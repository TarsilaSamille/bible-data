[{"verse":1,"text":"Chant des montées. Bénissez le SEIGNEUR, vous tous, serviteurs du SEIGNEUR, qui vous tenez dans la maison du SEIGNEUR pendant les nuits!","comment":"<em>montées </em><a href='/NBS/19/120/1'>120.1</a><sup>n</sup>. – <em>Bénissez </em><a href='/NBS/19/68/27'>68.27</a>; <a href='/NBS/19/103/21'>103.21</a>s; <a href='/NBS/19/135/19'>135.19</a>s; <a href='/NBS/16/9/5'>Né 9.5</a>; <a href='/NBS/13/29/20'>1Ch 29.20</a>. – <em>serviteurs du S</em>EIGNEUR<a href='/NBS/19/113/1'>113.1</a>+; <a href='/NBS/19/135/1'>135.1</a>; <a href='/NBS/66/19/5'>Ap 19.5</a>. – <em>qui vous tenez... </em><a href='/NBS/19/135/2'>135.2</a>; cf. <a href='/NBS/5/10/8'>Dt 10.8</a>; <a href='/NBS/5/18/7'>18.7</a>; <a href='/NBS/13/23/30'>1Ch 23.30</a>; <a href='/NBS/14/29/11'>2Ch 29.11</a>; <a href='/NBS/58/10/11'>Hé 10.11</a>. – <em>pendant les nuits </em><a href='/NBS/23/30/29'>Es 30.29</a>; <a href='/NBS/13/9/33'>1Ch 9.33</a>."},{"verse":2,"text":"Elevez vos mains vers le sanctuaire et bénissez le SEIGNEUR!","comment":"<em>Elevez vos mains </em><a href='/NBS/19/28/2'>28.2</a><sup>n</sup>; <a href='/NBS/19/141/2'>141.2</a>. – <em>vers le sanctuaire </em><a href='/NBS/19/5/8'>5.8</a>; <a href='/NBS/19/138/2'>138.2</a>."},{"verse":3,"text":"Que le SEIGNEUR te bénisse de Sion, lui qui fait le ciel et la terre!","comment":"<em>bénisse de Sion </em><a href='/NBS/19/20/3'>20.3</a>; <a href='/NBS/19/118/26'>118.26</a>; <a href='/NBS/19/128/5'>128.5</a>; cf. <a href='/NBS/4/6/22'>Nb 6.22</a>ss; <a href='/NBS/5/21/5'>Dt 21.5</a>; <a href='/NBS/9/2/20'>1S 2.20</a>. – <em>lui qui fait... </em><a href='/NBS/19/115/15'>115.15</a>+."}]
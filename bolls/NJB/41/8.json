,["「"],["十二","じゅうに"],["です"],["。"],["」"]]},{"verse":20,"text":"「四千人に七つのパンを裂いて上げたときは、パン切れを取り集めて幾つのかごがいっぱいになりましたか。」彼らは答えた。「七つです。」","tok":[["「"],["四千人","よんせんにん"],["に"],["七","なな"],["つ"],["の"],["パン"],["を"],["裂いて","さいて"],["上げた","あげた"],["とき"],["は"],["、"],["パン"],["切れ","きれ"],["を"],["取り集めて","とりあつめて"],["幾つ","いくつ"],["の"],["かご"],["が"],["いっぱい"],["に"],["なりました"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["七","なな"],["つ"],["です"],["。"],["」"]]},{"verse":21,"text":"イエスは言われた。「まだ悟らないのですか。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["まだ"],["悟らない","さとらない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":22,"text":"彼らはベツサイダに着いた。すると人々が盲人を連れて来て、彼にさわってくださるよう、イエスに願った。","tok":[["彼","かれ"],["ら"],["は"],["ベツサイダ"],["に"],["着いた","ついた"],["。"],["する"],["と"],["人々","ひとびと"],["が"],["盲人","もうじん"],["を"],["連れて","つれて"],["来て","きて"],["、"],["彼","かれ"],["に"],["さわって"],["くださる"],["よう"],["、"],["イエス"],["に"],["願った","ねがった"],["。"]]},{"verse":23,"text":"イエスは盲人の手を取って村の外に連れて行かれた。そしてその両目につばきをつけ、両手を彼に当てて「何か見えるか」と聞かれた。","tok":[["イエス"],["は"],["盲人","もうじん"],["の"],["手","て"],["を"],["取って","とって"],["村","むら"],["の"],["外","そと"],["に"],["連れて","つれて"],["行かれた","いかれた"],["。"],["そして"],["その"],["両目","りょうめ"],["に"],["つばき"],["を"],["つけ"],["、"],["両手","りょうて"],["を"],["彼","かれ"],["に"],["当てて","あてて"],["「"],["何","なん"],["か"],["見える","みえる"],["か"],["」"],["と"],["聞かれた","きかれた"],["。"]]},{"verse":24,"text":"すると彼は、見えるようになって、「人が見えます。木のようですが、歩いているのが見えます」と言った。","tok":[["する"],["と"],["彼","かれ"],["は"],["、"],["見える","みえる"],["よう"],["に"],["なって"],["、"],["「"],["人","ひと"],["が"],["見えます","みえます"],["。"],["木","き"],["の"],["よう"],["です"],["が"],["、"],["歩いて","あるいて"],["いる"],["の"],["が"],["見えます","みえます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":25,"text":"それから、イエスはもう一度彼の両目に両手を当てられた。そして、彼が見つめていると、すっかり直り、すべてのものがはっきり見えるようになった。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["もう"],["一度","いちど"],["彼","かれ"],["の"],["両目","りょうめ"],["に"],["両手","りょうて"],["を"],["当てられた","あてられた"],["。"],["そして"],["、"],["彼","かれ"],["が"],["見つめて","みつめて"],["いる"],["と"],["、"],["すっかり"],["直り","なおり"],["、"],["すべて"],["の"],["もの"]
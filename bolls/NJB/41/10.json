[{"verse":1,"text":"イエスは、そこを立って、ユダヤ地方とヨルダンの向こうに行かれた。すると、群衆がまたもみもとに集まって来たので、またいつものように彼らを教えられた。","tok":[["イエス"],["は"],["、"],["そこ"],["を"],["立って","たって"],["、"],["ユダヤ"],["地方","ちほう"],["と"],["ヨルダン"],["の"],["向こう","むこう"],["に"],["行かれた","いかれた"],["。"],["する"],["と"],["、"],["群衆","ぐんしゅう"],["が"],["また"],["も"],["みもと"],["に"],["集まって","あつまって"],["来た","きた"],["ので"],["、"],["また"],["いつも"],["の"],["よう"],["に"],["彼","かれ"],["ら"],["を"],["教えられた","おしえられた"],["。"]]},{"verse":2,"text":"すると、パリサイ人たちがみもとにやって来て、夫が妻を離別することは許されるかどうかと質問した。イエスをためそうとしたのである。","tok":[["する"],["と"],["、"],["パリサイ"],["人","にん"],["たち"],["が"],["みもと"],["に"],["やって"],["来て","きて"],["、"],["夫","おっと"],["が"],["妻","つま"],["を"],["離別","りべつ"],["する"],["こと"],["は"],["許される","ゆるされる"],["か"],["どう"],["か"],["と"],["質問","しつもん"],["した"],["。"],["イエス"],["を"],["ためそう"],["と"],["した"],["ので"],["ある"],["。"]]},{"verse":3,"text":"イエスは答えて言われた。「モーセはあなたがたに、何と命じていますか。」","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["モーセ"],["は"],["あなた"],["がた"],["に"],["、"],["何","なん"],["と"],["命じて","めいじて"],["います"],["か"],["。"],["」"]]},{"verse":4,"text":"彼らは言った。「モーセは、離婚状を書いて妻を離別することを許しました。」","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["モーセ"],["は"],["、"],["離婚状","りこんじょう"],["を"],["書いて","かいて"],["妻","つま"],["を"],["離別","りべつ"],["する"],["こと"],["を"],["許しました","ゆるしました"],["。"],["」"]]},{"verse":5,"text":"イエスは言われた。「モーセは、あなたがたの心がかたくななので、この命令をあなたがたに書いたのです。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["モーセ"],["は"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["が"],["かたくな"],["な"],["ので"],["、"],["この"],["命令","めいれい"],["を"],["あなた"],["がた"],["に"],["書いた","かいた"],["の"],["です"],["。"]]},{"verse":6,"text":"しかし、創造の初めから、神は、人を男と女に造られたのです。","tok":[["しかし"],["、"],["創造","そうぞう"],["の"],["初め","はじめ"],["から"],["、"],["神","かみ"],["は"],["、"],["人","ひと"],["を"],["男","おとこ"],["と"],["女","おんな"],["に"],["造られた","つくられた"],["の"],["です"],["。"]]},{"verse":7,"text":"それゆえ、人はその父と母を離れ、","tok":[["それ"],["ゆえ"],["、"],["人","ひと"],["は"],["その"],["父","ちち"],["と"],["母","はは"],["を"],["離れ","はなれ"],["、"]]},{"verse":8,"text":"ふたりは一体となるのです。それで、もはやふたりではなく、ひとりなので
[{"verse":1,"text":"さて、彼らがエルサレムの近くに来て、オリーブ山のふもとのベテパゲとベタニヤに近づいたとき、イエスはふたりの弟子を使いに出して、","tok":[["さて"],["、"],["彼","かれ"],["ら"],["が"],["エルサレム"],["の"],["近く","ちかく"],["に"],["来て","きて"],["、"],["オリーブ"],["山","さん"],["の"],["ふもと"],["の"],["ベテパゲ"],["と"],["ベタニヤ"],["に"],["近づいた","ちかづいた"],["とき"],["、"],["イエス"],["は"],["ふたり"],["の"],["弟子","でし"],["を"],["使い","つかい"],["に"],["出して","だして"],["、"]]},{"verse":2,"text":"言われた。「向こうの村へ行きなさい。村に入るとすぐ、まだだれも乗ったことのない、ろばの子が、つないであるのに気がつくでしょう。それをほどいて、引いて来なさい。","tok":[["言われた","いわれた"],["。"],["「"],["向こう","むこう"],["の"],["村","むら"],["へ"],["行き","いき"],["なさい"],["。"],["村","むら"],["に"],["入る","はいる"],["と"],["すぐ"],["、"],["まだ"],["だれ"],["も"],["乗った","のった"],["こと"],["の"],["ない"],["、"],["ろば"],["の"],["子","こ"],["が"],["、"],["つないで"],["ある"],["のに"],["気","き"],["が"],["つくでしょう"],["。"],["それ"],["を"],["ほどいて"],["、"],["引いて","ひいて"],["来","き"],["なさい"],["。"]]},{"verse":3,"text":"もし、『なぜそんなことをするのか』と言う人があったら、『主がお入用なのです。すぐに、またここに送り返されます』と言いなさい。」","tok":[["もし"],["、"],["『"],["なぜ"],["そんな"],["こと"],["を"],["する"],["の"],["か"],["』"],["と"],["言う","いう"],["人","ひと"],["が"],["あったら"],["、"],["『"],["主","ぬし"],["が"],["お入用","おにゅうよう"],["な"],["の"],["です"],["。"],["すぐ"],["に"],["、"],["また"],["ここ"],["に"],["送り返されます","おくりかえされます"],["』"],["と"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":4,"text":"そこで、出かけて見ると、表通りにある家の戸口に、ろばの子が一匹つないであったので、それをほどいた。","tok":[["そこ"],["で"],["、"],["出かけて","でかけて"],["見る","みる"],["と"],["、"],["表通り","おもてどおり"],["に"],["ある"],["家","いえ"],["の"],["戸口","とぐち"],["に"],["、"],["ろば"],["の"],["子","こ"],["が"],["一匹","いちひき"],["つないで"],["あった"],["ので"],["、"],["それ"],["を"],["ほどいた"],["。"]]},{"verse":5,"text":"すると、そこに立っていた何人かが言った。「ろばの子をほどいたりして、どうするのですか。」","tok":[["する"],["と"],["、"],["そこ"],["に"],["立って","たって"],["いた"],["何人","なんにん"],["か"],["が"],["言った","いった"],["。"],["「"],["ろば"],["の"],["子","こ"],["を"],["ほどい"],["たり"],["して"],["、"],["どう"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":6,"text":"弟子たちが、イエスの言われたとおりを話すと、彼らは許してくれた。","tok":[["弟子","でし"],["たち"],["が"],["、"],["イエス"],["の"],["言われた","いわれた"],["とおり"],["を"],["話す","はなす"],["と"],["、"],["彼","かれ"],["ら"],["は"],["許して","ゆるして"],["くれた"],["。"]]},{"verse":7,"text":"そこで、ろばの子をイエスのところへ引いて行って、自分たちの上着をその上に掛けた。イエスはそれに乗られた。","tok":[["そこ"],["で"],["、"],["ろば"],["の"],["子","こ"],["を"],["イエス"],["の"],["ところ"],["へ"],["引いて","ひいて"],["行って","いって"],["、"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["その"],["上","うえ"],["に"],["掛けた","かけた"],["。"],["イエス"],["は"],["それ"],["に"],["乗られた","のられた"],["。"]]},{"verse":8,"text":"すると、多くの人が、自分たちの上着を道に敷き、またほかの人々は、木の葉を枝ごと野原から切って来て、道に敷いた。","tok":[["する"],["と"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["、"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["道","みち"],["に"],["敷き","しき"],["、"],["また"],["ほか"],["の"],["人々","ひとびと"],["は"],["、"],["木の葉","このは"],["を"],["枝","えだ"],["ごと"],["野原","のはら"],["から"],["切って","きって"],["来て","きて"],["、"],["道","みち"],["に"],["敷いた","しいた"],["。"]]},{"verse":9,"text":"そして、前を行く者も、あとに従う者も、叫んでいた。「ホサナ。祝福あれ。主の御名によって来られる方に。","tok":[["そして"],["、"],["前","まえ"],["を"],["行く","いく"],["者","もの"],["も"],["、"],["あと"],["に"],["従う","したがう"],["者","もの"],["も"],["、"],["叫んで","さけんで"],["いた"],["。"],["「"],["ホサナ"],["。"],["祝福","しゅくふく"],["あれ"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["来られる","こられる"],["方","かた"],["に"],["。"]]},{"verse":10,"text":"祝福あれ。いま来た、われらの父ダビデの国に。ホサナ。いと高き所に。」","tok":[["祝福","しゅくふく"],["あれ"],["。"],["いま"],["来た","きた"],["、"],["われ"],["ら"],["の"],["父","ちち"],["ダビデ"],["の"],["国","くに"],["に"],["。"],["ホサナ"],["。"],["いと"],["高き","たかき"],["所","ところ"],["に"],["。"],["」"]]},{"verse":11,"text":"こうして、イエスはエルサレムに着き、宮に入られた。そして、すべてを見て回った後、時間ももうおそかったので、十二弟子といっしょにベタニヤに出て行かれた。","tok":[["こう"],["して"],["、"],["イエス"],["は"],["エルサレム"],["に"],["着き","つき"],["、"],["宮","みや"],["に"],["入られた","はいられた"],["。"],["そして"],["、"],["すべて"],["を"],["見て","みて"],["回った","まわった"],["後","あと"],["、"],["時間","じかん"],["も"],["もう"],["おそかった"],["ので"],["、"],["十二","じゅうに"],["弟子","でし"],["と"],["いっしょ"],["に"],["ベタニヤ"],["に"],["出て","でて"],["行かれた","いかれた"],["。"]]},{"verse":12,"text":"翌日、彼らがベタニヤを出たとき、イエスは空腹を覚えられた。","tok":[["翌日","よくじつ"],["、"],["彼","かれ"],["ら"],["が"],["ベタニヤ"],["を"],["出た","でた"],["とき"],["、"],["イエス"],["は"],["空腹","くうふく"],["を"],["覚えられた","おぼえられた"],["。"]]},{"verse":13,"text":"葉の茂ったいちじくの木が遠くに見えたので、それに何かありはしないかと見に行かれたが、そこに来ると、葉のほかは何もないのに気づかれた。いちじくのなる季節ではなかったからである。","tok":[["葉","は"],["の"],["茂った","しげった"],["いちじく"],["の"],["木","き"],["が"],["遠く","とおく"],["に"],["見えた","みえた"],["ので"],["、"],["それ"],["に"],["何","なん"],["か"],["あり"],["は"],["しない"],["か"],["と"],["見","み"],["に"],["行かれた","いかれた"],["が"],["、"],["そこ"],["に"],["来る","くる"],["と"],["、"],["葉","は"],["の"],["ほか"],["は"],["何","なん"],["も"],["ない"],["のに"],["気づかれた","きづかれた"],["。"],["いちじく"],["の"],["なる"],["季節","きせつ"],["で"],["は"],["なかった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"イエスは、その木に向かって言われた。「今後、いつまでも、だれもおまえの実を食べることのないように。」弟子たちはこれを聞いていた。","tok":[["イエス"],["は"],["、"],["その"],["木","き"],["に"],["向かって","むかって"],["言われた","いわれた"],["。"],["「"],["今後","こんご"],["、"],["いつ"],["まで"],["も"],["、"],["だれ"],["も"],["おまえ"],["の"],["実","じつ"],["を"],["食べる","たべる"],["こと"],["の"],["ない"],["よう"],["に"],["。"],["」"],["弟子","でし"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["いた"],["。"]]},{"verse":15,"text":"それから、彼らはエルサレムに着いた。イエスは宮に入り、宮の中で売り買いしている人々を追い出し始め、両替人の台や、鳩を売る者たちの腰掛けを倒し、","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["エルサレム"],["に"],["着いた","ついた"],["。"],["イエス"],["は"],["宮","みや"],["に"],["入り","はいり"],["、"],["宮","みや"],["の"],["中","なか"],["で"],["売り買い","うりかい"],["して"],["いる"],["人々","ひとびと"],["を"],["追い出し","おいだし"],["始め","はじめ"],["、"],["両替人","りょうがえにん"],["の"],["台","だい"],["や"],["、"],["鳩","はと"],["を"],["売る","うる"],["者","もの"],["たち"],["の"],["腰掛け","こしかけ"],["を"],["倒し","たおし"],["、"]]},{"verse":16,"text":"また宮を通り抜けて器具を運ぶことをだれにもお許しにならなかった。","tok":[["また"],["宮","みや"],["を"],["通り抜けて","とおりぬけて"],["器具","きぐ"],["を"],["運ぶ","はこぶ"],["こと"],["を"],["だれ"],["に"],["も"],["お許し","おゆるし"],["に"],["ならなかった"],["。"]]},{"verse":17,"text":"そして、彼らに教えて言われた。「『わたしの家は、すべての民の祈りの家と呼ばれる』と書いてあるではありませんか。それなのに、あなたがたはそれを強盗の巣にしたのです。」","tok":[["そして"],["、"],["彼","かれ"],["ら"],["に"],["教えて","おしえて"],["言われた","いわれた"],["。"],["「"],["『"],["わたし"],["の"],["家","いえ"],["は"],["、"],["すべて"],["の"],["民","たみ"],["の"],["祈り","いのり"],["の"],["家","いえ"],["と"],["呼ばれる","よばれる"],["』"],["と"],["書いて","かいて"],["ある"],["で"],["は"],["ありません"],["か"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["強盗","ごうとう"],["の"],["巣","す"],["に"],["した"],["の"],["です"],["。"],["」"]]},{"verse":18,"text":"祭司長、律法学者たちは聞いて、どのようにしてイエスを殺そうかと相談した。イエスを恐れたからであった。なぜなら、群衆がみなイエスの教えに驚嘆していたからである。","tok":[["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["聞いて","きいて"],["、"],["どの"],["よう"],["に"],["して"],["イエス"],["を"],["殺そう","ころそう"],["か"],["と"],["相談","そうだん"],["した"],["。"],["イエス"],["を"],["恐れた","おそれた"],["から"],["で"],["あった"],["。"],["なぜ"],["なら"],["、"],["群衆","ぐんしゅう"],["が"],["みな"],["イエス"],["の"],["教え","おしえ"],["に"],["驚嘆","きょうたん"],["して"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"夕方になると、イエスとその弟子たちは、いつも都から外に出た。","tok":[["夕方","ゆうがた"],["に"],["なる"],["と"],["、"],["イエス"],["と"],["その"],["弟子","でし"],["たち"],["は"],["、"],["いつも"],["都","みやこ"],["から"],["外","そと"],["に"],["出た","でた"],["。"]]},{"verse":20,"text":"朝早く、通りがかりに見ると、いちじくの木が根まで枯れていた。","tok":[["朝","あさ"],["早く","はやく"],["、"],["通りがかり","とおりがかり"],["に"],["見る","みる"],["と"],["、"],["いちじく"],["の"],["木","き"],["が"],["根","ね"],["まで"],["枯れて","かれて"],["いた"],["。"]]},{"verse":21,"text":"ペテロは思い出して、イエスに言った。「先生。ご覧なさい。あなたののろわれたいちじくの木が枯れました。」","tok":[["ペテロ"],["は"],["思い出して","おもいだして"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["ご覧","ごらん"],["なさい"],["。"],["あなた"],["の"],["のろわれた"],["いちじく"],["の"],["木","き"],["が"],["枯れました","かれました"],["。"],["」"]]},{"verse":22,"text":"イエスは答えて言われた。「神を信じなさい。","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["神","かみ"],["を"],["信じ","しんじ"],["なさい"],["。"]]},{"verse":23,"text":"まことに、あなたがたに告げます。だれでも、この山に向かって、『動いて、海に入れ』と言って、心の中で疑わず、ただ、自分の言ったとおりになると信じるなら、そのとおりになります。","tok":[["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["だれ"],["で"],["も"],["、"],["この"],["山","やま"],["に"],["向かって","むかって"],["、"],["『"],["動いて","うごいて"],["、"],["海","うみ"],["に"],["入れ","いれ"],["』"],["と"],["言って","いって"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["疑わず","うたがわず"],["、"],["ただ"],["、"],["自分","じぶん"],["の"],["言った","いった"],["とおり"],["に"],["なる"],["と"],["信じるなら","しんじるなら"],["、"],["その"],["とおり"],["に"],["なります"],["。"]]},{"verse":24,"text":"だからあなたがたに言うのです。祈って求めるものは何でも、すでに受けたと信じなさい。そうすれば、そのとおりになります。","tok":[["だ"],["から"],["あなた"],["がた"],["に"],["言う","いう"],["の"],["です"],["。"],["祈って","いのって"],["求める","もとめる"],["もの"],["は"],["何","なん"],["で"],["も"],["、"],["すでに"],["受けた","うけた"],["と"],["信じ","しんじ"],["なさい"],["。"],["そう"],["すれば"],["、"],["その"],["とおり"],["に"],["なります"],["。"]]},{"verse":25,"text":"また立って祈っているとき、だれかに対して恨み事があったら、赦してやりなさい。そうすれば、天におられるあなたがたの父も、あなたがたの罪を赦してくださいます。」","tok":[["また"],["立って","たって"],["祈って","いのって"],["いる"],["とき"],["、"],["だれ"],["か"],["に対して","にたいして"],["恨み","うらみ"],["事","こと"],["が"],["あったら"],["、"],["赦して","ゆるして"],["やり"],["なさい"],["。"],["そう"],["すれば"],["、"],["天","てん"],["に"],["おられる"],["あなた"],["がた"],["の"],["父","ちち"],["も"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["を"],["赦して","ゆるして"],["くださいます"],["。"],["」"]]},{"verse":26,"text":"一一・二五異本に二六節として、「しかし、もし赦してやらないなら、あなたがたの天の父も、あなたがたの罪を赦してくださいません」を加える。","tok":[["一一","いちいち"],["・"],["二五","にご"],["異本","いほん"],["に"],["二六","にろく"],["節","せつ"],["として"],["、"],["「"],["しかし"],["、"],["もし"],["赦して","ゆるして"],["やらないなら"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["も"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["を"],["赦して","ゆるして"],["くださいません"],["」"],["を"],["加える","くわえる"],["。"]]},{"verse":27,"text":"彼らはまたエルサレムに来た。イエスが宮の中を歩いておられると、祭司長、律法学者、長老たちが、イエスのところにやって来た。","tok":[["彼","かれ"],["ら"],["は"],["また"],["エルサレム"],["に"],["来た","きた"],["。"],["イエス"],["が"],["宮","みや"],["の"],["中","なか"],["を"],["歩いて","あるいて"],["おられる"],["と"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["、"],["長老","ちょうろう"],["たち"],["が"],["、"],["イエス"],["の"],["ところ"],["に"],["やって"],["来た","きた"],["。"]]},{"verse":28,"text":"そして、イエスに言った。「何の権威によって、これらのことをしておられるのですか。だれが、あなたにこれらのことをする権威を授けたのですか。」","tok":[["そして"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["何","なん"],["の"],["権威","けんい"],["によって"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["して"],["おられる"],["の"],["です"],["か"],["。"],["だれ"],["が"],["、"],["あなた"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["する"],["権威","けんい"],["を"],["授けた","さずけた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":29,"text":"そこでイエスは彼らに言われた。「一言尋ねますから、それに答えなさい。そうすれば、わたしも、何の権威によってこれらのことをしているかを、話しましょう。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["一言","ひとこと"],["尋ねます","たずねます"],["から"],["、"],["それ"],["に"],["答え","こたえ"],["なさい"],["。"],["そう"],["すれば"],["、"],["わたし"],["も"],["、"],["何","なん"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["こと"],["を"],["して"],["いる"],["か"],["を"],["、"],["話しましょう","はなしましょう"],["。"]]},{"verse":30,"text":"ヨハネのバプテスマは、天から来たのですか、人から出たのですか。答えなさい。」","tok":[["ヨハネ"],["の"],["バプテスマ"],["は"],["、"],["天","てん"],["から"],["来た","きた"],["の"],["です"],["か"],["、"],["人","ひと"],["から"],["出た","でた"],["の"],["です"],["か"],["。"],["答え","こたえ"],["なさい"],["。"],["」"]]},{"verse":31,"text":"すると、彼らは、こう言いながら、互いに論じ合った。「もし、天から、と言えば、それならなぜ、彼を信じなかったかと言うだろう。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["こう"],["言い","いい"],["ながら"],["、"],["互い","たがい"],["に"],["論じ合った","ろんじあった"],["。"],["「"],["もし"],["、"],["天","てん"],["から"],["、"],["と"],["言えば","いえば"],["、"],["それ"],["なら"],["なぜ"],["、"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["か"],["と"],["言うだろう","ゆうだろう"],["。"]]},{"verse":32,"text":"だからといって、人から、と言ってよいだろうか。」――彼らは群衆を恐れていたのである。というのは、人々がみな、ヨハネは確かに預言者だと思っていたからである。","tok":[["だ"],["から"],["と"],["いって"],["、"],["人","ひと"],["から"],["、"],["と"],["言って","いって"],["よいだろう"],["か"],["。"],["」"],["―"],["―"],["彼","かれ"],["ら"],["は"],["群衆","ぐんしゅう"],["を"],["恐れて","おそれて"],["いた"],["ので"],["ある"],["。"],["と"],["いう"],["の"],["は"],["、"],["人々","ひとびと"],["が"],["みな"],["、"],["ヨハネ"],["は"],["確か","たしか"],["に"],["預言者","よげんしゃ"],["だ"],["と"],["思って","おもって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"そこで彼らは、イエスに答えて、「わかりません」と言った。そこでイエスは彼らに、「わたしも、何の権威によってこれらのことをするのか、あなたがたに話すまい」と言われた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["イエス"],["に"],["答えて","こたえて"],["、"],["「"],["わかりません"],["」"],["と"],["言った","いった"],["。"],["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["、"],["「"],["わたし"],["も"],["、"],["何","なん"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["話すまい","はなすまい"],["」"],["と"],["言われた","いわれた"],["。"]]}]
[{"verse":1,"text":"さて、安息日が終わったので、マグダラのマリヤとヤコブの母マリヤとサロメとは、イエスに油を塗りに行こうと思い、香料を買った。","tok":[["さて"],["、"],["安息日","あんそくび"],["が"],["終わった","おわった"],["ので"],["、"],["マグダラ"],["の"],["マリヤ"],["と"],["ヤコブ"],["の"],["母","はは"],["マリヤ"],["と"],["サロメ"],["と"],["は"],["、"],["イエス"],["に"],["油","あぶら"],["を"],["塗り","ぬり"],["に"],["行こう","いこう"],["と"],["思い","おもい"],["、"],["香料","こうりょう"],["を"],["買った","かった"],["。"]]},{"verse":2,"text":"そして、週の初めの日の早朝、日が上ったとき、墓に着いた。","tok":[["そして"],["、"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["の"],["早朝","そうちょう"],["、"],["日","ひ"],["が"],["上った","のぼった"],["とき"],["、"],["墓","はか"],["に"],["着いた","ついた"],["。"]]},{"verse":3,"text":"彼女たちは、「墓の入口からあの石をころがしてくれる人が、だれかいるでしょうか」とみなで話し合っていた。","tok":[["彼女","かのじょ"],["たち"],["は"],["、"],["「"],["墓","はか"],["の"],["入口","いりぐち"],["から"],["あの"],["石","いし"],["を"],["ころがして"],["くれる"],["人","ひと"],["が"],["、"],["だれ"],["か"],["いるでしょう"],["か"],["」"],["と"],["みな"],["で"],["話し合って","はなしあって"],["いた"],["。"]]},{"verse":4,"text":"ところが、目を上げて見ると、あれほど大きな石だったのに、その石がすでにころがしてあった。","tok":[["ところ"],["が"],["、"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["あれ"],["ほど"],["大きな","おおきな"],["石","いし"],["だった"],["のに"],["、"],["その"],["石","いし"],["が"],["すでに"],["ころがして"],["あった"],["。"]]},{"verse":5,"text":"それで、墓の中に入ったところ、真っ白な長い衣をまとった青年が右側にすわっているのが見えた。彼女たちは驚いた。","tok":[["それ"],["で"],["、"],["墓","はか"],["の"],["中","なか"],["に"],["入った","はいった"],["ところ"],["、"],["真っ白","まっしろ"],["な"],["長い","ながい"],["衣","ころも"],["を"],["まとった"],["青年","せいねん"],["が"],["右側","みぎがわ"],["に"],["すわって"],["いる"],["の"],["が"],["見えた","みえた"],["。"],["彼女","かのじょ"],["たち"],["は"],["驚いた","おどろいた"],["。"]]},{"verse":6,"text":"青年は言った。「驚いてはいけません。あなたがたは、十字架につけられたナザレ人イエスを捜しているのでしょう。あの方はよみがえられました。ここにはおられません。ご覧なさい。ここがあの方の納められた所です。","tok":[["青年","せいねん"],["は"],["言った","いった"],["。"],["「"],["驚いて","おどろいて"],["は"],["いけません"],["。"],["あなた"],["がた"],["は"],["、"],["十字架","じゅうじか"],["に"],["つけられた"],["ナザレ人","なざれにん"],["イエス"],["を"],["捜して","さがして"],["いる"],["の"],["でしょう"],["。"],["あの"],["方","かた"],["は"],["よみがえられました"],["。"],["ここ"],["に"],["は"],["おられません"],["。"],["ご覧","ごらん"],["なさい"],["。"],["ここ"],["が"],["あの"],["方","かた"],["の"],["納められた","おさめられた"],["所","ところ"],["です"],["。"]]},{"verse":7,"text":"ですから行って、お弟子たちとペテロに、『イエスは、あなたがたより先にガリラヤへ行かれます。前に言われたとおり、そこでお会いできます』とそう言いなさい。」","tok":[["です"],["から"],["行って","いって"],["、"],["お弟子","おでし"],["たち"],["と"],["ペテロ"],["に"],["、"],["『"],["イエス"],["は"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["ガリラヤ"],["へ"],["行かれます","いかれます"],["。"],["前","まえ"],["に"],["言われた","いわれた"],["とおり"],["、"],["そこ"],["で"],["お会い","おあい"],["できます"],["』"],["と"],["そう"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":8,"text":"女たちは、墓を出て、そこから逃げ去った。すっかり震え上がって、気も転倒していたからである。そしてだれにも何も言わなかった。恐ろしかったからである。","tok":[["女","おんな"],["たち"],["は"],["、"],["墓","はか"],["を"],["出て","でて"],["、"],["そこ"],["から"],["逃げ去った","にげさった"],["。"],["すっかり"],["震え上がって","ふるえあがって"],["、"],["気","き"],["も"],["転倒","てんとう"],["して"],["いた"],["から"],["で"],["ある"],["。"],["そして"],["だれ"],["に"],["も"],["何","なん"],["も"],["言わなかった","いわなかった"],["。"],["恐ろしかった","おそろしかった"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"〔さて、週の初めの日の朝早くによみがえったイエスは、まずマグダラのマリヤにご自分を現された。イエスは、以前に、この女から七つの悪霊を追い出されたのであった。","tok":[["〔"],["さて"],["、"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["の"],["朝","あさ"],["早く","はやく"],["に"],["よみがえった"],["イエス"],["は"],["、"],["まず"],["マグダラ"],["の"],["マリヤ"],["に"],["ご自分","ごじぶん"],["を"],["現された","あらわされた"],["。"],["イエス"],["は"],["、"],["以前","いぜん"],["に"],["、"],["この"],["女","おんな"],["から"],["七","なな"],["つ"],["の"],["悪霊","あくりょう"],["を"],["追い出された","おいだされた"],["ので"],["あった"],["。"]]},{"verse":10,"text":"マリヤはイエスといっしょにいた人たちが嘆き悲しんで泣いているところに行き、そのことを知らせた。","tok":[["マリヤ"],["は"],["イエス"],["と"],["いっしょ"],["に"],["いた"],["人","ひと"],["たち"],["が"],["嘆き悲しんで","なげきかなしんで"],["泣いて","ないて"],["いる"],["ところ"],["に"],["行き","いき"],["、"],["その"],["こと"],["を"],["知らせた","しらせた"],["。"]]},{"verse":11,"text":"ところが、彼らは、イエスが生きておられ、お姿をよく見た、と聞いても、それを信じようとはしなかった。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["、"],["イエス"],["が"],["生きて","いきて"],["おられ"],["、"],["お姿","おすがた"],["を"],["よく"],["見た","みた"],["、"],["と"],["聞いて","きいて"],["も"],["、"],["それ"],["を"],["信じよう","しんじよう"],["と"],["は"],["しなかった"],["。"]]},{"verse":12,"text":"その後、彼らのうちのふたりがいなかのほうへ歩いていたおりに、イエスは別の姿でご自分を現された。","tok":[["その"],["後","ご"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["ふたり"],["が"],["いなか"],["の"],["ほう"],["へ"],["歩いて","あるいて"],["いた"],["おり"],["に"],["、"],["イエス"],["は"],["別","べつ"],["の"],["姿","すがた"],["で"],["ご自分","ごじぶん"],["を"],["現された","あらわされた"],["。"]]},{"verse":13,"text":"そこでこのふたりも、残りの人たちのところへ行ってこれを知らせたが、彼らはふたりの話も信じなかった。","tok":[["そこ"],["で"],["この"],["ふたり"],["も"],["、"],["残り","のこり"],["の"],["人","ひと"],["たち"],["の"],["ところ"],["へ"],["行って","いって"],["これ"],["を"],["知らせた","しらせた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["ふたり"],["の"],["話","はなし"],["も"],["信じなかった","しんじなかった"],["。"]]},{"verse":14,"text":"しかしそれから後になって、イエスは、その十一人が食卓に着いているところに現れて、彼らの不信仰とかたくなな心をお責めになった。それは、彼らが、よみがえられたイエスを見た人たちの言うところを信じなかったからである。","tok":[["しかし"],["それ"],["から"],["後","あと"],["に"],["なって"],["、"],["イエス"],["は"],["、"],["その"],["十一人","じゅういちにん"],["が"],["食卓","しょくたく"],["に"],["着いて","ついて"],["いる"],["ところ"],["に"],["現れて","あらわれて"],["、"],["彼","かれ"],["ら"],["の"],["不","ふ"],["信仰","しんこう"],["と"],["かたくな"],["な"],["心","こころ"],["を"],["お責め","おせめ"],["に"],["なった"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["、"],["よみがえられた"],["イエス"],["を"],["見た","みた"],["人","ひと"],["たち"],["の"],["言う","いう"],["ところ"],["を"],["信じなかった","しんじなかった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"それから、イエスは彼らにこう言われた。「全世界に出て行き、すべての造られた者に、福音を宣べ伝えなさい。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["こう"],["言われた","いわれた"],["。"],["「"],["全","ぜん"],["世界","せかい"],["に"],["出て","でて"],["行き","いき"],["、"],["すべて"],["の"],["造られた","つくられた"],["者","もの"],["に"],["、"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["なさい"],["。"]]},{"verse":16,"text":"信じてバプテスマを受ける者は、救われます。しかし、信じない者は罪に定められます。","tok":[["信じて","しんじて"],["バプテスマ"],["を"],["受ける","うける"],["者","もの"],["は"],["、"],["救われます","すくわれます"],["。"],["しかし"],["、"],["信じない","しんじない"],["者","もの"],["は"],["罪","つみ"],["に"],["定められます","さだめられます"],["。"]]},{"verse":17,"text":"信じる人々には次のようなしるしが伴います。すなわち、わたしの名によって悪霊を追い出し、新しいことばを語り、","tok":[["信じる","しんじる"],["人々","ひとびと"],["に"],["は"],["次","つぎ"],["の"],["よう"],["な"],["しるし"],["が"],["伴います","ともないます"],["。"],["すなわち"],["、"],["わたし"],["の"],["名","な"],["によって"],["悪霊","あくりょう"],["を"],["追い出し","おいだし"],["、"],["新しい","あたらしい"],["ことば"],["を"],["語り","かたり"],["、"]]},{"verse":18,"text":"蛇をもつかみ、たとい毒を飲んでも決して害を受けず、また、病人に手を置けば病人はいやされます。」","tok":[["蛇","へび"],["を"],["も"],["つかみ"],["、"],["たとい"],["毒","どく"],["を"],["飲んで","のんで"],["も"],["決して","けっして"],["害","がい"],["を"],["受けず","うけず"],["、"],["また"],["、"],["病人","びょうにん"],["に"],["手","て"],["を"],["置けば","おけば"],["病人","びょうにん"],["は"],["いやされます"],["。"],["」"]]},{"verse":19,"text":"主イエスは、彼らにこう話されて後、天に上げられて神の右の座に着かれた。","tok":[["主","しゅ"],["イエス"],["は"],["、"],["彼","かれ"],["ら"],["に"],["こう"],["話されて","はなされて"],["後","あと"],["、"],["天","てん"],["に"],["上げられて","あげられて"],["神","かみ"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着かれた","つかれた"],["。"]]},{"verse":20,"text":"そこで、彼らは出て行って、至る所で福音を宣べ伝えた。主は彼らとともに働き、みことばに伴うしるしをもって、みことばを確かなものとされた。〕別の追加文／〔さて、女たちは、命じられたすべてのことを、ペテロとその仲間の人々にさっそく知らせた。その後、イエスご自身、彼らによって、きよく、朽ちることのない、永遠の救いのおとずれを、東の果てから、西の果てまで送り届けられた。〕","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行って","いって"],["、"],["至る所","いたるところ"],["で"],["福音","ふくいん"],["を"],["宣べ伝えた","のべつたえた"],["。"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["働き","はたらき"],["、"],["みことば"],["に"],["伴う","ともなう"],["しるし"],["を"],["もって"],["、"],["みことば"],["を"],["確か","たしか"],["な"],["もの"],["と"],["された"],["。"],["〕"],["別","べつ"],["の"],["追加","ついか"],["文","ぶん"],["／"],["〔"],["さて"],["、"],["女","おんな"],["たち"],["は"],["、"],["命じられた","めいじられた"],["すべて"],["の"],["こと"],["を"],["、"],["ペテロ"],["と"],["その"],["仲間","なかま"],["の"],["人々","ひとびと"],["に"],["さっそく"],["知らせた","しらせた"],["。"],["その"],["後","ご"],["、"],["イエス"],["ご自身","ごじしん"],["、"],["彼","かれ"],["ら"],["によって"],["、"],["きよく"],["、"],["朽ちる","くちる"],["こと"],["の"],["ない"],["、"],["永遠","えいえん"],["の"],["救い","すくい"],["の"],["おとずれ"],["を"],["、"],["東","ひがし"],["の"],["果て","はて"],["から"],["、"],["西","にし"],["の"],["果て","はて"],["まで"],["送り届けられた","おくりとどけられた"],["。"],["〕"]]}]
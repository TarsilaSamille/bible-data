[{"verse":1,"text":"イエスはまた湖のほとりで教え始められた。おびただしい数の群衆がみもとに集まった。それでイエスは湖の上の舟に乗り、そこに腰をおろされ、群衆はみな岸べの陸地にいた。","tok":[["イエス"],["は"],["また"],["湖","みずうみ"],["の"],["ほとり"],["で"],["教え","おしえ"],["始められた","はじめられた"],["。"],["おびただしい"],["数","かず"],["の"],["群衆","ぐんしゅう"],["が"],["みもと"],["に"],["集まった","あつまった"],["。"],["それ"],["で"],["イエス"],["は"],["湖","みずうみ"],["の"],["上","うえ"],["の"],["舟","ふね"],["に"],["乗り","のり"],["、"],["そこ"],["に"],["腰","こし"],["を"],["おろされ"],["、"],["群衆","ぐんしゅう"],["は"],["みな"],["岸べ","きしべ"],["の"],["陸地","りくち"],["に"],["いた"],["。"]]},{"verse":2,"text":"イエスはたとえによって多くのことを教えられた。その教えの中でこう言われた。","tok":[["イエス"],["は"],["たとえ"],["によって"],["多く","おおく"],["の"],["こと"],["を"],["教えられた","おしえられた"],["。"],["その"],["教え","おしえ"],["の"],["中","なか"],["で"],["こう"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"「よく聞きなさい。種を蒔く人が種蒔きに出かけた。","tok":[["「"],["よく"],["聞き","きき"],["なさい"],["。"],["種","しゅ"],["を"],["蒔く","まく"],["人","ひと"],["が"],["種蒔き","たねまき"],["に"],["出かけた","でかけた"],["。"]]},{"verse":4,"text":"蒔いているとき、種が道ばたに落ちた。すると、鳥が来て食べてしまった。","tok":[["蒔いて","まいて"],["いる"],["とき"],["、"],["種","しゅ"],["が"],["道ばた","みちばた"],["に"],["落ちた","おちた"],["。"],["する"],["と"],["、"],["鳥","とり"],["が"],["来て","きて"],["食べて","たべて"],["しまった"],["。"]]},{"verse":5,"text":"また、別の種が土の薄い岩地に落ちた。土が深くなかったので、すぐに芽を出した。","tok":[["また"],["、"],["別","べつ"],["の"],["種","たね"],["が"],["土","つち"],["の"],["薄い","うすい"],["岩地","いわじ"],["に"],["落ちた","おちた"],["。"],["土","つち"],["が"],["深く","ふかく"],["なかった"],["ので"],["、"],["すぐ"],["に"],["芽","め"],["を"],["出した","だした"],["。"]]},{"verse":6,"text":"しかし日が上ると、焼けて、根がないために枯れてしまった。","tok":[["しかし"],["日","ひ"],["が"],["上る","のぼる"],["と"],["、"],["焼けて","やけて"],["、"],["根","ね"],["が"],["ない"],["ため"],["に"],["枯れて","かれて"],["しまった"],["。"]]},{"verse":7,"text":"また、別の種がいばらの中に落ちた。ところが、いばらが伸びて、それをふさいでしまったので、実を結ばなかった。","tok":[["また"],["、"],["別","べつ"],["の"],["種","たね"],["が"],["いばら"],["の"],["中","なか"],["に"],["落ちた","おちた"],["。"],["ところ"],["が"],["、"],["いばら"],["が"],["伸びて","のびて"],["、"],["それ"],["を"],["ふさいで"],["しまった"],["ので"],["、"],["実","じつ"],["を"],["結ばなかった","むすばなかった"],["。"]]},{"verse":8,"text":"また、別の種が良い地に落ちた。すると芽ばえ、育って、実を
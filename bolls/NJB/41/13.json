[{"verse":1,"text":"イエスが、宮から出て行かれるとき、弟子のひとりがイエスに言った。「先生。これはまあ、何とみごとな石でしょう。何とすばらしい建物でしょう。」","tok":[["イエス"],["が"],["、"],["宮","みや"],["から"],["出て","でて"],["行かれる","いかれる"],["とき"],["、"],["弟子","でし"],["の"],["ひとり"],["が"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["これ"],["は"],["まあ"],["、"],["何","なん"],["と"],["みごと"],["な"],["石","いし"],["でしょう"],["。"],["何","なん"],["と"],["すばらしい"],["建物","たてもの"],["でしょう"],["。"],["」"]]},{"verse":2,"text":"すると、イエスは彼に言われた。「この大きな建物を見ているのですか。石がくずされずに、積まれたまま残ることは決してありません。」","tok":[["する"],["と"],["、"],["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["この"],["大きな","おおきな"],["建物","たてもの"],["を"],["見て","みて"],["いる"],["の"],["です"],["か"],["。"],["石","いし"],["が"],["くずされず"],["に"],["、"],["積まれた","つまれた"],["まま"],["残る","のこる"],["こと"],["は"],["決して","けっして"],["ありません"],["。"],["」"]]},{"verse":3,"text":"イエスがオリーブ山で宮に向かってすわっておられると、ペテロ、ヤコブ、ヨハネ、アンデレが、ひそかにイエスに質問した。","tok":[["イエス"],["が"],["オリーブ"],["山","さん"],["で"],["宮","みや"],["に"],["向かって","むかって"],["すわって"],["おられる"],["と"],["、"],["ペテロ"],["、"],["ヤコブ"],["、"],["ヨハネ"],["、"],["アンデレ"],["が"],["、"],["ひそか"],["に"],["イエス"],["に"],["質問","しつもん"],["した"],["。"]]},{"verse":4,"text":"「お話しください。いつ、そういうことが起こるのでしょう。また、それがみな実現するようなときには、どんな前兆があるのでしょう。」","tok":[["「"],["お話し","おはなし"],["ください"],["。"],["いつ"],["、"],["そう"],["いう"],["こと"],["が"],["起こる","おこる"],["の"],["でしょう"],["。"],["また"],["、"],["それ"],["が"],["みな"],["実現","じつげん"],["する"],["よう"],["な"],["とき"],["に"],["は"],["、"],["どんな"],["前兆","ぜんちょう"],["が"],["ある"],["の"],["でしょう"],["。"],["」"]]},{"verse":5,"text":"そこで、イエスは彼らに話し始められた。「人に惑わされないように気をつけなさい。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["話し","はなし"],["始められた","はじめられた"],["。"],["「"],["人","ひと"],["に"],["惑わされない","まどわされない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":6,"text":"わたしの名を名のる者が大ぜい現れ、『私こそそれだ』と言って、多くの人を惑わすでしょう。","tok":[["わたし"],["の"],["名","な"],["を"],["名のる","なのる"],["者","もの"],["が"],["大ぜい","おおぜい"],["現れ","あらわれ"],["、"],["『"],["私","わたくし"],["こそ"],["それ"],["だ"],["』"],["と"],["言って","いって"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["惑わすでしょう","まどわすでしょう"],["。"]]},{"verse":7,"text":"また、戦争のことや戦争のうわさを聞いても、あわててはいけません。それは必ず起こることです。しかし、終わりが来たのではありません。","tok":[["また"],["、"],["戦争","せんそう"],["の"],["こと"],["や"],["戦争","せんそう"],["の"],["うわさ"],["を"],["聞いて","きいて"],["も"],["、"],["あわてて"],["は"],["いけません"],["。"],["それ"],["は"],["必ず","かならず"],["起こる","おこる"],["こと"],["です"],["。"],["しかし"],["、"],["終わり","おわり"],["が"],["来た","きた"],["ので"],["は"],["ありません"],["。"]]},{"verse":8,"text":"民族は民族に、国は国に敵対して立ち上がり、方々に地震があり、ききんも起こるはずだからです。これらのことは、産みの苦しみの初めです。","tok":[["民族","みんぞく"],["は"],["民族","みんぞく"],["に"],["、"],["国","くに"],["は"],["国","くに"],["に"],["敵対","てきたい"],["して"],["立ち上がり","たちあがり"],["、"],["方々","かたがた"],["に"],["地震","じしん"],["が"],["あり"],["、"],["ききん"],["も"],["起こる","おこる"],["はず"],["だ"],["から"],["です"],["。"],["これ"],["ら"],["の"],["こと"],["は"],["、"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["の"],["初め","はじめ"],["です"],["。"]]},{"verse":9,"text":"だが、あなたがたは、気をつけていなさい。人々は、あなたがたを議会に引き渡し、また、あなたがたは会堂でむち打たれ、また、わたしのゆえに、総督や王たちの前に立たされます。それは彼らに対してあかしをするためです。","tok":[["だ"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["気","き"],["を"],["つけて"],["い"],["なさい"],["。"],["人々","ひとびと"],["は"],["、"],["あなた"],["がた"],["を"],["議会","ぎかい"],["に"],["引き渡し","ひきわたし"],["、"],["また"],["、"],["あなた"],["がた"],["は"],["会堂","かいどう"],["で"],["むち打たれ","むちうたれ"],["、"],["また"],["、"],["わたし"],["の"],["ゆえ"],["に"],["、"],["総督","そうとく"],["や"],["王","おう"],["たち"],["の"],["前","まえ"],["に"],["立たされます","たたされます"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["に対して","にたいして"],["あかし"],["を"],["する"],["ため"],["です"],["。"]]},{"verse":10,"text":"こうして、福音がまずあらゆる民族に宣べ伝えられなければなりません。","tok":[["こう"],["して"],["、"],["福音","ふくいん"],["が"],["まず"],["あらゆる"],["民族","みんぞく"],["に"],["宣べ伝えられなければ","のべつたえられなければ"],["なりません"],["。"]]},{"verse":11,"text":"彼らに捕らえられ、引き渡されたとき、何と言おうかなどと案じるには及びません。ただ、そのとき自分に示されることを、話しなさい。話すのはあなたがたではなく、聖霊です。","tok":[["彼","かれ"],["ら"],["に"],["捕らえられ","とらえられ"],["、"],["引き渡された","ひきわたされた"],["とき"],["、"],["何","なん"],["と"],["言おう","いおう"],["か"],["など"],["と"],["案じる","あんじる"],["に"],["は"],["及びません","およびません"],["。"],["ただ"],["、"],["その"],["とき"],["自分","じぶん"],["に"],["示される","しめされる"],["こと"],["を"],["、"],["話し","はなし"],["なさい"],["。"],["話す","はなす"],["の"],["は"],["あなた"],["がた"],["で"],["は"],["なく"],["、"],["聖霊","せいれい"],["です"],["。"]]},{"verse":12,"text":"また兄弟は兄弟を死に渡し、父は子を死に渡し、子は両親に逆らって立ち、彼らを死に至らせます。","tok":[["また"],["兄弟","きょうだい"],["は"],["兄弟","きょうだい"],["を"],["死に","しに"],["渡し","わたし"],["、"],["父","ちち"],["は"],["子","こ"],["を"],["死に","しに"],["渡し","わたし"],["、"],["子","こ"],["は"],["両親","りょうしん"],["に"],["逆らって","さからって"],["立ち","たち"],["、"],["彼","かれ"],["ら"],["を"],["死","し"],["に"],["至らせます","いたらせます"],["。"]]},{"verse":13,"text":"また、わたしの名のために、あなたがたはみなの者に憎まれます。しかし、最後まで耐え忍ぶ人は救われます。","tok":[["また"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["は"],["みな"],["の"],["者","もの"],["に"],["憎まれます","にくまれます"],["。"],["しかし"],["、"],["最後","さいご"],["まで"],["耐え忍ぶ","たえしのぶ"],["人","ひと"],["は"],["救われます","すくわれます"],["。"]]},{"verse":14,"text":"『荒らす憎むべきもの』が、自分の立ってはならない所に立っているのを見たならば(読者はよく読み取るように。）ユダヤにいる人々は山へ逃げなさい。","tok":[["『"],["荒らす","あらす"],["憎むべき","にくむべき"],["もの"],["』"],["が"],["、"],["自分","じぶん"],["の"],["立って","たって"],["は"],["ならない"],["所","ところ"],["に"],["立って","たって"],["いる"],["の"],["を"],["見たならば","みたならば"],["("],["読者","どくしゃ"],["は"],["よく"],["読み取る","よみとる"],["よう"],["に"],["。"],["）"],["ユダヤ"],["に"],["いる"],["人々","ひとびと"],["は"],["山","やま"],["へ"],["逃げ","にげ"],["なさい"],["。"]]},{"verse":15,"text":"屋上にいる者は降りてはいけません。家から何かを取り出そうとして中に入ってはいけません。","tok":[["屋上","おくじょう"],["に"],["いる"],["者","もの"],["は"],["降りて","おりて"],["は"],["いけません"],["。"],["家","いえ"],["から"],["何","なん"],["か"],["を"],["取り出そう","とりだそう"],["として"],["中","なか"],["に"],["入って","はいって"],["は"],["いけません"],["。"]]},{"verse":16,"text":"畑にいる者は着物を取りに戻ってはいけません。","tok":[["畑","はたけ"],["に"],["いる"],["者","もの"],["は"],["着物","きもの"],["を"],["取り","とり"],["に"],["戻って","もどって"],["は"],["いけません"],["。"]]},{"verse":17,"text":"だがその日、哀れなのは身重の女と乳飲み子を持つ女です。","tok":[["だ"],["が"],["その"],["日","ひ"],["、"],["哀れ","あわれ"],["な"],["の"],["は"],["身重","みおも"],["の"],["女","おんな"],["と"],["乳飲み子","ちのみご"],["を"],["持つ","もつ"],["女","おんな"],["です"],["。"]]},{"verse":18,"text":"ただ、このことが冬に起こらないように祈りなさい。","tok":[["ただ"],["、"],["この"],["こと"],["が"],["冬","ふゆ"],["に"],["起こらない","おこらない"],["よう"],["に"],["祈り","いのり"],["なさい"],["。"]]},{"verse":19,"text":"その日は、神が天地を創造された初めから、今に至るまで、いまだかつてなかったような、またこれからもないような苦難の日だからです。","tok":[["その"],["日","ひ"],["は"],["、"],["神","かみ"],["が"],["天地","てんち"],["を"],["創造","そうぞう"],["された"],["初め","はじめ"],["から"],["、"],["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["いまだ"],["かつて"],["なかった"],["よう"],["な"],["、"],["また"],["これ"],["から"],["も"],["ない"],["よう"],["な"],["苦難","くなん"],["の"],["日","ひ"],["だ"],["から"],["です"],["。"]]},{"verse":20,"text":"そして、もし主がその日数を少なくしてくださらないなら、ひとりとして救われる者はないでしょう。しかし、主は、ご自分で選んだ選びの民のために、その日数を少なくしてくださったのです。","tok":[["そして"],["、"],["もし"],["主","ぬし"],["が"],["その"],["日数","にっすう"],["を"],["少なく","すくなく"],["して"],["くださらないなら"],["、"],["ひとり"],["として"],["救われる","すくわれる"],["者","もの"],["は"],["ないでしょう"],["。"],["しかし"],["、"],["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["で"],["選んだ","えらんだ"],["選び","えらび"],["の"],["民","たみ"],["の"],["ため"],["に"],["、"],["その"],["日数","にっすう"],["を"],["少なく","すくなく"],["して"],["くださった"],["の"],["です"],["。"]]},{"verse":21,"text":"そのとき、あなたがたに、『そら、キリストがここにいる』とか、『ほら、あそこにいる』とか言う者があっても、信じてはいけません。","tok":[["その"],["とき"],["、"],["あなた"],["がた"],["に"],["、"],["『"],["そら"],["、"],["キリスト"],["が"],["ここ"],["に"],["いる"],["』"],["と"],["か"],["、"],["『"],["ほら"],["、"],["あそこ"],["に"],["いる"],["』"],["と"],["か"],["言う","いう"],["者","もの"],["が"],["あって"],["も"],["、"],["信じて","しんじて"],["は"],["いけません"],["。"]]},{"verse":22,"text":"にせキリスト、にせ預言者たちが現れて、できれば選民を惑わそうとして、しるしや不思議なことをして見せます。","tok":[["にせ"],["キリスト"],["、"],["にせ"],["預言者","よげんしゃ"],["たち"],["が"],["現れて","あらわれて"],["、"],["できれば"],["選民","せんみん"],["を"],["惑わそう","まどわそう"],["として"],["、"],["しるし"],["や"],["不思議","ふしぎ"],["な"],["こと"],["を"],["して"],["見せます","みせます"],["。"]]},{"verse":23,"text":"だから、気をつけていなさい。わたしは、何もかも前もって話しました。","tok":[["だ"],["から"],["、"],["気","き"],["を"],["つけて"],["い"],["なさい"],["。"],["わたし"],["は"],["、"],["何","なん"],["も"],["か"],["も"],["前もって","まえもって"],["話しました","はなしました"],["。"]]},{"verse":24,"text":"だが、その日には、その苦難に続いて、太陽は暗くなり、月は光を放たず、","tok":[["だ"],["が"],["、"],["その"],["日","ひ"],["に"],["は"],["、"],["その"],["苦難","くなん"],["に"],["続いて","つづいて"],["、"],["太陽","たいよう"],["は"],["暗く","くらく"],["なり"],["、"],["月","つき"],["は"],["光","ひかり"],["を"],["放たず","はなたず"],["、"]]},{"verse":25,"text":"星は天から落ち、天の万象は揺り動かされます。","tok":[["星","ほし"],["は"],["天","てん"],["から"],["落ち","おち"],["、"],["天","てん"],["の"],["万象","ばんしょう"],["は"],["揺り動かされます","ゆりうごかされます"],["。"]]},{"verse":26,"text":"そのとき、人々は、人の子が偉大な力と栄光を帯びて雲に乗って来るのを見るのです。","tok":[["その"],["とき"],["、"],["人々","ひとびと"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["偉大","いだい"],["な"],["力","ちから"],["と"],["栄光","えいこう"],["を"],["帯びて","おびて"],["雲","くも"],["に"],["乗って","のって"],["来る","くる"],["の"],["を"],["見る","みる"],["の"],["です"],["。"]]},{"verse":27,"text":"そのとき、人の子は、御使いたちを送り、地の果てから天の果てまで、四方からその選びの民を集めます。","tok":[["その"],["とき"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["御使い","おつかい"],["たち"],["を"],["送り","おくり"],["、"],["地","ち"],["の"],["果て","はて"],["から"],["天","てん"],["の"],["果て","はて"],["まで"],["、"],["四方","しほう"],["から"],["その"],["選び","えらび"],["の"],["民","たみ"],["を"],["集めます","あつめます"],["。"]]},{"verse":28,"text":"いちじくの木から、たとえを学びなさい。枝が柔らかになって、葉が出て来ると、夏の近いことがわかります。","tok":[["いちじく"],["の"],["木","き"],["から"],["、"],["たとえ"],["を"],["学び","まなび"],["なさい"],["。"],["枝","えだ"],["が"],["柔らか","やわらか"],["に"],["なって"],["、"],["葉","は"],["が"],["出て","でて"],["来る","くる"],["と"],["、"],["夏","なつ"],["の"],["近い","ちかい"],["こと"],["が"],["わかります"],["。"]]},{"verse":29,"text":"そのように、これらのことが起こるのを見たら、人の子が戸口まで近づいていると知りなさい。","tok":[["その"],["よう"],["に"],["、"],["これ"],["ら"],["の"],["こと"],["が"],["起こる","おこる"],["の"],["を"],["見たら","みたら"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["戸口","とぐち"],["まで"],["近づいて","ちかづいて"],["いる"],["と"],["知り","しり"],["なさい"],["。"]]},{"verse":30,"text":"まことに、あなたがたに告げます。これらのことが全部起こってしまうまでは、この時代は過ぎ去りません。","tok":[["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["これ"],["ら"],["の"],["こと"],["が"],["全部","ぜんぶ"],["起こって","おこって"],["しまう"],["まで"],["は"],["、"],["この"],["時代","じだい"],["は"],["過ぎ去りません","すぎさりません"],["。"]]},{"verse":31,"text":"この天地は滅びます。しかし、わたしのことばは決して滅びることがありません。","tok":[["この"],["天地","てんち"],["は"],["滅びます","ほろびます"],["。"],["しかし"],["、"],["わたし"],["の"],["ことば"],["は"],["決して","けっして"],["滅びる","ほ
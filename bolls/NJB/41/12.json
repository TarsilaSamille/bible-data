,["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["これ"],["は"],["だれ"],["の"],["肖像","しょうぞう"],["です"],["か"],["。"],["だれ"],["の"],["銘","めい"],["です"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["「"],["カイザル"],["の"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"するとイエスは言われた。「カイザルのものはカイザルに返しなさい。そして神のものは神に返しなさい。」彼らはイエスに驚嘆した。","tok":[["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["カイザル"],["の"],["もの"],["は"],["カイザル"],["に"],["返し","かえし"],["なさい"],["。"],["そして"],["神","かみ"],["の"],["もの"],["は"],["神","かみ"],["に"],["返し","かえし"],["なさい"],["。"],["」"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["驚嘆","きょうたん"],["した"],["。"]]},{"verse":18,"text":"また、復活はないと主張していたサドカイ人たちが、イエスのところに来て、質問した。","tok":[["また"],["、"],["復活","ふっかつ"],["は"],["ない"],["と"],["主張","しゅちょう"],["して"],["いた"],["サドカイ"],["人","にん"],["たち"],["が"],["、"],["イエス"],["の"],["ところ"],["に"],["来て","きて"],["、"],["質問","しつもん"],["した"],["。"]]},{"verse":19,"text":"「先生。モーセは私たちのためにこう書いています。『もし、兄が死んで妻をあとに残し、しかも子がない場合には、その弟はその女を妻にして、兄のための子をもうけなければならない。』","tok":[["「"],["先生","せんせい"],["。"],["モーセ"],["は"],["私たち","わたしたち"],["の"],["ため"],["に"],["こう"],["書いて","かいて"],["います"],["。"],["『"],["もし"],["、"],["兄","あに"],["が"],["死んで","しんで"],["妻","つま"],["を"],["あと"],["に"],["残し","のこし"],["、"],["しかも"],["子","こ"],["が"],["ない"],["場合","ばあい"],["に"],["は"],["、"],["その"],["弟","おとうと"],["は"],["その"],["女","おんな"],["を"],["妻","つま"],["に"],["して"],["、"],["兄","あに"],["の"],["ため"],["の"],["子","こ"],["を"],["もうけなければ"],["ならない"],["。"],["』"]]},{"verse":20,"text":"さて、七人の兄弟がいました。長男が妻をめとりましたが、子を残さないで死にました。","tok":[["さて"],["、"],["七人","しちにん"],["の"],["兄弟","きょうだい"],["が"],["いました"],["。"],["長男","ちょうなん"],["が"],["妻","つま"],["を"],["めとりました"],["が"],["、"],["子","こ"],["を"],["残さないで","のこさないで"],["死にました","しにました"],["。"]]},{"verse":21,"text":"そこで次男がその女を妻にしたところ、やはり子を残さずに死にました。三男も同様でした。","tok":[["そこ"],["で"],["次男","じなん"],["が"],["その"],["女","おんな"],["を"],["妻","つま"],["に"],["した"],["ところ"],["、"],["やはり"],["子","こ"],["を"],["残さず","のこさず"],["に"],["死にました","しにました"],["。"],["三男","さんなん"],["も"],["同様","どうよう"],["でした"],["。"]]},{"verse":22,"text":"こうして、七人とも子を残しませんでした。最後に、女も死にました。","tok":[["こう"],["して"],["、"],["七人","しちにん"],["とも子","ともこ"],["を"],["残しませんでした","のこしませんでした"],["。"],["最後","さいご"],["に"],["、"],["女","おんな"],["も"],["死にました","しにました"],["。"]]},{"verse":23,"text":"復活の際、彼らがよみがえるとき、その女はだれの妻なのでしょうか。七人ともその女を妻にしたのですが。」","tok":[["復活","ふっかつ"],["の"],["際","さい"],["、"],["彼","かれ"],["ら"],["が"],["よみがえる"],["とき"],["、"],["その"],["女","おんな"],["は"],["だれ"],["の"],["妻","つま"],["な"],["の"],["でしょう"],["か"],["。"],["七人","ななにん"],["とも"],["その"],["女","おんな"],["を"],["妻","つま"],["に"],["した"],["の"],["です"],["が"],["。"],["」"]]},{"verse":24,"text":"イエスは彼らに言われた。「そんな思い違いをしているのは、聖書も神の力も知らないからではありませんか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["そんな"],["思い違い","おもいちがい"],["を"],["して"],["いる"],["の"],["は"],["、"],["聖書","せいしょ"],["も"],["神","かみ"],["の"],["力","ちから"],["も"],["知らない","しらない"],["から"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":25,"text":"人が死人の中からよみがえるときには、めとることも、とつぐこともなく、天の御使いたちのようです。","tok":[["人","ひと"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえる"],["とき"],["に"],["は"],["、"],["めとる"],["こと"],["も"],["、"],["とつぐ"],["こと"],["も"],["なく"],["、"],["天","てん"],["の"],["御使い","おつかい"],["たち"],["の"],["よう"],["です"],["。"]]},{"verse":26,"text":"それに、死人がよみがえることについては、モーセの書にある柴の個所で、神がモーセにどう語られたか、あなたがたは読んだことがないのですか。『わたしは、アブラハムの神、イサクの神、ヤコブの神である』とあります。","tok":[["それ"],["に"],["、"],["死人","しにん"],["が"],["よみがえる"],["こと"],["について"],["は"],["、"],["モーセ"],["の"],["書","しょ"],["に"],["ある"],["柴","しば"],["の"],["個所","かしょ"],["で"],["、"],["神","かみ"],["が"],["モーセ"],["に"],["どう"],["語られた","かたられた"],["か"],["、"],["あなた"],["がた"],["は"],["読んだ","よんだ"],["こと"],["が"],["ない"],["の"],["です"],["か"],["。"],["『"],["わたし"],["は"],["、"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["で"],["ある"],["』"],["と"],["あります"],["。"]]},{"verse":27,"text":"神は死んだ者の神ではありません。生きている者の神です。あなたがたはたいへんな思い違いをしています。」","tok":[["神","かみ"],["は"],["死んだ","しんだ"],["者","もの"],["の"],["神","かみ"],["で"],["は"],["ありません"],["。"],["生きて","いきて"],["いる"],["者","もの"],["の"],["神","かみ"],["です"],["。"],["あなた"],["がた"],["は"],["たいへん"],["な"],["思い違い","おもいちがい"],["を"],["して"],["います"],["。"],["」"]]},{"verse":28,"text":"律法学者がひとり来て、その議論を聞いていたが、イエスがみごとに答えられたのを知って、イエスに尋ねた。「すべての命令の中で、どれが一番たいせつですか。」","tok":[["律法学者","りっぽうがくしゃ"],["が"],["ひとり"],["来て","きて"],["、"],["その"],["議論","ぎろん"],["を"],["聞いて","きいて"],["いた"],["が"],["、"],["イエス"],["が"],["みごと"],["に"],["答えられた","こたえられた"],["の"],["を"],["知って","しって"],["、"],["イエス"],["に"],["尋ねた","たずねた"],["。"],["「"],["すべて"],["の"],["命令","めいれい"],["の"],["中","なか"],["で"],["、"],["どれ"],["が"],["一番","いちばん"],["たいせつ"],["です"],["か"],["。"],["」"]]},{"verse":29,"text":"イエスは答えられた。「一番たいせつなのはこれです。『イスラエルよ。聞け。われらの神である主は、唯一の主である。","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["一番","いちばん"],["たいせつ"],["な"],["の"],["は"],["これ"],["です"],["。"],["『"],["イスラエル"],["よ"],["。"],["聞け","きけ"],["。"],["われ"],["ら"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["唯一","ゆいいつ"],["の"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":30,"text":"心を尽くし、思いを尽くし、知性を尽くし、力を尽くして、あなたの神である主を愛せよ。』","tok":[["心","こころ"],["を"],["尽くし","つくし"],["、"],["思い","おもい"],["を"],["尽くし","つくし"],["、"],["知性","ちせい"],["を"],["尽くし","つくし"],["、"],["力","ちから"],["を"],["尽くして","つくして"],["、"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["を"],["愛せよ","あいせよ"],["。"],["』"]]},{"verse":31,"text":"次にはこれです。『あなたの隣人をあなた自身のように愛せよ。』この二つより大事な命令は、ほかにありません。」","tok":[["次","つぎ"],["に"],["は"],["これ"],["です"],["。"],["『"],["あなた"],["の"],["隣人","りんじん"],["を"],["あなた"],["自身","じしん"],["の"],["よう"],["に"],["愛せよ","あいせよ"],["。"],["』"],["この"],["二","ふた"],["つ"],["より"],["大事","だいじ"],["な"],["命令","めいれい"],["は"],["、"],["ほか"],["に"],["ありません"],["。"],["」"]]},{"verse":32,"text":"そこで、この律法学者は、イエスに言った。「先生。そのとおりです。『主は唯一であって、そのほかに、主はない』と言われたのは、まさにそのとおりです。","tok":[["そこ"],["で"],["、"],["この"],["律法学者","りっぽうがくしゃ"],["は"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["その"],["とおり"],["です"],["。"],["『"],["主","ぬし"],["は"],["唯一","ゆいいつ"],["で"],["あって"],["、"],["その"],["ほか"],["に"],["、"],["主","ぬし"],["は"],["ない"],["』"],["と"],["言われた","いわれた"],["の"],["は"],["、"],["まさに"],["その"],["とおり"],["です"],["。"]]},{"verse":33,"text":"また『心を尽くし、知恵を尽くし、力を尽くして主を愛し、また隣人をあなた自身のように愛する』ことは、どんな全焼のいけにえや供え物よりも、ずっとすぐれています。」","tok":[["また"],["『"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["知恵","ちえ"],["を"],["尽くし","つくし"],["、"],["力","ちから"],["を"],["尽くして","つくして"],["主","ぬし"],["を"],["愛し","あいし"],["、"],["また"],["隣人","りんじん"],["を"],["あなた"],["自身","じしん"],["の"],["よう"],["に"],["愛する","あいする"],["』"],["こと"],["は"],["、"],["どんな"],["全焼","ぜんしょう"],["の"],["いけにえ"],["や"],["供え物","そなえもの"],["より"],["も"],["、"],["ずっと"],["すぐれて"],["います"],["。"],["」"]]},{"verse":34,"text":"イエスは、彼が賢い返事をしたのを見て、言われた。「あなたは神の国から遠くない。」それから後は、だれもイエスにあえて尋ねる者がなかった。","tok":[["イエス"],["は"],["、"],["彼","かれ"],["が"],["賢い","かしこい"],["返事","へんじ"],["を"],["した"],["の"],["を"],["見て","みて"],["、"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["神","かみ"],["の"],["国","くに"],["から"],["遠く","とおく"],["ない"],["。"],["」"],["それ"],["から"],["後","あと"],["は"],["、"],["だれ"],["も"],["イエス"],["に"],["あえて"],["尋ねる","たずねる"],["者","もの"],["が"],["なかった"],["。"]]},{"verse":35,"text":"イエスが宮で教えておられたとき、こう言われた。「律法学者たちは、どうしてキリストをダビデの子と言うのですか。","tok":[["イエス"],["が"],["宮","みや"],["で"],["教えて","おしえて"],["おられた"],["とき"],["、"],["こう"],["言われた","いわれた"],["。"],["「"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["どう"],["して"],["キリスト"],["を"],["ダビデ"],["の"],["子","こ"],["と"],["言う","いう"],["の"],["です"],["か"],["。"]]},{"verse":36,"text":"ダビデ自身、聖霊によって、こう言っています。／『主は私の主に言われた。／「わたしがあなたの敵を／あなたの足の下に従わせるまでは、わたしの右の座に着いていなさい。」』","tok":[["ダビデ"],["自身","じしん"],["、"],["聖霊","せいれい"],["によって"],["、"],["こう"],["言って","いって"],["います"],["。"],["／"],["『"],["主","ぬし"],["は"],["私","わたくし"],["の"],["主","ぬし"],["に"],["言われた","いわれた"],["。"],["／"],["「"],["わたし"],["が"],["あなた"],["の"],["敵","てき"],["を"],["／"],["あなた"],["の"],["足","あし"],["の"],["下","した"],["に"],["従わせる","したがわせる"],["まで"],["は"],["、"],["わたし"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着いて","ついて"],["い"],["なさい"],["。"],["」"],["』"]]},{"verse":37,"text":"ダビデ自身がキリストを主と呼んでいるのに、どういうわけでキリストがダビデの子なのでしょう。」大ぜいの群衆は、イエスの言われることを喜んで聞いていた。","tok":[["ダビデ"],["自身","じしん"],["が"],["キリスト"],["を"],["主","ぬし"],["と"],["呼んで","よんで"],["いる"],["のに"],["、"],["どういう"],["わけ"],["で"],["キリスト"],["が"],["ダビデ"],["の"],["子","こ"],["な"],["の"],["でしょう"],["。"],["」"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["は"],["、"],["イエス"],["の"],["言われる","いわれる"],["こと"],["を"],["喜んで","よろこんで"],["聞いて","きいて"],["いた"],["。"]]},{"verse":38,"text":"イエスはその教えの中でこう言われた。「律法学者たちには気をつけなさい。彼らは、長い衣をまとって歩き回ったり、広場であいさつされたりすることが大好きで、","tok":[["イエス"],["は"],["その"],["教え","おしえ"],["の"],["中","なか"],["で"],["こう"],["言われた","いわれた"],["。"],["「"],["律法学者","りっぽうがくしゃ"],["たち"],["に"],["は"],["気","き"],["を"],["つけ"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["、"],["長い","ながい"],["衣","ころも"],["を"],["まとって"],["歩き回っ","あるきまわっ"],["たり"],["、"],["広場","ひろば"],["で"],["あいさつ"],["され"],["たり"],["する"],["こと"],["が"],["大好き","だいすき"],["で"],["、"]]},{"verse":39,"text":"また会堂の上席や、宴会の上座が大好きです。","tok":[["また"],["会堂","かいどう"],["の"],["上席","じょうせき"],["や"],["、"],["宴会","えんかい"],["の"],["上座","かみざ"],["が"],["大好き","だいすき"],["です"],["。"]]},{"verse":40,"text":"また、やもめの家を食いつぶし、見えを飾るために長い祈りをします。こういう人たちは人一倍きびしい罰を受けるのです。」","tok":[["また"],["、"],["やもめ"],["の"],["家","いえ"],["を"],["食いつぶし","くいつぶし"],["、"],["見え","みえ"],["を"],["飾る","かざる"],["ため"],["に"],["長い","ながい"],["祈り","いのり"],["を"],["します"],["。"],["こう"],["いう"],["人","ひと"],["たち"],["は"],["人一倍","ひといちばい"],["きびしい"],["罰","ばつ"],["を"],["受ける","うける"],["の"],["です"],["。"],["」"]]},{"verse":41,"text":"それから、イエスは献金箱に向かってすわり、人々が献金箱へ金を投げ入れる様子を見ておられた。多くの金持ちが大金を投げ入れていた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["献金","けんきん"],["箱","ばこ"],["に"],["向かって","むかって"],["すわり"],["、"],["人々","ひとびと"],["が"],["献金","けんきん"],["箱","ばこ"],["へ"],["金","かね"],["を"],["投げ入れる","なげいれる"],["様子","ようす"],["を"],["見て","みて"],["おられた"],["。"],["多く","おおく"],["の"],["金持ち","かねもち"],["が"],["大金","たいきん"],["を"],["投げ入れて","なげいれて"],["いた"],["。"]]},{"verse":42,"text":"そこへひとりの貧しいやもめが来て、レプタ銅貨を二つ投げ入れた。それは一コドラントに当たる。","tok":[["そこ"],["へ"],["ひとり"],["の"],["貧しい","まずしい"],["やもめ"],["が"],["来て","きて"],["、"],["レプタ"],["銅貨","どうか"],["を"],["二","ふた"],["つ"],["投げ入れた","なげいれた"],["。"],["それ"],["は"],["一","いち"],["コドラント"],["に"],["当たる","あたる"],["。"]]},{"verse":43,"text":"すると、イエスは弟子たちを呼び寄せて、こう言われた。「まことに、あなたがたに告げます。この貧しいやもめは、献金箱に投げ入れていたどの人よりもたくさん投げ入れました。","tok":[["する"],["と"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["を"],["呼び寄せて","よびよせて"],["、"],["こう"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["この"],["貧しい","まずしい"],["やもめ"],["は"],["、"],["献金","けんきん"],["箱","ばこ"],["に"],["投げ入れて","なげいれて"],["いた"],["どの"],["人","ひと"],["より"],["も"],["たくさん"],["投げ入れました","なげいれました"],["。"]]},{"verse":44,"text":"みなは、あり余る中から投げ入れたのに、この女は、乏しい中から、あるだけを全部、生活費の全部を投げ入れたからです。」","tok":[["みな"],["は"],["、"],["あり余る","ありあまる"],["中","なか"],["から"],["投げ入れた","なげいれた"],["のに"],["、"],["この"],["女","おんな"],["は"],["、"],["乏しい","とぼしい"],["中","なか"],["から"],["、"],["ある"],["だけ"],["を"],["全部","ぜんぶ"],["、"],["生活費","せいかつひ"],["の"],["全部","ぜんぶ"],["を"],["投げ入れた","なげいれた"],["から"],["です"],["。"],["」"]]}]
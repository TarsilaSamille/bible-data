[{"verse":1,"text":"さて、過越の祭りと種なしパンの祝いが二日後に迫っていたので、祭司長、律法学者たちは、どうしたらイエスをだまして捕らえ、殺すことができるだろうか、とけんめいであった。","tok":[["さて"],["、"],["過越","すぎこし"],["の"],["祭り","まつり"],["と"],["種","しゅ"],["なし"],["パン"],["の"],["祝い","いわい"],["が"],["二日後","ふたかご"],["に"],["迫って","せまって"],["いた"],["ので"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["どう"],["したら"],["イエス"],["を"],["だまして"],["捕らえ","とらえ"],["、"],["殺す","ころす"],["こと"],["が"],["できるだろう"],["か"],["、"],["と"],["けんめい"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼らは、「祭りの間はいけない。民衆の騒ぎが起こるといけないから」と話していた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["「"],["祭り","まつり"],["の"],["間","あいだ"],["は"],["いけない"],["。"],["民衆","みんしゅう"],["の"],["騒ぎ","さわぎ"],["が"],["起こる","おこる"],["と"],["いけない"],["から"],["」"],["と"],["話して","はなして"],["いた"],["。"]]},{"verse":3,"text":"イエスがベタニヤで、ツァラアトに冒された人シモンの家におられたとき、食卓に着いておられると、ひとりの女が、純粋で、非常に高価なナルド油の入った石膏のつぼを持って来て、そのつぼを割り、イエスの頭に注いだ。","tok":[["イエス"],["が"],["ベタニヤ"],["で"],["、"],["ツァラアト"],["に"],["冒された","おかされた"],["人","ひと"],["シモン"],["の"],["家","いえ"],["に"],["おられた"],["とき"],["、"],["食卓","しょくたく"],["に"],["着いて","ついて"],["おられる"],["と"],["、"],["ひとり"],["の"],["女","おんな"],["が"],["、"],["純粋","じゅんすい"],["で"],["、"],["非常","ひじょう"],["に"],["高価","こうか"],["な"],["ナルド"],["油","あぶら"],["の"],["入った","はいった"],["石膏","せっこう"],["の"],["つぼ"],["を"],["持って","もって"],["来て","きて"],["、"],["その"],["つぼ"],["を"],["割り","わり"],["、"],["イエス"],["の"],["頭","あたま"],["に"],["注いだ","そそいだ"],["。"]]},{"verse":4,"text":"すると、何人かの者が憤慨して互いに言った。「何のために、香油をこんなにむだにしたのか。","tok":[["する"],["と"],["、"],["何人","なんにん"],["か"],["の"],["者","もの"],["が"],["憤慨","ふんがい"],["して"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["何","なん"],["の"],["ため"],["に"],["、"],["香油","こうゆ"],["を"],["こんな"],["に"],["むだ"],["に"],["した"],["の"],["か"],["。"]]},{"verse":5,"text":"この香油なら、三百デナリ以上に売れて、貧しい人たちに施しができたのに。」そうして、その女をきびしく責めた。","tok":[["この"],["香油","こうゆ"],["なら"],["、"],["三百","みつお"],["デナリ"],["以上","いじょう"],["に"],["売れて","うれて"],["、"],["貧しい","まずしい"],["人","ひと"],["たち"],["に"],["施し","ほどこし"],["が"],["できた"],["のに"],["。"],["」"],["そう"],["して"],["、"],["その"],["女","おんな"],["を"],["きびしく"],["責めた","せめた"],["。"]]},{"verse":6,"text":"すると、イエスは言われた。「そのままにしておきなさい。なぜこの人を困らせるのですか。わたしのために、りっぱなことをしてくれたのです。","tok":[["する"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["そのまま"],["に"],["して"],["おき"],["なさい"],["。"],["なぜ"],["この"],["人","ひと"],["を"],["困らせる","こまらせる"],["の"],["です"],["か"],["。"],["わたし"],["の"],["ため"],["に"],["、"],["りっぱ"],["な"],["こと"],["を"],["して"],["くれた"],["の"],["です"],["。"]]},{"verse":7,"text":"貧しい人たちは、いつもあなたがたといっしょにいます。それで、あなたがたがしたいときは、いつでも彼らに良いことをしてやれます。しかし、わたしは、いつもあなたがたといっしょにいるわけではありません。","tok":[["貧しい","まずしい"],["人","ひと"],["たち"],["は"],["、"],["いつも"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["います"],["。"],["それ"],["で"],["、"],["あなた"],["がた"],["が"],["したい"],["とき"],["は"],["、"],["いつ"],["で"],["も"],["彼","かれ"],["ら"],["に"],["良い","よい"],["こと"],["を"],["して"],["やれます"],["。"],["しかし"],["、"],["わたし"],["は"],["、"],["いつも"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["いる"],["わけ"],["で"],["は"],["ありません"],["。"]]},{"verse":8,"text":"この女は、自分にできることをしたのです。埋葬の用意にと、わたしのからだに、前もって油を塗ってくれたのです。","tok":[["この"],["女","おんな"],["は"],["、"],["自分","じぶん"],["に"],["できる"],["こと"],["を"],["した"],["の"],["です"],["。"],["埋葬","まいそう"],["の"],["用意","ようい"],["に"],["と"],["、"],["わたし"],["の"],["からだ"],["に"],["、"],["前もって","まえもって"],["油","あぶら"],["を"],["塗って","ぬって"],["くれた"],["の"],["です"],["。"]]},{"verse":9,"text":"まことに、あなたがたに告げます。世界中のどこででも、福音が宣べ伝えられる所なら、この人のした事も語られて、この人の記念となるでしょう。」","tok":[["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["世界中","せかいじゅう"],["の"],["どこ"],["で"],["で"],["も"],["、"],["福音","ふくいん"],["が"],["宣べ伝えられる","のべつたえられる"],["所","ところ"],["なら"],["、"],["この"],["人","ひと"],["の"],["した"],["事","こと"],["も"],["語られて","かたられて"],["、"],["この"],["人","ひと"],["の"],["記念","きねん"],["と"],["なるでしょう"],["。"],["」"]]},{"verse":10,"text":"ところで、イスカリオテ・ユダは、十二弟子のひとりであるが、イエスを売ろうとして祭司長たちのところへ出向いて行った。","tok":[["ところ"],["で"],["、"],["イスカリオテ"],["・"],["ユダ"],["は"],["、"],["十二","じゅうに"],["弟子","でし"],["の"],["ひとり"],["で"],["ある"],["が"],["、"],["イエス"],["を"],["売ろう","うろう"],["として"],["祭司長","さいしちょう"],["たち"],["の"],["ところ"],["へ"],["出向いて","でむいて"],["行った","いった"],["。"]]},{"verse":11,"text":"彼らはこれを聞いて喜んで、金をやろうと約束した。そこでユダは、どうしたら、うまいぐあいにイエスを引き渡せるかと、ねらっていた。","tok":[["彼","かれ"],["ら"],["は"],["これ"],["を"],["聞いて","きいて"],["喜んで","よろこんで"],["、"],["金","きん"],["を"],["やろう"],["と"],["約束","やくそく"],["した"],["。"],["そこ"],["で"],["ユダ"],["は"],["、"],["どう"],["したら"],["、"],["うまい"],["ぐあい"],["に"],["イエス"],["を"],["引き渡せる","ひきわたせる"],["か"],["と"],["、"],["ねらって"],["いた"],["。"]]},{"verse":12,"text":"種なしパンの祝いの第一日、すなわち、過越の小羊をほふる日に、弟子たちはイエスに言った。「過越の食事をなさるのに、私たちは、どこへ行って用意をしましょうか。」","tok":[["種","しゅ"],["なし"],["パン"],["の"],["祝い","いわい"],["の"],["第","だい"],["一","いち"],["日","にち"],["、"],["すなわち"],["、"],["過越","すぎこし"],["の"],["小羊","こひつじ"],["を"],["ほふる"],["日","ひ"],["に"],["、"],["弟子","でし"],["たち"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["なさる"],["のに"],["、"],["私たち","わたしたち"],["は"],["、"],["どこ"],["へ"],["行って","いって"],["用意","ようい"],["を"],["しましょう"],["か"],["。"],["」"]]},{"verse":13,"text":"そこで、イエスは、弟子のうちふたりを送って、こう言われた。「都に入りなさい。そうすれば、水がめを運んでいる男に会うから、その人について行きなさい。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["、"],["弟子","でし"],["の"],["うち"],["ふたり"],["を"],["送って","おくって"],["、"],["こう"],["言われた","いわれた"],["。"],["「"],["都","と"],["に"],["入り","はいり"],["なさい"],["。"],["そう"],["すれば"],["、"],["水がめ","みずがめ"],["を"],["運んで","はこんで"],["いる"],["男","おとこ"],["に"],["会う","あう"],["から"],["、"],["その"],["人","ひと"],["について"],["行き","いき"],["なさい"],["。"]]},{"verse":14,"text":"そして、その人が入って行く家の主人に、『弟子たちといっしょに過越の食事をする、わたしの客間はどこか、と先生が言っておられる』と言いなさい。","tok":[["そして"],["、"],["その"],["人","ひと"],["が"],["入って","はいって"],["行く","いく"],["家","いえ"],["の"],["主人","しゅじん"],["に"],["、"],["『"],["弟子","でし"],["たち"],["と"],["いっしょ"],["に"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["する"],["、"],["わたし"],["の"],["客間","きゃくま"],["は"],["どこ"],["か"],["、"],["と"],["先生","せんせい"],["が"],["言って","いって"],["おられる"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":15,"text":"するとその主人が自分で、席が整って用意のできた二階の広間を見せてくれます。そこでわたしたちのために用意をしなさい。」","tok":[["する"],["と"],["その"],["主人","しゅじん"],["が"],["自分","じぶん"],["で"],["、"],["席","せき"],["が"],["整って","ととのって"],["用意","ようい"],["の"],["できた"],["二","に"],["階","かい"],["の"],["広間","ひろま"],["を"],["見せて","みせて"],["くれます"],["。"],["そこ"],["で"],["わたしたち"],["の"],["ため"],["に"],["用意","ようい"],["を"],["し"],["なさい"],["。"],["」"]]},{"verse":16,"text":"弟子たちが出かけて行って、都に入ると、まさしくイエスの言われたとおりであった。それで、彼らはそこで過越の食事の用意をした。","tok":[["弟子","でし"],["たち"],["が"],["出かけて","でかけて"],["行って","いって"],["、"],["都","と"],["に"],["入る","はいる"],["と"],["、"],["まさしく"],["イエス"],["の"],["言われた","いわれた"],["とおり"],["で"],["あった"],["。"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["そこ"],["で"],["過越","すぎこし"],["の"],["食事","しょくじ"],["の"],["用意","ようい"],["を"],["した"],["。"]]},{"verse":17,"text":"夕方になって、イエスは十二弟子といっしょにそこに来られた。","tok":[["夕方","ゆうがた"],["に"],["なって"],["、"],["イエス"],["は"],["十二","じゅうに"],["弟子","でし"],["と"],["いっしょ"],["に"],["そこ"],["に"],["来られた","こられた"],["。"]]},{"verse":18,"text":"そして、みなが席に着いて、食事をしているとき、イエスは言われた。「まことに、あなたがたに告げます。あなたがたのうちのひとりで、わたしといっしょに食事をしている者が、わたしを裏切ります。」","tok":[["そして"],["、"],["みな"],["が"],["席","せき"],["に"],["着いて","ついて"],["、"],["食事","しょくじ"],["を"],["して"],["いる"],["とき"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["あなた"],["がた"],["の"],["うち"],["の"],["ひとり"],["で"],["、"],["わたし"],["と"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["して"],["いる"],["者","もの"],["が"],["、"],["わたし"],["を"],["裏切ります","うらぎります"],["。"],["」"]]},{"verse":19,"text":"弟子たちは悲しくなって、「まさか私ではないでしょう」とかわるがわるイエスに言いだした。","tok":[["弟子","でし"],["たち"],["は"],["悲しく","かなしく"],["なって"],["、"],["「"],["まさか"],["私","わたくし"],["で"],["は"],["ないでしょう"],["」"],["と"],["かわるがわる"],["イエス"],["に"],["言い","いい"],["だした"],["。"]]},{"verse":20,"text":"イエスは言われた。「この十二人の中のひとりで、わたしといっしょに鉢に浸している者です。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["この"],["十二人","じゅうににん"],["の"],["中","なか"],["の"],["ひとり"],["で"],["、"],["わたし"],["と"],["いっしょ"],["に"],["鉢","ばち"],["に"],["浸して","ひたして"],["いる"],["者","もの"],["です"],["。"]]},{"verse":21,"text":"確かに、人の子は、自分について書いてあるとおりに、去って行きます。しかし、人の子を裏切るような人間はわざわいです。そういう人は生まれなかったほうがよかったのです。」","tok":[["確か","たしか"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["自分","じぶん"],["について"],["書いて","かいて"],["ある"],["とおり"],["に"],["、"],["去って","さって"],["行きます","いきます"],["。"],["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["を"],["裏切る","うらぎる"],["よう"],["な"],["人間","にんげん"],["は"],["わざわい"],["です"],["。"],["そう"],["いう"],["人","ひと"],["は"],["生まれなかった","うまれなかった"],["ほう"],["が"],["よかった"],["の"],["です"],["。"],["」"]]},{"verse":22,"text":"それから、みなが食事をしているとき、イエスはパンを取り、祝福して後、これを裂き、彼らに与えて言われた。「取りなさい。これはわたしのからだです。」","tok":[["それ"],["から"],["、"],["みな"],["が"],["食事","しょくじ"],["を"],["して"],["いる"],["とき"],["、"],["イエス"],["は"],["パン"],["を"],["取り","とり"],["、"],["祝福","しゅくふく"],["して"],["後","あと"],["、"],["これ"],["を"],["裂き","さき"],["、"],["彼","かれ"],["ら"],["に"],["与えて","あたえて"],["言われた","いわれた"],["。"],["「"],["取り","とり"],["なさい"],["。"],["これ"],["は"],["わたし"],["の"],["からだ"],["です"],["。"],["」"]]},{"verse":23,"text":"また、杯を取り、感謝をささげて後、彼らに与えられた。彼らはみなその杯から飲んだ。","tok":[["また"],["、"],["杯","さかずき"],["を"],["取り","とり"],["、"],["感謝","かんしゃ"],["を"],["ささげて"],["後","あと"],["、"],["彼","かれ"],["ら"],["に"],["与えられた","あたえられた"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["その"],["杯","さかずき"],["から"],["飲んだ","のんだ"],["。"]]},{"verse":24,"text":"イエスは彼らに言われた。「これはわたしの契約の血です。多くの人のために流されるものです。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["これ"],["は"],["わたし"],["の"],["契約","けいやく"],["の"],["血","ち"],["です"],["。"],["多く","おおく"],["の"],["人","ひと"],["の"],["ため"],["に"],["流される","ながされる"],["もの"],["です"],["。"]]},{"verse":25,"text":"まことに、あなたがたに告げます。神の国で新しく飲むその日までは、わたしはもはや、ぶどうの実で造った物を飲むことはありません。」","tok":[["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["神","かみ"],["の"],["国","くに"],["で"],["新しく","あたらしく"],["飲む","のむ"],["その"],["日","ひ"],["まで"],["は"],["、"],["わたし"],["は"],["もはや"],["、"],["ぶどう"],["の"],["実","じつ"],["で"],["造った","つくった"],["物","もの"],["を"],["飲む","のむ"],["こと"],["は"],["ありません"],["。"],["」"]]},{"verse":26,"text":"そして、賛美の歌を歌ってから、みなでオリーブ山へ出かけて行った。","tok":[["そして"],["、"],["賛美","さんび"],["の"],["歌","うた"],["を"],["歌って","うたって"],["から"],["、"],["みな"],["で"],["オリーブ"],["山","さん"],["へ"],["出かけて","でかけて"],["行った","いった"],["。"]]},{"verse":27,"text":"イエスは、弟子たちに言われた。「あなたがたはみな、つまずきます。『わたしが羊飼いを打つ。すると、羊は散り散りになる』と書いてありますから。","tok":[["イエス"],["は"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["は"],["みな"],["、"],["つまずきます"],["。"],["『"],["わたし"],["が"],["羊飼い","ひつじかい"],["を"],["打つ","うつ"],["。"],["する"],["と"],["、"],["羊","ひつじ"],["は"],["散り散り","ちりじり"],["に"],["なる"],["』"],["と"],["書いて","かいて"],["あります"],["から"],["。"]]},{"verse":28,"text":"しかしわたしは、よみがえってから、あなたがたより先に、ガリラヤへ行きます。」","tok":[["しかし"],["わたし"],["は"],["、"],["よみがえって"],["から"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["、"],["ガリラヤ"],["へ"],["行きます","いきます"],["。"],["」"]]},{"verse":29,"text":"すると、ペテロがイエスに言った。「たとい全部の者がつまずいても、私はつまずきません。」","tok":[["する"],["と"],["、"],["ペテロ"],["が"],["イエス"],["に"],["言った","いった"],["。"],["「"],["たとい"],["全部","ぜんぶ"],["の"],["者","もの"],["が"],["つまずいて"],["も"],["、"],["私","わたくし"],["は"],["つまずきません"],["。"],["」"]]},{"verse":30,"text":"イエスは彼に言われた。「まことに、あなたに告げます。あなたは、きょう、今夜、鶏が二度鳴く前に、わたしを知らないと三度言います。」","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["あなた"],["に"],["告げます","つげます"],["。"],["あなた"],["は"],["、"],["きょう"],["、"],["今夜","こんや"],["、"],["鶏","にわとり"],["が"],["二","に"],["度","ど"],["鳴く","なく"],["前","まえ"],["に"],["、"],["わたし"],["を"],["知らない","しらない"],["と"],["三","さん"],["度","ど"],["言います","いいます"],["。"],["」"]]},{"verse":31,"text":"ペテロは力を込めて言い張った。「たとい、ごいっしょに死ななければならないとしても、私は、あなたを知らないなどとは決して申しません。」みなの者もそう言った。","tok":[["ペテロ"],["は"],["力","ちから"],["を"],["込めて","こめて"],["言い張った","いいはった"],["。"],["「"],["たとい"],["、"],["ごいっしょ"],["に"],["死ななければ","しななければ"],["ならない"],["として"],["も"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["を"],["知らない","しらない"],["など"],["と"],["は"],["決して","けっして"],["申しません","もうしません"],["。"],["」"],["みな"],["の"],["者","もの"],["も"],["そう"],["言った","いった"],["。"]]},{"verse":32,"text":"ゲツセマネという所に来て、イエスは弟子たちに言われた。「わたしが祈る間、ここにすわっていなさい。」","tok":[["ゲツセマネ"],["と"],["いう"],["所","ところ"],["に"],["来て","きて"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["が"],["祈る","いのる"],["間","あいだ"],["、"],["ここ"],["に"],["すわって"],["い"],["なさい"],["。"],["」"]]},{"verse":33,"text":"そして、ペテロ、ヤコブ、ヨハネをいっしょに連れて行かれた。イエスは深く恐れもだえ始められた。","tok":[["そして"],["、"],["ペテロ"],["、"],["
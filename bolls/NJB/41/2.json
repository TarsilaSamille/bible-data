[{"verse":1,"text":"数日たって、イエスがカペナウムにまた来られると、家におられることが知れ渡った。","tok":[["数日","すうじつ"],["たって"],["、"],["イエス"],["が"],["カペナウム"],["に"],["また"],["来られる","こられる"],["と"],["、"],["家","いえ"],["に"],["おられる"],["こと"],["が"],["知れ渡った","しれわたった"],["。"]]},{"verse":2,"text":"それで多くの人が集まったため、戸口のところまですきまもないほどになった。この人たちに、イエスはみことばを話しておられた。","tok":[["それ"],["で"],["多く","おおく"],["の"],["人","ひと"],["が"],["集まった","あつまった"],["ため"],["、"],["戸口","とぐち"],["の"],["ところ"],["まで"],["すきま"],["も"],["ない"],["ほど"],["に"],["なった"],["。"],["この"],["人","ひと"],["たち"],["に"],["、"],["イエス"],["は"],["みことば"],["を"],["話して","はなして"],["おられた"],["。"]]},{"verse":3,"text":"そのとき、ひとりの中風の人が四人の人にかつがれて、みもとに連れて来られた。","tok":[["その"],["とき"],["、"],["ひとり"],["の"],["中風","ちゅうぶ"],["の"],["人","ひと"],["が"],["四人","よんにん"],["の"],["人","ひと"],["に"],["かつがれて"],["、"],["みもと"],["に"],["連れて","つれて"],["来られた","こられた"],["。"]]},{"verse":4,"text":"群衆のためにイエスに近づくことができなかったので、その人々はイエスのおられるあたりの屋根をはがし、穴をあけて、中風の人を寝かせたままその床をつり降ろした。","tok":[["群衆","ぐんしゅう"],["の"],["ため"],["に"],["イエス"],["に"],["近づく","ちかづく"],["こと"],["が"],["できなかった"],["ので"],["、"],["その"],["人々","ひとびと"],["は"],["イエス"],["の"],["おられる"],["あたり"],["の"],["屋根","やね"],["を"],["はがし"],["、"],["穴","あな"],["を"],["あけて"],["、"],["中風","ちゅうぶ"],["の"],["人","ひと"],["を"],["寝かせた","ねかせた"],["まま"],["その"],["床","ゆか"],["を"],["つり"],["降ろした","おろした"],["。"]]},{"verse":5,"text":"イエスは彼らの信仰を見て、中風の人に、「子よ。あなたの罪は赦されました」と言われた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["の"],["信仰","しんこう"],["を"],["見て","みて"],["、"],["中風","ちゅうぶ"],["の"],["人","ひと"],["に"],["、"],["「"],["子","こ"],["よ"],["。"],["あなた"],["の"],["罪","つみ"],["は"],["赦されました","ゆるされました"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":6,"text":"ところが、その場に律法学者が数人すわっていて、心の中で理屈を言った。","tok":[["ところ"],["が"],["、"],["その"],["場","ば"],["に"],["律法学者","りっぽうがくしゃ"],["が"],["数人","すうにん"],["すわって"],["いて"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["理屈","りくつ"],["を"],["言った","いった"],["。"]]},{"verse":7,"text":"「この人は、なぜ、あんなことを言うのか。神をけがしているのだ。神おひとりのほか、だれが罪を赦すことができよう。」","tok":[["「"],["この"],["人","ひと"],["は"],["、"],["なぜ"],["、"],["あんな"],["こと"],["を"],["言う","いう"],["の"],["か"],["。"],["神","かみ"],["を"],["けがして"],["いる"],["の"],["だ"],["。"],["神","かみ"],["おひとり"],["の"],["ほか"],["、"],["だれ"],["が"],["罪","つみ"],["を"],["赦す","ゆるす"],["こと"],["が"],["できよう"],["。"],["」"]]},{"verse":8,"text":"彼らが心の中でこのように理屈を言っているのを、イエスはすぐにご自分の霊で見抜いて、こう言われた。「なぜ、あなたがたは心の中でそんな理屈を言っているのか。","tok":[["彼","かれ"],["ら"],["が"],["心","こころ"],["の"],["中","なか"],["で"],["この"],["よう"],["に"],["理屈","りくつ"],["を"],["言って","いって"],["いる"],["の"],["を"],["、"],["イエス"],["は"],["すぐ"],["に"],["ご自分","ごじぶん"],["の"],["霊","れい"],["で"],["見抜いて","みぬいて"],["、"],["こう"],["言われた","いわれた"],["。"],["「"],["なぜ"],["、"],["あなた"],["がた"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["そんな"],["理屈","りくつ"],["を"],["言って","いって"],["いる"],["の"],["か"],["。"]]},{"verse":9,"text":"中風の人に、『あなたの罪は赦された』と言うのと、『起きて、寝床をたたんで歩け』と言うのと、どちらがやさしいか。","tok":[["中風","ちゅうぶ"],["の"],["人","ひと"],["に"],["、"],["『"],["あなた"],["の"],["罪","つみ"],["は"],["赦された","ゆるされた"],["』"],["と"],["言う","いう"],["の"],["と"],["、"],["『"],["起きて","おきて"],["、"],["寝床","ねどこ"],["を"],["たたんで"],["歩け","あるけ"],["』"],["と"],["言う","いう"],["の"],["と"],["、"],["どちら"],["が"],["やさしい"],["か"],["。"]]},{"verse":10,"text":"人の子が地上で罪を赦す権威を持っていることを、あなたがたに知らせるために。」こう言ってから、中風の人に、","tok":[["人","ひと"],["の"],["子","こ"],["が"],["地上","ちじょう"],["で"],["罪","つみ"],["を"],["赦す","ゆるす"],["権威","けんい"],["を"],["持って","もって"],["いる"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["知らせる","しらせる"],["ため"],["に"],["。"],["」"],["こう"],["言って","いって"],["から"],["、"],["中風","ちゅうぶ"],["の"],["人","ひと"],["に"],["、"]]},{"verse":11,"text":"「あなたに言う。起きなさい。寝床をたたんで、家に帰りなさい」と言われた。","tok":[["「"],["あなた"],["に"],["言う","ゆう"],["。"],["起き","おき"],["なさい"],["。"],["寝床","ねどこ"],["を"],["たたんで"],["、"],["家","いえ"],["に"],["帰り","かえり"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":12,"text":"すると彼は起き上がり、すぐに床を取り上げて、みなの見ている前を出て行った。それでみなの者がすっかり驚いて、「こういうことは、かつて見たことがない」と言って神をあがめた。","tok":[["する"],["と"],["彼","かれ"],["は"],["起き上がり","おきあがり"],["、"],["すぐ"],["に"],["床","ゆか"],["を"],["取り上げて","とりあげて"],["、"],["みな"],["の"],["見て","みて"],["いる"],["前","まえ"],["を"],["出て","でて"],["行った","いった"],["。"],["それ"],["で"],["みな"],["の"],["者","もの"],["が"],["すっかり"],["驚いて","おどろいて"],["、"],["「"],["こう"],["いう"],["こと"],["は"],["、"],["かつて"],["見た","みた"],["こと"],["が"],["ない"],["」"],["と"],["言って","いって"],["神","かみ"],["を"],["あがめた"],["。"]]},{"verse":13,"text":"イエスはまた湖のほとりに出て行かれた。すると群衆がみな、みもとにやって来たので、彼らに教えられた。","tok":[["イエス"],["は"],["また"],["湖","みずうみ"],["の"],["ほとり"],["に"],["出て","でて"],["行かれた","いかれた"],["。"],["する"],["と"],["群衆","ぐんしゅう"],["が"],["みな"],["、"],["みもと"],["に"],["やって"],["来た","きた"],["ので"],["、"],["彼","かれ"],["ら"],["に"],["教えられた","おしえられた"],["。"]]},{"verse":14,"text":"イエスは、道を通りながら、アルパヨの子レビが収税所にすわっているのをご覧になって、「わたしについて来なさい」と言われた。すると彼は立ち上がって従った。","tok":[["イエス"],["は"],["、"],["道","みち"],["を"],["通り","とおり"],["ながら"],["、"],["アルパヨ"],["の"],["子","こ"],["レビ"],["が"],["収税所","しゅうぜいしょ"],["に"],["すわって"],["いる"],["の"],["を"],["ご覧","ごらん"],["に"],["なって"],["、"],["「"],["わたし"],["について"],["来","き"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["彼","かれ"],["は"],["立ち上がって","たちあがって"],["従った","したがった"],["。"]]},{"verse":15,"text":"それから、イエスは、彼の家で食卓に着かれた。取税人や罪人たちも大ぜい、イエスや弟子たちといっしょに食卓に着いていた。こういう人たちが大ぜいいて、イエスに従っていたのである。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["、"],["彼","かれ"],["の"],["家","いえ"],["で"],["食卓","しょくたく"],["に"],["着かれた","つかれた"],["。"],["取","とり"],["税人","ぜいにん"],["や"],["罪人","ざいにん"],["たち"],["も"],["大ぜい","おおぜい"],["、"],["イエス"],["や"],["弟子","でし"],["たち"],["と"],["いっしょ"],["に"],["食卓","しょくたく"],["に"],["着いて","ついて"],["いた"],["。"],["こう"],["いう"],["人","ひと"],["たち"],["が"],["大ぜい","おおぜい"],["いて"],["、"],["イエス"],["に"],["従って","したがって"],["いた"],["ので"],["ある"],["。"]]},{"verse":16,"text":"パリサイ派の律法学者たちは、イエスが罪人や取税人たちといっしょに食事をしておられるのを見て、イエスの弟子たちにこう言った。「なぜ、あの人は取税人や罪人たちといっしょに食事をするのですか。」","tok":[["パリサイ"],["派","は"],["の"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["イエス"],["が"],["罪人","ざいにん"],["や"],["取","とり"],["税人","ぜいにん"],["たち"],["と"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["して"],["おられる"],["の"],["を"],["見て","みて"],["、"],["イエス"],["の"],["弟子","でし"],["たち"],["に"],["こう"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["あの"],["人","ひと"],["は"],["取","とり"],["税人","ぜいにん"],["や"],["罪人","ざいにん"],["たち"],["と"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":17,"text":"イエスはこれを聞いて、彼らにこう言われた。「医者を必要とするのは丈夫な者ではなく、病人です。わたしは正しい人を招くためではなく、罪人を招くために来たのです。」","tok":[["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["彼","かれ"],["ら"],["に"],["こう"],["言われた","いわれた"],["。"],["「"],["医者","いしゃ"],["を"],["必要","ひつよう"],["と"],["する"],["の"],["は"],["丈夫","じょうぶ"],["な"],["者","もの"],["で"],["は"],["なく"],["、"],["病人","びょうにん"],["です"],["。"],["わたし"],["は"],["正しい","ただしい"],["人","ひと"],["を"],["招く","まねく"],["ため"],["で"],["は"],["なく"],["、"],["罪人","ざいにん"],["を"],["招く","まねく"],["ため"],["に"],["来た","きた"],["の"],["です"],["。"],["」"]]},{"verse":18,"text":"ヨハネの弟子たちとパリサイ人たちは断食をしていた。そして、イエスのもとに来て言った。「ヨハネの弟子たちやパリサイ人の弟子たちは断食するのに、あなたの弟子たちはなぜ断食しないのですか。」","tok":[["ヨハネ"],["の"],["弟子","でし"],["たち"],["と"],["パリサイ"],["人","にん"],["たち"],["は"],["断食","だんじき"],["を"],["して"],["いた"],["。"],["そして"],["、"],["イエス"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["ヨハネ"],["の"],["弟子","でし"],["たち"],["や"],["パリサイ"],["人","にん"],["の"],["弟子","でし"],["たち"],["は"],["断食","だんじき"],["する"],["のに"],["、"],["あなた"],["の"],["弟子","でし"],["たち"],["は"],["なぜ"],["断食","だんじき"],["しない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":19,"text":"イエスは彼らに言われた。「花婿が自分たちといっしょにいる間、花婿につき添う友だちが断食できるでしょうか。花婿といっしょにいる時は、断食できないのです。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["花婿","はなむこ"],["が"],["自分","じぶん"],["たち"],["と"],["いっしょ"],["に"],["いる"],["間","あいだ"],["、"],["花婿","はなむこ"],["に"],["つき添う","つきそう"],["友だち","ともだち"],["が"],["断食","だんじき"],["できるでしょう"],["か"],["。"],["花婿","はなむこ"],["と"],["いっしょ"],["に"],["いる"],["時","とき"],["は"],["、"],["断食","だんじき"],["できない"],["の"],["です"],["。"]]},{"verse":20,"text":"しかし、花婿が彼らから取り去られる時が来ます。その日には断食します。","tok":[["しかし"],["、"],["花婿","はなむこ"],["が"],["彼","かれ"],["ら"],["から"],["取り去られる","とりさられる"],["時","とき"],["が"],["来ます","きます"],["。"],["その"],["日","ひ"],["に"],["は"],["断食","だんじき"],["します"],["。"]]},{"verse":21,"text":"だれも、真新しい布切れで古い着物の継ぎをするようなことはしません。そんなことをすれば、新しい継ぎ切れは古い着物を引き裂き、破れはもっとひどくなります。","tok":[["だれ"],["も"],["、"],["真新しい","まあたらしい"],["布切れ","ぬのきれ"],["で"],["古い","ふるい"],["着物","きもの"],["の"],["継ぎ","つぎ"],["を"],["する"],["よう"],["な"],["こと"],["は"],["しません"],["。"],["そんな"],["こと"],["を"],["すれば"],["、"],["新しい","あたらしい"],["継ぎ","つぎ"],["切れ","きれ"],["は"],["古い","ふるい"],["着物","きもの"],["を"],["引き裂き","ひきさき"],["、"],["破れ","やぶれ"],["は"],["もっと"],["ひどく"],["なります"],["。"]]},{"verse":22,"text":"また、だれも新しいぶどう酒を古い皮袋に入れるようなことはしません。そんなことをすれば、ぶどう酒は皮袋を張り裂き、ぶどう酒も皮袋もだめになってしまいます。新しいぶどう酒は新しい皮袋に入れるのです。」","tok":[["また"],["、"],["だれ"],["も"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["を"],["古い","ふるい"],["皮袋","かわぶくろ"],["に"],["入れる","いれる"],["よう"],["な"],["こと"],["は"],["しません"],["。"],["そんな"],["こと"],["を"],["すれば"],["、"],["ぶどう酒","ぶどうしゅ"],["は"],["皮袋","かわぶくろ"],["を"],["張り","はり"],["裂き","さき"],["、"],["ぶどう酒","ぶどうしゅ"],["も"],["皮袋","かわぶくろ"],["も"],["だめ"],["に"],["なって"],["しまいます"],["。"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["は"],["新しい","あたらしい"],["皮袋","かわぶくろ"],["に"],["入れる","いれる"],["の"],["です"],["。"],["」"]]},{"verse":23,"text":"ある安息日のこと、イエスは麦畑の中を通って行かれた。すると、弟子たちが道々穂を摘み始めた。","tok":[["ある"],["安息日","あんそくび"],["の"],["こと"],["、"],["イエス"],["は"],["麦畑","むぎばたけ"],["の"],["中","なか"],["を"],["通って","とおって"],["行かれた","いかれた"],["。"],["する"],["と"],["、"],["弟子","でし"],["たち"],["が"],["道々","みちみち"],["穂","ほ"],["を"],["摘み","つみ"],["始めた","はじめた"],["。"]]},{"verse":24,"text":"すると、パリサイ人たちがイエスに言った。「ご覧なさい。なぜ彼らは、安息日なのに、してはならないことをするのですか。」","tok":[["する"],["と"],["、"],["パリサイ"],["人","にん"],["たち"],["が"],["イエス"],["に"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["なさい"],["。"],["なぜ"],["彼","かれ"],["ら"],["は"],["、"],["安息日","あんそくび"],["な"],["のに"],["、"],["して"],["は"],["ならない"],["こと"],["を"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":25,"text":"イエスは彼らに言われた。「ダビデとその連れの者たちが、食物がなくてひもじかったとき、ダビデが何をしたか、読まなかったのですか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["ダビデ"],["と"],["その"],["連れ","つれ"],["の"],["者","もの"],["たち"],["が"],["、"],["食物","しょくもつ"],["が"],["なくて"],["ひもじかった"],["とき"],["、"],["ダビデ"],["が"],["何","なん"],["を"],["した"],["か"],["、"],["読まなかった","よまなかった"],["の"],["です"],["か"],["。"]]},{"verse":26,"text":"アビヤタルが大祭司のころ、ダビデは神の家に入って、祭司以外の者が食べてはならない供えのパンを、自分も食べ、またともにいた者たちにも与えたではありませんか。」","tok":[["アビヤタル"],["が"],["大","だい"],["祭司","さいし"],["の"],["ころ"],["、"],["ダビデ"],["は"],["神","かみ"],["の"],["家","いえ"],["に"],["入って","はいって"],["、"],["祭司","さいし"],["以外","いがい"],["の"],["者","もの"],["が"],["食べて","たべて"],["は"],["ならない"],["供え","そなえ"],["の"],["パン"],["を"],["、"],["自分","じぶん"],["も"],["食べ","たべ"],["、"],["また"],["とも"],["に"],["いた"],["者","もの"],["たち"],["に"],["も"],["与えたで","あたえたで"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":27,"text":"また言われた。「安息日は人間のために設けられたのです。人間が安息日のために造られたのではありません。","tok":[["また"],["言われた","いわれた"],["。"],["「"],["安息日","あんそくび"],["は"],["人間","にんげん"],["の"],["ため"],["に"],["設けられた","もうけられた"],["の"],["です"],["。"],["人間","にんげん"],["が"],["安息日","あんそくび"],["の"],["ため"],["に"],["造られた","つくられた"],["ので"],["は"],["ありません"],["。"]]},{"verse":28,"text":"人の子は安息日にも主です。」","tok":[["人","ひと"],["の"],["子","こ"],["は"],["安息日","あんそくび"],["に"],["も"],["主","ぬし"],["です"],["。"],["」"]]}]
tok":[["そこ"],["で"],["は"],["、"],["彼","かれ"],["ら"],["を"],["食う","くう"],["うじ"],["は"],["、"],["尽きる","つきる"],["こと"],["が"],["なく"],["、"],["火","ひ"],["は"],["消える","きえる"],["こと"],["が"],["ありません"],["。"]]},{"verse":49,"text":"すべては、火によって、塩けをつけられるのです。","tok":[["すべて"],["は"],["、"],["火","ひ"],["によって"],["、"],["塩け","しおけ"],["を"],["つけられる"],["の"],["です"],["。"]]},{"verse":50,"text":"塩は、ききめのあるものです。しかし、もし塩に塩けがなくなったら、何によって塩けを取り戻せましょう。あなたがたは、自分自身のうちに塩けを保ちなさい。そして、互いに和合して暮らしなさい。」","tok":[["塩","しお"],["は"],["、"],["きき"],["め"],["の"],["ある"],["もの"],["です"],["。"],["しかし"],["、"],["もし"],["塩","しお"],["に"],["塩け","しおけ"],["が"],["なくなったら"],["、"],["何","なん"],["によって"],["塩け","しおけ"],["を"],["取り戻せましょう","とりもどせましょう"],["。"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["の"],["うち"],["に"],["塩け","しおけ"],["を"],["保ち","たもち"],["なさい"],["。"],["そして"],["、"],["互い","たがい"],["に"],["和合","わごう"],["して"],["暮らし","くらし"],["なさい"],["。"],["」"]]}]
[{"verse":1,"text":"イエスは彼らに言われた。「まことに、あなたがたに告げます。ここに立っている人々の中には、神の国が力をもって到来しているのを見るまでは、決して死を味わわない者がいます。」","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["ここ"],["に"],["立って","たって"],["いる"],["人々","ひとびと"],["の"],["中","なか"],["に"],["は"],["、"],["神","かみ"],["の"],["国","くに"],["が"],["力","ちから"],["を"],["もって"],["到来","とうらい"],["して"],["いる"],["の"],["を"],["見る","みる"],["まで"],["は"],["、"],["決して","けっして"],["死","し"],["を"],["味わわない","あじわわない"],["者","もの"],["が"],["います"],["。"],["」"]]},{"verse":2,"text":"それから六日たって、イエスは、ペテロとヤコブとヨハネだけを連れて、高い山に導いて行かれた。そして彼らの目の前で御姿が変わった。","tok":[["それ"],["から"],["六日","むいか"],["たって"],["、"],["イエス"],["は"],["、"],["ペテロ"],["と"],["ヤコブ"],["と"],["ヨハネ"],["だけ"],["を"],["連れて","つれて"],["、"],["高い","たかい"],["山","やま"],["に"],["導いて","みちびいて"],["行かれた","いかれた"],["。"],["そして"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["御姿","おすがた"],["が"],["変わった","かわった"],["。"]]},{"verse":3,"text":"その御衣は、非常に白く光り、世のさらし屋では、とてもできないほどの白さであった。","tok":[["その"],["御衣","ぎょい"],["は"],["、"],["非常","ひじょう"],["に"],["白く","しろく"],["光り","ひかり"],["、"],["世","よ"],["の"],["さらし屋","さらしや"],["で"],["は"],["、"],["とても"],["できない"],["ほど"],["の"],["白","しろ"],["さ"],["で"],["あった"],["。"]]},{"verse":4,"text":"また、エリヤが、モーセとともに現れ、彼らはイエスと語り合っていた。","tok":[["また"],["、"],["エリヤ"],["が"],["、"],["モーセ"],["と"],["とも"],["に"],["現れ","あらわれ"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["と"],["語り合って","かたりあって"],["いた"],["。"]]},{"verse":5,"text":"すると、ペテロが口出ししてイエスに言った。「先生。私たちがここにいることは、すばらしいことです。私たちが、幕屋を三つ造ります。あなたのために一つ、モーセのために一つ、エリヤのために一つ。」","tok":[["する"],["と"],["、"],["ペテロ"],["が"],["口出し","くちだし"],["して"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["私たち","わたしたち"],["が"],["ここ"],["に"],["いる"],["こと"],["は"],["、"],["すばらしい"],["こと"],["です"],["。"],["私たち","わたしたち"],["が"],["、"],["幕屋","まくや"],["を"],["三","みっ"],["つ"],["造ります","つくります"],["。"],["あなた"],["の"],["ため"],["に"],["一","ひと"],["つ"],["、"],["モーセ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["、"],["エリヤ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["。"],["」"]]},{"verse":6,"text":"実のところ、ペテロは言うべきことがわからなかったのである。彼らは恐怖に打たれたのであった。","tok":[["実","じつ"],["の"],["ところ"],["、"],["ペテロ"],["は"],["言うべき","ゆうべき"],["こと"],["が"],["わからなかった"],["ので"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["恐怖","きょうふ"],["に"],["打たれた","うたれた"],["ので"],["あった"],["。"]]},{"verse":7,"text":"そのとき雲がわき起こってその人々をおおい、雲の中から、「これは、わたしの愛する子である。彼の言うことを聞きなさい」と言う声がした。","tok":[["その"],["とき"],["雲","くも"],["が"],["わき起こって","わきおこって"],["その"],["人々","ひとびと"],["を"],["おおい"],["、"],["雲","くも"],["の"],["中","なか"],["から"],["、"],["「"],["これ"],["は"],["、"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["で"],["ある"],["。"],["彼","かれ"],["の"],["言う","いう"],["こと"],["を"],["聞き","きき"],["なさい"],["」"],["と"],["言う","いう"],["声","こえ"],["が"],["した"],["。"]]},{"verse":8,"text":"彼らが急いであたりを見回すと、自分たちといっしょにいるのはイエスだけで、そこにはもはやだれも見えなかった。","tok":[["彼","かれ"],["ら"],["が"],["急いで","いそいで"],["あたり"],["を"],["見回す","みまわす"],["と"],["、"],["自分","じぶん"],["たち"],["と"],["いっしょ"],["に"],["いる"],["の"],["は"],["イエス"],["だけ"],["で"],["、"],["そこ"],["に"],["は"],["もはや"],["だれ"],["も"],["見えなかった","みえなかった"],["。"]]},{"verse":9,"text":"さて、山を降りながら、イエスは彼らに、人の子が死人の中からよみがえるときまでは、いま見たことをだれにも話してはならない、と特に命じられた。","tok":[["さて"],["、"],["山","やま"],["を"],["降り","おり"],["ながら"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえる"],["とき"],["まで"],["は"],["、"],["いま"],["見た","みた"],["こと"],["を"],["だれ"],["に"],["も"],["話して","はなして"],["は"],["ならない"],["、"],["と"],["特に","とくに"],["命じられた","めいじられた"],["。"]]},{"verse":10,"text":"そこで彼らは、そのおことばを心に堅く留め、死人の中からよみがえると言われたことはどういう意味かを論じ合った。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["その"],["おことば"],["を"],["心","こころ"],["に"],["堅く","かたく"],["留め","とめ"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえる"],["と"],["言われた","いわれた"],["こと"],["は"],["どういう"],["意味","いみ"],["か"],["を"],["論じ合った","ろんじあった"],["。"]]},{"verse":11,"text":"彼らはイエスに尋ねて言った。「律法学者たちは、まずエリヤが来るはずだと言っていますが、それはなぜでしょうか。」","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["まず"],["エリヤ"],["が"],["来る","くる"],["はず"],["だ"],["と"],["言って","いって"],["います"],["が"],["、"],["それ"],["は"],["なぜ"],["でしょう"],["か"],["。"],["」"]]},{"verse":12,"text":"イエスは言われた。「エリヤがまず来て、すべてのことを立て直します。では、人の子について、多くの苦しみを受け、さげすまれると書いてあるのは、どうしてなのですか。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["エリヤ"],["が"],["まず"],["来て","きて"],["、"],["すべて"],["の"],["こと"],["を"],["立て直します","たてなおします"],["。"],["で"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["について"],["、"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["さげすまれる"],["と"],["書いて","かいて"],["ある"],["の"],["は"],["、"],["どう"],["して"],["な"],["の"],["です"],["か"],["。"]]},{"verse":13,"text":"しかし、あなたがたに告げます。エリヤはもう来たのです。そして人々は、彼について書いてあるとおりに、好き勝手なことを彼にしたのです。」","tok":[["しかし"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["エリヤ"],["は"],["もう"],["来た","きた"],["の"],["です"],["。"],["そして"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["について"],["書いて","かいて"],["ある"],["とおり"],["に"],["、"],["好き勝手","すきかって"],["な"],["こと"],["を"],["彼","かれ"],["に"],["した"],["の"],["です"],["。"],["」"]]},{"verse":14,"text":"さて、彼らが、弟子たちのところに帰って来て、見ると、その回りに大ぜいの人の群れがおり、また、律法学者たちが弟子たちと論じ合っていた。","tok":[["さて"],["、"],["彼","かれ"],["ら"],["が"],["、"],["弟子","でし"],["たち"],["の"],["ところ"],["に"],["帰って","かえって"],["来て","きて"],["、"],["見る","みる"],["と"],["、"],["その"],["回り","まわり"],["に"],["大ぜい","おおぜい"],["の"],["人","ひと"],["の"],["群れ","むれ"],["が"],["おり"],["、"],["また"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["弟子","でし"],["たち"],["と"],["論じ合って","ろんじあって"],["いた"],["。"]]},{"verse":15,"text":"そしてすぐ、群衆はみな、イエスを見ると驚き、走り寄って来て、あいさつをした。","tok":[["そして"],["すぐ"],["、"],["群衆","ぐんしゅう"],["は"],["みな"],["、"],["イエス"],["を"],["見る","みる"],["と"],["驚き","おどろき"],["、"],["走り寄って","はしりよって"],["来て","きて"],["、"],["あいさつ"],["を"],["した"],["。"]]},{"verse":16,"text":"イエスは彼らに、「あなたがたは弟子たちと何を議論しているのですか」と聞かれた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["、"],["「"],["あなた"],["がた"],["は"],["弟子","でし"],["たち"],["と"],["何","なん"],["を"],["議論","ぎろん"],["して"],["いる"],["の"],["です"],["か"],["」"],["と"],["聞かれた","きかれた"],["。"]]},{"verse":17,"text":"すると群衆のひとりが、イエスに答えて言った。「先生。口をきけなくする霊につかれた私の息子を、先生のところに連れて来ました。","tok":[["する"],["と"],["群衆","ぐんしゅう"],["の"],["ひとり"],["が"],["、"],["イエス"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["口","くち"],["を"],["きけなく"],["する"],["霊","れい"],["に"],["つかれた"],["私","わたくし"],["の"],["息子","むすこ"],["を"],["、"],["先生","せんせい"],["の"],["ところ"],["に"],["連れて","つれて"],["来ました","きました"],["。"]]},{"verse":18,"text":"その霊が息子にとりつくと、所かまわず彼を押し倒します。そして彼はあわを吹き、歯ぎしりして、からだをこわばらせます。それでお弟子たちに、霊を追い出すよう願ったのですが、できませんでした。」","tok":[["その"],["霊","れい"],["が"],["息子","むすこ"],["に"],["とりつく"],["と"],["、"],["所","ところ"],["かまわず"],["彼","かれ"],["を"],["押し倒します","おしたおします"],["。"],["そして"],["彼","かれ"],["は"],["あわ"],["を"],["吹き","ふき"],["、"],["歯ぎしり","はぎしり"],["して"],["、"],["からだ"],["を"],["こわばらせます"],["。"],["それ"],["で"],["お弟子","おでし"],["たち"],["に"],["、"],["霊","れい"],["を"],["追い出す","おいだす"],["よう"],["願った","ねがった"],["の"],["です"],["が"],["、"],["できませんでした"],["。"],["」"]]},{"verse":19,"text":"イエスは答えて言われた。「ああ、不信仰な世だ。いつまであなたがたといっしょにいなければならないのでしょう。いつまであなたがたにがまんしていなければならないのでしょう。その子をわたしのところに連れて来なさい。」","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["ああ"],["、"],["不","ふ"],["信仰","しんこう"],["な"],["世","よ"],["だ"],["。"],["いつ"],["まで"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["いなければ"],["ならない"],["の"],["でしょう"],["。"],["いつ"],["まで"],["あなた"],["がた"],["に"],["がまん"],["して"],["いなければ"],["ならない"],["の"],["でしょう"],["。"],["その"],["子","こ"],["を"],["わたし"],["の"],["ところ"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"],["」"]]},{"verse":20,"text":"そこで、人々はイエスのところにその子を連れて来た。その子がイエスを見ると、霊はすぐに彼をひきつけさせたので、彼は地面に倒れ、あわを吹きながら、ころげ回った。","tok":[["そこ"],["で"],["、"],["人々","ひとびと"],["は"],["イエス"],["の"],["ところ"],["に"],["その"],["子","こ"],["を"],["連れて","つれて"],["来た","きた"],["。"],["その"],["子","こ"],["が"],["イエス"],["を"],["見る","みる"],["と"],["、"],["霊","れい"],["は"],["すぐ"],["に"],["彼","かれ"],["を"],["ひきつけさせた"],["ので"],["、"],["彼","かれ"],["は"],["地面","じめん"],["に"],["倒れ","たおれ"],["、"],["あわ"],["を"],["吹き","ふき"],["ながら"],["、"],["ころげ"],["回った","まわった"],["。"]]},{"verse":21,"text":"イエスはその子の父親に尋ねられた。「この子がこんなになってから、どのくらいになりますか。」父親は言った。「幼い時からです。","tok":[["イエス"],["は"],["その"],["子","こ"],["の"],["父親","ちちおや"],["に"],["尋ねられた","たずねられた"],["。"],["「"],["この"],["子","こ"],["が"],["こんな"],["に"],["なって"],["から"],["、"],["どの"],["くらい"],["に"],["なります"],["か"],["。"],["」"],["父親","ちちおや"],["は"],["言った","いった"],["。"],["「"],["幼い","おさない"],["時","とき"],["から"],["です"],["。"]]},{"verse":22,"text":"この霊は、彼を滅ぼそうとして、何度も火の中や水の中に投げ込みました。ただ、もし、おできになるものなら、私たちをあわれんで、お助けください。」","tok":[["この"],["霊","れい"],["は"],["、"],["彼","かれ"],["を"],["滅ぼそう","ほろぼそう"],["として"],["、"],["何度","なんど"],["も"],["火","ひ"],["の"],["中","なか"],["や"],["水","みず"],["の"],["中","なか"],["に"],["投げ込みました","なげこみました"],["。"],["ただ"],["、"],["もし"],["、"],["おでき"],["に"],["なる"],["もの"],["なら"],["、"],["私たち","わたしたち"],["を"],["あわれんで"],["、"],["お助け","おたすけ"],["ください"],["。"],["」"]]},{"verse":23,"text":"するとイエスは言われた。「できるものなら、と言うのか。信じる者には、どんなことでもできるのです。」","tok":[["する"],["と"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["できる"],["もの"],["なら"],["、"],["と"],["言う","いう"],["の"],["か"],["。"],["信じる","しんじる"],["者","もの"],["に"],["は"],["、"],["どんな"],["こと"],["で"],["も"],["できる"],["の"],["です"],["。"],["」"]]},{"verse":24,"text":"するとすぐに、その子の父は叫んで言った。「信じます。不信仰な私をお助けください。」","tok":[["する"],["と"],["すぐ"],["に"],["、"],["その"],["子","こ"],["の"],["父","ちち"],["は"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["信じます","しんじます"],["。"],["不","ふ"],["信仰","しんこう"],["な"],["私","わたくし"],["を"],["お助け","おたすけ"],["ください"],["。"],["」"]]},{"verse":25,"text":"イエスは、群衆が駆けつけるのをご覧になると、汚れた霊をしかって言われた。「口をきけなくし、耳を聞こえなくする霊。わたしがおまえに命じる。この子から出て行け。二度とこの子に入るな。」","tok":[["イエス"],["は"],["、"],["群衆","ぐんしゅう"],["が"],["駆けつける","かけつける"],["の"],["を"],["ご覧","ごらん"],["に"],["なる"],["と"],["、"],["汚れた","よごれた"],["霊","れい"],["を"],["しかって"],["言われた","いわれた"],["。"],["「"],["口","くち"],["を"],["きけなく"],["し"],["、"],["耳","みみ"],["を"],["聞こえなく","きこえなく"],["する"],["霊","れい"],["。"],["わたし"],["が"],["おまえ"],["に"],["命じる","めいじる"],["。"],["この"],["子","こ"],["から"],["出て","でて"],["行け","いけ"],["。"],["二","に"],["度","ど"],["と"],["この"],["子","こ"],["に"],["入る","はいる"],["な"],["。"],["」"]]},{"verse":26,"text":"するとその霊は、叫び声をあげ、その子を激しくひきつけさせて、出て行った。するとその子が死人のようになったので、多くの人々は、「この子は死んでしまった」と言った。","tok":[["する"],["と"],["その"],["霊","れい"],["は"],["、"],["叫び声","さけびごえ"],["を"],["あげ"],["、"],["その"],["子","こ"],["を"],["激しく","はげしく"],["ひきつけさせて"],["、"],["出て","でて"],["行った","いった"],["。"],["する"],["と"],["その"],["子","こ"],["が"],["死人","しにん"],["の"],["よう"],["に"],["なった"],["ので"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["は"],["、"],["「"],["この"],["子","こ"],["は"],["死んで","しんで"],["しまった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":27,"text":"しかし、イエスは、彼の手を取って起こされた。するとその子は立ち上がった。","tok":[["しかし"],["、"],["イエス"],["は"],["、"],["彼","かれ"],["の"],["手","て"],["を"],["取って","とって"],["起こされた","おこされた"],["。"],["する"],["と"],["その"],["子","こ"],["は"],["立ち上がった","たちあがった"],["。"]]},{"verse":28,"text":"イエスが家に入られると、弟子たちがそっとイエスに尋ねた。「どうしてでしょう。私たちには追い出せなかったのですが。」","tok":[["イエス"],["が"],["家","いえ"],["に"],["入られる","はいられる"],["と"],["、"],["弟子","でし"],["たち"],["が"],["そっと"],["イエス"],["に"],["尋ねた","たずねた"],["。"],["「"],["どう"],["して"],["でしょう"],["。"],["私たち","わたしたち"],["に"],["は"],["追い出せなかった","おいだせなかった"],["の"],["です"],["が"],["。"],["」"]]},{"verse":29,"text":"すると、イエスは言われた。「この種のものは、祈りによらなければ、何によっても追い出せるものではありません。」","tok":[["する"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["この"],["種","しゅ"],["の"],["もの"],["は"],["、"],["祈り","いのり"],["に"],["よらなければ"],["、"],["何","なん"],["によって"],["も"],["追い出せる","おいだせる"],["もの"],["で"],["は"],["ありません"],["。"],["」"]]},{"verse":30,"text":"さて、一行はそこを去って、ガリラヤを通って行った。イエスは、人に知られたくないと思われた。","tok":[["さて"],["、"],["一行","いっこう"],["は"],["そこ"],["を"],["去って","さって"],["、"],["ガリラヤ"],["を"],["通って","とおって"],["行った","いった"],["。"],["イエス"],["は"],["、"],["人","ひと"],["に"],["知られたく","しられたく"],["ない"],["と"],["思われた","おもわれた"],["。"]]},{"verse":31,"text":"それは、イエスは弟子たちを教えて、「人の子は人々の手に引き渡され、彼らはこれを殺す。しかし、殺されて、三日の後に、人の子はよみがえる」と話しておられたからである。","tok":[["それ"],["は"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["を"],["教えて","おしえて"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["は"],["人々","ひとびと"],["の"],["手","て"],["に"],["引き渡され","ひきわたされ"],["、"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["殺す","ころす"],["。"],["しかし"],["、"],["殺されて","ころされて"],["、"],["三日","みっか"],["の"],["後","あと"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["よみがえる"],["」"],["と"],["話して","はなして"],["おられた"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"しかし、弟子たちは、このみことばが理解できなかった。また、イエスに尋ねるのを恐れていた。","tok":[["しかし"],["、"],["弟子","でし"],["たち"],["は"],["、"],["この"],["みことば"],["が"],["理解","りかい"],["できなかった"],["。"],["また"],["、"],["イエス"],["に"],["尋ねる","たずねる"],["の"],["を"],["恐れて","おそれて"],["いた"],["。"]]},{"verse":33,"text":"カペナウムに着いた。イエスは、家に入った後、弟子たちに質問された。「道で何を論じ合っていたのですか。」","tok":[["カペナウム"],["に"],["着いた","ついた"],["。"],["イエス"],["は"],["、"],["家","いえ"],["に"],["入った","はいった"],["後","あと"],["、"],["弟子","でし"],["たち"],["に"],["質問","しつもん"],["された"],["。"],["「"],["道","みち"],["で"],["何","なん"],["を"],["論じ合って","ろんじあって"],["いた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":34,"text":"彼らは黙っていた。道々、だれが一番偉いかと論じ合っていたからである。","tok":[["彼","かれ"],["ら"],["は"],["黙って","だまって"],["いた"],["。"],["道々","みちみち"],["、"],["だれ"],["が"],["一番","いちばん"],["偉い","えらい"],["か"],["と"],["論じ合って","ろんじあって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":35,"text":"イエスはおすわりになり、十二弟子を呼んで、言われた。「だれでも人の先に立ちたいと思うなら、みなのしんがりとなり、みなに仕える者となりなさい。」","tok":[["イエス"],["は"],["おすわり"],["に"],["なり"],["、"],["十二","じゅうに"],["弟子","でし"],["を"],["呼んで","よんで"],["、"],["言われた","いわれた"],["。"],["「"],["だれ"],["で"],["も"],["人","ひと"],["の"],["先","さき"],["に"],["立ちたい","たちたい"],["と"],["思うなら","おもうなら"],["、"],["みな"],["の"],["しんがり"],["と"],["なり"],["、"],["みな"],["に"],["仕える","つかえる"],["者","もの"],["と"],["なり"],["なさい"],["。"],["」"]]},{"verse":36,"text":"それから、イエスは、ひとりの子どもを連れて来て、彼らの真ん中に立たせ、腕に抱き寄せて、彼らに言われた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["、"],["ひとり"],["の"],["子ども","こども"],["を"],["連れて","つれて"],["来て","きて"],["、"],["彼","かれ"],["ら"],["の"],["真ん中","まんなか"],["に"],["立たせ","たたせ"],["、"],["腕","うで"],["に"],["抱き寄せて","だきよせて"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"]]},{"verse":37,"text":"「だれでも、このような幼子たちのひとりを、わたしの名のゆえに受け入れるならば、わたしを受け入れるのです。また、だれでも、わたしを受け入れるならば、わたしを受け入れるのではなく、わたしを遣わされた方を受け入れるのです。」","tok":[["「"],["だれ"],["で"],["も"],["、"],["この"],["よう"],["な"],["幼子","おさなご"],["たち"],["の"],["ひとり"],["を"],["、"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["受け入れるならば","うけいれるならば"],["、"],["わたし"],["を"],["受け入れる","うけいれる"],["の"],["です"],["。"],["また"],["、"],["だれ"],["で"],["も"],["、"],["わたし"],["を"],["受け入れるならば","うけいれるならば"],["、"],["わたし"],["を"],["受け入れる","うけいれる"],["ので"],["は"],["なく"],["、"],["わたし"],["を"],["遣わされた","つかわされた"],["方","ほう"],["を"],["受け入れる","うけいれる"],["の"],["です"],["。"],["」"]]},{"verse":38,"text":"ヨハネがイエスに言った。「先生。先生の名を唱えて悪霊を追い出している者を見ましたが、私たちの仲間ではないので、やめさせました。」","tok":[["ヨハネ"],["が"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["先生","せんせい"],["の"],["名","な"],["を"],["唱えて","となえて"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["いる"],["者","もの"],["を"],["見ました","みました"],["が"],["、"],["私たち","わたしたち"],["の"],["仲間","なかま"],["で"],["は"],["ない"],["ので"],["、"],["やめさせました"],["。"],["」"]]},{"verse":39,"text":"しかし、イエスは言われた。「やめさせることはありません。わたしの名を唱えて、力あるわざを行いながら、すぐあとで、わたしを悪く言える者はないのです。","tok":[["しかし"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["やめさせる"],["こと"],["は"],["ありません"],["。"],["わたし"],["の"],["名","な"],["を"],["唱えて","となえて"],["、"],["力","ちから"],["ある"],["わざ"],["を"],["行い","おこない"],["ながら"],["、"],["すぐ"],["あと"],["で"],["、"],["わたし"],["を"],["悪く","わるく"],["言える","いえる"],["者","もの"],["は"],["ない"],["の"],["です"],["。"]]},{"verse":40,"text":"わたしたちに反対しない者は、わたしたちの味方です。","tok":[["わたしたち"],["に"],["反対","はんたい"],["しない"],["者","もの"],["は"],["、"],["わたしたち"],["の"],["味方","みかた"],["です"],["。"]]},{"verse":41,"text":"あなたがたがキリストの弟子だからというので、あなたがたに水一杯でも飲ませてくれる人は、決して報いを失うことはありません。これは確かなことです。","tok":[["あなた"],["がた"],["が"],["キリスト"],["の"],["弟子","でし"],["だ"],["から"],["と"],["いう"],["ので"],["、"],["あなた"],["がた"],["に"],["水","みず"],["一杯","いっぱい"],["で"],["も"],["飲ませて","のませて"],["くれる"],["人","ひと"],["は"],["、"],["決して","けっして"],["報い","むくい"],["を"],["失う","うしなう"],["こと"],["は"],["ありません"],["。"],["これ"],["は"],["確か","たしか"],["な"],["こと"],["です"],["。"]]},{"verse":42,"text":"また、わたしを信じるこの小さい者たちのひとりにでもつまずきを与えるような者は、むしろ大きい石臼を首にゆわえつけられて、海に投げ込まれたほうがましです。","tok":[["また"],["、"],["わたし"],["を"],["信じる","しんじる"],["この"],["小さい","ちいさい"],["者","もの"],["たち"],["の"],["ひとり"],["に"],["で"],["も"],["つまずき"],["を"],["与える","あたえる"],["よう"],["な"],["者","もの"],["は"],["、"],["むしろ"],["大きい","おおきい"],["石臼","いしうす"],["を"],["首","くび"],["に"],["ゆわえつけられて"],["、"],["海","うみ"],["に"],["投げ込まれた","なげこまれ
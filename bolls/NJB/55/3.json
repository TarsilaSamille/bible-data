[{"verse":1,"text":"終わりの日には困難な時代がやって来ることをよく承知しておきなさい。","tok":[["終わり","おわり"],["の"],["日","ひ"],["に"],["は"],["困難","こんなん"],["な"],["時代","じだい"],["が"],["やって"],["来る","くる"],["こと"],["を"],["よく"],["承知","しょうち"],["して"],["おき"],["なさい"],["。"]]},{"verse":2,"text":"そのときに人々は、自分を愛する者、金を愛する者、大言壮語する者、不遜な者、神をけがす者、両親に従わない者、感謝することを知らない者、汚れた者になり、","tok":[["その"],["とき"],["に"],["人々","ひとびと"],["は"],["、"],["自分","じぶん"],["を"],["愛する","あいする"],["者","もの"],["、"],["金","きん"],["を"],["愛する","あいする"],["者","もの"],["、"],["大言","たいげん"],["壮語","そうご"],["する"],["者","もの"],["、"],["不遜","ふそん"],["な"],["者","もの"],["、"],["神","かみ"],["を"],["けがす"],["者","もの"],["、"],["両親","りょうしん"],["に"],["従わない","したがわない"],["者","もの"],["、"],["感謝","かんしゃ"],["する"],["こと"],["を"],["知らない","しらない"],["者","もの"],["、"],["汚れた","よごれた"],["者","もの"],["に"],["なり"],["、"]]},{"verse":3,"text":"情け知らずの者、和解しない者、そしる者、節制のない者、粗暴な者、善を好まない者になり、","tok":[["情け","なさけ"],["知らず","しらず"],["の"],["者","もの"],["、"],["和解","わかい"],["しない"],["者","もの"],["、"],["そしる"],["者","もの"],["、"],["節制","せっせい"],["の"],["ない"],["者","もの"],["、"],["粗暴","そぼう"],["な"],["者","もの"],["、"],["善","ぜん"],["を"],["好まない","このまない"],["者","もの"],["に"],["なり"],["、"]]},{"verse":4,"text":"裏切る者、向こう見ずな者、慢心する者、神よりも快楽を愛する者になり、","tok":[["裏切る","うらぎる"],["者","もの"],["、"],["向こう","むこう"],["見ずな","みずな"],["者","もの"],["、"],["慢心","まんしん"],["する"],["者","もの"],["、"],["神","かみ"],["より"],["も"],["快楽","かいらく"],["を"],["愛する","あいする"],["者","もの"],["に"],["なり"],["、"]]},{"verse":5,"text":"見えるところは敬虔であっても、その実を否定する者になるからです。こういう人々を避けなさい。","tok":[["見える","みえる"],["ところ"],["は"],["敬虔","けいけん"],["で"],["あって"],["も"],["、"],["その"],["実","じつ"],["を"],["否定","ひてい"],["する"],["者","もの"],["に"],["なる"],["から"],["です"],["。"],["こう"],["いう"],["人々","ひとびと"],["を"],["避け","さけ"],["なさい"],["。"]]},{"verse":6,"text":"こういう人々の中には、家々に入り込み、愚かな女たちをたぶらかしている者がいます。その女たちは、さまざまの情欲に引き回されて罪に罪を重ね、","tok":[["こう"],["いう"],["人々","ひとびと"],["の"],["中","なか"],["に"],["は"],["、"],["家々","いえいえ"],["に"],["入り込み","はいりこみ"],["、"],["愚か","おろか"],["な"],["女","おんな"],["たち"],["を"],["たぶらかして"],["いる"],["者","もの"],["が"],["います"],["。"],["その"],["女","おんな"],["たち"],["は"],["、"],["さまざま"],["の"],["情欲","じょうよく"],["に"],["引き回されて","ひきまわされて"],["罪","つみ"],["に"],["罪","つみ"],["を"],["重ね","かさね"],["、"]]},{"verse":7,"text":"いつも学んではいるが、いつになっても真理を知ることのできない者たちです。","tok":[["いつも"],["学んで","まなんで"],["は"],["いる"],["が"],["、"],["いつ"],["に"],["なって"],["も"],["真理","しんり"],["を"],["知る","しる"],["こと"],["の"],["できない"],["者","もの"],["たち"],["です"],["。"]]},{"verse":8,"text":"また、こういう人々は、ちょうどヤンネとヤンブレがモーセに逆らったように、真理に逆らうのです。彼らは知性の腐った、信仰の失格者です。","tok":[["また"],["、"],["こう"],["いう"],["人々","ひとびと"],["は"],["、"],["ちょうど"],["ヤンネ"],["と"],["ヤンブレ"],["が"],["モーセ"],["に"],["逆らった","さからった"],["よう"],["に"],["、"],["真理","しんり"],["に"],["逆らう","さからう"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["知性","ちせい"],["の"],["腐った","くさった"],["、"],["信仰","しんこう"],["の"],["失格者","しっかくしゃ"],["です"],["。"]]},{"verse":9,"text":"でも、彼らはもうこれ以上に進むことはできません。彼らの愚かさは、あのふたりの場合のように、すべての人にはっきりわかるからです。","tok":[["で"],["も"],["、"],["彼","かれ"],["ら"],["は"],["もう"],["これ"],["以上","いじょう"],["に"],["進む","すすむ"],["こと"],["は"],["できません"],["。"],["彼","かれ"],["ら"],["の"],["愚か","おろか"],["さ"],["は"],["、"],["あの"],["ふたり"],["の"],["場合","ばあい"],["の"],["よう"],["に"],["、"],["すべて"],["の"],["人","ひと"],["に"],["はっきり"],["わかる"],["から"],["です"],["。"]]},{"verse":10,"text":"しかし、あなたは、私の教え、行動、計画、信仰、寛容、愛、忍耐に、","tok":[["しかし"],["、"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["教え","おしえ"],["、"],["行動","こうどう"],["、"],["計画","けいかく"],["、"],["信仰","しんこう"],["、"],["寛容","かんよう"],["、"],["愛","あい"],["、"],["忍耐","にんたい"],["に"],["、"]]},{"verse":11,"text":"またアンテオケ、イコニオム、ルステラで私にふりかかった迫害や苦難にも、よくついて来てくれました。何というひどい迫害に私は耐えて来たことでしょう。しかし、主はいっさいのことから私を救い出してくださいました。","tok":[["また"],["アンテオケ"],["、"],["イコニオム"],["、"],["ルステラ"],["で"],["私","わたくし"],["に"],["ふりかかった"],["迫害","はくがい"],["や"],["苦難","くなん"],["に"],["も"],["、"],["よく"],["ついて"],["来て","きて"],["くれました"],["。"],["何","なん"],["と"],["いう"],["ひどい"],["迫害","はくがい"],["に"],["私","わたくし"],["は"],["耐えて","たえて"],["来た","きた"],["こと"],["でしょう"],["。"],["しかし"],["、"],["主","ぬし"],["は"],["いっさい"],["の"],["こと"],["から"],["私","わたくし"],["を"],["救い出して","すくいだして"],["くださいました"],["。"]]},{"verse":12,"text":"確かに、キリスト・イエスにあって敬虔に生きようと願う者はみな、迫害を受けます。","tok":[["確か","たしか"],["に"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["敬虔","けいけん"],["に"],["生きよう","いきよう"],["と"],["願う","ねがう"],["者","もの"],["は"],["みな"],["、"],["迫害","はくがい"],["を"],["受けます","うけます"],["。"]]},{"verse":13,"text":"しかし、悪人や詐欺師たちは、だましたりだまされたりしながら、ますます悪に落ちて行くのです。","tok":[["しかし"],["、"],["悪人","あくにん"],["や"],["詐欺師","さぎし"],["たち"],["は"],["、"],["だまし"],["たり"],["だまされ"],["たり"],["し"],["ながら"],["、"],["ますます"],["悪","わる"],["に"],["落ちて","おちて"],["行く","いく"],["の"],["です"],["。"]]},{"verse":14,"text":"けれどもあなたは、学んで確信したところにとどまっていなさい。あなたは自分が、どの人たちからそれを学んだかを知っており、","tok":[["けれど"],["も"],["あなた"],["は"],["、"],["学んで","まなんで"],["確信","かくしん"],["した"],["ところ"],["に"],["とどまって"],["い"],["なさい"],["。"],["あなた"],["は"],["自分","じぶん"],["が"],["、"],["どの"],["人","ひと"],["たち"],["から"],["それ"],["を"],["学んだ","まなんだ"],["か"],["を"],["知って","しって"],["おり"],["、"]]},{"verse":15,"text":"また、幼いころから聖書に親しんで来たことを知っているからです。聖書はあなたに知恵を与えてキリスト・イエスに対する信仰による救いを受けさせることができるのです。","tok":[["また"],["、"],["幼い","おさない"],["ころ"],["から"],["聖書","せいしょ"],["に"],["親しんで","したしんで"],["来た","きた"],["こと"],["を"],["知って","しって"],["いる"],["から"],["です"],["。"],["聖書","せいしょ"],["は"],["あなた"],["に"],["知恵","ちえ"],["を"],["与えて","あたえて"],["キリスト"],["・"],["イエス"],["に"],["対する","たいする"],["信仰","しんこう"],["に"],["よる"],["救い","すくい"],["を"],["受けさせる","うけさせる"],["こと"],["が"],["できる"],["の"],["です"],["。"]]},{"verse":16,"text":"聖書はすべて、神の霊感によるもので、教えと戒めと矯正と義の訓練とのために有益です。","tok":[["聖書","せいしょ"],["は"],["すべて"],["、"],["神","かみ"],["の"],["霊感","れいかん"],["に"],["よる"],["もの"],["で"],["、"],["教え","おしえ"],["と"],["戒め","いましめ"],["と"],["矯正","きょうせい"],["と"],["義","ぎ"],["の"],["訓練","くんれん"],["と"],["の"],["ため"],["に"],["有益","ゆうえき"],["です"],["。"]]},{"verse":17,"text":"それは、神の人が、すべての良い働きのためにふさわしい十分に整えられた者となるためです。","tok":[["それ"],["は"],["、"],["神","かみ"],["の"],["人","ひと"],["が"],["、"],["すべて"],["の"],["良い","よい"],["働き","はたらき"],["の"],["ため"],["に"],["ふさわしい"],["十分","じゅうぶん"],["に"],["整えられた","ととのえられた"],["者","もの"],["と"],["なる"],["ため"],["です"],["。"]]}]
[{"verse":1,"text":"神の御前で、また、生きている人と死んだ人とをさばかれるキリスト・イエスの御前で、その現れとその御国を思って、私はおごそかに命じます。","tok":[["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["また"],["、"],["生きて","いきて"],["いる"],["人","ひと"],["と"],["死んだ","しんだ"],["人","ひと"],["と"],["を"],["さばかれる"],["キリスト"],["・"],["イエス"],["の"],["御前","ごぜん"],["で"],["、"],["その"],["現れ","あらわれ"],["と"],["その"],["御国","おくに"],["を"],["思って","おもって"],["、"],["私","わたくし"],["は"],["おごそか"],["に"],["命じます","めいじます"],["。"]]},{"verse":2,"text":"みことばを宣べ伝えなさい。時が良くても悪くてもしっかりやりなさい。寛容を尽くし、絶えず教えながら、責め、戒め、また勧めなさい。","tok":[["みことば"],["を"],["宣べ伝え","のべつたえ"],["なさい"],["。"],["時","じ"],["が"],["良くて","よくて"],["も"],["悪くて","わるくて"],["も"],["しっかり"],["やり"],["なさい"],["。"],["寛容","かんよう"],["を"],["尽くし","つくし"],["、"],["絶えず","たえず"],["教え","おしえ"],["ながら"],["、"],["責め","せめ"],["、"],["戒め","いましめ"],["、"],["また"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":3,"text":"というのは、人々が健全な教えに耳を貸そうとせず、自分につごうの良いことを言ってもらうために、気ままな願いをもって、次々に教師たちを自分たちのために寄せ集め、","tok":[["と"],["いう"],["の"],["は"],["、"],["人々","ひとびと"],["が"],["健全","けんぜん"],["な"],["教え","おしえ"],["に"],["耳","みみ"],["を"],["貸そう","かそう"],["と"],["せず"],["、"],["自分","じぶん"],["に"],["つごう"],["の"],["良い","よい"],["こと"],["を"],["言って","いって"],["もらう"],["ため"],["に"],["、"],["気まま","きまま"],["な"],["願い","ねがい"],["を"],["もって"],["、"],["次々","つぎつぎ"],["に"],["教師","きょうし"],["たち"],["を"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["寄せ集め","よせあつめ"],["、"]]},{"verse":4,"text":"真理から耳をそむけ、空想話にそれて行くような時代になるからです。","tok":[["真理","しんり"],["から"],["耳","みみ"],["を"],["そむけ"],["、"],["空想","くうそう"],["話","はなし"],["に"],["それ"],["て"],["行く","いく"],["よう"],["な"],["時代","じだい"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":5,"text":"しかし、あなたは、どのような場合にも慎み、困難に耐え、伝道者として働き、自分の務めを十分に果たしなさい。","tok":[["しかし"],["、"],["あなた"],["は"],["、"],["どのような"],["場合","ばあい"],["に"],["も"],["慎み","つつしみ"],["、"],["困難","こんなん"],["に"],["耐え","たえ"],["、"],["伝道者","でんどうしゃ"],["として"],["働き","はたらき"],["、"],["自分","じぶん"],["の"],["務め","つとめ"],["を"],["十分","じゅうぶん"],["に"],["果たし","はたし"],["なさい"],["。"]]},{"verse":6,"text":"私は今や注ぎの供え物となります。私が世を去る時はすでに来ました。","tok":[["私","わたくし"],["は"],["今","いま"],["や"],["注ぎ","そそぎ"],["の"],["供え物","そなえもの"],["と"],["なります"],["。"],["私","わたくし"],["が"],["世","よ"],["を"],["去る","さる"],["時","とき"],["は"],["すでに"],["来ました","きました"],["。"]]},{"verse":7,"text":"私は勇敢に戦い、走るべき道のりを走り終え、信仰を守り通しました。","tok":[["私","わたくし"],["は"],["勇敢","ゆうかん"],["に"],["戦い","たたかい"],["、"],["走るべき","はしるべき"],["道のり","みちのり"],["を"],["走り","はしり"],["終え","おえ"],["、"],["信仰","しんこう"],["を"],["守り","まもり"],["通しました","とおしました"],["。"]]},{"verse":8,"text":"今からは、義の栄冠が私のために用意されているだけです。かの日には、正しい審判者である主が、それを私に授けてくださるのです。私だけでなく、主の現れを慕っている者には、だれにでも授けてくださるのです。","tok":[["今","いま"],["から"],["は"],["、"],["義","ぎ"],["の"],["栄冠","えいかん"],["が"],["私","わたくし"],["の"],["ため"],["に"],["用意","ようい"],["されて"],["いる"],["だけ"],["です"],["。"],["かの"],["日","ひ"],["に"],["は"],["、"],["正しい","ただしい"],["審判者","しんぱんしゃ"],["で"],["ある"],["主","ぬし"],["が"],["、"],["それ"],["を"],["私","わたくし"],["に"],["授けて","さずけて"],["くださる"],["の"],["です"],["。"],["私","わたくし"],["だけ"],["で"],["なく"],["、"],["主","ぬし"],["の"],["現れ","あらわれ"],["を"],["慕って","したって"],["いる"],["者","もの"],["に"],["は"],["、"],["だれ"],["に"],["で"],["も"],["授けて","さずけて"],["くださる"],["の"],["です"],["。"]]},{"verse":9,"text":"あなたは、何とかして、早く私のところに来てください。","tok":[["あなた"],["は"],["、"],["何","なん"],["と"],["か"],["して"],["、"],["早く","はやく"],["私","わたくし"],["の"],["ところ"],["に"],["来て","きて"],["ください"],["。"]]},{"verse":10,"text":"デマスは今の世を愛し、私を捨ててテサロニケに行ってしまい、また、クレスケンスはガラテヤに、テトスはダルマテヤに行ったからです。","tok":[["デマス"],["は"],["今","いま"],["の"],["世","よ"],["を"],["愛し","あいし"],["、"],["私","わたくし"],["を"],["捨てて","すてて"],["テサロニケ"],["に"],["行って","いって"],["しまい"],["、"],["また"],["、"],["クレスケンス"],["は"],["ガラテヤ"],["に"],["、"],["テトス"],["は"],["ダルマテヤ"],["に"],["行った","いった"],["から"],["です"],["。"]]},{"verse":11,"text":"ルカだけは私とともにおります。マルコを伴って、いっしょに来てください。彼は私の務めのために役に立つからです。","tok":[["ルカ"],["だけ"],["は"],["私","わたくし"],["と"],["とも"],["に"],["おります"],["。"],["マルコ"],["を"],["伴って","ともなって"],["、"],["いっしょ"],["に"],["来て","きて"],["ください"],["。"],["彼","かれ"],["は"],["私","わたくし"],["の"],["務め","つとめ"],["の"],["ため"],["に"],["役","やく"],["に"],["立つ","たつ"],["から"],["です"],["。"]]},{"verse":12,"text":"私はテキコをエペソに遣わしました。","tok":[["私","わたくし"],["は"],["テキコ"],["を"],["エペソ"],["に"],["遣わしました","つかわしました"],["。"]]},{"verse":13,"text":"あなたが来るときは、トロアスでカルポのところに残しておいた上着を持って来てください。また、書物を、特に羊皮紙の物を持って来てください。","tok":[["あなた"],["が"],["来る","くる"],["とき"],["は"],["、"],["トロアス"],["で"],["カルポ"],["の"],["ところ"],["に"],["残して","のこして"],["おいた"],["上着","うわぎ"],["を"],["持って","もって"],["来て","きて"],["ください"],["。"],["また"],["、"],["書物","しょもつ"],["を"],["、"],["特に","とくに"],["羊皮紙","ようひし"],["の"],["物","もの"],["を"],["持って","もって"],["来て","きて"],["ください"],["。"]]},{"verse":14,"text":"銅細工人のアレキサンデルが私をひどく苦しめました。そのしわざに応じて主が彼に報いられます。","tok":[["銅","どう"],["細工人","さいくにん"],["の"],["アレキサンデル"],["が"],["私","わたくし"],["を"],["ひどく"],["苦しめました","くるしめました"],["。"],["その"],["しわざ"],["に"],["応じて","おうじて"],["主","ぬし"],["が"],["彼","かれ"],["に"],["報いられます","むくいられます"],["。"]]},{"verse":15,"text":"あなたも彼を警戒しなさい。彼は私たちのことばに激しく逆らったからです。","tok":[["あなた"],["も"],["彼","かれ"],["を"],["警戒","けいかい"],["し"],["なさい"],["。"],["彼","かれ"],["は"],["私たち","わたしたち"],["の"],["ことば"],["に"],["激しく","はげしく"],["逆らった","さからった"],["から"],["です"],["。"]]},{"verse":16,"text":"私の最初の弁明の際には、私を支持する者はだれもなく、みな私を見捨ててしまいました。どうか、彼らがそのためにさばかれることのありませんように。","tok":[["私","わたくし"],["の"],["最初","さいしょ"],["の"],["弁明","べんめい"],["の"],["際","さい"],["に"],["は"],["、"],["私","わたくし"],["を"],["支持","しじ"],["する"],["者","もの"],["は"],["だれ"],["も"],["なく"],["、"],["みな"],["私","わたくし"],["を"],["見捨てて","みすてて"],["しまいました"],["。"],["どう"],["か"],["、"],["彼","かれ"],["ら"],["が"],["その"],["ため"],["に"],["さばかれる"],["こと"],["の"],["ありません"],["よう"],["に"],["。"]]},{"verse":17,"text":"しかし、主は、私とともに立ち、私に力を与えてくださいました。それは、私を通してみことばが余すところなく宣べ伝えられ、すべての国の人々がみことばを聞くようになるためでした。私は獅子の口から助け出されました。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["、"],["私","わたくし"],["と"],["とも"],["に"],["立ち","たち"],["、"],["私","わたくし"],["に"],["力","ちから"],["を"],["与えて","あたえて"],["くださいました"],["。"],["それ"],["は"],["、"],["私","わたくし"],["を"],["通して","とおして"],["み"],["ことば"],["が"],["余す","あます"],["ところ"],["なく"],["宣べ伝えられ","のべつたえられ"],["、"],["すべて"],["の"],["国","くに"],["の"],["人々","ひとびと"],["が"],["みことば"],["を"],["聞く","きく"],["よう"],["に"],["なる"],["ため"],["でした"],["。"],["私","わたくし"],["は"],["獅子","しし"],["の"],["口","くち"],["から"],["助け出されました","たすけだされました"],["。"]]},{"verse":18,"text":"主は私を、すべての悪のわざから助け出し、天の御国に救い入れてくださいます。主に、御栄えがとこしえにありますように。アーメン。","tok":[["主","ぬし"],["は"],["私","わたくし"],["を"],["、"],["すべて"],["の"],["悪","あく"],["の"],["わざ"],["から"],["助け出し","たすけだし"],["、"],["天","てん"],["の"],["御国","おくに"],["に"],["救い","すくい"],["入れて","いれて"],["くださいます"],["。"],["主に","おもに"],["、"],["御栄え","おはえ"],["が"],["とこしえ"],["に"],["あります"],["よう"],["に"],["。"],["アーメン"],["。"]]},{"verse":19,"text":"プリスカとアクラによろしく。また、オネシポロの家族によろしく。","tok":[["プリスカ"],["と"],["アクラ"],["に"],["よろしく"],["。"],["また"],["、"],["オネシポロ"],["の"],["家族","かぞく"],["に"],["よろしく"],["。"]]},{"verse":20,"text":"エラストはコリントにとどまり、トロピモは病気のためにミレトに残して来ました。","tok":[["エラスト"],["は"],["コリント"],["に"],["とどまり"],["、"],["トロピモ"],["は"],["病気","びょうき"],["の"],["ため"],["に"],["ミレト"],["に"],["残して","のこして"],["来ました","きました"],["。"]]},{"verse":21,"text":"何とかして、冬になる前に来てください。ユブロ、プデス、リノス、クラウデヤ、またすべての兄弟たちが、あなたによろしくと言っています。","tok":[["何","なん"],["と"],["か"],["して"],["、"],["冬","ふゆ"],["に"],["なる"],["前","まえ"],["に"],["来て","きて"],["ください"],["。"],["ユブロ"],["、"],["プデス"],["、"],["リノス"],["、"],["クラウデヤ"],["、"],["また"],["すべて"],["の"],["兄弟","きょうだい"],["たち"],["が"],["、"],["あなた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":22,"text":"主があなたの霊とともにおられますように。恵みが、あなたがたとともにありますように。","tok":[["主","ぬし"],["が"],["あなた"],["の"],["霊","れい"],["と"],["とも"],["に"],["おられます"],["よう"],["に"],["。"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["あります"],["よう"],["に"],["。"]]}]
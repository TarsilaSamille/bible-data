[{"verse":1,"text":"私はキリストにあって真実を言い、偽りを言いません。次のことは、私の良心も、聖霊によってあかししています。","tok":[["私","わたくし"],["は"],["キリスト"],["に"],["あって"],["真実","しんじつ"],["を"],["言い","いい"],["、"],["偽り","いつわり"],["を"],["言いません","いいません"],["。"],["次","つぎ"],["の"],["こと"],["は"],["、"],["私","わたくし"],["の"],["良心","りょうしん"],["も"],["、"],["聖霊","せいれい"],["によって"],["あかし"],["して"],["います"],["。"]]},{"verse":2,"text":"私には大きな悲しみがあり、私の心には絶えず痛みがあります。","tok":[["私","わたくし"],["に"],["は"],["大きな","おおきな"],["悲しみ","かなしみ"],["が"],["あり"],["、"],["私","わたくし"],["の"],["心","こころ"],["に"],["は"],["絶えず","たえず"],["痛み","いたみ"],["が"],["あります"],["。"]]},{"verse":3,"text":"もしできることなら、私の同胞、肉による同国人のために、この私がキリストから引き離されて、のろわれた者となることさえ願いたいのです。","tok":[["もし"],["できる"],["こと"],["なら"],["、"],["私","わたくし"],["の"],["同胞","どうほう"],["、"],["肉","にく"],["に"],["よる"],["同国人","どうこくにん"],["の"],["ため"],["に"],["、"],["この"],["私","わたくし"],["が"],["キリスト"],["から"],["引き離されて","ひきはなされて"],["、"],["のろわれた"],["者","もの"],["と"],["なる"],["こと"],["さえ"],["願いたい","ねがいたい"],["の"],["です"],["。"]]},{"verse":4,"text":"彼らはイスラエル人です。子とされることも、栄光も、契約も、律法を与えられることも、礼拝も、約束も彼らのものです。","tok":[["彼","かれ"],["ら"],["は"],["イスラエル"],["人","にん"],["です"],["。"],["子","こ"],["と"],["される"],["こと"],["も"],["、"],["栄光","えいこう"],["も"],["、"],["契約","けいやく"],["も"],["、"],["律法","りっぽう"],["を"],["与えられる","あたえられる"],["こと"],["も"],["、"],["礼拝","れいはい"],["も"],["、"],["約束","やくそく"],["も"],["彼","かれ"],["ら"],["の"],["もの"],["です"],["。"]]},{"verse":5,"text":"父祖たちも彼らのものです。またキリストも、人としては彼らから出られたのです。このキリストは万物の上にあり、とこしえにほめたたえられる神です。アーメン。","tok":[["父祖","ふそ"],["たち"],["も"],["彼","かれ"],["ら"],["の"],["もの"],["です"],["。"],["また"],["キリスト"],["も"],["、"],["人","ひと"],["として"],["は"],["彼","かれ"],["ら"],["から"],["出られた","でられた"],["の"],["です"],["。"],["この"],["キリスト"],["は"],["万物","ばんぶつ"],["の"],["上","うえ"],["に"],["あり"],["、"],["とこしえ"],["に"],["ほめたたえられる"],["神","かみ"],["です"],["。"],["アーメン"],["。"]]},{"verse":6,"text":"しかし、神のみことばが無効になったわけではありません。なぜなら、イスラエルから出る者がみな、イスラエルなのではなく、","tok":[["しかし"],["、"],["神","かみ"],["のみ"],["ことば"],["が"],["無効","むこう"],["に"],["なった"],["わけ"],["で"],["は"],["ありません"],["。"],["なぜ"],["なら"],["、"],["イスラエル"],["から"],["出る","でる"],["者","もの"],["が"],["みな"],["、"],["イスラエル"],["な"],["ので"],["は"],["なく"],["、"]]},{"verse":7,"text":"アブラハムから出たからといって、すべてが子どもなのではなく、「イサクから出る者があなたの子孫と呼ばれる」のだからです。","tok":[["アブラハム"],["から"],["出た","でた"],["から"],["と"],["いって"],["、"],["すべて"],["が"],["子ども","こども"],["な"],["ので"],["は"],["なく"],["、"],["「"],["イサク"],["から"],["出る","でる"],["者","もの"],["が"],["あなた"],["の"],["子孫","しそん"],["と"],["呼ばれる","よばれる"],["」"],["の"],["だ"],["から"],["です"],["。"]]},{"verse":8,"text":"すなわち、肉の子どもがそのまま神の子どもではなく、約束の子どもが子孫とみなされるのです。","tok":[["すなわち"],["、"],["肉","にく"],["の"],["子ども","こども"],["が"],["そのまま"],["神","かみ"],["の"],["子ども","こども"],["で"],["は"],["なく"],["、"],["約束","やくそく"],["の"],["子ども","こども"],["が"],["子孫","しそん"],["と"],["みなされる"],["の"],["です"],["。"]]},{"verse":9,"text":"約束のみことばはこうです。「私は来年の今ごろ来ます。そして、サラは男の子を産みます。」","tok":[["約束","やくそく"],["の"],["みことば"],["は"],["こう"],["です"],["。"],["「"],["私","わたくし"],["は"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["来ます","きます"],["。"],["そして"],["、"],["サラ"],["は"],["男の子","おとこのこ"],["を"],["産みます","うみます"],["。"],["」"]]},{"verse":10,"text":"このことだけでなく、私たちの父イサクひとりによってみごもったリベカのこともあります。","tok":[["この"],["こと"],["だけ"],["で"],["なく"],["、"],["私たち","わたしたち"],["の"],["父","ちち"],["イサク"],["ひとり"],["によって"],["みごもった"],["リベカ"],["の"],["こと"],["も"],["あります"],["。"]]},{"verse":11,"text":"その子どもたちは、まだ生まれてもおらず、善も悪も行わないうちに、神の選びの計画の確かさが、行いにはよらず、召してくださる方によるようにと、","tok":[["その"],["子ども","こども"],["たち"],["は"],["、"],["まだ"],["生まれて","うまれて"],["も"],["おらず"],["、"],["善","ぜん"],["も"],["悪","あく"],["も"],["行わない","おこなわない"],["うち"],["に"],["、"],["神","かみ"],["の"],["選び","えらび"],["の"],["計画","けいかく"],["の"],["確か","たしか"],["さ"],["が"],["、"],["行い","おこない"],["に"],["は"],["よらず"],["、"],["召して","めして"],["くださる"],["方","かた"],["に"],["よる"],["よう"],["に"],["と"],["、"]]},{"verse":12,"text":"「兄は弟に仕える」と彼女に告げられたのです。","tok":[["「"],["兄","あに"],["は"],["弟","おとうと"],["に"],["仕える","つかえる"],["」"],["と"],["彼女","かのじょ"],["に"],["告げられた","つげられた"],["の"],["です"],["。"]]},{"verse":13,"text":"「わたしはヤコブを愛し、エサウを憎んだ」と書いてあるとおりです。","tok":[["「"],["わたし"],["は"],["ヤコブ"],["を"],["愛し","あいし"],["、"],["エサウ"],["を"],["憎んだ","にくんだ"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":14,"text":"それでは、どういうことになりますか。神に不正があるのですか。絶対にそんなことはありません。","tok":[["それ"],["で"],["は"],["、"],["どういう"],["こと"],["に"],["なります"],["か"],["。"],["神","かみ"],["に"],["不正","ふせい"],["が"],["ある"],["の"],["です"],["か"],["。"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"]]},{"verse":15,"text":"神はモーセに、「わたしは自分のあわれむ者をあわれみ、自分のいつくしむ者をいつくしむ」と言われました。","tok":[["神","かみ"],["は"],["モーセ"],["に"],["、"],["「"],["わたし"],["は"],["自分","じぶん"],["の"],["あわれむ"],["者","もの"],["を"],["あわれみ"],["、"],["自分","じぶん"],["の"],["いつくしむ"],["者","もの"],["を"],["いつくしむ"],["」"],["と"],["言われました","いわれました"],["。"]]},{"verse":16,"text":"したがって、事は人間の願いや努力によるのではなく、あわれんでくださる神によるのです。","tok":[["したがって"],["、"],["事","こと"],["は"],["人間","にんげん"],["の"],["願い","ねがい"],["や"],["努力","どりょく"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["あわれんで"],["くださる"],["神","かみ"],["に"],["よる"],["の"],["です"],["。"]]},{"verse":17,"text":"聖書はパロに、「わたしがあなたを立てたのは、あなたにおいてわたしの力を示し、わたしの名を全世界に告げ知らせるためである」と言っています。","tok":[["聖書","せいしょ"],["は"],["パロ"],["に"],["、"],["「"],["わたし"],["が"],["あなた"],["を"],["立てた","たてた"],["の"],["は"],["、"],["あなた"],["に"],["おいて"],["わたし"],["の"],["力","ちから"],["を"],["示し","しめし"],["、"],["わたし"],["の"],["名","な"],["を"],["全","ぜん"],["世界","せかい"],["に"],["告げ知らせる","つげしらせる"],["ため"],["で"],["ある"],["」"],["と"],["言って","いって"],["います"],["。"]]},{"verse":18,"text":"こういうわけで、神は、人をみこころのままにあわれみ、またみこころのままにかたくなにされるのです。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["神","かみ"],["は"],["、"],["人","ひと"],["を"],["みこころ"],["の"],["まま"],["に"],["あわれみ"],["、"],["また"],["みこころ"],["の"],["まま"],["に"],["かたくな"],["に"],["される"],["の"],["です"],["。"]]},{"verse":19,"text":"すると、あなたはこう言うでしょう。「それなのになぜ、神は人を責められるのですか。だれが神のご計画に逆らうことができましょう。」","tok":[["する"],["と"],["、"],["あなた"],["は"],["こう"],["言うでしょう","ゆうでしょう"],["。"],["「"],["それ"],["な"],["のに"],["なぜ"],["、"],["神","かみ"],["は"],["人","ひと"],["を"],["責められる","せめられる"],["の"],["です"],["か"],["。"],["だれ"],["が"],["神","かみ"],["の"],["ご計画","ごけいかく"],["に"],["逆らう","さからう"],["こと"],["が"],["できましょう"],["。"],["」"]]},{"verse":20,"text":"しかし、人よ。神に言い逆らうあなたは、いったい何ですか。形造られた者が形造った者に対して、「あなたはなぜ、私をこのようなものにしたのですか」と言えるでしょうか。","tok":[["しかし"],["、"],["人","ひと"],["よ"],["。"],["神","かみ"],["に"],["言い","いい"],["逆らう","さからう"],["あなた"],["は"],["、"],["いったい"],["何","なん"],["です"],["か"],["。"],["形造られた","かたちづくられた"],["者","もの"],["が"],["形造った","かたちづくった"],["者","もの"],["に対して","にたいして"],["、"],["「"],["あなた"],["は"],["なぜ"],["、"],["私","わたくし"],["を"],["この"],["よう"],["な"],["もの"],["に"],["した"],["の"],["です"],["か"],["」"],["と"],["言えるでしょう","いえるでしょう"],["か"],["。"]]},{"verse":21,"text":"陶器を作る者は、同じ土のかたまりから、尊いことに用いる器でも、また、つまらないことに用いる器でも作る権利を持っていないのでしょうか。","tok":[["陶器","とうき"],["を"],["作る","つくる"],["者","もの"],["は"],["、"],["同じ","おなじ"],["土","つち"],["の"],["かたまり"],["から"],["、"],["尊い","とうとい"],["こと"],["に"],["用いる","もちいる"],["器","うつわ"],["で"],["も"],["、"],["また"],["、"],["つまらない"],["こと"],["に"],["用いる","もちいる"],["器","うつわ"],["で"],["も"],["作る","つくる"],["権利","けんり"],["を"],["持って","もって"],["いない"],["の"],["でしょう"],["か"],["。"]]},{"verse":22,"text":"ですが、もし神が、怒りを示してご自分の力を知らせようと望んでおられるのに、その滅ぼされるべき怒りの器を、豊かな寛容をもって忍耐してくださったとしたら、どうでしょうか。","tok":[["です"],["が"],["、"],["もし"],["神","かみ"],["が"],["、"],["怒り","いかり"],["を"],["示して","しめして"],["ご自分","ごじぶん"],["の"],["力","ちから"],["を"],["知らせよう","しらせよう"],["と"],["望んで","のぞんで"],["おられる"],["のに"],["、"],["その"],["滅ぼされるべき","ほろぼされるべき"],["怒り","いかり"],["の"],["器","うつわ"],["を"],["、"],["豊か","ゆたか"],["な"],["寛容","かんよう"],["を"],["もって"],["忍耐","にんたい"],["して"],["くださった"],["と"],["したら"],["、"],["どう"],["でしょう"],["か"],["。"]]},{"verse":23,"text":"それも、神が栄光のためにあらかじめ用意しておられたあわれみの器に対して、その豊かな栄光を知らせてくださるためになのです。","tok":[["それ"],["も"],["、"],["神","かみ"],["が"],["栄光","えいこう"],["の"],["ため"],["に"],["あらかじめ"],["用意","ようい"],["して"],["おられた"],["あわれみ"],["の"],["器","うつわ"],["に対して","にたいして"],["、"],["その"],["豊か","ゆたか"],["な"],["栄光","えいこう"],["を"],["知らせて","しらせて"],["くださる"],["ため"],["に"],["な"],["の"],["です"],["。"]]},{"verse":24,"text":"神は、このあわれみの器として、私たちを、ユダヤ人の中からだけでなく、異邦人の中からも召してくださったのです。","tok":[["神","かみ"],["は"],["、"],["この"],["あわれみ"],["の"],["器","うつわ"],["として"],["、"],["私たち","わたしたち"],["を"],["、"],["ユダヤ人","ゆだやじん"],["の"],["中","なか"],["から"],["だけ"],["で"],["なく"],["、"],["異邦人","いほうじん"],["の"],["中","なか"],["から"],["も"],["召して","めして"],["くださった"],["の"],["です"],["。"]]},{"verse":25,"text":"それは、ホセアの書でも言っておられるとおりです。「わたしは、わが民でない者をわが民と呼び、愛さなかった者を愛する者と呼ぶ。","tok":[["それ"],["は"],["、"],["ホセア"],["の"],["書","しょ"],["で"],["も"],["言って","いって"],["おられる"],["とおり"],["です"],["。"],["「"],["わたし"],["は"],["、"],["わが"],["民","たみ"],["で"],["ない"],["者","もの"],["を"],["わが"],["民","たみ"],["と"],["呼び","よび"],["、"],["愛さなかった","あいさなかった"],["者","もの"],["を"],["愛する","あいする"],["者","もの"],["と"],["呼ぶ","よぶ"],["。"]]},{"verse":26,"text":"『あなたがたは、わたしの民ではない』と、わたしが言ったその場所で、彼らは、生ける神の子どもと呼ばれる。」","tok":[["『"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["民","たみ"],["で"],["は"],["ない"],["』"],["と"],["、"],["わたし"],["が"],["言った","いった"],["その"],["場所","ばしょ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["、"],["生ける","いける"],["神","かみ"],["の"],["子ども","こども"],["と"],["呼ばれる","よばれる"],["。"],["」"]]},{"verse":27,"text":"また、イスラエルについては、イザヤがこう叫んでいます。「たといイスラエルの子どもたちの数は、海べの砂のようであっても、救われるのは、残された者である。","tok":[["また"],["、"],["イスラエル"],["について"],["は"],["、"],["イザヤ"],["が"],["こう"],["叫んで","さけんで"],["います"],["。"],["「"],["たとい"],["イスラエル"],["の"],["子ども","こども"],["たち"],["の"],["数","かず"],["は"],["、"],["海べ","うみべ"],["の"],["砂","すな"],["の"],["よう"],["で"],["あって"],["も"],["、"],["救われる","すくわれる"],["の"],["は"],["、"],["残された","のこされた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":28,"text":"主は、みことばを完全に、しかも敏速に、地上に成し遂げられる。」","tok":[["主","ぬし"],["は"],["、"],["みことば"],["を"],["完全","かんぜん"],["に"],["、"],["しかも"],["敏速","びんそく"],["に"],["、"],["地上","ちじょう"],["に"],["成し遂げられる","なしとげられる"],["。"],["」"]]},{"verse":29,"text":"また、イザヤがこう預言したとおりです。「もし万軍の主が、私たちに子孫を残されなかったら、私たちはソドムのようになり、ゴモラと同じものとされたであろう。」","tok":[["また"],["、"],["イザヤ"],["が"],["こう"],["預言","よげん"],["した"],["とおり"],["です"],["。"],["「"],["もし"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["、"],["私たち","わたしたち"],["に"],["子孫","しそん"],["を"],["残されなかったら","のこされなかったら"],["、"],["私たち","わたしたち"],["は"],["ソドム"],["の"],["よう"],["に"],["なり"],["、"],["ゴモラ"],["と"],["同じ","おなじ"],["もの"],["と"],["されたで"],["あろう"],["。"],["」"]]},{"verse":30,"text":"では、どういうことになりますか。義を追い求めなかった異邦人は義を得ました。すなわち、信仰による義です。","tok":[["で"],["は"],["、"],["どういう"],["こと"],["に"],["なります"],["か"],["。"],["義","ぎ"],["を"],["追い求めなかった","おいもとめなかった"],["異邦人","いほうじん"],["は"],["義","ぎ"],["を"],["得ました","えました"],["。"],["すなわち"],["、"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["です"],["。"]]},{"verse":31,"text":"しかし、イスラエルは、義の律法を追い求めながら、その律法に到達しませんでした。","tok":[["しかし"],["、"],["イスラエル"],["は"],["、"],["義","ぎ"],["の"],["律法","りっぽう"],["を"],["追い求め","おいもとめ"],["ながら"],["、"],["その"],["律法","りっぽう"],["に"],["到達","とうたつ"],["しませんでした"],["。"]]},{"verse":32,"text":"なぜでしょうか。信仰によって追い求めることをしないで、行いによるかのように追い求めたからです。彼らは、つまずきの石につまずいたのです。","tok":[["なぜ"],["でしょう"],["か"],["。"],["信仰","しんこう"],["によって"],["追い求める","おいもとめる"],["こと"],["を"],["しないで"],["、"],["行い","おこない"],["に"],["よる"],["か"],["の"],["よう"],["に"],["追い求めた","おいもとめた"],["から"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["つまずき"],["の"],["石","いし"],["に"],["つまずいた"],["の"],["です"],["。"]]},{"verse":33,"text":"それは、こう書かれているとおりです。「見よ。わたしは、シオンに、つまずきの石、妨げの岩を置く。彼に信頼する者は、失望させられることがない。」","tok":[["それ"],["は"],["、"],["こう"],["書かれて","かかれて"],["いる"],["とおり"],["です"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["シオン"],["に"],["、"],["つまずき"],["の"],["石","いし"],["、"],["妨げ","さまたげ"],["の"],["岩","いわ"],["を"],["置く","おく"],["。"],["彼","かれ"],["に"],["信頼","しんらい"],["する"],["者","もの"],["は"],["、"],["失望","しつぼう"],["させられる"],["こと"],["が"],["ない"],["。"],["」"]]}]
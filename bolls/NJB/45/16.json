[{"verse":1,"text":"ケンクレヤにある教会の執事で、私たちの姉妹であるフィベを、あなたがたに推薦します。","tok":[["ケンクレヤ"],["に"],["ある"],["教会","きょうかい"],["の"],["執事","しつじ"],["で"],["、"],["私たち","わたしたち"],["の"],["姉妹","しまい"],["で"],["ある"],["フィベ"],["を"],["、"],["あなた"],["がた"],["に"],["推薦","すいせん"],["します"],["。"]]},{"verse":2,"text":"どうぞ、聖徒にふさわしいしかたで、主にあってこの人を歓迎し、あなたがたの助けを必要とすることは、どんなことでも助けてあげてください。この人は、多くの人を助け、また私自身をも助けてくれた人です。","tok":[["どうぞ"],["、"],["聖徒","せいと"],["に"],["ふさわしい"],["しかた"],["で"],["、"],["主に","おもに"],["あって"],["この"],["人","ひと"],["を"],["歓迎","かんげい"],["し"],["、"],["あなた"],["がた"],["の"],["助け","たすけ"],["を"],["必要","ひつよう"],["と"],["する"],["こと"],["は"],["、"],["どんな"],["こと"],["で"],["も"],["助けて","たすけて"],["あげて"],["ください"],["。"],["この"],["人","ひと"],["は"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["助け","たすけ"],["、"],["また"],["私自身","わたしじしん"],["を"],["も"],["助けて","たすけて"],["くれた"],["人","ひと"],["です"],["。"]]},{"verse":3,"text":"キリスト・イエスにあって私の同労者であるプリスカとアクラによろしく伝えてください。","tok":[["キリスト"],["・"],["イエス"],["に"],["あって"],["私","わたくし"],["の"],["同労者","どうろうしゃ"],["で"],["ある"],["プリスカ"],["と"],["アクラ"],["に"],["よろしく"],["伝えて","つたえて"],["ください"],["。"]]},{"verse":4,"text":"この人たちは、自分のいのちの危険を冒して私のいのちを守ってくれたのです。この人たちには、私だけでなく、異邦人のすべての教会も感謝しています。","tok":[["この"],["人","ひと"],["たち"],["は"],["、"],["自分","じぶん"],["の"],["いのち"],["の"],["危険","きけん"],["を"],["冒して","おかして"],["私","わたくし"],["の"],["いのち"],["を"],["守って","まもって"],["くれた"],["の"],["です"],["。"],["この"],["人","ひと"],["たち"],["に"],["は"],["、"],["私","わたくし"],["だけ"],["で"],["なく"],["、"],["異邦人","いほうじん"],["の"],["すべて"],["の"],["教会","きょうかい"],["も"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":5,"text":"またその家の教会によろしく伝えてください。私の愛するエパネトによろしく。この人はアジヤでキリストを信じた最初の人です。","tok":[["また"],["その"],["家","いえ"],["の"],["教会","きょうかい"],["に"],["よろしく"],["伝えて","つたえて"],["ください"],["。"],["私","わたくし"],["の"],["愛する","あいする"],["エパネト"],["に"],["よろしく"],["。"],["この"],["人","ひと"],["は"],["アジヤ"],["で"],["キリスト"],["を"],["信じた","しんじた"],["最初","さいしょ"],["の"],["人","ひと"],["です"],["。"]]},{"verse":6,"text":"あなたがたのために非常に労苦したマリヤによろしく。","tok":[["あなた"],["がた"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["労苦","ろうく"],["した"],["マリヤ"],["に"],["よろしく"],["。"]]},{"verse":7,"text":"私の同国人で私といっしょに投獄されたことのある、アンドロニコとユニアスにもよろしく。この人々は使徒たちの間によく知られている人々で、また私より先にキリストにある者となったのです。","tok":[["私","わたくし"],["の"],["同国人","どうこくにん"],["で"],["私","わたくし"],["と"],["いっしょ"],["に"],["投獄","とうごく"],["された"],["こと"],["の"],["ある"],["、"],["アンドロニコ"],["と"],["ユニアス"],["に"],["も"],["よろしく"],["。"],["この"],["人々","ひとびと"],["は"],["使徒","しと"],["たち"],["の"],["間","あいだ"],["に"],["よく"],["知られて","しられて"],["いる"],["人々","ひとびと"],["で"],["、"],["また"],["私","わたくし"],["より"],["先","さき"],["に"],["キリスト"],["に"],["ある"],["者","もの"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":8,"text":"主にあって私の愛するアムプリアトによろしく。","tok":[["主に","おもに"],["あって"],["私","わたくし"],["の"],["愛する","あいする"],["アムプリアト"],["に"],["よろしく"],["。"]]},{"verse":9,"text":"キリストにあって私たちの同労者であるウルバノと、私の愛するスタキスとによろしく。","tok":[["キリスト"],["に"],["あって"],["私たち","わたしたち"],["の"],["同労者","どうろうしゃ"],["で"],["ある"],["ウルバノ"],["と"],["、"],["私","わたくし"],["の"],["愛する","あいする"],["スタキス"],["と"],["に"],["よろしく"],["。"]]},{"verse":10,"text":"キリストにあって練達したアペレによろしく。アリストブロの家の人たちによろしく。","tok":[["キリスト"],["に"],["あって"],["練達","れんたつ"],["した"],["アペレ"],["に"],["よろしく"],["。"],["アリストブロ"],["の"],["家","いえ"],["の"],["人","ひと"],["たち"],["に"],["よろしく"],["。"]]},{"verse":11,"text":"私の同国人ヘロデオンによろしく。ナルキソの家の主にある人たちによろしく。","tok":[["私","わたくし"],["の"],["同国人","どうこくにん"],["ヘロデオン"],["に"],["よろしく"],["。"],["ナルキソ"],["の"],["家","いえ"],["の"],["主","ぬし"],["に"],["ある"],["人","ひと"],["たち"],["に"],["よろしく"],["。"]]},{"verse":12,"text":"主にあって労している、ツルパナとツルポサによろしく。主にあって非常に労苦した愛するペルシスによろしく。","tok":[["主に","おもに"],["あって"],["労して","ろうして"],["いる"],["、"],["ツルパナ"],["と"],["ツルポサ"],["に"],["よろしく"],["。"],["主に","おもに"],["あって"],["非常","ひじょう"],["に"],["労苦","ろうく"],["した"],["愛する","あいする"],["ペルシス"],["に"],["よろしく"],["。"]]},{"verse":13,"text":"主にあって選ばれた人ルポスによろしく。また彼と私との母によろしく。","tok":[["主に","おもに"],["あって"],["選ばれた","えらばれた"],["人","ひと"],["ルポス"],["に"],["よろしく"],["。"],["また"],["彼","かれ"],["と"],["私","わたくし"],["と"],["の"],["母","はは"],["に"],["よろしく"],["。"]]},{"verse":14,"text":"アスンクリト、フレゴン、ヘルメス、パトロバ、ヘルマスおよびその人たちといっしょにいる兄弟たちによろしく。","tok":[["アスンクリト"],["、"],["フレゴン"],["、"],["ヘルメス"],["、"],["パトロバ"],["、"],["ヘルマス"],["および"],["その"],["人","ひと"],["たち"],["と"],["いっしょ"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["に"],["よろしく"],["。"]]},{"verse":15,"text":"フィロロゴとユリヤ、ネレオとその姉妹、オルンパおよびその人たちといっしょにいるすべての聖徒たちによろしく。","tok":[["フィロロゴ"],["と"],["ユリヤ"],["、"],["ネレオ"],["と"],["その"],["姉妹","しまい"],["、"],["オルンパ"],["および"],["その"],["人","ひと"],["たち"],["と"],["いっしょ"],["に"],["いる"],["すべて"],["の"],["聖徒","せいと"],["たち"],["に"],["よろしく"],["。"]]},{"verse":16,"text":"あなたがたは聖なる口づけをもって互いのあいさつをかわしなさい。キリストの教会はみな、あなたがたによろしくと言っています。","tok":[["あなた"],["がた"],["は"],["聖","せい"],["なる"],["口づけ","くちづけ"],["を"],["もって"],["互い","たがい"],["の"],["あいさつ"],["を"],["かわし"],["なさい"],["。"],["キリスト"],["の"],["教会","きょうかい"],["は"],["みな"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":17,"text":"兄弟たち。私はあなたがたに願います。あなたがたの学んだ教えにそむいて、分裂とつまずきを引き起こす人たちを警戒してください。彼らから遠ざかりなさい。","tok":[["兄弟","きょうだい"],["たち"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["願います","ねがいます"],["。"],["あなた"],["がた"],["の"],["学んだ","まなんだ"],["教え","おしえ"],["に"],["そむいて"],["、"],["分裂","ぶんれつ"],["と"],["つまずき"],["を"],["引き起こす","ひきおこす"],["人","ひと"],["たち"],["を"],["警戒","けいかい"],["して"],["ください"],["。"],["彼","かれ"],["ら"],["から"],["遠ざかり","とおざかり"],["なさい"],["。"]]},{"verse":18,"text":"そういう人たちは、私たちの主キリストに仕えないで、自分の欲に仕えているのです。彼らは、なめらかなことば、へつらいのことばをもって純朴な人たちの心をだましているのです。","tok":[["そう"],["いう"],["人","ひと"],["たち"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["キリスト"],["に"],["仕えないで","つかえないで"],["、"],["自分","じぶん"],["の"],["欲","よく"],["に"],["仕えて","つかえて"],["いる"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["なめらか"],["な"],["ことば"],["、"],["へつらい"],["の"],["ことば"],["を"],["もって"],["純朴","じゅんぼく"],["な"],["人","ひと"],["たち"],["の"],["心","こころ"],["を"],["だまして"],["いる"],["の"],["です"],["。"]]},{"verse":19,"text":"あなたがたの従順はすべての人に知られているので、私はあなたがたのことを喜んでいます。しかし、私は、あなたがたが善にはさとく、悪にはうとくあってほしい、と望んでいます。","tok":[["あなた"],["がた"],["の"],["従順","じゅうじゅん"],["は"],["すべて"],["の"],["人","ひと"],["に"],["知られて","しられて"],["いる"],["ので"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["こと"],["を"],["喜んで","よろこんで"],["います"],["。"],["しかし"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["が"],["善","ぜん"],["に"],["は"],["さとく"],["、"],["悪","わる"],["に"],["は"],["うとく"],["あって"],["ほしい"],["、"],["と"],["望んで","のぞんで"],["います"],["。"]]},{"verse":20,"text":"平和の神は、すみやかに、あなたがたの足でサタンを踏み砕いてくださいます。／どうか、私たちの主イエスの恵みが、あなたがたとともにありますように。","tok":[["平和","へいわ"],["の"],["神","かみ"],["は"],["、"],["すみやか"],["に"],["、"],["あなた"],["がた"],["の"],["足","あし"],["で"],["サタン"],["を"],["踏み砕いて","ふみくだいて"],["くださいます"],["。"],["／"],["どう"],["か"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["の"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["あります"],["よう"],["に"],["。"]]},{"verse":21,"text":"私の同労者テモテが、あなたがたによろしくと言っています。また私の同国人ルキオとヤソンとソシパテロがよろしくと言っています。","tok":[["私","わたくし"],["の"],["同労者","どうろうしゃ"],["テモテ"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["また"],["私","わたくし"],["の"],["同国人","どうこくにん"],["ルキオ"],["と"],["ヤソン"],["と"],["ソシパテロ"],["が"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":22,"text":"この手紙を筆記した私、テルテオも、主にあってあなたがたにごあいさつ申し上げます。","tok":[["この"],["手紙","てがみ"],["を"],["筆記","ひっき"],["した"],["私","わたくし"],["、"],["テルテオ"],["も"],["、"],["主に","おもに"],["あって"],["あなた"],["がた"],["に"],["ごあいさつ"],["申し上げます","もうしあげます"],["。"]]},{"verse":23,"text":"私と全教会との家主であるガイオも、あなたがたによろしくと言っています。市の収入役であるエラストと兄弟クワルトもよろしくと言っています。","tok":[["私","わたくし"],["と"],["全教","ぜんきょう"],["会","かい"],["と"],["の"],["家主","やぬし"],["で"],["ある"],["ガイオ"],["も"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["市","し"],["の"],["収入役","しゅうにゅうやく"],["で"],["ある"],["エラスト"],["と"],["兄弟","きょうだい"],["クワルト"],["も"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":24,"text":"異本に二四節として「私たちの主イエス・キリストの恵みがあなたがたすべてとともにありますように。アーメン」を挿入するものがある。","tok":[["異本","いほん"],["に"],["二四","によん"],["節","せつ"],["として"],["「"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["恵み","めぐみ"],["が"],["あなた"],["がた"],["すべて"],["と"],["とも"],["に"],["あります"],["よう"],["に"],["。"],["アーメン"],["」"],["を"],["挿入","そうにゅう"],["する"],["もの"],["が"],["ある"],["。"]]},{"verse":25,"text":"私の福音とイエス・キリストの宣教によって、すなわち、世々にわたって長い間隠されていたが、今や現されて、永遠の神の命令に従い、預言者たちの書によって、信仰の従順に導くためにあらゆる国の人々に知らされた奥義の啓示によって、あなたがたを堅く立たせることができる方、","tok":[["私","わたくし"],["の"],["福音","ふくいん"],["と"],["イエス"],["・"],["キリスト"],["の"],["宣教","せんきょう"],["によって"],["、"],["すなわち"],["、"],["世々","せいせい"],["に"],["わたって"],["長い","ながい"],["間","あいだ"],["隠されて","かくされて"],["いた"],["が"],["、"],["今","いま"],["や"],["現されて","あらわされて"],["、"],["永遠","えいえん"],["の"],["神","かみ"],["の"],["命令","めいれい"],["に"],["従い","したがい"],["、"],["預言者","よげんしゃ"],["たち"],["の"],["書","しょ"],["によって"],["、"],["信仰","しんこう"],["の"],["従順","じゅうじゅん"],["に"],["導く","みちびく"],["ため"],["に"],["あらゆる"],["国","くに"],["の"],["人々","ひとびと"],["に"],["知らされた","しらされた"],["奥義","おうぎ"],["の"],["啓示","けいじ"],["によって"],["、"],["あなた"],["がた"],["を"],["堅く","かたく"],["立たせる","たたせる"],["こと"],["が"],["できる"],["方","かた"],["、"]]},{"verse":26,"text":"-","tok":[["-"]]},{"verse":27,"text":"知恵に富む唯一の神に、イエス・キリストによって、御栄えがとこしえまでありますように。アーメン。","tok":[["知恵","ちえ"],["に"],["富む","とむ"],["唯一","ゆいいつ"],["の"],["神","かみ"],["に"],["、"],["イエス"],["・"],["キリスト"],["によって"],["、"],["御栄え","おはえ"],["が"],["とこしえ"],["まで"],["あります"],["よう"],["に"],["。"],["アーメン"],["。"]]}]
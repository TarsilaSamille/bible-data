[{"verse":1,"text":"ですから、すべて他人をさばく人よ。あなたに弁解の余地はありません。あなたは、他人をさばくことによって、自分自身を罪に定めています。さばくあなたが、それと同じことを行っているからです。","tok":[["です"],["から"],["、"],["すべて"],["他人","たにん"],["を"],["さばく"],["人","ひと"],["よ"],["。"],["あなた"],["に"],["弁解","べんかい"],["の"],["余地","よち"],["は"],["ありません"],["。"],["あなた"],["は"],["、"],["他人","たにん"],["を"],["さばく"],["こと"],["によって"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["罪","つみ"],["に"],["定めて","さだめて"],["います"],["。"],["さばく"],["あなた"],["が"],["、"],["それ"],["と"],["同じ","おなじ"],["こと"],["を"],["行って","おこなって"],["いる"],["から"],["です"],["。"]]},{"verse":2,"text":"私たちは、そのようなことを行っている人々に下る神のさばきが正しいことを知っています。","tok":[["私たち","わたしたち"],["は"],["、"],["その"],["よう"],["な"],["こと"],["を"],["行って","おこなって"],["いる"],["人々","ひとびと"],["に"],["下る","くだる"],["神","かみ"],["の"],["さばき"],["が"],["正しい","ただしい"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":3,"text":"そのようなことをしている人々をさばきながら、自分で同じことをしている人よ。あなたは、自分は神のさばきを免れるのだとでも思っているのですか。","tok":[["その"],["よう"],["な"],["こと"],["を"],["して"],["いる"],["人々","ひとびと"],["を"],["さばき"],["ながら"],["、"],["自分","じぶん"],["で"],["同じ","おなじ"],["こと"],["を"],["して"],["いる"],["人","ひと"],["よ"],["。"],["あなた"],["は"],["、"],["自分","じぶん"],["は"],["神","かみ"],["の"],["さばき"],["を"],["免れる","まぬがれる"],["の"],["だ"],["と"],["で"],["も"],["思って","おもって"],["いる"],["の"],["です"],["か"],["。"]]},{"verse":4,"text":"それとも、神の慈愛があなたを悔い改めに導くことも知らないで、その豊かな慈愛と忍耐と寛容とを軽んじているのですか。","tok":[["それ"],["と"],["も"],["、"],["神","かみ"],["の"],["慈愛","じあい"],["が"],["あなた"],["を"],["悔い改め","くいあらため"],["に"],["導く","みちびく"],["こと"],["も"],["知らないで","しらないで"],["、"],["その"],["豊か","ゆたか"],["な"],["慈愛","じあい"],["と"],["忍耐","にんたい"],["と"],["寛容","かんよう"],["と"],["を"],["軽んじて","かろんじて"],["いる"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"ところが、あなたは、かたくなさと悔い改めのない心のゆえに、御怒りの日、すなわち、神の正しいさばきの現れる日の御怒りを自分のために積み上げているのです。","tok":[["ところ"],["が"],["、"],["あなた"],["は"],["、"],["かたくな"],["さ"],["と"],["悔い改め","くいあらため"],["の"],["ない"],["心","こころ"],["の"],["ゆえ"],["に"],["、"],["御怒り","おいかり"],["の"],["日","ひ"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["正しい","ただしい"],["さばき"],["の"],["現れる","あらわれる"],["日","ひ"],["の"],["御怒り","おいかり"],["を"],["自分","じぶん"],["の"],["ため"],["に"],["積み上げて","つみあげて"],["いる"],["の"],["です"],["。"]]},{"verse":6,"text":"神は、ひとりひとりに、その人の行いに従って報いをお与えになります。","tok":[["神","かみ"],["は"],["、"],["ひとりひとり"],["に"],["、"],["その"],["人","ひと"],["の"],["行い","おこない"],["に"],["従って","したがって"],["報い","むくい"],["を"],["お与え","おあたえ"],["に"],["なります"],["。"]]},{"verse":7,"text":"忍耐をもって善を行い、栄光と誉れと不滅のものとを求める者には、永遠のいのちを与え、","tok":[["忍耐","にんたい"],["を"],["もって"],["善","ぜん"],["を"],["行い","おこない"],["、"],["栄光","えいこう"],["と"],["誉れ","ほまれ"],["と"],["不滅","ふめつ"],["の"],["もの"],["と"],["を"],["求める","もとめる"],["者","もの"],["に"],["は"],["、"],["永遠","えいえん"],["の"],["いのち"],["を"],["与え","あたえ"],["、"]]},{"verse":8,"text":"党派心を持ち、真理に従わないで不義に従う者には、怒りと憤りを下されるのです。","tok":[["党派心","とうはしん"],["を"],["持ち","もち"],["、"],["真理","しんり"],["に"],["従わないで","したがわないで"],["不義","ふぎ"],["に"],["従う","したがう"],["者","もの"],["に"],["は"],["、"],["怒り","いかり"],["と"],["憤り","いきどおり"],["を"],["下される","くだされる"],["の"],["です"],["。"]]},{"verse":9,"text":"患難と苦悩とは、ユダヤ人をはじめギリシヤ人にも、悪を行うすべての者の上に下り、","tok":[["患難","かんなん"],["と"],["苦悩","くのう"],["と"],["は"],["、"],["ユダヤ人","ゆだやじん"],["を"],["はじめ"],["ギリシヤ"],["人","にん"],["に"],["も"],["、"],["悪","あく"],["を"],["行う","おこなう"],["すべて"],["の"],["者","もの"],["の"],["上","うえ"],["に"],["下り","くだり"],["、"]]},{"verse":10,"text":"栄光と誉れと平和は、ユダヤ人をはじめギリシヤ人にも、善を行うすべての者の上にあります。","tok":[["栄光","えいこう"],["と"],["誉れ","ほまれ"],["と"],["平和","へいわ"],["は"],["、"],["ユダヤ人","ゆだやじん"],["を"],["はじめ"],["ギリシヤ"],["人","にん"],["に"],["も"],["、"],["善","ぜん"],["を"],["行う","おこなう"],["すべて"],["の"],["者","もの"],["の"],["上","うえ"],["に"],["あります"],["。"]]},{"verse":11,"text":"神にはえこひいきなどはないからです。","tok":[["神","かみ"],["に"],["は"],["えこ"],["ひいき"],["など"],["は"],["ない"],["から"],["です"],["。"]]},{"verse":12,"text":"律法なしに罪を犯した者はすべて、律法なしに滅び、律法の下にあって罪を犯した者はすべて、律法によってさばかれます。","tok":[["律法","りっぽう"],["なし"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["は"],["すべて"],["、"],["律法","りっぽう"],["なし"],["に"],["滅び","ほろび"],["、"],["律法","りっぽう"],["の"],["下","した"],["に"],["あって"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["は"],["すべて"],["、"],["律法","りっぽう"],["によって"],["さばかれます"],["。"]]},{"verse":13,"text":"それは、律
[{"verse":1,"text":"兄弟たち。私が心の望みとし、また彼らのために神に願い求めているのは、彼らの救われることです。","tok":[["兄弟","きょうだい"],["たち"],["。"],["私","わたくし"],["が"],["心","こころ"],["の"],["望み","のぞみ"],["と"],["し"],["、"],["また"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["神","かみ"],["に"],["願い求めて","ねがいもとめて"],["いる"],["の"],["は"],["、"],["彼","かれ"],["ら"],["の"],["救われる","すくわれる"],["こと"],["です"],["。"]]},{"verse":2,"text":"私は、彼らが神に対して熱心であることをあかしします。しかし、その熱心は知識に基づくものではありません。","tok":[["私","わたくし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["神","かみ"],["に対して","にたいして"],["熱心","ねっしん"],["で"],["ある"],["こと"],["を"],["あかし"],["します"],["。"],["しかし"],["、"],["その"],["熱心","ねっしん"],["は"],["知識","ちしき"],["に"],["基づく","もとづく"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":3,"text":"というのは、彼らは神の義を知らず、自分自身の義を立てようとして、神の義に従わなかったからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["義","ぎ"],["を"],["知らず","しらず"],["、"],["自分","じぶん"],["自身","じしん"],["の"],["義","ぎ"],["を"],["立てよう","たてよう"],["として"],["、"],["神","かみ"],["の"],["義","ぎ"],["に"],["従わなかった","したがわなかった"],["から"],["です"],["。"]]},{"verse":4,"text":"キリストが律法を終わらせられたので、信じる人はみな義と認められるのです。","tok":[["キリスト"],["が"],["律法","りっぽう"],["を"],["終わらせられた","おわらせられた"],["ので"],["、"],["信じる","しんじる"],["人","ひと"],["は"],["みな"],["義","よし"],["と"],["認められる","みとめられる"],["の"],["です"],["。"]]},{"verse":5,"text":"モーセは、律法による義を行う人は、その義によって生きる、と書いています。","tok":[["モーセ"],["は"],["、"],["律法","りっぽう"],["に"],["よる"],["義","ぎ"],["を"],["行う","おこなう"],["人","ひと"],["は"],["、"],["その"],["義","ぎ"],["によって"],["生きる","いきる"],["、"],["と"],["書いて","かいて"],["います"],["。"]]},{"verse":6,"text":"しかし、信仰による義はこう言います。「あなたは心の中で、だれが天に上るだろうか、と言ってはいけない。」それはキリストを引き降ろすことです。","tok":[["しかし"],["、"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["は"],["こう"],["言います","いいます"],["。"],["「"],["あなた"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["だれ"],["が"],["天","てん"],["に"],["上るだろう","のぼるだろう"],["か"],["、"],["と"],["言って","いって"],["は"],["いけない"],["。"],["」"],["それ"],["は"],["キリスト"],["を"],["引き降ろす","ひきおろす"],["こと"],["です"],["。"]]},{"verse":7,"text":"また、「だれが地の奥底に下るだろうか、と言ってはいけない。」それはキリストを死者の中から引き上げることです。","tok":[["また"],["、"],["「"],["だれ"],["が"],["地","ち"],["の"],["奥底","おくそこ"],["に"],["下るだろう","くだるだろう"],["か"],["、"],["と"],["言って","いって"],["は"],["いけない"],["。"],["」"],["それ"],["は"],["キリスト"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["引き上げる","ひきあげる"],["こと"],["です"],["。"]]},{"verse":8,"text":"では、どう言っていますか。「みことばはあなたの近くにある。あなたの口にあり、あなたの心にある。」これは私たちの宣べ伝えている信仰のことばのことです。","tok":[["で"],["は"],["、"],["どう"],["言って","いって"],["います"],["か"],["。"],["「"],["みことば"],["は"],["あなた"],["の"],["近く","ちかく"],["に"],["ある"],["。"],["あなた"],["の"],["口","くち"],["に"],["あり"],["、"],["あなた"],["の"],["心","こころ"],["に"],["ある"],["。"],["」"],["これ"],["は"],["私たち","わたしたち"],["の"],["宣べ伝えて","のべつたえて"],["いる"],["信仰","しんこう"],["の"],["ことば"],["の"],["こと"],["です"],["。"]]},{"verse":9,"text":"なぜなら、もしあなたの口でイエスを主と告白し、あなたの心で神はイエスを死者の中からよみがえらせてくださったと信じるなら、あなたは救われるからです。","tok":[["なぜ"],["なら"],["、"],["もし"],["あなた"],["の"],["口","くち"],["で"],["イエス"],["を"],["主","ぬし"],["と"],["告白","こくはく"],["し"],["、"],["あなた"],["の"],["心","こころ"],["で"],["神","かみ"],["は"],["イエス"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせて"],["くださった"],["と"],["信じるなら","しんじるなら"],["、"],["あなた"],["は"],["救われる","すくわれる"],["から"],["です"],["。"]]},{"verse":10,"text":"人は心に信じて義と認められ、口で告白して救われるのです。","tok":[["人","ひと"],["は"],["心","こころ"],["に"],["信じて","しんじて"],["義","ぎ"],["と"],["認められ","みとめられ"],["、"],["口","くち"],["で"],["告白","こくはく"],["して"],["救われる","すくわれる"],["の"],["です"],["。"]]},{"verse":11,"text":"聖書はこう言っています。「彼に信頼する者は、失望させられることがない。」","tok":[["聖書","せいしょ"],["は"],["こう"],["言って","いって"],["います"],["。"],["「"],["彼","かれ"],["に"],["信頼","しんらい"],["する"],["者","もの"],["は"],["、"],["失望","しつぼう"],["させられる"],["こと"],["が"],["ない"],["。"],["」"]]},{"verse":12,"text":"ユダヤ人とギリシヤ人との区別はありません。同じ主が、すべての人の主であり、主を呼び求めるすべての人に対して恵み深くあられるからです。","tok":[["ユダヤ人","ゆだやじん"],["と"],["ギリシヤ"],["人","にん"],["と"],["の"],["区別","くべつ"],["は"],["ありません"],["。"],["同じ","おなじ"],["主","ぬし"],["が"],["、"],["すべて"],["の"],["人","ひと"],["の"],["主","ぬし"],["で"],["あり"],["、"],["主","ぬし"],["を"],["呼び求める","よびもとめる"],["すべて"],["の"],["人","ひと"],["に対して","にたいして"],["恵み","めぐみ"],["深く","ふかく"],["あられる"],["から"],["です"],["。"]]},{"verse":13,"text":"「主の御名を呼び求める者は、だれでも救われる」のです。","tok":[["「"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["呼び求める","よびもとめる"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["救われる","すくわれる"],["」"],["の"],["です"],["。"]]},{"verse":14,"text":"しかし、信じたことのない方を、どうして呼び求めることができるでしょう。聞いたことのない方を、どうして信じることができるでしょう。宣べ伝える人がなくて、どうして聞くことができるでしょう。","tok":[["しかし"],["、"],["信じた","しんじた"],["こと"],["の"],["ない"],["方","ほう"],["を"],["、"],["どう"],["して"],["呼び求める","よびもとめる"],["こと"],["が"],["できるでしょう"],["。"],["聞いた","きいた"],["こと"],["の"],["ない"],["方","ほう"],["を"],["、"],["どう"],["して"],["信じる","しんじる"],["こと"],["が"],["できるでしょう"],["。"],["宣べ伝える","のべつたえる"],["人","ひと"],["が"],["なくて"],["、"],["どう"],["して"],["聞く","きく"],["こと"],["が"],["できるでしょう"],["。"]]},{"verse":15,"text":"遣わされなくては、どうして宣べ伝えることができるでしょう。次のように書かれているとおりです。「良いことの知らせを伝える人々の足は、なんとりっぱでしょう。」","tok":[["遣わされなくて","つかわされなくて"],["は"],["、"],["どう"],["して"],["宣べ伝える","のべつたえる"],["こと"],["が"],["できるでしょう"],["。"],["次","つぎ"],["の"],["よう"],["に"],["書かれて","かかれて"],["いる"],["とおり"],["です"],["。"],["「"],["良い","よい"],["こと"],["の"],["知らせ","しらせ"],["を"],["伝える","つたえる"],["人々","ひとびと"],["の"],["足","あし"],["は"],["、"],["なん"],["と"],["りっぱ"],["でしょう"],["。"],["」"]]},{"verse":16,"text":"しかし、すべての人が福音に従ったのではありません。「主よ。だれが私たちの知らせを信じましたか」とイザヤは言っています。","tok":[["しかし"],["、"],["すべて"],["の"],["人","ひと"],["が"],["福音","ふくいん"],["に"],["従った","したがった"],["ので"],["は"],["ありません"],["。"],["「"],["主","ぬし"],["よ"],["。"],["だれ"],["が"],["私たち","わたしたち"],["の"],["知らせ","しらせ"],["を"],["信じました","しんじました"],["か"],["」"],["と"],["イザヤ"],["は"],["言って","いって"],["います"],["。"]]},{"verse":17,"text":"そのように、信仰は聞くことから始まり、聞くことは、キリストについてのみことばによるのです。","tok":[["その"],["よう"],["に"],["、"],["信仰","しんこう"],["は"],["聞く","きく"],["こと"],["から"],["始まり","はじまり"],["、"],["聞く","きく"],["こと"],["は"],["、"],["キリスト"],["について"],["のみ"],["ことば"],["に"],["よる"],["の"],["です"],["。"]]},{"verse":18,"text":"でも、こう尋ねましょう。「はたして彼らは聞こえなかったのでしょうか。」むろん、そうではありません。「その声は全地に響き渡り、そのことばは地の果てまで届いた。」","tok":[["で"],["も"],["、"],["こう"],["尋ねましょう","たずねましょう"],["。"],["「"],["はたして"],["彼","かれ"],["ら"],["は"],["聞こえなかった","きこえなかった"],["の"],["でしょう"],["か"],["。"],["」"],["むろん"],["、"],["そう"],["で"],["は"],["ありません"],["。"],["「"],["その"],["声","こえ"],["は"],["全地","ぜんち"],["に"],["響き","ひびき"],["渡り","わたり"],["、"],["その"],["ことば"],["は"],["地","ち"],["の"],["果て","はて"],["まで"],["届いた","とどいた"],["。"],["」"]]},{"verse":19,"text":"でも、私はこう言いましょう。「はたしてイスラエルは知らなかったのでしょうか。」まず、モーセがこう言っています。「わたしは、民でない者のことで、あなたがたのねたみを起こさせ、無知な国民のことで、あなたがたを怒らせる。」","tok":[["で"],["も"],["、"],["私","わたくし"],["は"],["こう"],["言いましょう","いいましょう"],["。"],["「"],["はたして"],["イスラエル"],["は"],["知らなかった","しらなかった"],["の"],["でしょう"],["か"],["。"],["」"],["まず"],["、"],["モーセ"],["が"],["こう"],["言って","いって"],["います"],["。"],["「"],["わたし"],["は"],["、"],["民","たみ"],["で"],["ない"],["者","もの"],["の"],["こと"],["で"],["、"],["あなた"],["がた"],["の"],["ねたみ"],["を"],["起こさせ","おこさせ"],["、"],["無知","むち"],["な"],["国民","こくみん"],["の"],["こと"],["で"],["、"],["あなた"],["がた"],["を"],["怒らせる","おこらせる"],["。"],["」"]]},{"verse":20,"text":"またイザヤは大胆にこう言っています。「わたしは、わたしを求めない者に見いだされ、わたしをたずねない者に自分を現した。」","tok":[["また"],["イザヤ"],["は"],["大胆","だいたん"],["に"],["こう"],["言って","いって"],["います"],["。"],["「"],["わたし"],["は"],["、"],["わたし"],["を"],["求めない","もとめない"],["者","もの"],["に"],["見いだされ","みいだされ"],["、"],["わたし"],["を"],["たずねない"],["者","もの"],["に"],["自分","じぶん"],["を"],["現した","あらわした"],["。"],["」"]]},{"verse":21,"text":"またイスラエルについては、こう言っています。「不従順で反抗する民に対して、わたしは一日中、手を差し伸べた。」","tok":[["また"],["イスラエル"],["について"],["は"],["、"],["こう"],["言って","いって"],["います"],["。"],["「"],["不","ふ"],["従順","じゅうじゅん"],["で"],["反抗","はんこう"],["する"],["民","たみ"],["に対して","にたいして"],["、"],["わたし"],["は"],["一","いち"],["日中","にちちゅう"],["、"],["手","て"],["を"],["差し伸べた","さしのべた"],["。"],["」"]]}]
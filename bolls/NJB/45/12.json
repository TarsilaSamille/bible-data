[{"verse":1,"text":"そういうわけですから、兄弟たち。私は、神のあわれみのゆえに、あなたがたにお願いします。あなたがたのからだを、神に受け入れられる、聖い、生きた供え物としてささげなさい。それこそ、あなたがたの霊的な礼拝です。","tok":[["そう"],["いう"],["わけ"],["です"],["から"],["、"],["兄弟","きょうだい"],["たち"],["。"],["私","わたくし"],["は"],["、"],["神","かみ"],["の"],["あわれみ"],["の"],["ゆえ"],["に"],["、"],["あなた"],["がた"],["に"],["お願い","おねがい"],["します"],["。"],["あなた"],["がた"],["の"],["からだ"],["を"],["、"],["神","かみ"],["に"],["受け入れられる","うけいれられる"],["、"],["聖い","きよい"],["、"],["生きた","いきた"],["供え物","そなえもの"],["として"],["ささげ"],["なさい"],["。"],["それ"],["こそ"],["、"],["あなた"],["がた"],["の"],["霊的","れいてき"],["な"],["礼拝","れいはい"],["です"],["。"]]},{"verse":2,"text":"この世と調子を合わせてはいけません。いや、むしろ、神のみこころは何か、すなわち、何が良いことで、神に受け入れられ、完全であるのかをわきまえ知るために、心の一新によって自分を変えなさい。","tok":[["この世","このよ"],["と"],["調子","ちょうし"],["を"],["合わせて","あわせて"],["は"],["いけません"],["。"],["いや"],["、"],["むしろ"],["、"],["神","かみ"],["のみ"],["こころ"],["は"],["何","なん"],["か"],["、"],["すなわち"],["、"],["何","なん"],["が"],["良い","よい"],["こと"],["で"],["、"],["神","かみ"],["に"],["受け入れられ","うけいれられ"],["、"],["完全","かんぜん"],["で"],["ある"],["の"],["か"],["を"],["わきまえ知る","わきまえしる"],["ため"],["に"],["、"],["心","こころ"],["の"],["一新","いっしん"],["によって"],["自分","じぶん"],["を"],["変え","かえ"],["なさい"],["。"]]},{"verse":3,"text":"私は、自分に与えられた恵みによって、あなたがたひとりひとりに言います。だれでも、思うべき限度を越えて思い上がってはいけません。いや、むしろ、神がおのおのに分け与えてくださった信仰の量りに応じて、慎み深い考え方をしなさい。","tok":[["私","わたくし"],["は"],["、"],["自分","じぶん"],["に"],["与えられた","あたえられた"],["恵み","めぐみ"],["によって"],["、"],["あなた"],["がた"],["ひとりひとり"],["に"],["言います","いいます"],["。"],["だれ"],["で"],["も"],["、"],["思うべき","おもうべき"],["限度","げんど"],["を"],["越えて","こえて"],["思い上がって","おもいあがって"],["は"],["いけません"],["。"],["いや"],["、"],["むしろ"],["、"],["神","かみ"],["が"],["おのおの"],["に"],["分け与えて","わけあたえて"],["くださった"],["信仰","しんこう"],["の"],["量り","はかり"],["に"],["応じて","おうじて"],["、"],["慎み深い","つつしみぶかい"],["考え方","かんがえかた"],["を"],["し"],["なさい"],["。"]]},{"verse":4,"text":"一つのからだには多くの器官があって、すべての器官が同じ働きはしないのと同じように、","tok":[["一","ひと"],["つ"],["の"],["からだ"],["に"],["は"],["多く","おおく"],["の"],["器官","きかん"],["が"],["あって"],["、"],["すべて"],["の"],["器官","きかん"],["が"],["同じ","おなじ"],["働き","はたらき"],["は"],["しない"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["、"]]},{"verse":5,"text":"大ぜいいる私たちも、キリストにあって一つのからだであり、ひとりひとり互いに器官なのです。","tok":[["大ぜい","おおぜい"],["いる"],["私たち","わたしたち"],["も"],["、"],["キリスト"],["に"],["あって"],["一","ひと"],["つ"],["の"],["からだ"],["で"],["あり"],["、"],["ひとりひとり"],["互い","たがい"],["に"],["器官","きかん"],["な"],["の"],["です"],["。"]]},{"verse":6,"text":"私たちは、与えられた恵みに従って、異なった賜物を持っているので、もしそれが預言であれば、その信仰に応じて預言しなさい。","tok":[["私たち","わたしたち"],["は"],["、"],["与えられた","あたえられた"],["恵み","めぐみ"],["に"],["従って","したがって"],["、"],["異なった","ことなった"],["賜物","たまもの"],["を"],["持って","もって"],["いる"],["ので"],["、"],["もし"],["それ"],["が"],["預言","よげん"],["で"],["あれば"],["、"],["その"],["信仰","しんこう"],["に"],["応じて","おうじて"],["預言","よげん"],["し"],["なさい"],["。"]]},{"verse":7,"text":"奉仕であれば奉仕し、教える人であれば教えなさい。","tok":[["奉仕","ほうし"],["で"],["あれば"],["奉仕","ほうし"],["し"],["、"],["教える","おしえる"],["人","ひと"],["で"],["あれば"],["教え","おしえ"],["なさい"],["。"]]},{"verse":8,"text":"勧めをする人であれば勧め、分け与える人は惜しまずに分け与え、指導する人は熱心に指導し、慈善を行う人は喜んでそれをしなさい。","tok":[["勧め","すすめ"],["を"],["する"],["人","ひと"],["で"],["あれば"],["勧め","すすめ"],["、"],["分け与える","わけあたえる"],["人","ひと"],["は"],["惜しまず","おしまず"],["に"],["分け与え","わけあたえ"],["、"],["指導","しどう"],["する"],["人","ひと"],["は"],["熱心","ねっしん"],["に"],["指導","しどう"],["し"],["、"],["慈善","じぜん"],["を"],["行う","おこなう"],["人","ひと"],["は"],["喜んで","よろこんで"],["それ"],["を"],["し"],["なさい"],["。"]]},{"verse":9,"text":"愛には偽りがあってはなりません。悪を憎み、善に親しみなさい。","tok":[["愛","あい"],["に"],["は"],["偽り","いつわり"],["が"],["あって"],["は"],["なりません"],["。"],["悪","あく"],["を"],["憎み","にくみ"],["、"],["善","ぜん"],["に"],["親しみ","したしみ"],["なさい"],["。"]]},{"verse":10,"text":"兄弟愛をもって心から互いに愛し合い、尊敬をもって互いに人を自分よりまさっていると思いなさい。","tok":[["兄弟","きょうだい"],["愛","あい"],["を"],["もって"],["心","こころ"],["から"],["互い","たがい"],["に"],["愛し合い","あいしあい"],["、"],["尊敬","そんけい"],["を"],["もって"],["互い","たがい"],["に"],["人","ひと"],["を"],["自分","じぶん"],["より"],["まさって"],["いる"],["と"],["思い","おもい"],["なさい"],["。"]]},{"verse":11,"text":"勤勉で怠らず、霊に燃え、主に仕えなさい。","tok":[["勤勉","きんべん"],["で"],["怠らず","おこたらず"],["、"],["霊","れい"],["に"],["燃え","もえ"],["、"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":12,"text":"望みを抱いて喜び、患難に耐え、絶えず祈りに励みなさい。","tok":[["望み","のぞみ"],["を"],["抱いて","いだいて"],["喜び","よろこび"],["、"],["患難","かんなん"],["に"],["耐え","たえ"],["、"],["絶えず","たえず"],["祈り","いのり"],["に"],["励み","はげみ"],["なさい"],["。"]]},{"verse":13,"text":"聖徒の入用に協力し、旅人をもてなしなさい。","tok":[["聖徒","せいと"],["の"],["入用","にゅうよう"],["に"],["協力","きょうりょく"],["し"],["、"],["旅人","たびびと"],["を"],["もてなし"],["なさい"],["。"]]},{"verse":14,"text":"あなたがたを迫害する者を祝福しなさい。祝福すべきであって、のろってはいけません。","tok":[["あなた"],["がた"],["を"],["迫害","はくがい"],["する"],["者","もの"],["を"],["祝福","しゅくふく"],["し"],["なさい"],["。"],["祝福","しゅくふく"],["すべきで"],["あって"],["、"],["のろって"],["は"],["いけません"],["。"]]},{"verse":15,"text":"喜ぶ者といっしょに喜び、泣く者といっしょに泣きなさい。","tok":[["喜ぶ","よろこぶ"],["者","もの"],["と"],["いっしょ"],["に"],["喜び","よろこび"],["、"],["泣く","なく"],["者","もの"],["と"],["いっしょ"],["に"],["泣き","なき"],["なさい"],["。"]]},{"verse":16,"text":"互いに一つ心になり、高ぶった思いを持たず、かえって身分の低い者に順応しなさい。自分こそ知者だなどと思ってはいけません。","tok":[["互い","たがい"],["に"],["一","ひと"],["つ"],["心","こころ"],["に"],["なり"],["、"],["高ぶった","たかぶった"],["思い","おもい"],["を"],["持たず","もたず"],["、"],["かえって"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["に"],["順応","じゅんのう"],["し"],["なさい"],["。"],["自分","じぶん"],["こそ"],["知者","ちしゃ"],["だ"],["など"],["と"],["思って","おもって"],["は"],["いけません"],["。"]]},{"verse":17,"text":"だれに対してでも、悪に悪を報いることをせず、すべての人が良いと思うことを図りなさい。","tok":[["だれ"],["に対して","にたいして"],["で"],["も"],["、"],["悪","わる"],["に"],["悪","あく"],["を"],["報いる","むくいる"],["こと"],["を"],["せず"],["、"],["すべて"],["の"],["人","ひと"],["が"],["良い","よい"],["と"],["思う","おもう"],["こと"],["を"],["図り","はかり"],["なさい"],["。"]]},{"verse":18,"text":"あなたがたは、自分に関する限り、すべての人と平和を保ちなさい。","tok":[["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["に"],["関する","かんする"],["限り","かぎり"],["、"],["すべて"],["の"],["人","ひと"],["と"],["平和","へいわ"],["を"],["保ち","たもち"],["なさい"],["。"]]},{"verse":19,"text":"愛する人たち。自分で復讐してはいけません。神の怒りに任せなさい。それは、こう書いてあるからです。「復讐はわたしのすることである。わたしが報いをする、と主は言われる。」","tok":[["愛する","あいする"],["人","ひと"],["たち"],["。"],["自分","じぶん"],["で"],["復讐","ふくしゅう"],["して"],["は"],["いけません"],["。"],["神","かみ"],["の"],["怒り","いかり"],["に"],["任せ","まかせ"],["なさい"],["。"],["それ"],["は"],["、"],["こう"],["書いて","かいて"],["ある"],["から"],["です"],["。"],["「"],["復讐","ふくしゅう"],["は"],["わたし"],["の"],["する"],["こと"],["で"],["ある"],["。"],["わたし"],["が"],["報い","むくい"],["を"],["する"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["」"]]},{"verse":20,"text":"もしあなたの敵が飢えたなら、彼に食べさせなさい。渇いたなら、飲ませなさい。そうすることによって、あなたは彼の頭に燃える炭火を積むことになるのです。","tok":[["もし"],["あなた"],["の"],["敵","てき"],["が"],["飢えたなら","うえたなら"],["、"],["彼","かれ"],["に"],["食べさせ","たべさせ"],["なさい"],["。"],["渇いたなら","かわいたなら"],["、"],["飲ませ","のませ"],["なさい"],["。"],["そう"],["する"],["こと"],["によって"],["、"],["あなた"],["は"],["彼","かれ"],["の"],["頭","あたま"],["に"],["燃える","もえる"],["炭火","すみび"],["を"],["積む","つむ"],["こと"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":21,"text":"悪に負けてはいけません。かえって、善をもって悪に打ち勝ちなさい。","tok":[["悪","わる"],["に"],["負けて","まけて"],["は"],["いけません"],["。"],["かえって"],["、"],["善","ぜん"],["を"],["もって"],["悪","わる"],["に"],["打ち勝ち","うちかち"],["なさい"],["。"]]}]
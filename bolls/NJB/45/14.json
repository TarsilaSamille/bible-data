[{"verse":1,"text":"あなたがたは信仰の弱い人を受け入れなさい。その意見をさばいてはいけません。","tok":[["あなた"],["がた"],["は"],["信仰","しんこう"],["の"],["弱い","よわい"],["人","ひと"],["を"],["受け入れ","うけいれ"],["なさい"],["。"],["その"],["意見","いけん"],["を"],["さばいて"],["は"],["いけません"],["。"]]},{"verse":2,"text":"何でも食べてよいと信じている人もいますが、弱い人は野菜よりほかには食べません。","tok":[["何","なん"],["で"],["も"],["食べて","たべて"],["よい"],["と"],["信じて","しんじて"],["いる"],["人","ひと"],["も"],["います"],["が"],["、"],["弱い","よわい"],["人","ひと"],["は"],["野菜","やさい"],["より"],["ほか"],["に"],["は"],["食べません","たべません"],["。"]]},{"verse":3,"text":"食べる人は食べない人を侮ってはいけないし、食べない人も食べる人をさばいてはいけません。神がその人を受け入れてくださったからです。","tok":[["食べる","たべる"],["人","ひと"],["は"],["食べない","たべない"],["人","ひと"],["を"],["侮って","あなどって"],["は"],["いけない"],["し"],["、"],["食べない","たべない"],["人","ひと"],["も"],["食べる","たべる"],["人","ひと"],["を"],["さばいて"],["は"],["いけません"],["。"],["神","かみ"],["が"],["その"],["人","ひと"],["を"],["受け入れて","うけいれて"],["くださった"],["から"],["です"],["。"]]},{"verse":4,"text":"あなたはいったいだれなので、他人のしもべをさばくのですか。しもべが立つのも倒れるのも、その主人の心次第です。このしもべは立つのです。なぜなら、主には、彼を立たせることができるからです。","tok":[["あなた"],["は"],["いったい"],["だれ"],["な"],["ので"],["、"],["他人","たにん"],["の"],["しもべ"],["を"],["さばく"],["の"],["です"],["か"],["。"],["しもべ"],["が"],["立つ","たつ"],["の"],["も"],["倒れる","たおれる"],["の"],["も"],["、"],["その"],["主人","しゅじん"],["の"],["心","こころ"],["次第","しだい"],["です"],["。"],["この"],["しもべ"],["は"],["立つ","たつ"],["の"],["です"],["。"],["なぜ"],["なら"],["、"],["主","ぬし"],["に"],["は"],["、"],["彼","かれ"],["を"],["立たせる","たたせる"],["こと"],["が"],["できる"],["から"],["です"],["。"]]},{"verse":5,"text":"ある日を、他の日に比べて、大事だと考える人もいますが、どの日も同じだと考える人もいます。それぞれ自分の心の中で確信を持ちなさい。","tok":[["ある"],["日","ひ"],["を"],["、"],["他","た"],["の"],["日","ひ"],["に"],["比べて","くらべて"],["、"],["大事","だいじ"],["だ"],["と"],["考える","かんがえる"],["人","ひと"],["も"],["います"],["が"],["、"],["どの"],["日","ひ"],["も"],["同じ","おなじ"],["だ"],["と"],["考える","かんがえる"],["人","ひと"],["も"],["います"],["。"],["それぞれ"],["自分","じぶん"],["の"],["心","こころ"],["の"],["中","なか"],["で"],["確信","かくしん"],["を"],["持ち","もち"],["なさい"],["。"]]},{"verse":6,"text":"日を守る人は、主のために守っています。食べる人は、主のために食べています。なぜなら、神に感謝しているからです。食べない人も、主のために食べないのであって、神に感謝しているのです。","tok":[["日","ひ"],["を"],["守る","まもる"],["人","ひと"],["は"],["、"],["主","ぬし"],["の"],["ため"],["に"],["守って","まもって"],["います"],["。"],["食べる","たべる"],["人","ひと"],["は"],["、"],["主","ぬし"],["の"],["ため"],["に"],["食べて","たべて"],["います"],["。"],["なぜ"],["なら"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["いる"],["から"],["です"],["。"],["食べない","たべない"],["人","ひと"],["も"],["、"],["主","ぬし"],["の"],["ため"],["に"],["食べない","たべない"],["ので"],["あって"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":7,"text":"私たちの中でだれひとりとして、自分のために生きている者はなく、また自分のために死ぬ者もありません。","tok":[["私たち","わたしたち"],["の"],["中","なか"],["で"],["だれ"],["ひとり"],["として"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["生きて","いきて"],["いる"],["者","もの"],["は"],["なく"],["、"],["また"],["自分","じぶん"],["の"],["ため"],["に"],["死ぬ","しぬ"],["者","もの"],["も"],["ありません"],["。"]]},{"verse":8,"text":"もし生きるなら、主のために生き、もし死ぬなら、主のために死ぬのです。ですから、生きるにしても、死ぬにしても、私たちは主のものです。","tok":[["もし"],["生きるなら","いきるなら"],["、"],["主","ぬし"],["の"],["ため"],["に"],["生き","いき"],["、"],["もし"],["死ぬなら","しぬなら"],["、"],["主","ぬし"],["の"],["ため"],["に"],["死ぬ","しぬ"],["の"],["です"],["。"],["です"],["から"],["、"],["生きる","いきる"],["に"],["して"],["も"],["、"],["死ぬ","しぬ"],["に"],["して"],["も"],["、"],["私たち","わたしたち"],["は"],["主","ぬし"],["の"],["もの"],["です"],["。"]]},{"verse":9,"text":"キリストは、死んだ人にとっても、生きている人にとっても、その主となるために、死んで、また生きられたのです。","tok":[["キリスト"],["は"],["、"],["死んだ","しんだ"],["人","ひと"],["にとって"],["も"],["、"],["生きて","いきて"],["いる"],["人","ひと"],["にとって"],["も"],["、"],["その"],["主","ぬし"],["と"],["なる"],["ため"],["に"],["、"],["死んで","しんで"],["、"],["また"],["生きられた","いきられた"],["の"],["です"],["。"]]},{"verse":10,"text":"それなのに、なぜ、あなたは自分の兄弟をさばくのですか。また、自分の兄弟を侮るのですか。私たちはみな、神のさばきの座に立つようになるのです。","tok":[["それ"],["な"],["のに"],["、"],["なぜ"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["さばく"],["の"],["です"],["か"],["。"],["また"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["侮る","あなどる"],["の"],["です"],["か"],["。"],["私たち","わたしたち"],["は"],["みな"],["、"],["神","かみ"],["の"],["さばき"],["の"],["座","ざ"],["に"],["立つ","たつ"],["よう"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":11,"text":"次のように書かれている
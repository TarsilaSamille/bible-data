、"],["いのち"],["と"],["平安","へいあん"],["です"],["。"]]},{"verse":7,"text":"というのは、肉の思いは神に対して反抗するものだからです。それは神の律法に服従しません。いや、服従できないのです。","tok":[["と"],["いう"],["の"],["は"],["、"],["肉","にく"],["の"],["思い","おもい"],["は"],["神","かみ"],["に対して","にたいして"],["反抗","はんこう"],["する"],["もの"],["だ"],["から"],["です"],["。"],["それ"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["に"],["服従","ふくじゅう"],["しません"],["。"],["いや"],["、"],["服従","ふくじゅう"],["できない"],["の"],["です"],["。"]]},{"verse":8,"text":"肉にある者は神を喜ばせることができません。","tok":[["肉","にく"],["に"],["ある"],["者","もの"],["は"],["神","かみ"],["を"],["喜ばせる","よろこばせる"],["こと"],["が"],["できません"],["。"]]},{"verse":9,"text":"けれども、もし神の御霊があなたがたのうちに住んでおられるなら、あなたがたは肉の中にではなく、御霊の中にいるのです。キリストの御霊を持たない人は、キリストのものではありません。","tok":[["けれど"],["も"],["、"],["もし"],["神","かみ"],["の"],["御霊","ごれい"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["住んで","すんで"],["おられるなら"],["、"],["あなた"],["がた"],["は"],["肉","にく"],["の"],["中","なか"],["に"],["で"],["は"],["なく"],["、"],["御霊","ごれい"],["の"],["中","なか"],["に"],["いる"],["の"],["です"],["。"],["キリスト"],["の"],["御霊","ごれい"],["を"],["持たない","もたない"],["人","ひと"],["は"],["、"],["キリスト"],["の"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":10,"text":"もしキリストがあなたがたのうちにおられるなら、からだは罪のゆえに死んでいても、霊が、義のゆえに生きています。","tok":[["もし"],["キリスト"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["おられるなら"],["、"],["からだ"],["は"],["罪","つみ"],["の"],["ゆえ"],["に"],["死んで","しんで"],["いて"],["も"],["、"],["霊","れい"],["が"],["、"],["義","ぎ"],["の"],["ゆえ"],["に"],["生きて","いきて"],["います"],["。"]]},{"verse":11,"text":"もしイエスを死者の中からよみがえらせた方の御霊が、あなたがたのうちに住んでおられるなら、キリスト・イエスを死者の中からよみがえらせた方は、あなたがたのうちに住んでおられる御霊によって、あなたがたの死ぬべきからだをも生かしてくださるのです。","tok":[["もし"],["イエス"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせた"],["方","ほう"],["の"],["御霊","ごれい"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["住んで","すんで"],["おられるなら"],["、"],["キリスト"],["・"],["イエス"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせた"],["方","ほう"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["住んで","すんで"],["おられる"],["御霊","ごれい"],["によって"],["、"],["あなた"],["がた"],["の"],["死ぬべき","しぬべき"],["からだ"],["を"],["も"],["生かして","いかして"],["くださる"],["の"],["です"],["。"]]},{"verse":12,"text":"ですから、兄弟たち。私たちは、肉に従って歩む責任を、肉に対して負ってはいません。","tok":[["です"],["から"],["、"],["兄弟","きょうだい"],["たち"],["。"],["私たち","わたしたち"],["は"],["、"],["肉","にく"],["に"],["従って","したがって"],["歩む","あゆむ"],["責任","せきにん"],["を"],["、"],["肉","にく"],["に対して","にたいして"],["負って","おって"],["は"],["いません"],["。"]]},{"verse":13,"text":"もし肉に従って生きるなら、あなたがたは死ぬのです。しかし、もし御霊によって、からだの行いを殺すなら、あなたがたは生きるのです。","tok":[["もし"],["肉","にく"],["に"],["従って","したがって"],["生きるなら","いきるなら"],["、"],["あなた"],["がた"],["は"],["死ぬ","しぬ"],["の"],["です"],["。"],["しかし"],["、"],["もし"],["御霊","ごれい"],["によって"],["、"],["からだ"],["の"],["行い","おこない"],["を"],["殺すなら","ころすなら"],["、"],["あなた"],["がた"],["は"],["生きる","いきる"],["の"],["です"],["。"]]},{"verse":14,"text":"神の御霊に導かれる人は、だれでも神の子どもです。","tok":[["神","かみ"],["の"],["御霊","ごれい"],["に"],["導かれる","みちびかれる"],["人","ひと"],["は"],["、"],["だれ"],["で"],["も"],["神","かみ"],["の"],["子ども","こども"],["です"],["。"]]},{"verse":15,"text":"あなたがたは、人を再び恐怖に陥れるような、奴隷の霊を受けたのではなく、子としてくださる御霊を受けたのです。私たちは御霊によって、「アバ、父」と呼びます。","tok":[["あなた"],["がた"],["は"],["、"],["人","ひと"],["を"],["再び","ふたたび"],["恐怖","きょうふ"],["に"],["陥れる","おとしいれる"],["よう"],["な"],["、"],["奴隷","どれい"],["の"],["霊","れい"],["を"],["受けた","うけた"],["ので"],["は"],["なく"],["、"],["子","こ"],["として"],["くださる"],["御霊","ごれい"],["を"],["受けた","うけた"],["の"],["です"],["。"],["私たち","わたしたち"],["は"],["御霊","ごれい"],["によって"],["、"],["「"],["アバ"],["、"],["父","ちち"],["」"],["と"],["呼びます","よびます"],["。"]]},{"verse":16,"text":"私たちが神の子どもであることは、御霊ご自身が、私たちの霊とともに、あかししてくださいます。","tok":[["私たち","わたしたち"],["が"],["神","かみ"],["の"],["子ども","こども"],["で"],["ある"],["こと"],["は"],["、"],["御霊","ごれい"],["ご自身","ごじしん"],["が"],["、"],["私たち","わたしたち"],["の"],["霊","れい"],["と"],["とも"],["に"],["、"],["あかし"],["して"],["くださいます"],["。"]]},{"verse":17,"text":"もし子どもであるなら、相続人でもあります。私たちがキリストと、栄光をともに受けるために苦難をともにしているなら、私たちは神の相続人であり、キリストとの共同相続人であります。","tok":[["もし"],["子ども","こども"],["で"],["あるなら"],["、"],["相続人","そうぞくにん"],["で"],["も"],["あります"],["。"],["私たち","わたしたち"],["が"],["キリスト"],["と"],["、"],["栄光","えいこう"],["を"],["とも"],["に"],["受ける","うける"],["ため"],["に"],["苦難","くなん"],["を"],["とも"],["に"],["して"],["いるなら"],["、"],[
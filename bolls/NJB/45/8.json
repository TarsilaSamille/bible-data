[["神","かみ"],["を"],["愛する","あいする"],["人々","ひとびと"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["ご計画","ごけいかく"],["に"],["従って","したがって"],["召された","めされた"],["人々","ひとびと"],["の"],["ため"],["に"],["は"],["、"],["神","かみ"],["が"],["すべて"],["の"],["こと"],["を"],["働かせて","はたらかせて"],["益","えき"],["として"],["くださる"],["こと"],["を"],["、"],["私たち","わたしたち"],["は"],["知って","しって"],["います"],["。"]]},{"verse":29,"text":"なぜなら、神は、あらかじめ知っておられる人々を、御子のかたちと同じ姿にあらかじめ定められたからです。それは、御子が多くの兄弟たちの中で長子となられるためです。","tok":[["なぜ"],["なら"],["、"],["神","かみ"],["は"],["、"],["あらかじめ"],["知って","しって"],["おられる"],["人々","ひとびと"],["を"],["、"],["御子","みこ"],["の"],["かたち"],["と"],["同じ","おなじ"],["姿","すがた"],["に"],["あらかじめ"],["定められた","さだめられた"],["から"],["です"],["。"],["それ"],["は"],["、"],["御子","みこ"],["が"],["多く","おおく"],["の"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["で"],["長子","ちょうし"],["と"],["なられる"],["ため"],["です"],["。"]]},{"verse":30,"text":"神はあらかじめ定めた人々をさらに召し、召した人々をさらに義と認め、義と認めた人々にはさらに栄光をお与えになりました。","tok":[["神","かみ"],["は"],["あらかじめ"],["定めた","さだめた"],["人々","ひとびと"],["を"],["さらに"],["召し","めし"],["、"],["召した","めした"],["人々","ひとびと"],["を"],["さらに"],["義","ぎ"],["と"],["認め","みとめ"],["、"],["義","ぎ"],["と"],["認めた","みとめた"],["人々","ひとびと"],["に"],["は"],["さらに"],["栄光","えいこう"],["を"],["お与え","おあたえ"],["に"],["なりました"],["。"]]},{"verse":31,"text":"では、これらのことからどう言えるでしょう。神が私たちの味方であるなら、だれが私たちに敵対できるでしょう。","tok":[["で"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["から"],["どう"],["言えるでしょう","いえるでしょう"],["。"],["神","かみ"],["が"],["私たち","わたしたち"],["の"],["味方","みかた"],["で"],["あるなら"],["、"],["だれ"],["が"],["私たち","わたしたち"],["に"],["敵対","てきたい"],["できるでしょう"],["。"]]},{"verse":32,"text":"私たちすべてのために、ご自分の御子をさえ惜しまずに死に渡された方が、どうして、御子といっしょにすべてのものを、私たちに恵んでくださらないことがありましょう。","tok":[["私たち","わたしたち"],["すべて"],["の"],["ため"],["に"],["、"],["ご自分","ごじぶん"],["の"],["御子","みこ"],["を"],["さえ"],["惜しまず","おしまず"],["に"],["死","し"],["に"],["渡された","わたされた"],["方","ほう"],["が"],["、"],["どう"],["して"],["、"],["御子","みこ"],["と"],["いっしょ"],["に"],["すべて"],["の"],["もの"],["を"],["、"],["私たち","わたしたち"],["に"],["恵んで","めぐんで"],["くださらない"],["こと"],["が"],["ありましょう"],["。"]]},{"verse":33,"text":"神に選ばれた人々を訴えるのはだれですか。神が義と認めてくださ
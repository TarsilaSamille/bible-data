[{"verse":1,"text":"ですから、信仰によって義と認められた私たちは、私たちの主イエス・キリストによって、神との平和を持っています。","tok":[["です"],["から"],["、"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["認められた","みとめられた"],["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["によって"],["、"],["神","かみ"],["と"],["の"],["平和","へいわ"],["を"],["持って","もって"],["います"],["。"]]},{"verse":2,"text":"またキリストによって、いま私たちの立っているこの恵みに信仰によって導き入れられた私たちは、神の栄光を望んで大いに喜んでいます。","tok":[["また"],["キリスト"],["によって"],["、"],["いま"],["私たち","わたしたち"],["の"],["立って","たって"],["いる"],["この"],["恵み","めぐみ"],["に"],["信仰","しんこう"],["によって"],["導き入れられた","みちびきいれられた"],["私たち","わたしたち"],["は"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["望んで","のぞんで"],["大いに","おおいに"],["喜んで","よろこんで"],["います"],["。"]]},{"verse":3,"text":"そればかりではなく、患難さえも喜んでいます。それは、患難が忍耐を生み出し、","tok":[["それ"],["ばかり"],["で"],["は"],["なく"],["、"],["患難","かんなん"],["さえ"],["も"],["喜んで","よろこんで"],["います"],["。"],["それ"],["は"],["、"],["患難","かんなん"],["が"],["忍耐","にんたい"],["を"],["生み出し","うみだし"],["、"]]},{"verse":4,"text":"忍耐が練られた品性を生み出し、練られた品性が希望を生み出すと知っているからです。","tok":[["忍耐","にんたい"],["が"],["練られた","ねられた"],["品性","ひんせい"],["を"],["生み出し","うみだし"],["、"],["練られた","ねられた"],["品性","ひんせい"],["が"],["希望","きぼう"],["を"],["生み出す","うみだす"],["と"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":5,"text":"この希望は失望に終わることがありません。なぜなら、私たちに与えられた聖霊によって、神の愛が私たちの心に注がれているからです。","tok":[["この"],["希望","きぼう"],["は"],["失望","しつぼう"],["に"],["終わる","おわる"],["こと"],["が"],["ありません"],["。"],["なぜ"],["なら"],["、"],["私たち","わたしたち"],["に"],["与えられた","あたえられた"],["聖霊","せいれい"],["によって"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["私たち","わたしたち"],["の"],["心","こころ"],["に"],["注がれて","そそがれて"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"私たちがまだ弱かったとき、キリストは定められた時に、不敬虔な者のために死んでくださいました。","tok":[["私たち","わたしたち"],["が"],["まだ"],["弱かった","よわかった"],["とき"],["、"],["キリスト"],["は"],["定められた","さだめられた"],["時","とき"],["に"],["、"],["不","ふ"],["敬虔","けいけん"],["な"],["者","もの"],["の"],["ため"],["に"],["死んで","しんで"],["くださいました"],["。"]]},{"verse":7,"text":"正しい人のためにでも死ぬ人はほとんどありません。情け深い人のためには、進んで死ぬ人があるいはいるでしょう。","tok":[["正しい","ただしい"],["人","ひと"],["の"],["ため"],["に"],["で"],["も"],["死ぬ","しぬ"],["人","ひと"],["は"],["ほとんど"],["ありません"],["。"],["情け深い","なさけぶかい"],["人","ひと"],["の"],["ため"],["に"],["は"],["、"],["進んで","すすんで"],["死ぬ","しぬ"],["人","ひと"],["が"],["あるいは"],["いるでしょう"],["。"]]},{"verse":8,"text":"しかし私たちがまだ罪人であったとき、キリストが私たちのために死んでくださったことにより、神は私たちに対するご自身の愛を明らかにしておられます。","tok":[["しかし"],["私たち","わたしたち"],["が"],["まだ"],["罪人","ざいにん"],["で"],["あった"],["とき"],["、"],["キリスト"],["が"],["私たち","わたしたち"],["の"],["ため"],["に"],["死んで","しんで"],["くださった"],["こと"],["に"],["より"],["、"],["神","かみ"],["は"],["私たち","わたしたち"],["に"],["対する","たいする"],["ご自身","ごじしん"],["の"],["愛","あい"],["を"],["明らか","あきらか"],["に"],["して"],["おられます"],["。"]]},{"verse":9,"text":"ですから、今すでにキリストの血によって義と認められた私たちが、彼によって神の怒りから救われるのは、なおさらのことです。","tok":[["です"],["から"],["、"],["今","いま"],["すでに"],["キリスト"],["の"],["血","ち"],["によって"],["義","ぎ"],["と"],["認められた","みとめられた"],["私たち","わたしたち"],["が"],["、"],["彼","かれ"],["によって"],["神","かみ"],["の"],["怒り","いかり"],["から"],["救われる","すくわれる"],["の"],["は"],["、"],["なおさら"],["の"],["こと"],["です"],["。"]]},{"verse":10,"text":"もし敵であった私たちが、御子の死によって神と和解させられたのなら、和解させられた私たちが、彼のいのちによって救いにあずかるのは、なおさらのことです。","tok":[["もし"],["敵","てき"],["で"],["あった"],["私たち","わたしたち"],["が"],["、"],["御子","みこ"],["の"],["死","し"],["によって"],["神","かみ"],["と"],["和解","わかい"],["させられた"],["の"],["なら"],["、"],["和解","わかい"],["させられた"],["私たち","わたしたち"],["が"],["、"],["彼","かれ"],["の"],["いのち"],["によって"],["救い","すくい"],["に"],["あずかる"],["の"],["は"],["、"],["なおさら"],["の"],["こと"],["です"],["。"]]},{"verse":11,"text":"そればかりでなく、私たちのために今や和解を成り立たせてくださった私たちの主イエス・キリストによって、私たちは神を大いに喜んでいるのです。","tok":[["それ"],["ばかり"],["で"],["なく"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["今","いま"],["や"],["和解","わかい"],["を"],["成り立たせて","なりたたせて"],["くださった"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["によって"],["、"],["私たち","わたしたち"],["は"],["神","かみ"],["を"],["大いに","おおいに"],["喜んで","よろこんで"],["いる"],["の"],["です"],["。"]]},{"verse":12,"text":"そういうわけで、ちょうどひとりの人によって罪が世界に入り、罪によって死が入り、こうして死が全人類に広がったのと同様に、――それというのも全人類が罪を犯したからです。","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["ちょうど"],["ひとり"],["の"],["人","ひと"],["によって"],["罪","つみ"],["が"],["世界","せかい"],["に"],["入り","はいり"],["、"],["罪","つみ"],["によって"],["死","し"],["が"],["入り","はいり"],["、"],["こう"],["して"],["死","し"],["が"],["全","ぜん"],["人類","じんるい"],["に"],["広がった","ひろがった"],["の"],["と"],["同様","どうよう"],["に"],["、"],["―"],["―"],["それ"],["と"],["いう"],["の"],["も"],["全","ぜん"],["人類","じんるい"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["です"],["。"]]},{"verse":13,"text":"というのは、律法が与えられるまでの時期にも罪は世にあったからです。しかし罪は、何かの律法がなければ、認められないものです。","tok":[["と"],["いう"],["の"],["は"],["、"],["律法","りっぽう"],["が"],["与えられる","あたえられる"],["まで"],["の"],["時期","じき"],["に"],["も"],["罪","つみ"],["は"],["世","よ"],["に"],["あった"],["から"],["です"],["。"],["しかし"],["罪","つみ"],["は"],["、"],["何","なん"],["か"],["の"],["律法","りっぽう"],["が"],["なければ"],["、"],["認められない","みとめられない"],["もの"],["です"],["。"]]},{"verse":14,"text":"ところが死は、アダムからモーセまでの間も、アダムの違反と同じようには罪を犯さなかった人々をさえ支配しました。アダムはきたるべき方のひな型です。","tok":[["ところ"],["が"],["死","し"],["は"],["、"],["アダム"],["から"],["モーセ"],["まで"],["の"],["間","あいだ"],["も"],["、"],["アダム"],["の"],["違反","いはん"],["と"],["同じ","おなじ"],["よう"],["に"],["は"],["罪","つみ"],["を"],["犯さなかった","おかさなかった"],["人々","ひとびと"],["を"],["さえ"],["支配","しはい"],["しました"],["。"],["アダム"],["は"],["きたるべき"],["方","ほう"],["の"],["ひな型","ひながた"],["です"],["。"]]},{"verse":15,"text":"ただし、恵みには違反の場合とは違う点があります。もしひとりの違反によって多くの人が死んだとすれば、それにもまして、神の恵みとひとりの人イエス・キリストの恵みによる賜物とは、多くの人々に満ちあふれるのです。","tok":[["ただし"],["、"],["恵み","めぐみ"],["に"],["は"],["違反","いはん"],["の"],["場合","ばあい"],["と"],["は"],["違う","ちがう"],["点","てん"],["が"],["あります"],["。"],["もし"],["ひとり"],["の"],["違反","いはん"],["によって"],["多く","おおく"],["の"],["人","ひと"],["が"],["死んだ","しんだ"],["と"],["すれば"],["、"],["それ"],["に"],["も"],["まして"],["、"],["神","かみ"],["の"],["恵み","めぐみ"],["と"],["ひとり"],["の"],["人","ひと"],["イエス"],["・"],["キリスト"],["の"],["恵み","めぐみ"],["に"],["よる"],["賜物","たまもの"],["と"],["は"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["に"],["満ちあふれる","みちあふれる"],["の"],["です"],["。"]]},{"verse":16,"text":"また、賜物には、罪を犯したひとりによる場合と違った点があります。さばきの場合は、一つの違反のために罪に定められたのですが、恵みの場合は、多くの違反が義と認められるからです。","tok":[["また"],["、"],["賜物","たまもの"],["に"],["は"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["ひとり"],["に"],["よる"],["場合","ばあい"],["と"],["違った","ちがった"],["点","てん"],["が"],["あります"],["。"],["さばき"],["の"],["場合","ばあい"],["は"],["、"],["一","ひと"],["つ"],["の"],["違反","いはん"],["の"],["ため"],["に"],["罪","つみ"],["に"],["定められた","さだめられた"],["の"],["です"],["が"],["、"],["恵み","めぐみ"],["の"],["場合","ばあい"],["は"],["、"],["多く","おおく"],["の"],["違反","いはん"],["が"],["義","ぎ"],["と"],["認められる","みとめられる"],["から"],["です"],["。"]]},{"verse":17,"text":"もしひとりの違反により、ひとりによって死が支配するようになったとすれば、なおさらのこと、恵みと義の賜物とを豊かに受けている人々は、ひとりのイエス・キリストにより、いのちにあって支配するのです。","tok":[["もし"],["ひとり"],["の"],["違反","いはん"],["に"],["より"],["、"],["ひとり"],["によって"],["死","し"],["が"],["支配","しはい"],["する"],["よう"],["に"],["なった"],["と"],["すれば"],["、"],["なおさら"],["の"],["こと"],["、"],["恵み","めぐみ"],["と"],["義","ぎ"],["の"],["賜物","たまもの"],["と"],["を"],["豊か","ゆたか"],["に"],["受けて","うけて"],["いる"],["人々","ひとびと"],["は"],["、"],["ひとり"],["の"],["イエス"],["・"],["キリスト"],["に"],["より"],["、"],["いのち"],["に"],["あって"],["支配","しはい"],["する"],["の"],["です"],["。"]]},{"verse":18,"text":"こういうわけで、ちょうどひとりの違反によってすべての人が罪に定められたのと同様に、ひとりの義の行為によってすべての人が義と認められ、いのちを与えられるのです。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["ちょうど"],["ひとり"],["の"],["違反","いはん"],["によって"],["すべて"],["の"],["人","ひと"],["が"],["罪","つみ"],["に"],["定められた","さだめられた"],["の"],["と"],["同様","どうよう"],["に"],["、"],["ひとり"],["の"],["義","ぎ"],["の"],["行為","こうい"],["によって"],["すべて"],["の"],["人","ひと"],["が"],["義","ぎ"],["と"],["認められ","みとめられ"],["、"],["いのち"],["を"],["与えられる","あたえられる"],["の"],["です"],["。"]]},{"verse":19,"text":"すなわち、ちょうどひとりの人の不従順によって多くの人が罪人とされたのと同様に、ひとりの従順によって多くの人が義人とされるのです。","tok":[["すなわち"],["、"],["ちょうど"],["ひとり"],["の"],["人","ひと"],["の"],["不","ふ"],["従順","じゅうじゅん"],["によって"],["多く","おおく"],["の"],["人","ひと"],["が"],["罪人","ざいにん"],["と"],["された"],["の"],["と"],["同様","どうよう"],["に"],["、"],["ひとり"],["の"],["従順","じゅうじゅん"],["によって"],["多く","おおく"],["の"],["人","ひと"],["が"],["義人","ぎじん"],["と"],["される"],["の"],["です"],["。"]]},{"verse":20,"text":"律法が入って来たのは、違反が増し加わるためです。しかし、罪の増し加わるところには、恵みも満ちあふれました。","tok":[["律法","りっぽう"],["が"],["入って","はいって"],["来た","きた"],["の"],["は"],["、"],["違反","いはん"],["が"],["増し","まし"],["加わる","くわわる"],["ため"],["です"],["。"],["しかし"],["、"],["罪","つみ"],["の"],["増し","まし"],["加わる","くわわる"],["ところ"],["に"],["は"],["、"],["恵み","めぐみ"],["も"],["満ちあふれました","みちあふれました"],["。"]]},{"verse":21,"text":"それは、罪が死によって支配したように、恵みが、私たちの主イエス・キリストにより、義の賜物によって支配し、永遠のいのちを得させるためなのです。","tok":[["それ"],["は"],["、"],["罪","つみ"],["が"],["死","し"],["によって"],["支配","しはい"],["した"],["よう"],["に"],["、"],["恵み","めぐみ"],["が"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["に"],["より"],["、"],["義","ぎ"],["の"],["賜物","たまもの"],["によって"],["支配","しはい"],["し"],["、"],["永遠","えいえん"],["の"],["いのち"],["を"],["得させる","えさせる"],["ため"],["な"],["の"],["です"],["。"]]}]
[{"verse":1,"text":"人はみな、上に立つ権威に従うべきです。神によらない権威はなく、存在している権威はすべて、神によって立てられたものです。","tok":[["人","ひと"],["は"],["みな"],["、"],["上","うえ"],["に"],["立つ","たつ"],["権威","けんい"],["に"],["従うべきです","したがうべきです"],["。"],["神","かみ"],["に"],["よらない"],["権威","けんい"],["は"],["なく"],["、"],["存在","そんざい"],["して"],["いる"],["権威","けんい"],["は"],["すべて"],["、"],["神","かみ"],["によって"],["立てられた","たてられた"],["もの"],["です"],["。"]]},{"verse":2,"text":"したがって、権威に逆らっている人は、神の定めにそむいているのです。そむいた人は自分の身にさばきを招きます。","tok":[["したがって"],["、"],["権威","けんい"],["に"],["逆らって","さからって"],["いる"],["人","ひと"],["は"],["、"],["神","かみ"],["の"],["定め","さだめ"],["に"],["そむいて"],["いる"],["の"],["です"],["。"],["そむいた"],["人","ひと"],["は"],["自分","じぶん"],["の"],["身","み"],["に"],["さばき"],["を"],["招きます","まねきます"],["。"]]},{"verse":3,"text":"支配者を恐ろしいと思うのは、良い行いをするときではなく、悪を行うときです。権威を恐れたくないと思うなら、善を行いなさい。そうすれば、支配者からほめられます。","tok":[["支配者","しはいしゃ"],["を"],["恐ろしい","おそろしい"],["と"],["思う","おもう"],["の"],["は"],["、"],["良い","よい"],["行い","おこない"],["を"],["する"],["とき"],["で"],["は"],["なく"],["、"],["悪","あく"],["を"],["行う","おこなう"],["とき"],["です"],["。"],["権威","けんい"],["を"],["恐れたく","おそれたく"],["ない"],["と"],["思うなら","おもうなら"],["、"],["善","ぜん"],["を"],["行い","おこない"],["なさい"],["。"],["そう"],["すれば"],["、"],["支配者","しはいしゃ"],["から"],["ほめられます"],["。"]]},{"verse":4,"text":"それは、彼があなたに益を与えるための、神のしもべだからです。しかし、もしあなたが悪を行うなら、恐れなければなりません。彼は無意味に剣を帯びてはいないからです。彼は神のしもべであって、悪を行う人には怒りをもって報います。","tok":[["それ"],["は"],["、"],["彼","かれ"],["が"],["あなた"],["に"],["益","えき"],["を"],["与える","あたえる"],["ため"],["の"],["、"],["神","かみ"],["の"],["しもべ"],["だ"],["から"],["です"],["。"],["しかし"],["、"],["もし"],["あなた"],["が"],["悪","あく"],["を"],["行うなら","おこなうなら"],["、"],["恐れなければ","おそれなければ"],["なりません"],["。"],["彼","かれ"],["は"],["無意味","むいみ"],["に"],["剣","けん"],["を"],["帯び","おび"],["ては"],["いない"],["から"],["です"],["。"],["彼","かれ"],["は"],["神","かみ"],["の"],["しもべ"],["で"],["あって"],["、"],["悪","あく"],["を"],["行う","おこなう"],["人","ひと"],["に"],["は"],["怒り","いかり"],["を"],["もって"],["報います","むくいます"],["。"]]},{"verse":5,"text":"ですから、ただ怒りが恐ろしいからだけでなく、良心のためにも、従うべきです。","tok":[["です"],["から"],["、"],["ただ"],["怒り","いかり"],["が"],["恐ろしい","おそろしい"],["から"],["だけ"],["で"],["なく"],["、"],["良心","りょうしん"],["の"],["ため"],["に"],["も"],["、"],["従うべきです","したがうべきです"],["。"]]},{"verse":6,"text":"同じ理由で、あなたがたは、みつぎを納めるのです。彼らは、いつもその務めに励んでいる神のしもべなのです。","tok":[["同じ","おなじ"],["理由","りゆう"],["で"],["、"],["あなた"],["がた"],["は"],["、"],["みつぎ"],["を"],["納める","おさめる"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["いつも"],["その"],["務め","つとめ"],["に"],["励んで","はげんで"],["いる"],["神","かみ"],["の"],["しもべ"],["な"],["の"],["です"],["。"]]},{"verse":7,"text":"あなたがたは、だれにでも義務を果たしなさい。みつぎを納めなければならない人にはみつぎを納め、税を納めなければならない人には税を納め、恐れなければならない人を恐れ、敬わなければならない人を敬いなさい。","tok":[["あなた"],["がた"],["は"],["、"],["だれ"],["に"],["で"],["も"],["義務","ぎむ"],["を"],["果たし","はたし"],["なさい"],["。"],["みつぎ"],["を"],["納めなければ","おさめなければ"],["ならない"],["人","ひと"],["に"],["は"],["みつぎ"],["を"],["納め","おさめ"],["、"],["税","ぜい"],["を"],["納めなければ","おさめなければ"],["ならない"],["人","ひと"],["に"],["は"],["税","ぜい"],["を"],["納め","おさめ"],["、"],["恐れなければ","おそれなければ"],["ならない"],["人","ひと"],["を"],["恐れ","おそれ"],["、"],["敬わなければ","うやまわなければ"],["ならない"],["人","ひと"],["を"],["敬い","うやまい"],["なさい"],["。"]]},{"verse":8,"text":"だれに対しても、何の借りもあってはいけません。ただし、互いに愛し合うことについては別です。他の人を愛する者は、律法を完全に守っているのです。","tok":[["だれ"],["に対して","にたいして"],["も"],["、"],["何","なん"],["の"],["借り","かり"],["も"],["あって"],["は"],["いけません"],["。"],["ただし"],["、"],["互い","たがい"],["に"],["愛し合う","あいしあう"],["こと"],["について"],["は"],["別","べつ"],["です"],["。"],["他","ほか"],["の"],["人","ひと"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["律法","りっぽう"],["を"],["完全","かんぜん"],["に"],["守って","まもって"],["いる"],["の"],["です"],["。"]]},{"verse":9,"text":"「姦淫するな、殺すな、盗むな、むさぼるな」という戒め、またほかにどんな戒めがあっても、それらは、「あなたの隣人をあなた自身のように愛せよ」ということばの中に要約されているからです。","tok":[["「"],["姦淫","かんいん"],["する"],["な"],["、"],["殺す","ころす"],["な"],["、"],["盗む","ぬすむ"],["な"],["、"],["むさぼる"],["な"],["」"],["と"],["いう"],["戒め","いましめ"],["、"],["また"],["ほか"],["に"],["どんな"],["戒め","いましめ"],["が"],["あって"],["も"],["、"],["それ"],["ら"],["は"],["、"],["「"],["あなた"],["の"],["隣人","りんじん"],["を"],["あなた"],["自身","じしん"],["の"],["よう"],["に"],["愛せよ","あいせよ"],["」"],["と"],["いう"],["ことば"],["の"],["中","なか"],["に"],["要約","ようやく"],["されて"],["いる"],["から"],["です"],["。"]]},{"verse":10,"text":"愛は隣人に対して害を与えません。それゆえ、愛は律法を全うします。","tok":[["愛","あい"],["は"],["隣人","りんじん"],["に対して","にたいして"],["害","がい"],["を"],["与えません","あたえません"],["。"],["それ"],["ゆえ"],["、"],["愛","あい"],["は"],["律法","りっぽう"],["を"],["全う","まっとう"],["します"],["。"]]},{"verse":11,"text":"あなたがたは、今がどのような時か知っているのですから、このように行いなさい。あなたがたが眠りからさめるべき時刻がもう来ています。というのは、私たちが信じたころよりも、今は救いが私たちにもっと近づいているからです。","tok":[["あなた"],["がた"],["は"],["、"],["今","いま"],["が"],["どのような"],["時","とき"],["か"],["知って","しって"],["いる"],["の"],["です"],["から"],["、"],["この"],["よう"],["に"],["行い","おこない"],["なさい"],["。"],["あなた"],["がた"],["が"],["眠り","ねむり"],["から"],["さめるべき"],["時刻","じこく"],["が"],["もう"],["来て","きて"],["います"],["。"],["と"],["いう"],["の"],["は"],["、"],["私たち","わたしたち"],["が"],["信じた","しんじた"],["ころ"],["より"],["も"],["、"],["今","いま"],["は"],["救い","すくい"],["が"],["私たち","わたしたち"],["に"],["もっと"],["近づいて","ちかづいて"],["いる"],["から"],["です"],["。"]]},{"verse":12,"text":"夜はふけて、昼が近づきました。ですから、私たちは、やみのわざを打ち捨てて、光の武具を着けようではありませんか。","tok":[["夜","よる"],["は"],["ふけて"],["、"],["昼","ひる"],["が"],["近づきました","ちかづきました"],["。"],["です"],["から"],["、"],["私たち","わたしたち"],["は"],["、"],["やみ"],["の"],["わざ"],["を"],["打ち捨てて","うちすてて"],["、"],["光","ひかり"],["の"],["武具","ぶぐ"],["を"],["着けようで","つけようで"],["は"],["ありません"],["か"],["。"]]},{"verse":13,"text":"遊興、酩酊、淫乱、好色、争い、ねたみの生活ではなく、昼間らしい、正しい生き方をしようではありませんか。","tok":[["遊興","ゆうきょう"],["、"],["酩酊","めいてい"],["、"],["淫乱","いんらん"],["、"],["好色","こうしょく"],["、"],["争い","あらそい"],["、"],["ねたみ"],["の"],["生活","せいかつ"],["で"],["は"],["なく"],["、"],["昼間","ひるま"],["らしい"],["、"],["正しい","ただしい"],["生き方","いきかた"],["を"],["しようで"],["は"],["ありません"],["か"],["。"]]},{"verse":14,"text":"主イエス・キリストを着なさい。肉の欲のために心を用いてはいけません。","tok":[["主","しゅ"],["イエス"],["・"],["キリスト"],["を"],["着","き"],["なさい"],["。"],["肉","にく"],["の"],["欲","よく"],["の"],["ため"],["に"],["心","こころ"],["を"],["用いて","もちいて"],["は"],["いけません"],["。"]]}]
[{"verse":1,"text":"それとも、兄弟たち。あなたがたは、律法が人に対して権限を持つのは、その人の生きている期間だけだ、ということを知らないのですか――私は律法を知っている人々に言っているのです。――","tok":[["それ"],["と"],["も"],["、"],["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["は"],["、"],["律法","りっぽう"],["が"],["人","ひと"],["に対して","にたいして"],["権限","けんげん"],["を"],["持つ","もつ"],["の"],["は"],["、"],["その"],["人","ひと"],["の"],["生きて","いきて"],["いる"],["期間","きかん"],["だけ"],["だ"],["、"],["と"],["いう"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["―"],["―"],["私","わたくし"],["は"],["律法","りっぽう"],["を"],["知って","しって"],["いる"],["人々","ひとびと"],["に"],["言って","いって"],["いる"],["の"],["です"],["。"],["―"],["―"]]},{"verse":2,"text":"夫のある女は、夫が生きている間は、律法によって夫に結ばれています。しかし、夫が死ねば、夫に関する律法から解放されます。","tok":[["夫","おっと"],["の"],["ある"],["女","おんな"],["は"],["、"],["夫","おっと"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["律法","りっぽう"],["によって"],["夫","おっと"],["に"],["結ばれて","むすばれて"],["います"],["。"],["しかし"],["、"],["夫","おっと"],["が"],["死ねば","しねば"],["、"],["夫","おっと"],["に"],["関する","かんする"],["律法","りっぽう"],["から"],["解放","かいほう"],["されます"],["。"]]},{"verse":3,"text":"ですから、夫が生きている間に他の男に行けば、姦淫の女と呼ばれるのですが、夫が死ねば、律法から解放されており、たとい他の男に行っても、姦淫の女ではありません。","tok":[["です"],["から"],["、"],["夫","おっと"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["に"],["他","ほか"],["の"],["男","おとこ"],["に"],["行けば","いけば"],["、"],["姦淫","かんいん"],["の"],["女","おんな"],["と"],["呼ばれる","よばれる"],["の"],["です"],["が"],["、"],["夫","おっと"],["が"],["死ねば","しねば"],["、"],["律法","りっぽう"],["から"],["解放","かいほう"],["されて"],["おり"],["、"],["たとい"],["他","ほか"],["の"],["男","おとこ"],["に"],["行って","いって"],["も"],["、"],["姦淫","かんいん"],["の"],["女","おんな"],["で"],["は"],["ありません"],["。"]]},{"verse":4,"text":"私の兄弟たちよ。それと同じように、あなたがたも、キリストのからだによって、律法に対しては死んでいるのです。それは、あなたがたが他の人、すなわち死者の中からよみがえった方と結ばれて、神のために実を結ぶようになるためです。","tok":[["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["それ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["、"],["キリスト"],["の"],["からだ"],["によって"],["、"],["律法","りっぽう"],["に対して","にたいして"],["は"],["死んで","しんで"],["いる"],["の"],["です"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["他","ほか"],["の"],["人","ひと"],["、"],["すなわち"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえった"],["方","ほう"],["と"],["結ばれて","むすばれて"],["、"],["神","かみ"],["の"],["ため"],["に"],["実","じつ"],["を"],["結ぶ","むすぶ"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":5,"text":"私たちが肉にあったときは、律法による数々の罪の欲情が私たちのからだの中に働いていて、死のために実を結びました。","tok":[["私たち","わたしたち"],["が"],["肉","にく"],["に"],["あった"],["とき"],["は"],["、"],["律法","りっぽう"],["に"],["よる"],["数々","かずかず"],["の"],["罪","つみ"],["の"],["欲情","よくじょう"],["が"],["私たち","わたしたち"],["の"],["からだ"],["の"],["中","なか"],["に"],["働いて","はたらいて"],["いて"],["、"],["死","し"],["の"],["ため"],["に"],["実","じつ"],["を"],["結びました","むすびました"],["。"]]},{"verse":6,"text":"しかし、今は、私たちは自分を捕らえていた律法に対して死んだので、それから解放され、その結果、古い文字にはよらず、新しい御霊によって仕えているのです。","tok":[["しかし"],["、"],["今","いま"],["は"],["、"],["私たち","わたしたち"],["は"],["自分","じぶん"],["を"],["捕らえて","とらえて"],["いた"],["律法","りっぽう"],["に対して","にたいして"],["死んだ","しんだ"],["ので"],["、"],["それ"],["から"],["解放","かいほう"],["され"],["、"],["その"],["結果","けっか"],["、"],["古い","ふるい"],["文字","もじ"],["に"],["は"],["よらず"],["、"],["新しい","あたらしい"],["御霊","ごれい"],["によって"],["仕えて","つかえて"],["いる"],["の"],["です"],["。"]]},{"verse":7,"text":"それでは、どういうことになりますか。律法は罪なのでしょうか。絶対にそんなことはありません。ただ、律法によらないでは、私は罪を知ることがなかったでしょう。律法が、「むさぼってはならない」と言わなかったら、私はむさぼりを知らなかったでしょう。","tok":[["それ"],["で"],["は"],["、"],["どういう"],["こと"],["に"],["なります"],["か"],["。"],["律法","りっぽう"],["は"],["罪","つみ"],["な"],["の"],["でしょう"],["か"],["。"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"],["ただ"],["、"],["律法","りっぽう"],["に"],["よらないで"],["は"],["、"],["私","わたくし"],["は"],["罪","つみ"],["を"],["知る","しる"],["こと"],["が"],["なかったでしょう"],["。"],["律法","りっぽう"],["が"],["、"],["「"],["むさぼって"],["は"],["ならない"],["」"],["と"],["言わなかったら","いわなかったら"],["、"],["私","わたくし"],["は"],["むさぼり"],["を"],["知らなかったでしょう","しらなかったでしょう"],["。"]]},{"verse":8,"text":"しかし、罪はこの戒めによって機会を捕らえ、私のうちにあらゆるむさぼりを引き起こしました。律法がなければ、罪は死んだものです。","tok":[["しかし"],["、"],["罪","つみ"],["は"],["この"],["戒め","いましめ"],["によって"],["機会","きかい"],["を"],["捕らえ","とらえ"],["、"],["私","わたくし"],["の"],["うち"],["に"],["あらゆる"],["むさぼり"],["を"],["引き起こしました","ひきおこしました"],["。"],["律法","りっぽう"],["が"],["なければ"],["、"],["罪","つみ"],["は"],["死んだ","しんだ"],["もの"],["です"],["。"]]},{"verse":9,"text":"私はかつて律法なしに生きていましたが、戒めが来たときに、罪が生き、私は死にました。","tok":[["私","わたくし"],["は"],["かつて"],["律法","りっぽう"],["なし"],["に"],["生きて","いきて"],["いました"],["が"],["、"],["戒め","いましめ"],["が"],["来た","きた"],["とき"],["に"],["、"],["罪","つみ"],["が"],["生き","いき"],["、"],["私","わたくし"],["は"],["死にました","しにました"],["。"]]},{"verse":10,"text":"それで私には、いのちに導くはずのこの戒めが、かえって死に導くものであることが、わかりました。","tok":[["それ"],["で"],["私","わたくし"],["に"],["は"],["、"],["いのち"],["に"],["導く","みちびく"],["はず"],["の"],["この"],["戒め","いましめ"],["が"],["、"],["かえって"],["死","し"],["に"],["導く","みちびく"],["もの"],["で"],["ある"],["こと"],["が"],["、"],["わかりました"],["。"]]},{"verse":11,"text":"それは、戒めによって機会を捕らえた罪が私を欺き、戒めによって私を殺したからです。","tok":[["それ"],["は"],["、"],["戒め","いましめ"],["によって"],["機会","きかい"],["を"],["捕らえた","とらえた"],["罪","つみ"],["が"],["私","わたくし"],["を"],["欺き","あざむき"],["、"],["戒め","いましめ"],["によって"],["私","わたくし"],["を"],["殺した","ころした"],["から"],["です"],["。"]]},{"verse":12,"text":"ですから、律法は聖なるものであり、戒めも聖であり、正しく、また良いものなのです。","tok":[["です"],["から"],["、"],["律法","りっぽう"],["は"],["聖","せい"],["なる"],["もの"],["で"],["あり"],["、"],["戒め","いましめ"],["も"],["聖","せい"],["で"],["あり"],["、"],["正しく","ただしく"],["、"],["また"],["良い","よい"],["もの"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"では、この良いものが、私に死をもたらしたのでしょうか。絶対にそんなことはありません。それはむしろ、罪なのです。罪は、この良いもので私に死をもたらすことによって、罪として明らかにされ、戒めによって、極度に罪深いものとなりました。","tok":[["で"],["は"],["、"],["この"],["良い","よい"],["もの"],["が"],["、"],["私","わたくし"],["に"],["死","し"],["を"],["もたらした"],["の"],["でしょう"],["か"],["。"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"],["それ"],["は"],["むしろ"],["、"],["罪","つみ"],["な"],["の"],["です"],["。"],["罪","つみ"],["は"],["、"],["この"],["良い","よい"],["もの"],["で"],["私","わたくし"],["に"],["死","し"],["を"],["もたらす"],["こと"],["によって"],["、"],["罪","つみ"],["として"],["明らか","あきらか"],["に"],["され"],["、"],["戒め","いましめ"],["によって"],["、"],["極度","きょくど"],["に"],["罪深い","つみぶかい"],["もの"],["と"],["なりました"],["。"]]},{"verse":14,"text":"私たちは、律法が霊的なものであることを知っています。しかし、私は罪ある人間であり、売られて罪の下にある者です。","tok":[["私たち","わたしたち"],["は"],["、"],["律法","りっぽう"],["が"],["霊的","れいてき"],["な"],["もの"],["で"],["ある"],[
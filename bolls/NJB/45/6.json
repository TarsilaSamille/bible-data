[{"verse":1,"text":"それでは、どういうことになりますか。恵みが増し加わるために、私たちは罪の中にとどまるべきでしょうか。","tok":[["それ"],["で"],["は"],["、"],["どういう"],["こと"],["に"],["なります"],["か"],["。"],["恵み","めぐみ"],["が"],["増し","まし"],["加わる","くわわる"],["ため"],["に"],["、"],["私たち","わたしたち"],["は"],["罪","つみ"],["の"],["中","なか"],["に"],["とどまるべきでしょう"],["か"],["。"]]},{"verse":2,"text":"絶対にそんなことはありません。罪に対して死んだ私たちが、どうして、なおもその中に生きていられるでしょう。","tok":[["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"],["罪","つみ"],["に対して","にたいして"],["死んだ","しんだ"],["私たち","わたしたち"],["が"],["、"],["どう"],["して"],["、"],["なお"],["も"],["その"],["中","なか"],["に"],["生きて","いきて"],["いられるでしょう"],["。"]]},{"verse":3,"text":"それとも、あなたがたは知らないのですか。キリスト・イエスにつくバプテスマを受けた私たちはみな、その死にあずかるバプテスマを受けたのではありませんか。","tok":[["それ"],["と"],["も"],["、"],["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["です"],["か"],["。"],["キリスト"],["・"],["イエス"],["に"],["つく"],["バプテスマ"],["を"],["受けた","うけた"],["私たち","わたしたち"],["は"],["みな"],["、"],["その"],["死","し"],["に"],["あずかる"],["バプテスマ"],["を"],["受けた","うけた"],["ので"],["は"],["ありません"],["か"],["。"]]},{"verse":4,"text":"私たちは、キリストの死にあずかるバプテスマによって、キリストとともに葬られたのです。それは、キリストが御父の栄光によって死者の中からよみがえられたように、私たちも、いのちにあって新しい歩みをするためです。","tok":[["私たち","わたしたち"],["は"],["、"],["キリスト"],["の"],["死","し"],["に"],["あずかる"],["バプテスマ"],["によって"],["、"],["キリスト"],["と"],["とも"],["に"],["葬られた","ほうむられた"],["の"],["です"],["。"],["それ"],["は"],["、"],["キリスト"],["が"],["御父","おちち"],["の"],["栄光","えいこう"],["によって"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえられた"],["よう"],["に"],["、"],["私たち","わたしたち"],["も"],["、"],["いのち"],["に"],["あって"],["新しい","あたらしい"],["歩み","あゆみ"],["を"],["する"],["ため"],["です"],["。"]]},{"verse":5,"text":"もし私たちが、キリストにつぎ合わされて、キリストの死と同じようになっているのなら、必ずキリストの復活とも同じようになるからです。","tok":[["もし"],["私たち","わたしたち"],["が"],["、"],["キリスト"],["に"],["つぎ"],["合わされて","あわされて"],["、"],["キリスト"],["の"],["死","し"],["と"],["同じ","おなじ"],["よう"],["に"],["なって"],["いる"],["の"],["なら"],["、"],["必ず","かならず"],["キリスト"],["の"],["復活","ふっかつ"],["とも"],["同じ","おなじ"],["よう"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":6,"text":"私たちの古い人がキリストとともに十字架につけられたのは、罪のからだが滅びて、私たちがもはやこれからは罪の奴隷でなくなるためであることを、私たちは知っています。","tok":[["私たち","わたしたち"],["の"],["古い","ふるい"],["人","ひと"],["が"],["キリスト"],["と"],["とも"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["の"],["は"],["、"],["罪","つみ"],["の"],["からだ"],["が"],["滅びて","ほろびて"],["、"],["私たち","わたしたち"],["が"],["もはや"],["これ"],["から"],["は"],["罪","つみ"],["の"],["奴隷","どれい"],["で"],["なくなる"],["ため"],["で"],["ある"],["こと"],["を"],["、"],["私たち","わたしたち"],["は"],["知って","しって"],["います"],["。"]]},{"verse":7,"text":"死んでしまった者は、罪から解放されているのです。","tok":[["死んで","しんで"],["しまった"],["者","もの"],["は"],["、"],["罪","つみ"],["から"],["解放","かいほう"],["されて"],["いる"],["の"],["です"],["。"]]},{"verse":8,"text":"もし私たちがキリストとともに死んだのであれば、キリストとともに生きることにもなる、と信じます。","tok":[["もし"],["私たち","わたしたち"],["が"],["キリスト"],["と"],["とも"],["に"],["死んだ","しんだ"],["ので"],["あれば"],["、"],["キリスト"],["と"],["とも"],["に"],["生きる","いきる"],["こと"],["に"],["も"],["なる"],["、"],["と"],["信じます","しんじます"],["。"]]},{"verse":9,"text":"キリストは死者の中からよみがえって、もはや死ぬことはなく、死はもはやキリストを支配しないことを、私たちは知っています。","tok":[["キリスト"],["は"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえって"],["、"],["もはや"],["死ぬ","しぬ"],["こと"],["は"],["なく"],["、"],["死","し"],["は"],["もはや"],["キリスト"],["を"],["支配","しはい"],["しない"],["こと"],["を"],["、"],["私たち","わたしたち"],["は"],["知って","しって"],["います"],["。"]]},{"verse":10,"text":"なぜなら、キリストが死なれたのは、ただ一度罪に対して死なれたのであり、キリストが生きておられるのは、神に対して生きておられるのだからです。","tok":[["なぜ"],["なら"],["、"],["キリスト"],["が"],["死なれた","しなれた"],["の"],["は"],["、"],["ただ"],["一度","いちど"],["罪","つみ"],["に対して","にたいして"],["死なれた","しなれた"],["ので"],["あり"],["、"],["キリスト"],["が"],["生きて","いきて"],["おられる"],["の"],["は"],["、"],["神","かみ"],["に対して","にたいして"],["生きて","いきて"],["おられる"],["の"],["だ"],["から"],["です"],["。"]]},{"verse":11,"text":"このように、あなたがたも、自分は罪に対しては死んだ者であり、神に対してはキリスト・イエスにあって生きた者だと、思いなさい。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["、"],["自分","じぶん"],["は"],["罪","つみ"],["に対して","にたいして"],["は"],["死んだ","しんだ"],["者","もの"],["で"],["あり"],["、"],["神","かみ"],["に対して","にたいして"],["は"],["キリスト"],["・"],["イエス"],["に"],["あって"],["生きた","いきた"],["者","もの"],["だ"],["と"],["、"],["思い","おもい"],["なさい"],["。"]]},{"verse":12,"text":"ですから、あなたがたの死ぬべきからだを罪の支配にゆだねて、その情欲に従ってはいけません。","tok":[["です"],["から"],["、"],["あなた"],["がた"],["の"],["死ぬべき","しぬべき"],["からだ"],["を"],["罪","つみ"],["の"],["支配","しはい"],["に"],["ゆだねて"],["、"],["その"],["情欲","じょうよく"],["に"],["従って","したがって"],["は"],["いけません"],["。"]]},{"verse":13,"text":"また、あなたがたの手足を不義の器として罪にささげてはいけません。むしろ、死者の中から生かされた者として、あなたがた自身とその手足を義の器として神にささげなさい。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["手足","てあし"],["を"],["不義","ふぎ"],["の"],["器","うつわ"],["として"],["罪","つみ"],["に"],["ささげて"],["は"],["いけません"],["。"],["むしろ"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["生かされた","いかされた"],["者","もの"],["として"],["、"],["あなた"],["がた"],["自身","じしん"],["と"],["その"],["手足","てあし"],["を"],["義","ぎ"],["の"],["器","うつわ"],["として"],["神","かみ"],["に"],["ささげ"],["なさい"],["。"]]},{"verse":14,"text":"というのは、罪はあなたがたを支配することがないからです。なぜなら、あなたがたは律法の下にはなく、恵みの下にあるからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["罪","つみ"],["は"],["あなた"],["がた"],["を"],["支配","しはい"],["する"],["こと"],["が"],["ない"],["から"],["です"],["。"],["なぜ"],["なら"],["、"],["あなた"],["がた"],["は"],["律法","りっぽう"],["の"],["下","した"],["に"],["は"],["なく"],["、"],["恵み","めぐみ"],["の"],["下","した"],["に"],["ある"],["から"],["です"],["。"]]},{"verse":15,"text":"それではどうなのでしょう。私たちは、律法の下にではなく、恵みの下にあるのだから罪を犯そう、ということになるのでしょうか。絶対にそんなことはありません。","tok":[["それ"],["で"],["は"],["どう"],["な"],["の"],["でしょう"],["。"],["私たち","わたしたち"],["は"],["、"],["律法","りっぽう"],["の"],["下","した"],["に"],["で"],["は"],["なく"],["、"],["恵み","めぐみ"],["の"],["下","した"],["に"],["ある"],["の"],["だ"],["から"],["罪","つみ"],["を"],["犯そう","おかそう"],["、"],["と"],["いう"],["こと"],["に"],["なる"],["の"],["でしょう"],["か"],["。"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"]]},{"verse":16,"text":"あなたがたはこのことを知らないのですか。あなたがたが自分の身をささげて奴隷として服従すれば、その服従する相手の奴隷であって、あるいは罪の奴隷となって死に至り、あるいは従順の奴隷となって義に至るのです。","tok":[["あなた"],["がた"],["は"],["この"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["が"],["自分","じぶん"],["の"],["身","み"],["を"],["ささげて"],["奴隷","どれい"],["として"],["服従","ふくじゅう"],["すれば"],["、"],["その"],["服従","ふくじゅう"],["する"],["相手","あいて"],["の"],["奴隷","どれい"],["で"],["あって"],["、"],["あるいは"],["罪","つみ"],["の"],["奴隷","どれい"],["と"],["なって"],["死","し"],["に"],["至り","いたり"],["
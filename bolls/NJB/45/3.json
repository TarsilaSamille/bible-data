[{"verse":1,"text":"では、ユダヤ人のすぐれたところは、いったい何ですか。割礼にどんな益があるのですか。","tok":[["で"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["すぐれた"],["ところ"],["は"],["、"],["いったい"],["何","なん"],["です"],["か"],["。"],["割礼","かつれい"],["に"],["どんな"],["益","えき"],["が"],["ある"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"それは、あらゆる点から見て、大いにあります。第一に、彼らは神のいろいろなおことばをゆだねられています。","tok":[["それ"],["は"],["、"],["あらゆる"],["点","てん"],["から"],["見て","みて"],["、"],["大いに","おおいに"],["あります"],["。"],["第","だい"],["一","いち"],["に"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["いろいろ"],["な"],["おことば"],["を"],["ゆだねられて"],["います"],["。"]]},{"verse":3,"text":"では、いったいどうなのですか。彼らのうちに不真実な者があったら、その不真実によって、神の真実が無に帰することになるでしょうか。","tok":[["で"],["は"],["、"],["いったい"],["どう"],["な"],["の"],["です"],["か"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["不","ふ"],["真実","しんじつ"],["な"],["者","もの"],["が"],["あったら"],["、"],["その"],["不","ふ"],["真実","しんじつ"],["によって"],["、"],["神","かみ"],["の"],["真実","しんじつ"],["が"],["無","む"],["に"],["帰する","きする"],["こと"],["に"],["なるでしょう"],["か"],["。"]]},{"verse":4,"text":"絶対にそんなことはありません。たとい、すべての人を偽り者としても、神は真実な方であるとすべきです。それは、「あなたが、そのみことばによって正しいとされ、さばかれるときには勝利を得られるため。」／と書いてあるとおりです。","tok":[["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"],["たとい"],["、"],["すべて"],["の"],["人","ひと"],["を"],["偽り","いつわり"],["者","もの"],["として"],["も"],["、"],["神","かみ"],["は"],["真実","しんじつ"],["な"],["方","かた"],["で"],["ある"],["と"],["すべきです"],["。"],["それ"],["は"],["、"],["「"],["あなた"],["が"],["、"],["その"],["みことば"],["によって"],["正しい","ただしい"],["と"],["され"],["、"],["さばかれる"],["とき"],["に"],["は"],["勝利","しょうり"],["を"],["得られる","えられる"],["ため"],["。"],["」"],["／"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":5,"text":"しかし、もし私たちの不義が神の義を明らかにするとしたら、どうなるでしょうか。人間的な言い方をしますが、怒りを下す神は不正なのでしょうか。","tok":[["しかし"],["、"],["もし"],["私たち","わたしたち"],["の"],["不義","ふぎ"],["が"],["神","かみ"],["の"],["義","ぎ"],["を"],["明らか","あきらか"],["に"],["する"],["と"],["したら"],["、"],["どう"],["なるでしょう"],["か"],["。"],["人間的","にんげんてき"],["な"],["言い方","いいかた"],["を"],["します"],["が"],["、"],["怒り","いかり"],["を"],["下す","くだす"],["神","かみ"],["は"],["不正","ふせい"],["な"],["の"],["でしょう"],["か"],["。"]]},{"verse":6,"text":"絶対にそんなことはありません。もしそうだとしたら、神はいったいどのように世をさばかれるのでしょう。","tok":[["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"],["もし"],["そう"],["だ"],["と"],["したら"],["、"],["神","かみ"],["は"],["いったい"],["どの"],["よう"],["に"],["世","よ"],["を"],["さばかれる"],["の"],["でしょう"],["。"]]},{"verse":7,"text":"でも、私の偽りによって、神の真理がますます明らかにされて神の栄光となるのであれば、なぜ私がなお罪人としてさばかれるのでしょうか。","tok":[["で"],["も"],["、"],["私","わたくし"],["の"],["偽り","いつわり"],["によって"],["、"],["神","かみ"],["の"],["真理","しんり"],["が"],["ますます"],["明らか","あきらか"],["に"],["されて"],["神","かみ"],["の"],["栄光","えいこう"],["と"],["なる"],["ので"],["あれば"],["、"],["なぜ"],["私","わたくし"],["が"],["なお"],["罪人","ざいにん"],["として"],["さばかれる"],["の"],["でしょう"],["か"],["。"]]},{"verse":8,"text":"「善を現すために、悪をしようではないか」と言ってはいけないのでしょうか――私たちはこの点でそしられるのです。ある人たちは、それが私たちのことばだと言っていますが。――もちろんこのように論じる者どもは当然罪に定められるのです。","tok":[["「"],["善","ぜん"],["を"],["現す","あらわす"],["ため"],["に"],["、"],["悪","あく"],["を"],["しようで"],["は"],["ない"],["か"],["」"],["と"],["言って","いって"],["は"],["いけない"],["の"],["でしょう"],["か"],["―"],["―"],["私たち","わたしたち"],["は"],["この"],["点","てん"],["で"],["そしられる"],["の"],["です"],["。"],["ある"],["人","ひと"],["たち"],["は"],["、"],["それ"],["が"],["私たち","わたしたち"],["の"],["ことば"],["だ"],["と"],["言って","いって"],["います"],["が"],["。"],["―"],["―"],["もちろん"],["この"],["よう"],["に"],["論じる","ろんじる"],["者","もの"],["ども"],["は"],["当然","とうぜん"],["罪","ざい"],["に"],["定められる","さだめられる"],["の"],["です"],["。"]]},{"verse":9,"text":"では、どうなのでしょう。私たちは他の者にまさっているのでしょうか。決してそうではありません。私たちは前に、ユダヤ人もギリシヤ人も、すべての人が罪の下にあると責めたのです。","tok":[["で"],["は"],["、"],["どう"],["な"],["の"],["でしょう"],["。"],["私たち","わたしたち"],["は"],["他","た"],["の"],["者","もの"],["に"],["まさって"],["いる"],["の"],["でしょう"],["か"],["。"],["決して","けっして"],["そう"],["で"],["は"],["ありません"],["。"],["私たち","わたしたち"],["は"],["前","まえ"],["に"],["、"],["ユダヤ人","ゆだやじん"],["も"],["ギリシヤ"],["人","にん"],["も"],["、"],["すべて"],["の"],["人","ひと"],["が"],["罪","つみ"],["の"],["下","した"],["に"],["ある"],["と"],["責めた","せめた"],["の"],["です"],["。"]]},{"verse":10,"text":"それは、次のように書いてあるとおりです。「義人はいない。ひとりもいない。","tok":[["それ"],["は"],["、"],["次","つぎ"],["の"],["よう"],["に"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"],["「"],["義人","ぎじん"],["は"],["いない"],["。"],["ひとり"],["も"],["いない"],["。"]]},{"verse":11,"text":"悟りのある人はいない。神を求める人はいない。","tok":[["悟り","さとり"],["の"],["ある"],["人","ひと"],["は"],["いない"],["。"],["神","かみ"],["を"],["求める","もとめる"],["人","ひと"],["は"],["いない"],["。"]]},{"verse":12,"text":"すべての人が迷い出て、みな、ともに無益な者となった。善を行う人はいない。ひとりもいない。」","tok":[["すべて"],["の"],["人","ひと"],["が"],["迷い出て","まよいでて"],["、"],["みな"],["、"],["とも"],["に"],["無益","むえき"],["な"],["者","もの"],["と"],["なった"],["。"],["善","ぜん"],["を"],["行う","おこなう"],["人","ひと"],["は"],["いない"],["。"],["ひとり"],["も"],["いない"],["。"],["」"]]},{"verse":13,"text":"「彼らののどは、開いた墓であり、彼らはその舌で欺く。」「彼らのくちびるの下には、まむしの毒があり、」","tok":[["「"],["彼","かれ"],["ら"],["の"],["のど"],["は"],["、"],["開いた","ひらいた"],["墓","はか"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["は"],["その"],["舌","した"],["で"],["欺く","あざむく"],["。"],["」"],["「"],["彼","かれ"],["ら"],["の"],["くちびる"],["の"],["下","した"],["に"],["は"],["、"],["まむし"],["の"],["毒","どく"],["が"],["あり"],["、"],["」"]]},{"verse":14,"text":"「彼らの口は、のろいと苦さで満ちている。」","tok":[["「"],["彼","かれ"],["ら"],["の"],["口","くち"],["は"],["、"],["のろい"],["と"],["苦","にが"],["さ"],["で"],["満ちて","みちて"],["いる"],["。"],["」"]]},{"verse":15,"text":"「彼らの足は血を流すのに速く、","tok":[["「"],["彼","かれ"],["ら"],["の"],["足","あし"],["は"],["血","ち"],["を"],["流す","ながす"],["のに"],["速く","はやく"],["、"]]},{"verse":16,"text":"彼らの道には破壊と悲惨がある。","tok":[["彼","かれ"],["ら"],["の"],["道","みち"],["に"],["は"],["破壊","はかい"],["と"],["悲惨","ひさん"],["が"],["ある"],["。"]]},{"verse":17,"text":"また、彼らは平和の道を知らない。」","tok":[["また"],["、"],["彼","かれ"],["ら"],["は"],["平和","へいわ"],["の"],["道","みち"],["を"],["知らない","しらない"],["。"],["」"]]},{"verse":18,"text":"「彼らの目の前には、神に対する恐れがない。」","tok":[["「"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["に"],["は"],["、"],["神","かみ"],["に"],["対する","たいする"],["恐れ","おそれ"],["が"],["ない"],["。"],["」"]]},{"verse":19,"text":"さて、私たちは、律法の言うことはみな、律法の下にある人々に対して言われていることを知っています。それは、すべての口がふさがれて、全世界が神のさばきに服するためです。","tok":[["さて"],["、"],["私たち","わたしたち"],["は"],["、"],["律法","りっぽう"],["の"],["言う","いう"],["こと"],["は"],["みな"],["、"],["律法","りっぽう"],["の"],["下","した"],["に"],["ある"],["人々","ひとびと"],["に対して","にたいして"],["言われて","いわれて"],["いる"],["こと"],["を"],["知って","しって"],["います"],["。"],["それ"],["は"],["、"],["すべて"],["の"],["口","くち"],["が"],["ふさがれて"],["、"],["全","ぜん"],["世界","せかい"],["が"],["神","かみ"],["の"],["さばき"],["に"],["服する","ふくする"],["ため"],["です"],["。"]]},{"verse":20,"text":"なぜなら、律法を行うことによっては、だれひとり神の前に義と認められないからです。律法によっては、かえって罪の意識が生じるのです。","tok":[["なぜ"],["なら"],["、"],["律法","りっぽう"],["を"],["行う","おこなう"],["こと"],["によって"],["は"],["、"],["だれ"],["ひとり"],["神","かみ"],["の"],["前","まえ"],["に"],["義","ぎ"],["と"],["認められない","みとめられない"],["から"],["です"],["。"],["律法","りっぽう"],["によって"],["は"],["、"],["かえって"],["罪","つみ"],["の"],["意識","いしき"],["が"],["生じる","しょうじる"],["の"],["です"],["。"]]},{"verse":21,"text":"しかし、今は、律法とは別に、しかも律法と預言者によってあかしされて、神の義が示されました。","tok":[["しかし"],["、"],["今","いま"],["は"],["、"],["律法","りっぽう"],["と"],["は"],["別","べつ"],["に"],["、"],["しかも"],["律法","りっぽう"],["と"],["預言者","よげんしゃ"],["によって"],["あかし"],["されて"],["、"],["神","かみ"],["の"],["義","ぎ"],["が"],["示されました","しめされました"],["。"]]},{"verse":22,"text":"すなわち、イエス・キリストを信じる信仰による神の義であって、それはすべての信じる人に与えられ、何の差別もありません。","tok":[["すなわち"],["、"],["イエス"],["・"],["キリスト"],["を"],["信じる","しんじる"],["信仰","しんこう"],["に"],["よる"],["神","かみ"],["の"],["義","ぎ"],["で"],["あって"],["、"],["それ"],["は"],["すべて"],["の"],["信じる","しんじる"],["人","ひと"],["に"],["与えられ","あたえられ"],["、"],["何","なん"],["の"],["差別","さべつ"],["も"],["ありません"],["。"]]},{"verse":23,"text":"すべての人は、罪を犯したので、神からの栄誉を受けることができず、","tok":[["すべて"],["の"],["人","ひと"],["は"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["ので"],["、"],["神","かみ"],["から"],["の"],["栄誉","えいよ"],["を"],["受ける","うける"],["こと"],["が"],["できず"],["、"]]},{"verse":24,"text":"ただ、神の恵みにより、キリスト・イエスによる贖いのゆえに、価なしに義と認められるのです。","tok":[["ただ"],["、"],["神","かみ"],["の"],["恵み","めぐみ"],["に"],["より"],["、"],["キリスト"],["・"],["イエス"],["に"],["よる"],["贖い","あがない"],["の"],["ゆえ"],["に"],["、"],["価","あたい"],["なし"],["に"],["義","ぎ"],["と"],["認められる","みとめられる"],["の"],["です"],["。"]]},{"verse":25,"text":"神は、キリスト・イエスを、その血による、また信仰による、なだめの供え物として、公にお示しになりました。それは、ご自身の義を現すためです。というのは、今までに犯されて来た罪を神の忍耐をもって見のがして来られたからです。","tok":[["神","かみ"],["は"],["、"],["キリスト"],["・"],["イエス"],["を"],["、"],["その"],["血","ち"],["に"],["よる"],["、"],["また"],["信仰","しんこう"],["に"],["よる"],["、"],["なだめ"],["の"],["供え物","そなえもの"],["として"],["、"],["公","おおやけ"],["に"],["お示し","おしめし"],["に"],["なりました"],["。"],["それ"],["は"],["、"],["ご自身","ごじしん"],["の"],["義","ぎ"],["を"],["現す","あらわす"],["ため"],["です"],["。"],["と"],["いう"],["の"],["は"],["、"],["今まで","いままで"],["に"],["犯されて","おかされて"],["来た","きた"],["罪","つみ"],["を"],["神","かみ"],["の"],["忍耐","にんたい"],["を"],["もって"],["見のがして","みのがして"],["来られた","こられた"],["から"],["です"],["。"]]},{"verse":26,"text":"それは、今の時にご自身の義を現すためであり、こうして神ご自身が義であり、また、イエスを信じる者を義とお認めになるためなのです。","tok":[["それ"],["は"],["、"],["今","いま"],["の"],["時","とき"],["に"],["ご自身","ごじしん"],["の"],["義","ぎ"],["を"],["現す","あらわす"],["ため"],["で"],["あり"],["、"],["こう"],["して"],["神","かみ"],["ご自身","ごじしん"],["が"],["義","ぎ"],["で"],["あり"],["、"],["また"],["、"],["イエス"],["を"],["信じる","しんじる"],["者","もの"],["を"],["義","ぎ"],["と"],["お認め","おみとめ"],["に"],["なる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":27,"text":"それでは、私たちの誇りはどこにあるのでしょうか。それはすでに取り除かれました。どういう原理によってでしょうか。行いの原理によってでしょうか。そうではなく、信仰の原理によってです。","tok":[["それ"],["で"],["は"],["、"],["私たち","わたしたち"],["の"],["誇り","ほこり"],["は"],["どこ"],["に"],["ある"],["の"],["でしょう"],["か"],["。"],["それ"],["は"],["すでに"],["取り除かれました","とりのぞかれました"],["。"],["どういう"],["原理","げんり"],["によって"],["でしょう"],["か"],["。"],["行い","おこない"],["の"],["原理","げんり"],["によって"],["でしょう"],["か"],["。"],["そう"],["で"],["は"],["なく"],["、"],["信仰","しんこう"],["の"],["原理","げんり"],["によって"],["です"],["。"]]},{"verse":28,"text":"人が義と認められるのは、律法の行いによるのではなく、信仰によるというのが、私たちの考えです。","tok":[["人","ひと"],["が"],["義","ぎ"],["と"],["認められる","みとめられる"],["の"],["は"],["、"],["律法","りっぽう"],["の"],["行い","おこない"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["信仰","しんこう"],["に"],["よる"],["と"],["いう"],["の"],["が"],["、"],["私たち","わたしたち"],["の"],["考え","かんがえ"],["です"],["。"]]},{"verse":29,"text":"それとも、神はユダヤ人だけの神でしょうか。異邦人にとっても神ではないのでしょうか。確かに神は、異邦人にとっても、神です。","tok":[["それ"],["と"],["も"],["、"],["神","かみ"],["は"],["ユダヤ人","ゆだやじん"],["だけ"],["の"],["神","かみ"],["でしょう"],["か"],["。"],["異邦人","いほうじん"],["にとって"],["も"],["神","かみ"],["で"],["は"],["ない"],["の"],["でしょう"],["か"],["。"],["確か","たしか"],["に"],["神","かみ"],["は"],["、"],["異邦人","いほうじん"],["にとって"],["も"],["、"],["神","かみ"],["です"],["。"]]},{"verse":30,"text":"神が唯一ならばそうです。この神は、割礼のある者を信仰によって義と認めてくださるとともに、割礼のない者をも、信仰によって義と認めてくださるのです。","tok":[["神","かみ"],["が"],["唯一","ゆいいつ"],["ならば"],["そう"],["です"],["。"],["この"],["神","かみ"],["は"],["、"],["割礼","かつれい"],["の"],["ある"],["者","もの"],["を"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["認めて","みとめて"],["くださる"],["と"],["とも"],["に"],["、"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["を"],["も"],["、"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["認めて","みとめて"],["くださる"],["の"],["です"],["。"]]},{"verse":31,"text":"それでは、私たちは信仰によって律法を無効にすることになるのでしょうか。絶対にそんなことはありません。かえって、律法を確立することになるのです。","tok":[["それ"],["で"],["は"],["、"],["私たち","わたしたち"],["は"],["信仰","しんこう"],["によって"],["律法","りっぽう"],["を"],["無効","むこう"],["に"],["する"],["こと"],["に"],["なる"],["の"],["でしょう"],["か"],["。"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"],["かえって"],["、"],["律法","りっぽう"],["を"],["確立","かくりつ"],["する"],["こと"],["に"],["なる"],["の"],["です"],["。"]]}]
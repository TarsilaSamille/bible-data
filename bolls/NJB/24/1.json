[{"verse":1,"text":"ベニヤミンの地アナトテにいた祭司のひとり、ヒルキヤの子エレミヤのことば。","tok":[["ベニヤミン"],["の"],["地","ち"],["アナトテ"],["に"],["いた"],["祭司","さいし"],["の"],["ひとり"],["、"],["ヒルキヤ"],["の"],["子","こ"],["エレミヤ"],["の"],["ことば"],["。"]]},{"verse":2,"text":"アモンの子、ユダの王ヨシヤの時代、その治世の第十三年に、エレミヤに主のことばがあった。","tok":[["アモン"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["ヨシヤ"],["の"],["時代","じだい"],["、"],["その"],["治世","ちせい"],["の"],["第","だい"],["十三","じゅうさん"],["年","ねん"],["に"],["、"],["エレミヤ"],["に"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":3,"text":"それはさらに、ヨシヤの子、ユダの王エホヤキムの時代にもあり、ヨシヤの子、ユダの王ゼデキヤの第十一年の終わりまで、すなわち、その年の第五の月、エルサレムの民の捕囚の時まであった。","tok":[["それ"],["は"],["さらに"],["、"],["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["時代","じだい"],["に"],["も"],["あり"],["、"],["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["第","だい"],["十一","じゅういち"],["年","ねん"],["の"],["終わり","おわり"],["まで"],["、"],["すなわち"],["、"],["その"],["年","とし"],["の"],["第","だい"],["五","ご"],["の"],["月","つき"],["、"],["エルサレム"],["の"],["民","たみ"],["の"],["捕囚","ほしゅう"],["の"],["時","とき"],["まで"],["あった"],["。"]]},{"verse":4,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":5,"text":"「わたしは、あなたを胎内に形造る前から、あなたを知り、あなたが腹から出る前から、あなたを聖別し、あなたを国々への預言者と定めていた。」","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["を"],["胎内","たいない"],["に"],["形造る","かたちづくる"],["前","まえ"],["から"],["、"],["あなた"],["を"],["知り","しり"],["、"],["あなた"],["が"],["腹","はら"],["から"],["出る","でる"],["前","まえ"],["から"],["、"],["あなた"],["を"],["聖別","せいべつ"],["し"],["、"],["あなた"],["を"],["国々","くにぐに"],["へ"],["の"],["預言者","よげんしゃ"],["と"],["定めて","さだめて"],["いた"],["。"],["」"]]},{"verse":6,"text":"そこで、私は言った。「ああ、神、主よ。ご覧のとおり、私はまだ若くて、どう語っていいかわかりません。」","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["ご覧","ごらん"],["の"],["とおり"],["、"],["私","わたくし"],["は"],["まだ"],["若くて","わかくて"],["、"],["どう"],["語って","かたって"],["いい"],["か"],["わかりません"],["。"],["」"]]},{"verse":7,"text":"すると、主は私に仰せられた。／「まだ若い、と言うな。／わたしがあなたを遣わすどんな所へでも行き、わたしがあなたに命じるすべての事を語れ。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["／"],["「"],["まだ"],["若い","わかい"],["、"],["と"],["言う","ゆう"],["な"],["。"],["／"],["わたし"],["が"],["あなた"],["を"],["遣わす","つかわす"],["どんな"],["所","ところ"],["へ"],["で"],["も"],["行き","いき"],["、"],["わたし"],["が"],["あなた"],["に"],["命じる","めいじる"],["すべて"],["の"],["事","こと"],["を"],["語れ","かたれ"],["。"]]},{"verse":8,"text":"彼らの顔を恐れるな。／わたしはあなたとともにいて、あなたを救い出すからだ。／――主の御告げ――」","tok":[["彼","かれ"],["ら"],["の"],["顔","かお"],["を"],["恐れる","おそれる"],["な"],["。"],["／"],["わたし"],["は"],["あなた"],["と"],["とも"],["に"],["いて"],["、"],["あなた"],["を"],["救い出す","すくいだす"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":9,"text":"そのとき、主は御手を伸ばして、私の口に触れ、主は私に仰せられた。／「今、わたしのことばをあなたの口に授けた。","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["御手","おて"],["を"],["伸ばして","のばして"],["、"],["私","わたくし"],["の"],["口","くち"],["に"],["触れ","ふれ"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["／"],["「"],["今","いま"],["、"],["わたし"],["の"],["ことば"],["を"],["あなた"],["の"],["口","くち"],["に"],["授けた","さずけた"],["。"]]},{"verse":10,"text":"見よ。わたしは、きょう、あなたを諸国の民と王国の上に任命し、あるいは引き抜き、あるいは引き倒し、あるいは滅ぼし、あるいはこわし、あるいは建て、また植えさせる。」","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["きょう"],["、"],["あなた"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["と"],["王国","おうこく"],["の"],["上","うえ"],["に"],["任命","にんめい"],["し"],["、"],["あるいは"],["引き抜き","ひきぬき"],["、"],["あるいは"],["引き倒し","ひきたおし"],["、"],["あるいは"],["滅ぼし","ほろぼし"],["、"],["あるいは"],["こわし"],["、"],["あるいは"],["建て","たて"],["、"],["また"],["植えさせる","うえさせる"],["。"],["」"]]},{"verse":11,"text":"次のような主のことばが私にあった。「エレミヤ。あなたは何を見ているのか。」そこで私は言った。「アーモンドの枝を見ています。」","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"],["「"],["エレミヤ"],["。"],["あなた"],["は"],["何","なん"],["を"],["見て","みて"],["いる"],["の"],["か"],["。"],["」"],["そこ"],["で"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["アーモンド"],["の"],["枝","えだ"],["を"],["見て","みて"],["います"],["。"],["」"]]},{"verse":12,"text":"すると主は私に仰せられた。「よく見たものだ。わたしのことばを実現しようと、わたしは見張っているからだ。」","tok":[["する"],["と"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["よく"],["見た","みた"],["もの"],["だ"],["。"],["わたし"],["の"],["ことば"],["を"],["実現","じつげん"],["しよう"],["と"],["、"],["わたし"],["は"],["見張って","みはって"],["いる"],["から"],["だ"],["。"],["」"]]},{"verse":13,"text":"再び、私に次のような主のことばがあった。「何を見ているのか。」そこで私は言った。「煮え立っているかまを見ています。それは北のほうからこちらに傾いています。」","tok":[["再び","ふたたび"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"],["「"],["何","なん"],["を"],["見て","みて"],["いる"],["の"],["か"],["。"],["」"],["そこ"],["で"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["煮え立って","にえたって"],["いる"],["かま"],["を"],["見て","みて"],["います"],["。"],["それ"],["は"],["北","きた"],["の"],["ほう"],["から"],["こちら"],["に"],["傾いて","かたむいて"],["います"],["。"],["」"]]},{"verse":14,"text":"すると主は私に仰せられた。／「わざわいが、北からこの地の全住民の上に、降りかかる。","tok":[["する"],["と"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["／"],["「"],["わざわい"],["が"],["、"],["北","きた"],["から"],["この"],["地","ち"],["の"],["全住民","ぜんじゅうみん"],["の"],["上","うえ"],["に"],["、"],["降りかかる","ふりかかる"],["。"]]},{"verse":15,"text":"今、わたしは北のすべての王国の民に／呼びかけているからだ。／――主の御告げ――／彼らは来て、エルサレムの門の入口と、周囲のすべての城壁と、ユダのすべての町に向かって、それぞれの王座を設ける。","tok":[["今","いま"],["、"],["わたし"],["は"],["北","きた"],["の"],["すべて"],["の"],["王国","おうこく"],["の"],["民","たみ"],["に"],["／"],["呼びかけて","よびかけて"],["いる"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["エルサレム"],["の"],["門","もん"],["の"],["入口","いりぐち"],["と"],["、"],["周囲","しゅうい"],["の"],["すべて"],["の"],["城壁","じょうへき"],["と"],["、"],["ユダ"],["の"],["すべて"],["の"],["町","まち"],["に"],["向かって","むかって"],["、"],["それぞれ"],["の"],["王座","おうざ"],["を"],["設ける","もうける"],["。"]]},{"verse":16,"text":"しかし、わたしは、彼らのすべての悪にさばきを下す。／彼らはわたしを捨てて、ほかの神々にいけにえをささげ、自分の手で造った物を拝んだからだ。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["悪","わる"],["に"],["さばき"],["を"],["下す","くだす"],["。"],["／"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["捨てて","すてて"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["造った","つくった"],["物","もの"],["を"],["拝んだ","おがんだ"],["から"],["だ"],["。"]]},{"verse":17,"text":"さあ、あなたは腰に帯を締め、立ち上がって、わたしがあなたに命じることをみな語れ。／彼らの顔におびえるな。／さもないと、わたしはあなたを彼らの面前で打ち砕く。","tok":[["さあ"],["、"],["あなた"],["は"],["腰","こし"],["に"],["帯","おび"],["を"],["締め","しめ"],["、"],["立ち上がって","たちあがって"],["、"],["わたし"],["が"],["あなた"],["に"],["命じる","めいじる"],["こと"],["を"],["みな"],["語れ","かたれ"],["。"],["／"],["彼","かれ"],["ら"],["の"],["顔","かお"],["に"],["おびえる"],["な"],["。"],["／"],["さも"],["ない"],["と"],["、"],["わたし"],["は"],["あなた"],["を"],["彼","かれ"],["ら"],["の"],["面前","めんぜん"],["で"],["打ち砕く","うちくだく"],["。"]]},{"verse":18,"text":"見よ。わたしはきょう、あなたを、全国に、ユダの王たち、首長たち、祭司たち、この国の人々に対して、城壁のある町、鉄の柱、青銅の城壁とした。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["きょう"],["、"],["あなた"],["を"],["、"],["全国","ぜんこく"],["に"],["、"],["ユダ"],["の"],["王","おう"],["たち"],["、"],["首長","しゅちょう"],["たち"],["、"],["祭司","さいし"],["たち"],["、"],["この"],["国","くに"],["の"],["人々","ひとびと"],["に対して","にたいして"],["、"],["城壁","じょうへき"],["の"],["ある"],["町","まち"],["、"],["鉄","てつ"],["の"],["柱","はしら"],["、"],["青銅","せいどう"],["の"],["城壁","じょうへき"],["と"],["した"],["。"]]},{"verse":19,"text":"だから、彼らがあなたと戦っても、あなたには勝てない。／わたしがあなたとともにいて、――主の御告げ――／あなたを救い出すからだ。」","tok":[["だ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["と"],["戦って","たたかって"],["も"],["、"],["あなた"],["に"],["は"],["勝てない","かてない"],["。"],["／"],["わたし"],["が"],["あなた"],["と"],["とも"],["に"],["いて"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["あなた"],["を"],["救い出す","すくいだす"],["から"],["だ"],["。"],["」"]]}]
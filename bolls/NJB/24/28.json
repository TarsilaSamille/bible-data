[{"verse":1,"text":"その同じ年、すなわち、ユダの王ゼデキヤの治世の初め、第四年の第五の月に、ギブオンの出の預言者、アズルの子ハナヌヤが、主の宮で、祭司たちとすべての民の前で、私に語って言った。","tok":[["その"],["同じ","おなじ"],["年","とし"],["、"],["すなわち"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["治世","ちせい"],["の"],["初め","はじめ"],["、"],["第","だい"],["四","よん"],["年","ねん"],["の"],["第","だい"],["五","ご"],["の"],["月","つき"],["に"],["、"],["ギブオン"],["の"],["出","で"],["の"],["預言者","よげんしゃ"],["、"],["アズル"],["の"],["子","こ"],["ハナヌヤ"],["が"],["、"],["主","ぬし"],["の"],["宮","みや"],["で"],["、"],["祭司","さいし"],["たち"],["と"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["、"],["私","わたくし"],["に"],["語って","かたって"],["言った","いった"],["。"]]},{"verse":2,"text":"「イスラエルの神、万軍の主は、こう仰せられる。わたしは、バビロンの王のくびきを打ち砕く。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["、"],["バビロン"],["の"],["王","おう"],["の"],["くびき"],["を"],["打ち砕く","うちくだく"],["。"]]},{"verse":3,"text":"二年のうちに、わたしは、バビロンの王ネブカデネザルがこの所から取って、バビロンに運んだ主の宮のすべての器をこの所に帰らせる。","tok":[["二","に"],["年","ねん"],["の"],["うち"],["に"],["、"],["わたし"],["は"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["が"],["この"],["所","ところ"],["から"],["取って","とって"],["、"],["バビロン"],["に"],["運んだ","はこんだ"],["主","ぬし"],["の"],["宮","みや"],["の"],["すべて"],["の"],["器","うつわ"],["を"],["この"],["所","ところ"],["に"],["帰らせる","かえらせる"],["。"]]},{"verse":4,"text":"バビロンに行ったエホヤキムの子、ユダの王エコヌヤと、ユダのすべての捕囚の民も、わたしはこの所に帰らせる。――主の御告げ――わたしがバビロンの王のくびきを打ち砕くからだ。」","tok":[["バビロン"],["に"],["行った","いった"],["エホヤキム"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エコヌヤ"],["と"],["、"],["ユダ"],["の"],["すべて"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["も"],["、"],["わたし"],["は"],["この"],["所","ところ"],["に"],["帰らせる","かえらせる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["が"],["バビロン"],["の"],["王","おう"],["の"],["くびき"],["を"],["打ち砕く","うちくだく"],["から"],["だ"],["。"],["」"]]},{"verse":5,"text":"そこで預言者エレミヤは、主の宮に立っている祭司たちや、すべての民の前で、預言者ハナヌヤに言った。","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["立って","たって"],["いる"],["祭司","さいし"],["たち"],["や"],["、"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["、"],["預言者","よげんしゃ"],["ハナヌヤ"],["に"],["言った","いった"],["。"]]},{"verse":6,"text":"預言者エレミヤは言った。「アーメン。そのとおりに主がしてくださるように。あなたが預言したことばを主が成就させ、主の宮の器と、すべての捕囚の民がバビロンからこの所に帰って来るように。","tok":[["預言者","よげんしゃ"],["エレミヤ"],["は"],["言った","いった"],["。"],["「"],["アーメン"],["。"],["その"],["とおり"],["に"],["主","ぬし"],["が"],["して"],["くださる"],["よう"],["に"],["。"],["あなた"],["が"],["預言","よげん"],["した"],["ことば"],["を"],["主","ぬし"],["が"],["成就","じょうじゅ"],["させ"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["器","うつわ"],["と"],["、"],["すべて"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["が"],["バビロン"],["から"],["この"],["所","ところ"],["に"],["帰って","かえって"],["来る","くる"],["よう"],["に"],["。"]]},{"verse":7,"text":"しかし、私があなたの耳と、すべての民の耳に語っているこのことばを聞きなさい。","tok":[["しかし"],["、"],["私","わたくし"],["が"],["あなた"],["の"],["耳","みみ"],["と"],["、"],["すべて"],["の"],["民","たみ"],["の"],["耳","みみ"],["に"],["語って","かたって"],["いる"],["この"],["ことば"],["を"],["聞き","きき"],["なさい"],["。"]]},{"verse":8,"text":"昔から、私と、あなたの先に出た預言者たちは、多くの国と大きな王国について、戦いとわざわいと疫病とを預言した。","tok":[["昔","むかし"],["から"],["、"],["私","わたくし"],["と"],["、"],["あなた"],["の"],["先","さき"],["に"],["出た","でた"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["多く","おおく"],["の"],["国","くに"],["と"],["大きな","おおきな"],["王国","おうこく"],["について"],["、"],["戦い","たたかい"],["と"],["わざわい"],["と"],["疫病","やくびょう"],["と"],["を"],["預言","よげん"],["した"],["。"]]},{"verse":9,"text":"平安を預言する預言者については、その預言者のことばが成就して初めて、ほんとうに主が遣わされた預言者だ、と知られるのだ。」","tok":[["平安","へいあん"],["を"],["預言","よげん"],["する"],["預言者","よげんしゃ"],["について"],["は"],["、"],["その"],["預言者","よげんしゃ"],["の"],["ことば"],["が"],["成就","じょうじゅ"],["して"],["初めて","はじめて"],["、"],["ほんとう"],["に"],["主","ぬし"],["が"],["遣わされた","つかわされた"],["預言者","よげんしゃ"],["だ"],["、"],["と"],["知られる","しられる"],["の"],["だ"],["。"],["」"]]},{"verse":10,"text":"しかし預言者ハナヌヤは、預言者エレミヤの首から例のかせを取り、それを砕いた。","tok":[["しかし"],["預言者","よげんしゃ"],["ハナヌヤ"],["は"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["首","くび"],["から"],["例","れい"],["のかせ"],["を"],["取り","とり"],["、"],["それ"],["を"],["砕いた","くだいた"],["。"]]},{"verse":11,"text":"そしてハナヌヤは、すべての民の前でこう言った。「主はこう仰せられる。『このとおり、わたしは二年のうちに、バビロンの王ネブカデネザルのくびきを、すべての国の首から砕く。』」そこで、預言者エレミヤは立ち去った。","tok":[["そして"],["ハナヌヤ"],["は"],["、"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["こう"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["この"],["とおり"],["、"],["わたし"],["は"],["二","に"],["年","ねん"],["の"],["うち"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["の"],["くびき"],["を"],["、"],["すべて"],["の"],["国","くに"],["の"],["首","くび"],["から"],["砕く","くだく"],["。"],["』"],["」"],["そこ"],["で"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["立ち去った","たちさった"],["。"]]},{"verse":12,"text":"預言者ハナヌヤが預言者エレミヤの首からかせを取ってこれを砕いて後、エレミヤに次のような主のことばがあった。","tok":[["預言者","よげんしゃ"],["ハナヌヤ"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["首","くび"],["から"],["かせ"],["を"],["取って","とって"],["これ"],["を"],["砕いて","くだいて"],["後","あと"],["、"],["エレミヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":13,"text":"「行って、ハナヌヤに次のように言え。『主はこう仰せられる。あなたは木のかせを砕いたが、その代わりに、鉄のかせを作ることになる。","tok":[["「"],["行って","いって"],["、"],["ハナヌヤ"],["に"],["次","つぎ"],["の"],["よう"],["に"],["言え","いえ"],["。"],["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["は"],["木","き"],["のかせ"],["を"],["砕いた","くだいた"],["が"],["、"],["その"],["代わり","かわり"],["に"],["、"],["鉄","てつ"],["のかせ"],["を"],["作る","つくる"],["こと"],["に"],["なる"],["。"]]},{"verse":14,"text":"まことに、イスラエルの神、万軍の主は、こう仰せられる。わたしは鉄のくびきをこれらすべての国の首にはめて、バビロンの王ネブカデネザルに仕えさせる。それで彼らは彼に仕える。野の獣まで、わたしは彼に与えた。』」","tok":[["まこと"],["に"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["鉄","てつ"],["の"],["くびき"],["を"],["これ"],["ら"],["すべて"],["の"],["国","くに"],["の"],["首","くび"],["に"],["はめて"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["に"],["仕えさせる","つかえさせる"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["に"],["仕える","つかえる"],["。"],["野","の"],["の"],["獣","けもの"],["まで"],["、"],["わたし"],["は"],["彼","かれ"],["に"],["与えた","あたえた"],["。"],["』"],["」"]]},{"verse":15,"text":"そこで預言者エレミヤは、預言者ハナヌヤに言った。「ハナヌヤ。聞きなさい。主はあなたを遣わされなかった。あなたはこの民を偽りに拠り頼ませた。","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["、"],["預言者","よげんしゃ"],["ハナヌヤ"],["に"],["言った","いった"],["。"],["「"],["ハナヌヤ"],["。"],["聞き","きき"],["なさい"],["。"],["主","ぬし"],["は"],["あなた"],["を"],["遣わされなかった","つかわされなかった"],["。"],["あなた"],["は"],["この"],["民","たみ"],["を"],["偽り","いつわり"],["に"],["拠り","より"],["頼ませた","たのませた"],["。"]]},{"verse":16,"text":"それゆえ、主はこう仰せられる。『見よ。わたしはあなたを地の面から追い出す。ことし、あなたは死ぬ。主への反逆をそそのかしたからだ。』」","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["地","ち"],["の"],["面","めん"],["から"],["追い出す","おいだす"],["。"],["ことし"],["、"],["あなた"],["は"],["死ぬ","しぬ"],["。"],["主","ぬし"],["へ"],["の"],["反逆","はんぎゃく"],["を"],["そそのかした"],["から"],["だ"],["。"],["』"],["」"]]},{"verse":17,"text":"預言者ハナヌヤはその年の第七の月に死んだ。","tok":[["預言者","よげんしゃ"],["ハナヌヤ"],["は"],["その"],["年","とし"],["の"],["第","だい"],["七","なな"],["の"],["月","つき"],["に"],["死んだ","しんだ"],["。"]]}]
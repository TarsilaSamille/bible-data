[{"verse":1,"text":"主からエレミヤにあったみことばは、こうである。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["は"],["、"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"「立って、陶器師の家に下れ。そこで、あなたに、わたしのことばを聞かせよう。」","tok":[["「"],["立って","たって"],["、"],["陶器師","とうきし"],["の"],["家","いえ"],["に"],["下れ","くだれ"],["。"],["そこ"],["で"],["、"],["あなた"],["に"],["、"],["わたし"],["の"],["ことば"],["を"],["聞かせよう","きかせよう"],["。"],["」"]]},{"verse":3,"text":"私が陶器師の家に下って行くと、ちょうど、彼はろくろで仕事をしているところだった。","tok":[["私","わたくし"],["が"],["陶器師","とうきし"],["の"],["家","いえ"],["に"],["下って","くだって"],["行く","いく"],["と"],["、"],["ちょうど"],["、"],["彼","かれ"],["は"],["ろくろ"],["で"],["仕事","しごと"],["を"],["して"],["いる"],["ところ"],["だった"],["。"]]},{"verse":4,"text":"陶器師は、粘土で制作中の器を自分の手でこわし、再びそれを陶器師自身の気に入ったほかの器に作り替えた。","tok":[["陶器師","とうきし"],["は"],["、"],["粘土","ねんど"],["で"],["制作中","せいさくちゅう"],["の"],["器","うつわ"],["を"],["自分","じぶん"],["の"],["手","て"],["で"],["こわし"],["、"],["再び","ふたたび"],["それ"],["を"],["陶器師","とうきし"],["自身","じしん"],["の"],["気","き"],["に"],["入った","いった"],["ほか"],["の"],["器","うつわ"],["に"],["作り替えた","つくりかえた"],["。"]]},{"verse":5,"text":"それから、私に次のような主のことばがあった。","tok":[["それ"],["から"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":6,"text":"「イスラエルの家よ。この陶器師のように、わたしがあなたがたにすることができないだろうか。――主の御告げ――見よ。粘土が陶器師の手の中にあるように、イスラエルの家よ、あなたがたも、わたしの手の中にある。","tok":[["「"],["イスラエル"],["の"],["家","いえ"],["よ"],["。"],["この"],["陶器師","とうきし"],["の"],["よう"],["に"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["する"],["こと"],["が"],["できないだろう"],["か"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["見","み"],["よ"],["。"],["粘土","ねんど"],["が"],["陶器師","とうきし"],["の"],["手","て"],["の"],["中","なか"],["に"],["ある"],["よう"],["に"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["あなた"],["がた"],["も"],["、"],["わたし"],["の"],["手","て"],["の"],["中","なか"],["に"],["ある"],["。"]]},{"verse":7,"text":"わたしが、一つの国、一つの王国について、引き抜き、引き倒し、滅ぼすと語ったその時、","tok":[["わたし"],["が"],["、"],["一","ひと"],["つ"],["の"],["国","くに"],["、"],["一","ひと"],["つ"],["の"],["王国","おうこく"],["について"],["、"],["引き抜き","ひきぬき"],["、"],["引き倒し","ひきたおし"],["、"],["滅ぼす","ほろぼす"],["と"],["語った","かたった"],["その"],["時","とき"],["、"]]},{"verse":8,"text":"もし、わたしがわざわいを予告したその民が、悔い改めるなら、わたしは、下そうと思っていたわざわいを思い直す。","tok":[["もし"],["、"],["わたし"],["が"],["わざわい"],["を"],["予告","よこく"],["した"],["その"],["民","たみ"],["が"],["、"],["悔い改めるなら","くいあらためるなら"],["、"],["わたし"],["は"],["、"],["下そう","くだそう"],["と"],["思って","おもって"],["いた"],["わざわい"],["を"],["思い直す","おもいなおす"],["。"]]},{"verse":9,"text":"わたしが、一つの国、一つの王国について、建て直し、植えると語ったその時、","tok":[["わたし"],["が"],["、"],["一","ひと"],["つ"],["の"],["国","くに"],["、"],["一","ひと"],["つ"],["の"],["王国","おうこく"],["について"],["、"],["建て直し","たてなおし"],["、"],["植える","うえる"],["と"],["語った","かたった"],["その"],["時","とき"],["、"]]},{"verse":10,"text":"もし、それがわたしの声に聞き従わず、わたしの目の前に悪を行うなら、わたしは、それに与えると言ったしあわせを思い直す。","tok":[["もし"],["、"],["それ"],["が"],["わたし"],["の"],["声","こえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行うなら","おこなうなら"],["、"],["わたし"],["は"],["、"],["それ"],["に"],["与える","あたえる"],["と"],["言った","いった"],["しあわせ"],["を"],["思い直す","おもいなおす"],["。"]]},{"verse":11,"text":"さあ、今、ユダの人とエルサレムの住民に言え。『主はこう仰せられる。見よ。わたしはあなたがたに対してわざわいを考え、あなたがたを攻める計画を立てている。さあ、おのおの悪の道から立ち返り、あなたがたの行いとわざとを改めよ。』","tok":[["さあ"],["、"],["今","いま"],["、"],["ユダ"],["の"],["人","ひと"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["言え","いえ"],["。"],["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["がた"],["に対して","にたいして"],["わざわい"],["を"],["考え","かんがえ"],["、"],["あなた"],["がた"],["を"],["攻める","せめる"],["計画","けいかく"],["を"],["立てて","たてて"],["いる"],["。"],["さあ"],["、"],["おのおの"],["悪","わる"],["の"],["道","みち"],["から"],["立ち返り","たちかえり"],["、"],["あなた"],["がた"],["の"],["行い","おこない"],["と"],["わざと"],["を"],["改めよ","あらためよ"],["。"],["』"]]},{"verse":12,"text":"しかし、彼らは言う。『だめだ。私たちは自分の計画に従い、おのおの悪いかたくなな心のままに行うのだから』と。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["言う","ゆう"],["。"],["『"],["だめ"],["だ"],["。"],["私たち","わたしたち"],["は"],["自分","じぶん"],["の"],["計画","けいかく"],["に"],["従い","したがい"],["、"],["おのおの"],["悪い","わるい"],["かたくな"],["な"],["心","こころ"],["の"],["まま"],["に"],["行う","おこなう"],["の"],["だ"],["から"],["』"],["と"],["。"]]},{"verse":13,"text":"それゆえ、主はこう仰せられる。／『さあ、国々の中で尋ねてみよ。／だれが、こんなことを聞いたことがあるか。／おとめイスラエルは、実に恐るべきことを行った。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["『"],["さあ"],["、"],["国々","くにぐに"],["の"],["中","なか"],["で"],["尋ねて","たずねて"],["み"],["よ"],["。"],["／"],["だれ"],["が"],["、"],["こんな"],["こと"],["を"],["聞いた","きいた"],["こと"],["が"],["ある"],["か"],["。"],["／"],["おとめ"],["イスラエル"],["は"],["、"],["実","じつ"],["に"],["恐るべき","おそるべき"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":14,"text":"レバノンの雪は、野の岩から消え去るだろうか。／ほかの国から流れて来る冷たい水が、引き抜かれるだろうか。","tok":[["レバノン"],["の"],["雪","ゆき"],["は"],["、"],["野","の"],["の"],["岩","いわ"],["から"],["消え去るだろう","きえさるだろう"],["か"],["。"],["／"],["ほか"],["の"],["国","くに"],["から"],["流れて","ながれて"],["来る","くる"],["冷たい","つめたい"],["水","みず"],["が"],["、"],["引き抜かれるだろう","ひきぬかれるだろう"],["か"],["。"]]},{"verse":15,"text":"それなのに、わたしの民はわたしを忘れ、むなしいものに香をたく。／それらは、彼らをその道、いにしえの道でつまずかせ、小道に、まだ築かれていない道に行かせ、","tok":[["それ"],["な"],["のに"],["、"],["わたし"],["の"],["民","たみ"],["は"],["わたし"],["を"],["忘れ","わすれ"],["、"],["むなしい"],["もの"],["に"],["香","こう"],["を"],["たく"],["。"],["／"],["それ"],["ら"],["は"],["、"],["彼","かれ"],["ら"],["を"],["その"],["道","みち"],["、"],["いにしえ"],["の"],["道","みち"],["で"],["つまずかせ"],["、"],["小道","こみち"],["に"],["、"],["まだ"],["築かれて","きずかれて"],["いない"],["道","みち"],["に"],["行かせ","いかせ"],["、"]]},{"verse":16,"text":"彼らの国を恐怖とし、永久にあざけりとする。／そこを通り過ぎる者はみな色を失い、頭を振る。","tok":[["彼","かれ"],["ら"],["の"],["国","くに"],["を"],["恐怖","きょうふ"],["と"],["し"],["、"],["永久","えいきゅう"],["に"],["あざけり"],["と"],["する"],["。"],["／"],["そこ"],["を"],["通り過ぎる","とおりすぎる"],["者","もの"],["は"],["みな"],["色","いろ"],["を"],["失い","うしない"],["、"],["頭","あたま"],["を"],["振る","ふる"],["。"]]},{"verse":17,"text":"東風のように、わたしは彼らを敵の前で散らす。／彼らの災難の日に、わたしは彼らに背を向け、顔を向けない。』」","tok":[["東風","とうふう"],["の"],["よう"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["前","まえ"],["で"],["散らす","ちらす"],["。"],["／"],["彼","かれ"],["ら"],["の"],["災難","さいなん"],["の"],["日","ひ"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["背","せ"],["を"],["向け","むけ"],["、"],["顔","かお"],["を"],["向けない","むけない"],["。"],["』"],["」"]]},{"verse":18,"text":"彼らは言った。「さあ、私たちは計画を立ててエレミヤを倒そう。祭司から律法が、知恵ある者からはかりごとが、預言者からことばが滅びうせることはないはずだから。さあ、舌で彼を打ち、彼のことばにはどれにも耳を傾けまい。」","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["さあ"],["、"],["私たち","わたしたち"],["は"],["計画","けいかく"],["を"],["立てて","たてて"],["エレミヤ"],["を"],["倒そう","たおそう"],["。"],["祭司","さいし"],["から"],["律法","りっぽう"],["が"],["、"],["知恵","ちえ"],["ある"],["者","もの"],["から"],["はかりごと"],["が"],["、"],["預言者","よげんしゃ"],["から"],["ことば"],["が"],["滅び","ほろび"],["うせる"],["こと"],["は"],["ない"],["はず"],["だ"],["から"],["。"],["さあ"],["、"],["舌","した"],["で"],["彼","かれ"],["を"],["打ち","うち"],["、"],["彼","かれ"],["の"],["ことば"],["に"],["は"],["どれ"],["に"],["も"],["耳","みみ"],["を"],["傾けまい","かたむけまい"],["。"],["」"]]},{"verse":19,"text":"主よ。私に耳を傾け、私と争う者の声を聞いてください。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["私","わたくし"],["と"],["争う","あらそう"],["者","もの"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["ください"],["。"]]},{"verse":20,"text":"善に悪を報いてよいでしょうか。／まことに彼らは、私のいのちを取ろうとして／穴を掘ったのです。／私があなたの御前に立って、彼らに対するあなたの憤りをやめていただき、彼らについて良いことを語ったことを、覚えてください。","tok":[["善","ぜん"],["に"],["悪","あく"],["を"],["報いて","むくいて"],["よいでしょう"],["か"],["。"],["／"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["取ろう","とろう"],["として"],["／"],["穴","あな"],["を"],["掘った","ほった"],["の"],["です"],["。"],["／"],["私","わたくし"],["が"],["あなた"],["の"],["御前","ごぜん"],["に"],["立って","たって"],["、"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["あなた"],["の"],["憤り","いきどおり"],["を"],["やめて"],["いただき"],["、"],["彼","かれ"],["ら"],["について"],["良い","よい"],["こと"],["を"],["語った","かたった"],["こと"],["を"],["、"],["覚えて","おぼえて"],["ください"],["。"]]},{"verse":21,"text":"それゆえ、彼らの子らをききんに渡し、彼らを剣で殺してください。／妻たちは子を失い、また、やもめになり、夫たちは虐殺されて死に、若い男たちは戦いで剣に殺されますように。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["の"],["子","こ"],["ら"],["を"],["ききん"],["に"],["渡し","わたし"],["、"],["彼","かれ"],["ら"],["を"],["剣","けん"],["で"],["殺して","ころして"],["ください"],["。"],["／"],["妻たち","つまたち"],["は"],["子","こ"],["を"],["失い","うしない"],["、"],["また"],["、"],["やもめ"],["に"],["なり"],["、"],["夫","おっと"],["たち"],["は"],["虐殺","ぎゃくさつ"],["されて"],["死に","しに"],["、"],["若い","わかい"],["男","おとこ"],["たち"],["は"],["戦い","たたかい"],["で"],["剣","けん"],["に"],["殺されます","ころされます"],["よう"],["に"],["。"]]},{"verse":22,"text":"あなたが突然、略奪隊に彼らを襲わせるとき、彼らの家からの叫びが聞こえます。／彼らは私を捕らえようと穴を掘り、私の足もとに、わなを隠したからです。","tok":[["あなた"],["が"],["突然","とつぜん"],["、"],["略奪隊","りゃくだつたい"],["に"],["彼","かれ"],["ら"],["を"],["襲わせる","おそわせる"],["とき"],["、"],["彼","かれ"],["ら"],["の"],["家","いえ"],["から"],["の"],["叫び","さけび"],["が"],["聞こえます","きこえます"],["。"],["／"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["を"],["捕らえよう","とらえよう"],["と"],["穴","あな"],["を"],["掘り","ほり"],["、"],["私","わたくし"],["の"],["足もと","あしもと"],["に"],["、"],["わな"],["を"],["隠した","かくした"],["から"],["です"],["。"]]},{"verse":23,"text":"しかし、主よ。あなたは、私を殺そうとする彼らの計画を／みな、ご存じです。／彼らの咎をおおわず、彼らの罪を御前からぬぐい去らないでください。／彼らを、御前で打ち倒し、あなたの御怒りの時に、彼らを罰してください。","tok":[["しかし"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["、"],["私","わたくし"],["を"],["殺そう","ころそう"],["と"],["する"],["彼","かれ"],["ら"],["の"],["計画","けいかく"],["を"],["／"],["みな"],["、"],["ご存じ","ごぞんじ"],["です"],["。"],["／"],["彼","かれ"],["ら"],["の"],["咎","とが"],["を"],["おおわず"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["御前","ごぜん"],["から"],["ぬぐい去らないで","ぬぐいさらないで"],["ください"],["。"],["／"],["彼","かれ"],["ら"],["を"],["、"],["御前","ごぜん"],["で"],["打ち倒し","うちたおし"],["、"],["あなた"],["の"],["御怒り","おいかり"],["の"],["時","とき"],["に"],["、"],["彼","かれ"],["ら"],["を"],["罰して","ばっして"],["ください"],["。"]]}]
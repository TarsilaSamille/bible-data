[{"verse":1,"text":"モアブについて。イスラエルの神、万軍の主は、こう仰せられる。「ああ、悲しいかな、ネボ。これは荒らされた。キルヤタイムもはずかしめられ、攻め取られた。そのとりでは、はずかしめられて打ちのめされた。","tok":[["モアブ"],["について"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["ああ"],["、"],["悲しい","かなしい"],["か"],["な"],["、"],["ネボ"],["。"],["これ"],["は"],["荒らされた","あらされた"],["。"],["キルヤタイム"],["も"],["はずかしめられ"],["、"],["攻め取られた","せめとられた"],["。"],["その"],["とり"],["で"],["は"],["、"],["はずかしめられて"],["打ちのめされた","うちのめされた"],["。"]]},{"verse":2,"text":"もはやモアブの栄誉はない。ヘシュボンでは、これに悪事をたくらんでいる。『行って、あの国民を断ち滅ぼして無き者にしよう。』マデメンよ。おまえも黙る。剣がおまえのあとを追っている。」","tok":[["もはや"],["モアブ"],["の"],["栄誉","えいよ"],["は"],["ない"],["。"],["ヘシュボン"],["で"],["は"],["、"],["これ"],["に"],["悪事","あくじ"],["を"],["たくらんで"],["いる"],["。"],["『"],["行って","いって"],["、"],["あの"],["国民","こくみん"],["を"],["断ち","たち"],["滅ぼして","ほろぼして"],["無き","なき"],["者","もの"],["に"],["しよう"],["。"],["』"],["マデメン"],["よ"],["。"],["おまえ"],["も"],["黙る","だまる"],["。"],["剣","けん"],["が"],["おまえ"],["の"],["あと"],["を"],["追って","おって"],["いる"],["。"],["」"]]},{"verse":3,"text":"聞け。ホロナイムからの悲鳴。／「破壊だ。大破滅だ」と。","tok":[["聞け","きけ"],["。"],["ホロナイム"],["から"],["の"],["悲鳴","ひめい"],["。"],["／"],["「"],["破壊","はかい"],["だ"],["。"],["大","だい"],["破滅","はめつ"],["だ"],["」"],["と"],["。"]]},{"verse":4,"text":"モアブは打ち破られた。／その叫びはツォアルまで聞こえた。","tok":[["モアブ"],["は"],["打ち破られた","うちやぶられた"],["。"],["／"],["その"],["叫び","さけび"],["は"],["ツォアル"],["まで"],["聞こえた","きこえた"],["。"]]},{"verse":5,"text":"ルヒテの坂を泣きながら嘆きが上る。／敵はホロナイムの下り坂では、いたいたしい破滅の叫びを聞いた。","tok":[["ルヒテ"],["の"],["坂","さか"],["を"],["泣き","なき"],["ながら"],["嘆き","なげき"],["が"],["上る","のぼる"],["。"],["／"],["敵","てき"],["は"],["ホロナイム"],["の"],["下り坂","くだりざか"],["で"],["は"],["、"],["いたいたしい"],["破滅","はめつ"],["の"],["叫び","さけび"],["を"],["聞いた","きいた"],["。"]]},{"verse":6,"text":"逃げて、おまえたちのいのちを救え。／荒野の中の野ろばのようになれ。","tok":[["逃げて","にげて"],["、"],["おまえ"],["たち"],["の"],["いのち"],["を"],["救え","すくえ"],["。"],["／"],["荒野","こうや"],["の"],["中","なか"],["の"],["野","の"],["ろば"],["の"],["よう"],["に"],["なれ"],["。"]]},{"verse":7,"text":"おまえは自分の作った物や／財宝に拠り頼んだので、おまえまで捕らえられ、ケモシュはその祭司や首長たちとともに、捕囚となって出て行く。","tok":[["おまえ"],["は"],["自分","じぶん"],["の"],["作った","つくった"],["物","もの"],["や"],["／"],["財宝","ざいほう"],["に"],["拠り","より"],["頼んだ","たのんだ"],["ので"],["、"],["おまえ"],["まで"],["捕らえられ","とらえられ"],["、"],["ケモシュ"],["は"],["その"],["祭司","さいし"],["や"],["首長","しゅちょう"],["たち"],["と"],["とも"],["に"],["、"],["捕囚","ほしゅう"],["と"],["なって"],["出て","でて"],["行く","いく"],["。"]]},{"verse":8,"text":"荒らす者がすべての町に入って来る。／一つの町ものがれることができない。／谷は滅びうせ、平地は根絶やしにされる。／主が仰せられるからだ。","tok":[["荒らす","あらす"],["者","もの"],["が"],["すべて"],["の"],["町","まち"],["に"],["入って","はいって"],["来る","くる"],["。"],["／"],["一","ひと"],["つ"],["の"],["町","まち"],["も"],["のがれる"],["こと"],["が"],["できない"],["。"],["／"],["谷","たに"],["は"],["滅び","ほろび"],["うせ"],["、"],["平地","へいち"],["は"],["根絶やし","ねだやし"],["に"],["される"],["。"],["／"],["主","ぬし"],["が"],["仰せられる","おおせられる"],["から"],["だ"],["。"]]},{"verse":9,"text":"モアブに翼を与えて、飛び去らせよ。／その町々は住む者もなくて荒れ果てる。","tok":[["モアブ"],["に"],["翼","つばさ"],["を"],["与えて","あたえて"],["、"],["飛び去らせ","とびさらせ"],["よ"],["。"],["／"],["その"],["町々","まちまち"],["は"],["住む","すむ"],["者","もの"],["も"],["なくて"],["荒れ果てる","あれはてる"],["。"]]},{"verse":10,"text":"主のみわざをおろそかにする者は、のろわれよ。その剣をとどめて血を流さないようにする者は、のろわれよ。","tok":[["主","ぬし"],["のみ"],["わざ"],["を"],["おろそか"],["に"],["する"],["者","もの"],["は"],["、"],["のろわれ"],["よ"],["。"],["その"],["剣","けん"],["を"],["とどめて"],["血","ち"],["を"],["流さない","ながさない"],["よう"],["に"],["する"],["者","もの"],["は"],["、"],["のろわれ"],["よ"],["。"]]},{"verse":11,"text":"モアブは若い時から安らかであった。／彼はぶどう酒のかすの上にじっとたまっていて、器から器へあけられたこともなく、捕囚として連れて行かれたこともなかった。／それゆえ、その味はそのまま残り、かおりも変わらなかった。","tok":[["モアブ"],["は"],["若い","わかい"],["時","とき"],["から"],["安らか","やすらか"],["で"],["あった"],["。"],["／"],["彼","かれ"],["は"],["ぶどう酒","ぶどうしゅ"],["の"],["かす"],["の"],["上","うえ"],["に"],["じっと"],["たまって"],["いて"],["、"],["器","うつわ"],["から"],["器","うつわ"],["へ"],["あけられた"],["こと"],["も"],["なく"],["、"],["捕囚","ほしゅう"],["として"],["連れて","つれて"],["行かれた","いかれた"],["こと"],["も"],["なかった"],["。"],["／"],["それ"],["ゆえ"],["、"],["その"],["味","あじ"],["は"],["そのまま"],["残り","のこり"],["、"],["かおり"],["も"],["変わらなかった","かわらなかった"],["。"]]},{"verse":12,"text":"「それゆえ、見よ、その日が来る。――主の御告げ――その日、わたしは、彼に酒蔵の番人を送る。彼らはそれを器から移し、その器をあけ、そのつぼを砕く。","tok":[["「"],["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["その"],["日","ひ"],["が"],["来る","くる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["に"],["酒蔵","さかぐら"],["の"],["番人","ばんにん"],["を"],["送る","おくる"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["器","うつわ"],["から"],["移し","うつし"],["、"],["その"],["器","うつわ"],["を"],["あけ"],["、"],["その"],["つぼ"],["を"],["砕く","くだく"],["。"]]},{"verse":13,"text":"モアブは、ケモシュのために恥を見る。イスラエルの家が、彼らの拠り頼むベテルのために恥を見たように。」","tok":[["モアブ"],["は"],["、"],["ケモシュ"],["の"],["ため"],["に"],["恥","はじ"],["を"],["見る","みる"],["。"],["イスラエル"],["の"],["家","いえ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["拠り","より"],["頼む","たのむ"],["ベテル"],["の"],["ため"],["に"],["恥","はじ"],["を"],["見た","みた"],["よう"],["に"],["。"],["」"]]},{"verse":14,"text":"どうして、あなたがたは「われわれは勇士、戦いの豪の者」と言えようか。","tok":[["どう"],["して"],["、"],["あなた"],["がた"],["は"],["「"],["われわれ"],["は"],["勇士","ゆうし"],["、"],["戦い","たたかい"],["の"],["豪","ごう"],["の"],["者","もの"],["」"],["と"],["言えよう","いえよう"],["か"],["。"]]},{"verse":15,"text":"モアブは荒らされ、その町々は襲われて、えり抜きの若者たちも、ほふり場に下って行く。／――その名を万軍の主という王の御告げ――","tok":[["モアブ"],["は"],["荒らされ","あらされ"],["、"],["その"],["町々","まちまち"],["は"],["襲われて","おそわれて"],["、"],["えり抜き","えりぬき"],["の"],["若者","わかもの"],["たち"],["も"],["、"],["ほふり場","ほふりじょう"],["に"],["下って","くだって"],["行く","いく"],["。"],["／"],["―"],["―"],["その"],["名","な"],["を"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["と"],["いう"],["王","おう"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":16,"text":"モアブの災難は近づいた。／そのわざわいは、すみやかに来る。","tok":[["モアブ"],["の"],["災難","さいなん"],["は"],["近づいた","ちかづいた"],["。"],["／"],["その"],["わざわい"],["は"],["、"],["すみやか"],["に"],["来る","くる"],["。"]]},{"verse":17,"text":"その回りの者、その名を知る者はみな、これのために嘆け。／「どうして力ある杖、美しい笏が砕かれたのか」／と言え。","tok":[["その"],["回り","まわり"],["の"],["者","もの"],["、"],["その"],["名","な"],["を"],["知る","しる"],["者","もの"],["は"],["みな"],["、"],["これ"],["の"],["ため"],["に"],["嘆け","なげけ"],["。"],["／"],["「"],["どう"],["して"],["力","ちから"],["ある"],["杖","つえ"],["、"],["美しい","うつくしい"],["笏","しゃく"],["が"],["砕かれた","くだかれた"],["の"],["か"],["」"],["／"],["と"],["言え","いえ"],["。"]]},{"verse":18,"text":"ディボンに住む娘よ。／栄光の座からおりて、潤いのない地にすわれ。／モアブを荒らす者が、あなたを襲い、あなたの要塞を滅ぼしたからだ。","tok":[["ディボン"],["に"],["住む","すむ"],["娘","むすめ"],["よ"],["。"],["／"],["栄光","えいこう"],["の"],["座","ざ"],["から"],["おりて"],["、"],["潤い","うるおい"],["の"],["ない"],["地","ち"],["に"],["すわれ"],["。"],["／"],["モアブ"],["を"],["荒らす","あらす"],["者","もの"],["が"],["、"],["あなた"],["を"],["襲い","おそい"],["、"],["あなた"],["の"],["要塞","ようさい"],["を"],["滅ぼした","ほろぼした"],["から"],["だ"],["。"]]},{"verse":19,"text":"アロエルに住む女よ。／道のかたわらに立って見張れ。／逃げて来る男、のがれて来る女に尋ねて、「何が起こったのか」と言え。","tok":[["アロエル"],["に"],["住む","すむ"],["女","おんな"],["よ"],["。"],["／"],["道","みち"],["の"],["かたわら"],["に"],["立って","たって"],["見張れ","みはれ"],["。"],["／"],["逃げて","にげて"],["来る","くる"],["男","おとこ"],["、"],["のがれて"],["来る","くる"],["女","おんな"],["に"],["尋ねて","たずねて"],["、"],["「"],["何","なん"],["が"],["起こった","おこった"],["の"],["か"],["」"],["と"],["言え","いえ"],["。"]]},{"verse":20,"text":"モアブは打ちのめされて、はずかしめられた。／泣きわめき、叫べ。／アルノンで、「モアブは荒らされた」と告げよ。","tok":[["モアブ"],["は"],["打ちのめされて","うちのめされて"],["、"],["はずかしめられた"],["。"],["／"],["泣きわめき","なきわめき"],["、"],["叫べ","さけべ"],["。"],["／"],["アルノン"],["で"],["、"],["「"],["モアブ"],["は"],["荒らされた","あらされた"],["」"],["と"],["告げ","つげ"],["よ"],["。"]]},{"verse":21,"text":"さばきは次の平地に来た。ホロン、ヤハツ、メファアテ、","tok":[["さばき"],["は"],["次","つぎ"],["の"],["平地","へいち"],["に"],["来た","きた"],["。"],["ホロン"],["、"],["ヤハツ"],["、"],["メファアテ"],["、"]]},{"verse":22,"text":"ディボン、ネボ、ベテ・ディブラタイム、","tok":[["ディボン"],["、"],["ネボ"],["、"],["ベテ"],["・"],["ディブラタイム"],["、"]]},{"verse":23,"text":"キルヤタイム、ベテ・ガムル、ベテ・メオン、","tok":[["キルヤタイム"],["、"],["ベテ"],["・"],["ガムル"],["、"],["ベテ"],["・"],["メオン"],["、"]]},{"verse":24,"text":"ケリヨテ、ボツラ、モアブの国の遠近のすべての町々に。","tok":[["ケリヨテ"],["、"],["ボツラ"],["、"],["モアブ"],["の"],["国","くに"],["の"],["遠近","おちこち"],["の"],["すべて"],["の"],["町々","まちまち"],["に"],["。"]]},{"verse":25,"text":"「モアブの角は切り落とされ、その腕は砕かれた。――主の御告げ――」","tok":[["「"],["モアブ"],["の"],["角","かど"],["は"],["切り落とされ","きりおとされ"],["、"],["その"],["腕","うで"],["は"],["砕かれた","くだかれた"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":26,"text":"彼を酔わせよ。主に対して高ぶったからだ。モアブは、へどを吐き散らし、彼もまた物笑いとなる。","tok":[["彼","かれ"],["を"],["酔わせ","よわせ"],["よ"],["。"],["主に","おもに"],["対して","たいして"],["高ぶった","たかぶった"],["から"],["だ"],["。"],["モアブ"],["は"],["、"],["へど"],["を"],["吐き散らし","はきちらし"],["、"],["彼","かれ"],["も"],["また"],["物笑い","ものわらい"],["と"],["なる"],["。"]]},{"verse":27,"text":"イスラエルは、あなたの物笑いではなかったのか。それとも、あなたが彼のことを語るたびごとに彼に向かって頭を振っていたのは、彼が見つけられた盗人のひとりであったためか。","tok":[["イスラエル"],["は"],["、"],["あなた"],["の"],["物笑い","ものわらい"],["で"],["は"],["なかった"],["の"],["か"],["。"],["それ"],["と"],["も"],["、"],["あなた"],["が"],["彼","かれ"],["の"],["こと"],["を"],["語る","かたる"],["たび"],["ごと"],["に"],["彼","かれ"],["に"],["向かって","むかって"],["頭","あたま"],["を"],["振って","ふって"],["いた"],["の"],["は"],["、"],["彼","かれ"],["が"],["見つけられた","みつけられた"],["盗人","ぬすびと"],["の"],["ひとり"],["で"],["あった"],["ため"],["か"],["。"]]},{"verse":28,"text":"モアブの住民よ。／町を見捨てて岩間に住め。／穴の入口のそばに巣を作る鳩のようになれ。","tok":[["モアブ"],["の"],["住民","じゅうみん"],["よ"],["。"],["／"],["町","まち"],["を"],["見捨てて","みすてて"],["岩間","いわま"],["に"],["住め","すめ"],["。"],["／"],["穴","あな"],["の"],["入口","いりぐち"],["の"],["そば"],["に"],["巣","す"],["を"],["作る","つくる"],["鳩","はと"],["の"],["よう"],["に"],["なれ"],["。"]]},{"verse":29,"text":"私たちはモアブの高ぶりを聞いた。／実に高慢だ。／その高慢、その高ぶり、その誇り、その心の高ぶりを。","tok":[["私たち","わたしたち"],["は"],["モアブ"],["の"],["高ぶり","たかぶり"],["を"],["聞いた","きいた"],["。"],["／"],["実","じつ"],["に"],["高慢","こうまん"],["だ"],["。"],["／"],["その"],["高慢","こうまん"],["、"],["その"],["高ぶり","たかぶり"],["、"],["その"],["誇り","ほこり"],["、"],["その"],["心","こころ"],["の"],["高ぶり","たかぶり"],["を"],["。"]]},{"verse":30,"text":"「わたしは、彼の高ぶりを知っている。――主の御告げ――その自慢話は正しくない。その行いも正しくない。」","tok":[["「"],["わたし"],["は"],["、"],["彼","かれ"],["の"],["高ぶり","たかぶり"],["を"],["知って","しって"],["いる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["その"],["自慢","じまん"],["話","はなし"],["は"],["正しく","ただしく"],["ない"],["。"],["その"],["行い","おこない"],["も"],["正しく","ただしく"],["ない"],["。"],["」"]]},{"verse":31,"text":"それゆえ、モアブのために私は泣きわめき、モアブ全体のために私は叫ぶ。キル・ヘレスの人々のために嘆く。","tok":[["それ"],["ゆえ"],["、"],["モアブ"],["の"],["ため"],["に"],["私","わたくし"],["は"],["泣きわめき","なきわめき"],["、"],["モアブ"],["全体","ぜんたい"],["の"],["ため"],["に"],["私","わたくし"],["は"],["叫ぶ","さけぶ"],["。"],["キル"],["・"],["ヘレス"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["嘆く","なげく"],["。"]]},{"verse":32,"text":"シブマのぶどうの木よ。／ヤゼルの涙にまさって、私はおまえのために泣く。／おまえのつるは伸びて海を越えた。／ヤゼルの海に達した。／おまえの夏のくだものとぶどうの取り入れを、荒らす者が襲った。","tok":[["シブマ"],["の"],["ぶどう"],["の"],["木","き"],["よ"],["。"],["／"],["ヤゼル"],["の"],["涙","なみだ"],["に"],["まさって"],["、"],["私","わたくし"],["は"],["おまえ"],["の"],["ため"],["に"],["泣く","なく"],["。"],["／"],["おまえ"],["の"],["つる"],["は"],["伸びて","のびて"],["海","うみ"],["を"],["越えた","こえた"],["。"],["／"],["ヤゼル"],["の"],["海","うみ"],["に"],["達した","たっした"],["。"],["／"],["おまえ"],["の"],["夏","なつ"],["の"],["くだもの"],["と"],["ぶどう"],["の"],["取り入れ","とりいれ"],["を"],["、"],["荒らす","あらす"],["者","もの"],["が"],["襲った","おそった"],["。"]]},{"verse":33,"text":"「モアブの果樹園とその国から、喜びと楽しみは取り去られ、私は酒ぶねから酒を絶やした。／喜びの声をあげてぶどうを踏む者もなく、ぶどう踏みの喜びの声は、もう喜びの声ではない。」","tok":[["「"],["モアブ"],["の"],["果樹園","かじゅえん"],["と"],["その"],["国","くに"],["から"],["、"],["喜び","よろこび"],["と"],["楽しみ","たのしみ"],["は"],["取り去られ","とりさられ"],["、"],["私","わたくし"],["は"],["酒","さか"],["ぶね"],["から"],["酒","さけ"],["を"],["絶やした","たやした"],["。"],["／"],["喜び","よろこび"],["の"],["声","こえ"],["を"],["あげて"],["ぶどう"],["を"],["踏む","ふむ"],["者","もの"],["も"],["なく"],["、"],["ぶどう"],["踏み","ふみ"],["の"],["喜び","よろこび"],["の"],["声","こえ"],["は"],["、"],["もう"],["喜び","よろこび"],["の"],["声","こえ"],["で"],["は"],["ない"],["。"],["」"]]},{"verse":34,"text":"ヘシュボンが叫んだため、その声はエルアレとヤハツまで、ツォアルからホロナイムやエグラテ・シェリシヤまで届いた。ニムリムの水さえ、荒廃した地となるからだ。","tok":[["ヘシュボン"],["が"],["叫んだ","さけんだ"],["ため"],["、"],["その"],["声","こえ"],["は"],["エルアレ"],["と"],["ヤハツ"],["まで"],["、"],["ツォアル"],["から"],["ホロナイム"],["や"],["エグラテ"],["・"],["シェリシヤ"],["まで"],["届いた","とどいた"],["。"],["ニムリム"],["の"],["水","みず"],["さえ"],["、"],["荒廃","こうはい"],["した"],["地","ち"],["と"],["なる"],["から"],["だ"],["。"]]},{"verse":35,"text":"「またわたしは、モアブの、――主の御告げ――高き所でいけにえをささげ、その神々に香をたく者を取り除く。」","tok":[["「"],["また"],["わたし"],["は"],["、"],["モアブ"],["の"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["高き","たかき"],["所","ところ"],["で"],["いけにえ"],["を"],["ささげ"],["、"],["その"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たく"],["者","もの"],["を"],["取り除く","とりのぞく"],["。"],["」"]]},{"verse":36,"text":"それゆえ、私の心はモアブのために笛のように鳴り、私の心はキル・ヘレスの人々のために笛のように鳴る。彼らの得た富も消えうせたからだ。","tok":[["それ"],["ゆえ"],["、"],["私","わたくし"],["の"],["心","こころ"],["は"],["モアブ"],["の"],["ため"],["に"],["笛","ふえ"],["の"],["よう"],["に"],["鳴り","なり"],["、"],["私","わたくし"],["の"],["心","こころ"],["は"],["キル"],["・"],["ヘレス"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["笛","ふえ"],["の"],["よう"],["に"],["鳴る","なる"],["。"],["彼","かれ"],["ら"],["の"],["得た","えた"],["富","とみ"],["も"],["消えうせた","きえうせた"],["から"],["だ"],["。"]]},{"verse":37,"text":"彼らは頭の毛をみなそり、ひげもみな切り取り、手にもみな傷をつけ、腰に荒布を着けているからだ。","tok":[["彼","かれ"],["ら"],["は"],["頭","あたま"],["の"],["毛","け"],["を"],["みなそり"],["、"],["ひげ"],["も"],["みな"],["切り取り","きりとり"],["、"],["手","て"],["に"],["も"],["みな"],["傷","きず"],["を"],["つけ"],["、"],["腰","こし"],["に"],["荒布","あらめ"],["を"],["着けて","つけて"],["いる"],["から"],["だ"],["。"]]},{"verse":38,"text":"モアブのすべての屋根の上や、広場には、ただ嘆きだけがある。「わたしがモアブを、だれにも喜ばれない器のように、砕いたからだ。――主の御告げ――」","tok":[["モアブ"],["の"],["すべて"],["の"],["屋根","やね"],["の"],["上","うえ"],["や"],["、"],["広場","ひろば"],["に"],["は"],["、"],["ただ"],["嘆き","なげき"],["だけ"],["が"],["ある"],["。"],["「"],["わたし"],["が"],["モアブ"],["を"],["、"],["だれ"],["に"],["も"],["喜ばれない","よろこばれない"],["器","うつわ"],["の"],["よう"],["に"],["、"],["砕いた","くだいた"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":39,"text":"どうしてこうも打ちのめされて、泣きわめくのか。どうして、モアブは恥を見、背を見せたのか。モアブは、その回りのすべての者の物笑いとなり、恐れとなってしまった。","tok":[["どう"],["して"],["こう"],["も"],["打ちのめされて","うちのめされて"],["、"],["泣きわめく","なきわめく"],["の"],["か"],["。"],["どう"],["して"],["、"],["モアブ"],["は"],["恥","はじ"],["を"],["見","み"],["、"],["背","せ"],["を"],["見せた","みせた"],["の"],["か"],["。"],["モアブ"],["は"],["、"],["その"],["回り","まわり"],["の"],["すべて"],["の"],["者","もの"],["の"],["物笑い","ものわらい"],["と"],["なり"],["、"],["恐れ","おそれ"],["と"],["なって"],["しまった"],["。"]]},{"verse":40,"text":"まことに、主はこう仰せられる。「見よ。彼は鷲のように飛びかかり、モアブに向かって翼を広げる。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["彼","かれ"],["は"],["鷲","わし"],["の"],["よう"],["に"],["飛びかかり","とびかかり"],["、"],["モアブ"],["に"],["向かって","むかって"],["翼","つばさ"],["を"],["広げる","ひろげる"],["。"]]},{"verse":41,"text":"町々は攻め取られ、要害は取られる。／その日、モアブの勇士の心も、産みの苦しみをする女の心のようになる。","tok":[["町々","まちまち"],["は"],["攻め取られ","せめとられ"],["、"],["要害","ようがい"],["は"],["取られる","とられる"],["。"],["／"],["その"],["日","ひ"],["、"],["モアブ"],["の"],["勇士","ゆうし"],["の"],["心","こころ"],["も"],["、"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["女","おんな"],["の"],["心","こころ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":42,"text":"モアブは滅ぼされて、民でなくなった。／主に対して高ぶったからだ。","tok":[["モアブ"],["は"],["滅ぼされて","ほろぼされて"],["、"],["民","みん"],["で"],["なくなった"],["。"],["／"],["主","ぬし"],["に対して","にたいして"],["高ぶった","たかぶった"],["から"],["だ"],["。"]]},{"verse":43,"text":"モアブの住民よ。恐れと穴とわなとが、あなたを襲う。――主の御告げ――","tok":[["モアブ"],["の"],["住民","じゅうみん"],["よ"],["。"],["恐れ","おそれ"],["と"],["穴","あな"],["と"],["わな"],["と"],["が"],["、"],["あなた"],["を"],["襲う","おそう"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":44,"text":"その恐れから逃げた者は、穴に落ち、穴から上る者は、わなに捕らえられる。／わたしがモアブに、彼らの刑罰の年を来させるからだ。／――主の御告げ――","tok":[["その"],["恐れ","おそれ"],["から"],["逃げた","にげた"],["者","もの"],["は"],["、"],["穴","あな"],["に"],["落ち","おち"],["、"],["穴","あな"],["から"],["上る","のぼる"],["者","もの"],["は"],["、"],["わな"],["に"],["捕らえられる","とらえられる"],["。"],["／"],["わたし"],["が"],["モアブ"],["に"],["、"],["彼","かれ"],["ら"],["の"],["刑罰","けいばつ"],["の"],["年","とし"],["を"],["来させる","きたさせる"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":45,"text":"ヘシュボンの陰には、のがれる者たちが力尽きて立ち止まる。／火がヘシュボンから、炎がシホンのうちから出て、モアブのこめかみと、騒がしい子らの頭の頂を焼いた。","tok":[["ヘシュボン"],["の"],["陰","かげ"],["に"],["は"],["、"],["のがれる"],["者","もの"],["たち"],["が"],["力","ちから"],["尽きて","つきて"],["立ち止まる","たちどまる"],["。"],["／"],["火","ひ"],["が"],["ヘシュボン"],["から"],["、"],["炎","ほのお"],["が"],["シホン"],["の"],["うち"],["から"],["出て","でて"],["、"],["モアブ"],["の"],["こめかみ"],["と"],["、"],["騒がしい","さわがしい"],["子","こ"],["ら"],["の"],["頭","あたま"],["の"],["頂","いただき"],["を"],["焼いた","やいた"],["。"]]},{"verse":46,"text":"ああ。モアブ。／ケモシュの民は滅びた。／あなたの息子はとりこにされ、娘は捕虜になって連れ去られた。","tok":[["ああ"],["。"],["モアブ"],["。"],["／"],["ケモシュ"],["の"],["民","たみ"],["は"],["滅びた","ほろびた"],["。"],["／"],["あなた"],["の"
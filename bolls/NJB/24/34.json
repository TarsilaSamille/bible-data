[{"verse":1,"text":"バビロンの王ネブカデレザルと、その全軍勢、および彼の支配下にある地のすべての王国とすべての国々の民が、エルサレムとそのすべての町々を攻めていたとき、主からエレミヤにあったみことばは、こうである。","tok":[["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["と"],["、"],["その"],["全","ぜん"],["軍勢","ぐんぜい"],["、"],["および"],["彼","かれ"],["の"],["支配下","しはいか"],["に"],["ある"],["地","ち"],["の"],["すべて"],["の"],["王国","おうこく"],["と"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["、"],["エルサレム"],["と"],["その"],["すべて"],["の"],["町々","まちまち"],["を"],["攻めて","せめて"],["いた"],["とき"],["、"],["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["は"],["、"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"「イスラエルの神、主は、こう仰せられる。行って、ユダの王ゼデキヤに告げて言え。／主はこう仰せられる。『見よ。わたしはこの町をバビロンの王の手に渡す。彼はこれを火で焼こう。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["行って","いって"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["／"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["この"],["町","まち"],["を"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["これ"],["を"],["火","ひ"],["で"],["焼こう","やこう"],["。"]]},{"verse":3,"text":"あなたはその手からのがれることができない。あなたは必ず捕らえられて、彼の手に渡されるからだ。あなたの目はバビロンの王の目を見、彼の口はあなたの口と語り、あなたはバビロンへ行く。』","tok":[["あなた"],["は"],["その"],["手","て"],["から"],["のがれる"],["こと"],["が"],["できない"],["。"],["あなた"],["は"],["必ず","かならず"],["捕らえられて","とらえられて"],["、"],["彼","かれ"],["の"],["手","て"],["に"],["渡される","わたされる"],["から"],["だ"],["。"],["あなた"],["の"],["目","め"],["は"],["バビロン"],["の"],["王","おう"],["の"],["目","め"],["を"],["見","み"],["、"],["彼","かれ"],["の"],["口","くち"],["は"],["あなた"],["の"],["口","くち"],["と"],["語り","かたり"],["、"],["あなた"],["は"],["バビロン"],["へ"],["行く","いく"],["。"],["』"]]},{"verse":4,"text":"ユダの王ゼデキヤ。ただ、主のことばを聞きなさい。主はあなたについてこう仰せられる。『あなたは剣で死ぬことはない。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["。"],["ただ"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["聞き","きき"],["なさい"],["。"],["主","ぬし"],["は"],["あなた"],["について"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["は"],["剣","けん"],["で"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":5,"text":"あなたは安らかに死んで、人々は、あなたの先祖たち、あなたの先にいた王たちのために香をたいたように、あなたのためにも香をたき、ああ主君よと言ってあなたをいたむ。このことを語るのはわたしだ。』――主の御告げ――」","tok":[["あなた"],["は"],["安らか","やすらか"],["に"],["死んで","しんで"],["、"],["人々","ひとびと"],["は"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["、"],["あなた"],["の"],["先","さき"],["に"],["いた"],["王","おう"],["たち"],["の"],["ため"],["に"],["香","こう"],["を"],["たいた"],["よう"],["に"],["、"],["あなた"],["の"],["ため"],["に"],["も"],["香","こう"],["を"],["たき"],["、"],["ああ"],["主君","しゅくん"],["よ"],["と"],["言って","いって"],["あなた"],["を"],["いたむ"],["。"],["この"],["こと"],["を"],["語る","かたる"],["の"],["は"],["わたし"],["だ"],["。"],["』"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":6,"text":"そこで預言者エレミヤは、これらすべてのことばを、エルサレムでユダの王ゼデキヤに語った。","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["、"],["これ"],["ら"],["すべて"],["の"],["ことば"],["を"],["、"],["エルサレム"],["で"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["に"],["語った","かたった"],["。"]]},{"verse":7,"text":"そのとき、バビロンの王の軍勢は、エルサレムとユダの残されたすべての町、ラキシュとアゼカを攻めていた。これらがユダの町々で城壁のある町として残っていたからである。","tok":[["その"],["とき"],["、"],["バビロン"],["の"],["王","おう"],["の"],["軍勢","ぐんぜい"],["は"],["、"],["エルサレム"],["と"],["ユダ"],["の"],["残された","のこされた"],["すべて"],["の"],["町","まち"],["、"],["ラキシュ"],["と"],["アゼカ"],["を"],["攻めて","せめて"],["いた"],["。"],["これ"],["ら"],["が"],["ユダ"],["の"],["町々","まちまち"],["で"],["城壁","じょうへき"],["の"],["ある"],["町","まち"],["として"],["残って","のこって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"ゼデキヤ王がエルサレムにいるすべての民と契約を結んで、彼らに奴隷の解放を宣言して後、主からエレミヤにあったみことば。","tok":[["ゼデキヤ"],["王","おう"],["が"],["エルサレム"],["に"],["いる"],["すべて"],["の"],["民","たみ"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["、"],["彼","かれ"],["ら"],["に"],["奴隷","どれい"],["の"],["解放","かいほう"],["を"],["宣言","せんげん"],["して"],["後","あと"],["、"],["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["。"]]},{"verse":9,"text":"――それは各自が、ヘブル人である自分の奴隷や女奴隷を自由の身にし、同胞のユダヤ人を奴隷にしないという契約であった。","tok":[["―"],["―"],["それ"],["は"],["各自","かくじ"],["が"],["、"],["ヘブル人","へぶるにん"],["で"],["ある"],["自分","じぶん"],["の"],["奴隷","どれい"],["や"],["女","じょ"],["奴隷","どれい"],["を"],["自由","じゆう"],["の"],["身","み"],["に"],["し"],["、"],["同胞","どうほう"],["の"],["ユダヤ人","ゆだやじん"],["を"],["奴隷","どれい"],["に"],["しない"],["と"],["いう"],["契約","けいやく"],["で"],["あった"],["。"]]},{"verse":10,"text":"契約に加入したすべての首長、すべての民は、それぞれ、自分の奴隷や女奴隷を自由の身にして、二度と彼らを奴隷にしないことに同意し、同意してから彼らを去らせた。","tok":[["契約","けいやく"],["に"],["加入","かにゅう"],["した"],["すべて"],["の"],["首長","しゅちょう"],["、"],["すべて"],["の"],["民","たみ"],["は"],["、"],["それぞれ"],["、"],["自分","じぶん"],["の"],["奴隷","どれい"],["や"],["女","じょ"],["奴隷","どれい"],["を"],["自由","じゆう"],["の"],["身","み"],["に"],["して"],["、"],["二","に"],["度","ど"],["と"],["彼","かれ"],["ら"],["を"],["奴隷","どれい"],["に"],["しない"],["こと"],["に"],["同意","どうい"],["し"],["、"],["同意","どうい"],["して"],["から"],["彼","かれ"],["ら"],["を"],["去らせた","さらせた"],["。"]]},{"verse":11,"text":"しかし、彼らは、そのあとで心を翻した。そして、いったん自由の身にした奴隷や女奴隷を連れ戻して、彼らを奴隷や女奴隷として使役した。――","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["、"],["その"],["あと"],["で"],["心","こころ"],["を"],["翻した","ひるがえした"],["。"],["そして"],["、"],["いったん"],["自由","じゆう"],["の"],["身","み"],["に"],["した"],["奴隷","どれい"],["や"],["女","じょ"],["奴隷","どれい"],["を"],["連れ戻して","つれもどして"],["、"],["彼","かれ"],["ら"],["を"],["奴隷","どれい"],["や"],["女","じょ"],["奴隷","どれい"],["として"],["使役","しえき"],["した"],["。"],["―"],["―"]]},{"verse":12,"text":"そこで、主からエレミヤに次のような主のことばがあった。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["から"],["エレミヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":13,"text":"「イスラエルの神、主は、こう仰せられる。『わたしが、あなたがたの先祖をエジプトの国、奴隷の家から連れ出した日に、わたしは彼らと契約を結んで言った。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["が"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["国","くに"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["連れ出した","つれだした"],["日","ひ"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["言った","いった"],["。"]]},{"verse":14,"text":"七年の終わりには、各自、自分のところに売られて来た同胞のヘブル人を去らせなければならない。六年の間、あなたに仕えさせ、その後、あなたは彼を自由の身にせよと。しかし、あなたがたの先祖は、わたしに聞かず、耳を傾けなかった。","tok":[["七","なな"],["年","ねん"],["の"],["終わり","おわり"],["に"],["は"],["、"],["各自","かくじ"],["、"],["自分","じぶん"],["の"],["ところ"],["に"],["売られて","うられて"],["来た","きた"],["同胞","どうほう"],["の"],["ヘブル人","へぶるにん"],["を"],["去らせなければ","さらせなければ"],["ならない"],["。"],["六","ろく"],["年","ねん"],["の"],["間","あいだ"],["、"],["あなた"],["に"],["仕えさせ","つかえさせ"],["、"],["その"],["後","ご"],["、"],["あなた"],["は"],["彼","かれ"],["を"],["自由","じゆう"],["の"],["身","み"],["に"],["せよ"],["と"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["は"],["、"],["わたし"],["に"],["聞かず","きかず"],["、"],["耳","みみ"],["を"],["傾けなかった","かたむけなかった"],["。"]]},{"verse":15,"text":"しかし、あなたがたは、きょう悔い改め、各自、隣人の解放を告げてわたしが正しいと見ることを行い、わたしの名がつけられているこの家で、わたしの前に契約を結んだ。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["きょう"],["悔い改め","くいあらため"],["、"],["各自","かくじ"],["、"],["隣人","りんじん"],["の"],["解放","かいほう"],["を"],["告げて","つげて"],["わたし"],["が"],["正しい","ただしい"],["と"],["見る","みる"],["こと"],["を"],["行い","おこない"],["、"],["わたし"],["の"],["名","な"],["が"],["つけられて"],["いる"],["この"],["家","いえ"],["で"],["、"],["わたし"],["の"],["前","まえ"],["に"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":16,"text":"それなのに、あなたがたは心を翻して、わたしの名を汚し、いったん自由の身にした奴隷や女奴隷をかってに連れ戻し、彼らをあなたがたの奴隷や女奴隷として使役した。』","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["心","こころ"],["を"],["翻して","ひるがえして"],["、"],["わたし"],["の"],["名","な"],["を"],["汚し","よごし"],["、"],["いったん"],["自由","じゆう"],["の"],["身","み"],["に"],["した"],["奴隷","どれい"],["や"],["女","じょ"],["奴隷","どれい"],["を"],["かって"],["に"],["連れ戻し","つれもどし"],["、"],["彼","かれ"],["ら"],["を"],["あなた"],["がた"],["の"],["奴隷","どれい"],["や"],["女","じょ"],["奴隷","どれい"],["として"],["使役","しえき"],["した"],["。"],["』"]]},{"verse":17,"text":"それゆえ、主はこう仰せられる。『あなたがたはわたしに聞き従わず、各自、自分の同胞や隣人に解放を告げなかったので、見よ、わたしはあなたがたに――主の御告げ――剣と疫病とききんの解放を宣言する。わたしは、あなたがたを地のすべての王国のおののきとする。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["がた"],["は"],["わたし"],["に"],["聞き従わず","ききしたがわず"],["、"],["各自","かくじ"],["、"],["自分","じぶん"],["の"],["同胞","どうほう"],["や"],["隣人","りんじん"],["に"],["解放","かいほう"],["を"],["告げなかった","つげなかった"],["ので"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["剣","けん"],["と"],["疫病","やくびょう"],["と"],["ききん"],["の"],["解放","かいほう"],["を"],["宣言","せんげん"],["する"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["地","ち"],["の"],["すべて"],["の"],["王国","おうこく"],["の"],["おののき"],["と"],["する"],["。"]]},{"verse":18,"text":"また、わたしの前で結んだ契約のことばを守らず、わたしの契約を破った者たちを、二つに断ち切られた子牛の間を通った者のようにする。","tok":[["また"],["、"],["わたし"],["の"],["前","まえ"],["で"],["結んだ","むすんだ"],["契約","けいやく"],["の"],["ことば"],["を"],["守らず","まもらず"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["破った","やぶった"],["者","もの"],["たち"],["を"],["、"],["二","ふた"],["つ"],["に"],["断ち切られた","たちきられた"],["子牛","こうし"],["の"],["間","あいだ"],["を"],["通った","とおった"],["者","もの"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":19,"text":"二つに分けた子牛の間を通った者は、ユダの首長たち、エルサレムの首長たち、宦官と祭司と一般の全民衆であった。","tok":[["二","ふた"],["つ"],["に"],["分けた","わけた"],["子牛","こうし"],["の"],["間","あいだ"],["を"],["通った","とおった"],["者","もの"],["は"],["、"],["ユダ"],["の"],["首長","しゅちょう"],["たち"],["、"],["エルサレム"],["の"],["首長","しゅちょう"],["たち"],["、"],["宦官","かんがん"],["と"],["祭司","さいし"],["と"],["一般","いっぱん"],["の"],["全","ぜん"],["民衆","みんしゅう"],["で"],["あった"],["。"]]},{"verse":20,"text":"わたしは彼らを、敵の手、いのちをねらう者たちの手に渡す。そのしかばねは空の鳥、地の獣のえじきとなる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["敵","てき"],["の"],["手","て"],["、"],["いのち"],["を"],["ねらう"],["者","もの"],["たち"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["その"],["しかばね"],["は"],["空","そら"],["の"],["鳥","とり"],["、"],["地","ち"],["の"],["獣","けもの"],["の"],["えじき"],["と"],["なる"],["。"]]},{"verse":21,"text":"わたしはまた、ユダの王ゼデキヤとそのつかさたちを敵の手、いのちをねらう者たちの手、あなたがたのところから退却したバビロンの王の軍勢の手に渡す。","tok":[["わたし"],["は"],["また"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["と"],["その"],["つかさ"],["たち"],["を"],["敵","てき"],["の"],["手","て"],["、"],["いのち"],["を"],["ねらう"],["者","もの"],["たち"],["の"],["手","て"],["、"],["あなた"],["がた"],["の"],["ところ"],["から"],["退却","たいきゃく"],["した"],["バビロン"],["の"],["王","おう"],["の"],["軍勢","ぐんぜい"],["の"],["手","て"],["に"],["渡す","わたす"],["。"]]},{"verse":22,"text":"見よ。わたしは命じ、――主の御告げ――彼らをこの町に引き返させる。彼らはこの町を攻め、これを取り、火で焼く。わたしはユダの町々を、住む者もいない荒れ果てた地とする。』」","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["命じ","めいじ"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["彼","かれ"],["ら"],["を"],["この"],["町","まち"],["に"],["引き返させる","ひきかえさせる"],["。"],["彼","かれ"],["ら"],["は"],["この"],["町","まち"],["を"],["攻め","せめ"],["、"],["これ"],["を"],["取り","とり"],["、"],["火","ひ"],["で"],["焼く","やく"],["。"],["わたし"],["は"],["ユダ"],["の"],["町々","まちまち"],["を"],["、"],["住む","すむ"],["者","もの"],["も"],["いない"],["荒れ果てた","あれはてた"],["地","ち"],["と"],["する"],["。"],["』"],["」"]]}]
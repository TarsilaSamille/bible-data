[{"verse":1,"text":"ヨシヤの子ゼデキヤは、エホヤキムの子エコヌヤに代わって王となった。バビロンの王ネブカデレザルが彼をユダの国の王にしたのである。","tok":[["ヨシヤ"],["の"],["子","こ"],["ゼデキヤ"],["は"],["、"],["エホヤキム"],["の"],["子","こ"],["エコヌヤ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["彼","かれ"],["を"],["ユダ"],["の"],["国","くに"],["の"],["王","おう"],["に"],["した"],["ので"],["ある"],["。"]]},{"verse":2,"text":"彼も、その家来たちも、一般の民衆も、預言者エレミヤによって語られた主のことばに聞き従わなかった。","tok":[["彼","かれ"],["も"],["、"],["その"],["家来","けらい"],["たち"],["も"],["、"],["一般","いっぱん"],["の"],["民衆","みんしゅう"],["も"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["によって"],["語られた","かたられた"],["主","ぬし"],["の"],["ことば"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"]]},{"verse":3,"text":"ゼデキヤ王は、シェレムヤの子エフカルと、マアセヤの子、祭司ゼパニヤを預言者エレミヤのもとに遣わして言った。「どうか、私たちのために、私たちの神、主に、祈ってください。」","tok":[["ゼデキヤ"],["王","おう"],["は"],["、"],["シェレムヤ"],["の"],["子","こ"],["エフカル"],["と"],["、"],["マアセヤ"],["の"],["子","こ"],["、"],["祭司","さいし"],["ゼパニヤ"],["を"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["もと"],["に"],["遣わして","つかわして"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["祈って","いのって"],["ください"],["。"],["」"]]},{"verse":4,"text":"――そのとき、エレミヤは民のうちに出入りしていて、まだ獄屋に入れられていなかった。","tok":[["―"],["―"],["その"],["とき"],["、"],["エレミヤ"],["は"],["民","みん"],["の"],["うち"],["に"],["出入り","でいり"],["して"],["いて"],["、"],["まだ"],["獄屋","ごくや"],["に"],["入れられて","いれられて"],["いなかった"],["。"]]},{"verse":5,"text":"パロの軍勢がエジプトから出て来たので、エルサレムを包囲中のカルデヤ人は、そのうわさを聞いて、エルサレムから退却したときであった。――","tok":[["パロ"],["の"],["軍勢","ぐんぜい"],["が"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["ので"],["、"],["エルサレム"],["を"],["包囲中","ほういちゅう"],["の"],["カルデヤ"],["人","にん"],["は"],["、"],["その"],["うわさ"],["を"],["聞いて","きいて"],["、"],["エルサレム"],["から"],["退却","たいきゃく"],["した"],["とき"],["で"],["あった"],["。"],["―"],["―"]]},{"verse":6,"text":"そのとき、預言者エレミヤに次のような主のことばがあった。","tok":[["その"],["とき"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":7,"text":"「イスラエルの神、主は、こう仰せられる。『わたしに尋ねるために、あなたがたをわたしのもとに遣わしたユダの王にこう言え。見よ。あなたがたを助けに出て来たパロの軍勢は、自分たちの国エジプトへ帰り、","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["に"],["尋ねる","たずねる"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["わたし"],["の"],["もと"],["に"],["遣わした","つかわした"],["ユダ"],["の"],["王","おう"],["に"],["こう"],["言え","いえ"],["。"],["見","み"],["よ"],["。"],["あなた"],["がた"],["を"],["助け","たすけ"],["に"],["出て","でて"],["来た","きた"],["パロ"],["の"],["軍勢","ぐんぜい"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["国","くに"],["エジプト"],["へ"],["帰り","かえり"],["、"]]},{"verse":8,"text":"カルデヤ人が引き返して来て、この町を攻め取り、これを火で焼く。』","tok":[["カルデヤ"],["人","ひと"],["が"],["引き返して","ひきかえして"],["来て","きて"],["、"],["この"],["町","まち"],["を"],["攻め取り","せめとり"],["、"],["これ"],["を"],["火","ひ"],["で"],["焼く","やく"],["。"],["』"]]},{"verse":9,"text":"主はこう仰せられる。『あなたがたは、カルデヤ人は必ず私たちから去る、と言って、みずから欺くな。彼らは去ることはないからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["がた"],["は"],["、"],["カルデヤ"],["人","にん"],["は"],["必ず","かならず"],["私たち","わたしたち"],["から"],["去る","さる"],["、"],["と"],["言って","いって"],["、"],["みずから"],["欺く","あざむく"],["な"],["。"],["彼","かれ"],["ら"],["は"],["去る","さる"],["こと"],["は"],["ない"],["から"],["だ"],["。"]]},{"verse":10,"text":"たとい、あなたがたが、あなたがたを攻めるカルデヤの全軍勢を打ち、その中に重傷を負った兵士たちだけが残ったとしても、彼らがそれぞれ、その天幕で立ち上がり、この町を火で焼くようになる。』」","tok":[["たとい"],["、"],["あなた"],["が"],["た"],["が"],["、"],["あなた"],["がた"],["を"],["攻める","せめる"],["カルデヤ"],["の"],["全","ぜん"],["軍勢","ぐんぜい"],["を"],["打ち","うち"],["、"],["その"],["中","なか"],["に"],["重傷","じゅうしょう"],["を"],["負った","おった"],["兵士","へいし"],["たち"],["だけ"],["が"],["残った","のこった"],["として"],["も"],["、"],["彼","かれ"],["ら"],["が"],["それぞれ"],["、"],["その"],["天幕","てんまく"],["で"],["立ち上がり","たちあがり"],["、"],["この"],["町","まち"],["を"],["火","ひ"],["で"],["焼く","やく"],["よう"],["に"],["なる"],["。"],["』"],["」"]]},{"verse":11,"text":"カルデヤの軍勢がパロの軍勢の来るのを聞いてエルサレムから退却したとき、","tok":[["カルデヤ"],["の"],["軍勢","ぐんぜい"],["が"],["パロ"],["の"],["軍勢","ぐんぜい"],["の"],["来る","くる"],["の"],["を"],["聞いて","きいて"],["エルサレム"],["から"],["退却","たいきゃく"],["した"],["とき"],["、"]]},{"verse":12,"text":"エレミヤは、ベニヤミンの地に行き、民の間で割り当ての地を決めるためにエルサレムから出て行った。","tok":[["エレミヤ"],["は"],["、"],["ベニヤミン"],["の"],["地","ち"],["に"],["行き","いき"],["、"],["民","みん"],["の"],["間","あいだ"],["で"],["割り当て","わりあて"],["の"],["地","ち"],["を"],["決める","きめる"],["ため"],["に"],["エルサレム"],["から"],["出て","でて"],["行った","いった"],["。"]]},{"verse":13,"text":"彼がベニヤミンの門に来たとき、そこにハナヌヤの子シェレムヤの子のイルイヤという名の当直の者がいて、「あなたはカルデヤ人のところへ落ちのびるのか」と言って、預言者エレミヤを捕らえた。","tok":[["彼","かれ"],["が"],["ベニヤミン"],["の"],["門","もん"],["に"],["来た","きた"],["とき"],["、"],["そこ"],["に"],["ハナヌヤ"],["の"],["子","こ"],["シェレムヤ"],["の"],["子","こ"],["の"],["イルイヤ"],["と"],["いう"],["名","な"],["の"],["当直","とうちょく"],["の"],["者","もの"],["が"],["いて"],["、"],["「"],["あなた"],["は"],["カルデヤ"],["人","にん"],["の"],["ところ"],["へ"],["落ちのびる","おちのびる"],["の"],["か"],["」"],["と"],["言って","いって"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["を"],["捕らえた","とらえた"],["。"]]},{"verse":14,"text":"エレミヤは、「違う。私はカルデヤ人のところに落ちのびるのではない」と言ったが、イルイヤは聞かず、エレミヤを捕らえて、首長たちのところに連れて行った。","tok":[["エレミヤ"],["は"],["、"],["「"],["違う","ちがう"],["。"],["私","わたくし"],["は"],["カルデヤ"],["人","にん"],["の"],["ところ"],["に"],["落ちのびる","おちのびる"],["ので"],["は"],["ない"],["」"],["と"],["言った","いった"],["が"],["、"],["イルイヤ"],["は"],["聞かず","きかず"],["、"],["エレミヤ"],["を"],["捕らえて","とらえて"],["、"],["首長","しゅちょう"],["たち"],["の"],["ところ"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":15,"text":"首長たちはエレミヤに向かって激しく怒り、彼を打ちたたき、書記ヨナタンの家にある牢屋に入れた。そこを獄屋にしていたからである。","tok":[["首長","しゅちょう"],["たち"],["は"],["エレミヤ"],["に"],["向かって","むかって"],["激しく","はげしく"],["怒り","おこり"],["、"],["彼","かれ"],["を"],["打ちたたき","うちたたき"],["、"],["書記","しょき"],["ヨナタン"],["の"],["家","いえ"],["に"],["ある"],["牢屋","ろうや"],["に"],["入れた","いれた"],["。"],["そこ"],["を"],["獄屋","ごくや"],["に"],["して"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"エレミヤは丸天井の地下牢に入れられ、長い間そこにいた。","tok":[["エレミヤ"],["は"],["丸","まる"],["天井","てんじょう"],["の"],["地下","ちか"],["牢","ろう"],["に"],["入れられ","いれられ"],["、"],["長い","ながい"],["間","あいだ"],["そこ"],["に"],["いた"],["。"]]},{"verse":17,"text":"ゼデキヤ王は人をやって彼を召し寄せた。王は自分の家でひそかに彼に尋ねて言った。「主から、みことばがあったか。」エレミヤは、「ありました」と言った。そして「あなたはバビロンの王の手に渡されます」と言った。","tok":[["ゼデキヤ"],["王","おう"],["は"],["人","ひと"],["を"],["やって"],["彼","かれ"],["を"],["召し寄せた","めしよせた"],["。"],["王","おう"],["は"],["自分","じぶん"],["の"],["家","いえ"],["で"],["ひそか"],["に"],["彼","かれ"],["に"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["主","ぬし"],["から"],["、"],["みことば"],["が"],["あった"],["か"],["。"],["」"],["エレミヤ"],["は"],["、"],["「"],["ありました"],["」"],["と"],["言った","いった"],["。"],["そして"],["「"],["あなた"],["は"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡されます","わたされます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"エレミヤはゼデキヤ王に言った。「あなたや、あなたの家来たちや、この民に、私が何の罪を犯したというので、私を獄屋に入れたのですか。","tok":[["エレミヤ"],["は"],["ゼデキヤ"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["あなた"],["や"],["、"],["あなた"],["の"],["家来","けらい"],["たち"],["や"],["、"],["この"],["民","たみ"],["に"],["、"],["私","わたくし"],["が"],["何","なん"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["と"],["いう"],["ので"],["、"],["私","わたくし"],["を"],["獄屋","ごくや"],["に"],["入れた","いれた"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"あなたがたに『バビロンの王は、あなたがたと、この国とを攻めに来ない』と言って預言した、あなたがたの預言者たちは、どこにいますか。","tok":[["あなた"],["がた"],["に"],["『"],["バビロン"],["の"],["王","おう"],["は"],["、"],["あなた"],["がた"],["と"],["、"],["この"],["国","くに"],["と"],["を"],["攻め","せめ"],["に"],["来ない","こない"],["』"],["と"],["言って","いって"],["預言","よげん"],["した"],["、"],["あなた"],["がた"],["の"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["どこ"],["に"],["います"],["か"],["。"]]},{"verse":20,"text":"今、王さま、どうぞ聞いてください。どうぞ、私の願いを御前にかなえて、私を書記ヨナタンの家へ帰らせないでください。そうすれば、私はあそこで死ぬことはないでしょう。」","tok":[["今","いま"],["、"],["王","おう"],["さま"],["、"],["どうぞ"],["聞いて","きいて"],["ください"],["。"],["どうぞ"],["、"],["私","わたくし"],["の"],["願い","ねがい"],["を"],["御前","ごぜん"],["に"],["かなえて"],["、"],["私","わたくし"],["を"],["書記","しょき"],["ヨナタン"],["の"],["家","いえ"],["へ"],["帰らせないで","かえらせないで"],["ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["は"],["あそこ"],["で"],["死ぬ","しぬ"],["こと"],["は"],["ないでしょう"],["。"],["」"]]},{"verse":21,"text":"そこでゼデキヤ王は命じて、エレミヤを監視の庭に入れさせ、町からすべてのパンが絶えるまで、パン屋街から、毎日パン一個を彼に与えさせた。こうして、エレミヤは監視の庭にとどまっていた。","tok":[["そこ"],["で"],["ゼデキヤ"],["王","おう"],["は"],["命じて","めいじて"],["、"],["エレミヤ"],["を"],["監視","かんし"],["の"],["庭","にわ"],["に"],["入れさせ","いれさせ"],["、"],["町","まち"],["から"],["すべて"],["の"],["パン"],["が"],["絶える","たえる"],["まで"],["、"],["パン屋街","ぱんやがい"],["から"],["、"],["毎日","まいにち"],["パン"],["一個","いちこ"],["を"],["彼","かれ"],["に"],["与えさせた","あたえさせた"],["。"],["こう"],["して"],["、"],["エレミヤ"],["は"],["監視","かんし"],["の"],["庭","にわ"],["に"],["とどまって"],["いた"],["。"]]}]
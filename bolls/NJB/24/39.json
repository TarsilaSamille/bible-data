[{"verse":1,"text":"ユダの王ゼデキヤの第九年、その第十の月に、バビロンの王ネブカデレザルは、その全軍勢を率いてエルサレムに攻めて来て、これを包囲した。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["第","だい"],["九","きゅう"],["年","ねん"],["、"],["その"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["は"],["、"],["その"],["全","ぜん"],["軍勢","ぐんぜい"],["を"],["率いて","ひきいて"],["エルサレム"],["に"],["攻めて","せめて"],["来て","きて"],["、"],["これ"],["を"],["包囲","ほうい"],["した"],["。"]]},{"verse":2,"text":"ゼデキヤの第十一年、第四の月の九日に、町は破られた。","tok":[["ゼデキヤ"],["の"],["第","だい"],["十一","じゅういち"],["年","ねん"],["、"],["第","だい"],["四","よん"],["の"],["月","つき"],["の"],["九日","ここのか"],["に"],["、"],["町","まち"],["は"],["破られた","やぶられた"],["。"]]},{"verse":3,"text":"そのとき、バビロンの王のすべての首長たちが入って来て、中央の門に座を占めた。すなわち、ネルガル・サル・エツェル、サムガル・ネブ、ラブ・サリスのサル・セキム、ラブ・マグのネルガル・サル・エツェル、およびバビロンの王の首長の残り全員である。","tok":[["その"],["とき"],["、"],["バビロン"],["の"],["王","おう"],["の"],["すべて"],["の"],["首長","しゅちょう"],["たち"],["が"],["入って","はいって"],["来て","きて"],["、"],["中央","ちゅうおう"],["の"],["門","もん"],["に"],["座","ざ"],["を"],["占めた","しめた"],["。"],["すなわち"],["、"],["ネルガル"],["・"],["サル"],["・"],["エツェル"],["、"],["サムガル"],["・"],["ネブ"],["、"],["ラブ"],["・"],["サリス"],["の"],["サル"],["・"],["セキム"],["、"],["ラブ"],["・"],["マグ"],["の"],["ネルガル"],["・"],["サル"],["・"],["エツェル"],["、"],["および"],["バビロン"],["の"],["王","おう"],["の"],["首長","しゅちょう"],["の"],["残り","のこり"],["全員","ぜんいん"],["で"],["ある"],["。"]]},{"verse":4,"text":"ユダの王ゼデキヤとすべての戦士は、彼らを見て逃げ、夜の間に、王の園の道伝いに、二重の城壁の間の門を通って町を出、アラバへの道に出た。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["と"],["すべて"],["の"],["戦士","せんし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["見て","みて"],["逃げ","にげ"],["、"],["夜","よる"],["の"],["間","あいだ"],["に"],["、"],["王","おう"],["の"],["園","その"],["の"],["道伝い","みちつたい"],["に"],["、"],["二","に"],["重","じゅう"],["の"],["城壁","じょうへき"],["の"],["間","あいだ"],["の"],["門","もん"],["を"],["通って","とおって"],["町","まち"],["を"],["出","で"],["、"],["アラバ"],["へ"],["の"],["道","みち"],["に"],["出た","でた"],["。"]]},{"verse":5,"text":"しかし、カルデヤの軍勢は彼らのあとを追い、エリコの草原でゼデキヤに追いつき、彼を捕らえて、ハマテの地のリブラにいるバビロンの王ネブカデレザルのもとに連れ上った。そこで、王は彼に宣告を下した。","tok":[["しかし"],["、"],["カルデヤ"],["の"],["軍勢","ぐんぜい"],["は"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追い","おい"],["、"],["エリコ"],["の"],["草原","そうげん"],["で"],["ゼデキヤ"],["に"],["追いつき","おいつき"],["、"],["彼","かれ"],["を"],["捕らえて","とらえて"],["、"],["ハマテ"],["の"],["地","ち"],["の"],["リブラ"],["に"],["いる"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["もと"],["に"],["連れ上った","つれのぼった"],["。"],["そこ"],["で"],["、"],["王","おう"],["は"],["彼","かれ"],["に"],["宣告","せんこく"],["を"],["下した","くだした"],["。"]]},{"verse":6,"text":"バビロンの王はリブラで、ゼデキヤの子たちをその目の前で虐殺し、またユダのおもだった人たちもみな虐殺し、","tok":[["バビロン"],["の"],["王","おう"],["は"],["リブラ"],["で"],["、"],["ゼデキヤ"],["の"],["子","こ"],["たち"],["を"],["その"],["目","め"],["の"],["前","まえ"],["で"],["虐殺","ぎゃくさつ"],["し"],["、"],["また"],["ユダ"],["の"],["おも"],["だった"],["人","ひと"],["たち"],["も"],["みな"],["虐殺","ぎゃくさつ"],["し"],["、"]]},{"verse":7,"text":"ゼデキヤの目をつぶし、彼を青銅の足かせにつないで、バビロンに連れて行った。","tok":[["ゼデキヤ"],["の"],["目","め"],["を"],["つぶし"],["、"],["彼","かれ"],["を"],["青銅","せいどう"],["の"],["足かせ","あしかせ"],["に"],["つないで"],["、"],["バビロン"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":8,"text":"カルデヤ人は、王宮も民の家も火で焼き、エルサレムの城壁を取りこわした。","tok":[["カルデヤ"],["人","にん"],["は"],["、"],["王宮","おうきゅう"],["も"],["民","みん"],["の"],["家","いえ"],["も"],["火","ひ"],["で"],["焼き","やき"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["取りこわした","とりこわした"],["。"]]},{"verse":9,"text":"侍従長ネブザルアダンは、町に残されていた残りの民と、王に降伏した投降者たちと、そのほかの残されていた民を、バビロンへ捕らえ移した。","tok":[["侍従長","じじゅうちょう"],["ネブザルアダン"],["は"],["、"],["町","まち"],["に"],["残されて","のこされて"],["いた"],["残り","のこり"],["の"],["民","たみ"],["と"],["、"],["王","おう"],["に"],["降伏","こうふく"],["した"],["投降者","とうこうしゃ"],["たち"],["と"],["、"],["その"],["ほか"],["の"],["残されて","のこされて"],["いた"],["民","たみ"],["を"],["、"],["バビロン"],["へ"],["捕らえ","とらえ"],["移した","うつした"],["。"]]},{"verse":10,"text":"しかし侍従長ネブザルアダンは、何も持たない貧民の一部をユダの地に残し、その日、彼らにぶどう畑と畑を与えた。","tok":[["しかし"],["侍従長","じじゅうちょう"],["ネブザルアダン"],["は"],["、"],["何","なん"],["も"],["持たない","もたない"],["貧民","ひんみん"],["の"],["一部","いちぶ"],["を"],["ユダ"],["の"],["地","ち"],["に"],["残し","のこし"],["、"],["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["に"],["ぶどう"],["畑","はたけ"],["と"],["畑","はたけ"],["を"],["与えた","あたえた"],["。"]]},{"verse":11,"t
おせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["この"],["町","まち"],["に"],["わたし"],["の"],["ことば"],["を"],["実現","じつげん"],["する"],["。"],["幸い","さいわい"],["の"],["ため"],["で"],["は"],["なく"],["、"],["わざわい"],["の"],["ため"],["だ"],["。"],["それ"],["ら"],["は"],["、"],["その"],["日","ひ"],["、"],["あなた"],["の"],["前","まえ"],["で"],["起こる","おこる"],["。"]]},{"verse":17,"text":"しかしその日、わたしはあなたを救い出す。――主の御告げ――あなたはあなたが恐れている者たちの手に渡されることはない。","tok":[["しかし"],["その"],["日","ひ"],["、"],["わたし"],["は"],["あなた"],["を"],["救い出す","すくいだす"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["あなた"],["は"],["あなた"],["が"],["恐れて","おそれて"],["いる"],["者","もの"],["たち"],["の"],["手","て"],["に"],["渡される","わたされる"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"わたしは必ずあなたを助け出す。あなたは剣に倒れず、あなたのいのちはあなたの分捕り物としてあなたのものになる。それは、あなたがわたしに信頼したからだ。――主の御告げ――』」","tok":[["わたし"],["は"],["必ず","かならず"],["あなた"],["を"],["助け出す","たすけだす"],["。"],["あなた"],["は"],["剣","けん"],["に"],["倒れず","たおれず"],["、"],["あなた"],["の"],["いのち"],["は"],["あなた"],["の"],["分","ぶん"],["捕り物","とりもの"],["として"],["あなた"],["の"],["もの"],["に"],["なる"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["わたし"],["に"],["信頼","しんらい"],["した"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["』"],["」"]]}]
":[["キティム"],["の"],["島々","しまじま"],["に"],["渡って","わたって"],["よく"],["見よ","みよ"],["。"],["／"],["ケダル"],["に"],["人","ひと"],["を"],["遣わして","つかわして"],["調べて","しらべて"],["み"],["よ"],["。"],["／"],["この"],["よう"],["な"],["こと"],["が"],["あった"],["か"],["どう"],["か"],["、"],["よく"],["見よ","みよ"],["。"]]},{"verse":11,"text":"かつて、神々を神々でないものに、取り替えた国民があっただろうか。／ところが、わたしの民は、その栄光を／無益なものに取り替えた。","tok":[["かつて"],["、"],["神々","かみがみ"],["を"],["神々","かみがみ"],["で"],["ない"],["もの"],["に"],["、"],["取り替えた","とりかえた"],["国民","こくみん"],["が"],["あっただろう"],["か"],["。"],["／"],["ところ"],["が"],["、"],["わたし"],["の"],["民","たみ"],["は"],["、"],["その"],["栄光","えいこう"],["を"],["／"],["無益","むえき"],["な"],["もの"],["に"],["取り替えた","とりかえた"],["。"]]},{"verse":12,"text":"天よ。このことに色を失え。／おぞ気立て。干上がれ。／――主の御告げ――","tok":[["天","てん"],["よ"],["。"],["この"],["こと"],["に"],["色","いろ"],["を"],["失え","うしなえ"],["。"],["／"],["お"],["ぞ"],["気立て","きだて"],["。"],["干上がれ","ひあがれ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":13,"text":"わたしの民は二つの悪を行った。／湧き水の泉であるわたしを捨てて、多くの水ためを、水をためることのできない、こわれた水ためを、自分たちのために掘ったのだ。","tok":[["わたし"],["の"],["民","たみ"],["は"],["二","ふた"],["つ"],["の"],["悪","あく"],["を"],["行った","おこなった"],["。"],["／"],["湧き水","わきみず"],["の"],["泉","いずみ"],["で"],["ある"],["わたし"],["を"],["捨てて","すてて"],["、"],["多く","おおく"],["の"],["水","みず"],["ため"],["を"],["、"],["水","みず"],["を"],["ためる"],["こと"],["の"],["できない"],["、"],["こわれた"],["水","みず"],["ため"],["を"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["掘った","ほった"],["の"],["だ"],["。"]]},{"verse":14,"text":"イスラエルは奴隷なのか。／それとも家に生まれたしもべなのか。／なぜ、獲物にされたのか。","tok":[["イスラエル"],["は"],["奴隷","どれい"],["な"],["の"],["か"],["。"],["／"],["それ"],["と"],["も"],["家","いえ"],["に"],["生まれた","うまれた"],["しもべ"],["な"],["の"],["か"],["。"],["／"],["なぜ"],["、"],["獲物","えもの"],["に"],["された"],["の"],["か"],["。"]]},{"verse":15,"text":"若獅子は、これに向かってほえたけり、叫び声をあげて、その地を荒れ果てさせ、その町々は焼かれて住む者もいなくなる。","tok":[["若","わか"],["獅子","しし"],["は"],["、"],["これ"],["に"],["向かって","むかって"],["ほえ"],["たけり"],["、"],["叫び声","さけびごえ"],["を"],["あげて"],["、"],["その"],["地","ち"],["を"],["荒れ果てさせ","あれはてさせ"],["、"],["その"],["町々","まちまち"],["は"],["焼かれて","やかれて"],["住む","すむ"],["者","もの"],["も"],["いなく"],["なる"],["。"]]},{"verse":16,"text":"ノフとタフパヌヘスの子らも、あなたの頭の頂をそり上げる。","tok":[["ノ"],["フと"],["タフパヌヘス"],["の"],["子","こ"],["ら"],["も"],["、"],["あなた"],["の"],["頭","あたま"],["の"],["頂","いただき"],["を"],["そり"],["上げる","あげる"],["。"]]},{"verse":17,"text":"あなたの神、主が、あなたを道に進ませたとき、あなたは主を捨てたので、このことがあなたに起こるのではないか。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["を"],["道","みち"],["に"],["進ませた","すすませた"],["とき"],["、"],["あなた"],["は"],["主","ぬし"],["を"],["捨てた","すてた"],["ので"],["、"],["この"],["こと"],["が"],["あなた"],["に"],["起こる","おこる"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":18,"text":"今、ナイル川の水を飲みに／エジプトの道に向かうとは、いったいどうしたことか。／ユーフラテス川の水を飲みに／アッシリヤの道に向かうとは、いったいどうしたことか。","tok":[["今","いま"],["、"],["ナイル"],["川","かわ"],["の"],["水","みず"],["を"],["飲み","のみ"],["に"],["／"],["エジプト"],["の"],["道","みち"],["に"],["向かう","むかう"],["と"],["は"],["、"],["いったい"],["どう"],["した"],["こと"],["か"],["。"],["／"],["ユーフラテス"],["川","かわ"],["の"],["水","みず"],["を"],["飲み","のみ"],["に"],["／"],["アッシリヤ"],["の"],["道","みち"],["に"],["向かう","むかう"],["と"],["は"],["、"],["いったい"],["どう"],["した"],["こと"],["か"],["。"]]},{"verse":19,"text":"あなたの悪が、あなたを懲らし、あなたの背信が、あなたを責める。／だから、知り、見きわめよ。／あなたが、あなたの神、主を捨てて、わたしを恐れないのは、どんなに悪く、苦々しいことかを。／――万軍の神、主の御告げ――","tok":[["あなた"],["の"],["悪","あく"],["が"],["、"],["あなた"],["を"],["懲らし","こらし"],["、"],["あなた"],["の"],["背信","はいしん"],["が"],["、"],["あなた"],["を"],["責める","せめる"],["。"],["／"],["だ"],["から"],["、"],["知り","しり"],["、"],["見きわめよ","みきわめよ"],["。"],["／"],["あなた"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["捨てて","すてて"],["、"],["わたし"],["を"],["恐れない","おそれない"],["の"],["は"],["、"],["どんな"],["に"],["悪く","わるく"],["、"],["苦々しい","にがにがしい"],["こと"],["か"],["を"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":20,"text":"実に、あなたは昔から自分のくびきを砕き、自分のなわめを断ち切って、『私は逃げ出さない』と言いながら、すべての高い丘の上や、すべての青々とした木の下で、寝そべって淫行を行っている。","tok":[["実","じつ"],["に"],["、"],["あなた"],["は"],["昔","むかし"],["から"],["自分","じぶん"],["の"],["くびき"],["を"],["砕き","くだき"],["、"],["自分","じぶん"],["の"],["なわ"],["め"],["を"],["断
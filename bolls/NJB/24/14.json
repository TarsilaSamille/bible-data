[{"verse":1,"text":"日照りのことについて、エレミヤにあった主のことば。","tok":[["日照り","ひでり"],["の"],["こと"],["について"],["、"],["エレミヤ"],["に"],["あった"],["主","ぬし"],["の"],["ことば"],["。"]]},{"verse":2,"text":"ユダは喪に服し、その門は打ちしおれ、地に伏して嘆き悲しみ、エルサレムは哀れな叫び声をあげる。","tok":[["ユダ"],["は"],["喪","も"],["に"],["服し","ふくし"],["、"],["その"],["門","もん"],["は"],["打ちしおれ","うちしおれ"],["、"],["地","ち"],["に"],["伏して","ふして"],["嘆き悲しみ","なげきかなしみ"],["、"],["エルサレム"],["は"],["哀れ","あわれ"],["な"],["叫び声","さけびごえ"],["を"],["あげる"],["。"]]},{"verse":3,"text":"その貴人たちは、召使いを、水を汲みにやるが、彼らが水ためのほとりに来ても、水は見つからず、からの器のままで帰る。／彼らは恥を見、侮られて、頭をおおう。","tok":[["その"],["貴人","きじん"],["たち"],["は"],["、"],["召使い","めしつかい"],["を"],["、"],["水","みず"],["を"],["汲み","くみ"],["に"],["やる"],["が"],["、"],["彼","かれ"],["ら"],["が"],["水","みず"],["ため"],["の"],["ほとり"],["に"],["来て","きて"],["も"],["、"],["水","みず"],["は"],["見つからず","みつからず"],["、"],["から"],["の"],["器","うつわ"],["の"],["まま"],["で"],["帰る","かえる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["恥","はじ"],["を"],["見","み"],["、"],["侮られて","あなどられて"],["、"],["頭","あたま"],["を"],["おおう"],["。"]]},{"verse":4,"text":"国に秋の大雨が降らず、地面が割れたため、農夫たちも恥を見、頭をおおう。","tok":[["国","くに"],["に"],["秋","あき"],["の"],["大雨","おおあめ"],["が"],["降らず","ふらず"],["、"],["地面","じめん"],["が"],["割れた","われた"],["ため"],["、"],["農夫","のうふ"],["たち"],["も"],["恥","はじ"],["を"],["見","み"],["、"],["頭","あたま"],["を"],["おおう"],["。"]]},{"verse":5,"text":"若草がないために、野の雌鹿さえ、子を産んでも捨てる。","tok":[["若草","わかくさ"],["が"],["ない"],["ため"],["に"],["、"],["野","の"],["の"],["雌鹿","めじか"],["さえ"],["、"],["子","こ"],["を"],["産んで","うんで"],["も"],["捨てる","すてる"],["。"]]},{"verse":6,"text":"野ろばは裸の丘の上に立ち、ジャッカルのようにあえぎ、目も衰え果てる。／青草がないためだ。","tok":[["野","の"],["ろば"],["は"],["裸","はだか"],["の"],["丘","おか"],["の"],["上","うえ"],["に"],["立ち","たち"],["、"],["ジャッカル"],["の"],["よう"],["に"],["あえぎ"],["、"],["目","め"],["も"],["衰え","おとろえ"],["果てる","はてる"],["。"],["／"],["青草","あおくさ"],["が"],["ない"],["ため"],["だ"],["。"]]},{"verse":7,"text":"私たちの咎が、私たちに不利な証言をしても、主よ、あなたの御名のために事をなしてください。／私たちの背信ははなはだしく、私たちはあなたに罪を犯しました。","tok":[["私たち","わたしたち"],["の"],["咎","とが"],["が"],["、"],["私たち","わたしたち"],["に"],["不利","ふり"],["な"],["証言","しょうげん"],["を"],["して"],["も"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["事","こと"],["を"],["なして"],["ください"],["。"],["／"],["私たち","わたしたち"],["の"],["背信","はいしん"],["は"],["はなはだしく"],["、"],["私たち","わたしたち"],["は"],["あなた"],["に"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"]]},{"verse":8,"text":"イスラエルの望みである方、苦難の時の救い主よ。／なぜあなたは、この国にいる在留異国人のように、また、一夜を過ごすため立ち寄った旅人のように、すげなくされるのですか。","tok":[["イスラエル"],["の"],["望み","のぞみ"],["で"],["ある"],["方","かた"],["、"],["苦難","くなん"],["の"],["時","とき"],["の"],["救い主","すくいぬし"],["よ"],["。"],["／"],["なぜ"],["あなた"],["は"],["、"],["この"],["国","くに"],["に"],["いる"],["在留","ざいりゅう"],["異国人","いこくにん"],["の"],["よう"],["に"],["、"],["また"],["、"],["一夜","いちや"],["を"],["過ごす","すごす"],["ため"],["立ち寄った","たちよった"],["旅人","たびびと"],["の"],["よう"],["に"],["、"],["すげなく"],["される"],["の"],["です"],["か"],["。"]]},{"verse":9,"text":"なぜ、あなたはあわてふためく人のように、また、人を救うこともできない勇士のように、されるのですか。／主よ。あなたは私たちの真ん中におられ、私たちはあなたの御名をもって、呼ばれているのです。／私たちを、置き去りにしないでください。","tok":[["なぜ"],["、"],["あなた"],["は"],["あわてふためく"],["人","ひと"],["の"],["よう"],["に"],["、"],["また"],["、"],["人","ひと"],["を"],["救う","すくう"],["こと"],["も"],["できない"],["勇士","ゆうし"],["の"],["よう"],["に"],["、"],["される"],["の"],["です"],["か"],["。"],["／"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["私たち","わたしたち"],["の"],["真ん中","まんなか"],["に"],["おられ"],["、"],["私たち","わたしたち"],["は"],["あなた"],["の"],["御名","ぎょめい"],["を"],["もって"],["、"],["呼ばれて","よばれて"],["いる"],["の"],["です"],["。"],["／"],["私たち","わたしたち"],["を"],["、"],["置き去り","おきざり"],["に"],["しないで"],["ください"],["。"]]},{"verse":10,"text":"この民について、主はこう仰せられる。「このように、彼らはさすらうことを愛し、その足を制することもしない。それで、主は彼らを喜ばず、今、彼らの咎を覚えて、その罪を罰する。」","tok":[["この"],["民","たみ"],["について"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["この"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["は"],["さすらう"],["こと"],["を"],["愛し","あいし"],["、"],["その"],["足","あし"],["を"],["制する","せいする"],["こと"],["も"],["しない"],["。"],["それ"],["で"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["喜ばず","よろこばず"],["、"],["今","いま"],["、"],["彼","かれ"],["ら"],["の"],["咎","とが"],["を"],["覚えて","おぼえて"],["、"],["その"],["罪","つみ"],["を"],["罰する","ばっする"],["。"],["」"]]},{"verse":11,"text":"主はさらに、私に仰せられた。「この民のために幸いを祈ってはならない。","tok":[["主","ぬし"],["は"],["さらに"],["、"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["この"],["民","たみ"],["の"],["ため"],["に"],["幸い","さいわい"],["を"],["祈って","いのって"],["は"],["ならない"],["。"]]},{"verse":12,"text":"彼らが断食しても、わたしは彼らの叫びを聞かない。全焼のいけにえや、穀物のささげ物をささげても、わたしはそれを受け入れない。かえって、剣とききんと疫病で、彼らをことごとく絶ち滅ぼす。」","tok":[["彼","かれ"],["ら"],["が"],["断食","だんじき"],["して"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["叫び","さけび"],["を"],["聞かない","きかない"],["。"],["全焼","ぜんしょう"],["の"],["いけにえ"],["や"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["ささげて"],["も"],["、"],["わたし"],["は"],["それ"],["を"],["受け入れない","うけいれない"],["。"],["かえって"],["、"],["剣","けん"],["と"],["ききん"],["と"],["疫病","やくびょう"],["で"],["、"],["彼","かれ"],["ら"],["を"],["ことごとく"],["絶ち","たち"],["滅ぼす","ほろぼす"],["。"],["」"]]},{"verse":13,"text":"私は言った。「ああ、神、主よ。預言者たちは、『あなたがたは剣を見ず、ききんもあなたがたに起こらない。かえって、わたしはこの所でまことの平安をあなたがたに与える』と人々に言っているではありませんか。」","tok":[["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["『"],["あなた"],["がた"],["は"],["剣","けん"],["を"],["見ず","みず"],["、"],["ききん"],["も"],["あなた"],["がた"],["に"],["起こらない","おこらない"],["。"],["かえって"],["、"],["わたし"],["は"],["この"],["所","ところ"],["で"],["まこと"],["の"],["平安","へいあん"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["』"],["と"],["人々","ひとびと"],["に"],["言って","いって"],["いるで"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":14,"text":"主は私に仰せられた。「あの預言者たちは、わたしの名によって偽りを預言している。わたしは彼らを遣わしたこともなく、彼らに命じたこともなく、語ったこともない。彼らは、偽りの幻と、むなしい占いと、自分の心の偽りごとを、あなたがたに預言しているのだ。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あの"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["わたし"],["の"],["名","な"],["によって"],["偽り","いつわり"],["を"],["預言","よげん"],["して"],["いる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["遣わした","つかわした"],["こと"],["も"],["なく"],["、"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["こと"],["も"],["なく"],["、"],["語った","かたった"],["こと"],["も"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["、"],["偽り","いつわり"],["の"],["幻","まぼろし"],["と"],["、"],["むなしい"],["占い","うらない"],["と"],["、"],["自分","じぶん"],["の"],["心","こころ"],["の"],["偽り","いつわり"],["ごと"],["を"],["、"],["あなた"],["がた"],["に"],["預言","よげん"],["して"],["いる"],["の"],["だ"],["。"]]},{"verse":15,"text":"それゆえ、わたしの名によって預言はするが、わたしが遣わしたのではない預言者たち、『剣やききんがこの国に起こらない』と言っているこの預言者たちについて、主はこう仰せられる。『剣とききんによって、その預言者たちは滅びうせる。』","tok":[["それ"],["ゆえ"],["、"],["わたし"],["の"],["名","な"],["によって"],["預言","よげん"],["は"],["する"],["が"],["、"],["わたし"],["が"],["遣わした","つかわした"],["ので"],["は"],["ない"],["預言者","よげんしゃ"],["たち"],["、"],["『"],["剣","けん"],["や"],["ききん"],["が"],["この"],["国","くに"],["に"],["起こらない","おこらない"],["』"],["と"],["言って","いって"],["いる"],["この"],["預言者","よげんしゃ"],["たち"],["について"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["剣","けん"],["と"],["ききん"],["によって"],["、"],["その"],["預言者","よげんしゃ"],["たち"],["は"],["滅び","ほろび"],["うせる"],["。"],["』"]]},{"verse":16,"text":"彼らの預言を聞いた民も、ききんと剣によってエルサレムの道ばたに投げ出され、彼らを葬る者もいなくなる。彼らも、その妻も、息子、娘もそのようになる。わたしは、彼らの上にわざわいを注ぎかける。","tok":[["彼","かれ"],["ら"],["の"],["預言","よげん"],["を"],["聞いた","きいた"],["民","たみ"],["も"],["、"],["ききん"],["と"],["剣","けん"],["によって"],["エルサレム"],["の"],["道ばた","みちばた"],["に"],["投げ出され","なげだされ"],["、"],["彼","かれ"],["ら"],["を"],["葬る","ほうむる"],["者","もの"],["も"],["いなく"],["なる"],["。"],["彼","かれ"],["ら"],["も"],["、"],["その"],["妻","つま"],["も"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["も"],["その"],["よう"],["に"],["なる"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["わざわい"],["を"],["注ぎ","そそぎ"],["かける"],["。"]]},{"verse":17,"text":"あなたは彼らに、このことばを言え。／『私の目は夜も昼も涙を流して、やむことがない。／私の民の娘、おとめの打たれた傷は大きく、いやしがたい、ひどい打ち傷。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["、"],["この"],["ことば"],["を"],["言え","いえ"],["。"],["／"],["『"],["私","わたくし"],["の"],["目","め"],["は"],["夜","よる"],["も"],["昼","ひる"],["も"],["涙","なみだ"],["を"],["流して","ながして"],["、"],["やむ"],["こと"],["が"],["ない"],["。"],["／"],["私","わたくし"],["の"],["民","たみ"],["の"],["娘","むすめ"],["、"],["おとめ"],["の"],["打たれた","うたれた"],["傷","きず"],["は"],["大きく","おおきく"],["、"],["いやし"],["がたい"],["、"],["ひどい"],["打ち傷","うちきず"],["。"]]},{"verse":18,"text":"野に出ると、見よ、剣で刺し殺された者たち。／町に入ると、見よ、飢えて病む者たち。／しかし、預言者も祭司も、地にさまよって、途方にくれている。』」","tok":[["野","の"],["に"],["出る","でる"],["と"],["、"],["見よ","みよ"],["、"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["たち"],["。"],["／"],["町","まち"],["に"],["入る","はいる"],["と"],["、"],["見よ","みよ"],["、"],["飢えて","うえて"],["病む","やむ"],["者","もの"],["たち"],["。"],["／"],["しかし"],["、"],["預言者","よげんしゃ"],["も"],["祭司","さいし"],["も"],["、"],["地","ち"],["に"],["さまよって"],["、"],["途方","とほう"],["に"],["くれて"],["いる"],["。"],["』"],["」"]]},{"verse":19,"text":"あなたはユダを全く退けたのですか。／あなたはシオンをきらわれたのですか。／なぜ、あなたは、私たちを打って、いやされないのですか。／私たちが平安を待ち望んでも、幸いはなく、いやしの時を待ち望んでも、なんと、恐怖しかありません。","tok":[["あなた"],["は"],["ユダ"],["を"],["全く","まったく"],["退けた","しりぞけた"],["の"],["です"],["か"],["。"],["／"],["あなた"],["は"],["シオン"],["を"],["きらわれた"],["の"],["です"],["か"],["。"],["／"],["なぜ"],["、"],["あなた"],["は"],["、"],["私たち","わたしたち"],["を"],["打って","うって"],["、"],["いやされない"],["の"],["です"],["か"],["。"],["／"],["私たち","わたしたち"],["が"],["平安","へいあん"],["を"],["待ち望んで","まちのぞんで"],["も"],["、"],["幸い","さいわい"],["は"],["なく"],["、"],["いやし"],["の"],["時","とき"],["を"],["待ち望んで","まちのぞんで"],["も"],["、"],["なん"],["と"],["、"],["恐怖","きょうふ"],["しか"],["ありません"],["。"]]},{"verse":20,"text":"主よ。私たちは自分たちの悪と、先祖の咎とを知っています。／ほんとうに私たちは、あなたに罪を犯しています。","tok":[["主","ぬし"],["よ"],["。"],["私たち","わたしたち"],["は"],["自分","じぶん"],["たち"],["の"],["悪","あく"],["と"],["、"],["先祖","せんぞ"],["の"],["咎","とが"],["と"],["を"],["知って","しって"],["います"],["。"],["／"],["ほんとう"],["に"],["私たち","わたしたち"],["は"],["、"],["あなた"],["に"],["罪","つみ"],["を"],["犯して","おかして"],["います"],["。"]]},{"verse":21,"text":"御名のために、私たちを退けないでください。／あなたの栄光の御座を／はずかしめないでください。／あなたが私たちに立てられた契約を覚えて、それを破らないでください。","tok":[["御名","ぎょめい"],["の"],["ため"],["に"],["、"],["私たち","わたしたち"],["を"],["退けないで","しりぞけないで"],["ください"],["。"],["／"],["あなた"],["の"],["栄光","えいこう"],["の"],["御座","ぎょざ"],["を"],["／"],["はずかしめないで"],["ください"],["。"],["／"],["あなた"],["が"],["私たち","わたしたち"],["に"],["立てられた","たてられた"],["契約","けいやく"],["を"],["覚えて","おぼえて"],["、"],["それ"],["を"],["破らないで","やぶらないで"],["ください"],["。"]]},{"verse":22,"text":"異国のむなしい神々の中で、大雨を降らせる者がいるでしょうか。／それとも、天が夕立を降らせるでしょうか。／私たちの神、主よ。／それは、あなたではありませんか。／私たちはあなたを待ち望みます。／あなたがこれらすべてをなさるからです。","tok":[["異国","いこく"]
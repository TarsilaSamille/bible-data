[{"verse":1,"text":"主からエレミヤにあったみことばは、こうである。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["は"],["、"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"「主の家の門に立ち、そこでこのことばを叫んで言え。／主を礼拝するために、この門に入るすべてのユダの人々よ。主のことばを聞け。","tok":[["「"],["主","ぬし"],["の"],["家","いえ"],["の"],["門","もん"],["に"],["立ち","たち"],["、"],["そこ"],["で"],["この"],["ことば"],["を"],["叫んで","さけんで"],["言え","いえ"],["。"],["／"],["主","ぬし"],["を"],["礼拝","れいはい"],["する"],["ため"],["に"],["、"],["この"],["門","もん"],["に"],["入る","はいる"],["すべて"],["の"],["ユダ"],["の"],["人々","ひとびと"],["よ"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":3,"text":"イスラエルの神、万軍の主は、こう仰せられる。あなたがたの行いと、わざとを改めよ。そうすれば、わたしは、あなたがたをこの所に住ませよう。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["の"],["行い","おこない"],["と"],["、"],["わざと"],["を"],["改めよ","あらためよ"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["この"],["所","ところ"],["に"],["住ませよう","すませよう"],["。"]]},{"verse":4,"text":"あなたがたは、『これは主の宮、主の宮、主の宮だ』と言っている偽りのことばを信頼してはならない。","tok":[["あなた"],["がた"],["は"],["、"],["『"],["これ"],["は"],["主","ぬし"],["の"],["宮","みや"],["、"],["主","ぬし"],["の"],["宮","みや"],["、"],["主","ぬし"],["の"],["宮","みや"],["だ"],["』"],["と"],["言って","いって"],["いる"],["偽り","いつわり"],["の"],["ことば"],["を"],["信頼","しんらい"],["して"],["は"],["ならない"],["。"]]},{"verse":5,"text":"もし、ほんとうに、あなたがたが行いとわざとを改め、あなたがたの間で公義を行い、","tok":[["もし"],["、"],["ほんとう"],["に"],["、"],["あなた"],["がた"],["が"],["行い","おこない"],["と"],["わざと"],["を"],["改め","あらため"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["公義","きみよし"],["を"],["行い","おこない"],["、"]]},{"verse":6,"text":"在留異国人、みなしご、やもめをしいたげず、罪のない者の血をこの所で流さず、ほかの神々に従って自分の身にわざわいを招くようなことをしなければ、","tok":[["在留","ざいりゅう"],["異国人","いこくにん"],["、"],["みなしご"],["、"],["やもめ"],["を"],["しいたげず"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["この"],["所","ところ"],["で"],["流さず","ながさず"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["自分","じぶん"],["の"],["身","み"],["に"],["わざわい"],["を"],["招く","まねく"],["よう"],["な"],["こと"],["を"],["しなければ"],["、"]]},{"verse":7,"text":"わたしはこの所、わたしがあなたがたの先祖に与えたこの地に、とこしえからとこしえまで、あなたがたを住ませよう。","tok":[["わたし"],["は"],["この"],["所","ところ"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["この"],["地","ち"],["に"],["、"],["とこしえ"],["から"],["とこしえ"],["まで"],["、"],["あなた"],["がた"],["を"],["住ませよう","すませよう"],["。"]]},{"verse":8,"text":"なんと、あなたがたは、役にも立たない偽りのことばにたよっている。","tok":[["なん"],["と"],["、"],["あなた"],["がた"],["は"],["、"],["役","やく"],["に"],["も"],["立たない","たたない"],["偽り","いつわり"],["の"],["ことば"],["に"],["たよって"],["いる"],["。"]]},{"verse":9,"text":"しかも、あなたがたは盗み、殺し、姦通し、偽って誓い、バアルのためにいけにえを焼き、あなたがたの知らなかったほかの神々に従っている。","tok":[["しかも"],["、"],["あなた"],["がた"],["は"],["盗み","ぬすみ"],["、"],["殺し","ころし"],["、"],["姦通","かんつう"],["し"],["、"],["偽って","いつわって"],["誓い","ちかい"],["、"],["バアル"],["の"],["ため"],["に"],["いけにえ"],["を"],["焼き","やき"],["、"],["あなた"],["がた"],["の"],["知らなかった","しらなかった"],["ほか"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["いる"],["。"]]},{"verse":10,"text":"それなのに、あなたがたは、わたしの名がつけられているこの家のわたしの前にやって来て立ち、『私たちは救われている』と言う。それは、このようなすべての忌みきらうべきことをするためか。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["名","な"],["が"],["つけられて"],["いる"],["この"],["家","いえ"],["の"],["わたし"],["の"],["前","まえ"],["に"],["やって"],["来て","きて"],["立ち","たち"],["、"],["『"],["私たち","わたしたち"],["は"],["救われて","すくわれて"],["いる"],["』"],["と"],["言う","ゆう"],["。"],["それ"],["は"],["、"],["この"],["よう"],["な"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["する"],["ため"],["か"],["。"]]},{"verse":11,"text":"わたしの名がつけられているこの家は、あなたがたの目には強盗の巣と見えたのか。そうだ。わたしにも、そう見えていた。――主の御告げ――","tok":[["わたし"],["の"],["名","な"],["が"],["つけられて"],["いる"],["この"],["家","いえ"],["は"],["、"],["あなた"],["がた"],["の"],["目","め"],["に"],["は"],["強盗","ごうとう"],["の"],["巣","す"],["と"],["見えた","みえた"],["の"],["か"],["。"],["そう"],["だ"],["。"],["わたし"],["に"],["も"],["、"],["そう"],["見えて","みえて"],["いた"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":12,"text":"それなら、さあ、シロにあったわたしの住まい、先にわたしの名を住ませた所へ行って、わたしの民イスラエルの悪のために、そこでわたしがしたことを見よ。","tok":[["それ"],["なら"],["、"],["さあ"],["、"],["シロ"],["に"],["あった"],["わたし"],["の"],["住まい","すまい"],["、"],["先","さき"],["に"],["わたし"],["の"],["名","な"],["を"],["住ませた","すませた"],["所","ところ"],["へ"],["行って","いって"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["悪","あく"],["の"],["ため"],["に"],["、"],["そこ"],["で"],["わたし"],["が"],["した"],["こと"],["を"],["見よ","みよ"],["。"]]},{"verse":13,"text":"今、あなたがたは、これらの事をみな行っている。――主の御告げ――わたしがあなたがたに絶えず、しきりに語りかけたのに、あなたがたは聞こうともせず、わたしが呼んだのに、答えもしなかった。","tok":[["今","いま"],["、"],["あなた"],["がた"],["は"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["みな"],["行って","いって"],["いる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["が"],["あなた"],["がた"],["に"],["絶えず","たえず"],["、"],["しきり"],["に"],["語りかけた","かたりかけた"],["のに"],["、"],["あなた"],["がた"],["は"],["聞こう","きこう"],["と"],["も"],["せず"],["、"],["わたし"],["が"],["呼んだ","よんだ"],["のに"],["、"],["答え","こたえ"],["も"],["しなかった"],["。"]]},{"verse":14,"text":"それで、あなたがたの頼みとするこの家、わたしの名がつけられているこの家、また、わたしが、あなたがたと、あなたがたの先祖に与えたこの場所に、わたしはシロにしたのと同様なことを行おう。","tok":[["それ"],["で"],["、"],["あなた"],["がた"],["の"],["頼み","たのみ"],["と"],["する"],["この"],["家","いえ"],["、"],["わたし"],["の"],["名","な"],["が"],["つけられて"],["いる"],["この"],["家","いえ"],["、"],["また"],["、"],["わたし"],["が"],["、"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["この"],["場所","ばしょ"],["に"],["、"],["わたし"],["は"],["シロ"],["に"],["した"],["の"],["と"],["同様","どうよう"],["な"],["こと"],["を"],["行おう","おこなおう"],["。"]]},{"verse":15,"text":"わたしは、かつて、あなたがたのすべての兄弟、エフライムのすべての子孫を追い払ったように、あなたがたを、わたしの前から追い払おう。","tok":[["わたし"],["は"],["、"],["かつて"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["兄弟","きょうだい"],["、"],["エフライム"],["の"],["すべて"],["の"],["子孫","しそん"],["を"],["追い払った","おいはらった"],["よう"],["に"],["、"],["あなた"],["がた"],["を"],["、"],["わたし"],["の"],["前","まえ"],["から"],["追い払おう","おいはらおう"],["。"]]},{"verse":16,"text":"あなたは、この民のために祈ってはならない。彼らのために叫んだり、祈りをささげたりしてはならない。わたしにとりなしをしてはならない。わたしはあなたの願いを聞かないからだ。","tok":[["あなた"],["は"],["、"],["この"],["民","たみ"],["の"],["ため"],["に"],["祈って","いのって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["叫ん","さけん"],["だり"],["、"],["祈り","いのり"],["を"],["ささげ"],["たり"],["して"],["は"],["ならない"],["。"],["わたし"],["に"],["とり"],["なし"],["を"],["して"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["の"],["願い","ねがい"],["を"],["聞かない","きかない"],["から"],["だ"],["。"]]},{"verse":17,"text":"彼らがユダの町々や、エルサレムのちまたで何をしているのか、あなたは見ていないのか。","tok":[["彼","かれ"],["ら"],["が"],["ユダ"],["の"],["町々","まちまち"],["や"],["、"],["エルサレム"],["の"],["ちまた"],["で"],["何","なん"],["を"],["して"],["いる"],["の"],["か"],["、"],["あなた"],["は"],["見て","みて"],["いない"],["の"],["か"],["。"]]},{"verse":18,"text":"子どもたちはたきぎを集め、父たちは火をたき、女たちは麦粉をこねて『天の女王』のための供えのパン菓子を作り、わたしの怒りを引き起こすために、ほかの神々に注ぎのぶどう酒を注いでいる。","tok":[["子ども","こども"],["たち"],["は"],["たきぎ"],["を"],["集め","あつめ"],["、"],["父","ちち"],["たち"],["は"],["火","ひ"],["を"],["たき"],["、"],["女","おんな"],["たち"],["は"],["麦粉","むぎこ"],["を"],["こねて"],["『"],["天","てん"],["の"],["女王","じょおう"],["』"],["の"],["ため"],["の"],["供え","そなえ"],["の"],["パン"],["菓子","かし"],["を"],["作り","つくり"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こす","ひきおこす"],["ため"],["に"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注いで","そそいで"],["いる"],["。"]]},{"verse":19,"text":"彼らはわたしの怒りを引き起こすのか。――主の御告げ――自分たちを怒らせ、自分たちの赤恥をさらすためではないか。」","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こす","ひきおこす"],["の"],["か"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["自分","じぶん"],["たち"],["を"],["怒らせ","おこらせ"],["、"],["自分","じぶん"],["たち"],["の"],["赤恥","あかはじ"],["を"],["さらす"],["ため"],["で"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":20,"text":"それで、神である主はこう仰せられる。「見よ。わたしの怒りと憤りは、この場所と、人間と、家畜と、畑の木と、地の産物とに注がれ、それは燃えて、消えることがない。」","tok":[["それ"],["で"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["は"],["、"],["この"],["場所","ばしょ"],["と"],["、"],["人間","にんげん"],["と"],["、"],["家畜","かちく"],["と"],["、"],["畑","はたけ"],["の"],["木","き"],["と"],["、"],["地","ち"],["の"],["産物","さんぶつ"],["と"],["に"],["注がれ","そそがれ"],["、"],["それ"],["は"],["燃えて","もえて"],["、"],["消える","きえる"],["こと"],["が"],["ない"],["。"],["」"]]},{"verse":21,"text":"イスラエルの神、万軍の主は、こう仰せられる。「全焼のいけにえを、あなたがたのほかのいけにえに加えて、その肉を食べよ。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["、"],["あなた"],["がた"],["の"],["ほか"],["の"],["いけにえ"],["に"],["加えて","くわえて"],["、"],["その"],["肉","にく"],["を"],["食べ","たべ"],["よ"],["。"]]},{"verse":22,"text":"わたしは、あなたがたの先祖をエジプトの国から連れ出したとき、全焼のいけにえや、ほかのいけにえについては何も語らず、命じもしなかった。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["国","くに"],["から"],["連れ出した","つれだした"],["とき"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["や"],["、"],["ほか"],["の"],["いけにえ"],["について"],["は"],["何","なん"],["も"],["語らず","かたらず"],["、"],["命じ","めいじ"],["も"],["しなかった"],["。"]]},{"verse":23,"text":"ただ、次のことを彼らに命じて言った。『わたしの声に聞き従え。そうすれば、わたしは、あなたがたの神となり、あなたがたは、わたしの民となる。あなたがたをしあわせにするために、わたしが命じるすべての道を歩め。』","tok":[["ただ"],["、"],["次","つぎ"],["の"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["『"],["わたし"],["の"],["声","こえ"],["に"],["聞き従え","ききしたがえ"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なり"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["民","たみ"],["と"],["なる"],["。"],["あなた"],["がた"],["を"],["しあわせ"],["に"],["する"],["ため"],["に"],["、"],["わたし"],["が"],["命じる","めいじる"],["すべて"],["の"],["道","みち"],["を"],["歩め","あゆめ"],["。"],["』"]]},{"verse":24,"text":"しかし、彼らは聞かず、耳を傾けず、悪いかたくなな心のはかりごとのままに歩み、前進するどころか後退した。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["聞かず","きかず"],["、"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["悪い","わるい"],["かたくな"],["な"],["心","こころ"],["の"],["はかりごと"],["の"],["まま"],["に"],["歩み","あゆみ"],["、"],["前進","ぜんしん"],["する"],["どころ"],["か"],["後退","こうたい"],["した"],["。"]]},{"verse":25,"text":"あなたがたの先祖がエジプトの国を出た日から今日まで、わたしはあなたがたに、わたしのしもべであるすべての預言者たちを、毎日朝早くから、たびたび送ったが、","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["が"],["エジプト"],["の"],["国","くに"],["を"],["出た","でた"],["日","ひ"],["から"],["今日","きょう"],["まで"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["わたし"],["の"],["しもべ"],["で"],["ある"],["すべて"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["、"],["毎日","まいにち"],["朝","あさ"],["早く","はやく"],["から"],["、"],["たびたび"],["送った","おくった"],["が"],["、"]]},{"verse":26,"text":"彼らはわたしに聞かず、耳を傾けず、うなじのこわい者となって、先祖たちよりも悪くなった。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["に"],["聞かず","きかず"],["、"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["うなじ"],["の"],["こわい"],["者","もの"],["と"],["なって"],["、"],["先祖","せんぞ"],["たち"],["より"],["も"],["悪く","わるく"],["なった"],["。"]]},{"verse":27,"text":"あなたが彼らにこれらのことをすべて語っても、彼らはあなたに聞かず、彼らを呼んでも、彼らはあなたに答えまい。","tok":[["あなた"],["が"],["彼","かれ"],["ら"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["すべて"],["語って","かたって"],["も"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["聞かず","きかず"],["、"],["彼","かれ"],["ら"],["を"],["呼んで","よんで"],["も"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["答えまい","こたえまい"],["。"]]},{"verse":28,"text":"そこであなたは彼らに言え。この民は、自分の神、主の声を聞かず、懲らしめを受けなかった民だ。真実は消えうせ、彼らの口から断たれた。","tok":[["そこ"],["で"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["この"],["民","みん"],["は"],["、"],["自分","じぶん"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["声","こえ"],["を"],["聞かず","きかず"],["、"],["懲らしめ","こらしめ"],["を"],["受けなかった","うけなかった"],["民","たみ"],["だ"],["。"],["真実","しんじつ"],["は"],["消えうせ","きえうせ"],["、"],["彼","かれ"],["ら"],["の"],["口","くち"],["から"],["断たれた","たたれた"],["。"]]},{"verse":29,"text":"『あなたの長い髪を切り捨て、裸の丘の上で哀歌を唱えよ。／主は、この世代の者を、激しく怒って、退け、捨てたからだ。』","tok":[["『"],["あなた"],["の"],["長い","ながい"],["髪","かみ"],["を"],["切り捨て","きりすて"],["、"],["裸","はだか"],["の"],["丘","おか"],["の"],["上","うえ"],["で"],["哀歌","あいか"],["を"],["唱え","となえ"],["よ"],["。"],["／"],["主","ぬし"],["は"],["、"],["この"],["世代","せだい"],["の"],["者","もの"],["を"],["、"],["激しく","はげしく"],["怒って","おこって"],["、"],["退け","しりぞけ"],["、"],["捨てた","すてた"],["から"],["だ"],["。"],["』"]]},{"verse":30,"text":"それは、ユダの子らが、わたしの目の前に悪を行ったからだ。――主の御告げ――彼らは、わたしの名がつけられているこの家に自分たちの忌むべき物を置いて、これを汚した。","tok":[["それ"],["は"],["、"],["ユダ"],["の"],["子","こ"],["ら"],["が"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行った","おこなった"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["名","な"],["が"],["つけられて"],["いる"],["この"],
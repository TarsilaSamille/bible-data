[{"verse":1,"text":"「ああ。わたしの牧場の群れを滅ぼし散らす牧者たち。――主の御告げ――」","tok":[["「"],["ああ"],["。"],["わたし"],["の"],["牧場","ぼくじょう"],["の"],["群れ","むれ"],["を"],["滅ぼし","ほろぼし"],["散らす","ちらす"],["牧者","ぼくしゃ"],["たち"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":2,"text":"それゆえ、イスラエルの神、主は、この民を牧する牧者たちについて、こう仰せられる。「あなたがたは、わたしの群れを散らし、これを追い散らして顧みなかった。見よ。わたしは、あなたがたの悪い行いを罰する。――主の御告げ――","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["この"],["民","たみ"],["を"],["牧","まき"],["する"],["牧者","ぼくしゃ"],["たち"],["について"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["群れ","むれ"],["を"],["散らし","ちらし"],["、"],["これ"],["を"],["追い散らして","おいちらして"],["顧みなかった","かえりみなかった"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["悪い","わるい"],["行い","おこない"],["を"],["罰する","ばっする"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":3,"text":"しかし、わたしは、わたしの群れの残りの者を、わたしが追い散らしたすべての国から集め、もとの牧場に帰らせる。彼らは多くの子を生んでふえよう。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["わたし"],["の"],["群れ","むれ"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["、"],["わたし"],["が"],["追い散らした","おいちらした"],["すべて"],["の"],["国","くに"],["から"],["集め","あつめ"],["、"],["もと"],["の"],["牧場","ぼくじょう"],["に"],["帰らせる","かえらせる"],["。"],["彼","かれ"],["ら"],["は"],["多く","おおく"],["の"],["子","こ"],["を"],["生んで","うんで"],["ふえよう"],["。"]]},{"verse":4,"text":"わたしは彼らの上に牧者たちを立て、彼らを牧させる。彼らは二度と恐れることなく、おののくことなく、失われることもない。――主の御告げ――","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["牧者","ぼくしゃ"],["たち"],["を"],["立て","たて"],["、"],["彼","かれ"],["ら"],["を"],["牧","まき"],["させる"],["。"],["彼","かれ"],["ら"],["は"],["二","に"],["度","ど"],["と"],["恐れる","おそれる"],["こと"],["なく"],["、"],["おののく"],["こと"],["なく"],["、"],["失われる","うしなわれる"],["こと"],["も"],["ない"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":5,"text":"見よ。その日が来る。／――主の御告げ――／その日、わたしは、ダビデに一つの正しい若枝を起こす。／彼は王となって治め、栄えて、この国に公義と正義を行う。","tok":[["見","み"],["よ"],["。"],["その"],["日","ひ"],["が"],["来る","くる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["ダビデ"],["に"],["一","ひと"],["つ"],["の"],["正しい","ただしい"],["若枝","わかえだ"],["を"],["起こす","おこす"],["。"],["／"],["彼","かれ"],["は"],["王","おう"],["と"],["なって"],["治め","おさめ"],["、"],["栄えて","さかえて"],["、"],["この"],["国","くに"],["に"],["公義","きみよし"],["と"],["正義","せいぎ"],["を"],["行う","おこなう"],["。"]]},{"verse":6,"text":"その日、ユダは救われ、イスラエルは安らかに住む。／その王の名は、『主は私たちの正義』と呼ばれよう。","tok":[["その"],["日","ひ"],["、"],["ユダ"],["は"],["救われ","すくわれ"],["、"],["イスラエル"],["は"],["安らか","やすらか"],["に"],["住む","すむ"],["。"],["／"],["その"],["王","おう"],["の"],["名","な"],["は"],["、"],["『"],["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["正義","せいぎ"],["』"],["と"],["呼ばれよう","よばれよう"],["。"]]},{"verse":7,"text":"それゆえ、見よ、このような日が来る。――主の御告げ――その日には、彼らは、『イスラエルの子らをエジプトの国から上らせた主は生きておられる』とはもう言わないで、","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["この"],["よう"],["な"],["日","ひ"],["が"],["来る","くる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["その"],["日","ひ"],["に"],["は"],["、"],["彼","かれ"],["ら"],["は"],["、"],["『"],["イスラエル"],["の"],["子","こ"],["ら"],["を"],["エジプト"],["の"],["国","くに"],["から"],["上らせた","のぼらせた"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["は"],["もう"],["言わないで","いわないで"],["、"]]},{"verse":8,"text":"『イスラエルの家のすえを北の国や、彼らの散らされたすべての地方から上らせた主は生きておられる』と言って、自分たちの土地に住むようになる。」","tok":[["『"],["イスラエル"],["の"],["家","いえ"],["の"],["すえ"],["を"],["北","きた"],["の"],["国","くに"],["や"],["、"],["彼","かれ"],["ら"],["の"],["散らされた","ちらされた"],["すべて"],["の"],["地方","ちほう"],["から"],["上らせた","のぼらせた"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["言って","いって"],["、"],["自分","じぶん"],["たち"],["の"],["土地","とち"],["に"],["住む","すむ"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":9,"text":"預言者たちに対して――／私の心は、うちに砕かれ、私の骨はみな震える。／私は酔いどれのようだ。／ぶどう酒に負けた男のようになった。／主と、主の聖なることばのために。","tok":[["預言者","よげんしゃ"],["たち"],["に対して","にたいして"],["―"],["―"],["／"],["私","わたくし"],["の"],["心","こころ"],["は"],["、"],["うち"],["に"],["砕かれ","くだかれ"],["、"],["私","わたくし"],["の"],["骨","ほね"],["は"],["みな"],["震える","ふるえる"],["。"],["／"],["私","わたくし"],["は"],["酔いどれ","よいどれ"],["の"],["よう"],["だ"],["。"],["／"],["ぶどう酒","ぶどうしゅ"],["に"],["負けた","まけた"],["男","おとこ"],["の"],["よう"],["に"],["なった"],["。"],["／"],["主","ぬし"],["と"],["、"],["主","ぬし"],["の"],["聖","せい"],["なる"],["ことば"],["の"],["ため"],["に"],["。"]]},{"verse":10,"text":"国は姦通する者で満ちているからだ。／地はのろわれて喪に服し、荒野の牧草地は乾ききる。／彼らの走る道は悪で、正しくないものをその力とする。","tok":[["国","くに"],["は"],["姦通","かんつう"],["する"],["者","もの"],["で"],["満ちて","みちて"],["いる"],["から"],["だ"],["。"],["／"],["地","ち"],["は"],["のろわれて"],["喪","も"],["に"],["服し","ふくし"],["、"],["荒野","こうや"],["の"],["牧草地","ぼくそうち"],["は"],["乾き","かわき"],["きる"],["。"],["／"],["彼","かれ"],["ら"],["の"],["走る","はしる"],["道","みち"],["は"],["悪","わる"],["で"],["、"],["正しく","ただしく"],["ない"],["もの"],["を"],["その"],["力","ちから"],["と"],["する"],["。"]]},{"verse":11,"text":"実に、預言者も祭司も汚れている。／わたしの家の中にも、わたしは彼らの悪を見いだした。／――主の御告げ――","tok":[["実","じつ"],["に"],["、"],["預言者","よげんしゃ"],["も"],["祭司","さいし"],["も"],["汚れて","よごれて"],["いる"],["。"],["／"],["わたし"],["の"],["家","いえ"],["の"],["中","なか"],["に"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["悪","あく"],["を"],["見いだした","みいだした"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":12,"text":"それゆえ、彼らの道は、暗やみの中のすべりやすい所のようになり、彼らは追い散らされて、そこに倒れる。／わたしが彼らにわざわいをもたらし、刑罰の年をもたらすからだ。／――主の御告げ――","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["の"],["道","みち"],["は"],["、"],["暗やみ","くらやみ"],["の"],["中","なか"],["の"],["すべり"],["やすい"],["所","ところ"],["の"],["よう"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["追い散らされて","おいちらされて"],["、"],["そこ"],["に"],["倒れる","たおれる"],["。"],["／"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["わざわい"],["を"],["もたらし"],["、"],["刑罰","けいばつ"],["の"],["年","とし"],["を"],["もたらす"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":13,"text":"サマリヤの預言者たちの中に、みだらな事をわたしは見た。／彼らはバアルによって預言し、わたしの民イスラエルを惑わした。","tok":[["サマリヤ"],["の"],["預言者","よげんしゃ"],["たち"],["の"],["中","なか"],["に"],["、"],["みだら"],["な"],["事","こと"],["を"],["わたし"],["は"],["見た","みた"],["。"],["／"],["彼","かれ"],["ら"],["は"],["バアル"],["によって"],["預言","よげん"],["し"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["を"],["惑わした","まどわした"],["。"]]},{"verse":14,"text":"エルサレムの預言者たちの中にも、恐ろしい事をわたしは見た。／彼らは姦通し、うそをついて歩き、悪を行う者どもの手を強くして、その悪からだれをも戻らせない。／彼らはみな、わたしには、ソドムのようであり、その住民はゴモラのようである。","tok":[["エルサレム"],["の"],["預言者","よげんしゃ"],["たち"],["の"],["中","なか"],["に"],["も"],["、"],["恐ろしい","おそろしい"],["事","こと"],["を"],["わたし"],["は"],["見た","みた"],["。"],["／"],["彼","かれ"],["ら"],["は"],["姦通","かんつう"],["し"],["、"],["うそ"],["を"],["ついて"],["歩き","あるき"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["ども"],["の"],["手","て"],["を"],["強く","つよく"],["して"],["、"],["その"],["悪","あく"],["から"],["だれ"],["を"],["も"],["戻らせない","もどらせない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["わたし"],["に"],["は"],["、"],["ソドム"],["の"],["よう"],["で"],["あり"],["、"],["その"],["住民","じゅうみん"],["は"],["ゴモラ"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":15,"text":"それゆえ、万軍の主は、預言者たちについて、こう仰せられる。「見よ。わたしは彼らに、苦よもぎを食べさせ、毒の水を飲ませる。汚れがエルサレムの預言者たちから出て、この全土に広がったからだ。」","tok":[["それ"],["ゆえ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["預言者","よげんしゃ"],["たち"],["について"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["、"],["苦","く"],["よもぎ"],["を"],["食べさせ","たべさせ"],["、"],["毒","どく"],["の"],["水","みず"],["を"],["飲ませる","のませる"],["。"],["汚れ","よごれ"],["が"],["エルサレム"],["の"],["預言者","よげんしゃ"],["たち"],["から"],["出て","でて"],["、"],["この"],["全土","ぜんど"],["に"],["広がった","ひろがった"],["から"],["だ"],["。"],["」"]]},{"verse":16,"text":"万軍の主はこう仰せられる。「あなたがたに預言する預言者たちのことばを聞くな。彼らはあなたがたをむなしいものにしようとしている。主の口からではなく、自分の心の幻を語っている。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["がた"],["に"],["預言","よげん"],["する"],["預言者","よげんしゃ"],["たち"],["の"],["ことば"],["を"],["聞く","きく"],["な"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["むなしい"],["もの"],["に"],["しよう"],["として"],["いる"],["。"],["主","ぬし"],["の"],["口","くち"],["から"],["で"],["は"],["なく"],["、"],["自分","じぶん"],["の"],["心","こころ"],["の"],["幻","まぼろし"],["を"],["語って","かたって"],["いる"],["。"]]},{"verse":17,"text":"彼らは、わたしを侮る者に向かって、『主はあなたがたに平安があると告げられた』としきりに言っており、また、かたくなな心のままに歩むすべての者に向かって、『あなたがたにはわざわいが来ない』と言っている。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["を"],["侮る","あなどる
"],["私","わたくし"],["に"],["こう"],["仰せられた","おおせられた"],["。"],["「"],["この"],["憤り","いきどおり"],["の"],["ぶどう酒","ぶどうしゅ"],["の"],["杯","さかずき"],["を"],["わたし"],["の"],["手","て"],["から"],["取り","とり"],["、"],["わたし"],["が"],["あなた"],["を"],["遣わす","つかわす"],["すべて"],["の"],["国々","くにぐに"],["に"],["、"],["これ"],["を"],["飲ませ","のませ"],["よ"],["。"]]},{"verse":16,"text":"彼らは飲んで、ふらつき、狂ったようになる。わたしが彼らの間に送る剣のためである。」","tok":[["彼","かれ"],["ら"],["は"],["飲んで","のんで"],["、"],["ふらつき"],["、"],["狂った","くるった"],["よう"],["に"],["なる"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["送る","おくる"],["剣","けん"],["の"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":17,"text":"そこで、私は主の御手からその杯を取り、主が私を遣わされたすべての国々に飲ませた。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["主","ぬし"],["の"],["御手","おて"],["から"],["その"],["杯","さかずき"],["を"],["取り","とり"],["、"],["主","ぬし"],["が"],["私","わたくし"],["を"],["遣わされた","つかわされた"],["すべて"],["の"],["国々","くにぐに"],["に"],["飲ませた","のませた"],["。"]]},{"verse":18,"text":"エルサレムとユダの町々とその王たち、つかさたちに。――彼らを今日のように廃墟とし、恐怖とし、あざけりとし、のろいとするためであった。――","tok":[["エルサレム"],["と"],["ユダ"],["の"],["町々","まちまち"],["と"],["その"],["王","おう"],["たち"],["、"],["つかさ"],["たち"],["に"],["。"],["―"],["―"],["彼","かれ"],["ら"],["を"],["今日","きょう"],["の"],["よう"],["に"],["廃墟","はいきょ"],["と"],["し"],["、"],["恐怖","きょうふ"],["と"],["し"],["、"],["あざけり"],["と"],["し"],["、"],["のろい"],["と"],["する"],["ため"],["で"],["あった"],["。"],["―"],["―"]]},{"verse":19,"text":"エジプトの王パロと、その家来たち、つかさたち、すべての民に、","tok":[["エジプト"],["の"],["王","おう"],["パロ"],["と"],["、"],["その"],["家来","けらい"],["たち"],["、"],["つかさ"],["たち"],["、"],["すべて"],["の"],["民","たみ"],["に"],["、"]]},{"verse":20,"text":"すべての混血の民、ウツの地のすべての王たち、ペリシテ人の地のすべての王たち――アシュケロン、ガザ、エクロン、アシュドデの残りの者――に、","tok":[["すべて"],["の"],["混血","こんけつ"],["の"],["民","たみ"],["、"],["ウツ"],["の"],["地","ち"],["の"],["すべて"],["の"],["王","おう"],["たち"],["、"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["の"],["すべて"],["の"],["王","おう"],["たち"],["―"],["―"],["アシュケロン"],["、"],["ガザ"],["、"],["エクロン"],["、"],["アシュドデ"],["の"],["残り","のこり"],["の"],["者","もの"],["―"],["―"],["に"],["、"]]},{"verse":21,"text":"エドム、モアブ、アモン人に、","tok":[["エドム"],["、"],["モアブ"],["、"],["アモン人","あもんにん"],["に"],["、"]]},{"verse":22,"text":"ツロのすべての王たち、シドンのすべての王たち、海のかなたにある島の王たちに、","tok":[["ツロ"],["の"],["すべて"],["の"],["王","おう"],["たち"],["、"],["シドン"],["の"],["すべて"],["の"],["王","おう"],["たち"],["、"],["海","うみ"],["の"],["かなた"],["に"],["ある"],["島","しま"],["の"],["王","おう"],["たち"],["に"],["、"]]},{"verse":23,"text":"デダン、テマ、ブズ、こめかみを刈り上げているすべての者に、","tok":[["デダン"],["、"],["テマ"],["、"],["ブズ"],["、"],["こめかみ"],["を"],["刈り上げて","かりあげて"],["いる"],["すべて"],["の"],["者","もの"],["に"],["、"]]},{"verse":24,"text":"アラビヤのすべての王たち、荒野に住む混血の民のすべての王たちに、","tok":[["アラビヤ"],["の"],["すべて"],["の"],["王","おう"],["たち"],["、"],["荒野","こうや"],["に"],["住む","すむ"],["混血","こんけつ"],["の"],["民","たみ"],["の"],["すべて"],["の"],["王","おう"],["たち"],["に"],["、"]]},{"verse":25,"text":"ジムリのすべての王たち、エラムのすべての王たち、メディヤのすべての王たちに、","tok":[["ジムリ"],["の"],["すべて"],["の"],["王","おう"],["たち"],["、"],["エラム"],["の"],["すべて"],["の"],["王","おう"],["たち"],["、"],["メディヤ"],["の"],["すべて"],["の"],["王","おう"],["たち"],["に"],["、"]]},{"verse":26,"text":"北国のすべての王たち、近い者も遠い者もひとりひとりに、地上のすべての王国に飲ませ、彼らのあとでバビロンの王が飲む。","tok":[["北国","きたぐに"],["の"],["すべて"],["の"],["王","おう"],["たち"],["、"],["近い","ちかい"],["者","もの"],["も"],["遠い","とおい"],["者","もの"],["も"],["ひとりひとり"],["に"],["、"],["地上","ちじょう"],["の"],["すべて"],["の"],["王国","おうこく"],["に"],["飲ませ","のませ"],["、"],["彼","かれ"],["ら"],["の"],["あと"],["で"],["バビロン"],["の"],["王","おう"],["が"],["飲む","のむ"],["。"]]},{"verse":27,"text":"「あなたは彼らに言え。『イスラエルの神、万軍の主は、こう仰せられる。飲んで酔い、へどを吐いて倒れよ。起き上がるな。わたしがあなたがたの間に剣を送るからだ。』","tok":[["「"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["『"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["飲んで","のんで"],["酔い","よい"],["、"],["へど"],["を"],["吐いて","はいて"],["倒れ","たおれ"],["よ"],["。"],["起き上がる","おきあがる"],["な"],["。"],["わたし"],["が"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["剣","けん"],["を"],["送る","おくる"],["から"],["だ"],["。"],["』"]]},{"verse":28,"text":"もし、彼らが、あなたの手からその杯を取って飲もうとしなければ、彼らに言え。『万軍の主はこう仰せられる。あなたがたは必ず飲まなければならない。","tok":[["もし"],["、"],["彼","かれ"],["ら"],["が"],["、"],["あなた"],["の"],["手","て"],["から"],["その"],["杯","さかずき"],["を"],["取って","とって"],["飲もう","のもう"],["と"],["しなければ"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["は"],["必ず","かならず"],["飲まなければ","のまなければ"],["ならない"],["。"]]},{"verse":29,"text":"見よ。わたしの名がつけられているこの町にも、わたしはわざわいを与え始めているからだ。あなたがたが、どんなに罰を免れようとしても、免れることはできない。わたしが、この地の全住民の上に、剣を呼び寄せているからだ。――万軍の主の御告げ――』","tok":[["見","み"],["よ"],["。"],["わたし"],["の"],["名","な"],["が"],["つけられて"],["いる"],["この"],["町","まち"],["に"],["も"],["、"],["わたし"],["は"],["わざわい"],["を"],["与え","あたえ"],["始めて","はじめて"],["いる"],["から"],["だ"],["。"],["あなた"],["が"],["た"],["が"],["、"],["どんな"],["に"],["罰","ばつ"],["を"],["免れよう","まぬがれよう"],["として"],["も"],["、"],["免れる","まぬがれる"],["こと"],["は"],["できない"],["。"],["わたし"],["が"],["、"],["この"],["地","ち"],["の"],["全住民","ぜんじゅうみん"],["の"],["上","うえ"],["に"],["、"],["剣","けん"],["を"],["呼び寄せて","よびよせて"],["いる"],["から"],["だ"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["』"]]},{"verse":30,"text":"あなたは彼らにこのすべてのことばを預言して、言え。／『主は高い所から叫び、その聖なる御住まいから声をあげられる。／その牧場に向かって大声で叫び、酒ぶねを踏む者のように、地の全住民に向かって叫び声をあげられる。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["この"],["すべて"],["の"],["ことば"],["を"],["預言","よげん"],["して"],["、"],["言え","いえ"],["。"],["／"],["『"],["主","ぬし"],["は"],["高い","たかい"],["所","ところ"],["から"],["叫び","さけび"],["、"],["その"],["聖","せい"],["なる"],["御住まい","おすまい"],["から"],["声","こえ"],["を"],["あげられる"],["。"],["／"],["その"],["牧場","ぼくじょう"],["に"],["向かって","むかって"],["大声","おおごえ"],["で"],["叫び","さけび"],["、"],["酒","さけ"],["ぶね"],["を"],["踏む","ふむ"],["者","もの"],["の"],["よう"],["に"],["、"],["地","ち"],["の"],["全住民","ぜんじゅうみん"],["に"],["向かって","むかって"],["叫び声","さけびごえ"],["を"],["あげられる"],["。"]]},{"verse":31,"text":"その騒ぎは地の果てまでも響き渡る。／主が諸国の民と争い、すべての者をさばき、悪者どもを剣に渡されるからだ。／――主の御告げ――","tok":[["その"],["騒ぎ","さわぎ"],["は"],["地","ち"],["の"],["果て","はて"],["まで"],["も"],["響き","ひびき"],["渡る","わたる"],["。"],["／"],["主","ぬし"],["が"],["諸国","しょこく"],["の"],["民","たみ"],["と"],["争い","あらそい"],["、"],["すべて"],["の"],["者","もの"],["を"],["さばき"],["、"],["悪者","わるもの"],["ども"],["を"],["剣","けん"],["に"],["渡される","わたされる"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":32,"text":"万軍の主はこう仰せられる。／見よ。わざわいが国から国へと移り行き、大暴風が地の果てから起こる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["見","み"],["よ"],["。"],["わざわい"],["が"],["国","くに"],["から"],["国","くに"],["へ"],["と"],["移り行き","うつりゆき"],["、"],["大","だい"],["暴風","ぼうふう"],["が"],["地","ち"],["の"],["果て","はて"],["から"],["起こる","おこる"],["。"]]},{"verse":33,"text":"その日、主に殺される者が地の果てから地の果てまでに及び、彼らはいたみ悲しまれることなく、集められることなく、葬られることもなく、地面の肥やしとなる。』」","tok":[["その"],["日","ひ"],["、"],["主に","おもに"],["殺される","ころされる"],["者","もの"],["が"],["地","ち"],["の"],["果て","はて"],["から"],["地","ち"],["の"],["果て","はて"],["まで"],["に"],["及び","および"],["、"],["彼","かれ"],["ら"],["は"],["いたみ悲しまれる","いたみかなしまれる"],["こと"],["なく"],["、"],["集められる","あつめられる"],["こと"],["なく"],["、"],["葬られる","ほうむられる"],["こと"],["も"],["なく"],["、"],["地面","じめん"],["の"],["肥やし","こやし"],["と"],["なる"],["。"],["』"],["」"]]},{"verse":34,"text":"牧者たちよ。泣きわめけ。／群れのあるじたちよ。灰の中にころげ回れ。／あなたがたがほふられ、あなたがたが散らされる日が来たからだ。／あなたがたは美しい雄羊のように倒れる。","tok":[["牧者","ぼくしゃ"],["たち"],["よ"],["。"],["泣きわめけ","なきわめけ"],["。"],["／"],["群れ","むれ"],["の"],["あるじ"],["たち"],["よ"],["。"],["灰","はい"],["の"],["中","なか"],["に"],["ころげ"],["回れ","まわれ"],["。"],["／"],["あなた"],["がた"],["が"],["ほふられ"],["、"],["あなた"],["がた"],["が"],["散らされる","ちらされる"],["日","ひ"],["が"],["来た","きた"],["から"],["だ"],["。"],["／"],["あなた"],["がた"],["は"],["美しい","うつくしい"],["雄羊","おひつじ"],["の"],["よう"],["に"],["倒れる","たおれる"],["。"]]},{"verse":35,"text":"逃げ場は牧者たちから、のがれ場は群れのあるじたちから消えうせる。","tok":[["逃げ場","にげば"],["は"],["牧者","ぼくしゃ"],["たち"],["から"],["、"],["の"],["がれ場","がれば"],["は"],["群れ","むれ"],["の"],["あるじ"],["たち"],["から"],["消えうせる","きえうせる"],["。"]]},{"verse":36,"text":"聞け。牧者たちの叫び、群れのあるじたちの泣き声を。／主が彼らの牧場を荒らしておられるからだ。","tok":[["聞け","きけ"],["。"],["牧者","ぼくしゃ"],["たち"],["の"],["叫び","さけび"],["、"],["群れ","むれ"],["の"],["あるじ"],["たち"],["の"],["泣き声","なきごえ"],["を"],["。"],["／"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["の"],["牧場","ぼくじょう"],["を"],["荒らして","あらして"],["おられる"],["から"],["だ"],["。"]]},{"verse":37
[{"verse":1,"text":"ヨシヤの子、ユダの王エホヤキムの第四年、すなわち、バビロンの王ネブカデレザルの元年に、ユダの民全体についてエレミヤにあったみことば。","tok":[["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["第","だい"],["四","よん"],["年","ねん"],["、"],["すなわち"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["元年","がんねん"],["に"],["、"],["ユダ"],["の"],["民","みん"],["全体","ぜんたい"],["について"],["エレミヤ"],["に"],["あった"],["みことば"],["。"]]},{"verse":2,"text":"これを預言者エレミヤは、ユダの民全体とエルサレムの全住民に語って言った。","tok":[["これ"],["を"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["、"],["ユダ"],["の"],["民","みん"],["全体","ぜんたい"],["と"],["エルサレム"],["の"],["全住民","ぜんじゅうみん"],["に"],["語って","かたって"],["言った","いった"],["。"]]},{"verse":3,"text":"アモンの子、ユダの王ヨシヤの第十三年から今日まで、この二十三年間、私に主のことばがあり、私はあなたがたに絶えず、しきりに語りかけたのに、あなたがたは聞かなかった。","tok":[["アモン"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["ヨシヤ"],["の"],["第","だい"],["十三","じゅうさん"],["年","ねん"],["から"],["今日","きょう"],["まで"],["、"],["この"],["二十三","にじゅうさん"],["年間","ねんかん"],["、"],["私","わたくし"],["に"],["主","ぬし"],["の"],["ことば"],["が"],["あり"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["絶えず","たえず"],["、"],["しきり"],["に"],["語りかけた","かたりかけた"],["のに"],["、"],["あなた"],["がた"],["は"],["聞かなかった","きかなかった"],["。"]]},{"verse":4,"text":"また、主はあなたがたに、主のしもべである預言者たちを早くからたびたび送ったのに、あなたがたは聞かず、聞こうと耳を傾けることもなかった。","tok":[["また"],["、"],["主","ぬし"],["は"],["あなた"],["がた"],["に"],["、"],["主","ぬし"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["を"],["早く","はやく"],["から"],["たびたび"],["送った","おくった"],["のに"],["、"],["あなた"],["がた"],["は"],["聞かず","きかず"],["、"],["聞こう","きこう"],["と"],["耳","みみ"],["を"],["傾ける","かたむける"],["こと"],["も"],["なかった"],["。"]]},{"verse":5,"text":"主は仰せられた。「さあ、おのおの、悪の道から、あなたがたの悪い行いから立ち返り、主があなたがたと先祖たちに与えた土地で、いつまでも、とこしえに住め。","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["さあ"],["、"],["おのおの"],["、"],["悪","あく"],["の"],["道","みち"],["から"],["、"],["あなた"],["がた"],["の"],["悪い","わるい"],["行い","おこない"],["から"],["立ち返り","たちかえり"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["と"],["先祖","せんぞ"],["たち"],["に"],["与えた","あたえた"],["土地","とち"],["で"],["、"],["いつ"],["まで"],["も"],["、"],["とこしえ"],["に"],["住め","すめ"],["。"]]},{"verse":6,"text":"ほかの神々に従い、それに仕え、それを拝んではならない。あなたがたが手で造った物によって、わたしの怒りを引き起こしてはならない。そうでないと、わたしもあなたがたにわざわいを与える。","tok":[["ほか"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["それ"],["に"],["仕え","つかえ"],["、"],["それ"],["を"],["拝んで","おがんで"],["は"],["ならない"],["。"],["あなた"],["がた"],["が"],["手","て"],["で"],["造った","つくった"],["物","もの"],["によって"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こして","ひきおこして"],["は"],["ならない"],["。"],["そう"],["で"],["ない"],["と"],["、"],["わたし"],["も"],["あなた"],["がた"],["に"],["わざわい"],["を"],["与える","あたえる"],["。"]]},{"verse":7,"text":"それでも、あなたがたはわたしに聞き従わなかった。――主の御告げ――それで、あなたがたは手で造った物でわたしの怒りを引き起こし、身にわざわいを招いた。」","tok":[["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["それ"],["で"],["、"],["あなた"],["がた"],["は"],["手","て"],["で"],["造った","つくった"],["物","もの"],["で"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こし","ひきおこし"],["、"],["身","み"],["に"],["わざわい"],["を"],["招いた","まねいた"],["。"],["」"]]},{"verse":8,"text":"それゆえ、万軍の主はこう仰せられる。「あなたがたがわたしのことばに聞き従わなかったために、","tok":[["それ"],["ゆえ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["がた"],["が"],["わたし"],["の"],["ことば"],["に"],["聞き従わなかった","ききしたがわなかった"],["ため"],["に"],["、"]]},{"verse":9,"text":"見よ、わたしは北のすべての種族を呼び寄せる。――主の御告げ――すなわち、わたしのしもべバビロンの王ネブカデレザルを呼び寄せて、この国と、その住民と、その回りのすべての国々とを攻めさせ、これを聖絶して、恐怖とし、あざけりとし、永遠の廃墟とする。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["北","きた"],["の"],["すべて"],["の"],["種族","しゅぞく"],["を"],["呼び寄せる","よびよせる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["すなわち"],["、"],["わたし"],["の"],["しもべ"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["を"],["呼び寄せて","よびよせて"],["、"],["この"],["国","くに"],["と"],["、"],["その"],["住民","じゅうみん"],["と"],["、"],["その"],["回り","まわり"],["の"],["すべて"],["の"],["国々","くにぐに"],["と"],["を"],["攻めさせ","せめさせ"],["、"],["これ"],["を"],["聖","せい"],["絶して","ぜっして"],["、"],["恐怖","きょうふ"],["と"],["し"],["、"],["あざけり"],["と"],["し"],["、"],["永遠","えいえん"],["の"],["廃墟","はいきょ"],["と"],["する"],["。"]]},{"verse":10,"text":"わたしは彼らの楽しみの声と喜びの声、花婿の声と花嫁の声、ひき臼の音と、とも
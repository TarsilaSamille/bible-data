[{"verse":1,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":2,"text":"「あなたは妻をめとるな。またこの所で、息子や娘を持つな。」","tok":[["「"],["あなた"],["は"],["妻","つま"],["を"],["めとる"],["な"],["。"],["また"],["この"],["所","ところ"],["で"],["、"],["息子","むすこ"],["や"],["娘","むすめ"],["を"],["持つ","もつ"],["な"],["。"],["」"]]},{"verse":3,"text":"まことに、主は、この所で生まれる息子や娘につき、また、この国で、彼らを産む母親たちや、彼らを生ませる父親たちについて、こう仰せられる。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["、"],["この"],["所","ところ"],["で"],["生まれる","うまれる"],["息子","むすこ"],["や"],["娘","むすめ"],["に"],["つき"],["、"],["また"],["、"],["この"],["国","くに"],["で"],["、"],["彼","かれ"],["ら"],["を"],["産む","うむ"],["母親","ははおや"],["たち"],["や"],["、"],["彼","かれ"],["ら"],["を"],["生ませる","うませる"],["父親","ちちおや"],["たち"],["について"],["、"],["こう"],["仰せられる","おおせられる"],["。"]]},{"verse":4,"text":"「彼らはひどい病気で死ぬ。彼らはいたみ悲しまれることなく、葬られることもなく、地面の肥やしとなる。また、剣とききんで滅ぼされ、しかばねは空の鳥や地の獣のえじきとなる。」","tok":[["「"],["彼","かれ"],["ら"],["は"],["ひどい"],["病気","びょうき"],["で"],["死ぬ","しぬ"],["。"],["彼","かれ"],["ら"],["は"],["いたみ悲しまれる","いたみかなしまれる"],["こと"],["なく"],["、"],["葬られる","ほうむられる"],["こと"],["も"],["なく"],["、"],["地面","じめん"],["の"],["肥やし","こやし"],["と"],["なる"],["。"],["また"],["、"],["剣","けん"],["と"],["ききん"],["で"],["滅ぼされ","ほろぼされ"],["、"],["しかばね"],["は"],["空","そら"],["の"],["鳥","とり"],["や"],["地","ち"],["の"],["獣","けもの"],["の"],["えじき"],["と"],["なる"],["。"],["」"]]},{"verse":5,"text":"まことに主はこう仰せられる。「あなたは、服喪中の家に入ってはならない。悼みに行ってはならない。彼らのために嘆いてはならない。わたしはこの民から、わたしの平安と、――主の御告げ――いつくしみと、あわれみとを取り去った。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["は"],["、"],["服喪中","ふくもちゅう"],["の"],["家","いえ"],["に"],["入って","はいって"],["は"],["ならない"],["。"],["悼み","いたみ"],["に"],["行って","いって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["嘆いて","なげいて"],["は"],["ならない"],["。"],["わたし"],["は"],["この"],["民","たみ"],["から"],["、"],["わたし"],["の"],["平安","へいあん"],["と"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["いつくしみ"],["と"],["、"],["あわれみ"],["と"],["を"],["取り去った","とりさった"],["。"]]},{"verse":6,"text":"この国の身分の高い者や低い者が死んでも葬られず、だれも彼らをいたみ悲しまず、彼らのために身を傷つけず、髪もそらない。","tok":[["この"],["国","くに"],["の"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["や"],["低い","ひくい"],["者","もの"],["が"],["死んで","しんで"],["も"],["葬られず","ほうむられず"],["、"],["だれ"],["も"],["彼","かれ"],["ら"],["を"],["いたみ悲しまず","いたみかなしまず"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["身","み"],["を"],["傷つけず","きずつけず"],["、"],["髪","かみ"],["も"],["そらない"],["。"]]},{"verse":7,"text":"だれも、死んだ者を悔やむために葬儀に出て、パンを裂くこともなく、その父や母を慰める杯を彼らに飲ませることもないだろう。","tok":[["だれ"],["も"],["、"],["死んだ","しんだ"],["者","もの"],["を"],["悔やむ","くやむ"],["ため"],["に"],["葬儀","そうぎ"],["に"],["出て","でて"],["、"],["パン"],["を"],["裂く","さく"],["こと"],["も"],["なく"],["、"],["その"],["父","ちち"],["や"],["母","はは"],["を"],["慰める","なぐさめる"],["杯","さかずき"],["を"],["彼","かれ"],["ら"],["に"],["飲ませる","のませる"],["こと"],["も"],["ないだろう"],["。"]]},{"verse":8,"text":"あなたは宴会の家に行き、いっしょにすわって食べたり飲んだりしてはならない。」","tok":[["あなた"],["は"],["宴会","えんかい"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["いっしょ"],["に"],["すわって"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["して"],["は"],["ならない"],["。"],["」"]]},{"verse":9,"text":"まことにイスラエルの神、万軍の主は、こう仰せられる。「見よ。わたしは、この所から、あなたがたの目の前で、あなたがたが生きているうちに、楽しみの声と喜びの声、花婿の声と花嫁の声を絶やす。","tok":[["まこと"],["に"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["この"],["所","ところ"],["から"],["、"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["あなた"],["がた"],["が"],["生きて","いきて"],["いる"],["うち"],["に"],["、"],["楽しみ","たのしみ"],["の"],["声","こえ"],["と"],["喜び","よろこび"],["の"],["声","こえ"],["、"],["花婿","はなむこ"],["の"],["声","こえ"],["と"],["花嫁","はなよめ"],["の"],["声","こえ"],["を"],["絶やす","たやす"],["。"]]},{"verse":10,"text":"あなたがこの民にこのすべてのことばを告げるとき、彼らがあなたに、『なぜ、主は私たちに、この大きなわざわいを語られたのか。私たちの咎とは何か。私たちの神、主に犯したという、私たちの罪とは何か』と尋ねたら、","tok":[["あなた"],["が"],["この"],["民","たみ"],["に"],["この"],["すべて"],["の"],["ことば"],["を"],["告げる","つげる"],["とき"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["、"],["『"],["なぜ"],["、"],["主","ぬし"],["は"],["私たち","わたしたち"],["に"],["、"],["この"],["大きな","おおきな"],["わざわい"],["を"],["語られた","かたられた"],["の"],["か"],["。"],["私たち","わたしたち"],["の"],["咎","とが"],["と"],["は"],["何","なん"],["か"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["犯した","おかした"],["と"],["いう"],["、"],["私たち","わたしたち"],["の"],["罪","つみ"],["と"],["は"],["何","なん"],["か"],["』"],["と"],["尋ねたら","たずねたら"],["、"]]},{"verse":11,"text":"あなたは彼らにこう言え。『あなたがたの先祖がわたしを捨て、――主の御告げ――ほかの神々に従い、これに仕え、これを拝み、わたしを捨てて、わたしの律法を守らなかったためだ。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["こう"],["言え","いえ"],["。"],["『"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["が"],["わたし"],["を"],["捨て","すて"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["ほか"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["これ"],["に"],["仕え","つかえ"],["、"],["これ"],["を"],["拝み","おがみ"],["、"],["わたし"],["を"],["捨てて","すてて"],["、"],["わたし"],["の"],["律法","りっぽう"],["を"],["守らなかった","まもらなかった"],["ため"],["だ"],["。"]]},{"verse":12,"text":"また、あなたがた自身、あなたがたの先祖以上に悪事を働き、しかも、おのおの悪い、かたくなな心のままに歩み、わたしに聞き従わないので、","tok":[["また"],["、"],["あなた"],["がた"],["自身","じしん"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["以上","いじょう"],["に"],["悪事","あくじ"],["を"],["働き","はたらき"],["、"],["しかも"],["、"],["おのおの"],["悪い","わるい"],["、"],["かたくな"],["な"],["心","こころ"],["の"],["まま"],["に"],["歩み","あゆみ"],["、"],["わたし"],["に"],["聞き従わない","ききしたがわない"],["ので"],["、"]]},{"verse":13,"text":"わたしはあなたがたをこの国から投げ出して、あなたがたも、先祖も知らなかった国へ行かせる。あなたがたは、そこで日夜、ほかの神々に仕える。わたしはあなたがたに、いつくしみを施さない。』","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["この"],["国","くに"],["から"],["投げ出して","なげだして"],["、"],["あなた"],["がた"],["も"],["、"],["先祖","せんぞ"],["も"],["知らなかった","しらなかった"],["国","くに"],["へ"],["行かせる","いかせる"],["。"],["あなた"],["がた"],["は"],["、"],["そこ"],["で"],["日夜","にちや"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕える","つかえる"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["いつくしみ"],["を"],["施さない","ほどこさない"],["。"],["』"]]},{"verse":14,"text":"それゆえ、見よ、その日が来る。――主の御告げ――その日にはもはや、『イスラエルの子らをエジプトの国から上らせた主は生きておられる』とは言わないで、","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["その"],["日","ひ"],["が"],["来る","くる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["その"],["日","ひ"],["に"],["は"],["もはや"],["、"],["『"],["イスラエル"],["の"],["子","こ"],["ら"],["を"],["エジプト"],["の"],["国","くに"],["から"],["上らせた","のぼらせた"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["は"],["言わないで","いわないで"],["、"]]},{"verse":15,"text":"ただ『イスラエルの子らを北の国や、彼らの散らされたすべての地方から上らせた主は生きておられる』と言うようになる。わたしは彼らの先祖に与えた彼らの土地に彼らを帰らせる。","tok":[["ただ"],["『"],["イスラエル"],["の"],["子","こ"],["ら"],["を"],["北","きた"],["の"],["国","くに"],["や"],["、"],["彼","かれ"],["ら"],["の"],["散らされた","ちらされた"],["すべて"],["の"],["地方","ちほう"],["から"],["上らせた","のぼらせた"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["言う","いう"],["よう"],["に"],["なる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["彼","かれ"],["ら"],["の"],["土地","とち"],["に"],["彼","かれ"],["ら"],["を"],["帰らせる","かえらせる"],["。"]]},{"verse":16,"text":"見よ。わたしは多くの漁夫をやって、――主の御告げ――彼らをすなどらせる。その後、わたしは多くの狩人をやって、すべての山、すべての丘、岩の割れ目から彼らをかり出させる。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["多く","おおく"],["の"],["漁夫","ぎょふ"],["を"],["やって"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["彼","かれ"],["ら"],["を"],["すなどらせる"],["。"],["その"],["後","ご"],["、"],["わたし"],["は"],["多く","おおく"],["の"],["狩人","かりゅうど"],["を"],["やって"],["、"],["すべて"],["の"],["山","やま"],["、"],["すべて"],["の"],["丘","おか"],["、"],["岩","いわ"],["の"],["割れ目","われめ"],["から"],["彼","かれ"],["ら"],["を"],["かり出させる","かりださせる"],["。"]]},{"verse":17,"text":"わたしの目は彼らのすべての行いを見ているからだ。彼らはわたしの前から隠れることはできない。また、彼らの咎もわたしの目の前から隠されはしない。","tok":[["わたし"],["の"],["目","め"],["は"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["行い","おこない"],["を"],["見て","みて"],["いる"],["から"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["前","まえ"],["から"],["隠れる","かくれる"],["こと"],["は"],["できない"],["。"],["また"],["、"],["彼","かれ"],["ら"],["の"],["咎","とが"],["も"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["から"],["隠され","かくされ"],["は"],["しない"],["。"]]},{"verse":18,"text":"わたしはまず、彼らの咎と罪に対し二倍の報復をする。それは彼らがわたしの国を忌むべきもののしかばねで汚し、忌みきらうべきものを、わたしの与えた相続地に、満たしたからである。」","tok":[["わたし"],["は"],["まず"],["、"],["彼","かれ"],["ら"],["の"],["咎","とが"],["と"],["罪","つみ"],["に"],["対し","たいし"],["二","に"],["倍","ばい"],["の"],["報復","ほうふく"],["を"],["する"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["国","くに"],["を"],["忌むべき","いむべき"],["もの"],["の"],["しかばね"],["で"],["汚し","よごし"],["、"],["忌みきらうべき","いみきらうべき"],["もの"],["を"],["、"],["わたし"],["の"],["与えた","あたえた"],["相続","そうぞく"],["地","ち"],["に"],["、"],["満たした","みたした"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":19,"text":"主よ、私の力、私のとりで、苦難の日の私の逃げ場よ。／あなたのもとに、諸国の民は地の果てから来て言うでしょう。／「私たちの先祖が受け継いだものは、ただ偽るもの、何の役にも立たないむなしいものばかりだった。","tok":[["主","ぬし"],["よ"],["、"],["私","わたくし"],["の"],["力","ちから"],["、"],["私","わたくし"],["の"],["とり"],["で"],["、"],["苦難","くなん"],["の"],["日","ひ"],["の"],["私","わたくし"],["の"],["逃げ場","にげば"],["よ"],["。"],["／"],["あなた"],["の"],["もと"],["に"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["地","ち"],["の"],["果て","はて"],["から"],["来て","きて"],["言うでしょう","ゆうでしょう"],["。"],["／"],["「"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["が"],["受け継いだ","うけついだ"],["もの"],["は"],["、"],["ただ"],["偽る","いつわる"],["もの"],["、"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["むなしい"],["もの"],["ばかり"],["だった"],["。"]]},{"verse":20,"text":"人間は、自分のために神々を造れようか。／そんなものは神ではない」と。","tok":[["人間","にんげん"],["は"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["神々","かみがみ"],["を"],["造れよう","つくれよう"],["か"],["。"],["／"],["そんな"],["もの"],["は"],["神","かみ"],["で"],["は"],["ない"],["」"],["と"],["。"]]},{"verse":21,"text":"「だから、見よ、わたしは彼らに知らせる。／今度こそ彼らに、わたしの手と、わたしの力を知らせる。／彼らは、わたしの名が主であることを知る。」","tok":[["「"],["だ"],["から"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["知らせる","しらせる"],["。"],["／"],["今度","こんど"],["こそ"],["彼","かれ"],["ら"],["に"],["、"],["わたし"],["の"],["手","て"],["と"],["、"],["わたし"],["の"],["力","ちから"],["を"],["知らせる","しらせる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["名","な"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"],["」"]]}]
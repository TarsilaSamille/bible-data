きのびる","いきのびる"],["。"]]},{"verse":18,"text":"あなたがバビロンの王の首長たちに降伏しないなら、この町はカルデヤ人の手に渡され、彼らはこれを火で焼き、あなたも彼らの手からのがれることができない。』」","tok":[["あなた"],["が"],["バビロン"],["の"],["王","おう"],["の"],["首長","しゅちょう"],["たち"],["に"],["降伏","こうふく"],["しないなら"],["、"],["この"],["町","まち"],["は"],["カルデヤ"],["人","にん"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["火","ひ"],["で"],["焼き","やき"],["、"],["あなた"],["も"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["のがれる"],["こと"],["が"],["できない"],["。"],["』"],["」"]]},{"verse":19,"text":"しかし、ゼデキヤ王はエレミヤに言った。「私は、カルデヤ人に投降したユダヤ人たちを恐れる。カルデヤ人が私を彼らの手に渡し、彼らが私をなぶりものにするかもしれない。」","tok":[["しかし"],["、"],["ゼデキヤ"],["王","おう"],["は"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["カルデヤ"],["人","にん"],["に"],["投降","とうこう"],["した"],["ユダヤ人","ゆだやじん"],["たち"],["を"],["恐れる","おそれる"],["。"],["カルデヤ"],["人","ひと"],["が"],["私","わたくし"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["彼","かれ"],["ら"],["が"],["私","わたくし"],["を"],["なぶりもの"],["に"],["する"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":20,"text":"エレミヤは言った。「彼らはあなたを渡しません。どうぞ、主の声、私があなたに語っていることに聞き従ってください。そうすれば、あなたはしあわせになり、あなたのいのちは助かるのです。","tok":[["エレミヤ"],["は"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["あなた"],["を"],["渡しません","わたしません"],["。"],["どうぞ"],["、"],["主","ぬし"],["の"],["声","こえ"],["、"],["私","わたくし"],["が"],["あなた"],["に"],["語って","かたって"],["いる"],["こと"],["に"],["聞き従って","ききしたがって"],["ください"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["しあわせ"],["に"],["なり"],["、"],["あなた"],["の"],["いのち"],["は"],["助かる","たすかる"],["の"],["です"],["。"]]},{"verse":21,"text":"しかし、もしあなたが降伏するのを拒むなら、これが、主の私に示されたみことばです。","tok":[["しかし"],["、"],["もし"],["あなた"],["が"],["降伏","こうふく"],["する"],["の"],["を"],["拒むなら","こばむなら"],["、"],["これ"],["が"],["、"],["主","ぬし"],["の"],["私","わたくし"],["に"],["示された","しめされた"],["みことば"],["です"],["。"]]},{"verse":22,"text":"『見よ。ユダの王の家に残された女たちはみな、バビロンの王の首長たちのところに引き出される。聞け。彼女らは言う。――／あなたの親友たちが、あなたをそそのかし、あなたに勝った。／彼らはあなたの足を泥の中に沈ませ、背を向けてしまった。","tok":[["『"],["見","み"],["よ"],["。"],["ユダ"],["の"],["王","おう"],["の"],["家","いえ"],["に"],["残された","のこされた"],["女","おんな"],["たち"],["は"],["みな"],["、"],["バビロン"],["の"],["王","おう"],["の"],["首長","しゅちょう"],["たち"],["の"],["ところ"],["に"],["引き出される","ひきだされる"],["。"],["聞け","きけ"],["。"],["彼女","かのじょ"],["ら"],["は"],["言う","ゆう"],["。"],["―"],["―"],["／"],["あなた"],["の"],["親友","しんゆう"],["たち"],["が"],["、"],["あなた"],["を"],["そそのかし"],["、"],["あなた"],["に"],["勝った","かった"],["。"],["／"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["足","あし"],["を"],["泥","どろ"],["の"],["中","なか"],["に"],["沈ませ","しずませ"],["、"],["背","せ"],["を"],["向けて","むけて"],["しまった"],["。"]]},{"verse":23,"text":"あなたの妻たちや、子どもたちはみな、カルデヤ人のところに引き出され、あなたも彼らの手からのがれることができずに、バビロンの王の手に捕らえられ、この町も火で焼かれる。』」","tok":[["あなた"],["の"],["妻たち","つまたち"],["や"],["、"],["子ども","こども"],["たち"],["は"],["みな"],["、"],["カルデヤ"],["人","にん"],["の"],["ところ"],["に"],["引き出され","ひきだされ"],["、"],["あなた"],["も"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["のがれる"],["こと"],["が"],["できず"],["に"],["、"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["捕らえられ","とらえられ"],["、"],["この"],["町","まち"],["も"],["火","ひ"],["で"],["焼かれる","やかれる"],["。"],["』"],["」"]]},{"verse":24,"text":"ゼデキヤはエレミヤに言った。「だれにも、これらのことを知らせてはならない。そうすれば、あなたは殺されることはない。","tok":[["ゼデキヤ"],["は"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["だれ"],["に"],["も"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["知らせて","しらせて"],["は"],["ならない"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["殺される","ころされる"],["こと"],["は"],["ない"],["。"]]},{"verse":25,"text":"もし、あの首長たちが、私があなたと話したことを聞いて、あなたのところに行き、あなたに『さあ、何を王と話したのか、教えてくれ。私たちに隠すな。あなたを殺しはしない。王はあなたに何を話したのだ』と言っても、","tok":[["もし"],["、"],["あの"],["首長","しゅちょう"],["たち"],["が"],["、"],["私","わたくし"],["が"],["あなた"],["と"],["話した","はなした"],["こと"],["を"],["聞いて","きいて"],["、"],["あなた"],["の"],["ところ"],["に"],["行き","いき"],["、"],["あなた"],["に"],["『"],["さあ"],["、"],["何","なん"],["を"],["王","おう"],["と"],["話した","はなした"],["の"],["か"],["、"],["教えて","おしえて"],["くれ"],["。"],["私たち","わたしたち"],["に"],["隠す","かくす"],["な"],["。"],["あなた"],["を"],["殺し","ころし"],["は"],["しない"],["。"],["王","おう"],["は"],["あなた"],["に"],["何","なん"],["を"],["話した","はなした"],["の"],["だ"],["』"],["と"],["言って","いって"],["も"],["、"]]},{"verse":26,"text":"あなたは彼らに、『私をヨナタンの家に返してそこで私が死ぬことがないようにしてくださいと、王の前に嘆願していた』と言いなさい。」","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["、"],["『"],["私","わたくし"],["を"],["ヨナタン"],["の"],["家","いえ"],["に"],["返して","かえして"],["そこ"],["で"],["私","わたくし"],["が"],["死ぬ","しぬ"],["こと"],["が"],["ない"],["よう"],["に"],["して"],["ください"],["と"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["嘆願","たんがん"],["して"],["いた"],["』"],["と"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":27,"text":"首長たちがみなエレミヤのところに来て、彼に尋ねたとき、彼は、王が命じたことばのとおりに、彼らに告げたので、彼らは黙ってしまった。あのことはだれにも聞かれなかったからである。","tok":[["首長","しゅちょう"],["たち"],["が"],["みな"],["エレミヤ"],["の"],["ところ"],["に"],["来て","きて"],["、"],["彼","かれ"],["に"],["尋ねた","たずねた"],["とき"],["、"],["彼","かれ"],["は"],["、"],["王","おう"],["が"],["命じた","めいじた"],["ことば"],["の"],["とおり"],["に"],["、"],["彼","かれ"],["ら"],["に"],["告げた","つげた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["黙って","だまって"],["しまった"],["。"],["あの"],["こと"],["は"],["だれ"],["に"],["も"],["聞かれなかった","きかれなかった"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"エレミヤは、エルサレムが攻め取られる日まで、監視の庭にとどまっていた。彼はエルサレムが攻め取られたときも、そこにいた。","tok":[["エレミヤ"],["は"],["、"],["エルサレム"],["が"],["攻め取られる","せめとられる"],["日","ひ"],["まで"],["、"],["監視","かんし"],["の"],["庭","にわ"],["に"],["とどまって"],["いた"],["。"],["彼","かれ"],["は"],["エルサレム"],["が"],["攻め取られた","せめとられた"],["とき"],["も"],["、"],["そこ"],["に"],["いた"],["。"]]}]
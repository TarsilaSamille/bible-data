[{"verse":1,"text":"主よ。私があなたと論じても、あなたのほうが正しいのです。／それでも、さばきについて、一つのことを私はあなたにお聞きしたいのです。／なぜ、悪者の道は栄え、裏切りを働く者が、みな安らかなのですか。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["が"],["あなた"],["と"],["論じて","ろんじて"],["も"],["、"],["あなた"],["の"],["ほう"],["が"],["正しい","ただしい"],["の"],["です"],["。"],["／"],["それ"],["で"],["も"],["、"],["さばき"],["について"],["、"],["一","ひと"],["つ"],["の"],["こと"],["を"],["私","わたくし"],["は"],["あなた"],["に"],["お聞き","おきき"],["したい"],["の"],["です"],["。"],["／"],["なぜ"],["、"],["悪者","わるもの"],["の"],["道","みち"],["は"],["栄え","さかえ"],["、"],["裏切り","うらぎり"],["を"],["働く","はたらく"],["者","もの"],["が"],["、"],["みな"],["安らか","やすらか"],["な"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"あなたは彼らを植え、彼らは根を張り、伸びて、実を結びました。／あなたは、彼らの口には近いのですが、彼らの思いからは遠く離れておられます。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["を"],["植え","うえ"],["、"],["彼","かれ"],["ら"],["は"],["根","ね"],["を"],["張り","はり"],["、"],["伸びて","のびて"],["、"],["実","じつ"],["を"],["結びました","むすびました"],["。"],["／"],["あなた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["口","くち"],["に"],["は"],["近い","ちかい"],["の"],["です"],["が"],["、"],["彼","かれ"],["ら"],["の"],["思い","おもい"],["から"],["は"],["遠く","とおく"],["離れて","はなれて"],["おられます"],["。"]]},{"verse":3,"text":"主よ。あなたは私を知り、私を見ておられ、あなたへの私の心をためされます。／どうか彼らを、ほふられる羊のように／引きずり出して、虐殺の日のために取り分けてください。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["は"],["私","わたくし"],["を"],["知り","しり"],["、"],["私","わたくし"],["を"],["見て","みて"],["おられ"],["、"],["あなた"],["へ"],["の"],["私","わたくし"],["の"],["心","こころ"],["を"],["ためされます"],["。"],["／"],["どう"],["か"],["彼","かれ"],["ら"],["を"],["、"],["ほふられる"],["羊","ひつじ"],["の"],["よう"],["に"],["／"],["引きずり","ひきずり"],["出して","だして"],["、"],["虐殺","ぎゃくさつ"],["の"],["日","ひ"],["の"],["ため"],["に"],["取り分けて","とりわけて"],["ください"],["。"]]},{"verse":4,"text":"いつまで、この地は喪に服し、すべての畑の青草は枯れているのでしょうか。／そこに住む者たちの悪のために、家畜も鳥も取り去られています。／人々は、「彼は私たちの最期を見ない」と／言っているのです。","tok":[["いつ"],["まで"],["、"],["この"],["地","ち"],["は"],["喪","も"],["に"],["服し","ふくし"],["、"],["すべて"],["の"],["畑","はたけ"],["の"],["青草","あおくさ"],["は"],["枯れて","かれて"],["いる"],["の"],["でしょう"],["か"],["。"],["／"],["そこ"],["に"],["住む","すむ"],["者","もの"],["たち"],["の"],["悪","あく"],["の"],["ため"],["に"],["、"],["家畜","かちく"],["も"],["鳥","とり"],["も"],["取り去られて","とりさられて"],["います"],["。"],["／"],["人々","ひとびと"],["は"],["、"],["「"],["彼","かれ"],["は"],["私たち","わたしたち"],["の"],["最期","さいご"],["を"],["見ない","みない"],["」"],["と"],["／"],["言って","いって"],["いる"],["の"],["です"],["。"]]},{"verse":5,"text":"あなたは徒歩の人たちと走っても疲れるのに、どうして騎馬の人と競走できよう。／あなたは平穏な地で安心して過ごしているのに、どうしてヨルダンの密林で過ごせよう。","tok":[["あなた"],["は"],["徒歩","とほ"],["の"],["人","ひと"],["たち"],["と"],["走って","はしって"],["も"],["疲れる","つかれる"],["のに"],["、"],["どう"],["して"],["騎馬","きば"],["の"],["人","ひと"],["と"],["競走","きょうそう"],["できよう"],["。"],["／"],["あなた"],["は"],["平穏","へいおん"],["な"],["地","ち"],["で"],["安心","あんしん"],["して"],["過ごして","すごして"],["いる"],["のに"],["、"],["どう"],["して"],["ヨルダン"],["の"],["密林","みつりん"],["で"],["過ごせよう","すごせよう"],["。"]]},{"verse":6,"text":"あなたの兄弟や、父の家の者さえ、彼らさえ、あなたを裏切り、彼らさえ、あなたのあとから大声で呼ばわるのだから、彼らがあなたに親切そうに語りかけても、彼らを信じてはならない。","tok":[["あなた"],["の"],["兄弟","きょうだい"],["や"],["、"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["さえ"],["、"],["彼","かれ"],["ら"],["さえ"],["、"],["あなた"],["を"],["裏切り","うらぎり"],["、"],["彼","かれ"],["ら"],["さえ"],["、"],["あなた"],["の"],["あと"],["から"],["大声","おおごえ"],["で"],["呼ばわる","よばわる"],["の"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["親切","しんせつ"],["そう"],["に"],["語りかけて","かたりかけて"],["も"],["、"],["彼","かれ"],["ら"],["を"],["信じて","しんじて"],["は"],["ならない"],["。"]]},{"verse":7,"text":"私は、私の家を捨て、私の相続地を見放し、私の心の愛するものを、敵の手中に渡した。","tok":[["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["家","いえ"],["を"],["捨て","すて"],["、"],["私","わたくし"],["の"],["相続","そうぞく"],["地","ち"],["を"],["見放し","みはなし"],["、"],["私","わたくし"],["の"],["心","こころ"],["の"],["愛する","あいする"],["もの"],["を"],["、"],["敵","てき"],["の"],["手中","しゅちゅう"],["に"],["渡した","わたした"],["。"]]},{"verse":8,"text":"私の相続地は、私にとって、林の中の獅子のようだ。／これは私に向かって、うなり声をあげる。／それで、私はこの地を憎む。","tok":[["私","わたくし"],["の"],["相続","そうぞく"],["地","ち"],["は"],["、"],["私","わたくし"],["にとって"],["、"],["林","はやし"],["の"],["中","なか"],["の"],["獅子","しし"],["の"],["よう"],["だ"],["。"],["／"],["これ"],["は"],["私","わたくし"],["に"],["向かって","むかって"],["、"],["うなり声","うなりごえ"],["を"],["あげる"],["。"],["／"],["それ"],["で"],["、"],["私","わたくし"],["は"],["この"],["地","ち"],["を"],["憎む","にくむ"],["。"]]},{"verse":9,"text":"私の相続地は、私にとって、まだらの猛禽なのか。／猛禽がそれを取り巻いているではないか。／さあ、すべての野の獣を集めよ。／連れて来て、食べさせよ。","tok":[["私","わたくし"],["の"],["相続","そうぞく"],["地","ち"],["は"],["、"],["私","わたくし"],["にとって"],["、"],["まだら"],["の"],["猛禽","もうきん"],["な"],["の"],["か"],["。"],["／"],["猛禽","もうきん"],["が"],["それ"],["を"],["取り巻いて","とりまいて"],["いるで"],["は"],["ない"],["か"],["。"],["／"],["さあ"],["、"],["すべて"],["の"],["野","の"],["の"],["獣","けもの"],["を"],["集めよ","あつめよ"],["。"],["／"],["連れて","つれて"],["来て","きて"],["、"],["食べさせ","たべさせ"],["よ"],["。"]]},{"verse":10,"text":"多くの牧者が、私のぶどう畑を荒らし、私の地所を踏みつけ、私の慕う地所を、恐怖の荒野にした。","tok":[["多く","おおく"],["の"],["牧者","ぼくしゃ"],["が"],["、"],["私","わたくし"],["の"],["ぶどう"],["畑","はたけ"],["を"],["荒らし","あらし"],["、"],["私","わたくし"],["の"],["地所","じしょ"],["を"],["踏みつけ","ふみつけ"],["、"],["私","わたくし"],["の"],["慕う","したう"],["地所","じしょ"],["を"],["、"],["恐怖","きょうふ"],["の"],["荒野","あらの"],["に"],["した"],["。"]]},{"verse":11,"text":"それは恐怖と化し、荒れ果てて、私に向かって嘆いている。／全地は荒らされてしまった。／だれも心に留める者がいないのだ。","tok":[["それ"],["は"],["恐怖","きょうふ"],["と"],["化し","かし"],["、"],["荒れ果てて","あれはてて"],["、"],["私","わたくし"],["に"],["向かって","むかって"],["嘆いて","なげいて"],["いる"],["。"],["／"],["全地","ぜんち"],["は"],["荒らされて","あらされて"],["しまった"],["。"],["／"],["だれ"],["も"],["心","こころ"],["に"],["留める","とめる"],["者","もの"],["が"],["いない"],["の"],["だ"],["。"]]},{"verse":12,"text":"荒野にあるすべての裸の丘の上に、荒らす者が来た。／主の剣が、地の果てから地の果てに至るまで／食い尽くすので、すべての者には平安がない。","tok":[["荒野","こうや"],["に"],["ある"],["すべて"],["の"],["裸","はだか"],["の"],["丘","おか"],["の"],["上","うえ"],["に"],["、"],["荒らす","あらす"],["者","もの"],["が"],["来た","きた"],["。"],["／"],["主","ぬし"],["の"],["剣","けん"],["が"],["、"],["地","ち"],["の"],["果て","はて"],["から"],["地","ち"],["の"],["果て","はて"],["に"],["至る","いたる"],["まで"],["／"],["食い","くい"],["尽くす","つくす"],["ので"],["、"],["すべて"],["の"],["者","もの"],["に"],["は"],["平安","へいあん"],["が"],["ない"],["。"]]},{"verse":13,"text":"小麦を蒔いても、いばらを刈り取り、労苦してもむだになる。／あなたがたは、自分たちの収穫で恥を見よう。／主の燃える怒りによって。","tok":[["小麦","こむぎ"],["を"],["蒔いて","まいて"],["も"],["、"],["いばら"],["を"],["刈り取り","かりとり"],["、"],["労苦","ろうく"],["して"],["も"],["むだ"],["に"],["なる"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["収穫","しゅうかく"],["で"],["恥","はじ"],["を"],["見よう","みよう"],["。"],["／"],["主","ぬし"],["の"],["燃える","もえる"],["怒り","いかり"],["によって"],["。"]]},{"verse":14,"text":"「主はこう仰せられる。わたしが、わたしの民イスラエルに継がせた相続地を侵す悪い隣国の民について。見よ、わたしは彼らをその土地から引き抜き、ユダの家も彼らの中から引き抜く。","tok":[["「"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["が"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["に"],["継がせた","つがせた"],["相続","そうぞく"],["地","ち"],["を"],["侵す","おかす"],["悪い","わるい"],["隣国","りんごく"],["の"],["民","たみ"],["について"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["その"],["土地","とち"],["から"],["引き抜き","ひきぬき"],["、"],["ユダ"],["の"],["家","いえ"],["も"],["彼","かれ"],["ら"],["の"],["中","なか"],["から"],["引き抜く","ひきぬく"],["。"]]},{"verse":15,"text":"しかし、彼らを引き抜いて後、わたしは再び彼らをあわれみ、彼らをそれぞれ、彼らの相続地、彼らの国に帰らせよう。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["を"],["引き抜いて","ひきぬいて"],["後","あと"],["、"],["わたし"],["は"],["再び","ふたたび"],["彼","かれ"],["ら"],["を"],["あわれみ"],["、"],["彼","かれ"],["ら"],["を"],["それぞれ"],["、"],["彼","かれ"],["ら"],["の"],["相続","そうぞく"],["地","ち"],["、"],["彼","かれ"],["ら"],["の"],["国","くに"],["に"],["帰らせよう","かえらせよう"],["。"]]},{"verse":16,"text":"彼らが、かつて、わたしの民にバアルによって誓うことを教えたように、もし彼らがわたしの民の道をよく学び、わたしの名によって、『主は生きておられる』と誓うなら、彼らは、わたしの民のうちに建てられよう。","tok":[["彼","かれ"],["ら"],["が"],["、"],["かつて"],["、"],["わたし"],["の"],["民","たみ"],["に"],["バアル"],["によって"],["誓う","ちかう"],["こと"],["を"],["教えた","おしえた"],["よう"],["に"],["、"],["もし"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["民","たみ"],["の"],["道","みち"],["を"],["よく"],["学び","まなび"],["、"],["わたし"],["の"],["名","な"],["によって"],["、"],["『"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["誓うなら","ちかうなら"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["民","たみ"],["の"],["うち"],["に"],["建てられよう","たてられよう"],["。"]]},{"verse":17,"text":"しかし、彼らが聞かなければ、わたしはその国を根こぎにして滅ぼしてしまう。――主の御告げ――」","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["が"],["聞かなければ","きかなければ"],["、"],["わたし"],["は"],["その"],["国","くに"],["を"],["根こぎ","ねこぎ"],["に"],["して"],["滅ぼして","ほろぼして"],["しまう"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]}]
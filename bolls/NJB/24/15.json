[{"verse":1,"text":"主は私に仰せられた。「たといモーセとサムエルがわたしの前に立っても、わたしはこの民を顧みない。彼らをわたしの前から追い出し、立ち去らせよ。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["たとい"],["モーセ"],["と"],["サムエル"],["が"],["わたし"],["の"],["前","まえ"],["に"],["立って","たって"],["も"],["、"],["わたし"],["は"],["この"],["民","たみ"],["を"],["顧みない","かえりみない"],["。"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["前","まえ"],["から"],["追い出し","おいだし"],["、"],["立ち去らせ","たちさらせ"],["よ"],["。"]]},{"verse":2,"text":"彼らがあなたに、『どこへ去ろうか』と言うなら、あなたは彼らに言え。『主はこう仰せられる。／死に定められた者は死に、剣に定められた者は剣に、ききんに定められた者はききんに、とりこに定められた者はとりこに。』","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["に"],["、"],["『"],["どこ"],["へ"],["去ろう","さろう"],["か"],["』"],["と"],["言うなら","ゆうなら"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["死","し"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["死に","しに"],["、"],["剣","けん"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["剣","けん"],["に"],["、"],["ききん"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["ききん"],["に"],["、"],["とりこ"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["とりこ"],["に"],["。"],["』"]]},{"verse":3,"text":"わたしは四つの種類のもので彼らを罰する。――主の御告げ――すなわち、切り殺すために剣、引きずるために犬、食い尽くし、滅ぼすために空の鳥と地の獣である。","tok":[["わたし"],["は"],["四","よん"],["つ"],["の"],["種類","しゅるい"],["の"],["もの"],["で"],["彼","かれ"],["ら"],["を"],["罰する","ばっする"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["すなわち"],["、"],["切り殺す","きりころす"],["ため"],["に"],["剣","けん"],["、"],["引きずる","ひきずる"],["ため"],["に"],["犬","いぬ"],["、"],["食い","くい"],["尽くし","つくし"],["、"],["滅ぼす","ほろぼす"],["ため"],["に"],["空","そら"],["の"],["鳥","とり"],["と"],["地","ち"],["の"],["獣","けもの"],["で"],["ある"],["。"]]},{"verse":4,"text":"わたしは彼らを、地のすべての王国のおののきとする。ユダの王ヒゼキヤの子マナセがエルサレムで行ったことのためである。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["地","ち"],["の"],["すべて"],["の"],["王国","おうこく"],["の"],["おののき"],["と"],["する"],["。"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["の"],["子","こ"],["マナセ"],["が"],["エルサレム"],["で"],["行った","おこなった"],["こと"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"エルサレムよ。／いったい、だれがおまえをあわれもう。／だれがおまえのために嘆こう。／だれが立ち寄って、おまえの安否を尋ねよう。","tok":[["エルサレム"],["よ"],["。"],["／"],["いったい"],["、"],["だれ"],["が"],["おまえ"],["を"],["あわれもう"],["。"],["／"],["だれ"],["が"],["おまえ"],["の"],["ため"],["に"],["嘆こう","なげこう"],["。"],["／"],["だれ"],["が"],["立ち寄って","たちよって"],["、"],["おまえ"],["の"],["安否","あんぴ"],["を"],["尋ねよう","たずねよう"],["。"]]},{"verse":6,"text":"おまえがわたしを捨てたのだ、――主の御告げ――／おまえはわたしに背を向けた。／わたしはおまえに手を伸ばし、おまえを滅ぼす。／わたしはあわれむのに飽いた。","tok":[["おまえ"],["が"],["わたし"],["を"],["捨てた","すてた"],["の"],["だ"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["おまえ"],["は"],["わたし"],["に"],["背","せ"],["を"],["向けた","むけた"],["。"],["／"],["わたし"],["は"],["おまえ"],["に"],["手","て"],["を"],["伸ばし","のばし"],["、"],["おまえ"],["を"],["滅ぼす","ほろぼす"],["。"],["／"],["わたし"],["は"],["あわれむ"],["のに"],["飽いた","あいた"],["。"]]},{"verse":7,"text":"わたしはこの国の町囲みのうちで、熊手で彼らを追い散らし、彼らの子を失わせ、わたしの民を滅ぼした。／彼らがその行いを悔い改めなかったからだ。","tok":[["わたし"],["は"],["この"],["国","くに"],["の"],["町","まち"],["囲み","かこみ"],["の"],["うち"],["で"],["、"],["熊手","くまで"],["で"],["彼","かれ"],["ら"],["を"],["追い散らし","おいちらし"],["、"],["彼","かれ"],["ら"],["の"],["子","こ"],["を"],["失わせ","うしなわせ"],["、"],["わたし"],["の"],["民","たみ"],["を"],["滅ぼした","ほろぼした"],["。"],["／"],["彼","かれ"],["ら"],["が"],["その"],["行い","おこない"],["を"],["悔い改めなかった","くいあらためなかった"],["から"],["だ"],["。"]]},{"verse":8,"text":"わたしはそのやもめの数を／海の砂よりも多くした。／わたしは若い男の母親に対し、真昼に荒らす者を送り、にわかに、苦痛と恐怖を彼女の上に襲わせた。","tok":[["わたし"],["は"],["その"],["やもめ"],["の"],["数","かず"],["を"],["／"],["海","うみ"],["の"],["砂","すな"],["より"],["も"],["多く","おおく"],["した"],["。"],["／"],["わたし"],["は"],["若い","わかい"],["男","おとこ"],["の"],["母親","ははおや"],["に"],["対し","たいし"],["、"],["真昼","まひる"],["に"],["荒らす","あらす"],["者","もの"],["を"],["送り","おくり"],["、"],["にわか"],["に"],["、"],["苦痛","くつう"],["と"],["恐怖","きょうふ"],["を"],["彼女","かのじょ"],["の"],["上","うえ"],["に"],["襲わせた","おそわせた"],["。"]]},{"verse":9,"text":"七人の子を産んだ女は打ちしおれ、その息はあえいだ。／彼女の太陽は、まだ昼のうちに没し、彼女は恥を見、はずかしめを受けた。／また、わたしは、彼らの残りの者を／彼らの敵の前で剣に渡す。／――主の御告げ――」","tok":[["七人","しちにん"],["の"],["子","こ"],["を"],["産んだ","うんだ"],["女","おんな"],["は"],["打ちしおれ","うちしおれ"],["、"],["その"],["息","いき"],["は"],["あえいだ"],["。"],["／"],["彼女","かのじょ"],["の"],["太陽","たいよう"],["は"],["、"],["まだ"],["昼","ひる"],["の"],["うち"],["に"],["没し","ぼっし"],["、"],["彼女","かのじょ"],["は"],["恥","はじ"],["を"],["見","み"],["、"],["はずかしめ"],["を"],["受けた","うけた"],["。"],["／"],["また"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["／"],["彼","かれ"],["ら"],["の"],["敵","てき"],["の"],["前","まえ"],["で"],["剣","けん"],["に"],["渡す","わたす"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":10,"text":"ああ、悲しいことだ。／私の母が私を産んだので、私は国中の争いの相手、けんかの相手となっている。／私は貸したことも、借りたこともないのに、みな、私をのろっている。","tok":[["ああ"],["、"],["悲しい","かなしい"],["こと"],["だ"],["。"],["／"],["私","わたくし"],["の"],["母","はは"],["が"],["私","わたくし"],["を"],["産んだ","うんだ"],["ので"],["、"],["私","わたくし"],["は"],["国中","くにちゅう"],["の"],["争い","あらそい"],["の"],["相手","あいて"],["、"],["けんか"],["の"],["相手","あいて"],["と"],["なって"],["いる"],["。"],["／"],["私","わたくし"],["は"],["貸した","かした"],["こと"],["も"],["、"],["借りた","かりた"],["こと"],["も"],["ない"],["のに"],["、"],["みな"],["、"],["私","わたくし"],["を"],["のろって"],["いる"],["。"]]},{"verse":11,"text":"主は仰せられた。／「必ずわたしはあなたを解き放って、しあわせにする。／必ずわたしは、わざわいの時、苦難の時に、敵があなたにとりなしを頼むようにする。","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["／"],["「"],["必ず","かならず"],["わたし"],["は"],["あなた"],["を"],["解き放って","ときはなって"],["、"],["しあわせ"],["に"],["する"],["。"],["／"],["必ず","かならず"],["わたし"],["は"],["、"],["わざわい"],["の"],["時","とき"],["、"],["苦難","くなん"],["の"],["時","とき"],["に"],["、"],["敵","てき"],["が"],["あなた"],["に"],["とり"],["なし"],["を"],["頼む","たのむ"],["よう"],["に"],["する"],["。"]]},{"verse":12,"text":"だれが鉄、北からの鉄や青銅を／砕くことができようか。","tok":[["だれ"],["が"],["鉄","てつ"],["、"],["北","きた"],["から"],["の"],["鉄","てつ"],["や"],["青銅","せいどう"],["を"],["／"],["砕く","くだく"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":13,"text":"わたしは、あなたの財宝、あなたの宝物を／獲物として、ただで引き渡す。／それは、あなたの国中で、あなたが犯した罪のためだ。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["財宝","ざいほう"],["、"],["あなた"],["の"],["宝物","たからもの"],["を"],["／"],["獲物","えもの"],["として"],["、"],["ただ"],["で"],["引き渡す","ひきわたす"],["。"],["／"],["それ"],["は"],["、"],["あなた"],["の"],["国中","くにちゅう"],["で"],["、"],["あなた"],["が"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["だ"],["。"]]},{"verse":14,"text":"わたしはあなたを／あなたの知らない国で敵に仕えさせる。／わたしの怒りによって火がつき、あなたがたに向かって燃えるからだ。」","tok":[["わたし"],["は"],["あなた"],["を"],["／"],["あなた"],["の"],["知らない","しらない"],["国","くに"],["で"],["敵","てき"],["に"],["仕えさせる","つかえさせる"],["。"],["／"],["わたし"],["の"],["怒り","いかり"],["によって"],["火","ひ"],["が"],["つき"],["、"],["あなた"],["がた"],["に"],["向かって","むかって"],["燃える","もえる"],["から"],["だ"],["。"],["」"]]},{"verse":15,"text":"主よ。あなたはご存じです。／私を思い出し、私を顧み、私を追う者たちに復讐してください。／あなたの御怒りをおそくして、私を取り去らないでください。／私があなたのためにそしりを受けているのを、知ってください。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["は"],["ご存じ","ごぞんじ"],["です"],["。"],["／"],["私","わたくし"],["を"],["思い出し","おもいだし"],["、"],["私","わたくし"],["を"],["顧み","かえりみ"],["、"],["私","わたくし"],["を"],["追う","おう"],["者","もの"],["たち"],["に"],["復讐","ふくしゅう"],["して"],["ください"],["。"],["／"],["あなた"],["の"],["御怒り","おいかり"],["を"],["おそく"],["して"],["、"],["私","わたくし"],["を"],["取り去らないで","とりさらないで"],["ください"],["。"],["／"],["私","わたくし"],["が"],["あなた"],["の"],["ため"],["に"],["そしり"],["を"],["受けて","うけて"],["いる"],["の"],["を"],["、"],["知って","しって"],["ください"],["。"]]},{"verse":16,"text":"私はあなたのみことばを見つけ出し、それを食べました。／あなたのみことばは、私にとって／楽しみとなり、心の喜びとなりました。／万軍の神、主よ。／私にはあなたの名がつけられているからです。","tok":[["私","わたくし"],["は"],["あなた"],["のみ"],["ことば"],["を"],["見つけ","みつけ"],["出し","だし"],["、"],["それ"],["を"],["食べました","たべました"],["。"],["／"],["あなた"],["のみ"],["ことば"],["は"],["、"],["私","わたくし"],["にとって"],["／"],["楽しみ","たのしみ"],["と"],["なり"],["、"],["心","こころ"],["の"],["喜び","よろこび"],["と"],["なりました"],["。"],["／"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["／"],["私","わたくし"],["に"],["は"],["あなた"],["の"],["名","な"],["が"],["つけられて"],["いる"],["から"],["です"],["。"]]},{"verse":17,"text":"私は、戯れる者たちの集まりにすわったことも、こおどりして喜んだこともありません。／私はあなたの御手によって、ひとりすわっていました。／あなたが憤りで私を満たされたからです。","tok":[["私","わたくし"],["は"],["、"],["戯れる","たわむれる"],["者","もの"],["たち"],["の"],["集まり","あつまり"],["に"],["すわった"],["こと"],["も"],["、"],["こおどり"],["して"],["喜んだ","よろこんだ"],["こと"],["も"],["ありません"],["。"],["／"],["私","わたくし"],["は"],["あなた"],["の"],["御手","おて"],["によって"],["、"],["ひとり"],["すわって"],["いました"],["。"],["／"],["あなた"],["が"],["憤り","いきどおり"],["で"],["私","わたくし"],["を"],["満たされた","みたされた"],["から"],["です"],["。"]]},{"verse":18,"text":"なぜ、私の痛みはいつまでも続き、私の打ち傷は直らず、いえようともしないのでしょう。／あなたは、私にとって、欺く者、当てにならない小川のようになられるのですか。","tok":[["なぜ"],["、"],["私","わたくし"],["の"],["痛み","いたみ"],["は"],["いつ"],["まで"],["も"],["続き","つづき"],["、"],["私","わたくし"],["の"],["打ち傷","うちきず"],["は"],["直らず","なおらず"],["、"],["いえよう"],["と"],["も"],["しない"],["の"],["でしょう"],["。"],["／"],["あなた"],["は"],["、"],["私","わたくし"],["にとって"],["、"],["欺く","あざむく"],["者","もの"],["、"],["当て","あて"],["に"],["ならない"],["小川","おがわ"],["の"],["よう"],["に"],["なられる"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"それゆえ、主はこう仰せられた。／「もし、あなたが帰って来るなら、わたしはあなたを帰らせ、わたしの前に立たせよう。／もし、あなたが、卑しいことではなく、尊いことを言うなら、あなたはわたしの口のようになる。／彼らがあなたのところに帰ることがあっても、あなたは彼らのところに帰ってはならない。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられた","おおせられた"],["。"],["／"],["「"],["もし"],["、"],["あなた"],["が"],["帰って","かえって"],["来るなら","くるなら"],["、"],["わたし"],["は"],["あなた"],["を"],["帰らせ","かえらせ"],["、"],["わたし"],["の"],["前","まえ"],["に"],["立たせよう","たたせよう"],["。"],["／"],["もし"],["、"],["あなた"],["が"],["、"],["卑しい","いやしい"],["こと"],["で"],["は"],["なく"],["、"],["尊い","とうとい"],["こと"],["を"],["言うなら","ゆうなら"],["、"],["あなた"],["は"],["わたし"],["の"],["口","くち"],["の"],["よう"],["に"],["なる"],["。"],["／"],["彼","かれ"],["ら"],["が"],["あなた"],["の"],["ところ"],["に"],["帰る","かえる"],["こと"],["が"],["あって"],["も"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["帰って","かえって"],["は"],["ならない"],["。"]]},{"verse":20,"text":"わたしはあなたを、この民に対し、堅固な青銅の城壁とする。／彼らは、あなたと戦っても、勝てない。／わたしがあなたとともにいて、あなたを救い、あなたを助け出すからだ。／――主の御告げ――","tok":[["わたし"],["は"],["あなた"],["を"],["、"],["この"],["民","たみ"],["に"],["対し","たいし"],["、"],["堅固","けんご"],["な"],["青銅","せいどう"],["の"],["城壁","じょうへき"],["と"],["する"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["と"],["戦って","たたかって"],["も"],["、"],["勝てない","かてない"],["。"],["／"],["わたし"],["が"],["あなた"],["と"],["とも"],["に"],["いて"],["、"],["あなた"],["を"],["救い","すくい"],["、"],["あなた"],["を"],["助け出す","たすけだす"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":21,"text":"また、わたしは、あなたを悪人どもの手から救い出し、横暴な者たちの手から助け出す。」","tok":[["また"],["、"],["わたし"],["は"],["、"],["あなた"],["を"],["悪人","あくにん"],["ども"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"],["横暴","おうぼう"],["な"],["者","もの"],["たち"],["の"],["手","て"],["から"],["助け出す","たすけだす"],["。"],["」"]]}]
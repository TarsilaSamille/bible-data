[{"verse":1,"text":"諸国の民について、預言者エレミヤにあった主のことば。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["について"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["あった"],["主","ぬし"],["の"],["ことば"],["。"]]},{"verse":2,"text":"エジプトについて、すなわちユーフラテス河畔のカルケミシュにいたエジプトの王パロ・ネコの軍勢について。ヨシヤの子、ユダの王エホヤキムの第四年に、バビロンの王ネブカデレザルはこれを打ち破った。","tok":[["エジプト"],["について"],["、"],["すなわち"],["ユーフラテス"],["河畔","かはん"],["の"],["カルケミシュ"],["に"],["いた"],["エジプト"],["の"],["王","おう"],["パロ"],["・"],["ネコ"],["の"],["軍勢","ぐんぜい"],["について"],["。"],["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["第","だい"],["四","よん"],["年","ねん"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["は"],["これ"],["を"],["打ち破った","うちやぶった"],["。"]]},{"verse":3,"text":"「盾と大盾を整えて、戦いに向かえ。","tok":[["「"],["盾","たて"],["と"],["大","だい"],["盾","たて"],["を"],["整えて","ととのえて"],["、"],["戦い","たたかい"],["に"],["向かえ","むかえ"],["。"]]},{"verse":4,"text":"騎兵よ。馬に鞍をつけて乗れ。／かぶとを着けて部署につけ。／槍をみがき、よろいを着よ。","tok":[["騎兵","きへい"],["よ"],["。"],["馬","うま"],["に"],["鞍","くら"],["を"],["つけて"],["乗れ","のれ"],["。"],["／"],["かぶと"],["を"],["着けて","つけて"],["部署","ぶしょ"],["に"],["つけ"],["。"],["／"],["槍","やり"],["を"],["みがき"],["、"],["よろい"],["を"],["着","き"],["よ"],["。"]]},{"verse":5,"text":"何ということか、この有様。／彼らはおののき、うしろに退く。／勇士たちは打たれ、うしろも振り向かずに逃げ去った。／恐れが回りにある。――主の御告げ――","tok":[["何","なん"],["と"],["いう"],["こと"],["か"],["、"],["この"],["有様","ありさま"],["。"],["／"],["彼","かれ"],["ら"],["は"],["おののき"],["、"],["うしろ"],["に"],["退く","しりぞく"],["。"],["／"],["勇士","ゆうし"],["たち"],["は"],["打たれ","うたれ"],["、"],["うしろ"],["も"],["振り向かず","ふりむかず"],["に"],["逃げ去った","にげさった"],["。"],["／"],["恐れ","おそれ"],["が"],["回り","まわり"],["に"],["ある"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":6,"text":"足の速い者も逃げることができない。／勇士たちものがれることができない。／北のほう、ユーフラテス川のほとりで、彼らはつまずき倒れた。","tok":[["足","あし"],["の"],["速い","はやい"],["者","もの"],["も"],["逃げる","にげる"],["こと"],["が"],["できない"],["。"],["／"],["勇士","ゆうし"],["たち"],["も"],["のがれる"],["こと"],["が"],["できない"],["。"],["／"],["北","きた"],["の"],["ほう"],["、"],["ユーフラテス"],["川","かわ"],["の"],["ほとり"],["で"],["、"],["彼","かれ"],["ら"],["は"],["つまずき"],["倒れた","たおれた"],["。"]]},{"verse":7,"text":"ナイル川のようにわき上がり、川々のように寄せては返すこの者はだれか。","tok":[["ナイル"],["川","かわ"],["の"],["よう"],["に"],["わき上がり","わきあがり"],["、"],["川","かわ"],["々"],["の"],["よう"],["に"],["寄せて","よせて"],["は"],["返す","かえす"],["この"],["者","もの"],["は"],["だれ"],["か"],["。"]]},{"verse":8,"text":"エジプトだ。――ナイル川のようにわき上がり、川々のように寄せては返す。／彼は言った。『わき上がって地をおおい、町も住民も滅ぼしてしまおう。』","tok":[["エジプト"],["だ"],["。"],["―"],["―"],["ナイル"],["川","かわ"],["の"],["よう"],["に"],["わき上がり","わきあがり"],["、"],["川","かわ"],["々"],["の"],["よう"],["に"],["寄せて","よせて"],["は"],["返す","かえす"],["。"],["／"],["彼","かれ"],["は"],["言った","いった"],["。"],["『"],["わき上がって","わきあがって"],["地","ち"],["を"],["おおい"],["、"],["町","まち"],["も"],["住民","じゅうみん"],["も"],["滅ぼして","ほろぼして"],["しまおう"],["。"],["』"]]},{"verse":9,"text":"馬よ、上れ。戦車よ、走れ。／勇士たちよ、出陣だ。／盾を取るクシュ人、プテ人、弓を引き張るルデ人よ。","tok":[["馬","うま"],["よ"],["、"],["上れ","のぼれ"],["。"],["戦車","せんしゃ"],["よ"],["、"],["走れ","はしれ"],["。"],["／"],["勇士","ゆうし"],["たち"],["よ"],["、"],["出陣","しゅつじん"],["だ"],["。"],["／"],["盾","たて"],["を"],["取る","とる"],["クシュ人","くしゅにん"],["、"],["プテ人","ぷてにん"],["、"],["弓","ゆみ"],["を"],["引き","ひき"],["張る","はる"],["ルデ人","るでにん"],["よ"],["。"]]},{"verse":10,"text":"その日は、万軍の神、主の日、仇に復讐する復讐の日。／剣は食らって飽き、彼らの血に酔う。／北の地、ユーフラテス川のほとりでは、万軍の神、主に、いけにえがささげられる。","tok":[["その"],["日","ひ"],["は"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["日","ひ"],["、"],["仇","あだ"],["に"],["復讐","ふくしゅう"],["する"],["復讐","ふくしゅう"],["の"],["日","ひ"],["。"],["／"],["剣","けん"],["は"],["食らって","くらって"],["飽き","あき"],["、"],["彼","かれ"],["ら"],["の"],["血","ち"],["に"],["酔う","よう"],["。"],["／"],["北","きた"],["の"],["地","ち"],["、"],["ユーフラテス"],["川","かわ"],["の"],["ほとり"],["で"],["は"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["いけにえ"],["が"],["ささげられる"],["。"]]},{"verse":11,"text":"おとめエジプトの娘よ。／ギルアデに上って乳香を取れ。／多くの薬を使ってもむなしい。／あなたはいやされない。","tok":[["おとめ"],["エジプト"],["の"],["娘","むすめ"],["よ"],["。"],["／"],["ギルアデ"],["に"],["上って","のぼって"],["乳香","にゅうこう"],["を"],["取れ","とれ"],["。"],["／"],["多く","おおく"],["の"],["薬","くすり"],["を"],["使って","つかって"],["も"],["むなしい"],["。"],["／"],["あなた"],["は"],["いやされない"],["。"]]},{"verse":12,"text":"国々は、あなたの恥を聞いた。／あなたの哀れな叫び声は地に満ちた。／勇士は勇士につまずき、共に倒れたからだ。」","tok":[["国々","くにぐに"],["は"],["、"],["あなた"],["の"],["恥","はじ"],["を"],["聞いた","きいた"],["。"],["／"],["あなた"],["の"],["哀れ","あわれ"],["な"],["叫び声","さけびごえ"],["は"],["地","ち"],["に"],["満ちた","みちた"],["。"],["／"],["勇士","ゆうし"],["は"],["勇士","ゆうし"],["に"],["つまずき"],["、"],["共","とも"],["に"],["倒れた","たおれた"],["から"],["だ"],["。"],["」"]]},{"verse":13,"text":"バビロンの王ネブカデレザルが来て、エジプトの国を打つことについて、主が預言者エレミヤに語られたみことば。","tok":[["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["来て","きて"],["、"],["エジプト"],["の"],["国","くに"],["を"],["打つ","うつ"],["こと"],["について"],["、"],["主","ぬし"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["語られた","かたられた"],["みことば"],["。"]]},{"verse":14,"text":"エジプトで告げ、ミグドルで聞かせ、ノフとタフパヌヘスで聞かせて言え。／「立ち上がって備えをせよ。／剣があなたの回りを食い尽くしたからだ。","tok":[["エジプト"],["で"],["告げ","つげ"],["、"],["ミグドル"],["で"],["聞かせ","きかせ"],["、"],["ノ"],["フと"],["タフパヌヘス"],["で"],["聞かせて","きかせて"],["言え","いえ"],["。"],["／"],["「"],["立ち上がって","たちあがって"],["備え","そなえ"],["を"],["せよ"],["。"],["／"],["剣","けん"],["が"],["あなた"],["の"],["回り","まわり"],["を"],["食い","くい"],["尽くした","つくした"],["から"],["だ"],["。"]]},{"verse":15,"text":"なぜ、あなたの雄牛は押し流されたのか。／立たなかったのか。／主が彼を追い払われたからだ。","tok":[["なぜ"],["、"],["あなた"],["の"],["雄牛","おうし"],["は"],["押し流された","おしながされた"],["の"],["か"],["。"],["／"],["立たなかった","たたなかった"],["の"],["か"],["。"],["／"],["主","ぬし"],["が"],["彼","かれ"],["を"],["追い払われた","おいはらわれた"],["から"],["だ"],["。"]]},{"verse":16,"text":"多くの者がつまずき、倒れた。／彼らは互いに言った。／『さあ、私たちの民のところ、生まれ故郷に帰ろう。／あのしいたげる者の剣を避けて。』","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["つまずき"],["、"],["倒れた","たおれた"],["。"],["／"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["／"],["『"],["さあ"],["、"],["私たち","わたしたち"],["の"],["民","たみ"],["の"],["ところ"],["、"],["生まれ","うまれ"],["故郷","こきょう"],["に"],["帰ろう","かえろう"],["。"],["／"],["あの"],["しいたげる"],["者","もの"],["の"],["剣","けん"],["を"],["避けて","さけて"],["。"],["』"]]},{"verse":17,"text":"彼らは、そこで叫んだ。／エジプトの王パロは、時期を逸して騒ぐ者。","tok":[["彼","かれ"],["ら"],["は"],["、"],["そこ"],["で"],["叫んだ","さけんだ"],["。"],["／"],["エジプト"],["の"],["王","おう"],["パロ"],["は"],["、"],["時期","じき"],["を"],["逸して","いっして"],["騒ぐ","さわぐ"],["者","もの"],["。"]]},{"verse":18,"text":"わたしは生きている。／――その名を万軍の主という王の御告げ――／彼は山々の中のタボルのように、海のほとりのカルメルのように、必ず来る。","tok":[["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["／"],["―"],["―"],["その"],["名","な"],["を"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["と"],["いう"],["王","おう"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["彼","かれ"],["は"],["山々","やまやま"],["の"],["中","なか"],["の"],["タボル"],["の"],["よう"],["に"],["、"],["海","うみ"],["の"],["ほとり"],["の"],["カルメル"],["の"],["よう"],["に"],["、"],["必ず","かならず"],["来る","くる"],["。"]]},{"verse":19,"text":"エジプトに住む娘よ。捕虜になる身支度をせよ。／ノフは荒れ果て、廃墟となって住む人もなくなるからだ。","tok":[["エジプト"],["に"],["住む","すむ"],["娘","むすめ"],["よ"],["。"],["捕虜","ほりょ"],["に"],["なる"],["身支度","みじたく"],["を"],["せよ"],["。"],["／"],["ノフ"],["は"],["荒れ果て","あれはて"],["、"],["廃墟","はいきょ"],["と"],["なって"],["住む","すむ"],["人","ひと"],["も"],["なくなる"],["から"],["だ"],["。"]]},{"verse":20,"text":"エジプトはかわいい雌の子牛。／北からあぶが襲って来る。","tok":[["エジプト"],["は"],["かわいい"],["雌","めす"],["の"],["子牛","こうし"],["。"],["／"],["北","きた"],["から"],["あぶ"],["が"],["襲って","おそって"],["来る","くる"],["。"]]},{"verse":21,"text":"その中にいた傭兵も、肥えた子牛のようだった。／彼らもまた、背を向けて共に逃げ、立ち止まろうともしなかった。／彼らの滅びの日、刑罰の時が、彼らの上に来たからだ。","tok":[["その"],["中","なか"],["に"],["いた"],["傭兵","ようへい"],["も"],["、"],["肥えた","こえた"],["子牛","こうし"],["の"],["よう"],["だった"],["。"],["／"],["彼","かれ"],["ら"],["も"],["また"],["、"],["背","せ"],["を"],["向けて","むけて"],["共","とも"],["に"],["逃げ","にげ"],["、"],["立ち止まろう","たちどまろう"],["と"],["も"],["しなかった"],["。"],["／"],["彼","かれ"],["ら"],["の"],["滅び","ほろび"],["の"],["日","ひ"],["、"],["刑罰","けいばつ"],["の"],["時","とき"],["が"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["来た","きた"],["から"],["だ"],["。"]]},{"verse":22,"text":"彼女の声は蛇のように消え去る。／彼らは軍勢を率いて来る。／きこりのように、斧を持って入って来る。","tok":[["彼女","かのじょ"],["の"],["声","こえ"],["は"],["蛇","へび"],["の"],["よう"],["に"],["消え去る","きえさる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["軍勢","ぐんぜい"],["を"],["率いて","ひきいて"],["来る","くる"],["。"],["／"],["きこり"],["の"],["よう"],["に"],["、"],["斧","おの"],["を"],["持って","もって"],["入って","はいって"],["来る","くる"],["。"]]},{"verse":23,"text":"彼らはその森を切り倒す。――主の御告げ――／それは測り知られず、いなごより多くて数えることができないからだ。","tok":[["彼","かれ"],["ら"],["は"],["その"],["森","もり"],["を"],["切り倒す","きりたおす"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["それ"],["は"],["測り知られず","はかりしられず"],["、"],["いなご"],["より"],["多くて","おおくて"],["数える","かぞえる"],["こと"],["が"],["できない"],["から"],["だ"],["。"]]},{"verse":24,"text":"娘エジプトは、はずかしめられ、北の民の手に渡された。」","tok":[["娘","むすめ"],["エジプト"],["は"],["、"],["はずかしめられ"],["、"],["北","きた"],["の"],["民","たみ"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"],["」"]]},{"verse":25,"text":"イスラエルの神、万軍の主は、仰せられる。「見よ。わたしは、ノのアモンと、パロとエジプト、その神々と王たち、パロと彼に拠り頼む者たちとを罰する。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["ノ"],["の"],["アモン"],["と"],["、"],["パロ"],["と"],["エジプト"],["、"],["その"],["神々","かみがみ"],["と"],["王","おう"],["たち"],["、"],["パロ"],["と"],["彼","かれ"],["に"],["拠り","より"],["頼む","たのむ"],["者","もの"],["たち"],["と"],["を"],["罰する","ばっする"],["。"]]},{"verse":26,"text":"わたしは彼らを、そのいのちをねらっている者たちの手、すなわちバビロンの王ネブカデレザルの手とその家来たちの手に渡す。その後、エジプトは、昔の日のように人が住むようになる。――主の御告げ――","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["その"],["いのち"],["を"],["ねらって"],["いる"],["者","もの"],["たち"],["の"],["手","て"],["、"],["すなわち"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["手","て"],["と"],["その"],["家来","けらい"],["たち"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["その"],["後","ご"],["、"],["エジプト"],["は"],["、"],["昔","むかし"],["の"],["日","ひ"],["の"],["よう"],["に"],["人","ひと"],["が"],["住む","すむ"],["よう"],["に"],["なる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":27,"text":"わたしのしもべヤコブよ。恐れるな。／イスラエルよ。おののくな。／見よ。わたしが、あなたを遠くから、あなたの子孫を捕囚の地から、救うからだ。／ヤコブは帰って来て、平穏に安らかに生き、おびえさせる者はだれもいない。","tok":[["わたし"],["の"],["しもべ"],["ヤコブ"],["よ"],["。"],["恐れる","おそれる"],["な"],["。"],["／"],["イスラエル"],["よ"],["。"],["おののく"],["な"],["。"],["／"],["見","み"],["よ"],["。"],["わたし"],["が"],["、"],["あなた"],["を"],["遠く","とおく"],["から"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["捕囚","ほしゅう"],["の"],["地","ち"],["から"],["、"],["救う","すくう"],["から"],["だ"],["。"],["／"],["ヤコブ"],["は"],["帰って","かえって"],["来て","きて"],["、"],["平穏","へいおん"],["に"],["安らか","やすらか"],["に"],["生き","いき"],["、"],["おびえ"],["させる"],["者","もの"],["は"],["だれ"],["も"],["いない"],["。"]]},{"verse":28,"text":"わたしのしもべヤコブよ。恐れるな。／――主の御告げ――／わたしがあなたとともにいるからだ。／わたしは、あなたを追いやった先の／すべての国々を滅ぼし尽くすからだ。／わたしはあなたを滅ぼし尽くさない。／公義によって、あなたを懲らしめ、あなたを罰せずにおくことは決してないが。」","tok":[["わたし"],["の"],["しもべ"],["ヤコブ"],["よ"],["。"],["恐れる","おそれる"],["な"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["が"],["あなた"],["と"],["とも"],["に"],["いる"],["から"],["だ"],["。"],["／"],["わたし"],["は"],["、"],["あなた"],["を"],["追いやった","おいやった"],["先","さき"],["の"],["／"],["すべて"],["の"],["国々","くにぐに"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["から"],["だ"],["。"],["／"],["わたし"],["は"],["あなた"],["を"],["滅ぼし","ほろぼし"],["尽くさない","つくさない"],["。"],["／"],["公義","きみよし"],["によって"],["、"],["あなた"],["を"],["懲らしめ","こらしめ"],["、"],["あなた"],["を"],["罰せず","ばっせず"],["に"],["おく"],["こと"],["は"],["決して","けっして"],["ない"],["が"],["。"],["」"]]}]
[{"verse":1,"text":"ユダの王ゼデキヤの第十年、すなわち、ネブカデレザルの第十八年に、主からエレミヤにあったみことば。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["第","だい"],["十","じゅう"],["年","ねん"],["、"],["すなわち"],["、"],["ネブカデレザル"],["の"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["に"],["、"],["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["。"]]},{"verse":2,"text":"そのとき、バビロンの王の軍勢がエルサレムを包囲中で、預言者エレミヤは、ユダの王の家にある監視の庭に監禁されていた。","tok":[["その"],["とき"],["、"],["バビロン"],["の"],["王","おう"],["の"],["軍勢","ぐんぜい"],["が"],["エルサレム"],["を"],["包囲中","ほういちゅう"],["で"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["、"],["ユダ"],["の"],["王","おう"],["の"],["家","いえ"],["に"],["ある"],["監視","かんし"],["の"],["庭","にわ"],["に"],["監禁","かんきん"],["されて"],["いた"],["。"]]},{"verse":3,"text":"彼が監禁されたのは、ユダの王ゼデキヤがエレミヤに、「なぜ、あなたは預言をするのか」と尋ねたとき、エレミヤが次のように答えたからである。「主はこう仰せられる。『見よ。わたしはこの町をバビロンの王の手に渡す。それで、彼はこれを攻め取る。","tok":[["彼","かれ"],["が"],["監禁","かんきん"],["された"],["の"],["は"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["が"],["エレミヤ"],["に"],["、"],["「"],["なぜ"],["、"],["あなた"],["は"],["預言","よげん"],["を"],["する"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["とき"],["、"],["エレミヤ"],["が"],["次","つぎ"],["の"],["よう"],["に"],["答えた","こたえた"],["から"],["で"],["ある"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["この"],["町","まち"],["を"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["それ"],["で"],["、"],["彼","かれ"],["は"],["これ"],["を"],["攻め取る","せめとる"],["。"]]},{"verse":4,"text":"ユダの王ゼデキヤは、カルデヤ人の手からのがれることはできない。彼は必ずバビロンの王の手に渡され、彼と口と口で語り、目と目で、彼を見る。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["は"],["、"],["カルデヤ"],["人","にん"],["の"],["手","て"],["から"],["のがれる"],["こと"],["は"],["できない"],["。"],["彼","かれ"],["は"],["必ず","かならず"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["彼","かれ"],["と"],["口","くち"],["と"],["口","くち"],["で"],["語り","かたり"],["、"],["目","め"],["と"],["目","め"],["で"],["、"],["彼","かれ"],["を"],["見る","みる"],["。"]]},{"verse":5,"text":"彼はまた、ゼデキヤをバビロンへ連れて行く。それでゼデキヤは、わたしが彼を顧みる時まで、そこにいる。――主の御告げ――あなたがたはカルデヤ人と戦っても、勝つことはできない。』」","tok":[["彼","かれ"],["は"],["また"],["、"],["ゼデキヤ"],["を"],["バビロン"],["へ"],["連れて","つれて"],["行く","いく"],["。"],["それ"],["で"],["ゼデキヤ"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["を"],["顧みる","かえりみる"],["時","とき"],["まで"],["、"],["そこ"],["に"],["いる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["あなた"],["がた"],["は"],["カルデヤ"],["人","にん"],["と"],["戦って","たたかって"],["も"],["、"],["勝つ","かつ"],["こと"],["は"],["できない"],["。"],["』"],["」"]]},{"verse":6,"text":"そのとき、エレミヤは言った。「私に次のような主のことばがあった。","tok":[["その"],["とき"],["、"],["エレミヤ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":7,"text":"見よ。あなたのおじシャルムの子ハナムエルが、あなたのところに来て、『アナトテにある私の畑を買ってくれ。あなたには買い戻す権利があるのだから』と言おう。","tok":[["見","み"],["よ"],["。"],["あなた"],["の"],["おじ"],["シャルム"],["の"],["子","こ"],["ハナムエル"],["が"],["、"],["あなた"],["の"],["ところ"],["に"],["来て","きて"],["、"],["『"],["アナトテ"],["に"],["ある"],["私","わたくし"],["の"],["畑","はたけ"],["を"],["買って","かって"],["くれ"],["。"],["あなた"],["に"],["は"],["買い戻す","かいもどす"],["権利","けんり"],["が"],["ある"],["の"],["だ"],["から"],["』"],["と"],["言おう","いおう"],["。"]]},{"verse":8,"text":"すると、主のことばのとおり、おじの子ハナムエルが私のところ、監視の庭に来て、私に言った。『どうか、ベニヤミンの地のアナトテにある私の畑を買ってください。あなたには所有権もあり、買い戻す権利もありますから、あなたが買い取ってください。』私は、それが主のことばであると知った。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["ことば"],["の"],["とおり"],["、"],["おじ"],["の"],["子","こ"],["ハナムエル"],["が"],["私","わたくし"],["の"],["ところ"],["、"],["監視","かんし"],["の"],["庭","にわ"],["に"],["来て","きて"],["、"],["私","わたくし"],["に"],["言った","いった"],["。"],["『"],["どう"],["か"],["、"],["ベニヤミン"],["の"],["地","ち"],["の"],["アナトテ"],["に"],["ある"],["私","わたくし"],["の"],["畑","はたけ"],["を"],["買って","かって"],["ください"],["。"],["あなた"],["に"],["は"],["所有権","しょゆうけん"],["も"],["あり"],["、"],["買い戻す","かいもどす"],["権利","けんり"],["も"],["あります"],["から"],["、"],["あなた"],["が"],["買い取って","かいとって"],["ください"],["。"],["』"],["私","わたくし"],["は"],["、"],["それ"],["が"],["主","ぬし"],["の"],["ことば"],["で"],["ある"],["と"],["知った","しった"],["。"]]},{"verse":9,"text":"そこで私は、おじの子ハナムエルから、アナトテにある畑を買い取り、彼に銀十七シェケルを払った。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["おじ"],["の"],["子","こ"],["ハナムエル"],["から"],["、"],["アナトテ"],["に"],["ある"],["畑","はたけ"],["を"],["買い取り","かいとり"],["、"],["彼","かれ"],["に"],["銀","ぎん"],["十七","じゅうなな"],["シェケル"],["を"],["払った","はらった"],["。"]]},{"verse":10,"text":"すなわち、証書に署名し、それに封印し、証人を立て、はかりで銀を量り、","tok":[["すなわち"],["、"],["証書","しょうしょ"],["に"],["署名","しょめい"],["し"],["、"],["それ"],["に"],["封印","ふういん"],["し"],["、"],["証人","しょうにん"],["を"],["立て","たて"],["、"],["はかり"],["で"],["銀","ぎん"],["を"],["量り","はかり"],["、"]]},{"verse":11,"text":"命令と規則に従って、封印された購入証書と、封印のない証書を取り、","tok":[["命令","めいれい"],["と"],["規則","きそく"],["に"],["従って","したがって"],["、"],["封印","ふういん"],["された"],["購入","こうにゅう"],["証書","しょうしょ"],["と"],["、"],["封印","ふういん"],["の"],["ない"],["証書","しょうしょ"],["を"],["取り","とり"],["、"]]},{"verse":12,"text":"おじの子ハナムエルと、購入証書に署名した証人たちと、監視の庭に座しているすべてのユダヤ人の前で、購入証書をマフセヤの子ネリヤの子バルクに渡し、","tok":[["おじ"],["の"],["子","こ"],["ハナムエル"],["と"],["、"],["購入","こうにゅう"],["証書","しょうしょ"],["に"],["署名","しょめい"],["した"],["証人","しょうにん"],["たち"],["と"],["、"],["監視","かんし"],["の"],["庭","にわ"],["に"],["座して","ざして"],["いる"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["の"],["前","まえ"],["で"],["、"],["購入","こうにゅう"],["証書","しょうしょ"],["を"],["マフセヤ"],["の"],["子","こ"],["ネリヤ"],["の"],["子","こ"],["バルク"],["に"],["渡し","わたし"],["、"]]},{"verse":13,"text":"彼らの前で、バルクに命じて言った。","tok":[["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["、"],["バルク"],["に"],["命じて","めいじて"],["言った","いった"],["。"]]},{"verse":14,"text":"『イスラエルの神、万軍の主は、こう仰せられる。これらの証書、すなわち封印されたこの購入証書と、封印のない証書を取って、土の器の中に入れ、これを長い間、保存せよ。","tok":[["『"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["これ"],["ら"],["の"],["証書","しょうしょ"],["、"],["すなわち"],["封印","ふういん"],["された"],["この"],["購入","こうにゅう"],["証書","しょうしょ"],["と"],["、"],["封印","ふういん"],["の"],["ない"],["証書","しょうしょ"],["を"],["取って","とって"],["、"],["土","つち"],["の"],["器","うつわ"],["の"],["中","なか"],["に"],["入れ","いれ"],["、"],["これ"],["を"],["長い","ながい"],["間","あいだ"],["、"],["保存","ほぞん"],["せよ"],["。"]]},{"verse":15,"text":"まことに、イスラエルの神、万軍の主は、こう仰せられる。再びこの国で、家や、畑や、ぶどう畑が買われるようになるのだ』と。」","tok":[["まこと"],["に"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["再び","ふたたび"],["この"],["国","くに"],["で"],["、"],["家","いえ"],["や"],["、"],["畑","はたけ"],["や"],["、"],["ぶどう"],["畑","はたけ"],["が"],["買われる","かわれる"],["よう"],["に"],["なる"],["の"],["だ"],["』"],["と"],["。"],["」"]]},{"verse":16,"text":"私は、購入証書をネリヤの子バルクに渡して後、主に祈って言った。","tok":[["私","わたくし"],["は"],["、"],["購入","こうにゅう"],["証書","しょうしょ"],["を"],["ネリヤ"],["の"],["子","こ"],["バルク"],["に"],["渡して","わたして"],["後","あと"],["、"],["主に","おもに"],["祈って","いのって"],["言った","いった"],["。"]]},{"verse":17,"text":"「ああ、神、主よ。まことに、あなたは大きな力と、伸ばした御腕とをもって天と地を造られました。あなたには何一つできないことはありません。","tok":[["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["まこと"],["に"],["、"],["あなた"],["は"],["大きな","おおきな"],["力","ちから"],["と"],["、"],["伸ばした","のばした"],["御腕","おうで"],["と"],["を"],["もって"],["天","てん"],["と"],["地","ち"],["を"],["造られました","つくられました"],["。"],["あなた"],["に"],["は"],["何","なん"],["一","ひと"],["つ"],["できない"],["こと"],["は"],["ありません"],["。"]]},{"verse":18,"text":"あなたは、恵みを千代にまで施し、先祖の咎をその後の子らのふところに報いる方、偉大な力強い神、その名は万軍の主です。","tok":[["あなた"],["は"],["、"],["恵み","めぐみ"],["を"],["千代","ちよ"],["に"],["まで"],["施し","ほどこし"],["、"],["先祖","せんぞ"],["の"],["咎","とが"],["を"],["その後","そのあと"],["の"],["子","こ"],["ら"],["の"],["ふところ"],["に"],["報いる","むくいる"],["方","かた"],["、"],["偉大","いだい"],["な"],["力強い","ちからづよい"],["神","かみ"],["、"],["その"],["名","な"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["です"],["。"]]},{"verse":19,"text":"おもんぱかりは大きく、みわざは力があり、御目は人の子のすべての道に開いており、人それぞれの生き方にしたがい、行いの結ぶ実にしたがって、すべてに報いをされます。","tok":[["おもんぱかり"],["は"],["大きく","おおきく"],["、"],["みわざ"],["は"],["力","ちから"],["が"],["あり"],["、"],["御目","おめ"],["は"],["人","ひと"],["の"],["子","こ"],["の"],["すべて"],["の"],["道","みち"],["に"],["開いて","ひらいて"],["おり"],["、"],["人","ひと"],["それぞれ"],["の"],["生き方","いきかた"],["に"],["したがい"],["、"],["行い","おこない"],["の"],["結ぶ","むすぶ"],["実","じつ"],["に"],["したがって"],["、"],["すべて"],["に"],["報い","むくい"],["を"],["されます"],["。"]]},{"verse":20,"text":"あなたは今日まで、エジプトの国で、イスラエルと、人の中で、しるしと不思議を行われ、ご自身の名を、今日のようにされました。","tok":[["あなた"],["は"],["今日","きょう"],["まで"],["、"],["エジプト"],["の"],["国","くに"],["で"],["、"],["イスラエル"],["と"],["、"],["人","ひと"],["の"],["中","なか"],["で"],["、"],["しるし"],["と"],["不思議","ふしぎ"],["を"],["行われ","おこなわれ"],["、"],["ご自身","ごじしん"],["の"],["名","な"],["を"],["、"],["今日","きょう"],["の"],["よう"],["に"],["されました"],["。"]]},{"verse":21,"text":"あなたはまた、御民イスラエルを、しるしと、不思議と、強い御手と、伸べた御腕と、大いなる恐れとをもって、エジプトの国から連れ出し、","tok":[["あなた"],["は"],["また"],["、"],["御民","ごみん"],["イスラエル"],["を"],["、"],["しるし"],["と"],["、"],["不思議","ふしぎ"],["と"],["、"],["強い","つよい"],["御手","おて"],["と"],["、"],["伸べた","のべた"],["御腕","おうで"],["と"],["、"],["大いなる","おおいなる"],["恐れ","おそれ"],["と"],["を"],["もって"],["、"],["エジプト"],["の"],["国","くに"],["から"],["連れ出し","つれだし"],["、"]]},{"verse":22,"text":"あなたが彼らの先祖に与えると誓われたこの国、乳と蜜の流れる国を彼らに授けられました。","tok":[["あなた"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["に"],["与える","あたえる"],["と"],["誓われた","ちかわれた"],["この"],["国","くに"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["国","くに"],["を"],["彼","かれ"],["ら"],["に"],["授けられました","さずけられました"],["。"]]},{"verse":23,"text":"彼らは、そこに行って、これを所有しましたが、あなたの声に聞き従わず、あなたの律法に歩まず、あなたが彼らにせよと命じた事を何一つ行わなかったので、あなたは彼らを、このようなあらゆるわざわいに会わせなさいました。","tok":[["彼","かれ"],["ら"],["は"],["、"],["そこ"],["に"],["行って","いって"],["、"],["これ"],["を"],["所有","しょゆう"],["しました"],["が"],["、"],["あなた"],["の"],["声","こえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["あなた"],["の"],["律法","りっぽう"],["に"],["歩まず","あゆまず"],["、"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["せよ"],["と"],["命じた","めいじた"],["事","こと"],["を"],["何","なん"],["一","ひと"],["つ"],["行わなかった","おこなわなかった"],["ので"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["、"],["この"],["よう"],["な"],["あらゆる"],["わざわい"],["に"],["会わせ","あわせ"],["なさいました"],["。"]]},{"verse":24,"text":"ご覧ください。この町を攻め取ろうとして、塁が築かれました。この町は、剣とききんと疫病のために、攻めているカルデヤ人の手に渡されようとしています。あなたの告げられた事は成就しました。ご覧のとおりです。","tok":[["ご覧","ごらん"],["ください"],["。"],["この"],["町","まち"],["を"],["攻め取ろう","せめとろう"],["として"],["、"],["塁","るい"],["が"],["築かれました","きずかれました"],["。"],["この"],["町","まち"],["は"],["、"],["剣","けん"],["と"],["ききん"],["と"],["疫病","やくびょう"],["の"],["ため"],["に"],["、"],["攻めて","せめて"],["いる"],["カルデヤ"],["人","にん"],["の"],["手","て"],["に"],["渡されよう","わたされよう"],["として"],["います"],["。"],["あなた"],["の"],["告げられた","つげられた"],["事","こと"],["は"],["成就","じょうじゅ"],["しました"],["。"],["ご覧","ごらん"],["の"],["とおり"],["です"],["。"]]},{"verse":25,"text":"神、主よ。あなたはこの町がカルデヤ人の手に渡されようとしているのに、私に、『銀を払ってあの畑を買い、証人を立てよ』と仰せられます。」","tok":[["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["この"],["町","まち"],["が"],["カルデヤ"],["人","にん"],["の"],["手","て"],["に"],["渡されよう","わたされよう"],["として"],["いる"],["のに"],["、"],["私","わたくし"],["に"],["、"],["『"],["銀","ぎん"],["を"],["払って","はらって"],["あの"],["畑","はたけ"],["を"],["買い","かい"],["、"],["証人","しょうにん"],["を"],["立てよ","たてよ"],["』"],["と"],["仰せられます","おおせられます"],["。"],["」"]]},{"verse":26,"text":"エレミヤに次のような主のことばがあった。","tok":[["エレミヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":27,"text":"「見よ。わたしは、すべての肉なる者の神、主である。わたしにとってできないことが一つでもあろうか。」","tok":[["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["にとって"],["できない"],["こと"],["が"],["一","ひと"],["つ"],["で"],["も"],["あろう"],["か"],["。"],["」"]]},{"verse":28,"text":"「それゆえ、主はこう仰せられる。見よ。わたしはこの町を、カルデヤ人の手と、バビロンの王ネブカデレザルの手に渡す。彼はこれを取ろう。","tok":[["「"],["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["この"],["町","まち"],["を"],["、"],["カルデヤ"],["人","にん"],["の"],["手","て"],["と"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["これ"],["を"],["取ろう","とろう"],["。"]]},{"verse":29,"text":"また、この町を攻めているカルデヤ人は、来て、この町に火をつけて焼く。また、人々が屋上でバアルに香をたき、ほかの神々に注ぎのぶどう酒を注いで、わたしの怒りを引き起こしたその家々にも火をつけて焼く。","tok":[["また"],["、"],["この"],["町","まち"],["を"],["攻めて","せめて"],["いる"],["カルデヤ"],["人","にん"],["は"],["、"],["来て","きて"],["、"],["この"],["町","まち"],["に"],["火","ひ"],["を"],["つけて"],["焼く","やく"],["。"],["また"],["、"],["人々","ひとびと"],["が"],["屋上","おくじょう"],["で"],["バアル"],["に"],["香","こう"],["を"],["たき"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注いで","そそいで"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こした","ひきおこした"],["その"],["家々","いえいえ"],["に"],["も"],["火","ひ"],["を"],["つけて"],["焼く","やく"],["。"]]},{"verse":30,"text":"なぜなら、イスラエルの子らとユダの子らは、若いころから、わたしの目の前に悪のみを行い、イスラエルの子らは、その手のわざをもってわたしの怒りを引き起こすのみであったからだ。――主の御告げ――","tok":[["なぜ"],["なら"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["と"],["ユダ"],["の"],["子","こ"],["ら"],["は"],["、"],["若い","わかい"],["ころ"],["から"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["のみ"],["を"],["行い","おこない"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["は"],["、"],["その"],["手","て"],["の"],["わざ"],["を"],["もって"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こす","ひきおこす"],["のみ"],["で"],["あった"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":31,"text":"この町は、建てられた日から今日まで、わたしの怒りと憤りを引き起こしてきたので、わたしはこれをわたしの顔の前から取り除く。","tok":[["この"],["町","まち"],["は"],["、"],["建てられた","たてられた"],["日","ひ"],["から"],["今日","きょう"],["まで"],["、"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["を"],["引き起こして","ひきおこして"],["きた"],["ので"],["、"],["わたし"],["は"],["これ"],["を"],["わたし"],["の"],["顔","かお"],["の"],["前","まえ"],["から"],["取り除く","とりのぞく"],["。"]]},{"verse":32,"text":"それは、イスラエルの子らとユダの子らが、すなわち彼ら自身と、その王、首長、祭司、預言者が、またユダの人もエルサレムの住民も、わたしの怒りを引き起こすために行った、すべての悪のゆえである。","tok":[["それ"],["は"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["と"],["ユダ"],["の"],["子","こ"],["ら"],["が"],["、"],["すなわち"],["彼","かれ"],["ら"],["自身","じしん"],["と"],["、"],["その"],["王","おう"],["、"],["首長","しゅちょう"],["、"],["祭司","さいし"],["、"],["預言者","よげんしゃ"],["が"],["、"],["また"],["ユダ"],["の"],["人","ひと"],["も"],["エルサレム"],["の"],["住民","じゅうみん"],["も"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こす","ひきおこす"],["ため"],["に"],["行った","いった"],["、"],["すべて"],["の"],["悪","あく"],["の"],["ゆえ"],["で"],["ある"],["。"]]},{"verse":33,"text":"彼らはわたしに、顔ではなくて背を向け、わたしがしきりに彼らに教えるが、聞いて懲らしめを受ける者もなく、","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["に"],["、"],["顔","かお"],["で"],["は"],["なくて"],["背","せ"],["を"],["向け","むけ"],["、"],["わたし"],["が"],["しきり"],["に"],["彼","かれ"],["ら"],["に"],["教える","おしえる"],["が"],["、"],["聞いて","きいて"],["懲らしめ","こらしめ"],["を"],["受ける","うける"],["者","もの"],["も"],["なく"],["、"]]},{"verse":34,"text":"わたしの名がつけられている宮に忌むべき物を置いて、これを汚し、","tok":[["わたし"],
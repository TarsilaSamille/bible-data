[{"verse":1,"text":"パロがまだガザを打たないうちに、ペリシテ人について、預言者エレミヤにあった主のことば。","tok":[["パロ"],["が"],["まだ"],["ガザ"],["を"],["打たない","うたない"],["うち"],["に"],["、"],["ペリシテ"],["人","にん"],["について"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["あった"],["主","ぬし"],["の"],["ことば"],["。"]]},{"verse":2,"text":"主はこう仰せられる。／「見よ。北から水が上って来て、あふれる流れとなり、地と、それに満ちるもの、町とその住民とにあふれかかる。／人々は泣き叫び、地の住民はみな泣きわめく。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["見","み"],["よ"],["。"],["北","きた"],["から"],["水","みず"],["が"],["上って","のぼって"],["来て","きて"],["、"],["あふれる"],["流れ","ながれ"],["と"],["なり"],["、"],["地","ち"],["と"],["、"],["それ"],["に"],["満ちる","みちる"],["もの"],["、"],["町","まち"],["と"],["その"],["住民","じゅうみん"],["と"],["に"],["あふれ"],["かかる"],["。"],["／"],["人々","ひとびと"],["は"],["泣き叫び","なきさけび"],["、"],["地","ち"],["の"],["住民","じゅうみん"],["は"],["みな"],["泣きわめく","なきわめく"],["。"]]},{"verse":3,"text":"荒馬のひづめの音、戦車の響き、車輪の騒音のため、父たちは気力を失って、子らを顧みない。","tok":[["荒馬","あらうま"],["の"],["ひづめ"],["の"],["音","おと"],["、"],["戦車","せんしゃ"],["の"],["響き","ひびき"],["、"],["車輪","しゃりん"],["の"],["騒音","そうおん"],["の"],["ため"],["、"],["父","ちち"],["たち"],["は"],["気力","きりょく"],["を"],["失って","うしなって"],["、"],["子","こ"],["ら"],["を"],["顧みない","かえりみない"],["。"]]},{"verse":4,"text":"すべてのペリシテ人を破滅させる日が／来たからだ。／その日には、ツロとシドンを、生き残って助ける者もみな、断ち滅ぼされる。／主が、カフトルの島に残っているペリシテ人も／破滅させるからだ。","tok":[["すべて"],["の"],["ペリシテ"],["人","にん"],["を"],["破滅","はめつ"],["させる"],["日","ひ"],["が"],["／"],["来た","きた"],["から"],["だ"],["。"],["／"],["その"],["日","ひ"],["に"],["は"],["、"],["ツロ"],["と"],["シドン"],["を"],["、"],["生き残って","いきのこって"],["助ける","たすける"],["者","もの"],["も"],["みな"],["、"],["断ち","たち"],["滅ぼされる","ほろぼされる"],["。"],["／"],["主","ぬし"],["が"],["、"],["カフトル"],["の"],["島","しま"],["に"],["残って","のこって"],["いる"],["ペリシテ"],["人","にん"],["も"],["／"],["破滅","はめつ"],["させる"],["から"],["だ"],["。"]]},{"verse":5,"text":"ガザは頭をそられ、アシュケロンは滅びうせた。／アナク人の残りの者よ。／いつまで、あなたは身を傷つけるのか。」","tok":[["ガザ"],["は"],["頭","あたま"],["を"],["そられ"],["、"],["アシュケロン"],["は"],["滅び","ほろび"],["うせた"],["。"],["／"],["アナク人","あなくにん"],["の"],["残り","のこり"],["の"],["者","もの"],["よ"],["。"],["／"],["いつ"],["まで"],["、"],["あなた"],["は"],["身","み"],["を"],["傷つける","きずつける"],["の"],["か"],["。"],["」"]]},{"verse":6,"text":"「ああ。主の剣よ。／いつまで、おまえは休まないのか。／さやに納まり、静かに休め。」","tok":[["「"],["ああ"],["。"],["主","ぬし"],["の"],["剣","けん"],["よ"],["。"],["／"],["いつ"],["まで"],["、"],["おまえ"],["は"],["休まない","やすまない"],["の"],["か"],["。"],["／"],["さや"],["に"],["納まり","おさまり"],["、"],["静か","しずか"],["に"],["休め","やすめ"],["。"],["」"]]},{"verse":7,"text":"どうして、おまえは休めよう。／主が剣に命じられたのだ。／アシュケロンとその海岸――／そこに剣を向けられたのだ。","tok":[["どう"],["して"],["、"],["おまえ"],["は"],["休めよう","やすめよう"],["。"],["／"],["主","ぬし"],["が"],["剣","けん"],["に"],["命じられた","めいじられた"],["の"],["だ"],["。"],["／"],["アシュケロン"],["と"],["その"],["海岸","かいがん"],["―"],["―"],["／"],["そこ"],["に"],["剣","けん"],["を"],["向けられた","むけられた"],["の"],["だ"],["。"]]}]
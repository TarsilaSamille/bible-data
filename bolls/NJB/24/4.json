[{"verse":1,"text":"「イスラエルよ。もし帰るのなら、――主の御告げ――／わたしのところに帰って来い。／もし、あなたが忌むべき物を／わたしの前から除くなら、あなたは迷うことはない。","tok":[["「"],["イスラエル"],["よ"],["。"],["もし"],["帰る","かえる"],["の"],["なら"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["の"],["ところ"],["に"],["帰って","かえって"],["来い","こい"],["。"],["／"],["もし"],["、"],["あなた"],["が"],["忌むべき","いむべき"],["物","もの"],["を"],["／"],["わたし"],["の"],["前","まえ"],["から"],["除くなら","のぞくなら"],["、"],["あなた"],["は"],["迷う","まよう"],["こと"],["は"],["ない"],["。"]]},{"verse":2,"text":"あなたが真実と公義と正義とによって／『主は生きておられる』と誓うなら、国々は主によって互いに祝福し合い、主によって誇り合う。」","tok":[["あなた"],["が"],["真実","しんじつ"],["と"],["公義","きみよし"],["と"],["正義","まさよし"],["と"],["によって"],["／"],["『"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["誓うなら","ちかうなら"],["、"],["国々","くにぐに"],["は"],["主に","おもに"],["よって"],["互い","たがい"],["に"],["祝福","しゅくふく"],["し"],["合い","あい"],["、"],["主に","おもに"],["よって"],["誇り","ほこり"],["合う","あう"],["。"],["」"]]},{"verse":3,"text":"まことに主は、ユダの人とエルサレムとに、こう仰せられる。／「耕地を開拓せよ。いばらの中に種を蒔くな。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["、"],["ユダ"],["の"],["人","ひと"],["と"],["エルサレム"],["と"],["に"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["耕地","こうち"],["を"],["開拓","かいたく"],["せよ"],["。"],["いばら"],["の"],["中","なか"],["に"],["種","しゅ"],["を"],["蒔く","まく"],["な"],["。"]]},{"verse":4,"text":"ユダの人とエルサレムの住民よ。／主のために割礼を受け、心の包皮を取り除け。／さもないと、あなたがたの悪い行いのため、わたしの憤りが火のように出て燃え上がり、消す者もいないだろう。」","tok":[["ユダ"],["の"],["人","ひと"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["よ"],["。"],["／"],["主","ぬし"],["の"],["ため"],["に"],["割礼","かつれい"],["を"],["受け","うけ"],["、"],["心","こころ"],["の"],["包皮","ほうひ"],["を"],["取り除け","とりのぞけ"],["。"],["／"],["さも"],["ない"],["と"],["、"],["あなた"],["がた"],["の"],["悪い","わるい"],["行い","おこない"],["の"],["ため"],["、"],["わたし"],["の"],["憤り","いきどおり"],["が"],["火","ひ"],["の"],["よう"],["に"],["出て","でて"],["燃え上がり","もえあがり"],["、"],["消す","けす"],["者","もの"],["も"],["いないだろう"],["。"],["」"]]},{"verse":5,"text":"「ユダに告げ、エルサレムに聞かせて言え。／国中に角笛を吹け。大声で叫んで言え。／『集まれ。城壁のある町に行こう。』","tok":[["「"],["ユダ"],["に"],["告げ","つげ"],["、"],["エルサレム"],["に"],["聞かせて","きかせて"],["言え","いえ"],["。"],["／"],["国中","くにちゅう"],["に"],["角笛","つのぶえ"],["を"],["吹け","ふけ"],["。"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["言え","いえ"],["。"],["／"],["『"],["集まれ","あつまれ"],["。"],["城壁","じょうへき"],["の"],["ある"],["町","まち"],["に"],["行こう","いこう"],["。"],["』"]]},{"verse":6,"text":"シオンのほうに旗を掲げよ。／のがれよ。立ち止まるな。／わたしがわざわいを北からもたらし、大いなる破滅をもたらすから。","tok":[["シオン"],["の"],["ほう"],["に"],["旗","はた"],["を"],["掲げ","かかげ"],["よ"],["。"],["／"],["のがれ"],["よ"],["。"],["立ち止まる","たちどまる"],["な"],["。"],["／"],["わたし"],["が"],["わざわい"],["を"],["北","きた"],["から"],["もたらし"],["、"],["大いなる","おおいなる"],["破滅","はめつ"],["を"],["もたらす"],["から"],["。"]]},{"verse":7,"text":"獅子はその茂みから上って来、国々を滅ぼす者は彼らの国から進み出た。／あなたの国を荒れ果てさせるために。／あなたの町々は滅び、住む者もいなくなろう。」","tok":[["獅子","しし"],["は"],["その"],["茂み","しげみ"],["から"],["上って","のぼって"],["来","き"],["、"],["国々","くにぐに"],["を"],["滅ぼす","ほろぼす"],["者","もの"],["は"],["彼","かれ"],["ら"],["の"],["国","くに"],["から"],["進み出た","すすみでた"],["。"],["／"],["あなた"],["の"],["国","くに"],["を"],["荒れ果てさせる","あれはてさせる"],["ため"],["に"],["。"],["／"],["あなた"],["の"],["町々","まちまち"],["は"],["滅び","ほろび"],["、"],["住む","すむ"],["者","もの"],["も"],["いなく"],["なろう"],["。"],["」"]]},{"verse":8,"text":"そのために荒布をまとい、悲しみ嘆け。／主の燃える怒りが、私たちから去らないからだ。","tok":[["その"],["ため"],["に"],["荒布","あらめ"],["を"],["まとい"],["、"],["悲しみ嘆け","かなしみなげけ"],["。"],["／"],["主","ぬし"],["の"],["燃える","もえる"],["怒り","いかり"],["が"],["、"],["私たち","わたしたち"],["から"],["去らない","さらない"],["から"],["だ"],["。"]]},{"verse":9,"text":"「その日には、――主の御告げ――／王の心、つかさたちの心は、ついえ去り、祭司はおののき、預言者は驚く。」","tok":[["「"],["その"],["日","ひ"],["に"],["は"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["王","おう"],["の"],["心","こころ"],["、"],["つかさ"],["たち"],["の"],["心","こころ"],["は"],["、"],["ついえ去り","ついえさり"],["、"],["祭司","さいし"],["は"],["おののき"],["、"],["預言者","よげんしゃ"],["は"],["驚く","おどろく"],["。"],["」"]]},{"verse":10,"text":"そこで、私は言った。「ああ、神、主よ。まことに、あなたはこの民とエルサレムを全く欺かれました――『あなたがたには平和が来る』と仰せられて。それなのに、剣が私ののどに触れています。」","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["まこと"],["に"],["、"],["あなた"],["は"],["この"],["民","たみ"],["と"],["エルサレム"],["を"],["全く","まったく"],["欺かれました","あざむかれました"],["―"],["―"],["『"],["あなた"],["がた"],["に"],["は"],["平和","へいわ"],["が"],["来る","くる"],["』"],["と"],["仰せられて","おおせられて"],["。"],["それ"],["な"],["のに"],["、"],["剣","けん"],["が"],["私","わたくし"],["の"],["のど"],["に"],["触れて","ふれて"],["います"],["。"],["」"]]},{"verse":11,"text":"その時、この民とエルサレムにこう告げられる。／荒野にある裸の丘の熱風が、わたしの民の娘のほうに吹いて来る。――／吹き分けるためでもなく、清めるためでもない。","tok":[["その"],["時","とき"],["、"],["この"],["民","たみ"],["と"],["エルサレム"],["に"],["こう"],["告げられる","つげられる"],["。"],["／"],["荒野","こうや"],["に"],["ある"],["裸","はだか"],["の"],["丘","おか"],["の"],["熱風","ねっぷう"],["が"],["、"],["わたし"],["の"],["民","たみ"],["の"],["娘","むすめ"],["の"],["ほう"],["に"],["吹いて","ふいて"],["来る","くる"],["。"],["―"],["―"],["／"],["吹き分ける","ふきわける"],["ため"],["で"],["も"],["なく"],["、"],["清める","きよめる"],["ため"],["で"],["も"],["ない"],["。"]]},{"verse":12,"text":"これよりも、もっと激しい風が、わたしのために吹いて来る。／今、わたしは彼らにさばきを下そう。","tok":[["これ"],["より"],["も"],["、"],["もっと"],["激しい","はげしい"],["風","かぜ"],["が"],["、"],["わたし"],["の"],["ため"],["に"],["吹いて","ふいて"],["来る","くる"],["。"],["／"],["今","いま"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["さばき"],["を"],["下そう","くだそう"],["。"]]},{"verse":13,"text":"見よ。それは雲のように上って来る。／その戦車はつむじ風のよう、その馬は鷲よりも速い。／ああ。私たちは荒らされる。","tok":[["見","み"],["よ"],["。"],["それ"],["は"],["雲","くも"],["の"],["よう"],["に"],["上って","のぼって"],["来る","くる"],["。"],["／"],["その"],["戦車","せんしゃ"],["は"],["つむじ風","つむじかぜ"],["の"],["よう"],["、"],["その"],["馬","うま"],["は"],["鷲","わし"],["より"],["も"],["速い","はやい"],["。"],["／"],["ああ"],["。"],["私たち","わたしたち"],["は"],["荒らされる","あらされる"],["。"]]},{"verse":14,"text":"エルサレムよ。救われるために、心を洗って悪を除け。／いつまで、あなたの中には邪念が宿っているのか。","tok":[["エルサレム"],["よ"],["。"],["救われる","すくわれる"],["ため"],["に"],["、"],["心","こころ"],["を"],["洗って","あらって"],["悪","あく"],["を"],["除け","よけ"],["。"],["／"],["いつ"],["まで"],["、"],["あなた"],["の"],["中","なか"],["に"],["は"],["邪念","じゃねん"],["が"],["宿って","やどって"],["いる"],["の"],["か"],["。"]]},{"verse":15,"text":"ああ、ダンから告げる声がある。／エフライムの山から／わざわいを告げ知らせている。","tok":[["ああ"],["、"],["ダン"],["から"],["告げる","つげる"],["声","こえ"],["が"],["ある"],["。"],["／"],["エフライム"],["の"],["山","やま"],["から"],["／"],["わざわい"],["を"],["告げ知らせて","つげしらせて"],["いる"],["。"]]},{"verse":16,"text":"国々に知らせよ。／さあ、エルサレムに告げ知らせよ。／包囲する者たちが遠くの地から来て、ユダの町々に叫び声をあげる。","tok":[["国々","くにぐに"],["に"],["知らせ","しらせ"],["よ"],["。"],["／"],["さあ"],["、"],["エルサレム"],["に"],["告げ知らせ","つげしらせ"],["よ"],["。"],["／"],["包囲","ほうい"],["する"],["者","もの"],["たち"],["が"],["遠く","とおく"],["の"],["地","ち"],["から"],["来て","きて"],["、"],["ユダ"],["の"],["町々","まちまち"],["に"],["叫び声","さけびごえ"],["を"],["あげる"],["。"]]},{"verse":17,"text":"彼らは畑の番人のように、ユダを取り囲む。／それは、ユダがわたしに逆らったからだ。／――主の御告げ――","tok":[["彼","かれ"],["ら"],["は"],["畑","はたけ"],["の"],["番人","ばんにん"],["の"],["よう"],["に"],["、"],["ユダ"],["を"],["取り囲む","とりかこむ"],["。"],["／"],["それ"],["は"],["、"],["ユダ"],["が"],["わたし"],["に"],["逆らった","さからった"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":18,"text":"あなたの行いと、あなたのわざが、あなたの身にこれを招いたのだ。／これがあなたへのわざわいで、実に苦い。／もう、あなたの心臓にまで達している。","tok":[["あなた"],["の"],["行い","おこない"],["と"],["、"],["あなた"],["の"],["わざ"],["が"],["、"],["あなた"],["の"],["身","み"],["に"],["これ"],["を"],["招いた","まねいた"],["の"],["だ"],["。"],["／"],["これ"],["が"],["あなた"],["へ"],["の"],["わざわい"],["で"],["、"],["実","じつ"],["に"],["苦い","にがい"],["。"],["／"],["もう"],["、"],["あなた"],["の"],["心臓","しんぞう"],["に"],["まで"],["達して","たっして"],["いる"],["。"]]},{"verse":19,"text":"私のはらわた、私のはらわた。／私は痛み苦しむ。私の心臓の壁よ。／私の心は高鳴り、私はもう、黙っていられない。／私のたましいよ。／おまえが角笛の音と、戦いの雄たけびを聞くからだ。","tok":[["私","わたくし"],["の"],["はらわた"],["、"],["私","わたくし"],["の"],["はらわた"],["。"],["／"],["私","わたくし"],["は"],["痛み","いたみ"],["苦しむ","くるしむ"],["。"],["私","わたくし"],["の"],["心臓","しんぞう"],["の"],["壁","かべ"],["よ"],["。"],["／"],["私","わたくし"],["の"],["心","こころ"],["は"],["高鳴り","たかなり"],["、"],["私","わたくし"],["は"],["もう"],["、"],["黙って","だまって"],["いられない"],["。"],["／"],["私","わたくし"],["の"],["たましい"],["よ"],["。"],["／"],["おまえ"],["が"],["角笛","つのぶえ"],["の"],["音","おと"],["と"],["、"],["戦い","たたかい"],["の"],["雄たけび","おたけび"],["を"],["聞く","きく"],["から"],["だ"],["。"]]},{"verse":20,"text":"破滅に次ぐ破滅が知らされる。／全国が荒らされるからだ。／たちまち、私の天幕も荒らされ、私の幕屋も倒される。","tok":[["破滅","はめつ"],["に"],["次ぐ","つぐ"],["破滅","はめつ"],["が"],["知らされる","しらされる"],["。"],["／"],["全国","ぜんこく"],["が"],["荒らされる","あらされる"],["から"],["だ"],["。"],["／"],["たちまち"],["、"],["私","わたくし"],["の"],["天幕","てんまく"],["も"],["荒らされ","あらされ"],["、"],["私","わたくし"],["の"],["幕屋","まくや"],["も"],["倒される","たおされる"],["。"]]},{"verse":21,"text":"いつまで私は、旗を見、角笛の音を聞かなければならないのだ。","tok":[["いつ"],["まで"],["私","わたくし"],["は"],["、"],["旗","はた"],["を"],["見","み"],["、"],["角笛","つのぶえ"],["の"],["音","おと"],["を"],["聞かなければ","きかなければ"],["ならない"],["の"],["だ"],["。"]]},{"verse":22,"text":"実に、わたしの民は愚か者で、わたしを知らない。／彼らは、ばかな子らで、彼らは悟りがない。／彼らは悪事を働くのに賢くて、善を行うことを知らない。","tok":[["実","じつ"],["に"],["、"],["わたし"],["の"],["民","たみ"],["は"],["愚か者","おろかもの"],["で"],["、"],["わたし"],["を"],["知らない","しらない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["ばか"],["な"],["子","こ"],["ら"],["で"],["、"],["彼","かれ"],["ら"],["は"],["悟り","さとり"],["が"],["ない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["悪事","あくじ"],["を"],["働く","はたらく"],["のに"],["賢くて","かしこくて"],["、"],["善","ぜん"],["を"],["行う","おこなう"],["こと"],["を"],["知らない","しらない"],["。"]]},{"verse":23,"text":"私が地を見ると、見よ、茫漠として何もなく、天を見ると、その光はなかった。","tok":[["私","わたくし"],["が"],["地","ち"],["を"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["茫漠","ぼうばく"],["として"],["何","なん"],["も"],["なく"],["、"],["天","てん"],["を"],["見る","みる"],["と"],["、"],["その"],["光","ひかり"],["は"],["なかった"],["。"]]},{"verse":24,"text":"私が山々を見ると、見よ、揺れ動き、すべての丘は震えていた。","tok":[["私","わたくし"],["が"],["山々","やまやま"],["を"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["揺れ動き","ゆれうごき"],["、"],["すべて"],["の"],["丘","おか"],["は"],["震えて","ふるえて"],["いた"],["。"]]},{"verse":25,"text":"私が見ると、見よ、人はひとりもいなく、空の鳥もみな飛び去っていた。","tok":[["私","わたくし"],["が"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["人","ひと"],["は"],["ひとり"],["も"],["いなく"],["、"],["空","そら"],["の"],["鳥","とり"],["も"],["みな"],["飛び去って","とびさって"],["いた"],["。"]]},{"verse":26,"text":"私が見ると、見よ、果樹園は荒野となり、町々は主の御前で、その燃える怒りによって、取りこわされていた。","tok":[["私","わたくし"],["が"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["果樹園","かじゅえん"],["は"],["荒野","こうや"],["と"],["なり"],["、"],["町々","まちまち"],["は"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["、"],["その"],["燃える","もえる"],["怒り","いかり"],["によって"],["、"],["取りこわされて","とりこわされて"],["いた"],["。"]]},{"verse":27,"text":"まことに主はこう仰せられる。／「全地は荒れ果てる。／しかし、わたしはことごとくは滅ぼさない。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["全地","ぜんち"],["は"],["荒れ果てる","あれはてる"],["。"],["／"],["しかし"],["、"],["わたし"],["は"],["ことごとく"],["は"],["滅ぼさない","ほろぼさない"],["。"]]},{"verse":28,"text":"このために、地は嘆き悲しみ、上の天も暗くなる。／わたしが語り、わたしが企てたからだ。／わたしは悔いず、取りやめもしない。」","tok":[["この"],["ため"],["に"],["、"],["地","ち"],["は"],["嘆き悲しみ","なげきかなしみ"],["、"],["上","うえ"],["の"],["天","てん"],["も"],["暗く","くらく"],["なる"],["。"],["／"],["わたし"],["が"],["語り","かたり"],["、"],["わたし"],["が"],["企てた","くわだてた"],["から"],["だ"],["。"],["／"],["わたし"],["は"],["悔いず","くいず"],["、"],["取りやめ","とりやめ"],["も"],["しない"],["。"],["」"]]},{"verse":29,"text":"騎兵と射手の叫びに、町中の人が逃げ去った。／彼らは草むらに入り、岩によじのぼった。／すべての町が捨てられ、そこに住む人もない。","tok":[["騎兵","きへい"],["と"],["射手","いて"],["の"],["叫び","さけび"],["に"],["、"],["町中","まちなか"],["の"],["人","ひと"],["が"],["逃げ去った","にげさった"],["。"],["／"],["彼","かれ"],["ら"],["は"],["草むら","くさむら"],["に"],["入り","はいり"],["、"],["岩","いわ"],["に"],["よじのぼった"],["。"],["／"],["すべて"],["の"],["町","まち"],["が"],["捨てられ","すてられ"],["、"],["そこ"],["に"],["住む","すむ"],["人","ひと"],["も"],["ない"],["。"]]},{"verse":30,"text":"踏みにじられた女よ。／あなたが緋の衣をまとい、金の飾りで身を飾りたてても、それが何の役に立とう。／目を塗って大きく見せても、美しく見せても、かいがない。／恋人たちは、あなたをうとみ、あなたのいのちを取ろうとしている。","tok":[["踏みにじられた","ふみにじられた"],["女","おんな"],["よ"],["。"],["／"],["あなた"],["が"],["緋","ひ"],["の"],["衣","ころも"],["を"],["まとい"],["、"],["金","きん"],["の"],["飾り","かざり"],["で"],["身","み"],["を"],["飾りたてて","かざりたてて"],["も"],["、"],["それ"],["が"],["何","なん"],["の"],["役","やく"],["に"],["立とう","たとう"],["。"],["／"],["目","め"],["を"],["塗って","ぬって"],["大きく","おおきく"],["見せて","みせて"],["も"],["、"],["美しく","うつくしく"],["見せて","みせて"],["も"],["、"],["かい"],["が"],["ない"],["。"],["／"],["恋人","こいびと"],["たち"],["は"],["、"],["あなた"],["を"],["うとみ"],["、"],["あなた"],["の"],["いのち"],["を"],["取ろう","とろう"],["として"],["いる"],["。"]]},{"verse":31,"text":"まことに、わたしは、産みの苦しみをする女のような声、初子を産む女のようなうめき、シオンの娘の声を聞いた。／彼女はあえぎ、手を伸べて言う。「ああ。私は殺す者たちのために疲れ果てた。」","tok":[["まこと"],["に"],["、"],["わたし"],["は"],["、"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["女","おんな"],["の"],["よう"],["な"],["声","こえ"],["、"],["初子","ういご"],["を"],["産む",
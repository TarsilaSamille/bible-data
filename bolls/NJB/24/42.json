,["者","もの"],["よ"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["もし"],["、"],["あなた"],["がた"],["が"],["エジプト"],["に"],["行こう","いこう"],["と"],["堅く","かたく"],["決心","けっしん"],["し"],["、"],["そこ"],["に"],["行って","いって"],["寄留","きりゅう"],["するなら"],["、"]]},{"verse":16,"text":"あなたがたの恐れている剣が、あのエジプトの国であなたがたに追いつき、あなたがたの心配しているききんが、あのエジプトであなたがたに追いすがり、あなたがたはあそこで死のう。","tok":[["あなた"],["がた"],["の"],["恐れて","おそれて"],["いる"],["剣","けん"],["が"],["、"],["あの"],["エジプト"],["の"],["国","くに"],["で"],["あなた"],["がた"],["に"],["追いつき","おいつき"],["、"],["あなた"],["がた"],["の"],["心配","しんぱい"],["して"],["いる"],["ききん"],["が"],["、"],["あの"],["エジプト"],["で"],["あなた"],["がた"],["に"],["追いすがり","おいすがり"],["、"],["あなた"],["がた"],["は"],["あそこ"],["で"],["死のう","しのう"],["。"]]},{"verse":17,"text":"エジプトに行ってそこに寄留しようと決心した者たちはみな、そこで剣とききんと疫病で死に、わたしが彼らに下すわざわいをのがれて生き残る者はいない。』","tok":[["エジプト"],["に"],["行って","いって"],["そこ"],["に"],["寄留","きりゅう"],["しよう"],["と"],["決心","けっしん"],["した"],["者","もの"],["たち"],["は"],["みな"],["、"],["そこ"],["で"],["剣","けん"],["と"],["ききん"],["と"],["疫病","やくびょう"],["で"],["死に","しに"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["下す","くだす"],["わざわい"],["を"],["のがれて"],["生き残る","いきのこる"],["者","もの"],["は"],["いない"],["。"],["』"]]},{"verse":18,"text":"まことに、イスラエルの神、万軍の主は、こう仰せられる。『わたしの怒りと憤りが、エルサレムの住民の上に注がれたように、あなたがたがエジプトに行くとき、わたしの憤りはあなたがたの上に注がれ、あなたがたは、のろいと、恐怖と、ののしりと、そしりになり、二度とこの所を見ることができない。』","tok":[["まこと"],["に"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["が"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["の"],["上","うえ"],["に"],["注がれた","そそがれた"],["よう"],["に"],["、"],["あなた"],["がた"],["が"],["エジプト"],["に"],["行く","いく"],["とき"],["、"],["わたし"],["の"],["憤り","いきどおり"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["注がれ","そそがれ"],["、"],["あなた"],["がた"],["は"],["、"],["のろい"],["と"],["、"],["恐怖","きょうふ"],["と"],["、"],["ののしり"],["と"],["、"],["そしり"],["に"],["なり"],["、"],["二","に"],["度","ど"],["と"],["この"],["所","ところ"],["を"],["見る","みる"],["こと"],["が"],["できない"],["。"],["』"]]},{"verse":19,"text":"ユダの残りの者よ。主はあなたがたに『エジプトへ行ってはならない』と仰せられた。きょう、私があなたがたにあかししたことを、確かに知らなければならない。","tok":[["ユダ"],["の"],["残り","のこり"],["の"],["者","もの"],["よ"],["。"],["主","ぬし"],["は"],["あなた"],["がた"],["に"],["『"],["エジプト"],["へ"],["行って","いって"],["は"],["ならない"],["』"],["と"],["仰せられた","おおせられた"],["。"],["きょう"],["、"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["あかし"],["した"],["こと"],["を"],["、"],["確か","たしか"],["に"],["知らなければ","しらなければ"],["ならない"],["。"]]},{"verse":20,"text":"あなたがたは迷い出てしまっている。あなたがたは私をあなたがたの神、主のもとに遣わして、『私たちのために、私たちの神、主に祈り、すべて私たちの神、主の仰せられるとおりに、私たちに告げてください。私たちはそれを行います』と言ったのだ。","tok":[["あなた"],["がた"],["は"],["迷い出て","まよいでて"],["しまって"],["いる"],["。"],["あなた"],["がた"],["は"],["私","わたくし"],["を"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["もと"],["に"],["遣わして","つかわして"],["、"],["『"],["私たち","わたしたち"],["の"],["ため"],["に"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈り","いのり"],["、"],["すべて"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["仰せられる","おおせられる"],["とおり"],["に"],["、"],["私たち","わたしたち"],["に"],["告げて","つげて"],["ください"],["。"],["私たち","わたしたち"],["は"],["それ"],["を"],["行います","おこないます"],["』"],["と"],["言った","いった"],["の"],["だ"],["。"]]},{"verse":21,"text":"だから、私は、きょう、あなたがたに告げたのに、あなたがたは、あなたがたの神、主の御声を聞かず、すべてそのために主が私をあなたがたに遣わされたことを聞かなかった。","tok":[["だ"],["から"],["、"],["私","わたくし"],["は"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["告げた","つげた"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["を"],["聞かず","きかず"],["、"],["すべて"],["その"],["ため"],["に"],["主","ぬし"],["が"],["私","わたくし"],["を"],["あなた"],["がた"],["に"],["遣わされた","つかわされた"],["こと"],["を"],["聞かなかった","きかなかった"],["。"]]},{"verse":22,"text":"だから今、確かに知れ。あなたがたは、行って寄留したいと思っているその所で、剣とききんと疫病で死ぬことを。」","tok":[["だ"],["から"],["今","いま"],["、"],["確か","たしか"],["に"],["知れ","しれ"],["。"],["あなた"],["がた"],["は"],["、"],["行って","いって"],["寄留","きりゅう"],["したい"],["と"],["思って","おもって"],["いる"],["その"],["所","ところ"],["で"],["、"],["剣","けん"],["と"],["ききん
[{"verse":1,"text":"すべての将校たち、カレアハの子ヨハナン、ホシャヤの子イザヌヤ、および身分の低い者も高い者もみな、寄って来て、","tok":[["すべて"],["の"],["将校","しょうこう"],["たち"],["、"],["カレアハ"],["の"],["子","こ"],["ヨハナン"],["、"],["ホシャヤ"],["の"],["子","こ"],["イザヌヤ"],["、"],["および"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["も"],["高い","たかい"],["者","もの"],["も"],["みな"],["、"],["寄って","よって"],["来て","きて"],["、"]]},{"verse":2,"text":"預言者エレミヤに言った。「どうぞ、私たちの願いを聞いてください。私たちのため、この残った者みなのために、あなたの神、主に、祈ってください。ご覧のとおり、私たちは多くの者の中からごくわずかだけ残ったのです。","tok":[["預言者","よげんしゃ"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["どうぞ"],["、"],["私たち","わたしたち"],["の"],["願い","ねがい"],["を"],["聞いて","きいて"],["ください"],["。"],["私たち","わたしたち"],["の"],["ため"],["、"],["この"],["残った","のこった"],["者","もの"],["みな"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["祈って","いのって"],["ください"],["。"],["ご覧","ごらん"],["の"],["とおり"],["、"],["私たち","わたしたち"],["は"],["多く","おおく"],["の"],["者","もの"],["の"],["中","なか"],["から"],["ごく"],["わずか"],["だけ"],["残った","のこった"],["の"],["です"],["。"]]},{"verse":3,"text":"あなたの神、主が、私たちの歩むべき道と、なすべきことを私たちに告げてくださいますように。」","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["私たち","わたしたち"],["の"],["歩むべき","あゆむべき"],["道","みち"],["と"],["、"],["なすべき"],["こと"],["を"],["私たち","わたしたち"],["に"],["告げて","つげて"],["くださいます"],["よう"],["に"],["。"],["」"]]},{"verse":4,"text":"そこで、預言者エレミヤは彼らに言った。「承知しました。今、私は、あなたがたのことばのとおり、あなたがたの神、主に祈り、主があなたがたに答えられることはみな、あなたがたに告げましょう。何事も、あなたがたに隠しません。」","tok":[["そこ"],["で"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["承知","しょうち"],["しました"],["。"],["今","いま"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["の"],["ことば"],["の"],["とおり"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈り","いのり"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["に"],["答えられる","こたえられる"],["こと"],["は"],["みな"],["、"],["あなた"],["がた"],["に"],["告げましょう","つげましょう"],["。"],["何事","なにごと"],["も"],["、"],["あなた"],["がた"],["に"],["隠しません","かくしません"],["。"],["」"]]},{"verse":5,"text":"彼らはエレミヤに言った。「主が私たちの間で真実な確かな証人でありますように。私たちは、すべてあなたの神、主が私たちのためにあなたを送って告げられることばのとおりに、必ず行います。","tok":[["彼","かれ"],["ら"],["は"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["私たち","わたしたち"],["の"],["間","あいだ"],["で"],["真実","しんじつ"],["な"],["確か","たしか"],["な"],["証人","しょうにん"],["で"],["あります"],["よう"],["に"],["。"],["私たち","わたしたち"],["は"],["、"],["すべて"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["私たち","わたしたち"],["の"],["ため"],["に"],["あなた"],["を"],["送って","おくって"],["告げられる","つげられる"],["ことば"],["の"],["とおり"],["に"],["、"],["必ず","かならず"],["行います","おこないます"],["。"]]},{"verse":6,"text":"私たちは良くても悪くても、あなたを遣わされた私たちの神、主の御声に聞き従います。私たちが私たちの神、主の御声に聞き従ってしあわせを得るためです。」","tok":[["私たち","わたしたち"],["は"],["良くて","よくて"],["も"],["悪くて","わるくて"],["も"],["、"],["あなた"],["を"],["遣わされた","つかわされた"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従います","ききしたがいます"],["。"],["私たち","わたしたち"],["が"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従って","ききしたがって"],["しあわせ"],["を"],["得る","える"],["ため"],["です"],["。"],["」"]]},{"verse":7,"text":"十日の後、主のことばがエレミヤにあった。","tok":[["十日","とうか"],["の"],["後","あと"],["、"],["主","ぬし"],["の"],["ことば"],["が"],["エレミヤ"],["に"],["あった"],["。"]]},{"verse":8,"text":"彼はカレアハの子ヨハナンと、彼とともにいるすべての将校と、身分の低い者や高い者をみな呼び寄せて、","tok":[["彼","かれ"],["は"],["カレアハ"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["すべて"],["の"],["将校","しょうこう"],["と"],["、"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["や"],["高い","たかい"],["者","もの"],["を"],["みな"],["呼び寄せて","よびよせて"],["、"]]},{"verse":9,"text":"彼らに言った。「あなたがたが私を遣わして、あなたがたの願いを御前に述べさせたイスラエルの神、主は、こう仰せられる。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["が"],["私","わたくし"],["を"],["遣わして","つかわして"],["、"],["あなた"],["がた"],["の"],["願い","ねがい"],["を"],["御前","ごぜん"],["に"],["述べさせた","のべさせた"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"]]},{"verse":10,"text":"『もし、あなたがたがこの国にとどまるなら、わたしはあなたがたを建てて、倒さず、あなたがたを植えて、引き抜かない。わたしはあなたがたに下したあのわざわいを思い直したからだ。","tok":[["『"],["もし"],["、"],["あなた"],["がた"],["が"],["この"],["国","くに"],["に"],["とどまるなら"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["建てて","たて
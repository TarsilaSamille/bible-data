[{"verse":1,"text":"もし、人が自分の妻を去らせ、彼女が彼のもとを去って、ほかの男のものになれば、この人は再び先の妻のもとに戻れるだろうか。／この国も大いに汚れていないだろうか。／あなたは、多くの愛人と淫行を行って、しかも、わたしのところに帰ると言っている。／――主の御告げ――","tok":[["もし"],["、"],["人","ひと"],["が"],["自分","じぶん"],["の"],["妻","つま"],["を"],["去らせ","さらせ"],["、"],["彼女","かのじょ"],["が"],["彼","かれ"],["の"],["もと"],["を"],["去って","さって"],["、"],["ほか"],["の"],["男","おとこ"],["の"],["もの"],["に"],["なれば"],["、"],["この"],["人","ひと"],["は"],["再び","ふたたび"],["先","さき"],["の"],["妻","つま"],["の"],["もと"],["に"],["戻れるだろう","もどれるだろう"],["か"],["。"],["／"],["この"],["国","くに"],["も"],["大いに","おおいに"],["汚れて","よごれて"],["いないだろう"],["か"],["。"],["／"],["あなた"],["は"],["、"],["多く","おおく"],["の"],["愛人","あいじん"],["と"],["淫行","いんこう"],["を"],["行って","おこなって"],["、"],["しかも"],["、"],["わたし"],["の"],["ところ"],["に"],["帰る","かえる"],["と"],["言って","いって"],["いる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":2,"text":"目を上げて裸の丘を見よ。／どこに、あなたが共寝をしなかった所があろう。／荒野のアラビヤ人がするように、道ばたで相手を待ってすわり込み、あなたの淫行と悪行によって、この地を汚した。","tok":[["目","め"],["を"],["上げて","あげて"],["裸","はだか"],["の"],["丘","おか"],["を"],["見よ","みよ"],["。"],["／"],["どこ"],["に"],["、"],["あなた"],["が"],["共寝","ともね"],["を"],["しなかった"],["所","ところ"],["が"],["あろう"],["。"],["／"],["荒野","こうや"],["の"],["アラビヤ"],["人","にん"],["が"],["する"],["よう"],["に"],["、"],["道ばた","みちばた"],["で"],["相手","あいて"],["を"],["待って","まって"],["すわり込み","すわりこみ"],["、"],["あなた"],["の"],["淫行","いんこう"],["と"],["悪行","あくぎょう"],["によって"],["、"],["この"],["地","ち"],["を"],["汚した","よごした"],["。"]]},{"verse":3,"text":"それで夕立はとどめられ、後の雨はなかった。／それでも、あなたは遊女の額をしていて、恥じようともしない。","tok":[["それ"],["で"],["夕立","ゆうだち"],["は"],["とどめられ"],["、"],["後","あと"],["の"],["雨","あめ"],["は"],["なかった"],["。"],["／"],["それ"],["で"],["も"],["、"],["あなた"],["は"],["遊女","ゆうじょ"],["の"],["額","がく"],["を"],["して"],["いて"],["、"],["恥じよう","はじよう"],["と"],["も"],["しない"],["。"]]},{"verse":4,"text":"今でも、わたしに、こう呼びかけているではないか。／『父よ。／あなたは私の若いころの連れ合いです。","tok":[["今","いま"],["で"],["も"],["、"],["わたし"],["に"],["、"],["こう"],["呼びかけて","よびかけて"],["いるで"],["は"],["ない"],["か"],["。"],["／"],["『"],["父","ちち"],["よ"],["。"],["／"],["あなた"],["は"],["私","わたくし"],["の"],["若い","わかい"],["ころ"],["の"],["連れ合い","つれあい"],["です"],["。"]]},{"verse":5,"text":"いつまでも怒られるのですか。／永久に怒り続けるのですか』と。／なんと、あなたはこう言っていても、できるだけ多くの悪を行っている。」","tok":[["いつ"],["まで"],["も"],["怒られる","おこられる"],["の"],["です"],["か"],["。"],["／"],["永久","えいきゅう"],["に"],["怒り","おこり"],["続ける","つづける"],["の"],["です"],["か"],["』"],["と"],["。"],["／"],["なん"],["と"],["、"],["あなた"],["は"],["こう"],["言って","いって"],["いて"],["も"],["、"],["できる"],["だけ"],["多く","おおく"],["の"],["悪","あく"],["を"],["行って","おこなって"],["いる"],["。"],["」"]]},{"verse":6,"text":"ヨシヤ王の時代に、主は私に仰せられた。「あなたは、背信の女イスラエルが行ったことを見たか。彼女はすべての高い山の上、すべての茂った木の下に行って、そこで淫行を行った。","tok":[["ヨシヤ"],["王","おう"],["の"],["時代","じだい"],["に"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["背信","はいしん"],["の"],["女","じょ"],["イスラエル"],["が"],["行った","おこなった"],["こと"],["を"],["見た","みた"],["か"],["。"],["彼女","かのじょ"],["は"],["すべて"],["の"],["高い","たかい"],["山","やま"],["の"],["上","うえ"],["、"],["すべて"],["の"],["茂った","しげった"],["木","き"],["の"],["下","した"],["に"],["行って","いって"],["、"],["そこ"],["で"],["淫行","いんこう"],["を"],["行った","おこなった"],["。"]]},{"verse":7,"text":"わたしは、彼女がすべてこれらのことをしたあとで、わたしに帰って来るだろうと思ったのに、帰らなかった。また裏切る女、妹のユダもこれを見た。","tok":[["わたし"],["は"],["、"],["彼女","かのじょ"],["が"],["すべて"],["これ"],["ら"],["の"],["こと"],["を"],["した"],["あと"],["で"],["、"],["わたし"],["に"],["帰って","かえって"],["来るだろう","くるだろう"],["と"],["思った","おもった"],["のに"],["、"],["帰らなかった","かえらなかった"],["。"],["また"],["裏切る","うらぎる"],["女","おんな"],["、"],["妹","いもうと"],["の"],["ユダ"],["も"],["これ"],["を"],["見た","みた"],["。"]]},{"verse":8,"text":"背信の女イスラエルは、姦通したというその理由で、わたしが離婚状を渡してこれを追い出したのに、裏切る女、妹のユダは恐れもせず、自分も行って、淫行を行ったのをわたしは見た。","tok":[["背信","はいしん"],["の"],["女","じょ"],["イスラエル"],["は"],["、"],["姦通","かんつう"],["した"],["と"],["いう"],["その"],["理由","りゆう"],["で"],["、"],["わたし"],["が"],["離婚状","りこんじょう"],["を"],["渡して","わたして"],["これ"],["を"],["追い出した","おいだした"],["のに"],["、"],["裏切る","うらぎる"],["女","おんな"],["、"],["妹","いもうと"],["の"],["ユダ"],["は"],["恐れ","おそれ"],["も"],["せず"],["、"],["自分","じぶん"],["も"],["行って","いって"],["、"],["淫行","いんこう"],["を"],["行った","おこなった"],["の"],["を"],["わたし"],["は"],["見た","みた"],["。"]]},{"verse":9,"text":"彼女は、自分の淫行を軽く見て、国を汚し、石や木と姦通した。","tok":[["彼女","かのじょ"],["は"],["、"],["自分","じぶん"],["の"],["淫行","いんこう"],["を"],["軽く","かるく"],["見て","みて"],["、"],["国","くに"],["を"],["汚し","よごし"],["、"],["石","いし"],["や"],["木","き"],["と"],["姦通","かんつう"],["した"],["。"]]},{"verse":10,"text":"このようなことをしながら、裏切る女、妹のユダは、心を尽くしてわたしに帰らず、ただ偽っていたにすぎなかった。――主の御告げ――」","tok":[["この"],["よう"],["な"],["こと"],["を"],["し"],["ながら"],["、"],["裏切る","うらぎる"],["女","おんな"],["、"],["妹","いもうと"],["の"],["ユダ"],["は"],["、"],["心","こころ"],["を"],["尽くして","つくして"],["わたし"],["に"],["帰らず","かえらず"],["、"],["ただ"],["偽って","いつわって"],["いた"],["に"],["すぎなかった"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":11,"text":"主はまた、私に仰せられた。「背信の女イスラエルは、裏切る女ユダよりも正しかった。","tok":[["主","ぬし"],["は"],["また"],["、"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["背信","はいしん"],["の"],["女","じょ"],["イスラエル"],["は"],["、"],["裏切る","うらぎる"],["女","おんな"],["ユダ"],["より"],["も"],["正しかった","ただしかった"],["。"]]},{"verse":12,"text":"行って、次のことばを北のほうに呼ばわって言え。／背信の女イスラエル。帰れ。／――主の御告げ――／わたしはあなたがたをしからない。／わたしは恵み深いから。／――主の御告げ――／わたしは、いつまでも怒ってはいない。","tok":[["行って","いって"],["、"],["次","つぎ"],["の"],["ことば"],["を"],["北","きた"],["の"],["ほう"],["に"],["呼ばわって","よばわって"],["言え","いえ"],["。"],["／"],["背信","はいしん"],["の"],["女","じょ"],["イスラエル"],["。"],["帰れ","かえれ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["あなた"],["がた"],["を"],["しからない"],["。"],["／"],["わたし"],["は"],["恵み","めぐみ"],["深い","ぶかい"],["から"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["、"],["いつ"],["まで"],["も"],["怒って","おこって"],["は"],["いない"],["。"]]},{"verse":13,"text":"ただ、あなたは自分の咎を知れ。／あなたは自分の神、主にそむいて、すべての茂った木の下で、他国の男とかってなまねをし、わたしの声を聞き入れなかった。／――主の御告げ――","tok":[["ただ"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["咎","とが"],["を"],["知れ","しれ"],["。"],["／"],["あなた"],["は"],["自分","じぶん"],["の"],["神","かみ"],["、"],["主に","おもに"],["そむいて"],["、"],["すべて"],["の"],["茂った","しげった"],["木","き"],["の"],["下","もと"],["で"],["、"],["他国","たこく"],["の"],["男","おとこ"],["と"],["か"],["って"],["な"],["まね"],["を"],["し"],["、"],["わたし"],["の"],["声","こえ"],["を"],["聞き入れなかった","ききいれなかった"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":14,"text":"背信の子らよ。帰れ。――主の御告げ――わたしが、あなたがたの夫になるからだ。わたしはあなたがたを、町からひとり、氏族からふたり選び取り、シオンに連れて行こう。","tok":[["背信","はいしん"],["の"],["子","こ"],["ら"],["よ"],["。"],["帰れ","かえれ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["が"],["、"],["あなた"],["がた"],["の"],["夫","おっと"],["に"],["なる"],["から"],["だ"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["町","まち"],["から"],["ひとり"],["、"],["氏族","しぞく"],["から"],["ふたり"],["選び取り","えらびとり"],["、"],["シオン"],["に"],["連れて","つれて"],["行こう","いこう"],["。"]]},{"verse":15,"text":"また、あなたがたに、わたしの心にかなった牧者たちを与える。彼らは知識と分別をもってあなたがたを育てよう。","tok":[["また"],["、"],["あなた"],["がた"],["に"],["、"],["わたし"],["の"],["心","こころ"],["に"],["かなった"],["牧者","ぼくしゃ"],["たち"],["を"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["知識","ちしき"],["と"],["分別","ぶんべつ"],["を"],["もって"],["あなた"],["がた"],["を"],["育てよう","そだてよう"],["。"]]},{"verse":16,"text":"その日、あなたがたが国中にふえて多くなるとき、――主の御告げ――彼らはもう、主の契約の箱について何も言わず、心にも留めず、思い出しもせず、調べもせず、再び作ろうともしない。","tok":[["その"],["日","ひ"],["、"],["あなた"],["がた"],["が"],["国中","くにちゅう"],["に"],["ふえて"],["多く","おおく"],["なる"],["とき"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["彼","かれ"],["ら"],["は"],["もう"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["について"],["何","なん"],["も"],["言わず","いわず"],["、"],["心","こころ"],["に"],["も"],["留めず","とめず"],["、"],["思い出し","おもいだし"],["も"],["せず"],["、"],["調べ","しらべ"],["も"],["せず"],["、"],["再び","ふたたび"],["作ろう","つくろう"],["と"],["も"],["しない"],["。"]]},{"verse":17,"text":"そのとき、エルサレムは『主の御座』と呼ばれ、万国の民はこの御座、主の名のあるエルサレムに集められ、二度と彼らは悪いかたくなな心のままに歩むことはない。","tok":[["その"],["とき"],["、"],["エルサレム"],["は"],["『"],["主","ぬし"],["の"],["御座","ぎょざ"],["』"],["と"],["呼ばれ","よばれ"],["、"],["万国","ばんこく"],["の"],["民","たみ"],["は"],["この"],["御座","ぎょざ"],["、"],["主","ぬし"],["の"],["名","な"],["の"],["ある"],["エルサレム"],["に"],["集められ","あつめられ"],["、"],["二","に"],["度","ど"],["と"],["彼","かれ"],["ら"],["は"],["悪い","わるい"],["かたくな"],["な"],["心","こころ"],["の"],["まま"],["に"],["歩む","あゆむ"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"その日、ユダの家はイスラエルの家といっしょになり、彼らはともどもに、北の国から、わたしが彼らの先祖に継がせた国に帰って来る。」","tok":[["その"],["日","ひ"],["、"],["ユダ"],["の"],["家","いえ"],["は"],["イスラエル"],["の"],["家","いえ"],["と"],["いっしょ"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["ともども"],["に"],["、"],["北","きた"],["の"],["国","くに"],["から"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["に"],["継がせた","つがせた"],["国","くに"],["に"],["帰って","かえって"],["来る","くる"],["。"],["」"]]},{"verse":19,"text":"「わたしはどのようにして、あなたを息子たちの中に入れ、あなたに、慕わしい地、諸国のうちで最も麗しいゆずりの地を授けようかと思っていた。また、わたしは、あなたがわたしを父と呼び、わたしに従って、もう離れまい、と思っていた。","tok":[["「"],["わたし"],["は"],["どの"],["よう"],["に"],["して"],["、"],["あなた"],["を"],["息子","むすこ"],["たち"],["の"],["中","なか"],["に"],["入れ","いれ"],["、"],["あなた"],["に"],["、"],["慕わしい","したわしい"],["地","ち"],["、"],["諸国","しょこく"],["の"],["うち"],["で"],["最も","もっとも"],["麗しい","うるわしい"],["ゆずり"],["の"],["地","ち"],["を"],["授けよう","さずけよう"],["か"],["と"],["思って","おもって"],["いた"],["。"],["また"],["、"],["わたし"],["は"],["、"],["あなた"],["が"],["わたし"],["を"],["父","ちち"],["と"],["呼び","よび"],["、"],["わたし"],["に"],["従って","したがって"],["、"],["もう"],["離れまい","はなれまい"],["、"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":20,"text":"ところが、なんと、妻が夫を裏切るように、あなたがたはわたしを裏切った。イスラエルの家よ。――主の御告げ――","tok":[["ところ"],["が"],["、"],["なん"],["と"],["、"],["妻","つま"],["が"],["夫","おっと"],["を"],["裏切る","うらぎる"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["裏切った","うらぎった"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":21,"text":"一つの声が裸の丘の上で聞こえる。／イスラエルの子らの哀願の泣き声だ。／彼らは自分たちの道を曲げ、自分たちの神、主を忘れたからだ。","tok":[["一","ひと"],["つ"],["の"],["声","こえ"],["が"],["裸","はだか"],["の"],["丘","おか"],["の"],["上","うえ"],["で"],["聞こえる","きこえる"],["。"],["／"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["哀願","あいがん"],["の"],["泣き声","なきごえ"],["だ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["道","みち"],["を"],["曲げ","まげ"],["、"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["忘れた","わすれた"],["から"],["だ"],["。"]]},{"verse":22,"text":"背信の子らよ。帰れ。／わたしがあなたがたの背信をいやそう。」／「今、私たちはあなたのもとにまいります。／あなたこそ、私たちの神、主だからです。","tok":[["背信","はいしん"],["の"],["子","こ"],["ら"],["よ"],["。"],["帰れ","かえれ"],["。"],["／"],["わたし"],["が"],["あなた"],["がた"],["の"],["背信","はいしん"],["を"],["いや"],["そう"],["。"],["」"],["／"],["「"],["今","いま"],["、"],["私たち","わたしたち"],["は"],["あなた"],["の"],["もと"],["に"],["まいります"],["。"],["／"],["あなた"],["こそ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["だ"],["から"],["です"],["。"]]},{"verse":23,"text":"確かに、もろもろの丘も、山の騒ぎも、偽りでした。／確かに、私たちの神、主に、イスラエルの救いがあります。","tok":[["確か","たしか"],["に"],["、"],["もろもろ"],["の"],["丘","おか"],["も"],["、"],["山","やま"],["の"],["騒ぎ","さわぎ"],["も"],["、"],["偽り","いつわり"],["でした"],["。"],["／"],["確か","たしか"],["に"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["イスラエル"],["の"],["救い","すくい"],["が"],["あります"],["。"]]},{"verse":24,"text":"しかし、私たちの若いころから、バアルが、私たちの先祖の勤労の実、彼らの羊の群れ、牛の群れ、息子、娘たちを食い尽くしました。","tok":[["しかし"],["、"],["私たち","わたしたち"],["の"],["若い","わかい"],["ころ"],["から"],["、"],["バアル"],["が"],["、"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["の"],["勤労","きんろう"],["の"],["実","じつ"],["、"],["彼","かれ"],["ら"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["牛","うし"],["の"],["群れ","むれ"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["を"],["食い","くい"],["尽くしました","つくしました"],["。"]]},{"verse":25,"text":"私たちは恥の中に伏し、侮辱が私たちのおおいとなっています。／私たちの神、主に対し、私たちも先祖たちも、私たちの若いころから今日まで罪を犯して、私たちの神、主の御声に／聞き従わなかったからです。」","tok":[["私たち","わたしたち"],["は"],["恥","はじ"],["の"],["中","なか"],["に"],["伏し","ふし"],["、"],["侮辱","ぶじょく"],["が"],["私たち","わたしたち"],["の"],["おおい"],["と"],["なって"],["います"],["。"],["／"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["対し","たいし"],["、"],["私たち","わたしたち"],["も"],["先祖","せんぞ"],["たち"],["も"],["、"],["私たち","わたしたち"],["の"],["若い","わかい"],["ころ"],["から"],["今日","きょう"],["まで"],["罪","つみ"],["を"],["犯して","おかして"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["／"],["聞き従わなかった","ききしたがわなかった"],["から"],["です"],["。"],["」"]]}]
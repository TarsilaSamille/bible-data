[{"verse":1,"text":"エレミヤはすべての民に、彼らの神、主のことばを語り終えた。それは彼らの神、主が、このすべてのことばをもって彼を遣わされたものであった。","tok":[["エレミヤ"],["は"],["すべて"],["の"],["民","たみ"],["に"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["語り","かたり"],["終えた","おえた"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["この"],["すべて"],["の"],["ことば"],["を"],["もって"],["彼","かれ"],["を"],["遣わされた","つかわされた"],["もの"],["で"],["あった"],["。"]]},{"verse":2,"text":"すると、ホシャヤの子アザルヤと、カレアハの子ヨハナンと、高ぶった人たちはみな、エレミヤに告げて言った。「あなたは偽りを語っている。私たちの神、主は『エジプトに行って寄留してはならない』と言わせるために、あなたを遣わされたのではない。","tok":[["する"],["と"],["、"],["ホシャヤ"],["の"],["子","こ"],["アザルヤ"],["と"],["、"],["カレアハ"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["高ぶった","たかぶった"],["人","ひと"],["たち"],["は"],["みな"],["、"],["エレミヤ"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["偽り","いつわり"],["を"],["語って","かたって"],["いる"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["『"],["エジプト"],["に"],["行って","いって"],["寄留","きりゅう"],["して"],["は"],["ならない"],["』"],["と"],["言わせる","いわせる"],["ため"],["に"],["、"],["あなた"],["を"],["遣わされた","つかわされた"],["ので"],["は"],["ない"],["。"]]},{"verse":3,"text":"ネリヤの子バルクが、あなたをそそのかして私たちに逆らわせ、私たちをカルデヤ人の手に渡して、私たちを死なせ、また、私たちをバビロンへ引いて行かせようとしているのだ。」","tok":[["ネリヤ"],["の"],["子","こ"],["バルク"],["が"],["、"],["あなた"],["を"],["そそのかして"],["私たち","わたしたち"],["に"],["逆らわせ","さからわせ"],["、"],["私たち","わたしたち"],["を"],["カルデヤ"],["人","にん"],["の"],["手","て"],["に"],["渡して","わたして"],["、"],["私たち","わたしたち"],["を"],["死なせ","しなせ"],["、"],["また"],["、"],["私たち","わたしたち"],["を"],["バビロン"],["へ"],["引いて","ひいて"],["行かせよう","いかせよう"],["として"],["いる"],["の"],["だ"],["。"],["」"]]},{"verse":4,"text":"カレアハの子ヨハナンと、すべての将校と、すべての民は、「ユダの国にとどまれ」という主の御声に聞き従わなかった。","tok":[["カレアハ"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["すべて"],["の"],["将校","しょうこう"],["と"],["、"],["すべて"],["の"],["民","たみ"],["は"],["、"],["「"],["ユダ"],["の"],["国","くに"],["に"],["とどまれ"],["」"],["と"],["いう"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"]]},{"verse":5,"text":"そして、カレアハの子ヨハナンと、すべての将校は、散らされていた国々からユダの国に住むために帰っていたユダの残りの者すべてを、","tok":[["そして"],["、"],["カレアハ"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["すべて"],["の"],["将校","しょうこう"],["は"],["、"],["散らされて","ちらされて"],["いた"],["国々","くにぐに"],["から"],["ユダ"],["の"],["国","くに"],["に"],["住む","すむ"],["ため"],["に"],["帰って","かえって"],["いた"],["ユダ"],["の"],["残り","のこり"],["の"],["者","もの"],["すべて"],["を"],["、"]]},{"verse":6,"text":"男も女も子どもも、王の娘も、それに、侍従長ネブザルアダンが、シャファンの子アヒカムの子ゲダルヤに託したすべての者、預言者エレミヤと、ネリヤの子バルクをも連れて、","tok":[["男","おとこ"],["も"],["女","おんな"],["も"],["子ども","こども"],["も"],["、"],["王","おう"],["の"],["娘","むすめ"],["も"],["、"],["それ"],["に"],["、"],["侍従長","じじゅうちょう"],["ネブザルアダン"],["が"],["、"],["シャファン"],["の"],["子","こ"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["に"],["託した","たくした"],["すべて"],["の"],["者","もの"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["と"],["、"],["ネリヤ"],["の"],["子","こ"],["バルク"],["を"],["も"],["連れて","つれて"],["、"]]},{"verse":7,"text":"エジプトの国に行った。彼らは主の御声に聞き従わなかったのである。こうして、彼らはタフパヌヘスまで来た。","tok":[["エジプト"],["の"],["国","くに"],["に"],["行った","いった"],["。"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["ので"],["ある"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["タフパヌヘス"],["まで"],["来た","きた"],["。"]]},{"verse":8,"text":"タフパヌヘスで、エレミヤに次のような主のことばがあった。","tok":[["タフパヌヘス"],["で"],["、"],["エレミヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":9,"text":"「あなたは手に大きな石を取り、それらを、ユダヤ人たちの目の前で、タフパヌヘスにあるパロの宮殿の入口にある敷石のしっくいの中に隠して、","tok":[["「"],["あなた"],["は"],["手","て"],["に"],["大きな","おおきな"],["石","いし"],["を"],["取り","とり"],["、"],["それ"],["ら"],["を"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["タフパヌヘス"],["に"],["ある"],["パロ"],["の"],["宮殿","きゅうでん"],["の"],["入口","いりぐち"],["に"],["ある"],["敷石","しきいし"],["の"],["しっくい"],["の"],["中","なか"],["に"],["隠して","かくして"],["、"]]},{"verse":10,"text":"彼らに言え。／イスラエルの神、万軍の主は、こう仰せられる。見よ。わたしは人を送り、わたしのしもべバビロンの王ネブカデレザルを連れて来て、彼の王座を、わたしが隠したこれらの石の上に据える。彼はその石の上に本営を張ろう。","tok":[["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["／"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["人","ひと"],["を"],["送り","おくり"],["、"],["わたし"],["の"],["しもべ"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["を"],["連れて","つれて"],["来て","きて"],["、"],["彼","かれ"],["の"],["王座","おうざ"],["を"],["、"],["わたし"],["が"],["隠した","かくした"],["これ"],["ら"],["の"],["石","いし"],["の"],["上","うえ"],["に"],["据える","すえる"],["。"],["彼","かれ"],["は"],["その"],["石","いし"],["の"],["上","うえ"],["に"],["本営","ほんえい"],["を"],["張ろう","はろう"],["。"]]},{"verse":11,"text":"彼は来てエジプトの国を打ち、死に定められた者を死に渡し、とりこに定められた者をとりこにし、剣に定められた者を剣に渡す。","tok":[["彼","かれ"],["は"],["来て","きて"],["エジプト"],["の"],["国","くに"],["を"],["打ち","うち"],["、"],["死","し"],["に"],["定められた","さだめられた"],["者","もの"],["を"],["死に","しに"],["渡し","わたし"],["、"],["とりこ"],["に"],["定められた","さだめられた"],["者","もの"],["を"],["とりこ"],["に"],["し"],["、"],["剣","けん"],["に"],["定められた","さだめられた"],["者","もの"],["を"],["剣","けん"],["に"],["渡す","わたす"],["。"]]},{"verse":12,"text":"彼はエジプトの神々の宮に火をつけて、それらを焼き、彼らをとりこにする。彼は牧者が自分の着物のしらみをつぶすようにエジプトの国をつぶして、ここから無事に去って行こう。","tok":[["彼","かれ"],["は"],["エジプト"],["の"],["神々","かみがみ"],["の"],["宮","みや"],["に"],["火","ひ"],["を"],["つけて"],["、"],["それ"],["ら"],["を"],["焼き","やき"],["、"],["彼","かれ"],["ら"],["を"],["とりこ"],["に"],["する"],["。"],["彼","かれ"],["は"],["牧者","ぼくしゃ"],["が"],["自分","じぶん"],["の"],["着物","きもの"],["の"],["しらみ"],["を"],["つぶす"],["よう"],["に"],["エジプト"],["の"],["国","くに"],["を"],["つぶして"],["、"],["ここ"],["から"],["無事","ぶじ"],["に"],["去って","さって"],["行こう","いこう"],["。"]]},{"verse":13,"text":"彼はエジプトの国にある太陽の宮の柱を砕き、エジプトの神々の宮を火で焼こう。」","tok":[["彼","かれ"],["は"],["エジプト"],["の"],["国","くに"],["に"],["ある"],["太陽","たいよう"],["の"],["宮","みや"],["の"],["柱","はしら"],["を"],["砕き","くだき"],["、"],["エジプト"],["の"],["神々","かみがみ"],["の"],["宮","みや"],["を"],["火","ひ"],["で"],["焼こう","やこう"],["。"],["」"]]}]
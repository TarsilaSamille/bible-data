[{"verse":1,"text":"主はこう仰せられる。「行って、土の焼き物のびんを買い、民の長老と年長の祭司のうちの数人といっしょに、","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["行って","いって"],["、"],["土","つち"],["の"],["焼き物","やきもの"],["の"],["びん"],["を"],["買い","かい"],["、"],["民","みん"],["の"],["長老","ちょうろう"],["と"],["年長","ねんちょう"],["の"],["祭司","さいし"],["の"],["うち"],["の"],["数人","すうにん"],["と"],["いっしょ"],["に"],["、"]]},{"verse":2,"text":"『瀬戸のかけらの門』の入口にあるベン・ヒノムの谷に出かけ、そこで、わたしがあなたに語ることばを呼ばわって、","tok":[["『"],["瀬戸","せと"],["の"],["かけら"],["の"],["門","もん"],["』"],["の"],["入口","いりぐち"],["に"],["ある"],["ベン"],["・"],["ヒノム"],["の"],["谷","たに"],["に"],["出かけ","でかけ"],["、"],["そこ"],["で"],["、"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["ことば"],["を"],["呼ばわって","よばわって"],["、"]]},{"verse":3,"text":"言え。『ユダの王たちとエルサレムの住民よ。主のことばを聞け。イスラエルの神、万軍の主は、こう仰せられる。見よ。わたしはこの所にわざわいをもたらす。だれでも、そのことを聞く者は、耳鳴りがする。","tok":[["言え","いえ"],["。"],["『"],["ユダ"],["の"],["王","おう"],["たち"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["よ"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["この"],["所","ところ"],["に"],["わざわい"],["を"],["もたらす"],["。"],["だれ"],["で"],["も"],["、"],["その"],["こと"],["を"],["聞く","きく"],["者","もの"],["は"],["、"],["耳鳴り","みみなり"],["が"],["する"],["。"]]},{"verse":4,"text":"彼らがわたしを捨ててこの所を見分けがつかないほどにし、この所で、彼らも彼らの先祖も、ユダの王たちも知らなかったほかの神々にいけにえをささげ、この所を罪のない者の血で満たし、","tok":[["彼","かれ"],["ら"],["が"],["わたし"],["を"],["捨てて","すてて"],["この"],["所","ところ"],["を"],["見分け","みわけ"],["が"],["つかない"],["ほど"],["に"],["し"],["、"],["この"],["所","ところ"],["で"],["、"],["彼","かれ"],["ら"],["も"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["も"],["、"],["ユダ"],["の"],["王","おう"],["たち"],["も"],["知らなかった","しらなかった"],["ほか"],["の"],["神々","かみがみ"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["この"],["所","ところ"],["を"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["で"],["満たし","みたし"],["、"]]},{"verse":5,"text":"バアルのために自分の子どもたちを全焼のいけにえとして火で焼くため、バアルの高き所を築いたからである。このような事は、わたしが命じたこともなく、語ったこともなく、思いつきもしなかったことだ。","tok":[["バアル"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["子ども","こども"],["たち"],["を"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["火","ひ"],["で"],["焼く","やく"],["ため"],["、"],["バアル"],["の"],["高き","たかき"],["所","ところ"],["を"],["築いた","きずいた"],["から"],["で"],["ある"],["。"],["この"],["よう"],["な"],["事","こと"],["は"],["、"],["わたし"],["が"],["命じた","めいじた"],["こと"],["も"],["なく"],["、"],["語った","かたった"],["こと"],["も"],["なく"],["、"],["思いつき","おもいつき"],["も"],["しなかった"],["こと"],["だ"],["。"]]},{"verse":6,"text":"それゆえ、見よ、その日が来る。――主の御告げ――その日には、この所はもはや、トフェテとかベン・ヒノムの谷とか呼ばれない。ただ虐殺の谷と呼ばれる。","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["その"],["日","ひ"],["が"],["来る","くる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["その"],["日","ひ"],["に"],["は"],["、"],["この"],["所","ところ"],["は"],["もはや"],["、"],["トフェテ"],["と"],["か"],["ベン"],["・"],["ヒノム"],["の"],["谷","たに"],["と"],["か"],["呼ばれない","よばれない"],["。"],["ただ"],["虐殺","ぎゃくさつ"],["の"],["谷","たに"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":7,"text":"また、わたしはこの所で、ユダとエルサレムのはかりごとをこぼち、彼らを敵の前で、剣で倒し、またいのちをねらう者の手によって倒し、そのしかばねを、空の鳥や地の獣にえじきとして与える。","tok":[["また"],["、"],["わたし"],["は"],["この"],["所","ところ"],["で"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["はかりごと"],["を"],["こ"],["ぼ"],["ち"],["、"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["前","まえ"],["で"],["、"],["剣","けん"],["で"],["倒し","たおし"],["、"],["また"],["いのち"],["を"],["ねらう"],["者","もの"],["の"],["手","て"],["によって"],["倒し","たおし"],["、"],["その"],["しかばね"],["を"],["、"],["空","そら"],["の"],["鳥","とり"],["や"],["地","ち"],["の"],["獣","けもの"],["に"],["えじき"],["として"],["与える","あたえる"],["。"]]},{"verse":8,"text":"また、わたしはこの町を恐怖とし、あざけりとする。そこを通り過ぎる者はみな、色を失い、そのすべての打ち傷を見てあざける。","tok":[["また"],["、"],["わたし"],["は"],["この"],["町","まち"],["を"],["恐怖","きょうふ"],["と"],["し"],["、"],["あざけり"],["と"],["する"],["。"],["そこ"],["を"],["通り過ぎる","とおりすぎる"],["者","もの"],["は"],["みな"],["、"],["色","いろ"],["を"],["失い","うしない"],["、"],["その"],["すべて"],["の"],["打ち傷","うちきず"],["を"],["見て","みて"],["あざける"],["。"]]},{"verse":9,"text":"またわたしは、包囲と、彼らの敵、いのちをねらう者がもたらす窮乏のために、彼らに自分の息子の肉、娘の肉を食べさせる。彼らは互いにその友の肉を食べ合う。』","tok":[["また"],["わたし"],["は"],["、"],["包囲","ほうい"],["と"],["、"],["彼","かれ"],["ら"],["の"],["敵","てき"],["、"],["いのち"],["を"],["ねらう"],["者","もの"],["が"],["もたらす"],["窮乏","きゅうぼう"],["の"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["に"],["自分","じぶん"],["の"],["息子","むすこ"],["の"],["肉","にく"],["、"],["娘","むすめ"],["の"],["肉","にく"],["を"],["食べさせる","たべさせる"],["。"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["その"],["友","とも"],["の"],["肉","にく"],["を"],["食べ合う","たべあう"],["。"],["』"]]},{"verse":10,"text":"そこであなたは、同行の人々の目の前で、そのびんを砕いて、","tok":[["そこ"],["で"],["あなた"],["は"],["、"],["同行","どうこう"],["の"],["人々","ひとびと"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["その"],["びん"],["を"],["砕いて","くだいて"],["、"]]},{"verse":11,"text":"彼らに言え。『万軍の主はこう仰せられる。陶器師の器が砕かれると、二度と直すことができない。このように、わたしはこの民と、この町を砕く。人々はトフェテに葬る余地がないほどに葬る。","tok":[["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["陶器師","とうきし"],["の"],["器","うつわ"],["が"],["砕かれる","くだかれる"],["と"],["、"],["二","に"],["度","ど"],["と"],["直す","なおす"],["こと"],["が"],["できない"],["。"],["この"],["よう"],["に"],["、"],["わたし"],["は"],["この"],["民","たみ"],["と"],["、"],["この"],["町","まち"],["を"],["砕く","くだく"],["。"],["人々","ひとびと"],["は"],["トフェテ"],["に"],["葬る","ほうむる"],["余地","よち"],["が"],["ない"],["ほど"],["に"],["葬る","ほうむる"],["。"]]},{"verse":12,"text":"わたしはこの所と、――主の御告げ――その住民にこうしよう。わたしはこの町をトフェテのようにする。","tok":[["わたし"],["は"],["この"],["所","ところ"],["と"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["その"],["住民","じゅうみん"],["に"],["こう"],["しよう"],["。"],["わたし"],["は"],["この"],["町","まち"],["を"],["トフェテ"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":13,"text":"エルサレムの家々とユダの王の家々、すなわち、彼らが屋上で天の万象に香をたき、ほかの神々に注ぎのぶどう酒を注いだすべての家々は、トフェテの地のように汚される。』」","tok":[["エルサレム"],["の"],["家々","いえいえ"],["と"],["ユダ"],["の"],["王","おう"],["の"],["家々","いえいえ"],["、"],["すなわち"],["、"],["彼","かれ"],["ら"],["が"],["屋上","おくじょう"],["で"],["天","てん"],["の"],["万象","ばんしょう"],["に"],["香","こう"],["を"],["たき"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注いだ","そそいだ"],["すべて"],["の"],["家々","いえいえ"],["は"],["、"],["トフェテ"],["の"],["地","ち"],["の"],["よう"],["に"],["汚される","よごされる"],["。"],["』"],["」"]]},{"verse":14,"text":"そこでエレミヤは、主が預言のために遣わしたトフェテから帰って来て、主の宮の庭に立ち、すべての民に言った。","tok":[["そこ"],["で"],["エレミヤ"],["は"],["、"],["主","ぬし"],["が"],["預言","よげん"],["の"],["ため"],["に"],["遣わした","つかわした"],["トフェテ"],["から"],["帰って","かえって"],["来て","きて"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["庭","にわ"],["に"],["立ち","たち"],["、"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["。"]]},{"verse":15,"text":"「イスラエルの神、万軍の主は、こう仰せられる。『見よ。わたしはこの町と、すべての町々に、わたしが告げたすべてのわざわいをもたらす。彼らがうなじのこわい者となって、わたしのことばに聞き従おうとしなかったからである。』」","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["この"],["町","まち"],["と"],["、"],["すべて"],["の"],["町々","まちまち"],["に"],["、"],["わたし"],["が"],["告げた","つげた"],["すべて"],["の"],["わざわい"],["を"],["もたらす"],["。"],["彼","かれ"],["ら"],["が"],["うなじ"],["の"],["こわい"],["者","もの"],["と"],["なって"],["、"],["わたし"],["の"],["ことば"],["に"],["聞き従おう","ききしたがおう"],["と"],["しなかった"],["から"],["で"],["ある"],["。"],["』"],["」"]]}]
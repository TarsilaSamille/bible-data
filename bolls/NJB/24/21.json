[{"verse":1,"text":"主からエレミヤにあったみことば。ゼデキヤ王は、マルキヤの子パシュフルと、マアセヤの子、祭司ゼパニヤをエレミヤのもとに遣わしてこう言わせた。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["。"],["ゼデキヤ"],["王","おう"],["は"],["、"],["マルキヤ"],["の"],["子","こ"],["パシュフル"],["と"],["、"],["マアセヤ"],["の"],["子","こ"],["、"],["祭司","さいし"],["ゼパニヤ"],["を"],["エレミヤ"],["の"],["もと"],["に"],["遣わして","つかわして"],["こう"],["言わせた","いわせた"],["。"]]},{"verse":2,"text":"「どうか、私たちのために主に尋ねてください。バビロンの王ネブカデレザルが私たちを攻めています。主がかつて、あらゆる奇しいみわざを行われたように、私たちにも行い、彼を私たちから離れ去らせてくださるかもしれませんから。」","tok":[["「"],["どう"],["か"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["主に","おもに"],["尋ねて","たずねて"],["ください"],["。"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["私たち","わたしたち"],["を"],["攻めて","せめて"],["います"],["。"],["主","ぬし"],["が"],["かつて"],["、"],["あらゆる"],["奇しい","くすしい"],["みわざ"],["を"],["行われた","おこなわれた"],["よう"],["に"],["、"],["私たち","わたしたち"],["に"],["も"],["行い","おこない"],["、"],["彼","かれ"],["を"],["私たち","わたしたち"],["から"],["離れ去らせて","はなれさらせて"],["くださる"],["か"],["も"],["しれません"],["から"],["。"],["」"]]},{"verse":3,"text":"エレミヤは彼らに言った。「あなたがたは、ゼデキヤにこう言いなさい。","tok":[["エレミヤ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["ゼデキヤ"],["に"],["こう"],["言い","いい"],["なさい"],["。"]]},{"verse":4,"text":"イスラエルの神、主は、こう仰せられる。『見よ。あなたがたは、城壁の外からあなたがたを囲んでいるバビロンの王とカルデヤ人とに向かって戦っているが、わたしは、あなたがたの手にしている武具を取り返して、それをこの町の中に集め、","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["城壁","じょうへき"],["の"],["外","そと"],["から"],["あなた"],["がた"],["を"],["囲んで","かこんで"],["いる"],["バビロン"],["の"],["王","おう"],["と"],["カルデヤ"],["人","にん"],["と"],["に"],["向かって","むかって"],["戦って","たたかって"],["いる"],["が"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["手","て"],["に"],["して"],["いる"],["武具","ぶぐ"],["を"],["取り返して","とりかえして"],["、"],["それ"],["を"],["この"],["町","まち"],["の"],["中","なか"],["に"],["集め","あつめ"],["、"]]},{"verse":5,"text":"わたし自身が、伸ばした手と強い腕と、怒りと、憤りと、激怒とをもって、あなたがたと戦い、","tok":[["わたし"],["自身","じしん"],["が"],["、"],["伸ばした","のばした"],["手","て"],["と"],["強い","つよい"],["腕","うで"],["と"],["、"],["怒り","いかり"],["と"],["、"],["憤り","いきどおり"],["と"],["、"],["激怒","げきど"],["と"],["を"],["もって"],["、"],["あなた"],["がた"],["と"],["戦い","たたかい"],["、"]]},{"verse":6,"text":"この町に住むものは、人間も獣も打ち、彼らはひどい疫病で死ぬ。","tok":[["この"],["町","まち"],["に"],["住む","すむ"],["もの"],["は"],["、"],["人間","にんげん"],["も"],["獣","けもの"],["も"],["打ち","うち"],["、"],["彼","かれ"],["ら"],["は"],["ひどい"],["疫病","やくびょう"],["で"],["死ぬ","しぬ"],["。"]]},{"verse":7,"text":"そのあとで、――主の御告げ――わたしはユダの王ゼデキヤと、その家来と、その民と、この町で、疫病や剣やききんからのがれて生き残った者たちとを、バビロンの王ネブカデレザルの手、敵の手、いのちをねらう者たちの手に渡す。彼は彼らを剣の刃で打ち、彼らを惜しまず、容赦せず、あわれまない。』」","tok":[["その"],["あと"],["で"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["は"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["と"],["、"],["その"],["家来","けらい"],["と"],["、"],["その"],["民","たみ"],["と"],["、"],["この"],["町","まち"],["で"],["、"],["疫病","やくびょう"],["や"],["剣","けん"],["や"],["ききん"],["から"],["のがれて"],["生き残った","いきのこった"],["者","もの"],["たち"],["と"],["を"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["手","て"],["、"],["敵","てき"],["の"],["手","て"],["、"],["いのち"],["を"],["ねらう"],["者","もの"],["たち"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["を"],["剣","けん"],["の"],["刃","は"],["で"],["打ち","うち"],["、"],["彼","かれ"],["ら"],["を"],["惜しまず","おしまず"],["、"],["容赦","ようしゃ"],["せず"],["、"],["あわれまない"],["。"],["』"],["」"]]},{"verse":8,"text":"「あなたは、この民に言え。／主はこう仰せられる。『見よ。わたしはあなたがたの前に、いのちの道と死の道を置く。","tok":[["「"],["あなた"],["は"],["、"],["この"],["民","たみ"],["に"],["言え","いえ"],["。"],["／"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["、"],["いのち"],["の"],["道","みち"],["と"],["死","し"],["の"],["道","みち"],["を"],["置く","おく"],["。"]]},{"verse":9,"text":"この町にとどまる者は、剣とききんと疫病によって死ぬが、出て、あなたがたを囲んでいるカルデヤ人にくだる者は、生きて、そのいのちは彼の分捕り物となる。","tok":[["この"],["町","まち"],["に"],["とどまる"],["者","もの"],["は"],["、"],["剣","けん"],["と"],["ききん"],["と"],["疫病","やくびょう"],["によって"],["死ぬ","しぬ"],["が"],["、"],["出て","でて"],["、"],["あなた"],["がた"],["を"],["囲んで","かこんで"],["いる"],["カルデヤ"],["人","にん"],["に"],["くだる"],["者","もの"],["は"],["、"],["生きて","いきて"],["、"],["その"],["いのち"],["は"],["彼","かれ"],["の"],["分","ぶん"],["捕り物","とりもの"],["と"],["なる"],["。"]]},{"verse":10,"text":"なぜならわたしは、幸いのためにではなく、わざわいのためにこの町から顔をそむけるからである。――主の御告げ――この町は、バビロンの王の手に渡され、彼はこれを火で焼くであろう。』」","tok":[["なぜ"],["なら"],["わたし"],["は"],["、"],["幸い","さいわい"],["の"],["ため"],["に"],["で"],["は"],["なく"],["、"],["わざわい"],["の"],["ため"],["に"],["この"],["町","まち"],["から"],["顔","かお"],["を"],["そむける"],["から"],["で"],["ある"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["この"],["町","まち"],["は"],["、"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["彼","かれ"],["は"],["これ"],["を"],["火","ひ"],["で"],["焼くで","やくで"],["あろう"],["。"],["』"],["」"]]},{"verse":11,"text":"ユダの王家のために――／「主のことばを聞け。","tok":[["ユダ"],["の"],["王家","おうけ"],["の"],["ため"],["に"],["―"],["―"],["／"],["「"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":12,"text":"ダビデの家よ。主はこう仰せられる。／朝ごとに、正しいさばきを行い、かすめられている者を、しいたげる者の手から救い出せ。／さもないと、あなたがたの悪行のために、わたしの憤りが火のように燃えて焼き尽くし、消す者はいない。」","tok":[["ダビデ"],["の"],["家","いえ"],["よ"],["。"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["朝","あさ"],["ごと"],["に"],["、"],["正しい","ただしい"],["さばき"],["を"],["行い","おこない"],["、"],["かすめられて"],["いる"],["者","もの"],["を"],["、"],["しいたげる"],["者","もの"],["の"],["手","て"],["から"],["救い出せ","すくいだせ"],["。"],["／"],["さも"],["ない"],["と"],["、"],["あなた"],["がた"],["の"],["悪行","あくぎょう"],["の"],["ため"],["に"],["、"],["わたし"],["の"],["憤り","いきどおり"],["が"],["火","ひ"],["の"],["よう"],["に"],["燃えて","もえて"],["焼き","やき"],["尽くし","つくし"],["、"],["消す","けす"],["者","もの"],["は"],["いない"],["。"],["」"]]},{"verse":13,"text":"「ああ、この谷に住む者、平地の岩よ。／あなたに言う。――主の御告げ――／あなたがたは、『だれが、私たちのところに下って来よう。／だれが、私たちの住まいに入れよう』と／言っている。","tok":[["「"],["ああ"],["、"],["この"],["谷","たに"],["に"],["住む","すむ"],["者","もの"],["、"],["平地","へいち"],["の"],["岩","いわ"],["よ"],["。"],["／"],["あなた"],["に"],["言う","ゆう"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["あなた"],["がた"],["は"],["、"],["『"],["だれ"],["が"],["、"],["私たち","わたしたち"],["の"],["ところ"],["に"],["下って","くだって"],["来よう","こよう"],["。"],["／"],["だれ"],["が"],["、"],["私たち","わたしたち"],["の"],["住まい","すまい"],["に"],["入れよう","いれよう"],["』"],["と"],["／"],["言って","いって"],["いる"],["。"]]},{"verse":14,"text":"わたしはあなたがたを、その行いの実にしたがって罰する。／――主の御告げ――／また、わたしは、その林に火をつける。／火はその周辺をことごとく焼き尽くす。」","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["その"],["行い","おこない"],["の"],["実","じつ"],["に"],["したがって"],["罰する","ばっする"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["また"],["、"],["わたし"],["は"],["、"],["その"],["林","はやし"],["に"],["火","ひ"],["を"],["つける"],["。"],["／"],["火","ひ"],["は"],["その"],["周辺","しゅうへん"],["を"],["ことごとく"],["焼き","やき"],["尽くす","つくす"],["。"],["」"]]}]
[{"verse":1,"text":"エルサレムのちまたを行き巡り、さあ、見て知るがよい。／その広場で捜して、だれか公義を行い、真実を求める者を見つけたら、わたしはエルサレムを赦そう。","tok":[["エルサレム"],["の"],["ちまた"],["を"],["行き","いき"],["巡り","めぐり"],["、"],["さあ"],["、"],["見て","みて"],["知る","しる"],["が"],["よい"],["。"],["／"],["その"],["広場","ひろば"],["で"],["捜して","さがして"],["、"],["だれ"],["か"],["公義","きみよし"],["を"],["行い","おこない"],["、"],["真実","しんじつ"],["を"],["求める","もとめる"],["者","もの"],["を"],["見つけたら","みつけたら"],["、"],["わたし"],["は"],["エルサレム"],["を"],["赦そう","ゆるそう"],["。"]]},{"verse":2,"text":"たとい彼らが、「主は生きておられる」と言っても、実は、彼らは偽って誓っているのだ。","tok":[["たとい"],["彼","かれ"],["ら"],["が"],["、"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["」"],["と"],["言って","いって"],["も"],["、"],["実","じつ"],["は"],["、"],["彼","かれ"],["ら"],["は"],["偽って","いつわって"],["誓って","ちかって"],["いる"],["の"],["だ"],["。"]]},{"verse":3,"text":"主よ。あなたの目は、真実に向けられていないのでしょうか。／あなたが彼らを打たれたのに、彼らは痛みもしませんでした。／彼らを絶ち滅ぼそうとされたのに、彼らは懲らしめを受けようともしませんでした。／彼らは顔を岩よりも堅くし、悔い改めようともしませんでした。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["目","め"],["は"],["、"],["真実","しんじつ"],["に"],["向けられて","むけられて"],["いない"],["の"],["でしょう"],["か"],["。"],["／"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["打たれた","うたれた"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["痛み","いたみ"],["も"],["しませんでした"],["。"],["／"],["彼","かれ"],["ら"],["を"],["絶ち","たち"],["滅ぼそう","ほろぼそう"],["と"],["された"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["懲らしめ","こらしめ"],["を"],["受けよう","うけよう"],["ともしませんでした"],["。"],["／"],["彼","かれ"],["ら"],["は"],["顔","かお"],["を"],["岩","いわ"],["より"],["も"],["堅く","かたく"],["し"],["、"],["悔い改めよう","くいあらためよう"],["ともしませんでした"],["。"]]},{"verse":4,"text":"そこで、私は思いました。／「彼らは、実に卑しい愚か者だ。／主の道も、神のさばきも知りもしない。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["思いました","おもいました"],["。"],["／"],["「"],["彼","かれ"],["ら"],["は"],["、"],["実","じつ"],["に"],["卑しい","いやしい"],["愚か者","おろかもの"],["だ"],["。"],["／"],["主","ぬし"],["の"],["道","みち"],["も"],["、"],["神","かみ"],["の"],["さばき"],["も"],["知り","しり"],["も"],["しない"],["。"]]},{"verse":5,"text":"だから、身分の高い者たちのところへ行って、彼らと語ろう。／彼らなら、主の道も、神のさばきも知っているから。」／ところが、彼らもみな、くびきを砕き、なわめを断ち切っていました。","tok":[["だ"],["から"],["、"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["たち"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["彼","かれ"],["ら"],["と"],["語ろう","かたろう"],["。"],["／"],["彼","かれ"],["ら"],["なら"],["、"],["主","ぬし"],["の"],["道","みち"],["も"],["、"],["神","かみ"],["の"],["さばき"],["も"],["知って","しって"],["いる"],["から"],["。"],["」"],["／"],["ところ"],["が"],["、"],["彼","かれ"],["ら"],["も"],["みな"],["、"],["くびき"],["を"],["砕き","くだき"],["、"],["なわ"],["め"],["を"],["断ち切って","たちきって"],["いました"],["。"]]},{"verse":6,"text":"それゆえ、森の獅子が彼らを殺し、荒れた地の狼が彼らを荒らす。／ひょうが彼らの町々をうかがう。／町から出る者をみな、引き裂こう。／彼らが多くの罪を犯し、その背信がはなはだしかったからだ。","tok":[["それ"],["ゆえ"],["、"],["森","もり"],["の"],["獅子","しし"],["が"],["彼","かれ"],["ら"],["を"],["殺し","ころし"],["、"],["荒れた","あれた"],["地","ち"],["の"],["狼","おおかみ"],["が"],["彼","かれ"],["ら"],["を"],["荒らす","あらす"],["。"],["／"],["ひょう"],["が"],["彼","かれ"],["ら"],["の"],["町々","まちまち"],["を"],["うかがう"],["。"],["／"],["町","まち"],["から"],["出る","でる"],["者","もの"],["を"],["みな"],["、"],["引き裂こう","ひきさこう"],["。"],["／"],["彼","かれ"],["ら"],["が"],["多く","おおく"],["の"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["その"],["背信","はいしん"],["が"],["はなはだしかった"],["から"],["だ"],["。"]]},{"verse":7,"text":"これでは、どうして、わたしがあなたを赦せよう。／あなたの子らはわたしを捨て、神でないものによって誓っていた。／わたしが彼らを満ち足らせたときも、彼らは姦通をし、遊女の家で身を傷つけた。","tok":[["これ"],["で"],["は"],["、"],["どう"],["して"],["、"],["わたし"],["が"],["あなた"],["を"],["赦せよう","ゆるせよう"],["。"],["／"],["あなた"],["の"],["子","こ"],["ら"],["は"],["わたし"],["を"],["捨て","すて"],["、"],["神","かみ"],["で"],["ない"],["もの"],["によって"],["誓って","ちかって"],["いた"],["。"],["／"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["満ち","みち"],["足らせた","たらせた"],["とき"],["も"],["、"],["彼","かれ"],["ら"],["は"],["姦通","かんつう"],["を"],["し"],["、"],["遊女","ゆうじょ"],["の"],["家","いえ"],["で"],["身","み"],["を"],["傷つけた","きずつけた"],["。"]]},{"verse":8,"text":"彼らは、肥え太ってさかりのついた馬のように、おのおの隣の妻を慕っていななく。","tok":[["彼","かれ"],["ら"],["は"],["、"],["肥え太って","こえふとって"],["さかり"],["の"],["ついた"],["馬","うま"],["の"],["よう"],["に"],["、"],["おのおの"],["隣","となり"],["の"],["妻","つま"],["を"],["慕って","したって"],["いななく"],["。"]]},{"verse":9,"text":"これらに対して、わたしが罰しないだろうか。／――主の御告げ――／このような国に、わたしが復讐しないだろうか。","tok":[["これ"],["ら"],["に対して","にたいして"],["、"],["わたし"],["が"],["罰しないだろう","ばっしないだろう"],["か"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["この"],["よう"],["な"],["国","くに"],["に"],["、"],["わたし"],["が"],["復讐","ふくしゅう"],["しないだろう"],["か"],["。"]]},{"verse":10,"text":"ぶどう畑の石垣に上って滅ぼせ。／しかし、ことごとく滅ぼしてはならない。／そのつるを除け。／それらは主のものではないからだ。","tok":[["ぶどう"],["畑","はたけ"],["の"],["石垣","いしがき"],["に"],["上って","のぼって"],["滅ぼせ","ほろぼせ"],["。"],["／"],["しかし"],["、"],["ことごとく"],["滅ぼして","ほろぼして"],["は"],["ならない"],["。"],["／"],["その"],["つる"],["を"],["除け","よけ"],["。"],["／"],["それ"],["ら"],["は"],["主","ぬし"],["の"],["もの"],["で"],["は"],["ない"],["から"],["だ"],["。"]]},{"verse":11,"text":"イスラエルの家とユダの家とは、大いにわたしを裏切ったからだ。／――主の御告げ――","tok":[["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["と"],["は"],["、"],["大いに","おおいに"],["わたし"],["を"],["裏切った","うらぎった"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":12,"text":"彼らは主を否んでこう言った。／「主が何だ。／わざわいは私たちを襲わない。／剣もききんも、私たちは、見はしない。","tok":[["彼","かれ"],["ら"],["は"],["主","ぬし"],["を"],["否んで","いなんで"],["こう"],["言った","いった"],["。"],["／"],["「"],["主","ぬし"],["が"],["何","なん"],["だ"],["。"],["／"],["わざわい"],["は"],["私たち","わたしたち"],["を"],["襲わない","おそわない"],["。"],["／"],["剣","けん"],["も"],["ききん"],["も"],["、"],["私たち","わたしたち"],["は"],["、"],["見","み"],["は"],["しない"],["。"]]},{"verse":13,"text":"預言者たちは風になり、みことばは彼らのうちにない。／彼らはこのようになる。」","tok":[["預言者","よげんしゃ"],["たち"],["は"],["風","ふう"],["に"],["なり"],["、"],["みことば"],["は"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["ない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["この"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":14,"text":"それゆえ、万軍の神、主は、こう仰せられる。／「あなたがたが、このようなことを言ったので、見よ、わたしは、あなたの口にあるわたしのことばを火とし、この民をたきぎとする。／火は彼らを焼き尽くす。","tok":[["それ"],["ゆえ"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["あなた"],["が"],["た"],["が"],["、"],["この"],["よう"],["な"],["こと"],["を"],["言った","いった"],["ので"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["口","くち"],["に"],["ある"],["わたし"],["の"],["ことば"],["を"],["火","ひ"],["と"],["し"],["、"],["この"],["民","たみ"],["を"],["たきぎ"],["と"],["する"],["。"],["／"],["火","ひ"],["は"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くす","つくす"],["。"]]},{"verse":15,"text":"イスラエルの家よ。／見よ。わたしはあなたがたを攻めに、遠くの地から一つの国民を連れて来る。／――主の御告げ――／それは古くからある国、昔からある国、そのことばをあなたは知らず、何を話しているのか聞き取れない国。","tok":[["イスラエル"],["の"],["家","いえ"],["よ"],["。"],["／"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["攻め","せめ"],["に"],["、"],["遠く","とおく"],["の"],["地","ち"],["から"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["を"],["連れて","つれて"],["来る","くる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["それ"],["は"],["古く","ふるく"],["から"],["ある"],["国","くに"],["、"],["昔","むかし"],["から"],["ある"],["国","くに"],["、"],["その"],["ことば"],["を"],["あなた"],["は"],["知らず","しらず"],["、"],["何","なん"],["を"],["話して","はなして"],["いる"],["の"],["か"],["聞き取れない","ききとれない"],["国","くに"],["。"]]},{"verse":16,"text":"その矢筒は開いた墓のようだ。／彼らはみなつわもの。","tok":[["その"],["矢筒","やづつ"],["は"],["開いた","ひらいた"],["墓","はか"],["の"],["よう"],["だ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["つわもの"],["。"]]},{"verse":17,"text":"彼らはあなたの刈り入れたものと／あなたのパンを食らい、あなたの息子、娘を食らい、あなたの羊の群れと牛の群れを食らい、あなたのぶどうと、いちじくを食らい、あなたの拠り頼む城壁のある町々を、剣で打ち破る。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["刈り入れた","かりいれた"],["もの"],["と"],["／"],["あなた"],["の"],["パン"],["を"],["食らい","くらい"],["、"],["あなた"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["を"],["食らい","くらい"],["、"],["あなた"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["と"],["牛","うし"],["の"],["群れ","むれ"],["を"],["食らい","くらい"],["、"],["あなた"],["の"],["ぶどう"],["と"],["、"],["いちじく"],["を"],["食らい","くらい"],["、"],["あなた"],["の"],["拠り","より"],["頼む","たのむ"],["城壁","じょうへき"],["の"],["ある"],["町々","まちまち"],["を"],["、"],["剣","けん"],["で"],["打ち破る","うちやぶる"],["。"]]},{"verse":18,"text":"しかし、その日にも、――主の御告げ――／わたしはあなたがたを、ことごとくは滅ぼさない。」","tok":[["しかし"],["、"],["その"],["日","ひ"],["に"],["も"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["ことごとく"],["は"],["滅ぼさない","ほろぼさない"],["。"],["」"]]},{"verse":19,"text":"「あなたがたが、『何のために、私たちの神、主は、これらすべての事を私たちにしたのか』と尋ねるときは、あなたは彼らにこう言え。『あなたがたが、わたしを捨て、あなたがたの国内で、外国の神々に仕えたように、あなたがたの国ではない地で、他国人に仕えるようになる。』","tok":[["「"
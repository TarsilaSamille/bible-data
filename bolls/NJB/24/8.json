[{"verse":1,"text":"その時、――主の御告げ――人々は、ユダの王たちの骨、首長たちの骨、祭司たちの骨、預言者たちの骨、エルサレムの住民の骨を、彼らの墓からあばき、","tok":[["その"],["時","とき"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["人々","ひとびと"],["は"],["、"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["骨","ほね"],["、"],["首長","しゅちょう"],["たち"],["の"],["骨","ほね"],["、"],["祭司","さいし"],["たち"],["の"],["骨","ほね"],["、"],["預言者","よげんしゃ"],["たち"],["の"],["骨","ほね"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["の"],["骨","ほね"],["を"],["、"],["彼","かれ"],["ら"],["の"],["墓","はか"],["から"],["あばき"],["、"]]},{"verse":2,"text":"それらを、彼らが愛し、仕え、従い、伺いを立て、拝んだ日や月や天の万象の前にさらす。それらは集められることなく、葬られることもなく、地面の肥やしとなる。","tok":[["それ"],["ら"],["を"],["、"],["彼","かれ"],["ら"],["が"],["愛し","あいし"],["、"],["仕え","つかえ"],["、"],["従い","したがい"],["、"],["伺い","うかがい"],["を"],["立て","たて"],["、"],["拝んだ","おがんだ"],["日","ひ"],["や"],["月","つき"],["や"],["天","てん"],["の"],["万象","ばんしょう"],["の"],["前","まえ"],["に"],["さらす"],["。"],["それ"],["ら"],["は"],["集められる","あつめられる"],["こと"],["なく"],["、"],["葬られる","ほうむられる"],["こと"],["も"],["なく"],["、"],["地面","じめん"],["の"],["肥やし","こやし"],["と"],["なる"],["。"]]},{"verse":3,"text":"また、この悪い一族の中から残された残りの者はみな、わたしが追い散らした残りの者のいるどんな所でも、いのちよりも死を選ぶようになる。――万軍の主の御告げ――」","tok":[["また"],["、"],["この"],["悪い","わるい"],["一族","いちぞく"],["の"],["中","なか"],["から"],["残された","のこされた"],["残り","のこり"],["の"],["者","もの"],["は"],["みな"],["、"],["わたし"],["が"],["追い散らした","おいちらした"],["残り","のこり"],["の"],["者","もの"],["の"],["いる"],["どんな"],["所","ところ"],["で"],["も"],["、"],["いのち"],["より"],["も"],["死","し"],["を"],["選ぶ","えらぶ"],["よう"],["に"],["なる"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":4,"text":"あなたは、彼らに言え。／主はこう仰せられる。／「倒れたら、起き上がらないのだろうか。／背信者となったら、悔い改めないのだろうか。","tok":[["あなた"],["は"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["／"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["倒れたら","たおれたら"],["、"],["起き上がらない","おきあがらない"],["の"],["だろう"],["か"],["。"],["／"],["背信者","はいしんしゃ"],["と"],["なったら"],["、"],["悔い改めない","くいあらためない"],["の"],["だろう"],["か"],["。"]]},{"verse":5,"text":"なぜ、この民エルサレムは、背信者となり、背信を続けているのか。／彼らは欺きにすがりつき、帰って来ようとしない。","tok":[["なぜ"],["、"],["この"],["民","みん"],["エルサレム"],["は"],["、"],["背信者","はいしんしゃ"],["と"],["なり"],["、"],["背信","はいしん"],["を"],["続けて","つづけて"],["いる"],["の"],["か"],["。"],["／"],["彼","かれ"],["ら"],["は"],["欺き","あざむき"],["に"],["すがりつき"],["、"],["帰って","かえって"],["来よう","こよう"],["と"],["しない"],["。"]]},{"verse":6,"text":"わたしは注意して聞いたが、彼らは正しくないことを語り、『私はなんということをしたのか』と言って、自分の悪行を悔いる者は、ひとりもいない。／彼らはみな、戦いに突入する馬のように、自分の走路に走り去る。","tok":[["わたし"],["は"],["注意","ちゅうい"],["して"],["聞いた","きいた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["正しく","ただしく"],["ない"],["こと"],["を"],["語り","かたり"],["、"],["『"],["私","わたくし"],["は"],["なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["か"],["』"],["と"],["言って","いって"],["、"],["自分","じぶん"],["の"],["悪行","あくぎょう"],["を"],["悔いる","くいる"],["者","もの"],["は"],["、"],["ひとり"],["も"],["いない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["戦い","たたかい"],["に"],["突入","とつにゅう"],["する"],["馬","うま"],["の"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["走路","そうろ"],["に"],["走り去る","はしりさる"],["。"]]},{"verse":7,"text":"空のこうのとりも、自分の季節を知っており、山鳩、つばめ、つるも、自分の帰る時を守るのに、わたしの民は主の定めを知らない。","tok":[["空","そら"],["の"],["こうのとり"],["も"],["、"],["自分","じぶん"],["の"],["季節","きせつ"],["を"],["知って","しって"],["おり"],["、"],["山鳩","やまばと"],["、"],["つばめ"],["、"],["つる"],["も"],["、"],["自分","じぶん"],["の"],["帰る","かえる"],["時","とき"],["を"],["守る","まもる"],["のに"],["、"],["わたし"],["の"],["民","たみ"],["は"],["主","ぬし"],["の"],["定め","さだめ"],["を"],["知らない","しらない"],["。"]]},{"verse":8,"text":"どうして、あなたがたは、『私たちは知恵ある者だ。／私たちには主の律法がある』と言えようか。／確かにそうだが、書記たちの偽りの筆が、これを偽りにしてしまっている。","tok":[["どう"],["して"],["、"],["あなた"],["がた"],["は"],["、"],["『"],["私たち","わたしたち"],["は"],["知恵","ちえ"],["ある"],["者","もの"],["だ"],["。"],["／"],["私たち","わたしたち"],["に"],["は"],["主","ぬし"],["の"],["律法","りっぽう"],["が"],["ある"],["』"],["と"],["言えよう","いえよう"],["か"],["。"],["／"],["確か","たしか"],["に"],["そう"],["だ"],["が"],["、"],["書記","しょき"],["たち"],["の"],["偽り","いつわり"],["の"],["筆","ふで"],["が"],["、"],["これ"],["を"],["偽り","いつわり"],["に"],["して"],["しまって"],["いる"],["。"]]},{"verse":9,"text":"知恵ある者たちは恥を見、驚きあわてて、捕らえられる。／見よ。主のことばを退けたからには、彼らに何の知恵があろう。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["たち"],["は"],["恥","はじ"],["を"],["見","み"],["、"],["驚きあわてて","おどろきあわてて"],["、"],["捕らえられる","とらえられる"],["。"],["／"],["見","み"],["よ"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["退けた","しりぞけた"],["から"],["に"],["は"],["、"],["彼","かれ"],["ら"],["に"],["何","なん"],["の"],["知恵","ちえ"],["が"],["あろう"],["。"]]},{"verse":10,"text":"それゆえ、わたしは彼らの妻を他人に与え、彼らの畑を侵略者に与える。／なぜなら、身分の低い者から高い者まで、みな利得をむさぼり、預言者から祭司に至るまで、みな偽りを行っているからだ。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["妻","つま"],["を"],["他人","たにん"],["に"],["与え","あたえ"],["、"],["彼","かれ"],["ら"],["の"],["畑","はたけ"],["を"],["侵略者","しんりゃくしゃ"],["に"],["与える","あたえる"],["。"],["／"],["なぜ"],["なら"],["、"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["から"],["高い","たかい"],["者","もの"],["まで"],["、"],["みな"],["利得","りとく"],["を"],["むさぼり"],["、"],["預言者","よげんしゃ"],["から"],["祭司","さいし"],["に"],["至る","いたる"],["まで"],["、"],["みな"],["偽り","いつわり"],["を"],["行って","おこなって"],["いる"],["から"],["だ"],["。"]]},{"verse":11,"text":"彼らは、わたしの民の娘の傷を手軽にいやし、平安がないのに、『平安だ、平安だ』と言っている。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["民","たみ"],["の"],["娘","むすめ"],["の"],["傷","きず"],["を"],["手軽","てがる"],["に"],["いやし"],["、"],["平安","へいあん"],["が"],["ない"],["のに"],["、"],["『"],["平安","へいあん"],["だ"],["、"],["平安","へいあん"],["だ"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":12,"text":"彼らは忌みきらうべきことをして、恥を見ただろうか。／彼らは少しも恥じず、恥じることも知らない。／だから、彼らは、倒れる者の中に倒れ、彼らの刑罰の時、よろめき倒れる」と／主は仰せられる。","tok":[["彼","かれ"],["ら"],["は"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["して"],["、"],["恥","はじ"],["を"],["見ただろう","みただろう"],["か"],["。"],["／"],["彼","かれ"],["ら"],["は"],["少し","すこし"],["も"],["恥じず","はじず"],["、"],["恥じる","はじる"],["こと"],["も"],["知らない","しらない"],["。"],["／"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["、"],["倒れる","たおれる"],["者","もの"],["の"],["中","なか"],["に"],["倒れ","たおれ"],["、"],["彼","かれ"],["ら"],["の"],["刑罰","けいばつ"],["の"],["時","とき"],["、"],["よろめき"],["倒れる","たおれる"],["」"],["と"],["／"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":13,"text":"「わたしは彼らを、刈り入れたい。／――主の御告げ――／しかし、ぶどうの木には、ぶどうがなく、いちじくの木には、いちじくがなく、葉はしおれている。／わたしはそれをなるがままにする。」","tok":[["「"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["刈り入れたい","かりいれたい"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["しかし"],["、"],["ぶどう"],["の"],["木","き"],["に"],["は"],["、"],["ぶどう"],["が"],["なく"],["、"],["いちじく"],["の"],["木","き"],["に"],["は"],["、"],["いちじく"],["が"],["なく"],["、"],["葉","は"],["は"],["しおれて"],["いる"],["。"],["／"],["わたし"],["は"],["それ"],["を"],["なる"],["が"],["まま"],["に"],["する"],["。"],["」"]]},{"verse":14,"text":"どうして、私たちはすわっているのか。／集まって、城壁のある町々に行き、そこで死のう。／私たちの神、主が、私たちを滅ぼす。／主が私たちに毒の水を飲ませられる。／私たちが主に罪を犯したからだ。","tok":[["どう"],["して"],["、"],["私たち","わたしたち"],["は"],["すわって"],["いる"],["の"],["か"],["。"],["／"],["集まって","あつまって"],["、"],["城壁","じょうへき"],["の"],["ある"],["町々","まちまち"],["に"],["行き","いき"],["、"],["そこ"],["で"],["死のう","しのう"],["。"],["／"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["私たち","わたしたち"],["を"],["滅ぼす","ほろぼす"],["。"],["／"],["主","ぬし"],["が"],["私たち","わたしたち"],["に"],["毒","どく"],["の"],["水","みず"],["を"],["飲ませられる","のませられる"],["。"],["／"],["私たち","わたしたち"],["が"],["主に","おもに"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["だ"],["。"]]},{"verse":15,"text":"平安を待ち望んでも、幸いはなく、いやしの時を待ち望んでも、見よ、恐怖しかない。","tok":[["平安","へいあん"],["を"],["待ち望んで","まちのぞんで"],["も"],["、"],["幸い","さいわい"],["は"],["なく"],["、"],["いやし"],["の"],["時","とき"],["を"],["待ち望んで","まちのぞんで"],["も"],["、"],["見よ","みよ"],["、"],["恐怖","きょうふ"],["しか"],["ない"],["。"]]},{"verse":16,"text":"「ダンから馬の鼻息が聞こえる。／その荒馬のいななきの声に、全地は震える。／彼らは来て、地と、それに満ちるもの、町と、その住民を食らう。","tok":[["「"],["ダン"],["から"],["馬","うま"],["の"],["鼻息","はないき"],["が"],["聞こえる","きこえる"],["。"],["／"],["その"],["荒馬","あらうま"],["の"],["いななき"],["の"],["声","こえ"],["に"],["、"],["全地","ぜんち"],["は"],["震える","ふるえる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["地","ち"],["と"],["、"],["それ"],["に"],["満ちる","みちる"],["もの"],["、"],["町","まち"],["と"],["、"],["その"],["住民","じゅうみん"],["を"],["食らう","くらう"],["。"]]},{"verse":17,"text":"見よ。わたしが、まじないのきかないコブラや、まむしを、あなたがたの中に送り、あなたがたをかませるからだ。／――主の御告げ――」","tok":[["見","み"],["よ"],["。"],["わたし"],["が"],["、"],["まじない"],["の"],["きかない"],["コブラ"],["や"],["、"],["まむし"],["を"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["送り","おくり"],["、"],["あなた"],["がた"],["を"],["かませる"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":18,"text":"私の悲しみはいやされず、私の心は弱り果てている。","tok":[["私","わたくし"],["の"],["悲しみ","かなしみ"],["は"],["いやされず"],["、"],["私","わたくし"],["の"],["心","こころ"],["は"],["弱り","よわり"],["果てて","はてて"],["いる"],["。"]]},{"verse":19,"text":"聞け。遠くの地からの／私の民の娘の叫び声を。「主はシオンにおられないのか。シオンの王は、その中におられないのか。」「なぜ、彼らは自分たちの刻んだ像により、外国のむなしいものによって、わたしの怒りを引き起こしたのか。」","tok":[["聞け","きけ"],["。"],["遠く","とおく"],["の"],["地","ち"],["から"],["の"],["／"],["私","わたくし"],["の"],["民","たみ"],["の"],["娘","むすめ"],["の"],["叫び声","さけびごえ"],["を"],["。"],["「"],["主","ぬし"],["は"],["シオン"],["に"],["おられない"],["の"],["か"],["。"],["シオン"],["の"],["王","おう"],["は"],["、"],["その"],["中","なか"],["に"],["おられない"],["の"],["か"],["。"],["」"],["「"],["なぜ"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["刻んだ","きざんだ"],["像","ぞう"],["に"],["より"],["、"],["外国","がいこく"],["の"],["むなしい"],["もの"],["によって"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こした","ひきおこした"],["の"],["か"],["。"],["」"]]},{"verse":20,"text":"「刈り入れ時は過ぎ、夏も終わった。／それなのに、私たちは救われない。」","tok":[["「"],["刈り入れ","かりいれ"],["時","とき"],["は"],["過ぎ","すぎ"],["、"],["夏","なつ"],["も"],["終わった","おわった"],["。"],["／"],["それ"],["な"],["のに"],["、"],["私たち","わたしたち"],["は"],["救われない","すくわれない"],["。"],["」"]]},{"verse":21,"text":"私の民の娘の傷のために、私も傷つき、私は憂え、恐怖が、私を捕らえた。","tok":[["私","わたくし"],["の"],["民","たみ"],["の"],["娘","むすめ"],["の"],["傷","きず"],["の"],["ため"],["に"],["、"],["私","わたくし"],["も"],["傷つき","きずつき"],["、"],["私","わたくし"],["は"],["憂え","うれえ"],["、"],["恐怖","きょうふ"],["が"],["、"],["私","わたくし"],["を"],["捕らえた","とらえた"],["。"]]},{"verse":22,"text":"乳香はギルアデにないのか。／医者はそこにいないのか。／それなのに、なぜ、私の民の娘の傷はいやされなかったのか。","tok":[["乳香","にゅうこう"],["は"],["ギルアデ"],["に"],["ない"],["の"],["か"],["。"],["／"],["医者","いしゃ"],["は"],["そこ"],["に"],["いない"],["の"],["か"],["。"],["／"],["それ"],["な"],["のに"],["、"],["なぜ"],["、"],["私","わたくし"],["の"],["民","たみ"],["の"],["娘","むすめ"],["の"],["傷","きず"],["は"],["いやされなかった"],["の"],["か"],["。"]]}]
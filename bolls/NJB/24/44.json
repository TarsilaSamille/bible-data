[{"verse":1,"text":"エジプトの国に住むすべてのユダヤ人、すなわちミグドル、タフパヌヘス、ノフ、およびパテロス地方に住む者たちについて、エレミヤにあったみことばは、次のとおりである。","tok":[["エジプト"],["の"],["国","くに"],["に"],["住む","すむ"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["、"],["すなわち"],["ミグドル"],["、"],["タフパヌヘス"],["、"],["ノフ"],["、"],["および"],["パテロス"],["地方","ちほう"],["に"],["住む","すむ"],["者","もの"],["たち"],["について"],["、"],["エレミヤ"],["に"],["あった"],["みことば"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"「イスラエルの神、万軍の主は、こう仰せられる。『あなたがたは、わたしがエルサレムとユダのすべての町に下したあのすべてのわざわいを見た。見よ。それらはきょう、廃墟となって、そこに住む者もない。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["エルサレム"],["と"],["ユダ"],["の"],["すべて"],["の"],["町","まち"],["に"],["下した","くだした"],["あの"],["すべて"],["の"],["わざわい"],["を"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["それ"],["ら"],["は"],["きょう"],["、"],["廃墟","はいきょ"],["と"],["なって"],["、"],["そこ"],["に"],["住む","すむ"],["者","もの"],["も"],["ない"],["。"]]},{"verse":3,"text":"それは、彼らが悪を行ってわたしの怒りを引き起こし、彼ら自身も、あなたがたも先祖も知らなかったほかの神々のところに行き、香をたいて仕えたためだ。","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["悪","あく"],["を"],["行って","おこなって"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こし","ひきおこし"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["も"],["、"],["あなた"],["がた"],["も"],["先祖","せんぞ"],["も"],["知らなかった","しらなかった"],["ほか"],["の"],["神々","かみがみ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["香","こう"],["を"],["たいて"],["仕えた","つかえた"],["ため"],["だ"],["。"]]},{"verse":4,"text":"それでわたしはあなたがたに、わたしのしもべであるすべての預言者たちを早くからたびたび送り、どうか、わたしの憎むこの忌みきらうべきことを行わないように、と言ったのに、","tok":[["それ"],["で"],["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["わたし"],["の"],["しもべ"],["で"],["ある"],["すべて"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["早く","はやく"],["から"],["たびたび"],["送り","おくり"],["、"],["どう"],["か"],["、"],["わたし"],["の"],["憎む","にくむ"],["この"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["行わない","おこなわない"],["よう"],["に"],["、"],["と"],["言った","いった"],["のに"],["、"]]},{"verse":5,"text":"彼らは聞かず、耳も傾けず、ほかの神々に香をたいて、その悪から立ち返らなかった。","tok":[["彼","かれ"],["ら"],["は"],["聞かず","きかず"],["、"],["耳","みみ"],["も"],["傾けず","かたむけず"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たいて"],["、"],["その"],["悪","あく"],["から"],["立ち返らなかった","たちかえらなかった"],["。"]]},{"verse":6,"text":"それで、わたしの憤りと怒りが、ユダの町々とエルサレムのちまたに注がれて燃え上がり、それらは今日のように廃墟となり荒れ果ててしまった。』","tok":[["それ"],["で"],["、"],["わたし"],["の"],["憤り","いきどおり"],["と"],["怒り","いかり"],["が"],["、"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["ちまた"],["に"],["注がれて","そそがれて"],["燃え上がり","もえあがり"],["、"],["それ"],["ら"],["は"],["今日","きょう"],["の"],["よう"],["に"],["廃墟","はいきょ"],["と"],["なり"],["荒れ果てて","あれはてて"],["しまった"],["。"],["』"]]},{"verse":7,"text":"それで今、イスラエルの神、万軍の神、主は、こう仰せられる。『あなたがたは自分自身に大きなわざわいを招こうとしているのか。なぜユダの中から男も女も、幼子も乳飲み子も断ち、残りの者を生かしておかないようにするのか。","tok":[["それ"],["で"],["今","いま"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["がた"],["は"],["自分","じぶん"],["自身","じしん"],["に"],["大きな","おおきな"],["わざわい"],["を"],["招こう","まねこう"],["として"],["いる"],["の"],["か"],["。"],["なぜ"],["ユダ"],["の"],["中","なか"],["から"],["男","おとこ"],["も"],["女","おんな"],["も"],["、"],["幼子","おさなご"],["も"],["乳飲み子","ちのみご"],["も"],["断ち","たち"],["、"],["残り","のこり"],["の"],["者","もの"],["を"],["生かして","いかして"],["おかない"],["よう"],["に"],["する"],["の"],["か"],["。"]]},{"verse":8,"text":"なぜ、あなたがたの手のわざによってわたしの怒りを引き起こし、寄留しに来たエジプトの国でも、ほかの神々に香をたき、あなたがた自身を断ち滅ぼし、地のすべての国の中で、ののしりとなり、そしりとなろうとするのか。","tok":[["なぜ"],["、"],["あなた"],["がた"],["の"],["手","て"],["の"],["わざ"],["によって"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こし","ひきおこし"],["、"],["寄留","きりゅう"],["し"],["に"],["来た","きた"],["エジプト"],["の"],["国","くに"],["で"],["も"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["、"],["あなた"],["がた"],["自身","じしん"],["を"],["断ち","たち"],["滅ぼし","ほろぼし"],["、"],["地","ち"],["の"],["すべて"],["の"],["国","くに"],["の"],["中","なか"],["で"],["、"],["ののしり"],["と"],["なり"],["、"],["そしり"],["と"],["なろう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":9,"text":"あなたがたは、ユダの国とエルサレムのちまたで行ったあなたがたの先祖の悪、ユダの王たちの悪、王妃たちの悪、あなたがたの悪、妻たちの悪を忘れたのか。","tok":[["あなた"],["がた"],["は"],["、"],["ユダ"],["の"],["国","くに"],["と"],["エルサレム"],["の"],["ちまた"],["で"],["行った","おこなった"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["悪","わる"],["、"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["悪","わる"],["、"],["王妃","おうひ"],["たち"],["の"],["悪","わる"],["、"],["あなた"],["がた"],["の"],["悪","わる"],["、"],["妻たち","つまたち"],["の"],["悪","あく"],["を"],["忘れた","わすれた"],["の"],["か"],["。"]]},{"verse":10,"text":"彼らは今日まで心砕かれず、恐れず、わたしがあなたがたとあなたがたの先祖の前に与えたわたしの律法と定めに歩まなかった。』","tok":[["彼","かれ"],["ら"],["は"],["今日","きょう"],["まで"],["心","こころ"],["砕かれず","くだかれず"],["、"],["恐れず","おそれず"],["、"],["わたし"],["が"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["前","まえ"],["に"],["与えた","あたえた"],["わたし"],["の"],["律法","りっぽう"],["と"],["定め","さだめ"],["に"],["歩まなかった","あゆまなかった"],["。"],["』"]]},{"verse":11,"text":"それゆえ、イスラエルの神、万軍の主は、こう仰せられる。『見よ。わたしは、わたしの顔をあなたがたからそむけて、わざわいを下し、ユダのすべての民を断ち滅ぼそう。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["わたし"],["の"],["顔","かお"],["を"],["あなた"],["がた"],["から"],["そむけて"],["、"],["わざわい"],["を"],["下し","くだし"],["、"],["ユダ"],["の"],["すべて"],["の"],["民","たみ"],["を"],["断ち","たち"],["滅ぼそう","ほろぼそう"],["。"]]},{"verse":12,"text":"わたしは、寄留しにエジプトの国へ行こうと決心したユダの残りの者を取り除く。彼らはみな、エジプトの国で、剣とききんに倒れて滅びる。身分の低い者も高い者もみな、剣とききんで死に、のろい、恐怖、ののしり、そしりとなる。","tok":[["わたし"],["は"],["、"],["寄留","きりゅう"],["し"],["に"],["エジプト"],["の"],["国","くに"],["へ"],["行こう","いこう"],["と"],["決心","けっしん"],["した"],["ユダ"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["取り除く","とりのぞく"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["エジプト"],["の"],["国","くに"],["で"],["、"],["剣","けん"],["と"],["ききん"],["に"],["倒れて","たおれて"],["滅びる","ほろびる"],["。"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["も"],["高い","たかい"],["者","もの"],["も"],["みな"],["、"],["剣","けん"],["と"],["ききん"],["で"],["死に","しに"],["、"],["のろい"],["、"],["恐怖","きょうふ"],["、"],["ののしり"],["、"],["そしり"],["と"],["なる"],["。"]]},{"verse":13,"text":"わたしは、エルサレムを罰したと同じように、エジプトの国に住んでいる者たちを、剣とききんと疫病で罰する。","tok":[["わたし"],["は"],["、"],["エルサレム"],["を"],["罰した","ばっした"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["エジプト"],["の"],["国","くに"],["に"],["住んで","すんで"],["いる"],["者","もの"],["たち"],["を"],["、"],["剣","けん"],["と"],["ききん"],["と"],["疫病","やくびょう"],["で"],["罰する","ばっする"],["。"]]},{"verse":14,"text":"エジプトの国に来てそこに寄留しているユダの残りの者のうち、のがれて生き残る者、帰って行って住みたいと願っているユダの地へ帰れる者はいない。ただのがれる者だけが帰れよう。』」","tok":[["エジプト"],["の"],["国","くに"],["に"],["来て","きて"],["そこ"],["に"],["寄留","きりゅう"],["して"],["いる"],["ユダ"],["の"],["残り","のこり"],["の"],["者","もの"],["の"],["うち"],["、"],["のがれて"],["生き残る","いきのこる"],["者","もの"],["、"],["帰って","かえって"],["行って","いって"],["住みたい","すみたい"],["と"],["願って","ねがって"],["いる"],["ユダ"],["の"],["地","ち"],["へ"],["帰れる","かえれる"],["者","もの"],["は"],["いない"],["。"],["ただ"],["のがれる"],["者","もの"],["だけ"],["が"],["帰れよう","かえれよう"],["。"],["』"],["」"]]},{"verse":15,"text":"すると、自分たちの妻がほかの神々に香をたいていることを知っているすべての男たちと、大集団をなしてそばに立っているすべての女たち、すなわち、エジプトの国とパテロスに住むすべての民は、エレミヤに答えて言った。","tok":[["する"],["と"],["、"],["自分","じぶん"],["たち"],["の"],["妻","つま"],["が"],["ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たいて"],["いる"],["こと"],["を"],["知って","しって"],["いる"],["すべて"],["の"],["男","おとこ"],["たち"],["と"],["、"],["大","だい"],["集団","しゅうだん"],["を"],["なして"],["そば"],["に"],["立って","たって"],["いる"],["すべて"],["の"],["女","おんな"],["たち"],["、"],["すなわち"],["、"],["エジプト"],["の"],["国","くに"],["と"],["パテロス"],["に"],["住む","すむ"],["すべて"],["の"],["民","たみ"],["は"],["、"],["エレミヤ"],["に"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":16,"text":"「あなたが主の御名によって私たちに語ったことばに、私たちは従うわけにはいかない。","tok":[["「"],["あなた"],["が"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["私たち","わたしたち"],["に"],["語った","かたった"],["ことば"],["に"],["、"],["私たち","わたしたち"],["は"],["従う","したがう"],["わけ"],["に"],["は"],["いかない"],["。"]]},{"verse":17,"text":"私たちは、私たちの口から出たことばをみな必ず行って、私たちも、先祖たちも、私たちの王たちも、首長たちも、ユダの町々やエルサレムのちまたで行っていたように、天の女王にいけにえをささげ、それに注ぎのぶどう酒を注ぎたい。私たちはその時、パンに飽き足り、しあわせでわざわいに会わなかったから。","tok":[["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["の"],["口","くち"],["から"],["出た","でた"],["ことば"],["を"],["みな"],["必ず","かならず"],["行って","いって"],["、"],["私たち","わたしたち"],["も"],["、"],["先祖","せんぞ"],["たち"],["も"],["、"],["私たち","わたしたち"],["の"],["王","おう"],["たち"],["も"],["、"],["首長","しゅちょう"],["たち"],["も"],["、"],["ユダ"],["の"],["町々","まちまち"],["や"],["エルサレム"],["の"],["ちまた"],["で"],["行って","いって"],["いた"],["よう"],["に"],["、"],["天","てん"],["の"],["女王","じょおう"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["それ"],["に"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注ぎたい","そそぎたい"],["。"],["私たち","わたしたち"],["は"],["その"],["時","とき"],["、"],["パン"],["に"],["飽き足り","あきたり"],["、"],["しあわせ"],["で"],["わざわい"],["に"],["会わなかった","あわなかった"],["から"],["。"]]},{"verse":18,"text":"私たちが天の女王にいけにえをささげ、それに注ぎのぶどう酒を注ぐのをやめた時から、私たちは万事に不足し、剣とききんに滅ぼされた。」","tok":[["私たち","わたしたち"],["が"],["天","てん"],["の"],["女王","じょおう"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["それ"],["に"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注ぐ","そそぐ"],["の"],["を"],["やめた"],["時","とき"],["から"],["、"],["私たち","わたしたち"],["は"],["万事","ばんじ"],["に"],["不足","ふそく"],["し"],["、"],["剣","けん"],["と"],["ききん"],["に"],["滅ぼされた","ほろぼされた"],["。"],["」"]]},{"verse":19,"text":"「私たち女が、天の女王にいけにえをささげ、それに注ぎのぶどう酒を注ぐとき、女王にかたどった供えのパン菓子を作り、注ぎのぶどう酒を注いだのは、私たちの夫と相談せずにしたことでしょうか。」","tok":[["「"],["私たち","わたしたち"],["女","おんな"],["が"],["、"],["天","てん"],["の"],["女王","じょおう"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["それ"],["に"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注ぐ","そそぐ"],["とき"],["、"],["女王","じょおう"],["に"],["かたどった"],["供え","そなえ"],["の"],["パン"],["菓子","かし"],["を"],["作り","つくり"],["、"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注いだ","そそいだ"],["の"],["は"],["、"],["私たち","わたしたち"],["の"],["夫","おっと"],["と"],["相談","そうだん"],["せず"],["に"],["した"],["こと"],["でしょう"],["か"],["。"],["」"]]},{"verse":20,"text":"そこでエレミヤは、男女のすべての民と、彼に口答えしたすべての民に語って言った。","tok":[["そこ"],["で"],["エレミヤ"],["は"],["、"],["男女","だんじょ"],["の"],["すべて"],["の"],["民","たみ"],["と"],["、"],["彼","かれ"],["に"],["口答え","くちごたえ"],["した"],["すべて"],["の"],["民","たみ"],["に"],["語って","かたって"],["言った","いった"],["。"]]},{"verse":21,"text":"「ユダの町々やエルサレムのちまたで、あなたがたや、あなたがたの先祖や、王たちや、首長たち、それに一般の人々がいけにえをささげたことを主は覚え、心に思い浮かべられたのではないか。","tok":[["「"],["ユダ"],["の"],["町々","まちまち"],["や"],["エルサレム"],["の"],["ちまた"],["で"],["、"],["あなた"],["がた"],["や"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["や"],["、"],["王","おう"],["たち"],["や"],["、"],["首長","しゅちょう"],["たち"],["、"],["それ"],["に"],["一般","いっぱん"],["の"],["人々","ひとびと"],["が"],["いけにえ"],["を"],["ささげた"],["こと"],["を"],["主","ぬし"],["は"],["覚え","おぼえ"],["、"],["心","こころ"],["に"],["思い浮かべられた","おもいうかべられた"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":22,"text":"主は、あなたがたの悪い行い、あなたがたが行ったあの忌みきらうべきことのために、もう耐えられず、それであなたがたの国は今日のように、住む者もなく、廃墟となり、恐怖、ののしりとなった。","tok":[["主","ぬし"],["は"],["、"],["あなた"],["がた"],["の"],["悪い","わるい"],["行い","おこない"],["、"],["あなた"],["がた"],["が"],["行った","おこなった"],["あの"],["忌みきらうべき","いみきらうべき"],["こと"],["の"],["ため"],["に"],["、"],["もう"],["耐えられず","たえられず"],["、"],["それ"],["で"],["あなた"],["がた"],["の"],["国","くに"],["は"],["今日","きょう"],["の"],["よう"],["に"],["、"],["住む","すむ"],["者","もの"],["も"],["なく"],["、"],["廃墟","はいきょ"],["と"],["なり"],["、"],["恐怖","きょうふ"],["、"],["ののしり"],["と"],["なった"],["。"]]},{"verse":23,"text":"あなたがたがいけにえをささげ、主に罪を犯して、主の御声に聞き従わず、主の律法と定めとあかしに歩まなかったために、あなたがたに、このわざわいが今日のように来たのだ。」","tok":[["あなた"],["がた"],["が"],["いけにえ"],["を"],["ささげ"],["、"],["主に","おもに"],["罪","つみ"],["を"],["犯して","おかして"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["主","ぬし"],["の"],["律法","りっぽう"],["と"],["定め","さだめ"],["と"],["あかし"],["に"],["歩まなかった","あゆまなかった"],["ため"],["に"],["、"],["あなた"],["がた"],["に"],["、"],["この"],["わざわい"],["が"],["今日","きょう"],["の"],["よう"],["に"],["来た","きた"],["の"],["だ"],["。"],["」"]]},{"verse":24,"text":"ついで、エレミヤは、すべての民、すべての女に言った。「エジプトの国にいるすべてのユダの人々よ。主のことばを聞け。","tok":[["つい"],["で"],["、"],["エレミヤ"],["は"],["、"],["すべて"],["の"],["民","たみ"],["、"],["すべて"],["の"],["女","おんな"],["に"],["言った","いった"],["。"],["「"],["エジプト"],["の"],["国","くに"],["に"],["いる"],["すべて"],["の"],["ユダ"],["の"],["人々","ひとびと"],["よ"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":25,"text":"イスラエルの神、万軍の主は、こう仰せられる。『あなたがたとあなたがたの妻は、自分たちの口で約束したことをその手で果たせ。あなたがたは、私たちは天の女王にいけにえをささげ、それに注ぎのぶどう酒を注ごうと誓った誓願を、必ず実行すると言っている。では、あなたがたの誓願を確かに果たし、あなたがたの誓願を必ず実行せよ。』","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["妻","つま"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["口","くち"],["で"],["約束","やくそく"],["した"],["こと"],["を"],["その"],["手","て"],["で"],["果たせ","はたせ"],["。"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["は"],["天","てん"],["の"],["女王","じょおう"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["それ"],["に"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注ごう","そそごう"],["と"],["誓った","ちかった"],["誓願","せいがん"],["を"],["、"],["必ず","かならず"],["実行","じっこう"],["する"],["と"],["言って","いって"],["いる"],["。"],["で"],["は"],["、"],["あなた"],["がた"],["の"],["誓願","せいがん"],["を"],["確か","たしか"],["に"],["果たし","はたし"],["、"],["あなた"],["がた"],["の"],["誓願","せいがん"],["を"],["必ず","かならず"],["実行","じっこう"],["せよ"],["。"],["』"]]},{"verse":26,"text":"それゆえ、エジプトの国に住むすべてのユダの人々。主のことばを聞け。『見よ。わたしはわたしの偉大な名によって誓う。――主は仰せられる――エジプトの全土において、神である主は生きておられると言って、わたしの名がユダヤ人の口にとなえられることはもうなくなる。","tok":[["それ"],["ゆえ"],["、"],["エジプト"],["の"],["国","くに"],["に"],["住む","すむ"],["すべて"],["の"],["ユダ"],["の"],["人々","ひとびと"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["わたし"],["の"],["偉大","いだい"],["な"],["名","な"],["によって"],["誓う","ちかう"],["。"],["―"],["―"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"],["エジプト"],["の"],["全土","ぜんど"],["に"],["おいて"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["と"],["言って","いって"],["、"],["わたし"],["の"],["名","な"],["が"],["ユダヤ人","ゆだやじん"],["の"],["口","くち"],["に"],["となえられる"],["こと"],["は"],["もう"],["なくなる"],["。"]]},{"verse":27,"text":"見よ。わたしは彼らを見張っている。わざわいのためであって、幸いのためではない。エジプトの国にいるすべてのユダヤ人は、剣とききんによって、ついには滅び絶える。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["見張って","みはって"],["いる"],["。"],["わざわい"],["の"],["ため"],["で"],["あって"],["、"],["幸い","さいわい"],["の"],["ため"],["で"],["は"],["ない"],["。"],["エジプト"],["の"],["国","くに"],["に"],["いる"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["は"],["、"],["剣","けん"],["と"],["ききん"],["によって"],["、"],["ついに"],["は"],["滅び","ほろび"],["絶える","たえる"],["。"]]},{"verse":28,"text":"剣をのがれる少数の者だけが、エジプトの国からユダの国に帰る。こうして、エジプトの国に来て寄留しているユダの残りの者たちはみな、わたしのと彼らのと、どちらのことばが成就するかを知る。","tok":[["剣","けん"],["を"],["のがれる"],["少数","しょうすう"],["の"],["者","もの"],["だけ"],["が"],["、"],["エジプト"],["の"],["国","くに"],["から"],["ユダ"],["の"],["国","くに"],["に"],["帰る","かえる"],["。"],["こう"],["して"],["、"],["エジプト"],["の"],["国","くに"],["に"],["来て","きて"],["寄留","きりゅう"],["して"],["いる"],["ユダ"],["の"],["残り","のこり"],["の"],["者","もの"],["たち"],["は"],["みな"],["、"],["わたし"],["の"],["と"],["彼","かれ"],["ら"],["の"],["と"],["、"],["どちら"],["の"],["ことば"],["が"],["成就","じょうじゅ"],["する"],["か"],["を"],["知る","しる"],["。"]]},{"verse":29,"text":"これがあなたがたへのしるしである。――主の御告げ――わたしはこの所であなたがたを罰する。それは、あなたがたにわざわいを下すというわたしのことばは必ず成就することをあなたがたが知るためである。』","tok":[["これ"],["が"],["あなた"],["が"],["たへ"],["の"],["しるし"],["で"],["ある"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["は"],["この"],["所","ところ"],["で"],["あなた"],["がた"],["を"],["罰する","ばっする"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["に"],["わざわい"],["を"],["下す","くだす"],["と"],["いう"],["わたし"],["の"],["ことば"],["は"],["必ず","かならず"],["成就","じょうじゅ"],["する"],["こと"],["を"],["あなた"],["がた"],["が"],["知る","しる"],["ため"],["で"],["ある"],["。"],["』"]]},{"verse":30,"text":"主はこう仰せられる。『見よ。わたしは、ユダの王ゼデキヤを、そのいのちをねらっていた彼の敵、バビロンの王ネブカデレザルの手に渡したように、エジプトの王パロ・ホフラをその敵の手、そのいのちをねらう者たちの手に渡す。』」","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["を"],["、"],["その"],["いのち"],["を"],["ねらって"],["いた"],["彼","かれ"],["の"],["敵","てき"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["手","て"],["に"],["渡した","わたした"],["よう"],["に"],["、"],["エジプト"],["の"],["王","おう"],["パロ"],["・"],["ホフラ"],["を"],["その"],["敵","てき"],["の"],["手","て"],["、"],["その"],["いのち"],["を"],["ねらう"],["者","もの"],["たち"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["』"],["」"]]}]
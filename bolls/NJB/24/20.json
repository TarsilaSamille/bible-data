[{"verse":1,"text":"祭司であり、主の宮のつかさ、監督者であるイメルの子パシュフルは、エレミヤがこれらのことばを預言するのを聞いた。","tok":[["祭司","さいし"],["で"],["あり"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["つかさ"],["、"],["監督者","かんとくしゃ"],["で"],["ある"],["イメル"],["の"],["子","こ"],["パシュフル"],["は"],["、"],["エレミヤ"],["が"],["これ"],["ら"],["の"],["ことば"],["を"],["預言","よげん"],["する"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"パシュフルは、預言者エレミヤを打ち、彼を主の宮にある上のベニヤミンの門にある足かせにつないだ。","tok":[["パシュフル"],["は"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["を"],["打ち","うち"],["、"],["彼","かれ"],["を"],["主","ぬし"],["の"],["宮","みや"],["に"],["ある"],["上","うえ"],["の"],["ベニヤミン"],["の"],["門","もん"],["に"],["ある"],["足かせ","あしかせ"],["に"],["つないだ"],["。"]]},{"verse":3,"text":"翌日になって、パシュフルがエレミヤを足かせから解いたとき、エレミヤは彼に言った。「主はあなたの名をパシュフルではなくて、『恐れが回りにある』と呼ばれる。","tok":[["翌日","よくじつ"],["に"],["なって"],["、"],["パシュフル"],["が"],["エレミヤ"],["を"],["足かせ","あしかせ"],["から"],["解いた","といた"],["とき"],["、"],["エレミヤ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["あなた"],["の"],["名","な"],["を"],["パシュフル"],["で"],["は"],["なくて"],["、"],["『"],["恐れ","おそれ"],["が"],["回り","まわり"],["に"],["ある"],["』"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":4,"text":"まことに主がこう仰せられる。『見よ。わたしはあなたを、あなた自身とあなたの愛するすべての者への恐れとする。彼らは、あなたの目の見る所で、敵の剣に倒れる。また、わたしはユダの人全部をバビロンの王の手に渡す。彼は彼らをバビロンへ引いて行き、剣で打ち殺す。","tok":[["まこと"],["に"],["主","ぬし"],["が"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["、"],["あなた"],["自身","じしん"],["と"],["あなた"],["の"],["愛する","あいする"],["すべて"],["の"],["者","もの"],["へ"],["の"],["恐れ","おそれ"],["と"],["する"],["。"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["目","め"],["の"],["見る","みる"],["所","ところ"],["で"],["、"],["敵","てき"],["の"],["剣","けん"],["に"],["倒れる","たおれる"],["。"],["また"],["、"],["わたし"],["は"],["ユダ"],["の"],["人","ひと"],["全部","ぜんぶ"],["を"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["を"],["バビロン"],["へ"],["引いて","ひいて"],["行き","いき"],["、"],["剣","けん"],["で"],["打ち殺す","うちころす"],["。"]]},{"verse":5,"text":"また、わたしはこの町のすべての富と、すべての勤労の実と、すべての宝を渡し、またユダの王たちの財宝を敵の手に渡す。彼らはそれをかすめ奪い、略奪し、バビロンへ運ぶ。","tok":[["また"],["、"],["わたし"],["は"],["この"],["町","まち"],["の"],["すべて"],["の"],["富","とみ"],["と"],["、"],["すべて"],["の"],["勤労","きんろう"],["の"],["実","じつ"],["と"],["、"],["すべて"],["の"],["宝","たから"],["を"],["渡し","わたし"],["、"],["また"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["財宝","ざいほう"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["かすめ"],["奪い","うばい"],["、"],["略奪","りゃくだつ"],["し"],["、"],["バビロン"],["へ"],["運ぶ","はこぶ"],["。"]]},{"verse":6,"text":"パシュフルよ。あなたとあなたの家に住むすべての者は、とりことなって、バビロンに行き、そこで死に、そこで葬られる。あなたも、あなたが偽りの預言をした相手の、あなたの愛するすべての人も。』」","tok":[["パシュフル"],["よ"],["。"],["あなた"],["と"],["あなた"],["の"],["家","いえ"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["は"],["、"],["とりこ"],["と"],["なって"],["、"],["バビロン"],["に"],["行き","いき"],["、"],["そこ"],["で"],["死に","しに"],["、"],["そこ"],["で"],["葬られる","ほうむられる"],["。"],["あなた"],["も"],["、"],["あなた"],["が"],["偽り","いつわり"],["の"],["預言","よげん"],["を"],["した"],["相手","あいて"],["の"],["、"],["あなた"],["の"],["愛する","あいする"],["すべて"],["の"],["人","ひと"],["も"],["。"],["』"],["」"]]},{"verse":7,"text":"主よ。あなたが私を惑わしたので、私はあなたに惑わされました。／あなたは私をつかみ、私を思いのままにしました。／私は一日中、物笑いとなり、みなが私をあざけります。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["が"],["私","わたくし"],["を"],["惑わした","まどわした"],["ので"],["、"],["私","わたくし"],["は"],["あなた"],["に"],["惑わされました","まどわされました"],["。"],["／"],["あなた"],["は"],["私","わたくし"],["を"],["つかみ"],["、"],["私","わたくし"],["を"],["思い","おもい"],["の"],["まま"],["に"],["しました"],["。"],["／"],["私","わたくし"],["は"],["一","いち"],["日中","にちちゅう"],["、"],["物笑い","ものわらい"],["と"],["なり"],["、"],["みな"],["が"],["私","わたくし"],["を"],["あざけります"],["。"]]},{"verse":8,"text":"私は、語るごとに、わめき、「暴虐だ。暴行だ」と叫ばなければなりません。／私への主のみことばが、一日中、そしりとなり、笑いぐさとなるのです。","tok":[["私","わたくし"],["は"],["、"],["語る","かたる"],["ごと"],["に"],["、"],["わめき"],["、"],["「"],["暴虐","ぼうぎゃく"],["だ"],["。"],["暴行","ぼうこう"],["だ"],["」"],["と"],["叫ばなければ","さけばなければ"],["なりません"],["。"],["／"],["私","わたくし"],["へ"],["の"],["主","ぬし"],["のみ"],["ことば"],["が"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["そしり"],["と"],["なり"],["、"],["笑いぐさ","わらいぐさ"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":9,"text":"私は、「主のことばを宣べ伝えまい。／もう主の名で語るまい」と思いましたが、主のみことばは私の心のうちで、骨の中に閉じ込められて／燃えさかる火のようになり、私はうちにしまっておくのに／疲れて耐えられません。","tok":[["私","わたくし"],["は"],["、"],["「"],["主","ぬし"],["の"],["ことば"],["を"],["宣べ伝えまい","のべつたえまい"],["。"],["／"],["もう"],["主","ぬし"],["の"],["名","な"],["で"],["語るまい","かたるまい"],["」"],["と"],["思いました","おもいました"],["が"],["、"],["主","ぬし"],["のみ"],["ことば"],["は"],["私","わたくし"],["の"],["心","こころ"],["の"],["うち"],["で"],["、"],["骨","ほね"],["の"],["中","なか"],["に"],["閉じ込められて","とじこめられて"],["／"],["燃えさかる","もえさかる"],["火","ひ"],["の"],["よう"],["に"],["なり"],["、"],["私","わたくし"],["は"],["うち"],["に"],["しまって"],["おく"],["のに"],["／"],["疲れて","つかれて"],["耐えられません","たえられません"],["。"]]},{"verse":10,"text":"私が多くの人のささやきを聞いたからです。「恐れが回りにあるぞ。訴えよ。われわれもあいつを訴えよう。」私の親しい者もみな、私のつまずくのを待ちもうけています。／「たぶん、彼は惑わされるから、われわれが彼に勝って、復讐してやろう」と。","tok":[["私","わたくし"],["が"],["多く","おおく"],["の"],["人","ひと"],["の"],["ささやき"],["を"],["聞いた","きいた"],["から"],["です"],["。"],["「"],["恐れ","おそれ"],["が"],["回り","まわり"],["に"],["ある"],["ぞ"],["。"],["訴え","うったえ"],["よ"],["。"],["われわれ"],["も"],["あいつ"],["を"],["訴えよう","うったえよう"],["。"],["」"],["私","わたくし"],["の"],["親しい","したしい"],["者","もの"],["も"],["みな"],["、"],["私","わたくし"],["の"],["つまずく"],["の"],["を"],["待ちもうけて","まちもうけて"],["います"],["。"],["／"],["「"],["たぶん"],["、"],["彼","かれ"],["は"],["惑わされる","まどわされる"],["から"],["、"],["われわれ"],["が"],["彼","かれ"],["に"],["勝って","かって"],["、"],["復讐","ふくしゅう"],["して"],["やろう"],["」"],["と"],["。"]]},{"verse":11,"text":"しかし、主は私とともにあって、横暴な勇士のようです。／ですから、私を追う者たちは、つまずいて、勝つことはできません。／彼らは成功しないので、大いに恥をかき、それが忘れられない永久の恥となりましょう。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["私","わたくし"],["と"],["とも"],["に"],["あって"],["、"],["横暴","おうぼう"],["な"],["勇士","ゆうし"],["の"],["よう"],["です"],["。"],["／"],["です"],["から"],["、"],["私","わたくし"],["を"],["追う","おう"],["者","もの"],["たち"],["は"],["、"],["つまずいて"],["、"],["勝つ","かつ"],["こと"],["は"],["できません"],["。"],["／"],["彼","かれ"],["ら"],["は"],["成功","せいこう"],["しない"],["ので"],["、"],["大いに","おおいに"],["恥","はじ"],["を"],["かき"],["、"],["それ"],["が"],["忘れられない","わすれられない"],["永久","えいきゅう"],["の"],["恥","はじ"],["と"],["なりましょう"],["。"]]},{"verse":12,"text":"正しい者を調べ、思いと心を見ておられる万軍の主よ。／あなたが彼らに復讐されるのを／私に見せてください。／あなたに私の訴えを打ち明けたのですから。","tok":[["正しい","ただしい"],["者","もの"],["を"],["調べ","しらべ"],["、"],["思い","おもい"],["と"],["心","こころ"],["を"],["見て","みて"],["おられる"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["。"],["／"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["復讐","ふくしゅう"],["される"],["の"],["を"],["／"],["私","わたくし"],["に"],["見せて","みせて"],["ください"],["。"],["／"],["あなた"],["に"],["私","わたくし"],["の"],["訴え","うったえ"],["を"],["打ち明けた","うちあけた"],["の"],["です"],["から"],["。"]]},{"verse":13,"text":"主に向かって歌い、主をほめたたえよ。／主が貧しい者のいのちを、悪を行う者どもの手から救い出されたからだ。","tok":[["主に","おもに"],["向かって","むかって"],["歌い","うたい"],["、"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["／"],["主","ぬし"],["が"],["貧しい","まずしい"],["者","もの"],["の"],["いのち"],["を"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["ども"],["の"],["手","て"],["から"],["救い出された","すくいだされた"],["から"],["だ"],["。"]]},{"verse":14,"text":"私の生まれた日は、のろわれよ。／母が私を産んだその日は、祝福されるな。","tok":[["私","わたくし"],["の"],["生まれた","うまれた"],["日","ひ"],["は"],["、"],["のろわれ"],["よ"],["。"],["／"],["母","はは"],["が"],["私","わたくし"],["を"],["産んだ","うんだ"],["その"],["日","ひ"],["は"],["、"],["祝福","しゅくふく"],["される"],["な"],["。"]]},{"verse":15,"text":"私の父に、「あなたに男の子が生まれた」と言って伝え、彼を大いに喜ばせた人は、のろわれよ。","tok":[["私","わたくし"],["の"],["父","ちち"],["に"],["、"],["「"],["あなた"],["に"],["男の子","おとこのこ"],["が"],["生まれた","うまれた"],["」"],["と"],["言って","いって"],["伝え","つたえ"],["、"],["彼","かれ"],["を"],["大いに","おおいに"],["喜ばせた","よろこばせた"],["人","ひと"],["は"],["、"],["のろわれ"],["よ"],["。"]]},{"verse":16,"text":"その人は、主がくつがえして／悔いない町々のようになれ。／朝には彼に叫びを聞かせ、真昼にはときの声を聞かせよ。","tok":[["その"],["人","ひと"],["は"],["、"],["主","ぬし"],["が"],["くつがえして"],["／"],["悔いない","くいない"],["町々","まちまち"],["の"],["よう"],["に"],["なれ"],["。"],["／"],["朝","あさ"],["に"],["は"],["彼","かれ"],["に"],["叫び","さけび"],["を"],["聞かせ","きかせ"],["、"],["真昼","まひる"],["に"],["は"],["とき"],["の"],["声","こえ"],["を"],["聞かせ","きかせ"],["よ"],["。"]]},{"verse":17,"text":"彼は、私が胎内にいるとき、私を殺さず、私の母を私の墓とせず、彼女の胎を、永久に／みごもったままにして／おかなかったのだから。","tok":[["彼","かれ"],["は"],["、"],["私","わたくし"],["が"],["胎内","たいない"],["に"],["いる"],["とき"],["、"],["私","わたくし"],["を"],["殺さず","ころさず"],["、"],["私","わたくし"],["の"],["母","はは"],["を"],["私","わたくし"],["の"],["墓","はか"],["と"],["せず"],["、"],["彼女","かのじょ"],["の"],["胎","はら"],["を"],["、"],["永久","えいきゅう"],["に"],["／"],["みごもった"],["まま"],["に"],["して"],["／"],["おかなかった"],["の"],["だ"],["から"],["。"]]},{"verse":18,"text":"なぜ、私は労苦と苦悩に会うために／胎を出たのか。／私の一生は恥のうちに終わるのか。","tok":[["なぜ"],["、"],["私","わたくし"],["は"],["労苦","ろうく"],["と"],["苦悩","くのう"],["に"],["会う","あう"],["ため"],["に"],["／"],["胎","はら"],["を"],["出た","でた"],["の"],["か"],["。"],["／"],["私","わたくし"],["の"],["一生","いっしょう"],["は"],["恥","はじ"],["の"],["うち"],["に"],["終わる","おわる"],["の"],["か"],["。"]]}]
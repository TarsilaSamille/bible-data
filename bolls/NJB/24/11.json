[{"verse":1,"text":"主からエレミヤにあったみことばは、こうである。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["は"],["、"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"「この契約のことばを聞け。これをユダの人とエルサレムの住民に語って、","tok":[["「"],["この"],["契約","けいやく"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["これ"],["を"],["ユダ"],["の"],["人","ひと"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["語って","かたって"],["、"]]},{"verse":3,"text":"彼らに言え。／イスラエルの神、主は、こう仰せられる。この契約のことばを聞かない者は、のろわれよ。","tok":[["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["／"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["この"],["契約","けいやく"],["の"],["ことば"],["を"],["聞かない","きかない"],["者","もの"],["は"],["、"],["のろわれ"],["よ"],["。"]]},{"verse":4,"text":"これは、わたしがあなたがたの先祖をエジプトの国、鉄の炉から連れ出した日に、『わたしの声に聞き従い、すべてわたしがあなたがたに命ずるように、それを行え。そうすれば、あなたがたはわたしの民となり、わたしはあなたがたの神となる』と言って、彼らに命じたものだ。","tok":[["これ"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["国","くに"],["、"],["鉄","てつ"],["の"],["炉","ろ"],["から"],["連れ出した","つれだした"],["日","ひ"],["に"],["、"],["『"],["わたし"],["の"],["声","こえ"],["に"],["聞き従い","ききしたがい"],["、"],["すべて"],["わたし"],["が"],["あなた"],["がた"],["に"],["命ずる","めいずる"],["よう"],["に"],["、"],["それ"],["を"],["行え","おこなえ"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["』"],["と"],["言って","いって"],["、"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["もの"],["だ"],["。"]]},{"verse":5,"text":"それは、わたしがあなたがたの先祖に対して、乳と蜜の流れる地を彼らに与えると誓った誓いを、今日あるとおり成就するためであった。」そこで、私は答えて言った。「主よ。アーメン。」","tok":[["それ"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に対して","にたいして"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["を"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["と"],["誓った","ちかった"],["誓い","ちかい"],["を"],["、"],["今日","きょう"],["ある"],["とおり"],["成就","じょうじゅ"],["する"],["ため"],["で"],["あった"],["。"],["」"],["そこ"],["で"],["、"],["私","わたくし"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["アーメン"],["。"],["」"]]},{"verse":6,"text":"すると主は私に仰せられた。「これらのことばのすべてを、ユダの町々と、エルサレムのちまたで叫んで、こう言え。『この契約のことばを聞いて、これを行え。』","tok":[["する"],["と"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["これ"],["ら"],["の"],["ことば"],["の"],["すべて"],["を"],["、"],["ユダ"],["の"],["町々","まちまち"],["と"],["、"],["エルサレム"],["の"],["ちまた"],["で"],["叫んで","さけんで"],["、"],["こう"],["言え","いえ"],["。"],["『"],["この"],["契約","けいやく"],["の"],["ことば"],["を"],["聞いて","きいて"],["、"],["これ"],["を"],["行え","おこなえ"],["。"],["』"]]},{"verse":7,"text":"わたしは、あなたがたの先祖をエジプトの国から導き出した日に、彼らをはっきり戒め、また今日まで、『わたしの声を聞け』と言って、しきりに戒めてきた。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出した","みちびきだした"],["日","ひ"],["に"],["、"],["彼","かれ"],["ら"],["を"],["はっきり"],["戒め","いましめ"],["、"],["また"],["今日","きょう"],["まで"],["、"],["『"],["わたし"],["の"],["声","こえ"],["を"],["聞け","きけ"],["』"],["と"],["言って","いって"],["、"],["しきり"],["に"],["戒めて","いましめて"],["きた"],["。"]]},{"verse":8,"text":"しかし彼らは聞かず、耳を傾けず、おのおの悪いかたくなな心のままに歩んだ。それで、わたしはこの契約のことばをみな、彼らに実現させた。わたしが行うように命じたのに、彼らが行わなかったからである。」","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["聞かず","きかず"],["、"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["おのおの"],["悪い","わるい"],["かたくな"],["な"],["心","こころ"],["の"],["まま"],["に"],["歩んだ","あゆんだ"],["。"],["それ"],["で"],["、"],["わたし"],["は"],["この"],["契約","けいやく"],["の"],["ことば"],["を"],["みな"],["、"],["彼","かれ"],["ら"],["に"],["実現","じつげん"],["させた"],["。"],["わたし"],["が"],["行う","おこなう"],["よう"],["に"],["命じた","めいじた"],["のに"],["、"],["彼","かれ"],["ら"],["が"],["行わなかった","おこなわなかった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"ついで、主は私に仰せられた。「ユダの人、エルサレムの住民の間に、謀反がある。","tok":[["つい"],["で"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["ユダ"],["の"],["人","ひと"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["の"],["間","あいだ"],["に"],["、"],["謀反","むほん"],["が"],["ある"],["。"]]},{"verse":10,"text":"彼らは、わたしのことばを聞こうとしなかった彼らの先祖たちの咎をくり返し、彼ら自身も、ほかの神々に従って、これに仕えた。イスラエルの家とユダの家は、わたしが彼らの先祖たちと結んだわたしの契約を破った。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["ことば"],["を"],["聞こう","きこう"],["と"],["しなかった"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["の"],["咎","とが"],["を"],["くり返し","くりかえし"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["も"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["、"],["これ"],["に"],["仕えた","つかえた"],["。"],["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["と"],["結んだ","むすんだ"],["わたし"],["の"],["契約","けいやく"],["を"],["破った","やぶった"],["。"],["」"]]},{"verse":11,"text":"それゆえ、主はこう仰せられる。「見よ。わたしは彼らにわざわいを下す。彼らはそれからのがれることはできない。彼らはわたしに叫ぶだろうが、わたしは彼らに聞かない。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["わざわい"],["を"],["下す","くだす"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["から"],["のがれる"],["こと"],["は"],["できない"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["叫ぶだろう","さけぶだろう"],["が"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["聞かない","きかない"],["。"]]},{"verse":12,"text":"そこで、ユダの町々とエルサレムの住民は、彼らが香をたいた神々のもとに行って叫ぶだろうが、これらは、彼らのわざわいの時に、彼らを決して救うことはできない。","tok":[["そこ"],["で"],["、"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["は"],["、"],["彼","かれ"],["ら"],["が"],["香","こう"],["を"],["たいた"],["神々","かみがみ"],["の"],["もと"],["に"],["行って","いって"],["叫ぶだろう","さけぶだろう"],["が"],["、"],["これ"],["ら"],["は"],["、"],["彼","かれ"],["ら"],["の"],["わざわい"],["の"],["時","とき"],["に"],["、"],["彼","かれ"],["ら"],["を"],["決して","けっして"],["救う","すくう"],["こと"],["は"],["できない"],["。"]]},{"verse":13,"text":"なぜなら、ユダよ、あなたの神々は、あなたの町の数ほどもあり、あなたがたは、恥ずべきもののための祭壇、バアルのためにいけにえを焼く祭壇を、エルサレムの通りの数ほども設けたからである。","tok":[["なぜ"],["なら"],["、"],["ユダ"],["よ"],["、"],["あなた"],["の"],["神々","かみがみ"],["は"],["、"],["あなた"],["の"],["町","まち"],["の"],["数","かず"],["ほど"],["も"],["あり"],["、"],["あなた"],["がた"],["は"],["、"],["恥ずべき","はずべき"],["もの"],["の"],["ため"],["の"],["祭壇","さいだん"],["、"],["バアル"],["の"],["ため"],["に"],["いけにえ"],["を"],["焼く","やく"],["祭壇","さいだん"],["を"],["、"],["エルサレム"],["の"],["通り","とおり"],["の"],["数","かず"],["ほど"],["も"],["設けた","もうけた"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"あなたは、この民のために祈ってはならない。彼らのために叫んだり祈りをささげたりしてはならない。彼らがわざわいに会ってわたしを呼ぶときにも、わたしは聞かないからだ。","tok":[["あなた"],["は"],["、"],["この"],["民","たみ"],["の"],["ため"],["に"],["祈って","いのって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["叫ん","さけん"],["だり"],["祈り","いのり"],["を"],["ささげ"],["たり"],["して"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["わざわい"],["に"],["会って","あって"],["わたし"],["を"],["呼ぶ","よぶ"],["とき"],["に"],["も"],["、"],["わたし"],["は"],["聞かない","きかない"],["から"],["だ"],["。"]]},{"verse":15,"text":"わたしの愛する者は、わたしの家で、何をしているのか。何をたくらんでいるのか。／誓願のささげ物や、いけにえの肉が、わざわいをあなたから過ぎ去らせるのか。／その時には、こおどりして喜ぶがよい。","tok":[["わたし"],["の"],["愛する","あいする"],["者","もの"],["は"],["、"],["わたし"],["の"],["家","いえ"],["で"],["、"],["何","なん"],["を"],["して"],["いる"],["の"],["か"],["。"],["何","なん"],["を"],["たくらんで"],["いる"],["の"],["か"],["。"],["／"],["誓願","せいがん"],["の"],["ささげ物","ささげもの"],["や"],["、"],["いけにえ"],["の"],["肉","にく"],["が"],["、"],["わざわい"],["を"],["あなた"],["から"],["過ぎ去らせる","すぎさらせる"],["の"],["か"],["。"],["／"],["その"],["時","とき"],["に"],["は"],["、"],["こおどり"],["して"],["喜ぶ","よろこぶ"],["が"],["よい"],["。"]]},{"verse":16,"text":"主はかつてあなたの名を、『良い実をみのらせる／美しい緑のオリーブの木』と呼ばれたが、大きな騒ぎの声が起こると、主はこれに火をつけ、その枝を焼かれる。","tok":[["主","ぬし"],["は"],["かつて"],["あなた"],["の"],["名","な"],["を"],["、"],["『"],["良い","よい"],["実","じつ"],["を"],["みのらせる"],["／"],["美しい","うつくしい"],["緑","みどり"],["の"],["オリーブ"],["の"],["木","き"],["』"],["と"],["呼ばれた","よばれた"],["が"],["、"],["大きな","おおきな"],["騒ぎ","さわぎ"],["の"],["声","こえ"],["が"],["起こる","おこる"],["と"],["、"],["主","ぬし"],["は"],["これ"],["に"],["火","ひ"],["を"],["つけ"],["、"],["その"],["枝","えだ"],["を"],["焼かれる","やかれる"],["。"]]},{"verse":17,"text":"あなたを植えた万軍の主が、あなたにわざわいを言い渡す。これはイスラエルの家とユダの家が、悪を行い、バアルにいけにえをささげて、わたしの怒りを引き起こしたからである。」","tok":[["あなた"],["を"],["植えた","うえた"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["、"],["あなた"],["に"],["わざわい"],["を"],["言い渡す","いいわたす"],["。"],["これ"],["は"],["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["が"],["、"],["悪","あく"],["を"],["行い","おこない"],["、"],["バアル"],["に"],["いけにえ"],["を"],["ささげて"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こした","ひきおこした"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":18,"text":"主が私に知らせてくださったので、私はそれを知りました。今、あなたは、彼らのわざを、私に見せてくださいました。","tok":[["主","ぬし"],["が"],["私","わたくし"],["に"],["知らせて","しらせて"],["くださった"],["ので"],["、"],["私","わたくし"],["は"],["それ"],["を"],["知りました","しりました"],["。"],["今","いま"],["、"],["あなた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["わざ"],["を"],["、"],["私","わたくし"],["に"],["見せて","みせて"],["くださいました"],["。"]]},{"verse":19,"text":"私は、ほふり場に引かれて行くおとなしい子羊のようでした。彼らが私に敵対して、「木を実とともに滅ぼそう。彼を生ける者の地から断って、その名が二度と思い出されないようにしよう」と計画していたことを、私は知りませんでした。","tok":[["私","わたくし"],["は"],["、"],["ほふり場","ほふりじょう"],["に"],["引かれて","ひかれて"],["行く","いく"],["おとなしい"],["子羊","こひつじ"],["の"],["よう"],["でした"],["。"],["彼","かれ"],["ら"],["が"],["私","わたくし"],["に"],["敵対","てきたい"],["して"],["、"],["「"],["木","き"],["を"],["実","じつ"],["と"],["とも"],["に"],["滅ぼそう","ほろぼそう"],["。"],["彼","かれ"],["を"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["から"],["断って","ことわって"],["、"],["その"],["名","な"],["が"],["二","に"],["度","ど"],["と"],["思い出されない","おもいだされない"],["よう"],["に"],["しよう"],["」"],["と"],["計画","けいかく"],["して"],["いた"],["こと"],["を"],["、"],["私","わたくし"],["は"],["知りませんでした","しりませんでした"],["。"]]},{"verse":20,"text":"しかし、正しいさばきをし、思いと心をためされる万軍の主よ。／あなたが彼らに復讐するのを／私は見ることでしょう。／私が、あなたに私の訴えを打ち明けたからです。","tok":[["しかし"],["、"],["正しい","ただしい"],["さばき"],["を"],["し"],["、"],["思い","おもい"],["と"],["心","こころ"],["を"],["ためされる"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["。"],["／"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["復讐","ふくしゅう"],["する"],["の"],["を"],["／"],["私","わたくし"],["は"],["見る","みる"],["こと"],["でしょう"],["。"],["／"],["私","わたくし"],["が"],["、"],["あなた"],["に"],["私","わたくし"],["の"],["訴え","うったえ"],["を"],["打ち明けた","うちあけた"],["から"],["です"],["。"]]},{"verse":21,"text":"それゆえ、主はアナトテの人々について、こう仰せられた。「彼らはあなたのいのちをねらい、『主の名によって預言するな。われわれの手にかかってあなたが死なないように』と言っている。」","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["アナトテ"],["の"],["人々","ひとびと"],["について"],["、"],["こう"],["仰せられた","おおせられた"],["。"],["「"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["いのち"],["を"],["ねらい"],["、"],["『"],["主","ぬし"],["の"],["名","な"],["によって"],["預言","よげん"],["する"],["な"],["。"],["われわれ"],["の"],["手","て"],["に"],["かかって"],["あなた"],["が"],["死なない","しなない"],["よう"],["に"],["』"],["と"],["言って","いって"],["いる"],["。"],["」"]]},{"verse":22,"text":"それで、万軍の主はこう仰せられる。「見よ。わたしは彼らを罰する。若い男は剣で殺され、彼らの息子、娘は飢えて死に、","tok":[["それ"],["で"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["罰する","ばっする"],["。"],["若い","わかい"],["男","おとこ"],["は"],["剣","けん"],["で"],["殺され","ころされ"],["、"],["彼","かれ"],["ら"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["は"],["飢えて","うえて"],["死に","しに"],["、"]]},{"verse":23,"text":"彼らには残る者がいなくなる。わたしがアナトテの人々にわざわいを下し、刑罰の年をもたらすからだ。」","tok":[["彼","かれ"],["ら"],["に"],["は"],["残る","のこる"],["者","もの"],["が"],["いなく"],["なる"],["。"],["わたし"],["が"],["アナトテ"],["の"],["人々","ひとびと"],["に"],["わざわい"],["を"],["下し","くだし"],["、"],["刑罰","けいばつ"],["の"],["年","とし"],["を"],["もたらす"],["から"],["だ"],["。"],["」"]]}]
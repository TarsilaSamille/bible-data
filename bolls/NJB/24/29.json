[{"verse":1,"text":"預言者エレミヤは、ネブカデネザルがエルサレムからバビロンへ引いて行った捕囚の民、長老たちで生き残っている者たち、祭司たち、預言者たち、およびすべての民に、エルサレムから手紙を送ったが、そのことばは次のとおりである。","tok":[["預言者","よげんしゃ"],["エレミヤ"],["は"],["、"],["ネブカデネザル"],["が"],["エルサレム"],["から"],["バビロン"],["へ"],["引いて","ひいて"],["行った","いった"],["捕囚","ほしゅう"],["の"],["民","たみ"],["、"],["長老","ちょうろう"],["たち"],["で"],["生き残って","いきのこって"],["いる"],["者","もの"],["たち"],["、"],["祭司","さいし"],["たち"],["、"],["預言者","よげんしゃ"],["たち"],["、"],["および"],["すべて"],["の"],["民","たみ"],["に"],["、"],["エルサレム"],["から"],["手紙","てがみ"],["を"],["送った","おくった"],["が"],["、"],["その"],["ことば"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"――これは、エコヌヤ王と王母と宦官たち、ユダとエルサレムの貴族たち、職人と鍛冶屋たちが、エルサレムを出て後、","tok":[["―"],["―"],["これ"],["は"],["、"],["エコヌヤ"],["王","おう"],["と"],["王母","おうぼ"],["と"],["宦官","かんがん"],["たち"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["貴族","きぞく"],["たち"],["、"],["職人","しょくにん"],["と"],["鍛冶屋","かじや"],["たち"],["が"],["、"],["エルサレム"],["を"],["出て","でて"],["後","あと"],["、"]]},{"verse":3,"text":"ユダの王ゼデキヤがバビロンの王ネブカデネザルのもとに、バビロンへ遣わした、シャファンの子エルアサとヒルキヤの子ゲマルヤの手に託したもので、次のように言っている――","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["が"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["の"],["もと"],["に"],["、"],["バビロン"],["へ"],["遣わした","つかわした"],["、"],["シャファン"],["の"],["子","こ"],["エルアサ"],["と"],["ヒルキヤ"],["の"],["子","こ"],["ゲマルヤ"],["の"],["手","て"],["に"],["託した","たくした"],["もの"],["で"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言って","いって"],["いる"],["―"],["―"]]},{"verse":4,"text":"イスラエルの神、万軍の主は、こう仰せられる。「エルサレムからバビロンへわたしが引いて行かせたすべての捕囚の民に。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["エルサレム"],["から"],["バビロン"],["へ"],["わたし"],["が"],["引いて","ひいて"],["行かせた","いかせた"],["すべて"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["に"],["。"]]},{"verse":5,"text":"家を建てて住みつき、畑を作って、その実を食べよ。","tok":[["家","いえ"],["を"],["建てて","たてて"],["住みつき","すみつき"],["、"],["畑","はたけ"],["を"],["作って","つくって"],["、"],["その"],["実","じつ"],["を"],["食べ","たべ"],["よ"],["。"]]},{"verse":6,"text":"妻をめとって、息子、娘を生み、あなたがたの息子には妻をめとり、娘には夫を与えて、息子、娘を産ませ、そこでふえよ。減ってはならない。","tok":[["妻","つま"],["を"],["めとって"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["を"],["生み","うみ"],["、"],["あなた"],["がた"],["の"],["息子","むすこ"],["に"],["は"],["妻","つま"],["を"],["めとり"],["、"],["娘","むすめ"],["に"],["は"],["夫","おっと"],["を"],["与えて","あたえて"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["を"],["産ませ","うませ"],["、"],["そこ"],["で"],["ふえ"],["よ"],["。"],["減って","へって"],["は"],["ならない"],["。"]]},{"verse":7,"text":"わたしがあなたがたを引いて行ったその町の繁栄を求め、そのために主に祈れ。そこの繁栄は、あなたがたの繁栄になるのだから。」","tok":[["わたし"],["が"],["あなた"],["がた"],["を"],["引いて","ひいて"],["行った","いった"],["その"],["町","まち"],["の"],["繁栄","はんえい"],["を"],["求め","もとめ"],["、"],["その"],["ため"],["に"],["主に","おもに"],["祈れ","いのれ"],["。"],["そこ"],["の"],["繁栄","はんえい"],["は"],["、"],["あなた"],["がた"],["の"],["繁栄","はんえい"],["に"],["なる"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":8,"text":"まことに、イスラエルの神、万軍の主は、こう仰せられる。「あなたがたのうちにいる預言者たちや、占い師たちにごまかされるな。あなたがたが夢を見させている、あなたがたの夢見る者の言うことを聞くな。","tok":[["まこと"],["に"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["がた"],["の"],["うち"],["に"],["いる"],["預言者","よげんしゃ"],["たち"],["や"],["、"],["占い師","うらないし"],["たち"],["に"],["ごまかされる"],["な"],["。"],["あなた"],["がた"],["が"],["夢","ゆめ"],["を"],["見させて","みさせて"],["いる"],["、"],["あなた"],["がた"],["の"],["夢","ゆめ"],["見る","みる"],["者","もの"],["の"],["言う","いう"],["こと"],["を"],["聞く","きく"],["な"],["。"]]},{"verse":9,"text":"なぜなら、彼らはわたしの名を使って偽りをあなたがたに預言しているのであって、わたしが彼らを遣わしたのではないからだ。――主の御告げ――」","tok":[["なぜ"],["なら"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["名","な"],["を"],["使って","つかって"],["偽り","いつわり"],["を"],["あなた"],["がた"],["に"],["預言","よげん"],["して"],["いる"],["ので"],["あって"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["遣わした","つかわした"],["ので"],["は"],["ない"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":10,"text":"まことに、主はこう仰せられる。「バビロンに七十年の満ちるころ、わたしはあなたがたを顧み、あなたがたにわたしの幸いな約束を果たして、あなたがたをこの所に帰らせる。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["バビロン"],["に"],["七十","ななじゅう"],["年","ねん"],["の"],["満ちる","みちる"],["ころ"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["顧み","かえりみ"],["、"],["あなた"],["がた"],["に"],["わたし"],["の"],["幸い","さいわい"],["な"],["約束","やくそく"],["を"],["果たして","はたして"],["、"],["あなた"],["がた"],["を"],["この"],["所","ところ"],["に"],["帰らせる","かえらせる"],["。"]]},{"verse":11,"text":"わたしはあなたがたのために立てている計画をよく知っているからだ。――主の御告げ――それはわざわいではなくて、平安を与える計画であり、あなたがたに将来と希望を与えるためのものだ。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["立てて","たてて"],["いる"],["計画","けいかく"],["を"],["よく"],["知って","しって"],["いる"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["それ"],["は"],["わざわい"],["で"],["は"],["なくて"],["、"],["平安","へいあん"],["を"],["与える","あたえる"],["計画","けいかく"],["で"],["あり"],["、"],["あなた"],["がた"],["に"],["将来","しょうらい"],["と"],["希望","きぼう"],["を"],["与える","あたえる"],["ため"],["の"],["もの"],["だ"],["。"]]},{"verse":12,"text":"あなたがたがわたしを呼び求めて歩き、わたしに祈るなら、わたしはあなたがたに聞こう。","tok":[["あなた"],["がた"],["が"],["わたし"],["を"],["呼び求めて","よびもとめて"],["歩き","あるき"],["、"],["わたし"],["に"],["祈るなら","いのるなら"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["聞こう","きこう"],["。"]]},{"verse":13,"text":"もし、あなたがたが心を尽くしてわたしを捜し求めるなら、わたしを見つけるだろう。","tok":[["もし"],["、"],["あなた"],["がた"],["が"],["心","こころ"],["を"],["尽くして","つくして"],["わたし"],["を"],["捜し求めるなら","さがしもとめるなら"],["、"],["わたし"],["を"],["見つけるだろう","みつけるだろう"],["。"]]},{"verse":14,"text":"わたしはあなたがたに見つけられる。――主の御告げ――わたしは、あなたがたの繁栄を元どおりにし、わたしがあなたがたを追い散らした先のすべての国々と、すべての場所から、あなたがたを集める。――主の御告げ――わたしはあなたがたを引いて行った先から、あなたがたをもとの所へ帰らせる。」","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["見つけられる","みつけられる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["し"],["、"],["わたし"],["が"],["あなた"],["がた"],["を"],["追い散らした","おいちらした"],["先","さき"],["の"],["すべて"],["の"],["国々","くにぐに"],["と"],["、"],["すべて"],["の"],["場所","ばしょ"],["から"],["、"],["あなた"],["がた"],["を"],["集める","あつめる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["は"],["あなた"],["がた"],["を"],["引いて","ひいて"],["行った","いった"],["先","さき"],["から"],["、"],["あなた"],["がた"],["を"],["もと"],["の"],["所","ところ"],["へ"],["帰らせる","かえらせる"],["。"],["」"]]},{"verse":15,"text":"あなたがたは、「主は私たちのために、バビロンでも預言者を起こされた」と言っているが、","tok":[["あなた"],["がた"],["は"],["、"],["「"],["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["ため"],["に"],["、"],["バビロン"],["で"],["も"],["預言者","よげんしゃ"],["を"],["起こされた","おこされた"],["」"],["と"],["言って","いって"],["いる"],["が"],["、"]]},{"verse":16,"text":"まことに、主は、ダビデの王座に着いている王と、この町に住んでいるすべての民と、捕囚としてあなたがたといっしょに出て行かなかったあなたがたの兄弟について、こう仰せられる。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["、"],["ダビデ"],["の"],["王座","おうざ"],["に"],["着いて","ついて"],["いる"],["王","おう"],["と"],["、"],["この"],["町","まち"],["に"],["住んで","すんで"],["いる"],["すべて"],["の"],["民","たみ"],["と"],["、"],["捕囚","ほしゅう"],["として"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["出て","でて"],["行かなかった","いかなかった"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["について"],["、"],["こう"],["仰せられる","おおせられる"],["。"]]},{"verse":17,"text":"万軍の主はこう仰せられる。「見よ。わたしは彼らの中に、剣とききんと疫病を送り、彼らを悪くて食べられない割れたいちじくのようにする。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["、"],["剣","けん"],["と"],["ききん"],["と"],["疫病","やくびょう"],["を"],["送り","おくり"],["、"],["彼","かれ"],["ら"],["を"],["悪くて","わるくて"],["食べられない","たべられない"],["割れた","われた"],["いちじく"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":18,"text":"わたしは剣とききんと疫病で彼らを追い、彼らを、地のすべての王国のおののきとし、わたしが彼らを追い散らしたすべての国の間で、のろいとし、恐怖とし、あざけりとし、そしりとする。","tok":[["わたし"],["は"],["剣","けん"],["と"],["ききん"],["と"],["疫病","やくびょう"],["で"],["彼","かれ"],["ら"],["を"],["追い","おい"],["、"],["彼","かれ"],["ら"],["を"],["、"],["地","ち"],["の"],["すべて"],["の"],["王国","おうこく"],["の"],["おののき"],["と"],["し"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["追い散らした","おいちらした"],["すべて"],["の"],["国","くに"],["の"],["間","あいだ"],["で"],["、"],["のろい"],["と"],["し"],["、"],["恐怖","きょうふ"],["と"],["し"],["、"],["あざけり"],["と"],["し"],["、"],["そしり"],["と"],["する"],["。"]]},{"verse":19,"text":"彼らがわたしのことばを聞かなかったからだ。――主の御告げ――わたしが彼らにわたしのしもべである預言者たちを早くからたびたび送ったのに、あなたがたが聞かなかったからだ。――主の御告げ――","tok":[["彼","かれ"],["ら"],["が"],["わたし"],["の"],["ことば"],["を"],["聞かなかった","きかなかった"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["を"],["早く","はやく"],["から"],["たびたび"],["送った","おくった"],["のに"],["、"],["あなた"],["がた"],["が"],["聞かなかった","きかなかった"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":20,"text":"わたしがエルサレムからバビロンへ送ったすべての捕囚の民よ。主のことばを聞け。」","tok":[["わたし"],["が"],["エルサレム"],["から"],["バビロン"],["へ"],["送った","おくった"],["すべて"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["よ"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["」"]]},{"verse":21,"text":"イスラエルの神、万軍の主は、わたしの名によってあなたがたに偽りを預言している者であるコラヤの子アハブと、マアセヤの子ゼデキヤについて、こう仰せられる。「見よ。わたしは彼らを、バビロンの王ネブカデレザルの手に渡す。彼はあなたがたの目の前で、彼らを打ち殺す。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["わたし"],["の"],["名","な"],["によって"],["あなた"],["がた"],["に"],["偽り","いつわり"],["を"],["預言","よげん"],["して"],["いる"],["者","もの"],["で"],["ある"],["コラヤ"],["の"],["子","こ"],["アハブ"],["と"],["、"],["マアセヤ"],["の"],["子","こ"],["ゼデキヤ"],["について"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["彼","かれ"],["ら"],["を"],["打ち殺す","うちころす"],["。"]]},{"verse":22,"text":"バビロンにいるユダの捕囚の民はみな、のろうときに彼らの名を使い、『主がおまえをバビロンの王が火で焼いたゼデキヤやアハブのようにされるように』と言うようになる。","tok":[["バビロン"],["に"],["いる"],["ユダ"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["は"],["みな"],["、"],["のろう"],["とき"],["に"],["彼","かれ"],["ら"],["の"],["名","な"],["を"],["使い","つかい"],["、"],["『"],["主","ぬし"],["が"],["おまえ"],["を"],["バビロン"],["の"],["王","おう"],["が"],["火","ひ"],["で"],["焼いた","やいた"],["ゼデキヤ"],["や"],["アハブ"],["の"],["よう"],["に"],["される"],["よう"],["に"],["』"],["と"],["言う","いう"],["よう"],["に"],["なる"],["。"]]},{"verse":23,"text":"それは、彼らがイスラエルのうちで、恥ずべきことを行い、隣人の妻たちと姦通し、わたしの命じもしなかった偽りのことばをわたしの名によって語ったからである。わたしはそれを知っており、その証人である。――主の御告げ――」","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["イスラエル"],["の"],["うち"],["で"],["、"],["恥ずべき","はずべき"],["こと"],["を"],["行い","おこない"],["、"],["隣人","りんじん"],["の"],["妻たち","つまたち"],["と"],["姦通","かんつう"],["し"],["、"],["わたし"],["の"],["命じ","めいじ"],["も"],["しなかった"],["偽り","いつわり"],["の"],["ことば"],["を"],["わたし"],["の"],["名","な"],["によって"],["語った","かたった"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["それ"],["を"],["知って","しって"],["おり"],["、"],["その"],["証人","しょうにん"],["で"],["ある"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":24,"text":"あなたはネヘラム人シェマヤに次のように言わなければならない。","tok":[["あなた"],["は"],["ネヘラム"],["人","にん"],["シェマヤ"],["に"],["次","つぎ"],["の"],["よう"],["に"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":25,"text":"「イスラエルの神、万軍の主は、次のように仰せられる。あなたは、あなたの名によって、エルサレムにいるすべての民と、マアセヤの子、祭司ゼパニヤ、および、すべての祭司に次のような手紙を送った。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["次","つぎ"],["の"],["よう"],["に"],["仰せられる","おおせられる"],["。"],["あなた"],["は"],["、"],["あなた"],["の"],["名","な"],["によって"],["、"],["エルサレム"],["に"],["いる"],["すべて"],["の"],["民","たみ"],["と"],["、"],["マアセヤ"],["の"],["子","こ"],["、"],["祭司","さいし"],["ゼパニヤ"],["、"],["および"],["、"],["すべて"],["の"],["祭司","さいし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["手紙","てがみ"],["を"],["送った","おくった"],["。"]]},{"verse":26,"text":"『主は、祭司エホヤダの代わりに、あなたを祭司とされましたが、それは、あなたを主の宮の監督者に任じて、すべて狂って預言をする者に備え、そういう者に足かせや、首かせをはめるためでした。","tok":[["『"],["主","ぬし"],["は"],["、"],["祭司","さいし"],["エホヤダ"],["の"],["代わり","かわり"],["に"],["、"],["あなた"],["を"],["祭司","さいし"],["と"],["されました"],["が"],["、"],["それ"],["は"],["、"],["あなた"],["を"],["主","ぬし"],["の"],["宮","みや"],["の"],["監督者","かんとくしゃ"],["に"],["任じて","にんじて"],["、"],["すべて"],["狂って","くるって"],["預言","よげん"],["を"],["する"],["者","もの"],["に"],["備え","そなえ"],["、"],["そう"],["いう"],["者","もの"],["に"],["足かせ","あしかせ"],["や"],["、"],["首かせ","くびかせ"],["を"],["はめる"],["ため"],["でした"],["。"]]},{"verse":27,"text":"それなのに、なぜ、今あなたは、あなたがたに預言しているアナトテ人エレミヤを責めないのですか。","tok":[["それ"],["な"],["のに"],["、"],["なぜ"],["、"],["今","いま"],["あなた"],["は"],["、"],["あなた"],["がた"],["に"],["預言","よげん"],["して"],["いる"],["アナトテ"],["人","にん"],["エレミヤ"],["を"],["責めない","せめない"],["の"],["です"],["か"],["。"]]},{"verse":28,"text":"それで、彼はバビロンの私たちのところに使いをよこして、それは長く続く。家を建てて住みつき、畑を作ってその実を食べなさいと、言わせたのです。』」","tok":[["それ"],["で"],["、"],["彼","かれ"],["は"],["バビロン"],["の"],["私たち","わたしたち"],["の"],["ところ"],["に"],["使い","つかい"],["を"],["よこして"],["、"],["それ"],["は"],["長く","ながく"],["続く","つづく"],["。"],["家","いえ"],["を"],["建てて","たてて"],["住みつき","すみつき"],["、"],["畑","はたけ"],["を"],["作って","つくって"],["その"],["実","じつ"],["を"],["食べ","たべ"],["なさい"],["と"],["、"],["言わせた","いわせた"],["の"],["です"],["。"],["』"],["」"]]},{"verse":29,"text":"――祭司ゼパニヤがこの手紙を預言者エレミヤに読んで聞かせたとき、","tok":[["―"],["―"],["祭司","さいし"],["ゼパニヤ"],["が"],["この"],["手紙","てがみ"],["を"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["読んで","よんで"],["聞かせた","きかせた"],["とき"],["、"]]},{"verse":30,"text":"エレミヤに次のような主のことばがあった。――","tok":[["エレミヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"],["―"],["―"]]},{"verse":31,"text":"「すべての捕囚の民に言い送れ。主はネヘラム人シェマヤにこう仰せられる。わたしはシェマヤを遣わさなかったのに、シェマヤがあなたがたに預言し、あなたがたを偽りに拠り頼ませた。","tok":[["「"],["すべて"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["に"],["言い送れ","いいおくれ"],["。"],["主","ぬし"],["は"],["ネヘラム"],["人","にん"],["シェマヤ"],["に"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["シェマヤ"],["を"],["遣わさなかった","つかわさなかった"],["のに"],["、"],["シェマヤ"],["が"],["あなた"],["がた"],["に"],["預言","よげん"],["し"],["、"],["あなた"],["がた"],["を"],["偽り","いつわり"],["に"],["拠り","より"],["頼ませた","たのませた"],["。"]]},{"verse":32,"text":"それゆえ、主はこう仰せられる。『見よ。わたしはネヘラム人シェマヤと、その子孫とを罰する。彼に属する者で、だれもこの民の中に住んで、わたしがわたしの民に行おうとしている良いことを見る者はいない。――主の御告げ――彼が主に対する反逆をそそのかしたからである。』」","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["ネヘラム"],["人","にん"],["シェマヤ"],["と"],["、"],["その"],["子孫","しそん"],["と"],["を"],["罰する","ばっする"],["。"],["彼","かれ"],["に"],["属する","ぞくする"],["者","もの"],["で"],["、"],["だれ"],["も"],["この"],["民","たみ"],["の"],["中","なか"],["に"],["住んで","すんで"],["、"],["わたし"],["が"],["わたし"],["の"],["民","たみ"],["に"],["行おう","おこなおう"],["として"],["いる"],["良い","よい"],["こと"],["を"],["見る","みる"],["者","もの"],["は"],["いない"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつ
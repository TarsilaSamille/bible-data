[{"verse":1,"text":"ベニヤミンの子らよ。／エルサレムの中からのがれよ。／テコアで角笛を吹き、ベテ・ハケレムでのろしを上げよ。／わざわいと大いなる破滅が、北から見おろしているからだ。","tok":[["ベニヤミン"],["の"],["子","こ"],["ら"],["よ"],["。"],["／"],["エルサレム"],["の"],["中","なか"],["から"],["のがれ"],["よ"],["。"],["／"],["テコア"],["で"],["角笛","つのぶえ"],["を"],["吹き","ふき"],["、"],["ベテ"],["・"],["ハケレム"],["で"],["のろし"],["を"],["上げ","あげ"],["よ"],["。"],["／"],["わざわい"],["と"],["大いなる","おおいなる"],["破滅","はめつ"],["が"],["、"],["北","きた"],["から"],["見おろして","みおろして"],["いる"],["から"],["だ"],["。"]]},{"verse":2,"text":"私は、シオンの娘を、麗しい牧場になぞらえる。","tok":[["私","わたくし"],["は"],["、"],["シオン"],["の"],["娘","むすめ"],["を"],["、"],["麗しい","うるわしい"],["牧場","ぼくじょう"],["に"],["なぞらえる"],["。"]]},{"verse":3,"text":"羊飼いは自分の群れを連れて、そこに行き、その回りに天幕を張り、その群れはおのおの、自分の草を食べる。","tok":[["羊飼い","ひつじかい"],["は"],["自分","じぶん"],["の"],["群れ","むれ"],["を"],["連れて","つれて"],["、"],["そこ"],["に"],["行き","いき"],["、"],["その"],["回り","まわり"],["に"],["天幕","てんまく"],["を"],["張り","はり"],["、"],["その"],["群れ","むれ"],["は"],["おのおの"],["、"],["自分","じぶん"],["の"],["草","くさ"],["を"],["食べる","たべる"],["。"]]},{"verse":4,"text":"「シオンに向かって聖戦をふれよ。／立て。われわれは真昼に上ろう。」「ああ、残念だ。日が傾いた。夕べの影も伸びる。」","tok":[["「"],["シオン"],["に"],["向かって","むかって"],["聖戦","せいせん"],["を"],["ふれよ"],["。"],["／"],["立て","たて"],["。"],["われわれ"],["は"],["真昼","まひる"],["に"],["上ろう","のぼろう"],["。"],["」"],["「"],["ああ"],["、"],["残念","ざんねん"],["だ"],["。"],["日","ひ"],["が"],["傾いた","かたむいた"],["。"],["夕べ","ゆうべ"],["の"],["影","かげ"],["も"],["伸びる","のびる"],["。"],["」"]]},{"verse":5,"text":"「立て。われわれは夜の間に上って、その宮殿を滅ぼそう。」","tok":[["「"],["立て","たて"],["。"],["われわれ"],["は"],["夜","よる"],["の"],["間","あいだ"],["に"],["上って","のぼって"],["、"],["その"],["宮殿","きゅうでん"],["を"],["滅ぼそう","ほろぼそう"],["。"],["」"]]},{"verse":6,"text":"まことに万軍の主はこう仰せられる。／「木を切って、エルサレムに対して塁を築け。／これは罰せられる町。／その中には、しいたげだけがある。","tok":[["まこと"],["に"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["木","き"],["を"],["切って","きって"],["、"],["エルサレム"],["に対して","にたいして"],["塁","るい"],["を"],["築け","きずけ"],["。"],["／"],["これ"],["は"],["罰せられる","ばっせられる"],["町","まち"],["。"],["／"],["その"],["中","なか"],["に"],["は"],["、"],["しいたげ"],["だけ"],["が"],["ある"],["。"]]},{"verse":7,"text":"井戸が水をわき出させるように、エルサレムは自分の悪をわき出させた。／暴虐と暴行が、その中で聞こえる。／わたしの前には、いつも病と打ち傷がある。","tok":[["井戸","いど"],["が"],["水","みず"],["を"],["わき出させる","わきださせる"],["よう"],["に"],["、"],["エルサレム"],["は"],["自分","じぶん"],["の"],["悪","あく"],["を"],["わき出させた","わきださせた"],["。"],["／"],["暴虐","ぼうぎゃく"],["と"],["暴行","ぼうこう"],["が"],["、"],["その"],["中","なか"],["で"],["聞こえる","きこえる"],["。"],["／"],["わたし"],["の"],["前","まえ"],["に"],["は"],["、"],["いつも病","いつもびょう"],["と"],["打ち傷","うちきず"],["が"],["ある"],["。"]]},{"verse":8,"text":"エルサレムよ。戒めを受けよ。／さもないと、わたしの心はおまえから離れ、おまえを住む人もない荒れ果てた地とする。」","tok":[["エルサレム"],["よ"],["。"],["戒め","いましめ"],["を"],["受けよ","うけよ"],["。"],["／"],["さも"],["ない"],["と"],["、"],["わたし"],["の"],["心","こころ"],["は"],["おまえ"],["から"],["離れ","はなれ"],["、"],["おまえ"],["を"],["住む","すむ"],["人","ひと"],["も"],["ない"],["荒れ果てた","あれはてた"],["地","ち"],["と"],["する"],["。"],["」"]]},{"verse":9,"text":"万軍の主はこう仰せられる。「ぶどうの残りを摘むように、イスラエルの残りの者をすっかり摘み取れ。ぶどうを収穫する者のように、あなたの手をもう一度、その枝に伸ばせ。」","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["ぶどう"],["の"],["残り","のこり"],["を"],["摘む","つむ"],["よう"],["に"],["、"],["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["すっかり"],["摘み取れ","つみとれ"],["。"],["ぶどう"],["を"],["収穫","しゅうかく"],["する"],["者","もの"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["手","て"],["を"],["もう"],["一度","いちど"],["、"],["その"],["枝","えだ"],["に"],["伸ばせ","のばせ"],["。"],["」"]]},{"verse":10,"text":"私はだれに語りかけ、だれをさとして、聞かせようか。／見よ。彼らの耳は閉じたままで、聞くこともできない。／見よ。主のことばは、彼らにとって、そしりとなる。／彼らはそれを喜ばない。","tok":[["私","わたくし"],["は"],["だれ"],["に"],["語りかけ","かたりかけ"],["、"],["だれ"],["を"],["さとして"],["、"],["聞かせよう","きかせよう"],["か"],["。"],["／"],["見","み"],["よ"],["。"],["彼","かれ"],["ら"],["の"],["耳","みみ"],["は"],["閉じた","とじた"],["まま"],["で"],["、"],["聞く","きく"],["こと"],["も"],["できない"],["。"],["／"],["見","み"],["よ"],["。"],["主","ぬし"],["の"],["ことば"],["は"],["、"],["彼","かれ"],["ら"],["にとって"],["、"],["そしり"],["と"],["なる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["喜ばない","よろこばない"],["。"]]},{"verse":11,"text":"私の身には主の憤りが満ち、これに耐えるのに、私は疲れ果てた。／「それを、道ばたにいる子どもの上にも、若い男の集まりの上にも、ぶちまけよ。／夫も妻も、ともどもに、年寄りも齢の満ちた者も共に捕らえられ、","tok":[["私","わたくし"],["の"],["身","み"],["に"],["は"],["主","ぬし"],["の"],["憤り","いきどおり"],["が"],["満ち","みち"],["、"],["これ"],["に"],["耐える","たえる"],["のに"],["、"],["私","わたくし"],["は"],["疲れ","つかれ"],["果てた","はてた"],["。"],["／"],["「"],["それ"],["を"],["、"],["道ばた","みちばた"],["に"],["いる"],["子ども","こども"],["の"],["上","うえ"],["に"],["も"],["、"],["若い","わかい"],["男","おとこ"],["の"],["集まり","あつまり"],["の"],["上","うえ"],["に"],["も"],["、"],["ぶちまけよ"],["。"],["／"],["夫","おっと"],["も"],["妻","つま"],["も"],["、"],["ともども"],["に"],["、"],["年寄り","としより"],["も"],["齢","とし"],["の"],["満ちた","みちた"],["者","もの"],["も"],["共","とも"],["に"],["捕らえられ","とらえられ"],["、"]]},{"verse":12,"text":"彼らの家は、畑や妻もろともに、他人のものとなる。／それは、わたしが／この国の住民に手を伸ばすからだ。／――主の御告げ――","tok":[["彼","かれ"],["ら"],["の"],["家","いえ"],["は"],["、"],["畑","はたけ"],["や"],["妻","つま"],["もろとも"],["に"],["、"],["他人","たにん"],["の"],["もの"],["と"],["なる"],["。"],["／"],["それ"],["は"],["、"],["わたし"],["が"],["／"],["この"],["国","くに"],["の"],["住民","じゅうみん"],["に"],["手","て"],["を"],["伸ばす","のばす"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":13,"text":"なぜなら、身分の低い者から高い者まで、みな利得をむさぼり、預言者から祭司に至るまで、みな偽りを行っているからだ。","tok":[["なぜ"],["なら"],["、"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["から"],["高い","たかい"],["者","もの"],["まで"],["、"],["みな"],["利得","りとく"],["を"],["むさぼり"],["、"],["預言者","よげんしゃ"],["から"],["祭司","さいし"],["に"],["至る","いたる"],["まで"],["、"],["みな"],["偽り","いつわり"],["を"],["行って","おこなって"],["いる"],["から"],["だ"],["。"]]},{"verse":14,"text":"彼らは、わたしの民の傷を手軽にいやし、平安がないのに、『平安だ、平安だ』と言っている。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["民","たみ"],["の"],["傷","きず"],["を"],["手軽","てがる"],["に"],["いやし"],["、"],["平安","へいあん"],["が"],["ない"],["のに"],["、"],["『"],["平安","へいあん"],["だ"],["、"],["平安","へいあん"],["だ"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":15,"text":"彼らは忌みきらうべきことをして、恥を見ただろうか。／彼らは少しも恥じず、恥じることも知らない。／だから、彼らは、倒れる者の中に倒れ、わたしが彼らを罰する時に、よろめき倒れる」と／主は仰せられる。","tok":[["彼","かれ"],["ら"],["は"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["して"],["、"],["恥","はじ"],["を"],["見ただろう","みただろう"],["か"],["。"],["／"],["彼","かれ"],["ら"],["は"],["少し",
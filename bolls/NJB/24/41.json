[{"verse":1,"text":"ところが第七の月に、王族のひとり、エリシャマの子ネタヌヤの子イシュマエルは、王の高官と十人の部下を連れて、ミツパにいるアヒカムの子ゲダルヤのもとに来て、ミツパで食事を共にした。","tok":[["ところ"],["が"],["第","だい"],["七","なな"],["の"],["月","つき"],["に"],["、"],["王族","おうぞく"],["の"],["ひとり"],["、"],["エリシャマ"],["の"],["子","こ"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["、"],["王","おう"],["の"],["高官","こうかん"],["と"],["十人","じゅうにん"],["の"],["部下","ぶか"],["を"],["連れて","つれて"],["、"],["ミツパ"],["に"],["いる"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["の"],["もと"],["に"],["来て","きて"],["、"],["ミツパ"],["で"],["食事","しょくじ"],["を"],["共","とも"],["に"],["した"],["。"]]},{"verse":2,"text":"そのとき、ネタヌヤの子イシュマエルと、彼とともにいた十人の部下は立ち上がって、シャファンの子アヒカムの子ゲダルヤを剣で打ち殺した。イシュマエルは、バビロンの王がこの国の総督にした者を殺した。","tok":[["その"],["とき"],["、"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["十人","じゅうにん"],["の"],["部下","ぶか"],["は"],["立ち上がって","たちあがって"],["、"],["シャファン"],["の"],["子","こ"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["を"],["剣","けん"],["で"],["打ち殺した","うちころした"],["。"],["イシュマエル"],["は"],["、"],["バビロン"],["の"],["王","おう"],["が"],["この"],["国","くに"],["の"],["総督","そうとく"],["に"],["した"],["者","もの"],["を"],["殺した","ころした"],["。"]]},{"verse":3,"text":"ミツパでゲダルヤとともにいたすべてのユダヤ人と、そこに居合わせたカルデヤ人の戦士たちをも、イシュマエルは打ち殺した。","tok":[["ミツパ"],["で"],["ゲダルヤ"],["と"],["とも"],["に"],["いた"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["と"],["、"],["そこ"],["に"],["居合わせた","いあわせた"],["カルデヤ"],["人","にん"],["の"],["戦士","せんし"],["たち"],["を"],["も"],["、"],["イシュマエル"],["は"],["打ち殺した","うちころした"],["。"]]},{"verse":4,"text":"ゲダルヤが殺された次の日、まだだれも知らないとき、","tok":[["ゲダルヤ"],["が"],["殺された","ころされた"],["次","つぎ"],["の"],["日","ひ"],["、"],["まだ"],["だれ"],["も"],["知らない","しらない"],["とき"],["、"]]},{"verse":5,"text":"シェケムや、シロや、サマリヤから八十人の者がやって来た。彼らはみな、ひげをそり、衣を裂き、身に傷をつけ、手に穀物のささげ物や乳香を持って、主の宮に持って行こうとしていた。","tok":[["シェケム"],["や"],["、"],["シロ"],["や"],["、"],["サマリヤ"],["から"],["八","はち"],["十人","じゅうにん"],["の"],["者","もの"],["が"],["やって"],["来た","きた"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["ひげ"],["を"],["そり"],["、"],["衣","ころも"],["を"],["裂き","さき"],["、"],["身","み"],["に"],["傷","きず"],["を"],["つけ"],["、"],["手","て"],["に"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["や"],["乳香","にゅうこう"],["を"],["持って","もって"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["持って","もって"],["行こう","いこう"],["として"],["いた"],["。"]]},{"verse":6,"text":"ネタヌヤの子イシュマエルは、彼らを迎えにミツパを出て、泣きながら歩いて行き、彼らに出会ったとき、言った。「アヒカムの子ゲダルヤのところにおいでなさい。」","tok":[["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["、"],["彼","かれ"],["ら"],["を"],["迎え","むかえ"],["に"],["ミツパ"],["を"],["出て","でて"],["、"],["泣き","なき"],["ながら"],["歩いて","あるいて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["に"],["出会った","であった"],["とき"],["、"],["言った","いった"],["。"],["「"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["の"],["ところ"],["に"],["おいで"],["なさい"],["。"],["」"]]},{"verse":7,"text":"彼らが町の中に入ったとき、ネタヌヤの子イシュマエルと、彼とともにいた部下たちは、彼らを殺して穴の中に投げ入れた。","tok":[["彼","かれ"],["ら"],["が"],["町","まち"],["の"],["中","なか"],["に"],["入った","はいった"],["とき"],["、"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["部下","ぶか"],["たち"],["は"],["、"],["彼","かれ"],["ら"],["を"],["殺して","ころして"],["穴","あな"],["の"],["中","なか"],["に"],["投げ入れた","なげいれた"],["。"]]},{"verse":8,"text":"彼らのうちの十人がイシュマエルに、「私たちを殺さないでください。私たちは、小麦、大麦、油、蜜を畑に隠していますから」と言ったので、彼は、彼らをその仲間とともに殺すのはやめた。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["十人","じゅうにん"],["が"],["イシュマエル"],["に"],["、"],["「"],["私たち","わたしたち"],["を"],["殺さないで","ころさないで"],["ください"],["。"],["私たち","わたしたち"],["は"],["、"],["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["油","あぶら"],["、"],["蜜","みつ"],["を"],["畑","はたけ"],["に"],["隠して","かくして"],["います"],["から"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["は"],["、"],["彼","かれ"],["ら"],["を"],["その"],["仲間","なかま"],["と"],["とも"],["に"],["殺す","ころす"],["の"],["は"],["やめた"],["。"]]},{"verse":9,"text":"イシュマエルが打ち殺した、ゲダルヤの指揮下の人たちのすべての死体を投げ入れた穴は、アサ王がイスラエルの王バシャを恐れて作ったものであった。ネタヌヤの子イシュマエルはそれを、殺された者で満たした。","tok":[["イシュマエル"],["が"],["打ち殺した","うちころした"],["、"],["ゲダルヤ"],["の"],["指揮下","しきか"],["の"],["人","ひと"],["たち"],["の"],["すべて"],["の"],["死体","したい"],["を"],["投げ入れた","なげいれた"],["穴","あな"],["は"],["、"],["アサ"],["王","おう"],["が"],["イスラエル"],["の"],["王","おう"],["バシャ"],["を"],["恐れて","おそれて"],["作った","つくった"],["もの"],["で"],["あった"],["。"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["それ"],["を"],["、"],["殺された","ころされた"],["者","もの"],["で"],["満たした","みたした"],["。"]]},{"verse":10,"text":"イシュマエルは、ミツパに残っていたすべての民、すなわち王の娘たちと、侍従長ネブザルアダンがアヒカムの子ゲダルヤにゆだねた、ミツパに残っていたすべての民とをとりこにした。ネタヌヤの子イシュマエルは彼らをとりこにして、アモン人のところに渡ろうとして出かけて行った。","tok":[["イシュマエル"],["は"],["、"],["ミツパ"],["に"],["残って","のこって"],["いた"],["すべて"],["の"],["民","たみ"],["、"],["すなわち"],["王","おう"],["の"],["娘","むすめ"],["たち"],["と"],["、"],["侍従長","じじゅうちょう"],["ネブザルアダン"],["が"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["に"],["ゆだねた"],["、"],["ミツパ"],["に"],["残って","のこって"],["いた"],["すべて"],["の"],["民","たみ"],["と"],["を"],["とりこ"],["に"],["した"],["。"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["彼","かれ"],["ら"],["を"],["とりこ"],["に"],["して"],["、"],["アモン人","あもんにん"],["の"],["ところ"],["に"],["渡ろう","わたろう"],["として"],["出かけて","でかけて"],["行った","いった"],["。"]]},{"verse":11,"text":"カレアハの子ヨハナンと、彼とともにいたすべての将校は、ネタヌヤの子イシュマエルが行ったすべての悪を聞いたので、","tok":[["カレアハ"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["すべて"],["の"],["将校","しょうこう"],["は"],["、"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["が"],["行った","おこなった"],["すべて"],["の"],["悪","あく"],["を"],["聞いた","きいた"],["ので"],["、"]]},{"verse":12,"text":"部下をみな連れて、ネタヌヤの子イシュマエルと戦うために出て行き、ギブオンにある大池のほとりで彼を見つけた。","tok":[["部下","ぶか"],["を"],["みな"],["連れて","つれて"],["、"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["と"],["戦う","たたかう"],["ため"],["に"],["出て","でて"],["行き","いき"],["、"],["ギブオン"],["に"],["ある"],["大池","おおいけ"],["の"],["ほとり"],["で"],["彼","かれ"],["を"],["見つけた","みつけた"],["。"]]},{"verse":13,"text":"イシュマエルとともにいたすべての民は、カレアハの子ヨハナンと、彼とともにいるすべての将校を見て喜んだ。","tok":[["イシュマエル"],["と"],["とも"],["に"],["いた"],["すべて"],["の"],["民","たみ"],["は"],["、"],["カレアハ"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["すべて"],["の"],["将校","しょうこう"],["を"],["見て","みて"],["喜んだ","よろこんだ"],["。"]]},{"verse":14,"text":"イシュマエルがミツパからとりこにして来たすべての民は身を翻して、カレアハの子ヨハナンのもとに帰って行った。","tok":[["イシュマエル"],["が"],["ミツパ"],["から"],["とりこ"],["に"],["して"],["来た","きた"],["すべて"],["の"],["民","たみ"],["は"],["身","み"],["を"],["翻して","ひるがえして"],["、"],["カレアハ"],["の"],["子","こ"],["ヨハナン"],["の"],["もと"],["に"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":15,"text":"ネタヌヤの子イシュマエルは、八人の者とともにヨハナンの前をのがれて、アモン人のところへ行った。","tok":[["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["、"],["八人","はちにん"],["の"],["者","もの"],["と"],["とも"],["に"],["ヨハナン"],["の"],["前","まえ"],["を"],["のがれて"],["、"],["アモン人","あもんにん"],["の"],["ところ"],["へ"],["行った","いった"],["。"]]},{"verse":16,"text":"カレアハの子ヨハナンと、彼とともにいたすべての将校は、ネタヌヤの子イシュマエルがアヒカムの子ゲダルヤを打ち殺して後、ミツパから、ネタヌヤの子イシュマエルから取り返したすべての残りの民、すなわちギブオンから連れ帰った勇士たち、戦士たち、女たち、子どもたち、および宦官たちを連れて、","tok":[["カレアハ"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["すべて"],["の"],["将校","しょうこう"],["は"],["、"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["が"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["を"],["打ち殺して","うちころして"],["後","あと"],["、"],["ミツパ"],["から"],["、"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["から"],["取り返した","とりかえした"],["すべて"],["の"],["残り","のこり"],["の"],["民","たみ"],["、"],["すなわち"],["ギブオン"],["から"],["連れ帰った","つれかえった"],["勇士","ゆうし"],["たち"],["、"],["戦士","せんし"],["たち"],["、"],["女","おんな"],["たち"],["、"],["子ども","こども"],["たち"],["、"],["および"],["宦官","かんがん"],["たち"],["を"],["連れて","つれて"],["、"]]},{"verse":17,"text":"エジプトに行こうとして、ベツレヘムのかたわらにあるゲルテ・キムハムへ行って、そこにとどまった。","tok":[["エジプト"],["に"],["行こう","いこう"],["として"],["、"],["ベツレヘム"],["の"],["かたわら"],["に"],["ある"],["ゲルテ"],["・"],["キムハム"],["へ"],["行って","いって"],["、"],["そこ"],["に"],["とどまった"],["。"]]},{"verse":18,"text":"それは、バビロンの王がこの国の総督としたアヒカムの子ゲダルヤをネタヌヤの子イシュマエルが打ち殺したので、カルデヤ人を恐れて、彼らから逃げるためであった。","tok":[["それ"],["は"],["、"],["バビロン"],["の"],["王","おう"],["が"],["この"],["国","くに"],["の"],["総督","そうとく"],["と"],["した"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["を"],["ネタヌヤ"],["の"],["子","こ"],["イシュマエル"],["が"],["打ち殺した","うちころした"],["ので"],["、"],["カルデヤ"],["人","ひと"],["を"],["恐れて","おそれて"],["、"],["彼","かれ"],["ら"],["から"],["逃げる","にげる"],["ため"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"バビロンの王ネブカデレザルが、エホヤキムの子、ユダの王エコヌヤと、ユダのつかさたちや、職人や、鍛冶屋をエルサレムから捕らえ移し、バビロンに連れて行って後、主は私に示された。見ると、主の宮の前に、二かごのいちじくが置かれている。","tok":[["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["、"],["エホヤキム"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エコヌヤ"],["と"],["、"],["ユダ"],["の"],["つかさ"],["たち"],["や"],["、"],["職人","しょくにん"],["や"],["、"],["鍛冶屋","かじや"],["を"],["エルサレム"],["から"],["捕らえ","とらえ"],["移し","うつし"],["、"],["バビロン"],["に"],["連れて","つれて"],["行って","いって"],["後","あと"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["示された","しめされた"],["。"],["見る","みる"],["と"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["前","まえ"],["に"],["、"],["二","に"],["かご"],["の"],["いちじく"],["が"],["置かれて","おかれて"],["いる"],["。"]]},{"verse":2,"text":"一つのかごのは非常に良いいちじくで、初なりのいちじくの実のようであり、もう一つのかごのは非常に悪いいちじくで、悪くて食べられないものである。","tok":[["一","ひと"],["つ"],["の"],["かご"],["の"],["は"],["非常","ひじょう"],["に"],["良い","よい"],["いちじく"],["で"],["、"],["初なり","はつなり"],["の"],["いちじく"],["の"],["実","じつ"],["の"],["よう"],["で"],["あり"],["、"],["もう"],["一","ひと"],["つ"],["の"],["かご"],["の"],["は"],["非常","ひじょう"],["に"],["悪い","わるい"],["いちじく"],["で"],["、"],["悪くて","わるくて"],["食べられない","たべられない"],["もの"],["で"],["ある"],["。"]]},{"verse":3,"text":"そのとき、主が私に、「エレミヤ。あなたは何を見ているのか」と言われたので、私は言った。「いちじくです。良いいちじくは非常に良く、悪いのは非常に悪く、悪くて食べられないものです。」","tok":[["その"],["とき"],["、"],["主","ぬし"],["が"],["私","わたくし"],["に"],["、"],["「"],["エレミヤ"],["。"],["あなた"],["は"],["何","なん"],["を"],["見て","みて"],["いる"],["の"],["か"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["いちじく"],["です"],["。"],["良い","よい"],["いちじく"],["は"],["非常","ひじょう"],["に"],["良く","よく"],["、"],["悪い","わるい"],["の"],["は"],["非常","ひじょう"],["に"],["悪く","わるく"],["、"],["悪くて","わるくて"],["食べられない","たべられない"],["もの"],["です"],["。"],["」"]]},{"verse":4,"text":"すると、私に次のような主のことばがあった。","tok":[["する"],["と"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":5,"text":"「イスラエルの神、主は、こう仰せられる。この良いいちじくのように、わたしは、この所からカルデヤ人の地に送ったユダの捕囚の民を良いものにしようと思う。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["この"],["良い","よい"],["いちじく"],["の"],["よう"],["に"],["、"],["わたし"],["は"],["、"],["この"],["所","ところ"],["から"],["カルデヤ"],["人","にん"],["の"],["地","ち"],["に"],["送った","おくった"],["ユダ"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["を"],["良い","よい"],["もの"],["に"],["しよう"],["と"],["思う","おもう"],["。"]]},{"verse":6,"text":"わたしは、良くするために彼らに目をかけて、彼らをこの国に帰らせ、彼らを建て直し、倒れないように植えて、もう引き抜かない。","tok":[["わたし"],["は"],["、"],["良く","よく"],["する"],["ため"],["に"],["彼","かれ"],["ら"],["に"],["目","め"],["を"],["かけて"],["、"],["彼","かれ"],["ら"],["を"],["この"],["国","くに"],["に"],["帰らせ","かえらせ"],["、"],["彼","かれ"],["ら"],["を"],["建て直し","たてなおし"],["、"],["倒れない","たおれない"],["よう"],["に"],["植えて","うえて"],["、"],["もう"],["引き抜かない","ひきぬかない"],["。"]]},{"verse":7,"text":"また、わたしは彼らに、わたしが主であることを知る心を与える。彼らはわたしの民となり、わたしは彼らの神となる。彼らが心を尽くしてわたしに立ち返るからである。","tok":[["また"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["心","こころ"],["を"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"],["彼","かれ"],["ら"],["が"],["心","こころ"],["を"],["尽くして","つくして"],["わたし"],["に"],["立ち返る","たちかえる"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"しかし、悪くて食べられないあの悪いいちじくのように、――まことに主はこう仰せられる――わたしは、ユダの王ゼデキヤと、そのつかさたち、エルサレムの残りの者と、この国に残されている者、およびエジプトの国に住みついている者とを、このようにする。","tok":[["しかし"],["、"],["悪くて","わるくて"],["食べられない","たべられない"],["あの"],["悪い","わるい"],["いちじく"],["の"],["よう"],["に"],["、"],["―"],["―"],["まこと"],["に"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["―"],["―"],["わたし"],["は"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["と"],["、"],["その"],["つかさ"],["たち"],["、"],["エルサレム"],["の"],["残り","のこり"],["の"],["者","もの"],["と"],["、"],["この"],["国","くに"],["に"],["残されて","のこされて"],["いる"],["者","もの"],["、"],["および"],["エジプト"],["の"],["国","くに"],["に"],["住みついて","すみついて"],["いる"],["者","もの"],["と"],["を"],["、"],["この"],["よう"],["に"],["する"],["。"]]},{"verse":9,"text":"わたしは彼らを地のすべての王国のおののき、悩みとし、また、わたしが追い散らすすべての所で、そしり、物笑いの種、なぶりもの、のろいとする。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["地","ち"],["の"],["すべて"],["の"],["王国","おうこく"],["の"],["おののき"],["、"],["悩み","なやみ"],["と"],["し"],["、"],["また"],["、"],["わたし"],["が"],["追い散らす","おいちらす"],["すべて"],["の"],["所","ところ"],["で"],["、"],["そしり"],["、"],["物笑い","ものわらい"],["の"],["種","しゅ"],["、"],["なぶりもの"],["、"],["のろい"],["と"],["する"],["。"]]},{"verse":10,"text":"わたしは彼らのうちに、剣と、ききんと、疫病を送り、彼らとその先祖に与えた地から彼らを滅ぼし尽くす。」","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["、"],["剣","けん"],["と"],["、"],["ききん"],["と"],["、"],["疫病","やくびょう"],["を"],["送り","おくり"],["、"],["彼","かれ"],["ら"],["と"],["その"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["地","ち"],["から"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"],["」"]]}]
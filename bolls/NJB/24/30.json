[{"verse":1,"text":"主からエレミヤにあったみことばは、次のとおりである。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"イスラエルの神、主はこう仰せられる。「わたしがあなたに語ったことばをみな、書物に書きしるせ。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["わたし"],["が"],["あなた"],["に"],["語った","かたった"],["ことば"],["を"],["みな"],["、"],["書物","しょもつ"],["に"],["書きしるせ","かきしるせ"],["。"]]},{"verse":3,"text":"見よ。その日が来る。――主の御告げ――その日、わたしは、わたしの民イスラエルとユダの繁栄を元どおりにすると、主は言う。わたしは彼らをその先祖たちに与えた地に帰らせる。彼らはそれを所有する。」","tok":[["見","み"],["よ"],["。"],["その"],["日","ひ"],["が"],["来る","くる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["と"],["ユダ"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["する"],["と"],["、"],["主","ぬし"],["は"],["言う","ゆう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["その"],["先祖","せんぞ"],["たち"],["に"],["与えた","あたえた"],["地","ち"],["に"],["帰らせる","かえらせる"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["所有","しょゆう"],["する"],["。"],["」"]]},{"verse":4,"text":"主がイスラエルとユダについて語られたことばは次のとおりである。","tok":[["主","ぬし"],["が"],["イスラエル"],["と"],["ユダ"],["について"],["語られた","かたられた"],["ことば"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":5,"text":"まことに主はこう仰せられる。／「おののきの声を、われわれは聞いた。／恐怖があって平安はない。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["お"],["の"],["のき"],["の"],["声","こえ"],["を"],["、"],["われわれ"],["は"],["聞いた","きいた"],["。"],["／"],["恐怖","きょうふ"],["が"],["あって"],["平安","へいあん"],["は"],["ない"],["。"]]},{"verse":6,"text":"男が子を産めるか、さあ、尋ねてみよ。／わたしが見るのに、なぜ、男がみな、産婦のように／腰に手を当てているのか。／なぜ、みなの顔が青く変わっているのか。","tok":[["男","おとこ"],["が"],["子","こ"],["を"],["産める","うめる"],["か"],["、"],["さあ"],["、"],["尋ねて","たずねて"],["み"],["よ"],["。"],["／"],["わたし"],["が"],["見る","みる"],["のに"],["、"],["なぜ"],["、"],["男","おとこ"],["が"],["みな"],["、"],["産婦","さんぷ"],["の"],["よう"],["に"],["／"],["腰","こし"],["に"],["手","て"],["を"],["当てて","あてて"],["いる"],["の"],["か"],["。"],["／"],["なぜ"],["、"],["みな"],["の"],["顔","かお"],["が"],["青く","あおく"],["変わって","かわって"],["いる"],["の"],["か"],["。"]]},{"verse":7,"text":"ああ。／その日は大いなる日、比べるものもない日だ。／それはヤコブにも苦難の時だ。／しかし彼はそれから救われる。","tok":[["ああ"],["。"],["／"],["その"],["日","ひ"],["は"],["大いなる","おおいなる"],["日","ひ"],["、"],["比べる","くらべる"],["もの"],["も"],["ない"],["日","ひ"],["だ"],["。"],["／"],["それ"],["は"],["ヤコブ"],["に"],["も"],["苦難","くなん"],["の"],["時","とき"],["だ"],["。"],["／"],["しかし"],["彼","かれ"],["は"],["それ"],["から"],["救われる","すくわれる"],["。"]]},{"verse":8,"text":"その日になると、――万軍の主の御告げ――わたしは彼らの首のくびきを砕き、彼らのなわめを解く。他国人は二度と彼らを奴隷にしない。","tok":[["その"],["日","ひ"],["に"],["なる"],["と"],["、"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["首","くび"],["の"],["くびき"],["を"],["砕き","くだき"],["、"],["彼","かれ"],["ら"],["の"],["なわ"],["め"],["を"],["解く","とく"],["。"],["他国人","たこくにん"],["は"],["二","に"],["度","ど"],["と"],["彼","かれ"],["ら"],["を"],["奴隷","どれい"],["に"],["しない"],["。"]]},{"verse":9,"text":"彼らは彼らの神、主と、わたしが彼らのために立てる彼らの王ダビデに仕えよう。","tok":[["彼","かれ"],["ら"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["と"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["立てる","たてる"],["彼","かれ"],["ら"],["の"],["王","おう"],["ダビデ"],["に"],["仕えよう","つかえよう"],["。"]]},{"verse":10,"text":"わたしのしもべヤコブよ。恐れるな。／――主の御告げ――／イスラエルよ。おののくな。／見よ。わたしが、あなたを遠くから、あなたの子孫を捕囚の地から、救うからだ。／ヤコブは帰って来て、平穏に安らかに生き、おびえさせる者はだれもいない。","tok":[["わたし"],["の"],["しもべ"],["ヤコブ"],["よ"],["。"],["恐れる","おそれる"],["な"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["イスラエル"],["よ"],["。"],["おののく"],["な"],["。"],["／"],["見","み"],["よ"],["。"],["わたし"],["が"],["、"],["あなた"],["を"],["遠く","とおく"],["から"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["捕囚","ほしゅう"],["の"],["地","ち"],["から"],["、"],["救う","すくう"],["から"],["だ"],["。"],["／"],["ヤコブ"],["は"],["帰って","かえって"],["来て","きて"],["、"],["平穏","へいおん"],["に"],["安らか","やすらか"],["に"],["生き","いき"],["、"],["おびえ"],["させる"],["者","もの"],["は"],["だれ"],["も"],["いない"],["。"]]},{"verse":11,"text":"わたしがあなたとともにいて、――主の御告げ――／あなたを救うからだ。／わたしは、あなたを散らした先の／すべての国々を滅ぼし尽くすからだ。／しかし、わたしはあなたを滅ぼし尽くさない。／公義によって、あなたを懲らしめ、あなたを罰せずにおくことは決してないが。」","tok":[["わたし"],["が"],["あなた"],["と"],["とも"],["に"],["いて"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["あなた"],["を"],["救う","すくう"],["から"],["だ"],["。"],["／"],["わたし"],["は"],["、"],["あなた"],["を"],["散らした","ちらした"],["先","さき"],["の"],["／"],["すべて"],["の"],["国々","くにぐに"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["から"],["だ"],["。"],["／"],["しかし"],["、"],["わたし"],["は"],["あなた"],["を"],["滅ぼし","ほろぼし"],["尽くさない","つくさない"],["。"],["／"],["公義","きみよし"],["によって"],["、"],["あなた"],["を"],["懲らしめ","こらしめ"],["、"],["あなた"],["を"],["罰せず","ばっせず"],["に"],["おく"],["こと"],["は"],["決して","けっして"],["ない"],["が"],["。"],["」"]]},{"verse":12,"text":"まことに主はこう仰せられる。／「あなたの傷はいやしにくく、あなたの打ち傷は痛んでいる。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["あなた"],["の"],["傷","きず"],["は"],["いやし"],["にくく"],["、"],["あなた"],["の"],["打ち傷","うちきず"],["は"],["痛んで","いたんで"],["いる"],["。"]]},{"verse":13,"text":"あなたの訴えを弁護する者もなく、はれものに薬をつけて、あなたをいやす者もいない。","tok":[["あなた"],["の"],["訴え","うったえ"],["を"],["弁護","べんご"],["する"],["者","もの"],["も"],["なく"],["、"],["はれもの"],["に"],["薬","くすり"],["を"],["つけて"],["、"],["あなた"],["を"],["いやす"],["者","もの"],["も"],["いない"],["。"]]},{"verse":14,"text":"あなたの恋人はみな、あなたを忘れ、あなたを尋ねようともしない。／わたしが、敵を打つようにあなたを打ち、ひどい懲らしめをしたからだ。／あなたの咎が大きく、あなたの罪が重いために。","tok":[["あなた"],["の"],["恋人","こいびと"],["は"],["みな"],["、"],["あなた"],["を"],["忘れ","わすれ"],["、"],["あなた"],["を"],["尋ねよう","たずねよう"],["と"],["も"],["しない"],["。"],["／"],["わたし"],["が"],["、"],["敵","てき"],["を"],["打つ","うつ"],["よう"],["に"],["あなた"],["を"],["打ち","うち"],["、"],["ひどい"],["懲らしめ","こらしめ"],["を"],["した"],["から"],["だ"],["。"],["／"],["あなた"],["の"],["咎","とが"],["が"],["大きく","おおきく"],["、"],["あなた"],["の"],["罪","つみ"],["が"],["重い","おもい"],["ため"],["に"],["。"]]},{"verse":15,"text":"なぜ、あなたは自分の傷のために叫ぶのか。／あなたの痛みは直らないのか。／あなたの咎が大きく、あなたの罪が重いため、わたしはこれらの事を、あなたにしたのだ。","tok":[["なぜ"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["傷","きず"],["の"],["ため"],["に"],["叫ぶ","さけぶ"],["の"],["か"],["。"],["／"],["あなた"],["の"],["痛み","いたみ"],["は"],["直らない","なおらない"],["の"],["か"],["。"],["／"],["あなた"],["の"],["咎","とが"],["が"],["大きく","おおきく"],["、"],["あなた"],["の"],["罪","つみ"],["が"],["重い","おもい"],["ため"],["、"],["わたし"],["は"],["これ"],["ら"],["の"],["事","こと"],["を"],["、"],["あなた"],["に"],["した"],["の"],["だ"],["。"]]},{"verse":16,"text":"しかし、あなたを食う者はみな、かえって食われ、あなたの敵はみな、とりことなって行き、あなたから略奪した者は、略奪され、あなたをかすめ奪った者は、わたしがみな獲物として与える。","tok":[["しかし"],["、"],["あなた"],["を"],["食う","くう"],["者","もの"],["は"],["みな"],["、"],["かえって"],["食われ","くわれ"],["、"],["あなた"],["の"],["敵","てき"],["は"],["みな"],["、"],["とりこ"],["と"],["なって"],["行き","いき"],["、"],["あなた"],["から"],["略奪","りゃくだつ"],["した"],["者","もの"],["は"],["、"],["略奪","りゃくだつ"],["され"],["、"],["あなた"],["を"],["かすめ"],["奪った","うばった"],["者","もの"],["は"],["、"],["わたし"],["が"],["みな"],["獲物","えもの"],["として"],["与える","あたえる"],["。"]]},{"verse":17,"text":"わたしがあなたの傷を直し、あなたの打ち傷をいやすからだ。／――主の御告げ――／あなたが、捨てられた女、だれも尋ねて来ないシオン、と呼ばれたからだ。」","tok":[["わたし"],["が"],["あなた"],["の"],["傷","きず"],["を"],["直し","なおし"],["、"],["あなた"],["の"],["打ち傷","うちきず"],["を"],["いやす"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["あなた"],["が"],["、"],["捨てられた","すてられた"],["女","おんな"],["、"],["だれ"],["も"],["尋ねて","たずねて"],["来ない","こない"],["シオン"],["、"],["と"],["呼ばれた","よばれた"],["から"],["だ"],["。"],["」"]]},{"verse":18,"text":"主はこう仰せられる。／「見よ。／わたしはヤコブの天幕の繁栄を元どおりにし、その住まいをあわれもう。／町はその廃墟の上に建て直され、宮殿は、その定められている所に建つ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["見","み"],["よ"],["。"],["／"],["わたし"],["は"],["ヤコブ"],["の"],["天幕","てんまく"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["し"],["、"],["その"],["住まい","すまい"],["を"],["あわれもう"],["。"],["／"],["町","まち"],["は"],["その"],["廃墟","はいきょ"],["の"],["上","うえ"],["に"],["建て直され","たてなおされ"],["、"],["宮殿","きゅうでん"],["は"],["、"],["その"],["定められて","さだめられて"],["いる"],["所","ところ"],["に"],["建つ","たつ"],["。"]]},{"verse":19,"text":"彼らの中から、感謝と、喜び笑う声がわき出る。／わたしは人をふやして減らさず、彼らを尊くして、軽んじられないようにする。","tok":[["彼","かれ"],["ら"],["の"],["中","なか"],["から"],["、"],["感謝","かんしゃ"],["と"],["、"],["喜び笑う","よろこびわらう"],["声","こえ"],["が"],["わき出る","わきでる"],["。"],["／"],["わたし"],["は"],["人","ひと"],["を"],["ふやして"],["減らさず","へらさず"],["、"],["彼","かれ"],["ら"],["を"],["尊く","とうとく"],["して"],["、"],["軽んじられない","かろんじられない"],["よう"],["に"],["する"],["。"]]},{"verse":20,"text":"その子たちは昔のようになり、その会衆はわたしの前で堅く立てられる。／わたしはこれを圧迫する者をみな罰する。","tok":[["その"],["子","こ"],["たち"],["は"],["昔","むかし"],["の"],["よう"],["に"],["なり"],["、"],["その"],["会衆","かいしゅう"],["は"],["わたし"],["の"],["前","まえ"],["で"],["堅く","かたく"],["立てられる","たてられる"],["。"],["／"],["わたし"],["は"],["これ"],["を"],["圧迫","あっぱく"],["する"],["者","もの"],["を"],["みな"],["罰する","ばっする"],["。"]]},{"verse":21,"text":"その権力者は、彼らのうちのひとり、その支配者はその中から出る。／わたしは彼を近づけ、彼はわたしに近づく。／わたしに近づくためにいのちをかける者は、いったいだれなのか。――主の御告げ――","tok":[["その"],["権力者","けんりょくしゃ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["ひとり"],["、"],["その"],["支配者","しはいしゃ"],["は"],["その"],["中","なか"],["から"],["出る","でる"],["。"],["／"],["わたし"],["は"],["彼","かれ"],["を"],["近づけ","ちかづけ"],["、"],["彼","かれ"],["は"],["わたし"],["に"],["近づく","ちかづく"],["。"],["／"],["わたし"],["に"],["近づく","ちかづく"],["ため"],["に"],["いのち"],["を"],["かける"],["者","もの"],["は"],["、"],["いったい"],["だれ"],["な"],["の"],["か"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":22,"text":"あなたがたはわたしの民となり、わたしはあなたがたの神となる。」","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["。"],["」"]]},{"verse":23,"text":"見よ。主の暴風、――憤り――／吹きつける暴風が起こり、悪者の頭上にうずを巻く。","tok":[["見","み"],["よ"],["。"],["主","ぬし"],["の"],["暴風","ぼうふう"],["、"],["―"],["―"],["憤り","いきどおり"],["―"],["―"],["／"],["吹きつける","ふきつける"],["暴風","ぼうふう"],["が"],["起こり","おこり"],["、"],["悪者","わるもの"],["の"],["頭上","ずじょう"],["に"],["うず"],["を"],["巻く","まく"],["。"]]},{"verse":24,"text":"主の燃える怒りは、御心の思うところを行って、成し遂げるまで／去ることはない。／終わりの日に、あなたがたはそれを悟ろう。","tok":[["主","ぬし"],["の"],["燃える","もえる"],["怒り","いかり"],["は"],["、"],["御心","おこころ"],["の"],["思う","おもう"],["ところ"],["を"],["行って","おこなって"],["、"],["成し遂げる","なしとげる"],["まで"],["／"],["去る","さる"],["こと"],["は"],["ない"],["。"],["／"],["終わり","おわり"],["の"],["日","ひ"],["に"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["悟ろう","さとろう"],["。"]]}]
[{"verse":1,"text":"ああ、私の頭が水であったなら、私の目が涙の泉であったなら、私は昼も夜も、私の娘、私の民の殺された者のために／泣こうものを。","tok":[["ああ"],["、"],["私","わたくし"],["の"],["頭","あたま"],["が"],["水","みず"],["で"],["あったなら"],["、"],["私","わたくし"],["の"],["目","め"],["が"],["涙","なみだ"],["の"],["泉","いずみ"],["で"],["あったなら"],["、"],["私","わたくし"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["、"],["私","わたくし"],["の"],["娘","むすめ"],["、"],["私","わたくし"],["の"],["民","たみ"],["の"],["殺された","ころされた"],["者","もの"],["の"],["ため"],["に"],["／"],["泣こう","なこう"],["もの"],["を"],["。"]]},{"verse":2,"text":"ああ、私が荒野に旅人の宿を持っていたなら、私の民を見捨てて、彼らから離れることができようものを。／彼らはみな姦通者、裏切り者の集会だから。","tok":[["ああ"],["、"],["私","わたくし"],["が"],["荒野","あらの"],["に"],["旅人","たびびと"],["の"],["宿","やど"],["を"],["持って","もって"],["いたなら"],["、"],["私","わたくし"],["の"],["民","たみ"],["を"],["見捨てて","みすてて"],["、"],["彼","かれ"],["ら"],["から"],["離れる","はなれる"],["こと"],["が"],["できよう"],["もの"],["を"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["姦通者","かんつうしゃ"],["、"],["裏切り者","うらぎりしゃ"],["の"],["集会","しゅうかい"],["だ"],["から"],["。"]]},{"verse":3,"text":"彼らは舌を弓のように曲げ、真実でなく、偽りをもって、地にはびこる。／まことに彼らは、悪から悪へ進み、わたしを知らない。――主の御告げ――","tok":[["彼","かれ"],["ら"],["は"],["舌","した"],["を"],["弓","ゆみ"],["の"],["よう"],["に"],["曲げ","まげ"],["、"],["真実","しんじつ"],["で"],["なく"],["、"],["偽り","いつわり"],["を"],["もって"],["、"],["地","ち"],["に"],["はびこる"],["。"],["／"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["、"],["悪","わる"],["から"],["悪","あく"],["へ"],["進み","すすみ"],["、"],["わたし"],["を"],["知らない","しらない"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":4,"text":"おのおの互いに警戒せよ。／どの兄弟も信用するな。／どの兄弟も人を押しのけ、どの友も中傷して歩き回るからだ。","tok":[["おのおの"],["互い","たがい"],["に"],["警戒","けいかい"],["せよ"],["。"],["／"],["どの"],["兄弟","きょうだい"],["も"],["信用","しんよう"],["する"],["な"],["。"],["／"],["どの"],["兄弟","きょうだい"],["も"],["人","ひと"],["を"],["押しのけ","おしのけ"],["、"],["どの"],["友","とも"],["も"],["中傷","ちゅうしょう"],["して"],["歩き回る","あるきまわる"],["から"],["だ"],["。"]]},{"verse":5,"text":"彼らはおのおの、だまし合って、真実を語らない。／偽りを語ることを舌に教え、悪事を働き、依然として悔い改めない。","tok":[["彼","かれ"],["ら"],["は"],["おのおの"],["、"],["だまし"],["合って","あって"],["、"],["真実","しんじつ"],["を"],["語らない","かたらない"],["。"],["／"],["偽り","いつわり"],["を"],["語る","かたる"],["こと"],["を"],["舌","した"],["に"],["教え","おしえ"],["、"],["悪事","あくじ"],["を"],["働き","はたらき"],["、"],["依然","いぜん"],["として"],["悔い改めない","くいあらためない"],["。"]]},{"verse":6,"text":"彼らはしいたげに、しいたげを重ね、欺きに欺きを重ねて、わたしを知ろうともしなかった。／――主の御告げ――","tok":[["彼","かれ"],["ら"],["は"],["しいたげ"],["に"],["、"],["しいたげ"],["を"],["重ね","かさね"],["、"],["欺き","あざむき"],["に"],["欺き","あざむき"],["を"],["重ねて","かさねて"],["、"],["わたし"],["を"],["知ろう","しろう"],["と"],["も"],["しなかった"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":7,"text":"それゆえ、万軍の主はこう仰せられる。／「見よ。わたしは彼らを溶かしてためす。／いったい、わたしの民の娘に対し、ほかに何ができようか。","tok":[["それ"],["ゆえ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["溶かして","とかして"],["ためす"],["。"],["／"],["いったい"],["、"],["わたし"],["の"],["民","たみ"],["の"],["娘","むすめ"],["に"],["対し","たいし"],["、"],["ほか"],["に"],["何","なん"],["が"],["できよう"],["か"],["。"]]},{"verse":8,"text":"彼らの舌はとがった矢で、欺きを語る。／口先では友人に平和を語るが、腹の中では待ち伏せを計る。","tok":[["彼","かれ"],["ら"],["の"],["舌","した"],["は"],["とがった"],["矢","や"],["で"],["、"],["欺き","あざむき"],["を"],["語る","かたる"],["。"],["／"],["口先","くちさき"],["で"],["は"],["友人","ゆうじん"],["に"],["平和","へいわ"],["を"],["語る","かたる"],["が"],["、"],["腹","はら"],["の"],["中","なか"],["で"],["は"],["待ち伏せ","まちぶせ"],["を"],["計る","はかる"],["。"]]},{"verse":9,"text":"これらのために、わたしは彼らを罰しないだろうか。／――主の御告げ――／このような国に対して、わたしが復讐しないだろうか。」","tok":[["これ"],["ら"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["罰しないだろう","ばっしないだろう"],["か"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["この"],["よう"],["な"],["国","くに"],["に対して","にたいして"],["、"],["わたし"],["が"],["復讐","ふくしゅう"],["しないだろう"],["か"],["。"],["」"]]},{"verse":10,"text":"私は山々のために泣き声をあげて嘆き、荒野の牧草地のために哀歌を唱える。／そこは、焼き払われて通る人もなく、群れの声も聞こえず、空の鳥から家畜まで、みな逃げ去っているからだ。","tok":[["私","わたくし"],["は"],["山々","やまやま"],["の"],["ため"],["に"],["泣き声","なきごえ"],["を"],["あげて"],["嘆き","なげき"],["、"],["荒野","こうや"],["の"],["牧草地","ぼくそうち"],["の"],["ため"],["に"],["哀歌","あいか"],["を"],["唱える","となえる"],["。"],["／"],["そこ"],["は"],["、"],["焼き払われて","やきはらわれて"],["通る","とおる"],["人","ひと"],["も"],["なく"],["、"],["群れ","むれ"],["の"],["声","こえ"],["も"],["聞こえず","きこえず"],["、"],["空","そら"],["の"],["鳥","とり"],["から"],["家畜","かちく"],["まで"],["、"],["みな"],["逃げ去って","にげさって"],["いる"],["から"],["だ"],["。"]]},{"verse":11,"text":"わたしはエルサレムを石くれの山とし、ジャッカルの住みかとする。／ユダの町々を荒れ果てさせ、住む者もなくする。","tok":[["わたし"],["は"],["エルサレム"],["を"],["石くれ","いしくれ"],["の"],["山","やま"],["と"],["し"],["、"],["ジャッカル"],["の"],["住みか","すみか"],["と"],["する"],["。"],["／"],["ユダ"],["の"],["町々","まちまち"],["を"],["荒れ果てさせ","あれはてさせ"],["、"],["住む","すむ"],["者","もの"],["も"],["なく"],["する"],["。"]]},{"verse":12,"text":"知恵があって、これを悟ることのできる者はだれか。／主の御口が語られたことを／告げ知らせることのできる者はだれか。／どうしてこの国は滅びたのか。／どうして荒野のように焼き払われて、通る人もないのか。","tok":[["知恵","ちえ"],["が"],["あって"],["、"],["これ"],["を"],["悟る","さとる"],["こと"],["の"],["できる"],["者","もの"],["は"],["だれ"],["か"],["。"],["／"],["主","ぬし"],["の"],["御口","おくち"],["が"],["語られた","かたられた"],["こと"],["を"],["／"],["告げ知らせる","つげしらせる"],["こと"],["の"],["できる"],["者","もの"],["は"],["だれ"],["か"],["。"],["／"],["どう"],["して"],["この"],["国","くに"],["は"],["滅びた","ほろびた"],["の"],["か"],["。"],["／"],["どう"],["して"],["荒野","こうや"],["の"],["よう"],["に"],["焼き払われて","やきはらわれて"],["、"],["通る","とおる"],["人","ひと"],["も"],["ない"],["の"],["か"],["。"]]},{"verse":13,"text":"主は仰せられる。「彼らは、わたしが彼らの前に与えたわたしの律法を捨て、わたしの声に聞き従わず、それに歩まず、","tok":[["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["「"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["与えた","あたえた"],["わたし"],["の"],["律法","りっぽう"],["を"],["捨て","すて"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["それ"],["に"],["歩まず","あゆまず"],["、"]]},{"verse":14,"text":"彼らのかたくなな心のままに歩み、先祖たちが彼らに教えたバアルに従って歩んだ。」","tok":[["彼","かれ"],["ら"],["の"],["かたくな"],["な"],["心","こころ"],["の"],["まま"],["に"],["歩み","あゆみ"],["、"],["先祖","せんぞ"],["たち"],["が"],["彼","かれ"],["ら"],["に"],["教えた","おしえた"],["バアル"],["に"],["従って","したがって"],["歩んだ","あゆんだ"],["。"],["」"]]},{"verse":15,"text":"それゆえ、イスラエルの神、万軍の主は、こう仰せられる。「見よ。わたしは、この民に、苦よもぎを食べさせ、毒の水を飲ませる。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["この"],["民","たみ"],["に"],["、"],["苦","く"],["よもぎ"],["を"],["食べさせ","たべさせ"],["、"],["毒","どく"],["の"],["水","みず"],["を"],["飲ませる","のませる"],["。"]]},{"verse":16,"text":"彼らも先祖たちも知らなかった国々に彼らを散らし、剣を彼らのうしろに送り、ついに彼らを絶滅させる。」","tok":[["彼","かれ"],["ら"],["も"],["先祖","せんぞ"],["たち"],["も"],["知らなかった","しらなかった"],["国々","くにぐに"],["に"],["彼","かれ"],["ら"],["を"],["散らし","ちらし"],["、"],["剣","けん"],["を"],["彼","かれ"],["ら"],["の"],["うしろ"],["に"],["送り","おくり"],["、"],["ついに"],["彼","かれ"],["ら"],["を"],["絶滅","ぜつめつ"],["させる"],["。"],["」"]]},{"verse":17,"text":"万軍の主はこう仰せられる。「よく考えて、泣き女を呼んで来させ、使いをやって巧みな女たちを連れて来させよ。」","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["よく"],["考えて","かんがえて"],["、"],["泣き女","なきおんな"],["を"],["呼んで","よんで"],["来させ","きさせ"],["、"],["使い","つかい"],["を"],["やって"],["巧み","たくみ"],["な"],["女","おんな"],["たち"],["を"],["連れて","つれて"],["来させよ","きさせよ"],["。"],["」"]]},{"verse":18,"text":"彼らをせきたて、私たちのために嘆きの声をあげさせ、私たちの目に涙をしたたらせ、私たちのまぶたに水をあふれさせよ。","tok":[["彼","かれ"],["ら"],["を"],["せきたて"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["嘆き","なげき"],["の"],["声","こえ"],["を"],["あげさせ"],["、"],["私たち","わたしたち"],["の"],["目","め"],["に"],["涙","なみだ"],["を"],["したたらせ"],["、"],["私たち","わたしたち"],["の"],["まぶた"],["に"],["水","みず"],["を"],["あふれさせ"],["よ"],["。"]]},{"verse":19,"text":"シオンから嘆きの声が聞こえるからだ。／ああ、私たちは踏みにじられ、いたく恥を見た。／私たちが国を見捨て、彼らが私たちの住まいを投げやったからだ。","tok":[["シオン"],["から"],["嘆き","なげき"],["の"],["声","こえ"],["が"],["聞こえる","きこえる"],["から"],["だ"],["。"],["／"],["ああ"],["、"],["私たち","わたしたち"],["は"],["踏みにじられ","ふみにじられ"],["、"],["いたく"],["恥","はじ"],["を"],["見た","みた"],["。"],["／"],["私たち","わたしたち"],["が"],["国","くに"],["を"],["見捨て","みすて"],["、"],["彼","かれ"],["ら"],["が"],["私たち","わたしたち"],["の"],["住まい","すまい"],["を"],["投げやった","なげやった"],["から"],["だ"],["。"]]},{"verse":20,"text":"女たちよ。主のことばを聞き、あなたがたの耳は、主の言われることばを受けとめよ。／あなたがたの娘に嘆きの歌を教え、隣の女にも哀歌を教えよ。","tok":[["女","おんな"],["たち"],["よ"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["聞き","きき"],["、"],["あなた"],["がた"],["の"],["耳","みみ"],["は"],["、
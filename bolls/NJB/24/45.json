[{"verse":1,"text":"ネリヤの子バルクが、ヨシヤの子、ユダの王エホヤキムの第四年に、エレミヤの口述によってこれらのことばを書物に書いたときに、預言者エレミヤが彼に語ったことばは、こうである。","tok":[["ネリヤ"],["の"],["子","こ"],["バルク"],["が"],["、"],["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["第","だい"],["四","よん"],["年","ねん"],["に"],["、"],["エレミヤ"],["の"],["口述","こうじゅつ"],["によって"],["これ"],["ら"],["の"],["ことば"],["を"],["書物","しょもつ"],["に"],["書いた","かいた"],["とき"],["に"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["が"],["彼","かれ"],["に"],["語った","かたった"],["ことば"],["は"],["、"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"「バルクよ。イスラエルの神、主は、あなたについてこう仰せられる。","tok":[["「"],["バルク"],["よ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["について"],["こう"],["仰せられる","おおせられる"],["。"]]},{"verse":3,"text":"あなたは言った。『ああ、哀れなこの私。主は私の痛みに悲しみを加えられた。私は嘆きで疲れ果て、いこいもない。』","tok":[["あなた"],["は"],["言った","いった"],["。"],["『"],["ああ"],["、"],["哀れ","あわれ"],["な"],["この"],["私","わたくし"],["。"],["主","ぬし"],["は"],["私","わたくし"],["の"],["痛み","いたみ"],["に"],["悲しみ","かなしみ"],["を"],["加えられた","くわえられた"],["。"],["私","わたくし"],["は"],["嘆き","なげき"],["で"],["疲れ","つかれ"],["果て","はて"],["、"],["いこい"],["も"],["ない"],["。"],["』"]]},{"verse":4,"text":"あなたが主にこう言うので、主はこう仰せられる。『見よ。わたしは自分が建てた物を自分でこわし、わたしが植えた物を自分で引き抜く。この全土をそうする。","tok":[["あなた"],["が"],["主に","おもに"],["こう"],["言う","いう"],["ので"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["自分","じぶん"],["が"],["建てた","たてた"],["物","もの"],["を"],["自分","じぶん"],["で"],["こわし"],["、"],["わたし"],["が"],["植えた","うえた"],["物","もの"],["を"],["自分","じぶん"],["で"],["引き抜く","ひきぬく"],["。"],["この"],["全土","ぜんど"],["を"],["そう"],["する"],["。"]]},{"verse":5,"text":"あなたは、自分のために大きなことを求めるのか。求めるな。見よ。わたしがすべての肉なる者に、わざわいを下すからだ。――主の御告げ――しかし、わたしは、あなたの行くどんな所ででも、あなたのいのちを分捕り物としてあなたに与える。』」","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["大きな","おおきな"],["こと"],["を"],["求める","もとめる"],["の"],["か"],["。"],["求める","もとめる"],["な"],["。"],["見","み"],["よ"],["。"],["わたし"],["が"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["に"],["、"],["わざわい"],["を"],["下す","くだす"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["しかし"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["行く","いく"],["どんな"],["所","ところ"],["で"],["で"],["も"],["、"],["あなた"],["の"],["いのち"],["を"],["分捕り","ぶんどり"],["物","もの"],["として"],["あなた"],["に"],["与える","あたえる"],["。"],["』"],["」"]]}]
[{"verse":1,"text":"ヨシヤの子、ユダの王エホヤキムの時代に、主からエレミヤにあったみことばは、こうである。","tok":[["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["時代","じだい"],["に"],["、"],["主","ぬし"],["から"],["エレミヤ"],["に"],["あった"],["みことば"],["は"],["、"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"「レカブ人の家に行って、彼らに語り、彼らを主の宮の一室に連れて来て、彼らに酒を飲ませよ。」","tok":[["「"],["レカブ人","れかぶにん"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["彼","かれ"],["ら"],["に"],["語り","かたり"],["、"],["彼","かれ"],["ら"],["を"],["主","ぬし"],["の"],["宮","みや"],["の"],["一室","いっしつ"],["に"],["連れて","つれて"],["来て","きて"],["、"],["彼","かれ"],["ら"],["に"],["酒","さけ"],["を"],["飲ませ","のませ"],["よ"],["。"],["」"]]},{"verse":3,"text":"そこで私は、ハバツィヌヤの子エレミヤの子であるヤアザヌヤと、その兄弟と、そのすべての息子と、レカブ人の全家を率い、","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["ハバツィヌヤ"],["の"],["子","こ"],["エレミヤ"],["の"],["子","こ"],["で"],["ある"],["ヤアザヌヤ"],["と"],["、"],["その"],["兄弟","きょうだい"],["と"],["、"],["その"],["すべて"],["の"],["息子","むすこ"],["と"],["、"],["レカブ人","れかぶにん"],["の"],["全","ぜん"],["家","いえ"],["を"],["率い","ひきい"],["、"]]},{"verse":4,"text":"彼らを主の宮のイグダルヤの子、神の人ハナンの子らの部屋に連れて来た。それは、首長たちの部屋の隣にあり、入口を守る者シャルムの子マアセヤの部屋の上にあった。","tok":[["彼","かれ"],["ら"],["を"],["主","ぬし"],["の"],["宮","みや"],["の"],["イグダルヤ"],["の"],["子","こ"],["、"],["神","かみ"],["の"],["人","ひと"],["ハナン"],["の"],["子","こ"],["ら"],["の"],["部屋","へや"],["に"],["連れて","つれて"],["来た","きた"],["。"],["それ"],["は"],["、"],["首長","しゅちょう"],["たち"],["の"],["部屋","へや"],["の"],["隣","となり"],["に"],["あり"],["、"],["入口","いりぐち"],["を"],["守る","まもる"],["者","もの"],["シャルム"],["の"],["子","こ"],["マアセヤ"],["の"],["部屋","へや"],["の"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":5,"text":"私は、レカブ人の家の子たちの前に、ぶどう酒を満たしたつぼと杯とを出して、彼らに「酒を飲みなさい」と言った。","tok":[["私","わたくし"],["は"],["、"],["レカブ人","れかぶにん"],["の"],["家の子","いえのこ"],["たち"],["の"],["前","まえ"],["に"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["満たした","みたした"],["つぼ"],["と"],["杯","さかずき"],["と"],["を"],["出して","だして"],["、"],["彼","かれ"],["ら"],["に"],["「"],["酒","さけ"],["を"],["飲み","のみ"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"すると彼らは言った。「私たちはぶどう酒を飲みません。それは、私たちの先祖レカブの子ヨナダブが私たちに命じて、『あなたがたも、あなたがたの子らも、永久にぶどう酒を飲んではならない。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["ぶどう酒","ぶどうしゅ"],["を"],["飲みません","のみません"],["。"],["それ"],["は"],["、"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["レカブ"],["の"],["子","こ"],["ヨナダブ"],["が"],["私たち","わたしたち"],["に"],["命じて","めいじて"],["、"],["『"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["の"],["子","こ"],["ら"],["も"],["、"],["永久","えいきゅう"],["に"],["ぶどう酒","ぶどうしゅ"],["を"],["飲んで","のんで"],["は"],["ならない"],["。"]]},{"verse":7,"text":"あなたがたは家を建てたり、種を蒔いたり、ぶどう畑を作ったり、また所有したりしてはならない。あなたがたが寄留している地の面に末長く生きるために、一生、天幕に住め』と言ったからです。","tok":[["あなた"],["がた"],["は"],["家","いえ"],["を"],["建て","たて"],["たり"],["、"],["種","しゅ"],["を"],["蒔い","まい"],["たり"],["、"],["ぶどう"],["畑","はたけ"],["を"],["作っ","つくっ"],["たり"],["、"],["また"],["所有","しょゆう"],["し"],["たり"],["して"],["は"],["ならない"],["。"],["あなた"],["がた"],["が"],["寄留","きりゅう"],["して"],["いる"],["地","ち"],["の"],["面","めん"],["に"],["末長く","すえながく"],["生きる","いきる"],["ため"],["に"],["、"],["一生","いっしょう"],["、"],["天幕","てんまく"],["に"],["住め","すめ"],["』"],["と"],["言った","いった"],["から"],["です"],["。"]]},{"verse":8,"text":"それで、私たちは、私たちの先祖レカブの子ヨナダブが私たちに命じたすべての命令に聞き従い、私たちも、妻も、息子、娘たちも、一生、ぶどう酒を飲まず、","tok":[["それ"],["で"],["、"],["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["レカブ"],["の"],["子","こ"],["ヨナダブ"],["が"],["私たち","わたしたち"],["に"],["命じた","めいじた"],["すべて"],["の"],["命令","めいれい"],["に"],["聞き従い","ききしたがい"],["、"],["私たち","わたしたち"],["も"],["、"],["妻","つま"],["も"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["も"],["、"],["一生","いっしょう"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["飲まず","のまず"],["、"]]},{"verse":9,"text":"住む家も建てず、ぶどう畑も、畑も、種も持ちません。","tok":[["住む","すむ"],["家","いえ"],["も"],["建てず","たてず"],["、"],["ぶどう"],["畑","はたけ"],["も"],["、"],["畑","はたけ"],["も"],["、"],["種","しゅ"],["も"],["持ちません","もちません"],["。"]]},{"verse":10,"text":"私たちは天幕に住み、すべて先祖ヨナダブが私たちに命じたとおりに、聞いて行ってきました。","tok":[["私たち","わたしたち"],["は"],["天幕","てんまく"],["に"],["住み","すみ"],["、"],["すべて"],["先祖","せんぞ"],["ヨナダブ"],["が"],["私たち","わたしたち"],["に"],["命じた","めいじた"],["とおり"],["に"],["、"],["聞いて","きいて"],["行って","いって"],["きました"],["。"]]},{"verse":11,"text":"しかし、バビロンの王ネブカデレザルがこの国に攻め上ったとき、私たちは『さあ、カルデヤの軍勢とアラムの軍勢を避けてエルサレムに行こう』と言って、エルサレムに住んだのです。」","tok":[["しかし"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデレザル"],["が"],["この"],["国","くに"],["に"],["攻め上った","せめのぼった"],["とき"],["、"],["私たち","わたしたち"],["は"],["『"],["さあ"],["、"],["カルデヤ"],["の"],["軍勢","ぐんぜい"],["と"],["アラム"],["の"],["軍勢","ぐんぜい"],["を"],["避けて","さけて"],["エルサレム"],["に"],["行こう","いこう"],["』"],["と"],["言って","いって"],["、"],["エルサレム"],["に"],["住んだ","すんだ"],["の"],["です"],["。"],["」"]]},{"verse":12,"text":"そこで、エレミヤに次のような主のことばがあった。","tok":[["そこ"],["で"],["、"],["エレミヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":13,"text":"「イスラエルの神、万軍の主は、こう仰せられる。行って、ユダの人とエルサレムの住民に言え。『あなたがたはわたしのことばを聞いて懲らしめを受けようとしないのか。――主の御告げ――","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["行って","いって"],["、"],["ユダ"],["の"],["人","ひと"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["言え","いえ"],["。"],["『"],["あなた"],["がた"],["は"],["わたし"],["の"],["ことば"],["を"],["聞いて","きいて"],["懲らしめ","こらしめ"],["を"],["受けよう","うけよう"],["と"],["しない"],["の"],["か"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":14,"text":"レカブの子ヨナダブが、酒を飲むなと子らに命じた命令は守られた。彼らは先祖の命令に聞き従ったので、今日まで飲まなかった。ところが、わたしがあなたがたにたびたび語っても、あなたがたはわたしに聞かなかった。","tok":[["レカブ"],["の"],["子","こ"],["ヨナダブ"],["が"],["、"],["酒","さけ"],["を"],["飲む","のむ"],["な"],["と"],["子","こ"],["ら"],["に"],["命じた","めいじた"],["命令","めいれい"],["は"],["守られた","まもられた"],["。"],["彼","かれ"],["ら"],["は"],["先祖","せんぞ"],["の"],["命令","めいれい"],["に"],["聞き従った","ききしたがった"],["ので"],["、"],["今日","きょう"],["まで"],["飲まなかった","のまなかった"],["。"],["ところ"],["が"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["たびたび"],["語って","かたって"],["も"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["聞かなかった","きかなかった"],["。"]]},{"verse":15,"text":"わたしはあなたがたに、わたしのしもべであるすべての預言者たちを早くからたびたび送って、さあ、おのおの悪の道から立ち返り、行いを改めよ。ほかの神々を慕ってそれに仕えてはならない。わたしがあなたがたと先祖たちに与えた土地に住めと言ったのに、あなたがたは耳を傾けず、わたしに聞かなかった。","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["わたし"],["の"],["しもべ"],["で"],["ある"],["すべて"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["早く","はやく"],["から"],["たびたび"],["送って","おくって"],["、"],["さあ"],["、"],["おのおの"],["悪","わる"],["の"],["道","みち"],["から"],["立ち返り","たちかえり"],["、"],["行い","おこない"],["を"],["改めよ","あらためよ"],["。"],["ほか"],["の"],["神々","かみがみ"],["を"],["慕って","したって"],["それ"],["に"],["仕えて","つかえて"],["は"],["ならない"],["。"],["わたし"],["が"],["あなた"],["がた"],["と"],["先祖","せんぞ"],["たち"],["に"],["与えた","あたえた"],["土地","とち"],["に"],["住め","すめ"],["と"],["言った","いった"],["のに"],["、"],["あなた"],["がた"],["は"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["わたし"],["に"],["聞かなかった","きかなかった"],["。"]]},{"verse":16,"text":"レカブの子ヨナダブの子たちは、先祖が命じた命令を守ってきたのに、この民はわたしに聞かなかった。』","tok":[["レカブ"],["の"],["子","こ"],["ヨナダブ"],["の"],["子","こ"],["たち"],["は"],["、"],["先祖","せんぞ"],["が"],["命じた","めいじた"],["命令","めいれい"],["を"],["守って","まもって"],["きた"],["のに"],["、"],["この"],["民","みん"],["は"],["わたし"],["に"],["聞かなかった","きかなかった"],["。"],["』"]]},{"verse":17,"text":"それゆえ、イスラエルの神、万軍の神、主は、こう仰せられる。『見よ。わたしはユダと、エルサレムの全住民に、わたしが彼らについて語ったすべてのわざわいを下す。わたしが彼らに語ったのに、彼らが聞かず、わたしが彼らに呼びかけたのに、彼らが答えなかったからだ。』」","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["ユダ"],["と"],["、"],["エルサレム"],["の"],["全住民","ぜんじゅうみん"],["に"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["について"],["語った","かたった"],["すべて"],["の"],["わざわい"],["を"],["下す","くだす"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["語った","かたった"],["のに"],["、"],["彼","かれ"],["ら"],["が"],["聞かず","きかず"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["呼びかけた","よびかけた"],["のに"],["、"],["彼","かれ"],["ら"],["が"],["答えなかった","こたえなかった"],["から"],["だ"],["。"],["』"],["」"]]},{"verse":18,"text":"エレミヤはレカブ人の家の者に言った。「イスラエルの神、万軍の主は、こう仰せられる。『あなたがたは、先祖ヨナダブの命令に聞き従い、そのすべての命令を守り、すべて彼があなたがたに命じたとおりに行った。』","tok":[["エレミヤ"],["は"],["レカブ人","れかぶにん"],["の"],["家","いえ"],["の"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["がた"],["は"],["、"],["先祖","せんぞ"],["ヨナダブ"],["の"],["命令","めいれい"],["に"],["聞き従い","ききしたがい"],["、"],["その"],["すべて"],["の"],["命令","めいれい"],["を"],["守り","まもり"],["、"],["すべて"],["彼","かれ"],["が"],["あなた"],["がた"],["に"],["命じた","めいじた"],["とおり"],["に"],["行った","いった"],["。"],["』"]]},{"verse":19,"text":"それゆえ、イスラエルの神、万軍の主は、こう仰せられる。『レカブの子、ヨナダブには、いつも、わたしの前に立つ人が絶えることはない。』」","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["レカブ"],["の"],["子","こ"],["、"],["ヨナダブ"],["に"],["は"],["、"],["いつも"],["、"],["わたし"],["の"],["前","まえ"],["に"],["立つ","たつ"],["人","ひと"],["が"],["絶える","たえる"],["こと"],["は"],["ない"],["。"],["』"],["」"]]}]
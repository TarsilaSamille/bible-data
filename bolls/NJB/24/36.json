[{"verse":1,"text":"ヨシヤの子、ユダの王エホヤキムの第四年に、主からエレミヤに次のようなみことばがあった。","tok":[["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["第","だい"],["四","よん"],["年","ねん"],["に"],["、"],["主","ぬし"],["から"],["エレミヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["みことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「あなたは巻き物を取り、わたしがあなたに語った日、すなわちヨシヤの時代から今日まで、わたしがイスラエルとユダとすべての国々について、あなたに語ったことばをみな、それに書きしるせ。","tok":[["「"],["あなた"],["は"],["巻き物","まきもの"],["を"],["取り","とり"],["、"],["わたし"],["が"],["あなた"],["に"],["語った","かたった"],["日","ひ"],["、"],["すなわち"],["ヨシヤ"],["の"],["時代","じだい"],["から"],["今日","きょう"],["まで"],["、"],["わたし"],["が"],["イスラエル"],["と"],["ユダ"],["と"],["すべて"],["の"],["国々","くにぐに"],["について"],["、"],["あなた"],["に"],["語った","かたった"],["ことば"],["を"],["みな"],["、"],["それ"],["に"],["書きしるせ","かきしるせ"],["。"]]},{"verse":3,"text":"ユダの家は、わたしが彼らに下そうと思っているすべてのわざわいを聞いて、それぞれ悪の道から立ち返るかもしれない。そうすれば、わたしも、彼らの咎と罪とを赦すことができる。」","tok":[["ユダ"],["の"],["家","いえ"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["下そう","くだそう"],["と"],["思って","おもって"],["いる"],["すべて"],["の"],["わざわい"],["を"],["聞いて","きいて"],["、"],["それぞれ"],["悪","わる"],["の"],["道","みち"],["から"],["立ち返る","たちかえる"],["か"],["も"],["しれない"],["。"],["そう"],["すれば"],["、"],["わたし"],["も"],["、"],["彼","かれ"],["ら"],["の"],["咎","とが"],["と"],["罪","つみ"],["と"],["を"],["赦す","ゆるす"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":4,"text":"それでエレミヤは、ネリヤの子バルクを呼んだ。バルクはエレミヤの口述に従って、彼に語られた主のことばを、ことごとく巻き物に書きしるした。","tok":[["それ"],["で"],["エレミヤ"],["は"],["、"],["ネリヤ"],["の"],["子","こ"],["バルク"],["を"],["呼んだ","よんだ"],["。"],["バルク"],["は"],["エレミヤ"],["の"],["口述","こうじゅつ"],["に"],["従って","したがって"],["、"],["彼","かれ"],["に"],["語られた","かたられた"],["主","ぬし"],["の"],["ことば"],["を"],["、"],["ことごとく"],["巻き物","まきもの"],["に"],["書きしるした","かきしるした"],["。"]]},{"verse":5,"text":"そしてエレミヤは、バルクに命じて言った。「私は閉じ込められていて、主の宮に行けない。","tok":[["そして"],["エレミヤ"],["は"],["、"],["バルク"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["閉じ込められて","とじこめられて"],["いて"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["行けない","いけない"],["。"]]},{"verse":6,"text":"だから、あなたが行って、主の宮で、断食の日に、あなたが私の口述によって巻き物に書きしるした主のことばを、民の耳に読み聞かせ、また町々から来るユダ全体の耳にもそれを読み聞かせよ。","tok":[["だ"],["から"],["、"],["あなた"],["が"],["行って","いって"],["、"],["主","ぬし"],["の"],["宮","みや"],["で"],["、"],["断食","だんじき"],["の"],["日","ひ"],["に"],["、"],["あなた"],["が"],["私","わたくし"],["の"],["口述","こうじゅつ"],["によって"],["巻き物","まきもの"],["に"],["書きしるした","かきしるした"],["主","ぬし"],["の"],["ことば"],["を"],["、"],["民","みん"],["の"],["耳","みみ"],["に"],["読み聞かせ","よみきかせ"],["、"],["また"],["町々","まちまち"],["から"],["来る","くる"],["ユダ"],["全体","ぜんたい"],["の"],["耳","みみ"],["に"],["も"],["それ"],["を"],["読み聞かせ","よみきかせ"],["よ"],["。"]]},{"verse":7,"text":"そうすれば、彼らは主の前に祈願をささげ、それぞれ悪の道から立ち返るかもしれない。主がこの民に語られた怒りと憤りは大きいからである。」","tok":[["そう"],["すれば"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["前","まえ"],["に"],["祈願","きがん"],["を"],["ささげ"],["、"],["それぞれ"],["悪","わる"],["の"],["道","みち"],["から"],["立ち返る","たちかえる"],["か"],["も"],["しれない"],["。"],["主","ぬし"],["が"],["この"],["民","たみ"],["に"],["語られた","かたられた"],["怒り","いかり"],["と"],["憤り","いきどおり"],["は"],["大きい","おおきい"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":8,"text":"そこでネリヤの子バルクは、すべて預言者エレミヤが命じたとおりに、主の宮で主のことばの巻き物を読んだ。","tok":[["そこ"],["で"],["ネリヤ"],["の"],["子","こ"],["バルク"],["は"],["、"],["すべて"],["預言者","よげんしゃ"],["エレミヤ"],["が"],["命じた","めいじた"],["とおり"],["に"],["、"],["主","ぬし"],["の"],["宮","みや"],["で"],["主","ぬし"],["の"],["ことば"],["の"],["巻き物","まきもの"],["を"],["読んだ","よんだ"],["。"]]},{"verse":9,"text":"ヨシヤの子、ユダの王エホヤキムの第五年、第九の月、エルサレムのすべての民と、ユダの町々からエルサレムに来ているすべての民に、主の前での断食が布告された。","tok":[["ヨシヤ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["第","だい"],["五","ご"],["年","ねん"],["、"],["第","だい"],["九","きゅう"],["の"],["月","つき"],["、"],["エルサレム"],["の"],["すべて"],["の"],["民","たみ"],["と"],["、"],["ユダ"],["の"],["町々","まちまち"],["から"],["エルサレム"],["に"],["来て","きて"],["いる"],["すべて"],["の"],["民","たみ"],["に"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["の"],["断食","だんじき"],["が"],["布告","ふこく"],["された"],["。"]]},{"verse":10,"text":"そのとき、バルクは、主の宮の、書記シャファンの子ゲマルヤの部屋で、――その部屋は主の宮の新しい門の入口にある上の庭にあった――すべての民に聞こえるように、その書物からエレミヤのことばを読んだ。","tok":[["その"],["とき"],["、"],["バルク"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["、"],["書記","しょき"],["シャファン"],["の"],["子","こ"],["ゲマルヤ"],["の"],["部屋","へや"],["で"],["、"],["―"],["―"],["その"],["部屋","へや"],["は"],["主","ぬし"],["の"],["宮","みや"],["の"],["新しい","あたらしい"],["門","もん"],["の"],["入口","いりぐち"],["に"],["ある"],["上","うえ"],["の"],["庭","にわ"],["に"],["あった"],["―"],["―"],["すべて"],["の"],["民","たみ"],["に"],["聞こえる","きこえる"],["よう"],["に"],["、"],["その"],["書物","しょもつ"],["から"],["エレミヤ"],["の"],["ことば"],["を"],["読んだ","よんだ"],["。"]]},{"verse":11,"text":"シャファンの子ゲマルヤの子ミカヤは、その書物にあるすべての主のことばを聞き、","tok":[["シャファン"],["の"],["子","こ"],["ゲマルヤ"],["の"],["子","こ"],["ミカヤ"],["は"],["、"],["その"],["書物","しょもつ"],["に"],["ある"],["すべて"],["の"],["主","ぬし"],["の"],["ことば"],["を"],["聞き","きき"],["、"]]},{"verse":12,"text":"王宮の、書記の部屋に下ったが、ちょうど、そこには、すべての首長たちがすわっていた。すなわち書記エリシャマ、シェマヤの子デラヤ、アクボルの子エルナタン、シャファンの子ゲマルヤ、ハナヌヤの子ゼデキヤ、およびすべての首長たちである。","tok":[["王宮","おうきゅう"],["の"],["、"],["書記","しょき"],["の"],["部屋","へや"],["に"],["下った","くだった"],["が"],["、"],["ちょうど"],["、"],["そこ"],["に"],["は"],["、"],["すべて"],["の"],["首長","しゅちょう"],["たち"],["が"],["すわって"],["いた"],["。"],["すなわち"],["書記","しょき"],["エリシャマ"],["、"],["シェマヤ"],["の"],["子","こ"],["デラヤ"],["、"],["アクボル"],["の"],["子","こ"],["エルナタン"],["、"],["シャファン"],["の"],["子","こ"],["ゲマルヤ"],["、"],["ハナヌヤ"],["の"],["子","こ"],["ゼデキヤ"],["、"],["および"],["すべて"],["の"],["首長","しゅちょう"],["たち"],["で"],["ある"],["。"]]},{"verse":13,"text":"ミカヤは、バルクがあの巻き物を民に読んで聞かせたときに聞いたすべてのことばを彼らに告げた。","tok":[["ミカヤ"],["は"],["、"],["バルク"],["が"],["あの"],["巻き物","まきもの"],["を"],["民","たみ"],["に"],["読んで","よんで"],["聞かせた","きかせた"],["とき"],["に"],["聞いた","きいた"],["すべて"],["の"],["ことば"],["を"],["彼","かれ"],["ら"],["に"],["告げた","つげた"],["。"]]},{"verse":14,"text":"すべての首長たちは、バルクのもとにクシの子シェレムヤの子ネタヌヤの子エフディを遣わして言わせた。「あなたが民に読んで聞かせたあの巻き物、あれを手に持って来なさい。」そこで、ネリヤの子バルクは、巻き物を手に持って彼らのところに入って来た。","tok":[["すべて"],["の"],["首長","しゅちょう"],["たち"],["は"],["、"],["バルク"],["の"],["もと"],["に"],["クシ"],["の"],["子","こ"],["シェレムヤ"],["の"],["子","こ"],["ネタヌヤ"],["の"],["子","こ"],["エフディ"],["を"],["遣わして","つかわして"],["言わせた","いわせた"],["。"],["「"],["あなた"],["が"],["民","たみ"],["に"],["読んで","よんで"],["聞かせた","きかせた"],["あの"],["巻き物","まきもの"],["、"],["あれ"],["を"],["手","て"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["」"],["そこ"],["で"],["、"],["ネリヤ"],["の"],["子","こ"],["バルク"],["は"],["、"],["巻き物","まきもの"],["を"],["手","て"],["に"],["持って","もって"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["入って","はいって"],["来た","きた"],["。"]]},{"verse":15,"text":"彼らはバルクに言った。「さあ、すわって、私たちにそれを読んで聞かせてくれ。」そこで、バルクは彼らに読んで聞かせた。","tok":[["彼","かれ"],["ら"],["は"],["バルク"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["すわって"],["、"],["私たち","わたしたち"],["に"],["それ"],["を"],["読んで","よんで"],["聞かせて","きかせて"],["くれ"],["。"],["」"],["そこ"],["で"],["、"],["バルク"],["は"],["彼","かれ"],["ら"],["に"],["読んで","よんで"],["聞かせた","きかせた"],["。"]]},{"verse":16,"text":"彼らがそのすべてのことばを聞いたとき、みな互いに恐れ、バルクに言った。「私たちは、これらのことばをみな、必ず王に告げなければならない。」","tok":[["彼","かれ"],["ら"],["が"],["その"],["すべて"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["みな"],["互い","たがい"],["に"],["恐れ","おそれ"],["、"],["バルク"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["これ"],["ら"],["の"],["ことば"],["を"],["みな"],["、"],["必ず","かならず"],["王","おう"],["に"],["告げなければ","つげなければ"],["ならない"],["。"],["」"]]},{"verse":17,"text":"彼らはバルクに尋ねて言った。「さあ、どのようにして、あなたはこれらのことばをみな、彼の口から書きとったのか、私たちに教えてくれ。」","tok":[["彼","かれ"],["ら"],["は"],["バルク"],["に"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["さあ"],["、"],["どの"],["よう"],["に"],["して"],["、"],["あなた"],["は"],["これ"],["ら"],["の"],["ことば"],["を"],["みな"],["、"],["彼","かれ"],["の"],["口","くち"],["から"],["書きとった","かきとった"],["の"],["か"],["、"],["私たち","わたしたち"],["に"],["教えて","おしえて"],["くれ"],["。"],["」"]]},{"verse":18,"text":"バルクは彼らに言った。「エレミヤがこれらすべてのことばを私に口述し、私が墨でこの巻き物に書きしるしました。」","tok":[["バルク"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["エレミヤ"],["が"],["これ"],["ら"],["すべて"],["の"],["ことば"],["を"],["私","わたくし"],["に"],["口述","こうじゅつ"],["し"],["、"],["私","わたくし"],["が"],["墨","すみ"],["で"],["この"],["巻き物","まきもの"],["に"],["書きしるしました","かきしるしました"],["。"],["」"]]},{"verse":19,"text":"すると、首長たちはバルクに言った。「行って、あなたも、エレミヤも身を隠しなさい。だれにも、あなたがたがどこにいるか知られないように。」","tok":[["する"],["と"],["、"],["首長","しゅちょう"],["たち"],["は"],["バルク"],["に"],["言った","いった"],["。"],["「"],["行って","いって"],["、"],["あなた"],["も"],["、"],["エレミヤ"],["も"],["身","み"],["を"],["隠し","かくし"],["なさい"],["。"],["だれ"],["に"],["も"],["、"],["あなた"],["がた"],["が"],["どこ"],["に"],["いる"],["か"],["知られない","しられない"],["よう"],["に"],["。"],["」"]]},{"verse":20,"text":"彼らは巻き物を書記エリシャマの部屋に置き、庭の王のところに行ってこのすべての事を王に報告した。","tok":[["彼","かれ"],["ら"],["は"],["巻き物","まきもの"],["を"],["書記","しょき"],["エリシャマ"],["の"],["部屋","へや"],["に"],["置き","おき"],["、"],["庭","にわ"],["の"],["王","おう"],["の"],["ところ"],["に"],["行って","いって"],["この"],["すべて"],["の"],["事","こと"],["を"],["王","おう"],["に"],["報告","ほうこく"],["した"],["。"]]},{"verse":21,"text":"王はエフディに、その巻き物を取りに行かせたので、彼はそれを書記エリシャマの部屋から取って来た。エフディはそれを、王と王のかたわらに立つすべての首長たちに読んで聞かせた。","tok":[["王","おう"],["は"],["エフディ"],["に"],["、"],["その"],["巻き物","まきもの"],["を"],["取り","とり"],["に"],["行かせた","いかせた"],["ので"],["、"],["彼","かれ"],["は"],["それ"],["を"],["書記","しょき"],["エリシャマ"],["の"],["部屋","へや"],["から"],["取って","とって"],["来た","きた"],["。"],["エフディ"],["は"],["それ"],["を"],["、"],["王","おう"],["と"],["王","おう"],["の"],["かたわら"],["に"],["立つ","たつ"],["すべて"],["の"],["首長","しゅちょう"],["たち"],["に"],["読んで","よんで"],["聞かせた","きかせた"],["。"]]},{"verse":22,"text":"第九の月であったので、王は冬の家の座に着いていた。彼の前には暖炉の火が燃えていた。","tok":[["第","だい"],["九","きゅう"],["の"],["月","つき"],["で"],["あった"],["ので"],["、"],["王","おう"],["は"],["冬","ふゆ"],["の"],["家","いえ"],["の"],["座","ざ"],["に"],["着いて","ついて"],["いた"],["。"],["彼","かれ"],["の"],["前","まえ"],["に"],["は"],["暖炉","だんろ"],["の"],["火","ひ"],["が"],["燃えて","もえて"],["いた"],["。"]]},{"verse":23,"text":"エフディが三、四段を読むごとに、王は書記の小刀でそれを裂いては、暖炉の火に投げ入れ、ついに、暖炉の火で巻き物全部を焼き尽くした。","tok":[["エフディ"],["が"],["三","さん"],["、"],["四","よん"],["段","だん"],["を"],["読む","よむ"],["ごと"],["に"],["、"],["王","おう"],["は"],["書記","しょき"],["の"],["小刀","こがたな"],["で"],["それ"],["を"],["裂いて","さいて"],["は"],["、"],["暖炉","だんろ"],["の"],["火","ひ"],["に"],["投げ入れ","なげいれ"],["、"],["ついに"],["、"],["暖炉","だんろ"],["の"],["火","ひ"],["で"],["巻き物","まきもの"],["全部","ぜんぶ"],["を"],["焼き","やき"],["尽くした","つくした"],["。"]]},{"verse":24,"text":"王も、彼のすべての家来たちも、これらのすべてのことばを聞きながら、恐れようともせず、衣を裂こうともしなかった。","tok":[["王","おう"],["も"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["家来","けらい"],["たち"],["も"],["、"],["これ"],["ら"],["の"],["すべて"],["の"],["ことば"],["を"],["聞き","き
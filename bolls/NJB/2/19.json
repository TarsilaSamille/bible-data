[{"verse":1,"text":"エジプトの地を出たイスラエル人は、第三の月の新月のその日に、シナイの荒野に入った。","tok":[["エジプト"],["の"],["地","ち"],["を"],["出た","でた"],["イスラエル"],["人","にん"],["は"],["、"],["第","だい"],["三","さん"],["の"],["月","つき"],["の"],["新月","しんげつ"],["の"],["その"],["日","ひ"],["に"],["、"],["シナイ"],["の"],["荒野","あらの"],["に"],["入った","はいった"],["。"]]},{"verse":2,"text":"彼らはレフィディムを旅立って、シナイの荒野に入り、その荒野で宿営した。イスラエルはそこで、山のすぐ前に宿営した。","tok":[["彼","かれ"],["ら"],["は"],["レフィディム"],["を"],["旅立って","たびだって"],["、"],["シナイ"],["の"],["荒野","あらの"],["に"],["入り","はいり"],["、"],["その"],["荒野","こうや"],["で"],["宿営","しゅくえい"],["した"],["。"],["イスラエル"],["は"],["そこ"],["で"],["、"],["山","やま"],["の"],["すぐ"],["前","まえ"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":3,"text":"モーセは神のみもとに上って行った。主は山から彼を呼んで仰せられた。「あなたは、このように、ヤコブの家に言い、イスラエルの人々に告げよ。","tok":[["モーセ"],["は"],["神","かみ"],["のみ"],["もと"],["に"],["上って","のぼって"],["行った","いった"],["。"],["主","ぬし"],["は"],["山","やま"],["から"],["彼","かれ"],["を"],["呼んで","よんで"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["この"],["よう"],["に"],["、"],["ヤコブ"],["の"],["家","いえ"],["に"],["言い","いい"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告げ","つげ"],["よ"],["。"]]},{"verse":4,"text":"あなたがたは、わたしがエジプトにしたこと、また、あなたがたを鷲の翼に載せ、わたしのもとに連れて来たことを見た。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["エジプト"],["に"],["した"],["こと"],["、"],["また"],["、"],["あなた"],["がた"],["を"],["鷲","わし"],["の"],["翼","つばさ"],["に"],["載せ","のせ"],["、"],["わたし"],["の"],["もと"],["に"],["連れて","つれて"],["来た","きた"],["こと"],["を"],["見た","みた"],["。"]]},{"verse":5,"text":"今、もしあなたがたが、まことにわたしの声に聞き従い、わたしの契約を守るなら、あなたがたはすべての国々の民の中にあって、わたしの宝となる。全世界はわたしのものであるから。","tok":[["今","いま"],["、"],["もし"],["あなた"],["が"],["た"],["が"],["、"],["まこと"],["に"],["わたし"],["の"],["声","こえ"],["に"],["聞き従い","ききしたがい"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["守るなら","まもるなら"],["、"],["あなた"],["がた"],["は"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["あって"],["、"],["わたし"],["の"],["宝","たから"],["と"],["なる"],["。"],["全","ぜん"],["世界","せかい"],["は"],["わたし"],["の"],["もの"],["で"],["ある"],["から"],["。"]]},{"verse":6,"text":"あなたがたはわたしにとって祭司の王国、聖なる国民となる。／これが、イスラエル人にあなたの語るべきことばである。」","tok":[["あなた"],["がた"],["は"],["わたし"],["にとって"],["祭司","さいし"],["の"],["王国","おうこく"],["、"],["聖","せい"],["なる"],["国民","こくみん"],["と"],["なる"],["。"],["／"],["これ"],["が"],["、"],["イスラエル"],["人","にん"],["に"],["あなた"],["の"],["語るべき","かたるべき"],["ことば"],["で"],["ある"],["。"],["」"]]},{"verse":7,"text":"モーセは行って、民の長老たちを呼び寄せ、主が命じられたこれらのことばをみな、彼らの前に述べた。","tok":[["モーセ"],["は"],["行って","いって"],["、"],["民","みん"],["の"],["長老","ちょうろう"],["たち"],["を"],["呼び寄せ","よびよせ"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["これ"],["ら"],["の"],["ことば"],["を"],["みな"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["述べた","のべた"],["。"]]},{"verse":8,"text":"すると民はみな口をそろえて答えた。「私たちは主が仰せられたことを、みな行います。」それでモーセは民のことばを主に持って帰った。","tok":[["する"],["と"],["民","たみ"],["は"],["みな"],["口","くち"],["を"],["そろえて"],["答えた","こたえた"],["。"],["「"],["私たち","わたしたち"],["は"],["主","ぬし"],["が"],["仰せられた","おおせられた"],["こと"],["を"],["、"],["みな"],["行います","おこないます"],["。"],["」"],["それ"],["で"],["モーセ"],["は"],["民","みん"],["の"],["ことば"],["を"],["主に","おもに"],["持って","もって"],["帰った","かえった"],["。"]]},{"verse":9,"text":"すると、主はモーセに仰せられた。「見よ。わたしは濃い雲の中で、あなたに臨む。わたしがあなたと語るのを民が聞き、いつまでもあなたを信じるためである。」それからモーセは民のことばを主に告げた。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["濃い","こい"],["雲","くも"],["の"],["中","なか"],["で"],["、"],["あなた"],["に"],["臨む","のぞむ"],["。"],["わたし"],["が"],["あなた"],["と"],["語る","かたる"],["の"],["を"],["民","たみ"],["が"],["聞き","きき"],["、"],["いつ"],["まで"],["も"],["あなた"],["を"],["信じる","しんじる"],["ため"],["で"],["ある"],["。"],["」"],["それ"],["から"],["モーセ"],["は"],["民","みん"],["の"],["ことば"],["を"],["主に","おもに"],["告げた","つげた"],["。"]]},{"verse":10,"text":"主はモーセに仰せられた。「あなたは民のところに行き、きょうとあす、彼らを聖別し、自分たちの着物を洗わせよ。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["民","みん"],["の"],["ところ"],["に"],["行き","いき"],["、"],["きょう"],["と"],["あす"],["、"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["し"],["、"],["自分","じぶん"],["たち"],["の"],["着物","きもの"],["を"],["洗わせ","あらわせ"],["よ"],["。"]]},{"verse":11,"text":"彼らは三日目のために用意をせよ。三日目には、主が民全体の目の前で、シナイ山に降りて来られるからである。","tok":[["彼","かれ"],["ら"],["は"],["三日目","みっかめ"],["の"],["ため"],["に"],["用意","ようい"],["を"],["せよ"],["。"],["三日目","みっかめ"],["に"],["は"],["、"],["主","ぬし"],["が"],["民","みん"],["全体","ぜんたい"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["シナイ"],["山","やま"],["に"],["降りて","おりて"],["来られる","こられる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"あなたは民のために、周囲に境を設けて言え。山に登ったり、その境界に触れたりしないように注意しなさい。山に触れる者は、だれでも必ず殺されなければならない。","tok":[["あなた"],["は"],["民","みん"],["の"],["ため"],["に"],["、"],["周囲","しゅうい"],["に"],["境","さかい"],["を"],["設けて","もうけて"],["言え","いえ"],["。"],["山","やま"],["に"],["登っ","のぼっ"],["たり"],["、"],["その"],["境界","きょうかい"],["に"],["触れ","ふれ"],["たり"],["しない"],["よう"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"],["山","やま"],["に"],["触れる","ふれる"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["必ず","かならず"],["殺されなければ","ころされなければ"],["ならない"],["。"]]},{"verse":13,"text":"それに手を触れてはならない。触れる者は必ず石で打ち殺されるか、刺し殺される。獣でも、人でも、生かしておいてはならない。しかし雄羊の角が長く鳴り響くとき、彼らは山に登って来なければならない。」","tok":[["それ"],["に"],["手","て"],["を"],["触れて","ふれて"],["は"],["ならない"],["。"],["触れる","ふれる"],["者","もの"],["は"],["必ず","かならず"],["石","いし"],["で"],["打ち殺される","うちころされる"],["か"],["、"],["刺し殺される","さしころされる"],["。"],["獣","けもの"],["で"],["も"],["、"],["人","ひと"],["で"],["も"],["、"],["生かして","いかして"],["おいて"],["は"],["ならない"],["。"],["しかし"],["雄羊","おひつじ"],["の"],["角","かど"],["が"],["長く","ながく"],["鳴り響く","なりひびく"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["山","やま"],["に"],["登って","のぼって"],["来なければ","こなければ"],["ならない"],["。"],["」"]]},{"verse":14,"text":"それでモーセは山から民のところに降りて来た。そして、民を聖別し、彼らに自分たちの着物を洗わせた。","tok":[["それ"],["で"],["モーセ"],["は"],["山","やま"],["から"],["民","たみ"],["の"],["ところ"],["に"],["降りて","おりて"],["来た","きた"],["。"],["そして"],["、"],["民","みん"],["を"],["聖別","せいべつ"],["し"],["、"],["彼","かれ"],["ら"],["に"],["自分","じぶん"],["たち"],["の"],["着物","きもの"],["を"],["洗わせた","あらわせた"],["。"]]},{"verse":15,"text":"モーセは民に言った。「三日目のために用意をしなさい。女に近づいてはならない。」","tok":[["モーセ"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["三日目","みっかめ"],["の"],["ため"],["に"],["用意","ようい"],["を"],["し"],["なさい"],["。"],["女","おんな"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["」"]]},{"verse":16,"text":"三日目の朝になると、山の上に雷といなずまと密雲があり、角笛の音が非常に高く鳴り響いたので、宿営の中の民はみな震え上がった。","tok":[["三日目","みっかめ"],["の"],["朝","あさ"],["に"],["なる"],["と"],["、"],["山","やま"],["の"],["上","うえ"],["に"],["雷","かみなり"],["と"],["いなずま"],["と"],["密雲","みつうん"],["が"],["あり"],["、"],["角笛","つのぶえ"],["の"],["音","おと"],["が"],["非常","ひじょう"],["に"],["高く","たかく"],["鳴り響いた","なりひびいた"],["ので"],["、"],["宿営","しゅくえい"],["の"],["中","なか"],["の"],["民","たみ"],["は"],["みな"],["震え上がった","ふるえあがった"],["。"]]},{"verse":17,"text":"モーセは民を、神を迎えるために、宿営から連れ出した。彼らは山のふもとに立った。","tok":[["モーセ"],["は"],["民","みん"],["を"],["、"],["神","かみ"],["を"],["迎える","むかえる"],["ため"],["に"],["、"],["宿営","しゅくえい"],["から"],["連れ出した","つれだした"],["。"],["彼","かれ"],["ら"],["は"],["山","やま"],["の"],["ふもと"],["に"],["立った","たった"],["。"]]},{"verse":18,"text":"シナイ山は全山が煙っていた。それは主が火の中にあって、山の上に降りて来られたからである。その煙は、かまどの煙のように立ち上り、全山が激しく震えた。","tok":[["シナイ"],["山","やま"],["は"],["全山","ぜんざん"],["が"],["煙って","けむって"],["いた"],["。"],["それ"],["は"],["主","ぬし"],["が"],["火","ひ"],["の"],["中","なか"],["に"],["あって"],["、"],["山","やま"],["の"],["上","うえ"],["に"],["降りて","おりて"],["来られた","こられた"],["から"],["で"],["ある"],["。"],["その"],["煙","けむり"],["は"],["、"],["かまど"],["の"],["煙","けむり"],["の"],["よう"],["に"],["立ち上り","たちのぼり"],["、"],["全山","ぜんざん"],["が"],["激しく","はげしく"],["震えた","ふるえた"],["。"]]},{"verse":19,"text":"角笛の音が、いよいよ高くなった。モーセは語り、神は声を出して、彼に答えられた。","tok":[["角笛","つのぶえ"],["の"],["音","おと"],["が"],["、"],["いよいよ"],["高く","たかく"],["なった"],["。"],["モーセ"],["は"],["語り","かたり"],["、"],["神","かみ"],["は"],["声","こえ"],["を"],["出して","だして"],["、"],["彼","かれ"],["に"],["答えられた","こたえられた"],["。"]]},{"verse":20,"text":"主がシナイ山の頂に降りて来られ、主がモーセを山の頂に呼び寄せられたので、モーセは登って行った。","tok":[["主","ぬし"],["が"],["シナイ"],["山","やま"],["の"],["頂","いただき"],["に"],["降りて","おりて"],["来られ","こられ"],["、"],["主","ぬし"],["が"],["モーセ"],["を"],["山","やま"],["の"],["頂","いただき"],["に"],["呼び寄せられた","よびよせられた"],["ので"],["、"],["モーセ"],["は"],["登って","のぼって"],["行った","いった"],["。"]]},{"verse":21,"text":"主はモーセに仰せられた。「下って行って、民を戒めよ。主を見ようと、彼らが押し破って来て、多くの者が滅びるといけない。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["下","した"],["って"],["行って","いって"],["、"],["民","みん"],["を"],["戒めよ","いましめよ"],["。"],["主","ぬし"],["を"],["見よう","みよう"],["と"],["、"],["彼","かれ"],["ら"],["が"],["押し破って","おしやぶって"],["来て","きて"],["、"],["多く","おおく"],["の"],["者","もの"],["が"],["滅びる","ほろびる"],["と"],["いけない"],["。"]]},{"verse":22,"text":"主に近づく祭司たちもまた、その身をきよめなければならない。主が彼らに怒りを発しないために。」","tok":[["主に","おもに"],["近づく","ちかづく"],["祭司","さいし"],["たち"],["も"],["また"],["、"],["その"],["身","み"],["を"],["きよめなければ"],["ならない"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["に"],["怒り","いかり"],["を"],["発しない","はっしない"],["ため"],["に"],["。"],["」"]]},{"verse":23,"text":"モーセは主に申し上げた。「民はシナイ山に登ることはできません。あなたが私たちを戒められて、『山の回りに境を設け、それを聖なる地とせよ』と仰せられたからです。」","tok":[["モーセ"],["は"],["主に","おもに"],["申し上げた","もうしあげた"],["。"],["「"],["民","みん"],["は"],["シナイ"],["山","やま"],["に"],["登る","のぼる"],["こと"],["は"],["できません"],["。"],["あなた"],["が"],["私たち","わたしたち"],["を"],["戒められて","いましめられて"],["、"],["『"],["山","やま"],["の"],["回り","まわり"],["に"],["境","さかい"],["を"],["設け","もうけ"],["、"],["それ"],["を"],["聖","せい"],["なる"],["地","ち"],["と"],["せよ"],["』"],["と"],["仰せられた","おおせられた"],["から"],["です"],["。"],["」"]]},{"verse":24,"text":"主は彼に仰せられた。「降りて行け。そしてあなたはアロンといっしょに登れ。祭司たちと民とは、主のところに登ろうとして押し破ってはならない。主が彼らに怒りを発せられないために。」","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["降りて","おりて"],["行け","いけ"],["。"],["そして"],["あなた"],["は"],["アロン"],["と"],["いっしょ"],["に"],["登れ","のぼれ"],["。"],["祭司","さいし"],["たち"],["と"],["民","たみ"],["と"],["は"],["、"],["主","ぬし"],["の"],["ところ"],["に"],["登ろう","のぼろう"],["として"],["押し破って","おしやぶって"],["は"],["ならない"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["に"],["怒り","いかり"],["を"],["発せられない","はっせられない"],["ため"],["に"],["。"],["」"]]},{"verse":25,"text":"そこでモーセは民のところに降りて行き、彼らに告げた。","tok":[["そこ"],["で"],["モーセ"],["は"],["民","みん"],["の"],["ところ"],["に"],["降りて","おりて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["に"],["告げた","つげた"],["。"]]}]
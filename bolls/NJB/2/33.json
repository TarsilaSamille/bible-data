[{"verse":1,"text":"主はモーセに仰せられた。「あなたも、あなたがエジプトの地から連れ上った民も、わたしがアブラハム、イサク、ヤコブに誓って、『これをあなたの子孫に与える』と言った地にここから上って行け。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["も"],["、"],["あなた"],["が"],["エジプト"],["の"],["地","ち"],["から"],["連れ上った","つれのぼった"],["民","たみ"],["も"],["、"],["わたし"],["が"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓って","ちかって"],["、"],["『"],["これ"],["を"],["あなた"],["の"],["子孫","しそん"],["に"],["与える","あたえる"],["』"],["と"],["言った","いった"],["地","ち"],["に"],["ここ"],["から"],["上って","のぼって"],["行け","いけ"],["。"]]},{"verse":2,"text":"わたしはあなたがたの前にひとりの使いを遣わし、わたしが、カナン人、エモリ人、ヘテ人、ペリジ人、ヒビ人、エブス人を追い払い、","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["ひとり"],["の"],["使い","つかい"],["を"],["遣わし","つかわし"],["、"],["わたし"],["が"],["、"],["カナン人","かなんにん"],["、"],["エモリ人","えもりにん"],["、"],["ヘテ人","へてにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス"],["人","ひと"],["を"],["追い払い","おいはらい"],["、"]]},{"verse":3,"text":"乳と蜜の流れる地にあなたがたを行かせよう。わたしは、あなたがたのうちにあっては上らないからである。あなたがたはうなじのこわい民であるから、わたしが途中であなたがたを絶ち滅ぼすようなことがあるといけないから。」","tok":[["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["に"],["あなた"],["がた"],["を"],["行かせよう","いかせよう"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["あって"],["は"],["上らない","のぼらない"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["うなじ"],["の"],["こわい"],["民","たみ"],["で"],["ある"],["から"],["、"],["わたし"],["が"],["途中","とちゅう"],["で"],["あなた"],["がた"],["を"],["絶ち","たち"],["滅ぼす","ほろぼす"],["よう"],["な"],["こと"],["が"],["ある"],["と"],["いけない"],["から"],["。"],["」"]]},{"verse":4,"text":"民はこの悪い知らせを聞いて悲しみ痛み、だれひとり、その飾り物を身に着ける者はいなかった。","tok":[["民","みん"],["は"],["この"],["悪い","わるい"],["知らせ","しらせ"],["を"],["聞いて","きいて"],["悲しみ","かなしみ"],["痛み","いたみ"],["、"],["だれ"],["ひとり"],["、"],["その"],["飾り物","かざりもの"],["を"],["身","み"],["に"],["着ける","つける"],["者","もの"],["は"],["いなかった"],["。"]]},{"verse":5,"text":"主はモーセに、仰せられた。「イスラエル人に言え。／あなたがたは、うなじのこわい民だ。一時でもあなたがたのうちにあって、上って行こうものなら、わたしはあなたがたを絶ち滅ぼしてしまうだろう。今、あなたがたの飾り物を身から取りはずしなさい。そうすれば、わたしはあなたがたをどうするかを考えよう。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["、"],["仰せられた","おおせられた"],["。"],["「"],["イスラエル"],["人","にん"],["に"],["言え","いえ"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["うなじ"],["の"],["こわい"],["民","たみ"],["だ"],["。"],["一時","いちじ"],["で"],["も"],["あなた"],["がた"],["の"],["うち"],["に"],["あって"],["、"],["上って","のぼって"],["行こう","いこう"],["もの"],["なら"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["絶ち","たち"],["滅ぼして","ほろぼして"],["しまうだろう"],["。"],["今","いま"],["、"],["あなた"],["がた"],["の"],["飾り物","かざりもの"],["を"],["身","み"],["から"],["取りはずし","とりはずし"],["なさい"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["どう"],["する"],["か"],["を"],["考えよう","かんがえよう"],["。"],["」"]]},{"verse":6,"text":"それで、イスラエル人はホレブの山以来、その飾り物を取りはずしていた。","tok":[["それ"],["で"],["、"],["イスラエル"],["人","にん"],["は"],["ホレブ"],["の"],["山","やま"],["以来","いらい"],["、"],["その"],["飾り物","かざりもの"],["を"],["取りはずして","とりはずして"],["いた"],["。"]]},{"verse":7,"text":"モーセはいつも天幕を取り、自分のためにこれを宿営の外の、宿営から離れた所に張り、そしてこれを会見の天幕と呼んでいた。だれでも主に伺いを立てる者は、宿営の外にある会見の天幕に行くのであった。","tok":[["モーセ"],["は"],["いつも"],["天幕","てんまく"],["を"],["取り","とり"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["これ"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["の"],["、"],["宿営","しゅくえい"],["から"],["離れた","はなれた"],["所","ところ"],["に"],["張り","はり"],["、"],["そして"],["これ"],["を"],["会見","かいけん"],["の"],["天幕","てんまく"],["と"],["呼んで","よんで"],["いた"],["。"],["だれ"],["で"],["も"],["主に","おもに"],["伺い","うかがい"],["を"],["立てる","たてる"],["者","もの"],["は"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["ある"],["会見","かいけん"],["の"],["天幕","てんまく"],["に"],["行く","いく"],["ので"],["あった"],["。"]]},{"verse":8,"text":"モーセがこの天幕に出て行くときは、民はみな立ち上がり、おのおの自分の天幕の入口に立って、モーセが天幕に入るまで、彼を見守った。","tok":[["モーセ"],["が"],["この"],["天幕","てんまく"],["に"],["出て","でて"],["行く","いく"],["とき"],["は"],["、"],["民","みん"],["は"],["みな"],["立ち上がり","たちあがり"],["、"],["おのおの"],["自分","じぶん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["立って","たって"],["、"],["モーセ"],["が"],["天幕","てんまく"],["に"],["入る","はいる"],["まで"],["、"],["彼","かれ"],["を"],["見守った","みまもった"],["。"]]},{"verse":9,"text":"モーセが天幕に入ると、雲の柱が降りて来て、天幕の入口に立った。主はモーセと語られた。","tok":[["モーセ"],["が"],["天幕","てんまく"],["に"],["入る","はいる"],["と"],["、"],["雲","くも"],["の"],["柱","はしら"],["が"],["降りて","おりて"],["来て","きて"],["、"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["立った","たった"],["。"],["主","ぬし"],["は"],["モーセ"],["と"],["語られた","かたられた"],["。"]]},{"verse":10,"text":"民は、みな、天幕の入口に雲の柱が立つのを見た。民はみな立って、おのおの自分の天幕の入口で伏し拝んだ。","tok":[["民","みん"],["は"],["、"],["みな"],["、"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["雲","くも"],["の"],["柱","はしら"],["が"],["立つ","たつ"],["の"],["を"],["見た","みた"],["。"],["民","たみ"],["は"],["みな"],["立って","たって"],["、"],["おのおの"],["自分","じぶん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["で"],["伏し拝んだ","ふしおがんだ"],["。"]]},{"verse":11,"text":"主は、人が自分の友と語るように、顔と顔とを合わせてモーセに語られた。モーセが宿営に帰ると、彼の従者でヌンの子ヨシュアという若者が幕屋を離れないでいた。","tok":[["主","ぬし"],["は"],["、"],["人","ひと"],["が"],["自分","じぶん"],["の"],["友","とも"],["と"],["語る","かたる"],["よう"],["に"],["、"],["顔","かお"],["と"],["顔","かお"],["と"],["を"],["合わせて","あわせて"],["モーセ"],["に"],["語られた","かたられた"],["。"],["モーセ"],["が"],["宿営","しゅくえい"],["に"],["帰る","かえる"],["と"],["、"],["彼","かれ"],["の"],["従者","じゅうしゃ"],["で"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["いう"],["若者","わかもの"],["が"],["幕屋","まくや"],["を"],["離れないで","はなれないで"],["いた"],["。"]]},{"verse":12,"text":"さて、モーセは主に申し上げた。「ご覧ください。あなたは私に、『この民を連れて上れ』と仰せになります。しかし、だれを私といっしょに遣わすかを知らせてくださいません。しかも、あなたご自身で、『わたしは、あなたを名ざして選び出した。あなたは特にわたしの心にかなっている』と仰せになりました。","tok":[["さて"],["、"],["モーセ"],["は"],["主に","おもに"],["申し上げた","もうしあげた"],["。"],["「"],["ご覧","ごらん"],["ください"],["。"],["あなた"],["は"],["私","わたくし"],["に"],["、"],["『"],["この"],["民","たみ"],["を"],["連れて","つれて"],["上れ","のぼれ"],["』"],["と"],["仰せ","おおせ"],["に"],["なります"],["。"],["しかし"],["、"],["だれ"],["を"],["私","わたくし"],["と"],["いっしょ"],["に"],["遣わす","つかわす"],["か"],["を"],["知らせて","しらせて"],["くださいません"],["。"],["しかも"],["、"],["あなた"],["ご自身","ごじしん"],["で"],["、"],["『"],["わたし"],["は"],["、"],["あなた"],["を"],["名ざし","なざし"],["て"],["選び出した","えらびだした"],["。"],["あなた"],["は"],["特に","とくに"],["わたし"],["の"],["心","こころ"],["に"],["かなって"],["いる"],["』"],["と"],["仰せ","おおせ"],["に"],["なりました"],["。"]]},{"verse":13,"text":"今、もしも、私があなたのお心にかなっているのでしたら、どうか、あなたの道を教えてください。そうすれば、私はあなたを知ることができ、あなたのお心にかなうようになれるでしょう。この国民があなたの民であることをお心に留めてください。」","tok":[["今","いま"],["、"],["もし"],["も"],["、"],["私","わたくし"],["が"],["あなた"],["の"],["お心","おこころ"],["に"],["かなって"],["いる"],["の"],["でしたら"],["、"],["どう"],["か"],["、"],["あなた"],["の"],["道","みち"],["を"],["教えて","おしえて"],["ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["は"],["あなた"],["を"],["知る","しる"],["こと"],["が"],["でき"],["、"],["あなた"],["の"],["お心","おこころ"],["に"],["かなう"],["よう"],["に"],["なれるでしょう"],["。"],["この"],["国民","こくみん"],["が"],["あなた"],["の"],["民","たみ"],["で"],["ある"],["こと"],["を"],["お心","おこころ"],["に"],["留めて","とめて"],["ください"],["。"],["」"]]},{"verse":14,"text":"すると主は仰せられた。「わたし自身がいっしょに行って、あなたを休ませよう。」","tok":[["する"],["と"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["自身","じしん"],["が"],["いっしょ"],["に"],["行って","いって"],["、"],["あなた"],["を"],["休ませよう","やすませよう"],["。"],["」"]]},{"verse":15,"text":"それでモーセは申し上げた。「もし、あなたご自身がいっしょにおいでにならないなら、私たちをここから上らせないでください。","tok":[["それ"],["で"],["モーセ"],["は"],["申し上げた","もうしあげた"],["。"],["「"],["もし"],["、"],["あなた"],["ご自身","ごじしん"],["が"],["いっしょ"],["に"],["おいで"],["に"],["ならないなら"],["、"],["私たち","わたしたち"],["を"],["ここ"],["から"],["上らせないで","のぼらせないで"],["ください"],["。"]]},{"verse":16,"text":"私とあなたの民とが、あなたのお心にかなっていることは、いったい何によって知られるのでしょう。それは、あなたが私たちといっしょにおいでになって、私とあなたの民が、地上のすべての民と区別されることによるのではないでしょうか。」","tok":[["私","わたくし"],["と"],["あなた"],["の"],["民","たみ"],["と"],["が"],["、"],["あなた"],["の"],["お心","おこころ"],["に"],["かなって"],["いる"],["こと"],["は"],["、"],["いったい"],["何","なん"],["によって"],["知られる","しられる"],["の"],["でしょう"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["私たち","わたしたち"],["と"],["いっしょ"],["に"],["おいで"],["に"],["なって"],["、"],["私","わたくし"],["と"],["あなた"],["の"],["民","たみ"],["が"],["、"],["地上","ちじょう"],["の"],["すべて"],["の"],["民","たみ"],["と"],["区別","くべつ"],["される"],["こと"],["に"],["よる"],["ので"],["は"],["ないでしょう"],["か"],["。"],["」"]]},{"verse":17,"text":"主はモーセに仰せられた。「あなたの言ったそのことも、わたしはしよう。あなたはわたしの心にかない、あなたを名ざして選び出したのだから。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["言った","いった"],["その"],["こと"],["も"],["、"],["わたし"],["は"],["しよう"],["。"],["あなた"],["は"],["わたし"],["の"],["心","こころ"],["に"],["かない"],["、"],["あなた"],["を"],["名ざし","なざし"],["て"],["選び出した","えらびだした"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":18,"text":"すると、モーセは言った。「どうか、あなたの栄光を私に見せてください。」","tok":[["する"],["と"],["、"],["モーセ"],["は"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["あなた"],["の"],["栄光","えいこう"],["を"],["私","わたくし"],["に"],["見せて","みせて"],["ください"],["。"],["」"]]},{"verse":19,"text":"主は仰せられた。「わたし自身、わたしのあらゆる善をあなたの前に通らせ、主の名で、あなたの前に宣言しよう。わたしは、恵もうと思う者を恵み、あわれもうと思う者をあわれむ。」","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["自身","じしん"],["、"],["わたし"],["の"],["あらゆる"],["善","ぜん"],["を"],["あなた"],["の"],["前","まえ"],["に"],["通らせ","とおらせ"],["、"],["主","ぬし"],["の"],["名","な"],["で"],["、"],["あなた"],["の"],["前","まえ"],["に"],["宣言","せんげん"],["しよう"],["。"],["わたし"],["は"],["、"],["恵もう","めぐもう"],["と"],["思う","おもう"],["者","もの"],["を"],["恵み","めぐみ"],["、"],["あわれもう"],["と"],["思う","おもう"],["者","もの"],["を"],["あわれむ"],["。"],["」"]]},{"verse":20,"text":"また仰せられた。「あなたはわたしの顔を見ることはできない。人はわたしを見て、なお生きていることはできないからである。」","tok":[["また"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["わたし"],["の"],["顔","かお"],["を"],["見る","みる"],["こと"],["は"],["できない"],["。"],["人","ひと"],["は"],["わたし"],["を"],["見て","みて"],["、"],["なお"],["生きて","いきて"],["いる"],["こと"],["は"],["できない"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":21,"text":"また主は仰せられた。「見よ。わたしのかたわらに一つの場所がある。あなたは岩の上に立て。","tok":[["また"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["の"],["かたわら"],["に"],["一","ひと"],["つ"],["の"],["場所","ばしょ"],["が"],["ある"],["。"],["あなた"],["は"],["岩","いわ"],["の"],["上","うえ"],["に"],["立て","たて"],["。"]]},{"verse":22,"text":"わたしの栄光が通り過ぎるときには、わたしはあなたを岩の裂け目に入れ、わたしが通り過ぎるまで、この手であなたをおおっておこう。","tok":[["わたし"],["の"],["栄光","えいこう"],["が"],["通り過ぎる","とおりすぎる"],["とき"],["に"],["は"],["、"],["わたし"],["は"],["あなた"],["を"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["入れ","いれ"],["、"],["わたし"],["が"],["通り過ぎる","とおりすぎる"],["まで"],["、"],["この"],["手","て"],["で"],["あなた"],["を"],["おおって"],["おこう"],["。"]]},{"verse":23,"text":"わたしが手をのけたら、あなたはわたしのうしろを見るであろうが、わたしの顔は決して見られない。」","tok":[["わたし"],["が"],["手","て"],["を"],["のけたら"],["、"],["あなた"],["は"],["わたし"],["の"],["うしろ"],["を"],["見るで","みるで"],["あろう"],["が"],["、"],["わたし"],["の"],["顔","かお"],["は"],["決して","けっして"],["見られない","みられない"],["。"],["」"]]}]
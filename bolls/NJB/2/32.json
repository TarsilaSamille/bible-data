[{"verse":1,"text":"民はモーセが山から降りて来るのに手間取っているのを見て、アロンのもとに集まり、彼に言った。「さあ、私たちに先立って行く神を、造ってください。私たちをエジプトの地から連れ上ったあのモーセという者が、どうなったのか、私たちにはわからないから。」","tok":[["民","みん"],["は"],["モーセ"],["が"],["山","やま"],["から"],["降りて","おりて"],["来る","くる"],["のに"],["手間取って","てまどって"],["いる"],["の"],["を"],["見て","みて"],["、"],["アロン"],["の"],["もと"],["に"],["集まり","あつまり"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["私たち","わたしたち"],["に"],["先立って","さきだって"],["行く","いく"],["神","かみ"],["を"],["、"],["造って","つくって"],["ください"],["。"],["私たち","わたしたち"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ上った","つれのぼった"],["あの"],["モーセ"],["と"],["いう"],["者","もの"],["が"],["、"],["どう"],["なった"],["の"],["か"],["、"],["私たち","わたしたち"],["に"],["は"],["わからない"],["から"],["。"],["」"]]},{"verse":2,"text":"それで、アロンは彼らに言った。「あなたがたの妻や、息子、娘たちの耳にある金の耳輪をはずして、私のところに持って来なさい。」","tok":[["それ"],["で"],["、"],["アロン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["妻","つま"],["や"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["の"],["耳","みみ"],["に"],["ある"],["金","かね"],["の"],["耳輪","みみわ"],["を"],["はずして"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["」"]]},{"verse":3,"text":"そこで、民はみな、その耳にある金の耳輪をはずして、アロンのところに持って来た。","tok":[["そこ"],["で"],["、"],["民","みん"],["は"],["みな"],["、"],["その"],["耳","みみ"],["に"],["ある"],["金","かね"],["の"],["耳輪","みみわ"],["を"],["はずして"],["、"],["アロン"],["の"],["ところ"],["に"],["持って","もって"],["来た","きた"],["。"]]},{"verse":4,"text":"彼がそれを、彼らの手から受け取り、のみで型を造り、鋳物の子牛にした。彼らは、「イスラエルよ。これがあなたをエジプトの地から連れ上ったあなたの神だ」と言った。","tok":[["彼","かれ"],["が"],["それ"],["を"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["受け取り","うけとり"],["、"],["のみ"],["で"],["型","かた"],["を"],["造り","つくり"],["、"],["鋳物","いもの"],["の"],["子牛","こうし"],["に"],["した"],["。"],["彼","かれ"],["ら"],["は"],["、"],["「"],["イスラエル"],["よ"],["。"],["これ"],["が"],["あなた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ上った","つれのぼった"],["あなた"],["の"],["神","かみ"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"アロンはこれを見て、その前に祭壇を築いた。そして、アロンは呼ばわって言った。「あすは主への祭りである。」","tok":[["アロン"],["は"],["これ"],["を"],["見て","みて"],["、"],["その"],["前","まえ"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"],["そして"],["、"],["アロン"],["は"],["呼ばわって","よばわって"],["言った","いった"],["。"],["「"],["あす"],["は"],["主","ぬし"],["へ"],["の"],["祭り","まつり"],["で"],["ある"],["。"],["」"]]},{"verse":6,"text":"そこで、翌日、朝早く彼らは全焼のいけにえをささげ、和解のいけにえを供えた。そして、民はすわっては、飲み食いし、立っては、戯れた。","tok":[["そこ"],["で"],["、"],["翌日","よくじつ"],["、"],["朝","あさ"],["早く","はやく"],["彼","かれ"],["ら"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["和解","わかい"],["の"],["いけにえ"],["を"],["供えた","そなえた"],["。"],["そして"],["、"],["民","みん"],["は"],["すわって"],["は"],["、"],["飲み食い","のみくい"],["し"],["、"],["立っ","たっ"],["ては"],["、"],["戯れた","たわむれた"],["。"]]},{"verse":7,"text":"主はモーセに仰せられた。「さあ、すぐ降りて行け。あなたがエジプトの地から連れ上ったあなたの民は、堕落してしまったから。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["さあ"],["、"],["すぐ"],["降りて","おりて"],["行け","いけ"],["。"],["あなた"],["が"],["エジプト"],["の"],["地","ち"],["から"],["連れ上った","つれのぼった"],["あなた"],["の"],["民","たみ"],["は"],["、"],["堕落","だらく"],["して"],["しまった"],["から"],["。"]]},{"verse":8,"text":"彼らは早くも、わたしが彼らに命じた道からはずれ、自分たちのために鋳物の子牛を造り、それを伏し拝み、それにいけにえをささげ、『イスラエルよ。これがあなたをエジプトの地から連れ上ったあなたの神だ』と言っている。」","tok":[["彼","かれ"],["ら"],["は"],["早く","はやく"],["も"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["道","みち"],["から"],["はずれ"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["鋳物","いもの"],["の"],["子牛","こうし"],["を"],["造り","つくり"],["、"],["それ"],["を"],["伏し拝み","ふしおがみ"],["、"],["それ"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["『"],["イスラエル"],["よ"],["。"],["これ"],["が"],["あなた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ上った","つれのぼった"],["あなた"],["の"],["神","かみ"],["だ"],["』"],["と"],["言って","いって"],["いる"],["。"],["」"]]},{"verse":9,"text":"主はまた、モーセに仰せられた。「わたしはこの民を見た。これは、実にうなじのこわい民だ。","tok":[["主","ぬし"],["は"],["また"],["、"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["この"],["民","たみ"],["を"],["見た","みた"],["。"],["これ"],["は"],["、"],["実","じつ"],["に"],["うなじ"],["の"],["こわい"],["民","たみ"],["だ"],["。"]]},{"verse":10,"text":"今はただ、わたしのするままにせよ。わたしの怒りが彼らに向かって燃え上がって、わたしが彼らを絶ち滅ぼすためだ。しかし、わたしはあなたを大いなる国民としよう。」","tok":[["今","いま"],["は"],["ただ"],["、"],["わたし"],["の"],["する"],["まま"],["に"],["せよ"],["。"],["わたし"],["の"],["怒り","いかり"],["が"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["燃え上がって","もえあがって"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["絶ち","たち"],["滅ぼす","ほろぼす"],["ため"],["だ"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["しよう"],["。"],["」"]]},{"verse":11,"text":"しかしモーセは、彼の神、主に嘆願して言った。「主よ。あなたが偉大な力と力強い御手をもって、エジプトの地から連れ出されたご自分の民に向かって、どうして、あなたは御怒りを燃やされるのですか。","tok":[["しかし"],["モーセ"],["は"],["、"],["彼","かれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["嘆願","たんがん"],["して"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["あなた"],["が"],["偉大","いだい"],["な"],["力","ちから"],["と"],["力強い","ちからづよい"],["御手","おて"],["を"],["もって"],["、"],["エジプト"],["の"],["地","ち"],["から"],["連れ出された","つれだされた"],["ご自分","ごじぶん"],["の"],["民","たみ"],["に"],["向かって","むかって"],["、"],["どう"],["して"],["、"],["あなた"],["は"],["御怒り","おいかり"],["を"],["燃やされる","もやされる"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"また、どうしてエジプト人が『神は彼らを山地で殺し、地の面から絶ち滅ぼすために、悪意をもって彼らを連れ出したのだ』と言うようにされるのですか。どうか、あなたの燃える怒りをおさめ、あなたの民へのわざわいを思い直してください。","tok":[["また"],["、"],["どう"],["して"],["エジプト"],["人","にん"],["が"],["『"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["山地","さんち"],["で"],["殺し","ころし"],["、"],["地","ち"],["の"],["面","めん"],["から"],["絶ち","たち"],["滅ぼす","ほろぼす"],["ため"],["に"],["、"],["悪意","あくい"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["連れ出した","つれだした"],["の"],["だ"],["』"],["と"],["言う","いう"],["よう"],["に"],["される"],["の"],["です"],["か"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["燃える","もえる"],["怒り","いかり"],["を"],["おさめ"],["、"],["あなた"],["の"],["民","たみ"],["へ"],["の"],["わざわい"],["を"],["思い直して","おもいなおして"],["ください"],["。"]]},{"verse":13,"text":"あなたのしもべアブラハム、イサク、イスラエルを覚えてください。あなたはご自身にかけて彼らに誓い、そうして、彼らに、『わたしはあなたがたの子孫を空の星のようにふやし、わたしが約束したこの地をすべて、あなたがたの子孫に与え、彼らは永久にこれを相続地とするようになる』と仰せられたのです。」","tok":[["あなた"],["の"],["しもべ"],["アブラハム"],["、"],["イサク"],["、"],["イスラエル"],["を"],["覚えて","おぼえて"],["ください"],["。"],["あなた"],["は"],["ご自身","ごじしん"],["に"],["かけて"],["彼","かれ"],["ら"],["に"],["誓い","ちかい"],["、"],["そう"],["して"],["、"],["彼","かれ"],["ら"],["に"],["、"],["『"],["わたし"],["は"],["あなた"],["がた"],["の"],["子孫","しそん"],["を"],["空","そら"],["の"],["星","ほし"],["の"],["よう"],["に"],["ふやし"],["、"],["わたし"],["が"],["約束","やくそく"],["した"],["この"],["地","ち"],["を"],["すべて"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["に"],["与え","あたえ"],["、"],["彼","かれ"],["ら"],["は"],["永久","えいきゅう"],["に"],["これ"],["を"],["相続","そうぞく"],["地","ち"],["と"],["する"],["よう"],["に"],["なる"],["』"],["と"],["仰せられた","おおせられた"],["の"],["です"],["。"],["」"]]},{"verse":14,"text":"すると、主はその民に下すと仰せられたわざわいを思い直された。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["その"],["民","たみ"],["に"],["下す","くだす"],["と"],["仰せられた","おおせられた"],["わざわい"],["を"],["思い直された","おもいなおされた"],["。"]]},{"verse":15,"text":"モーセは向き直り、二枚のあかしの板を手にして山から降りた。板は両面から書いてあった。すなわち、表と裏に書いてあった。","tok":[["モーセ"],["は"],["向き直り","むきなおり"],["、"],["二枚","にまい"],["の"],["あかし"],["の"],["板","いた"],["を"],["手","て"],["に"],["して"],["山","やま"],["から"],["降りた","おりた"],["。"],["板","いた"],["は"],["両面","りょうめん"],["から"],["書いて","かいて"],["あった"],["。"],["すなわち"],["、"],["表","ひょう"],["と"],["裏","うら"],["に"],["書いて","かいて"],["あった"],["。"]]},{"verse":16,"text":"板はそれ自体神の作であった。その字は神の字であって、その板に刻まれていた。","tok":[["板","いた"],["は"],["それ"],["自体","じたい"],["神","かみ"],["の"],["作","さく"],["で"],["あった"],["。"],["その"],["字","じ"],["は"],["神","かみ"],["の"],["字","じ"],["で"],["あって"],["、"],["その"],["板","いた"],["に"],["刻まれて","きざまれて"],["いた"],["。"]]},{"verse":17,"text":"ヨシュアは民の叫ぶ大声を聞いて、モーセに言った。「宿営の中にいくさの声がします。」","tok":[["ヨシュア"],["は"],["民","みん"],["の"],["叫ぶ","さけぶ"],["大声","おおごえ"],["を"],["聞いて","きいて"],["、"],["モーセ"],["に"],["言った","いった"],["。"],["「"],["宿営","しゅくえい"],["の"],["中","なか"],["に"],["いくさ"],["の"],["声","こえ"],["が"],["します"],["。"],["」"]]},{"verse":18,"text":"するとモーセは言った。「それは勝利を叫ぶ声ではなく、敗北を嘆く声でもない。私の聞くのは、歌を歌う声である。」","tok":[["する"],["と"],["モーセ"],["は"],["言った","いった"],["。"],["「"],["それ"],["は"],["勝利","しょうり"],["を"],["叫ぶ","さけぶ"],["声","こえ"],["で"],["は"],["なく"],["、"],["敗北","はいぼく"],["を"],["嘆く","なげく"],["声","こえ"],["で"],["も"],["ない"],["。"],["私","わたくし"],["の"],["聞く","きく"],["の"],["は"],["、"],["歌","うた"],["を"],["歌う","うたう"],["声","こえ"],["で"],["ある"],["。"],["」"]]},{"verse":19,"text":"宿営に近づいて、子牛と踊りを見るなり、モーセの怒りは燃え上がった。そして手からあの板を投げ捨て、それを山のふもとで砕いてしまった。","tok":[["宿営","しゅくえい"],["に"],["近づいて","ちかづいて"],["、"],["子牛","こうし"],["と"],["踊り","おどり"],["を"],["見る","みる"],["なり"],["、"],["モーセ"],["の"],["怒り","いかり"],["は"],["燃え上がった","もえあがった"],["。"],["そして"],["手","て"],["から"],["あの"],["板","いた"],["を"],["投げ捨て","なげすて"],["、"],["それ"],["を"],["山","やま"],["の"],["ふもと"],["で"],["砕いて","くだいて"],["しまった"],["。"]]},{"verse":20,"text":"それから、彼らが造った子牛を取り、これを火で焼き、さらにそれを粉々に砕き、それを水の上にまき散らし、イスラエル人に飲ませた。","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["造った","つくった"],["子牛","こうし"],["を"],["取り","とり"],["、"],["これ"],["を"],["火","ひ"],["で"],["焼き","やき"],["、"],["さらに"],["それ"],["を"],["粉々","こなごな"],["に"],["砕き","くだき"],["、"],["それ"],["を"],["水","みず"],["の"],["上","うえ"],["に"],["まき散らし","まきちらし"],["、"],["イスラエル"],["人","にん"],["に"],["飲ませた","のませた"],["。"]]},{"verse":21,"text":"モーセはアロンに言った。「この民はあなたに何をしたのですか。あなたが彼らにこんな大きな罪を犯させたのは。」","tok":[["モーセ"],["は"],["アロン"],["に"],["言った","いった"],["。"],["「"],["この"],["民","みん"],["は"],["あなた"],["に"],["何","なん"],["を"],["した"],["の"],["です"],["か"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["こんな"],["大きな","おおきな"],["罪","つみ"],["を"],["犯させた","おかさせた"],["の"],["は"],["。"],["」"]]},{"verse":22,"text":"アロンは言った。「わが主よ。どうか怒りを燃やさないでください。あなた自身、民の悪いのを知っているでしょう。","tok":[["アロン"],["は"],["言った","いった"],["。"],["「"],["わが"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["怒り","いかり"],["を"],["燃やさないで","もやさないで"],["ください"],["。"],["あなた"],["自身","じしん"],["、"],["民","みん"],["の"],["悪い","わるい"],["の"],["を"],["知って","しって"],["いるでしょう"],["。"]]},{"verse":23,"text":"彼らは私に言いました。『私たちに先立って行く神を、造ってくれ。私たちをエジプトの地から連れ上ったあのモーセという者が、どうなったのか、私たちにはわからないから。』","tok":[["彼","かれ"],["ら"],["は"],["私","わたくし"],["に"],["言いました","いいました"],["。"],["『"],["私たち","わたしたち"],["に"],["先立って","さきだって"],["行く","いく"],["神","かみ"],["を"],["、"],["造って","つくって"],["くれ"],["。"],["私たち","わたしたち"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ上った","つれのぼった"],["あの"],["モーセ"],["と"],["いう"],["者","もの"],["が"],["、"],["どう"],["なった"],["の"],["か"],["、"],["私たち","わたしたち"],["に"],["は"],["わからない"],["から"],["。"],["』"]]},{"verse":24,"text":"それで、私は彼らに、『だれでも、金を持っている者は私のために、それを取りはずせ』と言いました。彼らはそれを私に渡したので、私がこれを火に投げ入れたところ、この子牛が出て来たのです。」","tok":[["それ"],["で"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["に"],["、"],["『"],["だれ"],["で"],["も"],["、"],["金","きん"],["を"],["持って","もって"],["いる"],["者","もの"],["は"],["私","わたくし"],["の"],["ため"],["に"],["、"],["それ"],["を"],["取りはずせ","とりはずせ"],["』"],["と"],["言いました","いいました"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["私","わたくし"],["に"],["渡した","わたした"],["ので"],["、"],["私","わたくし"],["が"],["これ"],["を"],["火","ひ"],["に"],["投げ入れた","なげいれた"],["ところ"],["、"],["この"],["子牛","こうし"],["が"],["出て","でて"],["来た","きた"],["の"],["です"],["。"],["」"]]},{"verse":25,"text":"モーセは、民が乱れており、アロンが彼らをほうっておいたので、敵の物笑いとなっているのを見た。","tok":[["モーセ"],["は"],["、"],["民","みん"],["が"],["乱れて","みだれて"],["おり"],["、"],["アロン"],["が"],["彼","かれ"],["ら"],["を"],["ほうって"],["おいた"],["ので"],["、"],["敵","てき"],["の"],["物笑い","ものわらい"],["と"],["なって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":26,"text":"そこでモーセは宿営の入口に立って「だれでも、主につく者は、私のところに」と言った。するとレビ族がみな、彼のところに集まった。","tok":[["そこ"],["で"],["モーセ"],["は"],["宿営","しゅくえい"],["の"],["入口","いりぐち"],["に"],["立って","たって"],["「"],["だれ"],["で"],["も"],["、"],["主に","おもに"],["つく"],["者","もの"],["は"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["レビ族","れびぞく"],["が"],["みな"],["、"],["彼","かれ"],["の"],["ところ"],["に"],["集まった","あつまった"],["。"]]},{"verse":27,"text":"そこで、モーセは彼らに言った。「イスラエルの神、主はこう仰せられる。おのおの腰に剣を帯び、宿営の中を入口から入口へ行き巡って、おのおのその兄弟、その友、その隣人を殺せ。」","tok":[["そこ"],["で"],["、"],["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["おのおの"],["腰","こし"],["に"],["剣","けん"],["を"],["帯び","おび"],["、"],["宿営","しゅくえい"],["の"],["中","なか"],["を"],["入口","いりぐち"],["から"],["入口","いりぐち"],["へ"],["行き","いき"],["巡って","めぐって"],["、"],["おのおの"],["その"],["兄弟","きょうだい"],["、"],["その"],["友","とも"],["、"],["その"],["隣人","りんじん"],["を"],["殺せ","ころせ"],["。"],["」"]]},{"verse":28,"text":"レビ族は、モーセのことばどおりに行った。その日、民のうち、おおよそ三千人が倒れた。","tok":[["レビ族","れびぞく"],["は"],["、"],["モーセ"],["の"],["ことば"],["どおり"],["に"],["行った","いった"],["。"],["その"],["日","ひ"],["、"],["民","みん"],["の"],["うち"],["、"],["おおよそ"],["三千人","さんせんにん"],["が"],["倒れた","たおれた"],["。"]]},{"verse":29,"text":"そこで、モーセは言った。「あなたがたは、おのおのその子、その兄弟に逆らっても、きょう、主に身をささげよ。主が、きょう、あなたがたに祝福をお与えになるために。」","tok":[["そこ"],["で"],["、"],["モーセ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["おのおの"],["その"],["子","こ"],["、"],["その"],["兄弟","きょうだい"],["に"],["逆らって","さからって"],["も"],["、"],["きょう"],["、"],["主に","おもに"],["身","み"],["を"],["ささげ"],["よ"],["。"],["主","ぬし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["祝福","しゅくふく"],["を"],["お与え","おあたえ"],["に"],["なる"],["ため"],["に"],["。"],["」"]]},{"verse":30,"text":"翌日になって、モーセは民に言った。「あなたがたは大きな罪を犯した。それで今、私は主のところに上って行く。たぶんあなたがたの罪のために贖うことができるでしょう。」","tok":[["翌日","よくじつ"],["に"],["なって"],["、"],["モーセ"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["大きな","おおきな"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["それ"],["で"],["今","いま"],["、"],["私","わたくし"],["は"],["主","ぬし"],["の"],["ところ"],["に"],["上って","のぼって"],["行く","いく"],["。"],["たぶん"],["あなた"],["がた"],["の"],["罪","つみ"],["の"],["ため"],["に"],["贖う","あがなう"],["こと"],["が"],["できるでしょう"],["。"],["」"]]},{"verse":31,"text":"そこでモーセは主のところに戻って、申し上げた。「ああ、この民は大きな罪を犯してしまいました。自分たちのために金の神を造ったのです。","tok":[["そこ"],["で"],["モーセ"],["は"],["主","ぬし"],["の"],["ところ"],["に"],["戻って","もどって"],["、"],["申し上げた","もうしあげた"],["。"],["「"],["ああ"],["、"],["この"],["民","みん"],["は"],["大きな","おおきな"],["罪","つみ"],["を"],["犯して","おかして"],["しまいました"],["。"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["金","かね"],["の"],["神","かみ"],["を"],["造った","つくった"],["の"],["です"],["。"]]},{"verse":32,"text":"今、もし、彼らの罪をお赦しくだされるものなら――。しかし、もしも、かないませんなら、どうか、あなたがお書きになったあなたの書物から、私の名を消し去ってください。」","tok":[["今","いま"],["、"],["もし"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["お赦し","おゆるし"],["くだされる"],["もの"],["なら"],["―"],["―"],["。"],["しかし"],["、"],["もし"],["も"],["、"],["かないませんなら"],["、"],["どう"],["か"],["、"],["あなた"],["が"],["お書き","おかき"],["に"],["なった"],["あなた"],["の"],["書物","しょもつ"],["から"],["、"],["私","わたくし"],["の"],["名","な"],["を"],["消し去って","けしさって"],["ください"],["。"],["」"]]},{"verse":33,"text":"すると主はモーセに仰せられた。「わたしに罪を犯した者はだれであれ、わたしの書物から消し去ろう。","tok":[["する"],["と"],["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["は"],["だれ"],["で"],["あれ"],["、"],["わたし"],["の"],["書物","しょもつ"],["から"],["消し去ろう","けしさろう"],["。"]]},{"verse":34,"text":"しかし、今は行って、わたしがあなたに告げた場所に、民を導け。見よ。わたしの使いが、あなたの前を行く。わたしのさばきの日にわたしが彼らの罪をさばく。」","tok":[["しかし"],["、"],["今","いま"],["は"],["行って","いって"],["、"],["わたし"],["が"],["あなた"],["に"],["告げた","つげた"],["場所","ばしょ"],["に"],["、"],["民","みん"],["を"],["導け","みちびけ"],["。"],["見","み"],["よ"],["。"],["わたし"],["の"],["使い","つかい"],["が"],["、"],["あなた"],["の"],["前","まえ"],["を"],["行く","いく"],["。"],["わたし"],["の"],["さばき"],["の"],["日","ひ"],["に"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["さばく"],["。"],["」"]]},{"verse":35,"text":"こうして、主は民を打たれた。アロンが造った子牛を彼らが礼拝したからである。","tok":[["こう"],["して"],["、"],["主","ぬし"],["は"],["民","みん"],["を"],["打たれた","うたれた"],["。"],["アロン"],["が"],["造った","つくった"],["子牛","こうし"],["を"],["彼","かれ"],["ら"],["が"],["礼拝","れいはい"],["した"],["から"],["で"],["ある"],["。"]]}]
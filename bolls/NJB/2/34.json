[{"verse":1,"text":"主はモーセに仰せられた。「前のと同じような二枚の石の板を、切り取れ。わたしは、あなたが砕いたこの前の石の板にあったあのことばを、その石の板の上に書きしるそう。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["前","まえ"],["の"],["と"],["同じ","おなじ"],["よう"],["な"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["を"],["、"],["切り取れ","きりとれ"],["。"],["わたし"],["は"],["、"],["あなた"],["が"],["砕いた","くだいた"],["この"],["前","まえ"],["の"],["石","いし"],["の"],["板","いた"],["に"],["あった"],["あの"],["ことば"],["を"],["、"],["その"],["石","いし"],["の"],["板","いた"],["の"],["上","うえ"],["に"],["書きしるそう","かきしるそう"],["。"]]},{"verse":2,"text":"朝までに準備をし、朝シナイ山に登って、その山の頂でわたしの前に立て。","tok":[["朝","あさ"],["まで"],["に"],["準備","じゅんび"],["を"],["し"],["、"],["朝","あさ"],["シナイ"],["山","やま"],["に"],["登って","のぼって"],["、"],["その"],["山","やま"],["の"],["頂","いただき"],["で"],["わたし"],["の"],["前","まえ"],["に"],["立て","たて"],["。"]]},{"verse":3,"text":"だれも、あなたといっしょに登ってはならない。また、だれも、山のどこにも姿を見せてはならない。また、羊や牛であっても、その山のふもとで草を食べていてはならない。」","tok":[["だれ"],["も"],["、"],["あなた"],["と"],["いっしょ"],["に"],["登って","のぼって"],["は"],["ならない"],["。"],["また"],["、"],["だれ"],["も"],["、"],["山","やま"],["の"],["どこ"],["に"],["も"],["姿","すがた"],["を"],["見せて","みせて"],["は"],["ならない"],["。"],["また"],["、"],["羊","ひつじ"],["や"],["牛","うし"],["で"],["あって"],["も"],["、"],["その"],["山","やま"],["の"],["ふもと"],["で"],["草","くさ"],["を"],["食べて","たべて"],["いて"],["は"],["ならない"],["。"],["」"]]},{"verse":4,"text":"そこで、モーセは前のと同じような二枚の石の板を切り取り、翌朝早く、主が命じられたとおりに、二枚の石の板を手に持って、シナイ山に登った。","tok":[["そこ"],["で"],["、"],["モーセ"],["は"],["前","まえ"],["の"],["と"],["同じ","おなじ"],["よう"],["な"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["を"],["切り取り","きりとり"],["、"],["翌朝","よくあさ"],["早く","はやく"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["を"],["手","て"],["に"],["持って","もって"],["、"],["シナイ"],["山","やま"],["に"],["登った","のぼった"],["。"]]},{"verse":5,"text":"主は雲の中にあって降りて来られ、彼とともにそこに立って、主の名によって宣言された。","tok":[["主","ぬし"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["あって"],["降りて","おりて"],["来られ","こられ"],["、"],["彼","かれ"],["と"],["とも"],["に"],["そこ"],["に"],["立って","たって"],["、"],["主","ぬし"],["の
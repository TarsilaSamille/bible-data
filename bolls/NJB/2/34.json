["。"],["「"],["今","いま"],["ここ"],["で"],["、"],["わたし"],["は"],["契約","けいやく"],["を"],["結ぼう","むすぼう"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["民","みん"],["すべて"],["の"],["前","まえ"],["で"],["、"],["地","ち"],["の"],["どこ"],["に"],["おいて"],["も"],["、"],["また"],["、"],["どの"],["国々","くにぐに"],["の"],["うち"],["に"],["おいて"],["も"],["、"],["かつて"],["なされた"],["こと"],["の"],["ない"],["奇しい","くすしい"],["こと"],["を"],["行おう","おこなおう"],["。"],["あなた"],["と"],["とも"],["に"],["いる"],["この"],["民","みん"],["は"],["みな"],["、"],["主","ぬし"],["の"],["わざ"],["を"],["見るで","みるで"],["あろう"],["。"],["わたし"],["が"],["あなた"],["と"],["とも"],["に"],["行う","おこなう"],["こと"],["は"],["恐るべき","おそるべき"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしがきょう、あなたに命じることを、守れ。見よ。わたしはエモリ人、カナン人、ヘテ人、ペリジ人、ヒビ人、エブス人を、あなたの前から追い払う。","tok":[["わたし"],["が"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["こと"],["を"],["、"],["守れ","まもれ"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["エモリ人","えもりにん"],["、"],["カナン人","かなんにん"],["、"],["ヘテ人","へてにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス"],["人","ひと"],["を"],["、"],["あなた"],["の"],["前","まえ"],["から"],["追い払う","おいはらう"],["。"]]},{"verse":12,"text":"あなたは、注意して、あなたが入って行くその地の住民と契約を結ばないようにせよ。それがあなたの間で、わなとならないように。","tok":[["あなた"],["は"],["、"],["注意","ちゅうい"],["して"],["、"],["あなた"],["が"],["入って","はいって"],["行く","いく"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["と"],["契約","けいやく"],["を"],["結ばない","むすばない"],["よう"],["に"],["せよ"],["。"],["それ"],["が"],["あなた"],["の"],["間","あいだ"],["で"],["、"],["わな"],["と"],["ならない"],["よう"],["に"],["。"]]},{"verse":13,"text":"いや、あなたがたは彼らの祭壇を取りこわし、彼らの石柱を打ち砕き、アシェラ像を切り倒さなければならない。","tok":[["いや"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["を"],["取りこわし","とりこわし"],["、"],["彼","かれ"],["ら"],["の"],["石柱","せきちゅう"],["を"],["打ち砕き","うちくだき"],["、"],["アシェラ"],["像","ぞう"],["を"],["切り倒さなければ","きりたおさなければ"],["ならない"],["。"]]},{"verse":14,"text":"あなたはほかの神を拝んではならないからである。その名がねたみである主は、ねたむ神であるから。","tok":[["あなた"],["は"],["ほか"],["の"],["神","かみ"],["を"],["拝んで","おがんで"],["は"],["ならない"],["から"],["で"],["ある"],["。"],["その"],["名","な"],["が"],["ねたみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["ねたむ
[{"verse":1,"text":"さて、レビの家のひとりの人がレビ人の娘をめとった。","tok":[["さて"],["、"],["レビ"],["の"],["家","いえ"],["の"],["ひとり"],["の"],["人","ひと"],["が"],["レビ人","れびにん"],["の"],["娘","むすめ"],["を"],["めとった"],["。"]]},{"verse":2,"text":"女はみごもって、男の子を産んだが、そのかわいいのを見て、三か月の間その子を隠しておいた。","tok":[["女","おんな"],["は"],["みごもって"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["が"],["、"],["その"],["かわいい"],["の"],["を"],["見て","みて"],["、"],["三","さん"],["か月","かげつ"],["の"],["間","あいだ"],["その"],["子","こ"],["を"],["隠して","かくして"],["おいた"],["。"]]},{"verse":3,"text":"しかしもう隠しきれなくなったので、パピルス製のかごを手に入れ、それに瀝青と樹脂とを塗って、その子を中に入れ、ナイルの岸の葦の茂みの中に置いた。","tok":[["しかし"],["もう"],["隠し","かくし"],["きれなく"],["なった"],["ので"],["、"],["パピルス"],["製","せい"],["の"],["かご"],["を"],["手","て"],["に"],["入れ","いれ"],["、"],["それ"],["に"],["瀝青","れきせい"],["と"],["樹脂","じゅし"],["と"],["を"],["塗って","ぬって"],["、"],["その"],["子","こ"],["を"],["中","なか"],["に"],["入れ","いれ"],["、"],["ナイル"],["の"],["岸","きし"],["の"],["葦","あし"],["の"],["茂み","しげみ"],["の"],["中","なか"],["に"],["置いた","おいた"],["。"]]},{"verse":4,"text":"その子の姉が、その子がどうなるかを知ろうとして、遠く離れて立っていたとき、","tok":[["その"],["子","こ"],["の"],["姉","あね"],["が"],["、"],["その"],["子","こ"],["が"],["どう"],["なる"],["か"],["を"],["知ろう","しろう"],["として"],["、"],["遠く","とおく"],["離れて","はなれて"],["立って","たって"],["いた"],["とき"],["、"]]},{"verse":5,"text":"パロの娘が水浴びをしようとナイルに降りて来た。彼女の侍女たちはナイルの川辺を歩いていた。彼女は葦の茂みにかごがあるのを見、はしためをやって、それを取って来させた。","tok":[["パロ"],["の"],["娘","むすめ"],["が"],["水浴び","みずあび"],["を"],["しよう"],["と"],["ナイル"],["に"],["降りて","おりて"],["来た","きた"],["。"],["彼女","かのじょ"],["の"],["侍女","じじょ"],["たち"],["は"],["ナイル"],["の"],["川辺","かわべ"],["を"],["歩いて","あるいて"],["いた"],["。"],["彼女","かのじょ"],["は"],["葦","あし"],["の"],["茂み","しげみ"],["に"],["かご"],["が"],["ある"],["の"],["を"],["見","み"],["、"],["はし"],["ため"],["を"],["やって"],["、"],["それ"],["を"],["取って","とって"],["来させた","きさせた"],["。"]]},{"verse":6,"text":"それをあけると、子どもがいた。なんと、それは男の子で、泣いていた。彼女はその子をあわれに思い、「これはきっとヘブル人の子どもです」と言った。","tok":[["それ"],["を"],["あける"],["と"],["、"],["子ども","こども"],["が"],["いた"],["。"],["なん"],["と"],["、"],["それ"],["は"],["男の子","おとこのこ"],["で"],["、"],["泣いて","ないて"],["いた"],["。"],["彼女","かのじょ"],["は"],["その"],["子","こ"],["を"],["あわれ"],["に"],["思い","おもい"],["、"],["「"],["これ"],["は"],["きっと"],["ヘブル人","へぶるにん"],["の"],["子ども","こども"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"そのとき、その子の姉がパロの娘に言った。「あなたに代わって、その子に乳を飲ませるため、私が行って、ヘブル女のうばを呼んでまいりましょうか。」","tok":[["その"],["とき"],["、"],["その"],["子","こ"],["の"],["姉","あね"],["が"],["パロ"],["の"],["娘","むすめ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["に"],["代わって","かわって"],["、"],["その"],["子","こ"],["に"],["乳","ちち"],["を"],["飲ませる","のませる"],["ため"],["、"],["私","わたくし"],["が"],["行って","いって"],["、"],["ヘブル"],["女","おんな"],["の"],["うば"],["を"],["呼んで","よんで"],["まいりましょう"],["か"],["。"],["」"]]},{"verse":8,"text":"パロの娘が「そうしておくれ」と言ったので、おとめは行って、その子の母を呼んで来た。","tok":[["パロ"],["の"],["娘","むすめ"],["が"],["「"],["そう"],["して"],["おくれ"],["」"],["と"],["言った","いった"],["ので"],["、"],["おとめ"],["は"],["行って","いって"],["、"],["その"],["子","こ"],["の"],["母","はは"],["を"],["呼んで","よんで"],["来た","きた"],["。"]]},{"verse":9,"text":"パロの娘は彼女に言った。「この子を連れて行き、私に代わって乳を飲ませてください。私があなたの賃金を払いましょう。」それで、その女はその子を引き取って、乳を飲ませた。","tok":[["パロ"],["の"],["娘","むすめ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["この"],["子","こ"],["を"],["連れて","つれて"],["行き","いき"],["、"],["私","わたくし"],["に"],["代わって","かわって"],["乳","ちち"],["を"],["飲ませて","のませて"],["ください"],["。"],["私","わたくし"],["が"],["あなた"],["の"],["賃金","ちんぎん"],["を"],["払いましょう","はらいましょう"],["。"],["」"],["それ"],["で"],["、"],["その"],["女","おんな"],["は"],["その"],["子","こ"],["を"],["引き取って","ひきとって"],["、"],["乳","ちち"],["を"],["飲ませた","のませた"],["。"]]},{"verse":10,"text":"その子が大きくなったとき、女はその子をパロの娘のもとに連れて行った。その子は王女の息子になった。彼女はその子をモーセと名づけた。彼女は、「水の中から、私がこの子を引き出したのです」と言ったからである。","tok":[["その"],["子","こ"],["が"],["大きく","おおきく"],["なった"],["とき"],["、"],["女","おんな"],["は"],["その"],["子","こ"],["を"],["パロ"],["の"],["娘","むすめ"],["の"],["もと"],["に"],["連れて","つれて"],["行った","いった"],["。"],["その"],["子","こ"],["は"],["王女","おうじょ"],["の"],["息子","むすこ"],["に"],["なった"],["。"],["彼女","かのじょ"],["は"],["その"],["子","こ"],["を"],["モーセ"],["と"],["名づけた","なづけた"],["。"],["彼女","かのじょ"],["は"],["、"],["「"],["水","みず"],["の"],["中","なか"],["から"],["、"],["私","わたくし"],["が"],["この"],["子","こ"],["を"],["引き出した","ひきだした"],["の"],["です"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"こうして日がたち、モーセがおとなになったとき、彼は同胞のところへ出て行き、その苦役を見た。そのとき、自分の同胞であるひとりのヘブル人を、あるエジプト人が打っているのを見た。","tok":[["こう"],["して"],["日","ひ"],["が"],["たち"],["、"],["モーセ"],["が"],["おとな"],["に"],["なった"],["とき"],["、"],["彼","かれ"],["は"],["同胞","どうほう"],["の"],["ところ"],["へ"],["出て","でて"],["行き","いき"],["、"],["その"],["苦役","くえき"],["を"],["見た","みた"],["。"],["その"],["とき"],["、"],["自分","じぶん"],["の"],["同胞","どうほう"],["で"],["ある"],["ひとり"],["の"],["ヘブル人","へぶるにん"],["を"],["、"],["ある"],["エジプト"],["人","にん"],["が"],["打って","うって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":12,"text":"あたりを見回し、ほかにだれもいないのを見届けると、彼はそのエジプト人を打ち殺し、これを砂の中に隠した。","tok":[["あたり"],["を"],["見回し","みまわし"],["、"],["ほか"],["に"],["だれ"],["も"],["いない"],["の"],["を"],["見届ける","みとどける"],["と"],["、"],["彼","かれ"],["は"],["その"],["エジプト"],["人","にん"],["を"],["打ち殺し","うちころし"],["、"],["これ"],["を"],["砂","すな"],["の"],["中","なか"],["に"],["隠した","かくした"],["。"]]},{"verse":13,"text":"次の日、また外に出てみると、なんと、ふたりのヘブル人が争っているではないか。そこで彼は悪いほうに「なぜ自分の仲間を打つのか」と言った。","tok":[["次","つぎ"],["の"],["日","ひ"],["、"],["また"],["外","そと"],["に"],["出て","でて"],["みる"],["と"],["、"],["なん"],["と"],["、"],["ふたり"],["の"],["ヘブル人","へぶるにん"],["が"],["争って","あらそって"],["いるで"],["は"],["ない"],["か"],["。"],["そこ"],["で"],["彼","かれ"],["は"],["悪い","わるい"],["ほう"],["に"],["「"],["なぜ"],["自分","じぶん"],["の"],["仲間","なかま"],["を"],["打つ","うつ"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"するとその男は、「だれがあなたを私たちのつかさやさばきつかさにしたのか。あなたはエジプト人を殺したように、私も殺そうと言うのか」と言った。そこでモーセは恐れて、きっとあのことが知れたのだと思った。","tok":[["する"],["と"],["その"],["男","おとこ"],["は"],["、"],["「"],["だれ"],["が"],["あなた"],["を"],["私たち","わたしたち"],["の"],["つかさ"],["や"],["さばき"],["つかさ"],["に"],["した"],["の"],["か"],["。"],["あなた"],["は"],["エジプト"],["人","にん"],["を"],["殺した","ころした"],["よう"],["に"],["、"],["私","わたくし"],["も"],["殺そう","ころそう"],["と"],["言う","いう"],["の"],["か"],["」"],["と"],["言った","いった"],["。"],["そこ"],["で"],["モーセ"],["は"],["恐れて","おそれて"],["、"],["きっと"],["あの"],["こと"],["が"],["知れた","しれた"],["の"],["だ"],["と"],["思った","おもった"],["。"]]},{"verse":15,"text":"パロはこのことを聞いて、モーセを殺そうと捜し求めた。しかし、モーセはパロのところからのがれ、ミデヤンの地に住んだ。彼は井戸のかたわらにすわっていた。","tok":[["パロ"],["は"],["この"],["こと"],["を"],["聞いて","きいて"],["、"],["モーセ"],["を"],["殺そう","ころそう"],["と"],["捜し求めた","さがしもとめた"],["。"],["しかし"],["、"],["モーセ"],["は"],["パロ"],["の"],["ところ"],["から"],["のがれ"],["、"],["ミデヤン"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["。"],["彼","かれ"],["は"],["井戸","いど"],["の"],["かたわら"],["に"],["すわって"],["いた"],["。"]]},{"verse":16,"text":"ミデヤンの祭司に七人の娘がいた。彼女たちが父の羊の群れに水を飲ませるために来て、水を汲み、水ぶねに満たしていたとき、","tok":[["ミデヤン"],["の"],["祭司","さいし"],["に"],["七人","しちにん"],["の"],["娘","むすめ"],["が"],["いた"],["。"],["彼女","かのじょ"],["たち"],["が"],["父","ちち"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["に"],["水","みず"],["を"],["飲ませる","のませる"],["ため"],["に"],["来て","きて"],["、"],["水","みず"],["を"],["汲み","くみ"],["、"],["水","みず"],["ぶね"],["に"],["満たして","みたして"],["いた"],["とき"],["、"]]},{"verse":17,"text":"羊飼いたちが来て、彼女たちを追い払った。すると、モーセは立ち上がり、彼女たちを救い、その羊の群れに水を飲ませた。","tok":[["羊飼い","ひつじかい"],["たち"],["が"],["来て","きて"],["、"],["彼女","かのじょ"],["たち"],["を"],["追い払った","おいはらった"],["。"],["する"],["と"],["、"],["モーセ"],["は"],["立ち上がり","たちあがり"],["、"],["彼女","かのじょ"],["たち"],["を"],["救い","すくい"],["、"],["その"],["羊","ひつじ"],["の"],["群れ","むれ"],["に"],["水","みず"],["を"],["飲ませた","のませた"],["。"]]},{"verse":18,"text":"彼女たちが父レウエルのところに帰ったとき、父は言った。「どうしてきょうはこんなに早く帰って来たのか。」","tok":[["彼女","かのじょ"],["たち"],["が"],["父","ちち"],["レウエル"],["の"],["ところ"],["に"],["帰った","かえった"],["とき"],["、"],["父","ちち"],["は"],["言った","いった"],["。"],["「"],["どう"],["して"],["きょう"],["は"],["こんな"],["に"],["早く","はやく"],["帰って","かえって"],["来た","きた"],["の"],["か"],["。"],["」"]]},{"verse":19,"text":"彼女たちは答えた。「ひとりのエジプト人が私たちを羊飼いたちの手から救い出してくれました。そのうえその人は、私たちのために水まで汲み、羊の群れに飲ませてくれました。」","tok":[["彼女","かのじょ"],["たち"],["は"],["答えた","こたえた"],["。"],["「"],["ひとり"],["の"],["エジプト"],["人","にん"],["が"],["私たち","わたしたち"],["を"],["羊飼い","ひつじかい"],["たち"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["くれました"],["。"],["その"],["うえ"],["その"],["人","ひと"],["は"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["水","みず"],["まで"],["汲み","くみ"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["に"],["飲ませて","のませて"],["くれました"],["。"],["」"]]},{"verse":20,"text":"父は娘たちに言った。「その人はどこにいるのか。どうしてその人を置いて来てしまったのか。食事をあげるためにその人を呼んで来なさい。」","tok":[["父","ちち"],["は"],["娘","むすめ"],["たち"],["に"],["言った","いった"],["。"],["「"],["その"],["人","ひと"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["どう"],["して"],["その"],["人","ひと"],["を"],["置いて","おいて"],["来て","きて"],["しまった"],["の"],["か"],["。"],["食事","しょくじ"],["を"],["あげる"],["ため"],["に"],["その"],["人","ひと"],["を"],["呼んで","よんで"],["来","き"],["なさい"],["。"],["」"]]},{"verse":21,"text":"モーセは、思い切ってこの人といっしょに住むようにした。そこでその人は娘のチッポラをモーセに与えた。","tok":[["モーセ"],["は"],["、"],["思い切って","おもいきって"],["この"],["人","ひと"],["と"],["いっしょ"],["に"],["住む","すむ"],["よう"],["に"],["した"],["。"],["そこ"],["で"],["その"],["人","ひと"],["は"],["娘","むすめ"],["の"],["チッポラ"],["を"],["モーセ"],["に"],["与えた","あたえた"],["。"]]},{"verse":22,"text":"彼女は男の子を産んだ。彼はその子をゲルショムと名づけた。「私は外国にいる寄留者だ」と言ったからである。","tok":[["彼女","かのじょ"],["は"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["彼","かれ"],["は"],["その"],["子","こ"],["を"],["ゲルショム"],["と"],["名づけた","なづけた"],["。"],["「"],["私","わたくし"],["は"],["外国","がいこく"],["に"],["いる"],["寄留者","きりゅうしゃ"],["だ"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"それから何年もたって、エジプトの王は死んだ。イスラエル人は労役にうめき、わめいた。彼らの労役の叫びは神に届いた。","tok":[["それ"],["から"],["何","なん"],["年","ねん"],["も"],["たって"],["、"],["エジプト"],["の"],["王","おう"],["は"],["死んだ","しんだ"],["。"],["イスラエル"],["人","にん"],["は"],["労役","ろうえき"],["に"],["うめき"],["、"],["わめいた"],["。"],["彼","かれ"],["ら"],["の"],["労役","ろうえき"],["の"],["叫び","さけび"],["は"],["神","かみ"],["に"],["届いた","とどいた"],["。"]]},{"verse":24,"text":"神は彼らの嘆きを聞かれ、アブラハム、イサク、ヤコブとの契約を思い起こされた。","tok":[["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["嘆き","なげき"],["を"],["聞かれ","きかれ"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["と"],["の"],["契約","けいやく"],["を"],["思い起こされた","おもいおこされた"],["。"]]},{"verse":25,"text":"神はイスラエル人をご覧になった。神はみこころを留められた。","tok":[["神","かみ"],["は"],["イスラエル"],["人","にん"],["を"],["ご覧","ごらん"],["に"],["なった"],["。"],["神","かみ"],["は"],["みこころ"],["を"],["留められた","とめられた"],["。"]]}]
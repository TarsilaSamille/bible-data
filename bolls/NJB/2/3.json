[{"verse":1,"text":"モーセは、ミデヤンの祭司で彼のしゅうと、イテロの羊を飼っていた。彼はその群れを荒野の西側に追って行き、神の山ホレブにやって来た。","tok":[["モーセ"],["は"],["、"],["ミデヤン"],["の"],["祭司","さいし"],["で"],["彼","かれ"],["の"],["しゅうと"],["、"],["イテロ"],["の"],["羊","ひつじ"],["を"],["飼って","かって"],["いた"],["。"],["彼","かれ"],["は"],["その"],["群れ","むれ"],["を"],["荒野","あらの"],["の"],["西側","にしがわ"],["に"],["追って","おって"],["行き","いき"],["、"],["神","かみ"],["の"],["山","やま"],["ホレブ"],["に"],["やって"],["来た","きた"],["。"]]},{"verse":2,"text":"すると主の使いが彼に、現れた。柴の中の火の炎の中であった。よく見ると、火で燃えていたのに柴は焼け尽きなかった。","tok":[["する"],["と"],["主","ぬし"],["の"],["使い","つかい"],["が"],["彼","かれ"],["に"],["、"],["現れた","あらわれた"],["。"],["柴","しば"],["の"],["中","なか"],["の"],["火","ひ"],["の"],["炎","ほのお"],["の"],["中","なか"],["で"],["あった"],["。"],["よく"],["見る","みる"],["と"],["、"],["火","ひ"],["で"],["燃えて","もえて"],["いた"],["のに"],["柴","しば"],["は"],["焼け尽きなかった","やけつきなかった"],["。"]]},{"verse":3,"text":"モーセは言った。「なぜ柴が燃えていかないのか、あちらへ行ってこの大いなる光景を見ることにしよう。」","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["なぜ"],["柴","しば"],["が"],["燃えて","もえて"],["いかない"],["の"],["か"],["、"],["あちら"],["へ"],["行って","いって"],["この"],["大いなる","おおいなる"],["光景","こうけい"],["を"],["見る","みる"],["こと"],["に"],["しよう"],["。"],["」"]]},{"verse":4,"text":"主は彼が横切って見に来るのをご覧になった。神は柴の中から彼を呼び、「モーセ、モーセ」と仰せられた。彼は「はい。ここにおります」と答えた。","tok":[["主","ぬし"],["は"],["彼","かれ"],["が"],["横切って","よこぎって"],["見","み"],["に"],["来る","くる"],["の"],["を"],["ご覧","ごらん"],["に"],["なった"],["。"],["神","かみ"],["は"],["柴","しば"],["の"],["中","なか"],["から"],["彼","かれ"],["を"],["呼び","よび"],["、"],["「"],["モーセ"],["、"],["モーセ"],["」"],["と"],["仰せられた","おおせられた"],["。"],["彼","かれ"],["は"],["「"],["はい"],["。"],["ここ"],["に"],["おります"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":5,"text":"神は仰せられた。「ここに近づいてはいけない。あなたの足のくつを脱げ。あなたの立っている場所は、聖なる地である。」","tok":[["神","かみ"],["は"],["仰せられた","おおせられた"],["。"],["「"],["ここ"],["に"],["近づいて","ちかづいて"],["は"],["いけない"],["。"],["あなた"],["の"],["足","あし"],["の"],["くつ"],["を"],["脱げ","ぬげ"],["。"],["あなた"],["の"],["立って","たって"],["いる"],["場所","ばしょ"],["は"],["、"],["聖","せい"],["なる"],["地","ち"],["で"],["ある"],["。"],["」"]]},{"verse":6,"text":"また仰せられた。「わたしは、あなたの父の神、アブラハムの神、イサクの神、ヤコブの神である。」モーセは神を仰ぎ見ることを恐れて、顔を隠した。","tok":[["また"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["の"],["父","ちち"],["の"],["神","かみ"],["、"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["で"],["ある"],["。"],["」"],["モーセ"],["は"],["神","かみ"],["を"],["仰ぎ見る","あおぎみる"],["こと"],["を"],["恐れて","おそれて"],["、"],["顔","かお"],["を"],["隠した","かくした"],["。"]]},{"verse":7,"text":"主は仰せられた。「わたしは、エジプトにいるわたしの民の悩みを確かに見、追い使う者の前の彼らの叫びを聞いた。わたしは彼らの痛みを知っている。","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["、"],["エジプト"],["に"],["いる"],["わたし"],["の"],["民","たみ"],["の"],["悩み","なやみ"],["を"],["確か","たしか"],["に"],["見","み"],["、"],["追い使う","おいつかう"],["者","もの"],["の"],["前","まえ"],["の"],["彼","かれ"],["ら"],["の"],["叫び","さけび"],["を"],["聞いた","きいた"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["痛み","いたみ"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":8,"text":"わたしが下って来たのは、彼らをエジプトの手から救い出し、その地から、広い良い地、乳と蜜の流れる地、カナン人、ヘテ人、エモリ人、ペリジ人、ヒビ人、エブス人のいる所に、彼らを上らせるためだ。","tok":[["わたし"],["が"],["下って","くだって"],["来た","きた"],["の"],["は"],["、"],["彼","かれ"],["ら"],["を"],["エジプト"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"],["その"],["地","ち"],["から"],["、"],["広い","ひろい"],["良い","よい"],["地","ち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["、"],["カナン人","かなんにん"],["、"],["ヘテ人","へてにん"],["、"],["エモリ人","えもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["いる"],["所","ところ"],["に"],["、"],["彼","かれ"],["ら"],["を"],["上らせる","のぼらせる"],["ため"],["だ"],["。"]]},{"verse":9,"text":"見よ。今こそ、イスラエル人の叫びはわたしに届いた。わたしはまた、エジプトが彼らをしいたげているそのしいたげを見た。","tok":[["見","み"],["よ"],["。"],["今","いま"],["こそ"],["、"],["イスラエル"],["人","にん"],["の"],["叫び","さけび"],["は"],["わたし"],["に"],["届いた","とどいた"],["。"],["わたし"],["は"],["また"],["、"],["エジプト"],["が"],["彼","かれ"],["ら"],["を"],["しいたげて"],["いる"],["その"],["しいたげ"],["を"],["見た","みた"],["。"]]},{"verse":10,"text":"今、行け。わたしはあなたをパロのもとに遣わそう。わたしの民イスラエル人をエジプトから連れ出せ。」","tok":[["今","いま"],["、"],["行け","いけ"],["。"],["わたし"],["は"],["あなた"],["を"],["パロ"],["の"],["もと"],["に"],["遣わそう","つかわそう"],["。"],["わたし"],["の"],["民","みん"],["イスラエル"],["人","にん"],["を"],["エジプト"],["から"],["連れ出せ","つれだせ"],["。"],["」"]]},{"verse":11,"text":"モーセは神に申し上げた。「私はいったい何者なのでしょう。パロのもとに行ってイスラエル人をエジプトから連れ出さなければならないとは。」","tok":[["モーセ"],["は"],["神","かみ"],["に"],["申し上げた","もうしあげた"],["。"],["「"],["私","わたくし"],["は"],["いったい"],["何者","なにもの"],["な"],["の"],["でしょう"],["。"],["パロ"],["の"],["もと"],["に"],["行って","いって"],["イスラエル"],["人","にん"],["を"],["エジプト"],["から"],["連れ出さなければ","つれださなければ"],["ならない"],["と"],["は"],["。"],["」"]]},{"verse":12,"text":"神は仰せられた。「わたしはあなたとともにいる。これがあなたのためのしるしである。わたしがあなたを遣わすのだ。あなたが民をエジプトから導き出すとき、あなたがたは、この山で、神に仕えなければならない。」","tok":[["神","かみ"],["は"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["あなた"],["と"],["とも"],["に"],["いる"],["。"],["これ"],["が"],["あなた"],["の"],["ため"],["の"],["しるし"],["で"],["ある"],["。"],["わたし"],["が"],["あなた"],["を"],["遣わす","つかわす"],["の"],["だ"],["。"],["あなた"],["が"],["民","たみ"],["を"],["エジプト"],["から"],["導き出す","みちびきだす"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["この"],["山","やま"],["で"],["、"],["神","かみ"],["に"],["仕えなければ","つかえなければ"],["ならない"],["。"],["」"]]},{"verse":13,"text":"モーセは神に申し上げた。「今、私はイスラエル人のところに行きます。私が彼らに『あなたがたの父祖の神が、私をあなたがたのもとに遣わされました』と言えば、彼らは、『その名は何ですか』と私に聞くでしょう。私は、何と答えたらよいのでしょうか。」","tok":[["モーセ"],["は"],["神","かみ"],["に"],["申し上げた","もうしあげた"],["。"],["「"],["今","いま"],["、"],["私","わたくし"],["は"],["イスラエル"],["人","にん"],["の"],["ところ"],["に"],["行きます","いきます"],["。"],["私","わたくし"],["が"],["彼","かれ"],["ら"],["に"],["『"],["あなた"],["がた"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["が"],["、"],["私","わたくし"],["を"],["あなた"],["がた"],["の"],["もと"],["に"],["遣わされました","つかわされました"],["』"],["と"],["言えば","いえば"],["、"],["彼","かれ"],["ら"],["は"],["、"],["『"],["その"],["名","な"],["は"],["何","なん"],["です"],["か"],["』"],["と"],["私","わたくし"],["に"],["聞くでしょう","きくでしょう"],["。"],["私","わたくし"],["は"],["、"],["何","なん"],["と"],["答えたら","こたえたら"],["よい"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":14,"text":"神はモーセに仰せられた。「わたしは、『わたしはある』という者である。」また仰せられた。「あなたはイスラエル人にこう告げなければならない。『わたしはあるという方が、私をあなたがたのところに遣わされた』と。」","tok":[["神","かみ"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["、"],["『"],["わたし"],["は"],["ある"],["』"],["と"],["いう"],["者","もの"],["で"],["ある"],["。"],["」"],["また"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["イスラエル"],["人","にん"],["に"],["こう"],["告げなければ","つげなければ"],["ならない"],["。"],["『"],["わたし"],["は"],["ある"],["と"],["いう"],["方","かた"],["が"],["、"],["私","わたくし"],["を"],["あなた"],["がた"],["の"],["ところ"],["に"],["遣わされた","つかわされた"],["』"],["と"],["。"],["」"]]},{"verse":15,"text":"神はさらにモーセに仰せられた。「イスラエル人に言え。あなたがたの父祖の神、アブラハムの神、イサクの神、ヤコブの神、主が、私をあなたがたのところに遣わされた、と言え。これが永遠にわたしの名、これが代々にわたってわたしの呼び名である。","tok":[["神","かみ"],["は"],["さらに"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["イスラエル"],["人","にん"],["に"],["言え","いえ"],["。"],["あなた"],["がた"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["私","わたくし"],["を"],["あなた"],["がた"],["の"],["ところ"],["に"],["遣わされた","つかわされた"],["、"],["と"],["言え","いえ"],["。"],["これ"],["が"],["永遠","えいえん"],["に"],["わたし"],["の"],["名","な"],["、"],["これ"],["が"],["代々","だいだい"],["に"],["わたって"],["わたし"],["の"],["呼び名","よびな"],["で"],["ある"],["。"]]},{"verse":16,"text":"行って、イスラエルの長老たちを集めて、彼らに言え。あなたがたの父祖の神、アブラハム、イサク、ヤコブの神、主が、私に現れて仰せられた。『わたしはあなたがたのこと、またエジプトであなたがたがどういうしうちを受けているかを確かに心に留めた。","tok":[["行って","いって"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["を"],["集めて","あつめて"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["あなた"],["がた"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["私","わたくし"],["に"],["現れて","あらわれて"],["仰せられた","おおせられた"],["。"],["『"],["わたし"],["は"],["あなた"],["がた"],["の"],["こと"],["、"],["また"],["エジプト"],["で"],["あなた"],["がた"],["が"],["どういう"],["しうち"],["を"],["受けて","うけて"],["いる"],["か"],["を"],["確か","たしか"],["に"],["心","こころ"],["に"],["留めた","とめた"],["。"]]},{"verse":17,"text":"それで、わたしはあなたがたをエジプトでの悩みから救い出し、カナン人、ヘテ人、エモリ人、ペリジ人、ヒビ人、エブス人の地、乳と蜜の流れる地へ上らせると言ったのである。』","tok":[["それ"],["で"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["エジプト"],["で"],["の"],["悩み","なやみ"],["から"],["救い出し","すくいだし"],["、"],["カナン人","かなんにん"],["、"],["ヘテ人","へてにん"],["、"],["エモリ人","えもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["地","ち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["へ"],["上らせる","のぼらせる"],["と"],["言った","いった"],["ので"],["ある"],["。"],["』"]]},{"verse":18,"text":"彼らはあなたの声に聞き従おう。あなたはイスラエルの長老たちといっしょにエジプトの王のところに行き、彼に『ヘブル人の神、主が私たちとお会いになりました。どうか今、私たちに荒野へ三日の道のりの旅をさせ、私たちの神、主にいけにえをささげさせてください』と言え。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["声","こえ"],["に"],["聞き従おう","ききしたがおう"],["。"],["あなた"],["は"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["と"],["いっしょ"],["に"],["エジプト"],["の"],["王","おう"],["の"],["ところ"],["に"],["行き","いき"],["、"],["彼","かれ"],["に"],["『"],["ヘブル人","へぶるにん"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["私たち","わたしたち"],["と"],["お会い","おあい"],["に"],["なりました"],["。"],["どう"],["か"],["今","いま"],["、"],["私たち","わたしたち"],["に"],["荒野","あらの"],["へ"],["三日","みっか"],["の"],["道のり","みちのり"],["の"],["旅","たび"],["を"],["させ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["いけにえ"],["を"],["ささげさせて"],["ください"],["』"],["と"],["言え","いえ"],["。"]]},{"verse":19,"text":"しかし、エジプトの王は強いられなければ、あなたがたを行かせないのを、わたしはよく知っている。","tok":[["しかし"],["、"],["エジプト"],["の"],["王","おう"],["は"],["強いられなければ","しいられなければ"],["、"],["あなた"],["がた"],["を"],["行かせない","いかせない"],["の"],["を"],["、"],["わたし"],["は"],["よく"],["知って","しって"],["いる"],["。"]]},{"verse":20,"text":"わたしはこの手を伸ばし、エジプトのただ中で行うあらゆる不思議で、エジプトを打とう。こうしたあとで、彼はあなたがたを去らせよう。","tok":[["わたし"],["は"],["この"],["手","て"],["を"],["伸ばし","のばし"],["、"],["エジプト"],["の"],["ただ中","ただなか"],["で"],["行う","おこなう"],["あらゆる"],["不思議","ふしぎ"],["で"],["、"],["エジプト"],["を"],["打とう","うとう"],["。"],["こう"],["した"],["あと"],["で"],["、"],["彼","かれ"],["は"],["あなた"],["がた"],["を"],["去らせよう","さらせよう"],["。"]]},{"verse":21,"text":"わたしは、エジプトがこの民に好意を持つようにする。あなたがたは出て行くとき、何も持たずに出て行ってはならない。","tok":[["わたし"],["は"],["、"],["エジプト"],["が"],["この"],["民","たみ"],["に"],["好意","こうい"],["を"],["持つ","もつ"],["よう"],["に"],["する"],["。"],["あなた"],["がた"],["は"],["出て","でて"],["行く","いく"],["とき"],["、"],["何","なん"],["も"],["持たず","もたず"],["に"],["出て","でて"],["行って","いって"],["は"],["ならない"],["。"]]},{"verse":22,"text":"女はみな、隣の女、自分の家に宿っている女に銀の飾り、金の飾り、それに着物を求め、あなたがたはそれを自分の息子や娘の身に着けなければならない。あなたがたは、エジプトからはぎ取らなければならない。」","tok":[["女","おんな"],["は"],["みな"],["、"],["隣","となり"],["の"],["女","おんな"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["宿って","やどって"],["いる"],["女","おんな"],["に"],["銀","ぎん"],["の"],["飾り","かざり"],["、"],["金","きん"],["の"],["飾り","かざり"],["、"],["それ"],["に"],["着物","きもの"],["を"],["求め","もとめ"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["自分","じぶん"],["の"],["息子","むすこ"],["や"],["娘","むすめ"],["の"],["身","み"],["に"],["着けなければ","つけなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["、"],["エジプト"],["から"],["はぎ取らなければ","はぎとらなければ"],["ならない"],["。"],["」"]]}]
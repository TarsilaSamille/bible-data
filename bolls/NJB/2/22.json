[{"verse":1,"text":"牛とか羊を盗み、これを殺したり、これを売ったりした場合、牛一頭を牛五頭で、羊一頭を羊四頭で償わなければならない。","tok":[["牛","うし"],["と"],["か"],["羊","ひつじ"],["を"],["盗み","ぬすみ"],["、"],["これ"],["を"],["殺し","ころし"],["たり"],["、"],["これ"],["を"],["売っ","うっ"],["たり"],["した"],["場合","ばあい"],["、"],["牛","うし"],["一頭","いちとう"],["を"],["牛","うし"],["五頭","ごとう"],["で"],["、"],["羊","ひつじ"],["一頭","いちとう"],["を"],["羊","ひつじ"],["四頭","よんとう"],["で"],["償わなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":2,"text":"――もし、盗人が、抜け穴を掘って押し入るところを見つけられ、打たれて死んだなら、血の罪は打った者にはない。","tok":[["―"],["―"],["もし"],["、"],["盗人","ぬすびと"],["が"],["、"],["抜け穴","ぬけあな"],["を"],["掘って","ほって"],["押し入る","おしいる"],["ところ"],["を"],["見つけられ","みつけられ"],["、"],["打たれて","うたれて"],["死んだなら","しんだなら"],["、"],["血","ち"],["の"],["罪","つみ"],["は"],["打った","うった"],["者","もの"],["に"],["は"],["ない"],["。"]]},{"verse":3,"text":"もし、日が上っていれば、血の罪は打った者にある――盗みをした者は必ず償いをしなければならない。もし彼が何も持っていないなら、盗んだ物のために、彼自身が売られなければならない。","tok":[["もし"],["、"],["日","ひ"],["が"],["上って","のぼって"],["いれば"],["、"],["血","ち"],["の"],["罪","つみ"],["は"],["打った","うった"],["者","もの"],["に"],["ある"],["―"],["―"],["盗み","ぬすみ"],["を"],["した"],["者","もの"],["は"],["必ず","かならず"],["償い","つぐない"],["を"],["しなければ"],["ならない"],["。"],["もし"],["彼","かれ"],["が"],["何","なん"],["も"],["持って","もって"],["いないなら"],["、"],["盗んだ","ぬすんだ"],["物","もの"],["の"],["ため"],["に"],["、"],["彼","かれ"],["自身","じしん"],["が"],["売られなければ","うられなければ"],["ならない"],["。"]]},{"verse":4,"text":"もし盗んだ物が、牛でも、ろばでも、羊でも、生きたままで彼の手の中にあるのが確かに見つかったなら、それを二倍にして償わなければならない。","tok":[["もし"],["盗んだ","ぬすんだ"],["物","もの"],["が"],["、"],["牛","うし"],["で"],["も"],["、"],["ろば"],["で"],["も"],["、"],["羊","ひつじ"],["で"],["も"],["、"],["生きた","いきた"],["まま"],["で"],["彼","かれ"],["の"],["手","て"],["の"],["中","なか"],["に"],["ある"],["の"],["が"],["確か","たしか"],["に"],["見つかったなら","みつかったなら"],["、"],["それ"],["を"],["二","に"],["倍","ばい"],["に"],["して"],["償わなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":5,"text":"家畜に畑やぶどう畑の物を食べさせるとき、その家畜を放ち、それが他人の畑の物を食い荒らした場合、その人は自分の畑の最良の物と、ぶどう畑の最良の物とをもって、償いをしなければならない。","tok":[["家畜","かちく"],["に"],["畑","はたけ"],["や"],["ぶどう"],["畑","はたけ"],["の"],["物","もの"],["を"],["食べさせる","たべさせる"],["とき"],["、"],["その"],["家畜","かちく"],["を"],["放ち","はなち"],["、"],["それ"],["が"],["他人","たにん"],["の"],["畑","はたけ"],["の"],["物","もの"],["を"],["食い荒らした","くいあらした"],["場合","ばあい"],["、"],["その"],["人","ひと"],["は"],["自分","じぶん"],["の"],["畑","はたけ"],["の"],["最良","さいりょう"],["の"],["物","もの"],["と"],["、"],["ぶどう"],["畑","はたけ"],["の"],["最良","さいりょう"],["の"],["物","もの"],["と"],["を"],["もって"],["、"],["償い","つぐない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":6,"text":"火災を起こし、それがいばらに燃え移り、そのため積み上げた穀物の束、あるいは立穂、あるいは畑を焼き尽くした場合、出火させた者は、必ず償いをしなければならない。","tok":[["火災","かさい"],["を"],["起こし","おこし"],["、"],["それ"],["が"],["いばら"],["に"],["燃え移り","もえうつり"],["、"],["その"],["ため"],["積み上げた","つみあげた"],["穀物","こくもつ"],["の"],["束","たば"],["、"],["あるいは"],["立穂","りつほ"],["、"],["あるいは"],["畑","はたけ"],["を"],["焼き","やき"],["尽くした","つくした"],["場合","ばあい"],["、"],["出火","しゅっか"],["させた"],["者","もの"],["は"],["、"],["必ず","かならず"],["償い","つぐない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":7,"text":"金銭あるいは物品を、保管のために隣人に預け、それがその人の家から盗まれた場合、もし、その盗人が見つかったなら、盗人はそれを二倍にして償わなければならない。","tok":[["金銭","きんせん"],["あるいは"],["物品","ぶっぴん"],["を"],["、"],["保管","ほかん"],["の"],["ため"],["に"],["隣人","りんじん"],["に"],["預け","あずけ"],["、"],["それ"],["が"],["その"],["人","ひと"],["の"],["家","いえ"],["から"],["盗まれた","ぬすまれた"],["場合","ばあい"],["、"],["もし"],["、"],["その"],["盗人","ぬすびと"],["が"],["見つかったなら","みつかったなら"],["、"],["盗人","ぬすびと"],["は"],["それ"],["を"],["二","に"],["倍","ばい"],["に"],["して"],["償わなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":8,"text":"もし、盗人が見つからないなら、その家の主人は神の前に出て、彼が隣人の財産に絶対に手をかけなかったことを誓わなければならない。","tok":[["もし"],["、"],["盗人","ぬすびと"],["が"],["見つからないなら","みつからないなら"],["、"],["その"],["家","いえ"],["の"],["主人","しゅじん"],["は"],["神","かみ"],["の"],["前","まえ"],["に"],["出て","でて"],["、"],["彼","かれ"],["が"],["隣人","りんじん"],["の"],["財産","ざいさん"],["に"],["絶対","ぜったい"],["に"],["手","て"],["を"],["かけなかった"],["こと"],["を"],["誓わなければ","ちかわなければ"],["ならない"],["。"]]},{"verse":9,"text":"すべての横領事件に際し、牛でも、ろばでも、羊でも、着物でも、どんな紛失物でも、一方が、『それは自分のものだ』と言う場合、その双方の言い分を、神の前に持ち出さなければならない。そして、神が罪に定めた者は、それを二倍にして相手に償わなければならない。","tok":[["すべて"],["の"],["横領","おうりょう"],["事件","じけん"],["に"],["際し","さいし"],["、"],["牛","うし"],["で"],["も"],["、"],["ろば"],["で"],["も"],["、"],["羊","ひつじ"],["で"],["も"],["、"],["着物","きもの"],["で"],["も"],["、"],["どんな"],["紛失物","ふんしつぶつ"],["で"],["も"],["、"],["一方","いっぽう"],["が"],["、"],["『"],["それ"],["は"],["自分","じぶん"],["の"],["もの"],["だ"],["』"],["と"],["言う","いう"],["場合","ばあい"],["、"],["その"],["双方","そうほう"],["の"],["言い分","いいぶん"],["を"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["持ち出さなければ","もちださなければ"],["ならない"],["。"],["そして"],["、"],["神","かみ"],["が"],["罪","つみ"],["に"],["定めた","さだめた"],["者","もの"],["は"],["、"],["それ"],["を"],["二","に"],["倍","ばい"],["に"],["して"],["相手","あいて"],["に"],["償わなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":10,"text":"ろばでも、牛でも、羊でも、またどんな家畜でも、その番をしてもらうために隣人に預け、それが死ぬとか、傷つくとか、奪い去られるとかして、目撃者がいない場合、","tok":[["ろば"],["で"],["も"],["、"],["牛","うし"],["で"],["も"],["、"],["羊","ひつじ"],["で"],["も"],["、"],["また"],["どんな"],["家畜","かちく"],["で"],["も"],["、"],["その"],["番","ばん"],["を"],["して"],["もらう"],["ため"],["に"],["隣人","りんじん"],["に"],["預け","あずけ"],["、"],["それ"],["が"],["死ぬ","しぬ"],["と"],["か"],["、"],["傷つく","きずつく"],["と"],["か"],["、"],["奪い去られる","うばいさられる"],["と"],["か"],["して"],["、"],["目撃者","もくげきしゃ"],["が"],["いない"],["場合","ばあい"],["、"]]},{"verse":11,"text":"隣人の財産に絶対に手をかけなかったという主への誓いが、双方の間に、なければならない。その持ち主がこれを受け入れるなら、隣人は償いをする必要はない。","tok":[["隣人","りんじん"],["の"],["財産","ざいさん"],["に"],["絶対","ぜったい"],["に"],["手","て"],["を"],["かけなかった"],["と"],["いう"],["主","ぬし"],["へ"],["の"],["誓い","ちかい"],["が"],["、"],["双方","そうほう"],["の"],["間","あいだ"],["に"],["、"],["なければ"],["ならない"],["。"],["その"],["持ち主","もちぬし"],["が"],["これ"],["を"],["受け入れるなら","うけいれるなら"],["、"],["隣人","りんじん"],["は"],["償い","つぐない"],["を"],["する"],["必要","ひつよう"],["は"],["ない"],["。"]]},{"verse":12,"text":"しかし、もしそれが確かに自分のところから盗まれたのなら、その持ち主に償いをしなければならない。","tok":[["しかし"],["、"],["もし"],["それ"],["が"],["確か","たしか"],["に"],["自分","じぶん"],["の"],["ところ"],["から"],["盗まれた","ぬすまれた"],["の"],["なら"],["、"],["その"],["持ち主","もちぬし"],["に"],["償い","つぐない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":13,"text":"もしそれが確かに野獣に裂き殺されたのなら、証拠としてそれを持って行かなければならない。裂き殺されたものの償いをする必要はない。","tok":[["もし"],["それ"],["が"],["確か","たしか"],["に"],["野獣","やじゅう"],["に"],["裂き","さき"],["殺された","ころされた"],["の"],["なら"],["、"],["証拠","しょうこ"],["として"],["それ"],["を"],["持って","もって"],["行かなければ","いかなければ"],["ならない"],["。"],["裂き","さき"],["殺された","ころされた"],["もの"],["の"],["償い","つぐない"],["を"],["する"],["必要","ひつよう"],["は"],["ない"],["。"]]},{"verse":14,"text":"人が隣人から家畜を借り、それが傷つくか、死ぬかして、その持ち主がいっしょにいなかった場合は、必ず償いをしなければならない。","tok":[["人","ひと"],["が"],["隣人","りんじん"],["から"],["家畜","かちく"],["を"],["借り","かり"],["、"],["それ"],["が"],["傷つく","きずつく"],["か"],["、"],["死ぬ","しぬ"],["か"],["して"],["、"],["その"],["持ち主","もちぬし"],["が"],["いっしょ"],["に"],["いなかった"],["場合","ばあい"],["は"],["、"],["必ず","かならず"],["償い","つぐない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":15,"text":"もし、持ち主がいっしょにいたなら、償いをする必要はない。しかし、それが賃借りの物であったなら、借り賃は払わなければならない。","tok":[["もし"],["、"],["持ち主","もちぬし"],["が"],["いっしょ"],["に"],["いたなら"],["、"],["償い","つぐない"],["を"],["する"],["必要","ひつよう"],["は"],["ない"],["。"],["しかし"],["、"],["それ"],["が"],["賃借り","ちんがり"],["の"],["物","もの"],["で"],["あったなら"],["、"],["借り賃","かりちん"],["は"],["払わなければ","はらわなければ"],["ならない"],["。"]]},{"verse":16,"text":"まだ婚約していない処女をいざない、彼女と寝た場合は、その人は必ず花嫁料を払って、彼女を自分の妻としなければならない。","tok":[["まだ"],["婚約","こんやく"],["して"],["いない"],["処女","しょじょ"],["を"],["いざない"],["、"],["彼女","かのじょ"],["と"],["寝た","ねた"],["場合","ばあい"],["は"],["、"],["その"],["人","ひと"],["は"],["必ず","かならず"],["花嫁料","はなよめりょう"],["を"],["払って","はらって"],["、"],["彼女","かのじょ"],["を"],["自分","じぶん"],["の"],["妻","つま"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":17,"text":"もし、その父が彼女をその人に与えることを堅く拒むなら、その人は処女のために定められた花嫁料に相当する銀を支払わなければならない。","tok":[["もし"],["、"],["その"],["父","ちち"],["が"],["彼女","かのじょ"],["を"],["その"],["人","ひと"],["に"],["与える","あたえる"],["こと"],["を"],["堅く","かたく"],["拒むなら","こばむなら"],["、"],["その"],["人","ひと"],["は"],["処女","しょじょ"],["の"],["ため"],["に"],["定められた","さだめられた"],["花嫁料","はなよめりょう"],["に"],["相当","そうとう"],["する"],["銀","ぎん"],["を"],["支払わなければ","しはらわなければ"],["ならない"],["。"]]},{"verse":18,"text":"呪術を行う女は生かしておいてはならない。","tok":[["呪術","じゅじゅつ"],["を"],["行う","おこなう"],["女","おんな"],["は"],["生かして","いかして"],["おいて"],["は"],["ならない"],["。"]]},{"verse":19,"text":"獣と寝る者はすべて、必ず殺されなければならない。","tok":[["獣","けもの"],["と"],["寝る","ねる"],["者","もの"],["は"],["すべて"],["、"],["必ず","かならず"],["殺されなければ","ころされなければ"],["ならない"],["。"]]},{"verse":20,"text":"ただ主ひとりのほかに、ほかの神々にいけにえをささげる者は、聖絶しなければならない。","tok":[["ただ"],["主","ぬし"],["ひとり"],["の"],["ほか"],["に"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["いけにえ"],["を"],["ささげる"],["者","もの"],["は"],["、"],["聖","せい"],["絶しなければ","ぜっしなければ"],["ならない"],["。"]]},{"verse":21,"text":"在留異国人を苦しめてはならない。しいたげてはならない。あなたがたも、かつてはエジプトの国で、在留異国人であったからである。","tok":[["在留","ざいりゅう"],["異国人","いこくにん"],["を"],["苦しめて","くるしめて"],["は"],["ならない"],["。"],["しいたげて"],["は"],["ならない"],["。"],["あなた"],["がた"],["も"],["、"],["かつて"],["は"],["エジプト"],["の"],["国","くに"],["で"],["、"],["在留","ざいりゅう"],["異国人","いこくにん"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"すべてのやもめ、またはみなしごを悩ませてはならない。","tok":[["すべて"],["の"],["やもめ"],["、"],["また"],["は"],["みなしご"],["を"],["悩ませて","なやませて"],["は"],["ならない"],["。"]]},{"verse":23,"text":"もしあなたが彼らをひどく悩ませ、彼らがわたしに向かって切に叫ぶなら、わたしは必ず彼らの叫びを聞き入れる。","tok":[["もし"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["ひどく"],["悩ませ","なやませ"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["に"],["向かって","むかって"],["切に","せつに"],["叫ぶなら","さけぶなら"],["、"],["わたし"],["は"],["必ず","かならず"],["彼","かれ"],["ら"],["の"],["叫び","さけび"],["を"],["聞き入れる","ききいれる"],["。"]]},{"verse":24,"text":"わたしの怒りは燃え上がり、わたしは剣をもってあなたがたを殺す。あなたがたの妻はやもめとなり、あなたがたの子どもはみなしごとなる。","tok":[["わたし"],["の"],["怒り","いかり"],["は"],["燃え上がり","もえあがり"],["、"],["わたし"],["は"],["剣","けん"],["を"],["もって"],["あなた"],["がた"],["を"],["殺す","ころす"],["。"],["あなた"],["がた"],["の"],["妻","つま"],["は"],["やもめ"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["子ども","こども"],["は"],["みなしご"],["と"],["なる"],["。"]]},{"verse":25,"text":"わたしの民のひとりで、あなたのところにいる貧しい者に金を貸すのなら、彼に対して金貸しのようであってはならない。彼から利息を取ってはならない。","tok":[["わたし"],["の"],["民","たみ"],["の"],["ひとり"],["で"],["、"],["あなた"],["の"],["ところ"],["に"],["いる"],["貧しい","まずしい"],["者","もの"],["に"],["金","かね"],["を"],["貸す","かす"],["の"],["なら"],["、"],["彼","かれ"],["に対して","にたいして"],["金貸し","かねかし"],["の"],["よう"],["で"],["あって"],["は"],["ならない"],["。"],["彼","かれ"],["から"],["利息","りそく"],["を"],["取って","とって"],["は"],["ならない"],["。"]]},{"verse":26,"text":"もし、隣人の着る物を質に取るようなことをするのなら、日没までにそれを返さなければならない。","tok":[["もし"],["、"],["隣人","りんじん"],["の"],["着る","きる"],["物","もの"],["を"],["質","しつ"],["に"],["取る","とる"],["よう"],["な"],["こと"],["を"],["する"],["の"],["なら"],["、"],["日没","にちぼつ"],["まで"],["に"],["それ"],["を"],["返さなければ","かえさなければ"],["ならない"],["。"]]},{"verse":27,"text":"なぜなら、それは彼のただ一つのおおい、彼の身に着ける着物であるから。彼はほかに何を着て寝ることができよう。彼がわたしに向かって叫ぶとき、わたしはそれを聞き入れる。わたしは情け深いから。","tok":[["なぜ"],["なら"],["、"],["それ"],["は"],["彼","かれ"],["の"],["ただ"],["一","ひと"],["つ"],["の"],["おおい"],["、"],["彼","かれ"],["の"],["身","み"],["に"],["着ける","つける"],["着物","きもの"],["で"],["ある"],["から"],["。"],["彼","かれ"],["は"],["ほか"],["に"],["何","なん"],["を"],["着て","きて"],["寝る","ねる"],["こと"],["が"],["できよう"],["。"],["彼","かれ"],["が"],["わたし"],["に"],["向かって","むかって"],["叫ぶ","さけぶ"],["とき"],["、"],["わたし"],["は"],["それ"],["を"],["聞き入れる","ききいれる"],["。"],["わたし"],["は"],["情け深い","なさけぶかい"],["から"],["。"]]},{"verse":28,"text":"神をのろってはならない。また、民の上に立つ者をのろってはならない。","tok":[["神","かみ"],["を"],["のろって"],["は"],["ならない"],["。"],["また"],["、"],["民","みん"],["の"],["上","うえ"],["に"],["立つ","たつ"],["者","もの"],["を"],["のろって"],["は"],["ならない"],["。"]]},{"verse":29,"text":"あなたの豊かな産物と、あふれる酒とのささげ物を、遅らせてはならない。あなたの息子のうち初子は、わたしにささげなければならない。","tok":[["あなた"],["の"],["豊か","ゆたか"],["な"],["産物","さんぶつ"],["と"],["、"],["あふれる"],["酒","さけ"],["と"],["の"],["ささげ物","ささげもの"],["を"],["、"],["遅らせて","おくらせて"],["は"],["ならない"],["。"],["あなた"],["の"],["息子","むすこ"],["の"],["うち"],["初子","ういご"],["は"],["、"],["わたし"],["に"],["ささげなければ"],["ならない"],["。"]]},{"verse":30,"text":"あなたの牛と羊についても同様にしなければならない。七日間、その母親のそばに置き、八日目にわたしに、ささげなければならない。","tok":[["あなた"],["の"],["牛","うし"],["と"],["羊","ひつじ"],["について"],["も"],["同様","どうよう"],["に"],["しなければ"],["ならない"],["。"],["七","なな"],["日間","かかん"],["、"],["その"],["母親","ははおや"],["の"],["そば"],["に"],["置き","おき"],["、"],["八日目","ようかめ"],["に"],["わたし"],["に"],["、"],["ささげなければ"],["ならない"],["。"]]},{"verse":31,"text":"あなたがたは、わたしの聖なる民でなければならない。野で獣に裂き殺されたものの肉を食べてはならない。それは、犬に投げ与えなければならない。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["民","たみ"],["で"],["なければ"],["ならない"],["。"],["野","の"],["で"],["獣","けもの"],["に"],["裂き","さき"],["殺された","ころされた"],["もの"],["の"],["肉","にく"],["を"],["食べて
[{"verse":1,"text":"その後、モーセとアロンはパロのところに行き、そして言った。「イスラエルの神、主がこう仰せられます。『わたしの民を行かせ、荒野でわたしのために祭りをさせよ。』」","tok":[["その"],["後","ご"],["、"],["モーセ"],["と"],["アロン"],["は"],["パロ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["そして"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["行かせ","いかせ"],["、"],["荒野","こうや"],["で"],["わたし"],["の"],["ため"],["に"],["祭り","まつり"],["を"],["させ"],["よ"],["。"],["』"],["」"]]},{"verse":2,"text":"パロは答えた。「主とはいったい何者か。私がその声を聞いてイスラエルを行かせなければならないというのは。私は主を知らない。イスラエルを行かせはしない。」","tok":[["パロ"],["は"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["と"],["は"],["いったい"],["何者","なにもの"],["か"],["。"],["私","わたくし"],["が"],["その"],["声","こえ"],["を"],["聞いて","きいて"],["イスラエル"],["を"],["行かせなければ","いかせなければ"],["ならない"],["と"],["いう"],["の"],["は"],["。"],["私","わたくし"],["は"],["主","ぬし"],["を"],["知らない","しらない"],["。"],["イスラエル"],["を"],["行かせ","いかせ"],["は"],["しない"],["。"],["」"]]},{"verse":3,"text":"すると彼らは言った。「ヘブル人の神が私たちにお会いくださったのです。どうか今、私たちに荒野へ三日の道のりの旅をさせ、私たちの神、主にいけにえをささげさせてください。でないと、主は疫病か剣で、私たちを打たれるからです。」","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["ヘブル人","へぶるにん"],["の"],["神","かみ"],["が"],["私たち","わたしたち"],["に"],["お会い","おあい"],["くださった"],["の"],["です"],["。"],["どう"],["か"],["今","いま"],["、"],["私たち","わたしたち"],["に"],["荒野","あらの"],["へ"],["三日","みっか"],["の"],["道のり","みちのり"],["の"],["旅","たび"],["を"],["させ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["いけにえ"],["を"],["ささげさせて"],["ください"],["。"],["で"],["ない"],["と"],["、"],["主","ぬし"],["は"],["疫病","やくびょう"],["か"],["剣","けん"],["で"],["、"],["私たち","わたしたち"],["を"],["打たれる","うたれる"],["から"],["です"],["。"],["」"]]},{"verse":4,"text":"エジプトの王は彼らに言った。「モーセとアロン。おまえたちは、なぜ民に仕事をやめさせようとするのか。おまえたちの苦役に戻れ。」","tok":[["エジプト"],["の"],["王","おう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["モーセ"],["と"],["アロン"],["。"],["おまえ"],["たち"],["は"],["、"],["なぜ"],["民","たみ"],["に"],["仕事","しごと"],["を"],["やめさせよう"],["と"],["する"],["の"],["か"],["。"],["おまえ"],["たち"],["の"],["苦役","くえき"],["に"],["戻れ","もどれ"],["。"],["」"]]},{"verse":5,"text":"パロはまた言った。「見よ。今や彼らはこの地の人々よりも多くなっている。そしておまえたちは彼らの苦役を休ませようとしているのだ。」","tok":[["パロ"],["は"],["また"],["言った","いった"],["。"],["「"],["見","み"],["よ"],["。"],["今","いま"],["や"],["彼","かれ"],["ら"],["は"],["この"],["地","ち"],["の"],["人々","ひとびと"],["より"],["も"],["多く","おおく"],["なって"],["いる"],["。"],["そして"],["おまえ"],["たち"],["は"],["彼","かれ"],["ら"],["の"],["苦役","くえき"],["を"],["休ませよう","やすませよう"],["として"],["いる"],["の"],["だ"],["。"],["」"]]},{"verse":6,"text":"その日、パロはこの民を使う監督と人夫がしらに命じて言った。","tok":[["その"],["日","ひ"],["、"],["パロ"],["は"],["この"],["民","たみ"],["を"],["使う","つかう"],["監督","かんとく"],["と"],["人夫","にんぷ"],["がしら"],["に"],["命じて","めいじて"],["言った","いった"],["。"]]},{"verse":7,"text":"「おまえたちはれんがを作るわらを、これまでのようにこの民に与えてはならない。自分でわらを集めに行かせよ。","tok":[["「"],["おまえ"],["たち"],["は"],["れんが"],["を"],["作る","つくる"],["わら"],["を"],["、"],["これ"],["まで"],["の"],["よう"],["に"],["この"],["民","たみ"],["に"],["与えて","あたえて"],["は"],["ならない"],["。"],["自分","じぶん"],["で"],["わら"],["を"],["集め","あつめ"],["に"],["行かせ","いかせ"],["よ"],["。"]]},{"verse":8,"text":"そしてこれまで作っていた量のれんがを作らせるのだ。それを減らしてはならない。彼らはなまけ者だ。だから、『私たちの神に、いけにえをささげに行かせてください』と言って叫んでいるのだ。","tok":[["そして"],["これ"],["まで"],["作って","つくって"],["いた"],["量","りょう"],["の"],["れんが"],["を"],["作らせる","つくらせる"],["の"],["だ"],["。"],["それ"],["を"],["減らして","へらして"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["なまけ者","なまけもの"],["だ"],["。"],["だ"],["から"],["、"],["『"],["私たち","わたしたち"],["の"],["神","かみ"],["に"],["、"],["いけにえ"],["を"],["ささげ"],["に"],["行かせて","いかせて"],["ください"],["』"],["と"],["言って","いって"],["叫んで","さけんで"],["いる"],["の"],["だ"],["。"]]},{"verse":9,"text":"あの者たちの労役を重くし、その仕事をさせなければならない。偽りのことばにかかわりを持たせてはいけない。」","tok":[["あの"],["者","もの"],["たち"],["の"],["労役","ろうえき"],["を"],["重く","おもく"],["し"],["、"],["その"],["仕事","しごと"],["を"],["させなければ"],["ならない"],["。"],["偽り","いつわり"],["の"],["ことば"],["に"],["かかわり"],["を"],["持たせて","もたせて"],["は"],["いけない"],["。"],["」"]]},{"verse":10,"text":"そこで、この民を使う監督と人夫がしらたちは出て行って、民に告げて言った。「パロはこう言われる。『私はおまえたちにわらを与えない。","tok":[["そこ"],["で"],["、"],["この"],["民","たみ"],["を"],["使う","つかう"],["監督","かんとく"],["と"],["人夫","にんぷ"],["がしら"],["たち"],["は"],["出て","でて"],["行って","いって"],["、"],["民","みん"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["パロ"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["私","わたくし"],["は"],["おまえ"],["たち"],["に"],["わら"],["を"],["与えない","あたえない"],["。"]]},{"verse":11,"text":"おまえたちは自分でどこへでも行ってわらを見つけて、取って来い。おまえたちの労役は少しも減らさないから。』」","tok":[["おまえ"],["たち"],["は"],["自分","じぶん"],["で"],["どこ"],["へ"],["で"],["も"],["行って","いって"],["わら"],["を"],["見つけて","みつけて"],["、"],["取って","とって"],["来い","こい"],["。"],["おまえ"],["たち"],["の"],["労役","ろうえき"],["は"],["少し","すこし"],["も"],["減らさない","へらさない"],["から"],["。"],["』"],["」"]]},{"verse":12,"text":"そこで、民はエジプト全土に散って、わらの代わりに刈り株を集めた。","tok":[["そこ"],["で"],["、"],["民","みん"],["は"],["エジプト"],["全土","ぜんど"],["に"],["散って","ちって"],["、"],["わら"],["の"],["代わり","かわり"],["に"],["刈り株","かりかぶ"],["を"],["集めた","あつめた"],["。"]]},{"verse":13,"text":"監督たちは彼らをせきたてて言った。「わらがあったときと同じように、おまえたちの仕事、おまえたちのその日その日の仕事を仕上げよ。」","tok":[["監督","かんとく"],["たち"],["は"],["彼","かれ"],["ら"],["を"],["せきたてて"],["言った","いった"],["。"],["「"],["わら"],["が"],["あった"],["とき"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["おまえ"],["たち"],["の"],["仕事","しごと"],["、"],["おまえ"],["たち"],["の"],["その"],["日","ひ"],["その"],["日","ひ"],["の"],["仕事","しごと"],["を"],["仕上げ","しあげ"],["よ"],["。"],["」"]]},{"verse":14,"text":"パロの監督たちがこの民の上に立てたイスラエル人の人夫がしらたちは、打ちたたかれ、「なぜおまえたちは定められたれんがの分を、きのうもきょうも、これまでのように仕上げないのか」と言われた。","tok":[["パロ"],["の"],["監督","かんとく"],["たち"],["が"],["この"],["民","たみ"],["の"],["上","うえ"],["に"],["立てた","たてた"],["イスラエル"],["人","にん"],["の"],["人夫","にんぷ"],["がしら"],["たち"],["は"],["、"],["打ちたたかれ","うちたたかれ"],["、"],["「"],["なぜ"],["おまえ"],["たち"],["は"],["定められた","さだめられた"],["れんが"],["の"],["分","ぶん"],["を"],["、"],["きのう"],["も"],["きょう"],["も"],["、"],["これ"],["まで"],["の"],["よう"],["に"],["仕上げない","しあげない"],["の"],["か"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":15,"text":"そこで、イスラエル人の人夫がしらたちは、パロのところに行き、叫んで言った。「なぜあなたのしもべどもを、このように扱うのですか。","tok":[["そこ"],["で"],["、"],["イスラエル"],["人","にん"],["の"],["人夫","にんぷ"],["がしら"],["たち"],["は"],["、"],["パロ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["なぜ"],["あなた"],["の"],["しもべ"],["ども"],["を"],["、"],["この"],["よう"],["に"],["扱う","あつかう"],["の"],["です"],["か"],["。"]]},{"verse":16,"text":"あなたのしもべどもには、わらが与えられていません。それでも、彼らは私たちに、『れんがを作れ』と言っています。見てください。あなたのしもべどもは打たれています。しかし、いけないのはあなたの民なのです。」","tok":[["あなた"],["の"],["しもべ"],["ども"],["に"],["は"],["、"],["わら"],["が"],["与えられて","あたえられて"],["いません"],["。"],["それ"],["で"],["も"],["、"],["彼","かれ"],["ら"],["は"],["私たち","わたしたち"],["に"],["、"],["『"],["れんが"],["を"],["作れ","つくれ"],["』"],["と"],["言って","いって"],["います"],["。"],["見て","みて"],["ください"],["。"],["あなた"],["の"],["しもべ"],["ども"],["は"],["打たれて","うたれて"],["います"],["。"],["しかし"],["、"],["いけない"],["の"],["は"],["あなた"],["の"],["民","たみ"],["な"],["の"],["です"],["。"],["」"]]},{"verse":17,"text":"パロは言った。「おまえたちはなまけ者だ。なまけ者なのだ。だから『私たちの主にいけにえをささげに行かせてください』と言っているのだ。","tok":[["パロ"],["は"],["言った","いった"],["。"],["「"],["おまえ"],["たち"],["は"],["なまけ者","なまけもの"],["だ"],["。"],["なまけ者","なまけもの"],["な"],["の"],["だ"],["。"],["だ"],["から"],["『"],["私たち","わたしたち"],["の"],["主に","おもに"],["いけにえ"],["を"],["ささげ"],["に"],["行かせて","いかせて"],["ください"],["』"],["と"],["言って","いって"],["いる"],["の"],["だ"],["。"]]},{"verse":18,"text":"さあ、すぐに行って働け。わらは与えないが、おまえたちは割り当てどおりれんがを納めるのだ。」","tok":[["さあ"],["、"],["すぐ"],["に"],["行って","いって"],["働け","はたらけ"],["。"],["わら"],["は"],["与えない","あたえない"],["が"],["、"],["おまえ"],["たち"],["は"],["割り当て","わりあて"],["どおり"],["れんが"],["を"],["納める","おさめる"],["の"],["だ"],["。"],["」"]]},{"verse":19,"text":"イスラエル人の人夫がしらたちは、「おまえたちのれんがのその日その日の数を減らしてはならない」と聞かされたとき、これは、悪いことになったと思った。","tok":[["イスラエル"],["人","にん"],["の"],["人夫","にんぷ"],["がしら"],["たち"],["は"],["、"],["「"],["おまえ"],["たち"],["の"],["れんが"],["の"],["その"],["日","ひ"],["その"],["日","ひ"],["の"],["数","かず"],["を"],["減らして","へらして"],["は"],["ならない"],["」"],["と"],["聞かされた","きかされた"],["とき"],["、"],["これ"],["は"],["、"],["悪い","わるい"],["こと"],["に"],["なった"],["と"],["思った","おもった"],["。"]]},{"verse":20,"text":"彼らはパロのところから出て来たとき、彼らを迎えに来ているモーセとアロンに出会った。","tok":[["彼","かれ"],["ら"],["は"],["パロ"],["の"],["ところ"],["から"],["出て","でて"],["来た","きた"],["とき"],["、"],["彼","かれ"],["ら"],["を"],["迎え","むかえ"],["に"],["来て","きて"],["いる"],["モーセ"],["と"],["アロン"],["に"],["出会った","であった"],["。"]]},{"verse":21,"text":"彼らはふたりに言った。「主があなたがたを見て、さばかれますように。あなたがたはパロやその家臣たちに私たちを憎ませ、私たちを殺すために彼らの手に剣を渡したのです。」","tok":[["彼","かれ"],["ら"],["は"],["ふたり"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["あなた"],["がた"],["を"],["見て","みて"],["、"],["さばかれます"],["よう"],["に"],["。"],["あなた"],["がた"],["は"],["パロ"],["や"],["その"],["家臣","かしん"],["たち"],["に"],["私たち","わたしたち"],["を"],["憎ませ","にくませ"],["、"],["私たち","わたしたち"],["を"],["殺す","ころす"],["ため"],["に"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["剣","けん"],["を"],["渡した","わたした"],["の"],["です"],["。"],["」"]]},{"verse":22,"text":"それでモーセは主のもとに戻り、そして申し上げた。「主よ。なぜあなたはこの民に害をお与えになるのですか。何のために、私を遣わされたのですか。","tok":[["それ"],["で"],["モーセ"],["は"],["主","ぬし"],["の"],["もと"],["に"],["戻り","もどり"],["、"],["そして"],["申し上げた","もうしあげた"],["。"],["「"],["主","ぬし"],["よ"],["。"],["なぜ"],["あなた"],["は"],["この"],["民","たみ"],["に"],["害","がい"],["を"],["お与え","おあたえ"],["に"],["なる"],["の"],["です"],["か"],["。"],["何","なん"],["の"],["ため"],["に"],["、"],["私","わたくし"],["を"],["遣わされた","つかわされた"],["の"],["です"],["か"],["。"]]},{"verse":23,"text":"私がパロのところに行って、あなたの御名によって語ってからこのかた、彼はこの民に害を与えています。それなのにあなたは、あなたの民を少しも救い出そうとはなさいません。」","tok":[["私","わたくし"],["が"],["パロ"],["の"],["ところ"],["に"],["行って","いって"],["、"],["あなた"],["の"],["御名","ぎょめい"],["によって"],["語って","かたって"],["から"],["このかた"],["、"],["彼","かれ"],["は"],["この"],["民","たみ"],["に"],["害","がい"],["を"],["与えて","あたえて"],["います"],["。"],["それ"],["な"],["のに"],["あなた"],["は"],["、"],["あなた"],["の"],["民","たみ"],["を"],["少し","すこし"],["も"],["救い出そう","すくいだそう"],["と"],["は"],["なさいません"],["。"],["」"]]}]
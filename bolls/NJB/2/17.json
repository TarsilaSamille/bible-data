[{"verse":1,"text":"イスラエル人の全会衆は、主の命により、シンの荒野から旅立ち、旅を重ねて、レフィディムで宿営した。そこには民の飲む水がなかった。","tok":[["イスラエル"],["人","にん"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["主","ぬし"],["の"],["命","いのち"],["に"],["より"],["、"],["シン"],["の"],["荒野","あらの"],["から"],["旅立ち","たびだち"],["、"],["旅","たび"],["を"],["重ねて","かさねて"],["、"],["レフィディム"],["で"],["宿営","しゅくえい"],["した"],["。"],["そこ"],["に"],["は"],["民","みん"],["の"],["飲む","のむ"],["水","みず"],["が"],["なかった"],["。"]]},{"verse":2,"text":"それで、民はモーセと争い、「私たちに飲む水を下さい」と言った。モーセは彼らに、「あなたがたはなぜ私と争うのですか。なぜ主を試みるのですか」と言った。","tok":[["それ"],["で"],["、"],["民","みん"],["は"],["モーセ"],["と"],["争い","あらそい"],["、"],["「"],["私たち","わたしたち"],["に"],["飲む","のむ"],["水","みず"],["を"],["下さい","ください"],["」"],["と"],["言った","いった"],["。"],["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["、"],["「"],["あなた"],["がた"],["は"],["なぜ"],["私","わたくし"],["と"],["争う","あらそう"],["の"],["です"],["か"],["。"],["なぜ"],["主","ぬし"],["を"],["試みる","こころみる"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"民はその所で水に渇いた。それで民はモーセにつぶやいて言った。「いったい、なぜ私たちをエジプトから連れ上ったのですか。私や、子どもたちや、家畜を、渇きで死なせるためですか。」","tok":[["民","みん"],["は"],["その"],["所","ところ"],["で"],["水","みず"],["に"],["渇いた","かわいた"],["。"],["それ"],["で"],["民","たみ"],["は"],["モーセ"],["に"],["つぶやいて"],["言った","いった"],["。"],["「"],["いったい"],["、"],["なぜ"],["私たち","わたしたち"],["を"],["エジプト"],["から"],["連れ上った","つれのぼった"],["の"],["です"],["か"],["。"],["私","わたくし"],["や"],["、"],["子ども","こども"],["たち"],["や"],["、"],["家畜","かちく"],["を"],["、"],["渇き","かわき"],["で"],["死なせる","しなせる"],["ため"],["です"],["か"],["。"],["」"]]},{"verse":4,"text":"そこでモーセは主に叫んで言った。「私はこの民をどうすればよいのでしょう。もう少しで私を石で打ち殺そうとしています。」","tok":[["そこ"],["で"],["モーセ"],["は"],["主に","おもに"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["この"],["民","たみ"],["を"],["どう"],["すれば"],["よい"],["の"],["でしょう"],["。"],["もう"],["少し","すこし"],["で"],["私","わたくし"],["を"],["石","いし"],["で"],["打ち殺そう","うちころそう"],["として"],["います"],["。"],["」"]]},{"verse":5,"text":"主はモーセに仰せられた。「民の前を通り、イスラエルの長老たちを幾人か連れ、あなたがナイルを打ったあの杖を手に取って出て行け。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["民","みん"],["の"],["前","まえ"],["を"],["通り","とおり"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["を"],["幾人","いくにん"],["か"],["連れ","つれ"],["、"],["あなた"],["が"],["ナイル"],["を"],["打った","うった"],["あの"],["杖","つえ"],["を"],["手","て"],["に"],["取って","とって"],["出て","でて"],["行け","いけ"],["。"]]},{"verse":6,"text":"さあ、わたしはあそこのホレブの岩の上で、あなたの前に立とう。あなたがその岩を打つと、岩から水が出る。民はそれを飲もう。」そこでモーセはイスラエルの長老たちの目の前で、そのとおりにした。","tok":[["さあ"],["、"],["わたし"],["は"],["あそこ"],["の"],["ホレブ"],["の"],["岩","いわ"],["の"],["上","うえ"],["で"],["、"],["あなた"],["の"],["前","まえ"],["に"],["立とう","たとう"],["。"],["あなた"],["が"],["その"],["岩","いわ"],["を"],["打つ","うつ"],["と"],["、"],["岩","いわ"],["から"],["水","みず"],["が"],["出る","でる"],["。"],["民","たみ"],["は"],["それ"],["を"],["飲もう","のもう"],["。"],["」"],["そこ"],["で"],["モーセ"],["は"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["その"],["とおり"],["に"],["した"],["。"]]},{"verse":7,"text":"それで、彼はその所をマサ、またはメリバと名づけた。それは、イスラエル人が争ったからであり、また彼らが、「主は私たちの中におられるのか、おられないのか」と言って、主を試みたからである。","tok":[["それ"],["で"],["、"],["彼","かれ"],["は"],["その"],["所","ところ"],["を"],["マサ"],["、"],["また"],["は"],["メリバ"],["と"],["名づけた","なづけた"],["。"],["それ"],["は"],["、"],["イスラエル"],["人","にん"],["が"],["争った","あらそった"],["から"],["で"],["あり"],["、"],["また"],["彼","かれ"],["ら"],["が"],["、"],["「"],["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["中","なか"],["に"],["おられる"],["の"],["か"],["、"],["おられない"],["の"],["か"],["」"],["と"],["言って","いって"],["、"],["主","ぬし"],["を"],["試みた","こころみた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"さて、アマレクが来て、レフィディムでイスラエルと戦った。","tok":[["さて"],["、"],["アマレク"],["が"],["来て","きて"],["、"],["レフィディム"],["で"],["イスラエル"],["と"],["戦った","たたかった"],["。"]]},{"verse":9,"text":"モーセはヨシュアに言った。「私たちのために幾人かを選び、出て行ってアマレクと戦いなさい。あす私は神の杖を手に持って、丘の頂に立ちます。」","tok":[["モーセ"],["は"],["ヨシュア"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["の"],["ため"],["に"],["幾人","いくにん"],["か"],["を"],["選び","えらび"],["、"],["出て","でて"],["行って","いって"],["アマレク"],["と"],["戦い","たたかい"],["なさい"],["。"],["あす"],["私","わたくし"],["は"],["神","かみ"],["の"],["杖","つえ"],["を"],["手","て"],["に"],["持って","もって"],["、"],["丘","おか"],["の"],["頂","いただき"],["に"],["立ちます","たちます"],["。"],["」"]]},{"verse":10,"text":"ヨシュアはモーセが言ったとおりにして、アマレクと戦った。モーセとアロンとフルは丘の頂に登った。","tok":[["ヨシュア"],["は"],["モーセ"],["が"],["言った","いった"],["とおり"],["に"],["して"],["、"],["アマレク"],["と"],["戦った","たたかった"],["。"],["モーセ"],["と"],["アロン"],["と"],["フル"],["は"],["丘","おか"],["の"],["頂","いただき"],["に"],["登った","のぼった"],["。"]]},{"verse":11,"text":"モーセが手を上げているときは、イスラエルが優勢になり、手を降ろしているときは、アマレクが優勢になった。","tok":[["モーセ"],["が"],["手","て"],["を"],["上げて","あげて"],["いる"],["とき"],["は"],["、"],["イスラエル"],["が"],["優勢","ゆうせい"],["に"],["なり"],["、"],["手","て"],["を"],["降ろして","おろして"],["いる"],["とき"],["は"],["、"],["アマレク"],["が"],["優勢","ゆうせい"],["に"],["なった"],["。"]]},{"verse":12,"text":"しかし、モーセの手が重くなった。彼らは石を取り、それをモーセの足もとに置いたので、モーセはその上に腰掛けた。アロンとフルは、ひとりはこちら側、ひとりはあちら側から、モーセの手をささえた。それで彼の手は日が沈むまで、しっかりそのままであった。","tok":[["しかし"],["、"],["モーセ"],["の"],["手","て"],["が"],["重く","おもく"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["石","いし"],["を"],["取り","とり"],["、"],["それ"],["を"],["モーセ"],["の"],["足もと","あしもと"],["に"],["置いた","おいた"],["ので"],["、"],["モーセ"],["は"],["その"],["上","うえ"],["に"],["腰掛けた","こしかけた"],["。"],["アロン"],["と"],["フル"],["は"],["、"],["ひとり"],["は"],["こちら側","こちらがわ"],["、"],["ひとり"],["は"],["あちら側","あちらがわ"],["から"],["、"],["モーセ"],["の"],["手","て"],["を"],["ささえた"],["。"],["それ"],["で"],["彼","かれ"],["の"],["手","て"],["は"],["日","ひ"],["が"],["沈む","しずむ"],["まで"],["、"],["しっかり"],["そのまま"],["で"],["あった"],["。"]]},{"verse":13,"text":"ヨシュアは、アマレクとその民を剣の刃で打ち破った。","tok":[["ヨシュア"],["は"],["、"],["アマレク"],["と"],["その"],["民","たみ"],["を"],["剣","けん"],["の"],["刃","は"],["で"],["打ち破った","うちやぶった"],["。"]]},{"verse":14,"text":"主はモーセに仰せられた。「このことを記録として、書き物に書きしるし、ヨシュアに読んで聞かせよ。わたしはアマレクの記憶を天の下から完全に消し去ってしまう。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["この"],["こと"],["を"],["記録","きろく"],["として"],["、"],["書き物","かきもの"],["に"],["書きしるし","かきしるし"],["、"],["ヨシュア"],["に"],["読んで","よんで"],["聞かせ","きかせ"],["よ"],["。"],["わたし"],["は"],["アマレク"],["の"],["記憶","きおく"],["を"],["天","てん"],["の"],["下","した"],["から"],["完全","かんぜん"],["に"],["消し去って","けしさって"],["しまう"],["。"],["」"]]},{"verse":15,"text":"モーセは祭壇を築き、それをアドナイ・ニシと呼び、","tok":[["モーセ"],["は"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["それ"],["を"],["アドナイ"],["・"],["ニシ"],["と"],["呼び","よび"],["、"]]},{"verse":16,"text":"「それは『主の御座の上の手』のことで、主は代々にわたってアマレクと戦われる」と言った。","tok":[["「"],["それ"],["は"],["『"],["主","ぬし"],["の"],["御座","ぎょざ"],["の"],["上","うえ"],["の"],["手","て"],["』"],["の"],["こと"],["で"],["、"],["主","ぬし"],["は"],["代々","だいだい"],["に"],["わたって"],["アマレク"],["と"],["戦われる","たたかわれる"],["」"],["と"],["言った","いった"],["。"]]}]
[{"verse":1,"text":"主はモーセに仰せられた。「見よ。わたしはあなたをパロに対して神とし、あなたの兄アロンはあなたの預言者となる。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["パロ"],["に対して","にたいして"],["神","かみ"],["と"],["し"],["、"],["あなた"],["の"],["兄","あに"],["アロン"],["は"],["あなた"],["の"],["預言者","よげんしゃ"],["と"],["なる"],["。"]]},{"verse":2,"text":"あなたはわたしの命じることを、みな、告げなければならない。あなたの兄アロンはパロに、イスラエル人をその国から出て行かせるようにと告げなければならない。","tok":[["あなた"],["は"],["わたし"],["の"],["命じる","めいじる"],["こと"],["を"],["、"],["みな"],["、"],["告げなければ","つげなければ"],["ならない"],["。"],["あなた"],["の"],["兄","あに"],["アロン"],["は"],["パロ"],["に"],["、"],["イスラエル"],["人","にん"],["を"],["その"],["国","くに"],["から"],["出て","でて"],["行かせる","いかせる"],["よう"],["に"],["と"],["告げなければ","つげなければ"],["ならない"],["。"]]},{"verse":3,"text":"わたしはパロの心をかたくなにし、わたしのしるしと不思議をエジプトの地で多く行おう。","tok":[["わたし"],["は"],["パロ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["し"],["、"],["わたし"],["の"],["しるし"],["と"],["不思議","ふしぎ"],["を"],["エジプト"],["の"],["地","ち"],["で"],["多く","おおく"],["行おう","おこなおう"],["。"]]},{"verse":4,"text":"パロがあなたがたの言うことを聞き入れないなら、わたしは、手をエジプトの上に置き、大きなさばきによって、わたしの集団、わたしの民イスラエル人をエジプトの地から連れ出す。","tok":[["パロ"],["が"],["あなた"],["がた"],["の"],["言う","いう"],["こと"],["を"],["聞き入れないなら","ききいれないなら"],["、"],["わたし"],["は"],["、"],["手","て"],["を"],["エジプト"],["の"],["上","うえ"],["に"],["置き","おき"],["、"],["大きな","おおきな"],["さばき"],["によって"],["、"],["わたし"],["の"],["集団","しゅうだん"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["人","にん"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ出す","つれだす"],["。"]]},{"verse":5,"text":"わたしが手をエジプトの上に伸ばし、イスラエル人を彼らの真ん中から連れ出すとき、エジプトはわたしが主であることを知るようになる。」","tok":[["わたし"],["が"],["手","て"],["を"],["エジプト"],["の"],["上","うえ"],["に"],["伸ばし","のばし"],["、"],["イスラエル"],["人","にん"],["を"],["彼","かれ"],["ら"],["の"],["真ん中","まんなか"],["から"],["連れ出す","つれだす"],["とき"],["、"],["エジプト"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":6,"text":"そこでモーセとアロンはそうした。主が彼らに命じられたとおりにした。","tok":[["そこ"],["で"],["モーセ"],["と"],["アロン"],["は"],["そう"],["した"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"]]},{"verse":7,"text":"彼らがパロに語ったとき、モーセは八十歳、アロンは八十三歳であった。","tok":[["彼","かれ"],["ら"],["が"],["パロ"],["に"],["語った","かたった"],["とき"],["、"],["モーセ"],["は"],["八十歳","はちじゅうさい"],["、"],["アロン"],["は"],["八十三歳","はちじゅうさんさい"],["で"],["あった"],["。"]]},{"verse":8,"text":"また主はモーセとアロンに仰せられた。","tok":[["また"],["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["仰せられた","おおせられた"],["。"]]},{"verse":9,"text":"「パロがあなたがたに、『おまえたちの不思議を行え』と言うとき、あなたはアロンに、『その杖を取って、パロの前に投げよ』と言わなければならない。それは蛇になる。」","tok":[["「"],["パロ"],["が"],["あなた"],["がた"],["に"],["、"],["『"],["おまえ"],["たち"],["の"],["不思議","ふしぎ"],["を"],["行え","おこなえ"],["』"],["と"],["言う","いう"],["とき"],["、"],["あなた"],["は"],["アロン"],["に"],["、"],["『"],["その"],["杖","つえ"],["を"],["取って","とって"],["、"],["パロ"],["の"],["前","まえ"],["に"],["投げ","なげ"],["よ"],["』"],["と"],["言わなければ","いわなければ"],["ならない"],["。"],["それ"],["は"],["蛇","へび"],["に"],["なる"],["。"],["」"]]},{"verse":10,"text":"モーセとアロンはパロのところに行き、主が命じられたとおりに行った。アロンが自分の杖をパロとその家臣たちの前に投げたとき、それは蛇になった。","tok":[["モーセ"],["と"],["アロン"],["は"],["パロ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"],["アロン"],["が"],["自分","じぶん"],["の"],["杖","つえ"],["を"],["パロ"],["と"],["その"],["家臣","かしん"],["たち"],["の"],["前","まえ"],["に"],["投げた","なげた"],["とき"],["、"],["それ"],["は"],["蛇","へび"],["に"],["なった"],["。"]]},{"verse":11,"text":"そこで、パロも知恵のある者と呪術者を呼び寄せた。これらのエジプトの呪法師たちもまた彼らの秘術を使って、同じことをした。","tok":[["そこ"],["で"],["、"],["パロ"],["も"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["と"],["呪術者","じゅじゅつしゃ"],["を"],["呼び寄せた","よびよせた"],["。"],["これ"],["ら"],["の"],["エジプト"],["の"],["呪","しゅ"],["法師","ほうし"],["たち"],["も"],["また"],["彼","かれ"],["ら"],["の"],["秘術","ひじゅつ"],["を"],["使って","つかって"],["、"],["同じ","おなじ"],["こと"],["を"],["した"],["。"]]},{"verse":12,"text":"彼らがめいめい自分の杖を投げると、それが蛇になった。しかしアロンの杖は彼らの杖をのみこんだ。","tok":[["彼","かれ"],["ら"],["が"],["めいめい"],["自分","じぶん"],["の"],["杖","つえ"],["を"],["投げる","なげる"],["と"],["、"],["それ"],["が"],["蛇","へび"],["に"],["なった"],["。"],["しかし"],["アロン"],["の"],["杖","つえ"],["は"],["彼","かれ"],["ら"],["の"],["杖","つえ"],["を"],["のみこんだ"],["。"]]},{"verse":13,"text":"それでもパロの心はかたくなになり、彼らの言うことを聞き入れなかった。主が仰せられたとおりである。","tok":[["それ"],["で"],["も"],["パロ"],["の"],["心","こころ"],["は"],["かたくな"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞き入れなかった","ききいれなかった"],["。"],["主","ぬし"],["が"],["仰せられた","おおせられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":14,"text":"主はモーセに仰せられた。「パロの心は強情で、民を行かせることを拒んでいる。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["パロ"],["の"],["心","こころ"],["は"],["強情","ごうじょう"],["で"],["、"],["民","みん"],["を"],["行かせる","いかせる"],["こと"],["を"],["拒んで","こばんで"],["いる"],["。"]]},{"verse":15,"text":"あなたは朝、パロのところへ行け。見よ。彼は水のところに出て来る。あなたはナイルの岸に立って彼を迎えよ。そして、蛇に変わったあの杖を手に取って、","tok":[["あなた"],["は"],["朝","あさ"],["、"],["パロ"],["の"],["ところ"],["へ"],["行け","いけ"],["。"],["見","み"],["よ"],["。"],["彼","かれ"],["は"],["水","みず"],["の"],["ところ"],["に"],["出て","でて"],["来る","くる"],["。"],["あなた"],["は"],["ナイル"],["の"],["岸","きし"],["に"],["立って","たって"],["彼","かれ"],["を"],["迎え","むかえ"],["よ"],["。"],["そして"],["、"],["蛇","へび"],["に"],["変わった","かわった"],["あの"],["杖","つえ"],["を"],["手","て"],["に"],["取って","とって"],["、"]]},{"verse":16,"text":"彼に言わなければならない。ヘブル人の神、主が私をあなたに遣わして仰せられます。『わたしの民を行かせ、彼らに、荒野でわたしに仕えさせよ。』ああ、しかし、あなたは今までお聞きになりませんでした。","tok":[["彼","かれ"],["に"],["言わなければ","いわなければ"],["ならない"],["。"],["ヘブル人","へぶるにん"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["私","わたくし"],["を"],["あなた"],["に"],["遣わして","つかわして"],["仰せられます","おおせられます"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["行かせ","いかせ"],["、"],["彼","かれ"],["ら"],["に"],["、"],["荒野","こうや"],["で"],["わたし"],["に"],["仕えさせ","つかえさせ"],["よ"],["。"],["』"],["ああ"],["、"],["しかし"],["、"],["あなた"],["は"],["今まで","いままで"],["お聞き","おきき"],["に"],["なりませんでした"],["。"]]},{"verse":17,"text":"主はこう仰せられます。『あなたは、次のことによって、わたしが主であることを知るようになる。』ご覧ください。私は手に持っている杖でナイルの水を打ちます。水は血に変わり、","tok":[["主","ぬし"],["は"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["あなた"],["は"],["、"],["次","つぎ"],["の"],["こと"],["によって"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["』"],["ご覧","ごらん"],["ください"],["。"],["私","わたくし"],["は"],[
[{"verse":1,"text":"それから神はこれらのことばを、ことごとく告げて仰せられた。","tok":[["それ"],["から"],["神","かみ"],["は"],["これ"],["ら"],["の"],["ことば"],["を"],["、"],["ことごとく"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「わたしは、あなたをエジプトの国、奴隷の家から連れ出した、あなたの神、主である。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["連れ出した","つれだした"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたには、わたしのほかに、ほかの神々があってはならない。","tok":[["あなた"],["に"],["は"],["、"],["わたし"],["の"],["ほか"],["に"],["、"],["ほか"],["の"],["神々","かみがみ"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたは、自分のために、偶像を造ってはならない。上の天にあるものでも、下の地にあるものでも、地の下の水の中にあるものでも、どんな形をも造ってはならない。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["偶像","ぐうぞう"],["を"],["造って","つくって"],["は"],["ならない"],["。"],["上","うえ"],["の"],["天","てん"],["に"],["ある"],["もの"],["で"],["も"],["、"],["下","した"],["の"],["地","ち"],["に"],["ある"],["もの"],["で"],["も"],["、"],["地","ち"],["の"],["下","した"],["の"],["水","みず"],["の"],["中","なか"],["に"],["ある"],["もの"],["で"],["も"],["、"],["どんな"],["形","かたち"],["を"],["も"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":5,"text":"それらを拝んではならない。それらに仕えてはならない。あなたの神、主であるわたしは、ねたむ神、わたしを憎む者には、父の咎を子に報い、三代、四代にまで及ぼし、","tok":[["それ"],["ら"],["を"],["拝んで","おがんで"],["は"],["ならない"],["。"],["それ"],["ら"],["に"],["仕えて","つかえて"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["は"],["、"],["ねたむ"],["神","かみ"],["、"],["わたし"],["を"],["憎む","にくむ"],["者","もの"],["に"],["は"],["、"],["父","ちち"],["の"],["咎","とが"],["を"],["子","こ"],["に"],["報い","むくい"],["、"],["三代","みよ"],["、"],["四","よん"],["代","だい"],["に"],["まで"],["及ぼし","およぼし"],["、"]]},{"verse":6,"text":"わたしを愛し、わたしの命令を守る者には、恵みを千代にまで施すからである。","tok":[["わたし"],["を"],["愛し","あいし"],["、"],["わたし"],["の"],["命令","めいれい"],["を"],["守る","まもる"],["者","もの"],["に"],["は"],["、"],["恵み","めぐみ"],["を"],["千代","ちよ"],["に"],["まで"],["施す","ほどこす"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"あなたは、あなたの神、主の御名を、みだりに唱えてはならない。主は、御名をみだりに唱える者を、罰せずにはおかない。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["、"],["みだり"],["に"],["唱えて","となえて"],["は"],["ならない"],["。"],["主","ぬし"],["は"],["、"],["御名","ぎょめい"],["を"],["みだり"],["に"],["唱える","となえる"],["者","もの"],["を"],["、"],["罰せず","ばっせず"],["に"],["は"],["おかない"],["。"]]},{"verse":8,"text":"安息日を覚えて、これを聖なる日とせよ。","tok":[["安息日","あんそくび"],["を"],["覚えて","おぼえて"],["、"],["これ"],["を"],["聖","せい"],["なる"],["日","ひ"],["と"],["せよ"],["。"]]},{"verse":9,"text":"六日間、働いて、あなたのすべての仕事をしなければならない。","tok":[["六","ろく"],["日間","にちかん"],["、"],["働いて","はたらいて"],["、"],["あなた"],["の"],["すべて"],["の"],["仕事","しごと"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":10,"text":"しかし七日目は、あなたの神、主の安息である。あなたはどんな仕事もしてはならない。――あなたも、あなたの息子、娘、それにあなたの男奴隷や女奴隷、家畜、また、あなたの町囲みの中にいる在留異国人も――","tok":[["しかし"],["七日目","ななかめ"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["安息","あんそく"],["で"],["ある"],["。"],["あなた"],["は"],["どんな"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"],["―"],["―"],["あなた"],["も"],["、"],["あなた"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["それ"],["に"],["あなた"],["の"],["男","おとこ"],["奴隷","どれい"],["や"],["女","じょ"],["奴隷","どれい"],["、"],["家畜","かちく"],["、"],["また"],["、"],["あなた"],["の"],["町","まち"],["囲み","かこみ"],["の"],["中","なか"],["に"],["いる"],["在留","ざいりゅう"],["異国人","いこくにん"],["も"],["―"],["―"]]},{"verse":11,"text":"それは主が六日のうちに、天と地と海、またそれらの中にいるすべてのものを造り、七日目に休まれたからである。それゆえ、主は安息日を祝福し、これを聖なるものと宣言された。","tok":[["それ"],["は"],["主","ぬし"],["が"],["六日","むいか"],["の"],["うち"],["に"],["、"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["、"],["また"],["それ"],["ら"],["の"],["中","なか"],["に"],["いる"],["すべて"],["の"],["もの"],["を"],["造り","つくり"],["、"],["七日目","ななかめ"],["に"],["休まれた","やすまれた"],["から"],["で"],["ある"],["。"],["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["安息日","あんそくび"],["を"],["祝福","しゅくふく"],["し"],["、"],["これ"],["を"],["聖","せい"],["なる"],["もの"],["と"],["宣言","せんげん"],["された"],["。"]]},{"verse":12,"text":"あなたの父と母を敬え。あなたの神、主が与えようとしておられる地で、あなたの齢が長くなるためである。","tok":[["あなた"],["の"],["父","ちち"],["と"],["母","はは"],["を"],["敬え","うやまえ"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えよ
。"],["「"],["恐れて","おそれて"],["は"],["いけません"],["。"],["神","かみ"],["が"],["来られた","こられた"],["の"],["は"],["あなた"],["がた"],["を"],["試みる","こころみる"],["ため"],["な"],["の"],["です"],["。"],["また"],["、"],["あなた"],["がた"],["に"],["神","かみ"],["へ"],["の"],["恐れ","おそれ"],["が"],["生じて","しょうじて"],["、"],["あなた"],["がた"],["が"],["罪","つみ"],["を"],["犯さない","おかさない"],["ため"],["です"],["。"],["」"]]},{"verse":21,"text":"そこで、民は遠く離れて立ち、モーセは神のおられる暗やみに近づいて行った。","tok":[["そこ"],["で"],["、"],["民","みん"],["は"],["遠く","とおく"],["離れて","はなれて"],["立ち","たち"],["、"],["モーセ"],["は"],["神","かみ"],["の"],["おられる"],["暗やみ","くらやみ"],["に"],["近づいて","ちかづいて"],["行った","いった"],["。"]]},{"verse":22,"text":"主はモーセに仰せられた。「あなたはイスラエル人にこう言わなければならない。あなたがた自身、わたしが天からあなたがたと話したのを見た。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["イスラエル"],["人","にん"],["に"],["こう"],["言わなければ","いわなければ"],["ならない"],["。"],["あなた"],["がた"],["自身","じしん"],["、"],["わたし"],["が"],["天","てん"],["から"],["あなた"],["がた"],["と"],["話した","はなした"],["の"],["を"],["見た","みた"],["。"]]},{"verse":23,"text":"あなたがたはわたしと並べて、銀の神々を造ってはならない。また、あなたがた自身のために金の神々も造ってはならない。","tok":[["あなた"],["がた"],["は"],["わたし"],["と"],["並べて","ならべて"],["、"],["銀","ぎん"],["の"],["神々","かみがみ"],["を"],["造って","つくって"],["は"],["ならない"],["。"],["また"],["、"],["あなた"],["がた"],["自身","じしん"],["の"],["ため"],["に"],["金","かね"],["の"],["神々","かみがみ"],["も"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":24,"text":"わたしのために土の祭壇を造り、その上で、羊と牛をあなたの全焼のいけにえとし、和解のいけにえとしてささげなければならない。わたしの名を覚えさせるすべての所で、わたしはあなたに臨み、あなたを祝福しよう。","tok":[["わたし"],["の"],["ため"],["に"],["土","つち"],["の"],["祭壇","さいだん"],["を"],["造り","つくり"],["、"],["その"],["上","うえ"],["で"],["、"],["羊","ひつじ"],["と"],["牛","うし"],["を"],["あなた"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["し"],["、"],["和解","わかい"],["の"],["いけにえ"],["として"],["ささげなければ"],["ならない"],["。"],["わたし"],["の"],["名","な"],["を"],["覚えさせる","おぼえさせる"],["すべて"],["の"],["所","ところ"],["で"],["、"],["わたし"],["は"],["あなた"],["に"],["臨み","のぞみ"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["しよう"],["。"]]},{"verse":25,"text":"あなたが石の祭壇をわたしのために造るなら、切り石でそれを築いてはならない。あなたが石に、のみを当てるなら、それを汚すことになる。","tok":[["あなた"],["が"],["石","いし"],["の"],["祭壇","さいだん"],["を"],["わたし"],["の"],["ため"],["に"],["造るなら","つくるなら"],["、"],["切り石","きりいし"],["で"],["それ"],["を"],["築いて","きずいて"],["は"],["ならない"],["。"],["あなた"],["が"],["石","いし"],["に"],["、"],["のみ"],["を"],["当てるなら","あてるなら"],["、"],["それ"],["を"],["汚す","けがす"],["こと"],["に"],["なる"],["。"]]},{"verse":26,"text":"あなたは階段で、わたしの祭壇に上ってはならない。あなたの裸が、その上にあらわれてはならないからである。","tok":[["あなた"],["は"],["階段","かいだん"],["で"],["、"],["わたし"],["の"],["祭壇","さいだん"],["に"],["上って","のぼって"],["は"],["ならない"],["。"],["あなた"],["の"],["裸","はだか"],["が"],["、"],["その"],["上","うえ"],["に"],["あらわれて"],["は"],["ならない"],["から"],["で"],["ある"],["。"]]}]
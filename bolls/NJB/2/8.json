[{"verse":1,"text":"主はモーセに仰せられた。「パロのもとに行って言え。主はこう仰せられます。『わたしの民を行かせ、彼らにわたしに仕えさせるようにせよ。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["パロ"],["の"],["もと"],["に"],["行って","いって"],["言え","いえ"],["。"],["主","ぬし"],["は"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["行かせ","いかせ"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["に"],["仕えさせる","つかえさせる"],["よう"],["に"],["せよ"],["。"]]},{"verse":2,"text":"もし、あなたが行かせることを拒むなら、見よ、わたしは、あなたの全領土を、かえるをもって、打つ。","tok":[["もし"],["、"],["あなた"],["が"],["行かせる","いかせる"],["こと"],["を"],["拒むなら","こばむなら"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["全","ぜん"],["領土","りょうど"],["を"],["、"],["かえる"],["を"],["もって"],["、"],["打つ","うつ"],["。"]]},{"verse":3,"text":"かえるがナイルに群がり、上って来て、あなたの家に入る。あなたの寝室に、あなたの寝台に、あなたの家臣の家に、あなたの民の中に、あなたのかまどに、あなたのこね鉢に、入る。","tok":[["かえる"],["が"],["ナイル"],["に"],["群がり","むらがり"],["、"],["上って","のぼって"],["来て","きて"],["、"],["あなた"],["の"],["家","いえ"],["に"],["入る","はいる"],["。"],["あなた"],["の"],["寝室","しんしつ"],["に"],["、"],["あなた"],["の"],["寝台","しんだい"],["に"],["、"],["あなた"],["の"],["家臣","かしん"],["の"],["家","いえ"],["に"],["、"],["あなた"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["、"],["あなた"],["の"],["かまど"],["に"],["、"],["あなた"],["の"],["こね鉢","こねばち"],["に"],["、"],["入る","はいる"],["。"]]},{"verse":4,"text":"こうしてかえるは、あなたとあなたの民とあなたのすべての家臣の上に、はい上がる。』」","tok":[["こう"],["して"],["かえる"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["民","たみ"],["と"],["あなた"],["の"],["すべて"],["の"],["家臣","かしん"],["の"],["上","うえ"],["に"],["、"],["はい上がる","はいあがる"],["。"],["』"],["」"]]},{"verse":5,"text":"主はモーセに仰せられた。「アロンに言え。あなたの手に杖を持ち、川の上、流れの上、池の上に差し伸ばし、かえるをエジプトの地に、はい上がらせなさい。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["アロン"],["に"],["言え","いえ"],["。"],["あなた"],["の"],["手","て"],["に"],["杖","つえ"],["を"],["持ち","もち"],["、"],["川","かわ"],["の"],["上","うえ"],["、"],["流れ","ながれ"],["の"],["上","うえ"],["、"],["池の上","いけのうえ"],["に"],["差し伸ばし","さしのばし"],["、"],["かえる"],["を"],["エジプト"],["の"],["地","ち"],["に"],["、"],["はい上がらせ","はいあがらせ"],["なさい"],["。"],["」"]]},{"verse":6,"text":"アロンが手をエジプトの水の上に差し伸ばすと、かえるがはい上がって、エジプトの地をおおった。","tok":[["アロン"],["が"],["手","て"],["を"],["エジプト"],["の"],["水","みず"],["の"],["上","うえ"],["に"],["差し伸ばす","さしのばす"],["と"],["、"],["かえる"],["が"],["はい上がって","はいあがって"],["、"],["エジプト"],["の"],["地","ち"],["を"],["おおった"],["。"]]},{"verse":7,"text":"呪法師たちも彼らの秘術を使って、同じようにかえるをエジプトの地の上に、はい上がらせた。","tok":[["呪","しゅ"],["法師","ほうし"],["たち"],["も"],["彼","かれ"],["ら"],["の"],["秘術","ひじゅつ"],["を"],["使って","つかって"],["、"],["同じ","おなじ"],["よう"],["に"],["かえる"],["を"],["エジプト"],["の"],["地","ち"],["の"],["上","うえ"],["に"],["、"],["はい上がらせた","はいあがらせた"],["。"]]},{"verse":8,"text":"パロはモーセとアロンを呼び寄せて言った。「かえるを私と私の民のところから除くように、主に祈れ。そうすれば、私はこの民を行かせる。彼らは主にいけにえをささげることができる。」","tok":[["パロ"],["は"],["モーセ"],["と"],["アロン"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["かえる"],["を"],["私","わたくし"],["と"],["私","わたくし"],["の"],["民","たみ"],["の"],["ところ"],["から"],["除く","のぞく"],["よう"],["に"],["、"],["主に","おもに"],["祈れ","いのれ"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["は"],["この"],["民","たみ"],["を"],["行かせる","いかせる"],["。"],["彼","かれ"],["ら"],["は"],["主に","おもに"],["いけにえ"],["を"],["ささげる"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":9,"text":"モーセはパロに言った。「かえるがあなたとあなたの家から断ち切られ、ナイルにだけ残るように、あなたと、あなたの家臣と、あなたの民のために、私がいつ祈ったらよいのか、どうぞ言いつけてください。」","tok":[["モーセ"],["は"],["パロ"],["に"],["言った","いった"],["。"],["「"],["かえる"],["が"],["あなた"],["と"],["あなた"],["の"],["家","いえ"],["から"],["断ち切られ","たちきられ"],["、"],["ナイル"],["に"],["だけ"],["残る","のこる"],["よう"],["に"],["、"],["あなた"],["と"],["、"],["あなた"],["の"],["家臣","かしん"],["と"],["、"],["あなた"],["の"],["民","たみ"],["の"],["ため"],["に"],["、"],["私","わたくし"],["が"],["いつ"],["祈ったら","いのったら"],["よい"],["の"],["か"],["、"],["どうぞ"],["言いつけて","いいつけて"],["ください"],["。"],["」"]]},{"verse":10,"text":"パロが「あす」と言ったので、モーセは言った。「あなたのことばどおりになりますように。私たちの神、主のような方はほかにいないことを、あなたが知るためです。","tok":[["パロ"],["が"],["「"],["あす"],["」"],["と"],["言った","いった"],["ので"],["、"],["モーセ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["の"],["ことば"],["どおり"],["に"],["なります"],["よう"],["に"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["よう"],["な"],["方","かた"],["は"],["ほか"],["に"],["いない"],["こと"],["を"],["、"],["あなた"],["が"],["知る","しる"],["ため"],["です"],["。"]]},{"verse":11,"text":"かえるは、あなたとあなたの家とあなたの家臣と、あなたの民から離れて、ナイルにだけ残りましょう。」","tok":[["かえる"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["家","いえ"],["と"],["あなた"],["の"],["家臣","かしん"],["と"],["、"],["あなた"],["の"],["民","たみ"],["から"],["離れて","はなれて"],["、"],["ナイル"],["に"],["だけ"],["残りましょう","のこりましょう"],["。"],["」"]]},{"verse":12,"text":"こうしてモーセとアロンはパロのところから出て来た。モーセは、自分がパロに約束したかえるのことについて、主に叫んだ。","tok":[["こう"],["して"],["モーセ"],["と"],["アロン"],["は"],["パロ"],["の"],["ところ"],["から"],["出て","でて"],["来た","きた"],["。"],["モーセ"],["は"],["、"],["自分","じぶん"],["が"],["パロ"],["に"],["約束","やくそく"],["した"],["かえる"],["の"],["こと"],["について"],["、"],["主に","おもに"],["叫んだ","さけんだ"],["。"]]},{"verse":13,"text":"主はモーセのことばどおりにされたので、かえるは家と庭と畑から死に絶えた。","tok":[["主","ぬし"],["は"],["モーセ"],["の"],["ことば"],["どおり"],["に"],["された"],["ので"],["、"],["かえる"],["は"],["家","いえ"],["と"],["庭","にわ"],["と"],["畑","はたけ"],["から"],["死に絶えた","しにたえた"],["。"]]},{"verse":14,"text":"人々はそれらを山また山と積み上げたので、地は臭くなった。","tok":[["人々","ひとびと"],["は"],["それ"],["ら"],["を"],["山","やま"],["また"],["山","やま"],["と"],["積み上げた","つみあげた"],["ので"],["、"],["地","ち"],["は"],["臭く","くさく"],["なった"],["。"]]},{"verse":15,"text":"ところが、パロは息つく暇のできたのを見て、強情になり、彼らの言うことを聞き入れなかった。主の言われたとおりである。","tok":[["ところ"],["が"],["、"],["パロ"],["は"],["息","いき"],["つく"],["暇","ひま"],["の"],["できた"],["の"],["を"],["見て","みて"],["、"],["強情","ごうじょう"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞き入れなかった","ききいれなかった"],["。"],["主","ぬし"],["の"],["言われた","いわれた"],["とおり"],["で"],["ある"],["。"]]},{"verse":16,"text":"主はモーセに仰せられた。「アロンに言え。あなたの杖を差し伸ばして、地のちりを打て。そうすれば、それはエジプトの全土で、ぶよとなろう。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["アロン"],["に"],["言え","いえ"],["。"],["あなた"],["の"],["杖","つえ"],["を"],["差し伸ばして","さしのばして"],["、"],["地","ち"],["の"],["ちり"],["を"],["打て","うて"],["。"],["そう"],["すれば"],["、"],["それ"],["は"],["エジプト"],["の"],["全土","ぜんど"],["で"],["、"],["ぶよ"],["と"],["なろう"],["。"],["」"]]},{"verse":17,"text":"そこで彼らはそのように行った。アロンは手を差し伸ばして、杖で地のちりを打った。すると、ぶよは人や獣についた。地のちりはみな、エジプト全土で、ぶよとなった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["その"],["よう"],["に"],["行った","おこなった"],["。"],["アロン"],["は"],["手","て"],["を"],["差し伸ばして","さしのばして"],["、"],["杖","つえ"],["で"],["地","ち"],["の"],["ちり"],["を"],["打った","うった"],["。"],["する"],["と"],["、"],["ぶよ"],["は"],["人","ひと"],["や"],["獣","けもの"],["に"],["ついた"],["。"],["地","ち"],["の"],["ちり"],["は"],["みな"],["、"],["エジプト"],["全土","ぜんど"],["で"],["、"],["ぶよ"],["と"],["なった"],["。"]]},{"verse":18,"text":"呪法師たちもぶよを出そうと、彼らの秘術を使って同じようにしたが、できなかった。ぶよは人や獣についた。","tok":[["呪","しゅ"],["法師","ほうし"],["たち"],["も"],["ぶよ"],["を"],["出そう","だそう"],["と"],["、"],["彼","かれ"],["ら"],["の"],["秘術","ひじゅつ"],["を"],["使って","つかって"],["同じ","おなじ"],["よう"],["に"],["した"],["が"],["、"],["できなかった"],["。"],["ぶよ"],["は"],["人","ひと"],["や"],["獣","けもの"],["に"],["ついた"],["。"]]},{"verse":19,"text":"そこで、呪法師たちはパロに、「これは神の指です」と言った。しかしパロの心はかたくなになり、彼らの言うことを聞き入れなかった。主の言われたとおりである。","tok":[["そこ"],["で"],["、"],["呪","しゅ"],["法師","ほうし"],["たち"],["は"],["パロ"],["に"],["、"],["「"],["これ"],["は"],["神","かみ"],["の"],["指","ゆび"],["です"],["」"],["と"],["言った","いった"],["。"],["しかし"],["パロ"],["の"],["心","こころ"],["は"],["かたくな"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞き入れなかった","ききいれなかった"],["。"],["主","ぬし"],["の"],["言われた","いわれた"],["とおり"],["で"],["ある"],["。"]]},{"verse":20,"text":"主はモーセに仰せられた。「あしたの朝早く、パロの前に出よ。見よ。彼は水のところに出て来る。彼にこう言え。主はこう仰せられます。『わたしの民を行かせ、彼らをわたしに仕えさせよ。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あした"],["の"],["朝","あさ"],["早く","はやく"],["、"],["パロ"],["の"],["前","まえ"],["に"],["出よ","でよ"],["。"],["見","み"],["よ"],["。"],["彼","かれ"],["は"],["水","みず"],["の"],["ところ"],["に"],["出て","でて"],["来る","くる"],["。"],["彼","かれ"],["に"],["こう"],["言え","いえ"],["。"],["主","ぬし"],["は"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["行かせ","いかせ"],["、"],["彼","かれ"],["ら"],["を"],["わたし"],["に"],["仕えさせ","つかえさせ"],["よ"],["。"]]},{"verse":21,"text":"もしもあなたがわたしの民を行かせないなら、さあ、わたしは、あぶの群れを、あなたとあなたの家臣とあなたの民の中に、またあなたの家の中に放つ。エジプトの家々も、彼らがいる土地も、あぶの群れで満ちる。","tok":[["もし"],["も"],["あなた"],["が"],["わたし"],["の"],["民","たみ"],["を"],["行かせないなら","いかせないなら"],["、"],["さあ"],["、"],["わたし"],["は"],["、"],["あぶ"],["の"],["群れ","むれ"],["を"],["、"],["あなた"],["と"],["あなた"],["の"],["家臣","かしん"],["と"],["あなた"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["、"],["また"],["あなた"],["の"],["家","いえ"],["の"],["中","なか"],["に"],["放つ","はなつ"],["。"],["エジプト"],["の"],["家々","いえいえ"],["も"],["、"],["彼","かれ"],["ら"],["が"],["いる"],["土地","とち"],["も"],["、"],["あぶ"],["の"],["群れ","むれ"],["で"],["満ちる","みちる"],["。"]]},{"verse":22,"text":"わたしはその日、わたしの民がとどまっているゴシェンの地を特別に扱い、そこには、あぶの群れがいないようにする。それは主であるわたしが、その地の真ん中にいることを、あなたが知るためである。","tok":[["わたし"],["は"],["その"],["日","ひ"],["、"],["わたし"],["の"],["民","たみ"],["が"],["とどまって"],["いる"],["ゴシェン"],["の"],["地","ち"],["を"],["特別","とくべつ"],["に"],["扱い","あつかい"],["、"],["そこ"],["に"],["は"],["、"],["あぶ"],["の"],["群れ","むれ"],["が"],["いない"],["よう"],["に"],["する"],["。"],["それ"],["は"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["、"],["その"],["地","ち"],["の"],["真ん中","まんなか"],["に"],["いる"],["こと"],["を"],["、"],["あなた"],["が"],["知る","しる"],["ため"],["で"],["ある"],["。"]]},{"verse":23,"text":"わたしは、わたしの民とあなたの民との間を区別して、救いを置く。あす、このしるしが起こる。』」","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["民","たみ"],["と"],["あなた"],["の"],["民","たみ"],["と"],["の"],["間","あいだ"],["を"],["区別","くべつ"],["して"],["、"],["救い","すくい"],["を"],["置く","おく"],["。"],["あす"],["、"],["この"],["しるし"],["が"],["起こる","おこる"],["。"],["』"],["」"]]},{"verse":24,"text":"主がそのようにされたので、おびただしいあぶの群れが、パロの家とその家臣の家とに入って来た。エジプトの全土にわたり、地はあぶの群れによって荒れ果てた。","tok":[["主","ぬし"],["が"],["その"],["よう"],["に"],["された"],["ので"],["、"],["おびただしい"],["あぶ"],["の"],["群れ","むれ"],["が"],["、"],["パロ"],["の"],["家","いえ"],["と"],["その"],["家臣","かしん"],["の"],["家","いえ"],["と"],["に"],["入って","はいって"],["来た","きた"],["。"],["エジプト"],["の"],["全土","ぜんど"],["に"],["わたり"],["、"],["地","ち"],["は"],["あぶ"],["の"],["群れ","むれ"],["によって"],["荒れ果てた","あれはてた"],["。"]]},{"verse":25,"text":"パロはモーセとアロンを呼び寄せて言った。「さあ、この国内でおまえたちの神にいけにえをささげよ。」","tok":[["パロ"],["は"],["モーセ"],["と"],["アロン"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["さあ"],["、"],["この"],["国内","こくない"],["で"],["おまえ"],["たち"],["の"],["神","かみ"],["に"],["いけにえ"],["を"],["ささげ"],["よ"],["。"],["」"]]},{"verse":26,"text":"モーセは答えた。「そうすることは、とてもできません。なぜなら私たちは、私たちの神、主に、エジプト人の忌みきらうものを、いけにえとしてささげるからです。もし私たちがエジプト人の目の前で、その忌みきらうものを、いけにえとしてささげるなら、彼らは私たちを石で打ち殺しはしないでしょうか。","tok":[["モーセ"],["は"],["答えた","こたえた"],["。"],["「"],["そう"],["する"],["こと"],["は"],["、"],["とても"],["できません"],["。"],["なぜ"],["なら"],["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["エジプト"],["人","にん"],["の"],["忌みきらう","いみきらう"],["もの"],["を"],["、"],["いけにえ"],["として"],["ささげる"],["から"],["です"],["。"],["もし"],["私たち","わたしたち"],["が"],["エジプト"],["人","にん"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["その"],["忌みきらう","いみきらう"],["もの"],["を"],["、"],["いけにえ"],["として"],["ささげるなら"],["、"],["彼","かれ"],["ら"],["は"],["私たち","わたしたち"],["を"],["石","いし"],["で"],["打ち殺し","うちころし"],["は"],["しないでしょう"],["か"],["。"]]},{"verse":27,"text":"それで私たちは荒野に三日の道のりの旅をして、私たちの神、主にいけにえをささげなければなりません。これは、主が私たちにお命じになることです。」","tok":[["それ"],["で"],["私たち","わたしたち"],["は"],["荒野","こうや"],["に"],["三日","みっか"],["の"],["道のり","みちのり"],["の"],["旅","たび"],["を"],["して"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["いけにえ"],["を"],["ささげなければ"],["なりません"],["。"],["これ"],["は"],["、"],["主","ぬし"],["が"],["私たち","わたしたち"],["に"],["お命じ","おめいじ"],["に"],["なる"],["こと"],["です"],["。"],["」"]]},{"verse":28,"text":"パロは言った。「私は、おまえたちを行かせよう。おまえたちは荒野でおまえたちの神、主にいけにえをささげるがよい。ただ、決して遠くへ行ってはならない。私のために祈ってくれ。」","tok":[["パロ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["おまえ"],["たち"],["を"],["行かせよう","いかせよう"],["。"],["おまえ"],["たち"],["は"],["荒野","こうや"],["で"],["おまえ"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["いけにえ"],["を"],["ささげる"],["が"],["よい"],["。"],["ただ"],["、"],["決して","けっして"],["遠く","とおく"],["へ"],["行って","いって"],["は"],["ならない"],["。"],["私","わたくし"],["の"],["ため"],["に"],["祈って","いのって"],["くれ"],["。"],["」"]]},{"verse":29,"text":"モーセは言った。「それでは、私はあなたのところから出て行きます。私は主に祈ります。あす、あぶが、パロとその家臣とその民から離れます。ただ、パロは、重ねて欺かないようにしてください。民が主にいけにえをささげに行けないようにしないでください。」","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["それ"],["で"],["は"],["、"],["私","わたくし"],["は"],["あなた"],["の"],["ところ"],["から"],["出て","でて"],["行きます","いきます"],["。"],["私","わたくし"],["は"],["主","ぬし"],["に"],["祈ります","いのります"],["。"],["あす"],["、"],["あぶ"],["が"],["、"],["パロ"],["と"],["その"],["家臣","かしん"],["と"],["その"],["民","たみ"],["から"],["離れます","はなれます"],["。"],["ただ"],["、"],["パロ"],["は"],["、"],["重ねて","かさねて"],["欺かない","あざむかない"],["よう"],["に"],["して"],["ください"],["。"],["民","たみ"],["が"],["主に","おもに"],["いけにえ"],["を"],["ささげ"],["に"],["行けない","いけない"],["よう"],["に"],["しないで"],["ください"],["。"],["」"]]},{"verse":30,"text":"モーセはパロのところから出て行って主に祈った。","tok":[["モーセ"],["は"],["パロ"],["の"],["ところ"],["から"],["出て","でて"],["行って","いって"],["主に","おもに"],["祈った","いのった"],["。"]]},{"verse":31,"text":"主はモーセの願ったとおりにされたので、あぶはパロとその家臣およびその民から離れた。一匹も残らなかった。","tok":[["主","ぬし"],["は"],["モーセ"],["の"],["願った","ねがった"],["とおり"],["に"],["された"],["ので"],["、"],["あぶ"],["は"],["パロ"],["と"],["その"],["家臣","かしん"],["および"],["その"],["民","たみ"],["から"],["離れた","はなれた"],["。"],["一匹","いちひき"],["も"],["残らなかった","のこらなかった"],["。"]]},{"verse":32,"text":"しかし、パロはこのときも強情になり、民を行かせなかった。","tok":[["しかし"],["、"],["パロ"],["は"],["この"],["とき"],["も"],["強情","ごうじょう"],["に"],["なり"],["、"],["民","みん"],["を"],["行かせなかった","いかせなかった"],["。"]]}]
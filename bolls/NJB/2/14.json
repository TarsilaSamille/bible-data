[{"verse":1,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人に、引き返すように言え。そしてミグドルと海の間にあるピ・ハヒロテに面したバアル・ツェフォンの手前で宿営せよ。あなたがたは、それに向かって海辺に宿営しなければならない。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["、"],["引き返す","ひきかえす"],["よう"],["に"],["言え","いえ"],["。"],["そして"],["ミグドル"],["と"],["海","うみ"],["の"],["間","あいだ"],["に"],["ある"],["ピ"],["・"],["ハヒロテ"],["に"],["面した","めんした"],["バアル"],["・"],["ツェフォン"],["の"],["手前","てまえ"],["で"],["宿営","しゅくえい"],["せよ"],["。"],["あなた"],["がた"],["は"],["、"],["それ"],["に"],["向かって","むかって"],["海辺","うみべ"],["に"],["宿営","しゅくえい"],["しなければ"],["ならない"],["。"]]},{"verse":3,"text":"パロはイスラエル人について、『彼らはあの地で迷っている。荒野は彼らを閉じ込めてしまった』と言うであろう。","tok":[["パロ"],["は"],["イスラエル"],["人","にん"],["について"],["、"],["『"],["彼","かれ"],["ら"],["は"],["あの"],["地","ち"],["で"],["迷って","まよって"],["いる"],["。"],["荒野","こうや"],["は"],["彼","かれ"],["ら"],["を"],["閉じ込めて","とじこめて"],["しまった"],["』"],["と"],["言うで","ゆうで"],["あろう"],["。"]]},{"verse":4,"text":"わたしはパロの心をかたくなにし、彼が彼らのあとを追えば、パロとその全軍勢を通してわたしは栄光を現し、エジプトはわたしが主であることを知るようになる。」そこでイスラエル人はそのとおりにした。","tok":[["わたし"],["は"],["パロ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["し"],["、"],["彼","かれ"],["が"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追えば","おえば"],["、"],["パロ"],["と"],["その"],["全","ぜん"],["軍勢","ぐんぜい"],["を"],["通して","とおして"],["わたし"],["は"],["栄光","えいこう"],["を"],["現し","あらわし"],["、"],["エジプト"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"],["そこ"],["で"],["イスラエル"],["人","にん"],["は"],["その"],["とおり"],["に"],["した"],["。"]]},{"verse":5,"text":"民の逃げたことがエジプトの王に告げられると、パロとその家臣たちは民についての考えを変えて言った。「われわれはいったい何ということをしたのだ。イスラエルを去らせてしまい、われわれに仕えさせないとは。」","tok":[["民","みん"],["の"],["逃げた","にげた"],["こと"],["が"],["エジプト"],["の"],["王","おう"],["に"],["告げられる","つげられる"],["と"],["、"],["パロ"],["と"],["その"],["家臣","かしん"],["たち"],["は"],["民","みん"],["について"],["の"],["考え","かんがえ"],["を"],["変えて","かえて"],["言った","いった"],["。"],["「"],["われわれ"],["は"],["いったい"],["何","なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["だ"],["。"],["イスラエル"],["を"],["去らせて","さらせて"],["しまい"],["、"],["われわれ"],["に"],["仕えさせない","つかえさせない"],["と"],["は"],["。"],["」"]]},{"verse":6,"text":"そこでパロは戦車を整え、自分でその軍勢を率い、","tok":[["そこ"],["で"],["パロ"],["は"],["戦車","せんしゃ"],["を"],["整え","ととのえ"],["、"],["自分","じぶん"],["で"],["その"],["軍勢","ぐんぜい"],["を"],["率い","ひきい"],["、"]]},{"verse":7,"text":"えり抜きの戦車六百とエジプトの全戦車を、それぞれ補佐官をつけて率いた。","tok":[["えり抜き","えりぬき"],["の"],["戦車","せんしゃ"],["六百","ろくひゃく"],["と"],["エジプト"],["の"],["全","ぜん"],["戦車","せんしゃ"],["を"],["、"],["それぞれ"],["補佐官","ほさかん"],["を"],["つけて"],["率いた","ひきいた"],["。"]]},{"verse":8,"text":"主がエジプトの王パロの心をかたくなにされたので、パロはイスラエル人を追跡した。しかしイスラエル人は臆することなく出て行った。","tok":[["主","ぬし"],["が"],["エジプト"],["の"],["王","おう"],["パロ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["された"],["ので"],["、"],["パロ"],["は"],["イスラエル"],["人","にん"],["を"],["追跡","ついせき"],["した"],["。"],["しかし"],["イスラエル"],["人","にん"],["は"],["臆する","おくする"],["こと"],["なく"],["出て","でて"],["行った","いった"],["。"]]},{"verse":9,"text":"それでエジプトは彼らを追跡した。パロの戦車の馬も、騎兵も、軍勢も、ことごとく、バアル・ツェフォンの手前、ピ・ハヒロテで、海辺に宿営している彼らに追いついた。","tok":[["それ"],["で"],["エジプト"],["は"],["彼","かれ"],["ら"],["を"],["追跡","ついせき"],["した"],["。"],["パロ"],["の"],["戦車","せんしゃ"],["の"],["馬","うま"],["も"],["、"],["騎兵","きへい"],["も"],["、"],["軍勢","ぐんぜい"],["も"],["、"],["ことごとく"],["、"],["バアル"],["・"],["ツェフォン"],["の"],["手前","てまえ"],["、"],["ピ"],["・"],["ハヒロテ"],["で"],["、"],["海辺","うみべ"],["に"],["宿営","しゅくえい"],["して"],["いる"],["彼","かれ"],["ら"],["に"],["追いついた","おいついた"],["。"]]},{"verse":10,"text":"パロは近づいていた。それで、イスラエル人が目を上げて見ると、なんと、エジプト人が彼らのあとに迫っているではないか。イスラエル人は非常に恐れて、主に向かって叫んだ。","tok":[["パロ"],["は"],["近づいて","ちかづいて"],["いた"],["。"],["それ"],["で"],["、"],["イスラエル"],["人","にん"],["が"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["エジプト"],["人","にん"],["が"],["彼","かれ"],["ら"],["の"],["あと"],["に"],["迫って","せまって"],["いるで"],["は"],["ない"],["か"],["。"],["イスラエル"],["人","にん"],["は"],["非常","ひじょう"],["に"],["恐れて","おそれて"],["、"],["主に","おもに"],["向かって","むかって"],["叫んだ","さけんだ"],["。"]]},{"verse":11,"text":"そしてモーセに言った。「エジプトには墓がないので、あなたは私たちを連れて来て、この荒野で、死なせるのですか。私たちをエジプトから連れ出したりして、いったい何ということを私たちにしてくれたのです。","tok":[["そして"],["モーセ"],["に"],["言った","いった"],["。"],["「"],["エジプト"],["に"],["は"],["墓","はか"],["が"],["ない"],["ので"],["、"],["あなた"],["は"],["私たち","わたしたち"],["を"],["連れて","つれて"],["来て","きて"],["、"],["この"],["荒野","あらの"],["で"],["、"],["死なせる","しなせる"],["の"],["です"],["か"],["。"],["私たち","わたしたち"],["を"],["エジプト"],["から"],["連れ出し","つれだし"],["たり"],["して"],["、"],["いったい"],["何","なん"],["と"],["いう"],["こと"],["を"],["私たち","わたしたち"],["に"],["して"],["くれた"],["の"],["です"],["。"]]},{"verse":12,"text":"私たちがエジプトであなたに言ったことは、こうではありませんでしたか。『私たちのことはかまわないで、私たちをエジプトに仕えさせてください。』事実、エジプトに仕えるほうがこの荒野で死ぬよりも私たちには良かったのです。」","tok":[["私たち","わたしたち"],["が"],["エジプト"],["で"],["あなた"],["に"],["言った","いった"],["こと"],["は"],["、"],["こう"],["で"],["は"],["ありませんでした"],["か"],["。"],["『"],["私たち","わたしたち"],["の"],["こと"],["は"],["かまわないで"],["、"],["私たち","わたしたち"],["を"],["エジプト"],["に"],["仕えさせて","つかえさせて"],["ください"],["。"],["』"],["事実","じじつ"],["、"],["エジプト"],["に"],["仕える","つかえる"],["ほう"],["が"],["この"],["荒野","こうや"],["で"],["死ぬ","しぬ"],["より"],["も"],["私たち","わたしたち"],["に"],["は"],["良かった","よかった"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"それでモーセは民に言った。「恐れてはいけない。しっかり立って、きょう、あなたがたのために行われる主の救いを見なさい。あなたがたは、きょう見るエジプト人をもはや永久に見ることはできない。","tok":[["それ"],["で"],["モーセ"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["恐れて","おそれて"],["は"],["いけない"],["。"],["しっかり"],["立って","たって"],["、"],["きょう"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["行われる","おこなわれる"],["主","ぬし"],["の"],["救い","すくい"],["を"],["見","み"],["なさい"],["。"],["あなた"],["がた"],["は"],["、"],["きょう"],["見る","みる"],["エジプト"],["人","にん"],["を"],["もはや"],["永久","えいきゅう"],["に"],["見る","みる"],["こと"],["は"],["できない"],["。"]]},{"verse":14,"text":"主があなたがたのために戦われる。あなたがたは黙っていなければならない。」","tok":[["主","ぬし"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["戦われる","たたかわれる"],["。"],["あなた"],["がた"],["は"],["黙って","だまって"],["いなければ"],["ならない"],["。"],["」"]]},{"verse":15,"text":"主はモーセに仰せられた。「なぜあなたはわたしに向かって叫ぶのか。イスラエル人に前進するように言え。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["なぜ"],["あなた"],["は"],["わたし"],["に"],["向かって","むかって"],["叫ぶ","さけぶ"],["の"],["か"],["。"],["イスラエル"],["人","にん"],["に"],["前進","ぜんしん"],["する"],["よう"],["に"],["言え
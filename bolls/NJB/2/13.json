[{"verse":1,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人の間で、最初に生まれる初子はすべて、人であれ家畜であれ、わたしのために聖別せよ。それはわたしのものである。」","tok":[["「"],["イスラエル"],["人","にん"],["の"],["間","あいだ"],["で"],["、"],["最初","さいしょ"],["に"],["生まれる","うまれる"],["初子","ういご"],["は"],["すべて"],["、"],["人","ひと"],["で"],["あれ"],["家畜","かちく"],["で"],["あれ"],["、"],["わたし"],["の"],["ため"],["に"],["聖別","せいべつ"],["せよ"],["。"],["それ"],["は"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["」"]]},{"verse":3,"text":"モーセは民に言った。「奴隷の家であるエジプトから出て来たこの日を覚えていなさい。主が力強い御手で、あなたがたをそこから連れ出されたからである。種を入れたパンを食べてはならない。","tok":[["モーセ"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["奴隷","どれい"],["の"],["家","いえ"],["で"],["ある"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["この"],["日","ひ"],["を"],["覚えて","おぼえて"],["い"],["なさい"],["。"],["主","ぬし"],["が"],["力強い","ちからづよい"],["御手","おて"],["で"],["、"],["あなた"],["がた"],["を"],["そこ"],["から"],["連れ出された","つれだされた"],["から"],["で"],["ある"],["。"],["種","しゅ"],["を"],["入れた","いれた"],["パン"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":4,"text":"アビブの月のこの日にあなたがたは出発する。","tok":[["アビブ"],["の"],["月","つき"],["の"],["この"],["日","ひ"],["に"],["あなた"],["がた"],["は"],["出発","しゅっぱつ"],["する"],["。"]]},{"verse":5,"text":"主があなたに与えるとあなたの先祖たちに誓われたカナン人、ヘテ人、エモリ人、ヒビ人、エブス人の地、乳と蜜の流れる地に、あなたを連れて行かれるとき、次の儀式をこの月に守りなさい。","tok":[["主","ぬし"],["が"],["あなた"],["に"],["与える","あたえる"],["と"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["カナン人","かなんにん"],["、"],["ヘテ人","へてにん"],["、"],["エモリ人","えもりにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["地","ち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["に"],["、"],["あなた"],["を"],["連れて","つれて"],["行かれる","いかれる"],["とき"],["、"],["次","つぎ"],["の"],["儀式","ぎしき"],["を"],["この"],["月","つき"],["に"],["守り","まもり"],["なさい"],["。"]]},{"verse":6,"text":"七日間、あなたは種を入れないパンを食べなければならない。七日目は主への祭りである。","tok":[["七","なな"],["日間","かかん"],["、"],["あなた"],["は"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["七日目","ななかめ"],["は"],["主","ぬし"],["へ"],["の"],["祭り","まつり"],["で"],["ある"],["。"]]},{"verse":7,"text":"種を入れないパンを七日間、食べなければならない。あなたのところに種を入れたパンがあってはならない。あなたの領土のどこにおいても、あなたのところにパン種があってはならない。","tok":[["種","しゅ"],["を"],["入れない","いれない"],["パン"],["を"],["七","なな"],["日間","かかん"],["、"],["食べなければ","たべなければ"],["ならない"],["。"],["あなた"],["の"],["ところ"],["に"],["種","しゅ"],["を"],["入れた","いれた"],["パン"],["が"],["あって"],["は"],["ならない"],["。"],["あなた"],["の"],["領土","りょうど"],["の"],["どこ"],["に"],["おいて"],["も"],["、"],["あなた"],["の"],["ところ"],["に"],["パン種","ぱんだね"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":8,"text":"その日、あなたは息子に説明して、『これは、私がエジプトから出て来たとき、主が私にしてくださったことのためなのだ』と言いなさい。","tok":[["その"],["日","ひ"],["、"],["あなた"],["は"],["息子","むすこ"],["に"],["説明","せつめい"],["して"],["、"],["『"],["これ"],["は"],["、"],["私","わたくし"],["が"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["とき"],["、"],["主","ぬし"],["が"],["私","わたくし"],["に"],["して"],["くださった"],["こと"],["の"],["ため"],["な"],["の"],["だ"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":9,"text":"これをあなたの手の上のしるしとし、またあなたの額の上の記念としなさい。それは主のおしえがあなたの口にあるためであり、主が力強い御手で、あなたをエジプトから連れ出されたからである。","tok":[["これ"],["を"],["あなた"],["の"],["手","て"],["の"],["上","うえ"],["の"],["しるし"],["と"],["し"],["、"],["また"],["あなた"],["の"],["額","がく"],["の"],["上","うえ"],["の"],["記念","きねん"],["と"],["し"],["なさい"],["。"],["それ"],["は"],["主","ぬし"],["の"],["おしえ"],["が"],["あなた"],["の"],["口","くち"],["に"],["ある"],["ため"],["で"],["あり"],["、"],["主","ぬし"],["が"],["力強い","ちからづよい"],["御手","おて"],["で"],["、"],["あなた"],["を"],["エジプト"],["から"],["連れ出された","つれだされた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたはこのおきてを年々その定められた時に守りなさい。","tok":[["あなた"],["は"],["この"],["おきて"],["を"],["年々","ねんねん"],["その"],["定められた","さだめられた"],["時","とき"],["に"],["守り","まもり"],["なさい"],["。"]]},{"verse":11,"text":"主が、あなたとあなたの先祖たちに誓われたとおりに、あなたをカナン人の地に導き、そこをあなたに賜るとき、","tok":[["主","ぬし"],["が"],["、"],["あなた"],["と"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["とおり"],["に"],["、"],["あなた"],["を"],["カナン人","かなんにん"],["の"],["地","ち"],["に"],["導き","みちびき"],["、"],["そこ"],["を"],["あなた"],["に"],["賜る","たまわる"],["とき"],["、"]]},{"verse":12,"text":"すべて最初に生まれる者を、主のものとしてささげなさい。あなたの家畜から生まれる初子もみな、雄は主のものである。","tok":[["すべて"],["最初","さいしょ"],["に"],["生まれる","うまれる"],["者","もの"],["を"],["、"],["主","ぬし"],["の"],["もの"],["として"],["ささげ"],["なさい"],["。"],["あなた"],["の"],["家畜","かちく"],["から"],["生まれる","うまれる"],["初子","ういご"],["も"],["みな"],["、"],["雄","おす"],["は"],["主","ぬし"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":13,"text":"ただし、ろばの初子はみな、羊で贖わなければならない。もし贖わないなら、その首を折らなければならない。あなたの子どもたちのうち、男の初子はみな、贖わなければならない。","tok":[["ただし"],["、"],["ろば"],["の"],["初子","ういご"],["は"],["みな"],["、"],["羊","ひつじ"],["で"],["贖わなければ","あがなわなければ"],["ならない"],["。"],["もし"],["贖わないなら","あがなわないなら"],["、"],["その"],["首","くび"],["を"],["折らなければ","おらなければ"],["ならない"],["。"],["あなた"],["の"],["子ども","こども"],["たち"],["の"],["うち"],["、"],["男","おとこ"],["の"],["初子","ういご"],["は"],["みな"],["、"],["贖わなければ","あがなわなければ"],["ならない"],["。"]]},{"verse":14,"text":"後になってあなたの子があなたに尋ねて、『これは、どういうことですか』と言うときは、彼に言いなさい。『主は力強い御手によって、私たちを奴隷の家、エジプトから連れ出された。","tok":[["後","あと"],["に"],["なって"],["あなた"],["の"],["子","こ"],["が"],["あなた"],["に"],["尋ねて","たずねて"],["、"],["『"],["これ"],["は"],["、"],["どういう"],["こと"],["です"],["か"],["』"],["と"],["言う","いう"],["とき"],["は"],["、"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["。"],["『"],["主","ぬし"],["は"],["力強い","ちからづよい"],["御手","おて"],["によって"],["、"],["私たち","わたしたち"],["を"],["奴隷","どれい"],["の"],["家","いえ"],["、"],["エジプト"],["から"],["連れ出された","つれだされた"],["。"]]},{"verse":15,"text":"パロが私たちを、なかなか行かせなかったとき、主はエジプトの地の初子を、人の初子をはじめ家畜の初子に至るまで、みな殺された。それで、私は初めに生まれる雄をみな、いけにえとして、主にささげ、私の子どもたちの初子をみな、私は贖うのだ。』","tok":[["パロ"],["が"],["私たち","わたしたち"],["を"],["、"],["なかなか"],["行かせなかった","いかせなかった"],["とき"],["、"],["主","ぬし"],["は"],["エジプト"],["の"],["地","ち"],["の"],["初子","ういご"],["を"],["、"],["人","ひと"],["の"],["初子","ういご"],["を"],["はじめ"],["家畜","かちく"],["の"],["初子","ういご"],["に"],["至る","いたる"],["まで"],["、"],["みな"],["殺された","ころされた"],["。"],["それ"],["で"],["、"],["私","わたくし"],["は"],["初め","はじめ"],["に"],["生まれる","うまれる"],["雄","おす"],["を"],["みな"],["、"],["いけにえ"],["として"],["、"],["主に","おもに"],["ささげ"],["、"],["私","わたくし"],["の"],["子ども","こども"],["たち"],["の"],["初子","ういご"],["を"],["みな"],["、"],["私","わたくし"],["は"],["贖う","あがなう"],["の"],["だ"],["。"],["』"]]},{"verse":16,"text":"これを手の上のしるしとし、また、あなたの額の上の記章としなさい。それは主が力強い御手によって、私たちをエジプトから連れ出されたからである。」","tok":[["これ"],["を"],["手","て"],["の"],["上","うえ"],["の"],["しるし"],["と"],["し"],["、"],["また"],["、"],["あなた"],["の"],["額","がく"],["の"],["上","うえ"],["の"],["記章","きしょう"],["と"],["し"],["なさい"],["。"],["それ"],["は"],["主","ぬし"],["が"],["力強い","ちからづよい"],["御手","おて"],["によって"],["、"],["私たち","わたしたち"],["を"],["エジプト"],["から"],["連れ出された","つれだされた"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":17,"text":"さて、パロがこの民を行かせたとき、神は、彼らを近道であるペリシテ人の国の道には導かれなかった。神はこう言われた。「民が戦いを見て、心が変わり、エジプトに引き返すといけない。」","tok":[["さて"],["、"],["パロ"],["が"],["この"],["民","たみ"],["を"],["行かせた","いかせた"],["とき"],["、"],["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["を"],["近道","ちかみち"],["で"],["ある"],["ペリシテ"],["人","にん"],["の"],["国","くに"],["の"],["道","みち"],["に"],["は"],["導かれなかった","みちびかれなかった"],["。"],["神","かみ"],["は"],["こう"],["言われた","いわれた"],["。"],["「"],["民","みん"],["が"],["戦い","たたかい"],["を"],["見て","みて"],["、"],["心","こころ"],["が"],["変わり","かわり"],["、"],["エジプト"],["に"],["引き返す","ひきかえす"],["と"],["いけない"],["。"],["」"]]},{"verse":18,"text":"それで神はこの民を葦の海に沿う荒野の道に回らせた。イスラエル人は編隊を組み、エジプトの国から離れた。","tok":[["それ"],["で"],["神","かみ"],["は"],["この"],["民","たみ"],["を"],["葦","あし"],["の"],["海","うみ"],["に"],["沿う","そう"],["荒野","あらの"],["の"],["道","みち"],["に"],["回らせた","まわらせた"],["。"],["イスラエル"],["人","にん"],["は"],["編隊","へんたい"],["を"],["組み","くみ"],["、"],["エジプト"],["の"],["国","くに"],["から"],["離れた","はなれた"],["。"]]},{"verse":19,"text":"モーセはヨセフの遺骸を携えて来た。それはヨセフが、「神は必ずあなたがたを顧みてくださる。そのとき、あなたがたは私の遺骸をここから携え上らなければならない」と言って、イスラエルの子らに堅く誓わせたからである。","tok":[["モーセ"],["は"],["ヨセフ"],["の"],["遺骸","いがい"],["を"],["携えて","たずさえて"],["来た","きた"],["。"],["それ"],["は"],["ヨセフ"],["が"],["、"],["「"],["神","かみ"],["は"],["必ず","かならず"],["あなた"],["がた"],["を"],["顧みて","かえりみて"],["くださる"],["。"],["その"],["とき"],["、"],["あなた"],["がた"],["は"],["私","わたくし"],["の"],["遺骸","いがい"],["を"],["ここ"],["から"],["携え","たずさえ"],["上らなければ","のぼらなければ"],["ならない"],["」"],["と"],["言って","いって"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["に"],["堅く","かたく"],["誓わせた","ちかわせた"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"こうして彼らはスコテから出て行き、荒野の端にあるエタムに宿営した。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["スコテ"],["から"],["出て","でて"],["行き","いき"],["、"],["荒野","こうや"],["の"],["端","はし"],["に"],["ある"],["エタム"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":21,"text":"主は、昼は、途上の彼らを導くため、雲の柱の中に、夜は、彼らを照らすため、火の柱の中にいて、彼らの前を進まれた。彼らが昼も夜も進んで行くためであった。","tok":[["主","ぬし"],["は"],["、"],["昼","ひる"],["は"],["、"],["途上","とじょう"],["の"],["彼","かれ"],["ら"],["を"],["導く","みちびく"],["ため"],["、"],["雲","くも"],["の"],["柱","はしら"],["の"],["中","なか"],["に"],["、"],["夜","よる"],["は"],["、"],["彼","かれ"],["ら"],["を"],["照らす","てらす"],["ため"],["、"],["火","ひ"],["の"],["柱","はしら"],["の"],["中","なか"],["に"],["いて"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["を"],["進まれた","すすまれた"],["。"],["彼","かれ"],["ら"],["が"],["昼","ひる"],["も"],["夜","よる"],["も"],["進んで","すすんで"],["行く","いく"],["ため"],["で"],["あった"],["。"]]},{"verse":22,"text":"昼はこの雲の柱、夜はこの火の柱が民の前から離れなかった。","tok":[["昼","ひる"],["は"],["この"],["雲","くも"],["の"],["柱","はしら"],["、"],["夜","よる"],["は"],["この"],["火","ひ"],["の"],["柱","はしら"],["が"],["民","たみ"],["の"],["前","まえ"],["から"],["離れなかった","はなれなかった"],["。"]]}]
[{"verse":1,"text":"モーセは答えて申し上げた。「ですが、彼らは私を信ぜず、また私の声に耳を傾けないでしょう。『主はあなたに現れなかった』と言うでしょうから。」","tok":[["モーセ"],["は"],["答えて","こたえて"],["申し上げた","もうしあげた"],["。"],["「"],["です"],["が"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["を"],["信ぜず","しんぜず"],["、"],["また"],["私","わたくし"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けないでしょう","かたむけないでしょう"],["。"],["『"],["主","ぬし"],["は"],["あなた"],["に"],["現れなかった","あらわれなかった"],["』"],["と"],["言うでしょう","ゆうでしょう"],["から"],["。"],["」"]]},{"verse":2,"text":"主は彼に仰せられた。「あなたの手にあるそれは何か。」彼は答えた。「杖です。」","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["手","て"],["に"],["ある"],["それ"],["は"],["何","なん"],["か"],["。"],["」"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["杖","つえ"],["です"],["。"],["」"]]},{"verse":3,"text":"すると仰せられた。「それを地に投げよ。」彼がそれを地に投げると、杖は蛇になった。モーセはそれから身を引いた。","tok":[["する"],["と"],["仰せられた","おおせられた"],["。"],["「"],["それ"],["を"],["地","ち"],["に"],["投げ","なげ"],["よ"],["。"],["」"],["彼","かれ"],["が"],["それ"],["を"],["地","ち"],["に"],["投げる","なげる"],["と"],["、"],["杖","つえ"],["は"],["蛇","へび"],["に"],["なった"],["。"],["モーセ"],["は"],["それ"],["から"],["身","み"],["を"],["引いた","ひいた"],["。"]]},{"verse":4,"text":"主はまた、モーセに仰せられた。「手を伸ばして、その尾をつかめ。」彼が手を伸ばしてそれを握ったとき、それは手の中で杖になった。","tok":[["主","ぬし"],["は"],["また"],["、"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["手","て"],["を"],["伸ばして","のばして"],["、"],["その"],["尾","お"],["を"],["つかめ"],["。"],["」"],["彼","かれ"],["が"],["手","て"],["を"],["伸ばして","のばして"],["それ"],["を"],["握った","にぎった"],["とき"],["、"],["それ"],["は"],["手","て"],["の"],["中","なか"],["で"],["杖","つえ"],["に"],["なった"],["。"]]},{"verse":5,"text":"「これは、彼らの父祖の神、アブラハムの神、イサクの神、ヤコブの神、主があなたに現れたことを、彼らが信じるためである。」","tok":[["「"],["これ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["現れた","あらわれた"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["が"],["信じる","しんじる"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":6,"text":"主はなおまた、彼に仰せられた。「手をふところに入れよ。」彼は手をふところに入れた。そして、出した。なんと、彼の手はツァラアトに冒され、雪のようになっていた。","tok":[["主","ぬし"],["は"],["なお"],["また"],["、"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["手","て"],["を"],["ふところ"],["に"],["入れよ","いれよ"],["。"],["」"],["彼","かれ"],["は"],["手","て"],["を"],["ふところ"],["に"],["入れた","いれた"],["。"],["そして"],["、"],["出した","だした"],["。"],["なん"],["と"],["、"],["彼","かれ"],["の"],["手","て"],["は"],["ツァラアト"],["に"],["冒され","おかされ"],["、"],["雪","ゆき"],["の"],["よう"],["に"],["なって"],["いた"],["。"]]},{"verse":7,"text":"また、主は仰せられた。「あなたの手をもう一度ふところに入れよ。」そこで彼はもう一度手をふところに入れた。そして、ふところから出した。なんと、それは再び彼の肉のようになっていた。","tok":[["また"],["、"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["手","て"],["を"],["もう"],["一度","いちど"],["ふところ"],["に"],["入れよ","いれよ"],["。"],["」"],["そこ"],["で"],["彼","かれ"],["は"],["もう"],["一度","いちど"],["手","て"],["を"],["ふところ"],["に"],["入れた","いれた"],["。"],["そして"],["、"],["ふところ"],["から"],["出した","だした"],["。"],["なん"],["と"],["、"],["それ"],["は"],["再び","ふたたび"],["彼","かれ"],["の"],["肉","にく"],["の"],["よう"],["に"],["なって"],["いた"],["。"]]},{"verse":8,"text":"「たとい彼らがあなたを信ぜず、また初めのしるしの声に聞き従わなくても、後のしるしの声は信じるであろう。","tok":[["「"],["たとい"],["彼","かれ"],["ら"],["が"],["あなた"],["を"],["信ぜず","しんぜず"],["、"],["また"],["初め","はじめ"],["の"],["しるし"],["の"],["声","こえ"],["に"],["聞き従わなくて","ききしたがわなくて"],["も"],["、"],["後","あと"],["の"],["しるし"],["の"],["声","こえ"],["は"],["信じるで","しんじるで"],["あろう"],["。"]]},{"verse":9,"text":"もしも彼らがこの二つのしるしをも信ぜず、あなたの声にも聞き従わないなら、ナイルから水を汲んで、それをかわいた土に注がなければならない。あなたがナイルから汲んだその水は、かわいた土の上で血となる。」","tok":[["もし"],["も"],["彼","かれ"],["ら"],["が"],["この"],["二","ふた"],["つ"],["の"],["しるし"],["を"],["も"],["信ぜず","しんぜず"],["、"],["あなた"],["の"],["声","こえ"],["に"],["も"],["聞き従わないなら","ききしたがわないなら"],["、"],["ナイル"],["から"],["水","みず"],["を"],["汲んで","くんで"],["、"],["それ"],["を"],["かわいた"],["土","つち"],["に"],["注がなければ","そそがなければ"],["ならない"],["。"],["あなた"],["が"],["ナイル"],["から"],["汲んだ","くんだ"],["その"],["水","みず"],["は"],["、"],["かわいた"],["土","つち"],["の"],["上","うえ"],["で"],["血","ち"],["と"],["なる"],["。"],["」"]]},{"verse":10,"text":"モーセは主に申し上げた。「ああ主よ。私はことばの人ではありません。以前からそうでしたし、あなたがしもべに語られてからもそうです。私は口が重く、舌が重いのです。」","tok":[["モーセ"],["は"],["主に","おもに"],["申し上げた","もうしあげた"],["。"],["「"],["ああ"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["ことば"],["の"],["人","ひと"],["で"],["は"],["ありません"],["。"],["以前","いぜん"],["から"],["そう"],["でした"],["し"],["、"],["あなた"],["が"],["しもべ"],["に"],["語られて","かたられて"],["から"],["も"],["そう"],["です"],["。"],["私","わたくし"],["は"],["口","くち"],["が"],["重く","おもく"],["、"],["舌","した"],["が"],["重い","おもい"],["の"],["です"],["。"],["」"]]},{"verse":11,"text":"主は彼に仰せられた。「だれが人に口をつけたのか。だれが口をきけなくし、耳を聞こえなくし、あるいは、目を開いたり、盲目にしたりするのか。それはこのわたし、主ではないか。","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["だれ"],["が"],["人","ひと"],["に"],["口","くち"],["を"],["つけた"],["の"],["か"],["。"],["だれ"],["が"],["口","くち"],["を"],["きけなく"],["し"],["、"],["耳","みみ"],["を"],["聞こえなく","きこえなく"],["し"],["、"],["あるいは"],["、"],["目","め"],["を"],["開い","ひらい"],["たり"],["、"],["盲目","もうもく"],["に"],["し"],["たり"],["する"],["の"],["か"],["。"],["それ"],["は"],["この"],["わたし"],["、"],["主","ぬし"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":12,"text":"さあ行け。わたしがあなたの口とともにあって、あなたの言うべきことを教えよう。」","tok":[["さあ"],["行け","いけ"],["。"],["わたし"],["が"],["あなた"],["の"],["口","くち"],["と"],["とも"],["に"],["あって"],["、"],["あなた"],["の"],["言うべき","ゆうべき"],["こと"],["を"],["教えよう","おしえよう"],["。"],["」"]]},{"verse":13,"text":"すると申し上げた。「ああ主よ。どうかほかの人を遣わしてください。」","tok":[["する"],["と"],["申し上げた","もうしあげた"],["。"],["「"],["ああ"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["ほか"],["の"],["人","ひと"],["を"],["遣わして","つかわして"],["ください"],["。"],["」"]]},{"verse":14,"text":"すると、主の怒りがモーセに向かって燃え上がり、こう仰せられた。「あなたの兄、レビ人アロンがいるではないか。わたしは彼がよく話すことを知っている。今、彼はあなたに会いに出て来ている。あなたに会えば、心から喜ぼう。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["が"],["モーセ"],["に"],["向かって","むかって"],["燃え上がり","もえあがり"],["、"],["こう"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["兄","あに"],["、"],["レビ人","れびにん"],["アロン"],["が"],["いるで"],["は"],["ない"],["か"],["。"],["わたし"],["は"],["彼","かれ"],["が"],["よく"],["話す","はなす"],["こと"],["を"],["知って","しって"],["いる"],["。"],["今","いま"],["、"],["彼","かれ"],["は"],["あなた"],["に"],["会い","あい"],["に"],["出て","でて"],["来て","きて"],["いる"],["。"],["あなた"],["に"],["会えば","あえば"],["、"],["心","こころ"],["から"],["喜ぼう","よろこぼう"],["。"]]},{"verse":15,"text":"あなたが彼に語り、その口にことばを置くなら、わたしはあなたの口とともにあり、彼の口とともにあって、あなたがたのなすべきことを教えよう。","tok":[["あなた"],["が"],["彼","かれ"],["に"],["語り","かたり"],["、"],["その"],["口","くち"],["に"],["ことば"],["を"],["置くなら","おくなら"],["、"],["わたし"],["は"],["あなた"],["の"],["口","くち"],["と"],["とも"],["に"],["あり"],["、"],["彼","かれ"],["の"],["口","くち"],["と"],["とも"],["に"],["あって"],["、"],["あなた"],["がた"],["の"],["なすべき"],["こと"],["を"],["教えよう","おしえよう"],["。"]]},{"verse":16,"text":"彼があなたに代わって民に語るなら、彼はあなたの口の代わりとなり、あなたは彼に対して神の代わりとなる。","tok":[["彼","かれ"],["が"],["あなた"],["に"],["代わって","かわって"],["民","みん"],["に"],["語るなら","かたるなら"],["、"],["彼","かれ"],["は"],["あなた"],["の"],["口","くち"],["の"],["代わり","かわり"],["と"],["なり"],["、"],["あなた"],["は"],["彼","かれ"],["に対して","にたいして"],["神","かみ"],["の"],["代わり","かわり"],["と"],["なる"],["。"]]},{"verse":17,"text":"あなたはこの杖を手に取り、これでしるしを行わなければならない。」","tok":[["あなた"],["は"],["この"],["杖","つえ"],["を"],["手","て"],["に"],["取り","とり"],["、"],["これ"],["で"],["しるし"],["を"],["行わなければ","おこなわなければ"],["ならない"],["。"],["」"]]},{"verse":18,"text":"それで、モーセはしゅうとのイテロのもとに帰り、彼に言った。「どうか私をエジプトにいる親類のもとに帰らせ、彼らがまだ生きながらえているかどうか見させてください。」イテロはモーセに「安心して行きなさい」と答えた。","tok":[["それ"],["で"],["、"],["モーセ"],["は"],["しゅうと"],["の"],["イテロ"],["の"],["もと"],["に"],["帰り","かえり"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["私","わたくし"],["を"],["エジプト"],["に"],["いる"],["親類","しんるい"],["の"],["もと"],["に"],["帰らせ","かえらせ"],["、"],["彼","かれ"],["ら"],["が"],["まだ"],["生きながらえて","いきながらえて"],["いる"],["か"],["どう"],["か"],["見させて","みさせて"],["ください"],["。"],["」"],["イテロ"],["は"],["モーセ"],["に"],["「"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":19,"text":"主はミデヤンでモーセに仰せられた。「エジプトに帰って行け。あなたのいのちを求めていた者は、みな死んだ。」","tok":[["主","ぬし"],["は"],["ミデヤン"],["で"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["エジプト"],["に"],["帰って","かえって"],["行け","いけ"],["。"],["あなた"],["の"],["いのち"],["を"],["求めて","もとめて"],["いた"],["者","もの"],["は"],["、"],["みな"],["死んだ","しんだ"],["。"],["」"]]},{"verse":20,"text":"そこで、モーセは妻や息子たちを連れ、彼らをろばに乗せてエジプトの地へ帰った。モーセは手に神の杖を持っていた。","tok":[["そこ"],["で"],["、"],["モーセ"],["は"],["妻","つま"],["や"],["息子","むすこ"],["たち"],["を"],["連れ","つれ"],["、"],["彼","かれ"],["ら"],["を"],["ろば"],["に"],["乗せて","のせて"],["エジプト"],["の"],["地","ち"],["へ"],["帰った","かえった"],["。"],["モーセ"],["は"],["手","て"],["に"],["神","かみ"],["の"],["杖","つえ"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":21,"text":"主はモーセに仰せられた。「エジプトに帰って行ったら、わたしがあなたの手に授けた不思議を、ことごとく心に留め、それをパロの前で行え。しかし、わたしは彼の心をかたくなにする。彼は民を去らせないであろう。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["エジプト"],["に"],["帰って","かえって"],["行ったら","いったら"],["、"],["わたし"],["が"],["あなた"],["の"],["手","て"],["に"],["授けた","さずけた"],["不思議","ふしぎ"],["を"],["、"],["ことごとく"],["心","こころ"],["に"],["留め","とめ"],["、"],["それ"],["を"],["パロ"],["の"],["前","まえ"],["で"],["行え","おこなえ"],["。"],["しかし"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["。"],["彼","かれ"],["は"],["民","みん"],["を"],["去らせないで","さらせないで"],["あろう"],["。"]]},{"verse":22,"text":"そのとき、あなたはパロに言わなければならない。／主はこう仰せられる。『イスラエルはわたしの子、わたしの初子である。","tok":[["その"],["とき"],["、"],["あなた"],["は"],["パロ"],["に"],["言わなければ","いわなければ"],["ならない"],["。"],["／"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["イスラエル"],["は"],["わたし"],["の"],["子","こ"],["、"],["わたし"],["の"],["初子","ういご"],["で"],["ある"],["。"]]},{"verse":23,"text":"そこでわたしはあなたに言う。わたしの子を行かせて、わたしに仕えさせよ。もし、あなたが拒んで彼を行かせないなら、見よ、わたしはあなたの子、あなたの初子を殺す。』」","tok":[["そこ"],["で"],["わたし"],["は"],["あなた"],["に"],["言う","ゆう"],["。"],["わたし"],["の"],["子","こ"],["を"],["行かせて","いかせて"],["、"],["わたし"],["に"],["仕えさせ","つかえさせ"],["よ"],["。"],["もし"],["、"],["あなた"],["が"],["拒んで","こばんで"],["彼","かれ"],["を"],["行かせないなら","いかせないなら"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["子","こ"],["、"],["あなた"],["の"],["初子","ういご"],["を"],["殺す","ころす"],["。"],["』"],["」"]]},{"verse":24,"text":"さて、途中、一夜を明かす場所でのことだった。主はモーセに会われ、彼を殺そうとされた。","tok":[["さて"],["、"],["途中","とちゅう"],["、"],["一夜","いちや"],["を"],["明かす","あかす"],["場所","ばしょ"],["で"],["の"],["こと"],["だった"],["。"],["主","ぬし"],["は"],["モーセ"],["に"],["会われ","あわれ"],["、"],["彼","かれ"],["を"],["殺そう","ころそう"],["と"],["された"],["。"]]},{"verse":25,"text":"そのとき、チッポラは火打石を取って、自分の息子の包皮を切り、それをモーセの両足につけ、そして言った。
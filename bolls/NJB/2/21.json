。"]]},{"verse":35,"text":"ある人の牛が、もうひとりの人の牛を突いて、その牛が死んだ場合、両者は生きている牛を売って、その金を分け、また死んだ牛も分けなければならない。","tok":[["ある"],["人","ひと"],["の"],["牛","うし"],["が"],["、"],["もう"],["ひとり"],["の"],["人","ひと"],["の"],["牛","うし"],["を"],["突いて","ついて"],["、"],["その"],["牛","うし"],["が"],["死んだ","しんだ"],["場合","ばあい"],["、"],["両者","りょうしゃ"],["は"],["生きて","いきて"],["いる"],["牛","うし"],["を"],["売って","うって"],["、"],["その"],["金","きん"],["を"],["分け","わけ"],["、"],["また"],["死んだ","しんだ"],["牛","うし"],["も"],["分けなければ","わけなければ"],["ならない"],["。"]]},{"verse":36,"text":"しかし、その牛が以前から突くくせのあることがわかっていて、その持ち主が監視をしなかったのなら、その人は必ず牛は牛で償わなければならない。しかし、その死んだ牛は自分のものとなる。","tok":[["しかし"],["、"],["その"],["牛","うし"],["が"],["以前","いぜん"],["から"],["突く","つく"],["くせ"],["の"],["ある"],["こと"],["が"],["わかって"],["いて"],["、"],["その"],["持ち主","もちぬし"],["が"],["監視","かんし"],["を"],["しなかった"],["の"],["なら"],["、"],["その"],["人","ひと"],["は"],["必ず","かならず"],["牛","うし"],["は"],["牛","うし"],["で"],["償わなければ","つぐなわなければ"],["ならない"],["。"],["しかし"],["、"],["その"],["死んだ","しんだ"],["牛","うし"],["は"],["自分","じぶん"],["の"],["もの"],["と"],["なる"],["。"]]}]
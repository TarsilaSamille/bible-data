[{"verse":1,"text":"さて、モーセのしゅうと、ミデヤンの祭司イテロは、神がモーセと御民イスラエルのためになさったすべてのこと、すなわち、どのようにして主がイスラエルをエジプトから連れ出されたかを聞いた。","tok":[["さて"],["、"],["モーセ"],["の"],["しゅうと"],["、"],["ミデヤン"],["の"],["祭司","さいし"],["イテロ"],["は"],["、"],["神","かみ"],["が"],["モーセ"],["と"],["御民","ごみん"],["イスラエル"],["の"],["ため"],["に"],["なさった"],["すべて"],["の"],["こと"],["、"],["すなわち"],["、"],["どの"],["よう"],["に"],["して"],["主","ぬし"],["が"],["イスラエル"],["を"],["エジプト"],["から"],["連れ出された","つれだされた"],["か"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"それでモーセのしゅうとイテロは、先に送り返されていたモーセの妻チッポラと","tok":[["それ"],["で"],["モーセ"],["の"],["しゅうと"],["イテロ"],["は"],["、"],["先","さき"],["に"],["送り返されて","おくりかえされて"],["いた"],["モーセ"],["の"],["妻","つま"],["チッポラ"],["と"]]},{"verse":3,"text":"そのふたりの息子を連れて行った。そのひとりの名はゲルショムであった。それは「私は外国にいる寄留者だ」という意味である。","tok":[["その"],["ふたり"],["の"],["息子","むすこ"],["を"],["連れて","つれて"],["行った","いった"],["。"],["その"],["ひとり"],["の"],["名","な"],["は"],["ゲルショム"],["で"],["あった"],["。"],["それ"],["は"],["「"],["私","わたくし"],["は"],["外国","がいこく"],["に"],["いる"],["寄留者","きりゅうしゃ"],["だ"],["」"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["。"]]},{"verse":4,"text":"もうひとりの名はエリエゼル。それは「私の父の神は私の助けであり、パロの剣から私を救われた」という意味である。","tok":[["もう"],["ひとり"],["の"],["名","な"],["は"],["エリエゼル"],["。"],["それ"],["は"],["「"],["私","わたくし"],["の"],["父","ちち"],["の"],["神","かみ"],["は"],["私","わたくし"],["の"],["助け","たすけ"],["で"],["あり"],["、"],["パロ"],["の"],["剣","けん"],["から"],["私","わたくし"],["を"],["救われた","すくわれた"],["」"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["。"]]},{"verse":5,"text":"モーセのしゅうとイテロは、モーセの息子と妻といっしょに、荒野のモーセのところに行った。彼はそこの神の山に宿営していた。","tok":[["モーセ"],["の"],["しゅうと"],["イテロ"],["は"],["、"],["モーセ"],["の"],["息子","むすこ"],["と"],["妻","つま"],["と"],["いっしょ"],["に"],["、"],["荒野","こうや"],["の"],["モーセ"],["の"],["ところ"],["に"],["行った","いった"],["。"],["彼","かれ"],["は"],["そこ"],["の"],["神","かみ"],["の"],["山","やま"],["に"],["宿営","しゅくえい"],["して"],["いた"],["。"]]},{"verse":6,"text":"イテロはモーセに伝えた。「あなたのしゅうとである私イテロは、あなたの妻とそのふたりの息子といっしょに、あなたのところに来ています。」","tok":[["イテロ"],["は"],["モーセ"],["に"],["伝えた","つたえた"],["。"],["「"],["あなた"],["の"],["しゅうと"],["で"],["ある"],["私","わたくし"],["イテロ"],["は"],["、"],["あなた"],["の"],["妻","つま"],["と"],["その"],["ふたり"],["の"],["息子","むすこ"],["と"],["いっしょ"],["に"],["、"],["あなた"],["の"],["ところ"],["に"],["来て","きて"],["います"],["。"],["」"]]},{"verse":7,"text":"モーセは、しゅうとを迎えに出て行き、身をかがめ、彼に口づけした。彼らは互いに安否を問い、天幕に入った。","tok":[["モーセ"],["は"],["、"],["しゅうと"],["を"],["迎え","むかえ"],["に"],["出て","でて"],["行き","いき"],["、"],["身","み"],["を"],["かがめ"],["、"],["彼","かれ"],["に"],["口づけ","くちづけ"],["した"],["。"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["安否","あんぴ"],["を"],["問い","とい"],["、"],["天幕","てんまく"],["に"],["入った","はいった"],["。"]]},{"verse":8,"text":"モーセはしゅうとに、主がイスラエルのために、パロとエジプトとになさったすべてのこと、途中で彼らに降りかかったすべての困難、また主が彼らを救い出された次第を語った。","tok":[["モーセ"],["は"],["しゅうと"],["に"],["、"],["主","ぬし"],["が"],["イスラエル"],["の"],["ため"],["に"],["、"],["パロ"],["と"],["エジプト"],["と"],["に"],["なさった"],["すべて"],["の"],["こと"],["、"],["途中","とちゅう"],["で"],["彼","かれ"],["ら"],["に"],["降りかかった","ふりかかった"],["すべて"],["の"],["困難","こんなん"],["、"],["また"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["救い出された","すくいだされた"],["次第","しだい"],["を"],["語った","かたった"],["。"]]},{"verse":9,"text":"イテロは、主がイスラエルのためにしてくださったすべての良いこと、エジプトの手から救い出してくださったことを喜んだ。","tok":[["イテロ"],["は"],["、"],["主","ぬし"],["が"],["イスラエル"],["の"],["ため"],["に"],["して"],["くださった"],["すべて"],["の"],["良い","よい"],["こと"],["、"],["エジプト"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["くださった"],["こと"],["を"],["喜んだ","よろこんだ"],["。"]]},{"verse":10,"text":"イテロは言った。「主はほむべきかな。主はあなたがたをエジプトの手と、パロの手から救い出し、この民をエジプトの支配から救い出されました。","tok":[["イテロ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","ぬし"],["は"],["あなた"],["がた"],["を"],["エジプト"],["の"],["手","て"],["と"],["、"],["パロ"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"],["この"],["民","たみ"],["を"],["エジプト"],["の"],["支配","しはい"],["から"],["救い出されました","すくいだされました"],["。"]]},{"verse":11,"text":"今こそ私は主があらゆる神々にまさって偉大であることを知りました。実に彼らがこの民に対して不遜であったということにおいても。」","tok":[["今","いま"],["こそ"],["私","わたくし"],["は"],["主","ぬし"],["が"],["あらゆる"],["神々","かみがみ"],["に"],["まさって"],["偉大","いだい"],["で"],["ある"],["こと"],["を"],["知りました","しりました"],["。"],["実","じつ"],["に"],["彼","かれ"],["ら"],["が"],["この"],["民","たみ"],["に対して","にたいして"],["不遜","ふそん"],["で"],["あった"],["と"],["いう"],["こと"],["に"],["おいて"],["も"],["。"],["」"]]},{"verse":12,"text":"モーセのしゅうとイテロは、全焼のいけにえと神へのいけにえを持って来たので、アロンは、モーセのしゅうととともに神の前で食事をするために、イスラエルのすべての長老たちといっしょにやって来た。","tok":[["モーセ"],["の"],["しゅうと"],["イテロ"],["は"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["神","かみ"],["へ"],["の"],["いけにえ"],["を"],["持って","もって"],["来た","きた"],["ので"],["、"],["アロン"],["は"],["、"],["モーセ"],["の"],["しゅうと"],["と"],["とも"],["に"],["神","かみ"],["の"],["前","まえ"],["で"],["食事","しょくじ"],["を"],["する"],["ため"],["に"],["、"],["イスラエル"],["の"],["すべて"],["の"],["長老","ちょうろう"],["たち"],["と"],["いっしょ"],["に"],["やって"],["来た","きた"],["。"]]},{"verse":13,"text":"翌日、モーセは民をさばくためにさばきの座に着いた。民は朝から夕方まで、モーセのところに立っていた。","tok":[["翌日","よくじつ"],["、"],["モーセ"],["は"],["民","みん"],["を"],["さばく"],["ため"],["に"],["さばき"],["の"],["座","ざ"],["に"],["着いた","ついた"],["。"],["民","たみ"],["は"],["朝","あさ"],["から"],["夕方","ゆうがた"],["まで"],["、"],["モーセ"],["の"],["ところ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":14,"text":"モーセのしゅうとは、モーセが民のためにしているすべてのことを見て、こう言った。「あなたが民にしているこのことは、いったい何ですか。なぜあなたひとりだけがさばきの座に着き、民はみな朝から夕方まであなたのところに立っているのですか。」","tok":[["モーセ"],["の"],["しゅうと"],["は"],["、"],["モーセ"],["が"],["民","たみ"],["の"],["ため"],["に"],["して"],["いる"],["すべて"],["の"],["こと"],["を"],["見て","みて"],["、"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["が"],["民","たみ"],["に"],["して"],["いる"],["この"],["こと"],["は"],["、"],["いったい"],["何","なん"],["です"],["か"],["。"],["なぜ"],["あなた"],["ひとり"],["だけ"],["が"],["さばき"],["の"],["座","ざ"],["に"],["着き","つき"],["、"],["民","みん"],["は"],["みな"],["朝","あさ"],["から"],["夕方","ゆうがた"],["まで"],["あなた"],["の"],["ところ"],["に"],["立って","たって"],["いる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":15,"text":"モーセはしゅうとに答えた。「民は、神のみこころを求めて、私のところに来るのです。","tok":[["モーセ"],["は"],["しゅうと"],["に"],["答えた","こたえた"],["。"],["「"],["民","みん"],["は"],["、"],["神","かみ"],["のみ"],["こころ"],["を"],["求めて","もとめて"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["来る","くる"],["の"],["です"],["。"]]},{"verse":16,"text":"彼らに何か事件があると、私のところに来ます。私は双方の間をさばいて、神のおきてとおしえを知らせるのです。」","tok":[["彼","かれ"],["ら"],["に"],["何","なん"],["か"],["事件","じけん"],["が"],["ある"],["と"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["来ます","きます"],["。"],["私","わたくし"],["は"],["双方","そうほう"],["の"],["間","あいだ"],["を"],["さばいて"],["、"],["神","かみ"],["の"],["おきて"],["と"],["おしえ"],["を"],["知らせる","しらせる"],["の"],["です"],["。"],["」"]]},{"verse":17,"text":"するとモーセのしゅうとは言った。「あなたのしていることは良くありません。","tok":[["する"],["と"],["モーセ"],["の"],["しゅうと"],["は"],["言った","いった"],["。"],["「"],["あなた"],["の"],["して"],["いる"],["こと"],["は"],["良く","よく"],["ありません"],["。"]]},{"verse":18,"text":"あなたも、あなたといっしょにいるこの民も、きっと疲れ果ててしまいます。このことはあなたには重すぎますから、あなたはひとりでそれをすることはできません。","tok":[["あなた"],["も"],["、"],["あなた"],["と"],["いっしょ"],["に"],["いる"],["この"],["民","みん"],["も"],["、"],["きっと"],["疲れ","つかれ"],["果てて","はてて"],["しまいます"],["。"],["この"],["こと"],["は"],["あなた"],["に"],["は"],["重","おも"],["すぎます"],["から"],["、"],["あなた"],["は"],["ひとり"],["で"],["それ"],["を"],["する"],["こと"],["は"],["できません"],["。"]]},{"verse":19,"text":"さあ、私の言うことを聞いてください。私はあなたに助言をしましょう。どうか神があなたとともにおられるように。あなたは民に代わって神の前にいて、事件を神のところに持って行きなさい。","tok":[["さあ"],["、"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["助言","じょげん"],["を"],["しましょう"],["。"],["どう"],["か"],["神","かみ"],["が"],["あなた"],["と"],["とも"],["に"],["おられる"],["よう"],["に"],["。"],["あなた"],["は"],["民","みん"],["に"],["代わって","かわって"],["神","かみ"],["の"],["前","まえ"],["に"],["いて"],["、"],["事件","じけん"],["を"],["神","かみ"],["の"],["ところ"],["に"],["持って","もって"],["行き","いき"],["なさい"],["。"]]},{"verse":20,"text":"あなたは彼らにおきてとおしえとを与えて、彼らの歩むべき道と、なすべきわざを彼らに知らせなさい。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["おきて"],["と"],["おし"],["えと"],["を"],["与えて","あたえて"],["、"],["彼","かれ"],["ら"],["の"],["歩むべき","あゆむべき"],["道","みち"],["と"],["、"],["なすべき"],["わざ"],["を"],["彼","かれ"],["ら"],["に"],["知らせ","しらせ"],["なさい"],["。"]]},{"verse":21,"text":"あなたはまた、民全体の中から、神を恐れる、力のある人々、不正の利を憎む誠実な人々を見つけ出し、千人の長、百人の長、五十人の長、十人の長として、民の上に立てなければなりません。","tok":[["あなた"],["は"],["また"],["、"],["民","みん"],["全体","ぜんたい"],["の"],["中","なか"],["から"],["、"],["神","かみ"],["を"],["恐れる","おそれる"],["、"],["力","ちから"],["の"],["ある"],["人々","ひとびと"],["、"],["不正","ふせい"],["の"],["利","り"],["を"],["憎む","にくむ"],["誠実","せいじつ"],["な"],["人々","ひとびと"],["を"],["見つけ","みつけ"],["出し","だし"],["、"],["千人","せんにん"],["の"],["長","ちょう"],["、"],["百人","ひゃくにん"],["の"],["長","ちょう"],["、"],["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["、"],["十人","じゅうにん"],["の"],["長","ちょう"],["として"],["、"],["民","みん"],["の"],["上","うえ"],["に"],["立てなければ","たてなければ"],["なりません"],["。"]]},{"verse":22,"text":"いつもは彼らが民をさばくのです。大きい事件はすべてあなたのところに持って来、小さい事件はみな、彼らがさばかなければなりません。あなたの重荷を軽くしなさい。彼らはあなたとともに重荷をになうのです。","tok":[["いつも"],["は"],["彼","かれ"],["ら"],["が"],["民","たみ"],["を"],["さばく"],["の"],["です"],["。"],["大きい","おおきい"],["事件","じけん"],["は"],["すべて"],["あなた"],["の"],["ところ"],["に"],["持って","もって"],["来","き"],["、"],["小さい","ちいさい"],["事件","じけん"],["は"],["みな"],["、"],["彼","かれ"],["ら"],["が"],["さばかなければ"],["なりません"],["。"],["あなた"],["の"],["重荷","おもに"],["を"],["軽く","かるく"],["し"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["と"],["とも"],["に"],["重荷","おもに"],["を"],["になう"],["の"],["です"],["。"]]},{"verse":23,"text":"もしあなたがこのことを行えば、――神があなたに命じられるのですが――あなたはもちこたえることができ、この民もみな、平安のうちに自分のところに帰ることができましょう。」","tok":[["もし"],["あなた"],["が"],["この"],["こと"],["を"],["行えば","おこなえば"],["、"],["―"],["―"],["神","かみ"],["が"],["あなた"],["に"],["命じられる","めいじられる"],["の"],["です"],["が"],["―"],["―"],["あなた"],["は"],["もちこたえる"],["こと"],["が"],["でき"],["、"],["この"],["民","みん"],["も"],["みな"],["、"],["平安","へいあん"],["の"],["うち"],["に"],["自分","じぶん"],["の"],["ところ"],["に"],["帰る","かえる"],["こと"],["が"],["できましょう"],["。"],["」"]]},{"verse":24,"text":"モーセはしゅうとの言うことを聞き入れ、すべて言われたとおりにした。","tok":[["モーセ"],["は"],["しゅうと"],["の"],["言う","いう"],["こと"],["を"],["聞き入れ","ききいれ"],["、"],["すべて"],["言われた","いわれた"],["とおり"],["に"],["した"],["。"]]},{"verse":25,"text":"モーセは、イスラエル全体の中から力のある人々を選び、千人の長、百人の長、五十人の長、十人の長として、民のかしらに任じた。","tok":[["モーセ"],["は"],["、"],["イスラエル"],["全体","ぜんたい"],["の"],["中","なか"],["から"],["力","ちから"],["の"],["ある"],["人々","ひとびと"],["を"],["選び","えらび"],["、"],["千人","せんにん"],["の"],["長","ちょう"],["、"],["百人","ひゃくにん"],["の"],["長","ちょう"],["、"],["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["、"],["十人","じゅうにん"],["の"],["長","ちょう"],["として"],["、"],["民","みん"],["の"],["かしら"],["に"],["任じた","にんじた"],["。"]]},{"verse":26,"text":"いつもは彼らが民をさばき、むずかしい事件はモーセのところに持って来たが、小さい事件は、みな彼ら自身でさばいた。","tok":[["いつも"],["は"],["彼","かれ"],["ら"],["が"],["民","たみ"],["を"],["さばき"],["、"],["むずかしい"],["事件","じけん"],["は"],["モーセ"],["の"],["ところ"],["に"],["持って","もって"],["来た","きた"],["が"],["、"],["小さい","ちいさい"],["事件","じけん"],["は"],["、"],["みな"],["彼","かれ"],["ら"],["自身","じしん"],["で"],["さばいた"],["。"]]},{"verse":27,"text":"それから、モーセはしゅうとを見送った。彼は自分の国へ帰って行った。","tok":[["それ"],["から"],["、"],["モーセ"],["は"],["しゅうと"],["を"],["見送った","みおくった"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["国","くに"],["へ"],["帰って","かえって"],["行った","いった"],["。"]]}]
[{"verse":1,"text":"主はモーセに仰せられた。「わたしはパロとエジプトの上になお一つのわざわいを下す。そのあとで彼は、あなたがたをここから行かせる。彼があなたがたを行かせるときは、ほんとうにひとり残らずあなたがたをここから追い出してしまおう。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["パロ"],["と"],["エジプト"],["の"],["上","うえ"],["に"],["なお"],["一","ひと"],["つ"],["の"],["わざわい"],["を"],["下す","くだす"],["。"],["その"],["あと"],["で"],["彼","かれ"],["は"],["、"],["あなた"],["がた"],["を"],["ここ"],["から"],["行かせる","いかせる"],["。"],["彼","かれ"],["が"],["あなた"],["がた"],["を"],["行かせる","いかせる"],["とき"],["は"],["、"],["ほんとう"],["に"],["ひとり"],["残らず","のこらず"],["あなた"],["がた"],["を"],["ここ"],["から"],["追い出して","おいだして"],["しまおう"],["。"]]},{"verse":2,"text":"さあ、民に語って聞かせよ。男は隣の男から、女は隣の女から銀の飾りや金の飾りを求めるように。」","tok":[["さあ"],["、"],["民","みん"],["に"],["語って","かたって"],["聞かせ","きかせ"],["よ"],["。"],["男","おとこ"],["は"],["隣","となり"],["の"],["男","おとこ"],["から"],["、"],["女","おんな"],["は"],["隣","となり"],["の"],["女","おんな"],["から"],["銀","ぎん"],["の"],["飾り","かざり"],["や"],["金","きん"],["の"],["飾り","かざり"],["を"],["求める","もとめる"],["よう"],["に"],["。"],["」"]]},{"verse":3,"text":"主はエジプトが民に好意を持つようにされた。モーセその人も、エジプトの国でパロの家臣と民とに非常に尊敬されていた。","tok":[["主","ぬし"],["は"],["エジプト"],["が"],["民","たみ"],["に"],["好意","こうい"],["を"],["持つ","もつ"],["よう"],["に"],["された"],["。"],["モーセ"],["その"],["人","ひと"],["も"],["、"],["エジプト"],["の"],["国","くに"],["で"],["パロ"],["の"],["家臣","かしん"],["と"],["民","たみ"],["と"],["に"],["非常","ひじょう"],["に"],["尊敬","そんけい"],["されて"],["いた"],["。"]]},{"verse":4,"text":"モーセは言った。「主はこう仰せられます。『真夜中ごろ、わたしはエジプトの中に出て行く。","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["真","ま"],["夜","よる"],["中ごろ","なかごろ"],["、"],["わたし"],["は"],["エジプト"],["の"],["中","なか"],["に"],["出て","でて"],["行く","いく"],["。"]]},{"verse":5,"text":"エジプトの国の初子は、王座に着くパロの初子から、ひき臼のうしろにいる女奴隷の初子、それに家畜の初子に至るまで、みな死ぬ。","tok":[["エジプト"],["の"],["国","くに"],["の"],["初子","ういご"],["は"],["、"],["王座","おうざ"],["に"],["着く","つく"],["パロ"],["の"],["初子","ういご"],["から"],["、"],["ひき臼","ひきうす"],["の"],["うしろ"],["に"],["いる"],["女","じょ"],["奴隷","どれい"],["の"],["初子","ういご"],["、"],["それ"],["に"],["家畜","かちく"],["の"],["初子","ういご"],["に"],["至る","いたる"],["まで"],["、"],["みな"],["死ぬ","しぬ"],["。"]]},{"verse":6,"text":"そしてエジプト全土にわたって、大きな叫びが起こる。このようなことはかつてなく、また二度とないであろう。』","tok":[["そして"],["エジプト"],["全土","ぜんど"],["に"],["わたって"],["、"],["大きな","おおきな"],["叫び","さけび"],["が"],["起こる","おこる"],["。"],["この"],["よう"],["な"],["こと"],["は"],["かつて"],["なく"],["、"],["また"],["二","に"],["度","ど"],["と"],["ないで"],["あろう"],["。"],["』"]]},{"verse":7,"text":"しかしイスラエル人に対しては、人から家畜に至るまで、犬も、うなりはしないでしょう。これは、主がエジプト人とイスラエル人を区別されるのを、あなたがたが知るためです。","tok":[["しかし"],["イスラエル"],["人","にん"],["に"],["対し","たいし"],["ては"],["、"],["人","ひと"],["から"],["家畜","かちく"],["に"],["至る","いたる"],["まで"],["、"],["犬","いぬ"],["も"],["、"],["うなり"],["は"],["しないでしょう"],["。"],["これ"],["は"],["、"],["主","ぬし"],["が"],["エジプト"],["人","にん"],["と"],["イスラエル"],["人","にん"],["を"],["区別","くべつ"],["される"],["の"],["を"],["、"],["あなた"],["がた"],["が"],["知る","しる"],["ため"],["です"],["。"]]},{"verse":8,"text":"あなたのこの家臣たちは、みな、私のところに来て伏し拝み、『あなたとあなたに従う民はみな出て行ってください』と言うでしょう。私はそのあとで出て行きます。」こうしてモーセは怒りに燃えてパロのところから出て行った。","tok":[["あなた"],["の"],["この"],["家臣","かしん"],["たち"],["は"],["、"],["みな"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["来て","きて"],["伏し拝み","ふしおがみ"],["、"],["『"],["あなた"],["と"],["あなた"],["に"],["従う","したがう"],["民","たみ"],["は"],["みな"],["出て","でて"],["行って","いって"],["ください"],["』"],["と"],["言うでしょう","ゆうでしょう"],["。"],["私","わたくし"],["は"],["その"],["あと"],["で"],["出て","でて"],["行きます","いきます"],["。"],["」"],["こう"],["して"],["モーセ"],["は"],["怒り","いかり"],["に"],["燃えて","もえて"],["パロ"],["の"],["ところ"],["から"],["出て","でて"],["行った","いった"],["。"]]},{"verse":9,"text":"主はモーセに仰せられた。「パロはあなたがたの言うことを聞き入れないであろう。それはわたしの不思議がエジプトの地で多くなるためである。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["パロ"],["は"],["あなた"],["がた"],["の"],["言う","いう"],["こと"],["を"],["聞き入れないで","ききいれないで"],["あろう"],["。"],["それ"],["は"],["わたし"],["の"],["不思議","ふしぎ"],["が"],["エジプト"],["の"],["地","ち"],["で"],["多く","おおく"],["なる"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":10,"text":"モーセとアロンは、パロの前でこれらの不思議をみな行った。しかし主はパロの心をかたくなにされ、パロはイスラエル人を自分の国から出て行かせなかった。","tok":[["モーセ"],["と"],["アロン"],["は"],["、"],["パロ"],["の"],["前","まえ"],["で"],["これ"],["ら"],["の"],["不思議","ふしぎ"],["を"],["みな"],["行った","いった"],["。"],["しかし"],["主","ぬし"],["は"],["パロ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["され"],["、"],["パロ"],["は"],["イスラエル"],["人","にん"],["を"],["自分","じぶん"],["の"],["国","くに"],["から"],["出て","でて"],["行かせなかった","いかせなかった"],["。"]]}]
[{"verse":1,"text":"それで主はモーセに仰せられた。「わたしがパロにしようとしていることは、今にあなたにわかる。すなわち強い手で、彼は彼らを出て行かせる。強い手で、彼はその国から彼らを追い出してしまう。」","tok":[["それ"],["で"],["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["が"],["パロ"],["に"],["しよう"],["として"],["いる"],["こと"],["は"],["、"],["今","いま"],["に"],["あなた"],["に"],["わかる"],["。"],["すなわち"],["強い","つよい"],["手","て"],["で"],["、"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["を"],["出て","でて"],["行かせる","いかせる"],["。"],["強い","つよい"],["手","て"],["で"],["、"],["彼","かれ"],["は"],["その"],["国","くに"],["から"],["彼","かれ"],["ら"],["を"],["追い出して","おいだして"],["しまう"],["。"],["」"]]},{"verse":2,"text":"神はモーセに告げて仰せられた。「わたしは主である。","tok":[["神","かみ"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":3,"text":"わたしは、アブラハム、イサク、ヤコブに、全能の神として現れたが、主という名では、わたしを彼らに知らせなかった。","tok":[["わたし"],["は"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["、"],["全能","ぜんのう"],["の"],["神","かみ"],["として"],["現れた","あらわれた"],["が"],["、"],["主","ぬし"],["と"],["いう"],["名","な"],["で"],["は"],["、"],["わたし"],["を"],["彼","かれ"],["ら"],["に"],["知らせなかった","しらせなかった"],["。"]]},{"verse":4,"text":"またわたしは、カナンの地、すなわち彼らがとどまった在住の地を彼らに与えるという契約を彼らに立てた。","tok":[["また"],["わたし"],["は"],["、"],["カナン"],["の"],["地","ち"],["、"],["すなわち"],["彼","かれ"],["ら"],["が"],["とどまった"],["在住","ざいじゅう"],["の"],["地","ち"],["を"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["と"],["いう"],["契約","けいやく"],["を"],["彼","かれ"],["ら"],["に"],["立てた","たてた"],["。"]]},{"verse":5,"text":"今わたしは、エジプトが奴隷としているイスラエル人の嘆きを聞いて、わたしの契約を思い起こした。","tok":[["今","いま"],["わたし"],["は"],["、"],["エジプト"],["が"],["奴隷","どれい"],["として"],["いる"],["イスラエル"],["人","にん"],["の"],["嘆き","なげき"],["を"],["聞いて","きいて"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["思い起こした","おもいおこした"],["。"]]},{"verse":6,"text":"それゆえ、イスラエル人に言え。わたしは主である。わたしはあなたがたをエジプトの苦役の下から連れ出し、労役から救い出す。伸ばした腕と大いなるさばきとによってあなたがたを贖う。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["人","にん"],["に"],["言え","いえ"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["エジプト"],["の"],["苦役","くえき"],["の"],["下","した"],["から"],["連れ出し","つれだし"],["、"],["労役","ろうえき"],["から"],["救い出す","すくいだす"],["。"],["伸ばした","のばした"],["腕","うで"],["と"],["大いなる","おおいなる"],["さばき"],["と"],["によって"],["あなた"],["がた"],["を"],["贖う","あがなう"],["。"]]},{"verse":7,"text":"わたしはあなたがたを取ってわたしの民とし、わたしはあなたがたの神となる。あなたがたは、わたしがあなたがたの神、主であり、あなたがたをエジプトの苦役の下から連れ出す者であることを知るようになる。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["取って","とって"],["わたし"],["の"],["民","たみ"],["と"],["し"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["。"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["あり"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["苦役","くえき"],["の"],["下","した"],["から"],["連れ出す","つれだす"],["者","もの"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"わたしは、アブラハム、イサク、ヤコブに与えると誓ったその地に、あなたがたを連れて行き、それをあなたがたの所有として与える。わたしは主である。」","tok":[["わたし"],["は"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["与える","あたえる"],["と"],["誓った","ちかった"],["その"],["地","ち"],["に"],["、"],["あなた"],["がた"],["を"],["連れて","つれて"],["行き","いき"],["、"],["それ"],["を"],["あなた"],["がた"],["の"],["所有","しょゆう"],["として"],["与える","あたえる"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"モーセはこのようにイスラエル人に話したが、彼らは落胆と激しい労役のためモーセに聞こうとはしなかった。","tok":[["モーセ"],["は"],["この"],["よう"],["に"],["イスラエル"],["人","にん"],["に"],["話した","はなした"],["が"],["、"],["彼","かれ"],["ら"],["は"],["落胆","らくたん"],["と"],["激しい","はげしい"],["労役","ろうえき"],["の"],["ため"],["モーセ"],["に"],["聞こう","きこう"],["と"],["は"],["しなかった"],["。"]]},{"verse":10,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":11,"text":"「エジプトの王パロのところへ行って、彼がイスラエル人をその国から去らせるように告げよ。」","tok":[["「"],["エジプト"],["の"],["王","おう"],["パロ"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["彼","かれ"],["が"],["イスラエル"],["人","にん"],["を"],["その"],["国","くに"],["から"],["去らせる","さらせる"],["よう"],["に"],["告げ","つげ"],["よ"],["。"],["」"]]},{"verse":12,"text":"しかしモーセは主の前に訴えて言った。「ご覧ください。イスラエル人でさえ、私の言うことを聞こうとはしないのです。どうしてパロが私の言うことを聞くでしょう。私は口べたなのです。」","tok":[["しかし"],["モーセ"],["は"],["主","ぬし"],["の"],["前","まえ"],["に"],["訴えて","うったえて"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["ください"],["。"],["イスラエル"],["人","にん"],["で"],["さえ"],["、"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞こう","きこう"],["と"],["は"],["しない"],["の"],["です"],["。"],["どう"],["して"],["パロ"],["が"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞くでしょう","きくでしょう"],["。"],["私","わたくし"],["は"],["口べた","くちべた"],["な"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"そこで主はモーセとアロンに語り、イスラエル人をエジプトから連れ出すため、イスラエル人とエジプトの王パロについて彼らに命令された。","tok":[["そこ"],["で"],["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["語り","かたり"],["、"],["イスラエル"],["人","にん"],["を"],["エジプト"],["から"],["連れ出す","つれだす"],["ため"],["、"],["イスラエル"],["人","にん"],["と"],["エジプト"],["の"],["王","おう"],["パロ"],["について"],["彼","かれ"],["ら"],["に"],["命令","めいれい"],["された"],["。"]]},{"verse":14,"text":"彼らの父祖の家のかしらたちは次のとおりである。イスラエルの長子ルベンの子はエノク、パル、ヘツロン、カルミで、これらがルベン族である。","tok":[["彼","かれ"],["ら"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["かしら"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["イスラエル"],["の"],["長子","ちょうし"],["ルベン"],["の"],["子","こ"],["は"],["エノク"],["、"],["パル"],["、"],["ヘツロン"],["、"],["カルミ"],["で"],["、"],["これ"],["ら"],["が"],["ルベン族","るべんぞく"],["で"],["ある"],["。"]]},{"verse":15,"text":"シメオンの子はエムエル、ヤミン、オハデ、ヤキン、ツォハル、およびカナン人の女の子サウルで、これらがシメオン族である。","tok":[["シメオン"],["の"],["子","こ"],["は"],["エムエル"],["、"],["ヤミン"],["、"],["オハデ"],["、"],["ヤキン"],["、"],["ツォハル"],["、"],["および"],["カナン人","かなんにん"],["の"],["女の子","おんなのこ"],["サウル"],["で"],["、"],["これ"],["ら"],["が"],["シメオン"],["族","ぞく"],["で"],["ある"],["。"]]},{"verse":16,"text":"レビの子の家系の名は、次のとおりである。ゲルション、ケハテ、メラリ。レビの一生は百三十七年であった。","tok":[["レビ"],["の"],["子","こ"],["の"],["家系","かけい"],["の"],["名","な"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ゲルション"],["、"],["ケハテ"],["、"],["メラリ"],["。"],["レビ"],["の"],["一生","いっしょう"],["は"],["百三十七","ひゃくさんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":17,"text":"ゲルションの子の諸氏族はリブニとシムイである。","tok":[["ゲルション"],["の"],["子","こ"],["の"],["諸","しょ"],["氏族","しぞく"],["は"],["リブニ"],["と"],["シムイ"],["で"],["ある"],["。"]]},{"verse":18,"text":"ケハテの子はアムラム、イツハル、ヘブロン、ウジエルである。ケハテの一生は百三十三年であった。","tok":[["ケハテ"],["の"],["子","こ"],["は"],["アムラム"],["、"],["イツハル"],["、"],["ヘブロン"],["、"],["ウジエル"],["で"],["ある"],["。"],["ケハテ"],["の"],["一生","いっしょう"],["は"],["百三十三","ひゃくさんじゅうさん"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":19,"text":"メラリの子はマフリとムシである。これらはレビ人の諸氏族の家系である。","tok":[["メラリ"],["の"],["子","こ"],["は"],["マフリ"],["と"],["ムシ"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["レビ人","れびにん"],["の"],["諸","しょ"],["氏族","しぞく"],["の"],["家系","かけい"],["で"],["ある"],["。"]]},{"verse":20,"text":"アムラムは父の妹ヨケベデを妻にめとり、彼女はアロンとモーセを産んだ。アムラムの一生は百三十七年であった。","tok":[["アムラム"],["は"],["父","ちち"],["の"],["妹","いもうと"],["ヨケベデ"],["を"],["妻","つま"],["に"],["めとり"],["、"],["彼女","かのじょ"],["は"],["アロン"],["と"],["モーセ"],["を"],["産んだ","うんだ"],["。"],["アムラム"],["の"],["一生","いっしょう"],["は"],["百三十七","ひゃくさんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":21,"text":"イツハルの子はコラ、ネフェグ、ジクリである。","tok":[["イツハル"],["の"],["子","こ"],["は"],["コラ"],["、"],["ネフェグ"],["、"],["ジクリ"],["で"],["ある"],["。"]]},{"verse":22,"text":"ウジエルの子はミシャエル、エルツァファン、シテリである。","tok":[["ウジエル"],["の"],["子","こ"],["は"],["ミシャエル"],["、"],["エルツァファン"],["、"],["シテリ"],["で"],["ある"],["。"]]},{"verse":23,"text":"アロンは、アミナダブの娘でナフションの妹であるエリシェバを妻にめとり、彼女はナダブとアビフ、エルアザルとイタマルを産んだ。","tok":[["アロン"],["は"],["、"],["アミナダブ"],["の"],["娘","むすめ"],["で"],["ナフション"],["の"],["妹","いもうと"],["で"],["ある"],["エリシェバ"],["を"],["妻","つま"],["に"],["めとり"],["、"],["彼女","かのじょ"],["は"],["ナダブ"],["と"],["アビフ"],["、"],["エルアザル"],["と"],["イタマル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":24,"text":"コラの子はアシル、エルカナ、アビアサフで、これらはコラ族である。","tok":[["コラ"],["の"],["子","こ"],["は"],["アシル"],["、"],["エルカナ"],["、"],["アビアサフ"],["で"],["、"],["これ"],["ら"],["は"],["コラ族","こらぞく"],["で"],["ある"],["。"]]},{"verse":25,"text":"アロンの子エルアザルは、プティエルの娘のひとりを妻にめとり、彼女はピネハスを産んだ。これらはレビ人の諸氏族の一族のかしらたちである。","tok":[["アロン"],["の"],["子","こ"],["エルアザル"],["は"],["、"],["プティエル"],["の"],["娘","むすめ"],["の"],["ひとり"],["を"],["妻","つま"],["に"],["めとり"],["、"],["彼女","かのじょ"],["は"],["ピネハス"],["を"],["産んだ","うんだ"],["。"],["これ"],["ら"],["は"],["レビ人","れびにん"],["の"],["諸","しょ"],["氏族","しぞく"],["の"],["一族","いちぞく"],["の"],["かしら"],["たち"],["で"],["ある"],["。"]]},{"verse":26,"text":"主が「イスラエル人を集団ごとにエジプトの地から連れ出せ」と仰せられたのは、このアロンとモーセにである。","tok":[["主","ぬし"],["が"],["「"],["イスラエル"],["人","にん"],["を"],["集団","しゅうだん"],["ごと"],["に"],["エジプト"],["の"],["地","ち"],["から"],["連れ出せ","つれだせ"],["」"],["と"],["仰せられた","おおせられた"],["の"],["は"],["、"],["この"],["アロン"],["と"],["モーセ"],["に"],["で"],["ある"],["。"]]},{"verse":27,"text":"エジプトの王パロに向かって、イスラエル人をエジプトから連れ出すようにと言ったのは、このモーセとアロンであった。","tok":[["エジプト"],["の"],["王","おう"],["パロ"],["に"],["向かって","むかって"],["、"],["イスラエル"],["人","にん"],["を"],["エジプト"],["から"],["連れ出す","つれだす"],["よう"],["に"],["と"],["言った","いった"],["の"],["は"],["、"],["この"],["モーセ"],["と"],["アロン"],["で"],["あった"],["。"]]},{"verse":28,"text":"主がエジプトの地でモーセに告げられたときに、","tok":[["主","ぬし"],["が"],["エジプト"],["の"],["地","ち"],["で"],["モーセ"],["に"],["告げられた","つげられた"],["とき"],["に"],["、"]]},{"verse":29,"text":"主はモーセに告げて仰せられた。「わたしは主である。わたしがあなたに話すことを、みな、エジプトの王パロに告げよ。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["が"],["あなた"],["に"],["話す","はなす"],["こと"],["を"],["、"],["みな"],["、"],["エジプト"],["の"],["王","おう"],["パロ"],["に"],["告げ","つげ"],["よ"],["。"],["」"]]},{"verse":30,"text":"しかしモーセは主の前に申し上げた。「ご覧ください。私は口べたです。どうしてパロが私の言うことを聞くでしょう。」","tok":[["しかし"],["モーセ"],["は"],["主","ぬし"],["の"],["前","まえ"],["に"],["申し上げた","もうしあげた"],["。"],["「"],["ご覧","ごらん"],["ください"],["。"],["私","わたくし"],["は"],["口べた","くちべた"],["です"],["。"],["どう"],["して"],["パロ"],["が"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞くでしょう","きくでしょう"],["。"],["」"]]}]
],["を"],["かたくな"],["に"],["され"],["、"],["彼","かれ"],["は"],["ふたり"],["の"],["言う","いう"],["こと"],["を"],["聞き入れなかった","ききいれなかった"],["。"],["主","ぬし"],["が"],["モーセ"],["に"],["言われた","いわれた"],["とおり"],["で"],["ある"],["。"]]},{"verse":13,"text":"主はモーセに仰せられた。「あしたの朝早く、パロの前に立ち、彼に言え。ヘブル人の神、主はこう仰せられます。『わたしの民を行かせ、彼らをわたしに仕えさせよ。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あした"],["の"],["朝","あさ"],["早く","はやく"],["、"],["パロ"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["彼","かれ"],["に"],["言え","いえ"],["。"],["ヘブル人","へぶるにん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["行かせ","いかせ"],["、"],["彼","かれ"],["ら"],["を"],["わたし"],["に"],["仕えさせ","つかえさせ"],["よ"],["。"]]},{"verse":14,"text":"今度は、わたしは、あなたとあなたの家臣とあなたの民とに、わたしのすべての災害を送る。わたしのような者は地のどこにもいないことを、あなたに知らせるためである。","tok":[["今度","こんど"],["は"],["、"],["わたし"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["家臣","かしん"],["と"],["あなた"],["の"],["民","たみ"],["と"],["に"],["、"],["わたし"],["の"],["すべて"],["の"],["災害","さいがい"],["を"],["送る","おくる"],["。"],["わたし"],["の"],["よう"],["な"],["者","もの"],["は"],["地","ち"],["の"],["どこ"],["に"],["も"],["いない"],["こと"],["を"],["、"],["あなた"],["に"],["知らせる","しらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"わたしが今、手を伸ばして、あなたとあなたの民を疫病で打つなら、あなたは地から消し去られる。","tok":[["わたし"],["が"],["今","いま"],["、"],["手","て"],["を"],["伸ばして","のばして"],["、"],["あなた"],["と"],["あなた"],["の"],["民","たみ"],["を"],["疫病","やくびょう"],["で"],["打つなら","うつなら"],["、"],["あなた"],["は"],["地","ち"],["から"],["消し去られる","けしさられる"],["。"]]},{"verse":16,"text":"それにもかかわらず、わたしは、わたしの力をあなたに示すためにあなたを立てておく。また、わたしの名を全地に告げ知らせるためである。","tok":[["それ"],["に"],["も"],["かかわらず"],["、"],["わたし"],["は"],["、"],["わたし"],["の"],["力","ちから"],["を"],["あなた"],["に"],["示す","しめす"],["ため"],["に"],["あなた"],["を"],["立てて","たてて"],["おく"],["。"],["また"],["、"],["わたし"],["の"],["名","な"],["を"],["全地","ぜんち"],["に"],["告げ知らせる","つげしらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"あなたはまだわたしの民に対して高ぶっており、彼らを行かせようとしない。","tok":[["あなた"],["は"],["まだ"],["わたし"],["の"],["民","たみ"],["に対して","にたいして"],["高ぶって","たかぶって"],["おり"],["、"],["彼","かれ"],["ら"],["を"],["行かせよう","いかせよう"],["と"],["しない"],["。"]]},{"verse":18,"text":"さあ、今度は、あすの今ごろ、エジプトにおいて建国の日以来、今までになかったきわめて激しい雹をわたしは降らせる。","tok":[["さあ"],["、"],["今度","こんど"],["は"],["、"],["あす"],["の"],["今ごろ","いまごろ"],["、"],["エジプト"],["に"],["おいて"],["建国","けんこく"],["の"],["日","ひ"],["以来","いらい"],["、"],["今まで","いままで"],["に"],["なかった"],["きわめて"],["激しい","はげしい"],["雹","ひょう"],["を"],["わたし"],["は"],["降らせる","ふらせる"],["。"]]},{"verse":19,"text":"それゆえ、今すぐ使いをやり、あなたの家畜、あなたが持っている野にあるすべてのものを避難させよ。野にいて家へ連れ戻すことのできない人や獣はみな雹が落ちて来ると死んでしまう。』」","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["すぐ"],["使い","つかい"],["を"],["やり"],["、"],["あなた"],["の"],["家畜","かちく"],["、"],["あなた"],["が"],["持って","もって"],["いる"],["野","の"],["に"],["ある"],["すべて"],["の"],["もの"],["を"],["避難","ひなん"],["させ"],["よ"],["。"],["野","の"],["に"],["いて"],["家","いえ"],["へ"],["連れ戻す","つれもどす"],["こと"],["の"],["できない"],["人","ひと"],["や"],["獣","けもの"],["は"],["みな"],["雹","ひょう"],["が"],["落ちて","おちて"],["来る","くる"],["と"],["死んで","しんで"],["しまう"],["。"],["』"],["」"]]},{"verse":20,"text":"パロの家臣のうちで主のことばを恐れた者は、しもべたちと家畜を家に避難させた。","tok":[["パロ"],["の"],["家臣","かしん"],["の"],["うち"],["で"],["主","ぬし"],["の"],["ことば"],["を"],["恐れた","おそれた"],["者","もの"],["は"],["、"],["しもべ"],["たち"],["と"],["家畜","かちく"],["を"],["家","いえ"],["に"],["避難","ひなん"],["させた"],["。"]]},{"verse":21,"text":"しかし、主のことばを心に留めなかった者は、しもべたちや家畜をそのまま野に残した。","tok":[["しかし"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["心","こころ"],["に"],["留めなかった","とめなかった"],["者","もの"],["は"],["、"],["しもべ"],["たち"],["や"],["家畜","かちく"],["を"],["そのまま"],["野","の"],["に"],["残した","のこした"],["。"]]},{"verse":22,"text":"そこで主はモーセに仰せられた。「あなたの手を天に向けて差し伸ばせ。そうすれば、エジプト全土にわたって、人、獣、またエジプトの地のすべての野の草の上に雹が降る。」","tok":[["そこ"],["で"],["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["手","て"],["を"],["天","てん"],["に"],["向けて","むけて"],["差し伸ばせ","さしのばせ"],["。"],["そう"],["すれば"],["、"],["エジプト"],["全土","ぜんど"],["に"],["わたって"],["、"],["人","ひと"],["、"],["獣","けもの"],["、"],["また"],["エジプト"],["の"],["地","ち"],["の"],["すべて"],["の"],["野","の"],["の"],["草","くさ"],["の"],["上","うえ"],["に"],["雹","ひょう"],["が"],["降る","ふる"],["。"],["」"]]},{"verse":23,"text":"モーセが杖を天に向けて差し伸ばすと、主は雷と雹を送り、火が地に向かって走った。主はエジプトの国に雹を降らせた。","tok":[["モーセ"],["が"],["杖","つえ"],["を"],["天","てん"],["に"],["向けて","むけて"],["差し伸ばす","さしのばす"],["と"],["、"],["主","ぬし"],["は"],["雷","かみなり"],["と"],["雹","ひょう"],["を"],["送り","おくり"],["、"],["火","ひ"],["が"],["地","ち"],["に"],["向かって","むかって"],["走った","はしった"],["。"],["主","ぬし"],["は"],["エジプト"],["の"],["国","くに"],["に"],["雹","ひょう"],["を"],["降らせた","ふらせた"],["。"]]},{"verse":24,"text":"雹が降り、雹のただ中を火がひらめき渡った。建国以来エジプトの国中どこにもそのようなことのなかった、きわめて激しいものであった。","tok":[["雹","ひょう"],["が"],["降り","ふり"],["、"],["雹","ひょう"],["の"],["ただ中","ただなか"],["を"],["火","ひ"],["が"],["ひらめき"],["渡った","わたった"],["。"],["建国","けんこく"],["以来","いらい"],["エジプト"],["の"],["国中","くにちゅう"],["どこ"],["に"],["も"],["その"],["よう"],["な"],["こと"],["の"],["なかった"],["、"],["きわめて"],["激しい","はげしい"],["もの"],["で"],["あった"],["。"]]},{"verse":25,"text":"雹はエジプト全土にわたって、人をはじめ獣に至るまで、野にいるすべてのものを打ち、また野の草をみな打った。野の木もことごとく打ち砕いた。","tok":[["雹","ひょう"],["は"],["エジプト"],["全土","ぜんど"],["に"],["わたって"],["、"],["人","ひと"],["を"],["はじめ"],["獣","けもの"],["に"],["至る","いたる"],["まで"],["、"],["野","の"],["に"],["いる"],["すべて"],["の"],["もの"],["を"],["打ち","うち"],["、"],["また"],["野","の"],["の"],["草","くさ"],["を"],["みな"],["打った","うった"],["。"],["野","の"],["の"],["木","き"],["も"],["ことごとく"],["打ち砕いた","うちくだいた"],["。"]]},{"verse":26,"text":"ただ、イスラエル人が住むゴシェンの地には、雹は降らなかった。","tok":[["ただ"],["、"],["イスラエル"],["人","にん"],["が"],["住む","すむ"],["ゴシェン"],["の"],["地","ち"],["に"],["は"],["、"],["雹","ひょう"],["は"],["降らなかった","ふらなかった"],["。"]]},{"verse":27,"text":"そこでパロは使いをやって、モーセとアロンを呼び寄せ、彼らに言った。「今度は、私は罪を犯した。主は正しいお方だ。私と私の民は悪者だ。","tok":[["そこ"],["で"],["パロ"],["は"],["使い","つかい"],["を"],["やって"],["、"],["モーセ"],["と"],["アロン"],["を"],["呼び寄せ","よびよせ"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["今度","こんど"],["は"],["、"],["私","わたくし"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["主","ぬし"],["は"],["正しい","ただしい"],["お方","おかた"],["だ"],["。"],["私","わたくし"],["と"],["私","わたくし"],["の"],["民","たみ"],["は"],["悪者","わるもの"],["だ"],["。"]]},{"verse":28,"text":"主に祈ってくれ。神の雷と雹は、もうたくさんだ。私はおまえたちを行かせよう。おまえたちはもう、とどまってはならない。」","tok":[["主に","おもに"],["祈って","いのって"],["くれ"],["。"],["神","かみ"],["の"],["雷","かみなり"],["と"],["雹","ひょう"],["は"],["、"],["もう"],["たくさん"],["だ"],["。"],["私","わたくし"],["は"],["おまえ"],["たち"],["を"],["行かせよう","いかせよう"],["。"],["おまえ"],["たち"],["は"],["もう"],["、"],["とどまって"],["は"],["ならない"],["。"],["」"]]},{"verse":29,"text":"モーセは彼に言った。「私が町を出たら、すぐに主に向かって手を伸べ広げましょう。そうすれば雷はやみ、雹はもう降らなくなりましょう。この地が主のものであることをあなたが知るためです。","tok":[["モーセ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["町","まち"],["を"],["出たら","でたら"],["、"],["すぐ"],["に"],["主","ぬし"],["に"],["向かって","むかって"],["手","て"],["を"],["伸べ","のべ"],["広げましょう","ひろげましょう"],["。"],["そう"],["すれば"],["雷","かみなり"],["は"],["やみ"],["、"],["雹","ひょう"],["は"],["もう"],["降らなく","ふらなく"],["なりましょう"],["。"],["この"],["地","ち"],["が"],["主","ぬし"],["の"],["もの"],["で"],["ある"],["こと"],["を"],["あなた"],["が"],["知る","しる"],["ため"],["です"],["。"]]},{"verse":30,"text":"しかし、あなたとあなたの家臣が、まだ、神である主を恐れていないことを、私は知っています。」","tok":[["しかし"],["、"],["あなた"],["と"],["あなた"],["の"],["家臣","かしん"],["が"],["、"],["まだ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["を"],["恐れて","おそれて"],["いない"],["こと"],["を"],["、"],["私","わたくし"],["は"],["知って","しって"],["います"],["。"],["」"]]},{"verse":31,"text":"――亜麻と大麦は打ち倒された。大麦は穂を出し、亜麻はつぼみをつけていたからである。","tok":[["―"],["―"],["亜麻","あま"],["と"],["大麦","おおむぎ"],["は"],["打ち倒された","うちたおされた"],["。"],["大麦","おおむぎ"],["は"],["穂","ほ"],["を"],["出し","だし"],["、"],["亜麻","あま"],["は"],["つぼみ"],["を"],["つけて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"しかし小麦とスペルト小麦は打ち倒されなかった。これらは実るのがおそいからである――","tok":[["しかし"],["小麦","こむぎ"],["と"],["スペルト"],["小麦","こむぎ"],["は"],["打ち倒されなかった","うちたおされなかった"],["。"],["これ"],["ら"],["は"],["実る","みのる"],["の"],["が"],["おそい"],["から"],["で"],["ある"],["―"],["―"]]},{"verse":33,"text":"モーセはパロのところを去り、町を出て、主に向かって両手を伸べ広げた。すると、雷と雹はやみ、雨はもう地に降らなくなった。","tok":[["モーセ"],["は"],["パロ"],["の"],["ところ"],["を"],["去り","さり"],["、"],["町","まち"],["を"],["出て","でて"],["、"],["主に","おもに"],["向かって","むかって"],["両手","りょうて"],["を"],["伸べ","のべ"],["広げた","ひろげた"],["。"],["する"],["と"],["、"],["雷","かみなり"],["と"],["雹","ひょう"],["は"],["やみ"],["、"],["雨","あめ"],["は"],["もう"],["地","ち"],["に"],["降らなく",
[{"verse":1,"text":"主は、モーセに仰せられた。「あなたとアロン、ナダブとアビフ、それにイスラエルの長老七十人は、主のところに上り、遠く離れて伏し拝め。","tok":[["主","ぬし"],["は"],["、"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["と"],["アロン"],["、"],["ナダブ"],["と"],["アビフ"],["、"],["それ"],["に"],["イスラエル"],["の"],["長老","ちょうろう"],["七","なな"],["十人","じゅうにん"],["は"],["、"],["主","ぬし"],["の"],["ところ"],["に"],["上り","のぼり"],["、"],["遠く","とおく"],["離れて","はなれて"],["伏し拝め","ふしおがめ"],["。"]]},{"verse":2,"text":"モーセひとり主のもとに近づけ。他の者は近づいてはならない。民もモーセといっしょに上ってはならない。」","tok":[["モーセ"],["ひとり"],["主","ぬし"],["の"],["もと"],["に"],["近づけ","ちかづけ"],["。"],["他","ほか"],["の"],["者","もの"],["は"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["民","たみ"],["も"],["モーセ"],["と"],["いっしょ"],["に"],["上って","のぼって"],["は"],["ならない"],["。"],["」"]]},{"verse":3,"text":"そこでモーセは来て、主のことばと、定めをことごとく民に告げた。すると、民はみな声を一つにして答えて言った。「主の仰せられたことは、みな行います。」","tok":[["そこ"],["で"],["モーセ"],["は"],["来て","きて"],["、"],["主","ぬし"],["の"],["ことば"],["と"],["、"],["定め","さだめ"],["を"],["ことごとく"],["民","たみ"],["に"],["告げた","つげた"],["。"],["する"],["と"],["、"],["民","みん"],["は"],["みな"],["声","こえ"],["を"],["一","ひと"],["つ"],["に"],["して"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["仰せられた","おおせられた"],["こと"],["は"],["、"],["みな"],["行います","おこないます"],["。"],["」"]]},{"verse":4,"text":"それで、モーセは主のことばを、ことごとく書きしるした。そうしてモーセは、翌朝早く、山のふもとに祭壇を築き、またイスラエルの十二部族にしたがって十二の石の柱を立てた。","tok":[["それ"],["で"],["、"],["モーセ"],["は"],["主","ぬし"],["の"],["ことば"],["を"],["、"],["ことごとく"],["書きしるした","かきしるした"],["。"],["そう"],["して"],["モーセ"],["は"],["、"],["翌朝","よくあさ"],["早く","はやく"],["、"],["山","やま"],["の"],["ふもと"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["また"],["イスラエル"],["の"],["十二","じゅうに"],["部族","ぶぞく"],["に"],["したがって"],["十二","じゅうに"],["の"],["石","いし"],["の"],["柱","はしら"],["を"],["立てた","たてた"],["。"]]},{"verse":5,"text":"それから、彼はイスラエル人の若者たちを遣わしたので、彼らは全焼のいけにえをささげ、また、和解のいけにえとして雄牛を主にささげた。","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["イスラエル"],["人","にん"],["の"],["若者","わかもの"],["たち"],["を"],["遣わした","つかわした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["また"],["、"],["和解","わかい"],["の"],["いけにえ"],["として"],["雄牛","おうし"],["を"],["主に","おもに"],["ささげた"],["。"]]},{"verse":6,"text":"モーセはその血の半分を取って、鉢に入れ、残りの半分を祭壇に注ぎかけた。","tok":[["モーセ"],["は"],["その"],["血","ち"],["の"],["半分","はんぶん"],["を"],["取って","とって"],["、"],["鉢","ばち"],["に"],["入れ","いれ"],["、"],["残り","のこり"],["の"],["半分","はんぶん"],["を"],["祭壇","さいだん"],["に"],["注ぎ","そそぎ"],["かけた"],["。"]]},{"verse":7,"text":"そして、契約の書を取り、民に読んで聞かせた。すると、彼らは言った。「主の仰せられたことはみな行い、聞き従います。」","tok":[["そして"],["、"],["契約","けいやく"],["の"],["書","しょ"],["を"],["取り","とり"],["、"],["民","みん"],["に"],["読んで","よんで"],["聞かせた","きかせた"],["。"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["仰せられた","おおせられた"],["こと"],["は"],["みな"],["行い","おこない"],["、"],["聞き従います","ききしたがいます"],["。"],["」"]]},{"verse":8,"text":"そこで、モーセはその血を取って、民に注ぎかけ、そして言った。「見よ。これは、これらすべてのことばに関して、主があなたがたと結ばれる契約の血である。」","tok":[["そこ"],["で"],["、"],["モーセ"],["は"],["その"],["血","ち"],["を"],["取って","とって"],["、"],["民","みん"],["に"],["注ぎ","そそぎ"],["かけ"],["、"],["そして"],["言った","いった"],["。"],["「"],["見","み"],["よ"],["。"],["これ"],["は"],["、"],["これ"],["ら"],["すべて"],["の"],["ことば"],["に関して","にかんして"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["と"],["結ばれる","むすばれる"],["契約","けいやく"],["の"],["血","ち"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"それからモーセとアロン、ナダブとアビフ、それにイスラエルの長老七十人は上って行った。","tok":[["それ"],["から"],["モーセ"],["と"],["アロン"],["、"],["ナダブ"],["と"],["アビフ"],["、"],["それ"],["に"],["イスラエル"],["の"],["長老","ちょうろう"],["七","なな"],["十人","じゅうにん"],["は"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":10,"text":"そうして、彼らはイスラエルの神を仰ぎ見た。御足の下にはサファイヤを敷いたようなものがあり、透き通っていて青空のようであった。","tok":[["そう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["神","かみ"],["を"],["仰ぎ見た","あおぎみた"],["。"],["御足","おあし"],["の"],["下","した"],["に"],["は"],["サファイヤ"],["を"],["敷いた","しいた"],["よう"],["な"],["もの"],["が"],["あり"],["、"],["透き通って","すきとおって"],["いて"],["青空","あおぞら"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":11,"text":"神はイスラエル人の指導者たちに手を下されなかったので、彼らは神を見、しかも飲み食いをした。","tok":[["神","かみ"],["は"],["イスラエル"],["人","にん"],["の"],["指導者","しどうしゃ"],["たち"],["に"],["手","て"],["を"],["下されなかった","くだされなかった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["を"],["見","み"],["、"],["しかも"],["飲み食い","のみくい"],["を"],["した"],["。"]]},{"verse":12,"text":"主はモーセに仰せられた。「山へ行き、わたしのところに上り、そこにおれ。彼らを教えるために、わたしが書きしるしたおしえと命令の石の板をあなたに授けよう。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["山","やま"],["へ"],["行き","いき"],["、"],["わたし"],["の"],["ところ"],["に"],["上り","のぼり"],["、"],["そこ"],["に"],["おれ"],["。"],["彼","かれ"],["ら"],["を"],["教える","おしえる"],["ため"],["に"],["、"],["わたし"],["が"],["書きしるした","かきしるした"],["おしえ"],["と"],["命令","めいれい"],["の"],["石","いし"],["の"],["板","いた"],["を"],["あなた"],["に"],["授けよう","さずけよう"],["。"],["」"]]},{"verse":13,"text":"そこで、モーセとその従者ヨシュアは立ち上がり、モーセは神の山に登った。","tok":[["そこ"],["で"],["、"],["モーセ"],["と"],["その"],["従者","じゅうしゃ"],["ヨシュア"],["は"],["立ち上がり","たちあがり"],["、"],["モーセ"],["は"],["神","かみ"],["の"],["山","やま"],["に"],["登った","のぼった"],["。"]]},{"verse":14,"text":"彼は長老たちに言った。「私たちがあなたがたのところに帰って来るまで、ここにいなさい。ここに、アロンとフルとがあなたがたといっしょにいます。訴え事のある者は、だれでも彼らに告げるようにしなさい。」","tok":[["彼","かれ"],["は"],["長老","ちょうろう"],["たち"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["の"],["ところ"],["に"],["帰って","かえって"],["来る","くる"],["まで"],["、"],["ここ"],["に"],["い"],["なさい"],["。"],["ここ"],["に"],["、"],["アロン"],["と"],["フル"],["と"],["が"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["います"],["。"],["訴え","うったえ"],["事","こと"],["の"],["ある"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["彼","かれ"],["ら"],["に"],["告げる","つげる"],["よう"],["に"],["し"],["なさい"],["。"],["」"]]},{"verse":15,"text":"モーセが山に登ると、雲が山をおおった。","tok":[["モーセ"],["が"],["山","やま"],["に"],["登る","のぼる"],["と"],["、"],["雲","くも"],["が"],["山","やま"],["を"],["おおった"],["。"]]},{"verse":16,"text":"主の栄光はシナイ山の上にとどまり、雲は六日間、山をおおっていた。七日目に主は雲の中からモーセを呼ばれた。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["は"],["シナイ"],["山","やま"],["の"],["上","うえ"],["に"],["とどまり"],["、"],["雲","くも"],["は"],["六","むい"],["日間","かかん"],["、"],["山","やま"],["を"],["おおって"],["いた"],["。"],["七日目","ななかめ"],["に"],["主","ぬし"],["は"],["雲","くも"],["の"],["中","なか"],["から"],["モーセ"],["を"],["呼ばれた","よばれた"],["。"]]},{"verse":17,"text":"主の栄光は、イスラエル人の目には、山の頂で燃え上がる火のように見えた。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["は"],["、"],["イスラエル"],["人","にん"],["の"],["目","め"],["に"],["は"],["、"],["山","やま"],["の"],["頂","いただき"],["で"],["燃え上がる","もえあがる"],["火","ひ"],["の"],["よう"],["に"],["見えた","みえた"],["。"]]},{"verse":18,"text":"モーセは雲の中に入って行き、山に登った。そして、モーセは四十日四十夜、山にいた。","tok":[["モーセ"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["入って","はいって"],["行き","いき"],["、"],["山","やま"],["に"],["登った","のぼった"],["。"],["そして"],["、"],["モーセ"],["は"],["四十日","よんとうか"],["四十","よんじゅう"],["夜","よる"],["、"],["山","やま"],["に"],["いた"],["。"]]}]
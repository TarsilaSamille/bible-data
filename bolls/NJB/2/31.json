[{"verse":1,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「見よ。わたしは、ユダ部族のフルの子であるウリの子ベツァルエルを名ざして召し、","tok":[["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["ユダ"],["部族","ぶぞく"],["の"],["フル"],["の"],["子","こ"],["で"],["ある"],["ウリ"],["の"],["子","こ"],["ベツァルエル"],["を"],["名ざし","なざし"],["て"],["召し","めし"],["、"]]},{"verse":3,"text":"彼に知恵と英知と知識とあらゆる仕事において、神の霊を満たした。","tok":[["彼","かれ"],["に"],["知恵","ちえ"],["と"],["英知","えいち"],["と"],["知識","ちしき"],["と"],["あらゆる"],["仕事","しごと"],["に"],["おいて"],["、"],["神","かみ"],["の"],["霊","れい"],["を"],["満たした","みたした"],["。"]]},{"verse":4,"text":"それは、彼が、金や銀や青銅の細工を巧みに設計し、","tok":[["それ"],["は"],["、"],["彼","かれ"],["が"],["、"],["金","きん"],["や"],["銀","ぎん"],["や"],["青銅","せいどう"],["の"],["細工","さいく"],["を"],["巧み","たくみ"],["に"],["設計","せっけい"],["し"],["、"]]},{"verse":5,"text":"はめ込みの宝石を彫り、木を彫刻し、あらゆる仕事をするためである。","tok":[["はめ込み","はめこみ"],["の"],["宝石","ほうせき"],["を"],["彫り","ほり"],["、"],["木","き"],["を"],["彫刻","ちょうこく"],["し"],["、"],["あらゆる"],["仕事","しごと"],["を"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"見よ。わたしは、ダン部族のアヒサマクの子オホリアブを、彼のもとに任命した。わたしはすべて心に知恵のある者に知恵を授けた。彼らはわたしがあなたに命じたものを、ことごとく作る。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["ダン"],["部族","ぶぞく"],["の"],["アヒサマク"],["の"],["子","こ"],["オホリアブ"],["を"],["、"],["彼","かれ"],["の"],["もと"],["に"],["任命","にんめい"],["した"],["。"],["わたし"],["は"],["すべて"],["心","こころ"],["に"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["に"],["知恵","ちえ"],["を"],["授けた","さずけた"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["あなた"],["に"],["命じた","めいじた"],["もの"],["を"],["、"],["ことごとく"],["作る","つくる"],["。"]]},{"verse":7,"text":"すなわち、会見の天幕、あかしの箱、その上の『贖いのふた』、天幕のあらゆる設備品、","tok":[["すなわち"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["、"],["あかし"],["の"],["箱","ばこ"],["、"],["その"],["上","うえ"],["の"],["『"],["贖い","あがない"],["の"],["ふた"],["』"],["、"],["天幕","てんまく"],["の"],["あらゆる"],["設備品","せつびひん"],["、"]]},{"verse":8,"text":"机とその付属品、純金の燭台と、そのいろいろな器具、香の壇、","tok":[["机","つくえ"],["と"],["その"],["付属品","ふぞくひん"],["、"],["純金","じゅんきん"],["の"],["燭台","しょくだい"],["と"],["、"],["その"],["いろいろ"],["な"],["器具","きぐ"],["、"],["香","こう"],["の"],["壇","だん"],["、"]]},{"verse":9,"text":"全焼のいけにえの祭壇と、そのあらゆる道具、洗盤とその台、","tok":[["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["祭壇","さいだん"],["と"],["、"],["その"],["あらゆる"],["道具","どうぐ"],["、"],["洗","あらい"],["盤","ばん"],["と"],["その"],["台","だい"],["、"]]},{"verse":10,"text":"式服、すなわち、祭司として仕える祭司アロンの聖なる装束と、その子らの装束、","tok":[["式服","しきふく"],["、"],["すなわち"],["、"],["祭司","さいし"],["として"],["仕える","つかえる"],["祭司","さいし"],["アロン"],["の"],["聖","せい"],["なる"],["装束","しょうぞく"],["と"],["、"],["その"],["子","こ"],["ら"],["の"],["装束","しょうぞく"],["、"]]},{"verse":11,"text":"そそぎの油、聖所のためのかおりの高い香である。彼らは、すべて、わたしがあなたに命じたとおりに作らなければならない。」","tok":[["そそぎ"],["の"],["油","あぶら"],["、"],["聖","せい"],["所","しょ"],["の"],["ため"],["の"],["かおり"],["の"],["高い","たかい"],["香","かおり"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["すべて"],["、"],["わたし"],["が"],["あなた"],["に"],["命じた","めいじた"],["とおり"],["に"],["作らなければ","つくらなければ"],["ならない"],["。"],["」"]]},{"verse":12,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":13,"text":"「あなたはイスラエル人に告げて言え。／あなたがたは、必ずわたしの安息を守らなければならない。これは、代々にわたり、わたしとあなたがたとの間のしるし、わたしがあなたがたを聖別する主であることを、あなたがたが知るためのものなのである。","tok":[["「"],["あなた"],["は"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["必ず","かならず"],["わたし"],["の"],["安息","あんそく"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["これ"],["は"],["、"],["代々","だいだい"],["に"],["わたり"],["、"],["わたし"],["と"],["あなた"],["がた"],["と"],["の"],["間","あいだ"],["の"],["しるし"],["、"],["わたし"],["が"],["あなた"],["がた"],["を"],["聖別","せいべつ"],["する"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["、"],["あなた"],["がた"],["が"],["知る","しる"],["ため"],["の"],["もの"],["な"],["ので"],["ある"],["。"]]},{"verse":14,"text":"これは、あなたがたにとって聖なるものであるから、あなたがたはこの安息を守らなければならない。これを汚す者は必ず殺されなければならない。この安息中に仕事をする者は、だれでも、その民から断ち切られる。","tok":[["これ"],["は"],["、"],["あなた"],["がた"],["にとって"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["から"],["、"],["あなた"],["がた"],["は"],["この"],["安息","あんそく"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["これ"],["を"],["汚す","けがす"],["者","もの"],["は"],["必ず","かならず"],["殺されなければ","ころされなければ"],["ならない"],["。"],["この"],["安息中","あんそくちゅう"],["に"],["仕事","しごと"],["を"],["する"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["、"],["その"],["民","たみ"],["から"],["断ち切られる","たちきられる"],["。"]]},{"verse":15,"text":"六日間は仕事をしてもよい。しかし、七日目は、主の聖なる全き休みの安息日である。安息の日に仕事をする者は、だれでも必ず殺されなければならない。","tok":[["六","むい"],["日間","かかん"],["は"],["仕事","しごと"],["を"],["して"],["も"],["よい"],["。"],["しかし"],["、"],["七日目","ななかめ"],["は"],["、"],["主","ぬし"],["の"],["聖","せい"],["なる"],["全","ぜん"],["き"],["休み","やすみ"],["の"],["安息日","あんそくび"],["で"],["ある"],["。"],["安息","あんそく"],["の"],["日","ひ"],["に"],["仕事","しごと"],["を"],["する"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["必ず","かならず"],["殺されなければ","ころされなければ"],["ならない"],["。"]]},{"verse":16,"text":"イスラエル人はこの安息を守り、永遠の契約として、代々にわたり、この安息を守らなければならない。","tok":[["イスラエル"],["人","にん"],["は"],["この"],["安息","あんそく"],["を"],["守り","まもり"],["、"],["永遠","えいえん"],["の"],["契約","けいやく"],["として"],["、"],["代々","だいだい"],["に"],["わたり"],["、"],["この"],["安息","あんそく"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":17,"text":"これは、永遠に、わたしとイスラエル人との間のしるしである。それは主が六日間に天と地とを造り、七日目に休み、いこわれたからである。」","tok":[["これ"],["は"],["、"],["永遠","えいえん"],["に"],["、"],["わたし"],["と"],["イスラエル"],["人","にん"],["と"],["の"],["間","あいだ"],["の"],["しるし"],["で"],["ある"],["。"],["それ"],["は"],["主","ぬし"],["が"],["六","むい"],["日間","かかん"],["に"],["天","てん"],["と"],["地","ち"],["と"],["を"],["造り","つくり"],["、"],["七日目","ななかめ"],["に"],["休み","やすみ"],["、"],["いこわれた"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":18,"text":"こうして主は、シナイ山でモーセと語り終えられたとき、あかしの板二枚、すなわち、神の指で書かれた石の板をモーセに授けられた。","tok":[["こう"],["して"],["主","ぬし"],["は"],["、"],["シナイ"],["山","やま"],["で"],["モーセ"],["と"],["語り","かたり"],["終えられた","おえられた"],["とき"],["、"],["あかし"],["の"],["板","いた"],["二枚","にまい"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["指","ゆび"],["で"],["書かれた","かかれた"],["石","いし"],["の"],["板","いた"],["を"],["モーセ"],["に"],["授けられた","さずけられた"],["。"]]}]
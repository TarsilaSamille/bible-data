[{"verse":1,"text":"ついで、イスラエル人の全会衆は、エリムから旅立ち、エジプトの地を出て、第二の月の十五日に、エリムとシナイとの間にあるシンの荒野に入った。","tok":[["つい"],["で"],["、"],["イスラエル"],["人","にん"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["エリム"],["から"],["旅立ち","たびだち"],["、"],["エジプト"],["の"],["地","ち"],["を"],["出て","でて"],["、"],["第","だい"],["二","に"],["の"],["月","つき"],["の"],["十五","じゅうご"],["日","にち"],["に"],["、"],["エリム"],["と"],["シナイ"],["と"],["の"],["間","あいだ"],["に"],["ある"],["シン"],["の"],["荒野","あらの"],["に"],["入った","はいった"],["。"]]},{"verse":2,"text":"そのとき、イスラエル人の全会衆は、この荒野でモーセとアロンにつぶやいた。","tok":[["その"],["とき"],["、"],["イスラエル"],["人","にん"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["この"],["荒野","こうや"],["で"],["モーセ"],["と"],["アロン"],["に"],["つぶやいた"],["。"]]},{"verse":3,"text":"イスラエル人は彼らに言った。「エジプトの地で、肉なべのそばにすわり、パンを満ち足りるまで食べていたときに、私たちは主の手にかかって死んでいたらよかったのに。事実、あなたがたは、私たちをこの荒野に連れ出して、この全集団を飢え死にさせようとしているのです。」","tok":[["イスラエル"],["人","にん"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["エジプト"],["の"],["地","ち"],["で"],["、"],["肉","にく"],["なべ"],["の"],["そば"],["に"],["すわり"],["、"],["パン"],["を"],["満ち足りる","みちたりる"],["まで"],["食べて","たべて"],["いた"],["とき"],["に"],["、"],["私たち","わたしたち"],["は"],["主","ぬし"],["の"],["手","て"],["に"],["かかって"],["死んで","しんで"],["いたら"],["よかった"],["のに"],["。"],["事実","じじつ"],["、"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["を"],["この"],["荒野","こうや"],["に"],["連れ出して","つれだして"],["、"],["この"],["全","ぜん"],["集団","しゅうだん"],["を"],["飢え死に","うえじに"],["させよう"],["として"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":4,"text":"主はモーセに仰せられた。「見よ。わたしはあなたがたのために、パンが天から降るようにする。民は外に出て、毎日、一日分を集めなければならない。これは、彼らがわたしのおしえに従って歩むかどうかを、試みるためである。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["パン"],["が"],["天","てん"],["から"],["降る","ふる"],["よう"],["に"],["する"],["。"],["民","たみ"],["は"],["外","そと"],["に"],["出て","でて"],["、"],["毎日","まいにち"],["、"],["一","いち"],["日","にち"],["分","ぶん"],["を"],["集めなければ","あつめなければ"],["ならない"],["。"],["これ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["おしえ"],["に"],["従って","したがって"],["歩む","あゆむ"],["か"],["どう"],["か"],["を"],["、"],["試みる","こころみる"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"六日目に、彼らが持って来た物を整える場合、日ごとに集める分の二倍とする。」","tok":[["六日目","むいかめ"],["に"],["、"],["彼","かれ"],["ら"],["が"],["持って","もって"],["来た","きた"],["物","もの"],["を"],["整える","ととのえる"],["場合","ばあい"],["、"],["日ごと","ひごと"],["に"],["集める","あつめる"],["分","ぶん"],["の"],["二","に"],["倍","ばい"],["と"],["する"],["。"],["」"]]},{"verse":6,"text":"それでモーセとアロンは、すべてのイスラエル人に言った。「夕方には、あなたがたは、主がエジプトの地からあなたがたを連れ出されたことを知り、","tok":[["それ"],["で"],["モーセ"],["と"],["アロン"],["は"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["に"],["言った","いった"],["。"],["「"],["夕方","ゆうがた"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["主","ぬし"],["が"],["エジプト"],["の"],["地","ち"],["から"],["あなた"],["がた"],["を"],["連れ出された","つれだされた"],["こと"],["を"],["知り","しり"],["、"]]},{"verse":7,"text":"朝には、主の栄光を見る。主に対するあなたがたのつぶやきを主が聞かれたのです。あなたがたが、この私たちにつぶやくとは、いったい私たちは何なのだろう。」","tok":[["朝","あさ"],["に"],["は"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["を"],["見る","みる"],["。"],["主に","おもに"],["対する","たいする"],["あなた"],["がた"],["の"],["つぶやき"],["を"],["主","ぬし"],["が"],["聞かれた","きかれた"],["の"],["です"],["。"],["あなた"],["が"],["た"],["が"],["、"],["この"],["私たち","わたしたち"],["に"],["つぶやく"],["と"],["は"],["、"],["いったい"],["私たち","わたしたち"],["は"],["何","なん"],["な"],["の"],["だろう"],["。"],["」"]]},{"verse":8,"text":"モーセはまた言った。「夕方には、主があなたがたに食べる肉を与え、朝には満ち足りるほどパンを与えてくださるのは、あなたがたが主に対してつぶやく、そのつぶやきを主が聞かれたからです。いったい私たちは何なのだろうか。あなたがたのつぶやきは、この私たちに対してではなく、主に対してなのです。」","tok":[["モーセ"],["は"],["また"],["言った","いった"],["。"],["「"],["夕方","ゆうがた"],["に"],["は"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["に"],["食べる","たべる"],["肉","にく"],["を"],["与え","あたえ"],["、"],["朝","あさ"],["に"],["は"],["満ち足りる","みちたりる"],["ほど"],["パン"],["を"],["与えて","あたえて"],["くださる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["主","ぬし"],["に対して","にたいして"],["つぶやく"],["、"],["その"],["つぶやき"],["を"],["主","ぬし"],["が"],["聞かれた","きかれた"],["から"],["です"],["。"],["いったい"],["私たち","わたしたち"],["は"],["何","なん"],["な"],["の"],["だろう"],["か"],["。"],["あなた"],["がた"],["の"],["つぶやき"],["は"],["、"],["この"],["私たち","わたしたち"],["に対して","にたいして"],["で"],["は"],["なく"],["、"],["主に","おもに"],["対して
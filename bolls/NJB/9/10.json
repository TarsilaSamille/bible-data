[{"verse":1,"text":"サムエルは油のつぼを取ってサウルの頭にそそぎ、彼に口づけして言った。「主が、ご自身のものである民の君主として、あなたに油をそそがれたではありませんか。2あなたが、きょう、私のもとを離れて行くとき、ベニヤミンの領内のツェルツァフにあるラケルの墓のそばで、ふたりの人に会いましょう。そのふたりはあなたに、『あなたが捜して歩いておられるあの雌ろばは見つかりました。ところで、あなたの父上は、雌ろばのことなどあきらめて、息子のために、どうしたらよかろうと言って、あなたがたのことを心配しておられます』と言うでしょう。","tok":[["サムエル"],["は"],["油","あぶら"],["の"],["つぼ"],["を"],["取って","とって"],["サウル"],["の"],["頭","あたま"],["に"],["そそぎ"],["、"],["彼","かれ"],["に"],["口づけ","くちづけ"],["して"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["、"],["ご自身","ごじしん"],["の"],["もの"],["で"],["ある"],["民","たみ"],["の"],["君主","くんしゅ"],["として"],["、"],["あなた"],["に"],["油","あぶら"],["を"],["そそがれたで"],["は"],["ありません"],["か"],["。"],["2"],["あなた"],["が"],["、"],["きょう"],["、"],["私","わたくし"],["の"],["もと"],["を"],["離れて","はなれて"],["行く","いく"],["とき"],["、"],["ベニヤミン"],["の"],["領内","りょうない"],["の"],["ツェルツァフ"],["に"],["ある"],["ラケル"],["の"],["墓","はか"],["の"],["そば"],["で"],["、"],["ふたり"],["の"],["人","ひと"],["に"],["会いましょう","あいましょう"],["。"],["その"],["ふたり"],["は"],["あなた"],["に"],["、"],["『"],["あなた"],["が"],["捜して","さがして"],["歩いて","あるいて"],["おられる"],["あの"],["雌","めす"],["ろば"],["は"],["見つかりました","みつかりました"],["。"],["ところ"],["で"],["、"],["あなた"],["の"],["父上","ちちじょう"],["は"],["、"],["雌","めす"],["ろば"],["の"],["こと"],["など"],["あきらめて"],["、"],["息子","むすこ"],["の"],["ため"],["に"],["、"],["どう"],["したら"],["よかろう"],["と"],["言って","いって"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["心配","しんぱい"],["して"],["おられます"],["』"],["と"],["言うでしょう","ゆうでしょう"],["。"]]},{"verse":2,"text":"-","tok":[["-"]]},{"verse":3,"text":"あなたがそこからなお進んで、タボルの樫の木のところまで来ると、そこでベテルの神のもとに上って行く三人の人に会います。ひとりは子やぎ三頭を持ち、ひとりは丸型のパン三つを持ち、ひとりはぶどう酒の皮袋一つを持っています。","tok":[["あなた"],["が"],["そこ"],["から"],["なお"],["進んで","すすんで"],["、"],["タボル"],["の"],["樫","かし"],["の"],["木","き"],["の"],["ところ"],["まで"],["来る","くる"],["と"],["、"],["そこ"],["で"],["ベテル"],["の"],["神","かみ"],["の"],["もと"],["に"],["上って","のぼって"],["行く","いく"],["三人","さんにん"],["の"],["人","ひと"],["に"],["会います","あいます"],["。"],["ひとり"],["は"],["子やぎ","こやぎ"],["三頭","さんとう"],["を"],["持ち","もち"],["、"],["ひとり"],["は"],["丸型","まるがた"],["の"],["パン"],["三","みっ"],["つ"],["を"],["持ち","もち"],["、"],["ひとり"],["は"],["ぶどう酒","ぶどうしゅ"],["の"],["皮袋","かわぶくろ"],["一","ひと"],["つ"],["を"],["持って","もって"],["います"],["。"]]},{"verse":4,"text":"彼らはあなたに安否を尋ね、あなたにパンを二つくれます。あなたは彼らの手から受け取りなさい。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["に"],["安否","あんぴ"],["を"],["尋ね","たずね"],["、"],["あなた"],["に"],["パン"],["を"],["二","ふた"],["つ"],["くれます"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["受け取り","うけとり"],["なさい"],["。"]]},{"verse":5,"text":"その後、ペリシテ人の守備隊のいる神のギブアに着きます。あなたがその町に入るとき、琴、タンバリン、笛、立琴を鳴らす者を先頭に、高き所から降りて来る預言者の一団に出会います。彼らは預言をしていますが、","tok":[["その"],["後","ご"],["、"],["ペリシテ"],["人","にん"],["の"],["守備隊","しゅびたい"],["の"],["いる"],["神","かみ"],["の"],["ギブア"],["に"],["着きます","つきます"],["。"],["あなた"],["が"],["その"],["町","まち"],["に"],["入る","はいる"],["とき"],["、"],["琴","こと"],["、"],["タンバリン"],["、"],["笛","ふえ"],["、"],["立琴","たてごと"],["を"],["鳴らす","ならす"],["者","もの"],["を"],["先頭","せんとう"],["に"],["、"],["高き","たかき"],["所","ところ"],["から"],["降りて","おりて"],["来る","くる"],["預言者","よげんしゃ"],["の"],["一団","いちだん"],["に"],["出会います","であいます"],["。"],["彼","かれ"],["ら"],["は"],["預言","よげん"],["を"],["して"],["います"],["が"],["、"]]},{"verse":6,"text":"主の霊があなたの上に激しく下ると、あなたも彼らといっしょに預言して、あなたは新しい人に変えられます。","tok":[["主","ぬし"],["の"],["霊","れい"],["が"],["あなた"],["の"],["上","うえ"],["に"],["激しく","はげしく"],["下る","くだる"],["と"],["、"],["あなた"],["も"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["預言","よげん"],["して"],["、"],["あなた"],["は"],["新しい","あたらしい"],["人","ひと"],["に"],["変えられます","かえられます"],["。"]]},{"verse":7,"text":"このしるしがあなたに起こったら、手当たりしだいに何でもしなさい。神があなたとともにおられるからです。","tok":[["この"],["しるし"],["が"],["あなた"],["に"],["起こったら","おこったら"],["、"],["手当たり","てあたり"],["しだい"],["に"],["何","なん"],["で"],["も"],["し"],["なさい"],["。"],["神","かみ"],["が"],["あなた"],["と"],["とも"],["に"],["おられる"],["から"],["です"],["。"]]},{"verse":8,"text":"あなたは私より先にギルガルに下りなさい。私も全焼のいけにえと和解のいけにえとをささげるために、あなたのところへ下って行きます。あなたは私が着くまで七日間、そこで待たなければなりません。私がなすべきことを教えます。」","tok":[["あなた"],["は"],["私","わたくし"],["より"],["先","さき"],["に"],["ギルガル"],["に"],["下り","おり"],["なさい"],["。"],["私","わたくし"],["も"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["和解","わかい"],["の"],["いけにえ"],["と"],["を"],["ささげる"],["ため"],["に"],["、"],["あなた"],["の"],["ところ"],["へ"],["下って","くだって"],["行きます","いきます"],["。"],["あなた"],["は"],["私","わたくし"],["が"],["着く","つく"],["まで"],["七","なな"],["日間","かかん"],["、"],["そこ"],["で"],["待たなければ","またなければ"],["なりません"],["。"],["私","わたくし"],["が"],["なすべき"],["こと"],["を"],["教えます","おしえます"],["。"],["」"]]},{"verse":9,"text":"サウルがサムエルをあとにして去って行ったとき、神はサウルの心を変えて新しくされた。こうして、これらすべてのしるしは、その日に起こった。","tok":[["サウル"],["が"],["サムエル"],["を"],["あと"],["に"],["して"],["去って","さって"],["行った","いった"],["とき"],["、"],["神","かみ"],["は"],["サウル"],["の"],["心","こころ"],["を"],["変えて","かえて"],["新しく","あたらしく"],["された"],["。"],["こう"],["して"],["、"],["これ"],["ら"],["すべて"],["の"],["しるし"],["は"],["、"],["その"],["日","ひ"],["に"],["起こった","おこった"],["。"]]},{"verse":10,"text":"彼らがそこ、ギブアに着くと、なんと、預言者の一団が彼に出会い、神の霊が彼の上に激しく下った。それで彼も彼らの間で預言を始めた。","tok":[["彼","かれ"],["ら"],["が"],["そこ"],["、"],["ギブア"],["に"],["着く","つく"],["と"],["、"],["なん"],["と"],["、"],["預言者","よげんしゃ"],["の"],["一団","いちだん"],["が"],["彼","かれ"],["に"],["出会い","であい"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["激しく","はげしく"],["下った","くだった"],["。"],["それ"],["で"],["彼","かれ"],["も"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["預言","よげん"],["を"],["始めた","はじめた"],["。"]]},{"verse":11,"text":"以前からサウルを知っている者みなが、彼が預言者たちといっしょに預言しているのを見た。民は互いに言った。「キシュの息子は、いったいどうしたことか。サウルもまた、預言者のひとりなのか。」","tok":[["以前","いぜん"],["から"],["サウル"],["を"],["知って","しって"],["いる"],["者","もの"],["みな"],["が"],["、"],["彼","かれ"],["が"],["預言者","よげんしゃ"],["たち"],["と"],["いっしょ"],["に"],["預言","よげん"],["して"],["いる"],["の"],["を"],["見た","みた"],["。"],["民","たみ"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["キシュ"],["の"],["息子","むすこ"],["は"],["、"],["いったい"],["どう"],["した"],["こと"],["か"],["。"],["サウル"],["も"],["また"],["、"],["預言者","よげんしゃ"],["の"],["ひとり"],["な"],["の"],["か"],["。"],["」"]]},{"verse":12,"text":"そこにいたひとりも、これに応じて、「彼らの父はだれだろう」と言った。こういうわけで、「サウルもまた、預言者のひとりなのか」ということが、ことわざになった。","tok":[["そこ"],["に"],["いた"],["ひとり"],["も"],["、"],["これ"],["に"],["応じて","おうじて"],["、"],["「"],["彼","かれ"],["ら"],["の"],["父","ちち"],["は"],["だれ"],["だろう"],["」"],["と"],["言った","いった"],["。"],["こう"],["いう"],["わけ"],["で"],["、"],["「"],["サウル"],["も"],["また"],["、"],["預言者","よげんしゃ"],["の"],["ひとり"],["な"],["の"],["か"],["」"],["と"],["いう"],["こと"],["が"],["、"],["ことわざ"],["に"],["なった"],["。"]]},{"verse":13,"text":"サウルは預言することを終えて、高き所に行った。","tok":[["サウル"],["は"],["預言","よげん"],["する"],["こと"],["を"],["終えて","おえて"],["、"],["高き","たかき"],["所","ところ"],["に"],["行った","いった"],["。"]]},{"verse":14,"text":"サウルのおじは、彼とその若い者に言った。「どこへ行っていたのか。」するとサウルは答えた。「雌ろばを捜しにです。見つからないのでサムエルのところに行って来ました。」","tok":[["サウル"],["の"],["おじ"],["は"],["、"],["彼","かれ"],["と"],["その"],["若い","わかい"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["どこ"],["へ"],["行って","いって"],["いた"],["の"],["か"],["。"],["」"],["する"],["と"],["サウル"],["は"],["答えた","こたえた"],["。"],["「"],["雌","めす"],["ろば"],["を"],["捜し","さがし"],["に"],["です"],["。"],["見つからない","みつからない"],["ので"],["サムエル"],["の"],["ところ"],["に"],["行って","いって"],["来ました","きました"],["。"],["」"]]},{"verse":15,"text":"サウルのおじは言った。「サムエルはあなたがたに何と言ったか、私に話してくれ。」","tok":[["サウル"],["の"],["おじ"],["は"],["言った","いった"],["。"],["「"],["サムエル"],["は"],["あなた"],["がた"],["に"],["何","なん"],["と"],["言った","いった"],["か"],["、"],["私","わたくし"],["に"],["話して","はなして"],["くれ"],["。"],["」"]]},{"verse":16,"text":"サウルはおじに言った。「雌ろばは見つかっていると、はっきり私たちに知らせてくれました。」サウルは、サムエルが語った王位のことについては、おじに話さなかった。","tok":[["サウル"],["は"],["おじ"],["に"],["言った","いった"],["。"],["「"],["雌","めす"],["ろば"],["は"],["見つかって","みつかって"],["いる"],["と"],["、"],["はっきり"],["私たち","わたしたち"],["に"],["知らせて","しらせて"],["くれました"],["。"],["」"],["サウル"],["は"],["、"],["サムエル"],["が"],["語った","かたった"],["王位","おうい"],["の"],["こと"],["について"],["は"],["、"],["おじ"],["に"],["話さなかった","はなさなかった"],["。"]]},{"verse":17,"text":"サムエルはミツパで、民を主のもとに呼び集め、","tok":[["サムエル"],["は"],["ミツパ"],["で"],["、"],["民","みん"],["を"],["主","ぬし"],["の"],["もと"],["に"],["呼び集め","よびあつめ"],["、"]]},{"verse":18,"text":"イスラエル人に言った。「イスラエルの神、主はこう仰せられる。『わたしはイスラエルをエジプトから連れ上り、あなたがたを、エジプトの手と、あなたがたをしいたげていたすべての王国の手から、救い出した。』","tok":[["イスラエル"],["人","にん"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["は"],["イスラエル"],["を"],["エジプト"],["から"],["連れ上り","つれのぼり"],["、"],["あなた"],["がた"],["を"],["、"],["エジプト"],["の"],["手","て"],["と"],["、"],["あなた"],["がた"],["を"],["しいたげて"],["いた"],["すべて"],["の"],["王国","おうこく"],["の"],["手","て"],["から"],["、"],["救い出した","すくいだした"],["。"],["』"]]},{"verse":19,"text":"ところで、あなたがたはきょう、すべてのわざわいと苦しみからあなたがたを救ってくださる、あなたがたの神を退けて、『いや、私たちの上に王を立ててください』と言った。今、あなたがたは、部族ごとに、分団ごとに、主の前に出なさい。」","tok":[["ところ"],["で"],["、"],["あなた"],["がた"],["は"],["きょう"],["、"],["すべて"],["の"],["わざわい"],["と"],["苦しみ","くるしみ"],["から"],["あなた"],["がた"],["を"],["救って","すくって"],["くださる"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["を"],["退けて","しりぞけて"],["、"],["『"],["いや"],["、"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立てて","たてて"],["ください"],["』"],["と"],["言った","いった"],["。"],["今","いま"],["、"],["あなた"],["がた"],["は"],["、"],["部族","ぶぞく"],["ごと"],["に"],["、"],["分団","ぶんだん"],["ごと"],["に"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["出","で"],["なさい"],["。"],["」"]]},{"verse":20,"text":"こうしてサムエルは、イスラエルの全部族を近づけた。するとベニヤミンの部族がくじで取り分けられた。","tok":[["こう"],["して"],["サムエル"],["は"],["、"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["を"],["近づけた","ちかづけた"],["。"],["する"],["と"],["ベニヤミン"],["の"],["部族","ぶぞく"],["が"],["くじ"],["で"],["取り分けられた","とりわけられた"],["。"]]},{"verse":21,"text":"それでベニヤミンの部族を、その氏族ごとに近づけたところ、マテリの氏族が取り分けられ、そしてキシュの子サウルが取り分けられた。そこで人々はサウルを捜したが、見つからなかった。","tok":[["それ"],["で"],["ベニヤミン"],["の"],["部族","ぶぞく"],["を"],["、"],["その"],["氏族","しぞく"],["ごと"],["に"],["近づけた","ちかづけた"],["ところ"],["、"],["マテリ"],["の"],["氏族","しぞく"],["が"],["取り分けられ","とりわけられ"],["、"],["そして"],["キシュ"],["の"],["子","こ"],["サウル"],["が"],["取り分けられた","とりわけられた"],["。"],["そこ"],["で"],["人々","ひとびと"],["は"],["サウル"],["を"],["捜した","さがした"],["が"],["、"],["見つからなかった","みつからなかった"],["。"]]},{"verse":22,"text":"それで人々がまた、主に、「あの人はもう、ここに来ているのですか」と尋ねた。主は、「見よ。彼は荷物の間に隠れている」と言われた。","tok":[["それ"],["で"],["人々","ひとびと"],["が"],["また"],["、"],["主に","おもに"],["、"],["「"],["あの"],["人","ひと"],["は"],["もう"],["、"],["ここ"],["に"],["来て","きて"],["いる"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["主","ぬし"],["は"],["、"],["「"],["見","み"],["よ"],["。"],["彼","かれ"],["は"],["荷物","にもつ"],["の"],["間","あいだ"],["に"],["隠れて","かくれて"],["いる"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":23,"text":"人々は走って行って、そこから彼を連れて来た。サウルが民の中に立つと、民のだれよりも、肩から上だけ高かった。","tok":[["人々","ひとびと"],["は"],["走って","はしって"],["行って","いって"],["、"],["そこ"],["から"],["彼","かれ"],["を"],["連れて","つれて"],["来た","きた"],["。"],["サウル"],["が"],["民","たみ"],["の"],["中","なか"],["に"],["立つ","たつ"],["と"],["、"],["民","みん"],["の"],["だれ"],["より"],["も"],["、"],["肩","かた"],["から"],["上","うえ"],["だけ"],["高かった","たかかった"],["。"]]},{"verse":24,"text":"サムエルは民のすべてに言った。「見よ。主がお選びになったこの人を。民のうちだれも、この人に並ぶ者はいない。」民はみな、喜び叫んで、「王さま。ばんざい」と言った。","tok":[["サムエル"],["は"],["民","みん"],["の"],["すべて"],["に"],["言った","いった"],["。"],["「"],["見","み"],["よ"],["。"],["主","ぬし"],["が"],["お選び","おえらび"],["に"],["なった"],["この"],["人","ひと"],["を"],["。"],["民","たみ"],["の"],["うち"],["だれ"],["も"],["、"],["この"],["人","ひと"],["に"],["並ぶ","ならぶ"],["者","もの"],["は"],["いない"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["喜び叫んで","よろこびさけんで"],["、"],["「"],["王","おう"],["さま"],["。"],["ばんざい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":25,"text":"サムエルは民に王の責任を告げ、それを文書にしるして主の前に納めた。こうしてサムエルは民をみな、それぞれ自分の家へ帰した。","tok":[["サムエル"],["は"],["民","みん"],["に"],["王","おう"],["の"],["責任","せきにん"],["を"],["告げ","つげ"],["、"],["それ"],["を"],["文書","ぶんしょ"],["に"],["しるして"],["主","ぬし"],["の"],["前","まえ"],["に"],["納めた","おさめた"],["。"],["こう"],["して"],["サムエル"],["は"],["民","みん"],["を"],["みな"],["、"],["それぞれ"],["自分","じぶん"],["の"],["家","いえ"],["へ"],["帰した","かえした"],["。"]]},{"verse":26,"text":"サウルもまた、ギブアの自分の家へ帰った。神に心を動かされた勇者は、彼について行った。","tok":[["サウル"],["も"],["また"],["、"],["ギブア"],["の"],["自分","じぶん"],["の"],["家","いえ"],["へ"],["帰った","かえった"],["。"],["神","かみ"],["に"],["心","こころ"],["を"],["動かされた","うごかされた"],["勇者","ゆうしゃ"],["は"],["、"],["彼","かれ"],["について"],["行った","いった"],["。"]]},{"verse":27,"text":"しかし、よこしまな者たちは、「この者がどうしてわれわれを救えよう」と言って軽蔑し、彼に贈り物を持って来なかった。しかしサウルは黙っていた。","tok":[["しかし"],["、"],["よこしま"],["な"],["者","もの"],["たち"],["は"],["、"],["「"],["この"],["者","もの"],["が"],["どう"],["して"],["われわれ"],["を"],["救えよう","すくえよう"],["」"],["と"],["言って","いって"],["軽蔑","けいべつ"],["し"],["、"],["彼","かれ"],["に"],["贈り物","おくりもの"],["を"],["持って","もって"],["来なかった","こなかった"],["。"],["しかし"],["サウル"],
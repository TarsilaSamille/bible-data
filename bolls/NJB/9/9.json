[{"verse":1,"text":"ベニヤミン人で、その名をキシュという人がいた。――キシュはアビエルの子、順次さかのぼって、ツェロルの子、ベコラテの子、アフィアハの子。アフィアハは裕福なベニヤミン人であった――","tok":[["ベニヤミン"],["人","にん"],["で"],["、"],["その"],["名","な"],["を"],["キシュ"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["―"],["―"],["キシュ"],["は"],["アビエル"],["の"],["子","こ"],["、"],["順次","じゅんじ"],["さかのぼって"],["、"],["ツェロル"],["の"],["子","こ"],["、"],["ベコラテ"],["の"],["子","こ"],["、"],["アフィアハ"],["の"],["子","こ"],["。"],["アフィアハ"],["は"],["裕福","ゆうふく"],["な"],["ベニヤミン"],["人","にん"],["で"],["あった"],["―"],["―"]]},{"verse":2,"text":"キシュにはひとりの息子がいて、その名をサウルと言った。彼は美しい若い男で、イスラエル人の中で彼より美しい者はいなかった。彼は民のだれよりも、肩から上だけ高かった。","tok":[["キシュ"],["に"],["は"],["ひとり"],["の"],["息子","むすこ"],["が"],["いて"],["、"],["その"],["名","な"],["を"],["サウル"],["と"],["言った","いった"],["。"],["彼","かれ"],["は"],["美しい","うつくしい"],["若い","わかい"],["男","おとこ"],["で"],["、"],["イスラエル"],["人","にん"],["の"],["中","なか"],["で"],["彼","かれ"],["より"],["美しい","うつくしい"],["者","もの"],["は"],["いなかった"],["。"],["彼","かれ"],["は"],["民","みん"],["の"],["だれ"],["より"],["も"],["、"],["肩","かた"],["から"],["上","うえ"],["だけ"],["高かった","たかかった"],["。"]]},{"verse":3,"text":"あるとき、サウルの父キシュの雌ろばがいなくなった。そこでキシュは、息子サウルに言った。「若い者をひとり連れて、雌ろばを捜しに行ってくれ。」","tok":[["ある"],["とき"],["、"],["サウル"],["の"],["父","ちち"],["キシュ"],["の"],["雌","めす"],["ろば"],["が"],["いなく"],["なった"],["。"],["そこ"],["で"],["キシュ"],["は"],["、"],["息子","むすこ"],["サウル"],["に"],["言った","いった"],["。"],["「"],["若い","わかい"],["者","もの"],["を"],["ひとり"],["連れて","つれて"],["、"],["雌","めす"],["ろば"],["を"],["捜し","さがし"],["に"],["行って","いって"],["くれ"],["。"],["」"]]},{"verse":4,"text":"そこで、彼らはエフライムの山地を巡り、シャリシャの地を巡り歩いたが、見つからなかった。さらに彼らはシャアリムの地を巡り歩いたが、いなかった。ベニヤミン人の地を巡り歩いたが、見つからなかった。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["エフライム"],["の"],["山地","さんち"],["を"],["巡り","めぐり"],["、"],["シャリシャ"],["の"],["地","ち"],["を"],["巡り歩いた","めぐりあるいた"],["が"],["、"],["見つからなかった","みつからなかった"],["。"],["さらに"],["彼","かれ"],["ら"],["は"],["シャアリム"],["の"],["地","ち"],["を"],["巡り歩いた","めぐりあるいた"],["が"],["、"],["いなかった"],["。"],["ベニヤミン"],["人","にん"],["の"],["地","ち"],["を"],["巡り歩いた","めぐりあるいた"],["が"],["、"],["見つからなかった","みつからなかった"],["。"]]},{"verse":5,"text":"彼らがツフの地に来たとき、サウルは連れの若い者に言った。「さあ、もう帰ろう。父が雌ろばのことはさておき、私たちのことを心配するといけないから。」","tok":[["彼","かれ"],["ら"],["が"],["ツフ"],["の"],["地","ち"],["に"],["来た","きた"],["とき"],["、"],["サウル"],["は"],["連れ","つれ"],["の"],["若い","わかい"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["もう"],["帰ろう","かえろう"],["。"],["父","ちち"],["が"],["雌","めす"],["ろば"],["の"],["こと"],["は"],["さておき"],["、"],["私たち","わたしたち"],["の"],["こと"],["を"],["心配","しんぱい"],["する"],["と"],["いけない"],["から"],["。"],["」"]]},{"verse":6,"text":"すると、彼は言った。「待ってください。この町には神の人がいます。この人は敬われている人です。この人の言うことはみな、必ず実現します。今そこへまいりましょう。たぶん、私たちの行くべき道を教えてくれるでしょう。」","tok":[["する"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["待って","まって"],["ください"],["。"],["この"],["町","まち"],["に"],["は"],["神","かみ"],["の"],["人","ひと"],["が"],["います"],["。"],["この"],["人","ひと"],["は"],["敬われて","うやまわれて"],["いる"],["人","ひと"],["です"],["。"],["この"],["人","ひと"],["の"],["言う","いう"],["こと"],["は"],["みな"],["、"],["必ず","かならず"],["実現","じつげん"],["します"],["。"],["今","いま"],["そこ"],["へ"],["まいりましょう"],["。"],["たぶん"],["、"],["私たち","わたしたち"],["の"],["行くべき","いくべき"],["道","みち"],["を"],["教えて","おしえて"],["くれるでしょう"],["。"],["」"]]},{"verse":7,"text":"サウルは若い者に言った。「もし行くとすると、その人に何を持って行こうか。私たちの袋には、パンもなくなったし、その神の人に持って行く贈り物もない。何かあるか。」","tok":[["サウル"],["は"],["若い","わかい"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["もし"],["行く","いく"],["と"],["する"],["と"],["、"],["その"],["人","ひと"],["に"],["何","なん"],["を"],["持って","もって"],["行こう","いこう"],["か"],["。"],["私たち","わたしたち"],["の"],["袋","ふくろ"],["に"],["は"],["、"],["パン"],["も"],["なくなった"],["し"],["、"],["その"],["神","かみ"],["の"],["人","ひと"],["に"],["持って","もって"],["行く","いく"],["贈り物","おくりもの"],["も"],["ない"],["。"],["何","なん"],["か"],["ある"],["か"],["。"],["」"]]},{"verse":8,"text":"その若い者はまたサウルに答えて言った。「ご覧ください。私の手に四分の一シェケルの銀があります。私がこれを神の人に差し上げて、私たちの行く道を教えてもらいましょう。」","tok":[["その"],["若い","わかい"],["者","もの"],["は"],["また"],["サウル"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["ください"],["。"],["私","わたくし"],["の"],["手","て"],["に"],["四分","よんぶん"],["の"],["一","いち"],["シェケル"],["の"],["銀","ぎん"],["が"],["あります"],["。"],["私","わたくし"],["が"],["これ"],["を"],["神","かみ"],["の"],["人","ひと"],["に"],["差し上げて","さしあげて"],["、"],["私たち","わたしたち"],["の"],["行く","いく"],["道","みち"],["を"],["教えて","おしえて"],["もらいましょう"],["。"],["」"]]},{"verse":9,"text":"――昔イスラエルでは、神のみこころを求めに行く人は、「さあ、予見者のところへ行こう」と言った。今の預言者は、昔は予見者と呼ばれていたからである――","tok":[["―"],["―"],["昔","むかし"],["イスラエル"],["で"],["は"],["、"],["神","かみ"],["のみ"],["こころ"],["を"],["求め","もとめ"],["に"],["行く","いく"],["人","ひと"],["は"],["、"],["「"],["さあ"],["、"],["予見者","よけんしゃ"],["の"],["ところ"],["へ"],["行こう","いこう"],["」"],["と"],["言った","いった"],["。"],["今","いま"],["の"],["預言者","よげんしゃ"],["は"],["、"],["昔","むかし"],["は"],["予見者","よけんしゃ"],["と"],["呼ばれて","よばれて"],["いた"],["から"],["で"],["ある"],["―"],["―"]]},{"verse":10,"text":"するとサウルは若い者に言った。「それはいい。さあ、行こう。」こうして、ふたりは神の人のいる町へ出かけた。","tok":[["する"],["と"],["サウル"],["は"],["若い","わかい"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["それ"],["は"],["いい"],["。"],["さあ"],["、"],["行こう","いこう"],["。"],["」"],["こう"],["して"],["、"],["ふたり"],["は"],["神","かみ"],["の"],["人","ひと"],["の"],["いる"],["町","まち"],["へ"],["出かけた","でかけた"],["。"]]},{"verse":11,"text":"彼らはその町の坂道を上って行った。水を汲みに出て来た娘たちに出会って、「ここに予見者がおられますか」と尋ねた。","tok":[["彼","かれ"],["ら"],["は"],["その"],["町","まち"],["の"],["坂道","さかみち"],["を"],["上って","のぼって"],["行った","いった"],["。"],["水","みず"],["を"],["汲み","くみ"],["に"],["出て","でて"],["来た","きた"],["娘","むすめ"],["たち"],["に"],["出会って","であって"],["、"],["「"],["ここ"],["に"],["予見者","よけんしゃ"],["が"],["おられます"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":12,"text":"すると、娘たちは答えて言った。「ついこの先におられます。今、急いでください。きょう、町に来られました。きょう、あの高き所で民のためにいけにえをささげますから。","tok":[["する"],["と"],["、"],["娘","むすめ"],["たち"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["つい"],["この先","このさき"],["に"],["おられます"],["。"],["今","いま"],["、"],["急いで","いそいで"],["ください"],["。"],["きょう"],["、"],["町","まち"],["に"],["来られました","こられました"],["。"],["きょう"],["、"],["あの"],["高き","たかき"],["所","ところ"],["で"],["民","たみ"],["の"],["ため"],["に"],["いけにえ"],["を"],["ささげます"],["から"],["。"]]},{"verse":13,"text":"町にお入りになると、すぐ、あの方にお会いできるでしょう。あの方が食事のために高き所に上られる前に。民は、あの方が来て、いけにえを祝福されるまでは食事をしません。祝福のあとで招かれた者たちが食事をすることになっています。今、上ってください。すぐ、あの方に会えるでしょう。」","tok":[["町","まち"],["に"],["お入り","おいり"],["に"],["なる"],["と"],["、"],["すぐ"],["、"],["あの"],["方","かた"],["に"],["お会い","おあい"],["できるでしょう"],["。"],["あの"],["方","ほう"],["が"],["食事","しょくじ"],["の"],["ため"],["に"],["高き","たかき"],["所","ところ"],["に"],["上られる","のぼられる"],["前","まえ"],["に"],["。"],["民","たみ"],["は"],["、"],["あの"],["方","ほう"],["が"],["来て","きて"],["、"],["いけにえ"],["を"],["祝福","しゅくふく"],["される"],["まで"],["は"],["食事","しょくじ"],["を"],["しません"],["。"],["祝福","しゅくふく"],["の"],["あと"],["で"],["招かれた","まねかれた"],["者","もの"],["たち"],["が"],["食事","しょくじ"],["を"],["する"],["こと"],["に"],["なって"],["います"],["。"],["今","いま"],["、"],["上って","のぼって"],["ください"],["。"],["すぐ"],["、"],["あの"],["方","かた"],["に"],["会えるでしょう","あえるでしょう"],["。"],["」"]]},{"verse":14,"text":"彼らが町へ上って行って、町にさしかかったとき、ちょうどサムエルは、高き所に上ろうとして彼らに向かって出て来た。","tok":[["彼","かれ"],["ら"],["が"],["町","まち"],["へ"],["上って","のぼって"],["行って","いって"],["、"],["町","まち"],["に"],["さしかかった"],["とき"],["、"],["ちょうど"],["サムエル"],["は"],["、"],["高き","たかき"],["所","ところ"],["に"],["上ろう","のぼろう"],["として"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["出て","でて"],["来た","きた"],["。"]]},{"verse":15,"text":"主は、サウルが来る前の日に、サムエルの耳を開いて仰せられた。","tok":[["主","ぬし"],["は"],["、"],["サウル"],["が"],["来る","くる"],["前","まえ"],["の"],["日","ひ"],["に"],["、"],["サムエル"],["の"],["耳","みみ"],["を"],["開いて","ひらいて"],["仰せられた","おおせられた"],["。"]]},{"verse":16,"text":"「あすの今ごろ、わたしはひとりの人をベニヤミンの地からあなたのところに遣わす。あなたは彼に油をそそいで、わたしの民イスラエルの君主とせよ。彼はわたしの民をペリシテ人の手から救うであろう。民の叫びがわたしに届いたので、わたしは自分の民を見たからだ。」","tok":[["「"],["あす"],["の"],["今ごろ","いまごろ"],["、"],["わたし"],["は"],["ひとり"],["の"],["人","ひと"],["を"],["ベニヤミン"],["の"],["地","ち"],["から"],["あなた"],["の"],["ところ"],["に"],["遣わす","つかわす"],["。"],["あなた"],["は"],["彼","かれ"],["に"],["油","あぶら"],["を"],["そそいで"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["君主","くんしゅ"],["と"],["せよ"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["民","たみ"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["救うで","すくうで"],["あろう"],["。"],["民","たみ"],["の"],["叫び","さけび"],["が"],["わたし"],["に"],["届いた","とどいた"],["ので"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["民","たみ"],["を"],["見た","みた"],["から"],["だ"],["。"],["」"]]},{"verse":17,"text":"サムエルがサウルを見たとき、主は彼に告げられた。「ここに、わたしがあなたに話した者がいる。この者がわたしの民を支配するのだ。」","tok":[["サムエル"],["が"],["サウル"],["を"],["見た","みた"],["とき"],["、"],["主","ぬし"],["は"],["彼","かれ"],["に"],["告げられた","つげられた"],["。"],["「"],["ここ"],["に"],["、"],["わたし"],["が"],["あなた"],["に"],["話した","はなした"],["者","もの"],["が"],["いる"],["。"],["この"],["者","もの"],["が"],["わたし"],["の"],["民","たみ"],["を"],["支配","しはい"],["する"],["の"],["だ"],["。"],["」"]]},{"verse":18,"text":"サウルは、門の中でサムエルに近づいたとき、言った。「予見者の家はどこですか。教えてください。」","tok":[["サウル"],["は"],["、"],["門","もん"],["の"],["中","なか"],["で"],["サムエル"],["に"],["近づいた","ちかづいた"],["とき"],["、"],["言った","いった"],["。"],["「"],["予見者","よけんしゃ"],["の"],["家","いえ"],["は"],["どこ"],["です"],["か"],["。"],["教えて","おしえて"],["ください"],["。"],["」"]]},{"verse":19,"text":"サムエルはサウルに答えて言った。「私がその予見者です。この先のあの高き所に上りなさい。きょう、あなたがたは私といっしょに食事をすることになっています。あしたの朝、私があなたをお送りしましょう。あなたの心にあることを全部、明かしましょう。","tok":[["サムエル"],["は"],["サウル"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["その"],["予見者","よけんしゃ"],["です"],["。"],["この先","このさき"],["の"],["あの"],["高き","たかき"],["所","ところ"],["に"],["上り","のぼり"],["なさい"],["。"],["きょう"],["、"],["あなた"],["がた"],["は"],["私","わたくし"],["と"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["する"],["こと"],["に"],["なって"],["います"],["。"],["あした"],["の"],["朝","あさ"],["、"],["私","わたくし"],["が"],["あなた"],["を"],["お送り","おおくり"],["しましょう"],["。"],["あなた"],["の"],["心","こころ"],["に"],["ある"],["こと"],["を"],["全部","ぜんぶ"],["、"],["明かしましょう","あかしましょう"],["。"]]},{"verse":20,"text":"三日前にいなくなったあなたの雌ろばについては、もう気にかけないように。あれは見つかっています。イスラエルのすべてが望んでいるものは、だれのものでしょう。それはあなたのもの、あなたの父の全家のものではありませんか。」","tok":[["三日","みっか"],["前","まえ"],["に"],["いなく"],["なった"],["あなた"],["の"],["雌","めす"],["ろば"],["について"],["は"],["、"],["もう"],["気","き"],["に"],["かけない"],["よう"],["に"],["。"],["あれ"],["は"],["見つかって","みつかって"],["います"],["。"],["イスラエル"],["の"],["すべて"],["が"],["望んで","のぞんで"],["いる"],["もの"],["は"],["、"],["だれ"],["の"],["もの"],["でしょう"],["。"],["それ"],["は"],["あなた"],["の"],["もの"],["、"],["あなた"],["の"],["父","ちち"],["の"],["全","ぜん"],["家","いえ"],["の"],["もの"],["で"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":21,"text":"サウルは答えて言った。「私はイスラエルの部族のうちの最も小さいベニヤミン人ではありませんか。私の家族は、ベニヤミンの部族のどの家族よりも、つまらないものではありませんか。どうしてあなたはこのようなことを私に言われるのですか。」","tok":[["サウル"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["うち"],["の"],["最も","もっとも"],["小さい","ちいさい"],["ベニヤミン"],["人","にん"],["で"],["は"],["ありません"],["か"],["。"],["私","わたくし"],["の"],["家族","かぞく"],["は"],["、"],["ベニヤミン"],["の"],["部族","ぶぞく"],["の"],["どの"],["家族","かぞく"],["より"],["も"],["、"],["つまらない"],["もの"],["で"],["は"],["ありません"],["か"],["。"],["どう"],["して"],["あなた"],["は"],["この"],["よう"],["な"],["こと"],["を"],["私","わたくし"],["に"],["言われる","いわれる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":22,"text":"しかし、サムエルはサウルとその若い者を広間に連れて入り、三十人ほどの招かれた者の上座に彼らを着かせた。","tok":[["しかし"],["、"],["サムエル"],["は"],["サウル"],["と"],["その"],["若い","わかい"],["者","もの"],["を"],["広間","ひろま"],["に"],["連れて","つれて"],["入り","はいり"],["、"],["三","さん"],["十人","じゅうにん"],["ほど"],["の"],["招かれた","まねかれた"],["者","もの"],["の"],["上座","かみざ"],["に"],["彼","かれ"],["ら"],["を"],["着かせた","つかせた"],["。"]]},{"verse":23,"text":"サムエルが料理人に、「取っておくようにと言って渡しておいた分を下さい」と言うと、","tok":[["サムエル"],["が"],["料理人","りょうりにん"],["に"],["、"],["「"],["取って","とって"],["おく"],["よう"],["に"],["と"],["言って","いって"],["渡して","わたして"],["おいた"],["分","ぶん"],["を"],["下さい","ください"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":24,"text":"料理人は、ももとその上の部分とを取り出し、それをサウルの前に置いた。そこでサムエルは言った。「あなたの前に置かれたのは取っておいたものです。お食べなさい。私が客を招いたからと民に言って、この時のため、あなたに取っておいたのです。」その日、サウルはサムエルといっしょに食事をした。","tok":[["料理人","りょうりにん"],["は"],["、"],["もも"],["と"],["その"],["上","うえ"],["の"],["部分","ぶぶん"],["と"],["を"],["取り出し","とりだし"],["、"],["それ"],["を"],["サウル"],["の"],["前","まえ"],["に"],["置いた","おいた"],["。"],["そこ"],["で"],["サムエル"],["は"],["言った","いった"],["。"],["「"],["あなた"],["の"],["前","まえ"],["に"],["置かれた","おかれた"],["の"],["は"],["取って","とって"],["おいた"],["もの"],["です"],["。"],["お食べ","おたべ"],["なさい"],["。"],["私","わたくし"],["が"],["客","きゃく"],["を"],["招いた","まねいた"],["から"],["と"],["民","たみ"],["に"],["言って","いって"],["、"],["この"],["時","とき"],["の"],["ため"],["、"],["あなた"],["に"],["取って","とって"],["おいた"],["の"],["です"],["。"],["」"],["その"],["日","ひ"],["、"],["サウル"],["は"],["サムエル"],["と"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":25,"text":"それから彼らは高き所から町に下って来た。サムエルはサウルと屋上で話をした。","tok":[["それ"],["から"],["彼","かれ"],["ら"],["は"],["高き","たかき"],["所","ところ"],["から"],["町","まち"],["に"],["下って","くだって"],["来た","きた"],["。"],["サムエル"],["は"],["サウル"],["と"],["屋上","おくじょう"],["で"],["話","はなし"],["を"],["した"],["。"]]},{"verse":26,"text":"朝早く、夜が明けかかると、サムエルは屋上のサウルを呼んで言った。「起きてください。お送りしましょう。」サウルは起きて、サムエルとふたりで外に出た。","tok":[["朝","あさ"],["早く","はやく"],["、"],["夜","よる"],["が"],["明けかかる","あけかかる"],["と"],["、"],["サムエル"],["は"],["屋上","おくじょう"],["の"],["サウル"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["起きて","おきて"],["ください"],["。"],["お送り","おおくり"],["しましょう"],["。"],["」"],["サウル"],["は"],["起きて","おきて"],["、"],["サムエル"],["と"],["ふたり"],["で"],["外","そと"],["に"],["出た","でた"],["。"]]},{"verse":27,"text":"彼らは、町はずれに下って来ていた。サムエルはサウルに言った。「この若い者に、私たちより先に行くように言ってください。若い者が先に行ったら、あなたは、ここにしばらくとどまってください。神のことばをお聞かせしますから。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["町はずれ","まちはずれ"],["に"],["下って","くだって"],["来て","きて"],["いた"],["。"],["サムエル"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["この"],["若い","わかい"],["者","もの"],["に"],["、"],["私たち","わたしたち"],["より"],["先","さき"],["に"],["行く","いく"],["よう"],["に"],["言って","いって"],["ください"],["。"],["若い","わかい"],["者","もの"],["が"],["先","さき"],["に"],["行ったら","いったら"],["、"],["あなた"],["は"],["、"],["ここ"],["に"],["しばらく"],["とどまって"],["ください"],["。"],["神","かみ"],["の"],["ことば"],["を"],["お聞かせ","おきかせ"],["します"],["から"],["。"],["」"]]}]
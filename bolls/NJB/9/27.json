[{"verse":1,"text":"ダビデは心の中で言った。「私はいつか、いまに、サウルの手によって滅ぼされるだろう。ペリシテ人の地にのがれるよりほかに道はない。そうすれば、サウルは、私をイスラエルの領土内で、くまなく捜すのをあきらめるであろう。こうして私は彼の手からのがれよう。」","tok":[["ダビデ"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["いつ"],["か"],["、"],["いま"],["に"],["、"],["サウル"],["の"],["手","て"],["によって"],["滅ぼされるだろう","ほろぼされるだろう"],["。"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["に"],["のがれる"],["より"],["ほか"],["に"],["道","みち"],["は"],["ない"],["。"],["そう"],["すれば"],["、"],["サウル"],["は"],["、"],["私","わたくし"],["を"],["イスラエル"],["の"],["領土内","りょうどない"],["で"],["、"],["くまなく"],["捜す","さがす"],["の"],["を"],["あきらめるで"],["あろう"],["。"],["こう"],["して"],["私","わたくし"],["は"],["彼","かれ"],["の"],["手","て"],["から"],["のがれよう"],["。"],["」"]]},{"verse":2,"text":"そこでダビデは、いっしょにいた六百人の者を連れて、ガテの王マオクの子アキシュのところへ渡って行った。","tok":[["そこ"],["で"],["ダビデ"],["は"],["、"],["いっしょ"],["に"],["いた"],["六百人","ろくひゃくにん"],["の"],["者","もの"],["を"],["連れて","つれて"],["、"],["ガテ"],["の"],["王","おう"],["マオク"],["の"],["子","こ"],["アキシュ"],["の"],["ところ"],["へ"],["渡って","わたって"],["行った","いった"],["。"]]},{"verse":3,"text":"ダビデとその部下たちは、それぞれ自分の家族とともに、ガテでアキシュのもとに住みついた。ダビデも、そのふたりの妻、イズレエル人アヒノアムと、ナバルの妻であったカルメル人アビガイルといっしょであった。","tok":[["ダビデ"],["と"],["その"],["部下","ぶか"],["たち"],["は"],["、"],["それぞれ"],["自分","じぶん"],["の"],["家族","かぞく"],["と"],["とも"],["に"],["、"],["ガテ"],["で"],["アキシュ"],["の"],["もと"],["に"],["住みついた","すみついた"],["。"],["ダビデ"],["も"],["、"],["その"],["ふたり"],["の"],["妻","つま"],["、"],["イズレエル"],["人","にん"],["アヒノアム"],["と"],["、"],["ナバル"],["の"],["妻","つま"],["で"],["あった"],["カルメル"],["人","にん"],["アビガイル"],["と"],["いっしょ"],["で"],["あった"],["。"]]},{"verse":4,"text":"ダビデがガテへ逃げたことが、サウルに知らされると、サウルは二度とダビデを追おうとはしなかった。","tok":[["ダビデ"],["が"],["ガテ"],["へ"],["逃げた","にげた"],["こと"],["が"],["、"],["サウル"],["に"],["知らされる","しらされる"],["と"],["、"],["サウル"],["は"],["二","に"],["度","ど"],["と"],["ダビデ"],["を"],["追おう","おおう"],["と"],["は"],["しなかった"],["。"]]},{"verse":5,"text":"ダビデはアキシュに言った。「もし、私の願いをかなえてくださるなら、地方の町の一つの場所を私に与えて、そこに私を住まわせてください。どうして、このしもべが王の都に、あなたといっしょに住めましょう。」","tok":[["ダビデ"],["は"],["アキシュ"],["に"],["言った","いった"],["。"],["「"],["もし"],["、"],["私","わたくし"],["の"],["願い","ねがい"],["を"],["かなえて"],["くださるなら"],["、"],["地方","ちほう"],["の"],["町","まち"],["の"],["一","ひと"],["つ"],["の"],["場所","ばしょ"],["を"],["私","わたくし"],["に"],["与えて","あたえて"],["、"],["そこ"],["に"],["私","わたくし"],["を"],["住まわせて","すまわせて"],["ください"],["。"],["どう"],["して"],["、"],["この"],["しもべ"],["が"],["王","おう"],["の"],["都","と"],["に"],["、"],["あなた"],["と"],["いっしょ"],["に"],["住めましょう","すめましょう"],["。"],["」"]]},{"verse":6,"text":"それでアキシュは、その日、ツィケラグをダビデに与えた。それゆえ、ツィケラグは今日まで、ユダの王に属している。","tok":[["それ"],["で"],["アキシュ"],["は"],["、"],["その"],["日","ひ"],["、"],["ツィケラグ"],["を"],["ダビデ"],["に"],["与えた","あたえた"],["。"],["それ"],["ゆえ"],["、"],["ツィケラグ"],["は"],["今日","きょう"],["まで"],["、"],["ユダ"],["の"],["王","おう"],["に"],["属して","ぞくして"],["いる"],["。"]]},{"verse":7,"text":"ダビデがペリシテ人の地に住んだ日数は一年四か月であった。","tok":[["ダビデ"],["が"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["日数","にっすう"],["は"],["一","いち"],["年","ねん"],["四","し"],["か月","かげつ"],["で"],["あった"],["。"]]},{"verse":8,"text":"ダビデは部下とともに上って行って、ゲシュル人、ゲゼル人、アマレク人を襲った。彼らは昔から、シュルのほうエジプトの国に及ぶ地域に住んでいた。","tok":[["ダビデ"],["は"],["部下","ぶか"],["と"],["とも"],["に"],["上って","のぼって"],["行って","いって"],["、"],["ゲシュル"],["人","にん"],["、"],["ゲゼル人","げぜるにん"],["、"],["アマレク"],["人","にん"],["を"],["襲った","おそった"],["。"],["彼","かれ"],["ら"],["は"],["昔","むかし"],["から"],["、"],["シュル"],["の"],["ほう"],["エジプト"],["の"],["国","くに"],["に"],["及ぶ","およぶ"],["地域","ちいき"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":9,"text":"ダビデは、これらの地方を打つと、男も女も生かしておかず、羊、牛、ろば、らくだ、それに着物などを奪って、いつもアキシュのところに帰って来ていた。","tok":[["ダビデ"],["は"],["、"],["これ"],["ら"],["の"],["地方","ちほう"],["を"],["打つ","うつ"],["と"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["生かして","いかして"],["おかず"],["、"],["羊","ひつじ"],["、"],["牛","うし"],["、"],["ろば"],["、"],["らく"],["だ"],["、"],["それ"],["に"],["着物","きもの"],["など"],["を"],["奪って","うばって"],["、"],["いつも"],["アキシュ"],["の"],["ところ"],["に"],["帰って","かえって"],["来て","きて"],["いた"],["。"]]},{"verse":10,"text":"アキシュが、「きょうは、どこを襲ったのか」と尋ねると、ダビデはいつも、ユダのネゲブとか、エラフメエル人のネゲブとか、ケニ人のネゲブとか答えていた。","tok":[["アキシュ"],["が"],["、"],["「"],["きょう"],["は"],["、"],["どこ"],["を"],["襲った","おそった"],["の"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["ダビデ"],["は"],["いつも"],["、"],["ユダ"],["の"],["ネゲブ"],["と"],["か"],["、"],["エラフメエル"],["人","にん"],["の"],["ネゲブ"],["と"],["か"],["、"],["ケニ"],["人","ひと"],["の"],["ネゲブ"],["と"],["か"],["答えて","こたえて"],["いた"],["。"]]},{"verse":11,"text":"ダビデは男も女も生かしておかず、ガテにひとりも連れて来なかった。彼らが、「ダビデはこういうことをした」と言って、自分たちのことを告げるといけない、と思ったからである。ダビデはペリシテ人の地に住んでいる間、いつも、このようなやり方をしていた。","tok":[["ダビデ"],["は"],["男","おとこ"],["も"],["女","おんな"],["も"],["生かして","いかして"],["おかず"],["、"],["ガテ"],["に"],["ひとり"],["も"],["連れて","つれて"],["来なかった","こなかった"],["。"],["彼","かれ"],["ら"],["が"],["、"],["「"],["ダビデ"],["は"],["こう"],["いう"],["こと"],["を"],["した"],["」"],["と"],["言って","いって"],["、"],["自分","じぶん"],["たち"],["の"],["こと"],["を"],["告げる","つげる"],["と"],["いけない"],["、"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"],["ダビデ"],["は"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["に"],["住んで","すんで"],["いる"],["間","あいだ"],["、"],["いつも"],["、"],["この"],["よう"],["な"],["やり方","やりかた"],["を"],["して"],["いた"],["。"]]},{"verse":12,"text":"アキシュはダビデを信用して、こう思った。「ダビデは進んで自分の同胞イスラエル人に忌みきらわれるようなことをしている。彼はいつまでも私のしもべになっていよう。」","tok":[["アキシュ"],["は"],["ダビデ"],["を"],["信用","しんよう"],["して"],["、"],["こう"],["思った","おもった"],["。"],["「"],["ダビデ"],["は"],["進んで","すすんで"],["自分","じぶん"],["の"],["同胞","どうほう"],["イスラエル"],["人","にん"],["に"],["忌みきらわれる","いみきらわれる"],["よう"],["な"],["こと"],["を"],["して"],["いる"],["。"],["彼","かれ"],["は"],["いつ"],["まで"],["も"],["私","わたくし"],["の"],["しもべ"],["に"],["なって"],["いよう"],["。"],["」"]]}]
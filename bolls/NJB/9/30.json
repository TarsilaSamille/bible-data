[{"verse":1,"text":"ダビデとその部下が、三日目にツィケラグに帰ってみると、アマレク人がネゲブとツィケラグを襲ったあとだった。彼らはツィケラグを攻撃して、これを火で焼き払い、","tok":[["ダビデ"],["と"],["その"],["部下","ぶか"],["が"],["、"],["三日目","みっかめ"],["に"],["ツィケラグ"],["に"],["帰って","かえって"],["みる"],["と"],["、"],["アマレク"],["人","にん"],["が"],["ネゲブ"],["と"],["ツィケラグ"],["を"],["襲った","おそった"],["あと"],["だった"],["。"],["彼","かれ"],["ら"],["は"],["ツィケラグ"],["を"],["攻撃","こうげき"],["して"],["、"],["これ"],["を"],["火","ひ"],["で"],["焼き払い","やきはらい"],["、"]]},{"verse":2,"text":"そこにいた女たちを、子どももおとなもみな、とりこにし、ひとりも殺さず、自分たちの所に連れて去った。","tok":[["そこ"],["に"],["いた"],["女","おんな"],["たち"],["を"],["、"],["子ども","こども"],["も"],["おとな"],["も"],["みな"],["、"],["とりこ"],["に"],["し"],["、"],["ひとり"],["も"],["殺さず","ころさず"],["、"],["自分","じぶん"],["たち"],["の"],["所","ところ"],["に"],["連れて","つれて"],["去った","さった"],["。"]]},{"verse":3,"text":"ダビデとその部下が、この町に着いたとき、町は火で焼かれており、彼らの妻も、息子も、娘たちも連れ去られていた。","tok":[["ダビデ"],["と"],["その"],["部下","ぶか"],["が"],["、"],["この"],["町","まち"],["に"],["着いた","ついた"],["とき"],["、"],["町","まち"],["は"],["火","ひ"],["で"],["焼かれて","やかれて"],["おり"],["、"],["彼","かれ"],["ら"],["の"],["妻","つま"],["も"],["、"],["息子","むすこ"],["も"],["、"],["娘","むすめ"],["たち"],["も"],["連れ去られて","つれさられて"],["いた"],["。"]]},{"verse":4,"text":"ダビデも、彼といっしょにいた者たちも、声をあげて泣き、ついには泣く力もなくなった。","tok":[["ダビデ"],["も"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["いた"],["者","もの"],["たち"],["も"],["、"],["声","こえ"],["を"],["あげて"],["泣き","なき"],["、"],["ついに"],["は"],["泣く","なく"],["力","ちから"],["も"],["なくなった"],["。"]]},{"verse":5,"text":"ダビデのふたりの妻、イズレエル人アヒノアムも、ナバルの妻であったカルメル人アビガイルも連れ去られていた。","tok":[["ダビデ"],["の"],["ふたり"],["の"],["妻","つま"],["、"],["イズレエル"],["人","にん"],["アヒノアム"],["も"],["、"],["ナバル"],["の"],["妻","つま"],["で"],["あった"],["カルメル"],["人","にん"],["アビガイル"],["も"],["連れ去られて","つれさられて"],["いた"],["。"]]},{"verse":6,"text":"ダビデは非常に悩んだ。民がみな、自分たちの息子、娘たちのことで心を悩まし、ダビデを石で打ち殺そうと言いだしたからである。しかし、ダビデは彼の神、主によって奮い立った。","tok":[["ダビデ"],["は"],["非常","ひじょう"],["に"],["悩んだ","なやんだ"],["。"],["民","たみ"],["が"],["みな"],["、"],["自分","じぶん"],["たち"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["の"],["こと"],["で"],["心","こころ"],["を"],["悩まし","なやまし"],["、"],["ダビデ"],["を"],["石","いし"],["で"],["打ち殺そう","うちころそう"],["と"],["言い","いい"],["だした"],["から"],["で"],["ある"],["。"],["しかし"],["、"],["ダビデ"],["は"],["彼","かれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["よって"],["奮い立った","ふるいたった"],["。"]]},{"verse":7,"text":"ダビデが、アヒメレクの子、祭司エブヤタルに、「エポデを持って来なさい」と言ったので、エブヤタルはエポデをダビデのところに持って来た。","tok":[["ダビデ"],["が"],["、"],["アヒメレク"],["の"],["子","こ"],["、"],["祭司","さいし"],["エブヤタル"],["に"],["、"],["「"],["エポデ"],["を"],["持って","もって"],["来","き"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["エブヤタル"],["は"],["エポデ"],["を"],["ダビデ"],["の"],["ところ"],["に"],["持って","もって"],["来た","きた"],["。"]]},{"verse":8,"text":"ダビデは主に伺って言った。「あの略奪隊を追うべきでしょうか。追いつけるでしょうか。」するとお答えになった。「追え。必ず追いつくことができる。必ず救い出すことができる。」","tok":[["ダビデ"],["は"],["主に","おもに"],["伺って","うかがって"],["言った","いった"],["。"],["「"],["あの"],["略奪隊","りゃくだつたい"],["を"],["追うべきでしょう","おうべきでしょう"],["か"],["。"],["追いつけるでしょう","おいつけるでしょう"],["か"],["。"],["」"],["する"],["と"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["追え","おえ"],["。"],["必ず","かならず"],["追いつく","おいつく"],["こと"],["が"],["できる"],["。"],["必ず","かならず"],["救い出す","すくいだす"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":9,"text":"そこでダビデは六百人の部下とともに出て行き、ベソル川まで来た。残された者は、そこにとどまった。","tok":[["そこ"],["で"],["ダビデ"],["は"],["六百人","ろくひゃくにん"],["の"],["部下","ぶか"],["と"],["とも"],["に"],["出て","でて"],["行き","いき"],["、"],["ベソル"],["川","かわ"],["まで"],["来た","きた"],["。"],["残された","のこされた"],["者","もの"],["は"],["、"],["そこ"],["に"],["とどまった"],["。"]]},{"verse":10,"text":"ダビデと四百人の者は追撃を続け、疲れきってベソル川を渡ることのできなかった二百人の者は、そこにとどまった。","tok":[["ダビデ"],["と"],["四百人","よんひゃくにん"],["の"],["者","もの"],["は"],["追撃","ついげき"],["を"],["続け","つづけ"],["、"],["疲れ","つかれ"],["きって"],["ベソル"],["川","かわ"],["を"],["渡る","わたる"],["こと"],["の"],["できなかった"],["二百人","にひゃくにん"],["の"],["者","もの"],["は"],["、"],["そこ"],["に"],["とどまった"],["。"]]},{"verse":11,"text":"彼らはひとりのエジプト人を野原で見つけ、ダビデのところに連れて来た。彼らは彼にパンをやって、食べさせ、水も飲ませた。","tok":[["彼","かれ"],["ら"],["は"],["ひとり"],["の"],["エジプト"],["人","にん"],["を"],["野原","のはら"],["で"],["見つけ","みつけ"],["、"],["ダビデ"],["の"],["ところ"],["に"],["連れて","つれて"],["来た","きた"],["。"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["に"],["パン"],["を"],["やって"],["、"],["食べさせ","たべさせ"],["、"],["水","みず"],["も"],["飲ませた","のませた"],["。"]]},{"verse":12,"text":"さらに、ひとかたまりの干しいちじくと、二ふさの干しぶどうをやると、彼はそれを食べて元気を回復した。三日三晩、パンも食べず、水も飲んでいなかったからである。","tok":[["さらに"],["、"],["ひとかたまり"],["の"],["干し","ほし"],["いちじく"],["と"],["、"],["二","に"],["ふさ"],["の"],["干し","ほし"],["ぶどう"],["を"],["やる"],["と"],["、"],["彼","かれ"],["は"],["それ"],["を"],["食べて","たべて"],["元気","げんき"],["を"],["回復","かいふく"],["した"],["。"],["三日","みっか"],["三","さん"],["晩","ばん"],["、"],["パン"],["も"],["食べず","たべず"],["、"],["水","みず"],["も"],["飲んで","のんで"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"ダビデは彼に言った。「おまえはだれのものか。どこから来たのか。」すると答えた。「私はエジプトの若者で、アマレク人の奴隷です。私が三日前に病気になったので、主人は私を置き去りにしたのです。","tok":[["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["は"],["だれ"],["の"],["もの"],["か"],["。"],["どこ"],["から"],["来た","きた"],["の"],["か"],["。"],["」"],["する"],["と"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["エジプト"],["の"],["若者","わかもの"],["で"],["、"],["アマレク"],["人","にん"],["の"],["奴隷","どれい"],["です"],["。"],["私","わたくし"],["が"],["三日","みっか"],["前","まえ"],["に"],["病気","びょうき"],["に"],["なった"],["ので"],["、"],["主人","しゅじん"],["は"],["私","わたくし"],["を"],["置き去り","おきざり"],["に"],["した"],["の"],["です"],["。"]]},{"verse":14,"text":"私たちは、ケレテ人のネゲブと、ユダに属する地と、カレブのネゲブを襲い、ツィケラグを火で焼き払いました。」","tok":[["私たち","わたしたち"],["は"],["、"],["ケレテ人","けれてにん"],["の"],["ネゲブ"],["と"],["、"],["ユダ"],["に"],["属する","ぞくする"],["地","ち"],["と"],["、"],["カレブ"],["の"],["ネゲブ"],["を"],["襲い","おそい"],["、"],["ツィケラグ"],["を"],["火","ひ"],["で"],["焼き払いました","やきはらいました"],["。"],["」"]]},{"verse":15,"text":"ダビデは彼に言った。「その略奪隊のところに案内できるか。」彼は答えた。「私を殺さず、主人の手に私を渡さないと、神かけて私に誓ってください。そうすれば、あなたをあの略奪隊のところに案内いたしましょう。」","tok":[["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["その"],["略奪隊","りゃくだつたい"],["の"],["ところ"],["に"],["案内","あんない"],["できる"],["か"],["。"],["」"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["を"],["殺さず","ころさず"],["、"],["主人","しゅじん"],["の"],["手","て"],["に"],["私","わたくし"],["を"],["渡さない","わたさない"],["と"],["、"],["神","かみ"],["かけて"],["私","わたくし"],["に"],["誓って","ちかって"],["ください"],["。"],["そう"],["すれば"],["、"],["あなた"],["を"],["あの"],["略奪隊","りゃくだつたい"],["の"],["ところ"],["に"],["案内","あんない"],["いたしましょう"],["。"],["」"]]},{"verse":16,"text":"彼がダビデを案内して行くと、ちょうど、彼らはその地いっぱいに散って飲み食いし、お祭り騒ぎをしていた。彼らがペリシテ人の地やユダの地から、非常に多くの分捕り物を奪ったからである。","tok":[["彼","かれ"],["が"],["ダビデ"],["を"],["案内","あんない"],["して"],["行く","いく"],["と"],["、"],["ちょうど"],["、"],["彼","かれ"],["ら"],["は"],["その"],["地","ち"],["いっぱい"],["に"],["散って","ちって"],["飲み食い","のみくい"],["し"],["、"],["お祭り騒ぎ","おまつりさわぎ"],["を"],["して"],["いた"],["。"],["彼","かれ"],["ら"],["が"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["や"],["ユダ"],["の"],["地","ち"],["から"],["、"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["分","ぶん"],["捕り物","とりもの"],["を"],["奪った","うばった"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"そこでダビデは、その夕暮れから次の夕方まで彼らを打った。らくだに乗って逃げた四百人の若い者たちのほかは、ひとりものがれおおせなかった。","tok":[["そこ"],["で"],["ダビデ"],["は"],["、"],["その"],["夕暮れ","ゆうぐれ"],["から"],["次","つぎ"],["の"],["夕方","ゆうがた"],["まで"],["彼","かれ"],["ら"],["を"],["打った","うった"],["。"],["らくだ"],["に"],["乗って","のって"],["逃げた","にげた"],["四百人","よんひゃくにん"],["の"],["若い","わかい"],["者","もの"],["たち"],["の"],["ほか"],["は"],["、"],["ひとり"],["も"],["のがれ"],["おおせなかった"],["。"]]},{"verse":18,"text":"こうしてダビデは、アマレクが奪い取ったものを全部、取り戻した。彼のふたりの妻も取り戻した。","tok":[["こう"],["して"],["ダビデ"],["は"],["、"],["アマレク"],["が"],["奪い取った","うばいとった"],["もの"],["を"],["全部","ぜんぶ"],["、"],["取り戻した","とりもどした"],["。"],["彼","かれ"],["の"],["ふたり"],["の"],["妻","つま"],["も"],["取り戻した","とりもどした"],["。"]]},{"verse":19,"text":"彼らは、子どももおとなも、また息子、娘たちも、分捕り物も、彼らが奪われたものは、何一つ失わなかった。ダビデは、これらすべてを取り返した。","tok":[["彼","かれ"],["ら"],["は"],["、"],["子ども","こども"],["も"],["おとな"],["も"],["、"],["また"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["も"],["、"],["分","ぶん"],["捕り物","とりもの"],["も"],["、"],["彼","かれ"],["ら"],["が"],["奪われた","うばわれた"],["もの"],["は"],["、"],["何","なん"],["一","ひと"],["つ"],["失わなかった","うしなわなかった"],["。"],["ダビデ"],["は"],["、"],["これ"],["ら"],["すべて"],["を"],["取り返した","とりかえした"],["。"]]},{"verse":20,"text":"ダビデはまた、すべての羊と牛を取った。彼らはこの家畜の先に立って導き、「これはダビデの分捕り物です」と言った。","tok":[["ダビデ"],["は"],["また"],["、"],["すべて"],["の"],["羊","ひつじ"],["と"],["牛","うし"],["を"],["取った","とった"],["。"],["彼","かれ"],["ら"],["は"],["この"],["家畜","かちく"],["の"],["先","さき"],["に"],["立って","たって"],["導き","みちびき"],["、"],["「"],["これ"],["は"],["ダビデ"],["の"],["分","ぶん"],["捕り物","とりもの"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":21,"text":"ダビデが、疲れてダビデについて来ることができずにベソル川のほとりにとどまっていた二百人の者のところに来たとき、彼らはダビデと彼に従った者たちを迎えに出て来た。ダビデはこの人たちに近づいて彼らの安否を尋ねた。","tok":[["ダビデ"],["が"],["、"],["疲れて","つかれて"],["ダビデ"],["について"],["来る","くる"],["こと"],["が"],["できず"],["に"],["ベソル"],["川","かわ"],["の"],["ほとり"],["に"],["とどまって"],["いた"],["二百人","にひゃくにん"],["の"],["者","もの"],["の"],["ところ"],["に"],["来た","きた"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["ダビデ"],["と"],["彼","かれ"],["に"],["従った","したがった"],["者","もの"],["たち"],["を"],["迎え","むかえ"],["に"],["出て","でて"],["来た","きた"],["。"],["ダビデ"],["は"],["この"],["人","ひと"],["たち"],["に"],["近づいて","ちかづいて"],["彼","かれ"],["ら"],["の"],["安否","あんぴ"],["を"],["尋ねた","たずねた"],["。"]]},{"verse":22,"text":"そのとき、ダビデといっしょに行った者たちのうち、意地の悪い、よこしまな者たちがみな、口々に言った。「彼らはいっしょに行かなかったのだから、われわれが取り戻した分捕り物を、彼らに分けてやるわけにはいかない。ただ、めいめい自分の妻と子どもを連れて行くがよい。」","tok":[["その"],["とき"],["、"],["ダビデ"],["と"],["いっしょ"],["に"],["行った","いった"],["者","もの"],["たち"],["の"],["うち"],["、"],["意地","いじ"],["の"],["悪い","わるい"],["、"],["よこしま"],["な"],["者","もの"],["たち"],["が"],["みな"],["、"],["口々","くちぐち"],["に"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["いっしょ"],["に"],["行かなかった","いかなかった"],["の"],["だ"],["から"],["、"],["われわれ"],["が"],["取り戻した","とりもどした"],["分捕り物","ぶんどりぶつ"],["を"],["、"],["彼","かれ"],["ら"],["に"],["分けて","わけて"],["やる"],["わけ"],["に"],["は"],["いかない"],["。"],["ただ"],["、"],["めいめい"],["自分","じぶん"],["の"],["妻","つま"],["と"],["子ども","こども"],["を"],["連れて","つれて"],["行く","いく"],["が"],["よい"],["。"],["」"]]},{"verse":23,"text":"ダビデは言った。「兄弟たちよ。主が私たちに賜った物を、そのようにしてはならない。主が私たちを守り、私たちを襲った略奪隊を私たちの手に渡されたのだ。","tok":[["ダビデ"],["は"],["言った","いった"],["。"],["「"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["主","ぬし"],["が"],["私たち","わたしたち"],["に"],["賜った","たまわった"],["物","もの"],["を"],["、"],["その"],["よう"],["に"],["して"],["は"],["ならない"],["。"],["主","ぬし"],["が"],["私たち","わたしたち"],["を"],["守り","まもり"],["、"],["私たち","わたしたち"],["を"],["襲った","おそった"],["略奪隊","りゃくだつたい"],["を"],["私たち","わたしたち"],["の"],["手","て"],["に"],["渡された","わたされた"],["の"],["だ"],["。"]]},{"verse":24,"text":"だれが、このことについて、あなたがたの言うことを聞くだろうか。戦いに下って行った者への分け前も、荷物のそばにとどまっていた者への分け前も同じだ。共に同じく分け合わなければならない。」","tok":[["だれ"],["が"],["、"],["この"],["こと"],["について"],["、"],["あなた"],["がた"],["の"],["言う","いう"],["こと"],["を"],["聞くだろう","きくだろう"],["か"],["。"],["戦い","たたかい"],["に"],["下って","くだって"],["行った","いった"],["者","もの"],["へ"],["の"],["分け前","わけまえ"],["も"],["、"],["荷物","にもつ"],["の"],["そば"],["に"],["とどまって"],["いた"],["者","もの"],["へ"],["の"],["分け前","わけまえ"],["も"],["同じ","おなじ"],["だ"],["。"],["共","とも"],["に"],["同じく","おなじく"],["分け合わなければ","わけあわなければ"],["ならない"],["。"],["」"]]},{"verse":25,"text":"その日以来、ダビデはこれをイスラエルのおきてとし、定めとした。今日もそうである。","tok":[["その"],["日","ひ"],["以来","いらい"],["、"],["ダビデ"],["は"],["これ"],["を"],["イスラエル"],["の"],["おきて"],["と"],["し"],["、"],["定め","さだめ"],["と"],["した"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":26,"text":"ダビデはツィケラグに帰って、友人であるユダの長老たちに分捕り物のいくらかを送って言った。「これはあなたがたへの贈り物で、主の敵からの分捕り物の一部です。」","tok":[["ダビデ"],["は"],["ツィケラグ"],["に"],["帰って","かえって"],["、"],["友人","ゆうじん"],["で"],["ある"],["ユダ"],["の"],["長老","ちょうろう"],["たち"],["に"],["分捕り","ぶんどり"],["物","もの"],["の"],["いくら"],["か"],["を"],["送って","おくって"],["言った","いった"],["。"],["「"],["これ"],["は"],["あなた"],["が"],["たへ"],["の"],["贈り物","おくりもの"],["で"],["、"],["主","ぬし"],["の"],["敵","てき"],["から"],["の"],["分","ぶん"],["捕り物","とりもの"],["の"],["一部","いちぶ"],["です"],["。"],["」"]]},{"verse":27,"text":"その送り先は、ベテルの人々、ネゲブのラモテの人々、ヤティルの人々、","tok":[["その"],["送り先","おくりさき"],["は"],["、"],["ベテル"],["の"],["人々","ひとびと"],["、"],["ネゲブ"],["の"],["ラモテ"],["の"],["人々","ひとびと"],["、"],["ヤティル"],["の"],["人々","ひとびと"],["、"]]},{"verse":28,"text":"アロエルの人々、シフモテの人々、エシュテモアの人々、","tok":[["アロエル"],["の"],["人々","ひとびと"],["、"],["シフモテ"],["の"],["人々","ひとびと"],["、"],["エシュテモア"],["の"],["人々","ひとびと"],["、"]]},{"verse":29,"text":"ラカルの人々、エラフメエル人の町々の人たち、ケニ人の町々の人たち、","tok":[["ラカル"],["の"],["人々","ひとびと"],["、"],["エラフメエル"],["人","にん"],["の"],["町々","まちまち"],["の"],["人","ひと"],["たち"],["、"],["ケニ"],["人","ひと"],["の"],["町々","まちまち"],["の"],["人","ひと"],["たち"],["、"]]},{"verse":30,"text":"ホルマの人々、ボル・アシャンの人々、アタクの人々、","tok":[["ホルマ"],["の"],["
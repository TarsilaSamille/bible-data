[{"verse":1,"text":"サムエルのことばが全イスラエルに行き渡ったころ、イスラエルはペリシテ人を迎え撃つために戦いに出て、エベン・エゼルのあたりに陣を敷いた。ペリシテ人はアフェクに陣を敷いた。","tok":[["サムエル"],["の"],["ことば"],["が"],["全","ぜん"],["イスラエル"],["に"],["行き","いき"],["渡った","わたった"],["ころ"],["、"],["イスラエル"],["は"],["ペリシテ"],["人","にん"],["を"],["迎え撃つ","むかえうつ"],["ため"],["に"],["戦い","たたかい"],["に"],["出て","でて"],["、"],["エベン"],["・"],["エゼル"],["の"],["あたり"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["ペリシテ"],["人","にん"],["は"],["アフェク"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"]]},{"verse":2,"text":"ペリシテ人はイスラエルを迎え撃つ陣ぞなえをした。戦いが始まると、イスラエルはペリシテ人に打ち負かされ、約四千人が野の陣地で打たれた。","tok":[["ペリシテ"],["人","にん"],["は"],["イスラエル"],["を"],["迎え撃つ","むかえうつ"],["陣","じん"],["ぞ"],["なえ"],["を"],["した"],["。"],["戦い","たたかい"],["が"],["始まる","はじまる"],["と"],["、"],["イスラエル"],["は"],["ペリシテ"],["人","にん"],["に"],["打ち負かされ","うちまかされ"],["、"],["約","やく"],["四千人","よんせんにん"],["が"],["野","の"],["の"],["陣地","じんち"],["で"],["打たれた","うたれた"],["。"]]},{"verse":3,"text":"民が陣営に戻って来たとき、イスラエルの長老たちは言った。「なぜ主は、きょう、ペリシテ人の前でわれわれを打ったのだろう。シロから主の契約の箱をわれわれのところに持って来よう。そうすれば、それがわれわれの真ん中に来て、われわれを敵の手から救おう。」","tok":[["民","みん"],["が"],["陣営","じんえい"],["に"],["戻って","もどって"],["来た","きた"],["とき"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["は"],["言った","いった"],["。"],["「"],["なぜ"],["主","ぬし"],["は"],["、"],["きょう"],["、"],["ペリシテ"],["人","にん"],["の"],["前","まえ"],["で"],["われわれ"],["を"],["打った","うった"],["の"],["だろう"],["。"],["シロ"],["から"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["われわれ"],["の"],["ところ"],["に"],["持って","もって"],["来よう","こよう"],["。"],["そう"],["すれば"],["、"],["それ"],["が"],["われわれ"],["の"],["真ん中","まんなか"],["に"],["来て","きて"],["、"],["われわれ"],["を"],["敵","てき"],["の"],["手","て"],["から"],["救おう","すくおう"],["。"],["」"]]},{"verse":4,"text":"そこで民はシロに人を送った。彼らはそこから、ケルビムに座しておられる万軍の主の契約の箱をかついで来た。エリのふたりの息子、ホフニとピネハスも、神の契約の箱といっしょにそこに来た。","tok":[["そこ"],["で"],["民","たみ"],["は"],["シロ"],["に"],["人","ひと"],["を"],["送った","おくった"],["。"],["彼","かれ"],["ら"],["は"],["そこ"],["から"],["、"],["ケルビム"],["に"],["座して","ざして"],["おられる"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["かついで"],["来た","きた"],["。"],["エリ"],["の"],["ふたり"],["の"],["息子","むすこ"],["、"],["ホフニ"],["と"],["ピネハス"],["も"],["、"],["神","かみ"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["と"],["いっしょ"],["に"],["そこ"],["に"],["来た","きた"],["。"]]},{"verse":5,"text":"主の契約の箱が陣営に着いたとき、全イスラエルは大歓声をあげた。それで地はどよめいた。","tok":[["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["が"],["陣営","じんえい"],["に"],["着いた","ついた"],["とき"],["、"],["全","ぜん"],["イスラエル"],["は"],["大","だい"],["歓声","かんせい"],["を"],["あげた"],["。"],["それ"],["で"],["地","ち"],["は"],["どよめいた"],["。"]]},{"verse":6,"text":"ペリシテ人は、その歓声を聞いて、「ヘブル人の陣営の、あの大歓声は何だろう」と言った。そして、主の箱が陣営に着いたと知ったとき、","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["その"],["歓声","かんせい"],["を"],["聞いて","きいて"],["、"],["「"],["ヘブル人","へぶるにん"],["の"],["陣営","じんえい"],["の"],["、"],["あの"],["大","だい"],["歓声","かんせい"],["は"],["何","なん"],["だろう"],["」"],["と"],["言った","いった"],["。"],["そして"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["が"],["陣営","じんえい"],["に"],["着いた","ついた"],["と"],["知った","しった"],["とき"],["、"]]},{"verse":7,"text":"ペリシテ人は、「神が陣営に来た」と言って、恐れた。そして言った。「ああ、困ったことだ。今まで、こんなことはなかった。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["「"],["神","かみ"],["が"],["陣営","じんえい"],["に"],["来た","きた"],["」"],["と"],["言って","いって"],["、"],["恐れた","おそれた"],["。"],["そして"],["言った","いった"],["。"],["「"],["ああ"],["、"],["困った","こまった"],["こと"],["だ"],["。"],["今まで","いままで"],["、"],["こんな"],["こと"],["は"],["なかった"],["。"]]},{"verse":8,"text":"ああ、困ったことだ。だれがこの力ある神々の手から、われわれを救い出してくれよう。これらの神々は、荒野で、ありとあらゆる災害をもってエジプトを打った神々だ。","tok":[["ああ"],["、"],["困った","こまった"],["こと"],["だ"],["。"],["だれ"],["が"],["この"],["力","ちから"],["ある"],["神々","かみがみ"],["の"],["手","て"],["から"],["、"],["われわれ"],["を"],["救い出して","すくいだして"],["くれよう"],["。"],["これ"],["ら"],["の"],["神々","かみがみ"],["は"],["、"],["荒野","あらの"],["で"],["、"],["あり"],["と"],["あらゆる"],["災害","さいがい"],["を"],["もって"],["エジプト"],["を"],["打った","うった"],["神々","かみがみ"],["だ"],["。"]]},{"verse":9,"text":"さあ、ペリシテ人よ。奮い立て。男らしくふるまえ。さもないと、ヘブル人がおまえたちに仕えたように、おまえたちがヘブル人に仕えるようになる。男らしくふるまって戦え。」","tok":[["さあ"],["、"],["ペリシテ"],["人","にん"],["よ"],["。"],["奮い立て","ふるいたて"],["。"],["男","おとこ"],["らしく"],["ふるまえ"],["。"],["さも"],["ない"],["と"],["、"],["ヘブル人","へぶるにん"],["が"],["おまえ"],["たち"],["に"],["仕えた","つかえた"],["よう"],["に"],["、"],["おまえ"],["たち"],["が"],["ヘブル人","へぶるにん"],["に"],["仕える","つかえる"],["よう"],["に"],["なる"],["。"],["男","おとこ"],["らしく"],["ふるまって"],["戦え","たたかえ"],["。"],["」"]]},{"verse":10,"text":"こうしてペリシテ人は戦ったので、イスラエルは打ち負かされ、おのおの自分たちの天幕に逃げた。そのとき、非常に激しい疫病が起こり、イスラエルの歩兵三万人が倒れた。","tok":[["こう"],["して"],["ペリシテ"],["人","にん"],["は"],["戦った","たたかった"],["ので"],["、"],["イスラエル"],["は"],["打ち負かされ","うちまかされ"],["、"],["おのおの"],["自分","じぶん"],["たち"],["の"],["天幕","てんまく"],["に"],["逃げた","にげた"],["。"],["その"],["とき"],["、"],["非常","ひじょう"],["に"],["激しい","はげしい"],["疫病","やくびょう"],["が"],["起こり","おこり"],["、"],["イスラエル"],["の"],["歩兵","ふひょう"],["三万人","さんまんにん"],["が"],["倒れた","たおれた"],["。"]]},{"verse":11,"text":"神の箱は奪われ、エリのふたりの息子、ホフニとピネハスは死んだ。","tok":[["神","かみ"],["の"],["箱","ばこ"],["は"],["奪われ","うばわれ"],["、"],["エリ"],["の"],["ふたり"],["の"],["息子","むすこ"],["、"],["ホフニ"],["と"],["ピネハス"],["は"],["死んだ","しんだ"],["。"]]},{"verse":12,"text":"その日、ひとりのベニヤミン人が、戦場から走って来て、シロに着いた。その着物は裂け、頭には土をかぶっていた。","tok":[["その"],["日","ひ"],["、"],["ひとり"],["の"],["ベニヤミン"],["人","にん"],["が"],["、"],["戦場","せんじょう"],["から"],["走って","はしって"],["来て","きて"],["、"],["シロ"],["に"],["着いた","ついた"],["。"],["その"],["着物","きもの"],["は"],["裂け","さけ"],["、"],["頭","あたま"],["に"],["は"],["土","つち"],["を"],["かぶって"],["いた"],["。"]]},{"verse":13,"text":"彼が着いたとき、エリは道のそばに設けた席にすわって、見張っていた。神の箱のことを気づかっていたからである。この男が町に入って敗戦を知らせたので、町中こぞって泣き叫んだ。","tok":[["彼","かれ"],["が"],["着いた","ついた"],["とき"],["、"],["エリ"],["は"],["道","みち"],["の"],["そば"],["に"],["設けた","もうけた"],["席","せき"],["に"],["すわって"],["、"],["見張って","みはって"],["いた"],["。"],["神","かみ"],["の"],["箱","ばこ"],["の"],["こと"],["を"],["気づかって","きづかって"],["いた"],["から"],["で"],["ある"],["。"],["この"],["男","おとこ"],["が"],["町","まち"],["に"],["入って","はいって"],["敗戦","はいせん"],["を"],["知らせた","しらせた"],["ので"],["、"],["町中","まちなか"],["こぞって"],["泣き叫んだ","なきさけんだ"],["。"]]},{"verse":14,"text":"エリが、この泣き叫ぶ声を聞いて、「この騒々しい声は何だ」と尋ねると、この者は大急ぎでやって来て、エリに知らせた。","tok":[["エリ"],["が"],["、"],["この"],["泣き叫ぶ","なきさけぶ"],["声","こえ"],["を"],["聞いて","きいて"],["、"],["「"],["この"],["騒々しい","そうぞうしい"],["声","こえ"],["は"],["何","なん"],["だ"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["この"],["者","もの"],["は"],["大急ぎ","おおいそぎ"],["で"],["やって"],["来て","きて"],["、"],["エリ"],["に"],["知らせた","しらせた"],["。"]]},{"verse":15,"text":"エリは九十八歳で、その目はこわばり、何も見えなくなっていた。","tok":[["エリ"],["は"],["九十八歳","きゅうじゅうはちさい"],["で"],["、"],["その"],["目","め"],["は"],["こわばり"],["、"],["何","なん"],["も"],["見えなく","みえなく"],["なって"],["いた"],["。"]]},{"verse":16,"text":"その男はエリに言った。「私は戦場から来た者です。私は、きょう、戦場から逃げて来ました。」するとエリは、「状況はどうか。わが子よ」と聞いた。","tok":[["その"],["男","おとこ"],["は"],["エリ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["戦場","せんじょう"],["から"],["来た","きた"],["者","もの"],["です"],["。"],["私","わたくし"],["は"],["、"],["きょう"],["、"],["戦場","せんじょう"],["から"],["逃げて","にげて"],["来ました","きました"],["。"],["」"],["する"],["と"],["エリ"],["は"],["、"],["「"],["状況","じょうきょう"],["は"],["どう"],["か"],["。"],["わが"],["子","こ"],["よ"],["」"],["と"],["聞いた","きいた"],["。"]]},{"verse":17,"text":"この知らせを持って来た者は答えて言った。「イスラエルはペリシテ人の前から逃げ、民のうちに打たれた者が多く出ました。それにあなたのふたりの子息、ホフニとピネハスも死に、神の箱は奪われました。」","tok":[["この"],["知らせ","しらせ"],["を"],["持って","もって"],["来た","きた"],["者","もの"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["イスラエル"],["は"],["ペリシテ"],["人","にん"],["の"],["前","まえ"],["から"],["逃げ","にげ"],["、"],["民","みん"],["の"],["うち"],["に"],["打たれた","うたれた"],["者","もの"],["が"],["多く","おおく"],["出ました","でました"],["。"],["それ"],["に"],["あなた"],["の"],["ふたり"],["の"],["子息","しそく"],["、"],["ホフニ"],["と"],["ピネハス"],["も"],["死に","しに"],["、"],["神","かみ"],["の"],["箱","ばこ"],["は"],["奪われました","うばわれました"],["。"],["」"]]},{"verse":18,"text":"彼が神の箱のことを告げたとき、エリはその席から門のそばにあおむけに落ち、首を折って死んだ。年寄りで、からだが重かったからである。彼は四十年間、イスラエルをさばいた。","tok":[["彼","かれ"],["が"],["神","かみ"],["の"],["箱","ばこ"],["の"],["こと"],["を"],["告げた","つげた"],["とき"],["、"],["エリ"],["は"],["その"],["席","せき"],["から"],["門","もん"],["の"],["そば"],["に"],["あおむけ"],["に"],["落ち","おち"],["、"],["首","くび"],["を"],["折って","おって"],["死んだ","しんだ"],["。"],["年寄り","としより"],["で"],["、"],["からだ"],["が"],["重かった","おもかった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["四十","よんじゅう"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":19,"text":"彼の嫁、ピネハスの妻は身ごもっていて、出産間近であったが、神の箱が奪われ、しゅうとと、夫が死んだという知らせを聞いたとき、陣痛が起こり、身をかがめて子を産んだ。","tok":[["彼","かれ"],["の"],["嫁","よめ"],["、"],["ピネハス"],["の"],["妻","つま"],["は"],["身ごもって","みごもって"],["いて"],["、"],["出産","しゅっさん"],["間近","まじか"],["で"],["あった"],["が"],["、"],["神","かみ"],["の"],["箱","ばこ"],["が"],["奪われ","うばわれ"],["、"],["しゅうと"],["と"],["、"],["夫","おっと"],["が"],["死んだ","しんだ"],["と"],["いう"],["知らせ","しらせ"],["を"],["聞いた","きいた"],["とき"],["、"],["陣痛","じんつう"],["が"],["起こり","おこり"],["、"],["身","み"],["を"],["かがめて"],["子","こ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":20,"text":"彼女が死にかけているので、彼女の世話をしていた女たちが、「しっかりしなさい。男の子が生まれましたよ」と言ったが、彼女は答えもせず、気にも留めなかった。","tok":[["彼女","かのじょ"],["が"],["死に","しに"],["かけて"],["いる"],["ので"],["、"],["彼女","かのじょ"],["の"],["世話","せわ"],["を"],["して"],["いた"],["女","おんな"],["たち"],["が"],["、"],["「"],["しっかり"],["し"],["なさい"],["。"],["男の子","おとこのこ"],["が"],["生まれました","うまれました"],["よ"],["」"],["と"],["言った","いった"],["が"],["、"],["彼女","かのじょ"],["は"],["答え","こたえ"],["も"],["せず"],["、"],["気","き"],["に"],["も"],["留めなかった","とめなかった"],["。"]]},{"verse":21,"text":"彼女は、「栄光がイスラエルから去った」と言って、その子をイ・カボデと名づけた。これは神の箱が奪われたこと、それに、しゅうとと、夫のことをさしたのである。","tok":[["彼女","かのじょ"],["は"],["、"],["「"],["栄光","えいこう"],["が"],["イスラエル"],["から"],["去った","さった"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["イ"],["・"],["カボデ"],["と"],["名づけた","なづけた"],["。"],["これ"],["は"],["神","かみ"],["の"],["箱","ばこ"],["が"],["奪われた","うばわれた"],["こと"],["、"],["それ"],["に"],["、"],["しゅうと"],["と"],["、"],["夫","おっと"],["の"],["こと"],["を"],["さした"],["ので"],["ある"],["。"]]},{"verse":22,"text":"彼女は、「栄光はイスラエルを去りました。神の箱が奪われたから」と言った。","tok":[["彼女","かのじょ"],["は"],["、"],["「"],["栄光","えいこう"],["は"],["イスラエル"],["を"],["去りました","さりました"],["。"],["神","かみ"],["の"],["箱","ばこ"],["が"],["奪われた","うばわれた"],["から"],["」"],["と"],["言った","いった"],["。"]]}]
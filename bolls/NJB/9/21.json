[{"verse":1,"text":"ダビデはノブの祭司アヒメレクのところに行った。アヒメレクはダビデを迎え、恐る恐る彼に言った。「なぜ、おひとりで、だれもお供がいないのですか。」","tok":[["ダビデ"],["は"],["ノブ"],["の"],["祭司","さいし"],["アヒメレク"],["の"],["ところ"],["に"],["行った","いった"],["。"],["アヒメレク"],["は"],["ダビデ"],["を"],["迎え","むかえ"],["、"],["恐る恐る","おそるおそる"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["おひとり"],["で"],["、"],["だれ"],["も"],["お供","おとも"],["が"],["いない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":2,"text":"ダビデは祭司アヒメレクに言った。「王は、ある事を命じて、『おまえを遣わし、おまえに命じた事については、何事も人に知らせてはならない』と私に言われました。若い者たちとは、しかじかの場所で落ち合うことにしています。","tok":[["ダビデ"],["は"],["祭司","さいし"],["アヒメレク"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["は"],["、"],["ある"],["事","こと"],["を"],["命じて","めいじて"],["、"],["『"],["おまえ"],["を"],["遣わし","つかわし"],["、"],["おまえ"],["に"],["命じた","めいじた"],["事","こと"],["について"],["は"],["、"],["何事","なにごと"],["も"],["人","ひと"],["に"],["知らせて","しらせて"],["は"],["ならない"],["』"],["と"],["私","わたくし"],["に"],["言われました","いわれました"],["。"],["若い","わかい"],["者","もの"],["たち"],["と"],["は"],["、"],["しかじか"],["の"],["場所","ばしょ"],["で"],["落ち合う","おちあう"],["こと"],["に"],["して"],["います"],["。"]]},{"verse":3,"text":"ところで、今、お手もとに何かあったら、五つのパンでも、何か、ある物を私に下さい。」","tok":[["ところ"],["で"],["、"],["今","いま"],["、"],["お手もと","おてもと"],["に"],["何","なん"],["か"],["あったら"],["、"],["五","いつ"],["つ"],["の"],["パン"],["で"],["も"],["、"],["何","なん"],["か"],["、"],["ある"],["物","もの"],["を"],["私","わたくし"],["に"],["下さい","ください"],["。"],["」"]]},{"verse":4,"text":"祭司はダビデに答えて言った。「普通のパンは手もとにありません。ですが、もし若い者たちが女から遠ざかっているなら、聖別されたパンがあります。」","tok":[["祭司","さいし"],["は"],["ダビデ"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["普通","ふつう"],["の"],["パン"],["は"],["手もと","てもと"],["に"],["ありません"],["。"],["です"],["が"],["、"],["もし"],["若い","わかい"],["者","もの"],["たち"],["が"],["女","おんな"],["から"],["遠ざかって","とおざかって"],["いるなら"],["、"],["聖別","せいべつ"],["された"],["パン"],["が"],["あります"],["。"],["」"]]},{"verse":5,"text":"ダビデは祭司に答えて言った。「確かにこれまでのように、私が出かけて以来、私たちは女を遠ざけています。それで若い者たちは汚れていません。普通の旅でもそうですから、ましてきょうは確かに汚れていません。」","tok":[["ダビデ"],["は"],["祭司","さいし"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["確か","たしか"],["に"],["これ"],["まで"],["の"],["よう"],["に"],["、"],["私","わたくし"],["が"],["出かけて","でかけて"],["以来","いらい"],["、"],["私たち","わたしたち"],["は"],["女","おんな"],["を"],["遠ざけて","とおざけて"],["います"],["。"],["それ"],["で"],["若い","わかい"],["者","もの"],["たち"],["は"],["汚れて","よごれて"],["いません"],["。"],["普通","ふつう"],["の"],["旅","たび"],["で"],["も"],["そう"],["です"],["から"],["、"],["まして"],["きょう"],["は"],["確か","たしか"],["に"],["汚れて","よごれて"],["いません"],["。"],["」"]]},{"verse":6,"text":"そこで祭司は彼に聖別されたパンを与えた。そこには、その日、あたたかいパンと置きかえられて、主の前から取り下げられた供えのパンしかなかったからである。","tok":[["そこ"],["で"],["祭司","さいし"],["は"],["彼","かれ"],["に"],["聖別","せいべつ"],["された"],["パン"],["を"],["与えた","あたえた"],["。"],["そこ"],["に"],["は"],["、"],["その"],["日","ひ"],["、"],["あたたかい"],["パン"],["と"],["置きかえられて","おきかえられて"],["、"],["主","ぬし"],["の"],["前","まえ"],["から"],["取り下げられた","とりさげられた"],["供え","そなえ"],["の"],["パン"],["しか"],["なかった"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"――その日、そこにはサウルのしもべのひとりが主の前に引き止められていた。その名はドエグといって、エドム人であり、サウルの牧者たちの中のつわものであった――","tok":[["―"],["―"],["その"],["日","ひ"],["、"],["そこ"],["に"],["は"],["サウル"],["の"],["しもべ"],["の"],["ひとり"],["が"],["主","ぬし"],["の"],["前","まえ"],["に"],["引き止められて","ひきとめられて"],["いた"],["。"],["その"],["名","な"],["は"],["ドエグ"],["と"],["いって"],["、"],["エドム人","えどむにん"],["で"],["あり"],["、"],["サウル"],["の"],["牧者","ぼくしゃ"],["たち"],["の"],["中","なか"],["の"],["つわもの"],["で"],["あった"],["―"],["―"]]},{"verse":8,"text":"ダビデはアヒメレクに言った。「ここに、あなたの手もとに、槍か、剣はありませんか。私は自分の剣も武器も持って来なかったのです。王の命令があまり急だったので。」","tok":[["ダビデ"],["は"],["アヒメレク"],["に"],["言った","いった"],["。"],["「"],["ここ"],["に"],["、"],["あなた"],["の"],["手もと","てもと"],["に"],["、"],["槍","やり"],["か"],["、"],["剣","けん"],["は"],["ありません"],["か"],["。"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["剣","けん"],["も"],["武器","ぶき"],["も"],["持って","もって"],["来なかった","こなかった"],["の"],["です"],["。"],["王","おう"],["の"],["命令","めいれい"],["が"],["あまり"],["急","きゅう"],["だった"],["ので"],["。"],["」"]]},{"verse":9,"text":"祭司は言った。「あなたがエラの谷で打ち殺したペリシテ人ゴリヤテの剣が、ご覧なさい、エポデのうしろに布に包んであります。よろしければ、持って行ってください。ここには、それしかありませんから。」ダビデは言った。「それは何よりです。私に下さい。」","tok":[["祭司","さいし"],["は"],["言った","いった"],["。"],["「"],["あなた"],["が"],["エラ"],["の"],["谷","たに"],["で"],["打ち殺した","うちころした"],["ペリシテ"],["人","にん"],["ゴリヤテ"],["の"],["剣","けん"],["が"],["、"],["ご覧","ごらん"],["なさい"],["、"],["エポデ"],["の"],["うしろ"],["に"],["布","ぬの"],["に"],["包んで","つつんで"],["あります"],["。"],["よろしければ"],["、"],["持って","もって"],["行って","いって"],["ください"],["。"],["ここ"],["に"],["は"],["、"],["それ"],["しか"],["ありません"],["から"],["。"],["」"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["それ"],["は"],["何","なん"],["より"],["です"],["。"],["私","わたくし"],["に"],["下さい","ください"],["。"],["」"]]},{"verse":10,"text":"ダビデはその日、すぐにサウルからのがれ、ガテの王アキシュのところへ行った。","tok":[["ダビデ"],["は"],["その"],["日","ひ"],["、"],["すぐ"],["に"],["サウル"],["から"],["のがれ"],["、"],["ガテ"],["の"],["王","おう"],["アキシュ"],["の"],["ところ"],["へ"],["行った","いった"],["。"]]},{"verse":11,"text":"するとアキシュの家来たちがアキシュに言った。「この人は、あの国の王ダビデではありませんか。みなが踊りながら、『サウルは千を打ち、ダビデは万を打った』／と言って歌っていたのは、この人のことではありませんか。」","tok":[["する"],["と"],["アキシュ"],["の"],["家来","けらい"],["たち"],["が"],["アキシュ"],["に"],["言った","いった"],["。"],["「"],["この"],["人","ひと"],["は"],["、"],["あの"],["国","くに"],["の"],["王","おう"],["ダビデ"],["で"],["は"],["ありません"],["か"],["。"],["みな"],["が"],["踊り","おどり"],["ながら"],["、"],["『"],["サウル"],["は"],["千","せん"],["を"],["打ち","うち"],["、"],["ダビデ"],["は"],["万","よろず"],["を"],["打った","うった"],["』"],["／"],["と"],["言って","いって"],["歌って","うたって"],["いた"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["で"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":12,"text":"ダビデは、このことばを気にして、ガテの王アキシュを非常に恐れた。","tok":[["ダビデ"],["は"],["、"],["この"],["ことば"],["を"],["気","き"],["に"],["して"],["、"],["ガテ"],["の"],["王","おう"],["アキシュ"],["を"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":13,"text":"それでダビデは彼らの前で気が違ったかのようにふるまい、捕らえられて狂ったふりをし、門のとびらに傷をつけたり、ひげによだれを流したりした。","tok":[["それ"],["で"],["ダビデ"],["は"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["気","き"],["が"],["違った","ちがった"],["か"],["の"],["よう"],["に"],["ふるまい"],["、"],["捕らえられて","とらえられて"],["狂った","くるった"],["ふり"],["を"],["し"],["、"],["門","もん"],["の"],["とびら"],["に"],["傷","きず"],["を"],["つけ"],["たり"],["、"],["ひげ"],["に"],["よだれ"],["を"],["流し","ながし"],["たり"],["した"],["。"]]},{"verse":14,"text":"アキシュは家来たちに言った。「おい、おまえたちも見るように、この男は気が狂っている。なぜ、私のところに連れて来たのか。","tok":[["アキシュ"],["は"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["おい"],["、"],["おまえ"],["たち"],["も"],["見る","みる"],["よう"],["に"],["、"],["この"],["男","おとこ"],["は"],["気","き"],["が"],["狂って","くるって"],["いる"],["。"],["なぜ"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["連れて","つれて"],["来た","きた"],["の"],["か"],["。"]]},{"verse":15,"text":"私に気の狂った者が足りないとでもいうのか。私の前で狂っているのを見せるために、この男を連れて来るとは。この男を私の家に入れようとでもいうのか。」","tok":[["私","わたくし"],["に"],["気","き"],["の"],["狂った","くるった"],["者","もの"],["が"],["足りない","たりない"],["と"],["で"],["も"],["いう"],["の"],["か"],["。"],["私","わたくし"],["の"],["前","まえ"],["で"],["狂って","くるって"],["いる"],["の"],["を"],["見せる","みせる"],["ため"],["に"],["、"],["この"],["男","おとこ"],["を"],["連れて","つれて"],["来る","くる"],["と"],["は"],["。"],["この"],["男","おとこ"],["を"],["私","わたくし"],["の"],["家","いえ"],["に"],["入れよう","いれよう"],["と"],["で"],["も"],["いう"],["の"],["か"],["。"],["」"]]}]
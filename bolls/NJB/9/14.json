,["行くべきでしょう","いくべきでしょう"],["か"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["イスラエル"],["の"],["手","て"],["に"],["渡して","わたして"],["くださる"],["の"],["でしょう"],["か"],["。"],["」"],["しかし"],["その"],["日","ひ"],["は"],["何","なん"],["の"],["答え","こたえ"],["も"],["なかった"],["。"]]},{"verse":38,"text":"そこでサウルは言った。「民のかしらたちはみな、ここに寄って来なさい。きょう、どうしてこのような罪が起こったかを確かめてみなさい。","tok":[["そこ"],["で"],["サウル"],["は"],["言った","いった"],["。"],["「"],["民","みん"],["の"],["かしら"],["たち"],["は"],["みな"],["、"],["ここ"],["に"],["寄って","よって"],["来","き"],["なさい"],["。"],["きょう"],["、"],["どう"],["して"],["この"],["よう"],["な"],["罪","つみ"],["が"],["起こった","おこった"],["か"],["を"],["確かめて","たしかめて"],["み"],["なさい"],["。"]]},{"verse":39,"text":"まことに、イスラエルを救う主は生きておられる。たとい、それが私の子ヨナタンであっても、彼は必ず死ななければならない。」しかし民のうちだれもこれに答える者はいなかった。","tok":[["まこと"],["に"],["、"],["イスラエル"],["を"],["救う","すくう"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["たとい"],["、"],["それ"],["が"],["私","わたくし"],["の"],["子","こ"],["ヨナタン"],["で"],["あって"],["も"],["、"],["彼","かれ"],["は"],["必ず","かならず"],["死ななければ","しななければ"],["ならない"],["。"],["」"],["しかし"],["民","みん"],["の"],["うち"],["だれ"],["も"],["これ"],["に"],["答える","こたえる"],["者","もの"],["は"],["いなかった"],["。"]]},{"verse":40,"text":"サウルはすべてのイスラエル人に言った。「あなたがたは、こちら側にいなさい。私と、私の子ヨナタンは、あちら側にいよう。」民はサウルに言った。「あなたのお気に召すようにしてください。」","tok":[["サウル"],["は"],["すべて"],["の"],["イスラエル"],["人","にん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["こちら側","こちらがわ"],["に"],["い"],["なさい"],["。"],["私","わたくし"],["と"],["、"],["私","わたくし"],["の"],["子","こ"],["ヨナタン"],["は"],["、"],["あちら側","あちらがわ"],["に"],["いよう"],["。"],["」"],["民","みん"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["お気","おき"],["に"],["召す","めす"],["よう"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":41,"text":"そこでサウルはイスラエルの神、主に、「みこころをお示しください」と言った。すると、ヨナタンとサウルが取り分けられ、民ははずれた。","tok":[["そこ"],["で"],["サウル"],["は"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["「"],["みこころ"],["を"],["お示し","おしめし"],["ください"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["、"],["ヨナタン"],["と"],["サウル"],["が"],["取り分けられ","とりわけられ"],["、"],["民","みん"],["は"],["はずれた"],["。"]]},{"verse":42,"text":"それでサウルは言った。「私か、私の子ヨナタンかを決めてください。」するとヨナタンが取り分けられた。","tok":[["それ"],["で"],["サウル"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["か"],["、"],["私","わたくし"],["の"],["子","こ"],["ヨナタン"],["か"],["を"],["決めて","きめて"],["ください"],["。"],["」"],["する"],["と"],["ヨナタン"],["が"],["取り分けられた","とりわけられた"],["。"]]},{"verse":43,"text":"サウルはヨナタンに言った。「何をしたのか、私に告げなさい。」そこでヨナタンは彼に告げて言った。「私は手にあった杖の先で、少しばかりの蜜を、確かに味見しましたが。ああ、私は死ななければなりません。」","tok":[["サウル"],["は"],["ヨナタン"],["に"],["言った","いった"],["。"],["「"],["何","なん"],["を"],["した"],["の"],["か"],["、"],["私","わたくし"],["に"],["告げ","つげ"],["なさい"],["。"],["」"],["そこ"],["で"],["ヨナタン"],["は"],["彼","かれ"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["手","て"],["に"],["あった"],["杖","つえ"],["の"],["先","さき"],["で"],["、"],["少し","すこし"],["ばかり"],["の"],["蜜","みつ"],["を"],["、"],["確か","たしか"],["に"],["味見","あじみ"],["しました"],["が"],["。"],["ああ"],["、"],["私","わたくし"],["は"],["死ななければ","しななければ"],["なりません"],["。"],["」"]]},{"verse":44,"text":"サウルは言った。「神が幾重にも罰してくださるように。ヨナタン。おまえは必ず死ななければならない。」","tok":[["サウル"],["は"],["言った","いった"],["。"],["「"],["神","かみ"],["が"],["幾重","いくえ"],["に"],["も"],["罰して","ばっして"],["くださる"],["よう"],["に"],["。"],["ヨナタン"],["。"],["おまえ"],["は"],["必ず","かならず"],["死ななければ","しななければ"],["ならない"],["。"],["」"]]},{"verse":45,"text":"すると民はサウルに言った。「このような大勝利をイスラエルにもたらしたヨナタンが死ななければならないのですか。絶対にそんなことはありません。主は生きておられます。あの方の髪の毛一本でも地に落ちてはなりません。神が共におられたので、あの方は、きょう、これをなさったのです。」こうして民はヨナタンを救ったので、ヨナタンは死ななかった。","tok":[["する"],["と"],["民","たみ"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["この"],["よう"],["な"],["大勝利","だいしょうり"],["を"],["イスラエル"],["に"],["もたらした"],["ヨナタン"],["が"],["死ななければ","しななければ"],["ならない"],["の"],["です"],["か"],["。"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"],["主","ぬし"],["は"],["生きて","いきて"],["おられます"],["。"],["あの"],["方","かた"],["の"],["髪の毛","かみのけ"],["一本","いちぽん"],["で"],["も"],["地","ち"],["に"],["落ちて","おちて"],["は"],["なりません"],["。"],["神","かみ"],["が"],["共","とも"],["に"],["おられた"],["ので"],["、"],["あの"],["方","かた"],["は"],["、"],["きょう"],["、"],["これ"],["を"],["なさった"],["の"],["です"],["。"],["」"],["こう"],["して"],["民","みん"],["は"],["ヨナタン"],["を"],["救った","すくった"],["ので"],["、"],["ヨナタン"],["は"],["死ななかった","しななかった"],["。"]]},{"verse":46,"text":"こうして、サウルはペリシテ人を追うのをやめて引き揚げ、ペリシテ人は自分たちの所へ帰って行った。","tok":[["こう"],["して"],["、"],["サウル"],["は"],["ペリシテ"],["人","にん"],["を"],["追う","おう"],["の"],["を"],["やめて"],["引き揚げ","ひきあげ"],["、"],["ペリシテ"],["人","にん"],["は"],["自分","じぶん"],["たち"],["の"],["所","ところ"],["へ"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":47,"text":"サウルは、イスラエルの王位を取ってから、周囲のすべての敵と戦った。すなわち、モアブ、アモン人、エドム、ツォバの王たち、ペリシテ人と戦い、どこに行っても彼らを懲らしめた。","tok":[["サウル"],["は"],["、"],["イスラエル"],["の"],["王位","おうい"],["を"],["取って","とって"],["から"],["、"],["周囲","しゅうい"],["の"],["すべて"],["の"],["敵","てき"],["と"],["戦った","たたかった"],["。"],["すなわち"],["、"],["モアブ"],["、"],["アモン人","あもんにん"],["、"],["エドム"],["、"],["ツォバ"],["の"],["王","おう"],["たち"],["、"],["ペリシテ"],["人","にん"],["と"],["戦い","たたかい"],["、"],["どこ"],["に"],["行って","いって"],["も"],["彼","かれ"],["ら"],["を"],["懲らしめた","こらしめた"],["。"]]},{"verse":48,"text":"彼は勇気を奮って、アマレク人を打ち、イスラエル人を略奪者の手から救い出した。","tok":[["彼","かれ"],["は"],["勇気","ゆうき"],["を"],["奮って","ふるって"],["、"],["アマレク"],["人","にん"],["を"],["打ち","うち"],["、"],["イスラエル"],["人","にん"],["を"],["略奪者","りゃくだつしゃ"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["。"]]},{"verse":49,"text":"さて、サウルの息子は、ヨナタン、イシュビ、マルキ・シュア、ふたりの娘の名は、姉がメラブ、妹がミカルであった。","tok":[["さて"],["、"],["サウル"],["の"],["息子","むすこ"],["は"],["、"],["ヨナタン"],["、"],["イシュビ"],["、"],["マルキ"],["・"],["シュア"],["、"],["ふたり"],["の"],["娘","むすめ"],["の"],["名","な"],["は"],["、"],["姉","あね"],["が"],["メラブ"],["、"],["妹","いもうと"],["が"],["ミカル"],["で"],["あった"],["。"]]},{"verse":50,"text":"サウルの妻の名はアヒノアムで、アヒマアツの娘であった。将軍の名はアブネルでサウルのおじネルの子であった。","tok":[["サウル"],["の"],["妻","つま"],["の"],["名","な"],["は"],["アヒノアム"],["で"],["、"],["アヒマアツ"],["の"],["娘","むすめ"],["で"],["あった"],["。"],["将軍","しょうぐん"],["の"],["名","な"],["は"],["アブネル"],["で"],["サウル"],["の"],["おじ"],["ネル"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":51,"text":"サウルの父キシュとアブネルの父ネルとは、アビエルの子であった。","tok":[["サウル"],["の"],["父","ちち"],["キシュ"],["と"],["アブネル"],["の"],["父","ちち"],["ネル"],["と"],["は"],["、"],["アビエル"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":52,"text":"サウルの一生の間、ペリシテ人との激しい戦いがあった。サウルは勇気のある者や、力のある者を見つけると、その者をみな、召しかかえた。","tok":[["サウル"],["の"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["ペリシテ"],["人","にん"],["と"],["の"],["激しい","はげしい"],["戦い","たたかい"],["が"],["あった"],["。"],["サウル"],["は"],["勇気","ゆうき"],["の"],["ある"],["者","もの"],["や"],["、"],["力","ちから"],["の"],["ある"],["者","もの"],["を"],["見つける","みつける"],["と"],["、"],["その"],["者","もの"],["を"],["みな"],["、"],["召しかかえた","めしかかえた"],["。"]]}]
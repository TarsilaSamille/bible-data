[{"verse":1,"text":"ある日のこと、サウルの子ヨナタンは、道具持ちの若者に言った。「さあ、この向こう側のペリシテ人の先陣のところへ渡って行こう。」ヨナタンは、このことを父に知らせなかった。","tok":[["ある"],["日","ひ"],["の"],["こと"],["、"],["サウル"],["の"],["子","こ"],["ヨナタン"],["は"],["、"],["道具持ち","どうぐもち"],["の"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["この"],["向こう側","むこうがわ"],["の"],["ペリシテ"],["人","にん"],["の"],["先陣","せんじん"],["の"],["ところ"],["へ"],["渡って","わたって"],["行こう","いこう"],["。"],["」"],["ヨナタン"],["は"],["、"],["この"],["こと"],["を"],["父","ちち"],["に"],["知らせなかった","しらせなかった"],["。"]]},{"verse":2,"text":"サウルはギブアのはずれの、ミグロンにある、ざくろの木の下にとどまっていた。彼とともにいた民は、約六百人であった。","tok":[["サウル"],["は"],["ギブア"],["の"],["はずれ"],["の"],["、"],["ミグロン"],["に"],["ある"],["、"],["ざくろ"],["の"],["木","き"],["の"],["下","した"],["に"],["とどまって"],["いた"],["。"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["民","たみ"],["は"],["、"],["約","やく"],["六百人","ろくひゃくにん"],["で"],["あった"],["。"]]},{"verse":3,"text":"シロで主の祭司であったエリの子ピネハスの子イ・カボデの兄弟アヒトブの子であるアヒヤが、エポデを持っていた。民はヨナタンが出て行ったことを知らなかった。","tok":[["シロ"],["で"],["主","ぬし"],["の"],["祭司","さいし"],["で"],["あった"],["エリ"],["の"],["子","こ"],["ピネハス"],["の"],["子","こ"],["イ"],["・"],["カボデ"],["の"],["兄弟","きょうだい"],["アヒトブ"],["の"],["子","こ"],["で"],["ある"],["アヒヤ"],["が"],["、"],["エポデ"],["を"],["持って","もって"],["いた"],["。"],["民","たみ"],["は"],["ヨナタン"],["が"],["出て","でて"],["行った","いった"],["こと"],["を"],["知らなかった","しらなかった"],["。"]]},{"verse":4,"text":"ヨナタンがペリシテ人の先陣に渡って行こうとする渡し場の両側には、こちら側にも、向かい側にも、切り立った岩があり、片側の名はボツェツ、他の側の名はセネであった。","tok":[["ヨナタン"],["が"],["ペリシテ"],["人","にん"],["の"],["先陣","せんじん"],["に"],["渡って","わたって"],["行こう","いこう"],["と"],["する"],["渡し場","わたしば"],["の"],["両側","りょうがわ"],["に"],["は"],["、"],["こちら側","こちらがわ"],["に"],["も"],["、"],["向かい側","むかいがわ"],["に"],["も"],["、"],["切り立った","きりたった"],["岩","いわ"],["が"],["あり"],["、"],["片側","かたがわ"],["の"],["名","な"],["は"],["ボツェツ"],["、"],["他","た"],["の"],["側","がわ"],["の"],["名","な"],["は"],["セネ"],["で"],["あった"],["。"]]},{"verse":5,"text":"片側の切り立った岩はミクマスに面して北側に、他の側の切り立った岩はゲバに面して南側にそそり立っていた。","tok":[["片側","かたがわ"],["の"],["切り立った","きりたった"],["岩","いわ"],["は"],["ミクマス"],["に"],["面して","めんして"],["北側","きたがわ"],["に"],["、"],["他","た"],["の"],["側","がわ"],["の"],["切り立った","きりたった"],["岩","いわ"],["は"],["ゲバ"],["に"],["面して","めんして"],["南側","みなみがわ"],["に"],["そそり立って","そそりたって"],["いた"],["。"]]},{"verse":6,"text":"ヨナタンは、道具持ちの若者に言った。「さあ、あの割礼を受けていない者どもの先陣のところへ渡って行こう。たぶん、主がわれわれに味方してくださるであろう。大人数によるのであっても、小人数によるのであっても、主がお救いになるのに妨げとなるものは何もない。」","tok":[["ヨナタン"],["は"],["、"],["道具持ち","どうぐもち"],["の"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["あの"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["者","もの"],["ども"],["の"],["先陣","せんじん"],["の"],["ところ"],["へ"],["渡って","わたって"],["行こう","いこう"],["。"],["たぶん"],["、"],["主","ぬし"],["が"],["われわれ"],["に"],["味方","みかた"],["して"],["くださるで"],["あろう"],["。"],["大人数","おおにんずう"],["に"],["よる"],["ので"],["あって"],["も"],["、"],["小","しょう"],["人数","にんずう"],["に"],["よる"],["ので"],["あって"],["も"],["、"],["主","ぬし"],["が"],["お救い","おすくい"],["に"],["なる"],["のに"],["妨げ","さまたげ"],["と"],["なる"],["もの"],["は"],["何","なん"],["も"],["ない"],["。"],["」"]]},{"verse":7,"text":"すると道具持ちが言った。「何でも、あなたのお心のままにしてください。さあ、お進みください。私もいっしょにまいります。お心のままに。」","tok":[["する"],["と"],["道具持ち","どうぐもち"],["が"],["言った","いった"],["。"],["「"],["何","なん"],["で"],["も"],["、"],["あなた"],["の"],["お心","おこころ"],["の"],["まま"],["に"],["して"],["ください"],["。"],["さあ"],["、"],["お進み","おすすみ"],["ください"],["。"],["私","わたくし"],["も"],["いっしょ"],["に"],["まいります"],["。"],["お心","おこころ"],["の"],["まま"],["に"],["。"],["」"]]},{"verse":8,"text":"ヨナタンは言った。「今われわれは、あの者どものところに渡って行って、彼らの前に身を現すのだ。","tok":[["ヨナタン"],["は"],["言った","いった"],["。"],["「"],["今","いま"],["われわれ"],["は"],["、"],["あの"],["者","もの"],["ども"],["の"],["ところ"],["に"],["渡って","わたって"],["行って","いって"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["身","み"],["を"],["現す","あらわす"],["の"],["だ"],["。"]]},{"verse":9,"text":"もしも彼らが、『おれたちがおまえらのところに行くまで、じっとしていろ』と言ったら、われわれはその場に立ちとどまり、彼らのところに上って行くまい。","tok":[["もし"],["も"],["彼","かれ"],["ら"],["が"],["、"],["『"],["おれ"],["たち"],["が"],["おまえ"],["ら"],["の"],["ところ"],["に"],["行く","いく"],["まで"],["、"],["じっと"],["して"],["いろ"],["』"],["と"],["言ったら","いったら"],["、"],["われわれ"],["は"],["その"],["場","ば"],["に"],["立ち","たち"],["とどまり"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["上って","のぼって"],["行くまい","いくまい"],["。"]]},{"verse":10,"text":"もし彼らが、『おれたちのところに上って来い』と言えば、われわれは上って行こう。主が彼らを、われわれの手に渡されたのだから。これがわれわれへのしるしである。」","tok":[["もし"],["彼","かれ"],["ら"],["が"],["、"],["『"],["おれ"],["たち"],["の"],["ところ"],["に"],["上って","のぼって"],["来い","こい"],["』"],["と"],["言えば","いえば"],["、"],["われわれ"],["は"],["上って","のぼって"],["行こう","いこう"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["、"],["われわれ"],["の"],["手","て"],["に"],["渡された","わたされた"],["の"],["だ"],["から"],["。"],["これ"],["が"],["われわれ"],["へ"],["の"],["しるし"],["で"],["ある"],["。"],["」"]]},{"verse":11,"text":"こうして、このふたりはペリシテ人の先陣に身を現した。するとペリシテ人が言った。「やあ、ヘブル人が、隠れていた穴から出て来るぞ。」","tok":[["こう"],["して"],["、"],["この"],["ふたり"],["は"],["ペリシテ"],["人","にん"],["の"],["先陣","せんじん"],["に"],["身","み"],["を"],["現した","あらわした"],["。"],["する"],["と"],["ペリシテ"],["人","にん"],["が"],["言った","いった"],["。"],["「"],["やあ"],["、"],["ヘブル人","へぶるにん"],["が"],["、"],["隠れて","かくれて"],["いた"],["穴","あな"],["から"],["出て","でて"],["来る","くる"],["ぞ"],["。"],["」"]]},{"verse":12,"text":"先陣の者たちは、ヨナタンと道具持ちとに呼びかけて言った。「おれたちのところに上って来い。思い知らせてやる。」ヨナタンは、道具持ちに言った。「私について上って来なさい。主がイスラエルの手に彼らを渡されたのだ。」","tok":[["先陣","せんじん"],["の"],["者","もの"],["たち"],["は"],["、"],["ヨナタン"],["と"],["道具持ち","どうぐもち"],["と"],["に"],["呼びかけて","よびかけて"],["言った","いった"],["。"],["「"],["おれ"],["たち"],["の"],["ところ"],["に"],["上って","のぼって"],["来い","こい"],["。"],["思い知らせて","おもいしらせて"],["やる"],["。"],["」"],["ヨナタン"],["は"],["、"],["道具持ち","どうぐもち"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["について"],["上って","のぼって"],["来","き"],["なさい"],["。"],["主","ぬし"],["が"],["イスラエル"],["の"],["手","て"],["に"],["彼","かれ"],["ら"],["を"],["渡された","わたされた"],["の"],["だ"],["。"],["」"]]},{"verse":13,"text":"ヨナタンは手足を使ってよじのぼり、道具持ちもあとに続いた。ペリシテ人はヨナタンの前に倒れ、道具持ちがそのあとから彼らを打ち殺した。","tok":[["ヨナタン"],["は"],["手足","てあし"],["を"],["使って","つかって"],["よじのぼり"],["、"],["道具持ち","どうぐもち"],["も"],["あと"],["に"],["続いた","つづいた"],["。"],["ペリシテ"],["人","にん"],["は"],["ヨナタン"],["の"],["前","まえ"],["に"],["倒れ","たおれ"],["、"],["道具持ち","どうぐもち"],["が"],["その"],["あと"],["から"],["彼","かれ"],["ら"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":14,"text":"ヨナタンと道具持ちが最初に殺したのは約二十人で、それも一くびきの牛が一日で耕す畑のおおよそ半分の場所で行われた。","tok":[["ヨナタン"],["と"],["道具持ち","どうぐもち"],["が"],["最初","さいしょ"],["に"],["殺した","ころした"],["の"],["は"],["約","やく"],["二","に"],["十人","じゅうにん"],["で"],["、"],["それ"],["も"],["一","ひと"],["くびき"],["の"],["牛","うし"],["が"],["一","いち"],["日","にち"],["で"],["耕す","たがやす"],["畑","はたけ"],["の"],["おおよそ"],["半分","はんぶん"],["の"],["場所","ばしょ"],["で"],["行われた","おこなわれた"],["。"]]},{"verse":15,"text":"こうして陣営にも、野外にも、また民全体のうちにも恐れが起こった。先陣の者、略奪隊さえ恐れおののいた。地は震え、非常な恐れとなった。","tok":[["こう"],["して"],["陣営","じんえい"],["に"],["も"],["、"],["野外","やがい"],["に"],["も"],["、"],["また"],["民","みん"],["全体","ぜんたい"],["の"],["うち"],["に"],["も"],["恐れ","おそれ"],["が"],["起こった","おこった"],["。"],["先陣","せんじん"],["の"],["者","もの"],["、"],["略奪隊","りゃくだつたい"],["さえ"],["恐れおののいた","おそれおののいた"],["。"],["地","ち"],["は"],["震え","ふるえ"],["、"],["非常","ひじょう"],["な"],["恐れ","おそれ"],["と"],["なった"],["。"]]},{"verse":16,"text":"ベニヤミンのギブアにいるサウルのために見張りをしていた者たちが見ると、群集は震えおののいて右往左往していた。","tok":[["ベニヤミン"],["の"],["ギブア"],["に"],["いる"],["サウル"],["の"],["ため"],["に"],["見張り","みはり"],["を"],["して"],["いた"],["者","もの"],["たち"],["が"],["見る","みる"],["と"],["、"],["群集","ぐんしゅう"],["は"],["震えおののいて","ふるえおののいて"],["右往","うおう"],["左往","さおう"],["して"],["いた"],["。"]]},{"verse":17,"text":"サウルは彼とともにいる民に言った。「だれがわれわれのところから出て行ったかを、調べて、見なさい。」そこで彼らが調べると、ヨナタンと道具持ちがそこにいなかった。","tok":[["サウル"],["は"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["民","たみ"],["に"],["言った","いった"],["。"],["「"],["だれ"],["が"],["われわれ"],["の"],["ところ"],["から"],["出て","でて"],["行った","いった"],["か"],["を"],["、"],["調べて","しらべて"],["、"],["見","み"],["なさい"],["。"],["」"],["そこ"],["で"],["彼","かれ"],["ら"],["が"],["調べる","しらべる"],["と"],["、"],["ヨナタン"],["と"],["道具持ち","どうぐもち"],["が"],["そこ"],["に"],["いなかった"],["。"]]},{"verse":18,"text":"サウルはアヒヤに言った。「神の箱を持って来なさい。」神の箱は、その日、イスラエル人の間にあったからである。","tok":[["サウル"],["は"],["アヒヤ"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["の"],["箱","ばこ"],["を"],["持って","もって"],["来","き"],["なさい"],["。"],["」"],["神","かみ"],["の"],["箱","ばこ"],["は"],["、"],["その"],["日","ひ"],["、"],["イスラエル"],["人","にん"],["の"],["間","あいだ"],["に"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"サウルが祭司とまだ話しているうちに、ペリシテ人の陣営の騒動は、ますます大きくなっていった。／そこでサウルは祭司に、「もう手をしまいなさい」と言った。","tok":[["サウル"],["が"],["祭司","さいし"],["と"],["まだ"],["話して","はなして"],["いる"],["うち"],["に"],["、"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["の"],["騒動","そうどう"],["は"],["、"],["ますます"],["大きく","おおきく"],["なって"],["いった"],["。"],["／"],["そこ"],["で"],["サウル"],["は"],["祭司","さいし"],["に"],["、"],["「"],["もう"],["手","て"],["を"],["しまい"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"サウルと、彼とともにいた民がみな、集まって戦場に行くと、そこでは剣をもって同士打ちをしており、非常な大恐慌が起こっていた。","tok":[["サウル"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["民","たみ"],["が"],["みな"],["、"],["集まって","あつまって"],["戦場","せんじょう"],["に"],["行く","いく"],["と"],["、"],["そこ"],["で"],["は"],["剣","けん"],["を"],["もって"],["同士打ち","どうしうち"],["を"],["して"],["おり"],["、"],["非常","ひじょう"],["な"],["大恐慌","だいきょうこう"],["が"],["起こって","おこって"],["いた"],["。"]]},{"verse":21,"text":"それまでペリシテ人につき、彼らといっしょに陣営に上って来ていたヘブル人も転じて、サウルとヨナタンとともにいるイスラエル人の側につくようになった。","tok":[["それ"],["まで"],["ペリシテ"],["人","にん"],["に"],["つき"],["、"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["陣営","じんえい"],["に"],["上って","のぼって"],["来て","きて"],["いた"],["ヘブル人","へぶるにん"],["も"],["転じて","てんじて"],["、"],["サウル"],["と"],["ヨナタン"],["と"],["とも"],["に"],["いる"],["イスラエル"],["人","にん"],["の"],["側","がわ"],["に"],["つく"],["よう"],["に"],["なった"],["。"]]},{"verse":22,"text":"また、エフライムの山地に隠れていたすべてのイスラエル人も、ペリシテ人が逃げたと聞いて、彼らもまた戦いに加わってペリシテ人に追い迫った。","tok":[["また"],["、"],["エフライム"],["の"],["山地","さんち"],["に"],["隠れて","かくれて"],["いた"],["すべて"],["の"],["イスラエル"],["人","にん"],["も"],["、"],["ペリシテ"],["人","にん"],["が"],["逃げた","にげた"],["と"],["聞いて","きいて"],["、"],["彼","かれ"],["ら"],["も"],["また"],["戦い","たたかい"],["に"],["加わって","くわわって"],["ペリシテ"],["人","にん"],["に"],["追い迫った","おいせまった"],["。"]]},{"verse":23,"text":"こうしてその日、主はイスラエルを救い、戦いはベテ・アベンに移った。","tok":[["こう"],["して"],["その"],["日","ひ"],["、"],["主","ぬし"],["は"],["イスラエル"],["を"],["救い","すくい"],["、"],["戦い","たたかい"],["は"],["ベテ"],["・"],["アベン"],["に"],["移った","うつった"],["。"]]},{"verse":24,"text":"その日、イスラエル人はひどく苦しんだ。サウルが民に誓わせて、「夕方、私が敵に復讐するまで、食物を食べる者はのろわれる」と言い、民はだれも食物を味見もしなかったからである。","tok":[["その"],["日","ひ"],["、"],["イスラエル"],["人","にん"],["は"],["ひどく"],["苦しんだ","くるしんだ"],["。"],["サウル"],["が"],["民","たみ"],["に"],["誓わせて","ちかわせて"],["、"],["「"],["夕方","ゆうがた"],["、"],["私","わたくし"],["が"],["敵","てき"],["に"],["復讐","ふくしゅう"],["する"],["まで"],["、"],["食物","しょくもつ"],["を"],["食べる","たべる"],["者","もの"],["は"],["のろわれる"],["」"],["と"],["言い","いい"],["、"],["民","みん"],["は"],["だれ"],["も"],["食物","しょくもつ"],["を"],["味見","あじみ"],["も"],["しなかった"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"この地はどこでも、森に入って行くと、地面に蜜があった。","tok":[["この"],["地","ち"],["は"],["どこ"],["で"],["も"],["、"],["森","もり"],["に"],["入って","はいって"],["行く","いく"],["と"],["、"],["地面","じめん"],["に"],["蜜","みつ"],["が"],["あった"],["。"]]},{"verse":26,"text":"民が森に入ると、蜜がしたたっていたが、だれもそれを手につけて口に入れる者はなかった。民は誓いを恐れていたからである。","tok":[["民","みん"],["が"],["森","もり"],["に"],["入る","はいる"],["と"],["、"],["蜜","みつ"],["が"],["したたって"],["いた"],["が"],["、"],["だれ"],["も"],["それ"],["を"],["手","て"],["に"],["つけて"],["口","くち"],["に"],["入れる","いれる"],["者","もの"],["は"],["なかった"],["。"],["民","たみ"],["は"],["誓い","ちかい"],["を"],["恐れて","おそれて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"ヨナタンは、父が民に誓わせていることを聞いていなかった。それで手にあった杖の先を伸ばして、それを蜜蜂の巣に浸し、それを手につけて口に入れた。すると彼の目が輝いた。","tok":[["ヨナタン"],["は"],["、"],["父","ちち"],["が"],["民","たみ"],["に"],["誓わせて","ちかわせて"],["いる"],["こと"],["を"],["聞いて","きいて"],["いなかった"],["。"],["それ"],["で"],["手","て"],["に"],["あった"],["杖","つえ"],["の"],["先","さき"],["を"],["伸ばして","のばして"],["、"],["それ"],["を"],["蜜蜂","すがる"],["の"],["巣","す"],["に"],["浸し","ひたし"],["、"],["それ"],["を"],["手","て"],["に"],["つけて"],["口","くち"],["に"],["入れた","いれた"],["。"],["する"],["と"],["彼","かれ"],["の"],["目","め"],["が"],["輝いた","かがやいた"],["。"]]},{"verse":28,"text":"そのとき、民のひとりが告げて言った。「あなたの父上は、民に堅く誓わせて、きょう、食物を食べる者はのろわれる、とおっしゃいました。それで民は疲れているのです。」","tok":[["その"],["とき"],["、"],["民","みん"],["の"],["ひとり"],["が"],["告げて","つげて"],["言った","いった"],["。"],["「"],["あなた"],["の"],["父上","ちちじょう"],["は"],["、"],["民","みん"],["に"],["堅く","かたく"],["誓わせて","ちかわせて"],["、"],["きょう"],["、"],["食物","しょくもつ"],["を"],["食べる","たべる"],["者","もの"],["は"],["のろわれる"],["、"],["と"],["おっしゃいました"],["。"],["それ"],["で"],["民","たみ"],["は"],["疲れて","つかれて"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":29,"text":"ヨナタンは言った。「父はこの国を悩ま
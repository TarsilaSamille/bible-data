[{"verse":1,"text":"サウルは、ダビデを殺すことを、息子ヨナタンや家来の全部に告げた。しかし、サウルの子ヨナタンはダビデを非常に愛していた。","tok":[["サウル"],["は"],["、"],["ダビデ"],["を"],["殺す","ころす"],["こと"],["を"],["、"],["息子","むすこ"],["ヨナタン"],["や"],["家来","けらい"],["の"],["全部","ぜんぶ"],["に"],["告げた","つげた"],["。"],["しかし"],["、"],["サウル"],["の"],["子","こ"],["ヨナタン"],["は"],["ダビデ"],["を"],["非常","ひじょう"],["に"],["愛して","あいして"],["いた"],["。"]]},{"verse":2,"text":"それでヨナタンはダビデに告げて言った。「私の父サウルは、あなたを殺そうとしています。それで、あしたの朝は、注意して、隠れ場にとどまり、身を隠していてください。","tok":[["それ"],["で"],["ヨナタン"],["は"],["ダビデ"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["父","ちち"],["サウル"],["は"],["、"],["あなた"],["を"],["殺そう","ころそう"],["として"],["います"],["。"],["それ"],["で"],["、"],["あした"],["の"],["朝","あさ"],["は"],["、"],["注意","ちゅうい"],["して"],["、"],["隠れ場","かくれば"],["に"],["とどまり"],["、"],["身","み"],["を"],["隠して","かくして"],["いて"],["ください"],["。"]]},{"verse":3,"text":"私はあなたのいる野原に出て行って、父のそばに立ち、あなたのことについて父に話しましょう。何かわかったら、あなたに知らせましょう。」","tok":[["私","わたくし"],["は"],["あなた"],["の"],["いる"],["野原","のはら"],["に"],["出て","でて"],["行って","いって"],["、"],["父","ちち"],["の"],["そば"],["に"],["立ち","たち"],["、"],["あなた"],["の"],["こと"],["について"],["父","ちち"],["に"],["話しましょう","はなしましょう"],["。"],["何","なん"],["か"],["わかったら"],["、"],["あなた"],["に"],["知らせましょう","しらせましょう"],["。"],["」"]]},{"verse":4,"text":"ヨナタンは父サウルにダビデの良いことを話し、父に言った。「王よ。あなたのしもべダビデについて罪を犯さないでください。彼はあなたに対して罪を犯してはいません。かえって、彼のしたことは、あなたにとっては非常な益となっています。","tok":[["ヨナタン"],["は"],["父","ちち"],["サウル"],["に"],["ダビデ"],["の"],["良い","よい"],["こと"],["を"],["話し","はなし"],["、"],["父","ちち"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["よ"],["。"],["あなた"],["の"],["しもべ"],["ダビデ"],["について"],["罪","つみ"],["を"],["犯さないで","おかさないで"],["ください"],["。"],["彼","かれ"],["は"],["あなた"],["に対して","にたいして"],["罪","つみ"],["を"],["犯して","おかして"],["は"],["いません"],["。"],["かえって"],["、"],["彼","かれ"],["の"],["した"],["こと"],["は"],["、"],["あなた"],["にとって"],["は"],["非常","ひじょう"],["な"],["益","えき"],["と"],["なって"],["います"],["。"]]},{"verse":5,"text":"彼が自分のいのちをかけて、ペリシテ人を打ったので、主は大勝利をイスラエル全体にもたらしてくださったのです。あなたはそれを見て、喜ばれました。なぜ何の理由もなくダビデを殺し、罪のない者の血を流して、罪を犯そうとされるのですか。」","tok":[["彼","かれ"],["が"],["自分","じぶん"],["の"],["いのち"],["を"],["かけて"],["、"],["ペリシテ"],["人","にん"],["を"],["打った","うった"],["ので"],["、"],["主","ぬし"],["は"],["大勝利","だいしょうり"],["を"],["イスラエル"],["全体","ぜんたい"],["に"],["もたらして"],["くださった"],["の"],["です"],["。"],["あなた"],["は"],["それ"],["を"],["見て","みて"],["、"],["喜ばれました","よろこばれました"],["。"],["なぜ"],["何","なん"],["の"],["理由","りゆう"],["も"],["なく"],["ダビデ"],["を"],["殺し","ころし"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["流して","ながして"],["、"],["罪","つみ"],["を"],["犯そう","おかそう"],["と"],["される"],["の"],["です"],["か"],["。"],["」"]]},{"verse":6,"text":"サウルはヨナタンの言うことを聞き入れた。サウルは誓った。「主は生きておられる。あれは殺されることはない。」","tok":[["サウル"],["は"],["ヨナタン"],["の"],["言う","いう"],["こと"],["を"],["聞き入れた","ききいれた"],["。"],["サウル"],["は"],["誓った","ちかった"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["あれ"],["は"],["殺される","ころされる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":7,"text":"それで、ヨナタンはダビデを呼んで、このことのすべてを告げた。ヨナタンがダビデをサウルのところに連れて行ったので、ダビデは以前のようにサウルに仕えることになった。","tok":[["それ"],["で"],["、"],["ヨナタン"],["は"],["ダビデ"],["を"],["呼んで","よんで"],["、"],["この"],["こと"],["の"],["すべて"],["を"],["告げた","つげた"],["。"],["ヨナタン"],["が"],["ダビデ"],["を"],["サウル"],["の"],["ところ"],["に"],["連れて","つれて"],["行った","いった"],["ので"],["、"],["ダビデ"],["は"],["以前","いぜん"],["の"],["よう"],["に"],["サウル"],["に"],["仕える","つかえる"],["こと"],["に"],["なった"],["。"]]},{"verse":8,"text":"それからまた、戦いが起こったが、ダビデは出て行って、ペリシテ人と戦い、彼らを打って大損害を与えた。それで、彼らはダビデの前から逃げた。","tok":[["それ"],["から"],["また"],["、"],["戦い","たたかい"],["が"],["起こった","おこった"],["が"],["、"],["ダビデ"],["は"],["出て","でて"],["行って","いって"],["、"],["ペリシテ"],["人","にん"],["と"],["戦い","たたかい"],["、"],["彼","かれ"],["ら"],["を"],["打って","うって"],["大","だい"],["損害","そんがい"],["を"],["与えた","あたえた"],["。"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["ダビデ"],["の"],["前","まえ"],["から"],["逃げた","にげた"],["。"]]},{"verse":9,"text":"ときに、わざわいをもたらす、主の霊がサウルに臨んだ。サウルは自分の家にすわっており、その手には槍を持っていた。ダビデは琴を手にしてひいていた。","tok":[["とき"],["に"],["、"],["わざわい"],["を"],["もたらす"],["、"],["主","ぬし"],["の"],["霊","れい"],["が"],["サウル"],["に"],["臨んだ","のぞんだ"],["。"],["サウル"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["すわって"],["おり"],["、"],["その"],["手","て"],["に"],["は"],["槍","やり"],["を"],["持って","もって"],["いた"],["。"],["ダビデ"],["は"],["琴","こと"],["を"],["手","て"],["に"],["して"],["ひいて"],["いた"],["。"]]},{"verse":10,"text":"サウルが槍でダビデを壁に突き刺そうとしたとき、ダビデはサウルから身を避けたので、サウルは槍を壁に打ちつけた。ダビデは逃げ、その夜は難をのがれた。","tok":[["サウル"],["が"],["槍","やり"],["で"],["ダビデ"],["を"],["壁","かべ"],["に"],["突き刺そう","つきさそう"],["と"],["した"],["とき"],["、"],["ダビデ"],["は"],["サウル"],["から"],["身","み"],["を"],["避けた","さけた"],["ので"],["、"],["サウル"],["は"],["槍","やり"],["を"],["壁","かべ"],["に"],["打ちつけた","うちつけた"],["。"],["ダビデ"],["は"],["逃げ","にげ"],["、"],["その"],["夜","よる"],["は"],["難","なん"],["を"],["のがれた"],["。"]]},{"verse":11,"text":"サウルはダビデの家に使者たちを遣わし、彼を見張らせ、朝になって彼を殺そうとした。ダビデの妻ミカルはダビデに告げて言った。「今夜、あなたのいのちを救わなければ、あすは、あなたは殺されてしまいます。」","tok":[["サウル"],["は"],["ダビデ"],["の"],["家","いえ"],["に"],["使者","ししゃ"],["たち"],["を"],["遣わし","つかわし"],["、"],["彼","かれ"],["を"],["見張らせ","みはらせ"],["、"],["朝","あさ"],["に"],["なって"],["彼","かれ"],["を"],["殺そう","ころそう"],["と"],["した"],["。"],["ダビデ"],["の"],["妻","つま"],["ミカル"],["は"],["ダビデ"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["今夜","こんや"],["、"],["あなた"],["の"],["いのち"],["を"],["救わなければ","すくわなければ"],["、"],["あす"],["は"],["、"],["あなた"],["は"],["殺されて","ころされて"],["しまいます"],["。"],["」"]]},{"verse":12,"text":"こうしてミカルはダビデを窓から降ろしたので、彼は逃げて行き、難をのがれた。","tok":[["こう"],["して"],["ミカル"],["は"],["ダビデ"],["を"],["窓","まど"],["から"],["降ろした","おろした"],["ので"],["、"],["彼","かれ"],["は"],["逃げて","にげて"],["行き","いき"],["、"],["難","なん"],["を"],["のがれた"],["。"]]},{"verse":13,"text":"ミカルはテラフィムを取って、それを寝床の上に置き、やぎの毛で編んだものを枕のところに置き、それを着物でおおった。","tok":[["ミカル"],["は"],["テラフィム"],["を"],["取って","とって"],["、"],["それ"],["を"],["寝床","ねどこ"],["の"],["上","うえ"],["に"],["置き","おき"],["、"],["やぎ"],["の"],["毛","け"],["で"],["編んだ","あんだ"],["もの"],["を"],["枕","まくら"],["の"],["ところ"],["に"],["置き","おき"],["、"],["それ"],["を"],["着物","きもの"],["で"],["おおった"],["。"]]},{"verse":14,"text":"サウルがダビデを捕らえようと使者たちを遣わしたとき、ミカルは、「あの人は病気です」と言った。","tok":[["サウル"],["が"],["ダビデ"],["を"],["捕らえよう","とらえよう"],["と"],["使者","ししゃ"],["たち"],["を"],["遣わした","つかわした"],["とき"],["、"],["ミカル"],["は"],["、"],["「"],["あの"],["人","ひと"],["は"],["病気","びょうき"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"サウルはダビデを見ようとして、「あれを寝床のまま、私のところに連れて来い。あれを殺すのだ」と言って使者たちを遣わした。","tok":[["サウル"],["は"],["ダビデ"],["を"],["見よう","みよう"],["として"],["、"],["「"],["あれ"],["を"],["寝床","ねどこ"],["の"],["まま"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["連れて","つれて"],["来い","こい"],["。"],["あれ"],["を"],["殺す","ころす"],["の"],["だ"],["」"],["と"],["言って","いって"],["使者","ししゃ"],["たち"],["を"],["遣わした","つかわした"],["。"]]},{"verse":16,"text":"使者たちが入って見ると、なんと、テラフィムが寝床にあり、やぎの毛で編んだものが枕のところにあった。","tok":[["使者","ししゃ"],["たち"],["が"],["入って","はいって"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["テラフィム"],["が"],["寝床","ねどこ"],["に"],["あり"],["、"],["やぎ"],["の"],["毛","け"],["で"],["編んだ","あんだ"],["もの"],["が"],["枕","まくら"],["の"],["ところ"],["に"],["あった"],["。"]]},{"verse":17,"text":"サウルはミカルに言った。「なぜ、このようにして私を欺き、私の敵を逃がし、のがれさせたのか。」ミカルはサウルに言った。「あの人は、『私を逃がしてくれ。私がどうしておまえを殺せよう』と私に言ったのです。」","tok":[["サウル"],["は"],["ミカル"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["この"],["よう"],["に"],["して"],["私","わたくし"],["を"],["欺き","あざむき"],["、"],["私","わたくし"],["の"],["敵","てき"],["を"],["逃がし","にがし"],["、"],["のがれ"],["させた"],["の"],["か"],["。"],["」"],["ミカル"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["あの"],["人","ひと"],["は"],["、"],["『"],["私","わたくし"],["を"],["逃がして","にがして"],["くれ"],["。"],["私","わたくし"],["が"],["どう"],["して"],["おまえ"],["を"],["殺せよう","ころせよう"],["』"],["と"],["私","わたくし"],["に"],["言った","いった"],["の"],["です"],["。"],["」"]]},{"verse":18,"text":"ダビデは逃げ、のがれて、ラマのサムエルのところに行き、サウルが自分にしたこといっさいをサムエルに話した。そしてサムエルと、ナヨテに行って住んだ。","tok":[["ダビデ"],["は"],["逃げ","にげ"],["、"],["のがれて"],["、"],["ラマ"],["の"],["サムエル"],["の"],["ところ"],["に"],["行き","いき"],["、"],["サウル"],["が"],["自分","じぶん"],["に"],["した"],["こと"],["いっさい"],["を"],["サムエル"],["に"],["話した","はなした"],["。"],["そして"],["サムエル"],["と"],["、"],["ナヨテ"],["に"],["行って","いって"],["住んだ","すんだ"],["。"]]},{"verse":19,"text":"ところが、「ダビデは、なんと、ラマのナヨテにいます」とサウルに告げる者がいた。","tok":[["ところ"],["が"],["、"],["「"],["ダビデ"],["は"],["、"],["なん"],["と"],["、"],["ラマ"],["の"],["ナヨテ"],["に"],["います"],["」"],["と"],["サウル"],["に"],["告げる","つげる"],["者","もの"],["が"],["いた"],["。"]]},{"verse":20,"text":"そこでサウルはダビデを捕らえようと使者たちを遣わした。彼らは、預言者の一団が預言しており、サムエルがその監督をする者として立っているのを見た。そのとき、神の霊がサウルの使者たちに臨み、彼らもまた、預言した。","tok":[["そこ"],["で"],["サウル"],["は"],["ダビデ"],["を"],["捕らえよう","とらえよう"],["と"],["使者","ししゃ"],["たち"],["を"],["遣わした","つかわした"],["。"],["彼","かれ"],["ら"],["は"],["、"],["預言者","よげんしゃ"],["の"],["一団","いちだん"],["が"],["預言","よげん"],["して"],["おり"],["、"],["サムエル"],["が"],["その"],["監督","かんとく"],["を"],["する"],["者","もの"],["として"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["その"],["とき"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["サウル"],["の"],["使者","ししゃ"],["たち"],["に"],["臨み","のぞみ"],["、"],["彼","かれ"],["ら"],["も"],["また"],["、"],["預言","よげん"],["した"],["。"]]},{"verse":21,"text":"サウルにこのことが知らされたとき、彼はほかの使者たちを遣わしたが、彼らもまた、預言した。サウルはさらに三度目の使者たちを送ったが、彼らもまた、預言した。","tok":[["サウル"],["に"],["この"],["こと"],["が"],["知らされた","しらされた"],["とき"],["、"],["彼","かれ"],["は"],["ほか"],["の"],["使者","ししゃ"],["たち"],["を"],["遣わした","つかわした"],["が"],["、"],["彼","かれ"],["ら"],["も"],["また"],["、"],["預言","よげん"],["した"],["。"],["サウル"],["は"],["さらに"],["三度目","さんどめ"],["の"],["使者","ししゃ"],["たち"],["を"],["送った","おくった"],["が"],["、"],["彼","かれ"],["ら"],["も"],["また"],["、"],["預言","よげん"],["した"],["。"]]},{"verse":22,"text":"そこでサウル自身もまたラマへ行った。彼はセクにある大きな井戸まで来たとき、「サムエルとダビデはどこにいるか」と尋ねた。すると、「今、ラマのナヨテにいます」と言われた。","tok":[["そこ"],["で"],["サウル"],["自身","じしん"],["も"],["また"],["ラマ"],["へ"],["行った","いった"],["。"],["彼","かれ"],["は"],["セク"],["に"],["ある"],["大きな","おおきな"],["井戸","いど"],["まで"],["来た","きた"],["とき"],["、"],["「"],["サムエル"],["と"],["ダビデ"],["は"],["どこ"],["に"],["いる"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["する"],["と"],["、"],["「"],["今","いま"],["、"],["ラマ"],["の"],["ナヨテ"],["に"],["います"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":23,"text":"サウルはそこからラマのナヨテへ出て行ったが、彼にも神の霊が臨み、彼は預言しながら歩いて、ラマのナヨテに着いた。","tok":[["サウル"],["は"],["そこ"],["から"],["ラマ"],["の"],["ナヨテ"],["へ"],["出て","でて"],["行った","いった"],["が"],["、"],["彼","かれ"],["に"],["も"],["神","かみ"],["の"],["霊","れい"],["が"],["臨み","のぞみ"],["、"],["彼","かれ"],["は"],["預言","よげん"],["し"],["ながら"],["歩いて","あるいて"],["、"],["ラマ"],["の"],["ナヨテ"],["に"],["着いた","ついた"],["。"]]},{"verse":24,"text":"彼もまた着物を脱いで、サムエルの前で預言し、一昼夜の間、裸のまま倒れていた。このために、「サウルもまた、預言者のひとりなのか」と言われるようになった。","tok":[["彼","かれ"],["も"],["また"],["着物","きもの"],["を"],["脱いで","ぬいで"],["、"],["サムエル"],["の"],["前","まえ"],["で"],["預言","よげん"],["し"],["、"],["一昼夜","いっちゅうや"],["の"],["間","あいだ"],["、"],["裸","はだか"],["の"],["まま"],["倒れて","たおれて"],["いた"],["。"],["この"],["ため"],["に"],["、"],["「"],["サウル"],["も"],["また"],["、"],["預言者","よげんしゃ"],["の"],["ひとり"],["な"],["の"],["か"],["」"],["と"],["言われる","いわれる"],["よう"],["に"],["なった"],["。"]]}]
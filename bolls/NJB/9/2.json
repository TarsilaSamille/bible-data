[{"verse":1,"text":"ハンナは祈って言った。「私の心は主を誇り、私の角は主によって高く上がります。私の口は敵に向かって大きく開きます。私はあなたの救いを喜ぶからです。","tok":[["ハンナ"],["は"],["祈って","いのって"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["心","こころ"],["は"],["主","ぬし"],["を"],["誇り","ほこり"],["、"],["私","わたくし"],["の"],["角","かど"],["は"],["主に","おもに"],["よって"],["高く","たかく"],["上がります","あがります"],["。"],["私","わたくし"],["の"],["口","くち"],["は"],["敵","てき"],["に"],["向かって","むかって"],["大きく","おおきく"],["開きます","ひらきます"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["救い","すくい"],["を"],["喜ぶ","よろこぶ"],["から"],["です"],["。"]]},{"verse":2,"text":"主のように聖なる方はありません。あなたに並ぶ者はないからです。私たちの神のような岩はありません。","tok":[["主","ぬし"],["の"],["よう"],["に"],["聖","せい"],["なる"],["方","かた"],["は"],["ありません"],["。"],["あなた"],["に"],["並ぶ","ならぶ"],["者","もの"],["は"],["ない"],["から"],["です"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["よう"],["な"],["岩","いわ"],["は"],["ありません"],["。"]]},{"verse":3,"text":"高ぶって、多くを語ってはなりません。横柄なことばを口から出してはなりません。まことに主は、すべてを知る神。そのみわざは確かです。","tok":[["高ぶって","たかぶって"],["、"],["多く","おおく"],["を"],["語って","かたって"],["は"],["なりません"],["。"],["横柄","おうへい"],["な"],["ことば"],["を"],["口","くち"],["から"],["出して","だして"],["は"],["なりません"],["。"],["まこと"],["に"],["主","ぬし"],["は"],["、"],["すべて"],["を"],["知る","しる"],["神","かみ"],["。"],["その"],["みわざ"],["は"],["確か","たしか"],["です"],["。"]]},{"verse":4,"text":"勇士の弓が砕かれ、弱い者が力を帯び、","tok":[["勇士","ゆうし"],["の"],["弓","ゆみ"],["が"],["砕かれ","くだかれ"],["、"],["弱い","よわい"],["者","もの"],["が"],["力","ちから"],["を"],["帯び","おび"],["、"]]},{"verse":5,"text":"食べ飽いた者がパンのために雇われ、飢えていた者が働きをやめ、不妊の女が七人の子を産み、多くの子を持つ女が、しおれてしまいます。","tok":[["食べ","たべ"],["飽いた","あいた"],["者","もの"],["が"],["パン"],["の"],["ため"],["に"],["雇われ","やとわれ"],["、"],["飢えて","うえて"],["いた"],["者","もの"],["が"],["働き","はたらき"],["を"],["やめ"],["、"],["不妊","ふにん"],["の"],["女","おんな"],["が"],["七人","ななにん"],["の"],["子","こ"],["を"],["産み","うみ"],["、"],["多く","おおく"],["の"],["子","こ"],["を"],["持つ","もつ"],["女","おんな"],["が"],["、"],["しおれて"],["しまいます"],["。"]]},{"verse":6,"text":"主は殺し、また生かし、よみに下し、また上げる。","tok":[["主","ぬし"],["は"],["殺し","ころし"],["、"],["また"],["生かし","いかし"],["、"],["よみ"],["に"],["下し","くだし"],["、"],["また"],["上げる","あげる"],["。"]]},{"verse":7,"text":"主は、貧しくし、また富ませ、低くし、また高くするのです。","tok":[["主","ぬし"],["は"],["、"],["貧しく","まずしく"],["し"],["、"],["また"],["富ませ","とませ"],["、"],["低く","ひくく"],["し"],["、"],["また"],["高く","たかく"],["する"],["の"],["です"],["。"]]},{"verse":8,"text":"主は、弱い者をちりから起こし、貧しい人を、あくたから引き上げ、高貴な者とともに、すわらせ、彼らに栄光の位を継がせます。／まことに、地の柱は主のもの、その上に主は世界を据えられました。","tok":[["主","ぬし"],["は"],["、"],["弱い","よわい"],["者","もの"],["を"],["ちり"],["から"],["起こし","おこし"],["、"],["貧しい","まずしい"],["人","ひと"],["を"],["、"],["あくた"],["から"],["引き上げ","ひきあげ"],["、"],["高貴","こうき"],["な"],["者","もの"],["と"],["とも"],["に"],["、"],["すわらせ"],["、"],["彼","かれ"],["ら"],["に"],["栄光","えいこう"],["の"],["位","くらい"],["を"],["継がせます","つがせます"],["。"],["／"],["まこと"],["に"],["、"],["地","ち"],["の"],["柱","はしら"],["は"],["主","ぬし"],["の"],["もの"],["、"],["その"],["上","うえ"],["に"],["主","ぬし"],["は"],["世界","せかい"],["を"],["据えられました","すえられました"],["。"]]},{"verse":9,"text":"主は聖徒たちの足を守られます。／悪者どもは、やみの中に滅びうせます。／まことに人は、おのれの力によっては勝てません。","tok":[["主","ぬし"],["は"],["聖徒","せいと"],["たち"],["の"],["足","あし"],["を"],["守られます","まもられます"],["。"],["／"],["悪者","わるもの"],["ども"],["は"],["、"],["やみ"],["の"],["中","なか"],["に"],["滅び","ほろび"],["うせます"],["。"],["／"],["まこと"],["に"],["人","ひと"],["は"],["、"],["おのれ"],["の"],["力","ちから"],["によって"],["は"],["勝てません","かてません"],["。"]]},{"verse":10,"text":"主は、はむかう者を打ち砕き、その者に、天から雷鳴を響かせられます。／主は地の果て果てまでさばき、ご自分の王に力を授け、主に油そそがれた者の角を高く上げられます。」","tok":[["主","ぬし"],["は"],["、"],["はむかう"],["者","もの"],["を"],["打ち砕き","うちくだき"],["、"],["その"],["者","もの"],["に"],["、"],["天","てん"],["から"],["雷鳴","らいめい"],["を"],["響かせられます","ひびかせられます"],["。"],["／"],["主","ぬし"],["は"],["地","ち"],["の"],["果て果て","はてはて"],["まで"],["さばき"],["、"],["ご自分","ごじぶん"],["の"],["王","おう"],["に"],["力","ちから"],["を"],["授け","さずけ"],["、"],["主に","おもに"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["角","かど"],["を"],["高く","たかく"],["上げられます","あげられます"],["。"],["」"]]},{"verse":11,"text":"その後、エルカナはラマの自分の家に帰った。幼子は、祭司エリのもとで主に仕えていた。","tok":[["その"],["後","ご"],["、"],["エルカナ"],["は"],["ラマ"],["の"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰った","かえった"],["。"],["幼子","おさなご"],["は"],["、"],["祭司","さいし"],["エリ"],["の"],["もと"],["で"],["主に","おもに"],["仕えて","つかえて"],["いた"],["。"]]},{"verse":12,"text":"さて、エリの息子たちは、よこしまな者で、主を知らず、","tok":[["さて"],["、"],["エリ"],["の"],["息子","むすこ"],["たち"],["は"],["、"],["よこしま"],["な"],["者","もの"],["で"],["、"],["主","ぬし"],["を"],["知らず","しらず"],["、"]]},{"verse":13,"text":"民にかかわる祭司の定めについてもそうであった。だれかが、いけにえをささげていると、まだ肉を煮ている間に、祭司の子が三又の肉刺しを手にしてやって来て、","tok":[["民","みん"],["に"],["かかわる"],["祭司","さいし"],["の"],["定め","さだめ"],["について"],["も"],["そう"],["で"],["あった"],["。"],["だれ"],["か"],["が"],["、"],["いけにえ"],["を"],["ささげて"],["いる"],["と"],["、"],["まだ"],["肉","にく"],["を"],["煮て","にて"],["いる"],["間","あいだ"],["に"],["、"],["祭司","さいし"],["の"],["子","こ"],["が"],["三又","みつまた"],["の"],["肉刺し","にくさし"],["を"],["手","て"],["に"],["して"],["やって"],["来て","きて"],["、"]]},{"verse":14,"text":"これを、大なべや、かまや、大がまや、なべに突き入れ、肉刺しで取り上げたものをみな、祭司が自分のものとして取っていた。彼らはシロで、そこに来るすべてのイスラエルに、このようにしていた。","tok":[["これ"],["を"],["、"],["大なべ","おおなべ"],["や"],["、"],["かま"],["や"],["、"],["大","だい"],["がま"],["や"],["、"],["なべ"],["に"],["突き入れ","つきいれ"],["、"],["肉刺し","にくさし"],["で"],["取り上げた","とりあげた"],["もの"],["を"],["みな"],["、"],["祭司","さいし"],["が"],["自分","じぶん"],["の"],["もの"],["として"],["取って","とって"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["シロ"],["で"],["、"],["そこ"],["に"],["来る","くる"],["すべて"],["の"],["イスラエル"],["に"],["、"],["この"],["よう"],["に"],["して"],["いた"],["。"]]},{"verse":15,"text":"それどころか、人々が脂肪を焼いて煙にしないうちに祭司の子はやって来て、いけにえをささげる人に、「祭司に、その焼く肉を渡しなさい。祭司は煮た肉は受け取りません。生の肉だけです」と言うので、","tok":[["それ"],["どころ"],["か"],["、"],["人々","ひとびと"],["が"],["脂肪","しぼう"],["を"],["焼いて","やいて"],["煙","けむり"],["に"],["しない"],["うち"],["に"],["祭司","さいし"],["の"],["子","こ"],["は"],["やって"],["来て","きて"],["、"],["いけにえ"],["を"],["ささげる"],["人","ひと"],["に"],["、"],["「"],["祭司","さいし"],["に"],["、"],["その"],["焼く","やく"],["肉","にく"],["を"],["渡し","わたし"],["なさい"],["。"],["祭司","さいし"],["は"],["煮た","にた"],["肉","にく"],["は"],["受け取りません","うけとりません"],["。"],["生","なま"],["の"],["肉","にく"],["だけ"],["です"],["」"],["と"],["言う","いう"],["ので"],["、"]]},{"verse":16,"text":"人が、「まず、脂肪をすっかり焼いて煙にし、好きなだけお取りなさい」と言うと、祭司の子は、「いや、いま渡さなければならない。でなければ、私は力ずくで取る」と言った。","tok":[["人","ひと"],["が"],["、"],["「"],["まず"],["、"],["脂肪","しぼう"],["を"],["すっかり"],["焼いて","やいて"],["煙","けむり"],["に"],["し"],["、"],["好き","すき"],["な"],["だけ"],["お取り","おとり"],["なさい"],["」"],["と"],["言う","ゆう"],["と"],["、"],["祭司","さいし"],["の"],["子","こ"],["は"],["、"],["「"],["いや"],["、"],["いま"],["渡さなければ","わたさなければ"],["ならない"],["。"],["で"],["なければ"],["、"],["私","わたくし"],["は"],["力","ちから"],["ずく"],["で"],["取る","とる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"このように、子たちの罪は、主の前で非常に大きかった。主へのささげ物を、この人たちが侮ったからである。","tok":[["この"],["よう"],["に"],["、"],["子","こ"],["たち"],["の"],["罪","つみ"],["は"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["非常","ひじょう"],["に"],["大きかった","おおきかった"],["。"],["主","ぬし"],["へ"],["の"],["ささげ物","ささげもの"],["を"],["、"],["この"],["人","ひと"],["たち"],["が"],["侮った","あなどった"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"サムエルはまだ幼く、亜麻布のエポデを身にまとい、主の前に仕えていた。","tok":[["サムエル"],["は"],["まだ"],["幼く","おさなく"],["、"],["亜","あ"],["麻布","あざぶ"],["の"],["エポデ"],["を"],["身","み"],["に"],["まとい"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["仕えて","つかえて"],["いた"],["。"]]},{"verse":19,"text":"サムエルの母は、彼のために小さな上着を作り、毎年、夫とともに、その年のいけにえをささげに上って行くとき、その上着を持って行くのだった。","tok":[["サムエル"],["の"],["母","はは"],["は"],["、"],["彼","かれ"],["の"],["ため"],["に"],["小さな","ちいさな"],["上着","うわぎ"],["を"],["作り","つくり"],["、"],["毎年","まいとし"],["、"],["夫","おっと"],["と"],["とも"],["に"],["、"],["その"],["年","とし"],["の"],["いけにえ"],["を"],["ささげ"],["に"],["上って","のぼって"],["行く","いく"],["とき"],["、"],["その"],["上着","うわぎ"],["を"],["持って","もって"],["行く","いく"],["の"],["だった"],["。"]]},{"verse":20,"text":"エリは、エルカナとその妻を祝福して、「主がお求めになった者の代わりに、主がこの女により、あなたに子どもを賜りますように」と言い、彼らは、自分の家に帰るのであった。","tok":[["エリ"],["は"],["、"],["エルカナ"],["と"],["その"],["妻","つま"],["を"],["祝福","しゅくふく"],["して"],["、"],["「"],["主","ぬし"],["が"],["お求め","おもとめ"],["に"],["なった"],["者","もの"],["の"],["代わり","かわり"],["に"],["、"],["主","ぬし"],["が"],["この"],["女","おんな"],["に"],["より"],["、"],["あなた"],["に"],["子ども","こども"],["を"],["賜ります","たまわります"],["よう"],["に"],["」"],["と"],["言い","いい"],["、"],["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰る","かえる"],["ので"],["あった"],["。"]]},{"verse":21,"text":"事実、主はハンナを顧み、彼女はみごもって、三人の息子と、ふたりの娘を産んだ。少年サムエルは、主のみもとで成長した。","tok":[["事実","じじつ"],["、"],["主","ぬし"],["は"],["ハンナ"],["を"],["顧み","かえりみ"],["、"],["彼女","かのじょ"],["は"],["みごもって"],["、"],["三人","さんにん"],["の"],["息子","むすこ"],["と"],["、"],["ふたり"],["の"],["娘","むすめ"],["を"],["産んだ","うんだ"],["。"],["少年","しょうねん"],["サムエル"],["は"],["、"],["主","ぬし"],["のみ"],["もと"],["で"],["成長","せいちょう"],["した"],["。"]]},{"verse":22,"text":"エリは非常に年をとっていた。彼は自分の息子たちがイスラエル全体に行っていることの一部始終、それに彼らが会見の天幕の入口で仕えている女たちと寝ているということを聞いた。","tok":[["エリ"],["は"],["非常","ひじょう"],["に"],["年","とし"],["を"],["とって"],["いた"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["息子","むすこ"],["たち"],["が"],["イスラエル"],["全体","ぜんたい"],["に"],["行って","いって"],["いる"],["こと"],["の"],["一部","いちぶ"],["始終","しじゅう"],["、"],["それ"],["に"],["彼","かれ"],["ら"],["が"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["で"],["仕えて","つかえて"],["いる"],["女","おんな"],["たち"],["と"],["寝て","ねて"],["いる"],["と"],["いう"],["こと"],["を"],["聞いた","きいた"],["。"]]},{"verse":23,"text":"それでエリは息子たちに言った。「なぜ、おまえたちはこんなことをするのだ。私はこの民全部から、おまえたちのした悪いことについて聞いている。","tok":[["それ"],["で"],["エリ"],["は"],["息子","むすこ"],["たち"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["おまえ"],["たち"],["は"],["こんな"],["こと"],["を"],["する"],["の"],["だ"],["。"],["私","わたくし"],["は"],["この"],["民","みん"],["全部","ぜんぶ"],["から"],["、"],["おまえ"],["たち"],["の"],["した"],["悪い","わるい"],["こと"],["について"],["聞いて","きいて"],["いる"],["。"]]},{"verse":24,"text":"子たちよ。そういうことをしてはいけない。私が主の民の言いふらしているのを聞くそのうわさは良いものではない。","tok":[["子","こ"],["たち"],["よ"],["。"],["そう"],["いう"],["こと"],["を"],["して"],["は"],["いけない"],["。"],["私","わたくし"],["が"],["主","ぬし"],["の"],["民","たみ"],["の"],["言いふらして","いいふらして"],["いる"],["の"],["を"],["聞く","きく"],["その"],["うわさ"],["は"],["良い","よい"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":25,"text":"人がもし、ほかの人に対して罪を犯すと、神がその仲裁をしてくださる。だが、人が主に対して罪を犯したら、だれが、その者のために仲裁に立とうか。」しかし、彼らは父の言うことを聞こうとしなかった。彼らを殺すことが主のみこころであったからである。","tok":[["人","ひと"],["が"],["もし"],["、"],["ほか"],["の"],["人","ひと"],["に対して","にたいして"],["罪","つみ"],["を"],["犯す","おかす"],["と"],["、"],["神","かみ"],["が"],["その"],["仲裁","ちゅうさい"],["を"],["して"],["くださる"],["。"],["だ"],["が"],["、"],["人","ひと"],["が"],["主","ぬし"],["に対して","にたいして"],["罪","つみ"],["を"],["犯したら","おかしたら"],["、"],["だれ"],["が"],["、"],["その"],["者","もの"],["の"],["ため"],["に"],["仲裁","ちゅうさい"],["に"],["立とう","たとう"],["か"],["。"],["」"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["父","ちち"],["の"],["言う","いう"],["こと"],["を"],["聞こう","きこう"],["と"],["しなかった"],["。"],["彼","かれ"],["ら"],["を"],["殺す","ころす"],["こと"],["が"],["主","ぬし"],["のみ"],["こころ"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"一方、少年サムエルはますます成長し、主にも、人にも愛された。","tok":[["一方","いっぽう"],["、"],["少年","しょうねん"],["サムエル"],["は"],["ますます"],["成長","せいちょう"],["し"],["、"],["主に","おもに"],["も"],["、"],["人","ひと"],["に"],["も"],["愛された","あいされた"],["。"]]},{"verse":27,"text":"そのころ、神の人がエリのところに来て、彼に言った。「主はこう仰せられる。／あなたの父の家がエジプトでパロの家に属していたとき、わたしは、この身を明らかに彼らに示したではないか。","tok":[["その"],["ころ"],["、"],["神","かみ"],["の"],["人","ひと"],["が"],["エリ"],["の"],["ところ"],["に"],["来て","きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["が"],["エジプト"],["で"],["パロ"],["の"],["家","いえ"],["に"],["属して","ぞくして"],["いた"],["とき"],["、"],["わたし"],["は"],["、"],["この"],["身","み"],["を"],["明らか","あきらか"],["に"],["彼","かれ"],["ら"],["に"],["示したで","しめしたで"],["は"],["ない"],["か"],["。"]]},{"verse":28,"text":"また、イスラエルの全部族から、その家を選び、わたしの祭司とし、わたしの祭壇に上り、香をたき、わたしの前でエポデを着るようにした。こうして、イスラエル人のすべての火によるささげ物を、あなたの父の家に与えた。","tok":[["また"],["、"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["から"],["、"],["その"],["家","いえ"],["を"],["選び","えらび"],["、"],["わたし"],["の"],["祭司","さいし"],["と"],["し"],["、"],["わたし"],["の"],["祭壇","さいだん"],["に"],["上り","のぼり"],["、"],["香","こう"],["を"],["たき"],["、"],["わたし"],["の"],["前","まえ"],["で"],["エポデ"],["を"],["着る","きる"],["よう"],["に"],["した"],["。"],["こう"],["して"],["、"],["イスラエル"],["人","にん"],["の"],["すべて"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["を"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["与えた","あたえた"],["。"]]},{"verse":29,"text":"なぜ、あなたがたは、わたしが命じたわたしへのいけにえ、わたしへのささげ物を、わたしの住む所で軽くあしらい、またあなたは、わたしよりも自分の息子たちを重んじて、わたしの民イスラエルのすべてのささげ物のうち最上の部分で自分たちを肥やそうとするのか。","tok":[["なぜ"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["命じた","めいじた"],["わたし"],["へ"],["の"],["いけにえ"],["、"],["わたし"],["へ"],["の"],["ささげ物","ささげもの"],["を"],["、"],["わたし"],["の"],["住む","すむ"],["所","ところ"],["で"],["軽く","かるく"],["あしらい"],["、"],["また"],["あなた"],["は"],["、"],["わたし"],["より"],["も"],["自分","じぶん"],["の"],["息子","むすこ"],["たち"],["を"],["重んじて","おもんじて"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["すべて"],["の"],["ささげ物","ささげもの"],["の"],["うち"],["最上","さいじょう"],["の"],["部分","ぶぶん"],["で"],["自分","じぶん"],["たち"],["を"],["肥やそう","こやそう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":30,"text":"それゆえ、――イスラエルの神、主の御告げだ――あなたの家と、あなたの父の家とは、永遠にわたしの前を歩む、と確かに言ったが、今や、――主の御告げだ――絶対にそんなことはない。わたしは、わたしを尊ぶ者を尊ぶ。わたしをさげすむ者は軽んじられる。","tok":[["それ"],["ゆえ"],["、"],["―"],["―"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御告げ","おつげ"],["だ"],["―"],["―"],["あなた"],["の"],["家","いえ"],["と"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["と"],["は"],["、"],["永遠","えいえん"],["に"],["わたし"],["の"],["前","まえ"],["を"],["歩む","あゆむ"],["、"],["と"],["確か","たしか"],["に"],["言った","いった"],["が"],["、"],["今","いま"],["や"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["だ"],["―"],["―"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["、"],["わたし"],["を"],["尊ぶ","とうとぶ"],["者","もの"],["を"],["尊ぶ","とうとぶ"],["。"],["わたし"],["を"],["さげすむ"],["者","もの"],["は"],["軽んじられる","かろんじられる"],["。"]]},{"verse":31,"text":"見よ。わたしがあなたの腕と、あなたの父の家の腕とを切り落とし、あなたの家には年寄りがいなくなる日が近づいている。","tok":[["見","み"],["よ"],["。"],["わたし"],["が"],["あなた"],["の"],["腕","うで"],["と"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["腕","うで"],["と"],["を"],["切り落とし","きりおとし"],["、"],["あなた"],["の"],["家","いえ"],["に"],["は"],["年寄り","としより"],["が"],["いなく"],["なる"],["日","ひ"],["が"],["近づいて","ちかづいて"],["いる"],["。"]]},{"verse":32,"text":"イスラエルはしあわせにされるのに、あなたはわたしの住む所で敵を見るようになろう。あなたの家には、いつまでも、年寄りがいなくなる。","tok":[["イスラエル"],["は"],["しあわせ"],["に"],["される"],["のに"],["、"],["あなた"],["は"],["わたし"],["の"],["住む","すむ"],["所","ところ"],["で"],["敵","てき"],["を"],["見る","みる"],["よう"],["に"],["なろう"],["。"],["あなた"],["の"],["家","いえ"],["に"],["は"],["、"],["いつ"],["まで"],["も"],["、"],["年寄り","としより"],["が"],["いなく"],["なる"],["。"]]},{"verse":33,"text":"わたしは、ひとりの人をあなたのために、わたしの祭壇から断ち切らない。その人はあなたの目を衰えさせ、あなたの心をやつれさせよう。あなたの家の多くの者はみな、壮年のうちに死ななければならない。","tok":[["わたし"],["は"],["、"],["ひとり"],["の"],["人","ひと"],["を"],["あなた"],["の"],["ため"],["に"],["、"],["わたし"],["の"],["祭壇","さいだん"],["から"],["断ち切らない","たちきらない"],["。"],["その"],["人","ひと"],["は"],["あなた"],["の"],["目","め"],["を"],["衰えさせ","おとろえさせ"],["、"],["あなた"],["の"],["心","こころ"],["を"],["やつれさせよう"],["。"],["あなた"],["の"],["家","いえ"],["の"],["多く","おおく"],["の"],["者","もの"],["は"],["みな"],["、"],["壮年","そうねん"],["の"],["うち"],["に"],["死ななければ","しななければ"],["ならない"],["。"]]},{"verse":34,"text":"あなたのふたりの息子、ホフニとピネハスの身にふりかかることが、あなたへのしるしである。ふたりとも一日のうちに死ぬ。","tok":[["あなた"],["の"],["ふたり"],["の"],["息子","むすこ"],["、"],["ホフニ"],["と"],["ピネハス"],["の"],["身","み"],["に"],["ふりかかる"],["こと"],["が"],["、"],["あなた"],["へ"],["の"],["しるし"],["で"],["ある"],["。"],["ふたり"],["とも"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":35,"text":"わたしは、わたしの心と思いの中で事を行う忠実な祭司を、わたしのために起こそう。わたしは彼のために長く続く家を建てよう。彼は、いつまでもわたしに油そそがれた者の前を歩むであろう。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["心","こころ"],["と"],["思い","おもい"],["の"],["中","なか"],["で"],["事","こと"],["を"],["行う","おこなう"],["忠実","ちゅうじつ"],["な"],["祭司","さいし"],["を"],["、"],["わたし"],["の"],["ため"],["に"],["起こそう","おこそう"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["ため"],["に"],["長く","ながく"],["続く","つづく"],["家","いえ"],["を"],["建てよう","たてよう"],["。"],["彼","かれ"],["は"],["、"],["いつ"],["まで"],["も"],["わたし"],["に"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["前","まえ"],["を"],["歩むで","あゆむで"],["あろう"],["。"]]},{"verse":36,"text":"あなたの家の生き残った者はみな、賃金とパン一個を求めて彼のところに来ておじぎをし、『どうか、祭司の務めの一つでも私にあてがって、一切れのパンを食べさせてください』と言おう。」","tok":[["あなた"],["の"],["家","いえ"],["の"],["生き残った","いきのこった"],["者","もの"],["は"],["みな"],["、"],["賃金","ちんぎん"],["と"],["パン"],["一個","いちこ"],["を"],["求めて","もとめて"],["彼","かれ"],["の"],["ところ"],["に"],["来て","きて"],["おじぎ"],["を"],["し"],["、"],["『"],["どう"],["か"],["、"],["祭司","さいし"],["の"],["務め","つとめ"],["の"],["一","ひと"],["つ"],["で"],["も"],["私","わたくし"],["に"],["あてがって"],["、"],["一切れ","ひときれ"],["の"],["パン"],["を"],["食べさせて","たべさせて"],["ください"],["』"],["と"
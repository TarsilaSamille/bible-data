[{"verse":1,"text":"ダビデはそこを去って、アドラムのほら穴に避難した。彼の兄弟たちや、彼の父の家のみなの者が、これを聞いて、そのダビデのところに下って来た。","tok":[["ダビデ"],["は"],["そこ"],["を"],["去って","さって"],["、"],["アドラム"],["の"],["ほら穴","ほらあな"],["に"],["避難","ひなん"],["した"],["。"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["や"],["、"],["彼","かれ"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["みな"],["の"],["者","もの"],["が"],["、"],["これ"],["を"],["聞いて","きいて"],["、"],["その"],["ダビデ"],["の"],["ところ"],["に"],["下って","くだって"],["来た","きた"],["。"]]},{"verse":2,"text":"また、困窮している者、負債のある者、不満のある者たちもみな、彼のところに集まって来たので、ダビデは彼らの長となった。こうして、約四百人の者が彼とともにいるようになった。","tok":[["また"],["、"],["困窮","こんきゅう"],["して"],["いる"],["者","もの"],["、"],["負債","ふさい"],["の"],["ある"],["者","もの"],["、"],["不満","ふまん"],["の"],["ある"],["者","もの"],["たち"],["も"],["みな"],["、"],["彼","かれ"],["の"],["ところ"],["に"],["集まって","あつまって"],["来た","きた"],["ので"],["、"],["ダビデ"],["は"],["彼","かれ"],["ら"],["の"],["長","ちょう"],["と"],["なった"],["。"],["こう"],["して"],["、"],["約","やく"],["四百人","よんひゃくにん"],["の"],["者","もの"],["が"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["よう"],["に"],["なった"],["。"]]},{"verse":3,"text":"ダビデはそこからモアブのミツパに行き、モアブの王に言った。「神が私にどんなことをされるかわかるまで、どうか、私の父と母とを出て来させて、あなたがたといっしょにおらせてください。」","tok":[["ダビデ"],["は"],["そこ"],["から"],["モアブ"],["の"],["ミツパ"],["に"],["行き","いき"],["、"],["モアブ"],["の"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["が"],["私","わたくし"],["に"],["どんな"],["こと"],["を"],["される"],["か"],["わかる"],["まで"],["、"],["どう"],["か"],["、"],["私","わたくし"],["の"],["父","ちち"],["と"],["母","はは"],["と"],["を"],["出て","でて"],["来させて","きさせて"],["、"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["おらせて"],["ください"],["。"],["」"]]},{"verse":4,"text":"こうしてダビデが両親をモアブの王の前に連れて来たので、両親は、ダビデが要害にいる間、王のもとに住んだ。","tok":[["こう"],["して"],["ダビデ"],["が"],["両親","りょうしん"],["を"],["モアブ"],["の"],["王","おう"],["の"],["前","まえ"],["に"],["連れて","つれて"],["来た","きた"],["ので"],["、"],["両親","りょうしん"],["は"],["、"],["ダビデ"],["が"],["要害","ようがい"],["に"],["いる"],["間","あいだ"],["、"],["王","おう"],["の"],["もと"],["に"],["住んだ","すんだ"],["。"]]},{"verse":5,"text":"そのころ、預言者ガドはダビデに言った。「この要害にとどまっていないで、さあ、ユダの地に帰りなさい。」そこでダビデは出て、ハレテの森へ行った。","tok":[["その"],["ころ"],["、"],["預言者","よげんしゃ"],["ガド"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["この"],["要害","ようがい"],["に"],["とどまって"],["いないで"],["、"],["さあ"],["、"],["ユダ"],["の"],["地","ち"],["に"],["帰り","かえり"],["なさい"],["。"],["」"],["そこ"],["で"],["ダビデ"],["は"],["出て","でて"],["、"],["ハレテ"],["の"],["森","もり"],["へ"],["行った","いった"],["。"]]},{"verse":6,"text":"サウルは、ダビデおよび彼とともにいる者たちが見つかった、ということを聞いた。そのとき、サウルはギブアにある高台の柳の木の下で、槍を手にしてすわっていた。彼の家来たちはみな、彼のそばに立っていた。","tok":[["サウル"],["は"],["、"],["ダビデ"],["および"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["者","もの"],["たち"],["が"],["見つかった","みつかった"],["、"],["と"],["いう"],["こと"],["を"],["聞いた","きいた"],["。"],["その"],["とき"],["、"],["サウル"],["は"],["ギブア"],["に"],["ある"],["高台","たかだい"],["の"],["柳","やなぎ"],["の"],["木","き"],["の"],["下","もと"],["で"],["、"],["槍","やり"],["を"],["手","て"],["に"],["して"],["すわって"],["いた"],["。"],["彼","かれ"],["の"],["家来","けらい"],["たち"],["は"],["みな"],["、"],["彼","かれ"],["の"],["そば"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":7,"text":"サウルは、そばに立っている家来たちに言った。「聞け。ベニヤミン人。エッサイの子が、おまえたち全部に畑やぶどう畑をくれ、おまえたち全部を千人隊の長、百人隊の長にするであろうか。","tok":[["サウル"],["は"],["、"],["そば"],["に"],["立って","たって"],["いる"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["聞け","きけ"],["。"],["ベニヤミン"],["人","にん"],["。"],["エッサイ"],["の"],["子","こ"],["が"],["、"],["おまえ"],["たち"],["全部","ぜんぶ"],["に"],["畑","はたけ"],["や"],["ぶどう"],["畑","はたけ"],["を"],["くれ"],["、"],["おまえ"],["たち"],["全部","ぜんぶ"],["を"],["千人隊","せんにんたい"],["の"],["長","ちょう"],["、"],["百人隊","ひゃくにんたい"],["の"],["長","ちょう"],["に"],["するで"],["あろう"],["か"],["。"]]},{"verse":8,"text":"それなのに、おまえたちはみな、私に謀反を企てている。きょうのように、息子がエッサイの子と契約を結んだことも私の耳に入れず、息子が私のあのしもべを私に、はむかわせるようにしたことも、私の耳に入れず、だれも私のことを思って心を痛めない。」","tok":[["それ"],["な"],["のに"],["、"],["おまえ"],["たち"],["は"],["みな"],["、"],["私","わたくし"],["に"],["謀反","むほん"],["を"],["企てて","くわだてて"],["いる"],["。"],["きょう"],["の"],["よう"],["に"],["、"],["息子","むすこ"],["が"],["エッサイ"],["の"],["子","こ"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["こと"],["も"],["私","わたくし"],["の"],["耳","みみ"],["に"],["入れず","いれず"],["、"],["息子","むすこ"],["が"],["私","わたくし"],["の"],["あの"],["しもべ"],["を"],["私","わたくし"],["に"],["、"],["はむかわせる"],["よう"],["に"],["した"],["こと"],["も"],["、"],["私","わたくし"],["の"],["耳","みみ"],["に"],["入れず","いれず"],["、"],["だれ"],["も"],["私","わたくし"],["の"],["こと"],["を"],["思って","おもって"],["心","こころ"],["を"],["痛めない","いためない"],["。"],["」"]]},{"verse":9,"text":"すると、サウルの家来のそばに立っていたエドム人ドエグが答えて言った。「私は、エッサイの子が、ノブのアヒトブの子アヒメレクのところに来たのを見ました。","tok":[["する"],["と"],["、"],["サウル"],["の"],["家来","けらい"],["の"],["そば"],["に"],["立って","たって"],["いた"],["エドム人","えどむにん"],["ドエグ"],["が"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["エッサイ"],["の"],["子","こ"],["が"],["、"],["ノブ"],["の"],["アヒトブ"],["の"],["子","こ"],["アヒメレク"],["の"],["ところ"],["に"],["来た","きた"],["の"],["を"],["見ました","みました"],["。"]]},{"verse":10,"text":"アヒメレクは彼のために主に伺って、彼に食料を与え、ペリシテ人ゴリヤテの剣も与えました。」","tok":[["アヒメレク"],["は"],["彼","かれ"],["の"],["ため"],["に"],["主","ぬし"],["に"],["伺って","うかがって"],["、"],["彼","かれ"],["に"],["食料","しょくりょう"],["を"],["与え","あたえ"],["、"],["ペリシテ"],["人","にん"],["ゴリヤテ"],["の"],["剣","けん"],["も"],["与えました","あたえました"],["。"],["」"]]},{"verse":11,"text":"そこで王は人をやって、祭司アヒトブの子アヒメレクと、彼の父の家の者全部、すなわち、ノブにいる祭司たちを呼び寄せたので、彼らはみな、王のところに来た。","tok":[["そこ"],["で"],["王","おう"],["は"],["人","ひと"],["を"],["やって"],["、"],["祭司","さいし"],["アヒトブ"],["の"],["子","こ"],["アヒメレク"],["と"],["、"],["彼","かれ"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["全部","ぜんぶ"],["、"],["すなわち"],["、"],["ノブ"],["に"],["いる"],["祭司","さいし"],["たち"],["を"],["呼び寄せた","よびよせた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["王","おう"],["の"],["ところ"],["に"],["来た","きた"],["。"]]},{"verse":12,"text":"サウルは言った。「聞け。アヒトブの息子。」彼は答えた。「はい、王さま。ここにおります。」","tok":[["サウル"],["は"],["言った","いった"],["。"],["「"],["聞け","きけ"],["。"],["アヒトブ"],["の"],["息子","むすこ"],["。"],["」"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["はい"],["、"],["王","おう"],["さま"],["。"],["ここ"],["に"],["おります"],["。"],["」"]]},{"verse":13,"text":"サウルは彼に言った。「おまえとエッサイの子は、なぜ私に謀反を企てるのか。おまえは彼にパンと剣を与え、彼がきょうあるように、私に、はむかうために彼のために神に伺ったりしている。」","tok":[["サウル"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["と"],["エッサイ"],["の"],["子","こ"],["は"],["、"],["なぜ"],["私","わたくし"],["に"],["謀反","むほん"],["を"],["企てる","くわだてる"],["の"],["か"],["。"],["おまえ"],["は"],["彼","かれ"],["に"],["パン"],["と"],["剣","けん"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["が"],["きょう"],["ある"],["よう"],["に"],["、"],["私","わたくし"],["に"],["、"],["はむかう"],["ため"],["に"],["彼","かれ"],["の"],["ため"],["に"],["神","かみ"],["に"],["伺っ","うかがっ"],["たり"],["して"],["いる"],["。"],["」"]]},{"verse":14,"text":"アヒメレクは王に答えて言った。「あなたの家来のうち、ダビデほど忠実な者が、ほかにだれかいるでしょうか。ダビデは王の婿であり、あなたの護衛の長であり、あなたの家では尊敬されているではありませんか。","tok":[["アヒメレク"],["は"],["王","おう"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あなた"],["の"],["家来","けらい"],["の"],["うち"],["、"],["ダビデ"],["ほど"],["忠実","ちゅうじつ"],["な"],["者","もの"],["が"],["、"],["ほか"],["に"],["だれ"],["か"],["いるでしょう"],["か"],["。"],["ダビデ"],["は"],["王","おう"],["の"],["婿","むこ"],["で"],["あり"],["、"],["あなた"],["の"],["護衛","ごえい"],["の"],["長","ちょう"],["で"],["あり"],["、"],["あなた"],["の"],["家","いえ"],["で"],["は"],["尊敬","そんけい"],["されて"],["いるで"],["は"],["ありません"],["か"],["。"]]},{"verse":15,"text":"私が彼のために神に伺うのは、きょうに始まったことでしょうか。決して、決して。王さま。私や、私の父の家の者全部に汚名を着せないでください。しもべは、この事件については、いっさい知らないのですから。」","tok":[["私","わたくし"],["が"],["彼","かれ"],["の"],["ため"],["に"],["神","かみ"],["に"],["伺う","うかがう"],["の"],["は"],["、"],["きょう"],["に"],["始まった","はじまった"],["こと"],["でしょう"],["か"],["。"],["決して","けっして"],["、"],["決して","けっして"],["。"],["王","おう"],["さま"],["。"],["私","わたくし"],["や"],["、"],["私","わたくし"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["全部","ぜんぶ"],["に"],["汚名","おめい"],["を"],["着せないで","きせないで"],["ください"],["。"],["しもべ"],["は"],["、"],["この"],["事件","じけん"],["について"],["は"],["、"],["いっさい"],["知らない","しらない"],["の"],["です"],["から"],["。"],["」"]]},{"verse":16,"text":"しかし王は言った。「アヒメレク。おまえは必ず死ななければならない。おまえも、おまえの父の家の者全部もだ。」","tok":[["しかし"],["王","おう"],["は"],["言った","いった"],["。"],["「"],["アヒメレク"],["。"],["おまえ"],["は"],["必ず","かならず"],["死ななければ","しななければ"],["ならない"],["。"],["おまえ"],["も"],["、"],["おまえ"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["全部","ぜんぶ"],["も"],["だ"],["。"],["」"]]},{"verse":17,"text":"それから、王はそばに立っていた近衛兵たちに言った。「近寄って、主の祭司たちを殺せ。彼らはダビデにくみし、彼が逃げているのを知りながら、それを私の耳に入れなかったからだ。」しかし王の家来たちは、主の祭司たちに手を出して撃ちかかろうとはしなかった。","tok":[["それ"],["から"],["、"],["王","おう"],["は"],["そば"],["に"],["立って","たって"],["いた"],["近衛兵","このえへい"],["たち"],["に"],["言った","いった"],["。"],["「"],["近寄って","ちかよって"],["、"],["主","ぬし"],["の"],["祭司","さいし"],["たち"],["を"],["殺せ","ころせ"],["。"],["彼","かれ"],["ら"],["は"],["ダビデ"],["に"],["くみし"],["、"],["彼","かれ"],["が"],["逃げて","にげて"],["いる"],["の"],["を"],["知り","しり"],["ながら"],["、"],["それ"],["を"],["私","わたくし"],["の"],["耳","みみ"],["に"],["入れなかった","いれなかった"],["から"],["だ"],["。"],["」"],["しかし"],["王","おう"],["の"],["家来","けらい"],["たち"],["は"],["、"],["主","ぬし"],["の"],["祭司","さいし"],["たち"],["に"],["手","て"],["を"],["出して","だして"],["撃ち","うち"],["かかろう"],["と"],["は"],["しなかった"],["。"]]},{"verse":18,"text":"それで王はドエグに言った。「おまえが近寄って祭司たちに撃ちかかれ。」そこでエドム人ドエグが近寄って、祭司たちに撃ちかかった。その日、彼は八十五人を殺した。それぞれ亜麻布のエポデを着ていた人であった。","tok":[["それ"],["で"],["王","おう"],["は"],["ドエグ"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["が"],["近寄って","ちかよって"],["祭司","さいし"],["たち"],["に"],["撃ち","うち"],["かかれ"],["。"],["」"],["そこ"],["で"],["エドム人","えどむにん"],["ドエグ"],["が"],["近寄って","ちかよって"],["、"],["祭司","さいし"],["たち"],["に"],["撃ち","うち"],["かかった"],["。"],["その"],["日","ひ"],["、"],["彼","かれ"],["は"],["八十五人","はちじゅうごにん"],["を"],["殺した","ころした"],["。"],["それぞれ"],["亜","あ"],["麻布","あざぶ"],["の"],["エポデ"],["を"],["着て","きて"],["いた"],["人","ひと"],["で"],["あった"],["。"]]},{"verse":19,"text":"彼は祭司の町ノブを、男も女も、子どもも乳飲み子までも、剣の刃で打った。牛もろばも羊も、剣の刃で打った。","tok":[["彼","かれ"],["は"],["祭司","さいし"],["の"],["町","まち"],["ノブ"],["を"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["、"],["子ども","こども"],["も"],["乳飲み子","ちのみご"],["まで"],["も"],["、"],["剣","けん"],["の"],["刃","は"],["で"],["打った","うった"],["。"],["牛","うし"],["も"],["ろば"],["も"],["羊","ひつじ"],["も"],["、"],["剣","けん"],["の"],["刃","は"],["で"],["打った","うった"],["。"]]},{"verse":20,"text":"ところが、アヒトブの子アヒメレクの息子のエブヤタルという名の人が、ひとりのがれてダビデのところに逃げて来た。","tok":[["ところ"],["が"],["、"],["アヒトブ"],["の"],["子","こ"],["アヒメレク"],["の"],["息子","むすこ"],["の"],["エブヤタル"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["が"],["、"],["ひとり"],["のがれて"],["ダビデ"],["の"],["ところ"],["に"],["逃げて","にげて"],["来た","きた"],["。"]]},{"verse":21,"text":"エブヤタルはダビデに、サウルが主の祭司たちを虐殺したことを告げた。","tok":[["エブヤタル"],["は"],["ダビデ"],["に"],["、"],["サウル"],["が"],["主
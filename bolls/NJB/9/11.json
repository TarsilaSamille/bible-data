[{"verse":1,"text":"その後、アモン人ナハシュが上って来て、ヤベシュ・ギルアデに対して陣を敷いた。ヤベシュの人々はみな、ナハシュに言った。「私たちと契約を結んでください。そうすれば、私たちはあなたに仕えましょう。」","tok":[["その"],["後","ご"],["、"],["アモン人","あもんにん"],["ナハシュ"],["が"],["上って","のぼって"],["来て","きて"],["、"],["ヤベシュ"],["・"],["ギルアデ"],["に対して","にたいして"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["ヤベシュ"],["の"],["人々","ひとびと"],["は"],["みな"],["、"],["ナハシュ"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["ください"],["。"],["そう"],["すれば"],["、"],["私たち","わたしたち"],["は"],["あなた"],["に"],["仕えましょう","つかえましょう"],["。"],["」"]]},{"verse":2,"text":"そこでアモン人ナハシュは彼らに言った。「次の条件で契約を結ぼう。おまえたちみなの者の右の目をえぐり取ることだ。それをもって全イスラエルにそしりを負わせよう。」","tok":[["そこ"],["で"],["アモン人","あもんにん"],["ナハシュ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["次","つぎ"],["の"],["条件","じょうけん"],["で"],["契約","けいやく"],["を"],["結ぼう","むすぼう"],["。"],["おまえ"],["たち"],["みな"],["の"],["者","もの"],["の"],["右","みぎ"],["の"],["目","め"],["を"],["えぐり取る","えぐりとる"],["こと"],["だ"],["。"],["それ"],["を"],["もって"],["全","ぜん"],["イスラエル"],["に"],["そしり"],["を"],["負わせよう","おわせよう"],["。"],["」"]]},{"verse":3,"text":"ヤベシュの長老たちは彼に言った。「七日の猶予を与えてください。イスラエルの国中に使者を送りたいのです。もし、私たちを救う者がいなければ、あなたに降伏します。」","tok":[["ヤベシュ"],["の"],["長老","ちょうろう"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["七日","ななか"],["の"],["猶予","ゆうよ"],["を"],["与えて","あたえて"],["ください"],["。"],["イスラエル"],["の"],["国中","くにちゅう"],["に"],["使者","ししゃ"],["を"],["送りたい","おくりたい"],["の"],["です"],["。"],["もし"],["、"],["私たち","わたしたち"],["を"],["救う","すくう"],["者","もの"],["が"],["いなければ"],["、"],["あなた"],["に"],["降伏","こうふく"],["します"],["。"],["」"]]},{"verse":4,"text":"使者たちはサウルのギブアに来て、このことをそこの民の耳に入れた。民はみな、声をあげて泣いた。","tok":[["使者","ししゃ"],["たち"],["は"],["サウル"],["の"],["ギブア"],["に"],["来て","きて"],["、"],["この"],["こと"],["を"],["そこ"],["の"],["民","たみ"],["の"],["耳","みみ"],["に"],["入れた","いれた"],["。"],["民","たみ"],["は"],["みな"],["、"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":5,"text":"そこへ、サウルが牛を追って畑から帰って来た。サウルは言った。「民が泣いているが、どうしたのですか。」そこで、みなが、ヤベシュの人々のことを彼に話した。","tok":[["そこ"],["へ"],["、"],["サウル"],["が"],["牛","うし"],["を"],["追って","おって"],["畑","はたけ"],["から"],["帰って","かえって"],["来た","きた"],["。"],["サウル"],["は"],["言った","いった"],["。"],["「"],["民","みん"],["が"],["泣いて","ないて"],["いる"],["が"],["、"],["どう"],["した"],["の"],["です"],["か"],["。"],["」"],["そこ"],["で"],["、"],["みな"],["が"],["、"],["ヤベシュ"],["の"],["人々","ひとびと"],["の"],["こと"],["を"],["彼","かれ"],["に"],["話した","はなした"],["。"]]},{"verse":6,"text":"サウルがこれらのことを聞いたとき、神の霊がサウルの上に激しく下った。それで彼の怒りは激しく燃え上がった。","tok":[["サウル"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["聞いた","きいた"],["とき"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["サウル"],["の"],["上","うえ"],["に"],["激しく","はげしく"],["下った","くだった"],["。"],["それ"],["で"],["彼","かれ"],["の"],["怒り","いかり"],["は"],["激しく","はげしく"],["燃え上がった","もえあがった"],["。"]]},{"verse":7,"text":"彼は一くびきの牛を取り、これを切り分け、それを使者に託してイスラエルの国中に送り、「サウルとサムエルとに従って出て来ない者の牛は、このようにされる」と言わせた。民は主を恐れて、いっせいに出て来た。","tok":[["彼","かれ"],["は"],["一","いち"],["く"],["びき"],["の"],["牛","うし"],["を"],["取り","とり"],["、"],["これ"],["を"],["切り分け","きりわけ"],["、"],["それ"],["を"],["使者","ししゃ"],["に"],["託して","たくして"],["イスラエル"],["の"],["国中","くにちゅう"],["に"],["送り","おくり"],["、"],["「"],["サウル"],["と"],["サムエル"],["と"],["に"],["従って","したがって"],["出て","でて"],["来ない","こない"],["者","もの"],["の"],["牛","うし"],["は"],["、"],["この"],["よう"],["に"],["される"],["」"],["と"],["言わせた","いわせた"],["。"],["民","たみ"],["は"],["主","ぬし"],["を"],["恐れて","おそれて"],["、"],["いっせい"],["に"],["出て","でて"],["来た","きた"],["。"]]},{"verse":8,"text":"サウルがベゼクで彼らを数えたとき、イスラエルの人々は三十万人、ユダの人々は三万人であった。","tok":[["サウル"],["が"],["ベゼク"],["で"],["彼","かれ"],["ら"],["を"],["数えた","かぞえた"],["とき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["三十万人","さんじゅうまんにん"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["三万人","さんまんにん"],["で"],["あった"],["。"]]},{"verse":9,"text":"彼らは、やって来た使者たちに言った。「ヤベシュ・ギルアデの人にこう言わなければならない。あすの真昼ごろ、あなたがたに救いがある。」使者たちは帰って来て、ヤベシュの人々に告げたので、彼らは喜んだ。","tok":[["彼","かれ"],["ら"],["は"],["、"],["やって"],["来た","きた"],["使者","ししゃ"],["たち"],["に"],["言った","いった"],["。"],["「"],["ヤベシュ"],["・"],["ギルアデ"],["の"],["人","ひと"],["に"],["こう"],["言わなければ","いわなければ"],["ならない"],["。"],["あす"],["の"],["真","ま"],["昼ごろ","ひるごろ"],["、"],["あなた"],["がた"],["に"],["救い","すくい"],["が"],["ある"],["。"],["」"],["使者","ししゃ"],["たち"],["は"],["帰って","かえって"],["来て","きて"],["、"],["ヤベシュ"],["の"],["人々","ひとびと"],["に"],["告げた","つげた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["喜んだ","よろこんだ"],["。"]]},{"verse":10,"text":"ヤベシュの人々は言った。「私たちは、あす、あなたがたに降伏します。あなたがたのよいと思うように私たちにしてください。」","tok":[["ヤベシュ"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["あす"],["、"],["あなた"],["がた"],["に"],["降伏","こうふく"],["します"],["。"],["あなた"],["がた"],["の"],["よい"],["と"],["思う","おもう"],["よう"],["に"],["私たち","わたしたち"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":11,"text":"翌日、サウルは民を三組に分け、夜明けの見張りの時、陣営に突入し、昼までアモン人を打った。残された者もいたが、散って行って、ふたりの者が共に残ることはなかった。","tok":[["翌日","よくじつ"],["、"],["サウル"],["は"],["民","みん"],["を"],["三","さん"],["組","くみ"],["に"],["分け","わけ"],["、"],["夜明け","よあけ"],["の"],["見張り","みはり"],["の"],["時","とき"],["、"],["陣営","じんえい"],["に"],["突入","とつにゅう"],["し"],["、"],["昼","ひる"],["まで"],["アモン人","あもんにん"],["を"],["打った","うった"],["。"],["残された","のこされた"],["者","もの"],["も"],["いた"],["が"],["、"],["散って","ちって"],["行って","いって"],["、"],["ふたり"],["の"],["者","もの"],["が"],["共","とも"],["に"],["残る","のこる"],["こと"],["は"],["なかった"],["。"]]},{"verse":12,"text":"そのとき、民はサムエルに言った。「サウルがわれわれを治めるのか、などと言ったのはだれでしたか。その者たちを引き渡してください。彼らを殺します。」","tok":[["その"],["とき"],["、"],["民","みん"],["は"],["サムエル"],["に"],["言った","いった"],["。"],["「"],["サウル"],["が"],["われわれ"],["を"],["治める","おさめる"],["の"],["か"],["、"],["など"],["と"],["言った","いった"],["の"],["は"],["だれ"],["でした"],["か"],["。"],["その"],["者","もの"],["たち"],["を"],["引き渡して","ひきわたして"],["ください"],["。"],["彼","かれ"],["ら"],["を"],["殺します","ころします"],["。"],["」"]]},{"verse":13,"text":"しかしサウルは言った。「きょうは人を殺してはならない。きょう、主がイスラエルを救ってくださったのだから。」","tok":[["しかし"],["サウル"],["は"],["言った","いった"],["。"],["「"],["きょう"],["は"],["人","ひと"],["を"],["殺して","ころして"],["は"],["ならない"],["。"],["きょう"],["、"],["主","ぬし"],["が"],["イスラエル"],["を"],["救って","すくって"],["くださった"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":14,"text":"それからサムエルは民に言った。「さあ、われわれはギルガルへ行って、そこで王権を創設する宣言をしよう。」","tok":[["それ"],["から"],["サムエル"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["われわれ"],["は"],["ギルガル"],["へ"],["行って","いって"],["、"],["そこ"],["で"],["王権","おうけん"],["を"],["創設","そうせつ"],["する"],["宣言","せんげん"],["を"],["しよう"],["。"],["」"]]},{"verse":15,"text":"民はみなギルガルへ行き、ギルガルで、主の前に、サウルを王とした。彼らはそこで主の前に和解のいけにえをささげ、サウルとイスラエルのすべての者が、そこで大いに喜んだ。","tok":[["民","みん"],["は"],["みな"],["ギルガル"],["へ"],["行き","いき"],["、"],["ギルガル"],["で"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["、"],["サウル"],["を"],["王","おう"],["と"],["した"],["。"],["彼","かれ"],["ら"],["は"],["そこ"],["で"],["主","ぬし"],["の"],["前","まえ"],["に"],["和解","わかい"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["サウル"],["と"],["イスラエル"],["の"],["すべて"],["の"],["者","もの"],["が"],["、"],["そこ"],["で"],["大いに","おおいに"],["喜んだ","よろこんだ"],["。"]]}]
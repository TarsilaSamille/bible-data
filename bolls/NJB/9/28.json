[{"verse":1,"text":"そのころ、ペリシテ人はイスラエルと戦おうとして、軍隊を召集した。アキシュはダビデに言った。「あなたと、あなたの部下は、私といっしょに出陣することになっているのを、よく承知していてもらいたい。」","tok":[["その"],["ころ"],["、"],["ペリシテ"],["人","にん"],["は"],["イスラエル"],["と"],["戦おう","たたかおう"],["として"],["、"],["軍隊","ぐんたい"],["を"],["召集","しょうしゅう"],["した"],["。"],["アキシュ"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["と"],["、"],["あなた"],["の"],["部下","ぶか"],["は"],["、"],["私","わたくし"],["と"],["いっしょ"],["に"],["出陣","しゅつじん"],["する"],["こと"],["に"],["なって"],["いる"],["の"],["を"],["、"],["よく"],["承知","しょうち"],["して"],["いて"],["もらいたい"],["。"],["」"]]},{"verse":2,"text":"ダビデはアキシュに言った。「よろしゅうございます。このしもべが、どうするか、おわかりになるでしょう。」アキシュはダビデに言った。「よろしい。あなたをいつまでも、私の護衛に任命しておこう。」","tok":[["ダビデ"],["は"],["アキシュ"],["に"],["言った","いった"],["。"],["「"],["よろしゅう"],["ございます"],["。"],["この"],["しもべ"],["が"],["、"],["どう"],["する"],["か"],["、"],["おわかり"],["に"],["なるでしょう"],["。"],["」"],["アキシュ"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["よろしい"],["。"],["あなた"],["を"],["いつ"],["まで"],["も"],["、"],["私","わたくし"],["の"],["護衛","ごえい"],["に"],["任命","にんめい"],["して"],["おこう"],["。"],["」"]]},{"verse":3,"text":"サムエルが死んだとき、全イスラエルは彼のためにいたみ悲しみ、彼をその町ラマに葬った。サウルは国内から霊媒や口寄せを追い出していた。","tok":[["サムエル"],["が"],["死んだ","しんだ"],["とき"],["、"],["全","ぜん"],["イスラエル"],["は"],["彼","かれ"],["の"],["ため"],["に"],["いたみ悲しみ","いたみかなしみ"],["、"],["彼","かれ"],["を"],["その"],["町","まち"],["ラマ"],["に"],["葬った","ほうむった"],["。"],["サウル"],["は"],["国内","こくない"],["から"],["霊媒","れいばい"],["や"],["口寄せ","くちよせ"],["を"],["追い出して","おいだして"],["いた"],["。"]]},{"verse":4,"text":"ペリシテ人が集まって、シュネムに来て陣を敷いたので、サウルは全イスラエルを召集して、ギルボアに陣を敷いた。","tok":[["ペリシテ"],["人","にん"],["が"],["集まって","あつまって"],["、"],["シュネム"],["に"],["来て","きて"],["陣","じん"],["を"],["敷いた","しいた"],["ので"],["、"],["サウル"],["は"],["全","ぜん"],["イスラエル"],["を"],["召集","しょうしゅう"],["して"],["、"],["ギルボア"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"]]},{"verse":5,"text":"サウルはペリシテ人の陣営を見て恐れ、その心はひどくわなないた。","tok":[["サウル"],["は"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["を"],["見て","みて"],["恐れ","おそれ"],["、"],["その"],["心","こころ"],["は"],["ひどく"],["わなないた"],["。"]]},{"verse":6,"text":"それで、サウルは主に伺ったが、主が夢によっても、ウリムによっても、預言者によっても答えてくださらなかったので、","tok":[["それ"],["で"],["、"],["サウル"],["は"],["主に","おもに"],["伺った","うかがった"],["が"],["、"],["主","ぬし"],["が"],["夢","ゆめ"],["によって"],["も"],["、"],["ウリム"],["によって"],["も"],["、"],["預言者","よげんしゃ"],["によって"],["も"],["答えて","こたえて"],["くださらなかった"],["ので"],["、"]]},{"verse":7,"text":"サウルは自分の家来たちに言った。「霊媒をする女を捜して来い。私がその女のところに行って、その女に尋ねてみよう。」家来たちはサウルに言った。「エン・ドルに霊媒をする女がいます。」","tok":[["サウル"],["は"],["自分","じぶん"],["の"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["霊媒","れいばい"],["を"],["する"],["女","おんな"],["を"],["捜して","さがして"],["来い","こい"],["。"],["私","わたくし"],["が"],["その"],["女","おんな"],["の"],["ところ"],["に"],["行って","いって"],["、"],["その"],["女","おんな"],["に"],["尋ねて","たずねて"],["みよう"],["。"],["」"],["家来","けらい"],["たち"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["エン"],["・"],["ドル"],["に"],["霊媒","れいばい"],["を"],["する"],["女","おんな"],["が"],["います"],["。"],["」"]]},{"verse":8,"text":"サウルは、変装して身なりを変え、ふたりの部下を連れて、夜、その女のところに行き、そして言った。「霊媒によって、私のために占い、私の名ざす人を呼び出してもらいたい。」","tok":[["サウル"],["は"],["、"],["変装","へんそう"],["して"],["身なり","みなり"],["を"],["変え","かえ"],["、"],["ふたり"],["の"],["部下","ぶか"],["を"],["連れて","つれて"],["、"],["夜","よる"],["、"],["その"],["女","おんな"],["の"],["ところ"],["に"],["行き","いき"],["、"],["そして"],["言った","いった"],["。"],["「"],["霊媒","れいばい"],["によって"],["、"],["私","わたくし"],["の"],["ため"],["に"],["占い","うらない"],["、"],["私","わたくし"],["の"],["名","な"],["ざす"],["人","ひと"],["を"],["呼び出して","よびだして"],["もらいたい"],["。"],["」"]]},{"verse":9,"text":"すると、この女は彼に言った。「あなたは、サウルがこの国から霊媒や口寄せを断ち滅ぼされたことをご存じのはずです。それなのに、なぜ、私のいのちにわなをかけて、私を殺そうとするのですか。」","tok":[["する"],["と"],["、"],["この"],["女","おんな"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["サウル"],["が"],["この"],["国","くに"],["から"],["霊媒","れいばい"],["や"],["口寄せ","くちよせ"],["を"],["断ち","たち"],["滅ぼされた","ほろぼされた"],["こと"],["を"],["ご存じ","ごぞんじ"],["の"],["はず"],["です"],["。"],["それ"],["な"],["のに"],["、"],["なぜ"],["、"],["私","わたくし"],["の"],["いのち"],["に"],["わな"],["を"],["かけて"],["、"],["私","わたくし"],["を"],["殺そう","ころそう"],["と"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":10,"text":"サウルは主にかけて彼女に誓って言った。「主は生きておられる。このことにより、あなたが咎を負うことは決してない。」","tok":[["サウル"],["は"],["主","ぬし"],["に"],["かけて"],["彼女","かのじょ"],["に"],["誓って","ちかって"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["この"],["こと"],["に"],["より"],["、"],["あなた"],["が"],["咎","とが"],["を"],["負う","おう"],["こと"],["は"],["決して","けっして"],["ない"],["。"],["」"]]},{"verse":11,"text":"すると、女は言った。「だれを呼び出しましょうか。」サウルは言った。「サムエルを呼び出してもらいたい。」","tok":[["する"],["と"],["、"],["女","おんな"],["は"],["言った","いった"],["。"],["「"],["だれ"],["を"],["呼び出しましょう","よびだしましょう"],["か"],["。"],["」"],["サウル"],["は"],["言った","いった"],["。"],["「"],["サムエル"],["を"],["呼び出して","よびだして"],["もらいたい"],["。"],["」"]]},{"verse":12,"text":"この女がサムエルを見たとき、大声で叫んだ。そしてこの女はサウルに次のように言った。「あなたはなぜ、私を欺いたのですか。あなたはサウルではありませんか。」","tok":[["この"],["女","おんな"],["が"],["サムエル"],["を"],["見た","みた"],["とき"],["、"],["大声","おおごえ"],["で"],["叫んだ","さけんだ"],["。"],["そして"],["この"],["女","おんな"],["は"],["サウル"],["に"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["なぜ"],["、"],["私","わたくし"],["を"],["欺いた","あざむいた"],["の"],["です"],["か"],["。"],["あなた"],["は"],["サウル"],["で"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":13,"text":"王は彼女に言った。「恐れることはない。何が見えるのか。」この女はサウルに言った。「こうごうしい方が地から上って来られるのが見えます。」","tok":[["王","おう"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["何","なん"],["が"],["見える","みえる"],["の"],["か"],["。"],["」"],["この"],["女","おんな"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["こうごうしい"],["方","ほう"],["が"],["地","ち"],["から"],["上って","のぼって"],["来られる","こられる"],["の"],["が"],["見えます","みえます"],["。"],["」"]]},{"verse":14,"text":"サウルは彼女に尋ねた。「どんな様子をしておられるか。」彼女は言った。「年老いた方が上って来られます。外套を着ておられます。」サウルは、その人がサムエルであることがわかって、地にひれ伏して、おじぎをした。","tok":[["サウル"],["は"],["彼女","かのじょ"],["に"],["尋ねた","たずねた"],["。"],["「"],["どんな"],["様子","ようす"],["を"],["して"],["おられる"],["か"],["。"],["」"],["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["年老いた","としおいた"],["方","ほう"],["が"],["上って","のぼって"],["来られます","こられます"],["。"],["外套","がいとう"],["を"],["着て","きて"],["おられます"],["。"],["」"],["サウル"],["は"],["、"],["その"],["人","ひと"],["が"],["サムエル"],["で"],["ある"],["こと"],["が"],["わかって"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["、"],["おじぎ"],["を"],["した"],["。"]]},{"verse":15,"text":"サムエルはサウルに言った。「なぜ、私を呼び出して、私を煩わすのか。」サウルは言った。「私は困りきっています。ペリシテ人が私を攻めて来るのに、神は私から去っておられます。預言者によっても、夢によっても、もう私に答えてくださらないのです。それで私がどうすればよいか教えていただくために、あなたをお呼びしました。」","tok":[["サムエル"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["私","わたくし"],["を"],["呼び出して","よびだして"],["、"],["私","わたくし"],["を"],["煩わす","わずらわす"],["の"],["か"],["。"],["」"],["サウル"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["困り","こまり"],["きって"],["います"],["。"],["ペリシテ"],["人","にん"],["が"],["私","わたくし"],["を"],["攻めて","せめて"],["来る","くる"],["のに"],["、"],["神","かみ"],["は"],["私","わたくし"],["から"],["去って","さって"],["おられます"],["。"],["預言者","よげんしゃ"],["によって"],["も"],["、"],["夢","ゆめ"],["によって"],["も"],["、"],["もう"],["私","わたくし"],["に"],["答えて","こたえて"],["くださらない"],["の"],["です"],["。"],["それ"],["で"],["私","わたくし"],["が"],["どう"],["すれば"],["よい"],["か"],["教えて","おしえて"],["いただく"],["ため"],["に"],["、"],["あなた"],["を"],["お"],["呼び","よび"],["しました"],["。"],["」"]]},{"verse":16,"text":"サムエルは言った。「なぜ、私に尋ねるのか。主はあなたから去り、あなたの敵になられたのに。","tok":[["サムエル"],["は"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["私","わたくし"],["に"],["尋ねる","たずねる"],["の"],["か"],["。"],["主","ぬし"],["は"],["あなた"],["から"],["去り","さり"],["、"],["あなた"],["の"],["敵","てき"],["に"],["なられた"],["のに"],["。"]]},{"verse":17,"text":"主は、私を通して告げられたとおりのことをなさったのだ。主は、あなたの手から王位をはぎ取って、あなたの友ダビデに与えられた。","tok":[["主","ぬし"],["は"],["、"],["私","わたくし"],["を"],["通して","とおして"],["告げられた","つげられた"],["とおり"],["の"],["こと"],["を"],["なさった"],["の"],["だ"],["。"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["手","て"],["から"],["王位","おうい"],["を"],["はぎ取って","はぎとって"],["、"],["あなた"],["の"],["友","とも"],["ダビデ"],["に"],["与えられた","あたえられた"],["。"]]},{"verse":18,"text":"あなたは主の御声に聞き従わず、燃える御怒りをもってアマレクを罰しなかったからだ。それゆえ、主はきょう、このことをあなたにされたのだ。","tok":[["あなた"],["は"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["燃える","もえる"],["御怒り","おいかり"],["を"],["もって"],["アマレク"],["を"],["罰しなかった","ばっしなかった"],["から"],["だ"],["。"],["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["きょう"],["、"],["この"],["こと"],["を"],["あなた"],["に"],["された"],["の"],["だ"],["。"]]},{"verse":19,"text":"主は、あなたといっしょにイスラエルをペリシテ人の手に渡される。あす、あなたも、あなたの息子たちも私といっしょになろう。そして主は、イスラエルの陣営をペリシテ人の手に渡される。」","tok":[["主","ぬし"],["は"],["、"],["あなた"],["と"],["いっしょ"],["に"],["イスラエル"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["に"],["渡される","わたされる"],["。"],["あす"],["、"],["あなた"],["も"],["、"],["あなた"],["の"],["息子","むすこ"],["たち"],["も"],["私","わたくし"],["と"],["いっしょ"],["に"],["なろう"],["。"],["そして"],["主","ぬし"],["は"],["、"],["イスラエル"],["の"],["陣営","じんえい"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["に"],["渡される","わたされる"],["。"],["」"]]},{"verse":20,"text":"すると、サウルは突然、倒れて地上に棒のようになった。サムエルのことばを非常に恐れたからである。それに、その日、一昼夜、何の食事もしていなかったので、彼の力がうせていたからである。","tok":[["する"],["と"],["、"],["サウル"],["は"],["突然","とつぜん"],["、"],["倒れて","たおれて"],["地上","ちじょう"],["に"],["棒","ぼう"],["の"],["よう"],["に"],["なった"],["。"],["サムエル"],["の"],["ことば"],["を"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["から"],["で"],["ある"],["。"],["それ"],["に"],["、"],["その"],["日","ひ"],["、"],["一昼夜","いっちゅうや"],["、"],["何","なん"],["の"],["食事","しょくじ"],["も"],["して"],["いなかった"],["ので"],["、"],["彼","かれ"],["の"],["力","ちから"],["が"],["うせて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"女はサウルのところに来て、サウルが非常におびえているのを見て彼に言った。「あなたのはしためは、あなたの言われたことに聞き従いました。私は自分のいのちをかけて、あなたが言われた命令に従いました。","tok":[["女","おんな"],["は"],["サウル"],["の"],["ところ"],["に"],["来て","きて"],["、"],["サウル"],["が"],["非常","ひじょう"],["に"],["おびえて"],["いる"],["の"],["を"],["見て","みて"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["はし"],["ため"],["は"],["、"],["あなた"],["の"],["言われた","いわれた"],["こと"],["に"],["聞き従いました","ききしたがいました"],["。"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["いのち"],["を"],["かけて"],["、"],["あなた"],["が"],["言われた","いわれた"],["命令","めいれい"],["に"],["従いました","したがいました"],["。"]]},{"verse":22,"text":"今度はどうか、あなたがこのはしための言うことを聞き入れてください。パンを少し差し上げますから、それを食べてください。お帰りのとき、元気になられるでしょう。」","tok":[["今度","こんど"],["は"],["どう"],["か"],["、"],["あなた"],["が"],["この"],["はし"],["ため"],["の"],["言う","いう"],["こと"],["を"],["聞き入れて","ききいれて"],["ください"],["。"],["パン"],["を"],["少し","すこし"],["差し上げます","さしあげます"],["から"],["、"],["それ"],["を"],["食べて","たべて"],["ください"],["。"],["お帰り","おかえり"],["の"],["とき"],["、"],["元気","げんき"],["に"],["なられるでしょう"],["。"],["」"]]},{"verse":23,"text":"サウルは、これを断って、「食べたくない」と言った。しかし、彼の家来とこの女がしきりに勧めたので、サウルはその言うことを聞き入れて地面から立ち上がり、床の上にすわった。","tok":[["サウル"],["は"],["、"],["これ"],["を"],["断って","ことわって"],["、"],["「"],["食べたく","たべたく"],["ない"],["」"],["と"],["言った","いった"],["。"],["しかし"],["、"],["彼","かれ"],["の"],["家来","けらい"],["と"],["この"],["女","おんな"],["が"],["しきり"],["に"],["勧めた","すすめた"],["ので"],["、"],["サウル"],["は"],["その"],["言う","いう"],["こと"],["を"],["聞き入れて","ききいれて"],["地面","じめん"],["から"],["立ち上がり","たちあがり"],["、"],["床","ゆか"],["の"],["上","うえ"],["に"],["すわった"],["。"]]},{"verse":24,"text":"この女の家に肥えた子牛がいたので、急いでそれをほふり、また、小麦粉を取って練り、種を入れないパンを焼いた。","tok":[["この"],["女","おんな"],["の"],["家","いえ"],["に"],["肥えた","こえた"],["子牛","こうし"],["が"],["いた"],["ので"],["、"],["急いで","いそいで"],["それ"],["を"],["ほふり"],["、"],["また"],["、"],["小麦粉","こむぎこ"],["を"],["取って","とって"],["練り","ねり"],["、"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["を"],["焼いた","やいた"],["。"]]},{"verse":25,"text":"それをサウルとその家来たちの前に差し出すと、彼らはそれを食べた。その夜、彼らは立ち去った。","tok":[["それ"],["を"],["サウル"],["と"],["その"],["家来","けらい"],["たち"],["の"],["前","まえ"],["に"],["差し出す","さしだす"],["と"],["、"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["食べた","たべた"],["。"],["その"],["夜","よる"],["、"],["彼","かれ"],["ら"],["は"],["立ち去った","たちさった"],["。"]]}]
[{"verse":1,"text":"ジフ人がギブアにいるサウルのところに来て言った。「ダビデはエシモンの東にあるハキラの丘に隠れているではありませんか。」","tok":[["ジフ人","じふにん"],["が"],["ギブア"],["に"],["いる"],["サウル"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["ダビデ"],["は"],["エシモン"],["の"],["東","ひがし"],["に"],["ある"],["ハキラ"],["の"],["丘","おか"],["に"],["隠れて","かくれて"],["いるで"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":2,"text":"そこでサウルはすぐ、三千人のイスラエルの精鋭を率い、ジフの荒野にいるダビデを求めてジフの荒野へ下って行った。","tok":[["そこ"],["で"],["サウル"],["は"],["すぐ"],["、"],["三千人","さんせんにん"],["の"],["イスラエル"],["の"],["精鋭","せいえい"],["を"],["率い","ひきい"],["、"],["ジフ"],["の"],["荒野","あらの"],["に"],["いる"],["ダビデ"],["を"],["求めて","もとめて"],["ジフ"],["の"],["荒野","あらの"],["へ"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":3,"text":"サウルは、エシモンの東にあるハキラの丘で、道のかたわらに陣を敷いた。一方、ダビデは荒野にとどまっていた。ダビデはサウルが自分を追って荒野に来たのを見たので、","tok":[["サウル"],["は"],["、"],["エシモン"],["の"],["東","ひがし"],["に"],["ある"],["ハキラ"],["の"],["丘","おか"],["で"],["、"],["道","みち"],["の"],["かたわら"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["一方","いっぽう"],["、"],["ダビデ"],["は"],["荒野","こうや"],["に"],["とどまって"],["いた"],["。"],["ダビデ"],["は"],["サウル"],["が"],["自分","じぶん"],["を"],["追って","おって"],["荒野","こうや"],["に"],["来た","きた"],["の"],["を"],["見た","みた"],["ので"],["、"]]},{"verse":4,"text":"斥候を送り、サウルが確かに来たことを知った。","tok":[["斥候","せっこう"],["を"],["送り","おくり"],["、"],["サウル"],["が"],["確か","たしか"],["に"],["来た","きた"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":5,"text":"ダビデは、サウルが陣を敷いている場所へ出て行き、サウルと、その将軍ネルの子アブネルとが寝ている場所を見つけた。サウルは幕営の中で寝ており、兵士たちは、その回りに宿営していた。","tok":[["ダビデ"],["は"],["、"],["サウル"],["が"],["陣","じん"],["を"],["敷いて","しいて"],["いる"],["場所","ばしょ"],["へ"],["出て","でて"],["行き","いき"],["、"],["サウル"],["と"],["、"],["その"],["将軍","しょうぐん"],["ネル"],["の"],["子","こ"],["アブネル"],["と"],["が"],["寝て","ねて"],["いる"],["場所","ばしょ"],["を"],["見つけた","みつけた"],["。"],["サウル"],["は"],["幕営","ばくえい"],["の"],["中","なか"],["で"],["寝て","ねて"],["おり"],["、"],["兵士","へいし"],["たち"],["は"],["、"],["その"],["回り","まわり"],["に"],["宿営","しゅくえい"],["して"],["いた"],["。"]]},{"verse":6,"text":"そこで、ダビデは、ヘテ人アヒメレクと、ヨアブの兄弟で、ツェルヤの子アビシャイとに言った。「だれか私といっしょに陣営のサウルのところへ下って行く者はいないか。」するとアビシャイが答えた。「私があなたといっしょに下って行きます。」","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["、"],["ヘテ人","へてにん"],["アヒメレク"],["と"],["、"],["ヨアブ"],["の"],["兄弟","きょうだい"],["で"],["、"],["ツェルヤ"],["の"],["子","こ"],["アビシャイ"],["と"],["に"],["言った","いった"],["。"],["「"],["だれ"],["か"],["私","わたくし"],["と"],["いっしょ"],["に"],["陣営","じんえい"],["の"],["サウル"],["の"],["ところ"],["へ"],["下って","くだって"],["行く","いく"],["者","もの"],["は"],["いない"],["か"],["。"],["」"],["する"],["と"],["アビシャイ"],["が"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["が"],["あなた"],["と"],["いっしょ"],["に"],["下って","くだって"],["行きます","いきます"],["。"],["」"]]},{"verse":7,"text":"ダビデとアビシャイは夜、民のところに行った。見ると、サウルは幕営の中で横になって寝ており、彼の槍が、その枕もとの地面に突き刺してあった。アブネルも兵士たちも、その回りに眠っていた。","tok":[["ダビデ"],["と"],["アビシャイ"],["は"],["夜","よる"],["、"],["民","みん"],["の"],["ところ"],["に"],["行った","いった"],["。"],["見る","みる"],["と"],["、"],["サウル"],["は"],["幕営","ばくえい"],["の"],["中","なか"],["で"],["横","よこ"],["に"],["なって"],["寝て","ねて"],["おり"],["、"],["彼","かれ"],["の"],["槍","やり"],["が"],["、"],["その"],["枕もと","まくらもと"],["の"],["地面","じめん"],["に"],["突き刺して","つきさして"],["あった"],["。"],["アブネル"],["も"],["兵士","へいし"],["たち"],["も"],["、"],["その"],["回り","まわり"],["に"],["眠って","ねむって"],["いた"],["。"]]},{"verse":8,"text":"アビシャイはダビデに言った。「神はきょう、あなたの敵をあなたの手に渡されました。どうぞ私に、あの槍で彼を一気に地に刺し殺させてください。二度することはいりません。」","tok":[["アビシャイ"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["は"],["きょう"],["、"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["手","て"],["に"],["渡されました","わたされました"],["。"],["どうぞ"],["私","わたくし"],["に"],["、"],["あの"],["槍","やり"],["で"],["彼","かれ"],["を"],["一気","いっき"],["に"],["地","ち"],["に"],["刺し殺させて","さしころさせて"],["ください"],["。"],["二","に"],["度","ど"],["する"],["こと"],["はいりません"],["。"],["」"]]},{"verse":9,"text":"しかしダビデはアビシャイに言った。「殺してはならない。主に油そそがれた方に手を下して、だれが無罪でおられよう。」","tok":[["しかし"],["ダビデ"],["は"],["アビシャイ"],["に"],["言った","いった"],["。"],["「"],["殺して","ころして"],["は"],["ならない"],["。"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","ほう"],["に"],["手","て"],["を"],["下して","くだして"],["、"],["だれ"],["が"],["無罪","むざい"],["で"],["おられよう"],["。"],["」"]]},{"verse":10,"text":"ダビデは言った。「主は生きておられる。主は、必ず彼を打たれる。彼はその生涯の終わりに死ぬか、戦いに下ったときに滅ぼされるかだ。","tok":[["ダビデ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["主","ぬし"],["は"],["、"],["必ず","かならず"],["彼","かれ"],["を"],["打たれる","うたれる"],["。"],["彼","かれ"],["は"],["その"],["生涯","しょうがい"],["の"],["終わり","おわり"],["に"],["死ぬ","しぬ"],["か"],["、"],["戦い","たたかい"],["に"],["下った","くだった"],["とき"],["に"],["滅ぼされる","ほろぼされる"],["か"],["だ"],["。"]]},{"verse":11,"text":"私が、主に油そそがれた方に手を下すなど、主の前に絶対にできないことだ。さあ、今は、あの枕もとにある槍と水差しとを取って行くことにしよう。」","tok":[["私","わたくし"],["が"],["、"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","ほう"],["に"],["手","て"],["を"],["下す","くだす"],["など"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["絶対","ぜったい"],["に"],["できない"],["こと"],["だ"],["。"],["さあ"],["、"],["今","いま"],["は"],["、"],["あの"],["枕もと","まくらもと"],["に"],["ある"],["槍","やり"],["と"],["水差し","みずさし"],["と"],["を"],["取って","とって"],["行く","いく"],["こと"],["に"],["しよう"],["。"],["」"]]},{"verse":12,"text":"こうしてダビデはサウルの枕もとの槍と水差しとを取り、ふたりは立ち去ったが、だれひとりとしてこれを見た者も、気づいた者も、目をさました者もなかった。主が彼らを深い眠りに陥れられたので、みな眠りこけていたからである。","tok":[["こう"],["して"],["ダビデ"],["は"],["サウル"],["の"],["枕もと","まくらもと"],["の"],["槍","やり"],["と"],["水差し","みずさし"],["と"],["を"],["取り","とり"],["、"],["ふたり"],["は"],["立ち去った","たちさった"],["が"],["、"],["だれ"],["ひとり"],["として"],["これ"],["を"],["見た","みた"],["者","もの"],["も"],["、"],["気づいた","きづいた"],["者","もの"],["も"],["、"],["目","め"],["を"],["さました"],["者","もの"],["も"],["なかった"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["深い","ふかい"],["眠り","ねむり"],["に"],["陥れられた","おとしいれられた"],["ので"],["、"],["みな"],["眠りこけて","ねむりこけて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"ダビデは向こう側へ渡って行き、遠く離れた山の頂上に立った。彼らの間には、かなりの隔たりがあった。","tok":[["ダビデ"],["は"],["向こう側","むこうがわ"],["へ"],["渡って","わたって"],["行き","いき"],["、"],["遠く","とおく"],["離れた","はなれた"],["山","やま"],["の"],["頂上","ちょうじょう"],["に"],["立った","たった"],["。"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["は"],["、"],["かなり"],["の"],["隔たり","へだたり"],["が"],["あった"],["。"]]},{"verse":14,"text":"そしてダビデは、兵士たちとネルの子アブネルに呼びかけて言った。「アブネル。返事をしろ。」アブネルは答えて言った。「王を呼びつけるおまえはだれだ。」","tok":[["そして"],["ダビデ"],["は"],["、"],["兵士","へいし"],["たち"],["と"],["ネル"],["の"],["子","こ"],["アブネル"],["に"],["呼びかけて","よびかけて"],["言った","いった"],["。"],["「"],["アブネル"],["。"],["返事","へんじ"],["を"],["しろ"],["。"],["」"],["アブネル"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["王","おう"],["を"],["呼びつける","よびつける"],["おまえ"],["は"],["だれ"],["だ"],["。"],["」"]]},{"verse":15,"text":"ダビデはアブネルに言った。「おまえは男ではないか。イスラエル中で、おまえに並ぶ者があろうか。おまえはなぜ、自分の主君である王を見張っていなかったのだ。兵士のひとりが、おまえの主君である王を殺しに入り込んだのに。","tok":[["ダビデ"],["は"],["アブネル"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["は"],["男","おとこ"],["で"],["は"],["ない"],["か"],["。"],["イスラエル"],["中","ちゅう"],["で"],["、"],["おまえ"],["に"],["並ぶ","ならぶ"],["者","もの"],["が"],["あろう"],["か"],["。"],["おまえ"],["は"],["なぜ"],["、"],["自分","じぶん"],["の"],["主君","しゅくん"],["で"],["ある"],["王","おう"],["を"],["見張って","みはって"],["いなかった"],["の"],["だ"],["。"],["兵士","へいし"],["の"],["ひとり"],["が"],["、"],["おまえ"],["の"],["主君","しゅくん"],["で"],["ある"],["王","おう"],["を"],["殺し","ころし"],["に"],["入り込んだ","はいりこんだ"],["のに"],["。"]]},{"verse":16,"text":"おまえのやったことは良くない。主に誓って言うが、おまえたちは死に値する。おまえたちの主君、主に油そそがれた方を見張っていなかったからだ。今、王の枕もとにあった王の槍と水差しが、どこにあるか見てみよ。」","tok":[["おまえ"],["の"],["やった"],["こと"],["は"],["良く","よく"],["ない"],["。"],["主に","おもに"],["誓って","ちかって"],["言う","ゆう"],["が"],["、"],["おまえ"],["たち"],["は"],["死に","しに"],["値","あたい"],["する"],["。"],["おまえ"],["たち"],["の"],["主君","しゅくん"],["、"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","ほう"],["を"],["見張って","みはって"],["いなかった"],["から"],["だ"],["。"],["今","いま"],["、"],["王","おう"],["の"],["枕もと","まくらもと"],["に"],["あった"],["王","おう"],["の"],["槍","やり"],["と"],["水差し","みずさし"],["が"],["、"],["どこ"],["に"],["ある"],["か"],["見て","みて"],["み"],["よ"],["。"],["」"]]},{"verse":17,"text":"サウルは、それがダビデの声だとわかって言った。「わが子ダビデよ。これはおまえの声ではないか。」ダビデは答えた。「私の声です。王さま。」","tok":[["サウル"],["は"],["、"],["それ"],["が"],["ダビデ"],["の"],["声","こえ"],["だ"],["と"],["わかって"],["言った","いった"],["。"],["「"],["わが"],["子","こ"],["ダビデ"],["よ"],["。"],["これ"],["は"],["おまえ"],["の"],["声","こえ"],["で"],["は"],["ない"],["か"],["。"],["」"],["ダビデ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["の"],["声","こえ"],["です"],["。"],["王","おう"],["さま"],["。"],["」"]]},{"verse":18,"text":"そして言った。「なぜ、わが君はこのしもべのあとを追われるのですか。私が何をしたというのですか。私の手に、どんな悪があるというのですか。","tok":[["そして"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["わが"],["君","きみ"],["は"],["この"],["しもべ"],["の"],["あと"],["を"],["追われる","おわれる"],["の"],["です"],["か"],["。"],["私","わたくし"],["が"],["何","なん"],["を"],["した"],["と"],["いう"],["の"],["です"],["か"],["。"],["私","わたくし"],["の"],["手","て"],["に"],["、"],["どんな"],["悪","あく"],["が"],["ある"],["と"],["いう"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"王さま。どうか今、このしもべの言うことを聞いてください。もし私にはむかうようにあなたに誘いかけられたのが主であれば、主はあなたのささげ物を受け入れられるでしょう。しかし、それが人によるのであれば、主の前で彼らがのろわれますように。彼らはきょう、私を追い払って、主のゆずりの地にあずからせず、行ってほかの神々に仕えよ、と言っているからです。","tok":[["王","おう"],["さま"],["。"],["どう"],["か"],["今","いま"],["、"],["この"],["しもべ"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["ください"],["。"],["もし"],["私","わたくし"],["に"],["はむかう"],["よう"],["に"],["あなた"],["に"],["誘いかけられた","さそいかけられた"],["の"],["が"],["主","ぬし"],["で"],["あれば"],["、"],["主","ぬし"],["は"],["あなた"],["の"],["ささげ物","ささげもの"],["を"],["受け入れられるでしょう","うけいれられるでしょう"],["。"],["しかし"],["、"],["それ"],["が"],["人","ひと"],["に"],["よる"],["ので"],["あれば"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["彼","かれ"],["ら"],["が"],["のろわれます"],["よう"],["に"],["。"],["彼","かれ"],["ら"],["は"],["きょう"],["、"],["私","わたくし"],["を"],["追い払って","おいはらって"],["、"],["主","ぬし"],["の"],["ゆずり"],["の"],["地","ち"],["に"],["あずからせず"],["、"],["行って","いって"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えよ","つかえよ"],["、"],["と"],["言って","いって"],["いる"],["から"],["です"],["。"]]},{"verse":20,"text":"どうか今、私が主の前から去って、この血を地面に流すことがありませんように。イスラエルの王が、山で、しゃこを追うように、一匹の蚤をねらって出て来られたからです。」","tok":[["どう"],["か"],["今","いま"],["、"],["私","わたくし"],["が"],["主","ぬし"],["の"],["前","まえ"],["から"],["去って","さって"],["、"],["この"],["血","ち"],["を"],["地面","じめん"],["に"],["流す","ながす"],["こと"],["が"],["ありません"],["よう"],["に"],["。"],["イスラエル"],["の"],["王","おう"],["が"],["、"],["山","やま"],["で"],["、"],["しゃこ"],["を"],["追う","おう"],["よう"],["に"],["、"],["一匹","いちひき"],["の"],["蚤","のみ"],["を"],["ねらって"],["出て","でて"],["来られた","こられた"],["から"],["です"],["。"],["」"]]},{"verse":21,"text":"サウルは言った。「私は罪を犯した。わが子ダビデ。帰って来なさい。私はもう、おまえに害を加えない。きょう、私のいのちがおまえによって助けられたからだ。ほんとうに私は愚かなことをして、たいへんなまちがいを犯した。」","tok":[["サウル"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["わが"],["子","こ"],["ダビデ"],["。"],["帰って","かえって"],["来","き"],["なさい"],["。"],["私","わたくし"],["は"],["もう"],["、"],["おまえ"],["に"],["害","がい"],["を"],["加えない","くわえない"],["。"],["きょう"],["、"],["私","わたくし"],["の"],["いのち"],["が"],["おまえ"],["によって"],["助けられた","たすけられた"],["から"],["だ"],["。"],["ほんとう"],["に"],["私","わたくし"],["は"],["愚か","おろか"],["な"],["こと"],["を"],["して"],["、"],["たいへん"],["な"],["まちがい"],["を"],["犯した","おかした"],["。"],["」"]]},{"verse":22,"text":"ダビデは答えて言った。「さあ、ここに王の槍があります。これを取りに、若者のひとりをよこしてください。","tok":[["ダビデ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["さあ"],["、"],["ここ"],["に"],["王","おう"],["の"],["槍","やり"],["が"],["あります"],["。"],["これ"],["を"],["取り","とり"],["に"],["、"],["若者","わかもの"],["の"],["ひとり"],["を"],["よこして"],["ください"],["。"]]},{"verse":23,"text":"主は、おのおの、その人の正しさと真実に報いてくださいます。主はきょう、あなたを私の手に渡されましたが、私は、主に油そそがれた方に、この手を下したくはありませんでした。","tok":[["主","ぬし"],["は"],["、"],["おのおの"],["、"],["その"],["人","ひと"],["の"],["正し","ただし"],["さ"],["と"],["真実","しんじつ"],["に"],["報いて","むくいて"],["くださいます"],["。"],["主","ぬし"],["は"],["きょう"],["、"],["あなた"],["を"],["私","わたくし"],["の"],["手","て"],["に"],["渡されました","わたされました"],["が"],["、"],["私","わたくし"],["は"],["、"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","ほう"],["に"],["、"],["この"],["手","て"],["を"],["下したく","くだしたく"],["は"],["ありませんでした"],["。"]]},{"verse":24,"text":"きょう、私があなたのいのちをたいせつにしたように、主は私のいのちをたいせつにして、すべての苦しみから私を救い出してくださいます。」","tok":[["きょう"],["、"],["私","わたくし"],["が"],["あなた"],["の"],["いのち"],["を"],["たいせつ"],["に"],["した"],["よう"],["に"],["、"],["主","ぬし"],["は"],["私","わたくし"],["の"],["いのち"],["を"],["たいせつ"],["に"],["して"],["、"],["すべて"],["の"],["苦しみ","くるしみ"],["から"],["私","わたくし"],["を"],["救い出して","すくいだして"],["くださいます"],["。"],["」"]]},{"verse":25,"text":"サウルはダビデに言った。「わが子ダビデ。おまえに祝福があるように。おまえは多くのことをするだろうが、それはきっと成功しよう。」こうしてダビデは自分の旅を続け、サウルは自分の家へ帰って行った。","tok":[["サウル"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["わが"],["子","こ"],["ダビデ"],["。"],["おまえ"],["に"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["。"],["おまえ"],["は"],["多く","おおく"],["の"],["こと"],["を"],["するだろう"],["が"],["、"],["それ"],["は"],["きっと"],["成功",
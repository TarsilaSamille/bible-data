[{"verse":1,"text":"サウルがペリシテ人討伐から帰って来たとき、ダビデが今、エン・ゲディの荒野にいるということが知らされた。","tok":[["サウル"],["が"],["ペリシテ"],["人","にん"],["討伐","とうばつ"],["から"],["帰って","かえって"],["来た","きた"],["とき"],["、"],["ダビデ"],["が"],["今","いま"],["、"],["エン・ゲディ"],["の"],["荒野","あらの"],["に"],["いる"],["と"],["いう"],["こと"],["が"],["知らされた","しらされた"],["。"]]},{"verse":2,"text":"そこでサウルは、イスラエル全体から三千人の精鋭をえり抜いて、エエリムの岩の東に、ダビデとその部下を捜しに出かけた。","tok":[["そこ"],["で"],["サウル"],["は"],["、"],["イスラエル"],["全体","ぜんたい"],["から"],["三千人","さんせんにん"],["の"],["精鋭","せいえい"],["を"],["えり抜いて","えりぬいて"],["、"],["エエリム"],["の"],["岩","いわ"],["の"],["東","ひがし"],["に"],["、"],["ダビデ"],["と"],["その"],["部下","ぶか"],["を"],["捜し","さがし"],["に"],["出かけた","でかけた"],["。"]]},{"verse":3,"text":"彼が、道ばたの羊の群れの囲い場に来たとき、そこにほら穴があったので、サウルは用をたすためにその中に入った。そのとき、ダビデとその部下は、そのほら穴の奥のほうにすわっていた。","tok":[["彼","かれ"],["が"],["、"],["道ばた","みちばた"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["囲い場","かこいば"],["に"],["来た","きた"],["とき"],["、"],["そこ"],["に"],["ほら穴","ほらあな"],["が"],["あった"],["ので"],["、"],["サウル"],["は"],["用","よう"],["を"],["たす"],["ため"],["に"],["その"],["中","なか"],["に"],["入った","はいった"],["。"],["その"],["とき"],["、"],["ダビデ"],["と"],["その"],["部下","ぶか"],["は"],["、"],["その"],["ほら穴","ほらあな"],["の"],["奥","おく"],["の"],["ほう"],["に"],["すわって"],["いた"],["。"]]},{"verse":4,"text":"ダビデの部下はダビデに言った。「今こそ、主があなたに、『見よ。わたしはあなたの敵をあなたの手に渡す。彼をあなたのよいと思うようにせよ』と言われた、その時です。」そこでダビデは立ち上がり、サウルの上着のすそを、こっそり切り取った。","tok":[["ダビデ"],["の"],["部下","ぶか"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["今","いま"],["こそ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["、"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["を"],["あなた"],["の"],["よい"],["と"],["思う","おもう"],["よう"],["に"],["せよ"],["』"],["と"],["言われた","いわれた"],["、"],["その"],["時","とき"],["です"],["。"],["」"],["そこ"],["で"],["ダビデ"],["は"],["立ち上がり","たちあがり"],["、"],["サウル"],["の"],["上着","うわぎ"],["の"],["すそ"],["を"],["、"],["こっそり"],["切り取った","きりとった"],["。"]]},{"verse":5,"text":"こうして後、ダビデは、サウルの上着のすそを切り取ったことについて心を痛めた。","tok":[["こう"],["して"],["後","あと"],["、"],["ダビデ"],["は"],["、"],["サウル"],["の"],["上着","うわぎ"],["の"],["すそ"],["を"],["切り取った","きりとった"],["こと"],["について"],["心","こころ"],["を"],["痛めた","いためた"],["。"]]},{"verse":6,"text":"彼は部下に言った。「私が、主に逆らって、主に油そそがれた方、私の主君に対して、そのようなことをして、手を下すなど、主の前に絶対にできないことだ。彼は主に油そそがれた方だから。」","tok":[["彼","かれ"],["は"],["部下","ぶか"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["、"],["主に","おもに"],["逆らって","さからって"],["、"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","かた"],["、"],["私","わたくし"],["の"],["主君","しゅくん"],["に対して","にたいして"],["、"],["その"],["よう"],["な"],["こと"],["を"],["して"],["、"],["手","て"],["を"],["下す","くだす"],["など"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["絶対","ぜったい"],["に"],["できない"],["こと"],["だ"],["。"],["彼","かれ"],["は"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","ほう"],["だ"],["から"],["。"],["」"]]},{"verse":7,"text":"ダビデはこう言って部下を説き伏せ、彼らがサウルに襲いかかるのを許さなかった。サウルは、ほら穴から出て道を歩いて行った。","tok":[["ダビデ"],["は"],["こう"],["言って","いって"],["部下","ぶか"],["を"],["説き伏せ","ときふせ"],["、"],["彼","かれ"],["ら"],["が"],["サウル"],["に"],["襲いかかる","おそいかかる"],["の"],["を"],["許さなかった","ゆるさなかった"],["。"],["サウル"],["は"],["、"],["ほら穴","ほらあな"],["から"],["出て","でて"],["道","みち"],["を"],["歩いて","あるいて"],["行った","いった"],["。"]]},{"verse":8,"text":"その後、ダビデもほら穴から出て行き、サウルのうしろから呼びかけ、「王よ」と言った。サウルがうしろを振り向くと、ダビデは地にひれ伏して、礼をした。","tok":[["その"],["後","ご"],["、"],["ダビデ"],["も"],["ほら穴","ほらあな"],["から"],["出て","でて"],["行き","いき"],["、"],["サウル"],["の"],["うしろ"],["から"],["呼びかけ","よびかけ"],["、"],["「"],["王","おう"],["よ"],["」"],["と"],["言った","いった"],["。"],["サウル"],["が"],["うしろ"],["を"],["振り向く","ふりむく"],["と"],["、"],["ダビデ"],["は"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["、"],["礼","れい"],["を"],["した"],["。"]]},{"verse":9,"text":"そしてダビデはサウルに言った。「あなたはなぜ、『ダビデがあなたに害を加えようとしている』と言う人のうわさを信じられるのですか。","tok":[["そして"],["ダビデ"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["なぜ"],["、"],["『"],["ダビデ"],["が"],["あなた"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["として"],["いる"],["』"],["と"],["言う","いう"],["人","ひと"],["の"],["うわさ"],["を"],["信じられる","しんじられる"],["の"],["です"],["か"],["。"]]},{"verse":10,"text":"実はきょう、いましがた、主があのほら穴で私の手にあなたをお渡しになったのを、あなたはご覧になったのです。ある者はあなたを殺そうと言ったのですが、私は、あなたを思って、『私の主君に手を下すまい。あの方は主に油そそがれた方だから』と申しました。","tok":[["実","じつ"],["は"],["きょう"],["、"],["いましがた"],["、"],["主","ぬし"],["が"],["あの"],["ほら穴","ほらあな"],["で"],["私","わたくし"],["の"],["手","て"],["に"],["あなた"],["を"],["お渡し","おわたし"],["に"],["なった"],["の"],["を"],["、"],["あなた"],["は"],["ご覧","ごらん"],["に"],["なった"],["の"],["です"],["。"],["ある"],["者","もの"],["は"],["あなた"],["を"],["殺そう","ころそう"],["と"],["言った","いった"],["の"],["です"],["が"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["を"],["思って","おもって"],["、"],["『"],["私","わたくし"],["の"],["主君","しゅくん"],["に"],["手","て"],["を"],["下すまい","くだすまい"],["。"],["あの"],["方","かた"],["は"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","ほう"],["だ"],["から"],["』"],["と"],["申しました","もうしました"],["。"]]},{"verse":11,"text":"わが父よ。どうか、私の手にあるあなたの上着のすそをよくご覧ください。私はあなたの上着のすそを切り取りましたが、あなたを殺しはしませんでした。それによって私に悪いこともそむきの罪もないことを、確かに認めてください。私はあなたに罪を犯さなかったのに、あなたは私のいのちを取ろうとつけねらっておられます。","tok":[["わが"],["父","ちち"],["よ"],["。"],["どう"],["か"],["、"],["私","わたくし"],["の"],["手","て"],["に"],["ある"],["あなた"],["の"],["上着","うわぎ"],["の"],["すそ"],["を"],["よく"],["ご覧","ごらん"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["上着","うわぎ"],["の"],["すそ"],["を"],["切り取りました","きりとりました"],["が"],["、"],["あなた"],["を"],["殺し","ころし"],["は"],["しませんでした"],["。"],["それ"],["によって"],["私","わたくし"],["に"],["悪い","わるい"],["こと"],["も"],["そむき"],["の"],["罪","つみ"],["も"],["ない"],["こと"],["を"],["、"],["確か","たしか"],["に"],["認めて","みとめて"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["罪","つみ"],["を"],["犯さなかった","おかさなかった"],["のに"],["、"],["あなた"],["は"],["私","わたくし"],["の"],["いのち"],["を"],["取ろう","とろう"],["と"],["つけねらって"],["おられます"],["。"]]},{"verse":12,"text":"どうか、主が、私とあなたの間をさばき、主が私の仇を、あなたに報いられますように。私はあなたを手にかけることはしません。","tok":[["どう"],["か"],["、"],["主","ぬし"],["が"],["、"],["私","わたくし"],["と"],["あなた"],["の"],["間","あいだ"],["を"],["さばき"],["、"],["主","ぬし"],["が"],["私","わたくし"],["の"],["仇","あだ"],["を"],["、"],["あなた"],["に"],["報いられます","むくいられます"],["よう"],["に"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["手","て"],["に"],["かける"],["こと"],["は"],["しません"],["。"]]},{"verse":13,"text":"昔のことわざに、『悪は悪者から出る』と言っているので、私はあなたを手にかけることはしません。","tok":[["昔","むかし"],["の"],["ことわざ"],["に"],["、"],["『"],["悪","あく"],["は"],["悪者","わるもの"],["から"],["出る","でる"],["』"],["と"],["言って","いって"],["いる"],["ので"],["、"],["私","わたくし"],["は"],["あなた"],["を"],["手","て"],["に"],["かける"],["こと"],["は"],["しません"],["。"]]},{"verse":14,"text":"イスラエルの王はだれを追って出て来られたのですか。あなたはだれを追いかけておられるのですか。それは死んだ犬のあとを追い、一匹の蚤を追っておられるのにすぎません。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["だれ"],["を"],["追って","おって"],["出て","でて"],["来られた","こられた"],["の"],["です"],["か"],["。"],["あなた"],["は"],["だれ"],["を"],["追いかけて","おいかけて"],["おられる"],["の"],["です"],["か"],["。"],["それ"],["は"],["死んだ","しんだ"],["犬","いぬ"],["の"],["あと"],["を"],["追い","おい"],["、"],["一匹","いちひき"],["の"],["蚤","のみ"],["を"],["追って","おって"],["おられる"],["のに"],["すぎません"],["。"]]},{"verse":15,"text":"どうか主が、さばき人となり、私とあなたの間をさばき、私の訴えを取り上げて、これを弁護し、正しいさばきであなたの手から私を救ってくださいますように。」","tok":[["どう"],["か"],["主","ぬし"],["が"],["、"],["さばき人","さばきにん"],["と"],["なり"],["、"],["私","わたくし"],["と"],["あなた"],["の"],["間","あいだ"],["を"],["さばき"],["、"],["私","わたくし"],["の"],["訴え","うったえ"],["を"],["取り上げて","とりあげて"],["、"],["これ"],["を"],["弁護","べんご"],["し"],["、"],["正しい","ただしい"],["さばき"],["で"],["あなた"],["の"],["手","て"],["から"],["私","わたくし"],["を"],["救って","すくって"],["くださいます"],["よう"],["に"],["。"],["」"]]},{"verse":16,"text":"ダビデがこのようにサウルに語り終えたとき、サウルは、「これはあなたの声なのか。わが子ダビデよ」と言った。サウルは声をあげて泣いた。","tok":[["ダビデ"],["が"],["この"],["よう"],["に"],["サウル"],["に"],["語り","かたり"],["終えた","おえた"],["とき"],["、"],["サウル"],["は"],["、"],["「"],["これ"],["は"],["あなた"],["の"],["声","こえ"],["な"],["の"],["か"],["。"],["わが"],["子","こ"],["ダビデ"],["よ"],["」"],["と"],["言った","いった"],["。"],["サウル"],["は"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":17,"text":"そしてダビデに言った。「あなたは私より正しい。あなたは私に良くしてくれたのに、私はあなたに悪いしうちをした。","tok":[["そして"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["より"],["正しい","ただしい"],["。"],["あなた"],["は"],["私","わたくし"],["に"],["良く","よく"],["して"],["くれた"],["のに"],["、"],["私","わたくし"],["は"],["あなた"],["に"],["悪い","わるい"],["し"],["うち"],["を"],["した"],["。"]]},{"verse":18,"text":"あなたが私に良いことをしていたことを、きょう、あなたは知らせてくれた。主が私をあなたの手に渡されたのに、私を殺さなかったからだ。","tok":[["あなた"],["が"],["私","わたくし"],["に"],["良い","よい"],["こと"],["を"],["して"],["いた"],["こと"],["を"],["、"],["きょう"],["、"],["あなた"],["は"],["知らせて","しらせて"],["くれた"],["。"],["主","ぬし"],["が"],["私","わたくし"],["を"],["あなた"],["の"],["手","て"],["に"],["渡された","わたされた"],["のに"],["、"],["私","わたくし"],["を"],["殺さなかった","ころさなかった"],["から"],["だ"],["。"]]},{"verse":19,"text":"人が自分の敵を見つけたとき、無事にその敵を去らせるであろうか。あなたがきょう、私にしてくれた事の報いとして、主があなたに幸いを与えられるように。","tok":[["人","ひと"],["が"],["自分","じぶん"],["の"],["敵","てき"],["を"],["見つけた","みつけた"],["とき"],["、"],["無事","ぶじ"],["に"],["その"],["敵","てき"],["を"],["去らせるで","さらせるで"],["あろう"],["か"],["。"],["あなた"],["が"],["きょう"],["、"],["私","わたくし"],["に"],["して"],["くれた"],["事","こと"],["の"],["報い","むくい"],["として"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["幸い","さいわい"],["を"],["与えられる","あたえられる"],["よう"],["に"],["。"]]},{"verse":20,"text":"あなたが必ず王になり、あなたの手によってイスラエル王国が確立することを、私は今、確かに知った。","tok":[["あなた"],["が"],["必ず","かならず"],["王","おう"],["に"],["なり"],["、"],["あなた"],["の"],["手","て"],["によって"],["イスラエル"],["王国","おうこく"],["が"],["確立","かくりつ"],["する"],["こと"],["を"],["、"],["私","わたくし"],["は"],["今","いま"],["、"],["確か","たしか"],["に"],["知った","しった"],["。"]]},{"verse":21,"text":"さあ、主にかけて私に誓ってくれ。私のあとの私の子孫を断たず、私の名を私の父の家から根絶やしにしないことを。」","tok":[["さあ"],["、"],["主","ぬし"],["に"],["かけて"],["私","わたくし"],["に"],["誓って","ちかって"],["くれ"],["。"],["私","わたくし"],["の"],["あと"],["の"],["私","わたくし"],["の"],["子孫","しそん"],["を"],["断たず","たたず"],["、"],["私","わたくし"],["の"],["名","な"],["を"],["私","わたくし"],["の"],["父","ちち"],["の"],["家","いえ"],["から"],["根絶やし","ねだやし"],["に"],["しない"],["こと"],["を"],["。"],["」"]]},{"verse":22,"text":"ダビデはこれをサウルに誓った。サウルは自分の家へ帰り、ダビデとその部下は要害へ上って行った。","tok":[["ダビデ"],["は"],["これ"],["を"],["サウル"],["に"],["誓った","ちかった"],["。"],["サウル"],["は"],["自分","じぶん"],["の"],["家","いえ"],["へ"],["帰り","かえり"],["、"],["ダビデ"],["と"],["その"],["部下","ぶか"],["は"],["要害","ようがい"],["へ"],["上って","のぼって"],["行った","いった"],["。"]]}]
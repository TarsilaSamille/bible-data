[{"verse":1,"text":"サムエルはすべてのイスラエル人に言った。「見よ。あなたがたが私に言ったことを、私はことごとく聞き入れ、あなたがたの上にひとりの王を立てた。","tok":[["サムエル"],["は"],["すべて"],["の"],["イスラエル"],["人","にん"],["に"],["言った","いった"],["。"],["「"],["見","み"],["よ"],["。"],["あなた"],["がた"],["が"],["私","わたくし"],["に"],["言った","いった"],["こと"],["を"],["、"],["私","わたくし"],["は"],["ことごとく"],["聞き入れ","ききいれ"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["ひとり"],["の"],["王","おう"],["を"],["立てた","たてた"],["。"]]},{"verse":2,"text":"今、見なさい。王はあなたがたの先に立って歩んでいる。この私は年をとり、髪も白くなった。それに私の息子たちは、あなたがたとともにいるようになった。私は若い時から今日まで、あなたがたの先に立って歩んだ。","tok":[["今","いま"],["、"],["見","み"],["なさい"],["。"],["王","おう"],["は"],["あなた"],["がた"],["の"],["先","さき"],["に"],["立って","たって"],["歩んで","あゆんで"],["いる"],["。"],["この"],["私","わたくし"],["は"],["年","とし"],["を"],["とり"],["、"],["髪","かみ"],["も"],["白く","しろく"],["なった"],["。"],["それ"],["に"],["私","わたくし"],["の"],["息子","むすこ"],["たち"],["は"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["いる"],["よう"],["に"],["なった"],["。"],["私","わたくし"],["は"],["若い","わかい"],["時","とき"],["から"],["今日","きょう"],["まで"],["、"],["あなた"],["がた"],["の"],["先","さき"],["に"],["立って","たって"],["歩んだ","あゆんだ"],["。"]]},{"verse":3,"text":"さあ、今、主の前、油そそがれた者の前で、私を訴えなさい。私はだれかの牛を取っただろうか。だれかのろばを取っただろうか。だれかを苦しめ、だれかを迫害しただろうか。だれかの手からわいろを取って自分の目をくらましただろうか。もしそうなら、私はあなたがたにお返しする。」","tok":[["さあ"],["、"],["今","いま"],["、"],["主","ぬし"],["の"],["前","まえ"],["、"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["前","まえ"],["で"],["、"],["私","わたくし"],["を"],["訴え","うったえ"],["なさい"],["。"],["私","わたくし"],["は"],["だれ"],["か"],["の"],["牛","うし"],["を"],["取っただろう","とっただろう"],["か"],["。"],["だれ"],["か"],["の"],["ろば"],["を"],["取っただろう","とっただろう"],["か"],["。"],["だれ"],["か"],["を"],["苦しめ","くるしめ"],["、"],["だれ"],["か"],["を"],["迫害","はくがい"],["しただろう"],["か"],["。"],["だれ"],["か"],["の"],["手","て"],["から"],["わいろ"],["を"],["取って","とって"],["自分","じぶん"],["の"],["目","め"],["を"],["くらましただろう"],["か"],["。"],["もし"],["そう"],["なら"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["お返し","おかえし"],["する"],["。"],["」"]]},{"verse":4,"text":"彼らは言った。「あなたは私たちを苦しめたことも、迫害したことも、人の手から何かを取ったこともありません。」","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私たち","わたしたち"],["を"],["苦しめた","くるしめた"],["こと"],["も"],["、"],["迫害","はくがい"],["した"],["こと"],["も"],["、"],["人","ひと"],["の"],["手","て"],["から"],["何","なん"],["か"],["を"],["取った","とった"],["こと"],["も"],["ありません"],["。"],["」"]]},{"verse":5,"text":"そこでサムエルは彼らに言った。「あなたがたが私の手に何も見いださなかったことについては、きょう、あなたがたの間で主が証人であり、主に油そそがれた者が証人である。」すると彼らは言った。「その方が証人です。」","tok":[["そこ"],["で"],["サムエル"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["が"],["私","わたくし"],["の"],["手","て"],["に"],["何","なん"],["も"],["見いださなかった","みいださなかった"],["こと"],["について"],["は"],["、"],["きょう"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["主","ぬし"],["が"],["証人","しょうにん"],["で"],["あり"],["、"],["主に","おもに"],["油","あぶら"],["そそがれた"],["者","もの"],["が"],["証人","しょうにん"],["で"],["ある"],["。"],["」"],["する"],["と"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["その"],["方","ほう"],["が"],["証人","しょうにん"],["です"],["。"],["」"]]},{"verse":6,"text":"サムエルは民に言った。「モーセとアロンを立てて、あなたがたの先祖をエジプトの地から上らせたのは主である。","tok":[["サムエル"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["モーセ"],["と"],["アロン"],["を"],["立てて","たてて"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["上らせた","のぼらせた"],["の"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":7,"text":"さあ、立ちなさい。私は、主があなたがたと、あなたがたの先祖とに行われたすべての正義のみわざを、主の前であなたがたに説き明かそう。","tok":[["さあ"],["、"],["立ち","たち"],["なさい"],["。"],["私","わたくし"],["は"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["と"],["に"],["行われた","おこなわれた"],["すべて"],["の"],["正義","せいぎ"],["のみ"],["わざ"],["を"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["あなた"],["がた"],["に"],["説き明かそう","ときあかそう"],["。"]]},{"verse":8,"text":"ヤコブがエジプトに行ったとき、あなたがたの先祖は主に叫んだ。主はモーセとアロンを遣わされ、この人々はあなたがたの先祖をエジプトから連れ出し、この地に住まわせた。","tok":[["ヤコブ"],["が"],["エジプト"],["に"],["行った","いった"],["とき"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["は"],["主に","おもに"],["叫んだ","さけんだ"],["。"],["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["を"],["遣わされ","つかわされ"],["、"],["この"],["人々","ひとびと"],["は"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["から"],["連れ出し","つれだし"],["、"],["この"],["地","ち"],["に"],["住まわせた","すまわせた"],["。"]]},{"verse":9,"text":"ところが、彼らは彼らの神、主を忘れたので、主は彼らをハツォルの将軍シセラの手、ペリシテ人の手、モアブの王の手に売り渡された。それで彼らが戦いをいどまれたのである。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["忘れた","わすれた"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["ハツォル"],["の"],["将軍","しょうぐん"],["シセラ"],["の"],["手","て"],["、"],["ペリシテ"],["人","にん"],["の"],["手","て"],["、"],["モアブ"],["の"],["王","おう"],["の"],["手","て"],["に"],["売り渡された","うりわたされた"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["が"],["戦い","たたかい"],["を"],["いどまれた"],["ので"],["ある"],["。"]]},{"verse":10,"text":"彼らが、『私たちは主を捨て、バアルやアシュタロテなどに仕えて罪を犯しました。私たちを敵の手から救い出してください。私たちはあなたに仕えます』と言って、主に叫び求めたとき、","tok":[["彼","かれ"],["ら"],["が"],["、"],["『"],["私たち","わたしたち"],["は"],["主","ぬし"],["を"],["捨て","すて"],["、"],["バアル"],["や"],["アシュタロテ"],["など"],["に"],["仕えて","つかえて"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["私たち","わたしたち"],["を"],["敵","てき"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["ください"],["。"],["私たち","わたしたち"],["は"],["あなた"],["に"],["仕えます","つかえます"],["』"],["と"],["言って","いって"],["、"],["主に","おもに"],["叫び","さけび"],["求めた","もとめた"],["とき"],["、"]]},{"verse":11,"text":"主はエルバアルとベダンとエフタとサムエルを遣わし、あなたがたを周囲の敵の手から救い出してくださった。それであなたがたは安らかに暮らしてきた。","tok":[["主","ぬし"],["は"],["エルバアル"],["と"],["ベダン"],["と"],["エフタ"],["と"],["サムエル"],["を"],["遣わし","つかわし"],["、"],["あなた"],["がた"],["を"],["周囲","しゅうい"],["の"],["敵","てき"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["くださった"],["。"],["それ"],["で"],["あなた"],["がた"],["は"],["安らか","やすらか"],["に"],["暮らして","くらして"],["きた"],["。"]]},{"verse":12,"text":"あなたがたは、アモン人の王ナハシュがあなたがたに向かって来るのを見たとき、あなたがたの神、主があなたがたの王であるのに、『いや、王が私たちを治めなければならない』と私に言った。","tok":[["あなた"],["がた"],["は"],["、"],["アモン人","あもんにん"],["の"],["王","おう"],["ナハシュ"],["が"],["あなた"],["がた"],["に"],["向かって","むかって"],["来る","くる"],["の"],["を"],["見た","みた"],["とき"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["の"],["王","おう"],["で"],["ある"],["のに"],["、"],["『"],["いや"],["、"],["王","おう"],["が"],["私たち","わたしたち"],["を"],["治めなければ","おさめなければ"],["ならない"],["』"],["と"],["私","わたくし"],["に"],["言った","いった"],["。"]]},{"verse":13,"text":"今、見なさい。あなたがたが選び、あなたがたが求めた王を。見なさい。主はあなたがたの上に王を置かれた。","tok":[["今","いま"],["、"],["見","み"],["なさい"],["。"],["あなた"],["がた"],["が"],["選び","えらび"],["、"],["あなた"],["がた"],["が"],["求めた","もとめた"],["王","おう"],["を"],["。"],["見","み"],["なさい"],["。"],["主","ぬし"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["置かれた","おかれた"],["。"]]},{"verse":14,"text":"もし、あなたがたが主を恐れ、主に仕え、主の御声に聞き従い、主の命令に逆らわず、また、あなたがたも、あなたがたを治める王も、あなたがたの神、主のあとに従うなら、それで良い。","tok":[["もし"],["、"],["あなた"],["がた"],["が"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["主に","おもに"],["仕え","つかえ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従い","ききしたがい"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["に"],["逆らわず","さからわず"],["、"],["また"],["、"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["を"],["治める","おさめる"],["王","おう"],["も"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["あと"],["に"],["従うなら","したがうなら"],["、"],["それ"],["で"],["良い","よい"],["。"]]},{"verse":15,"text":"もし、あなたがたが主の御声に聞き従わず、主の命令に逆らうなら、主の手があなたがたの先祖たちに下ったように、あなたがたの上にも下る。","tok":[["もし"],["、"],["あなた"],["がた"],["が"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["に"],["逆らうなら","さからうなら"],["、"],["主","ぬし"],["の"],["手","て"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["に"],["下った","くだった"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["も"],["下る","くだる"],["。"]]},{"verse":16,"text":"今一度立って、主があなたがたの目の前で行われるこの大きなみわざを見なさい。","tok":[["今","いま"],["一度","いちど"],["立って","たって"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["行われる","おこなわれる"],["この"],["大きな","おおきな"],["みわざ"],["を"],["見","み"],["なさい"],["。"]]},{"verse":17,"text":"今は小麦の刈り入れ時ではないか。だが私が主に呼び求めると、主は雷と雨とを下される。あなたがたは王を求めて、主のみこころを大いにそこなったことを悟り、心に留めなさい。」","tok":[["今","いま"],["は"],["小麦","こむぎ"],["の"],["刈り入れ","かりいれ"],["時","とき"],["で"],["は"],["ない"],["か"],["。"],["だ"],["が"],["私","わたくし"],["が"],["主に","おもに"],["呼び求める","よびもとめる"],["と"],["、"],["主","ぬし"],["は"],["雷","かみなり"],["と"],["雨","あめ"],["と"],["を"],["下される","くだされる"],["。"],["あなた"],["がた"],["は"],["王","おう"],["を"],["求めて","もとめて"],["、"],["主","ぬし"],["のみ"],["こころ"],["を"],["大いに","おおいに"],["そこなった"],["こと"],["を"],["悟り","さとり"],["、"],["心","こころ"],["に"],["留め","とめ"],["なさい"],["。"],["」"]]},{"verse":18,"text":"それからサムエルは主に呼び求めた。すると、主はその日、雷と雨とを下された。民はみな、主とサムエルを非常に恐れた。","tok":[["それ"],["から"],["サムエル"],["は"],["主に","おもに"],["呼び求めた","よびもとめた"],["。"],["する"],["と"],["、"],["主","ぬし"],["は"],["その"],["日","ひ"],["、"],["雷","かみなり"],["と"],["雨","あめ"],["と"],["を"],["下された","くだされた"],["。"],["民","たみ"],["は"],["みな"],["、"],["主","ぬし"],["と"],["サムエル"],["を"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":19,"text":"民はみな、サムエルに言った。「あなたのしもべどものために、あなたの神、主に祈り、私たちが死なないようにしてください。私たちのあらゆる罪の上に、王を求めるという悪を加えたからです。」","tok":[["民","みん"],["は"],["みな"],["、"],["サムエル"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["しもべ"],["ども"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈り","いのり"],["、"],["私たち","わたしたち"],["が"],["死なない","しなない"],["よう"],["に"],["して"],["ください"],["。"],["私たち","わたしたち"],["の"],["あらゆる"],["罪","つみ"],["の"],["上","うえ"],["に"],["、"],["王","おう"],["を"],["求める","もとめる"],["と"],["いう"],["悪","わる"],["を"],["加えた","くわえた"],["から"],["です"],["。"],["」"]]},{"verse":20,"text":"サムエルは民に言った。「恐れてはならない。あなたがたは、このすべての悪を行った。しかし主に従い、わきにそれず、心を尽くして主に仕えなさい。","tok":[["サムエル"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["がた"],["は"],["、"],["この"],["すべて"],["の"],["悪","あく"],["を"],["行った","おこなった"],["。"],["しかし"],["主に","おもに"],["従い","したがい"],["、"],["わき"],["に"],["それず"],["、"],["心","こころ"],["を"],["尽くして","つくして"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":21,"text":"役にも立たず、救い出すこともできないむなしいものに従って、わきへそれてはならない。それはむなしいものだ。","tok":[["役","やく"],["に"],["も"],["立たず","たたず"],["、"],["救い出す","すくいだす"],["こと"],["も"],["できない"],["むなしい"],["もの"],["に"],["従って","したがって"],["、"],["わき"],["へ"],["それ"],["て"],["は"],["ならない"],["。"],["それ"],["は"],["むなしい"],["もの"],["だ"],["。"]]},{"verse":22,"text":"まことに主は、ご自分の偉大な御名のために、ご自分の民を捨て去らない。主はあえて、あなたがたをご自分の民とされるからだ。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["の"],["偉大","いだい"],["な"],["御名","ぎょめい"],["の"],["ため"],["に"],["、"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["捨て去らない","すてさらない"],["。"],["主","ぬし"],["は"],["あえて"],["、"],["あなた"],["がた"],["を"],["ご自分","ごじぶん"],["の"],["民","たみ"],["と"],["される"],["から"],["だ"],["。"]]},{"verse":23,"text":"私もまた、あなたがたのために祈るのをやめて主に罪を犯すことなど、とてもできない。私はあなたがたに、よい正しい道を教えよう。","tok":[["私","わたくし"],["も"],["また"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["祈る","いのる"],["の"],["を"],["やめて"],["主に","おもに"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["など"],["、"],["とても"],["できない"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["、"],["よい"],["正しい","ただしい"],["道","みち"],["を"],["教えよう","おしえよう"],["。"]]},{"verse":24,"text":"ただ、主を恐れ、心を尽くし、誠意をもって主に仕えなさい。主がどれほど偉大なことをあなたがたになさったかを見分けなさい。","tok":[["ただ"],["、"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["誠意","せいい"],["を"],["もって"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"],["主","ぬし"],["が"],["どれ"],["ほど"],["偉大","いだい"],["な"],["こと"],["を"],["あなた"],["がた"],["に"],["なさった"],["か"],["を"],["見分け","みわけ"],["なさい"],["。"]]},{"verse":25,"text":"あなたがたが悪を重ねるなら、あなたがたも、あなたがたの王も滅ぼし尽くされる。」","tok":[["あなた"],["がた"],["が"],["悪","あく"],["を"],["重ねるなら","かさねるなら"],["、"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["の"],["王","おう"],["も"],["滅ぼし","ほろぼし"],["尽くされる","つくされる"],["。"],["」"]]}]
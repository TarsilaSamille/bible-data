[{"verse":1,"text":"サムエルは、年老いたとき、息子たちをイスラエルのさばきつかさとした。","tok":[["サムエル"],["は"],["、"],["年老いた","としおいた"],["とき"],["、"],["息子","むすこ"],["たち"],["を"],["イスラエル"],["の"],["さばきつ"],["か"],["さ"],["と"],["した"],["。"]]},{"verse":2,"text":"長男の名はヨエル、次男の名はアビヤである。彼らはベエル・シェバで、さばきつかさであった。","tok":[["長男","ちょうなん"],["の"],["名","な"],["は"],["ヨエル"],["、"],["次男","じなん"],["の"],["名","な"],["は"],["アビヤ"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["ベエル"],["・"],["シェバ"],["で"],["、"],["さばき"],["つかさ"],["で"],["あった"],["。"]]},{"verse":3,"text":"この息子たちは父の道に歩まず、利得を追い求め、わいろを取り、さばきを曲げていた。","tok":[["この"],["息子","むすこ"],["たち"],["は"],["父","ちち"],["の"],["道","みち"],["に"],["歩まず","あゆまず"],["、"],["利得","りとく"],["を"],["追い求め","おいもとめ"],["、"],["わいろ"],["を"],["取り","とり"],["、"],["さばき"],["を"],["曲げて","まげて"],["いた"],["。"]]},{"verse":4,"text":"そこでイスラエルの長老たちはみな集まり、ラマのサムエルのところに来て、","tok":[["そこ"],["で"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["は"],["みな"],["集まり","あつまり"],["、"],["ラマ"],["の"],["サムエル"],["の"],["ところ"],["に"],["来て","きて"],["、"]]},{"verse":5,"text":"彼に言った。「今や、あなたはお年を召され、あなたのご子息たちは、あなたの道を歩みません。どうか今、ほかのすべての国民のように、私たちをさばく王を立ててください。」","tok":[["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["今","いま"],["や"],["、"],["あなた"],["は"],["お年","おとし"],["を"],["召され","めされ"],["、"],["あなた"],["の"],["ご子息","ごしそく"],["たち"],["は"],["、"],["あなた"],["の"],["道","みち"],["を"],["歩みません","あゆみません"],["。"],["どう"],["か"],["今","いま"],["、"],["ほか"],["の"],["すべて"],["の"],["国民","こくみん"],["の"],["よう"],["に"],["、"],["私たち","わたしたち"],["を"],["さばく"],["王","おう"],["を"],["立てて","たてて"],["ください"],["。"],["」"]]},{"verse":6,"text":"彼らが、「私たちをさばく王を与えてください」と言ったとき、そのことばはサムエルの気に入らなかった。そこでサムエルは主に祈った。","tok":[["彼","かれ"],["ら"],["が"],["、"],["「"],["私たち","わたしたち"],["を"],["さばく"],["王","おう"],["を"],["与えて","あたえて"],["ください"],["」"],["と"],["言った","いった"],["とき"],["、"],["その"],["ことば"],["は"],["サムエル"],["の"],["気","き"],["に"],["入らなかった","いらなかった"],["。"],["そこ"],["で"],["サムエル"],["は"],["主に","おもに"],["祈った","いのった"],["。"]]},{"verse":7,"text":"主はサムエルに仰せられた。「この民があなたに言うとおりに、民の声を聞き入れよ。それはあなたを退けたのではなく、彼らを治めているこのわたしを退けたのであるから。","tok":[["主","ぬし"],["は"],["サムエル"],["に"],["仰せられた","おおせられた"],["。"],["「"],["この"],["民","たみ"],["が"],["あなた"],["に"],["言う","いう"],["とおり"],["に"],["、"],["民","みん"],["の"],["声","こえ"],["を"],["聞き入れよ","ききいれよ"],["。"],["それ"],["は"],["あなた"],["を"],["退けた","しりぞけた"],["ので"],["は"],["なく"],["、"],["彼","かれ"],["ら"],["を"],["治めて","おさめて"],["いる"],["この"],["わたし"],["を"],["退けた","しりぞけた"],["ので"],["ある"],["から"],["。"]]},{"verse":8,"text":"わたしが彼らをエジプトから連れ上った日から今日に至るまで、彼らのした事といえば、わたしを捨てて、ほかの神々に仕えたことだった。そのように彼らは、あなたにもしているのだ。","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["を"],["エジプト"],["から"],["連れ上った","つれのぼった"],["日","ひ"],["から"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["彼","かれ"],["ら"],["の"],["した"],["事","こと"],["と"],["いえば"],["、"],["わたし"],["を"],["捨てて","すてて"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["こと"],["だった"],["。"],["その"],["よう"],["に"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["に"],["も"],["して"],["いる"],["の"],["だ"],["。"]]},{"verse":9,"text":"今、彼らの声を聞け。ただし、彼らにきびしく警告し、彼らを治める王の権利を彼らに知らせよ。」","tok":[["今","いま"],["、"],["彼","かれ"],["ら"],["の"],["声","こえ"],["を"],["聞け","きけ"],["。"],["ただし"],["、"],["彼","かれ"],["ら"],["に"],["きびしく"],["警告","けいこく"],["し"],["、"],["彼","かれ"],["ら"],["を"],["治める","おさめる"],["王","おう"],["の"],["権利","けんり"],["を"],["彼","かれ"],["ら"],["に"],["知らせ","しらせ"],["よ"],["。"],["」"]]},{"verse":10,"text":"そこでサムエルは、彼に王を求めるこの民に、主のことばを残らず話した。","tok":[["そこ"],["で"],["サムエル"],["は"],["、"],["彼","かれ"],["に"],["王","おう"],["を"],["求める","もとめる"],["この"],["民","たみ"],["に"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["残らず","のこらず"],["話した","はなした"],["。"]]},{"verse":11,"text":"そして言った。「あなたがたを治める王の権利はこうだ。王はあなたがたの息子をとり、彼らを自分の戦車や馬に乗せ、自分の戦車の前を走らせる。","tok":[["そして"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["を"],["治める","おさめる"],["王","おう"],["の"],["権利","けんり"],["は"],["こう"],["だ"],["。"],["王","おう"],["は"],["あなた"],["がた"],["の"],["息子","むすこ"],["を"],["とり"],["、"],["彼","かれ"],["ら"],["を"],["自分","じぶん"],["の"],["戦車","せんしゃ"],["や"],["馬","うま"],["に"],["乗せ","のせ"],["、"],["自分","じぶん"],["の"],["戦車","せんしゃ"],["の"],["前","まえ"],["を"],["走らせる","はしらせる"],["。"]]},{"verse":12,"text":"自分のために彼らを千人隊の長、五十人隊の長として、自分の耕地を耕させ、自分の刈り入れに従事させ、武具や、戦車の部品を作らせる。","tok":[["自分","じぶん"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["千人隊","せんにんたい"],["の"],["長","ちょう"],["、"],["五","ご"],["十人隊","じゅうにんたい"],["の"],["長","ちょう"],["として"],["、"],["自分","じぶん"],["の"],["耕地","こうち"],["を"],["耕させ","たがやさせ"],["、"],["自分","じぶん"],["の"],["刈り入れ","かりいれ"],["に"],["従事","じゅうじ"],["させ"],["、"],["武具","ぶぐ"],["や"],["、"],["戦車","せんしゃ"],["の"],["部品","ぶひん"],["を"],["作らせる","つくらせる"],["。"]]},{"verse":13,"text":"あなたがたの娘をとり、香料作りとし、料理女とし、パン焼き女とする。","tok":[["あなた"],["がた"],["の"],["娘","むすめ"],["を"],["とり"],["、"],["香料","こうりょう"],["作り","つくり"],["と"],["し"],["、"],["料理女","りょうりじょ"],["と"],["し"],["、"],["パン焼き","ぱんやき"],["女","おんな"],["と"],["する"],["。"]]},{"verse":14,"text":"あなたがたの畑や、ぶどう畑や、オリーブ畑の良い所を取り上げて、自分の家来たちに与える。","tok":[["あなた"],["がた"],["の"],["畑","はたけ"],["や"],["、"],["ぶどう"],["畑","はたけ"],["や"],["、"],["オリーブ"],["畑","はたけ"],["の"],["良い","よい"],["所","ところ"],["を"],["取り上げて","とりあげて"],["、"],["自分","じぶん"],["の"],["家来","けらい"],["たち"],["に"],["与える","あたえる"],["。"]]},{"verse":15,"text":"あなたがたの穀物とぶどうの十分の一を取り、それを自分の宦官や家来たちに与える。","tok":[["あなた"],["がた"],["の"],["穀物","こくもつ"],["と"],["ぶどう"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["取り","とり"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["宦官","かんがん"],["や"],["家来","けらい"],["たち"],["に"],["与える","あたえる"],["。"]]},{"verse":16,"text":"あなたがたの奴隷や、女奴隷、それに最もすぐれた若者や、ろばを取り、自分の仕事をさせる。","tok":[["あなた"],["がた"],["の"],["奴隷","どれい"],["や"],["、"],["女","じょ"],["奴隷","どれい"],["、"],["それ"],["に"],["最も","もっとも"],["すぐれた"],["若者","わかもの"],["や"],["、"],["ろば"],["を"],["取り","とり"],["、"],["自分","じぶん"],["の"],["仕事","しごと"],["を"],["させる"],["。"]]},{"verse":17,"text":"あなたがたの羊の群れの十分の一を取り、あなたがたは王の奴隷となる。","tok":[["あなた"],["がた"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["取り","とり"],["、"],["あなた"],["がた"],["は"],["王","おう"],["の"],["奴隷","どれい"],["と"],["なる"],["。"]]},{"verse":18,"text":"その日になって、あなたがたが、自分たちに選んだ王ゆえに、助けを求めて叫んでも、その日、主はあなたがたに答えてくださらない。」","tok":[["その"],["日","ひ"],["に"],["なって"],["、"],["あなた"],["が"],["た"],["が"],["、"],["自分","じぶん"],["たち"],["に"],["選んだ","えらんだ"],["王","おう"],["ゆえ"],["に"],["、"],["助け","たすけ"],["を"],["求めて","もとめて"],
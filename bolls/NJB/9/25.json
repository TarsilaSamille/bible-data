[{"verse":1,"text":"サムエルが死んだとき、イスラエル人はみな集まって、彼のためにいたみ悲しみ、ラマにある彼の屋敷に葬った。ダビデはそこを立ってパランの荒野に下って行った。","tok":[["サムエル"],["が"],["死んだ","しんだ"],["とき"],["、"],["イスラエル"],["人","にん"],["は"],["みな"],["集まって","あつまって"],["、"],["彼","かれ"],["の"],["ため"],["に"],["いたみ悲しみ","いたみかなしみ"],["、"],["ラマ"],["に"],["ある"],["彼","かれ"],["の"],["屋敷","やしき"],["に"],["葬った","ほうむった"],["。"],["ダビデ"],["は"],["そこ"],["を"],["立って","たって"],["パラン"],["の"],["荒野","あらの"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":2,"text":"マオンにひとりの人がいた。彼はカルメルで事業をしており、非常に裕福であった。彼は羊三千頭、やぎ一千頭を持っていた。そのころ、彼はカルメルで羊の毛の刈り取りの祝いをしていた。","tok":[["マオン"],["に"],["ひとり"],["の"],["人","ひと"],["が"],["いた"],["。"],["彼","かれ"],["は"],["カルメル"],["で"],["事業","じぎょう"],["を"],["して"],["おり"],["、"],["非常","ひじょう"],["に"],["裕福","ゆうふく"],["で"],["あった"],["。"],["彼","かれ"],["は"],["羊","ひつじ"],["三千頭","さんせんとう"],["、"],["やぎ"],["一千頭","いちせんとう"],["を"],["持って","もって"],["いた"],["。"],["その"],["ころ"],["、"],["彼","かれ"],["は"],["カルメル"],["で"],["羊","ひつじ"],["の"],["毛","け"],["の"],["刈り取り","かりとり"],["の"],["祝い","いわい"],["を"],["して"],["いた"],["。"]]},{"verse":3,"text":"この人の名はナバルといい、彼の妻の名はアビガイルといった。この女は聡明で美人であったが、夫は頑迷で行状が悪かった。彼はカレブ人であった。","tok":[["この"],["人","ひと"],["の"],["名","な"],["は"],["ナバル"],["と"],["いい"],["、"],["彼","かれ"],["の"],["妻","つま"],["の"],["名","な"],["は"],["アビガイル"],["と"],["いった"],["。"],["この"],["女","おんな"],["は"],["聡明","そうめい"],["で"],["美人","びじん"],["で"],["あった"],["が"],["、"],["夫","おっと"],["は"],["頑迷","がんめい"],["で"],["行状","ぎょうじょう"],["が"],["悪かった","わるかった"],["。"],["彼","かれ"],["は"],["カレブ人","かれぶにん"],["で"],["あった"],["。"]]},{"verse":4,"text":"ダビデはナバルがその羊の毛を刈っていることを荒野で聞いた。","tok":[["ダビデ"],["は"],["ナバル"],["が"],["その"],["羊","ひつじ"],["の"],["毛","け"],["を"],["刈って","かって"],["いる"],["こと"],["を"],["荒野","あらの"],["で"],["聞いた","きいた"],["。"]]},{"verse":5,"text":"それで、ダビデは十人の若者を遣わし、その若者たちに言った。「カルメルへ上って行って、ナバルのところに行き、私の名で彼に安否を尋ね、","tok":[["それ"],["で"],["、"],["ダビデ"],["は"],["十人","じゅうにん"],["の"],["若者","わかもの"],["を"],["遣わし","つかわし"],["、"],["その"],["若者","わかもの"],["たち"],["に"],["言った","いった"],["。"],["「"],["カルメル"],["へ"],["上って","のぼって"],["行って","いって"],["、"],["ナバル"],["の"],["ところ"],["に"],["行き","いき"],["、"],["私","わたくし"],["の"],["名","な"],["で"],["彼","かれ"],["に"],["安否","あんぴ"],["を"],["尋ね","たずね"],["、"]]},{"verse":6,"text":"わが同胞に、こうあいさつしなさい。『あなたに平安がありますように。あなたの家に平安がありますように。また、あなたのすべてのものに平安がありますように。","tok":[["わが"],["同胞","どうほう"],["に"],["、"],["こう"],["あいさつ"],["し"],["なさい"],["。"],["『"],["あなた"],["に"],["平安","へいあん"],["が"],["あります"],["よう"],["に"],["。"],["あなた"],["の"],["家","いえ"],["に"],["平安","へいあん"],["が"],["あります"],["よう"],["に"],["。"],["また"],["、"],["あなた"],["の"],["すべて"],["の"],["もの"],["に"],["平安","へいあん"],["が"],["あります"],["よう"],["に"],["。"]]},{"verse":7,"text":"私は今、羊の毛を刈る者たちが、あなたのところにいるのを聞きました。あなたの羊飼いたちは、私たちといっしょにいましたが、私たちは彼らに恥ずかしい思いをさせたことはありませんでした。彼らがカルメルにいる間中、何もなくなりませんでした。","tok":[["私","わたくし"],["は"],["今","いま"],["、"],["羊","ひつじ"],["の"],["毛","け"],["を"],["刈る","かる"],["者","もの"],["たち"],["が"],["、"],["あなた"],["の"],["ところ"],["に"],["いる"],["の"],["を"],["聞きました","ききました"],["。"],["あなた"],["の"],["羊飼い","ひつじかい"],["たち"],["は"],["、"],["私たち","わたしたち"],["と"],["いっしょ"],["に"],["いました"],["が"],["、"],["私たち","わたしたち"],["は"],["彼","かれ"],["ら"],["に"],["恥ずかしい","はずかしい"],["思い","おもい"],["を"],["させた"],["こと"],["は"],["ありませんでした"],["。"],["彼","かれ"],["ら"],["が"],["カルメル"],["に"],["いる"],["間中","まなか"],["、"],["何","なん"],["も"],["なくなりませんでした"],["。"]]},{"verse":8,"text":"あなたの若者に尋ねてみてください。きっと、そう言うでしょう。ですから、この若者たちに親切にしてやってください。私たちは祝いの日に来たのですから。どうか、このしもべたちと、あなたの子ダビデに、何かあなたの手もとにある物を与えてください。』」","tok":[["あなた"],["の"],["若者","わかもの"],["に"],["尋ねて","たずねて"],["みて"],["ください"],["。"],["きっと"],["、"],["そう"],["言うでしょう","ゆうでしょう"],["。"],["です"],["から"],["、"],["この"],["若者","わかもの"],["たち"],["に"],["親切","しんせつ"],["に"],["して"],["やって"],["ください"],["。"],["私たち","わたしたち"],["は"],["祝い","いわい"],["の"],["日","ひ"],["に"],["来た","きた"],["の"],["です"],["から"],["。"],["どう"],["か"],["、"],["この"],["しもべ"],["たち"],["と"],["、"],["あなた"],["の"],["子","こ"],["ダビデ"],["に"],["、"],["何","なん"],["か"],["あなた"],["の"],["手もと","てもと"],["に"],["ある"],["物","もの"],["を"],["与えて","あたえて"],["ください"],["。"],["』"],["」"]]},{"verse":9,"text":"ダビデの若者たちは行って、言われたとおりのことをダビデの名によってナバルに告げ、答えを待った。","tok":[["ダビデ"],["の"],["若者","わかもの"],["たち"],["は"],["行って","いって"],["、"],["言われた","いわれた"],["とおり"],["の"],["こと"],["を"],["ダビデ"],["の"],["名","な"],["によって"],["ナバル"],["に"],["告げ","つげ"],["、"],["答え","こたえ"],["を"],["待った","まった"],["。"]]},{"verse":10,"text":"ナバルはダビデの家来たちに答えて言った。「ダビデとは、いったい何者だ。エッサイの子とは、いったい何者だ。このごろは、主人のところを脱走する奴隷が多くなっている。","tok":[["ナバル"],["は"],["ダビデ"],["の"],["家来","けらい"],["たち"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["ダビデ"],["と"],["は"],["、"],["いったい"],["何者","なにもの"],["だ"],["。"],["エッサイ"],["の"],["子","こ"],["と"],["は"],["、"],["いったい"],["何者","なにもの"],["だ"],["。"],["このごろ"],["は"],["、"],["主人","しゅじん"],["の"],["ところ"],["を"],["脱走","だっそう"],["する"],["奴隷","どれい"],["が"],["多く","おおく"],["なって"],["いる"],["。"]]},{"verse":11,"text":"私のパンと私の水、それに羊の毛の刈り取りの祝いのためにほふったこの肉を取って、どこから来たかもわからない者どもに、くれてやらなければならないのか。」","tok":[["私","わたくし"],["の"],["パン"],["と"],["私","わたくし"],["の"],["水","みず"],["、"],["それ"],["に"],["羊","ひつじ"],["の"],["毛","け"],["の"],["刈り取り","かりとり"],["の"],["祝い","いわい"],["の"],["ため"],["に"],["ほふった"],["この"],["肉","にく"],["を"],["取って","とって"],["、"],["どこ"],["から"],["来た","きた"],["か"],["も"],["わからない"],["者","もの"],["ども"],["に"],["、"],["くれて"],["やらなければ"],["ならない"],["の"],["か"],["。"],["」"]]},{"verse":12,"text":"それでダビデの若者たちは、もと来た道を引き返し、戻って来て、これら一部始終をダビデに報告した。","tok":[["それ"],["で"],["ダビデ"],["の"],["若者","わかもの"],["たち"],["は"],["、"],["もと"],["来た","きた"],["道","みち"],["を"],["引き返し","ひきかえし"],["、"],["戻って","もどって"],["来て","きて"],["、"],["これ"],["ら"],["一部","いちぶ"],["始終","しじゅう"],["を"],["ダビデ"],["に"],["報告","ほうこく"],["した"],["。"]]},{"verse":13,"text":"ダビデが部下に「めいめい自分の剣を身につけよ」と命じたので、みな剣を身につけた。ダビデも剣を身につけた。四百人ほどの者がダビデについて上って行き、二百人は荷物のところにとどまった。","tok":[["ダビデ"],["が"],["部下","ぶか"],["に"],["「"],["めいめい"],["自分","じぶん"],["の"],["剣","けん"],["を"],["身","み"],["に"],["つけよ"],["」"],["と"],["命じた","めいじた"],["ので"],["、"],["みな"],["剣","けん"],["を"],["身","み"],["に"],["つけた"],["。"],["ダビデ"],["も"],["剣","けん"],["を"],["身","み"],["に"],["つけた"],["。"],["四百人","よんひゃくにん"],["ほど"],["の"],["者","もの"],["が"],["ダビデ"],["について"],["上って","のぼって"],["行き","いき"],["、"],["二百人","にひゃくにん"],["は"],["荷物","にもつ"],["の"],["ところ"],["に"],["とどまった"],["。"]]},{"verse":14,"text":"そのとき、ナバルの妻アビガイルに、若者のひとりが
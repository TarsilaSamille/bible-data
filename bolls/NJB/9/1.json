[{"verse":1,"text":"エフライムの山地ラマタイム・ツォフィムに、その名をエルカナというひとりの人がいた。この人はエロハムの子、順次さかのぼって、エリフの子、トフの子、エフライム人ツフの子であった。","tok":[["エフライム"],["の"],["山地","さんち"],["ラマタイム"],["・"],["ツォフィム"],["に"],["、"],["その"],["名","な"],["を"],["エルカナ"],["と"],["いう"],["ひとり"],["の"],["人","ひと"],["が"],["いた"],["。"],["この"],["人","ひと"],["は"],["エロハム"],["の"],["子","こ"],["、"],["順次","じゅんじ"],["さかのぼって"],["、"],["エリフ"],["の"],["子","こ"],["、"],["トフ"],["の"],["子","こ"],["、"],["エフライム"],["人","にん"],["ツフ"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":2,"text":"エルカナには、ふたりの妻があった。ひとりの妻の名はハンナ、もうひとりの妻の名はペニンナと言った。ペニンナには子どもがあったが、ハンナには子どもがなかった。","tok":[["エルカナ"],["に"],["は"],["、"],["ふたり"],["の"],["妻","つま"],["が"],["あった"],["。"],["ひとり"],["の"],["妻","つま"],["の"],["名","な"],["は"],["ハンナ"],["、"],["もう"],["ひとり"],["の"],["妻","つま"],["の"],["名","な"],["は"],["ペニンナ"],["と"],["言った","いった"],["。"],["ペニンナ"],["に"],["は"],["子ども","こども"],["が"],["あった"],["が"],["、"],["ハンナ"],["に"],["は"],["子ども","こども"],["が"],["なかった"],["。"]]},{"verse":3,"text":"この人は自分の町から毎年シロに上って、万軍の主を礼拝し、いけにえをささげていた。そこにはエリのふたりの息子、主の祭司ホフニとピネハスがいた。","tok":[["この"],["人","ひと"],["は"],["自分","じぶん"],["の"],["町","まち"],["から"],["毎年","まいとし"],["シロ"],["に"],["上って","のぼって"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["を"],["礼拝","れいはい"],["し"],["、"],["いけにえ"],["を"],["ささげて"],["いた"],["。"],["そこ"],["に"],["は"],["エリ"],["の"],["ふたり"],["の"],["息子","むすこ"],["、"],["主","ぬし"],["の"],["祭司","さいし"],["ホフニ"],["と"],["ピネハス"],["が"],["いた"],["。"]]},{"verse":4,"text":"その日になると、エルカナはいけにえをささげ、妻のペニンナ、彼女のすべての息子、娘たちに、それぞれの受ける分を与えた。","tok":[["その"],["日","ひ"],["に"],["なる"],["と"],["、"],["エルカナ"],["は"],["いけにえ"],["を"],["ささげ"],["、"],["妻","つま"],["の"],["ペニンナ"],["、"],["彼女","かのじょ"],["の"],["すべて"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["に"],["、"],["それぞれ"],["の"],["受ける","うける"],["分","ぶん"],["を"],["与えた","あたえた"],["。"]]},{"verse":5,"text":"しかしハンナには特別の受け分を与えていた。主は彼女の胎を閉じておられたが、彼がハンナを愛していたからである。","tok":[["しかし"],["ハンナ"],["に"],["は"],["特別","とくべつ"],["の"],["受け","うけ"],["分","ぶん"],["を"],["与えて","あたえて"],["いた"],["。"],["主","ぬし"],["は"],["彼女","かのじょ"],["の"],["胎","はら"],["を"],["閉じて","とじて"],["おられた"],["が"],["、"],["彼","かれ"],["が"],["ハンナ"],["を"],["愛して","あいして"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"彼女を憎むペニンナは、主がハンナの胎を閉じておられるというので、ハンナが気をもんでいるのに、彼女をひどくいらだたせるようにした。","tok":[["彼女","かのじょ"],["を"],["憎む","にくむ"],["ペニンナ"],["は"],["、"],["主","ぬし"],["が"],["ハンナ"],["の"],["胎","はら"],["を"],["閉じて","とじて"],["おられる"],["と"],["いう"],["ので"],["、"],["ハンナ"],["が"],["気","き"],["を"],["もんで"],["いる"],["のに"],["、"],["彼女","かのじょ"],["を"],["ひどく"],["いらだたせる"],["よう"],["に"],["した"],["。"]]},{"verse":7,"text":"毎年、このようにして、彼女が主の宮に上って行くたびに、ペニンナは彼女をいらだたせた。そのためハンナは泣いて、食事をしようともしなかった。","tok":[["毎年","まいとし"],["、"],["この"],["よう"],["に"],["して"],["、"],["彼女","かのじょ"],["が"],["主","ぬし"],["の"],["宮","みや"],["に"],["上って","のぼって"],["行く","いく"],["たび"],["に"],["、"],["ペニンナ"],["は"],["彼女","かのじょ"],["を"],["いらだたせた"],["。"],["その"],["ため"],["ハンナ"],["は"],["泣いて","ないて"],["、"],["食事","しょくじ"],["を"],["しよう"],["と"],["も"],["しなかった"],["。"]]},{"verse":8,"text":"それで夫エルカナは彼女に言った。「ハンナ。なぜ、泣くのか。どうして、食べないのか。どうして、ふさいでいるのか。あなたにとって、私は十人の息子以上の者ではないのか。」","tok":[["それ"],["で"],["夫","おっと"],["エルカナ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["ハンナ"],["。"],["なぜ"],["、"],["泣く","なく"],["の"],["か"],["。"],["どう"],["して"],["、"],["食べない","たべない"],["の"],["か"],["。"],["どう"],["して"],["、"],["ふさいで"],["いる"],["の"],["か"],["。"],["あなた"],["にとって"],["、"],["私","わたくし"],["は"],["十人","じゅうにん"],["の"],["息子","むすこ"],["以上","いじょう"],["の"],["者","もの"],["で"],["は"],["ない"],["の"],["か"],["。"],["」"]]},{"verse":9,"text":"シロでの食事が終わって、ハンナは立ち上がった。そのとき、祭司エリは、主の宮の柱のそばの席にすわっていた。","tok":[["シロ"],["で"],["の"],["食事","しょくじ"],["が"],["終わって","おわって"],["、"],["ハンナ"],["は"],["立ち上がった","たちあがった"],["。"],["その"],["とき"],["、"],["祭司","さいし"],["エリ"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["柱","はしら"],["の"],["そば"],["の"],["席","せき"],["に"],["すわって"],["いた"],["。"]]},{"verse":10,"text":"ハンナの心は痛んでいた。彼女は主に祈って、激しく泣いた。","tok":[["ハンナ"],["の"],["心","こころ"],["は"],["痛んで","いたんで"],["いた"],["。"],["彼女","かのじょ"],["は"],["主に","おもに"],["祈って","いのって"],["、"],["激しく","はげしく"],["泣いた","ないた"],["。"]]},{"verse":11,"text":"そして誓願を立てて言った。「万軍の主よ。もし、あなたが、はしための悩みを顧みて、私を心に留め、このはしためを忘れず、このはしために男の子を授けてくださいますなら、私はその子の一生を主におささげします。そして、その子の頭に、かみそりを当てません。」","tok":[["そして"],["誓願","せいがん"],["を"],["立てて","たてて"],["言った","いった"],["。"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["。"],["もし"],["、"],["あなた"],["が"],["、"],["はし"],["ため"],["の"],["悩み","なやみ"],["を"],["顧みて","かえりみて"],["、"],["私","わたくし"],["を"],["心","こころ"],["に"],["留め","とめ"],["、"],["この"],["はし"],["ため"],["を"],["忘れず","わすれず"],["、"],["この"],["はし"],["ため"],["に"],["男の子","おとこのこ"],["を"],["授けて","さずけて"],["くださいますなら"],["、"],["私","わたくし"],["は"],["その"],["子","こ"],["の"],["一生","いっしょう"],["を"],["主に","おもに"],["おささげ"],["します"],["。"],["そして"],["、"],["その"],["子","こ"],["の"],["頭","あたま"],["に"],["、"],["かみそり"],["を"],["当てません","あてません"],["。"],["」"]]},{"verse":12,"text":"ハンナが主の前で長く祈っている間、エリはその口もとを見守っていた。","tok":[["ハンナ"],["が"],["主","ぬし"],["の"],["前","まえ"],["で"],["長く","ながく"],["祈って","いのって"],["いる"],["間","あいだ"],["、"],["エリ"],["は"],["その"],["口もと","くちもと"],["を"],["見守って","みまもって"],["いた"],["。"]]},{"verse":13,"text":"ハンナは心のうちで祈っていたので、くちびるが動くだけで、その声は聞こえなかった。それでエリは彼女が酔っているのではないかと思った。","tok":[["ハンナ"],["は"],["心","こころ"],["の"],["うち"],["で"],["祈って","いのって"],["いた"],["ので"],["、"],["くちびる"],["が"],["動く","うごく"],["だけ"],["で"],["、"],["その"],["声","こえ"],["は"],["聞こえなかった","きこえなかった"],["。"],["それ"],["で"],["エリ"],["は"],["彼女","かのじょ"],["が"],["酔って","よって"],["いる"],["ので"],["は"],["ない"],["か"],["と"],["思った","おもった"],["。"]]},{"verse":14,"text":"エリは彼女に言った。「いつまで酔っているのか。酔いをさましなさい。」","tok":[["エリ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["いつ"],["まで"],["酔って","よって"],["いる"],["の"],["か"],["。"],["酔い","よい"],["を"],["さまし"],["なさい"],["。"],["」"]]},{"verse":15,"text":"ハンナは答えて言った。「いいえ、祭司さま。私は心に悩みのある女でございます。ぶどう酒も、お酒も飲んではおりません。私は主の前に、私の心を注ぎ出していたのです。","tok":[["ハンナ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["いいえ"],["、"],["祭司","さいし"],["さま"],["。"],["私","わたくし"],["は"],["心","こころ"],["に"],["悩み","なやみ"],["の"],["ある"],["女","おんな"],["で"],["ございます"],["。"],["ぶどう酒","ぶどうしゅ"],["も"],["、"],["お酒","おさけ"],["も"],["飲んで","のんで"],["は"],["おりません"],["。"],["私","わたくし"],["は"],["主","ぬし"],["の"],["前","まえ"],["に"],["、"],["私","わたくし"],["の"],["心","こころ"],["を"],["注ぎ","そそぎ"],["出して","だして"],["いた"],["の"],["です"],["。"]]},{"verse":16,"text":"このはしためを、よこしまな女と思わないでください。私はつのる憂いといらだちのため、今まで祈っていたのです。」","tok":[["この"],["はし"],["ため"],["を"],["、"],["よこしま"],["な"],["女","おんな"],["と"],["思わないで","おもわないで"],["ください"],["。"],["私","わたくし"],["は"],["つのる"],["憂い","うれい"],["と"],["いらだち"],["の"],["ため"],["、"],["今まで","いままで"],["祈って","いのって"],["いた"],["の"],["です"],["。"],["」"]]},{"verse":17,"text":"エリは答えて言った。「安心して行きなさい。イスラエルの神が、あなたの願ったその願いをかなえてくださるように。」","tok":[["エリ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["。"],["イスラエル"],["の"],["神","かみ"],["が"],["、"],["あなた"],["の"],["願った","ねがった"],["その"],["願い","ねがい"],["を"],["かなえて"],["くださる"],["よう"],["に"],["。"],["」"]]},{"verse":18,"text":"彼女は、「はしためが、あなたのご好意にあずかることができますように」と言った。それからこの女は帰って食事をした。彼女の顔は、もはや以前のようではなかった。","tok":[["彼女","かのじょ"],["は"],["、"],["「"],["はし"],["ため"],["が"],["、"],["あなた"],["の"],["ご好意","ごこうい"],["に"],["あずかる"],["こと"],["が"],["できます"],["よう"],["に"],["」"],["と"],["言った","いった"],["。"],["それ"],["から"],["この"],["女","おんな"],["は"],["帰って","かえって"],["食事","しょくじ"],["を"],["した"],["。"],["彼女","かのじょ"],["の"],["顔","かお"],["は"],["、"],["もはや"],["以前","いぜん"],["の"],["よう"],["で"],["は"],["なかった"],["。"]]},{"verse":19,"text":"翌朝早く、彼らは主の前で礼拝をし、ラマにある自分たちの家へ帰って行った。エルカナは自分の妻ハンナを知った。主は彼女を心に留められた。","tok":[["翌朝","よくあさ"],["早く","はやく"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["前","まえ"],["で"],["礼拝","れいはい"],["を"],["し"],["、"],["ラマ"],["に"],["ある"],["自分","じぶん"],["たち"],["の"],["家","いえ"],["へ"],["帰って","かえって"],["行った","いった"],["。"],["エルカナ"],["は"],["自分","じぶん"],["の"],["妻","つま"],["ハンナ"],["を"],["知った","しった"],["。"],["主","ぬし"],["は"],["彼女","かのじょ"],["を"],["心","こころ"],["に"],["留められた","とめられた"],["。"]]},{"verse":20,"text":"日が改まって、ハンナはみごもり、男の子を産んだ。そして「私がこの子を主に願ったから」と言って、その名をサムエルと呼んだ。","tok":[["日","ひ"],["が"],["改まって","あらたまって"],["、"],["ハンナ"],["は"],["みごもり"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["そして"],["「"],["私","わたくし"],["が"],["この"],["子","こ"],["を"],["主に","おもに"],["願った","ねがった"],["から"],["」"],["と"],["言って","いって"],["、"],["その"],["名","な"],["を"],["サムエル"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":21,"text":"夫のエルカナは、家族そろって、年ごとのいけにえを主にささげ、自分の誓願を果たすために上って行こうとしたが、","tok":[["夫","おっと"],["の"],["エルカナ"],["は"],["、"],["家族","かぞく"],["そろって"],["、"],["年","ねん"],["ごと"],["の"],["いけにえ"],["を"],["主に","おもに"],["ささげ"],["、"],["自分","じぶん"],["の"],["誓願","せいがん"],["を"],["果たす","はたす"],["ため"],["に"],["上って","のぼって"],["行こう","いこう"],["と"],["した"],["が"],["、"]]},{"verse":22,"text":"ハンナは夫に、「この子が乳離れし、私がこの子を連れて行き、この子が主の御顔を拝し、いつまでも、そこにとどまるようになるまでは」と言って、上って行かなかった。","tok":[["ハンナ"],["は"],["夫","おっと"],["に"],["、"],["「"],["この"],["子","こ"],["が"],["乳離れ","ちばなれ"],["し"],["、"],["私","わたくし"],["が"],["この"],["子","こ"],["を"],["連れて","つれて"],["行き","いき"],["、"],["この"],["子","こ"],["が"],["主","ぬし"],["の"],["御顔","おかお"],["を"],["拝し","はいし"],["、"],["いつ"],["まで"],["も"],["、"],["そこ"],["に"],["とどまる"],["よう"],["に"],["なる"],["まで"],["は"],["」"],["と"],["言って","いって"],["、"],["上って","のぼって"],["行かなかった","いかなかった"],["。"]]},{"verse":23,"text":"夫のエルカナは彼女に言った。「あなたの良いと思うようにしなさい。この子が乳離れするまで待ちなさい。ただ、主のおことばのとおりになるように。」こうしてこの女は、とどまって、その子が乳離れするまで乳を飲ませた。","tok":[["夫","おっと"],["の"],["エルカナ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["良い","よい"],["と"],["思う","おもう"],["よう"],["に"],["し"],["なさい"],["。"],["この"],["子","こ"],["が"],["乳離れ","ちばなれ"],["する"],["まで"],["待ち","まち"],["なさい"],["。"],["ただ"],["、"],["主","ぬし"],["の"],["おことば"],["の"],["とおり"],["に"],["なる"],["よう"],["に"],["。"],["」"],["こう"],["して"],["この"],["女","おんな"],["は"],["、"],["とどまって"],["、"],["その"],["子","こ"],["が"],["乳離れ","ちばなれ"],["する"],["まで"],["乳","ちち"],["を"],["飲ませた","のませた"],["。"]]},{"verse":24,"text":"その子が乳離れしたとき、彼女は雄牛三頭、小麦粉一エパ、ぶどう酒の皮袋一つを携え、その子を連れ上り、シロの主の宮に連れて行った。その子は幼かった。","tok":[["その"],["子","こ"],["が"],["乳離れ","ちばなれ"],["した"],["とき"],["、"],["彼女","かのじょ"],["は"],["雄牛","おうし"],["三頭","さんとう"],["、"],["小麦粉","こむぎこ"],["一","いち"],["エパ"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["皮袋","かわぶくろ"],["一","ひと"],["つ"],["を"],["携え","たずさえ"],["、"],["その"],["子","こ"],["を"],["連れ上り","つれのぼり"],["、"],["シロ"],["の"],["主","ぬし"],["の"],["宮","みや"],["に"],["連れて","つれて"],["行った","いった"],["。"],["その"],["子","こ"],["は"],["幼かった","おさなかった"],["。"]]},{"verse":25,"text":"彼らは、雄牛一頭をほふり、その子をエリのところに連れて行った。","tok":[["彼","かれ"],["ら"],["は"],["、"],["雄牛","おうし"],["一頭","いちとう"],["を"],["ほふり"],["、"],["その"],["子","こ"],["を"],["エリ"],["の"],["ところ"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":26,"text":"ハンナは言った。「おお、祭司さま。あなたは生きておられます。祭司さま。私はかつて、ここのあなたのそばに立って、主に祈った女でございます。","tok":[["ハンナ"],["は"],["言った","いった"],["。"],["「"],["おお"],["、"],["祭司","さいし"],["さま"],["。"],["あなた"],["は"],["生きて","いきて"],["おられます"],["。"],["祭司","さいし"],["さま"],["。"],["私","わたくし"],["は"],["かつて"],["、"],["ここ"],["の"],["あなた"],["の"],["そば"],["に"],["立って","たって"],["、"],["主に","おもに"],["祈った","いのった"],["女","おんな"],["で"],["ございます"],["。"]]},{"verse":27,"text":"この子のために、私は祈ったのです。主は私がお願いしたとおり、私の願いをかなえてくださいました。","tok":[["この"],["子","こ"],["の"],["ため"],["に"],["、"],["私","わたくし"],["は"],["祈った","いのった"],["の"],["です"],["。"],["主","ぬし"],["は"],["私","わたくし"],["が"],["お願い","おねがい"],["した"],["とおり"],["、"],["私","わたくし"],["の"],["願い","ねがい"],["を"],["かなえて"],["くださいました"],["。"]]},{"verse":28,"text":"それで私もまた、この子を主にお渡しいたします。この子は一生涯、主に渡されたものです。」こうして彼らはそこで主を礼拝した。","tok":[["それ"],["で"],["私","わたくし"],["も"],["また"],["、"],["この"],["子","こ"],["を"],["主に","おもに"],["お渡し","おわたし"],["いたします"],["。"],["この"],["子","こ"],["は"],["一生涯","いっしょうがい"],["、"],["主に","おもに"],["渡された","わたされた"],["もの"],["です"],["。"],["」"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["そこ"],["で"],["主","ぬし"],["を"],["礼拝","れいはい"],["した"],["。"]]}]
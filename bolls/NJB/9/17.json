,["。"]]},{"verse":42,"text":"ペリシテ人はあたりを見おろして、ダビデに目を留めたとき、彼をさげすんだ。ダビデが若くて、紅顔の美少年だったからである。","tok":[["ペリシテ"],["人","にん"],["は"],["あたり"],["を"],["見おろして","みおろして"],["、"],["ダビデ"],["に"],["目","め"],["を"],["留めた","とめた"],["とき"],["、"],["彼","かれ"],["を"],["さげすんだ"],["。"],["ダビデ"],["が"],["若くて","わかくて"],["、"],["紅顔","こうがん"],["の"],["美少年","びしょうねん"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":43,"text":"ペリシテ人はダビデに言った。「おれは犬なのか。杖を持って向かって来るが。」ペリシテ人は自分の神々によってダビデをのろった。","tok":[["ペリシテ"],["人","にん"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["おれ"],["は"],["犬","いぬ"],["な"],["の"],["か"],["。"],["杖","つえ"],["を"],["持って","もって"],["向かって","むかって"],["来る","くる"],["が"],["。"],["」"],["ペリシテ"],["人","にん"],["は"],["自分","じぶん"],["の"],["神々","かみがみ"],["によって"],["ダビデ"],["を"],["のろった"],["。"]]},{"verse":44,"text":"ペリシテ人はダビデに言った。「さあ、来い。おまえの肉を空の鳥や野の獣にくれてやろう。」","tok":[["ペリシテ"],["人","にん"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["来い","こい"],["。"],["おまえ"],["の"],["肉","にく"],["を"],["空","そら"],["の"],["鳥","とり"],["や"],["野","の"],["の"],["獣","けもの"],["に"],["くれて"],["やろう"],["。"],["」"]]},{"verse":45,"text":"ダビデはペリシテ人に言った。「おまえは、剣と、槍と、投げ槍を持って、私に向かって来るが、私は、おまえがなぶったイスラエルの戦陣の神、万軍の主の御名によって、おまえに立ち向かうのだ。","tok":[["ダビデ"],["は"],["ペリシテ"],["人","にん"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["は"],["、"],["剣","けん"],["と"],["、"],["槍","やり"],["と"],["、"],["投げ槍","なげやり"],["を"],["持って","もって"],["、"],["私","わたくし"],["に"],["向かって","むかって"],["来る","くる"],["が"],["、"],["私","わたくし"],["は"],["、"],["おまえ"],["が"],["なぶった"],["イスラエル"],["の"],["戦陣","せんじん"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["、"],["おまえ"],["に"],["立ち向かう","たちむかう"],["の"],["だ"],["。"]]},{"verse":46,"text":"きょう、主はおまえを私の手に渡される。私はおまえを打って、おまえの頭を胴体から離し、きょう、ペリシテ人の陣営のしかばねを、空の鳥、地の獣に与える。すべての国は、イスラエルに神がおられることを知るであろう。","tok":[["きょう"],["、"],["主","ぬし"],["は"],["おまえ"],["を"],["私","わたくし"],["の"],["手","て"],["に"],["渡される","わたされる"],["。"],["私","わたくし"],["は"],["おまえ"],["を"],["打って","うって"],["、"],["おまえ"],["の"],["頭","あたま"],["を"],["胴体","どうたい"],["から"],["離し","はなし"],["、"],["きょう"],["、"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["の"],["しかばね"],["を"],["、"],["空","そら"],["の"],["鳥","とり"],["、"],["地","ち"],["の"],["獣","けもの"],["に"],["与える","あたえる"],["。"],["すべて"],["の"],["国","くに"],["は"],["、"],["イスラエル"],["に"],["神","かみ"],["が"],["おられる"],["こと"],["を"],["知るで","しるで"],["あろう"],["。"]]},{"verse":47,"text":"この全集団も、主が剣や槍を使わずに救うことを知るであろう。この戦いは主の戦いだ。主はおまえたちをわれわれの手に渡される。」","tok":[["この"],["全","ぜん"],["集団","しゅうだん"],["も"],["、"],["主","ぬし"],["が"],["剣","けん"],["や"],["槍","やり"],["を"],["使わず","つかわず"],["に"],["救う","すくう"],["こと"],["を"],["知るで","しるで"],["あろう"],["。"],["この"],["戦い","たたかい"],["は"],["主","ぬし"],["の"],["戦い","たたかい"],["だ"],["。"],["主","ぬし"],["は"],["おまえ"],["たち"],["を"],["われわれ"],["の"],["手","て"],["に"],["渡される","わたされる"],["。"],["」"]]},{"verse":48,"text":"そのペリシテ人は、立ち上がり、ダビデを迎え撃とうと近づいて来た。ダビデもすばやく戦場を走って行き、ペリシテ人に立ち向かった。","tok":[["その"],["ペリシテ"],["人","にん"],["は"],["、"],["立ち上がり","たちあがり"],["、"],["ダビデ"],["を"],["迎え撃とう","むかえうとう"],["と"],["近づいて","ちかづいて"],["来た","きた"],["。"],["ダビデ"],["も"],["すばやく"],["戦場","せんじょう"],["を"],["走って","はしって"],["行き","いき"],["、"],["ペリシテ"],["人","にん"],["に"],["立ち向かった","たちむかった"],["。"]]},{"verse":49,"text":"ダビデは袋の中に手を差し入れ、石を一つ取り、石投げでそれを放ち、ペリシテ人の額を打った。石は額に食い込み、彼はうつぶせに倒れた。","tok":[["ダビデ"],["は"],["袋","ふくろ"],["の"],["中","なか"],["に"],["手","て"],["を"],["差し入れ","さしいれ"],["、"],["石","いし"],["を"],["一","ひと"],["つ"],["取り","とり"],["、"],["石投げ","いしなげ"],["で"],["それ"],["を"],["放ち","はなち"],["、"],["ペリシテ"],["人","にん"],["の"],["額","がく"],["を"],["打った","うった"],["。"],["石","いし"],["は"],["額","がく"],["に"],["食い込み","くいこみ"],["、"],["彼","かれ"],["は"],["うつぶせ"],["に"],["倒れた","たおれた"],["。"]]},{"verse":50,"text":"こうしてダビデは、石投げと一つの石で、このペリシテ人に勝った。ダビデの手には、一振りの剣もなかったが、このペリシテ人を打ち殺してしまった。","tok":[["こう"],["して"],["ダビデ"],["は"],["、"],["石投げ","いしなげ"],["と"],["一","ひと"],["つ"],["の"],["石","いし"],["で"],["、"],["この"],["ペリシテ"],["人","にん"],["に"],["勝った","かった"],["。"],["ダビデ"],["の"],["手","て"],["に"],["は"],["、"],["一","いち"],["振り","ふり"],["の"],["剣","けん"],["も"],["なかった"],["が"],["、"],["この"],["ペリシテ"],["人","にん"],["を"],["打ち殺して","うちころして"],["しまった"],["。"]]},{"verse":51,"text":"ダビデは走って行って、このペリシテ人の上にまたがり、彼の剣を奪って、さやから抜き、とどめを刺して首をはねた。ペリシテ人たちは、彼らの勇士が死んだのを見て逃げた。","tok":[["ダビデ"],["は"],["走って","はしって"],["行って","いって"],["、"],["この"],["ペリシテ"],["人","にん"],["の"],["上","うえ"],["に"],["またがり"],["、"],["彼","かれ"],["の"],["剣","けん"],["を"],["奪って","うばって"],["、"],["さや"],["から"],["抜き","ぬき"],["、"],["とどめ"],["を"],["刺して","さして"],["首","くび"],["を"],["はねた"],["。"],["ペリシテ"],["人","にん"],["たち"],["は"],["、"],["彼","かれ"],["ら"],["の"],["勇士","ゆうし"],["が"],["死んだ","しんだ"],["の"],["を"],["見て","みて"],["逃げた","にげた"],["。"]]},{"verse":52,"text":"イスラエルとユダの人々は立ち上がり、ときの声をあげて、ペリシテ人をガテに至るまで、エクロンの門まで追った。それでペリシテ人は、シャアライムからガテとエクロンに至る途上で刺し殺されて倒れた。","tok":[["イスラエル"],["と"],["ユダ"],["の"],["人々","ひとびと"],["は"],["立ち上がり","たちあがり"],["、"],["とき"],["の"],["声","こえ"],["を"],["あげて"],["、"],["ペリシテ"],["人","にん"],["を"],["ガテ"],["に"],["至る","いたる"],["まで"],["、"],["エクロン"],["の"],["門","もん"],["まで"],["追った","おった"],["。"],["それ"],["で"],["ペリシテ"],["人","にん"],["は"],["、"],["シャア"],["ライム"],["から"],["ガテ"],["と"],["エクロン"],["に"],["至る","いたる"],["途上","とじょう"],["で"],["刺し殺されて","さしころされて"],["倒れた","たおれた"],["。"]]},{"verse":53,"text":"イスラエル人はペリシテ人追撃から引き返して、ペリシテ人の陣営を略奪した。","tok":[["イスラエル"],["人","にん"],["は"],["ペリシテ"],["人","にん"],["追撃","ついげき"],["から"],["引き返して","ひきかえして"],["、"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["を"],["略奪","りゃくだつ"],["した"],["。"]]},{"verse":54,"text":"ダビデは、あのペリシテ人の首を取って、エルサレムに持ち帰った。武具は彼の天幕に置いた。","tok":[["ダビデ"],["は"],["、"],["あの"],["ペリシテ"],["人","にん"],["の"],["首","くび"],["を"],["取って","とって"],["、"],["エルサレム"],["に"],["持ち帰った","もちかえった"],["。"],["武具","ぶぐ"],["は"],["彼","かれ"],["の"],["天幕","てんまく"],["に"],["置いた","おいた"],["。"]]},{"verse":55,"text":"サウルは、ダビデがあのペリシテ人に立ち向かって出て行くのを見たとき、将軍アブネルに言った。「アブネル。あの若者はだれの子だ。」アブネルは言った。「王さま。私はあなたに誓います。私は存じません。」","tok":[["サウル"],["は"],["、"],["ダビデ"],["が"],["あの"],["ペリシテ"],["人","にん"],["に"],["立ち向かって","たちむかって"],["出て","でて"],["行く","いく"],["の"],["を"],["見た","みた"],["とき"],["、"],["将軍","しょうぐん"],["アブネル"],["に"],["言った","いった"],["。"],["「"],["アブネル"],["。"],["あの"],["若者","わかもの"],["は"],["だれ"],["の"],["子","こ"],["だ"],["。"],["」"],["アブネル"],["は"],["言った","いった"],["。"],["「"],["王","おう"],["さま"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["誓います","ちかいます"],["。"],["私","わたくし"],["は"],["存じません","ぞんじません"],["。"],["」"]]},{"verse":56,"text":"すると王は命じた。「あなたは、あの少年がだれの子か尋ねなさい。」","tok":[["する"],["と"],["王","おう"],["は"],["命じた","めいじた"],["。"],["「"],["あなた"],["は"],["、"],["あの"],["少年","しょうねん"],["が"],["だれ"],["の"],["子","こ"],["か"],["尋ね","たずね"],["なさい"],["。"],["」"]]},{"verse":57,"text":"ダビデが、あのペリシテ人を打って帰って来たとき、アブネルは彼をサウルの前に連れて行った。ダビデはペリシテ人の首を手にしていた。","tok":[["ダビデ"],["が"],["、"],["あの"],["ペリシテ"],["人","にん"],["を"],["打って","うって"],["帰って","かえって"],["来た","きた"],["とき"],["、"],["アブネル"],["は"],["彼","かれ"],["を"],["サウル"],["の"],["前","まえ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["ダビデ"],["は"],["ペリシテ"],["人","にん"],["の"],["首","くび"],["を"],["手","て"],["に"],["して"],["いた"],["。"]]},{"verse":58,"text":"サウルはダビデに言った。「若者。あなたはだれの子か。」ダビデは言った。「私は、あなたのしもべ、ベツレヘム人エッサイの子です。」","tok":[["サウル"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["若者","わかもの"],["。"],["あなた"],["は"],["だれ"],["の"],["子","こ"],["か"],["。"],["」"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["あなた"],["の"],["しもべ"],["、"],["ベツレヘム"],["人","にん"],["エッサイ"],["の"],["子","こ"],["です"],["。"],["」"]]}]
[{"verse":1,"text":"ペリシテ人は戦いのために軍隊を召集した。彼らはユダのソコに集まり、ソコとアゼカとの間にあるエフェス・ダミムに陣を敷いた。","tok":[["ペリシテ"],["人","にん"],["は"],["戦い","たたかい"],["の"],["ため"],["に"],["軍隊","ぐんたい"],["を"],["召集","しょうしゅう"],["した"],["。"],["彼","かれ"],["ら"],["は"],["ユダ"],["の"],["ソコ"],["に"],["集まり","あつまり"],["、"],["ソコ"],["と"],["アゼカ"],["と"],["の"],["間","あいだ"],["に"],["ある"],["エフェス"],["・"],["ダミム"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"]]},{"verse":2,"text":"サウルとイスラエル人は集まって、エラの谷に陣を敷き、ペリシテ人を迎え撃つため、戦いの備えをした。","tok":[["サウル"],["と"],["イスラエル"],["人","にん"],["は"],["集まって","あつまって"],["、"],["エラ"],["の"],["谷","たに"],["に"],["陣","じん"],["を"],["敷き","しき"],["、"],["ペリシテ"],["人","にん"],["を"],["迎え撃つ","むかえうつ"],["ため"],["、"],["戦い","たたかい"],["の"],["備え","そなえ"],["を"],["した"],["。"]]},{"verse":3,"text":"ペリシテ人は向こう側の山の上に、イスラエル人はこちら側の山の上に、谷を隔てて相対した。","tok":[["ペリシテ"],["人","にん"],["は"],["向こう側","むこうがわ"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["、"],["イスラエル"],["人","にん"],["は"],["こちら側","こちらがわ"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["、"],["谷","たに"],["を"],["隔てて","へだてて"],["相対","そうたい"],["した"],["。"]]},{"verse":4,"text":"ときに、ペリシテ人の陣営から、ひとりの代表戦士が出て来た。その名はゴリヤテ、ガテの生まれで、その背の高さは六キュビト半。","tok":[["とき"],["に"],["、"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["から"],["、"],["ひとり"],["の"],["代表","だいひょう"],["戦士","せんし"],["が"],["出て","でて"],["来た","きた"],["。"],["その"],["名","な"],["は"],["ゴリヤテ"],["、"],["ガテ"],["の"],["生まれ","うまれ"],["で"],["、"],["その"],["背","せ"],["の"],["高さ","たかさ"],["は"],["六","ろく"],["キュビト"],["半","はん"],["。"]]},{"verse":5,"text":"頭には青銅のかぶとをかぶり、身にはうろことじのよろいを着けていた。よろいの重さは青銅で五千シェケル。","tok":[["頭","あたま"],["に"],["は"],["青銅","せいどう"],["の"],["かぶと"],["を"],["かぶり"],["、"],["身","み"],["に"],["は"],["うろこ"],["とじ"],["の"],["よろい"],["を"],["着けて","つけて"],["いた"],["。"],["よろい"],["の"],["重さ","おもさ"],["は"],["青銅","せいどう"],["で"],["五千","ごせん"],["シェケル"],["。"]]},{"verse":6,"text":"足には青銅のすね当て、背中には青銅の投げ槍。","tok":[["足","あし"],["に"],["は"],["青銅","せいどう"],["の"],["すね当て","すねあて"],["、"],["背中","せなか"],["に"],["は"],["青銅","せいどう"],["の"],["投げ槍","なげやり"],["。"]]},{"verse":7,"text":"槍の柄は機織りの巻き棒のようであり、槍の穂先は、鉄で六百シェケル。盾持ちが彼の先を歩いていた。","tok":[["槍","やり"],["の"],["柄","がら"],["は"],["機織り","はたおり"],["の"],["巻き","まき"],["棒","ぼう"],["の"],["よう"],["で"],["あり"],["、"],["槍","やり"],["の"],["穂先","ほさき"],["は"],["、"],["鉄","てつ"],["で"],["六百","ろくひゃく"],["シェケル"],["。"],["盾持ち","たてもち"],["が"],["彼","かれ"],["の"],["先","さき"],["を"],["歩いて","あるいて"],["いた"],["。"]]},{"verse":8,"text":"ゴリヤテは立って、イスラエル人の陣に向かって叫んで言った。「おまえらは、なぜ、並んで出て来たのか。おれはペリシテ人だし、おまえらはサウルの奴隷ではないのか。ひとりを選んで、おれのところによこせ。","tok":[["ゴリヤテ"],["は"],["立って","たって"],["、"],["イスラエル"],["人","にん"],["の"],["陣","じん"],["に"],["向かって","むかって"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["おまえ"],["ら"],["は"],["、"],["なぜ"],["、"],["並んで","ならんで"],["出て","でて"],["来た","きた"],["の"],["か"],["。"],["おれ"],["は"],["ペリシテ"],["人","にん"],["だ"],["し"],["、"],["おまえ"],["ら"],["は"],["サウル"],["の"],["奴隷","どれい"],["で"],["は"],["ない"],["の"],["か"],["。"],["ひとり"],["を"],["選んで","えらんで"],["、"],["おれ"],["の"],["ところ"],["に"],["よこせ"],["。"]]},{"verse":9,"text":"おれと勝負して勝ち、おれを打ち殺すなら、おれたちはおまえらの奴隷となる。もし、おれが勝って、そいつを殺せば、おまえらがおれたちの奴隷となり、おれたちに仕えるのだ。」","tok":[["おれ"],["と"],["勝負","しょうぶ"],["して"],["勝ち","かち"],["、"],["おれ"],["を"],["打ち殺すなら","うちころすなら"],["、"],["おれ"],["たち"],["は"],["おまえ"],["ら"],["の"],["奴隷","どれい"],["と"],["なる"],["。"],["もし"],["、"],["おれ"],["が"],["勝って","かって"],["、"],["そいつ"],["を"],["殺せば","ころせば"],["、"],["おまえ"],["ら"],["が"],["おれ"],["たち"],["の"],["奴隷","どれい"],["と"],["なり"],["、"],["おれ"],["たち"],["に"],["仕える","つかえる"],["の"],["だ"],["。"],["」"]]},{"verse":10,"text":"そのペリシテ人はまた言った。「きょうこそ、イスラエルの陣をなぶってやる。ひとりをよこせ。ひとつ勝負をしよう。」","tok":[["その"],["ペリシテ"],["人","にん"],["は"],["また"],["言った","いった"],["。"],["「"],["きょう"],["こそ"],["、"],["イスラエル"],["の"],["陣","じん"],["を"],["なぶって"],["やる"],["。"],["ひとり"],["を"],["よこせ"],["。"],["ひと"],["つ"],["勝負","しょうぶ"],["を"],["しよう"],["。"],["」"]]},{"verse":11,"text":"サウルとイスラエルのすべては、このペリシテ人のことばを聞いたとき、意気消沈し、非常に恐れた。","tok":[["サウル"],["と"],["イスラエル"],["の"],["すべて"],["は"],["、"],["この"],["ペリシテ"],["人","にん"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["意気","いき"],["消沈","しょうちん"],["し"],["、"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":12,"text":"ダビデはユダのベツレヘムのエフラテ人でエッサイという名の人の息子であった。エッサイには八人の息子がいた。この人はサウルの時代には、年をとって老人になっていた。","tok":[["ダビデ"],["は"],["ユダ"],["の"],["ベツレヘム"],["の"],["エフラテ"],["人","にん"],["で"],["エッサイ"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["の"],["息子","むすこ"],["で"],["あった"],["。"],["エッサイ"],["に"],["は"],["八人","はちにん"],["の"],["息子","むすこ"],["が"],["いた"],["。"],["この"],["人","ひと"],["は"],["サウル"],["の"],["時代","じだい"],["に"],["は"],["、"],["年","とし"],["を"],["とって"],["老人","ろうじん"],["に"],["なって"],["いた"],["。"]]},{"verse":13,"text":"エッサイの上の三人の息子たちは、サウルに従って戦いに出て行った。戦いに行った三人の息子の名は、長男エリアブ、次男アビナダブ、三男シャマであった。","tok":[["エッサイ"],["の"],["上","うえ"],["の"],["三人","さんにん"],["の"],["息子","むすこ"],["たち"],["は"],["、"],["サウル"],["に"],["従って","したがって"],["戦い","たたかい"],["に"],["出て","でて"],["行った","いった"],["。"],["戦い","たたかい"],["に"],["行った","いった"],["三人","さんにん"],["の"],["息子","むすこ"],["の"],["名","な"],["は"],["、"],["長男","ちょうなん"],["エリアブ"],["、"],["次男","じなん"],["アビナダブ"],["、"],["三男","さんなん"],["シャマ"],["で"],["あった"],["。"]]},{"verse":14,"text":"ダビデは末っ子で、上の三人がサウルに従って出ていた。","tok":[["ダビデ"],["は"],["末っ子","すえっこ"],["で"],["、"],["上","うえ"],["の"],["三人","さんにん"],["が"],["サウル"],["に"],["従って","したがって"],["出て","でて"],["いた"],["。"]]},{"verse":15,"text":"ダビデは、サウルのところへ行ったり、帰ったりしていた。ベツレヘムの父の羊を飼うためであった。","tok":[["ダビデ"],["は"],["、"],["サウル"],["の"],["ところ"],["へ"],["行っ","いっ"],["たり"],["、"],["帰っ","かえっ"],["たり"],["して"],["いた"],["。"],["ベツレヘム"],["の"],["父","ちち"],["の"],["羊","ひつじ"],["を"],["飼う","かう"],["ため"],["で"],["あった"],["。"]]},{"verse":16,"text":"例のペリシテ人は、四十日間、朝早くと夕暮れに出て来て姿を現した。","tok":[["例","れい"],["の"],["ペリシテ"],["人","にん"],["は"],["、"],["四十日間","しとかかん"],["、"],["朝","あさ"],["早く","はやく"],["と"],["夕暮れ","ゆうぐれ"],["に"],["出て","でて"],["来て","きて"],["姿","すがた"],["を"],["現した","あらわした"],["。"]]},{"verse":17,"text":"エッサイは息子のダビデに言った。「さあ、兄さんたちのために、この炒り麦一エパと、このパン十個を取り、兄さんたちの陣営に急いで持って行きなさい。","tok":[["エッサイ"],["は"],["息子","むすこ"],["の"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["兄さん","にいさん"],["たち"],["の"],["ため"],["に"],["、"],["この"],["炒り","いり"],["麦","むぎ"],["一","いち"],["エパ"],["と"],["、"],["この"],["パン"],["十個","じゅうこ"],["を"],["取り","とり"],["、"],["兄さん","にいさん"],["たち"],["の"],["陣営","じんえい"],["に"],["急いで","いそいで"],["持って","もって"],["行き","いき"],["なさい"],["。"]]},{"verse":18,"text":"この十個のチーズは千人隊の長に届け、兄さんたちの安否を調べなさい。そしてしるしを持って来なさい。","tok":[["この"],["十個","じゅうこ"],["の"],["チーズ"],["は"],["千人隊","せんにんたい"],["の"],["長","ちょう"],["に"],["届け","とどけ"],["、"],["兄さん","にいさん"],["たち"],["の"],["安否","あんぴ"],["を"],["調べ","しらべ"],["なさい"],["。"],["そして"],["しるし"],["を"],["持って","もって"],["来","き"],["なさい"],["。"]]},{"verse":19,"text":"サウルと兄さんたち、それにイスラエルの人たちはみな、エラの谷でペリシテ人と戦っているのだから。」","tok":[["サウル"],["と"],["兄さん","にいさん"],["たち"],["、"],["それ"],["に"],["イスラエル"],["の"],["人","ひと"],["たち"],["は"],["みな"],["、"],["エラ"],["の"],["谷","たに"],["で"],["ペリシテ"],["人","にん"],["と"],["戦って","たたかって"],["いる"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":20,"text":"ダビデは翌朝早く、羊を番人に預け、エッサイが命じたとおりに、品物を持って出かけた。彼が野営地に来ると、軍勢はときの声をあげて、陣地に出るところであった。","tok":[["ダビデ"],["は"],["翌朝","よくあさ"],["早く","はやく"],["、"],["羊","ひつじ"],["を"],["番人","ばんにん"],["に"],["預け","あずけ"],["、"],["エッサイ"],["が"],["命じた","めいじた"],["とおり"],["に"],["、"],["品物","しなもの"],["を"],["持って","もって"],["出かけた","でかけた"],["。"],["彼","かれ"],["が"],["野営","やえい"],["地","ち"],["に"],["来る","くる"],["と"],["、"],["軍勢","ぐんぜい"],["は"],["とき"],["の"],["声","こえ"],["を"],["あげて"],["、"],["陣地","じんち"],["に"],["出る","でる"],["ところ"],["で"],["あった"],["。"]]},{"verse":21,"text":"イスラエル人とペリシテ人とは、それぞれ向かい合って陣を敷いていた。","tok":[["イスラエル"],["人","にん"],["と"],["ペリシテ"],["人","にん"],["と"],["は"],["、"],["それぞれ"],["向かい合って","むかいあって"],["陣","じん"],["を"],["敷いて","しいて"],["いた"],["。"]]},{"verse":22,"text":"ダビデは、その品物を武器を守る者に預け、陣地に走って行き、兄たちの安否を尋ねた。","tok":[["ダビデ"],["は"],["、"],["その"],["品物","しなもの"],["を"],["武器","ぶき"],["を"],["守る","まもる"],["者","もの"],["に"],["預け","あずけ"],["、"],["陣地","じんち"],["に"],["走って","はしって"],["行き","いき"],["、"],["兄たち","あにたち"],["の"],["安否","あんぴ"],["を"],["尋ねた","たずねた"],["。"]]},{"verse":23,"text":"ダビデが兄たちと話していると、ちょうどその時、ガテのペリシテ人で、その名をゴリヤテという代表戦士が、ペリシテ人の陣地から上って来て、いつもと同じ文句をくり返した。ダビデはこれを聞いた。","tok":[["ダビデ"],["が"],["兄たち","あにたち"],["と"],["話して","はなして"],["いる"],["と"],["、"],["ちょうど"],["その"],["時","とき"],["、"],["ガテ"],["の"],["ペリシテ"],["人","にん"],["で"],["、"],["その"],["名","な"],["を"],["ゴリヤテ"],["と"],["いう"],["代表","だいひょう"],["戦士","せんし"],["が"]
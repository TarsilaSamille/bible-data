[{"verse":1,"text":"主はサムエルに仰せられた。「いつまであなたはサウルのことで悲しんでいるのか。わたしは彼をイスラエルの王位から退けている。角に油を満たして行け。あなたをベツレヘム人エッサイのところへ遣わす。わたしは彼の息子たちの中に、わたしのために、王を見つけたから。」","tok":[["主","ぬし"],["は"],["サムエル"],["に"],["仰せられた","おおせられた"],["。"],["「"],["いつ"],["まで"],["あなた"],["は"],["サウル"],["の"],["こと"],["で"],["悲しんで","かなしんで"],["いる"],["の"],["か"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["イスラエル"],["の"],["王位","おうい"],["から"],["退けて","しりぞけて"],["いる"],["。"],["角","かど"],["に"],["油","あぶら"],["を"],["満たして","みたして"],["行け","いけ"],["。"],["あなた"],["を"],["ベツレヘム"],["人","にん"],["エッサイ"],["の"],["ところ"],["へ"],["遣わす","つかわす"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["息子","むすこ"],["たち"],["の"],["中","なか"],["に"],["、"],["わたし"],["の"],["ため"],["に"],["、"],["王","おう"],["を"],["見つけた","みつけた"],["から"],["。"],["」"]]},{"verse":2,"text":"サムエルは言った。「私はどうして行けましょう。サウルが聞いたら、私を殺すでしょう。」主は仰せられた。「あなたは群れのうちから一頭の雌の子牛を取り、『主にいけにえをささげに行く』と言え。","tok":[["サムエル"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["どう"],["して"],["行けましょう","いけましょう"],["。"],["サウル"],["が"],["聞いたら","きいたら"],["、"],["私","わたくし"],["を"],["殺すでしょう","ころすでしょう"],["。"],["」"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["群れ","むれ"],["の"],["うち"],["から"],["一頭","いちとう"],["の"],["雌","めす"],["の"],["子牛","こうし"],["を"],["取り","とり"],["、"],["『"],["主に","おもに"],["いけにえ"],["を"],["ささげ"],["に"],["行く","いく"],["』"],["と"],["言え","いえ"],["。"]]},{"verse":3,"text":"いけにえをささげるときに、エッサイを招け。あなたのなすべきことを、このわたしが教えよう。あなたはわたしのために、わたしが言う人に油をそそげ。」","tok":[["いけにえ"],["を"],["ささげる"],["とき"],["に"],["、"],["エッサイ"],["を"],["招け","まねけ"],["。"],["あなた"],["の"],["なすべき"],["こと"],["を"],["、"],["この"],["わたし"],["が"],["教えよう","おしえよう"],["。"],["あなた"],["は"],["わたし"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["言う","いう"],["人","ひと"],["に"],["油","あぶら"],["を"],["そそげ"],["。"],["」"]]},{"verse":4,"text":"サムエルは主が告げられたとおりにして、ベツレヘムへ行った。すると町の長老たちは恐れながら彼を迎えて言った。「平和なことでおいでになったのですか。」","tok":[["サムエル"],["は"],["主","ぬし"],["が"],["告げられた","つげられた"],["とおり"],["に"],["して"],["、"],["ベツレヘム"],["へ"],["行った","いった"],["。"],["する"],["と"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["は"],["恐れ","おそれ"],["ながら"],["彼","かれ"],["を"],["迎えて","むかえて"],["言った","いった"],["。"],["「"],["平和","へいわ"],["な"],["こと"],["で"],["おいで"],["に"],["なった"],["の"],["です"],["か"],["。"],["」"]]},{"verse":5,"text":"サムエルは答えた。「平和なことです。主にいけにえをささげるために来ました。私がいけにえをささげるとき、あなたがたは身を聖別して私といっしょに来なさい。」こうして、サムエルはエッサイとその子たちを聖別し、彼らを、いけにえをささげるために招いた。","tok":[["サムエル"],["は"],["答えた","こたえた"],["。"],["「"],["平和","へいわ"],["な"],["こと"],["です"],["。"],["主に","おもに"],["いけにえ"],["を"],["ささげる"],["ため"],["に"],["来ました","きました"],["。"],["私","わたくし"],["が"],["いけにえ"],["を"],["ささげる"],["とき"],["、"],["あなた"],["がた"],["は"],["身","み"],["を"],["聖別","せいべつ"],["して"],["私","わたくし"],["と"],["いっしょ"],["に"],["来","き"],["なさい"],["。"],["」"],["こう"],["して"],["、"],["サムエル"],["は"],["エッサイ"],["と"],["その"],["子","こ"],["たち"],["を"],["聖別","せいべつ"],["し"],["、"],["彼","かれ"],["ら"],["を"],["、"],["いけにえ"],["を"],["ささげる"],["ため"],["に"],["招いた","まねいた"],["。"]]},{"verse":6,"text":"彼らが来たとき、サムエルはエリアブを見て、「確かに、主の前で油をそそがれる者だ」と思った。","tok":[["彼","かれ"],["ら"],["が"],["来た","きた"],["とき"],["、"],["サムエル"],["は"],["エリアブ"],["を"],["見て","みて"],["、"],["「"],["確か","たしか"],["に"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["油","あぶら"],["を"],["そそがれる"],["者","もの"],["だ"],["」"],["と"],["思った","おもった"],["。"]]},{"verse":7,"text":"しかし主はサムエルに仰せられた。「彼の容貌や、背の高さを見てはならない。わたしは彼を退けている。人が見るようには見ないからだ。人はうわべを見るが、主は心を見る。」","tok":[["しかし"],["主","ぬし"],["は"],["サムエル"],["に"],["仰せられた","おおせられた"],["。"],["「"],["彼","かれ"],["の"],["容貌","ようぼう"],["や"],["、"],["背","せ"],["の"],["高さ","たかさ"],["を"],["見て","みて"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["退けて","しりぞけて"],["いる"],["。"],["人","ひと"],["が"],["見る","みる"],["よう"],["に"],["は"],["見ない","みない"],["から"],["だ"],["。"],["人","ひと"],["は"],["うわべ"],["を"],["見る","みる"],["が"],["、"],["主","ぬし"],["は"],["心","こころ"],["を"],["見る","みる"],["。"],["」"]]},{"verse":8,"text":"エッサイはアビナダブを呼んで、サムエルの前に進ませた。サムエルは、「この者もまた、主は選んでおられない」と言った。","tok":[["エッサイ"],["は"],["アビナダブ"],["を"],["呼んで","よんで"],["、"],["サムエル"],["の"],["前","まえ"],["に"],["進ませた","すすませた"],["。"],["サムエル"],["は"],["、"],["「"],["この"],["者","もの"],["も"],["また"],["、"],["主","ぬし"],["は"],["選んで","えらんで"],["おられない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"エッサイはシャマを進ませたが、サムエルは、「この者もまた、主は選んではおられない」と言った。","tok":[["エッサイ"],["は"],["シャマ"],["を"],["進ませた","すすませた"],["が"],["、"],["サムエル"],["は"],["、"],["「"],["この"],["者","もの"],["も"],["また"],["、"],["主","ぬし"],["は"],["選んで","えらんで"],["は"],["おられない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"こうしてエッサイは七人の息子をサムエルの前に進ませたが、サムエルはエッサイに言った。「主はこの者たちを選んではおられない。」","tok":[["こう"],["して"],["エッサイ"],["は"],["七人","ななにん"],["の"],["息子","むすこ"],["を"],["サムエル"],["の"],["前","まえ"],["に"],["進ませた","すすませた"],["が"],["、"],["サムエル"],["は"],["エッサイ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["この"],["者","もの"],["たち"],["を"],["選んで","えらんで"],["は"],["おられない"],["。"],["」"]]},{"verse":11,"text":"サムエルはエッサイに言った。「子どもたちはこれで全部ですか。」エッサイは答えた。「まだ末の子が残っています。あれは今、羊の番をしています。」サムエルはエッサイに言った。「人をやって、その子を連れて来なさい。その子がここに来るまで、私たちは座に着かないから。」","tok":[["サムエル"],["は"],["エッサイ"],["に"],["言った","いった"],["。"],["「"],["子ども","こども"],["たち"],["は"],["これ"],["で"],["全部","ぜんぶ"],["です"],["か"],["。"],["」"],["エッサイ"],["は"],["答えた","こたえた"],["。"],["「"],["まだ"],["末","すえ"],["の"],["子","こ"],["が"],["残って","のこって"],["います"],["。"],["あれ"],["は"],["今","いま"],["、"],["羊","ひつじ"],["の"],["番","ばん"],["を"],["して"],["います"],["。"],["」"],["サムエル"],["は"],["エッサイ"],["に"],["言った","いった"],["。"],["「"],["人","ひと"],["を"],["やって"],["、"],["その"],["子","こ"],["を"],["連れて","つれて"],["来","き"],["なさい"],["。"],["その"],["子","こ"],["が"],["ここ"],["に"],["来る","くる"],["まで"],["、"],["私たち","わたしたち"],["は"],["座","ざ"],["に"],["着かない","つかない"],["から"],["。"],["」"]]},{"verse":12,"text":"エッサイは人をやって、彼を連れて来させた。その子は血色の良い顔で、目が美しく、姿もりっぱだった。主は仰せられた。「さあ、この者に油をそそげ。この者がそれだ。」","tok":[["エッサイ"],["は"],["人","ひと"],["を"],["やって"],["、"],["彼","かれ"],["を"],["連れて","つれて"],["来させた","きさせた"],["。"],["その"],["子","こ"],["は"],["血色","けっしょく"],["の"],["良い","よい"],["顔","かお"],["で"],["、"],["目","め"],["が"],["美しく","うつくしく"],["、"],["姿","すがた"],["も"],["りっぱ"],["だった"],["。"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["さあ"],["、"],["この"],["者","もの"],["に"],["油","あぶら"],["を"],["そそげ"],["。"],["この"],["者","もの"],["が"],["それ"],["だ"],["。"],["」"]]},{"verse":13,"text":"サムエルは油の角を取り、兄弟たちの真ん中で彼に油をそそいだ。主の霊がその日以来、ダビデの上に激しく下った。サムエルは立ち上がってラマへ帰った。","tok":[["サムエル"],["は"],["油","あぶら"],["の"],["角","かど"],["を"],["取り","とり"],["、"],["兄弟","きょうだい"],["たち"],["の"],["真ん中","まんなか"],["で"],["彼","かれ"],["に"],["油","あぶら"],["を"],["そそいだ"],["。"],["主","ぬし"],["の"],["霊","れい"],["が"],["その"],["日","ひ"],["以来","いらい"],["、"],["ダビデ"],["の"],["上","うえ"],["に"],["激しく","はげしく"],["下った","くだった"],["。"],["サムエル"],["は"],["立ち上がって","たちあがって"],["ラマ"],["へ"],["帰った","かえった"],["。"]]},{"verse":14,"text":"主の霊はサウルを離れ、主からの、わざわいの霊が彼をおびえさせた。","tok":[["主","ぬし"],["の"],["霊","れい"],["は"],["サウル"],["を"],["離れ","はなれ"],["、"],["主","ぬし"],["から"],["の"],["、"],["わざわい"],["の"],["霊","れい"],["が"],["彼","かれ"],["を"],["おびえさせた"],["。"]]},{"verse":15,"text":"そこでサウルの家来たちは彼に言った。「ご覧ください。わざわいをもたらす、神の霊があなたをおびえさせているのです。","tok":[["そこ"],["で"],["サウル"],["の"],["家来","けらい"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["ください"],["。"],["わざわい"],["を"],["もたらす"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["あなた"],["を"],["おびえさせて"],["いる"],["の"],["です"],["。"]]},{"verse":16,"text":"わが君。どうか御前にはべるこの家来どもに命じて、じょうずに立琴をひく者を捜させてください。わざわいをもたらす、神の霊があなたに臨むとき、その者が琴をひけば、あなたは良くなられるでしょう。」","tok":[["わが"],["君","きみ"],["。"],["どう"],["か"],["御前","ごぜん"],["に"],["はべる"],["この"],["家来","けらい"],["ども"],["に"],["命じて","めいじて"],["、"],["じょうず"],["に"],["立琴","たてごと"],["を"],["ひく"],["者","もの"],["を"],["捜させて","さがさせて"],["ください"],["。"],["わざわい"],["を"],["もたらす"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["あなた"],["に"],["臨む","のぞむ"],["とき"],["、"],["その"],["者","もの"],["が"],["琴","こと"],["を"],["ひけば"],["、"],["あなた"],["は"],["良く","よく"],["なられるでしょう"],["。"],["」"]]},{"verse":17,"text":"そこでサウルは家来たちに言った。「どうか、私のためにじょうずなひき手を見つけて、私のところに連れて来てくれ。」","tok":[["そこ"],["で"],["サウル"],["は"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["私","わたくし"],["の"],["ため"],["に"],["じょうず"],["な"],["ひき"],["手","て"],["を"],["見つけて","みつけて"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["連れて","つれて"],["来て","きて"],["くれ"],["。"],["」"]]},{"verse":18,"text":"すると、若者のひとりが答えて言った。「おります。私はベツレヘム人エッサイの息子を見たことがあります。琴がじょうずで勇士であり、戦士です。ことばには分別があり、体格も良い人です。主がこの人とともにおられます。」","tok":[["する"],["と"],["、"],["若者","わかもの"],["の"],["ひとり"],["が"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["おります"],["。"],["私","わたくし"],["は"],["ベツレヘム"],["人","にん"],["エッサイ"],["の"],["息子","むすこ"],["を"],["見た","みた"],["こと"],["が"],["あります"],["。"],["琴","こと"],["が"],["じょうず"],["で"],["勇士","ゆうし"],["で"],["あり"],["、"],["戦士","せんし"],["です"],["。"],["ことば"],["に"],["は"],["分別","ぶんべつ"],["が"],["あり"],["、"],["体格","たいかく"],["も"],["良い","よい"],["人","ひと"],["です"],["。"],["主","ぬし"],["が"],["この"],["人","ひと"],["と"],["とも"],["に"],["おられます"],["。"],["」"]]},{"verse":19,"text":"そこでサウルは使いをエッサイのところに遣わし、「羊の番をしているあなたの子ダビデを私のところによこしてください」と言わせた。","tok":[["そこ"],["で"],["サウル"],["は"],["使い","つかい"],["を"],["エッサイ"],["の"],["ところ"],["に"],["遣わし","つかわし"],["、"],["「"],["羊","ひつじ"],["の"],["番","ばん"],["を"],["して"],["いる"],["あなた"],["の"],["子","こ"],["ダビデ"],["を"],["私","わたくし"],["の"],["ところ"],["に"],["よこして"],["ください"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":20,"text":"それでエッサイは、ろば一頭分のパンと、ぶどう酒の皮袋一つ、子やぎ一匹を取り、息子ダビデに託して、これをサウルに送った。","tok":[["それ"],["で"],["エッサイ"],["は"],["、"],["ろば"],["一頭","いちとう"],["分","ぶん"],["の"],["パン"],["と"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["皮袋","かわぶくろ"],["一","ひと"],["つ"],["、"],["子やぎ","こやぎ"],["一匹","いちひき"],["を"],["取り","とり"],["、"],["息子","むすこ"],["ダビデ"],["に"],["託して","たくして"],["、"],["これ"],["を"],["サウル"],["に"],["送った","おくった"],["。"]]},{"verse":21,"text":"ダビデはサウルのもとに来て、彼に仕えた。サウルは彼を非常に愛し、ダビデはサウルの道具持ちとなった。","tok":[["ダビデ"],["は"],["サウル"],["の"],["もと"],["に"],["来て","きて"],["、"],["彼","かれ"],["に"],["仕えた","つかえた"],["。"],["サウル"],["は"],["彼","かれ"],["を"],["非常","ひじょう"],["に"],["愛し","あいし"],["、"],["ダビデ"],["は"],["サウル"],["の"],["道具持ち","どうぐもち"],["と"],["なった"],["。"]]},{"verse":22,"text":"サウルはエッサイのところに人をやり、「どうか、ダビデを私に仕えさせてください。私の気に入ったから」と言わせた。","tok":[["サウル"],["は"],["エッサイ"],["の"],["ところ"],["に"],["人","ひと"],["を"],["やり"],["、"],["「"],["どう"],["か"],["、"],["ダビデ"],["を"],["私","わたくし"],["に"],["仕えさせて","つかえさせて"],["ください"],["。"],["私","わたくし"],["の"],["気","き"],["に"],["入った","いった"],["から"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":23,"text":"神の霊がサウルに臨むたびに、ダビデは立琴を手に取って、ひき、サウルは元気を回復して、良くなり、わざわいの霊は彼から離れた。","tok":[["神","かみ"],["の"],["霊","れい"],["が"],["サウル"],["に"],["臨む","のぞむ"],["たび"],["に"],["、"],["ダビデ"],["は"],["立琴","たてごと"],["を"],["手","て"],["に"],["取って","とって"],["、"],["ひき"],["、"],["サウル"],["は"],["元気","げんき"],["を"],["回復","かいふく"],["して"],["、"],["良く","よく"],["なり"],["、"],["わざわい"],["の"],["霊","れい"],["は"],["彼","かれ"],["から"],["離れた","はなれた"],["。"]]}]
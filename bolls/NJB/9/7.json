[{"verse":1,"text":"キルヤテ・エアリムの人々は来て、主の箱を運び上げ、それを丘の上のアビナダブの家に運び、彼の子エルアザルを聖別して、主の箱を守らせた。","tok":[["キルヤテ"],["・"],["エアリム"],["の"],["人々","ひとびと"],["は"],["来て","きて"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["運び上げ","はこびあげ"],["、"],["それ"],["を"],["丘","おか"],["の"],["上","うえ"],["の"],["アビナダブ"],["の"],["家","いえ"],["に"],["運び","はこび"],["、"],["彼","かれ"],["の"],["子","こ"],["エルアザル"],["を"],["聖別","せいべつ"],["して"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["守らせた","まもらせた"],["。"]]},{"verse":2,"text":"その箱がキルヤテ・エアリムにとどまった日から長い年月がたって、二十年になった。イスラエルの全家は主を慕い求めていた。","tok":[["その"],["箱","ばこ"],["が"],["キルヤテ"],["・"],["エアリム"],["に"],["とどまった"],["日","ひ"],["から"],["長い","ながい"],["年月","としつき"],["が"],["たって"],["、"],["二十","にじゅう"],["年","ねん"],["に"],["なった"],["。"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["は"],["主","ぬし"],["を"],["慕い求めて","したいもとめて"],["いた"],["。"]]},{"verse":3,"text":"そのころ、サムエルはイスラエルの全家に次のように言った。「もし、あなたがたが心を尽くして主に帰り、あなたがたの間から外国の神々やアシュタロテを取り除き、心を主に向け、主にのみ仕えるなら、主はあなたがたをペリシテ人の手から救い出されます。」","tok":[["その"],["ころ"],["、"],["サムエル"],["は"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["に"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"],["「"],["もし"],["、"],["あなた"],["がた"],["が"],["心","こころ"],["を"],["尽くして","つくして"],["主に","おもに"],["帰り","かえり"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["から"],["外国","がいこく"],["の"],["神々","かみがみ"],["や"],["アシュタロテ"],["を"],["取り除き","とりのぞき"],["、"],["心","こころ"],["を"],["主に","おもに"],["向け","むけ"],["、"],["主に","おもに"],["のみ"],["仕えるなら","つかえるなら"],["、"],["主","ぬし"],["は"],["あなた"],["がた"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["救い出されます","すくいだされます"],["。"],["」"]]},{"verse":4,"text":"そこでイスラエル人は、バアルやアシュタロテを取り除き、主にのみ仕えた。","tok":[["そこ"],["で"],["イスラエル"],["人","にん"],["は"],["、"],["バアル"],["や"],["アシュタロテ"],["を"],["取り除き","とりのぞき"],["、"],["主に","おもに"],["のみ"],["仕えた","つかえた"],["。"]]},{"verse":5,"text":"それで、サムエルは言った。「イスラエル人をみな、ミツパに集めなさい。私はあなたがたのために主に祈りましょう。」","tok":[["それ"],["で"],["、"],["サムエル"],["は"],["言った","いった"],["。"],["「"],["イスラエル"],["人","にん"],["を"],["みな"],["、"],["ミツパ"],["に"],["集め","あつめ"],["なさい"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["主","ぬし"],["に"],["祈りましょう","いのりましょう"],["。"],["」"]]},{"verse":6,"text":"彼らはミツパに集まり、水を汲んで主の前に注ぎ、その日は断食した。そうして、その所で言った。「私たちは主に対して罪を犯しました。」こうしてサムエルはミツパでイスラエル人をさばいた。","tok":[["彼","かれ"],["ら"],["は"],["ミツパ"],["に"],["集まり","あつまり"],["、"],["水","みず"],["を"],["汲んで","くんで"],["主","ぬし"],["の"],["前","まえ"],["に"],["注ぎ","そそぎ"],["、"],["その"],["日","ひ"],["は"],["断食","だんじき"],["した"],["。"],["そう"],["して"],["、"],["その"],["所","ところ"],["で"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["主に","おもに"],["対して","たいして"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["」"],["こう"],["して"],["サムエル"],["は"],["ミツパ"],["で"],["イスラエル"],["人","にん"],["を"],["さばいた"],["。"]]},{"verse":7,"text":"イスラエル人がミツパに集まったことをペリシテ人が聞いたとき、ペリシテ人の領主たちはイスラエルに攻め上った。イスラエル人はこれを聞いて、ペリシテ人を恐れた。","tok":[["イスラエル"],["人","にん"],["が"],["ミツパ"],["に"],["集まった","あつまった"],["こと"],["を"],["ペリシテ"],["人","にん"],["が"],["聞いた","きいた"],["とき"],["、"],["ペリシテ"],["人","にん"],["の"],["領主","りょうしゅ"],["たち"],["は"],["イスラエル"],["に"],["攻め上った","せめのぼった"],["。"],["イスラエル"],["人","にん"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["ペリシテ"],["人","にん"],["を"],["恐れた","おそれた"],["。"]]},{"verse":8,"text":"そこでイスラエル人はサムエルに言った。「私たちの神、主に叫ぶのをやめないでください。私たちをペリシテ人の手から救ってくださるように。」","tok":[["そこ"],["で"],["イスラエル"],["人","にん"],["は"],["サムエル"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["叫ぶ","さけぶ"],["の"],["を"],["やめないで"],["ください"],["。"],["私たち","わたしたち"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["救って","すくって"],["くださる"],["よう"],["に"],["。"],["」"]]},{"verse":9,"text":"サムエルは乳離れしていない子羊一頭を取り、焼き尽くす全焼のいけにえとして主にささげた。サムエルはイスラエルのために主に叫んだ。それで主は彼に答えられた。","tok":[["サムエル"],["は"],["乳離れ","ちばなれ"],["して"],["いない"],["子羊","こひつじ"],["一頭","いちとう"],["を"],["取り","とり"],["、"],["焼き","やき"],["尽くす","つくす"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["主に","おもに"],["ささげた"],["。"],["サムエル"],["は"],["イスラエル"],["の"],["ため"],["に"],["主に","おもに"],["叫んだ","さけんだ"],["。"],["それ"],["で"],["主","ぬし"],["は"],["彼","かれ"],["に"],["答えられた","こたえられた"],["。"]]},{"verse":10,"text":"サムエルが全焼のいけにえをささげていたとき、ペリシテ人がイスラエルと戦おうとして近づいて来たが、主はその日、ペリシテ人の上に、大きな雷鳴をとどろかせ、彼らをかき乱したので、彼らはイスラエル人に打ち負かされた。","tok":[["サムエル"],["が"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげて"],["いた"],["とき"],["、"],["ペリシテ"],["人","にん"],["が"],["イスラエル"],["と"],["戦おう","たたかおう"],["として"],["近づいて","ちかづいて"],["来た","きた"],["が"],["、"],["主","ぬし"],["は"],["その"],["日","ひ"],["、"],["ペリシテ"],["人","にん"],["の"],["上","うえ"],["に"],["、"],["大きな","おおきな"],["雷鳴","らいめい"],["を"],["とどろかせ"],["、"],["彼","かれ"],["ら"],["を"],["かき乱した","かきみだした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["人","にん"],["に"],["打ち負かされた","うちまかされた"],["。"]]},{"verse":11,"text":"イスラエルの人々は、ミツパから出て、ペリシテ人を追い、彼らを打って、ベテ・カルの下にまで行った。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["ミツパ"],["から"],["出て","でて"],["、"],["ペリシテ"],["人","にん"],["を"],["追い","おい"],["、"],["彼","かれ"],["ら"],["を"],["打って","うって"],["、"],["ベテ"],["・"],["カル"],["の"],["下","した"],["に"],["まで"],["行った","いった"],["。"]]},{"verse":12,"text":"そこでサムエルは一つの石を取り、それをミツパとシェンの間に置き、それにエベン・エゼルという名をつけ、「ここまで主が私たちを助けてくださった」と言った。","tok":[["そこ"],["で"],["サムエル"],["は"],["一","ひと"],["つ"],["の"],["石","いし"],["を"],["取り","とり"],["、"],["それ"],["を"],["ミツパ"],["と"],["シェン"],["の"],["間","あいだ"],["に"],["置き","おき"],["、"],["それ"],["に"],["エベン"],["・"],["エゼル"],["と"],["いう"],["名","な"],["を"],["つけ"],["、"],["「"],["ここ"],["まで"],["主","ぬし"],["が"],["私たち","わたしたち"],["を"],["助けて","たすけて"],["くださった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"こうしてペリシテ人は征服され、二度とイスラエルの領内に、入って来なかった。サムエルの生きている間、主の手がペリシテ人を防いでいた。","tok":[["こう"],["して"],["ペリシテ"],["人","にん"],["は"],["征服","せいふく"],["され"],["、"],["二","に"],["度","ど"],["と"],["イスラエル"],["の"],["領内","りょうない"],["に"],["、"],["入って","はいって"],["来なかった","こなかった"],["。"],["サムエル"],["の"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["主","ぬし"],["の"],["手","て"],["が"],["ペリシテ"],["人","にん"],["を"],["防いで","ふせいで"],["いた"],["。"]]},{"verse":14,"text":"ペリシテ人がイスラエルから奪った町々は、エクロンからガテまで、イスラエルに戻った。イスラエルはペリシテ人の手から、領土を解放した。そのころ、イスラエル人とエモリ人の間には平和があった。","tok":[["ペリシテ"],["人","にん"],["が"],["イスラエル"],["から"],["奪った","うばった"],["町々","まちまち"],["は"],["、"],["エクロン"],["から"],["ガテ"],["まで"],["、"],["イスラエル"],["に"],["戻った","もどった"],["。"],["イスラエル"],["は"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["、"],["領土","りょうど"],["を"],["解放","かいほう"],["した"],["。"],["その"],["ころ"],["、"],["イスラエル"],["人","にん"],["と"],["エモリ人","えもりにん"],["の"],["間","あいだ"],["に"],["は"],["平和","へいわ"],["が"],["あった"],["。"]]},{"verse":15,"text":"サムエルは、一生の間、イスラエルをさばいた。","tok":[["サムエル"],["は"],["、"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":16,"text":"彼は毎年、ベテル、ギルガル、ミツパを巡回し、それらの地でイスラエルをさばき、","tok":[["彼","かれ"],["は"],["毎年","まいとし"],["、"],["ベテル"],["、"],["ギルガル"],["、"],["ミツパ"],["を"],["巡回","じゅんかい"],["し"],["、"],["それ"],["ら"],["の"],["地","ち"],["で"],["イスラエル"],["を"],["さばき"],["、"]]},{"verse":17,"text":"ラマに帰った。そこに自分の家があったからである。彼はそこでイスラエルをさばいた。彼はまた、そこに主のために一つの祭壇を築いた。","tok":[["ラマ"],["に"],["帰った","かえった"],["。"],["そこ"],["に"],["自分","じぶん"],["の"],["家","いえ"],["が"],["あった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["そこ"],["で"],["イスラエル"],["を"],["さばいた"],["。"],["彼","かれ"],["は"],["また"],["、"],["そこ"],["に"],["主","ぬし"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]}]
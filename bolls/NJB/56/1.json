[{"verse":1,"text":"神のしもべ、また、イエス・キリストの使徒パウロ――私は、神に選ばれた人々の信仰と、敬虔にふさわしい真理の知識とのために使徒とされたのです。","tok":[["神","かみ"],["の"],["しもべ"],["、"],["また"],["、"],["イエス"],["・"],["キリスト"],["の"],["使徒","しと"],["パウロ"],["―"],["―"],["私","わたくし"],["は"],["、"],["神","かみ"],["に"],["選ばれた","えらばれた"],["人々","ひとびと"],["の"],["信仰","しんこう"],["と"],["、"],["敬虔","けいけん"],["に"],["ふさわしい"],["真理","しんり"],["の"],["知識","ちしき"],["と"],["の"],["ため"],["に"],["使徒","しと"],["と"],["された"],["の"],["です"],["。"]]},{"verse":2,"text":"それは、偽ることのない神が、永遠の昔から約束してくださった永遠のいのちの望みに基づくことです。","tok":[["それ"],["は"],["、"],["偽る","いつわる"],["こと"],["の"],["ない"],["神","かみ"],["が"],["、"],["永遠","えいえん"],["の"],["昔","むかし"],["から"],["約束","やくそく"],["して"],["くださった"],["永遠","えいえん"],["の"],["いのち"],["の"],["望み","のぞみ"],["に"],["基づく","もとづく"],["こと"],["です"],["。"]]},{"verse":3,"text":"神は、ご自分の定められた時に、このみことばを宣教によって明らかにされました。私は、この宣教を私たちの救い主なる神の命令によって、ゆだねられたのです――このパウロから、","tok":[["神","かみ"],["は"],["、"],["ご自分","ごじぶん"],["の"],["定められた","さだめられた"],["時","とき"],["に"],["、"],["この"],["みことば"],["を"],["宣教","せんきょう"],["によって"],["明らか","あきらか"],["に"],["されました"],["。"],["私","わたくし"],["は"],["、"],["この"],["宣教","せんきょう"],["を"],["私たち","わたしたち"],["の"],["救い主","すくいぬし"],["なる"],["神","かみ"],["の"],["命令","めいれい"],["によって"],["、"],["ゆだねられた"],["の"],["です"],["―"],["―"],["この"],["パウロ"],["から"],["、"]]},{"verse":4,"text":"同じ信仰による真実のわが子テトスへ。父なる神および私たちの救い主なるキリスト・イエスから、恵みと平安がありますように。","tok":[["同じ","おなじ"],["信仰","しんこう"],["に"],["よる"],["真実","しんじつ"],["の"],["わが"],["子","こ"],["テトス"],["へ"],["。"],["父","ちち"],["なる"],["神","かみ"],["および"],["私たち","わたしたち"],["の"],["救い主","すくいぬし"],["なる"],["キリスト"],["・"],["イエス"],["から"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["あります"],["よう"],["に"],["。"]]},{"verse":5,"text":"私があなたをクレテに残したのは、あなたが残っている仕事の整理をし、また、私が指図したように、町ごとに長老たちを任命するためでした。","tok":[["私","わたくし"],["が"],["あなた"],["を"],["クレテ"],["に"],["残した","のこした"],["の"],["は"],["、"],["あなた"],["が"],["残って","のこって"],["いる"],["仕事","しごと"],["の"],["整理","せいり"],["を"],["し"],["、"],["また"],["、"],["私","わたくし"],["が"],["指図","さしず"],["した"],["よう"],["に"],["、"],["町","まち"],["ごと"],["に"],["長老","ちょうろう"],["たち"],["を"],["任命","にんめい"],["する"],["ため"],["でした"],["。"]]},{"verse":6,"text":"それには、その人が、非難されるところがなく、ひとりの妻の夫であり、その子どもは不品行を責められたり、反抗的であったりしない信者であることが条件です。","tok":[["それ"],["に"],["は"],["、"],["その"],["人","ひと"],["が"],["、"],["非難","ひなん"],["される"],["ところ"],["が"],["なく"],["、"],["ひとり"],["の"],["妻","つま"],["の"],["夫","おっと"],["で"],["あり"],["、"],["その"],["子ども","こども"],["は"],["不品行","ふひんこう"],["を"],["責められ","せめられ"],["たり"],["、"],["反抗的","はんこうてき"],["で"],["あっ"],["たり"],["しない"],["信者","しんじゃ"],["で"],["ある"],["こと"],["が"],["条件","じょうけん"],["です"],["。"]]},{"verse":7,"text":"監督は神の家の管理者として、非難されるところのない者であるべきです。わがままでなく、短気でなく、酒飲みでなく、けんか好きでなく、不正な利を求めず、","tok":[["監督","かんとく"],["は"],["神","かみ"],["の"],["家","いえ"],["の"],["管理者","かんりしゃ"],["として"],["、"],["非難","ひなん"],["される"],["ところ"],["の"],["ない"],["者","もの"],["で"],["あるべきです"],["。"],["わがまま"],["で"],["なく"],["、"],["短気","たんき"],["で"],["なく"],["、"],["酒飲み","さけのみ"],["で"],["なく"],["、"],["けんか"],["好き","すき"],["で"],["なく"],["、"],["不正","ふせい"],["な"],["利","り"],["を"],["求めず","もとめず"],["、"]]},{"verse":8,"text":"かえって、旅人をよくもてなし、善を愛し、慎み深く、正しく、敬虔で、自制心があり、","tok":[["かえって"],["、"],["旅人","たびびと"],["を"],["よく"],["もてなし"],["、"],["善","ぜん"],["を"],["愛し","あいし"],["、"],["慎み深く","つつしみぶかく"],["、"],["正しく","ただしく"],["、"],["敬虔","けいけん"],["で"],["、"],["自制心","じせいしん"],["が"],["あり"],["、"]]},{"verse":9,"text":"教えにかなった信頼すべきみことばを、しっかりと守っていなければなりません。それは健全な教えをもって励ましたり、反対する人たちを正したりすることができるためです。","tok":[["教え","おしえ"],["に"],["かなった"],["信頼","しんらい"],["すべき"],["みことば"],["を"],["、"],["しっかり"],["と"],["守って","まもって"],["いなければ"],["なりません"],["。"],["それ"],["は"],["健全","けんぜん"],["な"],["教え","おしえ"],["を"],["もって"],["励まし","はげまし"],["たり"],["、"],["反対","はんたい"],["する"],["人","ひと"],["たち"],["を"],["正し","ただし"],["たり"],["する"],["こと"],["が"],["できる"],["ため"],["です"],["。"]]},{"verse":10,"text":"実は、反抗的な者、空論に走る者、人を惑わす者が多くいます。特に、割礼を受けた人々がそうです。","tok":[["実","じつ"],["は"],["、"],["反抗的","はんこうてき"],["な"],["者","もの"],["、"],["空論","くうろん"],["に"],["走る","はしる"],["者","もの"],["、"],["人","ひと"],["を"],["惑わす","まどわす"],["者","もの"],["が"],["多く","おおく"],["います"],["。"],["特に","とくに"],["、"],["割礼","かつれい"],["を"],["受けた","うけた"],["人々","ひとびと"],["が"],["そう"],["です"],["。"]]},{"verse":11,"text":"彼らの口を封じなければいけません。彼らは、不正な利を得るために、教えてはいけないことを教え、家々を破壊しています。","tok":[["彼","かれ"],["ら"],["の"],["口","くち"],["を"],["封じなければ","ふうじなければ"],["いけません"],["。"],["彼","かれ"],["ら"],["は"],["、"],["不正","ふせい"],["な"],["利","り"],["を"],["得る","える"],["ため"],["に"],["、"],["教えて","おしえて"],["は"],["いけない"],["こと"],["を"],["教え","おしえ"],["、"],["家々","いえいえ"],["を"],["破壊","はかい"],["して"],["います"],["。"]]},{"verse":12,"text":"彼らと同国人であるひとりの預言者がこう言いました。「クレテ人は昔からのうそつき、悪いけだもの、なまけ者の食いしんぼう。」","tok":[["彼","かれ"],["ら"],["と"],["同国人","どうこくにん"],["で"],["ある"],["ひとり"],["の"],["預言者","よげんしゃ"],["が"],["こう"],["言いました","いいました"],["。"],["「"],["クレテ人","くれてにん"],["は"],["昔","むかし"],["から"],["の"],["うそつき"],["、"],["悪い","わるい"],["けだもの"],["、"],["なまけ者","なまけもの"],["の"],["食いしんぼう","くいしんぼう"],["。"],["」"]]},{"verse":13,"text":"この証言はほんとうなのです。ですから、きびしく戒めて、人々の信仰を健全にし、","tok":[["この"],["証言","しょうげん"],["は"],["ほんとう"],["な"],["の"],["です"],["。"],["です"],["から"],["、"],["きびしく"],["戒めて","いましめて"],["、"],["人々","ひとびと"],["の"],["信仰","しんこう"],["を"],["健全","けんぜん"],["に"],["し"],["、"]]},{"verse":14,"text":"ユダヤ人の空想話や、真理から離れた人々の戒めには心を寄せないようにさせなさい。","tok":[["ユダヤ人","ゆだやじん"],["の"],["空想","くうそう"],["話","はなし"],["や"],["、"],["真理","しんり"],["から"],["離れた","はなれた"],["人々","ひとびと"],["の"],["戒め","いましめ"],["に"],["は"],["心","こころ"],["を"],["寄せない","よせない"],["よう"],["に"],["させ"],["なさい"],["。"]]},{"verse":15,"text":"きよい人々には、すべてのものがきよいのです。しかし、汚れた、不信仰な人々には、何一つきよいものはありません。それどころか、その知性と良心までも汚れています。","tok":[["きよい"],["人々","ひとびと"],["に"],["は"],["、"],["すべて"],["の"],["もの"],["が"],["きよい"],["の"],["です"],["。"],["しかし"],["、"],["汚れた","よごれた"],["、"],["不","ふ"],["信仰","しんこう"],["な"],["人々","ひとびと"],["に"],["は"],["、"],["何","なん"],["一","ひと"],["つ"],["きよい"],["もの"],["は"],["ありません"],["。"],["それ"],["どころ"],["か"],["、"],["その"],["知性","ちせい"],["と"],["良心","りょうしん"],["まで"],["も"],["汚れて","よごれて"],["います"],["。"]]},{"verse":16,"text":"彼らは、神を知っていると口では言いますが、行いでは否定しています。実に忌まわしく、不従順で、どんな良いわざにも不適格です。","tok":[["彼","かれ"],["ら"],["は"],["、"],["神","かみ"],["を"],["知って","しって"],["いる"],["と"],["口","くち"],["で"],["は"],["言います","いいます"],["が"],["、"],["行い","おこない"],["で"],["は"],["否定","ひてい"],["して"],["います"],["。"],["実","じつ"],["に"],["忌まわしく","いまわしく"],["、"],["不","ふ"],["従順","じゅうじゅん"],["で"],["、"],["どんな"],["良い","よい"],["わざ"],["に"],["も"],["不","ふ"],["適格","てきかく"],["です"],["。"]]}]
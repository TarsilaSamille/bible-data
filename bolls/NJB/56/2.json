[{"verse":1,"text":"しかし、あなたは健全な教えにふさわしいことを話しなさい。","tok":[["しかし"],["、"],["あなた"],["は"],["健全","けんぜん"],["な"],["教え","おしえ"],["に"],["ふさわしい"],["こと"],["を"],["話し","はなし"],["なさい"],["。"]]},{"verse":2,"text":"老人たちには、自制し、謹厳で、慎み深くし、信仰と愛と忍耐とにおいて健全であるように。","tok":[["老人","ろうじん"],["たち"],["に"],["は"],["、"],["自制","じせい"],["し"],["、"],["謹厳","きんげん"],["で"],["、"],["慎み深く","つつしみぶかく"],["し"],["、"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["忍耐","にんたい"],["と"],["に"],["おいて"],["健全","けんぜん"],["で"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"同じように、年をとった婦人たちには、神に仕えている者らしく敬虔にふるまい、悪口を言わず、大酒のとりこにならず、良いことを教える者であるように。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["年","とし"],["を"],["とった"],["婦人","ふじん"],["たち"],["に"],["は"],["、"],["神","かみ"],["に"],["仕えて","つかえて"],["いる"],["者","もの"],["らしく"],["敬虔","けいけん"],["に"],["ふるまい"],["、"],["悪口","わるぐち"],["を"],["言わず","いわず"],["、"],["大酒","おおざけ"],["の"],["とりこ"],["に"],["ならず"],["、"],["良い","よい"],["こと"],["を"],["教える","おしえる"],["者","もの"],["で"],["ある"],["よう"],["に"],["。"]]},{"verse":4,"text":"そうすれば、彼女たちは、若い婦人たちに向かって、夫を愛し、子どもを愛し、","tok":[["そう"],["すれば"],["、"],["彼女","かのじょ"],["たち"],["は"],["、"],["若い","わかい"],["婦人","ふじん"],["たち"],["に"],["向かって","むかって"],["、"],["夫","おっと"],["を"],["愛し","あいし"],["、"],["子ども","こども"],["を"],["愛し","あいし"],["、"]]},{"verse":5,"text":"慎み深く、貞潔で、家事に励み、優しく、自分の夫に従順であるようにと、さとすことができるのです。それは、神のことばがそしられるようなことのないためです。","tok":[["慎み深く","つつしみぶかく"],["、"],["貞潔","ていけつ"],["で"],["、"],["家事","かじ"],["に"],["励み","はげみ"],["、"],["優しく","やさしく"],["、"],["自分","じぶん"],["の"],["夫","おっと"],["に"],["従順","じゅうじゅん"],["で"],["ある"],["よう"],["に"],["と"],["、"],["さとす"],["こと"],["が"],["できる"],["の"],["です"],["。"],["それ"],["は"],["、"],["神","かみ"],["の"],["ことば"],["が"],["そしられる"],["よう"],["な"],["こと"],["の"],["ない"],["ため"],["です"],["。"]]},{"verse":6,"text":"同じように、若い人々には、思慮深くあるように勧めなさい。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["若い","わかい"],["人々","ひとびと"],["に"],["は"],["、"],["思慮","しりょ"],["深く","ふかく"],["ある"],["よう"],["に"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":7,"text":"また、すべての点で自分自身が良いわざの模範となり、教えにおいては純正で、威厳を保ち、","tok":[["また"],["、"],["すべて"],["の"],["点","てん"],["で"],["自分","じぶん"],["自身","じしん"],["が"],["良い","よい"],["わざ"],["の"],["模範","もはん"],["と"],["なり"],["、"],["教え","おしえ"],["に"],["おいて"],["は"],["純正","じゅんせい"],["で"],["、"],["威厳","いげん"],["を"],["保ち","たもち"],["、"]]},{"verse":8,"text":"非難すべきところのない、健全なことばを用いなさい。そうすれば、敵対する者も、私たちについて、何も悪いことが言えなくなって、恥じ入ることになるでしょう。","tok":[["非難","ひなん"],["すべき"],["ところ"],["の"],["ない"],["、"],["健全","けんぜん"],["な"],["ことば"],["を"],["用い","もちい"],["なさい"],["。"],["そう"],["すれば"],["、"],["敵対","てきたい"],["する"],["者","もの"],["も"],["、"],["私たち","わたしたち"],["について"],["、"],["何","なん"],["も"],["悪い","わるい"],["こと"],["が"],["言えなく","いえなく"],["なって"],["、"],["恥じ入る","はじいる"],["こと"],["に"],["なるでしょう"],["。"]]},{"verse":9,"text":"奴隷には、すべての点で自分の主人に従って、満足を与え、口答えせず、","tok":[["奴隷","どれい"],["に"],["は"],["、"],["すべて"],["の"],["点","てん"],["で"],["自分","じぶん"],["の"],["主人","しゅじん"],["に"],["従って","したがって"],["、"],["満足","まんぞく"],["を"],["与え","あたえ"],["、"],["口答え","くちごたえ"],["せず"],["、"]]},{"verse":10,"text":"盗みをせず、努めて真実を表すように勧めなさい。それは、彼らがあらゆることで、私たちの救い主である神の教えを飾るようになるためです。","tok":[["盗み","ぬすみ"],["を"],["せず"],["、"],["努めて","つとめて"],["真実","しんじつ"],["を"],["表す","あらわす"],["よう"],["に"],["勧め","すすめ"],["なさい"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["あらゆる"],["こと"],["で"],["、"],["私たち","わたしたち"],["の"],["救い主","すくいぬし"],["で"],["ある"],["神","かみ"],["の"],["教え","おしえ"],["を"],["飾る","かざる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":11,"text":"というのは、すべての人を救う神の恵みが現れ、","tok":[["と"],["いう"],["の"],["は"],["、"],["すべて"],["の"],["人","ひと"],["を"],["救う","すくう"],["神","かみ"],["の"],["恵み","めぐみ"],["が"],["現れ","あらわれ"],["、"]]},{"verse":12,"text":"私たちに、不敬虔とこの世の欲とを捨て、この時代にあって、慎み深く、正しく、敬虔に生活し、","tok":[["私たち","わたしたち"],["に"],["、"],["不","ふ"],["敬虔","けいけん"],["と"],["この世","このよ"],["の"],["欲","よく"],["と"],["を"],["捨て","すて"],["、"],["この"],["時代","じだい"],["に"],["あって"],["、"],["慎み深く","つつしみぶかく"],["、"],["正しく","ただしく"],["、"],["敬虔","けいけん"],["に"],["生活","せいかつ"],["し"],["、"]]},{"verse":13,"text":"祝福された望み、すなわち、大いなる神であり私たちの救い主であるキリスト・イエスの栄光ある現れを待ち望むようにと教えさとしたからです。","tok":[["祝福","しゅくふく"],["された"],["望み","のぞみ"],["、"],["すなわち"],["、"],["大いなる","おおいなる"],["神","かみ"],["で"],["あり"],["私たち","わたしたち"],["の"],["救い主","すくいぬし"],["で"],["ある"],["キリスト"],["・"],["イエス"],["の"],["栄光","えいこう"],["ある"],["現れ","あらわれ"],["を"],["待ち望む","まちのぞむ"],["よう"],["に"],["と"],["教えさとした","おしえさとした"],["から"],["です"],["。"]]},{"verse":14,"text":"キリストが私たちのためにご自身をささげられたのは、私たちをすべての不法から贖い出し、良いわざに熱心なご自分の民を、ご自分のためにきよめるためでした。","tok":[["キリスト"],["が"],["私たち","わたしたち"],["の"],["ため"],["に"],["ご自身","ごじしん"],["を"],["ささげられた"],["の"],["は"],["、"],["私たち","わたしたち"],["を"],["すべて"],["の"],["不法","ふほう"],["から"],["贖い","あがない"],["出し","だし"],["、"],["良い","よい"],["わざ"],["に"],["熱心","ねっしん"],["な"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["、"],["ご自分","ごじぶん"],["の"],["ため"],["に"],["きよめる"],["ため"],["でした"],["。"]]},{"verse":15,"text":"あなたは、これらのことを十分な権威をもって話し、勧め、また、責めなさい。だれにも軽んじられてはいけません。","tok":[["あなた"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["十分","じゅうぶん"],["な"],["権威","けんい"],["を"],["もって"],["話し","はなし"],["、"],["勧め","すすめ"],["、"],["また"],["、"],["責め","せめ"],["なさい"],["。"],["だれ"],["に"],["も"],["軽んじられて","かろんじられて"],["は"],["いけません"],["。"]]}]
[{"verse":1,"text":"あなたは彼らに注意を与えて、支配者たちと権威者たちに服従し、従順で、すべての良いわざを進んでする者とならせなさい。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["注意","ちゅうい"],["を"],["与えて","あたえて"],["、"],["支配者","しはいしゃ"],["たち"],["と"],["権威者","けんいしゃ"],["たち"],["に"],["服従","ふくじゅう"],["し"],["、"],["従順","じゅうじゅん"],["で"],["、"],["すべて"],["の"],["良い","よい"],["わざ"],["を"],["進んで","すすんで"],["する"],["者","もの"],["と"],["ならせ"],["なさい"],["。"]]},{"verse":2,"text":"また、だれをもそしらず、争わず、柔和で、すべての人に優しい態度を示す者とならせなさい。","tok":[["また"],["、"],["だれ"],["を"],["も"],["そしらず"],["、"],["争わず","あらそわず"],["、"],["柔和","にゅうわ"],["で"],["、"],["すべて"],["の"],["人","ひと"],["に"],["優しい","やさしい"],["態度","たいど"],["を"],["示す","しめす"],["者","もの"],["と"],["ならせ"],["なさい"],["。"]]},{"verse":3,"text":"私たちも以前は、愚かな者であり、不従順で、迷った者であり、いろいろな欲情と快楽の奴隷になり、悪意とねたみの中に生活し、憎まれ者であり、互いに憎み合う者でした。","tok":[["私たち","わたしたち"],["も"],["以前","いぜん"],["は"],["、"],["愚か","おろか"],["な"],["者","もの"],["で"],["あり"],["、"],["不","ふ"],["従順","じゅうじゅん"],["で"],["、"],["迷った","まよった"],["者","もの"],["で"],["あり"],["、"],["いろいろ"],["な"],["欲情","よくじょう"],["と"],["快楽","かいらく"],["の"],["奴隷","どれい"],["に"],["なり"],["、"],["悪意","あくい"],["と"],["ねたみ"],["の"],["中","なか"],["に"],["生活","せいかつ"],["し"],["、"],["憎まれ","にくまれ"],["者","もの"],["で"],["あり"],["、"],["互い","たがい"],["に"],["憎み合う","にくみあう"],["者","もの"],["でした"],["。"]]},{"verse":4,"text":"しかし、私たちの救い主なる神のいつくしみと人への愛とが現れたとき、","tok":[["しかし"],["、"],["私たち","わたしたち"],["の"],["救い主","すくいぬし"],["なる"],["神","かみ"],["の"],["いつくしみ"],["と"],["人","ひと"],["へ"],["の"],["愛","あい"],["と"],["が"],["現れた","あらわれた"],["とき"],["、"]]},{"verse":5,"text":"神は、私たちが行った義のわざによってではなく、ご自分のあわれみのゆえに、聖霊による、新生と更新との洗いをもって私たちを救ってくださいました。","tok":[["神","かみ"],["は"],["、"],["私たち","わたしたち"],["が"],["行った","おこなった"],["義","ぎ"],["の"],["わざ"],["によって"],["で"],["は"],["なく"],["、"],["ご自分","ごじぶん"],["の"],["あわれみ"],["の"],["ゆえ"],["に"],["、"],["聖霊","せいれい"],["に"],["よる"],["、"],["新生","しんせい"],["と"],["更新","こうしん"],["と"],["の"],["洗い","あらい"],["を"],["もって"],["私たち","わたしたち"],["を"],["救って","すくって"],["くださいました"],["。"]]},{"verse":6,"text":"神は、この聖霊を、私たちの救い主なるイエス・キリストによって、私たちに豊かに注いでくださったのです。","tok":[["神","かみ"],["は"],["、"],["この"],["聖霊","せいれい"],["を"],["、"],["私たち","わたしたち"],["の"],["救い主","すくいぬし"],["なる"],["イエス"],["・"],["キリスト"],["によって"],["、"],["私たち","わたしたち"],["に"],["豊か","ゆたか"],["に"],["注いで","そそいで"],["くださった"],["の"],["です"],["。"]]},{"verse":7,"text":"それは、私たちがキリストの恵みによって義と認められ、永遠のいのちの望みによって、相続人となるためです。","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["が"],["キリスト"],["の"],["恵み","めぐみ"],["によって"],["義","ぎ"],["と"],["認められ","みとめられ"],["、"],["永遠","えいえん"],["の"],["いのち"],["の"],["望み","のぞみ"],["によって"],["、"],["相続人","そうぞくにん"],["と"],["なる"],["ため"],["です"],["。"]]},{"verse":8,"text":"これは信頼できることばですから、私は、あなたがこれらのことについて、確信をもって話すように願っています。それは、神を信じている人々が、良いわざに励むことを心がけるようになるためです。これらのことは良いことであって、人々に有益なことです。","tok":[["これ"],["は"],["信頼","しんらい"],["できる"],["ことば"],["です"],["から"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["が"],["これ"],["ら"],["の"],["こと"],["について"],["、"],["確信","かくしん"],["を"],["もって"],["話す","はなす"],["よう"],["に"],["願って","ねがって"],["います"],["。"],["それ"],["は"],["、"],["神","かみ"],["を"],["信じて","しんじて"],["いる"],["人々","ひとびと"],["が"],["、"],["良い","よい"],["わざ"],["に"],["励む","はげむ"],["こと"],["を"],["心がける","こころがける"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["これ"],["ら"],["の"],["こと"],["は"],["良い","よい"],["こと"],["で"],["あって"],["、"],["人々","ひとびと"],["に"],["有益","ゆうえき"],["な"],["こと"],["です"],["。"]]},{"verse":9,"text":"しかし、愚かな議論、系図、口論、律法についての論争などを避けなさい。それらは無益で、むだなものです。","tok":[["しかし"],["、"],["愚か","おろか"],["な"],["議論","ぎろん"],["、"],["系図","けいず"],["、"],["口論","こうろん"],["、"],["律法","りっぽう"],["について"],["の"],["論争","ろんそう"],["など"],["を"],["避け","さけ"],["なさい"],["。"],["それ"],["ら"],["は"],["無益","むえき"],["で"],["、"],["むだ"],["な"],["もの"],["です"],["。"]]},{"verse":10,"text":"分派を起こす者は、一、二度戒めてから、除名しなさい。","tok":[["分派","ぶんぱ"],["を"],["起こす","おこす"],["者","もの"],["は"],["、"],["一","いち"],["、"],["二","に"],["度","ど"],["戒めて","いましめて"],["から"],["、"],["除名","じょめい"],["し"],["なさい"],["。"]]},{"verse":11,"text":"このような人は、あなたも知っているとおり、堕落しており、自分で悪いと知りながら罪を犯しているのです。","tok":[["この"],["よう"],["な"],["人","ひと"],["は"],["、"],["あなた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["堕落","だらく"],["して"],["おり"],["、"],["自分","じぶん"],["で"],["悪い","わるい"],["と"],["知り","しり"],["ながら"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["の"],["です"],["。"]]},{"verse":12,"text":"私がアルテマスかテキコをあなたのもとに送ったら、あなたは、何としてでも、ニコポリにいる私のところに来てください。私はそこで冬を過ごすことに決めています。","tok":[["私","わたくし"],["が"],["アルテマス"],["か"],["テキコ"],["を"],["あなた"],["の"],["もと"],["に"],["送ったら","おくったら"],["、"],["あなた"],["は"],["、"],["何","なん"],["として"],["で"],["も"],["、"],["ニコポリ"],["に"],["いる"],["私","わたくし"],["の"],["ところ"],["に"],["来て","きて"],["ください"],["。"],["私","わたくし"],["は"],["そこ"],["で"],["冬","ふゆ"],["を"],["過ごす","すごす"],["こと"],["に"],["決めて","きめて"],["います"],["。"]]},{"verse":13,"text":"ぜひとも、律法学者ゼナスとアポロとが旅に出られるようにし、彼らが不自由しないように世話をしてあげなさい。","tok":[["ぜひ"],["と"],["も"],["、"],["律法学者","りっぽうがくしゃ"],["ゼナス"],["と"],["アポロ"],["と"],["が"],["旅","たび"],["に"],["出られる","でられる"],["よう"],["に"],["し"],["、"],["彼","かれ"],["ら"],["が"],["不自由","ふじゆう"],["しない"],["よう"],["に"],["世話","せわ"],["を"],["して"],["あげ"],["なさい"],["。"]]},{"verse":14,"text":"私たち一同も、なくてならないもののために、正しい仕事に励むように教えられなければなりません。それは、実を結ばない者にならないためです。","tok":[["私たち","わたしたち"],["一同","いちどう"],["も"],["、"],["なくて"],["ならない"],["もの"],["の"],["ため"],["に"],["、"],["正しい","ただしい"],["仕事","しごと"],["に"],["励む","はげむ"],["よう"],["に"],["教えられなければ","おしえられなければ"],["なりません"],["。"],["それ"],["は"],["、"],["実","じつ"],["を"],["結ばない","むすばない"],["者","もの"],["に"],["ならない"],["ため"],["です"],["。"]]},{"verse":15,"text":"私といっしょにいる者たち一同が、あなたによろしくと言っています。私たちの信仰の友である人々に、よろしく言ってください。／恵みが、あなたがたすべてとともにありますように。","tok":[["私","わたくし"],["と"],["いっしょ"],["に"],["いる"],["者","もの"],["たち"],["一同","いちどう"],["が"],["、"],["あなた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["私たち","わたしたち"],["の"],["信仰","しんこう"],["の"],["友","とも"],["で"],["ある"],["人々","ひとびと"],["に"],["、"],["よろしく"],["言って","いって"],["ください"],["。"],["／"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["すべて"],["と"],["とも"],["に"],["あります"],["よう"],["に"],["。"]]}]
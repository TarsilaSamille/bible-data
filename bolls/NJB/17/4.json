[{"verse":1,"text":"モルデカイは、なされたすべてのことを知った。すると、モルデカイは着物を引き裂き、荒布をまとい、灰をかぶり、大声でひどくわめき叫びながら町の真ん中に出て行き、","tok":[["モルデカイ"],["は"],["、"],["なされた"],["すべて"],["の"],["こと"],["を"],["知った","しった"],["。"],["する"],["と"],["、"],["モルデカイ"],["は"],["着物","きもの"],["を"],["引き裂き","ひきさき"],["、"],["荒布","あらめ"],["を"],["まとい"],["、"],["灰","はい"],["を"],["かぶり"],["、"],["大声","おおごえ"],["で"],["ひどく"],["わめき"],["叫び","さけび"],["ながら"],["町","まち"],["の"],["真ん中","まんなか"],["に"],["出て","でて"],["行き","いき"],["、"]]},{"verse":2,"text":"王の門の前まで来た。だれも荒布をまとったままでは、王の門に入ることができなかったからである。","tok":[["王","おう"],["の"],["門","もん"],["の"],["前","まえ"],["まで"],["来た","きた"],["。"],["だれ"],["も"],["荒布","あらめ"],["を"],["まとった"],["まま"],["で"],["は"],["、"],["王","おう"],["の"],["門","もん"],["に"],["入る","はいる"],["こと"],["が"],["できなかった"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"王の命令とその法令が届いたどの州においても、ユダヤ人のうちに大きな悲しみと、断食と、泣き声と、嘆きとが起こり、多くの者は荒布を着て灰の上にすわった。","tok":[["王","おう"],["の"],["命令","めいれい"],["と"],["その"],["法令","ほうれい"],["が"],["届いた","とどいた"],["どの"],["州","しゅう"],["に"],["おいて"],["も"],["、"],["ユダヤ人","ゆだやじん"],["の"],["うち"],["に"],["大きな","おおきな"],["悲しみ","かなしみ"],["と"],["、"],["断食","だんじき"],["と"],["、"],["泣き声","なきごえ"],["と"],["、"],["嘆き","なげき"],["と"],["が"],["起こり","おこり"],["、"],["多く","おおく"],["の"],["者","もの"],["は"],["荒布","あらめ"],["を"],["着て","きて"],["灰","はい"],["の"],["上","うえ"],["に"],["すわった"],["。"]]},{"verse":4,"text":"そのとき、エステルの侍女たちと、その宦官たちが入って来て、彼女にこのことを告げたので、王妃はひどく悲しみ、モルデカイに着物を送って、それを着させ、荒布を脱がせようとしたが、彼はそれを受け取らなかった。","tok":[["その"],["とき"],["、"],["エステル"],["の"],["侍女","じじょ"],["たち"],["と"],["、"],["その"],["宦官","かんがん"],["たち"],["が"],["入って","はいって"],["来て","きて"],["、"],["彼女","かのじょ"],["に"],["この"],["こと"],["を"],["告げた","つげた"],["ので"],["、"],["王妃","おうひ"],["は"],["ひどく"],["悲しみ","かなしみ"],["、"],["モルデカイ"],["に"],["着物","きもの"],["を"],["送って","おくって"],["、"],["それ"],["を"],["着させ","きさせ"],["、"],["荒布","あらめ"],["を"],["脱がせよう","ぬがせよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["は"],["それ"],["を"],["受け取らなかった","うけとらなかった"],["。"]]},{"verse":5,"text":"そこでエステルは、王の宦官のひとりで、王が彼女に仕えさせるために任命していたハタクを呼び寄せ、モルデカイのところへ行って、これはどういうわけか、また何のためかと聞いて来るように命じた。","tok":[["そこ"],["で"],["エステル"],["は"],["、"],["王","おう"],["の"],["宦官","かんがん"],["の"],["ひとり"],["で"],["、"],["王","おう"],["が"],["彼女","かのじょ"],["に"],["仕えさせる","つかえさせる"],["ため"],["に"],["任命","にんめい"],["して"],["いた"],["ハタク"],["を"],["呼び寄せ","よびよせ"],["、"],["モルデカイ"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["これ"],["は"],["どういう"],["わけ"],["か"],["、"],["また"],["何","なん"],["の"],["ため"],["か"],["と"],["聞いて","きいて"],["来る","くる"],["よう"],["に"],["命じた","めいじた"],["。"]]},{"verse":6,"text":"それで、ハタクは王の門の前の町の広場にいるモルデカイのところに出て行った。","tok":[["それ"],["で"],["、"],["ハタク"],["は"],["王","おう"],["の"],["門","もん"],["の"],["前","まえ"],["の"],["町","まち"],["の"],["広場","ひろば"],["に"],["いる"],["モルデカイ"],["の"],["ところ"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":7,"text":"モルデカイは自分の身に起こったことを全部、彼に告げ、ハマンがユダヤ人を滅ぼすために、王の金庫に納めると約束した正確な金額をも告げた。","tok":[["モルデカイ"],["は"],["自分","じぶん"],["の"],["身","み"],["に"],["起こった","おこった"],["こと"],["を"],["全部","ぜんぶ"],["、"],["彼","かれ"],["に"],["告げ","つげ"],["、"],["ハマン"],["が"],["ユダヤ人","ゆだやじん"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["、"],["王","おう"],["の"],["金庫","きんこ"],["に"],["納める","おさめる"],["と"],["約束","やくそく"],["した"],["正確","せいかく"],["な"],["金額","きんがく"],["を"],["も"],["告げた","つげた"],["。"]]},{"verse":8,"text":"モルデカイはまた、ユダヤ人を滅ぼすためにシュシャンで発布された法令の文書の写しをハタクに渡し、それをエステルに見せて、事情を知らせてくれと言い、また、彼女が王のところに行って、自分の民族のために王にあわれみを求めるように彼女に言いつけてくれと頼んだ。","tok":[["モルデカイ"],["は"],["また"],["、"],["ユダヤ人","ゆだやじん"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["シュシャン"],["で"],["発布","はっぷ"],["された"],["法令","ほうれい"],["の"],["文書","ぶんしょ"],["の"],["写し","うつし"],["を"],["ハタク"],["に"],["渡し","わたし"],["、"],["それ"],["を"],["エステル"],["に"],["見せて","みせて"],["、"],["事情","じじょう"],["を"],["知らせて","しらせて"],["くれ"],["と"],["言い","いい"],["、"],["また"],["、"],["彼女","かのじょ"],["が"],["王","おう"],["の"],["ところ"],["に"],["行って","いって"],["、"],["自分","じぶん"],["の"],["民族","みんぞく"],["の"],["ため"],["に"],["王","おう"],["に"],["あわれみ"],["を"],["求める","もとめる"],["よう"],["に"],["彼女","かのじょ"],["に"],["言いつけて","いいつけて"],["くれ"],["と"],["頼んだ","たのんだ"],["。"]]},{"verse":9,"text":"ハタクは帰って来て、モルデカイの伝言をエステルに伝えた。","tok":[["ハタク"],["は"],["帰って","かえって"],["来て","きて"],["、"],["モルデカイ"],["の"],["伝言","でんごん"],["を"],["エステル"],["に"],["伝えた","つたえた"],["。"]]},{"verse":10,"text":"するとエステルはハタクに命じて、モルデカイにこう伝えさせた。","tok":[["する"],["と"],["エステル"],["は"],["ハタク"],["に"],["命じて","めいじて"],["、"],["モルデカイ"],["に"],["こう"],["伝えさせた","つたえさせた"],["。"]]},{"verse":11,"text":"「王の家臣も、王の諸州の民族もみな、男でも女でも、だれでも、召されないで内庭に入り、王のところに行く者は死刑に処せられるという一つの法令があることを知っております。しかし、王がその者に金の笏を差し伸ばせば、その者は生きます。でも、私はこの三十日間、まだ、王のところへ行くようにと召されていません。」","tok":[["「"],["王","おう"],["の"],["家臣","かしん"],["も"],["、"],["王","おう"],["の"],["諸州","しょしゅう"],["の"],["民族","みんぞく"],["も"],["みな"],["、"],["男","おとこ"],["で"],["も"],["女","おんな"],["で"],["も"],["、"],["だれ"],["で"],["も"],["、"],["召されないで","めされないで"],["内庭","ないてい"],["に"],["入り","はいり"],["、"],["王","おう"],["の"],["ところ"],["に"],["行く","いく"],["者","もの"],["は"],["死刑","しけい"],["に"],["処せられる","しょせられる"],["と"],["いう"],["一","ひと"],["つ"],["の"],["法令","ほうれい"],["が"],["ある"],["こと"],["を"],["知って","しって"],["おります"],["。"],["しかし"],["、"],["王","おう"],["が"],["その"],["者","もの"],["に"],["金","かね"],["の"],["笏","しゃく"],["を"],["差し伸ばせば","さしのばせば"],["、"],["その"],["者","もの"],["は"],["生きます","いきます"],["。"],["で"],["も"],["、"],["私","わたくし"],["は"],["この"],["三十","さんとう"],["日間","かかん"],["、"],["まだ"],["、"],["王","おう"],["の"],["ところ"],["へ"],["行く","いく"],["よう"],["に"],["と"],["召されて","めされて"],["いません"],["。"],["」"]]},{"verse":12,"text":"彼がエステルのことばをモルデカイに伝えると、","tok":[["彼","かれ"],["が"],["エステル"],["の"],["ことば"],["を"],["モルデカイ"],["に"],["伝える","つたえる"],["と"],["、"]]},{"verse":13,"text":"モルデカイはエステルに返事を送って言った。「あなたはすべてのユダヤ人から離れて王宮にいるから助かるだろうと考えてはならない。","tok":[["モルデカイ"],["は"],["エステル"],["に"],["返事","へんじ"],["を"],["送って","おくって"],["言った","いった"],["。"],["「"],["あなた"],["は"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["から"],["離れて","はなれて"],["王宮","おうきゅう"],["に"],["いる"],["から"],["助かるだろう","たすかるだろう"],["と"],["考えて","かんがえて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"もし、あなたがこのような時に沈黙を守るなら、別の所から、助けと救いがユダヤ人のために起ころう。しかしあなたも、あなたの父の家も滅びよう。あなたがこの王国に来たのは、もしかすると、この時のためであるかもしれない。」","tok":[["もし"],["、"],["あなた"],["が"],["この"],["よう"],["な"],["時","とき"],["に"],["沈黙","ちんもく"],["を"],["守るなら","まもるなら"],["、"],["別","べつ"],["の"],["所","ところ"],["から"],["、"],["助け","たすけ"],["と"],["救い","すくい"],["が"],["ユダヤ人","ゆだやじん"],["の"],["ため"],["に"],["起ころう","おころう"],["。"],["しかし"],["あなた"],["も"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["も"],["滅びよう","ほろびよう"],["。"],["あなた"],["が"],["この"],["王国","おうこく"],["に"],["来た","きた"],["の"],["は"],["、"],["もし"],["か"],["する"],["と"],["、"],["この"],["時","とき"],["の"],["ため"],["で"],["ある"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":15,"text":"エステルはモルデカイに返事を送って言った。","tok":[["エステル"],["は"],["モルデカイ"],["に"],["返事","へんじ"],["を"],["送って","おくって"],["言った","いった"],["。"]]},{"verse":16,"text":"「行って、シュシャンにいるユダヤ人をみな集め、私のために断食をしてください。三日三晩、食べたり飲んだりしないように。私も、私の侍女たちも、同じように断食をしましょう。たとい法令にそむいても私は王のところへまいります。私は、死ななければならないのでしたら、死にます。」","tok":[["「"],["行って","いって"],["、"],["シュシャン"],["に"],["いる"],["ユダヤ人","ゆだやじん"],["を"],["みな"],["集め","あつめ"],["、"],["私","わたくし"],["の"],["ため"],["に"],["断食","だんじき"],["を"],["して"],["ください"],["。"],["三日","みっか"],["三","さん"],["晩","ばん"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["しない"],["よう"],["に"],["。"],["私","わたくし"],["も"],["、"],["私","わたくし"],["の"],["侍女","じじょ"],["たち"],["も"],["、"],["同じ","おなじ"],["よう"],["に"],["断食","だんじき"],["を"],["しましょう"],["。"],["たとい"],["法令","ほうれい"],["に"],["そむいて"],["も"],["私","わたくし"],["は"],["王","おう"],["の"],["ところ"],["へ"],["まいります"],["。"],["私","わたくし"],["は"],["、"],["死ななければ","しななければ"],["ならない"],["の"],["でしたら"],["、"],["死にます","しにます"],["。"],["」"]]},{"verse":17,"text":"そこで、モルデカイは出て行って、エステルが彼に命じたとおりにした。","tok":[["そこ"],["で"],["、"],["モルデカイ"],["は"],["出て","でて"],["行って","いって"],["、"],["エステル"],["が"],["彼","かれ"],["に"],["命じた","めいじた"],["とおり"],["に"],["した"],["。"]]}]
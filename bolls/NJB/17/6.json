[{"verse":1,"text":"その夜、王は眠れなかったので、記録の書、年代記を持って来るように命じ、王の前でそれを読ませた。","tok":[["その"],["夜","よる"],["、"],["王","おう"],["は"],["眠れなかった","ねむれなかった"],["ので"],["、"],["記録","きろく"],["の"],["書","しょ"],["、"],["年代記","ねんだいき"],["を"],["持って","もって"],["来る","くる"],["よう"],["に"],["命じ","めいじ"],["、"],["王","おう"],["の"],["前","まえ"],["で"],["それ"],["を"],["読ませた","よませた"],["。"]]},{"verse":2,"text":"その中に、入口を守っていた王のふたりの宦官ビグタナとテレシュが、アハシュエロス王を殺そうとしていることをモルデカイが報告した、と書かれてあるのが見つかった。","tok":[["その"],["中","なか"],["に"],["、"],["入口","いりぐち"],["を"],["守って","まもって"],["いた"],["王","おう"],["の"],["ふたり"],["の"],["宦官","かんがん"],["ビグタナ"],["と"],["テレシュ"],["が"],["、"],["アハシュエロス"],["王","おう"],["を"],["殺そう","ころそう"],["として"],["いる"],["こと"],["を"],["モルデカイ"],["が"],["報告","ほうこく"],["した"],["、"],["と"],["書かれて","かかれて"],["ある"],["の"],["が"],["見つかった","みつかった"],["。"]]},{"verse":3,"text":"そこで王は尋ねた。「このために、栄誉とか昇進とか、何かモルデカイにしたか。」王に仕える若い者たちは答えた。「彼には何もしていません。」","tok":[["そこ"],["で"],["王","おう"],["は"],["尋ねた","たずねた"],["。"],["「"],["この"],["ため"],["に"],["、"],["栄誉","えいよ"],["と"],["か"],["昇進","しょうしん"],["と"],["か"],["、"],["何","なん"],["か"],["モルデカイ"],["に"],["した"],["か"],["。"],["」"],["王","おう"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["たち"],["は"],["答えた","こたえた"],["。"],["「"],["彼","かれ"],["に"],["は"],["何","なん"],["も"],["して"],["いません"],["。"],["」"]]},{"verse":4,"text":"王は言った。「庭にいるのはだれか。」ちょうど、ハマンが、モルデカイのために準備した柱に彼をかけることを王に上奏しようと、王宮の外庭に入って来たところであった。","tok":[["王","おう"],["は"],["言った","いった"],["。"],["「"],["庭","にわ"],["に"],["いる"],["の"],["は"],["だれ"],["か"],["。"],["」"],["ちょうど"],["、"],["ハマン"],["が"],["、"],["モルデカイ"],["の"],["ため"],["に"],["準備","じゅんび"],["した"],["柱","はしら"],["に"],["彼","かれ"],["を"],["かける"],["こと"],["を"],["王","おう"],["に"],["上奏","じょうそう"],["しよう"],["と"],["、"],["王宮","おうきゅう"],["の"],["外庭","そとにわ"],["に"],["入って","はいって"],["来た","きた"],["ところ"],["で"],["あった"],["。"]]},{"verse":5,"text":"王に仕える若い者たちは彼に言った。「今、庭に立っているのはハマンです。」王は言った。「ここに通せ。」","tok":[["王","おう"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["今","いま"],["、"],["庭","にわ"],["に"],["立って","たって"],["いる"],["の"],["は"],["ハマン"],["です"],["。"],["」"],["王","おう"],["は"],["言った","いった"],["。"],["「"],["ここ"],["に"],["通せ","とおせ"],["。"],["」"]]},{"verse":6,"text":"ハマンが入って来たので、王は彼に言った。「王が栄誉を与えたいと思う者には、どうしたらよかろう。」そのとき、ハマンは心のうちで思った。「王が栄誉を与えたいと思われる者は、私以外にだれがあろう。」","tok":[["ハマン"],["が"],["入って","はいって"],["来た","きた"],["ので"],["、"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["が"],["栄誉","えいよ"],["を"],["与えたい","あたえたい"],["と"],["思う","おもう"],["者","もの"],["に"],["は"],["、"],["どう"],["したら"],["よかろう"],["。"],["」"],["その"],["とき"],["、"],["ハマン"],["は"],["心","こころ"],["の"],["うち"],["で"],["思った","おもった"],["。"],["「"],["王","おう"],["が"],["栄誉","えいよ"],["を"],["与えたい","あたえたい"],["と"],["思われる","おもわれる"],["者","もの"],["は"],["、"],["私","わたくし"],["以外","いがい"],["に"],["だれ"],["が"],["あろう"],["。"],["」"]]},{"verse":7,"text":"そこでハマンは王に言った。「王が栄誉を与えたいと思われる人のためには、","tok":[["そこ"],["で"],["ハマン"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["が"],["栄誉","えいよ"],["を"],["与えたい","あたえたい"],["と"],["思われる","おもわれる"],["人","ひと"],["の"],["ため"],["に"],["は"],["、"]]},{"verse":8,"text":"王が着ておられた王服を持って来させ、また、王の乗られた馬を、その頭に王冠をつけて引いて来させてください。","tok":[["王","おう"],["が"],["着て","きて"],["おられた"],["王","おう"],["服","ふく"],["を"],["持って","もって"],["来させ","きさせ"],["、"],["また"],["、"],["王","おう"],["の"],["乗られた","のられた"],["馬","うま"],["を"],["、"],["その"],["頭","あたま"],["に"],["王冠","おうかん"],["を"],["つけて"],["引いて","ひいて"],["来させて","きさせて"],["ください"],["。"]]},{"verse":9,"text":"その王服と馬を、貴族である王の首長のひとりの手に渡し、王が栄誉を与えたいと思われる人に王服を着させ、その人を馬に乗せて、町の広場に導かせ、その前で『王が栄誉を与えたいと思われる人はこのとおりである』と、ふれさせてください。」","tok":[["その"],["王","おう"],["服","ふく"],["と"],["馬","うま"],["を"],["、"],["貴族","きぞく"],["で"],["ある"],["王","おう"],["の"],["首長","しゅちょう"],["の"],["ひとり"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["王","おう"],["が"],["栄誉","えいよ"],["を"],["与えたい","あたえたい"],["と"],["思われる","おもわれる"],["人","ひと"],["に"],["王","おう"],["服","ふく"],["を"],["着させ","きさせ"],["、"],["その"],["人","ひと"],["を"],["馬","うま"],["に"],["乗せて","のせて"],["、"],["町","まち"],["の"],["広場","ひろば"],["に"],["導かせ","みちびかせ"],["、"],["その"],["前","まえ"],["で"],["『"],["王","おう"],["が"],["栄誉","えいよ"],["を"],["与えたい","あたえたい"],["と"],["思われる","おもわれる"],["人","ひと"],["は"],["この"],["とおり"],["で"],["ある"],["』"],["と"],["、"],["ふれさせて"],["ください"],["。"],["」"]]},{"verse":10,"text":"すると、王はハマンに言った。「あなたが言ったとおりに、すぐ王服と馬を取って来て、王の門のところにすわっているユダヤ人モルデカイにそうしなさい。あなたの言ったことを一つもたがえてはならない。」","tok":[["する"],["と"],["、"],["王","おう"],["は"],["ハマン"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["言った","いった"],["とおり"],["に"],["、"],["すぐ"],["王","おう"],["服","ふく"],["と"],["馬","うま"],["を"],["取って","とって"],["来て","きて"],["、"],["王","おう"],["の"],["門","もん"],["の"],["ところ"],["に"],["すわって"],["いる"],["ユダヤ人","ゆだやじん"],["モルデカイ"],["に"],["そう"],["し"],["なさい"],["。"],["あなた"],["の"],["言った","いった"],["こと"],["を"],["一","ひと"],["つ"],["も"],["たがえて"],["は"],["ならない"],["。"],["」"]]},{"verse":11,"text":"それで、ハマンは王服と馬を取って来て、モルデカイに着せ、彼を馬に乗せて町の広場に導き、その前で「王が栄誉を与えたいと思われる人はこのとおりである」と叫んだ。","tok":[["それ"],["で"],["、"],["ハマン"],["は"],["王","おう"],["服","ふく"],["と"],["馬","うま"],["を"],["取って","とって"],["来て","きて"],["、"],["モルデカイ"],["に"],["着せ","きせ"],["、"],["彼","かれ"],["を"],["馬","うま"],["に"],["乗せて","のせて"],["町","まち"],["の"],["広場","ひろば"],["に"],["導き","みちびき"],["、"],["その"],["前","まえ"],["で"],["「"],["王","おう"],["が"],["栄誉","えいよ"],["を"],["与えたい","あたえたい"],["と"],["思われる","おもわれる"],["人","ひと"],["は"],["この"],["とおり"],["で"],["ある"],["」"],["と"],["叫んだ","さけんだ"],["。"]]},{"verse":12,"text":"それからモルデカイは王の門に戻ったが、ハマンは嘆いて、頭をおおい、急いで家に帰った。","tok":[["それ"],["から"],["モルデカイ"],["は"],["王","おう"],["の"],["門","もん"],["に"],["戻った","もどった"],["が"],["、"],["ハマン"],["は"],["嘆いて","なげいて"],["、"],["頭","あたま"],["を"],["おおい"],["、"],["急いで","いそいで"],["家","いえ"],["に"],["帰った","かえった"],["。"]]},{"verse":13,"text":"そして、ハマンは自分の身に起こった一部始終を妻ゼレシュとすべての友人たちに話した。すると、彼の知恵のある者たちと、妻ゼレシュは彼に言った。「あなたはモルデカイに負けかけておいでですが、このモルデカイが、ユダヤ民族のひとりであるなら、あなたはもう彼に勝つことはできません。きっと、あなたは彼に負けるでしょう。」","tok":[["そして"],["、"],["ハマン"],["は"],["自分","じぶん"],["の"],["身","み"],["に"],["起こった","おこった"],["一部","いちぶ"],["始終","しじゅう"],["を"],["妻","つま"],["ゼレシュ"],["と"],["すべて"],["の"],["友人","ゆうじん"],["たち"],["に"],["話した","はなした"],["。"],["する"],["と"],["、"],["彼","かれ"],["の"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["たち"],["と"],["、"],["妻","つま"],["ゼレシュ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["モルデカイ"],["に"],["負け","まけ"],["かけて"],["おいでです"],["が"],["、"],["この"],["モルデカイ"],["が"],["、"],["ユダヤ"],["民族","みんぞく"],["の"],["ひとり"],["で"],["あるなら"],["、"],["あなた"],["は"],["もう"],["彼","かれ"],["に"],["勝つ","かつ"],["こと"],["は"],["できません"],["。"],["きっと"],["、"],["あなた"],["は"],["彼","かれ"],["に"],["負けるでしょう","まけるでしょう"],["。"],["」"]]},{"verse":14,"text":"彼らがまだハマンと話しているうちに、王の宦官たちがやって来て、ハマンを急がせ、エステルの設けた宴会に連れて行った。","tok":[["彼","かれ"],["ら"],["が"],["まだ"],["ハマン"],["と"],["話して","はなして"],["いる"],["うち"],["に"],["、"],["王","おう"],["の"],["宦官","かんがん"],["たち"],["が"],["やって"],["来て","きて"],["、"],["ハマン"],["を"],["急がせ","いそがせ"],["、"],["エステル"],["の"],["設けた","もうけた"],["宴会","えんかい"],["に"],["連れて","つれて"],["行った","いった"],["。"]]}]
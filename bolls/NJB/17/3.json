[{"verse":1,"text":"この出来事の後、アハシュエロス王は、アガグ人ハメダタの子ハマンを重んじ、彼を昇進させて、その席を、彼とともにいるすべての首長たちの上に置いた。","tok":[["この"],["出来事","できごと"],["の"],["後","あと"],["、"],["アハシュエロス"],["王","おう"],["は"],["、"],["アガグ人","あがぐにん"],["ハメダタ"],["の"],["子","こ"],["ハマン"],["を"],["重んじ","おもんじ"],["、"],["彼","かれ"],["を"],["昇進","しょうしん"],["させて"],["、"],["その"],["席","せき"],["を"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["すべて"],["の"],["首長","しゅちょう"],["たち"],["の"],["上","うえ"],["に"],["置いた","おいた"],["。"]]},{"verse":2,"text":"それで、王の門のところにいる王の家来たちはみな、ハマンに対してひざをかがめてひれ伏した。王が彼についてこのように命じたからである。しかし、モルデカイはひざもかがめず、ひれ伏そうともしなかった。","tok":[["それ"],["で"],["、"],["王","おう"],["の"],["門","もん"],["の"],["ところ"],["に"],["いる"],["王","おう"],["の"],["家来","けらい"],["たち"],["は"],["みな"],["、"],["ハマン"],["に対して","にたいして"],["ひざ"],["を"],["かがめて"],["ひれ伏した","ひれふした"],["。"],["王","おう"],["が"],["彼","かれ"],["について"],["この"],["よう"],["に"],["命じた","めいじた"],["から"],["で"],["ある"],["。"],["しかし"],["、"],["モルデカイ"],["は"],["ひざ"],["も"],["かがめず"],["、"],["ひれ伏そう","ひれふそう"],["と"],["も"],["しなかった"],["。"]]},{"verse":3,"text":"王の門のところにいる王の家来たちはモルデカイに、「あなたはなぜ、王の命令にそむくのか」と言った。","tok":[["王","おう"],["の"],["門","もん"],["の"],["ところ"],["に"],["いる"],["王","おう"],["の"],["家来","けらい"],["たち"],["は"],["モルデカイ"],["に"],["、"],["「"],["あなた"],["は"],["なぜ"],["、"],["王","おう"],["の"],["命令","めいれい"],["に"],["そむく"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"彼らは、毎日そう言ったが、モルデカイが耳を貸さなかったので、モルデカイのこの態度が続けられてよいものかどうかを見ようと、これをハマンに告げた。モルデカイは自分がユダヤ人であることを彼らに打ち明けていたからである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["毎日","まいにち"],["そう"],["言った","いった"],["が"],["、"],["モルデカイ"],["が"],["耳","みみ"],["を"],["貸さなかった","かさなかった"],["ので"],["、"],["モルデカイ"],["の"],["この"],["態度","たいど"],["が"],["続けられて","つづけられて"],["よい"],["もの"],["か"],["どう"],["か"],["を"],["見よう","みよう"],["と"],["、"],["これ"],["を"],["ハマン"],["に"],["告げた","つげた"],["。"],["モルデカイ"],["は"],["自分","じぶん"],["が"],["ユダヤ人","ゆだやじん"],["で"],["ある"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["打ち明けて","うちあけて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"ハマンはモルデカイが自分に対してひざもかがめず、ひれ伏そうともしないのを見て、憤りに満たされた。","tok":[["ハマン"],["は"],["モルデカイ"],["が"],["自分","じぶん"],["に対して","にたいして"],["ひざ"],["も"],["かがめず"],["、"],["ひれ伏そう","ひれふそう"],["と"],["も"],["しない"],["の"],["を"],["見て","みて"],["、"],["憤り","いきどおり"],["に"],["満たされた","みたされた"],["。"]]},{"verse":6,"text":"ところが、ハマンはモルデカイひとりに手を下すことだけで満足しなかった。彼らがモルデカイの民族のことを、ハマンに知らせていたからである。それでハマンは、アハシュエロスの王国中のすべてのユダヤ人、すなわちモルデカイの民族を、根絶やしにしようとした。","tok":[["ところ"],["が"],["、"],["ハマン"],["は"],["モルデカイ"],["ひとり"],["に"],["手","て"],["を"],["下す","くだす"],["こと"],["だけ"],["で"],["満足","まんぞく"],["しなかった"],["。"],["彼","かれ"],["ら"],["が"],["モルデカイ"],["の"],["民族","みんぞく"],["の"],["こと"],["を"],["、"],["ハマン"],["に"],["知らせて","しらせて"],["いた"],["から"],["で"],["ある"],["。"],["それ"],["で"],["ハマン"],["は"],["、"],["アハシュエロス"],["の"],["王国中","おうこくちゅう"],["の"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["、"],["すなわち"],["モルデカイ"],["の"],["民族","みんぞく"],["を"],["、"],["根絶やし","ねだやし"],["に"],["しよう"],["と"],["した"],["。"]]},{"verse":7,"text":"アハシュエロス王の第十二年の第一の月、すなわちニサンの月に、日と月とを決めるためにハマンの前で、プル、すなわちくじが投げられ、くじは第十二の月、すなわちアダルの月に当たった。","tok":[["アハシュエロス"],["王","おう"],["の"],["第","だい"],["十二","じゅうに"],["年","ねん"],["の"],["第","だい"],["一","いち"],["の"],["月","つき"],["、"],["すなわち"],["ニサン"],["の"],["月","つき"],["に"],["、"],["日","ひ"],["と"],["月","つき"],["と"],["を"],["決める","きめる"],["ため"],["に"],["ハマン"],["の"],["前","まえ"],["で"],["、"],["プル"],["、"],["すなわち"],["くじ"],["が"],["投げられ","なげられ"],["、"],["くじ"],["は"],["第","だい"],["十二","じゅうに"],["の"],["月","つき"],["、"],["すなわち"],["アダル"],["の"],["月","つき"],["に"],["当たった","あたった"],["。"]]},{"verse":8,"text":"ハマンはアハシュエロス王に言った。「あなたの王国のすべての州にいる諸民族の間に、散らされて離れ離れになっている一つの民族がいます。彼らの法令は、どの民族のものとも違っていて、彼らは王の法令を守っていません。それで、彼らをそのままにさせておくことは、王のためになりません。","tok":[["ハマン"],["は"],["アハシュエロス"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["王国","おうこく"],["の"],["すべて"],["の"],["州","しゅう"],["に"],["いる"],["諸","しょ"],["民族","みんぞく"],["の"],["間","あいだ"],["に"],["、"],["散らされて","ちらされて"],["離れ離れ","はなればなれ"],["に"],["なって"],["いる"],["一","ひと"],["つ"],["の"],["民族","みんぞく"],["が"],["います"],["。"],["彼","かれ"],["ら"],["の"],["法令","ほうれい"],["は"],["、"],["どの"],["民族","みんぞく"],["の"],["もの"],["と"],["も"],["違って","ちがって"],["いて"],["、"],["彼","かれ"],["ら"],["は"],["王","おう"],["の"],["法令","ほうれい"],["を"],["守って","まもって"],["いません"],["。"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["を"],["そのまま"],["に"],["させて"],["おく"],["こと"],["は"],["、"],["王","おう"],["の"],["ため"],["に"],["なりません"],["。"]]},{"verse":9,"text":"もしも王さま、よろしければ、彼らを滅ぼすようにと書いてください。私はその仕事をする者たちに銀一万タラントを量って渡します。そうして、それを王の金庫に納めさせましょう。」","tok":[["もし"],["も"],["王","おう"],["さま"],["、"],["よろしければ"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["よう"],["に"],["と"],["書いて","かいて"],["ください"],["。"],["私","わたくし"],["は"],["その"],["仕事","しごと"],["を"],["する"],["者","もの"],["たち"],["に"],["銀","ぎん"],["一万","いちまん"],["タラント"],["を"],["量って","はかって"],["渡します","わたします"],["。"],["そう"],["して"],["、"],["それ"],["を"],["王","おう"],["の"],["金庫","きんこ"],["に"],["納めさせましょう","おさめさせましょう"],["。"],["」"]]},{"verse":10,"text":"そこで、王は自分の手から指輪をはずして、アガグ人ハメダタの子で、ユダヤ人の敵であるハマンに、それを渡した。","tok":[["そこ"],["で"],["、"],["王","おう"],["は"],["自分","じぶん"],["の"],["手","て"],["から"],["指輪","ゆびわ"],["を"],["はずして"],["、"],["アガグ人","あがぐにん"],["ハメダタ"],["の"],["子","こ"],["で"],["、"],["ユダヤ人","ゆだやじん"],["の"],["敵","てき"],["で"],["ある"],["ハマン"],["に"],["、"],["それ"],["を"],["渡した","わたした"],["。"]]},{"verse":11,"text":"そして、王はハマンに言った。「その銀はあなたに授けよう。また、その民族もあなたの好きなようにしなさい。」","tok":[["そして"],["、"],["王","おう"],["は"],["ハマン"],["に"],["言った","いった"],["。"],["「"],["その"],["銀","ぎん"],["は"],["あなた"],["に"],["授けよう","さずけよう"],["。"],["また"],["、"],["その"],["民族","みんぞく"],["も"],["あなた"],["の"],["好き","すき"],["な"],["よう"],["に"],["し"],["なさい"],["。"],["」"]]},{"verse":12,"text":"そこで、第一の月の十三日に、王の書記官が召集され、ハマンが、王の太守や、各州を治めている総督や、各民族の首長たちに命じたことが全部、各州にはその文字で、各民族にはそのことばでしるされた。それは、アハシュエロスの名で書かれ、王の指輪で印が押された。","tok":[["そこ"],["で"],["、"],["第","だい"],["一","いち"],["の"],["月","つき"],["の"],["十三","じゅうさん"],["日","にち"],["に"],["、"],["王","おう"],["の"],["書記官","しょきかん"],["が"],["召集","しょうしゅう"],["され"],["、"],["ハマン"],["が"],["、"],["王","おう"],["の"],["太守","たいしゅ"],["や"],["、"],["各州","かくしゅう"],["を"],["治めて","おさめて"],["いる"],["総督","そうとく"],["や"],["、"],["各","かく"],["民族","みんぞく"],["の"],["首長","しゅちょう"],["たち"],["に"],["命じた","めいじた"],["こと"],["が"],["全部","ぜんぶ"],["、"],["各州","かくしゅう"],["に"],["は"],["その"],["文字","もじ"],["で"],["、"],["各","かく"],["民族","みんぞく"],["に"],["は"],["その"],["ことば"],["で"],["しるされた"],["。"],["それ"],["は"],["、"],["アハシュエロス"],["の"],["名","な"],["で"],["書かれ","かかれ"],["、"],["王","おう"],["の"],["指輪","ゆびわ"],["で"],["印","しるし"],["が"],["押された","おされた"],["。"]]},{"verse":13,"text":"書簡は急使によって王のすべての州へ送られた。それには、第十二の月、すなわちアダルの月の十三日の一日のうちに、若い者も年寄りも、子どもも女も、すべてのユダヤ人を根絶やしにし、殺害し、滅ぼし、彼らの家財をかすめ奪えとあった。","tok":[["書簡","しょかん"],["は"],["急使","きゅうし"],["によって"],["王","おう"],["の"],["すべて"],["の"],["州","しゅう"],["へ"],["送られた","おくられた"],["。"],["それ"],["に"],["は"],["、"],["第","だい"],["十二","じゅうに"],["の"],["月","つき"],["、"],["すなわち"],["アダル"],["の"],["月","つき"],["の"],["十三","じゅうさん"],["日","にち"],["の"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["、"],["若い","わかい"],["者","もの"],["も"],["年寄り","としより"],["も"],["、"],["子ども","こども"],["も"],["女","おんな"],["も"],["、"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["を"],["根絶やし","ねだやし"],["に"],["し"],["、"],["殺害","さつがい"],["し"],["、"],["滅ぼし","ほろぼし"],["、"],["彼","かれ"],["ら"],["の"],["家財","かざい"],["を"],["かすめ"],["奪え","うばえ"],["と"],["あった"],["。"]]},{"verse":14,"text":"各州に法令として発布される文書の写しが、この日の準備のために、すべての民族に公示された。","tok":[["各州","かくしゅう"],["に"],["法令","ほうれい"],["として"],["発布","はっぷ"],["される"],["文書","ぶんしょ"],["の"],["写し","うつし"],["が"],["、"],["この"],["日","ひ"],["の"],["準備","じゅんび"],["の"],["ため"],["に"],["、"],["すべて"],["の"],["民族","みんぞく"],["に"],["公示","こうじ"],["された"],["。"]]},{"verse":15,"text":"急使は王の命令によって急いで出て行った。この法令はシュシャンの城でも発布された。このとき、王とハマンは酒をくみかわしていたが、シュシャンの町は混乱に陥った。","tok":[["急使","きゅうし"],["は"],["王","おう"],["の"],["命令","めいれい"],["によって"],["急いで","いそいで"],["出て","でて"],["行った","いった"],["。"],["この"],["法令","ほうれい"],["は"],["シュシャン"],["の"],["城","しろ"],["で"],["も"],["発布","はっぷ"],["された"],["。"],["この"],["とき"],["、"],["王","おう"],["と"],["ハマン"],["は"],["酒","さけ"],["を"],["くみ"],["かわして"],["いた"],["が"],["、"],["シュシャン"],["の"],["町","まち"],["は"],["混乱","こんらん"],["に"],["陥った","おちいった"],["。"]]}]
[{"verse":1,"text":"アハシュエロスの時代のこと――このアハシュエロスは、ホドからクシュまで百二十七州を治めていた――","tok":[["アハシュエロス"],["の"],["時代","じだい"],["の"],["こと"],["―"],["―"],["この"],["アハシュエロス"],["は"],["、"],["ホド"],["から"],["クシュ"],["まで"],["百二十七","ひゃくにじゅうなな"],["州","しゅう"],["を"],["治めて","おさめて"],["いた"],["―"],["―"]]},{"verse":2,"text":"アハシュエロス王がシュシャンの城で、王座に着いていたころ、","tok":[["アハシュエロス"],["王","おう"],["が"],["シュシャン"],["の"],["城","しろ"],["で"],["、"],["王座","おうざ"],["に"],["着いて","ついて"],["いた"],["ころ"],["、"]]},{"verse":3,"text":"その治世の第三年に、彼はすべての首長と家臣たちのために宴会を催した。それにはペルシヤとメディヤの有力者、貴族たちおよび諸州の首長たちが出席した。","tok":[["その"],["治世","ちせい"],["の"],["第","だい"],["三","さん"],["年","ねん"],["に"],["、"],["彼","かれ"],["は"],["すべて"],["の"],["首長","しゅちょう"],["と"],["家臣","かしん"],["たち"],["の"],["ため"],["に"],["宴会","えんかい"],["を"],["催した","もよおした"],["。"],["それ"],["に"],["は"],["ペルシヤ"],["と"],["メディヤ"],["の"],["有力","ゆうりょく"],["者","しゃ"],["、"],["貴族","きぞく"],["たち"],["および"],["諸州","しょしゅう"],["の"],["首長","しゅちょう"],["たち"],["が"],["出席","しゅっせき"],["した"],["。"]]},{"verse":4,"text":"そのとき、王は輝かしい王国の富と、そのきらびやかな栄誉を幾日も示して、百八十日に及んだ。","tok":[["その"],["とき"],["、"],["王","おう"],["は"],["輝かしい","かがやかしい"],["王国","おうこく"],["の"],["富","とみ"],["と"],["、"],["その"],["きらびやか"],["な"],["栄誉","えいよ"],["を"],["幾日","いくか"],["も"],["示して","しめして"],["、"],["百八十日","ひゃくはちとうか"],["に"],["及んだ","およんだ"],["。"]]},{"verse":5,"text":"この期間が終わると、王は、シュシャンの城にいた身分の高い者から低い者に至るまですべての民のために、七日間、王宮の園の庭で、宴会を催した。","tok":[["この"],["期間","きかん"],["が"],["終わる","おわる"],["と"],["、"],["王","おう"],["は"],["、"],["シュシャン"],["の"],["城","しろ"],["に"],["いた"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["から"],["低い","ひくい"],["者","もの"],["に"],["至る","いたる"],["まで"],["すべて"],["の"],["民","たみ"],["の"],["ため"],["に"],["、"],["七","なな"],["日間","かかん"],["、"],["王宮","おうきゅう"],["の"],["園","その"],["の"],["庭","にわ"],["で"],["、"],["宴会","えんかい"],["を"],["催した","もよおした"],["。"]]},{"verse":6,"text":"そこには白綿布や青色の布が、白や紫色の細ひもで大理石の柱の銀の輪に結びつけられ、金と銀でできた長いすが、緑色石、白大理石、真珠貝や黒大理石のモザイクの床の上に置かれていた。","tok":[["そこ"],["に"],["は"],["白","しろ"],["綿布","めんぷ"],["や"],["青色","あおいろ"],["の"],["布","ぬの"],["が"],["、"],["白","しろ"],["や"],["紫色","むらさきいろ"],["の"],["細ひも","ほそひも"],["で"],["大理石","だいりせき"],["の"],["柱","はしら"],["の"],["銀","ぎん"],["の"],["輪","わ"],["に"],["結びつけられ","むすびつけられ"],["、"],["金","きん"],["と"],["銀","ぎん"],["で"],["できた"],["長いす","ながいす"],["が"],["、"],["緑色","みどりいろ"],["石","いし"],["、"],["白","しろ"],["大理石","だいりせき"],["、"],["真珠貝","しんじゅがい"],["や"],["黒","くろ"],["大理石","だいりせき"],["の"],["モザイク"],["の"],["床","ゆか"],["の"],["上","うえ"],["に"],["置かれて","おかれて"],["いた"],["。"]]},{"verse":7,"text":"彼は金の杯で酒をふるまったが、その杯は一つ一つ違っていた。そして王の勢力にふさわしく王室の酒がたくさんあった。","tok":[["彼","かれ"],["は"],["金","きん"],["の"],["杯","さかずき"],["で"],["酒","さけ"],["を"],["ふるまった"],["が"],["、"],["その"],["杯","さかずき"],["は"],["一","ひと"],["つ"],["一","ひと"],["つ"],["違って","ちがって"],["いた"],["。"],["そして"],["王","おう"],["の"],["勢力","せいりょく"],["に"],["ふさわしく"],["王室","おうしつ"],["の"],["酒","さけ"],["が"],["たくさん"],["あった"],["。"]]},{"verse":8,"text":"それを飲むとき、法令によって、だれも強いられなかった。だれでもめいめい自分の好みのままにするようにと、王が宮殿のすべての役人に命じておいたからである。","tok":[["それ"],["を"],["飲む","のむ"],["とき"],["、"],["法令","ほうれい"],["によって"],["、"],["だれ"],["も"],["強いられなかった","しいられなかった"],["。"],["だれ"],["で"],["も"],["めいめい"],["自分","じぶん"],["の"],["好み","このみ"],["の"],["まま"],["に"],["する"],["よう"],["に"],["と"],["、"],["王","おう"],["が"],["宮殿","きゅうでん"],["の"],["すべて"],["の"],["役人","やくにん"],["に"],["命じて","めいじて"],["おいた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"王妃ワシュティも、アハシュエロス王の王宮で婦人たちのために宴会を催した。","tok":[["王妃","おうひ"],["ワシュティ"],["も"],["、"],["アハシュエロス"],["王","おう"],["の"],["王宮","おうきゅう"],["で"],["婦人","ふじん"],["たち"],["の"],["ため"],["に"],["宴会","えんかい"],["を"],["催した","もよおした"],["。"]]},{"verse":10,"text":"七日目に、王は酒で心が陽気になり、アハシュエロス王に仕える七人の宦官メフマン、ビゼタ、ハルボナ、ビグタ、アバグタ、ゼタル、カルカスに命じて、","tok":[["七日目","ななかめ"],["に"],["、"],["王","おう"],["は"],["酒","さけ"],["で"],["心","こころ"],["が"],["陽気","ようき"],["に"],["なり"],["、"],["アハシュエロス"],["王","おう"],["に"],["仕える","つかえる"],["七人","ななにん"],["の"],["宦官","かんがん"],["メフマン"],["、"],["ビゼタ"],["、"],["ハルボナ"],["、"],["ビグタ"],["、"],["アバグタ"],["、"],["ゼタル"],["、"],["カルカス"],["に"],["命じて","めいじて"],["、"]]},{"verse":11,"text":"王妃ワシュティに王冠をかぶらせ、彼女を王の前に連れて来るようにと言った。それは、彼女の容姿が美しかったので、その美しさを民と首長たちに見せるためであった。","tok":[["王妃","おうひ"],["ワシュティ"],["に"],["王冠","おうかん"],["を"],["かぶらせ"],["、"],["彼女","かのじょ"],["を"],["王","おう"],["の"],["前","まえ"],["に"],["連れて","つれて"],["来る","くる"],["よう"],["に"],["と"],["言った","いった"],["。"],["それ"],["は"],["、"],["彼女","かのじょ"],["の"],["容姿","ようし"],["が"],["美しかった","うつくしかった"],["ので"],["、"],["その"],["美し","うつくし"],["さ"],["を"],["民","たみ"],["と"],["首長","しゅちょう"],["たち"],["に"],["見せる","みせる"],["ため"],["で"],["あった"],["。"]]},{"verse":12,"text":"しかし、王妃ワシュティが宦官から伝えられた王の命令を拒んで来ようとしなかったので、王は非常に怒り、その憤りが彼のうちで燃え立った。","tok":[["しかし"],["、"],["王妃","おうひ"],["ワシュティ"],["が"],["宦官","かんがん"],["から"],["伝えられた","つたえられた"],["王","おう"],["の"],["命令","めいれい"],["を"],["拒んで","こばんで"],["来よう","こよう"],["と"],["しなかった"],["ので"],["、"],["王","おう"],["は"],["非常","ひじょう"],["に"],["怒り","おこり"],["、"],["その"],["憤り","いきどおり"],["が"],["彼","かれ"],["の"],["うち"],["で"],["燃え立った","もえたった"],["。"]]},{"verse":13,"text":"そこで王は法令に詳しい、知恵のある者たちに相談した。――このように、法令と裁判に詳しいすべての者に計るのが、王のならわしであった。","tok":[["そこ"],["で"],["王","おう"],["は"],["法令","ほうれい"],["に"],["詳しい","くわしい"],["、"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["たち"],["に"],["相談","そうだん"],["した"],["。"],["―"],["―"],["この"],["よう"],["に"],["、"],["法令","ほうれい"],["と"],["裁判","さいばん"],["に"],["詳しい","くわしい"],["すべて"],["の"],["者","もの"],["に"],["計る","はかる"],["の"],["が"],["、"],["王","おう"],["の"],["ならわし"],["で"],["あった"],["。"]]},{"verse":14,"text":"王の側近の者はペルシヤとメディヤの七人の首長たちカルシェナ、シェタル、アデマタ、タルシシュ、メレス、マルセナ、メムカンで、彼らは王と面接ができ、王国の最高の地位についていた――","tok":[["王","おう"],["の"],["側近","そっきん"],["の"],["者","もの"],["は"],["ペルシヤ"],["と"],["メディヤ"],["の"],["七人","しちにん"],["の"],["首長","しゅちょう"],["たち"],["カルシェナ"],["、"],["シェタル"],["、"],["アデマタ"],["、"],["タルシシュ"],["、"],["メレス"],["、"],["マルセナ"],["、"],["メムカン"],["で"],["、"],["彼","かれ"],["ら"],["は"],["王","おう"],["と"],["面接","めんせつ"],["が"],["でき"],["、"],["王国","おうこく"],["の"],["最高","さいこう"],["の"],["地位","ちい"],["について"],["いた"],["―"],["―"]]},{"verse":15,"text":"「王妃ワシュティは、宦官によって伝えられたアハシュエロス王の命令に従わなかったが、法令により、彼女をどう処分すべきだろうか。」","tok":[["「"],["王妃","おうひ"],["ワシュティ"],["は"],["、"],["宦官","かんがん"],["によって"],["伝えられた","つたえられた"],["アハシュエロス"],["王","おう"],["の"],["命令","めいれい"],["に"],["従わなかった","したがわなかった"],["が"],["、"],["法令","ほうれい"],["に"],["より"],["、"],["彼女","かのじょ"],["を"],["どう"],["処分","しょぶん"],["すべきだろう"],["か"],["。"],["」"]]},{"verse":16,"text":"メムカンは王と首長たちの前で答えた。「王妃ワシュティは王ひとりにではなく、すべての首長とアハシュエロス王のすべての州の全住民にも悪いことをしました。","tok":[["メムカン"],["は"],["王","おう"],["と"],["首長","しゅちょう"],["たち"],["の"],["前","まえ"],["で"],["答えた","こたえた"],["。"],["「"],["王妃","おうひ"],["ワシュティ"],["は"],["王","おう"],["ひとり"],["に"],["で"],["は"],["なく"],["、"],["すべて"],["の"],["首長","しゅちょう"],["と"],["アハシュエロス"],["王","おう"],["の"],["すべて"],["の"],["州","しゅう"],["の"],["全住民","ぜんじゅうみん"],["に"],["も"],["悪い","わるい"],["こと"],["を"],["しました"],["。"]]},{"verse":17,"text":"なぜなら、王妃の行いが女たちみなに知れ渡り、『アハシュエロス王が王妃ワシュティに王の前に来るようにと命じたが、来なかった』と言って、女たちは自分の夫を軽く見るようになるでしょう。","tok":[["なぜ"],["なら"],["、"],["王妃","おうひ"],["の"],["行い","おこない"],["が"],["女","おんな"],["たち"],["みな"],["に"],["知れ渡り","しれわたり"],["、"],["『"],["アハシュエロス"],["王","おう"],["が"],["王妃","おうひ"],["ワシュティ"],["に"],["王","おう"],["の"],["前","まえ"],["に"],["来る","くる"],["よう"],["に"],["と"],["命じた","めいじた"],["が"],["、"],["来なかった","こなかった"],["』"],["と"],["言って","いって"],["、"],["女","おんな"],["たち"],["は"],["自分","じぶん"],["の"],["夫","おっと"],["を"],["軽く","かるく"],["見る","みる"],["よう"],["に"],["なるでしょう"],["。"]]},{"verse":18,"text":"きょうにでも、王妃のことを聞いたペルシヤとメディヤの首長の夫人たちは、王のすべての首長たちに、このことを言って、ひどい軽蔑と怒りが起こることでしょう。","tok":[["きょう"],["に"],["で"],["も"],["、"],["王妃","おうひ"],["の"],["こと"],["を"],["聞いた","きいた"],["ペルシヤ"],["と"],["メディヤ"],["の"],["首長","しゅちょう"],["の"],["夫人","ふじん"],["たち"],["は"],["、"],["王","おう"],["の"],["すべて"],["の"],["首長","しゅちょう"],["たち"],["に"],["、"],["この"],["こと"],["を"],["言って","いって"],["、"],["ひどい"],["軽蔑","けいべつ"],["と"],["怒り","いかり"],["が"],["起こる","おこる"],["こと"],["でしょう"],["。"]]},{"verse":19,"text":"もしも王によろしければ、ワシュティはアハシュエロス王の前に出てはならないという勅令をご自身で出し、ペルシヤとメディヤの法令の中に書き入れて、変更することのないようにし、王は王妃の位を彼女よりもすぐれた婦人に授けてください。","tok":[["もし"],["も"],["王","おう"],["に"],["よろしければ"],["、"],["ワシュティ"],["は"],["アハシュエロス"],["王","おう"],["の"],["前","まえ"],["に"],["出て","でて"],["は"],["ならない"],["と"],["いう"],["勅令","ちょくれい"],["を"],["ご自身","ごじしん"],["で"],["出し","だし"],["、"],["ペルシヤ"],["と"],["メディヤ"],["の"],["法令","ほうれい"],["の"],["中","なか"],["に"],["書き入れて","かきいれて"],["、"],["変更","へんこう"],["する"],["こと"],["の"],["ない"],["よう"],["に"],["し"],["、"],["王","おう"],["は"],["王妃","おうひ"],["の"],["位","くらい"],["を"],["彼女","かのじょ"],["より"],["も"],["すぐれた"],["婦人","ふじん"],["に"],["授けて","さずけて"],["ください"],["。"]]},{"verse":20,"text":"王が出される詔勅が、この大きな王国の隅々まで告げ知らされると、女たちは、身分の高い者から低い者に至るまでみな、自分の夫を尊敬するようになりましょう。」","tok":[["王","おう"],["が"],["出される","だされる"],["詔勅","しょうちょく"],["が"],["、"],["この"],["大きな","おおきな"],["王国","おうこく"],["の"],["隅々","すみずみ"],["まで"],["告げ知らされる","つげしらされる"],["と"],["、"],["女","おんな"],["たち"],["は"],["、"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["から"],["低い","ひくい"],["者","もの"],["に"],["至る","いたる"],["まで"],["みな"],["、"],["自分","じぶん"],["の"],["夫","おっと"],["を"],["尊敬","そんけい"],["する"],["よう"],["に"],["なりましょう"],["。"],["」"]]},{"verse":21,"text":"この進言は、王と首長たちの心にかなったので、王はメムカンの言ったとおりにした。","tok":[["この"],["進言","しんげん"],["は"],["、"],["王","おう"],["と"],["首長","しゅちょう"],["たち"],["の"],["心","こころ"],["に"],["かなった"],["ので"],["、"],["王","おう"],["は"],["メムカン"],["の"],["言った","いった"],["とおり"],["に"],["した"],["。"]]},{"verse":22,"text":"そこで王は、王のすべての州に書簡を送った。各州にはその文字で、各民族にはそのことばで書簡を送り、男子はみな、一家の主人となること、また、自分の民族のことばで話すことを命じた。","tok":[["そこ"],["で"],["王","おう"],["は"],["、"],["王","おう"],["の"],["すべて"],["の"],["州","しゅう"],["に"],["書簡","しょかん"],["を"],["送った","おくった"],["。"],["各","かく"],["州","しゅう"],["に"],["は"],["その"],["文字","もじ"],["で"],["、"],["各","かく"],["民族","みんぞく"],["に"],["は"],["その"],["ことば"],["で"],["書簡","しょかん"],["を"],["送り","おくり"],["、"],["男子","だんし"],["は"],["みな"],["、"],["一家","いっか"],["の"],["主人","しゅじん"],["と"],["なる"],["こと"],["、"],["また"],["、"],["自分","じぶん"],["の"],["民族","みんぞく"],["の"],["ことば"],["で"],["話す","はなす"],["こと"],["を"],["命じた","めいじた"],["。"]]}]
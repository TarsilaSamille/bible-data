[{"verse":1,"text":"さて、三日目にエステルは王妃の衣装を着て、王室の正面にある王宮の内庭に立った。王は王室の入口の正面にある王宮の玉座にすわっていた。","tok":[["さて"],["、"],["三日目","みっかめ"],["に"],["エステル"],["は"],["王妃","おうひ"],["の"],["衣装","いしょう"],["を"],["着て","きて"],["、"],["王室","おうしつ"],["の"],["正面","しょうめん"],["に"],["ある"],["王宮","おうきゅう"],["の"],["内庭","うちにわ"],["に"],["立った","たった"],["。"],["王","おう"],["は"],["王室","おうしつ"],["の"],["入口","いりぐち"],["の"],["正面","しょうめん"],["に"],["ある"],["王宮","おうきゅう"],["の"],["玉座","ぎょくざ"],["に"],["すわって"],["いた"],["。"]]},{"verse":2,"text":"王が、庭に立っている王妃エステルを見たとき、彼女は王の好意を受けたので、王は手に持っていた金の笏をエステルに差し伸ばした。そこで、エステルは近寄って、その笏の先にさわった。","tok":[["王","おう"],["が"],["、"],["庭","にわ"],["に"],["立って","たって"],["いる"],["王妃","おうひ"],["エステル"],["を"],["見た","みた"],["とき"],["、"],["彼女","かのじょ"],["は"],["王","おう"],["の"],["好意","こうい"],["を"],["受けた","うけた"],["ので"],["、"],["王","おう"],["は"],["手","て"],["に"],["持って","もって"],["いた"],["金","かね"],["の"],["笏","しゃく"],["を"],["エステル"],["に"],["差し伸ばした","さしのばした"],["。"],["そこ"],["で"],["、"],["エステル"],["は"],["近寄って","ちかよって"],["、"],["その"],["笏","しゃく"],["の"],["先","さき"],["に"],["さわった"],["。"]]},{"verse":3,"text":"王は彼女に言った。「どうしたのだ。王妃エステル。何がほしいのか。王国の半分でも、あなたにやれるのだが。」","tok":[["王","おう"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["どう"],["した"],["の"],["だ"],["。"],["王妃","おうひ"],["エステル"],["。"],["何","なん"],["が"],["ほしい"],["の"],["か"],["。"],["王国","おうこく"],["の"],["半分","はんぶん"],["で"],["も"],["、"],["あなた"],["に"],["やれる"],["の"],["だ"],["が"],["。"],["」"]]},{"verse":4,"text":"エステルは答えた。「もしも、王さまがよろしければ、きょう、私が王さまのために設ける宴会にハマンとごいっしょにお越しください。」","tok":[["エステル"],["は"],["答えた","こたえた"],["。"],["「"],["もし"],["も"],["、"],["王","おう"],["さま"],["が"],["よろしければ"],["、"],["きょう"],["、"],["私","わたくし"],["が"],["王","おう"],["さま"],["の"],["ため"],["に"],["設ける","もうける"],["宴会","えんかい"],["に"],["ハマン"],["と"],["ごいっしょ"],["に"],["お越し","おこし"],["ください"],["。"],["」"]]},{"verse":5,"text":"すると、王は、「ハマンをせきたてて、エステルの言ったようにしよう」と言った。王とハマンはエステルが設けた宴会に出た。","tok":[["する"],["と"],["、"],["王","おう"],["は"],["、"],["「"],["ハマン"],["を"],["せきたてて"],["、"],["エステル"],["の"],["言った","いった"],["よう"],["に"],["しよう"],["」"],["と"],["言った","いった"],["。"],["王","おう"],["と"],["ハマン"],["は"],["エステル"],["が"],["設けた","もうけた"],["宴会","えんかい"],["に"],["出た","でた"],["。"]]},{"verse":6,"text":"その酒宴の席上、王はエステルに尋ねた。「あなたは何を願っているのか。それを授けてやろう。何を望んでいるのか。王国の半分でも、それをかなえてやろう。」","tok":[["その"],["酒宴","しゅえん"],["の"],["席上","せきじょう"],["、"],["王","おう"],["は"],["エステル"],["に"],["尋ねた","たずねた"],["。"],["「"],["あなた"],["は"],["何","なん"],["を"],["願って","ねがって"],["いる"],["の"],["か"],["。"],["それ"],["を"],["授けて","さずけて"],["やろう"],["。"],["何","なん"],["を"],["望んで","のぞんで"],["いる"],["の"],["か"],["。"],["王国","おうこく"],["の"],["半分","はんぶん"],["で"],["も"],["、"],["それ"],["を"],["かなえて"],["やろう"],["。"],["」"]]},{"verse":7,"text":"エステルは答えて言った。「私が願い、望んでいることは、","tok":[["エステル"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["願い","ねがい"],["、"],["望んで","のぞんで"],["いる"],["こと"],["は"],["、"]]},{"verse":8,"text":"もしも王さまのお許しが得られ、王さまがよろしくて、私の願いをゆるし、私の望みをかなえていただけますなら、私が設ける宴会に、ハマンとごいっしょに、もう一度お越しください。そうすれば、あす、私は王さまのおっしゃったとおりにいたします。」","tok":[["もし"],["も"],["王","おう"],["さま"],["の"],["お許し","おゆるし"],["が"],["得られ","えられ"],["、"],["王","おう"],["さま"],["が"],["よろしくて"],["、"],["私","わたくし"],["の"],["願い","ねがい"],["を"],["ゆるし"],["、"],["私","わたくし"],["の"],["望み","のぞみ"],["を"],["かなえて"],["いただけますなら"],["、"],["私","わたくし"],["が"],["設ける","もうける"],["宴会","えんかい"],["に"],["、"],["ハマン"],["と"],["ごいっしょ"],["に"],["、"],["もう"],["一度","いちど"],["お越し","おこし"],["ください"],["。"],["そう"],["すれば"],["、"],["あす"],["、"],["私","わたくし"],["は"],["王","おう"],["さま"],["の"],["おっしゃった"],["とおり"],["に"],["いたします"],["。"],["」"]]},{"verse":9,"text":"ハマンはその日、喜び、上きげんで出て行った。ところが、ハマンは、王の門のところにいるモルデカイが立ち上がろうともせず、自分を少しも恐れていないのを見て、モルデカイに対する憤りに満たされた。","tok":[["ハマン"],["は"],["その"],["日","ひ"],["、"],["喜び","よろこび"],["、"],["上","じょう"],["きげん"],["で"],["出て","でて"],["行った","いった"],["。"],["ところ"],["が"],["、"],["ハマン"],["は"],["、"],["王","おう"],["の"],["門","もん"],["の"],["ところ"],["に"],["いる"],["モルデカイ"],["が"],["立ち上がろう","たちあがろう"],["と"],["も"],["せず"],["、"],["自分","じぶん"],["を"],["少し","すこし"],["も"],["恐れて","おそれて"],["いない"],["の"],["を"],["見て","みて"],["、"],["モルデカイ"],["に"],["対する","たいする"],["憤り","いきどおり"],["に"],["満たされた","みたされた"],["。"]]},{"verse":10,"text":"しかし、ハマンはがまんして家に帰り、人をやって、友人たちと妻ゼレシュを連れて来させた。","tok":[["しかし"],["、"],["ハマン"],["は"],["がまん"],["して"],["家","いえ"],["に"],["帰り","かえり"],["、"],["人","ひと"],["を"],["やって"],["、"],["友人","ゆうじん"],["たち"],["と"],["妻","つま"],["ゼレシュ"],["を"],["連れて","つれて"],["来させた","きさせた"],["。"]]},{"verse":11,"text":"ハマンは自分の輝かしい富について、また、子どもが大ぜいいることや、王が自分を重んじ、王の首長や家臣たちの上に自分を昇進させてくれたことなどを全部彼らに話した。","tok":[["ハマン"],["は"],["自分","じぶん"],["の"],["輝かしい","かがやかしい"],["富","とみ"],["について"],["、"],["また"],["、"],["子ども","こども"],["が"],["大ぜい","おおぜい"],["いる"],["こと"],["や"],["、"],["王","おう"],["が"],["自分","じぶん"],["を"],["重んじ","おもんじ"],["、"],["王","おう"],["の"],["首長","しゅちょう"],["や"],["家臣","かしん"],["たち"],["の"],["上","うえ"],["に"],["自分","じぶん"],["を"],["昇進","しょうしん"],["させて"],["くれた"],["こと"],["など"],["を"],["全部","ぜんぶ"],["彼","かれ"],["ら"],["に"],["話した","はなした"],["。"]]},{"verse":12,"text":"そして、ハマンは言った。「しかも、王妃エステルは、王妃が設けた宴会に、私のほかはだれも王といっしょに来させなかった。あすもまた、私は王といっしょに王妃に招かれている。","tok":[["そして"],["、"],["ハマン"],["は"],["言った","いった"],["。"],["「"],["しかも"],["、"],["王妃","おうひ"],["エステル"],["は"],["、"],["王妃","おうひ"],["が"],["設けた","もうけた"],["宴会","えんかい"],["に"],["、"],["私","わたくし"],["の"],["ほか"],["は"],["だれ"],["も"],["王","おう"],["と"],["いっしょ"],["に"],["来させなかった","きさせなかった"],["。"],["あす"],["も"],["また"],["、"],["私","わたくし"],["は"],["王","おう"],["と"],["いっしょ"],["に"],["王妃","おうひ"],["に"],["招かれて","まねかれて"],["いる"],["。"]]},{"verse":13,"text":"しかし、私が、王の門のところにすわっているあのユダヤ人モルデカイを見なければならない間は、これらのことはいっさい私のためにならない。」","tok":[["しかし"],["、"],["私","わたくし"],["が"],["、"],["王","おう"],["の"],["門","もん"],["の"],["ところ"],["に"],["すわって"],["いる"],["あの"],["ユダヤ人","ゆだやじん"],["モルデカイ"],["を"],["見なければ","みなければ"],["ならない"],["間","あいだ"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["は"],["いっさい"],["私","わたくし"],["の"],["ため"],["に"],["ならない"],["。"],["」"]]},{"verse":14,"text":"すると、彼の妻ゼレシュとすべての友人たちは、彼に言った。「高さ五十キュビトの柱を立てさせ、あしたの朝、王に話して、モルデカイをそれにかけ、それから、王といっしょに喜んでその宴会においでなさい。」この進言はハマンの気に入ったので、彼はその柱を立てさせた。","tok":[["する"],["と"],["、"],["彼","かれ"],["の"],["妻","つま"],["ゼレシュ"],["と"],["すべて"],["の"],["友人","ゆうじん"],["たち"],["は"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["高さ","たかさ"],["五十","ごじゅう"],["キュビト"],["の"],["柱","はしら"],["を"],["立てさせ","たてさせ"],["、"],["あした"],["の"],["朝","あさ"],["、"],["王","おう"],["に"],["話して","はなして"],["、"],["モルデカイ"],["を"],["それ"],["に"],["かけ"],["、"],["それ"],["から"],["、"],["王","おう"],["と"],["いっしょ"],["に"],["喜んで","よろこんで"],["その"],["宴会","えんかい"],["に"],["おいで"],["なさい"],["。"],["」"],["この"],["進言","しんげん"],["は"],["ハマン"],["の"],["気","き"],["に"],["入った","いった"],["ので"],["、"],["彼","かれ"],["は"],["その"],["柱","はしら"],["を"],["立てさせた","たてさせた"],["。"]]}]
[{"verse":1,"text":"この出来事の後、アハシュエロス王の憤りがおさまると、王は、ワシュティのこと、彼女のしたこと、また、彼女に対して決められたことを思い出した。","tok":[["この"],["出来事","できごと"],["の"],["後","あと"],["、"],["アハシュエロス"],["王","おう"],["の"],["憤り","いきどおり"],["が"],["おさまる"],["と"],["、"],["王","おう"],["は"],["、"],["ワシュティ"],["の"],["こと"],["、"],["彼女","かのじょ"],["の"],["した"],["こと"],["、"],["また"],["、"],["彼女","かのじょ"],["に対して","にたいして"],["決められた","きめられた"],["こと"],["を"],["思い出した","おもいだした"],["。"]]},{"verse":2,"text":"そのとき、王に仕える若い者たちは言った。「王のために容姿の美しい未婚の娘たちを捜しましょう。","tok":[["その"],["とき"],["、"],["王","おう"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["たち"],["は"],["言った","いった"],["。"],["「"],["王","おう"],["の"],["ため"],["に"],["容姿","ようし"],["の"],["美しい","うつくしい"],["未婚","みこん"],["の"],["娘","むすめ"],["たち"],["を"],["捜しましょう","さがしましょう"],["。"]]},{"verse":3,"text":"王は、王国のすべての州に役人を任命し、容姿の美しい未婚の娘たちをみな、シュシャンの城の婦人部屋に集めさせ、女たちの監督官である王の宦官ヘガイの管理のもとに置き、化粧に必要な品々を彼女たちに与えるようにしてください。","tok":[["王","おう"],["は"],["、"],["王国","おうこく"],["の"],["すべて"],["の"],["州","しゅう"],["に"],["役人","やくにん"],["を"],["任命","にんめい"],["し"],["、"],["容姿","ようし"],["の"],["美しい","うつくしい"],["未婚","みこん"],["の"],["娘","むすめ"],["たち"],["を"],["みな"],["、"],["シュシャン"],["の"],["城","しろ"],["の"],["婦人","ふじん"],["部屋","へや"],["に"],["集めさせ","あつめさせ"],["、"],["女","おんな"],["たち"],["の"],["監督官","かんとくかん"],["で"],["ある"],["王","おう"],["の"],["宦官","かんがん"],["ヘガイ"],["の"],["管理","かんり"],["の"],["もと"],["に"],["置き","おき"],["、"],["化粧","けしょう"],["に"],["必要","ひつよう"],["な"],["品々","しなじな"],["を"],["彼女","かのじょ"],["たち"],["に"],["与える","あたえる"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":4,"text":"そして、王のお心にかなうおとめをワシュティの代わりに王妃としてください。」このことは王の心にかなったので、彼はそのようにした。","tok":[["そして"],["、"],["王","おう"],["の"],["お心","おこころ"],["に"],["かなう"],["おとめ"],["を"],["ワシュティ"],["の"],["代わり","かわり"],["に"],["王妃","おうひ"],["として"],["ください"],["。"],["」"],["この"],["こと"],["は"],["王","おう"],["の"],["心","こころ"],["に"],["かなった"],["ので"],["、"],["彼","かれ"],["は"],["その"],["よう"],["に"],["した"],["。"]]},{"verse":5,"text":"シュシャンの城にひとりのユダヤ人がいた。その名をモルデカイといって、ベニヤミン人キシュの子シムイの子ヤイルの子であった。","tok":[["シュシャン"],["の"],["城","しろ"],["に"],["ひとり"],["の"],["ユダヤ人","ゆだやじん"],["が"],["いた"],["。"],["その"],["名","な"],["を"],["モルデカイ"],["と"],["いって"],["、"],["ベニヤミン"],["人","にん"],["キシュ"],["の"],["子","こ"],["シムイ"],["の"],["子","こ"],["ヤイル"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":6,"text":"このキシュは、バビロンの王ネブカデネザルが捕らえ移したユダの王エコヌヤといっしょに捕らえ移された捕囚の民とともに、エルサレムから捕らえ移された者であった。","tok":[["この"],["キシュ"],["は"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["が"],["捕らえ","とらえ"],["移した","うつした"],["ユダ"],["の"],["王","おう"],["エコヌヤ"],["と"],["いっしょ"],["に"],["捕らえ","とらえ"],["移された","うつされた"],["捕囚","ほしゅう"],["の"],["民","たみ"],["と"],["とも"],["に"],["、"],["エルサレム"],["から"],["捕らえ","とらえ"],["移された","うつされた"],["者","もの"],["で"],["あった"],["。"]]},{"verse":7,"text":"モルデカイはおじの娘ハダサ、すなわち、エステルを養育していた。彼女には父も母もいなかったからである。このおとめは、姿も顔だちも美しかった。彼女の父と母が死んだとき、モルデカイは彼女を引き取って自分の娘としたのである。","tok":[["モルデカイ"],["は"],["おじ"],["の"],["娘","むすめ"],["ハダサ"],["、"],["すなわち"],["、"],["エステル"],["を"],["養育","よういく"],["して"],["いた"],["。"],["彼女","かのじょ"],["に"],["は"],["父","ちち"],["も"],["母","はは"],["も"],["いなかった"],["から"],["で"],["ある"],["。"],["この"],["おとめ"],["は"],["、"],["姿","すがた"],["も"],["顔だち","かおだち"],["も"],["美しかった","うつくしかった"],["。"],["彼女","かのじょ"],["の"],["父","ちち"],["と"],["母","はは"],["が"],["死んだ","しんだ"],["とき"],["、"],["モルデカイ"],["は"],["彼女","かのじょ"],["を"],["引き取って","ひきとって"],["自分","じぶん"],["の"],["娘","むすめ"],["と"],["した"],["ので"],["ある"],["。"]]},{"verse":8,"text":"王の命令、すなわちその法令が伝えられて、多くのおとめたちがシュシャンの城に集められ、ヘガイの管理のもとに置かれたとき、エステルも王宮に連れて行かれて、女たちの監督官ヘガイの管理のもとに置かれた。","tok":[["王","おう"],["の"],["命令","めいれい"],["、"],["すなわち"],["その"],["法令","ほうれい"],["が"],["伝えられて","つたえられて"],["、"],["多く","おおく"],["の"],["おとめ"],["たち"],["が"],["シュシャン"],["の"],["城","しろ"],["に"],["集められ","あつめられ"],["、"],["ヘガイ"],["の"],["管理","かんり"],["の"],["もと"],["に"],["置かれた","おかれた"],["とき"],["、"],["エステル"],["も"],["王宮","おうきゅう"],["に"],["連れて","つれて"],["行かれて","いかれて"],["、"],["女","おんな"],["たち"],["の"],["監督官","かんとくかん"],["ヘガイ"],["の"],["管理","かんり"],["の"],["もと"],["に"],["置かれた","おかれた"],["。"]]},{"verse":9,"text":"このおとめは、ヘガイの心にかない、彼の好意を得た。そこで、彼は急いで化粧に必要な品々とごちそうを彼女に与え、また王宮から選ばれた七人の侍女を彼女にあてがった。そして、ヘガイは彼女とその侍女たちを、婦人部屋の最も良い所に移した。","tok":[["この"],["おとめ"],["は"],["、"],["ヘガイ"],["の"],["心","こころ"],["に"],["かない"],["、"],["彼","かれ"],["の"],["好意","こうい"],["を"],["得た","えた"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["は"],["急いで","いそいで"],["化粧","けしょう"],["に"],["必要","ひつよう"],["な"],["品々","しなじな"],["と"],["ごちそう"],["を"],["彼女","かのじょ"],["に"],["与え","あたえ"],["、"],["また"],["王宮","おうきゅう"],["から"],["選ばれた","えらばれた"],["七人","ななにん"],["の"],["侍女","じじょ"],["を"],["彼女","かのじょ"],["に"],["あてがった"],["。"],["そして"],["、"],["ヘガイ"],["は"],["彼女","かのじょ"],["と"],["その"],["侍女","じじょ"],["たち"],["を"],["、"],["婦人","ふじん"],["部屋","へや"],["の"],["最も","もっとも"],["良い","よい"],["所","ところ"],["に"],["移した","うつした"],["。"]]},{"verse":10,"text":"エステルは自分の民族をも、自分の生まれをも明かさなかった。モルデカイが、明かしてはならないと彼女に命じておいたからである。","tok":[["エステル"],["は"],["自分","じぶん"],["の"],["民族","みんぞく"],["を"],["も"],["、"],["自分","じぶん"],["の"],["生まれ","うまれ"],["を"],["も"],["明かさなかった","あかさなかった"],["。"],["モルデカイ"],["が"],["、"],["明かして","あかして"],["は"],["ならない"],["と"],["彼女","かのじょ"],["に"],["命じて","めいじて"],["おいた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"モルデカイは毎日婦人部屋の庭の前を歩き回り、エステルの安否と、彼女がどうされるかを知ろうとしていた。","tok":[["モルデカイ"],["は"],["毎日","まいにち"],["婦人","ふじん"],["部屋","へや"],["の"],["庭","にわ"],["の"],["前","まえ"],["を"],["歩き回り","あるきまわり"],["、"],["エステル"],["の"],["安否","あんぴ"],["と"],["、"],["彼女","かのじょ"],["が"],["どう"],["される"],["か"],["を"],["知ろう","しろう"],["として"],["いた"],["。"]]},{"verse":12,"text":"おとめたちは、婦人の規則に従って、十二か月の期間が終わって後、ひとりずつ順番にアハシュエロス王のところに、入って行くことになっていた。これは、準備の期間が、六か月は没薬の油で、次の六か月は香料と婦人の化粧に必要な品々で化粧することで終わることになっていたからである。","tok":[["おとめ"],["たち"],["は"],["、"],["婦人","ふじん"],["の"],["規則","きそく"],["に"],["従って","したがって"],["、"],["十二","じゅうに"],["か月","かげつ"],["の"],["期間","きかん"],["が"],["終わって","おわって"],["後","あと"],["、"],["ひとり"],["ずつ"],["順番","じゅんばん"],["に"],["アハシュエロス"],["王","おう"],["の"],["ところ"],["に"],["、"],["入って","はいって"],["行く","いく"],["こと"],["に"],["なって"],["いた"],["。"],["これ"],["は"],["、"],["準備","じゅんび"],["の"],["期間","きかん"],["が"],["、"],["六","ろく"],["か月","かげつ"],["は"],["没薬","もつやく"],["の"],["油","あぶら"],["で"],["、"],["次","つぎ"],["の"],["六","ろく"],["か月","かげつ"],["は"],["香料","こうりょう"],["と"],["婦人","ふじん"],["の"],["化粧","けしょう"],["に"],["必要","ひつよう"],["な"],["品々","しなじな"],["で"],["化粧","けしょう"],["する"],["こと"],["で"],["終わる","おわる"],["こと"],["に"],["なって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"このようにして、おとめが王のところに入って行くとき、おとめの願うものはみな与えられ、それを持って婦人部屋から王宮に行くことができた。","tok":[["この"],["よう"],["に"],["して"],["、"],["おとめ"],["が"],["王","おう"],["の"],["ところ"],["に"],["入って","はいって"],["行く","いく"],["とき"],["、"],["おとめ"],["の"],["願う","ねがう"],["もの"],["は"],["みな"],["与えられ","あたえられ"],["、"],["それ"],["を"],["持って","もって"],["婦人","ふじん"],["部屋","へや"],["から"],["王宮","おうきゅう"],["に"],["行く","いく"],["こと"],["が"],["できた"],["。"]]},{"verse":14,"text":"おとめは夕方入って行き、朝になると、ほかの婦人部屋に帰っていた。そこは、そばめたちの監督官である王の宦官シャアシュガズの管理のもとにあった。そこの女は、王の気に入り、指名されるのでなければ、二度と王のところには行けなかった。","tok":[["おとめ"],["は"],["夕方","ゆうがた"],["入って","はいって"],["行き","いき"],["、"],["朝","あさ"],["に"],["なる"],["と"],["、"],["ほか"],["の"],["婦人","ふじん"],["部屋","へや"],["に"],["帰って","かえって"],["いた"],["。"],["そこ"],["は"],["、"],["そばめ"],["たち"],["の"],["監督官","かんとくかん"],["で"],["ある"],["王","おう"],["の"],["宦官","かんがん"],["シャアシュガズ"],["の"],["管理","かんり"],["の"],["もと"],["に"],["あった"],["。"],["そこ"],["の"],["女","おんな"],["は"],["、"],["王","おう"],["の"],["気","き"],["に"],["入り","いり"],["、"],["指名","しめい"],["される"],["ので"],["なければ"],["、"],["二","に"],["度","ど"],["と"],["王","おう"],["の"],["ところ"],["に"],["は"],["行けなかった","いけなかった"],["。"]]},{"verse":15,"text":"さて、モルデカイが引き取って、自分の娘とした彼のおじアビハイルの娘エステルが、王のところに入って行く順番が来たとき、彼女は女たちの監督官である王の宦官ヘガイの勧めたもののほかは、何一つ求めなかった。こうしてエステルは、彼女を見るすべての者から好意を受けていた。","tok":[["さて"],["、"],["モルデカイ"],["が"],["引き取って","ひきとって"],["、"],["自分","じぶん"],["の"],["娘","むすめ"],["と"],["した"],["彼","かれ"],["の"],["おじ"],["アビハイル"],["の"],["娘","むすめ"],["エステル"],["が"],["、"],["王","おう"],["の"],["ところ"],["に"],["入って","はいって"],["行く","いく"],["順番","じゅんばん"],["が"],["来た","きた"],["とき"],["、"],["彼女","かのじょ"],["は"],["女","おんな"],["たち"],["の"],["監督官","かんとくかん"],["で"],["ある"],["王","おう"],["の"],["宦官","かんがん"],["ヘガイ"],["の"],["勧めた","すすめた"],["もの"],["の"],["ほか"],["は"],["、"],["何","なん"],["一","ひと"],["つ"],["求めなかった","もとめなかった"],["。"],["こう"],["して"],["エステル"],["は"],["、"],["彼女","かのじょ"],["を"],["見る","みる"],["すべて"],["の"],["者","もの"],["から"],["好意","こうい"],["を"],["受けて","うけて"],["いた"],["。"]]},{"verse":16,"text":"エステルがアハシュエロス王の王宮に召されたのは、王の治世の第七年の第十の月、すなわちテベテの月であった。","tok":[["エステル"],["が"],["アハシュエロス"],["王","おう"],["の"],["王宮","おうきゅう"],["に"],["召された","めされた"],["の"],["は"],["、"],["王","おう"],["の"],["治世","ちせい"],["の"],["第","だい"],["七","なな"],["年","ねん"],["の"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["、"],["すなわち"],["テベテ"],["の"],["月","つき"],["で"],["あった"],["。"]]},{"verse":17,"text":"王はほかのどの女たちよりもエステルを愛した。このため、彼女はどの娘たちよりも王の好意と恵みを受けた。こうして、王はついに王冠を彼女の頭に置き、ワシュティの代わりに彼女を王妃とした。","tok":[["王","おう"],["は"],["ほか"],["の"],["どの"],["女","おんな"],["たち"],["より"],["も"],["エステル"],["を"],["愛した","あいした"],["。"],["この"],["ため"],["、"],["彼女","かのじょ"],["は"],["どの"],["娘","むすめ"],["たち"],["より"],["も"],["王","おう"],["の"],["好意","こうい"],["と"],["恵み","めぐみ"],["を"],["受けた","うけた"],["。"],["こう"],["して"],["、"],["王","おう"],["は"],["ついに"],["王冠","おうかん"],["を"],["彼女","かのじょ"],["の"],["頭","あたま"],["に"],["置き","おき"],["、"],["ワシュティ"],["の"],["代わり","かわり"],["に"],["彼女","かのじょ"],["を"],["王妃","おうひ"],["と"],["した"],["。"]]},{"verse":18,"text":"それから、王はすべての首長と家臣たちの大宴会、すなわち、エステルの宴会を催し、諸州には休日を与えて、王の勢力にふさわしい贈り物を配った。","tok":[["それ"],["から"],["、"],["王","おう"],["は"],["すべて"],["の"],["首長","しゅちょう"],["と"],["家臣","かしん"],["たち"],["の"],["大","だい"],["宴会","えんかい"],["、"],["すなわち"],["、"],["エステル"],["の"],["宴会","えんかい"],["を"],["催し","もよおし"],["、"],["諸州","しょしゅう"],["に"],["は"],["休日","きゅうじつ"],["を"],["与えて","あたえて"],["、"],["王","おう"],["の"],["勢力","せいりょく"],["に"],["ふさわしい"],["贈り物","おくりもの"],["を"],["配った","くばった"],["。"]]},{"verse":19,"text":"娘たちが二度目に集められたとき、モルデカイは王の門のところにすわっていた。","tok":[["娘","むすめ"],["たち"],["が"],["二度目","にどめ"],["に"],["集められた","あつめられた"],["とき"],["、"],["モルデカイ"],["は"],["王","おう"],["の"],["門","もん"],["の"],["ところ"],["に"],["すわって"],["いた"],["。"]]},{"verse":20,"text":"エステルは、モルデカイが彼女に命じていたように、まだ自分の生まれをも、自分の民族をも明かしていなかった。エステルはモルデカイに養育されていた時と同じように、彼の言いつけに従っていた。","tok":[["エステル"],["は"],["、"],["モルデカイ"],["が"],["彼女","かのじょ"],["に"],["命じて","めいじて"],["いた"],["よう"],["に"],["、"],["まだ"],["自分","じぶん"],["の"],["生まれ","うまれ"],["を"],["も"],["、"],["自分","じぶん"],["の"],["民族","みんぞく"],["を"],["も"],["明かして","あかして"],["いなかった"],["。"],["エステル"],["は"],["モルデカイ"],["に"],["養育","よういく"],["されて"],["いた"],["時","とき"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["彼","かれ"],["の"],["言いつけ","いいつけ"],["に"],["従って","したがって"],["いた"],["。"]]},{"verse":21,"text":"そのころ、モルデカイが王の門のところにすわっていると、入口を守っていた王のふたりの宦官ビグタンとテレシュが怒って、アハシュエロス王を殺そうとしていた。","tok":[["その"],["ころ"],["、"],["モルデカイ"],["が"],["王","おう"],["の"],["門","もん"],["の"],["ところ"],["に"],["すわって"],["いる"],["と"],["、"],["入口","いりぐち"],["を"],["守って","まもって"],["いた"],["王","おう"],["の"],["ふたり"],["の"],["宦官","かんがん"],["ビグタン"],["と"],["テレシュ"],["が"],["怒って","おこって"],["、"],["アハシュエロス"],["王","おう"],["を"],["殺そう","ころそう"],["として"],["いた"],["。"]]},{"verse":22,"text":"このことがモルデカイに知れたので、彼はこれを王妃エステルに知らせた。エステルはこれをモルデカイの名で王に告げた。","tok":[["この"],["こと"],["が"],["モルデカイ"],["に"],["知れた","しれた"],["ので"],["、"],["彼","かれ"],["は"],["これ"],["を"],["王妃","おうひ"],["エステル"],["に"],["知らせた","しらせた"],["。"],["エステル"],["は"],["これ"],["を"],["モルデカイ"],["の"],["名","な"],["で"],["王","おう"],["に"],["告げた","つげた"],["。"]]},{"verse":23,"text":"このことが追及されて、その事実が明らかになったので、彼らふたりは木にかけられた。このことは王の前で年代記の書に記録された。","tok":[["この"],["こと"],["が"],["追及","ついきゅう"],["されて"],["、"],["その"],["事実","じじつ"],["が"],["明らか","あきらか"],["に"],["なった"],["ので"],["、"],["彼","かれ"],["ら"],["ふたり"],["は"],["木","き"],["に"],["かけられた"],["。"],["この"],["こと"],["は"],["王","おう"],["の"],["前","まえ"],["で"],["年代記","ねんだいき"],["の"],["書","しょ"],["に"],["記録","きろく"],["された"],["。"]]}]
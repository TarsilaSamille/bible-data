[{"verse":1,"text":"エリシャは、かつて子どもを生き返らせてやったあの女に言った。「あなたは家族の者たちと旅に立ち、あなたがとどまっていたい所に、しばらくとどまっていなさい。主がききんを起こされたので、この国は七年間、ききんに見舞われるから。」","tok":[["エリシャ"],["は"],["、"],["かつて"],["子ども","こども"],["を"],["生き返らせて","いきかえらせて"],["やった"],["あの"],["女","おんな"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["家族","かぞく"],["の"],["者","もの"],["たち"],["と"],["旅","たび"],["に"],["立ち","たち"],["、"],["あなた"],["が"],["とどまって"],["いたい"],["所","ところ"],["に"],["、"],["しばらく"],["とどまって"],["い"],["なさい"],["。"],["主","ぬし"],["が"],["ききん"],["を"],["起こされた","おこされた"],["ので"],["、"],["この"],["国","くに"],["は"],["七","なな"],["年間","ねんかん"],["、"],["ききん"],["に"],["見舞われる","みまわれる"],["から"],["。"],["」"]]},{"verse":2,"text":"そこで、この女は神の人のことばに従って出発し、家族の者を連れてペリシテ人の地に行き、七年間滞在した。","tok":[["そこ"],["で"],["、"],["この"],["女","おんな"],["は"],["神","かみ"],["の"],["人","ひと"],["の"],["ことば"],["に"],["従って","したがって"],["出発","しゅっぱつ"],["し"],["、"],["家族","かぞく"],["の"],["者","もの"],["を"],["連れて","つれて"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["に"],["行き","いき"],["、"],["七","なな"],["年間","ねんかん"],["滞在","たいざい"],["した"],["。"]]},{"verse":3,"text":"七年たって後、彼女はペリシテ人の地から戻って来て、自分の家と畑を得ようと王に訴え出た。","tok":[["七","なな"],["年","ねん"],["たって"],["後","あと"],["、"],["彼女","かのじょ"],["は"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["から"],["戻って","もどって"],["来て","きて"],["、"],["自分","じぶん"],["の"],["家","いえ"],["と"],["畑","はたけ"],["を"],["得よう","えよう"],["と"],["王","おう"],["に"],["訴え出た","うったえでた"],["。"]]},{"verse":4,"text":"そのころ、王は神の人に仕える若い者ゲハジに、「エリシャが行ったすばらしいことを、残らず私に聞かしてくれ」と言って、話していた。","tok":[["その"],["ころ"],["、"],["王","おう"],["は"],["神","かみ"],["の"],["人","ひと"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["ゲハジ"],["に"],["、"],["「"],["エリシャ"],["が"],["行った","おこなった"],["すばらしい"],["こと"],["を"],["、"],["残らず","のこらず"],["私","わたくし"],["に"],["聞かして","きかして"],["くれ"],["」"],["と"],["言って","いって"],["、"],["話して","はなして"],["いた"],["。"]]},{"verse":5,"text":"彼が王に、死人を生き返らせたあのことを話していると、ちょうどそこに、子どもを生き返らせてもらった女が、自分の家と畑のことについて王に訴えに来た。そこで、ゲハジは言った。「王さま。これがその女です。これが、エリシャが生き返らせたその子どもです。」","tok":[["彼","かれ"],["が"],["王","おう"],["に"],["、"],["死人","しにん"],["を"],["生き返らせた","いきかえらせた"],["あの"],["こと"],["を"],["話して","はなして"],["いる"],["と"],["、"],["ちょうど"],["そこ"],["に"],["、"],["子ども","こども"],["を"],["生き返らせて","いきかえらせて"],["もらった"],["女","おんな"],["が"],["、"],["自分","じぶん"],["の"],["家","いえ"],["と"],["畑","はたけ"],["の"],["こと"],["について"],["王","おう"],["に"],["訴え","うったえ"],["に"],["来た","きた"],["。"],["そこ"],["で"],["、"],["ゲハジ"],["は"],["言った","いった"],["。"],["「"],["王","おう"],["さま"],["。"],["これ"],["が"],["その"],["女","おんな"],["です"],["。"],["これ"],["が"],["、"],["エリシャ"],["が"],["生き返らせた","いきかえらせた"],["その"],["子ども","こども"],["です"],["。"],["」"]]},{"verse":6,"text":"王が彼女に尋ねると、彼女は王にそのことを話した。そこで、王は彼女のためにひとりの宦官に命じて言った。「彼女の物は全部返してやりなさい。それに、彼女がこの地を離れた日から、きょうまでの畑の収穫もみな、返してやりなさい。」","tok":[["王","おう"],["が"],["彼女","かのじょ"],["に"],["尋ねる","たずねる"],["と"],["、"],["彼女","かのじょ"],["は"],["王","おう"],["に"],["その"],["こと"],["を"],["話した","はなした"],["。"],["そこ"],["で"],["、"],["王","おう"],["は"],["彼女","かのじょ"],["の"],["ため"],["に"],["ひとり"],["の"],["宦官","かんがん"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["彼女","かのじょ"],["の"],["物","もの"],["は"],["全部","ぜんぶ"],["返して","かえして"],["やり"],["なさい"],["。"],["それ"],["に"],["、"],["彼女","かのじょ"],["が"],["この"],["地","ち"],["を"],["離れた","はなれた"],["日","ひ"],["から"],["、"],["きょう"],["まで"],["の"],["畑","はたけ"],["の"],["収穫","しゅうかく"],["も"],["みな"],["、"],["返して","かえして"],["やり"],["なさい"],["。"],["」"]]},{"verse":7,"text":"エリシャがダマスコに行ったとき、アラムの王ベン・ハダデは病気であったが、彼に「神の人がここまで来ました」という知らせがあった。","tok":[["エリシャ"],["が"],["ダマスコ"],["に"],["行った","いった"],["とき"],["、"],["アラム"],["の"],["王","おう"],["ベン"],["・"],["ハダデ"],["は"],["病気","びょうき"],["で"],["あった"],["が"],["、"],["彼","かれ"],["に"],["「"],["神","かみ"],["の"],["人","ひと"],["が"],["ここ"],["まで"],["来ました","きました"],["」"],["と"],["いう"],["知らせ","しらせ"],["が"],["あった"],["。"]]},{"verse":8,"text":"王はハザエルに言った。「贈り物を持って行って、神の人を迎え、私のこの病気が直るかどうか、あの人を通して主のみこころを求めてくれ。」","tok":[["王","おう"],["は"],["ハザエル"],["に"],["言った","いった"],["。"],["「"],["贈り物","おくりもの"],["を"],["持って","もって"],["行って","いって"],["、"],["神","かみ"],["の"],["人","ひと"],["を"],["迎え","むかえ"],["、"],["私","わたくし"],["の"],["この"],["病気","びょうき"],["が"],["直る","なおる"],["か"],["どう"],["か"],["、"],["あの"],["人","ひと"],["を"],["通して","とおして"],["主","ぬし"],["のみ"],["こころ"],["を"],["求めて","もとめて"],["くれ"],["。"],["」"]]},{"verse":9,"text":"そこで、ハザエルはダマスコのあらゆる良い物をらくだ四十頭に載せ、贈り物として携えて、彼を迎えに行った。彼は神の人の前に行って立ち、そして言った。「あなたの子、アラムの王ベン・ハダデが、『この病気は直るであろうか』と言ってあなたのところへ私をよこしました。」","tok":[["そこ"],["で"],["、"],["ハザエル"],["は"],["ダマスコ"],["の"],["あらゆる"],["良い","よい"],["物","もの"],["を"],["らくだ"],["四十頭","よんじゅうとう"],["に"],["載せ","のせ"],["、"],["贈り物","おくりもの"],["として"],["携えて","たずさえて"],["、"],["彼","かれ"],["を"],["迎え","むかえ"],["に"],["行った","いった"],["。"],["彼","かれ"],["は"],["神","かみ"],["の"],["人","ひと"],["の"],["前","まえ"],["に"],["行って","いって"],["立ち","たち"],["、"],["そして"],["言った","いった"],["。"],["「"],["あなた"],["の"],["子","こ"],["、"],["アラム"],["の"],["王","おう"],["ベン"],["・"],["ハダデ"],["が"],["、"],["『"],["この"],["病気","びょうき"],["は"],["直るで","なおるで"],["あろう"],["か"],["』"],["と"],["言って","いって"],["あなた"],["の"],["ところ"],["へ"],["私","わたくし"],["を"],["よこしました"],["。"],["」"]]},{"verse":10,"text":"エリシャは彼に言った。「行って、『あなたは必ず直る』と彼に告げなさい。しかし、主は私に、彼が必ず死ぬことも示された。」","tok":[["エリシャ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["行って","いって"],["、"],["『"],["あなた"],["は"],["必ず","かならず"],["直る","なおる"],["』"],["と"],["彼","かれ"],["に"],["告げ","つげ"],["なさい"],["。"],["しかし"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["、"],["彼","かれ"],["が"],["必ず","かならず"],["死ぬ","しぬ"],["こと"],["も"],["示された","しめされた"],["。"],["」"]]},{"verse":11,"text":"神の人は、彼が恥じるほど、じっと彼を見つめ、そして泣き出したので、","tok":[["神","かみ"],["の"],["人","ひと"],["は"],["、"],["彼","かれ"],["が"],["恥じる","はじる"],["ほど"],["、"],["じっと"],["彼","かれ"],["を"],["見つめ","みつめ"],["、"],["そして"],["泣き","なき"],["出した","だした"],["ので"],["、"]]},{"verse":12,"text":"ハザエルは尋ねた。「あなたさまは、なぜ泣くのですか。」エリシャは答えた。「私は、あなたがイスラエルの人々に害を加えようとしていることを知っているからだ。あなたは、彼らの要塞に火を放ち、その若い男たちを剣で切り殺し、幼子たちを八つ裂きにし、妊婦たちを切り裂くだろう。」","tok":[["ハザエル"],["は"],["尋ねた","たずねた"],["。"],["「"],["あなた"],["さま"],["は"],["、"],["なぜ"],["泣く","なく"],["の"],["です"],["か"],["。"],["」"],["エリシャ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["、"],["あなた"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["として"],["いる"],["こと"],["を"],["知って","しって"],["いる"],["から"],["だ"],["。"],["あなた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["要塞","ようさい"],["に"],["火","ひ"],["を"],["放ち","はなち"],["、"],["その"],["若い","わかい"],["男","おとこ"],["たち"],["を"],["剣","けん"],["で"],["切り殺し","きりころし"],["、"],["幼子","おさなご"],["たち"],["を"],["八つ裂き","やつざき"],["に"],["し"],["、"],["妊婦","にんぷ"],["たち"],["を"],["切り裂くだろう","きりさくだろう"],["。"],["」"]]},{"verse":13,"text":"ハザエルは言った。「しもべは犬にすぎないのに、どうして、そんなだいそれたことができましょう。」しかし、エリシャは言った。「主は私に、あなたがアラムの王になると、示されたのだ。」","tok":[["ハザエル"],["は"],["言った","いった"],["。"],["「"],["しもべ"],["は"],["犬","いぬ"],["に"],["すぎない"],["のに"],["、"],["どう"],["して"],["、"],["そんな"],["だいそれた"],["こと"],["が"],["できましょう"],["。"],["」"],["しかし"],["、"],["エリシャ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["私","わたくし"],["に"],["、"],["あなた"],["が"],["アラム"],["の"],["王","おう"],["に"],["なる"],["と"],["、"],["示された","しめされた"],["の"],["だ"],["。"],["」"]]},{"verse":14,"text":"彼はエリシャのもとを去り、自分の主君のところに帰った。王が彼に、「エリシャはあなたに何と言ったか」と尋ねると、彼は、「あなたは必ず直る、と彼は言いました」と答えた。","tok":[["彼","かれ"],["は"],["エリシャ"],["の"],["もと"],["を"],["去り","さり"],["、"],["自分","じぶん"],["の"],["主君","しゅくん"],["の"],["ところ"],["に"],["帰った","かえった"],["。"],["王","おう"],["が"],["彼","かれ"],["に"],["、"],["「"],["エリシャ"],["は"],["あなた"],["に"],["何","なん"],["と"],["言った","いった"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["彼","かれ"],["は"],["、"],["「"],["あなた"],["は"],["必ず","かならず"],["直る","なおる"],["、"],["と"],["彼","かれ"],["は"],["言いました","いいました"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":15,"text":"しかし、翌日、ハザエルは毛布を取って、それを水に浸し、王の顔にかぶせたので、王は死んだ。こうして、ハザエルは彼に代わって王となった。","tok":[["しかし"],["、"],["翌日","よくじつ"],["、"],["ハザエル"],["は"],["毛布","もうふ"],["を"],["取って","とって"],["、"],["それ"],["を"],["水","みず"],["に"],["浸し","ひたし"],["、"],["王","おう"],["の"],["顔","かお"],["に"],["かぶせた"],["ので"],["、"],["王","おう"],["は"],["死んだ","しんだ"],["。"],["こう"],["して"],["、"],["ハザエル"],["は"],["彼","かれ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":16,"text":"イスラエルの王アハブの子ヨラムの第五年に――ヨシャパテがユダの王であったが――ユダの王ヨシャパテの子ヨラムが王となった。","tok":[["イスラエル"],["の"],["王","おう"],["アハブ"],["の"],["子","こ"],["ヨラム"],["の"],["第","だい"],["五","ご"],["年","ねん"],["に"],["―"],["―"],["ヨシャパテ"],["が"],["ユダ"],["の"],["王","おう"],["で"],["あった"],["が"],[
[{"verse":1,"text":"ヨシヤは八歳で王となり、エルサレムで三十一年間、王であった。彼の母の名はエディダといい、ボツカテの出のアダヤの娘であった。","tok":[["ヨシヤ"],["は"],["八歳","はちさい"],["で"],["王","おう"],["と"],["なり"],["、"],["エルサレム"],["で"],["三十一","さんじゅういち"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"],["彼","かれ"],["の"],["母","はは"],["の"],["名","な"],["は"],["エディダ"],["と"],["いい"],["、"],["ボツカテ"],["の"],["出","で"],["の"],["アダヤ"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼は主の目にかなうことを行って、先祖ダビデのすべての道に歩み、右にも左にもそれなかった。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["かなう"],["こと"],["を"],["行って","おこなって"],["、"],["先祖","せんぞ"],["ダビデ"],["の"],["すべて"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それ"],["なかった"],["。"]]},{"verse":3,"text":"ヨシヤ王の第十八年に、王はメシュラムの子アツァルヤの子である書記シャファンを主の宮に遣わして言った。","tok":[["ヨシヤ"],["王","おう"],["の"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["に"],["、"],["王","おう"],["は"],["メシュラム"],["の"],["子","こ"],["アツァルヤ"],["の"],["子","こ"],["で"],["ある"],["書記","しょき"],["シャファン"],["を"],["主","ぬし"],["の"],["宮","みや"],["に"],["遣わして","つかわして"],["言った","いった"],["。"]]},{"verse":4,"text":"「大祭司ヒルキヤのもとに上って行き、主の宮に納められた金、すなわち、入口を守る者たちが民から集めたものを彼に計算させ、","tok":[["「"],["大","だい"],["祭司","さいし"],["ヒルキヤ"],["の"],["もと"],["に"],["上って","のぼって"],["行き","いき"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["納められた","おさめられた"],["金","きん"],["、"],["すなわち"],["、"],["入口","いりぐち"],["を"],["守る","まもる"],["者","もの"],["たち"],["が"],["民","たみ"],["から"],["集めた","あつめた"],["もの"],["を"],["彼","かれ"],["に"],["計算","けいさん"],["させ"],["、"]]},{"verse":5,"text":"それを主の宮で工事している監督者たちの手に渡しなさい。それを主の宮で工事している者たちに渡し、宮の破損の修理をさせなさい。","tok":[["それ"],["を"],["主","ぬし"],["の"],["宮","みや"],["で"],["工事","こうじ"],["して"],["いる"],["監督者","かんとくしゃ"],["たち"],["の"],["手","て"],["に"],["渡し","わたし"],["なさい"],["。"],["それ"],["を"],["主","ぬし"],["の"],["宮","みや"],["で"],["工事","こうじ"],["して"],["いる"],["者","もの"],["たち"],["に"],["渡し","わたし"],["、"],["宮","みや"],["の"],["破損","はそん"],["の"],["修理","しゅうり"],["を"],["させ"],["なさい"],["。"]]},{"verse":6,"text":"木工、建築師、石工に渡し、また宮の修理のための木材や切り石を買わせなさい。","tok":[["木工","もっこう"],["、"],["建築師","けんちくし"],["、"],["石工","せっこう"],["に"],["渡し","わたし"],["、"],["また"],["宮","みや"],["の"],["修理","しゅうり"],["の"],["ため"],["の"],["木材","もくざい"],["や"],["切り石","きりいし"],["を"],["買わせ","かわせ"],["なさい"],["。"]]},{"verse":7,"text":"ただし、彼らの手に渡した金を彼らといっしょに勘定してはならない。彼らは忠実に働いているからである。」","tok":[["ただし"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡した","わたした"],["金","かね"],["を"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["勘定","かんじょう"],["して"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["忠実","ちゅうじつ"],["に"],["働いて","はたらいて"],["いる"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":8,"text":"そのとき、大祭司ヒルキヤは書記シャファンに、「私は主の宮で律法の書を見つけました」と言って、その書物をシャファンに渡したので、彼はそれを読んだ。","tok":[["その"],["とき"],["、"],["大","だい"],["祭司","さいし"],["ヒルキヤ"],["は"],["書記","しょき"],["シャファン"],["に"],["、"],["「"],["私","わたくし"],["は"],["主","ぬし"],["の"],["宮","みや"],["で"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["見つけました","みつけました"],["」"],["と"],["言って","いって"],["、"],["その"],["書物","しょもつ"],["を"],["シャファン"],["に"],["渡した","わたした"],["ので"],["、"],["彼","かれ"],["は"],["それ"],["を"],["読んだ","よんだ"],["。"]]},{"verse":9,"text":"書記シャファンは王のもとに行って、王に報告して言った。「しもべたちは、宮にあった金を箱からあけて、これを主の宮で工事している監督者たちの手に渡しました。」","tok":[["書記","しょき"],["シャファン"],["は"],["王","おう"],["の"],["もと"],["に"],["行って","いって"],["、"],["王","おう"],["に"],["報告","ほうこく"],["して"],["言った","いった"],["。"],["「"],["しもべ"],["たち"],["は"],["、"],["宮","みや"],["に"],["あった"],["金","かね"],["を"],["箱","ばこ"],["から"],["あけて"],["、"],["これ"],["を"],["主","ぬし"],["の"],["宮","みや"],["で"],["工事","こうじ"],["して"],["いる"],["監督者","かんとくしゃ"],["たち"],["の"],["手","て"],["に"],["渡しました","わたしました"],["。"],["」"]]},{"verse":10,"text":"ついで、書記シャファンは王に告げて、言った。「祭司ヒルキヤが私に一つの書物を渡してくれました。」そして、シャファンは王の前でそれを読み上げた。","tok":[["つい"],["で"],["、"],["書記","しょき"],["シャファン"],["は"],["王","おう"],["に"],["告げて","つげて"],["、"],["言った","いった"],["。"],["「"],["祭司","さいし"],["ヒルキヤ"],["が"],["私","わたくし"],["に"],["一","ひと"],["つ"],["の"],["書物","しょもつ"],["を"],["渡して","わたして"],["くれました"],["。"],["」"],["そして"],["、"],["シャファン"],["は"],["王","おう"],["の"],["前","まえ"],["で"],["それ"],["を"],["読み上げた","よみあげた"],["。"]]},{"verse":11,"text":"王は律法の書のことばを聞いたとき、自分の衣を裂いた。","tok":[["王","おう"],["は"],["律法","りっぽう"],["の"],["書","しょ"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["裂いた","さいた"],["。"]]},{"verse":12,"text":"王は祭司ヒルキヤ、シャファンの子アヒカム、ミカヤの子アクボル、書記シャファン、王の家来アサヤに命じて言った。","tok":[["王","おう"],["は"],["祭司","さいし"],["ヒルキヤ"],["、"],["シャファン"],["の"],["子","こ"],["アヒカム"],["、"],["ミカヤ"],["の"],["子","こ"],["アクボル"],["、"],["書記","しょき"],["シャファン"],["、"],["王","おう"],["の"],["家来","けらい"],["アサヤ"],["に"],["命じて","めいじて"],["言った","いった"],["。"]]},{"verse":13,"text":"「行って、この見つかった書物のことばについて、私のため、民のため、ユダ全体のために、主のみこころを求めなさい。私たちの先祖が、この書物のことばに聞き従わず、すべて私たちについてしるされているとおりに行わなかったため、私たちに向かって燃え上がった主の憤りは激しいから。」","tok":[["「"],["行って","いって"],["、"],["この"],["見つかった","みつかった"],["書物","しょもつ"],["の"],["ことば"],["について"],["、"],["私","わたくし"],["の"],["ため"],["、"],["民","みん"],["の"],["ため"],["、"],["ユダ"],["全体","ぜんたい"],["の"],["ため"],["に"],["、"],["主","ぬし"],["のみ"],["こころ"],["を"],["求め","もとめ"],["なさい"],["。"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["が"],["、"],["この"],["書物","しょもつ"],["の"],["ことば"],["に"],["聞き従わず","ききしたがわず"],["、"],["すべて"],["私たち","わたしたち"],["について"],["しるされて"],["いる"],["とおり"],["に"],["行わなかった","おこなわなかった"],["ため"],["、"],["私たち","わたしたち"],["に"],["向かって","むかって"],["燃え上がった","もえあがった"],["主","ぬし"],["の"],["憤り","いきどおり"],["は"],["激しい","はげしい"],["から"],["。"],["」"]]},{"verse":14,"text":"そこで、祭司ヒルキヤ、アヒカム、アクボル、シャファン、アサヤは、女預言者フルダのもとに行った。彼女は、ハルハスの子ティクワの子、装束係シャルムの妻で、エルサレムの第二区に住んでいた。彼らが彼女に伝えると、","tok":[["そこ"],["で"],["、"],["祭司","さいし"],["ヒルキヤ"],["、"],["アヒカム"],["、"],["アクボル"],["、"],["シャファン"],["、"],["アサヤ"],["は"],["、"],["女","おんな"],["預言者","よげんしゃ"],["フルダ"],["の"],["もと"],["に"],["行った","いった"],["。"],["彼女","かのじょ"],["は"],["、"],["ハルハス"],["の"],["子","こ"],["ティクワ"],["の"],["子","こ"],["、"],["装束","しょうぞく"],["係","かかり"],["シャルム"],["の"],["妻","つま"],["で"],["、"],["エルサレム"],["の"],["第","だい"],["二区","にく"],["に"],["住んで","すんで"],["いた"],["。"],["彼","かれ"],["ら"],["が"],["彼女","かのじょ"],["に"],["伝える","つたえる"],["と"],["、"]]},{"verse":15,"text":"彼女は彼らに答えた。「イスラエルの神、主は、こう仰せられます。『あなたがたをわたしのもとに遣わした人に告げよ。","tok":[["彼女","かのじょ"],["は"],["彼","かれ"],["ら"],["に"],["答えた","こたえた"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["あなた"],["がた"],["を"],["わたし"],["の"],["もと"],["に"],["遣わした","つかわした"],["人","ひと"],["に"],["告げ","つげ"],["よ"],["。"]]},{"verse":16,"text":"主はこう仰せられる。見よ。わたしは、この場所とその住民の上にわざわいをもたらす。ユダの王が読み上げた書物のすべてのことばを成就する。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["この"],["場所","ばしょ"],["と"],["その"],["住民","じゅうみん"],["の"],["上","うえ"],["に"],["わざわい"],["を"],["もたらす"],["。"],["ユダ"],["の"],["王","おう"],["が"],["読み上げた","よみあげた"],["書物","しょもつ"],["の"],["すべて"],["の"],["ことば"],["を"],["成就","じょうじゅ"],["する"],["。"]]},{"verse":17,"text":"彼らはわたしを捨て、ほかの神々に香をたき、彼らのすべての手のわざで、わたしの怒りを引き起こすようにした。わたしの憤りはこの場所に燃え上がり、消えることがない。』","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["を"],["捨て","すて"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["、"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["手","て"],["の"],["わざ"],["で"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こす","ひきおこす"],["よう"],["に"],["した"],["。"],["わたし"],["の"],["憤り","いきどおり"],["は"],["この"],["場所","ばしょ"],["に"],["燃え上がり","もえあがり"],["、"],["消える","きえる"],["こと"],["が"],["ない"],["。"],["』"]]},{"verse":18,"text":"主のみこころを求めるために、あなたがたを遣わしたユダの王には、こう言わなければなりません。『あなたが聞いたことばについて、イスラエルの神、主は、こう仰せられます。","tok":[["主","ぬし"],["のみ"],["こころ"],["を"],["求める","もとめる"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["遣わした","つかわした"],["ユダ"],["の"],["王","おう"],["に"],["は"],["、"],["こう"],["言わなければ","いわなければ"],["なりません"],["。"],["『"],["あなた"],["が"],["聞いた","きいた"],["ことば"],["について"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられます","おおせられます"],["。"]]},{"verse":19,"text":"あなたが、この場所とその住民について、これは恐怖となり、のろいとなると、わたしが言ったのを聞いたとき、あなたは心を痛め、主の前にへりくだり、自分の衣を裂き、わたしの前で泣いたので、わたしもまた、あなたの願いを聞き入れる。――主の御告げです――","tok":[["あなた"],["が"],["、"],["この"],["場所","ばしょ"],["と"],["その"],["住民","じゅうみん"],["について"],["、"],["これ"],["は"],["恐怖","きょうふ"],["と"],["なり"],["、"],["のろい"],["と"],["なる"],["と"],["、"],["わたし"],["が"],["言った","いった"],["の"],["を"],["聞いた","きいた"],["とき"],["、"],["あなた"],["は"],["心","こころ"],["を"],["痛め","いため"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["へりくだり"],["、"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["裂き","さき"],["、"],["わたし"],["の"],["前","まえ"],["で"],["泣いた","ないた"],["ので"],["、"],["わたし"],["も"],["また"],["、"],["あなた"],["の"],["願い","ねがい"],["を"],["聞き入れる","ききいれる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["です"],["―"],["―"]]},{"verse":20,"text":"それゆえ、見よ、わたしは、あなたを先祖たちのもとに集めよう。あなたは安らかに自分の墓に集められる。それで、あなたは自分の目で、わたしがこの場所にもたらすすべてのわざわいを見ることがない。』」彼らはそれを王に報告した。","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["あなた"],["を"],["先祖","せんぞ"],["たち"],["の"],["もと"],["に"],["集めよう","あつめよう"],["。"],["あなた"],["は"],["安らか","やすらか"],["に"],["自分","じぶん"],["の"],["墓","はか"],["に"],["集められる","あつめられる"],["。"],["それ"],["で"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["目","め"],["で"],["、"],["わたし"],["が"],["この"],["場所","ばしょ"],["に"],["もたらす"],["すべて"],["の"],["わざわい"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"],["』"],["」"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["王","おう"],["に"],["報告","ほうこく"],["した"],["。"]]}]
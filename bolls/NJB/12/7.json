[{"verse":1,"text":"エリシャは言った。「主のことばを聞きなさい。主はこう仰せられる。『あすの今ごろ、サマリヤの門で、上等の小麦粉一セアが一シェケルで、大麦二セアが一シェケルで売られるようになる。』」","tok":[["エリシャ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["ことば"],["を"],["聞き","きき"],["なさい"],["。"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あす"],["の"],["今ごろ","いまごろ"],["、"],["サマリヤ"],["の"],["門","もん"],["で"],["、"],["上等","じょうとう"],["の"],["小麦粉","こむぎこ"],["一","いち"],["セア"],["が"],["一","いち"],["シェケル"],["で"],["、"],["大麦","おおむぎ"],["二","に"],["セア"],["が"],["一","いち"],["シェケル"],["で"],["売られる","うられる"],["よう"],["に"],["なる"],["。"],["』"],["」"]]},{"verse":2,"text":"しかし、侍従で、王がその腕に寄りかかっていた者が、神の人に答えて言った。「たとい、主が天に窓を作られるにしても、そんなことがあるだろうか。」そこで、彼は言った。「確かに、あなたは自分の目でそれを見るが、それを食べることはできない。」","tok":[["しかし"],["、"],["侍従","じじゅう"],["で"],["、"],["王","おう"],["が"],["その"],["腕","うで"],["に"],["寄りかかって","よりかかって"],["いた"],["者","もの"],["が"],["、"],["神","かみ"],["の"],["人","ひと"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["たとい"],["、"],["主","ぬし"],["が"],["天","てん"],["に"],["窓","まど"],["を"],["作られる","つくられる"],["に"],["して"],["も"],["、"],["そんな"],["こと"],["が"],["あるだろう"],["か"],["。"],["」"],["そこ"],["で"],["、"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["確か","たしか"],["に"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["目","め"],["で"],["それ"],["を"],["見る","みる"],["が"],["、"],["それ"],["を"],["食べる","たべる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":3,"text":"さて、四人のツァラアトに冒された人が、町の門の入口にいた。彼らは互いに言った。「私たちはどうして死ぬまでここにすわっていなければならないのだろうか。","tok":[["さて"],["、"],["四人","よんにん"],["の"],["ツァラアト"],["に"],["冒された","おかされた"],["人","ひと"],["が"],["、"],["町","まち"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["どう"],["して"],["死ぬ","しぬ"],["まで"],["ここ"],["に"],["すわって"],["いなければ"],["ならない"],["の"],["だろう"],["か"],["。"]]},{"verse":4,"text":"たとい、私たちが町に入ろうと言っても、町はききんなので、私たちはそこで死ななければならない。ここにすわっていても死んでしまう。さあ今、アラムの陣営に入り込もう。もし彼らが私たちを生かしておいてくれるなら、私たちは生きのびられる。もし殺すなら、そのときは死ぬまでのことだ。」","tok":[["たとい"],["、"],["私たち","わたしたち"],["が"],["町","まち"],["に"],["入ろう","はいろう"],["と"],["言って","いって"],["も"],["、"],["町","まち"],["は"],["ききん"],["な"],["ので"],["、"],["私たち","わたしたち"],["は"],["そこ"],["で"],["死ななければ","しななければ"],["ならない"],["。"],["ここ"],["に"],["すわって"],["いて"],["も"],["死んで","しんで"],["しまう"],["。"],["さあ"],["今","いま"],["、"],["アラム"],["の"],["陣営","じんえい"],["に"],["入り込もう","はいりこもう"],["。"],["もし"],["彼","かれ"],["ら"],["が"],["私たち","わたしたち"],["を"],["生かして","いかして"],["おいて"],["くれるなら"],["、"],["私たち","わたしたち"],["は"],["生きのびられる","いきのびられる"],["。"],["もし"],["殺すなら","ころすなら"],["、"],["その"],["とき"],["は"],["死ぬ","しぬ"],["まで"],["の"],["こと"],["だ"],["。"],["」"]]},{"verse":5,"text":"こうして、彼らはアラムの陣営に行こうと、夕暮れになって立ち上がり、アラムの陣営の端まで来た。見ると、なんと、そこにはだれもいなかった。","tok":[["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["アラム"],["の"],["陣営","じんえい"],["に"],["行こう","いこう"],["と"],["、"],["夕暮れ","ゆうぐれ"],["に"],["なって"],["立ち上がり","たちあがり"],["、"],["アラム"],["の"],["陣営","じんえい"],["の"],["端","はし"],["まで"],["来た","きた"],["。"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["そこ"],["に"],["は"],["だれ"],["も"],["いなかった"],["。"]]},{"verse":6,"text":"主がアラムの陣営に、戦車の響き、馬のいななき、大軍勢の騒ぎを聞かせられたので、彼らは口々に、「あれ。イスラエルの王が、ヘテ人の王たち、エジプトの王たちを雇って、われわれを襲うのだ」と言って、","tok":[["主","ぬし"],["が"],["アラム"],["の"],["陣営","じんえい"],["に"],["、"],["戦車","せんしゃ"],["の"],["響き","ひびき"],["、"],["馬","うま"],["の"],["いななき"],["、"],["大軍勢","たいぐんぜい"],["の"],["騒ぎ","さわぎ"],["を"],["聞かせられた","きかせられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["口々","くちぐち"],["に"],["、"],["「"],["あれ"],["。"],["イスラエル"],["の"],["王","おう"],["が"],["、"],["ヘテ人","へてにん"],["の"],["王","おう"],["たち"],["、"],["エジプト"],["の"],["王","おう"],["たち"],["を"],["雇って","やとって"],["、"],["われわれ"],["を"],["襲う","おそう"],["の"],["だ"],["」"],["と"],["言って","いって"],["、"]]},{"verse":7,"text":"夕暮れになると、彼らは立って逃げ、彼らの天幕や馬やろば、すなわち、陣営をそのまま置き去りにして、いのちからがら逃げ去ったのであった。","tok":[["夕暮れ","ゆうぐれ"],["に"],["なる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["立って","たって"],["逃げ","にげ"],["、"],["彼","かれ"],["ら"],["の"],["天幕","てんまく"],["や"],["馬","うま"],["やろば"],["、"],["すなわち"],["、"],["陣営","じんえい"],["を"],["そのまま"],["置き去り","おきざり"],["に"],["して"],["、"],["いのち"],["からがら"],["逃げ去った","にげさった"],["ので"],["あった"],["。"]]},{"verse":8,"text":"このツァラアトに冒された人たちは、陣営の端に来て、一つの天幕に入り、食べたり飲んだりして、そこから、銀や金や衣服を持ち出し、それを隠しに行った。また、戻って来ては、ほかの天幕に入り、そこから持ち出し、それを隠しに行った。","tok":[["この"],["ツァラアト"],["に"],["冒された","おかされた"],["人","ひと"],["たち"],["は"],["、"],["陣営","じんえい"],["の"],["端","はし"],["に"],["来て","きて"],["、"],["一","ひと"],["つ"],["の"],["天幕","てんまく"],["に"],["入り","はいり"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["して"],["、"],["そこ"],["から"],["、"],["銀","ぎん"],["や"],["金","きん"],["や"],["衣服","いふく"],["を"],["持ち出し","もちだし"],["、"],["それ"],["を"],["隠し","かくし"],["に"],["行った","いった"],["。"],["また"],["、"],["戻って","もどって"],["来て","きて"],["は"],["、"],["ほか"],["の"],["天幕","てんまく"],["に"],["入り","はいり"],["、"],["そこ"],["から"],["持ち出し","もちだし"],["、"],["それ"],["を"],["隠し","かくし"],["に"],["行った","いった"],["。"]]},{"verse":9,"text":"彼らは話し合って言った。「私たちのしていることは正しくない。きょうは、良い知らせの日なのに、私たちはためらっている。もし明け方まで待っていたら、私たちは罰を受けるだろう。さあ、行って、王の家に知らせよう。」","tok":[["彼","かれ"],["ら"],["は"],["話し合って","はなしあって"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["の"],["して"],["いる"],["こと"],["は"],["正しく","ただしく"],["ない"],["。"],["きょう"],["は"],["、"],["良い","よい"],["知らせ","しらせ"],["の"],["日","ひ"],["な"],["のに"],["、"],["私たち","わたしたち"],["は"],["ためらって"],["いる"],["。"],["もし"],["明け方","あけがた"],["まで"],["待って","まって"],["いたら"],["、"],["私たち","わたしたち"],["は"],["罰","ばつ"],["を"],["受けるだろう","うけるだろう"],["。"],["さあ"],["、"],["行って","いって"],["、"],["王","おう"],["の"],["家","いえ"],["に"],["知らせよう","しらせよう"],["。"],["」"]]},{"verse":10,"text":"彼らは町に行って、門衛を呼び、彼らに告げて言った。「私たちがアラムの陣営に入ってみると、もう、そこにはだれもおらず、人の声もありませんでした。ただ、馬やろばがつながれたままで、天幕もそっくりそのままでした。」","tok":[["彼","かれ"],["ら"],["は"],["町","まち"],["に"],["行って","いって"],["、"],["門衛","もんえい"],["を"],["呼び","よび"],["、"],["彼","かれ"],["ら"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["が"],["アラム"],["の"],["陣営","じんえい"],["に"],["入って","はいって"],["みる"],["と"],["、"],["もう"],["、"],["そこ"],["に"],["は"],["だれ"],["も"],["おらず"],["、"],["人","ひと"],["の"],["声","こえ"],["も"],["ありませんでした"],["。"],["ただ"],["、"],["馬","うま"],["や"],["ろば"],["が"],["つながれた"],["まま"],["で"],["、"],["天幕","てんまく"],["も"],["そっくり"],["そのまま"],["でした"],["。"],["」"]]},{"verse":11,"text":"そこで門衛たちは叫んで、門のうちの王の家に告げた。","tok":[["そこ"],["で"],["門衛","もんえい"],["たち"],["は"],["叫んで","さけんで"],["、"],["門","もん"],["の"],["うち"],["の"],["王","おう"],["の"],["家","いえ"],["に"],["告げた","つげた"],["。"]]},{"verse":12,"text":"王は夜中に起きて家来たちに言った。「アラムが私たちに対して計ったことをあなたがたに教えよう。彼らは私たちが飢えているのを知っているので、陣営から出て行って野に隠れ、あいつらが町から出て来たら、生けどりにし、それから町に押し入ろう、と考えているのだ。」","tok":[["王","おう"],["は"],["夜中","よなか"],["に"],["起きて","おきて"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["アラム"],["が"],["私たち","わたしたち"],["に対して","にたいして"],["計った","はかった"],["こと"],["を"],["あなた"],["がた"],["に"],["教えよう","おしえよう"],["。"],["彼","かれ"],["ら"],["は"],["私たち","わたしたち"],["が"],["飢えて","うえて"],["いる"],["の"],["を"],["知って","しって"],["いる"],["ので"],["、"],["陣営","じんえい"],["から"],["出て","でて"],["行って","いって"],["野","の"],["に"],["隠れ","かくれ"],["、"],["あいつ"],["ら"],["が"],["町","まち"],["から"],["出て","でて"],["来たら","きたら"],["、"],["生けどり","いけどり"],["に"],["し"],["、"],["それ"],["から"],["町","まち"],["に"],["押し入ろう","おしいろう"],["、"],["と"],["考えて","かんがえて"],["いる"],["の"],["だ"],["。"],["」"]]},{"verse":13,"text":"すると、家来のひとりが答えて言った。「それでは、だれかにこの町に残っている馬の中から五頭だけ取らせ、その者たちを遣わして偵察してみましょう。どうせ彼らはこの町に残っているイスラエルの全民衆と同じめに会い、または、すでに滅ぼされたイスラエルの全民衆と同じめに会うのですから。」","tok":[["する"],["と"],["、"],["家来","けらい"],["の"],["ひとり"],["が"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["それ"],["で"],["は"],["、"],["だれ"],["か"],["に"],["この"],["町","まち"],["に"],["残って","のこって"],["いる"],["馬","うま"],["の"],["中","なか"],["から"],["五頭","ごとう"],["だけ"],["取らせ","とらせ"],["、"],["その"],["者","もの"],["たち"],["を"],["遣わして","つかわして"],["偵察","ていさつ"],["して"],["みましょう"],["。"],["どうせ"],["彼","かれ"],["ら"],["は"],["この"],["町","まち"],["に"],["残って","のこって"],["いる"],["イスラエル"],["の"],["全","ぜん"],["民衆","みんしゅう"],["と"],["同じ","おなじ"],["め"],["に"],["会い","あい"],["、"],["また"],["は"],["、"],["すでに"],["滅ぼされた","ほろぼされた"],["イスラエル"],["の"],["全","ぜん"],["民衆","みんしゅう"],["と"],["同じ","おなじ"],["め"],["に"],["会う","あう"],["の"],["です"],["から"],["。"],["」"]]},{"verse":14,"text":"彼らが二台分の戦車の馬を取ると、王は、「行って、偵察して来なさい」と命じ、アラムの陣営のあとを追わせた。","tok":[["彼","かれ"],["ら"],["が"],["二","に"],["台","だい"],["分","ぶん"],["の"],["戦車","せんしゃ"],["の"],["馬","うま"],["を"],["取る","とる"],["と"],["、"],["王","おう"],["は"],["、"],["「"],["行って","いって"],["、"],["偵察","ていさつ"],["して"]
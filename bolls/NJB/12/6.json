[{"verse":1,"text":"預言者のともがらがエリシャに、「ご覧のとおり、私たちがあなたといっしょに住んでいるこの場所は狭くなりましたので、","tok":[["預言者","よげんしゃ"],["の"],["とも"],["がら"],["が"],["エリシャ"],["に"],["、"],["「"],["ご覧","ごらん"],["の"],["とおり"],["、"],["私たち","わたしたち"],["が"],["あなた"],["と"],["いっしょ"],["に"],["住んで","すんで"],["いる"],["この"],["場所","ばしょ"],["は"],["狭く","せまく"],["なりました"],["ので"],["、"]]},{"verse":2,"text":"ヨルダン川に行きましょう。そこからめいめい一本ずつ材木を切り出して、そこに、私たちの住む所を作りましょう」と言うと、エリシャは、「行きなさい」と言った。","tok":[["ヨルダン"],["川","かわ"],["に"],["行きましょう","いきましょう"],["。"],["そこ"],["から"],["めいめい"],["一本","いちぽん"],["ずつ"],["材木","ざいもく"],["を"],["切り出して","きりだして"],["、"],["そこ"],["に"],["、"],["私たち","わたしたち"],["の"],["住む","すむ"],["所","ところ"],["を"],["作りましょう","つくりましょう"],["」"],["と"],["言う","ゆう"],["と"],["、"],["エリシャ"],["は"],["、"],["「"],["行き","いき"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"すると、そのひとりが、「あなたもどうか、思い切ってしもべたちといっしょに行ってください」と言ったので、エリシャは、「では、私も行こう」と言って、","tok":[["する"],["と"],["、"],["その"],["ひとり"],["が"],["、"],["「"],["あなた"],["も"],["どう"],["か"],["、"],["思い切って","おもいきって"],["しもべ"],["たち"],["と"],["いっしょ"],["に"],["行って","いって"],["ください"],["」"],["と"],["言った","いった"],["ので"],["、"],["エリシャ"],["は"],["、"],["「"],["で"],["は"],["、"],["私","わたくし"],["も"],["行こう","いこう"],["」"],["と"],["言って","いって"],["、"]]},{"verse":4,"text":"彼らといっしょに出かけた。彼らは、ヨルダン川に着くと、木を切り倒した。","tok":[["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["出かけた","でかけた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["ヨルダン"],["川","かわ"],["に"],["着く","つく"],["と"],["、"],["木","き"],["を"],["切り倒した","きりたおした"],["。"]]},{"verse":5,"text":"ひとりが材木を倒しているとき、斧の頭を水の中に落としてしまった。彼は叫んで言った。「ああ、わが主。あれは借り物です。」","tok":[["ひとり"],["が"],["材木","ざいもく"],["を"],["倒して","たおして"],["いる"],["とき"],["、"],["斧","おの"],["の"],["頭","あたま"],["を"],["水","みず"],["の"],["中","なか"],["に"],["落として","おとして"],["しまった"],["。"],["彼","かれ"],["は"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["ああ"],["、"],["わが"],["主","ぬし"],["。"],["あれ"],["は"],["借り物","かりもの"],["です"],["。"],["」"]]},{"verse":6,"text":"神の人は言った。「どこに落としたのか。」彼がその場所を示すと、エリシャは一本の枝を切って、そこに投げ込み、斧の頭を浮かばせた。","tok":[["神","かみ"],["の"],["人","ひと"],["は"],["言った","いった"],["。"],["「"],["どこ"],["に"],[
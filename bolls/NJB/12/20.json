[{"verse":1,"text":"そのころ、ヒゼキヤは病気になって死にかかっていた。そこへ、アモツの子、預言者イザヤが来て、彼に言った。「主はこう仰せられます。『あなたの家を整理せよ。あなたは死ぬ。直らない。』」","tok":[["その"],["ころ"],["、"],["ヒゼキヤ"],["は"],["病気","びょうき"],["に"],["なって"],["死にかかって","しにかかって"],["いた"],["。"],["そこ"],["へ"],["、"],["アモツ"],["の"],["子","こ"],["、"],["預言者","よげんしゃ"],["イザヤ"],["が"],["来て","きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["あなた"],["の"],["家","いえ"],["を"],["整理","せいり"],["せよ"],["。"],["あなた"],["は"],["死ぬ","しぬ"],["。"],["直らない","なおらない"],["。"],["』"],["」"]]},{"verse":2,"text":"そこでヒゼキヤは顔を壁に向けて、主に祈って、言った。","tok":[["そこ"],["で"],["ヒゼキヤ"],["は"],["顔","かお"],["を"],["壁","かべ"],["に"],["向けて","むけて"],["、"],["主に","おもに"],["祈って","いのって"],["、"],["言った","いった"],["。"]]},{"verse":3,"text":"「ああ、主よ。どうか思い出してください。私が、まことを尽くし、全き心をもって、あなたの御前に歩み、あなたがよいと見られることを行ってきたことを。」こうして、ヒゼキヤは大声で泣いた。","tok":[["「"],["ああ"],["、"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["思い出して","おもいだして"],["ください"],["。"],["私","わたくし"],["が"],["、"],["まこと"],["を"],["尽くし","つくし"],["、"],["全","ぜん"],["き"],["心","こころ"],["を"],["もって"],["、"],["あなた"],["の"],["御前","ごぜん"],["に"],["歩み","あゆみ"],["、"],["あなた"],["が"],["よい"],["と"],["見られる","みられる"],["こと"],["を"],["行って","おこなって"],["きた"],["こと"],["を"],["。"],["」"],["こう"],["して"],["、"],["ヒゼキヤ"],["は"],["大声","おおごえ"],["で"],["泣いた","ないた"],["。"]]},{"verse":4,"text":"イザヤがまだ中庭を出ないうちに、次のような主のことばが彼にあった。","tok":[["イザヤ"],["が"],["まだ"],["中庭","なかにわ"],["を"],["出ない","でない"],["うち"],["に"],["、"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["彼","かれ"],["に"],["あった"],["。"]]},{"verse":5,"text":"「引き返して、わたしの民の君主ヒゼキヤに告げよ。／あなたの父ダビデの神、主は、こう仰せられる。『わたしはあなたの祈りを聞いた。あなたの涙も見た。見よ。わたしはあなたをいやす。三日目には、あなたは主の宮に上る。","tok":[["「"],["引き返して","ひきかえして"],["、"],["わたし"],["の"],["民","たみ"],["の"],["君主","くんしゅ"],["ヒゼキヤ"],["に"],["告げ","つげ"],["よ"],["。"],["／"],["あなた"],["の"],["父","ちち"],["ダビデ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["は"],["あなた"],["の"],["祈り","いのり"],["を"],["聞いた","きいた"],["。"],["あなた"],["の"],["涙","なみだ"],["も"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["いやす"],["。"],["三日目","みっかめ"],["に"],["は"],["、"],["あなた"],["は"],["主","ぬし"],["の"],["宮","みや"],["に"],["上る","のぼる"],["。"]]},{"verse":6,"text":"わたしは、あなたの寿命にもう十五年を加えよう。わたしはアッシリヤの王の手から、あなたとこの町を救い出し、わたしのために、また、わたしのしもべダビデのためにこの町を守る。』」","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["寿命","じゅみょう"],["に"],["もう"],["十五","じゅうご"],["年","ねん"],["を"],["加えよう","くわえよう"],["。"],["わたし"],["は"],["アッシリヤ"],["の"],["王","おう"],["の"],["手","て"],["から"],["、"],["あなた"],["と"],["この"],["町","まち"],["を"],["救い出し","すくいだし"],["、"],["わたし"],["の"],["ため"],["に"],["、"],["また"],["、"],["わたし"],["の"],["しもべ"],["ダビデ"],["の"],["ため"],["に"],["この"],["町","まち"],["を"],["守る","まもる"],["。"],["』"],["」"]]},{"verse":7,"text":"イザヤが、「干しいちじくをひとかたまり、持って来なさい」と命じたので、人々はそれを持って来て、腫物に当てた。すると、彼は直った。","tok":[["イザヤ"],["が"],["、"],["「"],["干し","ほし"],["いちじく"],["を"],["ひとかたまり"],["、"],["持って","もって"],["来","き"],["なさい"],["」"],["と"],["命じた","めいじた"],["ので"],["、"],["人々","ひとびと"],["は"],["それ"],["を"],["持って","もって"],["来て","きて"],["、"],["腫物","しゅもつ"],["に"],["当てた","あてた"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["直った","なおった"],["。"]]},{"verse":8,"text":"ヒゼキヤはイザヤに言った。「主が私をいやしてくださり、私が三日目に主の宮に上れるしるしは何ですか。」","tok":[["ヒゼキヤ"],["は"],["イザヤ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["私","わたくし"],["を"],["いやして"],["くださり"],["、"],["私","わたくし"],["が"],["三日目","みっかめ"],["に"],["主","ぬし"],["の"],["宮","みや"],["に"],["上れる","のぼれる"],["しるし"],["は"],["何","なん"],["です"],["か"],["。"],["」"]]},{"verse":9,"text":"イザヤは言った。「これがあなたへの主からのしるしです。主は約束されたことを成就されます。影が十度進むか、十度戻るかです。」","tok":[["イザヤ"],["は"],["言った","いった"],["。"],["「"],["これ"],["が"],["あなた"],["へ"],["の"],["主","ぬし"],["から"],["の"],["しるし"],["です"],["。"],["主","ぬし"],["は"],["約束","やくそく"],["された"],["こと"],["を"],["成就","じょうじゅ"],["されます"],["。"],["影","かげ"],["が"],["十","じゅう"],["度","ど"],["進む","すすむ"],["か"],["、"],["十","じゅう"],["度","ど"],["戻る","もどる"],["か"],["です"],["。"],["」"]]},{"verse":10,"text":"ヒゼキヤは答えた。「影が十度伸びるのは容易なことです。むしろ、影が十度あとに戻るようにしてください。」","tok":[["ヒゼキヤ"],["は"],["答えた","こたえた"],["。"],["「"],["影","かげ"],["が"],["十","じゅう"],["度","ど"],["伸びる","のびる"],["の"],["は"],["容易","ようい"],["な"],["こと"],["です"],["。"],["むしろ"],["、"],["影","かげ"],["が"],["十","じゅう"],["度","ど"],["あと"],["に"],["戻る","もどる"],["よう"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":11,"text":"預言者イザヤが主に祈ると、主はアハズの日時計におりた日時計の影を十度あとに戻された。","tok":[["預言者","よげんしゃ"],["イザヤ"],["が"],["主に","おもに"],["祈る","いのる"],["と"],["、"],["主","ぬし"],["は"],["アハズ"],["の"],["日時計","ひどけい"],["に"],["おりた"],["日時計","ひどけい"],["の"],["影","かげ"],["を"],["十","じゅう"],["度","ど"],["あと"],["に"],["戻された","もどされた"],["。"]]},{"verse":12,"text":"そのころ、バルアダンの子、バビロンの王メロダク・バルアダンは、使者を遣わし、手紙と贈り物をヒゼキヤに届けた。ヒゼキヤが病気だったことを聞いていたからである。","tok":[["その"],["ころ"],["、"],["バルアダン"],["の"],["子","こ"],["、"],["バビロン"],["の"],["王","おう"],["メロダク"],["・"],["バルアダン"],["は"],["、"],["使者","ししゃ"],["を"],["遣わし","つかわし"],["、"],["手紙","てがみ"],["と"],["贈り物","おくりもの"],["を"],["ヒゼキヤ"],["に"],["届けた","とどけた"],["。"],["ヒゼキヤ"],["が"],["病気","びょうき"],["だった"],["こと"],["を"],["聞いて","きいて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"ヒゼキヤは、彼らのことを聞いて、すべての宝庫、銀、金、香料、高価な油、武器庫、彼の宝物倉にあるすべての物を彼らに見せた。ヒゼキヤがその家の中、および国中で、彼らに見せなかった物は一つもなかった。","tok":[["ヒゼキヤ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["こと"],["を"],["聞いて","きいて"],["、"],["すべて"],["の"],["宝庫","ほうこ"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["香料","こうりょう"],["、"],["高価","こうか"],["な"],["油","あぶら"],["、"],["武器庫","ぶきこ"],["、"],["彼","かれ"],["の"],["宝物倉","ほうもつそう"],["に"],["ある"],["すべて"],["の"],["物","もの"],["を"],["彼","かれ"],["ら"],["に"],["見せた","みせた"],["。"],["ヒゼキヤ"],["が"],["その"],["家","いえ"],["の"],["中","なか"],["、"],["および"],["国中","くにちゅう"],["で"],["、"],["彼","かれ"],["ら"],["に"],["見せなかった","みせなかった"],["物","もの"],["は"],["一","ひと"],["つ"],["も"],["なかった"],["。"]]},{"verse":14,"text":"そこで預言者イザヤが、ヒゼキヤ王のところに来て、彼に尋ねた。「あの人々は何を言いましたか。どこから来たのですか。」ヒゼキヤは答えた。「遠い国、バビロンから来たのです。」","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["イザヤ"],["が"],["、"],["ヒゼキヤ"],["王","おう"],["の"],["ところ"],["に"],["来て","きて"],["、"],["彼","かれ"],["に"],["尋ねた","たずねた"],["。"],["「"],["あの"],["人々","ひとびと"],["は"],["何","なん"],["を"],["言いました","いいました"],["か"],["。"],["どこ"],["から"],["来た","きた"],["の"],["です"],["か"],["。"],["」"],["ヒゼキヤ"],["は"],["答えた","こたえた"],["。"],["「"],["遠い","とおい"],["国","くに"],["、"],["バビロン"],["から"],["来た","きた"],["の"],["です"],["。"],["」"]]},{"verse":15,"text":"イザヤはまた言った。「彼らは、あなたの家で何を見たのですか。」ヒゼキヤは答えた。「私の家の中のすべての物を見ました。私の宝物倉の中で彼らに見せなかった物は一つもありません。」","tok":[["イザヤ"],["は"],["また"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["家","いえ"],["で"],["何","なん"],["を"],["見た","みた"],["の"],["です"],["か"],["。"],["」"],["ヒゼキヤ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["の"],["家","いえ"],["の"],["中","なか"],["の"],["すべて"],["の"],["物","もの"],["を"],["見ました","みました"],["。"],["私","わたくし"],["の"],["宝物倉","ほうもつそう"],["の"],["中","なか"],["で"],["彼","かれ"],["ら"],["に"],["見せなかった","みせなかった"],["物","もの"],["は"],["一","ひと"],["つ"],["も"],["ありません"],["。"],["」"]]},{"verse":16,"text":"すると、イザヤはヒゼキヤに言った。「主のことばを聞きなさい。","tok":[["する"],["と"],["、"],["イザヤ"],["は"],["ヒゼキヤ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["ことば"],["を"],["聞き","きき"],["なさい"],["。"]]},{"verse":17,"text":"見よ。あなたの家にある物、あなたの先祖たちが今日まで、たくわえてきた物がすべて、バビロンへ運び去られる日が来ている。何一つ残されまい、と主は仰せられます。","tok":[["見","み"],["よ"],["。"],["あなた"],["の"],["家","いえ"],["に"],["ある"],["物","もの"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["が"],["今日","きょう"],["まで"],["、"],["たくわえて"],["きた"],["物","もの"],["が"],["すべて"],["、"],["バビロン"],["へ"],["運び去られる","はこびさられる"],["日","ひ"],["が"],["来て","きて"],["いる"],["。"],["何","なん"],["一","ひと"],["つ"],["残されまい","のこされまい"],["、"],["と"],["主","ぬし"],["は"],["仰せられます","おおせられます"],["。"]]},{"verse":18,"text":"また、あなたの生む、あなた自身の息子たちのうち、捕らえられてバビロンの王の宮殿で宦官となる者があろう。」","tok":[["また"],["、"],["あなた"],["の"],["生む","うむ"],["、"],["あなた"],["自身","じしん"],["の"],["息子","むすこ"],["たち"],["の"],["うち"],["、"],["捕らえられて","とらえられて"],["バビロン"],["の"],["王","おう"],["の"],["宮殿","きゅうでん"],["で"],["宦官","かんがん"],["と"],["なる"],["者","もの"],["が"],["あろう"],["。"],["」"]]},{"verse":19,"text":"ヒゼキヤはイザヤに言った。「あなたが告げてくれた主のことばはありがたい。」彼は、自分が生きている間は、平和で安全ではなかろうか、と思ったからである。","tok":[["ヒゼキヤ"],["は"],["イザヤ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["告げて","つげて"],["くれた"],["主","ぬし"],["の"],["ことば"],["は"],["ありがたい"],["。"],["」"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["平和","へいわ"],["で"],["安全","あんぜん"],["で"],["は"],["なかろう"],["か"],["、"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"ヒゼキヤのその他の業績、彼のすべての功績、彼が貯水池と水道を造り、町に水を引いたこと、それはユダの王たちの年代記の書にしるされているではないか。","tok":[["ヒゼキヤ"],["の"],["その"],["他","た"],["の"],["業績","ぎょうせき"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["功績","こうせき"],["、"],["彼","かれ"],["が"],["貯水池","ちょすいち"],["と"],["水道","すいどう"],["を"],["造り","つくり"],["、"],["町","まち"],["に"],["水","みず"],["を"],["引いた","ひいた"],["こと"],["、"],["それ"],["は"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["年代記","ねんだいき"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":21,"text":"こうして、ヒゼキヤは彼の先祖たちとともに眠り、その子マナセが代わって王となった。","tok":[["こう"],["して"],["、"],["ヒゼキヤ"],["は"],["彼","かれ"],["の"],["先祖","せんぞ"],["たち"],["と"],["とも"],["に"],["眠り","ねむり"],["、"],["その"],["子","こ"],["マナセ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]}]
[{"verse":1,"text":"マナセは十二歳で王となり、エルサレムで五十五年間、王であった。彼の母の名はヘフツィ・バハといった。","tok":[["マナセ"],["は"],["十二歳","じゅうにさい"],["で"],["王","おう"],["と"],["なり"],["、"],["エルサレム"],["で"],["五十五","ごじゅうご"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"],["彼","かれ"],["の"],["母","はは"],["の"],["名","な"],["は"],["ヘフツィ"],["・"],["バハ"],["と"],["いった"],["。"]]},{"verse":2,"text":"彼は、主がイスラエル人の前から追い払われた異邦の民の忌みきらうべきならわしをまねて、主の目の前に悪を行った。","tok":[["彼","かれ"],["は"],["、"],["主","ぬし"],["が"],["イスラエル"],["人","にん"],["の"],["前","まえ"],["から"],["追い払われた","おいはらわれた"],["異邦","いほう"],["の"],["民","たみ"],["の"],["忌みきらうべき","いみきらうべき"],["ならわし"],["を"],["まねて"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行った","おこなった"],["。"]]},{"verse":3,"text":"彼は、父ヒゼキヤが打ちこわした高き所を築き直し、バアルのために祭壇を立て、イスラエルの王アハブがしたようにアシェラ像を造り、天の万象を拝み、これに仕えた。","tok":[["彼","かれ"],["は"],["、"],["父","ちち"],["ヒゼキヤ"],["が"],["打ちこわした","うちこわした"],["高き","たかき"],["所","ところ"],["を"],["築き直し","きずきなおし"],["、"],["バアル"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["立て","たて"],["、"],["イスラエル"],["の"],["王","おう"],["アハブ"],["が"],["した"],["よう"],["に"],["アシェラ"],["像","ぞう"],["を"],["造り","つくり"],["、"],["天","てん"],["の"],["万象","ばんしょう"],["を"],["拝み","おがみ"],["、"],["これ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":4,"text":"彼は、主がかつて、「エルサレムにわたしの名を置く」と言われた主の宮に、祭壇を築いたのである。","tok":[["彼","かれ"],["は"],["、"],["主","ぬし"],["が"],["かつて"],["、"],["「"],["エルサレム"],["に"],["わたし"],["の"],["名","な"],["を"],["置く","おく"],["」"],["と"],["言われた","いわれた"],["主","ぬし"],["の"],["宮","みや"],["に"],["、"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["ので"],["ある"],["。"]]},{"verse":5,"text":"こうして、彼は、主の宮の二つの庭に、天の万象のために祭壇を築いた。","tok":[["こう"],["して"],["、"],["彼","かれ"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["二","ふた"],["つ"],["の"],["庭","にわ"],["に"],["、"],["天","てん"],["の"],["万象","ばんしょう"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]},{"verse":6,"text":"また、自分の子どもに火の中をくぐらせ、卜占をし、まじないをし、霊媒や口寄せをして、主の目の前に悪を行い、主の怒りを引き起こした。","tok":[["また"],["、"],["自分","じぶん"],["の"],["子ども","こども"],["に"],["火","ひ"],["の"],["中","なか"],["を"],["くぐらせ"],["、"],["卜占","ぼくせん"],["を"],["し"],["、"],["まじない"],["を"],["し"],["、"],["霊媒","れいばい"],["や"],["口寄せ","くちよせ"],["を"],["して"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行い","おこない"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["を"],["引き起こした","ひきおこした"],["。"]]},{"verse":7,"text":"さらに彼は、自分が造ったアシェラの彫像を宮に安置した。主はかつてこの宮について、ダビデとその子ソロモンに言われた。「わたしは、この宮に、そしてわたしがイスラエルの全部族の中から選んだエルサレムに、わたしの名をとこしえに置く。","tok":[["さらに"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["が"],["造った","つくった"],["アシェラ"],["の"],["彫像","ちょうぞう"],["を"],["宮","みや"],["に"],["安置","あんち"],["した"],["。"],["主","ぬし"],["は"],["かつて"],["この"],["宮","みや"],["について"],["、"],["ダビデ"],["と"],["その"],["子","こ"],["ソロモン"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["、"],["この"],["宮","みや"],["に"],["、"],["そして"],["わたし"],["が"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["の"],["中","なか"],["から"],["選んだ","えらんだ"],["エルサレム"],["に"],["、"],["わたし"],["の"],["名","な"],["を"],["とこしえ"],["に"],["置く","おく"],["。"]]},{"verse":8,"text":"もし彼らが、わたしの命じたすべてのこと、わたしのしもべモーセが彼らに命じたすべての律法を、守り行いさえするなら、わたしはもう二度と、彼らの先祖に与えた地から、イスラエルの足を迷い出させない。」","tok":[["もし"],["彼","かれ"],["ら"],["が"],["、"],["わたし"],["の"],["命じた","めいじた"],["すべて"],["の"],["こと"],["、"],["わたし"],["の"],["しもべ"],["モーセ"],["が"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["すべて"],["の"],["律法","りっぽう"],["を"],["、"],["守り","まもり"],["行い","おこない"],["さえ"],["するなら"],["、"],["わたし"],["は"],["もう"],["二","に"],["度","ど"],["と"],["、"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["地","ち"],["から"],["、"],["イスラエル"],["の"],["足","あし"],["を"],["迷い出させない","まよいでさせない"],["。"],["」"]]},{"verse":9,"text":"しかし、彼らはこれに聞き従わず、マナセは彼らを迷わせて、主がイスラエル人の前で根絶やしにされた異邦人よりも、さらに悪いことを行わせた。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["これ"],["に"],["聞き従わず","ききしたがわず"],["、"],["マナセ"],["は"],["彼","かれ"],["ら"],["を"],["迷わせて","まよわせて"],["、"],["主","ぬし"],["が"],["イスラエル"],["人","にん"],["の"],["前","まえ"],["で"],["根絶やし","ねだやし"],["に"],["された"],["異邦人","いほうじん"],["より"],["も"],["、"],["さらに"],["悪い","わるい"],["こと"],["を"],["行わせた","おこなわせた"],["。"]]},{"verse":10,"text":"主は、そのしもべ預言者たちによって、次のように告げられた。","tok":[["主","ぬし"],["は"],["、"],["その"],["しもべ"],["預言者","よげんしゃ"],["たち"],["によって"],["、"],["次","つぎ"],["の"],["よう"],["に"],["告げられた","つげられた"],["。"]]},{"verse":11,"text":"「ユダの王マナセは、これらの忌みきらうべきことを、彼以前にいたエモリ人が行ったすべてのことよりもさらに悪いことを行い、その偶像でユダにまで罪を犯させた。","tok":[["「"],["ユダ"],["の"],["王","おう"],["マナセ"],["は"],["、"],["これ"],["ら"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["、"],["彼","かれ"],["以前","いぜん"],["に"],["いた"],["エモリ人","えもりにん"],["が"],["行った","おこなった"],["すべて"],["の"],["こと"],["より"],["も"],["さらに"],["悪い","わるい"],["こと"],["を"],["行い","おこない"],["、"],["その"],["偶像","ぐうぞう"],["で"],["ユダ"],["に"],["まで"],["罪","つみ"],["を"],["犯させた","おかさせた"],["。"]]},{"verse":12,"text":"それゆえ、イスラエルの神、主は、こう仰せられる。見よ。わたしはエルサレムとユダにわざわいをもたらす。だれでもそれを聞く者は、二つの耳が鳴るであろう。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["エルサレム"],["と"],["ユダ"],["に"],["わざわい"],["を"],["もたらす"],["。"],["だれ"],["で"],["も"],["それ"],["を"],["聞く","きく"],["者","もの"],["は"],["、"],["二","ふた"],["つ"],["の"],["耳","みみ"],["が"],["鳴るで","なるで"],["あろう"],["。"]]},{"verse":13,"text":"わたしは、サマリヤに使った測りなわと、アハブの家に使ったおもりとをエルサレムの上に伸ばし、人が皿をぬぐい、それをぬぐって伏せるように、わたしはエルサレムをぬぐい去ろう。","tok":[["わたし"],["は"],["、"],["サマリヤ"],["に"],["使った","つかった"],["測り","はかり"],["なわ"],["と"],["、"],["アハブ"],["の"],["家","いえ"],["に"],["使った","つかった"],["おもり"],["と"],["を"],["エルサレム"],["の"],["上","うえ"],["に"],["伸ばし","のばし"],["、"],["人","ひと"],["が"],["皿","さら"],["を"],["ぬぐい"],["、"],["それ"],["を"],["ぬぐって"],["伏せる","ふせる"],["よう"],["に"],["、"],["わたし"],["は"],["エルサレム"],["を"],["ぬぐい去ろう","ぬぐいさろう"],["。"]]},{"verse":14,"text":"わたしは、わたしのものである民の残りの者を捨て去り、彼らを敵の手に渡す。彼らはそのすべての敵のえじきとなり、奪い取られる。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["もの"],["で"],["ある"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["捨て去り","すてさり"],["、"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["ら"],["は"],["その"],["すべて"],["の"],["敵","てき"],["の"],["えじき"],["と"],["なり"],["、"],["奪い取られる","うばいとられる"],["。"]]},{"verse":15,"text":"それは、彼らの先祖がエジプトを出た日から今日まで、わたしの目の前に悪を行い、わたしの怒りを引き起こしたからである。」","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["が"],["エジプト"],["を"],["出た","でた"],["日","ひ"],["から"],["今日","きょう"],["まで"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行い","おこない"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こした","ひきおこした"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":16,"text":"マナセは、ユダに罪を犯させ、主の目の前に悪を行わせて、罪を犯したばかりでなく、罪のない者の血まで多量に流し、それがエルサレムの隅々に満ちるほどであった。","tok":[["マナセ"],["は"],["、"],["ユダ"],["に"],["罪","つみ"],["を"],["犯させ","おかさせ"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行わせて","おこなわせて"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["ばかり"],["で"],["なく"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["まで"],["多量","たりょう"],["に"],["流し","ながし"],["、"],["それ"],["が"],["エルサレム"],["の"],["隅々","すみずみ"],["に"],["満ちる","みちる"],["ほど"],["で"],["あった"],["。"]]},{"verse":17,"text":"マナセのその他の業績、彼の行ったすべての事、および彼の犯した罪、それはユダの王たちの年代記の書にしるされているではないか。","tok":[["マナセ"],["の"],["その"],["他","た"],["の"],["業績","ぎょうせき"],["、"],["彼","かれ"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["、"],["および"],["彼","かれ"],["の"],["犯した","おかした"],["罪","つみ"],["、"],["それ"],["は"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["年代記","ねんだいき"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":18,"text":"マナセは彼の先祖たちとともに眠り、その家の園、ウザの園に葬られた。彼の子アモンが代わって王となった。","tok":[["マナセ"],["は"],["彼","かれ"],["の"],["先祖","せんぞ"],["たち"],["と"],["とも"],["に"],["眠り","ねむり"],["、"],["その"],["家","いえ"],["の"],["園","その"],["、"],["ウザ"],["の"],["園","その"],["に"],["葬られた","ほうむられた"],["。"],["彼","かれ"],["の"],["子","こ"],["アモン"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":19,"text":"アモンは二十二歳で王となり、エルサレムで二年間、王であった。彼の母の名はメシュレメテといい、ヨテバの出のハルツの娘であった。","tok":[["アモン"],["は"],["二十二歳","にじゅうにさい"],["で"],["王","おう"],["と"],["なり"],["、"],["エルサレム"],["で"],["二","に"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"],["彼","かれ"],["の"],["母","はは"],["の"],["名","な"],["は"],["メシュレメテ"],["と"],["いい"],["、"],["ヨテバ"],["の"],["出","で"],["の"],["ハルツ"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":20,"text":"彼は、その父マナセが行ったように、主の目の前に悪を行った。","tok":[["彼","かれ"],["は"],["、"],
[{"verse":1,"text":"アハブにはサマリヤに七十人の子どもがあった。エフーは手紙を書いてサマリヤに送り、イズレエルのつかさたちや長老たち、および、アハブの子の養育係たちにこう伝えた。","tok":[["アハブ"],["に"],["は"],["サマリヤ"],["に"],["七","なな"],["十人","じゅうにん"],["の"],["子ども","こども"],["が"],["あった"],["。"],["エフー"],["は"],["手紙","てがみ"],["を"],["書いて","かいて"],["サマリヤ"],["に"],["送り","おくり"],["、"],["イズレエル"],["の"],["つかさ"],["たち"],["や"],["長老","ちょうろう"],["たち"],["、"],["および"],["、"],["アハブ"],["の"],["子","こ"],["の"],["養育","よういく"],["係","かかり"],["たち"],["に"],["こう"],["伝えた","つたえた"],["。"]]},{"verse":2,"text":"「この手紙が届いたら、あなたがたのところに、あなたがたの主君の子どもたちがおり、戦車も馬も城壁のある町も武器もあなたがたのところにあるのだから、すぐ、","tok":[["「"],["この"],["手紙","てがみ"],["が"],["届いたら","とどいたら"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["、"],["あなた"],["がた"],["の"],["主君","しゅくん"],["の"],["子ども","こども"],["たち"],["が"],["おり"],["、"],["戦車","せんしゃ"],["も"],["馬","うま"],["も"],["城壁","じょうへき"],["の"],["ある"],["町","まち"],["も"],["武器","ぶき"],["も"],["あなた"],["がた"],["の"],["ところ"],["に"],["ある"],["の"],["だ"],["から"],["、"],["すぐ"],["、"]]},{"verse":3,"text":"あなたがたの主君の子どもの中から最もすぐれた正しい人物を選んで、その父の王座に着かせ、あなたがたの主君の家のために戦え。」","tok":[["あなた"],["がた"],["の"],["主君","しゅくん"],["の"],["子ども","こども"],["の"],["中","なか"],["から"],["最も","もっとも"],["すぐれた"],["正しい","ただしい"],["人物","じんぶつ"],["を"],["選んで","えらんで"],["、"],["その"],["父","ちち"],["の"],["王座","おうざ"],["に"],["着かせ","つかせ"],["、"],["あなた"],["がた"],["の"],["主君","しゅくん"],["の"],["家","いえ"],["の"],["ため"],["に"],["戦え","たたかえ"],["。"],["」"]]},{"verse":4,"text":"彼らは非常に恐れて言った。「ふたりの王たちでさえ、彼に当たることができなかったのに、どうしてこのわれわれが当たることができよう。」","tok":[["彼","かれ"],["ら"],["は"],["非常","ひじょう"],["に"],["恐れて","おそれて"],["言った","いった"],["。"],["「"],["ふたり"],["の"],["王","おう"],["たち"],["で"],["さえ"],["、"],["彼","かれ"],["に"],["当たる","あたる"],["こと"],["が"],["できなかった"],["のに"],["、"],["どう"],["して"],["この"],["われわれ"],["が"],["当たる","あたる"],["こと"],["が"],["できよう"],["。"],["」"]]},{"verse":5,"text":"そこで、宮内長官、町のつかさ、長老たち、および、養育係たちは、エフーに人を送って言った。「私どもはあなたのしもべです。あなたが私どもにお命じになることは何でもいたしますが、だれをも王に立てるつもりはありません。あなたのお気に召すようにしてください。」","tok":[["そこ"],["で"],["、"],["宮内","くない"],["長官","ちょうかん"],["、"],["町","まち"],["の"],["つかさ"],["、"],["長老","ちょうろう"],["たち"],["、"],["および"],["、"],["養育","よういく"],["係","かかり"],["たち"],["は"],["、"],["エフー"],["に"],["人","ひと"],["を"],["送って","おくって"],["言った","いった"],["。"],["「"],["私","わたくし"],["ども"],["は"],["あなた"],["の"],["しもべ"],["です"],["。"],["あなた"],["が"],["私","わたくし"],["ども"],["に"],["お命じ","おめいじ"],["に"],["なる"],["こと"],["は"],["何","なん"],["で"],["も"],["いたします"],["が"],["、"],["だれ"],["を"],["も"],["王","おう"],["に"],["立てる","たてる"],["つもり"],["は"],["ありません"],["。"],["あなた"],["の"],["お気","おき"],["に"],["召す","めす"],["よう"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":6,"text":"そこで、エフーは再び彼らに手紙を書いてこう言った。「もしあなたがたが私に味方し、私の命令に従うのなら、あなたがたの主君の子どもたちの首を取り、あすの今ごろ、イズレエルの私のもとに持って来い。」そのころ、王の子どもたち七十人は、彼らを養育していた町のおもだった人たちのもとにいた。","tok":[["そこ"],["で"],["、"],["エフー"],["は"],["再び","ふたたび"],["彼","かれ"],["ら"],["に"],["手紙","てがみ"],["を"],["書いて","かいて"],["こう"],["言った","いった"],["。"],["「"],["もし"],["あなた"],["がた"],["が"],["私","わたくし"],["に"],["味方","みかた"],["し"],["、"],["私","わたくし"],["の"],["命令","めいれい"],["に"],["従う","したがう"],["の"],["なら"],["、"],["あなた"],["がた"],["の"],["主君","しゅくん"],["の"],["子ども","こども"],["たち"],["の"],["首","くび"],["を"],["取り","とり"],["、"],["あす"],["の"],["今ごろ","いまごろ"],["、"],["イズレエル"],["の"],["私","わたくし"],["の"],["もと"],["に"],["持って","もって"],["来い","こい"],["。"],["」"],["その"],["ころ"],["、"],["王","おう"],["の"],["子ども","こども"],["たち"],["七","なな"],["十人","じゅうにん"],["は"],["、"],["彼","かれ"],["ら"],["を"],["養育","よういく"],["して"],["いた"],["町","まち"],["の"],["おも"],["だった"],["人","ひと"],["たち"],["の"],["もと"],["に"],["いた"],["。"]]},{"verse":7,"text":"その手紙が彼らに届くと、彼らは王の子どもたちを捕らえ、その七十人を切り殺し、その首を幾つかのかごに入れ、それをイズレエルのエフーのもとに送り届けた。","tok":[["その"],["手紙","てがみ"],["が"],["彼","かれ"],["ら"],["に"],["届く","とどく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["王","おう"],["の"],["子ども","こども"],["たち"],["を"],["捕らえ","とらえ"],["、"],["その"],["七","なな"],["十人","じゅうにん"],["を"],["切り殺し","きりころし"],["、"],["その"],["首","くび"],["を"],["幾つ","いくつ"],["か"],["の"],["かご"],["に"],["入れ","いれ"],["、"],["それ"],["を"],["イズレエル"],["の"],["エフー"],["の"],["もと"],["に"],["送り届けた","おくりとどけた"],["。"]]},{"verse":8,"text":"使者が来て、「彼らは王の子どもたちの首を持ってまいりました」とエフーに報告した。すると、彼は、「それを二つに分けて積み重ね、朝まで門の入口に置いておけ」と命じた。","tok":[["使者","ししゃ"],["が"],["来て","きて"],["、"],["「"],["彼","かれ"],["ら"],["は"],["王","おう"],["の"],["子ども","こども"],["たち"],["の"],["首","くび"],["を"],["持って","もって"],["まいりました"],["」"],["と"],["エフー"],["に"],["報告","ほうこく"],["した"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["、"],["「"],["それ"],["を"],["二","ふた"],["つ"],["に"],["分けて","わけて"],["積み重ね","つみかさね"],["、"],["朝","あさ"],["まで"],["門","もん"],["の"],["入口","いりぐち"],["に"],["置いて","おいて"],["おけ"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":9,"text":"朝になると、エフーは出て行って立ち、すべての民に言った。「あなたがたには罪はない。聞け。私が主君に対して謀反を起こして、彼を殺したのだ。しかしこれらの者を皆殺しにしたのはだれか。","tok":[["朝","あさ"],["に"],["なる"],["と"],["、"],["エフー"],["は"],["出て","でて"],["行って","いって"],["立ち","たち"],["、"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["に"],["は"],["罪","つみ"],["は"],["ない"],["。"],["聞け","きけ"],["。"],["私","わたくし"],["が"],["主君","しゅくん"],["に対して","にたいして"],["謀反","むほん"],["を"],["起こして","おこして"],["、"],["彼","かれ"],["を"],["殺した","ころした"],["の"],["だ"],["。"],["しかし"],["これ"],["ら"],["の"],["者","もの"],["を"],["皆殺し","みなごろし"],["に"],["した"],["の"],["は"],["だれ"],["か"],["。"]]},{"verse":10,"text":"だから知れ。主がアハブの家について告げられた主のことばは一つも地に落ちないことを。主は、そのしもべエリヤによってお告げになったことをなされたのだ。」","tok":[["だ"],["から"],["知れ","しれ"],["。"],["主","ぬし"],["が"],["アハブ"],["の"],["家","いえ"],["について"],["告げられた","つげられた"],["主","ぬし"],["の"],["ことば"],["は"],["一","ひと"],["つ"],["も"],["地","ち"],["に"],["落ちない","おちない"],["こと"],["を"],["。"],["主","ぬし"],["は"],["、"],["その"],["しもべ"],["エリヤ"],["によって"],["お告げ","おつげ"],["に"],["なった"],["こと"],["を"],["なされた"],["の"],["だ"],["。"],["」"]]},{"verse":11,"text":"そして、エフーは、アハブの家に属する者でイズレエルに残っていた者全部、身分の高い者、親しい者、その祭司たちを、みな打ち殺し、ひとりも生き残る者がないまでにした。","tok":[["そして"],["、"],["エフー"],["は"],["、"],["アハブ"],["の"],["家","いえ"],["に"],["属する","ぞくする"],["者","もの"],["で"],["イズレエル"],["に"],["残って","のこって"],["いた"],["者","もの"],["全部","ぜんぶ"],["、"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["、"],["親しい","したしい"],["者","もの"],["、"],["その"],["祭司","さいし"],["たち"],["を"],["、"],["みな"],["打ち殺し","うちころし"],["、"],["ひとり"],["も"],["生き残る","いきのこる"],["者","もの"],["が"],["ない"],["まで"],["に"],["した"],["。"]]},{"verse":12,"text":"それから、エフーは立ってサマリヤへ行った。彼は途中、羊飼いのベテ・エケデという所にいた。","tok":[["それ"],["から"],["、"],["エフー"],["は"],["立って","たって"],["サマリヤ"],["へ"],["行った","いった"],["。"],["彼","かれ"],["は"],["途中","とちゅう"],["、"],["羊飼い","ひつじかい"],["の"],["ベテ"],["・"],["エケデ"],["と"],["いう"],["所","ところ"],["に"],["いた"],["。"]]},{"verse":13,"text":"その間に、エフーはユダの王アハズヤの身内の者たちに出会った。彼が「あなたがたはだれか」と聞くと、彼らは、「私たちはアハズヤの身内の者です。王の子どもたちと、王母の子どもたちの安否を気づかって下って来たのです」と答えた。","tok":[["その"],["間","あいだ"],["に"],["、"],["エフー"],["は"],["ユダ"],["の"],["王","おう"],["アハズヤ"],["の"],["身内","みうち"],["の"],["者","もの"],["たち"],["に"],["出会った","であった"],["。"],["彼","かれ"],["が"],["「"],["あなた"],["がた"],["は"],["だれ"],["か"],["」"],["と"],["聞く","きく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["私たち","わたしたち"],["は"],["アハズヤ"],["の"],["身内","みうち"],["の"],["者","もの"],["です"],["。"],["王","おう"],["の"],["子ども","こども"],["たち"],["と"],["、"],["王母","おうぼ"],["の"],["子ども","こども"],["たち"],["の"],["安否","あんぴ"],["を"],["気づかって","きづかって"],["下って","くだって"],["来た","きた"],["の"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":14,"text":"エフーは「彼らを生けどりにせよ」と言った。それで人々は彼らを生けどりにした。そして、ベテ・エケデの水ためのところで、彼ら四十二人を殺し、ひとりも残さなかった。","tok":[["エフー"],["は"],["「"],["彼","かれ"],["ら"],["を"],["生けどり","いけどり"],["に"],["せよ"],["」"],["と"],["言った","いった"],["。"],["それ"],["で"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["を"],["生けどり","いけどり"],["に"],["した"],["。"],["そして"],["、"],["ベテ"],["・"],["エケデ"],["の"],["水","みず"],["ため"],["の"],["ところ"],["で"],["、"],["彼","かれ"],["ら"],["四十二人","よんじゅうににん"],["を"],["殺し","ころし"],["、"],["ひとり"],["も"],["残さなかった","のこさなかった"],["。"]]},{"verse":15,"text":"彼がそこを去って行くと、彼を迎えに来たレカブの子ヨナダブに出会った。エフーは彼にあいさつして言った。「私の心があなたの心に結ばれているように、あなたの心もそうですか。」ヨナダブは、「そうです」と答えた。「それなら、こちらに手をよこしなさい。」ヨナダブが手を差し出すと、エフーは彼を戦車の上に引き上げて、","tok":[["彼","かれ"],["が"],["そこ"],["を"],["去って","さって"],["行く","いく"],["と"],["、"],["彼","かれ"],["を"],["迎え","むかえ"],["に"],["来た","きた"],["レカブ"],["の"],["子","こ"],["ヨナダブ"],["に"],["出会った","であった"],["。"],["エフー"],["は"],["彼","かれ"],["に"],["あいさつ"],["して"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["心","こころ"],["が"],["あなた"],["の"],["心","こころ"],["に"],["結ばれて","むすばれて"],["いる"],["よう"],["に"],["、"],["あなた"],["の"],["心","こころ"],["も"],["そう"
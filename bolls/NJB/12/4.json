[{"verse":1,"text":"預言者のともがらの妻のひとりがエリシャに叫んで言った。「あなたのしもべである私の夫が死にました。ご存じのように、あなたのしもべは、主を恐れておりました。ところが、貸し主が来て、私のふたりの子どもを自分の奴隷にしようとしております。」","tok":[["預言者","よげんしゃ"],["の"],["とも"],["がら"],["の"],["妻","つま"],["の"],["ひとり"],["が"],["エリシャ"],["に"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["あなた"],["の"],["しもべ"],["で"],["ある"],["私","わたくし"],["の"],["夫","おっと"],["が"],["死にました","しにました"],["。"],["ご存じ","ごぞんじ"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["しもべ"],["は"],["、"],["主","ぬし"],["を"],["恐れて","おそれて"],["おりました"],["。"],["ところ"],["が"],["、"],["貸し主","かしぬし"],["が"],["来て","きて"],["、"],["私","わたくし"],["の"],["ふたり"],["の"],["子ども","こども"],["を"],["自分","じぶん"],["の"],["奴隷","どれい"],["に"],["しよう"],["として"],["おります"],["。"],["」"]]},{"verse":2,"text":"エリシャは彼女に言った。「何をしてあげようか。あなたには、家にどんな物があるか、言いなさい。」彼女は答えた。「はしための家には何もありません。ただ、油のつぼ一つしかありません。」","tok":[["エリシャ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["何","なん"],["を"],["して"],["あげよう"],["か"],["。"],["あなた"],["に"],["は"],["、"],["家","いえ"],["に"],["どんな"],["物","もの"],["が"],["ある"],["か"],["、"],["言い","いい"],["なさい"],["。"],["」"],["彼女","かのじょ"],["は"],["答えた","こたえた"],["。"],["「"],["はし"],["ため"],["の"],["家","いえ"],["に"],["は"],["何","なん"],["も"],["ありません"],["。"],["ただ"],["、"],["油","あぶら"],["の"],["つぼ"],["一","ひと"],["つ"],["しか"],["ありません"],["。"],["」"]]},{"verse":3,"text":"すると、彼は言った。「外に出て行って、隣の人みなから、器を借りて来なさい。からの器を。それも、一つ二つではいけません。","tok":[["する"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["外","そと"],["に"],["出て","でて"],["行って","いって"],["、"],["隣","となり"],["の"],["人","ひと"],["みな"],["から"],["、"],["器","うつわ"],["を"],["借りて","かりて"],["来","き"],["なさい"],["。"],["から"],["の"],["器","うつわ"],["を"],["。"],["それ"],["も"],["、"],["一","ひと"],["つ"],["二","ふた"],["つ"],["で"],["は"],["いけません"],["。"]]},{"verse":4,"text":"家に入ったなら、あなたと子どもたちのうしろの戸を閉じなさい。そのすべての器に油をつぎなさい。いっぱいになったものはわきに置きなさい。」","tok":[["家","いえ"],["に"],["入ったなら","はいったなら"],["、"],["あなた"],["と"],["子ども","こども"],["たち"],["の"],["うしろ"],["の"],["戸","と"],["を"],["閉じ","とじ"],["なさい"],["。"],["その"],["すべて"],["の"],["器","うつわ"],["に"],["油","あぶら"],["を"],["つぎ"],["なさい"],["。"],["いっぱい"],["に"],["なった"],["もの"],["は"],["わき"],["に"],["置き","おき"],["なさい"],["。"],["」"]]},{"verse":5,"text":"そこで、彼女は彼のもとから去り、子どもたちといっしょにうしろの戸を閉じ、子どもたちが次々に彼女のところに持って来る器に油をついだ。","tok":[["そこ"],["で"],["、"],["彼女","かのじょ"],["は"],["彼","かれ"],["の"],["もと"],["から"],["去り","さり"],["、"],["子ども","こども"],["たち"],["と"],["いっしょ"],["に"],["うしろ"],["の"],["戸","と"],["を"],["閉じ","とじ"],["、"],["子ども","こども"],["たち"],["が"],["次々","つぎつぎ"],["に"],["彼女","かのじょ"],["の"],["ところ"],["に"],["持って","もって"],["来る","くる"],["器","うつわ"],["に"],["油","あぶら"],["を"],["ついだ"],["。"]]},{"verse":6,"text":"器がいっぱいになったので、彼女は子どもに言った。「もっと器を持って来なさい。」子どもが彼女に、「もう器はありません」と言うと、油は止まった。","tok":[["器","うつわ"],["が"],["いっぱい"],["に"],["なった"],["ので"],["、"],["彼女","かのじょ"],["は"],["子ども","こども"],["に"],["言った","いった"],["。"],["「"],["もっと"],["器","うつわ"],["を"],["持って","もって"],["来","き"],["なさい"],["。"],["」"],["子ども","こども"],["が"],["彼女","かのじょ"],["に"],["、"],["「"],["もう"],["器","うつわ"],["は"],["ありません"],["」"],["と"],["言う","ゆう"],["と"],["、"],["油","あぶら"],["は"],["止まった","とまった"],["。"]]},{"verse":7,"text":"彼女が神の人に知らせに行くと、彼は言った。「行って、その油を売り、あなたの負債を払いなさい。その残りで、あなたと子どもたちは暮らしていけます。」","tok":[["彼女","かのじょ"],["が"],["神","かみ"],["の"],["人","ひと"],["に"],["知らせ","しらせ"],["に"],["行く","いく"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["行って","いって"],["、"],["その"],["油","あぶら"],["を"],["売り","うり"],["、"],["あなた"],["の"],["負債","ふさい"],["を"],["払い","はらい"],["なさい"],["。"],["その"],["残り","のこり"],["で"],["、"],["あなた"],["と"],["子ども","こども"],["たち"],["は"],["暮らして","くらして"],["いけます"],["。"],["」"]]},{"verse":8,"text":"ある日、エリシャがシュネムを通りかかると、そこにひとりの裕福な女がいて、彼を食事に引き止めた。それからは、そこを通りかかるたびごとに、そこに寄って、食事をするようになった。","tok":[["ある"],["日","ひ"],["、"],["エリシャ"],["が"],["シュネム"],["を"],["通りかかる","とおりかかる"],["と"],["、"],["そこ"],["に"],["ひとり"],["の"],["裕福","ゆうふく"],["な"],["女","おんな"],["が"],["いて"],["、"],["彼","かれ"],["を"],["食事","しょくじ"],["に"],["引き止めた","ひきとめた"],["。"],["それ"],["から"],["は"],["、"],["そこ"],["を"],["通りかかる","とおりかかる"],["たび"],["ごと"],["に"],["、"],["そこ"],["に"],["寄って","よって"],["、"],["食事","しょくじ"],["を"],["する"],["よう"],["に"],["なった"],["。"]]},{"verse":9,"text":"女は夫に言った。「いつも私たちのところに立ち寄って行かれるあの方は、きっと神の聖なる方に違いありません。","tok":[["女","おんな"],["は"],["夫","おっと"],["に"],["言った","いった"],["。"],["「"],["いつも"],["私たち","わたしたち"],["の"],["ところ"],["に"],["立ち寄って","たちよって"],["行かれる","いかれる"],["あの"],["方","かた"],["は"],["、"],["きっと"],["神","かみ"],["の"],["聖","せい"],["なる"],["方","かた"],["に"],["違い","ちがい"],["ありません"],["。"]]},{"verse":10,"text":"ですから、屋上に壁のある小さな部屋を作り、あの方のために寝台と机といすと燭台とを置きましょう。あの方が私たちのところにおいでになるたびに、そこをお使いになれますから。」","tok":[["です"],["から"],["、"],["屋上","おくじょう"],["に"],["壁","かべ"],["の"],["ある"],["小さな","ちいさな"],["部屋","へや"],["を"],["作り","つくり"],["、"],["あの"],["方","かた"],["の"],["ため"],["に"],["寝台","しんだい"],["と"],["机","つくえ"],["と"],["いす"],["と"],["燭台","しょくだい"],["と"],["を"],["置きましょう","おきましょう"],["。"],["あの"],["方","ほう"],["が"],["私たち","わたしたち"],["の"],["ところ"],["に"],["おいで"],["に"],["なる"],["たび"],["に"],["、"],["そこ"],["を"],["お使い","おつかい"],["に"],["なれます"],["から"],["。"],["」"]]},{"verse":11,"text":"ある日、エリシャはそこに来て、その屋上の部屋に入り、そこで横になった。","tok":[["ある"],["日","ひ"],["、"],["エリシャ"],["は"],["そこ"],["に"],["来て","きて"],["、"],["その"],["屋上","おくじょう"],["の"],["部屋","へや"],["に"],["入り","はいり"],["、"],["そこ"],["で"],["横","よこ"],["に"],["なった"],["。"]]},{"verse":12,"text":"彼は若い者ゲハジに言った。「ここのシュネムの女を呼びなさい。」彼が呼ぶと、彼女は彼の前に立った。","tok":[["彼","かれ"],["は"],["若い","わかい"],["者","もの"],["ゲハジ"],["に"],["言った","いった"],["。"],["「"],["ここ"],["の"],["シュネム"],["の"],["女","おんな"],["を"],["呼び","よび"],["なさい"],["。"],["」"],["彼","かれ"],["が"],["呼ぶ","よぶ"],["と"],["、"],["彼女","かのじょ"],["は"],["彼","かれ"],["の"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":13,"text":"エリシャはゲハジに言った。「彼女にこう伝えなさい。『ほんとうに、あなたはこのように、私たちのことでいっしょうけんめいほねおってくれたが、あなたのために何をしたらよいか。王か、それとも、将軍に、何か話してほしいことでもあるか。』」彼女は答えた。「私は私の民の中で、しあわせに暮らしております。」","tok":[["エリシャ"],["は"],["ゲハジ"],["に"],["言った","いった"],["。"],["「"],["彼女","かのじょ"],["に"],["こう"],["伝え","つたえ"],["なさい"],["。"],["『"],["ほんとう"],["に"],["、"],["あなた"],["は"],["この"],["よう"],["に"],["、"],["私たち","わたしたち"],["の"],["こと"],["で"],["いっしょう"],["けんめい"],["ほねおって"],["くれた"],["が"],["、"],["あなた"],["の"],["ため"],["に"],["何","なん"],["を"],["したら"],["よい"],["か"],["。"],["王","おう"],["か"],["、"],["それ"],["と"],["も"],["、"],["将軍","しょうぐん"],["に"],["、"],["何","なん"],["か"],["話して","はなして"],["ほしい"],["こと"],["で"],["も"],["ある"],["か"],["。"],["』"],["」"],["彼女","かのじょ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["私","わたくし"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["、"],["しあわせ"],["に"],["暮らして","くらして"],["おります"],["。"],["」"]]},{"verse":14,"text":"エリシャは言った。「では、彼女のために何をしたら良いだろうか。」ゲハジは言った。「彼女には子どもがなく、それに、彼女の夫も年をとっています。」","tok":[["エリシャ"],["は"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["彼女","かのじょ"],["の"],["ため"],["に"],["何","なん"],["を"],["したら"],["良いだろう","よいだろう"],["か"],["。"],["」"],["ゲハジ"],["は"],["言った","いった"],["。"],["「"],["彼女","かのじょ"],["に"],["は"],["子ども","こども"],["が"],["なく"],["、"],["それ"],["に"],["、"],["彼女","かのじょ"],["の"],["夫","おっと"],["も"],["年","とし"],["を"],["とって"],["います"],["。"],["」"]]},{"verse":15,"text":"エリシャが、「彼女を呼んで来なさい」と言ったので、ゲハジが彼女を呼ぶと、彼女は入口のところに立った。","tok":[["エリシャ"],["が"],["、"],["「"],["彼女","かのじょ"],["を"],["呼んで","よんで"],["来","き"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["ゲハジ"],["が"],["彼女","かのじょ"],["を"],["呼ぶ","よぶ"],["と"],["、"],["彼女","かのじょ"],["は"],["入口","いりぐち"],["の"],["ところ"],["に"],["立った","たった"],["。"]]},{"verse":16,"text":"エリシャは言った。「来年の今ごろ、あなたは男の子を抱くようになろう。」彼女は言った。「いいえ。あなたさま。神の人よ。このはしために偽りを言わないでください。」","tok":[["エリシャ"],["は"],["言った","いった"],["。"],["「"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["、"],["あなた"],["は"],["男の子","おとこのこ"],["を"],["抱く","いだく"],["よう"],["に"],["なろう"],["。"],["」"],["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["いいえ"],["。"],["あなた"],["さま"],["。"],["神","かみ"],["の"],["人","ひと"],["よ"],["。"],["この"],["はし"],["ため"],["に"],["偽り","いつわり"],["を"],["言わないで","いわないで"],["ください"],["。"],["」"]]},{"verse":17,"text":"しかし、この女はみごもり、エリシャが彼女に告げたとおり、翌年のちょうどそのころ、男の子を産んだ。","tok":[["しかし"],["、"],["この"],["女","おんな"],["は"],["みごもり"],["、"],["エリシャ"],["が"],["彼女","かのじょ"],["に"],["告げた","つげた"],["とおり"],["、"],["翌年","よくねん"],["の"],["ちょうど"],["その"],["ころ"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":18,"text":"その子が、大きくなって、ある日、刈り入れ人といっしょにいる父のところに出て行ったとき、","tok":[["その"],["子","こ"],["が"],["、"],["大きく","おおきく"],["なって"],["、"],["ある"],["日","ひ"],["、"],["刈り入れ","かりいれ"],["人","にん"],["と"],["いっしょ"],["に"],["いる"],["父","ちち"],["の"],["ところ"],["に"],["出て","でて"],["行った","いった"],["とき"],["、"]]},{"verse":19,"text":"父親に、「私の頭が、頭が」と言ったので、父親は若者に、「この子を母親のところに抱いて行ってくれ」と命じた。","tok":[["父親","ちちおや"],["に"],["、"],["「"],["私","わたくし"],["の"],["頭","あたま"],["が"],["、"],["頭","あたま"],["が"],["」"],["と"],["言った","いった"],["ので"],["、"],["父親","ちちおや"],["は"],["若者","わかもの"],["に"],["、"],["「"],["この"],["子","こ"],["を"],["母親","ははおや"],["の"],["ところ"],["に"],["抱いて","いだいて"],["行って","いって"],["くれ"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":20,"text":"若者はその子を抱いて、母親のところに連れて行った。この子は昼まで母親のひざの上に休んでいたが、ついに死んだ。","tok":[["若者","わかもの"],["は"],["その"],["子","こ"],["を"],["抱いて","いだいて"],["、"],["母親","ははおや"],["の"],["ところ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["この"],["子","こ"],["は"],["昼","ひる"],["まで"],["母親","ははおや"],["の"],["ひざ"],["の"],["上","うえ"],["に"],["休んで","やすんで"],["いた"],["が"],["、"],["ついに"],["死んだ","しんだ"],["。"]]},{"verse":21,"text":"彼女は屋上に上がって行って、神の人の寝台にその子を寝かし、戸をしめて出て来た。","tok":[["彼女","かのじょ"],["は"],["屋上","おくじょう"],["に"],["上がって","あがって"],["行って","いって"],["、"],["神","かみ"],["の"],["人","ひと"],["の"],["寝台","しんだい"],["に"],["その"],["子","こ"],["を"],["寝かし","ねかし"],["、"],["戸","と"],["を"],["しめて"],["出て","でて"],["来た","きた"],["。"]]},{"verse":22,"text":"彼女は夫に呼びかけて言った。「どうぞ、若者のひとりと、雌ろば一頭を私によこしてください。私は急いで、神の人のところに行って、すぐ戻って来ますから。」","tok":[["彼女","かのじょ"],["は"],["夫","おっと"],["に"],["呼びかけて","よびかけて"],["言った","いった"],["。"],["「"],["どうぞ"],["、"],["若者","わかもの"],["の"],["ひとり"],["と"],["、"],["雌","めす"],["ろば"],["一頭","いちとう"],["を"],["私","わたくし"],["に"],["よこして"],["ください"],["。"],["私","わたくし"],["は"],["急いで","いそいで"],["、"],["神","かみ"],["の"],["人","ひと"],["の"],["ところ"],["に"],["行って","いって"],["、"],["すぐ"],["戻って","もどって"],["来ます","きます"],["から"],["。"],["」"]]},{"verse":23,"text":"すると彼は、「どうして、きょう、あの人のところに行くのか。新月祭でもなく、安息日でもないのに」と言ったが、彼女は、「それでも、かまいません」と答えた。","tok":[["する"],["と"],["彼","かれ"],["は"],["、"],["「"],["どう"],["して"],["、"],["きょう"],["、"],["あの"],["人","ひと"],["の"],["ところ"],["に"],["行く","いく"],["の"],["か"],["。"],["新月祭","しんげつさい"],["で"],["も"],["なく"],["、"],["安息日","あんそくび"],["で"],["も"],["ない"],["のに"],["」"],["と"],["言った","いった"],["が"],["、"],["彼女",
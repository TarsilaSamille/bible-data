[{"verse":1,"text":"アハブの死後、モアブがイスラエルにそむいた。","tok":[["アハブ"],["の"],["死後","しご"],["、"],["モアブ"],["が"],["イスラエル"],["に"],["そむいた"],["。"]]},{"verse":2,"text":"さて、アハズヤはサマリヤにある彼の屋上の部屋の欄干から落ちて病気になった。彼は使者たちを遣わし、「行って、エクロンの神、バアル・ゼブブに、私のこの病気が直るかどうか、伺いを立てなさい」と命じた。","tok":[["さて"],["、"],["アハズヤ"],["は"],["サマリヤ"],["に"],["ある"],["彼","かれ"],["の"],["屋上","おくじょう"],["の"],["部屋","へや"],["の"],["欄干","らんかん"],["から"],["落ちて","おちて"],["病気","びょうき"],["に"],["なった"],["。"],["彼","かれ"],["は"],["使者","ししゃ"],["たち"],["を"],["遣わし","つかわし"],["、"],["「"],["行って","いって"],["、"],["エクロン"],["の"],["神","かみ"],["、"],["バアル"],["・"],["ゼブブ"],["に"],["、"],["私","わたくし"],["の"],["この"],["病気","びょうき"],["が"],["直る","なおる"],["か"],["どう"],["か"],["、"],["伺い","うかがい"],["を"],["立て","たて"],["なさい"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":3,"text":"そのころ、主の使いがティシュベ人エリヤに告げた。「さあ、上って行って、サマリヤの王の使者たちに会い、彼らに言え。『あなたがたがエクロンの神、バアル・ゼブブに伺いを立てに行くのは、イスラエルに神がいないためか。","tok":[["その"],["ころ"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["ティシュベ"],["人","にん"],["エリヤ"],["に"],["告げた","つげた"],["。"],["「"],["さあ"],["、"],["上って","のぼって"],["行って","いって"],["、"],["サマリヤ"],["の"],["王","おう"],["の"],["使者","ししゃ"],["たち"],["に"],["会い","あい"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["『"],["あなた"],["がた"],["が"],["エクロン"],["の"],["神","かみ"],["、"],["バアル"],["・"],["ゼブブ"],["に"],["伺い","うかがい"],["を"],["立て","たて"],["に"],["行く","いく"],["の"],["は"],["、"],["イスラエル"],["に"],["神","かみ"],["が"],["いない"],["ため"],["か"],["。"]]},{"verse":4,"text":"それゆえ、主はこう仰せられる。あなたは上ったその寝台から降りることはない。あなたは必ず死ぬ。』」それで、エリヤは出て行った。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["は"],["上った","のぼった"],["その"],["寝台","しんだい"],["から"],["降りる","おりる"],["こと"],["は"],["ない"],["。"],["あなた"],["は"],["必ず","かならず"],["死ぬ","しぬ"],["。"],["』"],["」"],["それ"],["で"],["、"],["エリヤ"],["は"],["出て","でて"],["行った","いった"],["。"]]},{"verse":5,"text":"使者たちがアハズヤのもとに戻って来ると、彼は、「なぜあなたがたは帰って来たのか」と彼らに尋ねた。","tok":[["使者","ししゃ"],["たち"],["が"],["アハズヤ"],["の"],["もと"],["に"],["戻って","もどって"],["来る","くる"],["と"],["、"],["彼","かれ"],["は"],["、"],["「"],["なぜ"],["あなた"],["がた"],["は"],["帰って","かえって"],["
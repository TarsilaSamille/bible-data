[{"verse":1,"text":"ユダの王アハズヤの子ヨアシュの第二十三年に、エフーの子エホアハズがサマリヤでイスラエルの王となり、十七年間、王であった。","tok":[["ユダ"],["の"],["王","おう"],["アハズヤ"],["の"],["子","こ"],["ヨアシュ"],["の"],["第","だい"],["二十三","にじゅうさん"],["年","ねん"],["に"],["、"],["エフー"],["の"],["子","こ"],["エホアハズ"],["が"],["サマリヤ"],["で"],["イスラエル"],["の"],["王","おう"],["と"],["なり"],["、"],["十七","じゅうなな"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼は主の目の前に悪を行い、イスラエルに罪を犯させたネバテの子ヤロブアムの罪を犯し続けて、それをやめなかった。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行い","おこない"],["、"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ネバテ"],["の"],["子","こ"],["ヤロブアム"],["の"],["罪","つみ"],["を"],["犯し","おかし"],["続けて","つづけて"],["、"],["それ"],["を"],["やめなかった"],["。"]]},{"verse":3,"text":"それで、主の怒りがイスラエルに向かって燃え上がり、主は彼らをアラムの王ハザエル、および、ハザエルの子ベン・ハダデの手にいつまでも渡しておられた。","tok":[["それ"],["で"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["が"],["イスラエル"],["に"],["向かって","むかって"],["燃え上がり","もえあがり"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["アラム"],["の"],["王","おう"],["ハザエル"],["、"],["および"],["、"],["ハザエル"],["の"],["子","こ"],["ベン"],["・"],["ハダデ"],["の"],["手","て"],["に"],["いつ"],["まで"],["も"],["渡して","わたして"],["おられた"],["。"]]},{"verse":4,"text":"しかし、エホアハズが主に願ったので、主はこれを聞き入れられた。アラムの王のしいたげによって、イスラエルがしいたげられているのを見られたからである。","tok":[["しかし"],["、"],["エホアハズ"],["が"],["主に","おもに"],["願った","ねがった"],["ので"],["、"],["主","ぬし"],["は"],["これ"],["を"],["聞き入れられた","ききいれられた"],["。"],["アラム"],["の"],["王","おう"],["の"],["しいたげ"],["によって"],["、"],["イスラエル"],["が"],["しいたげられて"],["いる"],["の"],["を"],["見られた","みられた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"主がイスラエル人にひとりの救い手を与えられたとき、イスラエルの人々はアラムの支配を脱し、以前のように、自分たちの天幕に住むようになった。","tok":[["主","ぬし"],["が"],["イスラエル"],["人","にん"],["に"],["ひとり"],["の"],["救い手","すくいて"],["を"],["与えられた","あたえられた"],["とき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["アラム"],["の"],["支配","しはい"],["を"],["脱し","だっし"],["、"],["以前","いぜん"],["の"],["よう"],["に"],["、"],["自分","じぶん"],["たち"],["の"],["天幕","てんまく"],["に"],["住む","すむ"],["よう"],["に"],["なった"],["。"]]},{"verse":6,"text":"それにもかかわらず、彼らはイスラエルに罪を犯させたヤロブアム家の罪を離れず、なおそれを行い続け、アシェラ像もサマリヤに立ったままであった。","tok":[["それ"],["に"],["も"],["かかわらず"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ヤロブアム"],["家","や"],["の"],["罪","つみ"],["を"],["離れず","はなれず"],["、"],["なお"],["それ"],["を"],["行い","おこない"],["続け","つづけ"],["、"],["アシェラ"],["像","ぞう"],["も"],["サマリヤ"],["に"],["立った","たった"],["まま"],["で"],["あった"],["。"]]},{"verse":7,"text":"また、アラムの王が彼らを滅ぼして、打穀のときのちりのようにしたので、エホアハズには騎兵五十、戦車十台、歩兵一万だけの軍隊しか残されていなかった。","tok":[["また"],["、"],["アラム"],["の"],["王","おう"],["が"],["彼","かれ"],["ら"],["を"],["滅ぼして","ほろぼして"],["、"],["打","だ"],["穀","こく"],["の"],["とき"],["の"],["ちり"],["の"],["よう"],["に"],["した"],["ので"],["、"],["エホアハズ"],["に"],["は"],["騎兵","きへい"],["五十","ごじゅう"],["、"],["戦車","せんしゃ"],["十","じゅう"],["台","だい"],["、"],["歩兵","ふひょう"],["一万","いちまん"],["だけ"],["の"],["軍隊","ぐんたい"],["しか"],["残されて","のこされて"],["いなかった"],["。"]]},{"verse":8,"text":"エホアハズのその他の業績、彼の行ったすべての事、およびその功績、それはイスラエルの王たちの年代記の書にしるされているではないか。","tok":[["エホアハズ"],["の"],["その"],["他","た"],["の"],["業績","ぎょうせき"],["、"],["彼","かれ"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["、"],["および"],["その"],["功績","こうせき"],["、"],["それ"],["は"],["イスラエル"],["の"],["王","おう"],["たち"],["の"],["年代記","ねんだいき"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":9,"text":"エホアハズは彼の先祖たちとともに眠り、人々は彼をサマリヤに葬った。彼の子ヨアシュが代わって王となった。","tok":[["エホアハズ"],["は"],["彼","かれ"],["の"],["先祖","せんぞ"],["たち"],["と"],["とも"],["に"],["眠り","ねむり"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["サマリヤ"],["に"],["葬った","ほうむった"],["。"],["彼","かれ"],["の"],["子","こ"],["ヨアシュ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":10,"text":"ユダの王ヨアシュの第三十七年に、エホアハズの子ヨアシュがサマリヤでイスラエルの王となり、十六年間、王であった。","tok":[["ユダ"],["の"],["王","おう"],["ヨアシュ"],["の"],["第","だい"],["三十七","さんじゅうなな"],["年","ねん"],["に"],["、"],["エホアハズ"],["の"],["子","こ"],["ヨアシュ"],["が"],["サマリヤ"],["で"],["イスラエル"],["の"],["王","おう"],["と"],["なり"],["、"],["十六","じゅうろく"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"]]},{"verse":11,"text":"彼は主の目の前に悪を行い、イスラエルに罪を犯させたネバテの子ヤロブアムのすべての罪から離れず、なおそれを行い続けた。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行い","おこない"],["、"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ネバテ"],["の"],["子","こ"],["ヤロブアム"],["の"],["すべて"],["の"],["罪","つみ"],["から"],["離れず","はなれず"],["、"],["なお"],["それ"],["を"],["行い","おこない"],["続けた","つづけた"],["。"]]},{"verse":12,"text":"ヨアシュのその他の業績、彼の行ったすべての事、およびユダの王アマツヤと戦ったその功績、それはイスラエルの王たちの年代記の書にしるされているではないか。","tok":[["ヨアシュ"],["の"],["その"],["他","た"],["の"],["業績","ぎょうせき"],["、"],["彼","かれ"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["、"],["および"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["と"],["戦った","たたかった"],["その"],["功績","こうせき"],["、"],["それ"],["は"],["イスラエル"],["の"],["王","おう"],["たち"],["の"],["年代記","ねんだいき"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":13,"text":"ヨアシュは彼の先祖たちとともに眠り、ヤロブアムがその王座に着いた。ヨアシュはイスラエルの王たちとともにサマリヤに葬られた。","tok":[["ヨアシュ"],["は"],["彼","かれ"],["の"],["先祖","せんぞ"],["たち"],["と"],["とも"],["に"],["眠り","ねむり"],["、"],["ヤロブアム"],["が"],["その"],["王座","おうざ"],["に"],["着いた","ついた"],["。"],["ヨアシュ"],["は"],["イスラエル"],["の"],["王","おう"],["たち"],["と"],["とも"],["に"],["サマリヤ"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":14,"text":"エリシャが死の病をわずらっていたときのことである。イスラエルの王ヨアシュは、彼のところに下って行き、彼の上に泣き伏して、「わが父。わが父。イスラエルの戦車と騎兵たち」と叫んだ。","tok":[["エリシャ"],["が"],["死","し"],["の"],["病","やまい"],["を"],["わずらって"],["いた"],["とき"],["の"],["こと"],["で"],["ある"],["。"],["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["は"],["、"],["彼","かれ"],["の"],["ところ"],["に"],["下って","くだって"],["行き","いき"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["泣き伏して","なきふして"],["、"],["「"],["わが"],["父","ちち"],["。"],["わが"],["父","ちち"],["。"],["イスラエル"],["の"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["たち"],["」"],["と"],["叫んだ","さけんだ"],["。"]]},{"verse":15,"text":"エリシャが王に、「弓と矢を取りなさい」と言ったので、彼は弓と矢をエリシャのところに持って行った。","tok":[["エリシャ"],["が"],["王","おう"],["に"],["、"],["「"],["弓","ゆみ"],["と"],["矢","や"],["を"],["取り","とり"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["は"],["弓","ゆみ"],["と"],["矢","や"],["を"],["エリシャ"],["の"],["ところ"],["に"],["持って","もって"],["行った","いった"],["。"]]},{"verse":16,"text":"彼はイスラエルの王に、「弓に手をかけなさい」と言ったので、彼は手をかけた。すると、エリシャは自分の手を王の手の上にのせて、","tok":[["彼","かれ"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["、"],["「"],["弓","ゆみ"],["に"],["手","て"],["を"],["かけ"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["は"],["手","て"],["を"],["かけた"],["。"],["する"],["と"],["、"],["エリシャ"],["は"],["自分","じぶん"],["の"],["手","て"],["を"],["王","おう"],["の"],["手","て"],["の"],["上","うえ"],["に"],["のせて"],["、"]]},{"verse":17,"text":"「東側の窓をあけなさい」と言ったので、彼がそれをあけると、エリシャはさらに言った。「矢を射なさい。」彼が矢を射ると、エリシャは言った。「主の勝利の矢。アラムに対する勝利の矢。あなたはアフェクでアラムを打ち、これを絶ち滅ぼす。」","tok":[["「"],["東側","ひがしがわ"],["の"],["窓","まど"],["を"],["あけ"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["が"],["それ"],["を"],["あける"],["と"],["、"],["エリシャ"],["は"],["さらに"],["言った","いった"],["。"],["「"],["矢","や"],["を"],["射","い"],["なさい"],["。"],["」"],["彼","かれ"],["が"],["矢","や"],["を"],["射る","いる"],["と"],["、"],["エリシャ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["勝利","しょうり"],["の"],["矢","や"],["。"],["アラム"],["に"],["対する","たいする"],["勝利","しょうり"],["の"],["矢","や"],["。"],["あなた"],["は"],["アフェク"],["で"],["アラム"],["を"],["打ち","うち"],["、"],["これ"],["を"],["絶ち","たち"],["滅ぼす","ほろぼす"],["。"],["」"]]},{"verse":18,"text":"ついでエリシャは、「矢を取りなさい」と言った。彼が取ると、エリシャはイスラエルの王に、「それで地面を打ちなさい」と言った。すると彼は三回打ったが、それでやめた。","tok":[["ついで"],["エリシャ"],["は"],["、"],["「"],["矢","や"],["を"],["取り","とり"],["なさい"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["が"],["取る","とる"],["と"],["、"],["エリシャ"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["、"],["「"],["それ"],["で"],["地面","じめん"],["を"],["打ち","うち"],["なさい"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["彼","かれ"],["は"],["三","さん"],["回","かい"],["打った","うった"],["が"],["、"],["それ"],["で"],["やめた"],["。"]]},{"verse":19,"text":"神の人は彼に向かい怒って言った。「あなたは、五回、六回、打つべきだった。そうすれば、あなたはアラムを打って、絶ち滅ぼしたことだろう。しかし、今は三度だけアラムを打つことになろう。」","tok":[["神","かみ"],["の"],["人","ひと"],["は"],["彼","かれ"],["に"],["向かい","むかい"],["怒","ど"],["って"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["五","ご"],["回","かい"],["、"],["六","ろく"],["回","かい"],["、"],["打つべきだった","うつべきだった"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["アラム"],["を"],["打って","うって"],["、"],["絶ち","たち"],["滅ぼした","ほろぼした"],["こと"],["だろう"],["。"],["しかし"],["、"],["今","いま"],["は"],["三","さん"],["度","ど"],["だけ"],["アラム"],["を"],["打つ","うつ"],["こと"],["に"],["なろう"],["。"],["」"]]},{"verse":20,"text":"こうして、エリシャは死んで葬られた。モアブの略奪隊は、年が改まるたびにこの国に侵入していた。","tok":[["こう"],["して"],["、"],["エリシャ"],["は"],["死んで","しんで"],["葬られた","ほうむられた"],["。"],["モアブ"],["の"],["略奪隊","りゃくだつたい"],["は"],["、"],["年","ねん"],["が"],["改まる","あらたまる"],["たび"],["に"],["この"],["国","くに"],["に"],["侵入","しんにゅう"],["して"],["いた"],["。"]]},{"verse":21,"text":"人々が、ひとりの人を葬ろうとしていたちょうどその時、略奪隊を見たので、その人をエリシャの墓に投げ入れて去って行った。その人がエリシャの骨に触れるや、その人は生き返り、自分の足で立ち上がった。","tok":[["人々","ひとびと"],["が"],["、"],["ひとり"],["の"],["人","ひと"],["を"],["葬ろう","ほうむろう"],["として"],["いた"],["ちょうど"],["その"],["時","とき"],["、"],["略奪隊","りゃくだつたい"],["を"],["見た","みた"],["ので"],["、"],["その"],["人","ひと"],["を"],["エリシャ"],["の"],["墓","はか"],["に"],["投げ入れて","なげいれて"],["去って","さって"],["行った","いった"],["。"],["その"],["人","ひと"],["が"],["エリシャ"],["の"],["骨","ほね"],["に"],["触れる","ふれる"],["や"],["、"],["その"],["人","ひと"],["は"],["生き返り","いきかえり"],["、"],["自分","じぶん"],["の"],["足","あし"],["で"],["立ち上がった","たちあがった"],["。"]]},{"verse":22,"text":"アラムの王ハザエルは、エホアハズの生きている間中、イスラエル人をしいたげたが、","tok":[["アラム"],["の"],["王","おう"],["ハザエル"],["は"],["、"],["エホアハズ"],["の"],["生きて","いきて"],["いる"],["間中","まなか"],["、"],["イスラエル"],["人","にん"],["を"],["しいたげた"],["が"],["、"]]},{"verse":23,"text":"主は、アブラハム、イサク、ヤコブとの契約のために、彼らを恵み、あわれみ、顧みて、彼らを滅ぼし尽くすことは望まず、今日まで彼らから御顔をそむけられなかった。","tok":[["主","ぬし"],["は"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["と"],["の"],["契約","けいやく"],["の"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["恵み","めぐみ"],["、"],["あわれみ"],["、"],["顧みて","かえりみて"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["こと"],["は"],["望まず","のぞまず"],["、"],["今日","きょう"],["まで"],["彼","かれ"],["ら"],["から"],["御顔","おかお"],["を"],["そむけられなかった"],["。"]]},{"verse":24,"text":"アラムの王ハザエルは死に、その子ベン・ハダデが代わって王となった。","tok":[["アラム"],["の"],["王","おう"],["ハザエル"],["は"],["死に","しに"],["、"],["その"],["子","こ"],["ベン"],["・"],["ハダデ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":25,"text":"エホアハズの子ヨアシュは、その
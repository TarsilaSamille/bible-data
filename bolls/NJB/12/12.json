[{"verse":1,"text":"ヨアシュはエフーの第七年に王となり、エルサレムで四十年間、王であった。彼の母の名はツィブヤといい、ベエル・シェバの出であった。","tok":[["ヨアシュ"],["は"],["エフー"],["の"],["第","だい"],["七","なな"],["年","ねん"],["に"],["王","おう"],["と"],["なり"],["、"],["エルサレム"],["で"],["四十","よんじゅう"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"],["彼","かれ"],["の"],["母","はは"],["の"],["名","な"],["は"],["ツィブヤ"],["と"],["いい"],["、"],["ベエル"],["・"],["シェバ"],["の"],["出","で"],["で"],["あった"],["。"]]},{"verse":2,"text":"ヨアシュは、祭司エホヤダが彼を教えた間はいつも、主の目にかなうことを行った。","tok":[["ヨアシュ"],["は"],["、"],["祭司","さいし"],["エホヤダ"],["が"],["彼","かれ"],["を"],["教えた","おしえた"],["間","あいだ"],["は"],["いつも"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["かなう"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":3,"text":"ただし、高き所は取り除かなかった。民はなおも、その高き所でいけにえをささげたり、香をたいたりしていた。","tok":[["ただし"],["、"],["高き","たかき"],["所","ところ"],["は"],["取り除かなかった","とりのぞかなかった"],["。"],["民","たみ"],["は"],["なお"],["も"],["、"],["その"],["高き","たかき"],["所","ところ"],["で"],["いけにえ"],["を"],["ささげ"],["たり"],["、"],["香","こう"],["を"],["たい"],["たり"],["して"],["いた"],["。"]]},{"verse":4,"text":"ヨアシュは祭司たちに言った。「主の宮にささげられる聖別されたすべての金、すなわち、各人に割り当てを課せられた金や、自発的に主の宮にささげられるすべての金は、","tok":[["ヨアシュ"],["は"],["祭司","さいし"],["たち"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["宮","みや"],["に"],["ささげられる"],["聖別","せいべつ"],["された"],["すべて"],["の"],["金","かね"],["、"],["すなわち"],["、"],["各人","かくじん"],["に"],["割り当て","わりあて"],["を"],["課せられた","かせられた"],["金","かね"],["や"],["、"],["自発的","じはつてき"],["に"],["主","ぬし"],["の"],["宮","みや"],["に"],["ささげられる"],["すべて"],["の"],["金","かね"],["は"],["、"]]},{"verse":5,"text":"祭司たちが、めいめい自分の担当する者から受け取り、宮のどこかが破損していれば、その破損の修理にそれを当てなければならない。」","tok":[["祭司","さいし"],["たち"],["が"],["、"],["めいめい"],["自分","じぶん"],["の"],["担当","たんとう"],["する"],["者","もの"],["から"],["受け取り","うけとり"],["、"],["宮","みや"],["の"],["どこ"],["か"],["が"],["破損","はそん"],["して"],["いれば"],["、"],["その"],["破損","はそん"],["の"],["修理","しゅうり"],["に"],["それ"],["を"],["当てなければ","あてなければ"],["ならない"],["。"],["」"]]},{"verse":6,"text":"しかし、ヨアシュ王の第二十三年になっても、祭司たちは宮の破損を修理しなかった。","tok":[["しかし"],["、"],["ヨアシュ"],["王","おう"],["の"],["第","だい"],["二十三","にじゅうさん"],["年","ねん"],["に"],["なって"],["も"],["、"],["祭司","さいし"],["たち"],["は"],["宮","みや"],["の"],["破損","はそん"],["を"],["修理","しゅうり"],["しなかった"],["。"]]},{"verse":7,"text":"それでヨアシュ王は、祭司エホヤダと、祭司たちを呼んで彼らに言った。「なぜ、宮の破損を修理しないのか。もう、あなたがたは、自分の担当する者たちから金を受け取ってはならない。宮の破損に、それを当てなければならないから。」","tok":[["それ"],["で"],["ヨアシュ"],["王","おう"],["は"],["、"],["祭司","さいし"],["エホヤダ"],["と"],["、"],["祭司","さいし"],["たち"],["を"],["呼んで","よんで"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["宮","みや"],["の"],["破損","はそん"],["を"],["修理","しゅうり"],["しない"],["の"],["か"],["。"],["もう"],["、"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["の"],["担当","たんとう"],["する"],["者","もの"],["たち"],["から"],["金","かね"],["を"],["受け取って","うけとって"],["は"],["ならない"],["。"],["宮","みや"],["の"],["破損","はそん"],["に"],["、"],["それ"],["を"],["当てなければ","あてなければ"],["ならない"],["から"],["。"],["」"]]},{"verse":8,"text":"祭司たちは、民から金を受け取らないことと、宮の破損の修理の責任を持たないこととに同意した。","tok":[["祭司","さいし"],["たち"],["は"],["、"],["民","みん"],["から"],["金","かね"],["を"],["受け取らない","うけとらない"],["こと"],["と"],["、"],["宮","みや"],["の"],["破損","はそん"],["の"],["修理","しゅうり"],["の"],["責任","せきにん"],["を"],["持たない","もたない"],["こと"],["と"],["に"],["同意","どうい"],["した"],["。"]]},{"verse":9,"text":"祭司エホヤダは、一つの箱を取り、そのふたに穴をあけ、それを祭壇のわき、主の宮の入口の右側に置いた。入口を守る祭司たちは、主の宮に納められる金をみな、そこに置いた。","tok":[["祭司","さいし"],["エホヤダ"],["は"],["、"],["一","ひと"],["つ"],["の"],["箱","ばこ"],["を"],["取り","とり"],["、"],["その"],["ふた"],["に"],["穴","あな"],["を"],["あけ"],["、"],["それ"],["を"],["祭壇","さいだん"],["の"],["わき"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["入口","いりぐち"],["の"],["右側","みぎがわ"],["に"],["置いた","おいた"],["。"],["入口","いりぐち"],["を"],["守る","まもる"],["祭司","さいし"],["たち"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["納められる","おさめられる"],["金","かね"],["を"],["みな"],["、"],["そこ"],["に"],["置いた","おいた"],["。"]]},{"verse":10,"text":"箱の中に金が多くなるのを見て、王の書記と大祭司は、上って来て、それを袋に入れ、主の宮に納められている金を計算した。","tok":[["箱","ばこ"],["の"],["中","なか"],["に"],["金","かね"],["が"],["多く","おおく"],["なる"],["の"],["を"],["見て","みて"],["、"],["王","おう"],["の"],["書記","しょき"],["と"],["大","だい"],["祭司","さいし"],["は"],["、"],["上って","のぼって"],["来て","きて"],["、"],["それ"],["を"],["袋","ふくろ"],["に"],["入れ","いれ"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["納められて","おさめられて"],["いる"],["金","かね"],["を"],["計算","けいさん"],["した"],["。"]]},{"verse":11,"text":"こうして、勘定された金は、主の宮で工事をしている監督者たちの手に渡された。彼らはそれを主の宮で働く木工や建築師たち、","tok":[["こう"],["して"],["、"],["勘定","かんじょう"],["された"],["金","かね"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["で"],["工事","こうじ"],["を"],["して"],["いる"],["監督者","かんとくしゃ"],["たち"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["主","ぬし"],["の"],["宮","みや"],["で"],["働く","はたらく"],["木工","もっこう"],["や"],["建築師","けんちくし"],["たち"],["、"]]},{"verse":12,"text":"石工や石切り工たちに支払い、また、主の宮の破損修理のための木材や切り石を買うために支払った。つまり、宮の修理のための出費全部のために支払った。","tok":[["石工","せっこう"],["や"],["石切り","いしきり"],["工","こう"],["たち"],["に"],["支払い","しはらい"],["、"],["また"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["破損","はそん"],["修理","しゅうり"],["の"],["ため"],["の"],["木材","もくざい"],["や"],["切り石","きりいし"],["を"],["買う","かう"],["ため"],["に"],["支払った","しはらった"],["。"],["つまり"],["、"],["宮","みや"],["の"],["修理","しゅうり"],["の"],["ため"],["の"],["出費","しゅっぴ"],["全部","ぜんぶ"],["の"],["ため"],["に"],["支払った","しはらった"],["。"]]},{"verse":13,"text":"ただし、主の宮に納められる金で、主の宮のために銀の皿、心切りばさみ、鉢、ラッパなど、すべての金の器、銀の器を作ることはなかった。","tok":[["ただし"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["納められる","おさめられる"],["金","かね"],["で"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["ため"],["に"],["銀","ぎん"],["の"],["皿","さら"],["、"],["心切り","しんきり"],["ばさみ"],["、"],["鉢","ばち"],["、"],["ラッパ"],["など"],["、"],["すべて"],["の"],["金","かね"],["の"],["器","うつわ"],["、"],["銀","ぎん"],["の"],["器","うつわ"],["を"],["作る","つくる"],["こと"],["は"],["なかった"],["。"]]},{"verse":14,"text":"ただ、これを工事する者に渡し、これを主の宮の修理に当てた。","tok":[["ただ"],["、"],["これ"],["を"],["工事","こうじ"],["する"],["者","もの"],["に"],["渡し","わたし"],["、"],["これ"],["を"],["主","ぬし"],["の"],["宮","みや"],["の"],["修理","しゅうり"],["に"],["当てた","あてた"],["。"]]},{"verse":15,"text":"また、工事する者に支払うように金を渡した人々と、残高を勘定することもしなかった。彼らが忠実に働いていたからである。","tok":[["また"],["、"],["工事","こうじ"],["する"],["者","もの"],["に"],["支払う","しはらう"],["よう"],["に"],["金","かね"],["を"],["渡した","わたした"],["人々","ひとびと"],["と"],["、"],["残高","ざんだか"],["を"],["勘定","かんじょう"],["する"],["こと"],["も"],["しなかった"],["。"],["彼","かれ"],["ら"],["が"],["忠実","ちゅうじつ"],["に"],["働いて","はたらいて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"罪過のためのいけにえの金と、罪のためのいけにえの金とは、主の宮に納められず、祭司たちのものとなった。","tok":[["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["の"],["金","かね"],["と"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["の"],["金","かね"],["と"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["納められず","おさめられず"],["、"],["祭司","さいし"],["たち"],["の"],["もの"],["と"],["なった"],["。"]]},{"verse":17,"text":"そのとき、アラムの王ハザエルが上って来てガテを攻め、これを取った。それから、ハザエルはエルサレムを目ざして攻め上った。","tok":[["その"],["とき"],["、"],["アラム"],["の"],["王","おう"],["ハザエル"],["が"],["上って","のぼって"],["来て","きて"],["ガテ"],["を"],["攻め","せめ"],["、"],["これ"],["を"],["取った","とった"],["。"],["それ"],["から"],["、"],["ハザエル"],["は"],["エルサレム"],["を"],["目ざして","めざして"],["攻め上った","せめのぼった"],["。"]]},{"verse":18,"text":"それでユダの王ヨアシュは、自分の先祖であるユダの王ヨシャパテ、ヨラム、アハズヤが聖別してささげたすべての物、および自分自身が聖別してささげた物、主の宮と王宮との宝物倉にあるすべての金を取って、アラムの王ハザエルに送ったので、ハザエルはエルサレムから去って行った。","tok":[["それ"],["で"],["ユダ"],["の"],["王","おう"],["ヨアシュ"],["は"],["、"],["自分","じぶん"],["の"],["先祖","せんぞ"],["で"],["ある"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["、"],["ヨラム"],["、"],["アハズヤ"],["が"],["聖別","せいべつ"],["して"],["ささげた"],["すべて"],["の"],["物","もの"],["、"],["および"],["自分","じぶん"],["自身","じしん"],["が"],["聖別","せいべつ"],["して"],["ささげた"],["物","もの"],["、"],["主","ぬし"],["の"],["宮","みや"],["と"],["王宮","おうきゅう"],["と"],["の"],["宝物倉","ほうもつそう"],["に"],["ある"],["すべて"],["の"],["金","かね"],["を"],["取って","とって"],["、"],["アラム"],["の"],["王","おう"],["ハザエル"],["に"],["送った","おくった"],["ので"],["、"],["ハザエル"],["は"],["エルサレム"],["から"],["去って","さって"],["行った","いった"],["。"]]},{"verse":19,"text":"ヨアシュのその他の業績、彼の行ったすべての事、それはユダの王たちの年代記の書にしるされているではないか。","tok":[["ヨアシュ"],["の"],["その"],["他","た"],["の"],["業績","ぎょうせき"],["、"],["彼","かれ"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["、"],["それ"],["は"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["年代記","ねんだいき"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":20,"text":"ヨアシュの家来たちは立ち上がって謀反を起こし、シラに下って行くヨアシュをミロの家で打ち殺した。","tok":[["ヨアシュ"],["の"],["家来","けらい"],["たち"],["は"],["立ち上がって","たちあがって"],["謀反","むほん"],["を"],["起こし","おこし"],["、"],["シラ"],["に"],["下って","くだって"],["行く","いく"],["ヨアシュ"],["を"],["ミロ"],["の"],["家","いえ"],["で"],["打ち殺した","うちころした"],["。"]]},{"verse":21,"text":"彼の家来シムアテの子ヨザバデとショメルの子エホザバデが彼を打った。それで彼は死んだ。人々は彼をダビデの町に先祖たちといっしょに葬った。彼の子アマツヤが代わって王となった。","tok":[["彼","かれ"],["の"],["家来","けらい"],["シムアテ"],["の"],["子","こ"],["ヨザバデ"],["と"],["ショメル"],["の"],["子","こ"],["エホザバデ"],["が"],["彼","かれ"],["を"],["打った","うった"],["。"],["それ"],["で"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["ダビデ"],["の"],["町","まち"],["に"],["先祖","せんぞ"],["たち"],["と"],["いっしょ"],["に"],["葬った","ほうむった"],["。"],["彼","かれ"],["の"],["子","こ"],["アマツヤ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]}]
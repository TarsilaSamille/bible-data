[{"verse":1,"text":"預言者エリシャは預言者のともがらのひとりを呼んで言った。「腰に帯を引き締め、手にこの油のつぼを持って、ラモテ・ギルアデに行きなさい。","tok":[["預言者","よげんしゃ"],["エリシャ"],["は"],["預言者","よげんしゃ"],["の"],["とも"],["がら"],["の"],["ひとり"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["腰","こし"],["に"],["帯","おび"],["を"],["引き締め","ひきしめ"],["、"],["手","て"],["に"],["この"],["油","あぶら"],["の"],["つぼ"],["を"],["持って","もって"],["、"],["ラモテ"],["・"],["ギルアデ"],["に"],["行き","いき"],["なさい"],["。"]]},{"verse":2,"text":"そこに行ったら、ニムシの子ヨシャパテの子エフーを見つけ、家に入って、その同僚たちの中から彼を立たせ、奥の間に連れて行き、","tok":[["そこ"],["に"],["行ったら","いったら"],["、"],["ニムシ"],["の"],["子","こ"],["ヨシャパテ"],["の"],["子","こ"],["エフー"],["を"],["見つけ","みつけ"],["、"],["家","いえ"],["に"],["入って","はいって"],["、"],["その"],["同僚","どうりょう"],["たち"],["の"],["中","なか"],["から"],["彼","かれ"],["を"],["立たせ","たたせ"],["、"],["奥","おく"],["の"],["間","あいだ"],["に"],["連れて","つれて"],["行き","いき"],["、"]]},{"verse":3,"text":"油のつぼを取って、彼の頭の上に油をそそいで言いなさい。『主はこう仰せられる。わたしはあなたに油をそそいでイスラエルの王とする。』それから、戸をあけて、ぐずぐずしていないで逃げなさい。」","tok":[["油","あぶら"],["の"],["つぼ"],["を"],["取って","とって"],["、"],["彼","かれ"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["油","あぶら"],["を"],["そそいで"],["言い","いい"],["なさい"],["。"],["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["そそいで"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["。"],["』"],["それ"],["から"],["、"],["戸","と"],["を"],["あけて"],["、"],["ぐずぐず"],["して"],["いないで"],["逃げ","にげ"],["なさい"],["。"],["」"]]},{"verse":4,"text":"そこで、その若い者、預言者に仕える若い者は、ラモテ・ギルアデに行った。","tok":[["そこ"],["で"],["、"],["その"],["若い","わかい"],["者","もの"],["、"],["預言者","よげんしゃ"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["は"],["、"],["ラモテ"],["・"],["ギルアデ"],["に"],["行った","いった"],["。"]]},{"verse":5,"text":"彼が来てみると、ちょうど、将校たちが会議中であった。彼は言った。「隊長。あなたに申し上げることがあります。」エフーは言った。「このわれわれのうちのだれにか。」若い者は、「隊長。あなたにです」と答えた。","tok":[["彼","かれ"],["が"],["来て","きて"],["みる"],["と"],["、"],["ちょうど"],["、"],["将校","しょうこう"],["たち"],["が"],["会議中","かいぎちゅう"],["で"],["あった"],["。"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["隊長","たいちょう"],["。"],["あなた"],["に"],["申し上げる","もうしあげる"],["こと"],["が"],["あります"],["。"],["」"],["エフー"],["は"],["言った","いった"],["。"],["「"],["この"],["われわれ"],["の"],["うち"],["の"],["だれ"],["に"],["か"],["。"],["」"],["若い","わかい"],["者","もの"],["は"],["、"],["「"],["隊長","たいちょう"],["。"],["あなた"],["に"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":6,"text":"エフーは立って、家に入った。そこで若い者は油をエフーの頭にそそいで言った。「イスラエルの神、主は、こう仰せられる。『わたしはあなたに油をそそいで、主の民イスラエルの王とする。","tok":[["エフー"],["は"],["立って","たって"],["、"],["家","いえ"],["に"],["入った","はいった"],["。"],["そこ"],["で"],["若い","わかい"],["者","もの"],["は"],["油","あぶら"],["を"],["エフー"],["の"],["頭","あたま"],["に"],["そそいで"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["そそいで"],["、"],["主","ぬし"],["の"],["民","みん"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["。"]]},{"verse":7,"text":"あなたは、主君アハブの家の者を打ち殺さなければならない。こうしてわたしは、わたしのしもべである預言者たちの血、イゼベルによって流された主のすべてのしもべたちの血の復讐をする。","tok":[["あなた"],["は"],["、"],["主君","しゅくん"],["アハブ"],["の"],["家","いえ"],["の"],["者","もの"],["を"],["打ち殺さなければ","うちころさなければ"],["ならない"],["。"],["こう"],["して"],["わたし"],["は"],["、"],["わたし"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["の"],["血","ち"],["、"],["イゼベル"],["によって"],["流された","ながされた"],["主","ぬし"],["の"],["すべて"],["の"],["しもべ"],["たち"],["の"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["。"]]},{"verse":8,"text":"それでアハブの家はことごとく滅びうせる。わたしは、アハブに属する小わっぱから奴隷や自由の者に至るまでを、イスラエルで断ち滅ぼし、","tok":[["それ"],["で"],["アハブ"],["の"],["家","いえ"],["は"],["ことごとく"],["滅び","ほろび"],["うせる"],["。"],["わたし"],["は"],["、"],["アハブ"],["に"],["属する","ぞくする"],["小わっぱ","こわっぱ"],["から"],["奴隷","どれい"],["や"],["自由","じゆう"],["の"],["者","もの"],["に"],["至る","いたる"],["まで"],["を"],["、"],["イスラエル"],["で"],["断ち","たち"],["滅ぼし","ほろぼし"],["、"]]},{"verse":9,"text":"アハブの家をネバテの子ヤロブアムの家のようにし、アヒヤの子バシャの家のようにする。","tok":[["アハブ"],["の"],["家","いえ"],["を"],["ネバテ"],["の"],["子","こ"],["ヤロブアム"],["の"],["家","いえ"],["の"],["よう"],["に"],["し"],["、"],["アヒヤ"],["の"],["子","こ"],["バシャ"],["の"],["家","いえ"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":10,"text":"犬がイズレエルの地所でイゼベルを食らい、だれも彼女を葬る者がいない。』」こう言って彼は戸をあけて逃げた。","tok":[["犬","いぬ"],["が"],["イズレエル"],["の"],["地所","じしょ"],["で"],["イゼベル"],["を"],["食らい","くらい"],["、"],["だれ"],["も"],["彼女","かのじょ"],["を"],["葬る","ほうむる"],["者","もの"],["が"],["いない"],["。"],["』"],["」"],["こう"],["言って","いって"],["彼","かれ"],["は"],["戸","と"],["を"],["あけて"],["逃げた","にげた"],["。"]]},{"verse":11,"text":"エフーが彼の主君の家来たちのところに出て来ると、ひとりが彼に尋ねた。「何事もなかったのですか。あの気の狂った者は何のために来たのですか。」すると、エフーは彼らに答えた。「あなたがたは、あの男も、あの男の言ったことも知っているはずだ。」","tok":[["エフー"],["が"],["彼","かれ"],["の"],["主君","しゅくん"],["の"],["家来","けらい"],["たち"],["の"],["ところ"],["に"],["出て","でて"],["来る","くる"],["と"],["、"],["ひとり"],["が"],["彼","かれ"],["に"],["尋ねた","たずねた"],["。"],["「"],["何事","なにごと"],["も"],["なかった"],["の"],["です"],["か"],["。"],["あの"],["気","き"],["の"],["狂った","くるった"],["者","もの"],["は"],["何","なん"],["の"],["ため"],["に"],["来た","きた"],["の"],["です"],["か"],["。"],["」"],["する"],["と"],["、"],["エフー"],["は"],["彼","かれ"],["ら"],["に"],["答えた","こたえた"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["あの"],["男","おとこ"],["も"],["、"],["あの"],["男","おとこ"],["の"],["言った","いった"],["こと"],["も"],["知って","しって"],["いる"],["はず"],["だ"],["。"],["」"]]},{"verse":12,"text":"彼らは言った。「あなたは偽っている。われわれに教えてくれ。」そこで、彼は答えた。「あの男は私にこんなことを言った。『主はこう仰せられる。わたしはあなたに油をそそいでイスラエルの王とする』と。」","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["偽って","いつわって"],["いる"],["。"],["われわれ"],["に"],["教えて","おしえて"],["くれ"],["。"],["」"],["そこ"],["で"],["、"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["あの"],["男","おとこ"],["は"],["私","わたくし"],["に"],["こんな"],["こと"],["を"],["言った","いった"],["。"],["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["そそいで"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["』"],["と"],["。"],["」"]]},{"verse":13,"text":"すると、彼らは大急ぎで、みな自分の上着を脱ぎ、入口の階段の彼の足もとに敷き、角笛を吹き鳴らして、「エフーは王である」と言った。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["大急ぎ","おおいそぎ"],["で"],["、"],["みな"],["自分","じぶん"],["の"],["上着","うわぎ"],["を"],["脱ぎ","ぬぎ"],["、"],["入口","いりぐち"],["の"],["階段","かいだん"],["の"],["彼","かれ"],["の"],["足もと","あしもと"],["に"],["敷き","しき"],["、"],["角笛","つのぶえ"],["を"],["吹き鳴らして","ふきならして"],["、"],["「"],["エフー"],["は"],["王","おう"],["で"],["ある"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"こうして、ニムシの子ヨシャパテの子エフーは、ヨラムに対して謀反を起こした。――ヨラムは全イスラエルを率いて、ラモテ・ギルアデでアラムの王ハザエルを防いだが、","tok":[["こう"],["して"],["、"],["ニムシ"],["の"],["子","こ"],["ヨシャパテ"],["の"],["子","こ"],["エフー"],["は"],["、"],["ヨラム"],["に対して","にたいして"],["謀反","むほん"],["を"],["起こした","おこした"],["。"],["―"],["―"],["ヨラム"],["は"],["全","ぜん"],["イスラエル"],["を"],["率いて","ひきいて"],["、"],["ラモテ"],["・"],["ギルアデ"],["で"],["アラム"],["の"],["王","おう"],["ハザエル"],["を"],["防いだ","ふせいだ"],["が"],["、"]]},{"verse":15,"text":"ヨラム王は、アラムの王ハザエルと戦ったときにアラム人に負わされた傷をいやすため、イズレエルに帰って来ていた――エフーは言った。「もし、これがあなたがたの本心であれば、だれもこの町からのがれ出て、イズレエルに知らせに行ってはならない。」","tok":[["ヨラム"],["王","おう"],["は"],["、"],["アラム"],["の"],["王","おう"],["ハザエル"],["と"],["戦った","たたかった"],["とき"],["に"],["アラム人","あらむにん"],["に"],["負わされた","おわされた"],["傷","きず"],["を"],["いやす"],["ため"],["、"],["イズレエル"],["に"],["帰って","かえって"],["来て","きて"],["いた"],["―"],["―"],["エフー"],["は"],["言った","いった"],["。"],["「"],["もし"],["、"],["これ"],["が"],["あなた"],["がた"],["の"],["本心","ほんしん"],["で"],["あれば"],["、"],["だれ"],["も"],["この"],["町","まち"],["から"],["のがれ出て","のがれでて"],["、"],["イズレエル"],["に"],["知らせ","しらせ"],["に"],["行って","いって"],["は"],["ならない"],["。"],["」"]]},{"verse":16,"text":"それから、エフーは車に乗って、イズレエルへ行った。ヨラムがそこで床についており、ユダの王アハズヤもヨラムを見舞いに下っていたからである。","tok":[["それ"],["から"],["、"],["エフー"],["は"],["車","くるま"],["に"],["乗って","のって"],["、"],["イズレエル"],["へ"],["行った","いった"],["。"],["ヨラム"],["が"],["そこ"],["で"],["床","ゆか"],["について"],["おり"],["、"],["ユダ"],["の"],["王","おう"],["アハズヤ"],["も"],["ヨラム"],["を"],["見舞い","みまい"],["に"],["下って","くだって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"イズレエルのやぐらの上に、ひとりの見張りが立っていたが、エフーの軍勢がやって来るのを見て、「軍勢が見える」と言った。ヨラムは、「騎兵ひとりを選んで彼らを迎えにやり、お元気ですかと、尋ねさせなさい」と言った。","tok":[["イズレエル"],["の"],["やぐら"],["の"],["上","うえ"],["に"],["、"],["ひとり"],["の"],["見張り","みはり"],["が"],["立って","たって"],["いた"],["が"],["、"],["エフー"],["の"],["軍勢","ぐんぜい"],["が"],["やって"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["「"],["軍勢","ぐんぜい"],["が"],["見える","みえる"],["」"],["と"],["言った","いった"],["。"],["ヨラム"],["は"],["、"],["「"],["騎兵","きへい"],["ひとり"],["を"],["選んで","えらんで"],["彼","かれ"],["ら"],["を"],["迎え","むかえ"],["に"],["やり"],["、"],["お元気","おげんき"],["です"],["か"],["と"],["、"],["尋ねさせ","たずねさせ"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"そこで、騎兵は彼を迎えに行って言った。「王が、お元気ですかと尋ねておられます。」エフーは言った。「元気かどうか、あなたの知ったことではない。私のうしろについて来い。」一方、見張りは報告して言った。「使者は彼らのところに着きましたが、帰って来ません。」","tok":[["そこ"],["で"],["、"],["騎兵","きへい"],["は"],["彼","かれ"],["を"],["迎え","むかえ"],["に"],["行って","いって"],["言った","いった"],["。"],["「"],["王","おう"],["が"],["、"],["お元気","おげんき"],["です"],["か"],["と"],["尋ねて","たずねて"],["おられます"],["。"],["」"],["エフー"],["は"],["言った","いった"],["。"],["「"],["元気","げんき"],["か"],["どう"],["か"],["、"],["あなた"],["の"],["知った","しった"],["こと"],["で"],["は"],["ない"],["。"],["私","わたくし"],["の"],["うしろ"],["について"],["来い","こい"],["。"],["」"],["一方","いっぽう"],["、"],["見張り","みはり"],["は"],["報告","ほうこく"],["して"],["言った","いった"],["。"],["「"],["使者","ししゃ"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["着きました","つきました"],["が"],["、"],["帰って","かえって"],["来ません","きません"],["。"],["」"]]},{"verse":19,"text":"そこでヨラムは、もうひとりの騎兵を送った。彼は彼らのところに行って言った。「王が、お元気ですかと尋ねておられます。」すると、エフーは言った。「元気かどうか、あなたの知ったことではない。私のうしろについて来い。」","tok":[["そこ"],["で"],["ヨラム"],["は"],["、"],["もう"],["ひとり"],["の"],["騎兵","きへい"],["を"],["送った","おくった"],["。"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["行って","いって"],["言った","いった"],["。"],["「"],["王","おう"],["が"],["、"],["お元気","おげんき"],["です"],["か"],["と"],["尋ねて","たずねて"],["おられます"],["。"],["」"],["する"],["と"],["、"],["エフー"],["は"],["言った","いった"],["。"],["「"],["元気","げんき"],["か"],["どう"],["か"],["、"],["あなた"],["の"],["知った","しった"],["こと"],["で"],["は"],["ない"],["。"],["私","わたくし"],["の"],["うしろ"],["について"],["来い","こい"],["。"],["」"]]},{"verse":20,"text":"見張りはまた、報告して言った。「あれは彼らのところに着きましたが、帰って来ません。しかし、車の御し方は、ニムシの子エフーの御し方に似ています。気が狂ったように御しています。」","tok":[["見張り","みはり"],["は"],["また"],["、"],["報告","ほうこく"],["して"],["言った","いった"],["。"],["「"],["あれ"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["着きました","つきました"],["が"],["、"],["帰って","かえって"],["来ません","きません"],["。"],["しかし"],["、"],["車","くるま"],["の"],["御し方","おしかた"],["は"],["、"],["ニムシ"],["の"],["子","こ"],["エフー"],["の"],["御し","ぎょし"],["方","かた"],["に"],["似て","にて"],["い
[{"verse":1,"text":"だれが知恵ある者にふさわしいだろう。／だれが事物の意義を知りえよう。／人の知恵は、その人の顔を輝かし、その顔の固さを和らげる。","tok":[["だれ"],["が"],["知恵","ちえ"],["ある"],["者","もの"],["に"],["ふさわしいだろう"],["。"],["／"],["だれ"],["が"],["事物","じぶつ"],["の"],["意義","いぎ"],["を"],["知り","しり"],["えよう"],["。"],["／"],["人","ひと"],["の"],["知恵","ちえ"],["は"],["、"],["その"],["人","ひと"],["の"],["顔","かお"],["を"],["輝かし","かがやかし"],["、"],["その"],["顔","かお"],["の"],["固","かた"],["さ"],["を"],["和らげる","やわらげる"],["。"]]},{"verse":2,"text":"私は言う。王の命令を守れ。神の誓約があるから。","tok":[["私","わたくし"],["は"],["言う","ゆう"],["。"],["王","おう"],["の"],["命令","めいれい"],["を"],["守れ","まもれ"],["。"],["神","かみ"],["の"],["誓約","せいやく"],["が"],["ある"],["から"],["。"]]},{"verse":3,"text":"王の前からあわてて退出するな。悪事に荷担するな。王は自分の望むままを何でもするから。","tok":[["王","おう"],["の"],["前","まえ"],["から"],["あわてて"],["退出","たいしゅつ"],["する"],["な"],["。"],["悪事","あくじ"],["に"],["荷担","かたん"],["する"],["な"],["。"],["王","おう"],["は"],["自分","じぶん"],["の"],["望む","のぞむ"],["まま"],["を"],["何","なん"],["で"],["も"],["する"],["から"],["。"]]},{"verse":4,"text":"王のことばには権威がある。だれが彼に、「あなたは何をするのですか」と言えようか。","tok":[["王","おう"],["の"],["ことば"],["に"],["は"],["権威","けんい"],["が"],["ある"],["。"],["だれ"],["が"],["彼","かれ"],["に"],["、"],["「"],["あなた"],["は"],["何","なん"],["を"],["する"],["の"],["です"],["か"],["」"],["と"],["言えよう","いえよう"],["か"],["。"]]},{"verse":5,"text":"命令を守る者はわざわいを知らない。／知恵ある者の心は時とさばきを知っている。","tok":[["命令","めいれい"],["を"],["守る","まもる"],["者","もの"],["は"],["わざわい"],["を"],["知らない","しらない"],["。"],["／"],["知恵","ちえ"],["ある"],["者","もの"],["の"],["心","こころ"],["は"],["時","とき"],["と"],["さばき"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":6,"text":"すべての営みには時とさばきがある。人に降りかかるわざわいが多いからだ。","tok":[["すべて"],["の"],["営み","いとなみ"],["に"],["は"],["時","とき"],["と"],["さばき"],["が"],["ある"],["。"],["人","ひと"],["に"],["降りかかる","ふりかかる"],["わざわい"],["が"],["多い","おおい"],["から"],["だ"],["。"]]},{"verse":7,"text":"何が起こるかを知っている者はいない。いつ起こるかをだれも告げることはできない。","tok":[["何","なん"],["が"],["起こる","おこる"],["か"],["を"],["知って","しって"],["いる"],["者","もの"],["は"],["いない"],["。"],["いつ"],["起こる","おこる"],["か"],["を"],["だれ"],["も"],["告げる","つげる"],["こと"],["は"],["できない"],["。"]]},{"verse":8,"text":"風を支配し、風を止めることのできる人はいない。死の日も支配することはできない。この戦いから放免される者はいない。悪は悪の所有者を救いえない。","tok":[["風","かぜ"],["を"],["支配","しはい"],["し"],["、"],["風","かぜ"],["を"],["止める","とめる"],["こと"],["の"],["できる"],["人","ひと"],["は"],["いない"],["。"],["死","し"],["の"],["日","ひ"],["も"],["支配","しはい"],["する"],["こと"],["は"],["できない"],["。"],["この"],["戦い","たたかい"],["から"],["放免","ほうめん"],["される"],["者","もの"],["は"],["いない"],["。"],["悪","あく"],["は"],["悪","あく"],["の"],["所有者","しょゆうしゃ"],["を"],["救い","すくい"],["えない"],["。"]]},{"verse":9,"text":"私はこのすべてを見て、日の下で行われるいっさいのわざ、人が人を支配して、わざわいを与える時について、私の心を用いた。","tok":[["私","わたくし"],["は"],["この"],["すべて"],["を"],["見て","みて"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["行われる","おこなわれる"],["いっさい"],["の"],["わざ"],["、"],["人","ひと"],["が"],["人","ひと"],["を"],["支配","しはい"],["して"],["、"],["わざわい"],["を"],["与える","あたえる"],["時","とき"],["について"],["、"],["私","わたくし"],["の"],["心","こころ"],["を"],["用いた","もちいた"],["。"]]},{"verse":10,"text":"そこで、私は見た。悪者どもが葬られて、行くのを。しかし、正しい行いの者が、聖なる方の所を去り、そうして、町で忘れられるのを。これもまた、むなしい。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["見た","みた"],["。"],["悪者","わるもの"],["ども"],["が"],["葬られて","ほうむられて"],["、"],["行く","いく"],["の"],["を"],["。"],["しかし"],["、"],["正しい","ただしい"],["行い","おこない"],["の"],["者","もの"],["が"],["、"],["聖","せい"],["なる"],["方","かた"],["の"],["所","ところ"],["を"],["去り","さり"],["、"],["そう"],["して"],["、"],["町","まち"],["で"],["忘れられる","わすれられる"],["の"],["を"],["。"],["これ"],["も"],["また"],["、"],["むなしい"],["。"]]},{"verse":11,"text":"悪い行いに対する宣告がすぐ下されないので、人の子らの心は悪を行う思いで満ちている。","tok":[["悪い","わるい"],["行い","おこない"],["に"],["対する","たいする"],["宣告","せんこく"],["が"],["すぐ"],["下されない","くだされない"],["ので"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["心","こころ"],["は"],["悪","あく"],["を"],["行う","おこなう"],["思い","おもい"],["で"],["満ちて","みちて"],["いる"],["。"]]},{"verse":12,"text":"罪人が、百度悪事を犯しても、長生きしている。しかし私は、神を恐れる者も、神を敬って、しあわせであることを知っている。","tok":[["罪人","ざいにん"],["が"],["、"],["百","ひゃく"],["度","ど"],["悪事","あくじ"],["を"],["犯して","おかして"],["も"],["、"],["長生き","ながいき"],["して"],["いる"],["。"],["しかし"],["私","わたくし"],["は"],["、"],["神","かみ"],["を"],["恐れる","おそれる"],["者","もの"],["も"],["、"],["神","かみ"],["を"],["敬って","うやまって"],["、"],["しあわせ"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":13,"text":"悪者にはしあわせがない。その生涯を影のように長くすることはできない。彼らは神を敬わないからだ。","tok":[["悪者","わるもの"],["に"],["は"],["しあわせ"],["が"],["ない"],["。"],["その"],["生涯","しょうがい"],["を"],["影","かげ"],["の"],["よう"],["に"],["長く","ながく"],["する"],["こと"],["は"],["できない"],["。"],["彼","かれ"],["ら"],["は"],["神","かみ"],["を"],["敬わない","うやまわない"],["から"],["だ"],["。"]]},{"verse":14,"text":"しかし、むなしいことが地上で行われている。悪者の行いに対する報いを正しい人がその身に受け、正しい人の行いに対する報いを悪者がその身に受けることがある。これもまた、むなしい、と私は言いたい。","tok":[["しかし"],["、"],["むなしい"],["こと"],["が"],["地上","ちじょう"],["で"],["行われて","おこなわれて"],["いる"],["。"],["悪者","わるもの"],["の"],["行い","おこない"],["に"],["対する","たいする"],["報い","むくい"],["を"],["正しい","ただしい"],["人","ひと"],["が"],["その"],["身","み"],["に"],["受け","うけ"],["、"],["正しい","ただしい"],["人","ひと"],["の"],["行い","おこない"],["に"],["対する","たいする"],["報い","むくい"],["を"],["悪者","わるもの"],["が"],["その"],["身","み"],["に"],["受ける","うける"],["こと"],["が"],["ある"],["。"],["これ"],["も"],["また"],["、"],["むなしい"],["、"],["と"],["私","わたくし"],["は"],["言いたい","いいたい"],["。"]]},{"verse":15,"text":"私は快楽を賛美する。日の下では、食べて、飲んで、楽しむよりほかに、人にとって良いことはない。これは、日の下で、神が人に与える一生の間に、その労苦に添えてくださるものだ。","tok":[["私","わたくし"],["は"],["快楽","かいらく"],["を"],["賛美","さんび"],["する"],["。"],["日","ひ"],["の"],["下","もと"],["で"],["は"],["、"],["食べて","たべて"],["、"],["飲んで","のんで"],["、"],["楽しむ","たのしむ"],["より"],["ほか"],["に"],["、"],["人","ひと"],["にとって"],["良い","よい"],["こと"],["は"],["ない"],["。"],["これ"],["は"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["、"],["神","かみ"],["が"],["人","ひと"],["に"],["与える","あたえる"],["一生","いっしょう"],["の"],["間","あいだ"],["に"],["、"],["その"],["労苦","ろうく"],["に"],["添えて","そえて"],["くださる"],["もの"],["だ"],["。"]]},{"verse":16,"text":"私は一心に知恵を知り、昼も夜も眠らずに、地上で行われる人の仕事を見ようとしたとき、","tok":[["私","わたくし"],["は"],["一心","いっしん"],["に"],["知恵","ちえ"],["を"],["知り","しり"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["眠らず","ねむらず"],["に"],["、"],["地上","ちじょう"],["で"],["行われる","おこなわれる"],["人","ひと"],["の"],["仕事","しごと"],["を"],["見よう","みよう"],["と"],["した"],["とき"],["、"]]},{"verse":17,"text":"すべては神のみわざであることがわかった。人は日の下で行われるみわざを見きわめることはできない。人は労苦して捜し求めても、見いだすことはない。知恵ある者が知っていると思っても、見きわめることはできない。","tok":[["すべて"],["は"],["神","かみ"],["のみ"],["わざ"],["で"],["ある"],["こと"],["が"],["わかった"],["。"],["人","ひと"],["は"],["日","ひ"],["の"],["下","もと"],["で"],["行われる","おこなわれる"],["みわざ"],["を"],["見きわめる","みきわめる"],["こと"],["は"],["できない"],["。"],["人","ひと"],["は"],["労苦","ろうく"],["して"],["捜し求めて","さがしもとめて"],["も"],["、"],["見いだす","みいだす"],["こと"],["は"],["ない"],["。"],["知恵","ちえ"],["ある"],["者","もの"],["が"],["知って","しって"],["いる"],["と"],["思って","おもって"],["も"],["、"],["見きわめる","みきわめる"],["こと"],["は"],["できない"],["。"]]}]
[{"verse":1,"text":"エルサレムでの王、ダビデの子、伝道者のことば。","tok":[["エルサレム"],["で"],["の"],["王","おう"],["、"],["ダビデ"],["の"],["子","こ"],["、"],["伝道者","でんどうしゃ"],["の"],["ことば"],["。"]]},{"verse":2,"text":"空の空。伝道者は言う。／空の空。すべては空。","tok":[["空","そら"],["の"],["空","そら"],["。"],["伝道者","でんどうしゃ"],["は"],["言う","ゆう"],["。"],["／"],["空","そら"],["の"],["空","そら"],["。"],["すべて"],["は"],["空","そら"],["。"]]},{"verse":3,"text":"日の下で、どんなに労苦しても、それが人に何の益になろう。","tok":[["日","ひ"],["の"],["下","もと"],["で"],["、"],["どんな"],["に"],["労苦","ろうく"],["して"],["も"],["、"],["それ"],["が"],["人","ひと"],["に"],["何","なん"],["の"],["益","えき"],["に"],["なろう"],["。"]]},{"verse":4,"text":"一つの時代は去り、次の時代が来る。／しかし地はいつまでも変わらない。","tok":[["一","ひと"],["つ"],["の"],["時代","じだい"],["は"],["去り","さり"],["、"],["次","つぎ"],["の"],["時代","じだい"],["が"],["来る","くる"],["。"],["／"],["しかし"],["地","ち"],["は"],["いつ"],["まで"],["も"],["変わらない","かわらない"],["。"]]},{"verse":5,"text":"日は上り、日は沈み、またもとの上る所に帰って行く。","tok":[["日","ひ"],["は"],["上り","のぼり"],["、"],["日","ひ"],["は"],["沈み","しずみ"],["、"],["また"],["もと"],["の"],["上る","のぼる"],["所","ところ"],["に"],["帰って","かえって"],["行く","いく"],["。"]]},{"verse":6,"text":"風は南に吹き、巡って北に吹く。／巡り巡って風は吹く。／しかし、その巡る道に風は帰る。","tok":[["風","かぜ"],["は"],["南","みなみ"],["に"],["吹き","ふき"],["、"],["巡って","めぐって"],["北","きた"],["に"],["吹く","ふく"],["。"],["／"],["巡り巡って","めぐりめぐって"],["風","かぜ"],["は"],["吹く","ふく"],["。"],["／"],["しかし"],["、"],["その"],["巡る","めぐる"],["道","みち"],["に"],["風","かぜ"],["は"],["帰る","かえる"],["。"]]},{"verse":7,"text":"川はみな海に流れ込むが、海は満ちることがない。／川は流れ込む所に、また流れる。","tok":[["川","かわ"],["は"],["みな"],["海","うみ"],["に"],["流れ込む","ながれこむ"],["が"],["、"],["海","うみ"],["は"],["満ちる","みちる"],["こと"],["が"],["ない"],["。"],["／"],["川","かわ"],["は"],["流れ込む","ながれこむ"],["所","ところ"],["に"],["、"],["また"],["流れる","ながれる"],["。"]]},{"verse":8,"text":"すべての事はものうい。／人は語ることさえできない。／目は見て飽きることもなく、耳は聞いて満ち足りることもない。","tok":[["すべて"],["の"],["事","こと"],["は"],["ものうい"],["。"],["／"],["人","ひと"],["は"],["語る","かたる"],["こと"],["さえ"],["できない"],["。"],["／"],["目","め"],["は"],["見て","みて"],["飽きる","あきる"],["こと"],["も"],["なく"],["、"],["耳","みみ"],["は"],["聞いて","きいて"],["満ち足りる","みちたりる"],["こと"],["も"],["ない"],["。"]]},{"verse":9,"text":"昔あったものは、これからもあり、昔起こったことは、これからも起こる。／日の下には新しいものは一つもない。","tok":[["昔","むかし"],["あった"],["もの"],["は"],["、"],["これ"],["から"],["も"],["あり"],["、"],["昔","むかし"],["起こった","おこった"],["こと"],["は"],["、"],["これ"],["から"],["も"],["起こる","おこる"],["。"],["／"],["日","にち"],["の"],["下","した"],["に"],["は"],["新しい","あたらしい"],["もの"],["は"],["一","ひと"],["つ"],["も"],["ない"],["。"]]},{"verse":10,"text":"「これを見よ。これは新しい」と言われるものがあっても、それは、私たちよりはるか先の時代に、すでにあったものだ。","tok":[["「"],["これ"],["を"],["見よ","みよ"],["。"],["これ"],["は"],["新しい","あたらしい"],["」"],["と"],["言われる","いわれる"],["もの"],["が"],["あって"],["も"],["、"],["それ"],["は"],["、"],["私たち","わたしたち"],["より"],["はるか"],["先","さき"],["の"],["時代","じだい"],["に"],["、"],["すでに"],["あった"],["もの"],["だ"],["。"]]},{"verse":11,"text":"先にあったことは記憶に残っていない。これから後に起こることも、それから後の時代の人々には記憶されないであろう。","tok":[["先","さき"],["に"],["あった"],["こと"],["は"],["記憶","きおく"],["に"],["残って","のこって"],["いない"],["。"],["これ"],["から"],["後","あと"],["に"],["起こる","おこる"],["こと"],["も"],["、"],["それ"],["から"],["後","あと"],["の"],["時代","じだい"],["の"],["人々","ひとびと"],["に"],["は"],["記憶","きおく"],["されないで"],["あろう"],["。"]]},{"verse":12,"text":"伝道者である私は、エルサレムでイスラエルの王であった。","tok":[["伝道者","でんどうしゃ"],["で"],["ある"],["私","わたくし"],["は"],["、"],["エルサレム"],["で"],["イスラエル"],["の"],["王","おう"],["で"],["あった"],["。"]]},{"verse":13,"text":"私は、天の下で行われるいっさいの事について、知恵を用いて、一心に尋ね、探り出そうとした。これは、人の子らが労苦するようにと神が与えたつらい仕事だ。","tok":[["私","わたくし"],["は"],["、"],["天","てん"],["の"],["下","もと"],["で"],["行われる","おこなわれる"],["いっさい"],["の"],["事","こと"],["について"],["、"],["知恵","ちえ"],["を"],["用いて","もちいて"],["、"],["一心","いっしん"],["に"],["尋ね","たずね"],["、"],["探り出そう","さぐりだそう"],["と"],["した"],["。"],["これ"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["が"],["労苦","ろうく"],["する"],["よう"],["に"],["と"],["神","かみ"],["が"],["与えた","あたえた"],["つらい"],["仕事","しごと"],["だ"],["。"]]},{"verse":14,"text":"私は、日の下で行われたすべてのわざを見たが、なんと、すべてがむなしいことよ。風を追うようなものだ。","tok":[["私","わたくし"],["は"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["行われた","おこなわれた"],["すべて"],["の"],["わざ"],["を"],["見た","みた"],["が"],["、"],["なん"],["と"],["、"],["すべて"],["が"],["むなしい"],["こと"],["よ"],["。"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":15,"text":"曲がっているものを、まっすぐにはできない。／なくなっているものを、数えることはできない。","tok":[["曲がって","まがって"],["いる"],["もの"],["を"],["、"],["まっすぐ"],["に"],["は"],["できない"],["。"],["／"],["なくなって"],["いる"],["もの"],["を"],["、"],["数える","かぞえる"],["こと"],["は"],["できない"],["。"]]},{"verse":16,"text":"私は自分の心にこう語って言った。「今や、私は、私より先にエルサレムにいただれよりも知恵を増し加えた。私の心は多くの知恵と知識を得た。」","tok":[["私","わたくし"],["は"],["自分","じぶん"],["の"],["心","こころ"],["に"],["こう"],["語って","かたって"],["言った","いった"],["。"],["「"],["今","いま"],["や"],["、"],["私","わたくし"],["は"],["、"],["私","わたくし"],["より"],["先","さき"],["に"],["エルサレム"],["に"],["いた"],["だれ"],["より"],["も"],["知恵","ちえ"],["を"],["増し加えた","ましくわえた"],["。"],["私","わたくし"],["の"],["心","こころ"],["は"],["多く","おおく"],["の"],["知恵","ちえ"],["と"],["知識","ちしき"],["を"],["得た","えた"],["。"],["」"]]},{"verse":17,"text":"私は、一心に知恵と知識を、狂気と愚かさを知ろうとした。それもまた風を追うようなものであることを知った。","tok":[["私","わたくし"],["は"],["、"],["一心","いっしん"],["に"],["知恵","ちえ"],["と"],["知識","ちしき"],["を"],["、"],["狂気","きょうき"],["と"],["愚か","おろか"],["さ"],["を"],["知ろう","しろう"],["と"],["した"],["。"],["それ"],["も"],["また"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["もの"],["で"],["ある"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":18,"text":"実に、知恵が多くなれば悩みも多くなり、知識を増す者は悲しみを増す。","tok":[["実","じつ"],["に"],["、"],["知恵","ちえ"],["が"],["多く","おおく"],["なれば"],["悩み","なやみ"],["も"],["多く","おおく"],["なり"],["、"],["知識","ちしき"],["を"],["増す","ます"],["者","もの"],["は"],["悲しみ","かなしみ"],["を"],["増す","ます"],["。"]]}]
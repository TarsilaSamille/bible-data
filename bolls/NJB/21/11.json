[{"verse":1,"text":"あなたのパンを水の上に投げよ。／ずっと後の日になって、あなたはそれを見いだそう。","tok":[["あなた"],["の"],["パン"],["を"],["水","みず"],["の"],["上","うえ"],["に"],["投げ","なげ"],["よ"],["。"],["／"],["ずっと"],["後","あと"],["の"],["日","ひ"],["に"],["なって"],["、"],["あなた"],["は"],["それ"],["を"],["見いだそう","みいだそう"],["。"]]},{"verse":2,"text":"あなたの受ける分を七人か八人に分けておけ。／地上でどんなわざわいが起こるか／あなたは知らないのだから。","tok":[["あなた"],["の"],["受ける","うける"],["分","ぶん"],["を"],["七人","しちにん"],["か"],["八人","はちにん"],["に"],["分けて","わけて"],["おけ"],["。"],["／"],["地上","ちじょう"],["で"],["どんな"],["わざわい"],["が"],["起こる","おこる"],["か"],["／"],["あなた"],["は"],["知らない","しらない"],["の"],["だ"],["から"],["。"]]},{"verse":3,"text":"雲が雨で満ちると、それは地上に降り注ぐ。／木が南風や北風で倒されると、その木は倒れた場所にそのままにある。","tok":[["雲","くも"],["が"],["雨","あめ"],["で"],["満ちる","みちる"],["と"],["、"],["それ"],["は"],["地上","ちじょう"],["に"],["降り注ぐ","ふりそそぐ"],["。"],["／"],["木","き"],["が"],["南風","はえ"],["や"],["北風","きたかぜ"],["で"],["倒される","たおされる"],["と"],["、"],["その"],["木","き"],["は"],["倒れた","たおれた"],["場所","ばしょ"],["に"],["そのまま"],["に"],["ある"],["。"]]},{"verse":4,"text":"風を警戒している人は種を蒔かない。／雲を見ている者は刈り入れをしない。","tok":[["風","かぜ"],["を"],["警戒","けいかい"],["して"],["いる"],["人","ひと"],["は"],["種","しゅ"],["を"],["蒔かない","まかない"],["。"],["／"],["雲","くも"],["を"],["見て","みて"],["いる"],["者","もの"],["は"],["刈り入れ","かりいれ"],["を"],["しない"],["。"]]},{"verse":5,"text":"あなたは妊婦の胎内の骨々のことと同様、風の道がどのようなものかを知らない。そのように、あなたはいっさいを行われる神のみわざを知らない。","tok":[["あなた"],["は"],["妊婦","にんぷ"],["の"],["胎内","たいない"],["の"],["骨々","ほねぼね"],["の"],["こと"],["と"],["同様","どうよう"],["、"],["風","かぜ"],["の"],["道","みち"],["が"],["どのような"],["もの"],["か"],["を"],["知らない","しらない"],["。"],["その"],["よう"],["に"],["、"],["あなた"],["は"],["いっさい"],["を"],["行われる","おこなわれる"],["神","かみ"],["のみ"],["わざ"],["を"],["知らない","しらない"],["。"]]},{"verse":6,"text":"朝のうちにあなたの種を蒔け。夕方も手を放してはいけない。あなたは、あれか、これか、どこで成功するのか、知らないからだ。二つとも同じようにうまくいくかもわからない。","tok":[["朝","あさ"],["の"],["うち"],["に"],["あなた"],["の"],["種","たね"],["を"],["蒔け","まけ"],["。"],["夕方","ゆうがた"],["も"],["手","て"],["を"],["放して","はなして"],["は"],["いけない"],["。"],["あなた"],["は"],["、"],["あれ"],["か"],["、"],["これ"],["か"],["、"],["どこ"],["で"],["成功","せいこう"],["する"],["の"],["か"],["、"],["知らない","しらない"],["から"],["だ"],["。"],["二","ふた"],["つ"],["とも"],["同じ","おなじ"],["よう"],["に"],["うまく"],["いく"],["か"],["も"],["わからない"],["。"]]},{"verse":7,"text":"光は快い。太陽を見ることは目のために良い。","tok":[["光","ひかり"],["は"],["快い","こころよい"],["。"],["太陽","たいよう"],["を"],["見る","みる"],["こと"],["は"],["目","め"],["の"],["ため"],["に"],["良い","よい"],["。"]]},{"verse":8,"text":"人は長年生きて、ずっと楽しむがよい。だが、やみの日も数多くあることを忘れてはならない。すべて起こることはみな、むなしい。","tok":[["人","ひと"],["は"],["長年","ながねん"],["生きて","いきて"],["、"],["ずっと"],["楽しむ","たのしむ"],["が"],["よい"],["。"],["だ"],["が"],["、"],["やみ"],["の"],["日","ひ"],["も"],["数多く","かずおおく"],["ある"],["こと"],["を"],["忘れて","わすれて"],["は"],["ならない"],["。"],["すべて"],["起こる","おこる"],["こと"],["は"],["みな"],["、"],["むなしい"],["。"]]},{"verse":9,"text":"若い男よ。若いうちに楽しめ。若い日にあなたの心を喜ばせよ。あなたの心のおもむくまま、あなたの目の望むままに歩め。しかし、これらすべての事において、あなたは神のさばきを受けることを知っておけ。","tok":[["若い","わかい"],["男","おとこ"],["よ"],["。"],["若い","わかい"],["うち"],["に"],["楽しめ","たのしめ"],["。"],["若い","わかい"],["日","ひ"],["に"],["あなた"],["の"],["心","こころ"],["を"],["喜ばせ","よろこばせ"],["よ"],["。"],["あなた"],["の"],["心","こころ"],["の"],["おもむく"],["まま"],["、"],["あなた"],["の"],["目","め"],["の"],["望む","のぞむ"],["まま"],["に"],["歩め","あゆめ"],["。"],["しかし"],["、"],["これ"],["ら"],["すべて"],["の"],["事","こと"],["に"],["おいて"],["、"],["あなた"],["は"],["神","かみ"],["の"],["さばき"],["を"],["受ける","うける"],["こと"],["を"],["知って","しって"],["おけ"],["。"]]},{"verse":10,"text":"だから、あなたの心から悲しみを除き、あなたの肉体から痛みを取り去れ。若さも、青春も、むなしいからだ。","tok":[["だ"],["から"],["、"],["あなた"],["の"],["心","こころ"],["から"],["悲しみ","かなしみ"],["を"],["除き","のぞき"],["、"],["あなた"],["の"],["肉体","にくたい"],["から"],["痛み","いたみ"],["を"],["取り去れ","とりされ"],["。"],["若","わか"],["さ"],["も"],["、"],["青春","せいしゅん"],["も"],["、"],["むなしい"],["から"],["だ"],["。"]]}]
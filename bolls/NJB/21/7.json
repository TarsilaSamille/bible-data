[{"verse":1,"text":"良い名声は良い香油にまさり、死の日は生まれる日にまさる。","tok":[["良い","よい"],["名声","めいせい"],["は"],["良い","よい"],["香油","こうゆ"],["に"],["まさり"],["、"],["死","し"],["の"],["日","ひ"],["は"],["生まれる","うまれる"],["日","ひ"],["に"],["まさる"],["。"]]},{"verse":2,"text":"祝宴の家に行くよりは、喪中の家に行くほうがよい。／そこには、すべての人の終わりがあり、生きている者が／それを心に留めるようになるからだ。","tok":[["祝宴","しゅくえん"],["の"],["家","いえ"],["に"],["行く","いく"],["より"],["は"],["、"],["喪中","もちゅう"],["の"],["家","いえ"],["に"],["行く","いく"],["ほう"],["が"],["よい"],["。"],["／"],["そこ"],["に"],["は"],["、"],["すべて"],["の"],["人","ひと"],["の"],["終わり","おわり"],["が"],["あり"],["、"],["生きて","いきて"],["いる"],["者","もの"],["が"],["／"],["それ"],["を"],["心","こころ"],["に"],["留める","とめる"],["よう"],["に"],["なる"],["から"],["だ"],["。"]]},{"verse":3,"text":"悲しみは笑いにまさる。／顔の曇りによって心は良くなる。","tok":[["悲しみ","かなしみ"],["は"],["笑い","わらい"],["に"],["まさる"],["。"],["／"],["顔","かお"],["の"],["曇り","くもり"],["によって"],["心","こころ"],["は"],["良く","よく"],["なる"],["。"]]},{"verse":4,"text":"知恵ある者の心は喪中の家に向き、愚かな者の心は楽しみの家に向く。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["心","こころ"],["は"],["喪中","もちゅう"],["の"],["家","いえ"],["に"],["向き","むき"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["心","こころ"],["は"],["楽しみ","たのしみ"],["の"],["家","いえ"],["に"],["向く","むく"],["。"]]},{"verse":5,"text":"知恵ある者の叱責を聞くのは、愚かな者の歌を聞くのにまさる。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["叱責","しっせき"],["を"],["聞く","きく"],["の"],["は"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["歌","うた"],["を"],["聞く","きく"],["のに"],["まさる"],["。"]]},{"verse":6,"text":"愚かな者の笑いは、なべの下のいばらがはじける音に似ている。／これもまた、むなしい。","tok":[["愚か","おろか"],["な"],["者","もの"],["の"],["笑い","わらい"],["は"],["、"],["なべ"],["の"],["下","した"],["の"],["いばら"],["が"],["はじける"],["音","おと"],["に"],["似て","にて"],["いる"],["。"],["／"],["これ"],["も"],["また"],["、"],["むなしい"],["。"]]},{"verse":7,"text":"しいたげは知恵ある者を愚かにし、まいないは心を滅ぼす。","tok":[["しいたげ"],["は"],["知恵","ちえ"],["ある"],["者","もの"],["を"],["愚か","おろか"],["に"],["し"],["、"],["まいない"],["は"],["心","こころ"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":8,"text":"事の終わりは、その初めにまさり、忍耐は、うぬぼれにまさる。","tok":[["事","こと"],["の"],["終わり","おわり"],["は"],["、"],["その"],["初め","はじめ"],["に"],["まさり"],["、"],["忍
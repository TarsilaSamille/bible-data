[{"verse":1,"text":"私は日の下で、もう一つの悪があるのを見た。それは人の上に重くのしかかっている。","tok":[["私","わたくし"],["は"],["日","ひ"],["の"],["下","もと"],["で"],["、"],["もう"],["一","ひと"],["つ"],["の"],["悪","あく"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"],["それ"],["は"],["人","ひと"],["の"],["上","うえ"],["に"],["重く","おもく"],["のしかかって"],["いる"],["。"]]},{"verse":2,"text":"神が富と財宝と誉れとを与え、彼の望むもので何一つ欠けたもののない人がいる。しかし、神は、この人がそれを楽しむことを許さず、外国人がそれを楽しむようにされる。これはむなしいことで、それは悪い病だ。","tok":[["神","かみ"],["が"],["富","とみ"],["と"],["財宝","ざいほう"],["と"],["誉れ","ほまれ"],["と"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["の"],["望む","のぞむ"],["もの"],["で"],["何","なん"],["一","ひと"],["つ"],["欠けた","かけた"],["もの"],["の"],["ない"],["人","ひと"],["が"],["いる"],["。"],["しかし"],["、"],["神","かみ"],["は"],["、"],["この"],["人","ひと"],["が"],["それ"],["を"],["楽しむ","たのしむ"],["こと"],["を"],["許さず","ゆるさず"],["、"],["外国人","がいこくじん"],["が"],["それ"],["を"],["楽しむ","たのしむ"],["よう"],["に"],["される"],["。"],["これ"],["は"],["むなしい"],["こと"],["で"],["、"],["それ"],["は"],["悪い","わるい"],["病","やまい"],["だ"],["。"]]},{"verse":3,"text":"もし人が百人の子どもを持ち、多くの年月を生き、彼の年が多くなっても、彼が幸いで満たされることなく、墓にも葬られなかったなら、私は言う、死産の子のほうが彼よりはましだと。","tok":[["もし"],["人","ひと"],["が"],["百人","ひゃくにん"],["の"],["子ども","こども"],["を"],["持ち","もち"],["、"],["多く","おおく"],["の"],["年月","としつき"],["を"],["生き","いき"],["、"],["彼","かれ"],["の"],["年","とし"],["が"],["多く","おおく"],["なって"],["も"],["、"],["彼","かれ"],["が"],["幸い","さいわい"],["で"],["満たされる","みたされる"],["こと"],["なく"],["、"],["墓","はか"],["に"],["も"],["葬られなかったなら","ほうむられなかったなら"],["、"],["私","わたくし"],["は"],["言う","いう"],["、"],["死産","しざん"],["の"],["子","こ"],["の"],["ほう"],["が"],["彼","かれ"],["より"],["は"],["まし"],["だ"],["と"],["。"]]},{"verse":4,"text":"その子はむなしく生まれて来て、やみの中に去り、その名はやみの中に消される。","tok":[["その"],["子","こ"],["は"],["むなしく"],["生まれて","うまれて"],["来て","きて"],["、"],["やみ"],["の"],["中","なか"],["に"],["去り","さり"],["、"],["その"],["名","な"],["は"],["やみ"],["の"],["中","なか"],["に"],["消される","けされる"],["。"]]},{"verse":5,"text":"太陽も見ず、何も知らずに。しかし、この子のほうが彼よりは安らかである。","tok":[["太陽","たいよう"],["も"],["見ず","みず"],["、"],["何","なん"],["も"],["知らず","しらず"],["に"],["。"],["しかし"],["、"],["この"],["子","こ"],["の"],["ほう"],["が"],["彼","かれ"],["より"],["は"],["安らか","やすらか"],["で"],["ある"],["。"]]},{"verse":6,"text":"彼が千年の倍も生きても、――しあわせな目に会わなければ――両者とも同じ所に行くのではないか。","tok":[["彼","かれ"],["が"],["千","せん"],["年","ねん"],["の"],["倍","ばい"],["も"],["生きて","いきて"],["も"],["、"],["―"],["―"],["しあわせ"],["な"],["目","め"],["に"],["会わなければ","あわなければ"],["―"],["―"],["両者","りょうしゃ"],["とも"],["同じ","おなじ"],["所","ところ"],["に"],["行く","いく"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":7,"text":"人の労苦はみな、自分の口のためである。／しかし、その食欲は決して満たされない。","tok":[["人","ひと"],["の"],["労苦","ろうく"],["は"],["みな"],["、"],["自分","じぶん"],["の"],["口","くち"],["の"],["ため"],["で"],["ある"],["。"],["／"],["しかし"],["、"],["その"],["食欲","しょくよく"],["は"],["決して","けっして"],["満たされない","みたされない"],["。"]]},{"verse":8,"text":"知恵ある者は、愚かな者より何がまさっていよう。人々の前での生き方を知っている貧しい人も、何がまさっていよう。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["は"],["、"],["愚か","おろか"],["な"],["者","もの"],["より"],["何","なん"],["が"],["まさって"],["いよう"],["。"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["の"],["生き方","いきかた"],["を"],["知って","しって"],["いる"],["貧しい","まずしい"],["人","ひと"],["も"],["、"],["何","なん"],["が"],["まさって"],["いよう"],["。"]]},{"verse":9,"text":"目が見るところは、心があこがれることにまさる。これもまた、むなしく、風を追うようなものだ。","tok":[["目","め"],["が"],["見る","みる"],["ところ"],["は"],["、"],["心","こころ"],["が"],["あこがれる"],["こと"],["に"],["まさる"],["。"],["これ"],["も"],["また"],["、"],["むなしく"],["、"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":10,"text":"今あるものは、何であるか、すでにその名がつけられ、また彼がどんな人であるかも知られている。彼は彼よりも力のある者と争うことはできない。","tok":[["今","いま"],["ある"],["もの"],["は"],["、"],["何","なん"],["で"],["ある"],["か"],["、"],["すでに"],["その"],["名","な"],["が"],["つけられ"],["、"],["また"],["彼","かれ"],["が"],["どんな"],["人","ひと"],["で"],["ある"],["か"],["も"],["知られて","しられて"],["いる"],["。"],["彼","かれ"],["は"],["彼","かれ"],["より"],["も"],["力","ちから"],["の"],["ある"],["者","もの"],["と"],["争う","あらそう"],["こと"],["は"],["できない"],["。"]]},{"verse":11,"text":"多く語れば、それだけむなしさを増す。それは、人にとって何の益になるだろう。","tok":[["多く","おおく"],["語れば","かたれば"],["、"],["それ"],["だけ"],["むなし"],["さ"],["を"],["増す","ます"],["。"],["それ"],["は"],["、"],["人","ひと"],["にとって"],["何","なん"],["の"],["益","えき"],["に"],["なるだろう"],["。"]]},{"verse":12,"text":"だれが知ろうか。影のように過ごすむなしいつかのまの人生で、何が人のために善であるかを。だれが人に告げることができようか。彼の後に、日の下で何が起こるかを。","tok":[["だれ"],["が"],["知ろう","しろう"],["か"],["。"],["影","かげ"],["の"],["よう"],["に"],["過ごす","すごす"],["むなしい"],["つかのま"],["の"],["人生","じんせい"],["で"],["、"],["何","なん"],["が"],["人","ひと"],["の"],["ため"],["に"],["善","ぜん"],["で"],["ある"],["か"],["を"],["。"],["だれ"],["が"],["人","ひと"],["に"],["告げる","つげる"],["こと"],["が"],["できよう"],["か"],["。"],["彼","かれ"],["の"],["後","あと"],["に"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["何","なん"],["が"],["起こる","おこる"],["か"],["を"],["。"]]}]
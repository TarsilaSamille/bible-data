[{"verse":1,"text":"あなたの若い日に、あなたの創造者を覚えよ。わざわいの日が来ないうちに、また「何の喜びもない」と言う年月が近づく前に。","tok":[["あなた"],["の"],["若い","わかい"],["日","ひ"],["に"],["、"],["あなた"],["の"],["創造者","そうぞうしゃ"],["を"],["覚え","おぼえ"],["よ"],["。"],["わざわい"],["の"],["日","ひ"],["が"],["来ない","こない"],["うち"],["に"],["、"],["また"],["「"],["何","なん"],["の"],["喜び","よろこび"],["も"],["ない"],["」"],["と"],["言う","いう"],["年月","としつき"],["が"],["近づく","ちかづく"],["前","まえ"],["に"],["。"]]},{"verse":2,"text":"太陽と光、月と星が暗くなり、雨の後にまた雨雲がおおう前に。","tok":[["太陽","たいよう"],["と"],["光","ひかり"],["、"],["月","つき"],["と"],["星","ほし"],["が"],["暗く","くらく"],["なり"],["、"],["雨","あめ"],["の"],["後","あと"],["に"],["また"],["雨雲","あまぐも"],["が"],["おおう"],["前","まえ"],["に"],["。"]]},{"verse":3,"text":"その日には、家を守る者は震え、力のある男たちは身をかがめ、粉ひき女たちは少なくなって仕事をやめ、窓からながめている女の目は暗くなる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["家","いえ"],["を"],["守る","まもる"],["者","もの"],["は"],["震え","ふるえ"],["、"],["力","ちから"],["の"],["ある"],["男","おとこ"],["たち"],["は"],["身","み"],["を"],["かがめ"],["、"],["粉ひき","こなひき"],["女","おんな"],["たち"],["は"],["少なく","すくなく"],["なって"],["仕事","しごと"],["を"],["やめ"],["、"],["窓","まど"],["から"],["ながめて"],["いる"],["女","おんな"],["の"],["目","め"],["は"],["暗く","くらく"],["なる"],["。"]]},{"verse":4,"text":"通りのとびらは閉ざされ、臼をひく音も低くなり、人は鳥の声に起き上がり、歌を歌う娘たちはみなうなだれる。","tok":[["通り","とおり"],["の"],["とびら"],["は"],["閉ざされ","とざされ"],["、"],["臼","うす"],["を"],["ひく"],["音","おと"],["も"],["低く","ひくく"],["なり"],["、"],["人","ひと"],["は"],["鳥","とり"],["の"],["声","こえ"],["に"],["起き上がり","おきあがり"],["、"],["歌","うた"],["を"],["歌う","うたう"],["娘","むすめ"],["たち"],["は"],["みな"],["うなだれる"],["。"]]},{"verse":5,"text":"彼らはまた高い所を恐れ、道でおびえる。アーモンドの花は咲き、いなごはのろのろ歩き、ふうちょうぼくは花を開く。だが、人は永遠の家へと歩いて行き、嘆く者たちが通りを歩き回る。","tok":[["彼","かれ"],["ら"],["は"],["また"],["高い","たかい"],["所","ところ"],["を"],["恐れ","おそれ"],["、"],["道","みち"],["で"],["おびえる"],["。"],["アーモンド"],["の"],["花","はな"],["は"],["咲き","さき"],["、"],["いなご"],["は"],["のろのろ"],["歩き","あるき"],["、"],["ふう"],["ちょう"],["ぼく"],["は"],["花","はな"],["を"],["開く","ひらく"],["。"],["だ"],["が"],["、"],["人","ひと"],["は"],["永遠","えいえん"],["の"],["家","いえ"],["へ"],["と"],["歩いて","あるいて"],["行き","いき"],["、"],["嘆く","なげく"],["者","もの"],["たち"],["が"],["通り","とおり"],["を"],["歩き回る","あるきまわる"],["。"]]},{"verse":6,"text":"こうしてついに、銀のひもは切れ、金の器は打ち砕かれ、水がめは泉のかたわらで砕かれ、滑車が井戸のそばでこわされる。","tok":[["こう"],["して"],["ついに"],["、"],["銀","ぎん"],["の"],["ひも"],["は"],["切れ","きれ"],["、"],["金","きん"],["の"],["器","うつわ"],["は"],["打ち砕かれ","うちくだかれ"],["、"],["水がめ","みずがめ"],["は"],["泉","いずみ"],["の"],["かたわら"],["で"],["砕かれ","くだかれ"],["、"],["滑車","かっしゃ"],["が"],["井戸","いど"],["の"],["そば"],["で"],["こわされる"],["。"]]},{"verse":7,"text":"ちりはもとあった地に帰り、霊はこれを下さった神に帰る。","tok":[["ちり"],["は"],["もと"],["あった"],["地","ち"],["に"],["帰り","かえり"],["、"],["霊","れい"],["は"],["これ"],["を"],["下さった","くださった"],["神","かみ"],["に"],["帰る","かえる"],["。"]]},{"verse":8,"text":"空の空。伝道者は言う。すべては空。","tok":[["空","そら"],["の"],["空","そら"],["。"],["伝道者","でんどうしゃ"],["は"],["言う","ゆう"],["。"],["すべて"],["は"],["空","そら"],["。"]]},{"verse":9,"text":"伝道者は知恵ある者であったが、そのうえ、知識を民に教えた。彼は思索し、探求し、多くの箴言をまとめた。","tok":[["伝道者","でんどうしゃ"],["は"],["知恵","ちえ"],["ある"],["者","もの"],["で"],["あった"],["が"],["、"],["その"],["うえ"],["、"],["知識","ちしき"],["を"],["民","たみ"],["に"],["教えた","おしえた"],["。"],["彼","かれ"],["は"],["思索","しさく"],["し"],["、"],["探求","たんきゅう"],["し"],["、"],["多く","おおく"],["の"],["箴言","しんげん"],["を"],["まとめた"],["。"]]},{"verse":10,"text":"伝道者は適切なことばを見いだそうとし、真理のことばを正しく書き残した。","tok":[["伝道者","でんどうしゃ"],["は"],["適切","てきせつ"],["な"],["ことば"],["を"],["見いだそう","みいだそう"],["と"],["し"],["、"],["真理","しんり"],["の"],["ことば"],["を"],["正しく","ただしく"],["書き残した","かきのこした"],["。"]]},{"verse":11,"text":"知恵ある者のことばは突き棒のようなもの、編集されたものはよく打ちつけられた釘のようなものである。これらはひとりの羊飼いによって与えられた。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["ことば"],["は"],["突き棒","つきぼう"],["の"],["よう"],["な"],["もの"],["、"],["編集","へんしゅう"],["された"],["もの"],["は"],["よく"],["打ちつけられた","うちつけられた"],["釘","くぎ"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["ひとり"],["の"],["羊飼い","ひつじかい"],["によって"],["与えられた","あたえられた"],["。"]]},{"verse":12,"text":"わが子よ。これ以外のことにも注意せよ。多くの本を作ることには、限りがない。多くのものに熱中すると、からだが疲れる。","tok":[["わが"],["子","こ"],["よ"],["。"],["これ"],["以外","いがい"],["の"],["こと"],["に"],["も"],["注意","ちゅうい"],["せよ"],["。"],["多く","おおく"],["の"],["本","ほん"],["を"],["作る","つくる"],["こと"],["に"],["は"],["、"],["限り","かぎり"],["が"],["ない"],["。"],["多く","おおく"],["の"],["もの"],["に"],["熱中","ねっちゅう"],["する"],["と"],["、"],["からだ"],["が"],["疲れる","つかれる"],["。"]]},{"verse":13,"text":"結局のところ、もうすべてが聞かされていることだ。神を恐れよ。神の命令を守れ。これが人間にとってすべてである。","tok":[["結局","けっきょく"],["の"],["ところ"],["、"],["もう"],["すべて"],["が"],["聞かされて","きかされて"],["いる"],["こと"],["だ"],["。"],["神","かみ"],["を"],["恐れよ","おそれよ"],["。"],["神","かみ"],["の"],["命令","めいれい"],["を"],["守れ","まもれ"],["。"],["これ"],["が"],["人間","にんげん"],["にとって"],["すべて"],["で"],["ある"],["。"]]},{"verse":14,"text":"神は、善であれ悪であれ、すべての隠れたことについて、すべてのわざをさばかれるからだ。","tok":[["神","かみ"],["は"],["、"],["善","ぜん"],["で"],["あれ"],["悪","わる"],["で"],["あれ"],["、"],["すべて"],["の"],["隠れた","かくれた"],["こと"],["について"],["、"],["すべて"],["の"],["わざ"],["を"],["さばかれる"],["から"],["だ"],["。"]]}]
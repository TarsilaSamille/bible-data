[{"verse":1,"text":"死んだはえは、調合した香油を臭くし、発酵させる。／少しの愚かさは、知恵や栄誉よりも重い。","tok":[["死んだ","しんだ"],["は"],["え"],["は"],["、"],["調合","ちょうごう"],["した"],["香油","こうゆ"],["を"],["臭く","くさく"],["し"],["、"],["発酵","はっこう"],["させる"],["。"],["／"],["少し","すこし"],["の"],["愚か","おろか"],["さ"],["は"],["、"],["知恵","ちえ"],["や"],["栄誉","えいよ"],["より"],["も"],["重い","おもい"],["。"]]},{"verse":2,"text":"知恵ある者の心は右に向き、愚かな者の心は左に向く。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["心","こころ"],["は"],["右","みぎ"],["に"],["向き","むき"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["心","こころ"],["は"],["左","ひだり"],["に"],["向く","むく"],["。"]]},{"verse":3,"text":"愚か者が道を行くとき、思慮に欠けている。／自分が愚かであることを、みなに知らせる。","tok":[["愚か者","おろかもの"],["が"],["道","みち"],["を"],["行く","いく"],["とき"],["、"],["思慮","しりょ"],["に"],["欠けて","かけて"],["いる"],["。"],["／"],["自分","じぶん"],["が"],["愚か","おろか"],["で"],["ある"],["こと"],["を"],["、"],["みな"],["に"],["知らせる","しらせる"],["。"]]},{"verse":4,"text":"支配者があなたに向かって立腹しても、あなたはその場を離れてはならない。／冷静は大きな罪を犯さないようにするから。","tok":[["支配者","しはいしゃ"],["が"],["あなた"],["に"],["向かって","むかって"],["立腹","りっぷく"],["して"],["も"],["、"],["あなた"],["は"],["その"],["場","ば"],["を"],["離れて","はなれて"],["は"],["ならない"],["。"],["／"],["冷静","れいせい"],["は"],["大きな","おおきな"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["する"],["から"],["。"]]},{"verse":5,"text":"私は、日の下に一つの悪があるのを見た。／それは／権力者の犯す過失のようなものである。","tok":[["私","わたくし"],["は"],["、"],["日","ひ"],["の"],["下","した"],["に"],["一","ひと"],["つ"],["の"],["悪","あく"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"],["／"],["それ"],["は"],["／"],["権力者","けんりょくしゃ"],["の"],["犯す","おかす"],["過失","かしつ"],["の"],["よう"],["な"],["もの"],["で"],["ある"],["。"]]},{"verse":6,"text":"愚か者が非常に高い位につけられ、富む者が低い席に着けられている。","tok":[["愚か者","おろかもの"],["が"],["非常","ひじょう"],["に"],["高い","たかい"],["位","くらい"],["に"],["つけられ"],["、"],["富む","とむ"],["者","もの"],["が"],["低い","ひくい"],["席","せき"],["に"],["着けられて","つけられて"],["いる"],["。"]]},{"verse":7,"text":"私は奴隷たちが馬に乗り、君主たちが奴隷のように地を歩くのを見た。","tok":[["私","わたくし"],["は"],["奴隷","どれい"],["たち"],["が"],["馬","うま"],["に"],["乗り","のり"],["、"],["君主","くんしゅ"],["たち"],["が"],["奴隷","どれい"],["の"],["よう"],["に"],["地","ち"],["を"],["歩く","あるく"],["の"],[
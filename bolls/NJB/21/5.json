[{"verse":1,"text":"神の宮へ行くときは、自分の足に気をつけよ。近寄って聞くことは、愚かな者がいけにえをささげるのにまさる。彼らは自分たちが悪を行っていることを知らないからだ。","tok":[["神","かみ"],["の"],["宮","みや"],["へ"],["行く","いく"],["とき"],["は"],["、"],["自分","じぶん"],["の"],["足","あし"],["に"],["気","き"],["を"],["つけよ"],["。"],["近寄って","ちかよって"],["聞く","きく"],["こと"],["は"],["、"],["愚か","おろか"],["な"],["者","もの"],["が"],["いけにえ"],["を"],["ささげる"],["のに"],["まさる"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["が"],["悪","あく"],["を"],["行って","おこなって"],["いる"],["こと"],["を"],["知らない","しらない"],["から"],["だ"],["。"]]},{"verse":2,"text":"神の前では、軽々しく、心あせってことばを出すな。神は天におられ、あなたは地にいるからだ。だから、ことばを少なくせよ。","tok":[["神","かみ"],["の"],["前","まえ"],["で"],["は"],["、"],["軽々しく","かるがるしく"],["、"],["心","こころ"],["あせって"],["ことば"],["を"],["出す","だす"],["な"],["。"],["神","かみ"],["は"],["天","てん"],["に"],["おられ"],["、"],["あなた"],["は"],["地","ち"],["に"],["いる"],["から"],["だ"],["。"],["だ"],["から"],["、"],["ことば"],["を"],["少なく","すくなく"],["せよ"],["。"]]},{"verse":3,"text":"仕事が多いと夢を見る。／ことばが多いと愚かな者の声となる。","tok":[["仕事","しごと"],["が"],["多い","おおい"],["と"],["夢","ゆめ"],["を"],["見る","みる"],["。"],["／"],["ことば"],["が"],["多い","おおい"],["と"],["愚か","おろか"],["な"],["者","もの"],["の"],["声","こえ"],["と"],["なる"],["。"]]},{"verse":4,"text":"神に誓願を立てるときには、それを果たすのを遅らせてはならない。神は愚かな者を喜ばないからだ。誓ったことは果たせ。","tok":[["神","かみ"],["に"],["誓願","せいがん"],["を"],["立てる","たてる"],["とき"],["に"],["は"],["、"],["それ"],["を"],["果たす","はたす"],["の"],["を"],["遅らせて","おくらせて"],["は"],["ならない"],["。"],["神","かみ"],["は"],["愚か","おろか"],["な"],["者","もの"],["を"],["喜ばない","よろこばない"],["から"],["だ"],["。"],["誓った","ちかった"],["こと"],["は"],["果たせ","はたせ"],["。"]]},{"verse":5,"text":"誓って果たさないよりは、誓わないほうがよい。","tok":[["誓って","ちかって"],["果たさない","はたさない"],["より"],["は"],["、"],["誓わない","ちかわない"],["ほう"],["が"],["よい"],["。"]]},{"verse":6,"text":"あなたの口が、あなたに罪を犯させないようにせよ。使者の前で「あれは過失だ」と言ってはならない。神が、あなたの言うことを聞いて怒り、あなたの手のわざを滅ぼしてもよいだろうか。","tok":[["あなた"],["の"],["口","くち"],["が"],["、"],["あなた"],["に"],["罪","つみ"],["を"],["犯させない","おかさせない"],["よう"],["に"],["せよ"],["。"],["使者","ししゃ"],["の"],["前","まえ"],["で"],["「"],["あれ"],["は"],["過失","かしつ"],["だ"],["」"],["と"],["言って","いって"],["は"],["ならない"],["。"],["神","かみ"],["が"],["、"],["あなた"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["怒り","おこり"],["、"],["あなた"],["の"],["手","て"],["の"],["わざ"],["を"],["滅ぼして","ほろぼして"],["も"],["よいだろう"],["か"],["。"]]},{"verse":7,"text":"夢が多くなると、むなしいことばも多くなる。／ただ、神を恐れよ。","tok":[["夢","ゆめ"],["が"],["多く","おおく"],["なる"],["と"],["、"],["むなしい"],["ことば"],["も"],["多く","おおく"],["なる"],["。"],["／"],["ただ"],["、"],["神","かみ"],["を"],["恐れよ","おそれよ"],["。"]]},{"verse":8,"text":"ある州で、貧しい者がしいたげられ、権利と正義がかすめられるのを見ても、そのことに驚いてはならない。その上役には、それを見張るもうひとりの上役がおり、彼らよりももっと高い者たちもいる。","tok":[["ある"],["州","しゅう"],["で"],["、"],["貧しい","まずしい"],["者","もの"],["が"],["しいたげられ"],["、"],["権利","けんり"],["と"],["正義","まさよし"],["が"],["かすめられる"],["の"],["を"],["見て","みて"],["も"],["、"],["その"],["こと"],["に"],["驚いて","おどろいて"],["は"],["ならない"],["。"],["その"],["上役","うわやく"],["に"],["は"],["、"],["それ"],["を"],["見張る","みはる"],["もう"],["ひとり"],["の"],["上役","うわやく"],["が"],["おり"],["、"],["彼","かれ"],["ら"],["より"],["も"],["もっと"],["高い","たかい"],["者","もの"],["たち"],["も"],["いる"],["。"]]},{"verse":9,"text":"何にもまして、国の利益は農地を耕させる王である。","tok":[["何に","なんに"],["も"],["まして"],["、"],["国","くに"],["の"],["利益","りえき"],["は"],["農地","のうち"],["を"],["耕させる","たがやさせる"],["王","おう"],["で"],["ある"],["。"]]},{"verse":10,"text":"金銭を愛する者は金銭に満足しない。富を愛する者は収益に満足しない。これもまた、むなしい。","tok":[["金銭","きんせん"],["を"],["愛する","あいする"],["者","もの"],["は"],["金銭","きんせん"],["に"],["満足","まんぞく"],["しない"],["。"],["富","とみ"],["を"],["愛する","あいする"],["者","もの"],["は"],["収益","しゅうえき"],["に"],["満足","まんぞく"],["しない"],["。"],["これ"],["も"],["また"],["、"],["むなしい"],["。"]]},{"verse":11,"text":"財産がふえると、寄食者もふえる。持ち主にとって何の益になろう。彼はそれを目で見るだけだ。","tok":[["財産","ざいさん"],["が"],["ふえる"],["と"],["、"],["寄食者","きしょくしゃ"],["も"],["ふえる"],["。"],["持ち主","もちぬし"],["にとって"],["何","なん"],["の"],["益","えき"],["に"],["なろう"],["。"],["彼","かれ"],["は"],["それ"],["を"],["目","め"],["で"],["見る","みる"],["だけ"],["だ"],["。"]]},{"verse":12,"text":"働く者は、少し食べても多く食べても、ここちよく眠る。富む者は、満腹しても、安眠をとどめられる。","tok":[["働く","はたらく"],["者","もの"],["は"],["、"],["少し","すこし"],["食べて","たべて"],["も"],["多く","おおく"],["食べて","たべて"],["も"],["、"],["ここちよく"],["眠る","ねむる"],["。"],["富む","とむ"],["者","もの"],["は"],["、"],["満腹","まんぷく"],["して"],["も"],["、"],["安眠","あんみん"],["を"],["とどめられる"],["。"]]},{"verse":13,"text":"私は日の下に、痛ましいことがあるのを見た。所有者に守られている富が、その人に害を加えることだ。","tok":[["私","わたくし"],["は"],["日","ひ"],["の"],["下","した"],["に"],["、"],["痛ましい","いたましい"],["こと"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"],["所有者","しょゆうしゃ"],["に"],["守られて","まもられて"],["いる"],["富","とみ"],["が"],["、"],["その"],["人","ひと"],["に"],["害","がい"],["を"],["加える","くわえる"],["こと"],["だ"],["。"]]},{"verse":14,"text":"その富は不幸な出来事で失われ、子どもが生まれても、自分の手もとには何もない。","tok":[["その"],["富","とみ"],["は"],["不幸","ふこう"],["な"],["出来事","できごと"],["で"],["失われ","うしなわれ"],["、"],["子ども","こども"],["が"],["生まれて","うまれて"],["も"],["、"],["自分","じぶん"],["の"],["手もと","てもと"],["に"],["は"],["何","なん"],["も"],["ない"],["。"]]},{"verse":15,"text":"母の胎から出て来たときのように、また裸でもとの所に帰る。彼は、自分の労苦によって得たものを、何一つ手に携えて行くことができない。","tok":[["母","はは"],["の"],["胎","はら"],["から"],["出て","でて"],["来た","きた"],["とき"],["の"],["よう"],["に"],["、"],["また"],["裸","はだか"],["で"],["もと"],["の"],["所","ところ"],["に"],["帰る","かえる"],["。"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["の"],["労苦","ろうく"],["によって"],["得た","えた"],["もの"],["を"],["、"],["何","なん"],["一","ひと"],["つ"],["手","て"],["に"],["携えて","たずさえて"],["行く","いく"],["こと"],["が"],["できない"],["。"]]},{"verse":16,"text":"これも痛ましいことだ。出て来たときと全く同じようにして去って行く。風のために労苦して何の益があるだろう。","tok":[["これ"],["も"],["痛ましい","いたましい"],["こと"],["だ"],["。"],["出て","でて"],["来た","きた"],["とき"],["と"],["全く","まったく"],["同じ","おなじ"],["よう"],["に"],["して"],["去って","さって"],["行く","いく"],["。"],["風","かぜ"],["の"],["ため"],["に"],["労苦","ろうく"],["して"],["何","なん"],["の"],["益","えき"],["が"],["あるだろう"],["。"]]},{"verse":17,"text":"しかも、人は一生、やみの中で食事をする。多くの苦痛、病気、そして怒り。","tok":[["しかも"],["、"],["人","ひと"],["は"],["一生","いっしょう"],["、"],["やみ"],["の"],["中","なか"],["で"],["食事","しょくじ"],["を"],["する"],["。"],["多く","おおく"],["の"],["苦痛","くつう"],["、"],["病気","びょうき"],["、"],["そして"],["怒り","いかり"],["。"]]},{"verse":18,"text":"見よ。私がよいと見たこと、好ましいことは、神がその人に許されるいのちの日数の間、日の下で骨折るすべての労苦のうちに、しあわせを見つけて、食べたり飲んだりすることだ。これが人の受ける分なのだ。","tok":[["見","み"],["よ"],["。"],["私","わたくし"],["が"],["よい"],["と"],["見た","みた"],["こと"],["、"],["好ましい","このましい"],["こと"],["は"],["、"],["神","かみ"],["が"],["その"],["人","ひと"],["に"],["許される","ゆるされる"],["いのち"],["の"],["日数","にっすう"],["の"],["間","あいだ"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["骨折る","ほねおる"],["すべて"],["の"],["労苦","ろうく"],["の"],["うち"],["に"],["、"],["しあわせ"],["を"],["見つけて","みつけて"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["する"],["こと"],["だ"],["。"],["これ"],["が"],["人","ひと"],["の"],["受ける","うける"],["分","ぶん"],["な"],["の"],["だ"],["。"]]},{"verse":19,"text":"実に神はすべての人間に富と財宝を与え、これを楽しむことを許し、自分の受ける分を受け、自分の労苦を喜ぶようにされた。これこそが神の賜物である。","tok":[["実","じつ"],["に"],["神","かみ"],["は"],["すべて"],["の"],["人間","にんげん"],["に"],["富","とみ"],["と"],["財宝","ざいほう"],["を"],["与え","あたえ"],["、"],["これ"],["を"],["楽しむ","たのしむ"],["こと"],["を"],["許し","ゆるし"],["、"],["自分","じぶん"],["の"],["受ける","うける"],["分","ぶん"],["を"],["受け","うけ"],["、"],["自分","じぶん"],["の"],["労苦","ろうく"],["を"],["喜ぶ","よろこぶ"],["よう"],["に"],["された"],["。"],["これ"],["こそ"],["が"],["神","かみ"],["の"],["賜物","たまもの"],["で"],["ある"],["。"]]},{"verse":20,"text":"こういう人は、自分の生涯のことをくよくよ思わない。神が彼の心を喜びで満たされるからだ。","tok":[["こう"],["いう"],["人","ひと"],["は"],["、"],["自分","じぶん"],["の"],["生涯","しょうがい"],["の"],["こと"],["を"],["くよくよ"],["思わない","おもわない"],["。"],["神","かみ"],["が"],["彼","かれ"],["の"],["心","こころ"],["を"],["喜び","よろこび"],["で"],["満たされる","みたされる"],["から"],["だ"],["。"]]}]
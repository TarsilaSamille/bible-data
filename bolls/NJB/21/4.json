[{"verse":1,"text":"私は再び、日の下で行われるいっさいのしいたげを見た。見よ、しいたげられている者の涙を。彼らには慰める者がいない。しいたげる者が権力をふるう。しかし、彼らには慰める者がいない。","tok":[["私","わたくし"],["は"],["再び","ふたたび"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["行われる","おこなわれる"],["いっさい"],["の"],["しいたげ"],["を"],["見た","みた"],["。"],["見よ","みよ"],["、"],["しいたげられて"],["いる"],["者","もの"],["の"],["涙","なみだ"],["を"],["。"],["彼","かれ"],["ら"],["に"],["は"],["慰める","なぐさめる"],["者","もの"],["が"],["いない"],["。"],["しいたげる"],["者","もの"],["が"],["権力","けんりょく"],["を"],["ふるう"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["に"],["は"],["慰める","なぐさめる"],["者","もの"],["が"],["いない"],["。"]]},{"verse":2,"text":"私は、まだいのちがあって生きながらえている人よりは、すでに死んだ死人のほうに祝いを申し述べる。","tok":[["私","わたくし"],["は"],["、"],["まだ"],["いのち"],["が"],["あって"],["生きながらえて","いきながらえて"],["いる"],["人","ひと"],["より"],["は"],["、"],["すでに"],["死んだ","しんだ"],["死人","しにん"],["の"],["ほう"],["に"],["祝い","いわい"],["を"],["申し述べる","もうしのべる"],["。"]]},{"verse":3,"text":"また、この両者よりもっと良いのは、今までに存在しなかった者、日の下で行われる悪いわざを見なかった者だ。","tok":[["また"],["、"],["この"],["両者","りょうしゃ"],["より"],["もっと"],["良い","よい"],["の"],["は"],["、"],["今まで","いままで"],["に"],["存在","そんざい"],["しなかった"],["者","もの"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["行われる","おこなわれる"],["悪い","わるい"],["わざ"],["を"],["見なかった","みなかった"],["者","もの"],["だ"],["。"]]},{"verse":4,"text":"私はまた、あらゆる労苦とあらゆる仕事の成功を見た。それは人間同士のねたみにすぎない。これもまた、むなしく、風を追うようなものだ。","tok":[["私","わたくし"],["は"],["また"],["、"],["あらゆる"],["労苦","ろうく"],["と"],["あらゆる"],["仕事","しごと"],["の"],["成功","せいこう"],["を"],["見た","みた"],["。"],["それ"],["は"],["人間同士","にんげんどうし"],["の"],["ねたみ"],["に"],["すぎない"],["。"],["これ"],["も"],["また"],["、"],["むなしく"],["、"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":5,"text":"愚かな者は、手をこまねいて、自分の肉を食べる。","tok":[["愚か","おろか"],["な"],["者","もの"],["は"],["、"],["手","て"],["を"],["こまねいて"],["、"],["自分","じぶん"],["の"],["肉","にく"],["を"],["食べる","たべる"],["。"]]},{"verse":6,"text":"片手に安楽を満たすことは、両手に労苦を満たして風を追うのにまさる。","tok":[["片手","かたて"],["に"],["安楽","あんらく"],["を"],["満たす","みたす"],["こと"],["は"],["、"],["両手","りょうて"],["に"],["労苦","ろうく"],["を"],["満たして","みたして"],["風","かぜ"],["を"],["追う","おう"],["のに"],["まさる"],["。"]]},{"verse":7,"text":"私は再び、日の下にむなしさのあるのを見た。","tok":[["私","わたくし"],["は"],["再び","ふたたび"],["、"],["日","ひ"],["の"],["下","した"],["に"],["むなし"],["さ"],["の"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse":8,"text":"ひとりぼっちで、仲間もなく、子も兄弟もない人がいる。それでも彼のいっさいの労苦には終わりがなく、彼の目は富を求めて飽き足りることがない。そして、「私はだれのために労苦し、楽しみもなくて自分を犠牲にしているのか」とも言わない。これもまた、むなしく、つらい仕事だ。","tok":[["ひとりぼっち"],["で"],["、"],["仲間","なかま"],["も"],["なく"],["、"],["子","こ"],["も"],["兄弟","きょうだい"],["も"],["ない"],["人","ひと"],["が"],["いる"],["。"],["それ"],["で"],["も"],["彼","かれ"],["の"],["いっさい"],["の"],["労苦","ろうく"],["に"],["は"],["終わり","おわり"],["が"],["なく"],["、"],["彼","かれ"],["の"],["目","め"],["は"],["富","とみ"],["を"],["求めて","もとめて"],["飽き足りる","あきたりる"],["こと"],["が"],["ない"],["。"],["そして"],["、"],["「"],["私","わたくし"],["は"],["だれ"],["の"],["ため"],["に"],["労苦","ろうく"],["し"],["、"],["楽しみ","たのしみ"],["も"],["なくて"],["自分","じぶん"],["を"],["犠牲","ぎせい"],["に"],["して"],["いる"],["の"],["か"],["」"],["と"],["も"],["言わない","いわない"],["。"],["これ"],["も"],["また"],["、"],["むなしく"],["、"],["つらい"],["仕事","しごと"],["だ"],["。"]]},{"verse":9,"text":"ふたりはひとりよりもまさっている。ふたりが労苦すれば、良い報いがあるからだ。","tok":[["ふたり"],["は"],["ひとり"],["より"],["も"],["まさって"],["いる"],["。"],["ふたり"],["が"],["労苦","ろうく"],["すれば"],["、"],["良い","よい"],["報い","むくい"],["が"],["ある"],["から"],["だ"],["。"]]},{"verse":10,"text":"どちらかが倒れるとき、ひとりがその仲間を起こす。倒れても起こす者のいないひとりぼっちの人はかわいそうだ。","tok":[["どちら"],["か"],["が"],["倒れる","たおれる"],["とき"],["、"],["ひとり"],["が"],["その"],["仲間","なかま"],["を"],["起こす","おこす"],["。"],["倒れて","たおれて"],["も"],["起こす","おこす"],["者","もの"],["の"],["いない"],["ひとりぼっち"],["の"],["人","ひと"],["は"],["かわいそう"],["だ"],["。"]]},{"verse":11,"text":"また、ふたりがいっしょに寝ると暖かいが、ひとりでは、どうして暖かくなろう。","tok":[["また"],["、"],["ふたり"],["が"],["いっしょ"],["に"],["寝る","ねる"],["と"],["暖かい","あたたかい"],["が"],["、"],["ひとり"],["で"],["は"],["、"],["どう"],["して"],["暖かく","あたたかく"],["なろう"],["。"]]},{"verse":12,"text":"もしひとりなら、打ち負かされても、ふたりなら立ち向かえる。三つ撚りの糸は簡単には切れない。","tok":[["もし"],["ひとり"],["なら"],["、"],["打ち負かされて","うちまかされて"],["も"],["、"],["ふたり"],["なら"],["立ち向かえる","たちむかえる"],["。"],["三","みっ"],["つ"],["撚り","より"],["の"],["糸","いと"],["は"],["簡単","かんたん"],["に"],["は"],["切れない","きれない"],["。"]]},{"verse":13,"text":"貧しくても知恵のある若者は、もう忠言を受けつけない年とった愚かな王にまさる。","tok":[["貧しくて","まずしくて"],["も"],["知恵","ちえ"],["の"],["ある"],["若者","わかもの"],["は"],["、"],["もう"],["忠言","ちゅうげん"],["を"],["受けつけない","うけつけない"],["年","とし"],["とった"],["愚か","おろか"],["な"],["王","おう"],["に"],["まさる"],["。"]]},{"verse":14,"text":"たとい、彼が牢獄から出て来て王になったにしても、たとい、彼が王国で貧しく生まれた者であったにしても。","tok":[["たとい"],["、"],["彼","かれ"],["が"],["牢獄","ろうごく"],["から"],["出て","でて"],["来て","きて"],["王","おう"],["に"],["なった"],["に"],["して"],["も"],["、"],["たとい"],["、"],["彼","かれ"],["が"],["王国","おうこく"],["で"],["貧しく","まずしく"],["生まれた","うまれた"],["者","もの"],["で"],["あった"],["に"],["して"],["も"],["。"]]},{"verse":15,"text":"私は、日の下に生息するすべての生きものが、王に代わって立つ後継の若者の側につくのを見た。","tok":[["私","わたくし"],["は"],["、"],["日","ひ"],["の"],["下","した"],["に"],["生息","せいそく"],["する"],["すべて"],["の"],["生きもの","いきもの"],["が"],["、"],["王","おう"],["に"],["代わって","かわって"],["立つ","たつ"],["後継","こうけい"],["の"],["若者","わかもの"],["の"],["側","がわ"],["に"],["つく"],["の"],["を"],["見た","みた"],["。"]]},{"verse":16,"text":"すべての民には果てしがない。彼が今あるすべての民の先頭に立っても、これから後の者たちは、彼を喜ばないであろう。これもまた、むなしく、風を追うようなものだ。","tok":[["すべて"],["の"],["民","たみ"],["に"],["は"],["果てし","はてし"],["が"],["ない"],["。"],["彼","かれ"],["が"],["今","いま"],["ある"],["すべて"],["の"],["民","たみ"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["も"],["、"],["これ"],["から"],["後","あと"],["の"],["者","もの"],["たち"],["は"],["、"],["彼","かれ"],["を"],["喜ばないで","よろこばないで"],["あろう"],["。"],["これ"],["も"],["また"],["、"],["むなしく"],["、"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["もの"],["だ"],["。"]]}]
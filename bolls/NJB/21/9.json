[{"verse":1,"text":"というのは、私はこのいっさいを心に留め、正しい人も、知恵のある者も、彼らの働きも、神の御手の中にあることを確かめたからである。彼らの前にあるすべてのものが愛であるか、憎しみであるか、人にはわからない。","tok":[["と"],["いう"],["の"],["は"],["、"],["私","わたくし"],["は"],["この"],["いっさい"],["を"],["心","こころ"],["に"],["留め","とめ"],["、"],["正しい","ただしい"],["人","ひと"],["も"],["、"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["も"],["、"],["彼","かれ"],["ら"],["の"],["働き","はたらき"],["も"],["、"],["神","かみ"],["の"],["御手","おて"],["の"],["中","なか"],["に"],["ある"],["こと"],["を"],["確かめた","たしかめた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["ある"],["すべて"],["の"],["もの"],["が"],["愛","あい"],["で"],["ある"],["か"],["、"],["憎しみ","にくしみ"],["で"],["ある"],["か"],["、"],["人","ひと"],["に"],["は"],["わからない"],["。"]]},{"verse":2,"text":"すべての事はすべての人に同じように起こる。同じ結末が、正しい人にも、悪者にも、善人にも、きよい人にも、汚れた人にも、いけにえをささげる人にも、いけにえをささげない人にも来る。善人にも、罪人にも同様である。誓う者にも、誓うのを恐れる者にも同様である。","tok":[["すべて"],["の"],["事","こと"],["は"],["すべて"],["の"],["人","ひと"],["に"],["同じ","おなじ"],["よう"],["に"],["起こる","おこる"],["。"],["同じ","おなじ"],["結末","けつまつ"],["が"],["、"],["正しい","ただしい"],["人","ひと"],["に"],["も"],["、"],["悪者","わるもの"],["に"],["も"],["、"],["善人","ぜんにん"],["に"],["も"],["、"],["きよい"],["人","ひと"],["に"],["も"],["、"],["汚れた","よごれた"],["人","ひと"],["に"],["も"],["、"],["いけにえ"],["を"],["ささげる"],["人","ひと"],["に"],["も"],["、"],["いけにえ"],["を"],["ささげない"],["人","ひと"],["に"],["も"],["来る","くる"],["。"],["善人","ぜんにん"],["に"],["も"],["、"],["罪人","ざいにん"],["に"],["も"],["同様","どうよう"],["で"],["ある"],["。"],["誓う","ちかう"],["者","もの"],["に"],["も"],["、"],["誓う","ちかう"],["の"],["を"],["恐れる","おそれる"],["者","もの"],["に"],["も"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":3,"text":"同じ結末がすべての人に来るということ、これは日の下で行われるすべての事のうちで最も悪い。だから、人の子らの心は悪に満ち、生きている間、その心には狂気が満ち、それから後、死人のところに行く。","tok":[["同じ","おなじ"],["結末","けつまつ"],["が"],["すべて"],["の"],["人","ひと"],["に"],["来る","くる"],["と"],["いう"],["こと"],["、"],["これ"],["は"],["日","ひ"],["の"],["下","もと"],["で"],["行われる","おこなわれる"],["すべて"],["の"],["事","こと"],["の"],["うち"],["で"],["最も","もっとも"],["悪い","わるい"],["。"],["だ"],["から"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["心","こころ"],["は"],["悪","わる"],["に"],["満ち","みち"],["、"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["その"],["心","こころ"],["に"],["は"],["狂気","きょうき"],["が"],["満ち","みち"],["、"],["それ"],["から"],["後","あと"],["、"],["死人","しにん"],["の"],["ところ"],["に"],["行く","いく"],["。"]]},{"verse":4,"text":"すべて生きている者に連なっている者には希望がある。生きている犬は死んだ獅子にまさるからである。","tok":[["すべて"],["生きて","いきて"],["いる"],["者","もの"],["に"],["連なって","つらなって"],["いる"],["者","もの"],["に"],["は"],["希望","きぼう"],["が"],["ある"],["。"],["生きて","いきて"],["いる"],["犬","いぬ"],["は"],["死んだ","しんだ"],["獅子","しし"],["に"],["まさる"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"生きている者は自分が死ぬことを知っているが、死んだ者は何も知らない。彼らにはもはや何の報いもなく、彼らの呼び名も忘れられる。","tok":[["生きて","いきて"],["いる"],["者","もの"],["は"],["自分","じぶん"],["が"],["死ぬ","しぬ"],["こと"],["を"],["知って","しって"],["いる"],["が"],["、"],["死んだ","しんだ"],["者","もの"],["は"],["何","なん"],["も"],["知らない","しらない"],["。"],["彼","かれ"],["ら"],["に"],["は"],["もはや"],["何","なん"],["の"],["報い","むくい"],["も"],["なく"],["、"],["彼","かれ"],["ら"],["の"],["呼び名","よびな"],["も"],["忘れられる","わすれられる"],["。"]]},{"verse":6,"text":"彼らの愛も憎しみも、ねたみもすでに消えうせ、日の下で行われるすべての事において、彼らには、もはや永遠に受ける分はない。","tok":[["彼","かれ"],["ら"],["の"],["愛","あい"],["も"],["憎しみ","にくしみ"],["も"],["、"],["ねたみ"],["も"],["すでに"],["消えうせ","きえうせ"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["行われる","おこなわれる"],["すべて"],["の"],["事","こと"],["に"],["おいて"],["、"],["彼","かれ"],["ら"],["に"],["は"],["、"],["もはや"],["永遠","えいえん"],["に"],["受ける","うける"],["分","ぶん"],["は"],["ない"],["。"]]},{"verse":7,"text":"さあ、喜んであなたのパンを食べ、愉快にあなたのぶどう酒を飲め。／神はすでにあなたの行いを喜んでおられる。","tok":[["さあ"],["、"],["喜んで","よろこんで"],["あなた"],["の"],["パン"],["を"],["食べ","たべ"],["、"],["愉快","ゆかい"],["に"],["あなた"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["飲め","のめ"],["。"],["／"],["神","かみ"],["は"],["すでに"],["あなた"],["の"],["行い","おこない"],["を"],["喜んで","よろこんで"],["おられる"],["。"]]},{"verse":8,"text":"いつもあなたは白い着物を着、頭には油を絶やしてはならない。","tok":[["いつも"],["あなた"],["は"],["白い","しろい"],["着物","きもの"],["を"],["着","き"],["、"],["頭","あたま"],["に"],["は"],["油","あぶら"],["を"],["絶やして","たやして"],["は"],["ならない"],["。"]]},{"verse":9,"text":"日の下であなたに与えられたむなしい一生の間に、あなたの愛する妻と生活を楽しむがよい。それが、生きている間に、日の下であなたがする労苦によるあなたの受ける分である。","tok":[["日","ひ"],["の"],["下","もと"],["で"],["あなた"],["に"],["与えられた","あたえられた"],["むなしい"],["一生","いっしょう"],["の"],["間","あいだ"],["に"],["、"],["あなた"],["の"],["愛する","あいする"],["妻","つま"],["と"],["生活","せいかつ"],["を"],["楽しむ","たのしむ"],["が"],["よい"],["。"],["それ"],["が"],["、"],["生きて","いきて"],["いる"],["間","あいだ"],["に"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["あなた"],["が"],["する"],["労苦","ろうく"],["に"],["よる"],["あなた"],["の"],["受ける","うける"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたの手もとにあるなすべきことはみな、自分の力でしなさい。あなたが行こうとしているよみには、働きも企ても知識も知恵もないからだ。","tok":[["あなた"],["の"],["手もと","てもと"],["に"],["ある"],["なすべき"],["こと"],["は"],["みな"],["、"],["自分","じぶん"],["の"],["力","ちから"],["で"],["し"],["なさい"],["。"],["あなた"],["が"],["行こう","いこう"],["として"],["いる"],["よ"],["み"],["に"],["は"],["、"],["働き","はたらき"],["も"],["企て","くわだて"],["も"],["知識","ちしき"],["も"],["知恵","ちえ"],["も"],["ない"],["から"],["だ"],["。"]]},{"verse":11,"text":"私は再び、日の下を見たが、競走は足の早い人のものではなく、戦いは勇士のものではなく、またパンは知恵ある人のものではなく、また富は悟りのある人のものではなく、愛顧は知識のある人のものではないことがわかった。すべての人が時と機会に出会うからだ。","tok":[["私","わたくし"],["は"],["再び","ふたたび"],["、"],["日","ひ"],["の"],["下","した"],["を"],["見た","みた"],["が"],["、"],["競走","きょうそう"],["は"],["足","あし"],["の"],["早い","はやい"],["人","ひと"],["の"],["もの"],["で"],["は"],["なく"],["、"],["戦い","たたかい"],["は"],["勇士","ゆうし"],["の"],["もの"],["で"],["は"],["なく"],["、"],["また"],["パン"],["は"],["知恵","ちえ"],["ある"],["人","ひと"],["の"],["もの"],["で"],["は"],["なく"],["、"],["また"],["富","とみ"],["は"],["悟り","さとり"],["の"],["ある"],["人","ひと"],["の"],["もの"],["で"],["は"],["なく"],["、"],["愛顧","あいこ"],["は"],["知識","ちしき"],["の"],["ある"],["人","ひと"],["の"],["もの"],["で"],["は"],["ない"],["こと"],["が"],["わかった"],["。"],["すべて"],["の"],["人","ひと"],["が"],["時","とき"],["と"],["機会","きかい"],["に"],["出会う","であう"],["から"],["だ"],["。"]]},{"verse":12,"text":"しかも、人は自分の時を知らない。悪い網にかかった魚のように、わなにかかった鳥のように、人の子らもまた、わざわいの時が突然彼らを襲うと、それにかかってしまう。","tok":[["しかも"],["、"],["人","ひと"],["は"],["自分","じぶん"],["の"],["時","とき"],["を"],["知らない","しらない"],["。"],["悪い","わるい"],["網","あみ"],["に"],["かかった"],["魚","さかな"],["の"],["よう"],["に"],["、"],["わな"],["に"],["かかった"],["鳥","とり"],["の"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["も"],["また"],["、"],["わざわい"],["の"],["時","とき"],["が"],["突然","とつぜん"],["彼","かれ"],["ら"],["を"],["襲う","おそう"],["と"],["、"],["それ"],["に"],["かかって"],["しまう"],["。"]]},{"verse":13,"text":"私はまた、日の下で知恵についてこのようなことを見た。それは私にとって大きなことであった。","tok":[["私","わたくし"],["は"],["また"],["、"],["日","ひ"],["の"],["下","もと"],["で"],["知恵","ちえ"],["について"],["この"],["よう"],["な"],["こと"],["を"],["見た","みた"],["。"],["それ"],["は"],["私","わたくし"],["にとって"],["大きな","おおきな"],["こと"],["で"],["あった"],["。"]]},{"verse":14,"text":"わずかな人々が住む小さな町があった。そこに大王が攻めて来て、これを包囲し、これに対して大きなとりでを築いた。","tok":[["わずか"],["な"],["人々","ひとびと"],["が"],["住む","すむ"],["小さな","ちいさな"],["町","まち"],["が"],["あった"],["。"],["そこ"],["に"],["大王","だいおう"],["が"],["攻めて","せめて"],["来て","きて"],["、"],["これ"],["を"],["包囲","ほうい"],["し"],["、"],["これ"],["に対して","にたいして"],["大きな","おおきな"],["とりで"],["を"],["築いた","きずいた"],["。"]]},{"verse":15,"text":"ところが、その町に、貧しいひとりの知恵ある者がいて、自分の知恵を用いてその町を解放した。しかし、だれもこの貧しい人を記憶しなかった。","tok":[["ところ"],["が"],["、"],["その"],["町","まち"],["に"],["、"],["貧しい","まずしい"],["ひとり"],["の"],["知恵","ちえ"],["ある"],["者","もの"],["が"],["いて"],["、"],["自分","じぶん"],["の"],["知恵","ちえ"],["を"],["用いて","もちいて"],["その"],["町","まち"],["を"],["解放","かいほう"],["した"],["。"],["しかし"],["、"],["だれ"],["も"],["この"],["貧しい","まずしい"],["人","ひと"],["を"],["記憶","きおく"],["しなかった"],["。"]]},{"verse":16,"text":"私は言う。「知恵は力にまさる。しかし貧しい者の知恵はさげすまれ、彼の言うことも聞かれない。」","tok":[["私","わたくし"],["は"],["言う","ゆう"],["。"],["「"],["知恵","ちえ"],["は"],["力","ちから"],["に"],["まさる"],["。"],["しかし"],["貧しい","まずしい"],["者","もの"],["の"],["知恵","ちえ"],["は"],["さげすまれ"],["、"],["彼","かれ"],["の"],["言う","いう"],["こと"],["も"],["聞かれない","きかれない"],["。"],["」"]]},{"verse":17,"text":"知恵ある者の静かなことばは、愚かな者の間の支配者の叫びよりは、よく聞かれる。","tok":[["知恵","ちえ"],["ある"],["者","もの"],["の"],["静か","しずか"],["な"],["ことば"],["は"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["間","あいだ"],["の"],["支配者","しはいしゃ"],["の"],["叫び","さけび"],["より"],["は"],["、"],["よく"],["聞かれる","きかれる"],["。"]]},{"verse":18,"text":"知恵は武器にまさり、ひとりの罪人は多くの良いことを打ちこわす。","tok":[["知恵","ちえ"],["は"],["武器","ぶき"],["に"],["まさり"],["、"],["ひとり"],["の"],["罪人","ざいにん"],["は"],["多く","おおく"],["の"],["良い","よい"],["こと"],["を"],["打ちこわす","うちこわす"],
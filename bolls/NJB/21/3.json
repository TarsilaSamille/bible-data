[{"verse":1,"text":"天の下では、何事にも定まった時期があり、すべての営みには時がある。","tok":[["天","てん"],["の"],["下","もと"],["で"],["は"],["、"],["何事","なにごと"],["に"],["も"],["定まった","さだまった"],["時期","じき"],["が"],["あり"],["、"],["すべて"],["の"],["営み","いとなみ"],["に"],["は"],["時","とき"],["が"],["ある"],["。"]]},{"verse":2,"text":"生まれるのに時があり、死ぬのに時がある。／植えるのに時があり、植えた物を引き抜くのに時がある。","tok":[["生まれる","うまれる"],["のに"],["時","とき"],["が"],["あり"],["、"],["死ぬ","しぬ"],["のに"],["時","とき"],["が"],["ある"],["。"],["／"],["植える","うえる"],["のに"],["時","とき"],["が"],["あり"],["、"],["植えた","うえた"],["物","もの"],["を"],["引き抜く","ひきぬく"],["のに"],["時","とき"],["が"],["ある"],["。"]]},{"verse":3,"text":"殺すのに時があり、いやすのに時がある。／くずすのに時があり、建てるのに時がある。","tok":[["殺す","ころす"],["のに"],["時","とき"],["が"],["あり"],["、"],["いやす"],["のに"],["時","とき"],["が"],["ある"],["。"],["／"],["くずす"],["のに"],["時","とき"],["が"],["あり"],["、"],["建てる","たてる"],["のに"],["時","とき"],["が"],["ある"],["。"]]},{"verse":4,"text":"泣くのに時があり、ほほえむのに時がある。／嘆くのに時があり、踊るのに時がある。","tok":[["泣く","なく"],["のに"],["時","とき"],["が"],["あり"],["、"],["ほほえむ"],["のに"],["時","とき"],["が"],["ある"],["。"],["／"],["嘆く","なげく"],["のに"],["時","とき"],["が"],["あり"],["、"],["踊る","おどる"],["のに"],["時","とき"],["が"],["ある"],["。"]]},{"verse":5,"text":"石を投げ捨てるのに時があり、石を集めるのに時がある。／抱擁するのに時があり、抱擁をやめるのに時がある。","tok":[["石","いし"],["を"],["投げ捨てる","なげすてる"],["のに"],["時","とき"],["が"],["あり"],["、"],["石","いし"],["を"],["集める","あつめる"],["のに"],["時","とき"],["が"],["ある"],["。"],["／"],["抱擁","ほうよう"],["する"],["のに"],["時","とき"],["が"],["あり"],["、"],["抱擁","ほうよう"],["を"],["やめる"],["のに"],["時","とき"],["が"],["ある"],["。"]]},{"verse":6,"text":"捜すのに時があり、失うのに時がある。／保つのに時があり、投げ捨てるのに時がある。","tok":[["捜す","さがす"],["のに"],["時","とき"],["が"],["あり"],["、"],["失う","うしなう"],["のに"],["時","とき"],["が"],["ある"],["。"],["／"],["保つ","たもつ"],["のに"],["時","とき"],["が"],["あり"],["、"],["投げ捨てる","なげすてる"],["のに"],["時","とき"],["が"],["ある"],["。"]]},{"verse":7,"text":"引き裂くのに時があり、縫い合わせるのに時がある。／黙っているのに時があり、話をするのに時がある。","tok":[["引き裂く","ひきさく"],["のに"],["時","とき"],["が"],["あり"],["、"],["縫い合わせる","ぬいあわせる"],["のに"],["時","とき"],["が"],["ある"],["。"],["／"],["黙って","だまって"],["いる"],["のに"],["時","とき"],["が"],["あり"],["、"],["話","はなし"],["を"],["する"],["のに"],["時","とき"],["が"],["ある"],["。"]]},{"verse":8,"text":"愛するのに時があり、憎むのに時がある。／戦うのに時があり、和睦するのに時がある。","tok":[["愛する","あいする"],["のに"],["時","とき"],["が"],["あり"],["、"],["憎む","にくむ"],["のに"],["時","とき"],["が"],["ある"],["。"],["／"],["戦う","たたかう"],["のに"],["時","とき"],["が"],["あり"],["、"],["和睦","わぼく"],["する"],["のに"],["時","とき"],["が"],["ある"],["。"]]},{"verse":9,"text":"働く者は労苦して何の益を得よう。","tok":[["働く","はたらく"],["者","もの"],["は"],["労苦","ろうく"],["して"],["何","なん"],["の"],["益","えき"],["を"],["得よう","えよう"],["。"]]},{"verse":10,"text":"私は神が人の子らに与えて労苦させる仕事を見た。","tok":[["私","わたくし"],["は"],["神","かみ"],["が"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["与えて","あたえて"],["労苦","ろうく"],["させる"],["仕事","しごと"],["を"],["見た","みた"],["。"]]},{"verse":11,"text":"神のなさることは、すべて時にかなって美しい。神はまた、人の心に永遠を与えられた。しかし人は、神が行われるみわざを、初めから終わりまで見きわめることができない。","tok":[["神","かみ"],["の"],["なさる"],["こと"],["は"],["、"],["すべて"],["時","とき"],["に"],["かなって"],["美しい","うつくしい"],["。"],["神","かみ"],["は"],["また"],["、"],["人","ひと"],["の"],["心","こころ"],["に"],["永遠","えいえん"],["を"],["与えられた","あたえられた"],["。"],["しかし"],["人","ひと"],["は"],["、"],["神","かみ"],["が"],["行われる","おこなわれる"],["みわざ"],["を"],["、"],["初め","はじめ"],["から"],["終わり","おわり"],["まで"],["見きわめる","みきわめる"],["こと"],["が"],["できない"],["。"]]},{"verse":12,"text":"私は知った。人は生きている間に喜び楽しむほか何も良いことがないのを。","tok":[["私","わたくし"],["は"],["知った","しった"],["。"],["人","ひと"],["は"],["生きて","いきて"],["いる"],["間","あいだ"],["に"],["喜び楽しむ","よろこびたのしむ"],["ほか"],["何","なん"],["も"],["良い","よい"],["こと"],["が"],["ない"],["の"],["を"],["。"]]},{"verse":13,"text":"また、人がみな、食べたり飲んだりし、すべての労苦の中にしあわせを見いだすこともまた神の賜物であることを。","tok":[["また"],["、"],["人","ひと"],["が"],["みな"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["し"],["、"],["すべて"],["の"],["労苦","ろうく"],["の"],["中","なか"],["に"],["しあわせ"],["を"],["見いだす","みいだす"],["こと"],["も"],["また"],["神","かみ"],["の"],["賜物","たまもの"],["で"],["ある"],["こと"],["を"],["。"]]},{"verse":14,"text":"私は知った。神のなさることはみな永遠に変わらないことを。それに何かをつけ加えることも、それから何かを取り去ることもできない。神がこのことをされたのだ。人は神を恐れなければならない。","tok":[["私","わたくし"],["は"],["知った","しった"],["。"],["神","かみ"],["の"],["なさる"],["こと"],["は"],["みな"],["永遠","えいえん
[{"verse":1,"text":"さて、使徒たちやユダヤにいる兄弟たちは、異邦人たちも神のみことばを受け入れた、ということを耳にした。","tok":[["さて"],["、"],["使徒","しと"],["たち"],["や"],["ユダヤ"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["は"],["、"],["異邦人","いほうじん"],["たち"],["も"],["神","かみ"],["のみ"],["ことば"],["を"],["受け入れた","うけいれた"],["、"],["と"],["いう"],["こと"],["を"],["耳","みみ"],["に"],["した"],["。"]]},{"verse":2,"text":"そこで、ペテロがエルサレムに上ったとき、割礼を受けた者たちは、彼を非難して、","tok":[["そこ"],["で"],["、"],["ペテロ"],["が"],["エルサレム"],["に"],["上った","のぼった"],["とき"],["、"],["割礼","かつれい"],["を"],["受けた","うけた"],["者","もの"],["たち"],["は"],["、"],["彼","かれ"],["を"],["非難","ひなん"],["して"],["、"]]},{"verse":3,"text":"「あなたは割礼のない人々のところに行って、彼らといっしょに食事をした」と言った。","tok":[["「"],["あなた"],["は"],["割礼","かつれい"],["の"],["ない"],["人々","ひとびと"],["の"],["ところ"],["に"],["行って","いって"],["、"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["した"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"そこでペテロは口を開いて、事の次第を順序正しく説明して言った。","tok":[["そこ"],["で"],["ペテロ"],["は"],["口","くち"],["を"],["開いて","ひらいて"],["、"],["事","こと"],["の"],["次第","しだい"],["を"],["順序","じゅんじょ"],["正しく","ただしく"],["説明","せつめい"],["して"],["言った","いった"],["。"]]},{"verse":5,"text":"「私がヨッパの町で祈っていると、うっとりと夢ごこちになり、幻を見ました。四隅をつり下げられた大きな敷布のような入れ物が天から降りて来て、私のところに届いたのです。","tok":[["「"],["私","わたくし"],["が"],["ヨッパ"],["の"],["町","まち"],["で"],["祈って","いのって"],["いる"],["と"],["、"],["うっとり"],["と"],["夢","ゆめ"],["ごこち"],["に"],["なり"],["、"],["幻","まぼろし"],["を"],["見ました","みました"],["。"],["四隅","よすみ"],["を"],["つり下げられた","つりさげられた"],["大きな","おおきな"],["敷布","しきふ"],["の"],["よう"],["な"],["入れ物","いれもの"],["が"],["天","てん"],["から"],["降りて","おりて"],["来て","きて"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["届いた","とどいた"],["の"],["です"],["。"]]},{"verse":6,"text":"その中をよく見ると、地の四つ足の獣、野獣、はうもの、空の鳥などが見えました。","tok":[["その"],["中","なか"],["を"],["よく"],["見る","みる"],["と"],["、"],["地","ち"],["の"],["四つ足","よつあし"],["の"],["獣","けもの"],["、"],["野獣","やじゅう"],["、"],["は"],["う"],["もの"],["、"],["空","そら"],["の"],["鳥","とり"],["など"],["が"],["見えました","みえました"],["。"]]},{"verse":7,"text":"そして、『ペテロ。さあ、ほふって食べなさい』と言う声を聞きました。","tok":[["そして"],["、"],["『"],["ペテロ"],["。"],["さあ"],["、"],["ほふって"],["食べ",
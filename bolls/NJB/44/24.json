[{"verse":1,"text":"五日の後、大祭司アナニヤは、数人の長老およびテルトロという弁護士といっしょに下って来て、パウロを総督に訴えた。","tok":[["五日","いつか"],["の"],["後","あと"],["、"],["大","だい"],["祭司","さいし"],["アナニヤ"],["は"],["、"],["数人","すうにん"],["の"],["長老","ちょうろう"],["および"],["テルトロ"],["と"],["いう"],["弁護士","べんごし"],["と"],["いっしょ"],["に"],["下って","くだって"],["来て","きて"],["、"],["パウロ"],["を"],["総督","そうとく"],["に"],["訴えた","うったえた"],["。"]]},{"verse":2,"text":"パウロが呼び出されると、テルトロが訴えを始めてこう言った。「ペリクス閣下。閣下のおかげで、私たちはすばらしい平和を与えられ、また、閣下のご配慮で、この国の改革が進行しておりますが、","tok":[["パウロ"],["が"],["呼び出される","よびだされる"],["と"],["、"],["テルトロ"],["が"],["訴え","うったえ"],["を"],["始めて","はじめて"],["こう"],["言った","いった"],["。"],["「"],["ペリクス"],["閣下","かっか"],["。"],["閣下","かっか"],["の"],["おかげ"],["で"],["、"],["私たち","わたしたち"],["は"],["すばらしい"],["平和","へいわ"],["を"],["与えられ","あたえられ"],["、"],["また"],["、"],["閣下","かっか"],["の"],["ご配慮","ごはいりょ"],["で"],["、"],["この"],["国","くに"],["の"],["改革","かいかく"],["が"],["進行","しんこう"],["して"],["おります"],["が"],["、"]]},{"verse":3,"text":"その事実をあらゆる面において、また至る所で認めて、私たちは心から感謝しております。","tok":[["その"],["事実","じじつ"],["を"],["あらゆる"],["面","めん"],["に"],["おいて"],["、"],["また"],["至る所","いたるところ"],["で"],["認めて","みとめて"],["、"],["私たち","わたしたち"],["は"],["心","こころ"],["から"],["感謝","かんしゃ"],["して"],["おります"],["。"]]},{"verse":4,"text":"さて、あまりご迷惑をおかけしないように、ごく手短に申し上げますから、ご寛容をもってお聞きくださるようお願いいたします。","tok":[["さて"],["、"],["あまり"],["ご迷惑","ごめいわく"],["を"],["おかけ"],["しない"],["よう"],["に"],["、"],["ごく"],["手短","てみじか"],["に"],["申し上げます","もうしあげます"],["から"],["、"],["ご寛容","ごかんよう"],["を"],["もって"],["お聞き","おきき"],["くださる"],["よう"],["お願い","おねがい"],["いたします"],["。"]]},{"verse":5,"text":"この男は、まるでペストのような存在で、世界中のユダヤ人の間に騒ぎを起こしている者であり、ナザレ人という一派の首領でございます。","tok":[["この"],["男","おとこ"],["は"],["、"],["まるで"],["ペスト"],["の"],["よう"],["な"],["存在","そんざい"],["で"],["、"],["世界中","せかいじゅう"],["の"],["ユダヤ人","ゆだやじん"],["の"],["間","あいだ"],["に"],["騒ぎ","さわぎ"],["を"],["起こして","おこして"],["いる"],["者","もの"],["で"],["あり"],["、"],["ナザレ人","なざれにん"],["と"],["いう"],["一派","いっぱ"],["の"],["首領","しゅりょう"],["で"],["ございます"],["。"]]},{"verse":6,"text":"この男は宮さえもけがそうとしましたので、私たちは彼を捕らえました。","tok":[["この"],["男","おとこ"],["は"],["宮","みや"],["さえ"],["も"],["けがそう"],["と"],["しました"],["ので"],["、"],["私たち","わたしたち"],["は"],["彼","かれ"],["を"],["捕らえました","とらえました"],["。"]]},{"verse":7,"text":"後期の異本に、このあと、「そして私たちが自分たちの律法で彼をさばこうとしたところ、7千人隊長ルシヤがやって来て、むりやりに彼を私たちの手から奪い、8彼を訴える者は、あなたの前に来るようにと命じました」という挿入がある。","tok":[["後期","こうき"],["の"],["異本","いほん"],["に"],["、"],["この"],["あと"],["、"],["「"],["そして"],["私たち","わたしたち"],["が"],["自分","じぶん"],["たち"],["の"],["律法","りっぽう"],["で"],["彼","かれ"],["を"],["さばこう"],["と"],["した"],["ところ"],["、"],["7千人","ななせんにん"],["隊長","たいちょう"],["ルシヤ"],["が"],["やって"],["来て","きて"],["、"],["むりやり"],["に"],["彼","かれ"],["を"],["私たち","わたしたち"],["の"],["手","て"],["から"],["奪い","うばい"],["、"],["8"],["彼","かれ"],["を"],["訴える","うったえる"],["者","もの"],["は"],["、"],["あなた"],["の"],["前","まえ"],["に"],["来る","くる"],["よう"],["に"],["と"],["命じました","めいじました"],["」"],["と"],["いう"],["挿入","そうにゅう"],["が"],["ある"],["。"]]},{"verse":8,"text":"閣下ご自身で、これらすべてのことについて彼をお調べくださいますなら、私たちが彼を訴えております事がらを、おわかりになっていただけるはずです。」","tok":[["閣下","かっか"],["ご自身","ごじしん"],["で"],["、"],["これ"],["ら"],["すべて"],["の"],["こと"],["について"],["彼","かれ"],["を"],["お調べ","おしらべ"],["くださいますなら"],["、"],["私たち","わたしたち"],["が"],["彼","かれ"],["を"],["訴えて","うったえて"],["おります"],["事がら","ことがら"],["を"],["、"],["おわかり"],["に"],["なって"],["いただける"],["はず"],["です"],["。"],["」"]]},{"verse":9,"text":"ユダヤ人たちも、この訴えに同調し、全くそのとおりだと言った。","tok":[["ユダヤ人","ゆだやじん"],["たち"],["も"],["、"],["この"],["訴え","うったえ"],["に"],["同調","どうちょう"],["し"],["、"],["全く","まったく"],["その"],["とおり"],["だ"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"そのとき、総督がパウロに、話すようにと合図したので、パウロはこう答えた。「閣下が多年に渡り、この民の裁判をつかさどる方であることを存じておりますので、私は喜んで弁明いたします。","tok":[["その"],["とき"],["、"],["総督","そうとく"],["が"],["パウロ"],["に"],["、"],["話す","はなす"],["よう"],["に"],["と"],["合図","あいず"],["した"],["ので"],["、"],["パウロ"],["は"],["こう"],["答えた","こたえた"],["。"],["「"],["閣下","かっか"],["が"],["多年","たねん"],["に"],["渡り","わたり"],["、"],["この"],["民","たみ"],["の"],["裁判","さいばん"],["を"],["つかさどる"],["方","かた"],["で"],["ある"],["こと"],["を"],["存じて","ぞんじて"],["おります"],["ので"],["、"],["私","わたくし"],["は"],["喜んで","よろこんで"],["弁明","べんめい"],["いたします"],["。"]]},{"verse":11,"text":"お調べになればわかることですが、私が礼拝のためにエルサレムに上って来てから、まだ十二日しかたっておりません。","tok":[["お調べ","おしらべ"],["に"],["なれば"],["わかる"],["こと"],["です"],["が"],["、"],["私","わたくし"],["が"],["礼拝","れいはい"],["の"],["ため"],["に"],["エルサレム"],["に"],["上って","のぼって"],["来て","きて"],["から"],["、"],["まだ"],["十二","じゅうに"],["日","にち"],["しか"],["たって"],["おりません"],["。"]]},{"verse":12,"text":"そして、宮でも会堂でも、また市内でも、私がだれかと論争したり、群衆を騒がせたりするのを見た者はありません。","tok":[["そして"],["、"],["宮","みや"],["で"],["も"],["会堂","かいどう"],["で"],["も"],["、"],["また"],["市内","しない"],["で"],["も"],["、"],["私","わたくし"],["が"],["だれ"],["か"],["と"],["論争","ろんそう"],["し"],["たり"],["、"],["群衆","ぐんしゅう"],["を"],["騒がせ","さわがせ"],["たり"],["する"],["の"],["を"],["見た","みた"],["者","もの"],["は"],["ありません"],["。"]]},{"verse":13,"text":"いま私を訴えていることについて、彼らは証拠をあげることができないはずです。","tok":[["いま"],["私","わたくし"],["を"],["訴えて","うったえて"],["いる"],["こと"],["について"],["、"],["彼","かれ"],["ら"],["は"],["証拠","しょうこ"],["を"],["あげる"],["こと"],["が"],["できない"],["はず"],["です"],["。"]]},{"verse":14,"text":"しかし、私は、彼らが異端と呼んでいるこの道に従って、私たちの先祖の神に仕えていることを、閣下の前で承認いたします。私は、律法にかなうことと、預言者たちが書いていることとを全部信じています。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["異端","いたん"],["と"],["呼んで","よんで"],["いる"],["この"],["道","みち"],["に"],["従って","したがって"],["、"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["に"],["仕えて","つかえて"],["いる"],["こと"],["を"],["、"],["閣下","かっか"],["の"],["前","まえ"],["で"],["承認","しょうにん"],["いたします"],["。"],["私","わたくし"],["は"],["、"],["律法","りっぽう"],["に"],["かなう"],["こと"],["と"],["、"],["預言者","よげんしゃ"],["たち"],["が"],["書いて","かいて"],["いる"],["こと"],["と"],["を"],["全部","ぜんぶ"],["信じて","しんじて"],["います"],["。"]]},{"verse":15,"text":"また、義人も悪人も必ず復活するという、この人たち自身も抱いている望みを、神にあって抱いております。","tok":[["また"],["、"],["義人","ぎじん"],["も"],["悪人","あくにん"],["も"],["必ず","かならず"],["復活","ふっかつ"],["する"],["と"],["いう"],["、"],["この"],["人","ひと"],["たち"],["自身","じしん"],["も"],["抱いて","いだいて"],["いる"],["望み","のぞみ"],["を"],["、"],["神","かみ"],["に"],["あって"],["抱いて","いだいて"],["おります"],["。"]]},{"verse":16,"text":"そのために、私はいつも、神の前にも人の前にも責められることのない良心を保つように、と最善を尽くしています。","tok":[["その"],["ため"],["に"],["、"],["私","わたくし"],["は"],["いつも"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["も"],["人","ひと"],["の"],["前","まえ"],["に"],["も"],["責められる","せめられる"],["こと"],["の"],["ない"],["良心","りょうしん"],["を"],["保つ","たもつ"],["よう"],["に"],["、"],["と"],["最善","さいぜん"],["を"],["尽くして","つくして"],["います"],["。"]]},{"verse":17,"text":"さて私は、同胞に対して施しをし、また供え物をささげるために、幾年ぶりかで帰って来ました。","tok":[["さて"],["私","わたくし"],["は"],["、"],["同胞","どうほう"],["に対して","にたいして"],["施し","ほどこし"],["を"],["し"],["、"],["また"],["供え物","そなえもの"],["を"],["ささげる"],["ため"],["に"],["、"],["幾","いく"],["年","ねん"],["ぶり"],["か"],["で"],["帰って","かえって"],["来ました","きました"],["。"]]},{"verse":18,"text":"その供え物のことで私は清めを受けて宮の中にいたのを彼らに見られたのですが、別に群衆もおらず、騒ぎもありませんでした。ただアジヤから来た幾人かのユダヤ人がおりました。","tok":[["その"],["供え物","そなえもの"],["の"],["こと"],["で"],["私","わたくし"],["は"],["清め","きよめ"],["を"],["受けて","うけて"],["宮","みや"],["の"],["中","なか"],["に"],["いた"],["の"],["を"],["彼","かれ"],["ら"],["に"],["見られた","みられた"],["の"],["です"],["が"],["、"],["別","べつ"],["に"],["群衆","ぐんしゅう"],["も"],["おらず"],["、"],["騒ぎ","さわぎ"],["も"],["ありませんでした"],["。"],["ただ"],["アジヤ"],["から"],["来た","きた"],["幾人","いくにん"],["か"],["の"],["ユダヤ人","ゆだやじん"],["が"],["おりました"],["。"]]},{"verse":19,"text":"もし彼らに、私について何か非難したいことがあるなら、自分で閣下の前に来て訴えるべきです。","tok":[["もし"],["彼","かれ"],["ら"],["に"],["、"],["私","わたくし"],["について"],["何","なん"],["か"],["非難","ひなん"],["したい"],["こと"],["が"],["あるなら"],["、"],["自分","じぶん"],["で"],["閣下","かっか"],["の"],["前","まえ"],["に"],["来て","きて"],["訴えるべきです","うったえるべきです"],["。"]]},{"verse":20,"text":"でなければ、今ここにいる人々に、議会の前に立っていたときの私にどんな不正を見つけたかを言わせてください。","tok":[["で"],["なければ"],["、"],["今","いま"],["ここ"],["に"],["いる"],["人々","ひとびと"],["に"],["、"],["議会","ぎかい"],["の"],["前","まえ"],["に"],["立って","たって"],["いた"],["とき"],["の"],["私","わたくし"],["に"],["どんな"],["不正","ふせい"],["を"],["見つけた","みつけた"],["か"],["を"],["言わせて","いわせて"],["ください"],["。"]]},{"verse":21,"text":"彼らの中に立っていたとき、私はただ一言、『死者の復活のことで、私はきょう、あなたがたの前でさばかれているのです』と叫んだにすぎません。」","tok":[["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["立って","たって"],["いた"],["とき"],["、"],["私","わたくし"],["は"],["ただ"],["一言","ひとこと"],["、"],["『"],["死者","ししゃ"],["の"],["復活","ふっかつ"],["の"],["こと"],["で"],["、"],["私","わたくし"],["は"],["きょう"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["で"],["さばかれて"],["いる"],["の"],["です"],["』"],["と"],["叫んだ","さけんだ"],["に"],["すぎません"],["。"],["」"]]},{"verse":22,"text":"しかしペリクスは、この道について相当詳しい知識を持っていたので、「千人隊長ルシヤが下って来るとき、あなたがたの事件を解決することにしよう」と言って、裁判を延期した。","tok":[["しかし"],["ペリクス"],["は"],["、"],["この"],["道","みち"],["について"],["相当","そうとう"],["詳しい","くわしい"],["知識","ちしき"],["を"],["持って","もって"],["いた"],["ので"],["、"],["「"],["千人","せんにん"],["隊長","たいちょう"],["ルシヤ"],["が"],["下って","くだって"],["来る","くる"],["とき"],["、"],["あなた"],["がた"],["の"],["事件","じけん"],["を"],["解決","かいけつ"],["する"],["こと"],["に"],["しよう"],["」"],["と"],["言って","いって"],["、"],["裁判","さいばん"],["を"],["延期","えんき"],["した"],["。"]]},{"verse":23,"text":"そして百人隊長に、パウロを監禁するように命じたが、ある程度の自由を与え、友人たちが世話をすることを許した。","tok":[["そして"],["百人","ひゃくにん"],["隊長","たいちょう"],["に"],["、"],["パウロ"],["を"],["監禁","かんきん"],["する"],["よう"],["に"],["命じた","めいじた"],["が"],["、"],["ある"],["程度","ていど"],["の"],["自由","じゆう"],["を"],["与え","あたえ"],["、"],["友人","ゆうじん"],["たち"],["が"],["世話","せわ"],["を"],["する"],["こと"],["を"],["許した","ゆるした"],["。"]]},{"verse":24,"text":"数日後、ペリクスはユダヤ人である妻ドルシラを連れて来て、パウロを呼び出し、キリスト・イエスを信じる信仰について話を聞いた。","tok":[["数日後","すうじつご"],["、"],["ペリクス"],["は"],["ユダヤ人","ゆだやじん"],["で"],["ある"],["妻","つま"],["ドルシラ"],["を"],["連れて","つれて"],["来て","きて"],["、"],["パウロ"],["を"],["呼び出し","よびだし"],["、"],["キリスト"],["・"],["イエス"],["を"],["信じる","しんじる"],["信仰","しんこう"],["について"],["話","はなし"],["を"],["聞いた","きいた"],["。"]]},{"verse":25,"text":"しかし、パウロが正義と節制とやがて来る審判とを論じたので、ペリクスは恐れを感じ、「今は帰ってよい。おりを見て、また呼び出そう」と言った。","tok":[["しかし"],["、"],["パウロ"],["が"],["正義","せいぎ"],["と"],["節制","せっせい"],["と"],["やがて"],["来る","くる"],["審判","しんぱん"],["と"],["を"],["論じた","ろんじた"],["ので"],["、"],["ペリクス"],["は"],["恐れ","おそれ"],["を"],["感じ","かんじ"],["、"],["「"],["今","いま"],["は"],["帰って","かえって"],["よい"],["。"],["おり"],["を"],["見て","みて"],["、"],["また"],["呼び出そう","よびだそう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"それとともに、彼はパウロから金をもらいたい下心があったので、幾度もパウロを呼び出して話し合った。","tok":[["それ"],["と"],["とも"],["に"],["、"],["彼","かれ"],["は"],["パウロ"],["から"],["金","かね"],["を"],["もらいたい"],["下心","したごころ"],["が"],["あった"],["ので"],["、"],["幾度","いくど"],["も"],["パウロ"],["を"],["呼び出して","よびだして"],["話し合った","はなしあった"],["。"]]},{"verse":27,"text":"二年たって後、ポルキオ・フェストがペリクスの後任になったが、ペリクスはユダヤ人に恩を売ろうとして、パウロを牢につないだままにしておいた。","tok":[["二","に"],["年","ねん"],["たって"],["後","あと"],["、"],["ポルキオ"],["・"],["フェスト"],["が"],["ペリクス"],["の"],["後任","こうにん"],["に"],["なった"],["が"],["、"],["ペリクス"],["は"],["ユダヤ人","ゆだやじん"],["に"],["恩","おん"],["を"],["売ろう","うろう"],["として"],["、"],["パウロ"],["を"],["牢","ろう"],["に"],["つないだ"],["まま"],["に"],["して"],["おいた"],["。"]]}]
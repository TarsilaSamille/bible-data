[{"verse":1,"text":"サウロは、ステパノを殺すことに賛成していた。その日、エルサレムの教会に対する激しい迫害が起こり、使徒たち以外の者はみな、ユダヤとサマリヤの諸地方に散らされた。","tok":[["サウロ"],["は"],["、"],["ステパノ"],["を"],["殺す","ころす"],["こと"],["に"],["賛成","さんせい"],["して"],["いた"],["。"],["その"],["日","ひ"],["、"],["エルサレム"],["の"],["教会","きょうかい"],["に"],["対する","たいする"],["激しい","はげしい"],["迫害","はくがい"],["が"],["起こり","おこり"],["、"],["使徒","しと"],["たち"],["以外","いがい"],["の"],["者","もの"],["は"],["みな"],["、"],["ユダヤ"],["と"],["サマリヤ"],["の"],["諸","しょ"],["地方","ちほう"],["に"],["散らされた","ちらされた"],["。"]]},{"verse":2,"text":"敬虔な人たちはステパノを葬り、彼のために非常に悲しんだ。","tok":[["敬虔","けいけん"],["な"],["人","ひと"],["たち"],["は"],["ステパノ"],["を"],["葬り","ほうむり"],["、"],["彼","かれ"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["悲しんだ","かなしんだ"],["。"]]},{"verse":3,"text":"サウロは教会を荒らし、家々に入って、男も女も引きずり出し、次々に牢に入れた。","tok":[["サウロ"],["は"],["教会","きょうかい"],["を"],["荒らし","あらし"],["、"],["家々","いえいえ"],["に"],["入って","はいって"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["引きずり","ひきずり"],["出し","だし"],["、"],["次々","つぎつぎ"],["に"],["牢","ろう"],["に"],["入れた","いれた"],["。"]]},{"verse":4,"text":"他方、散らされた人たちは、みことばを宣べながら、巡り歩いた。","tok":[["他方","たほう"],["、"],["散らされた","ちらされた"],["人","ひと"],["たち"],["は"],["、"],["みことば"],["を"],["宣べ","のべ"],["ながら"],["、"],["巡り歩いた","めぐりあるいた"],["。"]]},{"verse":5,"text":"ピリポはサマリヤの町に下って行き、人々にキリストを宣べ伝えた。","tok":[["ピリポ"],["は"],["サマリヤ"],["の"],["町","まち"],["に"],["下って","くだって"],["行き","いき"],["、"],["人々","ひとびと"],["に"],["キリスト"],["を"],["宣べ伝えた","のべつたえた"],["。"]]},{"verse":6,"text":"群衆はピリポの話を聞き、その行っていたしるしを見て、みなそろって、彼の語ることに耳を傾けた。","tok":[["群衆","ぐんしゅう"],["は"],["ピリポ"],["の"],["話","はなし"],["を"],["聞き","きき"],["、"],["その"],["行って","いって"],["いた"],["しるし"],["を"],["見て","みて"],["、"],["みな"],["そろって"],["、"],["彼","かれ"],["の"],["語る","かたる"],["こと"],["に"],["耳","みみ"],["を"],["傾けた","かたむけた"],["。"]]},{"verse":7,"text":"汚れた霊につかれた多くの人たちからは、その霊が大声で叫んで出て行くし、多くの中風の者や足のなえた者は直ったからである。","tok":[["汚れた","よごれた"],["霊","れい"],["に"],["つかれた"],["多く","おおく"],["の"],["人","ひと"],["たち"],["から"],["は"],["、"],["その"],["霊","れい"],["が"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["出て","でて"],["行く","いく"],["し"],["、"],["多く","おおく"],["の"],["中風","ちゅうぶ"],["の"],["者","もの"],["や"],["足","あし"],["の"],["なえた"],["者","もの"],["は"],["直った","なおった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"それでその町に大きな喜びが起こった。","tok":[["それ"],["で"],["その"],["町","まち"],["に"],["大きな","おおきな"],["喜び","よろこび"],["が"],["起こった","おこった"],["。"]]},{"verse":9,"text":"ところが、この町にシモンという人がいた。彼は以前からこの町で魔術を行って、サマリヤの人々を驚かし、自分は偉大な者だと話していた。","tok":[["ところ"],["が"],["、"],["この"],["町","まち"],["に"],["シモン"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["彼","かれ"],["は"],["以前","いぜん"],["から"],["この"],["町","まち"],["で"],["魔術","まじゅつ"],["を"],["行って","おこなって"],["、"],["サマリヤ"],["の"],["人々","ひとびと"],["を"],["驚かし","おどろかし"],["、"],["自分","じぶん"],["は"],["偉大","いだい"],["な"],["者","もの"],["だ"],["と"],["話して","はなして"],["いた"],["。"]]},{"verse":10,"text":"小さな者から大きな者に至るまで、あらゆる人々が彼に関心を抱き、「この人こそ、大能と呼ばれる、神の力だ」と言っていた。","tok":[["小さな","ちいさな"],["者","もの"],["から"],["大きな","おおきな"],["者","もの"],["に"],["至る","いたる"],["まで"],["、"],["あらゆる"],["人々","ひとびと"],["が"],["彼","かれ"],["に"],["関心","かんしん"],["を"],["抱き","いだき"],["、"],["「"],["この"],["人","ひと"],["こそ"],["、"],["大能","おおの"],["と"],["呼ばれる","よばれる"],["、"],["神","かみ"],["の"],["力","ちから"],["だ"],["」"],["と"],["言って","いって"],["いた"],["。"]]},{"verse":11,"text":"人々が彼に関心を抱いたのは、長い間、その魔術に驚かされていたからである。","tok":[["人々","ひとびと"],["が"],["彼","かれ"],["に"],["関心","かんしん"],["を"],["抱いた","いだいた"],["の"],["は"],["、"],["長い","ながい"],["間","あいだ"],["、"],["その"],["魔術","まじゅつ"],["に"],["驚かされて","おどろかされて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"しかし、ピリポが神の国とイエス・キリストの御名について宣べるのを信じた彼らは、男も女もバプテスマを受けた。","tok":[["しかし"],["、"],["ピリポ"],["が"],["神","かみ"],["の"],["国","くに"],["と"],["イエス"],["・"],["キリスト"],["の"],["御名","ぎょめい"],["について"],["宣べる","のべる"],["の"],["を"],["信じた","しんじた"],["彼","かれ"],["ら"],["は"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["バプテスマ"],["を"],["受けた","うけた"],["。"]]},{"verse":13,"text":"シモン自身も信じて、バプテスマを受け、いつもピリポについていた。そして、しるしとすばらしい奇蹟が行われるのを見て、驚いていた。","tok":[["シモン"],["自身","じしん"],["も"],["信じて","しんじて"],["、"],["バプテスマ"],["を"],["受け","うけ"],["、"],["いつも"],["ピリポ"],["について"],["いた"],["。"],["そして"],["、"],["しるし"],["と"],["すばらしい"],["奇蹟","きせき"],["が"],["行われる","おこなわれる"],["の"],["を"],["見て","みて"],["、"],["驚いて","おどろいて"],["いた"],["。"]]},{"verse":14,"text":"さて、エルサレムにいる使徒たちは、サマリヤの人々が神のことばを受け入れたと聞いて、ペテロとヨハネを彼らのところへ遣わした。","tok":[["さて"],["、"],["エルサレム"],["に"],["いる"],["使徒","しと"],["たち"],["は"],["、"],["サマリヤ"],["の"],["人々","ひとびと"],["が"],["神","かみ"],["の"],["ことば"],["を"],["受け入れた","うけいれた"],["と"],["聞いて","きいて"],["、"],["ペテロ"],["と"],["ヨハネ"],["を"],["彼","かれ"],["ら"],["の"],["ところ"],["へ"],["遣わした","つかわした"],["。"]]},{"verse":15,"text":"ふたりは下って行って、人々が聖霊を受けるように祈った。","tok":[["ふたり"],["は"],["下って","くだって"],["行って","いって"],["、"],["人々","ひとびと"],["が"],["聖霊","せいれい"],["を"],["受ける","うける"],["よう"],["に"],["祈った","いのった"],["。"]]},{"verse":16,"text":"彼らは主イエスの御名によってバプテスマを受けていただけで、聖霊がまだだれにも下っておられなかったからである。","tok":[["彼","かれ"],["ら"],["は"],["主","しゅ"],["イエス"],["の"],["御名","ぎょめい"],["によって"],["バプテスマ"],["を"],["受けて","うけて"],["いた"],["だけ"],["で"],["、"],["聖霊","せいれい"],["が"],["まだ"],["だれ"],["に"],["も"],["下って","くだって"],["おられなかった"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"ふたりが彼らの上に手を置くと、彼らは聖霊を受けた。","tok":[["ふたり"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置く","おく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["聖霊","せいれい"],["を"],["受けた","うけた"],["。"]]},{"verse":18,"text":"使徒たちが手を置くと御霊が与えられるのを見たシモンは、使徒たちのところに金を持って来て、","tok":[["使徒","しと"],["たち"],["が"],["手","て"],["を"],["置く","おく"],["と"],["御霊","ごれい"],["が"],["与えられる","あたえられる"],["の"],["を"],["見た","みた"],["シモン"],["は"],["、"],["使徒","しと"],["たち"],["の"],["ところ"],["に"],["金","かね"],["を"],["持って","もって"],["来て","きて"],["、"]]},{"verse":19,"text":"「私が手を置いた者がだれでも聖霊を受けられるように、この権威を私にも下さい」と言った。","tok":[["「"],["私","わたくし"],["が"],["手","て"],["を"],["置いた","おいた"],["者","もの"],["が"],["だれ"],["で"],["も"],["聖霊","せいれい"],["を"],["受けられる","うけられる"],["よう"],["に"],["、"],["この"],["権威","けんい"],["を"],["私","わたくし"],["に"],["も"],["下さい","ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"ペテロは彼に向かって言った。「あなたの金は、あなたとともに滅びるがよい。あなたは金で神の賜物を手に入れようと思っているからです。","tok":[["ペテロ"],["は"],["彼","かれ"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["あなた"],["の"],["金","かね"],["は"],["、"],["あなた"],["と"],["とも"],["に"],["滅びる","ほろびる"],["が"],["よい"],["。"],["あなた"],["は"],["金","きん"],["で"],["神","かみ"],["の"],["賜物","たまもの"],["を"],["手","て"],["に"],["入れよう","いれよう"],["と"],["思って","おもって"],["いる"],["から"],["です"],["。"]]},{"verse":21,"text":"あなたは、このことについては何の関係もないし、それにあずかることもできません。あなたの心が神の前に正しくないからです。","tok":[["あなた"],["は"],["、"],["この"],["こと"],["について"],["は"],["何","なん"],["の"],["関係","かんけい"],["も"],["ない"],["し"],["、"],["それ"],["に"],["あずかる"],["こと"],["も"],["できません"],["。"],["あなた"],["の"],["心","こころ"],["が"],["神","かみ"],["の"],["前","まえ"],["に"],["正しく","ただしく"],["ない"],["から"],["です"],["。"]]},{"verse":22,"text":"だから、この悪事を悔い改めて、主に祈りなさい。あるいは、心に抱いた思いが赦されるかもしれません。","tok":[["だ"],["から"],["、"],["この"],["悪事","あくじ"],["を"],["悔い改めて","くいあらためて"],["、"],["主に","おもに"],["祈り","いのり"],["なさい"],["。"],["あるいは"],["、"],["心","こころ"],["に"],["抱いた","いだいた"],["思い","おもい"],["が"],["赦される","ゆるされる"],["か"],["も"],["しれません"],["。"]]},{"verse":23,"text":"あなたはまだ苦い胆汁と不義のきずなの中にいることが、私にはよくわかっています。」","tok":[["あなた"],["は"],["まだ"],["苦い","にがい"],["胆汁","たんじゅう"],["と"],["不義","ふぎ"],["の"],["きずな"],["の"],["中","なか"],["に"],["いる"],["こと"],["が"],["、"],["私","わたくし"],["に"],["は"],["よく"],["わかって"],["います"],["。"],["」"]]},{"verse":24,"text":"シモンは答えて言った。「あなたがたの言われた事が何も私に起こらないように、私のために主に祈ってください。」","tok":[["シモン"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["言われた","いわれた"],["事","こと"],["が"],["何","なん"],["も"],["私","わたくし"],["に"],["起こらない","おこらない"],["よう"],["に"],["、"],["私","わたくし"],["の"],["ため"],["に"],["主","ぬし"],["に"],["祈って","いのって"],["ください"],["。"],["」"]]},{"verse":25,"text":"このようにして、使徒たちはおごそかにあかしをし、また主のことばを語って後、エルサレムへの帰途につき、サマリヤ人の多くの村でも福音を宣べ伝えた。","tok":[["この"],["よう"],["に"],["して"],["、"],["使徒","しと"],["たち"],["は"],["おごそか"],["に"],["あかし"],["を"],["し"],["、"],["また"],["主","ぬし"],["の"],["ことば"],["を"],["語って","かたって"],["後","あと"],["、"],["エルサレム"],["へ"],["の"],["帰途","きと"],["に"],["つき"],["、"],["サマリヤ"],["人","にん"],["の"],["多く","おおく"],["の"],["村","むら"],["で"],["も"],["福音","ふくいん"],["を"],["宣べ伝えた","のべつたえた"],["。"]]},{"verse":26,"text":"ところが、主の使いがピリポに向かってこう言った。「立って南へ行き、エルサレムからガザに下る道に出なさい。」(このガザは今、荒れ果てている。)","tok":[["ところ"],["が"],["
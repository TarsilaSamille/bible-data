],["。"]]},{"verse":45,"text":"私たちの父祖たちは、この幕屋を次々に受け継いで、神が彼らの前から異邦人を追い払い、その領土を取らせてくださったときには、ヨシュアとともにそれを運び入れ、ついにダビデの時代となりました。","tok":[["私たち","わたしたち"],["の"],["父祖","ふそ"],["たち"],["は"],["、"],["この"],["幕屋","まくや"],["を"],["次々","つぎつぎ"],["に"],["受け継いで","うけついで"],["、"],["神","かみ"],["が"],["彼","かれ"],["ら"],["の"],["前","まえ"],["から"],["異邦人","いほうじん"],["を"],["追い払い","おいはらい"],["、"],["その"],["領土","りょうど"],["を"],["取らせて","とらせて"],["くださった"],["とき"],["に"],["は"],["、"],["ヨシュア"],["と"],["とも"],["に"],["それ"],["を"],["運び入れ","はこびいれ"],["、"],["ついに"],["ダビデ"],["の"],["時代","じだい"],["と"],["なりました"],["。"]]},{"verse":46,"text":"ダビデは神の前に恵みをいただき、ヤコブの神のために御住まいを得たいと願い求めました。","tok":[["ダビデ"],["は"],["神","かみ"],["の"],["前","まえ"],["に"],["恵み","めぐみ"],["を"],["いただき"],["、"],["ヤコブ"],["の"],["神","かみ"],["の"],["ため"],["に"],["御住まい","おすまい"],["を"],["得たい","えたい"],["と"],["願い求めました","ねがいもとめました"],["。"]]},{"verse":47,"text":"けれども、神のために家を建てたのはソロモンでした。","tok":[["けれど"],["も"],["、"],["神","かみ"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てた","たてた"],["の"],["は"],["ソロモン"],["でした"],["。"]]},{"verse":48,"text":"しかし、いと高き方は、手で造った家にはお住みになりません。預言者が語っているとおりです。","tok":[["しかし"],["、"],["いと"],["高き","たかき"],["方","ほう"],["は"],["、"],["手","て"],["で"],["造った","つくった"],["家","いえ"],["に"],["は"],["お住み","おすみ"],["に"],["なりません"],["。"],["預言者","よげんしゃ"],["が"],["語って","かたって"],["いる"],["とおり"],["です"],["。"]]},{"verse":49,"text":"『主は言われる。天はわたしの王座、地はわたしの足の足台である。あなたがたは、どのような家をわたしのために建てようとするのか。わたしの休む所とは、どこか。","tok":[["『"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["天","てん"],["は"],["わたし"],["の"],["王座","おうざ"],["、"],["地","ち"],["は"],["わたし"],["の"],["足","あし"],["の"],["足台","あしだい"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["どのような"],["家","いえ"],["を"],["わたし"],["の"],["ため"],["に"],["建てよう","たてよう"],["と"],["する"],["の"],["か"],["。"],["わたし"],["の"],["休む","やすむ"],["所","ところ"],["と"],["は"],["、"],["どこ"],["か"],["。"]]},{"verse":50,"text":"わたしの手が、これらのものをみな、造ったのではないか。』","tok":[["わたし"],["の"],["手","て"],["が"],["、"],["これ"],["ら"],["の"],["もの"],["を"],["みな"],["、"],["造った","つくった"],["ので"],["は"],["ない"],["か"],["。"],["』"]]},{"verse":51,"text":"かたくなで、心と耳とに割礼を受けていない人たち。あなたがたは、父祖たちと同様に、いつも聖霊に逆らっているのです。","tok":[["かたくな"],["で"],["、"],["心","こころ"],["と"],["耳","みみ"],["と"],["に"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["人","ひと"],["たち"],["。"],["あなた"],["がた"],["は"],["、"],["父祖","ふそ"],["たち"],["と"],["同様","どうよう"],["に"],["、"],["いつも"],["聖霊","せいれい"],["に"],["逆らって","さからって"],["いる"],["の"],["です"],["。"]]},{"verse":52,"text":"あなたがたの父祖たちが迫害しなかった預言者がだれかあったでしょうか。彼らは、正しい方が来られることを前もって宣べた人たちを殺したが、今はあなたがたが、この正しい方を裏切る者、殺す者となりました。","tok":[["あなた"],["がた"],["の"],["父祖","ふそ"],["たち"],["が"],["迫害","はくがい"],["しなかった"],["預言者","よげんしゃ"],["が"],["だれ"],["か"],["あったでしょう"],["か"],["。"],["彼","かれ"],["ら"],["は"],["、"],["正しい","ただしい"],["方","ほう"],["が"],["来られる","こられる"],["こと"],["を"],["前もって","まえもって"],["宣べた","のべた"],["人","ひと"],["たち"],["を"],["殺した","ころした"],["が"],["、"],["今","いま"],["は"],["あなた"],["が"],["た"],["が"],["、"],["この"],["正しい","ただしい"],["方","ほう"],["を"],["裏切る","うらぎる"],["者","もの"],["、"],["殺す","ころす"],["者","もの"],["と"],["なりました"],["。"]]},{"verse":53,"text":"あなたがたは、御使いたちによって定められた律法を受けたが、それを守ったことはありません。」","tok":[["あなた"],["がた"],["は"],["、"],["御使い","おつかい"],["たち"],["によって"],["定められた","さだめられた"],["律法","りっぽう"],["を"],["受けた","うけた"],["が"],["、"],["それ"],["を"],["守った","まもった"],["こと"],["は"],["ありません"],["。"],["」"]]},{"verse":54,"text":"人々はこれを聞いて、はらわたが煮え返る思いで、ステパノに向かって歯ぎしりした。","tok":[["人々","ひとびと"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["はらわた"],["が"],["煮え返る","にえかえる"],["思い","おもい"],["で"],["、"],["ステパノ"],["に"],["向かって","むかって"],["歯ぎしり","はぎしり"],["した"],["。"]]},{"verse":55,"text":"しかし、聖霊に満たされていたステパノは、天を見つめ、神の栄光と、神の右に立っておられるイエスとを見て、","tok":[["しかし"],["、"],["聖霊","せいれい"],["に"],["満たされて","みたされて"],["いた"],["ステパノ"],["は"],["、"],["天","てん"],["を"],["見つめ","みつめ"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["と"],["、"],["神","かみ"],["の"],["右","みぎ"],["に"],["立って","たって"],["おられる"],["イエス"],["と"],["を"],["見て","みて"],["、"]]},{"verse":56,"text":"こう言った。「見なさい。天が開けて、人の子が神の右に立っておられるのが見えます。」","tok":[["こう"],["言った","いった"],["。"],["「"],["見","み"],["なさい"],["。"],["天","てん"],["が"],["開けて","あけて"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["神","かみ"],["の"],["右","みぎ"],["に"],["立って","たって"],["おられる"],["の"],["が"],["見えます","みえます"],["。"],["」"]]},{"verse":57,"text":"人々は大声で叫びながら、耳をおおい、いっせいにステパノに殺到した。","tok":[["人々","ひとびと"],["は"],["大声","おおごえ"],["で"],["叫び","さけび"],["ながら"],["、"],["耳","みみ"],["を"],["おおい"],["、"],["いっせい"],["に"],["ステパノ"],["に"],["殺到","さっとう"],["した"],["。"]]},{"verse":58,"text":"そして彼を町の外に追い出して、石で打ち殺した。証人たちは、自分たちの着物をサウロという青年の足もとに置いた。","tok":[["そして"],["彼","かれ"],["を"],["町","まち"],["の"],["外","そと"],["に"],["追い出して","おいだして"],["、"],["石","いし"],["で"],["打ち殺した","うちころした"],["。"],["証人","しょうにん"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["着物","きもの"],["を"],["サウロ"],["と"],["いう"],["青年","せいねん"],["の"],["足もと","あしもと"],["に"],["置いた","おいた"],["。"]]},{"verse":59,"text":"こうして彼らがステパノに石を投げつけていると、ステパノは主を呼んで、こう言った。「主イエスよ。私の霊をお受けください。」","tok":[["こう"],["して"],["彼","かれ"],["ら"],["が"],["ステパノ"],["に"],["石","いし"],["を"],["投げつけて","なげつけて"],["いる"],["と"],["、"],["ステパノ"],["は"],["主","ぬし"],["を"],["呼んで","よんで"],["、"],["こう"],["言った","いった"],["。"],["「"],["主","しゅ"],["イエス"],["よ"],["。"],["私","わたくし"],["の"],["霊","れい"],["を"],["お受け","おうけ"],["ください"],["。"],["」"]]},{"verse":60,"text":"そして、ひざまずいて、大声でこう叫んだ。「主よ。この罪を彼らに負わせないでください。」こう言って、眠りについた。","tok":[["そして"],["、"],["ひざまずいて"],["、"],["大声","おおごえ"],["で"],["こう"],["叫んだ","さけんだ"],["。"],["「"],["主","ぬし"],["よ"],["。"],["この"],["罪","つみ"],["を"],["彼","かれ"],["ら"],["に"],["負わせないで","おわせないで"],["ください"],["。"],["」"],["こう"],["言って","いって"],["、"],["眠り","ねむり"],["に"],["ついた"],["。"]]}]
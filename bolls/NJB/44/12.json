[{"verse":1,"text":"そのころ、ヘロデ王は、教会の中のある人々を苦しめようとして、その手を伸ばし、","tok":[["その"],["ころ"],["、"],["ヘロデ"],["王","おう"],["は"],["、"],["教会","きょうかい"],["の"],["中","なか"],["の"],["ある"],["人々","ひとびと"],["を"],["苦しめよう","くるしめよう"],["として"],["、"],["その"],["手","て"],["を"],["伸ばし","のばし"],["、"]]},{"verse":2,"text":"ヨハネの兄弟ヤコブを剣で殺した。","tok":[["ヨハネ"],["の"],["兄弟","きょうだい"],["ヤコブ"],["を"],["剣","けん"],["で"],["殺した","ころした"],["。"]]},{"verse":3,"text":"それがユダヤ人の気に入ったのを見て、次にはペテロをも捕らえにかかった。それは、種なしパンの祝いの時期であった。","tok":[["それ"],["が"],["ユダヤ人","ゆだやじん"],["の"],["気","き"],["に"],["入った","いった"],["の"],["を"],["見て","みて"],["、"],["次","つぎ"],["に"],["は"],["ペテロ"],["を"],["も"],["捕らえ","とらえ"],["に"],["かかった"],["。"],["それ"],["は"],["、"],["種","しゅ"],["なし"],["パン"],["の"],["祝い","いわい"],["の"],["時期","じき"],["で"],["あった"],["。"]]},{"verse":4,"text":"ヘロデはペテロを捕らえて牢に入れ、四人一組の兵士四組に引き渡して監視させた。それは、過越の祭りの後に、民の前に引き出す考えであったからである。","tok":[["ヘロデ"],["は"],["ペテロ"],["を"],["捕らえて","とらえて"],["牢","ろう"],["に"],["入れ","いれ"],["、"],["四人","よんにん"],["一","ひと"],["組","くみ"],["の"],["兵士","へいし"],["四","よん"],["組","くみ"],["に"],["引き渡して","ひきわたして"],["監視","かんし"],["させた"],["。"],["それ"],["は"],["、"],["過越","すぎこし"],["の"],["祭り","まつり"],["の"],["後","あと"],["に"],["、"],["民","みん"],["の"],["前","まえ"],["に"],["引き出す","ひきだす"],["考え","かんがえ"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"こうしてペテロは牢に閉じ込められていた。教会は彼のために、神に熱心に祈り続けていた。","tok":[["こう"],["して"],["ペテロ"],["は"],["牢","ろう"],["に"],["閉じ込められて","とじこめられて"],["いた"],["。"],["教会","きょうかい"],["は"],["彼","かれ"],["の"],["ため"],["に"],["、"],["神","かみ"],["に"],["熱心","ねっしん"],["に"],["祈り","いのり"],["続けて","つづけて"],["いた"],["。"]]},{"verse":6,"text":"ところでヘロデが彼を引き出そうとしていた日の前夜、ペテロは二本の鎖につながれてふたりの兵士の間で寝ており、戸口には番兵たちが牢を監視していた。","tok":[["ところ"],["で"],["ヘロデ"],["が"],["彼","かれ"],["を"],["引き出そう","ひきだそう"],["として"],["いた"],["日","ひ"],["の"],["前夜","ぜんや"],["、"],["ペテロ"],["は"],["二本","にぽん"],["の"],["鎖","くさり"],["に"],["つながれて"],["ふたり"],["の"],["兵士","へいし"],["の"],["間","あいだ"],["で"],["寝て","ねて"],["おり"],["、"],["戸口","とぐち"],["に"],["は"],["番兵","ばんぺい"],["たち"],["が"],["牢","ろう"],["を"],["監視","かんし"],["して"],["いた"],["。"]]},{"verse":7,"text":"すると突然、主の御使いが現れ、光が牢を照らした。御使いはペテロのわき腹をたたいて彼を起こし、「急いで立ち上がりなさい」と言った。すると、鎖が彼の手から落ちた。","tok":[["する"],["と"],["突然","とつぜん"],["、"],["主","ぬし"],["の"],["御使い","おつかい"],["が"],["現れ","あらわれ"],["、"],["光","ひかり"],["が"],["牢","ろう"],["を"],["照らした","てらした"],["。"],["御使い","おつかい"],["は"],["ペテロ"],["の"],["わき腹","わきばら"],["を"],["たたいて"],["彼","かれ"],["を"],["起こし","おこし"],["、"],["「"],["急いで","いそいで"],["立ち上がり","たちあがり"],["なさい"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["、"],["鎖","くさり"],["が"],["彼","かれ"],["の"],["手","て"],["から"],["落ちた","おちた"],["。"]]},{"verse":8,"text":"そして御使いが、「帯を締めて、くつをはきなさい」と言うので、彼はそのとおりにした。すると、「上着を着て、私について来なさい」と言った。","tok":[["そして"],["御使い","おつかい"],["が"],["、"],["「"],["帯","おび"],["を"],["締めて","しめて"],["、"],["くつ"],["を"],["はき"],["なさい"],["」"],["と"],["言う","いう"],["ので"],["、"],["彼","かれ"],["は"],["その"],["とおり"],["に"],["した"],["。"],["する"],["と"],["、"],["「"],["上着","うわぎ"],["を"],["着て","きて"],["、"],["私","わたくし"],["について"],["来","き"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"そこで、外に出て、御使いについて行った。彼には御使いのしている事が現実の事だとはわからず、幻を見ているのだと思われた。","tok":[["そこ"],["で"],["、"],["外","そと"],["に"],["出て","でて"],["、"],["御使い","おつかい"],["について"],["行った","いった"],["。"],["彼","かれ"],["に"],["は"],["御使い","おつかい"],["の"],["して"],["いる"],["事","こと"],["が"],["現実","げんじつ"],["の"],["事","こと"],["だ"],["と"],["は"],["わからず"],["、"],["幻","まぼろし"],["を"],["見て","みて"],["いる"],["の"],["だ"],["と"],["思われた","おもわれた"],["。"]]},{"verse":10,"text":"彼らが、第一、第二の衛所を通り、町に通じる鉄の門まで来ると、門がひとりでに開いた。そこで、彼らは外に出て、ある通りを進んで行くと、御使いは、たちまち彼を離れた。","tok":[["彼","かれ"],["ら"],["が"],["、"],["第","だい"],["一","いち"],["、"],["第","だい"],["二","に"],["の"],["衛所","えいしょ"],["を"],["通り","とおり"],["、"],["町","まち"],["に"],["通じる","つうじる"],["鉄","てつ"],["の"],["門","もん"],["まで"],["来る","くる"],["と"],["、"],["門","もん"],["が"],["ひとりでに"],["開いた","ひらいた"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["外","そと"],["に"],["出て","でて"],["、"],["ある"],["通り","とおり"],["を"],["進んで","すすんで"],["行く","いく"],["と"],["、"],["御使い","おつかい"],["は"],["、"],["たちまち"],["彼","かれ"],["を"],["離れた","はなれた"],["。"]]},{"verse":11,"text":"そのとき、ペテロは我に返って言った。「今、確かにわかった。主は御使いを遣わして、ヘロデの手から、また、ユダヤ人たちが待ち構えていたすべての災いから、私を救い出してくださったのだ。」","tok":[["その"],["とき"],["、"],["ペテロ"],["は"],["我","われ"],["に"],["返って","かえって"],["言った","いった"],["。"],["「"],["今","いま"],["、"],["確か","たしか"],["に"],["わかった"],["。"],["主","ぬし"],["は"],["御使い","おつかい"],["を"],["遣わして","つかわして"],["、"],["ヘロデ"],["の"],["手","て"],["から"],["、"],["また"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["待ち構えて","まちかまえて"],["いた"],["すべて"],["の"],["災い","わざわい"],["から"],["、"],["私","わたくし"],["を"],["救い出して","すくいだして"],["くださった"],["の"],["だ"],["。"],["」"]]},{"verse":12,"text":"こうとわかったので、ペテロは、マルコと呼ばれているヨハネの母マリヤの家へ行った。そこには大ぜいの人が集まって、祈っていた。","tok":[["こう"],["と"],["わかった"],["ので"],["、"],["ペテロ"],["は"],["、"],["マルコ"],["と"],["呼ばれて","よばれて"],["いる"],["ヨハネ"],["の"],["母","はは"],["マリヤ"],["の"],["家","いえ"],["へ"],["行った","いった"],["。"],["そこ"],["に"],["は"],["大ぜい","おおぜい"],["の"],["人","ひと"],["が"],["集まって","あつまって"],["、"],["祈って","いのって"],["いた"],["。"]]},{"verse":13,"text":"彼が入口の戸をたたくと、ロダという女中が応対に出て来た。","tok":[["彼","かれ"],["が"],["入口","いりぐち"],["の"],["戸","と"],["を"],["たたく"],["と"],["、"],["ロダ"],["と"],["いう"],["女中","じょちゅう"],["が"],["応対","おうたい"],["に"],["出て","でて"],["来た","きた"],["。"]]},{"verse":14,"text":"ところが、ペテロの声だとわかると、喜びのあまり門をあけもしないで、奥へ駆け込み、ペテロが門の外に立っていることをみなに知らせた。","tok":[["ところ"],["が"],["、"],["ペテロ"],["の"],["声","こえ"],["だ"],["と"],["わかる"],["と"],["、"],["喜び","よろこび"],["の"],["あまり"],["門","もん"],["を"],["あけ"],["も"],["しないで"],["、"],["奥","おく"],["へ"],["駆け込み","かけこみ"],["、"],["ペテロ"],["が"],["門","もん"],["の"],["外","そと"],["に"],["立って","たって"],["いる"],["こと"],["を"],["みな"],["に"],["知らせた","しらせた"],["。"]]},{"verse":15,"text":"彼らは、「あなたは気が狂っているのだ」と言ったが、彼女はほんとうだと言い張った。そこで彼らは、「それは彼の御使いだ」と言っていた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["「"],["あなた"],["は"],["気","き"],["が"],["狂って","くるって"],["いる"],["の"],["だ"],["」"],["と"],["言った","いった"],["が"],["、"],["彼女","かのじょ"],["は"],["ほんとう"],["だ"],["と"],["言い張った","いいはった"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["「"],["それ"],["は"],["彼","かれ"],["の"],["御使い","おつかい"],["だ"],["」"],["と"],["言って","いって"],["いた"],["。"]]},{"verse":16,"text":"しかし、ペテロはたたき続けていた。彼らが門をあけると、そこにペテロがいたので、非常に驚いた。","tok":[["しかし"],["、"],["ペテロ"],["は"],["たたき"],["続けて","つづけて"],["いた"],["。"],["彼","かれ"],["ら"],["が"],["門","もん"],["を"],["あける"],["と"],["、"],["そこ"],["に"],["ペテロ"],["が"],["いた"],["ので"],["、"],["非常","ひじょう"],["に"],["驚いた","おどろいた"],["。"]]},{"verse":17,"text":"しかし彼は、手ぶりで彼らを静かにさせ、主がどのようにして牢から救い出してくださったかを、彼らに話して聞かせた。それから、「このことをヤコブと兄弟たちに知らせてください」と言って、ほかの所へ出て行った。","tok":[["しかし"],["彼","かれ"],["は"],["、"],["手ぶり","てぶり"],["で"],["彼","かれ"],["ら"],["を"],["静か","しずか"],["に"],["させ"],["、"],["主","ぬし"],["が"],["どの"],["よう"],["に"],["して"],["牢","ろう"],["から"],["救い出して","すくいだして"],["くださった"],["か"],["を"],["、"],["彼","かれ"],["ら"],["に"],["話して","はなして"],["聞かせた","きかせた"],["。"],["それ"],["から"],["、"],["「"],["この"],["こと"],["を"],["ヤコブ"],["と"],["兄弟","きょうだい"],["たち"],["に"],["知らせて","しらせて"],["ください"],["」"],["と"],["言って","いって"],["、"],["ほか"],["の"],["所","ところ"],["へ"],["出て","でて"],["行った","いった"],["。"]]},{"verse":18,"text":"さて、朝になると、ペテロはどうなったのかと、兵士たちの間に大騒ぎが起こった。","tok":[["さて"],["、"],["朝","あさ"],["に"],["なる"],["と"],["、"],["ペテロ"],["は"],["どう"],["なった"],["の"],["か"],["と"],["、"],["兵士","へいし"],["たち"],["の"],["間","あいだ"],["に"],["大騒ぎ","おおさわぎ"],["が"],["起こった","おこった"],["。"]]},{"verse":19,"text":"ヘロデは彼を捜したが見つけることができないので、番兵たちを取り調べ、彼らを処刑するように命じ、そして、ユダヤからカイザリヤに下って行って、そこに滞在した。","tok":[["ヘロデ"],["は"],["彼","かれ"],["を"],["捜した","さがした"],["が"],["見つける","みつける"],["こと"],["が"],["できない"],["ので"],["、"],["番兵","ばんぺい"],["たち"],["を"],["取り調べ","とりしらべ"],["、"],["彼","かれ"],["ら"],["を"],["処刑","しょけい"],["する"],["よう"],["に"],["命じ","めいじ"],["、"],["そして"],["、"],["ユダヤ"],["から"],["カイザリヤ"],["に"],["下って","くだって"],["行って","いって"],["、"],["そこ"],["に"],["滞在","たいざい"],["した"],["。"]]},{"verse":20,"text":"さて、ヘロデはツロとシドンの人々に対して強い敵意を抱いていた。そこで彼らはみなでそろって彼をたずね、王の侍従ブラストに取り入って和解を求めた。その地方は王の国から食糧を得ていたからである。","tok":[["さて"],["、"],["ヘロデ"],["は"],["ツロ"],["と"],["シドン"],["の"],["人々","ひとびと"],["に対して","にたいして"],["強い","つよい"],["敵意","てきい"],["を"],["抱いて","いだいて"],["いた"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["みな"],["で"],["そろって"],["彼","かれ"],["を"],["たずね"],["、"],["王","おう"],["の"],["侍従","じじゅう"],["ブラスト"],["に"],["取り入って","とりいって"],["和解","わかい"],["を"],["求めた","もとめた"],["。"],["その"],["地方","ちほう"],["は"],["王","おう"],["の"],["国","くに"],["から"],["食糧","しょくりょう"],["を"],["得て","えて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"定められた日に、ヘロデは王服を着けて、王座に着き、彼らに向かって演説を始めた。","tok":[["定められた","さだめられた"],["日","ひ"],["に"],["、"],["ヘロデ"],["は"],["王","おう"],["服","ふく"],["を"],["着けて","つけて"],["、"],["王座","おうざ"],["に"],["着き","つき"],["、"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["演説","えんぜつ"],["を"],["始めた","はじめた"],["。"]]},{"verse":22,"text":"そこで民衆は、「神の声だ。人間の声ではない」と叫び続けた。","tok":[["そこ"],["で"],["民衆","みんしゅう"],["は"],["、"],["「"],["神","かみ"],["の"],["声","こえ"],["だ"],["。"],["人間","にんげん"],["の"],["声","こえ"],["で"],["は"],["ない"],["」"],["と"],["叫び","さけび"],["続けた","つづけた"],["。"]]},{"verse":23,"text":"するとたちまち、主の使いがヘロデを打った。ヘロデが神に栄光を帰さなかったからである。彼は虫にかまれて息が絶えた。","tok":[["する"],["と"],["たちまち"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["ヘロデ"],["を"],["打った","うった"],["。"],["ヘロデ"],["が"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰さなかった","かえさなかった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["虫","むし"],["に"],["かまれて"],["息","いき"],["が"],["絶えた","たえた"],["。"]]},{"verse":24,"text":"主のみことばは、ますます盛んになり、広まって行った。","tok":[["主","ぬし"],["のみ"],["ことば"],["は"],["、"],["ますます"],["盛ん","さかん"],["に"],["なり"],["、"],["広まって","ひろまって"],["行った","いった"],["。"]]},{"verse":25,"text":"任務を果たしたバルナバとサウロは、マルコと呼ばれるヨハネを連れて、エルサレムから帰って来た。","tok":[["任務","にんむ"],["を"],["果たした","はたした"],["バルナバ"],["と"],["サウロ"],["は"],["、"],["マルコ"],["と"],["呼ばれる","よばれる"],["ヨハネ"],["を"],["連れて","つれて"],["、"],["エルサレム"],["から"],["帰って","かえって"],["来た","きた"],["。"]]}]
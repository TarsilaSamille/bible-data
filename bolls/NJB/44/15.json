[{"verse":1,"text":"さて、ある人々がユダヤから下って来て、兄弟たちに、「モーセの慣習に従って割礼を受けなければ、あなたがたは救われない」と教えていた。","tok":[["さて"],["、"],["ある"],["人々","ひとびと"],["が"],["ユダヤ"],["から"],["下って","くだって"],["来て","きて"],["、"],["兄弟","きょうだい"],["たち"],["に"],["、"],["「"],["モーセ"],["の"],["慣習","かんしゅう"],["に"],["従って","したがって"],["割礼","かつれい"],["を"],["受けなければ","うけなければ"],["、"],["あなた"],["がた"],["は"],["救われない","すくわれない"],["」"],["と"],["教えて","おしえて"],["いた"],["。"]]},{"verse":2,"text":"そしてパウロやバルナバと彼らとの間に激しい対立と論争が生じたので、パウロとバルナバと、その仲間のうちの幾人かが、この問題について使徒たちや長老たちと話し合うために、エルサレムに上ることになった。","tok":[["そして"],["パウロ"],["や"],["バルナバ"],["と"],["彼","かれ"],["ら"],["と"],["の"],["間","あいだ"],["に"],["激しい","はげしい"],["対立","たいりつ"],["と"],["論争","ろんそう"],["が"],["生じた","しょうじた"],["ので"],["、"],["パウロ"],["と"],["バルナバ"],["と"],["、"],["その"],["仲間","なかま"],["の"],["うち"],["の"],["幾人","いくにん"],["か"],["が"],["、"],["この"],["問題","もんだい"],["について"],["使徒","しと"],["たち"],["や"],["長老","ちょうろう"],["たち"],["と"],["話し合う","はなしあう"],["ため"],["に"],["、"],["エルサレム"],["に"],["上る","のぼる"],["こと"],["に"],["なった"],["。"]]},{"verse":3,"text":"彼らは教会の人々に見送られ、フェニキヤとサマリヤを通る道々で、異邦人の改宗のことを詳しく話したので、すべての兄弟たちに大きな喜びをもたらした。","tok":[["彼","かれ"],["ら"],["は"],["教会","きょうかい"],["の"],["人々","ひとびと"],["に"],["見送られ","みおくられ"],["、"],["フェニキヤ"],["と"],["サマリヤ"],["を"],["通る","とおる"],["道々","みちみち"],["で"],["、"],["異邦人","いほうじん"],["の"],["改宗","かいしゅう"],["の"],["こと"],["を"],["詳しく","くわしく"],["話した","はなした"],["ので"],["、"],["すべて"],["の"],["兄弟","きょうだい"],["たち"],["に"],["大きな","おおきな"],["喜び","よろこび"],["を"],["もたらした"],["。"]]},{"verse":4,"text":"エルサレムに着くと、彼らは教会と使徒たちと長老たちに迎えられ、神が彼らとともにいて行われたことを、みなに報告した。","tok":[["エルサレム"],["に"],["着く","つく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["教会","きょうかい"],["と"],["使徒","しと"],["たち"],["と"],["長老","ちょうろう"],["たち"],["に"],["迎えられ","むかえられ"],["、"],["神","かみ"],["が"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["いて"],["行われた","おこなわれた"],["こと"],["を"],["、"],["みな"],["に"],["報告","ほうこく"],["した"],["。"]]},{"verse":5,"text":"しかし、パリサイ派の者で信者になった人々が立ち上がり、「異邦人にも割礼を受けさせ、また、モーセの律法を守ることを命じるべきである」と言った。","tok":[["しかし"],["、"],["パリサイ"],["派","は"],["の"],["者","もの"],["で"],["信者","しんじゃ"],["に"],["なった"],["人々","
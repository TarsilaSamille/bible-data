["に"],["三四","さんし"],["節","せつ"],["として"],["、"],["「"],["しかし"],["、"],["シラス"],["は"],["そこ"],["に"],["とどまる"],["こと"],["に"],["決めた","きめた"],["」"],["を"],["加える","くわえる"],["もの"],["も"],["ある"],["。"]]},{"verse":35,"text":"パウロとバルナバはアンテオケにとどまって、ほかの多くの人々とともに、主のみことばを教え、宣べ伝えた。","tok":[["パウロ"],["と"],["バルナバ"],["は"],["アンテオケ"],["に"],["とどまって"],["、"],["ほか"],["の"],["多く","おおく"],["の"],["人々","ひとびと"],["と"],["とも"],["に"],["、"],["主","ぬし"],["のみ"],["ことば"],["を"],["教え","おしえ"],["、"],["宣べ伝えた","のべつたえた"],["。"]]},{"verse":36,"text":"幾日かたって後、パウロはバルナバにこう言った。「先に主のことばを伝えたすべての町々の兄弟たちのところに、またたずねて行って、どうしているか見て来ようではありませんか。」","tok":[["幾日","いくか"],["かた"],["って"],["後","あと"],["、"],["パウロ"],["は"],["バルナバ"],["に"],["こう"],["言った","いった"],["。"],["「"],["先","さき"],["に"],["主","ぬし"],["の"],["ことば"],["を"],["伝えた","つたえた"],["すべて"],["の"],["町々","まちまち"],["の"],["兄弟","きょうだい"],["たち"],["の"],["ところ"],["に"],["、"],["また"],["たずねて"],["行って","いって"],["、"],["どう"],["して"],["いる"],["か"],["見て","みて"],["来","き"],["よう"],["で"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":37,"text":"ところが、バルナバは、マルコとも呼ばれるヨハネもいっしょに連れて行くつもりであった。","tok":[["ところ"],["が"],["、"],["バルナバ"],["は"],["、"],["マルコ"],["と"],["も"],["呼ばれる","よばれる"],["ヨハネ"],["も"],["いっしょ"],["に"],["連れて","つれて"],["行く","いく"],["つもり"],["で"],["あった"],["。"]]},{"verse":38,"text":"しかしパウロは、パンフリヤで一行から離れてしまい、仕事のために同行しなかったような者はいっしょに連れて行かないほうがよいと考えた。","tok":[["しかし"],["パウロ"],["は"],["、"],["パンフリヤ"],["で"],["一行","いっこう"],["から"],["離れて","はなれて"],["しまい"],["、"],["仕事","しごと"],["の"],["ため"],["に"],["同行","どうこう"],["しなかった"],["よう"],["な"],["者","もの"],["は"],["いっしょ"],["に"],["連れて","つれて"],["行かない","いかない"],["ほう"],["が"],["よい"],["と"],["考えた","かんがえた"],["。"]]},{"verse":39,"text":"そして激しい反目となり、その結果、互いに別行動をとることになって、バルナバはマルコを連れて、船でキプロスに渡って行った。","tok":[["そして"],["激しい","はげしい"],["反目","はんもく"],["と"],["なり"],["、"],["その"],["結果","けっか"],["、"],["互い","たがい"],["に"],["別行動","べつこうどう"],["を"],["とる"],["こと"],["に"],["なって"],["、"],["バルナバ"],["は"],["マルコ"],["を"],["連れて","つれて"],["、"],["船","ふね"],["で"],["キプロス"],["に"],["渡って","わたって"],["行った","いった"],["。"]]},{"verse":40,"text":"パウロはシラスを選び、兄弟たちから主の恵みにゆだねられて出発した。","tok":[["
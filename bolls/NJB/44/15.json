,["の"],["幕屋","まくや"],["を"],["建て直す","たてなおす"],["。"],["すなわち"],["、"],["廃墟","はいきょ"],["と"],["化した","かした"],["幕屋","まくや"],["を"],["建て直し","たてなおし"],["、"],["それ"],["を"],["元どおり","もとどおり"],["に"],["する"],["。"]]},{"verse":17,"text":"それは、残った人々、すなわち、わたしの名で呼ばれる異邦人がみな、主を求めるようになるためである。","tok":[["それ"],["は"],["、"],["残った","のこった"],["人々","ひとびと"],["、"],["すなわち"],["、"],["わたし"],["の"],["名","な"],["で"],["呼ばれる","よばれる"],["異邦人","いほうじん"],["が"],["みな"],["、"],["主","ぬし"],["を"],["求める","もとめる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":18,"text":"大昔からこれらのことを知らせておられる主が、こう言われる。』","tok":[["大昔","おおむかし"],["から"],["これ"],["ら"],["の"],["こと"],["を"],["知らせて","しらせて"],["おられる"],["主","ぬし"],["が"],["、"],["こう"],["言われる","いわれる"],["。"],["』"]]},{"verse":19,"text":"そこで、私の判断では、神に立ち返る異邦人を悩ませてはいけません。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["の"],["判断","はんだん"],["で"],["は"],["、"],["神","かみ"],["に"],["立ち返る","たちかえる"],["異邦人","いほうじん"],["を"],["悩ませて","なやませて"],["は"],["いけません"],["。"]]},{"verse":20,"text":"ただ、偶像に供えて汚れた物と不品行と絞め殺した物と血とを避けるように書き送るべきだと思います。","tok":[["ただ"],["、"],["偶像","ぐうぞう"],["に"],["供えて","そなえて"],["汚れた","よごれた"],["物","もの"],["と"],["不品行","ふひんこう"],["と"],["絞め殺した","しめころした"],["物","もの"],["と"],["血","ち"],["と"],["を"],["避ける","さける"],["よう"],["に"],["書き送るべきだ","かきおくるべきだ"],["と"],["思います","おもいます"],["。"]]},{"verse":21,"text":"昔から、町ごとにモーセの律法を宣べる者がいて、それが安息日ごとに諸会堂で読まれているからです。」","tok":[["昔","むかし"],["から"],["、"],["町","まち"],["ごと"],["に"],["モーセ"],["の"],["律法","りっぽう"],["を"],["宣べる","のべる"],["者","もの"],["が"],["いて"],["、"],["それ"],["が"],["安息日","あんそくび"],["ごと"],["に"],["諸","しょ"],["会堂","かいどう"],["で"],["読まれて","よまれて"],["いる"],["から"],["です"],["。"],["」"]]},{"verse":22,"text":"そこで使徒たちと長老たち、また、全教会もともに、彼らの中から人を選んで、パウロやバルナバといっしょにアンテオケへ送ることを決議した。選ばれたのは兄弟たちの中の指導者たちで、バルサバと呼ばれるユダおよびシラスであった。","tok":[["そこ"],["で"],["使徒","しと"],["たち"],["と"],["長老","ちょうろう"],["たち"],["、"],["また"],["、"],["全教","ぜんきょう"],["会","かい"],["も"],["とも"],["に"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["から"],["人","ひと"],["を"],["選んで","えらんで"],["、"],["パウロ"],["や"],["バルナバ"],["と"],["いっしょ"],["に"],["アンテオケ"],["へ"],["送る","おくる"],["こと"],["を"],["決議","けつぎ"],["した"],["。"],["選ばれた","えらばれた"],["の"],["は"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["の"],["指導者","しどうしゃ"],["たち"],["で"],["、"],["バルサバ"],["と"],["呼ばれる","よばれる"],["ユダ"],["および"],["シラス"],["で"],["あった"],["。"]]},{"verse":23,"text":"彼らはこの人たちに託して、こう書き送った。「兄弟である使徒および長老たちは、アンテオケ、シリヤ、キリキヤにいる異邦人の兄弟たちに、あいさつをいたします。","tok":[["彼","かれ"],["ら"],["は"],["この"],["人","ひと"],["たち"],["に"],["託して","たくして"],["、"],["こう"],["書き送った","かきおくった"],["。"],["「"],["兄弟","きょうだい"],["で"],["ある"],["使徒","しと"],["および"],["長老","ちょうろう"],["たち"],["は"],["、"],["アンテオケ"],["、"],["シリヤ"],["、"],["キリキヤ"],["に"],["いる"],["異邦人","いほうじん"],["の"],["兄弟","きょうだい"],["たち"],["に"],["、"],["あいさつ"],["を"],["いたします"],["。"]]},{"verse":24,"text":"私たちの中のある者たちが、私たちからは何も指示を受けていないのに、いろいろなことを言ってあなたがたを動揺させ、あなたがたの心を乱したことを聞きました。","tok":[["私たち","わたしたち"],["の"],["中","なか"],["の"],["ある"],["者","もの"],["たち"],["が"],["、"],["私たち","わたしたち"],["から"],["は"],["何","なん"],["も"],["指示","しじ"],["を"],["受けて","うけて"],["いない"],["のに"],["、"],["いろいろ"],["な"],["こと"],["を"],["言って","いって"],["あなた"],["がた"],["を"],["動揺","どうよう"],["させ"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["乱した","みだした"],["こと"],["を"],["聞きました","ききました"],["。"]]},{"verse":25,"text":"そこで、私たちは人々を選び、私たちの愛するバルナバおよびパウロといっしょに、あなたがたのところへ送ることに衆議一決しました。","tok":[["そこ"],["で"],["、"],["私たち","わたしたち"],["は"],["人々","ひとびと"],["を"],["選び","えらび"],["、"],["私たち","わたしたち"],["の"],["愛する","あいする"],["バルナバ"],["および"],["パウロ"],["と"],["いっしょ"],["に"],["、"],["あなた"],["がた"],["の"],["ところ"],["へ"],["送る","おくる"],["こと"],["に"],["衆議","しゅうぎ"],["一決","いっけつ"],["しました"],["。"]]},{"verse":26,"text":"このバルナバとパウロは、私たちの主イエス・キリストの御名のために、いのちを投げ出した人たちです。","tok":[["この"],["バルナバ"],["と"],["パウロ"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["、"],["いのち"],["を"],["投げ出した","なげだした"],["人","ひと"],["たち"],["です"],["。"]]},{"verse":27,"text":"こういうわけで、私たちはユダとシラスを送りました。彼らは口頭で同じ趣旨のことを伝えるはずです。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["私たち","わたしたち"],["は"],["ユダ"],["と"],["シラス"],["を"],["送りました","おくりました"],["。"],["彼","かれ"],["ら"],["は"],["口頭","こうとう"],["で"],["同じ","お
[{"verse":1,"text":"彼らはアムピポリスとアポロニヤを通って、テサロニケへ行った。そこには、ユダヤ人の会堂があった。","tok":[["彼","かれ"],["ら"],["は"],["アムピポリス"],["と"],["アポロニヤ"],["を"],["通って","とおって"],["、"],["テサロニケ"],["へ"],["行った","いった"],["。"],["そこ"],["に"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["会堂","かいどう"],["が"],["あった"],["。"]]},{"verse":2,"text":"パウロはいつもしているように、会堂に入って行って、三つの安息日にわたり、聖書に基づいて彼らと論じた。","tok":[["パウロ"],["は"],["いつも"],["して"],["いる"],["よう"],["に"],["、"],["会堂","かいどう"],["に"],["入って","はいって"],["行って","いって"],["、"],["三","みっ"],["つ"],["の"],["安息日","あんそくび"],["に"],["わたり"],["、"],["聖書","せいしょ"],["に"],["基づいて","もとづいて"],["彼","かれ"],["ら"],["と"],["論じた","ろんじた"],["。"]]},{"verse":3,"text":"そして、キリストは苦しみを受け、死者の中からよみがえらなければならないことを説明し、また論証して、「私があなたがたに伝えているこのイエスこそ、キリストなのです」と言った。","tok":[["そして"],["、"],["キリスト"],["は"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらなければ"],["ならない"],["こと"],["を"],["説明","せつめい"],["し"],["、"],["また"],["論証","ろんしょう"],["して"],["、"],["「"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["伝えて","つたえて"],["いる"],["この"],["イエス"],["こそ"],["、"],["キリスト"],["な"],["の"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"彼らのうちの幾人かはよくわかって、パウロとシラスに従った。またほかに、神を敬うギリシヤ人が大ぜいおり、貴婦人たちも少なくなかった。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["幾人","いくにん"],["か"],["は"],["よく"],["わかって"],["、"],["パウロ"],["と"],["シラス"],["に"],["従った","したがった"],["。"],["また"],["ほか"],["に"],["、"],["神","かみ"],["を"],["敬う","うやまう"],["ギリシヤ"],["人","にん"],["が"],["大ぜい","おおぜい"],["おり"],["、"],["貴婦人","きふじん"],["たち"],["も"],["少なく","すくなく"],["なかった"],["。"]]},{"verse":5,"text":"ところが、ねたみにかられたユダヤ人は、町のならず者をかり集め、暴動を起こして町を騒がせ、またヤソンの家を襲い、ふたりを人々の前に引き出そうとして捜した。","tok":[["ところ"],["が"],["、"],["ねたみ"],["に"],["かられた"],["ユダヤ人","ゆだやじん"],["は"],["、"],["町","まち"],["の"],["ならず者","ならずもの"],["を"],["かり集め","かりあつめ"],["、"],["暴動","ぼうどう"],["を"],["起こして","おこして"],["町","まち"],["を"],["騒がせ","さわがせ"],["、"],["また"],["ヤソン"],["の"],["家","いえ"],["を"],["襲い","おそい"],["、"],["ふたり"],["を"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["引き出そう","ひきだそう"],["として"],["捜した","さがした"],["。"]]},{"verse":6,"text":"しかし、見つからないので、ヤソンと兄弟たちの幾人かを、町の役人たちのところへひっぱって行き、大声でこう言った。「世界中を騒がせて来た者たちが、ここにも入り込んでいます。","tok":[["しかし"],["、"],["見つからない","みつからない"],["ので"],["、"],["ヤソン"],["と"],["兄弟","きょうだい"],["たち"],["の"],["幾人","いくにん"],["か"],["を"],["、"],["町","まち"],["の"],["役人","やくにん"],["たち"],["の"],["ところ"],["へ"],["ひっぱって"],["行き","いき"],["、"],["大声","おおごえ"],["で"],["こう"],["言った","いった"],["。"],["「"],["世界中","せかいじゅう"],["を"],["騒がせて","さわがせて"],["来た","きた"],["者","もの"],["たち"],["が"],["、"],["ここ"],["に"],["も"],["入り込んで","はいりこんで"],["います"],["。"]]},{"verse":7,"text":"それをヤソンが家に迎え入れたのです。彼らはみな、イエスという別の王がいると言って、カイザルの詔勅にそむく行いをしているのです。」","tok":[["それ"],["を"],["ヤソン"],["が"],["家","いえ"],["に"],["迎え入れた","むかえいれた"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["イエス"],["と"],["いう"],["別","べつ"],["の"],["王","おう"],["が"],["いる"],["と"],["言って","いって"],["、"],["カイザル"],["の"],["詔勅","しょうちょく"],["に"],["そむく"],["行い","おこない"],["を"],["して"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":8,"text":"こうして、それを聞いた群衆と町の役人たちとを不安に陥れた。","tok":[["こう"],["して"],["、"],["それ"],["を"],["聞いた","きいた"],["群衆","ぐんしゅう"],["と"],["町","まち"],["の"],["役人","やくにん"],["たち"],["と"],["を"],["不安","ふあん"],["に"],["陥れた","おとしいれた"],["。"]]},{"verse":9,"text":"彼らは、ヤソンとそのほかの者たちから保証金を取ったうえで釈放した。","tok":[["彼","かれ"],["ら"],["は"],["、"],["ヤソン"],["と"],["その"],["ほか"],["の"],["者","もの"],["たち"],["から"],["保証金","ほしょうきん"],["を"],["取った","とった"],["うえ"],["で"],["釈放","しゃくほう"],["した"],["。"]]},{"verse":10,"text":"兄弟たちは、すぐさま、夜のうちにパウロとシラスをベレヤへ送り出した。ふたりはそこに着くと、ユダヤ人の会堂に入って行った。","tok":[["兄弟","きょうだい"],["たち"],["は"],["、"],["すぐさま"],["、"],["夜","よる"],["の"],["うち"],["に"],["パウロ"],["と"],["シラス"],["を"],["ベレヤ"],["へ"],["送り出した","おくりだした"],["。"],["ふたり"],["は"],["そこ"],["に"],["着く","つく"],["と"],["、"],["ユダヤ人","ゆだやじん"],["の"],["会堂","かいどう"],["に"],["入って","はいって"],["行った","いった"],["。"]]},{"verse":11,"text":"ここのユダヤ人は、テサロニケにいる者たちよりも良い人たちで、非常に熱心にみことばを聞き、はたしてそのとおりかどうかと毎日聖書を調べた。","tok":[["ここ"],["の"],["ユダヤ人","ゆだやじん"],["は"],["、"],["テサロニケ"],["に"],["いる"],["者","もの"],["たち"],["より"],["も"],["良い","よい"],["人","ひと"],["たち"],["で"],["、"],["非常","ひじょう"],["に"],["熱心","ねっしん"],["に"],["みことば"],["を"],["聞き","きき"],["、"],["はたして"],["その"],["とおり"],["か"],["どう"],["か"],["と"],["毎日","まいにち"],["聖書","せいしょ"],["を"],["調べた","しらべた"],["。"]]},{"verse":12,"text":"そのため、彼らのうちの多くの者が信仰に入った。その中にはギリシヤの貴婦人や男子も少なくなかった。","tok":[["その"],["ため"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["多く","おおく"],["の"],["者","もの"],["が"],["信仰","しんこう"],["に"],["入った","はいった"],["。"],["その"],["中","なか"],["に"],["は"],["ギリシヤ"],["の"],["貴婦人","きふじん"],["や"],["男子","だんし"],["も"],["少なく","すくなく"],["なかった"],["。"]]},{"verse":13,"text":"ところが、テサロニケのユダヤ人たちは、パウロがベレヤでも神のことばを伝えていることを知り、ここにもやって来て、群衆を扇動して騒ぎを起こした。","tok":[["ところ"],["が"],["、"],["テサロニケ"],["の"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["パウロ"],["が"],["ベレヤ"],["で"],["も"],["神","かみ"],["の"],["ことば"],["を"],["伝えて","つたえて"],["いる"],["こと"],["を"],["知り","しり"],["、"],["ここ"],["に"],["も"],["やって"],["来て","きて"],["、"],["群衆","ぐんしゅう"],["を"],["扇動","せんどう"],["して"],["騒ぎ","さわぎ"],["を"],["起こした","おこした"],["。"]]},{"verse":14,"text":"そこで兄弟たちは、ただちにパウロを送り出して海べまで行かせたが、シラスとテモテはベレヤに踏みとどまった。","tok":[["そこ"],["で"],["兄弟","きょうだい"],["たち"],["は"],["、"],["ただちに"],["パウロ"],["を"],["送り出して","おくりだして"],["海べ","うみべ"],["まで"],["行かせた","いかせた"],["が"],["、"],["シラス"],["と"],["テモテ"],["は"],["ベレヤ"],["に"],["踏みとどまった","ふみとどまった"],["。"]]},{"verse":15,"text":"パウロを案内した人たちは、彼をアテネまで連れて行った。そしてシラスとテモテに一刻も早く来るように、という命令を受けて、帰って行った。","tok":[["パウロ"],["を"],["案内","あんない"],["した"],["人","ひと"],["たち"],["は"],["、"],["彼","かれ"],["を"],["アテネ"],["まで"],["連れて","つれて"],["行った","いった"],["。"],["そして"],["シラス"],["と"],["テモテ"],["に"],["一刻","いっこく"],["も"],["早く","はやく"],["来る","くる"],["よう"],["に"],["、"],["と"],["いう"],["命令","めいれい"],["を"],["受けて","うけて"],["、"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":16,"text":"さて、アテネでふたりを待っていたパウロは、町が偶像でいっぱいなのを見て、心に憤りを感じた。","tok":[["さて"],["、"],["アテネ"],["で"],["ふたり"],["を"],["待って","まって"],["いた"],["パウロ"],["は"],["、"],["町","まち"],["が"],["偶像","ぐうぞう"],["で"],["いっぱい"],["な"],["の"],["を"],["見て","みて"],["、"],["心","こころ"],["に"],["憤り","いきどおり"],["を"],["感じた","かんじた"],["。"]]},{"verse":17,"text":"そこでパウロは、会堂ではユダヤ人や神を敬う人たちと論じ、広場では毎日そこに居合わせた人たちと論じた。","tok":[["そこ"],["で"],["パウロ"],["は"],["、"],["会堂","かいどう"],["で"],["は"],["ユダヤ人","ゆだやじん"],["や"],["神","かみ"],["を"],["敬う","うやまう"],["人","ひと"],["たち"],["と"],["論じ","ろんじ"],["、"],["広場","ひろば"],["で"],["は"],["毎日","まいにち"],["そこ"],["に"],["居合わせた","いあわせた"],["人","ひと"],["たち"],["と"],["論じた","ろんじた"],["。"]]},{"verse":18,"text":"エピクロス派とストア派の哲学者たちも幾人かいて、パウロと論じ合っていたが、その中のある者たちは、「このおしゃべりは、何を言うつもりなのか」と言い、ほかの者たちは、「彼は外国の神々を伝えているらしい」と言った。パウロがイエスと復活とを宣べ伝えたからである。","tok":[["エピクロス"],["派","は"],["と"],["ストア派","すとあは"],["の"],["哲学者","てつがくしゃ"],["たち"],["も"],["幾人","いくにん"],["かいて"],["、"],["パウロ"],["と"],["論じ合って","ろんじあって"],["いた"],["が"],["、"],["その"],["中","なか"],["の"],["ある"],["者","もの"],["たち"],["は"],["、"],["「"],["この"],["おしゃべり"],["は"],["、"],["何","なん"],["を"],["言う","いう"],["つもり"],["な"],["の"],["か"],["」"],["と"],["言い","いい"],["、"],["ほか"],["の"],["者","もの"],["たち"],["は"],["、"],["「"],["彼","かれ"],["は"],["外国","がいこく"],["の"],["神々","かみがみ"],["を"],["伝えて","つたえて"],["いるらしい"],["」"],["と"],["言った","いった"],["。"],["パウロ"],["が"],["イエス"],["と"],["復活","ふっかつ"],["と"],["を"],["宣べ伝えた","のべつたえた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"そこで彼らは、パウロをアレオパゴスに連れて行ってこう言った。「あなたの語っているその新しい教えがどんなものであるか、知らせていただけませんか。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["パウロ"],["を"],["アレオパゴス"],["に"],["連れて","つれて"],["行って","いって"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["の"],["語って","かたって"],["いる"],["その"],["新しい","あたらしい"],["教え","おしえ"],["が"],["どんな"],["もの"],["で"],["ある"],["か"],["、"],["知らせて","しらせて"],["いただけません"],["か"],["。"]]},{"verse":20,"text":"私たちにとっては珍しいことを聞かせてくださるので、それがいったいどんなものか、私たちは知りたいのです。」","tok":[["私たち","わたしたち"],["にとって"],["は"],["珍しい","めずらしい"],["こと"],["を"],["聞かせて","きかせて"],["くださる"],["ので"],["、"],["それ"],["が"],["いったい"],["どんな"],["もの"],["か"],["、"],["私たち","わたしたち"],["は"],["知りたい","しりたい"],["の"],["です"],["。"],["」"]]},{"verse":21,"text":"アテネ人も、そこに住む外国人もみな、何か耳新しいことを話したり、聞いたりすることだけで、日を過ごしていた。","tok":[["アテネ人","あてねにん"],["も"],["、"],["そこ"],["に"],["住む","すむ"],["外国人","がいこくじん"],["も"],["みな"],["、"],["何","なん"],["か"],["耳新しい","みみあたらしい"],["こと"],["を"],["話し","はなし"],["たり"],["、"],["聞い","きい"],["たり"],["する"],["こと"],["だけ"],["で"],["、"],["日","ひ"],["を"],["過ごして","すごして"],["いた"],["。"]]},{"verse":22,"text":"そこでパウロは、アレオパゴスの真ん中に立って言った。「アテネの人たち。あらゆる点から見て、私はあなたがたを宗教心にあつい方々だと見ております。","tok":[["そこ"],["で"],["パウロ"],["は"],["、"],["アレオパゴス"],["の"],["真ん中","まんなか"],["に"],["立って","たって"],["言った","いった"],["。"],["「"],["アテネ"],["の"],["人","ひと"],["たち"],["。"],["あらゆる"],["点","てん"],["から"],["見て","みて"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["を"],["宗教心","しゅうきょうしん"],["に"],["あつい"],["方々","かたがた"],["だ"],["と"],["見て","みて"],["おります"],["。"]]},{"verse":23,"text":"私が道を通りながら、あなたがたの拝むものをよく見ているうちに、『知られない神に』と刻まれた祭壇があるのを見つけました。そこで、あなたがたが知らずに拝んでいるものを、教えましょう。","tok":[["私","わたくし"],["が"],["道","みち"],["を"],["通り","とおり"],["ながら"],["、"],["あなた"],["がた"],["の"],["拝む","おがむ"],["もの"],["を"],["よく"],["見て","みて"],["いる"],["うち"],["に"],["、"],["『"],["知られない","しられない"],["神","かみ"],["に"],["』"],["と"],["刻まれた","きざまれた"],["祭壇","さいだん"],["が"],["ある"],["の"],["を"],["見つけました","みつけました"],["。"],["そこ"],["で"],["、"],["あなた"],["がた"],["が"],["知らず","しらず"],["に"],["拝んで","おがんで"],["いる"],["もの"],["を"],["、"],["教えましょう","おしえましょう"],["。"]]},{"verse":24,"text":"この世界とその中にあるすべてのものをお造りになった神は、天地の主ですから、手でこしらえた宮などにはお住みになりません。","tok":[["この"],["世界","せかい"],["と"],["その"],["中","なか"],["に"],["ある"],["すべて"],["の"],["もの"],["を"],["お造り","おつくり"],["に"],["なった"],["神","かみ"],["は"],["、"],["天地","てんち"],["の"],["主","ぬし"],["です"],["から"],["、"],["手","て"],["で"],["こしらえた"],["宮","みや"],["など"],["に"],["は"],["お住み","おすみ"],["に"],["なりません"],["。"]]},{"verse":25,"text":"また、何かに不自由なことでもあるかのように、人の手によって仕えられる必要はありません。神は、すべての人に、いのちと息と万物とをお与えになった方だからです。","tok":[["また"],["、"],["何","なん"],["か"],["に"],["不自由","ふじゆう"],["な"],["こと"],["で"],["も"],["ある"],["か"],["の"],["よう"],["に"],["、"],["人","ひと"],["の"],["手","て"],["によって"],["仕えられる","つかえられる"],["必要","ひつよう"],["は"],["ありません"],["。"],["神","かみ"],["は"],["、"],["すべて"],["の"],["人","ひと"],["に"],["、"],["いのち"],["と"],["息","いき"],["と"],["万物","ばんぶつ"],["と"],["を"],["お与え","おあたえ"],["に"],["なった"],["方","ほう"],["だ"],["から"],["です"],["。"]]},{"verse":26,"text":"神は、ひとりの人からすべての国の人々を造り出して、地の全面に住まわせ、それぞれに決められた時代と、その住まいの境界とをお定めになりました。","tok":[["神","かみ"],["は"],["、"],["ひとり"],["の"],["人","ひと"],["から"],["すべて"],["の"],["国","くに"],["の"],["人々","ひとびと"],["を"],["造り出して","つくりだして"],["、"],["地","ち"],["の"],["全面","ぜんめん"],["に"],["住まわせ","すまわせ"],["、"],["それぞれ"],["に"],["決められた","きめられた"],["時代","じだい"],["と"],["、"],["その"],["住まい","すまい"],["の"],["境界","きょうかい"],["と"],["を"],["お定め","おさだめ"],["に"],["なりました"],["。"]]},{"verse":27,"text":"これは、神を求めさせるためであって、もし探り求めることでもあるなら、神を見いだすこともあるのです。確かに、神は、私たちひとりひとりから遠く離れてはおられません。","tok":[["これ"],["は"],["、"],["神","かみ"],["を"],["求め","もとめ"],["させる"],["ため"],["で"],["あって"],["、"],["もし"],["探り求める","さぐりもとめる"],["こと"],["で"],["も"],["あるなら"],["、"],["神","かみ"],["を"],["見いだす","みいだす"],["こと"],["も"],["ある"],["の"],["です"],["。"],["確か","たしか"],["に"],["、"],["神","かみ"],["は"],["、"],["私たち","わたしたち"],["ひとりひとり"],["から"],["遠く","とおく"],["離れて","はなれて"],["は"],["おられません"],["。"]]},{"verse":28,"text":"私たちは、神の中に生き、動き、また存在しているのです。あなたがたのある詩人たちも、『私たちもまたその子孫である』と言ったとおりです。","tok":[["私たち","わたしたち"],["は"],["、"],["神","かみ"],["の"],["中","なか"],["に"],["生き","いき"],["、"],["動き","うごき"],["、"],["また"],["存在","そんざい"],["して"],["いる"],["の"],["です"],["。"],["あなた"],["がた"],["の"],["ある"],["詩人","しじん"],["たち"],["も"],["、"],["『"],["私たち","わたしたち"],["も"],["また"],["その"],["子孫","しそん"],["で"],["ある"],["』"],["と"],["言った","いった"],["とおり"],["です"],["。"]]},{"verse":29,"text":"そのように私たちは神の子孫ですから、神を、人間の技術や工夫で造った金や銀や石などの像と同じものと考えてはいけません。","tok":[["その"],["よう"],["に"],["私たち","わたしたち"],["は"],["神","かみ"],["の"],["子孫","しそん"],["です"],["から"],["、"],["神","かみ"],["を"],["、"],["人間","にんげん"],["の"],["技術","ぎじゅつ"],["や"],["工夫","くふう"],["で"],["造った","つくった"],["金","かね"],["や"],["銀","ぎん"],["や"],["石","いし"],["など"],["の"],["像","ぞう"],["と"],["同じ","おなじ"],["もの"],["と"],["考えて","かんがえて"],["は"],["いけません"],["。"]]},{"verse":30,"text":"神は、そのような無知の時代を見過ごしておられましたが、今は、どこででもすべての人に悔い改めを命じておられます。","tok":[["神","かみ"],["は"],["、"],["その"],["よう"],["な"],["無知","むち"],["の"],["時代","じだい"],["を"],["見過ごして","みすごして"],["おられました"],["が"],["、"],["今","いま"],["は"],["、"],["どこ"],["で"],["で"],["も"],["すべて"],["の"],["人","ひと"],["に"],["悔い改め","くいあらため"],["を"],["命じて","めいじて"],["おられます"],["。"]]},{"verse":31,"text":"なぜなら、神は、お立てになったひとりの人により義をもってこの世界をさばくため、日を決めておられるからです。そして、その方を死者の中からよみがえらせることによって、このことの確証をすべての人にお与えになったのです。」","tok":[["なぜ"],["なら"],["、"],["神","かみ"],["は"],["、"],["お立て","おたて"],["に"],["なった"],["ひとり"],["の"],["人","ひと"],["に"],["より"],["義","ぎ"],["を"],["もって"],["この"],["世界","せかい"],["を"],["さばく"],["ため"],["、"],["日","ひ"],["を"],["決めて","きめて"],["おられる"],["から"],["です"],["。"],["そして"],["、"],["その"],["方","ほう"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせる"],["こと"],["によって"],["、"],["この"],["こと"],["の"],["確証","かくしょう"],["を"],["すべて"],["の"],["人","ひと"],["に"],["お与え","おあたえ"],["に"],["なった"],["の"],["です"],["。"],["」"]]},{"verse":32,"text":"死者の復活のことを聞くと、ある者たちはあざ笑い、ほかの者たちは、「このことについては、またいつか聞くことにしよう」と言った。","tok":[["死者","ししゃ"],["の"],["復活","ふっかつ"],["の"],["こと"],["を"],["聞く","きく"],["と"],["、"],["ある"],["者","もの"],["たち"],["は"],["あざ笑い","あざわらい"],["、"],["ほか"],["の"],["者","もの"],["たち"],["は"],["、"],["「"],["この"],["こと"],["について"],["は"],["、"],["また"],["いつ"],["か"],["聞く","きく"],["こと"],["に"],["しよう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":33,"text":"こうして、パウロは彼らの中から出て行った。","tok":[["こう"],["して"],["、"],["パウロ"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["から"],["出て","でて"],["行った","いった"],["。"]]},{"verse":34,"text":"しかし、彼につき従って信仰に入った人たちもいた。それは、アレオパゴスの裁判官デオヌシオ、ダマリスという女、その他の人々であった。","tok":[["しかし"],["、"],["彼","かれ"],["に"],["つき従って","つきしたがって"],["信仰","しんこう"],["に"],["入った","はいった"],["人","ひと"],["たち"],["も"],["いた"],["。"],["それ"],["は"],["、"],["アレオパゴス"],["の"],["裁判官","さいばんかん"],["デオヌシオ"],["、"],["ダマリス"],["と"],["いう"],["女","おんな"],["、"],["その"],["他","た"],["の"],["人々","ひとびと"],["で"],["あった"],["。"]]}]
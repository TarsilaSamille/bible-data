[{"verse":1,"text":"こうして救われてから、私たちは、ここがマルタと呼ばれる島であることを知った。","tok":[["こう"],["して"],["救われて","すくわれて"],["から"],["、"],["私たち","わたしたち"],["は"],["、"],["ここ"],["が"],["マルタ"],["と"],["呼ばれる","よばれる"],["島","しま"],["で"],["ある"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":2,"text":"島の人々は私たちに非常に親切にしてくれた。おりから雨が降りだして寒かったので、彼らは火をたいて私たちみなをもてなしてくれた。","tok":[["島","しま"],["の"],["人々","ひとびと"],["は"],["私たち","わたしたち"],["に"],["非常","ひじょう"],["に"],["親切","しんせつ"],["に"],["して"],["くれた"],["。"],["おり"],["から"],["雨","あめ"],["が"],["降り","ふり"],["だして"],["寒かった","さむかった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["火","ひ"],["を"],["たいて"],["私たち","わたしたち"],["みな"],["を"],["もてなして"],["くれた"],["。"]]},{"verse":3,"text":"パウロがひとかかえの柴をたばねて火にくべると、熱気のために、一匹のまむしがはい出して来て、彼の手に取りついた。","tok":[["パウロ"],["が"],["ひとかかえ"],["の"],["柴","しば"],["を"],["たばねて"],["火","ひ"],["に"],["くべる"],["と"],["、"],["熱気","ねっき"],["の"],["ため"],["に"],["、"],["一匹","いちひき"],["の"],["まむし"],["が"],["はい出して","はいだして"],["来て","きて"],["、"],["彼","かれ"],["の"],["手","て"],["に"],["取りついた","とりついた"],["。"]]},{"verse":4,"text":"島の人々は、この生き物がパウロの手から下がっているのを見て、「この人はきっと人殺しだ。海からはのがれたが、正義の女神はこの人を生かしてはおかないのだ」と互いに話し合った。","tok":[["島","しま"],["の"],["人々","ひとびと"],["は"],["、"],["この"],["生き物","いきもの"],["が"],["パウロ"],["の"],["手","て"],["から"],["下がって","さがって"],["いる"],["の"],["を"],["見て","みて"],["、"],["「"],["この"],["人","ひと"],["は"],["きっと"],["人殺し","ひとごろし"],["だ"],["。"],["海","うみ"],["から"],["は"],["のがれた"],["が"],["、"],["正義","せいぎ"],["の"],["女神","めがみ"],["は"],["この"],["人","ひと"],["を"],["生かして","いかして"],["は"],["おかない"],["の"],["だ"],["」"],["と"],["互い","たがい"],["に"],["話し合った","はなしあった"],["。"]]},{"verse":5,"text":"しかし、パウロは、その生き物を火の中に振り落として、何の害も受けなかった。","tok":[["しかし"],["、"],["パウロ"],["は"],["、"],["その"],["生き物","いきもの"],["を"],["火","ひ"],["の"],["中","なか"],["に"],["振り落として","ふりおとして"],["、"],["何","なん"],["の"],["害","がい"],["も"],["受けなかった","うけなかった"],["。"]]},{"verse":6,"text":"島の人々は、彼が今にも、はれ上がって来るか、または、倒れて急死するだろうと待っていた。しかし、いくら待っても、彼に少しも変わった様子が見えないので、彼らは考えを変えて、「この人は神さまだ」と言いだした。","tok":[["島","しま"],["の"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["が"],["今","いま"],["に"],["も"],["、"],["はれ上がって","はれあがって"],["来る","くる"],["か"],["、"],["また"],["は"],["、"],["倒れて","たおれて"],["急死","きゅうし"],["するだろう"],["と"],["待って","まって"],["いた"],["。"],["しかし"],["、"],["いくら"],["待って","まって"],["も"],["、"],["彼","かれ"],["に"],["少し","すこし"],["も"],["変わった","かわった"],["様子","ようす"],["が"],["見えない","みえない"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["考え","かんがえ"],["を"],["変えて","かえて"],["、"],["「"],["この"],["人","ひと"],["は"],["神","かみ"],["さま"],["だ"],["」"],["と"],["言い","いい"],["だした"],["。"]]},{"verse":7,"text":"さて、その場所の近くに、島の首長でポプリオという人の領地があった。彼はそこに私たちを招待して、三日間手厚くもてなしてくれた。","tok":[["さて"],["、"],["その"],["場所","ばしょ"],["の"],["近く","ちかく"],["に"],["、"],["島","しま"],["の"],["首長","しゅちょう"],["で"],["ポプリオ"],["と"],["いう"],["人","ひと"],["の"],["領地","りょうち"],["が"],["あった"],["。"],["彼","かれ"],["は"],["そこ"],["に"],["私たち","わたしたち"],["を"],["招待","しょうたい"],["して"],["、"],["三","みっ"],["日間","かかん"],["手厚く","てあつく"],["もてなして"],["くれた"],["。"]]},{"verse":8,"text":"たまたまポプリオの父が、熱病と下痢とで床に着いていた。そこでパウロは、その人のもとに行き、祈ってから、彼の上に手を置いて直してやった。","tok":[["たまたま"],["ポプリオ"],["の"],["父","ちち"],["が"],["、"],["熱病","ねつびょう"],["と"],["下痢","げり"],["と"],["で"],["床","ゆか"],["に"],["着いて","ついて"],["いた"],["。"],["そこ"],["で"],["パウロ"],["は"],["、"],["その"],["人","ひと"],["の"],["もと"],["に"],["行き","いき"],["、"],["祈って","いのって"],["から"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置いて","おいて"],["直して","なおして"],["やった"],["。"]]},{"verse":9,"text":"このことがあってから、島のほかの病人たちも来て、直してもらった。","tok":[["この"],["こと"],["が"],["あって"],["から"],["、"],["島","しま"],["の"],["ほか"],["の"],["病人","びょうにん"],["たち"],["も"],["来て","きて"],["、"],["直して","なおして"],["もらった"],["。"]]},{"verse":10,"text":"それで彼らは、私たちを非常に尊敬し、私たちが出帆するときには、私たちに必要な品々を用意してくれた。","tok":[["それ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["私たち","わたしたち"],["を"],["非常","ひじょう"],["に"],["尊敬","そんけい"],["し"],["、"],["私たち","わたしたち"],["が"],["出帆","しゅっぱん"],["する"],["とき"],["に"],["は"],["、"],["私たち","わたしたち"],["に"],["必要","ひつよう"],["な"],["品々","しなじな"],["を"],["用意","ようい"],["して"],["くれた"],["。"]]},{"verse":11,"text":"三か月後に、私たちは、この島で冬を過ごしていた、船首にデオスクロイの飾りのある、アレキサンドリヤの船で出帆した。","tok":[["三","さん"],["か月後","かげつご"],["に"],["、"],["私たち","わたしたち"],["は"],["、"],["この"],["島","しま"],["で"],["冬","ふゆ"],["を"],["過ごして","すごして"],["いた"],["、"],["船首","せんしゅ"],["に"],["デオスクロイ"],["の"],["飾り","かざり"],["の"],["ある"],["、"],["アレキサンドリヤ"],["の"],["船","ふね"],["で"],["出帆","しゅっぱん"],["した"],["。"]]},{"verse":12,"text":"シラクサに寄港して、三日間とどまり、","tok":[["シラクサ"],["に"],["寄港","きこう"],["して"],["、"],["三","みっ"],["日間","かかん"],["とどまり"],["、"]]},{"verse":13,"text":"そこから回って、レギオンに着いた。一日たつと、南風が吹き始めたので、二日目にはポテオリに入港した。","tok":[["そこ"],["から"],["回って","まわって"],["、"],["レギオン"],["に"],["着いた","ついた"],["。"],["一","いち"],["日","にち"],["たつ"],["と"],["、"],["南風","はえ"],["が"],["吹き","ふき"],["始めた","はじめた"],["ので"],["、"],["二日目","ふたかめ"],["に"],["は"],["ポテオリ"],["に"],["入港","にゅうこう"],["した"],["。"]]},{"verse":14,"text":"ここで、私たちは兄弟たちに会い、勧められるままに彼らのところに七日間滞在した。こうして、私たちはローマに到着した。","tok":[["ここ"],["で"],["、"],["私たち","わたしたち"],["は"],["兄弟","きょうだい"],["たち"],["に"],["会い","あい"],["、"],["勧められる","すすめられる"],["まま"],["に"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["七","なな"],["日間","かかん"],["滞在","たいざい"],["した"],["。"],["こう"],["して"],["、"],["私たち","わたしたち"],["は"],["ローマ"],["に"],["到着","とうちゃく"],["した"],["。"]]},{"verse":15,"text":"私たちのことを聞いた兄弟たちは、ローマからアピオ・ポロとトレス・タベルネまで出迎えに来てくれた。パウロは彼らに会って、神に感謝し、勇気づけられた。","tok":[["私たち","わたしたち"],["の"],["こと"],["を"],["聞いた","きいた"],["兄弟","きょうだい"],["たち"],["は"],["、"],["ローマ"],["から"],["アピオ"],["・"],["ポロ"],["と"],["トレス"],["・"],["タベルネ"],["まで"],["出迎え","でむかえ"],["に"],["来て","きて"],["くれた"],["。"],["パウロ"],["は"],["彼","かれ"],["ら"],["に"],["会って","あって"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["、"],["勇気","ゆうき"],["づけられた"],["。"]]},{"verse":16,"text":"私たちがローマに入ると、パウロは番兵付きで自分だけの家に住むことが許された。","tok":[["私たち","わたしたち"],["が"],["ローマ"],["に"],["入る","はいる"],["と"],["、"],["パウロ"],["は"],["番兵付き","ばんぺいつき"],["で"],["自分","じぶん"],["だけ"],["の"],["家","いえ"],["に"],["住む","すむ"],["こと"],["が"],["許された","ゆるされた"],["。"]]},{"verse":17,"text":"三日の後、パウロはユダヤ人のおもだった人たちを呼び集め、彼らが集まったときに、こう言った。「兄弟たち。私は、私の国民に対しても、先祖の慣習に対しても、何一つそむくことはしていないのに、エルサレムで囚人としてローマ人の手に渡されました。","tok":[["三日","みっか"],["の"],["後","あと"],["、"],["パウロ"],["は"],["ユダヤ人","ゆだやじん"],["の"],["おも"],["だった"],["人","ひと"],["たち"],["を"],["呼び集め","よびあつめ"],["、"],["彼","かれ"],["ら"],["が"],["集まった","あつまった"],["とき"],["に"],["、"],["こう"],["言った","いった"],["。"],["「"],["兄弟","きょうだい"],["たち"],["。"],["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["国民","こくみん"],["に対して","にたいして"],["も"],["、"],["先祖","せんぞ"],["の"],["慣習","かんしゅう"],["に対して","にたいして"],["も"],["、"],["何","なん"],["一","ひと"],["つ"],["そむく"],["こと"],["は"],["して"],["いない"],["のに"],["、"],["エルサレム"],["で"],["囚人","しゅうじん"],["として"],["ローマ人","ろーまじん"],["の"],["手","て"],["に"],["渡されました","わたされました"],["。"]]},{"verse":18,"text":"ローマ人は私を取り調べましたが、私を死刑にする理由が何もなかったので、私を釈放しようと思ったのです。","tok":[["ローマ人","ろーまじん"],["は"],["私","わたくし"],["を"],["取り調べました","とりしらべました"],["が"],["、"],["私","わたくし"],["を"],["死刑","しけい"],["に"],["する"],["理由","りゆう"],["が"],["何","なん"],["も"],["なかった"],["ので"],["、"],["私","わたくし"],["を"],["釈放","しゃくほう"],["しよう"],["と"],["思った","おもった"],["の"],["です"],["。"]]},{"verse":19,"text":"ところが、ユダヤ人たちが反対したため、私はやむなくカイザルに上訴しました。それは、私の同胞を訴えようとしたのではありません。","tok":[["ところ"],["が"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["反対","はんたい"],["した"],["ため"],["、"],["私","わたくし"],["は"],["やむなく"],["カイザル"],["に"],["上訴","じょうそ"],["しました"],["。"],["それ"],["は"],["、"],["私","わたくし"],["の"],["同胞","どうほう"],["を"],["訴えよう","うったえよう"],["と"],["した"],["ので"],["は"],["ありません"],["。"]]},{"verse":20,"text":"このようなわけで、私は、あなたがたに会ってお話ししようと思い、お招きしました。私はイスラエルの望みのためにこの鎖につながれているのです。」","tok":[["この"],["よう"],["な"],["わけ"],["で"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["に"],["会って","あって"],["お話し","おはなし"],["しよう"],["と"],["思い","おもい"],["、"],["お招き","おまねき"],["しました"],["。"],["私","わたくし"],["は"],["イスラエル"],["の"],["望み","のぞみ"],["の"],["ため"],["に"],["この"],["鎖","くさり"],["に"],["つながれて"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":21,"text":"すると、彼らはこう言った。「私たちは、あなたのことについて、ユダヤから何の知らせも受けておりません。また、当地に来た兄弟たちの中で、あなたについて悪いことを告げたり、話したりした者はおりません。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["こう"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["あなた"],["の"],["こと"],["について"],["、"],["ユダヤ"],["から"],["何","なん"],["の"],["知らせ","しらせ"],["も"],["受けて","うけて"],["おりません"],["。"],["また"],["、"],["当地","とうち"],["に"],["来た","きた"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["で"],["、"],["あなた"],["について"],["悪い","わるい"],["こと"],["を"],["告げ","つげ"],["たり"],["、"],["話し","はなし"],["たり"],["した"],["者","もの"],["は"],["おりません"],["。"]]},{"verse":22,"text":"私たちは、あなたが考えておられることを、直接あなたから聞くのがよいと思っています。この宗派については、至る所で非難があることを私たちは知っているからです。」","tok":[["私たち","わたしたち"],["は"],["、"],["あなた"],["が"],["考えて","かんがえて"],["おられる"],["こと"],["を"],["、"],["直接","ちょくせつ"],["あなた"],["から"],["聞く","きく"],["の"],["が"],["よい"],["と"],["思って","おもって"],["います"],["。"],["この"],["宗派","しゅうは"],["について"],["は"],["、"],["至る所","いたるところ"],["で"],["非難","ひなん"],["が"],["ある"],["こと"],["を"],["私たち","わたしたち"],["は"],["知って","しって"],["いる"],["から"],["です"],["。"],["」"]]},{"verse":23,"text":"そこで、彼らは日を定めて、さらに大ぜいでパウロの宿にやって来た。彼は朝から晩まで語り続けた。神の国のことをあかしし、また、モーセの律法と預言者たちの書によって、イエスのことについて彼らを説得しようとした。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["日","ひ"],["を"],["定めて","さだめて"],["、"],["さらに"],["大ぜい","おおぜい"],["で"],["パウロ"],["の"],["宿","やど"],["に"],["やって"],["来た","きた"],["。"],["彼","かれ"],["は"],["朝","あさ"],["から"],["晩","ばん"],["まで"],["語り","かたり"],["続けた","つづけた"],["。"],["神","かみ"],["の"],["国","くに"],["の"],["こと"],["を"],["あかし"],["し"],["、"],["また"],["、"],["モーセ"],["の"],["律法","りっぽう"],["と"],["預言者","よげんしゃ"],["たち"],["の"],["書","しょ"],["によって"],["、"],["イエス"],["の"],["こと"],["について"],["彼","かれ"],["ら"],["を"],["説得","せっとく"],["しよう"],["と"],["した"],["。"]]},{"verse":24,"text":"ある人々は彼の語る事を信じたが、ある人々は信じようとしなかった。","tok":[["ある"],["人々","ひとびと"],["は"],["彼","かれ"],["の"],["語る","かたる"],["事","こと"],["を"],["信じた","しんじた"],["が"],["、"],["ある"],["人々","ひとびと"],["は"],["信じよう","しんじよう"],["と"],["しなかった"],["。"]]},{"verse":25,"text":"こうして、彼らは、お互いの意見が一致せずに帰りかけたので、パウロは一言、次のように言った。「聖霊が預言者イザヤを通してあなたがたの父祖たちに語られたことは、まさにそのとおりでした。","tok":[["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["、"],["お互い","おたがい"],["の"],["意見","いけん"],["が"],["一致","いっち"],["せず"],["に"],["帰りかけた","かえりかけた"],["ので"],["、"],["パウロ"],["は"],["一言","ひとこと"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"],["「"],["聖霊","せいれい"],["が"],["預言者","よげんしゃ"],["イザヤ"],["を"],["通して","とおして"],["あなた"],["がた"],["の"],["父祖","ふそ"],["たち"],["に"],["語られた","かたられた"],["こと"],["は"],["、"],["まさに"],["その"],["とおり"],["でした"],["。"]]},{"verse":26,"text":"『この民のところに行って、告げよ。あなたがたは確かに聞きはするが、決して悟らない。確かに見てはいるが、決してわからない。","tok":[["『"],["この"],["民","たみ"],["の"],["ところ"],["に"],["行って","いって"],["、"],["告げ","つげ"],["よ"],["。"],["あなた"],["がた"],["は"],["確か","たしか"],["に"],["聞き","きき"],["は"],["する"],["が"],["、"],["決して","けっして"],["悟らない","さとらない"],["。"],["確か","たしか"],["に"],["見","み"],["ては"],["いる"],["が"],["、"],["決して","けっして"],["わからない"],["。"]]},{"verse":27,"text":"この民の心は鈍くなり、その耳は遠く、その目はつぶっているからである。それは、彼らがその目で見、その耳で聞き、その心で悟って、立ち返り、わたしにいやされることのないためである。』","tok":[["この"],["民","たみ"],["の"],["心","こころ"],["は"],["鈍く","にぶく"],["なり"],["、"],["その"],["耳","みみ"],["は"],["遠く","とおく"],["、"],["その"],["目","め"],["は"],["つぶって"],["いる"],["から"],["で"],["ある"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["その"],["目","め"],["で"],["見","み"],["、"],["その"],["耳","みみ"],["で"],["聞き","きき"],["、"],["その"],["心","こころ"],["で"],["悟って","さとって"],["、"],["立ち返り","たちかえり"],["、"],["わたし"],["に"],["いやされる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"],["』"]]},{"verse":28,"text":"ですから、承知しておいてください。神のこの救いは、異邦人に送られました。彼らは、耳を傾けるでしょう。」","tok":[["です"],["から"],["、"],["承知","しょうち"],["して"],["おいて"],["ください"],["。"],["神","かみ"],["の"],["この"],["救い","すくい"],["は"],["、"],["異邦人","いほうじん"],["に"],["送られました","おくられました"],["。"],["彼","かれ"],["ら"],["は"],["、"],["耳","みみ"],["を"],["傾けるでしょう","かたむけるでしょう"],["。"],["」"]]},{"verse":29,"text":"ある写本には二九節として、次の挿入がある。「彼がこれらのことを話し終えると、ユダヤ人たちは互いに激しく論じ合いながら、帰って行った。」","tok":[["ある"],["写本","しゃほん"],["に"],["は"],["二九","にきゅう"],["節","せつ"],["として"],["、"],["次","つぎ"],["の"],["挿入","そうにゅう"],["が"],["ある"],["。"],["「"],["彼","かれ"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["話し","はなし"],["終える","おえる"],["と"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["互い","たがい"],["に"],["激しく","はげしく"],["論じ合い","ろんじあい"],["ながら"],["、"],["帰って","かえって"],["行った","いった"],["。"],["」"]]},{"verse":30,"text":"こうしてパウロは満二年の間、自費で借りた家に住み、たずねて来る人たちをみな迎えて、","tok":[["こう"],["して"],["パウロ"],["は"],["満","まん"],["二","に"],["年","ねん"],["の"],["間","あいだ"],["、"],["自費","じひ"],["で"],["借りた","かりた"],["家","いえ"],["に"],["住み","すみ"],["、"],["たずねて"],["来る","くる"],["人","ひと"],["たち"],["を"],["みな"],["迎えて","むかえて"],["、"]]},{"verse":31,"text":"大胆に、少しも妨げられることなく、神の国を宣べ伝え、主イエス・キリストのことを教えた。","tok":[["大胆","だいたん"],["に"],["、"],["少し","すこし"],["も"],["妨げられる","さまたげられる"],["こと"],["なく"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["宣べ伝え","のべつたえ"],["、"],["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["こと"],["を"],["教えた","おしえた"],["。"]]}]
[{"verse":1,"text":"ペテロとヨハネは午後三時の祈りの時間に宮に上って行った。","tok":[["ペテロ"],["と"],["ヨハネ"],["は"],["午後","ごご"],["三","さん"],["時","じ"],["の"],["祈り","いのり"],["の"],["時間","じかん"],["に"],["宮","みや"],["に"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":2,"text":"すると、生まれつき足のなえた人が運ばれて来た。この男は、宮に入る人たちから施しを求めるために、毎日「美しの門」という名の宮の門に置いてもらっていた。","tok":[["する"],["と"],["、"],["生まれつき","うまれつき"],["足","あし"],["の"],["なえた"],["人","ひと"],["が"],["運ばれて","はこばれて"],["来た","きた"],["。"],["この"],["男","おとこ"],["は"],["、"],["宮","みや"],["に"],["入る","はいる"],["人","ひと"],["たち"],["から"],["施し","ほどこし"],["を"],["求める","もとめる"],["ため"],["に"],["、"],["毎日","まいにち"],["「"],["美し","うつくし"],["の"],["門","もん"],["」"],["と"],["いう"],["名","な"],["の"],["宮","みや"],["の"],["門","もん"],["に"],["置いて","おいて"],["もらって"],["いた"],["。"]]},{"verse":3,"text":"彼は、ペテロとヨハネが宮に入ろうとするのを見て、施しを求めた。","tok":[["彼","かれ"],["は"],["、"],["ペテロ"],["と"],["ヨハネ"],["が"],["宮","みや"],["に"],["入ろう","はいろう"],["と"],["する"],["の"],["を"],["見て","みて"],["、"],["施し","ほどこし"],["を"],["求めた","もとめた"],["。"]]},{"verse":4,"text":"ペテロは、ヨハネとともに、その男を見つめて、「私たちを見なさい」と言った。","tok":[["ペテロ"],["は"],["、"],["ヨハネ"],["と"],["とも"],["に"],["、"],["その"],["男","おとこ"],["を"],["見つめて","みつめて"],["、"],["「"],["私たち","わたしたち"],["を"],["見","み"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"男は何かもらえると思って、ふたりに目を注いだ。","tok":[["男","おとこ"],["は"],["何","なん"],["か"],["もらえる"],["と"],["思って","おもって"],["、"],["ふたり"],["に"],["目","め"],["を"],["注いだ","そそいだ"],["。"]]},{"verse":6,"text":"すると、ペテロは、「金銀は私にはない。しかし、私にあるものを上げよう。ナザレのイエス・キリストの名によって、歩きなさい」と言って、","tok":[["する"],["と"],["、"],["ペテロ"],["は"],["、"],["「"],["金銀","きんぎん"],["は"],["私","わたくし"],["に"],["は"],["ない"],["。"],["しかし"],["、"],["私","わたくし"],["に"],["ある"],["もの"],["を"],["上げよう","あげよう"],["。"],["ナザレ"],["の"],["イエス"],["・"],["キリスト"],["の"],["名","な"],["によって"],["、"],["歩き","あるき"],["なさい"],["」"],["と"],["言って","いって"],["、"]]},{"verse":7,"text":"彼の右手を取って立たせた。するとたちまち、彼の足とくるぶしが強くなり、","tok":[["彼","かれ"],["の"],["右手","みぎて"],["を"],["取って","とって"],["立たせた","たたせた"],["。"],["する"],["と"],["たちまち"],["、"],["彼","かれ"],["の"],["足","あし"],["と"],["くるぶし"],["が"],["強く","つよく"],["な
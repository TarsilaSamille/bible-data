[{"verse":1,"text":"フェストは州総督として着任すると、三日後にカイザリヤからエルサレムに上った。","tok":[["フェスト"],["は"],["州","しゅう"],["総督","そうとく"],["として"],["着任","ちゃくにん"],["する"],["と"],["、"],["三日後","みっかご"],["に"],["カイザリヤ"],["から"],["エルサレム"],["に"],["上った","のぼった"],["。"]]},{"verse":2,"text":"すると、祭司長たちとユダヤ人のおもだった者たちが、パウロのことを訴え出て、","tok":[["する"],["と"],["、"],["祭司長","さいしちょう"],["たち"],["と"],["ユダヤ人","ゆだやじん"],["の"],["おも"],["だった"],["者","もの"],["たち"],["が"],["、"],["パウロ"],["の"],["こと"],["を"],["訴え出て","うったえでて"],["、"]]},{"verse":3,"text":"パウロを取り調べる件について自分たちに好意を持ってくれるように頼み、パウロをエルサレムに呼び寄せていただきたいと彼に懇願した。彼らはパウロを途中で殺害するために待ち伏せをさせていた。","tok":[["パウロ"],["を"],["取り調べる","とりしらべる"],["件","けん"],["について"],["自分","じぶん"],["たち"],["に"],["好意","こうい"],["を"],["持って","もって"],["くれる"],["よう"],["に"],["頼み","たのみ"],["、"],["パウロ"],["を"],["エルサレム"],["に"],["呼び寄せて","よびよせて"],["いただきたい"],["と"],["彼","かれ"],["に"],["懇願","こんがん"],["した"],["。"],["彼","かれ"],["ら"],["は"],["パウロ"],["を"],["途中","とちゅう"],["で"],["殺害","さつがい"],["する"],["ため"],["に"],["待ち伏せ","まちぶせ"],["を"],["させて"],["いた"],["。"]]},{"verse":4,"text":"ところが、フェストは、パウロはカイザリヤに拘置されているし、自分はまもなく出発の予定であると答え、","tok":[["ところ"],["が"],["、"],["フェスト"],["は"],["、"],["パウロ"],["は"],["カイザリヤ"],["に"],["拘置","こうち"],["されて"],["いる"],["し"],["、"],["自分","じぶん"],["は"],["ま"],["も"],["なく"],["出発","しゅっぱつ"],["の"],["予定","よてい"],["で"],["ある"],["と"],["答え","こたえ"],["、"]]},{"verse":5,"text":"「だから、その男に何か不都合なことがあるなら、あなたがたのうちの有力な人たちが、私といっしょに下って行って、彼を告訴しなさい」と言った。","tok":[["「"],["だ"],["から"],["、"],["その"],["男","おとこ"],["に"],["何","なん"],["か"],["不都合","ふつごう"],["な"],["こと"],["が"],["あるなら"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["有力","ゆうりょく"],["な"],["人","ひと"],["たち"],["が"],["、"],["私","わたくし"],["と"],["いっしょ"],["に"],["下って","くだって"],["行って","いって"],["、"],["彼","かれ"],["を"],["告訴","こくそ"],["し"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"フェストは、彼らのところに八日あるいは十日ばかり滞在しただけで、カイザリヤへ下って行き、翌日、裁判の席に着いて、パウロの出廷を命じた。","tok":[["フェスト"],["は"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["八日","ようか"],["あるいは"],["十日","とうか"],["ばかり"],["滞在","たいざい"],["した"],["だけ"],["で"],["、"],["カイザリヤ"],["へ"],["下って","くだって"],["行き","いき"],["、"],["翌日","よくじつ"],["、"],["裁判","さいばん"],["の"],["席","せき"],["に"],["着いて","ついて"],["、"],["パウロ"],["の"],["出廷","しゅってい"],["を"],["命じた","めいじた"],["。"]]},{"verse":7,"text":"パウロが出て来ると、エルサレムから下って来たユダヤ人たちは、彼を取り囲んで立ち、多くの重い罪状を申し立てたが、それを証拠立てることはできなかった。","tok":[["パウロ"],["が"],["出て","でて"],["来る","くる"],["と"],["、"],["エルサレム"],["から"],["下って","くだって"],["来た","きた"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["彼","かれ"],["を"],["取り囲んで","とりかこんで"],["立ち","たち"],["、"],["多く","おおく"],["の"],["重い","おもい"],["罪状","ざいじょう"],["を"],["申し立てた","もうしたてた"],["が"],["、"],["それ"],["を"],["証拠","しょうこ"],["立てる","たてる"],["こと"],["は"],["できなかった"],["。"]]},{"verse":8,"text":"しかしパウロは弁明して、「私は、ユダヤ人の律法に対しても、宮に対しても、またカイザルに対しても、何の罪も犯してはおりません」と言った。","tok":[["しかし"],["パウロ"],["は"],["弁明","べんめい"],["して"],["、"],["「"],["私","わたくし"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["律法","りっぽう"],["に対して","にたいして"],["も"],["、"],["宮","みや"],["に対して","にたいして"],["も"],["、"],["また"],["カイザル"],["に対して","にたいして"],["も"],["、"],["何","なん"],["の"],["罪","つみ"],["も"],["犯して","おかして"],["は"],["おりません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"ところが、ユダヤ人の歓心を買おうとしたフェストは、パウロに向かって、「あなたはエルサレムに上り、この事件について、私の前で裁判を受けることを願うか」と尋ねた。","tok":[["ところ"],["が"],["、"],["ユダヤ人","ゆだやじん"],["の"],["歓心","かんしん"],["を"],["買おう","かおう"],["と"],["した"],["フェスト"],["は"],["、"],["パウロ"],["に"],["向かって","むかって"],["、"],["「"],["あなた"],["は"],["エルサレム"],["に"],["上り","のぼり"],["、"],["この"],["事件","じけん"],["について"],["、"],["私","わたくし"],["の"],["前","まえ"],["で"],["裁判","さいばん"],["を"],["受ける","うける"],["こと"],["を"],["願う","ねがう"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":10,"text":"すると、パウロはこう言った。「私はカイザルの法廷に立っているのですから、ここで裁判を受けるのが当然です。あなたもよくご存じのとおり、私はユダヤ人にどんな悪いこともしませんでした。","tok":[["する"],["と"],["、"],["パウロ"],["は"],["こう"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["カイザル"],["の"],["法廷","ほうてい"],["に"],["立って","たって"],["いる"],["の"],["です"],["から"],["、"],["ここ"],["で"],["裁判","さいばん"],["を"],["受ける","うける"],["の"],["が"],["当然","とうぜん"],["です"],["。"],["あなた"],["も"],["よく"],["ご存じ","ごぞんじ"],["の"],["とおり"],["、"],["私","わたくし"],["は"],["ユダヤ人","ゆだやじん"],["に"],["どんな"],["悪い","わるい"],["こと"],["も"],["しませんでした"],["。"]]},{"verse":11,"text":"もし私が悪いことをして、死罪に当たることをしたのでしたら、私は死をのがれようとはしません。しかし、この人たちが私を訴えていることに一つも根拠がないとすれば、だれも私を彼らに引き渡すことはできません。私はカイザルに上訴します。」","tok":[["もし"],["私","わたくし"],["が"],["悪い","わるい"],["こと"],["を"],["して"],["、"],["死罪","しざい"],["に"],["当たる","あたる"],["こと"],["を"],["した"],["の"],["でしたら"],["、"],["私","わたくし"],["は"],["死","し"],["を"],["のがれよう"],["と"],["は"],["しません"],["。"],["しかし"],["、"],["この"],["人","ひと"],["たち"],["が"],["私","わたくし"],["を"],["訴えて","うったえて"],["いる"],["こと"],["に"],["一","ひと"],["つ"],["も"],["根拠","こんきょ"],["が"],["ない"],["と"],["すれば"],["、"],["だれ"],["も"],["私","わたくし"],["を"],["彼","かれ"],["ら"],["に"],["引き渡す","ひきわたす"],["こと"],["は"],["できません"],["。"],["私","わたくし"],["は"],["カイザル"],["に"],["上訴","じょうそ"],["します"],["。"],["」"]]},{"verse":12,"text":"そのとき、フェストは陪席の者たちと協議したうえで、こう答えた。「あなたはカイザルに上訴したのだから、カイザルのもとへ行きなさい。」","tok":[["その"],["とき"],["、"],["フェスト"],["は"],["陪席","ばいせき"],["の"],["者","もの"],["たち"],["と"],["協議","きょうぎ"],["した"],["うえ"],["で"],["、"],["こう"],["答えた","こたえた"],["。"],["「"],["あなた"],["は"],["カイザル"],["に"],["上訴","じょうそ"],["した"],["の"],["だ"],["から"],["、"],["カイザル"],["の"],["もと"],["へ"],["行き","いき"],["なさい"],["。"],["」"]]},{"verse":13,"text":"数日たってから、アグリッパ王とベルニケが、フェストに敬意を表するためにカイザリヤに来た。","tok":[["数日","すうじつ"],["たって"],["から"],["、"],["アグリッパ"],["王","おう"],["と"],["ベルニケ"],["が"],["、"],["フェスト"],["に"],["敬意","けいい"],["を"],["表する","ひょうする"],["ため"],["に"],["カイザリヤ"],["に"],["来た","きた"],["。"]]},{"verse":14,"text":"ふたりがそこに長く滞在していたので、フェストはパウロの一件を王に持ち出してこう言った。「ペリクスが囚人として残して行ったひとりの男がおります。","tok":[["ふたり"],["が"],["そこ"],["に"],["長く","ながく"],["滞在","たいざい"],["して"],["いた"],["ので"],["、"],["フェスト"],["は"],["パウロ"],["の"],["一","いち"],["件","けん"],["を"],["王","おう"],["に"],["持ち出して","もちだして"],["こう"],["言った","いった"],["。"],["「"],["ペリクス"],["が"],["囚人","しゅうじん"],["として"],["残して","のこして"],["行った","いった"],["ひとり"],["の"],["男","おとこ"],["が"],["おります"],["。"]]},{"verse":15,"text":"私がエルサレムに行ったとき、祭司たちとユダヤ人の長老たちとが、その男のことを私に訴え出て、罪に定めるように要求しました。","tok":[["私","わたくし"],["が"],["エルサレム"],["に"],["行った","いった"],["とき"],["、"],["祭司","さいし"],["たち"],["と"],["ユダヤ人","ゆだやじん"],["の"],["長老","ちょうろう"],["たち"],["と"],["が"],["、"],["その"],["男","おとこ"],["の"],["こと"],["を"],["私","わたくし"],["に"],["訴え出て","うったえでて"],["、"],["罪","つみ"],["に"],["定める","さだめる"],["よう"],["に"],["要求","ようきゅう"],["しました"],["。"]]},{"verse":16,"text":"そのとき私は、『被告が、彼を訴えた者の面前で訴えに対して弁明する機会を与えられないで、そのまま引き渡されるということはローマの慣例ではない』と答えておきました。","tok":[["その"],["とき"],["私","わたくし"],["は"],["、"],["『"],["被告","ひこく"],["が"],["、"],["彼","かれ"],["を"],["訴えた","うったえた"],["者","もの"],["の"],["面前","めんぜん"],["で"],["訴え","うったえ"],["に対して","にたいして"],["弁明","べんめい"],["する"],["機会","きかい"],["を"],["与えられないで","あたえられないで"],["、"],["そのまま"],["引き渡される","ひきわたされる"],["と"],["いう"],["こと"],["は"],["ローマ"],["の"],["慣例","かんれい"],["で"],["は"],["ない"],["』"],["と"],["答えて","こたえて"],["おきました"],["。"]]},{"verse":17,"text":"そういうわけで、訴える者たちがここに集まったとき、私は時を移さず、その翌日、裁判の席に着いて、その男を出廷させました。","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["訴える","うったえる"],["者","もの"],["たち"],["が"],["ここ"],["に"],["集まった","あつまった"],["とき"],["、"],["私","わたくし"],["は"],["時","とき"],["を"],["移さず","うつさず"],["、"],["その"],["翌日","よくじつ"],["、"],["裁判","さいばん"],["の"],["席","せき"],["に"],["着いて","ついて"],["、"],["その"],["男","おとこ"],["を"],["出廷","しゅってい"],["させました"],["。"]]},{"verse":18,"text":"訴えた者たちは立ち上がりましたが、私が予期していたような犯罪についての訴えは何一つ申し立てませんでした。","tok":[["訴えた","うったえた"],["者","もの"],["たち"],["は"],["立ち上がりました","たちあがりました"],["が"],["、"],["私","わたくし"],["が"],["予期","よき"],["して"],["いた"],["よう"],["な"],["犯罪","はんざい"],["について"],["の"],["訴え","うったえ"],["は"],["何","なん"],["一","ひと"],["つ"],["申し立てませんでした","もうしたてませんでした"],["。"]]},{"verse":19,"text":"ただ、彼と言い争っている点は、彼ら自身の宗教に関することであり、また、死んでしまったイエスという者のことで、そのイエスが生きているとパウロは主張しているのでした。","tok":[["ただ"],["、"],["彼","かれ"],["と"],["言い争って","いいあらそって"],["いる"],["点","てん"],["は"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["の"],["宗教","しゅうきょう"],["に"],["関する","かんする"],["こと"],["で"],["あり"],["、"],["また"],["、"],["死んで","しんで"],["しまった"],["イエス"],["と"],["いう"],["者","もの"],["の"],["こと"],["で"],["、"],["その"],["イエス"],["が"],["生きて","いきて"],["いる"],["と"],["パウロ"],["は"],["主張","しゅちょう"],["して"],["いる"],["の"],["でした"],["。"]]},{"verse":20,"text":"このような問題をどう取り調べたらよいか、私には見当がつかないので、彼に『エルサレムに上り、そこで、この事件について裁判を受けたいのか』と尋ねたところが、","tok":[["この"],["よう"],["な"],["問題","もんだい"],["を"],["どう"],["取り調べたら","とりしらべたら"],["よい"],["か"],["、"],["私","わたくし"],["に"],["は"],["見当","けんとう"],["が"],["つかない"],["ので"],["、"],["彼","かれ"],["に"],["『"],["エルサレム"],["に"],["上り","のぼり"],["、"],["そこ"],["で"],["、"],["この"],["事件","じけん"],["について"],["裁判","さいばん"],["を"],["受けたい","うけたい"],["の"],["か"],["』"],["と"],["尋ねた","たずねた"],["ところ"],["が"],["、"]]},{"verse":21,"text":"パウロは、皇帝の判決を受けるまで保護してほしいと願い出たので、彼をカイザルのもとに送る時まで守っておくように、命じておきました。」","tok":[["パウロ"],["は"],["、"],["皇帝","こうてい"],["の"],["判決","はんけつ"],["を"],["受ける","うける"],["まで"],["保護","ほご"],["して"],["ほしい"],["と"],["願い出た","ねがいでた"],["ので"],["、"],["彼","かれ"],["を"],["カイザル"],["の"],["もと"],["に"],["送る","おくる"],["時","とき"],["まで"],["守って","まもって"],["おく"],["よう"],["に"],["、"],["命じて","めいじて"],["おきました"],["。"],["」"]]},{"verse":22,"text":"すると、アグリッパがフェストに、「私も、その男の話を聞きたいものです」と言ったので、フェストは、「では、明日お聞きください」と言った。","tok":[["する"],["と"],["、"],["アグリッパ"],["が"],["フェスト"],["に"],["、"],["「"],["私","わたくし"],["も"],["、"],["その"],["男","おとこ"],["の"],["話","はなし"],["を"],["聞きたい","ききたい"],["もの"],["です"],["」"],["と"],["言った","いった"],["ので"],["、"],["フェスト"],["は"],["、"],["「"],["で"],["は"],["、"],["明日","あす"],["お聞き","おきき"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":23,"text":"こういうわけで、翌日、アグリッパとベルニケは、大いに威儀を整えて到着し、千人隊長たちや市の首脳者たちにつき添われて講堂に入った。そのとき、フェストの命令によってパウロが連れて来られた。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["翌日","よくじつ"],["、"],["アグリッパ"],["と"],["ベルニケ"],["は"],["、"],["大いに","おおいに"],["威儀","いぎ"],["を"],["整えて","ととのえて"],["到着","とうちゃく"],["し"],["、"],["千人","せんにん"],["隊長","たいちょう"],["たち"],["や"],["市","し"],["の"],["首脳者","しゅのうしゃ"],["たち"],["に"],["つき添われて","つきそわれて"],["講堂","こうどう"],["に"],["入った","はいった"],["。"],["その"],["とき"],["、"],["フェスト"],["の"],["命令","めいれい"],["によって"],["パウロ"],["が"],["連れて","つれて"],["来られた","こられた"],["。"]]},{"verse":24,"text":"そこで、フェストはこう言った。「アグリッパ王、ならびに、ここに同席の方々。ご覧ください。ユダヤ人がこぞって、一刻も生かしてはおけないと呼ばわり、エルサレムでも、ここでも、私に訴えて来たのは、この人のことです。","tok":[["そこ"],["で"],["、"],["フェスト"],["は"],["こう"],["言った","いった"],["。"],["「"],["アグリッパ"],["王","おう"],["、"],["ならびに"],["、"],["ここ"],["に"],["同席","どうせき"],["の"],["方々","かたがた"],["。"],["ご覧","ごらん"],["ください"],["。"],["ユダヤ人","ゆだやじん"],["が"],["こぞって"],["、"],["一刻","いっこく"],["も"],["生かして","いかして"],["は"],["おけない"],["と"],["呼ばわり","よばわり"],["、"],["エルサレム"],["で"],["も"],["、"],["ここ"],["で"],["も"],["、"],["私","わたくし"],["に"],["訴えて","うったえて"],["来た","きた"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["です"],["。"]]},{"verse":25,"text":"私としては、彼は死に当たることは何一つしていないと思います。しかし、彼自身が皇帝に上訴しましたので、彼をそちらに送ることに決めました。","tok":[["私","わたくし"],["として"],["は"],["、"],["彼","かれ"],["は"],["死","し"],["に"],["当たる","あたる"],["こと"],["は"],["何","なん"],["一","ひと"],["つ"],["して"],["いない"],["と"],["思います","おもいます"],["。"],["しかし"],["、"],["彼","かれ"],["自身","じしん"],["が"],["皇帝","こうてい"],["に"],["上訴","じょうそ"],["しました"],["ので"],["、"],["彼","かれ"],["を"],["そちら"],["に"],["送る","おくる"],["こと"],["に"],["決めました","きめました"],["。"]]},{"verse":26,"text":"ところが、彼について、わが君に書き送るべき確かな事がらが一つもないのです。それで皆さんの前に、わけてもアグリッパ王よ、あなたの前に、彼を連れてまいりました。取り調べをしてみたら、何か書き送るべきことが得られましょう。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["について"],["、"],["わが"],["君","きみ"],["に"],["書き送るべき","かきおくるべき"],["確か","たしか"],["な"],["事がら","ことがら"],["が"],["一","ひと"],["つ"],["も"],["ない"],["の"],["です"],["。"],["それ"],["で"],["皆","みな"],["さん"],["の"],["前","まえ"],["に"],["、"],["わけて"],["も"],["アグリッパ"],["王","おう"],["よ"],["、"],["あなた"],["の"],["前","まえ"],["に"],["、"],["彼","かれ"],["を"],["連れて","つれて"],["まいりました"],["。"],["取り調べ","とりしらべ"],["を"],["して"],["みたら"],["、"],["何","なん"],["か"],["書き送るべき","かきおくるべき"],["こと"],["が"],["得られましょう","えられましょう"],["。"]]},{"verse":27,"text":"囚人を送るのに、その訴えの個条を示さないのは、理に合わないと思うのです。」","tok":[["囚人","しゅうじん"],["を"],["送る","おくる"],["のに"],["、"],["その"],["訴え","うったえ"],["の"],["個条","かじょう"],["を"],["示さない","しめさない"],["の"],["は"],["、"],["理","り"],["に"],["合わない","あわない"],["と"],["思う","おもう"],["の"],["です"],["。"],["」"]]}]
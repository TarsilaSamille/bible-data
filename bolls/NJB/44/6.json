[{"verse":1,"text":"そのころ、弟子たちがふえるにつれて、ギリシヤ語を使うユダヤ人たちが、ヘブル語を使うユダヤ人たちに対して苦情を申し立てた。彼らのうちのやもめたちが、毎日の配給でなおざりにされていたからである。","tok":[["その"],["ころ"],["、"],["弟子","でし"],["たち"],["が"],["ふえる"],["に"],["つれて"],["、"],["ギリシヤ"],["語","ご"],["を"],["使う","つかう"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["、"],["ヘブル"],["語","ご"],["を"],["使う","つかう"],["ユダヤ人","ゆだやじん"],["たち"],["に対して","にたいして"],["苦情","くじょう"],["を"],["申し立てた","もうしたてた"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["やもめ"],["たち"],["が"],["、"],["毎日","まいにち"],["の"],["配給","はいきゅう"],["で"],["なおざり"],["に"],["されて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"そこで、十二使徒は弟子たち全員を呼び集めてこう言った。「私たちが神のことばをあと回しにして、食卓のことに仕えるのはよくありません。","tok":[["そこ"],["で"],["、"],["十二","じゅうに"],["使徒","しと"],["は"],["弟子","でし"],["たち"],["全員","ぜんいん"],["を"],["呼び集めて","よびあつめて"],["こう"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["が"],["神","かみ"],["の"],["ことば"],["を"],["あと回し","あとまわし"],["に"],["して"],["、"],["食卓","しょくたく"],["の"],["こと"],["に"],["仕える","つかえる"],["の"],["は"],["よく"],["ありません"],["。"]]},{"verse":3,"text":"そこで、兄弟たち。あなたがたの中から、御霊と知恵とに満ちた、評判の良い人たち七人を選びなさい。私たちはその人たちをこの仕事に当たらせることにします。","tok":[["そこ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["の"],["中","なか"],["から"],["、"],["御霊","ごれい"],["と"],["知恵","ちえ"],["と"],["に"],["満ちた","みちた"],["、"],["評判","ひょうばん"],["の"],["良い","よい"],["人","ひと"],["たち"],["七人","ななにん"],["を"],["選び","えらび"],["なさい"],["。"],["私たち","わたしたち"],["は"],["その"],["人","ひと"],["たち"],["を"],["この"],["仕事","しごと"],["に"],["当たらせる","あたらせる"],["こと"],["に"],["します"],["。"]]},{"verse":4,"text":"そして、私たちは、もっぱら祈りとみことばの奉仕に励むことにします。」","tok":[["そして"],["、"],["私たち","わたしたち"],["は"],["、"],["もっぱら"],["祈り","いのり"],["と"],["みことば"],["の"],["奉仕","ほうし"],["に"],["励む","はげむ"],["こと"],["に"],["します"],["。"],["」"]]},{"verse":5,"text":"この提案は全員の承認するところとなり、彼らは、信仰と聖霊とに満ちた人ステパノ、およびピリポ、プロコロ、ニカノル、テモン、パルメナ、アンテオケの改宗者ニコラオを選び、","tok":[["この"],["提案","ていあん"],["は"],["全員","ぜんいん"],["の"],["承認","しょうにん"],["する"],["ところ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["、"],["信仰","しんこう"],["と"],["聖霊","せいれい"],["と"],["に"],["満ちた","みちた"],["人","ひと"],["ステパノ"],["、"],["および"],["ピリポ"],["、"],["プロコロ"],["、"],["ニカノル"],["、"],["テモン"],["、"],["パルメナ"],["、"],["アンテオケ"],["の"],["改宗者","かいしゅうしゃ"],["ニコラオ"],["を"],["選び","えらび"],["、"]]},{"verse":6,"text":"この人たちを使徒たちの前に立たせた。そこで使徒たちは祈って、手を彼らの上に置いた。","tok":[["この"],["人","ひと"],["たち"],["を"],["使徒","しと"],["たち"],["の"],["前","まえ"],["に"],["立たせた","たたせた"],["。"],["そこ"],["で"],["使徒","しと"],["たち"],["は"],["祈って","いのって"],["、"],["手","て"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["置いた","おいた"],["。"]]},{"verse":7,"text":"こうして神のことばは、ますます広まって行き、エルサレムで、弟子の数が非常にふえて行った。そして、多くの祭司たちが次々に信仰に入った。","tok":[["こう"],["して"],["神","かみ"],["の"],["ことば"],["は"],["、"],["ますます"],["広まって","ひろまって"],["行き","いき"],["、"],["エルサレム"],["で"],["、"],["弟子","でし"],["の"],["数","かず"],["が"],["非常","ひじょう"],["に"],["ふえて"],["行った","いった"],["。"],["そして"],["、"],["多く","おおく"],["の"],["祭司","さいし"],["たち"],["が"],["次々","つぎつぎ"],["に"],["信仰","しんこう"],["に"],["入った","はいった"],["。"]]},{"verse":8,"text":"さて、ステパノは恵みと力とに満ち、人々の間で、すばらしい不思議なわざとしるしを行っていた。","tok":[["さて"],["、"],["ステパノ"],["は"],["恵み","めぐみ"],["と"],["力","ちから"],["と"],["に"],["満ち","みち"],["、"],["人々","ひとびと"],["の"],["間","あいだ"],["で"],["、"],["すばらしい"],["不思議","ふしぎ"],["な"],["わざと"],["しるし"],["を"],["行って","おこなって"],["いた"],["。"]]},{"verse":9,"text":"ところが、いわゆるリベルテンの会堂に属する人々で、クレネ人、アレキサンドリヤ人、キリキヤやアジヤから来た人々などが立ち上がって、ステパノと議論した。","tok":[["ところ"],["が"],["、"],["いわゆる"],["リベルテン"],["の"],["会堂","かいどう"],["に"],["属する","ぞくする"],["人々","ひとびと"],["で"],["、"],["クレネ人","くれねにん"],["、"],["アレキサンドリヤ"],["人","にん"],["、"],["キリキヤ"],["や"],["アジヤ"],["から"],["来た","きた"],["人々","ひとびと"],["など"],["が"],["立ち上がって","たちあがって"],["、"],["ステパノ"],["と"],["議論","ぎろん"],["した"],["。"]]},{"verse":10,"text":"しかし、彼が知恵と御霊によって語っていたので、それに対抗することができなかった。","tok":[["しかし"],["、"],["彼","かれ"],["が"],["知恵","ちえ"],["と"],["御霊","ごれい"],["によって"],["語って","かたって"],["いた"],["ので"],["、"],["それ"],["に"],["対抗","たいこう"],["する"],["こと"],["が"],["できなかった"],["。"]]},{"verse":11,"text":"そこで、彼らはある人々をそそのかし、「私たちは彼がモーセと神とをけがすことばを語るのを聞いた」と言わせた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["ある"],["人々","ひとびと"],["を"],["そそのかし"],["、"],["「"],["私たち","わたしたち"],["は"],["彼","かれ"],["が"],["モーセ"],["と"],["神","かみ"],["と"],["を"],["けがす"],["ことば"],["を"],["語る","かたる"],["の"],["を"],["聞いた","きいた"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":12,"text":"また、民衆と長老たちと律法学者たちを扇動し、彼を襲って捕らえ、議会にひっぱって行った。","tok":[["また"],["、"],["民衆","みんしゅう"],["と"],["長老","ちょうろう"],["たち"],["と"],["律法学者","りっぽうがくしゃ"],["たち"],["を"],["扇動","せんどう"],["し"],["、"],["彼","かれ"],["を"],["襲って","おそって"],["捕らえ","とらえ"],["、"],["議会","ぎかい"],["に"],["ひっぱって"],["行った","いった"],["。"]]},{"verse":13,"text":"そして、偽りの証人たちを立てて、こう言わせた。「この人は、この聖なる所と律法とに逆らうことばを語るのをやめません。","tok":[["そして"],["、"],["偽り","いつわり"],["の"],["証人","しょうにん"],["たち"],["を"],["立てて","たてて"],["、"],["こう"],["言わせた","いわせた"],["。"],["「"],["この"],["人","ひと"],["は"],["、"],["この"],["聖","せい"],["なる"],["所","ところ"],["と"],["律法","りっぽう"],["と"],["に"],["逆らう","さからう"],["ことば"],["を"],["語る","かたる"],["の"],["を"],["やめません"],["。"]]},{"verse":14,"text":"『あのナザレ人イエスはこの聖なる所をこわし、モーセが私たちに伝えた慣例を変えてしまう』と彼が言うのを、私たちは聞きました。」","tok":[["『"],["あの"],["ナザレ人","なざれにん"],["イエス"],["は"],["この"],["聖","せい"],["なる"],["所","ところ"],["を"],["こわし"],["、"],["モーセ"],["が"],["私たち","わたしたち"],["に"],["伝えた","つたえた"],["慣例","かんれい"],["を"],["変えて","かえて"],["しまう"],["』"],["と"],["彼","かれ"],["が"],["言う","いう"],["の"],["を"],["、"],["私たち","わたしたち"],["は"],["聞きました","ききました"],["。"],["」"]]},{"verse":15,"text":"議会で席に着いていた人々はみな、ステパノに目を注いだ。すると彼の顔は御使いの顔のように見えた。","tok":[["議会","ぎかい"],["で"],["席","せき"],["に"],["着いて","ついて"],["いた"],["人々","ひとびと"],["は"],["みな"],["、"],["ステパノ"],["に"],["目","め"],["を"],["注いだ","そそいだ"],["。"],["する"],["と"],["彼","かれ"],["の"],["顔","かお"],["は"],["御使い","おつかい"],["の"],["顔","かお"],["の"],["よう"],["に"],["見えた","みえた"],["。"]]}]
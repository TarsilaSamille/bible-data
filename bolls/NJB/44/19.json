[{"verse":1,"text":"アポロがコリントにいた間に、パウロは奥地を通ってエペソに来た。そして幾人かの弟子に出会って、","tok":[["アポロ"],["が"],["コリント"],["に"],["いた"],["間","あいだ"],["に"],["、"],["パウロ"],["は"],["奥地","おくち"],["を"],["通って","とおって"],["エペソ"],["に"],["来た","きた"],["。"],["そして"],["幾人","いくにん"],["か"],["の"],["弟子","でし"],["に"],["出会って","であって"],["、"]]},{"verse":2,"text":"「信じたとき、聖霊を受けましたか」と尋ねると、彼らは、「いいえ、聖霊の与えられることは、聞きもしませんでした」と答えた。","tok":[["「"],["信じた","しんじた"],["とき"],["、"],["聖霊","せいれい"],["を"],["受けました","うけました"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["いいえ"],["、"],["聖霊","せいれい"],["の"],["与えられる","あたえられる"],["こと"],["は"],["、"],["聞き","きき"],["も"],["しませんでした"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":3,"text":"「では、どんなバプテスマを受けたのですか」と言うと、「ヨハネのバプテスマです」と答えた。","tok":[["「"],["で"],["は"],["、"],["どんな"],["バプテスマ"],["を"],["受けた","うけた"],["の"],["です"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"],["「"],["ヨハネ"],["の"],["バプテスマ"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":4,"text":"そこで、パウロは、「ヨハネは、自分のあとに来られるイエスを信じるように人々に告げて、悔い改めのバプテスマを授けたのです」と言った。","tok":[["そこ"],["で"],["、"],["パウロ"],["は"],["、"],["「"],["ヨハネ"],["は"],["、"],["自分","じぶん"],["の"],["あと"],["に"],["来られる","こられる"],["イエス"],["を"],["信じる","しんじる"],["よう"],["に"],["人々","ひとびと"],["に"],["告げて","つげて"],["、"],["悔い改め","くいあらため"],["の"],["バプテスマ"],["を"],["授けた","さずけた"],["の"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"これを聞いたその人々は、主イエスの御名によってバプテスマを受けた。","tok":[["これ"],["を"],["聞いた","きいた"],["その"],["人々","ひとびと"],["は"],["、"],["主","しゅ"],["イエス"],["の"],["御名","ぎょめい"],["によって"],["バプテスマ"],["を"],["受けた","うけた"],["。"]]},{"verse":6,"text":"パウロが彼らの上に手を置いたとき、聖霊が彼らに臨まれ、彼らは異言を語ったり、預言をしたりした。","tok":[["パウロ"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置いた","おいた"],["とき"],["、"],["聖霊","せいれい"],["が"],["彼","かれ"],["ら"],["に"],["臨まれ","のぞまれ"],["、"],["彼","かれ"],["ら"],["は"],["異言","いげん"],["を"],["語っ","かたっ"],["たり"],["、"],["預言","よげん"],["を"],["し"],["たり"],["した"],["。"]]},{"verse":7,"text":"その人々は、みなで十二人ほどであった。","tok":[["その"],["人々","ひとびと"],["は"],["、"],["みな"],["で"],["十二人","じゅうににん"],["ほど"],["で"],["あった"],["。"]]},{"verse":8,"text":"それから、パウロは会堂に入って、三か月の間大胆に語り、神の国について論じて、彼らを説得しようと努めた。","tok":[["それ"],["から"],["、"],["パウロ"],["は"],["会堂","かいどう"],["に"],["入って","はいって"],["、"],["三","さん"],["か月","かげつ"],["の"],["間","あいだ"],["大胆","だいたん"],["に"],["語り","かたり"],["、"],["神","かみ"],["の"],["国","くに"],["について"],["論じて","ろんじて"],["、"],["彼","かれ"],["ら"],["を"],["説得","せっとく"],["しよう"],["と"],["努めた","つとめた"],["。"]]},{"verse":9,"text":"しかし、ある者たちが心をかたくなにして聞き入れず、会衆の前で、この道をののしったので、パウロは彼らから身を引き、弟子たちをも退かせて、毎日ツラノの講堂で論じた。","tok":[["しかし"],["、"],["ある"],["者","もの"],["たち"],["が"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["聞き入れず","ききいれず"],["、"],["会衆","かいしゅう"],["の"],["前","まえ"],["で"],["、"],["この"],["道","みち"],["を"],["ののしった"],["ので"],["、"],["パウロ"],["は"],["彼","かれ"],["ら"],["から"],["身","み"],["を"],["引き","ひき"],["、"],["弟子","でし"],["たち"],["を"],["も"],["退かせて","しりぞかせて"],["、"],["毎日","まいにち"],["ツラノ"],["の"],["講堂","こうどう"],["で"],["論じた","ろんじた"],["。"]]},{"verse":10,"text":"これが二年の間続いたので、アジヤに住む者はみな、ユダヤ人もギリシヤ人も主のことばを聞いた。","tok":[["これ"],["が"],["二","に"],["年","ねん"],["の"],["間","あいだ"],["続いた","つづいた"],["ので"],["、"],["アジヤ"],["に"],["住む","すむ"],["者","もの"],["は"],["みな"],["、"],["ユダヤ人","ゆだやじん"],["も"],["ギリシヤ"],["人","にん"],["も"],["主","ぬし"],["の"],["ことば"],["を"],["聞いた","きいた"],["。"]]},{"verse":11,"text":"神はパウロの手によって驚くべき奇蹟を行われた。","tok":[["神","かみ"],["は"],["パウロ"],["の"],["手","て"],["によって"],["驚くべき","おどろくべき"],["奇蹟","きせき"],["を"],["行われた","おこなわれた"],["。"]]},{"verse":12,"text":"パウロの身に着けている手ぬぐいや前掛けをはずして病人に当てると、その病気は去り、悪霊は出て行った。","tok":[["パウロ"],["の"],["身","み"],["に"],["着けて","つけて"],["いる"],["手ぬぐい","てぬぐい"],["や"],["前掛け","まえかけ"],["を"],["はずして"],["病人","びょうにん"],["に"],["当てる","あてる"],["と"],["、"],["その"],["病気","びょうき"],["は"],["去り","さり"],["、"],["悪霊","あくりょう"],["は"],["出て","でて"],["行った","いった"],["。"]]},{"verse":13,"text":"ところが、諸国を巡回しているユダヤ人の魔よけ祈祷師の中のある者たちも、ためしに、悪霊につかれている者に向かって主イエスの御名をとなえ、「パウロの宣べ伝えているイエスによって、おまえたちに命じる」と言ってみた。","tok":[["ところ"],["が"],["、"],["諸国","しょこく"],["を"],["巡回","じゅんかい"],["して"],["いる"],["ユダヤ人","ゆだやじん"],["の"],["魔よけ","まよけ"],["祈祷師","きとうし"],["の"],["中","なか"],["の"],["ある"],["者","もの"],["たち"],["も"],["、"],["ためし"],["に"],["、"],["悪霊","あくりょう"],["に"],["つかれて"],["いる"],["者","もの"],["に"],["向かって","むかって"],["主","しゅ"],["イエス"],["の"],["御名","ぎょめい"],["を"],["となえ"],["、"],["「"],["パウロ"],["の"],["宣べ伝えて","のべつたえて"],["いる"],["イエス"],["によって"],["、"],["おまえ"],["たち"],["に"],["命じる","めいじる"],["」"],["と"],["言って","いって"],["みた"],["。"]]},{"verse":14,"text":"そういうことをしたのは、ユダヤの祭司長スケワという人の七人の息子たちであった。","tok":[["そう"],["いう"],["こと"],["を"],["した"],["の"],["は"],["、"],["ユダヤ"],["の"],["祭","まつり"],["司長","しちょう"],["スケワ"],["と"],["いう"],["人","ひと"],["の"],["七人","しちにん"],["の"],["息子","むすこ"],["たち"],["で"],["あった"],["。"]]},{"verse":15,"text":"すると悪霊が答えて、「自分はイエスを知っているし、パウロもよく知っている。けれどおまえたちは何者だ」と言った。","tok":[["する"],["と"],["悪霊","あくりょう"],["が"],["答えて","こたえて"],["、"],["「"],["自分","じぶん"],["は"],["イエス"],["を"],["知って","しって"],["いる"],["し"],["、"],["パウロ"],["も"],["よく"],["知って","しって"],["いる"],["。"],["けれど"],["おまえ"],["たち"],["は"],["何者","なにもの"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":16,"text":"そして悪霊につかれている人は、彼らに飛びかかり、ふたりの者を押さえつけて、みなを打ち負かしたので、彼らは裸にされ、傷を負ってその家を逃げ出した。","tok":[["そして"],["悪霊","あくりょう"],["に"],["つかれて"],["いる"],["人","ひと"],["は"],["、"],["彼","かれ"],["ら"],["に"],["飛びかかり","とびかかり"],["、"],["ふたり"],["の"],["者","もの"],["を"],["押さえつけて","おさえつけて"],["、"],["みな"],["を"],["打ち負かした","うちまかした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["裸","はだか"],["に"],["され"],["、"],["傷","きず"],["を"],["負って","おって"],["その"],["家","いえ"],["を"],["逃げ出した","にげだした"],["。"]]},{"verse":17,"text":"このことがエペソに住むユダヤ人とギリシヤ人の全部に知れ渡ったので、みな恐れを感じて、主イエスの御名をあがめるようになった。","tok":[["この"],["こと"],["が"],["エペソ"],["に"],["住む","すむ"],["ユダヤ人","ゆだやじん"],["と"],["ギリシヤ"],["人","にん"],["の"],["全部","ぜんぶ"],["に"],["知れ渡った","しれわたった"],["ので"],["、"],["みな"],["恐れ","おそれ"],["を"],["感じて","かんじて"],["、"],["主","しゅ"],["イエス"],["の"],["御名","ぎょめい"],["を"],["あがめる"],["よう"],["に"],["なった"],["。"]]},{"verse":18,"text":"そして、信仰に入った人たちの中から多くの者がやって来て、自分たちのしていることをさらけ出して告白した。","tok":[["そして"],["、"],["信仰","しんこう"],["に"],["入った","はいった"],["人","ひと"],["たち"],["の"],["中","なか"],["から"],["多く","おおく"],["の"],["者","もの"],["が"],["やって"],["来て","きて"],["、"],["自分","じぶん"],["たち"],["の"],["して"],["いる"],["こと"],["を"],["さらけ出して","さらけだして"],["告白","こくはく"],["した"],["。"]]},{"verse":19,"text":"また魔術を行っていた多くの者が、その書物をかかえて来て、みなの前で焼き捨てた。その値段を合計してみると、銀貨五万枚になった。","tok":[["また"],["魔術","まじゅつ"],["を"],["行って","おこなって"],["いた"],["多く","おおく"],["の"],["者","もの"],["が"],["、"],["その"],["書物","しょもつ"],["を"],["かかえて"],["来て","きて"],["、"],["みな"],["の"],["前","まえ"],["で"],["焼き捨てた","やきすてた"],["。"],["その"],["値段","ねだん"],["を"],["合計","ごうけい"],["して"],["みる"],["と"],["、"],["銀貨","ぎんか"],["五万枚","ごまんまい"],["に"],["なった"],["。"]]},{"verse":20,"text":"こうして、主のことばは驚くほど広まり、ますます力強くなって行った。","tok":[["こう"],["して"],["、"],["主","ぬし"],["の"],["ことば"],["は"],["驚く","おどろく"],["ほど"],["広まり","ひろまり"],["、"],["ますます"],["力強く","ちからづよく"],["なって"],["行った","いった"],["。"]]},{"verse":21,"text":"これらのことが一段落すると、パウロは御霊の示しにより、マケドニヤとアカヤを通ったあとでエルサレムに行くことにした。そして、「私はそこに行ってから、ローマも見なければならない」と言った。","tok":[["これ"],["ら"],["の"],["こと"],["が"],["一段落","いちだんらく"],["する"],["と"],["、"],["パウロ"],["は"],["御霊","ごれい"],["の"],["示し","しめし"],["に"],["より"],["、"],["マケドニヤ"],["と"],["アカヤ"],["を"],["通った","とおった"],["あと"],["で"],["エルサレム"],["に"],["行く","いく"],["こと"],["に"],["した"],["。"],["そして"],["、"],["「"],["私","わたくし"],["は"],["そこ"],["に"],["行って","いって"],["から"],["、"],["ローマ"],["も"],["見なければ","みなければ"],["ならない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":22,"text":"そこで、自分に仕えている者の中からテモテとエラストのふたりをマケドニヤに送り出したが、パウロ自身は、なおしばらくアジヤにとどまっていた。","tok":[["そこ"],["で"],["、"],["自分","じぶん"],["に"],["仕えて","つかえて"],["いる"],["者","もの"],["の"],["中","なか"],["から"],["テモテ"],["と"],["エラスト"],["の"],["ふたり"],["を"],["マケドニヤ"],["に"],["送り出した","おくりだした"],["が"],["、"],["パウロ"],["自身","じしん"],["は"],["、"],["なお"],["しばらく"],["アジヤ"],["に"],["とどまって"],["いた"],["。"]]},{"verse":23,"text":"そのころ、この道のことから、ただならぬ騒動が持ち上がった。","tok":[["その"],["ころ"],["、"],["この"],["道","みち"],["の"],["こと"],["から"],["、"],["ただ"],["ならぬ"],["騒動","そうどう"],["が"],["持ち上がった","もちあがった"],["。"]]},{"verse":24,"text":"それというのは、デメテリオという銀細工人がいて、銀でアルテミス神殿の模型を作り、職人たちにかなりの収入を得させていたが、","tok":[["それ"],["と"],["いう"],["の"],["は"],["、"],["デメテリオ"],["と"],["いう"],["銀","ぎん"],["細工人","さいくにん"],["が"],["いて"],["、"],["銀","ぎん"],["で"],["アルテミス"],["神殿","しんでん"],["の"],["模
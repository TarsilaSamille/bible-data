[{"verse":1,"text":"イコニオムでも、ふたりは連れ立ってユダヤ人の会堂に入り、話をすると、ユダヤ人もギリシヤ人も大ぜいの人々が信仰に入った。","tok":[["イコニオム"],["で"],["も"],["、"],["ふたり"],["は"],["連れ立って","つれだって"],["ユダヤ人","ゆだやじん"],["の"],["会堂","かいどう"],["に"],["入り","はいり"],["、"],["話","はなし"],["を"],["する"],["と"],["、"],["ユダヤ人","ゆだやじん"],["も"],["ギリシヤ"],["人","にん"],["も"],["大ぜい","おおぜい"],["の"],["人々","ひとびと"],["が"],["信仰","しんこう"],["に"],["入った","はいった"],["。"]]},{"verse":2,"text":"しかし、信じようとしないユダヤ人たちは、異邦人たちをそそのかして、兄弟たちに対し悪意を抱かせた。","tok":[["しかし"],["、"],["信じよう","しんじよう"],["と"],["しない"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["異邦人","いほうじん"],["たち"],["を"],["そそのかして"],["、"],["兄弟","きょうだい"],["たち"],["に"],["対し","たいし"],["悪意","あくい"],["を"],["抱かせた","いだかせた"],["。"]]},{"verse":3,"text":"それでも、ふたりは長らく滞在し、主によって大胆に語った。主は、彼らの手にしるしと不思議なわざを行わせ、御恵みのことばの証明をされた。","tok":[["それ"],["で"],["も"],["、"],["ふたり"],["は"],["長らく","ながらく"],["滞在","たいざい"],["し"],["、"],["主に","おもに"],["よって"],["大胆","だいたん"],["に"],["語った","かたった"],["。"],["主","ぬし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["しるし"],["と"],["不思議","ふしぎ"],["な"],["わざ"],["を"],["行わせ","おこなわせ"],["、"],["御恵み","おめぐみ"],["の"],["ことば"],["の"],["証明","しょうめい"],["を"],["された"],["。"]]},{"verse":4,"text":"ところが、町の人々は二派に分かれ、ある者はユダヤ人の側につき、ある者は使徒たちの側についた。","tok":[["ところ"],["が"],["、"],["町","まち"],["の"],["人々","ひとびと"],["は"],["二派","には"],["に"],["分かれ","わかれ"],["、"],["ある"],["者","もの"],["は"],["ユダヤ人","ゆだやじん"],["の"],["側","がわ"],["に"],["つき"],["、"],["ある"],["者","もの"],["は"],["使徒","しと"],["たち"],["の"],["側","がわ"],["に"],["ついた"],["。"]]},{"verse":5,"text":"異邦人とユダヤ人が彼らの指導者たちといっしょになって、使徒たちをはずかしめて、石打ちにしようと企てたとき、","tok":[["異邦人","いほうじん"],["と"],["ユダヤ人","ゆだやじん"],["が"],["彼","かれ"],["ら"],["の"],["指導者","しどうしゃ"],["たち"],["と"],["いっしょ"],["に"],["なって"],["、"],["使徒","しと"],["たち"],["を"],["はずかしめて"],["、"],["石打ち","いしうち"],["に"],["しよう"],["と"],["企てた","くわだてた"],["とき"],["、"]]},{"verse":6,"text":"ふたりはそれを知って、ルカオニヤの町であるルステラとデルベ、およびその付近の地方に難を避け、","tok":[["ふたり"],["は"],["それ"],["を"],["知って","しって"],["、"],["ルカオニヤ"],["の"],["町","まち"],["で"],["ある"],["ルステラ"],["と"],["デルベ"],["、"],["および"],["その"],["付近","ふきん"],["の"],["地方","ちほう"],["に"],["難","なん"],["を"],["避け","さけ"],["、"]]},{"verse":7,"text":"そこで福音の宣教を続けた。","tok":[["そこ"],["で"],["福音","ふくいん"],["の"],["宣教","せんきょう"],["を"],["続けた","つづけた"],["。"]]},{"verse":8,"text":"ルステラでのことであるが、ある足のきかない人がすわっていた。彼は生まれつき足のなえた人で、歩いたことがなかった。","tok":[["ルステラ"],["で"],["の"],["こと"],["で"],["ある"],["が"],["、"],["ある"],["足","あし"],["の"],["きかない"],["人","ひと"],["が"],["すわって"],["いた"],["。"],["彼","かれ"],["は"],["生まれつき","うまれつき"],["足","あし"],["の"],["なえた"],["人","ひと"],["で"],["、"],["歩いた","あるいた"],["こと"],["が"],["なかった"],["。"]]},{"verse":9,"text":"この人がパウロの話すことに耳を傾けていた。パウロは彼に目を留め、いやされる信仰があるのを見て、","tok":[["この"],["人","ひと"],["が"],["パウロ"],["の"],["話す","はなす"],["こと"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["いた"],["。"],["パウロ"],["は"],["彼","かれ"],["に"],["目","め"],["を"],["留め","とめ"],["、"],["いや"],["される"],["信仰","しんこう"],["が"],["ある"],["の"],["を"],["見て","みて"],["、"]]},{"verse":10,"text":"大声で、「自分の足で、まっすぐに立ちなさい」と言った。すると彼は飛び上がって、歩き出した。","tok":[["大声","おおごえ"],["で"],["、"],["「"],["自分","じぶん"],["の"],["足","あし"],["で"],["、"],["まっすぐ"],["に"],["立ち","たち"],["なさい"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["彼","かれ"],["は"],["飛び上がって","とびあがって"],["、"],["歩き","あるき"],["出した","だした"],["。"]]},{"verse":11,"text":"パウロのしたことを見た群衆は、声を張り上げ、ルカオニヤ語で、「神々が人間の姿をとって、私たちのところにお下りになったのだ」と言った。","tok":[["パウロ"],["の"],["した"],["こと"],["を"],["見た","みた"],["群衆","ぐんしゅう"],["は"],["、"],["声","こえ"],["を"],["張り上げ","はりあげ"],["、"],["ルカオニヤ"],["語","ご"],["で"],["、"],["「"],["神々","かみがみ"],["が"],["人間","にんげん"],["の"],["姿","すがた"],["を"],["とって"],["、"],["私たち","わたしたち"],["の"],["ところ"],["に"],["お下り","おくだり"],["に"],["なった"],["の"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"そして、バルナバをゼウスと呼び、パウロがおもに話す人であったので、パウロをヘルメスと呼んだ。","tok":[["そして"],["、"],["バルナバ"],["を"],["ゼウス"],["と"],["呼び","よび"],["、"],["パウロ"],["が"],["おもに"],["話す","はなす"],["人","ひと"],["で"],["あった"],["ので"],["、"],["パウロ"],["を"],["ヘルメス"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":13,"text":"すると、町の門の前にあるゼウス神殿の祭司は、雄牛数頭と花飾りを門の前に携えて来て、群衆といっしょに、いけにえをささげようとした。","tok":[["する"],["と"],["、"],["町","まち"],["の"],["門","もん"],["の"],["前","まえ"],["に"],["ある"],["ゼウス"],["神殿","しんでん"],["の"],["祭司","さいし"],["は"],["、"],["雄牛","おうし"],["数頭","すうとう"],["と"],["花飾り","はなかざり"],["を"],["門","もん"],["の"],["前","まえ"],["に"],["携えて","たずさえて"],["来て","きて"],["、"],["群衆","ぐんしゅう"],["と"],["いっしょ"],["に"],["、"],["いけにえ"],["を"],["ささげよう"],["と"],["した"],["。"]]},{"verse":14,"text":"これを聞いた使徒たち、バルナバとパウロは、衣を裂いて、群衆の中に駆け込み、叫びながら、","tok":[["これ"],["を"],["聞いた","きいた"],["使徒","しと"],["たち"],["、"],["バルナバ"],["と"],["パウロ"],["は"],["、"],["衣","ころも"],["を"],["裂いて","さいて"],["、"],["群衆","ぐんしゅう"],["の"],["中","なか"],["に"],["駆け込み","かけこみ"],["、"],["叫び","さけび"],["ながら"],["、"]]},{"verse":15,"text":"言った。「皆さん。どうしてこんなことをするのですか。私たちも皆さんと同じ人間です。そして、あなたがたがこのようなむなしいことを捨てて、天と地と海とその中にあるすべてのものをお造りになった生ける神に立ち返るように、福音を宣べ伝えている者たちです。","tok":[["言った","いった"],["。"],["「"],["皆","みな"],["さん"],["。"],["どう"],["して"],["こんな"],["こと"],["を"],["する"],["の"],["です"],["か"],["。"],["私たち","わたしたち"],["も"],["皆","みな"],["さん"],["と"],["同じ","おなじ"],["人間","にんげん"],["です"],["。"],["そして"],["、"],["あなた"],["がた"],["が"],["この"],["よう"],["な"],["むなしい"],["こと"],["を"],["捨てて","すてて"],["、"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["と"],["その"],["中","なか"],["に"],["ある"],["すべて"],["の"],["もの"],["を"],["お造り","おつくり"],["に"],["なった"],["生ける","いける"],["神","かみ"],["に"],["立ち返る","たちかえる"],["よう"],["に"],["、"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["いる"],["者","もの"],["たち"],["です"],["。"]]},{"verse":16,"text":"過ぎ去った時代には、神はあらゆる国の人々がそれぞれ自分の道を歩むことを許しておられました。","tok":[["過ぎ去った","すぎさった"],["時代","じだい"],["に"],["は"],["、"],["神","かみ"],["は"],["あらゆる"],["国","くに"],["の"],["人々","ひとびと"],["が"],["それぞれ"],["自分","じぶん"],["の"],["道","みち"],["を"],["歩む","あゆむ"],["こと"],["を"],["許して","ゆるして"],["おられました"],["。"]]},{"verse":17,"text":"とはいえ、ご自身のことをあかししないでおられたのではありません。すなわち、恵みをもって、天から雨を降らせ、実りの季節を与え、食物と喜びとで、あなたがたの心を満たしてくださったのです。」","tok":[["と"],["は"],["いえ"],["、"],["ご自身","ごじしん"],["の"],["こと"],["を"],["あかし"],["しないで"],["おられた"],["ので"],["は"],["ありません"],["。"],["すなわち"],["、"],["恵み","めぐみ"],["を"],["もって"],["、"],["天","てん"],["から"],["雨","あめ"],["を"],["降らせ","ふらせ"],["、"],["実り","みのり"],["の"],["季節","きせつ"],["を"],["与え","あたえ"],["、"],["食物","しょくもつ"],["と"],["喜び","よろこび"],["と"],["で"],["、"],["あな
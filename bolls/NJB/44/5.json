[{"verse":1,"text":"ところが、アナニヤという人は、妻のサッピラとともにその持ち物を売り、","tok":[["ところ"],["が"],["、"],["アナニヤ"],["と"],["いう"],["人","ひと"],["は"],["、"],["妻","つま"],["の"],["サッピラ"],["と"],["とも"],["に"],["その"],["持ち物","もちもの"],["を"],["売り","うり"],["、"]]},{"verse":2,"text":"妻も承知のうえで、その代金の一部を残しておき、ある部分を持って来て、使徒たちの足もとに置いた。","tok":[["妻","つま"],["も"],["承知","しょうち"],["の"],["うえ"],["で"],["、"],["その"],["代金","だいきん"],["の"],["一部","いちぶ"],["を"],["残して","のこして"],["おき"],["、"],["ある"],["部分","ぶぶん"],["を"],["持って","もって"],["来て","きて"],["、"],["使徒","しと"],["たち"],["の"],["足もと","あしもと"],["に"],["置いた","おいた"],["。"]]},{"verse":3,"text":"そこで、ペテロがこう言った。「アナニヤ。どうしてあなたはサタンに心を奪われ、聖霊を欺いて、地所の代金の一部を自分のために残しておいたのか。","tok":[["そこ"],["で"],["、"],["ペテロ"],["が"],["こう"],["言った","いった"],["。"],["「"],["アナニヤ"],["。"],["どう"],["して"],["あなた"],["は"],["サタン"],["に"],["心","こころ"],["を"],["奪われ","うばわれ"],["、"],["聖霊","せいれい"],["を"],["欺いて","あざむいて"],["、"],["地所","じしょ"],["の"],["代金","だいきん"],["の"],["一部","いちぶ"],["を"],["自分","じぶん"],["の"],["ため"],["に"],["残して","のこして"],["おいた"],["の"],["か"],["。"]]},{"verse":4,"text":"それはもともとあなたのものであり、売ってからもあなたの自由になったのではないか。なぜこのようなことをたくらんだのか。あなたは人を欺いたのではなく、神を欺いたのだ。」","tok":[["それ"],["は"],["もともと"],["あなた"],["の"],["もの"],["で"],["あり"],["、"],["売って","うって"],["から"],["も"],["あなた"],["の"],["自由","じゆう"],["に"],["なった"],["ので"],["は"],["ない"],["か"],["。"],["なぜ"],["この"],["よう"],["な"],["こと"],["を"],["たくらんだ"],["の"],["か"],["。"],["あなた"],["は"],["人","ひと"],["を"],["欺いた","あざむいた"],["ので"],["は"],["なく"],["、"],["神","かみ"],["を"],["欺いた","あざむいた"],["の"],["だ"],["。"],["」"]]},{"verse":5,"text":"アナニヤはこのことばを聞くと、倒れて息が絶えた。そして、これを聞いたすべての人に、非常な恐れが生じた。","tok":[["アナニヤ"],["は"],["この"],["ことば"],["を"],["聞く","きく"],["と"],["、"],["倒れて","たおれて"],["息","いき"],["が"],["絶えた","たえた"],["。"],["そして"],["、"],["これ"],["を"],["聞いた","きいた"],["すべて"],["の"],["人","ひと"],["に"],["、"],["非常","ひじょう"],["な"],["恐れ","おそれ"],["が"],["生じた","しょうじた"],["。"]]},{"verse":6,"text":"青年たちは立って、彼を包み、運び出して葬った。","tok":[["青年","せいねん"],["たち"],["は"],["立って","たって"],["、"],["彼","かれ"],["を"],["包み","つつみ"],["、"],["運び出して","はこびだして"],["葬った","ほうむった"],["。"]]},{"verse":7,"text":"三時間ほどたって、彼の妻はこ
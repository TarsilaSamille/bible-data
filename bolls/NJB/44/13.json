[{"verse":1,"text":"さて、アンテオケには、そこにある教会に、バルナバ、ニゲルと呼ばれるシメオン、クレネ人ルキオ、国主ヘロデの乳兄弟マナエン、サウロなどという預言者や教師がいた。","tok":[["さて"],["、"],["アンテオケ"],["に"],["は"],["、"],["そこ"],["に"],["ある"],["教会","きょうかい"],["に"],["、"],["バルナバ"],["、"],["ニゲル"],["と"],["呼ばれる","よばれる"],["シメオン"],["、"],["クレネ人","くれねにん"],["ルキオ"],["、"],["国主","こくしゅ"],["ヘロデ"],["の"],["乳","にゅう"],["兄弟","きょうだい"],["マナエン"],["、"],["サウロ"],["など"],["と"],["いう"],["預言者","よげんしゃ"],["や"],["教師","きょうし"],["が"],["いた"],["。"]]},{"verse":2,"text":"彼らが主を礼拝し、断食をしていると、聖霊が、「バルナバとサウロをわたしのために聖別して、わたしが召した任務につかせなさい」と言われた。","tok":[["彼","かれ"],["ら"],["が"],["主","ぬし"],["を"],["礼拝","れいはい"],["し"],["、"],["断食","だんじき"],["を"],["して"],["いる"],["と"],["、"],["聖霊","せいれい"],["が"],["、"],["「"],["バルナバ"],["と"],["サウロ"],["を"],["わたし"],["の"],["ため"],["に"],["聖別","せいべつ"],["して"],["、"],["わたし"],["が"],["召した","めした"],["任務","にんむ"],["に"],["つかせ"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"そこで彼らは、断食と祈りをして、ふたりの上に手を置いてから、送り出した。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["断食","だんじき"],["と"],["祈り","いのり"],["を"],["して"],["、"],["ふたり"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置いて","おいて"],["から"],["、"],["送り出した","おくりだした"],["。"]]},{"verse":4,"text":"ふたりは聖霊に遣わされて、セルキヤに下り、そこから船でキプロスに渡った。","tok":[["ふたり"],["は"],["聖霊","せいれい"],["に"],["遣わされて","つかわされて"],["、"],["セルキヤ"],["に"],["下り","くだり"],["、"],["そこ"],["から"],["船","ふね"],["で"],["キプロス"],["に"],["渡った","わたった"],["。"]]},{"verse":5,"text":"サラミスに着くと、ユダヤ人の諸会堂で神のことばを宣べ始めた。彼らはヨハネを助手として連れていた。","tok":[["サラミス"],["に"],["着く","つく"],["と"],["、"],["ユダヤ人","ゆだやじん"],["の"],["諸","しょ"],["会堂","かいどう"],["で"],["神","かみ"],["の"],["ことば"],["を"],["宣べ","のべ"],["始めた","はじめた"],["。"],["彼","かれ"],["ら"],["は"],["ヨハネ"],["を"],["助手","じょしゅ"],["として"],["連れて","つれて"],["いた"],["。"]]},{"verse":6,"text":"島全体を巡回して、パポスまで行ったところ、にせ預言者で、名をバルイエスというユダヤ人の魔術師に出会った。","tok":[["島","とう"],["全体","ぜんたい"],["を"],["巡回","じゅんかい"],["して"],["、"],["パポス"],["まで"],["行った","いった"],["ところ"],["、"],["にせ"],["預言者","よげんしゃ"],["で"],["、"],["名","な"],["を"],["バルイエス"],["と"],["いう"],["ユダヤ人","ゆだやじん"],["の"],["魔術師","まじゅつし"],["に"],["出会った","であった"],["。"]]},{"verse":7,"text":"この男は地方総督セルギオ・パウロのもとにいた。この総督は賢明な人であって、バルナバとサウロを招いて、神のことばを聞きたいと思っていた。","tok":[["この"],["男","おとこ"],["は"],["地方","ちほう"],["総督","そうとく"],["セルギオ"],["・"],["パウロ"],["の"],["もと"],["に"],["いた"],["。"],["この"],["総督","そうとく"],["は"],["賢明","けんめい"],["な"],["人","ひと"],["で"],["あって"],["、"],["バルナバ"],["と"],["サウロ"],["を"],["招いて","まねいて"],["、"],["神","かみ"],["の"],["ことば"],["を"],["聞きたい","ききたい"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":8,"text":"ところが、魔術師エルマ(エルマという名を訳すと魔術師)は、ふたりに反対して、総督を信仰の道から遠ざけようとした。","tok":[["ところ"],["が"],["、"],["魔術師","まじゅつし"],["エルマ"],["("],["エルマ"],["と"],["いう"],["名","な"],["を"],["訳す","やくす"],["と"],["魔術師","まじゅつし"],[")"],["は"],["、"],["ふたり"],["に"],["反対","はんたい"],["して"],["、"],["総督","そうとく"],["を"],["信仰","しんこう"],["の"],["道","みち"],["から"],["遠ざけよう","とおざけよう"],["と"],["した"],["。"]]},{"verse":9,"text":"しかし、サウロ、別名でパウロは、聖霊に満たされ、彼をにらみつけて、","tok":[["しかし"],["、"],["サウロ"],["、"],["別名","べつめい"],["で"],["パウロ"],["は"],["、"],["聖霊","せいれい"],["に"],["満たされ","みたされ"],["、"],["彼","かれ"],["を"],["にらみつけて"],["、"]]},{"verse":10,"text":"言った。「ああ、あらゆる偽りとよこしまに満ちた者、悪魔の子、すべての正義の敵。おまえは、主のまっすぐな道を曲げることをやめないのか。","tok":[["言った","いった"],["。"],["「"],["ああ"],["、"],["あらゆる"],["偽り","いつわり"],["と"],["よこしま"],["に"],["満ちた","みちた"],["者","もの"],["、"],["悪魔","あくま"],["の"],["子","こ"],["、"],["すべて"],["の"],["正義","せいぎ"],["の"],["敵","てき"],["。"],["おまえ"],["は"],["、"],["主","ぬし"],["の"],["まっすぐ"],["な"],["道","みち"],["を"],["曲げる","まげる"],["こと"],["を"],["やめない"],["の"],["か"],["。"]]},{"verse":11,"text":"見よ。主の御手が今、おまえの上にある。おまえは盲目になって、しばらくの間、日の光を見ることができなくなる」と言った。するとたちまち、かすみとやみが彼をおおったので、彼は手を引いてくれる人を捜し回った。","tok":[["見","み"],["よ"],["。"],["主","ぬし"],["の"],["御手","おて"],["が"],["今","いま"],["、"],["おまえ"],["の"],["上","うえ"],["に"],["ある"],["。"],["おまえ"],["は"],["盲目","もうもく"],["に"],["なって"],["、"],["しばらく"],["の"],["間","あいだ"],["、"],["日","ひ"],["の"],["光","ひかり"],["を"],["見る","みる"],["こと"],["が"],["できなく"],["なる"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["たちまち"],["、"],["かすみ"],["と"],["やみ"],["が"],["彼","かれ"],["を"],["おおった"],["ので"],["、"],["彼","かれ"],["は"],["手","て"],["を"],["引いて","ひいて"],["くれる"],["人","ひと"],["を"],["捜し回った","さがしまわった"],["。"]]},{"verse":12,"text":"この出来事を見た総督は、主の教えに驚嘆して信仰に入った。","tok":[["この"],["出来事","できごと"],["を"],["見た","みた"],["総督","そうとく"],["は"],["、"],["主","ぬし"],["の"],["教え","おしえ"],["に"],["驚嘆","きょうたん"],["して"],["信仰","しんこう"],["に"],["入った","はいった"],["。"]]},{"verse":13,"text":"パウロの一行は、パポスから船出して、パンフリヤのペルガに渡った。ここでヨハネは一行から離れて、エルサレムに帰った。","tok":[["パウロ"],["の"],["一行","いっこう"],["は"],["、"],["パポス"],["から"],["船出","ふなで"],["して"],["、"],["パンフリヤ"],["の"],["ペルガ"],["に"],["渡った","わたった"],["。"],["ここ"],["で"],["ヨハネ"],["は"],["一行","いっこう"],["から"],["離れて","はなれて"],["、"],["エルサレム"],["に"],["帰った","かえった"],["。"]]},{"verse":14,"text":"しかし彼らは、ペルガから進んでピシデヤのアンテオケに行き、安息日に会堂に入って席に着いた。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["、"],["ペルガ"],["から"],["進んで","すすんで"],["ピシデヤ"],["の"],["アンテオケ"],["に"],["行き","いき"],["、"],["安息日","あんそくび"],["に"],["会堂","かいどう"],["に"],["入って","はいって"],["席","せき"],["に"],["着いた","ついた"],["。"]]},{"verse":15,"text":"律法と預言者の朗読があって後、会堂の管理者たちが、彼らのところに人をやってこう言わせた。「兄弟たち。あなたがたのうちどなたか、この人たちのために奨励のことばがあったら、どうぞお話しください。」","tok":[["律法","りっぽう"],["と"],["預言者","よげんしゃ"],["の"],["朗読","ろうどく"],["が"],["あって"],["後","あと"],["、"],["会堂","かいどう"],["の"],["管理者","かんりしゃ"],["たち"],["が"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["人","ひと"],["を"],["やって"],["こう"],["言わせた","いわせた"],["。"],["「"],["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["の"],["うち"],["どなた"],["か"],["、"],["この"],["人","ひと"],["たち"],["の"],["ため"],["に"],["奨励","しょうれい"],["の"],["ことば"],["が"],["あったら"],["、"],["どうぞ"],["お話し","おはなし"],["ください"],["。"],["」"]]},{"verse":16,"text":"そこでパウロが立ち上がり、手を振りながら言った。「イスラエルの人たち、ならびに神を恐れかしこむ方々。よく聞いてください。","tok":[["そこ"],["で"],["パウロ"],["が"],["立ち上がり","たちあがり"],["、"],["手","て"],["を"],["振り","ふり"],["ながら"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["人","ひと"],["たち"],["、"],["ならびに"],["神","かみ"],["を"],["恐れ","おそれ"],["かしこむ"],["方々","かたがた"],["。"],["よく"],["聞いて","きいて"],["ください"],["。"]]},{"verse":17,"text":"この民イスラエルの神は、私たちの父祖たちを選び、民がエジプトの地に滞在していた間にこれを強大にし、御腕を高く上げて、彼らをその地から導き出してくださいました。","tok":[["この"],["民","みん"],["イスラエル"],["の"],["神","かみ"],["は"],["、"],["私たち","わたしたち"],["の"],["父祖","ふそ"],["たち"],["を"],["選び","えらび"],["、"],["民","みん"],["が"],["エジプト"],["の"],["地","ち"],["に"],["滞在","たいざい"],["して"],["いた"],["間","あいだ"],["に"],["これ"],["を"],["強大","きょうだい"],["に"],["し"],["、"],["御腕","おうで"],["を"],["高く","たかく"],["上げて","あげて"],["、"],["彼","かれ"],["ら"],["を"],["その"],["地","ち"],["から"],["導き出して","みちびきだして"],["くださいました"],["。"]]},{"verse":18,"text":"そして約四十年間、荒野で彼らを耐え忍ばれました。","tok":[["そして"],["約","やく"],["四十","よんじゅう"],["年間","ねんかん"],["、"],["荒野","こうや"],["で"],["彼","かれ"],["ら"],["を"],["耐え忍ばれました","たえしのばれました"],["。"]]},{"verse":19,"text":"それからカナンの地で、七つの民を滅ぼし、その地を相続財産として分配されました。これが、約四百五十年間のことです。","tok":[["それ"],["から"],["カナン"],["の"],["地","ち"],["で"],["、"],["七","なな"],["つ"],["の"],["民","たみ"],["を"],["滅ぼし","ほろぼし"],["、"],["その"],["地","ち"],["を"],["相続","そうぞく"],["財産","ざいさん"],["として"],["分配","ぶんぱい"],["されました"],["。"],["これ"],["が"],["、"],["約","やく"],["四百五十","よんひゃくごじゅう"],["年間","ねんかん"],["の"],["こと"],["です"],["。"]]},{"verse":20,"text":"その後、預言者サムエルの時代までは、さばき人たちをお遣わしになりました。","tok":[["その"],["後","ご"],["、"],["預言者","よげんしゃ"],["サムエル"],["の"],["時代","じだい"],["まで"],["は"],["、"],["さばき人","さばきにん"],["たち"],["を"],["お遣わし","おつかわし"],["に"],["なりました"],["。"]]},{"verse":21,"text":"それから彼らが王をほしがったので、神はベニヤミン族の人、キスの子サウロを四十年間お与えになりました。","tok":[["それ"],["から"],["彼","かれ"],["ら"],["が"],["王","おう"],["を"],["ほし"],["がっ"],["た"],["ので"],["、"],["神","かみ"],["は"],["ベニヤミン"],["族","ぞく"],["の"],["人","ひと"],["、"],["キス"],["の"],["子","こ"],["サウロ"],["を"],["四十","よんじゅう"],["年間","ねんかん"],["お与え","おあたえ"],["に"],["なりました"],["。"]]},{"verse":22,"text":"それから、彼を退けて、ダビデを立てて王とされましたが、このダビデについてあかしして、こう言われました。『わたしはエッサイの子ダビデを見いだした。彼はわたしの心にかなった者で、わたしのこころを余すところなく実行する。』","tok":[["それ"],["から"],["、"],["彼","かれ"],["を"],["退けて","しりぞけて"],["、"],["ダビデ"],["を"],["立てて","たてて"],["王","おう"],["と"],["されました"],["が"],["、"],["この"],["ダビデ"],["について"],["あかし"],["して"],["、"],["こう"],["言われました","いわれました"],["。"],["『"],["わたし"],["は"],["エッサイ"],["の"],["子","こ"],["ダビデ"],["を"],["見いだした","みいだした"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["心","こころ"],["に"],["かなった"],["者","もの"],["で"],["、"],["わたし"],["の"],["こころ"],["を"],["余す","あます"],["ところ"],["なく"],["実行","じっこう"],["する"],["。"],["』"]]},{"verse":23,"text":"神は、このダビデの子孫から、約束に従って、イスラエルに救い主イエスをお送りになりました。","tok":[["神","かみ"],["は"],["、"],["この"],["ダビデ"],["の"],["子孫","しそん"],["から"],["、"],["約束","やくそく"],["に"],["従って","したがって"],["、"],["イスラエル"],["に"],["救い主","すくいぬし"],["イエス"],["を"],["お送り","おおくり"],["に"],["なりました"],["。"]]},{"verse":24,"text":"この方がおいでになる前に、ヨハネがイスラエルのすべての民に、前もって悔い改めのバプテスマを宣べ伝えていました。","tok":[["この"],["方","ほう"],["が"],["おいで"],["に"],["なる"],["前","まえ"],["に"],["、"],["ヨハネ"],["が"],["イスラエル"],["の"],["すべて"],["の"],["民","たみ"],["に"],["、"],["前もって","まえもって"],["悔い改め","くいあらため"],["の"],["バプテスマ"],["を"],["宣べ伝えて","のべつたえて"],["いました"],["。"]]},{"verse":25,"text":"ヨハネは、その一生を終えようとするころ、こう言いました。『あなたがたは、私をだれと思うのですか。私はその方ではありません。ご覧なさい。その方は私のあとからおいでになります。私は、その方のくつのひもを解く値うちもありません。』","tok":[["ヨハネ"],["は"],["、"],["その"],["一生","いっしょう"],["を"],["終えよう","おえよう"],["と"],["する"],["ころ"],["、"],["こう"],["言いました","いいました"],["。"],["『"],["あなた"],["がた"],["は"],["、"],["私","わたくし"],["を"],["だれ"],["と"],["思う","おもう"],["の"],["です"],["か"],["。"],["私","わたくし"],["は"],["その"],["方","かた"],["で"],["は"],["ありません"],["。"],["ご覧","ごらん"],["なさい"],["。"],["その"],["方","かた"],["は"],["私","わたくし"],["の"],["あと"],["から"],["おいで"],["に"],["なります"],["。"],["私","わたくし"],["は"],["、"],["その"],["方","かた"],["の"],["くつ"],["の"],["ひも"],["を"],["解く","とく"],["値うち","ねうち"],["も"],["ありません"],["。"],["』"]]},{"verse":26,"text":"兄弟の方々、アブラハムの子孫の方々、ならびに皆さんの中で神を恐れかしこむ方々。この救いのことばは、私たちに送られているのです。","tok":[["兄弟","きょうだい"],["の"],["方々","ほうぼう"],["、"],["アブラハム"],["の"],["子孫","しそん"],["の"],["方々","ほうぼう"],["、"],["ならびに"],["皆","みな"],["さん"],["の"],["中","なか"],["で"],["神","かみ"],["を"],["恐れ","おそれ"],["かしこむ"],["方々","かたがた"],["。"],["この"],["救い","すくい"],["の"],["ことば"],["は"],["、"],["私たち","わたしたち"],["に"],["送られて","おくられて"],["いる"],["の"],["です"],["。"]]},{"verse":27,"text":"エルサレムに住む人々とその指導者たちは、このイエスを認めず、また安息日ごとに読まれる預言者のことばを理解せず、イエスを罪に定めて、その預言を成就させてしまいました。","tok":[["エルサレム"],["に"],["住む","すむ"],["人々","ひとびと"],["と"],["その"],["指導者","しどうしゃ"],["たち"],["は"],["、"],["この"],["イエス"],["を"],["認めず","みとめず"],["、"],["また"],["安息日","あんそくび"],["ごと"],["に"],["読まれる","よまれる"],["預言者","よげんしゃ"],["の"],["ことば"],["を"],["理解","りかい"],["せず"],["、"],["イエス"],["を"],["罪","つみ"],["に"],["定めて","さだめて"],["、"],["その"],["預言","よげん"],["を"],["成就","じょうじゅ"],["させて"],["しまいました"],["。"]]},{"verse":28,"text":"そして、死罪に当たる何の理由も見いだせなかったのに、イエスを殺すことをピラトに強要したのです。","tok":[["そして"],["、"],["死罪","しざい"],["に"],["当たる","あたる"],["何","なん"],["の"],["理由","りゆう"],["も"],["見いだせなかった","みいだせなかった"],["のに"],["、"],["イエス"],["を"],["殺す","ころす"],["こと"],["を"],["ピラト"],["に"],["強要","きょうよう"],["した"],["の"],["です"],["。"]]},{"verse":29,"text":"こうして、イエスについて書いてあることを全部成し終えて後、イエスを十字架から取り降ろして墓の中に納めました。","tok":[["こう"],["して"],["、"],["イエス"],["について"],["書いて","かいて"],["ある"],["こと"],["を"],["全部","ぜんぶ"],["成し","なし"],["終えて","おえて"],["後","あと"],["、"],["イエス"],["を"],["十字架","じゅうじか"],["から"],["取り降ろして","とりおろして"],["墓","はか"],["の"],["中","なか"],["に"],["納めました","おさめました"],["。"]]},{"verse":30,"text":"しかし、神はこの方を死者の中からよみがえらせたのです。","tok":[["しかし"],["、"],["神","かみ"],["は"],["この"],["方","ほう"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせた"],["の"],["です"],["。"]]},{"verse":31,"text":"イエスは幾日にもわたり、ご自分といっしょにガリラヤからエルサレムに上った人たちに、現れました。きょう、その人たちがこの民に対してイエスの証人となっています。","tok":[["イエス"],["は"],["幾日","いくか"],["に"],["も"],["わたり"],["、"],["ご自分","ごじぶん"],["と"],["いっしょ"],["に"],["ガリラヤ"],["から"],["エルサレム"],["に"],["上った","のぼった"],["人","ひと"],["たち"],["に"],["、"],["現れました","あらわれました"],["。"],["きょう"],["、"],["その"],["人","ひと"],["たち"],["が"],["この"],["民","たみ"],["に対して","にたいして"],["イエス"],["の"],["証人","しょうにん"],["と"],["なって"],["います"],["。"]]},{"verse":32,"text":"私たちは、神が父祖たちに対してなされた約束について、あなたがたに良い知らせをしているのです。","tok":[["私たち","わたしたち"],["は"],["、"],["神","かみ"],["が"],["父祖","ふそ"],["たち"],["に対して","にたいして"],["なされた"],["約束","やくそく"],["について"],["、"],["あなた"],["がた"],["に"],["良い","よい"],["知らせ","しらせ"],["を"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":33,"text":"神は、イエスをよみがえらせ、それによって、私たち子孫にその約束を果たされました。詩篇の第二篇に、『あなたは、わたしの子。きょう、わたしがあなたを生んだ』と書いてあるとおりです。","tok":[["神","かみ"],["は"],["、"],["イエス"],["を"],["よみがえらせ"],["、"],["それ"],["によって"],["、"],["私たち","わたしたち"],["子孫","しそん"],["に"],["その"],["約束","やくそく"],["を"],["果たされました","はたされました"],["。"],["詩篇","しへん"],["の"],["第","だい"],["二","に"],["篇"
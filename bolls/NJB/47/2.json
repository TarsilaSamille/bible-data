[{"verse":1,"text":"そこで私は、あなたがたを悲しませることになるような訪問は二度とくり返すまいと決心したのです。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["を"],["悲しませる","かなしませる"],["こと"],["に"],["なる"],["よう"],["な"],["訪問","ほうもん"],["は"],["二","に"],["度","ど"],["と"],["くり返すまい","くりかえすまい"],["と"],["決心","けっしん"],["した"],["の"],["です"],["。"]]},{"verse":2,"text":"もし私があなたがたを悲しませているのなら、私が悲しませているその人以外に、だれが私を喜ばせてくれるでしょうか。","tok":[["もし"],["私","わたくし"],["が"],["あなた"],["がた"],["を"],["悲しませて","かなしませて"],["いる"],["の"],["なら"],["、"],["私","わたくし"],["が"],["悲しませて","かなしませて"],["いる"],["その"],["人","ひと"],["以外","いがい"],["に"],["、"],["だれ"],["が"],["私","わたくし"],["を"],["喜ばせて","よろこばせて"],["くれるでしょう"],["か"],["。"]]},{"verse":3,"text":"あのような手紙を書いたのは、私が行くときには、私に喜びを与えてくれるはずの人たちから悲しみを与えられたくないからでした。それは、私の喜びがあなたがたすべての喜びであることを、あなたがたすべてについて確信しているからです。","tok":[["あの"],["よう"],["な"],["手紙","てがみ"],["を"],["書いた","かいた"],["の"],["は"],["、"],["私","わたくし"],["が"],["行く","いく"],["とき"],["に"],["は"],["、"],["私","わたくし"],["に"],["喜び","よろこび"],["を"],["与えて","あたえて"],["くれる"],["はず"],["の"],["人","ひと"],["たち"],["から"],["悲しみ","かなしみ"],["を"],["与えられたく","あたえられたく"],["ない"],["から"],["でした"],["。"],["それ"],["は"],["、"],["私","わたくし"],["の"],["喜び","よろこび"],["が"],["あなた"],["がた"],["すべて"],["の"],["喜び","よろこび"],["で"],["ある"],["こと"],["を"],["、"],["あなた"],["がた"],["すべて"],["について"],["確信","かくしん"],["して"],["いる"],["から"],["です"],["。"]]},{"verse":4,"text":"私は大きな苦しみと心の嘆きから、涙ながらに、あなたがたに手紙を書きました。それは、あなたがたを悲しませるためではなく、私があなたがたに対して抱いている、あふれるばかりの愛を知っていただきたいからでした。","tok":[["私","わたくし"],["は"],["大きな","おおきな"],["苦しみ","くるしみ"],["と"],["心","こころ"],["の"],["嘆き","なげき"],["から"],["、"],["涙","なみだ"],["ながら"],["に"],["、"],["あなた"],["がた"],["に"],["手紙","てがみ"],["を"],["書きました","かきました"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["を"],["悲しませる","かなしませる"],["ため"],["で"],["は"],["なく"],["、"],["私","わたくし"],["が"],["あなた"],["がた"],["に対して","にたいして"],["抱いて","いだいて"],["いる"],["、"],["あふれる"],["ばかり"],["の"],["愛","あい"],["を"],["知って","しって"],["いただきたい"],["から"],["でした"],["。"]]},{"verse":5,"text":"もしある人が悲しみのもとになったとすれば、その人は、私を悲しませたというよりも、ある程度――というのは言い過ぎにならないためですが――あなたがた全部を悲しませたのです。","tok":[["もし"],["ある"],["人","ひと"],["が"],["悲しみ","かなしみ"],["の"],["もと"],["に"],["なった"],["と"],["すれば"],["、"],["その"],["人","ひと"],["は"],["、"],["私","わたくし"],["を"],["悲しませた","かなしませた"],["と"],["いう"],["より"],["も"],["、"],["ある"],["程度","ていど"],["―"],["―"],["と"],["いう"],["の"],["は"],["言い","いい"],["過ぎ","すぎ"],["に"],["ならない"],["ため"],["です"],["が"],["―"],["―"],["あなた"],["がた"],["全部","ぜんぶ"],["を"],["悲しませた","かなしませた"],["の"],["です"],["。"]]},{"verse":6,"text":"その人にとっては、すでに多数の人から受けたあの処罰で十分ですから、","tok":[["その"],["人","ひと"],["にとって"],["は"],["、"],["すでに"],["多数","たすう"],["の"],["人","ひと"],["から"],["受けた","うけた"],["あの"],["処罰","しょばつ"],["で"],["十分","じゅうぶん"],["です"],["から"],["、"]]},{"verse":7,"text":"あなたがたは、むしろ、その人を赦し、慰めてあげなさい。そうしないと、その人はあまりにも深い悲しみに押しつぶされてしまうかもしれません。","tok":[["あなた"],["がた"],["は"],["、"],["むしろ"],["、"],["その"],["人","ひと"],["を"],["赦し","ゆるし"],["、"],["慰めて","なぐさめて"],["あげ"],["なさい"],["。"],["そう"],["しない"],["と"],["、"],["その"],["人","ひと"],["は"],["あまり"],["に"],["も"],["深い","ふかい"],["悲しみ","かなしみ"],["に"],["押しつぶされて","おしつぶされて"],["しまう"],["か"],["も"],["しれません"],["。"]]},{"verse":8,"text":"そこで私は、その人に対する愛を確認することを、あなたがたに勧めます。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["その"],["人","ひと"],["に"],["対する","たいする"],["愛","あい"],["を"],["確認","かくにん"],["する"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["勧めます","すすめます"],["。"]]},{"verse":9,"text":"私が手紙を書いたのは、あなたがたがすべてのことにおいて従順であるかどうかをためすためであったのです。","tok":[["私","わたくし"],["が"],["手紙","てがみ"],["を"],["書いた","かいた"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["すべて"],["の"],["こと"],["に"],["おいて"],["従順","じゅうじゅん"],["で"],["ある"],["か"],["どう"],["か"],["を"],["ためす"],["ため"],["で"],["あった"],["の"],["です"],["。"]]},{"verse":10,"text":"もしあなたがたが人を赦すなら、私もその人を赦します。私が何かを赦したのなら、私の赦したことは、あなたがたのために、キリストの御前で赦したのです。","tok":[["もし"],["あなた"],["がた"],["が"],["人","ひと"],["を"],["赦すなら","ゆるすなら"],["、"],["私","わたくし"],["も"],["その"],["人","ひと"],["を"],["赦します","ゆるします"],["。"],["私","わたくし"],["が"],["何","なん"],["か"],["を"],["赦した","ゆるした"],["の"],["なら"],["、"],["私","わたくし"],["の"],["赦した","ゆるした"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["キリスト"],["の"],["御前","ごぜん"],["で"],["赦した","ゆるした"],["の"],["です"],["。"]]},{"verse":11,"text":"これは、私たちがサタンに欺かれないためです。私たちはサタンの策略を知らないわけではありません。","tok":[["これ"],["は"],["、"],["私たち","わたしたち"],["が"],["サタン"],["に"],["欺かれない","あざむかれない"],["ため"],["です"],["。"],["私たち","わたしたち"],["は"],["サタン"],["の"],["策略","さくりゃく"],["を"],["知らない","しらない"],["わけ"],["で"],["は"],["ありません"],["。"]]},{"verse":12,"text":"私が、キリストの福音のためにトロアスに行ったとき、主は私のために門を開いてくださいましたが、","tok":[["私","わたくし"],["が"],["、"],["キリスト"],["の"],["福音","ふくいん"],["の"],["ため"],["に"],["トロアス"],["に"],["行った","いった"],["とき"],["、"],["主","ぬし"],["は"],["私","わたくし"],["の"],["ため"],["に"],["門","もん"],["を"],["開いて","ひらいて"],["くださいました"],["が"],["、"]]},{"verse":13,"text":"兄弟テトスに会えなかったので、心に安らぎがなく、そこの人々に別れを告げて、マケドニヤへ向かいました。","tok":[["兄弟","きょうだい"],["テトス"],["に"],["会えなかった","あえなかった"],["ので"],["、"],["心","こころ"],["に"],["安らぎ","やすらぎ"],["が"],["なく"],["、"],["そこ"],["の"],["人々","ひとびと"],["に"],["別れ","わかれ"],["を"],["告げて","つげて"],["、"],["マケドニヤ"],["へ"],["向かいました","むかいました"],["。"]]},{"verse":14,"text":"しかし、神に感謝します。神はいつでも、私たちを導いてキリストによる勝利の行列に加え、至る所で私たちを通して、キリストを知る知識のかおりを放ってくださいます。","tok":[["しかし"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["します"],["。"],["神","かみ"],["は"],["いつ"],["で"],["も"],["、"],["私たち","わたしたち"],["を"],["導いて","みちびいて"],["キリスト"],["に"],["よる"],["勝利","しょうり"],["の"],["行列","ぎょうれつ"],["に"],["加え","くわえ"],["、"],["至る所","いたるところ"],["で"],["私たち","わたしたち"],["を"],["通して","とおして"],["、"],["キリスト"],["を"],["知る","しる"],["知識","ちしき"],["の"],["かおり"],["を"],["放って","はなって"],["くださいます"],["。"]]},{"verse":15,"text":"私たちは、救われる人々の中でも、滅びる人々の中でも、神の前にかぐわしいキリストのかおりなのです。","tok":[["私たち","わたしたち"],["は"],["、"],["救われる","すくわれる"],["人々","ひとびと"],["の"],["中","なか"],["で"],["も"],["、"],["滅びる","ほろびる"],["人々","ひとびと"],["の"],["中","なか"],["で"],["も"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["かぐわしい"],["キリスト"],["の"],["かおり"],["な"],["の"],["です"],["。"]]},{"verse":16,"text":"ある人たちにとっては、死から出て死に至らせるかおりであり、ある人たちにとっては、いのちから出ていのちに至らせるかおりです。このような務めにふさわしい者は、いったいだれでしょう。","tok":[["ある"],["人","ひと"],["たち"],["にとって"],["は"],["、"],["死","し"],["から"],["出て","でて"],["死","し"],["に"],["至らせる","いたらせる"],["かおり"],["で"],["あり"],["、"],["ある"],["人","ひと"],["たち"],["にとって"],["は
[{"verse":1,"text":"愛する者たち。私たちはこのような約束を与えられているのですから、いっさいの霊肉の汚れから自分をきよめ、神を恐れかしこんで聖きを全うしようではありませんか。","tok":[["愛する","あいする"],["者","もの"],["たち"],["。"],["私たち","わたしたち"],["は"],["この"],["よう"],["な"],["約束","やくそく"],["を"],["与えられて","あたえられて"],["いる"],["の"],["です"],["から"],["、"],["いっさい"],["の"],["霊肉","れいにく"],["の"],["汚れ","よごれ"],["から"],["自分","じぶん"],["を"],["きよめ"],["、"],["神","かみ"],["を"],["恐れ","おそれ"],["かしこ"],["ん"],["で"],["聖","せい"],["き"],["を"],["全う","まっとう"],["しようで"],["は"],["ありません"],["か"],["。"]]},{"verse":2,"text":"私たちに対して心を開いてください。私たちは、だれにも不正をしたことがなく、だれをもそこなったことがなく、だれからも利をむさぼったことがありません。","tok":[["私たち","わたしたち"],["に対して","にたいして"],["心","こころ"],["を"],["開いて","ひらいて"],["ください"],["。"],["私たち","わたしたち"],["は"],["、"],["だれ"],["に"],["も"],["不正","ふせい"],["を"],["した"],["こと"],["が"],["なく"],["、"],["だれ"],["を"],["も"],["そこなった"],["こと"],["が"],["なく"],["、"],["だれ"],["から"],["も"],["利","り"],["を"],["むさぼった"],["こと"],["が"],["ありません"],["。"]]},{"verse":3,"text":"責めるためにこう言うのではありません。前にも言ったように、あなたがたは、私たちとともに死に、ともに生きるために、私たちの心のうちにあるのです。","tok":[["責める","せめる"],["ため"],["に"],["こう"],["言う","いう"],["ので"],["は"],["ありません"],["。"],["前","まえ"],["に"],["も"],["言った","いった"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["と"],["とも"],["に"],["死に","しに"],["、"],["とも"],["に"],["生きる","いきる"],["ため"],["に"],["、"],["私たち","わたしたち"],["の"],["心","こころ"],["の"],["うち"],["に"],["ある"],["の"],["です"],["。"]]},{"verse":4,"text":"私のあなたがたに対する信頼は大きいのであって、私はあなたがたを大いに誇りとしています。私は慰めに満たされ、どんな苦しみの中にあっても喜びに満ちあふれています。","tok":[["私","わたくし"],["の"],["あなた"],["がた"],["に"],["対する","たいする"],["信頼","しんらい"],["は"],["大きい","おおきい"],["ので"],["あって"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["を"],["大いに","おおいに"],["誇り","ほこり"],["として"],["います"],["。"],["私","わたくし"],["は"],["慰め","なぐさめ"],["に"],["満たされ","みたされ"],["、"],["どんな"],["苦しみ","くるしみ"],["の"],["中","なか"],["に"],["あって"],["も"],["喜び","よろこび"],["に"],["満ちあふれて","みちあふれて"],["います"],["。"]]},{"verse":5,"text":"マケドニヤに着いたとき、私たちの身には少しの安らぎもなく、さまざまの苦しみに会って、外には戦い、うちには恐れがありました。","tok":[["マケドニヤ"],["に"],["着いた","ついた"],["とき"],["、"],["私たち","わたしたち"],["の"],["身","み"],["に"],["は"],["少し","すこし"],["の"],["安らぎ","やすらぎ"],["も"],["なく"],["、"],["さまざま"],["の"],["苦しみ","くるしみ"],["に"],["会って","あって"],["、"],["外","そと"],["に"],["は"],["戦い","たたかい"],["、"],["うち"],["に"],["は"],["恐れ","おそれ"],["が"],["ありました"],["。"]]},{"verse":6,"text":"しかし、気落ちした者を慰めてくださる神は、テトスが来たことによって、私たちを慰めてくださいました。","tok":[["しかし"],["、"],["気落ち","きおち"],["した"],["者","もの"],["を"],["慰めて","なぐさめて"],["くださる"],["神","かみ"],["は"],["、"],["テトス"],["が"],["来た","きた"],["こと"],["によって"],["、"],["私たち","わたしたち"],["を"],["慰めて","なぐさめて"],["くださいました"],["。"]]},{"verse":7,"text":"ただテトスが来たことばかりでなく、彼があなたがたから受けた慰めによっても、私たちは慰められたのです。あなたがたが私を慕っていること、嘆き悲しんでいること、また私に対して熱意を持っていてくれることを知らされて、私はますます喜びにあふれました。","tok":[["ただ"],["テトス"],["が"],["来た","きた"],["こと"],["ばかり"],["で"],["なく"],["、"],["彼","かれ"],["が"],["あなた"],["がた"],["から"],["受けた","うけた"],["慰め","なぐさめ"],["によって"],["も"],["、"],["私たち","わたしたち"],["は"],["慰められた","なぐさめられた"],["の"],["です"],["。"],["あなた"],["がた"],["が"],["私","わたくし"],["を"],["慕って","したって"],["いる"],["こと"],["、"],["嘆き悲しんで","なげきかなしんで"],["いる"],["こと"],["、"],["また"],["私","わたくし"],["に対して","にたいして"],["熱意","ねつい"],["を"],["持って","もって"],["いて"],["くれる"],["こと"],["を"],["知らされて","しらされて"],["、"],["私","わたくし"],["は"],["ますます"],["喜び","よろこび"],["に"],["あふれました"],["。"]]},{"verse":8,"text":"あの手紙によってあなたがたを悲しませたけれども、私はそれを悔いていません。あの手紙がしばらくの間であったにしろあなたがたを悲しませたのを見て、悔いたけれども、","tok":[["あの"],["手紙","てがみ"],["によって"],["あなた"],["がた"],["を"],["悲しませた","かなしませた"],["けれど"],["も"],["、"],["私","わたくし"],["は"],["それ"],["を"],["悔いて","くいて"],["いません"],["。"],["あの"],["手紙","てがみ"],["が"],["しばらく"],["の"],["間","あいだ"],["で"],["あった"],["に"],["しろ"],["あなた"],["がた"],["を"],["悲しませた","かなしませた"],["の"],["を"],["見て","みて"],["、"],["悔いた","くいた"],["けれど"],["も"],["、"]]},{"verse":9,"text":"今は喜んでいます。あなたがたが悲しんだからではなく、あなたがたが悲しんで悔い改めたからです。あなたがたは神のみこころに添って悲しんだので、私たちのために何の害も受けなかったのです。","tok":[["今","いま"],["は"],["喜んで","よろこんで"],["います"],["。"],["あなた"],["がた"],["が"],["悲しんだ","かなしんだ"],["から"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["が"],["悲しんで","かなしんで"],["悔い改めた","くいあらためた"],["から"],["です"],["。"],["あなた"],["がた"],["は"],["神","かみ"],["のみ"],["こころ"],["に"],["添って","そって"],["悲しんだ","かなしんだ"],["ので"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["何","なん"],["の"],["害","がい"],["も"],["受けなかった","うけなかった"],["の"],["です"],["。"]]},{"verse":10,"text":"神のみこころに添った悲しみは、悔いのない、救いに至る悔い改めを生じさせますが、世の悲しみは死をもたらします。","tok":[["神","かみ"],["のみ"],["こころ"],["に"],["添った","そった"],["悲しみ","かなしみ"],["は"],["、"],["悔い","くい"],["の"],["ない"],["、"],["救い","すくい"],["に"],["至る","いたる"],["悔い改め","くいあらため"],["を"],["生じさせます","しょうじさせます"],["が"],["、"],["世","よ"],["の"],["悲しみ","かなしみ"],["は"],["死","し"],["を"],["もたらします"],["。"]]},{"verse":11,"text":"ご覧なさい。神のみこころに添ったその悲しみが、あなたがたのうちに、どれほどの熱心を起こさせたことでしょう。また、弁明、憤り、恐れ、慕う心、熱意を起こさせ、処罰を断行させたことでしょう。あの問題について、あなたがたは、自分たちがすべての点で潔白であることを証明したのです。","tok":[["ご覧","ごらん"],["なさい"],["。"],["神","かみ"],["のみ"],["こころ"],["に"],["添った","そった"],["その"],["悲しみ","かなしみ"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["どれ"],["ほど"],["の"],["熱心","ねっしん"],["を"],["起こさせた","おこさせた"],["こと"],["でしょう"],["。"],["また"],["、"],["弁明","べんめい"],["、"],["憤り","いきどおり"],["、"],["恐れ","おそれ"],["、"],["慕う","したう"],["心","こころ"],["、"],["熱意","ねつい"],["を"],["起こさせ","おこさせ"],["、"],["処罰","しょばつ"],["を"],["断行","だんこう"],["させた"],["こと"],["でしょう"],["。"],["あの"],["問題","もんだい"],["について"],["、"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["が"],["すべて"],["の"],["点","てん"],["で"],["潔白","けっぱく"],["で"],["ある"],["こと"],["を"],["証明","しょうめい"],["した"],["の"],["です"],["。"]]},{"verse":12,"text":"ですから、私はあなたがたに手紙を書きましたが、それは悪を行った人のためでもなく、その被害者のためでもなくて、私たちに対するあなたがたの熱心が、神の御前に明らかにされるためであったのです。","tok":[["です"],["から"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["手紙","てがみ"],["を"],["書きました","かきました"],["が"],["、"],["それ"],["は"],["悪","あく"],["を"],["行った","おこなった"],["人","ひと"],["の"],["ため"],["で"],["も"],["なく"],["、"],["その"],["被害者","ひがいしゃ"],["の"],["ため"],["で"],["も"],["なくて"],["、"],["私たち","わたしたち"],["に"],["対する","たいする"],["あなた"],["がた"],["の"],["熱心","ねっしん"],["が"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["明らか","あきらか"],["に"],["される"],["ため"],["で"],["あった"],["の"],["です"],["。"]]},{"verse":13,"text":"こういうわけですから、私たちは慰めを受けました。／この慰めの上にテトスの喜びが加わって、私たちはなおいっそう喜びました。テトスの心が、あなたがたすべてによって安らぎを与えられたからです。","tok":[["こう"],["いう"],["わけ"],["です"],["から"],["、"],["私たち","わたしたち"],["は"],["慰め","なぐさめ"],["を"],["受けました","うけました"],["。"],["／"],["この"],["慰め","なぐさめ"],["の"],["上","うえ"],["に"],["テトス"],["の"],["喜び","よろこび"],["が"],["加わって","くわわって"],["、"],["私たち","わたしたち"],["は"],["なお"],["いっそう"],["喜びました","よろこびました"],["。"],["テトス"],["の"],["心","こころ"],["が"],["、"],["あなた"],["がた"],["すべて"],["によって"],["安らぎ","やすらぎ"],["を"],["与えられた","あたえられた"],["から"],["です"],["。"]]},{"verse":14,"text":"私はテトスに、あなたがたのことを少しばかり誇りましたが、そのことで恥をかかずに済みました。というのは、私たちがあなたがたに語ったことがすべて真実であったように、テトスに対して誇ったことも真実となったからです。","tok":[["私","わたくし"],["は"],["テトス"],["に"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["少し","すこし"],["ばかり"],["誇りました","ほこりました"],["が"],["、"],["その"],["こと"],["で"],["恥","はじ"],["を"],["かかず"],["に"],["済みました","すみました"],["。"],["と"],["いう"],["の"],["は"],["、"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["に"],["語った","かたった"],["こと"],["が"],["すべて"],["真実","しんじつ"],["で"],["あった"],["よう"],["に"],["、"],["テトス"],["に対して","にたいして"],["誇った","ほこった"],["こと"],["も"],["真実","しんじつ"],["と"],["なった"],["から"],["です"],["。"]]},{"verse":15,"text":"彼は、あなたがたがみなよく言うことを聞き、恐れおののいて、自分を迎えてくれたことを思い出して、あなたがたへの愛情をますます深めています。","tok":[["彼","かれ"],["は"],["、"],["あなた"],["がた"],["が"],["みな"],["よく"],["言う","いう"],["こと"],["を"],["聞き","きき"],["、"],["恐れおののいて","おそれおののいて"],["、"],["自分","じぶん"],["を"],["迎えて","むかえて"],["くれた"],["こと"],["を"],["思い出して","おもいだして"],["、"],["あなた"],["が"],["たへ"],["の"],["愛情","あいじょう"],["を"],["ますます"],["深めて","ふかめて"],["います"],["。"]]},{"verse":16,"text":"私は、あなたがたに全幅の信頼を寄せることができるのを喜んでいます。","tok":[["私","わたくし"],["は"],["、"],["あなた"],["がた"],["に"],["全幅","ぜんぷく"],["の"],["信頼","しんらい"],["を"],["寄せる","よせる"],["こと"],["が"],["できる"],["の"],["を"],["喜んで","よろこんで"],["います"],["。"]]}]
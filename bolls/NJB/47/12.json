[{"verse":1,"text":"無益なことですが、誇るのもやむをえないことです。私は主の幻と啓示のことを話しましょう。","tok":[["無益","むえき"],["な"],["こと"],["です"],["が"],["、"],["誇る","ほこる"],["の"],["も"],["やむ"],["を"],["えない"],["こと"],["です"],["。"],["私","わたくし"],["は"],["主","ぬし"],["の"],["幻","まぼろし"],["と"],["啓示","けいじ"],["の"],["こと"],["を"],["話しましょう","はなしましょう"],["。"]]},{"verse":2,"text":"私はキリストにあるひとりの人を知っています。この人は十四年前に――肉体のままであったか、私は知りません。肉体を離れてであったか、それも知りません。神はご存じです、――第三の天にまで引き上げられました。","tok":[["私","わたくし"],["は"],["キリスト"],["に"],["ある"],["ひとり"],["の"],["人","ひと"],["を"],["知って","しって"],["います"],["。"],["この"],["人","ひと"],["は"],["十四","じゅうよん"],["年","ねん"],["前","まえ"],["に"],["―"],["―"],["肉体","にくたい"],["の"],["まま"],["で"],["あった"],["か"],["、"],["私","わたくし"],["は"],["知りません","しりません"],["。"],["肉体","にくたい"],["を"],["離れて","はなれて"],["で"],["あった"],["か"],["、"],["それ"],["も"],["知りません","しりません"],["。"],["神","かみ"],["は"],["ご存じ","ごぞんじ"],["です"],["、"],["―"],["―"],["第","だい"],["三","さん"],["の"],["天","てん"],["に"],["まで"],["引き上げられました","ひきあげられました"],["。"]]},{"verse":3,"text":"私はこの人が、――それが肉体のままであったか、肉体を離れてであったかは知りません。神はご存じです、――","tok":[["私","わたくし"],["は"],["この"],["人","ひと"],["が"],["、"],["―"],["―"],["それ"],["が"],["肉体","にくたい"],["の"],["まま"],["で"],["あった"],["か"],["、"],["肉体","にくたい"],["を"],["離れて","はなれて"],["で"],["あった"],["か"],["は"],["知りません","しりません"],["。"],["神","かみ"],["は"],["ご存じ","ごぞんじ"],["です"],["、"],["―"],["―"]]},{"verse":4,"text":"パラダイスに引き上げられて、人間には語ることを許されていない、口に出すことのできないことばを聞いたことを知っています。","tok":[["パラダイス"],["に"],["引き上げられて","ひきあげられて"],["、"],["人間","にんげん"],["に"],["は"],["語る","かたる"],["こと"],["を"],["許されて","ゆるされて"],["いない"],["、"],["口","くち"],["に"],["出す","だす"],["こと"],["の"],["できない"],["ことば"],["を"],["聞いた","きいた"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":5,"text":"このような人について私は誇るのです。しかし、私自身については、自分の弱さ以外には誇りません。","tok":[["この"],["よう"],["な"],["人","ひと"],["について"],["私","わたくし"],["は"],["誇る","ほこる"],["の"],["です"],["。"],["しかし"],["、"],["私自身","わたしじしん"],["について"],["は"],["、"],["自分","じぶん"],["の"],["弱","よわ"],["さ"],["以外","いがい"],["に"],["は"],["誇りません","ほこりません"],["。"]]},{"verse":6,"text":"たとい私が誇りたいと思ったとしても、愚か者にはなりません。真実のことを話すのだからです。しかし、誇ることは控えましょう。私について見ること、私から聞くこと以上に、人が私を過大に評価するといけないからです。","tok":[["たとい"],["私","わたくし"],["が"],["誇りたい","ほこりたい"],["と"],["思った","おもった"],["として"],["も"],["、"],["愚か者","おろかもの"],["に"],["は"],["なりません"],["。"],["真実","しんじつ"],["の"],["こと"],["を"],["話す","はなす"],["の"],["だ"],["から"],["です"],["。"],["しかし"],["、"],["誇る","ほこる"],["こと"],["は"],["控えましょう","ひかえましょう"],["。"],["私","わたくし"],["について"],["見る","みる"],["こと"],["、"],["私","わたくし"],["から"],["聞く","きく"],["こと"],["以上","いじょう"],["に"],["、"],["人","ひと"],["が"],["私","わたくし"],["を"],["過大","かだい"],["に"],["評価","ひょうか"],["する"],["と"],["いけない"],["から"],["です"],["。"]]},{"verse":7,"text":"また、その啓示があまりにもすばらしいからです。そのために私は、高ぶることのないようにと、肉体に一つのとげを与えられました。それは私が高ぶることのないように、私を打つための、サタンの使いです。","tok":[["また"],["、"],["その"],["啓示","けいじ"],["が"],["あまり"],["に"],["も"],["すばらしい"],["から"],["です"],["。"],["その"],["ため"],["に"],["私","わたくし"],["は"],["、"],["高ぶる","たかぶる"],["こと"],["の"],["ない"],["よう"],["に"],["と"],["、"],["肉体","にくたい"],["に"],["一","ひと"],["つ"],["の"],["とげ"],["を"],["与えられました","あたえられました"],["。"],["それ"],["は"],["私","わたくし"],["が"],["高ぶる","たかぶる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["私","わたくし"],["を"],["打つ","うつ"],["ため"],["の"],["、"],["サタン"],["の"],["使い","つかい"],["です"],["。"]]},{"verse":8,"text":"このことについては、これを私から去らせてくださるようにと、三度も主に願いました。","tok":[["この"],["こと"],["について"],["は"],["、"],["これ"],["を"],["私","わたくし"],["から"],["去らせて","さらせて"],["くださる"],["よう"],["に"],["と"],["、"],["三","さん"],["度","ど"],["も"],["主に","おもに"],["願いました","ねがいました"],["。"]]},{"verse":9,"text":"しかし、主は、「わたしの恵みは、あなたに十分である。というのは、わたしの力は、弱さのうちに完全に現れるからである」と言われたのです。ですから、私は、キリストの力が私をおおうために、むしろ大いに喜んで私の弱さを誇りましょう。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["、"],["「"],["わたし"],["の"],["恵み","めぐみ"],["は"],["、"],["あなた"],["に"],["十分","じゅうぶん"],["で"],["ある"],["。"],["と"],["いう"],["の"],["は"],["、"],["わたし"],["の"],["力","ちから"],["は"],["、"],["弱","よわ"],["さ"],["の"],["うち"],["に"],["完全","かんぜん"],["に"],["現れる","あらわれる"],["から"],["で"],["ある"],["」"],["と"],["言われた","いわれた"],["の"],["です"],["。"],["です"],["から"],["、"],["私","わたくし"],["は"],["、"],["キリスト"],["の"],["力","ちから"],["が"],["私","わたくし"],["を"],["おおう"],["ため"],["に"],["、"],["むしろ"],["大いに","おおいに"],["喜んで","よろこんで"],["私","わたくし"],["の"],["弱","よわ"],["さ"],["を"],["誇りましょう","ほこりましょう"],["。"]]},{"verse":10,"text":"ですから、私は、キリストのために、弱さ、侮辱、苦痛、迫害、困難に甘んじています。なぜなら、私が弱いときにこそ、私は強いからです。","tok":[["です"],["から"],["、"],["私","わたくし"],["は"],["、"],["キリスト"],["の"],["ため"],["に"],["、"],["弱","よわ"],["さ"],["、"],["侮辱","ぶじょく"],["、"],["苦痛","くつう"],["、"],["迫害","はくがい"],["、"],["困難","こんなん"],["に"],["甘んじて","あまんじて"],["います"],["。"],["なぜ"],["なら"],["、"],["私","わたくし"],["が"],["弱い","よわい"],["とき"],["に"],["こそ"],["、"],["私","わたくし"],["は"],["強い","つよい"],["から"],["です"],["。"]]},{"verse":11,"text":"私は愚か者になりました。あなたがたが無理に私をそうしたのです。私は当然あなたがたの推薦を受けてよかったはずです。たとい私は取るに足りない者であっても、私はあの大使徒たちにどのような点でも劣るところはありませんでした。","tok":[["私","わたくし"],["は"],["愚か者","おろかもの"],["に"],["なりました"],["。"],["あなた"],["がた"],["が"],["無理","むり"],["に"],["私","わたくし"],["を"],["そう"],["した"],["の"],["です"],["。"],["私","わたくし"],["は"],["当然","とうぜん"],["あなた"],["がた"],["の"],["推薦","すいせん"],["を"],["受けて","うけて"],["よかった"],["はず"],["です"],["。"],["たとい"],["私","わたくし"],["は"],["取る","とる"],["に"],["足りない","たりない"],["者","もの"],["で"],["あって"],["も"],["、"],["私","わたくし"],["は"],["あの"],["大使","たいし"],["徒","と"],["たち"],["に"],["どのような"],["点","てん"],["で"],["も"],["劣る","おとる"],["ところ"],["は"],["ありませんでした"],["。"]]},{"verse":12,"text":"使徒としてのしるしは、忍耐を尽くしてあなたがたの間で行われた、しるしと不思議と力あるわざです。","tok":[["使徒","しと"],["として"],["の"],["しるし"],["は"],["、"],["忍耐","にんたい"],["を"],["尽くして","つくして"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["行われた","おこなわれた"],["、"],["しるし"],["と"],["不思議","ふしぎ"],["と"],["力","ちから"],["ある"],["わざ"],["です"],["。"]]},{"verse":13,"text":"あなたがたが他の諸教会より劣っている点は何でしょうか。それは、私のほうであなたがたには負担をかけなかったことだけです。この不正については、どうか、赦してください。","tok":[["あなた"],["がた"],["が"],["他","ほか"],["の"],["諸教","しょきょう"],["会","かい"],["より"],["劣って","おとって"],["いる"],["点","てん"],["は"],["何","なん"],["でしょう"],["か"],["。"],["それ"],["は"],["、"],["私","わたくし"],["の"],["ほう"],["で"],["あなた"],["がた"],["に"],["は"],["負担","ふたん"],["を"],["かけなかった"],["こと"],["だけ"],["です"],["。"],["この"],["不正","ふせい"],["について"],["は"],["、"],["どう"],["か"],["、"],["赦して","ゆるして"],["ください"],["。"]]},{"verse":14,"text":"今、私はあなたがたのところに行こうとして、三度目の用意ができています。しかし、あなたがたに負担はかけません。私が求めているのは、あなたがたの持ち物ではなく、あなたがた自身だからです。子は親のためにたくわえる必要はなく、親が子のためにたくわえるべきです。","tok":[["今","いま"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["ところ"],["に"],["行こう","いこう"],["として"],["、"],["三度目","さんどめ"],["の"],["用意","ようい"],["が"],["できて"],["います"],["。"],["しかし"],["、"],["あなた"],["がた"],["に"],["負担","ふたん"],["は"],["かけません"],["。"],["私","わたくし"],["が"],["求めて","もとめて"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["持ち物","もちもの"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["自身","じしん"],["だ"],["から"],["です"],["。"],["子","こ"],["は"],["親","おや"],["の"],["ため"],["に"],["たくわえる"],["必要","ひつよう"],["は"],["なく"],["、"],["親","おや"],["が"],["子","こ"],["の"],["ため"],["に"],["たくわえるべきです"],["。"]]},{"verse":15,"text":"ですから、私はあなたがたのたましいのためには、大いに喜んで財を費やし、また私自身をさえ使い尽くしましょう。私があなたがたを愛すれば愛するほど、私はいよいよ愛されなくなるのでしょうか。","tok":[["です"],["から"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["たましい"],["の"],["ため"],["に"],["は"],["、"],["大いに","おおいに"],["喜んで","よろこんで"],["財","ざい"],["を"],["費やし","ついやし"],["、"],["また"],["私自身","わたしじしん"],["を"],["さえ"],["使い尽くしましょう","つかいつくしましょう"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["を"],["愛すれば","あいすれば"],["愛する","あいする"],["ほど"],["、"],["私","わたくし"],["は"],["いよいよ"],["愛されなく","あいされなく"],["なる"],["の"],["でしょう"],["か"],["。"]]},{"verse":16,"text":"あなたがたに重荷は負わせなかったにしても、私は、悪賢くて、あなたがたからだまし取ったのだと言われます。","tok":[["あなた"],["がた"],["に"],["重荷","おもに"],["は"],["負わせなかった","おわせなかった"],["に"],["して"],["も"],["、"],["私","わたくし"],["は"],["、"],["悪賢くて","わるがしこくて"],["、"],["あなた"],["がた"],["から"],["だまし取った","だましとった"],["の"],["だ"],["と"],["言われます","いわれます"],["。"]]},{"verse":17,"text":"あなたがたのところに遣わした人たちのうちのだれによって、私があなたがたを欺くようなことがあったでしょうか。","tok":[["あなた"],["がた"],["の"],["ところ"],["に"],["遣わした","つかわした"],["人","ひと"],["たち"],["の"],["うち"],["の"],["だれ"],["によって"],["、"],["私","わたくし"],["が"],["あなた"],["がた"],["を"],["欺く","あざむく"],["よう"],["な"],["こと"],["が"],["あったでしょう"],["か"],["。"]]},{"verse":18,"text":"私はテトスにそちらに行くように勧め、また、あの兄弟を同行させました。テトスはあなたがたを欺くようなことをしたでしょうか。私たちは同じ心で、同じ歩調で歩いたのではありませんか。","tok":[["私","わたくし"],["は"],["テトス"],["に"],["そちら"],["に"],["行く","いく"],["よう"],["に"],["勧め","すすめ"],["、"],["また"],["、"],["あの"],["兄弟","きょうだい"],["を"],["同行","どうこう"],["させました"],["。"],["テトス"],["は"],["あなた"],["がた"],["を"],["欺く","あざむく"],["よう"],["な"],["こと"],["を"],["したでしょう"],["か"],["。"],["私たち","わたしたち"],["は"],["同じ","おなじ"],["心","こころ"],["で"],["、"],["同じ","おなじ"],["歩調","ほちょう"],["で"],["歩いた","あるいた"],["ので"],["は"],["ありません"],["か"],["。"]]},{"verse":19,"text":"あなたがたは、前から、私たちがあなたがたに対して自己弁護をしているのだと思っていたことでしょう。しかし、私たちは神の御前で、キリストにあって語っているのです。愛する人たち。すべては、あなたがたを築き上げるためなのです。","tok":[["あなた"],["がた"],["は"],["、"],["前","まえ"],["から"],["、"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["に対して","にたいして"],["自己","じこ"],["弁護","べんご"],["を"],["して"],["いる"],["の"],["だ"],["と"],["思って","おもって"],["いた"],["こと"],["でしょう"],["。"],["しかし"],["、"],["私たち","わたしたち"],["は"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["キリスト"],["に"],["あって"],["語って","かたって"],["いる"],["の"],["です"],["。"],["愛する","あいする"],["人","ひと"],["たち"],["。"],["すべて"],["は"],["、"],["あなた"],["がた"],["を"],["築き上げる","きずきあげる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":20,"text":"私の恐れていることがあります。私が行ってみると、あなたがたは私の期待しているような者でなく、私もあなたがたの期待しているような者でないことになるのではないでしょうか。また、争い、ねたみ、憤り、党派心、そしり、陰口、高ぶり、騒動があるのではないでしょうか。","tok":[["私","わたくし"],["の"],["恐れて","おそれて"],["いる"],["こと"],["が"],["あります"],["。"],["私","わたくし"],["が"],["行って","いって"],["みる"],["と"],["、"],["あなた"],["がた"],["は"],["私","わたくし"],["の"],["期待","きたい"],["して"],["いる"],["よう"],["な"],["者","もの"],["で"],["なく"],["、"],["私","わたくし"],["も"],["あなた"],["がた"],["の"],["期待","きたい"],["して"],["いる"],["よう"],["な"],["者","もの"],["で"],["ない"],["こと"],["に"],["なる"],["ので"],["は"],["ないでしょう"],["か"],["。"],["また"],["、"],["争い","あらそい"],["、"],["ねたみ"],["、"],["憤り","いきどおり"],["、"],["党派心","とうはしん"],["、"],["そしり"],["、"],["陰口","かげぐち"],["、"],["高ぶり","たかぶり"],["、"],["騒動","そうどう"],["が"],["ある"],["ので"],["は"],["ないでしょう"],["か"],["。"]]},{"verse":21,"text":"私がもう一度行くとき、またも私の神が、あなたがたの面前で、私をはずかしめることはないでしょうか。そして私は、前から罪を犯していて、その行った汚れと不品行と好色を悔い改めない多くの人たちのために、嘆くようなことにはならないでしょうか。","tok":[["私","わたくし"],["が"],["もう"],["一度","いちど"],["行く","いく"],["とき"],["、"],["また"],["も"],["私","わたくし"],["の"],["神","かみ"],["が"],["、"],["あなた"],["がた"],["の"],["面前","めんぜん"],["で"],["、"],["私","わたくし"],["を"],["はずかしめる"],["こと"],["は"],["ないでしょう"],["か"],["。"],["そして"],["私","わたくし"],["は"],["、"],["前","まえ"],["から"],["罪","つみ"],["を"],["犯して","おかして"],["いて"],["、"],["その"],["行った","いった"],["汚れ","よごれ"],["と"],["不品行","ふひんこう"],["と"],["好色","こうしょく"],["を"],["悔い改めない","くいあらためない"],["多く","おおく"],["の"],["人","ひと"],["たち"],["の"],["ため"],["に"],["、"],["嘆く","なげく"],["よう"],["な"],["こと"],["に"],["は"],["ならないでしょう"],["か"],["。"]]}]
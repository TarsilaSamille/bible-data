[{"verse":1,"text":"私があなたがたのところへ行くのは、これで三度目です。すべての事実は、ふたりか三人の証人の口によって確認されるのです。","tok":[["私","わたくし"],["が"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行く","いく"],["の"],["は"],["、"],["これ"],["で"],["三度目","さんどめ"],["です"],["。"],["すべて"],["の"],["事実","じじつ"],["は"],["、"],["ふたり"],["か"],["三人","さんにん"],["の"],["証人","しょうにん"],["の"],["口","くち"],["によって"],["確認","かくにん"],["される"],["の"],["です"],["。"]]},{"verse":2,"text":"私は二度目の滞在のときに前もって言っておいたのですが、こうして離れている今も、前から罪を犯している人たちとほかのすべての人たちに、あらかじめ言っておきます。今度そちらに行ったときには、容赦はしません。","tok":[["私","わたくし"],["は"],["二度目","にどめ"],["の"],["滞在","たいざい"],["の"],["とき"],["に"],["前もって","まえもって"],["言って","いって"],["おいた"],["の"],["です"],["が"],["、"],["こう"],["して"],["離れて","はなれて"],["いる"],["今","いま"],["も"],["、"],["前","まえ"],["から"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["人","ひと"],["たち"],["と"],["ほか"],["の"],["すべて"],["の"],["人","ひと"],["たち"],["に"],["、"],["あらかじめ"],["言って","いって"],["おきます"],["。"],["今度","こんど"],["そちら"],["に"],["行った","いった"],["とき"],["に"],["は"],["、"],["容赦","ようしゃ"],["は"],["しません"],["。"]]},{"verse":3,"text":"こう言うのは、あなたがたはキリストが私によって語っておられるという証拠を求めているからです。キリストはあなたがたに対して弱くはなく、あなたがたの間にあって強い方です。","tok":[["こう"],["言う","いう"],["の"],["は"],["、"],["あなた"],["がた"],["は"],["キリスト"],["が"],["私","わたくし"],["によって"],["語って","かたって"],["おられる"],["と"],["いう"],["証拠","しょうこ"],["を"],["求めて","もとめて"],["いる"],["から"],["です"],["。"],["キリスト"],["は"],["あなた"],["がた"],["に対して","にたいして"],["弱く","よわく"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["あって"],["強い","つよい"],["方","ほう"],["です"],["。"]]},{"verse":4,"text":"確かに、弱さのゆえに十字架につけられましたが、神の力のゆえに生きておられます。私たちもキリストにあって弱い者ですが、あなたがたに対する神の力のゆえに、キリストとともに生きているのです。","tok":[["確か","たしか"],["に"],["、"],["弱","よわ"],["さ"],["の"],["ゆえ"],["に"],["十字架","じゅうじか"],["に"],["つけられました"],["が"],["、"],["神","かみ"],["の"],["力","ちから"],["の"],["ゆえ"],["に"],["生きて","いきて"],["おられます"],["。"],["私たち","わたしたち"],["も"],["キリスト"],["に"],["あって"],["弱い","よわい"],["者","もの"],["です"],["が"],["、"],["あなた"],["がた"],["に"],["対する","たいする"],["神","かみ"],["の"],["力","ちから"],["の"],["ゆえ"],["に"],["、"],["キリスト"],["と"],["とも"],["に"],["生きて","いきて"],["いる"],["の"],["です"],["。"]]},{"verse":5,"text":"あなたがたは、信仰に立っているかどうか、自分自身をためし、また吟味しなさい。それとも、あなたがたのうちにはイエス・キリストがおられることを、自分で認めないのですか――あなたがたがそれに不適格であれば別です。――","tok":[["あなた"],["がた"],["は"],["、"],["信仰","しんこう"],["に"],["立って","たって"],["いる"],["か"],["どう"],["か"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["ためし"],["、"],["また"],["吟味","ぎんみ"],["し"],["なさい"],["。"],["それ"],["と"],["も"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["は"],["イエス"],["・"],["キリスト"],["が"],["おられる"],["こと"],["を"],["、"],["自分","じぶん"],["で"],["認めない","みとめない"],["の"],["です"],["か"],["―"],["―"],["あなた"],["がた"],["が"],["それ"],["に"],["不","ふ"],["適格","てきかく"],["で"],["あれば"],["別","べつ"],["です"],["。"],["―"],["―"]]},{"verse":6,"text":"しかし、私たちは不適格でないことを、あなたがたが悟るように私は望んでいます。","tok":[["しかし"],["、"],["私たち","わたしたち"],["は"],["不","ふ"],["適格","てきかく"],["で"],["ない"],["こと"],["を"],["、"],["あなた"],["がた"],["が"],["悟る","さとる"],["よう"],["に"],["私","わたくし"],["は"],["望んで","のぞんで"],["います"],["。"]]},{"verse":7,"text":"私たちは、あなたがたがどんな悪をも行わないように神に祈っています。それによって、私たち自身の適格であることが明らかになるというのではなく、たとい私たちは不適格のように見えても、あなたがたに正しい行いをしてもらいたいためです。","tok":[["私たち","わたしたち"],["は"],["、"],["あなた"],["がた"],["が"],["どんな"],["悪","あく"],["を"],["も"],["行わない","おこなわない"],["よう"],["に"],["神","かみ"],["に"],["祈って","いのって"],["います"],["。"],["それ"],["によって"],["、"],["私たち","わたしたち"],["自身","じしん"],["の"],["適格","てきかく"],["で"],["ある"],["こと"],["が"],["明らか","あきらか"],["に"],["なる"],["と"],["いう"],["ので"],["は"],["なく"],["、"],["たとい"],["私たち","わたしたち"],["は"],["不","ふ"],["適格","てきかく"],["の"],["よう"],["に"],["見えて","みえて"],["も"],["、"],["あなた"],["がた"],["に"],["正しい","ただしい"],["行い","おこない"],["を"],["して"],["もらいたい"],["ため"],["です"],["。"]]},{"verse":8,"text":"私たちは、真理に逆らっては何をすることもできず、真理のためなら、何でもできるのです。","tok":[["私たち","わたしたち"],["は"],["、"],["真理","しんり"],["に"],["逆らって","さからって"],["は"],["何","なん"],["を"],["する"],["こと"],["も"],["できず"],["、"],["真理","しんり"],["の"],["ため"],["なら"],["、"],["何","なん"],["で"],["も"],["できる"],["の"],["です"],["。"]]},{"verse":9,"text":"私たちは、自分は弱くてもあなたがたが強ければ、喜ぶのです。私たちはあなたがたが完全な者になることを祈っています。","tok":[["私たち","わたしたち"],["は"],["、"],["自分","じぶん"],["は"],["弱くて","よわくて"],["も"],["あなた"],["がた"],["が"],["強ければ","つよければ"],["、"],["喜ぶ","よろこぶ"],["の"],["です"],["。"],["私たち","わたしたち"],["は"],["あなた"],["がた"],["が"],["完全","かんぜん"],["な"],["者","もの"],["に"],["なる"],["こと"],["を"],["祈って","いのって"],["います"],["。"]]},{"verse":10,"text":"そういうわけで、離れていてこれらのことを書いているのは、私が行ったとき、主が私に授けてくださった権威を用いて、きびしい処置をとることのないようにするためです。この権威が与えられたのは築き上げるためであって、倒すためではないのです。","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["離れて","はなれて"],["いて"],["これ"],["ら"],["の"],["こと"],["を"],["書いて","かいて"],["いる"],["の"],["は"],["、"],["私","わたくし"],["が"],["行った","おこなった"],["とき"],["、"],["主","ぬし"],["が"],["私","わたくし"],["に"],["授けて","さずけて"],["くださった"],["権威","けんい"],["を"],["用いて","もちいて"],["、"],["きびしい"],["処置","しょち"],["を"],["とる"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["です"],["。"],["この"],["権威","けんい"],["が"],["与えられた","あたえられた"],["の"],["は"],["築き上げる","きずきあげる"],["ため"],["で"],["あって"],["、"],["倒す","たおす"],["ため"],["で"],["は"],["ない"],["の"],["です"],["。"]]},{"verse":11,"text":"終わりに、兄弟たち。喜びなさい。完全な者になりなさい。慰めを受けなさい。一つ心になりなさい。平和を保ちなさい。そうすれば、愛と平和の神はあなたがたとともにいてくださいます。","tok":[["終わり","おわり"],["に"],["、"],["兄弟","きょうだい"],["たち"],["。"],["喜び","よろこび"],["なさい"],["。"],["完全","かんぜん"],["な"],["者","もの"],["に"],["なり"],["なさい"],["。"],["慰め","なぐさめ"],["を"],["受け","うけ"],["なさい"],["。"],["一","ひと"],["つ"],["心","こころ"],["に"],["なり"],["なさい"],["。"],["平和","へいわ"],["を"],["保ち","たもち"],["なさい"],["。"],["そう"],["すれば"],["、"],["愛","あい"],["と"],["平和","へいわ"],["の"],["神","かみ"],["は"],["あなた"],["がた"],["と"],["とも"],["に"],["いて"],["くださいます"],["。"]]},{"verse":12,"text":"聖なる口づけをもって、互いにあいさつをかわしなさい。すべての聖徒たちが、あなたがたによろしくと言っています。","tok":[["聖","せい"],["なる"],["口づけ","くちづけ"],["を"],["もって"],["、"],["互い","たがい"],["に"],["あいさつ"],["を"],["かわし"],["なさい"],["。"],["すべて"],["の"],["聖徒","せいと"],["たち"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":13,"text":"主イエス・キリストの恵み、神の愛、聖霊の交わりが、あなたがたすべてとともにありますように。","tok":[["主","しゅ"],["イエス"],["・"],["キリスト"],["の"],["恵み","めぐみ"],["、"],["神","かみ"],["の"],["愛","あい"],["、"],["聖霊","せいれい"],["の"],["交わり","まじわり"],["が"],["、"],["あなた"],["がた"],["すべて"],["と"],["とも"],["に"],["あります"],["よう"],["に"],["。"]]}]
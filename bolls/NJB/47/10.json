[{"verse":1,"text":"さて、私パウロは、キリストの柔和と寛容をもって、あなたがたにお勧めします。私は、あなたがたの間にいて、面と向かっているときはおとなしく、離れているあなたがたに対しては強気な者です。","tok":[["さて"],["、"],["私","わたくし"],["パウロ"],["は"],["、"],["キリスト"],["の"],["柔和","にゅうわ"],["と"],["寛容","かんよう"],["を"],["もって"],["、"],["あなた"],["がた"],["に"],["お勧め","おすすめ"],["します"],["。"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["いて"],["、"],["面","めん"],["と"],["向かって","むかって"],["いる"],["とき"],["は"],["おとなしく"],["、"],["離れて","はなれて"],["いる"],["あなた"],["がた"],["に対して","にたいして"],["は"],["強気","つよき"],["な"],["者","もの"],["です"],["。"]]},{"verse":2,"text":"しかし、私は、あなたがたのところに行くときには、私たちを肉に従って歩んでいるかのように考える人々に対して勇敢にふるまおうと思っているその確信によって、強気にふるまうことがなくて済むように願っています。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["行く","いく"],["とき"],["に"],["は"],["、"],["私たち","わたしたち"],["を"],["肉","にく"],["に"],["従って","したがって"],["歩んで","あゆんで"],["いる"],["か"],["の"],["よう"],["に"],["考える","かんがえる"],["人々","ひとびと"],["に対して","にたいして"],["勇敢","ゆうかん"],["に"],["ふるまおう"],["と"],["思って","おもって"],["いる"],["その"],["確信","かくしん"],["によって"],["、"],["強気","つよき"],["に"],["ふるまう"],["こと"],["が"],["なくて"],["済む","すむ"],["よう"],["に"],["願って","ねがって"],["います"],["。"]]},{"verse":3,"text":"私たちは肉にあって歩んではいても、肉に従って戦ってはいません。","tok":[["私たち","わたしたち"],["は"],["肉","にく"],["に"],["あって"],["歩んで","あゆんで"],["は"],["いて"],["も"],["、"],["肉","にく"],["に"],["従って","したがって"],["戦って","たたかって"],["は"],["いません"],["。"]]},{"verse":4,"text":"私たちの戦いの武器は、肉の物ではなく、神の御前で、要塞をも破るほどに力のあるものです。","tok":[["私たち","わたしたち"],["の"],["戦い","たたかい"],["の"],["武器","ぶき"],["は"],["、"],["肉","にく"],["の"],["物","もの"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["要塞","ようさい"],["を"],["も"],["破る","やぶる"],["ほど"],["に"],["力","ちから"],["の"],["ある"],["もの"],["です"],["。"]]},{"verse":5,"text":"私たちは、さまざまの思弁と、神の知識に逆らって立つあらゆる高ぶりを打ち砕き、すべてのはかりごとをとりこにしてキリストに服従させ、","tok":[["私たち","わたしたち"],["は"],["、"],["さまざま"],["の"],["思弁","しべん"],["と"],["、"],["神","かみ"],["の"],["知識","ちしき"],["に"],["逆らって","さからって"],["立つ","たつ"],["あらゆる"],["高ぶり","たかぶり"],["を"],["打ち砕き","うちくだき"],["、"],["すべて"],["の"],["はかりごと"],["を"],["とりこ"],["に"],["して"],["キリスト"],["に"],["服従","ふくじゅう"],["させ"],["、"]]},{"verse":6,"text":"また、あなたがたの従順が完全になるとき、あらゆる不従順を罰する用意ができているのです。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["従順","じゅうじゅん"],["が"],["完全","かんぜん"],["に"],["なる"],["とき"],["、"],["あらゆる"],["不","ふ"],["従順","じゅうじゅん"],["を"],["罰する","ばっする"],["用意","ようい"],["が"],["できて"],["いる"],["の"],["です"],["。"]]},{"verse":7,"text":"あなたがたは、うわべのことだけを見ています。もし自分はキリストに属する者だと確信している人がいるなら、その人は、自分がキリストに属しているように、私たちもまたキリストに属しているということを、もう一度、自分でよく考えなさい。","tok":[["あなた"],["がた"],["は"],["、"],["うわべ"],["の"],["こと"],["だけ"],["を"],["見て","みて"],["います"],["。"],["もし"],["自分","じぶん"],["は"],["キリスト"],["に"],["属する","ぞくする"],["者","もの"],["だ"],["と"],["確信","かくしん"],["して"],["いる"],["人","ひと"],["が"],["いるなら"],["、"],["その"],["人","ひと"],["は"],["、"],["自分","じぶん"],["が"],["キリスト"],["に"],["属して","ぞくして"],["いる"],["よう"],["に"],["、"],["私たち","わたしたち"],["も"],["また"],["キリスト"],["に"],["属して","ぞくして"],["いる"],["と"],["いう"],["こと"],["を"],["、"],["もう"],["一度","いちど"],["、"],["自分","じぶん"],["で"],["よく"],["考え","かんがえ"],["なさい"],["。"]]},{"verse":8,"text":"あなたがたを倒すためにではなく、立てるために主が私たちに授けられた権威については、たとい私が多少誇りすぎることがあっても、恥とはならないでしょう。","tok":[["あなた"],["がた"],["を"],["倒す","たおす"],["ため"],["に"],["で"],["は"],["なく"],["、"],["立てる","たてる"],["ため"],["に"],["主","ぬし"],["が"],["私たち","わたしたち"],["に"],["授けられた","さずけられた"],["権威","けんい"],["について"],["は"],["、"],["たとい"],["私","わたくし"],["が"],["多少","たしょう"],["誇り","ほこり"],["すぎる"],["こと"],["が"],["あって"],["も"],["、"],["恥","はじ"],["と"],["は"],["ならないでしょう"],["。"]]},{"verse":9,"text":"私は手紙であなたがたをおどしているかのように見られたくありません。","tok":[["私","わたくし"],["は"],["手紙","てがみ"],["で"],["あなた"],["がた"],["を"],["おどして"],["いる"],["か"],["の"],["よう"],["に"],["見られたく","みられたく"],["ありません"],["。"]]},{"verse":10,"text":"彼らは言います。「パウロの手紙は重みがあって力強いが、実際に会った場合の彼は弱々しく、その話しぶりは、なっていない。」","tok":[["彼","かれ"],["ら"],["は"],["言います","いいます"],["。"],["「"],["パウロ"],["の"],["手紙","てがみ"],["は"],["重み","おもみ"],["が"],["あって"],["力強い","ちからづよい"],["が"],["、"],["実際","じっさい"],["に"],["会った","あった"],["場合","ばあい"],["の"],["彼","かれ"],["は"],["弱々しく","よわよわしく"],["、"],["その"],["話し","はなし"],["ぶり"],["は"],["、"],["なって"],["いない"],["。"],["」"]]},{"verse":11,"text":"そういう人はよく承知しておきなさい。離れているときに書く手紙のことばがそうなら、いっしょにいるときの行動もそのとおりです。","tok":[["そう"],["いう"],["人","ひと"],["は"],["よく"],["承知","しょうち"],["して"],["おき"],["なさい"],["。"],["離れて","はなれて"],["いる"],["とき"],["に"],["書く","かく"],["手紙","てがみ"],["の"],["ことば"],["が"],["そう"],["なら"],["、"],["いっしょ"],["に"],["いる"],["とき"],["の"],["行動","こうどう"],["も"],["その"],["とおり"],["です"],["。"]]},{"verse":12,"text":"私たちは、自己推薦をしているような人たちの中のだれかと自分を同列に置いたり、比較したりしようなどとは思いません。しかし、彼らが自分たちの間で自分を量ったり、比較したりしているのは、知恵のないことなのです。","tok":[["私たち","わたしたち"],["は"],["、"],["自己","じこ"],["推薦","すいせん"],["を"],["して"],["いる"],["よう"],["な"],["人","ひと"],["たち"],["の"],["中","なか"],["の"],["だれ"],["か"],["と"],["自分","じぶん"],["を"],["同列","どうれつ"],["に"],["置い","おい"],["たり"],["、"],["比較","ひかく"],["し"],["たり"],["しよう"],["など"],["と"],["は"],["思いません","おもいません"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["が"],["自分","じぶん"],["たち"],["の"],["間","あいだ"],["で"],["自分","じぶん"],["を"],["量っ","はかっ"],["たり"],["、"],["比較","ひかく"],["し"],["たり"],["して"],["いる"],["の"],["は"],["、"],["知恵","ちえ"],["の"],["ない"],["こと"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"私たちは、限度を越えて誇りはしません。私たちがあなたがたのところまで行くのも、神が私たちに量って割り当ててくださった限度内で行くのです。","tok":[["私たち","わたしたち"],["は"],["、"],["限度","げんど"],["を"],["越えて","こえて"],["誇り","ほこり"],["は"],["しません"],["。"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["の"],["ところ"],["まで"],["行く","いく"],["の"],["も"],["、"],["神","かみ"],["が"],["私たち","わたしたち"],["に"],["量って","はかって"],["割り当てて","わりあてて"],["くださった"],["限度内","げんどない"],["で"],["行く","いく"],["の"],["です"],["。"]]},{"verse":14,"text":"私たちは、あなたがたのところまでは行かないのに無理に手を伸ばしているのではありません。事実、私たちは、キリストの福音を携えてあなたがたのところにまで行ったのです。","tok":[["私たち","わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["ところ"],["まで"],["は"],["行かない","いかない"],["のに"],["無理","むり"],["に"],["手","て"],["を"],["伸ばして","のばして"],["いる"],["ので"],["は"],["ありません"],["。"],["事実","じじつ"],["、"],["私たち","わたしたち"],["は"],["、"],["キリスト"],["の"],["福音","ふくいん"],["を"],["携えて","たずさえて"],["あなた"],["がた"],["の"],["ところ"],["に"],["まで"],["行った","いった"],["の"],["です"],["。"]]},{"verse":15,"text":"私たちは、自分の限度を越えてほかの人の働きを誇ることはしません。ただ、あなたがたの信仰が成長し、あなたがたによって、私たちの領域内で私たちの働きが広げられることを望んでいます。","tok":[["私たち","わたしたち"],["は"],["、"],["自分","じぶん"],["の"],["限度","げんど"],["を"],["越えて","こえて"],["ほか"],["の"],["人","ひと"],["の"],["働き","はたらき"],["を"],["誇る","ほこる"],["こと"],["は"],["しません"],["。"],["ただ"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["が"],["成長","せいちょう"],["し"],["、"],["あなた"],["がた"],["によって"],["、"],["私たち","わたしたち"],["の"],["領域内","りょういきない"],["で"],["私たち","わたしたち"],["の"],["働き","はたらき"],["が"],["広げられる","ひろげられる"],["こと"],["を"],["望んで","のぞんで"],["います"],["。"]]},{"verse":16,"text":"それは、私たちがあなたがたの向こうの地域にまで福音を宣べ伝えるためであって、決して他の人の領域でなされた働きを誇るためではないのです。","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["の"],["向こう","むこう"],["の"],["地域","ちいき"],["に"],["まで"],["福音","ふくいん"],["を"],["宣べ伝える","のべつたえる"],["ため"],["で"],["あって"],["、"],["決して","けっして"],["他","ほか"],["の"],["人","ひと"],["の"],["領域","りょういき"],["で"],["なされた"],["働き","はたらき"],["を"],["誇る","ほこる"],["ため"],["で"],["は"],["ない"],["の"],["です"],["。"]]},{"verse":17,"text":"誇る者は、主を誇りなさい。","tok":[["誇る","ほこる"],["者","もの"],["は"],["、"],["主","ぬし"],["を"],["誇り","ほこり"],["なさい"],["。"]]},{"verse":18,"text":"自分で自分を推薦する人でなく、主に推薦される人こそ、受け入れられる人です。","tok":[["自分","じぶん"],["で"],["自分","じぶん"],["を"],["推薦","すいせん"],["する"],["人","ひと"],["で"],["なく"],["、"],["主に","おもに"],["推薦","すいせん"],["される"],["人","ひと"],["こそ"],["、"],["受け入れられる","うけいれられる"],["人","ひと"],["です"],["。"]]}]
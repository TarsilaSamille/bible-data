[{"verse":1,"text":"こういうわけで、私たちは、あわれみを受けてこの務めに任じられているのですから、勇気を失うことなく、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["私たち","わたしたち"],["は"],["、"],["あわれみ"],["を"],["受けて","うけて"],["この"],["務め","つとめ"],["に"],["任じられて","にんじられて"],["いる"],["の"],["です"],["から"],["、"],["勇気","ゆうき"],["を"],["失う","うしなう"],["こと"],["なく"],["、"]]},{"verse":2,"text":"恥ずべき隠された事を捨て、悪巧みに歩まず、神のことばを曲げず、真理を明らかにし、神の御前で自分自身をすべての人の良心に推薦しています。","tok":[["恥ずべき","はずべき"],["隠された","かくされた"],["事","こと"],["を"],["捨て","すて"],["、"],["悪巧み","わるだくみ"],["に"],["歩まず","あゆまず"],["、"],["神","かみ"],["の"],["ことば"],["を"],["曲げず","まげず"],["、"],["真理","しんり"],["を"],["明らか","あきらか"],["に"],["し"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["自分","じぶん"],["自身","じしん"],["を"],["すべて"],["の"],["人","ひと"],["の"],["良心","りょうしん"],["に"],["推薦","すいせん"],["して"],["います"],["。"]]},{"verse":3,"text":"それでもなお私たちの福音におおいが掛かっているとしたら、それは、滅びる人々の場合に、おおいが掛かっているのです。","tok":[["それ"],["で"],["も"],["なお"],["私たち","わたしたち"],["の"],["福音","ふくいん"],["に"],["おおい"],["が"],["掛かって","かかって"],["いる"],["と"],["したら"],["、"],["それ"],["は"],["、"],["滅びる","ほろびる"],["人々","ひとびと"],["の"],["場合","ばあい"],["に"],["、"],["おおい"],["が"],["掛かって","かかって"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"その場合、この世の神が不信者の思いをくらませて、神のかたちであるキリストの栄光にかかわる福音の光を輝かせないようにしているのです。","tok":[["その"],["場合","ばあい"],["、"],["この世","このよ"],["の"],["神","かみ"],["が"],["不信者","ふしんしゃ"],["の"],["思い","おもい"],["を"],["くらませて"],["、"],["神","かみ"],["の"],["かたち"],["で"],["ある"],["キリスト"],["の"],["栄光","えいこう"],["に"],["かかわる"],["福音","ふくいん"],["の"],["光","ひかり"],["を"],["輝かせない","かがやかせない"],["よう"],["に"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":5,"text":"私たちは自分自身を宣べ伝えるのではなく、主なるキリスト・イエスを宣べ伝えます。私たち自身は、イエスのために、あなたがたに仕えるしもべなのです。","tok":[["私たち","わたしたち"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["宣べ伝える","のべつたえる"],["ので"],["は"],["なく"],["、"],["主","おも"],["なる"],["キリスト"],["・"],["イエス"],["を"],["宣べ伝えます","のべつたえます"],["。"],["私たち","わたしたち"],["自身","じしん"],["は"],["、"],["イエス"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["に"],["仕える","つかえる"],["しもべ"],["な"],["の"],["です"],["。"]]},{"verse":6,"text":"「光が、やみの中から輝き出よ」と言われた神は、私たちの心を照らし、キリストの御顔にある神の栄光を知る知識を輝かせてくださったのです。","tok":[["「"],["光","ひかり"],["が"],["、"],["やみ"],["の"],["中","なか"],["から"],["輝き出よ","かがやきでよ"],["」"],["と"],["言われた","いわれた"],["神","かみ"],["は"],["、"],["私たち","わたしたち"],["の"],["心","こころ"],["を"],["照らし","てらし"],["、"],["キリスト"],["の"],["御顔","おかお"],["に"],["ある"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["知る","しる"],["知識","ちしき"],["を"],["輝かせて","かがやかせて"],["くださった"],["の"],["です"],["。"]]},{"verse":7,"text":"私たちは、この宝を、土の器の中に入れているのです。それは、この測り知れない力が神のものであって、私たちから出たものでないことが明らかにされるためです。","tok":[["私たち","わたしたち"],["は"],["、"],["この"],["宝","たから"],["を"],["、"],["土","つち"],["の"],["器","うつわ"],["の"],["中","なか"],["に"],["入れて","いれて"],["いる"],["の"],["です"],["。"],["それ"],["は"],["、"],["この"],["測り知れない","はかりしれない"],["力","ちから"],["が"],["神","かみ"],["の"],["もの"],["で"],["あって"],["、"],["私たち","わたしたち"],["から"],["出た","でた"],["もの"],["で"],["ない"],["こと"],["が"],["明らか","あきらか"],["に"],["される"],["ため"],["です"],["。"]]},{"verse":8,"text":"私たちは、四方八方から苦しめられますが、窮することはありません。途方にくれていますが、行きづまることはありません。","tok":[["私たち","わたしたち"],["は"],["、"],["四方","しかた"],["八方","はっぽう"],["から"],["苦しめられます","くるしめられます"],["が"],["、"],["窮する","きゅうする"],["こと"],["は"],["ありません"],["。"],["途方","とほう"],["に"],["くれて"],["います"],["が"],["、"],["行きづまる","いきづまる"],["こと"],["は"],["ありません"],["。"]]},{"verse":9,"text":"迫害されていますが、見捨てられることはありません。倒されますが、滅びません。","tok":[["迫害","はくがい"],["されて"],["います"],["が"],["、"],["見捨てられる","みすてられる"],["こと"],["は"],["ありません"],["。"],["倒されます","たおされます"],["が"],["、"],["滅びません","ほろびません"],["。"]]},{"verse":10,"text":"いつでもイエスの死をこの身に帯びていますが、それは、イエスのいのちが私たちの身において明らかに示されるためです。","tok":[["いつ"],["で"],["も"],["イエス"],["の"],["死","し"],["を"],["この"],["身","み"],["に"],["帯びて","おびて"],["います"],["が"],["、"],["それ"],["は"],["、"],["イエス"],["の"],["いのち"],["が"],["私たち","わたしたち"],["の"],["身","み"],["に"],["おいて"],["明らか","あきらか"],["に"],["示される","しめされる"],["ため"],["です"],["。"]]},{"verse":11,"text":"私たち生きている者は、イエスのために絶えず死に渡されていますが、それは、イエスのいのちが私たちの死ぬべき肉体において明らかに示されるためなのです。","tok":[["私たち","わたしたち"],["生きて","いきて"],["いる"],["者","もの"],["は"],["、"],["イエス"],["の"],["ため"],["に"],["絶えず","たえず"],["死","し"],["に"],["渡されて","わたされて"],["います"],["が"],["、"],["それ"],["は"],["、"],["イエス"],["の"],["いのち"],["が"],["私たち","わたしたち"],["の"],["死ぬべき","しぬべき"],["肉体","にくたい"],["に"],["おいて"],["明らか","あきらか"],["に"],["示される","しめされる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":12,"text":"こうして、死は私たちのうちに働き、いのちはあなたがたのうちに働くのです。","tok":[["こう"],["して"],["、"],["死","し"],["は"],["私たち","わたしたち"],["の"],["うち"],["に"],["働き","はたらき"],["、"],["いのち"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["働く","はたらく"],["の"],["です"],["。"]]},{"verse":13,"text":"「私は信じた。それゆえに語った」と書いてあるとおり、それと同じ信仰の霊を持っている私たちも、信じているゆえに語るのです。","tok":[["「"],["私","わたくし"],["は"],["信じた","しんじた"],["。"],["それ"],["ゆえ"],["に"],["語った","かたった"],["」"],["と"],["書いて","かいて"],["ある"],["と"],["おり"],["、"],["それ"],["と"],["同じ","おなじ"],["信仰","しんこう"],["の"],["霊","れい"],["を"],["持って","もって"],["いる"],["私たち","わたしたち"],["も"],["、"],["信じて","しんじて"],["いる"],["ゆえ"],["に"],["語る","かたる"],["の"],["です"],["。"]]},{"verse":14,"text":"それは、主イエスをよみがえらせた方が、私たちをもイエスとともによみがえらせ、あなたがたといっしょに御前に立たせてくださることを知っているからです。","tok":[["それ"],["は"],["、"],["主","しゅ"],["イエス"],["を"],["よみがえらせた"],["方","ほう"],["が"],["、"],["私たち","わたしたち"],["を"],["も"],["イエス"],["と"],["とも"],["に"],["よみがえらせ"],["、"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["御前","ごぜん"],["に"],["立たせて","たたせて"],["くださる"],["こと"],["を"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":15,"text":"すべてのことはあなたがたのためであり、それは、恵みがますます多くの人々に及んで感謝が満ちあふれ、神の栄光が現れるようになるためです。","tok":[["すべて"],["の"],["こと"],["は"],["あなた"],["がた"],["の"],["ため"],["で"],["あり"],["、"],["それ"],["は"],["、"],["恵み","めぐみ"],["が"],["ますます"],["多く","おおく"],["の"],["人々","ひとびと"],["に"],["及んで","およんで"],["感謝","かんしゃ"],["が"],["満ちあふれ","みちあふれ"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["現れる","あらわれる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":16,"text":"ですから、私たちは勇気を失いません。たとい私たちの外なる人は衰えても、内なる人は日々新たにされています。","tok":[["です"],["から"],["、"],["私たち","わたしたち"],["は"],["勇気","ゆうき"],["を"],["失いません","うしないません"],["。"],["たとい"],["私たち","わたしたち"],["の"],["外","そと"],["なる"],["人","ひと"],["は"],["衰えて","おとろえて"],["も"],["、"],["内","うち"],["なる"],["人","ひと"],["は"],["日々","ひび"],["新た","あらた"],["に"],["されて"],["います"],["。"]]},{"verse":17,"text":"今の時の軽い患難は、私たちのうちに働いて、測り知れない、重い永遠の栄光をもたらすからです。","tok":[["今","いま"],["の"],["時","とき"],["の"],["軽い","かるい"],["患難","かんなん"],["は"],["、"],["私たち","わたしたち"],["の"],["うち"],["に"],["働いて","はたらいて"],["、"],["測り知れない","はかりしれない"],["、"],["重い","おもい"],["永遠","えいえん"],["の"],["栄光","えいこう"],["を"],["もたらす"],["から"],["です"],["。"]]},{"verse":18,"text":"私たちは、見えるものにではなく、見えないものにこそ目を留めます。見えるものは一時的であり、見えないものはいつまでも続くからです。","tok":[["私たち","わたしたち"],["は"],["、"],["見える","みえる"],["もの"],["に"],["で"],["は"],["なく"],["、"],["見えない","みえない"],["もの"],["に"],["こそ"],["目","め"],["を"],["留めます","とめます"],["。"],["見える","みえる"],["もの"],["は"],["一時的","いちじてき"],["で"],["あり"],["、"],["見えない","みえない"],["もの"],["は"],["いつ"],["まで"],["も"],["続く","つづく"],["から"],["です"],["。"]]}]
],["良心","りょうしん"],["に"],["も"],["明らか","あきらか"],["に"],["なる"],["こと"],["が"],["、"],["私","わたくし"],["の"],["望み","のぞみ"],["です"],["。"]]},{"verse":12,"text":"私たちはまたも自分自身をあなたがたに推薦しようとするのではありません。ただ、私たちのことを誇る機会をあなたがたに与えて、心においてではなく、うわべのことで誇る人たちに答えることができるようにさせたいのです。","tok":[["私たち","わたしたち"],["は"],["また"],["も"],["自分","じぶん"],["自身","じしん"],["を"],["あなた"],["がた"],["に"],["推薦","すいせん"],["しよう"],["と"],["する"],["ので"],["は"],["ありません"],["。"],["ただ"],["、"],["私たち","わたしたち"],["の"],["こと"],["を"],["誇る","ほこる"],["機会","きかい"],["を"],["あなた"],["がた"],["に"],["与えて","あたえて"],["、"],["心","こころ"],["に"],["おいて"],["で"],["は"],["なく"],["、"],["うわべ"],["の"],["こと"],["で"],["誇る","ほこる"],["人","ひと"],["たち"],["に"],["答える","こたえる"],["こと"],["が"],["できる"],["よう"],["に"],["させたい"],["の"],["です"],["。"]]},{"verse":13,"text":"もし私たちが気が狂っているとすれば、それはただ神のためであり、もし正気であるとすれば、それはただあなたがたのためです。","tok":[["もし"],["私たち","わたしたち"],["が"],["気","き"],["が"],["狂って","くるって"],["いる"],["と"],["すれば"],["、"],["それ"],["は"],["ただ"],["神","かみ"],["の"],["ため"],["で"],["あり"],["、"],["もし"],["正気","しょうき"],["で"],["ある"],["と"],["すれば"],["、"],["それ"],["は"],["ただ"],["あなた"],["がた"],["の"],["ため"],["です"],["。"]]},{"verse":14,"text":"というのは、キリストの愛が私たちを取り囲んでいるからです。私たちはこう考えました。ひとりの人がすべての人のために死んだ以上、すべての人が死んだのです。","tok":[["と"],["いう"],["の"],["は"],["、"],["キリスト"],["の"],["愛","あい"],["が"],["私たち","わたしたち"],["を"],["取り囲んで","とりかこんで"],["いる"],["から"],["です"],["。"],["私たち","わたしたち"],["は"],["こう"],["考えました","かんがえました"],["。"],["ひとり"],["の"],["人","ひと"],["が"],["すべて"],["の"],["人","ひと"],["の"],["ため"],["に"],["死んだ","しんだ"],["以上","いじょう"],["、"],["すべて"],["の"],["人","ひと"],["が"],["死んだ","しんだ"],["の"],["です"],["。"]]},{"verse":15,"text":"また、キリストがすべての人のために死なれたのは、生きている人々が、もはや自分のためにではなく、自分のために死んでよみがえった方のために生きるためなのです。","tok":[["また"],["、"],["キリスト"],["が"],["すべて"],["の"],["人","ひと"],["の"],["ため"],["に"],["死なれた","しなれた"],["の"],["は"],["、"],["生きて","いきて"],["いる"],["人々","ひとびと"],["が"],["、"],["もはや"],["自分","じぶん"],["の"],["ため"],["に"],["で"],["は"],["なく"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["死んで","しんで"],["よみがえった"],["方","ほう"],["の"],["ため"],["に"],["生きる","いきる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":16,"text":"ですから、私たちは今後、人間的な標準で人を知ろうとはしません。かつては人間的な標準でキリストを知っていたとしても、今はもうそのような知り方はしません。","tok":[["です"],["から"],["、"],["私たち","わたしたち"],["は"],["今後","こんご"],["、"],["人間的","にんげんてき"],["な"],["標準","ひょうじゅん"],["で"],["人","ひと"],["を"],["知ろう","しろう"],["と"],["は"],["しません"],["。"],["かつて"],["は"],["人間的","にんげんてき"],["な"],["標準","ひょうじゅん"],["で"],["キリスト"],["を"],["知って","しって"],["いた"],["として"],["も"],["、"],["今","いま"],["は"],["もう"],["その"],["よう"],["な"],["知り","しり"],["方","かた"],["は"],["しません"],["。"]]},{"verse":17,"text":"だれでもキリストのうちにあるなら、その人は新しく造られた者です。古いものは過ぎ去って、見よ、すべてが新しくなりました。","tok":[["だれ"],["で"],["も"],["キリスト"],["の"],["うち"],["に"],["あるなら"],["、"],["その"],["人","ひと"],["は"],["新しく","あたらしく"],["造られた","つくられた"],["者","もの"],["です"],["。"],["古い","ふるい"],["もの"],["は"],["過ぎ去って","すぎさって"],["、"],["見よ","みよ"],["、"],["すべて"],["が"],["新しく","あたらしく"],["なりました"],["。"]]},{"verse":18,"text":"これらのことはすべて、神から出ているのです。神は、キリストによって、私たちをご自分と和解させ、また和解の務めを私たちに与えてくださいました。","tok":[["これ"],["ら"],["の"],["こと"],["は"],["すべて"],["、"],["神","かみ"],["から"],["出て","でて"],["いる"],["の"],["です"],["。"],["神","かみ"],["は"],["、"],["キリスト"],["によって"],["、"],["私たち","わたしたち"],["を"],["ご自分","ごじぶん"],["と"],["和解","わかい"],["させ"],["、"],["また"],["和解","わかい"],["の"],["務め","つとめ"],["を"],["私たち","わたしたち"],["に"],["与えて","あたえて"],["くださいました"],["。"]]},{"verse":19,"text":"すなわち、神は、キリストにあって、この世をご自分と和解させ、違反行為の責めを人々に負わせないで、和解のことばを私たちにゆだねられたのです。","tok":[["すなわち"],["、"],["神","かみ"],["は"],["、"],["キリスト"],["に"],["あって"],["、"],["この世","このよ"],["を"],["ご自分","ごじぶん"],["と"],["和解","わかい"],["させ"],["、"],["違反","いはん"],["行為","こうい"],["の"],["責め","せめ"],["を"],["人々","ひとびと"],["に"],["負わせないで","おわせないで"],["、"],["和解","わかい"],["の"],["ことば"],["を"],["私たち","わたしたち"],["に"],["ゆだねられた"],["の"],["です"],["。"]]},{"verse":20,"text":"こういうわけで、私たちはキリストの使節なのです。ちょうど神が私たちを通して懇願しておられるようです。私たちは、キリストに代わって、あなたがたに願います。神の和解を受け入れなさい。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["私たち","わたしたち"],["は"],["キリスト"],["の"],["使節","しせつ"],["な"],["の"],["です"],["。"],["ちょうど"],["神","かみ"],["が"],["私たち","わたしたち"],["を"],["通して","とおして"],["懇願","こんがん"],["して"],["おられる"],["よう"],["です"],["。"],["私たち
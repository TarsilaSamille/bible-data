[{"verse":1,"text":"神のみこころによるキリスト・イエスの使徒パウロ、および兄弟テモテから、コリントにある神の教会、ならびにアカヤ全土にいるすべての聖徒たちへ。","tok":[["神","かみ"],["のみ"],["こころ"],["に"],["よる"],["キリスト"],["・"],["イエス"],["の"],["使徒","しと"],["パウロ"],["、"],["および"],["兄弟","きょうだい"],["テモテ"],["から"],["、"],["コリント"],["に"],["ある"],["神","かみ"],["の"],["教会","きょうかい"],["、"],["ならびに"],["アカヤ"],["全土","ぜんど"],["に"],["いる"],["すべて"],["の"],["聖徒","せいと"],["たち"],["へ"],["。"]]},{"verse":2,"text":"私たちの父なる神と主イエス・キリストから、恵みと平安があなたがたの上にありますように。","tok":[["私たち","わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"]]},{"verse":3,"text":"私たちの主イエス・キリストの父なる神、慈愛の父、すべての慰めの神がほめたたえられますように。","tok":[["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["、"],["慈愛","じあい"],["の"],["父","ちち"],["、"],["すべて"],["の"],["慰め","なぐさめ"],["の"],["神","かみ"],["が"],["ほめたたえられます"],["よう"],["に"],["。"]]},{"verse":4,"text":"神は、どのような苦しみのときにも、私たちを慰めてくださいます。こうして、私たちも、自分自身が神から受ける慰めによって、どのような苦しみの中にいる人をも慰めることができるのです。","tok":[["神","かみ"],["は"],["、"],["どのような"],["苦しみ","くるしみ"],["の"],["とき"],["に"],["も"],["、"],["私たち","わたしたち"],["を"],["慰めて","なぐさめて"],["くださいます"],["。"],["こう"],["して"],["、"],["私たち","わたしたち"],["も"],["、"],["自分","じぶん"],["自身","じしん"],["が"],["神","かみ"],["から"],["受ける","うける"],["慰め","なぐさめ"],["によって"],["、"],["どのような"],["苦しみ","くるしみ"],["の"],["中","なか"],["に"],["いる"],["人","ひと"],["を"],["も"],["慰める","なぐさめる"],["こと"],["が"],["できる"],["の"],["です"],["。"]]},{"verse":5,"text":"それは、私たちにキリストの苦難があふれているように、慰めもまたキリストによってあふれているからです。","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["に"],["キリスト"],["の"],["苦難","くなん"],["が"],["あふれて"],["いる"],["よう"],["に"],["、"],["慰め","なぐさめ"],["も"],["また"],["キリスト"],["によって"],["あふれて"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"もし私たちが苦しみに会うなら、それはあなたがたの慰めと救いのためです。もし私たちが慰めを受けるなら、それもあなたがたの慰めのためで、その慰めは、私たちが受けている苦難と同じ苦難に耐え抜く力をあなたがたに与えるのです。","tok":[["もし"],["私たち","わたしたち"],["が"],["苦しみ","くるしみ"],["に"],["会うなら","あうなら"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["慰め","なぐさめ"],["と"],["救い","すくい"],["の"],["ため"],["です"],["。"],["もし"],["私たち","わたしたち"],["が"],["慰め","なぐさめ"],["を"],["受けるなら","うけるなら"],["、"],["それ"],["も"],["あなた"],["がた"],["の"],["慰め","なぐさめ"],["の"],["ため"],["で"],["、"],["その"],["慰め","なぐさめ"],["は"],["、"],["私たち","わたしたち"],["が"],["受けて","うけて"],["いる"],["苦難","くなん"],["と"],["同じ","おなじ"],["苦難","くなん"],["に"],["耐え","たえ"],["抜く","ぬく"],["力","ちから"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["の"],["です"],["。"]]},{"verse":7,"text":"私たちがあなたがたについて抱いている望みは、動くことがありません。なぜなら、あなたがたが私たちと苦しみをともにしているように、慰めをもともにしていることを、私たちは知っているからです。","tok":[["私たち","わたしたち"],["が"],["あなた"],["がた"],["について"],["抱いて","いだいて"],["いる"],["望み","のぞみ"],["は"],["、"],["動く","うごく"],["こと"],["が"],["ありません"],["。"],["なぜ"],["なら"],["、"],["あなた"],["がた"],["が"],["私たち","わたしたち"],["と"],["苦しみ","くるしみ"],["を"],["とも"],["に"],["して"],["いる"],["よう"],["に"],["、"],["慰め","なぐさめ"],["を"],["も"],["とも"],["に"],["して"],["いる"],["こと"],["を"],["、"],["私たち","わたしたち"],["は"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":8,"text":"兄弟たちよ。私たちがアジヤで会った苦しみについて、ぜひ知っておいてください。私たちは、非常に激しい、耐えられないほどの圧迫を受け、ついにいのちさえも危くなり、","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["私たち","わたしたち"],["が"],["アジヤ"],["で"],["会った","あった"],["苦しみ","くるしみ"],["について"],["、"],["ぜひ"],["知って","しって"],["おいて"],["ください"],["。"],["私たち","わたしたち"],["は"],["、"],["非常","ひじょう"],["に"],["激しい","はげしい"],["、"],["耐えられない","たえられない"],["ほど"],["の"],["圧迫","あっぱく"],["を"],["受け","うけ"],["、"],["ついに"],["いのち"],["さえ"],["も"],["危く","あやうく"],["なり"],["、"]]},{"verse":9,"text":"ほんとうに、自分の心の中で死を覚悟しました。これは、もはや自分自身を頼まず、死者をよみがえらせてくださる神により頼む者となるためでした。","tok":[["ほんとう"],["に"],["、"],["自分","じぶん"],["の"],["心","こころ"],["の"],["中","なか"],["で"],["死","し"],["を"],["覚悟","かくご"],["しました"],["。"],["これ"],["は"],["、"],["もはや"],["自分","じぶん"],["自身","じしん"],["を"],["頼まず","たのまず"],["、"],["死者","ししゃ"],["を"],["よみがえらせて"],["くださる"],["神","かみ"],["に"],["より"],["頼む","たのむ"],["者","もの"],["と"],["なる"],["ため"],["でした"],["。"]]},{"verse":10,"text":"ところが神は、これほどの大きな死の危険から、私たちを救い出してくださいました。また将来も救い出してくださいます。なおも救い出してくださるという望みを、私たちはこの神に置いているのです。","tok":[["ところ"],["が"],["神","かみ"],["は"],["、"],["これ"],["ほど"],["の"],["大きな","おおきな"],["死","し"],["の"],["危険","きけん"],["から"],["、"],["私たち","わたしたち"],["を"],["救い出して","すくいだして"],["くださいました"],["。"],["また"],["将来","しょうらい"],["も"],["救い出して","すくいだして"],["くださいます"],["。"],["なお"],["も"],["救い出して","すくいだして"],["くださる"],["と"],["いう"],["望み","のぞみ"],["を"],["、"],["私たち","わたしたち"],["は"],["この"],["神","かみ"],["に"],["置いて","おいて"],["いる"],["の"],["です"],["。"]]},{"verse":11,"text":"あなたがたも祈りによって、私たちを助けて協力してくださるでしょう。それは、多くの人々の祈りにより私たちに与えられた恵みについて、多くの人々が感謝をささげるようになるためです。","tok":[["あなた"],["がた"],["も"],["祈り","いのり"],["によって"],["、"],["私たち","わたしたち"],["を"],["助けて","たすけて"],["協力","きょうりょく"],["して"],["くださるでしょう"],["。"],["それ"],["は"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["の"],["祈り","いのり"],["に"],["より"],["私たち","わたしたち"],["に"],["与えられた","あたえられた"],["恵み","めぐみ"],["について"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["感謝","かんしゃ"],["を"],["ささげる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":12,"text":"私たちがこの世の中で、特にあなたがたに対して、聖さと神から来る誠実さとをもって、人間的な知恵によらず、神の恵みによって行動していることは、私たちの良心のあかしするところであって、これこそ私たちの誇りです。","tok":[["私たち","わたしたち"],["が"],["この"],["世の中","よのなか"],["で"],["、"],["特に","とくに"],["あなた"],["がた"],["に対して","にたいして"],["、"],["聖","きよ"],["さ"],["と"],["神","かみ"],["から"],["来る","くる"],["誠実","せいじつ"],["さ"],["と"],["を"],["もって"],["、"],["人間的","にんげんてき"],["な"],["知恵","ちえ"],["に"],["よらず"],["、"],["神","かみ"],["の"],["恵み","めぐみ"],["によって"],["行動","こうどう"],["して"],["いる"],["こと"],["は"],["、"],["私たち","わたしたち"],["の"],["良心","りょうしん"],["の"],["あかし"],["する"],["ところ"],["で"],["あって"],["、"],["これ"],["こそ"],["私たち","わたしたち"],["の"],["誇り","ほこり"],["です"],["。"]]},{"verse":13,"text":"私たちは、あなたがたへの手紙で、あなたがたが読んで理解できること以外は何も書いていません。そして私は、あなたがたが十分に理解してくれることを望みます。","tok":[["私たち","わたしたち"],["は"],["、"],["あなた"],["が"],["たへ"],["の"],["手紙","てがみ"],["で"],["、"],["あなた"],["がた"],["が"],["読んで","よんで"],["理解","りかい"],["できる"],["こと"],["以外","いがい"],["は"],["何","なん"],["も"],["書いて","かいて"],["いません"],["。"],["そして"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["が"],["十分","じゅうぶん"],["に"],["理解","りかい"],["して"],["くれる"],["こと"],["を"],["望みます","のぞみます"],["。"]]},{"verse":14,"text":"あなたがたは、ある程度は、私たちを理解しているのですから、私たちの主イエスの日には、あなたがたが私たちの誇りであるように、私たちもあなたがたの誇りであるということを、さらに十分に理解してくださるよう望むのです。","tok":[["あなた"],["がた"],["は"],["、"],["ある"],["程度","ていど"],["は"],["、"],["私たち","わたしたち"],["を"],["理解","りかい"],["して"],["いる"],["の"],["です"],["から"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["の"],["日","ひ"],["に"],["は"],["、"],["あなた"],["がた"],["が"],["私たち","わたしたち"],["の"],["誇り","ほこり"],["で"],["ある"],["よう"],["に"],["、"],["私たち","わたしたち"],["も"],["あなた"],["がた"],["の"],["誇り","ほこり"],["で"],["ある"],["と"],["いう"],["こと"],["を"],["、"],["さらに"],["十分","じゅうぶん"],["に"],["理解","りかい"],["して"],["くださる"],["よう"],["望む","のぞむ"],["の"],["です"],["。"]]},{"verse":15,"text":"この確信をもって、私は次のような計画を立てました。まず初めにあなたがたのところへ行くことによって、あなたがたが恵みを二度受けられるようにしようとしたのです。","tok":[["この"],["確信","かくしん"],["を"],["もって"],["、"],["私","わたくし"],["は"],["次","つぎ"],["の"],["よう"],["な"],["計画","けいかく"],["を"],["立てました","たてました"],["。"],["まず"],["初め","はじめ"],["に"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行く","いく"],["こと"],["によって"],["、"],["あなた"],["がた"],["が"],["恵み","めぐみ"],["を"],["二","に"],["度","ど"],["受けられる","うけられる"],["よう"],["に"],["しよう"],["と"],["した"],["の"],["です"],["。"]]},{"verse":16,"text":"すなわち、あなたがたのところを通ってマケドニヤに行き、そしてマケドニヤから再びあなたがたのところに帰り、あなたがたに送られてユダヤに行きたいと思ったのです。","tok":[["すなわち"],["、"],["あなた"],["がた"],["の"],["ところ"],["を"],["通って","とおって"],["マケドニヤ"],["に"],["行き","いき"],["、"],["そして"],["マケドニヤ"],["から"],["再び","ふたたび"],["あなた"],["がた"],["の"],["ところ"],["に"],["帰り","かえり"],["、"],["あなた"],["がた"],["に"],["送られて","おくられて"],["ユダヤ"],["に"],["行きたい","いきたい"],["と"],["思った","おもった"],["の"],["です"],["。"]]},{"verse":17,"text":"そういうわけですから、この計画を立てた私が、どうして軽率でありえたでしょう。それとも、私の計画は人間的な計画であって、私にとっては、「しかり、しかり」は同時に、「否、否」なのでしょうか。","tok":[["そう"],["いう"],["わけ"],["です"],["から"],["、"],["この"],["計画","けいかく"],["を"],["立てた","たてた"],["私","わたくし"],["が"],["、"],["どう"],["して"],["軽率","けいそつ"],["で"],["あり"],["えたでしょう"],["。"],["それ"],["と"],["も"],["、"],["私","わたくし"],["の"],["計画","けいかく"],["は"],["人間的","にんげんてき"],["な"],["計画","けいかく"],["で"],["あって"],["、"],["私","わたくし"],["にとって"],["は"],["、"],["「"],["しかり"],["、"],["しかり"],["」"],["は"],["同時","どうじ"],["に"],["、"],["「"],["否","いな"],["、"],["否","いな"],["」"],["な"],["の"],["でしょう"],["か"],["。"]]},{"verse":18,"text":"しかし、神の真実にかけて言いますが、あなたがたに対する私たちのことばは、「しかり」と言って、同時に「否」と言うようなものではありません。","tok":[["しかし"],["、"],["神","かみ"],["の"],["真実","しんじつ"],["に"],["かけて"],["言います","いいます"],["が"],["、"],["あなた"],["がた"],["に"],["対する","たいする"],["私たち","わたしたち"],["の"],["ことば"],["は"],["、"],["「"],["しかり"],["」"],["と"],["言って","いって"],["、"],["同時","どうじ"],["に"],["「"],["否","いな"],["」"],["と"],["言う","いう"],["よう"],["な"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":19,"text":"私たち、すなわち、私とシルワノとテモテとが、あなたがたに宣べ伝えた神の子キリスト・イエスは、「しかり」と同時に「否」であるような方ではありません。この方には「しかり」だけがあるのです。","tok":[["私たち","わたしたち"],["、"],["すなわち"],["、"],["私","わたくし"],["と"],["シルワノ"],["と"],["テモテ"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["宣べ伝えた","のべつたえた"],["神","かみ"],["の"],["子","こ"],["キリスト"],["・"],["イエス"],["は"],["、"],["「"],["しかり"],["」"],["と"],["同時","どうじ"],["に"],["「"],["否","いな"],["」"],["で"],["ある"],["よう"],["な"],["方","かた"],["で"],["は"],["ありません"],["。"],["この"],["方","かた"],["に"],["は"],["「"],["しかり"],["」"],["だけ"],["が"],["ある"],["の"],["です"],["。"]]},{"verse":20,"text":"神の約束はことごとく、この方において「しかり」となりました。それで私たちは、この方によって「アーメン」と言い、神に栄光を帰するのです。","tok":[["神","かみ"],["の"],["約束","やくそく"],["は"],["ことごとく"],["、"],["この"],["方","かた"],["に"],["おいて"],["「"],["しかり"],["」"],["と"],["なりました"],["。"],["それ"],["で"],["私たち","わたしたち"],["は"],["、"],["この"],["方","かた"],["によって"],["「"],["アーメン"],["」"],["と"],["言い","いい"],["、"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰する","きする"],["の"],["です"],["。"]]},{"verse":21,"text":"私たちをあなたがたといっしょにキリストのうちに堅く保ち、私たちに油をそそがれた方は神です。","tok":[["私たち","わたしたち"],["を"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["キリスト"],["の"],["うち"],["に"],["堅く","かたく"],["保ち","たもち"],["、"],["私たち","わたしたち"],["に"],["油","あぶら"],["を"],["そそがれた"],["方","ほう"],["は"],["神","かみ"],["です"],["。"]]},{"verse":22,"text":"神はまた、確認の印を私たちに押し、保証として、御霊を私たちの心に与えてくださいました。","tok":[["神","かみ"],["は"],["また"],["、"],["確認","かくにん"],["の"],["印","しるし"],["を"],["私たち","わたしたち"],["に"],["押し","おし"],["、"],["保証","ほしょう"],["として"],["、"],["御霊","ごれい"],["を"],["私たち","わたしたち"],["の"],["心","こころ"],["に"],["与えて","あたえて"],["くださいました"],["。"]]},{"verse":23,"text":"私はこのいのちにかけ、神を証人にお呼びして言います。私がまだコリントへ行かないでいるのは、あなたがたに対する思いやりのためです。","tok":[["私","わたくし"],["は"],["この"],["いのち"],["に"],["かけ"],["、"],["神","かみ"],["を"],["証人","しょうにん"],["に"],["お呼び","および"],["して"],["言います","いいます"],["。"],["私","わたくし"],["が"],["まだ"],["コリント"],["へ"],["行かないで","いかないで"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["に"],["対する","たいする"],["思いやり","おもいやり"],["の"],["ため"],["です"],["。"]]},{"verse":24,"text":"私たちは、あなたがたの信仰を支配しようとする者ではなく、あなたがたの喜びのために働く協力者です。あなたがたは、信仰に堅く立っているからです。","tok":[["私たち","わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["を"],["支配","しはい"],["しよう"],["と"],["する"],["者","もの"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["喜び","よろこび"],["の"],["ため"],["に"],["働く","はたらく"],["協力者","きょうりょくしゃ"],["です"],["。"],["あなた"],["がた"],["は"],["、"],["信仰","しんこう"],["に"],["堅く","かたく"],["立って","たって"],["いる"],["から"],["です"],["。"]]}]
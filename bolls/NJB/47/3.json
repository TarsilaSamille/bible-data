[{"verse":1,"text":"私たちはまたもや自分を推薦しようとしているのでしょうか。それとも、ある人々のように、あなたがたにあてた推薦状とか、あなたがたの推薦状とかが、私たちに必要なのでしょうか。","tok":[["私たち","わたしたち"],["は"],["またもや"],["自分","じぶん"],["を"],["推薦","すいせん"],["しよう"],["として"],["いる"],["の"],["でしょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["ある"],["人々","ひとびと"],["の"],["よう"],["に"],["、"],["あなた"],["がた"],["に"],["あてた"],["推薦状","すいせんじょう"],["と"],["か"],["、"],["あなた"],["がた"],["の"],["推薦状","すいせんじょう"],["と"],["か"],["が"],["、"],["私たち","わたしたち"],["に"],["必要","ひつよう"],["な"],["の"],["でしょう"],["か"],["。"]]},{"verse":2,"text":"私たちの推薦状はあなたがたです。それは私たちの心にしるされていて、すべての人に知られ、また読まれているのです。","tok":[["私たち","わたしたち"],["の"],["推薦状","すいせんじょう"],["は"],["あなた"],["がた"],["です"],["。"],["それ"],["は"],["私たち","わたしたち"],["の"],["心","こころ"],["に"],["しるされて"],["いて"],["、"],["すべて"],["の"],["人","ひと"],["に"],["知られ","しられ"],["、"],["また"],["読まれて","よまれて"],["いる"],["の"],["です"],["。"]]},{"verse":3,"text":"あなたがたが私たちの奉仕によるキリストの手紙であり、墨によってではなく、生ける神の御霊によって書かれ、石の板にではなく、人の心の板に書かれたものであることが明らかだからです。","tok":[["あなた"],["がた"],["が"],["私たち","わたしたち"],["の"],["奉仕","ほうし"],["に"],["よる"],["キリスト"],["の"],["手紙","てがみ"],["で"],["あり"],["、"],["墨","すみ"],["によって"],["で"],["は"],["なく"],["、"],["生ける","いける"],["神","かみ"],["の"],["御霊","ごれい"],["によって"],["書かれ","かかれ"],["、"],["石","いし"],["の"],["板","いた"],["に"],["で"],["は"],["なく"],["、"],["人","ひと"],["の"],["心","こころ"],["の"],["板","いた"],["に"],["書かれた","かかれた"],["もの"],["で"],["ある"],["こと"],["が"],["明らか","あきらか"],["だ"],["から"],["です"],["。"]]},{"verse":4,"text":"私たちはキリストによって、神の御前でこういう確信を持っています。","tok":[["私たち","わたしたち"],["は"],["キリスト"],["によって"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["こう"],["いう"],["確信","かくしん"],["を"],["持って","もって"],["います"],["。"]]},{"verse":5,"text":"何事かを自分のしたことと考える資格が私たち自身にあるというのではありません。私たちの資格は神からのものです。","tok":[["何事","なにごと"],["か"],["を"],["自分","じぶん"],["の"],["した"],["こと"],["と"],["考える","かんがえる"],["資格","しかく"],["が"],["私たち","わたしたち"],["自身","じしん"],["に"],["ある"],["と"],["いう"],["ので"],["は"],["ありません"],["。"],["私たち","わたしたち"],["の"],["資格","しかく"],["は"],["神","かみ"],["から"],["の"],["もの"],["です"],["。"]]},{"verse":6,"text":"神は私たちに、新しい契約に仕える者となる資格を下さいました。文字に仕える者ではなく、御霊に仕える者です。文字は殺し、御霊は生かすからです。","tok":[["神","かみ"],["は"],["私たち","わたしたち"],["に"],["、"],["新しい","あたらしい"],["契約","けいやく"],["に"],["仕える","つかえる"],["者","もの"],["と"],["なる"],["資格","しかく"],["を"],["下さいました","くださいました"],["。"],["文字","もじ"],["に"],["仕える","つかえる"],["者","もの"],["で"],["は"],["なく"],["、"],["御霊","ごれい"],["に"],["仕える","つかえる"],["者","もの"],["です"],["。"],["文字","もじ"],["は"],["殺し","ころし"],["、"],["御霊","ごれい"],["は"],["生かす","いかす"],["から"],["です"],["。"]]},{"verse":7,"text":"もし石に刻まれた文字による、死の務めにも栄光があって、モーセの顔の、やがて消え去る栄光のゆえにさえ、イスラエルの人々がモーセの顔を見つめることができなかったほどだとすれば、","tok":[["もし"],["石","いし"],["に"],["刻まれた","きざまれた"],["文字","もじ"],["に"],["よる"],["、"],["死","し"],["の"],["務め","つとめ"],["に"],["も"],["栄光","えいこう"],["が"],["あって"],["、"],["モーセ"],["の"],["顔","かお"],["の"],["、"],["やがて"],["消え去る","きえさる"],["栄光","えいこう"],["の"],["ゆえ"],["に"],["さえ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["モーセ"],["の"],["顔","かお"],["を"],["見つめる","みつめる"],["こと"],["が"],["できなかった"],["ほど"],["だ"],["と"],["すれば"],["、"]]},{"verse":8,"text":"まして、御霊の務めには、どれほどの栄光があることでしょう。","tok":[["まして"],["、"],["御霊","ごれい"],["の"],["務め","つとめ"],["に"],["は"],["、"],["どれ"],["ほど"],["の"],["栄光","えいこう"],["が"],["ある"],["こと"],["でしょう"],["。"]]},{"verse":9,"text":"罪に定める務めに栄光があるのなら、義とする務めには、なおさら、栄光があふれるのです。","tok":[["罪","つみ"],["に"],["定める","さだめる"],["務め","つとめ"],["に"],["栄光","えいこう"],["が"],["ある"],["の"],["なら"],["、"],["義","ぎ"],["と"],["する"],["務め","つとめ"],["に"],["は"],["、"],["なおさら"],["、"],["栄光","えいこう"],["が"],["あふれる"],["の"],["です"],["。"]]},{"verse":10,"text":"そして、かつて栄光を受けたものは、この場合、さらにすぐれた栄光のゆえに、栄光のないものになっているからです。","tok":[["そして"],["、"],["かつて"],["栄光","えいこう"],["を"],["受けた","うけた"],["もの"],["は"],["、"],["この"],["場合","ばあい"],["、"],["さらに"],["すぐれた"],["栄光","えいこう"],["の"],["ゆえ"],["に"],["、"],["栄光","えいこう"],["の"],["ない"],["もの"],["に"],["なって"],["いる"],["から"],["です"],["。"]]},{"verse":11,"text":"もし消え去るべきものにも栄光があったのなら、永続するものには、なおさら栄光があるはずです。","tok":[["もし"],["消え去るべき","きえさるべき"],["もの"],["に"],["も"],["栄光","えいこう"],["が"],["あった"],["の"],["なら"],["、"],["永続","えいぞく"],["する"],["もの"],["に"],["は"],["、"],["なおさら"],["栄光","えいこう"],["が"],["ある"],["はず"],["です"],["。"]]},{"verse":12,"text":"このような望みを持っているので、私たちはきわめて大胆にふるまいます。","tok":[["この"],["よう"],["な"],["望み","のぞみ"],["を"],["持って","もって"],["いる"],["ので"],["、"],["私たち","わたしたち"],["は"],["きわめて"],["大胆","だいたん"],["に"],["ふるまいます"],["。"]]},{"verse":13,"text":"そして、モーセが、消えうせるものの最後をイスラエルの人々に見せないように、顔におおいを掛けたようなことはしません。","tok":[["そして"],["、"],["モーセ"],["が"],["、"],["消えうせる","きえうせる"],["もの"],["の"],["最後","さいご"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["見せない","みせない"],["よう"],["に"],["、"],["顔","かお"],["に"],["おおい"],["を"],["掛けた","かけた"],["よう"],["な"],["こと"],["は"],["しません"],["。"]]},{"verse":14,"text":"しかし、イスラエルの人々の思いは鈍くなったのです。というのは、今日に至るまで、古い契約が朗読されるときに、同じおおいが掛けられたままで、取りのけられてはいません。なぜなら、それはキリストによって取り除かれるものだからです。","tok":[["しかし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["思い","おもい"],["は"],["鈍く","にぶく"],["なった"],["の"],["です"],["。"],["と"],["いう"],["の"],["は"],["、"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["古い","ふるい"],["契約","けいやく"],["が"],["朗読","ろうどく"],["される"],["とき"],["に"],["、"],["同じ","おなじ"],["おおい"],["が"],["掛けられた","かけられた"],["まま"],["で"],["、"],["取りのけられ","とりのけられ"],["ては"],["いません"],["。"],["なぜ"],["なら"],["、"],["それ"],["は"],["キリスト"],["によって"],["取り除かれる","とりのぞかれる"],["もの"],["だ"],["から"],["です"],["。"]]},{"verse":15,"text":"かえって、今日まで、モーセの書が朗読されるときはいつでも、彼らの心にはおおいが掛かっているのです。","tok":[["かえって"],["、"],["今日","きょう"],["まで"],["、"],["モーセ"],["の"],["書","しょ"],["が"],["朗読","ろうどく"],["される"],["とき"],["は"],["いつ"],["で"],["も"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["に"],["は"],["おおい"],["が"],["掛かって","かかって"],["いる"],["の"],["です"],["。"]]},{"verse":16,"text":"しかし、人が主に向くなら、そのおおいは取り除かれるのです。","tok":[["しかし"],["、"],["人","ひと"],["が"],["主に","おもに"],["向くなら","むくなら"],["、"],["その"],["おおい"],["は"],["取り除かれる","とりのぞかれる"],["の"],["です"],["。"]]},{"verse":17,"text":"主は御霊です。そして、主の御霊のあるところには自由があります。","tok":[["主","ぬし"],["は"],["御霊","みたま"],["です"],["。"],["そして"],["、"],["主","ぬし"],["の"],["御霊","ごれい"],["の"],["ある"],["ところ"],["に"],["は"],["自由","じゆう"],["が"],["あります"],["。"]]},{"verse":18,"text":"私たちはみな、顔のおおいを取りのけられて、鏡のように主の栄光を反映させながら、栄光から栄光へと、主と同じかたちに姿を変えられて行きます。これはまさに、御霊なる主の働きによるのです。","tok":[["私たち","わたしたち"],["は"],["みな"],["、"],["顔","かお"],["の"],["おおい"],["を"],["取りのけられて","とりのけられて"],["、"],["鏡","かがみ"],["の"],["よう"],["に"],["主","ぬし"],["の"],["栄光","えいこう"],["を"],["反映","はんえい"],["させ"],["ながら"],["、"],["栄光","えいこう"],["から"],["栄光","えいこう"],["へ"],["と"],["、"],["主","ぬし"],["と"],["同じ","おなじ"],["かたち"],["に"],["姿","すがた"],["を"],["変えられて","かえられて"],["行きます","いきます"],["。"],["これ"],["は"],["まさに"],["、"],["御霊","みたま"],["なる"],["主","ぬし"],["の"],["働き","はたらき"],["に"],["よる"],["の"],["です"],["。"]]}]
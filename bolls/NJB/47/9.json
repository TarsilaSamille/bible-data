[{"verse":1,"text":"聖徒たちのためのこの奉仕については、いまさら、あなたがたに書き送る必要はないでしょう。","tok":[["聖徒","せいと"],["たち"],["の"],["ため"],["の"],["この"],["奉仕","ほうし"],["について"],["は"],["、"],["いまさら"],["、"],["あなた"],["がた"],["に"],["書き送る","かきおくる"],["必要","ひつよう"],["は"],["ないでしょう"],["。"]]},{"verse":2,"text":"私はあなたがたの熱意を知り、それについて、あなたがたのことをマケドニヤの人々に誇って、アカヤでは昨年から準備が進められていると言ったのです。こうして、あなたがたの熱心は、多くの人を奮起させました。","tok":[["私","わたくし"],["は"],["あなた"],["がた"],["の"],["熱意","ねつい"],["を"],["知り","しり"],["、"],["それ"],["について"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["マケドニヤ"],["の"],["人々","ひとびと"],["に"],["誇って","ほこって"],["、"],["アカヤ"],["で"],["は"],["昨年","さくねん"],["から"],["準備","じゅんび"],["が"],["進められて","すすめられて"],["いる"],["と"],["言った","いった"],["の"],["です"],["。"],["こう"],["して"],["、"],["あなた"],["がた"],["の"],["熱心","ねっしん"],["は"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["奮起","ふんき"],["させました"],["。"]]},{"verse":3,"text":"私が兄弟たちを送ることにしたのは、この場合、私たちがあなたがたについて誇ったことがむだにならず、私が言っていたとおりに準備していてもらうためです。","tok":[["私","わたくし"],["が"],["兄弟","きょうだい"],["たち"],["を"],["送る","おくる"],["こと"],["に"],["した"],["の"],["は"],["、"],["この"],["場合","ばあい"],["、"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["について"],["誇った","ほこった"],["こと"],["が"],["むだ"],["に"],["ならず"],["、"],["私","わたくし"],["が"],["言って","いって"],["いた"],["とおり"],["に"],["準備","じゅんび"],["して"],["いて"],["もらう"],["ため"],["です"],["。"]]},{"verse":4,"text":"そうでないと、もしマケドニヤの人が私といっしょに行って、準備ができていないのを見たら、あなたがたはもちろんですが、私たちも、このことを確信していただけに、恥をかくことになるでしょう。","tok":[["そう"],["で"],["ない"],["と"],["、"],["もし"],["マケドニヤ"],["の"],["人","ひと"],["が"],["私","わたくし"],["と"],["いっしょ"],["に"],["行って","いって"],["、"],["準備","じゅんび"],["が"],["できて"],["いない"],["の"],["を"],["見たら","みたら"],["、"],["あなた"],["がた"],["は"],["もちろん"],["です"],["が"],["、"],["私たち","わたしたち"],["も"],["、"],["この"],["こと"],["を"],["確信","かくしん"],["して"],["いた"],["だけ"],["に"],["、"],["恥","はじ"],["を"],["かく"],["こと"],["に"],["なるでしょう"],["。"]]},{"verse":5,"text":"そこで私は、兄弟たちに勧めて、先にそちらに行かせ、前に約束したあなたがたの贈り物を前もって用意していただくことが必要だと思いました。どうか、この献金を、惜しみながらするのではなく、好意に満ちた贈り物として用意しておいてください。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["兄弟","きょうだい"],["たち"],["に"],["勧めて","すすめて"],["、"],["先","さき"],["に"],["そちら"],["に"],["行かせ","いかせ"],["、"],["前","まえ"],["に"],["約束","やくそく"],["した"],["あなた"],["がた"],["の"],["贈り物","おくりもの"],["を"],["前もって","まえもって"],["用意","ようい"],["して"],["いただく"],["こと"],["が"],["必要","ひつよう"],["だ"],["と"],["思いました","おもいました"],["。"],["どう"],["か"],["、"],["この"],["献金","けんきん"],["を"],["、"],["惜しみ","おしみ"],["ながら"],["する"],["ので"],["は"],["なく"],["、"],["好意","こうい"],["に"],["満ちた","みちた"],["贈り物","おくりもの"],["として"],["用意","ようい"],["して"],["おいて"],["ください"],["。"]]},{"verse":6,"text":"私はこう考えます。少しだけ蒔く者は、少しだけ刈り取り、豊かに蒔く者は、豊かに刈り取ります。","tok":[["私","わたくし"],["は"],["こう"],["考えます","かんがえます"],["。"],["少し","すこし"],["だけ"],["蒔く","まく"],["者","もの"],["は"],["、"],["少し","すこし"],["だけ"],["刈り取り","かりとり"],["、"],["豊か","ゆたか"],["に"],["蒔く","まく"],["者","もの"],["は"],["、"],["豊か","ゆたか"],["に"],["刈り取ります","かりとります"],["。"]]},{"verse":7,"text":"ひとりひとり、いやいやながらでなく、強いられてでもなく、心で決めたとおりにしなさい。神は喜んで与える人を愛してくださいます。","tok":[["ひとりひとり"],["、"],["いやいや"],["ながら"],["で"],["なく"],["、"],["強いられて","しいられて"],["で"],["も"],["なく"],["、"],["心","こころ"],["で"],["決めた","きめた"],["とおり"],["に"],["し"],["なさい"],["。"],["神","かみ"],["は"],["喜んで","よろこんで"],["与える","あたえる"],["人","ひと"],["を"],["愛して","あいして"],["くださいます"],["。"]]},{"verse":8,"text":"神は、あなたがたを、常にすべてのことに満ち足りて、すべての良いわざにあふれる者とするために、あらゆる恵みをあふれるばかり与えることのできる方です。","tok":[["神","かみ"],["は"],["、"],["あなた"],["がた"],["を"],["、"],["常","つね"],["に"],["すべて"],["の"],["こと"],["に"],["満ち足りて","みちたりて"],["、"],["すべて"],["の"],["良い","よい"],["わざ"],["に"],["あふれる"],["者","もの"],["と"],["する"],["ため"],["に"],["、"],["あらゆる"],["恵み","めぐみ"],["を"],["あふれる"],["ばかり"],["与える","あたえる"],["こと"],["の"],["できる"],["方","かた"],["です"],["。"]]},{"verse":9,"text":"「この人は散らして、貧しい人々に与えた。／その義は永遠にとどまる。」／と書いてあるとおりです。","tok":[["「"],["この"],["人","ひと"],["は"],["散らして","ちらして"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["与えた","あたえた"],["。"],["／"],["その"],["義","ぎ"],["は"],["永遠","えいえん"],["に"],["とどまる"],["。"],["」"],["／"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":10,"text":"蒔く人に種と食べるパンを備えてくださる方は、あなたがたにも蒔く種を備え、それをふやし、あなたがたの義の実を増し加えてくださいます。","tok":[["蒔く","まく"],["人","ひと"],["に"],["種","しゅ"],["と"],["食べる","たべる"],["パン"],["を"],["備えて","そなえて"],["くださる"],["方","かた"],["は"],["、"],["あなた"],["がた"],["に"],["も"],["蒔く","まく"],["種","たね"],["を"],["備え","そなえ"],["、"],["それ"],["を"],["ふやし"],["、"],["あなた"],["がた"],["の"],["義","ぎ"],["の"],["実","じつ"],["を"],["増し加えて","ましくわえて"],["くださいます"],["。"]]},{"verse":11,"text":"あなたがたは、あらゆる点で豊かになって、惜しみなく与えるようになり、それが私たちを通して、神への感謝を生み出すのです。","tok":[["あなた"],["がた"],["は"],["、"],["あらゆる"],["点","てん"],["で"],["豊か","ゆたか"],["に"],["なって"],["、"],["惜しみなく","おしみなく"],["与える","あたえる"],["よう"],["に"],["なり"],["、"],["それ"],["が"],["私たち","わたしたち"],["を"],["通して","とおして"],["、"],["神","かみ"],["へ"],["の"],["感謝","かんしゃ"],["を"],["生み出す","うみだす"],["の"],["です"],["。"]]},{"verse":12,"text":"なぜなら、この奉仕のわざは、聖徒たちの必要を十分に満たすばかりでなく、神への多くの感謝を通して、満ちあふれるようになるからです。","tok":[["なぜ"],["なら"],["、"],["この"],["奉仕","ほうし"],["の"],["わざ"],["は"],["、"],["聖徒","せいと"],["たち"],["の"],["必要","ひつよう"],["を"],["十分","じゅうぶん"],["に"],["満たす","みたす"],["ばかり"],["で"],["なく"],["、"],["神","かみ"],["へ"],["の"],["多く","おおく"],["の"],["感謝","かんしゃ"],["を"],["通して","とおして"],["、"],["満ちあふれる","みちあふれる"],["よう"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":13,"text":"このわざを証拠として、彼らは、あなたがたがキリストの福音の告白に対して従順であり、彼らに、またすべての人々に惜しみなく与えていることを知って、神をあがめることでしょう。","tok":[["この"],["わざ"],["を"],["証拠","しょうこ"],["として"],["、"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["が"],["キリスト"],["の"],["福音","ふくいん"],["の"],["告白","こくはく"],["に対して","にたいして"],["従順","じゅうじゅん"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["に"],["、"],["また"],["すべて"],["の"],["人々","ひとびと"],["に"],["惜しみなく","おしみなく"],["与えて","あたえて"],["いる"],["こと"],["を"],["知って","しって"],["、"],["神","かみ"],["を"],["あがめる"],["こと"],["でしょう"],["。"]]},{"verse":14,"text":"また彼らは、あなたがたのために祈るとき、あなたがたに与えられた絶大な神の恵みのゆえに、あなたがたを慕うようになるのです。","tok":[["また"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["祈る","いのる"],["とき"],["、"],["あなた"],["がた"],["に"],["与えられた","あたえられた"],["絶大","ぜつだい"],["な"],["神","かみ"],["の"],["恵み","めぐみ"],["の"],["ゆえ"],["に"],["、"],["あなた"],["がた"],["を"],["慕う","したう"],["よう"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":15,"text":"ことばに表せないほどの賜物のゆえに、神に感謝します。","tok":[["ことば"],["に"],["表せない","あらわせない"],["ほど"],["の"],["賜物","たまもの"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["します"],["。"]]}]
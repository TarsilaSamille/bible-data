[{"verse":1,"text":"さて、兄弟たち。私たちは、マケドニヤの諸教会に与えられた神の恵みを、あなたがたに知らせようと思います。","tok":[["さて"],["、"],["兄弟","きょうだい"],["たち"],["。"],["私たち","わたしたち"],["は"],["、"],["マケドニヤ"],["の"],["諸教","しょきょう"],["会","かい"],["に"],["与えられた","あたえられた"],["神","かみ"],["の"],["恵み","めぐみ"],["を"],["、"],["あなた"],["がた"],["に"],["知らせよう","しらせよう"],["と"],["思います","おもいます"],["。"]]},{"verse":2,"text":"苦しみゆえの激しい試練の中にあっても、彼らの満ちあふれる喜びは、その極度の貧しさにもかかわらず、あふれ出て、その惜しみなく施す富となったのです。","tok":[["苦しみ","くるしみ"],["ゆえ"],["の"],["激しい","はげしい"],["試練","しれん"],["の"],["中","なか"],["に"],["あって"],["も"],["、"],["彼","かれ"],["ら"],["の"],["満ちあふれる","みちあふれる"],["喜び","よろこび"],["は"],["、"],["その"],["極度","きょくど"],["の"],["貧し","まずし"],["さ"],["に"],["も"],["かかわらず"],["、"],["あふれ出て","あふれでて"],["、"],["その"],["惜しみなく","おしみなく"],["施す","ほどこす"],["富","とみ"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":3,"text":"私はあかしします。彼らは自ら進んで、力に応じ、いや力以上にささげ、","tok":[["私","わたくし"],["は"],["あかし"],["します"],["。"],["彼","かれ"],["ら"],["は"],["自ら","みずから"],["進んで","すすんで"],["、"],["力","ちから"],["に"],["応じ","おうじ"],["、"],["いや"],["力","ちから"],["以上","いじょう"],["に"],["ささげ"],["、"]]},{"verse":4,"text":"聖徒たちをささえる交わりの恵みにあずかりたいと、熱心に私たちに願ったのです。","tok":[["聖徒","せいと"],["たち"],["を"],["ささえる"],["交わり","まじわり"],["の"],["恵み","めぐみ"],["に"],["あずかりたい"],["と"],["、"],["熱心","ねっしん"],["に"],["私たち","わたしたち"],["に"],["願った","ねがった"],["の"],["です"],["。"]]},{"verse":5,"text":"そして、私たちの期待以上に、神のみこころに従って、まず自分自身を主にささげ、また、私たちにもゆだねてくれました。","tok":[["そして"],["、"],["私たち","わたしたち"],["の"],["期待","きたい"],["以上","いじょう"],["に"],["、"],["神","かみ"],["のみ"],["こころ"],["に"],["従って","したがって"],["、"],["まず"],["自分","じぶん"],["自身","じしん"],["を"],["主に","おもに"],["ささげ"],["、"],["また"],["、"],["私たち","わたしたち"],["に"],["も"],["ゆだねて"],["くれました"],["。"]]},{"verse":6,"text":"それで私たちは、テトスがすでにこの恵みのわざをあなたがたの間で始めていたのですから、それを完了させるよう彼に勧めたのです。","tok":[["それ"],["で"],["私たち","わたしたち"],["は"],["、"],["テトス"],["が"],["すでに"],["この"],["恵み","めぐみ"],["の"],["わざ"],["を"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["始めて","はじめて"],["いた"],["の"],["です"],["から"],["、"],["それ"],["を"],["完了","かんりょう"],["させる"],["よう"],["彼","かれ"],["に"],["勧めた","すすめた"],["の"],["です"],["。"]]},{"verse":7,"text":"あなたがたは、すべてのことに、すなわち、信仰にも、ことばにも、知識にも、あらゆる熱心にも、私たちから出てあなたがたの間にある愛にも富んでいるように、この恵みのわざにも富むようになってください。","tok":[["あなた"],["がた"],["は"],["、"],["すべて"],["の"],["こと"],["に"],["、"],["すなわち"],["、"],["信仰","しんこう"],["に"],["も"],["、"],["ことば"],["に"],["も"],["、"],["知識","ちしき"],["に"],["も"],["、"],["あらゆる"],["熱心","ねっしん"],["に"],["も"],["、"],["私たち","わたしたち"],["から"],["出て","でて"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["ある"],["愛","あい"],["に"],["も"],["富んで","とんで"],["いる"],["よう"],["に"],["、"],["この"],["恵み","めぐみ"],["の"],["わざ"],["に"],["も"],["富む","とむ"],["よう"],["に"],["なって"],["ください"],["。"]]},{"verse":8,"text":"こうは言っても、私は命令するのではありません。ただ、他の人々の熱心さをもって、あなたがた自身の愛の真実を確かめたいのです。","tok":[["こう"],["は"],["言って","いって"],["も"],["、"],["私","わたくし"],["は"],["命令","めいれい"],["する"],["ので"],["は"],["ありません"],["。"],["ただ"],["、"],["他","た"],["の"],["人々","ひとびと"],["の"],["熱心","ねっしん"],["さ"],["を"],["もって"],["、"],["あなた"],["がた"],["自身","じしん"],["の"],["愛","あい"],["の"],["真実","しんじつ"],["を"],["確かめたい","たしかめたい"],["の"],["です"],["。"]]},{"verse":9,"text":"あなたがたは、私たちの主イエス・キリストの恵みを知っています。すなわち、主は富んでおられたのに、あなたがたのために貧しくなられました。それは、あなたがたが、キリストの貧しさによって富む者となるためです。","tok":[["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["恵み","めぐみ"],["を"],["知って","しって"],["います"],["。"],["すなわち"],["、"],["主","ぬし"],["は"],["富んで","とんで"],["おられた"],["のに"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["貧しく","まずしく"],["なられました"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["キリスト"],["の"],["貧し","まずし"],["さ"],["によって"],["富む","とむ"],["者","もの"],["と"],["なる"],["ため"],["です"],["。"]]},{"verse":10,"text":"この献金のことについて、私の意見を述べましょう。それはあなたがたの益になることだからです。あなたがたは、このことを昨年から、他に先んじて行っただけでなく、このことを他に先んじて願った人たちです。","tok":[["この"],["献金","けんきん"],["の"],["こと"],["について"],["、"],["私","わたくし"],["の"],["意見","いけん"],["を"],["述べましょう","のべましょう"],["。"],["それ"],["は"],["あなた"],["がた"],["の"],["益","えき"],["に"],["なる"],["こと"],["だ"],["から"],["です"],["。"],["あなた"],["がた"],["は"],["、"],["この"],["こと"],["を"],["昨年","さくねん"],["から"],["、"],["他","た"],["に"],["先んじて","さきんじて"],["行った","いった"],["だけ"],["で"],["なく"],["、"],["この"],["こと"],["を"],["他","ほか"],["に"],["先んじて","さきんじて"],["願った","ねがった"],["人","ひと"],["たち"],["です"],["。"]]},{"verse":11,"text":"ですから、今、それをし遂げなさい。喜んでしようと思ったのですから、持っている物で、それをし遂げることができるはずです。","tok":[["です"],["から"],["、"],["今","いま"],["、"],["それ"],["を"],["し遂げ","しとげ"],["なさい"],["。"],["喜んで","よろこんで"],["しよう"],["と"],["思った","おもった"],["の"],["です"],["から"],["、"],["持って","もって"],["いる"],["物","もの"],["で"],["、"],["それ"],["を"],["し遂げる","しとげる"],["こと"],["が"],["できる"],["はず"],["です"],["。"]]},{"verse":12,"text":"もし熱意があるならば、持たない物によってではなく、持っている程度に応じて、それは受納されるのです。","tok":[["もし"],["熱意","ねつい"],["が"],["あるならば"],["、"],["持たない","もたない"],["物","もの"],["によって"],["で"],["は"],["なく"],["、"],["持って","もって"],["いる"],["程度","ていど"],["に"],["応じて","おうじて"],["、"],["それ"],["は"],["受納","じゅのう"],["される"],["の"],["です"],["。"]]},{"verse":13,"text":"私はこのことによって、他の人々には楽をさせ、あなたがたには苦労をさせようとしているのではなく、平等を図っているのです。","tok":[["私","わたくし"],["は"],["この"],["こと"],["によって"],["、"],["他","た"],["の"],["人々","ひとびと"],["に"],["は"],["楽","らく"],["を"],["させ"],["、"],["あなた"],["がた"],["に"],["は"],["苦労","くろう"],["を"],["させよう"],["として"],["いる"],["ので"],["は"],["なく"],["、"],["平等","びょうどう"],["を"],["図って","はかって"],["いる"],["の"],["です"],["。"]]},{"verse":14,"text":"今あなたがたの余裕が彼らの欠乏を補うなら、彼らの余裕もまた、あなたがたの欠乏を補うことになるのです。こうして、平等になるのです。","tok":[["今","いま"],["あなた"],["がた"],["の"],["余裕","よゆう"],["が"],["彼","かれ"],["ら"],["の"],["欠乏","けつぼう"],["を"],["補うなら","おぎなうなら"],["、"],["彼","かれ"],["ら"],["の"],["余裕","よゆう"],["も"],["また"],["、"],["あなた"],["がた"],["の"],["欠乏","けつぼう"],["を"],["補う","おぎなう"],["こと"],["に"],["なる"],["の"],["です"],["。"],["こう"],["して"],["、"],["平等","びょうどう"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":15,"text":"「多く集めた者も余るところがなく、少し集めた者も足りないところがなかった」と書いてあるとおりです。","tok":[["「"],["多く","おおく"],["集めた","あつめた"],["者","もの"],["も"],["余る","あまる"],["ところ"],["が"],["なく"],["、"],["少し","すこし"],["集めた","あつめた"],["者","もの"],["も"],["足りない","たりない"],["ところ"],["が"],["なかった"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":16,"text":"私があなたがたのことを思うのと同じ熱心を、テトスの心にも与えてくださった神に感謝します。","tok":[["私","わたくし"],["が"],["あなた"],["がた"],["の"],["こと"],["を"],["思う","おもう"],["の"],["と"],["同
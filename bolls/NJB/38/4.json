[{"verse":1,"text":"私と話していた御使いが戻って来て、私を呼びさましたので、私は眠りからさまされた人のようであった。","tok":[["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["が"],["戻って","もどって"],["来て","きて"],["、"],["私","わたくし"],["を"],["呼びさました","よびさました"],["ので"],["、"],["私","わたくし"],["は"],["眠り","ねむり"],["から"],["さまされた"],["人","ひと"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼は私に言った。「あなたは何を見ているのか。」そこで私は答えた。「私が見ますと、全体が金でできている一つの燭台があります。その上部には、鉢があり、その鉢の上には七つのともしび皿があり、この上部にあるともしび皿には、それぞれ七つの管がついています。","tok":[["彼","かれ"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["何","なん"],["を"],["見て","みて"],["いる"],["の"],["か"],["。"],["」"],["そこ"],["で"],["私","わたくし"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["が"],["見ます","みます"],["と"],["、"],["全体","ぜんたい"],["が"],["金","かね"],["で"],["できて"],["いる"],["一","ひと"],["つ"],["の"],["燭台","しょくだい"],["が"],["あります"],["。"],["その"],["上部","じょうぶ"],["に"],["は"],["、"],["鉢","ばち"],["が"],["あり"],["、"],["その"],["鉢","ばち"],["の"],["上","うえ"],["に"],["は"],["七","なな"],["つ"],["の"],["ともしび"],["皿","さら"],["が"],["あり"],["、"],["この"],["上部","じょうぶ"],["に"],["ある"],["ともしび"],["皿","さら"],["に"],["は"],["、"],["それぞれ"],["七","なな"],["つ"],["の"],["管","くだ"],["が"],["ついて"],["います"],["。"]]},{"verse":3,"text":"また、そのそばには二本のオリーブの木があり、一本はこの鉢の右に、他の一本はその左にあります。」","tok":[["また"],["、"],["その"],["そば"],["に"],["は"],["二本","にぽん"],["の"],["オリーブ"],["の"],["木","き"],["が"],["あり"],["、"],["一本","いちぽん"],["は"],["この"],["鉢","ばち"],["の"],["右","みぎ"],["に"],["、"],["他","た"],["の"],["一本","いちぽん"],["は"],["その"],["左","ひだり"],["に"],["あります"],["。"],["」"]]},{"verse":4,"text":"さらに私は、私と話していた御使いにこう言った。「主よ。これらは何ですか。」","tok":[["さらに"],["私","わたくし"],["は"],["、"],["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["に"],["こう"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["これ"],["ら"],["は"],["何","なん"],["です"],["か"],["。"],["」"]]},{"verse":5,"text":"私と話していた御使いが答えて言った。「あなたは、これらが何か知らないのか。」私は言った。「主よ。知りません。」","tok":[["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["が"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["これ"],["ら"],["が"],["何","なん"],["か"],["知らない","しらない"],["の"],["か"],["。"],["」"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["知りません","しりません"],["。"],["」"]]},{"verse":6,"text":"すると彼は、私に答えてこう言った。「これは、ゼルバベルへの主のことばだ。『権力によらず、能力によらず、わたしの霊によって』と万軍の主は仰せられる。","tok":[["する"],["と"],["彼","かれ"],["は"],["、"],["私","わたくし"],["に"],["答えて","こたえて"],["こう"],["言った","いった"],["。"],["「"],["これ"],["は"],["、"],["ゼルバベル"],["へ"],["の"],["主","ぬし"],["の"],["ことば"],["だ"],["。"],["『"],["権力","けんりょく"],["に"],["よらず"],["、"],["能力","のうりょく"],["に"],["よらず"],["、"],["わたし"],["の"],["霊","れい"],["によって"],["』"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":7,"text":"大いなる山よ。おまえは何者だ。ゼルバベルの前で平地となれ。彼は、『恵みあれ。これに恵みあれ』と叫びながら、かしら石を運び出そう。」","tok":[["大いなる","おおいなる"],["山","やま"],["よ"],["。"],["おまえ"],["は"],["何者","なにもの"],["だ"],["。"],["ゼルバベル"],["の"],["前","まえ"],["で"],["平地","へいち"],["と"],["なれ"],["。"],["彼","かれ"],["は"],["、"],["『"],["恵み","めぐみ"],["あれ"],["。"],["これ"],["に"],["恵み","めぐみ"],["あれ"],["』"],["と"],["叫び","さけび"],["ながら"],["、"],["かしら"],["石","いし"],["を"],["運び出そう","はこびだそう"],["。"],["」"]]},{"verse":8,"text":"ついで私に次のような主のことばがあった。","tok":[["ついで"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":9,"text":"「ゼルバベルの手が、この宮の礎を据えた。彼の手が、それを完成する。このとき、あなたは、万軍の主が私をあなたがたに遣わされたことを知ろう。","tok":[["「"],["ゼルバベル"],["の"],["手","て"],["が"],["、"],["この"],["宮","みや"],["の"],["礎","いしずえ"],["を"],["据えた","すえた"],["。"],["彼","かれ"],["の"],["手","て"],["が"],["、"],["それ"],["を"],["完成","かんせい"],["する"],["。"],["この"],["とき"],["、"],["あなた"],["は"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["私","わたくし"],["を"],["あなた"],["がた"],["に"],["遣わされた","つかわされた"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":10,"text":"だれが、その日を小さな事としてさげすんだのか。これらは、ゼルバベルの手にある下げ振りを見て喜ぼう。これらの七つは、全地を行き巡る主の目である。」","tok":[["だれ"],["が"],["、"],["その"],["日","ひ"],["を"],["小さな","ちいさな"],["事","こと"],["として"],["さげすんだ"],["の"],["か"],["。"],["これ"],["ら"],["は"],["、"],["ゼルバベル"],["の"],["手","て"],["に"],["ある"],["下げ振り","さげふり"],["を"],["見て","みて"],["喜ぼう","よろこぼう"],["。"],["これ"],["ら"],["の"],["七","なな"],["つ"],["は"],["、"],["全地","ぜんち"],["を"],["行き","いき"],["巡る","めぐる"],["主","ぬし"],["の"],["目","め"],["で"],["ある"],["。"],["」"]]},{"verse":11,"text":"私はまた、彼に尋ねて言った。「燭台の右左にある、この二本のオリーブの木は何ですか。」","tok":[["私","わたくし"],["は"],["また"],["、"],["彼","かれ"],["に"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["燭台","しょくだい"],["の"],["右左","みぎひだり"],["に"],["ある"],["、"],["この"],["二本","にぽん"],["の"],["オリーブ"],["の"],["木","き"],["は"],["何","なん"],["です"],["か"],["。"],["」"]]},{"verse":12,"text":"私は再び尋ねて言った。「二本の金の管によって油をそそぎ出すこのオリーブの二本の枝は何ですか。」","tok":[["私","わたくし"],["は"],["再び","ふたたび"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["二本","にぽん"],["の"],["金","かね"],["の"],["管","くだ"],["によって"],["油","あぶら"],["を"],["そそぎ"],["出す","だす"],["この"],["オリーブ"],["の"],["二本","にぽん"],["の"],["枝","えだ"],["は"],["何","なん"],["です"],["か"],["。"],["」"]]},{"verse":13,"text":"すると彼は、私にこう言った。「あなたは、これらが何か知らないのか。」私は言った。「主よ。知りません。」","tok":[["する"],["と"],["彼","かれ"],["は"],["、"],["私","わたくし"],["に"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["これ"],["ら"],["が"],["何","なん"],["か"],["知らない","しらない"],["の"],["か"],["。"],["」"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["知りません","しりません"],["。"],["」"]]},{"verse":14,"text":"彼は言った。「これらは、全地の主のそばに立つ、ふたりの油そそがれた者だ。」","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["これ"],["ら"],["は"],["、"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["そば"],["に"],["立つ","たつ"],["、"],["ふたり"],["の"],["油","あぶら"],["そそがれた"],["者","もの"],["だ"],["。"],["」"]]}]
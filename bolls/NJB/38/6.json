[{"verse":1,"text":"私が再び目を上げて見ると、なんと、四台の戦車が二つの山の間から出て来ていた。山は青銅の山であった。","tok":[["私","わたくし"],["が"],["再び","ふたたび"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["四","よん"],["台","だい"],["の"],["戦車","せんしゃ"],["が"],["二","ふた"],["つ"],["の"],["山","やま"],["の"],["間","あいだ"],["から"],["出て","でて"],["来て","きて"],["いた"],["。"],["山","やま"],["は"],["青銅","せいどう"],["の"],["山","やま"],["で"],["あった"],["。"]]},{"verse":2,"text":"第一の戦車は赤い馬が、第二の戦車は黒い馬が、","tok":[["第","だい"],["一","いち"],["の"],["戦車","せんしゃ"],["は"],["赤い","あかい"],["馬","うま"],["が"],["、"],["第","だい"],["二","に"],["の"],["戦車","せんしゃ"],["は"],["黒い","くろい"],["馬","うま"],["が"],["、"]]},{"verse":3,"text":"第三の戦車は白い馬が、第四の戦車はまだら毛の強い馬が引いていた。","tok":[["第","だい"],["三","さん"],["の"],["戦車","せんしゃ"],["は"],["白い","しろい"],["馬","うま"],["が"],["、"],["第","だい"],["四","よん"],["の"],["戦車","せんしゃ"],["は"],["まだら"],["毛","け"],["の"],["強い","つよい"],["馬","うま"],["が"],["引いて","ひいて"],["いた"],["。"]]},{"verse":4,"text":"私は、私と話していた御使いに尋ねて言った。「主よ。これらは何ですか。」","tok":[["私","わたくし"],["は"],["、"],["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["に"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["これ"],["ら"],["は"],["何","なん"],["です"],["か"],["。"],["」"]]},{"verse":5,"text":"御使いは答えて言った。「これらは、全地の主の前に立って後、天の四方に出て行くものだ。","tok":[["御使い","おつかい"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["これ"],["ら"],["は"],["、"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["前","まえ"],["に"],["立って","たって"],["後","あと"],["、"],["天","てん"],["の"],["四方","しほう"],["に"],["出て","でて"],["行く","いく"],["もの"],["だ"],["。"]]},{"verse":6,"text":"そのうち、黒い馬は北の地へ出て行き、白い馬はそのあとに出て行き、まだら毛の馬は南の地へ出て行く。","tok":[["その"],["うち"],["、"],["黒い","くろい"],["馬","うま"],["は"],["北","きた"],["の"],["地","ち"],["へ"],["出て","でて"],["行き","いき"],["、"],["白い","しろい"],["馬","うま"],["は"],["その"],["あと"],["に"],["出て","でて"],["行き","いき"],["、"],["まだら"],["毛","け"],["の"],["馬","うま"],["は"],["南","みなみ"],["の"],["地","ち"],["へ"],["出て","でて"],["行く","いく"],["。"]]},{"verse":7,"text":"この強い馬が出て行き、地を駆け巡ろうとしているのだ。」そこで彼が、「行って、地を駆け巡れ」と言うと、それらは地を駆け巡った。","tok":[["この"],["強い","つよい"],["馬","うま"],["が"],["出て","でて"],["行き","いき"],["、"],["地","ち"],["を"],["駆け巡ろう","かけめぐろう"],["として"],["いる"],["の"],["だ"],["。"],["」"],["そこ"],["で"],["彼","かれ"],["が"],["、"],["「"],["行って","いって"],["、"],["地","ち"],["を"],["駆け巡れ","かけめぐれ"],["」"],["と"],["言う","ゆう"],["と"],["、"],["それ"],["ら"],["は"],["地","ち"],["を"],["駆け巡った","かけめぐった"],["。"]]},{"verse":8,"text":"そのとき、彼は私にこう告げた。「見よ。北の地へ出て行ったものを。それらは北の地で、わたしの怒りを静める。」","tok":[["その"],["とき"],["、"],["彼","かれ"],["は"],["私","わたくし"],["に"],["こう"],["告げた","つげた"],["。"],["「"],["見","み"],["よ"],["。"],["北","きた"],["の"],["地","ち"],["へ"],["出て","でて"],["行った","いった"],["もの"],["を"],["。"],["それ"],["ら"],["は"],["北","きた"],["の"],["地","ち"],["で"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["静める","しずめる"],["。"],["」"]]},{"verse":9,"text":"ついで私に次のような主のことばがあった。","tok":[["ついで"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":10,"text":"「捕囚の民であったヘルダイ、トビヤ、エダヤからささげ物を受け取り、その日、あなたはバビロンから帰って来たゼパニヤの子ヨシヤの家へ行け。","tok":[["「"],["捕囚","ほしゅう"],["の"],["民","たみ"],["で"],["あった"],["ヘルダイ"],["、"],["トビヤ"],["、"],["エダヤ"],["から"],["ささげ物","ささげもの"],["を"],["受け取り","うけとり"],["、"],["その"],["日","ひ"],["、"],["あなた"],["は"],["バビロン"],["から"],["帰って","かえって"],["来た","きた"],["ゼパニヤ"],["の"],["子","こ"],["ヨシヤ"],["の"],["家","いえ"],["へ"],["行け","いけ"],["。"]]},{"verse":11,"text":"あなたは金と銀を取って、冠を作り、それをエホツァダクの子、大祭司ヨシュアの頭にかぶらせ、","tok":[["あなた"],["は"],["金","きん"],["と"],["銀","ぎん"],["を"],["取って","とって"],["、"],["冠","かんむり"],["を"],["作り","つくり"],["、"],["それ"],["を"],["エホツァダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["の"],["頭","あたま"],["に"],["かぶらせ"],["、"]]},{"verse":12,"text":"彼にこう言え。『万軍の主はこう仰せられる。見よ。ひとりの人がいる。その名は若枝。彼のいる所から芽を出し、主の神殿を建て直す。","tok":[["彼","かれ"],["に"],["こう"],["言え","いえ"],["。"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["ひとり"],["の"],["人","ひと"],["が"],["いる"],["。"],["その"],["名","な"],["は"],["若枝","わかえだ"],["。"],["彼","かれ"],["の"],["いる"],["所","ところ"],["から"],["芽","め"],["を"],["出し","だし"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["を"],["建て直す","たてなおす"],["。"]]},{"verse":13,"text":"彼は主の神殿を建て、彼は尊厳を帯び、その王座に着いて支配する。その王座のかたわらに、ひとりの祭司がいて、このふたりの間には平和の一致がある。』","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["を"],["建て","たて"],["、"],["彼","かれ"],["は"],["尊厳","そんげん"],["を"],["帯び","おび"],["、"],["その"],["王座","おうざ"],["に"],["着いて","ついて"],["支配","しはい"],["する"],["。"],["その"],["王座","おうざ"],["の"],["かたわら"],["に"],["、"],["ひとり"],["の"],["祭司","さいし"],["が"],["いて"],["、"],["この"],["ふたり"],["の"],["間","あいだ"],["に"],["は"],["平和","へいわ"],["の"],["一致","いっち"],["が"],["ある"],["。"],["』"]]},{"verse":14,"text":"その冠は、ヘルダイ、トビヤ、エダヤ、ゼパニヤの子ヨシヤの記念として、主の神殿のうちに残ろう。","tok":[["その"],["冠","かんむり"],["は"],["、"],["ヘルダイ"],["、"],["トビヤ"],["、"],["エダヤ"],["、"],["ゼパニヤ"],["の"],["子","こ"],["ヨシヤ"],["の"],["記念","きねん"],["として"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["うち"],["に"],["残ろう","のころう"],["。"]]},{"verse":15,"text":"また、遠く離れていた者たちも来て、主の神殿を建て直そう。このとき、あなたがたは、万軍の主が私をあなたがたに遣わされたことを知ろう。もし、あなたがたが、あなたがたの神、主の御声に、ほんとうに聞き従うなら、そのようになる。」","tok":[["また"],["、"],["遠く","とおく"],["離れて","はなれて"],["いた"],["者","もの"],["たち"],["も"],["来て","きて"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["を"],["建て直そう","たてなおそう"],["。"],["この"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["私","わたくし"],["を"],["あなた"],["がた"],["に"],["遣わされた","つかわされた"],["こと"],["を"],["知ろう","しろう"],["。"],["もし"],["、"],["あなた"],["が"],["た"],["が"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["、"],["ほんとう"],["に"],["聞き従うなら","ききしたがうなら"],["、"],["その"],["よう"],["に"],["なる"],["。"],["」"]]}]
[{"verse":1,"text":"次のような万軍の主のことばがあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"万軍の主はこう仰せられる。「わたしは、シオンをねたむほど激しく愛し、ひどい憤りでこれをねたむ。」","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["わたし"],["は"],["、"],["シオン"],["を"],["ねたむ"],["ほど"],["激しく","はげしく"],["愛し","あいし"],["、"],["ひどい"],["憤り","いきどおり"],["で"],["これ"],["を"],["ねたむ"],["。"],["」"]]},{"verse":3,"text":"主はこう仰せられる。「わたしはシオンに帰り、エルサレムのただ中に住もう。エルサレムは真実の町と呼ばれ、万軍の主の山は聖なる山と呼ばれよう。」","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["わたし"],["は"],["シオン"],["に"],["帰り","かえり"],["、"],["エルサレム"],["の"],["ただ中","ただなか"],["に"],["住もう","すもう"],["。"],["エルサレム"],["は"],["真実","しんじつ"],["の"],["町","まち"],["と"],["呼ばれ","よばれ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["山","やま"],["は"],["聖","せい"],["なる"],["山","やま"],["と"],["呼ばれよう","よばれよう"],["。"],["」"]]},{"verse":4,"text":"万軍の主はこう仰せられる。「再び、エルサレムの広場には、老いた男、老いた女がすわり、年寄りになって、みな手に杖を持とう。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["再び","ふたたび"],["、"],["エルサレム"],["の"],["広場","ひろば"],["に"],["は"],["、"],["老いた","おいた"],["男","おとこ"],["、"],["老いた","おいた"],["女","おんな"],["が"],["すわり"],["、"],["年寄り","としより"],["に"],["なって"],["、"],["みな"],["手","て"],["に"],["杖","つえ"],["を"],["持とう","もとう"],["。"]]},{"verse":5,"text":"町の広場は、広場で遊ぶ男の子や女の子でいっぱいになろう。」","tok":[["町","まち"],["の"],["広場","ひろば"],["は"],["、"],["広場","ひろば"],["で"],["遊ぶ","あそぶ"],["男の子","おとこのこ"],["や"],["女の子","おんなのこ"],["で"],["いっぱい"],["に"],["なろう"],["。"],["」"]]},{"verse":6,"text":"万軍の主はこう仰せられる。「もし、これが、その日、この民の残りの者の目に不思議に見えても、わたしの目に、これが不思議に見えるだろうか。――万軍の主の御告げ――」","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["もし"],["、"],["これ"],["が"],["、"],["その"],["日","ひ"],["、"],["この"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["の"],["目","め"],["に"],["不思議","ふしぎ"],["に"],["見えて","みえて"],["も"],["、"],["わたし"],["の"],["目","め"],["に"],["、"],["これ"],["が"],["不思議","ふしぎ"],["に"],["見えるだろう","みえるだろう"],["か"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":7,"text":"万軍の主はこう仰せられる。「見よ。わたしは、わたしの民を日の出る地と日の入る地から救い、","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["わたし"],["の"],["民","たみ"],["を"],["日","ひ"],["の"],["出る","でる"],["地","ち"],["と"],["日","ひ"],["の"],["入る","はいる"],["地","ち"],["から"],["救い","すくい"],["、"]]},{"verse":8,"text":"彼らを連れ帰り、エルサレムの中に住ませる。このとき、彼らはわたしの民となり、わたしは真実と正義をもって彼らの神となる。」","tok":[["彼","かれ"],["ら"],["を"],["連れ帰り","つれかえり"],["、"],["エルサレム"],["の"],["中","なか"],["に"],["住ませる","すませる"],["。"],["この"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["真実","しんじつ"],["と"],["正義","せいぎ"],["を"],["もって"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"],["」"]]},{"verse":9,"text":"万軍の主はこう仰せられる。「勇気を出せ。あなたがたは、万軍の主の家である神殿を建てるための礎が据えられた日以来、預言者たちの口から、これらのことばを日ごろ聞いているではないか。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["勇気","ゆうき"],["を"],["出せ","だせ"],["。"],["あなた"],["がた"],["は"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["家","いえ"],["で"],["ある"],["神殿","しんでん"],["を"],["建てる","たてる"],["ため"],["の"],["礎","いしずえ"],["が"],["据えられた","すえられた"],["日","ひ"],["以来","いらい"],["、"],["預言者","よげんしゃ"],["たち"],["の"],["口","くち"],["から"],["、"],["これ"],["ら"],["の"],["ことば"],["を"],["日ごろ","ひごろ"],["聞いて","きいて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":10,"text":"その日以前は、人がかせいでも報酬がなく、家畜がかせいでも報酬がなかった。出て行く者にも、帰って来る者にも、敵がいるために平安はなかった。わたしがすべての人を互いに争わせたからだ。","tok":[["その"],["日","ひ"],["以前","いぜん"],["は"],["、"],["人","ひと"],["が"],["かせいで"],["も"],["報酬","ほうしゅう"],["が"],["なく"],["、"],["家畜","かちく"],["が"],["かせいで"],["も"],["報酬","ほうしゅう"],["が"],["なかった"],["。"],["出て","でて"],["行く","いく"],["者","もの"],["に"],["も"],["、"],["帰って","かえって"],["来る","くる"],["者","もの"],["に"],["も"],["、"],["敵","てき"],["が"],["いる"],["ため"],["に"],["平安","へいあん"],["は"],["なかった"],["。"],["わたし"],["が"],["すべて"],["の"],["人","ひと"],["を"],["互い","たがい"],["に"],["争わせた","あらそわせた"],["から"],["だ"],["。"]]},{"verse":11,"text":"しかし、今は、わたしはこの民の残りの者に対して、先の日のようではない。――万軍の主の御告げ――","tok":[["しかし"],["、"],["今","いま"],["は"],["、"],["わたし"],["は"],["この"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["に対して","にたいして"],["、"],["先の日","さきのひ"],["の"],["よう"],["で"],["は"],["ない"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":12,"text":"それは、平安の種が蒔かれ、ぶどうの木は実を結び、地は産物を出し、天は露を降らすからだ。わたしはこの民の残りの者に、これらすべてを継がせよう。","tok":[["それ"],["は"],["、"],["平安","へいあん"],["の"],["種","たね"],["が"],["蒔かれ","まかれ"],["、"],["ぶどう"],["の"],["木","き"],["は"],["実","じつ"],["を"],["結び","むすび"],["、"],["地","ち"],["は"],["産物","さんぶつ"],["を"],["出し","だし"],["、"],["天","てん"],["は"],["露","ろ"],["を"],["降らす","ふらす"],["から"],["だ"],["。"],["わたし"],["は"],["この"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["に"],["、"],["これ"],["ら"],["すべて"],["を"],["継がせよう","つがせよう"],["。"]]},{"verse":13,"text":"ユダの家よ。イスラエルの家よ。あなたがたは諸国の民の間でのろいとなったが、そのように、わたしはあなたがたを救って、祝福とならせる。恐れるな。勇気を出せ。」","tok":[["ユダ"],["の"],["家","いえ"],["よ"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["。"],["あなた"],["がた"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["間","あいだ"],["で"],["のろい"],["と"],["なった"],["が"],["、"],["その"],["よう"],["に"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["救って","すくって"],["、"],["祝福","しゅくふく"],["と"],["ならせる"],["。"],["恐れる","おそれる"],["な"],["。"],["勇気","ゆうき"],["を"],["出せ","だせ"],["。"],["」"]]},{"verse":14,"text":"万軍の主はこう仰せられる。「あなたがたの先祖がわたしを怒らせたとき、わたしはあなたがたにわざわいを下そうと考えた。――万軍の主は仰せられる――そしてわたしは思い直さなかった。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["が"],["わたし"],["を"],["怒らせた","おこらせた"],["とき"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["わざわい"],["を"],["下そう","くだそう"],["と"],["考えた","かんがえた"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"],["そして"],["わたし"],["は"],["思い直さなかった","おもいなおさなかった"],["。"]]},{"verse":15,"text":"しかし、このごろ、わたしはエルサレムとユダの家とに幸いを下そうと考えている。恐れるな。","tok":[["しかし"],["、"],["このごろ"],["、"],["わたし"],["は"],["エルサレム"],["と"],["ユダ"],["の"],["家","いえ"],["と"],["に"],["幸い","さいわい"],["を"],["下そう","くだそう"],["と"],["考えて","かんがえて"],["いる"],["。"],["恐れる","おそれる"],["な"],["。"]]},{"verse":16,"text":"これがあなたがたのしなければならないことだ。互いに真実を語り、あなたがたの町囲みのうちで、真実と平和のさばきを行え。","tok":[["これ"],["が"],["あなた"],["がた"],["の"],["しなければ"],["ならない"],["こと"],["だ"],["。"],["互い","たがい"],["に"],["真実","しんじつ"],["を"],["語り","かたり"],["、"],["あなた"],["がた"],["の"],["町","まち"],["囲み","かこみ"],["の"],["うち"],["で"],["、"],["真実","しんじつ"],["と"],["平和","へいわ"],["の"],["さばき"],["を"],["行え","おこなえ"],["。"]]},{"verse":17,"text":"互いに心の中で悪を計るな。偽りの誓いを愛するな。これらはみな、わたしが憎むからだ。――主の御告げ――」","tok":[["互い","たがい"],["に"],["心","こころ"],["の"],["中","なか"],["で"],["悪","あく"],["を"],["計る","はかる"],["な"],["。"],["偽り","いつわり"],["の"],["誓い","ちかい"],["を"],["愛する","あいする"],["な"],["。"],["これ"],["ら"],["は"],["みな"],["、"],["わたし"],["が"],["憎む","にくむ"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":18,"text":"さらに、私に次のような万軍の主のことばがあった。","tok":[["さらに"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":19,"text":"万軍の主はこう仰せられる。「第四の月の断食、第五の月の断食、第七の月の断食、第十の月の断食は、ユダの家にとっては、楽しみとなり、喜びとなり、うれしい例祭となる。だから、真実と平和を愛せよ。」","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["第","だい"],["四","よん"],["の"],["月","つき"],["の"],["断食","だんじき"],["、"],["第","だい"],["五","ご"],["の"],["月","つき"],["の"],["断食","だんじき"],["、"],["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["断食","だんじき"],["、"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["の"],["断食","だんじき"],["は"],["、"],["ユダ"],["の"],["家","いえ"],["にとって"],["は"],["、"],["楽しみ","たのしみ"],["と"],["なり"],["、"],["喜び","よろこび"],["と"],["なり"],["、"],["うれしい"],["例祭","れいさい"],["と"],["なる"],["。"],["だ"],["から"],["、"],["真実","しんじつ"],["と"],["平和","へいわ"],["を"],["愛せよ","あいせよ"],["。"],["」"]]},{"verse":20,"text":"万軍の主はこう仰せられる。「再び、国々の民と多くの町々の住民がやって来る。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["再び","ふたたび"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["と"],["多く","おおく"],["の"],["町々","まち
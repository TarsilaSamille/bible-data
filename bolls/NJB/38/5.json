[{"verse":1,"text":"私が再び目を上げて見ると、なんと、巻き物が飛んでいた。","tok":[["私","わたくし"],["が"],["再び","ふたたび"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["巻き物","まきもの"],["が"],["飛んで","とんで"],["いた"],["。"]]},{"verse":2,"text":"彼は私に言った。「何を見ているのか。」私は答えた。「飛んでいる巻き物を見ています。その長さは二十キュビト、その幅は十キュビトです。」","tok":[["彼","かれ"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["何","なん"],["を"],["見て","みて"],["いる"],["の"],["か"],["。"],["」"],["私","わたくし"],["は"],["答えた","こたえた"],["。"],["「"],["飛んで","とんで"],["いる"],["巻き物","まきもの"],["を"],["見て","みて"],["います"],["。"],["その"],["長さ","ながさ"],["は"],["二十","にじゅう"],["キュビト"],["、"],["その"],["幅","はば"],["は"],["十","じゅう"],["キュビト"],["です"],["。"],["」"]]},{"verse":3,"text":"すると彼は、私に言った。「これは、全地の面に出て行くのろいだ。盗む者はだれでも、これに照らし合わせて取り除かれ、また、偽って誓う者はだれでも、これに照らし合わせて取り除かれる。」","tok":[["する"],["と"],["彼","かれ"],["は"],["、"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["これ"],["は"],["、"],["全地","ぜんち"],["の"],["面","めん"],["に"],["出て","でて"],["行く","いく"],["のろい"],["だ"],["。"],["盗む","ぬすむ"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["これ"],["に"],["照らし合わせて","てらしあわせて"],["取り除かれ","とりのぞかれ"],["、"],["また"],["、"],["偽","にせ"],["って"],["誓う","ちかう"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["これ"],["に"],["照らし合わせて","てらしあわせて"],["取り除かれる","とりのぞかれる"],["。"],["」"]]},{"verse":4,"text":"「わたしが、それを出て行かせる。――万軍の主の御告げ――それは、盗人の家に入り、また、わたしの名を使って偽りの誓いを立てる者の家に入り、その家の真ん中にとどまり、その家を梁と石とともに絶ち滅ぼす。」","tok":[["「"],["わたし"],["が"],["、"],["それ"],["を"],["出て","でて"],["行かせる","いかせる"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["それ"],["は"],["、"],["盗人","ぬすびと"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],["また"],["、"],["わたし"],["の"],["名","な"],["を"],["使って","つかって"],["偽り","いつわり"],["の"],["誓い","ちかい"],["を"],["立てる","たてる"],["者","もの"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],["その"],["家","いえ"],["の"],["真ん中","まんなか"],["に"],["とどまり"],["、"],["その"],["家","いえ"],["を"],["梁","はり"],["と"],["石","いし"],["と"],["とも"],["に"],["絶ち","たち"],["滅ぼす","ほろぼす"],["。"],["」"]]},{"verse":5,"text":"私と話していた御使いが出て来て、私に言った。「目を上げて、この出て行く物が何かを見よ。」","tok":[["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["が"],["出て","でて"],["来て","きて"],["、"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["目","め"],["を"],["上げて","あげて"],["、"],["この"],["出て","でて"],["行く","いく"],["物","もの"],["が"],["何","なん"],["か"],["を"],["見よ","みよ"],["。"],["」"]]},{"verse":6,"text":"私が、「それは何ですか」と尋ねると、彼は言った。「これは、出て行くエパ枡だ。」そして言った。「これは、全地にある彼らの罪だ。」","tok":[["私","わたくし"],["が"],["、"],["「"],["それ"],["は"],["何","なん"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["これ"],["は"],["、"],["出て","でて"],["行く","いく"],["エパ"],["枡","ます"],["だ"],["。"],["」"],["そして"],["言った","いった"],["。"],["「"],["これ"],["は"],["、"],["全地","ぜんち"],["に"],["ある"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["だ"],["。"],["」"]]},{"verse":7,"text":"見よ。鉛のふたが持ち上げられ、エパ枡の中にひとりの女がすわっていた。","tok":[["見","み"],["よ"],["。"],["鉛","なまり"],["の"],["ふた"],["が"],["持ち上げられ","もちあげられ"],["、"],["エパ"],["枡","ます"],["の"],["中","なか"],["に"],["ひとり"],["の"],["女","おんな"],["が"],["すわって"],["いた"],["。"]]},{"verse":8,"text":"彼は、「これは罪悪だ」と言って、その女をエパ枡の中に閉じ込め、その口の上に鉛の重しをかぶせた。","tok":[["彼","かれ"],["は"],["、"],["「"],["これ"],["は"],["罪悪","ざいあく"],["だ"],["」"],["と"],["言って","いって"],["、"],["その"],["女","おんな"],["を"],["エパ"],["枡","ます"],["の"],["中","なか"],["に"],["閉じ込め","とじこめ"],["、"],["その"],["口","くち"],["の"],["上","うえ"],["に"],["鉛","なまり"],["の"],["重し","おもし"],["を"],["かぶせた"],["。"]]},{"verse":9,"text":"それから、私が目を上げて見ると、なんと、ふたりの女が出て来た。その翼は風をはらんでいた。彼女たちには、こうのとりの翼のような翼があり、彼女たちは、あのエパ枡を地と天との間に持ち上げた。","tok":[["それ"],["から"],["、"],["私","わたくし"],["が"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["ふたり"],["の"],["女","おんな"],["が"],["出て","でて"],["来た","きた"],["。"],["その"],["翼","つばさ"],["は"],["風","かぜ"],["を"],["はらんで"],["いた"],["。"],["彼女","かのじょ"],["たち"],["に"],["は"],["、"],["こうのとり"],["の"],["翼","つばさ"],["の"],["よう"],["な"],["翼","つばさ"],["が"],["あり"],["、"],["彼女","かのじょ"],["たち"],["は"],["、"],["あの"],["エパ"],["枡","ます"],["を"],["地","ち"],["と"],["天","てん"],["と"],["の"],["間","あいだ"],["に"],["持ち上げた","もちあげた"],["。"]]},{"verse":10,"text":"そこで私は、私と話していた御使いに尋ねた。「あの者たちは、エパ枡をどこへ持って行くのですか。」","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["に"],["尋ねた","たずねた"],["。"],["「"],["あの"],["者","もの"],["たち"],["は"],["、"],["エパ"],["枡","ます"],["を"],["どこ"],["へ"],["持って","もって"],["行く","いく"],["の"],["です"],["か"],["。"],["」"]]},{"verse":11,"text":"彼は私に言った。「シヌアルの地で、あの女のために神殿を建てる。それが整うと、そこの台の上に安置するためだ。」","tok":[["彼","かれ"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["シヌアル"],["の"],["地","ち"],["で"],["、"],["あの"],["女","おんな"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["建てる","たてる"],["。"],["それ"],["が"],["整う","ととのう"],["と"],["、"],["そこ"],["の"],["台","だい"],["の"],["上","うえ"],["に"],["安置","あんち"],["する"],["ため"],["だ"],["。"],["」"]]}]
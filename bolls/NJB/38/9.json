[{"verse":1,"text":"宣告。／主のことばはハデラクの地にあり、ダマスコは、そのとどまる所。／主の目は人に向けられ、イスラエルの全部族に向けられている。","tok":[["宣告","せんこく"],["。"],["／"],["主","ぬし"],["の"],["ことば"],["は"],["ハデラク"],["の"],["地","ち"],["に"],["あり"],["、"],["ダマスコ"],["は"],["、"],["その"],["とどまる"],["所","ところ"],["。"],["／"],["主","ぬし"],["の"],["目","め"],["は"],["人","ひと"],["に"],["向けられ","むけられ"],["、"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["に"],["向けられて","むけられて"],["いる"],["。"]]},{"verse":2,"text":"これに境を接するハマテにも、また、非常に知恵のあるツロやシドンにも／向けられている。","tok":[["これ"],["に"],["境","さかい"],["を"],["接する","せっする"],["ハマテ"],["に"],["も"],["、"],["また"],["、"],["非常","ひじょう"],["に"],["知恵","ちえ"],["の"],["ある"],["ツロ"],["や"],["シドン"],["に"],["も"],["／"],["向けられて","むけられて"],["いる"],["。"]]},{"verse":3,"text":"ツロは自分のために、とりでを築き、銀をちりのように積み、黄金を道ばたの泥のように積み上げた。","tok":[["ツロ"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["とりで"],["を"],["築き","きずき"],["、"],["銀","ぎん"],["を"],["ちり"],["の"],["よう"],["に"],["積み","つみ"],["、"],["黄金","おうごん"],["を"],["道ばた","みちばた"],["の"],["泥","どろ"],["の"],["よう"],["に"],["積み上げた","つみあげた"],["。"]]},{"verse":4,"text":"見よ。主はツロを占領し、その塁を打ち倒して海に入れる。／ツロは火で焼き尽くされる。","tok":[["見","み"],["よ"],["。"],["主","ぬし"],["は"],["ツロ"],["を"],["占領","せんりょう"],["し"],["、"],["その"],["塁","るい"],["を"],["打ち倒して","うちたおして"],["海","うみ"],["に"],["入れる","いれる"],["。"],["／"],["ツロ"],["は"],["火","ひ"],["で"],["焼き","やき"],["尽くされる","つくされる"],["。"]]},{"verse":5,"text":"アシュケロンは見て恐れ、ガザもひどくおののく。エクロンもそうだ。／その頼みにしていたものが／はずかしめられたのだから。／ガザからは王が消えうせ、アシュケロンには人が住まなくなる。","tok":[["アシュケロン"],["は"],["見て","みて"],["恐れ","おそれ"],["、"],["ガザ"],["も"],["ひどく"],["おののく"],["。"],["エクロン"],["も"],["そう"],["だ"],["。"],["／"],["その"],["頼み","たのみ"],["に"],["して"],["いた"],["もの"],["が"],["／"],["はずかしめられた"],["の"],["だ"],["から"],["。"],["／"],["ガザ"],["から"],["は"],["王","おう"],["が"],["消えうせ","きえうせ"],["、"],["アシュケロン"],["に"],["は"],["人","ひと"],["が"],["住まなく","すまなく"],["なる"],["。"]]},{"verse":6,"text":"アシュドデには混血の民が住むようになる。／わたしはペリシテ人の誇りを絶やし、","tok":[["アシュドデ"],["に"],["は"],["混血","こんけつ"],["の"],["民","たみ"],["が"],["住む","すむ"],["よう"],["に"],["なる"],["。"],["／"],["わたし"],["は"],["ペリシテ"],["人","にん"],["の"],["誇り","ほこり"],["を"],["絶やし","たやし"],["、"]]},{"verse":7,"text":"その口から流血の罪を除き、その歯の間から忌まわしいものを取り除く。／彼も、私たちの神のために残され、ユダの中の一首長のようになる。／エクロンもエブス人のようになる。","tok":[["その"],["口","くち"],["から"],["流血","りゅうけつ"],["の"],["罪","つみ"],["を"],["除き","のぞき"],["、"],["その"],["歯","は"],["の"],["間","あいだ"],["から"],["忌まわしい","いまわしい"],["もの"],["を"],["取り除く","とりのぞく"],["。"],["／"],["彼","かれ"],["も"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["ため"],["に"],["残され","のこされ"],["、"],["ユダ"],["の"],["中","なか"],["の"],["一","いち"],["首長","しゅちょう"],["の"],["よう"],["に"],["なる"],["。"],["／"],["エクロン"],["も"],["エブス人","えぶすにん"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"わたしは、わたしの家のために、行き来する者を見張る衛所に立つ。／それでもう、しいたげる者はそこを通らない。／今わたしがこの目で見ているからだ。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["家","いえ"],["の"],["ため"],["に"],["、"],["行き来","いきき"],["する"],["者","もの"],["を"],["見張る","みはる"],["衛所","えいしょ"],["に"],["立つ","たつ"],["。"],["／"],["それ"],["で"],["もう"],["、"],["しいたげる"],["者","もの"],["は"],["そこ"],["を"],["通らない","とおらない"],["。"],["／"],["今","いま"],["わたし"],["が"],["この"],["目","め"],["で"],["見て","みて"],["いる"],["から"],["だ"],["。"]]},{"verse":9,"text":"シオンの娘よ。大いに喜べ。／エルサレムの娘よ。喜び叫べ。／見よ。あなたの王があなたのところに来られる。／この方は正しい方で、救いを賜り、柔和で、ろばに乗られる。／それも、雌ろばの子の子ろばに。","tok":[["シオン"],["の"],["娘","むすめ"],["よ"],["。"],["大いに","おおいに"],["喜べ","よろこべ"],["。"],["／"],["エルサレム"],["の"],["娘","むすめ"],["よ"],["。"],["喜び叫べ","よろこびさけべ"],["。"],["／"],["見","み"],["よ"],["。"],["あなた"],["の"],["王","おう"],["が"],["あなた"],["の"],["ところ"],["に"],["来られる","こられる"],["。"],["／"],["この"],["方","かた"],["は"],["正しい","ただしい"],["方","ほう"],["で"],["、"],["救い","すくい"],["を"],["賜り","たまわり"],["、"],["柔和","にゅうわ"],["で"],["、"],["ろば"],["に"],["乗られる","のられる"],["。"],["／"],["それ"],["も"],["、"],["雌","めす"],["ろば"],["の"],["子","こ"],["の"],["子","こ"],["ろば"],["に"],["。"]]},{"verse":10,"text":"わたしは戦車をエフライムから、軍馬をエルサレムから絶やす。／戦いの弓も断たれる。／この方は諸国の民に平和を告げ、その支配は海から海へ、大川から地の果てに至る。","tok":[["わたし"],["は"],["戦車","せんしゃ"],["を"],["エフライム"],["から"],["、"],["軍馬","ぐんば"],["を"],["エルサレム"],["から"],["絶やす","たやす"],["。"],["／"],["戦い","たたかい"],["の"],["弓","ゆみ"],["も"],["断たれる","たたれる"],["。"],["／"],["この"],["方","かた"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["平和","へいわ"],["を"],["告げ","つげ"],["、"],["その"],["支配","しはい"],["は"],["海","うみ"],["から"],["海","うみ"],["へ"],["、"],["大川","おおかわ"],["から"],["地","ち"],["の"],["果て","はて"],["に"],["至る","いたる"],["。"]]},{"verse":11,"text":"あなたについても、あなたとの契約の血によって、わたしはあなたの捕らわれ人を、水のない穴から解き放つ。","tok":[["あなた"],["について"],["も"],["、"],["あなた"],["と"],["の"],["契約","けいやく"],["の"],["血","ち"],["によって"],["、"],["わたし"],["は"],["あなた"],["の"],["捕らわれ","とらわれ"],["人","にん"],["を"],["、"],["水","みず"],["の"],["ない"],["穴","あな"],["から"],["解き放つ","ときはなつ"],["。"]]},{"verse":12,"text":"望みを持つ捕らわれ人よ。とりでに帰れ。／わたしは、きょうもまた告げ知らせる。／わたしは二倍のものをあなたに返すと。","tok":[["望み","のぞみ"],["を"],["持つ","もつ"],["捕らわれ","とらわれ"],["人","にん"],["よ"],["。"],["とりで"],["に"],["帰れ","かえれ"],["。"],["／"],["わたし"],["は"],["、"],["きょう"],["も"],["また"],["告げ知らせる","つげしらせる"],["。"],["／"],["わたし"],["は"],["二","に"],["倍","ばい"],["の"],["もの"],["を"],["あなた"],["に"],["返す","かえす"],["と"],["。"]]},{"verse":13,"text":"わたしはユダを曲げてわたしの弓とし、これにエフライムをつがえたのだ。／シオンよ。わたしはあなたの子らを奮い立たせる。／ヤワンはあなたの子らを攻めるが、わたしはあなたを勇士の剣のようにする。","tok":[["わたし"],["は"],["ユダ"],["を"],["曲げて","まげて"],["わたし"],["の"],["弓","ゆみ"],["と"],["し"],["、"],["これ"],["に"],["エフライム"],["を"],["つがえた"],["の"],["だ"],["。"],["／"],["シオン"],["よ"],["。"],["わたし"],["は"],["あなた"],["の"],["子","こ"],["ら"],["を"],["奮い立たせる","ふるいたたせる"],["。"],["／"],["ヤワン"],["は"],["あなた"],["の"],["子","こ"],["ら"],["を"],["攻める","せめる"],["が"],["、"],["わたし"],["は"],["あなた"],["を"],["勇士","ゆうし"],["の"],["剣","けん"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":14,"text":"主は彼らの上に現れ、その矢はいなずまのように放たれる。／神である主は角笛を吹き鳴らし、南の暴風の中を進まれる。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["現れ","あらわれ"],["、"],["その"],["矢","や"],["は"],["いなずま"],["の"],["よう"],["に"],["放たれる","はなたれる"],["。"],["／"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["角笛","つのぶえ"],["を"],["吹き鳴らし","ふきならし"],["、"],["南","みなみ"],["の"],["暴風","ぼうふう"],["の"],["中","なか"],["を"],["進まれる","すすまれる"],["。"]]},{"verse":15,"text":"万軍の主が彼らをかばうので、彼らは石投げを使う者を滅ぼして踏みつけ、彼らの血をぶどう酒のように飲み、鉢のように、祭壇の四隅の角のように、満たされる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["かばう"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["石投げ","いしなげ"],["を"],["使う","つかう"],["者","もの"],["を"],["滅ぼして","ほろぼして"],["踏みつけ","ふみつけ"],["、"],["彼","かれ"],["ら"],["の"],["血","ち"],["を"],["ぶどう酒","ぶどうしゅ"],["の"],["よう"],["に"],["飲み","のみ"],["、"],["鉢","ばち"],["の"],["よう"],["に"],["、"],["祭壇","さいだん"],["の"],["四隅","よすみ"],["の"],["角","かど"],["の"],["よう"],["に"],["、"],["満たされる","みたされる"],["。"]]},{"verse":16,"text":"その日、彼らの神、主は、彼らを／主の民の群れとして救われる。／彼らはその地で、きらめく王冠の宝石となる。","tok":[["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["／"],["主","ぬし"],["の"],["民","たみ"],["の"],["群れ","むれ"],["として"],["救われる","すくわれる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["その"],["地","ち"],["で"],["、"],["きらめく"],["王冠","おうかん"],["の"],["宝石","ほうせき"],["と"],["なる"],["。"]]},{"verse":17,"text":"それは、なんとしあわせなことよ。／それは、なんと麗しいことよ。／穀物は若い男たちを栄えさせ、新しいぶどう酒は若い女たちを栄えさせる。","tok":[["それ"],["は"],["、"],["なん"],["と"],["しあわせ"],["な"],["こと"],["よ"],["。"],["／"],["それ"],["は"],["、"],["なん"],["と"],["麗しい","うるわしい"],["こと"],["よ"],["。"],["／"],["穀物","こくもつ"],["は"],["若い","わかい"],["男","おとこ"],["たち"],["を"],["栄えさせ","さかえさせ"],["、"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["は"],["若い","わかい"],["女","おんな"],["たち"],["を"],["栄えさせる","さかえさせる"],["。"]]}]
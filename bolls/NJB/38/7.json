[{"verse":1,"text":"ダリヨス王の第四年の第九の月、すなわち、キスレウの月の四日に、ゼカリヤに主のことばがあった。","tok":[["ダリヨス"],["王","おう"],["の"],["第","だい"],["四","よん"],["年","ねん"],["の"],["第","だい"],["九","きゅう"],["の"],["月","つき"],["、"],["すなわち"],["、"],["キスレウ"],["の"],["月","つき"],["の"],["四日","よんか"],["に"],["、"],["ゼカリヤ"],["に"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"そのとき、ベテルは、サル・エツェルとレゲム・メレクおよびその従者たちを、主に願うために遣わし、","tok":[["その"],["とき"],["、"],["ベテル"],["は"],["、"],["サル"],["・"],["エツェル"],["と"],["レゲム"],["・"],["メレク"],["および"],["その"],["従者","じゅうしゃ"],["たち"],["を"],["、"],["主に","おもに"],["願う","ねがう"],["ため"],["に"],["遣わし","つかわし"],["、"]]},{"verse":3,"text":"万軍の主の宮に仕える祭司たちと、預言者たちに尋ねさせた。「私が長年やってきたように、第五の月にも、断食をして泣かなければならないでしょうか。」","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["宮","みや"],["に"],["仕える","つかえる"],["祭司","さいし"],["たち"],["と"],["、"],["預言者","よげんしゃ"],["たち"],["に"],["尋ねさせた","たずねさせた"],["。"],["「"],["私","わたくし"],["が"],["長年","ながねん"],["やって"],["きた"],["よう"],["に"],["、"],["第","だい"],["五","ご"],["の"],["月","つき"],["に"],["も"],["、"],["断食","だんじき"],["を"],["して"],["泣かなければ","なかなければ"],["ならないでしょう"],["か"],["。"],["」"]]},{"verse":4,"text":"すると、私に次のような万軍の主のことばがあった。","tok":[["する"],["と"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":5,"text":"「この国のすべての民と祭司たちに向かってこう言え。この七十年の間、あなたがたが、第五の月と第七の月に断食して嘆いたとき、このわたしのために断食したのか。","tok":[["「"],["この"],["国","くに"],["の"],["すべて"],["の"],["民","たみ"],["と"],["祭司","さいし"],["たち"],["に"],["向かって","むかって"],["こう"],["言え","いえ"],["。"],["この"],["七十","ななじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["あなた"],["が"],["た"],["が"],["、"],["第","だい"],["五","ご"],["の"],["月","つき"],["と"],["第","だい"],["七","なな"],["の"],["月","つき"],["に"],["断食","だんじき"],["して"],["嘆いた","なげいた"],["とき"],["、"],["この"],["わたし"],["の"],["ため"],["に"],["断食","だんじき"],["した"],["の"],["か"],["。"]]},{"verse":6,"text":"あなたがたが食べたり飲んだりするとき、食べるのも飲むのも、自分たちのためではなかったか。","tok":[["あなた"],["がた"],["が"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["する"],["とき"],["、"],["食べる","たべる"],["の"],["も"],["飲む","のむ"],["の"],["も"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":7,"text":"エルサレムとその回りの町々に人が住み、平和であったとき、また、ネゲブや低地に人が住んでいたとき、主が先の預言者たちを通して告げられたのは、次のことではなかったか。」","tok":[["エルサレム"],["と"],["その"],["回り","まわり"],["の"],["町々","まちまち"],["に"],["人","ひと"],["が"],["住み","すみ"],["、"],["平和","へいわ"],["で"],["あった"],["とき"],["、"],["また"],["、"],["ネゲブ"],["や"],["低地","ていち"],["に"],["人","ひと"],["が"],["住んで","すんで"],["いた"],["とき"],["、"],["主","ぬし"],["が"],["先","さき"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["告げられた","つげられた"],["の"],["は"],["、"],["次","つぎ"],["の"],["こと"],["で"],["は"],["なかった"],["か"],["。"],["」"]]},{"verse":8,"text":"ついで、ゼカリヤに次のような主のことばがあった。","tok":[["つい"],["で"],["、"],["ゼカリヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":9,"text":"万軍の主はこう仰せられる。「正しいさばきを行い、互いに誠実を尽くし、あわれみ合え。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["正しい","ただしい"],["さばき"],["を"],["行い","おこない"],["、"],["互い","たがい"],["に"],["誠実","せいじつ"],["を"],["尽くし","つくし"],["、"],["あわれみ"],["合え","あえ"],["。"]]},{"verse":10,"text":"やもめ、みなしご、在留異国人、貧しい者をしいたげるな。互いに心の中で悪をたくらむな。」","tok":[["やもめ"],["、"],["みなしご"],["、"],["在留","ざいりゅう"],["異国人","いこくにん"],["、"],["貧しい","まずしい"],["者","もの"],["を"],["しいたげる"],["な"],["。"],["互い","たがい"],["に"],["心","こころ"],["の"],["中","なか"],["で"],["悪","あく"],["を"],["たくらむ"],["な"],["。"],["」"]]},{"verse":11,"text":"それなのに、彼らはこれを聞こうともせず、肩を怒らし、耳をふさいで聞き入れなかった。","tok":[["それ"],["な"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["聞こう","きこう"],["と"],["も"],["せず"],["、"],["肩","かた"],["を"],["怒らし","いからし"],["、"],["耳","みみ"],["を"],["ふさいで"],["聞き入れなかった","ききいれなかった"],["。"]]},{"verse":12,"text":"彼らは心を金剛石のようにして、万軍の主がその御霊により、先の預言者たちを通して送られたおしえとみことばを、聞き入れなかった。そこで、万軍の主から大きな怒りが下った。","tok":[["彼","かれ"],["ら"],["は"],["心","こころ"],["を"],["金剛石","こんごうせき"],["の"],["よう"],["に"],["して"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["その"],["御霊","みたま"],["に"],["より"],["、"],["先","さき"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["送られた","おくられた"],["おしえ"],["と"],["みことば"],["を"],["、"],["聞き入れなかった","ききいれなかった"],["。"],["そこ"],["で"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["から"],["大きな","おおきな"],["怒り","いかり"],["が"],["下った","くだった"],["。"]]},{"verse":13,"text":"「呼ばれたときも、彼らは聞かなかった。そのように、彼らが呼んでも、わたしは聞かない」と万軍の主は仰せられる。","tok":[["「"],["呼ばれた","よばれた"],["とき"],["も"],["、"],["彼","かれ"],["ら"],["は"],["聞かなかった","きかなかった"],["。"],["その"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["が"],["呼んで","よんで"],["も"],["、"],["わたし"],["は"],["聞かない","きかない"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":14,"text":"「わたしは、彼らを知らないすべての国々に彼らを追い散らす。この国は、彼らが去ったあと、荒れすたれて、行き来する者もいなくなる。こうして彼らはこの慕わしい国を荒れすたらせた。」","tok":[["「"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["知らない","しらない"],["すべて"],["の"],["国々","くにぐに"],["に"],["彼","かれ"],["ら"],["を"],["追い散らす","おいちらす"],["。"],["この"],["国","くに"],["は"],["、"],["彼","かれ"],["ら"],["が"],["去った","さった"],["あと"],["、"],["荒れ","あれ"],["すたれて"],["、"],["行き来","いきき"],["する"],["者","もの"],["も"],["いなく"],["なる"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["この"],["慕わしい","したわしい"],["国","くに"],["を"],["荒れ","あれ"],["すたらせた"],["。"],["」"]]}]
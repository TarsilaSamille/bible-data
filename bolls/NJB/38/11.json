[{"verse":1,"text":"レバノンよ。おまえの門をあけよ。／火が、おまえの杉の木を焼き尽くそう。","tok":[["レバノン"],["よ"],["。"],["おまえ"],["の"],["門","もん"],["を"],["あけよ"],["。"],["／"],["火","ひ"],["が"],["、"],["おまえ"],["の"],["杉","すぎ"],["の"],["木","き"],["を"],["焼き","やき"],["尽くそう","つくそう"],["。"]]},{"verse":2,"text":"もみの木よ。泣きわめけ。／杉の木は倒れ、みごとな木々が荒らされたからだ。／バシャンの樫の木よ。泣きわめけ。／深い森が倒れたからだ。","tok":[["もみ"],["の"],["木","き"],["よ"],["。"],["泣きわめけ","なきわめけ"],["。"],["／"],["杉","すぎ"],["の"],["木","き"],["は"],["倒れ","たおれ"],["、"],["みごと"],["な"],["木々","きぎ"],["が"],["荒らされた","あらされた"],["から"],["だ"],["。"],["／"],["バシャン"],["の"],["樫","かし"],["の"],["木","き"],["よ"],["。"],["泣きわめけ","なきわめけ"],["。"],["／"],["深い","ふかい"],["森","もり"],["が"],["倒れた","たおれた"],["から"],["だ"],["。"]]},{"verse":3,"text":"聞け。牧者たちの嘆きを。／彼らのみごとな木々が荒らされたからだ。／聞け。若い獅子のほえる声を。／ヨルダンの茂みが荒らされたからだ。","tok":[["聞け","きけ"],["。"],["牧者","ぼくしゃ"],["たち"],["の"],["嘆き","なげき"],["を"],["。"],["／"],["彼","かれ"],["ら"],["の"],["みごと"],["な"],["木々","きぎ"],["が"],["荒らされた","あらされた"],["から"],["だ"],["。"],["／"],["聞け","きけ"],["。"],["若い","わかい"],["獅子","しし"],["の"],["ほえる"],["声","こえ"],["を"],["。"],["／"],["ヨルダン"],["の"],["茂み","しげみ"],["が"],["荒らされた","あらされた"],["から"],["だ"],["。"]]},{"verse":4,"text":"私の神、主は、こう仰せられる。「ほふるための羊の群れを養え。","tok":[["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["ほふる"],["ため"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["養え","やしなえ"],["。"]]},{"verse":5,"text":"これを買った者が、これをほふっても、罪にならない。これを売る者は、『主はほむべきかな。私も富みますように』と言っている。その牧者たちは、これを惜しまない。","tok":[["これ"],["を"],["買った","かった"],["者","もの"],["が"],["、"],["これ"],["を"],["ほふって"],["も"],["、"],["罪","つみ"],["に"],["ならない"],["。"],["これ"],["を"],["売る","うる"],["者","もの"],["は"],["、"],["『"],["主","ぬし"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["私","わたくし"],["も"],["富みます","とみます"],["よう"],["に"],["』"],["と"],["言って","いって"],["いる"],["。"],["その"],["牧者","ぼくしゃ"],["たち"],["は"],["、"],["これ"],["を"],["惜しまない","おしまない"],["。"]]},{"verse":6,"text":"わたしが、もう、この地の住民を惜しまないからだ。――主の御告げ――見よ。わたしは、人をそれぞれ隣人の手に渡し、王の手に渡す。彼らはこの地を打ち砕くが、わたしは彼らの手からこれを救い出さない。」","tok":[["わたし"],["が"],["、"],["もう"],["、"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["を"],["惜しまない","おしまない"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["人","ひと"],["を"],["それぞれ"],["隣人","りんじん"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["王","おう"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["ら"],["は"],["この"],["地","ち"],["を"],["打ち砕く","うちくだく"],["が"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["これ"],["を"],["救い出さない","すくいださない"],["。"],["」"]]},{"verse":7,"text":"私は羊の商人たちのために、ほふられる羊の群れを飼った。私は二本の杖を取り、一本を「慈愛」と名づけ、他の一本を、「結合」と名づけた。こうして、私は群れを飼った。","tok":[["私","わたくし"],["は"],["羊","ひつじ"],["の"],["商人","しょうにん"],["たち"],["の"],["ため"],["に"],["、"],["ほふられる"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["飼った","かった"],["。"],["私","わたくし"],["は"],["二本","にぽん"],["の"],["杖","つえ"],["を"],["取り","とり"],["、"],["一本","いちぽん"],["を"],["「"],["慈愛","じあい"],["」"],["と"],["名づけ","なづけ"],["、"],["他","た"],["の"],["一本","いちぽん"],["を"],["、"],["「"],["結合","けつごう"],["」"],["と"],["名づけた","なづけた"],["。"],["こう"],["して"],["、"],["私","わたくし"],["は"],["群れ","むれ"],["を"],["飼った","かった"],["。"]]},{"verse":8,"text":"私は一月のうちに三人の牧者を消し去った。私の心は、彼らにがまんできなくなり、彼らの心も、私をいやがった。","tok":[["私","わたくし"],["は"],["一","いち"],["月","がつ"],["の"],["うち"],["に"],["三人","さんにん"],["の"],["牧者","ぼくしゃ"],["を"],["消し去った","けしさった"],["。"],["私","わたくし"],["の"],["心","こころ"],["は"],["、"],["彼","かれ"],["ら"],["に"],["がまん"],["できなく"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["も"],["、"],["私","わたくし"],["を"],["いやがった"],["。"]]},{"verse":9,"text":"私は言った。「私はもう、あなたがたを飼わない。死にたい者は死ね。隠されたい者は隠されよ。残りの者は、互いに相手の肉を食べるがよい。」","tok":[["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["もう"],["、"],["あなた"],["がた"],["を"],["飼わない","かわない"],["。"],["死にたい","しにたい"],["者","もの"],["は"],["死ね","しね"],["。"],["隠されたい","かくされたい"],["者","もの"],["は"],["隠され","かくされ"],["よ"],["。"],["残り","のこり"],["の"],["者","もの"],["は"],["、"],["互い","たがい"],["に"],["相手","あいて"],["の"],["肉","にく"],["を"],["食べる","たべる"],["が"],["よい"],["。"],["」"]]},{"verse":10,"text":"私は、私の杖、慈愛の杖を取り上げ、それを折った。私がすべての民と結んだ私の契約を破るためである。","tok":[["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["杖","つえ"],["、"],["慈愛","じあい"],["の"],["杖","つえ"],["を"],["取り上げ","とりあげ"],["、"],["それ"],["を"],["折った","おった"],["。"],["私","わたくし"],["が"],["すべて"],["の"],["民","たみ"],["と"],["結んだ","むすんだ"],["私","わたくし"],["の"],["契約","けいやく"],["を"],["破る","やぶる"],["ため"],["で"],["ある"],["。"]]},{"verse":11,"text":"その日、それは破られた。そのとき、私を見守っていた羊の商人たちは、それが主のことばであったことを知った。","tok":[["その"],["日","ひ"],["、"],["それ"],["は"],["破られた","やぶられた"],["。"],["その"],["とき"],["、"],["私","わたくし"],["を"],["見守って","みまもって"],["いた"],["羊","ひつじ"],["の"],["商人","しょうにん"],["たち"],["は"],["、"],["それ"],["が"],["主","ぬし"],["の"],["ことば"],["で"],["あった"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":12,"text":"私は彼らに言った。「あなたがたがよいと思うなら、私に賃金を払いなさい。もし、そうでないなら、やめなさい。」すると彼らは、私の賃金として、銀三十シェケルを量った。","tok":[["私","わたくし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["が"],["よい"],["と"],["思うなら","おもうなら"],["、"],["私","わたくし"],["に"],["賃金","ちんぎん"],["を"],["払い","はらい"],["なさい"],["。"],["もし"],["、"],["そう"],["で"],["ないなら"],["、"],["やめ"],["なさい"],["。"],["」"],["する"],["と"],["彼","かれ"],["ら"],["は"],["、"],["私","わたくし"],["の"],["賃金","ちんぎん"],["として"],["、"],["銀","ぎん"],["三十","さんじゅう"],["シェケル"],["を"],["量った","はかった"],["。"]]},{"verse":13,"text":"主は私に仰せられた。「彼らによってわたしが値積もりされた尊い価を、陶器師に投げ与えよ。」そこで、私は銀三十を取り、それを主の宮の陶器師に投げ与えた。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["彼","かれ"],["ら"],["によって"],["わたし"],["が"],["値","あたい"],["積もり","つもり"],["された"],["尊い","とうとい"],["価","あたい"],["を"],["、"],["陶器師","とうきし"],["に"],["投げ与えよ","なげあたえよ"],["。"],["」"],["そこ"],["で"],["、"],["私","わたくし"],["は"],["銀","ぎん"],["三十","さんじゅう"],["を"],["取り","とり"],["、"],["それ"],["を"],["主","ぬし"],["の"],["宮","みや"],["の"],["陶器師","とうきし"],["に"],["投げ与えた","なげあたえた"],["。"]]},{"verse":14,"text":"そして私は、結合という私のもう一本の杖を折った。これはユダとイスラエルとの間の兄弟関係を破るためであった。","tok":[["そして"],["私","わたくし"],["は"],["、"],["結合","けつごう"],["と"],["いう"],["私","わたくし"],["の"],["もう"],["一本","いちぽん"],["の"],["杖","つえ"],["を"],["折った","おった"],["。"],["これ"],["は"],["ユダ"],["と"],["イスラエル"],["と"],["の"],["間","あいだ"],["の"],["兄弟","きょうだい"],["関係","かんけい"],["を"],["破る","やぶる"],["ため"],["で"],["あった"],["。"]]},{"verse":15,"text":"主は私に仰せられた。「あなたは、もう一度、愚かな牧者の道具を取れ。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["もう"],["一度","いちど"],["、"],["愚か","おろか"],["な"],["牧者","ぼくしゃ"],["の"],["道具","どうぐ"],["を"],["取れ","とれ"],["。"]]},{"verse":16,"text":"見よ。わたしはひとりの牧者をこの地に起こすから。彼は迷い出たものを尋ねず、散らされたものを捜さず、傷ついたものをいやさず、飢えているものに食べ物を与えない。かえって肥えた獣の肉を食らい、そのひづめを裂く。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["ひとり"],["の"],["牧者","ぼくしゃ"],["を"],["この"],["地","ち"],["に"],["起こす","おこす"],["から"],["。"],["彼","かれ"],["は"],["迷い出た","まよいでた"],["もの"],["を"],["尋ねず","たずねず"],["、"],["散らされた","ちらされた"],["もの"],["を"],["捜さず","さがさず"],["、"],["傷ついた","きずついた"],["もの"],["を"],["いやさず"],["、"],["飢えて","うえて"],["いる"],["もの"],["に"],["食べ物","たべもの"],["を"],["与えない","あたえない"],["。"],["かえって"],["肥えた","こえた"],["獣","けもの"],["の"],["肉","にく"],["を"],["食らい","くらい"],["、"],["その"],["ひづめ"],["を"],["裂く","さく"],["。"]]},{"verse":17,"text":"ああ。／羊の群れを見捨てる、能なしの牧者。／剣がその腕とその右の目を打ち、その腕はなえ、その右の目は視力が衰える。」","tok":[["ああ"],["。"],["／"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["見捨てる","みすてる"],["、"],["能","のう"],["なし"],["の"],["牧者","ぼくしゃ"],["。"],["／"],["剣","けん"],["が"],["その"],["腕","うで"],["と"],["その"],["右","みぎ"],["の"],["目","め"],["を"],["打ち","うち"],["、"],["その"],["腕","うで"],["は"],["なえ"],["、"],["その"],["右","みぎ"],["の"],["目","め"],["は"],["視力","しりょく"],["が"],["衰える","おとろえる"],["。"],["」"]]}]
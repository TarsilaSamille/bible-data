[{"verse":1,"text":"私が目を上げて見ると、なんと、ひとりの人がいて、その手に一本の測り綱があった。","tok":[["私","わたくし"],["が"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["いて"],["、"],["その"],["手","て"],["に"],["一本","いちぽん"],["の"],["測り","はかり"],["綱","つな"],["が"],["あった"],["。"]]},{"verse":2,"text":"私がその人に、「あなたはどこへ行かれるのですか」と尋ねると、彼は答えた。「エルサレムを測りに行く。その幅と長さがどれほどあるかを見るために。」","tok":[["私","わたくし"],["が"],["その"],["人","ひと"],["に"],["、"],["「"],["あなた"],["は"],["どこ"],["へ"],["行かれる","いかれる"],["の"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["エルサレム"],["を"],["測り","はかり"],["に"],["行く","いく"],["。"],["その"],["幅","はば"],["と"],["長さ","ながさ"],["が"],["どれ"],["ほど"],["ある"],["か"],["を"],["見る","みる"],["ため"],["に"],["。"],["」"]]},{"verse":3,"text":"私と話していた御使いが出て行くと、すぐ、もうひとりの御使いが、彼に会うために出て行った。","tok":[["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["すぐ"],["、"],["もう"],["ひとり"],["の"],["御使い","おつかい"],["が"],["、"],["彼","かれ"],["に"],["会う","あう"],["ため"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":4,"text":"そして彼に言った。「走って行って、あの若者にこう告げなさい。『エルサレムは、その中の多くの人と家畜のため、城壁のない町とされよう。","tok":[["そして"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["走って","はしって"],["行って","いって"],["、"],["あの"],["若者","わかもの"],["に"],["こう"],["告げ","つげ"],["なさい"],["。"],["『"],["エルサレム"],["は"],["、"],["その"],["中","なか"],["の"],["多く","おおく"],["の"],["人","ひと"],["と"],["家畜","かちく"],["の"],["ため"],["、"],["城壁","じょうへき"],["の"],["ない"],["町","まち"],["と"],["されよう"],["。"]]},{"verse":5,"text":"しかし、わたしが、それを取り巻く火の城壁となる。――主の御告げ――わたしがその中の栄光となる。』","tok":[["しかし"],["、"],["わたし"],["が"],["、"],["それ"],["を"],["取り巻く","とりまく"],["火","ひ"],["の"],["城壁","じょうへき"],["と"],["なる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["が"],["その"],["中","なか"],["の"],["栄光","えいこう"],["と"],["なる"],["。"],["』"]]},{"verse":6,"text":"さあ、さあ。北の国から逃げよ。――主の御告げ――天の四方の風のように、わたしがあなたがたを散らしたからだ。――主の御告げ――","tok":[["さあ"],["、"],["さあ"],["。"],["北","きた"],["の"],["国","くに"],["から"],["逃げ","にげ"],["よ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["天","てん"],["の"],["四方","しほう"],["の"],["風","かぜ"],["の"],["よう"],["に"],["、"],["わたし"],["が"],["あなた"],["がた"],["を"],["散らした","ちらした"],["から"],["だ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":7,"text":"さあ、シオンにのがれよ。バビロンの娘とともに住む者よ。","tok":[["さあ"],["、"],["シオン"],["に"],["のがれ"],["よ"],["。"],["バビロン"],["の"],["娘","むすめ"],["と"],["とも"],["に"],["住む","すむ"],["者","もの"],["よ"],["。"]]},{"verse":8,"text":"主の栄光が、あなたがたを略奪した国々に私を遣わして後、万軍の主はこう仰せられる。『あなたがたに触れる者は、わたしのひとみに触れる者だ。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["が"],["、"],["あなた"],["がた"],["を"],["略奪","りゃくだつ"],["した"],["国々","くにぐに"],["に"],["私","わたくし"],["を"],["遣わして","つかわして"],["後","あと"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["がた"],["に"],["触れる","ふれる"],["者","もの"],["は"],["、"],["わたし"],["の"],["ひとみ"],["に"],["触れる","ふれる"],["者","もの"],["だ"],["。"]]},{"verse":9,"text":"見よ。わたしは、こぶしを彼らに振り上げる。彼らは自分に仕えた者たちのとりことなる』と。このとき、あなたがたは、万軍の主が私を遣わされたことを知ろう。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["こぶし"],["を"],["彼","かれ"],["ら"],["に"],["振り上げる","ふりあげる"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["に"],["仕えた","つかえた"],["者","もの"],["たち"],["の"],["とりこ"],["と"],["なる"],["』"],["と"],["。"],["この"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["私","わたくし"],["を"],["遣わされた","つかわされた"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":10,"text":"シオンの娘よ。喜び歌え。楽しめ。見よ。わたしは来て、あなたのただ中に住む。――主の御告げ――","tok":[["シオン"],["の"],["娘","むすめ"],["よ"],["。"],["喜び歌え","よろこびうたえ"],["。"],["楽しめ","たのしめ"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["来て","きて"],["、"],["あなた"],["の"],["ただ中","ただなか"],["に"],["住む","すむ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":11,"text":"その日、多くの国々が主につき、彼らはわたしの民となり、わたしはあなたのただ中に住む。あなたは、万軍の主が私をあなたに遣わされたことを知ろう。","tok":[["その"],["日","ひ"],["、"],["多く","おおく"],["の"],["国々","くにぐに"],["が"],["主に","おもに"],["つき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["あなた"],["の"],["ただ中","ただなか"],["に"],["住む","すむ"],["。"],["あなた"],["は"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["私","わたくし"],["を"],["あなた"],["に"],["遣わされた","つかわされた"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":12,"text":"主は、聖なる地で、ユダに割り当て地を分け与え、エルサレムを再び選ばれる。」","tok":[["主","ぬし"],["は"],["、"],["聖","せい"],["なる"],["地","ち"],["で"],["、"],["ユダ"],["に"],["割り当て","わりあて"],["地","ち"],["を"],["分け与え","わけあたえ"],["、"],["エルサレム"],["を"],["再び","ふたたび"],["選ばれる","えらばれる"],["。"],["」"]]},{"verse":13,"text":"すべての肉なる者よ。主の前で静まれ。主が立ち上がって、その聖なる住まいから来られるからだ。","tok":[["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["よ"],["。"],["主","ぬし"],["の"],["前","まえ"],["で"],["静まれ","しずまれ"],["。"],["主","ぬし"],["が"],["立ち上がって","たちあがって"],["、"],["その"],["聖","せい"],["なる"],["住まい","すまい"],["から"],["来られる","こられる"],["から"],["だ"],["。"]]}]
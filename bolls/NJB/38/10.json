[{"verse":1,"text":"後の雨の時に、主に雨を求めよ。／主はいなびかりを造り、大雨を人々に与え、野の草をすべての人に下さる。","tok":[["後","あと"],["の"],["雨","あめ"],["の"],["時","とき"],["に"],["、"],["主に","おもに"],["雨","あめ"],["を"],["求めよ","もとめよ"],["。"],["／"],["主","ぬし"],["はい"],["なびかり"],["を"],["造り","つくり"],["、"],["大雨","おおあめ"],["を"],["人々","ひとびと"],["に"],["与え","あたえ"],["、"],["野","の"],["の"],["草","くさ"],["を"],["すべて"],["の"],["人","ひと"],["に"],["下さる","くださる"],["。"]]},{"verse":2,"text":"テラフィムはつまらないことをしゃべり、占い師は偽りを見、夢見る者はむなしいことを語り、むなしい慰めを与えた。／それゆえ、人々は羊のようにさまよい、羊飼いがいないので悩む。","tok":[["テラフィム"],["は"],["つまらない"],["こと"],["を"],["しゃべり"],["、"],["占い師","うらないし"],["は"],["偽り","いつわり"],["を"],["見","み"],["、"],["夢","ゆめ"],["見る","みる"],["者","もの"],["は"],["むなしい"],["こと"],["を"],["語り","かたり"],["、"],["むなしい"],["慰め","なぐさめ"],["を"],["与えた","あたえた"],["。"],["／"],["それ"],["ゆえ"],["、"],["人々","ひとびと"],["は"],["羊","ひつじ"],["の"],["よう"],["に"],["さまよい"],["、"],["羊飼い","ひつじかい"],["が"],["いない"],["ので"],["悩む","なやむ"],["。"]]},{"verse":3,"text":"わたしの怒りは羊飼いたちに向かって燃える。／わたしは雄やぎを罰しよう。／万軍の主はご自分の群れであるユダの家を訪れ、彼らを戦場のすばらしい馬のようにされる。","tok":[["わたし"],["の"],["怒り","いかり"],["は"],["羊飼い","ひつじかい"],["たち"],["に"],["向かって","むかって"],["燃える","もえる"],["。"],["／"],["わたし"],["は"],["雄","おす"],["やぎ"],["を"],["罰しよう","ばっしよう"],["。"],["／"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["ご自分","ごじぶん"],["の"],["群れ","むれ"],["で"],["ある"],["ユダ"],["の"],["家","いえ"],["を"],["訪れ","おとずれ"],["、"],["彼","かれ"],["ら"],["を"],["戦場","せんじょう"],["の"],["すばらしい"],["馬","うま"],["の"],["よう"],["に"],["される"],["。"]]},{"verse":4,"text":"この群れからかしら石が、この群れから鉄のくいが、この群れからいくさ弓が、この群れからすべての指揮者が、ともどもに出て来る。","tok":[["この"],["群れ","むれ"],["から"],["かしら"],["石","いし"],["が"],["、"],["この"],["群れ","むれ"],["から"],["鉄","てつ"],["の"],["くい"],["が"],["、"],["この"],["群れ","むれ"],["から"],["いくさ"],["弓","ゆみ"],["が"],["、"],["この"],["群れ","むれ"],["から"],["すべて"],["の"],["指揮者","しきしゃ"],["が"],["、"],["ともども"],["に"],["出て","でて"],["来る","くる"],["。"]]},{"verse":5,"text":"道ばたの泥を踏みつける勇士のようになって、彼らは戦場で戦う。／主が彼らとともにおられるからだ。／馬に乗る者どもは恥を見る。","tok":[["道ばた","みちばた"],["の"],["泥","どろ"],["を"],["踏みつける","ふみつける"],["勇士","ゆうし"],["の"],["よう"],["に"],["なって"],["、"],["彼","かれ"],["ら"],["は"],["戦場","せんじょう"],["で"],["戦う","たたかう"],["。"],["／"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["おられる"],["から"],["だ"],["。"],["／"],["馬","うま"],["に"],["乗る","のる"],["者","もの"],["ども"],["は"],["恥","はじ"],["を"],["見る","みる"],["。"]]},{"verse":6,"text":"わたしはユダの家を強め、ヨセフの家を救う。／わたしは彼らを連れ戻す。／わたしが彼らをあわれむからだ。／彼らは、わたしに捨てられなかった者のようになる。／わたしが、彼らの神、主であり、彼らに答えるからだ。","tok":[["わたし"],["は"],["ユダ"],["の"],["家","いえ"],["を"],["強め","つよめ"],["、"],["ヨセフ"],["の"],["家","いえ"],["を"],["救う","すくう"],["。"],["／"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["連れ戻す","つれもどす"],["。"],["／"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["あわれむ"],["から"],["だ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["に"],["捨てられなかった","すてられなかった"],["者","もの"],["の"],["よう"],["に"],["なる"],["。"],["／"],["わたし"],["が"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["に"],["答える","こたえる"],["から"],["だ"],["。"]]},{"verse":7,"text":"エフライムは勇士のようになり、その心はぶどう酒に酔ったように喜ぶ。／彼らの子らは見て喜び、その心は主にあって大いに楽しむ。","tok":[["エフライム"],["は"],["勇士","ゆうし"],["の"],["よう"],["に"],["なり"],["、"],["その"],["心","こころ"],["は"],["ぶどう酒","ぶどうしゅ"],["に"],["酔った","よった"],["よう"],["に"],["喜ぶ","よろこぶ"],["。"],["／"],["彼","かれ"],["ら"],["の"],["子","こ"],["ら"],["は"],["見て","みて"],["喜び","よろこび"],["、"],["その"],["心","こころ"],["は"],["主に","おもに"],["あって"],["大いに","おおいに"],["楽しむ","たのしむ"],["。"]]},{"verse":8,"text":"わたしは彼らに合図して、彼らを集める。／わたしが彼らを贖ったからだ。／彼らは以前のように数がふえる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["合図","あいず"],["して"],["、"],["彼","かれ"],["ら"],["を"],["集める","あつめる"],["。"],["／"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["贖った","あがなった"],["から"],["だ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["以前","いぜん"],["の"],["よう"],["に"],["数","かず"],["が"],["ふえる"],["。"]]},{"verse":9,"text":"わたしは彼らを国々の民の間にまき散らすが、彼らは遠くの国々でわたしを思い出し、その子らとともに生きながらえて帰って来る。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["まき散らす","まきちらす"],["が"],["、"],["彼","かれ"],["ら"],["は"],["遠く","とおく"],["の"],["国々","くにぐに"],["で"],["わたし"],["を"],["思い出し","おもいだし"],["、"],["その"],["子","こ"],["ら"],["と"],["とも"],["に"],["生きながらえて","いきながらえて"],["帰って","かえって"],["来る","くる"],["。"]]},{"verse":10,"text":"わたしは彼らをエジプトの地から連れ帰り、アッシリヤから彼らを寄せ集める。／わたしはギルアデの地とレバノンへ／彼らを連れて行くが、そこも彼らには足りなくなる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ帰り","つれかえり"],["、"],["アッシリヤ"],["から"],["彼","かれ"],["ら"],["を"],["寄せ集める","よせあつめる"],["。"],["／"],["わたし"],["は"],["ギルアデ"],["の"],["地","ち"],["と"],["レバノン"],["へ"],["／"],["彼","かれ"],["ら"],["を"],["連れて","つれて"],["行く","いく"],["が"],["、"],["そこ"],["も"],["彼","かれ"],["ら"],["に"],["は"],["足りなく","たりなく"],["なる"],["。"]]},{"verse":11,"text":"彼らは苦難の海を渡り、海では波を打つ。／彼らはナイル川のすべての淵をからす。／アッシリヤの誇りは低くされ、エジプトの杖は離れる。","tok":[["彼","かれ"],["ら"],["は"],["苦難","くなん"],["の"],["海","うみ"],["を"],["渡り","わたり"],["、"],["海","うみ"],["で"],["は"],["波","なみ"],["を"],["打つ","うつ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["ナイル"],["川","かわ"],["の"],["すべて"],["の"],["淵","ふち"],["を"],["からす"],["。"],["／"],["アッシリヤ"],["の"],["誇り","ほこり"],["は"],["低く","ひくく"],["され"],["、"],["エジプト"],["の"],["杖","つえ"],["は"],["離れる","はなれる"],["。"]]},{"verse":12,"text":"彼らの力は主にあり、彼らは主の名によって歩き回る。／――主の御告げ――","tok":[["彼","かれ"],["ら"],["の"],["力","ちから"],["は"],["主に","おもに"],["あり"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["名","な"],["によって"],["歩き回る","あるきまわる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]}]
[{"verse":1,"text":"ダリヨスの第二年の第八の月に、イドの子ベレクヤの子、預言者ゼカリヤに、次のような主のことばがあった。","tok":[["ダリヨス"],["の"],["第","だい"],["二","に"],["年","ねん"],["の"],["第","だい"],["八","はち"],["の"],["月","つき"],["に"],["、"],["イド"],["の"],["子","こ"],["ベレクヤ"],["の"],["子","こ"],["、"],["預言者","よげんしゃ"],["ゼカリヤ"],["に"],["、"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"主はあなたがたの先祖たちを激しく怒られた。","tok":[["主","ぬし"],["は"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["を"],["激しく","はげしく"],["怒られた","おこられた"],["。"]]},{"verse":3,"text":"あなたは、彼らに言え。万軍の主はこう仰せられる。わたしに帰れ。――万軍の主の御告げ――そうすれば、わたしもあなたがたに帰る、と万軍の主は仰せられる。","tok":[["あなた"],["は"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["に"],["帰れ","かえれ"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["そう"],["すれば"],["、"],["わたし"],["も"],["あなた"],["がた"],["に"],["帰る","かえる"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":4,"text":"あなたがたの先祖たちのようであってはならない。先の預言者たちが彼らに叫んで、「万軍の主はこう仰せられる。あなたがたの悪の道から立ち返り、あなたがたの悪いわざを悔い改めよ」と言ったのに、彼らはわたしに聞き従わず、わたしに耳を傾けもしなかった。――主の御告げ――","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["の"],["よう"],["で"],["あって"],["は"],["ならない"],["。"],["先","さき"],["の"],["預言者","よげんしゃ"],["たち"],["が"],["彼","かれ"],["ら"],["に"],["叫んで","さけんで"],["、"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["の"],["悪","あく"],["の"],["道","みち"],["から"],["立ち返り","たちかえり"],["、"],["あなた"],["がた"],["の"],["悪い","わるい"],["わざ"],["を"],["悔い改めよ","くいあらためよ"],["」"],["と"],["言った","いった"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["聞き従わず","ききしたがわず"],["、"],["わたし"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["も"],["しなかった"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":5,"text":"あなたがたの先祖たちは今、どこにいるのか。預言者たちは永遠に生きているだろうか。","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["は"],["今","いま"],["、"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["預言者","よげんしゃ"],["たち"],["は"],["永遠","えいえん"],["に"],["生きて","いきて"],["いるだろう"],["か"],["。"]]},{"verse":6,"text":"しかし、わたしのしもべ、預言者たちにわたしが命じた、わたしのことばとおきてとは、あなたがたの先祖たちに追い迫ったではないか。そこで彼らは立ち返って言った。「万軍の主は、私たちの行いとわざに応じて、私たちにしようと考えられたとおりを、私たちにされた」と。","tok":[["しかし"],["、"],["わたし"],["の"],["しもべ"],["、"],["預言者","よげんしゃ"],["たち"],["に"],["わたし"],["が"],["命じた","めいじた"],["、"],["わたし"],["の"],["ことば"],["と"],["おきて"],["と"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["に"],["追い迫ったで","おいせまったで"],["は"],["ない"],["か"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["立ち返って","たちかえって"],["言った","いった"],["。"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["私たち","わたしたち"],["の"],["行い","おこない"],["と"],["わざ"],["に"],["応じて","おうじて"],["、"],["私たち","わたしたち"],["に"],["しよう"],["と"],["考えられた","かんがえられた"],["とおり"],["を"],["、"],["私たち","わたしたち"],["に"],["された"],["」"],["と"],["。"]]},{"verse":7,"text":"ダリヨスの第二年のシェバテの月である第十一の月の二十四日に、イドの子ベレクヤの子、預言者ゼカリヤに、次のような主のことばがあった。","tok":[["ダリヨス"],["の"],["第","だい"],["二","に"],["年","ねん"],["の"],["シェバテ"],["の"],["月","つき"],["で"],["ある"],["第","だい"],["十一","じゅういち"],["の"],["月","つき"],["の"],["二十四日","にじゅうよんか"],["に"],["、"],["イド"],["の"],["子","こ"],["ベレクヤ"],["の"],["子","こ"],["、"],["預言者","よげんしゃ"],["ゼカリヤ"],["に"],["、"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":8,"text":"夜、私が見ると、なんと、ひとりの人が赤い馬に乗っていた。その人は谷底にあるミルトスの木の間に立っていた。彼のうしろに、赤や、栗毛や、白い馬がいた。","tok":[["夜","よる"],["、"],["私","わたくし"],["が"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["赤い","あかい"],["馬","うま"],["に"],["乗って","のって"],["いた"],["。"],["その"],["人","ひと"],["は"],["谷底","たにそこ"],["に"],["ある"],["ミルトス"],["の"],["木の間","このま"],["に"],["立って","たって"],["いた"],["。"],["彼","かれ"],["の"],["うしろ"],["に"],["、"],["赤","あか"],["や"],["、"],["栗毛","くりげ"],["や"],["、"],["白い","しろい"],["馬","うま"],["が"],["いた"],["。"]]},{"verse":9,"text":"私が、「主よ。これらは何ですか」と尋ねると、私と話していた御使いが、「これらが何か、あなたに示そう」と私に言った。","tok":[["私","わたくし"],["が"],["、"],["「"],["主","ぬし"],["よ"],["。"],["これ"],["ら"],["は"],["何","なん"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["が"],["、"],["「"],["これ"],["ら"],["が"],["何","なん"],["か"],["、"],["あなた"],["に"],["示そう","しめそう"],["」"],["と"],["私","わたくし"],["に"],["言った","いった"],["。"]]},{"verse":10,"text":"ミルトスの木の間に立っていた人が答えて言った。「これらは、地を行き巡るために主が遣わされたものだ。」","tok":[["ミルトス"],["の"],["木の間","このま"],["に"],["立って","たって"],["いた"],["人","ひと"],["が"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["これ"],["ら"],["は"],["、"],["地","ち"],["を"],["行き","いき"],["巡る","めぐる"],["ため"],["に"],["主","ぬし"],["が"],["遣わされた","つかわされた"],["もの"],["だ"],["。"],["」"]]},{"verse":11,"text":"すると、これらは、ミルトスの木の間に立っている主の使いに答えて言った。「私たちは地を行き巡りましたが、まさに、全地は安らかで、穏やかでした。」","tok":[["する"],["と"],["、"],["これ"],["ら"],["は"],["、"],["ミルトス"],["の"],["木の間","このま"],["に"],["立って","たって"],["いる"],["主","ぬし"],["の"],["使い","つかい"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["地","ち"],["を"],["行き","いき"],["巡りました","めぐりました"],["が"],["、"],["まさに"],["、"],["全地","ぜんち"],["は"],["安らか","やすらか"],["で"],["、"],["穏やか","おだやか"],["でした"],["。"],["」"]]},{"verse":12,"text":"主の使いは答えて言った。「万軍の主よ。いつまで、あなたはエルサレムとユダの町々に、あわれみを施されないのですか。あなたがのろって、七十年になります。」","tok":[["主","ぬし"],["の"],["使い","つかい"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["。"],["いつ"],["まで"],["、"],["あなた"],["は"],["エルサレム"],["と"],["ユダ"],["の"],["町々","まちまち"],["に"],["、"],["あわれみ"],["を"],["施されない","ほどこされない"],["の"],["です"],["か"],["。"],["あなた"],["が"],["のろって"],["、"],["七十","ななじゅう"],["年","ねん"],["に"],["なります"],["。"],["」"]]},{"verse":13,"text":"すると主は、私と話していた御使いに、良いことば、慰めのことばで答えられた。","tok":[["する"],["と"],["主","ぬし"],["は"],["、"],["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["に"],["、"],["良い","よい"],["ことば"],["、"],["慰め","なぐさめ"],["の"],["ことば"],["で"],["答えられた","こたえられた"],["。"]]},{"verse":14,"text":"私と話していた御使いは私に言った。「叫んで言え。万軍の主はこう仰せられる。『わたしは、エルサレムとシオンを、ねたむほど激しく愛した。","tok":[["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["叫んで","さけんで"],["言え","いえ"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["は"],["、"],["エルサレム"],["と"],["シオン"],["を"],["、"],["ねたむ"],["ほど"],["激しく","はげしく"],["愛した","あいした"],["。"]]},{"verse":15,"text":"しかし、安逸をむさぼっている諸国の民に対しては大いに怒る。わたしが少ししか怒らないでいると、彼らはほしいままに悪事を行った。』","tok":[["しかし"],["、"],["安逸","あんいつ"],["を"],["むさぼって"],["いる"],["諸国","しょこく"],["の"],["民","たみ"],["に対して","にたいして"],["は"],["大いに","おおいに"],["怒る","おこる"],["。"],["わたし"],["が"],["少し","すこし"],["しか"],["怒らないで","おこらないで"],["いる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["ほしいまま"],["に"],["悪事","あくじ"],["を"],["行った","おこなった"],["。"],["』"]]},{"verse":16,"text":"それゆえ、主はこう仰せられる。『わたしは、あわれみをもってエルサレムに帰る。そこにわたしの宮が建て直される。――万軍の主の御告げ――測りなわはエルサレムの上に張られる。』","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["は"],["、"],["あわれみ"],["を"],["もって"],["エルサレム"],["に"],["帰る","かえる"],["。"],["そこ"],["に"],["わたし"],["の"],["宮","みや"],["が"],["建て直される","たてなおされる"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["測り","はかり"],["なわ"],["は"],["エルサレム"],["の"],["上","うえ"],["に"],["張られる","はられる"],["。"],["』"]]},{"verse":17,"text":"もう一度叫んで言え。万軍の主はこう仰せられる。『わたしの町々には、再び良いものが散り乱れる。主は、再びシオンを慰め、エルサレムを再び選ぶ。』」","tok":[["もう"],["一度","いちど"],["叫んで","さけんで"],["言え","いえ"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["の"],["町々","まちまち"],["に"],["は"],["、"],["再び","ふたたび"],["良い","よい"],["もの"],["が"],["散り乱れる","ちりみだれる"],["。"],["主","ぬし"],["は"],["、"],["再び","ふたたび"],["シオン"],["を"],["慰め","なぐさめ"],["、"],["エルサレム"],["を"],["再び","ふたたび"],["選ぶ","えらぶ"],["。"],["』"],["」"]]},{"verse":18,"text":"私が目を上げて見ると、なんと、四つの角があった。","tok":[["私","わたくし"],["が"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["四","よん"],["つ"],["の"],["角","かど"],["が"],["あった"],["。"]]},{"verse":19,"text":"私が、私と話していた御使いに、「これらは何ですか」と尋ねると、彼は私に言った。「これらは、ユダとイスラエルとエルサレムとを散らした角だ。」","tok":[["私","わたくし"],["が"],["、"],["私","わたくし"],["と"],["話して","はなして"],["いた"],["御使い","おつかい"],["に"],["、"],["「"],["これ"],["ら"],["は"],["何","なん"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["彼","かれ"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["これ"],["ら"],["は"],["、"],["ユダ"],["と"],["イスラエル"],["と"],["エルサレム"],["と"],["を"],["散らした","ちらした"],["角","かど"],["だ"],["。"],["」"]]},{"verse":20,"text":"そのとき、主は四人の職人を私に見せてくださった。","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["四人","よんにん"],["の"],["職人","しょくにん"],["を"],["私","わたくし"],["に"],["見せて","みせて"],["くださった"],["。"]]},{"verse":21,"text":"私が、「この者たちは、何をしに来たのですか」と尋ねると、主はこう仰せられた。「これらはユダを散らして、だれにも頭をもたげさせなかった角だ。この者たちは、これらの角を恐れさせ、また、ユダの地を散らそうと角をもたげる国々の角を打ち滅ぼすためにやって来たのだ。」","tok":[["私","わたくし"],["が"],["、"],["「"],["この"],["者","もの"],["たち"],["は"],["、"],["何","なん"],["を"],["し"],["に"],["来た","きた"],["の"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["主","ぬし"],["は"],["こう"],["仰せられた","おおせられた"],["。"],["「"],["これ"],["ら"],["は"],["ユダ"],["を"],["散らして","ちらして"],["、"],["だれ"],["に"],["も"],["頭","あたま"],["を"],["もたげさせなかった"],["角","かど"],["だ"],["。"],["この"],["者","もの"],["たち"],["は"],["、"],["これ"],["ら"],["の"],["角","かど"],["を"],["恐れさせ","おそれさせ"],["、"],["また"],["、"],["ユダ"],["の"],["地","ち"],["を"],["散らそう","ちらそう"],["と"],["角","かど"],["を"],["もたげる"],["国々","くにぐに"],["の"],["角","かど"],["を"],["打ち滅ぼす","うちほろぼす"],["ため"],["に"],["やって"],["来た","きた"],["の"],["だ"],["。"],["」"]]}]
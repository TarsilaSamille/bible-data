[{"verse":1,"text":"さて、週の初めの日に、マグダラのマリヤは、朝早くまだ暗いうちに墓に来た。そして、墓から石が取りのけてあるのを見た。","tok":[["さて"],["、"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["に"],["、"],["マグダラ"],["の"],["マリヤ"],["は"],["、"],["朝","あさ"],["早く","はやく"],["まだ"],["暗い","くらい"],["うち"],["に"],["墓","はか"],["に"],["来た","きた"],["。"],["そして"],["、"],["墓","はか"],["から"],["石","いし"],["が"],["取りのけて","とりのけて"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse":2,"text":"それで、走って、シモン・ペテロと、イエスが愛された、もうひとりの弟子とのところに来て、言った。「だれかが墓から主を取って行きました。主をどこに置いたのか、私たちにはわかりません。」","tok":[["それ"],["で"],["、"],["走って","はしって"],["、"],["シモン"],["・"],["ペテロ"],["と"],["、"],["イエス"],["が"],["愛された","あいされた"],["、"],["もう"],["ひとり"],["の"],["弟子","でし"],["と"],["の"],["ところ"],["に"],["来て","きて"],["、"],["言った","いった"],["。"],["「"],["だれ"],["か"],["が"],["墓","はか"],["から"],["主","ぬし"],["を"],["取って","とって"],["行きました","いきました"],["。"],["主","ぬし"],["を"],["どこ"],["に"],["置いた","おいた"],["の"],["か"],["、"],["私たち","わたしたち"],["に"],["は"],["わかりません"],["。"],["」"]]},{"verse":3,"text":"そこでペテロともうひとりの弟子は外に出て来て、墓のほうへ行った。","tok":[["そこ"],["で"],["ペテロ"],["と"],["もう"],["ひとり"],["の"],["弟子","でし"],["は"],["外","そと"],["に"],["出て","でて"],["来て","きて"],["、"],["墓","はか"],["の"],["ほう"],["へ"],["行った","いった"],["。"]]},{"verse":4,"text":"ふたりはいっしょに走ったが、もうひとりの弟子がペテロよりも速かったので、先に墓に着いた。","tok":[["ふたり"],["は"],["いっしょ"],["に"],["走った","はしった"],["が"],["、"],["もう"],["ひとり"],["の"],["弟子","でし"],["が"],["ペテロ"],["より"],["も"],["速かった","はやかった"],["ので"],["、"],["先","さき"],["に"],["墓","はか"],["に"],["着いた","ついた"],["。"]]},{"verse":5,"text":"そして、からだをかがめてのぞき込み、亜麻布が置いてあるのを見たが、中に入らなかった。","tok":[["そして"],["、"],["からだ"],["を"],["かがめて"],["のぞき込み","のぞきこみ"],["、"],["亜","あ"],["麻布","まふ"],["が"],["置いて","おいて"],["ある"],["の"],["を"],["見た","みた"],["が"],["、"],["中","なか"],["に"],["入らなかった","はいらなかった"],["。"]]},{"verse":6,"text":"シモン・ペテロも彼に続いて来て、墓に入り、亜麻布が置いてあって、","tok":[["シモン"],["・"],["ペテロ"],["も"],["彼","かれ"],["に"],["続いて","つづいて"],["来て","きて"],["、"],["墓","はか"],["に"],["入り","はいり"],["、"],["亜","あ"],["麻布","まふ"],["が"],["置いて","おいて"],["あって"],["、"]]},{"verse":7,"text":"イエスの頭に巻かれていた布切れは、亜麻布といっしょにはなく、離れた所に巻かれたままになっているのを見た。","tok":[["イエス"],["の"],["頭","あたま"],["に"],["巻かれて","まかれて"],["いた"],["布切れ","ぬのきれ"],["は"],["、"],["亜","あ"],["麻布","あざぶ"],["と"],["いっしょ"],["に"],["は"],["なく"],["、"],["離れた","はなれた"],["所","ところ"],["に"],["巻かれた","まかれた"],["まま"],["に"],["なって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":8,"text":"そのとき、先に墓に着いたもうひとりの弟子も入って来た。そして、見て、信じた。","tok":[["その"],["とき"],["、"],["先","さき"],["に"],["墓","はか"],["に"],["着いた","ついた"],["もう"],["ひとり"],["の"],["弟子","でし"],["も"],["入って","はいって"],["来た","きた"],["。"],["そして"],["、"],["見て","みて"],["、"],["信じた","しんじた"],["。"]]},{"verse":9,"text":"彼らは、イエスが死人の中からよみがえらなければならないという聖書を、まだ理解していなかったのである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["イエス"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらなければ"],["ならない"],["と"],["いう"],["聖書","せいしょ"],["を"],["、"],["まだ"],["理解","りかい"],["して"],["いなかった"],["ので"],["ある"],["。"]]},{"verse":10,"text":"それで、弟子たちはまた自分のところに帰って行った。","tok":[["それ"],["で"],["、"],["弟子","でし"],["たち"],["は"],["また"],["自分","じぶん"],["の"],["ところ"],["に"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":11,"text":"しかし、マリヤは外で墓のところにたたずんで泣いていた。そして、泣きながら、からだをかがめて墓の中をのぞき込んだ。","tok":[["しかし"],["、"],["マリヤ"],["は"],["外","そと"],["で"],["墓","はか"],["の"],["ところ"],["に"],["たたずんで"],["泣いて","ないて"],["いた"],["。"],["そして"],["、"],["泣き","なき"],["ながら"],["、"],["からだ"],["を"],["かがめて"],["墓","はか"],["の"],["中","なか"],["を"],["のぞき込んだ","のぞきこんだ"],["。"]]},{"verse":12,"text":"すると、ふたりの御使いが、イエスのからだが置かれていた場所に、ひとりは頭のところに、ひとりは足のところに、白い衣をまとってすわっているのが見えた。","tok":[["する"],["と"],["、"],["ふたり"],["の"],["御使い","おつかい"],["が"],["、"],["イエス"],["の"],["からだ"],["が"],["置かれて","おかれて"],["いた"],["場所","ばしょ"],["に"],["、"],["ひとり"],["は"],["頭","あたま"],["の"],["ところ"],["に"],["、"],["ひとり"],["は"],["足","あし"],["の"],["ところ"],["に"],["、"],["白い","しろい"],["衣","ころも"],["を"],["まとって"],["すわって"],["いる"],["の"],["が"],["見えた","みえた"],["。"]]},{"verse":13,"text":"彼らは彼女に言った。「なぜ泣いているのですか。」彼女は言った。「だれかが私の主を取って行きました。どこに置いたのか、私にはわからないのです。」","tok":[["彼","かれ"],["ら"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["泣いて","ないて"],["いる"],["の"],["です"],["か"],["。"],["」"],["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["だれ"],["か"],["が"],["私","わたくし"],["の"],["主","ぬし"],["を"],["取って","とって"],["行きました","いきました"],["。"],["どこ"],["に"],["置いた","おいた"],["の"],["か"],["、"],["私","わたくし"],["に"],["は"],["わからない"],["の"],["です"],["。"],["」"]]},{"verse":14,"text":"彼女はこう言ってから、うしろを振り向いた。すると、イエスが立っておられるのを見た。しかし、彼女にはイエスであることがわからなかった。","tok":[["彼女","かのじょ"],["は"],["こう"],["言って","いって"],["から"],["、"],["うしろ"],["を"],["振り向いた","ふりむいた"],["。"],["する"],["と"],["、"],["イエス"],["が"],["立って","たって"],["おられる"],["の"],["を"],["見た","みた"],["。"],["しかし"],["、"],["彼女","かのじょ"],["に"],["は"],["イエス"],["で"],["ある"],["こと"],["が"],["わからなかった"],["。"]]},{"verse":15,"text":"イエスは彼女に言われた。「なぜ泣いているのですか。だれを捜しているのですか。」彼女は、それを園の管理人だと思って言った。「あなたが、あの方を運んだのでしたら、どこに置いたのか言ってください。そうすれば私が引き取ります。」","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["。"],["「"],["なぜ"],["泣いて","ないて"],["いる"],["の"],["です"],["か"],["。"],["だれ"],["を"],["捜して","さがして"],["いる"],["の"],["です"],["か"],["。"],["」"],["彼女","かのじょ"],["は"],["、"],["それ"],["を"],["園","その"],["の"],["管理人","かんりにん"],["だ"],["と"],["思って","おもって"],["言った","いった"],["。"],["「"],["あなた"],["が"],["、"],["あの"],["方","ほう"],["を"],["運んだ","はこんだ"],["の"],["でしたら"],["、"],["どこ"],["に"],["置いた","おいた"],["の"],["か"],["言って","いって"],["ください"],["。"],["そう"],["すれば"],["私","わたくし"],["が"],["引き取ります","ひきとります"],["。"],["」"]]},{"verse":16,"text":"イエスは彼女に言われた。「マリヤ。」彼女は振り向いて、ヘブル語で、「ラボニ(すなわち、先生)」とイエスに言った。","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["。"],["「"],["マリヤ"],["。"],["」"],["彼女","かのじょ"],["は"],["振り向いて","ふりむいて"],["、"],["ヘブル"],["語","ご"],["で"],["、"],["「"],["ラボニ"],["("],["すなわち"],["、"],["先生","せんせい"],[")"],["」"],["と"],["イエス"],["に"],["言った","いった"],["。"]]},{"verse":17,"text":"イエスは彼女に言われた。「わたしにすがりついていてはいけません。わたしはまだ父のもとに上っていないからです。わたしの兄弟たちのところに行って、彼らに『わたしは、わたしの父またあなたがたの父、わたしの神またあなたがたの神のもとに上る』と告げなさい。」","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["に"],["すがりついて"],["いて"],["は"],["いけません"],["。"],["わたし"],["は"],["まだ"],["父","ちち"],["の"],["もと"],["に"],["上って","のぼって"],["いない"],["から"],["です"],["。"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["の"],["ところ"],["に"],["行って","い
[{"verse":1,"text":"イエスがヨハネよりも弟子を多くつくって、バプテスマを授けていることがパリサイ人の耳に入った。それを主が知られたとき、","tok":[["イエス"],["が"],["ヨハネ"],["より"],["も"],["弟子","でし"],["を"],["多く","おおく"],["つくって"],["、"],["バプテスマ"],["を"],["授けて","さずけて"],["いる"],["こと"],["が"],["パリサイ"],["人","にん"],["の"],["耳","みみ"],["に"],["入った","はいった"],["。"],["それ"],["を"],["主","ぬし"],["が"],["知られた","しられた"],["とき"],["、"]]},{"verse":2,"text":"――イエスご自身はバプテスマを授けておられたのではなく、弟子たちであったが――","tok":[["―"],["―"],["イエス"],["ご自身","ごじしん"],["は"],["バプテスマ"],["を"],["授けて","さずけて"],["おられた"],["ので"],["は"],["なく"],["、"],["弟子","でし"],["たち"],["で"],["あった"],["が"],["―"],["―"]]},{"verse":3,"text":"主はユダヤを去って、またガリラヤへ行かれた。","tok":[["主","ぬし"],["は"],["ユダヤ"],["を"],["去って","さって"],["、"],["また"],["ガリラヤ"],["へ"],["行かれた","いかれた"],["。"]]},{"verse":4,"text":"しかし、サマリヤを通って行かなければならなかった。","tok":[["しかし"],["、"],["サマリヤ"],["を"],["通って","とおって"],["行かなければ","いかなければ"],["ならなかった"],["。"]]},{"verse":5,"text":"それで主は、ヤコブがその子ヨセフに与えた地所に近いスカルというサマリヤの町に来られた。","tok":[["それ"],["で"],["主","ぬし"],["は"],["、"],["ヤコブ"],["が"],["その"],["子","こ"],["ヨセフ"],["に"],["与えた","あたえた"],["地所","じしょ"],["に"],["近い","ちかい"],["スカル"],["と"],["いう"],["サマリヤ"],["の"],["町","まち"],["に"],["来られた","こられた"],["。"]]},{"verse":6,"text":"そこにはヤコブの井戸があった。イエスは旅の疲れで、井戸のかたわらに腰をおろしておられた。時は第六時ごろであった。","tok":[["そこ"],["に"],["は"],["ヤコブ"],["の"],["井戸","いど"],["が"],["あった"],["。"],["イエス"],["は"],["旅","たび"],["の"],["疲れ","つかれ"],["で"],["、"],["井戸","いど"],["の"],["かたわら"],["に"],["腰","こし"],["を"],["おろして"],["おられた"],["。"],["時","とき"],["は"],["第","だい"],["六","ろく"],["時","じ"],["ごろ"],["で"],["あった"],["。"]]},{"verse":7,"text":"ひとりのサマリヤの女が水をくみに来た。イエスは「わたしに水を飲ませてください」と言われた。","tok":[["ひとり"],["の"],["サマリヤ"],["の"],["女","おんな"],["が"],["水","みず"],["を"],["くみ"],["に"],["来た","きた"],["。"],["イエス"],["は"],["「"],["わたし"],["に"],["水","みず"],["を"],["飲ませて","のませて"],["ください"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"弟子たちは食物を買いに、町へ出かけていた。","tok":[["弟子","でし"],["たち"],["は"],["食物","しょくもつ"],["を"],["買い","かい"],["に"],["、"],["町","まち"],["へ"],["出かけて","でかけて"],["いた"],["。"]]},{"verse":9,"text":"そこで、そのサマリヤの女は言った。「あなたはユダヤ人なのに、どうしてサマリヤの女の私に、飲み水をお求めになるのですか。」――ユダヤ人はサマリヤ人とつきあいをしなかったからである――","tok":[["そこ"],["で"],["、"],["その"],["サマリヤ"],["の"],["女","おんな"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["ユダヤ人","ゆだやじん"],["な"],["のに"],["、"],["どう"],["して"],["サマリヤ"],["の"],["女","おんな"],["の"],["私","わたくし"],["に"],["、"],["飲み水","のみみず"],["を"],["お求め","おもとめ"],["に"],["なる"],["の"],["です"],["か"],["。"],["」"],["―"],["―"],["ユダヤ人","ゆだやじん"],["は"],["サマリヤ"],["人","にん"],["と"],["つきあい"],["を"],["しなかった"],["から"],["で"],["ある"],["―"],["―"]]},{"verse":10,"text":"イエスは答えて言われた。「もしあなたが神の賜物を知り、また、あなたに水を飲ませてくれと言う者がだれであるかを知っていたなら、あなたのほうでその人に求めたことでしょう。そしてその人はあなたに生ける水を与えたことでしょう。」","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["もし"],["あなた"],["が"],["神","かみ"],["の"],["賜物","たまもの"],["を"],["知り","しり"],["、"],["また"],["、"],["あなた"],["に"],["水","みず"],["を"],["飲ませて","のませて"],["くれ"],["と"],["言う","いう"],["者","もの"],["が"],["だれ"],["で"],["ある"],["か"],["を"],["知って","しって"],["いたなら"],["、"],["あなた"],["の"],["ほう"],["で"],["その"],["人","ひと"],["に"],["求めた","もとめた"],["こと"],["でしょう"],["。"],["そして"],["その"],["人","ひと"],["は"],["あなた"],["に"],["生ける","いける"],["水","みず"],["を"],["与えた","あたえた"],["こと"],["でしょう"],["。"],["」"]]},{"verse":11,"text":"彼女は言った。「先生。あなたはくむ物を持っておいでにならず、この井戸は深いのです。その生ける水をどこから手にお入れになるのですか。","tok":[["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["あなた"],["は"],["くむ"],["物","もの"],["を"],["持って","もって"],["おいで"],["に"],["ならず"],["、"],["この"],["井戸","いど"],["は"],["深い","ふかい"],["の"],["です"],["。"],["その"],["生ける","いける"],["水","みず"],["を"],["どこ"],["から"],["手","て"],["に"],["お入れ","おいれ"],["に"],["なる"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"あなたは、私たちの父ヤコブよりも偉いのでしょうか。ヤコブは私たちにこの井戸を与え、彼自身も、彼の子たちも家畜も、この井戸から飲んだのです。」","tok":[["あなた"],["は"],["、"],["私たち","わたしたち"],["の"],["父","ちち"],["ヤコブ"],["より"],["も"],["偉い","えらい"],["の"],["でしょう"],["か"],["。"],["ヤコブ"],["は"],["私たち","わたしたち"],["に"],["この"],["井戸","いど"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["自身","じしん"],["も"],["、"],["彼","かれ"],["の"],["子","こ"],["たち"],["も"],["家畜","かちく"],["も"],["、"],["この"],["井戸","いど"],["から"],["飲んだ","のんだ"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"イエスは答えて言われた。「この水を飲む者はだれでも、また渇きます。","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["この"],["水","みず"],["を"],["飲む","のむ"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["また"],["渇きます","かわきます"],["。"]]},{"verse":14,"text":"しかし、わたしが与える水を飲む者はだれでも、決して渇くことがありません。わたしが与える水は、その人のうちで泉となり、永遠のいのちへの水がわき出ます。」","tok":[["しかし"],["、"],["わたし"],["が"],["与える","あたえる"],["水","みず"],["を"],["飲む","のむ"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["決して","けっして"],["渇く","かわく"],["こと"],["が"],["ありません"],["。"],["わたし"],["が"],["与える","あたえる"],["水","みず"],["は"],["、"],["その"],["人","ひと"],["の"],["うち"],["で"],["泉","いずみ"],["と"],["なり"],["、"],["永遠","えいえん"],["の"],["いのち"],["へ"],["の"],["水","みず"],["が"],["わき出ます","わきでます"],["。"],["」"]]},{"verse":15,"text":"女はイエスに言った。「先生。私が渇くことがなく、もうここまでくみに来なくてもよいように、その水を私に下さい。」","tok":[["女","おんな"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["私","わたくし"],["が"],["渇く","かわく"],["こと"],["が"],["なく"],["、"],["もう"],["ここ"],["まで"],["くみ"],["に"],["来なくて","こなくて"],["も"],["よい"],["よう"],["に"],["、"],["その"],["水","みず"],["を"],["私","わたくし"],["に"],["下さい","ください"],["。"],["」"]]},{"verse":16,"text":"イエスは彼女に言われた。「行って、あなたの夫をここに呼んで来なさい。」","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["。"],["「"],["行って","いって"],["、"],["あなた"],["の"],["夫","おっと"],["を"],["ここ"],["に"],["呼んで","よんで"],["来","き"],["なさい"],["。"],["」"]]},{"verse":17,"text":"女は答えて言った。「私には夫はありません。」イエスは言われた。「私には夫がないというのは、もっともです。","tok":[["女","おんな"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["は"],["夫","おっと"],["は"],["ありません"],["。"],["」"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["私","わたくし"],["に"],["は"],["夫","おっと"],["が"],["ない"],["と"],["いう"],["の"],["は"],["、"],["もっとも"],["です"],["。"]]},{"verse":18,"text":"あなたには夫が五人あったが、今あなたといっしょにいるのは、あなたの夫ではないからです。あなたが言ったことはほんとうです。」","tok":[["あなた"],["に"],["は"],["夫","おっと"],["が"],["五人","ごにん"],["あった"],["が"],["、"],["今","いま"],["あなた"],["と"],["いっしょ"],["に"],["いる"],["の"],["は"],["、"],["あなた"],["の"],["夫","おっと"],["で"],["は"],["ない"],["から"],["です"],["。"],["あなた"],["が"],["言った","いった"],["こと"],["は"],["ほんとう"],["です"],["。"],["」"]]},{"verse":19,"text":"女は言った。「先生。あなたは預言者だと思います。","tok":[["女","おんな"],["は"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["あなた"],["は"],["預言者","よげんしゃ"],["だ"],["と"],["思います","おもいます"],["。"]]},{"verse":20,"text":"私たちの父祖たちはこの山で礼拝しましたが、あなたがたは、礼拝すべき場所はエルサレムだと言われます。」","tok":[["私たち","わたしたち"],["の"],["父祖","ふそ"],["たち"],["は"],["この"],["山","やま"],["で"],["礼拝","れいはい"],["しました"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["礼拝","れいはい"],["すべき"],["場所","ばしょ"],["は"],["エルサレム"],["だ"],["と"],["言われます","いわれます"],["。"],["」"]]},{"verse":21,"text":"イエスは彼女に言われた。「わたしの言うことを信じなさい。あなたがたが父を礼拝するのは、この山でもなく、エルサレムでもない、そういう時が来ます。","tok":[["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["信じ","しんじ"],["なさい"],["。"],["あなた"],["がた"],["が"],["父","ちち"],["を"],["礼拝","れいはい"],["する"],["の"],["は"],["、"],["この"],["山","やま"],["で"],["も"],["なく"],["、"],["エルサレム"],["で"],["も"],["ない"],["、"],["そう"],["いう"],["時","とき"],["が"],["来ます","きます"],["。"]]},{"verse":22,"text":"救いはユダヤ人から出るのですから、わたしたちは知って礼拝していますが、あなたがたは知らないで礼拝しています。","tok":[["救い","すくい"],["は"],["ユダヤ人","ゆだやじん"],["から"],["出る","でる"],["の"],["です"],["から"],["、"],["わたしたち"],["は"],["知って","しって"],["礼拝","れいはい"],["して"],["います"],["が"],["、"],["あなた"],["がた"],["は"],["知らないで","しらないで"],["礼拝","れいはい"],["して"],["います"],["。"]]},{"verse":23,"text":"しかし、真の礼拝者たちが霊とまことによって父を礼拝する時が来ます。今がその時です。父はこのような人々を礼拝者として求めておられるからです。","tok":[["しかし"],["、"],["真","しん"],["の"],["礼拝者","れいはいしゃ"],["たち"],["が"],["霊","れい"],["と"],["まこと"],["によって"],["父","ちち"],["を"],["礼拝","れいはい"],["する"],["時","とき"],["が"],["来ます","きます"],["。"],["今","いま"],["が"],["その"],["時","とき"],["です"],["。"],["父","ちち"],["は"],["この"],["よう"],["な"],["人々","ひとびと"],["を"],["礼拝者","れいはいしゃ"],["として"],["求めて","もとめて"],["おられる"],["から"],["です"],["。"]]},{"verse":24,"text":"神は霊ですから、神を礼拝する者は、霊とまことによって礼拝しなければなりません。」","tok":[["神","かみ"],["は"],["霊","れい"],["です"],["から"],["、"],["神","かみ"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["は"],["、"],["霊","れい"],["と"],["まこと"],["によって"],["礼拝","れいはい"],["しなければ"],["なりません"],["。"],["」"]]},{"verse":25,"text":"女はイエスに言った。「私は、キリストと呼ばれるメシヤの来られることを知っています。その方が来られるときには、いっさいのことを私たちに知らせてくださるでしょう。」","tok":[["女","おんな"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["キリスト"],["と"],["呼ばれる","よばれる"],["メシヤ"],["の"],["来られる","こられる"],["こと"],["を"],["知って","しって"],["います"],["。"],["その"],["方","ほう"],["が"],["来られる","こられる"],["とき"],["に"],["は"],["、"],["いっさい"],["の"],["こと"],["を"],["私たち","わたしたち"],["に"],["知らせて","しらせて"],["くださるでしょう"],["。"],["」"]]},{"verse":26,"text":"イエスは言われた。「あなたと話しているこのわたしがそれです。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["と"],["話して","はなして"],["いる"],["この"],["わたし"],["が"],["それ"],["です"],["。"],["」"]]},{"verse":27,"text":"このとき、弟子たちが帰って来て、イエスが女の人と話しておられるのを不思議に思った。しかし、だれも、「何を求めておられるのですか」とも、「なぜ彼女と話しておられるのですか」とも言わなかった。","tok":[["この"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["帰って","かえって"],["来て","きて"],["、"],["イエス"],["が"],["女","おんな"],["の"],["人","ひと"],["と"],["話して","はなして"],["おられる"],["の"],["を"],["不思議","ふしぎ"],["に"],["思った","おもった"],["。"],["しかし"],["、"],["だれ"],["も"],["、"],["「"],["何","なん"],["を"],["求めて","もとめて"],["おられる"],["の"],["です"],["か"],["」"],["と"],["も"],["、"],["「"],["なぜ"],["彼女","かのじょ"],["と"],["話して","はなして"],["おられる"],["の"],["です"],["か"],["」"],["と"],["も"],["言わなかった","いわなかった"],["。"]]},{"verse":28,"text":"女は、自分の水がめを置いて町へ行き、人々に言った。","tok":[["女","おんな"],["は"],["、"],["自分","じぶん"],["の"],["水がめ","みずがめ"],["を"],["置いて","おいて"],["町","まち"],["へ"],["行き","いき"],["、"],["人々","ひとびと"],["に"],["言った","いった"],["。"]]},{"verse":29,"text":"「来て、見てください。私のしたこと全部を私に言った人がいるのです。この方がキリストなのでしょうか。」","tok":[["「"],["来て","きて"],["、"],["見て","みて"],["ください"],["。"],["私","わたくし"],["の"],["した"],["こと"],["全部","ぜんぶ"],["を"],["私","わたくし"],["に"],["言った","いった"],["人","ひと"],["が"],["いる"],["の"],["です"],["。"],["この"],["方","ほう"],["が"],["キリスト"],["な"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":30,"text":"そこで、彼らは町を出て、イエスのほうへやって来た。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["町","まち"],["を"],["出て","でて"],["、"],["イエス"],["の"],["ほう"],["へ"],["やって"],["来た","きた"],["。"]]},{"verse":31,"text":"そのころ、弟子たちはイエスに、「先生。召し上がってください」とお願いした。","tok":[["その"],["ころ"],["、"],["弟子","でし"],["たち"],["は"],["イエス"],["に"],["、"],["「"],["先生","せんせい"],["。"],["召し上がって","めしあがって"],["ください"],["」"],["と"],["お願い","おねがい"],["した"],["。"]]},{"verse":32,"text":"しかし、イエスは彼らに言われた。「わたしには、あなたがたの知らない食物があります。」","tok":[["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["に"],["は"],["、"],["あなた"],["がた"],["の"],["知らない","しらない"],["食物","しょくもつ"],["が"],["あります"],["。"],["」"]]},{"verse":33,"text":"そこで、弟子たちは互いに言った。「だれか食べる物を持って来たのだろうか。」","tok":[["そこ"],["で"],["、"],["弟子","でし"],["たち"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["だれ"],["か"],["食べる","たべる"],["物","もの"],["を"],["持って","もって"],["来た","きた"],["の"],["だろう"],["か"],["。"],["」"]]},{"verse":34,"text":"イエスは彼らに言われた。「わたしを遣わした方のみこころを行い、そのみわざを成し遂げることが、わたしの食物です。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["を"],["遣わした","つかわした"],["方","ほう"],["のみ"],["こころ"],["を"],["行い","おこない"],["、"],["その"],["みわざ"],["を"],["成し遂げる","なしとげる"],["こと"],["が"],["、"],["わたし"],["の"],["食物","しょくもつ"],["です"],["。"]]},{"verse":35,"text":"あなたがたは、『刈り入れ時が来るまでに、まだ四か月ある』と言ってはいませんか。さあ、わたしの言うことを聞きなさい。目を上げて畑を見なさい。色づいて、刈り入れるばかりになっています。","tok":[["あなた"],["がた"],["は"],["、"],["『"],["刈り入れ","かりいれ"],["時","とき"],["が"],["来る","くる"],["まで"],["に"],["、"],["まだ"],["四","よん"],["か月","かげつ"],["ある"],["』"],["と"],["言って","いって"],["は"],["いません"],["か"],["。"],["さあ"],["、"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["目","め"],["を"],["上げて","あげて"],["畑","はたけ"],["を"],["見","み"],["なさい"],["。"],["色づいて","いろづいて"],["、"],["刈り入れる","かりいれる"],["ばかり"],["に"],["なって"],["います"],["。"]]},{"verse":36,"text":"すでに、刈る者は報酬を受け、永遠のいのちに入れられる実を集めています。それは蒔く者と刈る者がともに喜ぶためです。","tok":[["すでに"],["、"],["刈る","かる"],["者","もの"],["は"],["報酬","ほうしゅう"],["を"],["受け","うけ"],["、"],["永遠","えいえん"],["の"],["いのち"],["に"],["入れられる","いれられる"],["実","じつ"],["を"],["集めて","あつめて"],["います"],["。"],["それ"],["は"],["蒔く","まく"],["者","もの"],["と"],["刈る","かる"],["者","もの"],["が"],["とも"],["に"],["喜ぶ","よろこぶ"],["ため"],["です"],["。"]]},{"verse":37,"text":"こういうわけで、『ひとりが種を蒔き、ほかの者が刈り取る』ということわざは、ほんとうなのです。","tok":[["こう"],["いう"],["わけ"],["で
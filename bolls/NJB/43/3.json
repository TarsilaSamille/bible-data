[{"verse":1,"text":"さて、パリサイ人の中にニコデモという人がいた。ユダヤ人の指導者であった。","tok":[["さて"],["、"],["パリサイ"],["人","にん"],["の"],["中","なか"],["に"],["ニコデモ"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["ユダヤ人","ゆだやじん"],["の"],["指導者","しどうしゃ"],["で"],["あった"],["。"]]},{"verse":2,"text":"この人が、夜、イエスのもとに来て言った。「先生。私たちは、あなたが神のもとから来られた教師であることを知っています。神がともにおられるのでなければ、あなたがなさるこのようなしるしは、だれも行うことができません。」","tok":[["この"],["人","ひと"],["が"],["、"],["夜","よる"],["、"],["イエス"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["私たち","わたしたち"],["は"],["、"],["あなた"],["が"],["神","かみ"],["の"],["もと"],["から"],["来られた","こられた"],["教師","きょうし"],["で"],["ある"],["こと"],["を"],["知って","しって"],["います"],["。"],["神","かみ"],["が"],["とも"],["に"],["おられる"],["ので"],["なければ"],["、"],["あなた"],["が"],["なさる"],["この"],["よう"],["な"],["しるし"],["は"],["、"],["だれ"],["も"],["行う","おこなう"],["こと"],["が"],["できません"],["。"],["」"]]},{"verse":3,"text":"イエスは答えて言われた。「まことに、まことに、あなたに告げます。人は、新しく生まれなければ、神の国を見ることはできません。」","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["まこと"],["に"],["、"],["あなた"],["に"],["告げます","つげます"],["。"],["人","ひと"],["は"],["、"],["新しく","あたらしく"],["生まれなければ","うまれなければ"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["見る","みる"],["こと"],["は"],["できません"],["。"],["」"]]},{"verse":4,"text":"ニコデモは言った。「人は、老年になっていて、どのようにして生まれることができるのですか。もう一度、母の胎に入って生まれることができましょうか。」","tok":[["ニコデモ"],["は"],["言った","いった"],["。"],["「"],["人","ひと"],["は"],["、"],["老年","ろうねん"],["に"],["なって"],["いて"],["、"],["どの"],["よう"],["に"],["して"],["生まれる","うまれる"],["こと"],["が"],["できる"],["の"],["です"],["か"],["。"],["もう"],["一度","いちど"],["、"],["母","はは"],["の"],["胎","はら"],["に"],["入って","はいって"],["生まれる","うまれる"],["こと"],["が"],["できましょう"],["か"],["。"],["」"]]},{"verse":5,"text":"イエスは答えられた。「まことに、まことに、あなたに告げます。人は、水と御霊によって生まれなければ、神の国に入ることができません。","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["まこと"],["に"],["、"],["まこと"],["に"],["、"],["あなた"],["に"],["告げます","つげます"],["。"],["人","ひと"],["は"],["、"],["水","みず"],["と"],["御霊","ごれい"],["によって"],["生まれなければ","うまれなければ"],["、"],["神","かみ"],["の"],["国","くに"],["に"],["入る","はいる"],["こと"],["が"],["できません"],["。"]]},{"verse":6,"text":"肉によって生まれた者は肉です。御霊によって生まれた者は霊です。","tok":[["肉","にく"],["によって"],["生まれた","うまれた"],["者","もの"],["は"],["肉","にく"],["です"],["。"],["御霊","ごれい"],["によって"],["生まれた","うまれた"],["者","もの"],["は"],["霊","れい"],["です"],["。"]]},{"verse":7,"text":"あなたがたは新しく生まれなければならない、とわたしが言ったことを不思議に思ってはなりません。","tok":[["あなた"],["がた"],["は"],["新しく","あたらしく"],["生まれなければ","うまれなければ"],["ならない"],["、"],["と"],["わたし"],["が"],["言った","いった"],["こと"],["を"],["不思議","ふしぎ"],["に"],["思って","おもって"],["は"],["なりません"],["。"]]},{"verse":8,"text":"風はその思いのままに吹き、あなたはその音を聞くが、それがどこから来てどこへ行くかを知らない。御霊によって生まれる者もみな、そのとおりです。」","tok":[["風","かぜ"],["は"],["その"],["思い","おもい"],["の"],["まま"],["に"],["吹き","ふき"],["、"],["あなた"],["は"],["その"],["音","おと"],["を"],["聞く","きく"],["が"],["、"],["それ"],["が"],["どこ"],["から"],["来て","きて"],["どこ"],["へ"],["行く","いく"],["か"],["を"],["知らない","しらない"],["。"],["御霊","ごれい"],["によって"],["生まれる","うまれる"],["者","もの"],["も"],["みな"],["、"],["その"],["とおり"],["です"],["。"],["」"]]},{"verse":9,"text":"ニコデモは答えて言った。「どうして、そのようなことがありうるのでしょう。」","tok":[["ニコデモ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["どう"],["して"],["、"],["その"],["よう"],["な"],["こと"],["が"],["あり"],["うる"],["の"],["でしょう"],["。"],["」"]]},{"verse":10,"text":"イエスは答えて言われた。「あなたはイスラエルの教師でありながら、こういうことがわからないのですか。","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["イスラエル"],["の"],["教師","きょうし"],["で"],["あり"],["ながら"],["、"],["こう"],["いう"],["こと"],["が"],["わからない"],["の"],["です"],["か"],["。"]]},{"verse":11,"text":"まことに、まことに、あなたに告げます。わたしたちは、知っていることを話し、見たことをあかししているのに、あなたがたは、わたしたちのあかしを受け入れません。","tok":[["まこと"],["に"],["、"],["まこと"],["に"],["、"],["あなた"],["に"],["告げます","つげます"],["。"],["わたしたち"],["は"],["、"],["知って","しって"],["いる"],["こと"],["を"],["話し","はなし"],["、"],["見た","みた"],["こと"],["を"],["あかし"],["して"],["いる"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["わたしたち"],["の"],["あかし"],["を"],["受け入れません","うけいれません"],["。"]]},{"verse":12,"text":"あなたがたは、わたしが地上のことを話したとき、信じないくらいなら、天上のことを話したとて、どうして信じるでしょう。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["地上","ちじょう"],["の"],["こと"],["を"],["話した","はなした"],["とき"],["、"],["信じない","しんじない"],["くらい"],["なら"],["、"],["天上","てんじょう"],["の"],["こと"],["を"],["話した","はなした"],["とて"],["、"],["どう"],["して"],["信じるでしょう","しんじるでしょう"],["。"]]},{"verse":13,"text":"だれも天に上った者はいません。しかし天から下った者はいます。すなわち人の子です。","tok":[["だれ"],["も"],["天","てん"],["に"],["上った","のぼった"],["者","もの"],["は"],["いません"],["。"],["しかし"],["天","てん"],["から"],["下った","くだった"],["者","もの"],["は"],["います"],["。"],["すなわち"],["人","ひと"],["の"],["子","こ"],["です"],["。"]]},{"verse":14,"text":"モーセが荒野で蛇を上げたように、人の子もまた上げられなければなりません。","tok":[["モーセ"],["が"],["荒野","あらの"],["で"],["蛇","へび"],["を"],["上げた","あげた"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["また"],["上げられなければ","あげられなければ"],["なりません"],["。"]]},{"verse":15,"text":"それは、信じる者がみな、人の子にあって永遠のいのちを持つためです。」","tok":[["それ"],["は"],["、"],["信じる","しんじる"],["者","もの"],["が"],["みな"],["、"],["人","ひと"],["の"],["子","こ"],["に"],["あって"],["永遠","えいえん"],["の"],["いのち"],["を"],["持つ","もつ"],["ため"],["です"],["。"],["」"]]},{"verse":16,"text":"神は、実に、そのひとり子をお与えになったほどに、世を愛された。それは御子を信じる者が、ひとりとして滅びることなく、永遠のいのちを持つためである。","tok":[["神","かみ"],["は"],["、"],["実","じつ"],["に"],["、"],["その"],["ひとり"],["子","こ"],["を"],["お与え","おあたえ"],["に"],["なった"],["ほど"],["に"],["、"],["世","よ"],["を"],["愛された","あいされた"],["。"],["それ"],["は"],["御子","みこ"],["を"],["信じる","しんじる"],["者","もの"],["が"],["、"],["ひとり"],["として"],["滅びる","ほろびる"],["こと"],["なく"],["、"],["永遠","えいえん"],["の"],["いのち"],["を"],["持つ","もつ"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"神が御子を世に遣わされたのは、世をさばくためではなく、御子によって世が救われるためである。","tok":[["神","かみ"],["が"],["御子","みこ"],["を"],["世","よ"],["に"],["遣わされた","つかわされた"],["の"],["は"],["、"],["世","よ"],["を"],["さばく"],["ため"],["で"],["は"],["なく"],["、"],["御子","みこ"],["によって"],["世","よ"],["が"],["救われる","すくわれる"],["ため"],["で"],["ある"],["。"]]},{"verse":18,"text":"御子を信じる者はさばかれない。信じない者は神のひとり子の御名を信じなかったので、すでにさばかれている。","tok":[["御子","みこ"],["を"],["信じる","しんじる"],["者","もの"],["は"],["さばかれない"],["。"],["信じない","しんじない"],["者","もの"],["は"],["神","かみ"],["の"],["ひとり"],["子","こ"],["の"],["御名","ぎょめい"],["を"],["信じなかった","しんじなかった"],["ので"],["、"],["すでに"],["さばかれて"],["いる"],["。"]]},{"verse":19,"text":"そのさばきというのは、こう
"]]},{"verse":25,"text":"イエスは彼らに答えられた。「わたしは話しました。しかし、あなたがたは信じないのです。わたしが父の御名によって行うわざが、わたしについて証言しています。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えられた","こたえられた"],["。"],["「"],["わたし"],["は"],["話しました","はなしました"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["信じない","しんじない"],["の"],["です"],["。"],["わたし"],["が"],["父","ちち"],["の"],["御名","ぎょめい"],["によって"],["行う","おこなう"],["わざ"],["が"],["、"],["わたし"],["について"],["証言","しょうげん"],["して"],["います"],["。"]]},{"verse":26,"text":"しかし、あなたがたは信じません。それは、あなたがたがわたしの羊に属していないからです。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["信じません","しんじません"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["羊","ひつじ"],["に"],["属して","ぞくして"],["いない"],["から"],["です"],["。"]]},{"verse":27,"text":"わたしの羊はわたしの声を聞き分けます。またわたしは彼らを知っています。そして彼らはわたしについて来ます。","tok":[["わたし"],["の"],["羊","ひつじ"],["は"],["わたし"],["の"],["声","こえ"],["を"],["聞き分けます","ききわけます"],["。"],["また"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["知って","しって"],["います"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["わたし"],["について"],["来ます","きます"],["。"]]},{"verse":28,"text":"わたしは彼らに永遠のいのちを与えます。彼らは決して滅びることがなく、また、だれもわたしの手から彼らを奪い去るようなことはありません。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["永遠","えいえん"],["の"],["いのち"],["を"],["与えます","あたえます"],["。"],["彼","かれ"],["ら"],["は"],["決して","けっして"],["滅びる","ほろびる"],["こと"],["が"],["なく"],["、"],["また"],["、"],["だれ"],["も"],["わたし"],["の"],["手","て"],["から"],["彼","かれ"],["ら"],["を"],["奪い去る","うばいさる"],["よう"],["な"],["こと"],["は"],["ありません"],["。"]]},{"verse":29,"text":"わたしに彼らをお与えになった父は、すべてにまさって偉大です。だれもわたしの父の御手から彼らを奪い去ることはできません。","tok":[["わたし"],["に"],["彼","かれ"],["ら"],["を"],["お与え","おあたえ"],["に"],["なった"],["父","ちち"],["は"],["、"],["すべて"],["に"],["まさって"],["偉大","いだい"],["です"],["。"],["だれ"],["も"],["わたし"],["の"],["父","ちち"],["の"],["御手","おて"],["から"],["彼","かれ"],["ら"],["を"],["奪い去る","うばいさる"],["こと"],["は"],["できません"],["。"]]},{"verse":30,"text":"わたしと父とは一つです。」","tok":[["わたし"],["と"],["父","ちち"],["と"],["は"],["一","ひと"],["つ"],["です"],["。"],["」"]]},{"verse":31,"text":"ユダヤ人たちは、イエスを石打ちにしようとして、また石を取り上げた。","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["イエス"],["を"],["石打ち","いしうち"],["に"],["しよう"],["として"],["、"],["また"],["石","いし"],["を"],["取り上げた","とりあげた"],["。"]]},{"verse":32,"text":"イエスは彼らに答えられた。「わたしは、父から出た多くの良いわざを、あなたがたに示しました。そのうちのどのわざのために、わたしを石打ちにしようとするのですか。」","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えられた","こたえられた"],["。"],["「"],["わたし"],["は"],["、"],["父","ちち"],["から"],["出た","でた"],["多く","おおく"],["の"],["良い","よい"],["わざ"],["を"],["、"],["あなた"],["がた"],["に"],["示しました","しめしました"],["。"],["その"],["うち"],["の"],["どの"],["わざ"],["の"],["ため"],["に"],["、"],["わたし"],["を"],["石打ち","いしうち"],["に"],["しよう"],["と"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":33,"text":"ユダヤ人たちはイエスに答えた。「良いわざのためにあなたを石打ちにするのではありません。冒?のためです。あなたは人間でありながら、自分を神とするからです。」","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["イエス"],["に"],["答えた","こたえた"],["。"],["「"],["良い","よい"],["わざ"],["の"],["ため"],["に"],["あなた"],["を"],["石打ち","いしうち"],["に"],["する"],["ので"],["は"],["ありません"],["。"],["冒","ぼう"],["?"],["の"],["ため"],["です"],["。"],["あなた"],["は"],["人間","にんげん"],["で"],["あり"],["ながら"],["、"],["自分","じぶん"],["を"],["神","かみ"],["と"],["する"],["から"],["です"],["。"],["」"]]},{"verse":34,"text":"イエスは彼らに答えられた。「あなたがたの律法に、『わたしは言った、おまえたちは神々である』と書いてはいないか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えられた","こたえられた"],["。"],["「"],["あなた"],["がた"],["の"],["律法","りっぽう"],["に"],["、"],["『"],["わたし"],["は"],["言った","いった"],["、"],["おまえ"],["たち"],["は"],["神々","かみがみ"],["で"],["ある"],["』"],["と"],["書いて","かいて"],["は"],["いない"],["か"],["。"]]},{"verse":35,"text":"もし、神のことばを受けた人々を、神々と呼んだとすれば、聖書は廃棄されるものではないから、","tok":[["もし"],["、"],["神","かみ"],["の"],["ことば"],["を"],["受けた","うけた"],["人々","ひとびと"],["を"],["、"],["神々","かみがみ"],["と"],["呼んだ","よんだ"],["と"],["すれば"],["、"],["聖書","せいしょ"],["は"],["廃棄","はいき"],["される"],["もの"],["で"],["は"],["ない"],["から"],["、"]]},{"verse":36,"text":"『わたしは神の子である』とわたしが言ったからといって、どうしてあなたがたは、父が、聖であることを示して世に遣わした者について、『神を冒?している』と言うのですか。","tok":[["『"],["わたし"],["は"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["』"],["と"],["わたし"],["が"],["言った","いった"],["から"],["と"],["いって"],["、"],["どう"],["して"],["あなた"],["がた"],["は"],["、"],["父","ちち"],["が"],["、"],["聖","せい"],["で"],["ある"],["こと"],["を"],["示して","しめして"],["世","よ"],["に"],["遣わした","つかわした"],["者","もの"],["について"],["、"],["『"],["神","かみ"],["を"],["冒","おかせ"],["?"],["して"],["いる"],["』"],["と"],["言う","いう"],["の"],["です"],["か"],["。"]]},{"verse":37,"text":"もしわたしが、わたしの父のみわざを行っていないのなら、わたしを信じないでいなさい。","tok":[["もし"],["わたし"],["が"],["、"],["わたし"],["の"],["父","ちち"],["のみ"],["わざ"],["を"],["行って","おこなって"],["いない"],["の"],["なら"],["、"],["わたし"],["を"],["信じないで","しんじないで"],["い"],["なさい"],["。"]]},{"verse":38,"text":"しかし、もし行っているなら、たといわたしの言うことが信じられなくても、わざを信用しなさい。それは、父がわたしにおられ、わたしが父にいることを、あなたがたが悟り、また知るためです。」","tok":[["しかし"],["、"],["もし"],["行って","いって"],["いるなら"],["、"],["たとい"],["わたし"],["の"],["言う","いう"],["こと"],["が"],["信じられなくて","しんじられなくて"],["も"],["、"],["わざ"],["を"],["信用","しんよう"],["し"],["なさい"],["。"],["それ"],["は"],["、"],["父","ちち"],["が"],["わたし"],["に"],["おられ"],["、"],["わたし"],["が"],["父","ちち"],["に"],["いる"],["こと"],["を"],["、"],["あなた"],["がた"],["が"],["悟り","さとり"],["、"],["また"],["知る","しる"],["ため"],["です"],["。"],["」"]]},{"verse":39,"text":"そこで、彼らはまたイエスを捕らえようとした。しかし、イエスは彼らの手からのがれられた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["また"],["イエス"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["。"],["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["のがれられた"],["。"]]},{"verse":40,"text":"そして、イエスはまたヨルダンを渡って、ヨハネが初めにバプテスマを授けていた所に行かれ、そこに滞在された。","tok":[["そして"],["、"],["イエス"],["は"],["また"],["ヨルダン"],["を"],["渡って","わたって"],["、"],["ヨハネ"],["が"],["初め","はじめ"],["に"],["バプテスマ"],["を"],["授けて","さずけて"],["いた"],["所","ところ"],["に"],["行かれ","いかれ"],["、"],["そこ"],["に"],["滞在","たいざい"],["された"],["。"]]},{"verse":41,"text":"多くの人々がイエスのところに来た。彼らは、「ヨハネは何一つしるしを行わなかったけれども、彼がこの方について話したことはみな真実であった」と言った。","tok":[["多く","おおく"],["の"],["人々","ひとびと"],["が"],["イエス"],["の"],["ところ"],["に"],["来た","きた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["「"],["ヨハネ"],["は"],["何","なん"],["一","ひと"],["つ"],["しるし"],["を"],["行わなかった","おこなわなかった"],["けれど"],["も"],["、"],["彼","かれ"],["が"],["この"],["方","かた"],["について"],["話した","はなした"],["こと"],["は"],["みな"],["真実","しんじつ"],["で"],["あった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":42,"text":"そして、その地方で多くの人々がイエスを信じた。","tok":[["そして"],["、"],["その"],["地方","ちほう"],["で"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["イエス"],["を"],["信じた","しんじた"],["。"]]}]
[{"verse":1,"text":"そこで、ピラトはイエスを捕らえて、むち打ちにした。","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["イエス"],["を"],["捕らえて","とらえて"],["、"],["むち打ち","むちうち"],["に"],["した"],["。"]]},{"verse":2,"text":"また、兵士たちは、いばらで冠を編んで、イエスの頭にかぶらせ、紫色の着物を着せた。","tok":[["また"],["、"],["兵士","へいし"],["たち"],["は"],["、"],["いばら"],["で"],["冠","かんむり"],["を"],["編んで","あんで"],["、"],["イエス"],["の"],["頭","あたま"],["に"],["かぶらせ"],["、"],["紫色","むらさきいろ"],["の"],["着物","きもの"],["を"],["着せた","きせた"],["。"]]},{"verse":3,"text":"彼らは、イエスに近寄っては、「ユダヤ人の王さま。ばんざい」と言い、またイエスの顔を平手で打った。","tok":[["彼","かれ"],["ら"],["は"],["、"],["イエス"],["に"],["近寄って","ちかよって"],["は"],["、"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["さま"],["。"],["ばんざい"],["」"],["と"],["言い","いい"],["、"],["また"],["イエス"],["の"],["顔","かお"],["を"],["平手","ひらて"],["で"],["打った","うった"],["。"]]},{"verse":4,"text":"ピラトは、もう一度外に出て来て、彼らに言った。「よく聞きなさい。あなたがたのところにあの人を連れ出して来ます。あの人に何の罪も見られないということを、あなたがたに知らせるためです。」","tok":[["ピラト"],["は"],["、"],["もう"],["一度","いちど"],["外","そと"],["に"],["出て","でて"],["来て","きて"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["よく"],["聞き","きき"],["なさい"],["。"],["あなた"],["がた"],["の"],["ところ"],["に"],["あの"],["人","ひと"],["を"],["連れ出して","つれだして"],["来ます","きます"],["。"],["あの"],["人","ひと"],["に"],["何","なん"],["の"],["罪","つみ"],["も"],["見られない","みられない"],["と"],["いう"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["知らせる","しらせる"],["ため"],["です"],["。"],["」"]]},{"verse":5,"text":"それでイエスは、いばらの冠と紫色の着物を着けて、出て来られた。するとピラトは彼らに「さあ、この人です」と言った。","tok":[["それ"],["で"],["イエス"],["は"],["、"],["いばら"],["の"],["冠","かんむり"],["と"],["紫色","むらさきいろ"],["の"],["着物","きもの"],["を"],["着けて","つけて"],["、"],["出て","でて"],["来られた","こられた"],["。"],["する"],["と"],["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["「"],["さあ"],["、"],["この"],["人","ひと"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"祭司長たちや役人たちはイエスを見ると、激しく叫んで、「十字架につけろ。十字架につけろ」と言った。ピラトは彼らに言った。「あなたがたがこの人を引き取り、十字架につけなさい。私はこの人には罪を認めません。」","tok":[["祭司長","さいしちょう"],["たち"],["や"],["役人","やくにん"],["たち"],["は"],["イエス"],["を"],["見る","みる"],["と"],["、"],["激しく","はげしく"],["叫んで","さけんで"],["、"],["「"],["十字架","じゅうじか"],["に"],["つけろ"],["。"],["十字架","じゅうじか"],["に"],["つけろ"],["」"],["と"],["言った","いった"],["。"],["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["が"],["この"],["人","ひと"],["を"],["引き取り","ひきとり"],["、"],["十字架","じゅうじか"],["に"],["つけ"],["なさい"],["。"],["私","わたくし"],["は"],["この"],["人","ひと"],["に"],["は"],["罪","つみ"],["を"],["認めません","みとめません"],["。"],["」"]]},{"verse":7,"text":"ユダヤ人たちは彼に答えた。「私たちには律法があります。この人は自分を神の子としたのですから、律法によれば、死に当たります。」","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["彼","かれ"],["に"],["答えた","こたえた"],["。"],["「"],["私たち","わたしたち"],["に"],["は"],["律法","りっぽう"],["が"],["あります"],["。"],["この"],["人","ひと"],["は"],["自分","じぶん"],["を"],["神","かみ"],["の"],["子","こ"],["と"],["した"],["の"],["です"],["から"],["、"],["律法","りっぽう"],["に"],["よれば"],["、"],["死","し"],["に"],["当たります","あたります"],["。"],["」"]]},{"verse":8,"text":"ピラトは、このことばを聞くと、ますます恐れた。","tok":[["ピラト"],["は"],["、"],["この"],["ことば"],["を"],["聞く","きく"],["と"],["、"],["ますます"],["恐れた","おそれた"],["。"]]},{"verse":9,"text":"そして、また官邸に入って、イエスに言った。「あなたはどこの人ですか。」しかし、イエスは彼に何の答えもされなかった。","tok":[["そして"],["、"],["また"],["官邸","かんてい"],["に"],["入って","はいって"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["どこ"],["の"],["人","ひと"],["です"],["か"],["。"],["」"],["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["に"],["何","なん"],["の"],["答え","こたえ"],["も"],["されなかった"],["。"]]},{"verse":10,"text":"そこで、ピラトはイエスに言った。「あなたは私に話さないのですか。私にはあなたを釈放する権威があり、また十字架につける権威があることを、知らないのですか。」","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["に"],["話さない","はなさない"],["の"],["です"],["か"],["。"],["私","わたくし"],["に"],["は"],["あなた"],["を"],["釈放","しゃくほう"],["する"],["権威","けんい"],["が"],["あり"],["、"],["また"],["十字架","じゅうじか"],["に"],["つける"],["権威","けんい"],["が"],["ある"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":11,"text":"イエスは答えられた。「もしそれが上から与えられているのでなかったら、あなたにはわたしに対して何の権威もありません。ですから、わたしをあなたに渡した者に、もっと大きい罪があるのです。」","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["もし"],["それ"],["が"],["上","うえ"],["から"],["与えられて","あたえられて"],["いる"],["ので"],["なかったら"],["、"],["あなた"],["に"],["は"],["わたし"],["に対して","にたいして"],["何","なん"],["の"],["権威","けんい"],["も"],["ありません"],["。"],["です"],["から"],["、"],["わたし"],["を"],["あなた"],["に"],["渡した","わたした"],["者","もの"],["に"],["、"],["もっと"],["大きい","おおきい"],["罪","つみ"],["が"],["ある"],["の"],["です"],["。"],["」"]]},{"verse":12,"text":"こういうわけで、ピラトはイエスを釈放しようと努力した。しかし、ユダヤ人たちは激しく叫んで言った。「もしこの人を釈放するなら、あなたはカイザルの味方ではありません。自分を王だとする者はすべて、カイザルにそむくのです。」","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["ピラト"],["は"],["イエス"],["を"],["釈放","しゃくほう"],["しよう"],["と"],["努力","どりょく"],["した"],["。"],["しかし"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["激しく","はげしく"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["もし"],["この"],["人","ひと"],["を"],["釈放","しゃくほう"],["するなら"],["、"],["あなた"],["は"],["カイザル"],["の"],["味方","みかた"],["で"],["は"],["ありません"],["。"],["自分","じぶん"],["を"],["王","おう"],["だ"],["と"],["する"],["者","もの"],["は"],["すべて"],["、"],["カイザル"],["に"],["そむく"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"そこでピラトは、これらのことばを聞いたとき、イエスを外に引き出し、敷石(ヘブル語ではガバタ)と呼ばれる場所で、裁判の席に着いた。","tok":[["そこ"],["で"],["ピラト"],["は"],["、"],["これ"],["ら"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["イエス"],["を"],["外","そと"],["に"],["引き出し","ひきだし"],["、"],["敷石","しきいし"],["("],["ヘブル"],["語","ご"],["で"],["は"],["ガバタ"],[")"],["と"],["呼ばれる","よばれる"],["場所","ばしょ"],["で"],["、"],["裁判","さいばん"],["の"],["席","せき"],["に"],["着いた","ついた"],["。"]]},{"verse":14,"text":"その日は過越の備え日で、時は第六時ごろであった。ピラトはユダヤ人たちに言った。「さあ、あなたがたの王です。」","tok":[["その"],["日","ひ"],["は"],["過越","すぎこし"],["の"],["備え","そなえ"],["日","ひ"],["で"],["、"],["時","とき"],["は"],["第","だい"],["六","ろく"],["時","じ"],["ごろ"],["で"],["あった"],["。"],["ピラト"],["は"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["あなた"],["がた"],["の"],["王","おう"],["です"],["。"],["」"]]},{"verse":15,"text":"彼らは激しく叫んだ。「除け。除け。十字架につけろ。」ピラトは彼らに言った。「あなたがたの王を私が十字架につけるのですか。」祭司長たちは答えた。「カイザルのほかには、私たちに王はありません。」","tok":[["彼","かれ"],["ら"],["は"],["激しく","はげしく"],["叫んだ","さけんだ"],["。"],["「"],["除け","よけ"],["。"],["除け","よけ"],["。"],["十字架","じゅうじか"],["に"],["つけろ"],["。"],["」"],["ピラト"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["王","おう"],["を"],["私","わたくし"],["が"],["十字架","じゅうじか"],["に"],["つける"],["の"],["です"],["か"],["。"],["」"],["祭司長","さいしちょう"],["たち"],["は"],["答えた","こたえた"],["。"],["「"],["カイザル"],["の"],["ほか"],["に"],["は"],["、"],["私たち","わたしたち"],["に"],["王","おう"],["は"],["ありません"],["。"],["」"]]},{"verse":16,"text":"そこでピラトは、そのとき、イエスを、十字架につけるため彼らに引き渡した。","tok":[["そこ"],["で"],["ピラト"],["は"],["、"],["その"],["とき"],["、"],["イエス"],["を"],["、"],["十字架","じゅうじか"],["に"],["つける"],["ため"],["彼","かれ"],["ら"],["に"],["引き渡した","ひきわたした"],["。"]]},{"verse":17,"text":"彼らはイエスを受け取った。そして、イエスはご自分で十字架を負って、「どくろの地」という場所(ヘブル語でゴルゴタと言われる)に出て行かれた。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["を"],["受け取った","うけとった"],["。"],["そして"],["、"],["イエス"],["は"],["ご自分","ごじぶん"],["で"],["十字架","じゅうじか"],["を"],["負って","おって"],["、"],["「"],["どくろ"],["の"],["地","ち"],["」"],["と"],["いう"],["場所","ばしょ"],["("],["ヘブル"],["語","ご"],["で"],["ゴルゴタ"],["と"],["言われる","いわれる"],[")"],["に"],["出て","でて"],["行かれた","いかれた"],["。"]]},{"verse":18,"text":"彼らはそこでイエスを十字架につけた。イエスといっしょに、ほかのふたりの者をそれぞれ両側に、イエスを真ん中にしてであった。","tok":[["彼","かれ"],["ら"],["は"],["そこ"],["で"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つけた"],["。"],["イエス"],["と"],["いっしょ"],["に"],["、"],["ほか"],["の"],["ふたり"],["の"],["者","もの"],["を"],["それぞれ"],["両側","りょうがわ"],["に"],["、"],["イエス"],["を"],["真ん中","まんなか"],["に"],["して"],["で"],["あった"],["。"]]},{"verse":19,"text":"ピラトは罪状書きも書いて、十字架の上に掲げた。それには「ユダヤ人の王ナザレ人イエス」と書いてあった。","tok":[["ピラト"],["は"],["罪状書き","ざいじょうかき"],["も"],["書いて","かいて"],["、"],["十字架","じゅうじか"],["の"],["上","うえ"],["に"],["掲げた","かかげた"],["。"],["それ"],["に"],["は"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["ナザレ人","なざれにん"],["イエス"],["」"],["と"],["書いて","かいて"],["あった"],["。"]]},{"verse":20,"text":"それで、大ぜいのユダヤ人がこの罪状書きを読んだ。イエスが十字架につけられた場所は都に近かったからである。またそれはヘブル語、ラテン語、ギリシヤ語で書いてあった。","tok":[["それ"],["で"],["、"],["大ぜい","おおぜい"],["の"],["ユダヤ人","ゆだやじん"],["が"],["この"],["罪状書き","ざいじょうかき"],["を"],["読んだ","よんだ"],["。"],["イエス"],["が"],["十字架","じゅうじか"],["に"],["つけられた"],["場所","ばしょ"],["は"],["都","と"],["に"],["近かった","ちかかった"],["から"],["で"],["ある"],["。"],["また"],["それ"],["は"],["ヘブル"],["語","ご"],["、"],["ラテン語","らてんご"],["、"],["ギリシヤ"],["語","ご"],["で"],["書いて","かいて"],["あった"],["。"]]},{"verse":21,"text":"そこで、ユダヤ人の祭司長たちがピラトに、「ユダヤ人の王、と書かないで、彼はユダヤ人の王と自称した、と書いてください」と言った。","tok":[["そこ"],["で"],["、"],["ユダヤ人","ゆだやじん"],["の"],["祭司長","さいしちょう"],["たち"],["が"],["ピラト"],["に"],["、"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["、"],["と"],["書かないで","かかないで"],["、"],["彼","かれ"],["は"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["と"],["自称","じしょう"],["した"],["、"],["と"],["書いて","かいて"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":22,"text":"ピラトは答えた。「私の書いたことは私が書いたのです。」","tok":[["ピラト"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["の"],["書いた","かいた"],["こと"],["は"],["私","わたくし"],["が"],["書いた","かいた"],["の"],["です"],["。"],["」"]]},{"verse":23,"text":"さて、兵士たちは、イエスを十字架につけると、イエスの着物を取り、ひとりの兵士に一つずつあたるよう四分した。また下着をも取ったが、それは上から全部一つに織った、縫い目なしのものであった。","tok":[["さて"],["、"],["兵士","へいし"],["たち"],["は"],["、"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つける"],["と"],["、"],["イエス"],["の"],["着物","きもの"],["を"],["取り","とり"],["、"],["ひとり"],["の"],["兵士","へいし"],["に"],["一","ひと"],["つ"],["ずつ"],["あたる"],["よう"],["四分","よんぶん"],["した"],["。"],["また"],["下着","したぎ"],["を"],["も"],["取った","とった"],["が"],["、"],["それ"],["は"],["上","うえ"],["から"],["全部","ぜんぶ"],["一","ひと"],["つ"],["に"],["織った","おった"],["、"],["縫い目","ぬいめ"],["なし"],["の"],["もの"],["で"],["あった"],["。"]]},{"verse":24,"text":"そこで彼らは互いに言った。「それは裂かないで、だれの物になるか、くじを引こう。」それは、「彼らはわたしの着物を分け合い、わたしの下着のためにくじを引いた」という聖書が成就するためであった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["それ"],["は"],["裂かないで","さかないで"],["、"],["だれ"],["の"],["物","もの"],["に"],["なる"],["か"],["、"],["くじ"],["を"],["引こう","ひこう"],["。"],["」"],["それ"],["は"],["、"],["「"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["着物","きもの"],["を"],["分け合い","わけあい"],["、"],["わたし"],["の"],["下着","したぎ"],["の"],["ため"],["に"],["くじ"],["を"],["引いた","ひいた"],["」"],["と"],["いう"],["聖書","せいしょ"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":25,"text":"兵士たちはこのようなことをしたが、イエスの十字架のそばには、イエスの母と母の姉妹と、クロパの妻のマリヤとマグダラのマリヤが立っていた。","tok":[["兵士","へいし"],["たち"],["は"],["この"],["よう"],["な"],["こと"],["を"],["した"],["が"],["、"],["イエス"],["の"],["十字架","じゅうじか"],["の"],["そば"],["に"],["は"],["、"],["イエス"],["の"],["母","はは"],["と"],["母","はは"],["の"],["姉妹","しまい"],["と"],["、"],["クロパ"],["の"],["妻","つま"],["の"],["マリヤ"],["と"],["マグダラ"],["の"],["マリヤ"],["が"],["立って","たって"],["いた"],["。"]]},{"verse":26,"text":"イエスは、母と、そばに立っている愛する弟子とを見て、母に「女の方。そこに、あなたの息子がいます」と言われた。","tok":[["イエス"],["は"],["、"],["母","はは"],["と"],["、"],["そば"],["に"],["立って","たって"],["いる"],["愛する","あいする"],["弟子","でし"],["と"],["を"],["見て","みて"],["、"],["母","はは"],["に"],["「"],["女","おんな"],["の"],["方","ほう"],["。"],["そこ"],["に"],["、"],["あなた"],["の"],["息子","むすこ"],["が"],["います"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":27,"text":"それからその弟子に「そこに、あなたの母がいます」と言われた。その時から、この弟子は彼女を自分の家に引き取った。","tok":[["それ"],["から"],["その"],["弟子","でし"],["に"],["「"],["そこ"],["に"],["、"],["あなた"],["の"],["母","はは"],["が"],["います"],["」"],["と"],["言われた","いわれた"],["。"],["その"],["時","とき"],["から"],["、"],["この"],["弟子","でし"],["は"],["彼女","かのじょ"],["を"],["自分","じぶん"],["の"],["家","いえ"],["に"],["引き取った","ひきとった"],["。"]]},{"verse":28,"text":"この後、イエスは、すべてのことが完了したのを知って、聖書が成就するために、「わたしは渇く」と言われた。","tok":[["この"],["後","ご"],["、"],["イエス"],["は"],["、"],["すべて"],["の"],["こと"],["が"],["完了","かんりょう"],["した"],["の"],["を"],["知って","しって"],["、"],["聖書","せいしょ"],["が"],["成就","じょうじゅ"],["する"],["ため"],["に"],["、"],["「"],["わたし"],["は"],["渇く","かわく"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":29,"text":"そこには酸いぶどう酒のいっぱい入った入れ物が置いてあった。そこで彼らは、酸いぶどう酒を含んだ海綿をヒソプの枝につけて、それをイエスの口もとに差し出した。","tok":[["そこ"],["に"],["は"],["酸い","すい"],["ぶどう酒","ぶどうしゅ"],["の"],["いっぱい"],["入った","はいった"],["入れ物","いれもの"],["が"],["置いて","おいて"],["あった"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["酸い","すい"],["ぶどう酒","ぶどうしゅ"],["を"],["含んだ","ふくんだ"],["海綿","かいめん"],["を"],["ヒソプ"],["の"],["枝","えだ"],["に"],["つけて"],["、"],["それ"],["を"],["イエス"],["の"],["口もと","くちもと"],["に"],["差し出した","さしだした"],["。"]]},{"verse":30,"text":"イエスは、酸いぶどう酒を受けられると、「完了した」と言われた。そして、頭をたれて、霊をお渡しになった。","tok":[["イエス"],["は"],["、"],["酸い","すい"],["ぶどう酒","ぶどうしゅ"],["を"],["受けられる","うけられる"],["と"],["、"],["「"],["完了","かんりょう"],["した"],["」"],["と"],["言われた","いわれた"],["。"],["そして"],["、"],["頭","あたま"],["を"],["たれて"],["、"],["霊","れい"],["を"],["お渡し","おわたし"],["に"],["なった"],["。"]]},{"verse":31,"text":"その日は備え日であったため、ユダヤ人たちは安息日に(その安息日は大いなる日であったので)、死体を十字架の上に残しておかないように、すねを折ってそれを取りのける処置をピラトに願った。","tok":[["その"],["日","ひ"],["は"],["備え","そなえ"],["日","ひ"],["で"],["あった"],["ため"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["安息日","あんそくび"],["に"],["("],["その"],["安息日","あんそくび"],["は"],["大いなる","おおいなる"],["日","ひ"],["で"],["あった"],["ので"],[")"],["、"],["死体","したい"],["を"],["十字架","じゅうじか"],["の"],["上","うえ"],["に"],["残して","のこして"],["おかない"],["よう"],["に"],["、"],["すね"],["を"],["折って","おって"],["それ"],["を"],["取りのける","とりのける"],["処置","しょち"],["を"],["ピラト"],["に"],["願った","ねがった"],["。"]]},{"verse":32,"text":"それで、兵士たちが来て、イエスといっしょに十字架につけられた第一の者と、もうひとりの者とのすねを折った。","tok":[["それ"],["で"],["、"],["兵士","へいし"],["たち"],["が"],["来て","きて"],["、"],["イエス"],["と"],["いっしょ"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["第","だい"],["一","いち"],["の"],["者","もの"],["と"],["、"],["もう"],["ひとり"],["の"],["者","もの"],["と"],["の"],["すね"],["を"],["折った","おった"],["。"]]},{"verse":33,"text":"しかし、イエスのところに来ると、イエスがすでに死んでおられるのを認めたので、そのすねを折らなかった。","tok":[["しかし"],["、"],["イエス"],["の"],["ところ"],["に"],["来る","くる"],["と"],["、"],["イエス"],["が"],["すでに"],["死んで","しんで"],["おられる"],["の"],["を"],["認めた","みとめた"],["ので"],["、"],["その"],["すね"],["を"],["折らなかった","おらなかった"],["。"]]},{"verse":34,"text":"しかし、兵士のうちのひとりがイエスのわき腹を槍で突き刺した。すると、ただちに血と水が出て来た。","tok":[["しかし"],["、"],["兵士","へいし"],["の"],["うち"],["の"],["ひとり"],["が"],["イエス"],["の"],["わき腹","わきばら"],["を"],["槍","やり"],["で"],["突き刺した","つきさした"],["。"],["する"],["と"],["、"],["ただちに"],["血","ち"],["と"],["水","みず"],["が"],["出て","でて"],["来た","きた"],["。"]]},{"verse":35,"text":"それを目撃した者があかしをしているのである。そのあかしは真実である。その人が、あなたがたにも信じさせるために、真実を話すということをよく知っているのである。","tok":[["それ"],["を"],["目撃","もくげき"],["した"],["者","もの"],["が"],["あかし"],["を"],["して"],["いる"],["ので"],["ある"],["。"],["その"],["あかし"],["は"],["真実","しんじつ"],["で"],["ある"],["。"],["その"],["人","ひと"],["が"],["、"],["あなた"],["がた"],["に"],["も"],["信じさせる","しんじさせる"],["ため"],["に"],["、"],["真実","しんじつ"],["を"],["話す","はなす"],["と"],["いう"],["こと"],["を"],["よく"],["知って","しって"],["いる"],["ので"],["ある"],["。"]]},{"verse":36,"text":"この事が起こったのは、「彼の骨は一つも砕かれない」という聖書のことばが成就するためであった。","tok":[["この"],["事","こと"],["が"],["起こった","おこった"],["の"],["は"],["、"],["「"],["彼","かれ"],["の"],["骨","ほね"],["は"],["一","ひと"],["つ"],["も"],["砕かれない","くだかれない"],["」"],["と"],["いう"],["聖書","せいしょ"],["の"],["ことば"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":37,"text":"また聖書の別のところには、「彼らは自分たちが突き刺した方を見る」と言われているからである。","tok":[["また"],["聖書","せいしょ"],["の"],["別","べつ"],["の"],["ところ"],["に"],["は"],["、"],["「"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["が"],["突き刺した","つきさした"],["方","ほう"],["を"],["見る","みる"],["」"],["と"],["言われて","いわれて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":38,"text":"そのあとで、イエスの弟子ではあったがユダヤ人を恐れてそのことを隠していたアリマタヤのヨセフが、イエスのからだを取りかたづけたいとピラトに願った。それで、ピラトは許可を与えた。そこで彼は来て、イエスのからだを取り降ろした。","tok":[["その"],["あと"],["で"],["、"],["イエス"],["の"],["弟子","でし"],["で"],["は"],["あった"],["が"],["ユダヤ人","ゆだやじん"],["を"],["恐れて","おそれて"],["その"],["こと"],["を"],["隠して","かくして"],["いた"],["アリマタヤ"],["の"],["ヨセフ"],["が"],["、"],["イエス"],["の"],["からだ"],["を"],["取り","とり"],["かたづけたい"],["と"],["ピラト"],["に"],["願った","ねがった"],["。"],["それ"],["で"],["、"],["ピラト"],["は"],["許可","きょか"],["を"],["与えた","あたえた"],["。"],["そこ"],["で"],["彼","かれ"],["は"],["来て","きて"],["、"],["イエス"],["の"],["からだ"],["を"],["取り降ろした","とりおろした"],["。"]]},{"verse":39,"text":"前に、夜イエスのところに来たニコデモも、没薬とアロエを混ぜ合わせたものをおよそ三十キログラムばかり持って、やって来た。","tok":[["前","まえ"],["に"],["、"],["夜","よる"],["イエス"],["の"],["ところ"],["に"],["来た","きた"],["ニコデモ"],["も"],["、"],["没薬","もつやく"],["と"],["アロエ"],["を"],["混ぜ合わせた","まぜあわせた"],["もの"],["を"],["およそ"],["三十","さんじゅう"],["キログラム"],["ばかり"],["持って","もって"],["、"],["やって"],["来た","きた"],["。"]]},{"verse":40,"text":"そこで、彼らはイエスのからだを取り、ユダヤ人の埋葬の習慣に従って、それを香料といっしょに亜麻布で巻いた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["の"],["からだ"],["を"],["取り","とり"],["、"],["ユダヤ人","ゆだやじん"],["の"],["埋葬","まいそう"],["の"],["習慣","しゅうかん"],["に"],["従って","したがって"],["、"],["それ"],["を"],["香料","こうりょう"],["と"],["いっしょ"],["に"],["亜","あ"],["麻布","あざぶ"],["で"],["巻いた","まいた"],["。"]]},{"verse":41,"text":"イエスが十字架につけられた場所に園があって、そこには、まだだれも葬られたことのない新しい墓があった。","t
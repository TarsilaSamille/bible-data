[{"verse":1,"text":"初めに、ことばがあった。ことばは神とともにあった。ことばは神であった。","tok":[["初め","はじめ"],["に"],["、"],["ことば"],["が"],["あった"],["。"],["ことば"],["は"],["神","かみ"],["と"],["とも"],["に"],["あった"],["。"],["ことば"],["は"],["神","かみ"],["で"],["あった"],["。"]]},{"verse":2,"text":"この方は、初めに神とともにおられた。","tok":[["この"],["方","かた"],["は"],["、"],["初め","はじめ"],["に"],["神","かみ"],["と"],["とも"],["に"],["おられた"],["。"]]},{"verse":3,"text":"すべてのものは、この方によって造られた。造られたもので、この方によらずにできたものは一つもない。","tok":[["すべて"],["の"],["もの"],["は"],["、"],["この"],["方","かた"],["によって"],["造られた","つくられた"],["。"],["造られた","つくられた"],["もの"],["で"],["、"],["この"],["方","かた"],["に"],["よらず"],["に"],["できた"],["もの"],["は"],["一","ひと"],["つ"],["も"],["ない"],["。"]]},{"verse":4,"text":"この方にいのちがあった。このいのちは人の光であった。","tok":[["この"],["方","かた"],["に"],["いのち"],["が"],["あった"],["。"],["この"],["いのち"],["は"],["人","ひと"],["の"],["光","ひかり"],["で"],["あった"],["。"]]},{"verse":5,"text":"光はやみの中に輝いている。やみはこれに打ち勝たなかった。","tok":[["光","ひかり"],["は"],["やみ"],["の"],["中","なか"],["に"],["輝いて","かがやいて"],["いる"],["。"],["やみ"],["は"],["これ"],["に"],["打ち勝たなかった","うちかたなかった"],["。"]]},{"verse":6,"text":"神から遣わされたヨハネという人が現れた。","tok":[["神","かみ"],["から"],["遣わされた","つかわされた"],["ヨハネ"],["と"],["いう"],["人","ひと"],["が"],["現れた","あらわれた"],["。"]]},{"verse":7,"text":"この人はあかしのために来た。光についてあかしするためであり、すべての人が彼によって信じるためである。","tok":[["この"],["人","ひと"],["は"],["あかし"],["の"],["ため"],["に"],["来た","きた"],["。"],["光","ひかり"],["について"],["あかし"],["する"],["ため"],["で"],["あり"],["、"],["すべて"],["の"],["人","ひと"],["が"],["彼","かれ"],["によって"],["信じる","しんじる"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"彼は光ではなかった。ただ光についてあかしするために来たのである。","tok":[["彼","かれ"],["は"],["光","ひかり"],["で"],["は"],["なかった"],["。"],["ただ"],["光","ひかり"],["について"],["あかし"],["する"],["ため"],["に"],["来た","きた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"すべての人を照らすそのまことの光が世に来ようとしていた。","tok":[["すべて"],["の"],["人","ひと"],["を"],["照らす","てらす"],["その"],["まこと"],["の"],["光","ひかり"],["が"],["世","よ"],["に"],["来よう","こよう"],["として"],["いた"],["。"]]},{"verse":10,"text":"この方はもとから世におられ、世はこの方によって造られたのに、世はこの方を知らなかった。","tok":[["この"],["方","かた"],["は"],["もと"],["から"],["世","よ"],["に"],
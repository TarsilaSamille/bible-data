[{"verse":1,"text":"イエスはこれらのことを話し終えられると、弟子たちとともに、ケデロンの川筋の向こう側に出て行かれた。そこに園があって、イエスは弟子たちといっしょに、そこに入られた。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["話し","はなし"],["終えられる","おえられる"],["と"],["、"],["弟子","でし"],["たち"],["と"],["とも"],["に"],["、"],["ケデロン"],["の"],["川筋","かわすじ"],["の"],["向こう側","むこうがわ"],["に"],["出て","でて"],["行かれた","いかれた"],["。"],["そこ"],["に"],["園","その"],["が"],["あって"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["いっしょ"],["に"],["、"],["そこ"],["に"],["入られた","はいられた"],["。"]]},{"verse":2,"text":"ところで、イエスを裏切ろうとしていたユダもその場所を知っていた。イエスがたびたび弟子たちとそこで会合されたからである。","tok":[["ところ"],["で"],["、"],["イエス"],["を"],["裏切ろう","うらぎろう"],["として"],["いた"],["ユダ"],["も"],["その"],["場所","ばしょ"],["を"],["知って","しって"],["いた"],["。"],["イエス"],["が"],["たびたび"],["弟子","でし"],["たち"],["と"],["そこ"],["で"],["会合","かいごう"],["された"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"そこで、ユダは一隊の兵士と、祭司長、パリサイ人たちから送られた役人たちを引き連れて、ともしびとたいまつと武器を持って、そこに来た。","tok":[["そこ"],["で"],["、"],["ユダ"],["は"],["一隊","いったい"],["の"],["兵士","へいし"],["と"],["、"],["祭司長","さいしちょう"],["、"],["パリサイ"],["人","にん"],["たち"],["から"],["送られた","おくられた"],["役人","やくにん"],["たち"],["を"],["引き連れて","ひきつれて"],["、"],["ともしび"],["と"],["たいまつ"],["と"],["武器","ぶき"],["を"],["持って","もって"],["、"],["そこ"],["に"],["来た","きた"],["。"]]},{"verse":4,"text":"イエスは自分の身に起ころうとするすべてのことを知っておられたので、出て来て、「だれを捜すのか」と彼らに言われた。","tok":[["イエス"],["は"],["自分","じぶん"],["の"],["身","み"],["に"],["起ころう","おころう"],["と"],["する"],["すべて"],["の"],["こと"],["を"],["知って","しって"],["おられた"],["ので"],["、"],["出て","でて"],["来て","きて"],["、"],["「"],["だれ"],["を"],["捜す","さがす"],["の"],["か"],["」"],["と"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"]]},{"verse":5,"text":"彼らは、「ナザレ人イエスを」と答えた。イエスは彼らに「それはわたしです」と言われた。イエスを裏切ろうとしていたユダも彼らといっしょに立っていた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["「"],["ナザレ人","なざれにん"],["イエス"],["を"],["」"],["と"],["答えた","こたえた"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["「"],["それ"],["は"],["わたし"],["です"],["」"],["と"],["言われた","いわれた"],["。"],["イエス"],["を"],["裏切ろう","うらぎろう"],["として"],["いた"],["ユダ"],["も"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":6,"text":"イエスが彼らに、「それはわたしです」と言われたとき、彼らはあとずさりし、そして地に倒れた。","tok":[["イエス"],["が"],["彼","かれ"],["ら"],["に"],["、"],["「"],["それ"],["は"],["わたし"],["です"],["」"],["と"],["言われた","いわれた"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["あとずさり"],["し"],["、"],["そして"],["地","ち"],["に"],["倒れた","たおれた"],["。"]]},{"verse":7,"text":"そこで、イエスがもう一度、「だれを捜すのか」と問われると、彼らは「ナザレ人イエスを」と言った。","tok":[["そこ"],["で"],["、"],["イエス"],["が"],["もう"],["一度","いちど"],["、"],["「"],["だれ"],["を"],["捜す","さがす"],["の"],["か"],["」"],["と"],["問われる","とわれる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["「"],["ナザレ人","なざれにん"],["イエス"],["を"],["」"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"イエスは答えられた。「それはわたしだと、あなたがたに言ったでしょう。もしわたしを捜しているのなら、この人たちはこのままで去らせなさい。」","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["それ"],["は"],["わたし"],["だ"],["と"],["、"],["あなた"],["がた"],["に"],["言ったでしょう","いったでしょう"],["。"],["もし"],["わたし"],["を"],["捜して","さがして"],["いる"],["の"],["なら"],["、"],["この"],["人","ひと"],["たち"],["は"],["この"],["まま"],["で"],["去らせ","さらせ"],["なさい"],["。"],["」"]]},{"verse":9,"text":"それは、「あなたがわたしに下さった者のうち、ただのひとりをも失いませんでした」とイエスが言われたことばが実現するためであった。","tok":[["それ"],["は"],["、"],["「"],["あなた"],["が"],["わたし"],["に"],["下さった","くださった"],["者","もの"],["の"],["うち"],["、"],["ただ"],["の"],["ひとり"],["を"],["も"],["失いませんでした","うしないませんでした"],["」"],["と"],["イエス"],["が"],["言われた","いわれた"],["ことば"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":10,"text":"シモン・ペテロは、剣を持っていたが、それを抜き、大祭司のしもべを撃ち、右の耳を切り落とした。そのしもべの名はマルコスであった。","tok":[["シモン"],["・"],["ペテロ"],["は"],["、"],["剣","けん"],["を"],["持って","もって"],["いた"],["が"],["、"],["それ"],["を"],["抜き","ぬき"],["、"],["大","だい"],["祭司","さいし"],["の"],["しもべ"],["を"],["撃ち","うち"],["、"],["右","みぎ"],["の"],["耳","みみ"],["を"],["切り落とした","きりおとした"],["。"],["その"],["しもべ"],["の"],["名","な"],["は"],["マルコス"],["で"],["あった"],["。"]]},{"verse":11,"text":"そこで、イエスはペテロに言われた。「剣をさやに収めなさい。父がわたしに下さった杯を、どうして飲まずにいられよう。」","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["ペテロ"],["に"],["言われた","いわれた"],["。"],["「"],["剣","けん"],["を"],["さや"],["に"],["収め","おさめ"],["なさい"],["。"],["父","ちち"],["が"],["わたし"],["に"],["下さった","くださった"],["杯","さかずき"],["を"],["、"],["どう"],["して"],["飲まず","のまず"],["に"],["いられよう"],["。"],["」"]]},{"verse":12,"text":"そこで、一隊の兵士と千人隊長、それにユダヤ人から送られた役人たちは、イエスを捕らえて縛り、","tok":[["そこ"],["で"],["、"],["一隊","いったい"],["の"],["兵士","へいし"],["と"],["千人","せんにん"],["隊長","たいちょう"],["、"],["それ"],["に"],["ユダヤ人","ゆだやじん"],["から"],["送られた","おくられた"],["役人","やくにん"],["たち"],["は"],["、"],["イエス"],["を"],["捕らえて","とらえて"],["縛り","しばり"],["、"]]},{"verse":13,"text":"まずアンナスのところに連れて行った。彼がその年の大祭司カヤパのしゅうとだったからである。","tok":[["まず"],["アンナス"],["の"],["ところ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["彼","かれ"],["が"],["その"],["年","とし"],["の"],["大","だい"],["祭司","さいし"],["カヤパ"],["の"],["しゅうと"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"カヤパは、ひとりの人が民に代わって死ぬことが得策である、とユダヤ人に助言した人である。","tok":[["カヤパ"],["は"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["民","たみ"],["に"],["代わって","かわって"],["死ぬ","しぬ"],["こと"],["が"],["得策","とくさく"],["で"],["ある"],["、"],["と"],["ユダヤ人","ゆだやじん"],["に"],["助言","じょげん"],["した"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":15,"text":"シモン・ペテロともうひとりの弟子は、イエスについて行った。この弟子は大祭司の知り合いで、イエスといっしょに大祭司の中庭に入った。","tok":[["シモン"],["・"],["ペテロ"],["と"],["もう"],["ひとり"],["の"],["弟子","でし"],["は"],["、"],["イエス"],["について"],["行った","いった"],["。"],["この"],["弟子","でし"],["は"],["大","だい"],["祭司","さいし"],["の"],["知り合い","しりあい"],["で"],["、"],["イエス"],["と"],["いっしょ"],["に"],["大","だい"],["祭司","さいし"],["の"],["中庭","なかにわ"],["に"],["入った","はいった"],["。"]]},{"verse":16,"text":"しかし、ペテロは外で門のところに立っていた。それで、大祭司の知り合いである、もうひとりの弟子が出て来て、門番の女に話して、ペテロを連れて入った。","tok":[["しかし"],["、"],["ペテロ"],["は"],["外","そと"],["で"],["門","もん"],["の"],["ところ"],["に"],["立って","たって"],["いた"],["。"],["それ"],["で"],["、"],["大","だい"],["祭司","さいし"],["の"],["知り合い","しりあい"],["で"],["ある"],["、"],["もう"],["ひとり"],["の"],["弟子","でし"],["が"],["出て","でて"],["来て","きて"],["、"],["門番","もんばん"],["の"],["女","おんな"],["に"],["話して","はなして"],["、"],["ペテロ"],["を"],["連れて","つれて"],["入った","はいった"],["。"]]},{"verse":17,"text":"すると、門番のはしためがペテロに、「あなたもあの人の弟子ではないでしょうね」と言った。ペテロは、「そんな者ではない」と言った。","tok":[["する"],["と"],["、"],["門番","もんばん"],["の"],["はし"],["ため"],["が"],["ペテロ"],["に"],["、"],["「"],["あなた"],["も"],["あの"],["人","ひと"],["の"],["弟子","でし"],["で"],["は"],["ないでしょう"],["ね"],["」"],["と"],["言った","いった"],["。"],["ペテロ"],["は"],["、"],["「"],["そんな"],["者","もの"],["で"],["は"],["ない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"寒かったので、しもべたちや役人たちは、炭火をおこし、そこに立って暖まっていた。ペテロも彼らといっしょに、立って暖まっていた。","tok":[["寒かった","さむかった"],["ので"],["、"],["しもべ"],["たち"],["や"],["役人","やくにん"],["たち"],["は"],["、"],["炭火","すみび"],["を"],["おこし"],["、"],["そこ"],["に"],["立って","たって"],["暖まって","あたたまって"],["いた"],["。"],["ペテロ"],["も"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["、"],["立って","たって"],["暖まって","あたたまって"],["いた"],["。"]]},{"verse":19,"text":"そこで、大祭司はイエスに、弟子たちのこと、また、教えのことについて尋問した。","tok":[["そこ"],["で"],["、"],["大","だい"],["祭司","さいし"],["は"],["イエス"],["に"],["、"],["弟子","でし"],["たち"],["の"],["こと"],["、"],["また"],["、"],["教え","おしえ"],["の"],["こと"],["について"],["尋問","じんもん"],["した"],["。"]]},{"verse":20,"text":"イエスは彼に答えられた。「わたしは世に向かって公然と話しました。わたしはユダヤ人がみな集まって来る会堂や宮で、いつも教えたのです。隠れて話したことは何もありません。","tok":[["イエス"],["は"],["彼","かれ"],["に"],["答えられた","こたえられた"],["。"],["「"],["わたし"],["は"],["世","よ"],["に"],["向かって","むかって"],["公然","こうぜん"],["と"],["話しました","はなしました"],["。"],["わたし"],["は"],["ユダヤ人","ゆだやじん"],["が"],["みな"],["集まって","あつまって"],["来る","くる"],["会堂","かいどう"],["や"],["宮","みや"],["で"],["、"],["いつ"],["も"],["教えた","おしえた"],["の"],["です"],["。"],["隠れて","かくれて"],["話した","はなした"],["こと"],["は"],["何","なん"],["も"],["ありません"],["。"]]},{"verse":21,"text":"なぜ、あなたはわたしに尋ねるのですか。わたしが人々に何を話したかは、わたしから聞いた人たちに尋ねなさい。彼らならわたしが話した事がらを知っています。」","tok":[["なぜ"],["、"],["あなた"],["は"],["わたし"],["に"],["尋ねる","たずねる"],["の"],["です"],["か"],["。"],["わたし"],["が"],["人々","ひとびと"],["に"],["何","なん"],["を"],["話した","はなした"],["か"],["は"],["、"],["わたし"],["から"],["聞いた","きいた"],["人","ひと"],["たち"],["に"],["尋ね","たずね"],["なさい"],["。"],["彼","かれ"],["ら"],["なら"],["わたし"],["が"],["話した","はなした"],["事がら","ことがら"],["を"],["知って","しって"],["います"],["。"],["」"]]},{"verse":22,"text":"イエスがこう言われたとき、そばに立っていた役人のひとりが、「大祭司にそのような答え方をするのか」と言って、平手でイエスを打った。","tok":[["イエス"],["が"],["こう"],["言われた","いわれた"],["とき"],["、"],["そば"],["に"],["立って","たって"],["いた"],["役人","やくにん"],["の"],["ひとり"],["が"],["、"],["「"],["大","だい"],["祭司"
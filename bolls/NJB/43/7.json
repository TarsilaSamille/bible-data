[{"verse":1,"text":"その後、イエスはガリラヤを巡っておられた。それは、ユダヤ人たちがイエスを殺そうとしていたので、ユダヤを巡りたいとは思われなかったからである。","tok":[["その"],["後","ご"],["、"],["イエス"],["は"],["ガリラヤ"],["を"],["巡って","めぐって"],["おられた"],["。"],["それ"],["は"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["イエス"],["を"],["殺そう","ころそう"],["として"],["いた"],["ので"],["、"],["ユダヤ"],["を"],["巡りたい","めぐりたい"],["と"],["は"],["思われなかった","おもわれなかった"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"さて、仮庵の祭りというユダヤ人の祝いが近づいていた。","tok":[["さて"],["、"],["仮庵","かりあん"],["の"],["祭り","まつり"],["と"],["いう"],["ユダヤ人","ゆだやじん"],["の"],["祝い","いわい"],["が"],["近づいて","ちかづいて"],["いた"],["。"]]},{"verse":3,"text":"そこで、イエスの兄弟たちはイエスに向かって言った。「あなたの弟子たちもあなたがしているわざを見ることができるように、ここを去ってユダヤに行きなさい。","tok":[["そこ"],["で"],["、"],["イエス"],["の"],["兄弟","きょうだい"],["たち"],["は"],["イエス"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["あなた"],["の"],["弟子","でし"],["たち"],["も"],["あなた"],["が"],["して"],["いる"],["わざ"],["を"],["見る","みる"],["こと"],["が"],["できる"],["よう"],["に"],["、"],["ここ"],["を"],["去って","さって"],["ユダヤ"],["に"],["行き","いき"],["なさい"],["。"]]},{"verse":4,"text":"自分から公の場に出たいと思いながら、隠れた所で事を行う者はありません。あなたがこれらの事を行うのなら、自分を世に現しなさい。」","tok":[["自分","じぶん"],["から"],["公","おおやけ"],["の"],["場","ば"],["に"],["出たい","でたい"],["と"],["思い","おもい"],["ながら"],["、"],["隠れた","かくれた"],["所","ところ"],["で"],["事","こと"],["を"],["行う","おこなう"],["者","もの"],["は"],["ありません"],["。"],["あなた"],["が"],["これ"],["ら"],["の"],["事","こと"],["を"],["行う","おこなう"],["の"],["なら"],["、"],["自分","じぶん"],["を"],["世","よ"],["に"],["現し","あらわし"],["なさい"],["。"],["」"]]},{"verse":5,"text":"兄弟たちもイエスを信じていなかったのである。","tok":[["兄弟","きょうだい"],["たち"],["も"],["イエス"],["を"],["信じて","しんじて"],["いなかった"],["ので"],["ある"],["。"]]},{"verse":6,"text":"そこでイエスは彼らに言われた。「わたしの時はまだ来ていません。しかし、あなたがたの時はいつでも来ているのです。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["の"],["時","とき"],["は"],["まだ"],["来て","きて"],["いません"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["時","とき"],["は"],["いつ"],["で"],["も"],["来て","きて"],["いる"],["の"],["です"],["。"]]},{"verse":7,"text":"世はあなたがたを憎むことはできません。しかしわたしを憎んでいます。わたしが、世について、その行いが悪いことをあかしするからです。","tok":[["世","よ"],["は"],["あなた"],["がた"],["を"],["憎む","にくむ"],["こと"],["は"],["できません"],["。"],["しかし"],["わたし"],["を"],["憎んで","にくんで"],["います"],["。"],["わたし"],["が"],["、"],["世","よ"],["について"],["、"],["その"],["行い","おこない"],["が"],["悪い","わるい"],["こと"],["を"],["あかし"],["する"],["から"],["です"],["。"]]},{"verse":8,"text":"あなたがたは祭りに上って行きなさい。わたしはこの祭りには行きません。わたしの時がまだ満ちていないからです。」","tok":[["あなた"],["がた"],["は"],["祭り","まつり"],["に"],["上って","のぼって"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["この"],["祭り","まつり"],["に"],["は"],["行きません","いきません"],["。"],["わたし"],["の"],["時","とき"],["が"],["まだ"],["満ちて","みちて"],["いない"],["から"],["です"],["。"],["」"]]},{"verse":9,"text":"こう言って、イエスはガリラヤにとどまられた。","tok":[["こう"],["言って","いって"],["、"],["イエス"],["は"],["ガリラヤ"],["に"],["とどまられた"],["。"]]},{"verse":10,"text":"しかし、兄弟たちが祭りに上ったとき、イエスご自身も、公にではなく、いわば内密に上って行かれた。","tok":[["しかし"],["、"],["兄弟","きょうだい"],["たち"],["が"],["祭り","まつり"],["に"],["上った","のぼった"],["とき"],["、"],["イエス"],["ご自身","ごじしん"],["も"],["、"],["公","おおやけ"],["に"],["で"],["は"],["なく"],["、"],["いわば"],["内密","ないみつ"],["に"],["上って","のぼって"],["行かれた","いかれた"],["。"]]},{"verse":11,"text":"ユダヤ人たちは、祭りのとき、「あの方はどこにおられるのか」と言って、イエスを捜していた。","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["祭り","まつり"],["の"],["とき"],["、"],["「"],["あの"],["方","かた"],["は"],["どこ"],["に"],["おられる"],["の"],["か"],["」"],["と"],["言って","いって"],["、"],["イエス"],["を"],["捜して","さがして"],["いた"],["。"]]},{"verse":12,"text":"そして群衆の間には、イエスについて、いろいろとひそひそ話がされていた。「良い人だ」と言う者もあり、「違う。群衆を惑わしているのだ」と言う者もいた。","tok":[["そして"],["群衆","ぐんしゅう"],["の"],["間","あいだ"],["に"],["は"],["、"],["イエス"],["について"],["、"],["いろいろ"],["と"],["ひそひそ"],["話","はなし"],["が"],["されて"],["いた"],["。"],["「"],["良い","よい"],["人","ひと"],["だ"],["」"],["と"],["言う","いう"],["者","もの"],["も"],["あり"],["、"],["「"],["違う","ちがう"],["。"],["群衆","ぐんしゅう"],["を"],["惑わして","まどわして"],["いる"],["の"],["だ"],["」"],["と"],["言う","いう"],["者","もの"],["も"],["いた"],["。"]]},{"verse":13,"text":"しかし、ユダヤ人たちを恐れたため、イエスについて公然と語る者はひとりもいなかった。","tok":[["しかし"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["を"],["恐れた","おそれた"],["ため"],["、"],["イエス"],["について"],["公然","こうぜん"],["と"],["語る","かたる"],["者","もの"],["は"],["ひとり"],["も"],["いなかった"],["。"]]},{"verse":14,"text":"しかし、祭りもすでに中ごろになったとき、イエスは宮に上って教え始められた。","tok":[["しかし"],["、"],["祭り","まつり"],["も"],["すでに"],["中ごろ","なかごろ"],["に"],["なった"],["とき"],["、"],["イエス"],["は"],["宮","みや"],["に"],["上って","のぼって"],["教え","おしえ"],["始められた","はじめられた"],["。"]]},{"verse":15,"text":"ユダヤ人たちは驚いて言った。「この人は正規に学んだことがないのに、どうして学問があるのか。」","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["驚いて","おどろいて"],["言った","いった"],["。"],["「"],["この"],["人","ひと"],["は"],["正規","せいき"],["に"],["学んだ","まなんだ"],["こと"],["が"],["ない"],["のに"],["、"],["どう"],["して"],["学問","がくもん"],["が"],["ある"],["の"],["か"],["。"],["」"]]},{"verse":16,"text":"そこでイエスは彼らに答えて言われた。「わたしの教えは、わたしのものではなく、わたしを遣わした方のものです。","tok":[["そこ"],["で"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["わたし"],["の"],["教え","おしえ"],["は"],["、"],["わたし"],["の"],["もの"],["で"],["は"],["なく"],["、"],["わたし"],["を"],["遣わした","つかわした"],["方","ほう"],["の"],["もの"],["です"],["。"]]},{"verse":17,"text":"だれでも神のみこころを行おうと願うなら、その人には、この教えが神から出たものか、わたしが自分から語っているのかがわかります。","tok":[["だれ"],["で"],["も"],["神","かみ"],["のみ"],["こころ"],["を"],["行おう","おこなおう"],["と"],["願うなら","ねがうなら"],["、"],["その"],["人","ひと"],["に"],["は"],["、"],["この"],["教え","おしえ"],["が"],["神","かみ"],["から"],["出た","でた"],["もの"],["か"],["、"],["わたし"],["が"],["自分","じぶん"],["から"],["語って","かたって"],["いる"],["の"],["か"],["が"],["わかります"],["。"]]},{"verse":18,"text":"自分から語る者は、自分の栄光を求めます。しかし自分を遣わした方の栄光を求める者は真実であり、その人には不正がありません。","tok":[["自分","じぶん"],["から"],["語る","かたる"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["栄光","えいこう"],["を"],["求めます","もとめます"],["。"],["しかし"],["自分","じぶん"],["を"],["遣わした","つかわした"],["方","ほう"],["の"],["栄光","えいこう"],["を"],["求める","もとめる"],["者","もの"],["は"],["真実","しんじつ"],["で"],["あり"],["、"],["その"],["人","ひと"],["に"],["は"],["不正","ふせい"],["が"],["ありません"],["。"]]},{"verse":19,"text":"モーセがあなたがたに律法を与えたではありませんか。それなのに、あなたがたはだれも、律法を守っていません。あなたがたは、なぜわたしを殺そうとするのですか。」","tok":[["モーセ"],["が"],["あなた"],["がた"],["に"],["律法","りっぽう"],["を"],["与えたで","あたえたで"],["は"],["ありません"],["か"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["だれ"],["も"],["、"],["律法","りっぽう"],["を"],["守って","まも
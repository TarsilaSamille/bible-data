,["食べた","たべた"],["が"],["、"],["死にました","しにました"],["。"]]},{"verse":50,"text":"しかし、これは天から下って来たパンで、それを食べると死ぬことがないのです。","tok":[["しかし"],["、"],["これ"],["は"],["天","てん"],["から"],["下って","くだって"],["来た","きた"],["パン"],["で"],["、"],["それ"],["を"],["食べる","たべる"],["と"],["死ぬ","しぬ"],["こと"],["が"],["ない"],["の"],["です"],["。"]]},{"verse":51,"text":"わたしは、天から下って来た生けるパンです。だれでもこのパンを食べるなら、永遠に生きます。またわたしが与えようとするパンは、世のいのちのための、わたしの肉です。」","tok":[["わたし"],["は"],["、"],["天","てん"],["から"],["下って","くだって"],["来た","きた"],["生ける","いける"],["パン"],["です"],["。"],["だれ"],["で"],["も"],["この"],["パン"],["を"],["食べるなら","たべるなら"],["、"],["永遠","えいえん"],["に"],["生きます","いきます"],["。"],["また"],["わたし"],["が"],["与えよう","あたえよう"],["と"],["する"],["パン"],["は"],["、"],["世","よ"],["の"],["いのち"],["の"],["ため"],["の"],["、"],["わたし"],["の"],["肉","にく"],["です"],["。"],["」"]]},{"verse":52,"text":"すると、ユダヤ人たちは、「この人は、どのようにしてその肉を私たちに与えて食べさせることができるのか」と言って互いに議論し合った。","tok":[["する"],["と"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["「"],["この"],["人","ひと"],["は"],["、"],["どの"],["よう"],["に"],["して"],["その"],["肉","にく"],["を"],["私たち","わたしたち"],["に"],["与えて","あたえて"],["食べさせる","たべさせる"],["こと"],["が"],["できる"],["の"],["か"],["」"],["と"],["言って","いって"],["互い","たがい"],["に"],["議論","ぎろん"],["し"],["合った","あった"],["。"]]},{"verse":53,"text":"イエスは彼らに言われた。「まことに、まことに、あなたがたに告げます。人の子の肉を食べ、またその血を飲まなければ、あなたがたのうちに、いのちはありません。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["人","ひと"],["の"],["子","こ"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["また"],["その"],["血","ち"],["を"],["飲まなければ","のまなければ"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["いのち"],["は"],["ありません"],["。"]]},{"verse":54,"text":"わたしの肉を食べ、わたしの血を飲む者は、永遠のいのちを持っています。わたしは終わりの日にその人をよみがえらせます。","tok":[["わたし"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["わたし"],["の"],["血","ち"],["を"],["飲む","のむ"],["者","もの"],["は"],["、"],["永遠","えいえん"],["の"],["いのち"],["を"],["持って","もって"],["います"],["。"],["わたし"],["は"],["終わり","おわり"],["の"],["日","ひ"],["に"],["その"],["人","ひと"],["を"],["よみがえらせます"],["。"]]},{"verse":55
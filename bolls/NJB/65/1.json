[{"verse":1,"text":"イエス・キリストのしもべであり、ヤコブの兄弟であるユダから、父なる神にあって愛され、イエス・キリストのために守られている、召された方々へ。","tok":[["イエス"],["・"],["キリスト"],["の"],["しもべ"],["で"],["あり"],["、"],["ヤコブ"],["の"],["兄弟","きょうだい"],["で"],["ある"],["ユダ"],["から"],["、"],["父","ちち"],["なる"],["神","かみ"],["に"],["あって"],["愛され","あいされ"],["、"],["イエス"],["・"],["キリスト"],["の"],["ため"],["に"],["守られて","まもられて"],["いる"],["、"],["召された","めされた"],["方々","かたがた"],["へ"],["。"]]},{"verse":2,"text":"どうか、あわれみと平安と愛が、あなたがたの上に、ますます豊かにされますように。","tok":[["どう"],["か"],["、"],["あわれみ"],["と"],["平安","へいあん"],["と"],["愛","あい"],["が"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["、"],["ますます"],["豊か","ゆたか"],["に"],["されます"],["よう"],["に"],["。"]]},{"verse":3,"text":"愛する人々。私はあなたがたに、私たちがともに受けている救いについて手紙を書こうとして、あらゆる努力をしていましたが、聖徒にひとたび伝えられた信仰のために戦うよう、あなたがたに勧める手紙を書く必要が生じました。","tok":[["愛する","あいする"],["人々","ひとびと"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["、"],["私たち","わたしたち"],["が"],["とも"],["に"],["受けて","うけて"],["いる"],["救い","すくい"],["について"],["手紙","てがみ"],["を"],["書こう","かこう"],["として"],["、"],["あらゆる"],["努力","どりょく"],["を"],["して"],["いました"],["が"],["、"],["聖徒","せいと"],["に"],["ひとたび"],["伝えられた","つたえられた"],["信仰","しんこう"],["の"],["ため"],["に"],["戦う","たたかう"],["よう"],["、"],["あなた"],["がた"],["に"],["勧める","すすめる"],["手紙","てがみ"],["を"],["書く","かく"],["必要","ひつよう"],["が"],["生じました","しょうじました"],["。"]]},{"verse":4,"text":"というのは、ある人々が、ひそかに忍び込んで来たからです。彼らは、このようなさばきに会うと昔から前もってしるされている人々で、不敬虔な者であり、私たちの神の恵みを放縦に変えて、私たちの唯一の支配者であり主であるイエス・キリストを否定する人たちです。","tok":[["と"],["いう"],["の"],["は"],["、"],["ある"],["人々","ひとびと"],["が"],["、"],["ひそか"],["に"],["忍び込んで","しのびこんで"],["来た","きた"],["から"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["この"],["よう"],["な"],["さばき"],["に"],["会う","あう"],["と"],["昔","むかし"],["から"],["前もって","まえもって"],["しるされて"],["いる"],["人々","ひとびと"],["で"],["、"],["不","ふ"],["敬虔","けいけん"],["な"],["者","もの"],["で"],["あり"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["恵み","めぐみ"],["を"],["放縦","ほうしょう"],["に"],["変えて","かえて"],["、"],["私たち","わたしたち"],["の"],["唯一","ゆいいつ"],["の"],["支配者","しはいしゃ"],["で"],["あり"],["主","ぬし"],["で"],["ある"],["イエス"],["・"],["キリスト"],["を"],["否定","ひてい"],["する"],["人","ひと"],["たち"],["です"],["。"]]},{"verse":5,"text":"あなたがたは、すべてのことをすっかり知っているにしても、私はあなたがたに思い出させたいことがあるのです。それは主が、民をエジプトの地から救い出し、次に、信じない人々を滅ぼされたということです。","tok":[["あなた"],["がた"],["は"],["、"],["すべて"],["の"],["こと"],["を"],["すっかり"],["知って","しって"],["いる"],["に"],["して"],["も"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["思い出させたい","おもいださせたい"],["こと"],["が"],["ある"],["の"],["です"],["。"],["それ"],["は"],["主","ぬし"],["が"],["、"],["民","みん"],["を"],["エジプト"],["の"],["地","ち"],["から"],["救い出し","すくいだし"],["、"],["次","つぎ"],["に"],["、"],["信じない","しんじない"],["人々","ひとびと"],["を"],["滅ぼされた","ほろぼされた"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":6,"text":"また、主は、自分の領域を守らず、自分のおるべき所を捨てた御使いたちを、大いなる日のさばきのために、永遠の束縛をもって、暗やみの下に閉じ込められました。","tok":[["また"],["、"],["主","ぬし"],["は"],["、"],["自分","じぶん"],["の"],["領域","りょういき"],["を"],["守らず","まもらず"],["、"],["自分","じぶん"],["の"],["おるべき"],["所","ところ"],["を"],["捨てた","すてた"],["御使い","おつかい"],["たち"],["を"],["、"],["大いなる","おおいなる"],["日","ひ"],["の"],["さばき"],["の"],["ため"],["に"],["、"],["永遠","えいえん"],["の"],["束縛","そくばく"],["を"],["もって"],["、"],["暗やみ","くらやみ"],["の"],["下","した"],["に"],["閉じ込められました","とじこめられました"],["。"]]},{"verse":7,"text":"また、ソドム、ゴモラおよび周囲の町々も彼らと同じように、好色にふけり、不自然な肉欲を追い求めたので、永遠の火の刑罰を受けて、みせしめにされています。","tok":[["また"],["、"],["ソドム"],["、"],["ゴモラ"],["および"],["周囲","しゅうい"],["の"],["町々","まちまち"],["も"],["彼","かれ"],["ら"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["好色","こうしょく"],["に"],["ふけり"],["、"],["不自然","ふしぜん"],["な"],["肉欲","にくよく"],["を"],["追い求めた","おいもとめた"],["ので"],["、"],["永遠","えいえん"],["の"],["火","ひ"],["の"],["刑罰","けいばつ"],["を"],["受けて","うけて"],["、"],["みせしめ"],["に"],["されて"],["います"],["。"]]},{"verse":8,"text":"それなのに、この人たちもまた同じように、夢見る者であり、肉体を汚し、権威ある者を軽んじ、栄えある者をそしっています。","tok":[["それ"],["な"],["のに"],["、"],["この"],["人","ひと"],["たち"],["も"],["また"],["同じ","おなじ"],["よう"],["に"],["、"],["夢","ゆめ"],["見る","みる"],["者","もの"],["で"],["あり"],["、"],["肉体","にくたい"],["を"],["汚し","よごし"],["、"],["権威","けんい"],["ある"],["者","もの"],["を"],["軽んじ","かろんじ"],["、"],["栄え","はえ"],["ある"],["者","もの"],["を"],["そしって"],["います"],["。"]]},{"verse":9,"text":"御使いのかしらミカエルは、モーセのからだについて、悪魔と論じ、言い争ったとき、あえて相手をのの
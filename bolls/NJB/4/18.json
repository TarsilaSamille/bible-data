[{"verse":1,"text":"そこで、主はアロンに言われた。「あなたと、あなたとともにいるあなたの子たちと、あなたの父の家の者たちは、聖所にかかわる咎を負わなければならない。そしてあなたと、あなたとともにいるあなたの子たちが、あなたがたの祭司職にかかわる咎を負わなければならない。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["アロン"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["と"],["、"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["子","こ"],["たち"],["と"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["たち"],["は"],["、"],["聖","せい"],["所","しょ"],["に"],["かかわる"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"],["そして"],["あなた"],["と"],["、"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["子","こ"],["たち"],["が"],["、"],["あなた"],["がた"],["の"],["祭司","さいし"],["職","しょく"],["に"],["かかわる"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":2,"text":"しかし、あなたの父祖の部族であるレビ族のあなたの身内の者たちも、あなたに近づけよ。彼らがあなたに配属され、あかしの天幕の前で、あなたと、あなたとともにいるあなたの子たちに仕えるためである。","tok":[["しかし"],["、"],["あなた"],["の"],["父祖","ふそ"],["の"],["部族","ぶぞく"],["で"],["ある"],["レビ族","れびぞく"],["の"],["あなた"],["の"],["身内","みうち"],["の"],["者","もの"],["たち"],["も"],["、"],["あなた"],["に"],["近づけ","ちかづけ"],["よ"],["。"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["配属","はいぞく"],["され"],["、"],["あかし"],["の"],["天幕","てんまく"],["の"],["前","まえ"],["で"],["、"],["あなた"],["と"],["、"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["子","こ"],["たち"],["に"],["仕える","つかえる"],["ため"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼らはあなたのための任務と、天幕全体の任務を果たすのである。しかし彼らは、聖所の器具と祭壇とに、近づいてはならない。彼らも、あなたがたも、死ぬことのないためである。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["ため"],["の"],["任務","にんむ"],["と"],["、"],["天幕","てんまく"],["全体","ぜんたい"],["の"],["任務","にんむ"],["を"],["果たす","はたす"],["ので"],["ある"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["、"],["聖","せい"],["所","しょ"],["の"],["器具","きぐ"],["と"],["祭壇","さいだん"],["と"],["に"],["、"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["も"],["、"],["あなた"],["がた"],["も"],["、"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼らがあなたに配属され、天幕の奉仕のすべてにかかわる会見の天幕の任務を果たす。ほかの者があなたがたに近づいてはならない。","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["に"],["配属","はいぞく"],["され"],["、"],["天幕","てんまく"],["の"],["奉仕","ほうし"],["の"],["すべて"],["に"],["かかわる"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["任務","にんむ"],["を"],["果たす","はたす"],["。"],["ほか"],["の"],["者","もの"],["が"],["あなた"],["がた"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"あなたがたが聖所の任務と祭壇の任務を果たすなら、イスラエル人に再び激しい怒りが下ることはない。","tok":[["あなた"],["がた"],["が"],["聖","せい"],["所","しょ"],["の"],["任務","にんむ"],["と"],["祭壇","さいだん"],["の"],["任務","にんむ"],["を"],["果たすなら","はたすなら"],["、"],["イスラエル"],["人","にん"],["に"],["再び","ふたたび"],["激しい","はげしい"],["怒り","いかり"],["が"],["下る","くだる"],["こと"],["は"],["ない"],["。"]]},{"verse":6,"text":"今ここに、わたしは、あなたがたの同族レビ人をイスラエル人の中から取り、会見の天幕の奉仕をするために、彼らを主にささげられたあなたがたへの贈り物とする。","tok":[["今","いま"],["ここ"],["に"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["同族","どうぞく"],["レビ人","れびにん"],["を"],["イスラエル"],["人","にん"],["の"],["中","なか"],["から"],["取り","とり"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["奉仕","ほうし"],["を"],["する"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["主に","おもに"],["ささげられた"],["あなた"],["が"],["たへ"],["の"],["贈り物","おくりもの"],["と"],["する"],["。"]]},{"verse":7,"text":"あなたと、あなたとともにいるあなたの子たちは、祭壇に関するすべてのことや、垂れ幕の内側のことについてのあなたがたの祭司職を守り、奉仕しなければならない。わたしはあなたがたの祭司職を賜物の奉仕として与える。ほかの者で近づく者は死ななければならない。」","tok":[["あなた"],["と"],["、"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["子","こ"],["たち"],["は"],["、"],["祭壇","さいだん"],["に"],["関する","かんする"],["すべて"],["の"],["こと"],["や"],["、"],["垂れ幕","たれまく"],["の"],["内側","うちがわ"],["の"],["こと"],["について"],["の"],["あなた"],["がた"],["の"],["祭司","さいし"],["職","しょく"],["を"],["守り","まもり"],["、"],["奉仕","ほうし"],["しなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["祭司","さいし"],["職","しょく"],["を"],["賜物","たまもの"],["の"],["奉仕","ほうし"],["として"],["与える","あたえる"],["。"],["ほか"],["の"],["者","もの"],["で"],["近づく","ちかづく"],["者","もの"],["は"],["死ななければ","しななければ"],["ならない"],["。"],["」"]]},{"verse":8,"text":"主はそれから、アロンに仰せられた。「今、わたしは、わたしへの奉納物にかかわる任務をあなたに与える。わたしはイスラエル人のすべての聖なるささげ物についてこれをあなたに、またあなたの子たちとに、受ける分として与え、永遠の分け前とする。","tok":[["主","ぬし"],["は"],["それ"],["から"],["、"],["アロン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["今","いま"],["、"],["わたし"],["は"],["、"],["わたし"],["へ"],["の"],["奉納物","ほうのうぶつ"],["に"],["かかわる"],["任務","にんむ"],["を"],["あなた"],["に"],["与える","あたえる"],["。"],["わたし"],["は"],["イスラエル"],["人","にん"],["の"],["すべて"],["の"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["について"],["これ"],["を"],["あなた"],["に"],["、"],["また"],["あなた"],["の"],["子","こ"],["たち"],["と"],["に"],["、"],["受ける","うける"],["分","ぶん"],["として"],["与え","あたえ"],["、"],["永遠","えいえん"],["の"],["分け前","わけまえ"],["と"],["する"],["。"]]},{"verse":9,"text":"最も聖なるもの、火によるささげ物のうちで、あなたの分となるものは次のとおりである。最も聖なるものとして、わたしに納めるすべてのささげ物、すなわち穀物のささげ物、罪のためのいけにえ、罪過のためのいけにえ、これらの全部は、あなたとあなたの子たちの分となる。","tok":[["最も","もっとも"],["聖","せい"],["なる"],["もの"],["、"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["の"],["うち"],["で"],["、"],["あなた"],["の"],["分","ぶん"],["と"],["なる"],["もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["最も","もっとも"],["聖","せい"],["なる"],["もの"],["として"],["、"],["わたし"],["に"],["納める","おさめる"],["すべて"],["の"],["ささげ物","ささげもの"],["、"],["すなわち"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["、"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["、"],["これ"],["ら"],["の"],["全部","ぜんぶ"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["たち"],["の"],["分","ぶん"],["と"],["なる"],["。"]]},{"verse":10,"text":"あなたはそれを最も聖なるものとして食べなければならない。ただ男子だけが、それを食べることができる。それはあなたにとって聖なるものである。","tok":[["あなた"],["は"],["それ"],["を"],["最も","もっとも"],["聖","せい"],["なる"],["もの"],["として"],["食べなければ","たべなければ"],["ならない"],["。"],["ただ"],["男子","だんし"],["だけ"],["が"],["、"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["それ"],["は"],["あなた"],["にとって"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"また次の物もあなたの分となる。イスラエル人の贈り物である奉納物、彼らのすべての奉献物、これをわたしはあなたとあなたの息子たち、それにあなたとともにいる娘たちに与えて、永遠の分け前とする。あなたの家にいるきよい者はみな、それを食べることができる。","tok":[["また"],["次","つぎ"],["の"],["物","もの"],["も"],["あなた"],["の"],["分","ぶん"],["と"],["なる"],["。"],["イスラエル"],["人","にん"],["の"],["贈り物","おくりもの"],["で"],["ある"],["奉納物","ほうのうぶつ"],["、"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["奉献物","ほうけんぶつ"],["、"],["これ"],["を"],["わたし"],["は"],["あなた"],["と"],["あなた"],["の"],["息子","むすこ"],["たち"],["、"],["それ"],["に"],["あなた"],["と"],["とも"],["に"],["いる"],["娘","むすめ"],["たち"],["に"],["与えて","あたえて"],["、"],["永遠","えいえん"],["の"],["分け前","わけまえ"],["と"],["する"],["。"],["あなた"],["の"],["家","いえ"],["に"],["いる"],["きよい"],["者","もの"],["は"],["みな"],["、"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"最良の新しい油、最良の新しいぶどう酒と穀物、これらの人々が主に供える初物全部をあなたに与える。","tok":[["最良","さいりょう"],["の"],["新しい","あたらしい"],["油","あぶら"],["、"],["最良","さいりょう"],["の"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["穀物","こくもつ"],["、"],["これ"],["ら"],["の"],["人々","ひとびと"],["が"],["主に","おもに"],["供える","そなえる"],["初物","はつもの"],["全部","ぜんぶ"],["を"],["あなた"],["に"],["与える","あたえる"],["。"]]},{"verse":13,"text":"彼らの国のすべてのものの初なりで、彼らが主に携えて来る物は、あなたのものになる。あなたの家にいるきよい者はだれでも、それを食べることができる。","tok":[["彼","かれ"],["ら"],["の"],["国","くに"],["の"],["すべて"],["の"],["もの"],["の"],["初なり","はつなり"],["で"],["、"],["彼","かれ"],["ら"],["が"],["主に","おもに"],["携えて","たずさえて"],["来る","くる"],["物","もの"],["は"],["、"],["あなた"],["の"],["もの"],["に"],["なる"],["。"],["あなた"],["の"],["家","いえ"],["に"],["いる"],["きよい"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":14,"text":"イスラエルのうちで、聖絶のものはみな、あなたのものになる。","tok":[["イスラエル"],["の"],["うち"],["で"],["、"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["は"],["みな"],["、"],["あなた"],["の"],["もの"],["に"],["なる"],["。"]]},{"verse":15,"text":"人でも、獣でも、すべての肉なるものの最初に生まれるもので主にささげられるものはみな、あなたのものとなる。ただし、人の初子は、必ず贖わなければならない。また、汚れた獣の初子も贖わなければならない。","tok":[["人","ひと"],["で"],["も"],["、"],["獣","けもの"],["で"],["も"],["、"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["の"],["最初","さいしょ"],["に"],["生まれる","うまれる"],["もの"],["で"],["主に","おもに"],["ささげられる"],["もの"],["は"],["みな"],["、"],["あなた"],["の"],["もの"],["と"],["なる"],["。"],["ただし"],["、"],["人","ひと"],["の"],["初子","ういご"],["は"],["、"],["必ず","かならず"],["贖わなければ","あがなわなければ"],["ならない"],["。"],["また"],["、"],["汚れた","よごれた"],["獣","けもの"],["の"],["初子","ういご"],["も"],["贖わなければ","あがなわなければ"],["ならない"],["。"]]},{"verse":16,"text":"その贖いの代金として、生後一か月以上は聖所のシェケルの評価によって銀五シェケルで贖わなければならない。一シェケルは二十ゲラである。","tok":[["その"],["贖い","あがない"],["の"],["代金","だいきん"],["として"],["、"],["生後","せいご"],["一","いち"],["か月","かげつ"],["以上","いじょう"],["は"],["聖","せい"],["所","しょ"],["の"],["シェケル"],["の"],["評価","ひょうか"],["によって"],["銀","ぎん"],["五","ご"],["シェケル"],["で"],["贖わなければ","あがなわなければ"],["ならない"],["。"],["一","いち"],["シェケル"],["は"],["二十","にじゅう"],["ゲラ"],["で"],["ある"],["。"]]},{"verse":17,"text":"ただし、牛の初子、または羊の初子、あるいはやぎの初子は贖ってはならない。これらは聖なるものであるからである。あなたはそれらの血を祭壇に振りかけ、その脂肪を火によるささげ物、主へのなだめのかおりとして、焼いて煙にしなければならない。","tok":[["ただし"],["、"],["牛","うし"],["の"],["初子","ういご"],["、"],["また"],["は"],["羊","ひつじ"],["の"],["初子","ういご"],["、"],["あるいは"],["やぎ"],["の"],["初子","ういご"],["は"],["贖って","あがなって"],["は"],["ならない"],["。"],["これ"],["ら"],["は"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["から"],["で"],["ある"],["。"],["あなた"],["は"],["それ"],["ら"],["の"],["血","ち"],["を"],["祭壇","さいだん"],["に"],["振りかけ","ふりかけ"],["、"],["その"],["脂肪","しぼう"],["を"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["、"],["主","ぬし"],["へ"],["の"],["なだめ"],["の"],["かおり"],["として"],["、"],["焼いて","やいて"],["煙","けむり"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":18,"text":"その肉はあなたのものとなる。それは奉献物の胸や右のもものようにあなたのものとなる。","tok":[["その"],["肉","にく"],["は"],["あなた"],["の"],["もの"],["と"],["なる"],["。"],["それ"],["は"],["奉献物","ほうけんぶつ"],["の"],["胸","むね"],["や"],["右","みぎ"],["の"],["もも"],["の"],["よう"],["に"],["あなた"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":19,"text":"イスラエル人が主に供える聖なる奉納物をみな、わたしは、あなたとあなたの息子たちと、あなたとともにいるあなたの娘たちに与えて、永遠の分け前とする。それは、主の前にあって、あなたとあなたの子孫に対する永遠の塩の契約となる。」","tok":[["イスラエル"],["人","にん"],["が"],["主に","おもに"],["供える","そなえる"],["聖","せい"],["なる"],["奉納物","ほうのうぶつ"],["を"],["みな"],["、"],["わたし"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["息子","むすこ"],["たち"],["と"],["、"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["娘","むすめ"],["たち"],["に"],["与えて","あたえて"],["、"],["永遠","えいえん"],["の"],["分け前","わけまえ"],["と"],["する"],["。"],["それ"],["は"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["あって"],["、"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["に"],["対する","たいする"],["永遠","えいえん"],["の"],["塩","しお"],["の"],["契約","けいやく"],["と"],["なる"],["。"],["」"]]},{"verse":20,"text":"主はまたアロンに仰せられた。「あなたは彼らの国で相続地を持ってはならない。彼らのうちで何の割り当て地をも所有してはならない。イスラエル人の中にあって、わたしがあなたの割り当ての地であり、あ
[{"verse":1,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人に告げて、彼らから、杖を、父の家ごとに一本ずつ、彼らの父祖の家のすべての族長から十二本の杖を、取れ。その杖におのおのの名を書きしるさなければならない。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["、"],["彼","かれ"],["ら"],["から"],["、"],["杖","つえ"],["を"],["、"],["父","ちち"],["の"],["家","いえ"],["ごと"],["に"],["一本","いちぽん"],["ずつ"],["、"],["彼","かれ"],["ら"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["すべて"],["の"],["族長","ぞくちょう"],["から"],["十二本","じゅうにぽん"],["の"],["杖","つえ"],["を"],["、"],["取れ","とれ"],["。"],["その"],["杖","つえ"],["に"],["おのおの"],["の"],["名","な"],["を"],["書きしるさなければ","かきしるさなければ"],["ならない"],["。"]]},{"verse":3,"text":"レビの杖にはアロンの名を書かなければならない。彼らの父祖の家のかしらにそれぞれ一本の杖とするから。","tok":[["レビ"],["の"],["杖","つえ"],["に"],["は"],["アロン"],["の"],["名","な"],["を"],["書かなければ","かかなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["かしら"],["に"],["それぞれ"],["一本","いちぽん"],["の"],["杖","つえ"],["と"],["する"],["から"],["。"]]},{"verse":4,"text":"あなたはそれらを、会見の天幕の中のわたしがそこであなたがたに会うあかしの箱の前に置け。","tok":[["あなた"],["は"],["それ"],["ら"],["を"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["中","なか"],["の"],["わたし"],["が"],["そこ"],["で"],["あなた"],["がた"],["に"],["会う","あう"],["あかし"],["の"],["箱","ばこ"],["の"],["前","まえ"],["に"],["置け","おけ"],["。"]]},{"verse":5,"text":"わたしが選ぶ人の杖は芽を出す。こうしてイスラエル人があなたがたに向かってつぶやく不平をわたし自身が静めよう。」","tok":[["わたし"],["が"],["選ぶ","えらぶ"],["人","ひと"],["の"],["杖","つえ"],["は"],["芽","め"],["を"],["出す","だす"],["。"],["こう"],["して"],["イスラエル"],["人","にん"],["が"],["あなた"],["がた"],["に"],["向かって","むかって"],["つぶやく"],["不平","ふへい"],["を"],["わたし"],["自身","じしん"],["が"],["静めよう","しずめよう"],["。"],["」"]]},{"verse":6,"text":"モーセがイスラエル人にこのように告げたので、彼らの族長たちはみな、父祖の家ごとに、族長ひとりに一本ずつの杖、十二本を彼に渡した。アロンの杖も彼らの杖の中にあった。","tok":[["モーセ"],["が"],["イスラエル"],["人","にん"],["に"],["この"],["よう"],["に"],["告げた","つげた"],["ので"],["、"],["彼","かれ"],["ら"],["の"],["族長","ぞくちょう"],["たち"],["は"],["みな"],["、"],["父祖","ふそ"],["の"],["家","いえ"],["ごと"],["に"],["、"],["族長","ぞくちょう"],["ひとり"],["に"],["一本","いちぽん"],["ずつ"],["の"],["杖","つえ"],["、"],["十二本","じゅうにぽん"],["を"],["彼","かれ"],["に"],["渡した","わたした"],["。"],["アロン"],["の"],["杖","つえ"],["も"],["彼","かれ"],["ら"],["の"],["杖","つえ"],["の"],["中","なか"],["に"],["あった"],["。"]]},{"verse":7,"text":"モーセはそれらの杖を、あかしの天幕の中の主の前に置いた。","tok":[["モーセ"],["は"],["それ"],["ら"],["の"],["杖","つえ"],["を"],["、"],["あかし"],["の"],["天幕","てんまく"],["の"],["中","なか"],["の"],["主","ぬし"],["の"],["前","まえ"],["に"],["置いた","おいた"],["。"]]},{"verse":8,"text":"その翌日、モーセはあかしの天幕に入って行った。すると見よ、レビの家のためのアロンの杖が芽をふき、つぼみを出し、花をつけ、アーモンドの実を結んでいた。","tok":[["その"],["翌日","よくじつ"],["、"],["モーセ"],["は"],["あかし"],["の"],["天幕","てんまく"],["に"],["入って","はいって"],["行った","いった"],["。"],["する"],["と"],["見よ","みよ"],["、"],["レビ"],["の"],["家","いえ"],["の"],["ため"],["の"],["アロン"],["の"],["杖","つえ"],["が"],["芽","め"],["を"],["ふき"],["、"],["つぼみ"],["を"],["出し","だし"],["、"],["花","はな"],["を"],["つけ"],["、"],["アーモンド"],["の"],["実","じつ"],["を"],["結んで","むすんで"],["いた"],["。"]]},{"verse":9,"text":"モーセがその杖をみな、主の前から、すべてのイスラエル人のところに持って来たので、彼らは見分けて、おのおの自分の杖を取った。","tok":[["モーセ"],["が"],["その"],["杖","つえ"],["を"],["みな"],["、"],["主","ぬし"],["の"],["前","まえ"],["から"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["の"],["ところ"],["に"],["持って","もって"],["来た","きた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["見分けて","みわけて"],["、"],["おのおの"],["自分","じぶん"],["の"],["杖","つえ"],["を"],["取った","とった"],["。"]]},{"verse":10,"text":"主はモーセに言われた。「アロンの杖をあかしの箱の前に戻して、逆らう者どもへの戒めのため、しるしとせよ。彼らのわたしに対する不平を全くなくして、彼らが死ぬことのないように。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["アロン"],["の"],["杖","つえ"],["を"],["あかし"],["の"],["箱","ばこ"],["の"],["前","まえ"],["に"],["戻して","もどして"],["、"],["逆らう","さからう"],["者","もの"],["ども"],["へ"],["の"],["戒め","いましめ"],["の"],["ため"],["、"],["しるし"],["と"],["せよ"],["。"],["彼","かれ"],["ら"],["の"],["わたし"],["に"],["対する","たいする"],["不平","ふへい"],["を"],["全く","まったく"],["なくして"],["、"],["彼","かれ"],["ら"],["が"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["よう"],["に"],["。"],["」"]]},{"verse":11,"text":"モーセはそうした。主が命じられたとおりにした。","tok":[["モーセ"],["は"],["そう"],["した"],["。"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"]]},{"verse":12,"text":"しかし、イスラエル人はモーセに言った。「ああ、私たちは死んでしまう。私たちは滅びる。みな滅びる。","tok":[["しかし"],["、"],["イスラエル"],["人","にん"],["は"],["モーセ"],["に"],["言った","いった"],["。"],["「"],["ああ"],["、"],["私たち","わたしたち"],["は"],["死んで","しんで"],["しまう"],["。"],["私たち","わたしたち"],["は"],["滅びる","ほろびる"],["。"],["みな"],["滅びる","ほろびる"],["。"]]},{"verse":13,"text":"主の幕屋にあえて近づく者はだれでも死ななければならないとは。ああ、私たちはみな、死に絶えなければならないのか。」","tok":[["主","ぬし"],["の"],["幕屋","まくや"],["に"],["あえて"],["近づく","ちかづく"],["者","もの"],["は"],["だれ"],["で"],["も"],["死ななければ","しななければ"],["ならない"],["と"],["は"],["。"],["ああ"],["、"],["私たち","わたしたち"],["は"],["みな"],["、"],["死に絶えなければ","しにたえなければ"],["ならない"],["の"],["か"],["。"],["」"]]}]
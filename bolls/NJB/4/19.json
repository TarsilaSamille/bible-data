[{"verse":1,"text":"主はモーセとアロンに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「主が命じて仰せられたおしえの定めは、こうである。イスラエル人に言い、傷がなく、まだくびきの置かれたことのない、完全な赤い雌牛をあなたのところに引いて来させよ。","tok":[["「"],["主","ぬし"],["が"],["命じて","めいじて"],["仰せられた","おおせられた"],["おしえ"],["の"],["定め","さだめ"],["は"],["、"],["こう"],["で"],["ある"],["。"],["イスラエル"],["人","にん"],["に"],["言い","いい"],["、"],["傷","きず"],["が"],["なく"],["、"],["まだ"],["くびき"],["の"],["置かれた","おかれた"],["こと"],["の"],["ない"],["、"],["完全","かんぜん"],["な"],["赤い","あかい"],["雌牛","めうし"],["を"],["あなた"],["の"],["ところ"],["に"],["引いて","ひいて"],["来させよ","きさせよ"],["。"]]},{"verse":3,"text":"あなたがたはそれを祭司エルアザルに渡せ。彼はそれを宿営の外に引き出し、彼の前でほふれ。","tok":[["あなた"],["がた"],["は"],["それ"],["を"],["祭司","さいし"],["エルアザル"],["に"],["渡せ","わたせ"],["。"],["彼","かれ"],["は"],["それ"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["引き出し","ひきだし"],["、"],["彼","かれ"],["の"],["前","まえ"],["で"],["ほふれ"],["。"]]},{"verse":4,"text":"祭司エルアザルは指でその血を取り、会見の天幕の正面に向かってこの血を七たび振りかけよ。","tok":[["祭司","さいし"],["エルアザル"],["は"],["指","ゆび"],["で"],["その"],["血","ち"],["を"],["取り","とり"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["正面","しょうめん"],["に"],["向かって","むかって"],["この"],["血","ち"],["を"],["七","なな"],["たび"],["振りかけよ","ふりかけよ"],["。"]]},{"verse":5,"text":"その雌牛は彼の目の前で焼け。その皮、肉、血をその汚物とともに焼かなければならない。","tok":[["その"],["雌牛","めうし"],["は"],["彼","かれ"],["の"],["目","め"],["の"],["前","まえ"],["で"],["焼け","やけ"],["。"],["その"],["皮","かわ"],["、"],["肉","にく"],["、"],["血","ち"],["を"],["その"],["汚物","おぶつ"],["と"],["とも"],["に"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":6,"text":"祭司は杉の木と、ヒソプと、緋色の糸を取り、それを雌牛の焼けている中に投げ入れる。","tok":[["祭司","さいし"],["は"],["杉","すぎ"],["の"],["木","き"],["と"],["、"],["ヒソプ"],["と"],["、"],["緋色","ひいろ"],["の"],["糸","いと"],["を"],["取り","とり"],["、"],["それ"],["を"],["雌牛","めうし"],["の"],["焼けて","やけて"],["いる"],["中","なか"],["に"],["投げ入れる","なげいれる"],["。"]]},{"verse":7,"text":"祭司は、その衣服を洗い、そのからだに水を浴びよ。その後、宿営に入ることができる。しかしその祭司は夕方まで汚れる。","tok":[["祭司","さいし"],["は"],["、"],["その"],["衣服","いふく"],["を"],["洗い","あらい"],["、"],["その"],["からだ"],["に"],["水","みず"],["を"],["浴び","あび"],["よ"],["。"],["その"],["後","ご"],["、"],["宿営","しゅくえい"],["に"],["入る","はいる"],["こと"],["が"],["できる"],["。"],["しかし"],["その"],["祭司","さいし"],["は"],["夕方","ゆうがた"],["まで"],["汚れる","よごれる"],["。"]]},{"verse":8,"text":"それを焼いた者も、その衣服を水で洗い、からだに水を浴びなければならない。しかし彼も夕方まで汚れる。","tok":[["それ"],["を"],["焼いた","やいた"],["者","もの"],["も"],["、"],["その"],["衣服","いふく"],["を"],["水","みず"],["で"],["洗い","あらい"],["、"],["からだ"],["に"],["水","みず"],["を"],["浴びなければ","あびなければ"],["ならない"],["。"],["しかし"],["彼","かれ"],["も"],["夕方","ゆうがた"],["まで"],["汚れる","よごれる"],["。"]]},{"verse":9,"text":"身のきよい人がその雌牛の灰を集め、宿営の外のきよい所に置き、イスラエル人の会衆のため、汚れをきよめる水を作るために、それを保存しておく。これは罪のきよめのためである。","tok":[["身","み"],["の"],["きよい"],["人","ひと"],["が"],["その"],["雌牛","めうし"],["の"],["灰","はい"],["を"],["集め","あつめ"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["の"],["きよい"],["所","ところ"],["に"],["置き","おき"],["、"],["イスラエル"],["人","にん"],["の"],["会衆","かいしゅう"],["の"],["ため"],["、"],["汚れ","よごれ"],["を"],["きよめる"],["水","みず"],["を"],["作る","つくる"],["ため"],["に"],["、"],["それ"],["を"],["保存","ほぞん"],["して"],["おく"],["。"],["これ"],["は"],["罪","つみ"],["の"],["きよめ"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":10,"text":"この雌牛の灰を集めた者も、その衣服を洗う。彼は夕方まで汚れる。これは、イスラエル人にも、あなたがたの間の在留異国人にも永遠のおきてとなる。","tok":[["この"],["雌牛","めうし"],["の"],["灰","はい"],["を"],["集めた","あつめた"],["者","もの"],["も"],["、"],["その"],["衣服","いふく"],["を"],["洗う","あらう"],["。"],["彼","かれ"],["は"],["夕方","ゆうがた"],["まで"],["汚れる","よごれる"],["。"],["これ"],["は"],["、"],["イスラエル"],["人","にん"],["に"],["も"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["の"],["在留","ざいりゅう"],["異国人","いこくにん"],["に"],["も"],["永遠","えいえん"],["の"],["おきて"],["と"],["なる"],["。"]]},{"verse":11,"text":"どのような人の死体にでも触れる者は、七日間、汚れる。","tok":[["どのような"],["人","ひと"],["の"],["死体","したい"],["に"],["で"],["も"],["触れる","ふれる"],["者","もの"],["は"],["、"],["七","なな"],["日間","かかん"],["、"],["汚れる","よごれる"],["。"]]},{"verse":12,"text":"その者は三日目と七日目に、汚れをきよめる水で罪の身をきよめ、きよくならなければならない。三日目と七日目に罪の身をきよめないなら、きよくなることはできない。","tok":[["その"],["者","もの"],["は"],["三日目","みっかめ"],["と"],["七日目","ななかめ"],["に"],["、"],["汚れ","よごれ"],["を"],["きよめる"],["水","みず"],["で"],["罪","つみ"],["の"],["身","み"],["を"],["きよめ"],["、"],["きよく"],["ならなければ"],["ならない"],["。"],["三日目","みっかめ"],["と"],["七日目","ななかめ"],["に"],["罪","つみ"],["の"],["身","み"],["を"],["きよめないなら"],["、"],["きよく"],["なる"],["こと"],["は"],["できない"],["。"]]},{"verse":13,"text":"すべて死んだ人の遺体に触れ、罪の身をきよめない者はだれでも、主の幕屋を汚す。その者はイスラエルから断ち切られる。その者は、汚れをきよめる水が振りかけられていないので、汚れており、その汚れがなお、その者にあるからである。","tok":[["すべて"],["死んだ","しんだ"],["人","ひと"],["の"],["遺体","いたい"],["に"],["触れ","ふれ"],["、"],["罪","つみ"],["の"],["身","み"],["を"],["きよめない"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["主","ぬし"],["の"],["幕屋","まくや"],["を"],["汚す","よごす"],["。"],["その"],["者","もの"],["は"],["イスラエル"],["から"],["断ち切られる","たちきられる"],["。"],["その"],["者","もの"],["は"],["、"],["汚れ","よごれ"],["を"],["きよめる"],["水","みず"],["が"],["振りかけられて","ふりかけられて"],["いない"],["ので"],["、"],["汚れて","よごれて"],["おり"],["、"],["その"],["汚れ","よごれ"],["が"],["なお"],["、"],["その"],["者","もの"],["に"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"人が天幕の中で死んだ場合のおしえは次のとおりである。その天幕に入る者と、その天幕の中にいる者はみな、七日間、汚れる。","tok":[["人","ひと"],["が"],["天幕","てんまく"],["の"],["中","なか"],["で"],["死んだ","しんだ"],["場合","ばあい"],["の"],["おしえ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["その"],["天幕","てんまく"],["に"],["入る","はいる"],["者","もの"],["と"],["、"],["その"],["天幕","てんまく"],["の"],["中","なか"],["に"],["いる"],["者","もの"],["は"],["みな"],["、"],["七","なな"],["日間","かかん"],["、"],["汚れる","よごれる"],["。"]]},{"verse":15,"text":"ふたをしていない口のあいた器もみな、汚れる。","tok":[["ふた"],["を"],["して"],["いない"],["口","くち"],["の"],["あいた"],["器","うつわ"],["も"],["みな"],["、"],["汚れる","よごれる"],["。"]]},{"verse":16,"text":"また、野外で、剣で刺し殺された者や死人や、人の骨や、墓に触れる者はみな、七日間、汚れる。","tok":[["また"],["、"],["野外","やがい"],["で"],["、"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["や"],["死人","しにん"],["や"],["、"],["人","ひと"],["の"],["骨","ほね"],["や"],["、"],["墓","はか"],["に"],["触れる","ふれる"],["者","もの"],["は"],["みな"],["、"],["七","なな"],["日間","かかん"],["、"],["汚れる","よごれる"],["。"]]},{"verse":17,"text":"この汚れた者のためには、罪のきよめのために焼いた灰を取り、器に入れて、それに湧き水を加える。","tok":[["この"],["汚れた","よごれた"],["者","もの"],["の"],["ため"],["に"],["は"],["、"],["罪","つみ"],["の"],["きよめ"],["の"],["ため"],["に"],["焼いた","やいた"],["灰","はい"],["を"],["取り","とり"],["、"],["器","うつわ"],["に"],["入れて","いれて"],["、"],["それ"],["に"],["湧き水","わきみず"],["を"],["加える","くわえる"],["。"]]},{"verse":18,"text":"身のきよい人がヒソプを取ってこの水に浸し、それを、天幕と、すべての器と、そこにいた者と、また骨や、刺し殺された者や、死人や、墓に触れた者との上に振りかける。","tok":[["身","み"],["の"],["きよい"],["人","ひと"],["が"],["ヒソプ"],["を"],["取って","とって"],["この"],["水","みず"],["に"],["浸し","ひたし"],["、"],["それ"],["を"],["、"],["天幕","てんまく"],["と"],["、"],["すべて"],["の"],["器","うつわ"],["と"],["、"],["そこ"],["に"],["いた"],["者","もの"],["と"],["、"],["また"],["骨","ほね"],["や"],["、"],["刺し殺された","さしころされた"],["者","もの"],["や"],["、"],["死人","しにん"],["や"],["、"],["墓","はか"],["に"],["触れた","ふれた"],["者","もの"],["と"],["の"],["上","うえ"],["に"],["振りかける","ふりかける"],["。"]]},{"verse":19,"text":"身のきよい人が、それを汚れた者に三日目と七日目に振りかければ、その者は七日目に、罪をきよめられる。その者は、衣服を洗い、水を浴びる。その者は夕方にはきよくなる。","tok":[["身","み"],["の"],["きよい"],["人","ひと"],["が"],["、"],["それ"],["を"],["汚れた","よごれた"],["者","もの"],["に"],["三日目","みっかめ"],["と"],["七日目","ななかめ"],["に"],["振りかければ","ふりかければ"],["、"],["その"],["者","もの"],["は"],["七日目","ななかめ"],["に"],["、"],["罪","つみ"],["を"],["きよめられる"],["。"],["その"],["者","もの"],["は"],["、"],["衣服","いふく"],["を"],["洗い","あらい"],["、"],["水","みず"],["を"],["浴びる","あびる"],["。"],["その"],["者","もの"],["は"],["夕方","ゆうがた"],["に"],["は"],["きよく"],["なる"],["。"]]},{"verse":20,"text":"汚れた者が、罪の身をきよめなければ、その者は集会の中から断ち切られる。その者は主の聖所を汚したからである。汚れをきよめる水がその者に振りかけられなかったので、その者は汚れている。","tok":[["汚れた","よごれた"],["者","もの"],["が"],["、"],["罪","つみ"],["の"],["身","み"],["を"],["きよめなければ"],["、"],["その"],["者","もの"],["は"],["集会","しゅうかい"],["の"],["中","なか"],["から"],["断ち切られる","たちきられる"],["。"],["その"],["者","もの"],["は"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚した","よごした"],["から"],["で"],["ある"],["。"],["汚れ","よごれ"],["を"],["きよめる"],["水","みず"],["が"],["その"],["者","もの"],["に"],["振りかけられなかった","ふりかけられなかった"],["ので"],["、"],["その"],["者","もの"],["は"],["汚れて","よごれて"],["いる"],["。"]]},{"verse":21,"text":"これは彼らに対する永遠のおきてとなる。汚れをきよめる水を振りかけた者は、その衣服を洗わなければならない。汚れをきよめる水に触れた者は夕方まで汚れる。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["永遠","えいえん"],["の"],["おきて"],["と"],["なる"],["。"],["汚れ","よごれ"],["を"],["きよめる"],["水","みず"],["を"],["振りかけた",
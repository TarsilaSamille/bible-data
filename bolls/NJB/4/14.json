[{"verse":1,"text":"全会衆は大声をあげて叫び、民はその夜、泣き明かした。","tok":[["全","ぜん"],["会衆","かいしゅう"],["は"],["大声","おおごえ"],["を"],["あげて"],["叫び","さけび"],["、"],["民","みん"],["は"],["その"],["夜","よる"],["、"],["泣き明かした","なきあかした"],["。"]]},{"verse":2,"text":"イスラエル人はみな、モーセとアロンにつぶやき、全会衆は彼らに言った。「私たちはエジプトの地で死んでいたらよかったのに。できれば、この荒野で死んだほうがましだ。","tok":[["イスラエル"],["人","にん"],["は"],["みな"],["、"],["モーセ"],["と"],["アロン"],["に"],["つぶやき"],["、"],["全","ぜん"],["会衆","かいしゅう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["エジプト"],["の"],["地","ち"],["で"],["死んで","しんで"],["いたら"],["よかった"],["のに"],["。"],["できれば"],["、"],["この"],["荒野","こうや"],["で"],["死んだ","しんだ"],["ほう"],["が"],["まし"],["だ"],["。"]]},{"verse":3,"text":"なぜ主は、私たちをこの地に導いて来て、剣で倒そうとされるのか。私たちの妻子は、さらわれてしまうのに。エジプトに帰ったほうが、私たちにとって良くはないか。」","tok":[["なぜ"],["主","ぬし"],["は"],["、"],["私たち","わたしたち"],["を"],["この"],["地","ち"],["に"],["導いて","みちびいて"],["来て","きて"],["、"],["剣","けん"],["で"],["倒そう","たおそう"],["と"],["される"],["の"],["か"],["。"],["私たち","わたしたち"],["の"],["妻子","さいし"],["は"],["、"],["さらわれて"],["しまう"],["のに"],["。"],["エジプト"],["に"],["帰った","かえった"],["ほう"],["が"],["、"],["私たち","わたしたち"],["にとって"],["良く","よく"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":4,"text":"そして互いに言った。「さあ、私たちは、ひとりのかしらを立ててエジプトに帰ろう。」","tok":[["そして"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["私たち","わたしたち"],["は"],["、"],["ひとり"],["の"],["かしら"],["を"],["立てて","たてて"],["エジプト"],["に"],["帰ろう","かえろう"],["。"],["」"]]},{"verse":5,"text":"そこで、モーセとアロンは、イスラエル人の会衆の全集会の集まっている前でひれ伏した。","tok":[["そこ"],["で"],["、"],["モーセ"],["と"],["アロン"],["は"],["、"],["イスラエル"],["人","にん"],["の"],["会衆","かいしゅう"],["の"],["全","ぜん"],["集会","しゅうかい"],["の"],["集まって","あつまって"],["いる"],["前","まえ"],["で"],["ひれ伏した","ひれふした"],["。"]]},{"verse":6,"text":"すると、その地を探って来た者のうち、ヌンの子ヨシュアとエフネの子カレブとは自分たちの着物を引き裂いて、","tok":[["する"],["と"],["、"],["その"],["地","ち"],["を"],["探って","さぐって"],["来た","きた"],["者","もの"],["の"],["うち"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["エフネ"],["の"],["子","こ"],["カレブ"],["と"],["は"],["自分","じぶん"],["たち"],["の"],["着物","きもの"],["を"],["引き裂いて","ひきさいて"],["、"]]},{"verse":7,"text"
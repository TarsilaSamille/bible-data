,["民","たみ"],["の"],["間","あいだ"],["で"],["行った","おこなった"],["すべて"],["の"],["しるし"],["に"],["も"],["かかわらず"],["、"],["いつ"],["まで"],["わたし"],["を"],["信じない","しんじない"],["の"],["か"],["。"]]},{"verse":12,"text":"わたしは疫病で彼らを打って滅ぼしてしまい、あなたを彼らよりも大いなる強い国民にしよう。」","tok":[["わたし"],["は"],["疫病","やくびょう"],["で"],["彼","かれ"],["ら"],["を"],["打って","うって"],["滅ぼして","ほろぼして"],["しまい"],["、"],["あなた"],["を"],["彼","かれ"],["ら"],["より"],["も"],["大いなる","おおいなる"],["強い","つよい"],["国民","こくみん"],["に"],["しよう"],["。"],["」"]]},{"verse":13,"text":"モーセは主に申し上げた。「エジプトは、あなたが御力によって、彼らのうちからこの民を導き出されたことを聞いて、","tok":[["モーセ"],["は"],["主に","おもに"],["申し上げた","もうしあげた"],["。"],["「"],["エジプト"],["は"],["、"],["あなた"],["が"],["御力","おちから"],["によって"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["から"],["この"],["民","たみ"],["を"],["導き出された","みちびきだされた"],["こと"],["を"],["聞いて","きいて"],["、"]]},{"verse":14,"text":"この地の住民に告げましょう。事実、彼らは、あなた、主がこの民のうちにおられ、あなた、主がまのあたりに現れて、あなたの雲が彼らの上に立ち、あなたが昼は雲の柱、夜は火の柱のうちにあって、彼らの前を歩んでおられるのを聞いているのです。","tok":[["この"],["地","ち"],["の"],["住民","じゅうみん"],["に"],["告げましょう","つげましょう"],["。"],["事実","じじつ"],["、"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["、"],["主","ぬし"],["が"],["この"],["民","たみ"],["の"],["うち"],["に"],["おられ"],["、"],["あなた"],["、"],["主","ぬし"],["が"],["まのあたり"],["に"],["現れて","あらわれて"],["、"],["あなた"],["の"],["雲","くも"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["立ち","たち"],["、"],["あなた"],["が"],["昼","ひる"],["は"],["雲","くも"],["の"],["柱","はしら"],["、"],["夜","よる"],["は"],["火","ひ"],["の"],["柱","はしら"],["の"],["うち"],["に"],["あって"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["を"],["歩んで","あゆんで"],["おられる"],["の"],["を"],["聞いて","きいて"],["いる"],["の"],["です"],["。"]]},{"verse":15,"text":"そこでもし、あなたがこの民をひとり残らず殺すなら、あなたのうわさを聞いた異邦の民は次のように言うでしょう。","tok":[["そこ"],["で"],["も"],["し"],["、"],["あなた"],["が"],["この"],["民","たみ"],["を"],["ひとり"],["残らず","のこらず"],["殺すなら","ころすなら"],["、"],["あなた"],["の"],["うわさ"],["を"],["聞いた","きいた"],["異邦","いほう"],["の"],["民","たみ"],["は"],["次","つぎ"],["の"],["よう"],["に"],["言うでしょう","ゆうでしょう"],["。"]]},{"verse":16,"text":"『主はこの民を、彼らに誓った地に導き入れることができなかったので、彼らを荒野で殺したのだ。』","tok":[["『"],["主","ぬし"],["は"],["この"],["民","たみ"],["を"],
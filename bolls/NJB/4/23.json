[{"verse":1,"text":"バラムはバラクに言った。「私のためにここに七つの祭壇を築き、七頭の雄牛と七頭の雄羊をここに用意してください。」","tok":[["バラム"],["は"],["バラク"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["ため"],["に"],["ここ"],["に"],["七","なな"],["つ"],["の"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["七頭","ななとう"],["の"],["雄牛","おうし"],["と"],["七頭","ななとう"],["の"],["雄羊","おひつじ"],["を"],["ここ"],["に"],["用意","ようい"],["して"],["ください"],["。"],["」"]]},{"verse":2,"text":"バラクはバラムの言ったとおりにした。そしてバラクとバラムとは、それぞれの祭壇の上で雄牛一頭と雄羊一頭とをささげた。","tok":[["バラク"],["は"],["バラム"],["の"],["言った","いった"],["とおり"],["に"],["した"],["。"],["そして"],["バラク"],["と"],["バラム"],["と"],["は"],["、"],["それぞれ"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["雄牛","おうし"],["一頭","いちとう"],["と"],["雄羊","おひつじ"],["一頭","いちとう"],["と"],["を"],["ささげた"],["。"]]},{"verse":3,"text":"バラムはバラクに言った。「あなたは、あなたの全焼のいけにえのそばに立っていなさい。私は行って来ます。たぶん、主は私に現れて会ってくださるでしょう。そうしたら、私にお示しになることはどんなことでも、あなたに知らせましょう。」そして彼は裸の丘に行った。","tok":[["バラム"],["は"],["バラク"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["あなた"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["そば"],["に"],["立って","たって"],["い"],["なさい"],["。"],["私","わたくし"],["は"],["行って","いって"],["来ます","きます"],["。"],["たぶん"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["現れて","あらわれて"],["会って","あって"],["くださるでしょう"],["。"],["そう"],["したら"],["、"],["私","わたくし"],["に"],["お示し","おしめし"],["に"],["なる"],["こと"],["は"],["どんな"],["こと"],["で"],["も"],["、"],["あなた"],["に"],["知らせましょう","しらせましょう"],["。"],["」"],["そして"],["彼","かれ"],["は"],["裸","はだか"],["の"],["丘","おか"],["に"],["行った","いった"],["。"]]},{"verse":4,"text":"神がバラムに会われたので、バラムは神に言った。「私は七つの祭壇を造り、それぞれの祭壇の上で雄牛一頭と雄羊一頭とをささげました。」","tok":[["神","かみ"],["が"],["バラム"],["に"],["会われた","あわれた"],["ので"],["、"],["バラム"],["は"],["神","かみ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["七","なな"],["つ"],["の"],["祭壇","さいだん"],["を"],["造り","つくり"],["、"],["それぞれ"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["雄牛","おうし"],["一頭","いちとう"],["と"],["雄羊","おひつじ"],["一頭","いちとう"],["と"],["を"],["ささげました"],["。"],["」"]]},{"verse":5,"text":"主はバラムの口にことばを置き、そして言われた。「バラクのところに帰れ。あなたはこう言わなければならない。」","tok":[["主","ぬし"],["は"],["バラム"],["の"],["口","くち"],["に"],["ことば"],["を"],["置き","おき"],["、"],["そして"],["言われた","いわれた"],["。"],["「"],["バラク"],["の"],["ところ"],["に"],["帰れ","かえれ"],["。"],["あなた"],["は"],["こう"],["言わなければ","いわなければ"],["ならない"],["。"],["」"]]},{"verse":6,"text":"それで、彼はバラクのところに帰った。すると、モアブのすべてのつかさたちといっしょに、彼は自分の全焼のいけにえのそばに立っていた。","tok":[["それ"],["で"],["、"],["彼","かれ"],["は"],["バラク"],["の"],["ところ"],["に"],["帰った","かえった"],["。"],["する"],["と"],["、"],["モアブ"],["の"],["すべて"],["の"],["つかさ"],["たち"],["と"],["いっしょ"],["に"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["そば"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":7,"text":"バラムは彼のことわざを唱えて言った。「バラクは、アラムから、モアブの王は、東の山々から、私を連れて来た。『来て、私のためにヤコブをのろえ。来て、イスラエルに滅びを宣言せよ。』","tok":[["バラム"],["は"],["彼","かれ"],["の"],["ことわざ"],["を"],["唱えて","となえて"],["言った","いった"],["。"],["「"],["バラク"],["は"],["、"],["アラム"],["から"],["、"],["モアブ"],["の"],["王","おう"],["は"],["、"],["東","ひがし"],["の"],["山々","やまやま"],["から"],["、"],["私","わたくし"],["を"],["連れて","つれて"],["来た","きた"],["。"],["『"],["来て","きて"],["、"],["私","わたくし"],["の"],["ため"],["に"],["ヤコブ"],["を"],["のろえ"],["。"],["来て","きて"],["、"],["イスラエル"],["に"],["滅び","ほろび"],["を"],["宣言","せんげん"],["せよ"],["。"],["』"]]},{"verse":8,"text":"神がのろわない者を、私がどうしてのろえようか。主が滅びを宣言されない者に、私がどうして滅びを宣言できようか。","tok":[["神","かみ"],["が"],["のろわない"],["者","もの"],["を"],["、"],["私","わたくし"],["が"],["どう"],["して"],["のろえ"],["よう"],["か"],["。"],["主","ぬし"],["が"],["滅び","ほろび"],["を"],["宣言","せんげん"],["されない"],["者","もの"],["に"],["、"],["私","わたくし"],["が"],["どう"],["して"],["滅び","ほろび"],["を"],["宣言","せんげん"],["できよう"],["か"],["。"]]},{"verse":9,"text":"岩山の頂から私はこれを見、丘の上から私はこれを見つめる。見よ。この民はひとり離れて住み、おのれを諸国の民の一つと認めない。","tok":[["岩山","いわやま"],["の"],["頂","いただき"],["から"],["私","わたくし"],["は"],["これ"],["を"],["見","み"],["、"],["丘","おか"],["の"],["上","うえ"],["から"],["私","わたくし"],["は"],["これ"],["を"],["見つめる","みつめる"],["。"],["見","み"],["よ"],["。"],["この"],["民","みん"],["は"],["ひとり"],["離れて","はなれて"],["住み","すみ"],["、"],["おのれ"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["一","ひと"],["つ"],["と"],["認めない","みとめない"],["。"]]},{"verse":10,"text":"だれがヤコブのちりを数え、イスラエルのちりの群れを数ええようか。私は正しい人が死ぬように死に、私の終わりが彼らと同じであるように。」","tok":[["だれ"],["が"],["ヤコブ"],["の"],["ちり"],["を"],["数え","かぞえ"],["、"],["イスラエル"],["の"],["ちり"],["の"],["群れ","むれ"],["を"],["数え","かぞえ"],["えよう"],["か"],["。"],["私","わたくし"],["は"],["正しい","ただしい"],["人","ひと"],["が"],["死ぬ","しぬ"],["よう"],["に"],["死に","しに"],["、"],["私","わたくし"],["の"],["終わり","おわり"],["が"],["彼","かれ"],["ら"],["と"],["同じ","おなじ"],["で"],["ある"],["よう"],["に"],["。"],["」"]]},{"verse":11,"text":"バラクはバラムに言った。「あなたは私になんということをしたのですか。私の敵をのろってもらうためにあなたを連れて来たのに、今、あなたはただ祝福しただけです。」","tok":[["バラク"],["は"],["バラム"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["に"],["なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["です"],["か"],["。"],["私","わたくし"],["の"],["敵","てき"],["を"],["のろって"],["もらう"],["ため"],["に"],["あなた"],["を"],["連れて","つれて"],["来た","きた"],["のに"],["、"],["今","いま"],["、"],["あなた"],["は"],["ただ"],["祝福","しゅくふく"],["した"],["だけ"],["です"],["。"],["」"]]},{"verse":12,"text":"バラムは答えて言った。「主が私の口に置かれること、それを私は忠実に語らなければなりません。」","tok":[["バラム"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["私","わたくし"],["の"],["口","くち"],["に"],["置かれる","おかれる"],["こと"],["、"],["それ"],["を"],["私","わたくし"],["は"],["忠実","ちゅうじつ"],["に"],["語らなければ","かたらなければ"],["なりません"],["。"],["」"]]},{"verse":13,"text":"バラクは彼に言った。「では、私といっしょにほかの所へ行ってください。そこから彼らを見ることができるが、ただその一部だけが見え、全体を見ることはできない所です。そこから私のために彼らをのろってください。」","tok":[["バラク"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["私","わたくし"],["と"],["いっしょ"],["に"],["ほか"],["の"],["所","ところ"],["へ"],["行って","いって"],["ください"],["。"],["そこ"],["から"],["彼","かれ"],["ら"],["を"],["見る","みる"],["こと"],["が"],["できる"],["が"],["、"],["ただ"],["その"],["一部","いちぶ"],["だけ"],["が"],["見え","みえ"],["、"],["全体","ぜんたい"],["を"],["見る","みる"],["こと"],["は"],["できない"],["所","ところ"],["です"],["。"],["そこ"],["から"],["私","わたくし"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["のろって"],["ください"],["。"],["」"]]},{"verse":14,"text":"バラクはバラムを、セデ・ツォフィムのピスガの頂に連れて行き、そこで七つの祭壇を築き、それぞれの祭壇の上で雄牛と雄羊とを一頭ずつささげた。","tok":[["バラク"],["は"],["バラム"],["を"],["、"],["セデ"],["・"],["ツォフィム"],["の"],["ピスガ"],["の"],["頂","いただき"],["に"],["連れて","つれて"],["行き","いき"],["、"],["そ
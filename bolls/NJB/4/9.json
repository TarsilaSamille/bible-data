[{"verse":1,"text":"エジプトの国を出て第二年目の第一月に、主はシナイの荒野でモーセに告げて仰せられた。","tok":[["エジプト"],["の"],["国","くに"],["を"],["出て","でて"],["第","だい"],["二","に"],["年目","ねんめ"],["の"],["第","だい"],["一","いち"],["月","がつ"],["に"],["、"],["主","ぬし"],["は"],["シナイ"],["の"],["荒野","あらの"],["で"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人は、定められた時に、過越のいけにえをささげよ。","tok":[["「"],["イスラエル"],["人","にん"],["は"],["、"],["定められた","さだめられた"],["時","とき"],["に"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげ"],["よ"],["。"]]},{"verse":3,"text":"あなたがたはこの月の十四日の夕暮れ、その定められた時に、それをささげなければならない。そのすべてのおきてとすべての定めに従って、それをしなければならない。」","tok":[["あなた"],["がた"],["は"],["この"],["月","つき"],["の"],["十四日","じゅうよんか"],["の"],["夕暮れ","ゆうぐれ"],["、"],["その"],["定められた","さだめられた"],["時","とき"],["に"],["、"],["それ"],["を"],["ささげなければ"],["ならない"],["。"],["その"],["すべて"],["の"],["おきて"],["と"],["すべて"],["の"],["定め","さだめ"],["に"],["従って","したがって"],["、"],["それ"],["を"],["しなければ"],["ならない"],["。"],["」"]]},{"verse":4,"text":"そこでモーセはイスラエル人に、過越のいけにえをささげるように命じたので、","tok":[["そこ"],["で"],["モーセ"],["は"],["イスラエル"],["人","にん"],["に"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげる"],["よう"],["に"],["命じた","めいじた"],["ので"],["、"]]},{"verse":5,"text":"彼らはシナイの荒野で第一月の十四日の夕暮れに過越のいけにえをささげた。イスラエル人はすべて主がモーセに命じられたとおりに行った。","tok":[["彼","かれ"],["ら"],["は"],["シナイ"],["の"],["荒野","あらの"],["で"],["第","だい"],["一","いち"],["月","がつ"],["の"],["十四日","じゅうよんか"],["の"],["夕暮れ","ゆうぐれ"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげた"],["。"],["イスラエル"],["人","にん"],["は"],["すべて"],["主","ぬし"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"]]},{"verse":6,"text":"しかし、人の死体によって身を汚し、その日に過越のいけにえをささげることができなかった人々がいた。彼らはその日、モーセとアロンの前に近づいた。","tok":[["しかし"],["、"],["人","ひと"],["の"],["死体","したい"],["によって"],["身","み"],["を"],["汚し","よごし"],["、"],["その"],["日","ひ"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげる"],["こと"],["が"],["できなかった"],["人々","ひとびと"],["が"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["その"],["日","ひ"],["、"],["モーセ"],["と"],["アロン"],["の"],["前","まえ"],["に"],["近づいた","ちかづいた"],["。"]]},{"verse":7,"text":"その人々は彼に言った。「私たちは、人の死体に
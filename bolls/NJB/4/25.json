[{"verse":1,"text":"イスラエルはシティムにとどまっていたが、民はモアブの娘たちと、みだらなことをし始めた。","tok":[["イスラエル"],["は"],["シティム"],["に"],["とどまって"],["いた"],["が"],["、"],["民","みん"],["は"],["モアブ"],["の"],["娘","むすめ"],["たち"],["と"],["、"],["みだら"],["な"],["こと"],["を"],["し"],["始めた","はじめた"],["。"]]},{"verse":2,"text":"娘たちは、自分たちの神々にいけにえをささげるのに、民を招いたので、民は食し、娘たちの神々を拝んだ。","tok":[["娘","むすめ"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["神々","かみがみ"],["に"],["いけにえ"],["を"],["ささげる"],["のに"],["、"],["民","みん"],["を"],["招いた","まねいた"],["ので"],["、"],["民","みん"],["は"],["食し","しょくし"],["、"],["娘","むすめ"],["たち"],["の"],["神々","かみがみ"],["を"],["拝んだ","おがんだ"],["。"]]},{"verse":3,"text":"こうしてイスラエルは、バアル・ペオルを慕うようになったので、主の怒りはイスラエルに対して燃え上がった。","tok":[["こう"],["して"],["イスラエル"],["は"],["、"],["バアル"],["・"],["ペオル"],["を"],["慕う","したう"],["よう"],["に"],["なった"],["ので"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["イスラエル"],["に対して","にたいして"],["燃え上がった","もえあがった"],["。"]]},{"verse":4,"text":"主はモーセに言われた。「この民のかしらたちをみな捕らえて、白日のもとに彼らを主の前でさらし者にせよ。主の燃える怒りはイスラエルから離れ去ろう。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["この"],["民","たみ"],["の"],["かしら"],["たち"],["を"],["みな"],["捕らえて","とらえて"],["、"],["白日","はくじつ"],["の"],["もと"],["に"],["彼","かれ"],["ら"],["を"],["主","ぬし"],["の"],["前","まえ"],["で"],["さらし者","さらしもの"],["に"],["せよ"],["。"],["主","ぬし"],["の"],["燃える","もえる"],["怒り","いかり"],["は"],["イスラエル"],["から"],["離れ去ろう","はなれさろう"],["。"],["」"]]},{"verse":5,"text":"そこでモーセはイスラエルのさばきつかさたちに言った。「あなたがたは、おのおの自分の配下のバアル・ペオルを慕った者たちを殺せ。」","tok":[["そこ"],["で"],["モーセ"],["は"],["イスラエル"],["の"],["さばき"],["つかさ"],["たち"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["おのおの"],["自分","じぶん"],["の"],["配下","はいか"],["の"],["バアル"],["・"],["ペオル"],["を"],["慕った","したった"],["者","もの"],["たち"],["を"],["殺せ","ころせ"],["。"],["」"]]},{"verse":6,"text":"モーセとイスラエル人の全会衆が会見の天幕の入口で泣いていると、彼らの目の前に、ひとりのイスラエル人が、その兄弟たちのところにひとりのミデヤン人の女を連れてやって来た。","tok":[["モーセ"],["と"],["イスラエル"],["人","にん"],["の"],["全","ぜん"],["会衆","かいしゅう"],["が"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["で"],["泣いて","ないて"],["いる"],["と"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["に"],["、"],["ひとり"],["の"],["イスラエル"],["人","にん"],["が"],["、"],["その"],["兄弟","きょうだい"],["たち"],["の"],["ところ"],["に"],["ひとり"],["の"],["ミデヤン"],["人","にん"],["の"],["女","おんな"],["を"],["連れて","つれて"],["やって"],["来た","きた"],["。"]]},{"verse":7,"text":"祭司アロンの子エルアザルの子ピネハスはそれを見るや、会衆の中から立ち上がり、手に槍を取り、","tok":[["祭司","さいし"],["アロン"],["の"],["子","こ"],["エルアザル"],["の"],["子","こ"],["ピネハス"],["は"],["それ"],["を"],["見る","みる"],["や"],["、"],["会衆","かいしゅう"],["の"],["中","なか"],["から"],["立ち上がり","たちあがり"],["、"],["手","て"],["に"],["槍","やり"],["を"],["取り","とり"],["、"]]},{"verse":8,"text":"そのイスラエル人のあとを追ってテントの奥の部屋に入り、イスラエル人とその女とをふたりとも、腹を刺し通して殺した。するとイスラエル人への神罰がやんだ。","tok":[["その"],["イスラエル"],["人","にん"],["の"],["あと"],["を"],["追って","おって"],["テント"],["の"],["奥","おく"],["の"],["部屋","へや"],["に"],["入り","はいり"],["、"],["イスラエル"],["人","にん"],["と"],["その"],["女","おんな"],["と"],["を"],["ふたり"],["とも"],["、"],["腹","はら"],["を"],["刺し通して","さしとおして"],["殺した","ころした"],["。"],["する"],["と"],["イスラエル"],["人","にん"],["へ"],["の"],["神罰","しんばつ"],["が"],["やんだ"],["。"]]},{"verse":9,"text":"この神罰で死んだ者は、二万四千人であった。","tok":[["この"],["神罰","しんばつ"],["で"],["死んだ","しんだ"],["者","もの"],["は"],["、"],["二万四千","にまんよんせん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":10,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":11,"text":"「祭司アロンの子エルアザルの子ピネハスは、わたしのねたみをイスラエル人の間で自分のねたみとしたことで、わたしの憤りを彼らから引っ込めさせた。わたしは、わたしのねたみによってイスラエル人を絶ち滅ぼすことはしなかった。","tok":[["「"],["祭司","さいし"],["アロン"],["の"],["子","こ"],["エルアザル"],["の"],["子","こ"],["ピネハス"],["は"],["、"],["わたし"],["の"],["ねたみ"],["を"],["イスラエル"],["人","にん"],["の"],["間","あいだ"],["で"],["自分","じぶん"],["の"],["ねたみ"],["と"],["した"],["こと"],["で"],["、"],["わたし"],["の"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["から"],["引っ込めさせた","ひっこめさせた"],["。"],["わたし"],["は"],["、"],["わたし"],["の"],["ねたみ"],["によって"],["イスラエル"],["人","にん"],["を"],["絶ち","たち"],["滅ぼす","ほろぼす"],["こと"],["は"],["しなかった"],["。"]]},{"verse":12,"text":"それゆえ、言え。『見よ。わたしは彼にわたしの平和の契約を与える。","tok":[["それ"],["ゆえ"],["、"],["言え","いえ"],["。"],["『"],["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["に"],["わたし"],["の"],["平和","へいわ"],["の"],["契約","けいやく"],["を"],["与える","あたえる"],["。"]]},{"verse":13,"text":"これは、彼とその後の彼の子孫にとって、永遠にわたる祭司職の契約となる。それは彼がおのれの神のためにねたみを表し、イスラエル人の贖いをしたからである。』」","tok":[["これ"],["は"],["、"],["彼","かれ"],["と"],["その後","そのあと"],["の"],["彼","かれ"],["の"],["子孫","しそん"],["にとって"],["、"],["永遠","えいえん"],["に"],["わたる"],["祭司","さいし"],["職","しょく"],["の"],["契約","けいやく"],["と"],["なる"],["。"],["それ"],["は"],["彼","かれ"],["が"],["おのれ"],["の"],["神","かみ"],["の"],["ため"],["に"],["ねたみ"],["を"],["表し","あらわし"],["、"],["イスラエル"],["人","にん"],["の"],["贖い","あがない"],["を"],["した"],["から"],["で"],["ある"],["。"],["』"],["」"]]},{"verse":14,"text":"その殺されたイスラエル人、ミデヤン人の女といっしょに殺された者の名は、シメオン人の父の家の長サルの子ジムリであった。","tok":[["その"],["殺された","ころされた"],["イスラエル"],["人","にん"],["、"],["ミデヤン"],["人","にん"],["の"],["女","おんな"],["と"],["いっしょ"],["に"],["殺された","ころされた"],["者","もの"],["の"],["名","な"],["は"],["、"],["シメオン"],["人","にん"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["長","なが"],["サル"],["の"],["子","こ"],["ジムリ"],["で"],["あった"],["。"]]},{"verse":15,"text":"また殺されたミデヤン人の女の名はツルの娘コズビであった。ツルはミデヤンの父の家の氏族のかしらであった。","tok":[["また"],["殺された","ころされた"],["ミデヤン"],["人","にん"],["の"],["女","おんな"],["の"],["名","な"],["は"],["ツル"],["の"],["娘","むすめ"],["コズビ"],["で"],["あった"],["。"],["ツル"],["は"],["ミデヤン"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["氏族","しぞく"],["の"],["かしら"],["で"],["あった"],["。"]]},{"verse":16,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":17,"text":"「ミデヤン人を襲い、彼らを打て。","tok":[["「"],["ミデヤン"],["人","にん"],["を"],["襲い","おそい"],["、"],["彼","かれ"],["ら"],["を"],["打て","うて"],["。"]]},{"verse":18,"text":"彼らは巧妙にたくらんだたくらみで、あなたがたを襲ってペオルの事件を引き起こし、ペオルの事件の神罰の日に殺された彼らの同族の女、ミデヤンの族長の娘コズビの事件を引き起こしたからだ。」","tok":[["彼","かれ"],["ら"],["は"],["巧妙","こうみょう"],["に"],["たくらんだ"],["たくらみ"],["で"],["、"],["あなた"],["がた"],["を"],["襲って","おそって"],["ペオル"],["の"],["事件","じけん"],["を"],["引き起こし","ひきおこし"],["、"],["ペオル"],["の"],["事件","じけん"],["の"],["神罰","しんばつ"],["の"],["日","ひ"],["に"],["殺された","ころされた"],["彼","かれ"],["ら"],["の"],["同族","どうぞく"],["の"],["女","おんな"],["、"],["ミデヤン"],["の"],["族長","ぞくちょう"],["の"],["娘","むすめ"],["コズビ"],["の"],["事件","じけん"],["を"],["引き起こした","ひきおこした"],["から"],["だ"],["。"],["」"]]}]
[{"verse":1,"text":"イスラエル人はさらに進んで、ヨルダンのエリコをのぞむ対岸のモアブの草原に宿営した。","tok":[["イスラエル"],["人","にん"],["は"],["さらに"],["進んで","すすんで"],["、"],["ヨルダン"],["の"],["エリコ"],["を"],["のぞむ"],["対岸","たいがん"],["の"],["モアブ"],["の"],["草原","そうげん"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":2,"text":"さてツィポルの子バラクは、イスラエルがエモリ人に行ったすべてのことを見た。","tok":[["さて"],["ツィポル"],["の"],["子","こ"],["バラク"],["は"],["、"],["イスラエル"],["が"],["エモリ人","えもりにん"],["に"],["行った","いった"],["すべて"],["の"],["こと"],["を"],["見た","みた"],["。"]]},{"verse":3,"text":"モアブはイスラエルの民が多数であったので非常に恐れた。それでモアブはイスラエル人に恐怖をいだいた。","tok":[["モアブ"],["は"],["イスラエル"],["の"],["民","たみ"],["が"],["多数","たすう"],["で"],["あった"],["ので"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"],["それ"],["で"],["モアブ"],["は"],["イスラエル"],["人","にん"],["に"],["恐怖","きょうふ"],["を"],["いだいた"],["。"]]},{"verse":4,"text":"そこでモアブはミデヤンの長老たちに言った。「今、この集団は、牛が野の青草をなめ尽くすように、私たちの回りのすべてのものをなめ尽くそうとしている。」ツィポルの子バラクは当時、モアブの王であった。","tok":[["そこ"],["で"],["モアブ"],["は"],["ミデヤン"],["の"],["長老","ちょうろう"],["たち"],["に"],["言った","いった"],["。"],["「"],["今","いま"],["、"],["この"],["集団","しゅうだん"],["は"],["、"],["牛","うし"],["が"],["野","の"],["の"],["青草","あおくさ"],["を"],["なめ"],["尽くす","つくす"],["よう"],["に"],["、"],["私たち","わたしたち"],["の"],["回り","まわり"],["の"],["すべて"],["の"],["もの"],["を"],["なめ"],["尽くそう","つくそう"],["として"],["いる"],["。"],["」"],["ツィポル"],["の"],["子","こ"],["バラク"],["は"],["当時","とうじ"],["、"],["モアブ"],["の"],["王","おう"],["で"],["あった"],["。"]]},{"verse":5,"text":"そこで彼は、同族の国にあるユーフラテス河畔のペトルにいるベオルの子バラムを招こうとして使者たちを遣わして、言わせた。「今ここに、一つの民がエジプトから出て来ている。今や、彼らは地の面をおおって、私のすぐそばにとどまっている。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["、"],["同族","どうぞく"],["の"],["国","くに"],["に"],["ある"],["ユーフラテス"],["河畔","かはん"],["の"],["ペトル"],["に"],["いる"],["ベオル"],["の"],["子","こ"],["バラム"],["を"],["招こう","まねこう"],["として"],["使者","ししゃ"],["たち"],["を"],["遣わして","つかわして"],["、"],["言わせた","いわせた"],["。"],["「"],["今","いま"],["ここ"],["に"],["、"],["一","ひと"],["つ"],["の"],["民","たみ"],["が"],["エジプト"],["から"],["出て","でて"],["来て","きて"],["いる"],["。"],["今","いま"],["や"],["、"],["彼","かれ"],["ら"],["は"],["地","ち"],["の"],["面","めん"],["を"],["おおって"],["、"],["私","わたくし"],["の"],["すぐ"],["そば"],["に"],["とどまって"],["いる"],["。"]]},{"verse":6,"text":"どうかいま来て、私のためにこの民をのろってもらいたい。この民は私より強い。そうしてくれれば、たぶん私は彼らを打って、この地から追い出すことができよう。私は、あなたが祝福する者は祝福され、あなたがのろう者はのろわれることを知っている。」","tok":[["どう"],["か"],["いま"],["来て","きて"],["、"],["私","わたくし"],["の"],["ため"],["に"],["この"],["民","たみ"],["を"],["のろって"],["もらいたい"],["。"],["この"],["民","みん"],["は"],["私","わたくし"],["より"],["強い","つよい"],["。"],["そう"],["して"],["くれれば"],["、"],["たぶん"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["を"],["打って","うって"],["、"],["この"],["地","ち"],["から"],["追い出す","おいだす"],["こと"],["が"],["できよう"],["。"],["私","わたくし"],["は"],["、"],["あなた"],["が"],["祝福","しゅくふく"],["する"],["者","もの"],["は"],["祝福","しゅくふく"],["され"],["、"],["あなた"],["が"],["の"],["ろう者","ろうしゃ"],["は"],["のろわれる"],["こと"],["を"],["知って","しって"],["いる"],["。"],["」"]]},{"verse":7,"text":"占いに通じているモアブの長老たちとミデヤンの長老たちとは、バラムのところに行き、彼にバラクのことづけを告げた。","tok":[["占い","うらない"],["に"],["通じて","つうじて"],["いる"],["モアブ"],["の"],["長老","ちょうろう"],["たち"],["と"],["ミデヤン"],["の"],["長老","ちょうろう"],["たち"],["と"],["は"],["、"],["バラム"],["の"],["ところ"],["に"],["行き","いき"],["、"],["彼","かれ"],["に"],["バラク"],["の"],["ことづけ"],["を"],["告げた","つげた"],["。"]]},{"verse":8,"text":"するとバラムは彼らに言った。「今夜はここに泊まりなさい。主が私に告げられるとおりのことをあなたがたに答えましょう。」そこでモアブのつかさたちはバラムのもとにとどまった。","tok":[["する"],["と"],["バラム"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["今夜","こんや"],["は"],["ここ"],["に"],["泊まり","とまり"],["なさい"],["。"],["主","ぬし"],["が"],["私","わたくし"],["に"],["告げられる","つげられる"],["とおり"],["の"],["こと"],["を"],["あなた"],["がた"],["に"],["答えましょう","こたえましょう"],["。"],["」"],["そこ"],["で"],["モアブ"],["の"],["つかさ"],["たち"],["は"],["バラム"],["の"],["もと"],["に"],["とどまった"],["。"]]},{"verse":9,"text":"神はバラムのところに来て言われた。「あなたといっしょにいるこの者たちは何者か。」","tok":[["神","かみ"],["は"],["バラム"],["の"],["ところ"],["に"],["来て","きて"],["言われた","いわれた"],["。"],["「"],["あなた"],["と"],["いっしょ"],["に"],["いる"],["この"],["者","もの"],["たち"],["は"],["何者","なにもの"],["か"],["。"],["」"]]},{"verse":10,"text":"バラムは神に申し上げた。「モアブの王ツィポルの子バラクが、私のところに使いをよこしました。","tok":[["バラム"],["は"],["神","かみ"],["に"],["申し上げた","もうしあげた"],["。"],["「"],["モアブ"],["の"],["王","おう"],["ツィポル"],["の"],["子","こ"],["バラク"],["が"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["使い","つかい"],["を"],["よこしました"],["。"]]},{"verse":11,"text":"『今ここに、エジプトから出て来た民がいて、地の面をおおっている。いま来て、私のためにこの民をのろってくれ。そうしたら、たぶん私は彼らと戦って、追い出すことができよう。』」","tok":[["『"],["今","いま"],["ここ"],["に"],["、"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["民","たみ"],["が"],["いて"],["、"],["地","ち"],["の"],["面","めん"],["を"],["おおって"],["いる"],["。"],["いま"],["来て","きて"],["、"],["私","わたくし"],["の"],["ため"],["に"],["この"],["民","たみ"],["を"],["のろって"],["くれ"],["。"],["そう"],["したら"],["、"],["たぶん"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["と"],["戦って","たたかって"],["、"],["追い出す","おいだす"],["こと"],["が"],["できよう"],["。"],["』"],["」"]]},{"verse":12,"text":"神はバラムに言われた。「あなたは彼らといっしょに行ってはならない。またその民をのろってもいけない。その民は祝福されているからだ。」","tok":[["神","かみ"],["は"],["バラム"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["行って","いって"],["は"],["ならない"],["。"],["また"],["その"],["民","たみ"],["を"],["のろって"],["も"],["いけない"],["。"],["その"],["民","みん"],["は"],["祝福","しゅくふく"],["されて"],["いる"],["から"],["だ"],["。"],["」"]]},{"verse":13,"text":"朝になると、バラムは起きてバラクのつかさたちに言った。「あなたがたの国に帰りなさい。主は私をあなたがたといっしょに行かせようとはなさらないから。」","tok":[["朝","あさ"],["に"],["なる"],["と"],["、"],["バラム"],["は"],["起きて","おきて"],["バラク"],["の"],["つかさ"],["たち"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["国","くに"],["に"],["帰り","かえり"],["なさい"],["。"],["主","ぬし"],["は"],["私","わたくし"],["を"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["行かせよう","いかせよう"],["と"],["は"],["なさらない"],["から"],["。"],["」"]]},{"verse":14,"text":"モアブのつかさたちは立ってバラクのところに帰り、そして言った。「バラムは私たちといっしょに来ようとはしませんでした。」","tok":[["モアブ"],["の"],["つかさ"],["たち"],["は"],["立って","たって"],["バラク"],["の"],["ところ"],["に"],["帰り","かえり"],["、"],["そして"],["言った","いった"],["。"],["「"],["バラム"],["は"],["私たち","わたしたち"],["と"],["いっしょ"],["に"],["来よう","こよう"],["と"],["は"],["しませんでした"],["。"],["」"]]},{"verse":15,"text":"バラクはもう一度、前の者より大ぜいの、しかも位の高いつかさたちを遣わした。","tok":[["バラク"],["は"],["もう"],["一度","いちど"],["、"],["前","まえ"],["の"],["者","もの"],["より"],["大ぜい","おおぜい"],["の"],["、"],["しかも"],["位","くらい"],["の"],["高い","たかい"],["つかさ"],["たち"],["を"],["遣わした","つかわした"],["。"]]},{"verse":16,"text":"彼らはバラムのところに来て彼に言った。「ツィポルの子バラクはこう申しました。『どうか私のところに来るのを拒まないでください。","tok":[["彼","かれ"],["ら"],["は"],["バラム"],["の"],["ところ"],["に"],["来て","きて"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["ツィポル"],["の"],["子","こ"],["バラク"],["は"],["こう"],["申しました","もうしました"],["。"],["『"],["どう"],["か"],["私","わたくし"],["の"],["ところ"],["に"],["来る","くる"],["の"],["を"],["拒まないで","こばまないで"],["ください"],["。"]]},{"verse":17,"text":"私はあなたを手厚くもてなします。また、あなたが私に言いつけられることは何でもします。どうぞ来て、私のためにこの民をのろってください。』」","tok":[["私","わたくし"],["は"],["あなた"],["を"],["手厚く","てあつく"],["もてなします"],["。"],["また"],["、"],["あなた"],["が"],["私","わたくし"],["に"],["言いつけられる","いいつけられる"],["こと"],["は"],["何","なん"],["で"],["も"],["します"],["。"],["どうぞ"],["来て","きて"],["、"],["私","わたくし"],["の"],["ため"],["に"],["この"],["民","たみ"],["を"],["のろって"],["ください"],["。"],["』"],["」"]]},{"verse":18,"text":"しかしバラムはバラクの家臣たちに答えて言った。「たといバラクが私に銀や金の満ちた彼の家をくれても、私は私の神、主のことばにそむいて、事の大小にかかわらず、何もすることはできません。","tok":[["しかし"],["バラム"],["は"],["バラク"],["の"],["家臣","かしん"],["たち"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["たとい"],["バラク"],["が"],["私","わたくし"],["に"],["銀","ぎん"],["や"],["金","きん"],["の"],["満ちた","みちた"],["彼","かれ"],["の"],["家","いえ"],["を"],["くれて"],["も"],["、"],["私","わたくし"],["は"],["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ことば"],["に"],["そむいて"],["、"],["事","こと"],["の"],["大小","だいしょう"],["に"],["かかわらず"],["、"],["何","なん"],["も"],["する"],["こと"],["は"],["できません"],["。"]]},{"verse":19,"text":"それであなたがたもまた、今晩ここにとどまりなさい。主が私に何かほかのことをお告げになるかどうか確かめましょう。」","tok":[["それ"],["で"],["あなた"],["がた"],["も"],["また"],["、"],["今晩","こんばん"],["ここ"],["に"],["とどまり"],["なさい"],["。"],["主","ぬし"],["が"],["私","わたくし"],["に"],["何","なん"],["か"],["ほか"],["の"],["こと"],["を"],["お告げ","おつげ"],["に"],["なる"],["か"],["どう"],["か"],["確かめましょう","たしかめましょう"],["。"],["」"]]},{"verse":20,"text":"その夜、神はバラムのところに来て、彼に言われた。「この者たちがあなたを招きに来たのなら、立って彼らとともに行け。だが、あなたはただ、わたしがあなたに告げることだけを行え。」","tok":[["その"],["夜","よる"],["、"],["神","かみ"],["は"],["バラム"],["の"],["ところ"],["に"],["来て","きて"],["、"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["この"],["者","もの"],["たち"],["が"],["あなた"],["を"],["招き","まねき"],["に"],["来た","
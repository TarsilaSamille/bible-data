[{"verse":1,"text":"エリコに近いヨルダンのほとりのモアブの草原で、主はモーセに告げて仰せられた。","tok":[["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["の"],["ほとり"],["の"],["モアブ"],["の"],["草原","そうげん"],["で"],["、"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人に命じて、その所有となる相続地の一部を、レビ人に住むための町々として与えさせなさい。彼らはその町々の回りの放牧地をレビ人に与えなければならない。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["命じて","めいじて"],["、"],["その"],["所有","しょゆう"],["と"],["なる"],["相続","そうぞく"],["地","ち"],["の"],["一部","いちぶ"],["を"],["、"],["レビ人","れびにん"],["に"],["住む","すむ"],["ため"],["の"],["町々","まちまち"],["として"],["与えさせ","あたえさせ"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["その"],["町々","まちまち"],["の"],["回り","まわり"],["の"],["放牧","ほうぼく"],["地","ち"],["を"],["レビ人","れびにん"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":3,"text":"町々は彼らが住むためであり、その放牧地は彼らの家畜や群れや、すべての獣のためである。","tok":[["町々","まちまち"],["は"],["彼","かれ"],["ら"],["が"],["住む","すむ"],["ため"],["で"],["あり"],["、"],["その"],["放牧","ほうぼく"],["地","ち"],["は"],["彼","かれ"],["ら"],["の"],["家畜","かちく"],["や"],["群れ","むれ"],["や"],["、"],["すべて"],["の"],["獣","けもの"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"あなたがたがレビ人に与える町々の放牧地は、町の城壁から外側に、回り一千キュビトでなければならない。","tok":[["あなた"],["がた"],["が"],["レビ人","れびにん"],["に"],["与える","あたえる"],["町々","まちまち"],["の"],["放牧","ほうぼく"],["地","ち"],["は"],["、"],["町","まち"],["の"],["城壁","じょうへき"],["から"],["外側","そとがわ"],["に"],["、"],["回り","まわり"],["一千","いちせん"],["キュビト"],["で"],["なければ"],["ならない"],["。"]]},{"verse":5,"text":"町の外側に、町を真ん中として東側に二千キュビト、南側に二千キュビト、西側に二千キュビト、北側に二千キュビトを測れ。これが彼らの町々の放牧地である。","tok":[["町","まち"],["の"],["外側","そとがわ"],["に"],["、"],["町","まち"],["を"],["真ん中","まんなか"],["として"],["東側","ひがしがわ"],["に"],["二千","にせん"],["キュビト"],["、"],["南側","みなみがわ"],["に"],["二千","にせん"],["キュビト"],["、"],["西側","にしがわ"],["に"],["二千","にせん"],["キュビト"],["、"],["北側","きたがわ"],["に"],["二千","にせん"],["キュビト"],["を"],["測れ","はかれ"],["。"],["これ"],["が"],["彼","かれ"],["ら"],["の"],["町々","まちまち"],["の"],["放牧","ほうぼく"],["地","ち"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたがたが、レビ人に与える町々、すなわち、人を殺した者がそこにのがれるために与える六つの、のがれの町と、そのほかに、四十二の町を与えなければならない。","tok":[["あなた"],["が"],["た"],["が"],["、"],["レビ人","れびにん"],["に"],["与える","あたえる"],["町々","まちまち"],["、"],["すなわち"],["、"],["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["が"],["そこ"],["に"],["のがれる"],["ため"],["に"],["与える","あたえる"],["六","むい"],["つ"],["の"],["、"],["のがれ"],["の"],["町","まち"],["と"],["、"],["その"],["ほか"],["に"],["、"],["四十二","よんじゅうに"],["の"],["町","まち"],["を"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":7,"text":"あなたがたがレビ人に与える町は、全部で四十八の町で、放牧地つきである。","tok":[["あなた"],["がた"],["が"],["レビ人","れびにん"],["に"],["与える","あたえる"],["町","まち"],["は"],["、"],["全部","ぜんぶ"],["で"],["四十八","しとや"],["の"],["町","まち"],["で"],["、"],["放牧","ほうぼく"],["地つき","じつき"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたがたがイスラエル人の所有地のうちから与える町々は、大きい部族からは多く、小さい部族からは少なくしなければならない。おのおの自分の相続した相続地に応じて、自分の町々からレビ人に与えなければならない。」","tok":[["あなた"],["がた"],["が"],["イスラエル"],["人","にん"],["の"],["所有地","しょゆうち"],["の"],["うち"],["から"],["与える","あたえる"],["町々","まちまち"],["は"],["、"],["大きい","おおきい"],["部族","ぶぞく"],["から"],["は"],["多く","おおく"],["、"],["小さい","ちいさい"],["部族","ぶぞく"],["から"],["は"],["少なく","すくなく"],["しなければ"],["ならない"],["。"],["おのおの"],["自分","じぶん"],["の"],["相続","そうぞく"],["した"],["相続","そうぞく"],["地","ち"],["に"],["応じて","おうじて"],["、"],["自分","じぶん"],["の"],["町々","まちまち"],["から"],["レビ人","れびにん"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"],["」"]]},{"verse":9,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":10,"text":"「イスラエル人に告げて、彼らに言え。あなたがたがヨルダンを渡ってカナンの地に入るとき、","tok":[["「"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡って","わたって"],["カナン"],["の"],["地","ち"],["に"],["入る","はいる"],["とき"],["、"]]},{"verse":11,"text":"あなたがたは町々を定めなさい。それをあなたがたのために、のがれの町とし、あやまって人を打ち殺した殺人者がそこにのがれることができるようにしなければならない。","tok":[["あなた"],["がた"],["は"],["町々","まちまち"],["を"],["定め","さだめ"],["なさい"],["。"],["それ"],["を"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["のがれ"],["の"],["町","まち"],["と"],["し"],["、"],["あやまって"],["人","ひと"],["を"],["打ち殺した","うちころした"],["殺人者","さつじんしゃ"],["が"],["そこ"],["に"],["のがれる"],["こと"],["が"],["できる"],["よう"],["に"],["しなけれ
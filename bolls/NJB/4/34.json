[{"verse":1,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人に命じて、彼らに言え。あなたがたがカナンの地に入るとき、あなたがたの相続地となる国、カナンの地の境界は次のとおりである。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["命じて","めいじて"],["、"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["あなた"],["がた"],["が"],["カナン"],["の"],["地","ち"],["に"],["入る","はいる"],["とき"],["、"],["あなた"],["がた"],["の"],["相続","そうぞく"],["地","ち"],["と"],["なる"],["国","くに"],["、"],["カナン"],["の"],["地","ち"],["の"],["境界","きょうかい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたがたの南側は、エドムに接するツィンの荒野に始まる。南の境界線は、東のほうの塩の海の端に始まる。","tok":[["あなた"],["がた"],["の"],["南側","みなみがわ"],["は"],["、"],["エドム"],["に"],["接する","せっする"],["ツィン"],["の"],["荒野","あらの"],["に"],["始まる","はじまる"],["。"],["南","みなみ"],["の"],["境界線","きょうかいせん"],["は"],["、"],["東","ひがし"],["の"],["ほう"],["の"],["塩","しお"],["の"],["海","うみ"],["の"],["端","はし"],["に"],["始まる","はじまる"],["。"]]},{"verse":4,"text":"その境界線は、アクラビムの坂の南から回ってツィンのほうに進み、その終わりはカデシュ・バルネアの南である。またハツァル・アダルを出て、アツモンに進む。","tok":[["その"],["境界線","きょうかいせん"],["は"],["、"],["アクラビム"],["の"],["坂","さか"],["の"],["南","みなみ"],["から"],["回って","まわって"],["ツィン"],["の"],["ほう"],["に"],["進み","すすみ"],["、"],["その"],["終わり","おわり"],["は"],["カデシュ"],["・"],["バルネア"],["の"],["南","みなみ"],["で"],["ある"],["。"],["また"],["ハツァル"],["・"],["アダル"],["を"],["出て","でて"],["、"],["アツモン"],["に"],["進む","すすむ"],["。"]]},{"verse":5,"text":"その境界線は、アツモンから回ってエジプト川に向かい、その終わりは海である。","tok":[["その"],["境界線","きょうかいせん"],["は"],["、"],["アツモン"],["から"],["回って","まわって"],["エジプト"],["川","かわ"],["に"],["向かい","むかい"],["、"],["その"],["終わり","おわり"],["は"],["海","うみ"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたがたの西の境界線は、大海とその沿岸である。これをあなたがたの西の境界線としなければならない。","tok":[["あなた"],["がた"],["の"],["西","にし"],["の"],["境界線","きょうかいせん"],["は"],["、"],["大海","たいかい"],["と"],["その"],["沿岸","えんがん"],["で"],["ある"],["。"],["これ"],["を"],["あなた"],["がた"],["の"],["西","にし"],["の"],["境界線","きょうかいせん"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":7,"text":"あなたがたの北の境界線は、次のとおりにしなければならない。大海からホル山まで線を引き、","tok":[["あなた"],["がた"],["の"],["北","きた"],["の"],["境界線","きょうかいせん"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["に"],["しなければ"],["ならない"],["。"],["大海","たいかい"],["から"],["ホル"],["山","やま"],["まで"],["線","せん"],["を"],["引き","ひき"],["、"]]},{"verse":8,"text":"さらにホル山からレボ・ハマテまで線を引き、その境界線の終わりはツェダデである。","tok":[["さらに"],["ホル"],["山","やま"],["から"],["レボ"],["・"],["ハマテ"],["まで"],["線","せん"],["を"],["引き","ひき"],["、"],["その"],["境界線","きょうかいせん"],["の"],["終わり","おわり"],["は"],["ツェダデ"],["で"],["ある"],["。"]]},{"verse":9,"text":"ついでその境界線は、ジフロンに延び、その終わりはハツァル・エナンである。これがあなたがたの北の境界線である。","tok":[["ついで"],["その"],["境界線","きょうかいせん"],["は"],["、"],["ジフロン"],["に"],["延び","のび"],["、"],["その"],["終わり","おわり"],["は"],["ハツァル"],["・"],["エナン"],["で"],["ある"],["。"],["これ"],["が"],["あなた"],["がた"],["の"],["北","きた"],["の"],["境界線","きょうかいせん"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたがたの東の境界線としては、ハツァル・エナンからシェファムまで線を引け。","tok":[["あなた"],["がた"],["の"],["東","ひがし"],["の"],["境界線","きょうかいせん"],["として"],["は"],["、"],["ハツァル"],["・"],["エナン"],["から"],["シェファム"],["まで"],["線","せん"],["を"],["引け","ひけ"],["。"]]},{"verse":11,"text":"その境界線は、シェファムからアインの東方のリブラに下り、さらに境界線は、そこから下ってキネレテの海の東の傾斜地に達し、","tok":[["その"],["境界線","きょうかいせん"],["は"],["、"],["シェファム"],["から"],["アイン"],["の"],["東方","とうほう"],["の"],["リブラ"],["に"],["下り","くだり"],["、"],["さらに"],["境界線","きょうかいせん"],["は"],["、"],["そこ"],["から"],["下って","くだって"],["キネレテ"],["の"],["海","うみ"],["の"],["東","ひがし"],["の"],["傾斜地","けいしゃち"],["に"],["達し","たっし"],["、"]]},{"verse":12,"text":"さらにその境界線は、ヨルダンに下り、その終わりは塩の海である。以上が周囲の境界線によるあなたがたの地である。」","tok":[["さらに"],["その"],["境界線","きょうかいせん"],["は"],["、"],["ヨルダン"],["に"],["下り","くだり"],["、"],["その"],["終わり","おわり"],["は"],["塩","しお"],["の"],["海","うみ"],["で"],["ある"],["。"],["以上","いじょう"],["が"],["周囲","しゅうい"],["の"],["境界線","きょうかいせん"],["に"],["よる"],["あなた"],["がた"],["の"],["地","ち"],["で"],["ある"],["。"],["」"]]},{"verse":13,"text":"モーセはイスラエル人に命じて言った。「これが、あなたがたがくじを引いて相続地とする土地である。主はこれを九部族と半部族に与えよと命じておられる。","tok":[["モーセ"],["は"],["イスラエル"],["人","にん"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["これ"],["が"],["、"],["あなた"],["がた"],["が"],["くじ"],["を"],["引いて","ひいて"],["相続","そうぞく"],["地","ち"],["と"],["する"],["土地","とち"],["で"]
[{"verse":1,"text":"そのとき、ミリヤムはアロンといっしょに、モーセがめとっていたクシュ人の女のことで彼を非難した。モーセがクシュ人の女をめとっていたからである。","tok":[["その"],["とき"],["、"],["ミリヤム"],["は"],["アロン"],["と"],["いっしょ"],["に"],["、"],["モーセ"],["が"],["めとって"],["いた"],["クシュ人","くしゅにん"],["の"],["女","おんな"],["の"],["こと"],["で"],["彼","かれ"],["を"],["非難","ひなん"],["した"],["。"],["モーセ"],["が"],["クシュ人","くしゅにん"],["の"],["女","おんな"],["を"],["めとって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"彼らは言った。「主はただモーセとだけ話されたのでしょうか。私たちとも話されたのではないでしょうか。」主はこれを聞かれた。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["ただ"],["モーセ"],["と"],["だけ"],["話された","はなされた"],["の"],["でしょう"],["か"],["。"],["私たち","わたしたち"],["と"],["も"],["話された","はなされた"],["ので"],["は"],["ないでしょう"],["か"],["。"],["」"],["主","ぬし"],["は"],["これ"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":3,"text":"さて、モーセという人は、地上のだれにもまさって非常に謙遜であった。","tok":[["さて"],["、"],["モーセ"],["と"],["いう"],["人","ひと"],["は"],["、"],["地上","ちじょう"],["の"],["だれ"],["に"],["も"],["まさって"],["非常","ひじょう"],["に"],["謙遜","けんそん"],["で"],["あった"],["。"]]},{"verse":4,"text":"そこで、主は突然、モーセとアロンとミリヤムに、「あなたがた三人は会見の天幕の所へ出よ」と言われたので、彼ら三人は出て行った。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["突然","とつぜん"],["、"],["モーセ"],["と"],["アロン"],["と"],["ミリヤム"],["に"],["、"],["「"],["あなた"],["がた"],["三人","さんにん"],["は"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["所","ところ"],["へ"],["出よ","でよ"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["彼","かれ"],["ら"],["三人","さんにん"],["は"],["出て","でて"],["行った","いった"],["。"]]},{"verse":5,"text":"主は雲の柱の中にあって降りて来られ、天幕の入口に立って、アロンとミリヤムを呼ばれた。ふたりが出て行くと、","tok":[["主","ぬし"],["は"],["雲","くも"],["の"],["柱","はしら"],["の"],["中","なか"],["に"],["あって"],["降りて","おりて"],["来られ","こられ"],["、"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["立って","たって"],["、"],["アロン"],["と"],["ミリヤム"],["を"],["呼ばれた","よばれた"],["。"],["ふたり"],["が"],["出て","でて"],["行く","いく"],["と"],["、"]]},{"verse":6,"text":"仰せられた。「わたしのことばを聞け。もし、あなたがたのひとりが預言者であるなら、主であるわたしは、幻の中でその者にわたしを知らせ、夢の中でその者に語る。","tok":[["仰せられた","おおせられた"],["。"],["「"],["わたし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["もし"],["、"],["あなた"],["がた"],["の"],["ひとり"],["が"],["預言者","よげんしゃ"],["で"],["あるなら"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["は"],["、"],["幻","まぼろし"],["の"],["中","なか"],["で"],["その"],["者","もの"],["に"],["わたし"],["を"],["知らせ","しらせ"],["、"],["夢","ゆめ"],["の"],["中","なか"],["で"],["その"],["者","もの"],["に"],["語る","かたる"],["。"]]},{"verse":7,"text":"しかしわたしのしもべモーセとはそうではない。彼はわたしの全家を通じて忠実な者である。","tok":[["しかし"],["わたし"],["の"],["しもべ"],["モーセ"],["と"],["は"],["そう"],["で"],["は"],["ない"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["全","ぜん"],["家","いえ"],["を"],["通じて","つうじて"],["忠実","ちゅうじつ"],["な"],["者","もの"],["で"],["ある"],["。"]]},{"verse":8,"text":"彼とは、わたしは口と口とで語り、明らかに語って、なぞで話すことはしない。彼はまた、主の姿を仰ぎ見ている。なぜ、あなたがたは、わたしのしもべモーセを恐れずに非難するのか。」","tok":[["彼","かれ"],["と"],["は"],["、"],["わたし"],["は"],["口","くち"],["と"],["口","くち"],["と"],["で"],["語り","かたり"],["、"],["明らか","あきらか"],["に"],["語って","かたって"],["、"],["なぞ"],["で"],["話す","はなす"],["こと"],["は"],["しない"],["。"],["彼","かれ"],["は"],["また"],["、"],["主","ぬし"],["の"],["姿","すがた"],["を"],["仰ぎ見て","あおぎみて"],["いる"],["。"],["なぜ"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["しもべ"],["モーセ"],["を"],["恐れず","おそれず"],["に"],["非難","ひなん"],["する"],["の"],["か"],["。"],["」"]]},{"verse":9,"text":"主の怒りが彼らに向かって燃え上がり、主は去って行かれた。","tok":[["主","ぬし"],["の"],["怒り","いかり"],["が"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["燃え上がり","もえあがり"],["、"],["主","ぬし"],["は"],["去って","さって"],["行かれた","いかれた"],["。"]]},{"verse":10,"text":"雲が天幕の上から離れ去ると、見よ、ミリヤムはツァラアトになり、雪のようになっていた。アロンがミリヤムのほうを振り向くと、見よ、彼女はツァラアトに冒されていた。","tok":[["雲","くも"],["が"],["天幕","てんまく"],["の"],["上","うえ"],["から"],["離れ去る","はなれさる"],["と"],["、"],["見よ","みよ"],["、"],["ミリヤム"],["は"],["ツァラアト"],["に"],["なり"],["、"],["雪","ゆき"],["の"],["よう"],["に"],["なって"],["いた"],["。"],["アロン"],["が"],["ミリヤム"],["の"],["ほう"],["を"],["振り向く","ふりむく"],["と"],["、"],["見よ","みよ"],["、"],["彼女","かのじょ"],["は"],["ツァラアト"],["に"],["冒されて","おかされて"],["いた"],["。"]]},{"verse":11,"text":"アロンはモーセに言った。「わが主よ。私たちが愚かで犯しました罪の罰をどうか、私たちに負わせないでください。","tok":[["アロン"],["は"],["モーセ"],["に"],["言った","いった"],["。"],["「"],["わが"],["主","ぬし"],["よ"],["。"],["私たち","わたしたち"],["が"],["愚か","おろか"],["で"],["犯しました","おかしました"],["罪","つみ"],["の"],["罰","ばつ"],["を"],["どう"],["か"],["、"],["私たち","わたしたち"],["に"],["負わせないで","おわせないで"],["ください"],["。"]]},{"verse":12,"text":"どうか、彼女を、その肉が半ば腐って母の胎から出て来る死人のようにしないでください。」","tok":[["どう"],["か"],["、"],["彼女","かのじょ"],["を"],["、"],["その"],["肉","にく"],["が"],["半ば","なかば"],["腐って","くさって"],["母","はは"],["の"],["胎","はら"],["から"],["出て","でて"],["来る","くる"],["死人","しにん"],["の"],["よう"],["に"],["しないで"],["ください"],["。"],["」"]]},{"verse":13,"text":"それで、モーセは主に叫んで言った。「神よ。どうか、彼女をいやしてください。」","tok":[["それ"],["で"],["、"],["モーセ"],["は"],["主に","おもに"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["神","かみ"],["よ"],["。"],["どう"],["か"],["、"],["彼女","かのじょ"],["を"],["いやして"],["ください"],["。"],["」"]]},{"verse":14,"text":"しかし主はモーセに言われた。「彼女の父が、彼女の顔につばきしてさえ、彼女は七日間、恥をかかせられたことになるではないか。彼女を七日間、宿営の外に締め出しておかなければならない。その後に彼女を連れ戻すことができる。」","tok":[["しかし"],["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["彼女","かのじょ"],["の"],["父","ちち"],["が"],["、"],["彼女","かのじょ"],["の"],["顔","かお"],["に"],["つばき"],["して"],["さえ"],["、"],["彼女","かのじょ"],["は"],["七","なな"],["日間","かかん"],["、"],["恥","はじ"],["を"],["かかせられた"],["こと"],["に"],["なるで"],["は"],["ない"],["か"],["。"],["彼女","かのじょ"],["を"],["七","なな"],["日間","かかん"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["締め出して","しめだして"],["おかなければ"],["ならない"],["。"],["その後","そのあと"],["に"],["彼女","かのじょ"],["を"],["連れ戻す","つれもどす"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":15,"text":"それでミリヤムは七日間、宿営の外に締め出された。民はミリヤムが連れ戻されるまで、旅立たなかった。","tok":[["それ"],["で"],["ミリヤム"],["は"],["七","なな"],["日間","かかん"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["締め出された","しめだされた"],["。"],["民","たみ"],["は"],["ミリヤム"],["が"],["連れ戻される","つれもどされる"],["まで"],["、"],["旅立たなかった","たびだたなかった"],["。"]]},{"verse":16,"text":"その後、民はハツェロテから旅立ち、パランの荒野に宿営した。","tok":[["その"],["後","ご"],["、"],["民","みん"],["は"],["ハツェロテ"],["から"],["旅立ち","たびだち"],["、"],["パラン"],["の"],["荒野","あらの"],["に"],["宿営","しゅくえい"],["した"],["。"]]}]
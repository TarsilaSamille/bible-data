[{"verse":1,"text":"さて、ヨセフの子マナセの一族のツェロフハデの娘たち――ツェロフハデはヘフェルの子、ヘフェルはギルアデの子、ギルアデはマキルの子、マキルはマナセの子――が進み出た。娘たちの名はマフラ、ノア、ホグラ、ミルカ、ティルツァであった。","tok":[["さて"],["、"],["ヨセフ"],["の"],["子","こ"],["マナセ"],["の"],["一族","いちぞく"],["の"],["ツェロフハデ"],["の"],["娘","むすめ"],["たち"],["―"],["―"],["ツェロフハデ"],["は"],["ヘフェル"],["の"],["子","こ"],["、"],["ヘフェル"],["は"],["ギルアデ"],["の"],["子","こ"],["、"],["ギルアデ"],["は"],["マキル"],["の"],["子","こ"],["、"],["マキル"],["は"],["マナセ"],["の"],["子","こ"],["―"],["―"],["が"],["進み出た","すすみでた"],["。"],["娘","むすめ"],["たち"],["の"],["名","な"],["は"],["マフラ"],["、"],["ノア"],["、"],["ホグラ"],["、"],["ミルカ"],["、"],["ティルツァ"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼女たちは、モーセと、祭司エルアザルと、族長たちと、全会衆との前、会見の天幕の入口に立って言った。","tok":[["彼女","かのじょ"],["たち"],["は"],["、"],["モーセ"],["と"],["、"],["祭司","さいし"],["エルアザル"],["と"],["、"],["族長","ぞくちょう"],["たち"],["と"],["、"],["全","ぜん"],["会衆","かいしゅう"],["と"],["の"],["前","まえ"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["立って","たって"],["言った","いった"],["。"]]},{"verse":3,"text":"「私たちの父は荒野で死にました。彼はコラの仲間と一つになって主に逆らった仲間には加わっていませんでしたが、自分の罪によって死にました。彼には男の子がなかったのです。","tok":[["「"],["私たち","わたしたち"],["の"],["父","ちち"],["は"],["荒野","こうや"],["で"],["死にました","しにました"],["。"],["彼","かれ"],["は"],["コラ"],["の"],["仲間","なかま"],["と"],["一","ひと"],["つ"],["に"],["なって"],["主に","おもに"],["逆らった","さからった"],["仲間","なかま"],["に"],["は"],["加わって","くわわって"],["いませんでした"],["が"],["、"],["自分","じぶん"],["の"],["罪","つみ"],["によって"],["死にました","しにました"],["。"],["彼","かれ"],["に"],["は"],["男の子","おとこのこ"],["が"],["なかった"],["の"],["です"],["。"]]},{"verse":4,"text":"男の子がなかったからといって、なぜ私たちの父の名がその氏族の間から削られるのでしょうか。私たちにも、父の兄弟たちの間で所有地を与えてください。」","tok":[["男の子","おとこのこ"],["が"],["なかった"],["から"],["と"],["いって"],["、"],["なぜ"],["私たち","わたしたち"],["の"],["父","ちち"],["の"],["名","な"],["が"],["その"],["氏族","しぞく"],["の"],["間","あいだ"],["から"],["削られる","けずられる"],["の"],["でしょう"],["か"],["。"],["私たち","わたしたち"],["に"],["も"],["、"],["父","ちち"],["の"],["兄弟","きょうだい"],["たち"],["の"],["間","あいだ"],["で"],["所有地","しょゆうち"],["を"],["与えて","あたえて"],["ください"],["。"],["」"]]},{"verse":5,"text":"そこでモーセは、彼女たちの訴えを、主の前に出した。","tok":[["そこ"],["で"],["モーセ"],["は"],["、"],["彼女","かのじょ"],["たち"],["の"],["訴え","うったえ"],["を"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["出した","だした"],["。"]]},{"verse":6,"text":"すると主はモーセに告げて仰せられた。","tok":[["する"],["と"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":7,"text":"「ツェロフハデの娘たちの言い分は正しい。あなたは必ず彼女たちに、その父の兄弟たちの間で、相続の所有地を与えなければならない。彼女たちにその父の相続地を渡せ。","tok":[["「"],["ツェロフハデ"],["の"],["娘","むすめ"],["たち"],["の"],["言い分","いいぶん"],["は"],["正しい","ただしい"],["。"],["あなた"],["は"],["必ず","かならず"],["彼女","かのじょ"],["たち"],["に"],["、"],["その"],["父","ちち"],["の"],["兄弟","きょうだい"],["たち"],["の"],["間","あいだ"],["で"],["、"],["相続","そうぞく"],["の"],["所有地","しょゆうち"],["を"],["与えなければ","あたえなければ"],["ならない"],["。"],["彼女","かのじょ"],["たち"],["に"],["その"],["父","ちち"],["の"],["相続","そうぞく"],["地","ち"],["を"],["渡せ","わたせ"],["。"]]},{"verse":8,"text":"あなたはイスラエル人に告げて言わなければならない。人が死に、その人に男の子がないときは、あなたがたはその相続地を娘に渡しなさい。","tok":[["あなた"],["は"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言わなければ","いわなければ"],["ならない"],["。"],["人","ひと"],["が"],["死に","しに"],["、"],["その"],["人","ひと"],["に"],["男の子","おとこのこ"],["が"],["ない"],["とき"],["は"],["、"],["あなた"],["がた"],["は"],["その"],["相続","そうぞく"],["地","ち"],["を"],["娘","むすめ"],["に"],["渡し","わたし"],["なさい"],["。"]]},{"verse":9,"text":"もし娘もないときには、その相続地を彼の兄弟たちに与えなさい。","tok":[["もし"],["娘","むすめ"],["も"],["ない"],["とき"],["に"],["は"],["、"],["その"],["相続","そうぞく"],["地","ち"],["を"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["に"],["与え","あたえ"],["なさい"],["。"]]},{"verse":10,"text":"もし兄弟たちもいないときには、その相続地を彼の父の兄弟たちに与えなさい。","tok":[["もし"],["兄弟","きょうだい"],["たち"],["も"],["いない"],["とき"],["に"],["は"],["、"],["その"],["相続","そうぞく"],["地","ち"],["を"],["彼","かれ"],["の"],["父","ちち"],["の"],["兄弟","きょうだい"],["たち"],["に"],["与え","あたえ"],["なさい"],["。"]]},{"verse":11,"text":"もしその父に兄弟がないときには、その相続地を彼の氏族の中で、彼に一番近い血縁の者に与え、それを受け継がせなさい。これを、主がモーセに命じられたとおり、イスラエル人のための定まったおきてとしなさい。」","tok":[["もし"],["その"],["父","ちち"],["に"],["兄弟","きょうだい"],["が"],["ない"],["とき"],["に"],["は"],["、"],["その"],["相続","そうぞく"],["地","ち"],["を"],["彼","かれ"],["の"],["氏族","しぞく"],["の"],["中","なか"],["で"],["、"],["彼","かれ"],["に"],["一番","いちばん"],["近い","ちかい"],["血縁","けつえん"],["の"],["者","もの"],["に"],["与え","あたえ"],["、"],["それ"],["を"],["受け継がせ","うけつがせ"],["なさい"],["。"],["これ"],["を"],["、"],["主","ぬし"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["、"],["イスラエル"],["人","にん"],["の"],["ため"],["の"],["定まった","さだまった"],["おきて"],["と"],["し"],["なさい"],["。"],["」"]]},{"verse":12,"text":"ついで主はモーセに言われた。「このアバリム山に登り、わたしがイスラエル人に与えた地を見よ。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["この"],["アバリム"],["山","さん"],["に"],["登り","のぼり"],["、"],["わたし"],["が"],["イスラエル"],["人","にん"],["に"],["与えた","あたえた"],["地","ち"],["を"],["見よ","みよ"],["。"]]},{"verse":13,"text":"それを見れば、あなたもまた、あなたの兄弟アロンが加えられたように、あなたの民に加えられる。","tok":[["それ"],["を"],["見れば","みれば"],["、"],["あなた"],["も"],["また"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["アロン"],["が"],["加えられた","くわえられた"],["よう"],["に"],["、"],["あなた"],["の"],["民","たみ"],["に"],["加えられる","くわえられる"],["。"]]},{"verse":14,"text":"ツィンの荒野で会衆が争ったとき、あなたがたがわたしの命令に逆らい、その水のほとりで、彼らの目の前に、わたしを聖なる者としなかったからである。」これはツィンの荒野のメリバテ・カデシュの水のことである。","tok":[["ツィン"],["の"],["荒野","あらの"],["で"],["会衆","かいしゅう"],["が"],["争った","あらそった"],["とき"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["命令","めいれい"],["に"],["逆らい","さからい"],["、"],["その"],["水","みず"],["の"],["ほとり"],["で"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["に"],["、"],["わたし"],["を"],["聖","せい"],["なる"],["者","もの"],["と"],["しなかった"],["から"],["で"],["ある"],["。"],["」"],["これ"],["は"],["ツィン"],["の"],["荒野","あらの"],["の"],["メリバテ"],["・"],["カデシュ"],["の"],["水","みず"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":15,"text":"それでモーセは主に申し上げた。","tok":[["それ"],["で"],["モーセ"],["は"],["主に","おもに"],["申し上げた","もうしあげた"],["。"]]},{"verse":16,"text":"「すべての肉なるもののいのちの神、主よ。ひとりの人を会衆の上に定め、","tok":[["「"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["の"],["いのち"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["ひとり"],["の"],["人","ひと"],["を"],["会衆","かいしゅう"],["の"],["上","うえ"],["に"],["定め","さだめ"],["、"]]},{"verse":17,"text":"彼が、彼らに先立って出て行き、彼らに先立って入り、また彼らを連れ出し、彼らを入らせるようにしてください。主の会衆を、飼う者のいない羊のようにしないでください。」","tok":[["彼","かれ"],["が"],["、"],["彼","かれ"],["ら"],["に"],["先立って","さきだって"],["出て","でて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["に"],["先立って","さきだって"],["入り","はいり"],["、"],["また"],["彼","かれ"],["ら"],["を"],["連れ出し","つれだし"],["、"],["彼","かれ"],["ら"],["を"],["入らせる","はいらせる"],["よう"],["に"],["して"],["ください"],["。"],["主","ぬし"],["の"],["会衆","かいしゅう"],["を"],["、"],["飼う","かう"],["者","もの"],["の"],["いない"],["羊","ひつじ"],["の"],["よう"],["に"],["しないで"],["ください"],["。"],["」"]]},{"verse":18,"text":"主はモーセに仰せられた。「あなたは神の霊の宿っている人、ヌンの子ヨシュアを取り、あなたの手を彼の上に置け。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["神","かみ"],["の"],["霊","れい"],["の"],["宿って","やどって"],["いる"],["人","ひと"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["を"],["取り","とり"],["、"],["あなた"],["の"],["手","て"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["置け","おけ"],["。"]]},{"verse":19,"text":"彼を祭司エルアザルと全会衆の前に立たせ、彼らの見ているところで彼を任命せよ。","tok":[["彼","かれ"],["を"],["祭司","さいし"],["エルアザル"],["と"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立たせ","たたせ"],["、"],["彼","かれ"],["ら"],["の"],["見て","みて"],["いる"],["ところ"],["で"],["彼","かれ"],["を"],["任命","にんめい"],["せよ"],["。"]]},{"verse":20,"text":"あなたは、自分の権威を彼に分け与え、イスラエル人の全会衆を彼に聞き従わせよ。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["権威","けんい"],["を"],["彼","かれ"],["に"],["分け与え","わけあたえ"],["、"],["イスラエル"],["人","にん"],["の"],["全","ぜん"],["会衆","かいしゅう"],["を"],["彼","かれ"],["に"],["聞き従わせ","ききしたがわせ"],["よ"],["。"]]},{"verse":21,"text":"彼は祭司エルアザルの前に立ち、エルアザルは彼のために主の前でウリムによるさばきを求めなければならない。ヨシュアと彼とともにいるイスラエルのすべての者、すなわち全会衆は、エルアザルの命令によって出、また、彼の命令によって、入らなければならない。」","tok":[["彼","かれ"],["は"],["祭司","さいし"],["エルアザル"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["エルアザル"],["は"],["彼","かれ"],["の"],["ため"],["に"],["主","ぬし"],["の"],["前","まえ"],["で"],["ウリム"],["に"],["よる"],["さばき"],["を"],["求めなければ","もとめなければ"],["ならない"],["。"],["ヨシュア"],["と"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["イスラエル"],["の"],["すべて"],["の"],["者","もの"],["、"],["すなわち"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["エルアザル"],["の"],["命令","めいれい"],["によって"],["出","で"],["、"],["また"],["、"],["彼","かれ"],["の"],["命令","めいれい"],["によって"],["、"],["入らなければ","はいらなければ"],["ならない"],["。"],["」"]]},{"verse":22,"text":"モーセは主が命じられたとおりに行った。ヨシュアを取って、彼を祭司エルアザルと全会衆の前に立たせ、","tok":[["モーセ"],["は"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"],["ヨシュア"],["を"],["取って","とって"],["、"],["彼","かれ"],["を"],["祭司","さいし"],["エルアザル"],["と"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立たせ","たたせ"],["、"]]},{"verse":23,"text":"自分の手を彼の上に置いて、主がモーセを通して告げられたとおりに彼を任命した。","tok":[["自分","じぶん"],["の"],["手","て"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["置いて","おいて"],["、"],["主","ぬし"],["が"],["モーセ"],["を"],["通して","とおして"],["告げられた","つげられた"],["とおり"],["に"],["彼","かれ"],["を"],["任命","にんめい"],["した"],["。"]]}]
[{"verse":1,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「人々を遣わして、わたしがイスラエル人に与えようとしているカナンの地を探らせよ。父祖の部族ごとにひとりずつ、みな、その族長を遣わさなければならない。」","tok":[["「"],["人々","ひとびと"],["を"],["遣わして","つかわして"],["、"],["わたし"],["が"],["イスラエル"],["人","にん"],["に"],["与えよう","あたえよう"],["として"],["いる"],["カナン"],["の"],["地","ち"],["を"],["探らせ","さぐらせ"],["よ"],["。"],["父祖","ふそ"],["の"],["部族","ぶぞく"],["ごと"],["に"],["ひとり"],["ずつ"],["、"],["みな"],["、"],["その"],["族長","ぞくちょう"],["を"],["遣わさなければ","つかわさなければ"],["ならない"],["。"],["」"]]},{"verse":3,"text":"モーセは主の命によって、パランの荒野から彼らを遣わした。彼らはみな、イスラエル人のかしらであった。","tok":[["モーセ"],["は"],["主","ぬし"],["の"],["命","いのち"],["によって"],["、"],["パラン"],["の"],["荒野","あらの"],["から"],["彼","かれ"],["ら"],["を"],["遣わした","つかわした"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["イスラエル"],["人","にん"],["の"],["かしら"],["で"],["あった"],["。"]]},{"verse":4,"text":"彼らの名は次のとおりであった。ルベン部族からはザクルの子シャムア。","tok":[["彼","かれ"],["ら"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["あった"],["。"],["ルベン"],["部族","ぶぞく"],["から"],["は"],["ザクル"],["の"],["子","こ"],["シャムア"],["。"]]},{"verse":5,"text":"シメオン部族からはホリの子シャファテ。","tok":[["シメオン"],["部族","ぶぞく"],["から"],["は"],["ホリ"],["の"],["子","こ"],["シャファテ"],["。"]]},{"verse":6,"text":"ユダ部族からはエフネの子カレブ。","tok":[["ユダ"],["部族","ぶぞく"],["から"],["は"],["エフネ"],["の"],["子","こ"],["カレブ"],["。"]]},{"verse":7,"text":"イッサカル部族からはヨセフの子イグアル。","tok":[["イッサカル"],["部族","ぶぞく"],["から"],["は"],["ヨセフ"],["の"],["子","こ"],["イグアル"],["。"]]},{"verse":8,"text":"エフライム部族からはヌンの子ホセア。","tok":[["エフライム"],["部族","ぶぞく"],["から"],["は"],["ヌン"],["の"],["子","こ"],["ホセア"],["。"]]},{"verse":9,"text":"ベニヤミン部族からはラフの子パルティ。","tok":[["ベニヤミン"],["部族","ぶぞく"],["から"],["は"],["ラフ"],["の"],["子","こ"],["パルティ"],["。"]]},{"verse":10,"text":"ゼブルン部族からはソディの子ガディエル。","tok":[["ゼブルン"],["部族","ぶぞく"],["から"],["は"],["ソディ"],["の"],["子","こ"],["ガディエル"],["。"]]},{"verse":11,"text":"ヨセフ部族、すなわちマナセ部族からはスシの子ガディ。","tok":[["ヨセフ"],["部族","ぶぞく"],["、"],["すなわち"],["マナセ"],["部族","ぶぞく"],["から"],["は"],["スシ"],["の"],["子","こ"],["ガディ"],["。"]]},{"verse":12,"text":"ダン部
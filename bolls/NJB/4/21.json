[{"verse":1,"text":"ネゲブに住んでいたカナン人アラデの王は、イスラエルがアタリムの道を進んで来ると聞いて、イスラエルと戦い、その何人かを捕虜として捕らえて行った。","tok":[["ネゲブ"],["に"],["住んで","すんで"],["いた"],["カナン人","かなんにん"],["アラデ"],["の"],["王","おう"],["は"],["、"],["イスラエル"],["が"],["アタリム"],["の"],["道","みち"],["を"],["進んで","すすんで"],["来る","くる"],["と"],["聞いて","きいて"],["、"],["イスラエル"],["と"],["戦い","たたかい"],["、"],["その"],["何人","なんにん"],["か"],["を"],["捕虜","ほりょ"],["として"],["捕らえて","とらえて"],["行った","いった"],["。"]]},{"verse":2,"text":"そこでイスラエルは主に誓願をして言った。「もし、確かにあなたが私の手に、この民を渡してくださるなら、私は彼らの町々を聖絶いたします。」","tok":[["そこ"],["で"],["イスラエル"],["は"],["主に","おもに"],["誓願","せいがん"],["を"],["して"],["言った","いった"],["。"],["「"],["もし"],["、"],["確か","たしか"],["に"],["あなた"],["が"],["私","わたくし"],["の"],["手","て"],["に"],["、"],["この"],["民","たみ"],["を"],["渡して","わたして"],["くださるなら"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["の"],["町々","まちまち"],["を"],["聖","せい"],["絶","ぜっ"],["いたします"],["。"],["」"]]},{"verse":3,"text":"主はイスラエルの願いを聞き入れ、カナン人を渡されたので、彼らはカナン人と彼らの町々を聖絶した。そしてその所の名をホルマと呼んだ。","tok":[["主","ぬし"],["は"],["イスラエル"],["の"],["願い","ねがい"],["を"],["聞き入れ","ききいれ"],["、"],["カナン人","かなんにん"],["を"],["渡された","わたされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["カナン人","かなんにん"],["と"],["彼","かれ"],["ら"],["の"],["町々","まちまち"],["を"],["聖","せい"],["絶した","ぜっした"],["。"],["そして"],["その"],["所","ところ"],["の"],["名","な"],["を"],["ホルマ"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":4,"text":"彼らはホル山から、エドムの地を迂回して、葦の海の道に旅立った。しかし民は、途中でがまんができなくなり、","tok":[["彼","かれ"],["ら"],["は"],["ホル"],["山","やま"],["から"],["、"],["エドム"],["の"],["地","ち"],["を"],["迂回","うかい"],["して"],["、"],["葦","あし"],["の"],["海","うみ"],["の"],["道","みち"],["に"],["旅立った","たびだった"],["。"],["しかし"],["民","みん"],["は"],["、"],["途中","とちゅう"],["で"],["がまん"],["が"],["できなく"],["なり"],["、"]]},{"verse":5,"text":"民は神とモーセに逆らって言った。「なぜ、あなたがたは私たちをエジプトから連れ上って、この荒野で死なせようとするのか。パンもなく、水もない。私たちはこのみじめな食物に飽き飽きした。」","tok":[["民","みん"],["は"],["神","かみ"],["と"],["モーセ"],["に"],["逆らって","さからって"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["あなた"],["がた"],["は"],["私たち","わたしたち"],["を"],["エジプト"],["から"],["連れ上って","つれのぼって"],["、"],["この"],["荒野","こうや"],["で"],["死なせよう","しなせよう"],["と"],["する"],["の"],["か"],["。"],["パン"],["も"],["なく"],["、"],["水","みず"],["も"],["ない"],["。"],["私たち","わたしたち"],["は"],["この"],["みじめ"],["な"],["食物","しょくもつ"],["に"],["飽き飽き","あきあき"],["した"],["。"],["」"]]},{"verse":6,"text":"そこで主は民の中に燃える蛇を送られたので、蛇は民にかみつき、イスラエルの多くの人々が死んだ。","tok":[["そこ"],["で"],["主","ぬし"],["は"],["民","みん"],["の"],["中","なか"],["に"],["燃える","もえる"],["蛇","へび"],["を"],["送られた","おくられた"],["ので"],["、"],["蛇","へび"],["は"],["民","みん"],["に"],["かみつき"],["、"],["イスラエル"],["の"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["死んだ","しんだ"],["。"]]},{"verse":7,"text":"民はモーセのところに来て言った。「私たちは主とあなたを非難して罪を犯しました。どうか、蛇を私たちから取り去ってくださるよう、主に祈ってください。」モーセは民のために祈った。","tok":[["民","みん"],["は"],["モーセ"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["主","ぬし"],["と"],["あなた"],["を"],["非難","ひなん"],["して"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["どう"],["か"],["、"],["蛇","へび"],["を"],["私たち","わたしたち"],["から"],["取り去って","とりさって"],["くださる"],["よう"],["、"],["主に","おもに"],["祈って","いのって"],["ください"],["。"],["」"],["モーセ"],["は"],["民","みん"],["の"],["ため"],["に"],["祈った","いのった"],["。"]]},{"verse":8,"text":"すると、主はモーセに仰せられた。「あなたは燃える蛇を作り、それを旗ざおの上につけよ。すべてかまれた者は、それを仰ぎ見れば、生きる。」","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["燃える","もえる"],["蛇","へび"],["を"],["作り","つくり"],["、"],["それ"],["を"],["旗ざお","はたざお"],["の"],["上","うえ"],["に"],["つけよ"],["。"],["すべて"],["かまれた"],["者","もの"],["は"],["、"],["それ"],["を"],["仰ぎ見れば","あおぎみれば"],["、"],["生きる","いきる"],["。"],["」"]]},{"verse":9,"text":"モーセは一つの青銅の蛇を作り、それを旗ざおの上につけた。もし蛇が人をかんでも、その者が青銅の蛇を仰ぎ見ると、生きた。","tok":[["モーセ"],["は"],["一","ひと"],["つ"],["の"],["青銅","せいどう"],["の"],["蛇","へび"],["を"],["作り","つくり"],["、"],["それ"],["を"],["旗ざお","はたざお"],["の"],["上","うえ"],["に"],["つけた"],["。"],["もし"],["蛇","へび"],["が"],["人","ひと"],["を"],["かん"],["で"],["も"],["、"],["その"],["者","もの"],["が"],["青銅","せいどう"],["の"],["蛇","へび"],["を"],["仰ぎ見る","あおぎみる"],["と"],["、"],["生きた","いきた"],["。"]]},{"verse":10,"text":"イスラエル人は旅立って、オボテで宿営した。","tok":[["イスラエル"],["人","にん"],["は"],["旅立って","たびだって"],["、"],["オボテ"],["で"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":11,"text":"彼らはオボテから旅立って、日の上る方、モアブに面した荒野にあるイエ・ハアバリムに宿営した。","tok":[["彼","かれ"],["ら"],["は"],["オボテ"],["から"],["旅立って","たびだって"],["、"],["日","ひ"],["の"],["上る","のぼる"],["方","かた"],["、"],["モアブ"],["に"],["面した","めんした"],["荒野","あらの"],["に"],["ある"],["イエ"],["・"],["ハアバリム"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":12,"text":"そこから旅立って、ゼレデの谷に宿営し、","tok":[["そこ"],["から"],["旅立って","たびだって"],["、"],["ゼレデ"],["の"],["谷","たに"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":13,"text":"さらにそこから旅立って、エモリ人の国境から広がっている荒野にあるアルノン川の向こう側に宿営した。アルノン川がモアブとエモリ人との間の、モアブの国境であるためである。","tok":[["さらに"],["そこ"],["から"],["旅立って","たびだって"],["、"],["エモリ人","えもりにん"],["の"],["国境","こっきょう"],["から"],["広がって","ひろがって"],["いる"],["荒野","あらの"],["に"],["ある"],["アルノン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["に"],["宿営","しゅくえい"],["した"],["。"],["アルノン"],["川","かわ"],["が"],["モアブ"],["と"],["エモリ人","えもりにん"],["と"],["の"],["間","あいだ"],["の"],["、"],["モアブ"],["の"],["国境","こっきょう"],["で"],["ある"],["ため"],["で"],["ある"],["。"]]},{"verse":14,"text":"それで、「主の戦いの書」にこう言われている。「スパのワヘブとアルノンの谷川とともに、","tok":[["それ"],["で"],["、"],["「"],["主","ぬし"],["の"],["戦い","たたかい"],["の"],["書","しょ"],["」"],["に"],["こう"],["言われて","いわれて"],["いる"],["。"],["「"],["スパ"],["の"],["ワヘブ"],["と"],["アルノン"],["の"],["谷川","たにがわ"],["と"],["とも"],["に"],["、"]]},{"verse":15,"text":"谷川の支流は、アルの定住地に達し、モアブの領土をささえている。」","tok":[["谷川","たにがわ"],["の"],["支流","しりゅう"],["は"],["、"],["アル"],["の"],["定住","ていじゅう"],["地","ち"],["に"],["達し","たっし"],["、"],["モアブ"],["の"],["領土","りょうど"],["を"],["ささえて"],["いる"],["。"],["」"]]},{"verse":16,"text":"彼らはそこからベエルに向かった。それは主がモーセに、「民を集めよ。わたしが彼らに水を与える」と言われた井戸である。","tok":[["彼","かれ"],["ら"],["は"],["そこ"],["から"],["ベエル"],["に"],["向かった","むかった"],["。"],["それ"],["は"],["主","ぬし"],["が"],["モーセ"],["に"],["、"],["「"],["民","みん"],["を"],["集めよ","あつめよ"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["水","みず"],["を"],["与える","あたえる"],["」"],["と"],["言われた","いわれた"],["井戸","いど"],["で"],["ある"],["。"]]},{"verse":17,"text":"そのとき、イスラエルはこの歌を歌った。「わきいでよ。井戸。――このために歌え――","tok":[["その"],["とき"],["、"],["イスラエル"],["は"],["この"],["歌","うた"],["を"],["歌った","うたった"],["。"],["「"],["わき"],["いで"],["よ"],["。"],["井戸","いど"],["。"],["―"],["―"],["この"],["ため"],["に"],["歌え","うたえ"],["―"],["―"]]},{"verse":18,"text":"笏をもって、杖をもって、つかさたちがうがち、民の尊き者たちが掘ったその井戸に。」彼らは荒野からマタナに進み、","tok":[["笏","しゃく"],["を"],["もって"],["、"],["杖","つえ"],["を"],["もって"],["、"],["つかさ"],["たち"],["が"],["うがち"],["、"],["民","みん"],["の"],["尊き","とうとき"],["者","もの"],["たち"],["が"],["掘った","ほった"],["その"],["井戸","いど"],["に"],["。"],["」"],["彼","かれ"],["ら"],["は"],["荒野","こうや"],["から"],["マタナ"],["に"],["進み","すすみ"],["、"]]},{"verse":19,"text":"マタナからナハリエルに、ナハリエルからバモテに、","tok":[["マタナ"],["から"],["ナハリエル"],["に"],["、"],["ナハリエル"],["から"],["バモテ"],["に"],["、"]]},{"verse":20,"text":"バモテからモアブの野にある谷に行き、荒地を見おろすピスガの頂に着いた。","tok":[["バモテ"],["から"],["モアブ"],["の"],["野","の"],["に"],["ある"],["谷","たに"],["に"],["行き","いき"],["、"],["荒地","あれち"],["を"],["見おろす","みおろす"],["ピスガ"],["の"],["頂","いただき"],["に"],["着いた","ついた"],["。"]]},{"verse":21,"text":"イスラエルはエモリ人の王シホンに使者たちを送って言った。","tok":[["イスラエル"],["は"],["エモリ人","えもりにん"],["の"],["王","おう"],["シホン"],["に"],["使者","ししゃ"],["たち"],["を"],["送って","おくって"],["言った","いった"],["。"]]},{"verse":22,"text":"「あなたの国を通らせてください。私たちは畑にもぶどう畑にも曲がって入ることをせず、井戸の水も飲みません。あなたの領土を通過するまで、私たちは王の道を通ります。」","tok":[["「"],["あなた"],["の"],["国","くに"],["を"],["通らせて","とおらせて"],["ください"],["。"],["私たち","わたしたち"],["は"],["畑","はたけ"],["に"],["も"],["ぶどう"],["畑","はたけ"],["に"],["も"],["曲がって","まがって"],["入る","はいる"],["こと"],["を"],["せず"],["、"],["井戸","いど"],["の"],["水","みず"],["も"],["飲みません","のみません"],["。"],["あなた"],["の"],["領土","りょうど"],["を"],["通過","つうか"],["する"],["まで"],["、"],["私たち","わたしたち"],["は"],["王","おう"],["の"],["道","みち"],["を"],["通ります","とおります"],["。"],["」"]]},{"verse":23,"text":"しかし、シホンはイスラエルが自分の領土を通ることを許さなかった。シホンはその民をみな集めて、イスラエルを迎え撃つために荒野に出て来た。そしてヤハツに来て、イスラエルと戦った。","tok":[["しかし"],["、"],["シホン"],["は"],["イスラエル"],["が"],["自分","じぶん"],["の"],["領土","りょうど"],["を"],["通る","とおる"],["こと"],["を"],["許さなかった","ゆるさなかった"],["。"],["シホン"],["は"],["その"],["民","たみ"],["を"],["みな"],["集めて","あつめて"],["、"],["イスラエル"],["を"],["迎え撃つ","むかえうつ"],["ため"],["に"],["荒野","あらの"],["に"],["出て","でて"],["来た","きた"],["。"],["そして"],["ヤハツ"],["に"],["来て","きて"],["、"],["イスラエル"],["と"],["戦った","たたかった"],["。"]]},{"verse":24,"text":"イスラエルは剣の刃で彼を打ち、その地をアルノンからヤボクまで、アモン人の国境まで占領した。アモン人の国境は堅固だったからである。","tok":[["イスラエル"],["は"],["剣","けん"],["の"],["刃","は"],["で"],["彼","かれ"],["を"],["打ち","うち"],["、"],["その"],["地","ち"],["を"],["アルノン"],["から"],["ヤボク"],["まで"],["、"],["アモン人","あもんにん"],["の"],["国境","こっきょう"],["まで"],["占領","せんりょう"],["した"],["。"],["アモン人","あもんにん"],["の"],["国境","こっきょう"],["は"],["堅固","けんご"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"イスラエルはこれらの町々をすべて取った。そしてイスラエルはエモリ人のすべての町々、ヘシュボンとそれに属するすべての村落に住みついた。","tok":[["イスラエル"],["は"],["これ"],["ら"],["の"],["町々","まちまち"],["を"],["すべて"],["取った","とった"],["。"],["そして"],["イスラエル"],["は"],["エモリ人","えもりにん"],["の"],["すべて"],["の"],["町々","まちまち"],["、"],["ヘシュボン"],["と"],["それ"],["に"],["属する","ぞくする"],["すべて"],["の"],["村落","そんらく"],["に"],["住みついた","すみついた"],["。"]]},{"verse":26,"text":"ヘシュボンはエモリ人の王、シホンの町であった。彼はモアブの以前の王と戦って、その手からその全土をアルノンまで取っていた。","tok":[["ヘシュボン"],["は"],["エモリ人","えもりにん"],["の"],["王","おう"],["、"],["シホン"],["の"],["町","まち"],["で"],["あった"],["。"],["彼","かれ"],["は"],["モアブ"],["の"],["以前","いぜん"],["の"],["王","おう"],["と"],["戦って","たたかって"],["、"],["その"],["手","て"],["から"],["その"],["全土","ぜんど"],["を"],["アルノン"],["まで"],["取って","とって"],["いた"],["。"]]},{"verse":27,"text":"それで、ことわざを唱える者たちが歌っている。「来たれ、ヘシュボンに。シホンの町は建てられ、堅くされている。","tok":[["それ"],["で"],["、"],["ことわざ"],["を"],["唱える","となえる"],["者","もの"],["たち"],["が"],["歌って","うたって"],["いる"],["。"],["「"],["来たれ","きたれ"],["、"],["ヘシュボン"],["に"],["。"],["シホン"],["の"],["町","まち"],["は"],["建てられ","たてられ"],["、"],["堅く","かたく"],["されて"],["いる"],["。"]]},{"verse":28,"text":"ヘシュボンから火が出、シホンの町から炎が出て、モアブのアルを焼き尽くし、アルノンにそびえる高地を焼き尽くしたからだ。","tok":[["ヘシュボン"],["から"],["火","ひ"],["が"],["出","で"],["、"],["シホン"],["の"],["町","まち"],["から"],["炎","ほのお"],["が"],["出て","でて"],["、"],["モアブ"],["の"],["アル"],["を"],["焼き","やき"],["尽くし","つくし"],["、"],["アルノン"],["に"],["そびえる"],["高地","こうち"],["を"],["焼き","やき"],["尽くした","つくした"],["から"],["だ"],["。"]]},{"verse":29,"text":"モアブよ。おまえはわざわいだ。ケモシュの民よ。おまえは滅びうせる。その息子たちは逃亡者、娘たちは捕らわれの身である。エモリ人の王シホンによって。","tok":[["モアブ"],["よ"],["。"],["おまえ"],["は"],["わざわい"],["だ"],["。"],["ケモシュ"],["の"],["民","たみ"],["よ"],["。"],["おまえ"],["は"],["滅び","ほろび"],["うせる"],["。"],["その"],["息子","むすこ"],["たち"],["は"],["逃亡者","とうぼうしゃ"],["、"],["娘","むすめ"],["たち"],["は"],["捕らわれ","とらわれ"],["の"],["身","み"],["で"],["ある"],["。"],["エモリ人","えもりにん"],["の"],["王","おう"],["シホン"],["によって"],["。"]]},{"verse":30,"text":"しかしわれわれは彼らを投げ倒した。ヘシュボンからディボンに至るまで滅びうせた。われわれはノファフまでも荒らし、それはメデバにまで及んだ。」","tok":[["しかし"],["われわれ"],["は"],["彼","かれ"],["ら"],["を"],["投げ倒した","なげたおした"],["。"],["ヘシュボン"],["から"],["ディボン"],["に"],["至る","いたる"],["まで"],["滅び","ほろび"],["うせた"],["。"],["われわれ"],["は"],["ノファフ"],["まで"],["も"],["荒らし","あらし"],["、"],["それ"],["は"],["メデバ"],["に"],["まで"],["及んだ","およんだ"],["。"],["」"]]},{"verse":31,"text":"こうしてイスラエルはエモリ人の地に住んだ。","tok":[["こう"],["して"],["イスラエル"],["は"],["エモリ人","えもりにん"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["。"]]},{"verse":32,"text":"そのとき、モーセはまた人をやって、ヤゼルを探らせ、ついにそれに属する村落を攻め取り、そこにいたエモリ人を追い出した。","tok":[["その"],["とき"],["、"],["モーセ"],["は"],["また"],["人","ひと"],["を"],["やって"],["、"],["ヤゼル"],["を"],["探らせ","さぐらせ"],["、"],["ついに"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["を"],["攻め取り","せめとり"],["、"],["そこ"],["に"],["いた"],["エモリ人","えもりにん"],["を"],["追い出した","おいだした"],["。"]]},{"verse":33,"text":"さらに彼らは進んでバシャンへの道を上って行ったが、バシャンの王オグはそのすべての民とともに出て来た。彼らを迎え撃ち、エデレイで戦うためであった。","tok":[["さらに"],["彼","かれ"],["ら"],["は"],["進んで","すすんで"],["バシャン"],["へ"],["の"],["道","みち"],["を"],["上って","のぼって"],["行った","いった"],["が"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["は"],["その"],["すべて"],["の"],["民","たみ"],["と"],["とも"],["に"],["出て","でて"],["来た","きた"],["。"],["彼","かれ"],["ら"],["を"],["迎え撃ち","むかえうち"],["、"],["エデレイ"],["で"],["戦う","たたかう"],["ため"],["で"],["あった"],["。"]]},{"verse":34,"text":"しかし、主はモーセに言われた。「彼を恐れてはならない。わたしは彼とそのすべての民とその地とをあなたの手のうちに与えた。あなたがヘシュボンに住んでいたエモリ人の王シホンに対して行ったように、彼に対しても行え。」","tok":[["しかし"],["、"],["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["彼","かれ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["と"],["その"],["すべて"],["の"],["民","たみ"],["と"],["その"],["地","ち"],["と"],["を"],["あなた"],["の"],["手","て"],["の"],["うち"],["に"],["与えた","あたえた"],["。"],["あなた"],["が"],["ヘシュボン"],["に"],["住んで","すんで"],["いた"],["エモリ人","えもりにん"],["の"],["王","おう"],["シホン"],["に対して","にたいして"],["行った","いった"],["よう"],["に"],["、"],["彼","かれ"],["に対して","にたいして"],["も"],["行え","おこなえ"],["。"],["」"]]},{"verse":35,"text":"そこで彼らは彼とその子らとそのすべての民とを打ち殺し、ひとりの生存者も残さなかった。こうして彼らはその地を占領した。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["と"],["その"],["子","こ"],["ら"],["と"],["その"],["すべて"],["の"],["民","たみ"],["と"],["を"],["打ち殺し","うちころし"],["、"],["ひとり"],["の"],["生存者","せいぞんしゃ"],["も"],["残さなかった","のこさなかった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["その"],["地","ち"],["を"],["占領","せんりょう"],["した"],["。"]]}]
[{"verse":1,"text":"バラムはイスラエルを祝福することが主の御心にかなうのを見、これまでのように、まじないを求めに行くことをせず、その顔を荒野に向けた。","tok":[["バラム"],["は"],["イスラエル"],["を"],["祝福","しゅくふく"],["する"],["こと"],["が"],["主","ぬし"],["の"],["御心","おこころ"],["に"],["かなう"],["の"],["を"],["見","み"],["、"],["これ"],["まで"],["の"],["よう"],["に"],["、"],["まじない"],["を"],["求め","もとめ"],["に"],["行く","いく"],["こと"],["を"],["せず"],["、"],["その"],["顔","かお"],["を"],["荒野","あらの"],["に"],["向けた","むけた"],["。"]]},{"verse":2,"text":"バラムが目を上げて、イスラエルがその部族ごとに宿っているのをながめたとき、神の霊が彼の上に臨んだ。","tok":[["バラム"],["が"],["目","め"],["を"],["上げて","あげて"],["、"],["イスラエル"],["が"],["その"],["部族","ぶぞく"],["ごと"],["に"],["宿って","やどって"],["いる"],["の"],["を"],["ながめた"],["とき"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":3,"text":"彼は彼のことわざを唱えて言った。「ベオルの子バラムの告げたことば。目のひらけた者の告げたことば。","tok":[["彼","かれ"],["は"],["彼","かれ"],["の"],["ことわざ"],["を"],["唱えて","となえて"],["言った","いった"],["。"],["「"],["ベオル"],["の"],["子","こ"],["バラム"],["の"],["告げた","つげた"],["ことば"],["。"],["目","め"],["の"],["ひらけた"],["者","もの"],["の"],["告げた","つげた"],["ことば"],["。"]]},{"verse":4,"text":"神の御告げを聞く者、全能者の幻を見る者、ひれ伏して、目のおおいを除かれた者の告げたことば。","tok":[["神","かみ"],["の"],["御告げ","おつげ"],["を"],["聞く","きく"],["者","もの"],["、"],["全能者","ぜんのうしゃ"],["の"],["幻","まぼろし"],["を"],["見る","みる"],["者","もの"],["、"],["ひれ伏して","ひれふして"],["、"],["目","め"],["の"],["おおい"],["を"],["除かれた","のぞかれた"],["者","もの"],["の"],["告げた","つげた"],["ことば"],["。"]]},{"verse":5,"text":"なんと美しいことよ。ヤコブよ、あなたの天幕は。イスラエルよ、あなたの住まいは。","tok":[["なん"],["と"],["美しい","うつくしい"],["こと"],["よ"],["。"],["ヤコブ"],["よ"],["、"],["あなた"],["の"],["天幕","てんまく"],["は"],["。"],["イスラエル"],["よ"],["、"],["あなた"],["の"],["住まい","すまい"],["は"],["。"]]},{"verse":6,"text":"それは、延び広がる谷間のように、川辺の園のように、主が植えたアロエのように、水辺の杉の木のように。","tok":[["それ"],["は"],["、"],["延び広がる","のびひろがる"],["谷間","たにま"],["の"],["よう"],["に"],["、"],["川辺","かわべ"],["の"],["園","その"],["の"],["よう"],["に"],["、"],["主","ぬし"],["が"],["植えた","うえた"],["アロエ"],["の"],["よう"],["に"],["、"],["水辺","みずべ"],["の"],["杉","すぎ"],["の"],["木","き"],["の"],["よう"],["に"],["。"]]},{"verse":7,"text":"その手おけからは水があふれ、その種は豊かな水に潤う。その王はアガグよりも高くなり、その王国はあがめられる。","tok":[["その"],["手おけ","ておけ"],["から"],["は"],["水","みず"],["が"],["あふれ"],["、"],["その"],["種","たね"],["は"],["豊か","ゆたか"],["な"],["水","みず"],["に"],["潤う","うるおう"],["。"],["その"],["王","おう"],["は"],["アガグ"],["より"],["も"],["高く","たかく"],["なり"],["、"],["その"],["王国","おうこく"],["は"],["あがめられる"],["。"]]},{"verse":8,"text":"彼をエジプトから連れ出した神は、彼にとっては野牛の角のようだ。彼はおのれの敵の国々を食い尽くし、彼らの骨を砕き、彼らの矢を粉々にする。","tok":[["彼","かれ"],["を"],["エジプト"],["から"],["連れ出した","つれだした"],["神","かみ"],["は"],["、"],["彼","かれ"],["にとって"],["は"],["野牛","やぎゅう"],["の"],["角","かど"],["の"],["よう"],["だ"],["。"],["彼","かれ"],["は"],["おのれ"],["の"],["敵","てき"],["の"],["国々","くにぐに"],["を"],["食い","くい"],["尽くし","つくし"],["、"],["彼","かれ"],["ら"],["の"],["骨","ほね"],["を"],["砕き","くだき"],["、"],["彼","かれ"],["ら"],["の"],["矢","や"],["を"],["粉々","こなごな"],["に"],["する"],["。"]]},{"verse":9,"text":"雄獅子のように、また雌獅子のように、彼はうずくまり、身を横たえる。だれがこれを起こすことができよう。あなたを祝福する者は祝福され、あなたをのろう者はのろわれる。」","tok":[["雄","ゆう"],["獅子","しし"],["の"],["よう"],["に"],["、"],["また"],["雌","めす"],["獅子","しし"],["の"],["よう"],["に"],["、"],["彼","かれ"],["は"],["うずくまり"],["、"],["身","み"],["を"],["横たえる","よこたえる"],["。"],["だれ"],["が"],["これ"],["を"],["起こす","おこす"],["こと"],["が"],["できよう"],["。"],["あなた"],["を"],["祝福","しゅくふく"],["する"],["者","もの"],["は"],["祝福","しゅくふく"],["され"],["、"],["あなた"],["を"],["の"],["ろう者","ろうしゃ"],["は"],["のろわれる"],["。"],["」"]]},{"verse":10,"text":"そこでバラクはバラムに対して怒りを燃やし、手を打ち鳴らした。バラクはバラムに言った。「私の敵をのろうためにあなたを招いたのに、かえってあなたは三度までも彼らを祝福した。","tok":[["そこ"],["で"],["バラク"],["は"],["バラム"],["に対して","にたいして"],["怒り","いかり"],["を"],["燃やし","もやし"],["、"],["手","て"],["を"],["打ち鳴らした","うちならした"],["。"],["バラク"],["は"],["バラム"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["敵","てき"],["を"],["のろう"],["ため"],["に"],["あなた"],["を"],["招いた","まねいた"],["のに"],["、"],["かえって"],["あなた"],["は"],["三","さん"],["度","ど"],["まで"],["も"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":11,"text":"今、あなたは自分のところに下がれ。私はあなたを手厚くもてなすつもりでいたが、主がもう、そのもてなしを拒まれたのだ。」","tok":[["今","いま"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["ところ"],["に"],["下がれ","さがれ"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["手厚く","てあつく"],["もてなす"],["つもり"],["で"],["いた"],["が"],["、"],["主","ぬし"],["が"],["もう"],["、"],["その"],["もてなし"],["を"],["拒まれた","こばまれた"],["の"],["だ"],["。"],["」"]]},{"verse":12,"text":"バラムはバラクに言った。「私はあなたがよこされた使者たちにこう言ったではありませんか。","tok":[["バラム"],["は"],["バラク"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["あなた"],["が"],["よこされた"],["使者","ししゃ"],["たち"],["に"],["こう"],["言ったで","いったで"],["は"],["ありません"],["か"],["。"]]},{"verse":13,"text":"『たとい、バラクが私に銀や金の満ちた彼の家をくれても、主のことばにそむいては、善でも悪でも、私の心のままにすることはできません。主が告げられること、それを私は告げなければなりません。』","tok":[["『"],["たとい"],["、"],["バラク"],["が"],["私","わたくし"],["に"],["銀","ぎん"],["や"],["金","きん"],["の"],["満ちた","みちた"],["彼","かれ"],["の"],["家","いえ"],["を"],["くれて"],["も"],["、"],["主","ぬし"],["の"],["ことば"],["に"],["そむいて"],["は"],["、"],["善","ぜん"],["で"],["も"],["悪","わる"],["で"],["も"],["、"],["私","わたくし"],["の"],["心","こころ"],["の"],["まま"],["に"],["する"],["こと"],["は"],["できません"],["。"],["主","ぬし"],["が"],["告げられる","つげられる"],["こと"],["、"],["それ"],["を"],["私","わたくし"],["は"],["告げなければ","つげなければ"],["なりません"],["。"],["』"]]},{"verse":14,"text":"今、私は私の民のところに帰ります。さあ、私は、この民が後の日にあなたの民に行おうとしていることをあなたのために申し上げましょう。」","tok":[["今","いま"],["、"],["私","わたくし"],["は"],["私","わたくし"],["の"],["民","たみ"],["の"],["ところ"],["に"],["帰ります","かえります"],["。"],["さあ"],["、"],["私","わたくし"],["は"],["、"],["この"],["民","たみ"],["が"],["後","あと"],["の"],["日","ひ"],["に"],["あなた"],["の"],["民","たみ"],["に"],["行おう","おこなおう"],["として"],["いる"],["こと"],["を"],["あなた"],["の"],["ため"],["に"],["申し上げましょう","もうしあげましょう"],["。"],["」"]]},{"verse":15,"text":"そして彼のことわざを唱えて言った。「ベオルの子バラムの告げたことば。目のひらけた者の告げたことば。","tok":[["そして"],["彼","かれ"],["の"],["ことわざ"],["を"],["唱えて","となえて"],["言った","いった"],["。"],["「"],["ベオル"],["の"],["子","こ"],["バラム"],["の"],["告げた","つげた"],["ことば"],["。"],["目","め"],["の"],["ひらけた"],["者","もの"],["の"],["告げた","つげた"],["ことば"],["。"]]},{"verse":16,"text":"神の御告げを聞く者、いと高き方の知識を知る者、全能者の幻を見る者、ひれ伏して、目のおおいを除かれた者の告げたことば。","tok":[["神","かみ"],["の"],["御告げ","おつげ"],["を"],["聞く","きく"],["者","もの"],["、"],["いと"],["高き","たかき"],["方","ほう"],["の"],["知識","ちしき"],["を"],["知る","しる"],["者","もの"],["、"],["全能者","ぜんのうしゃ"],["の"],["幻","まぼろし"],["を"],["見る","みる"],["者","もの"],["、"],["ひれ伏して","ひれふして"],["、"],["目","め"],["の"],["おおい"],["を"],["除かれた","のぞかれた"],["者","もの"],["の"],["告げた","つげた"],["ことば"],["。"]]},{"verse":17,"text":"私は見る。しかし今ではない。私は見つめる。しかし間近ではない。ヤコブから一つの星が上り、イスラエルから一本の杖が起こり、モアブのこめかみと、すべての騒ぎ立つ者の脳天を打ち砕く。","tok":[["私","わたくし"],["は"],["見る","みる"],["。"],["しかし"],["今","いま"],["で"],["は"],["ない"],["。"],["私","わたくし"],["は"],["見つめる","みつめる"],["。"],["しかし"],["間近","まじか"],["で"],["は"],["ない"],["。"],["ヤコブ"],["から"],["一","ひと"],["つ"],["の"],["星","ほし"],["が"],["上り","のぼり"],["、"],["イスラエル"],["から"],["一本","いちぽん"],["の"],["杖","つえ"],["が"],["起こり","おこり"],["、"],["モアブ"],["の"],["こめかみ"],["と"],["、"],["すべて"],["の"],["騒ぎ立つ","さわぎたつ"],["者","もの"],["の"],["脳天","のうてん"],["を"],["打ち砕く","うちくだく"],["。"]]},{"verse":18,"text":"その敵、エドムは所有地となり、セイルも所有地となる。イスラエルは力ある働きをする。","tok":[["その"],["敵","てき"],["、"],["エドム"],["は"],["所有地","しょゆうち"],["と"],["なり"],["、"],["セイル"],["も"],["所有地","しょゆうち"],["と"],["なる"],["。"],["イスラエル"],["は"],["力","ちから"],["ある"],["働き","はたらき"],["を"],["する"],["。"]]},{"verse":19,"text":"ヤコブから出る者が治め、残った者たちを町から消し去る。」","tok":[["ヤコブ"],["から"],["出る","でる"],["者","もの"],["が"],["治め","おさめ"],["、"],["残った","のこった"],["者","もの"],["たち"],["を"],["町","まち"],["から"],["消し去る","けしさる"],["。"],["」"]]},{"verse":20,"text":"彼はアマレクを見渡して彼のことわざを唱えて言った。「アマレクは国々の中で首位のもの。しかしその終わりは滅びに至る。」","tok":[["彼","かれ"],["は"],["アマレク"],["を"],["見渡して","みわたして"],["彼","かれ"],["の"],["ことわざ"],["を"],["唱えて","となえて"],["言った","いった"],["。"],["「"],["アマレク"],["は"],["国々","くにぐに"],["の"],["中","なか"],["で"],["首位","しゅい"],["の"],["もの"],["。"],["しかし"],["その"],["終わり","おわり"],["は"],["滅び","ほろび"],["に"],["至る","いたる"],["。"],["」"]]},{"verse":21,"text":"彼はケニ人を見渡して彼のことわざを唱えて言った。「あなたの住みかは堅固であり、あなたの巣は岩間の中に置かれている。","tok":[["彼","かれ"],["は"],["ケニ"],["人","ひと"],["を"],["見渡して","みわたして"],["彼","かれ"],["の"],["ことわざ"],["を"],["唱えて","となえて"],["言った","いった"],["。"],["「"],["あなた"],["の"],["住みか","すみか"],["は"],["堅固","けんご"],["で"],["あり"],["、"],["あなた"],["の"],["巣","す"],["は"],["岩間","いわま"],["の"],["中","なか"],["に"],["置かれて","おかれて"],["いる"],["。"]]},{"verse":22,"text":"しかし、カインは滅ぼし尽くされ、ついにはアシュルがあなたをとりこにする。」","tok":[["しかし"],["、"],["カイン"],["は"],["滅ぼし","ほろぼし"],["尽くされ","つくされ"],["、"],["ついに"],["は"],["アシュル"],["が"],["あなた"],["を"],["とりこ"],["に"],["する"],["。"],["」"]]},{"verse":23,"text":"彼はまた彼のことわざを唱えて言った。「ああ、神が定められたなら、だれが生きのびることができよう。","tok":[["彼","かれ"],["は"],["また"],["彼","かれ"],["の"],["ことわざ"],["を"],["唱えて","となえて"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["が"],["定められたなら","さだめられたなら"],["、"],["だれ"],["が"],["生きのびる","いきのびる"],["こと"],["が"],["できよう"],["。"]]},{"verse":24,"text":"船がキティムの岸から来て、アシュルを悩まし、エベルを悩ます。しかし、これもまた滅びに至る。」","tok":[["船","ふね"],["が"],["キティム"],["の"],["岸","きし"],["から"],["来て","きて"],["、"],["アシュル"],["を"],["悩まし","なやまし"],["、"],["エベル"],["を"],["悩ます","なやます"],["。"],["しかし"],["、"],["これ"],["も"],["また"],["滅び","ほろび"],["に"],["至る","いたる"],["。"],["」"]]},{"verse":25,"text":"それからバラムは立って自分のところへ帰って行った。バラクもまた帰途についた。","tok":[["それ"],["から"],["バラム"],["は"],["立って","たって"],["自分","じぶん"],["の"],["ところ"],["へ"],["帰って","かえって"],["行った","いった"],["。"],["バラク"],["も"],["また"],["帰途","きと"],["に"],["ついた"],["。"]]}]
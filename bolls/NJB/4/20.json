[{"verse":1,"text":"イスラエル人の全会衆は、第一の月にツィンの荒野に着いた。そこで民はカデシュにとどまった。ミリヤムはそこで死んで葬られた。","tok":[["イスラエル"],["人","にん"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["第","だい"],["一","いち"],["の"],["月","つき"],["に"],["ツィン"],["の"],["荒野","あらの"],["に"],["着いた","ついた"],["。"],["そこ"],["で"],["民","たみ"],["は"],["カデシュ"],["に"],["とどまった"],["。"],["ミリヤム"],["は"],["そこ"],["で"],["死んで","しんで"],["葬られた","ほうむられた"],["。"]]},{"verse":2,"text":"ところが会衆のためには水がなかったので、彼らは集まってモーセとアロンとに逆らった。","tok":[["ところ"],["が"],["会衆","かいしゅう"],["の"],["ため"],["に"],["は"],["水","みず"],["が"],["なかった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["集まって","あつまって"],["モーセ"],["と"],["アロン"],["と"],["に"],["逆らった","さからった"],["。"]]},{"verse":3,"text":"民はモーセと争って言った。「ああ、私たちの兄弟たちが主の前で死んだとき、私たちも死んでいたのなら。","tok":[["民","みん"],["は"],["モーセ"],["と"],["争って","あらそって"],["言った","いった"],["。"],["「"],["ああ"],["、"],["私たち","わたしたち"],["の"],["兄弟","きょうだい"],["たち"],["が"],["主","ぬし"],["の"],["前","まえ"],["で"],["死んだ","しんだ"],["とき"],["、"],["私たち","わたしたち"],["も"],["死んで","しんで"],["いた"],["の"],["なら"],["。"]]},{"verse":4,"text":"なぜ、あなたがたは主の集会をこの荒野に引き入れて、私たちと、私たちの家畜をここで死なせようとするのか。","tok":[["なぜ"],["、"],["あなた"],["がた"],["は"],["主","ぬし"],["の"],["集会","しゅうかい"],["を"],["この"],["荒野","こうや"],["に"],["引き入れて","ひきいれて"],["、"],["私たち","わたしたち"],["と"],["、"],["私たち","わたしたち"],["の"],["家畜","かちく"],["を"],["ここ"],["で"],["死なせよう","しなせよう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":5,"text":"なぜ、あなたがたは私たちをエジプトから上らせて、この悪い所に引き入れたのか。ここは穀物も、いちじくも、ぶどうも、ざくろも育つような所ではない。そのうえ、飲み水さえない。」","tok":[["なぜ"],["、"],["あなた"],["がた"],["は"],["私たち","わたしたち"],["を"],["エジプト"],["から"],["上らせて","のぼらせて"],["、"],["この"],["悪い","わるい"],["所","ところ"],["に"],["引き入れた","ひきいれた"],["の"],["か"],["。"],["ここ"],["は"],["穀物","こくもつ"],["も"],["、"],["いちじく"],["も"],["、"],["ぶどう"],["も"],["、"],["ざくろ"],["も"],["育つ","そだつ"],["よう"],["な"],["所","ところ"],["で"],["は"],["ない"],["。"],["その"],["うえ"],["、"],["飲み水","のみみず"],["さえ"],["ない"],["。"],["」"]]},{"verse":6,"text":"モーセとアロンは集会の前から去り、会見の天幕の入口に行ってひれ伏した。すると主の栄光が彼らに現れた。","tok":[["モーセ"],["と"],["アロン"],["は"],["集会","しゅうかい"],["の"],["前","まえ"],["から"],["去り","さり"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["行って","いって"],["ひれ伏した","ひれふした"],["。"],["する"],["と"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["彼","かれ"],["ら"],["に"],["現れた","あらわれた"],["。"]]},{"verse":7,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":8,"text":"「杖を取れ。あなたとあなたの兄弟アロンは、会衆を集めよ。あなたがたが彼らの目の前で岩に命じれば、岩は水を出す。あなたは、彼らのために岩から水を出し、会衆とその家畜に飲ませよ。」","tok":[["「"],["杖","つえ"],["を"],["取れ","とれ"],["。"],["あなた"],["と"],["あなた"],["の"],["兄弟","きょうだい"],["アロン"],["は"],["、"],["会衆","かいしゅう"],["を"],["集めよ","あつめよ"],["。"],["あなた"],["がた"],["が"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["岩","いわ"],["に"],["命じれば","めいじれば"],["、"],["岩","いわ"],["は"],["水","みず"],["を"],["出す","だす"],["。"],["あなた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["岩","いわ"],["から"],["水","みず"],["を"],["出し","だし"],["、"],["会衆","かいしゅう"],["と"],["その"],["家畜","かちく"],["に"],["飲ませ","のませ"],["よ"],["。"],["」"]]},{"verse":9,"text":"そこでモーセは、主が彼に命じられたとおりに、主の前から杖を取った。","tok":[["そこ"],["で"],["モーセ"],["は"],["、"],["主","ぬし"],["が"],["彼","かれ"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["主","ぬし"],["の"],["前","まえ"],["から"],["杖","つえ"],["を"],["取った","とった"],["。"]]},{"verse":10,"text":"そしてモーセとアロンは岩の前に集会を召集して、彼らに言った。「逆らう者たちよ。さあ、聞け。この岩から私たちがあなたがたのために水を出さなければならないのか。」","tok":[["そして"],["モーセ"],["と"],["アロン"],["は"],["岩","いわ"],["の"],["前","まえ"],["に"],["集会","しゅうかい"],["を"],["召集","しょうしゅう"],["して"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["逆らう","さからう"],["者","もの"],["たち"],["よ"],["。"],["さあ"],["、"],["聞け","きけ"],["。"],["この"],["岩","いわ"],["から"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["水","みず"],["を"],["出さなければ","ださなければ"],["ならない"],["の"],["か"],["。"],["」"]]},{"verse":11,"text":"モーセは手を上げ、彼の杖で岩を二度打った。すると、たくさんの水がわき出たので、会衆もその家畜も飲んだ。","tok":[["モーセ"],["は"],["手","て"],["を"],["上げ","あげ"],["、"],["彼","かれ"],["の"],["杖","つえ"],["で"],["岩","いわ"],["を"],["二","に"],["度","ど"],["打った","うった"],["。"],["する"],["と"],["、"],["たくさん"],["の"],["水","みず"],["が"],["わき出た","わきでた"],["ので"],["、"],["会衆","かいしゅう"],["も"],["その"],["家畜","かちく"],["も"],["飲んだ","のんだ"],["。"]]},{"verse":12,"text":"しかし、主はモーセとアロンに言われた。「あなたがたはわたしを信ぜず、わたしをイスラエルの人々の前に聖なる者としなかった。それゆえ、あなたがたは、この集会を、わたしが彼らに与えた地に導き入れることはできない。」","tok":[["しかし"],["、"],["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["は"],["わたし"],["を"],["信ぜず","しんぜず"],["、"],["わたし"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["聖","せい"],["なる"],["者","もの"],["と"],["しなかった"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["、"],["この"],["集会","しゅうかい"],["を"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["与えた","あたえた"],["地","ち"],["に"],["導き入れる","みちびきいれる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":13,"text":"これがメリバの水、イスラエル人が主と争ったことによるもので、主がこれによってご自身を、聖なる者として示されたのである。","tok":[["これ"],["が"],["メリバ"],["の"],["水","みず"],["、"],["イスラエル"],["人","にん"],["が"],["主","ぬし"],["と"],["争った","あらそった"],["こと"],["に"],["よる"],["もの"],["で"],["、"],["主","ぬし"],["が"],["これ"],["によって"],["ご自身","ごじしん"],["を"],["、"],["聖","せい"],["なる"],["者","もの"],["として"],["示された","しめされた"],["ので"],["ある"],["。"]]},{"verse":14,"text":"さて、モーセはカデシュからエドムの王のもとに使者たちを送った。「あなたの兄弟、イスラエルはこう申します。あなたは私たちに降りかかったすべての困難をご存じです。","tok":[["さて"],["、"],["モーセ"],["は"],["カデシュ"],["から"],["エドム"],["の"],["王","おう"],["の"],["もと"],["に"],["使者","ししゃ"],["たち"],["を"],["送った","おくった"],["。"],["「"],["あなた"],["の"],["兄弟","きょうだい"],["、"],["イスラエル"],["は"],["こう"],["申します","もうします"],["。"],["あなた"],["は"],["私たち","わたしたち"],["に"],["降りかかった","ふりかかった"],["すべて"],["の"],["困難","こんなん"],["を"],["ご存じ","ごぞんじ"],["です"],["。"]]},{"verse":15,"text":"私たちの先祖たちはエジプトに下り、私たちはエジプトに長年住んでいました。しかしエジプトは私たちや先祖たちを、虐待しました。","tok":[["私たち","わたしたち"],["の"],["先祖","せんぞ"],["たち"],["は"],["エジプト"],["に"],["下り","くだり"],["、"],["私たち","わたしたち"],["は"],["エジプト"],["に"],["長年","ながねん"],["住んで","すんで"],["いました"],["。"],["しかし"],["エジプト"],["は"],["私たち","わたしたち"],["や"],["先祖","せんぞ"],["たち"],["を"],["、"],["虐待","ぎゃくたい"],["しました"],["。"]]},{"verse":16,"text":"そこで、私たちが主に叫ぶと、主は私たちの声を聞いて、ひとりの御使いを遣わし、私たちをエジプトから連れ出されました。今、私たちはあなたの領土の境にある町、カデシュにおります。","tok":[["そこ"],["で"],["、"],["私たち","わたしたち"],["が"],["主に","おもに"],["叫ぶ","さけぶ"],["と"],["、"],["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["、"],["ひとり"],["の"],["御使い","おつかい"],["を"],["遣わし","つかわし"],["、"],["私たち","わたしたち"],["を"],["エジプト"],["から"],["連れ出されました","つれだされました"],["。"],["今","いま"],["、"],["私たち","わたしたち"],["は"],["あなた"],["の"],["領土","りょうど"],["の"],["境","さかい"],["に"],["ある"],["町","まち"],["、"],["カデシュ"],["に"],["おります"],["。"]]},{"verse":17,"text":"どうか、あなたの国を通らせてください。私たちは、畑もぶどう畑も通りません。井戸の水も飲みません。私たちは王の道を行き、あなたの領土を通過するまでは右にも左にも曲がりません。」","tok":[["どう"],["か"],["、"],["あなた"],["の"],["国","くに"],["を"],["通らせて","とおらせて"],["ください"],["。"],["私たち","わたしたち"],["は"],["、"],["畑","はたけ"],["も"],["ぶどう"],["畑","はたけ"],["も"],["通りません","とおりません"],["。"],["井戸","いど"],["の"],["水","みず"],["も"],["飲みません","のみません"],["。"],["私たち","わたしたち"],["は"],["王","おう"],["の"],["道","みち"],["を"],["行き","いき"],["、"],["あなた"],["の"],["領土","りょうど"],["を"],["通過","つうか"],["する"],["まで"],["は"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["曲がりません","まがりません"],["。"],["」"]]},{"verse":18,"text":"しかし、エドムはモーセに言った。「私のところを通ってはならない。さもないと、私は剣をもっておまえを迎え撃とう。」","tok":[["しかし"],["、"],["エドム"],["は"],["モーセ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["ところ"],["を"],["通って","とおって"],["は"],["ならない"],["。"],["さも"],["ない"],["と"],["、"],["私","わたくし"],["は"],["剣","けん"],["を"],["もって"],["おまえ"],["を"],["迎え撃とう","むかえうとう"],["。"],["」"]]},{"verse":19,"text":"イスラエル人は彼に言った。「私たちは公道を上って行きます。私たちと私たちの家畜があなたの水を飲むことがあれば、その代価を払います。ただ、歩いて通り過ぎるだけです。」","tok":[["イスラエル"],["人","にん"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["公道","こうどう"],["を"],["上って","のぼって"],["行きます","いきます"],["。"],["私たち","わたしたち"],["と"],["私たち","わたしたち"],["の"],["家畜","かちく"],["が"],["あなた"],["の"],["水","みず"],["を"],["飲む","のむ"],["こと"],["が"],["あれば"],["、"],["その"],["代価","だいか"],["を"],["払います","はらいます"],["。"],["ただ"],["、"],["歩いて","あるいて"],["通り過ぎる","とおりすぎる"],["だけ"],["です"],["。"],["」"]]},{"verse":20,"text":"しかし、エドムは、「通ってはならない」と言って、強力な大軍勢を率いて彼らを迎え撃つために出て来た。","tok":[["しかし"],["、"],["エドム"],["は"],["、"],["「"],["通って","かよって"],["は"],["ならない"],["」"],["と"],["言って","いって"],["、"],["強力","きょうりょく"],["な"],["大","だい"],["軍勢","ぐんぜい"],["を"],["率いて","ひきいて"],["彼","かれ"],["ら"],["を"],["迎え撃つ","むかえうつ"],["ため"],["に"],["出て","でて"],["来た","きた"],["。"]]},{"verse":21,"text":"こうして、エドムはイスラエルにその領土を通らせようとしなかったので、イスラエルは彼の所から方向を変えて去った。","tok":[["こう"],["して"],["、"],["エドム"],["は"],["イスラエル"],["に"],["その"],["領土","りょうど"],["を"],["通らせよう","とおらせよう"],["と"],["しなかった"],["ので"],["、"],["イスラエル"],["は"],["彼","かれ"],["の"],["所","ところ"],["から"],["方向","ほうこう"],["を"],["変えて","かえて"],["去った","さった"],["。"]]},{"verse":22,"text":"こうしてイスラエル人の全会衆は、カデシュから旅立ってホル山に着いた。","tok":[["こう"],["して"],["イスラエル"],["人","にん"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["カデシュ"],["から"],["旅立って","たびだって"],["ホル"],["山","やま"],["に"],["着いた","ついた"],["。"]]},{"verse":23,"text":"主は、エドムの国の領土にあるホル山で、モーセとアロンに告げて仰せられた。","tok":[["主","ぬし"],["は"],["、"],["エドム"],["の"],["国","くに"],["の"],["領土","りょうど"],["に"],["ある"],["ホル"],["山","やま"],["で"],["、"],["モーセ"],["と"],["アロン"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":24,"text":"「アロンは民に加えられる。しかし彼は、わたしがイスラエル人に与えた地に入ることはできない。それはメリバの水のことで、あなたがたがわたしの命令に逆らったからである。","tok":[["「"],["アロン"],["は"],["民","みん"],["に"],["加えられる","くわえられる"],["。"],["しかし"],["彼","かれ"],["は"],["、"],["わたし"],["が"],["イスラエル"],["人","にん"],["に"],["与えた","あたえた"],["地","ち"],["に"],["入る","はいる"],["こと"],["は"],["できない"],["。"],["それ"],["は"],["メリバ"],["の"],["水","みず"],["の"],["こと"],["で"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["命令","めいれい"],["に"],["逆らった","さからった"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"あなたはアロンと、その子エルアザルを連れてホル山に登れ。","tok":[["あなた"],["は"],["アロン"],["と"],["、"],["その"],["子","こ"],["エルアザル"],["を"],["連れて","つれて"],["ホル"],["山","やま"],["に"],["登れ","のぼれ"],["。"]]},{"verse":26,"text":"アロンにその衣服を脱がせ、これをその子エルアザルに着せよ。アロンは先祖の民に加えられ、そこで死ぬ。」","tok":[["アロン"],["に"],["その"],["衣服","いふく"],["を"],["脱がせ","ぬがせ"],["、"],["これ"],["を"],["その"],["子","こ"],["エルアザル"],["に"],["着せ","きせ"],["よ"],["。"],["アロン"],["は"],["先祖","せんぞ"],["の"],["民","たみ"],["に"],["加えられ","くわえられ"],["、"],["そこ"],["で"],["死ぬ","しぬ"],["。"],["」"]]},{"verse":27,"text":"モーセは、主が命じられたとおりに行った。全会衆の見ている前で、彼らはホル山に登って行った。","tok":[["モーセ"],["は"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"],["全","ぜん"],["会衆","かいしゅう"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["ホル"],["山","やま"],["に"],["登って","のぼって"],["行った","いった"],["。"]]},{"verse":28,"text":"モーセはアロンにその衣服を脱がせ、それをその子エルアザルに着せた。そしてアロンはその山の頂で死んだ。モーセとエルアザルが山から降りて来たとき、","tok":[["モーセ"],["は"],["アロン"],["に"],["その"],["衣服","いふく"],["を"],["脱がせ","ぬがせ"],["、"],["それ"],["を"],["その"],["子","こ"],["エルアザル"],["に"],["着せた","きせた"],["。"],["そして"],["アロン"],["は"],["その"],["山","やま"],["の"],["頂","いただき"],["で"],["死んだ","しんだ"],["。"],["モーセ"],["と"],["エルアザル"],["が"],["山","やま"],["から"],["降りて","おりて"],["来た","きた"],["とき"],["、"]]},{"verse":29,"text":"全会衆はアロンが息絶えたのを知った。そのためイスラエルの全家は三十日の間、アロンのために泣き悲しんだ。","tok":[["全","ぜん"],["会衆","かいしゅう"],["は"],["アロン"],["が"],["息","いき"],["絶えた","たえた"],["の"],["を"],["知った","しった"],["。"],["その"],["ため"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["は"],["三十日","さんとうか"],["の"],["間","あいだ"],["、"],["アロン"],["の"],["ため"],["に"],["泣き悲しんだ","なきかなしんだ"],["。"]]}]
[{"verse":1,"text":"レビの子ケハテの子であるイツハルの子コラは、ルベンの子孫であるエリアブの子ダタンとアビラム、およびペレテの子オンと共謀して、","tok":[["レビ"],["の"],["子","こ"],["ケハテ"],["の"],["子","こ"],["で"],["ある"],["イツハル"],["の"],["子","こ"],["コラ"],["は"],["、"],["ルベン"],["の"],["子孫","しそん"],["で"],["ある"],["エリアブ"],["の"],["子","こ"],["ダタン"],["と"],["アビラム"],["、"],["および"],["ペレテ"],["の"],["子","こ"],["オン"],["と"],["共謀","きょうぼう"],["して"],["、"]]},{"verse":2,"text":"会衆の上に立つ人たちで、会合で選び出された名のある者たち二百五十人のイスラエル人とともに、モーセに立ち向かった。","tok":[["会衆","かいしゅう"],["の"],["上","うえ"],["に"],["立つ","たつ"],["人","ひと"],["たち"],["で"],["、"],["会合","かいごう"],["で"],["選び出された","えらびだされた"],["名","な"],["の"],["ある"],["者","もの"],["たち"],["二百五","にひゃくご"],["十人","じゅうにん"],["の"],["イスラエル"],["人","にん"],["と"],["とも"],["に"],["、"],["モーセ"],["に"],["立ち向かった","たちむかった"],["。"]]},{"verse":3,"text":"彼らは集まって、モーセとアロンとに逆らい、彼らに言った。「あなたがたは分を越えている。全会衆残らず聖なるものであって、主がそのうちにおられるのに、なぜ、あなたがたは、主の集会の上に立つのか。」","tok":[["彼","かれ"],["ら"],["は"],["集まって","あつまって"],["、"],["モーセ"],["と"],["アロン"],["と"],["に"],["逆らい","さからい"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["分","ぶん"],["を"],["越えて","こえて"],["いる"],["。"],["全","ぜん"],["会衆","かいしゅう"],["残らず","のこらず"],["聖","せい"],["なる"],["もの"],["で"],["あって"],["、"],["主","ぬし"],["が"],["その"],["うち"],["に"],["おられる"],["のに"],["、"],["なぜ"],["、"],["あなた"],["がた"],["は"],["、"],["主","ぬし"],["の"],["集会","しゅうかい"],["の"],["上","うえ"],["に"],["立つ","たつ"],["の"],["か"],["。"],["」"]]},{"verse":4,"text":"モーセはこれを聞いてひれ伏した。","tok":[["モーセ"],["は"],["これ"],["を"],["聞いて","きいて"],["ひれ伏した","ひれふした"],["。"]]},{"verse":5,"text":"それから、コラとそのすべての仲間とに告げて言った。「あしたの朝、主は、だれがご自分のものか、だれが聖なるものかをお示しになり、その者をご自分に近づけられる。主は、ご自分が選ぶ者をご自分に近づけられるのだ。","tok":[["それ"],["から"],["、"],["コラ"],["と"],["その"],["すべて"],["の"],["仲間","なかま"],["と"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["あした"],["の"],["朝","あさ"],["、"],["主","ぬし"],["は"],["、"],["だれ"],["が"],["ご自分","ごじぶん"],["の"],["もの"],["か"],["、"],["だれ"],["が"],["聖","せい"],["なる"],["もの"],["か"],["を"],["お示し","おしめし"],["に"],["なり"],["、"],["その"],["者","もの"],["を"],["ご自分","ごじぶん"],["に"],["近づけられる","ちかづけられる"],["。"],["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["が"],["選ぶ","えらぶ"],["者","もの"],["を"],["ご自分","ごじぶん"],["に"],["近づけられる","ちかづけられる"],["の"],["だ"],["。"]]},{"verse":6,"text":"こうしなさい。コラとその仲間のすべてよ。あなたがたは火皿を取り、","tok":[["こう"],["し"],["なさい"],["。"],["コラ"],["と"],["その"],["仲間","なかま"],["の"],["すべて"],["よ"],["。"],["あなた"],["がた"],["は"],["火皿","ひざら"],["を"],["取り","とり"],["、"]]},{"verse":7,"text":"あす、主の前でその中に火を入れ、その上に香を盛りなさい。主がお選びになるその人が聖なるものである。レビの子たちよ。あなたがたが分を越えているのだ。」","tok":[["あす"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["その"],["中","なか"],["に"],["火","ひ"],["を"],["入れ","いれ"],["、"],["その"],["上","うえ"],["に"],["香","こう"],["を"],["盛り","もり"],["なさい"],["。"],["主","ぬし"],["が"],["お選び","おえらび"],["に"],["なる"],["その"],["人","ひと"],["が"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["。"],["レビ"],["の"],["子","こ"],["たち"],["よ"],["。"],["あなた"],["がた"],["が"],["分","ぶん"],["を"],["越えて","こえて"],["いる"],["の"],["だ"],["。"],["」"]]},{"verse":8,"text":"モーセはさらにコラに言った。「レビの子たちよ。よく聞きなさい。","tok":[["モーセ"],["は"],["さらに"],["コラ"],["に"],["言った","いった"],["。"],["「"],["レビ"],["の"],["子","こ"],["たち"],["よ"],["。"],["よく"],["聞き","きき"],["なさい"],["。"]]},{"verse":9,"text":"イスラエルの神が、あなたがたを、イスラエルの会衆から分けて、主の幕屋の奉仕をするために、また会衆の前に立って彼らに仕えるために、みもとに近づけてくださったのだ。あなたがたには、これに不足があるのか。","tok":[["イスラエル"],["の"],["神","かみ"],["が"],["、"],["あなた"],["がた"],["を"],["、"],["イスラエル"],["の"],["会衆","かいしゅう"],["から"],["分けて","わけて"],["、"],["主","ぬし"],["の"],["幕屋","まくや"],["の"],["奉仕","ほうし"],["を"],["する"],["ため"],["に"],["、"],["また"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立って","たって"],["彼","かれ"],["ら"],["に"],["仕える","つかえる"],["ため"],["に"],["、"],["みもと"],["に"],["近づけて","ちかづけて"],["くださった"],["の"],["だ"],["。"],["あなた"],["がた"],["に"],["は"],["、"],["これ"],["に"],["不足","ふそく"],["が"],["ある"],["の"],["か"],["。"]]},{"verse":10,"text":"こうしてあなたとあなたの同族であるレビ族全部を、あなたといっしょに近づけてくださったのだ。それなのに、あなたがたは祭司の職まで要求するのか。","tok":[["こう"],["して"],["あなた"],["と"],["あなた"],["の"],["同族","どうぞく"],["で"],["ある"],["レビ族","れびぞく"],["全部","ぜんぶ"],["を"],["、"],["あなた"],["と"],["いっしょ"],["に"],["近づけて","ちかづけて"],["くださった"],["の"],["だ"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["祭司","さいし"],["の"],["職","しょく"],["まで"],["要求","ようきゅう"],["する"],["の"],["か"],["。"]]},{"verse":11,"text":"それだから、あなたとあなたの仲間のすべては、一つになって主に逆らっているのだ。アロンが何だからといって、彼に対して不平を言うのか。」","tok":[["それ"],["だ"],["から"],["、"],["あなた"],["と"],["あなた"],["の"],["仲間","なかま"],["の"],["すべて"],["は"],["、"],["一","ひと"],["つ"],["に"],["なって"],["主に","おもに"],["逆らって","さからって"],["いる"],["の"],["だ"],["。"],["アロン"],["が"],["何","なん"],["だ"],["から"],["と"],["いって"],["、"],["彼","かれ"],["に対して","にたいして"],["不平","ふへい"],["を"],["言う","いう"],["の"],["か"],["。"],["」"]]},{"verse":12,"text":"モーセは使いをやって、エリアブの子のダタンとアビラムとを呼び寄せようとしたが、彼らは言った。「私たちは行かない。","tok":[["モーセ"],["は"],["使い","つかい"],["を"],["やって"],["、"],["エリアブ"],["の"],["子","こ"],["の"],["ダタン"],["と"],["アビラム"],["と"],["を"],["呼び寄せよう","よびよせよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["行かない","いかない"],["。"]]},{"verse":13,"text":"あなたが私たちを乳と蜜の流れる地から上らせて、荒野で私たちを死なせようとし、そのうえ、あなたは私たちを支配しようとして君臨している。それでも不足があるのか。","tok":[["あなた"],["が"],["私たち","わたしたち"],["を"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["から"],["上らせて","のぼらせて"],["、"],["荒野","こうや"],["で"],["私たち","わたしたち"],["を"],["死なせよう","しなせよう"],["と"],["し"],["、"],["その"],["うえ"],["、"],["あなた"],["は"],["私たち","わたしたち"],["を"],["支配","しはい"],["しよう"],["として"],["君臨","くんりん"],["して"],["いる"],["。"],["それ"],["で"],["も"],["不足","ふそく"],["が"],["ある"],["の"],["か"],["。"]]},{"verse":14,"text":"しかも、あなたは、乳と蜜の流れる地に私たちを連れても行かず、畑とぶどう畑を受け継ぐべき財産として私たちに与えてもいない。あなたは、この人たちの目をくらまそうとするのか。私たちは行かない。」","tok":[["しかも"],["、"],["あなた"],["は"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["に"],["私たち","わたしたち"],["を"],["連れて","つれて"],["も"],["行かず","いかず"],["、"],["畑","はたけ"],["と"],["ぶどう"],["畑","はたけ"],["を"],["受け継ぐべき","うけつぐべき"],["財産","ざいさん"],["として"],["私たち","わたしたち"],["に"],["与えて","あたえて"],["も"],["いない"],["。"],["あなた"],["は"],["、"],["この"],["人","ひと"],["たち"],["の"],["目","め"],["を"],["くらまそう"],["と"],["する"],["の"],["か"],["。"],["私たち","わたしたち"],["は"],["行かない","いかない"],["。"],["」"]]},{"verse":15,"text":"モーセは激しく怒った。そして主に申し上げた。「どうか、彼らのささげ物を顧みないでください。私は彼らから、ろば一頭も取ったことはなく、彼らのうちのだれをも傷つけたこともありません。」","tok":[["モーセ"],["は"],["激しく","はげしく"],["怒った","おこった"],["。"],["そして"],["主に","おもに"],["申し上げた","もうしあげた"],["。"],["「"],["どう"],["か"],["、"],["彼","かれ"],["ら"],["の"],["ささげ物","ささげもの"],["を"],["顧みないで","かえりみないで"],["ください"],["。"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["から"],["、"],["ろば"],["一頭","いちとう"],["も"],["取った","とった"],["こと"],["は"],["なく"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["だれ"],["を"],["も"],["傷つけた","きずつけた"],["こと"],["も"],["ありません"],["。"],["」"]]},{"verse":16,"text":"それから、モーセはコラに言った。「あなたとあなたの仲間のすべて、あなたと彼らとそれにアロンとは、あす、主の前に出なさい。","tok":[["それ"],["から"],["、"],["モーセ"],["は"],["コラ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["と"],["あなた"],["の"],["仲間","なかま"],["の"],["すべて"],["、"],["あなた"],["と"],["彼","かれ"],["ら"],["と"],["それ"],["に"],["アロン"],["と"],["は"],["、"],["あす"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["出","で"],["なさい"],["。"]]},{"verse":17,"text":"あなたがたは、おのおの自分の火皿を取り、その上に香を盛り、おのおの主の前にそれを持って来なさい。すなわち二百五十の火皿、それにまたあなたも、アロンも、おのおの火皿を持って来なさい。」","tok":[["あなた"],["がた"],["は"],["、"],["おのおの"],["自分","じぶん"],["の"],["火皿","ひざら"],["を"],["取り","とり"],["、"],["その"],["上","うえ"],["に"],["香","こう"],["を"],["盛り","もり"],["、"],["おのおの"],["主","ぬし"],["の"],["前","まえ"],["に"],["それ"],["を"],["持って","もって"],["来","き"],["なさい"],["。"],["すなわち"],["二百五十","にひゃくごじゅう"],["の"],["火皿","ひざら"],["、"],["それ"],["に"],["また"],["あなた"],["も"],["、"],["アロン"],["も"],["、"],["おのおの"],["火皿","ひざら"],["を"],["持って","もって"],["来","き"],["なさい"],["。"],["」"]]},{"verse":18,"text":"彼らはおのおの、その火皿を取り、それに火を入れて、その上に香を盛った。そしてモーセとアロンはいっしょに会見の天幕の入口に立った。","tok":[["彼","かれ"],["ら"],["は"],["おのおの"],["、"],["その"],["火皿","ひざら"],["を"],["取り","とり"],["、"],["それ"],["に"],["火","ひ"],["を"],["入れて","いれて"],["、"],["その"],["上","うえ"],["に"],["香","こう"],["を"],["盛った","もった"],["。"],["そして"],["モーセ"],["と"],["アロン"],["は"],["いっしょ"],["に"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["立った","たった"],["。"]]},{"verse":19,"text":"コラは全会衆を会見の天幕の入口に集めて、ふたりに逆らわせようとした。そのとき、主の栄光が全会衆に現れた。","tok":[["コラ"],["は"],["全","ぜん"],["会衆","かいしゅう"],["を"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["集めて","あつめて"],["、"],["ふたり"],["に"],["逆らわせよう","さからわせよう"
[{"verse":1,"text":"主がシナイ山でモーセと語られたときのアロンとモーセの系図は、次のとおりであった。","tok":[["主","ぬし"],["が"],["シナイ"],["山","やま"],["で"],["モーセ"],["と"],["語られた","かたられた"],["とき"],["の"],["アロン"],["と"],["モーセ"],["の"],["系図","けいず"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["あった"],["。"]]},{"verse":2,"text":"アロンの子らの名は長子ナダブと、アビフと、エルアザルと、イタマルであった。","tok":[["アロン"],["の"],["子","こ"],["ら"],["の"],["名","な"],["は"],["長子","ちょうし"],["ナダブ"],["と"],["、"],["アビ"],["フと"],["、"],["エルアザル"],["と"],["、"],["イタマル"],["で"],["あった"],["。"]]},{"verse":3,"text":"これらはアロンの子らの名であって、彼らは油そそがれて祭司の職に任じられた祭司であった。","tok":[["これ"],["ら"],["は"],["アロン"],["の"],["子","こ"],["ら"],["の"],["名","な"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["は"],["油","あぶら"],["そそがれて"],["祭司","さいし"],["の"],["職","しょく"],["に"],["任じられた","にんじられた"],["祭司","さいし"],["で"],["あった"],["。"]]},{"verse":4,"text":"しかしナダブとアビフは、シナイの荒野で主の前に異なった火をささげたとき、主の前で死んだ。彼らには子どもがなかった。そこでエルアザルとイタマルは父アロンの生存中から祭司として仕えた。","tok":[["しかし"],["ナダブ"],["と"],["アビフ"],["は"],["、"],["シナイ"],["の"],["荒野","あらの"],["で"],["主","ぬし"],["の"],["前","まえ"],["に"],["異なった","ことなった"],["火","ひ"],["を"],["ささげた"],["とき"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["死んだ","しんだ"],["。"],["彼","かれ"],["ら"],["に"],["は"],["子ども","こども"],["が"],["なかった"],["。"],["そこ"],["で"],["エルアザル"],["と"],["イタマル"],["は"],["父","ちち"],["アロン"],["の"],["生存中","せいぞんちゅう"],["から"],["祭司","さいし"],["として"],["仕えた","つかえた"],["。"]]},{"verse":5,"text":"主はモーセに告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":6,"text":"「レビ部族を近寄らせ、彼らを祭司アロンにつき添わせ、彼に仕えさせよ。","tok":[["「"],["レビ"],["部族","ぶぞく"],["を"],["近寄らせ","ちかよらせ"],["、"],["彼","かれ"],["ら"],["を"],["祭司","さいし"],["アロン"],["に"],["つき添わせ","つきそわせ"],["、"],["彼","かれ"],["に"],["仕えさせ","つかえさせ"],["よ"],["。"]]},{"verse":7,"text":"彼らは会見の天幕の前で、アロンの任務と全会衆の任務を果たして、幕屋の奉仕をしなければならない。","tok":[["彼","かれ"],["ら"],["は"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["前","まえ"],["で"],["、"],["アロン"],["の"],["任務","にんむ"],["と"],["全","ぜん"],["会衆","かいしゅう"],["の"],["任務","にんむ"],["を"],["果たして","はたして"],["、"],["幕屋","まくや"],["の"],["奉仕","ほうし"],["を"],["しなければ"],["ならない"],["。"]]},{"ver
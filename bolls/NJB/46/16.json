[{"verse":1,"text":"さて、聖徒たちのための献金については、ガラテヤの諸教会に命じたように、あなたがたにもこう命じます。","tok":[["さて"],["、"],["聖徒","せいと"],["たち"],["の"],["ため"],["の"],["献金","けんきん"],["について"],["は"],["、"],["ガラテヤ"],["の"],["諸教","しょきょう"],["会","かい"],["に"],["命じた","めいじた"],["よう"],["に"],["、"],["あなた"],["がた"],["に"],["も"],["こう"],["命じます","めいじます"],["。"]]},{"verse":2,"text":"私がそちらに行ってから献金を集めるようなことがないように、あなたがたはおのおの、いつも週の初めの日に、収入に応じて、手もとにそれをたくわえておきなさい。","tok":[["私","わたくし"],["が"],["そちら"],["に"],["行って","いって"],["から"],["献金","けんきん"],["を"],["集める","あつめる"],["よう"],["な"],["こと"],["が"],["ない"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["おのおの"],["、"],["いつも"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["に"],["、"],["収入","しゅうにゅう"],["に"],["応じて","おうじて"],["、"],["手もと","てもと"],["に"],["それ"],["を"],["たくわえて"],["おき"],["なさい"],["。"]]},{"verse":3,"text":"私がそちらに行ったとき、あなたがたの承認を得た人々に手紙を持たせて派遣し、あなたがたの献金をエルサレムに届けさせましょう。","tok":[["私","わたくし"],["が"],["そちら"],["に"],["行った","いった"],["とき"],["、"],["あなた"],["がた"],["の"],["承認","しょうにん"],["を"],["得た","えた"],["人々","ひとびと"],["に"],["手紙","てがみ"],["を"],["持たせて","もたせて"],["派遣","はけん"],["し"],["、"],["あなた"],["がた"],["の"],["献金","けんきん"],["を"],["エルサレム"],["に"],["届けさせましょう","とどけさせましょう"],["。"]]},{"verse":4,"text":"しかし、もし私も行くほうがよければ、彼らは、私といっしょに行くことになるでしょう。","tok":[["しかし"],["、"],["もし"],["私","わたくし"],["も"],["行く","いく"],["ほう"],["が"],["よければ"],["、"],["彼","かれ"],["ら"],["は"],["、"],["私","わたくし"],["と"],["いっしょ"],["に"],["行く","いく"],["こと"],["に"],["なるでしょう"],["。"]]},{"verse":5,"text":"私は、マケドニヤを通って後、あなたがたのところへ行きます。マケドニヤを通るつもりでいますから。","tok":[["私","わたくし"],["は"],["、"],["マケドニヤ"],["を"],["通って","とおって"],["後","あと"],["、"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行きます","いきます"],["。"],["マケドニヤ"],["を"],["通る","とおる"],["つもり"],["で"],["います"],["から"],["。"]]},{"verse":6,"text":"そして、たぶんあなたがたのところに滞在するでしょう。冬を越すことになるかもしれません。それは、どこに行くとしても、あなたがたに送っていただこうと思うからです。","tok":[["そして"],["、"],["たぶん"],["あなた"],["がた"],["の"],["ところ"],["に"],["滞在","たいざい"],["するでしょう"],["。"],["冬","ふゆ"],["を"],["越す","こす"],["こと"],["に"],["なる"],["か"],["も"],["しれません"],["。"],["それ"],["は"],["、"],["どこ"],["に"],["行く","いく"],["として"],["も"],["、"],["あなた"],["がた"],["に"],["送って","おくって"],["いただこう"],["と"],["思う","おもう"],["から"],["です"],["。"]]},{"verse":7,"text":"私は、いま旅の途中に、あなたがたの顔を見たいと思っているのではありません。主がお許しになるなら、あなたがたのところにしばらく滞在したいと願っています。","tok":[["私","わたくし"],["は"],["、"],["いま"],["旅","たび"],["の"],["途中","とちゅう"],["に"],["、"],["あなた"],["がた"],["の"],["顔","かお"],["を"],["見たい","みたい"],["と"],["思って","おもって"],["いる"],["ので"],["は"],["ありません"],["。"],["主","ぬし"],["が"],["お許し","おゆるし"],["に"],["なるなら"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["しばらく"],["滞在","たいざい"],["したい"],["と"],["願って","ねがって"],["います"],["。"]]},{"verse":8,"text":"しかし、五旬節まではエペソに滞在するつもりです。","tok":[["しかし"],["、"],["五","ご"],["旬","しゅん"],["節","ふし"],["まで"],["は"],["エペソ"],["に"],["滞在","たいざい"],["する"],["つもり"],["です"],["。"]]},{"verse":9,"text":"というのは、働きのための広い門が私のために開かれており、反対者も大ぜいいるからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["働き","はたらき"],["の"],["ため"],["の"],["広い","ひろい"],["門","もん"],["が"],["私","わたくし"],["の"],["ため"],["に"],["開かれて","ひらかれて"],["おり"],["、"],["反対者","はんたいしゃ"],["も"],["大ぜい","おおぜい"],["いる"],["から"],["です"],["。"]]},{"verse":10,"text":"テモテがそちらへ行ったら、あなたがたのところで心配なく過ごせるよう心を配ってください。彼も、私と同じように、主のみわざに励んでいるからです。","tok":[["テモテ"],["が"],["そちら"],["へ"],["行ったら","いったら"],["、"],["あなた"],["がた"],["の"],["ところ"],["で"],["心配","しんぱい"],["なく"],["過ごせる","すごせる"],["よう"],["心","こころ"],["を"],["配って","くばって"],["ください"],["。"],["彼","かれ"],["も"],["、"],["私","わたくし"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["主","ぬし"],["のみ"],["わざ"],["に"],["励んで","はげんで"],["いる"],["から"],["です"],["。"]]},{"verse":11,"text":"だれも彼を軽んじてはいけません。彼を平安のうちに送り出して、私のところに来させてください。私は、彼が兄弟たちとともに来るのを待ち望んでいます。","tok":[["だれ"],["も"],["彼","かれ"],["を"],["軽んじて","かろんじて"],["は"],["いけません"],["。"],["彼","かれ"],["を"],["平安","へいあん"],["の"],["うち"],["に"],["送り出して","おくりだして"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["来させて","きさせて"],["ください"],["。"],["私","わたくし"],["は"],["、"],["彼","かれ"],["が"],["兄弟","きょうだい"],["たち"],["と"],["とも"],["に"],["来る","くる"],["の"],["を"],["待ち望んで","まちのぞんで"],["います"],["。"]]},{"verse":12,"text":"兄弟アポロのことですが、兄弟たちといっしょにあなたがたのところへ行くように、私は強く彼に勧めました。しかし、彼は今、そちらへ行こうとは全然思っていません。しかし、機会があれば行くでしょう。","tok":[["兄弟","きょうだい"],["アポロ"],["の"],["こと"],["です"],["が"],["、"],["兄弟","きょうだい"],["たち"],["と"],["いっしょ"],["に"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行く","いく"],["よう"],["に"],["、"],["私","わたくし"],["は"],["強く","つよく"],["彼","かれ"],["に"],["勧めました","すすめました"],["。"],["しかし"],["、"],["彼","かれ"],["は"],["今","いま"],["、"],["そちら"],["へ"],["行こう","いこう"],["と"],["は"],["全然","ぜんぜん"],["思って","おもって"],["いません"],["。"],["しかし"],["、"],["機会","きかい"],["が"],["あれば"],["行くでしょう","いくでしょう"],["。"]]},{"verse":13,"text":"目を覚ましていなさい。堅く信仰に立ちなさい。男らしく、強くありなさい。","tok":[["目","め"],["を"],["覚まして","さまして"],["い"],["なさい"],["。"],["堅く","かたく"],["信仰","しんこう"],["に"],["立ち","たち"],["なさい"],["。"],["男","おとこ"],["らしく"],["、"],["強く","つよく"],["あり"],["なさい"],["。"]]},{"verse":14,"text":"いっさいのことを愛をもって行いなさい。","tok":[["いっさい"],["の"],["こと"],["を"],["愛","あい"],["を"],["もって"],["行い","おこない"],["なさい"],["。"]]},{"verse":15,"text":"兄弟たちよ。あなたがたに勧めます。ご承知のように、ステパナの家族は、アカヤの初穂であって、聖徒たちのために熱心に奉仕してくれました。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["勧めます","すすめます"],["。"],["ご承知","ごしょうち"],["の"],["よう"],["に"],["、"],["ステパナ"],["の"],["家族","かぞく"],["は"],["、"],["アカヤ"],["の"],["初穂","はつほ"],["で"],["あって"],["、"],["聖徒","せいと"],["たち"],["の"],["ため"],["に"],["熱心","ねっしん"],["に"],["奉仕","ほうし"],["して"],["くれました"],["。"]]},{"verse":16,"text":"あなたがたは、このような人たちに、また、ともに働き、労しているすべての人たちに服従しなさい。","tok":[["あなた"],["がた"],["は"],["、"],["この"],["よう"],["な"],["人","ひと"],["たち"],["に"],["、"],["また"],["、"],["とも"],["に"],["働き","はたらき"],["、"],["労して","ろうして"],["いる"],["すべて"],["の"],["人","ひと"],["たち"],["に"],["服従","ふくじゅう"],["し"],["なさい"],["。"]]},{"verse":17,"text":"ステパナとポルトナトとアカイコが来たので、私は喜んでいます。なぜなら、彼らは、あなたがたの足りない分を補ってくれたからです。","tok":[["ステパナ"],["と"],["ポルトナト"],["と"],["アカイコ"],["が"],["来た","きた"],["ので"],["、"],["私","わたくし"],["は"],["喜んで","よろこんで"],["います"],["。"],["なぜ"],["なら"],["、"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["の"],["足りない","たりない"],["分","ぶん"],["を"],["補って","おぎなって"],["くれた"],["から"],["です"],["。"]]},{"verse":18,"text":"彼らは、私の心をも、あなたがたの心をも安心させてくれました。このような人々の労をねぎらいなさい。","tok":[["彼","かれ"],["ら"],["は"],["、"],["私","わたくし"],["の"],["心","こころ"],["を"],["も"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["も"],["安心","あんしん"],["させて"],["くれました"],["。"],["この"],["よう"],["な"],["人々","ひとびと"],["の"],["労","ろう"],["を"],["ねぎらい"],["なさい"],["。"]]},{"verse":19,"text":"アジヤの諸教会がよろしくと言っています。アクラとプリスカ、また彼らの家の教会が主にあって心から、あなたがたによろしくと言っています。","tok":[["アジヤ"],["の"],["諸教","しょきょう"],["会","かい"],["が"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["アクラ"],["と"],["プリスカ"],["、"],["また"],["彼","かれ"],["ら"],["の"],["家","いえ"],["の"],["教会","きょうかい"],["が"],["主に","おもに"],["あって"],["心","こころ"],["から"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":20,"text":"すべての兄弟たちが、あなたがたによろしくと言っています。聖なる口づけをもって、互いにあいさつをかわしなさい。","tok":[["すべて"],["の"],["兄弟","きょうだい"],["たち"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["聖","せい"],["なる"],["口づけ","くちづけ"],["を"],["もって"],["、"],["互い","たがい"],["に"],["あいさつ"],["を"],["かわし"],["なさい"],["。"]]},{"verse":21,"text":"パウロが、自分の手であいさつを書きます。","tok":[["パウロ"],["が"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["あいさつ"],["を"],["書きます","かきます"],["。"]]},{"verse":22,"text":"主を愛さない者はだれでも、のろわれよ。主よ、来てください。","tok":[["主","ぬし"],["を"],["愛さない","あいさない"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["のろわれ"],["よ"],["。"],["主","ぬし"],["よ"],["、"],["来て","きて"],["ください"],["。"]]},{"verse":23,"text":"主イエスの恵みが、あなたがたとともにありますように。","tok":[["主","しゅ"],["イエス"],["の"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["あります"],["よう"],["に"],["。"]]},{"verse":24,"text":"私の愛は、キリスト・イエスにあって、あなたがたすべての者とともにあります。アーメン。","tok":[["私","わたくし"],["の"],["愛","あい"],["は"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["あなた"],["がた"],["すべて"],["の"],["者","もの"],["と"],["とも"],["に"],["あります"],["。"],["アーメン"],["。"]]}]
[{"verse":1,"text":"私には自由がないでしょうか。私は使徒ではないのでしょうか。私は私たちの主イエスを見たのではないでしょうか。あなたがたは、主にあって私の働きの実ではありませんか。","tok":[["私","わたくし"],["に"],["は"],["自由","じゆう"],["が"],["ないでしょう"],["か"],["。"],["私","わたくし"],["は"],["使徒","しと"],["で"],["は"],["ない"],["の"],["でしょう"],["か"],["。"],["私","わたくし"],["は"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["を"],["見た","みた"],["ので"],["は"],["ないでしょう"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["主に","おもに"],["あって"],["私","わたくし"],["の"],["働き","はたらき"],["の"],["実","じつ"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":2,"text":"たとい私がほかの人々に対しては使徒でなくても、少なくともあなたがたに対しては使徒です。あなたがたは、主にあって、私が使徒であることの証印です。","tok":[["たとい"],["私","わたくし"],["が"],["ほか"],["の"],["人々","ひとびと"],["に対して","にたいして"],["は"],["使徒","しと"],["で"],["なくて"],["も"],["、"],["少なく","すくなく"],["とも"],["あなた"],["がた"],["に対して","にたいして"],["は"],["使徒","しと"],["です"],["。"],["あなた"],["がた"],["は"],["、"],["主に","おもに"],["あって"],["、"],["私","わたくし"],["が"],["使徒","しと"],["で"],["ある"],["こと"],["の"],["証印","しょういん"],["です"],["。"]]},{"verse":3,"text":"私をさばく人たちに対して、私は次のように弁明します。","tok":[["私","わたくし"],["を"],["さばく"],["人","ひと"],["たち"],["に対して","にたいして"],["、"],["私","わたくし"],["は"],["次","つぎ"],["の"],["よう"],["に"],["弁明","べんめい"],["します"],["。"]]},{"verse":4,"text":"いったい私たちには飲み食いする権利がないのでしょうか。","tok":[["いったい"],["私たち","わたしたち"],["に"],["は"],["飲み食い","のみくい"],["する"],["権利","けんり"],["が"],["ない"],["の"],["でしょう"],["か"],["。"]]},{"verse":5,"text":"私たちには、ほかの使徒、主の兄弟たち、ケパなどと違って、信者である妻を連れて歩く権利がないのでしょうか。","tok":[["私たち","わたしたち"],["に"],["は"],["、"],["ほか"],["の"],["使徒","しと"],["、"],["主","ぬし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["ケパ"],["など"],["と"],["違って","ちがって"],["、"],["信者","しんじゃ"],["で"],["ある"],["妻","つま"],["を"],["連れて","つれて"],["歩く","あるく"],["権利","けんり"],["が"],["ない"],["の"],["でしょう"],["か"],["。"]]},{"verse":6,"text":"それともまた、私とバルナバだけには、生活のための働きをやめる権利がないのでしょうか。","tok":[["それ"],["と"],["も"],["また"],["、"],["私","わたくし"],["と"],["バルナバ"],["だけ"],["に"],["は"],["、"],["生活","せいかつ"],["の"],["ため"],["の"],["働き","はたらき"],["を"],["やめる"],["権利","けんり"],["が"],["ない"],["の"],["でしょう"],["か"],["。"]]},{"verse":7,"text":"いったい自分の費用で兵士になる者がいるでしょうか。自分でぶどう園を造りながら、その実を食べない者がいるでしょうか。羊の群れを飼いながら、その乳を飲まない者がいるでしょうか。","tok":[["いったい"],["自分","じぶん"],["の"],["費用","ひよう"],["で"],["兵士","へいし"],["に"],["なる"],["者","もの"],["が"],["いるでしょう"],["か"],["。"],["自分","じぶん"],["で"],["ぶどう園","ぶどうえん"],["を"],["造り","つくり"],["ながら"],["、"],["その"],["実","じつ"],["を"],["食べない","たべない"],["者","もの"],["が"],["いるでしょう"],["か"],["。"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["飼い","かい"],["ながら"],["、"],["その"],["乳","ちち"],["を"],["飲まない","のまない"],["者","もの"],["が"],["いるでしょう"],["か"],["。"]]},{"verse":8,"text":"私がこんなことを言うのは、人間の考えによって言っているのでしょうか。律法も同じことを言っているではありませんか。","tok":[["私","わたくし"],["が"],["こんな"],["こと"],["を"],["言う","いう"],["の"],["は"],["、"],["人間","にんげん"],["の"],["考え","かんがえ"],["によって"],["言って","いって"],["いる"],["の"],["でしょう"],["か"],["。"],["律法","りっぽう"],["も"],["同じ","おなじ"],["こと"],["を"],["言って","いって"],["いるで"],["は"],["ありません"],["か"],["。"]]},{"verse":9,"text":"モーセの律法には、「穀物をこなしている牛に、くつこを掛けてはいけない」と書いてあります。いったい神は、牛のことを気にかけておられるのでしょうか。","tok":[["モーセ"],["の"],["律法","りっぽう"],["に"],["は"],["、"],["「"],["穀物","こくもつ"],["を"],["こなして"],["いる"],["牛","うし"],["に"],["、"],["くつ"],["こ"],["を"],["掛けて","かけて"],["は"],["いけない"],["」"],["と"],["書いて","かいて"],["あります"],["。"],["いったい"],["神","かみ"],["は"],["、"],["牛","うし"],["の"],["こと"],["を"],["気","き"],["に"],["かけて"],["おられる"],["の"],["でしょう"],["か"],["。"]]},{"verse":10,"text":"それとも、もっぱら私たちのために、こう言っておられるのでしょうか。むろん、私たちのためにこう書いてあるのです。なぜなら、耕す者が望みを持って耕し、脱穀する者が分配を受ける望みを持って仕事をするのは当然だからです。","tok":[["それ"],["と"],["も"],["、"],["もっぱら"],["私たち","わたしたち"],["の"],["ため"],["に"],["、"],["こう"],["言って","いって"],["おられる"],["の"],["でしょう"],["か"],["。"],["むろん"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["こう"],["書いて","かいて"],["ある"],["の"],["です"],["。"],["なぜ"],["なら"],["、"],["耕す","たがやす"],["者","もの"],["が"],["望み","のぞみ"],["を"],["持って","もって"],["耕し","たがやし"],["、"],["脱穀","だっこく"],["する"],["者","もの"],["が"],["分配","ぶんぱい"],["を"],["受ける","うける"],["望み","のぞみ"],["を"],["持って","もって"],["仕事","しごと"],["を"],["する"],["の"],["は"],["当然","とうぜん"],["だ"],["から"],["です"],["。"]]},{"verse":11,"text":"もし私たちが、あなたがたに御霊のものを蒔いたのであれば、あなたがたから物質的なものを刈り取ることは行き過ぎでしょうか。","tok":[["もし"],["私たち","わたしたち"],["が"],["、"],["あなた"],["がた"],["に"],["御霊","ごれい"],["の"],["もの"],["を"],["蒔いた","まいた"],["ので"],["あれば"],["、"],["あなた"],["がた"],["から"],["物質的","ぶっしつてき"],["な"],["もの"],["を"],["刈り取る","かりとる"],["こと"],["は"],["行き","いき"],["過ぎでしょう","すぎでしょう"],["か"],["。"]]},{"verse":12,"text":"もし、ほかの人々が、あなたがたに対する権利にあずかっているのなら、私たちはなおさらその権利を用いてよいはずではありませんか。それなのに、私たちはこの権利を用いませんでした。かえって、すべてのことについて耐え忍んでいます。それは、キリストの福音に少しの妨げも与えまいとしてなのです。","tok":[["もし"],["、"],["ほか"],["の"],["人々","ひとびと"],["が"],["、"],["あなた"],["がた"],["に"],["対する","たいする"],["権利","けんり"],["に"],["あずかって"],["いる"],["の"],["なら"],["、"],["私たち","わたしたち"],["は"],["なおさら"],["その"],["権利","けんり"],["を"],["用いて","もちいて"],["よい"],["はず"],["で"],["は"],["ありません"],["か"],["。"],["それ"],["な"],["のに"],["、"],["私たち","わたしたち"],["は"],["この"],["権利","けんり"],["を"],["用いませんでした","もちいませんでした"],["。"],["かえって"],["、"],["すべて"],["の"],["こと"],["について"],["耐え忍んで","たえしのんで"],["います"],["。"],["それ"],["は"],["、"],["キリスト"],["の"],["福音","ふくいん"],["に"],["少し","すこし"],["の"],["妨げ","さまたげ"],["も"],["与えまい","あたえまい"],["として"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"あなたがたは、宮に奉仕している者が宮の物を食べ、祭壇に仕える者が祭壇の物にあずかることを知らないのですか。","tok":[["あなた"],["がた"],["は"],["、"],["宮","みや"],["に"],["奉仕","ほうし"],["して"],["いる"],["者","もの"],["が"],["宮","みや"],["の"],["物","もの"],["を"],["食べ","たべ"],["、"],["祭壇","さいだん"],["に"],["仕える","つかえる"],["者","もの"],["が"],["祭壇","さいだん"],["の"],["物","もの"],["に"],["あずかる"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"]]},{"verse":14,"text":"同じように、主も、福音を宣べ伝える者が、福音の働きから生活のささえを得るように定めておられます。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["主","ぬし"],["も"],["、"],["福音","ふくいん"],["を"],["宣べ伝える","のべつたえる"],["者","もの"],["が"],["、"],["福音","ふくいん"],["の"],["働き","はたらき"],["から"],["生活","せいかつ"],["の"],["ささえ"],["を"],["得る","える"],["よう"],["に"],["定めて","さだめて"],["おられます"],["。"]]},{"verse":15,"text":"しかし、私はこれらの権利を一つも用いませんでした。また、私は自分がそうされたくてこのように書いているのでもありません。私は自分の誇りをだれかに奪われるよりは、死んだほうがましだからです。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["これ"],["ら"],["の"],["権利","けんり"],["を"],["一","ひと"],["つ"],["も"],["用いませんでした","もちいませんでした"],["。"],["また"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["が"],["そう"],["されたくて"],["この"],["よう"],["に"],["書いて","かいて"],["いる"],["ので"],["も"],["ありません"],["。"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["誇り","ほこり"],["を"],["だれ"],["か"],["に"],["奪われる","うばわれる"],["より"],["は"],["、"],["死んだ","しんだ"],["ほう"],["が"],["まし"],["だ"],["から"],["です"],["。"]]},{"verse":16,"text":"というのは、私が福音を宣べ伝えても、それは私の誇りにはなりません。そのことは、私がどうしても、しなければならないことだからです。もし福音を宣べ伝えなかったなら、私はわざわいだ。","tok":[["と"],["いう"],["の"],["は"],["、"],["私","わたくし"],["が"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["も"],["、"],["それ"],["は"],["私","わたくし"],["の"],["誇り","ほこり"],["に"],["は"],["なりません"],["。"],["その"],["こと"],["は"],["、"],["私","わたくし"],["が"],["どう"],["して"],["も"],["、"],["しなければ"],["ならない"],["こと"],["だ"],["から"],["です"],["。"],["もし"],["福音","ふくいん"],["を"],["宣べ伝えなかったなら","のべつたえなかったなら"],["、"],["私","わたくし"],["は"],["わざわい"],["だ"],["。"]]},{"verse":17,"text":"もし私がこれを自発的にしているのなら、報いがありましょう。しかし、強いられたにしても、私には務めがゆだねられているのです。","tok":[["もし"],["私","わたくし"],["が"],["これ"],["を"],["自発的","じはつてき"],["に"],["して"],["いる"],["の"],["なら"],["、"],["報い","むくい"],["が"],["ありましょう"],["。"],["しかし"],["、"],["強いられた","しいられた"],["に"],["して"],["も"],["、"],["私","わたくし"],["に"],["は"],["務め","つとめ"],["が"],["ゆだねられて"],["いる"],["の"],["です"],["。"]]},{"verse":18,"text":"では、私にどんな報いがあるのでしょう。それは、福音を宣べ伝えるときに報酬を求めないで与え、福音の働きによって持つ自分の権利を十分に用いないことなのです。","tok":[["で"],["は"],["、"],["私","わたくし"],["に"],["どんな"],["報い","むくい"],["が"],["ある"],["の"],["でしょう"],["。"],["それ"],["は"],["、"],["福音","ふくいん"],["を"],["宣べ伝える","のべつたえる"],["とき"],["に"],["報酬","ほうしゅう"],["を"],["求めないで","もとめないで"],["与え","あたえ"],["、"],["福音","ふくいん"],["の"],["働き","はたらき"],["によって"],["持つ","もつ"],["自分","じぶん"],["の"],["権利","けんり"],["を"],["十分","じゅうぶん"],["に"],["用いない","もちいない"],["こと"],["な"],["の"],["です"],["。"]]},{"verse":19,"text":"私はだれに対しても自由ですが、より多くの人を獲得するために、すべての人の奴隷となりました。","tok":[["私","わたくし"],["は"],["だれ"],["に対して","にたいして"],["も"],["自由","じゆう"],["です"],["が"],["、"],["より"],["多く","おおく"],["の"],["人","ひと"],["を"],["獲得","かくとく"],["する"],["ため"],["に"],["、"],["すべて"],["の"],["人","ひと"],["の"],["奴隷","どれい"],["と"],["なりました"],["。"]]},{"verse":20,"text":"ユダヤ人にはユダヤ人のようになりました。それはユダヤ人を獲得するためです。律法の下にある人々には、私自身は律法の下には
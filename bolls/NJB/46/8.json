[{"verse":1,"text":"次に、偶像にささげた肉についてですが、私たちはみな知識を持っているということなら、わかっています。しかし、知識は人を高ぶらせ、愛は人の徳を建てます。","tok":[["次","つぎ"],["に"],["、"],["偶像","ぐうぞう"],["に"],["ささげた"],["肉","にく"],["について"],["です"],["が"],["、"],["私たち","わたしたち"],["は"],["みな"],["知識","ちしき"],["を"],["持って","もって"],["いる"],["と"],["いう"],["こと"],["なら"],["、"],["わかって"],["います"],["。"],["しかし"],["、"],["知識","ちしき"],["は"],["人","ひと"],["を"],["高ぶらせ","たかぶらせ"],["、"],["愛","あい"],["は"],["人","ひと"],["の"],["徳","とく"],["を"],["建てます","たてます"],["。"]]},{"verse":2,"text":"人がもし、何かを知っていると思ったら、その人はまだ知らなければならないほどのことも知ってはいないのです。","tok":[["人","ひと"],["が"],["もし"],["、"],["何","なん"],["か"],["を"],["知って","しって"],["いる"],["と"],["思ったら","おもったら"],["、"],["その"],["人","ひと"],["は"],["まだ"],["知らなければ","しらなければ"],["ならない"],["ほど"],["の"],["こと"],["も"],["知って","しって"],["は"],["いない"],["の"],["です"],["。"]]},{"verse":3,"text":"しかし、人が神を愛するなら、その人は神に知られているのです。","tok":[["しかし"],["、"],["人","ひと"],["が"],["神","かみ"],["を"],["愛するなら","あいするなら"],["、"],["その"],["人","ひと"],["は"],["神","かみ"],["に"],["知られて","しられて"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"そういうわけで、偶像にささげた肉を食べることについてですが、私たちは、世の偶像の神は実際にはないものであること、また、唯一の神以外には神は存在しないことを知っています。","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["偶像","ぐうぞう"],["に"],["ささげた"],["肉","にく"],["を"],["食べる","たべる"],["こと"],["について"],["です"],["が"],["、"],["私たち","わたしたち"],["は"],["、"],["世","よ"],["の"],["偶像","ぐうぞう"],["の"],["神","かみ"],["は"],["実際","じっさい"],["に"],["は"],["ない"],["もの"],["で"],["ある"],["こと"],["、"],["また"],["、"],["唯一","ゆいいつ"],["の"],["神","かみ"],["以外","いがい"],["に"],["は"],["神","かみ"],["は"],["存在","そんざい"],["しない"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":5,"text":"なるほど、多くの神や、多くの主があるので、神々と呼ばれるものならば、天にも地にもありますが、","tok":[["なるほど"],["、"],["多く","おおく"],["の"],["神","かみ"],["や"],["、"],["多く","おおく"],["の"],["主","ぬし"],["が"],["ある"],["ので"],["、"],["神々","かみがみ"],["と"],["呼ばれる","よばれる"],["もの"],["ならば"],["、"],["天","てん"],["に"],["も"],["地","ち"],["に"],["も"],["あります"],["が"],["、"]]},{"verse":6,"text":"私たちには、父なる唯一の神がおられるだけで、すべてのものはこの神から出ており、私たちもこの神のために存在しているのです。また、唯一の主なるイエス・キリストがおられるだけで、すべてのものはこの主によって存在し、私たちもこの主によって存在するのです。","tok":[["私たち","わたしたち"],["に"],["は"],["、"],["父","ちち"],["なる"],["唯一","ゆいいつ"],["の"],["神","かみ"],["が"],["おられる"],["だけ"],["で"],["、"],["すべて"],["の"],["もの"],["は"],["この"],["神","かみ"],["から"],["出て","でて"],["おり"],["、"],["私たち","わたしたち"],["も"],["この"],["神","かみ"],["の"],["ため"],["に"],["存在","そんざい"],["して"],["いる"],["の"],["です"],["。"],["また"],["、"],["唯一","ゆいいつ"],["の"],["主","ぬし"],["なる"],["イエス"],["・"],["キリスト"],["が"],["おられる"],["だけ"],["で"],["、"],["すべて"],["の"],["もの"],["は"],["この"],["主","ぬし"],["によって"],["存在","そんざい"],["し"],["、"],["私たち","わたしたち"],["も"],["この"],["主","ぬし"],["によって"],["存在","そんざい"],["する"],["の"],["です"],["。"]]},{"verse":7,"text":"しかし、すべての人にこの知識があるのではありません。ある人たちは、今まで偶像になじんで来たため偶像にささげた肉として食べ、それで彼らのそのように弱い良心が汚れるのです。","tok":[["しかし"],["、"],["すべて"],["の"],["人","ひと"],["に"],["この"],["知識","ちしき"],["が"],["ある"],["ので"],["は"],["ありません"],["。"],["ある"],["人","ひと"],["たち"],["は"],["、"],["今まで","いままで"],["偶像","ぐうぞう"],["に"],["なじんで"],["来た","きた"],["ため"],["偶像","ぐうぞう"],["に"],["ささげた"],["肉","にく"],["として"],["食べ","たべ"],["、"],["それ"],["で"],["彼","かれ"],["ら"],["の"],["その"],["よう"],["に"],["弱い","よわい"],["良心","りょうしん"],["が"],["汚れる","よごれる"],["の"],["です"],["。"]]},{"verse":8,"text":"しかし、私たちを神に近づけるのは食物ではありません。食べなくても損にはならないし、食べても益にはなりません。","tok":[["しかし"],["、"],["私たち","わたしたち"],["を"],["神","かみ"],["に"],["近づける","ちかづける"],["の"],["は"],["食物","しょくもつ"],["で"],["は"],["ありません"],["。"],["食べなくて","たべなくて"],["も"],["損","そん"],["に"],["は"],["ならない"],["し"],["、"],["食べて","たべて"],["も"],["益","えき"],["に"],["は"],["なりません"],["。"]]},{"verse":9,"text":"ただ、あなたがたのこの権利が、弱い人たちのつまずきとならないように、気をつけなさい。","tok":[["ただ"],["、"],["あなた"],["がた"],["の"],["この"],["権利","けんり"],["が"],["、"],["弱い","よわい"],["人","ひと"],["たち"],["の"],["つまずき"],["と"],["ならない"],["よう"],["に"],["、"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":10,"text":"知識のあるあなたが偶像の宮で食事をしているのをだれかが見たら、それによって力を得て、その人の良心は弱いのに、偶像の神にささげた肉を食べるようなことにならないでしょうか。","tok":[["知識","ちしき"],["の"],["ある"],["あなた"],["が"],["偶像","ぐうぞう"],["の"],["宮","みや"],["で"],["食事","しょくじ"],["を"],["して"],["いる"],["の"],["を"],["だれ"],["か"],["が"],["見たら","みたら"],["、"],["それ"],["によって"],["力","ちから"],["を"],["得て","えて"],["、"],["その"],["人","ひと"],["の"],["良心","りょうしん"],["は"],["弱い","よわい"],["のに"],["、"],["偶像","ぐうぞう"],["の"],["神","かみ"],["に"],["ささげた"],["肉","にく"],["を"],["食べる","たべる"],["よう"],["な"],["こと"],["に"],["ならないでしょう"],["か"],["。"]]},{"verse":11,"text":"その弱い人は、あなたの知識によって、滅びることになるのです。キリストはその兄弟のためにも死んでくださったのです。","tok":[["その"],["弱い","よわい"],["人","ひと"],["は"],["、"],["あなた"],["の"],["知識","ちしき"],["によって"],["、"],["滅びる","ほろびる"],["こと"],["に"],["なる"],["の"],["です"],["。"],["キリスト"],["は"],["その"],["兄弟","きょうだい"],["の"],["ため"],["に"],["も"],["死んで","しんで"],["くださった"],["の"],["です"],["。"]]},{"verse":12,"text":"あなたがたはこのように兄弟たちに対して罪を犯し、彼らの弱い良心を踏みにじるとき、キリストに対して罪を犯しているのです。","tok":[["あなた"],["がた"],["は"],["この"],["よう"],["に"],["兄弟","きょうだい"],["たち"],["に対して","にたいして"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["彼","かれ"],["ら"],["の"],["弱い","よわい"],["良心","りょうしん"],["を"],["踏みにじる","ふみにじる"],["とき"],["、"],["キリスト"],["に対して","にたいして"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["の"],["です"],["。"]]},{"verse":13,"text":"ですから、もし食物が私の兄弟をつまずかせるなら、私は今後いっさい肉を食べません。それは、私の兄弟につまずきを与えないためです。","tok":[["です"],["から"],["、"],["もし"],["食物","しょくもつ"],["が"],["私","わたくし"],["の"],["兄弟","きょうだい"],["を"],["つまずかせるなら"],["、"],["私","わたくし"],["は"],["今後","こんご"],["いっさい"],["肉","にく"],["を"],["食べません","たべません"],["。"],["それ"],["は"],["、"],["私","わたくし"],["の"],["兄弟","きょうだい"],["に"],["つまずき"],["を"],["与えない","あたえない"],["ため"],["です"],["。"]]}]
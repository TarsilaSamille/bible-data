[{"verse":1,"text":"さて兄弟たち。私があなたがたのところへ行ったとき、私は、すぐれたことば、すぐれた知恵を用いて、神のあかしを宣べ伝えることはしませんでした。","tok":[["さて"],["兄弟","きょうだい"],["たち"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行った","いった"],["とき"],["、"],["私","わたくし"],["は"],["、"],["すぐれた"],["ことば"],["、"],["すぐれた"],["知恵","ちえ"],["を"],["用いて","もちいて"],["、"],["神","かみ"],["の"],["あかし"],["を"],["宣べ伝える","のべつたえる"],["こと"],["は"],["しませんでした"],["。"]]},{"verse":2,"text":"なぜなら私は、あなたがたの間で、イエス・キリスト、すなわち十字架につけられた方のほかは、何も知らないことに決心したからです。","tok":[["なぜ"],["なら"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["、"],["イエス"],["・"],["キリスト"],["、"],["すなわち"],["十字架","じゅうじか"],["に"],["つけられた"],["方","ほう"],["の"],["ほか"],["は"],["、"],["何","なん"],["も"],["知らない","しらない"],["こと"],["に"],["決心","けっしん"],["した"],["から"],["です"],["。"]]},{"verse":3,"text":"あなたがたといっしょにいたときの私は、弱く、恐れおののいていました。","tok":[["あなた"],["がた"],["と"],["いっしょ"],["に"],["いた"],["とき"],["の"],["私","わたくし"],["は"],["、"],["弱く","よわく"],["、"],["恐れおののいて","おそれおののいて"],["いました"],["。"]]},{"verse":4,"text":"そして、私のことばと私の宣教とは、説得力のある知恵のことばによって行われたものではなく、御霊と御力の現れでした。","tok":[["そして"],["、"],["私","わたくし"],["の"],["ことば"],["と"],["私","わたくし"],["の"],["宣教","せんきょう"],["と"],["は"],["、"],["説得力","せっとくりょく"],["の"],["ある"],["知恵","ちえ"],["の"],["ことば"],["によって"],["行われた","おこなわれた"],["もの"],["で"],["は"],["なく"],["、"],["御霊","ごれい"],["と"],["御力","おちから"],["の"],["現れ","あらわれ"],["でした"],["。"]]},{"verse":5,"text":"それは、あなたがたの持つ信仰が、人間の知恵にささえられず、神の力にささえられるためでした。","tok":[["それ"],["は"],["、"],["あなた"],["がた"],["の"],["持つ","もつ"],["信仰","しんこう"],["が"],["、"],["人間","にんげん"],["の"],["知恵","ちえ"],["に"],["ささえられず"],["、"],["神","かみ"],["の"],["力","ちから"],["に"],["ささえられる"],["ため"],["でした"],["。"]]},{"verse":6,"text":"しかし私たちは、成人の間で、知恵を語ります。この知恵は、この世の知恵でもなく、この世の過ぎ去って行く支配者たちの知恵でもありません。","tok":[["しかし"],["私たち","わたしたち"],["は"],["、"],["成人","せいじん"],["の"],["間","あいだ"],["で"],["、"],["知恵","ちえ"],["を"],["語ります","かたります"],["。"],["この"],["知恵","ちえ"],["は"],["、"],["この世","このよ"],["の"],["知恵","ちえ"],["で"],["も"],["なく"],["、"],["この世","このよ"],["の"],["過ぎ去って","すぎさって"],["行く","いく"],["支配者","しはいしゃ"],["たち"],["の"],["知恵","ちえ"],["で"],["も"],["ありません"],["。"]]},{"verse":7,"text":"私たちの語るのは、隠された奥義としての神の知恵であって、それは、神が、私たちの栄光のために、世界の始まる前から、あらかじめ定められたものです。","tok":[["私たち","わたしたち"],["の"],["語る","かたる"],["の"],["は"],["、"],["隠された","かくされた"],["奥義","おうぎ"],["として"],["の"],["神","かみ"],["の"],["知恵","ちえ"],["で"],["あって"],["、"],["それ"],["は"],["、"],["神","かみ"],["が"],["、"],["私たち","わたしたち"],["の"],["栄光","えいこう"],["の"],["ため"],["に"],["、"],["世界","せかい"],["の"],["始まる","はじまる"],["前","まえ"],["から"],["、"],["あらかじめ"],["定められた","さだめられた"],["もの"],["です"],["。"]]},{"verse":8,"text":"この知恵を、この世の支配者たちは、だれひとりとして悟りませんでした。もし悟っていたら、栄光の主を十字架につけはしなかったでしょう。","tok":[["この"],["知恵","ちえ"],["を"],["、"],["この世","このよ"],["の"],["支配者","しはいしゃ"],["たち"],["は"],["、"],["だれ"],["ひとり"],["として"],["悟りませんでした","さとりませんでした"],["。"],["もし"],["悟って","さとって"],["いたら"],["、"],["栄光","えいこう"],["の"],["主","ぬし"],["を"],["十字架","じゅうじか"],["に"],["つけ"],["は"],["しなかったでしょう"],["。"]]},{"verse":9,"text":"まさしく、聖書に書いてあるとおりです。「目が見たことのないもの、耳が聞いたことのないもの、そして、人の心に思い浮かんだことのないもの。神を愛する者のために、神の備えてくださったものは、みなそうである。」","tok":[["まさしく"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"],["「"],["目","め"],["が"],["見た","みた"],["こと"],["の"],["ない"],["もの"],["、"],["耳","みみ"],["が"],["聞いた","きいた"],["こと"],["の"],["ない"],["もの"],["、"],["そして"],["、"],["人","ひと"],["の"],["心","こころ"],["に"],["思い浮かんだ","おもいうかんだ"],["こと"],["の"],["ない"],["もの"],["。"],["神","かみ"],["を"],["愛する","あいする"],["者","もの"],["の"],["ため"],["に"],["、"],["神","かみ"],["の"],["備えて","そなえて"],["くださった"],["もの"],["は"],["、"],["みな"],["そう"],["で"],["ある"],["。"],["」"]]},{"verse":10,"text":"神はこれを、御霊によって私たちに啓示されたのです。御霊はすべてのことを探り、神の深みにまで及ばれるからです。","tok":[["神","かみ"],["は"],["これ"],["を"],["、"],["御霊","ごれい"],["によって"],["私たち","わたしたち"],["に"],["啓示","けいじ"],["された"],["の"],["です"],["。"],["御霊","ごれい"],["は"],["すべて"],["の"],["こと"],["を"],["探り","さぐり"],["、"],["神","かみ"],["の"],["深み","ふかみ"],["に"],["まで"],["及ばれる","およばれる"],["から"],["です"],["。"]]},{"verse":11,"text":"いったい、人の心のことは、その人のうちにある霊のほかに、だれが知っているでしょう。同じように、神のみこころのことは、神の御霊のほかにはだれも知りません。","tok":[["いったい"],["、"],["人","ひと"],["の"],["心","こころ"],["の"],["こと"],["は"],["、"],["その"],["人","ひと"],["の"],["うち"],["に"],["ある"],["霊","れい"],["の"],["ほか"],["に"],["、"],["だれ"],["が"],["知って","しって"],["いるでしょう"],["。"],["同じ","おなじ"],["よう"],["に"],["、"],["神","かみ"],["のみ"],["こころ"],["の"],["こと"],["は"],["、"],["神","かみ"],["の"],["御霊","ごれい"],["の"],["ほか"],["に"],["は"],["だれ"],["も"],["知りません","しりません"],["。"]]},{"verse":12,"text":"ところで、私たちは、この世の霊を受けたのではなく、神の御霊を受けました。それは、恵みによって神から私たちに賜ったものを、私たちが知るためです。","tok":[["ところ"],["で"],["、"],["私たち","わたしたち"],["は"],["、"],["この世","このよ"],["の"],["霊","れい"],["を"],["受けた","うけた"],["ので"],["は"],["なく"],["、"],["神","かみ"],["の"],["御霊","ごれい"],["を"],["受けました","うけました"],["。"],["それ"],["は"],["、"],["恵み","めぐみ"],["によって"],["神","かみ"],["から"],["私たち","わたしたち"],["に"],["賜った","たまわった"],["もの"],["を"],["、"],["私たち","わたしたち"],["が"],["知る","しる"],["ため"],["です"],["。"]]},{"verse":13,"text":"この賜物について話すには、人の知恵に教えられたことばを用いず、御霊に教えられたことばを用います。その御霊のことばをもって御霊のことを解くのです。","tok":[["この"],["賜物","たまもの"],["について"],["話す","はなす"],["に"],["は"],["、"],["人","ひと"],["の"],["知恵","ちえ"],["に"],["教えられた","おしえられた"],["ことば"],["を"],["用いず","もちいず"],["、"],["御霊","ごれい"],["に"],["教えられた","おしえられた"],["ことば"],["を"],["用います","もちいます"],["。"],["その"],["御霊","みたま"],["の"],["ことば"],["を"],["もって"],["御霊","ごれい"],["の"],["こと"],["を"],["解く","とく"],["の"],["です"],["。"]]},{"verse":14,"text":"生まれながらの人間は、神の御霊に属することを受け入れません。それらは彼には愚かなことだからです。また、それを悟ることができません。なぜなら、御霊のことは御霊によってわきまえるものだからです。","tok":[["生まれ","うまれ"],["ながら"],["の"],["人間","にんげん"],["は"],["、"],["神","かみ"],["の"],["御霊","ごれい"],["に"],["属する","ぞくする"],["こと"],["を"],["受け入れません","うけいれません"],["。"],["それ"],["ら"],["は"],["彼","かれ"],["に"],["は"],["愚か","おろか"],["な"],["こと"],["だ"],["から"],["です"],["。"],["また"],["、"],["それ"],["を"],["悟る","さとる"],["こと"],["が"],["できません"],["。"],["なぜ"],["なら"],["、"],["御霊","ごれい"],["の"],["こと"],["は"],["御霊","ごれい"],["によって"],["わきまえる"],["もの"],["だ"],["から"],["です"],["。"]]},{"verse":15,"text":"御霊を受けている人は、すべてのことをわきまえますが、自分はだれによってもわきまえられません。","tok":[["御霊","ごれい"],["を"],["受けて","うけて"],["いる"],["人","ひと"],["は"],["、"],["すべて"],["の"],["こと"],["を"],["わきまえます"],["が"],["、"],["自分","じぶん"],["は"],["だれ"],["によって"],["も"],["わきまえられません"],["。"]]},{"verse":16,"text":"いったい、「だれが主のみこころを知り、主を導くことができたか。」ところが、私たちには、キリストの心があるのです。","tok":[["いったい"],["、"],["「"],["だれ"],["が"],["主","ぬし"],["のみ"],["こころ"],["を"],["知り","しり"],["、"],["主","ぬし"],["を"],["導く","みちびく"],["こと"],["が"],["できた"],["か"],["。"],["」"],["ところ"],["が"],["、"],["私たち","わたしたち"],["に"],["は"],["、"],["キリスト"],["の"],["心","こころ"],["が"],["ある"],["の"],["です"],["。"]]}]
[{"verse":1,"text":"あなたがたの間に不品行があるということが言われています。しかもそれは、異邦人の中にもないほどの不品行で、父の妻を妻にしている者がいるとのことです。","tok":[["あなた"],["がた"],["の"],["間","あいだ"],["に"],["不品行","ふひんこう"],["が"],["ある"],["と"],["いう"],["こと"],["が"],["言われて","いわれて"],["います"],["。"],["しかも"],["それ"],["は"],["、"],["異邦人","いほうじん"],["の"],["中","なか"],["に"],["も"],["ない"],["ほど"],["の"],["不品行","ふひんこう"],["で"],["、"],["父","ちち"],["の"],["妻","つま"],["を"],["妻","つま"],["に"],["して"],["いる"],["者","もの"],["が"],["いる"],["と"],["の"],["こと"],["です"],["。"]]},{"verse":2,"text":"それなのに、あなたがたは誇り高ぶっています。そればかりか、そのような行いをしている者をあなたがたの中から取り除こうとして悲しむこともなかったのです。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["誇り","ほこり"],["高ぶって","たかぶって"],["います"],["。"],["それ"],["ばかり"],["か"],["、"],["その"],["よう"],["な"],["行い","おこない"],["を"],["して"],["いる"],["者","もの"],["を"],["あなた"],["がた"],["の"],["中","なか"],["から"],["取り除こう","とりのぞこう"],["として"],["悲しむ","かなしむ"],["こと"],["も"],["なかった"],["の"],["です"],["。"]]},{"verse":3,"text":"私のほうでは、からだはそこにいなくても心はそこにおり、現にそこにいるのと同じように、そのような行いをした者を主イエスの御名によってすでにさばきました。","tok":[["私","わたくし"],["の"],["ほう"],["で"],["は"],["、"],["からだ"],["は"],["そこ"],["に"],["いなくて"],["も"],["心","こころ"],["は"],["そこ"],["に"],["おり"],["、"],["現に","げんに"],["そこ"],["に"],["いる"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["その"],["よう"],["な"],["行い","おこない"],["を"],["した"],["者","もの"],["を"],["主","ぬし"],["イエス"],["の"],["御名","ぎょめい"],["によって"],["すでに"],["さばきました"],["。"]]},{"verse":4,"text":"あなたがたが集まったときに、私も、霊においてともにおり、私たちの主イエスの権能をもって、","tok":[["あなた"],["がた"],["が"],["集まった","あつまった"],["とき"],["に"],["、"],["私","わたくし"],["も"],["、"],["霊","れい"],["に"],["おいて"],["とも"],["に"],["おり"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["の"],["権能","けんのう"],["を"],["もって"],["、"]]},{"verse":5,"text":"このような者をサタンに引き渡したのです。それは彼の肉が滅ぼされるためですが、それによって彼の霊が主の日に救われるためです。","tok":[["この"],["よう"],["な"],["者","もの"],["を"],["サタン"],["に"],["引き渡した","ひきわたした"],["の"],["です"],["。"],["それ"],["は"],["彼","かれ"],["の"],["肉","にく"],["が"],["滅ぼされる","ほろぼされる"],["ため"],["です"],["が"],["、"],["それ"],["によって"],["彼","かれ"],["の"],["霊","れい"],["が"],["主","ぬし"],["の"],["日","ひ"],["に"],["救われる","すくわれる"],["ため"],["です"],["。"]]},{"verse":6,"text":"あなたがたの高慢は、よくないことです。あなたがたは、ほんのわずかのパン種が、粉のかたまり全体をふくらませることを知らないのですか。","tok":[["あなた"],["がた"],["の"],["高慢","こうまん"],["は"],["、"],["よく"],["ない"],["こと"],["です"],["。"],["あなた"],["がた"],["は"],["、"],["ほんの"],["わずか"],["の"],["パン種","ぱんだね"],["が"],["、"],["粉","こな"],["の"],["かたまり"],["全体","ぜんたい"],["を"],["ふくらませる"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"]]},{"verse":7,"text":"新しい粉のかたまりのままでいるために、古いパン種を取り除きなさい。あなたがたはパン種のないものだからです。私たちの過越の小羊キリストが、すでにほふられたからです。","tok":[["新しい","あたらしい"],["粉","こな"],["の"],["かたまり"],["の"],["まま"],["で"],["いる"],["ため"],["に"],["、"],["古い","ふるい"],["パン種","ぱんだね"],["を"],["取り除き","とりのぞき"],["なさい"],["。"],["あなた"],["がた"],["は"],["パン種","ぱんだね"],["の"],["ない"],["もの"],["だ"],["から"],["です"],["。"],["私たち","わたしたち"],["の"],["過越","すぎこし"],["の"],["小羊","こひつじ"],["キリスト"],["が"],["、"],["すでに"],["ほふられた"],["から"],["です"],["。"]]},{"verse":8,"text":"ですから、私たちは、古いパン種を用いたり、悪意と不正のパン種を用いたりしないで、パン種の入らない、純粋で真実なパンで、祭りをしようではありませんか。","tok":[["です"],["から"],["、"],["私たち","わたしたち"],["は"],["、"],["古い","ふるい"],["パン種","ぱんだね"],["を"],["用い","もちい"],["たり"],["、"],["悪意","あくい"],["と"],["不正","ふせい"],["の"],["パン種","ぱんだね"],["を"],["用い","もちい"],["たり"],["しないで"],["、"],["パン種","ぱんだね"],["の"],["入らない","はいらない"],["、"],["純粋","じゅんすい"],["で"],["真実","しんじつ"],["な"],["パン"],["で"],["、"],["祭り","まつり"],["を"],["しようで"],["は"],["ありません"],["か"],["。"]]},{"verse":9,"text":"私は前にあなたがたに送った手紙で、不品行な者たちと交際しないようにと書きました。","tok":[["私","わたくし"],["は"],["前","まえ"],["に"],["あなた"],["がた"],["に"],["送った","おくった"],["手紙","てがみ"],["で"],["、"],["不品行","ふひんこう"],["な"],["者","もの"],["たち"],["と"],["交際","こうさい"],["しない"],["よう"],["に"],["と"],["書きました","かきました"],["。"]]},{"verse":10,"text":"それは、世の中の不品行な者、貪欲な者、略奪する者、偶像を礼拝する者と全然交際しないようにという意味ではありません。もしそうだとしたら、この世界から出て行かなければならないでしょう。","tok":[["それ"],["は"],["、"],["世の中","よのなか"],["の"],["不品行","ふひんこう"],["な"],["者","もの"],["、"],["貪欲","どんよく"],["な"],["者","もの"],["、"],["略奪","りゃくだつ"],["する"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["と"],["全然","ぜんぜん"],["交際","こうさい"],["しない"],["よう"],["に"],["と"],["いう"],["意味","いみ"],["で"],["は"],["ありません"],["。"],["もし"],["そう"],["だ"],["と"],["したら"],["、"],["この"],["世界","せかい"],["から"],["出て","でて"],["行かなければ","いかなければ"],["ならないでしょう"],["。"]]},{"verse":11,"text":"私が書いたことのほんとうの意味は、もし、兄弟と呼ばれる者で、しかも不品行な者、貪欲な者、偶像を礼拝する者、人をそしる者、酒に酔う者、略奪する者がいたなら、そのような者とはつきあってはいけない、いっしょに食事をしてもいけない、ということです。","tok":[["私","わたくし"],["が"],["書いた","かいた"],["こと"],["の"],["ほんとう"],["の"],["意味","いみ"],["は"],["、"],["もし"],["、"],["兄弟","きょうだい"],["と"],["呼ばれる","よばれる"],["者","もの"],["で"],["、"],["しかも"],["不品行","ふひんこう"],["な"],["者","もの"],["、"],["貪欲","どんよく"],["な"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["、"],["人","ひと"],["を"],["そしる"],["者","もの"],["、"],["酒","さけ"],["に"],["酔う","よう"],["者","もの"],["、"],["略奪","りゃくだつ"],["する"],["者","もの"],["が"],["いたなら"],["、"],["その"],["よう"],["な"],["者","もの"],["と"],["は"],["つきあって"],["は"],["いけない"],["、"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["して"],["も"],["いけない"],["、"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":12,"text":"外部の人たちをさばくことは、私のすべきことでしょうか。あなたがたがさばくべき者は、内部の人たちではありませんか。","tok":[["外部","がいぶ"],["の"],["人","ひと"],["たち"],["を"],["さばく"],["こと"],["は"],["、"],["私","わたくし"],["の"],["すべき"],["こと"],["でしょう"],["か"],["。"],["あなた"],["がた"],["が"],["さばくべき"],["者","もの"],["は"],["、"],["内部","ないぶ"],["の"],["人","ひと"],["たち"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":13,"text":"外部の人たちは、神がおさばきになります。その悪い人をあなたがたの中から除きなさい。","tok":[["外部","がいぶ"],["の"],["人","ひと"],["たち"],["は"],["、"],["神","かみ"],["が"],["おさばき"],["に"],["なります"],["。"],["その"],["悪い","わるい"],["人","ひと"],["を"],["あなた"],["がた"],["の"],["中","なか"],["から"],["除き","のぞき"],["なさい"],["。"]]}]
[{"verse":1,"text":"こういうわけで、私たちを、キリストのしもべ、また神の奥義の管理者だと考えなさい。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["私たち","わたしたち"],["を"],["、"],["キリスト"],["の"],["しもべ"],["、"],["また"],["神","かみ"],["の"],["奥義","おうぎ"],["の"],["管理者","かんりしゃ"],["だ"],["と"],["考え","かんがえ"],["なさい"],["。"]]},{"verse":2,"text":"この場合、管理者には、忠実であることが要求されます。","tok":[["この"],["場合","ばあい"],["、"],["管理者","かんりしゃ"],["に"],["は"],["、"],["忠実","ちゅうじつ"],["で"],["ある"],["こと"],["が"],["要求","ようきゅう"],["されます"],["。"]]},{"verse":3,"text":"しかし、私にとっては、あなたがたによる判定、あるいは、およそ人間による判決を受けることは、非常に小さなことです。事実、私は自分で自分をさばくことさえしません。","tok":[["しかし"],["、"],["私","わたくし"],["にとって"],["は"],["、"],["あなた"],["がた"],["に"],["よる"],["判定","はんてい"],["、"],["あるいは"],["、"],["およそ"],["人間","にんげん"],["に"],["よる"],["判決","はんけつ"],["を"],["受ける","うける"],["こと"],["は"],["、"],["非常","ひじょう"],["に"],["小さな","ちいさな"],["こと"],["です"],["。"],["事実","じじつ"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["で"],["自分","じぶん"],["を"],["さばく"],["こと"],["さえ"],["しません"],["。"]]},{"verse":4,"text":"私にはやましいことは少しもありませんが、だからといって、それで無罪とされるのではありません。私をさばく方は主です。","tok":[["私","わたくし"],["に"],["は"],["やましい"],["こと"],["は"],["少し","すこし"],["も"],["ありません"],["が"],["、"],["だ"],["から"],["と"],["いって"],["、"],["それ"],["で"],["無罪","むざい"],["と"],["される"],["ので"],["は"],["ありません"],["。"],["私","わたくし"],["を"],["さばく"],["方","ほう"],["は"],["主","ぬし"],["です"],["。"]]},{"verse":5,"text":"ですから、あなたがたは、主が来られるまでは、何についても、先走ったさばきをしてはいけません。主は、やみの中に隠れた事も明るみに出し、心の中のはかりごとも明らかにされます。そのとき、神から各人に対する称賛が届くのです。","tok":[["です"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["主","ぬし"],["が"],["来られる","こられる"],["まで"],["は"],["、"],["何","なん"],["について"],["も"],["、"],["先走った","さきばしった"],["さばき"],["を"],["して"],["は"],["いけません"],["。"],["主","ぬし"],["は"],["、"],["やみ"],["の"],["中","なか"],["に"],["隠れた","かくれた"],["事","こと"],["も"],["明るみ","あかるみ"],["に"],["出し","だし"],["、"],["心","こころ"],["の"],["中","なか"],["の"],["はかりごと"],["も"],["明らか","あきらか"],["に"],["されます"],["。"],["その"],["とき"],["、"],["神","かみ"],["から"],["各人","かくじん"],["に"],["対する","たいする"],["称賛","しょうさん"],["が"],["届く","とどく"],["の"],["です"],["。"]]},{"verse":6,"text":"さて、兄弟たち。以上、私は、私自身とアポロに当てはめて、あなたがたのために言って来ました。それは、あなたがたが、私たちの例によって、「書かれていることを越えない」ことを学ぶため、そして、一方にくみし、他方に反対して高慢にならないためです。","tok":[["さて"],["、"],["兄弟","きょうだい"],["たち"],["。"],["以上","いじょう"],["、"],["私","わたくし"],["は"],["、"],["私自身","わたしじしん"],["と"],["アポロ"],["に"],["当てはめて","あてはめて"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["言って","いって"],["来ました","きました"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["私たち","わたしたち"],["の"],["例","れい"],["によって"],["、"],["「"],["書かれて","かかれて"],["いる"],["こと"],["を"],["越えない","こえない"],["」"],["こと"],["を"],["学ぶ","まなぶ"],["ため"],["、"],["そして"],["、"],["一方","いっぽう"],["に"],["くみし"],["、"],["他方","たほう"],["に"],["反対","はんたい"],["して"],["高慢","こうまん"],["に"],["ならない"],["ため"],["です"],["。"]]},{"verse":7,"text":"いったいだれが、あなたをすぐれた者と認めるのですか。あなたには、何か、もらったものでないものがあるのですか。もしもらったのなら、なぜ、もらっていないかのように誇るのですか。","tok":[["いったい"],["だれ"],["が"],["、"],["あなた"],["を"],["すぐれた"],["者","もの"],["と"],["認める","みとめる"],["の"],["です"],["か"],["。"],["あなた"],["に"],["は"],["、"],["何","なん"],["か"],["、"],["もらった"],["もの"],["で"],["ない"],["もの"],["が"],["ある"],["の"],["です"],["か"],["。"],["もし"],["もらった"],["の"],["なら"],["、"],["なぜ"],["、"],["もらって"],["いない"],["か"],["の"],["よう"],["に"],["誇る","ほこる"],["の"],["です"],["か"],["。"]]},{"verse":8,"text":"あなたがたは、もう満ち足りています。もう豊かになっています。私たち抜きで、王さまになっています。いっそのこと、あなたがたがほんとうに王さまになっていたらよかったのです。そうすれば、私たちも、あなたがたといっしょに王になれたでしょうに。","tok":[["あなた"],["がた"],["は"],["、"],["もう"],["満ち足りて","みちたりて"],["います"],["。"],["もう"],["豊か","ゆたか"],["に"],["なって"],["います"],["。"],["私たち","わたしたち"],["抜き","ぬき"],["で"],["、"],["王","おう"],["さま"],["に"],["なって"],["います"],["。"],["いっそ"],["の"],["こと"],["、"],["あなた"],["がた"],["が"],["ほんとう"],["に"],["王","おう"],["さま"],["に"],["なって"],["いたら"],["よかった"],["の"],["です"],["。"],["そう"],["すれば"],["、"],["私たち","わたしたち"],["も"],["、"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["王","おう"],["に"],["なれたでしょう"],["に"],["。"]]},{"verse":9,"text":"私は、こう思います。神は私たち使徒を、死罪に決まった者のように、行列のしんがりとして引き出されました。こうして私たちは、御使いにも人々にも、この世の見せ物になったのです。","tok":[["私","わたくし"],["は"],["、"],["こう"],["思います","おもいます"],["。"],["神","かみ"],["は"],["私たち","わたしたち"],["使徒","しと"],["を"],["、"],["死罪","しざい"],["に"],["決まった","きまった"],["者","もの"],["の"],["よう"],["に"],["、"],["行列","ぎょうれつ"],["の"],["しんがり"],["として"],["引き出されました","ひきだされました"],["。"],["こう"],["して"],["私たち","わたしたち"],["は"],["、"],["御使い","おつかい"],["に"],["も"],["人々","ひとびと"],["に"],["も"],["、"],["この世","このよ"],["の"],["見せ物","みせもの"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":10,"text":"私たちはキリストのために愚かな者ですが、あなたがたはキリストにあって賢い者です。私たちは弱いが、あなたがたは強いのです。あなたがたは栄誉を持っているが、私たちは卑しめられています。","tok":[["私たち","わたしたち"],["は"],["キリスト"],["の"],["ため"],["に"],["愚か","おろか"],["な"],["者","もの"],["です"],["が"],["、"],["あなた"],["がた"],["は"],["キリスト"],["に"],["あって"],["賢い","かしこい"],["者","もの"],["です"],["。"],["私たち","わたしたち"],["は"],["弱い","よわい"],["が"],["、"],["あなた"],["がた"],["は"],["強い","つよい"],["の"],["です"],["。"],["あなた"],["がた"],["は"],["栄誉","えいよ"],["を"],["持って","もって"],["いる"],["が"],["、"],["私たち","わたしたち"],["は"],["卑しめられて","いやしめられて"],["います"],["。"]]},{"verse":11,"text":"今に至るまで、私たちは飢え、渇き、着る物もなく、虐待され、落ち着く先もありません。","tok":[["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["私たち","わたしたち"],["は"],["飢え","うえ"],["、"],["渇き","かわき"],["、"],["着る","きる"],["物","もの"],["も"],["なく"],["、"],["虐待","ぎゃくたい"],["され"],["、"],["落ち着く","おちつく"],["先","さき"],["も"],["ありません"],["。"]]},{"verse":12,"text":"また、私たちは苦労して自分の手で働いています。はずかしめられるときにも祝福し、迫害されるときにも耐え忍び、","tok":[["また"],["、"],["私たち","わたしたち"],["は"],["苦労","くろう"],["して"],["自分","じぶん"],["の"],["手","て"],["で"],["働いて","はたらいて"],["います"],["。"],["はずかしめられる"],["とき"],["に"],["も"],["祝福","しゅくふく"],["し"],["、"],["迫害","はくがい"],["される"],["とき"],["に"],["も"],["耐え忍び","たえしのび"],["、"]]},{"verse":13,"text":"ののしられるときには、慰めのことばをかけます。今でも、私たちはこの世のちり、あらゆるもののかすです。","tok":[["ののしられる"],["とき"],["に"],["は"],["、"],["慰め","なぐさめ"],["の"],["ことば"],["を"],["かけます"],["。"],["今","いま"],["で"],["も"],["、"],["私たち","わたしたち"],["は"],["この世","このよ"],["の"],["ちり"],["、"],["あらゆる"],["もの"],["の"],["かす"],["です"],["。"]]},{"verse":14,"text":"私がこう書くのは、あなたがたをはずかしめるためではなく、愛する私の子どもとして、さとすためです。","tok":[["私","わたくし"],["が"],["こう"],["書く","かく"],["の"],["は"],["、"],["あなた"],["がた"],["を"],["はずかしめる"],["ため"],["で"],["は"],["なく"],["、"],["愛する","あいする"],["私","わたくし"],["の"],["子ども","こども"],["として"],["、"],["さとす"],["ため"],["です"],["。"]]},{"verse":15,"text":"たといあなたがたに、キリストにある養育係が一万人あろうとも、父は多くあるはずがありません。この私が福音によって、キリスト・イエスにあって、あなたがたを生んだのです。","tok":[["たとい"],["あなた"],["がた"],["に"],["、"],["キリスト"],["に"],["ある"],["養育","よういく"],["係","かかり"],["が"],["一万人","いちまんにん"],["あろう"],["とも"],["、"],["父","ちち"],["は"],["多く","おおく"],["ある"],["はず"],["が"],["ありません"],["。"],["この"],["私","わたくし"],["が"],["福音","ふくいん"],["によって"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["あなた"],["がた"],["を"],["生んだ","うんだ"],["の"],["です"],["。"]]},{"verse":16,"text":"ですから、私はあなたがたに勧めます。どうか、私にならう者となってください。","tok":[["です"],["から"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["勧めます","すすめます"],["。"],["どう"],["か"],["、"],["私","わたくし"],["に"],["ならう"],["者","もの"],["と"],["なって"],["ください"],["。"]]},{"verse":17,"text":"そのために、私はあなたがたのところへテモテを送りました。テモテは主にあって私の愛する、忠実な子です。彼は、私が至る所のすべての教会で教えているとおりに、キリスト・イエスにある私の生き方を、あなたがたに思い起こさせてくれるでしょう。","tok":[["その"],["ため"],["に"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["ところ"],["へ"],["テモテ"],["を"],["送りました","おくりました"],["。"],["テモテ"],["は"],["主に","おもに"],["あって"],["私","わたくし"],["の"],["愛する","あいする"],["、"],["忠実","ちゅうじつ"],["な"],["子","こ"],["です"],["。"],["彼","かれ"],["は"],["、"],["私","わたくし"],["が"],["至る所","いたるところ"],["の"],["すべて"],["の"],["教会","きょうかい"],["で"],["教えて","おしえて"],["いる"],["とおり"],["に"],["、"],["キリスト"],["・"],["イエス"],["に"],["ある"],["私","わたくし"],["の"],["生き方","いきかた"],["を"],["、"],["あなた"],["がた"],["に"],["思い起こさせて","おもいおこさせて"],["くれるでしょう"],["。"]]},{"verse":18,"text":"私があなたがたのところへ行くことはあるまいと、思い上がっている人たちがいます。","tok":[["私","わたくし"],["が"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行く","いく"],["こと"],["は"],["あるまい"],["と"],["、"],["思い上がって","おもいあがって"],["いる"],["人","ひと"],["たち"],["が"],["います"],["。"]]},{"verse":19,"text":"しかし、主のみこころであれば、すぐにもあなたがたのところへ行きます。そして、思い上がっている人たちの、ことばではなく、力を見せてもらいましょう。","tok":[["しかし"],["、"],["主","ぬし"],["のみ"],["こころ"],["で"],["あれば"],["、"],["すぐ"],["に"],["も"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行きます","いきます"],["。"],["そして"],["、"],["思い上がって","おもいあがって"],["いる"],["人","ひと"],["たち"],["の"],["、"],["ことば"],["で"],["は"],["なく"],["、"],["力","ちから"],["を"],["見せて","みせて"],["もらいましょう"],["。"]]},{"verse":20,"text":"神の国はことばにはなく、力にあるのです。","tok":[["神","かみ"],["の"],["国","くに"],["は"],["ことば"],["に"],["は"],["なく"],["、"],["力","ちから"],["に"],["ある"],["の"],["です"],["。"]]},{"verse":21,"text":"あなたがたはどちらを望むのですか。私はあなたがたのところへむちを持って行きましょうか。それとも、愛と優しい心で行きましょうか。","tok":[["あなた"],["がた"],["は"],["どちら"],["を"],["望む","のぞむ"],["の"],["です"],["か"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["ところ"],["へ"],["むち"],["を"],["持って","もって"],["行きましょう","いきましょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["愛","あい"],["と"],["優しい","やさしい"],["心","こころ"],["で"],["行きましょう","いきましょう"],["か"],["。"]]}]
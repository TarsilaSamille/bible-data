[{"verse":1,"text":"たとい、私が人の異言や、御使いの異言で話しても、愛がないなら、やかましいどらや、うるさいシンバルと同じです。","tok":[["たとい"],["、"],["私","わたくし"],["が"],["人","ひと"],["の"],["異言","いげん"],["や"],["、"],["御使い","おつかい"],["の"],["異言","いげん"],["で"],["話して","はなして"],["も"],["、"],["愛","あい"],["が"],["ないなら"],["、"],["やかましい"],["どら"],["や"],["、"],["うるさい"],["シンバル"],["と"],["同じ","おなじ"],["です"],["。"]]},{"verse":2,"text":"また、たとい私が預言の賜物を持っており、またあらゆる奥義とあらゆる知識とに通じ、また、山を動かすほどの完全な信仰を持っていても、愛がないなら、何の値うちもありません。","tok":[["また"],["、"],["たとい"],["私","わたくし"],["が"],["預言","よげん"],["の"],["賜物","たまもの"],["を"],["持って","もって"],["おり"],["、"],["また"],["あらゆる"],["奥義","おうぎ"],["と"],["あらゆる"],["知識","ちしき"],["と"],["に"],["通じ","つうじ"],["、"],["また"],["、"],["山","やま"],["を"],["動かす","うごかす"],["ほど"],["の"],["完全","かんぜん"],["な"],["信仰","しんこう"],["を"],["持って","もって"],["いて"],["も"],["、"],["愛","あい"],["が"],["ないなら"],["、"],["何","なん"],["の"],["値うち","ねうち"],["も"],["ありません"],["。"]]},{"verse":3,"text":"また、たとい私が持っている物の全部を貧しい人たちに分け与え、また私のからだを焼かれるために渡しても、愛がなければ、何の役にも立ちません。","tok":[["また"],["、"],["たとい"],["私","わたくし"],["が"],["持って","もって"],["いる"],["物","もの"],["の"],["全部","ぜんぶ"],["を"],["貧しい","まずしい"],["人","ひと"],["たち"],["に"],["分け与え","わけあたえ"],["、"],["また"],["私","わたくし"],["の"],["からだ"],["を"],["焼かれる","やかれる"],["ため"],["に"],["渡して","わたして"],["も"],["、"],["愛","あい"],["が"],["なければ"],["、"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立ちません","たちません"],["。"]]},{"verse":4,"text":"愛は寛容であり、愛は親切です。また人をねたみません。愛は自慢せず、高慢になりません。","tok":[["愛","あい"],["は"],["寛容","かんよう"],["で"],["あり"],["、"],["愛","あい"],["は"],["親切","しんせつ"],["です"],["。"],["また"],["人","ひと"],["を"],["ねたみません"],["。"],["愛","あい"],["は"],["自慢","じまん"],["せず"],["、"],["高慢","こうまん"],["に"],["なりません"],["。"]]},{"verse":5,"text":"礼儀に反することをせず、自分の利益を求めず、怒らず、人のした悪を思わず、","tok":[["礼儀","れいぎ"],["に"],["反する","はんする"],["こと"],["を"],["せず"],["、"],["自分","じぶん"],["の"],["利益","りえき"],["を"],["求めず","もとめず"],["、"],["怒らず","おこらず"],["、"],["人","ひと"],["の"],["した"],["悪","あく"],["を"],["思わず","おもわず"],["、"]]},{"verse":6,"text":"不正を喜ばずに真理を喜びます。","tok":[["不正","ふせい"],["を"],["喜ばず","よろこばず"],["に"],["真理","しんり"],["を"],["喜びます","よろこびます"],["。"]]},{"verse":7,"text":"すべてをがまんし、すべてを信じ、すべてを期待し、すべてを耐え忍びます。","tok":[["すべて"],["を"],["がまん"],["し"],["、"],["すべて"],["を"],["信じ","しんじ"],["、"],["すべて"],["を"],["期待","きたい"],["し"],["、"],["すべて"],["を"],["耐え忍びます","たえしのびます"],["。"]]},{"verse":8,"text":"愛は決して絶えることがありません。預言の賜物ならばすたれます。異言ならばやみます。知識ならばすたれます。","tok":[["愛","あい"],["は"],["決して","けっして"],["絶える","たえる"],["こと"],["が"],["ありません"],["。"],["預言","よげん"],["の"],["賜物","たまもの"],["ならば"],["すたれます"],["。"],["異言","いげん"],["ならば"],["やみます"],["。"],["知識","ちしき"],["ならば"],["すたれます"],["。"]]},{"verse":9,"text":"というのは、私たちの知っているところは一部分であり、預言することも一部分だからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["私たち","わたしたち"],["の"],["知って","しって"],["いる"],["ところ"],["は"],["一部分","いちぶぶん"],["で"],["あり"],["、"],["預言","よげん"],["する"],["こと"],["も"],["一部分","いちぶぶん"],["だ"],["から"],["です"],["。"]]},{"verse":10,"text":"完全なものが現れたら、不完全なものはすたれます。","tok":[["完全","かんぜん"],["な"],["もの"],["が"],["現れたら","あらわれたら"],["、"],["不完全","ふかんぜん"],["な"],["もの"],["は"],["すたれます"],["。"]]},{"verse":11,"text":"私が子どもであったときには、子どもとして話し、子どもとして考え、子どもとして論じましたが、おとなになったときには、子どものことをやめました。","tok":[["私","わたくし"],["が"],["子ども","こども"],["で"],["あった"],["とき"],["に"],["は"],["、"],["子ども","こども"],["として"],["話し","はなし"],["、"],["子ども","こども"],["として"],["考え","かんがえ"],["、"],["子ども","こども"],["として"],["論じました","ろんじました"],["が"],["、"],["おとな"],["に"],["なった"],["とき"],["に"],["は"],["、"],["子ども","こども"],["の"],["こと"],["を"],["やめました"],["。"]]},{"verse":12,"text":"今、私たちは鏡にぼんやり映るものを見ていますが、その時には顔と顔とを合わせて見ることになります。今、私は一部分しか知りませんが、その時には、私が完全に知られているのと同じように、私も完全に知ることになります。","tok":[["今","いま"],["、"],["私たち","わたしたち"],["は"],["鏡","かがみ"],["に"],["ぼんやり"],["映る","うつる"],["もの"],["を"],["見て","みて"],["います"],["が"],["、"],["その"],["時","とき"],["に"],["は"],["顔","かお"],["と"],["顔","かお"],["と"],["を"],["合わせて","あわせて"],["見る","みる"],["こと"],["に"],["なります"],["。"],["今","いま"],["、"],["私","わたくし"],["は"],["一部分","いちぶぶん"],["しか"],["知りません","しりません"],["が"],["、"],["その"],["時","とき"],["に"],["は"],["、"],["私","わたくし"],["が"],["完全","かんぜん"],["に"],["知られて","しられて"],["いる"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["私","わたくし"],["も"],["完全","かんぜん"],["に"],["知る","しる"],["こと"],["に"],["なります"],["。"]]},{"verse":13,"text":"こういうわけで、いつまでも残るものは信仰と希望と愛です。その中で一番すぐれているのは愛です。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["いつ"],["まで"],["も"],["残る","のこる"],["もの"],["は"],["信仰","しんこう"],["と"],["希望","きぼう"],["と"],["愛","あい"],["です"],["。"],["その"],["中","なか"],["で"],["一番","いちばん"],["すぐれて"],["いる"],["の"],["は"],["愛","あい"],["です"],["。"]]}]
[{"verse":1,"text":"さて、兄弟たちよ。私は、あなたがたに向かって、御霊に属する人に対するようには話すことができないで、肉に属する人、キリストにある幼子に対するように話しました。","tok":[["さて"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["に"],["向かって","むかって"],["、"],["御霊","ごれい"],["に"],["属する","ぞくする"],["人","ひと"],["に"],["対する","たいする"],["よう"],["に"],["は"],["話す","はなす"],["こと"],["が"],["できないで"],["、"],["肉","にく"],["に"],["属する","ぞくする"],["人","ひと"],["、"],["キリスト"],["に"],["ある"],["幼子","おさなご"],["に"],["対する","たいする"],["よう"],["に"],["話しました","はなしました"],["。"]]},{"verse":2,"text":"私はあなたがたには乳を与えて、堅い食物を与えませんでした。あなたがたには、まだ無理だったからです。実は、今でもまだ無理なのです。","tok":[["私","わたくし"],["は"],["あなた"],["がた"],["に"],["は"],["乳","ちち"],["を"],["与えて","あたえて"],["、"],["堅い","かたい"],["食物","しょくもつ"],["を"],["与えませんでした","あたえませんでした"],["。"],["あなた"],["がた"],["に"],["は"],["、"],["まだ"],["無理","むり"],["だった"],["から"],["です"],["。"],["実","じつ"],["は"],["、"],["今","いま"],["で"],["も"],["まだ"],["無理","むり"],["な"],["の"],["です"],["。"]]},{"verse":3,"text":"あなたがたは、まだ肉に属しているからです。あなたがたの間にねたみや争いがあることからすれば、あなたがたは肉に属しているのではありませんか。そして、ただの人のように歩んでいるのではありませんか。","tok":[["あなた"],["がた"],["は"],["、"],["まだ"],["肉","にく"],["に"],["属して","ぞくして"],["いる"],["から"],["です"],["。"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["ねたみ"],["や"],["争い","あらそい"],["が"],["ある"],["こと"],["から"],["すれば"],["、"],["あなた"],["がた"],["は"],["肉","にく"],["に"],["属して","ぞくして"],["いる"],["ので"],["は"],["ありません"],["か"],["。"],["そして"],["、"],["ただ"],["の"],["人","ひと"],["の"],["よう"],["に"],["歩んで","あゆんで"],["いる"],["ので"],["は"],["ありません"],["か"],["。"]]},{"verse":4,"text":"ある人が、「私はパウロにつく」と言えば、別の人は、「私はアポロに」と言う。そういうことでは、あなたがたは、ただの人たちではありませんか。","tok":[["ある"],["人","ひと"],["が"],["、"],["「"],["私","わたくし"],["は"],["パウロ"],["に"],["つく"],["」"],["と"],["言えば","いえば"],["、"],["別","べつ"],["の"],["人","ひと"],["は"],["、"],["「"],["私","わたくし"],["は"],["アポロ"],["に"],["」"],["と"],["言う","ゆう"],["。"],["そう"],["いう"],["こと"],["で"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["ただ"],["の"],["人","ひと"],["たち"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":5,"text":"アポロとは何でしょう。パウロとは何でしょう。あなたがたが信仰に入るために用いられたしもべであって、主がおのおのに授けられたとおりのことをしたのです。","tok":[["アポロ"],["と"],["は"],["何","なん"],["でしょう"],["。"],["パウロ"],["と"],["は"],["何","なん"],["でしょう"],["。"],["あなた"],["がた"],["が"],["信仰","しんこう"],["に"],["入る","はいる"],["ため"],["に"],["用いられた","もちいられた"],["しもべ"],["で"],["あって"],["、"],["主","ぬし"],["が"],["おのおの"],["に"],["授けられた","さずけられた"],["とおり"],["の"],["こと"],["を"],["した"],["の"],["です"],["。"]]},{"verse":6,"text":"私が植えて、アポロが水を注ぎました。しかし、成長させたのは神です。","tok":[["私","わたくし"],["が"],["植えて","うえて"],["、"],["アポロ"],["が"],["水","みず"],["を"],["注ぎました","そそぎました"],["。"],["しかし"],["、"],["成長","せいちょう"],["させた"],["の"],["は"],["神","かみ"],["です"],["。"]]},{"verse":7,"text":"それで、たいせつなのは、植える者でも水を注ぐ者でもありません。成長させてくださる神なのです。","tok":[["それ"],["で"],["、"],["たいせつ"],["な"],["の"],["は"],["、"],["植える","うえる"],["者","もの"],["で"],["も"],["水","みず"],["を"],["注ぐ","そそぐ"],["者","もの"],["で"],["も"],["ありません"],["。"],["成長","せいちょう"],["させて"],["くださる"],["神","かみ"],["な"],["の"],["です"],["。"]]},{"verse":8,"text":"植える者と水を注ぐ者は、一つですが、それぞれ自分自身の働きに従って自分自身の報酬を受けるのです。","tok":[["植える","うえる"],["者","もの"],["と"],["水","みず"],["を"],["注ぐ","そそぐ"],["者","もの"],["は"],["、"],["一","ひと"],["つ"],["です"],["が"],["、"],["それぞれ"],["自分","じぶん"],["自身","じしん"],["の"],["働き","はたらき"],["に"],["従って","したがって"],["自分","じぶん"],["自身","じしん"],["の"],["報酬","ほうしゅう"],["を"],["受ける","うける"],["の"],["です"],["。"]]},{"verse":9,"text":"私たちは神の協力者であり、あなたがたは神の畑、神の建物です。","tok":[["私たち","わたしたち"],["は"],["神","かみ"],["の"],["協力者","きょうりょくしゃ"],["で"],["あり"],["、"],["あなた"],["がた"],["は"],["神","かみ"],["の"],["畑","はたけ"],["、"],["神","かみ"],["の"],["建物","たてもの"],["です"],["。"]]},{"verse":10,"text":"与えられた神の恵みによって、私は賢い建築家のように、土台を据えました。そして、ほかの人がその上に家を建てています。しかし、どのように建てるかについてはそれぞれが注意しなければなりません。","tok":[["与えられた","あたえられた"],["神","かみ"],["の"],["恵み","めぐみ"],["によって"],["、"],["私","わたくし"],["は"],["賢い","かしこい"],["建築家","けんちくか"],["の"],["よう"],["に"],["、"],["土台","どだい"],["を"],["据えました","すえました"],["。"],["そして"],["、"],["ほか"],["の"],["人","ひと"],["が"],["その"],["上","うえ"],["に"],["家","いえ"],["を"],["建てて","たてて"],["います"],["。"],["しかし"],["、"],["どの"],["よう"],["に"],["建てる","たてる"],["か"],["について"],["は"],["それぞれ"],["が"],["注意","ちゅうい"],["しなければ"],["なりません"],["。"]]},{"verse":11,"text":"というのは、だれも、すでに据えられている土台のほかに、ほかの物を据えることはできないからです。その土台とはイエス・キリストです。","tok":[["と"],["いう"],["の"],["は"],["、"],["だれ"],["も"],["、"],["すでに"],["据えられて","すえられて"],["いる"],["土台","どだい"],["の"],["ほか"],["に"],["、"],["ほか"],["の"],["物","もの"],["を"],["据える","すえる"],["こと"],["は"],["できない"],["から"],["です"],["。"],["その"],["土台","どだい"],["と"],["は"],["イエス"],["・"],["キリスト"],["です"],["。"]]},{"verse":12,"text":"もし、だれかがこの土台の上に、金、銀、宝石、木、草、わらなどで建てるなら、","tok":[["もし"],["、"],["だれ"],["か"],["が"],["この"],["土台","どだい"],["の"],["上","うえ"],["に"],["、"],["金","きん"],["、"],["銀","ぎん"],["、"],["宝石","ほうせき"],["、"],["木","き"],["、"],["草","くさ"],["、"],["わら"],["など"],["で"],["建てるなら","たてるなら"],["、"]]},{"verse":13,"text":"各人の働きは明瞭になります。その日がそれを明らかにするのです。というのは、その日は火とともに現れ、この火がその力で各人の働きの真価をためすからです。","tok":[["各人","かくじん"],["の"],["働き","はたらき"],["は"],["明瞭","めいりょう"],["に"],["なります"],["。"],["その"],["日","ひ"],["が"],["それ"],["を"],["明らか","あきらか"],["に"],["する"],["の"],["です"],["。"],["と"],["いう"],["の"],["は"],["、"],["その"],["日","ひ"],["は"],["火","ひ"],["と"],["とも"],["に"],["現れ","あらわれ"],["、"],["この"],["火","ひ"],["が"],["その"],["力","ちから"],["で"],["各人","かくじん"],["の"],["働き","はたらき"],["の"],["真価","しんか"],["を"],["ためす"],["から"],["です"],["。"]]},{"verse":14,"text":"もしだれかの建てた建物が残れば、その人は報いを受けます。","tok":[["もし"],["だれ"],["か"],["の"],["建てた","たてた"],["建物","たてもの"],["が"],["残れば","のこれば"],["、"],["その"],["人","ひと"],["は"],["報い","むくい"],["を"],["受けます","うけます"],["。"]]},{"verse":15,"text":"もしだれかの建てた建物が焼ければ、その人は損害を受けますが、自分自身は、火の中をくぐるようにして助かります。","tok":[["もし"],["だれ"],["か"],["の"],["建てた","たてた"],["建物","たてもの"],["が"],["焼ければ","やければ"],["、"],["その"],["人","ひと"],["は"],["損害","そんがい"],["を"],["受けます","うけます"],["が"],["、"],["自分","じぶん"],["自身","じしん"],["は"],["、"],["火","ひ"],["の"],["中","なか"],["を"],["くぐる"],["よう"],["に"],["して"],["助かります","たすかります"],["。"]]},{"verse":16,"text":"あなたがたは神の神殿であり、神の御霊があなたがたに宿っておられることを知らないのですか。","tok":[["あなた"],["がた"],["は"],["神","かみ"],["の"],["神殿","しんでん"],["で"],["あり"],["、"],["神","かみ"],["の"],["御霊","ごれい"],["が"],["あなた"],["がた"],["に"],["宿って","やどって"],["おられる"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"]]},{"verse":17,"text":"もし、だれかが神の神殿をこわすなら、神がその人を滅ぼされます。神の神殿は聖なるものだからです。あなたがたがその神殿です。","tok":[["もし"],["、"],["だれ"],["か"],["が"],["神","かみ"],["の"],["神殿","しんでん"],["を"],["こわすなら"],["、"],["神","かみ"],["が"],["その"],["人","ひと"],["を"],["滅ぼされます","ほろぼされます"],["。"],["神","かみ"],["の"],["神殿","しんでん"],["は"],["聖","せい"],["なる"],["もの"],["だ"],["から"],["です"],["。"],["あなた"],["がた"],["が"],["その"],["神殿","しんでん"],["です"],["。"]]},{"verse":18,"text":"だれも自分を欺いてはいけません。もしあなたがたの中で、自分は今の世の知者だと思う者がいたら、知者になるためには愚かになりなさい。","tok":[["だれ"],["も"],["自分","じぶん"],["を"],["欺いて","あざむいて"],["は"],["いけません"],["。"],["もし"],["あなた"],["がた"],["の"],["中","なか"],["で"],["、"],["自分","じぶん"],["は"],["今","いま"],["の"],["世","よ"],["の"],["知者","ちしゃ"],["だ"],["と"],["思う","おもう"],["者","もの"],["が"],["いたら"],["、"],["知者","ちしゃ"],["に"],["なる"],["ため"],["に"],["は"],["愚か","おろか"],["に"],["なり"],["なさい"],["。"]]},{"verse":19,"text":"なぜなら、この世の知恵は、神の御前では愚かだからです。こう書いてあります。「神は、知者どもを彼らの悪賢さの中で捕らえる。」","tok":[["なぜ"],["なら"],["、"],["この世","このよ"],["の"],["知恵","ちえ"],["は"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["は"],["愚か","おろか"],["だ"],["から"],["です"],["。"],["こう"],["書いて","かいて"],["あります"],["。"],["「"],["神","かみ"],["は"],["、"],["知者","ちしゃ"],["ども"],["を"],["彼","かれ"],["ら"],["の"],["悪賢","わるがしこ"],["さ"],["の"],["中","なか"],["で"],["捕らえる","とらえる"],["。"],["」"]]},{"verse":20,"text":"また、次のようにも書いてあります。「主は、知者の論議を無益だと知っておられる。」","tok":[["また"],["、"],["次","つぎ"],["の"],["よう"],["に"],["も"],["書いて","かいて"],["あります"],["。"],["「"],["主","ぬし"],["は"],["、"],["知者","ちしゃ"],["の"],["論議","ろんぎ"],["を"],["無益","むえき"],["だ"],["と"],["知って","しって"],["おられる"],["。"],["」"]]},{"verse":21,"text":"ですから、だれも人間を誇ってはいけません。すべては、あなたがたのものです。","tok":[["です"],["から"],["、"],["だれ"],["も"],["人間","にんげん"],["を"],["誇って","ほこって"],["は"],["いけません"],["。"],["すべて"],["は"],["、"],["あなた"],["がた"],["の"],["もの"],["です"],["。"]]},{"verse":22,"text":"パウロであれ、アポロであれ、ケパであれ、また世界であれ、いのちであれ、死であれ、また現在のものであれ、未来のものであれ、すべてあなたがたのものです。","tok":[["パウロ"],["で"],["あれ"],["、"],["アポロ"],["で"],["あれ"],["、"],["ケパ"],["で"],["あれ"],["、"],["また"],["世界","せかい"],["で"],["あれ"],["、"],["いのち"],["で"],["あれ"],["、"],["死","し"],["で"],["あれ"],["、"],["また"],["現在","げんざい"],["の"],["もの"],["で"],["あれ"],["、"],["未来","みらい"],["の"],["もの"],["で"],["あれ"],["、"],["すべて"],["あなた"],["がた"],["の"],["もの"],["です"],["。"]]},{"verse":23,"text":"そして、あなたがたはキリストのものであり、キリストは神のものです。","tok":[["そして"],["、"],["あなた"],["がた"],["は"],["キリスト"],["の"],["もの"],["で"],["あり"],["、"],["キリスト"],["は"],["神","かみ"],["の"],["もの"],["です"],["。"]]}]
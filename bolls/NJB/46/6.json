[{"verse":1,"text":"あなたがたの中には、仲間の者と争いを起こしたとき、それを聖徒たちに訴えないで、あえて、正しくない人たちに訴え出るような人がいるのでしょうか。","tok":[["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["、"],["仲間","なかま"],["の"],["者","もの"],["と"],["争い","あらそい"],["を"],["起こした","おこした"],["とき"],["、"],["それ"],["を"],["聖徒","せいと"],["たち"],["に"],["訴えないで","うったえないで"],["、"],["あえて"],["、"],["正しく","ただしく"],["ない"],["人","ひと"],["たち"],["に"],["訴え出る","うったえでる"],["よう"],["な"],["人","ひと"],["が"],["いる"],["の"],["でしょう"],["か"],["。"]]},{"verse":2,"text":"あなたがたは、聖徒が世界をさばくようになることを知らないのですか。世界があなたがたによってさばかれるはずなのに、あなたがたは、ごく小さな事件さえもさばく力がないのですか。","tok":[["あなた"],["がた"],["は"],["、"],["聖徒","せいと"],["が"],["世界","せかい"],["を"],["さばく"],["よう"],["に"],["なる"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"],["世界","せかい"],["が"],["あなた"],["がた"],["によって"],["さばかれる"],["はず"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["ごく"],["小さな","ちいさな"],["事件","じけん"],["さえ"],["も"],["さばく力","さばくりょく"],["が"],["ない"],["の"],["です"],["か"],["。"]]},{"verse":3,"text":"私たちは御使いをもさばくべき者だ、ということを、知らないのですか。それならこの世のことは、言うまでもないではありませんか。","tok":[["私たち","わたしたち"],["は"],["御使い","おつかい"],["を"],["も"],["さばくべき"],["者","もの"],["だ"],["、"],["と"],["いう"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["です"],["か"],["。"],["それ"],["なら"],["この世","このよ"],["の"],["こと"],["は"],["、"],["言う","いう"],["まで"],["も"],["ないで"],["は"],["ありません"],["か"],["。"]]},{"verse":4,"text":"それなのに、この世のことで争いが起こると、教会のうちでは無視される人たちを裁判官に選ぶのですか。","tok":[["それ"],["な"],["のに"],["、"],["この世","このよ"],["の"],["こと"],["で"],["争い","あらそい"],["が"],["起こる","おこる"],["と"],["、"],["教会","きょうかい"],["の"],["うち"],["で"],["は"],["無視","むし"],["される"],["人","ひと"],["たち"],["を"],["裁判官","さいばんかん"],["に"],["選ぶ","えらぶ"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"私はあなたがたをはずかしめるためにこう言っているのです。いったい、あなたがたの中には、兄弟の間の争いを仲裁することのできるような賢い者が、ひとりもいないのですか。","tok":[["私","わたくし"],["は"],["あなた"],["がた"],["を"],["はずかしめる"],["ため"],["に"],["こう"],["言って","いって"],["いる"],["の"],["です"],["。"],["いったい"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["、"],["兄弟","きょうだい"],["の"],["間","あいだ"],["の"],["争い","あらそい"],["を"],["仲裁","ちゅうさい"],["する"],["こと"],["の"],["できる"],["よう"],["な"],["賢い","かしこい"],["者","もの"],["が"],["、"],["ひとり"],["も"],["いない"],["の"],["です"],["か"],["。"]]},{"verse":6,"text":"それで、兄弟は兄弟を告訴し、しかもそれを不信者の前でするのですか。","tok":[["それ"],["で"],["、"],["兄弟","きょうだい"],["は"],["兄弟","きょうだい"],["を"],["告訴","こくそ"],["し"],["、"],["しかも"],["それ"],["を"],["不信者","ふしんしゃ"],["の"],["前","まえ"],["で"],["する"],["の"],["です"],["か"],["。"]]},{"verse":7,"text":"そもそも、互いに訴え合うことが、すでにあなたがたの敗北です。なぜ、むしろ不正をも甘んじて受けないのですか。なぜ、むしろだまされていないのですか。","tok":[["そもそも"],["、"],["互い","たがい"],["に"],["訴え合う","うったえあう"],["こと"],["が"],["、"],["すでに"],["あなた"],["がた"],["の"],["敗北","はいぼく"],["です"],["。"],["なぜ"],["、"],["むしろ"],["不正","ふせい"],["を"],["も"],["甘んじて","あまんじて"],["受けない","うけない"],["の"],["です"],["か"],["。"],["なぜ"],["、"],["むしろ"],["だまされて"],["いない"],["の"],["です"],["か"],["。"]]},{"verse":8,"text":"ところが、それどころか、あなたがたは、不正を行う、だまし取る、しかもそのようなことを兄弟に対してしているのです。","tok":[["ところ"],["が"],["、"],["それ"],["どころ"],["か"],["、"],["あなた"],["がた"],["は"],["、"],["不正","ふせい"],["を"],["行う","おこなう"],["、"],["だまし取る","だましとる"],["、"],["しかも"],["その"],["よう"],["な"],["こと"],["を"],["兄弟","きょうだい"],["に対して","にたいして"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":9,"text":"あなたがたは、正しくない者は神の国を相続できないことを、知らないのですか。だまされてはいけません。不品行な者、偶像を礼拝する者、姦淫をする者、男娼となる者、男色をする者、","tok":[["あなた"],["がた"],["は"],["、"],["正しく","ただしく"],["ない"],["者","もの"],["は"],["神","かみ"],["の"],["国","くに"],["を"],["相続","そうぞく"],["できない"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["です"],["か"],["。"],["だまされて"],["は"],["いけません"],["。"],["不品行","ふひんこう"],["な"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["、"],["姦淫","かんいん"],["を"],["する"],["者","もの"],["、"],["男娼","だんしょう"],["と"],["なる"],["者","もの"],["、"],["男色","だんしょく"],["を"],["する"],["者","もの"],["、"]]},{"verse":10,"text":"盗む者、貪欲な者、酒に酔う者、そしる者、略奪する者はみな、神の国を相続することができません。","tok":[["盗む","ぬすむ"],["者","もの"],["、"],["貪欲","どんよく"],["な"],["者","もの"],["、"],["酒","さけ"],["に"],["酔う","よう"],["者","もの"],["、"],["そしる"],["者","もの"],["、"],["略奪","りゃくだつ"],["する"],["者","もの"],["は"],["みな"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["相続","そうぞく"],["する"],["こと"],["が"],["できません"],["。"]]},{"verse":11,"text":"あなたがたの中のある人た
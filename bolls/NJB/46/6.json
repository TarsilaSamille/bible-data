"取って","とって"],["遊女","ゆうじょ"],["の"],["からだ"],["と"],["する"],["の"],["です"],["か"],["。"],["そんな"],["こと"],["は"],["絶対","ぜったい"],["に"],["許されません","ゆるされません"],["。"]]},{"verse":16,"text":"遊女と交われば、一つからだになることを知らないのですか。「ふたりは一体となる」と言われているからです。","tok":[["遊女","ゆうじょ"],["と"],["交われば","まじわれば"],["、"],["一","ひと"],["つ"],["からだ"],["に"],["なる"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"],["「"],["ふたり"],["は"],["一体","いったい"],["と"],["なる"],["」"],["と"],["言われて","いわれて"],["いる"],["から"],["です"],["。"]]},{"verse":17,"text":"しかし、主と交われば、一つ霊となるのです。","tok":[["しかし"],["、"],["主","ぬし"],["と"],["交われば","まじわれば"],["、"],["一","ひと"],["つ"],["霊","れい"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":18,"text":"不品行を避けなさい。人が犯す罪はすべて、からだの外のものです。しかし、不品行を行う者は、自分のからだに対して罪を犯すのです。","tok":[["不品行","ふひんこう"],["を"],["避け","さけ"],["なさい"],["。"],["人","ひと"],["が"],["犯す","おかす"],["罪","つみ"],["は"],["すべて"],["、"],["からだ"],["の"],["外","そと"],["の"],["もの"],["です"],["。"],["しかし"],["、"],["不品行","ふひんこう"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["からだ"],["に対して","にたいして"],["罪","つみ"],["を"],["犯す","おかす"],["の"],["です"],["。"]]},{"verse":19,"text":"あなたがたのからだは、あなたがたのうちに住まれる、神から受けた聖霊の宮であり、あなたがたは、もはや自分自身のものではないことを、知らないのですか。","tok":[["あなた"],["がた"],["の"],["からだ"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["住まれる","すまれる"],["、"],["神","かみ"],["から"],["受けた","うけた"],["聖霊","せいれい"],["の"],["宮","みや"],["で"],["あり"],["、"],["あなた"],["がた"],["は"],["、"],["もはや"],["自分","じぶん"],["自身","じしん"],["の"],["もの"],["で"],["は"],["ない"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["です"],["か"],["。"]]},{"verse":20,"text":"あなたがたは、代価を払って買い取られたのです。ですから自分のからだをもって、神の栄光を現しなさい。","tok":[["あなた"],["がた"],["は"],["、"],["代価","だいか"],["を"],["払って","はらって"],["買い取られた","かいとられた"],["の"],["です"],["。"],["です"],["から"],["自分","じぶん"],["の"],["からだ"],["を"],["もって"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["現し","あらわし"],["なさい"],["。"]]}]
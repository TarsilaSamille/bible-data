[{"verse":1,"text":"神のみこころによってキリスト・イエスの使徒として召されたパウロと、兄弟ソステネから、","tok":[["神","かみ"],["のみ"],["こころ"],["によって"],["キリスト"],["・"],["イエス"],["の"],["使徒","しと"],["として"],["召された","めされた"],["パウロ"],["と"],["、"],["兄弟","きょうだい"],["ソステネ"],["から"],["、"]]},{"verse":2,"text":"コリントにある神の教会へ。すなわち、私たちの主イエス・キリストの御名を、至る所で呼び求めているすべての人々とともに、聖徒として召され、キリスト・イエスにあって聖なるものとされた方々へ。主は私たちの主であるとともに、そのすべての人々の主です。","tok":[["コリント"],["に"],["ある"],["神","かみ"],["の"],["教会","きょうかい"],["へ"],["。"],["すなわち"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["御名","ぎょめい"],["を"],["、"],["至る所","いたるところ"],["で"],["呼び求めて","よびもとめて"],["いる"],["すべて"],["の"],["人々","ひとびと"],["と"],["とも"],["に"],["、"],["聖徒","せいと"],["として"],["召され","めされ"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["聖","せい"],["なる"],["もの"],["と"],["された"],["方々","かたがた"],["へ"],["。"],["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["主","ぬし"],["で"],["ある"],["と"],["とも"],["に"],["、"],["その"],["すべて"],["の"],["人々","ひとびと"],["の"],["主","ぬし"],["です"],["。"]]},{"verse":3,"text":"私たちの父なる神と主イエス・キリストから、恵みと平安があなたがたの上にありますように。","tok":[["私たち","わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"]]},{"verse":4,"text":"私は、キリスト・イエスによってあなたがたに与えられた神の恵みのゆえに、あなたがたのことをいつも神に感謝しています。","tok":[["私","わたくし"],["は"],["、"],["キリスト"],["・"],["イエス"],["によって"],["あなた"],["がた"],["に"],["与えられた","あたえられた"],["神","かみ"],["の"],["恵み","めぐみ"],["の"],["ゆえ"],["に"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["いつも"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":5,"text":"というのは、あなたがたは、ことばといい、知識といい、すべてにおいて、キリストにあって豊かな者とされたからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["ことば"],["と"],["いい"],["、"],["知識","ちしき"],["と"],["いい"],["、"],["すべて"],["に"],["おいて"],["、"],["キリスト"],["に"],["あって"],["豊か","ゆたか"],["な"],["者","もの"],["と"],["された"],["から"],["です"],["。"]]},{"verse":6,"text":"それは、キリストについてのあかしが、あなたがたの中で確かになったからで、","tok":[["それ"],["は"],["、"],["キリスト"],["について"],["の"],["あかし"],["が"],["、"],["あなた"],["がた"],["の"],["中","なか"],["で"],["確か","たしか"],["に"],["なった"],["から"],["で"],["、"]]},{"verse":7,"text":"その結果、あなたがたはどんな賜物にも欠けるところがなく、また、熱心に私たちの主イエス・キリストの現れを待っています。","tok":[["その"],["結果","けっか"],["、"],["あなた"],["がた"],["は"],["どんな"],["賜物","たまもの"],["に"],["も"],["欠ける","かける"],["ところ"],["が"],["なく"],["、"],["また"],["、"],["熱心","ねっしん"],["に"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["現れ","あらわれ"],["を"],["待って","まって"],["います"],["。"]]},{"verse":8,"text":"主も、あなたがたを、私たちの主イエス・キリストの日に責められるところのない者として、最後まで堅く保ってくださいます。","tok":[["主","ぬし"],["も"],["、"],["あなた"],["がた"],["を"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["日","ひ"],["に"],["責められる","せめられる"],["ところ"],["の"],["ない"],["者","もの"],["として"],["、"],["最後","さいご"],["まで"],["堅く","かたく"],["保って","たもって"],["くださいます"],["。"]]},{"verse":9,"text":"神は真実であり、その方のお召しによって、あなたがたは神の御子、私たちの主イエス・キリストとの交わりに入れられました。","tok":[["神","かみ"],["は"],["真実","しんじつ"],["で"],["あり"],["、"],["その"],["方","かた"],["の"],["お召し","おめし"],["によって"],["、"],["あなた"],["がた"],["は"],["神","かみ"],["の"],["御子","みこ"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["と"],["の"],["交わり","まじわり"],["に"],["入れられました","いれられました"],["。"]]},{"verse":10,"text":"さて、兄弟たち。私は、私たちの主イエス・キリストの御名によって、あなたがたにお願いします。どうか、みなが一致して、仲間割れすることなく、同じ心、同じ判断を完全に保ってください。","tok":[["さて"],["、"],["兄弟","きょうだい"],["たち"],["。"],["私","わたくし"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["御名","ぎょめい"],["によって"],["、"],["あなた"],["がた"],["に"],["お願い","おねがい"],["します"],["。"],["どう"],["か"],["、"],["みな"],["が"],["一致","いっち"],["して"],["、"],["仲間","なかま"],["割れ","われ"],["する"],["こと"],["なく"],["、"],["同じ","おなじ"],["心","こころ"],["、"],["同じ","おなじ"],["判断","はんだん"],["を"],["完全","かんぜん"],["に"],["保って","たもって"],["ください"],["。"]]},{"verse":11,"text":"実はあなたがたのことをクロエの家の者から知らされました。兄弟たち。あなたがたの間には争いがあるそうで、","tok":[["実","じつ"],["は"],["あなた"],["がた"],["の"],["こと"],["を"],["クロエ"],["の"],["家","いえ"],["の"],["者","もの"],["から"],["知らされました","しらされました"],["。"],["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["は"],["争い","あらそい"],[
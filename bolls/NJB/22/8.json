[{"verse":1,"text":"ああ、もし、あなたが私の母の乳房を吸った／私の兄弟のようであったなら、私が外であなたに出会い、あなたに口づけしても、だれも私をさげすまないでしょうに。","tok":[["ああ"],["、"],["もし"],["、"],["あなた"],["が"],["私","わたくし"],["の"],["母","はは"],["の"],["乳房","ちぶさ"],["を"],["吸った","すった"],["／"],["私","わたくし"],["の"],["兄弟","きょうだい"],["の"],["よう"],["で"],["あったなら"],["、"],["私","わたくし"],["が"],["外","そと"],["で"],["あなた"],["に"],["出会い","であい"],["、"],["あなた"],["に"],["口づけ","くちづけ"],["して"],["も"],["、"],["だれ"],["も"],["私","わたくし"],["を"],["さげすまないでしょう"],["に"],["。"]]},{"verse":2,"text":"私はあなたを導き、私を育てた私の母の家にお連れして、香料を混ぜたぶどう酒、ざくろの果汁を／あなたに飲ませてあげましょう。","tok":[["私","わたくし"],["は"],["あなた"],["を"],["導き","みちびき"],["、"],["私","わたくし"],["を"],["育てた","そだてた"],["私","わたくし"],["の"],["母","はは"],["の"],["家","いえ"],["に"],["お連れ","おつれ"],["して"],["、"],["香料","こうりょう"],["を"],["混ぜた","まぜた"],["ぶどう酒","ぶどうしゅ"],["、"],["ざくろ"],["の"],["果汁","かじゅう"],["を"],["／"],["あなた"],["に"],["飲ませて","のませて"],["あげましょう"],["。"]]},{"verse":3,"text":"ああ、あの方の左の腕が私の頭の下にあり、右の手が私を抱いてくださるとよいのに。","tok":[["ああ"],["、"],["あの"],["方","かた"],["の"],["左","ひだり"],["の"],["腕","うで"],["が"],["私","わたくし"],["の"],["頭","あたま"],["の"],["下","した"],["に"],["あり"],["、"],["右","みぎ"],["の"],["手","て"],["が"],["私","わたくし"],["を"],["抱いて","いだいて"],["くださる"],["と"],["よい"],["のに"],["。"]]},{"verse":4,"text":"エルサレムの娘たち。／私はあなたがたに誓っていただきます。／揺り起こしたり、かき立てたりしないでください。／愛が目ざめたいと思うときまでは。","tok":[["エルサレム"],["の"],["娘","むすめ"],["たち"],["。"],["／"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["誓って","ちかって"],["いただきます"],["。"],["／"],["揺り起こし","ゆりおこし"],["たり"],["、"],["かき立て","かきたて"],["たり"],["しないで"],["ください"],["。"],["／"],["愛","あい"],["が"],["目ざめたい","めざめたい"],["と"],["思う","おもう"],["とき"],["まで"],["は"],["。"]]},{"verse":5,"text":"自分の愛する者に寄りかかって、荒野から上って来るひとはだれでしょう。／私はりんごの木の下で／あなたの目をさまさせた。／そこはあなたの母があなたのために／産みの苦しみをした所。／そこはあなたを産んだ者が／産みの苦しみをした所。","tok":[["自分","じぶん"],["の"],["愛する","あいする"],["者","もの"],["に"],["寄りかかって","よりかかって"],["、"],["荒野","こうや"],["から"],["上って","のぼって"],["来る","くる"],["ひと"],["は"],["だれ"],["でしょう"],["。"],["／"],["私","わたくし"],["は"],["りんご"],["の"],["木","き"],["の"],["下","もと"],["で"],["／"],["あなた"],["の"],["目","め"],["を"],["さまさせた"],["。"],["／"],["そこ"],["は"],["あなた"],["の"],["母","はは"],["が"],["あなた"],["の"],["ため"],["に"],["／"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["した"],["所","ところ"],["。"],["／"],["そこ"],["は"],["あなた"],["を"],["産んだ","うんだ"],["者","もの"],["が"],["／"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["した"],["所","ところ"],["。"]]},{"verse":6,"text":"私を封印のようにあなたの心臓の上に、封印のようにあなたの腕につけてください。／愛は死のように強く、ねたみはよみのように激しいからです。／その炎は火の炎、すさまじい炎です。","tok":[["私","わたくし"],["を"],["封印","ふういん"],["の"],["よう"],["に"],["あなた"],["の"],["心臓","しんぞう"],["の"],["上","うえ"],["に"],["、"],["封印","ふういん"],["の"],["よう"],["に"],["あなた"],["の"],["腕","うで"],["に"],["つけて"],["ください"],["。"],["／"],["愛","あい"],["は"],["死","し"],["の"],["よう"],["に"],["強く","つよく"],["、"],["ねたみ"],["は"],["よみ"],["の"],["よう"],["に"],["激しい","はげしい"],["から"],["です"],["。"],["／"],["その"],["炎","ほのお"],["は"],["火","ひ"],["の"],["炎","ほのお"],["、"],["すさまじい"],["炎","ほのお"],["です"],["。"]]},{"verse":7,"text":"大水もその愛を消すことができません。／洪水も押し流すことができません。／もし、人が愛を得ようとして、自分の財産をことごとく与えても、ただのさげすみしか得られません。","tok":[["大水","おおみず"],["も"],["その"],["愛","あい"],["を"],["消す","けす"],["こと"],["が"],["できません"],["。"],["／"],["洪水","こうずい"],["も"],["押し流す","おしながす"],["こと"],["が"],["できません"],["。"],["／"],["もし"],["、"],["人","ひと"],["が"],["愛","あい"],["を"],["得よう","えよう"],["として"],["、"],["自分","じぶん"],["の"],["財産","ざいさん"],["を"],["ことごとく"],["与えて","あたえて"],["も"],["、"],["ただ"],["の"],["さげすみ"],["しか"],["得られません","えられません"],["。"]]},{"verse":8,"text":"私たちの妹は若く、乳房もない。／私たちの妹に縁談のある日には、彼女のために何をしてあげよう。","tok":[["私たち","わたしたち"],["の"],["妹","いもうと"],["は"],["若く","わかく"],["、"],["乳房","ちぶさ"],["も"],["ない"],["。"],["／"],["私たち","わたしたち"],["の"],["妹","いもうと"],["に"],["縁談","えんだん"],["の"],["ある"],["日","ひ"],["に"],["は"],["、"],["彼女","かのじょ"],["の"],["ため"],["に"],["何","なん"],["を"],["して"],["あげよう"],["。"]]},{"verse":9,"text":"もし、彼女が城壁だったら、その上に銀の胸壁を建てよう。／彼女が戸であったら、杉の板で囲もう。","tok":[["もし"],["、"],["彼女","かのじょ"],["が"],["城壁","じょうへき"],["だったら"],["、"],["その"],["上","うえ"],["に"],["銀","ぎん"],["の"],["胸壁","きょうへき"],["を"],["建てよう","たてよう"],["。"],["／"],["彼女","かのじょ"],["が"],["戸","と"],["で"],["あったら"],["、"],["杉","すぎ"],["の"],["板","いた"],["で"],["囲もう","かこもう"],["。"]]},{"verse":10,"text":"私は城壁、私の乳房はやぐらのよう。／それで、私はあの方の目には／平安をもたらす者のようになりました。","tok":[["私","わたくし"],["は"],["城壁","じょうへき"],["、"],["私","わたくし"],["の"],["乳房","ちぶさ"],["は"],["やぐら"],["の"],["よう"],["。"],["／"],["それ"],["で"],["、"],["私","わたくし"],["は"],["あの"],["方","かた"],["の"],["目","め"],["に"],["は"],["／"],["平安","へいあん"],["を"],["もたらす"],["者","もの"],["の"],["よう"],["に"],["なりました"],["。"]]},{"verse":11,"text":"ソロモンにはバアル・ハモンにぶどう畑があった。／彼はぶどう畑を、守る者に任せ、おのおのその収穫によって／銀千枚を納めることになっていた。","tok":[["ソロモン"],["に"],["は"],["バアル"],["・"],["ハモン"],["に"],["ぶどう"],["畑","はたけ"],["が"],["あった"],["。"],["／"],["彼","かれ"],["は"],["ぶどう"],["畑","はたけ"],["を"],["、"],["守る","まもる"],["者","もの"],["に"],["任せ","まかせ"],["、"],["おのおの"],["その"],["収穫","しゅうかく"],["によって"],["／"],["銀","ぎん"],["千枚","せんまい"],["を"],["納める","おさめる"],["こと"],["に"],["なって"],["いた"],["。"]]},{"verse":12,"text":"私が持っているぶどう畑が私の前にある。／ソロモンよ。あなたには銀千枚、その実を守る者には銀二百枚。","tok":[["私","わたくし"],["が"],["持って","もって"],["いる"],["ぶどう"],["畑","はたけ"],["が"],["私","わたくし"],["の"],["前","まえ"],["に"],["ある"],["。"],["／"],["ソロモン"],["よ"],["。"],["あなた"],["に"],["は"],["銀","ぎん"],["千枚","せんまい"],["、"],["その"],["実","じつ"],["を"],["守る","まもる"],["者","もの"],["に"],["は"],["銀","ぎん"],["二百枚","にひゃくまい"],["。"]]},{"verse":13,"text":"庭の中に住む仲間たちは、あなたの声に耳を傾けている。／私にそれを聞かせよ。","tok":[["庭","にわ"],["の"],["中","なか"],["に"],["住む","すむ"],["仲間","なかま"],["たち"],["は"],["、"],["あなた"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["いる"],["。"],["／"],["私","わたくし"],["に"],["それ"],["を"],["聞かせ","きかせ"],["よ"],["。"]]},{"verse":14,"text":"私の愛する方よ。急いでください。／香料の山々の上のかもしかや、若い鹿のようになってください。","tok":[["私","わたくし"],["の"],["愛する","あいする"],["方","ほう"],["よ"],["。"],["急いで","いそいで"],["ください"],["。"],["／"],["香料","こうりょう"],["の"],["山々","やまやま"],["の"],["上","うえ"],["の"],["かもしか"],["や"],["、"],["若い","わかい"],["鹿","しか"],["の"],["よう"],["に"],["なって"],["ください"],["。"]]}]
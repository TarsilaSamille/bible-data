[{"verse":1,"text":"高貴な人の娘よ。／サンダルの中のあなたの足はなんと美しいことよ。／あなたの丸みを帯びたももは、名人の手で作られた飾りのようだ。","tok":[["高貴","こうき"],["な"],["人","ひと"],["の"],["娘","むすめ"],["よ"],["。"],["／"],["サンダル"],["の"],["中","なか"],["の"],["あなた"],["の"],["足","あし"],["は"],["なん"],["と"],["美しい","うつくしい"],["こと"],["よ"],["。"],["／"],["あなた"],["の"],["丸み","まるみ"],["を"],["帯びた","おびた"],["もも"],["は"],["、"],["名人","めいじん"],["の"],["手","て"],["で"],["作られた","つくられた"],["飾り","かざり"],["の"],["よう"],["だ"],["。"]]},{"verse":2,"text":"あなたのほぞは、混ぜ合わせたぶどう酒の／尽きることのない丸い杯。／あなたの腹は、ゆりの花で囲まれた小麦の山。","tok":[["あなた"],["の"],["ほぞ"],["は"],["、"],["混ぜ合わせた","まぜあわせた"],["ぶどう酒","ぶどうしゅ"],["の"],["／"],["尽きる","つきる"],["こと"],["の"],["ない"],["丸い","まるい"],["杯","さかずき"],["。"],["／"],["あなた"],["の"],["腹","はら"],["は"],["、"],["ゆり"],["の"],["花","はな"],["で"],["囲まれた","かこまれた"],["小麦","こむぎ"],["の"],["山","やま"],["。"]]},{"verse":3,"text":"あなたの二つの乳房は、ふたごのかもしか、二頭の子鹿。","tok":[["あなた"],["の"],["二","ふた"],["つ"],["の"],["乳房","ちぶさ"],["は"],["、"],["ふたご"],["の"],["かもしか"],["、"],["二頭","にとう"],["の"],["子鹿","こじか"],["。"]]},{"verse":4,"text":"あなたの首は、象牙のやぐらのようだ。／あなたの目は、バテ・ラビムの門のほとり、ヘシュボンの池。／あなたの鼻は、ダマスコのほうを見張っている／レバノンのやぐらのようだ。","tok":[["あなた"],["の"],["首","くび"],["は"],["、"],["象牙","ぞうげ"],["の"],["やぐら"],["の"],["よう"],["だ"],["。"],["／"],["あなた"],["の"],["目","め"],["は"],["、"],["バテ"],["・"],["ラビム"],["の"],["門","もん"],["の"],["ほとり"],["、"],["ヘシュボン"],["の"],["池","いけ"],["。"],["／"],["あなた"],["の"],["鼻","はな"],["は"],["、"],["ダマスコ"],["の"],["ほう"],["を"],["見張って","みはって"],["いる"],["／"],["レバノン"],["の"],["やぐら"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"あなたの頭はカルメル山のようにそびえ、あなたの乱れた髪は紫色。／王はそのふさふさした髪のとりこになった。","tok":[["あなた"],["の"],["頭","あたま"],["は"],["カルメル"],["山","さん"],["の"],["よう"],["に"],["そびえ"],["、"],["あなた"],["の"],["乱れた","みだれた"],["髪","かみ"],["は"],["紫色","むらさきいろ"],["。"],["／"],["王","おう"],["は"],["その"],["ふさふさ"],["した"],["髪","かみ"],["の"],["とりこ"],["に"],["なった"],["。"]]},{"verse":6,"text":"ああ、慰めに満ちた愛よ。／あなたはなんと美しく、快いことよ。","tok":[["ああ"],["、"],["慰め","なぐさめ"],["に"],["満ちた","みちた"],["愛","あい"],["よ"],["。"],["／"],["あなた"],["は"],["なん"],["と"],["美しく","うつくしく"],["、"],["快い","こころよい"],["こと"],["よ"],["。"]]},{"verse":7,"text":"あなたの背たけはなつめやしの木のよう、あなたの乳房はぶどうのふさのようだ。","tok":[["あなた"],["の"],["背たけ","せたけ"],["は"],["なつめやし"],["の"],["木","き"],["の"],["よう"],["、"],["あなた"],["の"],["乳房","ちぶさ"],["は"],["ぶどう"],["の"],["ふさ"],["の"],["よう"],["だ"],["。"]]},{"verse":8,"text":"私は言った。／「なつめやしの木に登り、その枝をつかみたい。／あなたの乳房はぶどうのふさのように、あなたの息はりんごのかおりのようであれ。","tok":[["私","わたくし"],["は"],["言った","いった"],["。"],["／"],["「"],["なつめやし"],["の"],["木","き"],["に"],["登り","のぼり"],["、"],["その"],["枝","えだ"],["を"],["つかみたい"],["。"],["／"],["あなた"],["の"],["乳房","ちぶさ"],["は"],["ぶどう"],["の"],["ふさ"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["息","いき"],["は"],["りんご"],["の"],["かおり"],["の"],["よう"],["で"],["あれ"],["。"]]},{"verse":9,"text":"あなたのことばは、良いぶどう酒のようだ。／私の愛に対して、なめらかに流れる。／眠っている者のくちびるを流れる。」","tok":[["あなた"],["の"],["ことば"],["は"],["、"],["良い","よい"],["ぶどう酒","ぶどうしゅ"],["の"],["よう"],["だ"],["。"],["／"],["私","わたくし"],["の"],["愛","あい"],["に対して","にたいして"],["、"],["なめらか"],["に"],["流れる","ながれる"],["。"],["／"],["眠って","ねむって"],["いる"],["者","もの"],["の"],["くちびる"],["を"],["流れる","ながれる"],["。"],["」"]]},{"verse":10,"text":"私は、私の愛する方のもの。／あの方は私を恋い慕う。","tok":[["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["愛する","あいする"],["方","ほう"],["の"],["もの"],["。"],["／"],["あの"],["方","かた"],["は"],["私","わたくし"],["を"],["恋い慕う","こいしたう"],["。"]]},{"verse":11,"text":"さあ、私の愛する方よ。野に出て行って、ヘンナ樹の花の中で夜を過ごしましょう。","tok":[["さあ"],["、"],["私","わたくし"],["の"],["愛する","あいする"],["方","ほう"],["よ"],["。"],["野","の"],["に"],["出て","でて"],["行って","いって"],["、"],["ヘンナ樹","へんなじゅ"],["の"],["花","はな"],["の"],["中","なか"],["で"],["夜","よる"],["を"],["過ごしましょう","すごしましょう"],["。"]]},{"verse":12,"text":"私たちは朝早くからぶどう畑に行き、ぶどうの木が芽を出したか、花が咲いたか、ざくろの花が咲いたかどうかを見て、そこで私の愛をあなたにささげましょう。","tok":[["私たち","わたしたち"],["は"],["朝","あさ"],["早く","はやく"],["から"],["ぶどう"],["畑","はたけ"],["に"],["行き","いき"],["、"],["ぶどう"],["の"],["木","き"],["が"],["芽","め"],["を"],["出した","だした"],["か"],["、"],["花","はな"],["が"],["咲いた","さいた"],["か"],["、"],["ざくろ"],["の"],["花","はな"],["が"],["咲いた","さいた"],["か"],["どう"],["か"],["を"],["見て","みて"],["、"],["そこ"],["で"],["私","わたくし"],["の"],["愛","あい"],["を"],["あなた"],["に"],["ささげましょう"],["。"]]},{"verse":13,"text":"恋なすびは、かおりを放ち、私たちの門のそばには、新しいのも、古いのも、すべて、最上の物があります。／私の愛する方よ。／これはあなたのためにたくわえたものです。","tok":[["恋","こい"],["なすび"],["は"],["、"],["かおり"],["を"],["放ち","はなち"],["、"],["私たち","わたしたち"],["の"],["門","もん"],["の"],["そば"],["に"],["は"],["、"],["新しい","あたらしい"],["の"],["も"],["、"],["古い","ふるい"],["の"],["も"],["、"],["すべて"],["、"],["最上","さいじょう"],["の"],["物","もの"],["が"],["あります"],["。"],["／"],["私","わたくし"],["の"],["愛する","あいする"],["方","ほう"],["よ"],["。"],["／"],["これ"],["は"],["あなた"],["の"],["ため"],["に"],["たくわえた"],["もの"],["です"],["。"]]}]
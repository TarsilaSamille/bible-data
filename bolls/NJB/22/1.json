[{"verse":1,"text":"ソロモンの雅歌","tok":[["ソロモン"],["の"],["雅歌","みやびか"]]},{"verse":2,"text":"あの方が私に／口づけしてくださったらよいのに。／あなたの愛はぶどう酒よりも快く、","tok":[["あの"],["方","ほう"],["が"],["私","わたくし"],["に"],["／"],["口づけ","くちづけ"],["して"],["くださったら"],["よい"],["のに"],["。"],["／"],["あなた"],["の"],["愛","あい"],["は"],["ぶどう酒","ぶどうしゅ"],["より"],["も"],["快く","こころよく"],["、"]]},{"verse":3,"text":"あなたの香油のかおりはかぐわしく、あなたの名はそそがれる香油のよう。／それで、おとめらはあなたを愛しています。","tok":[["あなた"],["の"],["香油","こうゆ"],["の"],["かおり"],["は"],["かぐわしく"],["、"],["あなた"],["の"],["名","な"],["は"],["そそがれる"],["香油","こうゆ"],["の"],["よう"],["。"],["／"],["それ"],["で"],["、"],["おとめ"],["ら"],["は"],["あなた"],["を"],["愛して","あいして"],["います"],["。"]]},{"verse":4,"text":"私を引き寄せてください。／私たちはあなたのあとから急いでまいります。／王は私を奥の間に連れて行かれました。／私たちはあなたによって楽しみ喜び、あなたの愛をぶどう酒にまさってほめたたえ、真心からあなたを愛しています。","tok":[["私","わたくし"],["を"],["引き寄せて","ひきよせて"],["ください"],["。"],["／"],["私たち","わたしたち"],["は"],["あなた"],["の"],["あと"],["から"],["急いで","いそいで"],["まいります"],["。"],["／"],["王","おう"],["は"],["私","わたくし"],["を"],["奥","おく"],["の"],["間","あいだ"],["に"],["連れて","つれて"],["行かれました","いかれました"],["。"],["／"],["私たち","わたしたち"],["は"],["あなた"],["によって"],["楽しみ","たのしみ"],["喜び","よろこび"],["、"],["あなた"],["の"],["愛","あい"],["を"],["ぶどう酒","ぶどうしゅ"],["に"],["まさって"],["ほめたたえ"],["、"],["真心","まごころ"],["から"],["あなた"],["を"],["愛して","あいして"],["います"],["。"]]},{"verse":5,"text":"エルサレムの娘たち。／私はケダルの天幕のように、ソロモンの幕のように、黒いけれども美しい。","tok":[["エルサレム"],["の"],["娘","むすめ"],["たち"],["。"],["／"],["私","わたくし"],["は"],["ケダル"],["の"],["天幕","てんまく"],["の"],["よう"],["に"],["、"],["ソロモン"],["の"],["幕","まく"],["の"],["よう"],["に"],["、"],["黒い","くろい"],["けれど"],["も"],["美しい","うつくしい"],["。"]]},{"verse":6,"text":"私をご覧にならないでください。／私は日に焼けて、黒いのです。／私の母の子らが私に向かっていきりたち、私をぶどう畑の見張りに立てたのです。／しかし、私は自分のぶどう畑は／見張りませんでした。","tok":[["私","わたくし"],["を"],["ご覧","ごらん"],["に"],["ならないで"],["ください"],["。"],["／"],["私","わたくし"],["は"],["日","ひ"],["に"],["焼けて","やけて"],["、"],["黒い","くろい"],["の"],["です"],["。"],["／"],["私","わたくし"],["の"],["母","はは"],["の"],["子","こ"],["ら"],["が"],["私","わたくし"],["に"],["向かって","むかって"],["いきりたち"],["、"],["私","わたくし"],["を"],["ぶどう"],["畑","はたけ"],["の"],["見張り","みはり"],["に"],["立てた","たてた"],["の"],["です"],["。"],["／"],["しかし"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["ぶどう"],["畑","はたけ"],["は"],["／"],["見張りませんでした","みはりませんでした"],["。"]]},{"verse":7,"text":"私の愛している人。どうか教えてください。／どこで羊を飼い、昼の間は、どこでそれを休ませるのですか。／あなたの仲間の群れのかたわらで、私はなぜ、顔おおいをつけた女のようにしていなければ／ならないのでしょう。","tok":[["私","わたくし"],["の"],["愛して","あいして"],["いる"],["人","ひと"],["。"],["どう"],["か"],["教えて","おしえて"],["ください"],["。"],["／"],["どこ"],["で"],["羊","ひつじ"],["を"],["飼い","かい"],["、"],["昼","ひる"],["の"],["間","あいだ"],["は"],["、"],["どこ"],["で"],["それ"],["を"],["休ませる","やすませる"],["の"],["です"],["か"],["。"],["／"],["あなた"],["の"],["仲間","なかま"],["の"],["群れ","むれ"],["の"],["かたわら"],["で"],["、"],["私","わたくし"],["は"],["なぜ"],["、"],["顔","かお"],["おおい"],["を"],["つけた"],["女","おんな"],["の"],["よう"],["に"],["して"],["いなければ"],["／"],["ならない"],["の"],["でしょう"],["。"]]},{"verse":8,"text":"女のなかで最も美しい人よ。／あなたがこれを知らないのなら、羊の群れの足跡について行き、羊飼いの住まいのかたわらで、あなたの子やぎを飼いなさい。","tok":[["女","おんな"],["の"],["なか"],["で"],["最も","もっとも"],["美しい","うつくしい"],["人","ひと"],["よ"],["。"],["／"],["あなた"],["が"],["これ"],["を"],["知らない","しらない"],["の"],["なら"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["足跡","あしあと"],["について"],["行き","いき"],["、"],["羊飼い","ひつじかい"],["の"],["住まい","すまい"],["の"],["かたわら"],["で"],["、"],["あなた"],["の"],["子やぎ","こやぎ"],["を"],["飼い","かい"],["なさい"],["。"]]},{"verse":9,"text":"わが愛する者よ。私はあなたを／パロの戦車の雌馬になぞらえよう。","tok":[["わが"],["愛する","あいする"],["者","もの"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["／"],["パロ"],["の"],["戦車","せんしゃ"],["の"],["雌馬","めすうま"],["に"],["なぞらえよう"],["。"]]},{"verse":10,"text":"あなたの頬には飾り輪がつき、首には宝石をちりばめた／首飾りがつけてあって、美しい。","tok":[["あなた"],["の"],["頬","ほお"],["に"],["は"],["飾り輪","かざりりん"],["が"],["つき"],["、"],["首","くび"],["に"],["は"],["宝石","ほうせき"],["を"],["ちりばめた"],["／"],["首飾り","くびかざり"],["が"],["つけて"],["あって"],["、"],["美しい","うつくしい"],["。"]]},{"verse":11,"text":"私たちは銀をちりばめた金の飾り輪を／あなたのために作ろう。","tok":[["私たち","わたしたち"],["は"],["銀","ぎん"],["を"],["ちりばめた"],["金","かね"],["の"],["飾り輪","かざりりん"],["を"],["／"],["あなた"],["の"],["ため"],["に"],["作ろう","つくろう"],["。"]]},{"verse":12,"text":"王がうたげの座に着いておられる間、私のナルドはかおりを放ちました。","tok":[["王","おう"],["が"
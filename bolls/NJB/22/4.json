[{"verse":1,"text":"ああ、わが愛する者。／あなたはなんと美しいことよ。／なんと美しいことよ。／あなたの目は、顔おおいのうしろで鳩のようだ。／あなたの髪は、ギルアデの山から降りて来る／やぎの群れのよう、","tok":[["ああ"],["、"],["わが"],["愛する","あいする"],["者","もの"],["。"],["／"],["あなた"],["は"],["なん"],["と"],["美しい","うつくしい"],["こと"],["よ"],["。"],["／"],["なん"],["と"],["美しい","うつくしい"],["こと"],["よ"],["。"],["／"],["あなた"],["の"],["目","め"],["は"],["、"],["顔","かお"],["おおい"],["の"],["うしろ"],["で"],["鳩","はと"],["の"],["よう"],["だ"],["。"],["／"],["あなた"],["の"],["髪","かみ"],["は"],["、"],["ギルアデ"],["の"],["山","やま"],["から"],["降りて","おりて"],["来る","くる"],["／"],["やぎ"],["の"],["群れ","むれ"],["の"],["よう"],["、"]]},{"verse":2,"text":"あなたの歯は、洗い場から上って来て／毛を刈られる雌羊の群れのようだ。／それはみな、ふたごを産み、ふたごを産まないものは一頭もいない。","tok":[["あなた"],["の"],["歯","は"],["は"],["、"],["洗い場","あらいば"],["から"],["上って","のぼって"],["来て","きて"],["／"],["毛","け"],["を"],["刈られる","かられる"],["雌羊","めひつじ"],["の"],["群れ","むれ"],["の"],["よう"],["だ"],["。"],["／"],["それ"],["は"],["みな"],["、"],["ふたご"],["を"],["産み","うみ"],["、"],["ふたご"],["を"],["産まない","うまない"],["もの"],["は"],["一頭","いちとう"],["も"],["いない"],["。"]]},{"verse":3,"text":"あなたのくちびるは紅の糸。／あなたの口は愛らしい。／あなたの頬は、顔おおいのうしろにあって、ざくろの片割れのようだ。","tok":[["あなた"],["の"],["くちびる"],["は"],["紅","くれない"],["の"],["糸","いと"],["。"],["／"],["あなた"],["の"],["口","くち"],["は"],["愛らしい","あいらしい"],["。"],["／"],["あなた"],["の"],["頬","ほお"],["は"],["、"],["顔","かお"],["おおい"],["の"],["うしろ"],["に"],["あって"],["、"],["ざくろ"],["の"],["片割れ","かたわれ"],["の"],["よう"],["だ"],["。"]]},{"verse":4,"text":"あなたの首は、兵器庫のために建てられた／ダビデのやぐらのようだ。／その上には千の盾が掛けられていて、みな勇士の丸い小盾だ。","tok":[["あなた"],["の"],["首","くび"],["は"],["、"],["兵器庫","へいきこ"],["の"],["ため"],["に"],["建てられた","たてられた"],["／"],["ダビデ"],["の"],["やぐら"],["の"],["よう"],["だ"],["。"],["／"],["その"],["上","うえ"],["に"],["は"],["千","せん"],["の"],["盾","たて"],["が"],["掛けられて","かけられて"],["いて"],["、"],["みな"],["勇士","ゆうし"],["の"],["丸い","まるい"],["小","こ"],["盾","たて"],["だ"],["。"]]},{"verse":5,"text":"あなたの二つの乳房は、ゆりの花の間で草を食べているふたごのかもしか、二頭の子鹿のようだ。","tok":[["あなた"],["の"],["二","ふた"],["つ"],["の"],["乳房","ちぶさ"],["は"],["、"],["ゆり"],["の"],["花","はな"],["の"],["間","あいだ"],["で"],["草","くさ"],["を"],["食べて","たべて"],["いる"],["ふたご"],["の"],["かもしか"],["、"],["二頭","にとう"],["の"],["子鹿","こじか"],["の"],["よう"],["だ"],["。"]]},{"verse":6,"text":"そよ風が吹き始め、影が消え去るころまでに、私は没薬の山、乳香の丘に行こう。","tok":[["そよ風","そよかぜ"],["が"],["吹き","ふき"],["始め","はじめ"],["、"],["影","かげ"],["が"],["消え去る","きえさる"],["ころ"],["まで"],["に"],["、"],["私","わたくし"],["は"],["没薬","もつやく"],["の"],["山","やま"],["、"],["乳香","にゅうこう"],["の"],["丘","おか"],["に"],["行こう","いこう"],["。"]]},{"verse":7,"text":"わが愛する者よ。あなたのすべては美しく、あなたには何の汚れもない。","tok":[["わが"],["愛する","あいする"],["者","もの"],["よ"],["。"],["あなた"],["の"],["すべて"],["は"],["美しく","うつくしく"],["、"],["あなた"],["に"],["は"],["何","なん"],["の"],["汚れ","よごれ"],["も"],["ない"],["。"]]},{"verse":8,"text":"花嫁よ。私といっしょにレバノンから、私といっしょにレバノンから来なさい。／アマナの頂から、セニル、すなわちヘルモンの頂から、獅子のほら穴、ひょうの山から降りて来なさい。","tok":[["花嫁","はなよめ"],["よ"],["。"],["私","わたくし"],["と"],["いっしょ"],["に"],["レバノン"],["から"],["、"],["私","わたくし"],["と"],["いっしょ"],["に"],["レバノン"],["から"],["来","き"],["なさい"],["。"],["／"],["アマナ"],["の"],["頂","いただき"],["から"],["、"],["セニル"],["、"],["すなわち"],["ヘルモン"],["の"],["頂","いただき"],["から"],["、"],["獅子","しし"],["の"],["ほら穴","ほらあな"],["、"],["ひょう"],["の"],["山","やま"],["から"],["降りて","おりて"],["来","き"],["なさい"],["。"]]},{"verse":9,"text":"私の妹、花嫁よ。／あなたは私の心を奪った。／あなたのただ一度のまなざしと、あなたの首飾りのただ一つの宝石で、私の心を奪ってしまった。","tok":[["私","わたくし"],["の"],["妹","いもうと"],["、"],["花嫁","はなよめ"],["よ"],["。"],["／"],["あなた"],["は"],["私","わたくし"],["の"],["心","こころ"],["を"],["奪った","うばった"],["。"],["／"],["あなた"],["の"],["ただ"],["一度","いちど"],["の"],["まなざし"],["と"],["、"],["あなた"],["の"],["首飾り","くびかざり"],["の"],["ただ"],["一","ひと"],["つ"],["の"],["宝石","ほうせき"],["で"],["、"],["私","わたくし"],["の"],["心","こころ"],["を"],["奪って","うばって"],["しまった"],["。"]]},{"verse":10,"text":"私の妹、花嫁よ。／あなたの愛は、なんと麗しいことよ。／あなたの愛は、ぶどう酒よりもはるかにまさり、あなたの香油のかおりは、すべての香料にもまさっている。","tok":[["私","わたくし"],["の"],["妹","いもうと"],["、"],["花嫁","はなよめ"],["よ"],["。"],["／"],["あなた"],["の"],["愛","あい"],["は"],["、"],["なん"],["と"],["麗しい","うるわしい"],["こと"],["よ"],["。"],["／"],["あなた"],["の"],["愛","あい"],["は"],["、"],["ぶどう酒","ぶどうしゅ"],["より"],["も"],["はるか"],["に"],["まさり"],["、"],["あなた"],["の"],["香油","こうゆ"],["の"],["かおり"],["は"],["、"],["すべて"],["の"],["香料","こうりょう"],["に"],["も"],["まさって"],["いる"],["。"]]},{"verse":11,"text":"花嫁よ。あなたのくちびるは蜂蜜をしたたらせ、あなたの舌の裏には蜜と乳がある。／あなたの着物のかおりは、レバノンのかおりのようだ。","tok":[["花嫁","はなよめ"],["よ"],["。"],["あなた"],["の"],["くちびる"],["は"],["蜂蜜","はちみつ"],["を"],["したたらせ"],["、"],["あなた"],["の"],["舌","した"],["の"],["裏","うら"],["に"],["は"],["蜜","みつ"],["と"],["乳","ちち"],["が"],["ある"],["。"],["／"],["あなた"],["の"],["着物","きもの"],["の"],["かおり"],["は"],["、"],["レバノン"],["の"],["かおり"],["の"],["よう"],["だ"],["。"]]},{"verse":12,"text":"私の妹、花嫁は、閉じられた庭、閉じられた源、封じられた泉。","tok":[["私","わたくし"],["の"],["妹","いもうと"],["、"],["花嫁","はなよめ"],["は"],["、"],["閉じられた","とじられた"],["庭","にわ"],["、"],["閉じられた","とじられた"],["源","みなもと"],["、"],["封じられた","ふうじられた"],["泉","いずみ"],["。"]]},{"verse":13,"text":"あなたの産み出すものは、最上の実をみのらすざくろの園、ヘンナ樹にナルド、","tok":[["あなた"],["の"],["産み出す","うみだす"],["もの"],["は"],["、"],["最上","さいじょう"],["の"],["実","じつ"],["を"],["みのらす"],["ざくろ"],["の"],["園","その"],["、"],["ヘンナ樹","へんなじゅ"],["に"],["ナルド"],["、"]]},{"verse":14,"text":"ナルド、サフラン、菖蒲、肉桂に、乳香の取れるすべての木、没薬、アロエに、香料の最上のものすべて、","tok":[["ナルド"],["、"],["サフラン"],["、"],["菖蒲","しょうぶ"],["、"],["肉桂","にっき"],["に"],["、"],["乳香","にゅうこう"],["の"],["取れる","とれる"],["すべて"],["の"],["木","き"],["、"],["没薬","もつやく"],["、"],["アロエ"],["に"],["、"],["香料","こうりょう"],["の"],["最上","さいじょう"],["の"],["もの"],["すべて"],["、"]]},{"verse":15,"text":"庭の泉、湧き水の井戸、レバノンからの流れ。","tok":[["庭","にわ"],["の"],["泉","いずみ"],["、"],["湧き水","わきみず"],["の"],["井戸","いど"],["、"],["レバノン"],["から"],["の"],["流れ","ながれ"],["。"]]},{"verse":16,"text":"北風よ、起きよ。南風よ、吹け。／私の庭に吹き、そのかおりを漂わせておくれ。／私の愛する方が庭に入り、その最上の実を食べることができるように。","tok":[["北風","きたかぜ"],["よ"],["、"],["起き","おき"],["よ"],["。"],["南風","はえ"],["よ"],["、"],["吹け","ふけ"],["。"],["／"],["私","わたくし"],["の"],["庭","にわ"],["に"],["吹き","ふき"],["、"],["その"],["かおり"],["を"],["漂わせて","ただよわせて"],["おくれ"],["。"],["／"],["私","わたくし"],["の"],["愛する","あいする"],["方","ほう"],["が"],["庭","にわ"],["に"],["入り","はいり"],["、"],["その"],["最上","さいじょう"],["の"],["実","じつ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["よう"],["に"],["。"]]}]
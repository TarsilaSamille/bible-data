[{"verse":1,"text":"（指揮者のために。ダビデの賛歌。ダビデがバテ・シェバのもとに通ったのちに、預言者ナタンが彼のもとに来たとき）神よ。御恵みによって、私に情けをかけ、あなたの豊かなあわれみによって、私のそむきの罪をぬぐい去ってください。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["。"],["ダビデ"],["が"],["バテ"],["・"],["シェバ"],["の"],["もと"],["に"],["通った","かよった"],["のち"],["に"],["、"],["預言者","よげんしゃ"],["ナタン"],["が"],["彼","かれ"],["の"],["もと"],["に"],["来た","きた"],["とき"],["）"],["神","かみ"],["よ"],["。"],["御恵み","おめぐみ"],["によって"],["、"],["私","わたくし"],["に"],["情け","なさけ"],["を"],["かけ"],["、"],["あなた"],["の"],["豊か","ゆたか"],["な"],["あわれみ"],["によって"],["、"],["私","わたくし"],["の"],["そむき"],["の"],["罪","つみ"],["を"],["ぬぐい去って","ぬぐいさって"],["ください"],["。"]]},{"verse":2,"text":"どうか私の咎を、私から全く洗い去り、私の罪から、私をきよめてください。","tok":[["どう"],["か"],["私","わたくし"],["の"],["咎","とが"],["を"],["、"],["私","わたくし"],["から"],["全く","まったく"],["洗い去り","あらいさり"],["、"],["私","わたくし"],["の"],["罪","つみ"],["から"],["、"],["私","わたくし"],["を"],["きよめて"],["ください"],["。"]]},{"verse":3,"text":"まことに、私は自分のそむきの罪を知っています。私の罪は、いつも私の目の前にあります。","tok":[["まこと"],["に"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["そむき"],["の"],["罪","つみ"],["を"],["知って","しって"],["います"],["。"],["私","わたくし"],["の"],["罪","つみ"],["は"],["、"],["いつも"],["私","わたくし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あります"],["。"]]},{"verse":4,"text":"私はあなたに、ただあなたに、罪を犯し、あなたの御目に悪であることを行いました。それゆえ、あなたが宣告されるとき、あなたは正しく、さばかれるとき、あなたはきよくあられます。","tok":[["私","わたくし"],["は"],["あなた"],["に"],["、"],["ただ"],["あなた"],["に"],["、"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["あなた"],["の"],["御目","おめ"],["に"],["悪","わる"],["で"],["ある"],["こと"],["を"],["行いました","おこないました"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["が"],["宣告","せんこく"],["される"],["とき"],["、"],["あなた"],["は"],["正しく","ただしく"],["、"],["さばかれる"],["とき"],["、"],["あなた"],["は"],["きよく"],["あられます"],["。"]]},{"verse":5,"text":"ああ、私は咎ある者として生まれ、罪ある者として母は私をみごもりました。","tok":[["ああ"],["、"],["私","わたくし"],["は"],["咎","とが"],["ある"],["者","もの"],["として"],["生まれ","うまれ"],["、"],["罪","つみ"],["ある"],["者","もの"],["として"],["母","はは"],["は"],["私","わたくし"],["を"],["みごもりました"],["。"]]},{"verse":6,"text":"ああ、あなたは心のうちの真実を喜ばれます。それゆえ、私の心の奥に知恵を教えてください。","tok":[["ああ"],["、"],["あなた"],["は"],["心","こころ"],["の"],["うち"],["の"],["真実","しんじつ"],["を"],["喜ばれます","よろこばれます"],["。"],["それ"],["ゆえ"],["、"],["私","わたくし"],["の"],["心","こころ"],["の"],["奥","おく"],["に"],["知恵","ちえ"],["を"],["教えて","おしえて"],["ください"],["。"]]},{"verse":7,"text":"ヒソプをもって私の罪を除いてきよめてください。そうすれば、私はきよくなりましょう。私を洗ってください。そうすれば、私は雪よりも白くなりましょう。","tok":[["ヒソプ"],["を"],["もって"],["私","わたくし"],["の"],["罪","つみ"],["を"],["除いて","のぞいて"],["きよめて"],["ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["は"],["きよく"],["なりましょう"],["。"],["私","わたくし"],["を"],["洗って","あらって"],["ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["は"],["雪","ゆき"],["より"],["も"],["白く","しろく"],["なりましょう"],["。"]]},{"verse":8,"text":"私に、楽しみと喜びを、聞かせてください。そうすれば、あなたがお砕きになった骨が、喜ぶことでしょう。","tok":[["私","わたくし"],["に"],["、"],["楽しみ","たのしみ"],["と"],["喜び","よろこび"],["を"],["、"],["聞かせて","きかせて"],["ください"],["。"],["そう"],["すれば"],["、"],["あなた"],["が"],["お砕き","おくだき"],["に"],["なった"],["骨","ほね"],["が"],["、"],["喜ぶ","よろこぶ"],["こと"],["でしょう"],["。"]]},{"verse":9,"text":"御顔を私の罪から隠し、私の咎をことごとく、ぬぐい去ってください。","tok":[["御顔","おかお"],["を"],["私","わたくし"],["の"],["罪","つみ"],["から"],["隠し","かくし"],["、"],["私","わたくし"],["の"],["咎","とが"],["を"],["ことごとく"],["、"],["ぬぐい去って","ぬぐいさって"],["ください"],["。"]]},{"verse":10,"text":"神よ。私にきよい心を造り、ゆるがない霊を私のうちに新しくしてください。","tok":[["神","かみ"],["よ"],["。"],["私","わたくし"],["に"],["きよい"],["心","こころ"],["を"],["造り","つくり"],["、"],["ゆるがない"],["霊","れい"],["を"],["私","わたくし"],["の"],["うち"],["に"],["新しく","あたらしく"],["して"],["ください"],["。"]]},{"verse":11,"text":"私をあなたの御前から、投げ捨てず、あなたの聖霊を、私から取り去らないでください。","tok":[["私","わたくし"],["を"],["あなた"],["の"],["御前","ごぜん"],["から"],["、"],["投げ捨てず","なげすてず"],["、"],["あなた"],["の"],["聖霊","せいれい"],["を"],["、"],["私","わたくし"],["から"],["取り去らないで","とりさらないで"],["ください"],["。"]]},{"verse":12,"text":"あなたの救いの喜びを、私に返し、喜んで仕える霊が、私をささえますように。","tok":[["あなた"],["の"],["救い","すくい"],["の"],["喜び","よろこび"],["を"],["、"],["私","わたくし"],["に"],["返し","かえし"],["、"],["喜んで","よろこんで"],["仕える","つかえる"],["霊","れい"],["が"],["、"],["私","わたくし"],["を"],["ささえます"],["よう"],["に"],["。"]]},{"verse":13,"text":"私は、そむく者たちに、あなたの道を教えましょう。そうすれば、罪人は、あなたのもとに帰りましょう。","tok":[["私","わたくし"],["は"],["、"],["そむく"],["者","もの"],["たち"],["に"],["、"],["あなた"],["の"],["道","みち"],["を"],["教えましょう","おしえましょう"],["。"],["そう"],["すれば"],["、"],["罪人","ざいにん"],["は"],["、"],["あなた"],["の"],["もと"],["に"],["帰りましょう","かえりましょう"],["。"]]},{"verse":14,"text":"神よ。私の救いの神よ。血の罪から私を救い出してください。そうすれば、私の舌は、あなたの義を、高らかに歌うでしょう。","tok":[["神","かみ"],["よ"],["。"],["私","わたくし"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["。"],["血","ち"],["の"],["罪","つみ"],["から"],["私","わたくし"],["を"],["救い出して","すくいだして"],["ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["の"],["舌","した"],["は"],["、"],["あなた"],["の"],["義","ぎ"],["を"],["、"],["高らか","たからか"],["に"],["歌うでしょう","うたうでしょう"],["。"]]},{"verse":15,"text":"主よ。私のくちびるを開いてください。そうすれば、私の口は、あなたの誉れを告げるでしょう。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["くちびる"],["を"],["開いて","ひらいて"],["ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["の"],["口","くち"],["は"],["、"],["あなた"],["の"],["誉れ","ほまれ"],["を"],["告げるでしょう","つげるでしょう"],["。"]]},{"verse":16,"text":"たとい私がささげても、まことに、あなたはいけにえを喜ばれません。全焼のいけにえを、望まれません。","tok":[["たとい"],["私","わたくし"],["が"],["ささげて"],["も"],["、"],["まこと"],["に"],["、"],["あなた"],["は"],["いけにえ"],["を"],["喜ばれません","よろこばれません"],["。"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["、"],["望まれません","のぞまれません"],["。"]]},{"verse":17,"text":"神へのいけにえは、砕かれた霊。砕かれた、悔いた心。神よ。あなたは、それをさげすまれません。","tok":[["神","かみ"],["へ"],["の"],["いけにえ"],["は"],["、"],["砕かれた","くだかれた"],["霊","れい"],["。"],["砕かれた","くだかれた"],["、"],["悔いた","くいた"],["心","こころ"],["。"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["、"],["それ"],["を"],["さげすまれません"],["。"]]},{"verse":18,"text":"どうか、ご恩寵により、シオンにいつくしみを施し、エルサレムの城壁を築いてください。","tok":[["どう"],["か"],["、"],["ご恩寵","ごおんちょう"],["に"],["より"],["、"],["シオン"],["に"],["いつくしみ"],["を"],["施し","ほどこし"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["築いて","きずいて"],["ください"],["。"]]},{"verse":19,"text":"そのとき、あなたは、全焼のいけにえと全焼のささげ物との、義のいけにえを喜ばれるでしょう。そのとき、雄の子牛があなたの祭壇にささげられましょう。","tok":[["その"],["とき"],["、"],["あなた"],["は"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["全焼","ぜんしょう"],["の"],["ささげ物","ささげもの"],["と"],["の"],["、"],["義","ぎ"],["の"],["いけにえ"],["を"],["喜ばれるでしょう","
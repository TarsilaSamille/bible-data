[{"verse":1,"text":"（都上りの歌。ダビデによる）主よ。私の心は誇らず、私の目は高ぶりません。及びもつかない大きなことや、奇しいことに、私は深入りしません。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["。"],["ダビデ"],["に"],["よる"],["）"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["心","こころ"],["は"],["誇らず","ほこらず"],["、"],["私","わたくし"],["の"],["目","め"],["は"],["高ぶりません","たかぶりません"],["。"],["及び","および"],["も"],["つかない"],["大きな","おおきな"],["こと"],["や"],["、"],["奇しい","くすしい"],["こと"],["に"],["、"],["私","わたくし"],["は"],["深入り","ふかいり"],["しません"],["。"]]},{"verse":2,"text":"まことに私は、自分のたましいを和らげ、静めました。乳離れした子が母親の前にいるように、私のたましいは乳離れした子のように私の前におります。","tok":[["まこと"],["に"],["私","わたくし"],["は"],["、"],["自分","じぶん"],["の"],["たましい"],["を"],["和らげ","やわらげ"],["、"],["静めました","しずめました"],["。"],["乳離れ","ちばなれ"],["した"],["子","こ"],["が"],["母親","ははおや"],["の"],["前","まえ"],["に"],["いる"],["よう"],["に"],["、"],["私","わたくし"],["の"],["たましい"],["は"],["乳離れ","ちばなれ"],["した"],["子","こ"],["の"],["よう"],["に"],["私","わたくし"],["の"],["前","まえ"],["に"],["おります"],["。"]]},{"verse":3,"text":"イスラエルよ。今よりとこしえまで主を待て。","tok":[["イスラエル"],["よ"],["。"],["今","いま"],["より"],["とこしえ"],["まで"],["主","ぬし"],["を"],["待て","まて"],["。"]]}]
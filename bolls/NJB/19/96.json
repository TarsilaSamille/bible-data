[{"verse":1,"text":"新しい歌を主に歌え。全地よ。主に歌え。","tok":[["新しい","あたらしい"],["歌","うた"],["を"],["主に","おもに"],["歌え","うたえ"],["。"],["全地","ぜんち"],["よ"],["。"],["主に","おもに"],["歌え","うたえ"],["。"]]},{"verse":2,"text":"主に歌え。御名をほめたたえよ。日から日へと、御救いの良い知らせを告げよ。","tok":[["主に","おもに"],["歌え","うたえ"],["。"],["御名","ぎょめい"],["を"],["ほめたたえ"],["よ"],["。"],["日","ひ"],["から"],["日","ひ"],["へ"],["と"],["、"],["御救い","おすくい"],["の"],["良い","よい"],["知らせ","しらせ"],["を"],["告げ","つげ"],["よ"],["。"]]},{"verse":3,"text":"主の栄光を国々の中で語り告げよ。その奇しいわざを、すべての国々の民の中で。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["を"],["国々","くにぐに"],["の"],["中","なか"],["で"],["語り告げ","かたりつげ"],["よ"],["。"],["その"],["奇しい","くすしい"],["わざ"],["を"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["。"]]},{"verse":4,"text":"まことに主は大いなる方、大いに賛美されるべき方。すべての神々にまさって恐れられる方だ。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["大いなる","おおいなる"],["方","かた"],["、"],["大いに","おおいに"],["賛美","さんび"],["されるべき"],["方","かた"],["。"],["すべて"],["の"],["神々","かみがみ"],["に"],["まさって"],["恐れられる","おそれられる"],["方","かた"],["だ"],["。"]]},{"verse":5,"text":"まことに、国々の民の神々はみな、むなしい。しかし主は天をお造りになった。","tok":[["まこと"],["に"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["神々","かみがみ"],["は"],["みな"],["、"],["むなしい"],["。"],["しかし"],["主","ぬし"],["は"],["天","てん"],["を"],["お造り","おつくり"],["に"],["なった"],["。"]]},{"verse":6,"text":"尊厳と威光は御前にあり、力と光栄は主の聖所にある。","tok":[["尊厳","そんげん"],["と"],["威光","いこう"],["は"],["御前","ごぜん"],["に"],["あり"],["、"],["力","ちから"],["と"],["光栄","こうえい"],["は"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["に"],["ある"],["。"]]},{"verse":7,"text":"国々の民の諸族よ。主にささげよ。栄光と力を主にささげよ。","tok":[["国々","くにぐに"],["の"],["民","たみ"],["の"],["諸族","しょぞく"],["よ"],["。"],["主に","おもに"],["ささげ"],["よ"],["。"],["栄光","えいこう"],["と"],["力","ちから"],["を"],["主に","おもに"],["ささげ"],["よ"],["。"]]},{"verse":8,"text":"御名の栄光を主にささげよ。ささげ物を携えて、主の大庭に入れ。","tok":[["御名","ぎょめい"],["の"],["栄光","えいこう"],["を"],["主に","おもに"],["ささげ"],["よ"],["。"],["ささげ物","ささげもの"],["を"],["携えて","たずさえて"],["、"],["主","ぬし"],["の"],["大庭","おおば"],["に"],["入れ","いれ"],["。"]]},{"verse":9,"text":"聖なる飾り物を着けて、主にひれ伏せ。全地よ。主の御前に、おののけ。","tok":[["聖","せい"],["なる
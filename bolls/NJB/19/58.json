[{"verse":1,"text":"（指揮者のために。「滅ぼすな」の調べに合わせて。ダビデのミクタム）力ある者よ。ほんとうに、おまえたちは義を語り、人の子らを公正にさばくのか。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["「"],["滅ぼす","ほろぼす"],["な"],["」"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["ミクタム"],["）"],["力","ちから"],["ある"],["者","もの"],["よ"],["。"],["ほんとう"],["に"],["、"],["おまえ"],["たち"],["は"],["義","ぎ"],["を"],["語り","かたり"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["を"],["公正","こうせい"],["に"],["さばく"],["の"],["か"],["。"]]},{"verse":2,"text":"いや、心では不正を働き、地上では、おまえたちの手の暴虐を、はびこらせている。","tok":[["いや"],["、"],["心","こころ"],["で"],["は"],["不正","ふせい"],["を"],["働き","はたらき"],["、"],["地上","ちじょう"],["で"],["は"],["、"],["おまえ"],["たち"],["の"],["手","て"],["の"],["暴虐","ぼうぎゃく"],["を"],["、"],["はびこらせて"],["いる"],["。"]]},{"verse":3,"text":"悪者どもは、母の胎を出たときから、踏み迷い、偽りを言う者どもは生まれたときからさまよっている。","tok":[["悪者","わるもの"],["ども"],["は"],["、"],["母","はは"],["の"],["胎","はら"],["を"],["出た","でた"],["とき"],["から"],["、"],["踏み迷い","ふみまよい"],["、"],["偽り","いつわり"],["を"],["言う","いう"],["者","もの"],["ども"],["は"],["生まれた","うまれた"],["とき"],["から"],["さまよって"],["いる"],["。"]]},{"verse":4,"text":"彼らは蛇の毒のような毒を持ち、耳をふさぐ、耳の聞こえないコブラのよう。","tok":[["彼","かれ"],["ら"],["は"],["蛇","へび"],["の"],["毒","どく"],["の"],["よう"],["な"],["毒","どく"],["を"],["持ち","もち"],["、"],["耳","みみ"],["を"],["ふさぐ"],["、"],["耳","みみ"],["の"],["聞こえない","きこえない"],["コブラ"],["の"],["よう"],["。"]]},{"verse":5,"text":"これは、蛇使いの声も、巧みに呪文を唱える者の声も、聞こうとしない。","tok":[["これ"],["は"],["、"],["蛇使い","へびつかい"],["の"],["声","こえ"],["も"],["、"],["巧み","たくみ"],["に"],["呪文","じゅもん"],["を"],["唱える","となえる"],["者","もの"],["の"],["声","こえ"],["も"],["、"],["聞こう","きこう"],["と"],["しない"],["。"]]},{"verse":6,"text":"神よ。彼らの歯を、その口の中で折ってください。主よ。若獅子のきばを、打ち砕いてください。","tok":[["神","かみ"],["よ"],["。"],["彼","かれ"],["ら"],["の"],["歯","は"],["を"],["、"],["その"],["口","くち"],["の"],["中","なか"],["で"],["折って","おって"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["若","わか"],["獅子","しし"],["の"],["きば"],["を"],["、"],["打ち砕いて","うちくだいて"],["ください"],["。"]]},{"verse":7,"text":"彼らを、流れて行く水のように消え去らせてください。彼が矢を放つときは、それを折れた矢のようにしてください。","tok":[["彼","かれ"],["ら"],["を"],["、"],["流れて","ながれて"],["行く","いく"],["水","みず"],["の"],["よう"],["に"],["消え去らせて","きえさらせて"],["ください"],["。"],["彼","かれ"],["が"],["矢","や"],["を"],["放つ","はなつ"],["とき"],["は"],["、"],["それ"],["を"],["折れた","おれた"],["矢","や"],["の"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":8,"text":"彼らを、溶けて、消えていくかたつむりのように、また、日の目を見ない、死産の子のようにしてください。","tok":[["彼","かれ"],["ら"],["を"],["、"],["溶けて","とけて"],["、"],["消えて","きえて"],["いく"],["かたつむり"],["の"],["よう"],["に"],["、"],["また"],["、"],["日の目","ひのめ"],["を"],["見ない","みない"],["、"],["死産","しざん"],["の"],["子","こ"],["の"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":9,"text":"おまえたちの釜が、いばらの火を感じる前に、神は、生のものも、燃えているものも、ひとしくつむじ風で吹き払われる。","tok":[["おまえ"],["たち"],["の"],["釜","かま"],["が"],["、"],["いばら"],["の"],["火","ひ"],["を"],["感じる","かんじる"],["前","まえ"],["に"],["、"],["神","かみ"],["は"],["、"],["生","なま"],["の"],["もの"],["も"],["、"],["燃えて","もえて"],["いる"],["もの"],["も"],["、"],["ひとしく"],["つむじ風","つむじかぜ"],["で"],["吹き払われる","ふきはらわれる"],["。"]]},{"verse":10,"text":"正しい者は、復讐を見て喜び、その足を、悪者の血で洗おう。","tok":[["正しい","ただしい"],["者","もの"],["は"],["、"],["復讐","ふくしゅう"],["を"],["見て","みて"],["喜び","よろこび"],["、"],["その"],["足","あし"],["を"],["、"],["悪者","わるもの"],["の"],["血","ち"],["で"],["洗おう","あらおう"],["。"]]},{"verse":11,"text":"こうして人々は言おう。「まことに、正しい者には報いがある。まことに、さばく神が、地におられる。」","tok":[["こう"],["して"],["人々","ひとびと"],["は"],["言おう","いおう"],["。"],["「"],["まこと"],["に"],["、"],["正しい","ただしい"],["者","もの"],["に"],["は"],["報い","むくい"],["が"],["ある"],["。"],["まこと"],["に"],["、"],["さばく"],["神","かみ"],["が"],["、"],["地","ち"],["に"],["おられる"],["。"],["」"]]}]
[{"verse":1,"text":"私たちにではなく、主よ、私たちにではなく、あなたの恵みとまことのために、栄光を、ただあなたの御名にのみ帰してください。","tok":[["私たち","わたしたち"],["に"],["で"],["は"],["なく"],["、"],["主","ぬし"],["よ"],["、"],["私たち","わたしたち"],["に"],["で"],["は"],["なく"],["、"],["あなた"],["の"],["恵み","めぐみ"],["と"],["まこと"],["の"],["ため"],["に"],["、"],["栄光","えいこう"],["を"],["、"],["ただ"],["あなた"],["の"],["御名","ぎょめい"],["に"],["のみ"],["帰して","かえして"],["ください"],["。"]]},{"verse":2,"text":"なぜ、国々は言うのか。「彼らの神は、いったいどこにいるのか」と。","tok":[["なぜ"],["、"],["国々","くにぐに"],["は"],["言う","いう"],["の"],["か"],["。"],["「"],["彼","かれ"],["ら"],["の"],["神","かみ"],["は"],["、"],["いったい"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["。"]]},{"verse":3,"text":"私たちの神は、天におられ、その望むところをことごとく行われる。","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["は"],["、"],["天","てん"],["に"],["おられ"],["、"],["その"],["望む","のぞむ"],["ところ"],["を"],["ことごとく"],["行われる","おこなわれる"],["。"]]},{"verse":4,"text":"彼らの偶像は銀や金で、人の手のわざである。","tok":[["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["は"],["銀","ぎん"],["や"],["金","かね"],["で"],["、"],["人","ひと"],["の"],["手","て"],["の"],["わざ"],["で"],["ある"],["。"]]},{"verse":5,"text":"口があっても語れず、目があっても見えない。","tok":[["口","くち"],["が"],["あって"],["も"],["語れず","かたれず"],["、"],["目","め"],["が"],["あって"],["も"],["見えない","みえない"],["。"]]},{"verse":6,"text":"耳があっても聞こえず、鼻があってもかげない。","tok":[["耳","みみ"],["が"],["あって"],["も"],["聞こえず","きこえず"],["、"],["鼻","はな"],["が"],["あって"],["も"],["かげない"],["。"]]},{"verse":7,"text":"手があってもさわれず、足があっても歩けない。のどがあっても声をたてることもできない。","tok":[["手","て"],["が"],["あって"],["も"],["さわれず"],["、"],["足","あし"],["が"],["あって"],["も"],["歩けない","あるけない"],["。"],["のど"],["が"],["あって"],["も"],["声","こえ"],["を"],["たてる"],["こと"],["も"],["できない"],["。"]]},{"verse":8,"text":"これを造る者も、これに信頼する者もみな、これと同じである。","tok":[["これ"],["を"],["造る","つくる"],["者","もの"],["も"],["、"],["これ"],["に"],["信頼","しんらい"],["する"],["者","もの"],["も"],["みな"],["、"],["これ"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":9,"text":"イスラエルよ。主に信頼せよ。この方こそ、彼らの助け、また盾である。","tok":[["イスラエル"],["よ"],["。"],["主に","おもに"],["信頼","しんらい"],["せよ"],["。"],["この"],["方","かた"],["こそ"],["、"],["彼","かれ"],["ら"],["の"],["助け","たすけ"],["、"],["また"],["盾","たて"],["で"],["ある"],["。"]]},{"verse":10,"text":"アロンの家よ。主に信頼せよ。この方こそ、彼らの助け、また盾である。","tok":[["アロン"],["の"],["家","いえ"],["よ"],["。"],["主に","おもに"],["信頼","しんらい"],["せよ"],["。"],["この"],["方","かた"],["こそ"],["、"],["彼","かれ"],["ら"],["の"],["助け","たすけ"],["、"],["また"],["盾","たて"],["で"],["ある"],["。"]]},{"verse":11,"text":"主を恐れる者たちよ。主に信頼せよ。この方こそ、彼らの助け、また盾である。","tok":[["主","ぬし"],["を"],["恐れる","おそれる"],["者","もの"],["たち"],["よ"],["。"],["主に","おもに"],["信頼","しんらい"],["せよ"],["。"],["この"],["方","かた"],["こそ"],["、"],["彼","かれ"],["ら"],["の"],["助け","たすけ"],["、"],["また"],["盾","たて"],["で"],["ある"],["。"]]},{"verse":12,"text":"主はわれらを御心に留められた。主は祝福してくださる。イスラエルの家を祝福し、アロンの家を祝福し、","tok":[["主","ぬし"],["は"],["われ"],["ら"],["を"],["御心","おこころ"],["に"],["留められた","とめられた"],["。"],["主","ぬし"],["は"],["祝福","しゅくふく"],["して"],["くださる"],["。"],["イスラエル"],["の"],["家","いえ"],["を"],["祝福","しゅくふく"],["し"],["、"],["アロン"],["の"],["家","いえ"],["を"],["祝福","しゅくふく"],["し"],["、"]]},{"verse":13,"text":"主を恐れる者を祝福してくださる。小さな者も、大いなる者も。","tok":[["主","ぬし"],["を"],["恐れる","おそれる"],["者","もの"],["を"],["祝福","しゅくふく"],["して"],["くださる"],["。"],["小さな","ちいさな"],["者","もの"],["も"],["、"],["大いなる","おおいなる"],["者","もの"],["も"],["。"]]},{"verse":14,"text":"主があなたがたをふやしてくださるように。あなたがたと、あなたがたの子孫とを。","tok":[["主","ぬし"],["が"],["あなた"],["がた"],["を"],["ふやして"],["くださる"],["よう"],["に"],["。"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["と"],["を"],["。"]]},{"verse":15,"text":"あなたがたが主によって祝福されるように。主は、天と地を造られた方である。","tok":[["あなた"],["がた"],["が"],["主に","おもに"],["よって"],["祝福","しゅくふく"],["される"],["よう"],["に"],["。"],["主","ぬし"],["は"],["、"],["天","てん"],["と"],["地","ち"],["を"],["造られた","つくられた"],["方","ほう"],["で"],["ある"],["。"]]},{"verse":16,"text":"天は、主の天である。しかし、地は、人の子らに与えられた。","tok":[["天","てん"],["は"],["、"],["主","ぬし"],["の"],["天","てん"],["で"],["ある"],["。"],["しかし"],["、"],["地","ち"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["与えられた","あたえられた"],["。"]]},{"verse":17,"text":"死人は主をほめたたえることがない。沈黙へ下る者もそうだ。","tok":[["死人","しにん"],["は"],["主","ぬし"],["を"],["ほめたたえる"],["こと"],["が"],["ない"],["。"],["沈黙","ちんもく"],["へ"],["下る","くだる"],["者","もの"],["も"],["そう"],["だ"],["。"]]},{"verse":18,"text":"しかし、私たちは、今よりとこしえまで、主をほめたたえよう。ハレルヤ。","tok":[["しかし"],["、"],["私たち","わたしたち"],["は"],["、"],["今","いま"],["より"],["とこしえ"],["まで"],["、"],["主","ぬし"],["を"],["ほめたたえよう"],["。"],["ハレルヤ"],["。"]]}]
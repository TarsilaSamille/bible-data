[{"verse":1,"text":"（指揮者のために。八弦の立琴に合わせて。ダビデの賛歌）主よ。お救いください。聖徒はあとを絶ち、誠実な人は人の子らの中から消え去りました。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["八","はち"],["弦","げん"],["の"],["立琴","たてごと"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["お救い","おすくい"],["ください"],["。"],["聖徒","せいと"],["は"],["あと"],["を"],["絶ち","たち"],["、"],["誠実","せいじつ"],["な"],["人","ひと"],["は"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["から"],["消え去りました","きえさりました"],["。"]]},{"verse":2,"text":"人は互いにうそを話し、へつらいのくちびると、二心で話します。","tok":[["人","ひと"],["は"],["互い","たがい"],["に"],["うそ"],["を"],["話し","はなし"],["、"],["へつらい"],["の"],["くちびる"],["と"],["、"],["二心","にしん"],["で"],["話します","はなします"],["。"]]},{"verse":3,"text":"主が、へつらいのくちびると傲慢の舌とを、ことごとく断ち切ってくださいますように。","tok":[["主","ぬし"],["が"],["、"],["へつらい"],["の"],["くちびる"],["と"],["傲慢","ごうまん"],["の"],["舌","した"],["と"],["を"],["、"],["ことごとく"],["断ち切って","たちきって"],["くださいます"],["よう"],["に"],["。"]]},{"verse":4,"text":"彼らはこう言うのです。「われらはこの舌で勝つことができる。われらのくちびるはわれらのものだ。だれが、われらの支配者なのか。」","tok":[["彼","かれ"],["ら"],["は"],["こう"],["言う","いう"],["の"],["です"],["。"],["「"],["われ"],["ら"],["は"],["この"],["舌","した"],["で"],["勝つ","かつ"],["こと"],["が"],["できる"],["。"],["われ"],["ら"],["の"],["くちびる"],["は"],["われ"],["ら"],["の"],["もの"],["だ"],["。"],["だれ"],["が"],["、"],["われ"],["ら"],["の"],["支配者","しはいしゃ"],["な"],["の"],["か"],["。"],["」"]]},{"verse":5,"text":"主は仰せられる。「悩む人が踏みにじられ、貧しい人が嘆くから、今、わたしは立ち上がる。わたしは彼を、その求める救いに入れよう。」","tok":[["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["「"],["悩む","なやむ"],["人","ひと"],["が"],["踏みにじられ","ふみにじられ"],["、"],["貧しい","まずしい"],["人","ひと"],["が"],["嘆く","なげく"],["から"],["、"],["今","いま"],["、"],["わたし"],["は"],["立ち上がる","たちあがる"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["、"],["その"],["求める","もとめる"],["救い","すくい"],["に"],["入れよう","いれよう"],["。"],["」"]]},{"verse":6,"text":"主のみことばは混じりけのないことば。土の炉で七回もためされて、純化された銀。","tok":[["主","ぬし"],["のみ"],["ことば"],["は"],["混じりけ","まじりけ"],["の"],["ない"],["ことば"],["。"],["土","つち"],["の"],["炉","ろ"],["で"],["七","なな"],["回","かい"],["も"],["ためされて"],["、"],["純化","じゅんか"],["された"],["銀","ぎん"],["。"]]},{"verse":7,"text":"あなたが、主よ、彼らをお守りになります。あなたはこの時代からとこしえまでも彼らを保たれます。","tok":[["あなた"],["が"],["、"],["主","ぬし"],["よ"],["、"],["彼","かれ"],["ら"],["を"],["お守り","おまもり"],["に"],["なります"],["。"],["あなた"],["は"],["この"],["時代","じだい"],["から"],["とこしえ"],["まで"],["も"],["彼","かれ"],["ら"],["を"],["保たれます","たもたれます"],["。"]]},{"verse":8,"text":"人の子の間で、卑しいことがあがめられているときには、悪者が、至る所で横行します。","tok":[["人","ひと"],["の"],["子","こ"],["の"],["間","あいだ"],["で"],["、"],["卑しい","いやしい"],["こと"],["が"],["あがめられて"],["いる"],["とき"],["に"],["は"],["、"],["悪者","わるもの"],["が"],["、"],["至る所","いたるところ"],["で"],["横行","おうこう"],["します"],["。"]]}]
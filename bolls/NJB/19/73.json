[{"verse":1,"text":"（アサフの賛歌）まことに神は、イスラエルに、心のきよい人たちに、いつくしみ深い。","tok":[["（"],["アサフ"],["の"],["賛歌","さんか"],["）"],["まこと"],["に"],["神","かみ"],["は"],["、"],["イスラエル"],["に"],["、"],["心","こころ"],["の"],["きよい"],["人","ひと"],["たち"],["に"],["、"],["いつくしみ"],["深い","ぶかい"],["。"]]},{"verse":2,"text":"しかし、私自身は、この足がたわみそうで、私の歩みは、すべるばかりだった。","tok":[["しかし"],["、"],["私自身","わたしじしん"],["は"],["、"],["この"],["足","あし"],["が"],["たわみ"],["そう"],["で"],["、"],["私","わたくし"],["の"],["歩み","あゆみ"],["は"],["、"],["すべる"],["ばかり"],["だった"],["。"]]},{"verse":3,"text":"それは、私が誇り高ぶる者をねたみ、悪者の栄えるのを見たからである。","tok":[["それ"],["は"],["、"],["私","わたくし"],["が"],["誇り","ほこり"],["高ぶる","たかぶる"],["者","もの"],["を"],["ねたみ"],["、"],["悪者","わるもの"],["の"],["栄える","さかえる"],["の"],["を"],["見た","みた"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼らの死には、苦痛がなく、彼らのからだは、あぶらぎっているからだ。","tok":[["彼","かれ"],["ら"],["の"],["死","し"],["に"],["は"],["、"],["苦痛","くつう"],["が"],["なく"],["、"],["彼","かれ"],["ら"],["の"],["からだ"],["は"],["、"],["あぶらぎって"],["いる"],["から"],["だ"],["。"]]},{"verse":5,"text":"人々が苦労するとき、彼らはそうではなく、ほかの人のようには打たれない。","tok":[["人々","ひとびと"],["が"],["苦労","くろう"],["する"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["そう"],["で"],["は"],["なく"],["、"],["ほか"],["の"],["人","ひと"],["の"],["よう"],["に"],["は"],["打たれない","うたれない"],["。"]]},{"verse":6,"text":"それゆえ、高慢が彼らの首飾りとなり、暴虐の着物が彼らをおおっている。","tok":[["それ"],["ゆえ"],["、"],["高慢","こうまん"],["が"],["彼","かれ"],["ら"],["の"],["首飾り","くびかざり"],["と"],["なり"],["、"],["暴虐","ぼうぎゃく"],["の"],["着物","きもの"],["が"],["彼","かれ"],["ら"],["を"],["おおって"],["いる"],["。"]]},{"verse":7,"text":"彼らの目は脂肪でふくらみ、心の思いはあふれ出る。","tok":[["彼","かれ"],["ら"],["の"],["目","め"],["は"],["脂肪","しぼう"],["で"],["ふくらみ"],["、"],["心","こころ"],["の"],["思い","おもい"],["は"],["あふれ出る","あふれでる"],["。"]]},{"verse":8,"text":"彼らはあざけり、悪意をもって語り、高い所からしいたげを告げる。","tok":[["彼","かれ"],["ら"],["は"],["あざけり"],["、"],["悪意","あくい"],["を"],["もって"],["語り","かたり"],["、"],["高い","たかい"],["所","ところ"],["から"],["しいたげ"],["を"],["告げる","つげる"],["。"]]},{"verse":9,"text":"彼らはその口を天にすえ、その舌は地を行き巡る。","tok":[["彼","かれ"],["ら"],["は"],["その"],["口","くち"],["を"],["天","てん"],["に"],["すえ"],["、"],["その"],["舌","した"],["
[{"verse":1,"text":"（指揮者のために。ダビデの賛歌）苦難の日に主があなたにお答えになりますように。ヤコブの神の名が、あなたを高く上げますように。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["苦難","くなん"],["の"],["日","ひ"],["に"],["主","ぬし"],["が"],["あなた"],["に"],["お答え","おこたえ"],["に"],["なります"],["よう"],["に"],["。"],["ヤコブ"],["の"],["神","かみ"],["の"],["名","な"],["が"],["、"],["あなた"],["を"],["高く","たかく"],["上げます","あげます"],["よう"],["に"],["。"]]},{"verse":2,"text":"主が聖所から、あなたに助けを送り、シオンから、あなたをささえられますように。","tok":[["主","ぬし"],["が"],["聖","せい"],["所","しょ"],["から"],["、"],["あなた"],["に"],["助け","たすけ"],["を"],["送り","おくり"],["、"],["シオン"],["から"],["、"],["あなた"],["を"],["ささえられます"],["よう"],["に"],["。"]]},{"verse":3,"text":"あなたの穀物のささげ物をすべて心に留め、あなたの全焼のいけにえを受け入れてくださいますように。セラ","tok":[["あなた"],["の"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["すべて"],["心","こころ"],["に"],["留め","とめ"],["、"],["あなた"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["受け入れて","うけいれて"],["くださいます"],["よう"],["に"],["。"],["セラ"]]},{"verse":4,"text":"主があなたの願いどおりにしてくださいますように。あなたのすべてのはかりごとを遂げさせてくださいますように。","tok":[["主","ぬし"],["が"],["あなた"],["の"],["願い","ねがい"],["どおり"],["に"],["して"],["くださいます"],["よう"],["に"],["。"],["あなた"],["の"],["すべて"],["の"],["はかりごと"],["を"],["遂げさせて","とげさせて"],["くださいます"],["よう"],["に"],["。"]]},{"verse":5,"text":"私たちは、あなたの勝利を喜び歌いましょう。私たちの神の御名により旗を高く掲げましょう。主があなたの願いのすべてを遂げさせてくださいますように。","tok":[["私たち","わたしたち"],["は"],["、"],["あなた"],["の"],["勝利","しょうり"],["を"],["喜び歌いましょう","よろこびうたいましょう"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["御名","ぎょめい"],["に"],["より"],["旗","はた"],["を"],["高く","たかく"],["掲げましょう","かかげましょう"],["。"],["主","ぬし"],["が"],["あなた"],["の"],["願い","ねがい"],["の"],["すべて"],["を"],["遂げさせて","とげさせて"],["くださいます"],["よう"],["に"],["。"]]},{"verse":6,"text":"今こそ、私は知る。主は、油をそそがれた者を、お救いになる。主は、右の手の救いの力をもって聖なる天から、お答えになる。","tok":[["今","いま"],["こそ"],["、"],["私","わたくし"],["は"],["知る","しる"],["。"],["主","ぬし"],["は"],["、"],["油","あぶら"],["を"],["そそがれた"],["者","もの"],["を"],["、"],["お救い","おすくい"],["に"],["なる"],["。"],["主","ぬし"],["は"],["、"],["右","みぎ"],["の"],["手","て"],["の"],["救い","すくい"],["の"],["力","ちから"],["を"],["もって"],["聖","せい"],["なる"],["天","てん"],["から"],["、"],["お答え","おこたえ"],["に"],["なる"],["。"]]},{"verse":7,"text":"ある者はいくさ車を誇り、ある者は馬を誇る。しかし、私たちは私たちの神、主の御名を誇ろう。","tok":[["ある"],["者","もの"],["は"],["いくさ車","いくさしゃ"],["を"],["誇り","ほこり"],["、"],["ある"],["者","もの"],["は"],["馬","うま"],["を"],["誇る","ほこる"],["。"],["しかし"],["、"],["私たち","わたしたち"],["は"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["誇ろう","ほころう"],["。"]]},{"verse":8,"text":"彼らは、ひざをつき、そして倒れた。しかし、私たちは、立ち上がり、まっすぐに立った。","tok":[["彼","かれ"],["ら"],["は"],["、"],["ひざ"],["を"],["つき"],["、"],["そして"],["倒れた","たおれた"],["。"],["しかし"],["、"],["私たち","わたしたち"],["は"],["、"],["立ち上がり","たちあがり"],["、"],["まっすぐ"],["に"],["立った","たった"],["。"]]},{"verse":9,"text":"主よ。王をお救いください。私たちが呼ぶときに私たちに答えてください。","tok":[["主","ぬし"],["よ"],["。"],["王","おう"],["を"],["お救い","おすくい"],["ください"],["。"],["私たち","わたしたち"],["が"],["呼ぶ","よぶ"],["とき"],["に"],["私たち","わたしたち"],["に"],["答えて","こたえて"],["ください"],["。"]]}]
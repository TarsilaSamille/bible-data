[{"verse":1,"text":"（記念のためのダビデの賛歌）主よ。あなたの大きな怒りで私を責めないでください。あなたの激しい憤りで私を懲らしめないでください。","tok":[["（"],["記念","きねん"],["の"],["ため"],["の"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["大きな","おおきな"],["怒り","いかり"],["で"],["私","わたくし"],["を"],["責めないで","せめないで"],["ください"],["。"],["あなた"],["の"],["激しい","はげしい"],["憤り","いきどおり"],["で"],["私","わたくし"],["を"],["懲らしめないで","こらしめないで"],["ください"],["。"]]},{"verse":2,"text":"あなたの矢が私の中に突き刺さり、あなたの手が私の上に激しく下って来ました。","tok":[["あなた"],["の"],["矢","や"],["が"],["私","わたくし"],["の"],["中","なか"],["に"],["突き刺さり","つきささり"],["、"],["あなた"],["の"],["手","て"],["が"],["私","わたくし"],["の"],["上","うえ"],["に"],["激しく","はげしく"],["下って","くだって"],["来ました","きました"],["。"]]},{"verse":3,"text":"あなたの憤りのため、私の肉には完全なところがなく、私の罪のため私の骨には健全なところがありません。","tok":[["あなた"],["の"],["憤り","いきどおり"],["の"],["ため"],["、"],["私","わたくし"],["の"],["肉","にく"],["に"],["は"],["完全","かんぜん"],["な"],["ところ"],["が"],["なく"],["、"],["私","わたくし"],["の"],["罪","つみ"],["の"],["ため"],["私","わたくし"],["の"],["骨","ほね"],["に"],["は"],["健全","けんぜん"],["な"],["ところ"],["が"],["ありません"],["。"]]},{"verse":4,"text":"私の咎が、私の頭を越え、重荷のように、私には重すぎるからです。","tok":[["私","わたくし"],["の"],["咎","とが"],["が"],["、"],["私","わたくし"],["の"],["頭","あたま"],["を"],["越え","こえ"],["、"],["重荷","おもに"],["の"],["よう"],["に"],["、"],["私","わたくし"],["に"],["は"],["重","おも"],["すぎる"],["から"],["です"],["。"]]},{"verse":5,"text":"私の傷は、悪臭を放ち、ただれました。それは私の愚かしさのためです。","tok":[["私","わたくし"],["の"],["傷","きず"],["は"],["、"],["悪臭","あくしゅう"],["を"],["放ち","はなち"],["、"],["ただれました"],["。"],["それ"],["は"],["私","わたくし"],["の"],["愚かし","おろかし"],["さ"],["の"],["ため"],["です"],["。"]]},{"verse":6,"text":"私はかがみ、深くうなだれ、一日中、嘆いて歩いています。","tok":[["私","わたくし"],["は"],["かがみ"],["、"],["深く","ふかく"],["うなだれ"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["嘆いて","なげいて"],["歩いて","あるいて"],["います"],["。"]]},{"verse":7,"text":"私の腰はやけどでおおい尽くされ、私の肉には完全なところがありません。","tok":[["私","わたくし"],["の"],["腰","こし"],["は"],["やけど"],["で"],["おおい"],["尽くされ","つくされ"],["、"],["私","わたくし"],["の"],["肉","にく"],["に"],["は"],["完全","かんぜん"],["な"],["ところ"],["が"],["ありません"],["。"]]},{"verse":8,"text":"私はしびれ、砕き尽くされ、心の乱れのためにうめいています。","tok":[["私","わたくし"],["は"],["しびれ"],["、"],["砕き","くだき"],["尽くされ","つくされ"],["、"],["心","こころ"],["の"],["乱れ","みだれ"],["の"],["ため"],["に"],["うめいて"],["います"],["。"]]},{"verse":9,"text":"主よ。私の願いはすべてあなたの御前にあり、私の嘆きはあなたから隠されていません。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["願い","ねがい"],["は"],["すべて"],["あなた"],["の"],["御前","ごぜん"],["に"],["あり"],["、"],["私","わたくし"],["の"],["嘆き","なげき"],["は"],["あなた"],["から"],["隠されて","かくされて"],["いません"],["。"]]},{"verse":10,"text":"私の心はわななきにわななき、私の力は私を見捨て、目の光さえも、私にはなくなりました。","tok":[["私","わたくし"],["の"],["心","こころ"],["は"],["わななき"],["に"],["わななき"],["、"],["私","わたくし"],["の"],["力","ちから"],["は"],["私","わたくし"],["を"],["見捨て","みすて"],["、"],["目","め"],["の"],["光","ひかり"],["さえ"],["も"],["、"],["私","わたくし"],["に"],["は"],["なくなりました"],["。"]]},{"verse":11,"text":"私の愛する者や私の友も、私のえやみを避けて立ち、私の近親の者も遠く離れて立っています。","tok":[["私","わたくし"],["の"],["愛する","あいする"],["者","もの"],["や"],["私","わたくし"],["の"],["友","とも"],["も"],["、"],["私","わたくし"],["の"],["え"],["やみ"],["を"],["避けて","さけて"],["立ち","たち"],["、"],["私","わたくし"],["の"],["近親","きんしん"],["の"],["者","もの"],["も"],["遠く","とおく"],["離れて","はなれて"],["立って","たって"],["います"],["。"]]},{"verse":12,"text":"私のいのちを求める者はわなを仕掛け、私を痛めつけようとする者は私の破滅を告げ、一日中、欺きを語っています。","tok":[["私","わたくし"],["の"],["いのち"],["を"],["求める","もとめる"],["者","もの"],["は"],["わな"],["を"],["仕掛け","しかけ"],["、"],["私","わたくし"],["を"],["痛めつけよう","いためつけよう"],["と"],["する"],["者","もの"],["は"],["私","わたくし"],["の"],["破滅","はめつ"],["を"],["告げ","つげ"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["欺き","あざむき"],["を"],["語って","かたって"],["います"],["。"]]},{"verse":13,"text":"しかし私には聞こえません。私は耳の聞こえない者のよう。口を開かず、話せない者のよう。","tok":[["しかし"],["私","わたくし"],["に"],["は"],["聞こえません","きこえません"],["。"],["私","わたくし"],["は"],["耳","みみ"],["の"],["聞こえない","きこえない"],["者","もの"],["の"],["よう"],["。"],["口","くち"],["を"],["開かず","ひらかず"],["、"],["話せない","はなせない"],["者","もの"],["の"],["よう"],["。"]]},{"verse":14,"text":"まことに私は、耳が聞こえず、口で言い争わない人のようです。","tok":[["まこと"],["に"],["私","わたくし"],["は"],["、"],["耳","みみ"],["が"],["聞こえず","きこえず"],["、"],["口","くち"],["で"],["言い争わない","いいあらそわない"],["人","ひと"],["の"],["よう"],["です"],["。"]]},{"verse":15,"text":"それは、主よ、私があなたを待ち望んでいるからです。わが神、主よ。あなたが答えてくださいますように。","tok":[["それ"],["は"],["、"],["主","ぬし"],["よ"],["、"],["私","わたくし"],["が"],["あなた"],["を"],["待ち望んで","まちのぞんで"],["いる"],["から"],["です"],["。"],["わが"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["が"],["答えて","こたえて"],["くださいます"],["よう"],["に"],["。"]]},{"verse":16,"text":"私は申しました。「私の足がよろけるとき、彼らが私のことで喜ばず、私に対して高ぶらないようにしてください。」","tok":[["私","わたくし"],["は"],["申しました","もうしました"],["。"],["「"],["私","わたくし"],["の"],["足","あし"],["が"],["よろける"],["とき"],["、"],["彼","かれ"],["ら"],["が"],["私","わたくし"],["の"],["こと"],["で"],["喜ばず","よろこばず"],["、"],["私","わたくし"],["に対して","にたいして"],["高ぶらない","たかぶらない"],["よう"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":17,"text":"私はつまずき倒れそうであり、私の痛みはいつも私の前にあります。","tok":[["私","わたくし"],["は"],["つまずき"],["倒れ","たおれ"],["そう"],["で"],["あり"],["、"],["私","わたくし"],["の"],["痛み","いたみ"],["は"],["いつも"],["私","わたくし"],["の"],["前","まえ"],["に"],["あります"],["。"]]},{"verse":18,"text":"私は自分の咎を言い表し、私の罪で私は不安になっています。","tok":[["私","わたくし"],["は"],["自分","じぶん"],["の"],["咎","とが"],["を"],["言い表し","いいあらわし"],["、"],["私","わたくし"],["の"],["罪","つみ"],["で"],["私","わたくし"],["は"],["不安","ふあん"],["に"],["なって"],["います"],["。"]]},{"verse":19,"text":"しかし私の敵は、活気に満ちて、強く、私を憎む偽り者が多くいます。","tok":[["しかし"],["私","わたくし"],["の"],["敵","てき"],["は"],["、"],["活気","かっき"],["に"],["満ちて","みちて"],["、"],["強く","つよく"],["、"],["私","わたくし"],["を"],["憎む","にくむ"],["偽り者","いつわりしゃ"],["が"],["多く","おおく"],["います"],["。"]]},{"verse":20,"text":"また、善にかえて悪を報いる者どもは、私が善を追い求めるからといって、私をなじっています。","tok":[["また"],["、"],["善","ぜん"],["に"],["かえて"],["悪","あく"],["を"],["報いる","むくいる"],["者","もの"],["ども"],["は"],["、"],["私","わたくし"],["が"],["善","ぜん"],["を"],["追い求める","おいもとめる"],["から"],["と"],["いって"],["、"],["私","わたくし"],["を"],["なじって"],["います"],["。"]]},{"verse":21,"text":"私を見捨てないでください。主よ。わが神よ。私から遠く離れないでください。","tok":[["私","わたくし"],["を"],["見捨てないで","みすてないで"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["わが"],["神","かみ"],["よ"],["。"],["私","わたくし"],["から"],["遠く","とおく"],["離れないで","はなれないで"],["ください"],["。"]]},{"verse":22,"text":"急いで私を助けてください。主よ、私の救いよ。","tok":[["急いで","いそいで"],["私","わたくし"],["を"],["助けて","たすけて"],[
[{"verse":1,"text":"幸いなことよ。悪者のはかりごとに歩まず、罪人の道に立たず、あざける者の座に着かなかった、その人。","tok":[["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["悪者","わるもの"],["の"],["はかりごと"],["に"],["歩まず","あゆまず"],["、"],["罪人","ざいにん"],["の"],["道","みち"],["に"],["立たず","たたず"],["、"],["あざける"],["者","もの"],["の"],["座","ざ"],["に"],["着かなかった","つかなかった"],["、"],["その"],["人","ひと"],["。"]]},{"verse":2,"text":"まことに、その人は主のおしえを喜びとし、昼も夜もそのおしえを口ずさむ。","tok":[["まこと"],["に"],["、"],["その"],["人","ひと"],["は"],["主","ぬし"],["の"],["おしえ"],["を"],["喜び","よろこび"],["と"],["し"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["その"],["おしえ"],["を"],["口ずさむ","くちずさむ"],["。"]]},{"verse":3,"text":"その人は、水路のそばに植わった木のようだ。時が来ると実がなり、その葉は枯れない。その人は、何をしても栄える。","tok":[["その"],["人","ひと"],["は"],["、"],["水路","すいろ"],["の"],["そば"],["に"],["植わった","うわった"],["木","き"],["の"],["よう"],["だ"],["。"],["時","じ"],["が"],["来る","くる"],["と"],["実","じつ"],["が"],["なり"],["、"],["その"],["葉","は"],["は"],["枯れない","かれない"],["。"],["その"],["人","ひと"],["は"],["、"],["何","なん"],["を"],["して"],["も"],["栄える","さかえる"],["。"]]},{"verse":4,"text":"悪者は、それとは違い、まさしく、風が吹き飛ばすもみがらのようだ。","tok":[["悪者","わるもの"],["は"],["、"],["それ"],["と"],["は"],["違い","ちがい"],["、"],["まさしく"],["、"],["風","かぜ"],["が"],["吹き飛ばす","ふきとばす"],["もみがら"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"それゆえ、悪者は、さばきの中に立ちおおせず、罪人は、正しい者のつどいに立てない。","tok":[["それ"],["ゆえ"],["、"],["悪者","わるもの"],["は"],["、"],["さばき"],["の"],["中","なか"],["に"],["立ち","たち"],["おおせず"],["、"],["罪人","ざいにん"],["は"],["、"],["正しい","ただしい"],["者","もの"],["の"],["つどい"],["に"],["立てない","たてない"],["。"]]},{"verse":6,"text":"まことに、主は、正しい者の道を知っておられる。しかし、悪者の道は滅びうせる。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["、"],["正しい","ただしい"],["者","もの"],["の"],["道","みち"],["を"],["知って","しって"],["おられる"],["。"],["しかし"],["、"],["悪者","わるもの"],["の"],["道","みち"],["は"],["滅び","ほろび"],["うせる"],["。"]]}]
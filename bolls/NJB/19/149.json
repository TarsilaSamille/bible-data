[{"verse":1,"text":"ハレルヤ。主に新しい歌を歌え。聖徒の集まりで主への賛美を。","tok":[["ハレルヤ"],["。"],["主に","おもに"],["新しい","あたらしい"],["歌","うた"],["を"],["歌え","うたえ"],["。"],["聖徒","せいと"],["の"],["集まり","あつまり"],["で"],["主","ぬし"],["へ"],["の"],["賛美","さんび"],["を"],["。"]]},{"verse":2,"text":"イスラエルは、おのれの造り主にあって喜べ。シオンの子らは、おのれの王にあって楽しめ。","tok":[["イスラエル"],["は"],["、"],["おのれ"],["の"],["造り主","つくりぬし"],["に"],["あって"],["喜べ","よろこべ"],["。"],["シオン"],["の"],["子","こ"],["ら"],["は"],["、"],["おのれ"],["の"],["王","おう"],["に"],["あって"],["楽しめ","たのしめ"],["。"]]},{"verse":3,"text":"踊りをもって、御名を賛美せよ。タンバリンと立琴をかなでて、主にほめ歌を歌え。","tok":[["踊り","おどり"],["を"],["もって"],["、"],["御名","ぎょめい"],["を"],["賛美","さんび"],["せよ"],["。"],["タンバリン"],["と"],["立琴","たてごと"],["を"],["かなでて"],["、"],["主に","おもに"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"]]},{"verse":4,"text":"主は、ご自分の民を愛し、救いをもって貧しい者を飾られる。","tok":[["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["愛し","あいし"],["、"],["救い","すくい"],["を"],["もって"],["貧しい","まずしい"],["者","もの"],["を"],["飾られる","かざられる"],["。"]]},{"verse":5,"text":"聖徒たちは栄光の中で喜び勇め。おのれの床の上で、高らかに歌え。","tok":[["聖徒","せいと"],["たち"],["は"],["栄光","えいこう"],["の"],["中","なか"],["で"],["喜び勇め","よろこびいさめ"],["。"],["おのれ"],["の"],["床","ゆか"],["の"],["上","うえ"],["で"],["、"],["高らか","たからか"],["に"],["歌え","うたえ"],["。"]]},{"verse":6,"text":"彼らの口には、神への称賛、彼らの手には、もろ刃の剣があるように。","tok":[["彼","かれ"],["ら"],["の"],["口","くち"],["に"],["は"],["、"],["神","かみ"],["へ"],["の"],["称賛","しょうさん"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["は"],["、"],["もろ刃","もろは"],["の"],["剣","けん"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":7,"text":"それは国々に復讐し、国民を懲らすため、","tok":[["それ"],["は"],["国々","くにぐに"],["に"],["復讐","ふくしゅう"],["し"],["、"],["国民","こくみん"],["を"],["懲らす","こらす"],["ため"],["、"]]},{"verse":8,"text":"また、鎖で彼らの王たちを、鉄のかせで彼らの貴族たちを縛るため。","tok":[["また"],["、"],["鎖","くさり"],["で"],["彼","かれ"],["ら"],["の"],["王","おう"],["たち"],["を"],["、"],["鉄","てつ"],["のかせで"],["彼","かれ"],["ら"],["の"],["貴族","きぞく"],["たち"],["を"],["縛る","しばる"],["ため"],["。"]]},{"verse":9,"text":"また書きしるされたさばきを彼らの間で行うため。それは、すべての聖徒の誉れである。ハレルヤ。","tok":[["また"],["書きしるされた","かきしるされた"],["さばき"],["を"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["行う","おこなう"],["ため"],["。"],["それ"],["は"],["、"],["すべて"],["の"],["聖徒","せいと"],["の"],["誉れ","ほまれ"],["で"],["ある"],["。"],["ハレルヤ"],["。"]]}]
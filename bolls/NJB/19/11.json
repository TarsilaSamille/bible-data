[{"verse":1,"text":"（指揮者のために。ダビデによる）主に私は身を避ける。どうして、あなたたちは私のたましいに言うのか。「鳥のように、おまえたちの山に飛んで行け。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["に"],["よる"],["）"],["主に","おもに"],["私","わたくし"],["は"],["身","み"],["を"],["避ける","さける"],["。"],["どう"],["して"],["、"],["あなた"],["たち"],["は"],["私","わたくし"],["の"],["たましい"],["に"],["言う","いう"],["の"],["か"],["。"],["「"],["鳥","とり"],["の"],["よう"],["に"],["、"],["おまえ"],["たち"],["の"],["山","やま"],["に"],["飛んで","とんで"],["行け","いけ"],["。"]]},{"verse":2,"text":"それ、見よ。悪者どもが弓を張り、弦に矢をつがえ、暗やみで心の直ぐな人を射ぬこうとしている。","tok":[["それ"],["、"],["見","み"],["よ"],["。"],["悪者","わるもの"],["ども"],["が"],["弓","ゆみ"],["を"],["張り","はり"],["、"],["弦","げん"],["に"],["矢","や"],["を"],["つがえ"],["、"],["暗やみ","くらやみ"],["で"],["心","こころ"],["の"],["直ぐ","すぐ"],["な"],["人","ひと"],["を"],["射ぬこう","いぬこう"],["として"],["いる"],["。"]]},{"verse":3,"text":"拠り所がこわされたら正しい者に何ができようか。」","tok":[["拠り所","よりどころ"],["が"],["こわされたら"],["正しい","ただしい"],["者","もの"],["に"],["何","なん"],["が"],["できよう"],["か"],["。"],["」"]]},{"verse":4,"text":"主は、その聖座が宮にあり、主は、その王座が天にある。その目は見通し、そのまぶたは、人の子らを調べる。","tok":[["主","ぬし"],["は"],["、"],["その"],["聖","せい"],["座","ざ"],["が"],["宮","みや"],["に"],["あり"],["、"],["主","ぬし"],["は"],["、"],["その"],["王座","おうざ"],["が"],["天","てん"],["に"],["ある"],["。"],["その"],["目","め"],["は"],["見通し","みとおし"],["、"],["その"],["まぶた"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["を"],["調べる","しらべる"],["。"]]},{"verse":5,"text":"主は正しい者と悪者を調べる。そのみこころは、暴虐を好む者を憎む。","tok":[["主","ぬし"],["は"],["正しい","ただしい"],["者","もの"],["と"],["悪者","わるもの"],["を"],["調べる","しらべる"],["。"],["その"],["みこころ"],["は"],["、"],["暴虐","ぼうぎゃく"],["を"],["好む","このむ"],["者","もの"],["を"],["憎む","にくむ"],["。"]]},{"verse":6,"text":"主は、悪者の上に網を張る。火と硫黄。燃える風が彼らの杯への分け前となろう。","tok":[["主","ぬし"],["は"],["、"],["悪者","わるもの"],["の"],["上","うえ"],["に"],["網","あみ"],["を"],["張る","はる"],["。"],["火","ひ"],["と"],["硫黄","いおう"],["。"],["燃える","もえる"],["風","かぜ"],["が"],["彼","かれ"],["ら"],["の"],["杯","さかずき"],["へ"],["の"],["分け前","わけまえ"],["と"],["なろう"],["。"]]},{"verse":7,"text":"主は正しく、正義を愛される。直ぐな人は、御顔を仰ぎ見る。","tok":[["主","ぬし"],["は"],["正しく","ただしく"],["、"],["正義","せいぎ"],["を"],["愛される","あいされる"],["。"],["直ぐ","すぐ"],["な"],["人","ひと"],["は"],["、"],["御顔","おかお"],["を"],["仰ぎ見る","あおぎみる"],["。"]]}]
[{"verse":1,"text":"（都上りの歌）主がシオンの繁栄を元どおりにされたとき、私たちは夢を見ている者のようであった。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["主","ぬし"],["が"],["シオン"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["された"],["とき"],["、"],["私たち","わたしたち"],["は"],["夢","ゆめ"],["を"],["見て","みて"],["いる"],["者","もの"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":2,"text":"そのとき、私たちの口は笑いで満たされ、私たちの舌は喜びの叫びで満たされた。そのとき、国々の間で、人々は言った。「主は彼らのために大いなることをなされた。」","tok":[["その"],["とき"],["、"],["私たち","わたしたち"],["の"],["口","くち"],["は"],["笑い","わらい"],["で"],["満たされ","みたされ"],["、"],["私たち","わたしたち"],["の"],["舌","した"],["は"],["喜び","よろこび"],["の"],["叫び","さけび"],["で"],["満たされた","みたされた"],["。"],["その"],["とき"],["、"],["国々","くにぐに"],["の"],["間","あいだ"],["で"],["、"],["人々","ひとびと"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["大いなる","おおいなる"],["こと"],["を"],["なされた"],["。"],["」"]]},{"verse":3,"text":"主は私たちのために大いなることをなされ、私たちは喜んだ。","tok":[["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["ため"],["に"],["大いなる","おおいなる"],["こと"],["を"],["なされ"],["、"],["私たち","わたしたち"],["は"],["喜んだ","よろこんだ"],["。"]]},{"verse":4,"text":"主よ。ネゲブの流れのように、私たちの繁栄を元どおりにしてください。","tok":[["主","ぬし"],["よ"],["。"],["ネゲブ"],["の"],["流れ","ながれ"],["の"],["よう"],["に"],["、"],["私たち","わたしたち"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["して"],["ください"],["。"]]},{"verse":5,"text":"涙とともに種を蒔く者は、喜び叫びながら刈り取ろう。","tok":[["涙","なみだ"],["と"],["とも"],["に"],["種","しゅ"],["を"],["蒔く","まく"],["者","もの"],["は"],["、"],["喜び叫び","よろこびさけび"],["ながら"],["刈り取ろう","かりとろう"],["。"]]},{"verse":6,"text":"種入れをかかえ、泣きながら出て行く者は、束をかかえ、喜び叫びながら帰って来る。","tok":[["種入れ","しゅいれ"],["を"],["かかえ"],["、"],["泣き","なき"],["ながら"],["出て","でて"],["行く","いく"],["者","もの"],["は"],["、"],["束","たば"],["を"],["かかえ"],["、"],["喜び叫び","よろこびさけび"],["ながら"],["帰って","かえって"],["来る","くる"],["。"]]}]
[{"verse":1,"text":"（ダビデがその子アブシャロムからのがれたときの賛歌）主よ。なんと私の敵がふえてきたことでしょう。私に立ち向かう者が多くいます。","tok":[["（"],["ダビデ"],["が"],["その"],["子","こ"],["アブシャロム"],["から"],["のがれた"],["とき"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["なん"],["と"],["私","わたくし"],["の"],["敵","てき"],["が"],["ふえて"],["きた"],["こと"],["でしょう"],["。"],["私","わたくし"],["に"],["立ち向かう","たちむかう"],["者","もの"],["が"],["多く","おおく"],["います"],["。"]]},{"verse":2,"text":"多くの者が私のたましいのことを言っています。「彼に神の救いはない」と。セラ","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["私","わたくし"],["の"],["たましい"],["の"],["こと"],["を"],["言って","いって"],["います"],["。"],["「"],["彼","かれ"],["に"],["神","かみ"],["の"],["救い","すくい"],["は"],["ない"],["」"],["と"],["。"],["セラ"]]},{"verse":3,"text":"しかし、主よ。あなたは私の回りを囲む盾、私の栄光、そして私のかしらを高く上げてくださる方です。","tok":[["しかし"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["回り","まわり"],["を"],["囲む","かこむ"],["盾","たて"],["、"],["私","わたくし"],["の"],["栄光","えいこう"],["、"],["そして"],["私","わたくし"],["の"],["かしら"],["を"],["高く","たかく"],["上げて","あげて"],["くださる"],["方","かた"],["です"],["。"]]},{"verse":4,"text":"私は声をあげて、主に呼ばわる。すると、聖なる山から私に答えてくださる。セラ","tok":[["私","わたくし"],["は"],["声","こえ"],["を"],["あげて"],["、"],["主に","おもに"],["呼ばわる","よばわる"],["。"],["する"],["と"],["、"],["聖","せい"],["なる"],["山","やま"],["から"],["私","わたくし"],["に"],["答えて","こたえて"],["くださる"],["。"],["セラ"]]},{"verse":5,"text":"私は身を横たえて、眠る。私はまた目をさます。主がささえてくださるから。","tok":[["私","わたくし"],["は"],["身","み"],["を"],["横たえて","よこたえて"],["、"],["眠る","ねむる"],["。"],["私","わたくし"],["は"],["また"],["目","め"],["を"],["さます"],["。"],["主","ぬし"],["が"],["ささえて"],["くださる"],["から"],["。"]]},{"verse":6,"text":"私を取り囲んでいる幾万の民をも私は恐れない。","tok":[["私","わたくし"],["を"],["取り囲んで","とりかこんで"],["いる"],["幾","いく"],["万","まん"],["の"],["民","たみ"],["を"],["も"],["私","わたくし"],["は"],["恐れない","おそれない"],["。"]]},{"verse":7,"text":"主よ。立ち上がってください。私の神。私をお救いください。あなたは私のすべての敵の頬を打ち、悪者の歯を打ち砕いてくださいます。","tok":[["主","ぬし"],["よ"],["。"],["立ち上がって","たちあがって"],["ください"],["。"],["私","わたくし"],["の"],["神","かみ"],["。"],["私","わたくし"],["を"],["お救い","おすくい"],["ください"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["すべて"],["の"],["敵","てき"],["の"],["頬","ほお"],["を"],["打ち","うち"],["、"],["悪者","わるもの"],["の"],["歯","は"],["を"],["打ち砕いて","うちくだいて"],["くださいます"],["。"]]},{"verse":8,"text":"救いは主にあります。あなたの祝福があなたの民の上にありますように。セラ","tok":[["救い","すくい"],["は"],["主に","おもに"],["あります"],["。"],["あなた"],["の"],["祝福","しゅくふく"],["が"],["あなた"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"],["セラ"]]}]
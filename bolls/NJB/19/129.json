[{"verse":1,"text":"（都上りの歌）「彼らは私の若いころからひどく私を苦しめた。」さあ、イスラエルは言え。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["「"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["の"],["若い","わかい"],["ころ"],["から"],["ひどく"],["私","わたくし"],["を"],["苦しめた","くるしめた"],["。"],["」"],["さあ"],["、"],["イスラエル"],["は"],["言え","いえ"],["。"]]},{"verse":2,"text":"「彼らは私の若いころからひどく私を苦しめた。彼らは私に勝てなかった。","tok":[["「"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["の"],["若い","わかい"],["ころ"],["から"],["ひどく"],["私","わたくし"],["を"],["苦しめた","くるしめた"],["。"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["に"],["勝てなかった","かてなかった"],["。"]]},{"verse":3,"text":"耕す者は私の背に鋤をあて、長いあぜを作った。」","tok":[["耕す","たがやす"],["者","もの"],["は"],["私","わたくし"],["の"],["背","せ"],["に"],["鋤","すき"],["を"],["あて"],["、"],["長い","ながい"],["あぜ"],["を"],["作った","つくった"],["。"],["」"]]},{"verse":4,"text":"主は、正しくあり、悪者の綱を断ち切られた。","tok":[["主","ぬし"],["は"],["、"],["正しく","まさしく"],["あり"],["、"],["悪者","わるもの"],["の"],["綱","つな"],["を"],["断ち切られた","たちきられた"],["。"]]},{"verse":5,"text":"シオンを憎む者はみな、恥を受けて、退け。","tok":[["シオン"],["を"],["憎む","にくむ"],["者","もの"],["は"],["みな"],["、"],["恥","はじ"],["を"],["受けて","うけて"],["、"],["退け","のけ"],["。"]]},{"verse":6,"text":"彼らは伸びないうちに枯れる屋根の草のようになれ。","tok":[["彼","かれ"],["ら"],["は"],["伸びない","のびない"],["うち"],["に"],["枯れる","かれる"],["屋根","やね"],["の"],["草","くさ"],["の"],["よう"],["に"],["なれ"],["。"]]},{"verse":7,"text":"刈り取る者は、そんなものを、つかみはしない。たばねる者も、かかえはしない。","tok":[["刈り取る","かりとる"],["者","もの"],["は"],["、"],["そんな"],["もの"],["を"],["、"],["つかみ"],["は"],["しない"],["。"],["たばねる"],["者","もの"],["も"],["、"],["かかえ"],["は"],["しない"],["。"]]},{"verse":8,"text":"通りがかりの人も、「主の祝福があなたがたにあるように。主の名によってあなたがたを祝福します」とは言わない。","tok":[["通りがかり","とおりがかり"],["の"],["人","ひと"],["も"],["、"],["「"],["主","ぬし"],["の"],["祝福","しゅくふく"],["が"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"],["主","ぬし"],["の"],["名","な"],["によって"],["あなた"],["がた"],["を"],["祝福","しゅくふく"],["します"],["」"],["と"],["は"],["言わない","いわない"],["。"]]}]
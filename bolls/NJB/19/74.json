[{"verse":1,"text":"（アサフのマスキール）神よ。なぜ、いつまでも拒み、あなたの牧場の羊に御怒りを燃やされるのですか。","tok":[["（"],["アサフ"],["の"],["マスキール"],["）"],["神","かみ"],["よ"],["。"],["なぜ"],["、"],["いつ"],["まで"],["も"],["拒み","こばみ"],["、"],["あなた"],["の"],["牧場","ぼくじょう"],["の"],["羊","ひつじ"],["に"],["御怒り","おいかり"],["を"],["燃やされる","もやされる"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"どうか思い起こしてください。昔あなたが買い取られた、あなたの会衆、あなたがご自分のものである部族として贖われた民を。また、あなたがお住まいになったシオンの山を。","tok":[["どう"],["か"],["思い起こして","おもいおこして"],["ください"],["。"],["昔","むかし"],["あなた"],["が"],["買い取られた","かいとられた"],["、"],["あなた"],["の"],["会衆","かいしゅう"],["、"],["あなた"],["が"],["ご自分","ごじぶん"],["の"],["もの"],["で"],["ある"],["部族","ぶぞく"],["として"],["贖われた","あがなわれた"],["民","たみ"],["を"],["。"],["また"],["、"],["あなた"],["が"],["お住まい","おすまい"],["に"],["なった"],["シオン"],["の"],["山","やま"],["を"],["。"]]},{"verse":3,"text":"永遠の廃墟に、あなたの足を向けてください。敵は聖所であらゆる害を加えています。","tok":[["永遠","えいえん"],["の"],["廃墟","はいきょ"],["に"],["、"],["あなた"],["の"],["足","あし"],["を"],["向けて","むけて"],["ください"],["。"],["敵","てき"],["は"],["聖","せい"],["所","しょ"],["で"],["あらゆる"],["害","がい"],["を"],["加えて","くわえて"],["います"],["。"]]},{"verse":4,"text":"あなたに敵対する者どもは、あなたの集会のただ中でほえたけり、おのれらの目じるしを、しるしとして掲げ、","tok":[["あなた"],["に"],["敵対","てきたい"],["する"],["者","もの"],["ども"],["は"],["、"],["あなた"],["の"],["集会","しゅうかい"],["の"],["ただ中","ただなか"],["で"],["ほえたけり"],["、"],["おのれ"],["ら"],["の"],["目じるし","めじるし"],["を"],["、"],["しるし"],["として"],["掲げ","かかげ"],["、"]]},{"verse":5,"text":"森の中で斧を振り上げるかのようです。","tok":[["森","もり"],["の"],["中","なか"],["で"],["斧","おの"],["を"],["振り上げる","ふりあげる"],["か"],["の"],["よう"],["です"],["。"]]},{"verse":6,"text":"そうして今や、手斧と槌で、聖所の彫り物をことごとく打ち砕き、","tok":[["そう"],["して"],["今","いま"],["や"],["、"],["手斧","ちょうな"],["と"],["槌","つち"],["で"],["、"],["聖","せい"],["所","しょ"],["の"],["彫り物","ほりもの"],["を"],["ことごとく"],["打ち砕き","うちくだき"],["、"]]},{"verse":7,"text":"あなたの聖所に火を放ち、あなたの御名の住まいを、その地まで汚しました。","tok":[["あなた"],["の"],["聖","せい"],["所","しょ"],["に"],["火","ひ"],["を"],["放ち","はなち"],["、"],["あなた"],["の"],["御名","ぎょめい"],["の"],["住まい","すまい"],["を"],["、"],["その"],["地","ち"],["まで"],["汚しました","よごしました"],["。"]]},{"verse":8,"text":"彼らは心の中で、「彼らを、ことごとく征服しよう」と言い、国中の神の集会所をみな、焼き払いました。","tok":[["彼","かれ"],["ら"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["「"],["彼","かれ"],["ら"],["を"],["、"],["ことごとく"],["征服","せいふく"],["しよう"],["」"],["と"],["言い","いい"],["、"],["国中","くにちゅう"],["の"],["神","かみ"],["の"],["集会所","しゅうかいしょ"],["を"],["みな"],["、"],["焼き払いました","やきはらいました"],["。"]]},{"verse":9,"text":"もう私たちのしるしは見られません。もはや預言者もいません。いつまでそうなのかを知っている者も、私たちの間にはいません。","tok":[["もう"],["私たち","わたしたち"],["の"],["しるし"],["は"],["見られません","みられません"],["。"],["もはや"],["預言者","よげんしゃ"],["も"],["いません"],["。"],["いつ"],["まで"],["そう"],["な"],["の"],["か"],["を"],["知って","しって"],["いる"],["者","もの"],["も"],["、"],["私たち","わたしたち"],["の"],["間","あいだ"],["に"],["は"],["いません"],["。"]]},{"verse":10,"text":"神よ。いつまで、仇はそしるのでしょうか。敵は、永久に御名を侮るのでしょうか。","tok":[["神","かみ"],["よ"],["。"],["いつ"],["まで"],["、"],["仇","あだ"],["は"],["そしる"],["の"],["でしょう"],["か"],["。"],["敵","てき"],["は"],["、"],["永久","えいきゅう"],["に"],["御名","ぎょめい"],["を"],["侮る","あなどる"],["の"],["でしょう"],["か"],["。"]]},{"verse":11,"text":"なぜ、あなたは御手を、右の御手を、引っ込めておられるのですか。その手をふところから出して彼らを滅ぼし尽くしてください。","tok":[["なぜ"],["、"],["あなた"],["は"],["御手","おて"],["を"],["、"],["右","みぎ"],["の"],["御手","おて"],["を"],["、"],["引っ込めて","ひっこめて"],["おられる"],["の"],["です"],["か"],["。"],["その"],["手","て"],["を"],["ふところ"],["から"],["出して","だして"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["尽くして","つくして"],["ください"],["。"]]},{"verse":12,"text":"確かに、神は、昔から私の王、地上のただ中で、救いのわざを行われる方です。","tok":[["確か","たしか"],["に"],["、"],["神","かみ"],["は"],["、"],["昔","むかし"],["から"],["私","わたくし"],["の"],["王","おう"],["、"],["地上","ちじょう"],["の"],["ただ中","ただなか"],["で"],["、"],["救い","すくい"],["の"],["わざ"],["を"],["行われる","おこなわれる"],["方","かた"],["です"],["。"]]},{"verse":13,"text":"あなたは、御力をもって海を分け、海の巨獣の頭を砕かれました。","tok":[["あなた"],["は"],["、"],["御力","おちから"],["を"],["もって"],["海","うみ"],["を"],["分け","わけ"],["、"],["海","うみ"],["の"],["巨獣","きょじゅう"],["の"],["頭","あたま"],["を"],["砕かれました","くだかれました"],["。"]]},{"verse":14,"text":"あなたは、レビヤタンの頭を打ち砕き、荒野の民のえじきとされました。","tok":[["あなた"],["は"],["、"],["レビヤタン"],["の"],["頭","あたま"],["を"],["打ち砕き","うちくだき"],["、"],["荒野","こうや"],["の"],["民","たみ"],["の"],["えじき"],["と"],["されました"],["。"]]},{"verse":15,"text":"あなたは泉と谷を切り開き、絶えず流れる川をからされました。","tok":[["あなた"],["は"],["泉","いずみ"],["と"],["谷","たに"],["を"],["切り開き","きりひらき"],["、"],["絶えず","たえず"],["流れる","ながれる"],["川","かわ"],["を"],["からされました"],["。"]]},{"verse":16,"text":"昼はあなたのもの、夜もまたあなたのもの。あなたは月と太陽とを備えられました。","tok":[["昼","ひる"],["は"],["あなた"],["の"],["もの"],["、"],["夜","よる"],["も"],["また"],["あなた"],["の"],["もの"],["。"],["あなた"],["は"],["月","つき"],["と"],["太陽","たいよう"],["と"],["を"],["備えられました","そなえられました"],["。"]]},{"verse":17,"text":"あなたは地のすべての境を定め、夏と冬とを造られました。","tok":[["あなた"],["は"],["地","ち"],["の"],["すべて"],["の"],["境","さかい"],["を"],["定め","さだめ"],["、"],["夏","なつ"],["と"],["冬","ふゆ"],["と"],["を"],["造られました","つくられました"],["。"]]},{"verse":18,"text":"主よ。どうか、心に留めてください。敵がそしり、愚かな民が御名を侮っていることを。","tok":[["主","ぬし"],["よ"],["。"],["どう"],["か"],["、"],["心","こころ"],["に"],["留めて","とめて"],["ください"],["。"],["敵","てき"],["が"],["そしり"],["、"],["愚か","おろか"],["な"],["民","たみ"],["が"],["御名","ぎょめい"],["を"],["侮って","あなどって"],["いる"],["こと"],["を"],["。"]]},{"verse":19,"text":"あなたの山鳩のいのちを獣に引き渡さないでください。あなたの悩む者たちのいのちを永久に忘れないでください。","tok":[["あなた"],["の"],["山鳩","やまばと"],["の"],["いのち"],["を"],["獣","けもの"],["に"],["引き渡さないで","ひきわたさないで"],["ください"],["。"],["あなた"],["の"],["悩む","なやむ"],["者","もの"],["たち"],["の"],["いのち"],["を"],["永久","えいきゅう"],["に"],["忘れないで","わすれないで"],["ください"],["。"]]},{"verse":20,"text":"どうか、契約に目を留めてください。地の暗い所には暴虐が横行していますから。","tok":[["どう"],["か"],["、"],["契約","けいやく"],["に"],["目","め"],["を"],["留めて","とめて"],["ください"],["。"],["地","ち"],["の"],["暗い","くらい"],["所","ところ"],["に"],["は"],["暴虐","ぼうぎゃく"],["が"],["横行","おうこう"],["して"],["います"],["から"],["。"]]},{"verse":21,"text":"しいたげられる者が卑しめられて帰ることがなく、悩む者、貧しい者が御名をほめたたえますように。","tok":[["しいたげられる"],["者","もの"],["が"],["卑しめられて","いやしめられて"],["帰る","かえる"],["こと"],["が"],["なく"],["、"],["悩む","なやむ"],["者","もの"],["、"],["貧しい","まずしい"],["者","もの"],["が"],["御名","ぎょめい"],["を"],["ほめたたえます"],["よう"],["に"],["。"]]},{"verse":22,"text":"神よ。立ち上がり、あなたの言い分を立ててください。愚か者が一日中あなたをそしっていることを心に留めてください。","tok":[["神","かみ"],["よ"],["。"],["立ち上がり","たちあがり"],["、"],["あなた"],["の"],["言い分","いいぶん"],["を"],["立てて","たてて"],["ください"],["。"],["愚
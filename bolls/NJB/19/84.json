[{"verse":1,"text":"（指揮者のために。ギテトの調べに合わせて。コラの子たちの賛歌）万軍の主。あなたのお住まいはなんと、慕わしいことでしょう。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ギテト"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["コラ"],["の"],["子","こ"],["たち"],["の"],["賛歌","さんか"],["）"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["。"],["あなた"],["の"],["お住まい","おすまい"],["は"],["なん"],["と"],["、"],["慕わしい","したわしい"],["こと"],["でしょう"],["。"]]},{"verse":2,"text":"私のたましいは、主の大庭を恋い慕って絶え入るばかりです。私の心も、身も、生ける神に喜びの歌を歌います。","tok":[["私","わたくし"],["の"],["たましい"],["は"],["、"],["主","ぬし"],["の"],["大庭","おおば"],["を"],["恋い慕って","こいしたって"],["絶え入る","たえいる"],["ばかり"],["です"],["。"],["私","わたくし"],["の"],["心","こころ"],["も"],["、"],["身","み"],["も"],["、"],["生ける","いける"],["神","かみ"],["に"],["喜び","よろこび"],["の"],["歌","うた"],["を"],["歌います","うたいます"],["。"]]},{"verse":3,"text":"雀さえも、住みかを見つけました。つばめも、ひなを入れる巣、あなたの祭壇を見つけました。万軍の主。私の王、私の神よ。","tok":[["雀","すずめ"],["さえ"],["も"],["、"],["住みか","すみか"],["を"],["見つけました","みつけました"],["。"],["つばめ"],["も"],["、"],["ひな"],["を"],["入れる","いれる"],["巣","す"],["、"],["あなた"],["の"],["祭壇","さいだん"],["を"],["見つけました","みつけました"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["。"],["私","わたくし"],["の"],["王","おう"],["、"],["私","わたくし"],["の"],["神","かみ"],["よ"],["。"]]},{"verse":4,"text":"なんと幸いなことでしょう。あなたの家に住む人たちは。彼らは、いつも、あなたをほめたたえています。セラ","tok":[["なん"],["と"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["。"],["あなた"],["の"],["家","いえ"],["に"],["住む","すむ"],["人","ひと"],["たち"],["は"],["。"],["彼","かれ"],["ら"],["は"],["、"],["いつも"],["、"],["あなた"],["を"],["ほめたたえて"],["います"],["。"],["セラ"]]},{"verse":5,"text":"なんと幸いなことでしょう。その力が、あなたにあり、その心の中にシオンへの大路のある人は。","tok":[["なん"],["と"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["。"],["その"],["力","ちから"],["が"],["、"],["あなた"],["に"],["あり"],["、"],["その"],["心","こころ"],["の"],["中","なか"],["に"],["シオン"],["へ"],["の"],["大路","おおじ"],["の"],["ある"],["人","ひと"],["は"],["。"]]},{"verse":6,"text":"彼らは涙の谷を過ぎるときも、そこを泉のわく所とします。初めの雨もまたそこを祝福でおおいます。","tok":[["彼","かれ"],["ら"],["は"],["涙","なみだ"],["の"],["谷","たに"],["を"],["過ぎる","すぎる"],["とき"],["も"],["、"],["そこ"],["を"],["泉","いずみ"],["の"],["わく所","わくしょ"],["と"],["します"],["。"],["初め","はじめ"],["の"],["雨","あめ"],["も"],["また"],["そこ"],["を"],["祝福","しゅくふく"],["で"],["おおいます"],["。"]]},{"verse":7,"text":"彼らは、力から力へと進み、シオンにおいて、神の御前に現れます。","tok":[["彼","かれ"],["ら"],["は"],["、"],["力","ちから"],["から"],["力","ちから"],["へ"],["と"],["進み","すすみ"],["、"],["シオン"],["に"],["おいて"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["現れます","あらわれます"],["。"]]},{"verse":8,"text":"万軍の神、主よ。私の祈りを聞いてください。ヤコブの神よ。耳を傾けてください。セラ","tok":[["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["祈り","いのり"],["を"],["聞いて","きいて"],["ください"],["。"],["ヤコブ"],["の"],["神","かみ"],["よ"],["。"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"],["セラ"]]},{"verse":9,"text":"神よ。われらの盾をご覧ください。あなたに油そそがれた者の顔に目を注いでください。","tok":[["神","かみ"],["よ"],["。"],["われ"],["ら"],["の"],["盾","たて"],["を"],["ご覧","ごらん"],["ください"],["。"],["あなた"],["に"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["顔","かお"],["に"],["目","め"],["を"],["注いで","そそいで"],["ください"],["。"]]},{"verse":10,"text":"まことに、あなたの大庭にいる一日は千日にまさります。私は悪の天幕に住むよりはむしろ神の宮の門口に立ちたいのです。","tok":[["まこと"],["に"],["、"],["あなた"],["の"],["大庭","おおば"],["に"],["いる"],["一","いち"],["日","にち"],["は"],["千","せん"],["日","にち"],["に"],["まさります"],["。"],["私","わたくし"],["は"],["悪","あく"],["の"],["天幕","てんまく"],["に"],["住む","すむ"],["より"],["は"],["むしろ"],["神","かみ"],["の"],["宮","みや"],["の"],["門口","かどぐち"],["に"],["立ちたい","たちたい"],["の"],["です"],["。"]]},{"verse":11,"text":"まことに、神なる主は太陽です。盾です。主は恵みと栄光を授け、正しく歩く者たちに、良いものを拒まれません。","tok":[["まこと"],["に"],["、"],["神","かみ"],["なる"],["主","ぬし"],["は"],["太陽","たいよう"],["です"],["。"],["盾","たて"],["です"],["。"],["主","ぬし"],["は"],["恵み","めぐみ"],["と"],["栄光","えいこう"],["を"],["授け","さずけ"],["、"],["正しく","ただしく"],["歩く","あるく"],["者","もの"],["たち"],["に"],["、"],["良い","よい"],["もの"],["を"],["拒まれません","こばまれません"],["。"]]},{"verse":12,"text":"万軍の主よ。なんと幸いなことでしょう。あなたに信頼するその人は。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["。"],["なん"],["と"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["。"],["あなた"],["に"],["信頼","しんらい"],["する"],["その"],["人","ひと"],["は"],["。"]]}]
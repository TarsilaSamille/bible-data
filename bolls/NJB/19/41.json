[{"verse":1,"text":"（指揮者のために。ダビデの賛歌）幸いなことよ。弱っている者に心を配る人は。主はわざわいの日にその人を助け出される。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["弱って","よわって"],["いる"],["者","もの"],["に"],["心","こころ"],["を"],["配る","くばる"],["人","ひと"],["は"],["。"],["主","ぬし"],["は"],["わざわい"],["の"],["日","ひ"],["に"],["その"],["人","ひと"],["を"],["助け出される","たすけだされる"],["。"]]},{"verse":2,"text":"主は彼を見守り、彼を生きながらえさせ、地上でしあわせな者とされる。どうか彼を敵の意のままにさせないでください。","tok":[["主","ぬし"],["は"],["彼","かれ"],["を"],["見守り","みまもり"],["、"],["彼","かれ"],["を"],["生きながらえさせ","いきながらえさせ"],["、"],["地上","ちじょう"],["で"],["しあわせ"],["な"],["者","もの"],["と"],["される"],["。"],["どう"],["か"],["彼","かれ"],["を"],["敵","てき"],["の"],["意","い"],["の"],["まま"],["に"],["させないで"],["ください"],["。"]]},{"verse":3,"text":"主は病の床で彼をささえられる。病むときにどうか彼を全くいやしてくださるように。","tok":[["主","ぬし"],["は"],["病","やまい"],["の"],["床","ゆか"],["で"],["彼","かれ"],["を"],["ささえられる"],["。"],["病む","やむ"],["とき"],["に"],["どう"],["か"],["彼","かれ"],["を"],["全く","まったく"],["いやして"],["くださる"],["よう"],["に"],["。"]]},{"verse":4,"text":"私は言った。「主よ、あわれんでください。私のたましいをいやしてください。私はあなたに罪を犯したからです。」","tok":[["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["あわれんで"],["ください"],["。"],["私","わたくし"],["の"],["たましい"],["を"],["いやして"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["です"],["。"],["」"]]},{"verse":5,"text":"私の敵は、私の悪口を言います。「いつ、彼は死に、その名は滅びるのだろうか。」","tok":[["私","わたくし"],["の"],["敵","てき"],["は"],["、"],["私","わたくし"],["の"],["悪口","わるぐち"],["を"],["言います","いいます"],["。"],["「"],["いつ"],["、"],["彼","かれ"],["は"],["死に","しに"],["、"],["その"],["名","な"],["は"],["滅びる","ほろびる"],["の"],["だろう"],["か"],["。"],["」"]]},{"verse":6,"text":"たとい、人が見舞いに来ても、その人はうそを言い、その心のうちでは、悪意をたくわえ、外に出ては、それを言いふらす。","tok":[["たとい"],["、"],["人","ひと"],["が"],["見舞い","みまい"],["に"],["来て","きて"],["も"],["、"],["その"],["人","ひと"],["は"],["うそ"],["を"],["言い","いい"],["、"],["その"],["心","こころ"],["の"],["うち"],["で"],["は"],["、"],["悪意","あくい"],["を"],["たくわえ"],["、"],["外","そと"],["に"],["出て","でて"],["は"],["、"],["それ"],["を"],["言いふらす","いいふらす"],["。"]]},{"verse":7,"text":"私を憎む者はみな、私について共にささやき、私に対して、悪をたくらむ。","tok":[["私","わたくし"],["を"],["憎む","にくむ"],["者","もの"],["は"],["みな"],["、"],["私","わたくし"],["について"],["共","とも"],["に"],["ささやき"],["、"],["私","わたくし"],["に対して","にたいして"],["、"],["悪","あく"],["を"],["たくらむ"],["。"]]},{"verse":8,"text":"「邪悪なものが、彼に取りついている。彼が床に着いたからには、もう二度と起き上がれまい。」","tok":[["「"],["邪悪","じゃあく"],["な"],["もの"],["が"],["、"],["彼","かれ"],["に"],["取りついて","とりついて"],["いる"],["。"],["彼","かれ"],["が"],["床","ゆか"],["に"],["着いた","ついた"],["から"],["に"],["は"],["、"],["もう"],["二","に"],["度","ど"],["と"],["起き上がれまい","おきあがれまい"],["。"],["」"]]},{"verse":9,"text":"私が信頼し、私のパンを食べた親しい友までが、私にそむいて、かかとを上げた。","tok":[["私","わたくし"],["が"],["信頼","しんらい"],["し"],["、"],["私","わたくし"],["の"],["パン"],["を"],["食べた","たべた"],["親しい","したしい"],["友","とも"],["まで"],["が"],["、"],["私","わたくし"],["に"],["そむいて"],["、"],["かかと"],["を"],["上げた","あげた"],["。"]]},{"verse":10,"text":"しかし、主よ。あなたは私をあわれんでください。私を立ち上がらせてください。そうすれば私は、彼らに仕返しができます。","tok":[["しかし"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["私","わたくし"],["を"],["あわれんで"],["ください"],["。"],["私","わたくし"],["を"],["立ち上がらせて","たちあがらせて"],["ください"],["。"],["そう"],["すれば"],["私","わたくし"],["は"],["、"],["彼","かれ"],["ら"],["に"],["仕返し","しかえし"],["が"],["できます"],["。"]]},{"verse":11,"text":"このことによって、あなたは私を喜んでおられるのが、わかります。私の敵が私に勝ちどきをあげないからです。","tok":[["この"],["こと"],["によって"],["、"],["あなた"],["は"],["私","わたくし"],["を"],["喜んで","よろこんで"],["おられる"],["の"],["が"],["、"],["わかります"],["。"],["私","わたくし"],["の"],["敵","てき"],["が"],["私","わたくし"],["に"],["勝ちどき","かちどき"],["を"],["あげない"],["から"],["です"],["。"]]},{"verse":12,"text":"誠実を尽くしている私を強くささえ、いつまでも、あなたの御顔の前に立たせてください。","tok":[["誠実","せいじつ"],["を"],["尽くして","つくして"],["いる"],["私","わたくし"],["を"],["強く","つよく"],["ささえ"],["、"],["いつ"],["まで"],["も"],["、"],["あなた"],["の"],["御顔","おかお"],["の"],["前","まえ"],["に"],["立たせて","たたせて"],["ください"],["。"]]},{"verse":13,"text":"ほむべきかな。イスラエルの神、主。とこしえから、とこしえまで。アーメン。アーメン。｜｜第二巻","tok":[["ほ"],["むべき"],["か"],["な"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["。"],["とこしえ"],["から"],["、"],["とこしえ"],["まで"],["。"],["アーメン"],["。"],["アーメン"],["。"],["｜"],["｜"],["第","だい"],["二","に"],["巻","かん"]]}]
[{"verse":1,"text":"（指揮者のために。歌。賛歌）全地よ。神に向かって喜び叫べ。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["歌","うた"],["。"],["賛歌","さんか"],["）"],["全地","ぜんち"],["よ"],["。"],["神","かみ"],["に"],["向かって","むかって"],["喜び叫べ","よろこびさけべ"],["。"]]},{"verse":2,"text":"御名の栄光をほめ歌い、神への賛美を栄光に輝かせよ。","tok":[["御名","ぎょめい"],["の"],["栄光","えいこう"],["を"],["ほめ"],["歌い","うたい"],["、"],["神","かみ"],["へ"],["の"],["賛美","さんび"],["を"],["栄光","えいこう"],["に"],["輝かせ","かがやかせ"],["よ"],["。"]]},{"verse":3,"text":"神に申し上げよ。「あなたのみわざは、なんと恐ろしいことでしょう。偉大な御力のために、あなたの敵は、御前にへつらい服します。","tok":[["神","かみ"],["に"],["申し上げ","もうしあげ"],["よ"],["。"],["「"],["あなた"],["のみ"],["わざ"],["は"],["、"],["なん"],["と"],["恐ろしい","おそろしい"],["こと"],["でしょう"],["。"],["偉大","いだい"],["な"],["御力","おちから"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["敵","てき"],["は"],["、"],["御前","ごぜん"],["に"],["へつらい"],["服します","ふくします"],["。"]]},{"verse":4,"text":"全地はあなたを伏し拝み、あなたにほめ歌を歌います。あなたの御名をほめ歌います。」セラ","tok":[["全地","ぜんち"],["は"],["あなた"],["を"],["伏し拝み","ふしおがみ"],["、"],["あなた"],["に"],["ほめ歌","ほめうた"],["を"],["歌います","うたいます"],["。"],["あなた"],["の"],["御名","ぎょめい"],["を"],["ほめ"],["歌います","うたいます"],["。"],["」"],["セラ"]]},{"verse":5,"text":"さあ、神のみわざを見よ。神の人の子らになさることは恐ろしい。","tok":[["さあ"],["、"],["神","かみ"],["のみ"],["わざ"],["を"],["見よ","みよ"],["。"],["神","かみ"],["の"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["なさる"],["こと"],["は"],["恐ろしい","おそろしい"],["。"]]},{"verse":6,"text":"神は海を変えて、かわいた地とされた。人々は川の中を歩いて渡る。さあ、私たちは、神にあって喜ぼう。","tok":[["神","かみ"],["は"],["海","うみ"],["を"],["変えて","かえて"],["、"],["かわいた"],["地","ち"],["と"],["された"],["。"],["人々","ひとびと"],["は"],["川","かわ"],["の"],["中","なか"],["を"],["歩いて","あるいて"],["渡る","わたる"],["。"],["さあ"],["、"],["私たち","わたしたち"],["は"],["、"],["神","かみ"],["に"],["あって"],["喜ぼう","よろこぼう"],["。"]]},{"verse":7,"text":"神はその権力をもってとこしえに統べ治め、その目は国々を監視される。頑迷な者を、高ぶらせないでください。セラ","tok":[["神","かみ"],["は"],["その"],["権力","けんりょく"],["を"],["もって"],["とこしえ"],["に"],["統べ治め","すべおさめ"],["、"],["その"],["目","め"],["は"],["国々","くにぐに"],["を"],["監視","かんし"],["される"],["。"],["頑迷","がんめい"],["な"],["者","もの"],["を"],["、"],["高ぶらせないで","たかぶらせないで"],["ください"],["。"],["セラ"]]},{"verse":8,"text":"国々の民よ。私たちの神をほめたたえよ。神への賛美の声を聞こえさせよ。","tok":[["国々","くにぐに"],["の"],["民","たみ"],["よ"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"],["神","かみ"],["へ"],["の"],["賛美","さんび"],["の"],["声","こえ"],["を"],["聞こえさせ","きこえさせ"],["よ"],["。"]]},{"verse":9,"text":"神は、私たちを、いのちのうちに保ち、私たちの足をよろけさせない。","tok":[["神","かみ"],["は"],["、"],["私たち","わたしたち"],["を"],["、"],["いのち"],["の"],["うち"],["に"],["保ち","たもち"],["、"],["私たち","わたしたち"],["の"],["足","あし"],["を"],["よろけさせない"],["。"]]},{"verse":10,"text":"神よ。まことに、あなたは私たちを調べ、銀を精錬するように、私たちを練られました。","tok":[["神","かみ"],["よ"],["。"],["まこと"],["に"],["、"],["あなた"],["は"],["私たち","わたしたち"],["を"],["調べ","しらべ"],["、"],["銀","ぎん"],["を"],["精錬","せいれん"],["する"],["よう"],["に"],["、"],["私たち","わたしたち"],["を"],["練られました","ねられました"],["。"]]},{"verse":11,"text":"あなたは私たちを網に引き入れ、私たちの腰に重荷をつけられました。","tok":[["あなた"],["は"],["私たち","わたしたち"],["を"],["網","あみ"],["に"],["引き入れ","ひきいれ"],["、"],["私たち","わたしたち"],["の"],["腰","こし"],["に"],["重荷","おもに"],["を"],["つけられました"],["。"]]},{"verse":12,"text":"あなたは人々に、私たちの頭の上を乗り越えさせられました。私たちは、火の中を通り、水の中を通りました。しかし、あなたは豊かな所へ私たちを連れ出されました。","tok":[["あなた"],["は"],["人々","ひとびと"],["に"],["、"],["私たち","わたしたち"],["の"],["頭","あたま"],["の"],["上","うえ"],["を"],["乗り越えさせられました","のりこえさせられました"],["。"],["私たち","わたしたち"],["は"],["、"],["火","ひ"],["の"],["中","なか"],["を"],["通り","とおり"],["、"],["水","みず"],["の"],["中","なか"],["を"],["通りました","とおりました"],["。"],["しかし"],["、"],["あなた"],["は"],["豊か","ゆたか"],["な"],["所","ところ"],["へ"],["私たち","わたしたち"],["を"],["連れ出されました","つれだされました"],["。"]]},{"verse":13,"text":"私は全焼のいけにえを携えて、あなたの家に行き、私の誓いを果たします。","tok":[["私","わたくし"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["携えて","たずさえて"],["、"],["あなた"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["私","わたくし"],["の"],["誓い","ちかい"],["を"],["果たします","はたします"],["。"]]},{"verse":14,"text":"それは、私の苦しみのときに、私のくちびるが言ったもの、私の口が申し上げた誓いです。","tok":[["それ"],["は"],["、"],["私","わたくし"],["の"],["苦しみ","くるしみ"],["の"],["とき"],["に"],["、"],["私","わたくし"],["の"],["くちびる"],["が"],["言った","いった"],["もの"],["、"],["私","わたくし"],["の"],["口","くち"],["が"],["申し上げた","もうしあげた"],["誓い","ちかい"],["です"],["。"]]},{"verse":15,"text":"私はあ
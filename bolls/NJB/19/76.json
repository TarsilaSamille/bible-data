[{"verse":1,"text":"（指揮者のために。弦楽器によって。アサフの賛歌。歌）神はユダにおいて知られ、御名はイスラエルにおいて大きい。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["弦楽器","げんがっき"],["によって"],["。"],["アサフ"],["の"],["賛歌","さんか"],["。"],["歌","うた"],["）"],["神","かみ"],["は"],["ユダ"],["に"],["おいて"],["知られ","しられ"],["、"],["御名","ぎょめい"],["は"],["イスラエル"],["に"],["おいて"],["大きい","おおきい"],["。"]]},{"verse":2,"text":"神の仮庵はシャレムにあり、その住まいはシオンにある。","tok":[["神","かみ"],["の"],["仮庵","かりあん"],["は"],["シャレム"],["に"],["あり"],["、"],["その"],["住まい","すまい"],["は"],["シオン"],["に"],["ある"],["。"]]},{"verse":3,"text":"その所で神は弓につがえる火矢、盾と剣、また戦いを打ち砕かれた。セラ","tok":[["その"],["所","ところ"],["で"],["神","かみ"],["は"],["弓","ゆみ"],["に"],["つがえる"],["火矢","ひや"],["、"],["盾","たて"],["と"],["剣","けん"],["、"],["また"],["戦い","たたかい"],["を"],["打ち砕かれた","うちくだかれた"],["。"],["セラ"]]},{"verse":4,"text":"あなたは輝かしく、えじきの山々にまさって威厳があります。","tok":[["あなた"],["は"],["輝かしく","かがやかしく"],["、"],["えじき"],["の"],["山々","やまやま"],["に"],["まさって"],["威厳","いげん"],["が"],["あります"],["。"]]},{"verse":5,"text":"剛胆な者らは略奪に会い、彼らは全く眠りこけました。勇士たちはだれも、手の施しようがありませんでした。","tok":[["剛胆","ごうたん"],["な"],["者","もの"],["ら"],["は"],["略奪","りゃくだつ"],["に"],["会い","あい"],["、"],["彼","かれ"],["ら"],["は"],["全く","まったく"],["眠りこけました","ねむりこけました"],["。"],["勇士","ゆうし"],["たち"],["は"],["だれ"],["も"],["、"],["手","て"],["の"],["施し","ほどこし"],["よう"],["が"],["ありませんでした"],["。"]]},{"verse":6,"text":"ヤコブの神よ。あなたが、お叱りになると、騎手も馬も、深い眠りに陥りました。","tok":[["ヤコブ"],["の"],["神","かみ"],["よ"],["。"],["あなた"],["が"],["、"],["お叱り","おしかり"],["に"],["なる"],["と"],["、"],["騎手","きしゅ"],["も"],["馬","うま"],["も"],["、"],["深い","ふかい"],["眠り","ねむり"],["に"],["陥りました","おちいりました"],["。"]]},{"verse":7,"text":"あなたは、あなたは、恐ろしい方。あなたが怒られたら、だれが御前に立ちえましょう。","tok":[["あなた"],["は"],["、"],["あなた"],["は"],["、"],["恐ろしい","おそろしい"],["方","ほう"],["。"],["あなた"],["が"],["怒られたら","おこられたら"],["、"],["だれ"],["が"],["御前","ごぜん"],["に"],["立ち","たち"],["えましょう"],["。"]]},{"verse":8,"text":"あなたの宣告が天から聞こえると、地は恐れて、沈黙を守りました。","tok":[["あなた"],["の"],["宣告","せんこく"],["が"],["天","てん"],["から"],["聞こえる","きこえる"],["と"],["、"],["地","ち"],["は"],["恐れて","おそれて"],["、"],["沈黙","ちんもく"],["を"],["守りました","まもりました"],["。"]]},{"verse":9,"text":"神が、さばきのために、そして地上の貧しい者たちをみな、救うために、立ち上がられたそのときに。セラ","tok":[["神","かみ"],["が"],["、"],["さばき"],["の"],["ため"],["に"],["、"],["そして"],["地上","ちじょう"],["の"],["貧しい","まずしい"],["者","もの"],["たち"],["を"],["みな"],["、"],["救う","すくう"],["ため"],["に"],["、"],["立ち上がられた","たちあがられた"],["その"],["とき"],["に"],["。"],["セラ"]]},{"verse":10,"text":"まことに、人の憤りまでもが、あなたをほめたたえ、あなたは、憤りの余りまでをも身に締められます。","tok":[["まこと"],["に"],["、"],["人","ひと"],["の"],["憤り","いきどおり"],["まで"],["もが"],["、"],["あなた"],["を"],["ほめたたえ"],["、"],["あなた"],["は"],["、"],["憤り","いきどおり"],["の"],["余り","あまり"],["まで"],["を"],["も"],["身","み"],["に"],["締められます","しめられます"],["。"]]},{"verse":11,"text":"あなたがたの神、主に、誓いを立て、それを果たせ。主の回りにいる者はみな、恐るべき方に、贈り物をささげよ。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["誓い","ちかい"],["を"],["立て","たて"],["、"],["それ"],["を"],["果たせ","はたせ"],["。"],["主","ぬし"],["の"],["回り","まわり"],["に"],["いる"],["者","もの"],["は"],["みな"],["、"],["恐るべき","おそるべき"],["方","かた"],["に"],["、"],["贈り物","おくりもの"],["を"],["ささげ"],["よ"],["。"]]},{"verse":12,"text":"主は君主たちのいのちを絶たれる。地の王たちにとって、恐ろしい方。","tok":[["主","ぬし"],["は"],["君主","くんしゅ"],["たち"],["の"],["いのち"],["を"],["絶たれる","たたれる"],["。"],["地","ち"],["の"],["王","おう"],["たち"],["にとって"],["、"],["恐ろしい","おそろしい"],["方","ほう"],["。"]]}]
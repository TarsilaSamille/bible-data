[{"verse":1,"text":"（都上りの歌）苦しみのうちに、私が主に呼ばわると、主は私に答えられた。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["苦しみ","くるしみ"],["の"],["うち"],["に"],["、"],["私","わたくし"],["が"],["主に","おもに"],["呼ばわる","よばわる"],["と"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["答えられた","こたえられた"],["。"]]},{"verse":2,"text":"主よ。私を偽りのくちびる、欺きの舌から、救い出してください。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["を"],["偽り","いつわり"],["の"],["くちびる"],["、"],["欺き","あざむき"],["の"],["舌","した"],["から"],["、"],["救い出して","すくいだして"],["ください"],["。"]]},{"verse":3,"text":"欺きの舌よ。おまえに何が与えられ、おまえに何が加えられるのか。","tok":[["欺き","あざむき"],["の"],["舌","した"],["よ"],["。"],["おまえ"],["に"],["何","なん"],["が"],["与えられ","あたえられ"],["、"],["おまえ"],["に"],["何","なん"],["が"],["加えられる","くわえられる"],["の"],["か"],["。"]]},{"verse":4,"text":"勇士の鋭い矢、それに、えにしだの熱い炭火だ。","tok":[["勇士","ゆうし"],["の"],["鋭い","するどい"],["矢","や"],["、"],["それ"],["に"],["、"],["えにし"],["だ"],["の"],["熱い","あつい"],["炭火","すみび"],["だ"],["。"]]},{"verse":5,"text":"ああ、哀れな私よ。メシェクに寄留し、ケダルの天幕で暮らすとは。","tok":[["ああ"],["、"],["哀れ","あわれ"],["な"],["私","わたくし"],["よ"],["。"],["メシェク"],["に"],["寄留","きりゅう"],["し"],["、"],["ケダル"],["の"],["天幕","てんまく"],["で"],["暮らす","くらす"],["と"],["は"],["。"]]},{"verse":6,"text":"私は、久しく、平和を憎む者とともに住んでいた。","tok":[["私","わたくし"],["は"],["、"],["久しく","ひさしく"],["、"],["平和","へいわ"],["を"],["憎む","にくむ"],["者","もの"],["と"],["とも"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":7,"text":"私は平和を――、私が話すと、彼らは戦いを望むのだ。","tok":[["私","わたくし"],["は"],["平和","へいわ"],["を"],["―"],["―"],["、"],["私","わたくし"],["が"],["話す","はなす"],["と"],["、"],["彼","かれ"],["ら"],["は"],["戦い","たたかい"],["を"],["望む","のぞむ"],["の"],["だ"],["。"]]}]
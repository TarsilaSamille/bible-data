[{"verse":1,"text":"（ダビデによる）主は、私の光、私の救い。だれを私は恐れよう。主は、私のいのちのとりで。だれを私はこわがろう。","tok":[["（"],["ダビデ"],["に"],["よる"],["）"],["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["光","ひかり"],["、"],["私","わたくし"],["の"],["救い","すくい"],["。"],["だれ"],["を"],["私","わたくし"],["は"],["恐れよう","おそれよう"],["。"],["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["いのち"],["の"],["とり"],["で"],["。"],["だれ"],["を"],["私","わたくし"],["は"],["こわ"],["がろう"],["。"]]},{"verse":2,"text":"悪を行う者が私の肉を食らおうと、私に襲いかかったとき、私の仇、私の敵、彼らはつまずき、倒れた。","tok":[["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["が"],["私","わたくし"],["の"],["肉","にく"],["を"],["食らおう","くらおう"],["と"],["、"],["私","わたくし"],["に"],["襲いかかった","おそいかかった"],["とき"],["、"],["私","わたくし"],["の"],["仇","あだ"],["、"],["私","わたくし"],["の"],["敵","てき"],["、"],["彼","かれ"],["ら"],["は"],["つまずき"],["、"],["倒れた","たおれた"],["。"]]},{"verse":3,"text":"たとい、私に向かって陣営が張られても、私の心は恐れない。たとい、戦いが私に向かって起こっても、それにも、私は動じない。","tok":[["たとい"],["、"],["私","わたくし"],["に"],["向かって","むかって"],["陣営","じんえい"],["が"],["張られて","はられて"],["も"],["、"],["私","わたくし"],["の"],["心","こころ"],["は"],["恐れない","おそれない"],["。"],["たとい"],["、"],["戦い","たたかい"],["が"],["私","わたくし"],["に"],["向かって","むかって"],["起こって","おこって"],["も"],["、"],["それ"],["に"],["も"],["、"],["私","わたくし"],["は"],["動じない","どうじない"],["。"]]},{"verse":4,"text":"私は一つのことを主に願った。私はそれを求めている。私のいのちの日の限り、主の家に住むことを。主の麗しさを仰ぎ見、その宮で、思いにふける、そのために。","tok":[["私","わたくし"],["は"],["一","ひと"],["つ"],["の"],["こと"],["を"],["主に","おもに"],["願った","ねがった"],["。"],["私","わたくし"],["は"],["それ"],["を"],["求めて","もとめて"],["いる"],["。"],["私","わたくし"],["の"],["いのち"],["の"],["日","ひ"],["の"],["限り","かぎり"],["、"],["主","ぬし"],["の"],["家","いえ"],["に"],["住む","すむ"],["こと"],["を"],["。"],["主","ぬし"],["の"],["麗し","うるわし"],["さ"],["を"],["仰ぎ見","あおぎみ"],["、"],["その"],["宮","みや"],["で"],["、"],["思い","おもい"],["に"],["ふける"],["、"],["その"],["ため"],["に"],["。"]]},{"verse":5,"text":"それは、主が、悩みの日に私を隠れ場に隠し、その幕屋のひそかな所に私をかくまい、岩の上に私を上げてくださるからだ。","tok":[["それ"],["は"],["、"],["主","ぬし"],["が"],["、"],["悩み","なやみ"],["の"],["日","ひ"],["に"],["私","わたくし"],["を"],["隠れ場","かくれば"],["に"],["隠し","かくし"],["、"],["その"],["幕屋","まくや"],["の"],["ひそか"],["な"],["所","ところ"],["に"],["私","わたくし"],["を"],["かくまい"],["、"],["岩","いわ"],["の"],["上","うえ"],["に"],["私","わたくし"],["を"],["上げて","あげて"],["くださる"],["から"],["だ"],["。"]]},{"verse":6,"text":"今、私のかしらは、私を取り囲む敵の上に高く上げられる。私は、その幕屋で、喜びのいけにえをささげ、歌うたい、主に、ほめ歌を歌おう。","tok":[["今","いま"],["、"],["私","わたくし"],["の"],["かしら"],["は"],["、"],["私","わたくし"],["を"],["取り囲む","とりかこむ"],["敵","てき"],["の"],["上","うえ"],["に"],["高く","たかく"],["上げられる","あげられる"],["。"],["私","わたくし"],["は"],["、"],["その"],["幕屋","まくや"],["で"],["、"],["喜び","よろこび"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["歌うたい","うたうたい"],["、"],["主に","おもに"],["、"],["ほめ歌","ほめうた"],["を"],["歌おう","うたおう"],["。"]]},{"verse":7,"text":"聞いてください。主よ。私の呼ぶこの声を。私をあわれみ、私に答えてください。","tok":[["聞いて","きいて"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["呼ぶ","よぶ"],["この"],["声","こえ"],["を"],["。"],["私","わたくし"],["を"],["あわれみ"],["、"],["私","わたくし"],["に"],["答えて","こたえて"],["ください"],["。"]]},{"verse":8,"text":"あなたに代わって、私の心は申します。「わたしの顔を、慕い求めよ」と。主よ。あなたの御顔を私は慕い求めます。","tok":[["あなた"],["に"],["代わって","かわって"],["、"],["私","わたくし"],["の"],["心","こころ"],["は"],["申します","もうします"],["。"],["「"],["わたし"],["の"],["顔","かお"],["を"],["、"],["慕い求めよ","したいもとめよ"],["」"],["と"],["。"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["御顔","おかお"],["を"],["私","わたくし"],["は"],["慕い求めます","したいもとめます"],["。"]]},{"verse":9,"text":"どうか、御顔を私に隠さないでください。あなたのしもべを、怒って、押しのけないでください。あなたは私の助けです。私を見放さないでください。見捨てないでください。私の救いの神。","tok":[["どう"],["か"],["、"],["御顔","おかお"],["を"],["私","わたくし"],["に"],["隠さないで","かくさないで"],["ください"],["。"],["あなた"],["の"],["しもべ"],["を"],["、"],["怒って","おこって"],["、"],["押しのけないで","おしのけないで"],["ください"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["助け","たすけ"],["です"],["。"],["私","わたくし"],["を"],["見放さないで","みはなさないで"],["ください"],["。"],["見捨てないで","みすてないで"],["ください"],["。"],["私","わたくし"],["の"],["救い","すくい"],["の"],["神","かみ"],["。"]]},{"verse":10,"text":"私の父、私の母が、私を見捨てるときは、主が私を取り上げてくださる。","tok":[["私","わたくし"],["の"],["父","ちち"],["、"],["私","わたくし"],["の"],["母","はは"],["が"],["、"],["私","わたくし"],["を"],["見捨てる","みすてる"],["とき"],["は"],["、"],["主","ぬし"],["が"],["私","わたくし"],["を"],["取り上げて","とりあげて"],["くださる"],["。"]]},{"verse":11,"text":"主よ。あなたの道を私に教えてください。私を待ち伏せている者どもがおりますから、私を平らな小道に導いてください。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["道","みち"],["を"],["私","わたくし"],["に"],["教えて","おしえて"],["ください"],["。"],["私","わたくし"],["を"],["待ち伏せて","まちぶせて"],["いる"],["者","もの"],["ども"],["が"],["おります"],["から"],["、"],["私","わたくし"],["を"],["平ら","たいら"],["な"],["小道","こみち"],["に"],["導いて","みちびいて"],["ください"],["。"]]},{"verse":12,"text":"私を、私の仇の意のままに、させないでください。偽りの証人どもが私に立ち向かい、暴言を吐いているのです。","tok":[["私","わたくし"],["を"],["、"],["私","わたくし"],["の"],["仇","あだ"],["の"],["意","い"],["の"],["まま"],["に"],["、"],["させないで"],["ください"],["。"],["偽り","いつわり"],["の"],["証人","しょうにん"],["ども"],["が"],["私","わたくし"],["に"],["立ち向かい","たちむかい"],["、"],["暴言","ぼうげん"],["を"],["吐いて","はいて"],["いる"],["の"],["です"],["。"]]},{"verse":13,"text":"ああ、私に、生ける者の地で主のいつくしみを見ることが信じられなかったなら――","tok":[["ああ"],["、"],["私","わたくし"],["に"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["主","ぬし"],["の"],["いつくしみ"],["を"],["見る","みる"],["こと"],["が"],["信じられなかったなら","しんじられなかったなら"],["―"],["―"]]},{"verse":14,"text":"待ち望め。主を。雄々しくあれ。心を強くせよ。待ち望め。主を。","tok":[["待ち望め","まちのぞめ"],["。"],["主","ぬし"],["を"],["。"],["雄々しく","おおしく"],["あれ"],["。"],["心","こころ"],["を"],["強く","つよく"],["せよ"],["。"],["待ち望め","まちのぞめ"],["。"],["主","ぬし"],["を"],["。"]]}]
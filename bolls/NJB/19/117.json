[{"verse":1,"text":"すべての国々よ。主をほめたたえよ。すべての民よ。主をほめ歌え。","tok":[["すべて"],["の"],["国々","くにぐに"],["よ"],["。"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["すべて"],["の"],["民","たみ"],["よ"],["。"],["主","ぬし"],["を"],["ほめ"],["歌え","うたえ"],["。"]]},{"verse":2,"text":"その恵みは私たちに大きく、主のまことはとこしえに。ハレルヤ。","tok":[["その"],["恵み","めぐみ"],["は"],["私たち","わたしたち"],["に"],["大きく","おおきく"],["、"],["主","ぬし"],["の"],["まこと"],["は"],["とこしえ"],["に"],["。"],["ハレルヤ"],["。"]]}]
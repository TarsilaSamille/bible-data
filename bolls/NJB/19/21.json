[{"verse":1,"text":"（指揮者のために。ダビデの賛歌）主よ。王はあなたの御力を、喜びましょう。あなたの御救いをどんなに楽しむことでしょう。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["王","おう"],["は"],["あなた"],["の"],["御力","おちから"],["を"],["、"],["喜びましょう","よろこびましょう"],["。"],["あなた"],["の"],["御救い","おすくい"],["を"],["どんな"],["に"],["楽しむ","たのしむ"],["こと"],["でしょう"],["。"]]},{"verse":2,"text":"あなたは彼の心の願いをかなえ、彼のくちびるの願いを、退けられません。セラ","tok":[["あなた"],["は"],["彼","かれ"],["の"],["心","こころ"],["の"],["願い","ねがい"],["を"],["かなえ"],["、"],["彼","かれ"],["の"],["くちびる"],["の"],["願い","ねがい"],["を"],["、"],["退けられません","しりぞけられません"],["。"],["セラ"]]},{"verse":3,"text":"あなたは彼を迎えてすばらしい祝福を与え、彼のかしらに純金の冠を置かれます。","tok":[["あなた"],["は"],["彼","かれ"],["を"],["迎えて","むかえて"],["すばらしい"],["祝福","しゅくふく"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["の"],["かしら"],["に"],["純金","じゅんきん"],["の"],["冠","かんむり"],["を"],["置かれます","おかれます"],["。"]]},{"verse":4,"text":"彼はあなたに、いのちを請い求めました。あなたは彼に、とこしえまでの長い日々を与えられました。","tok":[["彼","かれ"],["は"],["あなた"],["に"],["、"],["いのち"],["を"],["請い求めました","こいもとめました"],["。"],["あなた"],["は"],["彼","かれ"],["に"],["、"],["とこしえ"],["まで"],["の"],["長い","ながい"],["日々","ひび"],["を"],["与えられました","あたえられました"],["。"]]},{"verse":5,"text":"御救いによって彼の栄光は、大きい。あなたは、尊厳と威光を彼の上に置かれます。","tok":[["御救い","おすくい"],["によって"],["彼","かれ"],["の"],["栄光","えいこう"],["は"],["、"],["大きい","おおきい"],["。"],["あなた"],["は"],["、"],["尊厳","そんげん"],["と"],["威光","いこう"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["置かれます","おかれます"],["。"]]},{"verse":6,"text":"あなたは、とこしえに彼を祝福し、御前の喜びで彼を楽しませてくださいます。","tok":[["あなた"],["は"],["、"],["とこしえ"],["に"],["彼","かれ"],["を"],["祝福","しゅくふく"],["し"],["、"],["御前","ごぜん"],["の"],["喜び","よろこび"],["で"],["彼","かれ"],["を"],["楽しませて","たのしませて"],["くださいます"],["。"]]},{"verse":7,"text":"まことに、王は主に信頼し、いと高き方の恵みによってゆるがないでしょう。","tok":[["まこと"],["に"],["、"],["王","おう"],["は"],["主に","おもに"],["信頼","しんらい"],["し"],["、"],["いと"],["高き","たかき"],["方","ほう"],["の"],["恵み","めぐみ"],["によって"],["ゆるがないでしょう"],["。"]]},{"verse":8,"text":"あなたの手は、あなたのすべての敵を見つけ出し、あなたの右の手は、あなたを憎む者どもを見つけ出します。","tok":[["あなた"],["の"],["手","て"],["は"],["、"],["あなた"],["の"],["すべて"],["の"],["敵","てき"],["を"],["見つけ","みつけ"],["出し","だし"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["、"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["ども"],["を"],["見つけ","みつけ"],["出します","だします"],["。"]]},{"verse":9,"text":"あなたの御怒りのとき、彼らを、燃える炉のようにされましょう。主は御怒りによって彼らをのみ尽くし、火は彼らを食い尽くすでしょう。","tok":[["あなた"],["の"],["御怒り","おいかり"],["の"],["とき"],["、"],["彼","かれ"],["ら"],["を"],["、"],["燃える","もえる"],["炉","ろ"],["の"],["よう"],["に"],["されましょう"],["。"],["主","ぬし"],["は"],["御怒り","おいかり"],["によって"],["彼","かれ"],["ら"],["を"],["のみ"],["尽くし","つくし"],["、"],["火","ひ"],["は"],["彼","かれ"],["ら"],["を"],["食い","くい"],["尽くすでしょう","つくすでしょう"],["。"]]},{"verse":10,"text":"あなたは、地の上から、彼らのすえを滅ぼされましょう。また、人の子らの中から、彼らの子孫をも。","tok":[["あなた"],["は"],["、"],["地","ち"],["の"],["上","うえ"],["から"],["、"],["彼","かれ"],["ら"],["の"],["すえ"],["を"],["滅ぼされましょう","ほろぼされましょう"],["。"],["また"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["から"],["、"],["彼","かれ"],["ら"],["の"],["子孫","しそん"],["を"],["も"],["。"]]},{"verse":11,"text":"彼らが、あなたに対して悪を企て、たくらみを設けたとしても、彼らには、できません。","tok":[["彼","かれ"],["ら"],["が"],["、"],["あなた"],["に対して","にたいして"],["悪","あく"],["を"],["企て","くわだて"],["、"],["たくらみ"],["を"],["設けた","もうけた"],["として"],["も"],["、"],["彼","かれ"],["ら"],["に"],["は"],["、"],["できません"],["。"]]},{"verse":12,"text":"あなたは彼らが背を見せるようにし、弓弦を張って彼らの顔をねらわれるでしょう。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["が"],["背","せ"],["を"],["見せる","みせる"],["よう"],["に"],["し"],["、"],["弓弦","ゆづる"],["を"],["張って","はって"],["彼","かれ"],["ら"],["の"],["顔","かお"],["を"],["ねらわれるでしょう"],["。"]]},{"verse":13,"text":"主よ。御力のゆえに、あなたがあがめられますように。私たちは歌い、あなたの威力をほめ歌います。","tok":[["主","ぬし"],["よ"],["。"],["御力","おちから"],["の"],["ゆえ"],["に"],["、"],["あなた"],["が"],["あがめられます"],["よう"],["に"],["。"],["私たち","わたしたち"],["は"],["歌い","うたい"],["、"],["あなた"],["の"],["威力","いりょく"],["を"],["ほめ"],["歌います","うたいます"],["。"]]}]
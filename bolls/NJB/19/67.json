[{"verse":1,"text":"（指揮者のために。弦楽器によって。賛歌。歌）どうか、神が私たちをあわれみ、祝福し、御顔を私たちの上に照り輝かしてくださるように。セラ","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["弦楽器","げんがっき"],["によって"],["。"],["賛歌","さんか"],["。"],["歌","うた"],["）"],["どう"],["か"],["、"],["神","かみ"],["が"],["私たち","わたしたち"],["を"],["あわれみ"],["、"],["祝福","しゅくふく"],["し"],["、"],["御顔","おかお"],["を"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["照り","てり"],["輝かして","かがやかして"],["くださる"],["よう"],["に"],["。"],["セラ"]]},{"verse":2,"text":"それは、あなたの道が地の上に、あなたの御救いがすべての国々の間に知られるためです。","tok":[["それ"],["は"],["、"],["あなた"],["の"],["道","みち"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["、"],["あなた"],["の"],["御救い","おすくい"],["が"],["すべて"],["の"],["国々","くにぐに"],["の"],["間","あいだ"],["に"],["知られる","しられる"],["ため"],["です"],["。"]]},{"verse":3,"text":"神よ。国々の民があなたをほめたたえ、国々の民がこぞってあなたをほめたたえますように。","tok":[["神","かみ"],["よ"],["。"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["あなた"],["を"],["ほめたたえ"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["こぞって"],["あなた"],["を"],["ほめたたえます"],["よう"],["に"],["。"]]},{"verse":4,"text":"国民が喜び、また、喜び歌いますように。それはあなたが公正をもって国々の民をさばかれ、地の国民を導かれるからです。セラ","tok":[["国民","こくみん"],["が"],["喜び","よろこび"],["、"],["また"],["、"],["喜び歌います","よろこびうたいます"],["よう"],["に"],["。"],["それ"],["は"],["あなた"],["が"],["公正","こうせい"],["を"],["もって"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["さばかれ"],["、"],["地","ち"],["の"],["国民","こくみん"],["を"],["導かれる","みちびかれる"],["から"],["です"],["。"],["セラ"]]},{"verse":5,"text":"神よ。国々の民があなたをほめたたえ、国々の民がこぞってあなたをほめたたえますように。","tok":[["神","かみ"],["よ"],["。"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["あなた"],["を"],["ほめたたえ"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["こぞって"],["あなた"],["を"],["ほめたたえます"],["よう"],["に"],["。"]]},{"verse":6,"text":"地はその産物を出しました。神、私たちの神が、私たちを祝福してくださいますように。","tok":[["地","ち"],["は"],["その"],["産物","さんぶつ"],["を"],["出しました","だしました"],["。"],["神","かみ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["が"],["、"],["私たち","わたしたち"],["を"],["祝福","しゅくふく"],["して"],["くださいます"],["よう"],["に"],["。"]]},{"verse":7,"text":"神が私たちを祝福してくださって、地の果て果てが、ことごとく神を恐れますように。","tok":[["神","かみ"],["が"],["私たち","わたしたち"],["を"],["祝福","しゅくふく"],["して"],["くださって"],["、"],["地","ち"],["の"],["果て果て","はてはて"],["が"],["、"],["ことごとく"],["神","かみ"],["を"],["恐れます","おそれます"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"（賛歌）新しい歌を主に歌え。主は、奇しいわざをなさった。その右の御手と、その聖なる御腕とが、主に勝利をもたらしたのだ。","tok":[["（"],["賛歌","さんか"],["）"],["新しい","あたらしい"],["歌","うた"],["を"],["主に","おもに"],["歌え","うたえ"],["。"],["主","ぬし"],["は"],["、"],["奇しい","くすしい"],["わざ"],["を"],["なさった"],["。"],["その"],["右","みぎ"],["の"],["御手","おて"],["と"],["、"],["その"],["聖","せい"],["なる"],["御腕","おうで"],["と"],["が"],["、"],["主に","おもに"],["勝利","しょうり"],["を"],["もたらした"],["の"],["だ"],["。"]]},{"verse":2,"text":"主は御救いを知らしめ、その義を国々の前に現された。","tok":[["主","ぬし"],["は"],["御救い","おすくい"],["を"],["知らしめ","しらしめ"],["、"],["その"],["義","ぎ"],["を"],["国々","くにぐに"],["の"],["前","まえ"],["に"],["現された","あらわされた"],["。"]]},{"verse":3,"text":"主はイスラエルの家への恵みと真実を覚えておられる。地の果て果てまでもが、みな、われらの神の救いを見ている。","tok":[["主","ぬし"],["は"],["イスラエル"],["の"],["家","いえ"],["へ"],["の"],["恵み","めぐみ"],["と"],["真実","しんじつ"],["を"],["覚えて","おぼえて"],["おられる"],["。"],["地","ち"],["の"],["果て果て","はてはて"],["まで"],["もが"],["、"],["みな"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["救い","すくい"],["を"],["見て","みて"],["いる"],["。"]]},{"verse":4,"text":"全地よ。主に喜び叫べ。大声で叫び、喜び歌い、ほめ歌を歌え。","tok":[["全地","ぜんち"],["よ"],["。"],["主に","おもに"],["喜び叫べ","よろこびさけべ"],["。"],["大声","おおごえ"],["で"],["叫び","さけび"],["、"],["喜び歌い","よろこびうたい"],["、"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"]]},{"verse":5,"text":"立琴に合わせて、主にほめ歌を歌え。立琴と歌の調べに合わせて。","tok":[["立琴","たてごと"],["に"],["合わせて","あわせて"],["、"],["主に","おもに"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"],["立琴","たてごと"],["と"],["歌","うた"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"]]},{"verse":6,"text":"ラッパと角笛の音に合わせて、主である王の御前で喜び叫べ。","tok":[["ラッパ"],["と"],["角笛","つのぶえ"],["の"],["音","おと"],["に"],["合わせて","あわせて"],["、"],["主","ぬし"],["で"],["ある"],["王","おう"],["の"],["御前","ごぜん"],["で"],["喜び叫べ","よろこびさけべ"],["。"]]},{"verse":7,"text":"海と、それに満ちているもの。世界と、その中に住むものよ。鳴りとどろけ。","tok":[["海","うみ"],["と"],["、"],["それ"],["に"],["満ちて","みちて"],["いる"],["もの"],["。"],["世界","せかい"],["と"],["、"],["その"],["中","なか"],["に"],["住む","すむ"],["もの"],["よ"],["。"],["鳴り","なり"],["とどろけ"],["。"]]},{"verse":8,"text":"もろもろの川よ。手を打ち鳴らせ。山々も、こぞって主の御前で喜び歌え。","tok":[["もろもろ"],["の"],["川","かわ"],["よ"],["。"],["手","て"],["を"],["打ち鳴らせ","うちならせ"],["。"],["山々","やまやま"],["も"],["、"],["こぞって"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["喜び歌え","よろこびうたえ"],["。"]]},{"verse":9,"text":"確かに、主は地をさばくために来られる。主は義をもって世界をさばき、公正をもって国々の民を、さばかれる。","tok":[["確か","たしか"],["に"],["、"],["主","ぬし"],["は"],["地","ち"],["を"],["さばく"],["ため"],["に"],["来られる","こられる"],["。"],["主","ぬし"],["は"],["義","ぎ"],["を"],["もって"],["世界","せかい"],["を"],["さばき"],["、"],["公正","こうせい"],["を"],["もって"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["、"],["さばかれる"],["。"]]}]
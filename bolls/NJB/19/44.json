[{"verse":1,"text":"（指揮者のために。コラの子たちのマスキール）神よ。私たちはこの耳で、先祖たちが語ってくれたことを聞きました。あなたが昔、彼らの時代になさったみわざを。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["コラ"],["の"],["子","こ"],["たち"],["の"],["マスキール"],["）"],["神","かみ"],["よ"],["。"],["私たち","わたしたち"],["は"],["この"],["耳","みみ"],["で"],["、"],["先祖","せんぞ"],["たち"],["が"],["語って","かたって"],["くれた"],["こと"],["を"],["聞きました","ききました"],["。"],["あなた"],["が"],["昔","むかし"],["、"],["彼","かれ"],["ら"],["の"],["時代","じだい"],["に"],["なさった"],["みわざ"],["を"],["。"]]},{"verse":2,"text":"あなたは御手をもって、国々を追い払い、そこに彼らを植え、国民にわざわいを与え、そこに彼らを送り込まれました。","tok":[["あなた"],["は"],["御手","おて"],["を"],["もって"],["、"],["国々","くにぐに"],["を"],["追い払い","おいはらい"],["、"],["そこ"],["に"],["彼","かれ"],["ら"],["を"],["植え","うえ"],["、"],["国民","こくみん"],["に"],["わざわい"],["を"],["与え","あたえ"],["、"],["そこ"],["に"],["彼","かれ"],["ら"],["を"],["送り込まれました","おくりこまれました"],["。"]]},{"verse":3,"text":"彼らは、自分の剣によって地を得たのでもなく、自分の腕が彼らを救ったのでもありません。ただあなたの右の手、あなたの腕、あなたの御顔の光が、そうしたのです。あなたが彼らを愛されたからです。","tok":[["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["の"],["剣","けん"],["によって"],["地","ち"],["を"],["得た","えた"],["ので"],["も"],["なく"],["、"],["自分","じぶん"],["の"],["腕","うで"],["が"],["彼","かれ"],["ら"],["を"],["救った","すくった"],["ので"],["も"],["ありません"],["。"],["ただ"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["、"],["あなた"],["の"],["腕","うで"],["、"],["あなた"],["の"],["御顔","おかお"],["の"],["光","ひかり"],["が"],["、"],["そう"],["した"],["の"],["です"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["愛された","あいされた"],["から"],["です"],["。"]]},{"verse":4,"text":"神よ。あなたこそ私の王です。ヤコブの勝利を命じてください。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["こそ"],["私","わたくし"],["の"],["王","おう"],["です"],["。"],["ヤコブ"],["の"],["勝利","しょうり"],["を"],["命じて","めいじて"],["ください"],["。"]]},{"verse":5,"text":"あなたによって私たちは、敵を押し返し、御名によって私たちに立ち向かう者どもを踏みつけましょう。","tok":[["あなた"],["によって"],["私たち","わたしたち"],["は"],["、"],["敵","てき"],["を"],["押し返し","おしかえし"],["、"],["御名","ぎょめい"],["によって"],["私たち","わたしたち"],["に"],["立ち向かう","たちむかう"],["者","もの"],["ども"],["を"],["踏みつけましょう","ふみつけましょう"],["。"]]},{"verse":6,"text":"私は私の弓にたよりません。私の剣も私を救いません。","tok":[["私","わたくし"],["は"],["私","わたくし"],["の"],["弓","ゆみ"],["に"],["たよりません"],["。"],["私","わたくし"],["の"],["剣","けん"],["も"],["私","わたくし"],["を"],["救いません","すくいません"],["。"]]},{"verse":7,"text":"しかしあなたは、敵から私たちを救い、私たちを憎む者らをはずかしめなさいました。","tok":[["しかし"],["あなた"],["は"],["、"],["敵","てき"],["から"],["私たち","わたしたち"],["を"],["救い","すくい"],["、"],["私たち","わたしたち"],["を"],["憎む","にくむ"],["者","もの"],["ら"],["を"],["はずかしめ"],["なさいました"],["。"]]},{"verse":8,"text":"私たちはいつも神によって誇りました。また、あなたの御名をとこしえにほめたたえます。セラ","tok":[["私たち","わたしたち"],["は"],["いつも"],["神","かみ"],["によって"],["誇りました","ほこりました"],["。"],["また"],["、"],["あなた"],["の"],["御名","ぎょめい"],["を"],["とこしえ"],["に"],["ほめたたえます"],["。"],["セラ"]]},{"verse":9,"text":"それなのに、あなたは私たちを拒み、卑しめました。あなたはもはや、私たちの軍勢とともに出陣なさいません。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["は"],["私たち","わたしたち"],["を"],["拒み","こばみ"],["、"],["卑しめました","いやしめました"],["。"],["あなた"],["は"],["もはや"],["、"],["私たち","わたしたち"],["の"],["軍勢","ぐんぜい"],["と"],["とも"],["に"],["出陣","しゅつじん"],["なさいません"],["。"]]},{"verse":10,"text":"あなたは私たちを敵から退かせ、私たちを憎む者らは思うままにかすめ奪いました。","tok":[["あなた"],["は"],["私たち","わたしたち"],["を"],["敵","てき"],["から"],["退かせ","しりぞかせ"],["、"],["私たち","わたしたち"],["を"],["憎む","にくむ"],["者","もの"],["ら"],["は"],["思う","おもう"],["まま"],["に"],["かすめ"],["奪いました","うばいました"],["。"]]},{"verse":11,"text":"あなたは私たちを食用の羊のようにし、国々の中に私たちを散らされました。","tok":[["あなた"],["は"],["私たち","わたしたち"],["を"],["食用","しょくよう"],["の"],["羊","ひつじ"],["の"],["よう"],["に"],["し"],["、"],["国々","くにぐに"],["の"],["中","なか"],["に"],["私たち","わたしたち"],["を"],["散らされました","ちらされました"],["。"]]},{"verse":12,"text":"あなたはご自分の民を安値で売り、その代価で何の得もなさいませんでした。","tok":[["あなた"],["は"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["安値","やすね"],["で"],["売り","うり"],["、"],["その"],["代価","だいか"],["で"],["何","なん"],["の"],["得","とく"],["も"],["なさいませんでした"],["。"]]},{"verse":13,"text":"あなたは私たちを、隣人のそしりとし、回りの者のあざけりとし、笑いぐさとされます。","tok":[["あなた"],["は"],["私たち","わたしたち"],["を"],["、"],["隣人","りんじん"],["の"],["そしり"],["と"],["し"],["、"],["回り","まわり"],["の"],["者","もの"],["の"],["あざけり"],["と"],["し"],["、"],["笑いぐさ","わらいぐさ"],["と"],["されます"],["。"]]},{"verse":14,"text":"あなたは私たちを国々の中で物笑いの種とし、民の中で笑い者とされるのです。","tok":[["あなた"],["は"],["私たち","わたしたち"],["を"],["国々","くにぐに"],["の"],["中","なか"],["で"],["物笑い","ものわらい"],["の"],["種","しゅ"],["と"],["し"],["、"],["民","みん"],["の"],["中","なか"],["で"],["笑い者","わらいもの"],["と"],["される"],["の"],["です"],["。"]]},{"verse":15,"text":"私の前には、一日中、はずかしめがあって、私の顔の恥が私をおおってしまいました。","tok":[["私","わたくし"],["の"],["前","まえ"],["に"],["は"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["はずかしめ"],["が"],["あって"],["、"],["私","わたくし"],["の"],["顔","かお"],["の"],["恥","はじ"],["が"],["私","わたくし"],["を"],["おおって"],["しまいました"],["。"]]},{"verse":16,"text":"それはそしる者とののしる者の声のため、敵と復讐者のためでした。","tok":[["それ"],["は"],["そしる"],["者","もの"],["と"],["ののしる"],["者","もの"],["の"],["声","こえ"],["の"],["ため"],["、"],["敵","てき"],["と"],["復讐者","ふくしゅうしゃ"],["の"],["ため"],["でした"],["。"]]},{"verse":17,"text":"これらのことすべてが私たちを襲いました。しかし私たちはあなたを忘れませんでした。また、あなたの契約を無にしませんでした。","tok":[["これ"],["ら"],["の"],["こと"],["すべて"],["が"],["私たち","わたしたち"],["を"],["襲いました","おそいました"],["。"],["しかし"],["私たち","わたしたち"],["は"],["あなた"],["を"],["忘れませんでした","わすれませんでした"],["。"],["また"],["、"],["あなた"],["の"],["契約","けいやく"],["を"],["無","む"],["に"],["しませんでした"],["。"]]},{"verse":18,"text":"私たちの心はたじろがず、私たちの歩みはあなたの道からそれませんでした。","tok":[["私たち","わたしたち"],["の"],["心","こころ"],["は"],["たじろがず"],["、"],["私たち","わたしたち"],["の"],["歩み","あゆみ"],["は"],["あなた"],["の"],["道","みち"],["から"],["それませんでした"],["。"]]},{"verse":19,"text":"しかも、あなたはジャッカルの住む所で私たちを砕き、死の陰で私たちをおおわれたのです。","tok":[["しかも"],["、"],["あなた"],["は"],["ジャッカル"],["の"],["住む","すむ"],["所","ところ"],["で"],["私たち","わたしたち"],["を"],["砕き","くだき"],["、"],["死","し"],["の"],["陰","かげ"],["で"],["私たち","わたしたち"],["を"],["おおわれた"],["の"],["です"],["。"]]},{"verse":20,"text":"もし、私たちが私たちの神の名を忘れ、ほかの神に私たちの手を差し伸ばしたなら、","tok":[["もし"],["、"],["私たち","わたしたち"],["が"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["名","な"],["を"],["忘れ","わすれ"],["、"],["ほか"],["の"],["神","かみ"],["に"],["私たち","わたしたち"],["の"],["手","て"],["を"],["差し伸ばしたなら","さしのばしたなら"],["、"]]},{"verse":21,"text":"神はこれを探り出されないでしょうか。神は心の秘密を知っておられるからです。","tok":[["神","かみ"],["は"],["これ"],["を"],["探り出されないでしょう","さぐりだされないでしょう"],["か"],["。"],["神","かみ"],["は"],["心","こころ"],["の"],["秘密","ひみつ"],["を"],["知って","しって"],["おられる"],["から"],["です"],["。"]]},{"ve
[{"verse":1,"text":"（指揮者エドトンのために。ダビデの賛歌）私は言った。私は自分の道に気をつけよう。私が舌で罪を犯さないために。私の口に口輪をはめておこう。悪者が私の前にいる間は。","tok":[["（"],["指揮者","しきしゃ"],["エドトン"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["私","わたくし"],["は"],["言った","いった"],["。"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["道","みち"],["に"],["気","き"],["を"],["つけよう"],["。"],["私","わたくし"],["が"],["舌","した"],["で"],["罪","つみ"],["を"],["犯さない","おかさない"],["ため"],["に"],["。"],["私","わたくし"],["の"],["口","くち"],["に"],["口輪","くちわ"],["を"],["はめて"],["おこう"],["。"],["悪者","わるもの"],["が"],["私","わたくし"],["の"],["前","まえ"],["に"],["いる"],["間","あいだ"],["は"],["。"]]},{"verse":2,"text":"私はひたすら沈黙を守った。よいことにさえ、黙っていた。それで私の痛みは激しくなった。","tok":[["私","わたくし"],["は"],["ひたすら"],["沈黙","ちんもく"],["を"],["守った","まもった"],["。"],["よい"],["こと"],["に"],["さえ"],["、"],["黙って","だまって"],["いた"],["。"],["それ"],["で"],["私","わたくし"],["の"],["痛み","いたみ"],["は"],["激しく","はげしく"],["なった"],["。"]]},{"verse":3,"text":"私の心は私のうちで熱くなり、私がうめく間に、火は燃え上がった。そこで私は自分の舌で、こう言った。","tok":[["私","わたくし"],["の"],["心","こころ"],["は"],["私","わたくし"],["の"],["うち"],["で"],["熱く","あつく"],["なり"],["、"],["私","わたくし"],["が"],["うめく"],["間","あいだ"],["に"],["、"],["火","ひ"],["は"],["燃え上がった","もえあがった"],["。"],["そこ"],["で"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["舌","した"],["で"],["、"],["こう"],["言った","いった"],["。"]]},{"verse":4,"text":"主よ。お知らせください。私の終わり、私の齢が、どれだけなのか。私が、どんなに、はかないかを知ることができるように。","tok":[["主","ぬし"],["よ"],["。"],["お知らせ","おしらせ"],["ください"],["。"],["私","わたくし"],["の"],["終わり","おわり"],["、"],["私","わたくし"],["の"],["齢","とし"],["が"],["、"],["どれ"],["だけ"],["な"],["の"],["か"],["。"],["私","わたくし"],["が"],["、"],["どんな"],["に"],["、"],["はかない"],["か"],["を"],["知る","しる"],["こと"],["が"],["できる"],["よう"],["に"],["。"]]},{"verse":5,"text":"ご覧ください。あなたは私の日を手幅ほどにされました。私の一生は、あなたの前では、ないのも同然です。まことに、人はみな、盛んなときでも、全くむなしいものです。セラ","tok":[["ご覧","ごらん"],["ください"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["日","ひ"],["を"],["手幅","てはば"],["ほど"],["に"],["されました"],["。"],["私","わたくし"],["の"],["一生","いっしょう"],["は"],["、"],["あなた"],["の"],["前","まえ"],["で"],["は"],["、"],["ない"],["の"],["も"],["同然","どうぜん"],["です"],["。"],["まこと"],["に"],["、"],["人","ひと"],["は"],["みな"],["、"],["盛ん","さかん"],["な"],["とき"],["で"],["も"],["、"],["全く","まったく"],["むなしい"],["もの"],["です"],["。"],["セラ"]]},{"verse":6,"text":"まことに、人は幻のように歩き回り、まことに、彼らはむなしく立ち騒ぎます。人は、積みたくわえるが、だれがそれを集めるのかを知りません。","tok":[["まこと"],["に"],["、"],["人","ひと"],["は"],["幻","まぼろし"],["の"],["よう"],["に"],["歩き回り","あるきまわり"],["、"],["まこと"],["に"],["、"],["彼","かれ"],["ら"],["は"],["むなしく"],["立ち騒ぎます","たちさわぎます"],["。"],["人","ひと"],["は"],["、"],["積み","つみ"],["たくわえる"],["が"],["、"],["だれ"],["が"],["それ"],["を"],["集める","あつめる"],["の"],["か"],["を"],["知りません","しりません"],["。"]]},{"verse":7,"text":"主よ。今、私は何を待ち望みましょう。私の望み、それはあなたです。","tok":[["主","ぬし"],["よ"],["。"],["今","いま"],["、"],["私","わたくし"],["は"],["何","なん"],["を"],["待ち望みましょう","まちのぞみましょう"],["。"],["私","わたくし"],["の"],["望み","のぞみ"],["、"],["それ"],["は"],["あなた"],["です"],["。"]]},{"verse":8,"text":"私のすべてのそむきの罪から私を助け出してください。私を愚か者のそしりとしないでください。","tok":[["私","わたくし"],["の"],["すべて"],["の"],["そむき"],["の"],["罪","つみ"],["から"],["私","わたくし"],["を"],["助け出して","たすけだして"],["ください"],["。"],["私","わたくし"],["を"],["愚か者","おろかもの"],["の"],["そしり"],["と"],["しないで"],["ください"],["。"]]},{"verse":9,"text":"私は黙し、口を開きません。あなたが、そうなさったからです。","tok":[["私","わたくし"],["は"],["黙し","もくし"],["、"],["口","くち"],["を"],["開きません","ひらきません"],["。"],["あなた"],["が"],["、"],["そう"],["なさった"],["から"],["です"],["。"]]},{"verse":10,"text":"どうか、あなたのむちを私から取り除いてください。あなたの手に打たれて、私は衰え果てました。","tok":[["どう"],["か"],["、"],["あなた"],["の"],["むち"],["を"],["私","わたくし"],["から"],["取り除いて","とりのぞいて"],["ください"],["。"],["あなた"],["の"],["手","て"],["に"],["打たれて","うたれて"],["、"],["私","わたくし"],["は"],["衰え","おとろえ"],["果てました","はてました"],["。"]]},{"verse":11,"text":"あなたは、不義を責めて人を懲らしめ、その人の望むものを、しみが食うように、なくしてしまわれます。まことに、人はみな、むなしいものです。セラ","tok":[["あなた"],["は"],["、"],["不義","ふぎ"],["を"],["責めて","せめて"],["人","ひと"],["を"],["懲らしめ","こらしめ"],["、"],["その"],["人","ひと"],["の"],["望む","のぞむ"],["もの"],["を"],["、"],["しみ"],["が"],["食う","くう"],["よう"],["に"],["、"],["なくして"],["しまわれます"],["。"],["まこと"],["に"],["、"],["人","ひと"],["は"],["みな"],["、"],["むなしい"],["もの"],["です"],["。"],["セラ"]]},{"verse":12,"text":"私の祈りを聞いてください。主よ。私の叫びを耳に入れてください。私の涙に、黙っていないでください。私はあなたとともにいる旅人で、私のすべての先祖たちのように、寄留の者なのです。","tok":[["私","わたくし"],["の"],["祈り","いのり"],["を"],["聞いて","きいて"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["叫び","さけび"],["を"],["耳","みみ"],["に"],["入れて","いれて"],["ください"],["。"],["私","わたくし"],["の"],["涙","なみだ"],["に"],["、"],["黙って","だまって"],["いないで"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["と"],["とも"],["に"],["いる"],["旅人","たびびと"],["で"],["、"],["私","わたくし"],["の"],["すべて"],["の"],["先祖","せんぞ"],["たち"],["の"],["よう"],["に"],["、"],["寄留","きりゅう"],["の"],["者","もの"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"私を見つめないでください。私が去って、いなくなる前に、私がほがらかになれるように。","tok":[["私","わたくし"],["を"],["見つめないで","みつめないで"],["ください"],["。"],["私","わたくし"],["が"],["去って","さって"],["、"],["いなく"],["なる"],["前","まえ"],["に"],["、"],["私","わたくし"],["が"],["ほがらか"],["に"],["なれる"],["よう"],["に"],["。"]]}]
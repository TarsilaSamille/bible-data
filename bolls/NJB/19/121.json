[{"verse":1,"text":"（都上りの歌）私は山に向かって目を上げる。私の助けは、どこから来るのだろうか。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["私","わたくし"],["は"],["山","やま"],["に"],["向かって","むかって"],["目","め"],["を"],["上げる","あげる"],["。"],["私","わたくし"],["の"],["助け","たすけ"],["は"],["、"],["どこ"],["から"],["来る","くる"],["の"],["だろう"],["か"],["。"]]},{"verse":2,"text":"私の助けは、天地を造られた主から来る。","tok":[["私","わたくし"],["の"],["助け","たすけ"],["は"],["、"],["天地","てんち"],["を"],["造られた","つくられた"],["主","ぬし"],["から"],["来る","くる"],["。"]]},{"verse":3,"text":"主はあなたの足をよろけさせず、あなたを守る方は、まどろむこともない。","tok":[["主","ぬし"],["は"],["あなた"],["の"],["足","あし"],["を"],["よろけさせず"],["、"],["あなた"],["を"],["守る","まもる"],["方","かた"],["は"],["、"],["まどろむ"],["こと"],["も"],["ない"],["。"]]},{"verse":4,"text":"見よ。イスラエルを守る方は、まどろむこともなく、眠ることもない。","tok":[["見","み"],["よ"],["。"],["イスラエル"],["を"],["守る","まもる"],["方","かた"],["は"],["、"],["まどろむ"],["こと"],["も"],["なく"],["、"],["眠る","ねむる"],["こと"],["も"],["ない"],["。"]]},{"verse":5,"text":"主は、あなたを守る方。主は、あなたの右の手をおおう陰。","tok":[["主","ぬし"],["は"],["、"],["あなた"],["を"],["守る","まもる"],["方","かた"],["。"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["おおう"],["陰","かげ"],["。"]]},{"verse":6,"text":"昼も、日が、あなたを打つことがなく、夜も、月が、あなたを打つことはない。","tok":[["昼","ひる"],["も"],["、"],["日","ひ"],["が"],["、"],["あなた"],["を"],["打つ","うつ"],["こと"],["が"],["なく"],["、"],["夜","よる"],["も"],["、"],["月","つき"],["が"],["、"],["あなた"],["を"],["打つ","うつ"],["こと"],["は"],["ない"],["。"]]},{"verse":7,"text":"主は、すべてのわざわいから、あなたを守り、あなたのいのちを守られる。","tok":[["主","ぬし"],["は"],["、"],["すべて"],["の"],["わざわい"],["から"],["、"],["あなた"],["を"],["守り","まもり"],["、"],["あなた"],["の"],["いのち"],["を"],["守られる","まもられる"],["。"]]},{"verse":8,"text":"主は、あなたを、行くにも帰るにも、今よりとこしえまでも守られる。","tok":[["主","ぬし"],["は"],["、"],["あなた"],["を"],["、"],["行く","いく"],["に"],["も"],["帰る","かえる"],["に"],["も"],["、"],["今","いま"],["より"],["とこしえ"],["まで"],["も"],["守られる","まもられる"],["。"]]}]
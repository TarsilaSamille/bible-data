[{"verse":1,"text":"（ダビデの祈り）主よ。聞いてください、正しい訴えを。耳に留めてください、私の叫びを。耳に入れてください、欺きのくちびるからでない私の祈りを。","tok":[["（"],["ダビデ"],["の"],["祈り","いのり"],["）"],["主","ぬし"],["よ"],["。"],["聞いて","きいて"],["ください"],["、"],["正しい","ただしい"],["訴え","うったえ"],["を"],["。"],["耳","みみ"],["に"],["留めて","とめて"],["ください"],["、"],["私","わたくし"],["の"],["叫び","さけび"],["を"],["。"],["耳","みみ"],["に"],["入れて","いれて"],["ください"],["、"],["欺き","あざむき"],["の"],["くちびる"],["から"],["で"],["ない"],["私","わたくし"],["の"],["祈り","いのり"],["を"],["。"]]},{"verse":2,"text":"私のためのさばきが御前から出て、公正に御目が注がれますように。","tok":[["私","わたくし"],["の"],["ため"],["の"],["さばき"],["が"],["御前","ごぜん"],["から"],["出て","でて"],["、"],["公正","こうせい"],["に"],["御目","おめ"],["が"],["注がれます","そそがれます"],["よう"],["に"],["。"]]},{"verse":3,"text":"あなたは私の心を調べ、夜、私を問いただされました。あなたは私をためされましたが、何も見つけ出されません。私は、口のあやまちをしまいと心がけました。","tok":[["あなた"],["は"],["私","わたくし"],["の"],["心","こころ"],["を"],["調べ","しらべ"],["、"],["夜","よる"],["、"],["私","わたくし"],["を"],["問いただされました","といただされました"],["。"],["あなた"],["は"],["私","わたくし"],["を"],["ためされました"],["が"],["、"],["何","なん"],["も"],["見つけ","みつけ"],["出されません","だされません"],["。"],["私","わたくし"],["は"],["、"],["口","くち"],["の"],["あやまち"],["を"],["しまい"],["と"],["心がけました","こころがけました"],["。"]]},{"verse":4,"text":"人としての行いについては、あなたのくちびるのことばによりました。私は無法な者の道を避けました。","tok":[["人","ひと"],["として"],["の"],["行い","おこない"],["について"],["は"],["、"],["あなた"],["の"],["くちびる"],["の"],["ことば"],["に"],["よりました"],["。"],["私","わたくし"],["は"],["無法","むほう"],["な"],["者","もの"],["の"],["道","みち"],["を"],["避けました","さけました"],["。"]]},{"verse":5,"text":"私の歩みは、あなたの道を堅く守り、私の足はよろけませんでした。","tok":[["私","わたくし"],["の"],["歩み","あゆみ"],["は"],["、"],["あなた"],["の"],["道","みち"],["を"],["堅く","かたく"],["守り","まもり"],["、"],["私","わたくし"],["の"],["足","あし"],["は"],["よろけませんでした"],["。"]]},{"verse":6,"text":"神よ。私はあなたを呼び求めました。あなたは私に答えてくださるからです。耳を傾けて、私の申し上げることを聞いてください。","tok":[["神","かみ"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["呼び求めました","よびもとめました"],["。"],["あなた"],["は"],["私","わたくし"],["に"],["答えて","こたえて"],["くださる"],["から"],["です"],["。"],["耳","みみ"],["を"],["傾けて","かたむけて"],["、"],["私","わたくし"],["の"],["申し上げる","もうしあげる"],["こと"],["を"],["聞いて","きいて"],["ください"],["。"]]},{"verse":7,"text":"あなたの奇しい恵みをお示しください。立ち向かう者から身を避けて右の手に来る者を救う方。","tok":[["あなた"],["の"],["奇しい","くすしい"],["恵み","めぐみ"],["を"],["お示し","おしめし"],["ください"],["。"],["立ち向かう","たちむかう"],["者","もの"],["から"],["身","み"],["を"],["避けて","さけて"],["右","みぎ"],["の"],["手","て"],["に"],["来る","くる"],["者","もの"],["を"],["救う","すくう"],["方","かた"],["。"]]},{"verse":8,"text":"私を、ひとみのように見守り、御翼の陰に私をかくまってください。","tok":[["私","わたくし"],["を"],["、"],["ひとみ"],["の"],["よう"],["に"],["見守り","みまもり"],["、"],["御翼","おつばさ"],["の"],["陰","かげ"],["に"],["私","わたくし"],["を"],["かくまって"],["ください"],["。"]]},{"verse":9,"text":"私を襲う悪者から。私を取り巻く貪欲な敵から。","tok":[["私","わたくし"],["を"],["襲う","おそう"],["悪者","わるもの"],["から"],["。"],["私","わたくし"],["を"],["取り巻く","とりまく"],["貪欲","どんよく"],["な"],["敵","てき"],["から"],["。"]]},{"verse":10,"text":"彼らは、鈍い心を堅く閉ざし、その口をもって高慢に語ります。","tok":[["彼","かれ"],["ら"],["は"],["、"],["鈍い","にぶい"],["心","こころ"],["を"],["堅く","かたく"],["閉ざし","とざし"],["、"],["その"],["口","くち"],["を"],["もって"],["高慢","こうまん"],["に"],["語ります","かたります"],["。"]]},{"verse":11,"text":"彼らは、あとをつけて来て、今、私たちを取り囲みました。彼らは目をすえて、私たちを地に投げ倒そうとしています。","tok":[["彼","かれ"],["ら"],["は"],["、"],["あと"],["を"],["つけて"],["来て","きて"],["、"],["今","いま"],["、"],["私たち","わたしたち"],["を"],["取り囲みました","とりかこみました"],["。"],["彼","かれ"],["ら"],["は"],["目","め"],["を"],["すえて"],["、"],["私たち","わたしたち"],["を"],["地","ち"],["に"],["投げ倒そう","なげたおそう"],["として"],["います"],["。"]]},{"verse":12,"text":"彼は、あたかも、引き裂こうとねらっている獅子、待ち伏せしている若い獅子のようです。","tok":[["彼","かれ"],["は"],["、"],["あたかも"],["、"],["引き裂こう","ひきさこう"],["と"],["ねらって"],["いる"],["獅子","しし"],["、"],["待ち伏せ","まちぶせ"],["して"],["いる"],["若い","わかい"],["獅子","しし"],["の"],["よう"],["です"],["。"]]},{"verse":13,"text":"主よ。立ち上がってください。彼に立ち向かい、彼を打ちのめしてください。あなたの剣で、悪者から私のたましいを助け出してください。","tok":[["主","ぬし"],["よ"],["。"],["立ち上がって","たちあがって"],["ください"],["。"],["彼","かれ"],["に"],["立ち向かい","たちむかい"],["、"],["彼","かれ"],["を"],["打ちのめして","うちのめして"],["ください"],["。"],["あなた"],["の"],["剣","けん"],["で"],["、"],["悪者","わるもの"],["から"],["私","わたくし"],["の"],["たましい"],["を"],["助け出して","たすけだして"],["ください"],["。"]]},{"verse":14,"text":"主よ。人々から、あなたの御手で。相続分がこの世のいのちであるこの世の人々から。彼らの腹は、あなたの宝で満たされ、彼らは、子どもらに満ち足り、その豊かさを、その幼子らに残します。","tok":[["主","ぬし"],["よ"],["。"],["人々","ひとびと"],["から"],["、"],["あなた"],["の"],["御手","おて"],["で"],["。"],["相続分","そうぞくぶん"],["が"],["この世","このよ"],["の"],["いのち"],["で"],["ある"],["この世","このよ"],["の"],["人々","ひとびと"],["から"],["。"],["彼","かれ"],["ら"],["の"],["腹","はら"],["は"],["、"],["あなた"],["の"],["宝","たから"],["で"],["満たされ","みたされ"],["、"],["彼","かれ"],["ら"],["は"],["、"],["子ども","こども"],["ら"],["に"],["満ち足り","みちたり"],["、"],["その"],["豊か","ゆたか"],["さ"],["を"],["、"],["その"],["幼子","おさなご"],["ら"],["に"],["残します","のこします"],["。"]]},{"verse":15,"text":"しかし、私は、正しい訴えで、御顔を仰ぎ見、目ざめるとき、あなたの御姿に満ち足りるでしょう。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["、"],["正しい","ただしい"],["訴え","うったえ"],["で"],["、"],["御顔","おかお"],["を"],["仰ぎ見","あおぎみ"],["、"],["目ざめる","めざめる"],["とき"],["、"],["あなた"],["の"],["御姿","おすがた"],["に"],["満ち足りるでしょう","みちたりるでしょう"],["。"]]}]
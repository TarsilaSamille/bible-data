[{"verse":1,"text":"（指揮者のために。ダビデの賛歌）主よ。いつまでですか。あなたは私を永久にお忘れになるのですか。いつまで御顔を私からお隠しになるのですか。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["いつ"],["まで"],["です"],["か"],["。"],["あなた"],["は"],["私","わたくし"],["を"],["永久","えいきゅう"],["に"],["お忘れ","おわすれ"],["に"],["なる"],["の"],["です"],["か"],["。"],["いつ"],["まで"],["御顔","おかお"],["を"],["私","わたくし"],["から"],["お隠し","おかくし"],["に"],["なる"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"いつまで私は自分のたましいのうちで思い計らなければならないのでしょう。私の心には、一日中、悲しみがあります。いつまで敵が私の上に、勝ちおごるのでしょう。","tok":[["いつ"],["まで"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["たましい"],["の"],["うち"],["で"],["思い計らなければ","おもいはからなければ"],["ならない"],["の"],["でしょう"],["。"],["私","わたくし"],["の"],["心","こころ"],["に"],["は"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["悲しみ","かなしみ"],["が"],["あります"],["。"],["いつ"],["まで"],["敵","てき"],["が"],["私","わたくし"],["の"],["上","うえ"],["に"],["、"],["勝ち","かち"],["おごる"],["の"],["でしょう"],["。"]]},{"verse":3,"text":"私に目を注ぎ、私に答えてください。私の神、主よ。私の目を輝かせてください。私が死の眠りにつかないように。","tok":[["私","わたくし"],["に"],["目","め"],["を"],["注ぎ","そそぎ"],["、"],["私","わたくし"],["に"],["答えて","こたえて"],["ください"],["。"],["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["目","め"],["を"],["輝かせて","かがやかせて"],["ください"],["。"],["私","わたくし"],["が"],["死","し"],["の"],["眠り","ねむり"],["に"],["つかない"],["よう"],["に"],["。"]]},{"verse":4,"text":"また私の敵が、「おれは彼に勝った」と言わないように。私がよろめいた、と言って私の仇が喜ばないように。","tok":[["また"],["私","わたくし"],["の"],["敵","てき"],["が"],["、"],["「"],["おれ"],["は"],["彼","かれ"],["に"],["勝った","かった"],["」"],["と"],["言わない","いわない"],["よう"],["に"],["。"],["私","わたくし"],["が"],["よろめいた"],["、"],["と"],["言って","いって"],["私","わたくし"],["の"],["仇","あだ"],["が"],["喜ばない","よろこばない"],["よう"],["に"],["。"]]},{"verse":5,"text":"私はあなたの恵みに拠り頼みました。私の心はあなたの救いを喜びます。","tok":[["私","わたくし"],["は"],["あなた"],["の"],["恵み","めぐみ"],["に"],["拠り","より"],["頼みました","たのみました"],["。"],["私","わたくし"],["の"],["心","こころ"],["は"],["あなた"],["の"],["救い","すくい"],["を"],["喜びます","よろこびます"],["。"]]},{"verse":6,"text":"私は主に歌を歌います。主が私を豊かにあしらわれたゆえ。","tok":[["私","わたくし"],["は"],["主に","おもに"],["歌","うた"],["を"],["歌います","うたいます"],["。"],["主","ぬし"],["が"],["私","わたくし"],["を"],["豊か","ゆたか"],["に"],["あしらわれた"],["ゆえ"],["。"]]}]
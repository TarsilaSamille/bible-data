[{"verse":1,"text":"（指揮者のために。コラの子たちの賛歌）すべての国々の民よ。手をたたけ。喜びの声をあげて神に叫べ。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["コラ"],["の"],["子","こ"],["たち"],["の"],["賛歌","さんか"],["）"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["よ"],["。"],["手","て"],["を"],["たたけ"],["。"],["喜び","よろこび"],["の"],["声","こえ"],["を"],["あげて"],["神","かみ"],["に"],["叫べ","さけべ"],["。"]]},{"verse":2,"text":"まことに、いと高き方主は、恐れられる方。全地の大いなる王。","tok":[["まこと"],["に"],["、"],["いと"],["高き","たかき"],["方","ほう"],["主","しゅ"],["は"],["、"],["恐れられる","おそれられる"],["方","かた"],["。"],["全地","ぜんち"],["の"],["大いなる","おおいなる"],["王","おう"],["。"]]},{"verse":3,"text":"国々の民を私たちのもとに、国民を私たちの足もとに従わせる。","tok":[["国々","くにぐに"],["の"],["民","たみ"],["を"],["私たち","わたしたち"],["の"],["もと"],["に"],["、"],["国民","こくみん"],["を"],["私たち","わたしたち"],["の"],["足もと","あしもと"],["に"],["従わせる","したがわせる"],["。"]]},{"verse":4,"text":"主は、私たちのためにお選びになる。私たちの受け継ぐ地を。主の愛するヤコブの誉れを。セラ","tok":[["主","ぬし"],["は"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["お選び","おえらび"],["に"],["なる"],["。"],["私たち","わたしたち"],["の"],["受け継ぐ","うけつぐ"],["地","ち"],["を"],["。"],["主","ぬし"],["の"],["愛する","あいする"],["ヤコブ"],["の"],["誉れ","ほまれ"],["を"],["。"],["セラ"]]},{"verse":5,"text":"神は喜びの叫びの中を、主は角笛の音の中を、上って行かれた。","tok":[["神","かみ"],["は"],["喜び","よろこび"],["の"],["叫び","さけび"],["の"],["中","なか"],["を"],["、"],["主","ぬし"],["は"],["角笛","つのぶえ"],["の"],["音","おと"],["の"],["中","なか"],["を"],["、"],["上って","のぼって"],["行かれた","いかれた"],["。"]]},{"verse":6,"text":"神にほめ歌を歌え。ほめ歌を歌え。われらの王にほめ歌を歌え。ほめ歌を歌え。","tok":[["神","かみ"],["に"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"],["われ"],["ら"],["の"],["王","おう"],["に"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"]]},{"verse":7,"text":"まことに神は全地の王。巧みな歌でほめ歌を歌え。","tok":[["まこと"],["に"],["神","かみ"],["は"],["全地","ぜんち"],["の"],["王","おう"],["。"],["巧み","たくみ"],["な"],["歌","うた"],["で"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"]]},{"verse":8,"text":"神は国々を統べ治めておられる。神はその聖なる王座に着いておられる。","tok":[["神","かみ"],["は"],["国々","くにぐに"],["を"],["統べ治めて","すべおさめて"],["おられる"],["。"],["神","かみ"],["は"],["その"],["聖","せい"],["なる"],["王座","おうざ"],["に"],["着いて","ついて"],["おられる"],["。"]]},{"verse":9,"text":"国々の民の尊き者たちは、アブラハムの神の民として集められた。","tok":[["国々","くにぐに"],["の"],["民","たみ"],["の"],["尊き","とうとき"],["者","もの"],["たち"],["は"],["、"],["アブラハム"],["の"],["神","かみ"],["の"],["民","たみ"],["として"],["集められた","あつめられた"],["。"]]},{"verse":10,"text":"まことに、地の盾は神のもの。神は大いにあがめられる方。","tok":[["まこと"],["に"],["、"],["地","ち"],["の"],["盾","たて"],["は"],["神","かみ"],["の"],["もの"],["。"],["神","かみ"],["は"],["大いに","おおいに"],["あがめられる"],["方","かた"],["。"]]}]
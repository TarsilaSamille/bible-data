[{"verse":1,"text":"（都上りの歌。ダビデによる）「もしも主が私たちの味方でなかったなら。」さあ、イスラエルは言え。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["。"],["ダビデ"],["に"],["よる"],["）"],["「"],["もし"],["も"],["主","ぬし"],["が"],["私たち","わたしたち"],["の"],["味方","みかた"],["で"],["なかったなら"],["。"],["」"],["さあ"],["、"],["イスラエル"],["は"],["言え","いえ"],["。"]]},{"verse":2,"text":"「もしも主が私たちの味方でなかったなら、人々が私たちに逆らって立ち上がったとき、","tok":[["「"],["もし"],["も"],["主","ぬし"],["が"],["私たち","わたしたち"],["の"],["味方","みかた"],["で"],["なかったなら"],["、"],["人々","ひとびと"],["が"],["私たち","わたしたち"],["に"],["逆らって","さからって"],["立ち上がった","たちあがった"],["とき"],["、"]]},{"verse":3,"text":"そのとき、彼らは私たちを生きたままのみこんだであろう。彼らの怒りが私たちに向かって燃え上がったとき、","tok":[["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["私たち","わたしたち"],["を"],["生きた","いきた"],["まま"],["のみこんだで"],["あろう"],["。"],["彼","かれ"],["ら"],["の"],["怒り","いかり"],["が"],["私たち","わたしたち"],["に"],["向かって","むかって"],["燃え上がった","もえあがった"],["とき"],["、"]]},{"verse":4,"text":"そのとき、大水は私たちを押し流し、流れは私たちを越えて行ったであろう。","tok":[["その"],["とき"],["、"],["大水","おおみず"],["は"],["私たち","わたしたち"],["を"],["押し流し","おしながし"],["、"],["流れ","ながれ"],["は"],["私たち","わたしたち"],["を"],["越えて","こえて"],["行ったで","いったで"],["あろう"],["。"]]},{"verse":5,"text":"そのとき、荒れ狂う水は私たちを越えて行ったであろう。」","tok":[["その"],["とき"],["、"],["荒れ狂う","あれくるう"],["水","みず"],["は"],["私たち","わたしたち"],["を"],["越えて","こえて"],["行ったで","いったで"],["あろう"],["。"],["」"]]},{"verse":6,"text":"ほむべきかな。主。主は私たちを彼らの歯のえじきにされなかった。","tok":[["ほ"],["むべき"],["か"],["な"],["。"],["主","ぬし"],["。"],["主","ぬし"],["は"],["私たち","わたしたち"],["を"],["彼","かれ"],["ら"],["の"],["歯","は"],["の"],["えじき"],["に"],["されなかった"],["。"]]},{"verse":7,"text":"私たちは仕掛けられたわなから鳥のように助け出された。わなは破られ、私たちは助け出された。","tok":[["私たち","わたしたち"],["は"],["仕掛けられた","しかけられた"],["わな"],["から"],["鳥","とり"],["の"],["よう"],["に"],["助け出された","たすけだされた"],["。"],["わな"],["は"],["破られ","やぶられ"],["、"],["私たち","わたしたち"],["は"],["助け出された","たすけだされた"],["。"]]},{"verse":8,"text":"私たちの助けは、天地を造られた主の御名にある。","tok":[["私たち","わたしたち"],["の"],["助け","たすけ"],["は"],["、"],["天地","てんち"],["を"],["造られた","つくられた"],["主","ぬし"],["の"],["御名","ぎょめい"],["に"],["ある"],["。"]]}]
[{"verse":1,"text":"（指揮者のために。八弦の立琴に合わせて。ダビデの賛歌）主よ。御怒りで私を責めないでください。激しい憤りで私を懲らしめないでください。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["八","はち"],["弦","げん"],["の"],["立琴","たてごと"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["御怒り","おいかり"],["で"],["私","わたくし"],["を"],["責めないで","せめないで"],["ください"],["。"],["激しい","はげしい"],["憤り","いきどおり"],["で"],["私","わたくし"],["を"],["懲らしめないで","こらしめないで"],["ください"],["。"]]},{"verse":2,"text":"主よ。私をあわれんでください。私は衰えております。主よ。私をいやしてください。私の骨は恐れおののいています。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["を"],["あわれんで"],["ください"],["。"],["私","わたくし"],["は"],["衰えて","おとろえて"],["おります"],["。"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["を"],["いやして"],["ください"],["。"],["私","わたくし"],["の"],["骨","ほね"],["は"],["恐れおののいて","おそれおののいて"],["います"],["。"]]},{"verse":3,"text":"私のたましいはただ、恐れおののいています。主よ。いつまでですか。あなたは。","tok":[["私","わたくし"],["の"],["たましい"],["は"],["ただ"],["、"],["恐れおののいて","おそれおののいて"],["います"],["。"],["主","ぬし"],["よ"],["。"],["いつ"],["まで"],["です"],["か"],["。"],["あなた"],["は"],["。"]]},{"verse":4,"text":"帰って来てください。主よ。私のたましいを助け出してください。あなたの恵みのゆえに、私をお救いください。","tok":[["帰って","かえって"],["来て","きて"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["たましい"],["を"],["助け出して","たすけだして"],["ください"],["。"],["あなた"],["の"],["恵み","めぐみ"],["の"],["ゆえ"],["に"],["、"],["私","わたくし"],["を"],["お救い","おすくい"],["ください"],["。"]]},{"verse":5,"text":"死にあっては、あなたを覚えることはありません。よみにあっては、だれが、あなたをほめたたえるでしょう。","tok":[["死","し"],["に"],["あって"],["は"],["、"],["あなた"],["を"],["覚える","おぼえる"],["こと"],["は"],["ありません"],["。"],["よみ"],["に"],["あって"],["は"],["、"],["だれ"],["が"],["、"],["あなた"],["を"],["ほめたたえるでしょう"],["。"]]},{"verse":6,"text":"私は私の嘆きで疲れ果て、私の涙で、夜ごとに私の寝床を漂わせ、私のふしどを押し流します。","tok":[["私","わたくし"],["は"],["私","わたくし"],["の"],["嘆き","なげき"],["で"],["疲れ","つかれ"],["果て","はて"],["、"],["私","わたくし"],["の"],["涙","なみだ"],["で"],["、"],["夜","よる"],["ごと"],["に"],["私","わたくし"],["の"],["寝床","ねどこ"],["を"],["漂わせ","ただよわせ"],["、"],["私","わたくし"],["の"],["ふし"],["ど"],["を"],["押し流します","おしながします"],["。"]]},{"verse":7,"text":"私の目は、いらだちで衰え、私のすべての敵のために弱まりました。","tok":[["私","わたくし"],["の"],["目","め"],["は"],["、"],["いらだち"],["で"],["衰え","おとろえ"],["、"],["私","わたくし"],["の"],["すべて"],["の"],["敵","てき"],["の"],["ため"],["に"],["弱まりました","よわまりました"],["。"]]},{"verse":8,"text":"不法を行う者ども。みな私から離れて行け。主は私の泣く声を聞かれたのだ。","tok":[["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["ども"],["。"],["みな"],["私","わたくし"],["から"],["離れて","はなれて"],["行け","いけ"],["。"],["主","ぬし"],["は"],["私","わたくし"],["の"],["泣く","なく"],["声","こえ"],["を"],["聞かれた","きかれた"],["の"],["だ"],["。"]]},{"verse":9,"text":"主は私の切なる願いを聞かれた。主は私の祈りを受け入れられる。","tok":[["主","ぬし"],["は"],["私","わたくし"],["の"],["切","せつ"],["なる"],["願い","ねがい"],["を"],["聞かれた","きかれた"],["。"],["主","ぬし"],["は"],["私","わたくし"],["の"],["祈り","いのり"],["を"],["受け入れられる","うけいれられる"],["。"]]},{"verse":10,"text":"私の敵は、みな恥を見、ただ、恐れおののきますように。彼らは退き、恥を見ますように。またたくまに。","tok":[["私","わたくし"],["の"],["敵","てき"],["は"],["、"],["みな"],["恥","はじ"],["を"],["見","み"],["、"],["ただ"],["、"],["恐れおののきます","おそれおののきます"],["よう"],["に"],["。"],["彼","かれ"],["ら"],["は"],["退き","しりぞき"],["、"],["恥","はじ"],["を"],["見ます","みます"],["よう"],["に"],["。"],["また"],["たくま"],["に"],["。"]]}]
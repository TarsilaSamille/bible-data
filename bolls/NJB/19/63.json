[{"verse":1,"text":"（ダビデの賛歌。彼がユダの荒野にいたときに）神よ。あなたは私の神。私はあなたを切に求めます。水のない、砂漠の衰え果てた地で、私のたましいは、あなたに渇き、私の身も、あなたを慕って気を失うばかりです。","tok":[["（"],["ダビデ"],["の"],["賛歌","さんか"],["。"],["彼","かれ"],["が"],["ユダ"],["の"],["荒野","あらの"],["に"],["いた"],["とき"],["に"],["）"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["神","かみ"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["切に","せつに"],["求めます","もとめます"],["。"],["水","みず"],["の"],["ない"],["、"],["砂漠","さばく"],["の"],["衰え","おとろえ"],["果てた","はてた"],["地","ち"],["で"],["、"],["私","わたくし"],["の"],["たましい"],["は"],["、"],["あなた"],["に"],["渇き","かわき"],["、"],["私","わたくし"],["の"],["身","み"],["も"],["、"],["あなた"],["を"],["慕って","したって"],["気","き"],["を"],["失う","うしなう"],["ばかり"],["です"],["。"]]},{"verse":2,"text":"私は、あなたの力と栄光を見るために、こうして聖所で、あなたを仰ぎ見ています。","tok":[["私","わたくし"],["は"],["、"],["あなた"],["の"],["力","ちから"],["と"],["栄光","えいこう"],["を"],["見る","みる"],["ため"],["に"],["、"],["こう"],["して"],["聖","せい"],["所","しょ"],["で"],["、"],["あなた"],["を"],["仰ぎ見て","あおぎみて"],["います"],["。"]]},{"verse":3,"text":"あなたの恵みは、いのちにもまさるゆえ、私のくちびるは、あなたを賛美します。","tok":[["あなた"],["の"],["恵み","めぐみ"],["は"],["、"],["いのち"],["に"],["も"],["まさる"],["ゆえ"],["、"],["私","わたくし"],["の"],["くちびる"],["は"],["、"],["あなた"],["を"],["賛美","さんび"],["します"],["。"]]},{"verse":4,"text":"それゆえ私は生きているかぎり、あなたをほめたたえ、あなたの御名により、両手を上げて祈ります。","tok":[["それ"],["ゆえ"],["私","わたくし"],["は"],["生きて","いきて"],["いる"],["かぎり"],["、"],["あなた"],["を"],["ほめたたえ"],["、"],["あなた"],["の"],["御名","ぎょめい"],["に"],["より"],["、"],["両手","りょうて"],["を"],["上げて","あげて"],["祈ります","いのります"],["。"]]},{"verse":5,"text":"私のたましいが脂肪と髄に満ち足りるかのように、私のくちびるは喜びにあふれて賛美します。","tok":[["私","わたくし"],["の"],["たましい"],["が"],["脂肪","しぼう"],["と"],["髄","ずい"],["に"],["満ち足りる","みちたりる"],["か"],["の"],["よう"],["に"],["、"],["私","わたくし"],["の"],["くちびる"],["は"],["喜び","よろこび"],["に"],["あふれて"],["賛美","さんび"],["します"],["。"]]},{"verse":6,"text":"ああ、私は床の上であなたを思い出し、夜ふけて私はあなたを思います。","tok":[["ああ"],["、"],["私","わたくし"],["は"],["床","ゆか"],["の"],["上","うえ"],["で"],["あなた"],["を"],["思い出し","おもいだし"],["、"],["夜ふけ","よふけ"],["て"],["私","わたくし"],["は"],["あなた"],["を"],["思います","おもいます"],["。"]]},{"verse":7,"text":"あなたは私の助けでした。御翼の陰で、私は喜び歌います。","tok":[["あなた"],["は"],["私","わたくし"],["の"],["助け","たすけ"],["でした"],["。"],["御翼","おつばさ"],["の"],["陰","かげ"],["で"],["、"],["私","わたくし"],["は"],["喜び歌います","よろこびうたいます"],["。"]]},{"verse":8,"text":"私のたましいは、あなたにすがり、あなたの右の手は、私をささえてくださいます。","tok":[["私","わたくし"],["の"],["たましい"],["は"],["、"],["あなた"],["に"],["すがり"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["、"],["私","わたくし"],["を"],["ささえて"],["くださいます"],["。"]]},{"verse":9,"text":"しかし、私のいのちを求める者らは滅んでしまい、地の深い所に行くでしょう。","tok":[["しかし"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["求める","もとめる"],["者","もの"],["ら"],["は"],["滅んで","ほろんで"],["しまい"],["、"],["地","ち"],["の"],["深い","ふかい"],["所","ところ"],["に"],["行くでしょう","いくでしょう"],["。"]]},{"verse":10,"text":"彼らは、剣の力に渡され、きつねのえじきとなるのです。","tok":[["彼","かれ"],["ら"],["は"],["、"],["剣","けん"],["の"],["力","ちから"],["に"],["渡され","わたされ"],["、"],["きつね"],["の"],["えじき"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":11,"text":"しかし王は、神にあって喜び、神にかけて誓う者は、みな誇ります。偽りを言う者の口は封じられるからです。","tok":[["しかし"],["王","おう"],["は"],["、"],["神","かみ"],["に"],["あって"],["喜び","よろこび"],["、"],["神","かみ"],["に"],["かけて"],["誓う","ちかう"],["者","もの"],["は"],["、"],["みな"],["誇ります","ほこります"],["。"],["偽り","いつわり"],["を"],["言う","いう"],["者","もの"],["の"],["口","くち"],["は"],["封じられる","ふうじられる"],["から"],["です"],["。"]]}]
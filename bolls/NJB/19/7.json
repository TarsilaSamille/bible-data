[{"verse":1,"text":"（ベニヤミン人クシュのことについてダビデが主に歌ったシガヨンの歌）私の神、主よ。私はあなたのもとに身を避けました。どうか、追い迫るすべての者から私を救ってください。私を救い出してください。","tok":[["（"],["ベニヤミン"],["人","にん"],["クシュ"],["の"],["こと"],["について"],["ダビデ"],["が"],["主に","おもに"],["歌った","うたった"],["シガヨン"],["の"],["歌","うた"],["）"],["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["もと"],["に"],["身","み"],["を"],["避けました","さけました"],["。"],["どう"],["か"],["、"],["追い迫る","おいせまる"],["すべて"],["の"],["者","もの"],["から"],["私","わたくし"],["を"],["救って","すくって"],["ください"],["。"],["私","わたくし"],["を"],["救い出して","すくいだして"],["ください"],["。"]]},{"verse":2,"text":"救い出す者がいない間に彼らが獅子のように、私のたましいを引き裂き、さらって行くことがないように。","tok":[["救い出す","すくいだす"],["者","もの"],["が"],["いない"],["間","あいだ"],["に"],["彼","かれ"],["ら"],["が"],["獅子","しし"],["の"],["よう"],["に"],["、"],["私","わたくし"],["の"],["たましい"],["を"],["引き裂き","ひきさき"],["、"],["さらって"],["行く","いく"],["こと"],["が"],["ない"],["よう"],["に"],["。"]]},{"verse":3,"text":"私の神、主よ。もし私がこのことをしたのなら、もし私の手に不正があるのなら、","tok":[["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["もし"],["私","わたくし"],["が"],["この"],["こと"],["を"],["した"],["の"],["なら"],["、"],["もし"],["私","わたくし"],["の"],["手","て"],["に"],["不正","ふせい"],["が"],["ある"],["の"],["なら"],["、"]]},{"verse":4,"text":"もし私が親しい友に悪い仕打ちをしたのなら、また、私に敵対する者から、ゆえなく奪ったのなら、","tok":[["もし"],["私","わたくし"],["が"],["親しい","したしい"],["友","とも"],["に"],["悪い","わるい"],["仕打ち","しうち"],["を"],["した"],["の"],["なら"],["、"],["また"],["、"],["私","わたくし"],["に"],["敵対","てきたい"],["する"],["者","もの"],["から"],["、"],["ゆえなく"],["奪った","うばった"],["の"],["なら"],["、"]]},{"verse":5,"text":"敵に私を追わせ、追いつかせ、私のいのちを地に踏みにじらせてください。私のたましいをちりの中にとどまらせてください。セラ","tok":[["敵","てき"],["に"],["私","わたくし"],["を"],["追わせ","おわせ"],["、"],["追いつかせ","おいつかせ"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["地","ち"],["に"],["踏みにじらせて","ふみにじらせて"],["ください"],["。"],["私","わたくし"],["の"],["たましい"],["を"],["ちり"],["の"],["中","なか"],["に"],["とどまらせて"],["ください"],["。"],["セラ"]]},{"verse":6,"text":"主よ。御怒りをもって立ち上がってください。私の敵の激しい怒りに向かって立ち、私のために目をさましてください。あなたはさばきを定められました。","tok":[["主","ぬし"],["よ"],["。"],["御怒り","おいかり"],["を"],["もって"],["立ち上がって","たちあがって"],["ください"],["。"],["私","わたくし"],["の"],["敵","てき"],["の"],["激しい","はげしい"],["怒り","いかり"],["に"],["向かって","むかって"],["立ち","たち"],["、"],["私","わたくし"],["の"],["ため"],["に"],["目","め"],["を"],["さまして"],["ください"],["。"],["あなた"],["は"],["さばき"],["を"],["定められました","さだめられました"],["。"]]},{"verse":7,"text":"国民のつどいをあなたの回りに集め、その上の高いみくらにお帰りください。","tok":[["国民","こくみん"],["の"],["つどい"],["を"],["あなた"],["の"],["回り","まわり"],["に"],["集め","あつめ"],["、"],["その"],["上","うえ"],["の"],["高い","たかい"],["みくら"],["に"],["お帰り","おかえり"],["ください"],["。"]]},{"verse":8,"text":"主は諸国の民をさばかれる。主よ。私の義と、私にある誠実とにしたがって、私を弁護してください。","tok":[["主","ぬし"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["さばかれる"],["。"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["義","ぎ"],["と"],["、"],["私","わたくし"],["に"],["ある"],["誠実","せいじつ"],["と"],["に"],["したがって"],["、"],["私","わたくし"],["を"],["弁護","べんご"],["して"],["ください"],["。"]]},{"verse":9,"text":"どうか、悪者の悪があとを絶ち、あなたが正しい者を堅く立てられますように。正しい神は、心と思いを調べられます。","tok":[["どう"],["か"],["、"],["悪者","わるもの"],["の"],["悪","あく"],["が"],["あと"],["を"],["絶ち","たち"],["、"],["あなた"],["が"],["正しい","ただしい"],["者","もの"],["を"],["堅く","かたく"],["立てられます","たてられます"],["よう"],["に"],["。"],["正しい","ただしい"],["神","かみ"],["は"],["、"],["心","こころ"],["と"],["思い","おもい"],["を"],["調べられます","しらべられます"],["。"]]},{"verse":10,"text":"私の盾は神にあり、神は心の直ぐな人を救われる。","tok":[["私","わたくし"],["の"],["盾","たて"],["は"],["神","かみ"],["に"],["あり"],["、"],["神","かみ"],["は"],["心","こころ"],["の"],["直ぐ","すぐ"],["な"],["人","ひと"],["を"],["救われる","すくわれる"],["。"]]},{"verse":11,"text":"神は正しい審判者、日々、怒る神。","tok":[["神","かみ"],["は"],["正しい","ただしい"],["審判者","しんぱんしゃ"],["、"],["日々","ひび"],["、"],["怒る","おこる"],["神","かみ"],["。"]]},{"verse":12,"text":"悔い改めない者には剣をとぎ、弓を張って、ねらいを定め、","tok":[["悔い改めない","くいあらためない"],["者","もの"],["に"],["は"],["剣","けん"],["を"],["とぎ"],["、"],["弓","ゆみ"],["を"],["張って","はって"],["、"],["ねらい"],["を"],["定め","さだめ"],["、"]]},{"verse":13,"text":"その者に向かって、死の武器を構え、矢を燃える矢とされる。","tok":[["その"],["者","もの"],["に"],["向かって","むかって"],["、"],["死","し"],["の"],["武器","ぶき"],["を"],["構え","かまえ"],["、"],["矢","や"],["を"],["燃える","もえる"],["矢","や"],["と"],["される"],["。"]]},{"verse":14,"text":"見よ。彼は悪意を宿し、害毒をはらみ、偽りを生む。","tok":[["見","み"],["よ"],["。"],["彼","かれ"],["は"],["悪意","あくい"],["を"],["宿し","やどし"],["、"],["害毒","がいどく"],["を"],["はらみ"],["、"],["偽り","いつわり"],["を"],["生む","うむ"],["。"]]},{"verse":15,"text":"彼は穴を掘って、それを深くし、おのれの作った穴に落ち込む。","tok":[["彼","かれ"],["は"],["穴","あな"],["を"],["掘って","ほって"],["、"],["それ"],["を"],["深く","ふかく"],["し"],["、"],["おのれ"],["の"],["作った","つくった"],["穴","あな"],["に"],["落ち込む","おちこむ"],["。"]]},{"verse":16,"text":"その害毒は、おのれのかしらに戻り、その暴虐は、おのれの脳天に下る。","tok":[["その"],["害毒","がいどく"],["は"],["、"],["おのれ"],["の"],["かしら"],["に"],["戻り","もどり"],["、"],["その"],["暴虐","ぼうぎゃく"],["は"],["、"],["おのれ"],["の"],["脳天","のうてん"],["に"],["下る","くだる"],["。"]]},{"verse":17,"text":"その義にふさわしく、主を、私はほめたたえよう。いと高き方、主の御名をほめ歌おう。","tok":[["その"],["義","ぎ"],["に"],["ふさわしく"],["、"],["主","ぬし"],["を"],["、"],["私","わたくし"],["は"],["ほめたたえよう"],["。"],["いと"],["高き","たかき"],["方","かた"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["ほめ"],["歌おう","うたおう"],["。"]]}]
[{"verse":1,"text":"（指揮者のために。コラの子たちの賛歌）主よ。あなたは御国に恵みを施し、ヤコブの繁栄を元どおりにされました。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["コラ"],["の"],["子","こ"],["たち"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["御国","みくに"],["に"],["恵み","めぐみ"],["を"],["施し","ほどこし"],["、"],["ヤコブ"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["されました"],["。"]]},{"verse":2,"text":"あなたは、御民の咎を赦し、彼らのすべての罪を、おおわれました。セラ","tok":[["あなた"],["は"],["、"],["御民","ごみん"],["の"],["咎","とが"],["を"],["赦し","ゆるし"],["、"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["罪","つみ"],["を"],["、"],["おおわれました"],["。"],["セラ"]]},{"verse":3,"text":"あなたは、激しい怒りをことごとく取り去り、燃える御怒りを、押しとどめられました。","tok":[["あなた"],["は"],["、"],["激しい","はげしい"],["怒り","いかり"],["を"],["ことごとく"],["取り去り","とりさり"],["、"],["燃える","もえる"],["御怒り","おいかり"],["を"],["、"],["押しとどめられました","おしとどめられました"],["。"]]},{"verse":4,"text":"われらの救いの神よ。どうか、私たちを生き返らせ、私たちに対する御怒りをやめてください。","tok":[["われ"],["ら"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["。"],["どう"],["か"],["、"],["私たち","わたしたち"],["を"],["生き返らせ","いきかえらせ"],["、"],["私たち","わたしたち"],["に"],["対する","たいする"],["御怒り","おいかり"],["を"],["やめて"],["ください"],["。"]]},{"verse":5,"text":"あなたは、いつまでも、私たちに対して怒っておられるのですか。代々に至るまで、あなたの御怒りを引き延ばされるのですか。","tok":[["あなた"],["は"],["、"],["いつ"],["まで"],["も"],["、"],["私たち","わたしたち"],["に対して","にたいして"],["怒って","おこって"],["おられる"],["の"],["です"],["か"],["。"],["代々","だいだい"],["に"],["至る","いたる"],["まで"],["、"],["あなた"],["の"],["御怒り","おいかり"],["を"],["引き延ばされる","ひきのばされる"],["の"],["です"],["か"],["。"]]},{"verse":6,"text":"あなたは、私たちを再び生かされないのですか。あなたの民があなたによって喜ぶために。","tok":[["あなた"],["は"],["、"],["私たち","わたしたち"],["を"],["再び","ふたたび"],["生かされない","いかされない"],["の"],["です"],["か"],["。"],["あなた"],["の"],["民","たみ"],["が"],["あなた"],["によって"],["喜ぶ","よろこぶ"],["ため"],["に"],["。"]]},{"verse":7,"text":"主よ。私たちに、あなたの恵みを示し、あなたの救いを私たちに与えてください。","tok":[["主","ぬし"],["よ"],["。"],["私たち","わたしたち"],["に"],["、"],["あなた"],["の"],["恵み","めぐみ"],["を"],["示し","しめし"],["、"],["あなた"],["の"],["救い","すくい"],["を"],["私たち","わたしたち"],["に"],["与えて","あたえて"],["ください"],["。"]]},{"verse":8,"text":"私は、主であられる神の仰せを聞きたい。主は、御民と聖徒たちとに平和を告げ、彼らを再び愚かさには戻されない。","tok":[["私","わたくし"],["は"],["、"],["主","ぬし"],["で"],["あられる"],["神","かみ"],["の"],["仰せ","おおせ"],["を"],["聞きたい","ききたい"],["。"],["主","ぬし"],["は"],["、"],["御民","ごみん"],["と"],["聖徒","せいと"],["たち"],["と"],["に"],["平和","へいわ"],["を"],["告げ","つげ"],["、"],["彼","かれ"],["ら"],["を"],["再び","ふたたび"],["愚か","おろか"],["さ"],["に"],["は"],["戻されない","もどされない"],["。"]]},{"verse":9,"text":"まことに御救いは主を恐れる者たちに近い。それは、栄光が私たちの国にとどまるためです。","tok":[["まこと"],["に"],["御救い","おすくい"],["は"],["主","ぬし"],["を"],["恐れる","おそれる"],["者","もの"],["たち"],["に"],["近い","ちかい"],["。"],["それ"],["は"],["、"],["栄光","えいこう"],["が"],["私たち","わたしたち"],["の"],["国","くに"],["に"],["とどまる"],["ため"],["です"],["。"]]},{"verse":10,"text":"恵みとまこととは、互いに出会い、義と平和とは、互いに口づけしています。","tok":[["恵み","めぐみ"],["と"],["まこと"],["と"],["は"],["、"],["互い","たがい"],["に"],["出会い","であい"],["、"],["義","ぎ"],["と"],["平和","へいわ"],["と"],["は"],["、"],["互い","たがい"],["に"],["口づけ","くちづけ"],["して"],["います"],["。"]]},{"verse":11,"text":"まことは地から生えいで、義は天から見おろしています。","tok":[["まこと"],["は"],["地","ち"],["から"],["生え","はえ"],["いで"],["、"],["義","ぎ"],["は"],["天","てん"],["から"],["見おろして","みおろして"],["います"],["。"]]},{"verse":12,"text":"まことに、主は、良いものを下さるので、私たちの国は、その産物を生じます。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["、"],["良い","よい"],["もの"],["を"],["下さる","くださる"],["ので"],["、"],["私たち","わたしたち"],["の"],["国","くに"],["は"],["、"],["その"],["産物","さんぶつ"],["を"],["生じます","しょうじます"],["。"]]},{"verse":13,"text":"義は、主の御前に先立って行き、主の足跡を道とします。","tok":[["義","ぎ"],["は"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["先立って","さきだって"],["行き","いき"],["、"],["主","ぬし"],["の"],["足跡","あしあと"],["を"],["道","みち"],["と"],["します"],["。"]]}]
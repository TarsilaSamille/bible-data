[{"verse":1,"text":"（アサフの賛歌）神よ。国々は、ご自身のものである地に侵入し、あなたの聖なる宮をけがし、エルサレムを廃墟としました。","tok":[["（"],["アサフ"],["の"],["賛歌","さんか"],["）"],["神","かみ"],["よ"],["。"],["国々","くにぐに"],["は"],["、"],["ご自身","ごじしん"],["の"],["もの"],["で"],["ある"],["地","ち"],["に"],["侵入","しんにゅう"],["し"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["宮","みや"],["を"],["けがし"],["、"],["エルサレム"],["を"],["廃墟","はいきょ"],["と"],["しました"],["。"]]},{"verse":2,"text":"彼らは、あなたのしもべたちのしかばねを空の鳥のえじきとし、あなたの聖徒たちの肉を野の獣に与え、","tok":[["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["しもべ"],["たち"],["の"],["しかばね"],["を"],["空","そら"],["の"],["鳥","とり"],["の"],["えじき"],["と"],["し"],["、"],["あなた"],["の"],["聖徒","せいと"],["たち"],["の"],["肉","にく"],["を"],["野","の"],["の"],["獣","けもの"],["に"],["与え","あたえ"],["、"]]},{"verse":3,"text":"聖徒たちの血を、エルサレムの回りに、水のように注ぎ出しました。彼らを葬る者もいません。","tok":[["聖徒","せいと"],["たち"],["の"],["血","ち"],["を"],["、"],["エルサレム"],["の"],["回り","まわり"],["に"],["、"],["水","みず"],["の"],["よう"],["に"],["注ぎ","そそぎ"],["出しました","だしました"],["。"],["彼","かれ"],["ら"],["を"],["葬る","ほうむる"],["者","もの"],["も"],["いません"],["。"]]},{"verse":4,"text":"私たちは隣人のそしりとなり、回りの者のあざけりとなり、笑いぐさとなりました。","tok":[["私たち","わたしたち"],["は"],["隣人","りんじん"],["の"],["そしり"],["と"],["なり"],["、"],["回り","まわり"],["の"],["者","もの"],["の"],["あざけり"],["と"],["なり"],["、"],["笑いぐさ","わらいぐさ"],["と"],["なりました"],["。"]]},{"verse":5,"text":"主よ。いつまででしょうか。あなたは、いつまでもお怒りなのでしょうか。いつまで、あなたのねたみは火のように燃えるのでしょうか。","tok":[["主","ぬし"],["よ"],["。"],["いつ"],["まで"],["でしょう"],["か"],["。"],["あなた"],["は"],["、"],["いつ"],["まで"],["も"],["お怒り","おいかり"],["な"],["の"],["でしょう"],["か"],["。"],["いつ"],["まで"],["、"],["あなた"],["の"],["ねたみ"],["は"],["火","ひ"],["の"],["よう"],["に"],["燃える","もえる"],["の"],["でしょう"],["か"],["。"]]},{"verse":6,"text":"どうか、あなたを知らない国々に、御名を呼び求めない王国の上に、あなたの激しい憤りを注ぎ出してください。","tok":[["どう"],["か"],["、"],["あなた"],["を"],["知らない","しらない"],["国々","くにぐに"],["に"],["、"],["御名","ぎょめい"],["を"],["呼び求めない","よびもとめない"],["王国","おうこく"],["の"],["上","うえ"],["に"],["、"],["あなた"],["の"],["激しい","はげしい"],["憤り","いきどおり"],["を"],["注ぎ","そそぎ"],["出して","だして"],["ください"],["。"]]},{"verse":7,"text":"彼らはヤコブを食い尽くし、その住む所を荒らしたからです。","tok":[["彼","かれ"],["ら"],["は"],["ヤコブ"],["を"],["食い","くい"],["尽くし","つくし"],["、"],["その"],["住む","すむ"],["所","ところ"],["を"],["荒らした","あらした"],["から"],["です"],["。"]]},{"verse":8,"text":"先祖たちの咎を、私たちのものとして、思い出さないでください。あなたのあわれみが、すみやかに、私たちを迎えますように。私たちは、ひどくおとしめられていますから。","tok":[["先祖","せんぞ"],["たち"],["の"],["咎","とが"],["を"],["、"],["私たち","わたしたち"],["の"],["もの"],["として"],["、"],["思い出さないで","おもいださないで"],["ください"],["。"],["あなた"],["の"],["あわれみ"],["が"],["、"],["すみやか"],["に"],["、"],["私たち","わたしたち"],["を"],["迎えます","むかえます"],["よう"],["に"],["。"],["私たち","わたしたち"],["は"],["、"],["ひどく"],["おとしめられて"],["います"],["から"],["。"]]},{"verse":9,"text":"私たちの救いの神よ。御名の栄光のために、私たちを助けてください。御名のために、私たちを救い出し、私たちの罪をお赦しください。","tok":[["私たち","わたしたち"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["。"],["御名","ぎょめい"],["の"],["栄光","えいこう"],["の"],["ため"],["に"],["、"],["私たち","わたしたち"],["を"],["助けて","たすけて"],["ください"],["。"],["御名","ぎょめい"],["の"],["ため"],["に"],["、"],["私たち","わたしたち"],["を"],["救い出し","すくいだし"],["、"],["私たち","わたしたち"],["の"],["罪","つみ"],["を"],["お赦し","おゆるし"],["ください"],["。"]]},{"verse":10,"text":"なぜ、国々は、「彼らの神はどこにいるのか」と言うのでしょう。あなたのしもべたちの、流された血の復讐が、私たちの目の前で、国々に思い知らされますように。","tok":[["なぜ"],["、"],["国々","くにぐに"],["は"],["、"],["「"],["彼","かれ"],["ら"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["言う","いう"],["の"],["でしょう"],["。"],["あなた"],["の"],["しもべ"],["たち"],["の"],["、"],["流された","ながされた"],["血","ち"],["の"],["復讐","ふくしゅう"],["が"],["、"],["私たち","わたしたち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["国々","くにぐに"],["に"],["思い知らされます","おもいしらされます"],["よう"],["に"],["。"]]},{"verse":11,"text":"捕らわれ人のうめきが御前に届きますように。あなたの偉大な力によって、死に定められた人々を生きながらえさせてください。","tok":[["捕らわれ","とらわれ"],["人","にん"],["の"],["うめき"],["が"],["御前","ごぜん"],["に"],["届きます","とどきます"],["よう"],["に"],["。"],["あなた"],["の"],["偉大","いだい"],["な"],["力","ちから"],["によって"],["、"],["死","し"],["に"],["定められた","さだめられた"],["人々","ひとびと"],["を"],["生きながらえさせて","いきながらえさせて"],["ください"],["。"]]},{"verse":12,"text":"主よ。あなたをそしった、そのそしりの七倍を、私たちの隣人らの胸に返してください。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["を"],["そしった"],["、"],["その"],["そしり"],["の"],["七","なな"],["倍","ばい"],["を"],["、"],["私たち","わたしたち"],["の"],["隣人","りんじん"],["ら"],["の"],["胸","むね"],["に"],["返して","かえして"],["ください"],["。"]]},{"verse":13,"text":"そうすれば、あなたの民、あなたの牧場の羊である私たちは、とこしえまでも、あなたに感謝し、代々限りなくあなたの誉れを語り告げましょう。","tok":[["そう"],["すれば"],["、"],["あなた"],["の"],["民","たみ"],["、"],["あなた"],["の"],["牧場","ぼくじょう"],["の"],["羊","ひつじ"],["で"],["ある"],["私たち","わたしたち"],["は"],["、"],["とこしえ"],["まで"],["も"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["代々","だいだい"],["限りなく","かぎりなく"],["あなた"],["の"],["誉れ","ほまれ"],["を"],["語り告げましょう","かたりつげましょう"],["。"]]}]
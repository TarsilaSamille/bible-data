[{"verse":1,"text":"（コラの子たちの賛歌。歌）主は聖なる山に基を置かれる。","tok":[["（"],["コラ"],["の"],["子","こ"],["たち"],["の"],["賛歌","さんか"],["。"],["歌","うた"],["）"],["主","ぬし"],["は"],["聖","せい"],["なる"],["山","やま"],["に"],["基","もと"],["を"],["置かれる","おかれる"],["。"]]},{"verse":2,"text":"主は、ヤコブのすべての住まいにまさって、シオンのもろもろの門を愛される。","tok":[["主","ぬし"],["は"],["、"],["ヤコブ"],["の"],["すべて"],["の"],["住まい","すまい"],["に"],["まさって"],["、"],["シオン"],["の"],["もろもろ"],["の"],["門","もん"],["を"],["愛される","あいされる"],["。"]]},{"verse":3,"text":"神の都よ。あなたについては、すばらしいことが語られている。セラ","tok":[["神","かみ"],["の"],["都","みやこ"],["よ"],["。"],["あなた"],["について"],["は"],["、"],["すばらしい"],["こと"],["が"],["語られて","かたられて"],["いる"],["。"],["セラ"]]},{"verse":4,"text":"「わたしはラハブとバビロンをわたしを知っている者の数に入れよう。見よ。ペリシテとツロ、それにクシュもともに。これらをもここで生まれた者として。」","tok":[["「"],["わたし"],["は"],["ラハブ"],["と"],["バビロン"],["を"],["わたし"],["を"],["知って","しって"],["いる"],["者","もの"],["の"],["数","かず"],["に"],["入れよう","いれよう"],["。"],["見","み"],["よ"],["。"],["ペリシテ"],["と"],["ツロ"],["、"],["それ"],["に"],["クシュ"],["も"],["とも"],["に"],["。"],["これ"],["ら"],["を"],["も"],["ここ"],["で"],["生まれた","うまれた"],["者","もの"],["として"],["。"],["」"]]},{"verse":5,"text":"しかし、シオンについては、こう言われる。「だれもかれもが、ここで生まれた」と。こうして、いと高き方ご自身がシオンを堅くお建てになる。","tok":[["しかし"],["、"],["シオン"],["について"],["は"],["、"],["こう"],["言われる","いわれる"],["。"],["「"],["だれ"],["も"],["かれ"],["も"],["が"],["、"],["ここ"],["で"],["生まれた","うまれた"],["」"],["と"],["。"],["こう"],["して"],["、"],["いと"],["高き","たかき"],["方","ほう"],["ご自身","ごじしん"],["が"],["シオン"],["を"],["堅く","かたく"],["お建て","おたて"],["に"],["なる"],["。"]]},{"verse":6,"text":"主が国々の民を登録されるとき、「この民はここで生まれた」としるされる。セラ","tok":[["主","ぬし"],["が"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["登録","とうろく"],["される"],["とき"],["、"],["「"],["この"],["民","みん"],["は"],["ここ"],["で"],["生まれた","うまれた"],["」"],["と"],["しるされる"],["。"],["セラ"]]},{"verse":7,"text":"踊りながら歌う者は、「私の泉はことごとく、あなたにある」と言おう。","tok":[["踊り","おどり"],["ながら"],["歌う","うたう"],["者","もの"],["は"],["、"],["「"],["私","わたくし"],["の"],["泉","いずみ"],["は"],["ことごとく"],["、"],["あなた"],["に"],["ある"],["」"],["と"],["言おう","いおう"],["。"]]}]
[{"verse":1,"text":"主は王である。国々の民は恐れおののけ。主は、ケルビムの上の御座に着いておられる。地よ、震えよ。","tok":[["主","ぬし"],["は"],["王","おう"],["で"],["ある"],["。"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["恐れおののけ","おそれおののけ"],["。"],["主","ぬし"],["は"],["、"],["ケルビム"],["の"],["上","うえ"],["の"],["御座","ぎょざ"],["に"],["着いて","ついて"],["おられる"],["。"],["地","ち"],["よ"],["、"],["震え","ふるえ"],["よ"],["。"]]},{"verse":2,"text":"主はシオンにおいて、大いなる方。主はすべての国々の民の上に高くいます。","tok":[["主","ぬし"],["は"],["シオン"],["に"],["おいて"],["、"],["大いなる","おおいなる"],["方","かた"],["。"],["主","ぬし"],["は"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["高く","たかく"],["います"],["。"]]},{"verse":3,"text":"国々の民よ。大いなる、おそれおおい御名をほめたたえよ。主は聖である。","tok":[["国々","くにぐに"],["の"],["民","たみ"],["よ"],["。"],["大いなる","おおいなる"],["、"],["おそれおおい"],["御名","ぎょめい"],["を"],["ほめたたえ"],["よ"],["。"],["主","ぬし"],["は"],["聖","せい"],["で"],["ある"],["。"]]},{"verse":4,"text":"王の力は、さばきを愛する。あなたは公正を堅く立てられた。あなたは、ヤコブの中で、さばきと正義を行われた。","tok":[["王","おう"],["の"],["力","ちから"],["は"],["、"],["さばき"],["を"],["愛する","あいする"],["。"],["あなた"],["は"],["公正","こうせい"],["を"],["堅く","かたく"],["立てられた","たてられた"],["。"],["あなた"],["は"],["、"],["ヤコブ"],["の"],["中","なか"],["で"],["、"],["さばき"],["と"],["正義","せいぎ"],["を"],["行われた","おこなわれた"],["。"]]},{"verse":5,"text":"われらの神、主をあがめよ。その足台のもとにひれ伏せ。主は聖である。","tok":[["われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["あがめよ"],["。"],["その"],["足台","あしだい"],["の"],["もと"],["に"],["ひれ伏せ","ひれふせ"],["。"],["主","ぬし"],["は"],["聖","せい"],["で"],["ある"],["。"]]},{"verse":6,"text":"モーセとアロンは主の祭司の中に、サムエルは御名を呼ぶ者の中にいた。彼らは主を呼び、主は彼らに答えられた。","tok":[["モーセ"],["と"],["アロン"],["は"],["主","ぬし"],["の"],["祭司","さいし"],["の"],["中","なか"],["に"],["、"],["サムエル"],["は"],["御名","ぎょめい"],["を"],["呼ぶ","よぶ"],["者","もの"],["の"],["中","なか"],["に"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["を"],["呼び","よび"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["に"],["答えられた","こたえられた"],["。"]]},{"verse":7,"text":"主は、雲の柱から、彼らに語られた。彼らは、主のさとしと、彼らに賜ったおきてとを守った。","tok":[["主","ぬし"],["は"],["、"],["雲","くも"],["の"],["柱","はしら"],["から"],["、"],["彼","かれ"],["ら"],["に"],["語られた","かたられた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["の"],["さとし"],["と"],["、"],["彼","かれ"],["ら"],["に"],["賜った","たまわった"],["おきて"],["と"],["を"],["守った","まもった"],["。"]]},{"verse":8,"text":"われらの神、主。あなたは、彼らに答えられた。あなたは、彼らにとって赦しの神であられた。しかし、彼らのしわざに対してはそれに報いる方であった。","tok":[["われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["。"],["あなた"],["は"],["、"],["彼","かれ"],["ら"],["に"],["答えられた","こたえられた"],["。"],["あなた"],["は"],["、"],["彼","かれ"],["ら"],["にとって"],["赦し","ゆるし"],["の"],["神","かみ"],["で"],["あられた"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["の"],["しわざ"],["に対して","にたいして"],["は"],["それ"],["に"],["報いる","むくいる"],["方","かた"],["で"],["あった"],["。"]]},{"verse":9,"text":"われらの神、主をあがめよ。その聖なる山に向かって、ひれ伏せ。われらの神、主は聖である。","tok":[["われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["あがめよ"],["。"],["その"],["聖","せい"],["なる"],["山","やま"],["に"],["向かって","むかって"],["、"],["ひれ伏せ","ひれふせ"],["。"],["われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["聖","せい"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"ハレルヤ。主のしもべたちよ。ほめたたえよ。主の御名をほめたたえよ。","tok":[["ハレルヤ"],["。"],["主","ぬし"],["の"],["しもべ"],["たち"],["よ"],["。"],["ほめたたえ"],["よ"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"今よりとこしえまで、主の御名はほめられよ。","tok":[["今","いま"],["より"],["とこしえ"],["まで"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["は"],["ほめられ"],["よ"],["。"]]},{"verse":3,"text":"日の上る所から沈む所まで、主の御名がほめたたえられるように。","tok":[["日","ひ"],["の"],["上る","のぼる"],["所","ところ"],["から"],["沈む","しずむ"],["所","ところ"],["まで"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["が"],["ほめたたえられる"],["よう"],["に"],["。"]]},{"verse":4,"text":"主はすべての国々の上に高くいまし、その栄光は天の上にある。","tok":[["主","ぬし"],["は"],["すべて"],["の"],["国々","くにぐに"],["の"],["上","うえ"],["に"],["高く","たかく"],["いまし"],["、"],["その"],["栄光","えいこう"],["は"],["天","てん"],["の"],["上","うえ"],["に"],["ある"],["。"]]},{"verse":5,"text":"だれが、われらの神、主のようであろうか。主は高い御位に座し、","tok":[["だれ"],["が"],["、"],["われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["よう"],["で"],["あろう"],["か"],["。"],["主","ぬし"],["は"],["高い","たかい"],["御位","ごい"],["に"],["座し","ざし"],["、"]]},{"verse":6,"text":"身を低くして天と地をご覧になる。","tok":[["身","み"],["を"],["低く","ひくく"],["して"],["天","てん"],["と"],["地","ち"],["を"],["ご覧","ごらん"],["に"],["なる"],["。"]]},{"verse":7,"text":"主は、弱い者をちりから起こし、貧しい人をあくたから引き上げ、","tok":[["主","ぬし"],["は"],["、"],["弱い","よわい"],["者","もの"],["を"],["ちり"],["から"],["起こし","おこし"],["、"],["貧しい","まずしい"],["人","ひと"],["を"],["あくた"],["から"],["引き上げ","ひきあげ"],["、"]]},{"verse":8,"text":"彼らを、君主たちとともに、御民の君主たちとともに、王座に着かせられる。","tok":[["彼","かれ"],["ら"],["を"],["、"],["君主","くんしゅ"],["たち"],["と"],["とも"],["に"],["、"],["御民","ごみん"],["の"],["君主","くんしゅ"],["たち"],["と"],["とも"],["に"],["、"],["王座","おうざ"],["に"],["着かせられる","つかせられる"],["。"]]},{"verse":9,"text":"主は子を産まない女を、子をもって喜ぶ母として家に住まわせる。ハレルヤ。","tok":[["主","ぬし"],["は"],["子","こ"],["を"],["産まない","うまない"],["女","おんな"],["を"],["、"],["子","こ"],["を"],["もって"],["喜ぶ","よろこぶ"],["母","はは"],["として"],["家","いえ"],["に"],["住まわせる","すまわせる"],["。"],["ハレルヤ"],["。"]]}]
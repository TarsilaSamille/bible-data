,"ぬし"],["の"],["御顔","おかお"],["は"],["悪","あく"],["を"],["なす"],["者","もの"],["から"],["そむけられ"],["、"],["彼","かれ"],["ら"],["の"],["記憶","きおく"],["を"],["地","ち"],["から"],["消される","けされる"],["。"]]},{"verse":17,"text":"彼らが叫ぶと、主は聞いてくださる。そして、彼らをそのすべての苦しみから救い出される。","tok":[["彼","かれ"],["ら"],["が"],["叫ぶ","さけぶ"],["と"],["、"],["主","ぬし"],["は"],["聞いて","きいて"],["くださる"],["。"],["そして"],["、"],["彼","かれ"],["ら"],["を"],["その"],["すべて"],["の"],["苦しみ","くるしみ"],["から"],["救い出される","すくいだされる"],["。"]]},{"verse":18,"text":"主は心の打ち砕かれた者の近くにおられ、霊の砕かれた者を救われる。","tok":[["主","ぬし"],["は"],["心","こころ"],["の"],["打ち砕かれた","うちくだかれた"],["者","もの"],["の"],["近く","ちかく"],["に"],["おられ"],["、"],["霊","れい"],["の"],["砕かれた","くだかれた"],["者","もの"],["を"],["救われる","すくわれる"],["。"]]},{"verse":19,"text":"正しい者の悩みは多い。しかし、主はそのすべてから彼を救い出される。","tok":[["正しい","ただしい"],["者","もの"],["の"],["悩み","なやみ"],["は"],["多い","おおい"],["。"],["しかし"],["、"],["主","ぬし"],["は"],["その"],["すべて"],["から"],["彼","かれ"],["を"],["救い出される","すくいだされる"],["。"]]},{"verse":20,"text":"主は、彼の骨をことごとく守り、その一つさえ、砕かれることはない。","tok":[["主","ぬし"],["は"],["、"],["彼","かれ"],["の"],["骨","ほね"],["を"],["ことごとく"],["守り","まもり"],["、"],["その"],["一","ひと"],["つ"],["さえ"],["、"],["砕かれる","くだかれる"],["こと"],["は"],["ない"],["。"]]},{"verse":21,"text":"悪は悪者を殺し、正しい者を憎む者は罪に定められる。","tok":[["悪","あく"],["は"],["悪者","わるもの"],["を"],["殺し","ころし"],["、"],["正しい","ただしい"],["者","もの"],["を"],["憎む","にくむ"],["者","もの"],["は"],["罪","つみ"],["に"],["定められる","さだめられる"],["。"]]},{"verse":22,"text":"主はそのしもべのたましいを贖い出される。主に身を避ける者は、だれも罪に定められない。","tok":[["主","ぬし"],["は"],["その"],["しもべ"],["の"],["たましい"],["を"],["贖い","あがない"],["出される","だされる"],["。"],["主に","おもに"],["身","み"],["を"],["避ける","さける"],["者","もの"],["は"],["、"],["だれ"],["も"],["罪","つみ"],["に"],["定められない","さだめられない"],["。"]]}]
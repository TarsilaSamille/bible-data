[{"verse":1,"text":"（指揮者のために。「さとしは、ゆりの花」の調べに合わせて。教えのためのダビデのミクタム。ダビデがアラム・ナハライムやアラム・ツォバと戦っていたとき、ヨアブが帰って来て、塩の谷でエドムを一万二千人打ち殺したときに）神よ。あなたは私たちを拒み、私たちを破り、怒って、私たちから顔をそむけられました。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["「"],["さとし"],["は"],["、"],["ゆり"],["の"],["花","はな"],["」"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["教え","おしえ"],["の"],["ため"],["の"],["ダビデ"],["の"],["ミクタム"],["。"],["ダビデ"],["が"],["アラム"],["・"],["ナハライム"],["や"],["アラム"],["・"],["ツォバ"],["と"],["戦って","たたかって"],["いた"],["とき"],["、"],["ヨアブ"],["が"],["帰って","かえって"],["来て","きて"],["、"],["塩","しお"],["の"],["谷","たに"],["で"],["エドム"],["を"],["一万二千","いちまんにせん"],["人","にん"],["打ち殺した","うちころした"],["とき"],["に"],["）"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["私たち","わたしたち"],["を"],["拒み","こばみ"],["、"],["私たち","わたしたち"],["を"],["破り","やぶり"],["、"],["怒って","おこって"],["、"],["私たち","わたしたち"],["から"],["顔","かお"],["を"],["そむけられました"],["。"]]},{"verse":2,"text":"あなたは地をゆるがせ、それを引き裂かれました。その裂け目を、いやしてください。地がぐらついているのです。","tok":[["あなた"],["は"],["地","ち"],["を"],["ゆるがせ"],["、"],["それ"],["を"],["引き裂かれました","ひきさかれました"],["。"],["その"],["裂け目","さけめ"],["を"],["、"],["いやして"],["ください"],["。"],["地","ち"],["が"],["ぐらついて"],["いる"],["の"],["です"],["。"]]},{"verse":3,"text":"あなたは、御民に苦難をなめさせられました。よろめかす酒を、私たちに飲ませられました。","tok":[["あなた"],["は"],["、"],["御民","ごみん"],["に"],["苦難","くなん"],["を"],["なめさせられました"],["。"],["よろ"],["めかす"],["酒","さけ"],["を"],["、"],["私たち","わたしたち"],["に"],["飲ませられました","のませられました"],["。"]]},{"verse":4,"text":"あなたは、あなたを恐れる者のために旗を授けられました。それは、弓にかえて、これをひらめかせるためです。セラ","tok":[["あなた"],["は"],["、"],["あなた"],["を"],["恐れる","おそれる"],["者","もの"],["の"],["ため"],["に"],["旗","はた"],["を"],["授けられました","さずけられました"],["。"],["それ"],["は"],["、"],["弓","ゆみ"],["に"],["かえて"],["、"],["これ"],["を"],["ひらめかせる"],["ため"],["です"],["。"],["セラ"]]},{"verse":5,"text":"あなたの愛する者が助け出されるために、あなたの右の手で救ってください。そして私に答えてください。","tok":[["あなた"],["の"],["愛する","あいする"],["者","もの"],["が"],["助け出される","たすけだされる"],["ため"],["に"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["で"],["救って","すくって"],["ください"],["。"],["そして"],["私","わたくし"],["に"],["答えて","こたえて"],["ください"],["。"]]},{"verse":6,"text":"神は聖所から告げられた。「わたしは、喜び勇んで、シェケムを分割し、スコテの谷を配分しよう。","tok":[["神","かみ"],["は"],["聖","せい"],["所","しょ"],["から"],["告げられた","つげられた"],["。"],["「"],["わたし"],["は"],["、"],["喜び勇んで","よろこびいさんで"],["、"],["シェケム"],["を"],["分割","ぶんかつ"],["し"],["、"],["スコテ"],["の"],["谷","たに"],["を"],["配分","はいぶん"],["しよう"],["。"]]},{"verse":7,"text":"ギルアデはわたしのもの。マナセもわたしのもの。エフライムもまた、わたしの頭のかぶと。ユダはわたしの杖。","tok":[["ギルアデ"],["は"],["わたし"],["の"],["もの"],["。"],["マナセ"],["も"],["わたし"],["の"],["もの"],["。"],["エフライム"],["も"],["また"],["、"],["わたし"],["の"],["頭","あたま"],["の"],["かぶと"],["。"],["ユダ"],["は"],["わたし"],["の"],["杖","つえ"],["。"]]},{"verse":8,"text":"モアブはわたしの足を洗うたらい。エドムの上に、わたしのはきものを投げつけよう。ペリシテよ。わたしのゆえに大声で叫べ。」","tok":[["モアブ"],["は"],["わたし"],["の"],["足","あし"],["を"],["洗うたら","あろうたら"],["い"],["。"],["エドム"],["の"],["上","うえ"],["に"],["、"],["わたし"],["の"],["はきもの"],["を"],["投げつけよう","なげつけよう"],["。"],["ペリシテ"],["よ"],["。"],["わたし"],["の"],["ゆえ"],["に"],["大声","おおごえ"],["で"],["叫べ","さけべ"],["。"],["」"]]},{"verse":9,"text":"だれが私を防備の町に連れて行くでしょう。だれが私をエドムまで導くでしょう。","tok":[["だれ"],["が"],["私","わたくし"],["を"],["防備","ぼうび"],["の"],["町","まち"],["に"],["連れて","つれて"],["行くでしょう","いくでしょう"],["。"],["だれ"],["が"],["私","わたくし"],["を"],["エドム"],["まで"],["導くでしょう","みちびくでしょう"],["。"]]},{"verse":10,"text":"神よ。あなたご自身が私たちを拒まれたのではありませんか。神よ。あなたは、もはや私たちの軍勢とともに、出陣なさらないのですか。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["ご自身","ごじしん"],["が"],["私たち","わたしたち"],["を"],["拒まれた","こばまれた"],["ので"],["は"],["ありません"],["か"],["。"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["、"],["もはや"],["私たち","わたしたち"],["の"],["軍勢","ぐんぜい"],["と"],["とも"],["に"],["、"],["出陣","しゅつじん"],["なさらない"],["の"],["です"],["か"],["。"]]},{"verse":11,"text":"どうか、敵から私たちを助けてください。まことに、人の救いはむなしいものです。","tok":[["どう"],["か"],["、"],["敵","てき"],["から"],["私たち","わたしたち"],["を"],["助けて","たすけて"],["ください"],["。"],["まこと"],["に"],["、"],["人","ひと"],["の"],["救い","すくい"],["は"],["むなしい"],["もの"],["です"],["。"]]},{"verse":12,"text":"神によって、私たちは力ある働きをします。神こそ、私たちの敵を踏みつけられる方です。","tok":[["神","かみ"],["によって"],["、"],["私たち","わたしたち"],["は"],["力","ちから"],["ある"],["働き","はたらき"],["を"],["します"],["。"],["神","かみ"],["こそ"],["、"],["私たち","わたしたち"],["の"],["敵","てき"],["を"],["踏みつけられる","ふみつけられる"],["方","かた"],["です"],["。"]]}]
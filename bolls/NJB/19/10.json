[{"verse":1,"text":"主よ。なぜ、あなたは遠く離れてお立ちなのですか。苦しみのときに、なぜ、身を隠されるのですか。","tok":[["主","ぬし"],["よ"],["。"],["なぜ"],["、"],["あなた"],["は"],["遠く","とおく"],["離れて","はなれて"],["お立ちな","おたちな"],["の"],["です"],["か"],["。"],["苦しみ","くるしみ"],["の"],["とき"],["に"],["、"],["なぜ"],["、"],["身","み"],["を"],["隠される","かくされる"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"悪者は高ぶって、悩む人に追い迫ります。彼らが、おのれの設けたたくらみにみずから捕らえられますように。","tok":[["悪者","わるもの"],["は"],["高ぶって","たかぶって"],["、"],["悩む","なやむ"],["人","ひと"],["に"],["追い迫ります","おいせまります"],["。"],["彼","かれ"],["ら"],["が"],["、"],["おのれ"],["の"],["設けた","もうけた"],["たくらみ"],["に"],["みずから"],["捕らえられます","とらえられます"],["よう"],["に"],["。"]]},{"verse":3,"text":"悪者はおのれの心の欲望を誇り、貪欲な者は、主をのろい、また、侮る。","tok":[["悪者","わるもの"],["は"],["おのれ"],["の"],["心","こころ"],["の"],["欲望","よくぼう"],["を"],["誇り","ほこり"],["、"],["貪欲","どんよく"],["な"],["者","もの"],["は"],["、"],["主","ぬし"],["を"],["のろい"],["、"],["また"],["、"],["侮る","あなどる"],["。"]]},{"verse":4,"text":"悪者は高慢を顔に表して、神を尋ね求めない。その思いは「神はいない」の一言に尽きる。","tok":[["悪者","わるもの"],["は"],["高慢","こうまん"],["を"],["顔","かお"],["に"],["表して","あらわして"],["、"],["神","かみ"],["を"],["尋ね求めない","たずねもとめない"],["。"],["その"],["思い","おもい"],["は"],["「"],["神","かみ"],["は"],["いない"],["」"],["の"],["一言","ひとこと"],["に"],["尽きる","つきる"],["。"]]},{"verse":5,"text":"彼の道はいつも栄え、あなたのさばきは高くて、彼の目に、入らない。敵という敵を、彼は吹き飛ばす。","tok":[["彼","かれ"],["の"],["道","みち"],["は"],["いつ"],["も"],["栄え","さかえ"],["、"],["あなた"],["の"],["さばき"],["は"],["高くて","たかくて"],["、"],["彼","かれ"],["の"],["目","め"],["に"],["、"],["入らない","はいらない"],["。"],["敵","てき"],["と"],["いう"],["敵","てき"],["を"],["、"],["彼","かれ"],["は"],["吹き飛ばす","ふきとばす"],["。"]]},{"verse":6,"text":"彼は心の中で言う。「私はゆるぐことがなく、代々にわたって、わざわいに会わない。」","tok":[["彼","かれ"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["言う","ゆう"],["。"],["「"],["私","わたくし"],["は"],["ゆるぐ"],["こと"],["が"],["なく"],["、"],["代々","だいだい"],["に"],["わたって"],["、"],["わざわい"],["に"],["会わない","あわない"],["。"],["」"]]},{"verse":7,"text":"彼の口は、のろいと欺きとしいたげに満ち、彼の舌の裏には害毒と悪意がある。","tok":[["彼","かれ"],["の"],["口","くち"],["は"],["、"],["のろい"],["と"],["欺き","あざむき"],["と"],["しいたげ"],["に"],["満ち","みち"],["、"],["彼","かれ"],["の"],["舌","した"],["の"],["裏","うら"],["に"],["は"],["害毒","がいどく"],["と"],["悪意","あくい"],["が"],["ある"],["。"]]},{"verse":8,"text":"彼は村はずれの待ち伏せ場にすわり、隠れた所で、罪のない人を殺す。彼の目は不幸な人をねらっている。","tok":[["彼","かれ"],["は"],["村はずれ","むらはずれ"],["の"],["待ち伏せ","まちぶせ"],["場","ば"],["に"],["すわり"],["、"],["隠れた","かくれた"],["所","ところ"],["で"],["、"],["罪","つみ"],["の"],["ない"],["人","ひと"],["を"],["殺す","ころす"],["。"],["彼","かれ"],["の"],["目","め"],["は"],["不幸","ふこう"],["な"],["人","ひと"],["を"],["ねらって"],["いる"],["。"]]},{"verse":9,"text":"彼は茂みの中の獅子のように隠れ場で待ち伏せている。彼は悩む人を捕らえようと待ち伏せる。悩む人を、その網にかけて捕らえてしまう。","tok":[["彼","かれ"],["は"],["茂み","しげみ"],["の"],["中","なか"],["の"],["獅子","しし"],["の"],["よう"],["に"],["隠れ場","かくれば"],["で"],["待ち伏せて","まちぶせて"],["いる"],["。"],["彼","かれ"],["は"],["悩む","なやむ"],["人","ひと"],["を"],["捕らえよう","とらえよう"],["と"],["待ち伏せる","まちぶせる"],["。"],["悩む","なやむ"],["人","ひと"],["を"],["、"],["その"],["網","あみ"],["に"],["かけて"],["捕らえて","とらえて"],["しまう"],["。"]]},{"verse":10,"text":"不幸な人は、強い者によって砕かれ、うずくまり、倒れる。","tok":[["不幸","ふこう"],["な"],["人","ひと"],["は"],["、"],["強い","つよい"],["者","もの"],["によって"],["砕かれ","くだかれ"],["、"],["うずくまり"],["、"],["倒れる","たおれる"],["。"]]},{"verse":11,"text":"彼は心の中で言う。「神は忘れている。顔を隠している。彼は決して見はしないのだ。」","tok":[["彼","かれ"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["言う","ゆう"],["。"],["「"],["神","かみ"],["は"],["忘れて","わすれて"],["いる"],["。"],["顔","かお"],["を"],["隠して","かくして"],["いる"],["。"],["彼","かれ"],["は"],["決して","けっして"],["見","み"],["は"],["しない"],["の"],["だ"],["。"],["」"]]},{"verse":12,"text":"主よ。立ち上がってください。神よ。御手を上げてください。どうか、貧しい者を、忘れないでください。","tok":[["主","ぬし"],["よ"],["。"],["立ち上がって","たちあがって"],["ください"],["。"],["神","かみ"],["よ"],["。"],["御手","おて"],["を"],["上げて","あげて"],["ください"],["。"],["どう"],["か"],["、"],["貧しい","まずしい"],["者","もの"],["を"],["、"],["忘れないで","わすれないで"],["ください"],["。"]]},{"verse":13,"text":"なぜ、悪者は、神を侮るのでしょうか。彼は心の中で、あなたは追い求めないと言っています。","tok":[["なぜ"],["、"],["悪者","わるもの"],["は"],["、"],["神","かみ"],["を"],["侮る","あなどる"],["の"],["でしょう"],["か"],["。"],["彼","かれ"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["あなた"],["は"],["追い求めない","おいもとめない"],["と"],["言って","いって"],["います"],["。"]]},{"verse":14,"text":"あなたは、見ておられました。害毒と苦痛を。彼らを御手の中に収めるためにじっと見つめておられました。不幸な人は、あなたに身をゆだねます。あなたはみなしごを助ける方でした。","tok":[["あなた"],["は"],["、"],["見て","みて"],["おられました"],["。"],["害毒","がいどく"],["と"],["苦痛","くつう"],["を"],["。"],["彼","かれ"],["ら"],["を"],["御手","おて"],["の"],["中","なか"],["に"],["収める","おさめる"],["ため"],["に"],["じっと"],["見つめて","みつめて"],["おられました"],["。"],["不幸","ふこう"],["な"],["人","ひと"],["は"],["、"],["あなた"],["に"],["身","み"],["を"],["ゆだねます"],["。"],["あなた"],["は"],["みなしご"],["を"],["助ける","たすける"],["方","かた"],["でした"],["。"]]},{"verse":15,"text":"悪者と、よこしまな者の腕を折り、その悪を捜し求めて一つも残らぬようにしてください。","tok":[["悪者","わるもの"],["と"],["、"],["よこしま"],["な"],["者","もの"],["の"],["腕","うで"],["を"],["折り","おり"],["、"],["その"],["悪","あく"],["を"],["捜し求めて","さがしもとめて"],["一","ひと"],["つ"],["も"],["残らぬ","のこらぬ"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":16,"text":"主は世々限りなく王である。国々は、主の地から滅びうせた。","tok":[["主","ぬし"],["は"],["世々","せいせい"],["限りなく","かぎりなく"],["王","おう"],["で"],["ある"],["。"],["国々","くにぐに"],["は"],["、"],["主","ぬし"],["の"],["地","ち"],["から"],["滅び","ほろび"],["うせた"],["。"]]},{"verse":17,"text":"主よ。あなたは貧しい者の願いを聞いてくださいました。あなたは彼らの心を強くしてくださいます。耳を傾けて、","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["は"],["貧しい","まずしい"],["者","もの"],["の"],["願い","ねがい"],["を"],["聞いて","きいて"],["くださいました"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["強く","つよく"],["して"],["くださいます"],["。"],["耳","みみ"],["を"],["傾けて","かたむけて"],["、"]]},{"verse":18,"text":"みなしごと、しいたげられた者をかばってくださいます。地から生まれた人間がもはや、脅かすことができないように。","tok":[["みなしご"],["と"],["、"],["しいたげられた"],["者","もの"],["を"],["かばって"],["くださいます"],["。"],["地","ち"],["から"],["生まれた","うまれた"],["人間","にんげん"],["が"],["もはや"],["、"],["脅かす","おびやかす"],["こと"],["が"],["できない"],["よう"],["に"],["。"]]}]
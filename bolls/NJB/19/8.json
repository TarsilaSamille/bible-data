[{"verse":1,"text":"（指揮者のために。ギテトの調べに合わせて。ダビデの賛歌）私たちの主、主よ。あなたの御名は全地にわたり、なんと力強いことでしょう。あなたのご威光は天でたたえられています。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ギテト"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["私たち","わたしたち"],["の"],["主","ぬし"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["御名","ぎょめい"],["は"],["全地","ぜんち"],["に"],["わたり"],["、"],["なん"],["と"],["力強い","ちからづよい"],["こと"],["でしょう"],["。"],["あなた"],["の"],["ご威光","ごいこう"],["は"],["天","てん"],["で"],["たたえられて"],["います"],["。"]]},{"verse":2,"text":"あなたは幼子と乳飲み子たちの口によって、力を打ち建てられました。それは、あなたに敵対する者のため、敵と復讐する者とをしずめるためでした。","tok":[["あなた"],["は"],["幼子","おさなご"],["と"],["乳飲み子","ちのみご"],["たち"],["の"],["口","くち"],["によって"],["、"],["力","ちから"],["を"],["打ち建てられました","うちたてられました"],["。"],["それ"],["は"],["、"],["あなた"],["に"],["敵対","てきたい"],["する"],["者","もの"],["の"],["ため"],["、"],["敵","てき"],["と"],["復讐","ふくしゅう"],["する"],["者","もの"],["と"],["を"],["しずめる"],["ため"],["でした"],["。"]]},{"verse":3,"text":"あなたの指のわざである天を見、あなたが整えられた月や星を見ますのに、","tok":[["あなた"],["の"],["指","ゆび"],["の"],["わざ"],["で"],["ある"],["天","てん"],["を"],["見","み"],["、"],["あなた"],["が"],["整えられた","ととのえられた"],["月","つき"],["や"],["星","ほし"],["を"],["見ます","みます"],["のに"],["、"]]},{"verse":4,"text":"人とは、何者なのでしょう。あなたがこれを心に留められるとは。人の子とは、何者なのでしょう。あなたがこれを顧みられるとは。","tok":[["人","ひと"],["と"],["は"],["、"],["何者","なにもの"],["な"],["の"],["でしょう"],["。"],["あなた"],["が"],["これ"],["を"],["心","こころ"],["に"],["留められる","とめられる"],["と"],["は"],["。"],["人","ひと"],["の"],["子","こ"],["と"],["は"],["、"],["何者","なにもの"],["な"],["の"],["でしょう"],["。"],["あなた"],["が"],["これ"],["を"],["顧みられる","かえりみられる"],["と"],["は"],["。"]]},{"verse":5,"text":"あなたは、人を、神よりいくらか劣るものとし、これに栄光と誉れの冠をかぶらせました。","tok":[["あなた"],["は"],["、"],["人","ひと"],["を"],["、"],["神","かみ"],["より"],["いくら"],["か"],["劣る","おとる"],["もの"],["と"],["し"],["、"],["これ"],["に"],["栄光","えいこう"],["と"],["誉れ","ほまれ"],["の"],["冠","かんむり"],["を"],["かぶらせました"],["。"]]},{"verse":6,"text":"あなたの御手の多くのわざを人に治めさせ、万物を彼の足の下に置かれました。","tok":[["あなた"],["の"],["御手","おて"],["の"],["多く","おおく"],["の"],["わざ"],["を"],["人","ひと"],["に"],["治めさせ","おさめさせ"],["、"],["万物","ばんぶつ"],["を"],["彼","かれ"],["の"],["足","あし"],["の"],["下","した"],["に"],["置かれました","おかれました"],["。"]]},{"verse":7,"text":"すべて、羊も牛も、また、野の獣も、","tok":[["すべて"],["、"],["羊","ひつじ"],["も"],["牛","うし"],["も"],["、"],["また"],["、"],["野","の"],["の"],["獣","けもの"],["も"],["、"]]},{"verse":8,"text":"空の鳥、海の魚、海路を通うものも。","tok":[["空","そら"],["の"],["鳥","とり"],["、"],["海","うみ"],["の"],["魚","さかな"],["、"],["海路","かいろ"],["を"],["通う","かよう"],["もの"],["も"],["。"]]},{"verse":9,"text":"私たちの主、主よ。あなたの御名は全地にわたり、なんと力強いことでしょう。","tok":[["私たち","わたしたち"],["の"],["主","ぬし"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["御名","ぎょめい"],["は"],["全地","ぜんち"],["に"],["わたり"],["、"],["なん"],["と"],["力強い","ちからづよい"],["こと"],["でしょう"],["。"]]}]
[{"verse":1,"text":"ハレルヤ。幸いなことよ。主を恐れ、その仰せを大いに喜ぶ人は。","tok":[["ハレルヤ"],["。"],["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["その"],["仰せ","おおせ"],["を"],["大いに","おおいに"],["喜ぶ","よろこぶ"],["人","ひと"],["は"],["。"]]},{"verse":2,"text":"その人の子孫は地上で力ある者となり、直ぐな人たちの世代は祝福されよう。","tok":[["その"],["人","ひと"],["の"],["子孫","しそん"],["は"],["地上","ちじょう"],["で"],["力","ちから"],["ある"],["者","もの"],["と"],["なり"],["、"],["直ぐ","すぐ"],["な"],["人","ひと"],["たち"],["の"],["世代","せだい"],["は"],["祝福","しゅくふく"],["されよう"],["。"]]},{"verse":3,"text":"繁栄と富とはその家にあり、彼の義は永遠に堅く立つ。","tok":[["繁栄","はんえい"],["と"],["富","とみ"],["と"],["は"],["その"],["家","いえ"],["に"],["あり"],["、"],["彼","かれ"],["の"],["義","ぎ"],["は"],["永遠","えいえん"],["に"],["堅く","かたく"],["立つ","たつ"],["。"]]},{"verse":4,"text":"主は直ぐな人たちのために、光をやみの中に輝かす。主は情け深く、あわれみ深く、正しくあられる。","tok":[["主","ぬし"],["は"],["直ぐ","すぐ"],["な"],["人","ひと"],["たち"],["の"],["ため"],["に"],["、"],["光","ひかり"],["を"],["やみ"],["の"],["中","なか"],["に"],["輝かす","かがやかす"],["。"],["主","ぬし"],["は"],["情け深く","なさけぶかく"],["、"],["あわれみ"],["深く","ふかく"],["、"],["正しく","まさしく"],["あられる"],["。"]]},{"verse":5,"text":"しあわせなことよ。情け深く、人には貸し、自分のことを公正に取り行う人は。","tok":[["しあわせ"],["な"],["こと"],["よ"],["。"],["情け深く","なさけぶかく"],["、"],["人","ひと"],["に"],["は"],["貸し","かし"],["、"],["自分","じぶん"],["の"],["こと"],["を"],["公正","こうせい"],["に"],["取り行う","とりおこなう"],["人","ひと"],["は"],["。"]]},{"verse":6,"text":"彼は決してゆるがされない。正しい者はとこしえに覚えられる。","tok":[["彼","かれ"],["は"],["決して","けっして"],["ゆるがされない"],["。"],["正しい","ただしい"],["者","もの"],["は"],["とこしえ"],["に"],["覚えられる","おぼえられる"],["。"]]},{"verse":7,"text":"その人は悪い知らせを恐れず、主に信頼して、その心はゆるがない。","tok":[["その"],["人","ひと"],["は"],["悪い","わるい"],["知らせ","しらせ"],["を"],["恐れず","おそれず"],["、"],["主に","おもに"],["信頼","しんらい"],["して"],["、"],["その"],["心","こころ"],["は"],["ゆるがない"],["。"]]},{"verse":8,"text":"その心は堅固で、恐れることなく、自分の敵をものともしないまでになる。","tok":[["その"],["心","こころ"],["は"],["堅固","けんご"],["で"],["、"],["恐れる","おそれる"],["こと"],["なく"],["、"],["自分","じぶん"],["の"],["敵","てき"],["を"],["もの"],["と"],["も"],["しない"],["まで"],["に"],["なる"],["。"]]},{"verse":9,"text":"彼は貧しい人々に惜しみなく分け与えた。彼の義は永遠に堅く立つ。その角は栄光のうちに高く上げられる。","tok":[["彼","かれ"],["は"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["惜しみなく","おしみなく"],["分け与えた","わけあたえた"],["。"],["彼","かれ"],["の"],["義","ぎ"],["は"],["永遠","えいえん"],["に"],["堅く","かたく"],["立つ","たつ"],["。"],["その"],["角","かど"],["は"],["栄光","えいこう"],["の"],["うち"],["に"],["高く","たかく"],["上げられる","あげられる"],["。"]]},{"verse":10,"text":"悪者はそれを見ていらだち、歯ぎしりして溶け去る。悪者の願いは滅びうせる。","tok":[["悪者","わるもの"],["は"],["それ"],["を"],["見て","みて"],["いらだち"],["、"],["歯ぎしり","はぎしり"],["して"],["溶け去る","とけさる"],["。"],["悪者","わるもの"],["の"],["願い","ねがい"],["は"],["滅び","ほろび"],["うせる"],["。"]]}]
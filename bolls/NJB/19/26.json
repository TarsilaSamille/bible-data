[{"verse":1,"text":"（ダビデによる）私を弁護してください。主よ。私が誠実に歩み、よろめくことなく、主に信頼したことを。","tok":[["（"],["ダビデ"],["に"],["よる"],["）"],["私","わたくし"],["を"],["弁護","べんご"],["して"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["が"],["誠実","せいじつ"],["に"],["歩み","あゆみ"],["、"],["よろめく"],["こと"],["なく"],["、"],["主に","おもに"],["信頼","しんらい"],["した"],["こと"],["を"],["。"]]},{"verse":2,"text":"主よ。私を調べ、私を試みてください。私の思いと私の心をためしてください。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["を"],["調べ","しらべ"],["、"],["私","わたくし"],["を"],["試みて","こころみて"],["ください"],["。"],["私","わたくし"],["の"],["思い","おもい"],["と"],["私","わたくし"],["の"],["心","こころ"],["を"],["ためして"],["ください"],["。"]]},{"verse":3,"text":"あなたの恵みが私の目の前にあり、私はあなたの真理のうちを歩み続けました。","tok":[["あなた"],["の"],["恵み","めぐみ"],["が"],["私","わたくし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あり"],["、"],["私","わたくし"],["は"],["あなた"],["の"],["真理","しんり"],["の"],["うち"],["を"],["歩み","あゆみ"],["続けました","つづけました"],["。"]]},{"verse":4,"text":"私は、不信実な人とともにすわらず、偽善者とともに行きません。","tok":[["私","わたくし"],["は"],["、"],["不","ふ"],["信実","しんじつ"],["な"],["人","ひと"],["と"],["とも"],["に"],["すわらず"],["、"],["偽善者","ぎぜんしゃ"],["と"],["とも"],["に"],["行きません","いきません"],["。"]]},{"verse":5,"text":"私は、悪を行う者の集まりを憎み、悪者とともにすわりません。","tok":[["私","わたくし"],["は"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["の"],["集まり","あつまり"],["を"],["憎み","にくみ"],["、"],["悪者","わるもの"],["と"],["とも"],["に"],["すわりません"],["。"]]},{"verse":6,"text":"主よ。私は手を洗ってきよくし、あなたの祭壇の回りを歩きましょう。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["手","て"],["を"],["洗って","あらって"],["きよく"],["し"],["、"],["あなた"],["の"],["祭壇","さいだん"],["の"],["回り","まわり"],["を"],["歩きましょう","あるきましょう"],["。"]]},{"verse":7,"text":"感謝の声を聞こえさせ、あなたの奇しいみわざを余すことなく、語り告げましょう。","tok":[["感謝","かんしゃ"],["の"],["声","こえ"],["を"],["聞こえさせ","きこえさせ"],["、"],["あなた"],["の"],["奇しい","くすしい"],["みわざ"],["を"],["余す","あます"],["こと"],["なく"],["、"],["語り告げましょう","かたりつげましょう"],["。"]]},{"verse":8,"text":"主よ。私は、あなたのおられる家と、あなたの栄光の住まう所を愛します。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["、"],["あなた"],["の"],["おられる"],["家","いえ"],["と"],["、"],["あなた"],["の"],["栄光","えいこう"],["の"],["住まう","すまう"],["所","ところ"],["を"],["愛します","あいします"],["。"]]},{"verse":9,"text":"どうか私のたましいを罪人とともに、また、私のいのちを血を流す人々とともに、取り集めないでください。","tok":[["どう"],["か"],["私","わたくし"],["の"],["たましい"],["を"],["罪人","ざいにん"],["と"],["とも"],["に"],["、"],["また"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["血","ち"],["を"],["流す","ながす"],["人々","ひとびと"],["と"],["とも"],["に"],["、"],["取り集めないで","とりあつめないで"],["ください"],["。"]]},{"verse":10,"text":"彼らの両手には放らつがあり、彼らの右の手はわいろで満ちています。","tok":[["彼","かれ"],["ら"],["の"],["両手","りょうて"],["に"],["は"],["放らつ","ほうらつ"],["が"],["あり"],["、"],["彼","かれ"],["ら"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["わいろ"],["で"],["満ちて","みちて"],["います"],["。"]]},{"verse":11,"text":"しかし、私は、誠実に歩みます。どうか私を贖い出し、私をあわれんでください。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["、"],["誠実","せいじつ"],["に"],["歩みます","あゆみます"],["。"],["どう"],["か"],["私","わたくし"],["を"],["贖い","あがない"],["出し","だし"],["、"],["私","わたくし"],["を"],["あわれんで"],["ください"],["。"]]},{"verse":12,"text":"私の足は平らな所に立っています。私は、数々の集まりの中で、主をほめたたえましょう。","tok":[["私","わたくし"],["の"],["足","あし"],["は"],["平ら","たいら"],["な"],["所","ところ"],["に"],["立って","たって"],["います"],["。"],["私","わたくし"],["は"],["、"],["数々","かずかず"],["の"],["集まり","あつまり"],["の"],["中","なか"],["で"],["、"],["主","ぬし"],["を"],["ほめたたえましょう"],["。"]]}]
[{"verse":1,"text":"（ダビデによる）主よ。私のたましいは、あなたを仰いでいます。","tok":[["（"],["ダビデ"],["に"],["よる"],["）"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["たましい"],["は"],["、"],["あなた"],["を"],["仰いで","あおいで"],["います"],["。"]]},{"verse":2,"text":"わが神。私は、あなたに信頼いたします。どうか私が恥を見ないようにしてください。私の敵が私に勝ち誇らないようにしてください。","tok":[["わが"],["神","かみ"],["。"],["私","わたくし"],["は"],["、"],["あなた"],["に"],["信頼","しんらい"],["いたします"],["。"],["どう"],["か"],["私","わたくし"],["が"],["恥","はじ"],["を"],["見ない","みない"],["よう"],["に"],["して"],["ください"],["。"],["私","わたくし"],["の"],["敵","てき"],["が"],["私","わたくし"],["に"],["勝ち誇らない","かちほこらない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":3,"text":"まことに、あなたを待ち望む者はだれも恥を見ません。ゆえもなく裏切る者は恥を見ます。","tok":[["まこと"],["に"],["、"],["あなた"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["は"],["だれ"],["も"],["恥","はじ"],["を"],["見ません","みません"],["。"],["ゆえ"],["も"],["なく"],["裏切る","うらぎる"],["者","もの"],["は"],["恥","はじ"],["を"],["見ます","みます"],["。"]]},{"verse":4,"text":"主よ。あなたの道を私に知らせ、あなたの小道を私に教えてください。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["道","みち"],["を"],["私","わたくし"],["に"],["知らせ","しらせ"],["、"],["あなた"],["の"],["小道","こみち"],["を"],["私","わたくし"],["に"],["教えて","おしえて"],["ください"],["。"]]},{"verse":5,"text":"あなたの真理のうちに私を導き、私を教えてください。あなたこそ、私の救いの神、私は、あなたを一日中待ち望んでいるのです。","tok":[["あなた"],["の"],["真理","しんり"],["の"],["うち"],["に"],["私","わたくし"],["を"],["導き","みちびき"],["、"],["私","わたくし"],["を"],["教えて","おしえて"],["ください"],["。"],["あなた"],["こそ"],["、"],["私","わたくし"],["の"],["救い","すくい"],["の"],["神","かみ"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["を"],["一","いち"],["日中","にちちゅう"],["待ち望んで","まちのぞんで"],["いる"],["の"],["です"],["。"]]},{"verse":6,"text":"主よ。あなたのあわれみと恵みを覚えていてください。それらはとこしえからあったのですから。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["あわれみ"],["と"],["恵み","めぐみ"],["を"],["覚えて","おぼえて"],["いて"],["ください"],["。"],["それ"],["ら"],["は"],["とこしえ"],["から"],["あった"],["の"],["です"],["から"],["。"]]},{"verse":7,"text":"私の若い時の罪やそむきを覚えていないでください。あなたの恵みによって、私を覚えていてください。主よ。あなたのいつくしみのゆえに。","tok":[["私","わたくし"],["の"],["若い","わかい"],["時","とき"],["の"],["罪","つみ"],["や"],["そむき"],["を"],["覚えて","おぼえて"],["いないで"],["ください"],["。"],["あなた"],["の"],["恵み","めぐみ"],["によって"],["、"],["私","わたくし"],["を"],["覚えて","おぼえて"],["いて"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["いつくしみ"],["の"],["ゆえ"],["に"],["。"]]},{"verse":8,"text":"主は、いつくしみ深く、正しくあられる。それゆえ、罪人に道を教えられる。","tok":[["主","ぬし"],["は"],["、"],["いつくしみ"],["深く","ふかく"],["、"],["正しく","まさしく"],["あられる"],["。"],["それ"],["ゆえ"],["、"],["罪人","ざいにん"],["に"],["道","みち"],["を"],["教えられる","おしえられる"],["。"]]},{"verse":9,"text":"主は貧しい者を公義に導き、貧しい者にご自身の道を教えられる。","tok":[["主","ぬし"],["は"],["貧しい","まずしい"],["者","もの"],["を"],["公義","きみよし"],["に"],["導き","みちびき"],["、"],["貧しい","まずしい"],["者","もの"],["に"],["ご自身","ごじしん"],["の"],["道","みち"],["を"],["教えられる","おしえられる"],["。"]]},{"verse":10,"text":"主の小道はみな恵みと、まことである。その契約とそのさとしを守る者には。","tok":[["主","ぬし"],["の"],["小道","こみち"],["は"],["みな"],["恵み","めぐみ"],["と"],["、"],["まこと"],["で"],["ある"],["。"],["その"],["契約","けいやく"],["と"],["その"],["さとし"],["を"],["守る","まもる"],["者","もの"],["に"],["は"],["。"]]},{"verse":11,"text":"主よ。御名のために、私の咎をお赦しください。大きな咎を。","tok":[["主","ぬし"],["よ"],["。"],["御名","ぎょめい"],["の"],["ため"],["に"],["、"],["私","わたくし"],["の"],["咎","とが"],["を"],["お赦し","おゆるし"],["ください"],["。"],["大きな","おおきな"],["咎","とが"],["を"],["。"]]},{"verse":12,"text":"主を恐れる人は、だれか。主はその人に選ぶべき道を教えられる。","tok":[["主","ぬし"],["を"],["恐れる","おそれる"],["人","ひと"],["は"],["、"],["だれ"],["か"],["。"],["主","ぬし"],["は"],["その"],["人","ひと"],["に"],["選ぶべき","えらぶべき"],["道","みち"],["を"],["教えられる","おしえられる"],["。"]]},{"verse":13,"text":"その人のたましいは、しあわせの中に住み、その子孫は地を受け継ごう。","tok":[["その"],["人","ひと"],["の"],["たましい"],["は"],["、"],["しあわせ"],["の"],["中","なか"],["に"],["住み","すみ"],["、"],["その"],["子孫","しそん"],["は"],["地","ち"],["を"],["受け継ごう","うけつごう"],["。"]]},{"verse":14,"text":"主はご自身を恐れる者と親しくされ、ご自身の契約を彼らにお知らせになる。","tok":[["主","ぬし"],["は"],["ご自身","ごじしん"],["を"],["恐れる","おそれる"],["者","もの"],["と"],["親しく","したしく"],["され"],["、"],["ご自身","ごじしん"],["の"],["契約","けいやく"],["を"],["彼","かれ"],["ら"],["に"],["お知らせ","おしらせ"],["に"],["なる"],["。"]]},{"verse":15,"text":"私の目はいつも主に向かう。主が私の足を網から引き出してくださるから。","tok":[["私","わたくし"],["の"],["目","め"],["は"],["いつも"],["主に","おもに"],["向かう","むかう"],["。"],["主","ぬし"],["が"],["私","わたくし"],["の"],["足","あし"],["を"],["網","あみ"],["から"],["引き出して","ひきだして"],["くださる"],["から"],["。"]]},{"verse":16,"text":"私に御顔を向け、私をあわれんでください。私はただひとりで、悩んでいます。","tok":[["私","わたくし"],["に"],["御顔","おかお"],["を"],["向け","むけ"],["、"],["私","わたくし"],["を"],["あわれんで"],["ください"],["。"],["私","わたくし"],["は"],["ただ"],["ひとり"],["で"],["、"],["悩んで","なやんで"],["います"],["。"]]},{"verse":17,"text":"私の心の苦しみが大きくなりました。どうか、苦悩のうちから私を引き出してください。","tok":[["私","わたくし"],["の"],["心","こころ"],["の"],["苦しみ","くるしみ"],["が"],["大きく","おおきく"],["なりました"],["。"],["どう"],["か"],["、"],["苦悩","くのう"],["の"],["うち"],["から"],["私","わたくし"],["を"],["引き出して","ひきだして"],["ください"],["。"]]},{"verse":18,"text":"私の悩みと労苦を見て、私のすべての罪を赦してください。","tok":[["私","わたくし"],["の"],["悩み","なやみ"],["と"],["労苦","ろうく"],["を"],["見て","みて"],["、"],["私","わたくし"],["の"],["すべて"],["の"],["罪","つみ"],["を"],["赦して","ゆるして"],["ください"],["。"]]},{"verse":19,"text":"私の敵がどんなに多いかを見てください。彼らは暴虐な憎しみで、私を憎んでいます。","tok":[["私","わたくし"],["の"],["敵","てき"],["が"],["どんな"],["に"],["多い","おおい"],["か"],["を"],["見て","みて"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["暴虐","ぼうぎゃく"],["な"],["憎しみ","にくしみ"],["で"],["、"],["私","わたくし"],["を"],["憎んで","にくんで"],["います"],["。"]]},{"verse":20,"text":"私のたましいを守り、私を救い出してください。私が恥を見ないようにしてください。私はあなたに身を避けています。","tok":[["私","わたくし"],["の"],["たましい"],["を"],["守り","まもり"],["、"],["私","わたくし"],["を"],["救い出して","すくいだして"],["ください"],["。"],["私","わたくし"],["が"],["恥","はじ"],["を"],["見ない","みない"],["よう"],["に"],["して"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["身","み"],["を"],["避けて","さけて"],["います"],["。"]]},{"verse":21,"text":"誠実と正しさが私を保ちますように。私はあなたを待ち望んでいます。","tok":[["誠実","せいじつ"],["と"],["正し","ただし"],["さ"],["が"],["私","わたくし"],["を"],["保ちます","たもちます"],["よう"],["に"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["待ち望んで","まちのぞんで"],["います"],["。"]]},{"verse":22,"text":"神よ。イスラエルを、そのすべての苦しみから贖い出してください。","tok":[["神","かみ"],["よ"],["。"],["イスラエル"],["を"],["、"],["その"],["すべて"],["の"],["苦しみ","くるしみ"],["から"],["贖い","あがない"],["出して","だして"],["ください"],["。"]]}]
[{"verse":1,"text":"（指揮者のために。「暁の雌鹿」の調べに合わせて。ダビデの賛歌）わが神、わが神。どうして、私をお見捨てになったのですか。遠く離れて私をお救いにならないのですか。私のうめきのことばにも。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["「"],["暁","あかつき"],["の"],["雌鹿","めじか"],["」"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["わが"],["神","かみ"],["、"],["わが"],["神","かみ"],["。"],["どう"],["して"],["、"],["私","わたくし"],["を"],["お見捨て","おみすて"],["に"],["なった"],["の"],["です"],["か"],["。"],["遠く","とおく"],["離れて","はなれて"],["私","わたくし"],["を"],["お救い","おすくい"],["に"],["ならない"],["の"],["です"],["か"],["。"],["私","わたくし"],["の"],["うめき"],["の"],["ことば"],["に"],["も"],["。"]]},{"verse":2,"text":"わが神。昼、私は呼びます。しかし、あなたはお答えになりません。夜も、私は黙っていられません。","tok":[["わが"],["神","かみ"],["。"],["昼","ひる"],["、"],["私","わたくし"],["は"],["呼びます","よびます"],["。"],["しかし"],["、"],["あなた"],["は"],["お答え","おこたえ"],["に"],["なりません"],["。"],["夜","よる"],["も"],["、"],["私","わたくし"],["は"],["黙って","だまって"],["いられません"],["。"]]},{"verse":3,"text":"けれども、あなたは聖であられ、イスラエルの賛美を住まいとしておられます。","tok":[["けれど"],["も"],["、"],["あなた"],["は"],["聖","せい"],["で"],["あられ"],["、"],["イスラエル"],["の"],["賛美","さんび"],["を"],["住まい","すまい"],["として"],["おられます"],["。"]]},{"verse":4,"text":"私たちの先祖は、あなたに信頼しました。彼らは信頼し、あなたは彼らを助け出されました。","tok":[["私たち","わたしたち"],["の"],["先祖","せんぞ"],["は"],["、"],["あなた"],["に"],["信頼","しんらい"],["しました"],["。"],["彼","かれ"],["ら"],["は"],["信頼","しんらい"],["し"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["助け出されました","たすけだされました"],["。"]]},{"verse":5,"text":"彼らはあなたに叫び、彼らは助け出されました。彼らはあなたに信頼し、彼らは恥を見ませんでした。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["に"],["叫び","さけび"],["、"],["彼","かれ"],["ら"],["は"],["助け出されました","たすけだされました"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["信頼","しんらい"],["し"],["、"],["彼","かれ"],["ら"],["は"],["恥","はじ"],["を"],["見ませんでした","みませんでした"],["。"]]},{"verse":6,"text":"しかし、私は虫けらです。人間ではありません。人のそしり、民のさげすみです。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["虫けら","むしけら"],["です"],["。"],["人間","にんげん"],["で"],["は"],["ありません"],["。"],["人","ひと"],["の"],["そしり"],["、"],["民","みん"],["の"],["さげすみです"],["。"]]},{"verse":7,"text":"私を見る者はみな、私をあざけります。彼らは口をとがらせ、頭を振ります。","tok":[["私","わたくし
[{"verse":1,"text":"（ダビデによる）私は心を尽くしてあなたに感謝します。天使たちの前であなたをほめ歌います。","tok":[["（"],["ダビデ"],["に"],["よる"],["）"],["私","わたくし"],["は"],["心","こころ"],["を"],["尽くして","つくして"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"],["天使","てんし"],["たち"],["の"],["前","まえ"],["で"],["あなた"],["を"],["ほめ"],["歌います","うたいます"],["。"]]},{"verse":2,"text":"私はあなたの聖なる宮に向かってひれ伏し、あなたの恵みとまことをあなたの御名に感謝します。あなたは、ご自分のすべての御名のゆえに、あなたのみことばを高く上げられたからです。","tok":[["私","わたくし"],["は"],["あなた"],["の"],["聖","せい"],["なる"],["宮","みや"],["に"],["向かって","むかって"],["ひれ伏し","ひれふし"],["、"],["あなた"],["の"],["恵み","めぐみ"],["と"],["まこと"],["を"],["あなた"],["の"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["します"],["。"],["あなた"],["は"],["、"],["ご自分","ごじぶん"],["の"],["すべて"],["の"],["御名","ぎょめい"],["の"],["ゆえ"],["に"],["、"],["あなた"],["のみ"],["ことば"],["を"],["高く","たかく"],["上げられた","あげられた"],["から"],["です"],["。"]]},{"verse":3,"text":"私が呼んだその日に、あなたは私に答え、私のたましいに力を与えて強くされました。","tok":[["私","わたくし"],["が"],["呼んだ","よんだ"],["その"],["日","ひ"],["に"],["、"],["あなた"],["は"],["私","わたくし"],["に"],["答え","こたえ"],["、"],["私","わたくし"],["の"],["たましい"],["に"],["力","ちから"],["を"],["与えて","あたえて"],["強く","つよく"],["されました"],["。"]]},{"verse":4,"text":"主よ。地のすべての王たちは、あなたに感謝しましょう。彼らがあなたの口のみことばを聞いたからです。","tok":[["主","ぬし"],["よ"],["。"],["地","ち"],["の"],["すべて"],["の"],["王","おう"],["たち"],["は"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["しましょう"],["。"],["彼","かれ"],["ら"],["が"],["あなた"],["の"],["口","くち"],["のみ"],["ことば"],["を"],["聞いた","きいた"],["から"],["です"],["。"]]},{"verse":5,"text":"彼らは主の道について歌うでしょう。主の栄光が大きいからです。","tok":[["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["道","みち"],["について"],["歌うでしょう","うたうでしょう"],["。"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["大きい","おおきい"],["から"],["です"],["。"]]},{"verse":6,"text":"まことに、主は高くあられるが、低い者を顧みてくださいます。しかし、高ぶる者を遠くから見抜かれます。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["高く","たかく"],["あられる"],["が"],["、"],["低い","ひくい"],["者","もの"],["を"],["顧みて","かえりみて"],["くださいます"],["。"],["しかし"],["、"],["高ぶる","たかぶる"],["者","もの"],["を"],["遠く","とおく"],["から"],["見抜かれます","みぬかれます"],["。"]]},{"verse":7,"text":"私が苦しみの中を歩いても、あなたは私を生かしてくださいます。私の敵の怒りに向かって御手を伸ばし、あなたの右の手が私を救ってくださいます。","tok":[["私","わたくし"],["が"],["苦しみ","くるしみ"],["の"],["中","なか"],["を"],["歩いて","あるいて"],["も"],["、"],["あなた"],["は"],["私","わたくし"],["を"],["生かして","いかして"],["くださいます"],["。"],["私","わたくし"],["の"],["敵","てき"],["の"],["怒り","いかり"],["に"],["向かって","むかって"],["御手","おて"],["を"],["伸ばし","のばし"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["が"],["私","わたくし"],["を"],["救って","すくって"],["くださいます"],["。"]]},{"verse":8,"text":"主は私にかかわるすべてのことを、成し遂げてくださいます。主よ。あなたの恵みはとこしえにあります。あなたの御手のわざを捨てないでください。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["かかわる"],["すべて"],["の"],["こと"],["を"],["、"],["成し遂げて","なしとげて"],["くださいます"],["。"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["恵み","めぐみ"],["は"],["とこしえ"],["に"],["あります"],["。"],["あなた"],["の"],["御手","おて"],["の"],["わざ"],["を"],["捨てないで","すてないで"],["ください"],["。"]]}]
[{"verse":1,"text":"（都上りの歌）あなたに向かって、私は目を上げます。天の御座に着いておられる方よ。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["あなた"],["に"],["向かって","むかって"],["、"],["私","わたくし"],["は"],["目","め"],["を"],["上げます","あげます"],["。"],["天","てん"],["の"],["御座","ぎょざ"],["に"],["着いて","ついて"],["おられる"],["方","かた"],["よ"],["。"]]},{"verse":2,"text":"ご覧ください。奴隷の目が主人の手に向けられ、女奴隷の目が女主人の手に向けられているように、私たちの目は私たちの神、主に向けられています。主が私たちをあわれまれるまで。","tok":[["ご覧","ごらん"],["ください"],["。"],["奴隷","どれい"],["の"],["目","め"],["が"],["主人","しゅじん"],["の"],["手","て"],["に"],["向けられ","むけられ"],["、"],["女","じょ"],["奴隷","どれい"],["の"],["目","め"],["が"],["女","じょ"],["主人","しゅじん"],["の"],["手","て"],["に"],["向けられて","むけられて"],["いる"],["よう"],["に"],["、"],["私たち","わたしたち"],["の"],["目","め"],["は"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["向けられて","むけられて"],["います"],["。"],["主","ぬし"],["が"],["私たち","わたしたち"],["を"],["あわれまれる"],["まで"],["。"]]},{"verse":3,"text":"私たちをあわれんでください。主よ。私たちをあわれんでください。私たちはさげすみで、もういっぱいです。","tok":[["私たち","わたしたち"],["を"],["あわれんで"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["私たち","わたしたち"],["を"],["あわれんで"],["ください"],["。"],["私たち","わたしたち"],["は"],["さげすみで"],["、"],["もう"],["いっぱい"],["です"],["。"]]},{"verse":4,"text":"私たちのたましいは、安逸をむさぼる者たちのあざけりと、高ぶる者たちのさげすみとで、もういっぱいです。","tok":[["私たち","わたしたち"],["の"],["たましい"],["は"],["、"],["安逸","あんいつ"],["を"],["むさぼる"],["者","もの"],["たち"],["の"],["あざけり"],["と"],["、"],["高ぶる","たかぶる"],["者","もの"],["たち"],["の"],["さげすみ"],["と"],["で"],["、"],["もう"],["いっぱい"],["です"],["。"]]}]
[{"verse":1,"text":"（歌。コラの子たちの賛歌。指揮者のため。マハラテ・レアノテの調べに合わせて。エズラフ人ヘマンのマスキール）主、私の救いの神。私は昼は、叫び、夜は、あなたの御前にいます。","tok":[["（"],["歌","うた"],["。"],["コラ"],["の"],["子","こ"],["たち"],["の"],["賛歌","さんか"],["。"],["指揮者","しきしゃ"],["の"],["ため"],["。"],["マハラテ"],["・"],["レアノテ"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["エズラフ"],["人","にん"],["ヘマン"],["の"],["マスキール"],["）"],["主","ぬし"],["、"],["私","わたくし"],["の"],["救い","すくい"],["の"],["神","かみ"],["。"],["私","わたくし"],["は"],["昼","ひる"],["は"],["、"],["叫び","さけび"],["、"],["夜","よる"],["は"],["、"],["あなた"],["の"],["御前","ごぜん"],["に"],["います"],["。"]]},{"verse":2,"text":"私の祈りがあなたの御前に届きますように。どうか、あなたの耳を私の叫びに傾けてください。","tok":[["私","わたくし"],["の"],["祈り","いのり"],["が"],["あなた"],["の"],["御前","ごぜん"],["に"],["届きます","とどきます"],["よう"],["に"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["耳","みみ"],["を"],["私","わたくし"],["の"],["叫び","さけび"],["に"],["傾けて","かたむけて"],["ください"],["。"]]},{"verse":3,"text":"私のたましいは、悩みに満ち、私のいのちは、よみに触れていますから。","tok":[["私","わたくし"],["の"],["たましい"],["は"],["、"],["悩み","なやみ"],["に"],["満ち","みち"],["、"],["私","わたくし"],["の"],["いのち"],["は"],["、"],["よみ"],["に"],["触れて","ふれて"],["います"],["から"],["。"]]},{"verse":4,"text":"私は穴に下る者とともに数えられ、力のない者のようになっています。","tok":[["私","わたくし"],["は"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["とも"],["に"],["数えられ","かぞえられ"],["、"],["力","ちから"],["の"],["ない"],["者","もの"],["の"],["よう"],["に"],["なって"],["います"],["。"]]},{"verse":5,"text":"死人の中でも見放され、墓の中に横たわる殺された者のようになっています。あなたは彼らをもはや覚えてはおられません。彼らはあなたの御手から断ち切られています。","tok":[["死人","しにん"],["の"],["中","なか"],["で"],["も"],["見放され","みはなされ"],["、"],["墓","はか"],["の"],["中","なか"],["に"],["横たわる","よこたわる"],["殺された","ころされた"],["者","もの"],["の"],["よう"],["に"],["なって"],["います"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["もはや"],["覚えて","おぼえて"],["は"],["おられません"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["御手","おて"],["から"],["断ち切られて","たちきられて"],["います"],["。"]]},{"verse":6,"text":"あなたは私を最も深い穴に置いておられます。そこは暗い所、深い淵です。","tok":[["あなた"],["は"],["私","わたくし"],["を"],["最も","もっとも"],["深い","ふかい"],["穴","あな"],["に"],["置いて","おいて"],["おられます"],["。"],["そこ"],["は"],["暗い","くらい"],["所","ところ"],["、"],["深い","ふかい"],["淵","ふち"],["です"],["。"]]},{"verse":7,"text":"あなたの激しい憤りが私の上にとどまり、あなたのすべての波であなたは私を悩ましておられます。セラ","tok":[["あなた"],["の"],["激しい","はげしい"],["憤り","いきどおり"],["が"],["私","わたくし"],["の"],["上","うえ"],["に"],["とどまり"],["、"],["あなた"],["の"],["すべて"],["の"],["波","なみ"],["で"],["あなた"],["は"],["私","わたくし"],["を"],["悩まして","なやまして"],["おられます"],["。"],["セラ"]]},{"verse":8,"text":"あなたは私の親友を私から遠ざけ、私を彼らの忌みきらう者とされました。私は閉じ込められて、出て行くことができません。","tok":[["あなた"],["は"],["私","わたくし"],["の"],["親友","しんゆう"],["を"],["私","わたくし"],["から"],["遠ざけ","とおざけ"],["、"],["私","わたくし"],["を"],["彼","かれ"],["ら"],["の"],["忌みきらう","いみきらう"],["者","もの"],["と"],["されました"],["。"],["私","わたくし"],["は"],["閉じ込められて","とじこめられて"],["、"],["出て","でて"],["行く","いく"],["こと"],["が"],["できません"],["。"]]},{"verse":9,"text":"私の目は悩みによって衰えています。主よ。私は日ごとにあなたを呼び求めています。あなたに向かって私の両手を差し伸ばしています。","tok":[["私","わたくし"],["の"],["目","め"],["は"],["悩み","なやみ"],["によって"],["衰えて","おとろえて"],["います"],["。"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["日ごと","ひごと"],["に"],["あなた"],["を"],["呼び求めて","よびもとめて"],["います"],["。"],["あなた"],["に"],["向かって","むかって"],["私","わたくし"],["の"],["両手","りょうて"],["を"],["差し伸ばして","さしのばして"],["います"],["。"]]},{"verse":10,"text":"あなたは死人のために奇しいわざを行われるでしょうか。亡霊が起き上がって、あなたをほめたたえるでしょうか。セラ","tok":[["あなた"],["は"],["死人","しにん"],["の"],["ため"],["に"],["奇しい","くすしい"],["わざ"],["を"],["行われるでしょう","おこなわれるでしょう"],["か"],["。"],["亡霊","ぼうれい"],["が"],["起き上がって","おきあがって"],["、"],["あなた"],["を"],["ほめたたえるでしょう"],["か"],["。"],["セラ"]]},{"verse":11,"text":"あなたの恵みが墓の中で宣べられましょうか、あなたの真実が滅びの中で。","tok":[["あなた"],["の"],["恵み","めぐみ"],["が"],["墓","はか"],["の"],["中","なか"],["で"],["宣べられましょう","のべられましょう"],["か"],["、"],["あなた"],["の"],["真実","しんじつ"],["が"],["滅び","ほろび"],["の"],["中","なか"],["で"],["。"]]},{"verse":12,"text":"あなたの奇しいわざが、やみの中で知られるでしょうか、あなたの義が忘却の地で。","tok":[["あなた"],["の"],["奇しい","くすしい"],["わざ"],["が"],["、"],["やみ"],["の"],["中","なか"],["で"],["知られるでしょう","しられるでしょう"],["か"],["、"],["あなた"],["の"],["義","ぎ"],["が"],["忘却","ぼうきゃく"],["の"],["地","ち"],["で"],["。"]]},{"verse":13,"text":"しかし、主よ。この私は、あなたに叫んでいます。朝明けに、私の祈りはあなたのところに届きます。","tok":[["しかし"],["、"],["主","ぬし"],["よ"],["。"],[
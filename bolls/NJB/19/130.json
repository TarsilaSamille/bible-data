[{"verse":1,"text":"（都上りの歌）主よ。深い淵から、私はあなたを呼び求めます。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["主","ぬし"],["よ"],["。"],["深い","ふかい"],["淵","ふち"],["から"],["、"],["私","わたくし"],["は"],["あなた"],["を"],["呼び求めます","よびもとめます"],["。"]]},{"verse":2,"text":"主よ。私の声を聞いてください。私の願いの声に耳を傾けてください。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["ください"],["。"],["私","わたくし"],["の"],["願い","ねがい"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"]]},{"verse":3,"text":"主よ。あなたがもし、不義に目を留められるなら、主よ、だれが御前に立ちえましょう。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["が"],["もし"],["、"],["不義","ふぎ"],["に"],["目","め"],["を"],["留められるなら","とめられるなら"],["、"],["主","ぬし"],["よ"],["、"],["だれ"],["が"],["御前","ごぜん"],["に"],["立ち","たち"],["えましょう"],["。"]]},{"verse":4,"text":"しかし、あなたが赦してくださるからこそあなたは人に恐れられます。","tok":[["しかし"],["、"],["あなた"],["が"],["赦して","ゆるして"],["くださる"],["から"],["こそ"],["あなた"],["は"],["人","ひと"],["に"],["恐れられます","おそれられます"],["。"]]},{"verse":5,"text":"私は主を待ち望みます。私のたましいは、待ち望みます。私は主のみことばを待ちます。","tok":[["私","わたくし"],["は"],["主","ぬし"],["を"],["待ち望みます","まちのぞみます"],["。"],["私","わたくし"],["の"],["たましい"],["は"],["、"],["待ち望みます","まちのぞみます"],["。"],["私","わたくし"],["は"],["主","ぬし"],["のみ"],["ことば"],["を"],["待ちます","まちます"],["。"]]},{"verse":6,"text":"私のたましいは、夜回りが夜明けを待つのにまさり、まことに、夜回りが夜明けを待つのにまさって、主を待ちます。","tok":[["私","わたくし"],["の"],["たましい"],["は"],["、"],["夜回り","よまわり"],["が"],["夜明け","よあけ"],["を"],["待つ","まつ"],["のに"],["まさり"],["、"],["まこと"],["に"],["、"],["夜回り","よまわり"],["が"],["夜明け","よあけ"],["を"],["待つ","まつ"],["のに"],["まさって"],["、"],["主","ぬし"],["を"],["待ちます","まちます"],["。"]]},{"verse":7,"text":"イスラエルよ。主を待て。主には恵みがあり、豊かな贖いがある。","tok":[["イスラエル"],["よ"],["。"],["主","ぬし"],["を"],["待て","まて"],["。"],["主に","おもに"],["は"],["恵み","めぐみ"],["が"],["あり"],["、"],["豊か","ゆたか"],["な"],["贖い","あがない"],["が"],["ある"],["。"]]},{"verse":8,"text":"主は、すべての不義からイスラエルを贖い出される。","tok":[["主","ぬし"],["は"],["、"],["すべて"],["の"],["不義","ふぎ"],["から"],["イスラエル"],["を"],["贖い","あがない"],["出される","だされる"],["。"]]}]
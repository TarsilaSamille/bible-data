[{"verse":1,"text":"（指揮者のために。ギテトの調べに合わせて。アサフによる）われらの力であられる神に喜び歌え。ヤコブの神に喜び叫べ。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ギテト"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["アサフ"],["に"],["よる"],["）"],["われ"],["ら"],["の"],["力","ちから"],["で"],["あられる"],["神","かみ"],["に"],["喜び歌え","よろこびうたえ"],["。"],["ヤコブ"],["の"],["神","かみ"],["に"],["喜び叫べ","よろこびさけべ"],["。"]]},{"verse":2,"text":"声高らかにほめ歌を歌え。タンバリンを打ち鳴らせ。六弦の琴に合わせて、良い音の立琴をかき鳴らせ。","tok":[["声","こえ"],["高らか","たからか"],["に"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"],["タンバリン"],["を"],["打ち鳴らせ","うちならせ"],["。"],["六","ろく"],["弦","げん"],["の"],["琴","こと"],["に"],["合わせて","あわせて"],["、"],["良い","よい"],["音","おと"],["の"],["立琴","たてごと"],["を"],["かき鳴らせ","かきならせ"],["。"]]},{"verse":3,"text":"われらの祭りの日の、新月と満月に、角笛を吹き鳴らせ。","tok":[["われ"],["ら"],["の"],["祭り","まつり"],["の"],["日","ひ"],["の"],["、"],["新月","しんげつ"],["と"],["満月","まんげつ"],["に"],["、"],["角笛","つのぶえ"],["を"],["吹き鳴らせ","ふきならせ"],["。"]]},{"verse":4,"text":"それは、イスラエルのためのおきて、ヤコブの神の定めである。","tok":[["それ"],["は"],["、"],["イスラエル"],["の"],["ため"],["の"],["おきて"],["、"],["ヤコブ"],["の"],["神","かみ"],["の"],["定め","さだめ"],["で"],["ある"],["。"]]},{"verse":5,"text":"神が、エジプトの地に出て行かれたとき、ヨセフの中に、それをあかしとして授けられた。私は、まだ知らなかったことばを聞いた。","tok":[["神","かみ"],["が"],["、"],["エジプト"],["の"],["地","ち"],["に"],["出て","でて"],["行かれた","いかれた"],["とき"],["、"],["ヨセフ"],["の"],["中","なか"],["に"],["、"],["それ"],["を"],["あかし"],["として"],["授けられた","さずけられた"],["。"],["私","わたくし"],["は"],["、"],["まだ"],["知らなかった","しらなかった"],["ことば"],["を"],["聞いた","きいた"],["。"]]},{"verse":6,"text":"「わたしは、彼の肩から重荷を取り除き、彼の手を荷かごから離してやった。","tok":[["「"],["わたし"],["は"],["、"],["彼","かれ"],["の"],["肩","かた"],["から"],["重荷","おもに"],["を"],["取り除き","とりのぞき"],["、"],["彼","かれ"],["の"],["手","て"],["を"],["荷かご","にかご"],["から"],["離して","はなして"],["やった"],["。"]]},{"verse":7,"text":"あなたは苦しみのときに、呼び求め、わたしは、あなたを助け出した。わたしは、雷の隠れ場から、あなたに答え、メリバの水のほとりで、あなたをためした。セラ","tok":[["あなた"],["は"],["苦しみ","くるしみ"],["の"],["とき"],["に"],["、"],["呼び求め","よびもとめ"],["、"],["わたし"],["は"],["、"],["あなた"],["を"],["助け出した","たすけだした"],["。"],["わたし"],["は"],["、"],["雷","かみなり"],["の"],["隠れ場","かくれば"],["から"],["、"],["あなた"],["に"],["答え","こたえ"],["、"],["メリバ"],["の"],["水","みず"],["の"],["ほとり"],["で"],["、"],["あなた"],["を"],["ためした"],["。"],["セラ"]]},{"verse":8,"text":"聞け。わが民よ。わたしは、あなたをたしなめよう。イスラエルよ。よくわたしの言うことを聞け。","tok":[["聞け","きけ"],["。"],["わが"],["民","たみ"],["よ"],["。"],["わたし"],["は"],["、"],["あなた"],["を"],["たしなめよう"],["。"],["イスラエル"],["よ"],["。"],["よく"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞け","きけ"],["。"]]},{"verse":9,"text":"あなたのうちに、ほかの神があってはならない。あなたは、外国の神を拝んではならない。","tok":[["あなた"],["の"],["うち"],["に"],["、"],["ほか"],["の"],["神","かみ"],["が"],["あって"],["は"],["ならない"],["。"],["あなた"],["は"],["、"],["外国","がいこく"],["の"],["神","かみ"],["を"],["拝んで","おがんで"],["は"],["ならない"],["。"]]},{"verse":10,"text":"わたしが、あなたの神、主である。わたしはあなたをエジプトの地から連れ上った。あなたの口を大きくあけよ。わたしが、それを満たそう。","tok":[["わたし"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ上った","つれのぼった"],["。"],["あなた"],["の"],["口","くち"],["を"],["大きく","おおきく"],["あけよ"],["。"],["わたし"],["が"],["、"],["それ"],["を"],["満たそう","みたそう"],["。"]]},{"verse":11,"text":"しかしわが民は、わたしの声を聞かず、イスラエルは、わたしに従わなかった。","tok":[["しかし"],["わが"],["民","みん"],["は"],["、"],["わたし"],["の"],["声","こえ"],["を"],["聞かず","きかず"],["、"],["イスラエル"],["は"],["、"],["わたし"],["に"],["従わなかった","したがわなかった"],["。"]]},{"verse":12,"text":"それでわたしは、彼らをかたくなな心のままに任せ、自分たちのおもんぱかりのままに歩かせた。","tok":[["それ"],["で"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["かたくな"],["な"],["心","こころ"],["の"],["まま"],["に"],["任せ","まかせ"],["、"],["自分","じぶん"],["たち"],["の"],["おもんぱかり"],["の"],["まま"],["に"],["歩かせた","あるかせた"],["。"]]},{"verse":13,"text":"ああ、ただ、わが民がわたしに聞き従い、イスラエルが、わたしの道を歩いたのだったら。","tok":[["ああ"],["、"],["ただ"],["、"],["わが"],["民","たみ"],["が"],["わたし"],["に"],["聞き従い","ききしたがい"],["、"],["イスラエル"],["が"],["、"],["わたし"],["の"],["道","みち"],["を"],["歩いた","あるいた"],["の"],["だったら"],["。"]]},{"verse":14,"text":"わたしはただちに、彼らの敵を征服し、彼らの仇に、わたしの手を向けたのに。」","tok":[["わたし"],["は"],["ただちに"],["、"],["彼","かれ"],["ら"],["の"],["敵","てき"],["を"],["征服","せいふく"],["し"],["、"],["彼","かれ"],["ら"],["の"],["仇","あだ"],["に"],["、"],["わたし"],["の"],["手","て"],["を"],["向けた","むけた"],["のに"],["。"],["」"]]},{"verse":15,"text":"主を憎む者どもは、主にへつらっているが、彼らの刑罰の時は永遠に続く。","tok":[["主","ぬし"],["を"],["憎む","にくむ"],["者","もの"],["ども"],["は"],["、"],["主に","おもに"],["へつらって"],["いる"],["が"],["、"],["彼","かれ"],["ら"],["の"],["刑罰","けいばつ"],["の"],["時","とき"],["は"],["永遠","えいえん"],["に"],["続く","つづく"],["。"]]},{"verse":16,"text":"しかし主は、最良の小麦をイスラエルに食べさせる。「わたしは岩の上にできる蜜で、あなたを満ち足らせよう。」","tok":[["しかし"],["主","ぬし"],["は"],["、"],["最良","さいりょう"],["の"],["小麦","こむぎ"],["を"],["イスラエル"],["に"],["食べさせる","たべさせる"],["。"],["「"],["わたし"],["は"],["岩","いわ"],["の"],["上","うえ"],["に"],["できる"],["蜜","みつ"],["で"],["、"],["あなた"],["を"],["満ち","みち"],["足らせよう","たらせよう"],["。"],["」"]]}]
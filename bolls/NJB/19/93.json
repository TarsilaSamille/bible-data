[{"verse":1,"text":"主は、王であられ、みいつをまとっておられます。主はまとっておられます。力を身に帯びておられます。まことに、世界は堅く建てられ、揺らぐことはありません。","tok":[["主","ぬし"],["は"],["、"],["王","おう"],["で"],["あられ"],["、"],["みい"],["つ"],["を"],["まとって"],["おられます"],["。"],["主","ぬし"],["は"],["まとって"],["おられます"],["。"],["力","ちから"],["を"],["身","み"],["に"],["帯びて","おびて"],["おられます"],["。"],["まこと"],["に"],["、"],["世界","せかい"],["は"],["堅く","かたく"],["建てられ","たてられ"],["、"],["揺らぐ","ゆらぐ"],["こと"],["は"],["ありません"],["。"]]},{"verse":2,"text":"あなたの御座は、いにしえから堅く立ち、あなたは、とこしえからおられます。","tok":[["あなた"],["の"],["御座","ぎょざ"],["は"],["、"],["いにしえ"],["から"],["堅く","かたく"],["立ち","たち"],["、"],["あなた"],["は"],["、"],["とこしえ"],["から"],["おられます"],["。"]]},{"verse":3,"text":"主よ。川は、声をあげました。川は、叫び声をあげました。川は、とどろく声をあげています。","tok":[["主","ぬし"],["よ"],["。"],["川","かわ"],["は"],["、"],["声","こえ"],["を"],["あげました"],["。"],["川","かわ"],["は"],["、"],["叫び声","さけびごえ"],["を"],["あげました"],["。"],["川","かわ"],["は"],["、"],["とどろく"],["声","こえ"],["を"],["あげて"],["います"],["。"]]},{"verse":4,"text":"大水のとどろきにまさり、海の力強い波にもまさって、いと高き所にいます主は、力強くあられます。","tok":[["大水","おおみず"],["の"],["とどろき"],["に"],["まさり"],["、"],["海","うみ"],["の"],["力強い","ちからづよい"],["波","なみ"],["に"],["も"],["まさって"],["、"],["いと"],["高き","たかき"],["所","ところ"],["に"],["います"],["主","ぬし"],["は"],["、"],["力強く","ちからづよく"],["あられます"],["。"]]},{"verse":5,"text":"あなたのあかしは、まことに確かです。聖なることがあなたの家にはふさわしいのです。主よ、いつまでも。","tok":[["あなた"],["の"],["あかし"],["は"],["、"],["まこと"],["に"],["確か","たしか"],["です"],["。"],["聖","せい"],["なる"],["こと"],["が"],["あなた"],["の"],["家","いえ"],["に"],["は"],["ふさわしい"],["の"],["です"],["。"],["主","ぬし"],["よ"],["、"],["いつ"],["まで"],["も"],["。"]]}]
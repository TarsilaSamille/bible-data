[{"verse":1,"text":"（指揮者のために。エドトンによって。ダビデの賛歌）私のたましいは黙って、ただ神を待ち望む。私の救いは神から来る。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["エドトン"],["によって"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["私","わたくし"],["の"],["たましい"],["は"],["黙って","だまって"],["、"],["ただ"],["神","かみ"],["を"],["待ち望む","まちのぞむ"],["。"],["私","わたくし"],["の"],["救い","すくい"],["は"],["神","かみ"],["から"],["来る","くる"],["。"]]},{"verse":2,"text":"神こそ、わが岩。わが救い。わがやぐら。私は決して、ゆるがされない。","tok":[["神","かみ"],["こそ"],["、"],["わが"],["岩","いわ"],["。"],["わが"],["救い","すくい"],["。"],["わが"],["やぐら"],["。"],["私","わたくし"],["は"],["決して","けっして"],["、"],["ゆるがされない"],["。"]]},{"verse":3,"text":"おまえたちは、いつまでひとりの人を襲うのか。おまえたちはこぞって打ち殺そうとしている。あたかも、傾いた城壁か、ぐらつく石垣のように。","tok":[["おまえ"],["たち"],["は"],["、"],["いつ"],["まで"],["ひとり"],["の"],["人","ひと"],["を"],["襲う","おそう"],["の"],["か"],["。"],["おまえ"],["たち"],["は"],["こぞって"],["打ち殺そう","うちころそう"],["として"],["いる"],["。"],["あたかも"],["、"],["傾いた","かたむいた"],["城壁","じょうへき"],["か"],["、"],["ぐらつく"],["石垣","いしがき"],["の"],["よう"],["に"],["。"]]},{"verse":4,"text":"まことに、彼らは彼を高い地位から突き落とそうとたくらんでいる。彼らは偽りを好み、口では祝福し、心の中ではのろう。セラ","tok":[["まこと"],["に"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["を"],["高い","たかい"],["地位","ちい"],["から"],["突き落とそう","つきおとそう"],["と"],["たくらんで"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["偽り","いつわり"],["を"],["好み","このみ"],["、"],["口","くち"],["で"],["は"],["祝福","しゅくふく"],["し"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["は"],["のろう"],["。"],["セラ"]]},{"verse":5,"text":"私のたましいは黙って、ただ神を待ち望む。私の望みは神から来るからだ。","tok":[["私","わたくし"],["の"],["たましい"],["は"],["黙って","だまって"],["、"],["ただ"],["神","かみ"],["を"],["待ち望む","まちのぞむ"],["。"],["私","わたくし"],["の"],["望み","のぞみ"],["は"],["神","かみ"],["から"],["来る","くる"],["から"],["だ"],["。"]]},{"verse":6,"text":"神こそ、わが岩。わが救い。わがやぐら。私はゆるがされることはない。","tok":[["神","かみ"],["こそ"],["、"],["わが"],["岩","いわ"],["。"],["わが"],["救い","すくい"],["。"],["わが"],["やぐら"],["。"],["私","わたくし"],["は"],["ゆるがされる"],["こと"],["は"],["ない"],["。"]]},{"verse":7,"text":"私の救いと、私の栄光は、神にかかっている。私の力の岩と避け所は、神のうちにある。","tok":[["私","わたくし"],["の"],["救い","すくい"],["と"],["、"],["私","わたくし"],["の"],["栄光","えいこう"],["は"],["、"],["神","かみ"],["に"],["かかって"],["いる"],["。"],["私","わたくし"],["の"],["力","ちから"],["の"],["岩","いわ"],["と"],["避け","さけ"],["所","しょ"],["は"],["、"],["神","かみ"],["の"],["うち"],["に"],["ある"],["。"]]},{"verse":8,"text":"民よ。どんなときにも、神に信頼せよ。あなたがたの心を神の御前に注ぎ出せ。神は、われらの避け所である。セラ","tok":[["民","たみ"],["よ"],["。"],["どんな"],["とき"],["に"],["も"],["、"],["神","かみ"],["に"],["信頼","しんらい"],["せよ"],["。"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["注ぎ","そそぎ"],["出せ","だせ"],["。"],["神","かみ"],["は"],["、"],["われ"],["ら"],["の"],["避け","さけ"],["所","ところ"],["で"],["ある"],["。"],["セラ"]]},{"verse":9,"text":"まことに、身分の低い人々は、むなしく、高い人々は、偽りだ。はかりにかけると、彼らは上に上がる。彼らを合わせても、息より軽い。","tok":[["まこと"],["に"],["、"],["身分","みぶん"],["の"],["低い","ひくい"],["人々","ひとびと"],["は"],["、"],["むなしく"],["、"],["高い","たかい"],["人々","ひとびと"],["は"],["、"],["偽り","いつわり"],["だ"],["。"],["はかり"],["に"],["かける"],["と"],["、"],["彼","かれ"],["ら"],["は"],["上","うえ"],["に"],["上がる","あがる"],["。"],["彼","かれ"],["ら"],["を"],["合わせて","あわせて"],["も"],["、"],["息","いき"],["より"],["軽い","かるい"],["。"]]},{"verse":10,"text":"圧制にたよるな。略奪にむなしい望みをかけるな。富がふえても、それに心を留めるな。","tok":[["圧制","あっせい"],["に"],["たよる"],["な"],["。"],["略奪","りゃくだつ"],["に"],["むなしい"],["望み","のぞみ"],["を"],["かける"],["な"],["。"],["富","とみ"],["が"],["ふえて"],["も"],["、"],["それ"],["に"],["心","こころ"],["を"],["留める","とめる"],["な"],["。"]]},{"verse":11,"text":"神は、一度告げられた。二度、私はそれを聞いた。力は、神のものであることを。","tok":[["神","かみ"],["は"],["、"],["一度","いちど"],["告げられた","つげられた"],["。"],["二","に"],["度","ど"],["、"],["私","わたくし"],["は"],["それ"],["を"],["聞いた","きいた"],["。"],["力","ちから"],["は"],["、"],["神","かみ"],["の"],["もの"],["で"],["ある"],["こと"],["を"],["。"]]},{"verse":12,"text":"主よ。恵みも、あなたのものです。あなたは、そのしわざに応じて、人に報いられます。","tok":[["主","ぬし"],["よ"],["。"],["恵み","めぐみ"],["も"],["、"],["あなた"],["の"],["もの"],["です"],["。"],["あなた"],["は"],["、"],["その"],["しわざ"],["に"],["応じて","おうじて"],["、"],["人","ひと"],["に"],["報いられます","むくいられます"],["。"]]}]
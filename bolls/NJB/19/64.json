[{"verse":1,"text":"（指揮者のために。ダビデの賛歌）神よ。私の嘆くとき、その声を聞いてください。恐るべき敵から、私のいのちを守ってください。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["神","かみ"],["よ"],["。"],["私","わたくし"],["の"],["嘆く","なげく"],["とき"],["、"],["その"],["声","こえ"],["を"],["聞いて","きいて"],["ください"],["。"],["恐るべき","おそるべき"],["敵","てき"],["から"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["守って","まもって"],["ください"],["。"]]},{"verse":2,"text":"悪を行う者どものはかりごとから、不法を行う者らの騒ぎから、私をかくまってください。","tok":[["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["ども"],["の"],["はかりごと"],["から"],["、"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["ら"],["の"],["騒ぎ","さわぎ"],["から"],["、"],["私","わたくし"],["を"],["かくまって"],["ください"],["。"]]},{"verse":3,"text":"彼らは、その舌を剣のように、とぎすまし、苦いことばの矢を放っています。","tok":[["彼","かれ"],["ら"],["は"],["、"],["その"],["舌","した"],["を"],["剣","けん"],["の"],["よう"],["に"],["、"],["とぎすまし"],["、"],["苦い","にがい"],["ことば"],["の"],["矢","や"],["を"],["放って","はなって"],["います"],["。"]]},{"verse":4,"text":"全き人に向けて、隠れた所から射掛け、不意に射て恐れません。","tok":[["全","ぜん"],["き"],["人","ひと"],["に"],["向けて","むけて"],["、"],["隠れた","かくれた"],["所","ところ"],["から"],["射掛け","いかけ"],["、"],["不意","ふい"],["に"],["射て","いて"],["恐れません","おそれません"],["。"]]},{"verse":5,"text":"彼らは悪事に凝っています。語り合ってひそかにわなをかけ、「だれに、見破ることができよう」と言っています。","tok":[["彼","かれ"],["ら"],["は"],["悪事","あくじ"],["に"],["凝って","こって"],["います"],["。"],["語り合って","かたりあって"],["ひそか"],["に"],["わな"],["を"],["かけ"],["、"],["「"],["だれ"],["に"],["、"],["見破る","みやぶる"],["こと"],["が"],["できよう"],["」"],["と"],["言って","いって"],["います"],["。"]]},{"verse":6,"text":"彼らは不正をたくらみ、「たくらんだ策略がうまくいった」と言っています。人の内側のものと心とは、深いものです。","tok":[["彼","かれ"],["ら"],["は"],["不正","ふせい"],["を"],["たくらみ"],["、"],["「"],["たくらんだ"],["策略","さくりゃく"],["が"],["うまく"],["いった"],["」"],["と"],["言って","いって"],["います"],["。"],["人","ひと"],["の"],["内側","うちがわ"],["の"],["もの"],["と"],["心","こころ"],["と"],["は"],["、"],["深い","ふかい"],["もの"],["です"],["。"]]},{"verse":7,"text":"しかし神は、矢を彼らに射掛けられるので、彼らは、不意に傷つきましょう。","tok":[["しかし"],["神","かみ"],["は"],["、"],["矢","や"],["を"],["彼","かれ"],["ら"],["に"],["射掛けられる","いかけられる"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["、"],["不意","ふい"],["に"],["傷つきましょう","きずつきましょう"],["。"]]},{"verse":8,"text":"彼らは、おのれの舌を、みずからのつまずきとしたのです。彼らを見る者はみな、頭を振ってあざけります。","tok":[["彼","かれ"],["ら"],["は"],["、"],["おのれ"],["の"],["舌","した"],["を"],["、"],["みずから"],["の"],["つまずき"],["と"],["した"],["の"],["です"],["。"],["彼","かれ"],["ら"],["を"],["見る","みる"],["者","もの"],["は"],["みな"],["、"],["頭","あたま"],["を"],["振って","ふって"],["あざけります"],["。"]]},{"verse":9,"text":"こうして、すべての人は恐れ、神のみわざを告げ知らせ、そのなさったことを悟ります。","tok":[["こう"],["して"],["、"],["すべて"],["の"],["人","ひと"],["は"],["恐れ","おそれ"],["、"],["神","かみ"],["のみ"],["わざ"],["を"],["告げ知らせ","つげしらせ"],["、"],["その"],["なさった"],["こと"],["を"],["悟ります","さとります"],["。"]]},{"verse":10,"text":"正しい者は主にあって喜び、主に身を避けます。心の直ぐな人はみな、誇ることができましょう。","tok":[["正しい","ただしい"],["者","もの"],["は"],["主に","おもに"],["あって"],["喜び","よろこび"],["、"],["主に","おもに"],["身","み"],["を"],["避けます","さけます"],["。"],["心","こころ"],["の"],["直ぐ","すぐ"],["な"],["人","ひと"],["は"],["みな"],["、"],["誇る","ほこる"],["こと"],["が"],["できましょう"],["。"]]}]
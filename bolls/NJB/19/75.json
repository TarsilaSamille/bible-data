[{"verse":1,"text":"（指揮者のために。「滅ぼすな」の調べに合わせて。アサフの賛歌。歌）私たちは、あなたに感謝します。神よ。私たちは感謝します。御名は、近くにあり、人々は、あなたの奇しいわざを語り告げます。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["「"],["滅ぼす","ほろぼす"],["な"],["」"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["アサフ"],["の"],["賛歌","さんか"],["。"],["歌","うた"],["）"],["私たち","わたしたち"],["は"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"],["神","かみ"],["よ"],["。"],["私たち","わたしたち"],["は"],["感謝","かんしゃ"],["します"],["。"],["御名","ぎょめい"],["は"],["、"],["近く","ちかく"],["に"],["あり"],["、"],["人々","ひとびと"],["は"],["、"],["あなた"],["の"],["奇しい","くすしい"],["わざ"],["を"],["語り告げます","かたりつげます"],["。"]]},{"verse":2,"text":"「わたしが、定めの時を決め、わたしみずから公正にさばく。","tok":[["「"],["わたし"],["が"],["、"],["定め","さだめ"],["の"],["時","とき"],["を"],["決め","きめ"],["、"],["わたし"],["みずから"],["公正","こうせい"],["に"],["さばく"],["。"]]},{"verse":3,"text":"地とこれに住むすべての者が揺らぐとき、わたしは地の柱を堅く立てる。セラ","tok":[["地","ち"],["と"],["これ"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["が"],["揺らぐ","ゆらぐ"],["とき"],["、"],["わたし"],["は"],["地","ち"],["の"],["柱","はしら"],["を"],["堅く","かたく"],["立てる","たてる"],["。"],["セラ"]]},{"verse":4,"text":"わたしは、誇る者には、『誇るな』と言い、悪者には、『角を上げるな。","tok":[["わたし"],["は"],["、"],["誇る","ほこる"],["者","もの"],["に"],["は"],["、"],["『"],["誇る","ほこる"],["な"],["』"],["と"],["言い","いい"],["、"],["悪者","わるもの"],["に"],["は"],["、"],["『"],["角","かく"],["を"],["上げる","あげる"],["な"],["。"]]},{"verse":5,"text":"おまえたちの角を、高く上げるな。横柄な態度で語るな』と言う。」","tok":[["おまえ"],["たち"],["の"],["角","かど"],["を"],["、"],["高く","たかく"],["上げる","あげる"],["な"],["。"],["横柄","おうへい"],["な"],["態度","たいど"],["で"],["語る","かたる"],["な"],["』"],["と"],["言う","ゆう"],["。"],["」"]]},{"verse":6,"text":"高く上げることは、東からでもなく、西からでもなく、荒野からでもない。","tok":[["高く","たかく"],["上げる","あげる"],["こと"],["は"],["、"],["東","ひがし"],["から"],["で"],["も"],["なく"],["、"],["西","にし"],["から"],["で"],["も"],["なく"],["、"],["荒野","こうや"],["から"],["で"],["も"],["ない"],["。"]]},{"verse":7,"text":"それは、神が、さばく方であり、これを低くし、かれを高く上げられるからだ。","tok":[["それ"],["は"],["、"],["神","かみ"],["が"],["、"],["さばく"],["方","ほう"],["で"],["あり"],["、"],["これ"],["を"],["低く","ひくく"],["し"],["、"],["かれ"],["を"],["高く","たかく"],["上げられる","あげられる"],["から"],["だ"],["。"]]},{"verse":8,"text":"主の御手には、杯があり、よく混ぜ合わされた、あわだつぶどう酒がある。主が、これを注ぎ出されると、この世の悪者どもは、こぞって、そのかすまで飲んで、飲み干してしまう。","tok":[["主","ぬし"],["の"],["御手","おて"],["に"],["は"],["、"],["杯","さかずき"],["が"],["あり"],["、"],["よく"],["混ぜ合わされた","まぜあわされた"],["、"],["あわだつ"],["ぶどう酒","ぶどうしゅ"],["が"],["ある"],["。"],["主","ぬし"],["が"],["、"],["これ"],["を"],["注ぎ","そそぎ"],["出される","だされる"],["と"],["、"],["この世","このよ"],["の"],["悪者","わるもの"],["ども"],["は"],["、"],["こぞって"],["、"],["その"],["かす"],["まで"],["飲んで","のんで"],["、"],["飲み干して","のみほして"],["しまう"],["。"]]},{"verse":9,"text":"しかし私は、とこしえまでも告げよう。ヤコブの神を、ほめ歌おう。","tok":[["しかし"],["私","わたくし"],["は"],["、"],["とこしえ"],["まで"],["も"],["告げよう","つげよう"],["。"],["ヤコブ"],["の"],["神","かみ"],["を"],["、"],["ほめ歌","ほめうた"],["おう"],["。"]]},{"verse":10,"text":"悪者どもの角を、ことごとく切り捨てよう。しかし、正しい者の角は、高く上げられる。","tok":[["悪者","わるもの"],["ども"],["の"],["角","かど"],["を"],["、"],["ことごとく"],["切り捨てよう","きりすてよう"],["。"],["しかし"],["、"],["正しい","ただしい"],["者","もの"],["の"],["角","かど"],["は"],["、"],["高く","たかく"],["上げられる","あげられる"],["。"]]}]
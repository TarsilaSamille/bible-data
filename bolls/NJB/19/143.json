[{"verse":1,"text":"（ダビデの賛歌）主よ。私の祈りを聞き、私の願いに耳を傾けてください。あなたの真実と義によって、私に答えてください。","tok":[["（"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["祈り","いのり"],["を"],["聞き","きき"],["、"],["私","わたくし"],["の"],["願い","ねがい"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"],["あなた"],["の"],["真実","しんじつ"],["と"],["義","ぎ"],["によって"],["、"],["私","わたくし"],["に"],["答えて","こたえて"],["ください"],["。"]]},{"verse":2,"text":"あなたのしもべをさばきにかけないでください。生ける者はだれひとり、あなたの前に義と認められないからです。","tok":[["あなた"],["の"],["しもべ"],["を"],["さばき"],["に"],["かけないで"],["ください"],["。"],["生ける","いける"],["者","もの"],["は"],["だれ"],["ひとり"],["、"],["あなた"],["の"],["前","まえ"],["に"],["義","ぎ"],["と"],["認められない","みとめられない"],["から"],["です"],["。"]]},{"verse":3,"text":"敵は私のたましいを追いつめ、私のいのちを地に打ち砕き、長く死んでいる者のように、私を暗い所に住まわせたからです。","tok":[["敵","てき"],["は"],["私","わたくし"],["の"],["たましい"],["を"],["追いつめ","おいつめ"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["地","ち"],["に"],["打ち砕き","うちくだき"],["、"],["長く","ながく"],["死んで","しんで"],["いる"],["者","もの"],["の"],["よう"],["に"],["、"],["私","わたくし"],["を"],["暗い","くらい"],["所","ところ"],["に"],["住まわせた","すまわせた"],["から"],["です"],["。"]]},{"verse":4,"text":"それゆえ、私の霊は私のうちで衰え果て、私の心は私のうちでこわばりました。","tok":[["それ"],["ゆえ"],["、"],["私","わたくし"],["の"],["霊","れい"],["は"],["私","わたくし"],["の"],["うち"],["で"],["衰え","おとろえ"],["果て","はて"],["、"],["私","わたくし"],["の"],["心","こころ"],["は"],["私","わたくし"],["の"],["うち"],["で"],["こわばりました"],["。"]]},{"verse":5,"text":"私は昔の日々を思い出し、あなたのなさったすべてのことに思いを巡らし、あなたの御手のわざを静かに考えています。","tok":[["私","わたくし"],["は"],["昔","むかし"],["の"],["日々","ひび"],["を"],["思い出し","おもいだし"],["、"],["あなた"],["の"],["なさった"],["すべて"],["の"],["こと"],["に"],["思い","おもい"],["を"],["巡らし","めぐらし"],["、"],["あなた"],["の"],["御手","おて"],["の"],["わざ"],["を"],["静か","しずか"],["に"],["考えて","かんがえて"],["います"],["。"]]},{"verse":6,"text":"あなたに向かって、私は手を差し伸べ、私のたましいは、かわききった地のように、あなたを慕います。セラ","tok":[["あなた"],["に"],["向かって","むかって"],["、"],["私","わたくし"],["は"],["手","て"],["を"],["差し伸べ","さしのべ"],["、"],["私","わたくし"],["の"],["たましい"],["は"],["、"],["かわき"],["きった"],["地","ち"],["の"],["よう"],["に"],["、"],["あなた"],["を"],["慕います","したいます"],["。"],["セラ"]]},{"verse":7,"text":"主よ。早く私に答えてください。私の霊は滅びてしまいます。どうか、御顔を私に隠さないでください。私が穴に下る者と等しくならないため。","tok":[["主","ぬし"],["よ"],["。"],["早く","はやく"],["私","わたくし"],["に"],["答えて","こたえて"],["ください"],["。"],["私","わたくし"],["の"],["霊","れい"],["は"],["滅びて","ほろびて"],["しまいます"],["。"],["どう"],["か"],["、"],["御顔","おかお"],["を"],["私","わたくし"],["に"],["隠さないで","かくさないで"],["ください"],["。"],["私","わたくし"],["が"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["等しく","ひとしく"],["ならない"],["ため"],["。"]]},{"verse":8,"text":"朝にあなたの恵みを聞かせてください。私はあなたに信頼していますから。私に行くべき道を知らせてください。私のたましいはあなたを仰いでいますから。","tok":[["朝","あさ"],["に"],["あなた"],["の"],["恵み","めぐみ"],["を"],["聞かせて","きかせて"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["信頼","しんらい"],["して"],["います"],["から"],["。"],["私","わたくし"],["に"],["行くべき","いくべき"],["道","みち"],["を"],["知らせて","しらせて"],["ください"],["。"],["私","わたくし"],["の"],["たましい"],["は"],["あなた"],["を"],["仰いで","あおいで"],["います"],["から"],["。"]]},{"verse":9,"text":"主よ。私を敵から救い出してください。私はあなたの中に、身を隠します。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["を"],["敵","てき"],["から"],["救い出して","すくいだして"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["中","なか"],["に"],["、"],["身","み"],["を"],["隠します","かくします"],["。"]]},{"verse":10,"text":"あなたのみこころを行うことを教えてください。あなたこそ私の神であられますから。あなたのいつくしみ深い霊が、平らな地に私を導いてくださるように。","tok":[["あなた"],["のみ"],["こころ"],["を"],["行う","おこなう"],["こと"],["を"],["教えて","おしえて"],["ください"],["。"],["あなた"],["こそ"],["私","わたくし"],["の"],["神","かみ"],["で"],["あられます"],["から"],["。"],["あなた"],["の"],["いつくしみ"],["深い","ふかい"],["霊","れい"],["が"],["、"],["平ら","たいら"],["な"],["地","ち"],["に"],["私","わたくし"],["を"],["導いて","みちびいて"],["くださる"],["よう"],["に"],["。"]]},{"verse":11,"text":"主よ。あなたの御名のゆえに、私を生かし、あなたの義によって、私のたましいを苦しみから連れ出してください。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["御名","ぎょめい"],["の"],["ゆえ"],["に"],["、"],["私","わたくし"],["を"],["生かし","いかし"],["、"],["あなた"],["の"],["義","ぎ"],["によって"],["、"],["私","わたくし"],["の"],["たましい"],["を"],["苦しみ","くるしみ"],["から"],["連れ出して","つれだして"],["ください"],["。"]]},{"verse":12,"text":"あなたの恵みによって、私の敵を滅ぼし、私のたましいに敵対するすべての者を消し去ってください。私はあなたのしもべですから。","tok":[["あなた"],["の"],["恵み","めぐみ"],["によって"],["、"],["私","わたくし"],["の"],["敵","てき"],["を"],["滅ぼし","ほろぼし"],["、"],["私","わたくし"],["の"],["たましい"],["に"],["敵対","てきたい"],["する"],["すべて"],["の"],["者","もの"],["を"],["消し去って","けしさって"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["しもべ"],["です"],["から"],["。"]]}]
[{"verse":1,"text":"（都上りの歌）幸いなことよ。すべて主を恐れ、主の道を歩む者は。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["すべて"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["主","ぬし"],["の"],["道","みち"],["を"],["歩む","あゆむ"],["者","もの"],["は"],["。"]]},{"verse":2,"text":"あなたは、自分の手の勤労の実を食べるとき、幸福で、しあわせであろう。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["手","て"],["の"],["勤労","きんろう"],["の"],["実","じつ"],["を"],["食べる","たべる"],["とき"],["、"],["幸福","こうふく"],["で"],["、"],["しあわせ"],["で"],["あろう"],["。"]]},{"verse":3,"text":"あなたの妻は、あなたの家の奥にいて、豊かに実を結ぶぶどうの木のようだ。あなたの子らは、あなたの食卓を囲んで、オリーブの木を囲む若木のようだ。","tok":[["あなた"],["の"],["妻","つま"],["は"],["、"],["あなた"],["の"],["家","いえ"],["の"],["奥","おく"],["に"],["いて"],["、"],["豊か","ゆたか"],["に"],["実","じつ"],["を"],["結ぶ","むすぶ"],["ぶどう"],["の"],["木","き"],["の"],["よう"],["だ"],["。"],["あなた"],["の"],["子","こ"],["ら"],["は"],["、"],["あなた"],["の"],["食卓","しょくたく"],["を"],["囲んで","かこんで"],["、"],["オリーブ"],["の"],["木","き"],["を"],["囲む","かこむ"],["若木","わかぎ"],["の"],["よう"],["だ"],["。"]]},{"verse":4,"text":"見よ。主を恐れる人は、確かに、このように祝福を受ける。","tok":[["見","み"],["よ"],["。"],["主","ぬし"],["を"],["恐れる","おそれる"],["人","ひと"],["は"],["、"],["確か","たしか"],["に"],["、"],["この"],["よう"],["に"],["祝福","しゅくふく"],["を"],["受ける","うける"],["。"]]},{"verse":5,"text":"主はシオンからあなたを祝福される。あなたは、いのちの日の限り、エルサレムの繁栄を見よ。","tok":[["主","ぬし"],["は"],["シオン"],["から"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["。"],["あなた"],["は"],["、"],["いのち"],["の"],["日","ひ"],["の"],["限り","かぎり"],["、"],["エルサレム"],["の"],["繁栄","はんえい"],["を"],["見よ","みよ"],["。"]]},{"verse":6,"text":"あなたの子らの子たちを見よ。イスラエルの上に平和があるように。","tok":[["あなた"],["の"],["子","こ"],["ら"],["の"],["子","こ"],["たち"],["を"],["見よ","みよ"],["。"],["イスラエル"],["の"],["上","うえ"],["に"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"]]}]
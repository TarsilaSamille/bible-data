[{"verse":1,"text":"（指揮者のために。弦楽器に合わせて。ダビデの賛歌）私が呼ぶとき、答えてください。私の義なる神。あなたは、私の苦しみのときにゆとりを与えてくださいました。私をあわれみ、私の祈りを聞いてください。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["弦楽器","げんがっき"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["私","わたくし"],["が"],["呼ぶ","よぶ"],["とき"],["、"],["答えて","こたえて"],["ください"],["。"],["私","わたくし"],["の"],["義","ぎ"],["なる"],["神","かみ"],["。"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["苦しみ","くるしみ"],["の"],["とき"],["に"],["ゆとり"],["を"],["与えて","あたえて"],["くださいました"],["。"],["私","わたくし"],["を"],["あわれみ"],["、"],["私","わたくし"],["の"],["祈り","いのり"],["を"],["聞いて","きいて"],["ください"],["。"]]},{"verse":2,"text":"人の子たちよ。いつまでわたしの栄光をはずかしめ、むなしいものを愛し、まやかしものを慕い求めるのか。セラ","tok":[["人","ひと"],["の"],["子","こ"],["たち"],["よ"],["。"],["いつ"],["まで"],["わたし"],["の"],["栄光","えいこう"],["を"],["はずかしめ"],["、"],["むなしい"],["もの"],["を"],["愛し","あいし"],["、"],["まやかし"],["もの"],["を"],["慕い求める","したいもとめる"],["の"],["か"],["。"],["セラ"]]},{"verse":3,"text":"知れ。主は、ご自分の聖徒を特別に扱われるのだ。私が呼ぶとき、主は聞いてくださる。","tok":[["知れ","しれ"],["。"],["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["の"],["聖徒","せいと"],["を"],["特別","とくべつ"],["に"],["扱われる","あつかわれる"],["の"],["だ"],["。"],["私","わたくし"],["が"],["呼ぶ","よぶ"],["とき"],["、"],["主","ぬし"],["は"],["聞いて","きいて"],["くださる"],["。"]]},{"verse":4,"text":"恐れおののけ。そして罪を犯すな。床の上で自分の心に語り、静まれ。セラ","tok":[["恐れおののけ","おそれおののけ"],["。"],["そして"],["罪","つみ"],["を"],["犯す","おかす"],["な"],["。"],["床","ゆか"],["の"],["上","うえ"],["で"],["自分","じぶん"],["の"],["心","こころ"],["に"],["語り","かたり"],["、"],["静まれ","しずまれ"],["。"],["セラ"]]},{"verse":5,"text":"義のいけにえをささげ、主に拠り頼め。","tok":[["義","ぎ"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["主に","おもに"],["拠り","より"],["頼め","たのめ"],["。"]]},{"verse":6,"text":"多くの者は言っています。「だれかわれわれに良い目を見せてくれないものか。」主よ。どうか、あなたの御顔の光を、私たちの上に照らしてください。","tok":[["多く","おおく"],["の"],["者","もの"],["は"],["言って","いって"],["います"],["。"],["「"],["だれ"],["か"],["われわれ"],["に"],["良い","よい"],["目","め"],["を"],["見せて","みせて"],["くれない"],["もの"],["か"],["。"],["」"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["御顔","おかお"],["の"],["光","ひかり"],["を"],["、"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["照らして","てらして"],["ください"],["。"]]},{"verse":7,"text":"あなたは私の心に喜びを下さいました。それは穀物と新しいぶどう酒が豊かにあるときにもまさっています。","tok":[["あなた"],["は"],["私","わたくし"],["の"],["心","こころ"],["に"],["喜び","よろこび"],["を"],["下さいました","くださいました"],["。"],["それ"],["は"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["が"],["豊か","ゆたか"],["に"],["ある"],["とき"],["に"],["も"],["まさって"],["います"],["。"]]},{"verse":8,"text":"平安のうちに私は身を横たえ、すぐ、眠りにつきます。主よ。あなただけが、私を安らかに住まわせてくださいます。","tok":[["平安","へいあん"],["の"],["うち"],["に"],["私","わたくし"],["は"],["身","み"],["を"],["横たえ","よこたえ"],["、"],["すぐ"],["、"],["眠り","ねむり"],["に"],["つきます"],["。"],["主","ぬし"],["よ"],["。"],["あなた"],["だけ"],["が"],["、"],["私","わたくし"],["を"],["安らか","やすらか"],["に"],["住まわせて","すまわせて"],["くださいます"],["。"]]}]
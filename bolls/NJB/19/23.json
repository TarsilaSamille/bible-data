[{"verse":1,"text":"（ダビデの賛歌）主は私の羊飼い。私は、乏しいことがありません。","tok":[["（"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["は"],["私","わたくし"],["の"],["羊飼い","ひつじかい"],["。"],["私","わたくし"],["は"],["、"],["乏しい","とぼしい"],["こと"],["が"],["ありません"],["。"]]},{"verse":2,"text":"主は私を緑の牧場に伏させ、いこいの水のほとりに伴われます。","tok":[["主","ぬし"],["は"],["私","わたくし"],["を"],["緑","みどり"],["の"],["牧場","ぼくじょう"],["に"],["伏させ","ふさせ"],["、"],["いこい"],["の"],["水","みず"],["の"],["ほとり"],["に"],["伴われます","ともなわれます"],["。"]]},{"verse":3,"text":"主は私のたましいを生き返らせ、御名のために、私を義の道に導かれます。","tok":[["主","ぬし"],["は"],["私","わたくし"],["の"],["たましい"],["を"],["生き返らせ","いきかえらせ"],["、"],["御名","ぎょめい"],["の"],["ため"],["に"],["、"],["私","わたくし"],["を"],["義","ぎ"],["の"],["道","みち"],["に"],["導かれます","みちびかれます"],["。"]]},{"verse":4,"text":"たとい、死の陰の谷を歩くことがあっても、私はわざわいを恐れません。あなたが私とともにおられますから。あなたのむちとあなたの杖、それが私の慰めです。","tok":[["たとい"],["、"],["死","し"],["の"],["陰","かげ"],["の"],["谷","たに"],["を"],["歩く","あるく"],["こと"],["が"],["あって"],["も"],["、"],["私","わたくし"],["は"],["わざわい"],["を"],["恐れません","おそれません"],["。"],["あなた"],["が"],["私","わたくし"],["と"],["とも"],["に"],["おられます"],["から"],["。"],["あなた"],["の"],["むち"],["と"],["あなた"],["の"],["杖","つえ"],["、"],["それ"],["が"],["私","わたくし"],["の"],["慰め","なぐさめ"],["です"],["。"]]},{"verse":5,"text":"私の敵の前で、あなたは私のために食事をととのえ、私の頭に油をそそいでくださいます。私の杯は、あふれています。","tok":[["私","わたくし"],["の"],["敵","てき"],["の"],["前","まえ"],["で"],["、"],["あなた"],["は"],["私","わたくし"],["の"],["ため"],["に"],["食事","しょくじ"],["を"],["ととのえ"],["、"],["私","わたくし"],["の"],["頭","あたま"],["に"],["油","あぶら"],["を"],["そそいで"],["くださいます"],["。"],["私","わたくし"],["の"],["杯","さかずき"],["は"],["、"],["あふれて"],["います"],["。"]]},{"verse":6,"text":"まことに、私のいのちの日の限り、いつくしみと恵みとが、私を追って来るでしょう。私は、いつまでも、主の家に住まいましょう。","tok":[["まこと"],["に"],["、"],["私","わたくし"],["の"],["いのち"],["の"],["日","ひ"],["の"],["限り","かぎり"],["、"],["いつくしみ"],["と"],["恵み","めぐみ"],["と"],["が"],["、"],["私","わたくし"],["を"],["追って","おって"],["来るでしょう","くるでしょう"],["。"],["私","わたくし"],["は"],["、"],["いつ"],["まで"],["も"],["、"],["主","ぬし"],["の"],["家","いえ"],["に"],["住まいましょう","すまいましょう"],["。"]]}]
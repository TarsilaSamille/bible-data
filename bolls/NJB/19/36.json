[{"verse":1,"text":"（指揮者のために。主のしもべ、ダビデによる）罪は悪者の心の中に語りかける。彼の目の前には、神に対する恐れがない。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["主","ぬし"],["の"],["しもべ"],["、"],["ダビデ"],["に"],["よる"],["）"],["罪","つみ"],["は"],["悪者","わるもの"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["語りかける","かたりかける"],["。"],["彼","かれ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["は"],["、"],["神","かみ"],["に"],["対する","たいする"],["恐れ","おそれ"],["が"],["ない"],["。"]]},{"verse":2,"text":"彼はおのれの目で自分にへつらっている。おのれの咎を見つけ出し、それを憎むことで。","tok":[["彼","かれ"],["は"],["おのれ"],["の"],["目","め"],["で"],["自分","じぶん"],["に"],["へつらって"],["いる"],["。"],["おのれ"],["の"],["咎","とが"],["を"],["見つけ","みつけ"],["出し","だし"],["、"],["それ"],["を"],["憎む","にくむ"],["こと"],["で"],["。"]]},{"verse":3,"text":"彼の口のことばは、不法と欺きだ。彼は知恵を得ることも、善を行うこともやめてしまっている。","tok":[["彼","かれ"],["の"],["口","くち"],["の"],["ことば"],["は"],["、"],["不法","ふほう"],["と"],["欺きだ","あざむきだ"],["。"],["彼","かれ"],["は"],["知恵","ちえ"],["を"],["得る","える"],["こと"],["も"],["、"],["善","ぜん"],["を"],["行う","おこなう"],["こと"],["も"],["やめて"],["しまって"],["いる"],["。"]]},{"verse":4,"text":"彼は寝床で、不法を図り、よくない道に堅く立っていて、悪を捨てようとしない。","tok":[["彼","かれ"],["は"],["寝床","ねどこ"],["で"],["、"],["不法","ふほう"],["を"],["図り","はかり"],["、"],["よく"],["ない"],["道","みち"],["に"],["堅く","かたく"],["立って","たって"],["いて"],["、"],["悪","あく"],["を"],["捨てよう","すてよう"],["と"],["しない"],["。"]]},{"verse":5,"text":"主よ。あなたの恵みは天にあり、あなたの真実は雲にまで及びます。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["恵み","めぐみ"],["は"],["天","てん"],["に"],["あり"],["、"],["あなた"],["の"],["真実","しんじつ"],["は"],["雲","くも"],["に"],["まで"],["及びます","およびます"],["。"]]},{"verse":6,"text":"あなたの義は高くそびえる山のようで、あなたのさばきは深い海のようです。あなたは人や獣を栄えさせてくださいます。主よ。","tok":[["あなた"],["の"],["義","ぎ"],["は"],["高く","たかく"],["そびえる"],["山","やま"],["の"],["よう"],["で"],["、"],["あなた"],["の"],["さばき"],["は"],["深い","ふかい"],["海","うみ"],["の"],["よう"],["です"],["。"],["あなた"],["は"],["人","ひと"],["や"],["獣","けもの"],["を"],["栄えさせて","さかえさせて"],["くださいます"],["。"],["主","ぬし"],["よ"],["。"]]},{"verse":7,"text":"神よ。あなたの恵みは、なんと尊いことでしょう。人の子らは御翼の陰に身を避けます。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["の"],["恵み","めぐみ"],["は"],["、"],["なん"],["と"],["尊い","とうとい"],["こと"],["でしょう"],["。"],["人","ひと"],["の"],["子","こ"],["ら"],["は"],["御翼","おつばさ"],["の"],["陰","かげ"],["に"],["身","み"],["を"],["避けます","さけます"],["。"]]},{"verse":8,"text":"彼らはあなたの家の豊かさを心ゆくまで飲むでしょう。あなたの楽しみの流れを、あなたは彼らに飲ませなさいます。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["家","いえ"],["の"],["豊か","ゆたか"],["さ"],["を"],["心ゆく","こころゆく"],["まで"],["飲むでしょう","のむでしょう"],["。"],["あなた"],["の"],["楽しみ","たのしみ"],["の"],["流れ","ながれ"],["を"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["飲ませ","のませ"],["なさいます"],["。"]]},{"verse":9,"text":"いのちの泉はあなたにあり、私たちは、あなたの光のうちに光を見るからです。","tok":[["いのち"],["の"],["泉","いずみ"],["は"],["あなた"],["に"],["あり"],["、"],["私たち","わたしたち"],["は"],["、"],["あなた"],["の"],["光","ひかり"],["の"],["うち"],["に"],["光","ひかり"],["を"],["見る","みる"],["から"],["です"],["。"]]},{"verse":10,"text":"注いでください。あなたの恵みを、あなたを知る者に。あなたの義を、心の直ぐな人に。","tok":[["注いで","そそいで"],["ください"],["。"],["あなた"],["の"],["恵み","めぐみ"],["を"],["、"],["あなた"],["を"],["知る","しる"],["者","もの"],["に"],["。"],["あなた"],["の"],["義","ぎ"],["を"],["、"],["心","こころ"],["の"],["直ぐ","すぐ"],["な"],["人","ひと"],["に"],["。"]]},{"verse":11,"text":"高ぶりの足が私に追いつかず、悪者の手が私を追いやらないようにしてください。","tok":[["高ぶり","たかぶり"],["の"],["足","あし"],["が"],["私","わたくし"],["に"],["追いつかず","おいつかず"],["、"],["悪者","わるもの"],["の"],["手","て"],["が"],["私","わたくし"],["を"],["追いやらない","おいやらない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":12,"text":"そこでは、不法を行う者は倒れ、押し倒されて立ち上がれません。","tok":[["そこ"],["で"],["は"],["、"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["は"],["倒れ","たおれ"],["、"],["押し倒されて","おしたおされて"],["立ち上がれません","たちあがれません"],["。"]]}]
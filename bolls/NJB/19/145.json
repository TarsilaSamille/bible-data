[{"verse":1,"text":"（ダビデの賛美）私の神、王よ。私はあなたをあがめます。あなたの御名を世々限りなく、ほめたたえます。","tok":[["（"],["ダビデ"],["の"],["賛美","さんび"],["）"],["私","わたくし"],["の"],["神","かみ"],["、"],["王","おう"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["あがめます"],["。"],["あなた"],["の"],["御名","ぎょめい"],["を"],["世々","せいせい"],["限りなく","かぎりなく"],["、"],["ほめたたえます"],["。"]]},{"verse":2,"text":"日ごとにあなたをほめたたえ、あなたの御名を世々限りなく賛美します。","tok":[["日ごと","ひごと"],["に"],["あなた"],["を"],["ほめたたえ"],["、"],["あなた"],["の"],["御名","ぎょめい"],["を"],["世々","せいせい"],["限りなく","かぎりなく"],["賛美","さんび"],["します"],["。"]]},{"verse":3,"text":"主は大いなる方。大いに賛美されるべき方。その偉大さを測り知ることができません。","tok":[["主","ぬし"],["は"],["大いなる","おおいなる"],["方","かた"],["。"],["大いに","おおいに"],["賛美","さんび"],["されるべき"],["方","かた"],["。"],["その"],["偉大","いだい"],["さ"],["を"],["測り知る","はかりしる"],["こと"],["が"],["できません"],["。"]]},{"verse":4,"text":"代は代へと、あなたのみわざをほめ歌い、あなたの大能のわざを告げ知らせるでしょう。","tok":[["代","だい"],["は"],["代","だい"],["へ"],["と"],["、"],["あなた"],["のみ"],["わざ"],["を"],["ほめ"],["歌い","うたい"],["、"],["あなた"],["の"],["大能","おおの"],["の"],["わざ"],["を"],["告げ知らせるでしょう","つげしらせるでしょう"],["。"]]},{"verse":5,"text":"私は栄光輝くあなたの主権と、あなたの奇しいわざに思いを潜めます。","tok":[["私","わたくし"],["は"],["栄光","えいこう"],["輝く","かがやく"],["あなた"],["の"],["主権","しゅけん"],["と"],["、"],["あなた"],["の"],["奇しい","くすしい"],["わざ"],["に"],["思い","おもい"],["を"],["潜めます","ひそめます"],["。"]]},{"verse":6,"text":"人々はあなたの恐ろしいみわざの力を語り、私はあなたの偉大さを述べるでしょう。","tok":[["人々","ひとびと"],["は"],["あなた"],["の"],["恐ろしい","おそろしい"],["みわざ"],["の"],["力","ちから"],["を"],["語り","かたり"],["、"],["私","わたくし"],["は"],["あなた"],["の"],["偉大","いだい"],["さ"],["を"],["述べるでしょう","のべるでしょう"],["。"]]},{"verse":7,"text":"人々はあなたの豊かないつくしみの思い出を熱心に語り、あなたの義を高らかに歌うでしょう。","tok":[["人々","ひとびと"],["は"],["あなた"],["の"],["豊か","ゆたか"],["な"],["いつくしみ"],["の"],["思い出","おもいで"],["を"],["熱心","ねっしん"],["に"],["語り","かたり"],["、"],["あなた"],["の"],["義","ぎ"],["を"],["高らか","たからか"],["に"],["歌うでしょう","うたうでしょう"],["。"]]},{"verse":8,"text":"主は情け深く、あわれみ深く、怒るのにおそく、恵みに富んでおられます。","tok":[["主","ぬし"],["は"],["情け深く","なさけぶかく"],["、"],["あわれみ"],["深く","ふかく"],["、"],["怒る","おこる"],["のに"],["おそく"],["、"],["恵み","めぐみ"],["に"],["富んで","とんで"],["おられます"],["。"]]},{"verse":9,"text":"主はすべてのものにいつくしみ深く、そのあわれみは、造られたすべてのものの上にあります。","tok":[["主","ぬし"],["は"],["すべて"],["の"],["もの"],["に"],["いつくしみ"],["深く","ふかく"],["、"],["その"],["あわれみ"],["は"],["、"],["造られた","つくられた"],["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["あります"],["。"]]},{"verse":10,"text":"主よ。あなたの造られたすべてのものは、あなたに感謝し、あなたの聖徒はあなたをほめたたえます。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["造られた","つくられた"],["すべて"],["の"],["もの"],["は"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["あなた"],["の"],["聖徒","せいと"],["は"],["あなた"],["を"],["ほめたたえます"],["。"]]},{"verse":11,"text":"彼らはあなたの王国の栄光を告げ、あなたの大能のわざを、語るでしょう。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["王国","おうこく"],["の"],["栄光","えいこう"],["を"],["告げ","つげ"],["、"],["あなた"],["の"],["大能","おおの"],["の"],["わざ"],["を"],["、"],["語るでしょう","かたるでしょう"],["。"]]},{"verse":12,"text":"こうして人の子らに、主の大能のわざと、主の王国の輝かしい栄光を、知らせましょう。","tok":[["こう"],["して"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["、"],["主","ぬし"],["の"],["大能","おおの"],["の"],["わざと"],["、"],["主","ぬし"],["の"],["王国","おうこく"],["の"],["輝かしい","かがやかしい"],["栄光","えいこう"],["を"],["、"],["知らせましょう","しらせましょう"],["。"]]},{"verse":13,"text":"あなたの王国は、永遠にわたる王国。あなたの統治は、代々限りなく続きます。","tok":[["あなた"],["の"],["王国","おうこく"],["は"],["、"],["永遠","えいえん"],["に"],["わたる"],["王国","おうこく"],["。"],["あなた"],["の"],["統治","とうち"],["は"],["、"],["代々","だいだい"],["限りなく","かぎりなく"],["続きます","つづきます"],["。"]]},{"verse":14,"text":"主は倒れる者をみなささえ、かがんでいる者をみな起こされます。","tok":[["主","ぬし"],["は"],["倒れる","たおれる"],["者","もの"],["を"],["みなさ"],["さえ"],["、"],["かがんで"],["いる"],["者","もの"],["を"],["みな"],["起こされます","おこされます"],["。"]]},{"verse":15,"text":"すべての目は、あなたを待ち望んでいます。あなたは時にかなって、彼らに食物を与えられます。","tok":[["すべて"],["の"],["目","め"],["は"],["、"],["あなた"],["を"],["待ち望んで","まちのぞんで"],["います"],["。"],["あなた"],["は"],["時","とき"],["に"],["かなって"],["、"],["彼","かれ"],["ら"],["に"],["食物","しょくもつ"],["を"],["与えられます","あたえられます"],["。"]]},{"verse":16,"text":"あなたは御手を開き、すべての生けるものの願いを満たされます。","tok":[["あなた"],["は"],["御手","おて"],["を"],["開き","ひらき"],["、"],["すべて"],["の"],["生ける","いける"],["もの"],["の"],["願い","ねがい"],["を"],["満たされます","みたされます"],["。"]]},{"verse":17,"text":"主はご自分のすべての道において正しく、またすべてのみわざにおいて恵み深い。","tok":[["主","ぬし"],["は"],["ご自分","ごじぶん"],["の"],["すべて"],["の"],["道","みち"],["に"],["おいて"],["正しく","ただしく"],["、"],["また"],["すべて"],["のみ"],["わざ"],["に"],["おいて"],["恵み","めぐみ"],["深い","ぶかい"],["。"]]},{"verse":18,"text":"主を呼び求める者すべて、まことをもって主を呼び求める者すべてに主は近くあられる。","tok":[["主","ぬし"],["を"],["呼び求める","よびもとめる"],["者","もの"],["すべて"],["、"],["まこと"],["を"],["もって"],["主","ぬし"],["を"],["呼び求める","よびもとめる"],["者","もの"],["すべて"],["に"],["主","ぬし"],["は"],["近く","ちかく"],["あられる"],["。"]]},{"verse":19,"text":"また主を恐れる者の願いをかなえ、彼らの叫びを聞いて、救われる。","tok":[["また"],["主","ぬし"],["を"],["恐れる","おそれる"],["者","もの"],["の"],["願い","ねがい"],["を"],["かなえ"],["、"],["彼","かれ"],["ら"],["の"],["叫び","さけび"],["を"],["聞いて","きいて"],["、"],["救われる","すくわれる"],["。"]]},{"verse":20,"text":"すべて主を愛する者は主が守られる。しかし、悪者はすべて滅ぼされる。","tok":[["すべて"],["主","ぬし"],["を"],["愛する","あいする"],["者","もの"],["は"],["主","ぬし"],["が"],["守られる","まもられる"],["。"],["しかし"],["、"],["悪者","わるもの"],["は"],["すべて"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":21,"text":"私の口が主の誉れを語り、すべて肉なる者が聖なる御名を世々限りなくほめたたえますように。","tok":[["私","わたくし"],["の"],["口","くち"],["が"],["主","ぬし"],["の"],["誉れ","ほまれ"],["を"],["語り","かたり"],["、"],["すべて"],["肉","にく"],["なる"],["者","もの"],["が"],["聖","せい"],["なる"],["御名","ぎょめい"],["を"],["世々","せいせい"],["限りなく","かぎりなく"],["ほめたたえます"],["よう"],["に"],["。"]]}]
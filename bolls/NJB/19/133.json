[{"verse":1,"text":"（都上りの歌。ダビデによる）見よ。兄弟たちが一つになって共に住むことは、なんというしあわせ、なんという楽しさであろう。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["。"],["ダビデ"],["に"],["よる"],["）"],["見","み"],["よ"],["。"],["兄弟","きょうだい"],["たち"],["が"],["一","ひと"],["つ"],["に"],["なって"],["共","とも"],["に"],["住む","すむ"],["こと"],["は"],["、"],["なん"],["と"],["いう"],["しあわせ"],["、"],["なん"],["と"],["いう"],["楽し","たのし"],["さ"],["で"],["あろう"],["。"]]},{"verse":2,"text":"それは頭の上にそそがれた尊い油のようだ。それはひげに、アロンのひげに流れてその衣のえりにまで流れしたたる。","tok":[["それ"],["は"],["頭","あたま"],["の"],["上","うえ"],["に"],["そそがれた"],["尊い","とうとい"],["油","あぶら"],["の"],["よう"],["だ"],["。"],["それ"],["は"],["ひげ"],["に"],["、"],["アロン"],["の"],["ひげ"],["に"],["流れて","ながれて"],["その"],["衣","ころも"],["の"],["えり"],["に"],["まで"],["流れ","ながれ"],["したたる"],["。"]]},{"verse":3,"text":"それはまたシオンの山々におりるヘルモンの露にも似ている。主がそこにとこしえのいのちの祝福を命じられたからである。","tok":[["それ"],["は"],["また"],["シオン"],["の"],["山々","やまやま"],["に"],["おりる"],["ヘルモン"],["の"],["露","ろ"],["に"],["も"],["似て","にて"],["いる"],["。"],["主","ぬし"],["が"],["そこ"],["に"],["とこしえ"],["の"],["いのち"],["の"],["祝福","しゅくふく"],["を"],["命じられた","めいじられた"],["から"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"さあ、主に向かって、喜び歌おう。われらの救いの岩に向かって、喜び叫ぼう。","tok":[["さあ"],["、"],["主に","おもに"],["向かって","むかって"],["、"],["喜び歌おう","よろこびうたおう"],["。"],["われ"],["ら"],["の"],["救い","すくい"],["の"],["岩","いわ"],["に"],["向かって","むかって"],["、"],["喜び叫ぼう","よろこびさけぼう"],["。"]]},{"verse":2,"text":"感謝の歌をもって、御前に進み行き、賛美の歌をもって、主に喜び叫ぼう。","tok":[["感謝","かんしゃ"],["の"],["歌","うた"],["を"],["もって"],["、"],["御前","ごぜん"],["に"],["進み","すすみ"],["行き","いき"],["、"],["賛美","さんび"],["の"],["歌","うた"],["を"],["もって"],["、"],["主に","おもに"],["喜び叫ぼう","よろこびさけぼう"],["。"]]},{"verse":3,"text":"主は大いなる神であり、すべての神々にまさって、大いなる王である。","tok":[["主","ぬし"],["は"],["大いなる","おおいなる"],["神","かみ"],["で"],["あり"],["、"],["すべて"],["の"],["神々","かみがみ"],["に"],["まさって"],["、"],["大いなる","おおいなる"],["王","おう"],["で"],["ある"],["。"]]},{"verse":4,"text":"地の深みは主の御手のうちにあり、山々の頂も主のものである。","tok":[["地","ち"],["の"],["深み","ふかみ"],["は"],["主","ぬし"],["の"],["御手","おて"],["の"],["うち"],["に"],["あり"],["、"],["山々","やまやま"],["の"],["頂","いただき"],["も"],["主","ぬし"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":5,"text":"海は主のもの。主がそれを造られた。陸地も主の御手が造られた。","tok":[["海","うみ"],["は"],["主","ぬし"],["の"],["もの"],["。"],["主","ぬし"],["が"],["それ"],["を"],["造られた","つくられた"],["。"],["陸地","りくち"],["も"],["主","ぬし"],["の"],["御手","おて"],["が"],["造られた","つくられた"],["。"]]},{"verse":6,"text":"来たれ。私たちは伏し拝み、ひれ伏そう。私たちを造られた方、主の御前に、ひざまずこう。","tok":[["来たれ","きたれ"],["。"],["私たち","わたしたち"],["は"],["伏し拝み","ふしおがみ"],["、"],["ひれ伏そう","ひれふそう"],["。"],["私たち","わたしたち"],["を"],["造られた","つくられた"],["方","かた"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["、"],["ひざまずこう"],["。"]]},{"verse":7,"text":"主は、私たちの神。私たちは、その牧場の民、その御手の羊である。きょう、もし御声を聞くなら、","tok":[["主","ぬし"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["。"],["私たち","わたしたち"],["は"],["、"],["その"],["牧場","ぼくじょう"],["の"],["民","たみ"],["、"],["その"],["御手","おて"],["の"],["羊","ひつじ"],["で"],["ある"],["。"],["きょう"],["、"],["もし"],["御声","おこえ"],["を"],["聞くなら","きくなら"],["、"]]},{"verse":8,"text":"メリバでのときのように、荒野のマサでの日のように、あなたがたの心をかたくなにしてはならない。","tok":[["メリバ"],["で"],["の"],["とき"],["の"],["よう"],["に"],["、"],["荒野","こうや"],["の"],["マサ"],["で"],["の"],["日","ひ"],["の"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["。"]]},{"verse":9,"text":"あのとき、あなたがたの先祖たちはすでにわたしのわざを見ておりながら、わたしを試み、わたしをためした。","tok":[["あの"],["とき"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["は"],["すでに"],["わたし"],["の"],["わざ"],["を"],["見て","みて"],["おり"],["ながら"],["、"],["わたし"],["を"],["試み","こころみ"],["、"],["わたし"],["を"],["ためした"],["。"]]},{"verse":10,"text":"わたしは四十年の間、その世代の者たちを忌みきらい、そして言った。「彼らは、心の迷っている民だ。彼らは、わたしの道を知ってはいない」と。","tok":[["わたし"],["は"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["その"],["世代","せだい"],["の"],["者","もの"],["たち"],["を"],["忌みきらい","いみきらい"],["、"],["そして"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["、"],["心","こころ"],["の"],["迷って","まよって"],["いる"],["民","たみ"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["道","みち"],["を"],["知って","しって"],["は"],["いない"],["」"],["と"],["。"]]},{"verse":11,"text":"それゆえ、わたしは怒って誓った。「確かに彼らは、わたしの安息に、入れない」と。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["怒って","おこって"],["誓った","ちかった"],["。"],["「"],["確か","たしか"],["に"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["安息","あんそく"],["に"],["、"],["入れない","いれない"],["」"],["と"],["。"]]}]
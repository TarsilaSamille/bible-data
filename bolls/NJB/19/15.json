[{"verse":1,"text":"（ダビデの賛歌）主よ。だれが、あなたの幕屋に宿るのでしょうか。だれが、あなたの聖なる山に住むのでしょうか。","tok":[["（"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["だれ"],["が"],["、"],["あなた"],["の"],["幕屋","まくや"],["に"],["宿る","やどる"],["の"],["でしょう"],["か"],["。"],["だれ"],["が"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["山","やま"],["に"],["住む","すむ"],["の"],["でしょう"],["か"],["。"]]},{"verse":2,"text":"正しく歩み、義を行い、心の中の真実を語る人。","tok":[["正しく","ただしく"],["歩み","あゆみ"],["、"],["義","ぎ"],["を"],["行い","おこない"],["、"],["心","こころ"],["の"],["中","なか"],["の"],["真実","しんじつ"],["を"],["語る","かたる"],["人","ひと"],["。"]]},{"verse":3,"text":"その人は、舌をもってそしらず、友人に悪を行わず、隣人への非難を口にしない。","tok":[["その"],["人","ひと"],["は"],["、"],["舌","した"],["を"],["もって"],["そしらず"],["、"],["友人","ゆうじん"],["に"],["悪","あく"],["を"],["行わず","おこなわず"],["、"],["隣人","りんじん"],["へ"],["の"],["非難","ひなん"],["を"],["口","くち"],["に"],["しない"],["。"]]},{"verse":4,"text":"神に捨てられた人を、その目はさげすみ、主を恐れる者を尊ぶ。損になっても、立てた誓いは変えない。","tok":[["神","かみ"],["に"],["捨てられた","すてられた"],["人","ひと"],["を"],["、"],["その"],["目","め"],["は"],["さげすみ"],["、"],["主","ぬし"],["を"],["恐れる","おそれる"],["者","もの"],["を"],["尊ぶ","とうとぶ"],["。"],["損","そん"],["に"],["なって"],["も"],["、"],["立てた","たてた"],["誓い","ちかい"],["は"],["変えない","かえない"],["。"]]},{"verse":5,"text":"金を貸しても利息を取らず、罪を犯さない人にそむいて、わいろを取らない。このように行う人は、決してゆるがされない。","tok":[["金","きん"],["を"],["貸して","かして"],["も"],["利息","りそく"],["を"],["取らず","とらず"],["、"],["罪","つみ"],["を"],["犯さない","おかさない"],["人","ひと"],["に"],["そむいて"],["、"],["わいろ"],["を"],["取らない","とらない"],["。"],["この"],["よう"],["に"],["行う","おこなう"],["人","ひと"],["は"],["、"],["決して","けっして"],["ゆるがされない"],["。"]]}]
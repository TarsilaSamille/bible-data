[{"verse":1,"text":"（ダビデのミクタム）神よ。私をお守りください。私は、あなたに身を避けます。","tok":[["（"],["ダビデ"],["の"],["ミクタム"],["）"],["神","かみ"],["よ"],["。"],["私","わたくし"],["を"],["お守り","おまもり"],["ください"],["。"],["私","わたくし"],["は"],["、"],["あなた"],["に"],["身","み"],["を"],["避けます","さけます"],["。"]]},{"verse":2,"text":"私は、主に申し上げました。「あなたこそ、私の主。私の幸いは、あなたのほかにはありません。」","tok":[["私","わたくし"],["は"],["、"],["主に","おもに"],["申し上げました","もうしあげました"],["。"],["「"],["あなた"],["こそ"],["、"],["私","わたくし"],["の"],["主","ぬし"],["。"],["私","わたくし"],["の"],["幸い","さいわい"],["は"],["、"],["あなた"],["の"],["ほか"],["に"],["は"],["ありません"],["。"],["」"]]},{"verse":3,"text":"地にある聖徒たちには威厳があり、私の喜びはすべて、彼らの中にあります。","tok":[["地","ち"],["に"],["ある"],["聖徒","せいと"],["たち"],["に"],["は"],["威厳","いげん"],["が"],["あり"],["、"],["私","わたくし"],["の"],["喜び","よろこび"],["は"],["すべて"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["あります"],["。"]]},{"verse":4,"text":"ほかの神へ走った者の痛みは増し加わりましょう。私は、彼らの注ぐ血の酒を注がず、その名を口に唱えません。","tok":[["ほか"],["の"],["神","かみ"],["へ"],["走った","はしった"],["者","もの"],["の"],["痛み","いたみ"],["は"],["増し","まし"],["加わりましょう","くわわりましょう"],["。"],["私","わたくし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["注ぐ","そそぐ"],["血","ち"],["の"],["酒","さけ"],["を"],["注がず","そそがず"],["、"],["その"],["名","な"],["を"],["口","くち"],["に"],["唱えません","となえません"],["。"]]},{"verse":5,"text":"主は、私へのゆずりの地所、また私への杯です。あなたは、私の受ける分を、堅く保っていてくださいます。","tok":[["主","ぬし"],["は"],["、"],["私","わたくし"],["へ"],["の"],["ゆずり"],["の"],["地所","じしょ"],["、"],["また"],["私","わたくし"],["へ"],["の"],["杯","さかずき"],["です"],["。"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["受ける","うける"],["分","ぶん"],["を"],["、"],["堅く","かたく"],["保って","たもって"],["いて"],["くださいます"],["。"]]},{"verse":6,"text":"測り綱は、私の好む所に落ちた。まことに、私への、すばらしいゆずりの地だ。","tok":[["測り","はかり"],["綱","つな"],["は"],["、"],["私","わたくし"],["の"],["好む","このむ"],["所","ところ"],["に"],["落ちた","おちた"],["。"],["まこと"],["に"],["、"],["私","わたくし"],["へ"],["の"],["、"],["すばらしい"],["ゆずり"],["の"],["地","ち"],["だ"],["。"]]},{"verse":7,"text":"私は助言を下さった主をほめたたえる。まことに、夜になると、私の心が私に教える。","tok":[["私","わたくし"],["は"],["助言","じょげん"],["を"],["下さった","くださった"],["主","ぬし"],["を"],["ほめたたえる"],["。"],["まこと"],["に"],["、"],["夜","よる"],["に"],["なる"],["と"],["、"],["私","わたくし"],["の"],["心","こころ"],["が"],["私","わたくし"],["に"],["教える","おしえる"],["。"]]},{"verse":8,"text":"私はいつも、私の前に主を置いた。主が私の右におられるので、私はゆるぐことがない。","tok":[["私","わたくし"],["は"],["いつも"],["、"],["私","わたくし"],["の"],["前","まえ"],["に"],["主","ぬし"],["を"],["置いた","おいた"],["。"],["主","ぬし"],["が"],["私","わたくし"],["の"],["右","みぎ"],["に"],["おられる"],["ので"],["、"],["私","わたくし"],["は"],["ゆるぐ"],["こと"],["が"],["ない"],["。"]]},{"verse":9,"text":"それゆえ、私の心は喜び、私のたましいは楽しんでいる。私の身もまた安らかに住まおう。","tok":[["それ"],["ゆえ"],["、"],["私","わたくし"],["の"],["心","こころ"],["は"],["喜び","よろこび"],["、"],["私","わたくし"],["の"],["たましい"],["は"],["楽しんで","たのしんで"],["いる"],["。"],["私","わたくし"],["の"],["身","み"],["も"],["また"],["安らか","やすらか"],["に"],["住まおう","すまおう"],["。"]]},{"verse":10,"text":"まことに、あなたは、私のたましいをよみに捨ておかず、あなたの聖徒に墓の穴をお見せにはなりません。","tok":[["まこと"],["に"],["、"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["たましい"],["を"],["よみ"],["に"],["捨ておかず","すておかず"],["、"],["あなた"],["の"],["聖徒","せいと"],["に"],["墓","はか"],["の"],["穴","あな"],["を"],["お見せ","おみせ"],["に"],["は"],["なりません"],["。"]]},{"verse":11,"text":"あなたは私に、いのちの道を知らせてくださいます。あなたの御前には喜びが満ち、あなたの右には、楽しみがとこしえにあります。","tok":[["あなた"],["は"],["私","わたくし"],["に"],["、"],["いのち"],["の"],["道","みち"],["を"],["知らせて","しらせて"],["くださいます"],["。"],["あなた"],["の"],["御前","ごぜん"],["に"],["は"],["喜び","よろこび"],["が"],["満ち","みち"],["、"],["あなた"],["の"],["右","みぎ"],["に"],["は"],["、"],["楽しみ","たのしみ"],["が"],["とこしえ"],["に"],["あります"],["。"]]}]
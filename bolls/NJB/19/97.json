[{"verse":1,"text":"主は、王だ。地は、こおどりし、多くの島々は喜べ。","tok":[["主","ぬし"],["は"],["、"],["王","おう"],["だ"],["。"],["地","ち"],["は"],["、"],["こおどり"],["し"],["、"],["多く","おおく"],["の"],["島々","しまじま"],["は"],["喜べ","よろこべ"],["。"]]},{"verse":2,"text":"雲と暗やみが主を取り囲み、義とさばきが御座の基である。","tok":[["雲","くも"],["と"],["暗やみ","くらやみ"],["が"],["主","ぬし"],["を"],["取り囲み","とりかこみ"],["、"],["義","ぎ"],["と"],["さばき"],["が"],["御座","ぎょざ"],["の"],["基","もと"],["で"],["ある"],["。"]]},{"verse":3,"text":"火は御前に先立って行き主を取り囲む敵を焼き尽くす。","tok":[["火","ひ"],["は"],["御前","ごぜん"],["に"],["先立って","さきだって"],["行き","いき"],["主","しゅ"],["を"],["取り囲む","とりかこむ"],["敵","てき"],["を"],["焼き","やき"],["尽くす","つくす"],["。"]]},{"verse":4,"text":"主のいなずまは世界を照らし、地は見て、おののく。","tok":[["主","ぬし"],["の"],["いなずま"],["は"],["世界","せかい"],["を"],["照らし","てらし"],["、"],["地","ち"],["は"],["見て","みて"],["、"],["おののく"],["。"]]},{"verse":5,"text":"山々は主の御前に、ろうのように溶けた。全地の主の御前に。","tok":[["山々","やまやま"],["は"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["、"],["ろう"],["の"],["よう"],["に"],["溶けた","とけた"],["。"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["。"]]},{"verse":6,"text":"天は主の義を告げ、すべての国々の民は主の栄光を見る。","tok":[["天","てん"],["は"],["主","ぬし"],["の"],["義","ぎ"],["を"],["告げ","つげ"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["主","ぬし"],["の"],["栄光","えいこう"],["を"],["見る","みる"],["。"]]},{"verse":7,"text":"偶像に仕える者、むなしいものを誇りとする者は、みな恥を見よう。すべての神々よ。主にひれ伏せ。","tok":[["偶像","ぐうぞう"],["に"],["仕える","つかえる"],["者","もの"],["、"],["むなしい"],["もの"],["を"],["誇り","ほこり"],["と"],["する"],["者","もの"],["は"],["、"],["みな"],["恥","はじ"],["を"],["見よう","みよう"],["。"],["すべて"],["の"],["神々","かみがみ"],["よ"],["。"],["主に","おもに"],["ひれ伏せ","ひれふせ"],["。"]]},{"verse":8,"text":"シオンは聞いて、喜び、ユダの娘たちも、こおどりしました。主よ。あなたのさばきのために。","tok":[["シオン"],["は"],["聞いて","きいて"],["、"],["喜び","よろこび"],["、"],["ユダ"],["の"],["娘","むすめ"],["たち"],["も"],["、"],["こおどり"],["しました"],["。"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["さばき"],["の"],["ため"],["に"],["。"]]},{"verse":9,"text":"まことに主よ。あなたは全地の上に、すぐれて高い方。すべての神々をはるかに抜いて、高きにおられます。","tok":[["まこと"],["に"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["全地","ぜんち"],["の"],["上","うえ"],["に"],["、"],["すぐれて"],["高い","たかい"],["方","ほう"],["。"],["すべて"],["の"],["神々","かみがみ"],["を"],["はるか"],["に"],["抜いて","ぬいて"],["、"],["高き","たかき"],["に"],["おられます"],["。"]]},{"verse":10,"text":"主を愛する者たちよ。悪を憎め。主は聖徒たちのいのちを守り、悪者どもの手から、彼らを救い出される。","tok":[["主","ぬし"],["を"],["愛する","あいする"],["者","もの"],["たち"],["よ"],["。"],["悪","あく"],["を"],["憎め","にくめ"],["。"],["主","ぬし"],["は"],["聖徒","せいと"],["たち"],["の"],["いのち"],["を"],["守り","まもり"],["、"],["悪者","わるもの"],["ども"],["の"],["手","て"],["から"],["、"],["彼","かれ"],["ら"],["を"],["救い出される","すくいだされる"],["。"]]},{"verse":11,"text":"光は、正しい者のために、種のように蒔かれている。喜びは、心の直ぐな人のために。","tok":[["光","ひかり"],["は"],["、"],["正しい","ただしい"],["者","もの"],["の"],["ため"],["に"],["、"],["種","しゅ"],["の"],["よう"],["に"],["蒔かれて","まかれて"],["いる"],["。"],["喜び","よろこび"],["は"],["、"],["心","こころ"],["の"],["直ぐ","すぐ"],["な"],["人","ひと"],["の"],["ため"],["に"],["。"]]},{"verse":12,"text":"正しい者たち。主にあって喜べ。その聖なる御名に感謝せよ。","tok":[["正しい","ただしい"],["者","もの"],["たち"],["。"],["主に","おもに"],["あって"],["喜べ","よろこべ"],["。"],["その"],["聖","せい"],["なる"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["せよ"],["。"]]}]
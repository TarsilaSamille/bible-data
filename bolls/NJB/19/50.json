[{"verse":1,"text":"（アサフの賛歌）神の神、主は語り、地を呼び寄せられた。日の上る所から沈む所まで。","tok":[["（"],["アサフ"],["の"],["賛歌","さんか"],["）"],["神","かみ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["語り","かたり"],["、"],["地","ち"],["を"],["呼び寄せられた","よびよせられた"],["。"],["日","ひ"],["の"],["上る","のぼる"],["所","ところ"],["から"],["沈む","しずむ"],["所","ところ"],["まで"],["。"]]},{"verse":2,"text":"麗しさの窮み、シオンから、神は光を放たれた。","tok":[["麗し","うるわし"],["さ"],["の"],["窮み","きわみ"],["、"],["シオン"],["から"],["、"],["神","かみ"],["は"],["光","ひかり"],["を"],["放たれた","はなたれた"],["。"]]},{"verse":3,"text":"われらの神は来て、黙ってはおられない。御前には食い尽くす火があり、その回りには激しいあらしがある。","tok":[["われ"],["ら"],["の"],["神","かみ"],["は"],["来て","きて"],["、"],["黙って","だまって"],["は"],["おられない"],["。"],["御前","ごぜん"],["に"],["は"],["食い","くい"],["尽くす","つくす"],["火","ひ"],["が"],["あり"],["、"],["その"],["回り","まわり"],["に"],["は"],["激しい","はげしい"],["あらし"],["が"],["ある"],["。"]]},{"verse":4,"text":"神はご自分の民をさばくため、上なる天と、地とを呼び寄せられる。","tok":[["神","かみ"],["は"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["さばく"],["ため"],["、"],["上","うえ"],["なる"],["天","てん"],["と"],["、"],["地","ち"],["と"],["を"],["呼び寄せられる","よびよせられる"],["。"]]},{"verse":5,"text":"「わたしの聖徒たちをわたしのところに集めよ。いけにえにより、わたしの契約を結んだ者たちを。」","tok":[["「"],["わたし"],["の"],["聖徒","せいと"],["たち"],["を"],["わたし"],["の"],["ところ"],["に"],["集めよ","あつめよ"],["。"],["いけにえ"],["に"],["より"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["者","もの"],["たち"],["を"],["。"],["」"]]},{"verse":6,"text":"天は神の義を告げ知らせる。まことに神こそは審判者である。セラ","tok":[["天","てん"],["は"],["神","かみ"],["の"],["義","ぎ"],["を"],["告げ知らせる","つげしらせる"],["。"],["まこと"],["に"],["神","かみ"],["こそ"],["は"],["審判者","しんぱんしゃ"],["で"],["ある"],["。"],["セラ"]]},{"verse":7,"text":"「聞け。わが民よ。わたしは語ろう。イスラエルよ。わたしはあなたを戒めよう。わたしは神、あなたの神である。","tok":[["「"],["聞け","きけ"],["。"],["わが"],["民","たみ"],["よ"],["。"],["わたし"],["は"],["語ろう","かたろう"],["。"],["イスラエル"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["戒めよう","いましめよう"],["。"],["わたし"],["は"],["神","かみ"],["、"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":8,"text":"いけにえのことで、あなたを責めるのではない。あなたの全焼のいけにえは、いつも、わたしの前にある。","tok":[["いけにえ"],["の"],["こと"],["で"],["、"],["あなた"],["を"],["責める","せめる"],["の
[{"verse":1,"text":"（指揮者のために。ダビデの賛歌）主よ。私はあなたに身を避けています。私が決して恥を見ないようにしてください。あなたの義によって、私を助け出してください。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["身","み"],["を"],["避けて","さけて"],["います"],["。"],["私","わたくし"],["が"],["決して","けっして"],["恥","はじ"],["を"],["見ない","みない"],["よう"],["に"],["して"],["ください"],["。"],["あなた"],["の"],["義","ぎ"],["によって"],["、"],["私","わたくし"],["を"],["助け出して","たすけだして"],["ください"],["。"]]},{"verse":2,"text":"私に耳を傾け、早く私を救い出してください。私の力の岩となり、強いとりでとなって、私を救ってください。","tok":[["私","わたくし"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["早く","はやく"],["私","わたくし"],["を"],["救い出して","すくいだして"],["ください"],["。"],["私","わたくし"],["の"],["力","ちから"],["の"],["岩","いわ"],["と"],["なり"],["、"],["強い","つよい"],["とりで"],["と"],["なって"],["、"],["私","わたくし"],["を"],["救って","すくって"],["ください"],["。"]]},{"verse":3,"text":"あなたこそ、私の巌、私のとりでです。あなたの御名のゆえに、私を導き、私を伴ってください。","tok":[["あなた"],["こそ"],["、"],["私","わたくし"],["の"],["巌","いわ"],["、"],["私","わたくし"],["の"],["とりで"],["です"],["。"],["あなた"],["の"],["御名","ぎょめい"],["の"],["ゆえ"],["に"],["、"],["私","わたくし"],["を"],["導き","みちびき"],["、"],["私","わたくし"],["を"],["伴って","ともなって"],["ください"],["。"]]},{"verse":4,"text":"私をねらってひそかに張られた網から、私を引き出してください。あなたは私の力ですから。","tok":[["私","わたくし"],["を"],["ねらって"],["ひそか"],["に"],["張られた","はられた"],["網","あみ"],["から"],["、"],["私","わたくし"],["を"],["引き出して","ひきだして"],["ください"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["力","ちから"],["です"],["から"],["。"]]},{"verse":5,"text":"私の霊を御手にゆだねます。真実の神、主よ。あなたは私を贖い出してくださいました。","tok":[["私","わたくし"],["の"],["霊","れい"],["を"],["御手","おて"],["に"],["ゆだねます"],["。"],["真実","しんじつ"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["私","わたくし"],["を"],["贖い","あがない"],["出して","だして"],["くださいました"],["。"]]},{"verse":6,"text":"私は、むなしい偶像につく者を憎み、主に信頼しています。","tok":[["私","わたくし"],["は"],["、"],["むなしい"],["偶像","ぐうぞう"],["に"],["つく"],["者","もの"],["を"],["憎み","にくみ"],["、"],["主に","おもに"],["信頼","しんらい"],["して"],["います"],["。"]]},{"verse":7,"text":"あなたの恵みを私は楽しみ、喜びます。あなたは、私の悩みをご覧になり、私のたましいの苦しみを知っておられました。","tok":[["あなた"],["の"],["恵み","めぐみ"],["を"],["私","わたくし"],["は"],["楽しみ","たのしみ"],["、"],["喜びます","よろこびます"],["。"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["悩み","なやみ"],["を"],["ご覧","ごらん"],["に"],["なり"],["、"],["私","わたくし"],["の"],["たましい"],["の"],["苦しみ","くるしみ"],["を"],["知って","しって"],["おられました"],["。"]]},{"verse":8,"text":"あなたは私を敵の手に渡さず、私の足を広い所に立たせてくださいました。","tok":[["あなた"],["は"],["私","わたくし"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡さず","わたさず"],["、"],["私","わたくし"],["の"],["足","あし"],["を"],["広い","ひろい"],["所","ところ"],["に"],["立たせて","たたせて"],["くださいました"],["。"]]},{"verse":9,"text":"私をあわれんでください。主よ。私には苦しみがあるのです。私の目はいらだちで衰えてしまいました。私のたましいも、また私のからだも。","tok":[["私","わたくし"],["を"],["あわれんで"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["に"],["は"],["苦しみ","くるしみ"],["が"],["ある"],["の"],["です"],["。"],["私","わたくし"],["の"],["目","め"],["は"],["いらだち"],["で"],["衰えて","おとろえて"],["しまいました"],["。"],["私","わたくし"],["の"],["たましい"],["も"],["、"],["また"],["私","わたくし"],["の"],["からだ"],["も"],["。"]]},{"verse":10,"text":"まことに私のいのちは悲しみで尽き果てました。私の年もまた、嘆きで。私の力は私の咎によって弱まり、私の骨々も衰えてしまいました。","tok":[["まこと"],["に"],["私","わたくし"],["の"],["いのち"],["は"],["悲しみ","かなしみ"],["で"],["尽き","つき"],["果てました","はてました"],["。"],["私","わたくし"],["の"],["年","とし"],["も"],["また"],["、"],["嘆き","なげき"],["で"],["。"],["私","わたくし"],["の"],["力","ちから"],["は"],["私","わたくし"],["の"],["咎","とが"],["によって"],["弱まり","よわまり"],["、"],["私","わたくし"],["の"],["骨々","ほねぼね"],["も"],["衰えて","おとろえて"],["しまいました"],["。"]]},{"verse":11,"text":"私は、敵対するすべての者から、非難されました。わけても、私の隣人から。私の親友には恐れられ、外で私に会う者は、私を避けて逃げ去ります。","tok":[["私","わたくし"],["は"],["、"],["敵対","てきたい"],["する"],["すべて"],["の"],["者","もの"],["から"],["、"],["非難","ひなん"],["されました"],["。"],["わけて"],["も"],["、"],["私","わたくし"],["の"],["隣人","りんじん"],["から"],["。"],["私","わたくし"],["の"],["親友","しんゆう"],["に"],["は"],["恐れられ","おそれられ"],["、"],["外","そと"],["で"],["私","わたくし"],["に"],["会う","あう"],["者","もの"],["は"],["、"],["私","わたくし"],["を"],["避けて","さけて"],["逃げ去ります","にげさります"],["。"]]},{"verse":12,"text":"私は死人のように、人の心から忘れられ、こわれた器のようになりました。","tok":[["私","わたくし"],["は"],["死人","しにん"],["の"],["よう"],["に"],["、"],["人","ひと"],["の"],["心","こころ"],["から"],["忘れられ","わすれられ
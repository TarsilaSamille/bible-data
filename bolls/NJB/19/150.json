[{"verse":1,"text":"ハレルヤ。神の聖所で、神をほめたたえよ。御力の大空で、神をほめたたえよ。","tok":[["ハレルヤ"],["。"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["で"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"],["御力","おちから"],["の"],["大空","おおぞら"],["で"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"その大能のみわざのゆえに、神をほめたたえよ。そのすぐれた偉大さのゆえに、神をほめたたえよ。","tok":[["その"],["大能","おおの"],["のみ"],["わざ"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"],["その"],["すぐれた"],["偉大","いだい"],["さ"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":3,"text":"角笛を吹き鳴らして、神をほめたたえよ。十弦の琴と立琴をかなでて、神をほめたたえよ。","tok":[["角笛","つのぶえ"],["を"],["吹き鳴らして","ふきならして"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["と"],["立琴","たてごと"],["を"],["かなでて"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":4,"text":"タンバリンと踊りをもって、神をほめたたえよ。緒琴と笛とで、神をほめたたえよ。","tok":[["タンバリン"],["と"],["踊り","おどり"],["を"],["もって"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"],["緒","いとぐち"],["琴","こと"],["と"],["笛","ふえ"],["と"],["で"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":5,"text":"音の高いシンバルで、神をほめたたえよ。鳴り響くシンバルで、神をほめたたえよ。","tok":[["音","おと"],["の"],["高い","たかい"],["シンバル"],["で"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"],["鳴り響く","なりひびく"],["シンバル"],["で"],["、"],["神","かみ"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":6,"text":"息のあるものはみな、主をほめたたえよ。ハレルヤ。","tok":[["息","いき"],["の"],["ある"],["もの"],["は"],["みな"],["、"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["ハレルヤ"],["。"]]}]
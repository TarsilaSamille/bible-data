[{"verse":1,"text":"復讐の神、主よ。復讐の神よ。光を放ってください。","tok":[["復讐","ふくしゅう"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["復讐","ふくしゅう"],["の"],["神","かみ"],["よ"],["。"],["光","ひかり"],["を"],["放って","はなって"],["ください"],["。"]]},{"verse":2,"text":"地をさばく方よ。立ち上がってください。高ぶる者に報復してください。","tok":[["地","ち"],["を"],["さばく"],["方","ほう"],["よ"],["。"],["立ち上がって","たちあがって"],["ください"],["。"],["高ぶる","たかぶる"],["者","もの"],["に"],["報復","ほうふく"],["して"],["ください"],["。"]]},{"verse":3,"text":"主よ。悪者どもはいつまで、いつまで、悪者どもは、勝ち誇るのでしょう。","tok":[["主","ぬし"],["よ"],["。"],["悪者","わるもの"],["ども"],["は"],["いつ"],["まで"],["、"],["いつ"],["まで"],["、"],["悪者","わるもの"],["ども"],["は"],["、"],["勝ち誇る","かちほこる"],["の"],["でしょう"],["。"]]},{"verse":4,"text":"彼らは放言し、横柄に語り、不法を行う者はみな自慢します。","tok":[["彼","かれ"],["ら"],["は"],["放言","ほうげん"],["し"],["、"],["横柄","おうへい"],["に"],["語り","かたり"],["、"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["は"],["みな"],["自慢","じまん"],["します"],["。"]]},{"verse":5,"text":"主よ。彼らはあなたの民を打ち砕き、あなたのものである民を悩まします。","tok":[["主","ぬし"],["よ"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["民","たみ"],["を"],["打ち砕き","うちくだき"],["、"],["あなた"],["の"],["もの"],["で"],["ある"],["民","たみ"],["を"],["悩まします","なやまします"],["。"]]},{"verse":6,"text":"彼らは、やもめや在留異国人を殺し、みなしごたちを打ち殺します。","tok":[["彼","かれ"],["ら"],["は"],["、"],["やもめ"],["や"],["在留","ざいりゅう"],["異国人","いこくにん"],["を"],["殺し","ころし"],["、"],["みなしご"],["たち"],["を"],["打ち殺します","うちころします"],["。"]]},{"verse":7,"text":"こうして彼らは言っています。「主は見ることはない。ヤコブの神は気づかない。」","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["言って","いって"],["います"],["。"],["「"],["主","ぬし"],["は"],["見る","みる"],["こと"],["は"],["ない"],["。"],["ヤコブ"],["の"],["神","かみ"],["は"],["気づかない","きづかない"],["。"],["」"]]},{"verse":8,"text":"気づけ。民のうちのまぬけ者ども。愚か者ども。おまえらは、いつになったら、わかるのか。","tok":[["気づけ","きづけ"],["。"],["民","たみ"],["の"],["うち"],["の"],["まぬけ者","まぬけしゃ"],["ど"],["も"],["。"],["愚か者","おろかもの"],["ども"],["。"],["おまえ"],["ら"],["は"],["、"],["いつ"],["に"],["なったら"],["、"],["わかる"],["の"],["か"],["。"]]},{"verse":9,"text":"耳を植えつけられた方が、お聞きにならないだろうか。目を造られた方が、ご覧にならないだろうか。","tok":[["耳","みみ"],["を"],["植えつけられた","うえつけられた"],["方","ほう"],["が"],["、"],["お聞き","おきき"],["に"
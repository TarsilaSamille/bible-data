[{"verse":1,"text":"（歌。ダビデの賛歌）神よ。私の心はゆるぎません。私は歌い、私のたましいもまた、ほめ歌を歌いましょう。","tok":[["（"],["歌","うた"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["神","かみ"],["よ"],["。"],["私","わたくし"],["の"],["心","こころ"],["は"],["ゆるぎません"],["。"],["私","わたくし"],["は"],["歌い","うたい"],["、"],["私","わたくし"],["の"],["たましい"],["も"],["また"],["、"],["ほめ歌","ほめうた"],["を"],["歌いましょう","うたいましょう"],["。"]]},{"verse":2,"text":"十弦の琴よ、立琴よ。目をさませ。私は暁を呼びさましたい。","tok":[["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["よ"],["、"],["立琴","たてごと"],["よ"],["。"],["目","め"],["を"],["さませ"],["。"],["私","わたくし"],["は"],["暁","あかつき"],["を"],["呼びさましたい","よびさましたい"],["。"]]},{"verse":3,"text":"主よ。私は、国々の民の中にあって、あなたに感謝し、国民の中にあって、あなたにほめ歌を歌いましょう。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["あって"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["国民","こくみん"],["の"],["中","なか"],["に"],["あって"],["、"],["あなた"],["に"],["ほめ歌","ほめうた"],["を"],["歌いましょう","うたいましょう"],["。"]]},{"verse":4,"text":"あなたの恵みは大きく、天の上にまで及び、あなたのまことは雲にまで及ぶからです。","tok":[["あなた"],["の"],["恵み","めぐみ"],["は"],["大きく","おおきく"],["、"],["天","てん"],["の"],["上","うえ"],["に"],["まで"],["及び","および"],["、"],["あなた"],["の"],["まこと"],["は"],["雲","くも"],["に"],["まで"],["及ぶ","およぶ"],["から"],["です"],["。"]]},{"verse":5,"text":"神よ。あなたが天であがめられ、あなたの栄光が全世界であがめられますように。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["が"],["天","てん"],["で"],["あがめられ"],["、"],["あなた"],["の"],["栄光","えいこう"],["が"],["全","ぜん"],["世界","せかい"],["で"],["あがめられます"],["よう"],["に"],["。"]]},{"verse":6,"text":"あなたの愛する者が助け出されるために、あなたの右の手で救ってください。そして私に答えてください。","tok":[["あなた"],["の"],["愛する","あいする"],["者","もの"],["が"],["助け出される","たすけだされる"],["ため"],["に"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["で"],["救って","すくって"],["ください"],["。"],["そして"],["私","わたくし"],["に"],["答えて","こたえて"],["ください"],["。"]]},{"verse":7,"text":"神は聖所から告げられた。「わたしは、喜び勇んで、シェケムを分割し、スコテの谷を配分しよう。","tok":[["神","かみ"],["は"],["聖","せい"],["所","しょ"],["から"],["告げられた","つげられた"],["。"],["「"],["わたし"],["は"],["、"],["喜び勇んで","よろこびいさんで"],["、"],["シェケム"],["を"],["分割","ぶんかつ"],["し"],["、"],["スコテ"],["の"],["谷","たに"],["を"],["配分","はいぶん"],["しよう"],["。"]]},{"verse":8,"text":"ギルアデはわたしのもの。マナセもわたしのもの。エフライムもまた、わたしの頭のかぶと。ユダはわたしの杖。","tok":[["ギルアデ"],["は"],["わたし"],["の"],["もの"],["。"],["マナセ"],["も"],["わたし"],["の"],["もの"],["。"],["エフライム"],["も"],["また"],["、"],["わたし"],["の"],["頭","あたま"],["の"],["かぶと"],["。"],["ユダ"],["は"],["わたし"],["の"],["杖","つえ"],["。"]]},{"verse":9,"text":"モアブはわたしの足を洗うたらい。エドムの上に、わたしのはきものを投げつけよう。ペリシテの上で、わたしは大声で叫ぼう。」","tok":[["モアブ"],["は"],["わたし"],["の"],["足","あし"],["を"],["洗うたら","あろうたら"],["い"],["。"],["エドム"],["の"],["上","うえ"],["に"],["、"],["わたし"],["の"],["はきもの"],["を"],["投げつけよう","なげつけよう"],["。"],["ペリシテ"],["の"],["上","うえ"],["で"],["、"],["わたし"],["は"],["大声","おおごえ"],["で"],["叫ぼう","さけぼう"],["。"],["」"]]},{"verse":10,"text":"だれが私を要塞の町に連れて行くでしょう。だれが私をエドムまで導くでしょう。","tok":[["だれ"],["が"],["私","わたくし"],["を"],["要塞","ようさい"],["の"],["町","まち"],["に"],["連れて","つれて"],["行くでしょう","いくでしょう"],["。"],["だれ"],["が"],["私","わたくし"],["を"],["エドム"],["まで"],["導くでしょう","みちびくでしょう"],["。"]]},{"verse":11,"text":"神よ。あなたは私たちを拒まれたのではありませんか。神よ。あなたは、もはや私たちの軍勢とともに、出陣なさらないのですか。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["は"],["私たち","わたしたち"],["を"],["拒まれた","こばまれた"],["ので"],["は"],["ありません"],["か"],["。"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["、"],["もはや"],["私たち","わたしたち"],["の"],["軍勢","ぐんぜい"],["と"],["とも"],["に"],["、"],["出陣","しゅつじん"],["なさらない"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"どうか敵から私たちを助けてください。まことに、人の救いはむなしいものです。","tok":[["どう"],["か"],["敵","てき"],["から"],["私たち","わたしたち"],["を"],["助けて","たすけて"],["ください"],["。"],["まこと"],["に"],["、"],["人","ひと"],["の"],["救い","すくい"],["は"],["むなしい"],["もの"],["です"],["。"]]},{"verse":13,"text":"神によって、私たちは力ある働きをします。神が私たちの敵を踏みつけられます。","tok":[["神","かみ"],["によって"],["、"],["私たち","わたしたち"],["は"],["力","ちから"],["ある"],["働き","はたらき"],["を"],["します"],["。"],["神","かみ"],["が"],["私たち","わたしたち"],["の"],["敵","てき"],["を"],["踏みつけられます","ふみつけられます"],["。"]]}]
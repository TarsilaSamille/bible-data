[{"verse":1,"text":"バビロンの川のほとり、そこで、私たちはすわり、シオンを思い出して泣いた。","tok":[["バビロン"],["の"],["川","かわ"],["の"],["ほとり"],["、"],["そこ"],["で"],["、"],["私たち","わたしたち"],["は"],["すわり"],["、"],["シオン"],["を"],["思い出して","おもいだして"],["泣いた","ないた"],["。"]]},{"verse":2,"text":"その柳の木々に私たちは立琴を掛けた。","tok":[["その"],["柳","やなぎ"],["の"],["木々","きぎ"],["に"],["私たち","わたしたち"],["は"],["立琴","たてごと"],["を"],["掛けた","かけた"],["。"]]},{"verse":3,"text":"それは、私たちを捕らえ移した者たちが、そこで、私たちに歌を求め、私たちを苦しめる者たちが、興を求めて、「シオンの歌を一つ歌え」と言ったからだ。","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["を"],["捕らえ","とらえ"],["移した","うつした"],["者","もの"],["たち"],["が"],["、"],["そこ"],["で"],["、"],["私たち","わたしたち"],["に"],["歌","うた"],["を"],["求め","もとめ"],["、"],["私たち","わたしたち"],["を"],["苦しめる","くるしめる"],["者","もの"],["たち"],["が"],["、"],["興","きょう"],["を"],["求めて","もとめて"],["、"],["「"],["シオン"],["の"],["歌","うた"],["を"],["一","ひと"],["つ"],["歌え","うたえ"],["」"],["と"],["言った","いった"],["から"],["だ"],["。"]]},{"verse":4,"text":"私たちがどうして、異国の地にあって主の歌を歌えようか。","tok":[["私たち","わたしたち"],["が"],["どう"],["して"],["、"],["異国","いこく"],["の"],["地","ち"],["に"],["あって"],["主","ぬし"],["の"],["歌","うた"],["を"],["歌えよう","うたえよう"],["か"],["。"]]},{"verse":5,"text":"エルサレムよ。もしも、私がおまえを忘れたら、私の右手がその巧みさを忘れるように。","tok":[["エルサレム"],["よ"],["。"],["もし"],["も"],["、"],["私","わたくし"],["が"],["おまえ"],["を"],["忘れたら","わすれたら"],["、"],["私","わたくし"],["の"],["右手","みぎて"],["が"],["その"],["巧み","たくみ"],["さ"],["を"],["忘れる","わすれる"],["よう"],["に"],["。"]]},{"verse":6,"text":"もしも、私がおまえを思い出さず、私がエルサレムを最上の喜びにもまさってたたえないなら、私の舌が上あごについてしまうように。","tok":[["もし"],["も"],["、"],["私","わたくし"],["が"],["おまえ"],["を"],["思い出さず","おもいださず"],["、"],["私","わたくし"],["が"],["エルサレム"],["を"],["最上","さいじょう"],["の"],["喜び","よろこび"],["に"],["も"],["まさって"],["たたえないなら"],["、"],["私","わたくし"],["の"],["舌","した"],["が"],["上あご","うわあご"],["について"],["しまう"],["よう"],["に"],["。"]]},{"verse":7,"text":"主よ。エルサレムの日に、「破壊せよ、破壊せよ、その基までも」と言ったエドムの子らを思い出してください。","tok":[["主","ぬし"],["よ"],["。"],["エルサレム"],["の"],["日","ひ"],["に"],["、"],["「"],["破壊","はかい"],["せよ"],["、"],["破壊","はかい"],["せよ"],["、"],["その"],["基","もと"],["まで"],["も"],["」"],["と"],["言った","いった"],["エドム"],["の"],["子","こ"],["ら"],["を"],["思い出して","おもいだして"],["ください"],["。"]]},{"verse":8,"text":"バビロンの娘よ。荒れ果てた者よ。おまえの私たちへの仕打ちを、おまえに仕返しする人は、なんと幸いなことよ。","tok":[["バビロン"],["の"],["娘","むすめ"],["よ"],["。"],["荒れ果てた","あれはてた"],["者","もの"],["よ"],["。"],["おまえ"],["の"],["私たち","わたしたち"],["へ"],["の"],["仕打ち","しうち"],["を"],["、"],["おまえ"],["に"],["仕返し","しかえし"],["する"],["人","ひと"],["は"],["、"],["なん"],["と"],["幸い","さいわい"],["な"],["こと"],["よ"],["。"]]},{"verse":9,"text":"おまえの子どもたちを捕らえ、岩に打ちつける人は、なんと幸いなことよ。","tok":[["おまえ"],["の"],["子ども","こども"],["たち"],["を"],["捕らえ","とらえ"],["、"],["岩","いわ"],["に"],["打ちつける","うちつける"],["人","ひと"],["は"],["、"],["なん"],["と"],["幸い","さいわい"],["な"],["こと"],["よ"],["。"]]}]
[{"verse":1,"text":"（指揮者のために。コラの子たちの賛歌）すべての国々の民よ。これを聞け。世界に住むすべての者よ。耳を傾けよ。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["コラ"],["の"],["子","こ"],["たち"],["の"],["賛歌","さんか"],["）"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["よ"],["。"],["これ"],["を"],["聞け","きけ"],["。"],["世界","せかい"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["よ"],["。"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"]]},{"verse":2,"text":"低い者も、尊い者も、富む者も、貧しい者も、ともどもに。","tok":[["低い","ひくい"],["者","もの"],["も"],["、"],["尊い","とうとい"],["者","もの"],["も"],["、"],["富む","とむ"],["者","もの"],["も"],["、"],["貧しい","まずしい"],["者","もの"],["も"],["、"],["ともども"],["に"],["。"]]},{"verse":3,"text":"私の口は知恵を語り、私の心は英知を告げる。","tok":[["私","わたくし"],["の"],["口","くち"],["は"],["知恵","ちえ"],["を"],["語り","かたり"],["、"],["私","わたくし"],["の"],["心","こころ"],["は"],["英知","えいち"],["を"],["告げる","つげる"],["。"]]},{"verse":4,"text":"私はたとえに耳を傾け、立琴に合わせて私のなぞを解き明かそう。","tok":[["私","わたくし"],["は"],["たとえ"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["立琴","たてごと"],["に"],["合わせて","あわせて"],["私","わたくし"],["の"],["なぞ"],["を"],["解き明かそう","ときあかそう"],["。"]]},{"verse":5,"text":"どうして私は、わざわいの日に、恐れなければならないのか。私を取り囲んで中傷する者の悪意を。","tok":[["どう"],["して"],["私","わたくし"],["は"],["、"],["わざわい"],["の"],["日","ひ"],["に"],["、"],["恐れなければ","おそれなければ"],["ならない"],["の"],["か"],["。"],["私","わたくし"],["を"],["取り囲んで","とりかこんで"],["中傷","ちゅうしょう"],["する"],["者","もの"],["の"],["悪意","あくい"],["を"],["。"]]},{"verse":6,"text":"おのれの財産に信頼する者どもや、豊かな富を誇る者どもを。","tok":[["おのれ"],["の"],["財産","ざいさん"],["に"],["信頼","しんらい"],["する"],["者","もの"],["ども"],["や"],["、"],["豊か","ゆたか"],["な"],["富","とみ"],["を"],["誇る","ほこる"],["者","もの"],["ども"],["を"],["。"]]},{"verse":7,"text":"人は自分の兄弟をも買い戻すことはできない。自分の身代金を神に払うことはできない。","tok":[["人","ひと"],["は"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["も"],["買い戻す","かいもどす"],["こと"],["は"],["できない"],["。"],["自分","じぶん"],["の"],["身代金","みのしろきん"],["を"],["神","かみ"],["に"],["払う","はらう"],["こと"],["は"],["できない"],["。"]]},{"verse":8,"text":"――たましいの贖いしろは、高価であり、永久にあきらめなくてはならない――","tok":[["―"],["―"],["たましい"],["の"],["贖い","あがない"],["しろ"],["は"],["、"],["高価","こうか"],["で"],["あり"],["、"],["永久","えいきゅう"],["に"],["あきらめなくて"],["は"],["ならない"],["―"],["―"]]},{"verse":9,"text":"人はとこしえまでも生きながらえるであろうか。墓を見ないであろうか。","tok":[["人","ひと"],["は"],["とこしえ"],["まで"],["も"],["生きながらえるで","いきながらえるで"],["あろう"],["か"],["。"],["墓","はか"],["を"],["見ないで","みないで"],["あろう"],["か"],["。"]]},{"verse":10,"text":"彼は見る。知恵のある者たちが死に、愚か者もまぬけ者もひとしく滅び、自分の財産を他人に残すのを。","tok":[["彼","かれ"],["は"],["見る","みる"],["。"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["たち"],["が"],["死に","しに"],["、"],["愚か者","おろかもの"],["も"],["まぬけ者","まぬけしゃ"],["も"],["ひとしく"],["滅び","ほろび"],["、"],["自分","じぶん"],["の"],["財産","ざいさん"],["を"],["他人","たにん"],["に"],["残す","のこす"],["の"],["を"],["。"]]},{"verse":11,"text":"彼らは、心の中で、彼らの家は永遠に続き、その住まいは代々にまで及ぶと思い、自分たちの土地に、自分たちの名をつける。","tok":[["彼","かれ"],["ら"],["は"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["彼","かれ"],["ら"],["の"],["家","いえ"],["は"],["永遠","えいえん"],["に"],["続き","つづき"],["、"],["その"],["住まい","すまい"],["は"],["代々","だいだい"],["に"],["まで"],["及ぶ","およぶ"],["と"],["思い","おもい"],["、"],["自分","じぶん"],["たち"],["の"],["土地","とち"],["に"],["、"],["自分","じぶん"],["たち"],["の"],["名","な"],["を"],["つける"],["。"]]},{"verse":12,"text":"しかし人は、その栄華のうちにとどまれない。人は滅びうせる獣に等しい。","tok":[["しかし"],["人","ひと"],["は"],["、"],["その"],["栄華","えいが"],["の"],["うち"],["に"],["とどまれない"],["。"],["人","ひと"],["は"],["滅び","ほろび"],["うせる"],["獣","けもの"],["に"],["等しい","ひとしい"],["。"]]},{"verse":13,"text":"これが愚か者どもの道、彼らに従い、彼らの言うことを受け入れる者どもの道である。セラ","tok":[["これ"],["が"],["愚か者","おろかもの"],["ども"],["の"],["道","みち"],["、"],["彼","かれ"],["ら"],["に"],["従い","したがい"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["受け入れる","うけいれる"],["者","もの"],["ども"],["の"],["道","みち"],["で"],["ある"],["。"],["セラ"]]},{"verse":14,"text":"彼らは羊のようによみに定められ、死が彼らの羊飼いとなる。朝は、直ぐな者が彼らを支配する。彼らのかたちはなくなり、よみがその住む所となる。","tok":[["彼","かれ"],["ら"],["は"],["羊","ひつじ"],["の"],["よう"],["に"],["よみ"],["に"],["定められ","さだめられ"],["、"],["死","し"],["が"],["彼","かれ"],["ら"],["の"],["羊飼い","ひつじかい"],["と"],["なる"],["。"],["朝","あさ"],["は"],["、"],["直ぐ","すぐ"],["な"],["者","もの"],["が"],["彼","かれ"],["ら"],["を"],["支配","しはい"],["する"],["。"],["彼","かれ"],["ら"],["の"],["かたち"],["は"],["なくなり"],["、"],["よみ"],["が"],["その"],["住む","すむ"],["所","ところ"],["と"],["なる"],["。"]]},{"verse":15,"text":"しかし神は私のたましいをよみの手から買い戻される。神が私を受け入れてくださるからだ。セラ","tok":[["しかし"],["神","かみ"],["は"],["私","わたくし"],["の"],["たましい"],["を"],["よみ"],["の"],["手","て"],["から"],["買い戻される","かいもどされる"],["。"],["神","かみ"],["が"],["私","わたくし"],["を"],["受け入れて","うけいれて"],["くださる"],["から"],["だ"],["。"],["セラ"]]},{"verse":16,"text":"恐れるな。人が富を得ても、その人の家の栄誉が増し加わっても。","tok":[["恐れる","おそれる"],["な"],["。"],["人","ひと"],["が"],["富","とみ"],["を"],["得て","えて"],["も"],["、"],["その"],["人","ひと"],["の"],["家","いえ"],["の"],["栄誉","えいよ"],["が"],["増し","まし"],["加わって","くわわって"],["も"],["。"]]},{"verse":17,"text":"人は、死ぬとき、何一つ持って行くことができず、その栄誉も彼に従って下っては行かないのだ。","tok":[["人","ひと"],["は"],["、"],["死ぬ","しぬ"],["とき"],["、"],["何","なん"],["一","ひと"],["つ"],["持って","もって"],["行く","いく"],["こと"],["が"],["できず"],["、"],["その"],["栄誉","えいよ"],["も"],["彼","かれ"],["に"],["従って","したがって"],["下って","くだって"],["は"],["行かない","いかない"],["の"],["だ"],["。"]]},{"verse":18,"text":"彼が生きている間、自分を祝福できても、また、あなたが幸いな暮らしをしているために、人々があなたをほめたたえても。","tok":[["彼","かれ"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["自分","じぶん"],["を"],["祝福","しゅくふく"],["できて"],["も"],["、"],["また"],["、"],["あなた"],["が"],["幸い","さいわい"],["な"],["暮らし","くらし"],["を"],["して"],["いる"],["ため"],["に"],["、"],["人々","ひとびと"],["が"],["あなた"],["を"],["ほめたたえて"],["も"],["。"]]},{"verse":19,"text":"あなたは、自分の先祖の世代に行き、彼らは決して光を見ないであろう。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["先祖","せんぞ"],["の"],["世代","せだい"],["に"],["行き","いき"],["、"],["彼","かれ"],["ら"],["は"],["決して","けっして"],["光","ひかり"],["を"],["見ないで","みないで"],["あろう"],["。"]]},{"verse":20,"text":"人はその栄華の中にあっても、悟りがなければ、滅びうせる獣に等しい。","tok":[["人","ひと"],["は"],["その"],["栄華","えいが"],["の"],["中","なか"],["に"],["あって"],["も"],["、"],["悟り","さとり"],["が"],["なければ"],["、"],["滅び","ほろび"],["うせる"],["獣","けもの"],["に"],["等しい","ひとしい"],["。"]]}]
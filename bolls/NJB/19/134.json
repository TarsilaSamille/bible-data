[{"verse":1,"text":"（都上りの歌）さあ、主をほめたたえよ。主のすべてのしもべたち、夜ごとに主の家で仕える者たちよ。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["さあ"],["、"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["主","ぬし"],["の"],["すべて"],["の"],["しもべ"],["たち"],["、"],["夜","よる"],["ごと"],["に"],["主","ぬし"],["の"],["家","いえ"],["で"],["仕える","つかえる"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":2,"text":"聖所に向かってあなたがたの手を上げ、主をほめたたえよ。","tok":[["聖","せい"],["所","しょ"],["に"],["向かって","むかって"],["あなた"],["がた"],["の"],["手","て"],["を"],["上げ","あげ"],["、"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":3,"text":"天地を造られた主がシオンからあなたを祝福されるように。","tok":[["天地","てんち"],["を"],["造られた","つくられた"],["主","ぬし"],["が"],["シオン"],["から"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["よう"],["に"],["。"]]}]
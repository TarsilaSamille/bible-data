[{"verse":1,"text":"（都上りの歌）主よ。ダビデのために、彼のすべての苦しみを思い出してください。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["主","ぬし"],["よ"],["。"],["ダビデ"],["の"],["ため"],["に"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["苦しみ","くるしみ"],["を"],["思い出して","おもいだして"],["ください"],["。"]]},{"verse":2,"text":"彼は主に誓い、ヤコブの全能者に誓いを立てました。","tok":[["彼","かれ"],["は"],["主に","おもに"],["誓い","ちかい"],["、"],["ヤコブ"],["の"],["全能者","ぜんのうしゃ"],["に"],["誓い","ちかい"],["を"],["立てました","たてました"],["。"]]},{"verse":3,"text":"「私は決して、わが家の天幕に入りません。私のために備えられた寝床にも上がりません。","tok":[["「"],["私","わたくし"],["は"],["決して","けっして"],["、"],["わが家","わがや"],["の"],["天幕","てんまく"],["に"],["入りません","はいりません"],["。"],["私","わたくし"],["の"],["ため"],["に"],["備えられた","そなえられた"],["寝床","ねどこ"],["に"],["も"],["上がりません","あがりません"],["。"]]},{"verse":4,"text":"私の目に眠りを与えません。私のまぶたにまどろみをも。","tok":[["私","わたくし"],["の"],["目","め"],["に"],["眠り","ねむり"],["を"],["与えません","あたえません"],["。"],["私","わたくし"],["の"],["まぶた"],["に"],["まどろみ"],["を"],["も"],["。"]]},{"verse":5,"text":"私が主のために、一つの場所を見いだし、ヤコブの全能者のために、御住まいを見いだすまでは。」","tok":[["私","わたくし"],["が"],["主","ぬし"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["の"],["場所","ばしょ"],["を"],["見いだし","みいだし"],["、"],["ヤコブ"],["の"],["全能者","ぜんのうしゃ"],["の"],["ため"],["に"],["、"],["御住まい","おすまい"],["を"],["見いだす","みいだす"],["まで"],["は"],["。"],["」"]]},{"verse":6,"text":"今や、私たちはエフラテでそれを聞き、ヤアルの野で、それを見いだした。","tok":[["今","いま"],["や"],["、"],["私たち","わたしたち"],["は"],["エフラテ"],["で"],["それ"],["を"],["聞き","きき"],["、"],["ヤアル"],["の"],["野","の"],["で"],["、"],["それ"],["を"],["見いだした","みいだした"],["。"]]},{"verse":7,"text":"さあ、主の住まいに行き、主の足台のもとにひれ伏そう。","tok":[["さあ"],["、"],["主","ぬし"],["の"],["住まい","すまい"],["に"],["行き","いき"],["、"],["主","ぬし"],["の"],["足台","あしだい"],["の"],["もと"],["に"],["ひれ伏そう","ひれふそう"],["。"]]},{"verse":8,"text":"主よ。立ち上がってください。あなたの安息の場所に、お入りください。あなたと、あなたの御力の箱も。","tok":[["主","ぬし"],["よ"],["。"],["立ち上がって","たちあがって"],["ください"],["。"],["あなた"],["の"],["安息","あんそく"],["の"],["場所","ばしょ"],["に"],["、"],["お入り","おはいり"],["ください"],["。"],["あなた"],["と"],["、"],["あなた"],["の"],["御力","おちから"],["の"],["箱","ばこ"],["も"],["。"]]},{"verse":9,"text":"あなたの祭司たちは、義を身にまとい、あなたの聖徒たちは、喜び歌いますように。","tok":[["あなた"],["の"],["祭司","さいし"],["たち"],["は"],["、"],["義","ぎ"],["を"],["身","み"],["に"],["まとい"],["、"],["あなた"],["の"],["聖徒","せいと"],["たち"],["は"],["、"],["喜び歌います","よろこびうたいます"],["よう"],["に"],["。"]]},{"verse":10,"text":"あなたのしもべダビデのために、あなたに油そそがれた者の顔を、うしろへ向けないでください。","tok":[["あなた"],["の"],["しもべ"],["ダビデ"],["の"],["ため"],["に"],["、"],["あなた"],["に"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["顔","かお"],["を"],["、"],["うしろ"],["へ"],["向けないで","むけないで"],["ください"],["。"]]},{"verse":11,"text":"主はダビデに誓われた。それは、主が取り消すことのない真理である。「あなたの身から出る子をあなたの位に着かせよう。","tok":[["主","ぬし"],["は"],["ダビデ"],["に"],["誓われた","ちかわれた"],["。"],["それ"],["は"],["、"],["主","ぬし"],["が"],["取り消す","とりけす"],["こと"],["の"],["ない"],["真理","しんり"],["で"],["ある"],["。"],["「"],["あなた"],["の"],["身","み"],["から"],["出る","でる"],["子","こ"],["を"],["あなた"],["の"],["位","くらい"],["に"],["着かせよう","つかせよう"],["。"]]},{"verse":12,"text":"もし、あなたの子らが、わたしの契約と、わたしの教えるさとしを守るなら、彼らの子らもまた、とこしえにあなたの位に着くであろう。」","tok":[["もし"],["、"],["あなた"],["の"],["子","こ"],["ら"],["が"],["、"],["わたし"],["の"],["契約","けいやく"],["と"],["、"],["わたし"],["の"],["教える","おしえる"],["さとし"],["を"],["守るなら","まもるなら"],["、"],["彼","かれ"],["ら"],["の"],["子","こ"],["ら"],["も"],["また"],["、"],["とこしえ"],["に"],["あなた"],["の"],["位","くらい"],["に"],["着くで","つくで"],["あろう"],["。"],["」"]]},{"verse":13,"text":"主はシオンを選び、それをご自分の住みかとして望まれた。","tok":[["主","ぬし"],["は"],["シオン"],["を"],["選び","えらび"],["、"],["それ"],["を"],["ご自分","ごじぶん"],["の"],["住みか","すみか"],["として"],["望まれた","のぞまれた"],["。"]]},{"verse":14,"text":"「これはとこしえに、わたしの安息の場所、ここにわたしは住もう。わたしがそれを望んだから。","tok":[["「"],["これ"],["は"],["とこしえ"],["に"],["、"],["わたし"],["の"],["安息","あんそく"],["の"],["場所","ばしょ"],["、"],["ここ"],["に"],["わたし"],["は"],["住もう","すもう"],["。"],["わたし"],["が"],["それ"],["を"],["望んだ","のぞんだ"],["から"],["。"]]},{"verse":15,"text":"わたしは豊かにシオンの食物を祝福し、その貧しい者をパンで満ち足らせよう。","tok":[["わたし"],["は"],["豊か","ゆたか"],["に"],["シオン"],["の"],["食物","しょくもつ"],["を"],["祝福","しゅくふく"],["し"],["、"],["その"],["貧しい","まずしい"],["者","もの"],["を"],["パン"],["で"],["満ち","みち"],["足らせよう","たらせよう"],["。"]]},{"verse":16,"text":"その祭司らに救いを着せよう。その聖徒らは大いに喜び歌おう。","tok":[["その"],["祭司","さいし"],["ら"],["に"],["救い","すくい"],["を"],["着せよう","きせよう"],["。"],["その"],["聖徒","せいと"],["ら"],["は"],["大いに","おおいに"],["喜び歌おう","よろこびうたおう"],["。"]]},{"verse":17,"text":"そこにわたしはダビデのために、一つの角を生えさせよう。わたしは、わたしに油そそがれた者のために、一つのともしびを備えている。","tok":[["そこ"],["に"],["わたし"],["は"],["ダビデ"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["の"],["角","かど"],["を"],["生えさせよう","はえさせよう"],["。"],["わたし"],["は"],["、"],["わたし"],["に"],["油","あぶら"],["そそがれた"],["者","もの"],["の"],["ため"],["に"],["、"],["一","ひと"],["つ"],["の"],["ともしび"],["を"],["備えて","そなえて"],["いる"],["。"]]},{"verse":18,"text":"わたしは彼の敵に恥を着せる。しかし、彼の上には、彼の冠が光り輝くであろう。」","tok":[["わたし"],["は"],["彼","かれ"],["の"],["敵","てき"],["に"],["恥","はじ"],["を"],["着せる","きせる"],["。"],["しかし"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["は"],["、"],["彼","かれ"],["の"],["冠","かんむり"],["が"],["光り輝くで","ひかりかがやくで"],["あろう"],["。"],["」"]]}]
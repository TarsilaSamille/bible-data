[{"verse":1,"text":"（ダビデの賛歌）地とそれに満ちているもの、世界とその中に住むものは主のものである。","tok":[["（"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["地","ち"],["と"],["それ"],["に"],["満ちて","みちて"],["いる"],["もの"],["、"],["世界","せかい"],["と"],["その"],["中","なか"],["に"],["住む","すむ"],["もの"],["は"],["主","ぬし"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"まことに主は、海に地の基を据え、また、もろもろの川の上に、それを築き上げられた。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["、"],["海","うみ"],["に"],["地","ち"],["の"],["基","もと"],["を"],["据え","すえ"],["、"],["また"],["、"],["もろもろ"],["の"],["川","かわ"],["の"],["上","うえ"],["に"],["、"],["それ"],["を"],["築き上げられた","きずきあげられた"],["。"]]},{"verse":3,"text":"だれが、主の山に登りえようか。だれが、その聖なる所に立ちえようか。","tok":[["だれ"],["が"],["、"],["主","ぬし"],["の"],["山","やま"],["に"],["登り","のぼり"],["えよう"],["か"],["。"],["だれ"],["が"],["、"],["その"],["聖","せい"],["なる"],["所","ところ"],["に"],["立ち","たち"],["えよう"],["か"],["。"]]},{"verse":4,"text":"手がきよく、心がきよらかな者、そのたましいをむなしいことに向けず、欺き誓わなかった人。","tok":[["手がき","てがき"],["よく"],["、"],["心","こころ"],["が"],["きよらか"],["な"],["者","もの"],["、"],["その"],["たましい"],["を"],["むなしい"],["こと"],["に"],["向けず","むけず"],["、"],["欺き","あざむき"],["誓わなかった","ちかわなかった"],["人","ひと"],["。"]]},{"verse":5,"text":"その人は主から祝福を受け、その救いの神から義を受ける。","tok":[["その"],["人","ひと"],["は"],["主","ぬし"],["から"],["祝福","しゅくふく"],["を"],["受け","うけ"],["、"],["その"],["救い","すくい"],["の"],["神","かみ"],["から"],["義","ぎ"],["を"],["受ける","うける"],["。"]]},{"verse":6,"text":"これこそ、神を求める者の一族、あなたの御顔を慕い求める人々、ヤコブである。セラ","tok":[["これ"],["こそ"],["、"],["神","かみ"],["を"],["求める","もとめる"],["者","もの"],["の"],["一族","いちぞく"],["、"],["あなた"],["の"],["御顔","おかお"],["を"],["慕い求める","したいもとめる"],["人々","ひとびと"],["、"],["ヤコブ"],["で"],["ある"],["。"],["セラ"]]},{"verse":7,"text":"門よ。おまえたちのかしらを上げよ。永遠の戸よ。上がれ。栄光の王が入って来られる。","tok":[["門","もん"],["よ"],["。"],["おまえ"],["たち"],["の"],["かしら"],["を"],["上げ","あげ"],["よ"],["。"],["永遠","えいえん"],["の"],["戸","と"],["よ"],["。"],["上がれ","あがれ"],["。"],["栄光","えいこう"],["の"],["王","おう"],["が"],["入って","はいって"],["来られる","こられる"],["。"]]},{"verse":8,"text":"栄光の王とは、だれか。強く、力ある主。戦いに力ある主。","tok":[["栄光","えいこう"],["の"],["王","おう"],["と"],["は"],["、"],["だれ"],["か"],["。"],["強く","つよく"],["、"],["力","ちから"],["ある"],["主","ぬし"],["。"],["戦い","たたかい"],["に"],["力","ちから"],["ある"],["主","ぬし"],["。"]]},{"verse":9,"text":"門よ。おまえたちのかしらを上げよ。永遠の戸よ。上がれ。栄光の王が入って来られる。","tok":[["門","もん"],["よ"],["。"],["おまえ"],["たち"],["の"],["かしら"],["を"],["上げ","あげ"],["よ"],["。"],["永遠","えいえん"],["の"],["戸","と"],["よ"],["。"],["上がれ","あがれ"],["。"],["栄光","えいこう"],["の"],["王","おう"],["が"],["入って","はいって"],["来られる","こられる"],["。"]]},{"verse":10,"text":"その栄光の王とはだれか。万軍の主。これぞ、栄光の王。セラ","tok":[["その"],["栄光","えいこう"],["の"],["王","おう"],["と"],["は"],["だれ"],["か"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["。"],["これ"],["ぞ"],["、"],["栄光","えいこう"],["の"],["王","おう"],["。"],["セラ"]]}]
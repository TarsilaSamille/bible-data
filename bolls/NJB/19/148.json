[{"verse":1,"text":"ハレルヤ。天において主をほめたたえよ。いと高き所で主をほめたたえよ。","tok":[["ハレルヤ"],["。"],["天","てん"],["に"],["おいて"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["いと"],["高き","たかき"],["所","ところ"],["で"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"主をほめたたえよ。すべての御使いよ。主をほめたたえよ。主の万軍よ。","tok":[["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["すべて"],["の"],["御使い","おつかい"],["よ"],["。"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["主","ぬし"],["の"],["万","まん"],["軍","ぐん"],["よ"],["。"]]},{"verse":3,"text":"主をほめたたえよ。日よ。月よ。主をほめたたえよ。すべての輝く星よ。","tok":[["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["日","ひ"],["よ"],["。"],["月","つき"],["よ"],["。"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["すべて"],["の"],["輝く","かがやく"],["星","ほし"],["よ"],["。"]]},{"verse":4,"text":"主をほめたたえよ。天の天よ。天の上にある水よ。","tok":[["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["天","てん"],["の"],["天","てん"],["よ"],["。"],["天","てん"],["の"],["上","うえ"],["に"],["ある"],["水","みず"],["よ"],["。"]]},{"verse":5,"text":"彼らに主の名をほめたたえさせよ。主が命じて、彼らが造られた。","tok":[["彼","かれ"],["ら"],["に"],["主","ぬし"],["の"],["名","な"],["を"],["ほめたたえさせ"],["よ"],["。"],["主","ぬし"],["が"],["命じて","めいじて"],["、"],["彼","かれ"],["ら"],["が"],["造られた","つくられた"],["。"]]},{"verse":6,"text":"主は彼らを、世々限りなく立てられた。主は過ぎ去ることのない定めを置かれた。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["立てられた","たてられた"],["。"],["主","ぬし"],["は"],["過ぎ去る","すぎさる"],["こと"],["の"],["ない"],["定め","さだめ"],["を"],["置かれた","おかれた"],["。"]]},{"verse":7,"text":"地において主をほめたたえよ。海の巨獣よ。すべての淵よ。","tok":[["地","ち"],["に"],["おいて"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["海","うみ"],["の"],["巨獣","きょじゅう"],["よ"],["。"],["すべて"],["の"],["淵","ふち"],["よ"],["。"]]},{"verse":8,"text":"火よ。雹よ。雪よ。煙よ。みことばを行うあらしよ。","tok":[["火","ひ"],["よ"],["。"],["雹","ひょう"],["よ"],["。"],["雪","ゆき"],["よ"],["。"],["煙","けむり"],["よ"],["。"],["みことば"],["を"],["行う","おこなう"],["あらし"],["よ"],["。"]]},{"verse":9,"text":"山々よ。すべての丘よ。実のなる木よ。すべての杉よ。","tok":[["山々","やまやま"],["よ"],["。"],["すべて"],["の"],["丘","おか"],["よ"],["。"],["実","じつ"],["の"],["なる"],["木","き"],["よ"],["。"],["すべて"],["の"],["杉","すぎ"],["よ"],["。"]]},{"verse":10,"text":"獣よ。すべての家畜よ。はうものよ。翼のある鳥よ。","tok":[["獣","けもの"],["よ"],["。"],["すべて"],["の"],["家畜","かちく"],["よ"],["。"],["は"],["う"],["もの"],["よ"],["。"],["翼","つばさ"],["の"],["ある"],["鳥","とり"],["よ"],["。"]]},{"verse":11,"text":"地の王たちよ。すべての国民よ。君主たちよ。地のすべてのさばきづかさよ。","tok":[["地","ち"],["の"],["王","おう"],["たち"],["よ"],["。"],["すべて"],["の"],["国民","こくみん"],["よ"],["。"],["君主","くんしゅ"],["たち"],["よ"],["。"],["地","ち"],["の"],["すべて"],["の"],["さばき"],["づかさ"],["よ"],["。"]]},{"verse":12,"text":"若い男よ。若い女よ。年老いた者と幼い者よ。","tok":[["若い","わかい"],["男","おとこ"],["よ"],["。"],["若い","わかい"],["女","おんな"],["よ"],["。"],["年老いた","としおいた"],["者","もの"],["と"],["幼い","おさない"],["者","もの"],["よ"],["。"]]},{"verse":13,"text":"彼らに主の名をほめたたえさせよ。主の御名だけがあがめられ、その威光は地と天の上にあるからだ。","tok":[["彼","かれ"],["ら"],["に"],["主","ぬし"],["の"],["名","な"],["を"],["ほめたたえさせ"],["よ"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["だけ"],["が"],["あがめられ"],["、"],["その"],["威光","いこう"],["は"],["地","ち"],["と"],["天","てん"],["の"],["上","うえ"],["に"],["ある"],["から"],["だ"],["。"]]},{"verse":14,"text":"主は、その民の角を上げられた。主のすべての聖徒たち、主の近くにいる民、イスラエルの子らの賛美を。ハレルヤ。","tok":[["主","ぬし"],["は"],["、"],["その"],["民","たみ"],["の"],["角","かど"],["を"],["上げられた","あげられた"],["。"],["主","ぬし"],["の"],["すべて"],["の"],["聖徒","せいと"],["たち"],["、"],["主","ぬし"],["の"],["近く","ちかく"],["に"],["いる"],["民","たみ"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["賛美","さんび"],["を"],["。"],["ハレルヤ"],["。"]]}]
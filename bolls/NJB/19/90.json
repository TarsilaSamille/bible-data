[{"verse":1,"text":"（神の人モーセの祈り）主よ。あなたは代々にわたって私たちの住まいです。","tok":[["（"],["神","かみ"],["の"],["人","ひと"],["モーセ"],["の"],["祈り","いのり"],["）"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["代々","だいだい"],["に"],["わたって"],["私たち","わたしたち"],["の"],["住まい","すまい"],["です"],["。"]]},{"verse":2,"text":"山々が生まれる前から、あなたが地と世界とを生み出す前から、まことに、とこしえからとこしえまであなたは神です。","tok":[["山々","やまやま"],["が"],["生まれる","うまれる"],["前","まえ"],["から"],["、"],["あなた"],["が"],["地","ち"],["と"],["世界","せかい"],["と"],["を"],["生み出す","うみだす"],["前","まえ"],["から"],["、"],["まこと"],["に"],["、"],["とこしえ"],["から"],["とこしえ"],["まで"],["あなた"],["は"],["神","かみ"],["です"],["。"]]},{"verse":3,"text":"あなたは人をちりに帰らせて言われます。「人の子らよ、帰れ。」","tok":[["あなた"],["は"],["人","ひと"],["を"],["ちり"],["に"],["帰らせて","かえらせて"],["言われます","いわれます"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["ら"],["よ"],["、"],["帰れ","かえれ"],["。"],["」"]]},{"verse":4,"text":"まことに、あなたの目には、千年も、きのうのように過ぎ去り、夜回りのひとときのようです。","tok":[["まこと"],["に"],["、"],["あなた"],["の"],["目","め"],["に"],["は"],["、"],["千","せん"],["年","ねん"],["も"],["、"],["きのう"],["の"],["よう"],["に"],["過ぎ去り","すぎさり"],["、"],["夜回り","よまわり"],["の"],["ひととき"],["の"],["よう"],["です"],["。"]]},{"verse":5,"text":"あなたが人を押し流すと、彼らは、眠りにおちます。朝、彼らは移ろう草のようです。","tok":[["あなた"],["が"],["人","ひと"],["を"],["押し流す","おしながす"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["眠り","ねむり"],["に"],["おちます"],["。"],["朝","あさ"],["、"],["彼","かれ"],["ら"],["は"],["移ろう","うつろう"],["草","くさ"],["の"],["よう"],["です"],["。"]]},{"verse":6,"text":"朝は、花を咲かせているが、また移ろい、夕べには、しおれて枯れます。","tok":[["朝","あさ"],["は"],["、"],["花","はな"],["を"],["咲かせて","さかせて"],["いる"],["が"],["、"],["また"],["移ろい","うつろい"],["、"],["夕べ","ゆうべ"],["に"],["は"],["、"],["しおれて"],["枯れます","かれます"],["。"]]},{"verse":7,"text":"まことに、私たちはあなたの御怒りによって消えうせ、あなたの激しい憤りにおじ惑います。","tok":[["まこと"],["に"],["、"],["私たち","わたしたち"],["は"],["あなた"],["の"],["御怒り","おいかり"],["によって"],["消えうせ","きえうせ"],["、"],["あなた"],["の"],["激しい","はげしい"],["憤り","いきどおり"],["に"],["おじ"],["惑います","まどいます"],["。"]]},{"verse":8,"text":"あなたは私たちの不義を御前に、私たちの秘めごとを御顔の光の中に置かれます。","tok":[["あなた"],["は"],["私たち","わたしたち"],["の"],["不義","ふぎ"],["を"],["御前","ごぜん"],["に"],["、"],["私たち","わたしたち"],["の"],["秘めごと","ひめごと"],["を"],["御顔","おかお"],["の"],["光","ひかり"],["の"],["中","なか"],["に"],["置かれます","おかれます"],["。"]]},{"verse":9,"text":"まことに、私たちのすべての日はあなたの激しい怒りの中に沈み行き、私たちは自分の齢をひと息のように終わらせます。","tok":[["まこと"],["に"],["、"],["私たち","わたしたち"],["の"],["すべて"],["の"],["日","ひ"],["は"],["あなた"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["中","なか"],["に"],["沈み","しずみ"],["行き","いき"],["、"],["私たち","わたしたち"],["は"],["自分","じぶん"],["の"],["齢","とし"],["を"],["ひと息","ひといき"],["の"],["よう"],["に"],["終わらせます","おわらせます"],["。"]]},{"verse":10,"text":"私たちの齢は七十年。健やかであっても八十年。しかも、その誇りとするところは労苦とわざわいです。それは早く過ぎ去り、私たちも飛び去るのです。","tok":[["私たち","わたしたち"],["の"],["齢","とし"],["は"],["七十","ななじゅう"],["年","ねん"],["。"],["健やか","すこやか"],["で"],["あって"],["も"],["八十","はちじゅう"],["年","ねん"],["。"],["しかも"],["、"],["その"],["誇り","ほこり"],["と"],["する"],["ところ"],["は"],["労苦","ろうく"],["と"],["わざわい"],["です"],["。"],["それ"],["は"],["早く","はやく"],["過ぎ去り","すぎさり"],["、"],["私たち","わたしたち"],["も"],["飛び去る","とびさる"],["の"],["です"],["。"]]},{"verse":11,"text":"だれが御怒りの力を知っているでしょう。だれがあなたの激しい怒りを知っているでしょう。その恐れにふさわしく。","tok":[["だれ"],["が"],["御怒り","おいかり"],["の"],["力","ちから"],["を"],["知って","しって"],["いるでしょう"],["。"],["だれ"],["が"],["あなた"],["の"],["激しい","はげしい"],["怒り","いかり"],["を"],["知って","しって"],["いるでしょう"],["。"],["その"],["恐れ","おそれ"],["に"],["ふさわしく"],["。"]]},{"verse":12,"text":"それゆえ、私たちに自分の日を正しく数えることを教えてください。そうして私たちに知恵の心を得させてください。","tok":[["それ"],["ゆえ"],["、"],["私たち","わたしたち"],["に"],["自分","じぶん"],["の"],["日","ひ"],["を"],["正しく","まさしく"],["数える","かぞえる"],["こと"],["を"],["教えて","おしえて"],["ください"],["。"],["そう"],["して"],["私たち","わたしたち"],["に"],["知恵","ちえ"],["の"],["心","こころ"],["を"],["得させて","えさせて"],["ください"],["。"]]},{"verse":13,"text":"帰って来てください。主よ。いつまでこのようなのですか。あなたのしもべらを、あわれんでください。","tok":[["帰って","かえって"],["来て","きて"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["いつ"],["まで"],["この"],["よう"],["な"],["の"],["です"],["か"],["。"],["あなた"],["の"],["しもべ"],["ら"],["を"],["、"],["あわれんで"],["ください"],["。"]]},{"verse":14,"text":"どうか、朝には、あなたの恵みで私たちを満ち足らせ、私たちのすべての日に、喜び歌い、楽しむようにしてください。","tok":[["どう"],["か"],["、"],["朝","あさ"],["に"],["は"],["、"],["あなた"],["の"],["恵み","めぐみ"],["で"],["私たち","わ
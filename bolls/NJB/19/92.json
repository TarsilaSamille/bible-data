[{"verse":1,"text":"（賛歌。安息日のための歌）主に感謝するのは、良いことです。いと高き方よ。あなたの御名にほめ歌を歌うことは。","tok":[["（"],["賛歌","さんか"],["。"],["安息日","あんそくび"],["の"],["ため"],["の"],["歌","うた"],["）"],["主に","おもに"],["感謝","かんしゃ"],["する"],["の"],["は"],["、"],["良い","よい"],["こと"],["です"],["。"],["いと"],["高き","たかき"],["方","かた"],["よ"],["。"],["あなた"],["の"],["御名","ぎょめい"],["に"],["ほめ歌","ほめうた"],["を"],["歌う","うたう"],["こと"],["は"],["。"]]},{"verse":2,"text":"朝に、あなたの恵みを、夜ごとに、あなたの真実を言い表すことは。","tok":[["朝","あさ"],["に"],["、"],["あなた"],["の"],["恵み","めぐみ"],["を"],["、"],["夜","よる"],["ごと"],["に"],["、"],["あなた"],["の"],["真実","しんじつ"],["を"],["言い表す","いいあらわす"],["こと"],["は"],["。"]]},{"verse":3,"text":"十弦の琴や六弦の琴、それに立琴によるたえなる調べに合わせて。","tok":[["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["や"],["六","ろく"],["弦","げん"],["の"],["琴","こと"],["、"],["それ"],["に"],["立琴","たてごと"],["に"],["よる"],["たえなる"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"]]},{"verse":4,"text":"主よ。あなたは、あなたのなさったことで、私を喜ばせてくださいましたから、私は、あなたの御手のわざを、喜び歌います。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["は"],["、"],["あなた"],["の"],["なさった"],["こと"],["で"],["、"],["私","わたくし"],["を"],["喜ばせて","よろこばせて"],["くださいました"],["から"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["の"],["御手","おて"],["の"],["わざ"],["を"],["、"],["喜び歌います","よろこびうたいます"],["。"]]},{"verse":5,"text":"主よ。あなたのみわざはなんと大きいことでしょう。あなたの御計らいは、いとも深いのです。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["のみ"],["わざ"],["は"],["なん"],["と"],["大きい","おおきい"],["こと"],["でしょう"],["。"],["あなた"],["の"],["御計らい","おはからい"],["は"],["、"],["いとも"],["深い","ふかい"],["の"],["です"],["。"]]},{"verse":6,"text":"まぬけ者は知らず、愚か者にはこれがわかりません。","tok":[["まぬけ者","まぬけしゃ"],["は"],["知らず","しらず"],["、"],["愚か者","おろかもの"],["に"],["は"],["これ"],["が"],["わかりません"],["。"]]},{"verse":7,"text":"悪者どもが青草のようにもえいでようと、不法を行う者どもがみな栄えようと、それは彼らが永遠に滅ぼされるためです。","tok":[["悪者","わるもの"],["ども"],["が"],["青草","あおくさ"],["の"],["よう"],["に"],["も"],["え"],["いでよう"],["と"],["、"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["ども"],["が"],["みな"],["栄えよう","さかえよう"],["と"],["、"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["永遠","えいえん"],["に"],["滅ぼされる","ほろぼされる"],["ため"],["です"],["。"]]},{"verse":8,"text":"しかし主よ。あなたはとこしえに、いと高き所におられます。","tok":[["しかし"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["とこしえ"],["に"],["、"],["いと"],["高き","たかき"],["所","ところ"],["に"],["おられます"],["。"]]},{"verse":9,"text":"おお、主よ。今、あなたの敵が、今、あなたの敵が滅びます。不法を行う者どもがみな、散らされるのです。","tok":[["おお"],["、"],["主","ぬし"],["よ"],["。"],["今","いま"],["、"],["あなた"],["の"],["敵","てき"],["が"],["、"],["今","いま"],["、"],["あなた"],["の"],["敵","てき"],["が"],["滅びます","ほろびます"],["。"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["ども"],["が"],["みな"],["、"],["散らされる","ちらされる"],["の"],["です"],["。"]]},{"verse":10,"text":"しかし、あなたは私の角を野牛の角のように高く上げ、私に新しい油をそそがれました。","tok":[["しかし"],["、"],["あなた"],["は"],["私","わたくし"],["の"],["角","かど"],["を"],["野牛","やぎゅう"],["の"],["角","かど"],["の"],["よう"],["に"],["高く","たかく"],["上げ","あげ"],["、"],["私","わたくし"],["に"],["新しい","あたらしい"],["油","あぶら"],["を"],["そそがれました"],["。"]]},{"verse":11,"text":"私の目は私を待ち伏せている者どもを見下し、私の耳は私に立ち向かう悪人どもの悲鳴を聞きます。","tok":[["私","わたくし"],["の"],["目","め"],["は"],["私","わたくし"],["を"],["待ち伏せて","まちぶせて"],["いる"],["者","もの"],["ども"],["を"],["見下し","みくだし"],["、"],["私","わたくし"],["の"],["耳","みみ"],["は"],["私","わたくし"],["に"],["立ち向かう","たちむかう"],["悪人","あくにん"],["ども"],["の"],["悲鳴","ひめい"],["を"],["聞きます","ききます"],["。"]]},{"verse":12,"text":"正しい者は、なつめやしの木のように栄え、レバノンの杉のように育ちます。","tok":[["正しい","ただしい"],["者","もの"],["は"],["、"],["なつめやし"],["の"],["木","き"],["の"],["よう"],["に"],["栄え","さかえ"],["、"],["レバノン"],["の"],["杉","すぎ"],["の"],["よう"],["に"],["育ちます","そだちます"],["。"]]},{"verse":13,"text":"彼らは、主の家に植えられ、私たちの神の大庭で栄えます。","tok":[["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["の"],["家","いえ"],["に"],["植えられ","うえられ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["大庭","おおば"],["で"],["栄えます","さかえます"],["。"]]},{"verse":14,"text":"彼らは年老いてもなお、実を実らせ、みずみずしく、おい茂っていましょう。","tok":[["彼","かれ"],["ら"],["は"],["年老いて","としおいて"],["も"],["なお"],["、"],["実","じつ"],["を"],["実らせ","みのらせ"],["、"],["みずみずしく"],["、"],["おい茂って","おいしげって"],["いましょう"],["。"]]},{"verse":15,"text":"こうして彼らは、主の正しいことを告げましょう。主は、わが岩。主には不正がありません。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["の"],["正しい","ただしい"],["こと"],["を"],["告げましょう","つげましょう"],["。"],["主","ぬし"],["は"],["、"],["わが"],
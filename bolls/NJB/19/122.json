[{"verse":1,"text":"（都上りの歌。ダビデによる）人々が私に、「さあ、主の家に行こう」と言ったとき、私は喜んだ。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["。"],["ダビデ"],["に"],["よる"],["）"],["人々","ひとびと"],["が"],["私","わたくし"],["に"],["、"],["「"],["さあ"],["、"],["主","ぬし"],["の"],["家","いえ"],["に"],["行こう","いこう"],["」"],["と"],["言った","いった"],["とき"],["、"],["私","わたくし"],["は"],["喜んだ","よろこんだ"],["。"]]},{"verse":2,"text":"エルサレムよ。私たちの足は、おまえの門のうちに立っている。","tok":[["エルサレム"],["よ"],["。"],["私たち","わたしたち"],["の"],["足","あし"],["は"],["、"],["おまえ"],["の"],["門","もん"],["の"],["うち"],["に"],["立って","たって"],["いる"],["。"]]},{"verse":3,"text":"エルサレム、それは、よくまとめられた町として建てられている。","tok":[["エルサレム"],["、"],["それ"],["は"],["、"],["よく"],["まとめられた"],["町","まち"],["として"],["建てられて","たてられて"],["いる"],["。"]]},{"verse":4,"text":"そこに、多くの部族、主の部族が、上って来る。イスラエルのあかしとして、主の御名に感謝するために。","tok":[["そこ"],["に"],["、"],["多く","おおく"],["の"],["部族","ぶぞく"],["、"],["主","ぬし"],["の"],["部族","ぶぞく"],["が"],["、"],["上って","のぼって"],["来る","くる"],["。"],["イスラエル"],["の"],["あかし"],["として"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["する"],["ため"],["に"],["。"]]},{"verse":5,"text":"そこには、さばきの座、ダビデの家の王座があったからだ。","tok":[["そこ"],["に"],["は"],["、"],["さばき"],["の"],["座","ざ"],["、"],["ダビデ"],["の"],["家","いえ"],["の"],["王座","おうざ"],["が"],["あった"],["から"],["だ"],["。"]]},{"verse":6,"text":"エルサレムの平和のために祈れ。「おまえを愛する人々が栄えるように。","tok":[["エルサレム"],["の"],["平和","へいわ"],["の"],["ため"],["に"],["祈れ","いのれ"],["。"],["「"],["おまえ"],["を"],["愛する","あいする"],["人々","ひとびと"],["が"],["栄える","さかえる"],["よう"],["に"],["。"]]},{"verse":7,"text":"おまえの城壁のうちには、平和があるように。おまえの宮殿のうちには、繁栄があるように。」","tok":[["おまえ"],["の"],["城壁","じょうへき"],["の"],["うち"],["に"],["は"],["、"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"],["おまえ"],["の"],["宮殿","きゅうでん"],["の"],["うち"],["に"],["は"],["、"],["繁栄","はんえい"],["が"],["ある"],["よう"],["に"],["。"],["」"]]},{"verse":8,"text":"私の兄弟、私の友人のために、さあ、私は言おう。「おまえのうちに平和があるように。」","tok":[["私","わたくし"],["の"],["兄弟","きょうだい"],["、"],["私","わたくし"],["の"],["友人","ゆうじん"],["の"],["ため"],["に"],["、"],["さあ"],["、"],["私","わたくし"],["は"],["言おう","いおう"],["。"],["「"],["おまえ"],["の"],["うち"],["に"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"],["」"]]},{"verse":9,"text":"私たちの神、主の家のために、私は、おまえの繁栄を求めよう。","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["家","いえ"],["の"],["ため"],["に"],["、"],["私","わたくし"],["は"],["、"],["おまえ"],["の"],["繁栄","はんえい"],["を"],["求めよう","もとめよう"],["。"]]}]
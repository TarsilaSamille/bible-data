[{"verse":1,"text":"（都上りの歌。ソロモンによる）主が家を建てるのでなければ、建てる者の働きはむなしい。主が町を守るのでなければ、守る者の見張りはむなしい。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["。"],["ソロモン"],["に"],["よる"],["）"],["主","ぬし"],["が"],["家","いえ"],["を"],["建てる","たてる"],["ので"],["なければ"],["、"],["建てる","たてる"],["者","もの"],["の"],["働き","はたらき"],["は"],["むなしい"],["。"],["主","ぬし"],["が"],["町","まち"],["を"],["守る","まもる"],["ので"],["なければ"],["、"],["守る","まもる"],["者","もの"],["の"],["見張り","みはり"],["は"],["むなしい"],["。"]]},{"verse":2,"text":"あなたがたが早く起きるのも、おそく休むのも、辛苦の糧を食べるのも、それはむなしい。主はその愛する者には、眠っている間に、このように備えてくださる。","tok":[["あなた"],["がた"],["が"],["早く","はやく"],["起きる","おきる"],["の"],["も"],["、"],["おそく"],["休む","やすむ"],["の"],["も"],["、"],["辛苦","しんく"],["の"],["糧","かて"],["を"],["食べる","たべる"],["の"],["も"],["、"],["それ"],["は"],["むなしい"],["。"],["主","ぬし"],["は"],["その"],["愛する","あいする"],["者","もの"],["に"],["は"],["、"],["眠って","ねむって"],["いる"],["間","あいだ"],["に"],["、"],["この"],["よう"],["に"],["備えて","そなえて"],["くださる"],["。"]]},{"verse":3,"text":"見よ。子どもたちは主の賜物、胎の実は報酬である。","tok":[["見","み"],["よ"],["。"],["子ども","こども"],["たち"],["は"],["主","ぬし"],["の"],["賜物","たまもの"],["、"],["胎","はら"],["の"],["実","じつ"],["は"],["報酬","ほうしゅう"],["で"],["ある"],["。"]]},{"verse":4,"text":"若い時の子らはまさに勇士の手にある矢のようだ。","tok":[["若い","わかい"],["時","とき"],["の"],["子","こ"],["ら"],["は"],["まさに"],["勇士","ゆうし"],["の"],["手","て"],["に"],["ある"],["矢","や"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"幸いなことよ。矢筒をその矢で満たしている人は。彼らは、門で敵と語る時にも、恥を見ることがない。","tok":[["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["矢筒","やづつ"],["を"],["その"],["矢","や"],["で"],["満たして","みたして"],["いる"],["人","ひと"],["は"],["。"],["彼","かれ"],["ら"],["は"],["、"],["門","もん"],["で"],["敵","てき"],["と"],["語る","かたる"],["時","とき"],["に"],["も"],["、"],["恥","はじ"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"]]}]
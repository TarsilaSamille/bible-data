[{"verse":1,"text":"（ダビデのマスキール。彼が洞窟にいたときに。祈り）私は主に向かい、声をあげて叫びます。声をあげ、主にあわれみを請います。","tok":[["（"],["ダビデ"],["の"],["マスキール"],["。"],["彼","かれ"],["が"],["洞窟","どうくつ"],["に"],["いた"],["とき"],["に"],["。"],["祈り","いのり"],["）"],["私","わたくし"],["は"],["主に","おもに"],["向かい","むかい"],["、"],["声","こえ"],["を"],["あげて"],["叫びます","さけびます"],["。"],["声","こえ"],["を"],["あげ"],["、"],["主に","おもに"],["あわれみ"],["を"],["請います","こいます"],["。"]]},{"verse":2,"text":"私は御前に自分の嘆きを注ぎ出し、私の苦しみを御前に言い表します。","tok":[["私","わたくし"],["は"],["御前","ごぜん"],["に"],["自分","じぶん"],["の"],["嘆き","なげき"],["を"],["注ぎ","そそぎ"],["出し","だし"],["、"],["私","わたくし"],["の"],["苦しみ","くるしみ"],["を"],["御前","ごぜん"],["に"],["言い表します","いいあらわします"],["。"]]},{"verse":3,"text":"私の霊が私のうちで衰え果てたとき、あなたこそ、私の道を知っておられる方です。私が歩く、その道に、彼らは、私に、わなを仕掛けているのです。","tok":[["私","わたくし"],["の"],["霊","れい"],["が"],["私","わたくし"],["の"],["うち"],["で"],["衰え","おとろえ"],["果てた","はてた"],["とき"],["、"],["あなた"],["こそ"],["、"],["私","わたくし"],["の"],["道","みち"],["を"],["知って","しって"],["おられる"],["方","かた"],["です"],["。"],["私","わたくし"],["が"],["歩く","あるく"],["、"],["その"],["道","みち"],["に"],["、"],["彼","かれ"],["ら"],["は"],["、"],["私","わたくし"],["に"],["、"],["わな"],["を"],["仕掛けて","しかけて"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"私の右のほうに目を注いで、見てください。私を顧みる者もなく、私の逃げる所もなくなり、私のたましいに気を配る者もいません。","tok":[["私","わたくし"],["の"],["右","みぎ"],["の"],["ほう"],["に"],["目","め"],["を"],["注いで","そそいで"],["、"],["見て","みて"],["ください"],["。"],["私","わたくし"],["を"],["顧みる","かえりみる"],["者","もの"],["も"],["なく"],["、"],["私","わたくし"],["の"],["逃げる","にげる"],["所","ところ"],["も"],["なくなり"],["、"],["私","わたくし"],["の"],["たましい"],["に"],["気","き"],["を"],["配る","くばる"],["者","もの"],["も"],["いません"],["。"]]},{"verse":5,"text":"主よ。私はあなたに叫んで、言いました。「あなたは私の避け所、生ける者の地で、私の分の土地です。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["叫んで","さけんで"],["、"],["言いました","いいました"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["の"],["避け","さけ"],["所","しょ"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["、"],["私","わたくし"],["の"],["分","ぶん"],["の"],["土地","とち"],["です"],["。"]]},{"verse":6,"text":"私の叫びに耳を留めてください。私はひどく、おとしめられていますから。どうか、私を迫害する者から救い出してください。彼らは私よりも強いのです。","tok":[["私","わたくし"],["の"],["叫び","さけび"],["に"],["耳","みみ"],["を"],["留めて","とめて"],["ください"],["。"],["私","わたくし"],["は"],["ひどく"],["、"],["おとしめられて"],["います"],["から"],["。"],["どう"],["か"],["、"],["私","わたくし"],["を"],["迫害","はくがい"],["する"],["者","もの"],["から"],["救い出して","すくいだして"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["より"],["も"],["強い","つよい"],["の"],["です"],["。"]]},{"verse":7,"text":"私のたましいを、牢獄から連れ出し、私があなたの御名に感謝するようにしてください。正しい者たちが私の回りに集まることでしょう。あなたが私に良くしてくださるからです。」","tok":[["私","わたくし"],["の"],["たましい"],["を"],["、"],["牢獄","ろうごく"],["から"],["連れ出し","つれだし"],["、"],["私","わたくし"],["が"],["あなた"],["の"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["する"],["よう"],["に"],["して"],["ください"],["。"],["正しい","ただしい"],["者","もの"],["たち"],["が"],["私","わたくし"],["の"],["回り","まわり"],["に"],["集まる","あつまる"],["こと"],["でしょう"],["。"],["あなた"],["が"],["私","わたくし"],["に"],["良く","よく"],["して"],["くださる"],["から"],["です"],["。"],["」"]]}]
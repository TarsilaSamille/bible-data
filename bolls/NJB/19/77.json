[{"verse":1,"text":"（指揮者のために。エドトンの調べによって。アサフの賛歌）私は神に向かい声をあげて、叫ぶ。私が神に向かって声をあげると、神は聞かれる。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["エドトン"],["の"],["調べ","しらべ"],["によって"],["。"],["アサフ"],["の"],["賛歌","さんか"],["）"],["私","わたくし"],["は"],["神","かみ"],["に"],["向かい","むかい"],["声","こえ"],["を"],["あげて"],["、"],["叫ぶ","さけぶ"],["。"],["私","わたくし"],["が"],["神","かみ"],["に"],["向かって","むかって"],["声","こえ"],["を"],["あげる"],["と"],["、"],["神","かみ"],["は"],["聞かれる","きかれる"],["。"]]},{"verse":2,"text":"苦難の日に、私は主を尋ね求め、夜には、たゆむことなく手を差し伸ばしたが、私のたましいは慰めを拒んだ。","tok":[["苦難","くなん"],["の"],["日","ひ"],["に"],["、"],["私","わたくし"],["は"],["主","ぬし"],["を"],["尋ね求め","たずねもとめ"],["、"],["夜","よる"],["に"],["は"],["、"],["たゆむ"],["こと"],["なく"],["手","て"],["を"],["差し伸ばした","さしのばした"],["が"],["、"],["私","わたくし"],["の"],["たましい"],["は"],["慰め","なぐさめ"],["を"],["拒んだ","こばんだ"],["。"]]},{"verse":3,"text":"私は神を思い起こして嘆き、思いを潜めて、私の霊は衰え果てる。セラ","tok":[["私","わたくし"],["は"],["神","かみ"],["を"],["思い起こして","おもいおこして"],["嘆き","なげき"],["、"],["思い","おもい"],["を"],["潜めて","ひそめて"],["、"],["私","わたくし"],["の"],["霊","れい"],["は"],["衰え","おとろえ"],["果てる","はてる"],["。"],["セラ"]]},{"verse":4,"text":"あなたは、私のまぶたを閉じさせない。私の心は乱れて、もの言うこともできない。","tok":[["あなた"],["は"],["、"],["私","わたくし"],["の"],["まぶた"],["を"],["閉じさせない","とじさせない"],["。"],["私","わたくし"],["の"],["心","こころ"],["は"],["乱れて","みだれて"],["、"],["もの"],["言う","いう"],["こと"],["も"],["できない"],["。"]]},{"verse":5,"text":"私は、昔の日々、遠い昔の年々を思い返した。","tok":[["私","わたくし"],["は"],["、"],["昔","むかし"],["の"],["日々","ひび"],["、"],["遠い","とおい"],["昔","むかし"],["の"],["年々","ねんねん"],["を"],["思い返した","おもいかえした"],["。"]]},{"verse":6,"text":"夜には私の歌を思い起こし、自分の心と語り合い、私の霊は探り求める。","tok":[["夜","よる"],["に"],["は"],["私","わたくし"],["の"],["歌","うた"],["を"],["思い起こし","おもいおこし"],["、"],["自分","じぶん"],["の"],["心","こころ"],["と"],["語り合い","かたりあい"],["、"],["私","わたくし"],["の"],["霊","れい"],["は"],["探り求める","さぐりもとめる"],["。"]]},{"verse":7,"text":"「主は、いつまでも拒まれるのだろうか。もう決して愛してくださらないのだろうか。","tok":[["「"],["主","ぬし"],["は"],["、"],["いつ"],["まで"],["も"],["拒まれる","こばまれる"],["の"],["だろう"],["か"],["。"],["もう"],["決して","けっして"],["愛して","あいして"],["くださらない"],["の"],["だろう"],["か"],["。"]]},{"verse":8,"text":"主の恵みは、永久に絶たれたのだろうか。約束は、代々に至るまで、果たされないのだろうか。","tok":[["主","ぬし"],["の"],["恵み","めぐみ"],["は"],["、"],["永久","えいきゅう"],["に"],["絶たれた","たたれた"],["の"],["だろう"],["か"],["。"],["約束","やくそく"],["は"],["、"],["代々","だいだい"],["に"],["至る","いたる"],["まで"],["、"],["果たされない","はたされない"],["の"],["だろう"],["か"],["。"]]},{"verse":9,"text":"神は、いつくしみを忘れたのだろうか。もしや、怒ってあわれみを閉じてしまわれたのだろうか。」セラ","tok":[["神","かみ"],["は"],["、"],["いつくしみ"],["を"],["忘れた","わすれた"],["の"],["だろう"],["か"],["。"],["もし"],["や"],["、"],["怒って","おこって"],["あわれみ"],["を"],["閉じて","とじて"],["しまわれた"],["の"],["だろう"],["か"],["。"],["」"],["セラ"]]},{"verse":10,"text":"そのとき私は言った。「私の弱いのはいと高き方の右の手が変わったことによる。」","tok":[["その"],["とき"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["弱い","よわい"],["の"],["は"],["いと"],["高き","たかき"],["方","ほう"],["の"],["右","みぎ"],["の"],["手","て"],["が"],["変わった","かわった"],["こと"],["に"],["よる"],["。"],["」"]]},{"verse":11,"text":"私は、主のみわざを思い起こそう。まことに、昔からのあなたの奇しいわざを思い起こそう。","tok":[["私","わたくし"],["は"],["、"],["主","ぬし"],["のみ"],["わざ"],["を"],["思い起こそう","おもいおこそう"],["。"],["まこと"],["に"],["、"],["昔","むかし"],["から"],["の"],["あなた"],["の"],["奇しい","くすしい"],["わざ"],["を"],["思い起こそう","おもいおこそう"],["。"]]},{"verse":12,"text":"私は、あなたのなさったすべてのことに思いを巡らし、あなたのみわざを、静かに考えよう。","tok":[["私","わたくし"],["は"],["、"],["あなた"],["の"],["なさった"],["すべて"],["の"],["こと"],["に"],["思い","おもい"],["を"],["巡らし","めぐらし"],["、"],["あなた"],["のみ"],["わざ"],["を"],["、"],["静か","しずか"],["に"],["考えよう","かんがえよう"],["。"]]},{"verse":13,"text":"神よ。あなたの道は聖です。神のように大いなる神が、ほかにありましょうか。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["の"],["道","みち"],["は"],["聖","せい"],["です"],["。"],["神","かみ"],["の"],["よう"],["に"],["大いなる","おおいなる"],["神","かみ"],["が"],["、"],["ほか"],["に"],["ありましょう"],["か"],["。"]]},{"verse":14,"text":"あなたは奇しいわざを行われる神、国々の民の中に御力を現される方です。","tok":[["あなた"],["は"],["奇しい","くすしい"],["わざ"],["を"],["行われる","おこなわれる"],["神","かみ"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["御力","おちから"],["を"],["現される","あらわされる"],["方","かた"],["です"],["。"]]},{"verse":15,"text":"あなたは御腕をもって、ご自分の民、ヤコブとヨセフの子らを贖われました。セラ","tok":[["あなた"],["は"],["御腕","おうで"],["を"],["もって"],["、"],["ご自分","ごじぶん"],["の"],["民","たみ"],["、"],["ヤコブ"],["と"],["ヨセフ"],["の"],["子","こ"],["ら"],["を"],["贖われました","あがなわれました"],["。"],["セラ"]]},{"verse":16,"text":"神よ。水はあなたを見たのです。水はあなたを見て、わななきました。わたつみもまた、震え上がりました。","tok":[["神","かみ"],["よ"],["。"],["水","みず"],["は"],["あなた"],["を"],["見た","みた"],["の"],["です"],["。"],["水","みず"],["は"],["あなた"],["を"],["見て","みて"],["、"],["わななきました"],["。"],["わたつみ"],["も"],["また"],["、"],["震え上がりました","ふるえあがりました"],["。"]]},{"verse":17,"text":"雲は水を注ぎ出し、雷雲は雷をとどろかし、あなたの矢もまた、ひらめき飛びました。","tok":[["雲","くも"],["は"],["水","みず"],["を"],["注ぎ","そそぎ"],["出し","だし"],["、"],["雷雲","らいうん"],["は"],["雷","かみなり"],["を"],["とどろかし"],["、"],["あなた"],["の"],["矢","や"],["も"],["また"],["、"],["ひらめき"],["飛びました","とびました"],["。"]]},{"verse":18,"text":"あなたの雷の声は、いくさ車のように鳴り、いなずまは世界を照らし、地は震え、揺れ動きました。","tok":[["あなた"],["の"],["雷","かみなり"],["の"],["声","こえ"],["は"],["、"],["いくさ車","いくさしゃ"],["の"],["よう"],["に"],["鳴り","なり"],["、"],["いなずま"],["は"],["世界","せかい"],["を"],["照らし","てらし"],["、"],["地","ち"],["は"],["震え","ふるえ"],["、"],["揺れ動きました","ゆれうごきました"],["。"]]},{"verse":19,"text":"あなたの道は海の中にあり、あなたの小道は大水の中にありました。それで、あなたの足跡を見た者はありません。","tok":[["あなた"],["の"],["道","みち"],["は"],["海","うみ"],["の"],["中","なか"],["に"],["あり"],["、"],["あなた"],["の"],["小道","こみち"],["は"],["大水","おおみず"],["の"],["中","なか"],["に"],["ありました"],["。"],["それ"],["で"],["、"],["あなた"],["の"],["足跡","あしあと"],["を"],["見た","みた"],["者","もの"],["は"],["ありません"],["。"]]},{"verse":20,"text":"あなたは、ご自分の民を、モーセとアロンの手によって、羊の群れのように導かれました。","tok":[["あなた"],["は"],["、"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["、"],["モーセ"],["と"],["アロン"],["の"],["手","て"],["によって"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["よう"],["に"],["導かれました","みちびかれました"],["。"]]}]
[{"verse":1,"text":"（指揮者のために。コラの子たちのマスキール）鹿が谷川の流れを慕いあえぐように、神よ。私のたましいはあなたを慕いあえぎます。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["コラ"],["の"],["子","こ"],["たち"],["の"],["マスキール"],["）"],["鹿","しか"],["が"],["谷川","たにがわ"],["の"],["流れ","ながれ"],["を"],["慕い","したい"],["あえぐ"],["よう"],["に"],["、"],["神","かみ"],["よ"],["。"],["私","わたくし"],["の"],["たましい"],["は"],["あなた"],["を"],["慕い","したい"],["あえぎます"],["。"]]},{"verse":2,"text":"私のたましいは、神を、生ける神を求めて渇いています。いつ、私は行って、神の御前に出ましょうか。","tok":[["私","わたくし"],["の"],["たましい"],["は"],["、"],["神","かみ"],["を"],["、"],["生ける","いける"],["神","かみ"],["を"],["求めて","もとめて"],["渇いて","かわいて"],["います"],["。"],["いつ"],["、"],["私","わたくし"],["は"],["行って","いって"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["出ましょう","でましょう"],["か"],["。"]]},{"verse":3,"text":"私の涙は、昼も夜も、私の食べ物でした。人が一日中「おまえの神はどこにいるのか」と私に言う間。","tok":[["私","わたくし"],["の"],["涙","なみだ"],["は"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["、"],["私","わたくし"],["の"],["食べ物","たべもの"],["でした"],["。"],["人","ひと"],["が"],["一","いち"],["日","にち"],["中","なか"],["「"],["おまえ"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["私","わたくし"],["に"],["言う","いう"],["間","ま"],["。"]]},{"verse":4,"text":"私はあの事などを思い起こし、私の前で心を注ぎ出しています。私があの群れといっしょに行き巡り、喜びと感謝の声をあげて、祭りを祝う群集とともに神の家へとゆっくり歩いて行ったことなどを。","tok":[["私","わたくし"],["は"],["あの"],["事","こと"],["など"],["を"],["思い起こし","おもいおこし"],["、"],["私","わたくし"],["の"],["前","まえ"],["で"],["心","こころ"],["を"],["注ぎ","そそぎ"],["出して","だして"],["います"],["。"],["私","わたくし"],["が"],["あの"],["群れ","むれ"],["と"],["いっしょ"],["に"],["行き","いき"],["巡り","めぐり"],["、"],["喜び","よろこび"],["と"],["感謝","かんしゃ"],["の"],["声","こえ"],["を"],["あげて"],["、"],["祭り","まつり"],["を"],["祝う","いわう"],["群集","ぐんしゅう"],["と"],["とも"],["に"],["神","かみ"],["の"],["家","いえ"],["へ"],["と"],["ゆっくり"],["歩いて","あるいて"],["行った","いった"],["こと"],["など"],["を"],["。"]]},{"verse":5,"text":"わがたましいよ。なぜ、おまえはうなだれているのか。私の前で思い乱れているのか。神を待ち望め。私はなおも神をほめたたえる。御顔の救いを。","tok":[["わが"],["たましい"],["よ"],["。"],["なぜ"],["、"],["おまえ"],["は"],["うなだれて"],["いる"],["の"],["か"],["。"],["私","わたくし"],["の"],["前","まえ"],["で"],["思い乱れて","おもいみだれて"],["いる"],["の"],["か"],["。"],["神","かみ"],["を"],["待ち望め","まちのぞめ"],["。"],["私","わたくし"],["は"],["なお"],["も"],["神","かみ"],["を"],["ほめたたえる"],["。"],["御顔","おかお"],["の"],["救い","すくい"],["を"],["。"]]},{"verse":6,"text":"私の神よ。私のたましいは私の前でうなだれています。それゆえ、ヨルダンとヘルモンの地から、またミツァルの山から私はあなたを思い起こします。","tok":[["私","わたくし"],["の"],["神","かみ"],["よ"],["。"],["私","わたくし"],["の"],["たましい"],["は"],["私","わたくし"],["の"],["前","まえ"],["で"],["うなだれて"],["います"],["。"],["それ"],["ゆえ"],["、"],["ヨルダン"],["と"],["ヘルモン"],["の"],["地","ち"],["から"],["、"],["また"],["ミツァル"],["の"],["山","やま"],["から"],["私","わたくし"],["は"],["あなた"],["を"],["思い起こします","おもいおこします"],["。"]]},{"verse":7,"text":"あなたの大滝のとどろきに、淵が淵を呼び起こし、あなたの波、あなたの大波は、みな私の上を越えて行きました。","tok":[["あなた"],["の"],["大滝","おおたき"],["の"],["とどろき"],["に"],["、"],["淵","ふち"],["が"],["淵","ふち"],["を"],["呼び起こし","よびおこし"],["、"],["あなた"],["の"],["波","なみ"],["、"],["あなた"],["の"],["大波","おおなみ"],["は"],["、"],["みな"],["私","わたくし"],["の"],["上","うえ"],["を"],["越えて","こえて"],["行きました","いきました"],["。"]]},{"verse":8,"text":"昼には、主が恵みを施し、夜には、その歌が私とともにあります。私のいのち、神への、祈りが。","tok":[["昼","ひる"],["に"],["は"],["、"],["主","ぬし"],["が"],["恵み","めぐみ"],["を"],["施し","ほどこし"],["、"],["夜","よる"],["に"],["は"],["、"],["その"],["歌","うた"],["が"],["私","わたくし"],["と"],["とも"],["に"],["あります"],["。"],["私","わたくし"],["の"],["いのち"],["、"],["神","かみ"],["へ"],["の"],["、"],["祈り","いのり"],["が"],["。"]]},{"verse":9,"text":"私は、わが巌の神に申し上げます。「なぜ、あなたは私をお忘れになったのですか。なぜ私は敵のしいたげに、嘆いて歩くのですか。」","tok":[["私","わたくし"],["は"],["、"],["わが"],["巌","いわ"],["の"],["神","かみ"],["に"],["申し上げます","もうしあげます"],["。"],["「"],["なぜ"],["、"],["あなた"],["は"],["私","わたくし"],["を"],["お忘れ","おわすれ"],["に"],["なった"],["の"],["です"],["か"],["。"],["なぜ"],["私","わたくし"],["は"],["敵","てき"],["の"],["しいたげ"],["に"],["、"],["嘆いて","なげいて"],["歩く","あるく"],["の"],["です"],["か"],["。"],["」"]]},{"verse":10,"text":"私に敵対する者どもは、私の骨々が打ち砕かれるほど、私をそしり、一日中、「おまえの神はどこにいるのか」と私に言っています。","tok":[["私","わたくし"],["に"],["敵対","てきたい"],["する"],["者","もの"],["ども"],["は"],["、"],["私","わたくし"],["の"],["骨々","ほねぼね"],["が"],["打ち砕かれる","うちくだかれる"],["ほど"],["、"],["私","わたくし"],["を"],["そしり"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["「"],["おまえ"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["私","わたくし"],["に"],["言って","いって"],["います"],["。"]]},{"verse":11,"text":"わがたましいよ。なぜ、おまえはうなだれているのか。なぜ、私の前で思い乱れているのか。神を待ち望め。私はなおも神をほめたたえる。私の顔の救い、私の神を。","tok":[["わが"],["たましい"],["よ"],["。"],["なぜ"],["、"],["おまえ"],["は"],["うなだれて"],["いる"],["の"],["か"],["。"],["なぜ"],["、"],["私","わたくし"],["の"],["前","まえ"],["で"],["思い乱れて","おもいみだれて"],["いる"],["の"],["か"],["。"],["神","かみ"],["を"],["待ち望め","まちのぞめ"],["。"],["私","わたくし"],["は"],["なお"],["も"],["神","かみ"],["を"],["ほめたたえる"],["。"],["私","わたくし"],["の"],["顔","かお"],["の"],["救い","すくい"],["、"],["私","わたくし"],["の"],["神","かみ"],["を"],["。"]]}]
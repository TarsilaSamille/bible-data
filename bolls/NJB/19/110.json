[{"verse":1,"text":"（ダビデの賛歌）主は、私の主に仰せられる。「わたしがあなたの敵をあなたの足台とするまでは、わたしの右の座に着いていよ。」","tok":[["（"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["主","ぬし"],["に"],["仰せられる","おおせられる"],["。"],["「"],["わたし"],["が"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["足台","あしだい"],["と"],["する"],["まで"],["は"],["、"],["わたし"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着いて","ついて"],["い"],["よ"],["。"],["」"]]},{"verse":2,"text":"主は、あなたの力強い杖をシオンから伸ばされる。「あなたの敵の真ん中で治めよ。」","tok":[["主","ぬし"],["は"],["、"],["あなた"],["の"],["力強い","ちからづよい"],["杖","つえ"],["を"],["シオン"],["から"],["伸ばされる","のばされる"],["。"],["「"],["あなた"],["の"],["敵","てき"],["の"],["真ん中","まんなか"],["で"],["治めよ","おさめよ"],["。"],["」"]]},{"verse":3,"text":"あなたの民は、あなたの戦いの日に、聖なる飾り物を着けて、夜明け前から喜んで仕える。あなたの若者は、あなたにとっては、朝露のようだ。","tok":[["あなた"],["の"],["民","たみ"],["は"],["、"],["あなた"],["の"],["戦い","たたかい"],["の"],["日","ひ"],["に"],["、"],["聖","せい"],["なる"],["飾り物","かざりもの"],["を"],["着けて","つけて"],["、"],["夜明け","よあけ"],["前","まえ"],["から"],["喜んで","よろこんで"],["仕える","つかえる"],["。"],["あなた"],["の"],["若者","わかもの"],["は"],["、"],["あなた"],["にとって"],["は"],["、"],["朝露","ちょうろ"],["の"],["よう"],["だ"],["。"]]},{"verse":4,"text":"主は誓い、そしてみこころを変えない。「あなたは、メルキゼデクの例にならい、とこしえに祭司である。」","tok":[["主","ぬし"],["は"],["誓い","ちかい"],["、"],["そして"],["みこころ"],["を"],["変えない","かえない"],["。"],["「"],["あなた"],["は"],["、"],["メルキゼデク"],["の"],["例","れい"],["に"],["ならい"],["、"],["とこしえ"],["に"],["祭司","さいし"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"あなたの右にいます主は御怒りの日に、王たちを打ち砕かれる。","tok":[["あなた"],["の"],["右","みぎ"],["に"],["います"],["主","ぬし"],["は"],["御怒り","おいかり"],["の"],["日","ひ"],["に"],["、"],["王","おう"],["たち"],["を"],["打ち砕かれる","うちくだかれる"],["。"]]},{"verse":6,"text":"主は国々の間をさばき、それらをしかばねで満たし、広い国を治めるかしらを打ち砕かれる。","tok":[["主","ぬし"],["は"],["国々","くにぐに"],["の"],["間","あいだ"],["を"],["さばき"],["、"],["それ"],["ら"],["を"],["しかばね"],["で"],["満たし","みたし"],["、"],["広い","ひろい"],["国","くに"],["を"],["治める","おさめる"],["かしら"],["を"],["打ち砕かれる","うちくだかれる"],["。"]]},{"verse":7,"text":"主は道のほとりの流れから水を飲まれよう。それゆえ、その頭を高く上げられる。","tok":[["主","ぬし"],["は"],["道","みち"],["の"],["ほとり"],["の"],["流れ","ながれ"],["から"],["水","みず"],["を"],["飲まれよう","のまれよう"],["。"],["それ"],["ゆえ"],["、"],["その"],["頭","あたま"],["を"],["高く","たかく"],["上げられる","あげられる"],["。"]]}]
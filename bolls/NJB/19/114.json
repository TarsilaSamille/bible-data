[{"verse":1,"text":"イスラエルがエジプトから、ヤコブの家が異なることばの民のうちから、出て来たとき、","tok":[["イスラエル"],["が"],["エジプト"],["から"],["、"],["ヤコブ"],["の"],["家","いえ"],["が"],["異なる","ことなる"],["ことば"],["の"],["民","たみ"],["の"],["うち"],["から"],["、"],["出て","でて"],["来た","きた"],["とき"],["、"]]},{"verse":2,"text":"ユダは神の聖所となり、イスラエルはその領地となった。","tok":[["ユダ"],["は"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["と"],["なり"],["、"],["イスラエル"],["は"],["その"],["領地","りょうち"],["と"],["なった"],["。"]]},{"verse":3,"text":"海は見て逃げ去り、ヨルダン川はさかさに流れた。","tok":[["海","うみ"],["は"],["見て","みて"],["逃げ去り","にげさり"],["、"],["ヨルダン"],["川","かわ"],["は"],["さかさ"],["に"],["流れた","ながれた"],["。"]]},{"verse":4,"text":"山々は雄羊のように、丘は子羊のように、はねた。","tok":[["山々","やまやま"],["は"],["雄羊","おひつじ"],["の"],["よう"],["に"],["、"],["丘","おか"],["は"],["子羊","こひつじ"],["の"],["よう"],["に"],["、"],["はねた"],["。"]]},{"verse":5,"text":"海よ。なぜ、おまえは逃げ去るのか。ヨルダン川よ。なぜ、さかさに流れるのか。","tok":[["海","うみ"],["よ"],["。"],["なぜ"],["、"],["おまえ"],["は"],["逃げ去る","にげさる"],["の"],["か"],["。"],["ヨルダン"],["川","かわ"],["よ"],["。"],["なぜ"],["、"],["さかさ"],["に"],["流れる","ながれる"],["の"],["か"],["。"]]},{"verse":6,"text":"山々よ。おまえはなぜ雄羊のようにはねるのか。丘よ。なぜ子羊のようにはねるのか。","tok":[["山々","やまやま"],["よ"],["。"],["おまえ"],["は"],["なぜ"],["雄羊","おひつじ"],["の"],["よう"],["に"],["はねる"],["の"],["か"],["。"],["丘","おか"],["よ"],["。"],["なぜ"],["子羊","こひつじ"],["の"],["よう"],["に"],["はねる"],["の"],["か"],["。"]]},{"verse":7,"text":"地よ。主の御前におののけ。ヤコブの神の御前に。","tok":[["地","ち"],["よ"],["。"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["おののけ"],["。"],["ヤコブ"],["の"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["。"]]},{"verse":8,"text":"神は、岩を水のある沢に変えられた。堅い石を水の出る泉に。","tok":[["神","かみ"],["は"],["、"],["岩","いわ"],["を"],["水","みず"],["の"],["ある"],["沢","さわ"],["に"],["変えられた","かえられた"],["。"],["堅い","かたい"],["石","いし"],["を"],["水","みず"],["の"],["出る","でる"],["泉","いずみ"],["に"],["。"]]}]
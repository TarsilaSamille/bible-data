[{"verse":1,"text":"（悩む者の祈り。彼が気落ちして、自分の嘆きを主の前に注ぎ出したときのもの）主よ。私の祈りを聞いてください。私の叫びが、あなたに届きますように。","tok":[["（"],["悩む","なやむ"],["者","もの"],["の"],["祈り","いのり"],["。"],["彼","かれ"],["が"],["気落ち","きおち"],["して"],["、"],["自分","じぶん"],["の"],["嘆き","なげき"],["を"],["主","ぬし"],["の"],["前","まえ"],["に"],["注ぎ","そそぎ"],["出した","だした"],["とき"],["の"],["もの"],["）"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["祈り","いのり"],["を"],["聞いて","きいて"],["ください"],["。"],["私","わたくし"],["の"],["叫び","さけび"],["が"],["、"],["あなた"],["に"],["届きます","とどきます"],["よう"],["に"],["。"]]},{"verse":2,"text":"私が苦しんでいるときに、御顔を私に隠さないでください。私に耳を傾けてください。私が呼ぶときに、早く私に答えてください。","tok":[["私","わたくし"],["が"],["苦しんで","くるしんで"],["いる"],["とき"],["に"],["、"],["御顔","おかお"],["を"],["私","わたくし"],["に"],["隠さないで","かくさないで"],["ください"],["。"],["私","わたくし"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"],["私","わたくし"],["が"],["呼ぶ","よぶ"],["とき"],["に"],["、"],["早く","はやく"],["私","わたくし"],["に"],["答えて","こたえて"],["ください"],["。"]]},{"verse":3,"text":"私の日は煙の中に尽き果て、私の骨は炉のように燃えていますから。","tok":[["私","わたくし"],["の"],["日","ひ"],["は"],["煙","けむり"],["の"],["中","なか"],["に"],["尽き","つき"],["果て","はて"],["、"],["私","わたくし"],["の"],["骨","ほね"],["は"],["炉","ろ"],["の"],["よう"],["に"],["燃えて","もえて"],["います"],["から"],["。"]]},{"verse":4,"text":"私の心は、青菜のように打たれ、しおれ、パンを食べることさえ忘れました。","tok":[["私","わたくし"],["の"],["心","こころ"],["は"],["、"],["青菜","あおな"],["の"],["よう"],["に"],["打たれ","うたれ"],["、"],["しおれ"],["、"],["パン"],["を"],["食べる","たべる"],["こと"],["さえ"],["忘れました","わすれました"],["。"]]},{"verse":5,"text":"私の嘆く声で私の骨と皮はくっついてしまいました。","tok":[["私","わたくし"],["の"],["嘆く","なげく"],["声","こえ"],["で"],["私","わたくし"],["の"],["骨","ほね"],["と"],["皮","かわ"],["は"],["くっついて"],["しまいました"],["。"]]},{"verse":6,"text":"私は荒野のペリカンのようになり、廃墟のふくろうのようになっています。","tok":[["私","わたくし"],["は"],["荒野","こうや"],["の"],["ペリカン"],["の"],["よう"],["に"],["なり"],["、"],["廃墟","はいきょ"],["の"],["ふくろう"],["の"],["よう"],["に"],["なって"],["います"],["。"]]},{"verse":7,"text":"私はやせ衰えて、屋根の上のひとりぼっちの鳥のようになりました。","tok":[["私","わたくし"],["は"],["やせ衰えて","やせおとろえて"],["、"],["屋根","やね"],["の"],["上","うえ"],["の"],["ひとりぼっち"],["の"],["鳥","とり"],["の"],["よう"],["に"],["なりました"],["。"]]},{"verse":8,"text":"私の敵は一日中私をそしり、私をあざける者は私を名ざして毒づきます。","tok":[["私","わたくし"],["の"],["敵","てき"],["は"],["一","いち"],["日中","にちちゅう"],["私","わたくし"],["を"],["そしり"],["、"],["私","わたくし"],["を"],["あざける"],["者","もの"],["は"],["私","わたくし"],["を"],["名ざし","なざし"],["て"],["毒づきます","どくづきます"],["。"]]},{"verse":9,"text":"これはみな、私が、パンを食べるように灰を食べ、私の飲み物に涙を混ぜ合わせたからです。","tok":[["これ"],["は"],["みな"],["、"],["私","わたくし"],["が"],["、"],["パン"],["を"],["食べる","たべる"],["よう"],["に"],["灰","はい"],["を"],["食べ","たべ"],["、"],["私","わたくし"],["の"],["飲み物","のみもの"],["に"],["涙","なみだ"],["を"],["混ぜ合わせた","まぜあわせた"],["から"],["です"],["。"]]},{"verse":10,"text":"それはあなたの憤りと怒りとのゆえに、あなたが私を持ち上げ、投げ出されたからです。","tok":[["それ"],["は"],["あなた"],["の"],["憤り","いきどおり"],["と"],["怒り","いかり"],["と"],["の"],["ゆえ"],["に"],["、"],["あなた"],["が"],["私","わたくし"],["を"],["持ち上げ","もちあげ"],["、"],["投げ出された","なげだされた"],["から"],["です"],["。"]]},{"verse":11,"text":"私の日は、伸びていく夕影のようです。私は、青菜のようにしおれています。","tok":[["私","わたくし"],["の"],["日","ひ"],["は"],["、"],["伸びて","のびて"],["いく"],["夕影","ゆうかげ"],["の"],["よう"],["です"],["。"],["私","わたくし"],["は"],["、"],["青菜","あおな"],["の"],["よう"],["に"],["しおれて"],["います"],["。"]]},{"verse":12,"text":"しかし、主よ。あなたはとこしえに御座に着き、あなたの御名は代々に及びます。","tok":[["しかし"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["とこしえ"],["に"],["御座","ぎょざ"],["に"],["着き","つき"],["、"],["あなた"],["の"],["御名","ぎょめい"],["は"],["代々","だいだい"],["に"],["及びます","およびます"],["。"]]},{"verse":13,"text":"あなたは立ち上がり、シオンをあわれんでくださいます。今やいつくしみの時です。定めの時が来たからです。","tok":[["あなた"],["は"],["立ち上がり","たちあがり"],["、"],["シオン"],["を"],["あわれんで"],["くださいます"],["。"],["今","いま"],["や"],["いつくしみ"],["の"],["時","とき"],["です"],["。"],["定め","さだめ"],["の"],["時","とき"],["が"],["来た","きた"],["から"],["です"],["。"]]},{"verse":14,"text":"まことに、あなたのしもべはシオンの石を愛し、シオンのちりをいつくしみます。","tok":[["まこと"],["に"],["、"],["あなた"],["の"],["しもべ"],["は"],["シオン"],["の"],["石","いし"],["を"],["愛し","あいし"],["、"],["シオン"],["の"],["ちり"],["を"],["いつくしみます"],["。"]]},{"verse":15,"text":"こうして、国々は主の御名を恐れ、地のすべての王はあなたの栄光を恐れましょう。","tok":[["こう"],["して"],["、"],["国々","くにぐに"],["は"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["恐れ","おそれ"],["、"],["地","ち"],[
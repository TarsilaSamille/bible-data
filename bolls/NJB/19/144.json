[{"verse":1,"text":"（ダビデによる）ほむべきかな。わが岩である主。主は、戦いのために私の手を、いくさのために私の指を、鍛えられる。","tok":[["（"],["ダビデ"],["に"],["よる"],["）"],["ほ"],["むべき"],["か"],["な"],["。"],["わが"],["岩","いわ"],["で"],["ある"],["主","ぬし"],["。"],["主","ぬし"],["は"],["、"],["戦い","たたかい"],["の"],["ため"],["に"],["私","わたくし"],["の"],["手","て"],["を"],["、"],["いくさ"],["の"],["ため"],["に"],["私","わたくし"],["の"],["指","ゆび"],["を"],["、"],["鍛えられる","きたえられる"],["。"]]},{"verse":2,"text":"主は私の恵み、私のとりで。私のやぐら、私を救う方。私の盾、私の身の避け所。私の民を私に服させる方。","tok":[["主","ぬし"],["は"],["私","わたくし"],["の"],["恵み","めぐみ"],["、"],["私","わたくし"],["の"],["とり"],["で"],["。"],["私","わたくし"],["の"],["やぐら"],["、"],["私","わたくし"],["を"],["救う","すくう"],["方","かた"],["。"],["私","わたくし"],["の"],["盾","たて"],["、"],["私","わたくし"],["の"],["身","み"],["の"],["避け","さけ"],["所","しょ"],["。"],["私","わたくし"],["の"],["民","たみ"],["を"],["私","わたくし"],["に"],["服させる","ふくさせる"],["方","かた"],["。"]]},{"verse":3,"text":"主よ。人とは何者なのでしょう。あなたがこれを知っておられるとは。人の子とは何者なのでしょう。あなたがこれを顧みられるとは。","tok":[["主","ぬし"],["よ"],["。"],["人","ひと"],["と"],["は"],["何者","なにもの"],["な"],["の"],["でしょう"],["。"],["あなた"],["が"],["これ"],["を"],["知って","しって"],["おられる"],["と"],["は"],["。"],["人","ひと"],["の"],["子","こ"],["と"],["は"],["何者","なにもの"],["な"],["の"],["でしょう"],["。"],["あなた"],["が"],["これ"],["を"],["顧みられる","かえりみられる"],["と"],["は"],["。"]]},{"verse":4,"text":"人はただ息に似て、その日々は過ぎ去る影のようです。","tok":[["人","ひと"],["は"],["ただ"],["息","いき"],["に"],["似て","にて"],["、"],["その"],["日々","ひび"],["は"],["過ぎ去る","すぎさる"],["影","かげ"],["の"],["よう"],["です"],["。"]]},{"verse":5,"text":"主よ。あなたの天を押し曲げて降りて来てください。山々に触れて、煙を出させてください。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["天","てん"],["を"],["押し曲げて","おしまげて"],["降りて","おりて"],["来て","きて"],["ください"],["。"],["山々","やまやま"],["に"],["触れて","ふれて"],["、"],["煙","けむり"],["を"],["出させて","ださせて"],["ください"],["。"]]},{"verse":6,"text":"いなずまを放って、彼らを散らし、あなたの矢を放って、彼らをかき乱してください。","tok":[["いなずま"],["を"],["放って","はなって"],["、"],["彼","かれ"],["ら"],["を"],["散らし","ちらし"],["、"],["あなた"],["の"],["矢","や"],["を"],["放って","はなって"],["、"],["彼","かれ"],["ら"],["を"],["かき乱して","かきみだして"],["ください"],["。"]]},{"verse":7,"text":"いと高き所からあなたの御手を伸べ、大水から、また外国人の手から、私を解き放し、救い出してください。","tok":[["いと"],["高き","たかき"],["所","ところ"],["から"],["あなた"],["の"],["御手","おて"],["を"],["伸べ","のべ"],["、"],["大水","おおみず"],["から"],["、"],["また"],["外国人","がいこくじん"],["の"],["手","て"],["から"],["、"],["私","わたくし"],["を"],["解き放し","ときはなし"],["、"],["救い出して","すくいだして"],["ください"],["。"]]},{"verse":8,"text":"彼らの口はうそを言い、その右の手は偽りの右の手です。","tok":[["彼","かれ"],["ら"],["の"],["口","くち"],["は"],["うそ"],["を"],["言い","いい"],["、"],["その"],["右","みぎ"],["の"],["手","て"],["は"],["偽り","いつわり"],["の"],["右","みぎ"],["の"],["手","て"],["です"],["。"]]},{"verse":9,"text":"神よ。あなたに、私は新しい歌を歌い、十弦の琴をもってあなたに、ほめ歌を歌います。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["に"],["、"],["私","わたくし"],["は"],["新しい","あたらしい"],["歌","うた"],["を"],["歌い","うたい"],["、"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["を"],["もって"],["あなた"],["に"],["、"],["ほめ歌","ほめうた"],["を"],["歌います","うたいます"],["。"]]},{"verse":10,"text":"神は王たちに救いを与え、神のしもべダビデを、悪の剣から解き放されます。","tok":[["神","かみ"],["は"],["王","おう"],["たち"],["に"],["救い","すくい"],["を"],["与え","あたえ"],["、"],["神","かみ"],["の"],["しもべ"],["ダビデ"],["を"],["、"],["悪","あく"],["の"],["剣","けん"],["から"],["解き放されます","ときはなされます"],["。"]]},{"verse":11,"text":"私を、外国人の手から解き放し、救い出してください。彼らの口はうそを言い、その右の手は偽りの右の手です。","tok":[["私","わたくし"],["を"],["、"],["外国人","がいこくじん"],["の"],["手","て"],["から"],["解き放し","ときはなし"],["、"],["救い出して","すくいだして"],["ください"],["。"],["彼","かれ"],["ら"],["の"],["口","くち"],["は"],["うそ"],["を"],["言い","いい"],["、"],["その"],["右","みぎ"],["の"],["手","て"],["は"],["偽り","いつわり"],["の"],["右","みぎ"],["の"],["手","て"],["です"],["。"]]},{"verse":12,"text":"私たちの息子らが、若いときに、よく育った若木のようになりますように。私たちの娘らが、宮殿の建物にふさわしく刻まれた隅の柱のようになりますように。","tok":[["私たち","わたしたち"],["の"],["息子","むすこ"],["ら"],["が"],["、"],["若い","わかい"],["とき"],["に"],["、"],["よく"],["育った","そだった"],["若木","わかぎ"],["の"],["よう"],["に"],["なります"],["よう"],["に"],["。"],["私たち","わたしたち"],["の"],["娘","むすめ"],["ら"],["が"],["、"],["宮殿","きゅうでん"],["の"],["建物","たてもの"],["に"],["ふさわしく"],["刻まれた","きざまれた"],["隅","すみ"],["の"],["柱","はしら"],["の"],["よう"],["に"],["なります"],["よう"],["に"],["。"]]},{"verse":13,"text":"私たちの倉は満ち、あらゆる産物を備えますように。私たちの羊の群れは、私たちの野原で、幾千幾万となりますように。","tok":[["私たち","わたしたち"],["の"],["倉","くら"],["は"],["満ち","みち"],["、"],["あらゆる"],["産物","さんぶつ"],["を"],["備えます","そなえます"],["よう"],["に"],["。"],["私たち","わたしたち"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["は"],["、"],["私たち","わたしたち"],["の"],["野原","のはら"],["で"],["、"],["幾","いく"],["千","せんの"],["幾万","いくま"],["と"],["なります"],["よう"],["に"],["。"]]},{"verse":14,"text":"私たちの牛が子牛を産み、死ぬこともなく、出て行くこともなく、また、哀れな叫び声が私たちの町にありませんように。","tok":[["私たち","わたしたち"],["の"],["牛","うし"],["が"],["子牛","こうし"],["を"],["産み","うみ"],["、"],["死ぬ","しぬ"],["こと"],["も"],["なく"],["、"],["出て","でて"],["行く","いく"],["こと"],["も"],["なく"],["、"],["また"],["、"],["哀れ","あわれ"],["な"],["叫び声","さけびごえ"],["が"],["私たち","わたしたち"],["の"],["町","まち"],["に"],["ありません"],["よう"],["に"],["。"]]},{"verse":15,"text":"幸いなことよ。このようになる民は。幸いなことよ。主をおのれの神とするその民は。","tok":[["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["この"],["よう"],["に"],["なる"],["民","たみ"],["は"],["。"],["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["主","ぬし"],["を"],["おのれ"],["の"],["神","かみ"],["と"],["する"],["その"],["民","みん"],["は"],["。"]]}]
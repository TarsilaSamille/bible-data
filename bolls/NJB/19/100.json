[{"verse":1,"text":"（感謝の賛歌）全地よ。主に向かって喜びの声をあげよ。","tok":[["（"],["感謝","かんしゃ"],["の"],["賛歌","さんか"],["）"],["全地","ぜんち"],["よ"],["。"],["主に","おもに"],["向かって","むかって"],["喜び","よろこび"],["の"],["声","こえ"],["を"],["あげ"],["よ"],["。"]]},{"verse":2,"text":"喜びをもって主に仕えよ。喜び歌いつつ御前に来たれ。","tok":[["喜び","よろこび"],["を"],["もって"],["主に","おもに"],["仕え","つかえ"],["よ"],["。"],["喜び歌い","よろこびうたい"],["つつ"],["御前","ごぜん"],["に"],["来たれ","きたれ"],["。"]]},{"verse":3,"text":"知れ。主こそ神。主が、私たちを造られた。私たちは主のもの、主の民、その牧場の羊である。","tok":[["知れ","しれ"],["。"],["主","ぬし"],["こそ"],["神","かみ"],["。"],["主","ぬし"],["が"],["、"],["私たち","わたしたち"],["を"],["造られた","つくられた"],["。"],["私たち","わたしたち"],["は"],["主","ぬし"],["の"],["もの"],["、"],["主","ぬし"],["の"],["民","たみ"],["、"],["その"],["牧場","ぼくじょう"],["の"],["羊","ひつじ"],["で"],["ある"],["。"]]},{"verse":4,"text":"感謝しつつ、主の門に、賛美しつつ、その大庭に、入れ。主に感謝し、御名をほめたたえよ。","tok":[["感謝","かんしゃ"],["し"],["つつ"],["、"],["主","ぬし"],["の"],["門","もん"],["に"],["、"],["賛美","さんび"],["し"],["つつ"],["、"],["その"],["大庭","おおば"],["に"],["、"],["入れ","いれ"],["。"],["主に","おもに"],["感謝","かんしゃ"],["し"],["、"],["御名","ぎょめい"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":5,"text":"主はいつくしみ深くその恵みはとこしえまで、その真実は代々に至る。","tok":[["主","ぬし"],["は"],["いつくしみ"],["深く","ふかく"],["その"],["恵み","めぐみ"],["は"],["とこしえ"],["まで"],["、"],["その"],["真実","しんじつ"],["は"],["代々","だいだい"],["に"],["至る","いたる"],["。"]]}]
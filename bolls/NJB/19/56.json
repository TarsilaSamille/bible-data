[{"verse":1,"text":"（指揮者のために。「遠くの人の、もの言わぬ鳩」の調べに合わせて。ダビデのミクタム。ペリシテ人が、ガテでダビデを捕らえたときに）神よ。私をあわれんでください。人が私を踏みつけ、一日中、戦って、私をしいたげます。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["「"],["遠く","とおく"],["の"],["人","ひと"],["の"],["、"],["もの"],["言わぬ","いわぬ"],["鳩","はと"],["」"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["ミクタム"],["。"],["ペリシテ"],["人","にん"],["が"],["、"],["ガテ"],["で"],["ダビデ"],["を"],["捕らえた","とらえた"],["とき"],["に"],["）"],["神","かみ"],["よ"],["。"],["私","わたくし"],["を"],["あわれんで"],["ください"],["。"],["人","ひと"],["が"],["私","わたくし"],["を"],["踏みつけ","ふみつけ"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["戦って","たたかって"],["、"],["私","わたくし"],["を"],["しいたげます"],["。"]]},{"verse":2,"text":"私の敵は、一日中、私を踏みつけています。誇らしげに私に戦いをいどんでいる者が、多くいます。","tok":[["私","わたくし"],["の"],["敵","てき"],["は"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["私","わたくし"],["を"],["踏みつけて","ふみつけて"],["います"],["。"],["誇らし","ほこらし"],["げ"],["に"],["私","わたくし"],["に"],["戦い","たたかい"],["を"],["いどんで"],["いる"],["者","もの"],["が"],["、"],["多く","おおく"],["います"],["。"]]},{"verse":3,"text":"恐れのある日に、私は、あなたに信頼します。","tok":[["恐れ","おそれ"],["の"],["ある"],["日","ひ"],["に"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["に"],["信頼","しんらい"],["します"],["。"]]},{"verse":4,"text":"神にあって、私はみことばを、ほめたたえます。私は神に信頼し、何も恐れません。肉なる者が、私に何をなしえましょう。","tok":[["神","かみ"],["に"],["あって"],["、"],["私","わたくし"],["は"],["みことば"],["を"],["、"],["ほめたたえます"],["。"],["私","わたくし"],["は"],["神","かみ"],["に"],["信頼","しんらい"],["し"],["、"],["何","なん"],["も"],["恐れません","おそれません"],["。"],["肉","にく"],["なる"],["者","もの"],["が"],["、"],["私","わたくし"],["に"],["何","なん"],["を"],["なし"],["えましょう"],["。"]]},{"verse":5,"text":"一日中、彼らは私のことばを痛めつけています。彼らの思い計ることはみな、私にわざわいを加えることです。","tok":[["一","いち"],["日中","にちちゅう"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["の"],["ことば"],["を"],["痛めつけて","いためつけて"],["います"],["。"],["彼","かれ"],["ら"],["の"],["思い計る","おもいはかる"],["こと"],["は"],["みな"],["、"],["私","わたくし"],["に"],["わざわい"],["を"],["加える","くわえる"],["こと"],["です"],["。"]]},{"verse":6,"text":"彼らは襲い、彼らは待ち伏せ、私のあとをつけています。私のいのちをねらっているように。","tok":[["彼","かれ"],["ら"],["は"],["襲い","おそい"],["、"],["彼","かれ"],["ら"],["は"],["待ち伏せ","まちぶせ"],["、"],["私","わたくし"],["の"],["あと"],["を"],["つけて"],["います"],["。"],["私","わたくし"],["の"],["いのち"],["を"],["ねらって"],["いる"],["よう"],["に"],["。"]]},{"verse":7,"text":"神よ。彼らの不法のゆえに、彼らを投げつけてください。御怒りをもって、国々の民を打ち倒してください。","tok":[["神","かみ"],["よ"],["。"],["彼","かれ"],["ら"],["の"],["不法","ふほう"],["の"],["ゆえ"],["に"],["、"],["彼","かれ"],["ら"],["を"],["投げつけて","なげつけて"],["ください"],["。"],["御怒り","おいかり"],["を"],["もって"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["打ち倒して","うちたおして"],["ください"],["。"]]},{"verse":8,"text":"あなたは、私のさすらいをしるしておられます。どうか私の涙を、あなたの皮袋にたくわえてください。それはあなたの書には、ないのでしょうか。","tok":[["あなた"],["は"],["、"],["私","わたくし"],["の"],["さすらい"],["を"],["しるして"],["おられます"],["。"],["どう"],["か"],["私","わたくし"],["の"],["涙","なみだ"],["を"],["、"],["あなた"],["の"],["皮袋","かわぶくろ"],["に"],["たくわえて"],["ください"],["。"],["それ"],["は"],["あなた"],["の"],["書","しょ"],["に"],["は"],["、"],["ない"],["の"],["でしょう"],["か"],["。"]]},{"verse":9,"text":"それで、私が呼ばわる日に、私の敵は退きます。神が私の味方であることを私は知っています。","tok":[["それ"],["で"],["、"],["私","わたくし"],["が"],["呼ばわる","よばわる"],["日","ひ"],["に"],["、"],["私","わたくし"],["の"],["敵","てき"],["は"],["退きます","しりぞきます"],["。"],["神","かみ"],["が"],["私","わたくし"],["の"],["味方","みかた"],["で"],["ある"],["こと"],["を"],["私","わたくし"],["は"],["知って","しって"],["います"],["。"]]},{"verse":10,"text":"神にあって、私はみことばをほめたたえます。主にあって、私はみことばをほめたたえます。","tok":[["神","かみ"],["に"],["あって"],["、"],["私","わたくし"],["は"],["みことば"],["を"],["ほめたたえます"],["。"],["主に","おもに"],["あって"],["、"],["私","わたくし"],["は"],["みことば"],["を"],["ほめたたえます"],["。"]]},{"verse":11,"text":"私は、神に信頼しています。それゆえ、恐れません。人が、私に何をなしえましょう。","tok":[["私","わたくし"],["は"],["、"],["神","かみ"],["に"],["信頼","しんらい"],["して"],["います"],["。"],["それ"],["ゆえ"],["、"],["恐れません","おそれません"],["。"],["人","ひと"],["が"],["、"],["私","わたくし"],["に"],["何","なん"],["を"],["なし"],["えましょう"],["。"]]},{"verse":12,"text":"神よ。あなたへの誓いは、私の上にあります。私は、感謝のいけにえを、あなたにささげます。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["へ"],["の"],["誓い","ちかい"],["は"],["、"],["私","わたくし"],["の"],["上","うえ"],["に"],["あります"],["。"],["私","わたくし"],["は"],["、"],["感謝","かんしゃ"],["の"],["いけにえ"],["を"],["、"],["あなた"],["に"],["ささげます"],["。"]]},{"verse":13,"text":"あなたは、私のいのちを死から、まことに私の足を、つまずきから、救い出してくださいました。それは、私が、いのちの光のうちに、神の御前を歩むためでした。","tok":[["あなた"],["は"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["死","し"],["から"],["、"],["まこと"],["に"],["私","わたくし"],["の"],["足","あし"],["を"],["、"],["つまずき"],["から"],["、"],["救い出して","すくいだして"],["くださいました"],["。"],["それ"],["は"],["、"],["私","わたくし"],["が"],["、"],["いのち"],["の"],["光","ひかり"],["の"],["うち"],["に"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["を"],["歩む","あゆむ"],["ため"],["でした"],["。"]]}]
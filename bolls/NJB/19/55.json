[{"verse":1,"text":"（指揮者のために。弦楽器に合わせて。ダビデのマスキール）神よ。私の祈りを耳に入れ、私の切なる願いから、身を隠さないでください。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["弦楽器","げんがっき"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["マスキール"],["）"],["神","かみ"],["よ"],["。"],["私","わたくし"],["の"],["祈り","いのり"],["を"],["耳","みみ"],["に"],["入れ","いれ"],["、"],["私","わたくし"],["の"],["切","せつ"],["なる"],["願い","ねがい"],["から"],["、"],["身","み"],["を"],["隠さないで","かくさないで"],["ください"],["。"]]},{"verse":2,"text":"私に御心を留め、私に答えてください。私は苦しんで、心にうめき、泣きわめいています。","tok":[["私","わたくし"],["に"],["御心","おこころ"],["を"],["留め","とめ"],["、"],["私","わたくし"],["に"],["答えて","こたえて"],["ください"],["。"],["私","わたくし"],["は"],["苦しんで","くるしんで"],["、"],["心","こころ"],["に"],["うめき"],["、"],["泣きわめいて","なきわめいて"],["います"],["。"]]},{"verse":3,"text":"それは敵の叫びと、悪者の迫害のためです。彼らは私にわざわいを投げかけ、激しい怒りをもって私に恨みをいだいています。","tok":[["それ"],["は"],["敵","てき"],["の"],["叫び","さけび"],["と"],["、"],["悪者","わるもの"],["の"],["迫害","はくがい"],["の"],["ため"],["です"],["。"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["に"],["わざわい"],["を"],["投げかけ","なげかけ"],["、"],["激しい","はげしい"],["怒り","いかり"],["を"],["もって"],["私","わたくし"],["に"],["恨み","うらみ"],["を"],["いだいて"],["います"],["。"]]},{"verse":4,"text":"私の心は、うちにもだえ、死の恐怖が、私を襲っています。","tok":[["私","わたくし"],["の"],["心","こころ"],["は"],["、"],["うち"],["に"],["もだえ"],["、"],["死","し"],["の"],["恐怖","きょうふ"],["が"],["、"],["私","わたくし"],["を"],["襲って","おそって"],["います"],["。"]]},{"verse":5,"text":"恐れとおののきが私に臨み、戦慄が私を包みました。","tok":[["恐れ","おそれ"],["と"],["おののき"],["が"],["私","わたくし"],["に"],["臨み","のぞみ"],["、"],["戦慄","せんりつ"],["が"],["私","わたくし"],["を"],["包みました","つつみました"],["。"]]},{"verse":6,"text":"そこで私は言いました。「ああ、私に鳩のように翼があったなら。そうしたら、飛び去って、休むものを。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["言いました","いいました"],["。"],["「"],["ああ"],["、"],["私","わたくし"],["に"],["鳩","はと"],["の"],["よう"],["に"],["翼","つばさ"],["が"],["あったなら"],["。"],["そう"],["したら"],["、"],["飛び去って","とびさって"],["、"],["休む","やすむ"],["もの"],["を"],["。"]]},{"verse":7,"text":"ああ、私は遠くの方へのがれ去り、荒野の中に宿りたい。セラ","tok":[["ああ"],["、"],["私","わたくし"],["は"],["遠く","とおく"],["の"],["方","ほう"],["へ"],["のがれ"],["去り","さり"],["、"],["荒野","こうや"],["の"],["中","なか"],["に"],["宿りたい","やどりたい"],["。"],["セラ"]]},{"verse":8,"text":"あらしとはやてを避けて、私ののがれ場に急ぎたい。」","tok":[["あらし"],["と"],["はやて"],["を"],["避けて","さけて"],["、"],["私","わたくし"],["の"],["の"],["がれ場","がれば"],["に"],["急ぎたい","いそぎたい"],["。"],["」"]]},{"verse":9,"text":"主よ。どうか、彼らのことばを混乱させ、分裂させてください。私はこの町の中に暴虐と争いを見ています。","tok":[["主","ぬし"],["よ"],["。"],["どう"],["か"],["、"],["彼","かれ"],["ら"],["の"],["ことば"],["を"],["混乱","こんらん"],["させ"],["、"],["分裂","ぶんれつ"],["させて"],["ください"],["。"],["私","わたくし"],["は"],["この"],["町","まち"],["の"],["中","なか"],["に"],["暴虐","ぼうぎゃく"],["と"],["争い","あらそい"],["を"],["見て","みて"],["います"],["。"]]},{"verse":10,"text":"彼らは昼も夜も、町の城壁の上を歩き回り、町の真ん中には、罪悪と害毒があります。","tok":[["彼","かれ"],["ら"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["、"],["町","まち"],["の"],["城壁","じょうへき"],["の"],["上","うえ"],["を"],["歩き回り","あるきまわり"],["、"],["町","まち"],["の"],["真ん中","まんなか"],["に"],["は"],["、"],["罪悪","ざいあく"],["と"],["害毒","がいどく"],["が"],["あります"],["。"]]},{"verse":11,"text":"破滅は町の真ん中にあり、虐待と詐欺とは、その市場から離れません。","tok":[["破滅","はめつ"],["は"],["町","まち"],["の"],["真ん中","まんなか"],["に"],["あり"],["、"],["虐待","ぎゃくたい"],["と"],["詐欺","さぎ"],["と"],["は"],["、"],["その"],["市場","しじょう"],["から"],["離れません","はなれません"],["。"]]},{"verse":12,"text":"まことに、私をそしる者が敵ではありません。それなら私は忍べたでしょう。私に向かって高ぶる者が私を憎む者ではありません。それなら私は、彼から身を隠したでしょう。","tok":[["まこと"],["に"],["、"],["私","わたくし"],["を"],["そしる"],["者","もの"],["が"],["敵","てき"],["で"],["は"],["ありません"],["。"],["それ"],["なら"],["私","わたくし"],["は"],["忍べたでしょう","しのべたでしょう"],["。"],["私","わたくし"],["に"],["向かって","むかって"],["高ぶる","たかぶる"],["者","もの"],["が"],["私","わたくし"],["を"],["憎む","にくむ"],["者","もの"],["で"],["は"],["ありません"],["。"],["それ"],["なら"],["私","わたくし"],["は"],["、"],["彼","かれ"],["から"],["身","み"],["を"],["隠したでしょう","かくしたでしょう"],["。"]]},{"verse":13,"text":"そうではなくて、おまえが。私の同輩、私の友、私の親友のおまえが。","tok":[["そう"],["で"],["は"],["なくて"],["、"],["おまえ"],["が"],["。"],["私","わたくし"],["の"],["同輩","どうはい"],["、"],["私","わたくし"],["の"],["友","とも"],["、"],["私","わたくし"],["の"],["親友","しんゆう"],["の"],["おまえ"],["が"],["。"]]},{"verse":14,"text":"私たちは、いっしょに仲良く語り合い、神の家に群れといっしょに歩いて行ったのに。","tok":[["私たち","わたしたち"],["は"],["、"],["いっしょ"],["に"],["仲良く","なかよく"],["語り合い","かたりあい"],["、"],["神","かみ"],["の"],["家","いえ"],["に"],["群れ","むれ"],["と"],["いっしょ"],["に"],["歩いて","あるいて"],["行った","いった"],["のに"],["。"]]},{"verse":15,"text":"死が、彼らをつかめばよい。彼らが生きたまま、よみに下るがよい。悪が、彼らの住まいの中、彼らのただ中にあるから。","tok":[["死","し"],["が"],["、"],["彼","かれ"],["ら"],["を"],["つかめば"],["よい"],["。"],["彼","かれ"],["ら"],["が"],["生きた","いきた"],["まま"],["、"],["よみ"],["に"],["下る","くだる"],["が"],["よい"],["。"],["悪","あく"],["が"],["、"],["彼","かれ"],["ら"],["の"],["住まい","すまい"],["の"],["中","なか"],["、"],["彼","かれ"],["ら"],["の"],["ただ中","ただなか"],["に"],["ある"],["から"],["。"]]},{"verse":16,"text":"私が、神に呼ばわると、主は私を救ってくださる。","tok":[["私","わたくし"],["が"],["、"],["神","かみ"],["に"],["呼ばわる","よばわる"],["と"],["、"],["主","ぬし"],["は"],["私","わたくし"],["を"],["救って","すくって"],["くださる"],["。"]]},{"verse":17,"text":"夕、朝、真昼、私は嘆き、うめく。すると、主は私の声を聞いてくださる。","tok":[["夕","ゆう"],["、"],["朝","あさ"],["、"],["真昼","まひる"],["、"],["私","わたくし"],["は"],["嘆き","なげき"],["、"],["うめく"],["。"],["する"],["と"],["、"],["主","ぬし"],["は"],["私","わたくし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["くださる"],["。"]]},{"verse":18,"text":"主は、私のたましいを、敵の挑戦から、平和のうちに贖い出してくださる。私と争う者が多いから。","tok":[["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["たましい"],["を"],["、"],["敵","てき"],["の"],["挑戦","ちょうせん"],["から"],["、"],["平和","へいわ"],["の"],["うち"],["に"],["贖い","あがない"],["出して","だして"],["くださる"],["。"],["私","わたくし"],["と"],["争う","あらそう"],["者","もの"],["が"],["多い","おおい"],["から"],["。"]]},{"verse":19,"text":"神は聞き、彼らを悩まされる。昔から王座に着いている者をも。セラ彼らは改めず、彼らは神を恐れない。","tok":[["神","かみ"],["は"],["聞き","きき"],["、"],["彼","かれ"],["ら"],["を"],["悩まされる","なやまされる"],["。"],["昔","むかし"],["から"],["王座","おうざ"],["に"],["着いて","ついて"],["いる"],["者","もの"],["を"],["も"],["。"],["セラ"],["彼","かれ"],["ら"],["は"],["改めず","あらためず"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["を"],["恐れない","おそれない"],["。"]]},{"verse":20,"text":"彼は、自分の親しい者にまで手を伸ばし、自分の誓約を破った。","tok":[["彼","かれ"],["は"],["、"],["自分","じぶん"],["の"],["親しい","したしい"],["者","もの"],["に"],["まで"],["手","て"],["を"],["伸ばし","のばし"],["、"],["自分","じぶん"],["の"],["誓約","せいやく"],["を"],["破った","やぶった"],["。"]]},{"verse":21,"text":"彼の口は、バタよりもなめらかだが、その心には、戦いがある。彼のことばは、油よりも柔らかいが、それは抜き身の剣である。","tok":[["彼","かれ"],["の"],["口","くち"],["は"],["、"],["バタ"],["より"],["も"],["なめらか"],["だ"],["が"],["、"],["その"],["心","こころ"],["に"],["は"],["、"],["戦い","たたかい"],["が"],["ある"],["。"],["彼","かれ"],["の"],["ことば"],["は"],["、"],["油","あぶら"],["より"],["も"],["柔らかい","やわらかい"],["が"],["、"],["それ"],["は"],["抜き身","ぬきみ"],["の"],["剣","けん"],["で"],["ある"],["。"]]},{"verse":22,"text":"あなたの重荷を主にゆだねよ。主は、あなたのことを心配してくださる。主は決して、正しい者がゆるがされるようにはなさらない。","tok":[["あなた"],["の"],["重荷","おもに"],["を"],["主に","おもに"],["ゆだね"],["よ"],["。"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["こと"],["を"],["心配","しんぱい"],["して"],["くださる"],["。"],["主","ぬし"],["は"],["決して","けっして"],["、"],["正しい","ただしい"],["者","もの"],["が"],["ゆるがされる"],["よう"],["に"],["は"],["なさらない"],["。"]]},{"verse":23,"text":"しかし、神よ。あなたは彼らを、滅びの穴に落とされましょう。血を流す者と欺く者どもは、おのれの日数の半ばも生きながらえないでしょう。けれども、私は、あなたに拠り頼みます。","tok":[["しかし"],["、"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["、"],["滅び","ほろび"],["の"],["穴","あな"],["に"],["落とされましょう","おとされましょう"],["。"],["血","ち"],["を"],["流す","ながす"],["者","もの"],["と"],["欺く","あざむく"],["者","もの"],["ども"],["は"],["、"],["おのれ"],["の"],["日数","にっすう"],["の"],["半ば","なかば"],["も"],["生きながらえないでしょう","いきながらえないでしょう"],["。"],["けれど"],["も"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["に"],["拠り","より"],["頼みます","たのみます"],["。"]]}]
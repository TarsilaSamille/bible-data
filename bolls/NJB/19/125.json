[{"verse":1,"text":"（都上りの歌）主に信頼する人々はシオンの山のようだ。ゆるぐことなく、とこしえにながらえる。","tok":[["（"],["都上り","みやこのぼり"],["の"],["歌","うた"],["）"],["主に","おもに"],["信頼","しんらい"],["する"],["人々","ひとびと"],["は"],["シオン"],["の"],["山","やま"],["の"],["よう"],["だ"],["。"],["ゆるぐ"],["こと"],["なく"],["、"],["とこしえ"],["に"],["ながらえる"],["。"]]},{"verse":2,"text":"山々がエルサレムを取り囲むように、主は御民を今よりとこしえまでも囲まれる。","tok":[["山々","やまやま"],["が"],["エルサレム"],["を"],["取り囲む","とりかこむ"],["よう"],["に"],["、"],["主","ぬし"],["は"],["御民","ごみん"],["を"],["今","いま"],["より"],["とこしえ"],["まで"],["も"],["囲まれる","かこまれる"],["。"]]},{"verse":3,"text":"悪の杖が正しい者の地所の上にとどまることなく、正しい者が不正なことに、手を伸ばさないためである。","tok":[["悪","あく"],["の"],["杖","つえ"],["が"],["正しい","ただしい"],["者","もの"],["の"],["地所","じしょ"],["の"],["上","うえ"],["に"],["とどまる"],["こと"],["なく"],["、"],["正しい","ただしい"],["者","もの"],["が"],["不正","ふせい"],["な"],["こと"],["に"],["、"],["手","て"],["を"],["伸ばさない","のばさない"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"主よ。善良な人々や心の直ぐな人々に、いつくしみを施してください。","tok":[["主","ぬし"],["よ"],["。"],["善良","ぜんりょう"],["な"],["人々","ひとびと"],["や"],["心","こころ"],["の"],["直ぐ","すぐ"],["な"],["人々","ひとびと"],["に"],["、"],["いつくしみ"],["を"],["施して","ほどこして"],["ください"],["。"]]},{"verse":5,"text":"しかし、主は、曲がった道にそれる者どもを不法を行う者どもとともに、連れ去られよう。イスラエルの上に平和があるように。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["、"],["曲がった","まがった"],["道","みち"],["に"],["それる"],["者","もの"],["ども"],["を"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["ども"],["と"],["とも"],["に"],["、"],["連れ去られよう","つれさられよう"],["。"],["イスラエル"],["の"],["上","うえ"],["に"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"ハレルヤ。主の御名をほめたたえよ。ほめたたえよ。主のしもべたち。","tok":[["ハレルヤ"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["ほめたたえ"],["よ"],["。"],["ほめたたえ"],["よ"],["。"],["主","ぬし"],["の"],["しもべ"],["たち"],["。"]]},{"verse":2,"text":"主の家で仕え、私たちの神の家の大庭で仕える者よ。","tok":[["主","ぬし"],["の"],["家","いえ"],["で"],["仕え","つかえ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["家","いえ"],["の"],["大庭","おおば"],["で"],["仕える","つかえる"],["者","もの"],["よ"],["。"]]},{"verse":3,"text":"ハレルヤ。主はまことにいつくしみ深い。主の御名にほめ歌を歌え。その御名はいかにも麗しい。","tok":[["ハレルヤ"],["。"],["主","ぬし"],["は"],["まこと"],["に"],["いつくしみ"],["深い","ぶかい"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["に"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["。"],["その"],["御名","ぎょめい"],["は"],["いかに"],["も"],["麗しい","うるわしい"],["。"]]},{"verse":4,"text":"まことに、主はヤコブを選び、ご自分のものとされ、イスラエルを選んで、ご自分の宝とされた。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["ヤコブ"],["を"],["選び","えらび"],["、"],["ご自分","ごじぶん"],["の"],["もの"],["と"],["され"],["、"],["イスラエル"],["を"],["選んで","えらんで"],["、"],["ご自分","ごじぶん"],["の"],["宝","たから"],["と"],["された"],["。"]]},{"verse":5,"text":"まことに、私は知る。主は大いなる方、私たちの主はすべての神々にまさっておられる。","tok":[["まこと"],["に"],["、"],["私","わたくし"],["は"],["知る","しる"],["。"],["主","ぬし"],["は"],["大いなる","おおいなる"],["方","かた"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["は"],["すべて"],["の"],["神々","かみがみ"],["に"],["まさって"],["おられる"],["。"]]},{"verse":6,"text":"主は望むところをことごとく行われる。天で、地で、海で、またすべての淵で。","tok":[["主","ぬし"],["は"],["望む","のぞむ"],["ところ"],["を"],["ことごとく"],["行われる","おこなわれる"],["。"],["天","てん"],["で"],["、"],["地","ち"],["で"],["、"],["海","うみ"],["で"],["、"],["また"],["すべて"],["の"],["淵","ふち"],["で"],["。"]]},{"verse":7,"text":"主は地の果てから、雲を上らせ、雨のためにいなずまを造り、その倉から風を出される。","tok":[["主","ぬし"],["は"],["地","ち"],["の"],["果て","はて"],["から"],["、"],["雲","くも"],["を"],["上らせ","のぼらせ"],["、"],["雨","あめ"],["の"],["ため"],["に"],["いなずま"],["を"],["造り","つくり"],["、"],["その"],["倉","くら"],["から"],["風","かぜ"],["を"],["出される","だされる"],["。"]]},{"verse":8,"text":"主はエジプトの初子を人から獣に至るまで打たれた。","tok":[["主","ぬし"],["は"],["エジプト"],["の"],["初子","ういご"],["を"],["人","ひと"],["から"],["獣","けもの"],["に"],["至る","いたる"],["まで"],["打たれた","うたれた"],["。"]]},{"verse":9,"text":"エジプトよ。おまえの真っただ中に、主はしるしと奇蹟を送られた。パロとそのすべてのしもべらに。","tok":[["エジプト"],["よ"],["。"],["おまえ"],["の"],["真っただ中","まっただなか"],["に"],["、"],["主","ぬし"],["は"],["しるし"],["と"],["奇蹟","きせき"],["を"],["送られた","おくられた"],["。"],["パロ"],["と"],["その"],["すべて"],["の"],["しもべ"],["ら"],["に"],["。"]]},{"verse":10,"text":"主は多くの国々を打ち、力ある王たちを殺された。","tok":[["主","ぬし"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["を"],["打ち","うち"],["、"],["力","ちから"],["ある"],["王","おう"],["たち"],["を"],["殺された","ころされた"],["。"]]},{"verse":11,"text":"エモリ人の王シホン、バシャンの王オグ、カナンのすべての王国を。","tok":[["エモリ人","えもりにん"],["の"],["王","おう"],["シホン"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["、"],["カナン"],["の"],["すべて"],["の"],["王国","おうこく"],["を"],["。"]]},{"verse":12,"text":"主は彼らの地を、相続の地とし、御民イスラエルに相続の地として与えられた。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["地","ち"],["を"],["、"],["相続","そうぞく"],["の"],["地","ち"],["と"],["し"],["、"],["御民","ごみん"],["イスラエル"],["に"],["相続","そうぞく"],["の"],["地","ち"],["として"],["与えられた","あたえられた"],["。"]]},{"verse":13,"text":"主よ。あなたの御名はとこしえまで、主よ。あなたの呼び名は代々に及びます。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["の"],["御名","ぎょめい"],["は"],["とこしえ"],["まで"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["呼び名","よびな"],["は"],["代々","だいだい"],["に"],["及びます","およびます"],["。"]]},{"verse":14,"text":"まことに、主はご自分の民をさばき、そのしもべらをあわれまれます。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["さばき"],["、"],["その"],["しもべ"],["ら"],["を"],["あわれまれます"],["。"]]},{"verse":15,"text":"異邦の民の偶像は、銀や金で、人の手のわざです。","tok":[["異邦","いほう"],["の"],["民","たみ"],["の"],["偶像","ぐうぞう"],["は"],["、"],["銀","ぎん"],["や"],["金","かね"],["で"],["、"],["人","ひと"],["の"],["手","て"],["の"],["わざ"],["です"],["。"]]},{"verse":16,"text":"口があっても語れず、目があっても見えません。","tok":[["口","くち"],["が"],["あって"],["も"],["語れず","かたれず"],["、"],["目","め"],["が"],["あって"],["も"],["見えません","みえません"],["。"]]},{"verse":17,"text":"耳があっても聞こえず、また、その口には息がありません。","tok":[["耳","みみ"],["が"],["あって"],["も"],["聞こえず","きこえず"],["、"],["また"],["、"],["その"],["口","くち"],["に"],["は"],["息","いき"],["が"],["ありません"],["。"]]},{"verse":18,"text":"これを造る者もこれに信頼する者もみな、これと同じです。","tok":[["これ"],["を"],["造る","つくる"],["者","もの"],["も"],["これ"],["に"],["信頼","しんらい"],["する"],["者","もの"],["も"],["みな"],["、"],["これ"],["と"],["同じ","おなじ"],["です"],["。"]]},{"verse":19,"text":"イスラエルの家よ。主をほめたたえよ。アロンの家よ。主をほめたたえよ。","tok":[["イスラエル"],["の"],["家","いえ"],["よ"],["。"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["アロン"],["の"],["家","いえ"],["よ"],["。"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":20,"text":"レビの家よ。主をほめたたえよ。主を恐れる者よ。主をほめたたえよ。","tok":[["レビ"],["の"],["家","いえ"],["よ"],["。"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"],["主","ぬし"],["を"],["恐れる","おそれる"],["者","もの"],["よ"],["。"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":21,"text":"ほむべきかな。主。シオンにて。エルサレムに住む方。ハレルヤ。","tok":[["ほ"],["むべき"],["か"],["な"],["。"],["主","ぬし"],["。"],["シオン"],["にて"],["。"],["エルサレム"],["に"],["住む","すむ"],["方","ほう"],["。"],["ハレルヤ"],["。"]]}]
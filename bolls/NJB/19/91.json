[{"verse":1,"text":"いと高き方の隠れ場に住む者は、全能者の陰に宿る。","tok":[["いと"],["高き","たかき"],["方","ほう"],["の"],["隠れ場","かくれば"],["に"],["住む","すむ"],["者","もの"],["は"],["、"],["全能者","ぜんのうしゃ"],["の"],["陰","かげ"],["に"],["宿る","やどる"],["。"]]},{"verse":2,"text":"私は主に申し上げよう。「わが避け所、わがとりで、私の信頼するわが神」と。","tok":[["私","わたくし"],["は"],["主に","おもに"],["申し上げよう","もうしあげよう"],["。"],["「"],["わが"],["避け","さけ"],["所","しょ"],["、"],["わが"],["とり"],["で"],["、"],["私","わたくし"],["の"],["信頼","しんらい"],["する"],["わが"],["神","かみ"],["」"],["と"],["。"]]},{"verse":3,"text":"主は狩人のわなから、恐ろしい疫病から、あなたを救い出されるからである。","tok":[["主","ぬし"],["は"],["狩人","かりゅうど"],["の"],["わな"],["から"],["、"],["恐ろしい","おそろしい"],["疫病","やくびょう"],["から"],["、"],["あなた"],["を"],["救い出される","すくいだされる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"主は、ご自分の羽で、あなたをおおわれる。あなたは、その翼の下に身を避ける。主の真実は、大盾であり、とりでである。","tok":[["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["の"],["羽","はね"],["で"],["、"],["あなた"],["を"],["おおわれる"],["。"],["あなた"],["は"],["、"],["その"],["翼","つばさ"],["の"],["下","した"],["に"],["身","み"],["を"],["避ける","さける"],["。"],["主","ぬし"],["の"],["真実","しんじつ"],["は"],["、"],["大","だい"],["盾","たて"],["で"],["あり"],["、"],["とりで"],["で"],["ある"],["。"]]},{"verse":5,"text":"あなたは夜の恐怖も恐れず、昼に飛び来る矢も恐れない。","tok":[["あなた"],["は"],["夜","よる"],["の"],["恐怖","きょうふ"],["も"],["恐れず","おそれず"],["、"],["昼","ひる"],["に"],["飛び","とび"],["来る","くる"],["矢","や"],["も"],["恐れない","おそれない"],["。"]]},{"verse":6,"text":"また、暗やみに歩き回る疫病も、真昼に荒らす滅びをも。","tok":[["また"],["、"],["暗やみ","くらやみ"],["に"],["歩き回る","あるきまわる"],["疫病","やくびょう"],["も"],["、"],["真昼","まひる"],["に"],["荒らす","あらす"],["滅び","ほろび"],["を"],["も"],["。"]]},{"verse":7,"text":"千人が、あなたのかたわらに、万人が、あなたの右手に倒れても、それはあなたには、近づかない。","tok":[["千人","せんにん"],["が"],["、"],["あなた"],["の"],["かたわら"],["に"],["、"],["万人","ばんにん"],["が"],["、"],["あなた"],["の"],["右手","みぎて"],["に"],["倒れて","たおれて"],["も"],["、"],["それ"],["は"],["あなた"],["に"],["は"],["、"],["近づかない","ちかづかない"],["。"]]},{"verse":8,"text":"あなたはただ、それを目にし、悪者への報いを見るだけである。","tok":[["あなた"],["は"],["ただ"],["、"],["それ"],["を"],["目","め"],["に"],["し"],["、"],["悪者","わるもの"],["へ"],["の"],["報い","むくい"],["を"],["見る","みる"],["だけ"],["で"],["ある"],["。"]]},{"verse":9,"text":"それはあなたが私の避け所である主を、いと高き方を、あなたの住まいとしたからである。","tok":[["それ"],["は"],["あなた"],["が"],["私","わたくし"],["の"],["避け","さけ"],["所","ところ"],["で"],["ある"],["主","ぬし"],["を"],["、"],["いと"],["高き","たかき"],["方","ほう"],["を"],["、"],["あなた"],["の"],["住まい","すまい"],["と"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"わざわいは、あなたにふりかからず、えやみも、あなたの天幕に近づかない。","tok":[["わざわい"],["は"],["、"],["あなた"],["に"],["ふりかからず"],["、"],["え"],["やみ"],["も"],["、"],["あなた"],["の"],["天幕","てんまく"],["に"],["近づかない","ちかづかない"],["。"]]},{"verse":11,"text":"まことに主は、あなたのために、御使いたちに命じて、すべての道で、あなたを守るようにされる。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["ため"],["に"],["、"],["御使い","おつかい"],["たち"],["に"],["命じて","めいじて"],["、"],["すべて"],["の"],["道","みち"],["で"],["、"],["あなた"],["を"],["守る","まもる"],["よう"],["に"],["される"],["。"]]},{"verse":12,"text":"彼らは、その手で、あなたをささえ、あなたの足が石に打ち当たることのないようにする。","tok":[["彼","かれ"],["ら"],["は"],["、"],["その"],["手","て"],["で"],["、"],["あなた"],["を"],["ささえ"],["、"],["あなた"],["の"],["足","あし"],["が"],["石","いし"],["に"],["打ち当たる","うちあたる"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["。"]]},{"verse":13,"text":"あなたは、獅子とコブラとを踏みつけ、若獅子と蛇とを踏みにじろう。","tok":[["あなた"],["は"],["、"],["獅子","しし"],["と"],["コブラ"],["と"],["を"],["踏みつけ","ふみつけ"],["、"],["若","わか"],["獅子","しし"],["と"],["蛇","へび"],["と"],["を"],["踏みにじろう","ふみにじろう"],["。"]]},{"verse":14,"text":"彼がわたしを愛しているから、わたしは彼を助け出そう。彼がわたしの名を知っているから、わたしは彼を高く上げよう。","tok":[["彼","かれ"],["が"],["わたし"],["を"],["愛して","あいして"],["いる"],["から"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["助け出そう","たすけだそう"],["。"],["彼","かれ"],["が"],["わたし"],["の"],["名","な"],["を"],["知って","しって"],["いる"],["から"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["高く","たかく"],["上げよう","あげよう"],["。"]]},{"verse":15,"text":"彼が、わたしを呼び求めれば、わたしは、彼に答えよう。わたしは苦しみのときに彼とともにいて、彼を救い彼に誉れを与えよう。","tok":[["彼","かれ"],["が"],["、"],["わたし"],["を"],["呼び求めれば","よびもとめれば"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["に"],["答えよう","こたえよう"],["。"],["わたし"],["は"],["苦しみ","くるしみ"],["の"],["とき"],["に"],["彼","かれ"],["と"],["とも"],["に"],["いて"],["、"],["彼","かれ"],["を"],["救い","すくい"],["彼","かれ"],["に"],["誉れ","ほまれ"],["を"],["与えよう","あ
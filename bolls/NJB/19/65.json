[{"verse":1,"text":"（指揮者のために。ダビデの賛歌。歌）神よ。あなたの御前には静けさがあり、シオンには賛美があります。あなたに誓いが果たされますように。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["。"],["歌","うた"],["）"],["神","かみ"],["よ"],["。"],["あなた"],["の"],["御前","ごぜん"],["に"],["は"],["静けさ","しずけさ"],["が"],["あり"],["、"],["シオン"],["に"],["は"],["賛美","さんび"],["が"],["あります"],["。"],["あなた"],["に"],["誓い","ちかい"],["が"],["果たされます","はたされます"],["よう"],["に"],["。"]]},{"verse":2,"text":"祈りを聞かれる方よ。みもとにすべての肉なる者が参ります。","tok":[["祈り","いのり"],["を"],["聞かれる","きかれる"],["方","かた"],["よ"],["。"],["みもと"],["に"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["が"],["参ります","まいります"],["。"]]},{"verse":3,"text":"咎が私を圧倒しています。しかし、あなたは、私たちのそむきの罪を赦してくださいます。","tok":[["咎","とが"],["が"],["私","わたくし"],["を"],["圧倒","あっとう"],["して"],["います"],["。"],["しかし"],["、"],["あなた"],["は"],["、"],["私たち","わたしたち"],["の"],["そむき"],["の"],["罪","つみ"],["を"],["赦して","ゆるして"],["くださいます"],["。"]]},{"verse":4,"text":"幸いなことよ。あなたが選び、近寄せられた人、あなたの大庭に住むその人は。私たちは、あなたの家、あなたの聖なる宮の良いもので満ち足りるでしょう。","tok":[["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["あなた"],["が"],["選び","えらび"],["、"],["近寄せられた","ちかよせられた"],["人","ひと"],["、"],["あなた"],["の"],["大庭","おおば"],["に"],["住む","すむ"],["その"],["人","ひと"],["は"],["。"],["私たち","わたしたち"],["は"],["、"],["あなた"],["の"],["家","いえ"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["宮","みや"],["の"],["良い","よい"],["もの"],["で"],["満ち足りるでしょう","みちたりるでしょう"],["。"]]},{"verse":5,"text":"私たちの救いの神よ。あなたは、恐ろしい事柄をもって、義のうちに私たちに答えられます。あなたは、地のすべての果て果て、遠い大海の、信頼の的です。","tok":[["私たち","わたしたち"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["、"],["恐ろしい","おそろしい"],["事柄","ことがら"],["を"],["もって"],["、"],["義","ぎ"],["の"],["うち"],["に"],["私たち","わたしたち"],["に"],["答えられます","こたえられます"],["。"],["あなた"],["は"],["、"],["地","ち"],["の"],["すべて"],["の"],["果て果て","はてはて"],["、"],["遠い","とおい"],["大海","たいかい"],["の"],["、"],["信頼","しんらい"],["の"],["的","まと"],["です"],["。"]]},{"verse":6,"text":"あなたは、御力によって山々を堅く建て、力を帯びておられます。","tok":[["あなた"],["は"],["、"],["御力","おちから"],["によって"],["山々","やまやま"],["を"],["堅く","かたく"],["建て","たて"],["、"],["力","ちから"],["を"],["帯びて","おびて"],["おられます"],["。"]]},{"verse":7,"text":"あなたは、海のとどろき、その大波のとどろき、また国々の民の騒ぎを静められます。","tok":[["あなた"],["は"],["、"],["海","うみ"],["の"],["とどろき"],["、"],["その"],["大波","おおなみ"],["の"],["とどろき"],["、"],["また"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["騒ぎ","さわぎ"],["を"],["静められます","しずめられます"],["。"]]},{"verse":8,"text":"地の果て果てに住む者もあなたの数々のしるしを恐れます。あなたは、朝と夕べの起こる所を、高らかに歌うようにされます。","tok":[["地","ち"],["の"],["果て果て","はてはて"],["に"],["住む","すむ"],["者","もの"],["も"],["あなた"],["の"],["数々","かずかず"],["の"],["しるし"],["を"],["恐れます","おそれます"],["。"],["あなた"],["は"],["、"],["朝","あさ"],["と"],["夕べ","ゆうべ"],["の"],["起こる","おこる"],["所","ところ"],["を"],["、"],["高らか","たからか"],["に"],["歌う","うたう"],["よう"],["に"],["されます"],["。"]]},{"verse":9,"text":"あなたは、地を訪れ、水を注ぎ、これを大いに豊かにされます。神の川は水で満ちています。あなたは、こうして地の下ごしらえをし、彼らの穀物を作ってくださいます。","tok":[["あなた"],["は"],["、"],["地","ち"],["を"],["訪れ","おとずれ"],["、"],["水","みず"],["を"],["注ぎ","そそぎ"],["、"],["これ"],["を"],["大いに","おおいに"],["豊か","ゆたか"],["に"],["されます"],["。"],["神","かみ"],["の"],["川","かわ"],["は"],["水","みず"],["で"],["満ちて","みちて"],["います"],["。"],["あなた"],["は"],["、"],["こう"],["して"],["地","ち"],["の"],["下ごしらえ","したごしらえ"],["を"],["し"],["、"],["彼","かれ"],["ら"],["の"],["穀物","こくもつ"],["を"],["作って","つくって"],["くださいます"],["。"]]},{"verse":10,"text":"地のあぜみぞを水で満たし、そのうねをならし、夕立で地を柔らかにし、その生長を祝福されます。","tok":[["地","ち"],["の"],["あぜみ"],["ぞ"],["を"],["水","みず"],["で"],["満たし","みたし"],["、"],["その"],["うね"],["を"],["ならし"],["、"],["夕立","ゆうだち"],["で"],["地","ち"],["を"],["柔らか","やわらか"],["に"],["し"],["、"],["その"],["生長","せいちょう"],["を"],["祝福","しゅくふく"],["されます"],["。"]]},{"verse":11,"text":"あなたは、その年に、御恵みの冠をかぶらせ、あなたの通られた跡にはあぶらがしたたっています。","tok":[["あなた"],["は"],["、"],["その"],["年","とし"],["に"],["、"],["御恵み","おめぐみ"],["の"],["冠","かんむり"],["を"],["かぶらせ"],["、"],["あなた"],["の"],["通られた","とおられた"],["跡","あと"],["に"],["は"],["あぶら"],["が"],["したたって"],["います"],["。"]]},{"verse":12,"text":"荒野の牧場はしたたり、もろもろの丘も喜びをまとっています。","tok":[["荒野","こうや"],["の"],["牧場","ぼくじょう"],["は"],["した"],["たり"],["、"],["もろもろ"],["の"],["丘","おか"],["も"],["喜び","よろこび"],["を"],["まとって"],["います"],["。"]]},{"verse":13,"text":"牧草地は羊の群れを着、もろもろの谷は穀物をおおいとしています。まことに喜び叫び、歌っています。","tok":[["牧草地","ぼくそうち"],["は"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["着","き"],["、"],["もろもろ"],["の"],["谷","たに"],["は"],["穀物","こくもつ"],["を"],["おおい"],["として"],["います"],["。"],["まこと"],["に"],["喜び叫び","よろこびさけび"],["、"],["歌って","うたって"],["います"],["。"]]}]
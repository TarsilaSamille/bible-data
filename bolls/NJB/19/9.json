[{"verse":1,"text":"（指揮者のために。「ムテ・ラベン」の調べに合わせて。ダビデの賛歌）私は心を尽くして主に感謝します。あなたの奇しいわざを余すことなく語り告げます。","tok":[["（"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["「"],["ムテ"],["・"],["ラベン"],["」"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["私","わたくし"],["は"],["心","こころ"],["を"],["尽くして","つくして"],["主に","おもに"],["感謝","かんしゃ"],["します"],["。"],["あなた"],["の"],["奇しい","くすしい"],["わざ"],["を"],["余す","あます"],["こと"],["なく"],["語り告げます","かたりつげます"],["。"]]},{"verse":2,"text":"私は、あなたを喜び、誇ります。いと高き方よ。あなたの御名をほめ歌います。","tok":[["私","わたくし"],["は"],["、"],["あなた"],["を"],["喜び","よろこび"],["、"],["誇ります","ほこります"],["。"],["いと"],["高き","たかき"],["方","かた"],["よ"],["。"],["あなた"],["の"],["御名","ぎょめい"],["を"],["ほめ"],["歌います","うたいます"],["。"]]},{"verse":3,"text":"私の敵は退くとき、つまずき、あなたの前で、ついえ去ります。","tok":[["私","わたくし"],["の"],["敵","てき"],["は"],["退く","しりぞく"],["とき"],["、"],["つまずき"],["、"],["あなた"],["の"],["前","まえ"],["で"],["、"],["ついえ去ります","ついえさります"],["。"]]},{"verse":4,"text":"あなたが私の正しい訴えを支持し、義の審判者として王座に着かれるからです。","tok":[["あなた"],["が"],["私","わたくし"],["の"],["正しい","ただしい"],["訴え","うったえ"],["を"],["支持","しじ"],["し"],["、"],["義","ぎ"],["の"],["審判者","しんぱんしゃ"],["として"],["王座","おうざ"],["に"],["着かれる","つかれる"],["から"],["です"],["。"]]},{"verse":5,"text":"あなたは国々をお叱りになり、悪者を滅ぼし、彼らの名を、とこしえに、消し去られました。","tok":[["あなた"],["は"],["国々","くにぐに"],["を"],["お叱り","おしかり"],["に"],["なり"],["、"],["悪者","わるもの"],["を"],["滅ぼし","ほろぼし"],["、"],["彼","かれ"],["ら"],["の"],["名","な"],["を"],["、"],["とこしえ"],["に"],["、"],["消し去られました","けしさられました"],["。"]]},{"verse":6,"text":"敵は、絶え果てて永遠の廃墟。あなたが根こぎにされた町々、その記憶さえ、消えうせました。","tok":[["敵","てき"],["は"],["、"],["絶え","たえ"],["果てて","はてて"],["永遠","えいえん"],["の"],["廃墟","はいきょ"],["。"],["あなた"],["が"],["根こぎ","ねこぎ"],["に"],["された"],["町々","まちまち"],["、"],["その"],["記憶","きおく"],["さえ"],["、"],["消えうせました","きえうせました"],["。"]]},{"verse":7,"text":"しかし、主はとこしえに御座に着き、さばきのためにご自身の王座を堅く立てられた。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["とこしえ"],["に"],["御座","ぎょざ"],["に"],["着き","つき"],["、"],["さばき"],["の"],["ため"],["に"],["ご自身","ごじしん"],["の"],["王座","おうざ"],["を"],["堅く","かたく"],["立てられた","たてられた"],["。"]]},{"verse":8,"text":"主は義によって世界をさばき、公正をもって国民にさばきを行われる。","tok":[["主","ぬし"],["は"],["義","ぎ"],["によって"],["世界","せかい"],["を"],["さばき"],["、"],["公正","こうせい"],["を"],["もって"],["国民","こくみん"],["に"],["さばき"],["を"],["行われる","おこなわれる"],["。"]]},{"verse":9,"text":"主はしいたげられた者のとりで、苦しみのときのとりで。","tok":[["主","ぬし"],["は"],["しいたげられた"],["者","もの"],["の"],["とり"],["で"],["、"],["苦しみ","くるしみ"],["の"],["とき"],["の"],["とり"],["で"],["。"]]},{"verse":10,"text":"御名を知る者はあなたに拠り頼みます。主よ。あなたはあなたを尋ね求める者をお見捨てになりませんでした。","tok":[["御名","ぎょめい"],["を"],["知る","しる"],["者","もの"],["は"],["あなた"],["に"],["拠り","より"],["頼みます","たのみます"],["。"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["あなた"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["を"],["お見捨て","おみすて"],["に"],["なりませんでした"],["。"]]},{"verse":11,"text":"主にほめ歌を歌え、シオンに住まうその方に。国々の民にみわざを告げ知らせよ。","tok":[["主に","おもに"],["ほめ歌","ほめうた"],["を"],["歌え","うたえ"],["、"],["シオン"],["に"],["住まう","すまう"],["その"],["方","かた"],["に"],["。"],["国々","くにぐに"],["の"],["民","たみ"],["に"],["みわざ"],["を"],["告げ知らせ","つげしらせ"],["よ"],["。"]]},{"verse":12,"text":"血に報いる方は、彼らを心に留め、貧しい者の叫びをお忘れにならない。","tok":[["血","ち"],["に"],["報いる","むくいる"],["方","かた"],["は"],["、"],["彼","かれ"],["ら"],["を"],["心","こころ"],["に"],["留め","とめ"],["、"],["貧しい","まずしい"],["者","もの"],["の"],["叫び","さけび"],["を"],["お忘れ","おわすれ"],["に"],["ならない"],["。"]]},{"verse":13,"text":"主よ。私をあわれんでください。私を憎む者から来る私の悩みを見てください。主は死の門から私を引き上げてくださる。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["を"],["あわれんで"],["ください"],["。"],["私","わたくし"],["を"],["憎む","にくむ"],["者","もの"],["から"],["来る","くる"],["私","わたくし"],["の"],["悩み","なやみ"],["を"],["見て","みて"],["ください"],["。"],["主","ぬし"],["は"],["死","し"],["の"],["門","もん"],["から"],["私","わたくし"],["を"],["引き上げて","ひきあげて"],["くださる"],["。"]]},{"verse":14,"text":"私は、あなたのすべての誉れを語り告げるために、シオンの娘の門で、あなたの救いに歓声をあげましょう。","tok":[["私","わたくし"],["は"],["、"],["あなた"],["の"],["すべて"],["の"],["誉れ","ほまれ"],["を"],["語り告げる","かたりつげる"],["ため"],["に"],["、"],["シオン"],["の"],["娘","むすめ"],["の"],["門","もん"],["で"],["、"],["あなた"],["の"],["救い","すくい"],["に"],["歓声","かんせい"],["を"],["あげましょう"],["。"]]},{"verse":15,"text":"国々はおのれの作った穴に陥り、おのれの隠した網に、わが足をとられる。","tok":[["国々","くにぐに"],["は"],["おのれ"],["の"],["作った","つくった"],["穴","あな"],["に"],["陥り","おちいり"],["、"],["おのれ"],["の"],["隠した","かくした"],["網","あみ"],["に"],["、"],["わが"],["足","あし"],["を"],["とられる"],["。"]]},{"verse":16,"text":"主はご自身を知らせ、さばきを行われた。悪者はおのれの手で作ったわなにかかった。ヒガヨンセラ","tok":[["主","ぬし"],["は"],["ご自身","ごじしん"],["を"],["知らせ","しらせ"],["、"],["さばき"],["を"],["行われた","おこなわれた"],["。"],["悪者","わるもの"],["は"],["おのれ"],["の"],["手","て"],["で"],["作った","つくった"],["わな"],["に"],["かかった"],["。"],["ヒガヨンセラ"]]},{"verse":17,"text":"悪者どもは、よみに帰って行く。神を忘れたあらゆる国々も。","tok":[["悪者","わるもの"],["ども"],["は"],["、"],["よみ"],["に"],["帰って","かえって"],["行く","いく"],["。"],["神","かみ"],["を"],["忘れた","わすれた"],["あらゆる"],["国々","くにぐに"],["も"],["。"]]},{"verse":18,"text":"貧しい者は決して忘れられない。悩む者の望みは、いつまでもなくならない。","tok":[["貧しい","まずしい"],["者","もの"],["は"],["決して","けっして"],["忘れられない","わすれられない"],["。"],["悩む","なやむ"],["者","もの"],["の"],["望み","のぞみ"],["は"],["、"],["いつ"],["まで"],["も"],["なくならない"],["。"]]},{"verse":19,"text":"主よ。立ち上がってください。人間が勝ち誇らないために。国々が御前で、さばかれるために。","tok":[["主","ぬし"],["よ"],["。"],["立ち上がって","たちあがって"],["ください"],["。"],["人間","にんげん"],["が"],["勝ち誇らない","かちほこらない"],["ため"],["に"],["。"],["国々","くにぐに"],["が"],["御前","ごぜん"],["で"],["、"],["さばかれる"],["ため"],["に"],["。"]]},{"verse":20,"text":"主よ。彼らに恐れを起こさせてください。おのれが、ただ、人間にすぎないことを、国々に思い知らせてください。セラ","tok":[["主","ぬし"],["よ"],["。"],["彼","かれ"],["ら"],["に"],["恐れ","おそれ"],["を"],["起こさせて","おこさせて"],["ください"],["。"],["おのれ"],["が"],["、"],["ただ"],["、"],["人間","にんげん"],["に"],["すぎない"],["こと"],["を"],["、"],["国々","くにぐに"],["に"],["思い知らせて","おもいしらせて"],["ください"],["。"],["セラ"]]}]
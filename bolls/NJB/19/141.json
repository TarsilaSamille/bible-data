[{"verse":1,"text":"（ダビデの賛歌）主よ。私はあなたを呼び求めます。私のところに急いでください。私があなたに呼ばわるとき、私の声を聞いてください。","tok":[["（"],["ダビデ"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["呼び求めます","よびもとめます"],["。"],["私","わたくし"],["の"],["ところ"],["に"],["急いで","いそいで"],["ください"],["。"],["私","わたくし"],["が"],["あなた"],["に"],["呼ばわる","よばわる"],["とき"],["、"],["私","わたくし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["ください"],["。"]]},{"verse":2,"text":"私の祈りが、御前への香として、私が手を上げることが、夕べのささげ物として立ち上りますように。","tok":[["私","わたくし"],["の"],["祈り","いのり"],["が"],["、"],["御前","ごぜん"],["へ"],["の"],["香","こう"],["として"],["、"],["私","わたくし"],["が"],["手","て"],["を"],["上げる","あげる"],["こと"],["が"],["、"],["夕べ","ゆうべ"],["の"],["ささげ物","ささげもの"],["として"],["立ち上ります","たちのぼります"],["よう"],["に"],["。"]]},{"verse":3,"text":"主よ。私の口に見張りを置き、私のくちびるの戸を守ってください。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["口","くち"],["に"],["見張り","みはり"],["を"],["置き","おき"],["、"],["私","わたくし"],["の"],["くちびる"],["の"],["戸","と"],["を"],["守って","まもって"],["ください"],["。"]]},{"verse":4,"text":"私の心を悪いことに向けさせず、不法を行う者どもとともに、悪い行いに携わらないようにしてください。私が彼らのうまい物を食べないようにしてください。","tok":[["私","わたくし"],["の"],["心","こころ"],["を"],["悪い","わるい"],["こと"],["に"],["向けさせず","むけさせず"],["、"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["ども"],["と"],["とも"],["に"],["、"],["悪い","わるい"],["行い","おこない"],["に"],["携わらない","たずさわらない"],["よう"],["に"],["して"],["ください"],["。"],["私","わたくし"],["が"],["彼","かれ"],["ら"],["の"],["うまい"],["物","もの"],["を"],["食べない","たべない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":5,"text":"正しい者が愛情をもって私を打ち、私を責めますように。それは頭にそそがれる油です。私の頭がそれを拒まないようにしてください。彼らが悪行を重ねても、なおも私は祈ります。","tok":[["正しい","ただしい"],["者","もの"],["が"],["愛情","あいじょう"],["を"],["もって"],["私","わたくし"],["を"],["打ち","うち"],["、"],["私","わたくし"],["を"],["責めます","せめます"],["よう"],["に"],["。"],["それ"],["は"],["頭","あたま"],["に"],["そそがれる"],["油","あぶら"],["です"],["。"],["私","わたくし"],["の"],["頭","あたま"],["が"],["それ"],["を"],["拒まない","こばまない"],["よう"],["に"],["して"],["ください"],["。"],["彼","かれ"],["ら"],["が"],["悪行","あくぎょう"],["を"],["重ねて","かさねて"],["も"],["、"],["なお"],["も"],["私","わたくし"],["は"],["祈ります","いのります"],["。"]]},{"verse":6,"text":"彼らのさばきづかさらが岩のかたわらに投げ落とされたとき、彼らは私のいかにも喜ばしいことばを聞くことでしょう。","tok":[["彼","かれ"],["ら"],["の"],["さばき"],["づかさ"],["ら"],["が"],["岩","いわ"],["の"],["かたわら"],["に"],["投げ落とされた","なげおとされた"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["の"],["いかに"],["も"],["喜ばしい","よろこばしい"],["ことば"],["を"],["聞く","きく"],["こと"],["でしょう"],["。"]]},{"verse":7,"text":"人が地を掘り起こして砕くときのように、私たちの骨はよみの入口にまき散らされました。","tok":[["人","ひと"],["が"],["地","ち"],["を"],["掘り起こして","ほりおこして"],["砕く","くだく"],["とき"],["の"],["よう"],["に"],["、"],["私たち","わたしたち"],["の"],["骨","ほね"],["は"],["よみ"],["の"],["入口","いりぐち"],["に"],["まき散らされました","まきちらされました"],["。"]]},{"verse":8,"text":"私の主、神よ。まことに、私の目はあなたに向いています。私はあなたに身を避けます。私を放り出さないでください。","tok":[["私","わたくし"],["の"],["主","ぬし"],["、"],["神","かみ"],["よ"],["。"],["まこと"],["に"],["、"],["私","わたくし"],["の"],["目","め"],["は"],["あなた"],["に"],["向いて","むいて"],["います"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["身","み"],["を"],["避けます","さけます"],["。"],["私","わたくし"],["を"],["放り出さないで","ほうりださないで"],["ください"],["。"]]},{"verse":9,"text":"どうか、彼らが私に仕掛けたわなから、不法を行う者の落とし穴から、私を守ってください。","tok":[["どう"],["か"],["、"],["彼","かれ"],["ら"],["が"],["私","わたくし"],["に"],["仕掛けた","しかけた"],["わな"],["から"],["、"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["の"],["落とし穴","おとしあな"],["から"],["、"],["私","わたくし"],["を"],["守って","まもって"],["ください"],["。"]]},{"verse":10,"text":"私が通り過ぎるそのときに、悪者はおのれ自身の網に落ち込みますように。","tok":[["私","わたくし"],["が"],["通り過ぎる","とおりすぎる"],["その"],["とき"],["に"],["、"],["悪者","わるもの"],["は"],["おのれ"],["自身","じしん"],["の"],["網","あみ"],["に"],["落ち込みます","おちこみます"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"なぜ国々は騒ぎ立ち、国民はむなしくつぶやくのか。","tok":[["なぜ"],["国々","くにぐに"],["は"],["騒ぎ立ち","さわぎたち"],["、"],["国民","こくみん"],["は"],["むなしく"],["つぶやく"],["の"],["か"],["。"]]},{"verse":2,"text":"地の王たちは立ち構え、治める者たちは相ともに集まり、主と、主に油をそそがれた者とに逆らう。","tok":[["地","ち"],["の"],["王","おう"],["たち"],["は"],["立ち","たち"],["構え","かまえ"],["、"],["治める","おさめる"],["者","もの"],["たち"],["は"],["相","あい"],["とも"],["に"],["集まり","あつまり"],["、"],["主","ぬし"],["と"],["、"],["主に","おもに"],["油","あぶら"],["を"],["そそがれた"],["者","もの"],["と"],["に"],["逆らう","さからう"],["。"]]},{"verse":3,"text":"「さあ、彼らのかせを打ち砕き、彼らの綱を、解き捨てよう。」","tok":[["「"],["さあ"],["、"],["彼","かれ"],["ら"],["のかせ"],["を"],["打ち砕き","うちくだき"],["、"],["彼","かれ"],["ら"],["の"],["綱","つな"],["を"],["、"],["解き捨てよう","ときすてよう"],["。"],["」"]]},{"verse":4,"text":"天の御座に着いている方は笑い、主はその者どもをあざけられる。","tok":[["天","てん"],["の"],["御座","ぎょざ"],["に"],["着いて","ついて"],["いる"],["方","かた"],["は"],["笑い","わらい"],["、"],["主","ぬし"],["は"],["その"],["者","もの"],["ども"],["を"],["あざけられる"],["。"]]},{"verse":5,"text":"ここに主は、怒りをもって彼らに告げ、燃える怒りで彼らを恐れおののかせる。","tok":[["ここ"],["に"],["主","ぬし"],["は"],["、"],["怒り","いかり"],["を"],["もって"],["彼","かれ"],["ら"],["に"],["告げ","つげ"],["、"],["燃える","もえる"],["怒り","いかり"],["で"],["彼","かれ"],["ら"],["を"],["恐れおののかせる","おそれおののかせる"],["。"]]},{"verse":6,"text":"「しかし、わたしは、わたしの王を立てた。わたしの聖なる山、シオンに。」","tok":[["「"],["しかし"],["、"],["わたし"],["は"],["、"],["わたし"],["の"],["王","おう"],["を"],["立てた","たてた"],["。"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["、"],["シオン"],["に"],["。"],["」"]]},{"verse":7,"text":"「わたしは主の定めについて語ろう。主はわたしに言われた。『あなたは、わたしの子。きょう、わたしがあなたを生んだ。","tok":[["「"],["わたし"],["は"],["主","ぬし"],["の"],["定め","さだめ"],["について"],["語ろう","かたろう"],["。"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["『"],["あなた"],["は"],["、"],["わたし"],["の"],["子","こ"],["。"],["きょう"],["、"],["わたし"],["が"],["あなた"],["を"],["生んだ","うんだ"],["。"]]},{"verse":8,"text":"わたしに求めよ。わたしは国々をあなたへのゆずりとして与え、地をその果て果てまで、あなたの所有として与える。","tok":[["わたし"],["に"],["求めよ","もとめよ"],["。"],["わたし"],["は"],["国々","くにぐに"],["を"],["あなた"],["へ"],["の"],["ゆずり"],["として"],["与え","あたえ"],["、"],["地","ち"],["を"],["その"],["果て果て","はてはて"],["まで"],["、"],["あなた"],["の"],["所有","しょゆう"],["として"],["与える","あたえる"],["。"]]},{"verse":9,"text":"あなたは鉄の杖で彼らを打ち砕き、焼き物の器のように粉々にする。』」","tok":[["あなた"],["は"],["鉄","てつ"],["の"],["杖","つえ"],["で"],["彼","かれ"],["ら"],["を"],["打ち砕き","うちくだき"],["、"],["焼き物","やきもの"],["の"],["器","うつわ"],["の"],["よう"],["に"],["粉々","こなごな"],["に"],["する"],["。"],["』"],["」"]]},{"verse":10,"text":"それゆえ、今、王たちよ、悟れ。地のさばきづかさたちよ、慎め。","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["、"],["王","おう"],["たち"],["よ"],["、"],["悟れ","さとれ"],["。"],["地","ち"],["の"],["さばき"],["づかさ"],["たち"],["よ"],["、"],["慎め","つつしめ"],["。"]]},{"verse":11,"text":"恐れつつ主に仕えよ。おののきつつ喜べ。","tok":[["恐れ","おそれ"],["つつ"],["主に","おもに"],["仕え","つかえ"],["よ"],["。"],["おののき"],["つつ"],["喜べ","よろこべ"],["。"]]},{"verse":12,"text":"御子に口づけせよ。主が怒り、おまえたちが道で滅びないために。怒りは、いまにも燃えようとしている。幸いなことよ。すべて主に身を避ける人は。","tok":[["御子","みこ"],["に"],["口づけ","くちづけ"],["せよ"],["。"],["主","ぬし"],["が"],["怒り","おこり"],["、"],["おまえ"],["たち"],["が"],["道","みち"],["で"],["滅びない","ほろびない"],["ため"],["に"],["。"],["怒り","いかり"],["は"],["、"],["いま"],["に"],["も"],["燃えよう","もえよう"],["として"],["いる"],["。"],["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["すべて"],["主に","おもに"],["身","み"],["を"],["避ける","さける"],["人","ひと"],["は"],["。"]]}]
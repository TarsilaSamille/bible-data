[{"verse":1,"text":"ハレルヤ。私のたましいよ。主をほめたたえよ。","tok":[["ハレルヤ"],["。"],["私","わたくし"],["の"],["たましい"],["よ"],["。"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"私は生きているかぎり、主をほめたたえよう。いのちのあるかぎり、私の神に、ほめ歌を歌おう。","tok":[["私","わたくし"],["は"],["生きて","いきて"],["いる"],["かぎり"],["、"],["主","ぬし"],["を"],["ほめたたえよう"],["。"],["いのち"],["の"],["ある"],["かぎり"],["、"],["私","わたくし"],["の"],["神","かみ"],["に"],["、"],["ほめ歌","ほめうた"],["を"],["歌おう","うたおう"],["。"]]},{"verse":3,"text":"君主たちにたよってはならない。救いのない人間の子に。","tok":[["君主","くんしゅ"],["たち"],["に"],["たよって"],["は"],["ならない"],["。"],["救い","すくい"],["の"],["ない"],["人間","にんげん"],["の"],["子","こ"],["に"],["。"]]},{"verse":4,"text":"霊が出て行くと、人はおのれの土に帰り、その日のうちに彼のもろもろの計画は滅びうせる。","tok":[["霊","れい"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["人","ひと"],["は"],["おのれ"],["の"],["土","つち"],["に"],["帰り","かえり"],["、"],["その"],["日","ひ"],["の"],["うち"],["に"],["彼","かれ"],["の"],["もろもろ"],["の"],["計画","けいかく"],["は"],["滅び","ほろび"],["うせる"],["。"]]},{"verse":5,"text":"幸いなことよ。ヤコブの神を助けとし、その神、主に望みを置く者は。","tok":[["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["ヤコブ"],["の"],["神","かみ"],["を"],["助け","たすけ"],["と"],["し"],["、"],["その"],["神","かみ"],["、"],["主に","おもに"],["望み","のぞみ"],["を"],["置く","おく"],["者","もの"],["は"],["。"]]},{"verse":6,"text":"主は天と地と海とその中のいっさいを造った方。とこしえまでも真実を守り、","tok":[["主","ぬし"],["は"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["と"],["その"],["中","なか"],["の"],["いっさい"],["を"],["造った","つくった"],["方","ほう"],["。"],["とこしえ"],["まで"],["も"],["真実","しんじつ"],["を"],["守り","まもり"],["、"]]},{"verse":7,"text":"しいたげられる者のためにさばきを行い、飢えた者にパンを与える方。主は捕らわれ人を解放される。","tok":[["しいたげられる"],["者","もの"],["の"],["ため"],["に"],["さばき"],["を"],["行い","おこない"],["、"],["飢えた","うえた"],["者","もの"],["に"],["パン"],["を"],["与える","あたえる"],["方","かた"],["。"],["主","ぬし"],["は"],["捕らわれ","とらわれ"],["人","ひと"],["を"],["解放","かいほう"],["される"],["。"]]},{"verse":8,"text":"主は盲人の目をあけ、主はかがんでいる者を起こされる。主は正しい者を愛し、","tok":[["主","ぬし"],["は"],["盲人","もうじん"],["の"],["目","め"],["を"],["あけ"],["、"],["主","ぬし"],["は"],["かがんで"],["いる"],["者","もの"],["を"],["起こされる","おこされる"],["。"],["主","ぬし"],["は"],["正しい","ただしい"],["者","もの"],["を"],["愛し","あいし"],["、"]]},{"verse":9,"text":"主は在留異国人を守り、みなしごとやもめをささえられる。しかし主は悪者の道を曲げられる。","tok":[["主","ぬし"],["は"],["在留","ざいりゅう"],["異国人","いこくにん"],["を"],["守り","まもり"],["、"],["みなしご"],["と"],["やもめ"],["を"],["ささえられる"],["。"],["しかし"],["主","ぬし"],["は"],["悪者","わるもの"],["の"],["道","みち"],["を"],["曲げられる","まげられる"],["。"]]},{"verse":10,"text":"主は、とこしえまでも統べ治められる。シオンよ。あなたの神は代々にいます。ハレルヤ。","tok":[["主","ぬし"],["は"],["、"],["とこしえ"],["まで"],["も"],["統べ治められる","すべおさめられる"],["。"],["シオン"],["よ"],["。"],["あなた"],["の"],["神","かみ"],["は"],["代々","だいだい"],["に"],["います"],["。"],["ハレルヤ"],["。"]]}]
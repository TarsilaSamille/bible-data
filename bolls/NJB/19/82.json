[{"verse":1,"text":"（アサフの賛歌）神は神の会衆の中に立つ。神は神々の真ん中で、さばきを下す。","tok":[["（"],["アサフ"],["の"],["賛歌","さんか"],["）"],["神","かみ"],["は"],["神","かみ"],["の"],["会衆","かいしゅう"],["の"],["中","なか"],["に"],["立つ","たつ"],["。"],["神","かみ"],["は"],["神々","かみがみ"],["の"],["真ん中","まんなか"],["で"],["、"],["さばき"],["を"],["下す","くだす"],["。"]]},{"verse":2,"text":"いつまでおまえたちは、不正なさばきを行い、悪者どもの顔を立てるのか。セラ","tok":[["いつ"],["まで"],["おまえ"],["たち"],["は"],["、"],["不正","ふせい"],["な"],["さばき"],["を"],["行い","おこない"],["、"],["悪者","わるもの"],["ども"],["の"],["顔","かお"],["を"],["立てる","たてる"],["の"],["か"],["。"],["セラ"]]},{"verse":3,"text":"弱い者とみなしごとのためにさばき、悩む者と乏しい者の権利を認めよ。","tok":[["弱い","よわい"],["者","もの"],["と"],["みなし"],["ごと"],["の"],["ため"],["に"],["さばき"],["、"],["悩む","なやむ"],["者","もの"],["と"],["乏しい","とぼしい"],["者","もの"],["の"],["権利","けんり"],["を"],["認めよ","みとめよ"],["。"]]},{"verse":4,"text":"弱い者と貧しい者とを助け出し、悪者どもの手から救い出せ。","tok":[["弱い","よわい"],["者","もの"],["と"],["貧しい","まずしい"],["者","もの"],["と"],["を"],["助け出し","たすけだし"],["、"],["悪者","わるもの"],["ども"],["の"],["手","て"],["から"],["救い出せ","すくいだせ"],["。"]]},{"verse":5,"text":"彼らは、知らない。また、悟らない。彼らは、暗やみの中を歩き回る。地の基は、ことごとく揺らいでいる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["知らない","しらない"],["。"],["また"],["、"],["悟らない","さとらない"],["。"],["彼","かれ"],["ら"],["は"],["、"],["暗やみ","くらやみ"],["の"],["中","なか"],["を"],["歩き回る","あるきまわる"],["。"],["地","ち"],["の"],["基","もと"],["は"],["、"],["ことごとく"],["揺らいで","ゆらいで"],["いる"],["。"]]},{"verse":6,"text":"わたしは言った。「おまえたちは神々だ。おまえたちはみな、いと高き方の子らだ。","tok":[["わたし"],["は"],["言った","いった"],["。"],["「"],["おまえ"],["たち"],["は"],["神々","かみがみ"],["だ"],["。"],["おまえ"],["たち"],["は"],["みな"],["、"],["いと"],["高き","たかき"],["方","ほう"],["の"],["子","こ"],["ら"],["だ"],["。"]]},{"verse":7,"text":"にもかかわらず、おまえたちは、人のように死に、君主たちのひとりのように倒れよう。」","tok":[["に"],["も"],["かかわらず"],["、"],["おまえ"],["たち"],["は"],["、"],["人","ひと"],["の"],["よう"],["に"],["死に","しに"],["、"],["君主","くんしゅ"],["たち"],["の"],["ひとり"],["の"],["よう"],["に"],["倒れよう","たおれよう"],["。"],["」"]]},{"verse":8,"text":"神よ。立ち上がって、地をさばいてください。まことに、すべての国々はあなたが、ご自分のものとしておられます。","tok":[["神","かみ"],["よ"],["。"],["立ち上がって","たちあがって"],["、"],["地","ち"],["を"],["さばいて"],["ください"],["。"],["まこと"],["に"],["、"],["すべて"],["の"],["国々","くにぐに"],["は"],["あなた"],["が"],["、"],["ご自分","ごじぶん"],["の"],["もの"],["として"],["おられます"],["。"]]}]
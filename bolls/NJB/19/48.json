[{"verse":1,"text":"（歌。コラの子たちの賛歌）主は大いなる方。大いにほめたたえられるべき方。その聖なる山、われらの神の都において。","tok":[["（"],["歌","うた"],["。"],["コラ"],["の"],["子","こ"],["たち"],["の"],["賛歌","さんか"],["）"],["主","ぬし"],["は"],["大いなる","おおいなる"],["方","かた"],["。"],["大いに","おおいに"],["ほめたたえられるべき"],["方","かた"],["。"],["その"],["聖","せい"],["なる"],["山","やま"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["都","と"],["に"],["おいて"],["。"]]},{"verse":2,"text":"高嶺の麗しさは、全地の喜び。北の端なるシオンの山は大王の都。","tok":[["高嶺","たかね"],["の"],["麗し","うるわし"],["さ"],["は"],["、"],["全地","ぜんち"],["の"],["喜び","よろこび"],["。"],["北","きた"],["の"],["端","はし"],["なる"],["シオン"],["の"],["山","やま"],["は"],["大王","だいおう"],["の"],["都","と"],["。"]]},{"verse":3,"text":"神は、その宮殿で、ご自身をやぐらとして示された。","tok":[["神","かみ"],["は"],["、"],["その"],["宮殿","きゅうでん"],["で"],["、"],["ご自身","ごじしん"],["を"],["やぐら"],["として"],["示された","しめされた"],["。"]]},{"verse":4,"text":"見よ。王たちは相つどい、ともどもにそこを通り過ぎた。","tok":[["見","み"],["よ"],["。"],["王","おう"],["たち"],["は"],["相","あい"],["つどい"],["、"],["ともども"],["に"],["そこ"],["を"],["通り過ぎた","とおりすぎた"],["。"]]},{"verse":5,"text":"彼らは、見るとたちまち驚き、おじ惑って急いで逃げた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["見る","みる"],["と"],["たちまち"],["驚き","おどろき"],["、"],["おじ"],["惑って","まどって"],["急いで","いそいで"],["逃げた","にげた"],["。"]]},{"verse":6,"text":"その場で恐怖が彼らを捕らえた。産婦のような苦痛。","tok":[["その"],["場","ば"],["で"],["恐怖","きょうふ"],["が"],["彼","かれ"],["ら"],["を"],["捕らえた","とらえた"],["。"],["産婦","さんぷ"],["の"],["よう"],["な"],["苦痛","くつう"],["。"]]},{"verse":7,"text":"あなたは東風でタルシシュの船を打ち砕かれる。","tok":[["あなた"],["は"],["東風","とうふう"],["で"],["タルシシュ"],["の"],["船","ふね"],["を"],["打ち砕かれる","うちくだかれる"],["。"]]},{"verse":8,"text":"私たちは、聞いたとおりを、そのまま見た。万軍の主の都、われらの神の都で。神は都を、とこしえに堅く建てられる。セラ","tok":[["私たち","わたしたち"],["は"],["、"],["聞いた","きいた"],["とおり"],["を"],["、"],["そのまま"],["見た","みた"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["都","と"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["都","と"],["で"],["。"],["神","かみ"],["は"],["都","と"],["を"],["、"],["とこしえ"],["に"],["堅く","かたく"],["建てられる","たてられる"],["。"],["セラ"]]},{"verse":9,"text":"神よ。私たちは、あなたの宮の中で、あなたの恵みを思い巡らしました。","tok":[["神","かみ"],["よ"],["。"],["私たち","わたしたち"],["は"],["、"],["あなた"],["の"],["宮","みや"],["の"],["中","なか"],["で"],["、"],["あなた"],["の"],["恵み","めぐみ"],["を"],["思い巡らしました","おもいめぐらしました"],["。"]]},{"verse":10,"text":"神よ。あなたの誉れはあなたの御名と同じく、地の果てにまで及んでいます。あなたの右の手は義に満ちています。","tok":[["神","かみ"],["よ"],["。"],["あなた"],["の"],["誉れ","ほまれ"],["は"],["あなた"],["の"],["御名","ぎょめい"],["と"],["同じく","おなじく"],["、"],["地","ち"],["の"],["果て","はて"],["に"],["まで"],["及んで","およんで"],["います"],["。"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["義","ぎ"],["に"],["満ちて","みちて"],["います"],["。"]]},{"verse":11,"text":"あなたのさばきがあるために、シオンの山が喜び、ユダの娘が楽しむようにしてください。","tok":[["あなた"],["の"],["さばき"],["が"],["ある"],["ため"],["に"],["、"],["シオン"],["の"],["山","やま"],["が"],["喜び","よろこび"],["、"],["ユダ"],["の"],["娘","むすめ"],["が"],["楽しむ","たのしむ"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":12,"text":"シオンを巡り、その回りを歩け。そのやぐらを数えよ。","tok":[["シオン"],["を"],["巡り","めぐり"],["、"],["その"],["回り","まわり"],["を"],["歩け","あるけ"],["。"],["その"],["やぐら"],["を"],["数え","かぞえ"],["よ"],["。"]]},{"verse":13,"text":"その城壁に心を留めよ。その宮殿を巡り歩け。後の時代に語り伝えるために。","tok":[["その"],["城壁","じょうへき"],["に"],["心","こころ"],["を"],["留めよ","とめよ"],["。"],["その"],["宮殿","きゅうでん"],["を"],["巡り歩け","めぐりあるけ"],["。"],["後","あと"],["の"],["時代","じだい"],["に"],["語り伝える","かたりつたえる"],["ため"],["に"],["。"]]},{"verse":14,"text":"この方こそまさしく神。世々限りなくわれらの神であられる。神は私たちをとこしえに導かれる。","tok":[["この"],["方","かた"],["こそ"],["まさしく"],["神","かみ"],["。"],["世々","せいせい"],["限りなく","かぎりなく"],["われ"],["ら"],["の"],["神","かみ"],["で"],["あられる"],["。"],["神","かみ"],["は"],["私たち","わたしたち"],["を"],["とこしえ"],["に"],["導かれる","みちびかれる"],["。"]]}]
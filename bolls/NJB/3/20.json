],["が"],["もし"],["、"],["どんな"],["動物","どうぶつ"],["に"],["で"],["も"],["、"],["近づいて","ちかづいて"],["、"],["それ"],["と"],["とも"],["に"],["臥すなら","ふすなら"],["、"],["あなた"],["は"],["その"],["女","おんな"],["と"],["動物","どうぶつ"],["を"],["殺さなければ","ころさなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["必ず","かならず"],["殺されなければ","ころされなければ"],["ならない"],["。"],["その"],["血","ち"],["の"],["責任","せきにん"],["は"],["彼","かれ"],["ら"],["に"],["ある"],["。"]]},{"verse":17,"text":"人がもし、自分の姉妹、すなわち父の娘、あるいは母の娘をめとり、その姉妹の裸を見、また女が彼の裸を見るなら、これは恥ずべきことである。同族の目の前で彼らは断ち切られる。彼はその姉妹を犯した。その咎を負わなければならない。","tok":[["人","ひと"],["が"],["もし"],["、"],["自分","じぶん"],["の"],["姉妹","しまい"],["、"],["すなわち"],["父","ちち"],["の"],["娘","むすめ"],["、"],["あるいは"],["母","はは"],["の"],["娘","むすめ"],["を"],["めとり"],["、"],["その"],["姉妹","しまい"],["の"],["裸","はだか"],["を"],["見","み"],["、"],["また"],["女","おんな"],["が"],["彼","かれ"],["の"],["裸","はだか"],["を"],["見るなら","みるなら"],["、"],["これ"],["は"],["恥ずべき","はずべき"],["こと"],["で"],["ある"],["。"],["同族","どうぞく"],["の"],["目","め"],["の"],["前","まえ"],["で"],["彼","かれ"],["ら"],["は"],["断ち切られる","たちきられる"],["。"],["彼","かれ"],["は"],["その"],["姉妹","しまい"],["を"],["犯した","おかした"],["。"],["その"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":18,"text":"人がもし、月のさわりのある女と寝て、これを犯すなら、男は女の泉をあばき、女はその血の泉を現したのである。ふたりはその民の間から断たれる。","tok":[["人","ひと"],["が"],["もし"],["、"],["月","つき"],["の"],["さわり"],["の"],["ある"],["女","おんな"],["と"],["寝て","ねて"],["、"],["これ"],["を"],["犯すなら","おかすなら"],["、"],["男","おとこ"],["は"],["女","おんな"],["の"],["泉","いずみ"],["を"],["あばき"],["、"],["女","おんな"],["は"],["その"],["血","ち"],["の"],["泉","いずみ"],["を"],["現した","あらわした"],["ので"],["ある"],["。"],["ふたり"],["は"],["その"],["民","たみ"],["の"],["間","あいだ"],["から"],["断たれる","たたれる"],["。"]]},{"verse":19,"text":"母の姉妹や父の姉妹を犯してはならない。これは、自分の肉親を犯したのである。彼らは咎を負わなければならない。","tok":[["母","はは"],["の"],["姉妹","しまい"],["や"],["父","ちち"],["の"],["姉妹","しまい"],["を"],["犯して","おかして"],["は"],["ならない"],["。"],["これ"],["は"],["、"],["自分","じぶん"],["の"],["肉親","にくしん"],["を"],["犯した","おかした"],["ので"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":20,"text":"人がもし、自分のおばと寝るなら、おじ
[{"verse":1,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「あなたはイスラエル人に言わなければならない。イスラエル人、またはイスラエルにいる在留異国人のうちで、自分の子どもをモレクに与える者は、だれでも必ず殺さなければならない。この国の人々は彼を石で打ち殺さなければならない。","tok":[["「"],["あなた"],["は"],["イスラエル"],["人","にん"],["に"],["言わなければ","いわなければ"],["ならない"],["。"],["イスラエル"],["人","にん"],["、"],["また"],["は"],["イスラエル"],["に"],["いる"],["在留","ざいりゅう"],["異国人","いこくにん"],["の"],["うち"],["で"],["、"],["自分","じぶん"],["の"],["子ども","こども"],["を"],["モレク"],["に"],["与える","あたえる"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["必ず","かならず"],["殺さなければ","ころさなければ"],["ならない"],["。"],["この"],["国","くに"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["石","いし"],["で"],["打ち殺さなければ","うちころさなければ"],["ならない"],["。"]]},{"verse":3,"text":"わたしはその者からわたしの顔をそむけ、彼をその民の間から断つ。彼がモレクに子どもを与え、そのためわたしの聖所を汚し、わたしの聖なる名を汚すからである。","tok":[["わたし"],["は"],["その"],["者","もの"],["から"],["わたし"],["の"],["顔","かお"],["を"],["そむけ"],["、"],["彼","かれ"],["を"],["その"],["民","たみ"],["の"],["間","あいだ"],["から"],["断つ","たつ"],["。"],["彼","かれ"],["が"],["モレク"],["に"],["子ども","こども"],["を"],["与え","あたえ"],["、"],["その"],["ため"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚し","よごし"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚す","よごす"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"人がモレクにその子どもを与えるとき、もしこの国の人々が、ことさらに目をつぶり、彼を殺さなかったなら、","tok":[["人","ひと"],["が"],["モレク"],["に"],["その"],["子ども","こども"],["を"],["与える","あたえる"],["とき"],["、"],["もし"],["この"],["国","くに"],["の"],["人々","ひとびと"],["が"],["、"],["こと"],["さらに"],["目","め"],["を"],["つぶり"],["、"],["彼","かれ"],["を"],["殺さなかったなら","ころさなかったなら"],["、"]]},{"verse":5,"text":"わたし自身は、その人とその家族から顔をそむけ、彼と、彼にならいモレクを慕って、淫行を行うみだらな者をすべて、その民の間から断つ。","tok":[["わたし"],["自身","じしん"],["は"],["、"],["その"],["人","ひと"],["と"],["その"],["家族","かぞく"],["から"],["顔","かお"],["を"],["そむけ"],["、"],["彼","かれ"],["と"],["、"],["彼","かれ"],["に"],["ならい"],["モレク"],["を"],["慕って","したって"],["、"],["淫行","いんこう"],["を"],["行う","おこなう"],["みだら"],["な"],["者","もの"],["を"],["すべて"],["、"],["その"],["民","たみ"],["の"],["間","あいだ"],["から"],["断つ","たつ"],["。"]]},{"verse"
[{"verse":1,"text":"さて、アロンの子ナダブとアビフは、おのおの自分の火皿を取り、その中に火を入れ、その上に香を盛り、主が彼らに命じなかった異なった火を主の前にささげた。","tok":[["さて"],["、"],["アロン"],["の"],["子","こ"],["ナダブ"],["と"],["アビフ"],["は"],["、"],["おのおの"],["自分","じぶん"],["の"],["火皿","ひざら"],["を"],["取り","とり"],["、"],["その"],["中","なか"],["に"],["火","ひ"],["を"],["入れ","いれ"],["、"],["その"],["上","うえ"],["に"],["香","こう"],["を"],["盛り","もり"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["に"],["命じなかった","めいじなかった"],["異なった","ことなった"],["火","ひ"],["を"],["主","ぬし"],["の"],["前","まえ"],["に"],["ささげた"],["。"]]},{"verse":2,"text":"すると、主の前から火が出て、彼らを焼き尽くし、彼らは主の前で死んだ。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["前","まえ"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くし","つくし"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["前","まえ"],["で"],["死んだ","しんだ"],["。"]]},{"verse":3,"text":"それで、モーセはアロンに言った。「主が仰せになったことは、こういうことだ。『わたしに近づく者によって、わたしは自分の聖を現し、すべての民の前でわたしは自分の栄光を現す。』」それゆえ、アロンは黙っていた。","tok":[["それ"],["で"],["、"],["モーセ"],["は"],["アロン"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["仰せ","おおせ"],["に"],["なった"],["こと"],["は"],["、"],["こう"],["いう"],["こと"],["だ"],["。"],["『"],["わたし"],["に"],["近づく","ちかづく"],["者","もの"],["によって"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["聖","ひじり"],["を"],["現し","あらわし"],["、"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["わたし"],["は"],["自分","じぶん"],["の"],["栄光","えいこう"],["を"],["現す","あらわす"],["。"],["』"],["」"],["それ"],["ゆえ"],["、"],["アロン"],["は"],["黙って","だまって"],["いた"],["。"]]},{"verse":4,"text":"モーセはアロンのおじウジエルの子ミシャエルとエルツァファンを呼び寄せ、彼らに言った。「進み出て、あなたがたの身内の者たちを聖所の前から宿営の外に運び出しなさい。」","tok":[["モーセ"],["は"],["アロン"],["の"],["おじ"],["ウジエル"],["の"],["子","こ"],["ミシャエル"],["と"],["エルツァファン"],["を"],["呼び寄せ","よびよせ"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["進み出て","すすみでて"],["、"],["あなた"],["がた"],["の"],["身内","みうち"],["の"],["者","もの"],["たち"],["を"],["聖","せい"],["所","しょ"],["の"],["前","まえ"],["から"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["運び出し","はこびだし"],["なさい"],["。"],["」"]]},{"verse":5,"text":"彼らは進み出て、モーセが言ったように、彼らの長服をつかんで彼らを宿営の外に運び出した。","tok":[["彼","かれ"],["ら"],["は"],["進み出て","すすみでて"],["、"],["モーセ"],["が"],["言った","いった"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["長服","ふろっく"],["を"],["つかんで"],["彼","かれ"],["ら"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["運び出した","はこびだした"],["。"]]},{"verse":6,"text":"次に、モーセは、アロンとその子エルアザルとイタマルに言った。「あなたがたは髪の毛を乱してはならない。また着物を引き裂いてはならない。あなたがたが死なないため、また怒りが全会衆に下らないためである。しかし、あなたがたの身内の者、すなわちイスラエルの全家族が、主によって焼かれたことを泣き悲しまなければならない。","tok":[["次","つぎ"],["に"],["、"],["モーセ"],["は"],["、"],["アロン"],["と"],["その"],["子","こ"],["エルアザル"],["と"],["イタマル"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["髪の毛","かみのけ"],["を"],["乱して","みだして"],["は"],["ならない"],["。"],["また"],["着物","きもの"],["を"],["引き裂いて","ひきさいて"],["は"],["ならない"],["。"],["あなた"],["がた"],["が"],["死なない","しなない"],["ため"],["、"],["また"],["怒り","いかり"],["が"],["全","ぜん"],["会衆","かいしゅう"],["に"],["下らない","くだらない"],["ため"],["で"],["ある"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["身内","みうち"],["の"],["者","もの"],["、"],["すなわち"],["イスラエル"],["の"],["全","ぜん"],["家族","かぞく"],["が"],["、"],["主に","おもに"],["よって"],["焼かれた","やかれた"],["こと"],["を"],["泣き悲しまなければ","なきかなしまなければ"],["ならない"],["。"]]},{"verse":7,"text":"またあなたがたは会見の天幕の入口から外へ出てはならない。あなたがたが死なないためである。あなたがたの上には主のそそぎの油があるからだ。」それで、彼らはモーセのことばどおりにした。","tok":[["また"],["あなた"],["がた"],["は"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["から"],["外","そと"],["へ"],["出て","でて"],["は"],["ならない"],["。"],["あなた"],["がた"],["が"],["死なない","しなない"],["ため"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["は"],["主","ぬし"],["の"],["そそぎ"],["の"],["油","あぶら"],["が"],["ある"],["から"],["だ"],["。"],["」"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["モーセ"],["の"],["ことば"],["どおり"],["に"],["した"],["。"]]},{"verse":8,"text":"それから、主はアロンに告げて仰せられた。","tok":[["それ"],["から"],["、"],["主","ぬし"],["は"],["アロン"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":9,"text":"「会見の天幕に入って行くときには、あなたがたが死なないように、あなたも、あなたとともにいるあなたの子らも、ぶどう酒や強い酒を飲んではならない。これはあなたがたが代々守るべき永遠のおきてである。","tok":[["「"],["会見","かいけん"],["の"],["天幕","てんまく"],["に"],["入って","はいって"],["行く","いく"],["とき"],["に"],["は"],["、"],["あなた"],["がた"],["が"],["死なない","しなない"],["よう"],["に"],["、"],["あなた"],["も"],["、"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["子","こ"],["ら"],["も"],["、"],["ぶどう酒","ぶどうしゅ"],["や"],["強い","つよい"],["酒","さけ"],["を"],["飲んで","のんで"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["が"],["代々","だいだい"],["守るべき","まもるべき"],["永遠","えいえん"],["の"],["おきて"],["で"],["ある"],["。"]]},{"verse":10,"text":"それはまた、あなたがたが、聖なるものと俗なるもの、また、汚れたものときよいものを区別するため、","tok":[["それ"],["は"],["また"],["、"],["あなた"],["が"],["た"],["が"],["、"],["聖","せい"],["なる"],["もの"],["と"],["俗","ぞく"],["なる"],["もの"],["、"],["また"],["、"],["汚れた","よごれた"],["もの"],["と"],["きよい"],["もの"],["を"],["区別","くべつ"],["する"],["ため"],["、"]]},{"verse":11,"text":"また、主がモーセを通してイスラエル人に告げられたすべてのおきてを、あなたがたが彼らに教えるためである。」","tok":[["また"],["、"],["主","ぬし"],["が"],["モーセ"],["を"],["通して","とおして"],["イスラエル"],["人","にん"],["に"],["告げられた","つげられた"],["すべて"],["の"],["おきて"],["を"],["、"],["あなた"],["がた"],["が"],["彼","かれ"],["ら"],["に"],["教える","おしえる"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":12,"text":"そこで、モーセは、アロンとその生き残っている子のエルアザルとイタマルに言った。「主への火によるささげ物のうちから残った穀物のささげ物を取り、パン種を入れずに祭壇のそばで、食べなさい。これは最も聖なるものであるから。","tok":[["そこ"],["で"],["、"],["モーセ"],["は"],["、"],["アロン"],["と"],["その"],["生き残って","いきのこって"],["いる"],["子","こ"],["の"],["エルアザル"],["と"],["イタマル"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["の"],["うち"],["から"],["残った","のこった"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["取り","とり"],["、"],["パン種","ぱんだね"],["を"],["入れず","いれず"],["に"],["祭壇","さいだん"],["の"],["そば"],["で"],["、"],["食べ","たべ"],["なさい"],["。"],["これ"],["は"],["最も","もっとも"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["から"],["。"]]},{"verse":13,"text":"それを聖なる所で食べなさい。それは、主への火によるささげ物のうちから、あなたの受け取る分け前であり、あなたの子らの受け取る分け前である。そのように、私は命じられている。","tok":[["それ"],["を"],["聖","せい"],["なる"],["所","ところ"],["で"],["食べ","たべ"],["なさい"],["。"],["それ"],["は"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["の"],["うち"],["から"],["、"],["あなた"],["の"],["受け取る","うけとる"],["分け前","わけまえ"],["で"],["あり"],["、"],["あなた"],["の"],["子","こ"],["ら"],["の"],["受け取る","うけとる"],["分け前","わけまえ"],["で"],["ある"],["。"],["その"],["よう"],["に"],["、"],["私","わたくし"],["は"],["命じられて","めいじられて"],["いる"],["。"]]},{"verse":14,"text":"しかし、奉献物の胸と、奉納物のももとは、あなたと、あなたとともにいるあなたの息子、娘たちが、きよい所で食べることができる。それは、イスラエル人の和解のいけにえから、あなたの受け取る分け前、またあなたの子らの受け取る分け前として与えられている。","tok":[["しかし"],["、"],["奉献物","ほうけんぶつ"],["の"],["胸","むね"],["と"],["、"],["奉納物","ほうのうぶつ"],["の"],["もも"],["と"],["は"],["、"],["あなた"],["と"],["、"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["が"],["、"],["きよい"],["所","ところ"],["で"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["それ"],["は"],["、"],["イスラエル"],["人","にん"],["の"],["和解","わかい"],["の"],["いけにえ"],["から"],["、"],["あなた"],["の"],["受け取る","うけとる"],["分け前","わけまえ"],["、"],["また"],["あなた"],["の"],["子","こ"],["ら"],["の"],["受け取る","うけとる"],["分け前","わけまえ"],["として"],["与えられて","あたえられて"],["いる"],["。"]]},{"verse":15,"text":"人々は、奉納物のももと奉献物の胸とを、火によるささげ物の脂肪に添えて持って来て、奉献物として主に向かって揺り動かさなければならない。これは主が命じられたとおり、あなたと、またあなたとともにいるあなたの子らが永遠に受け取る分である。」","tok":[["人々","ひとびと"],["は"],["、"],["奉納物","ほうのうぶつ"],["の"],["もも"],["と"],["奉献物","ほうけんぶつ"],["の"],["胸","むね"],["と"],["を"],["、"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["の"],["脂肪","しぼう"],["に"],["添えて","そえて"],["持って","もって"],["来て","きて"],["、"],["奉献物","ほうけんぶつ"],["として"],["主に","おもに"],["向かって","むかって"],["揺り動かさなければ","ゆりうごかさなければ"],["ならない"],["。"],["これ"],["は"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["、"],["あなた"],["と"],["、"],["また"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["子","こ"],["ら"],["が"],["永遠","えいえん"],["に"],["受け取る","うけとる"],["分","ぶん"],["で"],["ある"],["。"],["」"]]},{"verse":16,"text":"モーセは罪のためのいけにえのやぎをけんめいに捜した。しかし、もう、焼かれてしまっていた。すると、モーセはアロンの子で生き残ったエルアザルとイタマルに怒って言った。","tok":[["モーセ"],["は"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["の"],["やぎ"],["を"],["けんめい"],["に"],["捜した","さがした"],["。"],["しかし"],["、"],["もう"],["、"],["焼かれて","やかれて"],["しまって"],["いた"],["。"],["する"],["と"],["、"],["モーセ"],["は"],["アロン"],["の"],["子","こ"],["で"],["生き残った","いきのこった"],["エルアザル"],["と"],["イタマル"],["に"],["怒って","おこって"],["言った","いった"],["。"]]},{"verse":17,"text":"「どうして、あなたがたは聖なる所でその罪のためのいけにえを食べなかったのか。それは最も聖なるものなのだ。それは、会衆の咎を除き、主の前で彼らのために贖いをするために、あなたがたに賜ったのだ。","tok":[["「"],["どう"],["して"],["、"],["あなた"],["がた"],["は"],["聖","せい"],["なる"],["所","ところ"],["で"],["その"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["を"],["食べなかった","たべなかった"],["の"],["か"],["。"],["それ"],["は"],["最も","もっとも"],["聖","せい"],["なる"],["もの"],["な"],["の"],["だ"],["。"],["それ"],["は"],["、"],["会衆","かいしゅう"],["の"],["咎","とが"],["を"],["除き","のぞき"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["贖い","あがない"],["を"],["する"],["ため"],["に"],["、"],["あなた"],["がた"],["に"],["賜った","たまわった"],["の"],["だ"],["。"]]},{"verse":18,"text":"その血は、聖所の中に携え入れられなかったではないか。あなたがたは、私が命じたように、それを聖所で食べなければならなかったのだ。」","tok":[["その"],["血","ち"],["は"],["、"],["聖","せい"],["所","しょ"],["の"],["中","なか"],["に"],["携え","たずさえ"],["入れられなかったで","いれられなかったで"],["は"],["ない"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["私","わたくし"],["が"],["命じた","めいじた"],["よう"],["に"],["、"],["それ"],["を"],["聖","せい"],["所","しょ"],["で"],["食べなければ","たべなければ"],["ならなかった"],["の"],["だ"],["。"],["」"]]},{"verse":19,"text":"そこでアロンはモーセに告げた。「ああ、きょう彼らがその罪のためのいけにえ、全焼のいけにえを、主の前にささげましたが、こういうことが私の身にふりかかったのです。もしきょう私が罪のためのいけにえを食べていたら、主のみこころにかなったのでしょうか。」","tok":[["そこ"],["で"],["アロン"],["は"],["モーセ"],["に"],["告げた","つげた"],["。"],["「"],["ああ"],["、"],["きょう"],["彼","かれ"],["ら"],["が"],["その"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["ささげました"],["が"],["、"],["こう"],["いう"],["こと"],["が"],["私","わたくし"],["の"],["身","み"],["に"],["ふりかかった"],["の"],["です"],["。"],["もし"],["きょう"],["私","わたくし"],["が"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["を"],["食べて","たべて"],["いたら"],["、"],["主","ぬし"],["のみ"],["こころ"],["に"],["かなった"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":20,"text":"モーセはこれを聞き、それでよいとした。","tok":[["モーセ"],["は"],["これ"],["を"],["聞き","きき"],["、"],["それ"],["で"],["よい"],["と"],["した"],["。"]]}]
[{"verse":1,"text":"人が罪を犯す場合、すなわち、証言しなければのろわれるという声を聞きながら――彼がそれを見ているとか、知っている証人であるのに――、そのことについて証言しないなら、その人は罪の咎を負わなければならない。","tok":[["人","ひと"],["が"],["罪","つみ"],["を"],["犯す","おかす"],["場合","ばあい"],["、"],["すなわち"],["、"],["証言","しょうげん"],["しなければ"],["のろわれる"],["と"],["いう"],["声","こえ"],["を"],["聞き","きき"],["ながら"],["―"],["―"],["彼","かれ"],["が"],["それ"],["を"],["見て","みて"],["いる"],["と"],["か"],["、"],["知って","しって"],["いる"],["証人","しょうにん"],["で"],["ある"],["のに"],["―"],["―"],["、"],["その"],["こと"],["について"],["証言","しょうげん"],["しないなら"],["、"],["その"],["人","ひと"],["は"],["罪","つみ"],["の"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":2,"text":"あるいは人が、汚れた獣の死体でも、汚れた家畜の死体でも、汚れた群生するものの死体でも、すべて汚れたものに触れ、汚れてはいたのに、そのことが彼の目から隠れ、後で咎を覚える場合、","tok":[["あるいは"],["人","ひと"],["が"],["、"],["汚れた","よごれた"],["獣","けもの"],["の"],["死体","したい"],["で"],["も"],["、"],["汚れた","よごれた"],["家畜","かちく"],["の"],["死体","したい"],["で"],["も"],["、"],["汚れた","よごれた"],["群生","ぐんせい"],["する"],["もの"],["の"],["死体","したい"],["で"],["も"],["、"],["すべて"],["汚れた","よごれた"],["もの"],["に"],["触れ","ふれ"],["、"],["汚れて","よごれて"],["は"],["いた"],["のに"],["、"],["その"],["こと"],["が"],["彼","かれ"],["の"],["目","め"],["から"],["隠れ","かくれ"],["、"],["後","あと"],["で"],["咎","とが"],["を"],["覚える","おぼえる"],["場合","ばあい"],["、"]]},{"verse":3,"text":"あるいは人が、触れれば汚れると言われる人のどんな汚れにも触れ、そのことを知ってはいたが、それが彼の目から隠れ、後で咎を覚える場合、","tok":[["あるいは"],["人","ひと"],["が"],["、"],["触れれば","ふれれば"],["汚れる","よごれる"],["と"],["言われる","いわれる"],["人","ひと"],["の"],["どんな"],["汚れ","よごれ"],["に"],["も"],["触れ","ふれ"],["、"],["その"],["こと"],["を"],["知って","しって"],["は"],["いた"],["が"],["、"],["それ"],["が"],["彼","かれ"],["の"],["目","め"],["から"],["隠れ","かくれ"],["、"],["後","あと"],["で"],["咎","とが"],["を"],["覚える","おぼえる"],["場合","ばあい"],["、"]]},{"verse":4,"text":"あるいは人が口で軽々しく、害になることでも益になることでも誓う場合、その人が軽々しく誓ったことがどんなことであれ、そのことを知ってはいたのに彼の目から隠れ、後でそれらの一つについて咎を覚える場合、","tok":[["あるいは"],["人","ひと"],["が"],["口","くち"],["で"],["軽々しく","かるがるしく"],["、"],["害","がい"],["に"],["なる"],["こと"],["で"],["も"],["益","えき"],["に"],["なる"],["こと"],["で"],["も"],["誓う","ちかう"],["場合","ばあい"],["、"],["その"],["人","ひと"],["が"],["軽々しく","かるがるしく"],["誓った","ちかった"],["こと"],["が"],["どんな"],["こと"],["で"],["あれ"],["、"],["その"],["こと"],["を"],["知って","しって"],["は"],["いた"],["のに"],["彼","かれ"],["の"],["目","め"],["から"],["隠れ","かくれ"],["、"],["後","あと"],["で"],["それ"],["ら"],["の"],["一","ひと"],["つ"],["について"],["咎","とが"],["を"],["覚える","おぼえる"],["場合","ばあい"],["、"]]},{"verse":5,"text":"これらの一つについて咎を覚えるときは、犯した罪を告白しなさい。","tok":[["これ"],["ら"],["の"],["一","ひと"],["つ"],["について"],["咎","とが"],["を"],["覚える","おぼえる"],["とき"],["は"],["、"],["犯した","おかした"],["罪","つみ"],["を"],["告白","こくはく"],["し"],["なさい"],["。"]]},{"verse":6,"text":"自分が犯した罪のために、償いとして、羊の群れの子羊でも、やぎでも、雌一頭を、主のもとに連れて来て、罪のためのいけにえとしなさい。祭司はその人のために、その人の罪の贖いをしなさい。","tok":[["自分","じぶん"],["が"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["に"],["、"],["償い","つぐない"],["として"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["子羊","こひつじ"],["で"],["も"],["、"],["やぎ"],["で"],["も"],["、"],["雌","めす"],["一頭","いちとう"],["を"],["、"],["主","ぬし"],["の"],["もと"],["に"],["連れて","つれて"],["来て","きて"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["と"],["し"],["なさい"],["。"],["祭司","さいし"],["は"],["その"],["人","ひと"],["の"],["ため"],["に"],["、"],["その"],["人","ひと"],["の"],["罪","つみ"],["の"],["贖い","あがない"],["を"],["し"],["なさい"],["。"]]},{"verse":7,"text":"しかし、もし彼に羊を買う余裕がなければ、自分が犯した罪の償いとして、山鳩二羽あるいは家鳩のひな二羽を主のところに持って来なさい。一羽は罪のためのいけにえ、他の一羽は全焼のいけにえとする。","tok":[["しかし"],["、"],["もし"],["彼","かれ"],["に"],["羊","ひつじ"],["を"],["買う","かう"],["余裕","よゆう"],["が"],["なければ"],["、"],["自分","じぶん"],["が"],["犯した","おかした"],["罪","つみ"],["の"],["償い","つぐない"],["として"],["、"],["山鳩","やまばと"],["二羽","ふたわ"],["あるいは"],["家鳩","いえばと"],["の"],["ひな"],["二羽","ふたわ"],["を"],["主","ぬし"],["の"],["ところ"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["一羽","ひとわ"],["は"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["、"],["他","た"],["の"],["一羽","ひとわ"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["する"],["。"]]},{"verse":8,"text":"彼はこれらを祭司のところに持って行き、祭司は罪のためのいけにえとなるものを、まずささげなさい。彼はその頭の首のところをひねり裂きなさい。それを切り離してはならない。","tok":[["彼","かれ"],["は"],["これ"],["ら"],["を"],["祭司","さいし"],["の"],["ところ"],["に"],["持って","もって"],["行き","いき"],["、"],["祭司","さいし"],["は"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["と"],["なる"],["もの"],["を"],["、"],["まず"],["ささげ"],["なさい"],["。"],["彼","かれ"],["は"],["その"],["頭","あたま"],["の"],["首","くび"],["の"],["ところ"],["を"],["ひねり"],["裂き","さき"],["なさい"],["。"],["それ"],["を"],["切り離して","きりはなして"],["は"],["ならない"],["。"]]},{"verse":9,"text":"それから罪のためのいけにえの血を祭壇の側面に振りかけ、血の残りはその祭壇の土台のところに絞り出しなさい。これは罪のためのいけにえである。","tok":[["それ"],["から"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["の"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["側面","そくめん"],["に"],["振りかけ","ふりかけ"],["、"],["血","ち"],["の"],["残り","のこり"],["は"],["その"],["祭壇","さいだん"],["の"],["土台","どだい"],["の"],["ところ"],["に"],["絞り出し","しぼりだし"],["なさい"],["。"],["これ"],["は"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["で"],["ある"],["。"]]},{"verse":10,"text":"祭司はもう一羽のほうも、定めに従って全焼のいけにえとしなければならない。祭司はその人のために、その人が犯した罪の贖いをしなさい。その人は赦される。","tok":[["祭司","さいし"],["は"],["もう"],["一羽","ひとわ"],["の"],["ほう"],["も"],["、"],["定め","さだめ"],["に"],["従って","したがって"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["しなければ"],["ならない"],["。"],["祭司","さいし"],["は"],["その"],["人","ひと"],["の"],["ため"],["に"],["、"],["その"],["人","ひと"],["が"],["犯した","おかした"],["罪","つみ"],["の"],["贖い","あがない"],["を"],["し"],["なさい"],["。"],["その"],["人","ひと"],["は"],["赦される","ゆるされる"],["。"]]},{"verse":11,"text":"もしその人が山鳩二羽あるいは家鳩のひな二羽さえも手に入れることができなければ、その犯した罪のためのささげ物として、十分の一エパの小麦粉を罪のためのいけにえとして持って来なさい。その人はその上に油を加えたり、その上に乳香を添えたりしてはならない。これは罪のためのいけにえであるから。","tok":[["もし"],["その"],["人","ひと"],["が"],["山鳩","やまばと"],["二羽","ふたわ"],["あるいは"],["家鳩","いえばと"],["の"],["ひな"],["二羽","ふたわ"],["さえ"],["も"],["手","て"],["に"],["入れる","いれる"],["こと"],["が"],["できなければ"],["、"],["その"],["犯した","おかした"],["罪","つみ"],["の"],["ため"],["の"],["ささげ物","ささげもの"],["として"],["、"],["十分","じゅうぶん"],["の"],["一","いち"],["エパ"],["の"],["小麦粉","こむぎこ"],["を"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["として"],["持って","もって"],["来","き"],["なさい"],["。"],["その"],["人","ひと"],["は"],["その"],["上","うえ"],["に"],["油","あぶら"],["を"],["加え","くわえ"],["たり"],["、"],["その"],["上","うえ"],["に"],["乳香","にゅうこう"],["を"],["添え","そえ"],["たり"],["して"],["は"],["ならない"],["。"],["これ"],["は"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["で"],["ある"],["から"],["。"]]},{"verse":12,"text":"彼はそれを祭司のところに持って行きなさい。祭司はそのひとつかみを記念の部分としてそれから取り出し、祭壇の上で、主への火によるささげ物といっしょにそれを焼いて煙にしなさい。これは罪のためのいけにえである。","tok":[["彼","かれ"],["は"],["それ"],["を"],["祭司","さいし"],["の"],["ところ"],["に"],["持って","もって"],["行き","いき"],["なさい"],["。"],["祭司","さいし"],["は"],["その"],["ひとつかみ"],["を"],["記念","きねん"],["の"],["部分","ぶぶん"],["として"],["それ"],["から"],["取り出し","とりだし"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["と"],["いっしょ"],["に"],["それ"],["を"],["焼いて","やいて"],["煙","けむり"],["に"],["し"],["なさい"],["。"],["これ"],["は"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["で"],["ある"],["。"]]},{"verse":13,"text":"祭司はその人のために、その人が犯したこれらの一つの罪の贖いをしなさい。その人は赦される。その残りは、穀物のささげ物と同じく、祭司のものとなる。」","tok":[["祭司","さいし"],["は"],["その"],["人","ひと"],["の"],["ため"],["に"],["、"],["その"],["人","ひと"],["が"],["犯した","おかした"],["これ"],["ら"],["の"],["一","ひと"],["つ"],["の"],["罪","つみ"],["の"],["贖い","あがない"],["を"],["し"],["なさい"],["。"],["その"],["人","ひと"],["は"],["赦される","ゆるされる"],["。"],["その"],["残り","のこり"],["は"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["と"],["同じく","おなじく"],["、"],["祭司","さいし"],["の"],["もの"],["と"],["なる"],["。"],["」"]]},{"verse":14,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":15,"text":"「人が不実なことを行い、あやまって主の聖なるものに対して罪を犯したときは、その償いのために、羊の群れから傷のない雄羊一頭、聖所のシェケルで数シェケルの銀に当たるとあなたが評価したものを取って、罪過のためのいけにえとして主のもとに連れて来る。","tok":[["「"],["人","ひと"],["が"],["不実","ふじつ"],["な"],["こと"],["を"],["行い","おこない"],["、"],["あやまって"],["主","ぬし"],["の"],["聖","せい"],["なる"],["もの"],["に対して","にたいして"],["罪","つみ"],["を"],["犯した","おかした"],["とき"],["は"],["、"],["その"],["償い","つぐない"],["の"],["ため"],["に"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["から"],["傷","きず"],["の"],["ない"],["雄羊","おひつじ"],["一頭","いちとう"],["、"],["聖","せい"],["所","しょ"],["の"],["シェケル"],["で"],["数","すう"],["シェケル"],["の"],["銀","ぎん"],["に"],["当たる","あたる"],["と"],["あなた"],["が"],["評価","ひょうか"],["した"],["もの"],["を"],["取って","とって"],["、"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["として"],["主","ぬし"],["の"],["もと"],["に"],["連れて","つれて"],["来る","くる"],["。"]]},{"verse":16,"text":"彼は、その聖なるものを犯した罪の償いをしなければならない。それにその五分の一を加えて、祭司にそれを渡さなければならない。祭司は、罪過のためのいけにえの雄羊で、彼のために贖いをしなければならない。その人は赦される。","tok":[["彼","かれ"],["は"],["、"],["その"],["聖","せい"],["なる"],["もの"],["を"],["犯した","おかした"],["罪","つみ"],["の"],["償い","つぐない"],["を"],["しなければ"],["ならない"],["。"],["それ"],["に"],["その"],["五分","ごぶん"],["の"],["一","いち"],["を"],["加えて","くわえて"],["、"],["祭司","さいし"],["に"],["それ"],["を"],["渡さなければ","わたさなければ"],["ならない"],["。"],["祭司","さいし"],["は"],["、"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["の"],["雄羊","おひつじ"],["で"],["、"],["彼","かれ"],["の"],["ため"],["に"],["贖い","あがない"],["を"],["しなければ"],["ならない"],["。"],["その"],["人","ひと"],["は"],["赦される","ゆるされる"],["。"]]},{"verse":17,"text":"また、もし人が罪を犯し、主がするなと命じたすべてのうち一つでも行い、それを知らずにいて、後で咎を覚える場合、その咎を負わなければならない。","tok":[["また"],["、"],["もし"],["人","ひと"],["が"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["主","ぬし"],["が"],["する"],["な"],["と"],["命じた","めいじた"],["すべて"],["の"],["うち"],["一","ひと"],["つ"],["で"],["も"],["行い","おこない"],["、"],["それ"],["を"],["知らず","しらず"],["に"],["いて"],["、"],["後","あと"],["で"],["咎","とが"],["を"],["覚える","おぼえる"],["場合","ばあい"],["、"],["その"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":18,"text":"その人は、羊の群れからあなたが評価した傷のない雄羊一頭を取って、罪過のためのいけにえとして祭司のところに連れて来る。祭司は、彼があやまって犯し、しかも自分では知らないでいた過失について、彼のために贖いをする。彼は赦される。","tok":[["その"],["人","ひと"],["は"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["から"],["あなた"],["が"],["評価","ひょうか"],["した"],["傷","きず"],["の"],["ない"],["雄羊","おひつじ"],["一頭","いちとう"],["を"],["取って","とって"],["、"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["として"],["祭司","さいし"],["の"],["ところ"],["に"],["連れて","つれて"],["来る","くる"],["。"],["祭司","さいし"],["は"],["、"],["彼","かれ"],["が"],["あやまって"],["犯し","おかし"],["、"],["しかも"],["自分","じぶん"],["で"],["は"],["知らないで","しらないで"],["いた"],["過失","かしつ"],["について"],["、"],["彼","かれ"],["の"],["ため"],["に"],["贖い","あがない"],["を"],["する"],["。"],["彼","かれ"],["は"],["赦される","ゆるされる"],["。"]]},{"verse":19,"text":"これは罪過のためのいけにえである。彼は確かに主の前に償いの責めを負った。」","tok":[["これ"],["は"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["で"],["ある"],["。"],["彼","かれ"],["は"],["確か","たしか"],["に"],["主","ぬし"],["の"],["前","まえ"],["に"],["償い","つぐない"],["の"],["責め
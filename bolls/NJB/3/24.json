[{"verse":1,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「あなたはイスラエル人に命じて、ともしびを絶えずともしておくために、燈火用の質の良い純粋なオリーブ油を持って来させよ。","tok":[["「"],["あなた"],["は"],["イスラエル"],["人","にん"],["に"],["命じて","めいじて"],["、"],["ともしび"],["を"],["絶えず","たえず"],["ともして"],["おく"],["ため"],["に"],["、"],["燈火用","とうかよう"],["の"],["質","しつ"],["の"],["良い","よい"],["純粋","じゅんすい"],["な"],["オリーブ油","おりーぶゆ"],["を"],["持って","もって"],["来させよ","きさせよ"],["。"]]},{"verse":3,"text":"アロンは会見の天幕の中、あかしの箱の垂れ幕の外側で、夕方から朝まで主の前に絶えず、そのともしびを整えておかなければならない。これは、あなたがたが代々守るべき永遠のおきてである。","tok":[["アロン"],["は"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["中","なか"],["、"],["あかし"],["の"],["箱","ばこ"],["の"],["垂れ幕","たれまく"],["の"],["外側","そとがわ"],["で"],["、"],["夕方","ゆうがた"],["から"],["朝","あさ"],["まで"],["主","ぬし"],["の"],["前","まえ"],["に"],["絶えず","たえず"],["、"],["その"],["ともしび"],["を"],["整えて","ととのえて"],["おかなければ"],["ならない"],["。"],["これ"],["は"],["、"],["あなた"],["がた"],["が"],["代々","だいだい"],["守るべき","まもるべき"],["永遠","えいえん"],["の"],["おきて"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼は純金の燭台の上に、そのともしびを絶えず主の前に整えておかなければならない。","tok":[["彼","かれ"],["は"],["純金","じゅんきん"],["の"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["、"],["その"],["ともしび"],["を"],["絶えず","たえず"],["主","ぬし"],["の"],["前","まえ"],["に"],["整えて","ととのえて"],["おかなければ"],["ならない"],["。"]]},{"verse":5,"text":"あなたは小麦粉を取り、それで輪型のパン十二個を焼く。一つの輪型のパンは十分の二エパである。","tok":[["あなた"],["は"],["小麦粉","こむぎこ"],["を"],["取り","とり"],["、"],["それ"],["で"],["輪型","わがた"],["の"],["パン"],["十二個","じゅうにこ"],["を"],["焼く","やく"],["。"],["一","ひと"],["つ"],["の"],["輪型","わがた"],["の"],["パン"],["は"],["十分","じゅうぶん"],["の"],["二","に"],["エパ"],["で"],["ある"],["。"]]},{"verse":6,"text":"それを主の前の純金の机の上に、一並び六個ずつ、二並びに置く。","tok":[["それ"],["を"],["主","ぬし"],["の"],["前","まえ"],["の"],["純金","じゅんきん"],["の"],["机","つくえ"],["の"],["上","うえ"],["に"],["、"],["一","いち"],["並び","ならび"],["六個","ろくこ"],["ずつ"],["、"],["二","に"],["並び","ならび"],["に"],["置く","おく"],["。"]]},{"verse":7,"text":"それぞれの並びに純粋な乳香を添え、主への火によるささげ物として、これをパンの記念の部分とする。","tok":[["それぞれ"],["の"],["並び","ならび"],["に"],["純粋","じゅんすい"],["な"],["乳香","にゅうこう"],["を"],["添え","そえ"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["として"],["、"],["これ"],["を"],["パン"],["の"],["記念","きねん"],["の"],["部分","ぶぶん"],["と"],["する"],["。"]]},{"verse":8,"text":"彼は安息日ごとに、絶えずこれを主の前に、整えておかなければならない。これはイスラエル人からのものであって永遠の契約である。","tok":[["彼","かれ"],["は"],["安息日","あんそくび"],["ごと"],["に"],["、"],["絶えず","たえず"],["これ"],["を"],["主","ぬし"],["の"],["前","まえ"],["に"],["、"],["整えて","ととのえて"],["おかなければ"],["ならない"],["。"],["これ"],["は"],["イスラエル"],["人","にん"],["から"],["の"],["もの"],["で"],["あって"],["永遠","えいえん"],["の"],["契約","けいやく"],["で"],["ある"],["。"]]},{"verse":9,"text":"これはアロンとその子らのものとなり、彼らはこれを聖なる所で食べる。これは最も聖なるものであり、主への火によるささげ物のうちから、彼の受け取る永遠の分け前である。」","tok":[["これ"],["は"],["アロン"],["と"],["その"],["子","こ"],["ら"],["の"],["もの"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["聖","せい"],["なる"],["所","ところ"],["で"],["食べる","たべる"],["。"],["これ"],["は"],["最も","もっとも"],["聖","せい"],["なる"],["もの"],["で"],["あり"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["の"],["うち"],["から"],["、"],["彼","かれ"],["の"],["受け取る","うけとる"],["永遠","えいえん"],["の"],["分け前","わけまえ"],["で"],["ある"],["。"],["」"]]},{"verse":10,"text":"さて、イスラエルの女を母とし、エジプト人を父とする者が、イスラエル人のうちに出たが、このイスラエルの女の息子と、あるイスラエル人とが宿営の中で争った。","tok":[["さて"],["、"],["イスラエル"],["の"],["女","おんな"],["を"],["母","はは"],["と"],["し"],["、"],["エジプト"],["人","にん"],["を"],["父","ちち"],["と"],["する"],["者","もの"],["が"],["、"],["イスラエル"],["人","にん"],["の"],["うち"],["に"],["出た","でた"],["が"],["、"],["この"],["イスラエル"],["の"],["女","おんな"],["の"],["息子","むすこ"],["と"],["、"],["ある"],["イスラエル"],["人","にん"],["と"],["が"],["宿営","しゅくえい"],["の"],["中","なか"],["で"],["争った","あらそった"],["。"]]},{"verse":11,"text":"そのとき、イスラエルの女の息子が、御名を冒瀆してのろったので、人々はこの者をモーセのところに連れて来た。その母の名はシェロミテで、ダンの部族のディブリの娘であった。","tok":[["その"],["とき"],["、"],["イスラエル"],["の"],["女","おんな"],["の"],["息子","むすこ"],["が"],["、"],["御名","ぎょめい"],["を"],["冒瀆","ぼうとく"],["して"],["のろった"],["ので"],["、"],["人々","ひとびと"],["は"],["この"],["者","もの"],["を"],["モーセ"],["の"],["ところ"],["に"],["連れて","つれて"],["来た","きた"],["。"],["その"],["母","はは"],["の"],["名","な"],["は"],["シェロミテ"],["で"],["、"],["ダン"],["の"],["部族","ぶぞく"],["の"],["ディブリ"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":12,"text":"人々は主の命令をまって彼らにはっきりと示すため、この者を監禁しておいた。","tok":[["人々","ひとびと"],["は"],["主","ぬし"],["の"],["命令","めいれい"],["を"],["まって"],["彼","かれ"],["ら"],["に"],["はっきり"],["と"],["示す","しめす"],["ため"],["、"],["この"],["者","もの"],["を"],["監禁","かんきん"],["して"],["おいた"],["。"]]},{"verse":13,"text":"そこで、主はモーセに告げて仰せられた。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":14,"text":"「あの、のろった者を宿営の外に連れ出し、それを聞いた者はすべてその者の頭の上に手を置き、全会衆はその者に石を投げて殺せ。","tok":[["「"],["あの"],["、"],["のろった"],["者","もの"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["連れ出し","つれだし"],["、"],["それ"],["を"],["聞いた","きいた"],["者","もの"],["は"],["すべて"],["その"],["者","もの"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置き","おき"],["、"],["全","ぜん"],["会衆","かいしゅう"],["は"],["その"],["者","もの"],["に"],["石","いし"],["を"],["投げて","なげて"],["殺せ","ころせ"],["。"]]},{"verse":15,"text":"あなたはイスラエル人に告げて言え。自分の神をのろう者はだれでも、その罪の罰を受ける。","tok":[["あなた"],["は"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["自分","じぶん"],["の"],["神","かみ"],["を"],["の"],["ろう者","ろうしゃ"],["は"],["だれ"],["で"],["も"],["、"],["その"],["罪","つみ"],["の"],["罰","ばつ"],["を"],["受ける","うける"],["。"]]},{"verse":16,"text":"主の御名を冒瀆する者は必ず殺されなければならない。全会衆は必ずその者に石を投げて殺さなければならない。在留異国人でも、この国に生まれた者でも、御名を冒瀆するなら、殺される。","tok":[["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["冒瀆","ぼうとく"],["する"],["者","もの"],["は"],["必ず","かならず"],["殺されなければ","ころされなければ"],["ならない"],["。"],["全","ぜん"],["会衆","かいしゅう"],["は"],["必ず","かならず"],["その"],["者","もの"],["に"],["石","いし"],["を"],["投げて","なげて"],["殺さなければ","ころさなければ"],["ならない"],["。"],["在留","ざいりゅう"],["異国人","いこくにん"],["で"],["も"],["、"],["この"],["国","くに"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["も"],["、"],["御名","ぎょめい"],["を"],["冒瀆","ぼうとく"],["するなら"],["、"],["殺される","ころされる"],["。"]]},{"verse":17,"text":"かりそめにも人を打ち殺す者は、必ず殺される。","tok":[["かりそめ"],["に"],["も"],["人","ひと"],["を"],["打ち殺す","うちころす"],["者","もの"],["は"],["、"],["必ず","かならず"],["殺される","ころされる"],["。"]]},{"verse":18,"text":"動物を打ち殺す者は、いのちに
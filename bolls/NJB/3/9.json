[{"verse":1,"text":"それから、八日目になって、モーセはアロンとその子ら、およびイスラエルの長老たちを呼び寄せ、","tok":[["それ"],["から"],["、"],["八日目","ようかめ"],["に"],["なって"],["、"],["モーセ"],["は"],["アロン"],["と"],["その"],["子","こ"],["ら"],["、"],["および"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["を"],["呼び寄せ","よびよせ"],["、"]]},{"verse":2,"text":"アロンに言った。「あなたは、子牛、すなわち、若い牛を罪のためのいけにえとして、雄羊を全焼のいけにえとして、それもまた傷のないものを取って、主の前にささげなさい。","tok":[["アロン"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["子牛","こうし"],["、"],["すなわち"],["、"],["若い","わかい"],["牛","うし"],["を"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["として"],["、"],["雄羊","おひつじ"],["を"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["、"],["それ"],["も"],["また"],["傷","きず"],["の"],["ない"],["もの"],["を"],["取って","とって"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["ささげ"],["なさい"],["。"]]},{"verse":3,"text":"あなたはまた、イスラエル人に告げて言わなければならない。あなたがたは、雄やぎを罪のためのいけにえとして、また、一歳の傷のない子牛と子羊とを全焼のいけにえとして取りなさい。","tok":[["あなた"],["は"],["また"],["、"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言わなければ","いわなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["、"],["雄","おす"],["やぎ"],["を"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["として"],["、"],["また"],["、"],["一歳","いちさい"],["の"],["傷","きず"],["の"],["ない"],["子牛","こうし"],["と"],["子羊","こひつじ"],["と"],["を"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["取り","とり"],["なさい"],["。"]]},{"verse":4,"text":"また主へのいけにえとして、和解のいけにえのための雄牛と雄羊を、また、油を混ぜた穀物のささげ物を、取りなさい。それは、きょう主があなたがたに現れるからである。」","tok":[["また"],["主","ぬし"],["へ"],["の"],["いけにえ"],["として"],["、"],["和解","わかい"],["の"],["いけにえ"],["の"],["ため"],["の"],["雄牛","おうし"],["と"],["雄羊","おひつじ"],["を"],["、"],["また"],["、"],["油","あぶら"],["を"],["混ぜた","まぜた"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["、"],["取り","とり"],["なさい"],["。"],["それ"],["は"],["、"],["きょう"],["主","ぬし"],["が"],["あなた"],["がた"],["に"],["現れる","あらわれる"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"そこで彼らは、モーセが命じたものを会見の天幕の前に持って来て、全会衆が近づき、主の前に立った。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["モーセ"],["が"],["命じた","めいじた"],["もの"],["を"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["前","まえ"],["に"],["持って","もって"],["来て","きて"],["、"],["全","ぜん"],["会衆","かいしゅう"],["が"],["近づき","ちかづき"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":6,"text":"モーセは言った。「これは、あなたがたが行うように主が命じられたことである。こうして主の栄光があなたがたに現れるためである。」","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["これ"],["は"],["、"],["あなた"],["がた"],["が"],["行う","おこなう"],["よう"],["に"],["主","ぬし"],["が"],["命じられた","めいじられた"],["こと"],["で"],["ある"],["。"],["こう"],["して"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["あなた"],["がた"],["に"],["現れる","あらわれる"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":7,"text":"それから、モーセはアロンに言った。「祭壇に近づきなさい。あなたの罪のためのいけにえと全焼のいけにえをささげ、あなた自身のため、またこの民のために贖いをしなさい。また民のささげ物をささげ、主が命じられたとおりに、彼らのために贖いをしなさい。」","tok":[["それ"],["から"],["、"],["モーセ"],["は"],["アロン"],["に"],["言った","いった"],["。"],["「"],["祭壇","さいだん"],["に"],["近づき","ちかづき"],["なさい"],["。"],["あなた"],["の"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["と"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["あなた"],["自身","じしん"],["の"],["ため"],["、"],["また"],["この"],["民","たみ"],["の"],["ため"],["に"],["贖い","あがない"],["を"],["し"],["なさい"],["。"],["また"],["民","みん"],["の"],["ささげ物","ささげもの"],["を"],["ささげ"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["贖い","あがない"],["を"],["し"],["なさい"],["。"],["」"]]},{"verse":8,"text":"そこで、アロンは祭壇に近づき、自分のために罪のためのいけにえの子牛をほふった。","tok":[["そこ"],["で"],["、"],["アロン"],["は"],["祭壇","さいだん"],["に"],["近づき","ちかづき"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["の"],["子牛","こうし"],["を"],["ほふった"],["。"]]},{"verse":9,"text":"アロンの子らは、その血を彼に差し出し、彼は指をその血に浸し、祭壇の角に塗った。彼はその血を祭壇の土台に注いだ。","tok":[["アロン"],["の"],["子","こ"],["ら"],["は"],["、"],["その"],["血","ち"],["を"],["彼","かれ"],["に"],["差し出し","さしだし"],["、"],["彼","かれ"],["は"],["指","ゆび"],["を"],["その"],["血","ち"],["に"],["浸し","ひたし"],["、"],["祭壇","さいだん"],["の"],["角","かど"],["に"],["塗った","ぬった"],["。"],["彼","かれ"],["は"],["その"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["土台","どだい"],["に"],["注いだ","そそいだ"],["。"]]},{"verse":10,"text":"彼は罪のためのいけにえからの脂肪と腎臓と肝臓の小葉を祭壇の上で焼いて煙にした。主がモーセに命じられたとおりである。","tok":[["彼","かれ"],["は"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["から"],["の"],["脂肪"
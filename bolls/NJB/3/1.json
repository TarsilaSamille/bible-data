[{"verse":1,"text":"主はモーセを呼び寄せ、会見の天幕から彼に告げて仰せられた。","tok":[["主","ぬし"],["は"],["モーセ"],["を"],["呼び寄せ","よびよせ"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["から"],["彼","かれ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人に告げて言え。もし、あなたがたが主にささげ物をささげるときは、だれでも、家畜の中から牛か羊をそのささげ物としてささげなければならない。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["もし"],["、"],["あなた"],["がた"],["が"],["主に","おもに"],["ささげ物","ささげもの"],["を"],["ささげる"],["とき"],["は"],["、"],["だれ"],["で"],["も"],["、"],["家畜","かちく"],["の"],["中","なか"],["から"],["牛","うし"],["か"],["羊","ひつじ"],["を"],["その"],["ささげ物","ささげもの"],["として"],["ささげなければ"],["ならない"],["。"]]},{"verse":3,"text":"もしそのささげ物が、牛の全焼のいけにえであれば、傷のない雄牛をささげなければならない。それを、彼が主の前に受け入れられるために会見の天幕の入口の所に連れて来なければならない。","tok":[["もし"],["その"],["ささげ物","ささげもの"],["が"],["、"],["牛","うし"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["で"],["あれば"],["、"],["傷","きず"],["の"],["ない"],["雄牛","おうし"],["を"],["ささげなければ"],["ならない"],["。"],["それ"],["を"],["、"],["彼","かれ"],["が"],["主","ぬし"],["の"],["前","まえ"],["に"],["受け入れられる","うけいれられる"],["ため"],["に"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["の"],["所","ところ"],["に"],["連れて","つれて"],["来なければ","こなければ"],["ならない"],["。"]]},{"verse":4,"text":"その人は、全焼のいけにえの頭の上に手を置く。それが彼を贖うため、彼の代わりに受け入れられるためである。","tok":[["その"],["人","ひと"],["は"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置く","おく"],["。"],["それ"],["が"],["彼","かれ"],["を"],["贖う","あがなう"],["ため"],["、"],["彼","かれ"],["の"],["代わり","かわり"],["に"],["受け入れられる","うけいれられる"],["ため"],["で"],["ある"],["。"]]},{"verse":5,"text":"その若い牛は、主の前でほふり、祭司であるアロンの子らは、その血を持って行って、会見の天幕の入口にある祭壇の回りに、その血を注ぎかけなさい。","tok":[["その"],["若い","わかい"],["牛","うし"],["は"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["ほふり"],["、"],["祭司","さいし"],["で"],["ある"],["アロン"],["の"],["子","こ"],["ら"],["は"],["、"],["その"],["血","ち"],["を"],["持って","もって"],["行って","いって"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["ある"],["祭壇","さいだん"],["の"],["回り","まわり"],["に"],["、"],["その"],["血","ち"],["を"],["注ぎ","そそぎ"],["かけ"],["なさい"],["。"]]},{"verse":6,"text":"また、その全焼のいけにえの皮をはぎ、いけにえを部分に切り分けなさい。","tok":[["また"],["、"],["その"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["皮","かわ"],["を"],["はぎ"],["、"],["いけにえ"],["を"],["部分","ぶぶん"],["に"],["切り分け","きりわけ"],["なさい"],["。"]]},{"verse":7,"text":"祭司であるアロンの子らは祭壇の上に火を置き、その火の上にたきぎを整えなさい。","tok":[["祭司","さいし"],["で"],["ある"],["アロン"],["の"],["子","こ"],["ら"],["は"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["火","ひ"],["を"],["置き","おき"],["、"],["その"],["火","ひ"],["の"],["上","うえ"],["に"],["たきぎ"],["を"],["整え","ととのえ"],["なさい"],["。"]]},{"verse":8,"text":"祭司であるアロンの子らは、その切り分けた部分と、頭と、脂肪とを祭壇の上にある火の上のたきぎの上に整えなさい。","tok":[["祭司","さいし"],["で"],["ある"],["アロン"],["の"],["子","こ"],["ら"],["は"],["、"],["その"],["切り分けた","きりわけた"],["部分","ぶぶん"],["と"],["、"],["頭","あたま"],["と"],["、"],["脂肪","しぼう"],["と"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["ある"],["火","ひ"],["の"],["上","うえ"],["の"],["たきぎ"],["の"],["上","うえ"],["に"],["整え","ととのえ"],["なさい"],["。"]]},{"verse":9,"text":"内臓と足は、水で洗わなければならない。祭司はこれら全部を祭壇の上で全焼のいけにえとして焼いて煙にする。これは、主へのなだめのかおりの火によるささげ物である。","tok":[["内臓","ないぞう"],["と"],["足","あし"],["は"],["、"],["水","みず"],["で"],["洗わなければ","あらわなければ"],["ならない"],["。"],["祭司","さいし"],["は"],["これ"],["ら"],["全部","ぜんぶ"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["焼いて","やいて"],["煙","けむり"],["に"],["する"],["。"],["これ"],["は"],["、"],["主","ぬし"],["へ"],["の"],["なだめ"],["の"],["かおり"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["で"],["ある"],["。"]]},{"verse":10,"text":"しかし、もし全焼のいけにえのためのささげ物が、羊の群れ、すなわち子羊またはやぎの中からなら、傷のない雄でなければならない。","tok":[["しかし"],["、"],["もし"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["ため"],["の"],["ささげ物","ささげもの"],["が"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["すなわち"],["子羊","こひつじ"],["また"],["は"],["やぎ"],["の"],["中","なか"],["から"],["なら"],["、"],["傷","きず"],["の"],["ない"],["雄","おす"],["で"],["なければ"],["ならない"],["。"]]},{"verse":11,"text":"祭壇の北側で、主の前にこれをほふりなさい。そして祭司であるアロンの子らは、その血を祭壇の回りに注ぎかけなさい。","tok":[["祭壇","さいだん"],["の"],["北側","きたがわ"],["で"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["これ"],["を"],["ほふり"],["なさい"],["。"],["そして"],["祭司","さいし"],["で"],["ある"],["アロン"],["の"],["子","こ"],["ら"],["は"],["、"],["その"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["回り","まわり"],["に"],["注ぎ","そそぎ"],["かけ"],["なさい"],["。"]]},{"verse":12,"text":"また、それを、部分に切り分け、祭司はこれを頭と脂肪に添えて祭壇の上にある火の上のたきぎの上に整えなさい。","tok":[["また"],["、"],["それ"],["を"],["、"],["部分","ぶぶん"],["に"],["切り分け","きりわけ"],["、"],["祭司","さいし"],["は"],["これ"],["を"],["頭","あたま"],["と"],["脂肪","しぼう"],["に"],["添えて","そえて"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["ある"],["火","ひ"],["の"],["上","うえ"],["の"],["たきぎ"],["の"],["上","うえ"],["に"],["整え","ととのえ"],["なさい"],["。"]]},{"verse":13,"text":"内臓と足は、水で洗わなければならない。こうして祭司はそれら全部をささげ、祭壇の上で焼いて煙にしなさい。これは全焼のいけにえであり、主へのなだめのかおりの火によるささげ物である。","tok":[["内臓","ないぞう"],["と"],["足","あし"],["は"],["、"],["水","みず"],["で"],["洗わなければ","あらわなければ"],["ならない"],["。"],["こう"],["して"],["祭司","さいし"],["は"],["それ"],["ら"],["全部","ぜんぶ"],["を"],["ささげ"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いて","やいて"],["煙","けむり"],["に"],["し"],["なさい"],["。"],["これ"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["で"],["あり"],["、"],["主","ぬし"],["へ"],["の"],["なだめ"],["の"],["かおり"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["で"],["ある"],["。"]]},{"verse":14,"text":"もしその人の主へのささげ物が、鳥の全焼のいけにえであるなら、山鳩または家鳩のひなの中から、そのささげ物をささげなければならない。","tok":[["もし"],["その"],["人","ひと"],["の"],["主","ぬし"],["へ"],["の"],["ささげ物","ささげもの"],["が"],["、"],["鳥","とり"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["で"],["あるなら"],["、"],["山鳩","やまばと"],["また"],["は"],["家鳩","いえばと"],["の"],["ひな"],["の"],["中","なか"],["から"],["、"],["その"],["ささげ物","ささげもの"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":15,"text":"祭司は、それを祭壇のところに持って来て、その頭をひねり裂き、祭壇の上でそれを焼いて煙にしなさい。ただし、その血は祭壇の側面に絞り出す。","tok":[["祭司","さいし"],["は"],["、"],["それ"],["を"],["祭壇","さいだん"],["の"],["ところ"],["に"],["持って","もって"],["来て","きて"],["、"],["その"],["頭","あたま"],["を"],["ひねり"],["裂き","さき"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["それ"],["を"],["焼いて","やいて"],["煙","けむり"],["に"],["し"],["なさい"],["。"],["ただし"],["、"],["その"],["血","ち"],["は"],["祭壇","さいだん"],["の"],["側面","そくめん"],["に"],["絞り出す","しぼりだす"],["。"]]},{"verse":16,"text":"またその汚物の入った餌袋を取り除き、祭壇の東側の灰捨て場に投げ捨てなさい。","tok":[["また"],["その"],["汚物","おぶつ"],["の"],["入った","はいった"],["餌袋","えさぶくろ"],["を"],["取り除き","とりのぞき"],["、"],["祭壇","さいだん"],["の"],["東側","ひがしがわ"],["の"],["灰","はい"],["捨て場","すてば"],["に"],["投げ捨て","なげすて"],["なさい"],["。"]]},{"verse":17,"text":"さらに、その翼を引き裂きなさい。それを切り離してはならない。そして、祭司はそれを祭壇の上、火の上にあるたきぎの上で焼いて煙にしなさい。これは全焼のいけにえであり、主へのなだめのかおりの火によるささげ物である。","tok":[["さらに"],["、"],["その"],["翼","つばさ"],["を"],["引き裂き","ひきさき"],["なさい"],["。"],["それ"],["を"],["切り離して","きりはなして"],["は"],["ならない"],["。"],["そして"],["、"],["祭司","さいし"],["は"],["それ"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["、"],["火","ひ"],["の"],["上","うえ"],["に"],["ある"],["たきぎ"],["の"],["上","うえ"],["で"],["焼いて","やいて"],["煙","けむり"],["に"],["し"],["なさい"],["。"],["これ"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["で"],["あり"],["、"],["主","ぬし"],["へ"],["の"],["なだめ"],["の"],["かおり"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["で"],["ある"],["。"]]}]
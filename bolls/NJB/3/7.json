[{"verse":1,"text":"罪過のためのいけにえのおしえは次のとおりである。これは、最も聖なるものである。","tok":[["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["の"],["おしえ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["これ"],["は"],["、"],["最も","もっとも"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"罪過のためのいけにえは、全焼のいけにえをほふる場所で、ほふらなければならない。そして、その血を祭壇の回りに注ぎかけなければならない。","tok":[["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["は"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ほふる"],["場所","ばしょ"],["で"],["、"],["ほふらなければ"],["ならない"],["。"],["そして"],["、"],["その"],["血","ち"],["を"],["祭壇","さいだん"],["の"],["回り","まわり"],["に"],["注ぎ","そそぎ"],["かけなければ"],["ならない"],["。"]]},{"verse":3,"text":"それから取った脂肪を全部、すなわち、あぶら尾と内臓をおおう脂肪、","tok":[["それ"],["から"],["取った","とった"],["脂肪","しぼう"],["を"],["全部","ぜんぶ"],["、"],["すなわち"],["、"],["あぶら"],["尾","お"],["と"],["内臓","ないぞう"],["を"],["おおう"],["脂肪","しぼう"],["、"]]},{"verse":4,"text":"二つの腎臓と、それについていて腰のあたりにある脂肪、さらに腎臓といっしょに取り除いた肝臓の上の小葉とをささげなければならない。","tok":[["二","ふた"],["つ"],["の"],["腎臓","じんぞう"],["と"],["、"],["それ"],["について"],["いて"],["腰","こし"],["の"],["あたり"],["に"],["ある"],["脂肪","しぼう"],["、"],["さらに"],["腎臓","じんぞう"],["と"],["いっしょ"],["に"],["取り除いた","とりのぞいた"],["肝臓","かんぞう"],["の"],["上","うえ"],["の"],["小葉","こば"],["と"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":5,"text":"祭司は、それらを祭壇の上で主への火によるささげ物として、焼いて煙にしなさい。これは罪過のためのいけにえである。","tok":[["祭司","さいし"],["は"],["、"],["それ"],["ら"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["として"],["、"],["焼いて","やいて"],["煙","けむり"],["に"],["し"],["なさい"],["。"],["これ"],["は"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["で"],["ある"],["。"]]},{"verse":6,"text":"祭司たちのうち、男子はみな、それを食べることができる。それを聖なる所で食べなければならない。これは最も聖なるものである。","tok":[["祭司","さいし"],["たち"],["の"],["うち"],["、"],["男子","だんし"],["は"],["みな"],["、"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["それ"],["を"],["聖","せい"],["なる"],["所","ところ"],["で"],["食べなければ","たべなければ"],["ならない"],["。"],["これ"],["は"],["最も","もっとも"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["。"]]},{"verse":7,"text":"罪のためのいけにえと罪過のためのいけにえについてのおしえは一つである。そのいけにえはそれをもって贖いをする祭司のものとなる。","tok":[["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["と"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["について"],["の"],["おしえ"],["は"],["一","ひと"],["つ"],["で"],["ある"],["。"],["その"],["いけにえ"],["は"],["それ"],["を"],["もって"],["贖い","あがない"],["を"],["する"],["祭司","さいし"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":8,"text":"祭司が、ある人の全焼のいけにえをささげるとき、そのささげた全焼のいけにえの皮はその祭司のものとなる。","tok":[["祭司","さいし"],["が"],["、"],["ある"],["人","ひと"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげる"],["とき"],["、"],["その"],["ささげた"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["皮","かわ"],["は"],["その"],["祭司","さいし"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":9,"text":"さらに、かまどで焼いた穀物のささげ物全部、およびなべや平なべで作られたものはみな、それをささげる祭司のものとなる。","tok":[["さらに"],["、"],["かまど"],["で"],["焼いた","やいた"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["全部","ぜんぶ"],["、"],["および"],["なべ"],["や"],["平なべ","ひらなべ"],["で"],["作られた","つくられた"],["もの"],["は"],["みな"],["、"],["それ"],["を"],["ささげる"],["祭司","さいし"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":10,"text":"また、穀物のささげ物で油を混ぜたものも、かわいたものもみな、ひとしくアロンの子ら全員のものとなる。","tok":[["また"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["で"],["油","あぶら"],["を"],["混ぜた","まぜた"],["もの"],["も"],["、"],["かわいた"],["もの"],["も"],["みな"],["、"],["ひとしく"],["アロン"],["の"],["子","こ"],["ら"],["全員","ぜんいん"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":11,"text":"主にささげる和解のいけにえのおしえは次のとおりである。","tok":[["主に","おもに"],["ささげる"],["和解","わかい"],["の"],["いけにえ"],["の"],["おしえ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":12,"text":"もし、それを感謝のためにささげるのなら、感謝のいけにえに添えて、油を混ぜた種を入れない輪型のパンと、油を塗った種を入れないせんべい、さらに油を混ぜてよくこねた小麦粉の輪型のパンをささげなければならない。","tok":[["もし"],["、"],["それ"],["を"],["感謝","かんしゃ"],["の"],["ため"],["に"],["ささげる"],["の"],["なら"],["、"],["感謝","かんしゃ"],["の"],["いけにえ"],["に"],["添えて","そえて"],["、"],["油","あぶら"],["を"],["混ぜた","まぜた"],["種","たね"],["を"],["入れない","いれない"],["輪型","わがた"],["の"],["パン"],["と"],["、"],["油","あぶら"],["を"],["塗った","ぬった"],["種","たね"],["を"],["入れない","いれない"],["せんべい"],["、"],["さらに"],["油","あぶら"],["を"],["混ぜて","まぜて"],["よく"],["こねた"],["小麦粉","こむぎこ"],["の"],["輪型","わがた"],["の"],["パン"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":13,"text":"なお和解のための感謝のいけにえに添えて、種を入れた輪型のパンをささげなさい。","tok":[["なお"],["和解","わかい"],["の"],["ため"],["の"],["感謝","かんしゃ"],["の"],["いけにえ"],["に"],["添えて","そえて"],["、"],["種","しゅ"],["を"],["入れた","いれた"],["輪型","わがた"],["の"],["パン"],["を"],["ささげ"],["なさい"],["。"]]},{"verse":14,"text":"そのうちから、おのおののささげ物の一つを取って、主への奉納物として、ささげなければならない。これは、和解のいけにえの血を注ぎかける祭司のものとなる。","tok":[["その"],["うち"],["から"],["、"],["おのおの"],["の"],["ささげ物","ささげもの"],["の"],["一","ひと"],["つ"],["を"],["取って","とって"],["、"],["主","ぬし"],["へ"],["の"],["奉納物","ほうのうぶつ"],["として"],["、"],["ささげなければ"],["ならない"],["。"],["これ"],["は"],["、"],["和解","わかい"],["の"],["いけにえ"],["の"],["血","ち"],["を"],["注ぎ","そそぎ"],["かける"],["祭司","さいし"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":15,"text":"和解のための感謝のいけにえの肉は、それがささげられるその日に食べ、そのうちの少しでも朝まで残しておいてはならない。","tok":[["和解","わかい"],["の"],["ため"],["の"],["感謝","かんしゃ"],["の"],["いけにえ"],["の"],["肉","にく"],["は"],["、"],["それ"],["が"],["ささげられる"],["その"],["日","ひ"],["に"],["食べ","たべ"],["、"],["その"],["うち"],["の"],["少し","すこし"],["で"],["も"],["朝","あさ"],["まで"],["残して","のこして"],["おいて"],["は"],["ならない"],["。"]]},{"verse":16,"text":"もしそのささげ物のいけにえが、誓願あるいは進んでささげるささげ物であるなら、彼がそのいけにえをささげる日に食べなければならない。残った余りを、翌日食べてもさしつかえない。","tok":[["もし"],["その"],["ささげ物","ささげもの"],["の"],["いけにえ"],["が"],["、"],["誓願","せいがん"],["あるいは"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["で"],["あるなら"],["、"],["彼","かれ"],["が"],["その"],["いけにえ"],["を"],["ささげる"],["日","ひ"],["に"],["食べなければ","たべなければ"],["ならない"],["。"],["残った","のこった"],["余り","あまり"],["を"],["、"],["翌日","よくじつ"],["食べて","たべて"],["も"],["さしつかえない"],["。"]]},{"verse":17,"text":"いけにえの肉の残った余りは三日目に火で焼かなければならない。","tok":[["いけにえ"],["の"],["肉","にく"],["の"],["残った","のこった"],["余り","あまり"],["は"],["三日目","みっかめ"],["に"],["火","ひ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":18,"text":"もし三日目にその和解のいけにえの肉を食べるようなことがあれば、それは受け入れられず、またそれをささげる人のものとは認められない。これは、汚れたものであり、そのいくらかでも食べる者はその咎を負わなければならない。","tok":[["もし"],["三日目","みっかめ"],["に"],["その"],["和解","わかい"],["の"],["いけにえ"],["の"],["肉","にく"],["を"],["食べる","たべる"],["よう"],["な"],["こと"],["が"],["あれば"],["、"],["それ"],["は"],["受け入れられず","うけいれられず"],["、"],["また"],["それ"],["を"],["ささげる"],["人","ひと"],["の"],["もの"],["と"],["は"],["認められない","みとめられない"],["。"],["これ"],["は"],["、"],["汚れた","よごれた"],["もの"],["で"],["あり"],["、"],["その"],["いくら"],["か"],["で"],["も"],["食べる","たべる"],["者","もの"],["は"],["その"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":19,"text":"また、何であろうと汚れた物に触れたなら、その肉は、食べてはならない。それは火で焼かなければならない。その他の肉ならば、きよい者はだれでもその肉を食べることができる。","tok":[["また"],["、"],["何","なん"],["で"],["あろう"],["と"],["汚れた","よごれた"],["物","もの"],["に"],["触れたなら","ふれたなら"],["、"],["その"],["肉","にく"],["は"],["、"],["食べて","たべて"],["は"],["ならない"],["。"],["それ"],["は"],["火","ひ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"],["その"],["他","た"],["の"],["肉","にく"],["ならば"],["、"],["きよい"],["者","もの"],["は"],["だれ"],["で"],["も"],["その"],["肉","にく"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":20,"text":"人がその身の汚れがあるのに、主への和解のいけにえの肉を食べるなら、その者はその民から断ち切られる。","tok":[["人","ひと"],["が"],["その"],["身","み"],["の"],["汚れ","よごれ"],["が"],["ある"],["のに"],["、"],["主","ぬし"],["へ"],["の"],["和解","わかい"],["の"],["いけにえ"],["の"],["肉","にく"],["を"],["食べるなら","たべるなら"],["、"],["その"],["者","もの"],["は"],["その"],["民","たみ"],["から"],["断ち切られる","たちきられる"],["。"]]},{"verse":21,"text":"また、人が、何であろうと汚れた物に、すなわち人の汚れ、あるいは汚れた動物、あるいはすべて汚れた忌むべき物に触れていながら、主への和解のいけにえの肉を食べるなら、その者はその民から断ち切られる。」","tok":[["また"],["、"],["人","ひと"],["が"],["、"],["何","なん"],["で"],["あろう"],["と"],["汚れた","よごれた"],["物","もの"],["に"],["、"],["すなわち"],["人","ひと"],["の"],["汚れ","よごれ"],["、"],["あるいは"],["汚れた","よごれた"],["動物","どうぶつ"],["、"],["あるいは"],["すべて"],["汚れた","よごれた"],["忌むべき","いむべき"],["物","もの"],["に"],["触れて","ふれて"],["い"],["ながら"],["、"],["主","ぬし"],["へ"],["の"],["和解","わかい"],["の"],["いけにえ"],["の"],["肉","にく"],["を"],["食べるなら","たべるなら"],["、"],["その"],["者","もの"],["は"],["その"],["民","たみ"],["から"],["断ち切られる","たちきられる"],["。"],["」"]]},{"verse":22,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":23,"text":"「イスラエル人に告げて言え。あなたがたは、牛や、羊、あるいはやぎの脂肪をいっさい食べてはならない。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["あなた"],["がた"],["は"],["、"],["牛","うし"],["や"],["、"],["羊","ひつじ"],["、"],["あるいは"],["やぎ"],["の"],["脂肪","しぼう"],["を"],["いっさい"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":24,"text":"死んだ動物の脂肪や野獣に引き裂かれた動物の脂肪は、何に使ってもさしつかえない。しかし、決してそれを食べてはならない。","tok":[["死んだ","しんだ"],["動物","どうぶつ"],["の"],["脂肪","しぼう"],["や"],["野獣","やじゅう"],["に"],["引き裂かれた","ひきさかれた"],["動物","どうぶつ"],["の"],["脂肪","しぼう"],["は"],["、"],["何","なん"],["に"],["使って","つかって"],["も"],["さしつかえない"],["。"],["しかし"],["、"],["決して","けっして"],["それ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":25,"text":"すべて、火によるささげ物として主にささげる動物の脂肪を食べる者、これを食べる者は、その民から断ち切られるからである。","tok":[["すべて"],["、"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["として"],["主に","おもに"],["ささげる"],["動物","どうぶつ"],["の"],["脂肪","しぼう"],["を"],["食べる","たべる"],["者","もの"],["、"],["これ"],["を"],["食べる","たべる"],["者","もの"],["は"],["、"],["その"],["民","たみ"],["から"],["断ち切られる","たちきられる"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"また、あなたがたのどこの居住地においても、鳥でも動物でも、その血をいっさい食べてはならない。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["どこ"],["の"],["居住地","きょじゅうち"],["に"],["おいて"],["も"],["、"],["鳥","とり"],["で"],["も"],["動物","どうぶつ"],["で"],["も"],["、"],["その"],["血","ち"],["を"],["いっさい"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":27,"text":"どんな血でもこれを食べる者はだれでも、その者はその民から断ち切られる。」","tok":[["どんな"],["血","ち"],["で"],["も"],["これ"],["を"],["食べる","たべる"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["その"],["者","もの"],["は"],["その"],["民","たみ"],["から"],["断ち切られる","たちきられる"],["。"],["」"]]},{"verse":28,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":29,"text":"「イスラエル人に告げて言え。和解のいけにえを主にささげる者は、その和解のいけにえのうちから、そのささげ物を主のところに持って来なければならない。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["和解","わかい"],["の"],["いけにえ"],["を"],["主に","おもに"],["ささげる"],["者","もの"],["は"],["、"],["その"],["和解","わかい"],["の"],["いけにえ"],["の"],["うち"],["から"],["、"],["その"],["ささげ物","ささげもの"],["を"],["主","ぬし"],["の"],["ところ"],["に"],["持って","もって"],["来なければ","こなければ"],["ならない"],["。"]]},{"verse":30,"text":"その者は、主への火によるささげ物を、自分で持って来なければならない。すなわち彼は、その脂肪を胸に添えて持って来なければならない。そしてその胸を奉献物として主に向かって揺り動かしなさい。","tok":[["その"],["者","もの"],["は"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["を"],["、"],["自分","じぶん"],["で"],["持って","もって"],["来なければ","こなければ"],["ならない"],["。"],["すなわち"],["彼","かれ"],["は"],["、"],["その"],["脂肪","しぼう"],["を"],["胸","むね"],["に"],["添えて","そえて"],["持って","もって"],["来なければ","こなければ"],["ならない"],["。"],["そして"],["その"],["胸","むね"],["を"],["奉献物","ほうけんぶつ"],["として"],["主に","おもに"],["向かって","むかって"],["揺り動かし","ゆりうごかし"],["なさい"],["。"]]},{"verse":31,"text":"祭司はその脂肪を祭壇の上で焼いて煙にしなさい。その胸はアロンとその子らのものとなる。","tok":[["祭司","さいし"],["は"],["その"],["脂肪","しぼう"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["焼いて","やいて"],["煙","けむり"],["に"],["し"],["なさい"],["。"],["その"],["胸","むね"],["は"],["アロン"],["と"],["その"],["子","こ"],["ら"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":32,"text":"あなたがたは、あなたがたの和解のいけにえのうちから右のももを、奉納物として祭司に与えなければならない。","tok":[["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["和解","わかい"],["の"],["いけにえ"],["の"],["うち"],["から"],["右","みぎ"],["の"],["もも"],["を"],["、"],["奉納物","ほうのうぶつ"],["として"],["祭司","さいし"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":33,"text":"その右のももは、アロンの子らのうち、和解のいけにえの血と脂肪をささげる者の受ける分として、その人のものとなる。","tok":[["その"],["右","みぎ"],["の"],["もも"],["は"],["、"],["アロン"],["の"],["子","こ"],["ら"],["の"],["うち"],["、"],["和解","わかい"],["の"],["いけにえ"],["の"],["血","ち"],["と"],["脂肪","しぼう"],["を"],["ささげる"],["者","もの"],["の"],["受ける","うける"],["分","ぶん"],["として"],["、"],["その"],["人","ひと"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":34,"text":"それは、わたしが、奉献物の胸と奉納物のももをイスラエル人から、その和解のいけにえのうちから取って、それを祭司アロンとその子らに、イスラエル人から受け取る永遠の分け前として与えたからである。」","tok":[["それ"],["は"],["、"],["わたし"],["が"],["、"],["奉献物","ほうけんぶつ"],["の"],["胸","むね"],["と"],["奉納物","ほうのうぶつ"],["の"],["もも"],["を"],["イスラエル"],["人","にん"],["から"],["、"],["その"],["和解","わかい"],["の"],["いけにえ"],["の"],["うち"],["から"],["取って","とって"],["、"],["それ"],["を"],["祭司","さいし"],["アロン"],["と"],["その"],["子","こ"],["ら"],["に"],["、"],["イスラエル"],["人","にん"],["から"],["受け取る","うけとる"],["永遠","えいえん"],["の"],["分け前","わけまえ"],["として"],["与えた","あたえた"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":35,"text":"これは、モーセが彼らを近づけて、祭司として主に仕えさせた日から、アロンとその子らが、主への火によるささげ物のうちから、受ける分であって、","tok":[["これ"],["は"],["、"],["モーセ"],["が"],["彼","かれ"],["ら"],["を"],["近づけて","ちかづけて"],["、"],["祭司","さいし"],["として"],["主に","おもに"],["仕えさせた","つかえさせた"],["日","ひ"],["から"],["、"],["アロン"],["と"],["その"],["子","こ"],["ら"],["が"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["の"],["うち"],["から"],["、"],["受ける","うける"],["分","ぶん"],["で"],["あって"],["、"]]},{"verse":36,"text":"それは、彼らが油そそがれた日から永遠のおきてとして、代々イスラエルの人から取って彼らに与えるよう、主が命じられたものである。","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["油","あぶら"],["そそがれた"],["日","ひ"],["から"],["永遠","えいえん"],["の"],["おきて"],["として"],["、"],["代々","だいだい"],["イスラエル"],["の"],["人","ひと"],["から"],["取って","とって"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["よう"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["もの"],["で"],["ある"],["。"]]},{"verse":37,"text":"これは、全焼のいけにえ、穀物のささげ物、罪のためのいけにえ、罪過のためのいけにえ、任職と和解のいけにえについてのおしえである。","tok":[["これ"],["は"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["、"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["、"],["任","にん"],["職","しょく"],["と"],["和解","わかい"],["の"],["いけにえ"],["について"],["の"],["おしえ"],["で"],["ある"],["。"]]},{"verse":38,"text":"これは、モーセがシナイの荒野でイスラエル人に、そのささげ物を主にささげるよう命じた日に、主がシナイ山でモーセに命じられたものである。","tok":[["これ"],["は"],["、"],["モーセ"],["が"],["シナイ"],["の"],["荒野","あらの"],["で"],["イスラエル"],["人","にん"],["に"],["、"],["その"],["ささげ物","ささげもの"],["を"],["主に","おもに"],["ささげる"],["よう"],["命じた","めいじた"],["日","ひ"],["に"],["、"],["主","ぬし"],["が"],["シナイ"],["山","やま"],["で"],["モーセ"],["に"],["命じられた","めいじられた"],["もの"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"ついで主はモーセに仰せられた。「アロンの子である祭司たちに言え。彼らに言え。縁者のうちで死んだ者のために、自分の身を汚してはならない。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["アロン"],["の"],["子","こ"],["で"],["ある"],["祭司","さいし"],["たち"],["に"],["言え","いえ"],["。"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["縁者","えんじゃ"],["の"],["うち"],["で"],["死んだ","しんだ"],["者","もの"],["の"],["ため"],["に"],["、"],["自分","じぶん"],["の"],["身","み"],["を"],["汚して","よごして"],["は"],["ならない"],["。"]]},{"verse":2,"text":"ただし、近親の者、母や父、息子や娘、また兄弟の場合は例外である。","tok":[["ただし"],["、"],["近親","きんしん"],["の"],["者","もの"],["、"],["母","はは"],["や"],["父","ちち"],["、"],["息子","むすこ"],["や"],["娘","むすめ"],["、"],["また"],["兄弟","きょうだい"],["の"],["場合","ばあい"],["は"],["例外","れいがい"],["で"],["ある"],["。"]]},{"verse":3,"text":"近親の、結婚したことのない処女の姉妹の場合は、身を汚してもよい。","tok":[["近親","きんしん"],["の"],["、"],["結婚","けっこん"],["した"],["こと"],["の"],["ない"],["処女","しょじょ"],["の"],["姉妹","しまい"],["の"],["場合","ばあい"],["は"],["、"],["身","み"],["を"],["汚して","よごして"],["も"],["よい"],["。"]]},{"verse":4,"text":"姻戚の縁者として身を汚し、自分を冒瀆することになってはならない。","tok":[["姻戚","いんせき"],["の"],["縁者","えんじゃ"],["として"],["身","み"],["を"],["汚し","よごし"],["、"],["自分","じぶん"],["を"],["冒瀆","ぼうとく"],["する"],["こと"],["に"],["なって"],["は"],["ならない"],["。"]]},{"verse":5,"text":"彼らは頭をそってはならない。ひげの両端をそり落としてもいけない。からだにどんな傷もつけてはならない。","tok":[["彼","かれ"],["ら"],["は"],["頭","あたま"],["を"],["そって"],["は"],["ならない"],["。"],["ひげ"],["の"],["両端","りょうたん"],["を"],["そり落として","そりおとして"],["も"],["いけない"],["。"],["からだ"],["に"],["どんな"],["傷","きず"],["も"],["つけて"],["は"],["ならない"],["。"]]},{"verse":6,"text":"彼らは自分の神に対して聖でなければならない。また自分の神の御名を汚してはならない。彼らは、主への火によるささげ物、彼らの神のパンをささげるからである。彼らは聖でなければならない。","tok":[["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["神","かみ"],["に対して","にたいして"],["聖","せい"],["で"],["なければ"],["ならない"],["。"],["また"],["自分","じぶん"],["の"],["神","かみ"],["の"],["御名","ぎょめい"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["の"],["パン"],["を"],["ささげる"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["聖","せい"],["で"],["なければ"],["ならない"],["。"]]},{"verse":7,"text":"彼らは淫行で汚れている女をめとってはならない。また夫から離婚された女をめとってはならない。祭司は神に対して聖であるから。","tok":[["彼","かれ"],["ら"],["は"],["淫行","いんこう"],["で"],["汚れて","よごれて"],["いる"],["女","おんな"],["を"],["めとって"],["は"],["ならない"],["。"],["また"],["夫","おっと"],["から"],["離婚","りこん"],["された"],["女","おんな"],["を"],["めとって"],["は"],["ならない"],["。"],["祭司","さいし"],["は"],["神","かみ"],["に対して","にたいして"],["聖","せい"],["で"],["ある"],["から"],["。"]]},{"verse":8,"text":"あなたは彼を聖別しなければならない。彼はあなたの神のパンをささげるからである。彼はあなたにとって聖でなければならない。あなたがたを聖別する主、わたしが聖であるから。","tok":[["あなた"],["は"],["彼","かれ"],["を"],["聖別","せいべつ"],["しなければ"],["ならない"],["。"],["彼","かれ"],["は"],["あなた"],["の"],["神","かみ"],["の"],["パン"],["を"],["ささげる"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["あなた"],["にとって"],["聖","せい"],["で"],["なければ"],["ならない"],["。"],["あなた"],["がた"],["を"],["聖別","せいべつ"],["する"],["主","ぬし"],["、"],["わたし"],["が"],["聖","せい"],["で"],["ある"],["から"],["。"]]},{"verse":9,"text":"祭司の娘が淫行で身を汚すなら、その父を汚すことになる。彼女は火で焼かれなければならない。","tok":[["祭司","さいし"],["の"],["娘","むすめ"],["が"],["淫行","いんこう"],["で"],["身","み"],["を"],["汚すなら","よごすなら"],["、"],["その"],["父","ちち"],["を"],["汚す","けがす"],["こと"],["に"],["なる"],["。"],["彼女","かのじょ"],["は"],["火","ひ"],["で"],["焼かれなければ","やかれなければ"],["ならない"],["。"]]},{"verse":10,"text":"兄弟たちのうち大祭司で、頭にそそぎの油がそそがれ、聖別されて装束を着けている者は、その髪の毛を乱したり、その装束を引き裂いたりしてはならない。","tok":[["兄弟","きょうだい"],["たち"],["の"],["うち"],["大","だい"],["祭司","さいし"],["で"],["、"],["頭","あたま"],["に"],["そそぎ"],["の"],["油","あぶら"],["が"],["そそがれ"],["、"],["聖別","せいべつ"],["されて"],["装束","しょうぞく"],["を"],["着けて","つけて"],["いる"],["者","もの"],["は"],["、"],["その"],["髪の毛","かみのけ"],["を"],["乱し","みだし"],["たり"],["、"],["その"],["装束","しょうぞく"],["を"],["引き裂い","ひきさい"],["たり"],["して"],["は"],["ならない"],["。"]]},{"verse":11,"text":"どんな死体のところにも、行ってはならない。自分の父のためにも母のためにも、自分の身を汚してはならない。","tok":[["どんな"],["死体","したい"],["の"],["ところ"],["に"],["も"],["、"],["行って","いって"],["は"],["ならない"],["。"],["自分","じぶん"],["の"],["父","ちち"],["の"],["ため"],["に"],["も"],["母","はは"],["の"],["ため"],["に"],["も"],["、"],["自分","じぶん"],["の"],["身","み"],["を"],["汚して","よごして"],["は"],["ならない"],["。"]]},{"verse":12,"text":"聖所から出て行って、神の聖所を汚してはならない。神のそそぎの油による記章を身につけているからである。わたしは主である。","tok":[["聖","せい"],["所","しょ"],["から"],["出て","でて"],["行って","いって"],["、"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["神","かみ"],["の"],["そそぎ"],["の"],["油","あぶら"],["に"],["よる"],["記章","きしょう"],["を"],["身","み"],["に"],["つけて"],["いる"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":13,"text":"彼は処女である女をめとらなければならない。","tok":[["彼","かれ"],["は"],["処女","しょじょ"],["で"],["ある"],["女","おんな"],["を"],["めとらなければ"],["ならない"],["。"]]},{"verse":14,"text":"やもめ、離婚された女、あるいは淫行で汚れている女、これらをめとってはならない。彼はただ、自分の民から処女をめとらなければならない。","tok":[["やもめ"],["、"],["離婚","りこん"],["された"],["女","おんな"],["、"],["あるいは"],["淫行","いんこう"],["で"],["汚れて","よごれて"],["いる"],["女","おんな"],["、"],["これ"],["ら"],["を"],["めとって"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["ただ"],["、"],["自分","じぶん"],["の"],["民","たみ"],["から"],["処女","しょじょ"],["を"],["めとらなければ"],["ならない"],["。"]]},{"verse":15,"text":"彼の民のうちで、その子孫を汚すことのないためである。わたしは彼を聖別する主だからである。」","tok":[["彼","かれ"],["の"],["民","たみ"],["の"],["うち"],["で"],["、"],["その"],["子孫","しそん"],["を"],["汚す","けがす"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["聖別","せいべつ"],["する"],["主","ぬし"],["だ"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":16,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":17,"text":"「アロンに告げて言え。あなたの代々の子孫のうち、だれでも身に欠陥のある者は、神のパンをささげるために近づいてはならない。","tok":[["「"],["アロン"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["あなた"],["の"],["代々","だいだい"],["の"],["子孫","しそん"],["の"],["うち"],["、"],["だれ"],["で"],["も"],["身","み"],["に"],["欠陥","けっかん"],["の"],["ある"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["パン"],["を"],["ささげる"],["ため"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"だれでも、身に欠陥のある者は近づいてはならない。目の見えない者、足のなえた者、あるいは手足が短すぎたり、長すぎたりしている者、","tok":[["だれ"],["で"],["も"],["、"],["身","み"],["に"],["欠陥","けっかん"],["の"],["ある"],["者","もの"],["は"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["、"],["足","あし"],["の"],["なえた"],["者","もの"],["、"],["あるいは"],["手足","てあし"],["が"],["短","みじか"],["すぎ"],["たり"],["、"],["長","なが"],["すぎ"],["たり"],["して"],["いる"],["者","もの"],["、"]]},{"verse":19,"text":"あるいは足や手の折れた者、","tok":[["あるいは"],["足","あし"],["や"],["手","て"],["の"],["折れた","おれた"],["者","もの"],["、"]]},{"verse":20,"text":"くる病、肺病でやせた者、目に星のある者、湿疹のある者、かさぶたのある者や、こうがんのつぶれた者などである。","tok":[["くる"],["病","やまい"],["、"],["肺病","はいびょう"],["で"],["やせた"],["者","もの"],["、"],["目","め"],["に"],["星","ほし"],["の"],["ある"],["者","もの"],["、"],["湿疹","しっしん"],["の"],["ある"],["者","もの"],["、"],["かさぶた"],["の"],["ある"],["者","もの"],["や"],["、"],["こう"],["がん"],["の"],["つぶれた"],["者","もの"],["など"],["で"],["ある"],["。"]]},{"verse":21,"text":"祭司であるアロンの子孫のうち、だれでも身に欠陥のある者は、主への火によるささげ物をささげるために近寄ってはならない。彼の身には欠陥があるから、神のパンをささげるために近寄ってはならない。","tok":[["祭司","さいし"],["で"],["ある"],["アロン"],["の"],["子孫","しそん"],["の"],["うち"],["、"],["だれ"],["で"],["も"],["身","み"],["に"],["欠陥","けっかん"],["の"],["ある"],["者","もの"],["は"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["を"],["ささげる"],["ため"],["に"],["近寄って","ちかよって"],["は"],["ならない"],["。"],["彼","かれ"],["の"],["身","み"],["に"],["は"],["欠陥","けっかん"],["が"],["ある"],["から"],["、"],["神","かみ"],["の"],["パン"],["を"],["ささげる"],["ため"],["に"],["近寄って","ちかよって"],["は"],["ならない"],["。"]]},{"verse":22,"text":"しかし彼は、神のパンは、最も聖なるものでも、聖なるものでも食べることができる。","tok":[["しかし"],["彼","かれ"],["は"],["、"],["神","かみ"],["の"],["パン"],["は"],["、"],["最も","もっとも"],["聖","せい"],["なる"],["もの"],["で"],["も"],["、"],["聖","せい"],["なる"],["もの"],["で"],["も"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":23,"text":"ただし、垂れ幕の所に行ってはならない。祭壇に近寄ってはならない。彼は身に欠陥があるからである。彼はわたしの聖所を汚してはならない。わたしがそれらを聖別する主だからである。」","tok":[["ただし"],["、"],["垂れ幕","たれまく"],["の"],["所","ところ"],["に"],["行って","いって"],["は"],["ならない"],["。"],["祭壇","さいだん"],["に"],["近寄って","ちかよって"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["身","み"],["に"],["欠陥","けっかん"],["が"],["ある"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["わたし"],["が"],["それ"],["ら"],["を"],["聖別","せいべつ"],["する"],["主","ぬし"],["だ"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":24,"text":"モーセはこのように、アロンとその子らとすべてのイスラエル人に告げた。","tok":[["モーセ"],["は"],["この"],["よう"],["に"],["、"],["アロン"],["と"],["その"],["子","こ"],["ら"],["と"],["すべて"],["の"],["イスラエル"],["人","にん"],["に"],["告げた","つげた"],["。"]]}]
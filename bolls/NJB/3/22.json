[{"verse":1,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「アロンとその子らに告げよ。イスラエル人の聖なるものは、わたしのために聖別しなければならない。彼らはわたしの聖なる名を汚してはならない。それは彼らがわたしのために、聖なるものとすべきものである。わたしは主である。","tok":[["「"],["アロン"],["と"],["その"],["子","こ"],["ら"],["に"],["告げ","つげ"],["よ"],["。"],["イスラエル"],["人","にん"],["の"],["聖","せい"],["なる"],["もの"],["は"],["、"],["わたし"],["の"],["ため"],["に"],["聖別","せいべつ"],["しなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["ため"],["に"],["、"],["聖","せい"],["なる"],["もの"],["と"],["すべき"],["もの"],["で"],["ある"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼らに言え。代々にわたり、あなたがたの子孫のだれかが、イスラエル人が主のために聖別した聖なるものに汚れたままで近づくなら、その者は、わたしの前から断ち切られる。わたしは主である。","tok":[["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["代々","だいだい"],["に"],["わたり"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["の"],["だれ"],["か"],["が"],["、"],["イスラエル"],["人","にん"],["が"],["主","ぬし"],["の"],["ため"],["に"],["聖別","せいべつ"],["した"],["聖","せい"],["なる"],["もの"],["に"],["汚れた","よごれた"],["まま"],["で"],["近づくなら","ちかづくなら"],["、"],["その"],["者","もの"],["は"],["、"],["わたし"],["の"],["前","まえ"],["から"],["断ち切られる","たちきられる"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":4,"text":"アロンの子孫のうち、ツァラアトの者、または漏出のある者はだれでも、きよくなるまで聖なるものを食べてはならない。また、死体によって汚されたものに触れる者、精を漏らす者、","tok":[["アロン"],["の"],["子孫","しそん"],["の"],["うち"],["、"],["ツァラアト"],["の"],["者","もの"],["、"],["また"],["は"],["漏出","ろうしゅつ"],["の"],["ある"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["きよく"],["なる"],["まで"],["聖","せい"],["なる"],["もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["また"],["、"],["死体","したい"],["によって"],["汚された","よごされた"],["もの"],["に"],["触れる","ふれる"],["者","もの"],["、"],["精","せい"],["を"],["漏らす","もらす"],["者","もの"],["、"]]},{"verse":5,"text":"あるいはすべて人を汚す、群生するものに触れる者、または、どのような汚れでも、人を汚れさせる人間に触れる者、","tok":[["あるいは"],["すべて"],["人","ひと"],["を"],["汚す","よごす"],["、"],["群生","ぐんせい"],["する"],["もの"],["に"],["触れる","ふれる"],["者","もの"],["、"],["また"],["は"],["、"],["どのような"],["汚れ","よごれ"],["で"],["も"],["、"],["人","ひと"],["を"],["汚れさせる","よごれさせる"],["人間","にんげん"],["に"],["触れる","ふれる"],["者","もの"],["、"]]},{"verse":6,"text":"このようなものに触れる者は、夕方まで汚れる。その者は、からだに水を浴びずに、聖なるものを食べてはならない。","tok":[["この"],["よう"],["な"],["もの"],["に"],["触れる","ふれる"],["者","もの"],["は"],["、"],["夕方","ゆうがた"],["まで"],["汚れる","よごれる"],["。"],["その"],["者","もの"],["は"],["、"],["からだ"],["に"],["水","みず"],["を"],["浴びず","あびず"],["に"],["、"],["聖","せい"],["なる"],["もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":7,"text":"ただし、日が沈めば、彼はきよくなり、その後、聖なるものを食べることができる。それは彼の食物だからである。","tok":[["ただし"],["、"],["日","ひ"],["が"],["沈めば","しずめば"],["、"],["彼","かれ"],["は"],["きよく"],["なり"],["、"],["その"],["後","ご"],["、"],["聖","せい"],["なる"],["もの"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["それ"],["は"],["彼","かれ"],["の"],["食物","しょくもつ"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"自然に死んだものや、野獣に裂き殺されたものを食べて、汚れてはならない。わたしは主である。","tok":[["自然","しぜん"],["に"],["死んだ","しんだ"],["もの"],["や"],["、"],["野獣","やじゅう"],["に"],["裂き","さき"],["殺された","ころされた"],["もの"],["を"],["食べて","たべて"],["、"],["汚れて","よごれて"],["は"],["ならない"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":9,"text":"彼らがわたしの戒めを守るなら、彼らが、これを汚し、そのために罪を負って、死ぬことはない。わたしは彼らを聖別する主である。","tok":[["彼","かれ"],["ら"],["が"],["わたし"],["の"],["戒め","いましめ"],["を"],["守るなら","まもるなら"],["、"],["彼","かれ"],["ら"],["が"],["、"],["これ"],["を"],["汚し","よごし"],["、"],["その"],["ため"],["に"],["罪","つみ"],["を"],["負って","おって"],["、"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["する"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":10,"text":"一般の者はだれも聖なるものを食べてはならない。祭司と同居している者や雇い人は、聖なるものを食べてはならない。","tok":[["一般","いっぱん"],["の"],["者","もの"],["は"],["だれ"],["も"],["聖","せい"],["なる"],["もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["祭司","さいし"],["と"],["同居","どうきょ"],["して"],["いる"],["者","もの"],["や"],["雇い人","やといにん"],["は"],["、"],["聖","せい"],["なる"],["もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":11,"text":"祭司に金で買われた者は、これを食べることができる。また、その家で生まれたしもべも、祭司のパンを食べることができる。","tok":[["祭司","さいし"],["に"],["金","かね"],["で"],["買われた","かわれた"],["者","もの"],["は"],["、"],["これ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["また"],["、"],["その"],["家","いえ"],["で"],["生まれた","うまれた"],["しもべ"],["も"],["、"],["祭司","さいし"],["の"],["パン"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"祭司の娘が一般の人と結婚したなら、彼女は聖なる奉納物を食べてはならない。","tok":[["祭司","さいし"],["の"],["娘","むすめ"],["が"],["一般","いっぱん"],["の"],["人","ひと"],["と"],["結婚","けっこん"],["したなら"],["、"],["彼女","かのじょ"],["は"],["聖","せい"],["なる"],["奉納物","ほうのうぶつ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":13,"text":"祭司の娘がやもめ、あるいは離婚された者となり、子どももなく、娘のときのように再びその父の家に戻っていれば、その父の食物を食べることができる。しかし、一般の者はだれも、それを食べてはならない。","tok":[["祭司","さいし"],["の"],["娘","むすめ"],["が"],["やもめ"],["、"],["あるいは"],["離婚","りこん"],["された"],["者","もの"],["と"],["なり"],["、"],["子ども","こども"],["も"],["なく"],["、"],["娘","むすめ"],["の"],["とき"],["の"],["よう"],["に"],["再び","ふたたび"],["その"],["父","ちち"],["の"],["家","いえ"],["に"],["戻って","もどって"],["いれば"],["、"],["その"],["父","ちち"],["の"],["食物","しょくもつ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["しかし"],["、"],["一般","いっぱん"],["の"],["者","もの"],["は"],["だれ"],["も"],["、"],["それ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"だれかが、あやまって聖なるものを食べるなら、それにその五分の一を足して、その聖なるものを祭司に渡す。","tok":[["だれ"],["か"],["が"],["、"],["あやまって"],["聖","せい"],["なる"],["もの"],["を"],["食べるなら","たべるなら"],["、"],["それ"],["に"],["その"],["五分","ごぶん"],["の"],["一","いち"],["を"],["足して","たして"],["、"],["その"],["聖","せい"],["なる"],["もの"],["を"],["祭司","さいし"],["に"],["渡す","わたす"],["。"]]},{"verse":15,"text":"イスラエル人に、その主に奉納する聖なるものを汚し、","tok":[["イスラエル"],["人","にん"],["に"],["、"],["その"],["主に","おもに"],["奉納","ほうのう"],["する"],["聖","せい"],["なる"],["もの"],["を"],["汚し","よごし"],["、"]]},{"verse":16,"text":"聖なるものを食べて、その罪過の咎を負うようにさせてはならない。わたしは彼らを聖別する主だからである。」","tok":[["聖","せい"],["なる"],["もの"],["を"],["食べて","たべて"],["、"],["その"],["罪過","ざいか"],["の"],["咎","とが"],["を"],["負う","おう"],["よう"],["に"],["させて"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["する"],["主","ぬし"],["だ"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":17,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":18,"text":"「アロンとその子ら、またすべてのイスラエル人に告げて言え。だれでも、イスラエルの家の者、またはイスラエルにいる在留異国人がささげ物をささげ、誓願のささげ物、あるいは進んでささげるささげ物として、全焼のいけにえを主にささげるなら、","tok":[["「"],["アロン"],["と"],["その"],["子","こ"],["ら"],["、"],["また"],["すべて"],["の"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["だれ"],["で"],["も"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["、"],["また"],["は"],["イスラエル"],["に"],["いる"],["在留","ざいりゅう"],["異国人","いこくにん"],["が"],["ささげ物","ささげもの"],["を"],["ささげ"],["、"],["誓願","せいがん"],["の"],["ささげ物","ささげもの"],["、"],["あるいは"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["として"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["主に","おもに"],["ささげるなら"],["、"]]},{"verse":19,"text":"あなたがたが受け入れられるためには、それは牛、羊、あるいはやぎのうちの傷のない雄でなければならない。","tok":[["あなた"],["がた"],["が"],["受け入れられる","うけいれられる"],["ため"],["に"],["は"],["、"],["それ"],["は"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["あるいは"],["やぎ"],["の"],["うち"],["の"],["傷","きず"],["の"],["ない"],["雄","おす"],["で"],["なければ"],["ならない"],["。"]]},{"verse":20,"text":"欠陥のあるものは、いっさいささげてはならない。それはあなたがたのために受け入れられないからである。","tok":[["欠陥","けっかん"],["の"],["ある"],["もの"],["は"],["、"],["いっさい"],["ささげて"],["は"],["ならない"],["。"],["それ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["受け入れられない","うけいれられない"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"また、人が特別の誓願を果たすため、あるいは進んでささげるささげ物として、牛か羊の中から和解のいけにえを主にささげるときは、それが受け入れられるためには傷のないものでなければならない。それにはどのような欠陥もあってはならない。","tok":[["また"],["、"],["人","ひと"],["が"],["特別","とくべつ"],["の"],["誓願","せいがん"],["を"],["果たす","はたす"],["ため"],["、"],["あるいは"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["として"],["、"],["牛","うし"],["か"],["羊","ひつじ"],["の"],["中","なか"],["から"],["和解","わかい"],["の"],["いけにえ"],["を"],["主に","おもに"],["ささげる"],["とき"],["は"],["、"],["それ"],["が"],["受け入れられる","うけいれられる"],["ため"],["に"],["は"],["傷","きず"],["の"],["ない"],["もの"],["で"],["なければ"],["ならない"],["。"],["それ"],["に"],["は"],["どのような"],["欠陥","けっかん"],["も"],["あって"],["は"],["ならない"],["。"]]},{"verse":22,"text":"盲目のもの、折れたところのあるもの、傷のあるもの、あるいは、うみの出るもの、湿疹のあるもの、かさぶたのあるもの、あなたがたはこれらのものを主にささげてはならない。また、これらのものを主への火によるささげ物として祭壇の上にささげてはならない。","tok":[["盲目","もうもく"],["の"],["もの"],["、"],["折れた","おれた"],["ところ"],["の"],["ある"],["もの"],["、"],["傷","きず"],["の"],["ある"],["もの"],["、"],["あるいは"],["、"],["うみ"],["の"],["出る","でる"],["もの"],["、"],["湿疹","しっしん"],["の"],["ある"],["もの"],["、"],["かさぶた"],["の"],["ある"],["もの"],["、"],["あなた"],["がた"],["は"],["これ"],["ら"],["の"],["もの"],["を"],["主に","おもに"],["ささげて"],["は"],["ならない"],["。"],["また"],["、"],["これ"],["ら"],["の"],["もの"],["を"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["として"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["ささげて"],["は"],["ならない"],["。"]]},{"verse":23,"text":"牛や羊で、足が伸びすぎているか、またはなえ縮んだものは、進んでささげるささげ物とすることはできるが、誓願のささげ物としては受け入れられない。","tok":[["牛","うし"],["や"],["羊","ひつじ"],["で"],["、"],["足","あし"],["が"],["伸び","のび"],["すぎて"],["いる"],["か"],["、"],["また"],["は"],["なえ"],["縮んだ","ちぢんだ"],["もの"],["は"],["、"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["と"],["する"],["こと"],["は"],["できる"],["が"],["、"],["誓願","せいがん"],["の"],["ささげ物","ささげもの"],["として"],["は"],["受け入れられない","うけいれられない"],["。"]]},{"verse":24,"text":"あなたがたは、こうがんの押しつぶされたもの、砕けたもの、裂かれたもの、切り取られたものを主にささげてはならない。あなたがたの地でそのようなことをしてはならない。","tok":[["あなた"],["がた"],["は"],["、"],["こう"],["がん"],["の"],["押しつぶされた","おしつぶされた"],["もの"],["、"],["砕けた","くだけた"],["もの"],["、"],["裂かれた","さかれた"],["もの"],["、"],["切り取られた","きりとられた"],["もの"],["を"],["主に","おもに"],["ささげて"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["地","ち"],["で"],["その"],["よう"],["な"],["こと"],["を"],["して"],["は"],["ならない"],["。"]]},{"verse":25,"text":"また、あなたがたは、外国人の手から何かこのようなものを受けて、あなたがたの神のパンとしてささげてはならない。これらのものはそこなわれており、欠陥があるから、あなたがたのために受け入れられない。」","tok":[["また"],["、"],["あなた"],["がた"],["は"],["、"],["外国人","がいこくじん"],["の"],["手","て"],["から"],["何","なん"],["か"],["この"],["よう"],["な"],["もの"],["を"],["受けて","うけて"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["の"],["パン"],["として"],["ささげて"],["は"],["ならない"],["。"],["これ"],["ら"],["の"],["もの"],["は"],["そこなわれて"],["おり"],["、"],["欠陥","けっかん"],["が"],["ある"],["から"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["受け入れられない","うけいれられない"],["。"],["」"]]},{"verse":26,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":27,"text":"「牛か羊かやぎが生まれたときは、七日間、その母親といっしょにしておく。八日目以後、それは主への火によるささげ物として受け入れられる。","tok":[["「"],["牛","うし"],["か"],["羊","ひつじ"],["か"],["やぎ"],["が"],["生まれた","うまれた"],["とき"],["は"],["、"],["七","なな"],["日間","かかん"],["、"],["その"],["母親","ははおや"],["と"],["いっしょ"],["に"],["して"],["おく"],["。"],["八日目","ようかめ"],["以後","いご"],["、"],["それ"],["は"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["として"],["受け入れられる","うけいれられる"],["。"]]},{"verse":28,"text":"しかし、牛でも、羊でも、それをその子と同じ日にほふってはならない。","tok":[["しかし"],["、"],["牛","うし"],["で"],["も"],["、"],["羊","ひつじ"],["で"],["も"],["、"],["それ"],["を"],["その"],["子","こ"],["と"],["同じ","おなじ"],["日","ひ"],["に"],["ほふって"],["は"],["ならない"],["。"]]},{"verse":29,"text":"主に感謝のいけにえをささげるときは、あなたがたが受け入れられるように、それをささげなければならない。","tok":[["主に","おもに"],["感謝","かんしゃ"],["の"],["いけにえ"],["を"],["ささげる"],["とき"],["は"],["、"],["あなた"],["がた"],["が"],["受け入れられる","うけいれられる"],["よう"],["に"],["、"],["それ"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":30,"text":"その同じ日にこれを食べ、朝までそれを残しておいてはならない。わたしは主である。","tok":[["その"],["同じ","おなじ"],["日","ひ"],["に"],["これ"],["を"],["食べ","たべ"],["、"],["朝","あさ"],["まで"],["それ"],["を"],["残して","のこして"],["おいて"],["は"],["ならない"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":31,"text":"あなたがたは、わたしの命令を守り、これを行え。わたしは主である。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["命令","めいれい"],["を"],["守り","まもり"],["、"],["これ"],["を"],["行え","おこなえ"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":32,"text":"わたしの聖なる名を汚してはならない。むしろわたしはイスラエル人のうちで聖とされなければならない。わたしはあなたがたを聖別した主である。","tok":[["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["むしろ"],["わたし"],["は"],["イスラエル"],["人","にん"],["の"],["うち"],["で"],["聖","せい"],["と"],["されなければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["聖別","せいべつ"],["した"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":33,"text":"あなたがたの神となるために、あなたがたをエジプトの地から連れ出した者、わたしは、主である。」","tok":[["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ出した","つれだした"],["者","もの"],["、"],["わたし"],["は"],["、"],["主","ぬし"],["で"],["ある"],["。"],["」"]]}]
[{"verse":1,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人に告げて言え。あなたがたが聖なる会合として召集する主の例祭、すなわちわたしの例祭は次のとおりである。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["あなた"],["がた"],["が"],["聖","せい"],["なる"],["会合","かいごう"],["として"],["召集","しょうしゅう"],["する"],["主","ぬし"],["の"],["例祭","れいさい"],["、"],["すなわち"],["わたし"],["の"],["例祭","れいさい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":3,"text":"六日間は仕事をしてもよい。しかし七日目は全き休みの安息、聖なる会合の日である。あなたがたは、いっさいの仕事をしてはならない。この日はあなたがたがどこに住んでいても主の安息日である。","tok":[["六","むい"],["日間","かかん"],["は"],["仕事","しごと"],["を"],["して"],["も"],["よい"],["。"],["しかし"],["七日目","ななかめ"],["は"],["全","ぜん"],["き"],["休み","やすみ"],["の"],["安息","あんそく"],["、"],["聖","せい"],["なる"],["会合","かいごう"],["の"],["日","ひ"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["いっさい"],["の"],["仕事","しごと"],["を"],["して"],["は"],["ならない"],["。"],["この"],["日","ひ"],["は"],["あなた"],["がた"],["が"],["どこ"],["に"],["住んで","すんで"],["いて"],["も"],["主","ぬし"],["の"],["安息日","あんそくび"],["で"],["ある"],["。"]]},{"verse":4,"text":"あなたがたが定期に召集しなければならない聖なる会合、すなわち主の例祭は次のとおりである。","tok":[["あなた"],["がた"],["が"],["定期","ていき"],["に"],["召集","しょうしゅう"],["しなければ"],["ならない"],["聖","せい"],["なる"],["会合","かいごう"],["、"],["すなわち"],["主","ぬし"],["の"],["例祭","れいさい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":5,"text":"第一月の十四日には、夕暮れに過越のいけにえを主にささげる。","tok":[["第","だい"],["一","いち"],["月","がつ"],["の"],["十四日","じゅうよんか"],["に"],["は"],["、"],["夕暮れ","ゆうぐれ"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["主に","おもに"],["ささげる"],["。"]]},{"verse":6,"text":"この月の十五日は、主の、種を入れないパンの祭りである。七日間、あなたがたは種を入れないパンを食べなければならない。","tok":[["この"],["月","つき"],["の"],["十五","じゅうご"],["日","にち"],["は"],["、"],["主","ぬし"],["の"],["、"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["の"],["祭り","まつり"],["で"],["ある"],["。"],["七","なな"],["日間","かかん"],["、"],["あなた"],["がた"],["は"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":7,"text":"最初の日は、あなたがたの聖なる会合とし、どんな労働の仕事もしてはならない。","tok":[["最初","さいしょ"],["の"],["日","ひ"],["は"],["、"],["あなた"],["がた"],["の"],["聖","せい"],["なる"],["会合","かいごう"],["と"],["し"],["、"],["どんな"],["労働","ろうどう"],["の"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":8,"text":"七日間、火によるささげ物を主にささげる。七日目は聖なる会合である。あなたがたは、どんな労働の仕事もしてはならない。」","tok":[["七","なな"],["日間","かかん"],["、"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["を"],["主に","おもに"],["ささげる"],["。"],["七日目","ななかめ"],["は"],["聖","せい"],["なる"],["会合","かいごう"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["どんな"],["労働","ろうどう"],["の"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"],["」"]]},{"verse":9,"text":"ついで主はモーセに告げて仰せられた。","tok":[["ついで"],["主","ぬし"],["は"],["モーセ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":10,"text":"「イスラエル人に告げて言え。わたしがあなたがたに与えようとしている地に、あなたがたが入り、収穫を刈り入れるときは、収穫の初穂の束を祭司のところに持って来る。","tok":[["「"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["わたし"],["が"],["あなた"],["がた"],["に"],["与えよう","あたえよう"],["として"],["いる"],["地","ち"],["に"],["、"],["あなた"],["がた"],["が"],["入り","はいり"],["、"],["収穫","しゅうかく"],["を"],["刈り入れる","かりいれる"],["とき"],["は"],["、"],["収穫","しゅうかく"],["の"],["初穂","はつほ"],["の"],["束","たば"],["を"],["祭司","さいし"],["の"],["ところ"],["に"],["持って","もって"],["来る","くる"],["。"]]},{"verse":11,"text":"祭司は、あなたがたが受け入れられるために、その束を主に向かって揺り動かす。祭司は安息日の翌日、それを揺り動かさなければならない。","tok":[["祭司","さいし"],["は"],["、"],["あなた"],["がた"],["が"],["受け入れられる","うけいれられる"],["ため"],["に"],["、"],["その"],["束","たば"],["を"],["主に","おもに"],["向かって","むかって"],["揺り動かす","ゆりうごかす"],["。"],["祭司","さいし"],["は"],["安息日","あんそくび"],["の"],["翌日","よくじつ"],["、"],["それ"],["を"],["揺り動かさなければ","ゆりうごかさなければ"],["ならない"],["。"]]},{"verse":12,"text":"あなたがたは、束を揺り動かすその日に、主への全焼のいけにえとして、一歳の傷のない雄の子羊をささげる。","tok":[["あなた"],["がた"],["は"],["、"],["束","たば"],["を"],["揺り動かす","ゆりうごかす"],["その"],["日","ひ"],["に"],["、"],["主","ぬし"],["へ"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["、"],["一歳","いちさい"],["の"],["傷","きず"],["の"],["ない"],["雄","おす"],["の"],["子羊","こひつじ"],["を"],["ささげる"],["。"]]},{"verse":13,"text":"その穀物のささげ物は、油を混ぜた小麦粉十分の二エパであり、主への火によるささげ物、なだめのかおりである。その注ぎのささげ物はぶどう酒で、一ヒンの四分の一である。","tok":[["その"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["は"],["、"],["油","あぶら"],["を"],["混ぜた","まぜた"],["小麦粉","こむぎこ"],["十分","じゅうぶん"],["の"],["二","に"],["エパ"],["で"],["あり"],["、"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["、"],["なだめ"],["の"],["かおり"],["で"],["ある"],["。"],["その"],["注ぎ","そそぎ"],["の"],["ささげ物","ささげもの"],["は"],["ぶどう酒","ぶどうしゅ"],["で"],["、"],["一","いち"],["ヒン"],["の"],["四分","よんぶん"],["の"],["一","いち"],["で"],["ある"],["。"]]},{"verse":14,"text":"あなたがたは神へのささげ物を持って来るその日まで、パンも、炒り麦も、新穀も食べてはならない。これはあなたがたがどこに住んでいても、代々守るべき永遠のおきてである。","tok":[["あなた"],["がた"],["は"],["神","かみ"],["へ"],["の"],["ささげ物","ささげもの"],["を"],["持って","もって"],["来る","くる"],["その"],["日","ひ"],["まで"],["、"],["パン"],["も"],["、"],["炒り","いり"],["麦","むぎ"],["も"],["、"],["新穀","しんこく"],["も"],["食べて","たべて"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["が"],["どこ"],["に"],["住んで","すんで"],["いて"],["も"],["、"],["代々","だいだい"],["守るべき","まもるべき"],["永遠","えいえん"],["の"],["おきて"],["で"],["ある"],["。"]]},{"verse":15,"text":"あなたがたは、安息日の翌日から、すなわち奉献物の束を持って来た日から、満七週間が終わるまでを数える。","tok":[["あなた"],["がた"],["は"],["、"],["安息日","あんそくび"],["の"],["翌日","よくじつ"],["から"],["、"],["すなわち"],["奉献物","ほうけんぶつ"],["の"],["束","たば"],["を"],["持って","もって"],["来た","きた"],["日","ひ"],["から"],["、"],["満","まん"],["七","なな"],["週間","しゅうかん"],["が"],["終わる","おわる"],["まで"],["を"],["数える","かぞえる"],["。"]]},{"verse":16,"text":"七回目の安息日の翌日まで五十日を数え、あなたがたは新しい穀物のささげ物を主にささげなければならない。","tok":[["七","なな"],["回目","かいめ"],["の"],["安息日","あんそくび"],["の"],["翌日","よくじつ"],["まで"],["五十日","ごとうか"],["を"],["数え","かぞえ"],["、"],["あなた"],["がた"],["は"],["新しい","あたらしい"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["主に","おもに"],["ささげなければ"],["ならない"],["。"]]},{"verse":17,"text":"あなたがたの住まいから、奉献物としてパン――主への初穂として、十分の二エパの小麦粉にパン種を入れて焼かれるもの――二個を持って来なければならない。","tok":[["あなた"],["がた"],["の"],["住まい","すまい"],["から"],["、"],["奉献物","ほうけんぶつ"],["として"],["パン"],["―"],["―"],["主","ぬし"],["へ"],["の"],["初穂","はつほ"],["として"],["、"],["十分","じゅうぶん"],["の"],["二","に"],["エパ"],["の"],["小麦粉","こむぎこ"],["に"],["パン種","ぱんだね"],["を"],["入れて","いれて"],["焼かれる","やかれる"],["もの"],["―"],["―"],["二個","にこ"],["を"],["持って","もって"],["来なければ","こなければ"],["ならない"],["。"]]},{"verse":18,"text":"そのパンといっしょに、主への全焼のいけにえとして、一歳の傷のない雄の子羊七頭、若い雄牛一頭、雄羊二頭、また、主へのなだめのかおりの、火によるささげ物として、彼らの穀物のささげ物と注ぎのささげ物とをささげる。","tok":[["その"],["パン"],["と"],["いっしょ"],["に"],["、"],["主","ぬし"],["へ"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["、"],["一歳","いちさい"],["の"],["傷","きず"],["の"],["ない"],["雄","おす"],["の"],["子羊","こひつじ"],["七頭","ななとう"],["、"],["若い","わかい"],["雄牛","おうし"],["一頭","いちとう"],["、"],["雄羊","おひつじ"],["二頭","にとう"],["、"],["また"],["、"],["主","ぬし"],["へ"],["の"],["なだめ"],["の"],["かおり"],["の"],["、"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["として"],["、"],["彼","かれ"],["ら"],["の"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["と"],["注ぎ","そそぎ"],["の"],["ささげ物","ささげもの"],["と"],["を"],["ささげる"],["。"]]},{"verse":19,"text":"また、雄やぎ一頭を、罪のためのいけにえとし、一歳の雄の子羊二頭を、和解のいけにえとする。","tok":[["また"],["、"],["雄","おす"],["やぎ"],["一頭","いちとう"],["を"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["と"],["し"],["、"],["一歳","いちさい"],["の"],["雄","おす"],["の"],["子羊","こひつじ"],["二頭","にとう"],["を"],["、"],["和解","わかい"],["の"],["いけにえ"],["と"],["する"],["。"]]},{"verse":20,"text":"祭司は、これら二頭の雄の子羊を、初穂のパンといっしょに、奉献物として主に向かって揺り動かす。これらは主の聖なるものであり、祭司のものとなる。","tok":[["祭司","さいし"],["は"],["、"],["これ"],["ら"],["二頭","にとう"],["の"],["雄","おす"],["の"],["子羊","こひつじ"],["を"],["、"],["初穂","はつほ"],["の"],["パン"],["と"],["いっしょ"],["に"],["、"],["奉献物","ほうけんぶつ"],["として"],["主に","おもに"],["向かって","むかって"],["揺り動かす","ゆりうごかす"],["。"],["これ"],["ら"],["は"],["主","ぬし"],["の"],["聖","せい"],["なる"],["もの"],["で"],["あり"],["、"],["祭司","さいし"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":21,"text":"その日、あなたがたは聖なる会合を召集する。それはあなたがたのためである。どんな労働の仕事もしてはならない。これはあなたがたがどこに住んでいても、代々守るべき永遠のおきてである。","tok":[["その"],["日","ひ"],["、"],["あなた"],["がた"],["は"],["聖","せい"],["なる"],["会合","かいごう"],["を"],["召集","しょうしゅう"],["する"],["。"],["それ"],["は"],["あなた"],["がた"],["の"],["ため"],["で"],["ある"],["。"],["どんな"],["労働","ろうどう"],["の"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["がた"],["が"],["どこ"],["に"],["住んで","すんで"],["いて"],["も"],["、"],["代々","だいだい"],["守るべき","まもるべき"],["永遠","えいえん"],["の"],["おきて"],["で"],["ある"],["。"]]},{"verse":22,"te
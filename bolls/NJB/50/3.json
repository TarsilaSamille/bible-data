[{"verse":1,"text":"最後に、私の兄弟たち。主にあって喜びなさい。前と同じことを書きますが、これは、私には煩わしいことではなく、あなたがたの安全のためにもなることです。","tok":[["最後","さいご"],["に"],["、"],["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["。"],["主に","おもに"],["あって"],["喜び","よろこび"],["なさい"],["。"],["前","まえ"],["と"],["同じ","おなじ"],["こと"],["を"],["書きます","かきます"],["が"],["、"],["これ"],["は"],["、"],["私","わたくし"],["に"],["は"],["煩わしい","わずらわしい"],["こと"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["安全","あんぜん"],["の"],["ため"],["に"],["も"],["なる"],["こと"],["です"],["。"]]},{"verse":2,"text":"どうか犬に気をつけてください。悪い働き人に気をつけてください。肉体だけの割礼の者に気をつけてください。","tok":[["どう"],["か"],["犬","いぬ"],["に"],["気","き"],["を"],["つけて"],["ください"],["。"],["悪い","わるい"],["働き人","はたらきにん"],["に"],["気","き"],["を"],["つけて"],["ください"],["。"],["肉体","にくたい"],["だけ"],["の"],["割礼","かつれい"],["の"],["者","もの"],["に"],["気","き"],["を"],["つけて"],["ください"],["。"]]},{"verse":3,"text":"神の御霊によって礼拝をし、キリスト・イエスを誇り、人間的なものを頼みにしない私たちのほうこそ、割礼の者なのです。","tok":[["神","かみ"],["の"],["御霊","ごれい"],["によって"],["礼拝","れいはい"],["を"],["し"],["、"],["キリスト"],["・"],["イエス"],["を"],["誇り","ほこり"],["、"],["人間的","にんげんてき"],["な"],["もの"],["を"],["頼み","たのみ"],["に"],["しない"],["私たち","わたしたち"],["の"],["ほう"],["こそ"],["、"],["割礼","かつれい"],["の"],["者","もの"],["な"],["の"],["です"],["。"]]},{"verse":4,"text":"ただし、私は、人間的なものにおいても頼むところがあります。もし、ほかの人が人間的なものに頼むところがあると思うなら、私は、それ以上です。","tok":[["ただし"],["、"],["私","わたくし"],["は"],["、"],["人間的","にんげんてき"],["な"],["もの"],["に"],["おいて"],["も"],["頼む","たのむ"],["ところ"],["が"],["あります"],["。"],["もし"],["、"],["ほか"],["の"],["人","ひと"],["が"],["人間的","にんげんてき"],["な"],["もの"],["に"],["頼む","たのむ"],["ところ"],["が"],["ある"],["と"],["思うなら","おもうなら"],["、"],["私","わたくし"],["は"],["、"],["それ"],["以上","いじょう"],["です"],["。"]]},{"verse":5,"text":"私は八日目の割礼を受け、イスラエル民族に属し、ベニヤミンの分かれの者です。きっすいのヘブル人で、律法についてはパリサイ人、","tok":[["私","わたくし"],["は"],["八日目","ようかめ"],["の"],["割礼","かつれい"],["を"],["受け","うけ"],["、"],["イスラエル"],["民族","みんぞく"],["に"],["属し","ぞくし"],["、"],["ベニヤミン"],["の"],["分かれ","わかれ"],["の"],["者","もの"],["です"],["。"],["きっすい"],["の"],["ヘブル人","へぶるにん"],["で"],["、"],["律法","りっぽう"],["について"],["は"],["パリサイ"],["人","にん"],["、"]]},{"verse":6,"text":"その熱
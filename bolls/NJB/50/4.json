[{"verse":1,"text":"そういうわけですから、私の愛し慕う兄弟たち、私の喜び、冠よ。どうか、このように主にあってしっかりと立ってください。私の愛する人たち。","tok":[["そう"],["いう"],["わけ"],["です"],["から"],["、"],["私","わたくし"],["の"],["愛し","あいし"],["慕う","したう"],["兄弟","きょうだい"],["たち"],["、"],["私","わたくし"],["の"],["喜び","よろこび"],["、"],["冠","かんむり"],["よ"],["。"],["どう"],["か"],["、"],["この"],["よう"],["に"],["主に","おもに"],["あって"],["しっかり"],["と"],["立って","たって"],["ください"],["。"],["私","わたくし"],["の"],["愛する","あいする"],["人","ひと"],["たち"],["。"]]},{"verse":2,"text":"ユウオデヤに勧め、スントケに勧めます。あなたがたは、主にあって一致してください。","tok":[["ユウオデヤ"],["に"],["勧め","すすめ"],["、"],["スントケ"],["に"],["勧めます","すすめます"],["。"],["あなた"],["がた"],["は"],["、"],["主に","おもに"],["あって"],["一致","いっち"],["して"],["ください"],["。"]]},{"verse":3,"text":"ほんとうに、真の協力者よ。あなたにも頼みます。彼女たちを助けてやってください。この人たちは、いのちの書に名のしるされているクレメンスや、そのほかの私の同労者たちとともに、福音を広めることで私に協力して戦ったのです。","tok":[["ほんとう"],["に"],["、"],["真","しん"],["の"],["協力者","きょうりょくしゃ"],["よ"],["。"],["あなた"],["に"],["も"],["頼みます","たのみます"],["。"],["彼女","かのじょ"],["たち"],["を"],["助けて","たすけて"],["やって"],["ください"],["。"],["この"],["人","ひと"],["たち"],["は"],["、"],["いのち"],["の"],["書","しょ"],["に"],["名","な"],["の"],["しるされて"],["いる"],["クレメンス"],["や"],["、"],["その"],["ほか"],["の"],["私","わたくし"],["の"],["同労者","どうろうしゃ"],["たち"],["と"],["とも"],["に"],["、"],["福音","ふくいん"],["を"],["広める","ひろめる"],["こと"],["で"],["私","わたくし"],["に"],["協力","きょうりょく"],["して"],["戦った","たたかった"],["の"],["です"],["。"]]},{"verse":4,"text":"いつも主にあって喜びなさい。もう一度言います。喜びなさい。","tok":[["いつも"],["主に","おもに"],["あって"],["喜び","よろこび"],["なさい"],["。"],["もう"],["一度","いちど"],["言います","いいます"],["。"],["喜び","よろこび"],["なさい"],["。"]]},{"verse":5,"text":"あなたがたの寛容な心を、すべての人に知らせなさい。主は近いのです。","tok":[["あなた"],["がた"],["の"],["寛容","かんよう"],["な"],["心","こころ"],["を"],["、"],["すべて"],["の"],["人","ひと"],["に"],["知らせ","しらせ"],["なさい"],["。"],["主","ぬし"],["は"],["近い","ちかい"],["の"],["です"],["。"]]},{"verse":6,"text":"何も思い煩わないで、あらゆる場合に、感謝をもってささげる祈りと願いによって、あなたがたの願い事を神に知っていただきなさい。","tok":[["何","なん"],["も"],["思い煩わないで","おもいわずらわないで"],["、"],["あらゆる"],["場合","ばあい"],["に"],["、"],["感謝","かんしゃ"],["を"],["もって"],["ささげる"],["祈り","いのり"],["と"],["願い","ねがい"],["によって"],["、"],["あなた"],["がた"],["の"],["願い事","ねがいごと"],["を"],["神","かみ"],["に"],["知って","しって"],["いただき"],["なさい"],["。"]]},{"verse":7,"text":"そうすれば、人のすべての考えにまさる神の平安が、あなたがたの心と思いをキリスト・イエスにあって守ってくれます。","tok":[["そう"],["すれば"],["、"],["人","ひと"],["の"],["すべて"],["の"],["考え","かんがえ"],["に"],["まさる"],["神","かみ"],["の"],["平安","へいあん"],["が"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["と"],["思い","おもい"],["を"],["キリスト"],["・"],["イエス"],["に"],["あって"],["守って","まもって"],["くれます"],["。"]]},{"verse":8,"text":"最後に、兄弟たち。すべての真実なこと、すべての誉れあること、すべての正しいこと、すべての清いこと、すべての愛すべきこと、すべての評判の良いこと、そのほか徳と言われること、称賛に値することがあるならば、そのようなことに心を留めなさい。","tok":[["最後","さいご"],["に"],["、"],["兄弟","きょうだい"],["たち"],["。"],["すべて"],["の"],["真実","しんじつ"],["な"],["こと"],["、"],["すべて"],["の"],["誉れ","ほまれ"],["ある"],["こと"],["、"],["すべて"],["の"],["正しい","ただしい"],["こと"],["、"],["すべて"],["の"],["清い","きよい"],["こと"],["、"],["すべて"],["の"],["愛すべき","あいすべき"],["こと"],["、"],["すべて"],["の"],["評判","ひょうばん"],["の"],["良い","よい"],["こと"],["、"],["その"],["ほか"],["徳","とく"],["と"],["言われる","いわれる"],["こと"],["、"],["称賛","しょうさん"],["に"],["値","あたい"],["する"],["こと"],["が"],["あるならば"],["、"],["その"],["よう"],["な"],["こと"],["に"],["心","こころ"],["を"],["留め","とめ"],["なさい"],["。"]]},{"verse":9,"text":"あなたがたが私から学び、受け、聞き、また見たことを実行しなさい。そうすれば、平和の神があなたがたとともにいてくださいます。","tok":[["あなた"],["がた"],["が"],["私","わたくし"],["から"],["学び","まなび"],["、"],["受け","うけ"],["、"],["聞き","きき"],["、"],["また"],["見た","みた"],["こと"],["を"],["実行","じっこう"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["平和","へいわ"],["の"],["神","かみ"],["が"],["あなた"],["がた"],["と"],["とも"],["に"],["いて"],["くださいます"],["。"]]},{"verse":10,"text":"私のことを心配してくれるあなたがたの心が、このたびついによみがえって来たことを、私は主にあって非常に喜びました。あなたがたは心にかけてはいたのですが、機会がなかったのです。","tok":[["私","わたくし"],["の"],["こと"],["を"],["心配","しんぱい"],["して"],["くれる"],["あなた"],["がた"],["の"],["心","こころ"],["が"],["、"],["この"],["たび"],["ついに"],["よみがえって"],["来た","きた"],["こと"],["を"],["、"],["私","わたくし"],["は"],["主に","おもに"],["あって"],["非常","ひじょう"],["に"],["喜びました","よろこびました"],["。"],["あなた"],["がた"],["は"],["心","こころ"],["に"],["かけて"],["は"],["いた"],["の"],["です"],["が"],["、"],["機会","きかい"],["が"],["なかった"],["の"],["です"],["。"]]},{"verse":11,"text":"乏しいからこう言うのではありません。私は、どんな境遇にあっても満ち足りることを学びました。","tok":[["乏しい","とぼしい"],["から"],["こう"],["言う","いう"],["ので"],["は"],["ありません"],["。"],["私","わたくし"],["は"],["、"],["どんな"],["境遇","きょうぐう"],["に"],["あって"],["も"],["満ち足りる","みちたりる"],["こと"],["を"],["学びました","まなびました"],["。"]]},{"verse":12,"text":"私は、貧しさの中にいる道も知っており、豊かさの中にいる道も知っています。また、飽くことにも飢えることにも、富むことにも乏しいことにも、あらゆる境遇に対処する秘訣を心得ています。","tok":[["私","わたくし"],["は"],["、"],["貧し","まずし"],["さ"],["の"],["中","なか"],["に"],["いる"],["道","みち"],["も"],["知って","しって"],["おり"],["、"],["豊か","ゆたか"],["さ"],["の"],["中","なか"],["に"],["いる"],["道","みち"],["も"],["知って","しって"],["います"],["。"],["また"],["、"],["飽く","あく"],["こと"],["に"],["も"],["飢える","うえる"],["こと"],["に"],["も"],["、"],["富む","とむ"],["こと"],["に"],["も"],["乏しい","とぼしい"],["こと"],["に"],["も"],["、"],["あらゆる"],["境遇","きょうぐう"],["に"],["対処","たいしょ"],["する"],["秘訣","ひけつ"],["を"],["心得て","こころえて"],["います"],["。"]]},{"verse":13,"text":"私は、私を強くしてくださる方によって、どんなことでもできるのです。","tok":[["私","わたくし"],["は"],["、"],["私","わたくし"],["を"],["強く","つよく"],["して"],["くださる"],["方","かた"],["によって"],["、"],["どんな"],["こと"],["で"],["も"],["できる"],["の"],["です"],["。"]]},{"verse":14,"text":"それにしても、あなたがたは、よく私と困難を分け合ってくれました。","tok":[["それ"],["に"],["して"],["も"],["、"],["あなた"],["がた"],["は"],["、"],["よく"],["私","わたくし"],["と"],["困難","こんなん"],["を"],["分け合って","わけあって"],["くれました"],["。"]]},{"verse":15,"text":"ピリピの人たち。あなたがたも知っているとおり、私が福音を宣べ伝え始めたころ、マケドニヤを離れて行ったときには、私の働きのために、物をやり取りしてくれた教会は、あなたがたのほかには一つもありませんでした。","tok":[["ピリピ"],["の"],["人","ひと"],["たち"],["。"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["私","わたくし"],["が"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["始めた","はじめた"],["ころ"],["、"],["マケドニヤ"],["を"],["離れて","はなれて"],["行った","いった"],["とき"],["に"],["は"],["、"],["私","わたくし"],["の"],["働き","はたらき"],["の"],["ため"],["に"],["、"],["物","もの"],["を"],["やり取り","やりとり"],["して"],["くれた"],["教会","きょうかい"],["は"],["、"],["あなた"],["がた"],["の"],["ほか"],["に"],["は"],["一","ひと"],["つ"],["も"],["ありませんでした"],["。"]]},{"verse":16,"text":"テサロニケにいたときでさえ、あなたがたは一度ならず二度までも物を送って、私の乏しさを補ってくれました。","tok":[["テサロニケ"],["に"],["いた"],["とき"],["で"],["さえ"],["、"],["あなた"],["がた"],["は"],[
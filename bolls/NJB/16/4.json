[{"verse":1,"text":"サヌバラテは私たちが城壁を修復していることを聞くと、怒り、また非常に憤慨して、ユダヤ人たちをあざけった。","tok":[["サヌバラテ"],["は"],["私たち","わたしたち"],["が"],["城壁","じょうへき"],["を"],["修復","しゅうふく"],["して"],["いる"],["こと"],["を"],["聞く","きく"],["と"],["、"],["怒り","いかり"],["、"],["また"],["非常","ひじょう"],["に"],["憤慨","ふんがい"],["して"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["を"],["あざけった"],["。"]]},{"verse":2,"text":"彼はその同胞と、サマリヤの有力者たちの前で言った。「この哀れなユダヤ人たちは、いったい何をしているのか。あれを修復して、いけにえをささげようとするのか。一日で仕上げようとするのか。焼けてしまった石をちりあくたの山から生き返らせようとするのか。」","tok":[["彼","かれ"],["は"],["その"],["同胞","どうほう"],["と"],["、"],["サマリヤ"],["の"],["有力","ゆうりょく"],["者","しゃ"],["たち"],["の"],["前","まえ"],["で"],["言った","いった"],["。"],["「"],["この"],["哀れ","あわれ"],["な"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["いったい"],["何","なん"],["を"],["して"],["いる"],["の"],["か"],["。"],["あれ"],["を"],["修復","しゅうふく"],["して"],["、"],["いけにえ"],["を"],["ささげよう"],["と"],["する"],["の"],["か"],["。"],["一","いち"],["日","にち"],["で"],["仕上げよう","しあげよう"],["と"],["する"],["の"],["か"],["。"],["焼けて","やけて"],["しまった"],["石","いし"],["を"],["ちりあくた"],["の"],["山","やま"],["から"],["生き返らせよう","いきかえらせよう"],["と"],["する"],["の"],["か"],["。"],["」"]]},{"verse":3,"text":"彼のそばにいたアモン人トビヤもまた、「彼らの建て直している城壁なら、一匹の狐が上っても、その石垣をくずしてしまうだろう」と言った。","tok":[["彼","かれ"],["の"],["そば"],["に"],["いた"],["アモン人","あもんにん"],["トビヤ"],["も"],["また"],["、"],["「"],["彼","かれ"],["ら"],["の"],["建て直して","たてなおして"],["いる"],["城壁","じょうへき"],["なら"],["、"],["一匹","いちひき"],["の"],["狐","きつね"],["が"],["上って","のぼって"],["も"],["、"],["その"],["石垣","いしがき"],["を"],["くずして"],["しまうだろう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"「お聞きください、私たちの神。私たちは軽蔑されています。彼らのそしりを彼らの頭に返し、彼らが捕囚の地でかすめ奪われるようにしてください。","tok":[["「"],["お聞き","おきき"],["ください"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["。"],["私たち","わたしたち"],["は"],["軽蔑","けいべつ"],["されて"],["います"],["。"],["彼","かれ"],["ら"],["の"],["そ"],["しり"],["を"],["彼","かれ"],["ら"],["の"],["頭","あたま"],["に"],["返し","かえし"],["、"],["彼","かれ"],["ら"],["が"],["捕囚","ほしゅう"],["の"],["地","ち"],["で"],["かすめ"],["奪われる","うばわれる"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":5,"text":"彼らの咎を赦すことなく、彼らの罪を御前からぬぐい去らないでください。彼らは建て直す者たちを侮辱したからです。」","tok":[["彼","かれ"],["ら"],["の"],["咎","とが"],["を"],["赦す","ゆるす"],["こと"],["なく"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["御前","ごぜん"],["から"],["ぬぐい去らないで","ぬぐいさらないで"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["建て直す","たてなおす"],["者","もの"],["たち"],["を"],["侮辱","ぶじょく"],["した"],["から"],["です"],["。"],["」"]]},{"verse":6,"text":"こうして、私たちは城壁を建て直し、城壁はみな、その高さの半分まで継ぎ合わされた。民に働く気があったからである。","tok":[["こう"],["して"],["、"],["私たち","わたしたち"],["は"],["城壁","じょうへき"],["を"],["建て直し","たてなおし"],["、"],["城壁","じょうへき"],["は"],["みな"],["、"],["その"],["高さ","たかさ"],["の"],["半分","はんぶん"],["まで"],["継ぎ合わされた","つぎあわされた"],["。"],["民","たみ"],["に"],["働く","はたらく"],["気","き"],["が"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"ところが、サヌバラテ、トビヤ、アラブ人、アモン人、アシュドデ人たちは、エルサレムの城壁の修復がはかどり、割れ目もふさがり始めたことを聞いたとき、非常に怒り、","tok":[["ところ"],["が"],["、"],["サヌバラテ"],["、"],["トビヤ"],["、"],["アラブ人","あらぶじん"],["、"],["アモン人","あもんにん"],["、"],["アシュドデ"],["人","ひと"],["たち"],["は"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["の"],["修復","しゅうふく"],["が"],["はかどり"],["、"],["割れ目","われめ"],["も"],["ふさがり"],["始めた","はじめた"],["こと"],["を"],["聞いた","きいた"],["とき"],["、"],["非常","ひじょう"],["に"],["怒り","おこり"],["、"]]},{"verse":8,"text":"彼らはみな共にエルサレムに攻め入り、混乱を起こそうと陰謀を企てた。","tok":[["彼","かれ"],["ら"],["は"],["みな"],["共","とも"],["に"],["エルサレム"],["に"],["攻め入り","せめいり"],["、"],["混乱","こんらん"],["を"],["起こそう","おこそう"],["と"],["陰謀","いんぼう"],["を"],["企てた","くわだてた"],["。"]]},{"verse":9,"text":"しかし私たちは、私たちの神に祈り、彼らに備えて日夜見張りを置いた。","tok":[["しかし"],["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["に"],["祈り","いのり"],["、"],["彼","かれ"],["ら"],["に"],["備えて","そなえて"],["日夜","にちや"],["見張り","みはり"],["を"],["置いた","おいた"],["。"]]},{"verse":10,"text":"そのとき、ユダの人々は言った。「荷をになう者の力は衰えているのに、ちりあくたは山をなしている。私たちは城壁を築くことはできない。」","tok":[["その"],["とき"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["。"],["「"],["荷","に"],["を"],["になう"],["者","もの"],["の"],["力","ちから"],["は"],["衰えて","おとろえて"],["いる"],["のに"],["、"],["ちりあくた"],["は"],["山","やま"],["を"],["なして"],["いる"],["。"],["私たち","わたしたち"],["は"],["城壁","じょうへき"],["を"],["築く","きずく"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":11,"text":"一方、私たちの敵は言った。「彼らの知らないうちに、また見ないうちに、彼らの真ん中に入り込んで、彼らを殺し、その工事をやめさせよう。」","tok":[["一方","いっぽう"],["、"],["私たち","わたしたち"],["の"],["敵","てき"],["は"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["の"],["知らない","しらない"],["うち"],["に"],["、"],["また"],["見ない","みない"],["うち"],["に"],["、"],["彼","かれ"],["ら"],["の"],["真ん中","まんなか"],["に"],["入り込んで","はいりこんで"],["、"],["彼","かれ"],["ら"],["を"],["殺し","ころし"],["、"],["その"],["工事","こうじ"],["を"],["やめさせよう"],["。"],["」"]]},{"verse":12,"text":"そこで、彼らの近くに住んでいたユダヤ人たちがやって来て、四方から十回も私たちに言った。「私たちのところに戻って来てほしい。」","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["の"],["近く","ちかく"],["に"],["住んで","すんで"],["いた"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["やって"],["来て","きて"],["、"],["四方","しほう"],["から"],["十","じゅう"],["回","かい"],["も"],["私たち","わたしたち"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["の"],["ところ"],["に"],["戻って","もどって"],["来て","きて"],["ほしい"],["。"],["」"]]},{"verse":13,"text":"そこで私は、民をその家族ごとに、城壁のうしろの低い所の、空地に、剣や槍や弓を持たせて配置した。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["民","みん"],["を"],["その"],["家族","かぞく"],["ごと"],["に"],["、"],["城壁","じょうへき"],["の"],["うしろ"],["の"],["低い","ひくい"],["所","ところ"],["の"],["、"],["空地","くうち"],["に"],["、"],["剣","けん"],["や"],["槍","やり"],["や"],["弓","ゆみ"],["を"],["持たせて","もたせて"],["配置","はいち"],["した"],["。"]]},{"verse":14,"text":"私は彼らが恐れているのを見て立ち上がり、おもだった人々や、代表者たち、およびその他の人々に言った。「彼らを恐れてはならない。大いなる恐るべき主を覚え、自分たちの兄弟、息子、娘、妻、また家のために戦いなさい。」","tok":[["私","わたくし"],["は"],["彼","かれ"],["ら"],["が"],["恐れて","おそれて"],["いる"],["の"],["を"],["見て","みて"],["立ち上がり","たちあがり"],["、"],["おも"],["だった"],["人々","ひとびと"],["や"],["、"],["代表者","だいひょうしゃ"],["たち"],["、"],["および"],["その"],["他","た"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["主","ぬし"],["を"],["覚え","おぼえ"],["、"],["自分","じぶん"],["たち"],["の"],["兄弟","きょうだい"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["妻","つま"],["、"],["また"],["家","いえ"],["の"],["ため"],["に"],["戦い","たたかい"],["なさい"],["。"],["」"]]},{"verse":15,"text":"私たちの敵が、彼らのたくらみは私たちに悟られ、神がそれを打ちこわされたということを聞いたとき、私たちはみな、城壁に帰り、それぞれ自分の工事に戻った。","tok":[["私たち","わたしたち"],["の"],["敵","てき"],["が"],["、"],["彼","かれ"],["ら"],["の"],["たくらみ"],["は"],["私たち","わたしたち"],["に"],["悟られ","さとられ"],["、"],["神","かみ"],["が"],["それ"],["を"],["打ちこわされた","うちこわされた"],["と"],["いう"],["こと"],["を"],["聞いた","きいた"],["とき"],["、"],["私たち","わたしたち"],["は"],["みな"],["、"],["城壁","じょうへき"],["に"],["帰り","かえり"],["、"],["それぞれ"],["自分","じぶん"],["の"],["工事","こうじ"],["に"],["戻った","もどった"],["。"]]},{"verse":16,"text":"その日以来、私に仕える若い者の半分は工事を続け、他の半分は、槍や、盾、弓、よろいで身を固めていた。一方、隊長たちはユダの全家を守った。","tok":[["その"],["日","ひ"],["以来","いらい"],["、"],["私","わたくし"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["の"],["半分","はんぶん"],["は"],["工事","こうじ"],["を"],["続け","つづけ"],["、"],["他","た"],["の"],["半分","はんぶん"],["は"],["、"],["槍","やり"],["や"],["、"],["盾","たて"],["、"],["弓","ゆみ"],["、"],["よろい"],["で"],["身","み"],["を"],["固めて","かためて"],["いた"],["。"],["一方","いっぽう"],["、"],["隊長","たいちょう"],["たち"],["は"],["ユダ"],["の"],["全","ぜん"],["家","いえ"],["を"],["守った","まもった"],["。"]]},{"verse":17,"text":"城壁を築く者たち、荷をかついで運ぶ者たちは、片手で仕事をし、片手に投げ槍を堅く握っていた。","tok":[["城壁","じょうへき"],["を"],["築く","きずく"],["者","もの"],["たち"],["、"],["荷","に"],["を"],["かついで"],["運ぶ","はこぶ"],["者","もの"],["たち"],["は"],["、"],["片手","かたて"],["で"],["仕事","しごと"],["を"],["し"],["、"],["片手","かたて"],["に"],["投げ槍","なげやり"],["を"],["堅く","かたく"],["握って","にぎって"],["いた"],["。"]]},{"verse":18,"text":"築く者は、それぞれ剣を腰にして築き、角笛を吹き鳴らす者は、私のそばにいた。","tok":[["築く","きずく"],["者","もの"],["は"],["、"],["それぞれ"],["剣","けん"],["を"],["腰","こし"],["に"],["して"],["築き","きずき"],["、"],["角笛","つのぶえ"],["を"],["吹き鳴らす","ふきならす"],["者","もの"],["は"],["、"],["私","わたくし"],["の"],["そば"],["に"],["いた"],["。"]]},{"verse":19,"text":"私はおもだった人々や、代表者たち、およびその他の人々に言った。「この工事は大きく、また広がっている。私たちは城壁の上で互いに遠く離れ離れになっている。","tok":[["私","わたくし"],["は"],["おも"],["だった"],["人々","ひとびと"],["や"],["、"],["代表者","だいひょうしゃ"],["たち"],["、"],["および"],["その"],["他","た"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["。"],["「"],["この"],["工事","こうじ"],["は"],["大きく","おおきく"],["、"],["また"],["広がって","ひろがって"],["いる"],["。"],["私たち","わたしたち"],["は"],["城壁","じょうへき"],["の"],["上","うえ"],["で"],["互い","たがい"],["に"],["遠く","とおく"],["離れ離れ","はなればなれ"],["に"],["なって"],["いる"],["。"]]},{"verse":20,"text":"どこででも、あなたがたが角笛の鳴るのを聞いたら、私たちのところに集まって来なさい。私たちの神が私たちのために戦ってくださるのだ。」","tok":[["どこ"],["で"],["で"],["も"],["、"],["あなた"],["がた"],["が"],["角笛","つのぶえ"],["の"],["鳴る","なる"],["の"],["を"],["聞いたら","きいたら"],["、"],["私たち","わたしたち"],["の"],["ところ"],["に"],["集まって","あつまって"],["来","き"],["なさい"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["が"],["私たち","わたしたち"],["の"],["ため"],["に"],["戦って","たたかって"],["くださる"],["の"],["だ"],["。"],["」"]]},{"verse":21,"text":"こうして、私たちはこの工事を進めたが、その半分の者は、夜明けから星の現れる時まで、槍を手に取っていた。","tok":[["こう"],["して"],["、"],["私たち","わたしたち"],["は"],["この"],["工事","こうじ"],["を"],["進めた","すすめた"],["が"],["、"],["その"],["半分","はんぶん"],["の"],["者","もの"],["は"],["、"],["夜明け","よあけ"],["から"],["星","ほし"],["の"],["現れる","あらわれる"],["時","とき"],["まで"],["、"],["槍","やり"],["を"],["手","て"],["に"],["取って","とって"],["いた"],["。"]]},{"verse":22,"text":"そのときまた、私は民に言った。「だれでも自分に仕える若い者といっしょにエルサレムのうちで夜を明かすようにしなさい。そうすれば、夜にも見張りがおり、昼には働くことができる。」","tok":[["その"],["とき"],["また"],["、"],["私","わたくし"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["だれ"],["で"],["も"],["自分","じぶん"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["と"],["いっしょ"],["に"],["エルサレム"],["の"],["うち"],["で"],["夜","よる"],["を"],["明かす","あかす"],["よう"],["に"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["夜","よる"],["に"],["も"],["見張り","みはり"],["が"],["おり"],["、"],["昼","ひる"],["に"],["は"],["働く","はたらく"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":23,"text":"私も、私の親類の者も、私に仕える若い者たちも、私を守る見張りの人々も、私たちのうちのだれも、服を脱がず、それぞれ投げ槍を手にしていた。","tok":[["私","わたくし"],["も"],["、"],["私","わたくし"],["の"],["親類","しんるい"],["の"],["者","もの"],["も"],["、"],["私","わたくし"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["たち"],["も"],["、"],["私","わたくし"],["を"],["守る","まもる"],["見張り","みはり"],["の"],["人々","ひとびと"],["も"],["、"],["私たち","わたしたち"],["の"],["うち"],["の"],["だれ"],["も"],["、"],["服","ふく"],["を"],["脱がず","ぬがず"],["、"],["それぞれ"],["投げ槍","なげやり"],["を"],["手","て"],["に"],["して"],["いた"],["。"]]}]
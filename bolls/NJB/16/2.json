[{"verse":1,"text":"アルタシャスタ王の第二十年のニサンの月に、王の前に酒が出たとき、私は酒を取り上げ、それを王に差し上げた。これまで、私は王の前でしおれたことはなかった。","tok":[["アルタシャスタ"],["王","おう"],["の"],["第","だい"],["二十","にじゅう"],["年","ねん"],["の"],["ニサン"],["の"],["月","つき"],["に"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["酒","さけ"],["が"],["出た","でた"],["とき"],["、"],["私","わたくし"],["は"],["酒","さけ"],["を"],["取り上げ","とりあげ"],["、"],["それ"],["を"],["王","おう"],["に"],["差し上げた","さしあげた"],["。"],["これ"],["まで"],["、"],["私","わたくし"],["は"],["王","おう"],["の"],["前","まえ"],["で"],["しおれた"],["こと"],["は"],["なかった"],["。"]]},{"verse":2,"text":"そのとき、王は私に言った。「あなたは病気でもなさそうなのに、なぜ、そのように悲しい顔つきをしているのか。きっと心に悲しみがあるに違いない。」私はひどく恐れて、","tok":[["その"],["とき"],["、"],["王","おう"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["病気","びょうき"],["で"],["も"],["なさ"],["そう"],["な"],["のに"],["、"],["なぜ"],["、"],["その"],["よう"],["に"],["悲しい","かなしい"],["顔つき","かおつき"],["を"],["して"],["いる"],["の"],["か"],["。"],["きっと"],["心","こころ"],["に"],["悲しみ","かなしみ"],["が"],["ある"],["に"],["違い","ちがい"],["ない"],["。"],["」"],["私","わたくし"],["は"],["ひどく"],["恐れて","おそれて"],["、"]]},{"verse":3,"text":"王に言った。「王よ。いつまでも生きられますように。私の先祖の墓のある町が廃墟となり、その門が火で焼き尽くされているというのに、どうして悲しい顔をしないでおられましょうか。」","tok":[["王","おう"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["よ"],["。"],["いつ"],["まで"],["も"],["生きられます","いきられます"],["よう"],["に"],["。"],["私","わたくし"],["の"],["先祖","せんぞ"],["の"],["墓","はか"],["の"],["ある"],["町","まち"],["が"],["廃墟","はいきょ"],["と"],["なり"],["、"],["その"],["門","もん"],["が"],["火","ひ"],["で"],["焼き","やき"],["尽くされて","つくされて"],["いる"],["と"],["いう"],["のに"],["、"],["どう"],["して"],["悲しい","かなしい"],["顔","かお"],["を"],["しないで"],["おられましょう"],["か"],["。"],["」"]]},{"verse":4,"text":"すると、王は私に言った。「では、あなたは何を願うのか。」そこで私は、天の神に祈ってから、","tok":[["する"],["と"],["、"],["王","おう"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["あなた"],["は"],["何","なん"],["を"],["願う","ねがう"],["の"],["か"],["。"],["」"],["そこ"],["で"],["私","わたくし"],["は"],["、"],["天","てん"],["の"],["神","かみ"],["に"],["祈って","いのって"],["から"],["、"]]},{"verse":5,"text":"王に答えた。「王さま。もしもよろしくて、このしもべをいれてくださいますなら、私をユダの地、私の先祖の墓のある町へ送って、それを再建させてください。」","tok":[["王","おう"],["に"],["答えた","こたえた"],["。"],["「"],["王","おう"],["さま"],["。"],["もし"],["も"],["よろしくて"],["、"],["この"],["しもべ"],["を"],["いれて"],["くださいますなら"],["、"],["私","わたくし"],["を"],["ユダ"],["の"],["地","ち"],["、"],["私","わたくし"],["の"],["先祖","せんぞ"],["の"],["墓","はか"],["の"],["ある"],["町","まち"],["へ"],["送って","おくって"],["、"],["それ"],["を"],["再建","さいけん"],["させて"],["ください"],["。"],["」"]]},{"verse":6,"text":"王は私に言った。――王妃もそばにすわっていた――「旅はどのくらいかかるのか。いつ戻って来るのか。」私が王にその期間を申し出ると、王は快く私を送り出してくれた。","tok":[["王","おう"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["―"],["―"],["王妃","おうひ"],["も"],["そば"],["に"],["すわって"],["いた"],["―"],["―"],["「"],["旅","たび"],["は"],["どの"],["くらい"],["かかる"],["の"],["か"],["。"],["いつ"],["戻って","もどって"],["来る","くる"],["の"],["か"],["。"],["」"],["私","わたくし"],["が"],["王","おう"],["に"],["その"],["期間","きかん"],["を"],["申し出る","もうしでる"],["と"],["、"],["王","おう"],["は"],["快く","こころよく"],["私","わたくし"],["を"],["送り出して","おくりだして"],["くれた"],["。"]]},{"verse":7,"text":"それで、私は王に言った。「もしも、王さまがよろしければ、川向こうの総督たちへの手紙を私に賜り、私がユダに着くまで、彼らが私を通らせるようにしてください。","tok":[["それ"],["で"],["、"],["私","わたくし"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["もし"],["も"],["、"],["王","おう"],["さま"],["が"],["よろしければ"],["、"],["川向こう","かわむこう"],["の"],["総督","そうとく"],["たち"],["へ"],["の"],["手紙","てがみ"],["を"],["私","わたくし"],["に"],["賜り","たまわり"],["、"],["私","わたくし"],["が"],["ユダ"],["に"],["着く","つく"],["まで"],["、"],["彼","かれ"],["ら"],["が"],["私","わたくし"],["を"],["通らせる","とおらせる"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":8,"text":"また、王に属する御園の番人アサフへの手紙も賜り、宮の城門の梁を置くため、また、あの町の城壁と、私が入る家のために、彼が材木を私に与えるようにしてください。」私の神の恵みの御手が私の上にあったので、王はそれをかなえてくれた。","tok":[["また"],["、"],["王","おう"],["に"],["属する","ぞくする"],["御園","みその"],["の"],["番人","ばんにん"],["アサフ"],["へ"],["の"],["手紙","てがみ"],["も"],["賜り","たまわり"],["、"],["宮","みや"],["の"],["城門","じょうもん"],["の"],["梁","はり"],["を"],["置く","おく"],["ため"],["、"],["また"],["、"],["あの"],["町","まち"],["の"],["城壁","じょうへき"],["と"],["、"],["私","わたくし"],["が"],["入る","はいる"],["家","いえ"],["の"],["ため"],["に"],["、"],["彼","かれ"],["が"],["材木","ざいもく"],["を"],["私","わたくし"],["に"],["与える","あたえる"],["よう"],["に"],["して"],["ください"],["。"],["」"],["私","わたくし"],["の"],["神","かみ"],["の"],["恵み","めぐみ"],["の"],["御手","おて"],["が"],["私","わたくし"],["の"],["上","うえ"],["に"],["あった"],["ので"],["、"],["王","おう"],["は"],["それ"],["を"],["かなえて"],["くれた"],["。"]]},{"verse":9,"text":"私は、川向こうの総督たちのところに行き、王の手紙を彼らに手渡した。それに、王は将校たちと騎兵を私につけてくれた。","tok":[["私","わたくし"],["は"],["、"],["川向こう","かわむこう"],["の"],["総督","そうとく"],["たち"],["の"],["ところ"],["に"],["行き","いき"],["、"],["王","おう"],["の"],["手紙","てがみ"],["を"],["彼","かれ"],["ら"],["に"],["手渡した","てわたした"],["。"],["それ"],["に"],["、"],["王","おう"],["は"],["将校","しょうこう"],["たち"],["と"],["騎兵","きへい"],["を"],["私","わたくし"],["に"],["つけて"],["くれた"],["。"]]},{"verse":10,"text":"ホロン人サヌバラテと、アモン人で役人のトビヤは、これを聞いて、非常に不きげんになった。イスラエル人の利益を求める人がやって来たからである。","tok":[["ホロン人","ほろんにん"],["サヌバラテ"],["と"],["、"],["アモン人","あもんにん"],["で"],["役人","やくにん"],["の"],["トビヤ"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["、"],["非常","ひじょう"],["に"],["不","ふ"],["きげん"],["に"],["なった"],["。"],["イスラエル"],["人","にん"],["の"],["利益","りえき"],["を"],["求める","もとめる"],["人","ひと"],["が"],["やって"],["来た","きた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"こうして、私はエルサレムにやって来て、そこに三日間とどまった。","tok":[["こう"],["して"],["、"],["私","わたくし"],["は"],["エルサレム"],["に"],["やって"],["来て","きて"],["、"],["そこ"],["に"],["三","みっ"],["日間","かかん"],["とどまった"],["。"]]},{"verse":12,"text":"あるとき、私は夜中に起きた。ほかに数人の者もいっしょにいた。しかし、私の神が、私の心を動かしてエルサレムのためにさせようとされることを、私はだれにも告げなかった。また、私が乗った獣のほかには、一頭の獣も連れて行かなかった。","tok":[["ある"],["とき"],["、"],["私","わたくし"],["は"],["夜中","よなか"],["に"],["起きた","おきた"],["。"],["ほか"],["に"],["数人","すうにん"],["の"],["者","もの"],["も"],["いっしょ"],["に"],["いた"],["。"],["しかし"],["、"],["私","わたくし"],["の"],["神","かみ"],["が"],["、"],["私","わたくし"],["の"],["心","こころ"],["を"],["動かして","うごかして"],["エルサレム"],["の"],["ため"],["に"],["させよう"],["と"],["される"],["こと"],["を"],["、"],["私","わたくし"],["は"],["だれ"],["に"],["も"],["告げなかった","つげなかった"],["。"],["また"],["、"],["私","わたくし"],["が"],["乗った","のった"],["獣","けもの"],["の"],["ほか"],["に"],["は"],["、"],["一頭","いちとう"],["の"],["獣","けもの"],["も"],["連れて","つれて"],["行かなかった","いかなかった"],["。"]]},{"verse":13,"text":"私は夜、谷の門を通って竜の泉のほう、糞の門のところに出て行き、エルサレムの城壁を調べると、それはくずされ、その門は火で焼け尽きていた。","tok":[["私","わたくし"],["は"],["夜","よる"],["、"],["谷","たに"],["の"],["門","もん"],["を"],["通って","とおって"],["竜","りゅう"],["の"],["泉","いずみ"],["の"],["ほう"],["、"],["糞","ふん"],["の"],["門","もん"],["の"],["ところ"],["に"],["出て","でて"],["行き","いき"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["調べる","しらべる"],["と"],["、"],["それ"],["は"],["くずされ"],["、"],["その"],["門","もん"],["は"],["火","ひ"],["で"],["焼け尽きて","やけつきて"],["いた"],["。"]]},{"verse":14,"text":"さらに、私は泉の門と王の池のほうへ進んで行ったが、私の乗っている獣の通れる所がなかった。","tok":[["さらに"],["、"],["私","わたくし"],["は"],["泉","いずみ"],["の"],["門","もん"],["と"],["王","おう"],["の"],["池","いけ"],["の"],["ほう"],["へ"],["進んで","すすんで"],["行った","いった"],["が"],["、"],["私","わたくし"],["の"],["乗って","のって"],["いる"],["獣","けもの"],["の"],["通れる","とおれる"],["所","ところ"],["が"],["なかった"],["。"]]},{"verse":15,"text":"そこで、私は夜のうちに流れを上って行き、城壁を調べた。そしてまた引き返し、谷の門を通って戻って来た。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["夜","よる"],["の"],["うち"],["に"],["流れ","ながれ"],["を"],["上って","のぼって"],["行き","いき"],["、"],["城壁","じょうへき"],["を"],["調べた","しらべた"],["。"],["そして"],["また"],["引き返し","ひきかえし"],["、"],["谷","たに"],["の"],["門","もん"],["を"],["通って","とおって"],["戻って","もどって"],["来た","きた"],["。"]]},{"verse":16,"text":"代表者たちは、私がどこへ行っていたか、また私が何をしていたか知らなかった。それに、私は、それをユダヤ人にも、祭司たちにも、おもだった人たちにも、代表者たちにも、その他工事をする者たちにも、まだ知らせていなかった。","tok":[["代表者","だいひょうしゃ"],["たち"],["は"],["、"],["私","わたくし"],["が"],["どこ"],["へ"],["行って","いって"],["いた"],["か"],["、"],["また"],["私","わたくし"],["が"],["何","なん"],["を"],["して"],["いた"],["か"],["知らなかった","しらなかった"],["。"],["それ"],["に"],["、"],["私","わたくし"],["は"],["、"],["それ"],["を"],["ユダヤ人","ゆだやじん"],["に"],["も"],["、"],["祭司","さいし"],["たち"],["に"],["も"],["、"],["おも"],["だった"],["人","ひと"],["たち"],["に"],["も"],["、"],["代表者","だいひょうしゃ"],["たち"],["に"],["も"],["、"],["その"],["他","た"],["工事","こうじ"],["を"],["する"],["者","もの"],["たち"],["に"],["も"],["、"],["まだ"],["知らせて","しらせて"],["いなかった"],["。"]]},{"verse":17,"text":"それから、私は彼らに言った。「あなたがたは、私たちの当面している困難を見ている。エルサレムは廃墟となり、その門は火で焼き払われたままである。さあ、エルサレムの城壁を建て直し、もうこれ以上そしりを受けないようにしよう。」","tok":[["それ"],["から"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["の"],["当面","とうめん"],["して"],["いる"],["困難","こんなん"],["を"],["見て","みて"],["いる"],["。"],["エルサレム"],["は"],["廃墟","はいきょ"],["と"],["なり"],["、"],["その"],["門","もん"],["は"],["火","ひ"],["で"],["焼き払われた","やきはらわれた"],["まま"],["で"],["ある"],["。"],["さあ"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["建て直し","たてなおし"],["、"],["もう"],["これ"],["以上","いじょう"],["そ"],["しり"],["を"],["受けない","うけない"],["よう"],["に"],["しよう"],["。"],["」"]]},{"verse":18,"text":"そして、私に恵みを下さった私の神の御手のことと、また、王が私に話したことばを、彼らに告げた。そこで彼らは、「さあ、再建に取りかかろう」と言って、この良い仕事に着手した。","tok":[["そして"],["、"],["私","わたくし"],["に"],["恵み","めぐみ"],["を"],["下さった","くださった"],["私","わたくし"],["の"],["神","かみ"],["の"],["御手","おて"],["の"],["こと"],["と"],["、"],["また"],["、"],["王","おう"],["が"],["私","わたくし"],["に"],["話した","はなした"],["ことば"],["を"],["、"],["彼","かれ"],["ら"],["に"],["告げた","つげた"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["「"],["さあ"],["、"],["再建","さいけん"],["に"],["取りかかろう","とりかかろう"],["」"],["と"],["言って","いって"],["、"],["この"],["良い","よい"],["仕事","しごと"],["に"],["着手","ちゃくしゅ"],["した"],["。"]]},{"verse":19,"text":"ところが、ホロン人サヌバラテと、アモン人で役人のトビヤ、および、アラブ人ゲシェムは、これを聞いて、私たちをあざけり、私たちをさげすんで言った。「おまえたちのしているこのことは何だ。おまえたちは王に反逆しようとしているのか。」","tok":[["ところ"],["が"],["、"],["ホロン人","ほろんにん"],["サヌバラテ"],["と"],["、"],["アモン人","あもんにん"],["で"],["役人","やくにん"],["の"],["トビヤ"],["、"],["および"],["、"],["アラブ人","あらぶじん"],["ゲシェム"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["、"],["私たち","わたしたち"],["を"],["あざけり"],["、"],["私たち","わたしたち"],["を"],["さげすんで"],["言った","いった"],["。"],["「"],["おまえ"],["たち"],["の"],["して"],["いる"],["この"],["こと"],["は"],["何","なん"],["だ"],["。"],["おまえ"],["たち"],["は"],["王","おう"],["に"],["反逆","はんぎゃく"],["しよう"],["として"],["いる"],["の"],["か"],["。"],["」"]]},{"verse":20,"text":"そこで、私は彼らにことばを返して言った。「天の神ご自身が、私たちを成功させてくださる。だから、そのしもべである私たちは、再建に取りかかっているのだ。しかし、あなたがたにはエルサレムの中に何の分け前も、権利も、記念もないのだ。」","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["に"],["ことば"],["を"],["返して","かえして"],["言った","いった"],["。"],["「"],["天","てん"],["の"],["神","かみ"],["ご自身","ごじしん"],["が"],["、"],["私たち","わたしたち"],["を"],["成功","せいこう"],["させて"],["くださる"],["。"],["だ"],["から"],["、"],["その"]
[{"verse":1,"text":"ときに、民とその妻たちは、その同胞のユダヤ人たちに対して強い抗議の声をあげた。","tok":[["とき"],["に"],["、"],["民","みん"],["と"],["その"],["妻たち","つまたち"],["は"],["、"],["その"],["同胞","どうほう"],["の"],["ユダヤ人","ゆだやじん"],["たち"],["に対して","にたいして"],["強い","つよい"],["抗議","こうぎ"],["の"],["声","こえ"],["を"],["あげた"],["。"]]},{"verse":2,"text":"ある者は、「私たちには息子や娘が大ぜいいる。私たちは、食べて生きるために、穀物を手に入れなければならない」と言い、","tok":[["ある"],["者","もの"],["は"],["、"],["「"],["私たち","わたしたち"],["に"],["は"],["息子","むすこ"],["や"],["娘","むすめ"],["が"],["大ぜい","おおぜい"],["いる"],["。"],["私たち","わたしたち"],["は"],["、"],["食べて","たべて"],["生きる","いきる"],["ため"],["に"],["、"],["穀物","こくもつ"],["を"],["手","て"],["に"],["入れなければ","いれなければ"],["ならない"],["」"],["と"],["言い","いい"],["、"]]},{"verse":3,"text":"またある者は、「このききんに際し、穀物を手に入れるために、私たちの畑も、ぶどう畑も、家も抵当に入れなければならない」と言った。","tok":[["また"],["ある"],["者","もの"],["は"],["、"],["「"],["この"],["ききん"],["に"],["際し","さいし"],["、"],["穀物","こくもつ"],["を"],["手","て"],["に"],["入れる","いれる"],["ため"],["に"],["、"],["私たち","わたしたち"],["の"],["畑","はたけ"],["も"],["、"],["ぶどう"],["畑","はたけ"],["も"],["、"],["家","いえ"],["も"],["抵当","ていとう"],["に"],["入れなければ","いれなければ"],["ならない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"またある者は言った。「私たちは、王に支払う税金のために、私たちの畑とぶどう畑をかたにして、金を借りなければならなかった。","tok":[["また"],["ある"],["者","もの"],["は"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["王","おう"],["に"],["支払う","しはらう"],["税金","ぜいきん"],["の"],["ため"],["に"],["、"],["私たち","わたしたち"],["の"],["畑","はたけ"],["と"],["ぶどう"],["畑","はたけ"],["を"],["かた"],["に"],["して"],["、"],["金","きん"],["を"],["借りなければ","かりなければ"],["ならなかった"],["。"]]},{"verse":5,"text":"現に、私たちの肉は私たちの兄弟の肉と同じであり、私たちの子どもも彼らの子どもと同じなのだ。それなのに、今、私たちは自分たちの息子や娘を奴隷に売らなければならない。事実、私たちの娘で、もう奴隷にされている者もいる。しかし、私たちの畑もぶどう畑も他人の所有となっているので、私たちにはどうする力もない。」","tok":[["現に","げんに"],["、"],["私たち","わたしたち"],["の"],["肉","にく"],["は"],["私たち","わたしたち"],["の"],["兄弟","きょうだい"],["の"],["肉","にく"],["と"],["同じ","おなじ"],["で"],["あり"],["、"],["私たち","わたしたち"],["の"],["子ども","こども"],["も"],["彼","かれ"],["ら"],["の"],["子ども","こども"],["と"],["同じ","おなじ"],["な"],["の"],["だ"],["。"],["それ"],["な"],["のに"],["、"],["今","いま"],["、"],["私たち","わたしたち"],["は"],["自分","じぶん"],["たち"],["の"],["息子","むすこ"],["や"],["娘","むすめ"],["を"],["奴隷","どれい"],["に"],["売らなければ","うらなければ"],["ならない"],["。"],["事実","じじつ"],["、"],["私たち","わたしたち"],["の"],["娘","むすめ"],["で"],["、"],["もう"],["奴隷","どれい"],["に"],["されて"],["いる"],["者","もの"],["も"],["いる"],["。"],["しかし"],["、"],["私たち","わたしたち"],["の"],["畑","はたけ"],["も"],["ぶどう"],["畑","はたけ"],["も"],["他人","たにん"],["の"],["所有","しょゆう"],["と"],["なって"],["いる"],["ので"],["、"],["私たち","わたしたち"],["に"],["は"],["どう"],["する"],["力","ちから"],["も"],["ない"],["。"],["」"]]},{"verse":6,"text":"私は彼らの不平と、これらのことばを聞いて、非常に怒った。","tok":[["私","わたくし"],["は"],["彼","かれ"],["ら"],["の"],["不平","ふへい"],["と"],["、"],["これ"],["ら"],["の"],["ことば"],["を"],["聞いて","きいて"],["、"],["非常","ひじょう"],["に"],["怒った","おこった"],["。"]]},{"verse":7,"text":"私は十分考えたうえで、おもだった者たちや代表者たちを非難して言った。「あなたがたはみな、自分の兄弟たちに、担保を取って金を貸している」と。私は大集会を開いて彼らを責め、","tok":[["私","わたくし"],["は"],["十分","じゅうぶん"],["考えた","かんがえた"],["うえ"],["で"],["、"],["おも"],["だった"],["者","もの"],["たち"],["や"],["代表者","だいひょうしゃ"],["たち"],["を"],["非難","ひなん"],["して"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["みな"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["たち"],["に"],["、"],["担保","たんぽ"],["を"],["取って","とって"],["金","きん"],["を"],["貸して","かして"],["いる"],["」"],["と"],["。"],["私","わたくし"],["は"],["大","だい"],["集会","しゅうかい"],["を"],["開いて","ひらいて"],["彼","かれ"],["ら"],["を"],["責め","せめ"],["、"]]},{"verse":8,"text":"彼らに言った。「私たちは、異邦人に売られた私たちの兄弟、ユダヤ人を、できるかぎり買い取った。それなのに、あなたがたはまた、自分の兄弟たちを売ろうとしている。私たちが彼らを買わなければならないのだ。」すると、彼らは黙ってしまい、一言も言いだせなかった。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["異邦人","いほうじん"],["に"],["売られた","うられた"],["私たち","わたしたち"],["の"],["兄弟","きょうだい"],["、"],["ユダヤ人","ゆだやじん"],["を"],["、"],["できる"],["かぎり"],["買い取った","かいとった"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["また"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["たち"],["を"],["売ろう","うろう"],["として"],["いる"],["。"],["私たち","わたしたち"],["が"],["彼","かれ"],["ら"],["を"],["買わなければ","かわなければ"],["ならない"],["の"],["だ"],["。"],["」"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["黙って","だまって"],["しまい"],["、"],["一言","ひとこと"],["も"],["言い","いい"],["だせなかった"],["。"]]},{"verse":9,"text":"私は言い続けた。「あなたがたのしていることは良くない。あなたがたは、私たちの敵である異邦人のそしりを受けないために、私たちの神を恐れながら歩むべきではないか。","tok":[["私","わたくし"],["は"],["言い","いい"],["続けた","つづけた"],["。"],["「"],["あなた"],["がた"],["の"],["して"],["いる"],["こと"],["は"],["良く","よく"],["ない"],["。"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["の"],["敵","てき"],["で"],["ある"],["異邦人","いほうじん"],["の"],["そ"],["しり"],["を"],["受けない","うけない"],["ため"],["に"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["を"],["恐れ","おそれ"],["ながら"],["歩むべきで","あゆむべきで"],["は"],["ない"],["か"],["。"]]},{"verse":10,"text":"私も、私の親類の者も、私に仕える若い者たちも、彼らに金や穀物を貸してやったが、私たちはその負債を帳消しにしよう。","tok":[["私","わたくし"],["も"],["、"],["私","わたくし"],["の"],["親類","しんるい"],["の"],["者","もの"],["も"],["、"],["私","わたくし"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["たち"],["も"],["、"],["彼","かれ"],["ら"],["に"],["金","かね"],["や"],["穀物","こくもつ"],["を"],["貸して","かして"],["やった"],["が"],["、"],["私たち","わたしたち"],["は"],["その"],["負債","ふさい"],["を"],["帳消し","ちょうけし"],["に"],["しよう"],["。"]]},{"verse":11,"text":"だから、あなたがたも、きょう、彼らの畑、ぶどう畑、オリーブ畑、家、それにまた、あなたがたが彼らに貸していた金や、穀物、新しいぶどう酒、油などの利子を彼らに返してやりなさい。」","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["も"],["、"],["きょう"],["、"],["彼","かれ"],["ら"],["の"],["畑","はたけ"],["、"],["ぶどう"],["畑","はたけ"],["、"],["オリーブ"],["畑","はたけ"],["、"],["家","いえ"],["、"],["それ"],["に"],["また"],["、"],["あなた"],["がた"],["が"],["彼","かれ"],["ら"],["に"],["貸して","かして"],["いた"],["金","かね"],["や"],["、"],["穀物","こくもつ"],["、"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["、"],["油","あぶら"],["など"],["の"],["利子","りし"],["を"],["彼","かれ"],["ら"],["に"],["返して","かえして"],["やり"],["なさい"],["。"],["」"]]},{"verse":12,"text":"すると彼らは、「私たちは返します。彼らから何も要求しません。私たちはあなたの言われるとおりにします」と言った。そこで、私は祭司たちを呼び、彼らにこの約束を実行する誓いを立てさせた。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["、"],["「"],["私たち","わたしたち"],["は"],["返します","かえします"],["。"],["彼","かれ"],["ら"],["から"],["何","なん"],["も"],["要求","ようきゅう"],["しません"],["。"],["私たち","わたしたち"],["は"],["あなた"],["の"],["言われる","いわれる"],["とおり"],["に"],["します"],["」"],["と"],["言った","いった"],["。"],["そこ"],["で"],["、"],["私","わたくし"],["は"],["祭司","さいし"],["たち"],["を"],["呼び","よび"],["、"],["彼","かれ"],["ら"],["に"],["この"],["約束","やくそく"],["を"],["実行","じっこう"],["する"],["誓い","ちかい"],["を"],["立てさせた","たてさせた"],["。"]]},{"verse":13,"text":"私はまた、私のすそを振って言った。「この約束を果たさない者を、ひとり残らず、神がこのように、その家とその勤労の実とから振り落としてくださいますように。このように、その者は振り落とされて、むなしいものとなりますように。」すると全集団は、「アーメン」と言って、主をほめたたえた。こうして、民はこの約束を実行した。","tok":[["私","わたくし"],["は"],["また"],["、"],["私","わたくし"],["の"],["すそ"],["を"],["振って","ふって"],["言った","いった"],["。"],["「"],["この"],["約束","やくそく"],["を"],["果たさない","はたさない"],["者","もの"],["を"],["、"],["ひとり"],["残らず","のこらず"],["、"],["神","かみ"],["が"],["この"],["よう"],["に"],["、"],["その"],["家","いえ"],["と"],["その"],["勤労","きんろう"],["の"],["実","じつ"],["と"],["から"],["振り落として","ふりおとして"],["くださいます"],["よう"],["に"],["。"],["この"],["よう"],["に"],["、"],["その"],["者","もの"],["は"],["振り落とされて","ふりおとされて"],["、"],["むなしい"],["もの"],["と"],["なります"],["よう"],["に"],["。"],["」"],["する"],["と"],["全","ぜん"],["集団","しゅうだん"],["は"],["、"],["「"],["アーメン"],["」"],["と"],["言って","いって"],["、"],["主","ぬし"],["を"],["ほめたたえた"],["。"],["こう"],["して"],["、"],["民","みん"],["は"],["この"],["約束","やくそく"],["を"],["実行","じっこう"],["した"],["。"]]},{"verse":14,"text":"また、私がユダの地の総督として任命された時から、すなわち、アルタシャスタ王の第二十年から第三十二年までの十二年間、私も私の親類も、総督としての手当を受けなかった。","tok":[["また"],["、"],["私","わたくし"],["が"],["ユダ"],["の"],["地","ち"],["の"],["総督","そうとく"],["として"],["任命","にんめい"],["された"],["時","とき"],["から"],["、"],["すなわち"],["、"],["アルタシャスタ"],["王","おう"],["の"],["第","だい"],["二十","にじゅう"],["年","ねん"],["から"],["第","だい"],["三十二","さんじゅうに"],["年","ねん"],["まで"],["の"],["十二","じゅうに"],["年間","ねんかん"],["、"],["私","わたくし"],["も"],["私","わたくし"],["の"],["親類","しんるい"],["も"],["、"],["総督","そうとく"],["として"],["の"],["手当","てあて"],["を"],["受けなかった","うけなかった"],["。"]]},{"verse":15,"text":"私の前任の総督たちは民の負担を重くし、民から、パンとぶどう酒のために取り立て、そのうえ、銀四十シェケルを取った。しかも、彼らに仕える若い者たちは民にいばりちらした。しかし、私は神を恐れて、そのようなことはしなかった。","tok":[["私","わたくし"],["の"],["前任","ぜんにん"],["の"],["総督","そうとく"],["たち"],["は"],["民","みん"],["の"],["負担","ふたん"],["を"],["重く","おもく"],["し"],["、"],["民","みん"],["から"],["、"],["パン"],["と"],["ぶどう酒","ぶどうしゅ"],["の"],["ため"],["に"],["取り立て","とりたて"],["、"],["その"],["うえ"],["、"],["銀","ぎん"],["四十","よんじゅう"],["シェケル"],["を"],["取った","とった"],["。"],["しかも"],["、"],["彼","かれ"],["ら"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["たち"],["は"],["民","みん"],["に"],["いばりちらした"],["。"],["しかし"],["、"],["私","わたくし"],["は"],["神","かみ"],["を"],["恐れて","おそれて"],["、"],["その"],["よう"],["な"],["こと"],["は"],["しなかった"],["。"]]},{"verse":16,"text":"また、私はこの城壁の工事に専念し、私たちは農地を買わなかった。私に仕える若い者たちはみな、工事に集まっていた。","tok":[["また"],["、"],["私","わたくし"],["は"],["この"],["城壁","じょうへき"],["の"],["工事","こうじ"],["に"],["専念","せんねん"],["し"],["、"],["私たち","わたしたち"],["は"],["農地","のうち"],["を"],["買わなかった","かわなかった"],["。"],["私","わたくし"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["たち"],["は"],["みな"],["、"],["工事","こうじ"],["に"],["集まって","あつまって"],["いた"],["。"]]},{"verse":17,"text":"ユダヤ人の代表者たち百五十人と、私たちの回りの国々から来る者が、私の食卓についていた。","tok":[["ユダヤ人","ゆだやじん"],["の"],["代表者","だいひょうしゃ"],["たち"],["百五","ひゃくご"],["十人","じゅうにん"],["と"],["、"],["私たち","わたしたち"],["の"],["回り","まわり"],["の"],["国々","くにぐに"],["から"],["来る","くる"],["者","もの"],["が"],["、"],["私","わたくし"],["の"],["食卓","しょくたく"],["について"],["いた"],["。"]]},{"verse":18,"text":"それで、一日に牛一頭、えり抜きの羊六頭が料理され、私のためには鶏が料理された。それに、十日ごとに、あらゆる種類のぶどう酒をたくさん用意した。それでも私は、この民に重い労役がかかっていたので、総督としての手当を要求しなかった。","tok":[["それ"],["で"],["、"],["一","いち"],["日","にち"],["に"],["牛","うし"],["一頭","いちとう"],["、"],["えり抜き","えりぬき"],["の"],["羊","ひつじ"],["六頭","ろくとう"],["が"],["料理","りょうり"],["され"],["、"],["私","わたくし"],["の"],["ため"],["に"],["は"],["鶏","にわとり"],["が"],["料理","りょうり"],["された"],["。"],["それ"],["に"],["、"],["十日","とうか"],["ごと"],["に"],["、"],["あらゆる"],["種類","しゅるい"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["たくさん"],["用意","ようい"],["した"],["。"],["それ"],["で"],["も"],["私","わたくし"],["は"],["、"],["この"],["民","たみ"],["に"],["重い","おもい"],["労役","ろうえき"],["が"],["かかって"],["いた"],["ので"],["、"],["総督","そうとく"],["として"],["の"],["手当","てあて"],["を"],["要求","ようきゅう"],["しなかった"],["。"]]},{"verse":19,"text":"私の神。どうか私がこの民のためにしたすべてのことを覚えて、私をいつくしんでください。","tok":[["私","わたくし"],["の"],["神","かみ"],["。"],["どう"],["か"],["私","わたくし"],["が"],["この"],["民","たみ"],["の"],["ため"],["に"],["した"],["すべて"],["の"],["こと"],["を"],["覚えて","おぼえて"],["、"],["私","わたくし"],["を"],["いつくしんで"],["ください"],["。"]]}]
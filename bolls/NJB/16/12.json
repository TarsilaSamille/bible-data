[{"verse":1,"text":"シェアルティエルの子ゼルバベル、およびヨシュアといっしょに上って来た祭司とレビ人は次のとおりである。セラヤ、エレミヤ、エズラ、","tok":[["シェアルティエル"],["の"],["子","こ"],["ゼルバベル"],["、"],["および"],["ヨシュア"],["と"],["いっしょ"],["に"],["上って","のぼって"],["来た","きた"],["祭司","さいし"],["と"],["レビ人","れびにん"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["セラヤ"],["、"],["エレミヤ"],["、"],["エズラ"],["、"]]},{"verse":2,"text":"アマルヤ、マルク、ハトシュ、","tok":[["アマルヤ"],["、"],["マルク"],["、"],["ハトシュ"],["、"]]},{"verse":3,"text":"シェカヌヤ、レフム、メレモテ、","tok":[["シェカヌヤ"],["、"],["レフム"],["、"],["メレモテ"],["、"]]},{"verse":4,"text":"イド、ギネトイ、アビヤ、","tok":[["イド"],["、"],["ギネトイ"],["、"],["アビヤ"],["、"]]},{"verse":5,"text":"ミヤミン、マアデヤ、ビルガ、","tok":[["ミヤミン"],["、"],["マアデヤ"],["、"],["ビルガ"],["、"]]},{"verse":6,"text":"シェマヤ、エホヤリブ、エダヤ、","tok":[["シェマヤ"],["、"],["エホヤリブ"],["、"],["エダヤ"],["、"]]},{"verse":7,"text":"サル、アモク、ヒルキヤ、エダヤ。以上はヨシュアの時代に、祭司たちとその同族のかしらであった。","tok":[["サル"],["、"],["アモク"],["、"],["ヒルキヤ"],["、"],["エダヤ"],["。"],["以上","いじょう"],["は"],["ヨシュア"],["の"],["時代","じだい"],["に"],["、"],["祭司","さいし"],["たち"],["と"],["その"],["同族","どうぞく"],["の"],["かしら"],["で"],["あった"],["。"]]},{"verse":8,"text":"また、レビ人では、ヨシュア、ビヌイ、カデミエル、シェレベヤ、ユダ、マタヌヤで、マタヌヤはその兄弟たちといっしょに感謝の歌を受け持っていた。","tok":[["また"],["、"],["レビ人","れびにん"],["で"],["は"],["、"],["ヨシュア"],["、"],["ビヌイ"],["、"],["カデミエル"],["、"],["シェレベヤ"],["、"],["ユダ"],["、"],["マタヌヤ"],["で"],["、"],["マタヌヤ"],["は"],["その"],["兄弟","きょうだい"],["たち"],["と"],["いっしょ"],["に"],["感謝","かんしゃ"],["の"],["歌","うた"],["を"],["受け持って","うけもって"],["いた"],["。"]]},{"verse":9,"text":"また彼らの兄弟のバクブクヤとウニは、務めのときには、彼らの向かい側に立った。","tok":[["また"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["の"],["バクブクヤ"],["と"],["ウニ"],["は"],["、"],["務め","つとめ"],["の"],["とき"],["に"],["は"],["、"],["彼","かれ"],["ら"],["の"],["向かい側","むかいがわ"],["に"],["立った","たった"],["。"]]},{"verse":10,"text":"ヨシュアはエホヤキムを生み、エホヤキムはエルヤシブを生み、エルヤシブはエホヤダを生み、","tok":[["ヨシュア"],["は"],["エホヤキム"],["を"],["生み","うみ"],["、"],["エホヤキム"],["は"],["エルヤシブ"],["を"],["生み","うみ"],["、"],["エルヤシブ"],["は"],["エホヤダ"],["を"],["生み","うみ"],["、"]]},{"verse":11,"text":"エホヤダはヨナタンを生み、ヨナタンはヤドアを生んだ。","tok":[["エホヤダ"],["は"],["ヨナタン"],["を"],["生み","うみ"],
[{"verse":1,"text":"さて、私が城壁を建て直し、破れ口は残されていないということが、サヌバラテ、トビヤ、アラブ人ゲシェム、その他の私たちの敵に聞こえると、――その時まで、私はまだ、門にとびらを取りつけていなかった――","tok":[["さて"],["、"],["私","わたくし"],["が"],["城壁","じょうへき"],["を"],["建て直し","たてなおし"],["、"],["破れ","やぶれ"],["口","くち"],["は"],["残されて","のこされて"],["いない"],["と"],["いう"],["こと"],["が"],["、"],["サヌバラテ"],["、"],["トビヤ"],["、"],["アラブ人","あらぶじん"],["ゲシェム"],["、"],["その"],["他","た"],["の"],["私たち","わたしたち"],["の"],["敵","てき"],["に"],["聞こえる","きこえる"],["と"],["、"],["―"],["―"],["その"],["時","とき"],["まで"],["、"],["私","わたくし"],["は"],["まだ"],["、"],["門","もん"],["に"],["とびら"],["を"],["取りつけて","とりつけて"],["いなかった"],["―"],["―"]]},{"verse":2,"text":"サヌバラテとゲシェムは私のところに使いをよこして言った。「さあ、オノの平地にある村の一つで会見しよう。」彼らは私に害を加えようとたくらんでいたのである。","tok":[["サヌバラテ"],["と"],["ゲシェム"],["は"],["私","わたくし"],["の"],["ところ"],["に"],["使い","つかい"],["を"],["よこして"],["言った","いった"],["。"],["「"],["さあ"],["、"],["オノ"],["の"],["平地","へいち"],["に"],["ある"],["村","むら"],["の"],["一","ひと"],["つ"],["で"],["会見","かいけん"],["しよう"],["。"],["」"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["たくらんで"],["いた"],["ので"],["ある"],["。"]]},{"verse":3,"text":"そこで、私は彼らのところに使者たちをやって言った。「私は大工事をしているから、下って行けない。私が工事をそのままにして、あなたがたのところへ下って行ったため、工事が止まるようなことがあってよいものだろうか。」","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["使者","ししゃ"],["たち"],["を"],["やって"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["大","だい"],["工事","こうじ"],["を"],["して"],["いる"],["から"],["、"],["下って","くだって"],["行けない","いけない"],["。"],["私","わたくし"],["が"],["工事","こうじ"],["を"],["そのまま"],["に"],["して"],["、"],["あなた"],["がた"],["の"],["ところ"],["へ"],["下って","くだって"],["行った","いった"],["ため"],["、"],["工事","こうじ"],["が"],["止まる","とまる"],["よう"],["な"],["こと"],["が"],["あって"],["よい"],["もの"],["だろう"],["か"],["。"],["」"]]},{"verse":4,"text":"すると、彼らは同じようにして、四度も私のところに人をよこした。それで私も同じように彼らに答えた。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["同じ","おなじ"],["よう"],["に"],["して"],["、"],["四","よん"],["度","ど"],["も"],["私","わたくし"],["の"],["ところ"],["に"],["人","ひと"],["を"],["よこした"],["。"],["それ"],["で"],["私","わたくし"],["も"],["同じ","おなじ"],["よう"],["に"],["彼","かれ"],["ら"],["に"],["答えた","こたえた"],["。"]]},{"verse":5,"text":"サヌバラテは五度目にも同じようにして、若い者を私のところによこした。その手には一通の開封した手紙を持っていた。","tok":[["サヌバラテ"],["は"],["五度目","ごどめ"],["に"],["も"],["同じ","おなじ"],["よう"],["に"],["して"],["、"],["若い","わかい"],["者","もの"],["を"],["私","わたくし"],["の"],["ところ"],["に"],["よこした"],["。"],["その"],["手","て"],["に"],["は"],["一通","いちつう"],["の"],["開封","かいふう"],["した"],["手紙","てがみ"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":6,"text":"それには次のように書いてあった。「諸国民の間に言いふらされ、また、ゲシェムも言っているが、あなたとユダヤ人たちは反逆をたくらんでおり、そのために、あなたは城壁を建て直している。このうわさによれば、あなたは彼らの王になろうとしている。","tok":[["それ"],["に"],["は"],["次","つぎ"],["の"],["よう"],["に"],["書いて","かいて"],["あった"],["。"],["「"],["諸国民","しょこくみん"],["の"],["間","あいだ"],["に"],["言いふらされ","いいふらされ"],["、"],["また"],["、"],["ゲシェム"],["も"],["言って","いって"],["いる"],["が"],["、"],["あなた"],["と"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["反逆","はんぎゃく"],["を"],["たくらんで"],["おり"],["、"],["その"],["ため"],["に"],["、"],["あなた"],["は"],["城壁","じょうへき"],["を"],["建て直して","たてなおして"],["いる"],["。"],["この"],["うわさ"],["に"],["よれば"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["王","おう"],["に"],["なろう"],["として"],["いる"],["。"]]},{"verse":7,"text":"また、あなたはエルサレムで、自分について宣言させるために、預言者たちを任命して、『ユダに王がいる』と言わせている。今にこのようなことが王に聞こえるであろう。さあ、来なさい。いっしょに相談しよう。」","tok":[["また"],["、"],["あなた"],["は"],["エルサレム"],["で"],["、"],["自分","じぶん"],["について"],["宣言","せんげん"],["させる"],["ため"],["に"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["任命","にんめい"],["して"],["、"],["『"],["ユダ"],["に"],["王","おう"],["が"],["いる"],["』"],["と"],["言わせて","いわせて"],["いる"],["。"],["今","いま"],["に"],["この"],["よう"],["な"],["こと"],["が"],["王","おう"],["に"],["聞こえるで","きこえるで"],["あろう"],["。"],["さあ"],["、"],["来","き"],["なさい"],["。"],["いっしょ"],["に"],["相談","そうだん"],["しよう"],["。"],["」"]]},{"verse":8,"text":"そこで、私は彼のところに人をやって言わせた。「あなたが言っているようなことはされていない。あなたはそのことを自分でかってに考え出したのだ」と。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["彼","かれ"],["の"],["ところ"],["に"],["人","ひと"],["を"],["やって"],["言わせた","いわせた"],["。"],["「"],["あなた"],["が"],["言って","いって"],["いる"],["よう"],["な"],["こと"],["は"],["されて"],["いない"],["。"],["あなた"],["は"],["その"],["こと"],["を"],["自分","じぶん"],["で"],["かって"],["に"],["考え出した","かんがえだした"],["の"],["だ"],["」"],["と"],["。"]]},{"verse":9,"text":"事実、これらのことはみな、「あの者たちが気力を失って工事をやめ、中止するだろう」と考えて、私たちをおどすためであった。ああ、今、私を力づけてください。","tok":[["事実","じじつ"],["、"],["これ"],["ら"],["の"],["こと"],["は"],["みな"],["、"],["「"],["あの"],["者","もの"],["たち"],["が"],["気力","きりょく"],["を"],["失って","うしなって"],["工事","こうじ"],["を"],["やめ"],["、"],["中止","ちゅうし"],["するだろう"],["」"],["と"],["考えて","かんがえて"],["、"],["私たち","わたしたち"],["を"],["おどす"],["ため"],["で"],["あった"],["。"],["ああ"],["、"],["今","いま"],["、"],["私","わたくし"],["を"],["力づけて","ちからづけて"],["ください"],["。"]]},{"verse":10,"text":"私がメヘタブエルの子デラヤの子シェマヤの家に行ったところ、彼は引きこもっており、そして言った。「私たちは、神の宮、本堂の中で会い、本堂の戸を閉じておこう。彼らがあなたを殺しにやって来るからだ。きっと夜分にあなたを殺しにやって来る。」","tok":[["私","わたくし"],["が"],["メヘタブエル"],["の"],["子","こ"],["デラヤ"],["の"],["子","こ"],["シェマヤ"],["の"],["家","いえ"],["に"],["行った","いった"],["ところ"],["、"],["彼","かれ"],["は"],["引きこもって","ひきこもって"],["おり"],["、"],["そして"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["神","かみ"],["の"],["宮","みや"],["、"],["本堂","ほんどう"],["の"],["中","なか"],["で"],["会い","あい"],["、"],["本堂","ほんどう"],["の"],["戸","と"],["を"],["閉じて","とじて"],["おこう"],["。"],["彼","かれ"],["ら"],["が"],["あなた"],["を"],["殺し","ころし"],["に"],["やって"],["来る","くる"],["から"],["だ"],["。"],["きっと"],["夜分","やぶん"],["に"],["あなた"],["を"],["殺し","ころし"],["に"],["やって"],["来る","くる"],["。"],["」"]]},{"verse":11,"text":"そこで、私は言った。「私のような者が逃げてよいものか。私のような者で、だれが本堂に入って生きながらえようか。私は入って行かない。」","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["よう"],["な"],["者","もの"],["が"],["逃げて","にげて"],["よい"],["もの"],["か"],["。"],["私","わたくし"],["の"],["よう"],["な"],["者","もの"],["で"],["、"],["だれ"],["が"],["本堂","ほんどう"],["に"],["入って","はいって"],["生きながらえよう","いきながらえよう"],["か"],["。"],["私","わたくし"],["は"],["入って","はいって"],["行かない","いかない"],["。"],["」"]]},{"verse":12,"text":"私にはわかっている。今、彼を遣わしたのは、神ではない。彼がこの預言を私に伝えたのは、トビヤとサヌバラテが彼を買収したからである。","tok":[["私","わたくし"],["に"],["は"],["わかって"],["いる"],["。"],["今","いま"],["、"],["彼","かれ"],["を"],["遣わした","つかわした"],["の"],["は"],["、"],["神","かみ"],["で"],["は"],["ない"],["。"],["彼","かれ"],["が"],["この"],["預言","よげん"],["を"],["私","わたくし"],["に"],["伝えた","つたえた"],["の"],["は"],["、"],["トビヤ"],["と"],["サヌバラテ"],["が"],["彼","かれ"],["を"],["買収","ばいしゅう"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"彼が買収されたのは、私が恐れ、言われるとおりにして、私が罪を犯すようにするためであり、彼らの悪口の種とし、私をそしるためであった。","tok":[["彼","かれ"],["が"],["買収","ばいしゅう"],["された"],["の"],["は"],["、"],["私","わたくし"],["が"],["恐れ","おそれ"],["、"],["言われる","いわれる"],["とおり"],["に"],["して"],["、"],["私","わたくし"],["が"],["罪","つみ"],["を"],["犯す","おかす"],["よう"],["に"],["する"],["ため"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["の"],["悪口","わるぐち"],["の"],["種","しゅ"],["と"],["し"],["、"],["私","わたくし"],["を"],["そしる"],["ため"],["で"],["あった"],["。"]]},{"verse":14,"text":"わが神よ。トビヤやサヌバラテのあのしわざと、また、私を恐れさせようとした女預言者ノアデヤや、その他の預言者たちのしわざを忘れないでください。","tok":[["わが"],["神","かみ"],["よ"],["。"],["トビヤ"],["や"],["サヌバラテ"],["の"],["あの"],["しわざ"],["と"],["、"],["また"],["、"],["私","わたくし"],["を"],["恐れさせよう","おそれさせよう"],["と"],["した"],["女","おんな"],["預言者","よげんしゃ"],["ノアデヤ"],["や"],["、"],["その"],["他","た"],["の"],["預言者","よげんしゃ"],["たち"],["の"],["しわざ"],["を"],["忘れないで","わすれないで"],["ください"],["。"]]},{"verse":15,"text":"こうして、城壁は五十二日かかって、エルルの月の二十五日に完成した。","tok":[["こう"],["して"],["、"],["城壁","じょうへき"],["は"],["五十二","ごじゅうに"],["日","にち"],["かかって"],["、"],["エルル"],["の"],["月","つき"],["の"],["二十五","にじゅうご"],["日","にち"],["に"],["完成","かんせい"],["した"],["。"]]},{"verse":16,"text":"私たちの敵がみな、これを聞いたとき、私たちの回りの諸国民はみな恐れ、大いに面目を失った。この工事が、私たちの神によってなされたことを知ったからである。","tok":[["私たち","わたしたち"],["の"],["敵","てき"],["が"],["みな"],["、"],["これ"],["を"],["聞いた","きいた"],["とき"],["、"],["私たち","わたしたち"],["の"],["回り","まわり"],["の"],["諸国民","しょこくみん"],["は"],["みな"],["恐れ","おそれ"],["、"],["大いに","おおいに"],["面目","めんぼく"],["を"],["失った","うしなった"],["。"],["この"],["工事","こうじ"],["が"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["によって"],["なされた"],["こと"],["を"],["知った","しった"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"また、そのころ、ユダのおもだった人々は、トビヤのところにひんぱんに手紙を送っており、トビヤも彼らに返事をしていた。","tok":[["また"],["、"],["その"],["ころ"],["、"],["ユダ"],["の"],["おも"],["だった"],["人々","ひとびと"],["は"],["、"],["トビヤ"],["の"],["ところ"],["に"],["ひんぱん"],["に"],["手紙","てがみ"],["を"],["送って","おくって"],["おり"],["、"],["トビヤ"],["も"],["彼","かれ"],["ら"],["に"],["返事","へんじ"],["を"],["して"],["いた"],["。"]]},{"verse":18,"text":"それは、トビヤがアラフの子シェカヌヤの婿であり、また、トビヤの子ヨハナンもベレクヤの子メシュラムの娘を妻にめとっていたので、彼と誓いを立てていた者がユダの中に大ぜいいたからである。","tok":[["それ"],["は"],["、"],["トビヤ"],["が"],["アラフ"],["の"],["子","こ"],["シェカヌヤ"],["の"],["婿","むこ"],["で"],["あり"],["、"],["また"],["、"],["トビヤ"],["の"],["子","こ"],["ヨハナン"],["も"],["ベレクヤ"],["の"],["子","こ"],["メシュラム"],["の"],["娘","むすめ"],["を"],["妻","つま"],["に"],["めとって"],["いた"],["ので"],["、"],["彼","かれ"],["と"],["誓い","ちかい"],["を"],["立てて","たてて"],["いた"],["者","もの"],["が"],["ユダ"],["の"],["中","なか"],["に"],["大ぜい","おおぜい"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"彼らはまた、私の前でトビヤの善行を語り、私の言うことを彼に伝えていた。トビヤは私をおどそうと、たびたび手紙を送って来た。","tok":[["彼","かれ"],["ら"],["は"],["また"],["、"],["私","わたくし"],["の"],["前","まえ"],["で"],["トビヤ"],["の"],["善行","ぜんこう"],["を"],["語り","かたり"],["、"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["彼","かれ"],["に"],["伝えて","つたえて"],["いた"],["。"],["トビヤ"],["は"],["私","わたくし"],["を"],["おどそう"],["と"],["、"],["たびたび"],["手紙","てがみ"],["を"],["送って","おくって"],["来た","きた"],["。"]]}]
[{"verse":1,"text":"民はみな、いっせいに、水の門の前の広場に集まって来た。そして彼らは、主がイスラエルに命じたモーセの律法の書を持って来るように、学者エズラに願った。","tok":[["民","みん"],["は"],["みな"],["、"],["いっせい"],["に"],["、"],["水","みず"],["の"],["門","もん"],["の"],["前","まえ"],["の"],["広場","ひろば"],["に"],["集まって","あつまって"],["来た","きた"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["が"],["イスラエル"],["に"],["命じた","めいじた"],["モーセ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["持って","もって"],["来る","くる"],["よう"],["に"],["、"],["学者","がくしゃ"],["エズラ"],["に"],["願った","ねがった"],["。"]]},{"verse":2,"text":"そこで、第七の月の一日目に祭司エズラは、男も女も、すべて聞いて理解できる人たちからなる集団の前に律法を持って来て、","tok":[["そこ"],["で"],["、"],["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["一","いち"],["日目","にちめ"],["に"],["祭司","さいし"],["エズラ"],["は"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["、"],["すべて"],["聞いて","きいて"],["理解","りかい"],["できる"],["人","ひと"],["たち"],["から"],["なる"],["集団","しゅうだん"],["の"],["前","まえ"],["に"],["律法","りっぽう"],["を"],["持って","もって"],["来て","きて"],["、"]]},{"verse":3,"text":"水の門の前の広場で、夜明けから真昼まで、男や女で理解できる人たちの前で、これを朗読した。民はみな、律法の書に耳を傾けた。","tok":[["水","みず"],["の"],["門","もん"],["の"],["前","まえ"],["の"],["広場","ひろば"],["で"],["、"],["夜明け","よあけ"],["から"],["真昼","まひる"],["まで"],["、"],["男","おとこ"],["や"],["女","おんな"],["で"],["理解","りかい"],["できる"],["人","ひと"],["たち"],["の"],["前","まえ"],["で"],["、"],["これ"],["を"],["朗読","ろうどく"],["した"],["。"],["民","たみ"],["は"],["みな"],["、"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["耳","みみ"],["を"],["傾けた","かたむけた"],["。"]]},{"verse":4,"text":"学者エズラは、このために作られた木の台の上に立った。彼のそばには、右手にマティテヤ、シェマ、アナヤ、ウリヤ、ヒルキヤ、マアセヤが立ち、左手にペダヤ、ミシャエル、マルキヤ、ハシュム、ハシュバダナ、ゼカリヤ、メシュラムが立った。","tok":[["学者","がくしゃ"],["エズラ"],["は"],["、"],["この"],["ため"],["に"],["作られた","つくられた"],["木","き"],["の"],["台","だい"],["の"],["上","うえ"],["に"],["立った","たった"],["。"],["彼","かれ"],["の"],["そば"],["に"],["は"],["、"],["右手","みぎて"],["に"],["マティテヤ"],["、"],["シェマ"],["、"],["アナヤ"],["、"],["ウリヤ"],["、"],["ヒルキヤ"],["、"],["マアセヤ"],["が"],["立ち","たち"],["、"],["左手","ひだりて"],["に"],["ペダヤ"],["、"],["ミシャエル"],["、"],["マルキヤ"],["、"],["ハシュム"],["、"],["ハシュバダナ"],["、"],["ゼカリヤ"],["、"],["メシュラム"],["が"],["立った","たった"],["。"]]},{"verse":5,"text":"エズラはすべての民の面前で、その書を開いた。彼はすべての民よりも高い所にいたからである。彼がそれを開くと、民はみな立ち上がった。","tok":[["エズラ"],["は"],["すべて"],["の"],["民","たみ"],["の"],["面前","めんぜん"],["で"],["、"],["その"],["書","しょ"],["を"],["開いた","ひらいた"],["。"],["彼","かれ"],["は"],["すべて"],["の"],["民","たみ"],["より"],["も"],["高い","たかい"],["所","ところ"],["に"],["いた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["が"],["それ"],["を"],["開く","ひらく"],["と"],["、"],["民","みん"],["は"],["みな"],["立ち上がった","たちあがった"],["。"]]},{"verse":6,"text":"エズラが大いなる神、主をほめたたえると、民はみな、手を上げながら、「アーメン、アーメン」と答えてひざまずき、地にひれ伏して主を礼拝した。","tok":[["エズラ"],["が"],["大いなる","おおいなる"],["神","かみ"],["、"],["主","ぬし"],["を"],["ほめたたえる"],["と"],["、"],["民","みん"],["は"],["みな"],["、"],["手","て"],["を"],["上げ","あげ"],["ながら"],["、"],["「"],["アーメン"],["、"],["アーメン"],["」"],["と"],["答えて","こたえて"],["ひざまずき"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["主","ぬし"],["を"],["礼拝","れいはい"],["した"],["。"]]},{"verse":7,"text":"ヨシュア、バニ、シェレベヤ、ヤミン、アクブ、シャベタイ、ホディヤ、マアセヤ、ケリタ、アザルヤ、エホザバデ、ハナン、ペラヤなどレビ人たちは、民に律法を解き明かした。その間、民はそこに立っていた。","tok":[["ヨシュア"],["、"],["バニ"],["、"],["シェレベヤ"],["、"],["ヤミン"],["、"],["アクブ"],["、"],["シャベタイ"],["、"],["ホディヤ"],["、"],["マアセヤ"],["、"],["ケリタ"],["、"],["アザルヤ"],["、"],["エホザバデ"],["、"],["ハナン"],["、"],["ペラヤ"],["など"],["レビ人","れびにん"],["たち"],["は"],["、"],["民","みん"],["に"],["律法","りっぽう"],["を"],["解き明かした","ときあかした"],["。"],["その"],["間","かん"],["、"],["民","みん"],["は"],["そこ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":8,"text":"彼らが神の律法の書をはっきりと読んで説明したので、民は読まれたことを理解した。","tok":[["彼","かれ"],["ら"],["が"],["神","かみ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["はっきり"],["と"],["読んで","よんで"],["説明","せつめい"],["した"],["ので"],["、"],["民","みん"],["は"],["読まれた","よまれた"],["こと"],["を"],["理解","りかい"],["した"],["。"]]},{"verse":9,"text":"総督であるネヘミヤと、祭司であり学者であるエズラと、民に解き明かすレビ人たちは、民全部に向かって言った。「きょうは、あなたがたの神、主のために聖別された日である。悲しんではならない。泣いてはならない。」民が律法のことばを聞いたときに、みな泣いていたからである。","tok":[["総督","そうとく"],["で"],["ある"],["ネヘミヤ"],["と"],["、"],["祭司","さいし"],["で"],["あり"],["学","がく"],["者","しゃ"],["で"],["ある"],["エズラ"],["と"],["、"],["民","みん"],["に"],["解き明かす","ときあかす"],["レビ人","れびにん"],["たち"],["は"],["、"],["民","みん"],["全部","ぜんぶ"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["きょう"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["聖別","せいべつ"],["された"],["日","ひ"],["で"],["ある"],["。"],["悲しんで","かなしんで"],["は"],["ならない"],["。"],["泣いて","ないて"],["は"],["ならない"],["。"],["」"],["民","みん"],["が"],["律法","りっぽう"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["に"],["、"],["みな"],["泣いて","ないて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"さらに、ネヘミヤは彼らに言った。「行って、上等な肉を食べ、甘いぶどう酒を飲みなさい。何も用意できなかった者にはごちそうを贈ってやりなさい。きょうは、私たちの主のために聖別された日である。悲しんではならない。あなたがたの力を主が喜ばれるからだ。」","tok":[["さらに"],["、"],["ネヘミヤ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["行って","いって"],["、"],["上等","じょうとう"],["な"],["肉","にく"],["を"],["食べ","たべ"],["、"],["甘い","あまい"],["ぶどう酒","ぶどうしゅ"],["を"],["飲み","のみ"],["なさい"],["。"],["何","なん"],["も"],["用意","ようい"],["できなかった"],["者","もの"],["に"],["は"],["ごちそう"],["を"],["贈って","おくって"],["やり"],["なさい"],["。"],["きょう"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["の"],["ため"],["に"],["聖別","せいべつ"],["された"],["日","ひ"],["で"],["ある"],["。"],["悲しんで","かなしんで"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["力","ちから"],["を"],["主","ぬし"],["が"],["喜ばれる","よろこばれる"],["から"],["だ"],["。"],["」"]]},{"verse":11,"text":"レビ人たちも、民全部を静めながら言った。「静まりなさい。きょうは神聖な日だから。悲しんではならない。」","tok":[["レビ人","れびにん"],["たち"],["も"],["、"],["民","みん"],["全部","ぜんぶ"],["を"],["静め","しずめ"],["ながら"],["言った","いった"],["。"],["「"],["静まり","しずまり"],["なさい"],["。"],["きょう"],["は"],["神聖","しんせい"],["な"],["日","ひ"],["だ"],["から"],["。"],["悲しんで","かなしんで"],["は"],["ならない"],["。"],["」"]]},{"verse":12,"text":"こうして、民はみな、行き、食べたり飲んだり、ごちそうを贈ったりして、大いに喜んだ。これは、彼らが教えられたことを理解したからである。","tok":[["こう"],["して"],["、"],["民","みん"],["は"],["みな"],["、"],["行き","いき"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["、"],["ごちそう"],["を"],["贈っ","おくっ"],["たり"],["して"],["、"],["大いに","おおいに"],["喜んだ","よろこんだ"],["。"],["これ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["教えられた","おしえられた"],["こと"],["を"],["理解","りかい"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"二日目に、すべての民の一族のかしらたちと、祭司たち、レビ人たちは、律法のことばをよく調べるために、学者エズラのところに集まって来た。","tok":[["二日目","ふたかめ"],["に"],["、"],["すべて"],["の"],["民","たみ"],["の"],["一族","いちぞく"],["の"],["かしら"],["たち"],["と"],["、"],["祭司","さいし"],["たち"],["、"],["レビ人","れびにん"],["たち"],["は"],["、"],["律法","りっぽう"],["の"],["ことば"],["を"],["よく"],["調べる","しらべる"],["ため"],["に"],["、"],["学者","がくしゃ"],["エズラ"],["の"],["ところ"],["に"],["集まって","あつまって"],["来た","きた"],["。"]]},{"verse":14,"text":"こうして彼らは、主がモーセを通して命じた律法に、イスラエル人は第七の月の祭りの間、仮庵の中に住まなければならない、と書かれているのを見つけ出した。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["が"],["モーセ"],["を"],["通して","とおして"],["命じた","めいじた"],["律法","りっぽう"],["に"],["、"],["イスラエル"],["人","にん"],["は"],["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["祭り","まつり"],["の"],["間","あいだ"],["、"],["仮庵","かりあん"],["の"],["中","なか"],["に"],["住まなければ","すまなければ"],["ならない"],["、"],["と"],["書かれて","かかれて"],["いる"],["の"],["を"],["見つけ","みつけ"],["出した","だした"],["。"]]},{"verse":15,"text":"これを聞くと、彼らは、自分たちのすべての町々とエルサレムに、次のようなおふれを出した。「山へ出て行き、オリーブ、野生のオリーブの木、ミルトス、なつめやし、また、枝の茂った木などの枝を取って来て、書かれているとおりに仮庵を作りなさい。」","tok":[["これ"],["を"],["聞く","きく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["すべて"],["の"],["町々","まちまち"],["と"],["エルサレム"],["に"],["、"],["次","つぎ"],["の"],["よう"],["な"],["おふれ"],["を"],["出した","だした"],["。"],["「"],["山","やま"],["へ"],["出て","でて"],["行き","いき"],["、"],["オリーブ"],["、"],["野生","やせい"],["の"],["オリーブ"],["の"],["木","き"],["、"],["ミルトス"],["、"],["なつめやし"],["、"],["また"],["、"],["枝","えだ"],["の"],["茂った","しげった"],["木","き"],["など"],["の"],["枝","えだ"],["を"],["取って","とって"],["来て","きて"],["、"],["書かれて","かかれて"],["いる"],["とおり"],["に"],["仮庵","かりあん"],["を"],["作り","つくり"],["なさい"],["。"],["」"]]},{"verse":16,"text":"そこで、民は出て行って、それを持って帰り、それぞれ自分の家の屋根の上や、庭の中、または、神の宮の庭や、水の門の広場、エフライムの門の広場などに、自分たちのために仮庵を作った。","tok":[["そこ"],["で"],["、"],["民","みん"],["は"],["出て","でて"],["行って","いって"],["、"],["それ"],["を"],["持って","もって"],["帰り","かえり"],["、"],["それぞれ"],["自分","じぶん"],["の"],["家","いえ"],["の"],["屋根","やね"],["の"],["上","うえ"],["や"],["、"],["庭","にわ"],["の"],["中","なか"],["、"],["また"],["は"],["、"],["神","かみ"],["の"],["宮","みや"],["の"],["庭","にわ"],["や"],["、"],["水","みず"],["の"],["門","もん"],["の"],["広場","ひろば"],["、"],["エフライム"],["の"],["門","もん"],["の"],["広場","ひろば"],["など"],["に"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["仮庵","かりあん"],["を"],["作った","つくった"],["。"]]},{"verse":17,"text":"捕囚から帰って来た全集団は、仮庵を作り、その仮庵に住んだ。ヌンの子ヨシュアの時代から今日まで、イスラエル人はこのようにしていなかったので、それは非常に大きな喜びであった。","tok":[["捕囚","ほしゅう"],["から"],["帰って","かえって"],["来た","きた"],["全","ぜん"],["集団","しゅうだん"],["は"],["、"],["仮庵","かりあん"],["を"],["作り","つくり"],["、"],["その"],["仮庵","かりあん"],["に"],["住んだ","すんだ"],["。"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["の"],["時代","じだい"],["から"],["今日","きょう"],["まで"],["、"],["イスラエル"],["人","にん"],["は"],["この"],["よう"],["に"],["して"],["いなかった"],["ので"],["、"],["それ"],["は"],["非常","ひじょう"],["に"],["大きな","おおきな"],["喜び","よろこび"],["で"],["あった"],["。"]]},{"verse":18,"text":"神の律法の書は、最初の日から最後の日まで、毎日朗読された。祭りは七日間、祝われ、八日目には定めに従って、きよめの集会が行われた。","tok":[["神","かみ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["は"],["、"],["最初","さいしょ"],["の"],["日","ひ"],["から"],["最後","さいご"],["の"],["日","ひ"],["まで"],["、"],["毎日","まいにち"],["朗読","ろうどく"],["された"],["。"],["祭り","まつり"],["は"],["七","なな"],["日間","かかん"],["、"],["祝われ","いわわれ"],["、"],["八日目","ようかめ"],["に"],["は"],["定め","さだめ"],["に"],["従って","したがって"],["、"],["きよめ"],["の"],["集会","しゅうかい"],["が"],["行われた","おこなわれた"],["。"]]}]
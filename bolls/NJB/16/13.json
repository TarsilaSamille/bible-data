[{"verse":1,"text":"その日、民に聞こえるように、モーセの書が朗読されたが、その中に、アモン人とモアブ人は決して神の集会に加わってはならない、と書かれているのが見つかった。","tok":[["その"],["日","ひ"],["、"],["民","みん"],["に"],["聞こえる","きこえる"],["よう"],["に"],["、"],["モーセ"],["の"],["書","しょ"],["が"],["朗読","ろうどく"],["された"],["が"],["、"],["その"],["中","なか"],["に"],["、"],["アモン人","あもんにん"],["と"],["モアブ人","もあぶにん"],["は"],["決して","けっして"],["神","かみ"],["の"],["集会","しゅうかい"],["に"],["加わって","くわわって"],["は"],["ならない"],["、"],["と"],["書かれて","かかれて"],["いる"],["の"],["が"],["見つかった","みつかった"],["。"]]},{"verse":2,"text":"それは、彼らがパンと水をもってイスラエル人を迎えず、かえって彼らをのろうためにバラムを雇ったからである。しかし、私たちの神はそののろいを祝福に変えられた。","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["パン"],["と"],["水","みず"],["を"],["もって"],["イスラエル"],["人","にん"],["を"],["迎えず","むかえず"],["、"],["かえって"],["彼","かれ"],["ら"],["を"],["のろう"],["ため"],["に"],["バラム"],["を"],["雇った","やとった"],["から"],["で"],["ある"],["。"],["しかし"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["は"],["その"],["のろい"],["を"],["祝福","しゅくふく"],["に"],["変えられた","かえられた"],["。"]]},{"verse":3,"text":"彼らはこの律法を聞くと、混血の者をみな、イスラエルから取り分けた。","tok":[["彼","かれ"],["ら"],["は"],["この"],["律法","りっぽう"],["を"],["聞く","きく"],["と"],["、"],["混血","こんけつ"],["の"],["者","もの"],["を"],["みな"],["、"],["イスラエル"],["から"],["取り分けた","とりわけた"],["。"]]},{"verse":4,"text":"これより以前、私たちの神の宮の部屋を任されていた祭司エルヤシブは、トビヤと親しい関係にあったので、","tok":[["これ"],["より"],["以前","いぜん"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["部屋","へや"],["を"],["任されて","まかされて"],["いた"],["祭司","さいし"],["エルヤシブ"],["は"],["、"],["トビヤ"],["と"],["親しい","したしい"],["関係","かんけい"],["に"],["あった"],["ので"],["、"]]},{"verse":5,"text":"トビヤのために大きな部屋を一つあてがった。その部屋にはかつて、穀物のささげ物、乳香、器物、および、レビ人や歌うたいや門衛たちのために定められていた穀物と新しいぶどう酒と油の十分の一、および祭司のための奉納物が保管されていた。","tok":[["トビヤ"],["の"],["ため"],["に"],["大きな","おおきな"],["部屋","へや"],["を"],["一","ひと"],["つ"],["あてがった"],["。"],["その"],["部屋","へや"],["に"],["は"],["かつて"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["、"],["乳香","にゅうこう"],["、"],["器物","きぶつ"],["、"],["および"],["、"],["レビ人","れびにん"],["や"],["歌うたい","うたうたい"],["や"],["門衛","もんえい"],["たち"],["の"],["ため"],["に"],["定められて","さだめられて"],["いた"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["油","あぶら"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["、"],["および"],["祭司","さいし"],["の"],["ため"],["の"],["奉納物","ほうのうぶつ"],["が"],["保管","ほかん"],["されて"],["いた"],["。"]]},{"verse":6,"text":"その間、私はエルサレムにいなかった。私は、バビロンの王アルタシャスタの三十二年に、王のところに行き、その後しばらくたって、王にいとまを請い、","tok":[["その"],["間","かん"],["、"],["私","わたくし"],["は"],["エルサレム"],["に"],["いなかった"],["。"],["私","わたくし"],["は"],["、"],["バビロン"],["の"],["王","おう"],["アルタシャスタ"],["の"],["三十二","さんじゅうに"],["年","ねん"],["に"],["、"],["王","おう"],["の"],["ところ"],["に"],["行き","いき"],["、"],["その後","そのあと"],["しばらく"],["たって"],["、"],["王","おう"],["に"],["いとま"],["を"],["請い","こい"],["、"]]},{"verse":7,"text":"エルサレムに帰って来たからである。そのとき、エルヤシブがトビヤのために行った悪、すなわち、神の宮の庭にある一つの部屋を彼にあてがったことに気づいた。","tok":[["エルサレム"],["に"],["帰って","かえって"],["来た","きた"],["から"],["で"],["ある"],["。"],["その"],["とき"],["、"],["エルヤシブ"],["が"],["トビヤ"],["の"],["ため"],["に"],["行った","いった"],["悪","わる"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["宮","みや"],["の"],["庭","にわ"],["に"],["ある"],["一","ひと"],["つ"],["の"],["部屋","へや"],["を"],["彼","かれ"],["に"],["あてがった"],["こと"],["に"],["気づいた","きづいた"],["。"]]},{"verse":8,"text":"私は大いにきげんを悪くし、トビヤ家の器具類を全部、その部屋から外へ投げ出し、","tok":[["私","わたくし"],["は"],["大いに","おおいに"],["きげん"],["を"],["悪く","わるく"],["し"],["、"],["トビヤ家","とびやか"],["の"],["器具類","きぐるい"],["を"],["全部","ぜんぶ"],["、"],["その"],["部屋","へや"],["から"],["外","そと"],["へ"],["投げ出し","なげだし"],["、"]]},{"verse":9,"text":"命じて、その部屋をきよめさせた。そして、私は、神の宮の器物を、穀物のささげ物や乳香といっしょに、再びそこに納めた。","tok":[["命じて","めいじて"],["、"],["その"],["部屋","へや"],["を"],["きよめさせた"],["。"],["そして"],["、"],["私","わたくし"],["は"],["、"],["神","かみ"],["の"],["宮","みや"],["の"],["器物","きぶつ"],["を"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["や"],["乳香","にゅうこう"],["と"],["いっしょ"],["に"],["、"],["再び","ふたたび"],["そこ"],["に"],["納めた","おさめた"],["。"]]},{"verse":10,"text":"私は、レビ人の分が支給されないので、仕事をするレビ人と歌うたいたちが、それぞれ自分の農地に逃げ去ったことを知った。","tok":[["私","わたくし"],["は"],["、"],["レビ人","れびにん"],["の"],["分","ぶん"],["が"],["支給","しきゅう"],["されない"],["ので"],["、"],["仕事","しごと"],["を"],["する"],["レビ人","れびにん"],["と"],["歌うたい","うたうたい"],["たち"],["が"],["、"],["それぞれ"],["自分","じぶん"],["の"],["農地","のうち"],["に"],["逃げ去った","にげさった"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":11,"text":"私は代表者たちを詰問し、「どうして神の宮が見捨てられているのか」と言った。そして私はレビ人たちを集め、もとの持ち場に戻らせた。","tok":[["私","わたくし"],["は"],["代表者","だいひょうしゃ"],["たち"],["を"],["詰問","きつもん"],["し"],["、"],["「"],["どう"],["して"],["神","かみ"],["の"],["宮","みや"],["が"],["見捨てられて","みすてられて"],["いる"],["の"],["か"],["」"],["と"],["言った","いった"],["。"],["そして"],["私","わたくし"],["は"],["レビ人","れびにん"],["たち"],["を"],["集め","あつめ"],["、"],["もと"],["の"],["持ち場","もちば"],["に"],["戻らせた","もどらせた"],["。"]]},{"verse":12,"text":"ユダの人々はみな、穀物と新しいぶどう酒と油の十分の一を宝物倉に持って来た。","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["みな"],["、"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["油","あぶら"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["宝物倉","ほうもつそう"],["に"],["持って","もって"],["来た","きた"],["。"]]},{"verse":13,"text":"そこで私は、祭司シェレムヤと、学者ツァドクと、レビ人のひとりペダヤに宝物倉を管理させ、マタヌヤの子ザクルの子ハナンを彼らの助手とした。彼らは忠実な者と認められていたからであった。彼らの任務は、兄弟たちに分け前を分配することであった。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["祭司","さいし"],["シェレムヤ"],["と"],["、"],["学者","がくしゃ"],["ツァドク"],["と"],["、"],["レビ人","れびにん"],["の"],["ひとり"],["ペダヤ"],["に"],["宝物倉","ほうもつそう"],["を"],["管理","かんり"],["させ"],["、"],["マタヌヤ"],["の"],["子","こ"],["ザクル"],["の"],["子","こ"],["ハナン"],["を"],["彼","かれ"],["ら"],["の"],["助手","じょしゅ"],["と"],["した"],["。"],["彼","かれ"],["ら"],["は"],["忠実","ちゅうじつ"],["な"],["者","もの"],["と"],["認められて","みとめられて"],["いた"],["から"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["の"],["任務","にんむ"],["は"],["、"],["兄弟","きょうだい"],["たち"],["に"],["分け前","わけまえ"],["を"],["分配","ぶんぱい"],["する"],["こと"],["で"],["あった"],["。"]]},{"verse":14,"text":"私の神。どうか、このことのために私を覚えていてください。私の神の宮と、その務めのためにしたいろいろな私の愛のわざを、ぬぐい去らないでください。","tok":[["私","わたくし"],["の"],["神","かみ"],["。"],["どう"],["か"],["、"],["この"],["こと"],["の"],["ため"],["に"],["私","わたくし"],["を"],["覚えて","おぼえて"],["いて"],["ください"],["。"],["私","わたくし"],["の"],["神","かみ"],["の"],["宮","みや"],["と"],["、"],["その"],["務め","つとめ"],["の"],["ため"],["に"],["した"],["いろいろ"],["な"],["私","わたくし"],["の"],["愛","あい"],["の"],["わざ"],["を"],["、"],["ぬぐい去らないで","ぬぐいさらないで"],["ください"],["。"]]},{"verse":15,"text":"そのころ私は、ユダのうちで安息日に酒ぶねを踏んでいる者や、麦束を運んでいる者、また、ろばに荷物を負わせている者、さらに、ぶどう酒、ぶどうの実、いちじくなど、あらゆる品物を積んで、安息日にエルサレムに運び込んでいる者を見つけた。それで私は、彼らが食物を売ったその日、彼らをとがめた。","tok":[["その"],["ころ"],["私","わたくし"],["は"],["、"],["ユダ"],["の"],["うち"],["で"],["安息日","あんそくび"],["に"],["酒","さけ"],["ぶね"],["を"],["踏んで","ふんで"],["いる"],["者","もの"],["や"],["、"],["麦","むぎ"],["束","たば"],["を"],["運んで","はこんで"],["いる"],["者","もの"],["、"],["また"],["、"],["ろば"],["に"],["荷物","にもつ"],["を"],["負わせて","おわせて"],["いる"],["者","もの"],["、"],["さらに"],["、"],["ぶどう酒","ぶどうしゅ"],["、"],["ぶどう"],["の"],["実","じつ"],["、"],["いちじく"],["など"],["、"],["あらゆる"],["品物","しなもの"],["を"],["積んで","つんで"],["、"],["安息日","あんそくび"],["に"],["エルサレム"],["に"],["運び込んで","はこびこんで"],["いる"],["者","もの"],["を"],["見つけた","みつけた"],["。"],["それ"],["で"],["私","わたくし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["食物","しょくもつ"],["を"],["売った","うった"],["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["を"],["とがめた"],["。"]]},{"verse":16,"text":"また、そこに住んでいたツロの人々も、魚や、いろいろな商品を運んで来て、安息日に、しかもエルサレムで、ユダの人々に売っていた。","tok":[["また"],["、"],["そこ"],["に"],["住んで","すんで"],["いた"],["ツロ"],["の"],["人々","ひとびと"],["も"],["、"],["魚","さかな"],["や"],["、"],["いろいろ"],["な"],["商品","しょうひん"],["を"],["運んで","はこんで"],["来て","きて"],["、"],["安息日","あんそくび"],["に"],["、"],["しかも"],["エルサレム"],["で"],["、"],["ユダ"],["の"],["人々","ひとびと"],["に"],["売って","うって"],["いた"],["。"]]},{"verse":17,"text":"そこで私は、ユダのおもだった人たちを詰問して言った。「あなたがたはなぜ、このような悪事を働いて安息日を汚しているのか。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["ユダ"],["の"],["おも"],["だった"],["人","ひと"],["たち"],["を"],["詰問","きつもん"],["して"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["なぜ"],["、"],["この"],["よう"],["な"],["悪事","あくじ"],["を"],["働いて","はたらいて"],["安息日","あんそくび"],["を"],["汚して","よごして"],["いる"],["の"],["か"],["。"]]},{"verse":18,"text":"あなたがたの先祖も、このようなことをしたので、私たちの神はこのすべてのわざわいを、私たちとこの町の上に送られたではないか。それなのに、あなたがたは安息日を汚して、イスラエルに下る怒りを加えている。」","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["も"],["、"],["この"],["よう"],["な"],["こと"],["を"],["した"],["ので"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["は"],["この"],["すべて"],["の"],["わざわい"],["を"],["、"],["私たち","わたしたち"],["と"],["この"],["町","まち"],["の"],["上","うえ"],["に"],["送られたで","おくられたで"],["は"],["ない"],["か"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["安息日","あんそくび"],["を"],["汚して","よごして"],["、"],["イスラエル"],["に"],["下る","くだる"],["怒り","いかり"],["を"],["加えて","くわえて"],["いる"],["。"],["」"]]},{"verse":19,"text":"安息日の前、エルサレムの門に夕やみが迫ると、私は命じて、とびらをしめさせ、安息日が済むまでは開いてはならないと命じた。そして、私の若い者の幾人かを門の見張りに立て、安息日に荷物が持ち込まれないようにした。","tok":[["安息日","あんそくび"],["の"],["前","まえ"],["、"],["エルサレム"],["の"],["門","もん"],["に"],["夕やみ","ゆうやみ"],["が"],["迫る","せまる"],["と"],["、"],["私","わたくし"],["は"],["命じて","めいじて"],["、"],["とびら"],["を"],["しめさせ"],["、"],["安息日","あんそくび"],["が"],["済む","すむ"],["まで"],["は"],["開いて","ひらいて"],["は"],["ならない"],["と"],["命じた","めいじた"],["。"],["そして"],["、"],["私","わたくし"],["の"],["若い","わかい"],["者","もの"],["の"],["幾人","いくにん"],["か"],["を"],["門","もん"],["の"],["見張り","みはり"],["に"],["立て","たて"],["、"],["安息日","あんそくび"],["に"],["荷物","にもつ"],["が"],["持ち込まれない","もちこまれない"],["よう"],["に"],["した"],["。"]]},{"verse":20,"text":"それで、商人や、あらゆる品物を売る者たちは、一度か二度エルサレムの外で夜を過ごした。","tok":[["それ"],["で"],["、"],["商人","しょうにん"],["や"],["、"],["あらゆる"],["品物","しなもの"],["を"],["売る","うる"],["者","もの"],["たち"],["は"],["、"],["一度","いちど"],["か"],["二","に"],["度","ど"],["エルサレム"],["の"],["外","そと"],["で"],["夜","よる"],["を"],["過ごした","すごした"],["。"]]},{"verse":21,"text":"そこで、私は彼らをとがめて言った。「なぜあなたがたは、城壁の前で夜を過ごすのか。再びそうするなら、私はあなたがたに手を下す。」その時から、彼らはもう、安息日には来なくなった。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["を"],["とがめて"],["言った","いった"],["。"],["「"],["なぜ"],["あなた"],["がた"],["は"],["、"],["城壁","じょうへき"],["の"],["前","まえ"],["で"],["夜","よる"],["を"],["過ごす","すごす"],["の"],["か"],["。"],["再び","ふたたび"],["そう"],["するなら"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["手","て"],["を"],["下す","くだす"],["。"],["」"],["その"],["時","とき"],["から"],["、"],["彼","かれ"],["ら"],["は"],["もう"],["、"],["安息日","あんそくび"],["に"],["は"],["来なく","こなく"],["なった"],["。"]]},{"verse":22,"text":"私はレビ人に命じて、身をきよめさせ、安息日をきよく保つために、門の守りにつかせた。私の神。どうか、このことにおいてもまた、私を覚えていてください。そして、あなたの大いなるいつくしみによって私をあわれんでください。","tok":[["私","わたくし"],["は"],["レビ人","れびにん"],["に"],["命じて","めいじて"],["、"],["身","み"],["を"],["きよめさせ"],["、"],["安息日","あんそくび"],["を"],["きよく"],["保つ","たもつ"],["ため"]
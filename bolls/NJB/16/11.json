[{"verse":1,"text":"民のつかさたちはエルサレムに住んでいたが、ほかの民は、くじを引いて、十人のうちからひとりずつ、聖なる都エルサレムに来て住むようにし、あとの九人をほかの町々に住まわせた。","tok":[["民","みん"],["の"],["つかさ"],["たち"],["は"],["エルサレム"],["に"],["住んで","すんで"],["いた"],["が"],["、"],["ほか"],["の"],["民","たみ"],["は"],["、"],["くじ"],["を"],["引いて","ひいて"],["、"],["十人","じゅうにん"],["の"],["うち"],["から"],["ひとり"],["ずつ"],["、"],["聖","せい"],["なる"],["都","と"],["エルサレム"],["に"],["来て","きて"],["住む","すむ"],["よう"],["に"],["し"],["、"],["あと"],["の"],["九人","きゅうにん"],["を"],["ほか"],["の"],["町々","まちまち"],["に"],["住まわせた","すまわせた"],["。"]]},{"verse":2,"text":"すると民は、自分から進んでエルサレムに住もうとする人々をみな、祝福した。","tok":[["する"],["と"],["民","たみ"],["は"],["、"],["自分","じぶん"],["から"],["進んで","すすんで"],["エルサレム"],["に"],["住もう","すもう"],["と"],["する"],["人々","ひとびと"],["を"],["みな"],["、"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":3,"text":"エルサレムに住んだこの州のかしらたちは次のとおりである。ユダの町々には、イスラエル人、祭司、レビ人、宮に仕えるしもべたち、ソロモンのしもべたちの子孫が、それぞれ、自分たちの町々の自分の所有地に住んだ。","tok":[["エルサレム"],["に"],["住んだ","すんだ"],["この"],["州","しゅう"],["の"],["かしら"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ユダ"],["の"],["町々","まちまち"],["に"],["は"],["、"],["イスラエル"],["人","にん"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["、"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["たち"],["、"],["ソロモン"],["の"],["しもべ"],["たち"],["の"],["子孫","しそん"],["が"],["、"],["それぞれ"],["、"],["自分","じぶん"],["たち"],["の"],["町々","まちまち"],["の"],["自分","じぶん"],["の"],["所有地","しょゆうち"],["に"],["住んだ","すんだ"],["。"]]},{"verse":4,"text":"ユダ族とベニヤミン族のうちのある者は、エルサレムに住んだ。すなわち、ユダ族では、ウジヤの子アタヤであった。このウジヤはゼカリヤの子、順次さかのぼって、アマルヤの子、シェファテヤの子、マハラルエルの子。マハラルエルはペレツの子孫のひとりである。","tok":[["ユダ族","ゆだぞく"],["と"],["ベニヤミン"],["族","ぞく"],["の"],["うち"],["の"],["ある"],["者","もの"],["は"],["、"],["エルサレム"],["に"],["住んだ","すんだ"],["。"],["すなわち"],["、"],["ユダ族","ゆだぞく"],["で"],["は"],["、"],["ウジヤ"],["の"],["子","こ"],["アタヤ"],["で"],["あった"],["。"],["この"],["ウジヤ"],["は"],["ゼカリヤ"],["の"],["子","こ"],["、"],["順次","じゅんじ"],["さかのぼって"],["、"],["アマルヤ"],["の"],["子","こ"],["、"],["シェファテヤ"],["の"],["子","こ"],["、"],["マハラ"],["ルエル"],["の"],["子","こ"],["。"],["マハラ"],["ルエル"],["は"],["ペレツ"],["の"],["子孫","しそん"],["の"],["ひとり"],["で"],["ある"],["。"]]},{"verse":5,"text":"次にバルクの子マアセヤであった。このバルクはコル・ホゼの子、順次さかのぼって、ハザヤの子、アダヤの子、エホヤリブの子、ゼカリヤの子。ゼカリヤはシェラ人の子孫である。","tok":[["次","つぎ"],["に"],["バルク"],["の"],["子","こ"],["マアセヤ"],["で"],["あった"],["。"],["この"],["バルク"],["は"],["コル"],["・"],["ホゼ"],["の"],["子","こ"],["、"],["順次","じゅんじ"],["さかのぼって"],["、"],["ハザヤ"],["の"],["子","こ"],["、"],["アダヤ"],["の"],["子","こ"],["、"],["エホヤリブ"],["の"],["子","こ"],["、"],["ゼカリヤ"],["の"],["子","こ"],["。"],["ゼカリヤ"],["は"],["シェラ人","しぇらにん"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":6,"text":"エルサレムに住んだペレツの子孫は合計四百六十八名の勇士であった。","tok":[["エルサレム"],["に"],["住んだ","すんだ"],["ペレツ"],["の"],["子孫","しそん"],["は"],["合計","ごうけい"],["四百六十八","よんひゃくろくじゅうはち"],["名","めい"],["の"],["勇士","ゆうし"],["で"],["あった"],["。"]]},{"verse":7,"text":"ベニヤミン族では次のとおりである。メシュラムの子サル。このメシュラムはヨエデの子、順次さかのぼって、ペダヤの子、コラヤの子、マアセヤの子、イティエルの子、エシャヤの子である。","tok":[["ベニヤミン"],["族","ぞく"],["で"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["メシュラム"],["の"],["子","こ"],["サル"],["。"],["この"],["メシュラム"],["は"],["ヨエデ"],["の"],["子","こ"],["、"],["順次","じゅんじ"],["さかのぼって"],["、"],["ペダヤ"],["の"],["子","こ"],["、"],["コラヤ"],["の"],["子","こ"],["、"],["マアセヤ"],["の"],["子","こ"],["、"],["イティエル"],["の"],["子","こ"],["、"],["エシャヤ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":8,"text":"彼の次には、ガバイとサライで、九百二十八名。","tok":[["彼","かれ"],["の"],["次","つぎ"],["に"],["は"],["、"],["ガバイ"],["と"],["サライ"],["で"],["、"],["九百二十八","きゅうひゃくにじゅうはち"],["名","めい"],["。"]]},{"verse":9,"text":"ジクリの子ヨエルが彼らの監督者であり、セヌアの子ユダが、彼の副監督者としてこの町を治めた。","tok":[["ジクリ"],["の"],["子","こ"],["ヨエル"],["が"],["彼","かれ"],["ら"],["の"],["監督者","かんとくしゃ"],["で"],["あり"],["、"],["セヌア"],["の"],["子","こ"],["ユダ"],["が"],["、"],["彼","かれ"],["の"],["副","ふく"],["監督者","かんとくしゃ"],["として"],["この"],["町","まち"],["を"],["治めた","おさめた"],["。"]]},{"verse":10,"text":"祭司のうちでは、エホヤリブの子エダヤと、ヤキン、","tok":[["祭司","さいし"],["の"],["うち"],["で"],["は"],["、"],["エホヤリブ"],["の"],["子","こ"],["エダヤ"],["と"],["、"],["ヤキン"],["、"]]},{"verse":11,"text":"神の宮のつかさセラヤであった。このセラヤはヒルキヤの子、順次さかのぼって、メシュラムの子、ツァドクの子、メラヨテの子、アヒトブの子である。","tok":[["神","かみ"],["の"],["宮","みや"],["の"],["つかさ"],["セラヤ"],["で"],["あった"],["。"],["この"],["セラヤ"],["は"],["ヒ
[{"verse":1,"text":"終わりに、兄弟たちよ。私たちのために祈ってください。主のみことばが、あなたがたのところでと同じように早く広まり、またあがめられますように。","tok":[["終わり","おわり"],["に"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["私たち","わたしたち"],["の"],["ため"],["に"],["祈って","いのって"],["ください"],["。"],["主","ぬし"],["のみ"],["ことば"],["が"],["、"],["あなた"],["がた"],["の"],["ところ"],["で"],["と"],["同じ","おなじ"],["よう"],["に"],["早く","はやく"],["広まり","ひろまり"],["、"],["また"],["あがめられます"],["よう"],["に"],["。"]]},{"verse":2,"text":"また、私たちが、ひねくれた悪人どもの手から救い出されますように。すべての人が信仰を持っているのではないからです。","tok":[["また"],["、"],["私たち","わたしたち"],["が"],["、"],["ひねくれた"],["悪人","あくにん"],["ども"],["の"],["手","て"],["から"],["救い出されます","すくいだされます"],["よう"],["に"],["。"],["すべて"],["の"],["人","ひと"],["が"],["信仰","しんこう"],["を"],["持って","もって"],["いる"],["ので"],["は"],["ない"],["から"],["です"],["。"]]},{"verse":3,"text":"しかし、主は真実な方ですから、あなたがたを強くし、悪い者から守ってくださいます。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["真実","しんじつ"],["な"],["方","ほう"],["です"],["から"],["、"],["あなた"],["がた"],["を"],["強く","つよく"],["し"],["、"],["悪い","わるい"],["者","もの"],["から"],["守って","まもって"],["くださいます"],["。"]]},{"verse":4,"text":"私たちが命じることを、あなたがたが現に実行しており、これからも実行してくれることを私たちは主にあって確信しています。","tok":[["私たち","わたしたち"],["が"],["命じる","めいじる"],["こと"],["を"],["、"],["あなた"],["がた"],["が"],["現に","げんに"],["実行","じっこう"],["して"],["おり"],["、"],["これ"],["から"],["も"],["実行","じっこう"],["して"],["くれる"],["こと"],["を"],["私たち","わたしたち"],["は"],["主に","おもに"],["あって"],["確信","かくしん"],["して"],["います"],["。"]]},{"verse":5,"text":"どうか、主があなたがたの心を導いて、神の愛とキリストの忍耐とを持たせてくださいますように。","tok":[["どう"],["か"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["導いて","みちびいて"],["、"],["神","かみ"],["の"],["愛","あい"],["と"],["キリスト"],["の"],["忍耐","にんたい"],["と"],["を"],["持たせて","もたせて"],["くださいます"],["よう"],["に"],["。"]]},{"verse":6,"text":"兄弟たちよ。主イエス・キリストの御名によって命じます。締まりのない歩み方をして私たちから受けた言い伝えに従わないでいる、すべての兄弟たちから離れていなさい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["御名","ぎょめい"],["によって"],["命じます","めいじます"],["。"],["締まり","しまり"],["の"],["ない"],["歩み","あゆみ"],["方","かた"],["を"],["して"],["私たち","わたしたち"],["から"],["受けた","うけた"],["言い伝え","いいつたえ"],["に"],["従わないで","したがわないで"],["いる"],["、"],["すべて"],["の"],["兄弟","きょうだい"],["たち"],["から"],["離れて","はなれて"],["い"],["なさい"],["。"]]},{"verse":7,"text":"どのように私たちを見ならうべきかは、あなたがた自身が知っているのです。あなたがたのところで、私たちは締まりのないことはしなかったし、","tok":[["どの"],["よう"],["に"],["私たち","わたしたち"],["を"],["見ならうべき","みならうべき"],["か"],["は"],["、"],["あなた"],["がた"],["自身","じしん"],["が"],["知って","しって"],["いる"],["の"],["です"],["。"],["あなた"],["がた"],["の"],["ところ"],["で"],["、"],["私たち","わたしたち"],["は"],["締まり","しまり"],["の"],["ない"],["こと"],["は"],["しなかった"],["し"],["、"]]},{"verse":8,"text":"人のパンをただで食べることもしませんでした。かえって、あなたがたのだれにも負担をかけまいとして、昼も夜も労苦しながら働き続けました。","tok":[["人","ひと"],["の"],["パン"],["を"],["ただ"],["で"],["食べる","たべる"],["こと"],["も"],["しませんでした"],["。"],["かえって"],["、"],["あなた"],["がた"],["の"],["だれ"],["に"],["も"],["負担","ふたん"],["を"],["かけまい"],["として"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["労苦","ろうく"],["し"],["ながら"],["働き","はたらき"],["続けました","つづけました"],["。"]]},{"verse":9,"text":"それは、私たちに権利がなかったからではなく、ただ私たちを見ならうようにと、身をもってあなたがたに模範を示すためでした。","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["に"],["権利","けんり"],["が"],["なかった"],["から"],["で"],["は"],["なく"],["、"],["ただ"],["私たち","わたしたち"],["を"],["見ならう","みならう"],["よう"],["に"],["と"],["、"],["身","み"],["を"],["もって"],["あなた"],["がた"],["に"],["模範","もはん"],["を"],["示す","しめす"],["ため"],["でした"],["。"]]},{"verse":10,"text":"私たちは、あなたがたのところにいたときにも、働きたくない者は食べるなと命じました。","tok":[["私たち","わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["いた"],["とき"],["に"],["も"],["、"],["働きたく","はたらきたく"],["ない"],["者","もの"],["は"],["食べる","たべる"],["な"],["と"],["命じました","めいじました"],["。"]]},{"verse":11,"text":"ところが、あなたがたの中には、何も仕事をせず、おせっかいばかりして、締まりのない歩み方をしている人たちがあると聞いています。","tok":[["ところ"],["が"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["、"],["何","なん"],["も"],["仕事","しごと"],["を"],["せず"],["、"],["おせっかい"],["ばかり"],["して"],["、"],["締まり","しまり"],["の"],["ない"],["歩み","あゆみ"],["方","かた"],["を"],["して"],["いる"],["人","ひと"],["たち"],["が"],["ある"],["と"],["聞いて","きいて"],["います"],["。"]]},{"verse":12,"text":"こういう人たちには、主イエス・キリストによって、命じ、また勧めます。静かに仕事をし、自分で得たパンを食べなさい。","tok":[["こう"],["いう"],["人","ひと"],["たち"],["に"],["は"],["、"],["主","しゅ"],["イエス"],["・"],["キリスト"],["によって"],["、"],["命じ","めいじ"],["、"],["また"],["勧めます","すすめます"],["。"],["静か","しずか"],["に"],["仕事","しごと"],["を"],["し"],["、"],["自分","じぶん"],["で"],["得た","えた"],["パン"],["を"],["食べ","たべ"],["なさい"],["。"]]},{"verse":13,"text":"しかしあなたがたは、たゆむことなく善を行いなさい。兄弟たちよ。","tok":[["しかし"],["あなた"],["がた"],["は"],["、"],["たゆむ"],["こと"],["なく"],["善","ぜん"],["を"],["行い","おこない"],["なさい"],["。"],["兄弟","きょうだい"],["たち"],["よ"],["。"]]},{"verse":14,"text":"もし、この手紙に書いた私たちの指示に従わない者があれば、そのような人には、特に注意を払い、交際しないようにしなさい。彼が恥じ入るようになるためです。","tok":[["もし"],["、"],["この"],["手紙","てがみ"],["に"],["書いた","かいた"],["私たち","わたしたち"],["の"],["指示","しじ"],["に"],["従わない","したがわない"],["者","もの"],["が"],["あれば"],["、"],["その"],["よう"],["な"],["人","ひと"],["に"],["は"],["、"],["特に","とくに"],["注意","ちゅうい"],["を"],["払い","はらい"],["、"],["交際","こうさい"],["しない"],["よう"],["に"],["し"],["なさい"],["。"],["彼","かれ"],["が"],["恥じ入る","はじいる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":15,"text":"しかし、その人を敵とはみなさず、兄弟として戒めなさい。","tok":[["しかし"],["、"],["その"],["人","ひと"],["を"],["敵","てき"],["と"],["は"],["みなさず"],["、"],["兄弟","きょうだい"],["として"],["戒め","いましめ"],["なさい"],["。"]]},{"verse":16,"text":"どうか、平和の主ご自身が、どんな場合にも、いつも、あなたがたに平和を与えてくださいますように。どうか、主があなたがたすべてと、ともにおられますように。","tok":[["どう"],["か"],["、"],["平和","へいわ"],["の"],["主","ぬし"],["ご自身","ごじしん"],["が"],["、"],["どんな"],["場合","ばあい"],["に"],["も"],["、"],["いつも"],["、"],["あなた"],["がた"],["に"],["平和","へいわ"],["を"],["与えて","あたえて"],["くださいます"],["よう"],["に"],["。"],["どう"],["か"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["すべて"],["と"],["、"],["とも"],["に"],["おられます"],["よう"],["に"],["。"]]},{"verse":17,"text":"パウロが自分の手であいさつを書きます。これは私のどの手紙にもあるしるしです。これが私の手紙の書き方です。","tok":[["パウロ"],["が"],["自分","じぶん"],["の"],["手","て"],["で"],["あいさつ"],["を"],["書きます","かきます"],["。"],["これ"],["は"],["私","わたくし"],["の"],["どの"],["手紙","てがみ"],["に"],["も"],["ある"],["しるし"],["です"],["。"],["これ"],["が"],["私","わたくし"],["の"],["手紙","てがみ"],["の"],["書き方","かきかた"],["です"],["。"]]},{"verse":18,"text":"どうか、私たちの主イエス・キリストの恵みが、あなたがたすべてとともにありますように。","tok":[["どう"],["か"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["
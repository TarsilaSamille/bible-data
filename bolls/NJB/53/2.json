[{"verse":1,"text":"さて兄弟たちよ。私たちの主イエス・キリストが再び来られることと、私たちが主のみもとに集められることに関して、あなたがたにお願いすることがあります。","tok":[["さて"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["が"],["再び","ふたたび"],["来られる","こられる"],["こと"],["と"],["、"],["私たち","わたしたち"],["が"],["主","ぬし"],["のみ"],["もと"],["に"],["集められる","あつめられる"],["こと"],["に関して","にかんして"],["、"],["あなた"],["がた"],["に"],["お願い","おねがい"],["する"],["こと"],["が"],["あります"],["。"]]},{"verse":2,"text":"霊によってでも、あるいはことばによってでも、あるいは私たちから出たかのような手紙によってでも、主の日がすでに来たかのように言われるのを聞いて、すぐに落ち着きを失ったり、心を騒がせたりしないでください。","tok":[["霊","れい"],["によって"],["で"],["も"],["、"],["あるいは"],["ことば"],["によって"],["で"],["も"],["、"],["あるいは"],["私たち","わたしたち"],["から"],["出た","でた"],["か"],["の"],["よう"],["な"],["手紙","てがみ"],["によって"],["で"],["も"],["、"],["主","ぬし"],["の"],["日","ひ"],["が"],["すでに"],["来た","きた"],["か"],["の"],["よう"],["に"],["言われる","いわれる"],["の"],["を"],["聞いて","きいて"],["、"],["すぐ"],["に"],["落ち着き","おちつき"],["を"],["失っ","うしなっ"],["たり"],["、"],["心","こころ"],["を"],["騒がせ","さわがせ"],["たり"],["しないで"],["ください"],["。"]]},{"verse":3,"text":"だれにも、どのようにも、だまされないようにしなさい。なぜなら、まず背教が起こり、不法の人、すなわち滅びの子が現れなければ、主の日は来ないからです。","tok":[["だれ"],["に"],["も"],["、"],["どの"],["よう"],["に"],["も"],["、"],["だまされない"],["よう"],["に"],["し"],["なさい"],["。"],["なぜ"],["なら"],["、"],["まず"],["背教","はいきょう"],["が"],["起こり","おこり"],["、"],["不法","ふほう"],["の"],["人","ひと"],["、"],["すなわち"],["滅び","ほろび"],["の"],["子","こ"],["が"],["現れなければ","あらわれなければ"],["、"],["主","ぬし"],["の"],["日","ひ"],["は"],["来ない","こない"],["から"],["です"],["。"]]},{"verse":4,"text":"彼は、すべて神と呼ばれるもの、また礼拝されるものに反抗し、その上に自分を高く上げ、神の宮の中に座を設け、自分こそ神であると宣言します。","tok":[["彼","かれ"],["は"],["、"],["すべて"],["神","かみ"],["と"],["呼ばれる","よばれる"],["もの"],["、"],["また"],["礼拝","れいはい"],["される"],["もの"],["に"],["反抗","はんこう"],["し"],["、"],["その"],["上","うえ"],["に"],["自分","じぶん"],["を"],["高く","たかく"],["上げ","あげ"],["、"],["神","かみ"],["の"],["宮","みや"],["の"],["中","なか"],["に"],["座","ざ"],["を"],["設け","もうけ"],["、"],["自分","じぶん"],["こそ"],["神","かみ"],["で"],["ある"],["と"],["宣言","せんげん"],["します"],["。"]]},{"verse":5,"text":"私がまだあなたがたのところにいたとき、これらのことをよく話しておいたのを思い出しませんか。","tok":[["私","わたくし"],["が"],["まだ"],["あなた"],["がた"],["の"],["ところ"],["に"],["いた"],["とき"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["よく"],["話して","はなして"],["おいた"],["の"],["を"],["思い出しません","おもいだしません"],["か"],["。"]]},{"verse":6,"text":"あなたがたが知っているとおり、彼がその定められた時に現れるようにと、いま引き止めているものがあるのです。","tok":[["あなた"],["がた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["彼","かれ"],["が"],["その"],["定められた","さだめられた"],["時","とき"],["に"],["現れる","あらわれる"],["よう"],["に"],["と"],["、"],["いま"],["引き止めて","ひきとめて"],["いる"],["もの"],["が"],["ある"],["の"],["です"],["。"]]},{"verse":7,"text":"不法の秘密はすでに働いています。しかし今は引き止める者があって、自分が取り除かれる時まで引き止めているのです。","tok":[["不法","ふほう"],["の"],["秘密","ひみつ"],["は"],["すでに"],["働いて","はたらいて"],["います"],["。"],["しかし"],["今","いま"],["は"],["引き止める","ひきとめる"],["者","もの"],["が"],["あって"],["、"],["自分","じぶん"],["が"],["取り除かれる","とりのぞかれる"],["時","とき"],["まで"],["引き止めて","ひきとめて"],["いる"],["の"],["です"],["。"]]},{"verse":8,"text":"その時になると、不法の人が現れますが、主は御口の息をもって彼を殺し、来臨の輝きをもって滅ぼしてしまわれます。","tok":[["その"],["時","とき"],["に"],["なる"],["と"],["、"],["不法","ふほう"],["の"],["人","ひと"],["が"],["現れます","あらわれます"],["が"],["、"],["主","ぬし"],["は"],["御口","おくち"],["の"],["息","いき"],["を"],["もって"],["彼","かれ"],["を"],["殺し","ころし"],["、"],["来臨","らいりん"],["の"],["輝き","かがやき"],["を"],["もって"],["滅ぼして","ほろぼして"],["しまわれます"],["。"]]},{"verse":9,"text":"不法の人の到来は、サタンの働きによるのであって、あらゆる偽りの力、しるし、不思議がそれに伴い、","tok":[["不法","ふほう"],["の"],["人","ひと"],["の"],["到来","とうらい"],["は"],["、"],["サタン"],["の"],["働き","はたらき"],["に"],["よる"],["ので"],["あって"],["、"],["あらゆる"],["偽り","いつわり"],["の"],["力","ちから"],["、"],["しるし"],["、"],["不思議","ふしぎ"],["が"],["それ"],["に"],["伴い","ともない"],["、"]]},{"verse":10,"text":"また、滅びる人たちに対するあらゆる悪の欺きが行われます。なぜなら、彼らは救われるために真理への愛を受け入れなかったからです。","tok":[["また"],["、"],["滅びる","ほろびる"],["人","ひと"],["たち"],["に"],["対する","たいする"],["あらゆる"],["悪","あく"],["の"],["欺き","あざむき"],["が"],["行われます","おこなわれます"],["。"],["なぜ"],["なら"],["、"],["彼","かれ"],["ら"],["は"],["救われる","すくわれる"],["ため"],["に"],["真理","しんり"],["へ"],["の"],["愛","あい"],["を"],["受け入れなかった","うけいれなかった"],["から"],["です"],["。"]]},{"verse":11,"text":"それゆえ神は、彼らが偽りを信じるように、惑わす力を送り込まれます。","tok":[["それ"],["ゆえ"],["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["偽り","いつわり"],["を"],["信じる","しんじる"],["よう"],["に"],["、"],["惑わす","まどわす"],["力","ちから"],["を"],["送り込まれます","おくりこまれます"],["。"]]},{"verse":12,"text":"それは、真理を信じないで、悪を喜んでいたすべての者が、さばかれるためです。","tok":[["それ"],["は"],["、"],["真理","しんり"],["を"],["信じないで","しんじないで"],["、"],["悪","あく"],["を"],["喜んで","よろこんで"],["いた"],["すべて"],["の"],["者","もの"],["が"],["、"],["さばかれる"],["ため"],["です"],["。"]]},{"verse":13,"text":"しかし、あなたがたのことについては、私たちはいつでも神に感謝しなければなりません。主に愛されている兄弟たち。神は、御霊による聖めと、真理による信仰によって、あなたがたを、初めから救いにお選びになったからです。","tok":[["しかし"],["、"],["あなた"],["がた"],["の"],["こと"],["について"],["は"],["、"],["私たち","わたしたち"],["は"],["いつ"],["で"],["も"],["神","かみ"],["に"],["感謝","かんしゃ"],["しなければ"],["なりません"],["。"],["主に","おもに"],["愛されて","あいされて"],["いる"],["兄弟","きょうだい"],["たち"],["。"],["神","かみ"],["は"],["、"],["御霊","ごれい"],["に"],["よる"],["聖","きよし"],["め"],["と"],["、"],["真理","しんり"],["に"],["よる"],["信仰","しんこう"],["によって"],["、"],["あなた"],["がた"],["を"],["、"],["初め","はじめ"],["から"],["救い","すくい"],["に"],["お選び","おえらび"],["に"],["なった"],["から"],["です"],["。"]]},{"verse":14,"text":"ですから神は、私たちの福音によってあなたがたを召し、私たちの主イエス・キリストの栄光を得させてくださったのです。","tok":[["です"],["から"],["神","かみ"],["は"],["、"],["私たち","わたしたち"],["の"],["福音","ふくいん"],["によって"],["あなた"],["がた"],["を"],["召し","めし"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["栄光","えいこう"],["を"],["得させて","えさせて"],["くださった"],["の"],["です"],["。"]]},{"verse":15,"text":"そこで、兄弟たち。堅く立って、私たちのことば、または手紙によって教えられた言い伝えを守りなさい。","tok":[["そこ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["。"],["堅く","かたく"],["立って","たって"],["、"],["私たち","わたしたち"],["の"],["ことば"],["、"],["また"],["は"],["手紙","てがみ"],["によって"],["教えられた","おしえられた"],["言い伝え","いいつたえ"],["を"],["守り","まもり"],["なさい"],["。"]]},{"verse":16,"text":"どうか、私たちの主イエス・キリストと、私たちの父なる神、すなわち、私たちを愛し、恵みによって永遠の慰めとすばらしい望みとを与えてくださった方ご自身が、","tok":[["どう"],["か"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["と"],["、"],["私たち","わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["、"],["すなわち"],["、"],["私たち","わたしたち"],["を"],["愛し","あいし"],["、"],["恵み","めぐみ"],["によって"],["永遠","えいえん"],["の"],["慰め","なぐさめ"],["と"],["すばらしい"],["望み","のぞみ"],["と"],["を"],["与えて","あたえて"],["くださった"],["方","ほう"],["ご自身","ごじしん"],["が"],["、"]]},{"verse":17,"text":"あらゆる良いわざとことばとに進むよう、あなたがたの心を慰め、強めてくださいますように。","tok":[["あらゆる"],["良い","よい"],["わざ"],["と"],["ことば"],["と"],["に"],["進む","すすむ"],["よう"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["慰め","なぐさめ"],["、"],["強めて","つよめて"],["くださいます"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"主はこう仰せられる。／「天はわたしの王座、地はわたしの足台。／わたしのために、あなたがたの建てる家は、いったいどこにあるのか。／わたしのいこいの場は、いったいどこにあるのか。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["天","てん"],["は"],["わたし"],["の"],["王座","おうざ"],["、"],["地","ち"],["は"],["わたし"],["の"],["足台","あしだい"],["。"],["／"],["わたし"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["建てる","たてる"],["家","いえ"],["は"],["、"],["いったい"],["どこ"],["に"],["ある"],["の"],["か"],["。"],["／"],["わたし"],["の"],["いこい"],["の"],["場","ば"],["は"],["、"],["いったい"],["どこ"],["に"],["ある"],["の"],["か"],["。"]]},{"verse":2,"text":"これらすべては、わたしの手が造ったもの、これらすべてはわたしのものだ。／――主の御告げ――／わたしが目を留める者は、へりくだって心砕かれ、わたしのことばにおののく者だ。","tok":[["これ"],["ら"],["すべて"],["は"],["、"],["わたし"],["の"],["手","て"],["が"],["造った","つくった"],["もの"],["、"],["これ"],["ら"],["すべて"],["は"],["わたし"],["の"],["もの"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["が"],["目","め"],["を"],["留める","とめる"],["者","もの"],["は"],["、"],["へりくだって"],["心","こころ"],["砕かれ","くだかれ"],["、"],["わたし"],["の"],["ことば"],["に"],["おののく"],["者","もの"],["だ"],["。"]]},{"verse":3,"text":"牛をほふる者は、人を打ち殺す者。／羊をいけにえにする者は、犬をくびり殺す者。／穀物のささげ物をささげる者は、豚の血をささげる者。／乳香をささげる者は、偶像をほめたたえる者。／実に彼らは自分かってな道を選び、その心は忌むべき物を喜ぶ。","tok":[["牛","うし"],["を"],["ほふる"],["者","もの"],["は"],["、"],["人","ひと"],["を"],["打ち殺す","うちころす"],["者","もの"],["。"],["／"],["羊","ひつじ"],["を"],["いけにえ"],["に"],["する"],["者","もの"],["は"],["、"],["犬","いぬ"],["を"],["くびり殺す","くびりころす"],["者","もの"],["。"],["／"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["ささげる"],["者","もの"],["は"],["、"],["豚","ぶた"],["の"],["血","ち"],["を"],["ささげる"],["者","もの"],["。"],["／"],["乳香","にゅうこう"],["を"],["ささげる"],["者","もの"],["は"],["、"],["偶像","ぐうぞう"],["を"],["ほめたたえる"],["者","もの"],["。"],["／"],["実","じつ"],["に"],["彼","かれ"],["ら"],["は"],["自","じ"],["分かって","わかって"],["な"],["道","みち"],["を"],["選び","えらび"],["、"],["その"],["心","こころ"],["は"],["忌むべき","いむべき"],["物","もの"],["を"],["喜ぶ","よろこぶ"],["。"]]},{"verse":4,"text":"わたしも、彼らを虐待することを選び、彼らに恐怖をもたらす。／わたしが呼んでもだれも答えず、わたしが語りかけても聞かず、わたしの目の前に悪を行い、わたしの喜ばない事を彼らが選んだからだ。」","tok":[["わたし"],["も"],["、"],["彼","かれ"],["ら"],["を"],["虐待","ぎゃくたい"],["する"],["こと"],["を"],["選び","えらび"],["、"],["彼","かれ"],["ら"],["に"],["恐怖","きょうふ"],["を"],["もたらす"],["。"],["／"],["わたし"],["が"],["呼んで","よんで"],["も"],["だれ"],["も"],["答えず","こたえず"],["、"],["わたし"],["が"],["語りかけて","かたりかけて"],["も"],["聞かず","きかず"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行い","おこない"],["、"],["わたし"],["の"],["喜ばない","よろこばない"],["事","こと"],["を"],["彼","かれ"],["ら"],["が"],["選んだ","えらんだ"],["から"],["だ"],["。"],["」"]]},{"verse":5,"text":"主のことばにおののく者たちよ。／主のことばを聞け。「あなたがたを憎み、わたしの名のためにあなたがたを押しのける、あなたがたの同胞は言った。『主に栄光を現させよ。そうすれば、あなたがたの楽しみを見てやろう。』しかし、彼らは恥を見る。」","tok":[["主","ぬし"],["の"],["ことば"],["に"],["おののく"],["者","もの"],["たち"],["よ"],["。"],["／"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["「"],["あなた"],["がた"],["を"],["憎み","にくみ"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["あなた"],["がた"],["を"],["押しのける","おしのける"],["、"],["あなた"],["がた"],["の"],["同胞","どうほう"],["は"],["言った","いった"],["。"],["『"],["主に","おもに"],["栄光","えいこう"],["を"],["現させ","あらわさせ"],["よ"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["の"],["楽しみ","たのしみ"],["を"],["見て","みて"],["やろう"],["。"],["』"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["恥","はじ"],["を"],["見る","みる"],["。"],["」"]]},{"verse":6,"text":"聞け。町からの騒ぎ、宮からの声、敵に報復しておられる主の御声を。","tok":[["聞け","きけ"],["。"],["町","まち"],["から"],["の"],["騒ぎ","さわぎ"],["、"],["宮","みや"],["から"],["の"],["声","こえ"],["、"],["敵","てき"],["に"],["報復","ほうふく"],["して"],["おられる"],["主","ぬし"],["の"],["御声","おこえ"],["を"],["。"]]},{"verse":7,"text":"彼女は産みの苦しみをする前に産み、陣痛の起こる前に男の子を産み落とした。","tok":[["彼女","かのじょ"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["前","まえ"],["に"],["産み","うみ"],["、"],["陣痛","じんつう"],["の"],["起こる","おこる"],["前","まえ"],["に"],["男の子","おとこのこ"],["を"],["産み落とした","うみおとした"],["。"]]},{"verse":8,"text":"だれが、このような事を聞き、だれが、これらの事を見たか。／地は一日の陣痛で産み出されようか。／国は一瞬にして生まれようか。／ところがシオンは、陣痛を起こすと同時に子らを産んだのだ。","tok":[["だれ"],["が"],["、"],["この"],["よう"],["な"],["事","こと"],["を"],["聞き","きき"],["、"],["だれ"],["が"],["、"],["これ"],["ら"],["の"],["事","こと"],["を"],["見た","みた"],["か"],["。"],["／"],["地","ち"],["は"],["一","いち"],["日","にち"],["の"],["陣痛","じんつう"],["で"],["産み出されよう","うみだされよう"],["か"],["。"],["／"],["国","くに"],["は"],["一瞬","いっしゅん"],["に"],["して"],["生まれよう","うまれよう"],["か"],["。"],["／"],["ところ"],["が"],["シオン"],["は"],["、"],["陣痛","じんつう"],["を"],["起こす","おこす"],["と"],["同時","どうじ"],["に"],["子","こ"],["ら"],["を"],["産んだ","うんだ"],["の"],["だ"],["。"]]},{"verse":9,"text":"「わたしが産み出させるようにしながら、産ませないだろうか」と主は仰せられる。／「わたしは産ませる者なのに、胎を閉ざすだろうか」と／あなたの神は仰せられる。","tok":[["「"],["わたし"],["が"],["産み出させる","うみださせる"],["よう"],["に"],["し"],["ながら"],["、"],["産ませないだろう","うませないだろう"],["か"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["／"],["「"],["わたし"],["は"],["産ませる","うませる"],["者","もの"],["な"],["のに"],["、"],["胎","はら"],["を"],["閉ざすだろう","とざすだろう"],["か"],["」"],["と"],["／"],["あなた"],["の"],["神","かみ"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":10,"text":"エルサレムとともに喜べ。／すべてこれを愛する者よ。これとともに楽しめ。／すべてこれのために悲しむ者よ。／これとともに喜び喜べ。","tok":[["エルサレム"],["と"],["とも"],["に"],["喜べ","よろこべ"],["。"],["／"],["すべて"],["これ"],["を"],["愛する","あいする"],["者","もの"],["よ"],["。"],["これ"],["と"],["とも"],["に"],["楽しめ","たのしめ"],["。"],["／"],["すべて"],["これ"],["の"],["ため"],["に"],["悲しむ","かなしむ"],["者","もの"],["よ"],["。"],["／"],["これ"],["と"],["とも"],["に"],["喜び","よろこび"],["喜べ","よろこべ"],["。"]]},{"verse":11,"text":"あなたは、彼女の慰めの乳房から乳を飲んで飽き足り、その豊かな乳房から吸って喜んだからだ。","tok":[["あなた"],["は"],["、"],["彼女","かのじょ"],["の"],["慰め","なぐさめ"],["の"],["乳房","ちぶさ"],["から"],["乳","ちち"],["を"],["飲んで","のんで"],["飽き足り","あきたり"],["、"],["その"],["豊か","ゆたか"],["な"],["乳房","ちぶさ"],["から"],["吸って","すって"],["喜んだ","よろこんだ"],["から"],["だ"],["。"]]},{"verse":12,"text":"主はこう仰せられる。／「見よ。わたしは川のように繁栄を彼女に与え、あふれる流れのように国々の富を与える。／あなたがたは乳を飲み、わきに抱かれ、ひざの上でかわいがられる。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["川","かわ"],["の"],["よう"],["に"],["繁栄","はんえい"],["を"],["彼女","かのじょ"],["に"],["与え","あたえ"],["、"],["あふれる"],["流れ","ながれ"],["の"],["よう"],["に"],["国々","くにぐに"],["の"],["富","とみ"],["を"],["与える","あたえる"],["。"],["／"],["あなた"],["がた"],["は"],["乳","ちち"],["を"],["飲み","のみ"],["、"],["わき"],["に"],["抱かれ","いだかれ"],["、"],["ひざ"],["の"],["上","うえ"],["で"],["かわい"],["がら"],["れる"],["。"]]},{"verse":13,"text":"母に慰められる者のように、わたしはあなたがたを慰め、エルサレムであなたがたは慰められる。","tok":[["母","はは"],["に"],["慰められる","なぐさめられる"],["者","もの"],["の"],["よう"],["に"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["慰め","なぐさめ"],["、"],["エルサレム"],["で"],["あなた"],["がた"],["は"],["慰められる","なぐさめられる"],["。"]]},{"verse":14,"text":"あなたがたはこれを見て、心喜び、あなたがたの骨は若草のように生き返る。／主の御手は、そのしもべたちに知られ、その憤りは敵たちに向けられる。」","tok":[["あなた"],["がた"],["は"],["これ"],["を"],["見て","みて"],["、"],["心","こころ"],["喜び","よろこび"],["、"],["あなた"],["がた"],["の"],["骨","ほね"],["は"],["若草","わかくさ"],["の"],["よう"],["に"],["生き返る","いきかえる"],["。"],["／"],["主","ぬし"],["の"],["御手","おて"],["は"],["、"],["その"],["しもべ"],["たち"],["に"],["知られ","しられ"],["、"],["その"],["憤り","いきどおり"],["は"],["敵","てき"],["たち"],["に"],["向けられる","むけられる"],["。"],["」"]]},{"verse":15,"text":"見よ。まことに、主は火の中を進んで来られる。／その戦車はつむじ風のようだ。／その怒りを激しく燃やし、火の炎をもって責めたてる。","tok":[["見","み"],["よ"],["。"],["まこと"],["に"],["、"],["主","ぬし"],["は"],["火","ひ"],["の"],["中","なか"],["を"],["進んで","すすんで"],["来られる","こられる"],["。"],["／"],["その"],["戦車","せんしゃ"],["は"],["つむじ風","つむじかぜ"],["の"],["よう"],["だ"],["。"],["／"],["その"],["怒り","いかり"],["を"],["激しく","はげしく"],["燃やし","もやし"],["、"],["火","ひ"],["の"],["炎","ほのお"],["を"],["もって"],["責めたてる","せめたてる"],["。"]]},{"verse":16,"text":"実に、主は火をもってさばき、その剣ですべての肉なる者をさばく。／主に刺し殺される者は多い。","tok":[["実","じつ"],["に"],["、"],["主","ぬし"],["は"],["火","ひ"],["を"],["もって"],["さばき"],["、"],["その"],["剣","けん"],["で"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["を"],["さばく"],["。"],["／"],["主に","おもに"],["刺し殺される","さしころされる"],["者","もの"],["は"],["多い","おおい"],["。"]]},{"verse":17,"text":"おのが身を聖別し、身をきよめて、園に行き、その中にある一つのものに従って、豚の肉や、忌むべき物や、ねずみを食らう者たちはみな、絶ち滅ぼされる。／――主の御告げ――","tok":[["お"],["の"],["が"],["身","み"],["を"],["聖別","せいべつ"],["し"],["、"],["身","み"],["を"],["きよめて"],["、"],["園","その"],["に"],["行き","いき"],["、"],["その"],["中","なか"],["に"],["ある"],["一","ひと"],["つ"],["の"],["もの"],["に"],["従って","したがって"],["、"],["豚","ぶた"],["の"],["肉","にく"],["や"],["、"],["忌むべき","いむべき"],["物","もの"],["や"],["、"],["ねずみ"],["を"],["食らう","くらう"],["者","もの"],["たち"],["は"],["みな"],["、"],["絶ち","たち"],["滅ぼされる","ほろぼされる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":18,"text":"「わたしは、彼らのわざと、思い計りとを知っている。わたしは、すべての国々と種族とを集めに来る。彼らは来て、わたしの栄光を見る。","tok":[["「"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["わざと"],["、"],["思い計り","おもいはかり"],["と"],["を"],["知って","しって"],["いる"],["。"],["わたし"],["は"],["、"],["すべて"],["の"],["国々","くにぐに"],["と"],["種族","しゅぞく"],["と"],["を"],["集め","あつめ"],["に"],["来る","くる"],["。"],["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["わたし"],["の"],["栄光","えいこう"],["を"],["見る","みる"],["。"]]},{"verse":19,"text":"わたしは彼らの中にしるしを置き、彼らのうちののがれた者たちを諸国に遣わす。すなわち、タルシシュ、プル、弓を引く者ルデ、トバル、ヤワン、遠い島々に。これらはわたしのうわさを聞いたこともなく、わたしの栄光を見たこともない。彼らはわたしの栄光を諸国の民に告げ知らせよう。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["しるし"],["を"],["置き","おき"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["のがれた"],["者","もの"],["たち"],["を"],["諸国","しょこく"],["に"],["遣わす","つかわす"],["。"],["すなわち"],["、"],["タルシシュ"],["、"],["プル"],["、"],["弓","ゆみ"],["を"],["引く","ひく"],["者","もの"],["ルデ"],["、"],["トバル"],["、"],["ヤワン"],["、"],["遠い","とおい"],["島々","しまじま"],["に"],["。"],["これ"],["ら"],["は"],["わたし"],["の"],["うわさ"],["を"],["聞いた","きいた"],["こと"],["も"],["なく"],["、"],["わたし"],["の"],["栄光","えいこう"],["を"],["見た","みた"],["こと"],["も"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["栄光","えいこう"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["告げ知らせよう","つげしらせよう"],["。"]]},{"verse":20,"text":"彼らは、すべての国々から、あなたがたの同胞をみな、主への贈り物として、馬、車、かご、騾馬、らくだに乗せて、わたしの聖なる山、エルサレムに連れて来る」と主は仰せられる。「それはちょうど、イスラエル人がささげ物をきよい器に入れて主の宮に携えて来るのと同じである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["すべて"],["の"],["国々","くにぐに"],["から"],["、"],["あなた"],["がた"],["の"],["同胞","どうほう"],["を"],["みな"],["、"],["主","ぬし"],["へ"],["の"],["贈り物","おくりもの"],["として"],["、"],["馬","うま"],["、"],["車","くるま"],["、"],["かご"],["、"],["騾馬","らば"],["、"],["らくだ"],["に"],["乗せて","のせて"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["、"],["エルサレム"],["に"],["連れて","つれて"],["来る","くる"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["「"],["それ"],["は"],["ちょうど"],["、"],["イスラエル"],["人","にん"],["が"],["ささげ物","ささげもの"],["を"],["きよい"],["器","うつわ"],["に"],["入れて","いれて"],["主","ぬし"],["の"],["宮","みや"],["に"],["携えて","たずさえて"],["来る","くる"],["の"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":21,"text":"わたしは彼らの中からある者を選んで祭司とし、レビ人とする」と主は仰せられる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["から"],["ある"],["者","もの"],["を"],["選んで","えらんで"],["祭司","さいし"],["と"],["し"],["、"],["レビ人","れびにん"],["と"],["する"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":22,"text":"「わたしの造る新しい天と新しい地が、わたしの前にいつまでも続くように、――主の御告げ――／あなたがたの子孫と、あなたがたの名も／いつまでも続く。","tok":[["「"],["わたし"],["の"],["造る","つくる"],["新しい","あたらしい"],["天","てん"],["と"],["新しい","あたらしい"],["地","ち"],["が"],["、"],["わたし"],["の"],["前","まえ"],["に"],["いつ"],["まで"],["も"],["続く","つづく"],["よう"],["に"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["あなた"],["がた"],["の"],["子孫","しそん"],["と"],["、"],["あなた"],["がた"],["の"],["名","な"],["も"],["／"],["いつ"],["まで"],["も"],["続く","つづく"],["。"]]},{"verse":23,"text":"毎月の新月の祭りに、毎週の安息日に、すべての人が、わたしの前に礼拝に来る」と／主は仰せられる。","tok":[["毎月","まいつき"],["の"],["新月","しんげつ"],["の"],["祭り","まつり"],["に"],["、"],["毎週","まいしゅう"],["の"],["安息日","あんそくび"],["に"],["、"],["すべて"],["の"],["人","ひと"],["が"],["、"],["わたし"],["の"],["前","まえ"],["に"],["礼拝","れいはい"],["に"],["来る","くる"],["」"],["と"],["／"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":24,"text":"「彼らは出て行って、わたしにそむいた者たちのしかばねを見る。／そのうじは死なず、その火も消えず、それはすべての人に、忌みきらわれる。」","tok":[["「"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行って","いって"],["、"],["わたし"],["に"],["そむいた"],["者","もの"],["たち"],["の"],["しかばね"],["を"],["見る","みる"],["。"],["／"],["その"],["うじ"],["は"],["死なず","しなず"],["、"],["その"],["火","ひ"],["も"],["消えず","きえず"],["、"],["それ"],["は"],["すべて"],["の"],["人","ひと"],["に"],["、"],["忌みきらわれる","いみきらわれる"],["。"],["」"]]}]
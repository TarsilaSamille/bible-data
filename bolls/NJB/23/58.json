[{"verse":1,"text":"せいいっぱい大声で叫べ。／角笛のように、声をあげよ。／わたしの民に彼らのそむきの罪を告げ、ヤコブの家にその罪を告げよ。","tok":[["せい"],["いっぱい"],["大声","おおごえ"],["で"],["叫べ","さけべ"],["。"],["／"],["角笛","つのぶえ"],["の"],["よう"],["に"],["、"],["声","こえ"],["を"],["あげ"],["よ"],["。"],["／"],["わたし"],["の"],["民","たみ"],["に"],["彼","かれ"],["ら"],["の"],["そむき"],["の"],["罪","つみ"],["を"],["告げ","つげ"],["、"],["ヤコブ"],["の"],["家","いえ"],["に"],["その"],["罪","つみ"],["を"],["告げ","つげ"],["よ"],["。"]]},{"verse":2,"text":"しかし、彼らは日ごとにわたしを求め、わたしの道を知ることを望んでいる。／義を行い、神の定めを捨てたことのない国のように、彼らはわたしの正しいさばきをわたしに求め、神に近づくことを望んでいる。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["日ごと","ひごと"],["に"],["わたし"],["を"],["求め","もとめ"],["、"],["わたし"],["の"],["道","みち"],["を"],["知る","しる"],["こと"],["を"],["望んで","のぞんで"],["いる"],["。"],["／"],["義","ぎ"],["を"],["行い","おこない"],["、"],["神","かみ"],["の"],["定め","さだめ"],["を"],["捨てた","すてた"],["こと"],["の"],["ない"],["国","くに"],["の"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["正しい","ただしい"],["さばき"],["を"],["わたし"],["に"],["求め","もとめ"],["、"],["神","かみ"],["に"],["近づく","ちかづく"],["こと"],["を"],["望んで","のぞんで"],["いる"],["。"]]},{"verse":3,"text":"「なぜ、私たちが断食したのに、あなたはご覧にならなかったのですか。／私たちが身を戒めたのに、どうしてそれを認めてくださらないのですか。」／見よ。あなたがたは／断食の日に自分の好むことをし、あなたがたの労働者をみな、圧迫する。","tok":[["「"],["なぜ"],["、"],["私たち","わたしたち"],["が"],["断食","だんじき"],["した"],["のに"],["、"],["あなた"],["は"],["ご覧","ごらん"],["に"],["ならなかった"],["の"],["です"],["か"],["。"],["／"],["私たち","わたしたち"],["が"],["身","み"],["を"],["戒めた","いましめた"],["のに"],["、"],["どう"],["して"],["それ"],["を"],["認めて","みとめて"],["くださらない"],["の"],["です"],["か"],["。"],["」"],["／"],["見","み"],["よ"],["。"],["あなた"],["がた"],["は"],["／"],["断食","だんじき"],["の"],["日","ひ"],["に"],["自分","じぶん"],["の"],["好む","このむ"],["こと"],["を"],["し"],["、"],["あなた"],["がた"],["の"],["労働者","ろうどうしゃ"],["を"],["みな"],["、"],["圧迫","あっぱく"],["する"],["。"]]},{"verse":4,"text":"見よ。あなたがたが断食をするのは、争いとけんかをするためであり、不法にこぶしを打ちつけるためだ。／あなたがたは今、断食をしているが、あなたがたの声はいと高き所に届かない。","tok":[["見","み"],["よ"],["。"],["あなた"],["がた"],["が"],["断食","だんじき"],["を"],["する"],["の"],["は"],["、"],["争い","あらそい"],["と"],["けんか"],["を"],["する"],["ため"],["で"],["あり"],["、"],["不法","ふほう"],["に"],["こぶし"],["を"],["打ちつける","うちつける"],["ため"],["だ"],["。"],["／"],["あなた"],["がた"],["は"],["今","いま"],["、"],["断食","だんじき"],["を"],["して"],["いる"],["が"],["、"],["あなた"],["がた"],["の"],["声","こえ"],["は"],["いと"],["高き","たかき"],["所","ところ"],["に"],["届かない","とどかない"],["。"]]},{"verse":5,"text":"わたしの好む断食、人が身を戒める日は、このようなものだろうか。／葦のように頭を垂れ、荒布と灰を敷き広げることだけだろうか。／これを、あなたがたは断食と呼び、主に喜ばれる日と呼ぶのか。","tok":[["わたし"],["の"],["好む","このむ"],["断食","だんじき"],["、"],["人","ひと"],["が"],["身","み"],["を"],["戒める","いましめる"],["日","ひ"],["は"],["、"],["この"],["よう"],["な"],["もの"],["だろう"],["か"],["。"],["／"],["葦","あし"],["の"],["よう"],["に"],["頭","あたま"],["を"],["垂れ","たれ"],["、"],["荒布","あらめ"],["と"],["灰","はい"],["を"],["敷き","しき"],["広げる","ひろげる"],["こと"],["だけ"],["だろう"],["か"],["。"],["／"],["これ"],["を"],["、"],["あなた"],["がた"],["は"],["断食","だんじき"],["と"],["呼び","よび"],["、"],["主に","おもに"],["喜ばれる","よろこばれる"],["日","ひ"],["と"],["呼ぶ","よぶ"],["の"],["か"],["。"]]},{"verse":6,"text":"わたしの好む断食は、これではないか。／悪のきずなを解き、くびきのなわめをほどき、しいたげられた者たちを自由の身とし、すべてのくびきを砕くことではないか。","tok":[["わたし"],["の"],["好む","このむ"],["断食","だんじき"],["は"],["、"],["これ"],["で"],["は"],["ない"],["か"],["。"],["／"],["悪","あく"],["の"],["きずな"],["を"],["解き","とき"],["、"],["くびき"],["の"],["なわ"],["め"],["を"],["ほどき"],["、"],["しいたげられた"],["者","もの"],["たち"],["を"],["自由","じゆう"],["の"],["身","み"],["と"],["し"],["、"],["すべて"],["の"],["くびき"],["を"],["砕く","くだく"],["こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":7,"text":"飢えた者にはあなたのパンを分け与え、家のない貧しい人々を家に入れ、裸の人を見て、これに着せ、あなたの肉親の世話をすることではないか。","tok":[["飢えた","うえた"],["者","もの"],["に"],["は"],["あなた"],["の"],["パン"],["を"],["分け与え","わけあたえ"],["、"],["家","いえ"],["の"],["ない"],["貧しい","まずしい"],["人々","ひとびと"],["を"],["家","いえ"],["に"],["入れ","いれ"],["、"],["裸","はだか"],["の"],["人","ひと"],["を"],["見て","みて"],["、"],["これ"],["に"],["着せ","きせ"],["、"],["あなた"],["の"],["肉親","にくしん"],["の"],["世話","せわ"],["を"],["する"],["こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":8,"text":"そのとき、暁のようにあなたの光がさしいで、あなたの傷はすみやかにいやされる。／あなたの義はあなたの前に進み、主の栄光が、あなたのしんがりとなられる。","tok":[["その"],["とき"],["、"],["暁","あかつき"],["の"],["よう"],["に"],["あなた"],["の"],["光","ひかり"],["が"],["さし"],["いで"],["、"],["あなた"],["の"],["傷","きず"],["は"],["すみやか"],["に"],["いやされる"],["。"],["／"],["あなた"],["の"],["義","ぎ"],["は"],["あなた"],["の"],["前","まえ"],["に"],["進み","すすみ"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["、"],["あなた"],["の"],["しんがり"],["と"],["なられる"],["。"]]},{"verse":9,"text":"そのとき、あなたが呼ぶと、主は答え、あなたが叫ぶと、「わたしはここにいる」と仰せられる。／もし、あなたの中から、くびきを除き、うしろ指をさすことや、つまらないおしゃべりを除き、","tok":[["その"],["とき"],["、"],["あなた"],["が"],["呼ぶ","よぶ"],["と"],["、"],["主","ぬし"],["は"],["答え","こたえ"],["、"],["あなた"],["が"],["叫ぶ","さけぶ"],["と"],["、"],["「"],["わたし"],["は"],["ここ"],["に"],["いる"],["」"],["と"],["仰せられる","おおせられる"],["。"],["／"],["もし"],["、"],["あなた"],["の"],["中","なか"],["から"],["、"],["くびき"],["を"],["除き","のぞき"],["、"],["うしろ指","うしろゆび"],["を"],["さす"],["こと"],["や"],["、"],["つまらない"],["おしゃべり"],["を"],["除き","のぞき"],["、"]]},{"verse":10,"text":"飢えた者に心を配り、悩む者の願いを満足させるなら、あなたの光は、やみの中に輝き上り、あなたの暗やみは、真昼のようになる。","tok":[["飢えた","うえた"],["者","もの"],["に"],["心","こころ"],["を"],["配り","くばり"],["、"],["悩む","なやむ"],["者","もの"],["の"],["願い","ねがい"],["を"],["満足","まんぞく"],["させるなら"],["、"],["あなた"],["の"],["光","ひかり"],["は"],["、"],["やみ"],["の"],["中","なか"],["に"],["輝き","かがやき"],["上り","のぼり"],["、"],["あなた"],["の"],["暗やみ","くらやみ"],["は"],["、"],["真昼","まひる"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":11,"text":"主は絶えず、あなたを導いて、焼けつく土地でも、あなたの思いを満たし、あなたの骨を強くする。／あなたは、潤された園のようになり、水のかれない源のようになる。","tok":[["主","ぬし"],["は"],["絶えず","たえず"],["、"],["あなた"],["を"],["導いて","みちびいて"],["、"],["焼けつく","やけつく"],["土地","とち"],["で"],["も"],["、"],["あなた"],["の"],["思い","おもい"],["を"],["満たし","みたし"],["、"],["あなた"],["の"],["骨","ほね"],["を"],["強く","つよく"],["する"],["。"],["／"],["あなた"],["は"],["、"],["潤された","うるおされた"],["園","その"],["の"],["よう"],["に"],["なり"],["、"],["水","みず"],["の"],["かれない"],["源","みなもと"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":12,"text":"あなたのうちのある者は、昔の廃墟を建て直し、あなたは古代の礎を築き直し、「破れを繕う者、市街を住めるように回復する者」と呼ばれよう。","tok":[["あなた"],["の"],["うち"],["の"],["ある"],["者","もの"],["は"],["、"],["昔","むかし"],["の"],["廃墟","はいきょ"],["を"],["建て直し","たてなおし"],["、"],["あなた"],["は"],["古代","こだい"],["の"],["礎","いしずえ"],["を"],["築き直し","きずきなおし"],["、"],["「"],["破れ","やぶれ"],["を"],["繕う","つくろう"],["者","もの"],["、"],["市街","しがい"],["を"],["住める","すめる"],["よう"],["に"],["回復","かいふく"],["する"],["者","もの"],["」"],["と"],["呼ばれよう","よばれよう"],["。"]]},{"verse":13,"text":"もし、あなたが安息日に出歩くことをやめ、わたしの聖日に自分の好むことをせず、安息日を「喜びの日」と呼び、主の聖日を「はえある日」と呼び、これを尊んで旅をせず、自分の好むことを求めず、むだ口を慎むなら、","tok":[["もし"],["、"],["あなた"],["が"],["安息日","あんそくび"],["に"],["出歩く","であるく"],["こと"],["を"],["やめ"],["、"],["わたし"],["の"],["聖日","せいじつ"],["に"],["自分","じぶん"],["の"],["好む","このむ"],["こと"],["を"],["せず"],["、"],["安息日","あんそくび"],["を"],["「"],["喜び","よろこび"],["の"],["日","ひ"],["」"],["と"],["呼び","よび"],["、"],["主","ぬし"],["の"],["聖日","せいじつ"],["を"],["「"],["は"],["え"],["ある"],["日","ひ"],["」"],["と"],["呼び","よび"],["、"],["これ"],["を"],["尊んで","とうとんで"],["旅","たび"],["を"],["せず"],["、"],["自分","じぶん"],["の"],["好む","このむ"],["こと"],["を"],["求めず","もとめず"],["、"],["むだ口","むだぐち"],["を"],["慎むなら","つつしむなら"],["、"]]},{"verse":14,"text":"そのとき、あなたは主をあなたの喜びとしよう。／「わたしはあなたに地の高い所を踏み行かせ、あなたの父ヤコブのゆずりの地で／あなたを養う」と／主の御口が語られたからである。","tok":[["その"],["とき"],["、"],["あなた"],["は"],["主","ぬし"],["を"],["あなた"],["の"],["喜び","よろこび"],["と"],["しよう"],["。"],["／"],["「"],["わたし"],["は"],["あなた"],["に"],["地","ち"],["の"],["高い","たかい"],["所","ところ"],["を"],["踏み","ふみ"],["行かせ","いかせ"],["、"],["あなた"],["の"],["父","ちち"],["ヤコブ"],["の"],["ゆずり"],["の"],["地","ち"],["で"],["／"],["あなた"],["を"],["養う","やしなう"],["」"],["と"],["／"],["主","ぬし"],["の"],["御口","おくち"],["が"],["語られた","かたられた"],["から"],["で"],["ある"],["。"]]}]
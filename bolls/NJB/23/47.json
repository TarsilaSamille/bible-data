[{"verse":1,"text":"「おとめバビロンの娘よ。／下って、ちりの上にすわれ。／カルデヤ人の娘よ。王座のない地にすわれ。／もうあなたは、優しい上品な女と呼ばれないからだ。","tok":[["「"],["おとめ"],["バビロン"],["の"],["娘","むすめ"],["よ"],["。"],["／"],["下って","くだって"],["、"],["ちり"],["の"],["上","うえ"],["に"],["すわれ"],["。"],["／"],["カルデヤ"],["人","にん"],["の"],["娘","むすめ"],["よ"],["。"],["王座","おうざ"],["の"],["ない"],["地","ち"],["に"],["すわれ"],["。"],["／"],["もう"],["あなた"],["は"],["、"],["優しい","やさしい"],["上品","じょうひん"],["な"],["女","おんな"],["と"],["呼ばれない","よばれない"],["から"],["だ"],["。"]]},{"verse":2,"text":"ひき臼を取って粉をひけ。／顔おおいを取り去り、すそをまくって、すねを出し、川を渡れ。","tok":[["ひき臼","ひきうす"],["を"],["取って","とって"],["粉","こな"],["を"],["ひけ"],["。"],["／"],["顔","かお"],["おおい"],["を"],["取り去り","とりさり"],["、"],["すそ"],["を"],["まくって"],["、"],["すね"],["を"],["出し","だし"],["、"],["川","かわ"],["を"],["渡れ","わたれ"],["。"]]},{"verse":3,"text":"あなたの裸は現れ、あなたの恥もあらわになる。／わたしは復讐をする。だれひとり容赦しない。」","tok":[["あなた"],["の"],["裸","はだか"],["は"],["現れ","あらわれ"],["、"],["あなた"],["の"],["恥","はじ"],["も"],["あらわ"],["に"],["なる"],["。"],["／"],["わたし"],["は"],["復讐","ふくしゅう"],["を"],["する"],["。"],["だれ"],["ひとり"],["容赦","ようしゃ"],["しない"],["。"],["」"]]},{"verse":4,"text":"私たちを贖う方、その名は万軍の主、イスラエルの聖なる方。","tok":[["私たち","わたしたち"],["を"],["贖う","あがなう"],["方","かた"],["、"],["その"],["名","な"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["。"]]},{"verse":5,"text":"「カルデヤ人の娘よ。／黙ってすわり、やみに入れ。／あなたはもう、王国の女王と呼ばれることはないからだ。","tok":[["「"],["カルデヤ"],["人","にん"],["の"],["娘","むすめ"],["よ"],["。"],["／"],["黙って","だまって"],["すわり"],["、"],["やみ"],["に"],["入れ","いれ"],["。"],["／"],["あなた"],["は"],["もう"],["、"],["王国","おうこく"],["の"],["女王","じょおう"],["と"],["呼ばれる","よばれる"],["こと"],["は"],["ない"],["から"],["だ"],["。"]]},{"verse":6,"text":"わたしは、わたしの民を怒って、わたしのゆずりの民を汚し、彼らをあなたの手に渡したが、あなたは彼らをあわれまず、老人にも、ひどく重いくびきを負わせた。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["民","たみ"],["を"],["怒って","おこって"],["、"],["わたし"],["の"],["ゆずり"],["の"],["民","たみ"],["を"],["汚し","よごし"],["、"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["手","て"],["に"],["渡した","わたした"],["が"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["あわれまず"],["、"],["老人","ろうじん"],["に"],["も"],["、"],["ひどく"],["重い","おもい"],["くびき"],["を"],["負わせた","おわせた"],["。"]]},{"verse":7,"text":"あなたは『いつまでも、私は女王でいよう』／と考えて、これらのことを心に留めず、自分の終わりのことを思ってもみなかった。","tok":[["あなた"],["は"],["『"],["いつ"],["まで"],["も"],["、"],["私","わたくし"],["は"],["女王","じょおう"],["で"],["いよう"],["』"],["／"],["と"],["考えて","かんがえて"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["心","こころ"],["に"],["留めず","とめず"],["、"],["自分","じぶん"],["の"],["終わり","おわり"],["の"],["こと"],["を"],["思って","おもって"],["も"],["みなかった"],["。"]]},{"verse":8,"text":"だから今、これを聞け。／楽しみにふけり、安心して住んでいる女。／心の中で、『私だけは特別だ。／私はやもめにはならないし、子を失うことも知らなくて済もう』と言う者よ。","tok":[["だ"],["から"],["今","いま"],["、"],["これ"],["を"],["聞け","きけ"],["。"],["／"],["楽しみ","たのしみ"],["に"],["ふけり"],["、"],["安心","あんしん"],["して"],["住んで","すんで"],["いる"],["女","おんな"],["。"],["／"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["『"],["私","わたくし"],["だけ"],["は"],["特別","とくべつ"],["だ"],["。"],["／"],["私","わたくし"],["は"],["やもめ"],["に"],["は"],["ならない"],["し"],["、"],["子","こ"],["を"],["失う","うしなう"],["こと"],["も"],["知らなくて","しらなくて"],["済もう","すもう"],["』"],["と"],["言う","いう"],["者","もの"],["よ"],["。"]]},{"verse":9,"text":"子を失うことと、やもめになること、この二つが一日のうちに、またたくまにあなたに来る。／あなたがどんなに多く呪術を行っても、どんなに強く呪文を唱えても、これらは突然、あなたを見舞う。","tok":[["子","こ"],["を"],["失う","うしなう"],["こと"],["と"],["、"],["やもめ"],["に"],["なる"],["こと"],["、"],["この"],["二","ふた"],["つ"],["が"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["、"],["またたく"],["ま"],["に"],["あなた"],["に"],["来る","くる"],["。"],["／"],["あなた"],["が"],["どんな"],["に"],["多く","おおく"],["呪術","じゅじゅつ"],["を"],["行って","おこなって"],["も"],["、"],["どんな"],["に"],["強く","つよく"],["呪文","じゅもん"],["を"],["唱えて","となえて"],["も"],["、"],["これ"],["ら"],["は"],["突然","とつぜん"],["、"],["あなた"],["を"],["見舞う","みまう"],["。"]]},{"verse":10,"text":"あなたは自分の悪に拠り頼み、『私を見る者はない』と言う。／あなたの知恵と知識、これがあなたを迷わせた。／だから、あなたは心の中で言う。／『私だけは特別だ。』","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["悪","わる"],["に"],["拠り","より"],["頼み","たのみ"],["、"],["『"],["私","わたくし"],["を"],["見る","みる"],["者","もの"],["は"],["ない"],["』"],["と"],["言う","ゆう"],["。"],["／"],["あなた"],["の"],["知恵","ちえ"],["と"],["知識","ちしき"],["、"],["これ"],["が"],["あなた"],["を"],["迷わせた","まよわせた"],["。"],["／"],["だ"],["から"],["、"],["あなた"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["言う","ゆう"],["。"],["／"],["『"],["私","わたくし"],["だけ"],["は"],["特別","とくべつ"],["だ"],["。"],["』"]]},{"verse":11,"text":"しかしわざわいがあなたを見舞う。／それを払いのけるまじないをあなたは知らない。／災難があなたを襲うが、あなたはそれを避けることはできない。／破滅はあなたの知らないうちに、突然あなたにやって来る。","tok":[["しかし"],["わざわい"],["が"],["あなた"],["を"],["見舞う","みまう"],["。"],["／"],["それ"],["を"],["払いのける","はらいのける"],["まじない"],["を"],["あなた"],["は"],["知らない","しらない"],["。"],["／"],["災難","さいなん"],["が"],["あなた"],["を"],["襲う","おそう"],["が"],["、"],["あなた"],["は"],["それ"],["を"],["避ける","さける"],["こと"],["は"],["できない"],["。"],["／"],["破滅","はめつ"],["は"],["あなた"],["の"],["知らない","しらない"],["うち"],["に"],["、"],["突然","とつぜん"],["あなた"],["に"],["やって"],["来る","くる"],["。"]]},{"verse":12,"text":"さあ、若い時からの使い古しの呪文や、多くの呪術を使って、立ち上がれ。／あるいは役立つかもしれない。／おびえさせることができるかもしれない。","tok":[["さあ"],["、"],["若い","わかい"],["時","とき"],["から"],["の"],["使い古し","つかいふるし"],["の"],["呪文","じゅもん"],["や"],["、"],["多く","おおく"],["の"],["呪術","じゅじゅつ"],["を"],["使って","つかって"],["、"],["立ち上がれ","たちあがれ"],["。"],["／"],["あるいは"],["役立つ","やくだつ"],["か"],["も"],["しれない"],["。"],["／"],["おびえ"],["させる"],["こと"],["が"],["できる"],["か"],["も"],["しれない"],["。"]]},{"verse":13,"text":"あなたに助言する者が多すぎて、あなたは疲れている。／さあ、天を観測する者、星を見る者、新月ごとにあなたに起こる事を知らせる者を／並べたてて、あなたを救わせてみよ。","tok":[["あなた"],["に"],["助言","じょげん"],["する"],["者","もの"],["が"],["多","おお"],["すぎて"],["、"],["あなた"],["は"],["疲れて","つかれて"],["いる"],["。"],["／"],["さあ"],["、"],["天","てん"],["を"],["観測","かんそく"],["する"],["者","もの"],["、"],["星","ほし"],["を"],["見る","みる"],["者","もの"],["、"],["新月","しんげつ"],["ごと"],["に"],["あなた"],["に"],["起こる","おこる"],["事","こと"],["を"],["知らせる","しらせる"],["者","もの"],["を"],["／"],["並べたてて","ならべたてて"],["、"],["あなた"],["を"],["救わせて","すくわせて"],["み"],["よ"],["。"]]},{"verse":14,"text":"見よ。彼らは刈り株のようになり、火が彼らを焼き尽くす。／彼らは自分のいのちを／炎の手から救い出すこともできない。／これは身を暖める炭火でもなく、その前にすわれる火でもない。","tok":[["見","み"],["よ"],["。"],["彼","かれ"],["ら"],["は"],["刈り株","かりかぶ"],["の"],["よう"],["に"],["なり"],["、"],["火","ひ"],["が"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くす","つくす"],["。"],["／"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["いのち"],["を"],["／"],["炎","ほのお"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["こと"],["も"],["できない"],["。"],["／"],["これ"],["は"],["身","み"],["を"],["暖める","あたためる"],["炭火","すみび"],["で"],["も"],["なく"],["、"],["その"],["前","まえ"],["に"],["すわれる"],["火","ひ"],["で"],["も"],["ない"],["。"]]},{"verse":15,"text":"あなたが若い時から仕え、行き来してきた者たちは、このようになる。／彼らはおのおの自分かってに迷い出て、あなたを救う者はひとりもいない。」","tok":[["あなた"],["が"],["若い","わかい"],["時","とき"],["から"],["仕え","つかえ"],["、"],["行き来","いきき"],["して"],["きた"],["者","もの"],["たち"],["は"],["、"],["この"],["よう"],["に"],["なる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["おのおの"],["自分","じぶん"],["か"],["って"],["に"],["迷い出て","まよいでて"],["、"],["あなた"],["を"],["救う","すくう"],["者","もの"],["は"],["ひとり"],["も"],["いない"],["。"],["」"]]}]
[{"verse":1,"text":"さめよ。さめよ。力をまとえ。シオン。／あなたの美しい衣を着よ。／聖なる都エルサレム。／無割礼の汚れた者が、もう、あなたの中に入って来ることはない。","tok":[["さめ"],["よ"],["。"],["さめ"],["よ"],["。"],["力","ちから"],["を"],["まとえ"],["。"],["シオン"],["。"],["／"],["あなた"],["の"],["美しい","うつくしい"],["衣","ころも"],["を"],["着","き"],["よ"],["。"],["／"],["聖","せい"],["なる"],["都","と"],["エルサレム"],["。"],["／"],["無","む"],["割礼","かつれい"],["の"],["汚れた","よごれた"],["者","もの"],["が"],["、"],["もう"],["、"],["あなた"],["の"],["中","なか"],["に"],["入って","はいって"],["来る","くる"],["こと"],["は"],["ない"],["。"]]},{"verse":2,"text":"ちりを払い落として立ち上がり、もとの座に着け、エルサレム。／あなたの首からかせをふりほどけ、捕囚のシオンの娘よ。","tok":[["ちり"],["を"],["払い落として","はらいおとして"],["立ち上がり","たちあがり"],["、"],["もと"],["の"],["座","ざ"],["に"],["着け","つけ"],["、"],["エルサレム"],["。"],["／"],["あなた"],["の"],["首","くび"],["から"],["かせ"],["を"],["ふりほどけ"],["、"],["捕囚","ほしゅう"],["の"],["シオン"],["の"],["娘","むすめ"],["よ"],["。"]]},{"verse":3,"text":"まことに主はこう仰せられる。「あなたがたは、ただで売られた。だから、金を払わずに買い戻される。」","tok":[["まこと"],["に"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["ただ"],["で"],["売られた","うられた"],["。"],["だ"],["から"],["、"],["金","きん"],["を"],["払わず","はらわず"],["に"],["買い戻される","かいもどされる"],["。"],["」"]]},{"verse":4,"text":"まことに神である主がこう仰せられる。「わたしの民は昔、エジプトに下って行ってそこに寄留した。またアッシリヤ人がゆえなく彼らを苦しめた。","tok":[["まこと"],["に"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["わたし"],["の"],["民","たみ"],["は"],["昔","むかし"],["、"],["エジプト"],["に"],["下って","くだって"],["行って","いって"],["そこ"],["に"],["寄留","きりゅう"],["した"],["。"],["また"],["アッシリヤ"],["人","にん"],["が"],["ゆえなく"],["彼","かれ"],["ら"],["を"],["苦しめた","くるしめた"],["。"]]},{"verse":5,"text":"さあ、今、ここでわたしは何をしよう。――主の御告げ――わたしの民はただで奪い取られ、彼らを支配する者たちはわめいている。――主の御告げ――また、わたしの名は一日中絶えず侮られている。","tok":[["さあ"],["、"],["今","いま"],["、"],["ここ"],["で"],["わたし"],["は"],["何","なん"],["を"],["しよう"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["の"],["民","たみ"],["は"],["ただ"],["で"],["奪い取られ","うばいとられ"],["、"],["彼","かれ"],["ら"],["を"],["支配","しはい"],["する"],["者","もの"],["たち"],["は"],["わめいて"],["いる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["また"],["、"],["わたし"],["の"],["名","な"],["は"],["一","いち"],["日中","にちちゅう"],["絶えず","たえず"],["侮られて","あなどられて"],["いる"],["。"]]},{"verse":6,"text":"それゆえ、わたしの民はわたしの名を知るようになる。その日、『ここにわたしがいる』と告げる者がわたしであることを知るようになる。」","tok":[["それ"],["ゆえ"],["、"],["わたし"],["の"],["民","たみ"],["は"],["わたし"],["の"],["名","な"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["その"],["日","ひ"],["、"],["『"],["ここ"],["に"],["わたし"],["が"],["いる"],["』"],["と"],["告げる","つげる"],["者","もの"],["が"],["わたし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":7,"text":"良い知らせを伝える者の足は／山々の上にあって、なんと美しいことよ。／平和を告げ知らせ、幸いな良い知らせを伝え、救いを告げ知らせ、「あなたの神が王となる」と／シオンに言う者の足は。","tok":[["良い","よい"],["知らせ","しらせ"],["を"],["伝える","つたえる"],["者","もの"],["の"],["足","あし"],["は"],["／"],["山々","やまやま"],["の"],["上","うえ"],["に"],["あって"],["、"],["なん"],["と"],["美しい","うつくしい"],["こと"],["よ"],["。"],["／"],["平和","へいわ"],["を"],["告げ知らせ","つげしらせ"],["、"],["幸い","さいわい"],["な"],["良い","よい"],["知らせ","しらせ"],["を"],["伝え","つたえ"],["、"],["救い","すくい"],["を"],["告げ知らせ","つげしらせ"],["、"],["「"],["あなた"],["の"],["神","かみ"],["が"],["王","おう"],["と"],["なる"],["」"],["と"],["／"],["シオン"],["に"],["言う","いう"],["者","もの"],["の"],["足","あし"],["は"],["。"]]},{"verse":8,"text":"聞け。あなたの見張り人たちが、声を張り上げ、共に喜び歌っている。／彼らは、主がシオンに帰られるのを、まのあたりに見るからだ。","tok":[["聞け","きけ"],["。"],["あなた"],["の"],["見張り","みはり"],["人","ひと"],["たち"],["が"],["、"],["声","こえ"],["を"],["張り上げ","はりあげ"],["、"],["共","とも"],["に"],["喜び歌って","よろこびうたって"],["いる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["が"],["シオン"],["に"],["帰られる","かえられる"],["の"],["を"],["、"],["まのあたり"],["に"],["見る","みる"],["から"],["だ"],["。"]]},{"verse":9,"text":"エルサレムの廃墟よ。／共に大声をあげて喜び歌え。／主がその民を慰め、エルサレムを贖われたから。","tok":[["エルサレム"],["の"],["廃墟","はいきょ"],["よ"],["。"],["／"],["共","とも"],["に"],["大声","おおごえ"],["を"],["あげて"],["喜び歌え","よろこびうたえ"],["。"],["／"],["主","ぬし"],["が"],["その"],["民","たみ"],["を"],["慰め","なぐさめ"],["、"],["エルサレム"],["を"],["贖われた","あがなわれた"],["から"],["。"]]},{"verse":10,"text":"主はすべての国々の目の前に、聖なる御腕を現した。／地の果て果てもみな、私たちの神の救いを見る。","tok":[["主","ぬし"],["は"],["すべて"],["の"],["国々","くにぐに"],["の"],["目","め"],["の"],["前","まえ"],["に"],["、"],["聖","せい"],["なる"],["御腕","おうで"],["を"],["現した","あらわした"],["。"],["／"],["地","ち"],["の"],["果て果て","はてはて"],["も"],["みな"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["救い","すくい"],["を"],["見る","みる"],["。"]]},{"verse":11,"text":"去れよ。去れよ。そこを出よ。／汚れたものに触れてはならない。／その中から出て、身をきよめよ。／主の器をになう者たち。","tok":[["去れ","され"],["よ"],["。"],["去れ","され"],["よ"],["。"],["そこ"],["を"],["出","で"],["よ"],["。"],["／"],["汚れた","よごれた"],["もの"],["に"],["触れて","ふれて"],["は"],["ならない"],["。"],["／"],["その"],["中","なか"],["から"],["出て","でて"],["、"],["身","み"],["を"],["きよめよ"],["。"],["／"],["主","ぬし"],["の"],["器","うつわ"],["を"],["になう"],["者","もの"],["たち"],["。"]]},{"verse":12,"text":"あなたがたは、あわてて出なくてもよい。／逃げるようにして去らなくてもよい。／主があなたがたの前に進み、イスラエルの神が、あなたがたのしんがりとなられるからだ。","tok":[["あなた"],["がた"],["は"],["、"],["あわてて"],["出なくて","でなくて"],["も"],["よい"],["。"],["／"],["逃げる","にげる"],["よう"],["に"],["して"],["去らなくて","さらなくて"],["も"],["よい"],["。"],["／"],["主","ぬし"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["進み","すすみ"],["、"],["イスラエル"],["の"],["神","かみ"],["が"],["、"],["あなた"],["がた"],["の"],["しんがり"],["と"],["なられる"],["から"],["だ"],["。"]]},{"verse":13,"text":"見よ。わたしのしもべは栄える。／彼は高められ、上げられ、非常に高くなる。","tok":[["見","み"],["よ"],["。"],["わたし"],["の"],["しもべ"],["は"],["栄える","さかえる"],["。"],["／"],["彼","かれ"],["は"],["高められ","たかめられ"],["、"],["上げられ","あげられ"],["、"],["非常","ひじょう"],["に"],["高く","たかく"],["なる"],["。"]]},{"verse":14,"text":"多くの者があなたを見て驚いたように、――その顔だちは、そこなわれて人のようではなく、その姿も人の子らとは違っていた――","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["あなた"],["を"],["見て","みて"],["驚いた","おどろいた"],["よう"],["に"],["、"],["―"],["―"],["その"],["顔だち","かおだち"],["は"],["、"],["そこなわれて"],["人","ひと"],["の"],["よう"],["で"],["は"],["なく"],["、"],["その"],["姿","すがた"],["も"],["人","ひと"],["の"],["子","こ"],["ら"],["と"],["は"],["違って","ちがって"],["いた"],["―"],["―"]]},{"verse":15,"text":"そのように、彼は多くの国々を驚かす。／王たちは彼の前で口をつぐむ。／彼らは、まだ告げられなかったことを見、まだ聞いたこともないことを悟るからだ。","tok":[["その"],["よう"],["に"],["、"],["彼","かれ"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["を"],["驚かす","おどろかす"],["。"],["／"],["王","おう"],["たち"],["は"],["彼","かれ"],["の"],["前","まえ"],["で"],["口","くち"],["を"],["つぐむ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["まだ"],["告げられなかった","つげられなかった"],["こと"],["を"],["見","み"],["、"],["まだ"],["聞いた","きいた"],["こと"],["も"],["ない"],["こと"],["を"],["悟る","さとる"],["から"],["だ"],["。"]]}]
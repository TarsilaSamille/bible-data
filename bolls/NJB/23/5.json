[{"verse":1,"text":"「さあ、わが愛する者のためにわたしは歌おう。／そのぶどう畑についてのわが愛の歌を。／わが愛する者は、よく肥えた山腹に、ぶどう畑を持っていた。","tok":[["「"],["さあ"],["、"],["わが"],["愛する","あいする"],["者","もの"],["の"],["ため"],["に"],["わたし"],["は"],["歌おう","うたおう"],["。"],["／"],["その"],["ぶどう"],["畑","はたけ"],["について"],["の"],["わが"],["愛","あい"],["の"],["歌","うた"],["を"],["。"],["／"],["わが"],["愛する","あいする"],["者","もの"],["は"],["、"],["よく"],["肥えた","こえた"],["山腹","さんぷく"],["に"],["、"],["ぶどう"],["畑","はたけ"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":2,"text":"彼はそこを掘り起こし、石を取り除き、そこに良いぶどうを植え、その中にやぐらを立て、酒ぶねまでも掘って、甘いぶどうのなるのを待ち望んでいた。／ところが、酸いぶどうができてしまった。","tok":[["彼","かれ"],["は"],["そこ"],["を"],["掘り起こし","ほりおこし"],["、"],["石","いし"],["を"],["取り除き","とりのぞき"],["、"],["そこ"],["に"],["良い","よい"],["ぶどう"],["を"],["植え","うえ"],["、"],["その"],["中","なか"],["に"],["やぐら"],["を"],["立て","たて"],["、"],["酒","さけ"],["ぶね"],["まで"],["も"],["掘って","ほって"],["、"],["甘い","あまい"],["ぶどう"],["の"],["なる"],["の"],["を"],["待ち望んで","まちのぞんで"],["いた"],["。"],["／"],["ところ"],["が"],["、"],["酸い","すい"],["ぶどう"],["が"],["できて"],["しまった"],["。"]]},{"verse":3,"text":"そこで今、エルサレムの住民とユダの人よ、さあ、わたしとわがぶどう畑との間をさばけ。","tok":[["そこ"],["で"],["今","いま"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["と"],["ユダ"],["の"],["人","ひと"],["よ"],["、"],["さあ"],["、"],["わたし"],["と"],["わが"],["ぶどう"],["畑","はたけ"],["と"],["の"],["間","あいだ"],["を"],["さばけ"],["。"]]},{"verse":4,"text":"わがぶどう畑になすべきことで、なお、何かわたしがしなかったことがあるのか。／なぜ、甘いぶどうのなるのを待ち望んだのに、酸いぶどうができたのか。","tok":[["わが"],["ぶどう"],["畑","はたけ"],["に"],["なすべき"],["こと"],["で"],["、"],["なお"],["、"],["何","なん"],["か"],["わたし"],["が"],["しなかった"],["こと"],["が"],["ある"],["の"],["か"],["。"],["／"],["なぜ"],["、"],["甘い","あまい"],["ぶどう"],["の"],["なる"],["の"],["を"],["待ち望んだ","まちのぞんだ"],["のに"],["、"],["酸い","すい"],["ぶどう"],["が"],["できた"],["の"],["か"],["。"]]},{"verse":5,"text":"さあ、今度はわたしが、あなたがたに知らせよう。／わたしがわがぶどう畑に対してすることを。／その垣を除いて、荒れすたれるに任せ、その石垣をくずして、踏みつけるままにする。","tok":[["さあ"],["、"],["今度","こんど"],["は"],["わたし"],["が"],["、"],["あなた"],["がた"],["に"],["知らせよう","しらせよう"],["。"],["／"],["わたし"],["が"],["わが"],["ぶどう"],["畑","はたけ"],["に対して","にたいして"],["する"],["こと"],["を"],["。"],["／"],["その"],["垣","かき"],["を"],["除いて","のぞいて"],["、"],["荒れ","あれ"],["すたれる"],["に"],["任せ","まかせ"],["、"],["その"],["石垣","いしがき"],["を"],["くずして"],["、"],["踏みつける","ふみつける"],["まま"],["に"],["する"],["。"]]},{"verse":6,"text":"わたしは、これを滅びるままにしておく。／枝はおろされず、草は刈られず、いばらとおどろが生い茂る。／わたしは雲に命じて、この上に雨を降らせない。」","tok":[["わたし"],["は"],["、"],["これ"],["を"],["滅びる","ほろびる"],["まま"],["に"],["して"],["おく"],["。"],["／"],["枝","えだ"],["は"],["おろされず"],["、"],["草","くさ"],["は"],["刈られず","かられず"],["、"],["いばら"],["と"],["おどろ"],["が"],["生い茂る","おいしげる"],["。"],["／"],["わたし"],["は"],["雲","くも"],["に"],["命じて","めいじて"],["、"],["この"],["上","うえ"],["に"],["雨","あめ"],["を"],["降らせない","ふらせない"],["。"],["」"]]},{"verse":7,"text":"まことに、万軍の主のぶどう畑はイスラエルの家。／ユダの人は、主が喜んで植えつけたもの。／主は公正を待ち望まれたのに、見よ、流血。／正義を待ち望まれたのに、見よ、泣き叫び。","tok":[["まこと"],["に"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["ぶどう"],["畑","はたけ"],["は"],["イスラエル"],["の"],["家","いえ"],["。"],["／"],["ユダ"],["の"],["人","ひと"],["は"],["、"],["主","ぬし"],["が"],["喜んで","よろこんで"],["植えつけた","うえつけた"],["もの"],["。"],["／"],["主","ぬし"],["は"],["公正","こうせい"],["を"],["待ち望まれた","まちのぞまれた"],["のに"],["、"],["見よ","みよ"],["、"],["流血","りゅうけつ"],["。"],["／"],["正義","せいぎ"],["を"],["待ち望まれた","まちのぞまれた"],["のに"],["、"],["見よ","みよ"],["、"],["泣き叫び","なきさけび"],["。"]]},{"verse":8,"text":"ああ。家に家を連ね、畑に畑を寄せている者たち。／あなたがたは余地も残さず、自分たちだけが国の中に住もうとしている。","tok":[["ああ"],["。"],["家","いえ"],["に"],["家","いえ"],["を"],["連ね","つらね"],["、"],["畑","はたけ"],["に"],["畑","はたけ"],["を"],["寄せて","よせて"],["いる"],["者","もの"],["たち"],["。"],["／"],["あなた"],["がた"],["は"],["余地","よち"],["も"],["残さず","のこさず"],["、"],["自分","じぶん"],["たち"],["だけ"],["が"],["国","くに"],["の"],["中","なか"],["に"],["住もう","すもう"],["として"],["いる"],["。"]]},{"verse":9,"text":"私の耳に、万軍の主は告げられた。／「必ず、多くの家は荒れすたれ、大きな美しい家々も住む人がなくなる。","tok":[["私","わたくし"],["の"],["耳","みみ"],["に"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["告げられた","つげられた"],["。"],["／"],["「"],["必ず","かならず"],["、"],["多く","おおく"],["の"],["家","いえ"],["は"],["荒れ","あれ"],["すたれ"],["、"],["大きな","おおきな"],["美しい","うつくしい"],["家々","いえいえ"],["も"],["住む","すむ"],["人","ひと"],["が"],["なくなる"],["。"]]},{"verse":10,"text":"十ツェメドのぶどう畑が一バテを産し、一ホメルの種が一エパを産するからだ。」","tok":[["十","じゅう"],["ツェメド"],["の"],["ぶどう"],["畑","はたけ"],["が"],["一","いち"],["バテ"],["を"],["産し","さんし"],["、"],["一","いち"],["ホメル"],["の"],["種","たね"],["が"],["一","いち"],["エパ"],["を"],["産する","さんする"],["から"],["だ"],["。"],["」"]]},{"verse":11,"text":"ああ。朝早くから強い酒を追い求め、夜をふかして、ぶどう酒をあおっている者たち。","tok":[["ああ"],["。"],["朝","あさ"],["早く","はやく"],["から"],["強い","つよい"],["酒","さけ"],["を"],["追い求め","おいもとめ"],["、"],["夜","よる"],["を"],["ふかして"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["あおって"],["いる"],["者","もの"],["たち"],["。"]]},{"verse":12,"text":"彼らの酒宴には、立琴と十弦の琴、タンバリンと笛とぶどう酒がある。／彼らは、主のみわざを見向きもせず、御手のなされたことを見もしない。","tok":[["彼","かれ"],["ら"],["の"],["酒宴","しゅえん"],["に"],["は"],["、"],["立琴","たてごと"],["と"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["、"],["タンバリン"],["と"],["笛","ふえ"],["と"],["ぶどう酒","ぶどうしゅ"],["が"],["ある"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["のみ"],["わざ"],["を"],["見向き","みむき"],["も"],["せず"],["、"],["御手","おて"],["の"],["なされた"],["こと"],["を"],["見","み"],["も"],["しない"],["。"]]},{"verse":13,"text":"それゆえ、わが民は無知のために捕らえ移される。／その貴族たちは、飢えた人々。／その群衆は、渇きで干からびる。","tok":[["それ"],["ゆえ"],["、"],["わが"],["民","みん"],["は"],["無知","むち"],["の"],["ため"],["に"],["捕らえ","とらえ"],["移される","うつされる"],["。"],["／"],["その"],["貴族","きぞく"],["たち"],["は"],["、"],["飢えた","うえた"],["人々","ひとびと"],["。"],["／"],["その"],["群衆","ぐんしゅう"],["は"],["、"],["渇き","かわき"],["で"],["干からびる","ひからびる"],["。"]]},{"verse":14,"text":"それゆえ、よみは、のどを広げ、口を限りなくあける。／その威光も、その騒音も、そのどよめきも、そこでの歓声も、よみに落ち込む。","tok":[["それ"],["ゆえ"],["、"],["よみ"],["は"],["、"],["のど"],["を"],["広げ","ひろげ"],["、"],["口","くち"],["を"],["限りなく","かぎりなく"],["あける"],["。"],["／"],["その"],["威光","いこう"],["も"],["、"],["その"],["騒音","そうおん"],["も"],["、"],["その"],["どよめき"],["も"],["、"],["そこ"],["で"],["の"],["歓声","かんせい"],["も"],["、"],["よみ"],["に"],["落ち込む","おちこむ"],["。"]]},{"verse":15,"text":"こうして人はかがめられ、人間は低くされ、高ぶる者の目も低くされる。","tok":[["こう"],["して"],["人","ひと"],["は"],["かがめられ"],["、"],["人間","にんげん"],["は"],["低く","ひくく"],["され"],["、"],["高ぶる","たかぶる"],["者","もの"],["の"],["目","め"],["も"],["低く","ひくく"],["される"],["。"]]},{"verse":16,"text":"しかし、万軍の主は、さばきによって高くなり、聖なる神は正義によって、みずから聖なることを示される。","tok":[["しかし"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["さばき"],["によって"],["高く","たかく"],["なり"],["、"],["聖","せい"],["なる"],["神","かみ"],["は"],["正義","せいぎ"],["によって"],["、"],["みずから"],["聖","せい"],["なる"],["こと"],["を"],["示される","しめされる"],["。"]]},{"verse":17,"text":"子羊は自分の牧場にいるように草を食べ、肥えた獣は廃墟にとどまって食をとる。","tok":[["子羊","こひつじ"],["は"],["自分","じぶん"],["の"],["牧場","ぼくじょう"],["に"],["いる"],["よう"],["に"],["草","くさ"],["を"],["食べ","たべ"],["、"],["肥えた","こえた"],["獣","けもの"],["は"],["廃墟","はいきょ"],["に"],["とどまって"],["食","しょく"],["を"],["とる"],["。"]]},{"verse":18,"text":"ああ。／うそを綱として咎を引き寄せ、車の手綱でするように、罪を引き寄せている者たち。","tok":[["ああ"],["。"],["／"],["うそ"],["を"],["綱","つな"],["として"],["咎","とが"],["を"],["引き寄せ","ひきよせ"],["、"],["車","くるま"],["の"],["手綱","たづな"],["で"],["する"],["よう"],["に"],["、"],["罪","つみ"],["を"],["引き寄せて","ひきよせて"],["いる"],["者","もの"],["たち"],["。"]]},{"verse":19,"text":"彼らは言う。「彼のすることを早くせよ。／急がせよ。それを見たいものだ。／イスラエルの聖なる方のはかりごとが、近づけばよい。それを知りたいものだ」と。","tok":[["彼","かれ"],["ら"],["は"],["言う","ゆう"],["。"],["「"],["彼","かれ"],["の"],["する"],["こと"],["を"],["早く","はやく"],["せよ"],["。"],["／"],["急がせ","いそがせ"],["よ"],["。"],["それ"],["を"],["見たい","みたい"],["もの"],["だ"],["。"],["／"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["の"],["はかりごと"],["が"],["、"],["近づけば","ちかづけば"],["よい"],["。"],["それ"],["を"],["知りたい","しりたい"],["もの"],["だ"],["」"],["と"],["。"]]},{"verse":20,"text":"ああ。／悪を善、善を悪と言っている者たち。／彼らはやみを光、光をやみとし、苦みを甘み、甘みを苦みとしている。","tok":[["ああ"],["。"],["／"],["悪","あく"],["を"],["善","ぜん"],["、"],["善","ぜん"],["を"],["悪","あく"],["と"],["言って","いって"],["いる"],["者","もの"],["たち"],["。"],["／"],["彼","かれ"],["ら"],["は"],["やみ"],["を"],["光","ひかり"],["、"],["光","ひかり"],["を"],["やみ"],["と"],["し"],["、"],["苦み","にがみ"],["を"],["甘み","あまみ"],["、"],["甘み","あまみ"],["を"],["苦み","にがみ"],["として"],["いる"],["。"]]},{"verse":21,"text":"ああ。おのれを知恵ある者とみなし、おのれを、悟りがある者と見せかける者たち。","tok":[["ああ"],["。"],["おのれ"],["を"],["知恵","ちえ"],["ある"],["者","もの"],["と"],["みなし"],["、"],["おのれ"],["を"],["、"],["悟り","さとり"],["が"],["ある"],["者","もの"],["と"],["見せかける","みせかける"],["者","もの"],["たち"],["。"]]},{"verse":22,"text":"ああ。酒を飲むことでの勇士、強い酒を混ぜ合わせることにかけての豪の者。","tok":[["ああ"],["。"],["酒","さけ"],["を"],["飲
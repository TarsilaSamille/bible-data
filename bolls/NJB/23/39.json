[{"verse":1,"text":"そのころ、バルアダンの子、バビロンの王メロダク・バルアダンは、使者を遣わし、手紙と贈り物をヒゼキヤに届けた。彼が病気だったが、元気になった、ということを聞いたからである。","tok":[["その"],["ころ"],["、"],["バルアダン"],["の"],["子","こ"],["、"],["バビロン"],["の"],["王","おう"],["メロダク"],["・"],["バルアダン"],["は"],["、"],["使者","ししゃ"],["を"],["遣わし","つかわし"],["、"],["手紙","てがみ"],["と"],["贈り物","おくりもの"],["を"],["ヒゼキヤ"],["に"],["届けた","とどけた"],["。"],["彼","かれ"],["が"],["病気","びょうき"],["だった"],["が"],["、"],["元気","げんき"],["に"],["なった"],["、"],["と"],["いう"],["こと"],["を"],["聞いた","きいた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"ヒゼキヤはそれらを喜び、宝庫、銀、金、香料、高価な油、いっさいの武器庫、彼の宝物倉にあるすべての物を彼らに見せた。ヒゼキヤがその家の中、および国中で、彼らに見せなかった物は一つもなかった。","tok":[["ヒゼキヤ"],["は"],["それ"],["ら"],["を"],["喜び","よろこび"],["、"],["宝庫","ほうこ"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["香料","こうりょう"],["、"],["高価","こうか"],["な"],["油","あぶら"],["、"],["いっさい"],["の"],["武器庫","ぶきこ"],["、"],["彼","かれ"],["の"],["宝物倉","ほうもつそう"],["に"],["ある"],["すべて"],["の"],["物","もの"],["を"],["彼","かれ"],["ら"],["に"],["見せた","みせた"],["。"],["ヒゼキヤ"],["が"],["その"],["家","いえ"],["の"],["中","なか"],["、"],["および"],["国中","くにちゅう"],["で"],["、"],["彼","かれ"],["ら"],["に"],["見せなかった","みせなかった"],["物","もの"],["は"],["一","ひと"],["つ"],["も"],["なかった"],["。"]]},{"verse":3,"text":"そこで預言者イザヤが、ヒゼキヤ王のところに来て、彼に尋ねた。「あの人々は何を言いましたか。どこから来たのですか。」ヒゼキヤは答えた。「遠い国、バビロンから、私のところに来たのです。」","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["イザヤ"],["が"],["、"],["ヒゼキヤ"],["王","おう"],["の"],["ところ"],["に"],["来て","きて"],["、"],["彼","かれ"],["に"],["尋ねた","たずねた"],["。"],["「"],["あの"],["人々","ひとびと"],["は"],["何","なん"],["を"],["言いました","いいました"],["か"],["。"],["どこ"],["から"],["来た","きた"],["の"],["です"],["か"],["。"],["」"],["ヒゼキヤ"],["は"],["答えた","こたえた"],["。"],["「"],["遠い","とおい"],["国","くに"],["、"],["バビロン"],["から"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["来た","きた"],["の"],["です"],["。"],["」"]]},{"verse":4,"text":"イザヤはまた言った。「彼らは、あなたの家で何を見たのですか。」ヒゼキヤは答えた。「私の家の中のすべての物を見ました。私の宝物倉の中で彼らに見せなかった物は一つもありません。」","tok":[["イザヤ"],["は"],["また"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["家","いえ"],["で"],["何","なん"],["を"],["見た","みた"],["の"],["です"],["か"],["。"],["」"],["ヒゼキヤ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["の"],["家","いえ"],["の"],["中","なか"],["の"],["すべて"],["の"],["物","もの"],["を"],["見ました","みました"],["。"],["私","わたくし"],["の"],["宝物倉","ほうもつそう"],["の"],["中","なか"],["で"],["彼","かれ"],["ら"],["に"],["見せなかった","みせなかった"],["物","もの"],["は"],["一","ひと"],["つ"],["も"],["ありません"],["。"],["」"]]},{"verse":5,"text":"すると、イザヤはヒゼキヤに言った。「万軍の主のことばを聞きなさい。","tok":[["する"],["と"],["、"],["イザヤ"],["は"],["ヒゼキヤ"],["に"],["言った","いった"],["。"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["ことば"],["を"],["聞き","きき"],["なさい"],["。"]]},{"verse":6,"text":"見よ。あなたの家にある物、あなたの先祖たちが今日まで、たくわえてきた物がすべて、バビロンへ運び去られる日が来ている。何一つ残されまい、と主は仰せられます。","tok":[["見","み"],["よ"],["。"],["あなた"],["の"],["家","いえ"],["に"],["ある"],["物","もの"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["が"],["今日","きょう"],["まで"],["、"],["たくわえて"],["きた"],["物","もの"],["が"],["すべて"],["、"],["バビロン"],["へ"],["運び去られる","はこびさられる"],["日","ひ"],["が"],["来て","きて"],["いる"],["。"],["何","なん"],["一","ひと"],["つ"],["残されまい","のこされまい"],["、"],["と"],["主","ぬし"],["は"],["仰せられます","おおせられます"],["。"]]},{"verse":7,"text":"また、あなたの生む、あなた自身の息子たちのうち、捕らえられてバビロンの王の宮殿で宦官となる者があろう。」","tok":[["また"],["、"],["あなた"],["の"],["生む","うむ"],["、"],["あなた"],["自身","じしん"],["の"],["息子","むすこ"],["たち"],["の"],["うち"],["、"],["捕らえられて","とらえられて"],["バビロン"],["の"],["王","おう"],["の"],["宮殿","きゅうでん"],["で"],["宦官","かんがん"],["と"],["なる"],["者","もの"],["が"],["あろう"],["。"],["」"]]},{"verse":8,"text":"ヒゼキヤはイザヤに言った。「あなたが告げてくれた主のことばはありがたい。」彼は、自分が生きている間は、平和で安全だろう、と思ったからである。","tok":[["ヒゼキヤ"],["は"],["イザヤ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["告げて","つげて"],["くれた"],["主","ぬし"],["の"],["ことば"],["は"],["ありがたい"],["。"],["」"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["平和","へいわ"],["で"],["安全","あんぜん"],["だろう"],["、"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]}]
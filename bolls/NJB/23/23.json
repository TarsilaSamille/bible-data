[{"verse":1,"text":"ツロに対する宣告。／タルシシュの船よ。泣きわめけ。／ツロは荒らされて、家も港もなくなった、と／キティムの地から、彼らに示されたのだ。","tok":[["ツロ"],["に"],["対する","たいする"],["宣告","せんこく"],["。"],["／"],["タルシシュ"],["の"],["船","ふね"],["よ"],["。"],["泣きわめけ","なきわめけ"],["。"],["／"],["ツロ"],["は"],["荒らされて","あらされて"],["、"],["家","いえ"],["も"],["港","みなと"],["も"],["なくなった"],["、"],["と"],["／"],["キティム"],["の"],["地","ち"],["から"],["、"],["彼","かれ"],["ら"],["に"],["示された","しめされた"],["の"],["だ"],["。"]]},{"verse":2,"text":"海辺の住民よ。黙せ。／海を渡るシドンの商人はあなたを富ませていた。","tok":[["海辺","うみべ"],["の"],["住民","じゅうみん"],["よ"],["。"],["黙せ","もくせ"],["。"],["／"],["海","うみ"],["を"],["渡る","わたる"],["シドン"],["の"],["商人","しょうにん"],["は"],["あなた"],["を"],["富ませて","とませて"],["いた"],["。"]]},{"verse":3,"text":"大海によって、シホルの穀物、ナイルの刈り入れがあなたの収穫となり、あなたは諸国と商いをしていた。","tok":[["大海","たいかい"],["によって"],["、"],["シホル"],["の"],["穀物","こくもつ"],["、"],["ナイル"],["の"],["刈り入れ","かりいれ"],["が"],["あなた"],["の"],["収穫","しゅうかく"],["と"],["なり"],["、"],["あなた"],["は"],["諸国","しょこく"],["と"],["商い","あきない"],["を"],["して"],["いた"],["。"]]},{"verse":4,"text":"シドンよ、恥を見よ、と海が言う。／海のとりでがこう言っている。「私は産みの苦しみをせず、子を産まず、若い男を育てず、若い女を養ったこともない。」","tok":[["シドン"],["よ"],["、"],["恥","はじ"],["を"],["見よ","みよ"],["、"],["と"],["海","うみ"],["が"],["言う","ゆう"],["。"],["／"],["海","うみ"],["の"],["とりで"],["が"],["こう"],["言って","いって"],["いる"],["。"],["「"],["私","わたくし"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["せず"],["、"],["子","こ"],["を"],["産まず","うまず"],["、"],["若い","わかい"],["男","おとこ"],["を"],["育てず","そだてず"],["、"],["若い","わかい"],["女","おんな"],["を"],["養った","やしなった"],["こと"],["も"],["ない"],["。"],["」"]]},{"verse":5,"text":"エジプトがこのツロのうわさを聞いたなら、ひどく苦しもう。","tok":[["エジプト"],["が"],["この"],["ツロ"],["の"],["うわさ"],["を"],["聞いたなら","きいたなら"],["、"],["ひどく"],["苦しもう","くるしもう"],["。"]]},{"verse":6,"text":"海辺の住民よ。／タルシシュへ渡り、泣きわめけ。","tok":[["海辺","うみべ"],["の"],["住民","じゅうみん"],["よ"],["。"],["／"],["タルシシュ"],["へ"],["渡り","わたり"],["、"],["泣きわめけ","なきわめけ"],["。"]]},{"verse":7,"text":"これが、あなたがたのおごった町なのか。／その起こりは古く、その足を遠くに運んで移住したものを。","tok":[["これ"],["が"],["、"],["あなた"],["がた"],["の"],["おごった"],["町","まち"],["な"],["の"],["か"],["。"],["／"],["その"],["起こり","おこり"],["は"],["古く","ふるく"],["、"],["その"],["足","あし"],["を"],["遠く","とおく"],["に"],["運んで","はこんで"],["移住","いじゅう"],["した"],["もの"],["を"],["。"]]},{"verse":8,"text":"だれが、王冠をいただくツロに対して／これを計ったのか。／その商人は君主たち、そのあきゅうどは世界で最も尊ばれていたのに。","tok":[["だれ"],["が"],["、"],["王冠","おうかん"],["を"],["いただく"],["ツロ"],["に対して","にたいして"],["／"],["これ"],["を"],["計った","はかった"],["の"],["か"],["。"],["／"],["その"],["商人","しょうにん"],["は"],["君主","くんしゅ"],["たち"],["、"],["その"],["あ"],["きゅう"],["ど"],["は"],["世界","せかい"],["で"],["最も","もっとも"],["尊ばれて","とうとばれて"],["いた"],["のに"],["。"]]},{"verse":9,"text":"万軍の主がそれを計り、すべての麗しい誇りを汚し、すべて世界で最も尊ばれている者を／卑しめられた。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["それ"],["を"],["計り","はかり"],["、"],["すべて"],["の"],["麗しい","うるわしい"],["誇り","ほこり"],["を"],["汚し","よごし"],["、"],["すべて"],["世界","せかい"],["で"],["最も","もっとも"],["尊ばれて","とうとばれて"],["いる"],["者","もの"],["を"],["／"],["卑しめられた","いやしめられた"],["。"]]},{"verse":10,"text":"タルシシュの娘よ。／ナイル川のように、自分の国にあふれよ。／だが、もうこれを制する者がいない。","tok":[["タルシシュ"],["の"],["娘","むすめ"],["よ"],["。"],["／"],["ナイル"],["川","かわ"],["の"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["国","くに"],["に"],["あふれ"],["よ"],["。"],["／"],["だ"],["が"],["、"],["もう"],["これ"],["を"],["制する","せいする"],["者","もの"],["が"],["いない"],["。"]]},{"verse":11,"text":"主は御手を海の上に伸ばし、王国をおののかせた。／主は命令を下してカナンのとりでを滅ぼした。","tok":[["主","ぬし"],["は"],["御手","おて"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["伸ばし","のばし"],["、"],["王国","おうこく"],["を"],["おののかせた"],["。"],["／"],["主","ぬし"],["は"],["命令","めいれい"],["を"],["下して","くだして"],["カナン"],["の"],["とりで"],["を"],["滅ぼした","ほろぼした"],["。"]]},{"verse":12,"text":"そして仰せられた。「もう二度とこおどりして喜ぶな。しいたげられたおとめ、シドンの娘よ。立ってキティムに渡れ。そこでもあなたは休めない。」","tok":[["そして"],["仰せられた","おおせられた"],["。"],["「"],["もう"],["二","に"],["度","ど"],["と"],["こおどり"],["して"],["喜ぶ","よろこぶ"],["な"],["。"],["しいたげられた"],["おとめ"],["、"],["シドン"],["の"],["娘","むすめ"],["よ"],["。"],["立って","たって"],["キティム"],["に"],["渡れ","わたれ"],["。"],["そこ"],["で"],["も"],["あなた"],["は"],["休めない","やすめない"],["。"],["」"]]},{"verse":13,"text":"見よ、カルデヤ人の国を。／――この民はもういない。／アッシリヤ人が／これを荒野の獣の住む所にした。――／彼らは、やぐらを立てて、その宮殿をかすめ、そこを廃墟にした。","tok":[["見よ","みよ"],["、"],["カルデヤ"],["人","にん"],["の"],["国","くに"],["を"],["。"],["／"],["―"],["―"],["この"],["民","みん"],["は"],["もう"],["いない"],["。"],["／"],["アッシリヤ"],["人","にん"],["が"],["／"],["これ"],["を"],["荒野","あらの"],["の"],["獣","けもの"],["の"],["住む","すむ"],["所","ところ"],["に"],["した"],["。"],["―"],["―"],["／"],["彼","かれ"],["ら"],["は"],["、"],["やぐら"],["を"],["立てて","たてて"],["、"],["その"],["宮殿","きゅうでん"],["を"],["かすめ"],["、"],["そこ"],["を"],["廃墟","はいきょ"],["に"],["した"],["。"]]},{"verse":14,"text":"タルシシュの船よ。泣きわめけ。／あなたがたのとりでが荒らされたからだ。","tok":[["タルシシュ"],["の"],["船","ふね"],["よ"],["。"],["泣きわめけ","なきわめけ"],["。"],["／"],["あなた"],["がた"],["の"],["とりで"],["が"],["荒らされた","あらされた"],["から"],["だ"],["。"]]},{"verse":15,"text":"その日になると、ツロは、ひとりの王の年代の七十年の間忘れられる。七十年が終わって、ツロは遊女の歌のようになる。","tok":[["その"],["日","ひ"],["に"],["なる"],["と"],["、"],["ツロ"],["は"],["、"],["ひとり"],["の"],["王","おう"],["の"],["年代","ねんだい"],["の"],["七十","ななじゅう"],["年","ねん"],["の"],["間","あいだ"],["忘れられる","わすれられる"],["。"],["七十","ななじゅう"],["年","ねん"],["が"],["終わって","おわって"],["、"],["ツロ"],["は"],["遊女","ゆうじょ"],["の"],["歌","うた"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":16,"text":"「立琴を取り、町を巡れ、忘れられた遊女よ。／うまくひけ、もっと歌え、思い出してもらうために。」","tok":[["「"],["立琴","たてごと"],["を"],["取り","とり"],["、"],["町","まち"],["を"],["巡れ","めぐれ"],["、"],["忘れられた","わすれられた"],["遊女","ゆうじょ"],["よ"],["。"],["／"],["うまく"],["ひけ"],["、"],["もっと"],["歌え","うたえ"],["、"],["思い出して","おもいだして"],["もらう"],["ため"],["に"],["。"],["」"]]},{"verse":17,"text":"七十年がたつと、主はツロを顧みられるので、彼女は再び遊女の報酬を得、地のすべての王国と地上で淫行を行う。","tok":[["七十","ななじゅう"],["年","ねん"],["が"],["たつ"],["と"],["、"],["主","ぬし"],["は"],["ツロ"],["を"],["顧みられる","かえりみられる"],["ので"],["、"],["彼女","かのじょ"],["は"],["再び","ふたたび"],["遊女","ゆうじょ"],["の"],["報酬","ほうしゅう"],["を"],["得","え"],["、"],["地","ち"],["の"],["すべて"],["の"],["王国","おうこく"],["と"],["地上","ちじょう"],["で"],["淫行","いんこう"],["を"],["行う","おこなう"],["。"]]},{"verse":18,"text":"その儲け、遊女の報酬は、主にささげられ、それはたくわえられず、積み立てられない。その儲けは、主の前に住む者たちが、飽きるほど食べ、上等の着物を着るためのものとなるからだ。","tok":[["その"],["儲け","もうけ"],["、"],["遊女","ゆうじょ"],["の"],["報酬","ほうしゅう"],["は"],["、"],["主に","おもに"],["ささげられ"],["、"],["それ"],["は"],["たくわえられず"],["、"],["積み立てられない","つみたてられない"],["。"],["その"],["儲け","もうけ"],["は"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["住む","すむ"],["者","もの"],["たち"],["が"],["、"],["飽きる","あきる"],["ほど"],["食べ","たべ"],["、"],["上等","じょうとう"],["の"],["着物","きもの"],["を"],["着る","きる"],["ため"],["の"],["もの"],["と"],["なる"],["から"],["だ"],["。"]]}]
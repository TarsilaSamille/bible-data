[{"verse":1,"text":"その日、あなたは言おう。「主よ。感謝します。あなたは、私を怒られたのに、あなたの怒りは去り、私を慰めてくださいました。」","tok":[["その"],["日","ひ"],["、"],["あなた"],["は"],["言おう","いおう"],["。"],["「"],["主","ぬし"],["よ"],["。"],["感謝","かんしゃ"],["します"],["。"],["あなた"],["は"],["、"],["私","わたくし"],["を"],["怒られた","おこられた"],["のに"],["、"],["あなた"],["の"],["怒り","いかり"],["は"],["去り","さり"],["、"],["私","わたくし"],["を"],["慰めて","なぐさめて"],["くださいました"],["。"],["」"]]},{"verse":2,"text":"見よ。神は私の救い。／私は信頼して恐れることはない。／ヤハ、主は、私の力、私のほめ歌。／私のために救いとなられた。","tok":[["見","み"],["よ"],["。"],["神","かみ"],["は"],["私","わたくし"],["の"],["救い","すくい"],["。"],["／"],["私","わたくし"],["は"],["信頼","しんらい"],["して"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["／"],["ヤハ"],["、"],["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["力","ちから"],["、"],["私","わたくし"],["の"],["ほめ歌","ほめうた"],["。"],["／"],["私","わたくし"],["の"],["ため"],["に"],["救い","すくい"],["と"],["なられた"],["。"]]},{"verse":3,"text":"あなたがたは喜びながら／救いの泉から水を汲む。","tok":[["あなた"],["がた"],["は"],["喜び","よろこび"],["ながら"],["／"],["救い","すくい"],["の"],["泉","いずみ"],["から"],["水","みず"],["を"],["汲む","くむ"],["。"]]},{"verse":4,"text":"その日、あなたがたは言う。／「主に感謝せよ。／その御名を呼び求めよ。／そのみわざを、国々の民の中に知らせよ。／御名があがめられていることを語り告げよ。","tok":[["その"],["日","ひ"],["、"],["あなた"],["がた"],["は"],["言う","ゆう"],["。"],["／"],["「"],["主に","おもに"],["感謝","かんしゃ"],["せよ"],["。"],["／"],["その"],["御名","ぎょめい"],["を"],["呼び求めよ","よびもとめよ"],["。"],["／"],["その"],["みわざ"],["を"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["知らせ","しらせ"],["よ"],["。"],["／"],["御名","ぎょめい"],["が"],["あがめられて"],["いる"],["こと"],["を"],["語り告げ","かたりつげ"],["よ"],["。"]]},{"verse":5,"text":"主をほめ歌え。／主はすばらしいことをされた。／これを、全世界に知らせよ。","tok":[["主","ぬし"],["を"],["ほめ"],["歌え","うたえ"],["。"],["／"],["主","ぬし"],["は"],["すばらしい"],["こと"],["を"],["された"],["。"],["／"],["これ"],["を"],["、"],["全","ぜん"],["世界","せかい"],["に"],["知らせ","しらせ"],["よ"],["。"]]},{"verse":6,"text":"シオンに住む者。／大声をあげて、喜び歌え。／イスラエルの聖なる方は、あなたの中におられる、大いなる方。」","tok":[["シオン"],["に"],["住む","すむ"],["者","もの"],["。"],["／"],["大声","おおごえ"],["を"],["あげて"],["、"],["喜び歌え","よろこびうたえ"],["。"],["／"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["は"],["、"],["あなた"],["の"],["中","なか"],["に"],["おられる"],["、"],["大いなる","おおいなる"],["方","かた"],["。"],["」"]]}]
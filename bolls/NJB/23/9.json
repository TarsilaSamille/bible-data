[{"verse":1,"text":"しかし、苦しみのあった所に、やみがなくなる。先にはゼブルンの地とナフタリの地は、はずかしめを受けたが、後には海沿いの道、ヨルダン川のかなた、異邦人のガリラヤは光栄を受けた。","tok":[["しかし"],["、"],["苦しみ","くるしみ"],["の"],["あった"],["所","ところ"],["に"],["、"],["やみ"],["が"],["なくなる"],["。"],["先","さき"],["に"],["は"],["ゼブルン"],["の"],["地","ち"],["と"],["ナフタリ"],["の"],["地","ち"],["は"],["、"],["はずかしめ"],["を"],["受けた","うけた"],["が"],["、"],["後","あと"],["に"],["は"],["海沿い","うみぞい"],["の"],["道","みち"],["、"],["ヨルダン"],["川","かわ"],["の"],["かなた"],["、"],["異邦人","いほうじん"],["の"],["ガリラヤ"],["は"],["光栄","こうえい"],["を"],["受けた","うけた"],["。"]]},{"verse":2,"text":"やみの中を歩んでいた民は、大きな光を見た。／死の陰の地に住んでいた者たちの上に／光が照った。","tok":[["やみ"],["の"],["中","なか"],["を"],["歩んで","あゆんで"],["いた"],["民","たみ"],["は"],["、"],["大きな","おおきな"],["光","ひかり"],["を"],["見た","みた"],["。"],["／"],["死","し"],["の"],["陰","かげ"],["の"],["地","ち"],["に"],["住んで","すんで"],["いた"],["者","もの"],["たち"],["の"],["上","うえ"],["に"],["／"],["光","ひかり"],["が"],["照った","てった"],["。"]]},{"verse":3,"text":"あなたはその国民をふやし、その喜びを増し加えられた。／彼らは刈り入れ時に喜ぶように、分捕り物を分けるときに楽しむように、あなたの御前で喜んだ。","tok":[["あなた"],["は"],["その"],["国民","こくみん"],["を"],["ふやし"],["、"],["その"],["喜び","よろこび"],["を"],["増し加えられた","ましくわえられた"],["。"],["／"],["彼","かれ"],["ら"],["は"],["刈り入れ","かりいれ"],["時","とき"],["に"],["喜ぶ","よろこぶ"],["よう"],["に"],["、"],["分","ぶん"],["捕り物","とりもの"],["を"],["分ける","わける"],["とき"],["に"],["楽しむ","たのしむ"],["よう"],["に"],["、"],["あなた"],["の"],["御前","ごぜん"],["で"],["喜んだ","よろこんだ"],["。"]]},{"verse":4,"text":"あなたが彼の重荷のくびきと、肩のむち、彼をしいたげる者の杖を、ミデヤンの日になされたように／粉々に砕かれたからだ。","tok":[["あなた"],["が"],["彼","かれ"],["の"],["重荷","おもに"],["の"],["くびき"],["と"],["、"],["肩","かた"],["の"],["むち"],["、"],["彼","かれ"],["を"],["しいたげる"],["者","もの"],["の"],["杖","つえ"],["を"],["、"],["ミデヤン"],["の"],["日","ひ"],["に"],["なされた"],["よう"],["に"],["／"],["粉々","こなごな"],["に"],["砕かれた","くだかれた"],["から"],["だ"],["。"]]},{"verse":5,"text":"戦場ではいたすべてのくつ、血にまみれた着物は、焼かれて、火のえじきとなる。","tok":[["戦場","せんじょう"],["で"],["は"],["いた"],["すべて"],["の"],["くつ"],["、"],["血","ち"],["に"],["まみれた"],["着物","きもの"],["は"],["、"],["焼かれて","やかれて"],["、"],["火","ひ"],["の"],["えじき"],["と"],["なる"],["。"]]},{"verse":6,"text":"ひとりのみどりごが、私たちのために生まれる。／ひとりの男の子が、私たちに与えられる。／主権はその肩にあり、その名は「不思議な助言者、力ある神、永遠の父、平和の君」と呼ばれる。","tok":[["ひとり"],["の"],["みどりご"],["が"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["生まれる","うまれる"],["。"],["／"],["ひとり"],["の"],["男の子","おとこのこ"],["が"],["、"],["私たち","わたしたち"],["に"],["与えられる","あたえられる"],["。"],["／"],["主権","しゅけん"],["は"],["その"],["肩","かた"],["に"],["あり"],["、"],["その"],["名","な"],["は"],["「"],["不思議","ふしぎ"],["な"],["助言者","じょげんしゃ"],["、"],["力","ちから"],["ある"],["神","かみ"],["、"],["永遠","えいえん"],["の"],["父","ちち"],["、"],["平和","へいわ"],["の"],["君","きみ"],["」"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":7,"text":"その主権は増し加わり、その平和は限りなく、ダビデの王座に着いて、その王国を治め、さばきと正義によってこれを堅く立て、これをささえる。今より、とこしえまで。／万軍の主の熱心がこれを成し遂げる。","tok":[["その"],["主権","しゅけん"],["は"],["増し","まし"],["加わり","くわわり"],["、"],["その"],["平和","へいわ"],["は"],["限りなく","かぎりなく"],["、"],["ダビデ"],["の"],["王座","おうざ"],["に"],["着いて","ついて"],["、"],["その"],["王国","おうこく"],["を"],["治め","おさめ"],["、"],["さばき"],["と"],["正義","せいぎ"],["によって"],["これ"],["を"],["堅く","かたく"],["立て","たて"],["、"],["これ"],["を"],["ささえる"],["。"],["今","いま"],["より"],["、"],["とこしえ"],["まで"],["。"],["／"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["熱心","ねっしん"],["が"],["これ"],["を"],["成し遂げる","なしとげる"],["。"]]},{"verse":8,"text":"主がヤコブに一つのことばを送られた。／それはイスラエルに落ちた。","tok":[["主","ぬし"],["が"],["ヤコブ"],["に"],["一","ひと"],["つ"],["の"],["ことば"],["を"],["送られた","おくられた"],["。"],["／"],["それ"],["は"],["イスラエル"],["に"],["落ちた","おちた"],["。"]]},{"verse":9,"text":"この民、エフライムとサマリヤに住む者たちは／みな、それを知り、高ぶり、思い上がって言う。","tok":[["この"],["民","たみ"],["、"],["エフライム"],["と"],["サマリヤ"],["に"],["住む","すむ"],["者","もの"],["たち"],["は"],["／"],["みな"],["、"],["それ"],["を"],["知り","しり"],["、"],["高ぶり","たかぶり"],["、"],["思い上がって","おもいあがって"],["言う","ゆう"],["。"]]},{"verse":10,"text":"「れんがが落ちたから、切り石で建て直そう。／いちじく桑の木が切り倒されたから、杉の木でこれに代えよう。」","tok":[["「"],["れんが"],["が"],["落ちた","おちた"],["から"],["、"],["切り石","きりいし"],["で"],["建て直そう","たてなおそう"],["。"],["／"],["いちじく"],["桑","くわ"],["の"],["木","き"],["が"],["切り倒された","きりたおされた"],["から"],["、"],["杉","すぎ"],["の"],["木","き"],["で"],["これ"],["に"],["代えよう","かえよう"],["。"],["」"]]},{"verse":11,"text":"そこで主は、レツィンに仇する者たちをのし上がらせ、その敵たちをあおりたてる。","tok":[["そこ"],["で"],["主","ぬし"],["は"],["、"],["レツィン"],["に"],["仇","あだ"],["する"],["者","もの"],["たち"],["を"],["のし上がらせ","のしあがらせ"],["、"],["その"],["敵","てき"],["たち"],["を"],["あおりたてる"],["。"]]},{"verse":12,"text":"東からはアラムが、西からはペリシテ人が、イスラエルをほおばって食らう。／それでも、御怒りは去らず、なおも、御手は伸ばされている。","tok":[["東","ひがし"],["から"],["は"],["アラム"],["が"],["、"],["西","にし"],["から"],["は"],["ペリシテ"],["人","にん"],["が"],["、"],["イスラエル"],["を"],["ほおばって"],["食らう","くらう"],["。"],["／"],["それ"],["で"],["も"],["、"],["御怒り","おいかり"],["は"],["去らず","さらず"],["、"],["なお"],["も"],["、"],["御手","おて"],["は"],["伸ばされて","のばされて"],["いる"],["。"]]},{"verse":13,"text":"しかし、この民は、自分を打った方に帰らず、万軍の主を求めなかった。","tok":[["しかし"],["、"],["この"],["民","みん"],["は"],["、"],["自分","じぶん"],["を"],["打った","うった"],["方","ほう"],["に"],["帰らず","かえらず"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["を"],["求めなかった","もとめなかった"],["。"]]},{"verse":14,"text":"そこで、主はイスラエルから、かしらも尾も、なつめやしの葉も葦も、ただ一日で切り取られた。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["イスラエル"],["から"],["、"],["かしら"],["も"],["尾","お"],["も"],["、"],["なつめやし"],["の"],["葉","は"],["も"],["葦","あし"],["も"],["、"],["ただ"],["一","いち"],["日","にち"],["で"],["切り取られた","きりとられた"],["。"]]},{"verse":15,"text":"そのかしらとは、長老や身分の高い者。／その尾とは、偽りを教える預言者。","tok":[["その"],["かしら"],["と"],["は"],["、"],["長老","ちょうろう"],["や"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["。"],["／"],["その"],["尾","お"],["と"],["は"],["、"],["偽り","いつわり"],["を"],["教える","おしえる"],["預言者","よげんしゃ"],["。"]]},{"verse":16,"text":"この民の指導者は迷わす者となり、彼らに導かれる者は惑わされる。","tok":[["この"],["民","たみ"],["の"],["指導者","しどうしゃ"],["は"],["迷わす","まよわす"],["者","もの"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["に"],["導かれる","みちびかれる"],["者","もの"],["は"],["惑わされる","まどわされる"],["。"]]},{"verse":17,"text":"それゆえ、主はその若い男たちを喜ばず、そのみなしごをも、やもめをもあわれまない。／みなが神を敬わず、悪を行い、すべての口が恥ずべきことを語っているからだ。／それでも、御怒りは去らず、なおも、御手は伸ばされている。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["その"],["若い","わかい"],["男","おとこ"],["たち"],["を"],["喜ばず","よろこばず"],["、"],["その"],["みなしご"],["を"],["も"],["、"],["やもめ"],["を"],["も"],["あわれまない"],["。"],["／"],["みな"],["が"],["神","かみ"],["を"],["敬わず","うやまわず"],["、"],["悪","あく"],["を"],["行い","おこない"],["、"],["すべて"],["の"],["口","くち"],["が"],["恥ずべき","はずべき"],["こと"],["を"],["語って","かたって"],["いる"],["から"],["だ"],["。"],["／"],["それ"],["で"],["も"],["、"],["御怒り","おいかり"],["は"],["去らず","さらず"],["、"],["なお"],["も"],["、"],["御手","おて"],["は"],["伸ばされて","のばされて"],["いる"],["。"]]},{"verse":18,"text":"悪は火のように燃えさかり、いばらとおどろをなめ尽くし、林の茂みに燃えついて、煙となって巻き上がる。","tok":[["悪","あく"],["は"],["火","ひ"],["の"],["よう"],["に"],["燃えさかり","もえさかり"],["、"],["いばら"],["と"],["おどろ"],["を"],["なめ"],["尽くし","つくし"],["、"],["林","はやし"],["の"],["茂み","しげみ"],["に"],["燃えついて","もえついて"],["、"],["煙","けむり"],["と"],["なって"],["巻き上がる","まきあがる"],["。"]]},{"verse":19,"text":"万軍の主の激しい怒りによって地は焼かれ、民は火のえじきのようになり、だれも互いにいたわり合わない。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["激しい","はげしい"],["怒り","いかり"],["によって"],["地","ち"],["は"],["焼かれ","やかれ"],["、"],["民","みん"],["は"],["火","ひ"],["の"],["えじき"],["の"],["よう"],["に"],["なり"],["、"],["だれ"],["も"],["互い","たがい"],["に"],["いたわり合わない","いたわりあわない"],["。"]]},{"verse":20,"text":"右にかぶりついても、飢え、左に食いついても、満ち足りず、おのおの自分の腕の肉を食べる。","tok":[["右","みぎ"],["に"],["かぶりついて"],["も"],["、"],["飢え","うえ"],["、"],["左","ひだり"],["に"],["食いついて","くいついて"],["も"],["、"],["満ち足りず","みちたりず"],["、"],["おのおの"],["自分","じぶん"],["の"],["腕","うで"],["の"],["肉","にく"],["を"],["食べる","たべる"],["。"]]},{"verse":21,"text":"マナセはエフライムとともに、エフライムはマナセとともに、彼らはいっしょにユダを襲う。／それでも、御怒りは去らず、なおも、御手は伸ばされている。","tok":[["マナセ"],["は"],["エフライム"],["と"],["とも"],["に"],["、"],["エフライム"],["は"],["マナセ"],["と"],["とも"],["に"],["、"],["彼","かれ"],["ら"],["は"],["いっしょ"],["に"],["ユダ"],["を"],["襲う","おそう"],["。"],["／"],["それ"],["で"],["も"],["、"],["御怒り","おいかり"],["は"],["去らず","さらず"],["、"],["なお"],["も"],["、"],["御手","おて"],["は"],["伸ばされて","のばされて"],["いる"],["。"]]}]
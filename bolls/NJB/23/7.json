[{"verse":1,"text":"ウジヤの子のヨタムの子、ユダの王アハズの時のこと、アラムの王レツィンと、イスラエルの王レマルヤの子ペカが、エルサレムに上って来てこれを攻めたが、戦いに勝てなかった。","tok":[["ウジヤ"],["の"],["子","こ"],["の"],["ヨタム"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["アハズ"],["の"],["時","とき"],["の"],["こと"],["、"],["アラム"],["の"],["王","おう"],["レツィン"],["と"],["、"],["イスラエル"],["の"],["王","おう"],["レマルヤ"],["の"],["子","こ"],["ペカ"],["が"],["、"],["エルサレム"],["に"],["上って","のぼって"],["来て","きて"],["これ"],["を"],["攻めた","せめた"],["が"],["、"],["戦い","たたかい"],["に"],["勝てなかった","かてなかった"],["。"]]},{"verse":2,"text":"ところが、「エフライムにアラムがとどまった」という報告がダビデの家に告げられた。すると、王の心も民の心も、林の木々が風で揺らぐように動揺した。","tok":[["ところ"],["が"],["、"],["「"],["エフライム"],["に"],["アラム"],["が"],["とどまった"],["」"],["と"],["いう"],["報告","ほうこく"],["が"],["ダビデ"],["の"],["家","いえ"],["に"],["告げられた","つげられた"],["。"],["する"],["と"],["、"],["王","おう"],["の"],["心","こころ"],["も"],["民","みん"],["の"],["心","こころ"],["も"],["、"],["林","はやし"],["の"],["木々","きぎ"],["が"],["風","かぜ"],["で"],["揺らぐ","ゆらぐ"],["よう"],["に"],["動揺","どうよう"],["した"],["。"]]},{"verse":3,"text":"そこで主はイザヤに仰せられた。「あなたとあなたの子シェアル・ヤシュブとは出かけて行って、布さらしの野への大路のそばにある上の池の水道の端でアハズに会い、","tok":[["そこ"],["で"],["主","ぬし"],["は"],["イザヤ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["シェアル"],["・"],["ヤシュブ"],["と"],["は"],["出かけて","でかけて"],["行って","いって"],["、"],["布","ぬの"],["さらし"],["の"],["野","の"],["へ"],["の"],["大路","おおじ"],["の"],["そば"],["に"],["ある"],["上","うえ"],["の"],["池","いけ"],["の"],["水道","すいどう"],["の"],["端","はし"],["で"],["アハズ"],["に"],["会い","あい"],["、"]]},{"verse":4,"text":"そこで彼に言え。／気をつけて、静かにしていなさい。恐れてはなりません。あなたは、これら二つの木切れの煙る燃えさし、レツィンすなわちアラムとレマルヤの子との燃える怒りに、心を弱らせてはなりません。","tok":[["そこ"],["で"],["彼","かれ"],["に"],["言え","いえ"],["。"],["／"],["気","き"],["を"],["つけて"],["、"],["静か","しずか"],["に"],["して"],["い"],["なさい"],["。"],["恐れて","おそれて"],["は"],["なりません"],["。"],["あなた"],["は"],["、"],["これ"],["ら"],["二","ふた"],["つ"],["の"],["木切れ","きぎれ"],["の"],["煙る","けむる"],["燃えさし","もえさし"],["、"],["レツィン"],["すなわち"],["アラム"],["と"],["レマルヤ"],["の"],["子","こ"],["と"],["の"],["燃える","もえる"],["怒り","いかり"],["に"],["、"],["心","こころ"],["を"],["弱らせて","よわらせて"],["は"],["なりません"],["。"]]},{"verse":5,"text":"アラムはエフライムすなわちレマルヤの子とともに、あなたに対して悪事を企ててこう言っています。","tok":[["アラム"],["は"],["エフライム"],["すなわち"],["レマルヤ"],["の"],["子","こ"],["と"],["とも"],["に"],["、"],["あなた"],["に対して","にたいして"],["悪事","あくじ"],["を"],["企てて","くわだてて"],["こう"],["言って","いって"],["います"],["。"]]},{"verse":6,"text":"『われわれはユダに上って、これを脅かし、これに攻め入り、わがものとし、タベアルの子をそこの王にしよう』と。","tok":[["『"],["われわれ"],["は"],["ユダ"],["に"],["上って","のぼって"],["、"],["これ"],["を"],["脅かし","おびやかし"],["、"],["これ"],["に"],["攻め入り","せめいり"],["、"],["わが"],["もの"],["と"],["し"],["、"],["タベアル"],["の"],["子","こ"],["を"],["そこ"],["の"],["王","おう"],["に"],["しよう"],["』"],["と"],["。"]]},{"verse":7,"text":"神である主はこう仰せられる。／『そのことは起こらないし、ありえない。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["『"],["その"],["こと"],["は"],["起こらない","おこらない"],["し"],["、"],["あり"],["えない"],["。"]]},{"verse":8,"text":"実に、アラムのかしらはダマスコ、ダマスコのかしらはレツィン。／――六十五年のうちに、エフライムは粉砕されて、もう民ではなくなる。――","tok":[["実","じつ"],["に"],["、"],["アラム"],["の"],["かしら"],["は"],["ダマスコ"],["、"],["ダマスコ"],["の"],["かしら"],["は"],["レツィン"],["。"],["／"],["―"],["―"],["六十五","ろくじゅうご"],["年","ねん"],["の"],["うち"],["に"],["、"],["エフライム"],["は"],["粉砕","ふんさい"],["されて"],["、"],["もう"],["民","たみ"],["で"],["は"],["なくなる"],["。"],["―"],["―"]]},{"verse":9,"text":"また、エフライムのかしらはサマリヤ、サマリヤのかしらはレマルヤの子。／もし、あなたがたが信じなければ、長く立つことはできない。』」","tok":[["また"],["、"],["エフライム"],["の"],["かしら"],["は"],["サマリヤ"],["、"],["サマリヤ"],["の"],["かしら"],["は"],["レマルヤ"],["の"],["子","こ"],["。"],["／"],["もし"],["、"],["あなた"],["がた"],["が"],["信じなければ","しんじなければ"],["、"],["長く","ながく"],["立つ","たつ"],["こと"],["は"],["できない"],["。"],["』"],["」"]]},{"verse":10,"text":"主は再び、アハズに告げてこう仰せられた。","tok":[["主","ぬし"],["は"],["再び","ふたたび"],["、"],["アハズ"],["に"],["告げて","つげて"],["こう"],["仰せられた","おおせられた"],["。"]]},{"verse":11,"text":"「あなたの神、主から、しるしを求めよ。よみの深み、あるいは、上の高いところから。」","tok":[["「"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["から"],["、"],["しるし"],["を"],["求めよ","もとめよ"],["。"],["よみ"],["の"],["深み","ふかみ"],["、"],["あるいは"],["、"],["上","うえ"],["の"],["高い","たかい"],["ところ"],["から"],["。"],["」"]]},{"verse":12,"text":"するとアハズは言った。「私は求めません。主を試みません。」","tok":[["する"],["と"],["アハズ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["求めません","もとめません"],["。"],["主","ぬし"],["を"],["試みません","こころみません"],["。"],["」"]]},{"verse":13,"text":"そこでイザヤは言った。「さあ、聞け。ダビデの家よ。あなたがたは、人々を煩わすのは小さなこととし、私の神までも煩わすのか。","tok":[["そこ"],["で"],["イザヤ"],["は"],["言った","いった"],["。"],["「"],["さあ"],["、"],["聞け","きけ"],["。"],["ダビデ"],["の"],["家","いえ"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["人々","ひとびと"],["を"],["煩わす","わずらわす"],["の"],["は"],["小さな","ちいさな"],["こと"],["と"],["し"],["、"],["私","わたくし"],["の"],["神","かみ"],["まで"],["も"],["煩わす","わずらわす"],["の"],["か"],["。"]]},{"verse":14,"text":"それゆえ、主みずから、あなたがたに一つのしるしを与えられる。見よ。処女がみごもっている。そして男の子を産み、その名を『インマヌエル』と名づける。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["みずから"],["、"],["あなた"],["がた"],["に"],["一","ひと"],["つ"],["の"],["しるし"],["を"],["与えられる","あたえられる"],["。"],["見","み"],["よ"],["。"],["処女","しょじょ"],["が"],["みごもって"],["いる"],["。"],["そして"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["その"],["名","な"],["を"],["『"],["インマヌエル"],["』"],["と"],["名づける","なづける"],["。"]]},{"verse":15,"text":"この子は、悪を退け、善を選ぶことを知るころまで、凝乳と蜂蜜を食べる。","tok":[["この"],["子","こ"],["は"],["、"],["悪","あく"],["を"],["退け","しりぞけ"],["、"],["善","ぜん"],["を"],["選ぶ","えらぶ"],["こと"],["を"],["知る","しる"],["ころ"],["まで"],["、"],["凝乳","ぎょうにゅう"],["と"],["蜂蜜","はちみつ"],["を"],["食べる","たべる"],["。"]]},{"verse":16,"text":"それは、まだその子が、悪を退け、善を選ぶことも知らないうちに、あなたが恐れているふたりの王の土地は、捨てられるからだ。","tok":[["それ"],["は"],["、"],["まだ"],["その"],["子","こ"],["が"],["、"],["悪","あく"],["を"],["退け","しりぞけ"],["、"],["善","ぜん"],["を"],["選ぶ","えらぶ"],["こと"],["も"],["知らない","しらない"],["うち"],["に"],["、"],["あなた"],["が"],["恐れて","おそれて"],["いる"],["ふたり"],["の"],["王","おう"],["の"],["土地","とち"],["は"],["、"],["捨てられる","すてられる"],["から"],["だ"],["。"]]},{"verse":17,"text":"主は、あなたとあなたの民とあなたの父の家に、エフライムがユダから離れた日以来、まだ来たこともない日を来させる。それは、アッシリヤの王だ。」","tok":[["主","ぬし"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["民","たみ"],["と"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["、"],["エフライム"],["が"],["ユダ"],["から"],["離れた","はなれた"],["日","ひ"],["以来","いらい"],["、"],["まだ"],["来た","きた"],["こと"],["も"],["ない"],["日","ひ"],["を"],["来させる","きたさせる"],["。"],["それ"],["は"],["、"],["アッシリヤ"],["の"],["王","おう"],["だ"],["。"],["」"]]},{"verse":18,"text":"その日になると、主はエジプトの川々の果てにいるあのはえ、アッシリヤの地にいるあの蜂に合図される。","tok":[["その"],["日","ひ"],["に"],["なる"],["と"],["、"],["主","ぬし"],["は"],["エジプト"],["の"],["川","かわ"],["々"],["の"],["果て","はて"],["に"],["いる"],["あの"],["はえ"],["、"],["アッシリヤ"],["の"],["地","ち"],["に"],["いる"],["あの"],["蜂","はち"],["に"],["合図","あいず"],["される"],["。"]]},{"verse":19,"text":"すると、彼らはやって来て、みな、険しい谷、岩の割れ目、すべてのいばらの茂み、すべての牧場に巣くう。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["やって"],["来て","きて"],["、"],["みな"],["、"],["険しい","けわしい"],["谷","たに"],["、"],["岩","いわ"],["の"],["割れ目","われめ"],["、"],["すべて"],["の"],["いばら"],["の"],["茂み","しげみ"],["、"],["すべて"],["の"],["牧場","ぼくじょう"],["に"],["巣くう","すくう"],["。"]]},{"verse":20,"text":"その日、主はユーフラテス川の向こうで雇ったかみそり、すなわち、アッシリヤの王を使って、頭と足の毛をそり、ひげまでもそり落とす。","tok":[["その"],["日","ひ"],["、"],["主","ぬし"],["は"],["ユーフラテス"],["川","かわ"],["の"],["向こう","むこう"],["で"],["雇った","やとった"],["かみそり"],["、"],["すなわち"],["、"],["アッシリヤ"],["の"],["王","おう"],["を"],["使って","つかって"],["、"],["頭","あたま"],["と"],["足","あし"],["の"],["毛","け"],["を"],["そり"],["、"],["ひげ"],["まで"],["も"],["そり落とす","そりおとす"],["。"]]},{"verse":21,"text":"その日になると、ひとりの人が雌の子牛一頭と羊二頭を飼う。","tok":[["その"],["日","ひ"],["に"],["なる"],["と"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["雌","めす"],["の"],["子牛","こうし"],["一頭","いちとう"],["と"],["羊","ひつじ"],["二頭","にとう"],["を"],["飼う","かう"],["。"]]},{"verse":22,"text":"これらが乳を多く出すので、凝乳を食べるようになる。／国のうちに残されたすべての者が／凝乳と蜂蜜を食べるようになる。","tok":[["これ"],["ら"],["が"],["乳","ちち"],["を"],["多く","おおく"],["出す","だす"],["ので"],["、"],["凝乳","ぎょうにゅう"],["を"],["食べる","たべる"],["よう"],["に"],["なる"],["。"],["／"],["国","くに"],["の"],["うち"],["に"],["残された","のこされた"],["すべて"],["の"],["者","もの"],["が"],["／"],["凝乳","ぎょうにゅう"],["と"],["蜂蜜","はちみつ"],["を"],["食べる","たべる"],["よう"],["に"],["なる"],["。"]]},{"verse":23,"text":"その日になると、ぶどう千株のある、銀千枚に値する地所もみな、いばらとおどろのものとなる。","tok":[["その"],["日","ひ"],["に"],["なる"],["と"],["、"],["ぶどう"],["千","せん"],["株","かぶ"],["の"],["ある"],["、"],["銀","ぎん"],["千枚","せんまい"],["に"],["値","あたい"],["する"],["地所","じしょ"],["も"],["みな"],["、"],["いばら"],["と"],["おどろ"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":24,"text":"全土がいばらとおどろになるので、人々は弓矢を持ってそこに行く。","tok":[["全土","ぜんど"],["が"],["いばら"],["と"],["おどろ"],["に"],["なる"],["ので"],["、"],["人々","ひとびと"],["は"],["弓矢","ゆみや"],["を"],["持って","もって"],["そこ"],["に"],["行く","いく"],["。"]]},{"verse":25,"text":"くわで耕されたすべての山も、あなたはいばらとおどろを恐れて、そこに行かない。／そこは牛の放牧地、羊の踏みつける所となる。","tok":[["くわ"],["で"],["耕された","たがやされた"],["すべて"],["の"],["山","やま"],["も"],["、"],["あなた"],["は"],["いばら"],["と"],["おどろ"],["を"],["恐れて","おそれて"],["、"],["そこ"],["に"],["行かない","いかない"],["。"],["／"],["そこ"],["は"],["牛","うし"],["の"],["放牧","ほうぼく"],["地","ち"],["、"],["羊","ひつじ"],["の"],["踏みつける","ふみつける"],["所","ところ"],["と"],["なる"],["。"]]}]
[{"verse":1,"text":"ヒゼキヤ王は、これを聞いて、自分の衣を裂き、荒布を身にまとって、主の宮に入った。","tok":[["ヒゼキヤ"],["王","おう"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["、"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["裂き","さき"],["、"],["荒布","あらめ"],["を"],["身","み"],["に"],["まとって"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["入った","はいった"],["。"]]},{"verse":2,"text":"彼は、宮内長官エルヤキム、書記シェブナ、年長の祭司たちに荒布をまとわせて、アモツの子、預言者イザヤのところに遣わした。","tok":[["彼","かれ"],["は"],["、"],["宮内","くない"],["長官","ちょうかん"],["エルヤキム"],["、"],["書記","しょき"],["シェブナ"],["、"],["年長","ねんちょう"],["の"],["祭司","さいし"],["たち"],["に"],["荒布","あらめ"],["を"],["まとわせて"],["、"],["アモツ"],["の"],["子","こ"],["、"],["預言者","よげんしゃ"],["イザヤ"],["の"],["ところ"],["に"],["遣わした","つかわした"],["。"]]},{"verse":3,"text":"彼らはイザヤに言った。「ヒゼキヤはこう言っておられます。『きょうは、苦難と、懲らしめと、侮辱の日です。子どもが生まれようとするのに、それを産み出す力がないのです。","tok":[["彼","かれ"],["ら"],["は"],["イザヤ"],["に"],["言った","いった"],["。"],["「"],["ヒゼキヤ"],["は"],["こう"],["言って","いって"],["おられます"],["。"],["『"],["きょう"],["は"],["、"],["苦難","くなん"],["と"],["、"],["懲らしめ","こらしめ"],["と"],["、"],["侮辱","ぶじょく"],["の"],["日","ひ"],["です"],["。"],["子ども","こども"],["が"],["生まれよう","うまれよう"],["と"],["する"],["のに"],["、"],["それ"],["を"],["産み出す","うみだす"],["力","ちから"],["が"],["ない"],["の"],["です"],["。"]]},{"verse":4,"text":"おそらく、あなたの神、主は、ラブ・シャケのことばを聞かれたことでしょう。彼の主君、アッシリヤの王が、生ける神をそしるために彼を遣わしたのです。あなたの神、主は、その聞かれたことばを責められますが、あなたはまだいる残りの者のため、祈りをささげてください。』」","tok":[["おそらく"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["ラブ"],["・"],["シャケ"],["の"],["ことば"],["を"],["聞かれた","きかれた"],["こと"],["でしょう"],["。"],["彼","かれ"],["の"],["主君","しゅくん"],["、"],["アッシリヤ"],["の"],["王","おう"],["が"],["、"],["生ける","いける"],["神","かみ"],["を"],["そしる"],["ため"],["に"],["彼","かれ"],["を"],["遣わした","つかわした"],["の"],["です"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["その"],["聞かれた","きかれた"],["ことば"],["を"],["責められます","せめられます"],["が"],["、"],["あなた"],["は"],["まだ"],["いる"],["残り","のこり"],["の"],["者","もの"],["の"],["ため"],["、"],["祈り","いのり"],["を"],["ささげて"],["ください"],["。"],["』"],["」"]]},{"verse":5,"text":"ヒゼキヤ王の家来たちがイザヤのもとに来たとき、","tok":[["ヒゼキヤ"],["王","おう"],["の"],["家来","けらい"],["たち"],["が"],["イザヤ"],["の"],["もと"],["に"],["来た","きた"],["とき"],["、"]]},{"verse":6,"text":"イザヤは彼らに言った。「あなたがたの主君にこう言いなさい。／主はこう仰せられる。『あなたが聞いたあのことば、アッシリヤの王の若い者たちがわたしを冒瀆したあのことばを恐れるな。","tok":[["イザヤ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["主君","しゅくん"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["／"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["が"],["聞いた","きいた"],["あの"],["ことば"],["、"],["アッシリヤ"],["の"],["王","おう"],["の"],["若い","わかい"],["者","もの"],["たち"],["が"],["わたし"],["を"],["冒瀆","ぼうとく"],["した"],["あの"],["ことば"],["を"],["恐れる","おそれる"],["な"],["。"]]},{"verse":7,"text":"今、わたしは彼のうちに一つの霊を入れる。彼は、あるうわさを聞いて、自分の国に引き揚げる。わたしは、その国で彼を剣で倒す。』」","tok":[["今","いま"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["うち"],["に"],["一","ひと"],["つ"],["の"],["霊","れい"],["を"],["入れる","いれる"],["。"],["彼","かれ"],["は"],["、"],["ある"],["うわさ"],["を"],["聞いて","きいて"],["、"],["自分","じぶん"],["の"],["国","くに"],["に"],["引き揚げる","ひきあげる"],["。"],["わたし"],["は"],["、"],["その"],["国","くに"],["で"],["彼","かれ"],["を"],["剣","けん"],["で"],["倒す","たおす"],["。"],["』"],["」"]]},{"verse":8,"text":"ラブ・シャケは退いて、リブナを攻めていたアッシリヤの王と落ち合った。王がラキシュから移動したことを聞いたからである。","tok":[["ラブ"],["・"],["シャケ"],["は"],["退いて","しりぞいて"],["、"],["リブナ"],["を"],["攻めて","せめて"],["いた"],["アッシリヤ"],["の"],["王","おう"],["と"],["落ち合った","おちあった"],["。"],["王","おう"],["が"],["ラキシュ"],["から"],["移動","いどう"],["した"],["こと"],["を"],["聞いた","きいた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"王は、クシュの王ティルハカについて、「彼はあなたと戦うために出て来ている」と聞いた。彼はそれを聞くと、使者たちをヒゼキヤに送って言った。","tok":[["王","おう"],["は"],["、"],["クシュ"],["の"],["王","おう"],["ティルハカ"],["について"],["、"],["「"],["彼","かれ"],["は"],["あなた"],["と"],["戦う","たたかう"],["ため"],["に"],["出て","でて"],["来て","きて"],["いる"],["」"],["と"],["聞いた","きいた"],["。"],["彼","かれ"],["は"],["それ"],["を"],["聞く","きく"],["と"],["、"],["使者","ししゃ"],["たち"],["を"],["ヒゼキヤ"],["に"],["送って","おくって"],["言った","いった"],["。"]]},{"verse":10,"text":"「ユダの王ヒゼキヤにこう伝えよ。『おまえの信頼するおまえの神にごまかされるな。おまえは、エルサレムはアッシリヤの王の手に渡されないと言っている。","tok":[["「"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["に"],["こう"],["伝え","つたえ"],["よ"],["。"],["『"],["おまえ"],["の"],["信頼","しんらい"],["する"],["おまえ"],["の"],["神","かみ"],["に"],["ごまかされる"],["な"],["。"],["おまえ"],["は"],["、"],["エルサレム"],["は"],["アッシリヤ"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡されない","わたされない"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":11,"text":"おまえは、アッシリヤの王たちがすべての国々にしたこと、それらを絶滅させたことを聞いている。それでも、おまえは救い出されるというのか。","tok":[["おまえ"],["は"],["、"],["アッシリヤ"],["の"],["王","おう"],["たち"],["が"],["すべて"],["の"],["国々","くにぐに"],["に"],["した"],["こと"],["、"],["それ"],["ら"],["を"],["絶滅","ぜつめつ"],["させた"],["こと"],["を"],["聞いて","きいて"],["いる"],["。"],["それ"],["で"],["も"],["、"],["おまえ"],["は"],["救い出される","すくいだされる"],["と"],["いう"],["の"],["か"],["。"]]},{"verse":12,"text":"私の先祖たちはゴザン、ハラン、レツェフ、および、テラサルにいたエデンの人々を滅ぼしたが、その国々の神々が彼らを救い出したのか。","tok":[["私","わたくし"],["の"],["先祖","せんぞ"],["たち"],["は"],["ゴザン"],["、"],["ハラン"],["、"],["レツェフ"],["、"],["および"],["、"],["テラサル"],["に"],["いた"],["エデン"],["の"],["人々","ひとびと"],["を"],["滅ぼした","ほろぼした"],["が"],["、"],["その"],["国々","くにぐに"],["の"],["神々","かみがみ"],["が"],["彼","かれ"],["ら"],["を"],["救い出した","すくいだした"],["の"],["か"],["。"]]},{"verse":13,"text":"ハマテの王、アルパデの王、セファルワイムの町の王、また、ヘナやイワの王は、どこにいるか。』」","tok":[["ハマテ"],["の"],["王","おう"],["、"],["アルパデ"],["の"],["王","おう"],["、"],["セファルワイム"],["の"],["町","まち"],["の"],["王","おう"],["、"],["また"],["、"],["ヘナ"],["や"],["イワ"],["の"],["王","おう"],["は"],["、"],["どこ"],["に"],["いる"],["か"],["。"],["』"],["」"]]},{"verse":14,"text":"ヒゼキヤは、使者の手からその手紙を受け取り、それを読み、主の宮に上って行って、それを主の前に広げた。","tok":[["ヒゼキヤ"],["は"],["、"],["使者","ししゃ"],["の"],["手","て"],["から"],["その"],["手紙","てがみ"],["を"],["受け取り","うけとり"],["、"],["それ"],["を"],["読み","よみ"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["上って","のぼって"],["行って","いって"],["、"],["それ"],["を"],["主","ぬし"],["の"],["前","まえ"],["に"],["広げた","ひろげた"],["。"]]},{"verse":15,"text":"ヒゼキヤは主に祈って言った。","tok":[["ヒゼキヤ"],["は"],["主に","おもに"],["祈って","いのって"],["言った","いった"],["。"]]},{"verse":16,"text":"「ケルビムの上に座しておられるイスラエルの神、万軍の主よ。ただ、あなただけが、地のすべての王国の神です。あなたが天と地を造られました。","tok":[["「"],["ケルビム"],["の"],["上","うえ"],["に"],["座して","ざして"],["おられる"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["。"],["ただ"],["、"],["あなた"],["だけ"],["が"],["、"],["地","ち
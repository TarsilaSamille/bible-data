[{"verse":1,"text":"国々よ。近づいて聞け。／諸国の民よ。耳を傾けよ。／地と、それに満ちるもの、世界と、そこから生え出たすべてのものよ。聞け。","tok":[["国々","くにぐに"],["よ"],["。"],["近づいて","ちかづいて"],["聞け","きけ"],["。"],["／"],["諸国","しょこく"],["の"],["民","たみ"],["よ"],["。"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["／"],["地","ち"],["と"],["、"],["それ"],["に"],["満ちる","みちる"],["もの"],["、"],["世界","せかい"],["と"],["、"],["そこ"],["から"],["生え出た","はえでた"],["すべて"],["の"],["もの"],["よ"],["。"],["聞け","きけ"],["。"]]},{"verse":2,"text":"主がすべての国に向かって怒り、すべての軍勢に向かって憤り、彼らを聖絶し、彼らが虐殺されるままにされたからだ。","tok":[["主","ぬし"],["が"],["すべて"],["の"],["国","くに"],["に"],["向かって","むかって"],["怒り","おこり"],["、"],["すべて"],["の"],["軍勢","ぐんぜい"],["に"],["向かって","むかって"],["憤り","いきどおり"],["、"],["彼","かれ"],["ら"],["を"],["聖","せい"],["絶し","ぜっし"],["、"],["彼","かれ"],["ら"],["が"],["虐殺","ぎゃくさつ"],["される"],["まま"],["に"],["された"],["から"],["だ"],["。"]]},{"verse":3,"text":"彼らの殺された者は投げやられ、その死体は悪臭を放ち、山々は、その血によって溶ける。","tok":[["彼","かれ"],["ら"],["の"],["殺された","ころされた"],["者","もの"],["は"],["投げやられ","なげやられ"],["、"],["その"],["死体","したい"],["は"],["悪臭","あくしゅう"],["を"],["放ち","はなち"],["、"],["山々","やまやま"],["は"],["、"],["その"],["血","ち"],["によって"],["溶ける","とける"],["。"]]},{"verse":4,"text":"天の万象は朽ち果て、天は巻き物のように巻かれる。／その万象は、枯れ落ちる。／ぶどうの木から葉が枯れ落ちるように。／いちじくの木から葉が枯れ落ちるように。","tok":[["天","てん"],["の"],["万象","ばんしょう"],["は"],["朽ち","くち"],["果て","はて"],["、"],["天","てん"],["は"],["巻き物","まきもの"],["の"],["よう"],["に"],["巻かれる","まかれる"],["。"],["／"],["その"],["万象","ばんしょう"],["は"],["、"],["枯れ落ちる","かれおちる"],["。"],["／"],["ぶどう"],["の"],["木","き"],["から"],["葉","は"],["が"],["枯れ落ちる","かれおちる"],["よう"],["に"],["。"],["／"],["いちじく"],["の"],["木","き"],["から"],["葉","は"],["が"],["枯れ落ちる","かれおちる"],["よう"],["に"],["。"]]},{"verse":5,"text":"天ではわたしの剣に血がしみ込んでいる。／見よ。これがエドムの上に下り、わたしが聖絶すると定めた民の上に下るからだ。","tok":[["天","てん"],["で"],["は"],["わたし"],["の"],["剣","けん"],["に"],["血","ち"],["が"],["しみ込んで","しみこんで"],["いる"],["。"],["／"],["見","み"],["よ"],["。"],["これ"],["が"],["エドム"],["の"],["上","うえ"],["に"],["下り","くだり"],["、"],["わたし"],["が"],["聖","せい"],["絶する","ぜっする"],["と"],["定めた","さだめた"],["民","たみ"],["の"],["上","うえ"],["に"],["下る","くだる"],["から"],["だ"],["。"]]},{"verse":6,"text":"主の剣は血で満ち、脂肪で肥えている。／子羊ややぎの血と、雄羊の腎臓の脂肪で肥えている。／主がボツラでいけにえをほふり、エドムの地で大虐殺をされるからだ。","tok":[["主","ぬし"],["の"],["剣","けん"],["は"],["血","ち"],["で"],["満ち","みち"],["、"],["脂肪","しぼう"],["で"],["肥えて","こえて"],["いる"],["。"],["／"],["子羊","こひつじ"],["や"],["やぎ"],["の"],["血","ち"],["と"],["、"],["雄羊","おひつじ"],["の"],["腎臓","じんぞう"],["の"],["脂肪","しぼう"],["で"],["肥えて","こえて"],["いる"],["。"],["／"],["主","ぬし"],["が"],["ボツラ"],["で"],["いけにえ"],["を"],["ほふり"],["、"],["エドム"],["の"],["地","ち"],["で"],["大虐殺","だいぎゃくさつ"],["を"],["される"],["から"],["だ"],["。"]]},{"verse":7,"text":"野牛は彼らとともに、雄牛は荒馬とともに倒れる。／彼らの地には血がしみ込み、その土は脂肪で肥える。","tok":[["野牛","やぎゅう"],["は"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["、"],["雄牛","おうし"],["は"],["荒馬","あらうま"],["と"],["とも"],["に"],["倒れる","たおれる"],["。"],["／"],["彼","かれ"],["ら"],["の"],["地","ち"],["に"],["は"],["血","ち"],["が"],["しみ込み","しみこみ"],["、"],["その"],["土","つち"],["は"],["脂肪","しぼう"],["で"],["肥える","こえる"],["。"]]},{"verse":8,"text":"それは主の復讐の日であり、シオンの訴えのために仇を返す年である。","tok":[["それ"],["は"],["主","ぬし"],["の"],["復讐","ふくしゅう"],["の"],["日","ひ"],["で"],["あり"],["、"],["シオン"],["の"],["訴え","うったえ"],["の"],["ため"],["に"],["仇","あだ"],["を"],["返す","かえす"],["年","とし"],["で"],["ある"],["。"]]},{"verse":9,"text":"エドムの川はピッチに、その土は硫黄に変わり、その地は燃えるピッチになる。","tok":[["エドム"],["の"],["川","かわ"],["は"],["ピッチ"],["に"],["、"],["その"],["土","つち"],["は"],["硫黄","いおう"],["に"],["変わり","かわり"],["、"],["その"],["地","ち"],["は"],["燃える","もえる"],["ピッチ"],["に"],["なる"],["。"]]},{"verse":10,"text":"それは夜も昼も消えず、いつまでもその煙は立ち上る。／そこは代々にわたって、廃墟となり、だれも、もうそこを通る者はない。","tok":[["それ"],["は"],["夜","よる"],["も"],["昼","ひる"],["も"],["消えず","きえず"],["、"],["いつ"],["まで"],["も"],["その"],["煙","けむり"],["は"],["立ち上る","たちのぼる"],["。"],["／"],["そこ"],["は"],["代々","だいだい"],["に"],["わたって"],["、"],["廃墟","はいきょ"],["と"],["なり"],["、"],["だれ"],["も"],["、"],["もう"],["そこ"],["を"],["通る","とおる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":11,"text":"ペリカンと針ねずみがそこをわがものとし、みみずくと烏がそこに住む。／主はその上に虚空の測りなわを張り、虚無のおもりを下げられる。","tok":[["ペリカン"],["と"],["針ねずみ","はりねずみ"],["が"],["そこ"],["を"],["わが"],["もの"],["と"],["し"],["、"],["みみずく"],["と"],["烏","からす"],["が"],["そこ"],["に"],["住む","すむ"],["。"],["／"],["主","ぬし"],["は"],["その"],["上","うえ"],["に"],["虚空","こくう"],["の"],["測り","はかり"],["なわ"],["を"],["張り","はり"],["、"],["虚無","きょむ"],["の"],["おもり"],["を"],["下げられる","さげられる"],["。"]]},{"verse":12,"text":"そのおもだった人たちのうち、王権を宣言する者が、だれもそこにはいない。／すべての首長たちもいなくなる。","tok":[["その"],["おも"],["だった"],["人","ひと"],["たち"],["の"],["うち"],["、"],["王権","おうけん"],["を"],["宣言","せんげん"],["する"],["者","もの"],["が"],["、"],["だれ"],["も"],["そこ"],["に"],["は"],["いない"],["。"],["／"],["すべて"],["の"],["首長","しゅちょう"],["たち"],["も"],["いなく"],["なる"],["。"]]},{"verse":13,"text":"そこの宮殿にはいばらが生え、要塞にはいらくさやあざみが生え、ジャッカルの住みか、だちょうの住む所となる。","tok":[["そこ"],["の"],["宮殿","きゅうでん"],["に"],["は"],["いばら"],["が"],["生え","はえ"],["、"],["要塞","ようさい"],["に"],["は"],["いらくさ"],["や"],["あざみ"],["が"],["生え","はえ"],["、"],["ジャッカル"],["の"],["住みか","すみか"],["、"],["だちょう"],["の"],["住む","すむ"],["所","ところ"],["と"],["なる"],["。"]]},{"verse":14,"text":"荒野の獣は山犬に会い、野やぎはその友を呼ぶ。／そこにはこうもりもいこい、自分の休み場を見つける。","tok":[["荒野","こうや"],["の"],["獣","けもの"],["は"],["山犬","やまいぬ"],["に"],["会い","あい"],["、"],["野やぎ","のやぎ"],["は"],["その"],["友","とも"],["を"],["呼ぶ","よぶ"],["。"],["／"],["そこ"],["に"],["は"],["こうもり"],["も"],["いこい"],["、"],["自分","じぶん"],["の"],["休み場","やすみば"],["を"],["見つける","みつける"],["。"]]},{"verse":15,"text":"蛇もそこに巣を作って卵を産み、それをかえして、自分の陰に集める。／とびもそれぞれ自分の連れ合いとそこに集まる。","tok":[["蛇","へび"],["も"],["そこ"],["に"],["巣","す"],["を"],["作って","つくって"],["卵","たまご"],["を"],["産み","うみ"],["、"],["それ"],["を"],["かえして"],["、"],["自分","じぶん"],["の"],["陰","かげ"],["に"],["集める","あつめる"],["。"],["／"],["とび"],["も"],["それぞれ"],["自分","じぶん"],["の"],["連れ合い","つれあい"],["と"],["そこ"],["に"],["集まる","あつまる"],["。"]]},{"verse":16,"text":"主の書物を調べて読め。／これらのもののうちどれも失われていない。／それぞれ自分の連れ合いを欠くものはいない。／それは、主の口がこれを命じ、主の御霊が、これらを集めたからである。","tok":[["主","ぬし"],["の"],["書物","しょもつ"],["を"],["調べて","しらべて"],["読め","よめ"],["。"],["／"],["これ"],["ら"],["の"],["もの"],["の"],["うち"],["どれ"],["も"],["失われて","うしなわれて"],["いない"],["。"],["／"],["それぞれ"],["自分","じぶん"],["の"],["連れ合い","つれあい"],["を"],["欠く","かく"],["もの"],["は"],["いない"],["。"],["／"],["それ"],["は"],["、"],["主","ぬし"],["の"],["口","くち"],["が"],["これ"],["を"],["命じ","めいじ"],["、"],["主","ぬし"],["の"],["御霊","ごれい"],["が"],["、"],["これ"],["ら"],["を"],["集めた","あつめた"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"主はこれらのもののために／受ける割り当てをくじで定め、御手が測りなわで測ってこれを分け与えたので、とこしえまでも彼らはこれを所有し、代々にわたって、ここに住む。","tok":[["主","ぬし"],["は"],["これ"],["ら"],["の"],["もの"],["の"],["ため"],["に"],["／"],["受ける","うける"],["割り当て","わりあて"],["を"],["くじ"],["で"],["定め","さだめ"],["、"],["御手","おて"],["が"],["測り","はかり"],["なわ"],["で"],["測って","はかって"],["これ"],["を"],["分け与えた","わけあたえた"],["ので"],["、"],["とこしえ"],["まで"],["も"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["所有","しょゆう"],["し"],["、"],["代々","だいだい"],["に"],["わたって"],["、"],["ここ"],["に"],["住む","すむ"],["。"]]}]
[{"verse":1,"text":"神である主の霊が、わたしの上にある。／主はわたしに油をそそぎ、貧しい者に良い知らせを伝え、心の傷ついた者をいやすために、わたしを遣わされた。／捕らわれ人には解放を、囚人には釈放を告げ、","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["霊","れい"],["が"],["、"],["わたし"],["の"],["上","うえ"],["に"],["ある"],["。"],["／"],["主","ぬし"],["は"],["わたし"],["に"],["油","あぶら"],["を"],["そそぎ"],["、"],["貧しい","まずしい"],["者","もの"],["に"],["良い","よい"],["知らせ","しらせ"],["を"],["伝え","つたえ"],["、"],["心","こころ"],["の"],["傷ついた","きずついた"],["者","もの"],["を"],["いやす"],["ため"],["に"],["、"],["わたし"],["を"],["遣わされた","つかわされた"],["。"],["／"],["捕らわれ","とらわれ"],["人","にん"],["に"],["は"],["解放","かいほう"],["を"],["、"],["囚人","しゅうじん"],["に"],["は"],["釈放","しゃくほう"],["を"],["告げ","つげ"],["、"]]},{"verse":2,"text":"主の恵みの年と、われわれの神の復讐の日を告げ、すべての悲しむ者を慰め、","tok":[["主","ぬし"],["の"],["恵み","めぐみ"],["の"],["年","とし"],["と"],["、"],["われわれ"],["の"],["神","かみ"],["の"],["復讐","ふくしゅう"],["の"],["日","ひ"],["を"],["告げ","つげ"],["、"],["すべて"],["の"],["悲しむ","かなしむ"],["者","もの"],["を"],["慰め","なぐさめ"],["、"]]},{"verse":3,"text":"シオンの悲しむ者たちに、灰の代わりに頭の飾りを、悲しみの代わりに喜びの油を、憂いの心の代わりに賛美の外套を／着けさせるためである。／彼らは、義の樫の木、栄光を現す主の植木と呼ばれよう。","tok":[["シオン"],["の"],["悲しむ","かなしむ"],["者","もの"],["たち"],["に"],["、"],["灰","はい"],["の"],["代わり","かわり"],["に"],["頭","あたま"],["の"],["飾り","かざり"],["を"],["、"],["悲しみ","かなしみ"],["の"],["代わり","かわり"],["に"],["喜び","よろこび"],["の"],["油","あぶら"],["を"],["、"],["憂い","うれい"],["の"],["心","こころ"],["の"],["代わり","かわり"],["に"],["賛美","さんび"],["の"],["外套","がいとう"],["を"],["／"],["着け","つけ"],["させる"],["ため"],["で"],["ある"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["義","ぎ"],["の"],["樫","かし"],["の"],["木","き"],["、"],["栄光","えいこう"],["を"],["現す","あらわす"],["主","ぬし"],["の"],["植木","うえき"],["と"],["呼ばれよう","よばれよう"],["。"]]},{"verse":4,"text":"彼らは昔の廃墟を建て直し、先の荒れ跡を復興し、廃墟の町々、代々の荒れ跡を一新する。","tok":[["彼","かれ"],["ら"],["は"],["昔","むかし"],["の"],["廃墟","はいきょ"],["を"],["建て直し","たてなおし"],["、"],["先","さき"],["の"],["荒れ","あれ"],["跡","あと"],["を"],["復興","ふっこう"],["し"],["、"],["廃墟","はいきょ"],["の"],["町々","まちまち"],["、"],["代々","だいだい"],["の"],["荒れ","あれ"],["跡","あと"],["を"],["一新","いっしん"],["する"],["。"]]},{"verse":5,"text":"他国人は、あなたがたの羊の群れを／飼うようになり、外国人が、あなたがたの農夫となり、ぶどう作りとなる。","tok":[["他国人","たこくにん"],["は"],["、"],["あなた"],["がた"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["／"],["飼う","かう"],["よう"],["に"],["なり"],["、"],["外国人","がいこくじん"],["が"],["、"],["あなた"],["がた"],["の"],["農夫","のうふ"],["と"],["なり"],["、"],["ぶどう"],["作り","つくり"],["と"],["なる"],["。"]]},{"verse":6,"text":"しかし、あなたがたは主の祭司ととなえられ、われわれの神に仕える者と呼ばれる。／あなたがたは国々の力を食い尽くし、その富を誇る。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["主","ぬし"],["の"],["祭司","さいし"],["と"],["となえられ"],["、"],["われわれ"],["の"],["神","かみ"],["に"],["仕える","つかえる"],["者","もの"],["と"],["呼ばれる","よばれる"],["。"],["／"],["あなた"],["がた"],["は"],["国々","くにぐに"],["の"],["力","ちから"],["を"],["食い","くい"],["尽くし","つくし"],["、"],["その"],["富","とみ"],["を"],["誇る","ほこる"],["。"]]},{"verse":7,"text":"あなたがたは恥に代えて、二倍のものを受ける。／人々は侮辱に代えて、その分け前に喜び歌う。／それゆえ、その国で二倍のものを所有し、とこしえの喜びが彼らのものとなる。","tok":[["あなた"],["がた"],["は"],["恥","はじ"],["に"],["代えて","かえて"],["、"],["二","に"],["倍","ばい"],["の"],["もの"],["を"],["受ける","うける"],["。"],["／"],["人々","ひとびと"],["は"],["侮辱","ぶじょく"],["に"],["代えて","かえて"],["、"],["その"],["分け前","わけまえ"],["に"],["喜び歌う","よろこびうたう"],["。"],["／"],["それ"],["ゆえ"],["、"],["その"],["国","くに"],["で"],["二","に"],["倍","ばい"],["の"],["もの"],["を"],["所有","しょゆう"],["し"],["、"],["とこしえ"],["の"],["喜び","よろこび"],["が"],["彼","かれ"],["ら"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":8,"text":"まことに、わたしは公義を愛する主だ。／わたしは不法な略奪を憎む。／わたしは誠実を尽くして彼らに報い、とこしえの契約を彼らと結ぶ。","tok":[["まこと"],["に"],["、"],["わたし"],["は"],["公義","きみよし"],["を"],["愛する","あいする"],["主","ぬし"],["だ"],["。"],["／"],["わたし"],["は"],["不法","ふほう"],["な"],["略奪","りゃくだつ"],["を"],["憎む","にくむ"],["。"],["／"],["わたし"],["は"],["誠実","せいじつ"],["を"],["尽くして","つくして"],["彼","かれ"],["ら"],["に"],["報い","むくい"],["、"],["とこしえ"],["の"],["契約","けいやく"],["を"],["彼","かれ"],["ら"],["と"],["結ぶ","むすぶ"],["。"]]},{"verse":9,"text":"彼らの子孫は国々のうちで、彼らのすえは国々の民のうちで知れ渡る。／彼らを見る者はみな、彼らが主に祝福された子孫であることを認める。","tok":[["彼","かれ"],["ら"],["の"],["子孫","しそん"],["は"],["国々","くにぐに"],["の"],["うち"],["で"],["、"],["彼","かれ"],["ら"],["の"],["すえ"],["は"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["うち"],["で"],["知れ渡る","しれわたる"],["。"],["／"],["彼","かれ"],["ら"],["を"],["見る","みる"],["者","もの"],["は"],["みな"],["、"],["彼","かれ"],["ら"],["が"],["主に","おもに"],["祝福","しゅくふく"],["された"],["子孫","しそん"],["で"],["ある"],["こと"],["を"],["認める","みとめる"],["。"]]},{"verse":10,"text":"わたしは主によって大いに楽しみ、わたしのたましいも、わたしの神によって喜ぶ。／主がわたしに、救いの衣を着せ、正義の外套をまとわせ、花婿のように栄冠をかぶらせ、花嫁のように宝玉で飾ってくださるからだ。","tok":[["わたし"],["は"],["主に","おもに"],["よって"],["大いに","おおいに"],["楽しみ","たのしみ"],["、"],["わたし"],["の"],["たましい"],["も"],["、"],["わたし"],["の"],["神","かみ"],["によって"],["喜ぶ","よろこぶ"],["。"],["／"],["主","ぬし"],["が"],["わたし"],["に"],["、"],["救い","すくい"],["の"],["衣","ころも"],["を"],["着せ","きせ"],["、"],["正義","せいぎ"],["の"],["外套","がいとう"],["を"],["まとわせ"],["、"],["花婿","はなむこ"],["の"],["よう"],["に"],["栄冠","えいかん"],["を"],["かぶらせ"],["、"],["花嫁","はなよめ"],["の"],["よう"],["に"],["宝玉","ほうぎょく"],["で"],["飾って","かざって"],["くださる"],["から"],["だ"],["。"]]},{"verse":11,"text":"地が芽を出し、園が蒔かれた種を芽ばえさせるように、神である主が義と賛美とを、すべての国の前に芽ばえさせるからだ。","tok":[["地","ち"],["が"],["芽","め"],["を"],["出し","だし"],["、"],["園","その"],["が"],["蒔かれた","まかれた"],["種","たね"],["を"],["芽ばえさせる","めばえさせる"],["よう"],["に"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["義","ぎ"],["と"],["賛美","さんび"],["と"],["を"],["、"],["すべて"],["の"],["国","くに"],["の"],["前","まえ"],["に"],["芽ばえさせる","めばえさせる"],["から"],["だ"],["。"]]}]
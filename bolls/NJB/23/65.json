[{"verse":1,"text":"わたしに問わなかった者たちに、わたしは尋ねられ、わたしを捜さなかった者たちに、見つけられた。／わたしは、わたしの名を呼び求めなかった国民に向かって、「わたしはここだ、わたしはここだ」と言った。","tok":[["わたし"],["に"],["問わなかった","とわなかった"],["者","もの"],["たち"],["に"],["、"],["わたし"],["は"],["尋ねられ","たずねられ"],["、"],["わたし"],["を"],["捜さなかった","さがさなかった"],["者","もの"],["たち"],["に"],["、"],["見つけられた","みつけられた"],["。"],["／"],["わたし"],["は"],["、"],["わたし"],["の"],["名","な"],["を"],["呼び求めなかった","よびもとめなかった"],["国民","こくみん"],["に"],["向かって","むかって"],["、"],["「"],["わたし"],["は"],["ここ"],["だ"],["、"],["わたし"],["は"],["ここ"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"わたしは、反逆の民、自分の思いに従って良くない道を歩む者たちに、一日中、わたしの手を差し伸べた。","tok":[["わたし"],["は"],["、"],["反逆","はんぎゃく"],["の"],["民","たみ"],["、"],["自分","じぶん"],["の"],["思い","おもい"],["に"],["従って","したがって"],["良く","よく"],["ない"],["道","みち"],["を"],["歩む","あゆむ"],["者","もの"],["たち"],["に"],["、"],["一","いち"],["日中","にちちゅう"],["、"],["わたし"],["の"],["手","て"],["を"],["差し伸べた","さしのべた"],["。"]]},{"verse":3,"text":"この民は、いつもわたしに逆らって／わたしの怒りを引き起こし、園の中でいけにえをささげ、れんがの上で香をたき、","tok":[["この"],["民","みん"],["は"],["、"],["いつも"],["わたし"],["に"],["逆らって","さからって"],["／"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こし","ひきおこし"],["、"],["園","その"],["の"],["中","なか"],["で"],["いけにえ"],["を"],["ささげ"],["、"],["れんが"],["の"],["上","うえ"],["で"],["香","こう"],["を"],["たき"],["、"]]},{"verse":4,"text":"墓地にすわり、見張り小屋に宿り、豚の肉を食べ、汚れた肉の吸い物を器に入れ、","tok":[["墓地","ぼち"],["に"],["すわり"],["、"],["見張り","みはり"],["小屋","こや"],["に"],["宿り","やどり"],["、"],["豚","ぶた"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["汚れた","よごれた"],["肉","にく"],["の"],["吸い物","すいもの"],["を"],["器","うつわ"],["に"],["入れ","いれ"],["、"]]},{"verse":5,"text":"「そこに立っておれ。私に近寄るな。／私はあなたより／聖なるものになっている」と言う。／「これらは、わたしの怒りの煙、一日中燃え続ける火である。","tok":[["「"],["そこ"],["に"],["立って","たって"],["おれ"],["。"],["私","わたくし"],["に"],["近寄る","ちかよる"],["な"],["。"],["／"],["私","わたくし"],["は"],["あなた"],["より"],["／"],["聖","せい"],["なる"],["もの"],["に"],["なって"],["いる"],["」"],["と"],["言う","ゆう"],["。"],["／"],["「"],["これ"],["ら"],["は"],["、"],["わたし"],["の"],["怒り","いかり"],["の"],["煙","けむり"],["、"],["一","いち"],["日中","にちちゅう"],["燃え","もえ"],["続ける","つづける"],["火","ひ"],["で"],["ある"],["。"]]},{"verse":6,"text":"見よ。これは、わたしの前に書かれている。／わたしは黙っていない。必ず報復する。／わたしは彼らのふところに報復する。――","tok":[["見","み"],["よ"],["。"],["これ"],["は"],["、"],["わたし"],["の"],["前","まえ"],["に"],["書かれて","かかれて"],["いる"],["。"],["／"],["わたし"],["は"],["黙って","だまって"],["いない"],["。"],["必ず","かならず"],["報復","ほうふく"],["する"],["。"],["／"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ふところ"],["に"],["報復","ほうふく"],["する"],["。"],["―"],["―"]]},{"verse":7,"text":"山の上で香をたき、丘の上でわたしをそしったあなたがたの咎と、あなたがたの先祖の咎とをともどもに。／わたしは、彼らの先のしわざを量って、彼らのふところに、報復する」と主は仰せられる。","tok":[["山","やま"],["の"],["上","うえ"],["で"],["香","こう"],["を"],["たき"],["、"],["丘","おか"],["の"],["上","うえ"],["で"],["わたし"],["を"],["そしった"],["あなた"],["がた"],["の"],["咎","とが"],["と"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["咎","とが"],["と"],["を"],["ともども"],["に"],["。"],["／"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["先","さき"],["の"],["しわざ"],["を"],["量って","はかって"],["、"],["彼","かれ"],["ら"],["の"],["ふところ"],["に"],["、"],["報復","ほうふく"],["する"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":8,"text":"主はこう仰せられる。／「ぶどうのふさの中に甘い汁があるのを見れば、『それをそこなうな。その中に祝福があるから』／と言うように、わたしも、わたしのしもべたちのために、その全部は滅ぼさない。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["ぶどう"],["の"],["ふさ"],["の"],["中","なか"],["に"],["甘い","あまい"],["汁","しる"],["が"],["ある"],["の"],["を"],["見れば","みれば"],["、"],["『"],["それ"],["を"],["そこなう"],["な"],["。"],["その"],["中","なか"],["に"],["祝福","しゅくふく"],["が"],["ある"],["から"],["』"],["／"],["と"],["言う","いう"],["よう"],["に"],["、"],["わたし"],["も"],["、"],["わたし"],["の"],["しもべ"],["たち"],["の"],["ため"],["に"],["、"],["その"],["全部","ぜんぶ"],["は"],["滅ぼさない","ほろぼさない"],["。"]]},{"verse":9,"text":"わたしは、ヤコブから子孫を、ユダからわたしの山々を所有する者を／生まれさせよう。／わたしの選んだ者がこれを所有し、わたしのしもべたちがそこに住む。","tok":[["わたし"],["は"],["、"],["ヤコブ"],["から"],["子孫","しそん"],["を"],["、"],["ユダ"],["から"],["わたし"],["の"],["山々","やまやま"],["を"],["所有","しょゆう"],["する"],["者","もの"],["を"],["／"],["生まれさせよう","うまれさせよう"],["。"],["／"],["わたし"],["の"],["選んだ","えらんだ"],["者","もの"],["が"],["これ"],["を"],["所有","しょゆう"],["し"],["、"],["わたし"],["の"],["しもべ"],["たち"],["が"],["そこ"],["に"],["住む","すむ"],["。"]]},{"verse":10,"text":"わたしを求めたわたしの民にとって、シャロンは羊の群れの牧場、アコルの谷は牛の群れの伏す所となる。","tok":[["わたし"],["を"],["求めた","もとめた"],["わたし"],["の"],["民","たみ"],["にとって"],["、"],["シャロン"],["は"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["牧場","ぼくじょう"],["、"],["アコル"],["の"],["谷","たに"],["は"],["牛","うし"],["の"],["群れ","むれ"],["の"],["伏す","ふす"],["所","ところ"],["と"],["なる"],["。"]]},{"verse":11,"text":"しかし、あなたがた、主を捨てる者、わたしの聖なる山を忘れる者、ガドのために食卓を整える者、メニのために、混ぜ合わせた酒を盛る者たちよ。","tok":[["しかし"],["、"],["あなた"],["がた"],["、"],["主","ぬし"],["を"],["捨てる","すてる"],["者","もの"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["を"],["忘れる","わすれる"],["者","もの"],["、"],["ガド"],["の"],["ため"],["に"],["食卓","しょくたく"],["を"],["整える","ととのえる"],["者","もの"],["、"],["メニ"],["の"],["ため"],["に"],["、"],["混ぜ合わせた","まぜあわせた"],["酒","さけ"],["を"],["盛る","もる"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":12,"text":"わたしはあなたがたを剣に渡す。／それであなたがたはみな、虐殺されて倒れる。／わたしが呼んでも答えず、わたしが語りかけても聞かず、わたしの目の前に悪を行い、わたしの喜ばない事を選んだからだ。」","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["剣","けん"],["に"],["渡す","わたす"],["。"],["／"],["それ"],["で"],["あなた"],["がた"],["は"],["みな"],["、"],["虐殺","ぎゃくさつ"],["されて"],["倒れる","たおれる"],["。"],["／"],["わたし"],["が"],["呼んで","よんで"],["も"],["答えず","こたえず"],["、"],["わたし"],["が"],["語りかけて","かたりかけて"],["も"],["聞かず","きかず"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行い","おこない"],["、"],["わたし"],["の"],["喜ばない","よろこばない"],["事","こと"],["を"],["選んだ","えらんだ"],["から"],["だ"],["。"],["」"]]},{"verse":13,"text":"それゆえ、神である主はこう仰せられる。／「見よ。わたしのしもべたちは食べる。／しかし、あなたがたは飢える。／見よ。わたしのしもべたちは飲む。／しかし、あなたがたは渇く。／見よ。わたしのしもべたちは喜ぶ。／しかし、あなたがたは恥を見る。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["見","み"],["よ"],["。"],["わたし"],["の"],["しもべ"],["たち"],["は"],["食べる","たべる"],["。"],["／"],["しかし"],["、"],["あなた"],["がた"],["は"],["飢える","うえる"],["。"],["／"],["見","み"],["よ"],["。"],["わたし"],["の"],["しもべ"],["たち"],["は"],["飲む","のむ"],["。"],["／"],["しかし"],["、"],["あなた"],["がた"],["は"],["渇く","かわく"],["。"],["／"],["見","み"],["よ"],["。"],["わたし"],["の"],["しもべ"],["たち"],["は"],["喜ぶ","よろこぶ"],["。"],["／"],["しかし"],["、"],["あなた"],["がた"],["は"],["恥","はじ"],["を"],["見る","みる"],["。"]]},{"verse":14,"text":"見よ。わたしのしもべたちは／心の楽しみによって喜び歌う。／しかし、あなたがたは心の痛みによって叫び、たましいの傷によって泣きわめく。","tok":[["見","み"],["よ"],["。"],["わたし"],["の"],["しもべ"],["たち"],["は"],["／"],["心","こころ"],["の"],["楽しみ","たのしみ"],["によって"],["喜び歌う","よろこびうたう"],["。"],["／"],["しかし"],["、"],["あなた"],["がた"],["は"],["心","こころ"],["の"],["痛み","いたみ"],["によって"],["叫び","さけび"],["、"],["たましい"],["の"],["傷","きず"],["によって"],["泣きわめく","なきわめく"],["。"]]},{"verse":15,"text":"あなたがたは自分の名を、わたしの選んだ者たちののろいとして残す。／それで神である主は、あなたがたを殺される。／ご自分のしもべたちを、ほかの名で呼ばれるようにされる。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["名","な"],["を"],["、"],["わたし"],["の"],["選んだ","えらんだ"],["者","もの"],["たち"],["の"],["のろい"],["として"],["残す","のこす"],["。"],["／"],["それ"],["で"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["を"],["殺される","ころされる"],["。"],["／"],["ご自分","ごじぶん"],["の"],["しもべ"],["たち"],["を"],["、"],["ほか"],["の"],["名","な"],["で"],["呼ばれる","よばれる"],["よう"],["に"],["される"],["。"]]},{"verse":16,"text":"この世にあって祝福される者は、まことの神によって祝福され、この世にあって誓う者は、まことの神によって誓う。／先の苦難は忘れられ、わたしの目から隠されるからだ。","tok":[["この世","このよ"],["に"],["あって"],["祝福","しゅくふく"],["される"],["者","もの"],["は"],["、"],["まこと"],["の"],["神","かみ"],["によって"],["祝福","しゅくふく"],["され"],["、"],["この世","このよ"],["に"],["あって"],["誓う","ちかう"],["者","もの"],["は"],["、"],["まこと"],["の"],["神","かみ"],["によって"],["誓う","ちかう"],["。"],["／"],["先","さき"],["の"],["苦難","くなん"],["は"],["忘れられ","わすれられ"],["、"],["わたし"],["の"],["目","め"],["から"],["隠される","かくされる"],["から"],["だ"],["。"]]},{"verse":17,"text":"見よ。まことにわたしは新しい天と新しい地を／創造する。／先の事は思い出されず、心に上ることもない。","tok":[["見","み"],["よ"],["。"],["まこと"],["に"],["わたし"],["は"],["新しい","あたらしい"],["天","てん"],["と"],["新しい","あたらしい"],["地","ち"],["を"],["／"],["創造","そうぞう"],["する"],["。"],["／"],["先","さき"],["の"],["事","こと"],["は"],["思い出されず","おもいだされず"],["、"],["心","こころ"],["に"],["上る","のぼる"],["こと"],["も"],["ない"],["。"]]},{"verse":18,"text":"だから、わたしの創造するものを、いついつまでも楽しみ喜べ。／見よ。わたしはエルサレムを創造して喜びとし、その民を楽しみとする。","tok":[["だ"],["から"],["、"],["わたし"],["の"],["創造","そうぞう"],["する"],["もの"],["を"],["、"],["いついつ"],["まで"],["も"],["楽しみ","たのしみ"],["喜べ","よろこべ"],["。"],["／"],["見","み"],["よ"],["。"],["わたし"],["は"],["エルサレム"],["を"],["創造","そうぞう"],["して"],["喜び","よろこび"],["と"],["し"],["、"],["その"],["民","たみ"],["を"],["楽しみ","たのしみ"],["と"],["する"],["。"]]},{"verse":19,"text":"わたしはエルサレムを喜び、わたしの民を楽しむ。／そこにはもう、泣き声も叫び声も聞かれない。","tok":[["わたし"],["は"],["エルサレム"],["を"],["喜び","よろこび"],["、"],["わたし"],["の"],["民","たみ"],["を"],["楽しむ","たのしむ"],["。"],["／"],["そこ"],["に"],["は"],["もう"],["、"],["泣き声","なきごえ"],["も"],["叫び声","さけびごえ"],["も"],["聞かれない","きかれない"],["。"]]},{"verse":20,"text":"そこにはもう、数日しか生きない乳飲み子も、寿命の満ちない老人もない。／百歳で死ぬ者は若かったとされ、百歳にならないで死ぬ者は、のろわれた者とされる。","tok":[["そこ"],["に"],["は"],["もう"],["、"],["数日","すうじつ"],["しか"],["生きない","いきない"],["乳飲み子","ちのみご"],["も"],["、"],["寿命","じゅみょう"],["の"],["満ちない","みちない"],["老人","ろうじん"],["も"],["ない"],["。"],["／"],["百歳","ひゃくさい"],["で"],["死ぬ","しぬ"],["者","もの"],["は"],["若かった","わかかった"],["と"],["され"],["、"],["百歳","ひゃくさい"],["に"],["ならないで"],["死ぬ","しぬ"],["者","もの"],["は"],["、"],["のろわれた"],["者","もの"],["と"],["される"],["。"]]},{"verse":21,"text":"彼らは家を建てて住み、ぶどう畑を作って、その実を食べる。","tok":[["彼","かれ"],["ら"],["は"],["家","いえ"],["を"],["建てて","たてて"],["住み","すみ"],["、"],["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["、"],["その"],["実","じつ"],["を"],["食べる","たべる"],["。"]]},{"verse":22,"text":"彼らが建てて他人が住むことはなく、彼らが植えて他人が食べることはない。／わたしの民の寿命は、木の寿命に等しく、わたしの選んだ者は、自分の手で作った物を／存分に用いることができるからだ。","tok":[["彼","かれ"],["ら"],["が"],["建てて","たてて"],["他人","たにん"],["が"],["住む","すむ"],["こと"],["は"],["なく"],["、"],["彼","かれ"],["ら"],["が"],["植えて","うえて"],["他人","たにん"],["が"],["食べる","たべる"],["こと"],["は"],["ない"],["。"],["／"],["わたし"],["の"],["民","たみ"],["の"],["寿命","じゅみょう"],["は"],["、"],["木","き"],["の"],["寿命","じゅみょう"],["に"],["等しく","ひとしく"],["、"],["わたし"],["の"],["選んだ","えらんだ"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["作った","つくった"],["物","もの"],["を"],["／"],["存分","ぞんぶん"],["に"],["用いる","もちいる"],["こと"],["が"],["できる"],["から"],["だ"],["。"]]},{"verse":23,"text":"彼らはむだに労することもなく、子を産んで、突然その子が死ぬこともない。／彼らは主に祝福された者のすえであり、その子孫たちは彼らとともにいるからだ。","tok":[["彼","かれ"],["ら"],["は"],["むだ"],["に"],["労する","ろうする"],["こと"],["も"],["なく"],["、"],["子","こ"],["を"],["産んで","うんで"],["、"],["
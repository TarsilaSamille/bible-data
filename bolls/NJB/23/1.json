[{"verse":1,"text":"アモツの子イザヤの幻。これは彼が、ユダとエルサレムについて、ユダの王ウジヤ、ヨタム、アハズ、ヒゼキヤの時代に見たものである。","tok":[["アモツ"],["の"],["子","こ"],["イザヤ"],["の"],["幻","まぼろし"],["。"],["これ"],["は"],["彼","かれ"],["が"],["、"],["ユダ"],["と"],["エルサレム"],["について"],["、"],["ユダ"],["の"],["王","おう"],["ウジヤ"],["、"],["ヨタム"],["、"],["アハズ"],["、"],["ヒゼキヤ"],["の"],["時代","じだい"],["に"],["見た","みた"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"天よ、聞け。地も耳を傾けよ。／主が語られるからだ。／「子らはわたしが大きくし、育てた。／しかし彼らはわたしに逆らった。","tok":[["天","てん"],["よ"],["、"],["聞け","きけ"],["。"],["地","ち"],["も"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["／"],["主","ぬし"],["が"],["語られる","かたられる"],["から"],["だ"],["。"],["／"],["「"],["子","こ"],["ら"],["は"],["わたし"],["が"],["大きく","おおきく"],["し"],["、"],["育てた","そだてた"],["。"],["／"],["しかし"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["逆らった","さからった"],["。"]]},{"verse":3,"text":"牛はその飼い主を、ろばは持ち主の飼葉おけを知っている。／それなのに、イスラエルは知らない。／わたしの民は悟らない。」","tok":[["牛","うし"],["は"],["その"],["飼い主","かいぬし"],["を"],["、"],["ろば"],["は"],["持ち主","もちぬし"],["の"],["飼葉","かいば"],["おけ"],["を"],["知って","しって"],["いる"],["。"],["／"],["それ"],["な"],["のに"],["、"],["イスラエル"],["は"],["知らない","しらない"],["。"],["／"],["わたし"],["の"],["民","たみ"],["は"],["悟らない","さとらない"],["。"],["」"]]},{"verse":4,"text":"ああ。罪を犯す国、咎重き民、悪を行う者どもの子孫、堕落した子ら。／彼らは主を捨て、イスラエルの聖なる方を侮り、背を向けて離れ去った。","tok":[["ああ"],["。"],["罪","つみ"],["を"],["犯す","おかす"],["国","くに"],["、"],["咎","とが"],["重き民","おもきみん"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["ども"],["の"],["子孫","しそん"],["、"],["堕落","だらく"],["した"],["子","こ"],["ら"],["。"],["／"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["を"],["捨て","すて"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["を"],["侮り","あなどり"],["、"],["背","せ"],["を"],["向けて","むけて"],["離れ去った","はなれさった"],["。"]]},{"verse":5,"text":"あなたがたは、なおも／どこを打たれようというのか。／反逆に反逆を重ねて。／頭は残すところなく病にかかり、心臓もすっかり弱り果てている。","tok":[["あなた"],["がた"],["は"],["、"],["なお"],["も"],["／"],["どこ"],["を"],["打たれよう","うたれよう"],["と"],["いう"],["の"],["か"],["。"],["／"],["反逆","はんぎゃく"],["に"],["反逆","はんぎゃく"],["を"],["重ねて","かさねて"],["。"],["／"],["頭","あたま"],["は"],["残す","のこす"],["ところ"],["なく"],["病","やまい"],["に"],["かかり"],["、"],["心臓","しんぞう"],["も"],["すっかり"],["弱り","よわり"],["果てて","はてて"],["いる"],["。"]]},{"verse":6,"text":"足の裏から頭まで、健全なところはなく、傷と、打ち傷と、打たれた生傷。／絞り出してももらえず、包んでももらえず、油で和らげてももらえない。","tok":[["足","あし"],["の"],["裏","うら"],["から"],["頭","あたま"],["まで"],["、"],["健全","けんぜん"],["な"],["ところ"],["は"],["なく"],["、"],["傷","きず"],["と"],["、"],["打ち傷","うちきず"],["と"],["、"],["打たれた","うたれた"],["生傷","なまきず"],["。"],["／"],["絞り出して","しぼりだして"],["も"],["もらえず"],["、"],["包んで","つつんで"],["も"],["もらえず"],["、"],["油","あぶら"],["で"],["和らげて","やわらげて"],["も"],["もらえない"],["。"]]},{"verse":7,"text":"あなたがたの国は荒れ果てている。／あなたがたの町々は火で焼かれ、畑は、あなたがたの前で、他国人が食い荒らし、他国人の破滅にも似て荒れ果てている。","tok":[["あなた"],["がた"],["の"],["国","くに"],["は"],["荒れ果てて","あれはてて"],["いる"],["。"],["／"],["あなた"],["がた"],["の"],["町々","まちまち"],["は"],["火","ひ"],["で"],["焼かれ","やかれ"],["、"],["畑","はたけ"],["は"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["で"],["、"],["他国人","たこくにん"],["が"],["食い荒らし","くいあらし"],["、"],["他国人","たこくにん"],["の"],["破滅","はめつ"],["に"],["も"],["似て","にて"],["荒れ果てて","あれはてて"],["いる"],["。"]]},{"verse":8,"text":"しかし、シオンの娘は残された。／あたかもぶどう畑の小屋のように、きゅうり畑の番小屋のように、包囲された町のように。","tok":[["しかし"],["、"],["シオン"],["の"],["娘","むすめ"],["は"],["残された","のこされた"],["。"],["／"],["あたかも"],["ぶどう"],["畑","はたけ"],["の"],["小屋","こや"],["の"],["よう"],["に"],["、"],["きゅうり"],["畑","はたけ"],["の"],["番小屋","ばんごや"],["の"],["よう"],["に"],["、"],["包囲","ほうい"],["された"],["町","まち"],["の"],["よう"],["に"],["。"]]},{"verse":9,"text":"もしも、万軍の主が、少しの生き残りの者を／私たちに残されなかったら、私たちもソドムのようになり、ゴモラと同じようになっていた。","tok":[["もし"],["も"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["、"],["少し","すこし"],["の"],["生き残り","いきのこり"],["の"],["者","もの"],["を"],["／"],["私たち","わたしたち"],["に"],["残されなかったら","のこされなかったら"],["、"],["私たち","わたしたち"],["も"],["ソドム"],["の"],["よう"],["に"],["なり"],["、"],["ゴモラ"],["と"],["同じ","おなじ"],["よう"],["に"],["なって"],["いた"],["。"]]},{"verse":10,"text":"聞け。ソドムの首領たち。主のことばを。／耳を傾けよ。ゴモラの民。／私たちの神のみおしえに。","tok":[["聞け","きけ"],["。"],["ソドム"],["の"],["首領","しゅりょう"],["たち"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["。"],["／"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["ゴモラ"],["の"],["民","たみ"],["。"],["／"],["私たち","わたしたち"],["の"],["神","かみ"],["のみ"],["おしえ"],["に"],["。"]]},{"verse":11,"text":"「あなたがたの多くのいけにえは、わたしに何になろう」と、主は仰せられる。／「わたしは、雄羊の全焼のいけにえや、肥えた家畜の脂肪に飽きた。／雄牛、子羊、雄やぎの血も喜ばない。","tok":[["「"],["あなた"],["がた"],["の"],["多く","おおく"],["の"],["いけにえ"],["は"],["、"],["わたし"],["に"],["何","なん"],["に"],["なろう"],["」"],["と"],["、"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["／"],["「"],["わたし"],["は"],["、"],["雄羊","おひつじ"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["や"],["、"],["肥えた","こえた"],["家畜","かちく"],["の"],["脂肪","しぼう"],["に"],["飽きた","あきた"],["。"],["／"],["雄牛","おうし"],["、"],["子羊","こひつじ"],["、"],["雄","おす"],["やぎ"],["の"],["血","ち"],["も"],["喜ばない","よろこばない"],["。"]]},{"verse":12,"text":"あなたがたは、わたしに会いに出て来るが、だれが、わたしの庭を踏みつけよ、と／あなたがたに求めたのか。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["に"],["会い","あい"],["に"],["出て","でて"],["来る","くる"],["が"],["、"],["だれ"],["が"],["、"],["わたし"],["の"],["庭","にわ"],["を"],["踏みつけよ","ふみつけよ"],["、"],["と"],["／"],["あなた"],["がた"],["に"],["求めた","もとめた"],["の"],["か"],["。"]]},{"verse":13,"text":"もう、むなしいささげ物を携えて来るな。／香の煙――それもわたしの忌みきらうもの。／新月の祭りと安息日――会合の召集、不義と、きよめの集会、これにわたしは耐えられない。","tok":[["もう"],["、"],["むなしい"],["ささげ物","ささげもの"],["を"],["携えて","たずさえて"],["来る","くる"],["な"],["。"],["／"],["香","こう"],["の"],["煙","けむり"],["―"],["―"],["それ"],["も"],["わたし"],["の"],["忌みきらう","いみきらう"],["もの"],["。"],["／"],["新月","しんげつ"],["の"],["祭り","まつり"],["と"],["安息","あんそく"],["日","にち"],["―"],["―"],["会合","かいごう"],["の"],["召集","しょうしゅう"],["、"],["不義","ふぎ"],["と"],["、"],["きよめ"],["の"],["集会","しゅうかい"],["、"],["これ"],["に"],["わたし"],["は"],["耐えられない","たえられない"],["。"]]},{"verse":14,"text":"あなたがたの新月の祭りや例祭を、わたしの心は憎む。／それはわたしの重荷となり、わたしは負うのに疲れ果てた。","tok":[["あなた"],["がた"],["の"],["新月","しんげつ"],["の"],["祭り","まつり"],["や"],["例祭","れいさい"],["を"],["、"],["わたし"],["の"],["心","こころ"],["は"],["憎む","にくむ"],["。"],["／"],["それ"],["は"],["わたし"],["の"],["重荷","おもに"],["と"],["なり"],["、"],["わたし"],["は"],["負う","おう"],["のに"],["疲れ","つかれ"],["果てた","はてた"],["。"]]},{"verse":15,"text":"あなたがたが手を差し伸べて祈っても、わたしはあなたがたから目をそらす。／どんなに祈りを増し加えても、聞くことはない。／あなたがたの手は血まみれだ。","tok":[["あなた"],["がた"],["が"],["手","て"],["を"],["差し伸べて","さしのべて"],["祈って","いのって"],["も"],["、"],["わたし"],["は"],["あなた"],["がた"],["から"],["目","め"],["を"],["そらす"],["。"],["／"],["どんな"],["に"],["祈り","いのり"],["を"],["増し加えて","ましくわえて"],["も"],["、"],["聞く","きく"],["こと"],["は"],["ない"],["。"],["／"],["あなた"],["がた"],["の"],["手","て"],["は"],["血まみれ","ちまみれ"],["だ"],["。"]]},{"verse":16,"text":"洗え。身をきよめよ。／わたしの前で、あなたがたの悪を取り除け。／悪事を働くのをやめよ。","tok":[["洗え","あらえ"],["。"],["身","み"],["を"],["きよめよ"],["。"],["／"],["わたし"],["の"],["前","まえ"],["で"],["、"],["あなた"],["がた"],["の"],["悪","あく"],["を"],["取り除け","とりのぞけ"],["。"],["／"],["悪事","あくじ"],["を"],["働く","はたらく"],["の"],["を"],["やめよ"],["。"]]},{"verse":17,"text":"善をなすことを習い、公正を求め、しいたげる者を正し、みなしごのために正しいさばきをなし、やもめのために弁護せよ。」","tok":[["善","ぜん"],["を"],["なす"],["こと"],["を"],["習い","ならい"],["、"],["公正","こうせい"],["を"],["求め","もとめ"],["、"],["しいたげる"],["者","もの"],["を"],["正し","ただし"],["、"],["みなしご"],["の"],["ため"],["に"],["正しい","ただしい"],["さばき"],["を"],["なし"],["、"],["やもめ"],["の"],["ため"],["に"],["弁護","べんご"],["せよ"],["。"],["」"]]},{"verse":18,"text":"「さあ、来たれ。論じ合おう」と主は仰せられる。／「たとい、あなたがたの罪が緋のように赤くても、雪のように白くなる。／たとい、紅のように赤くても、羊の毛のようになる。","tok":[["「"],["さあ"],["、"],["来たれ","きたれ"],["。"],["論じ合おう","ろんじあおう"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["／"],["「"],["たとい"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["が"],["緋","ひ"],["の"],["よう"],["に"],["赤くて","あかくて"],["も"],["、"],["雪","ゆき"],["の"],["よう"],["に"],["白く","しろく"],["なる"],["。"],["／"],["たとい"],["、"],["紅","くれない"],["の"],["よう"],["に"],["赤くて","あかくて"],["も"],["、"],["羊","ひつじ"],["の"],["毛","け"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":19,"text":"もし喜んで聞こうとするなら、あなたがたは、この国の良い物を食べることができる。","tok":[["もし"],["喜んで","よろこんで"],["聞こう","きこう"],["と"],["するなら"],["、"],["あなた"],["がた"],["は"],["、"],["この"],["国","くに"],["の"],["良い","よい"],["物","もの"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":20,"text":"しかし、もし拒み、そむくなら、あなたがたは剣にのまれる」と、主の御口が語られたからである。","tok":[["しかし"],["、"],["もし"],["拒み","こばみ"],["、"],["そむくなら"],["、"],["あなた"],["がた"],["は"],["剣","けん"],["に"],["のまれる"],["」"],["と"],["、"],["主","ぬし"],["の"],["御口","おくち"],["が"],["語られた","かたられた"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"どうして、遊女になったのか、忠信な都が。／公正があふれ、正義がそこに宿っていたのに。／今は人殺しばかりだ。","tok":[["どう"],["して"],["、"],["遊女","ゆうじょ"],["に"],["なった"],["の"],["か"],["、"],["忠信","ちゅうしん"],["な"],["都","と"],["が"],["。"],["／"],["公正","こうせい"],["が"],["あふれ"],["、"],["正義","せいぎ"],["が"],["そこ"],["に"],["宿って","やどって"],["いた"],["のに"],["。"],["／"],["今","いま"],["は"],["人殺し","ひとごろし"],["ばかり"],["だ"],["。"]]},{"verse":22,"text":"おまえの銀は、かなかすになった。／おまえの良い酒も、水で割ってある。","tok":[["おまえ"],["の"],["銀","ぎん"],["は"],["、"],["かな"],["かす"],["に"],["なった"],["。"],["／"],["おまえ"],["の"],["良い","よい"],["酒","さけ"],["も"],["、"],["水","みず"],["で"],["割って","わって"],["ある"],["。"]]},{"verse":23,"text":"おまえのつかさたちは反逆者、盗人の仲間。／みな、わいろを愛し、報酬を追い求める。／みなしごのために正しいさばきをせず、やもめの訴えも彼らは取り上げない。","tok":[["おまえ"],["の"],["つかさ"],["たち"],["は"],["反逆者","はんぎゃくしゃ"],["、"],["盗人","ぬすびと"],["の"],["仲間","なかま"],["。"],["／"],["みな"],["、"],["わいろ"],["を"],["愛し","あいし"],["、"],["報酬","ほうしゅう"],["を"],["追い求める","おいもとめる"],["。"],["／"],["みなしご"],["の"],["ため"],["に"],["正しい","ただしい"],["さばき"],["を"],["せず"],["、"],["やもめ"],["の"],["訴え","うったえ"],["も"],["彼","かれ"],["ら"],["は"],["取り上げない","とりあげない"],["。"]]},{"verse":24,"text":"それゆえに、――万軍の主、イスラエルの全能者、主の御告げ――／「ああ。／わたしの仇に思いを晴らし、わたしの敵に復讐しよう。","tok":[["それ"],["ゆえ"],["に"],["、"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["、"],["イスラエル"],["の"],["全能者","ぜんのうしゃ"],["、"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["「"],["ああ"],["。"],["／"],["わたし"],["の"],["仇","あだ"],["に"],["思い","おもい"],["を"],["晴らし","はらし"],["、"],["わたし"],["の"],["敵","てき"],["に"],["復讐","ふくしゅう"],["しよう"],["。"]]},{"verse":25,"text":"しかし、おまえの上に再びわが手を伸ばし、おまえのかなかすを灰汁のように溶かし、その浮きかすをみな除こう。","tok":[["しかし"],["、"],["おまえ"],["の"],["上","うえ"],["に"],["再び","ふたたび"],["わが"],["手","て"],["を"],["伸ばし","のばし"],["、"],["おまえ"],["の"],["かな"],["かす"],["を"],["灰汁","あく"],["の"],["よう"],["に"],["溶かし","とかし"],["、"],["その"],["浮きかす","うきかす"],["を"],["みな"],["除こう","のぞこう"],["。"]]},{"verse":26,"text":"こうして、おまえのさばきつかさたちを初めのように、おまえの議官たちを昔のようにしよう。／そうして後、おまえは正義の町、忠信な都と呼ばれよう。」","tok":[["こう"],["して"],["、"],["おまえ"],["の"],["さばき"],["つかさ"],["たち"],["を"],["初め","はじめ"],["の"],["よう"],["に"],["、"],["おまえ"],["の"],["議官","ぎかん"],["たち"],["を"],["昔","むかし"],["の"],["よう"],["に"],["しよう"],["。"],["／"],["そう"],["して"],["後","あと"],["、"],["おまえ"],["は"],["正義","せいぎ"],["の"],["町","まち"],["、"],["忠信","ちゅうしん"],["な"],["都","と"],["と"],["呼ばれよう","よばれよう"],["。"],["」"]]},{"verse":27,"text":"シオンは公正によって贖われ、その町の悔い改める者は／正義によって贖われる。","tok":[["シオン"],["は"],["公正","こうせい"],["によって"],["贖われ","あがなわれ"],["、"],["その"],["町","まち"],["の"],["悔い改める","くいあらためる"],["者","もの"],["は"],["／"],["正義","せいぎ"],["によって"],["贖われる","あがなわれる"],["。"]]},{"verse":28,"text":"そむく者は罪人とともに破滅し、主を捨てる者は、うせ果てる。","tok":[["そむく"],["者","もの"],["は"],["罪人","ざいにん"],["と"],["とも"],["に"],["破滅","はめつ"],["し"],["、"],["主","ぬし"],["を"],["捨てる","すてる"],["者","もの"],["は"],["、"],["うせ"],["果てる","はてる"],["。"]]},{"verse":29,"text":"まことに、彼らは、あなたがたの慕った樫の木で恥を見、あなたがたは、みずから選んだ園によって／はずかしめを受けよう。","tok":[["まこと"],["に"],["、"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["の"],["慕った","したった"],["樫","かし"],["の"],["木","き"],["で"],["恥","はじ"],["を"],["見","み"],["、"],["あなた"],["がた"],["は"],["、"],["みずから"],["選んだ","えらんだ"],["園","その"],["によって"],["／"],["はずかしめ"],["を"],["受けよう","うけよう"],["。"]]},{"verse":30,"text":"あなたがたは葉のしぼんだ樫の木のように、水のない園のようになるからだ。","tok":[["あなた"],["がた"],["は"],["葉","は"],["の"],["しぼんだ"],["樫","かし"],["の"],["木","き"],["の"],["よう"],["に"],["、"],["水","みず"],["の"],["ない"],["園","その"],["の"],["よう"],["に"],["なる"],["から"],["だ"],["。"]]},{"verse":31,"text":"つわものは麻くずに、そのわざは火花になり、その二つとも燃え立って、これを消す者がいない。","tok":[["つわもの"],["は"],["麻","あさ"],["くず"],["に"],["、"],["その"],["わざ"],["は"],["火花","ひばな"],["に"],["なり"],["、"],["その"],["二","ふた"],["つ"],["とも"],["燃え立って","もえたって"],["、"],["これ"],["を"],["消す","けす"],["者","もの"],["が"],["いない"],["。"]]}]
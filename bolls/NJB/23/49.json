[{"verse":1,"text":"島々よ。私に聞け。遠い国々の民よ。耳を傾けよ。主は、生まれる前から私を召し、母の胎内にいる時から私の名を呼ばれた。","tok":[["島々","しまじま"],["よ"],["。"],["私","わたくし"],["に"],["聞け","きけ"],["。"],["遠い","とおい"],["国々","くにぐに"],["の"],["民","たみ"],["よ"],["。"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["主","ぬし"],["は"],["、"],["生まれる","うまれる"],["前","まえ"],["から"],["私","わたくし"],["を"],["召し","めし"],["、"],["母","はは"],["の"],["胎内","たいない"],["に"],["いる"],["時","とき"],["から"],["私","わたくし"],["の"],["名","な"],["を"],["呼ばれた","よばれた"],["。"]]},{"verse":2,"text":"主は私の口を鋭い剣のようにし、御手の陰に私を隠し、私をとぎすました矢として、矢筒の中に私を隠した。","tok":[["主","ぬし"],["は"],["私","わたくし"],["の"],["口","くち"],["を"],["鋭い","するどい"],["剣","けん"],["の"],["よう"],["に"],["し"],["、"],["御手","おて"],["の"],["陰","かげ"],["に"],["私","わたくし"],["を"],["隠し","かくし"],["、"],["私","わたくし"],["を"],["とぎすました"],["矢","や"],["として"],["、"],["矢筒","やづつ"],["の"],["中","なか"],["に"],["私","わたくし"],["を"],["隠した","かくした"],["。"]]},{"verse":3,"text":"そして、私に仰せられた。「あなたはわたしのしもべ、イスラエル。わたしはあなたのうちに、わたしの栄光を現す。」","tok":[["そして"],["、"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["わたし"],["の"],["しもべ"],["、"],["イスラエル"],["。"],["わたし"],["は"],["あなた"],["の"],["うち"],["に"],["、"],["わたし"],["の"],["栄光","えいこう"],["を"],["現す","あらわす"],["。"],["」"]]},{"verse":4,"text":"しかし、私は言った。「私はむだな骨折りをして、いたずらに、むなしく、私の力を使い果たした。それでも、私の正しい訴えは、主とともにあり、私の報酬は、私の神とともにある。」","tok":[["しかし"],["、"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["むだ"],["な"],["骨折り","ほねおり"],["を"],["して"],["、"],["いたずら"],["に"],["、"],["むなしく"],["、"],["私","わたくし"],["の"],["力","ちから"],["を"],["使い果たした","つかいはたした"],["。"],["それ"],["で"],["も"],["、"],["私","わたくし"],["の"],["正しい","ただしい"],["訴え","うったえ"],["は"],["、"],["主","ぬし"],["と"],["とも"],["に"],["あり"],["、"],["私","わたくし"],["の"],["報酬","ほうしゅう"],["は"],["、"],["私","わたくし"],["の"],["神","かみ"],["と"],["とも"],["に"],["ある"],["。"],["」"]]},{"verse":5,"text":"今、主は仰せられる。／――主はヤコブをご自分のもとに帰らせ、イスラエルをご自分のもとに集めるために、私が母の胎内にいる時、私をご自分のしもべとして造られた。／私は主に尊ばれ、私の神は私の力となられた。――","tok":[["今","いま"],["、"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["／"],["―"],["―"],["主","ぬし"],["は"],["ヤコブ"],["を"],["ご自分","ごじぶん"],["の"],["もと"],["に"],["帰らせ","かえらせ"],["、"],["イスラエル"],["を"],["ご自分","ごじぶん"],["の"],["もと"],["に"],["集める","あつめる"],["ため"],["に"],["、"],["私","わたくし"],["が"],["母","はは"],["の"],["胎内","たいない"],["に"],["いる"],["時","とき"],["、"],["私","わたくし"],["を"],["ご自分","ごじぶん"],["の"],["しもべ"],["として"],["造られた","つくられた"],["。"],["／"],["私","わたくし"],["は"],["主に","おもに"],["尊ばれ","とうとばれ"],["、"],["私","わたくし"],["の"],["神","かみ"],["は"],["私","わたくし"],["の"],["力","ちから"],["と"],["なられた"],["。"],["―"],["―"]]},{"verse":6,"text":"主は仰せられる。「ただ、あなたがわたしのしもべとなって、ヤコブの諸部族を立たせ、イスラエルのとどめられている者たちを帰らせるだけではない。わたしはあなたを諸国の民の光とし、地の果てにまでわたしの救いをもたらす者とする。」","tok":[["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["「"],["ただ"],["、"],["あなた"],["が"],["わたし"],["の"],["しもべ"],["と"],["なって"],["、"],["ヤコブ"],["の"],["諸","しょ"],["部族","ぶぞく"],["を"],["立たせ","たたせ"],["、"],["イスラエル"],["の"],["とどめられて"],["いる"],["者","もの"],["たち"],["を"],["帰らせる","かえらせる"],["だけ"],["で"],["は"],["ない"],["。"],["わたし"],["は"],["あなた"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["光","ひかり"],["と"],["し"],["、"],["地","ち"],["の"],["果て","はて"],["に"],["まで"],["わたし"],["の"],["救い","すくい"],["を"],["もたらす"],["者","もの"],["と"],["する"],["。"],["」"]]},{"verse":7,"text":"イスラエルを贖う、その聖なる方、主は、人にさげすまれている者、民に忌みきらわれている者、支配者たちの奴隷に向かってこう仰せられる。「王たちは見て立ち上がり、首長たちもひれ伏す。主が真実であり、イスラエルの聖なる方があなたを選んだからである。」","tok":[["イスラエル"],["を"],["贖う","あがなう"],["、"],["その"],["聖","せい"],["なる"],["方","かた"],["、"],["主","ぬし"],["は"],["、"],["人","ひと"],["に"],["さげすまれて"],["いる"],["者","もの"],["、"],["民","みん"],["に"],["忌みきらわれて","いみきらわれて"],["いる"],["者","もの"],["、"],["支配者","しはいしゃ"],["たち"],["の"],["奴隷","どれい"],["に"],["向かって","むかって"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["王","おう"],["たち"],["は"],["見て","みて"],["立ち上がり","たちあがり"],["、"],["首長","しゅちょう"],["たち"],["も"],["ひれ伏す","ひれふす"],["。"],["主","ぬし"],["が"],["真実","しんじつ"],["で"],["あり"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["が"],["あなた"],["を"],["選んだ","えらんだ"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":8,"text":"主はこう仰せられる。／「恵みの時に、わたしはあなたに答え、救いの日にあなたを助けた。／わたしはあなたを見守り、あなたを民の契約とし、国を興し、荒れ果てたゆずりの地を継がせよう。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["恵み","めぐみ"],["の"],["時","とき"],["に"],["、"],["わたし"],["は"],["あなた"],["に"],["答え","こたえ"],["、"],["救い","すくい"],["の"],["日","ひ"],["に"],["あなた"],["を"],["助けた","たすけた"],["。"],["／"],["わたし"],["は"],["あなた"],["を"],["見守り","みまもり"],["、"],["あなた"],["を"],["民","たみ"],["の"],["契約","けいやく"],["と"],["し"],["、"],["国","くに"],["を"],["興し","おこし"],["、"],["荒れ果てた","あれはてた"],["ゆずり"],["の"],["地","ち"],["を"],["継がせよう","つがせよう"],["。"]]},{"verse":9,"text":"わたしは捕らわれ人には『出よ』と言い、やみの中にいる者には『姿を現せ』と言う。／彼らは道すがら羊を飼い、裸の丘の至る所が、彼らの牧場となる。","tok":[["わたし"],["は"],["捕らわれ","とらわれ"],["人","ひと"],["に"],["は"],["『"],["出","で"],["よ"],["』"],["と"],["言い","いい"],["、"],["やみ"],["の"],["中","なか"],["に"],["いる"],["者","もの"],["に"],["は"],["『"],["姿","すがた"],["を"],["現せ","あらわせ"],["』"],["と"],["言う","ゆう"],["。"],["／"],["彼","かれ"],["ら"],["は"],["道すがら","みちすがら"],["羊","ひつじ"],["を"],["飼い","かい"],["、"],["裸","はだか"],["の"],["丘","おか"],["の"],["至る所","いたるところ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["牧場","ぼくじょう"],["と"],["なる"],["。"]]},{"verse":10,"text":"彼らは飢えず、渇かず、熱も太陽も彼らを打たない。／彼らをあわれむ者が彼らを導き、水のわく所に連れて行くからだ。","tok":[["彼","かれ"],["ら"],["は"],["飢えず","うえず"],["、"],["渇かず","かわかず"],["、"],["熱","ねつ"],["も"],["太陽","たいよう"],["も"],["彼","かれ"],["ら"],["を"],["打たない","うたない"],["。"],["／"],["彼","かれ"],["ら"],["を"],["あわれむ"],["者","もの"],["が"],["彼","かれ"],["ら"],["を"],["導き","みちびき"],["、"],["水","みず"],["の"],["わく所","わくしょ"],["に"],["連れて","つれて"],["行く","いく"],["から"],["だ"],["。"]]},{"verse":11,"text":"わたしは、わたしの山々をすべて道とし、わたしの大路を高くする。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["山々","やまやま"],["を"],["すべて"],["道","みち"],["と"],["し"],["、"],["わたし"],["の"],["大路","おおじ"],["を"],["高く","たかく"],["する"],["。"]]},{"verse":12,"text":"見よ。ある者は遠くから来る。／また、ある者は北から西から、また、ある者はシニムの地から来る。」","tok":[["見","み"],["よ"],["。"],["ある"],["者","もの"],["は"],["遠く","とおく"],["から"],["来る","くる"],["。"],["／"],["また"],["、"],["ある"],["者","もの"],["は"],["北","きた"],["から"],["西","にし"],["から"],["、"],["また"],["、"],["ある"],["者","もの"],["は"],["シニム"],["の"],["地","ち"],["から"],["来る","くる"],["。"],["」"]]},{"verse":13,"text":"天よ。喜び歌え。地よ。楽しめ。／山々よ。喜びの歌声をあげよ。／主がご自分の民を慰め、その悩める者をあわれまれるからだ。","tok":[["天","てん"],["よ"],["。"],["喜び歌え","よろこびうたえ"],["。"],["地","ち"],["よ"],["。"],["楽しめ","たのしめ"],["。"],["／"],["山々","やまやま"],["よ"],["。"],["喜び","よろこび"],["の"],["歌声","うたごえ"],["を"],["あげ"],["よ"],["。"],["／"],["主","ぬし"],["が"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["慰め","なぐさめ"],["、"],["その"],["悩める","なやめる"],["者","もの"],["を"],["あわれまれる"],["から"],["だ"],["。"]]},{"verse":14,"text":"しかし、シオンは言った。／「主は私を見捨てた。主は私を忘れた」と。","tok":[["しかし"],["、"],["シオン"],["は"],["言った","いった"],["。"],["／"],["「"],["主","ぬし"],["は"],["私","わたくし"],["を"],["見捨てた","みすてた"],["。"],["主","ぬし"],["は"],["私","わたくし"],["を"],["忘れた","わすれた"],["」"],["と"],["。"]]},{"verse":15,"text":"「女が自分の乳飲み子を忘れようか。／自分の胎の子をあわれまないだろうか。／たとい、女たちが忘れても、このわたしはあなたを忘れない。","tok":[["「"],["女","おんな"],["が"],["自分","じぶん"],["の"],["乳飲み子","ちのみご"],["を"],["忘れよう","わすれよう"],["か"],["。"],["／"],["自分","じぶん"],["の"],["胎","はら"],["の"],["子","こ"],["を"],["あわれまないだろう"],["か"],["。"],["／"],["たとい"],["、"],["女","おんな"],["たち"],["が"],["忘れて","わすれて"],["も"],["、"],["この"],["わたし"],["は"],["あなた"],["を"],["忘れない","わすれない"],["。"]]},{"verse":16,"text":"見よ。わたしは手のひらに／あなたを刻んだ。／あなたの城壁は、いつもわたしの前にある。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["手のひら","てのひら"],["に"],["／"],["あなた"],["を"],["刻んだ","きざんだ"],["。"],["／"],["あなた"],["の"],["城壁","じょうへき"],["は"],["、"],["いつも"],["わたし"],["の"],["前","まえ"],["に"],["ある"],["。"]]},{"verse":17,"text":"あなたの子どもたちは急いで来る。／あなたを滅ぼし、あなたを廃墟とした者は、あなたのところから出て行く。","tok":[["あなた"],["の"],["子ども","こども"],["たち"],["は"],["急いで","いそいで"],["来る","くる"],["。"],["／"],["あなた"],["を"],["滅ぼし","ほろぼし"],["、"],["あなた"],["を"],["廃墟","はいきょ"],["と"],["した"],["者","もの"],["は"],["、"],["あなた"],["の"],["ところ"],["から"],["出て","でて"],["行く","いく"],["。"]]},{"verse":18,"text":"目を上げて、あたりを見回せ。／彼らはみな集まって、あなたのところに来る。／わたしは生きている。――主の御告げ――／あなたは必ず、彼らをみな飾り物として身につけ、花嫁のように彼らを帯に結ぶ。","tok":[["目","め"],["を"],["上げて","あげて"],["、"],["あたり"],["を"],["見回せ","みまわせ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["集まって","あつまって"],["、"],["あなた"],["の"],["ところ"],["に"],["来る","くる"],["。"],["／"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["あなた"],["は"],["必ず","かならず"],["、"],["彼","かれ"],["ら"],["を"],["みな"],["飾り物","かざりもの"],["として"],["身","み"],["に"],["つけ"],["、"],["花嫁","はなよめ"],["の"],["よう"],["に"],["彼","かれ"],["ら"],["を"],["帯","おび"],["に"],["結ぶ","むすぶ"],["。"]]},{"verse":19,"text":"必ず、あなたの廃墟と荒れ跡と滅びた地は、いまに、人が住むには狭すぎるようになり、あなたを滅ぼした者たちは／遠くへ離れ去る。","tok":[["必ず","かならず"],["、"],["あなた"],["の"],["廃墟","はいきょ"],["と"],["荒れ","あれ"],["跡","あと"],["と"],["滅びた","ほろびた"],["地","ち"],["は"],["、"],["いま"],["に"],["、"],["人","ひと"],["が"],["住む","すむ"],["に"],["は"],["狭","せま"],["すぎる"],["よう"],["に"],["なり"],["、"],["あなた"],["を"],["滅ぼした","ほろぼした"],["者","もの"],["たち"],["は"],["／"],["遠く","とおく"],["へ"],["離れ去る","はなれさる"],["。"]]},{"verse":20,"text":"あなたが子を失って後に生まれた子らが、再びあなたの耳に言おう。／『この場所は、私には狭すぎる。／私が住めるように、場所をあけてもらいたい』と。","tok":[["あなた"],["が"],["子","こ"],["を"],["失って","うしなって"],["後","あと"],["に"],["生まれた","うまれた"],["子","こ"],["ら"],["が"],["、"],["再び","ふたたび"],["あなた"],["の"],["耳","みみ"],["に"],["言おう","いおう"],["。"],["／"],["『"],["この"],["場所","ばしょ"],["は"],["、"],["私","わたくし"],["に"],["は"],["狭","せま"],["すぎる"],["。"],["／"],["私","わたくし"],["が"],["住める","すめる"],["よう"],["に"],["、"],["場所","ばしょ"],["を"],["あけて"],["もらいたい"],["』"],["と"],["。"]]},{"verse":21,"text":"そのとき、あなたは心の中で言おう。／『だれが私に、この者たちを／生んでくれたのだろう。／私は子に死なれた女、うまずめ、亡命のさすらい者であったのに。／だれがこの者たちを育てたのだろう。／見よ。私は、ただひとり、残されていたのに、この者たちはどこから来たのだろう。』」","tok":[["その"],["とき"],["、"],["あなた"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["言おう","いおう"],["。"],["／"],["『"],["だれ"],["が"],["私","わたくし"],["に"],["、"],["この"],["者","もの"],["たち"],["を"],["／"],["生んで","うんで"],["くれた"],["の"],["だろう"],["。"],["／"],["私","わたくし"],["は"],["子","こ"],["に"],["死なれた","しなれた"],["女","おんな"],["、"],["うまずめ"],["、"],["亡命","ぼうめい"],["の"],["さすらい"],["者","しゃ"],["で"],["あった"],["のに"],["。"],["／"],["だれ"],["が"],["この"],["者","もの"],["たち"],["を"],["育てた","そだてた"],["の"],["だろう"],["。"],["／"],["見","み"],["よ"],["。"],["私","わたくし"],["は"],["、"],["ただ"],["ひとり"],["、"],["残されて","のこされて"],["いた"],["のに"],["、"],["この"],["者","もの"],["たち"],["は"],["どこ"],["から"],["来た","きた"],["の"],["だろう"],["。"],["』"],["」"]]},{"verse":22,"text":"神である主はこう仰せられる。／「見よ。わたしは国々に向かって手を上げ、わたしの旗を国々の民に向かって揚げる。／彼らは、あなたの息子たちを／ふところに抱いて来、あなたの娘たちは肩に負われて来る。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["国々","くにぐに"],["に"],["向かって","むかって"],["手","て"],["を"],["上げ","あげ"],["、"],["わたし"],["の"],["旗","はた"],["を"],["国々","くにぐに"],["の"],["民","たみ"],["に"],["向かって","むかって"],["揚げる","あげる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["息子","むすこ"],["たち"],["を"],["／"],["ふところ"],["に"],["抱いて","いだいて"],["来","き"],["、"],["あなた"],["の"],["娘","むすめ"],["たち"],["は"],["肩","かた"],["に"],["負われて","おわれて"],["来る","くる"],["。"]]},{"verse":23,"text":"王たちはあなたの世話をする者となり、王妃たちはあなたのうばとなる。／彼らは顔を地につけて、あなたを伏し拝み、あなたの足のちりをなめる。／あなたは、わたしが主であることを知る。／わたしを待ち望む者は恥を見ることがない。」","tok":[["王","おう"],["たち"],["は"],["あなた"],["の"],["世話","せわ"],["を"],["する"],["者","もの"],["と"],["なり"],["、"],["王妃","おうひ"],["たち"],["は"],["あなた"],["の"],["うば"],["と"],["なる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["顔","かお"],["を"],["地","ち"],["に"],["つけて"],["、"],["あなた"],["を"],["伏し拝み","ふしおがみ"],["、"],["あなた"],["の"],["足","あし"],["の"],["ちり"],["を"],["なめる"],["。"],["／"],["あなた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"],["／"],["わたし"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["は"],["恥","はじ"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"],["」"]]},{"verse":24,"text":"奪われた物を勇士から取り戻せようか。／罪のないとりこたちを助け出せようか。","tok":[["奪われた","うばわれた"],["物","もの"],["を"],["勇士","ゆうし"],["から"],["取り戻せよう","とりもどせよう"],["か"],["。"],["／"],["罪","つみ"],["の"],["ない"],["とりこ"],["たち"],["を"],["助け出せよう","たすけだせよう"],["か"],["。"]]},{"verse":25,"text":"まことに、主はこう仰せられる。／「勇士のとりこは取り戻され、横暴な者に奪われた物も奪い返される。／あなたの争う者とわたしは争い、あなたの子らをこのわたしが救う。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["勇士","ゆうし"],["の"],["とりこ"],["は"],["取り戻され","とりもどされ"],["、"],["横暴","おうぼう"],["な"],["者","もの"],["に"],["奪われた","うばわれた"],["物","もの"],["も"],["奪い返される","うばいかえされる"],["。"],["／"],["あなた"],["の"],["争う","あらそう"],["者","もの"],["と"],["わたし"],["は"],["争い","あらそい"],["、"],["あなた"],["の"],["子","こ"],["ら"],["を"],["この"],["わたし"],["が"],["救う","すくう"],["。"]]},{"verse":26,"text":"わたしは、あなたをしいたげる者に、彼ら自身の肉を食らわせる。／彼らは甘いぶどう酒に酔うように、自分自身の血に酔う。／すべての者が、わたしが主、あなたの救い主、あなたの贖い主、ヤコブの力強き者であることを知る。」","tok":[["わたし"],["は"],["、"],["あなた"],["を"],["しいたげる"],["者","もの"],["に"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["の"],["肉","にく"],["を"],["食らわせる","くらわせる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["甘い","あまい"],["ぶどう酒","ぶどうしゅ"],["に"],["酔う","よう"],["よう"],["に"],["、"],["自分","じぶん"],["自身","じしん"],["の"],["血","ち"],["に"],["酔う","よう"],["。"],["／"],["すべて"],["の"],["者","もの"],["が"],["、"],["わたし"],["が"],["主","ぬし"],["、"],["あなた"],["の"],["救い主","すくいぬし"],["、"],["あなた"],["の"],["贖い","あがない"],["主","ぬし"],["、"],["ヤコブ"],["の"],["力","ちから"],["強き","つよき"],["者","もの"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"],["」"]]}]
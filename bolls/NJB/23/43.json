[{"verse":1,"text":"だが、今、ヤコブよ。／あなたを造り出した方、主はこう仰せられる。／イスラエルよ。／あなたを形造った方、主はこう仰せられる。／「恐れるな。わたしがあなたを贖ったのだ。／わたしはあなたの名を呼んだ。／あなたはわたしのもの。","tok":[["だ"],["が"],["、"],["今","いま"],["、"],["ヤコブ"],["よ"],["。"],["／"],["あなた"],["を"],["造り出した","つくりだした"],["方","かた"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["イスラエル"],["よ"],["。"],["／"],["あなた"],["を"],["形造った","かたちづくった"],["方","かた"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["恐れる","おそれる"],["な"],["。"],["わたし"],["が"],["あなた"],["を"],["贖った","あがなった"],["の"],["だ"],["。"],["／"],["わたし"],["は"],["あなた"],["の"],["名","な"],["を"],["呼んだ","よんだ"],["。"],["／"],["あなた"],["は"],["わたし"],["の"],["もの"],["。"]]},{"verse":2,"text":"あなたが水の中を過ぎるときも、わたしはあなたとともにおり、川を渡るときも、あなたは押し流されない。／火の中を歩いても、あなたは焼かれず、炎はあなたに燃えつかない。","tok":[["あなた"],["が"],["水","みず"],["の"],["中","なか"],["を"],["過ぎる","すぎる"],["とき"],["も"],["、"],["わたし"],["は"],["あなた"],["と"],["とも"],["に"],["おり"],["、"],["川","かわ"],["を"],["渡る","わたる"],["とき"],["も"],["、"],["あなた"],["は"],["押し流されない","おしながされない"],["。"],["／"],["火","ひ"],["の"],["中","なか"],["を"],["歩いて","あるいて"],["も"],["、"],["あなた"],["は"],["焼かれず","やかれず"],["、"],["炎","ほのお"],["は"],["あなた"],["に"],["燃えつかない","もえつかない"],["。"]]},{"verse":3,"text":"わたしが、あなたの神、主、イスラエルの聖なる者、あなたの救い主であるからだ。／わたしは、エジプトをあなたの身代金とし、クシュとセバをあなたの代わりとする。","tok":[["わたし"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["者","もの"],["、"],["あなた"],["の"],["救い主","すくいぬし"],["で"],["ある"],["から"],["だ"],["。"],["／"],["わたし"],["は"],["、"],["エジプト"],["を"],["あなた"],["の"],["身代金","みのしろきん"],["と"],["し"],["、"],["クシュ"],["と"],["セバ"],["を"],["あなた"],["の"],["代わり","かわり"],["と"],["する"],["。"]]},{"verse":4,"text":"わたしの目には、あなたは高価で尊い。／わたしはあなたを愛している。／だからわたしは人をあなたの代わりにし、国民をあなたのいのちの代わりにするのだ。","tok":[["わたし"],["の"],["目","め"],["に"],["は"],["、"],["あなた"],["は"],["高価","こうか"],["で"],["尊い","とうとい"],["。"],["／"],["わたし"],["は"],["あなた"],["を"],["愛して","あいして"],["いる"],["。"],["／"],["だ"],["から"],["わたし"],["は"],["人","ひと"],["を"],["あなた"],["の"],["代わり","かわり"],["に"],["し"],["、"],["国民","こくみん"],["を"],["あなた"],["の"],["いのち"],["の"],["代わり","かわり"],["に"],["する"],["の"],["だ"],["。"]]},{"verse":5,"text":"恐れるな。／わたしがあなたとともにいるからだ。／わたしは東から、あなたの子孫を来させ、西から、あなたを集める。","tok":[["恐れる","おそれる"],["な"],["。"],["／"],["わたし"],["が"],["あなた"],["と"],["とも"],["に"],["いる"],["から"],["だ"],["。"],["／"],["わたし"],["は"],["東","ひがし"],["から"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["来させ","きたさせ"],["、"],["西","にし"],["から"],["、"],["あなた"],["を"],["集める","あつめる"],["。"]]},{"verse":6,"text":"わたしは、北に向かって『引き渡せ』と言い、南に向かって『引き止めるな』と言う。／わたしの子らを遠くから来させ、わたしの娘らを地の果てから来させよ。","tok":[["わたし"],["は"],["、"],["北","きた"],["に"],["向かって","むかって"],["『"],["引き渡せ","ひきわたせ"],["』"],["と"],["言い","いい"],["、"],["南","みなみ"],["に"],["向かって","むかって"],["『"],["引き止める","ひきとめる"],["な"],["』"],["と"],["言う","ゆう"],["。"],["／"],["わたし"],["の"],["子","こ"],["ら"],["を"],["遠く","とおく"],["から"],["来させ","きさせ"],["、"],["わたし"],["の"],["娘","むすめ"],["ら"],["を"],["地","ち"],["の"],["果て","はて"],["から"],["来させよ","きさせよ"],["。"]]},{"verse":7,"text":"わたしの名で呼ばれるすべての者は、わたしの栄光のために、わたしがこれを創造し、これを形造り、これを造った。","tok":[["わたし"],["の"],["名","な"],["で"],["呼ばれる","よばれる"],["すべて"],["の"],["者","もの"],["は"],["、"],["わたし"],["の"],["栄光","えいこう"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["これ"],["を"],["創造","そうぞう"],["し"],["、"],["これ"],["を"],["形造り","かたちづくり"],["、"],["これ"],["を"],["造った","つくった"],["。"]]},{"verse":8,"text":"目があっても盲目の民、耳があっても聞こえない者たちを連れ出せ。","tok":[["目","め"],["が"],["あって"],["も"],["盲目","もうもく"],["の"],["民","たみ"],["、"],["耳","みみ"],["が"],["あって"],["も"],["聞こえない","きこえない"],["者","もの"],["たち"],["を"],["連れ出せ","つれだせ"],["。"]]},{"verse":9,"text":"すべての国々をつどわせ、諸国の民を集めよ。／彼らのうちのだれが、このことを告げ、先の事をわれわれに聞かせることができようか。／彼らの証人を出して証言させ、それを聞く者に『ほんとうだ』と言わせよ。","tok":[["すべて"],["の"],["国々","くにぐに"],["を"],["つどわせ"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["集めよ","あつめよ"],["。"],["／"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["だれ"],["が"],["、"],["この"],["こと"],["を"],["告げ","つげ"],["、"],["先","さき"],["の"],["事","こと"],["を"],["われわれ"],["に"],["聞かせる","きかせる"],["こと"],["が"],["できよう"],["か"],["。"],["／"],["彼","かれ"],["ら"],["の"],["証人","しょうにん"],["を"],["出して","だして"],["証言","しょうげん"],["させ"],["、"],["それ"],["を"],["聞く","きく"],["者","もの"],["に"],["『"],["ほんとう"],["だ"],["』"],["と"],["言わせ","いわせ"],["よ"],["。"]]},{"verse":10,"text":"あなたがたはわたしの証人、――主の御告げ――／わたしが選んだわたしのしもべである。／これは、あなたがたが知って、わたしを信じ、わたしがその者であることを悟るためだ。／わたしより先に造られた神はなく、わたしより後にもない。","tok":[["あなた"],["がた"],["は"],["わたし"],["の"],["証人","しょうにん"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["が"],["選んだ","えらんだ"],["わたし"],["の"],["しもべ"],["で"],["ある"],["。"],["／"],["これ"],["は"],["、"],["あなた"],["がた"],["が"],["知って","しって"],["、"],["わたし"],["を"],["信じ","しんじ"],["、"],["わたし"],["が"],["その"],["者","もの"],["で"],["ある"],["こと"],["を"],["悟る","さとる"],["ため"],["だ"],["。"],["／"],["わたし"],["より"],["先","さき"],["に"],["造られた","つくられた"],["神","かみ"],["は"],["なく"],["、"],["わたし"],["より"],["後","あと"],["に"],["も"],["ない"],["。"]]},{"verse":11,"text":"わたし、このわたしが、主であって、わたしのほかに救い主はいない。","tok":[["わたし"],["、"],["この"],["わたし"],["が"],["、"],["主","ぬし"],["で"],["あって"],["、"],["わたし"],["の"],["ほか"],["に"],["救い主","すくいぬし"],["は"],["いない"],["。"]]},{"verse":12,"text":"このわたしが、告げ、救い、聞かせたのだ。／あなたがたのうちに、異なる神はなかった。／だから、あなたがたはわたしの証人。／――主の御告げ――わたしは神だ。","tok":[["この"],["わたし"],["が"],["、"],["告げ","つげ"],["、"],["救い","すくい"],["、"],["聞かせた","きかせた"],["の"],["だ"],["。"],["／"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["異なる","ことなる"],["神","かみ"],["は"],["なかった"],["。"],["／"],["だ"],["から"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["証人","しょうにん"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["は"],["神","かみ"],["だ"],["。"]]},{"verse":13,"text":"これから後もわたしは神だ。／わたしの手から救い出せる者はなく、わたしが事を行えば、だれがそれを戻しえよう。」","tok":[["これ"],["から"],["後","あと"],["も"],["わたし"],["は"],["神","かみ"],["だ"],["。"],["／"],["わたし"],["の"],["手","て"],["から"],["救い出せる","すくいだせる"],["者","もの"],["は"],["なく"],["、"],["わたし"],["が"],["事","こと"],["を"],["行えば","おこなえば"],["、"],["だれ"],["が"],["それ"],["を"],["戻し","もどし"],["えよう"],["。"],["」"]]},{"verse":14,"text":"あなたがたを贖われたイスラエルの聖なる方、主はこう仰せられる。／「あなたがたのために、わたしはバビロンに使いを送り、彼らの横木をみな突き落とし、カルデヤ人を喜び歌っている船から突き落とす。","tok":[["あなた"],["がた"],["を"],["贖われた","あがなわれた"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["バビロン"],["に"],["使い","つかい"],["を"],["送り","おくり"],["、"],["彼","かれ"],["ら"],["の"],["横木","よこぎ"],["を"],["みな"],["突き落とし","つきおとし"],["、"],["カルデヤ"],["人","ひと"],["を"],["喜び歌って","よろこびうたって"],["いる"],["船","ふね"],["から"],["突き落とす","つきおとす"],["。"]]},{"verse":15,"text":"わたしは主、あなたがたの聖なる者、イスラエルの創造者、あなたがたの王である。」","tok":[["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["がた"],["の"],["聖","せい"],["なる"],["者","もの"],["、"],["イスラエル"],["の"],["創造者","そうぞうしゃ"],["、"],["あなた"],["がた"],["の"],["王","おう"],["で"],["ある"],["。"],["」"]]},{"verse":16,"text":"海の中に道を、激しく流れる水の中に通り道を設け、","tok":[["海","うみ"],["の"],["中","なか"],["に"],["道","みち"],["を"],["、"],["激しく","はげしく"],["流れる","ながれる"],["水","みず"],["の"],["中","なか"],["に"],["通り道","とおりみち"],["を"],["設け","もうけ"],["、"]]},{"verse":17,"text":"戦車と馬、強力な軍勢を連れ出した主は／こう仰せられる。／「彼らはみな倒れて起き上がれず、燈心のように消える。","tok":[["戦車","せんしゃ"],["と"],["馬","うま"],["、"],["強力","きょうりょく"],["な"],["軍勢","ぐんぜい"],["を"],["連れ出した","つれだした"],["主","ぬし"],["は"],["／"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["彼","かれ"],["ら"],["は"],["みな"],["倒れて","たおれて"],["起き上がれず","おきあがれず"],["、"],["燈心","とうしん"],["の"],["よう"],["に"],["消える","きえる"],["。"]]},{"verse":18,"text":"先の事どもを思い出すな。／昔の事どもを考えるな。","tok":[["先","さき"],["の"],["事","こと"],["ども"],["を"],["思い出す","おもいだす"],["な"],["。"],["／"],["昔","むかし"],["の"],["事","こと"],["ども"],["を"],["考える","かんがえる"],["な"],["。"]]},{"verse":19,"text":"見よ。わたしは新しい事をする。／今、もうそれが起ころうとしている。／あなたがたは、それを知らないのか。／確かに、わたしは荒野に道を、荒地に川を設ける。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["新しい","あたらしい"],["事","こと"],["を"],["する"],["。"],["／"],["今","いま"],["、"],["もう"],["それ"],["が"],["起ころう","おころう"],["として"],["いる"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["それ"],["を"],["知らない","しらない"],["の"],["か"],["。"],["／"],["確か","たしか"],["に"],["、"],["わたし"],["は"],["荒野","こうや"],["に"],["道","みち"],["を"],["、"],["荒地","あれち"],["に"],["川","かわ"],["を"],["設ける","もうける"],["。"]]},{"verse":20,"text":"野の獣、ジャッカルや、だちょうも、わたしをあがめる。／わたしが荒野に水をわき出させ、荒地に川を流し、わたしの民、わたしの選んだ者に飲ませるからだ。","tok":[["野","の"],["の"],["獣","けもの"],["、"],["ジャッカル"],["や"],["、"],["だちょう"],["も"],["、"],["わたし"],["を"],["あがめる"],["。"],["／"],["わたし"],["が"],["荒野","あらの"],["に"],["水","みず"],["を"],["わき出させ","わきださせ"],["、"],["荒地","あれち"],["に"],["川","かわ"],["を"],["流し","ながし"],["、"],["わたし"],["の"],["民","たみ"],["、"],["わたし"],["の"],["選んだ","えらんだ"],["者","もの"],["に"],["飲ませる","のませる"],["から"],["だ"],["。"]]},{"verse":21,"text":"わたしのために造ったこの民は／わたしの栄誉を宣べ伝えよう。","tok":[["わたし"],["の"],["ため"],["に"],["造った","つくった"],["この"],["民","みん"],["は"],["／"],["わたし"],["の"],["栄誉","えいよ"],["を"],["宣べ伝えよう","のべつたえよう"],["。"]]},{"verse":22,"text":"しかしヤコブよ。／あなたはわたしを呼び求めなかった。／イスラエルよ。／あなたはわたしのために労苦しなかった。","tok":[["しかし"],["ヤコブ"],["よ"],["。"],["／"],["あなた"],["は"],["わたし"],["を"],["呼び求めなかった","よびもとめなかった"],["。"],["／"],["イスラエル"],["よ"],["。"],["／"],["あなた"],["は"],["わたし"],["の"],["ため"],["に"],["労苦","ろうく"],["しなかった"],["。"]]},{"verse":23,"text":"あなたはわたしに、全焼のいけにえの羊を携えて来ず、いけにえをささげて、わたしをあがめようともしなかった。／わたしは穀物のささげ物のことで、あなたに苦労をさせず、乳香のことであなたを煩わせもしなかった。","tok":[["あなた"],["は"],["わたし"],["に"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["羊","ひつじ"],["を"],["携えて","たずさえて"],["来ず","こず"],["、"],["いけにえ"],["を"],["ささげて"],["、"],["わたし"],["を"],["あがめよう"],["と"],["も"],["しなかった"],["。"],["／"],["わたし"],["は"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["の"],["こと"],["で"],["、"],["あなた"],["に"],["苦労","くろう"],["を"],["させず"],["、"],["乳香","にゅうこう"],["の"],["こと"],["で"],["あなた"],["を"],["煩わせ","わずらわせ"],["も"],["しなかった"],["。"]]},{"verse":24,"text":"あなたはわたしのために、金を払って菖蒲を買わず、いけにえの脂肪で、わたしを満足させなかった。／かえって、あなたの罪で、わたしに苦労をさせ、あなたの不義で、わたしを煩わせただけだ。","tok":[["あなた"],["は"],["わたし"],["の"],["ため"],["に"],["、"],["金","きん"],["を"],["払って","はらって"],["菖蒲","しょうぶ"],["を"],["買わず","かわず"],["、"],["いけにえ"],["の"],["脂肪","しぼう"],["で"],["、"],["わたし"],["を"],["満足","まんぞく"],["させなかった"],["。"],["／"],["かえって"],["、"],["あなた"],["の"],["罪","つみ"],["で"],["、"],["わたし"],["に"],["苦労","くろう"],["を"],["させ"],["、"],["あなた"],["の"],["不義","ふぎ"],["で"],["、"],["わたし"],["を"],["煩わせた","わずらわせた"],["だけ"],["だ"],["。"]]},{"verse":25,"text":"わたし、このわたしは、わたし自身のために／あなたのそむきの罪をぬぐい去り、もうあなたの罪を思い出さない。","tok":[["わたし"],["、"],["この"],["わたし"],["は"],["、"],["わたし"],["自身","じしん"],["の"],["ため"],["に"],["／"],["あなた"],["の"],["そむき"],["の"],["罪","つみ"],["を"],["ぬぐい去り","ぬぐいさり"],["、"],["もう"],["あなた"],["の"],["罪","つみ"],["を"],["思い出さない","おもいださない"],["。"]]},{"verse":26,"text":"わたしに思い出させよ。／共に論じ合おう。／身の潔白を明かすため、あなたのほうから述べたてよ。","tok":[["わたし"],["に"],["思い出させ","おもいださせ"],["よ"],["。"],["／"],["共","とも"],["に"],["論じ合おう","ろんじあおう"],["。"],["／"],["身","み"],["の"],["潔白","けっぱく"],["を"],["明かす","あかす"],["ため"],["、"],["あなた"],["の"],["ほう"],["から"],["述べたてよ","のべたてよ"],["。"]]},{"verse":27,"text":"あなたの最初の先祖は罪を犯し、あなたの代言者たちは、わたしにそむいた。","tok":[["あなた"],["の"],["最初","さいしょ"],["の"],["先祖","せんぞ"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["あなた"],["の"],["代言者","だいげんしゃ"],["たち"],["は"],["、"],["わたし"],["に"],["そむいた"],["。"]]},{"verse":28,"text":"それで、わたしは聖所のつかさたちを汚し、ヤコブが聖絶されるようにし、イスラエルが、ののしられるようにした。」","tok":[["それ"],["で"],["、"],["わたし"],["は"],["聖","せい"],["所","しょ"],["の"],["つかさ"],["たち"],["を"],["汚し","よごし"],["、"],["ヤコブ"],["が"],["聖","せい"],["絶","ぜっ"],["される"],["よう"],["に"],["し"],["、"],["イスラエル"],["が"],["、"],["ののしられる"],["よう"],["に"],["した"],["。"],["」"]]}]
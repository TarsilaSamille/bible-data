[{"verse":1,"text":"ああ。アリエル、アリエル。／ダビデが陣を敷いた都よ。／年に年を加え、祭りを巡って来させよ。","tok":[["ああ"],["。"],["アリエル"],["、"],["アリエル"],["。"],["／"],["ダビデ"],["が"],["陣","じん"],["を"],["敷いた","しいた"],["都","みやこ"],["よ"],["。"],["／"],["年","ねん"],["に"],["年","とし"],["を"],["加え","くわえ"],["、"],["祭り","まつり"],["を"],["巡って","めぐって"],["来させよ","きさせよ"],["。"]]},{"verse":2,"text":"わたしはアリエルをしいたげるので、そこにはうめきと嘆きが起こり、そこはわたしにとっては祭壇の炉のようになる。","tok":[["わたし"],["は"],["アリエル"],["を"],["しいたげる"],["ので"],["、"],["そこ"],["に"],["は"],["うめき"],["と"],["嘆き","なげき"],["が"],["起こり","おこり"],["、"],["そこ"],["は"],["わたし"],["にとって"],["は"],["祭壇","さいだん"],["の"],["炉","ろ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":3,"text":"わたしは、あなたの回りに陣を敷き、あなたを前哨部隊で囲み、あなたに対して塁を築く。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["回り","まわり"],["に"],["陣","じん"],["を"],["敷き","しき"],["、"],["あなた"],["を"],["前哨","ぜんしょう"],["部隊","ぶたい"],["で"],["囲み","かこみ"],["、"],["あなた"],["に対して","にたいして"],["塁","るい"],["を"],["築く","きずく"],["。"]]},{"verse":4,"text":"あなたは倒れて、地の中から語りかけるが、あなたの言うことは、ちりで打ち消される。／あなたが地の中から出す声は、死人の霊の声のようになり、あなたの言うことは、ちりの中からのささやきのようになる。","tok":[["あなた"],["は"],["倒れて","たおれて"],["、"],["地","ち"],["の"],["中","なか"],["から"],["語りかける","かたりかける"],["が"],["、"],["あなた"],["の"],["言う","いう"],["こと"],["は"],["、"],["ちり"],["で"],["打ち消される","うちけされる"],["。"],["／"],["あなた"],["が"],["地","ち"],["の"],["中","なか"],["から"],["出す","だす"],["声","こえ"],["は"],["、"],["死人","しにん"],["の"],["霊","れい"],["の"],["声","こえ"],["の"],["よう"],["に"],["なり"],["、"],["あなた"],["の"],["言う","いう"],["こと"],["は"],["、"],["ちり"],["の"],["中","なか"],["から"],["の"],["ささやき"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":5,"text":"しかし、あなたの敵の群れも、細かいほこりのようになり、横暴な者の群れは、吹き飛ぶもみがらのようになる。／しかも、それはにわかに、急に起こる。","tok":[["しかし"],["、"],["あなた"],["の"],["敵","てき"],["の"],["群れ","むれ"],["も"],["、"],["細かい","こまかい"],["ほこり"],["の"],["よう"],["に"],["なり"],["、"],["横暴","おうぼう"],["な"],["者","もの"],["の"],["群れ","むれ"],["は"],["、"],["吹き飛ぶ","ふきとぶ"],["もみがら"],["の"],["よう"],["に"],["なる"],["。"],["／"],["しかも"],["、"],["それ"],["は"],["にわか"],["に"],["、"],["急","きゅう"],["に"],["起こる","おこる"],["。"]]},{"verse":6,"text":"万軍の主は、雷と地震と大きな音をもって、つむじ風と暴風と焼き尽くす火の炎をもって、あなたを訪れる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["雷","かみなり"],["と"],["地震","じしん"],["と"],["大きな","おおきな"],["音","おと"],["を"],["もって"],["、"],["つむじ風","つむじかぜ"],["と"],["暴風","ぼうふう"],["と"],["焼き","やき"],["尽くす","つくす"],["火","ひ"],["の"],["炎","ほのお"],["を"],["もって"],["、"],["あなた"],["を"],["訪れる","おとずれる"],["。"]]},{"verse":7,"text":"アリエルに戦いをいどむすべての民の群れ、これを攻めて、これを取り囲み、これをしいたげる者たちはみな、夢のようになり、夜の幻のようになる。","tok":[["アリエル"],["に"],["戦い","たたかい"],["を"],["いどむ"],["すべて"],["の"],["民","たみ"],["の"],["群れ","むれ"],["、"],["これ"],["を"],["攻めて","せめて"],["、"],["これ"],["を"],["取り囲み","とりかこみ"],["、"],["これ"],["を"],["しいたげる"],["者","もの"],["たち"],["は"],["みな"],["、"],["夢","ゆめ"],["の"],["よう"],["に"],["なり"],["、"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"飢えた者が、夢の中で食べ、目がさめると、その腹はからであるように、渇いている者が、夢の中で飲み、目がさめると、なんとも疲れて、のどが干からびているように、シオンの山に戦いをいどむすべての民の群れも、そのようになる。","tok":[["飢えた","うえた"],["者","もの"],["が"],["、"],["夢","ゆめ"],["の"],["中","なか"],["で"],["食べ","たべ"],["、"],["目","め"],["が"],["さめる"],["と"],["、"],["その"],["腹","はら"],["は"],["から"],["で"],["ある"],["よう"],["に"],["、"],["渇いて","かわいて"],["いる"],["者","もの"],["が"],["、"],["夢","ゆめ"],["の"],["中","なか"],["で"],["飲み","のみ"],["、"],["目","め"],["が"],["さめる"],["と"],["、"],["なん"],["と"],["も"],["疲れて","つかれて"],["、"],["のど"],["が"],["干からびて","ひからびて"],["いる"],["よう"],["に"],["、"],["シオン"],["の"],["山","やま"],["に"],["戦い","たたかい"],["を"],["いどむ"],["すべて"],["の"],["民","たみ"],["の"],["群れ","むれ"],["も"],["、"],["その"],["よう"],["に"],["なる"],["。"]]},{"verse":9,"text":"のろくなれ。驚け。／目を堅くつぶって見えなくなれ。／彼らは酔うが、ぶどう酒によるのではない。／ふらつくが、強い酒によるのではない。","tok":[["のろく"],["なれ"],["。"],["驚け","おどろけ"],["。"],["／"],["目","め"],["を"],["堅く","かたく"],["つぶって"],["見えなく","みえなく"],["なれ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["酔う","よう"],["が"],["、"],["ぶどう酒","ぶどうしゅ"],["に"],["よる"],["ので"],["は"],["ない"],["。"],["／"],["ふらつく"],["が"],["、"],["強い","つよい"],["酒","さけ"],["に"],["よる"],["ので"],["は"],["ない"],["。"]]},{"verse":10,"text":"主が、あなたがたの上に深い眠りの霊を注ぎ、あなたがたの目、預言者たちを閉じ、あなたがたの頭、先見者たちをおおわれたから。","tok":[["主","ぬし"],["が"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["深い","ふかい"],["眠り","ねむり"],["の"],["霊","れい"],["を"],["注ぎ","そそぎ"],["、"],["あなた"],["がた"],["の"],["目","め"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["閉じ","とじ"],["、"],["あなた"],["がた"],["の"],["頭","あたま"],["、"],["先見者","せんけんしゃ"],["たち"],["を"],["おおわれた"],["から"],["。"]]},{"verse":11,"text":"そこで、あなたがたにとっては、すべての幻が、封じられた書物のことばのようになった。これを、読み書きのできる人に渡して、「どうぞ、これを読んでください」と言っても、「これは、封じられているから読めない」と言い、","tok":[["そこ"],["で"],["、"],["あなた"],["がた"],["にとって"],["は"],["、"],["すべて"],["の"],["幻","まぼろし"],["が"],["、"],["封じられた","ふうじられた"],["書物","しょもつ"],["の"],["ことば"],["の"],["よう"],["に"],["なった"],["。"],["これ"],["を"],["、"],["読み書き","よみかき"],["の"],["できる"],["人","ひと"],["に"],["渡して","わたして"],["、"],["「"],["どうぞ"],["、"],["これ"],["を"],["読んで","よんで"],["ください"],["」"],["と"],["言って","いって"],["も"],["、"],["「"],["これ"],["は"],["、"],["封じられて","ふうじられて"],["いる"],["から"],["読めない","よめない"],["」"],["と"],["言い","いい"],["、"]]},{"verse":12,"text":"また、その書物を、読み書きのできない人に渡して、「どうぞ、これを読んでください」と言っても、「私は、読み書きができない」と答えよう。","tok":[["また"],["、"],["その"],["書物","しょもつ"],["を"],["、"],["読み書き","よみかき"],["の"],["できない"],["人","ひと"],["に"],["渡して","わたして"],["、"],["「"],["どうぞ"],["、"],["これ"],["を"],["読んで","よんで"],["ください"],["」"],["と"],["言って","いって"],["も"],["、"],["「"],["私","わたくし"],["は"],["、"],["読み書き","よみかき"],["が"],["できない"],["」"],["と"],["答えよう","こたえよう"],["。"]]},{"verse":13,"text":"そこで主は仰せられた。／「この民は口先で近づき、くちびるでわたしをあがめるが、その心はわたしから遠く離れている。／彼らがわたしを恐れるのは、人間の命令を教え込まれてのことにすぎない。","tok":[["そこ"],["で"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["／"],["「"],["この"],["民","みん"],["は"],["口先","くちさき"],["で"],["近づき","ちかづき"],["、"],["くちびる"],["で"],["わたし"],["を"],["あがめる"],["が"],["、"],["その"],["心","こころ"],["は"],["わたし"],["から"],["遠く","とおく"],["離れて","はなれて"],["いる"],["。"],["／"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["恐れる","おそれる"],["の"],["は"],["、"],["人間","にんげん"],["の"],["命令","めいれい"],["を"],["教え込まれて","おしえこまれて"],["の"],["こと"],["に"],["すぎない"],["。"]]},{"verse":14,"text":"それゆえ、見よ、わたしはこの民に再び不思議なこと、驚き怪しむべきことをする。／この民の知恵ある者の知恵は滅び、悟りある者の悟りは隠される。」","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["民","たみ"],["に"],["再び","ふたたび"],["不思議","ふしぎ"],["な"],["こと"],["、"],["驚き怪しむべき","おどろきあやしむべき"],["こと"],["を"],["する"],["。"],["／"],["この"],["民","たみ"],["の"],["知恵","ちえ"],["ある"],["者","もの"],["の"],["知恵","ちえ"],["は"],["滅び","ほろび"],["、"],["悟り","さとり"],["ある"],["者","もの"],["の"],["悟り","さとり"],["は"],["隠される","かくされる"],["。"],["」"]]},{"verse":15,"text":"ああ。／主に自分のはかりごとを深く隠す者たち。／彼らはやみの中で事を行い、そして言う。「だれが、私たちを見ていよう。／だれが、私たちを知っていよう」と。","tok":[["ああ"],["。"],["／"],["主に","おもに"],["自分","じぶん"],["の"],["はかりごと"],["を"],["深く","ふかく"],["隠す","かくす"],["者","もの"],["たち"],["。"],["／"],["彼","かれ"],["ら"],["は"],["やみ"],["の"],["中","なか"],["で"],["事","こと"],["を"],["行い","おこない"],["、"],["そして"],["言う","ゆう"],["。"],["「"],["だれ"],["が"],["、"],["私たち","わたしたち"],["を"],["見て","みて"],["いよう"],["。"],["／"],["だれ"],["が"],["、"],["私たち","わたしたち"],["を"],["知って","しって"],["いよう"],["」"],["と"],["。"]]},{"verse":16,"text":"ああ、あなたがたは、物をさかさに考えている。／陶器師を粘土と同じにみなしてよかろうか。／造られた者が、それを造った者に、「彼は私を造らなかった」と言い、陶器が陶器師に、「彼はわからずやだ」と言えようか。","tok":[["ああ"],["、"],["あなた"],["がた"],["は"],["、"],["物","もの"],["を"],["さかさ"],["に"],["考えて","かんがえて"],["いる"],["。"],["／"],["陶器師","とうきし"],["を"],["粘土","ねんど"],["と"],["同じ","おなじ"],["に"],["みなして"],["よかろう"],["か"],["。"],["／"],["造られた","つくられた"],["者","もの"],["が"],["、"],["それ"],["を"],["造った","つくった"],["者","もの"],["に"],["、"],["「"],["彼","かれ"],["は"],["私","わたくし"],["を"],["造らなかった","つくらなかった"],["」"],["と"],["言い","いい"],["、"],["陶器","とうき"],["が"],["陶器師","とうきし"],["に"],["、"],["「"],["彼","かれ"],["は"],["わからず"],["や"],["だ"],["」"],["と"],["言えよう","いえよう"],["か"],["。"]]},{"verse":17,"text":"もうしばらくすれば、確かに、レバノンは果樹園に変わり、果樹園は森とみなされるようになる。","tok":[["もう"],["しばらく"],["すれば"],["、"],["確か","たしか"],["に"],["、"],["レバノン"],["は"],["果樹園","かじゅえん"],["に"],["変わり","かわり"],["、"],["果樹園","かじゅえん"],["は"],["森","もり"],["と"],["みなされる"],["よう"],["に"],["なる"],["。"]]},{"verse":18,"text":"その日、耳の聞こえない者が書物のことばを聞き、目の見えない者の目が暗黒とやみから物を見る。","tok":[["その"],["日","ひ"],["、"],["耳","みみ"],["の"],["聞こえない","きこえない"],["者","もの"],["が"],["書物","しょもつ"],["の"],["ことば"],["を"],["聞き","きき"],["、"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["の"],["目","め"],["が"],["暗黒","あんこく"],["と"],["やみ"],["から"],["物","もの"],["を"],["見る","みる"],["。"]]},{"verse":19,"text":"へりくだる者は主によっていよいよ喜び、貧しい人はイスラエルの聖なる方によって／楽しむ。","tok":[["へりくだる"],["者","もの"],["は"],["主に","おもに"],["よって"],["いよいよ"],["喜び","よろこび"],["、"],["貧しい","まずしい"],["人","ひと"],["は"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["によって"],["／"],["楽しむ","たのしむ"],["。"]]},{"verse":20,"text":"横暴な者はいなくなり、あざける者は滅びてしまい、悪をしようとうかがう者はみな、断ち滅ぼされるからだ。","tok":[["横暴","おうぼう"],["な"],["者","もの"],["は"],["いなく"],["なり"],["、"],["あざける"],["者","もの"],["は"],["滅びて","ほろびて"],["しまい"],["、"],["悪","あく"],["を"],["しよう"],["と"],["うかがう"],["者","もの"],["は"],["みな"],["、"],["断ち","たち"],["滅ぼされる","ほろぼされる"],["から"],["だ"],["。"]]},{"verse":21,"text":"彼らは、うわさ話で他人を罪に陥れ、城門でさばきをする者のあげあしを取り、正しい人を、むなしい理由でくつがえす。","tok":[["彼","かれ"],["ら"],["は"],["、"],["うわさ話","うわさばなし"],["で"],["他人","たにん"],["を"],["罪","つみ"],["に"],["陥れ","おとしいれ"],["、"],["城門","じょうもん"],["で"],["さばき"],["を"],["する"],["者","もの"],["の"],["あげあし"],["を"],["取り","とり"],["、"],["正しい","ただしい"],["人","ひと"],["を"],["、"],["むなしい"],["理由","りゆう"],["で"],["くつがえす"],["。"]]},{"verse":22,"text":"それゆえ、アブラハムを贖われた主は、ヤコブの家について、こう仰せられる。「今からは、ヤコブは恥を見ることがない。今からは、顔色を失うことがない。","tok":[["それ"],["ゆえ"],["、"],["アブラハム"],["を"],["贖われた","あがなわれた"],["主","ぬし"],["は"],["、"],["ヤコブ"],["の"],["家","いえ"],["について"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["今","いま"],["から"],["は"],["、"],["ヤコブ"],["は"],["恥","はじ"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"],["今","いま"],["から"],["は"],["、"],["顔色","かおいろ"],["を"],["失う","うしなう"],["こと"],["が"],["ない"],["。"]]},{"verse":23,"text":"彼が自分の子らを見、自分たちの中で、わたしの手のわざを見るとき、彼らはわたしの名を聖とし、ヤコブの聖なる方を聖とし、イスラエルの神を恐れるからだ。","tok":[["彼","かれ"],["が"],["自分","じぶん"],["の"],["子","こ"],["ら"],["を"],["見","み"],["、"],["自分","じぶん"],["たち"],["の"],["中","なか"],["で"],["、"],["わたし"],["の"],["手","て"],["の"],["わざ"],["を"],["見る","みる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["名","な"],["を"],["聖","せい"],["と"],["し"],["、"],["ヤコブ"],["の"],["聖","せい"],["なる"],["方","かた"],["を"],["聖","せい"],["と"],["し"],["、"],["イスラエル"],["の"],["神","かみ"],["を"],["恐れる","おそれる"],["から"],["だ"],["。"]]},{"verse":24,"text":"心の迷っている者は悟りを得、つぶやく者もおしえを学ぶ。」","tok":[["心","こころ"],["の"],["迷って",
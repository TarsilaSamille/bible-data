[{"verse":1,"text":"ああ。／自分は踏みにじられなかったのに、人を踏みにじり、自分は裏切られなかったのに、人を裏切るあなたは。／あなたが踏みにじることを終えるとき、あなたは踏みにじられ、あなたが裏切りをやめるとき、あなたは裏切られる。","tok":[["ああ"],["。"],["／"],["自分","じぶん"],["は"],["踏みにじられなかった","ふみにじられなかった"],["のに"],["、"],["人","ひと"],["を"],["踏みにじり","ふみにじり"],["、"],["自分","じぶん"],["は"],["裏切られなかった","うらぎられなかった"],["のに"],["、"],["人","ひと"],["を"],["裏切る","うらぎる"],["あなた"],["は"],["。"],["／"],["あなた"],["が"],["踏みにじる","ふみにじる"],["こと"],["を"],["終える","おえる"],["とき"],["、"],["あなた"],["は"],["踏みにじられ","ふみにじられ"],["、"],["あなた"],["が"],["裏切り","うらぎり"],["を"],["やめる"],["とき"],["、"],["あなた"],["は"],["裏切られる","うらぎられる"],["。"]]},{"verse":2,"text":"主よ。私たちをあわれんでください。／私たちはあなたを待ち望みます。／朝ごとに、私たちの腕となり、苦難の時の私たちの救いとなってください。","tok":[["主","ぬし"],["よ"],["。"],["私たち","わたしたち"],["を"],["あわれんで"],["ください"],["。"],["／"],["私たち","わたしたち"],["は"],["あなた"],["を"],["待ち望みます","まちのぞみます"],["。"],["／"],["朝","あさ"],["ごと"],["に"],["、"],["私たち","わたしたち"],["の"],["腕","うで"],["と"],["なり"],["、"],["苦難","くなん"],["の"],["時","とき"],["の"],["私たち","わたしたち"],["の"],["救い","すくい"],["と"],["なって"],["ください"],["。"]]},{"verse":3,"text":"騒ぎの声に国々の民は逃げ、あなたが立ち上がると、国は散らされます。","tok":[["騒ぎ","さわぎ"],["の"],["声","こえ"],["に"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["逃げ","にげ"],["、"],["あなた"],["が"],["立ち上がる","たちあがる"],["と"],["、"],["国","くに"],["は"],["散らされます","ちらされます"],["。"]]},{"verse":4,"text":"あなたがたの分捕り物は、油虫が物を集めるように集められ、いなごの群れが飛びつくように飛びつかれる。","tok":[["あなた"],["がた"],["の"],["分","ぶん"],["捕り物","とりもの"],["は"],["、"],["油虫","あぶらむし"],["が"],["物","もの"],["を"],["集める","あつめる"],["よう"],["に"],["集められ","あつめられ"],["、"],["いなご"],["の"],["群れ","むれ"],["が"],["飛びつく","とびつく"],["よう"],["に"],["飛びつかれる","とびつかれる"],["。"]]},{"verse":5,"text":"主はいと高き方で、高い所に住み、シオンを公正と正義で満たされる。","tok":[["主","ぬし"],["は"],["いと"],["高き","たかき"],["方","ほう"],["で"],["、"],["高い","たかい"],["所","ところ"],["に"],["住み","すみ"],["、"],["シオン"],["を"],["公正","こうせい"],["と"],["正義","せいぎ"],["で"],["満たされる","みたされる"],["。"]]},{"verse":6,"text":"あなたの時代は堅く立つ。／知恵と知識とが、救いの富である。／主を恐れることが、その財宝である。","tok":[["あなた"],["の"],["時代","じだい"],["は"],["堅く","かたく"],["立つ","たつ"],["。"],["／"],["知恵","ちえ"],["と"],["知識","ちしき"],["と"],["が"],["、"],["救い","すくい"],["の"],["富","とみ"],["で"],["ある"],["。"],["／"],["主","ぬし"],["を"],["恐れる","おそれる"],["こと"],["が"],["、"],["その"],["財宝","ざいほう"],["で"],["ある"],["。"]]},{"verse":7,"text":"見よ。彼らの勇士はちまたで叫び、平和の使者たちは激しく泣く。","tok":[["見","み"],["よ"],["。"],["彼","かれ"],["ら"],["の"],["勇士","ゆうし"],["は"],["ちまた"],["で"],["叫び","さけび"],["、"],["平和","へいわ"],["の"],["使者","ししゃ"],["たち"],["は"],["激しく","はげしく"],["泣く","なく"],["。"]]},{"verse":8,"text":"大路は荒れ果て、道行く者はとだえ、契約は破られ、町々は捨てられ、人は顧みられない。","tok":[["大路","おおじ"],["は"],["荒れ果て","あれはて"],["、"],["道","みち"],["行く","いく"],["者","もの"],["は"],["とだえ"],["、"],["契約","けいやく"],["は"],["破られ","やぶられ"],["、"],["町々","まちまち"],["は"],["捨てられ","すてられ"],["、"],["人","ひと"],["は"],["顧みられない","かえりみられない"],["。"]]},{"verse":9,"text":"国は喪に服し、しおれ、レバノンははずかしめを受けて、しなび、シャロンは荒地のようになり、バシャンもカルメルも葉を振り落とす。","tok":[["国","くに"],["は"],["喪","も"],["に"],["服し","ふくし"],["、"],["しおれ"],["、"],["レバノン"],["は"],["はずかしめ"],["を"],["受けて","うけて"],["、"],["しなび"],["、"],["シャロン"],["は"],["荒地","あれち"],["の"],["よう"],["に"],["なり"],["、"],["バシャン"],["も"],["カルメル"],["も"],["葉","は"],["を"],["振り落とす","ふりおとす"],["。"]]},{"verse":10,"text":"「今、わたしは立ち上がる」と主は仰せられる。／「今、わたしは自分を高め、今、あがめられるようにしよう。","tok":[["「"],["今","いま"],["、"],["わたし"],["は"],["立ち上がる","たちあがる"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["／"],["「"],["今","いま"],["、"],["わたし"],["は"],["自分","じぶん"],["を"],["高め","たかめ"],["、"],["今","いま"],["、"],["あがめられる"],["よう"],["に"],["しよう"],["。"]]},{"verse":11,"text":"あなたがたは枯れ草をはらみ、わらを産む。／あなたがたの息は、あなたがたを食い尽くす火だ。","tok":[["あなた"],["がた"],["は"],["枯れ草","かれくさ"],["を"],["はらみ"],["、"],["わら"],["を"],["産む","うむ"],["。"],["／"],["あなた"],["がた"],["の"],["息","いき"],["は"],["、"],["あなた"],["がた"],["を"],["食い","くい"],["尽くす","つくす"],["火","ひ"],["だ"],["。"]]},{"verse":12,"text":"国々の民は焼かれて石灰となり、刈り取られて火をつけられるいばらとなる。","tok":[["国々","くにぐに"],["の"],["民","たみ"],["は"],["焼かれて","やかれて"],["石灰","せっかい"],["と"],["なり"],["、"],["刈り取られて","かりとられて"],["火","ひ"],["を"],["つけられる"],["いばら"],["と"],["なる"],["。"]]},{"verse":13,"text":"遠くの者よ。わたしのしたことを聞け。／近くの者よ。わたしの力を知れ。」","tok":[["遠く","とおく"],["の"],["者","もの"],["よ"],["。"],["わたし"],["の"],["した"],["こと"],["を"],["聞け","きけ"],["。"],["／"],["近く","ちかく"],["の"],["者","もの"],["よ"],["。"],["わたし"],["の"],["力","ちから"],["を"],["知れ","しれ"],["。"],["」"]]},{"verse":14,"text":"罪人たちはシオンでわななき、神を敬わない者は恐怖に取りつかれる。「私たちのうち、だれが焼き尽くす火に耐えられよう。私たちのうち、だれがとこしえに燃える炉に耐えられよう。」","tok":[["罪人","ざいにん"],["たち"],["は"],["シオン"],["で"],["わななき"],["、"],["神","かみ"],["を"],["敬わない","うやまわない"],["者","もの"],["は"],["恐怖","きょうふ"],["に"],["取りつかれる","とりつかれる"],["。"],["「"],["私たち","わたしたち"],["の"],["うち"],["、"],["だれ"],["が"],["焼き","やき"],["尽くす","つくす"],["火","ひ"],["に"],["耐えられよう","たえられよう"],["。"],["私たち","わたしたち"],["の"],["うち"],["、"],["だれ"],["が"],["とこしえ"],["に"],["燃える","もえる"],["炉","ろ"],["に"],["耐えられよう","たえられよう"],["。"],["」"]]},{"verse":15,"text":"正義を行う者、まっすぐに語る者、強奪による利得を退ける者、手を振ってわいろを取らない者、耳を閉じて血なまぐさいことを聞かない者、目を閉じて悪いことを見ない者、","tok":[["正義","せいぎ"],["を"],["行う","おこなう"],["者","もの"],["、"],["まっすぐ"],["に"],["語る","かたる"],["者","もの"],["、"],["強奪","ごうだつ"],["に"],["よる"],["利得","りとく"],["を"],["退ける","しりぞける"],["者","もの"],["、"],["手","て"],["を"],["振って","ふって"],["わいろ"],["を"],["取らない","とらない"],["者","もの"],["、"],["耳","みみ"],["を"],["閉じて","とじて"],["血なまぐさい","ちなまぐさい"],["こと"],["を"],["聞かない","きかない"],["者","もの"],["、"],["目","め"],["を"],["閉じて","とじて"],["悪い","わるい"],["こと"],["を"],["見ない","みない"],["者","もの"],["、"]]},{"verse":16,"text":"このような人は、高い所に住み、そのとりでは岩の上の要害である。／彼のパンは与えられ、その水は確保される。","tok":[["この"],["よう"],["な"],["人","ひと"],["は"],["、"],["高い","たかい"],["所","ところ"],["に"],["住み","すみ"],["、"],["その"],["とり"],["で"],["は"],["岩","いわ"],["の"],["上","うえ"],["の"],["要害","ようがい"],["で"],["ある"],["。"],["／"],["彼","かれ"],["の"],["パン"],["は"],["与えられ","あたえられ"],["、"],["その"],["水","みず"],["は"],["確保","かくほ"],["される"],["。"]]},{"verse":17,"text":"あなたの目は、麗しい王を見、遠く広がった国を見る。","tok":[["あなた"],["の"],["目","め"],["は"],["、"],["麗しい","うるわしい"],["王","おう"],["を"],["見","み"],["、"],["遠く","とおく"],["広がった","ひろがった"],["国","くに"],["を"],["見る","みる"],["。"]]},{"verse":18,"text":"あなたの心は、恐ろしかった事どもを思い起こす。「数えた者はどこへ行ったのか。測った者はどこへ行ったのか。やぐらを数えた者はどこへ行ったのか。」","tok":[["あなた"],["の"],["心","こころ"],["は"],["、"],["恐ろしかった","おそろしかった"],["事","こと"],["ども"],["を"],["思い起こす","おもいおこす"],["。"],["「"],["数えた","かぞえた
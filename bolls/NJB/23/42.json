[{"verse":1,"text":"見よ。わたしのささえるわたしのしもべ、わたしの心の喜ぶわたしが選んだ者。／わたしは彼の上にわたしの霊を授け、彼は国々に公義をもたらす。","tok":[["見","み"],["よ"],["。"],["わたし"],["の"],["ささえる"],["わたし"],["の"],["しもべ"],["、"],["わたし"],["の"],["心","こころ"],["の"],["喜ぶ","よろこぶ"],["わたし"],["が"],["選んだ","えらんだ"],["者","もの"],["。"],["／"],["わたし"],["は"],["彼","かれ"],["の"],["上","うえ"],["に"],["わたし"],["の"],["霊","れい"],["を"],["授け","さずけ"],["、"],["彼","かれ"],["は"],["国々","くにぐに"],["に"],["公義","きみよし"],["を"],["もたらす"],["。"]]},{"verse":2,"text":"彼は叫ばず、声をあげず、ちまたにその声を聞かせない。","tok":[["彼","かれ"],["は"],["叫ばず","さけばず"],["、"],["声","こえ"],["を"],["あげず"],["、"],["ちまた"],["に"],["その"],["声","こえ"],["を"],["聞かせない","きかせない"],["。"]]},{"verse":3,"text":"彼はいたんだ葦を折ることもなく、くすぶる燈心を消すこともなく、まことをもって公義をもたらす。","tok":[["彼","かれ"],["は"],["いたんだ"],["葦","あし"],["を"],["折る","おる"],["こと"],["も"],["なく"],["、"],["くすぶる"],["燈心","とうしん"],["を"],["消す","けす"],["こと"],["も"],["なく"],["、"],["まこと"],["を"],["もって"],["公義","きみよし"],["を"],["もたらす"],["。"]]},{"verse":4,"text":"彼は衰えず、くじけない。／ついには、地に公義を打ち立てる。／島々も、そのおしえを待ち望む。","tok":[["彼","かれ"],["は"],["衰えず","おとろえず"],["、"],["くじけない"],["。"],["／"],["ついに"],["は"],["、"],["地","ち"],["に"],["公義","きみよし"],["を"],["打ち立てる","うちたてる"],["。"],["／"],["島々","しまじま"],["も"],["、"],["その"],["おしえ"],["を"],["待ち望む","まちのぞむ"],["。"]]},{"verse":5,"text":"天を造り出し、これを引き延べ、地とその産物を押し広め、その上の民に息を与え、この上を歩む者に霊を授けた神なる主は／こう仰せられる。","tok":[["天","てん"],["を"],["造り出し","つくりだし"],["、"],["これ"],["を"],["引き","ひき"],["延べ","のべ"],["、"],["地","ち"],["と"],["その"],["産物","さんぶつ"],["を"],["押し広め","おしひろめ"],["、"],["その"],["上","うえ"],["の"],["民","たみ"],["に"],["息","いき"],["を"],["与え","あたえ"],["、"],["この"],["上","うえ"],["を"],["歩む","あゆむ"],["者","もの"],["に"],["霊","れい"],["を"],["授けた","さずけた"],["神","かみ"],["なる"],["主","ぬし"],["は"],["／"],["こう"],["仰せられる","おおせられる"],["。"]]},{"verse":6,"text":"「わたし、主は、義をもってあなたを召し、あなたの手を握り、あなたを見守り、あなたを民の契約とし、国々の光とする。","tok":[["「"],["わたし"],["、"],["主","ぬし"],["は"],["、"],["義","ぎ"],["を"],["もって"],["あなた"],["を"],["召し","めし"],["、"],["あなた"],["の"],["手","て"],["を"],["握り","にぎり"],["、"],["あなた"],["を"],["見守り","みまもり"],["、"],["あなた"],["を"],["民","たみ"],["の"],["契約","けいやく"],["と"],["し"],["、"],["国々","くにぐに"],["の"],["光","ひかり"],["と"],["する"],["。"]]},{"verse":7,"text":"こうして、見えない目を開き、囚人を牢獄から、やみの中に住む者を獄屋から連れ出す。","tok":[["こう"],["して"],["、"],["見えない","みえない"],["目","め"],["を"],["開き","ひらき"],["、"],["囚人","しゅうじん"],["を"],["牢獄","ろうごく"],["から"],["、"],["やみ"],["の"],["中","なか"],["に"],["住む","すむ"],["者","もの"],["を"],["獄屋","ごくや"],["から"],["連れ出す","つれだす"],["。"]]},{"verse":8,"text":"わたしは主、これがわたしの名。／わたしの栄光を他の者に、わたしの栄誉を刻んだ像どもに与えはしない。","tok":[["わたし"],["は"],["主","ぬし"],["、"],["これ"],["が"],["わたし"],["の"],["名","な"],["。"],["／"],["わたし"],["の"],["栄光","えいこう"],["を"],["他","ほか"],["の"],["者","もの"],["に"],["、"],["わたし"],["の"],["栄誉","えいよ"],["を"],["刻んだ","きざんだ"],["像","ぞう"],["ども"],["に"],["与え","あたえ"],["は"],["しない"],["。"]]},{"verse":9,"text":"先の事は、見よ、すでに起こった。／新しい事を、わたしは告げよう。／それが起こる前に、あなたがたに聞かせよう。」","tok":[["先","さき"],["の"],["事","こと"],["は"],["、"],["見よ","みよ"],["、"],["すでに"],["起こった","おこった"],["。"],["／"],["新しい","あたらしい"],["事","こと"],["を"],["、"],["わたし"],["は"],["告げよう","つげよう"],["。"],["／"],["それ"],["が"],["起こる","おこる"],["前","まえ"],["に"],["、"],["あなた"],["がた"],["に"],["聞かせよう","きかせよう"],["。"],["」"]]},{"verse":10,"text":"主に向かって新しい歌を歌え、その栄誉を地の果てから。／海に下る者、そこを渡るすべての者、島々とそこに住む者よ。","tok":[["主に","おもに"],["向かって","むかって"],["新しい","あたらしい"],["歌","うた"],["を"],["歌え","うたえ"],["、"],["その"],["栄誉","えいよ"],["を"],["地","ち"],["の"],["果て","はて"],["から"],["。"],["／"],["海","うみ"],["に"],["下る","くだる"],["者","もの"],["、"],["そこ"],["を"],["渡る","わたる"],["すべて"],["の"],["者","もの"],["、"],["島々","しまじま"],["と"],["そこ"],["に"],["住む","すむ"],["者","もの"],["よ"],["。"]]},{"verse":11,"text":"荒野とその町々、ケダル人の住む村々よ。声をあげよ。／セラに住む者は喜び歌え。／山々の頂から声高らかに叫べ。","tok":[["荒野","こうや"],["と"],["その"],["町々","まちまち"],["、"],["ケダル人","けだるにん"],["の"],["住む","すむ"],["村々","むらむら"],["よ"],["。"],["声","こえ"],["を"],["あげ"],["よ"],["。"],["／"],["セラ"],["に"],["住む","すむ"],["者","もの"],["は"],["喜び歌え","よろこびうたえ"],["。"],["／"],["山々","やまやま"],["の"],["頂","いただき"],["から"],["声","こえ"],["高らか","たからか"],["に"],["叫べ","さけべ"],["。"]]},{"verse":12,"text":"主に栄光を帰し、島々にその栄誉を告げ知らせよ。","tok":[["主に","おもに"],["栄光","えいこう"],["を"],["帰し","かえし"],["、"],["島々","しまじま"],["に"],["その"],["栄誉","えいよ"],["を"],["告げ知らせ","つげしらせ"],["よ"],["。"]]},{"verse":13,"text":"主は勇士のようにいで立ち、戦士のように激しく奮い立ち、ときの声をあげて叫び、敵に向かって威力を現す。","tok":[["主","ぬし"],["は"],["勇士","ゆうし"],["の"],["よう"],["に"],["いで立ち","いでたち"],["、"],["戦士","せんし"],["の"],["よう"],["に"],["激しく","はげしく"],["奮い立ち","ふるいたち"],["、"],["とき"],["の"],["声","こえ"],["を"],["あげて"],["叫び","さけび"],["、"],["敵","てき"],["に"],["向かって","むかって"],["威力","いりょく"],["を"],["現す","あらわす"],["。"]]},{"verse":14,"text":"わたしは久しく黙っていた。／静かに自分を押さえていた。／今は、子を産む女のようにうめき、激しい息づかいであえぐ。","tok":[["わたし"],["は"],["久しく","ひさしく"],["黙って","だまって"],["いた"],["。"],["／"],["静か","しずか"],["に"],["自分","じぶん"],["を"],["押さえて","おさえて"],["いた"],["。"],["／"],["今","いま"],["は"],["、"],["子","こ"],["を"],["産む","うむ"],["女","おんな"],["の"],["よう"],["に"],["うめき"],["、"],["激しい","はげしい"],["息づかい","いきづかい"],["で"],["あえぐ"],["。"]]},{"verse":15,"text":"わたしは山や丘を荒らし、そのすべての青草を枯らし、川をかわいた地とし、沢をからす。","tok":[["わたし"],["は"],["山","やま"],["や"],["丘","おか"],["を"],["荒らし","あらし"],["、"],["その"],["すべて"],["の"],["青草","あおくさ"],["を"],["枯らし","からし"],["、"],["川","かわ"],["を"],["かわいた"],["地","ち"],["と"],["し"],["、"],["沢","さわ"],["を"],["からす"],["。"]]},{"verse":16,"text":"わたしは目の見えない者に、彼らの知らない道を歩ませ、彼らの知らない通り道を行かせる。／彼らの前でやみを光に、でこぼこの地を平らにする。／これらのことをわたしがして、彼らを見捨てない。","tok":[["わたし"],["は"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["に"],["、"],["彼","かれ"],["ら"],["の"],["知らない","しらない"],["道","みち"],["を"],["歩ませ","あゆませ"],["、"],["彼","かれ"],["ら"],["の"],["知らない","しらない"],["通り道","とおりみち"],["を"],["行かせる","いかせる"],["。"],["／"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["やみ"],["を"],["光","ひかり"],["に"],["、"],["でこぼこ"],["の"],["地","ち"],["を"],["平ら","たいら"],["に"],["する"],["。"],["／"],["これ"],["ら"],["の"],["こと"],["を"],["わたし"],["が"],["して"],["、"],["彼","かれ"],["ら"],["を"],["見捨てない","みすてない"],["。"]]},{"verse":17,"text":"彫像に拠り頼み、鋳像に、「あなたがたこそ、私たちの神々」と言う者は、退けられて、恥を見る。","tok":[["彫像","ちょうぞう"],["に"],["拠り","より"],["頼み","たのみ"],["、"],["鋳像","ちゅうぞう"],["に"],["、"],["「"],["あなた"],["がた"],["こそ"],["、"],["私たち","わたしたち"],["の"],["神々","かみがみ"],["」"],["と"],["言う","いう"],["者","もの"],["は"],["、"],["退けられて","しりぞけられて"],["、"],["恥","はじ"],["を"],["見る","みる"],["。"]]},{"verse":18,"text":"耳の聞こえない者たちよ、聞け。／目の見えない者たちよ、目をこらして見よ。","tok":[["耳","みみ"],["の"],["聞こえない","きこえない"],["者","もの"],["たち"],["よ"],["、"],["聞け","きけ"],["。"],["／"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["たち"],["よ"],["、"],["目","め"],["を"],["こらして"],["見","み"],["よ"],["。"]]},{"verse":19,"text":"わたしのしもべほどの盲目の者が、だれかほかにいようか。／わたしの送る使者のような耳の聞こえない者が、ほかにいようか。／わたしに買い取られた者のような盲目の者、主のしもべのような盲目の者が、だれかほかにいようか。","tok":[["わたし"],["の"],["しもべ"],["ほど"],["の"],["盲目","もうもく"],["の"],["者","もの"],["が"],["、"],["だれ"],["か"],["ほか"],["に"],["いよう"],["か"],["。"],["／"],["わたし"],["の"],["送る","おくる"],["使者","ししゃ"],["の"],["よう"],["な"],["耳","みみ"],["の"],["聞こえない","きこえない"],["者","もの"],["が"],["、"],["ほか"],["に"],["いよう"],["か"],["。"],["／"],["わたし"],["に"],["買い取られた","かいとられた"],["者","もの"],["の"],["よう"],["な"],["盲目","もうもく"],["の"],["者","もの"],["、"],["主","ぬし"],["の"],["しもべ"],["の"],["よう"],["な"],["盲目","もうもく"],["の"],["者","もの"],["が"],["、"],["だれ"],["か"],["ほか"],["に"],["いよう"],["か"],["。"]]},{"verse":20,"text":"あなたは多くのことを見ながら、心に留めず、耳を開きながら、聞こうとしない。","tok":[["あなた"],["は"],["多く","おおく"],["の"],["こと"],["を"],["見","み"],["ながら"],["、"],["心","こころ"],["に"],["留めず","とめず"],["、"],["耳","みみ"],["を"],["開き","ひらき"],["ながら"],["、"],["聞こう","きこう"],["と"],["しない"],["。"]]},{"verse":21,"text":"主は、ご自分の義のために、みおしえを広め、これを輝かすことを望まれた。","tok":[["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["の"],["義","ぎ"],["の"],["ため"],["に"],["、"],["みおしえ"],["を"],["広め","ひろめ"],["、"],["これ"],["を"],["輝かす","かがやかす"],["こと"],["を"],["望まれた","のぞまれた"],["。"]]},{"verse":22,"text":"これは、かすめ奪われ、略奪された民のことであって、若い男たちはみな、わなにかかり、獄屋に閉じ込められた。／彼らはかすめ奪われたが、助け出す者もなく、奪い取られても、それを返せと言う者もいない。","tok":[["これ"],["は"],["、"],["かすめ"],["奪われ","うばわれ"],["、"],["略奪","りゃくだつ"],["された"],["民","たみ"],["の"],["こと"],["で"],["あって"],["、"],["若い","わかい"],["男","おとこ"],["たち"],["は"],["みな"],["、"],["わな"],["に"],["かかり"],["、"],["獄屋","ごくや"],["に"],["閉じ込められた","とじこめられた"],["。"],["／"],["彼","かれ"],["ら"],["は"],["かすめ"],["奪われた","うばわれた"],["が"],["、"],["助け出す","たすけだす"],["者","もの"],["も"],["なく"],["、"],["奪い取られて","うばいとられて"],["も"],["、"],["それ"],["を"],["返せ","かえせ"],["と"],["言う","いう"],["者","もの"],["も"],["いない"],["。"]]},{"verse":23,"text":"あなたがたのうち、だれが、これに耳を傾け、だれが、後々のために注意して聞くだろうか。","tok":[["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["が"],["、"],["これ"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["だれ"],["が"],["、"],["後々","のちのち"],["の"],["ため"],["に"],["注意","ちゅうい"],["して"],["聞くだろう","きくだろう"],["か"],["。"]]},{"verse":24,"text":"だれが、ヤコブを、奪い取る者に渡し、イスラエルを、かすめ奪う者に渡したのか。／それは主ではないか。／この方に、私たちは罪を犯し、主の道に歩むことを望まず、そのおしえに聞き従わなかった。","tok":[["だれ"],["が"],["、"],["ヤコブ"],["を"],["、"],["奪い取る","うばいとる"],["者","もの"],["に"],["渡し","わたし"],["、"],["イスラエル"],["を"],["、"],["かすめ"],["奪う","うばう"],["者","もの"],["に"],["渡した","わたした"],["の"],["か"],["。"],["／"],["それ"],["は"],["主","ぬし"],["で"],["は"],["ない"],["か"],["。"],["／"],["この"],["方","かた"],["に"],["、"],["私たち","わたしたち"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["主","ぬし"],["の"],["道","みち"],["に"],["歩む","あゆむ"],["こと"],["を"],["望まず","のぞまず"],["、"],["その"],["おしえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"]]},{"verse":25,"text":"そこで主は、燃える怒りをこれに注ぎ、激しい戦いをこれに向けた。／それがあたりを焼き尽くしても、彼は悟らず、自分に燃えついても、心に留めなかった。","tok":[["そこ"],["で"],["主","ぬし"],["は"],["、"],["燃える","もえる"],["怒り","いかり"],["を"],["これ"],["に"],["注ぎ","そそぎ"],["、"],["激しい","はげしい"],["戦い","たたかい"],["を"],["これ"],["に"],["向けた","むけた"],["。"],["／"],["それ"],["が"],["あたり"],["を"],["焼き","やき"],["尽くして","つくして"],["も"],["、"],["彼","かれ"],["は"],["悟らず","さとらず"],["、"],["自分","じぶん"],["に"],["燃えついて","もえついて"],["も"],["、"],["心","こころ"],["に"],["留めなかった","とめなかった"],["。"]]}]
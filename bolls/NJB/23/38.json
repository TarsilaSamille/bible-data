[{"verse":1,"text":"そのころ、ヒゼキヤは病気になって死にかかっていた。そこへ、アモツの子、預言者イザヤが来て、彼に言った。「主はこう仰せられます。『あなたの家を整理せよ。あなたは死ぬ。直らない。』」","tok":[["その"],["ころ"],["、"],["ヒゼキヤ"],["は"],["病気","びょうき"],["に"],["なって"],["死にかかって","しにかかって"],["いた"],["。"],["そこ"],["へ"],["、"],["アモツ"],["の"],["子","こ"],["、"],["預言者","よげんしゃ"],["イザヤ"],["が"],["来て","きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["あなた"],["の"],["家","いえ"],["を"],["整理","せいり"],["せよ"],["。"],["あなた"],["は"],["死ぬ","しぬ"],["。"],["直らない","なおらない"],["。"],["』"],["」"]]},{"verse":2,"text":"そこでヒゼキヤは顔を壁に向けて、主に祈って、","tok":[["そこ"],["で"],["ヒゼキヤ"],["は"],["顔","かお"],["を"],["壁","かべ"],["に"],["向けて","むけて"],["、"],["主に","おもに"],["祈って","いのって"],["、"]]},{"verse":3,"text":"言った。「ああ、主よ。どうか思い出してください。私が、まことを尽くし、全き心をもって、あなたの御前に歩み、あなたがよいと見られることを行ってきたことを。」こうして、ヒゼキヤは大声で泣いた。","tok":[["言った","いった"],["。"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["思い出して","おもいだして"],["ください"],["。"],["私","わたくし"],["が"],["、"],["まこと"],["を"],["尽くし","つくし"],["、"],["全","ぜん"],["き"],["心","こころ"],["を"],["もって"],["、"],["あなた"],["の"],["御前","ごぜん"],["に"],["歩み","あゆみ"],["、"],["あなた"],["が"],["よい"],["と"],["見られる","みられる"],["こと"],["を"],["行って","おこなって"],["きた"],["こと"],["を"],["。"],["」"],["こう"],["して"],["、"],["ヒゼキヤ"],["は"],["大声","おおごえ"],["で"],["泣いた","ないた"],["。"]]},{"verse":4,"text":"そのとき、イザヤに次のような主のことばがあった。","tok":[["その"],["とき"],["、"],["イザヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":5,"text":"「行って、ヒゼキヤに告げよ。／あなたの父ダビデの神、主は、こう仰せられます。『わたしはあなたの祈りを聞いた。あなたの涙も見た。見よ。わたしはあなたの寿命にもう十五年を加えよう。","tok":[["「"],["行って","いって"],["、"],["ヒゼキヤ"],["に"],["告げ","つげ"],["よ"],["。"],["／"],["あなた"],["の"],["父","ちち"],["ダビデ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["わたし"],["は"],["あなた"],["の"],["祈り","いのり"],["を"],["聞いた","きいた"],["。"],["あなた"],["の"],["涙","なみだ"],["も"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["の"],["寿命","じゅみょう"],["に"],["もう"],["十五","じゅうご"],["年","ねん"],["を"],["加えよう","くわえよう"],["。"]]},{"verse":6,"text":"わたしはアッシリヤの王の手から、あなたとこの町を救い出し、この町を守る。』","tok":[["わたし"],["は"],["アッシリヤ"],["の"],["王","おう"],["の"],["手","て"],["から"],["、"],["あなた"],["と"],["この"],["町","まち"],["を"],["救い出し","すくいだし"],["、"],["この"],["町","まち"],["を"],["守る","まもる"],["。"],["』"]]},{"verse":7,"text":"これがあなたへの主からのしるしです。主は約束されたこのことを成就されます。","tok":[["これ"],["が"],["あなた"],["へ"],["の"],["主","ぬし"],["から"],["の"],["しるし"],["です"],["。"],["主","ぬし"],["は"],["約束","やくそく"],["された"],["この"],["こと"],["を"],["成就","じょうじゅ"],["されます"],["。"]]},{"verse":8,"text":"見よ。わたしは、アハズの日時計におりた時計の影を、十度あとに戻す。」すると、日時計におりた日が十度戻った。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["アハズ"],["の"],["日時計","ひどけい"],["に"],["おりた"],["時計","とけい"],["の"],["影","かげ"],["を"],["、"],["十","じゅう"],["度","ど"],["あと"],["に"],["戻す","もどす"],["。"],["」"],["する"],["と"],["、"],["日時計","ひどけい"],["に"],["おりた"],["日","ひ"],["が"],["十","じゅう"],["度","ど"],["戻った","もどった"],["。"]]},{"verse":9,"text":"ユダの王ヒゼキヤが、病気になって、その病気から回復したときにしるしたもの。","tok":[["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["が"],["、"],["病気","びょうき"],["に"],["なって"],["、"],["その"],["病気","びょうき"],["から"],["回復","かいふく"],["した"],["とき"],["に"],["しるした"],["もの"],["。"]]},{"verse":10,"text":"私は言った。／私は生涯の半ばで、よみの門に入る。／私は、私の残りの年を失ってしまった。","tok":[["私","わたくし"],["は"],["言った","いった"],["。"],["／"],["私","わたくし"],["は"],["生涯","しょうがい"],["の"],["半ば","なかば"],["で"],["、"],["よみ"],["の"],["門","もん"],["に"],["入る","はいる"],["。"],["／"],["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["残り","のこり"],["の"],["年","とし"],["を"],["失って","うしなって"],["しまった"],["。"]]},{"verse":11,"text":"私は言った。／私は主を見ない。生ける者の地で主を見ない。／死人の国の住人とともに、再び人を見ることがない。","tok":[["私","わたくし"],["は"],["言った","いった"],["。"],["／"],["私","わたくし"],["は"],["主","ぬし"],["を"],["見ない","みない"],["。"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["主","ぬし"],["を"],["見ない","みない"],["。"],["／"],["死人","しにん"],["の"],["国","くに"],["の"],["住人","じゅうにん"],["と"],["とも"],["に"],["、"],["再び","ふたたび"],["人","ひと"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"]]},{"verse":12,"text":"私の住みかは牧者の天幕のように引き抜かれ、私から取り去られた。／私は、私のいのちを機織りのように巻いた。／主は私を、機から断ち切る。／あなたは昼も夜も、私を全く捨てておかれます。","tok":[["私","わたくし"],["の"],["住みか","すみか"],["は"],["牧者","ぼくしゃ"],["の"],["天幕","てんまく"],["の"],["よう"],["に"],["引き抜かれ","ひきぬかれ"],["、"],["私","わたくし"],["から"],["取り去られた","とりさられた"],["。"],["／"],["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["機織り","はたおり"],["の"],["よう"],["に"],["巻いた","まいた"],["。"],["／"],["主","ぬし"],["は"],["私","わたくし"],["を"],["、"],["機","き"],["から"],["断ち切る","たちきる"],["。"],["／"],["あなた"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["、"],["私","わたくし"],["を"],["全く","まったく"],["捨てて","すてて"],["おかれます"],["。"]]},{"verse":13,"text":"私は朝まで叫びました。／主は、雄獅子のように／私のすべての骨を砕かれます。／あなたは昼も夜も、私を全く捨てておかれます。","tok":[["私","わたくし"],["は"],["朝","あさ"],["まで"],["叫びました","さけびました"],["。"],["／"],["主","ぬし"],["は"],["、"],["雄","ゆう"],["獅子","しし"],["の"],["よう"],["に"],["／"],["私","わたくし"],["の"],["すべて"],["の"],["骨","ほね"],["を"],["砕かれます","くだかれます"],["。"],["／"],["あなた"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["、"],["私","わたくし"],["を"],["全く","まったく"],["捨てて","すてて"],["おかれます"],["。"]]},{"verse":14,"text":"つばめや、つるのように、私は泣き、鳩のように、うめきました。／私の目は、上を仰いで衰えました。／主よ。私はしいたげられています。／私の保証人となってください。","tok":[["つばめ"],["や"],["、"],["つる"],["の"],["よう"],["に"],["、"],["私","わたくし"],["は"],["泣き","なき"],["、"],["鳩","はと"],["の"],["よう"],["に"],["、"],["うめきました"],["。"],["／"],["私","わたくし"],["の"],["目","め"],["は"],["、"],["上","うえ"],["を"],["仰いで","あおいで"],["衰えました","おとろえました"],["。"],["／"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["しいたげられて"],["います"],["。"],["／"],["私","わたくし"],["の"],["保証人","ほしょうにん"],["と"],["なって"],["ください"],["。"]]},{"verse":15,"text":"何を私は語れましょう。／主が私に語り、主みずから行われたのに。／私は私のすべての年月、私のたましいの苦しみのために、静かに歩みます。","tok":[["何","なん"],["を"],["私","わたくし"],["は"],["語れましょう","かたれましょう"],["。"],["／"],["主","ぬし"],["が"],["私","わたくし"],["に"],["語り","かたり"],["、"],["主","ぬし"],["みずから"],["行われた","おこなわれた"],["のに"],["。"],["／"],["私","わたくし"],["は"],["私","わたくし"],["の"],["すべて"],["の"],["年月","としつき"],["、"],["私","わたくし"],["の"],["たましい"],["の"],["苦しみ","くるしみ"],["の"],["ため"],["に"],["、"],["静か","しずか"],["に"],["歩みます","あゆみます"],["。"]]},{"verse":16,"text":"主よ。これらによって、人は生きるのです。／私の息のいのちも、すべてこれらに従っています。／どうか、私を健やかにし、私を生かしてください。","tok":[["主","ぬし"],["よ"],["。"],["これ"],["ら"],["によって"],["、"],["人","ひと"],["は"],["生きる","いきる"],["の"],["です"],["。"],["／"],["私","わたくし"],["の"],["息","いき"],["の"],["いのち"],["も"],["、"],["すべて"],["これ"],["ら"],["に"],["従って","したがって"],["います"],["。"],["／"],["どう"],["か"],["、"],["私","わたくし"],["を"],["健やか","すこやか"],["に"],["し"],["、"],["私","わたくし"],["を"],["生かして","いかして"],["ください"],["。"]]},{"verse":17,"text":"ああ、私の苦しんだ苦しみは／平安のためでした。／あなたは、滅びの穴から、私のたましいを引き戻されました。／あなたは私のすべての罪を、あなたのうしろに投げやられました。","tok":[["ああ"],["、"],["私","わたくし"],["の"],["苦しんだ","くるしんだ"],["苦しみ","くるしみ"],["は"],["／"],["平安","へいあん"],["の"],["ため"],["でした"],["。"],["／"],["あなた"],["は"],["、"],["滅び","ほろび"],["の"],["穴","あな"],["から"],["、"],["私","わたくし"],["の"],["たましい"],["を"],["引き戻されました","ひきもどされました"],["。"],["／"],["あなた"],["は"],["私","わたくし"],["の"],["すべて"],["の"],["罪","つみ"],["を"],["、"],["あなた"],["の"],["うしろ"],["に"],["投げやられました","なげやられました"],["。"]]},{"verse":18,"text":"よみはあなたをほめたたえず、死はあなたを賛美せず、穴に下る者たちは、あなたのまことを待ち望みません。","tok":[["よみ"],["は"],["あなた"],["を"],["ほめたたえず"],["、"],["死","し"],["は"],["あなた"],["を"],["賛美","さんび"],["せず"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["は"],["、"],["あなた"],["の"],["まこと"],["を"],["待ち望みません","まちのぞみません"],["。"]]},{"verse":19,"text":"生きている者、ただ生きている者だけが／今日の私のように、あなたをほめたたえるのです。／父は子らにあなたのまことについて知らせます。","tok":[["生きて","いきて"],["いる"],["者","もの"],["、"],["ただ"],["生きて","いきて"],["いる"],["者","もの"],["だけ"],["が"],["／"],["今日","きょう"],["の"],["私","わたくし"],["の"],["よう"],["に"],["、"],["あなた"],["を"],["ほめたたえる"],["の"],["です"],["。"],["／"],["父","ちち"],["は"],["子","こ"],["ら"],["に"],["あなた"],["の"],["まこと"],["について"],["知らせます","しらせます"],["。"]]},{"verse":20,"text":"主は、私を救ってくださる。／私たちの生きている日々の間、主の宮で琴をかなでよう。","tok":[["主","ぬし"],["は"],["、"],["私","わたくし"],["を"],["救って","すくって"],["くださる"],["。"],["／"],["私たち","わたしたち"],["の"],["生きて","いきて"],["いる"],["日々","ひび"],["の"],["間","あいだ"],["、"],["主","ぬし"],["の"],["宮","みや"],["で"],["琴","こと"],["を"],["かなでよう"],["。"]]},{"verse":21,"text":"イザヤは言った。「ひとかたまりの干しいちじくを持って来させ、腫物の上に塗りつけなさい。そうすれば直ります。」","tok":[["イザヤ"],["は"],["言った","いった"],["。"],["「"],["ひとかたまり"],["の"],["干し","ほし"],["いちじく"],["を"],["持って","もって"],["来させ","きさせ"],["、"],["腫物","
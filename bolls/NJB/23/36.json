[{"verse":1,"text":"ヒゼキヤ王の第十四年に、アッシリヤの王セナケリブが、ユダのすべての城壁のある町々を攻めて、これを取った。","tok":[["ヒゼキヤ"],["王","おう"],["の"],["第","だい"],["十四","じゅうよん"],["年","ねん"],["に"],["、"],["アッシリヤ"],["の"],["王","おう"],["セナケリブ"],["が"],["、"],["ユダ"],["の"],["すべて"],["の"],["城壁","じょうへき"],["の"],["ある"],["町々","まちまち"],["を"],["攻めて","せめて"],["、"],["これ"],["を"],["取った","とった"],["。"]]},{"verse":2,"text":"アッシリヤの王は、ラブ・シャケに大軍をつけて、ラキシュからエルサレムに、ヒゼキヤ王のところへ送った。ラブ・シャケは布さらしの野への大路にある上の池の水道のそばに立った。","tok":[["アッシリヤ"],["の"],["王","おう"],["は"],["、"],["ラブ"],["・"],["シャケ"],["に"],["大軍","たいぐん"],["を"],["つけて"],["、"],["ラキシュ"],["から"],["エルサレム"],["に"],["、"],["ヒゼキヤ"],["王","おう"],["の"],["ところ"],["へ"],["送った","おくった"],["。"],["ラブ"],["・"],["シャケ"],["は"],["布","ぬの"],["さらし"],["の"],["野","の"],["へ"],["の"],["大路","おおじ"],["に"],["ある"],["上","うえ"],["の"],["池","いけ"],["の"],["水道","すいどう"],["の"],["そば"],["に"],["立った","たった"],["。"]]},{"verse":3,"text":"そこで、ヒルキヤの子である宮内長官エルヤキム、書記シェブナ、および、アサフの子である参議ヨアフが、彼のもとに出て行った。","tok":[["そこ"],["で"],["、"],["ヒルキヤ"],["の"],["子","こ"],["で"],["ある"],["宮内","くない"],["長官","ちょうかん"],["エルヤキム"],["、"],["書記","しょき"],["シェブナ"],["、"],["および"],["、"],["アサフ"],["の"],["子","こ"],["で"],["ある"],["参議","さんぎ"],["ヨアフ"],["が"],["、"],["彼","かれ"],["の"],["もと"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":4,"text":"ラブ・シャケは彼らに言った。「ヒゼキヤに伝えよ。大王、アッシリヤの王がこう言っておられる。／いったい、おまえは何に拠り頼んでいるのか。","tok":[["ラブ"],["・"],["シャケ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["ヒゼキヤ"],["に"],["伝え","つたえ"],["よ"],["。"],["大王","だいおう"],["、"],["アッシリヤ"],["の"],["王","おう"],["が"],["こう"],["言って","いって"],["おられる"],["。"],["／"],["いったい"],["、"],["おまえ"],["は"],["何","なん"],["に"],["拠り","より"],["頼んで","たのんで"],["いる"],["の"],["か"],["。"]]},{"verse":5,"text":"口先だけのことばが、戦略であり戦力だと思い込んでいるのか。今、おまえはだれに拠り頼んで私に反逆するのか。","tok":[["口先","くちさき"],["だけ"],["の"],["ことば"],["が"],["、"],["戦略","せんりゃく"],["で"],["あり"],["戦力","せんりょく"],["だ"],["と"],["思い込んで","おもいこんで"],["いる"],["の"],["か"],["。"],["今","いま"],["、"],["おまえ"],["は"],["だれ"],["に"],["拠り","より"],["頼んで","たのんで"],["私","わたくし"],["に"],["反逆","はんぎゃく"],["する"],["の"],["か"],["。"]]},{"verse":6,"text":"おまえは、あのいたんだ葦の杖、エジプトに拠り頼んでいるが、これは、それに寄りかかる者の手を刺し通すだけだ。エジプトの王、パロは、すべて彼に拠り頼む者たちにそうするのだ。","tok":[["おまえ"],["は"],["、"],["あの"],["いたんだ"],["葦","あし"],["の"],["杖","つえ"],["、"],["エジプト"],["に"],["拠り","より"],["頼んで","たのんで"],["いる"],["が"],["、"],["これ"],["は"],["、"],["それ"],["に"],["寄りかかる","よりかかる"],["者","もの"],["の"],["手","て"],["を"],["刺し通す","さしとおす"],["だけ"],["だ"],["。"],["エジプト"],["の"],["王","おう"],["、"],["パロ"],["は"],["、"],["すべて"],["彼","かれ"],["に"],["拠り","より"],["頼む","たのむ"],["者","もの"],["たち"],["に"],["そう"],["する"],["の"],["だ"],["。"]]},{"verse":7,"text":"おまえは私に『われわれは、われわれの神、主に拠り頼む』と言う。その主とは、ヒゼキヤが高き所と祭壇を取り除いておいて、ユダとエルサレムに向かい『この祭壇の前で拝め』と言ったそういう主ではないか、と。","tok":[["おまえ"],["は"],["私","わたくし"],["に"],["『"],["われわれ"],["は"],["、"],["われわれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["拠り","より"],["頼む","たのむ"],["』"],["と"],["言う","ゆう"],["。"],["その"],["主","ぬし"],["と"],["は"],["、"],["ヒゼキヤ"],["が"],["高き","たかき"],["所","ところ"],["と"],["祭壇","さいだん"],["を"],["取り除いて","とりのぞいて"],["おいて"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["向かい","むかい"],["『"],["この"],["祭壇","さいだん"],["の"],["前","まえ"],["で"],["拝め","おがめ"],["』"],["と"],["言った","いった"],["そう"],["いう"],["主","ぬし"],["で"],["は"],["ない"],["か"],["、"],["と"],["。"]]},{"verse":8,"text":"さあ、今、私の主君、アッシリヤの王と、かけをしないか。もしおまえのほうで乗り手をそろえることができれば、私はおまえに二千頭の馬を与えよう。","tok":[["さあ"],["、"],["今","いま"],["、"],["私","わたくし"],["の"],["主君","しゅくん"],["、"],["アッシリヤ"],["の"],["王","おう"],["と"],["、"],["かけ"],["を"],["しない"],["か"],["。"],["もし"],["おまえ"],["の"],["ほう"],["で"],["乗り手","のりて"],["を"],["そろえる"],["こと"],["が"],["できれば"],["、"],["私","わたくし"],["は"],["おまえ"],["に"],["二千頭","にせんとう"],["の"],["馬","うま"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":9,"text":"おまえは戦車と騎兵のことでエジプトに拠り頼んでいるが、私の主君の最も小さい家来のひとりの総督をさえ撃退することはできないのだ。","tok":[["おまえ"],["は"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["の"],["こと"],["で"],["エジプト"],["に"],["拠り","より"],["頼んで","たのんで"],["いる"],["が"],["、"],["私","わたくし"],["の"],["主君","しゅくん"],["の"],["最も","もっとも"],["小さい","ちいさい"],["家来","けらい"],["の"],["ひとり"],["の"],["総督","そうとく"],["を"],["さえ"],["撃退","げきたい"],["する"],["こと"],["は"],["できない"],["の"],["だ"],["。"]]},{"verse":10,"text":"今、私がこの国を滅ぼすために上って来たのは、主をさしおいてのことであろうか。主が私に『この国に攻め上って、これを滅ぼせ』と言われたのだ。」","tok":[["今","いま"],["、"],["私","わたくし"],["が"],["この"],["国","くに"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["上って","のぼって"],["来た","きた"],["の"],["は"],["、"],["主","ぬし"],["を"],["さしおいて"],["の"],["こと"],["で"],["あろう"],["か"],["。"],["主","ぬし"],["が"],["私","わたくし"],["に"],["『"],["この"],["国","くに"],["に"],["攻め上って","せめのぼって"],["、"],["これ"],["を"],["滅ぼせ","ほろぼせ"],["』"],["と"],["言われた","いわれた"],["の"],["だ"],["。"],["」"]]},{"verse":11,"text":"エルヤキムとシェブナとヨアフとは、ラブ・シャケに言った。「どうかしもべたちには、アラム語で話してください。われわれはアラム語がわかりますから。城壁の上にいる民の聞いている所では、われわれにユダのことばで話さないでください。」","tok":[["エルヤキム"],["と"],["シェブナ"],["と"],["ヨアフ"],["と"],["は"],["、"],["ラブ"],["・"],["シャケ"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["しもべ"],["たち"],["に"],["は"],["、"],["アラム"],["語","ご"],["で"],["話して","はなして"],["ください"],["。"],["われわれ"],["は"],["アラム"],["語","ご"],["が"],["わかります"],["から"],["。"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["いる"],["民","たみ"],["の"],["聞いて","きいて"],["いる"],["所","ところ"],["で"],["は"],["、"],["われわれ"],["に"],["ユダ"],["の"],["ことば"],["で"],["話さないで","はなさないで"],["ください"],["。"],["」"]]},{"verse":12,"text":"すると、ラブ・シャケは言った。「私の主君がこれらのことを告げに私を遣わされたのは、おまえの主君や、おまえのためだろうか。むしろ、城壁の上にすわっている者たちのためではないか。彼らはおまえたちといっしょに、自分の糞を食らい、自分の尿を飲むようになるのだ。」","tok":[["する"],["と"],["、"],["ラブ"],["・"],["シャケ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["主君","しゅくん"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["告げ","つげ"],["に"],["私","わたくし"],["を"],["遣わされた","つかわされた"],["の"],["は"],["、"],["おまえ"],["の"],["主君","しゅくん"],["や"],["、"],["おまえ"],["の"],["ため"],["だろう"],["か"],["。"],["むしろ"],["、"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["すわって"],["いる"],["者","もの"],["たち"],["の"],["ため"],["で"],["は"],["ない"],["か"],["。"],["彼","かれ"],["ら"],["は"],["おまえ"],["たち"],["と"],["いっしょ"],["に"],["、"],["自分","じぶん"],["の"],["糞","ふん"],["を"],["食らい","くらい"],["、"],["自分","じぶん"],["の"],["尿","にょう"],["を"],["飲む","のむ"],["よう"],["に"],["なる"],["の"],["だ"],["。"],["」"]]},{"verse":13,"text":"こうして、ラブ・シャケはつっ立って、ユダのことばで大声に呼ばわって、言った。「大王、アッシリヤの王のことばを聞け。","tok":[["こう"],["して"],["、"],["ラブ"],["・"],["シャケ"],["は"],["つっ立って","つったって"],["、"],["ユダ"],["の"],["ことば"],["で"],["大声","おおごえ"],["に"],["呼ばわって","よばわって"],["、"],["言った","いった"],["。"],["「"],["大王","だいおう"],["、"],["アッシリヤ"],["の"],["王","おう"],["の"],["ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":14,"text":"王はこう言われる。ヒゼキヤにごまかされるな。あれはおまえたちを救い出すことはできない。","tok":[["王","おう"],["は"],["こう"],["言われる","いわれる"],["。"],["ヒゼキヤ"],["に"],["ごまかされる"],["な"],["。"],["あれ"],["は"],["おまえ"],["たち"],["を"],["救い出す","すくいだす"],["こと"],["は"],["できない"],["。"]]},{"verse":15,"text":"ヒゼキヤが、主は必ずわれわれを救い出してくださる、この町は決してアッシリヤの王の手に渡されることはない、と言って、おまえたちに主を信頼させようとするが、そうはさせない。","tok":[["ヒゼキヤ"],["が"],["、"],["主","ぬし"],["は"],["必ず","かならず"],["われわれ"],["を"],["救い出して","すくいだして"],["くださる"],["、"],["この"],["町","まち"],["は"],["決して","けっして"],["アッシリヤ"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡される","わたされる"],["こと"],["は"],["ない"],["、"],["と"],["言って","いって"],["、"],["おまえ"],["たち"],["に"],["主","ぬし"],["を"],["信頼","しんらい"],["させよう"],["と"],["する"],["が"],["、"],["そう"],["は"],["させない"],["。"]]},{"verse":16,"text":"ヒゼキヤの言うことを聞くな。アッシリヤの王はこう言っておられるからだ。私と和を結び、私に降参せよ。そうすれば、おまえたちはみな、自分のぶどうと自分のいちじくを食べ、また、自分の井戸の水を飲めるのだ。","tok":[["ヒゼキヤ"],["の"],["言う","いう"],["こと"],["を"],["聞く","きく"],["な"],["。"],["アッシリヤ"],["の"],["王","おう"],["は"],["こう"],["言って","いって"],["おられる"],["から"],["だ"],["。"],["私","わたくし"],["と"],["和","わ"],["を"],["結び","むすび"],["、"],["私","わたくし"],["に"],["降参","こうさん"],["せよ"],["。"],["そう"],["すれば"],["、"],["おまえ"],["たち"],["は"],["みな"],["、"],["自分","じぶん"],["の"],["ぶどう"],["と"],["自分","じぶん"],["の"],["いちじく"],["を"],["食べ","たべ"],["、"],["また"],["、"],["自分","じぶん"],["の"],["井戸","いど"],["の"],["水","みず"],["を"],["飲める","のめる"],["の"],["だ"],["。"]]},{"verse":17,"text":"その後、私が来て、おまえたちの国と同じような国におまえたちを連れて行こう。そこは穀物とぶどう酒の地、パンとぶどう畑の地である。","tok":[["その"],["後","ご"],["、"],["私","わたくし"],["が"],["来て","きて"],["、"],["おまえ"],["たち"],["の"],["国","くに"],["と"],["同じ","おなじ"],["よう"],["な"],["国","くに"],["に"],["おまえ"],["たち"],["を"],["連れて","つれて"],["行こう","いこう"],["。"],["そこ"],["は"],["穀物","こくもつ"],["と"],["ぶどう酒","ぶどうしゅ"],["の"],["地","ち"],["、"],["パン"],["と"],["ぶどう"],["畑","はたけ"],["の"],["地","ち"],["で"],["ある"],["。"]]},{"verse":18,"text":"おまえたちは、ヒゼキヤが、主がわれわれを救い出してくださると言っているのに、そそのかされないようにせよ。国々の神々が、だれか、自分の国をアッシリヤの王の手から救い出しただろうか。","tok":[["おまえ"],["たち"],["は"],["、"],["ヒゼキヤ"],["が"],["、"],["主","ぬし"],["が"],["われわれ"],["を"],["救い出して","すくいだして"],["くださる"],["と"],["言って","いって"],["いる"],["のに"],["、"],["そそのかされない"],["よう"],["に"],["せよ"],["。"],["国々","くにぐに"],["の"],["神々","かみがみ"],["が"],["、"],["だれ"],["か"],["、"],["自分","じぶん"],["の"],["国","くに"],["を"],["アッシリヤ"],["の"],["王","おう"],["の"],["手","て"],["から"],["救い出しただろう","すくいだしただろう"],["か"],["。"]]},{"verse":19,"text":"ハマテやアルパデの神々は今、どこにいるのか。セファルワイムの神々はどこにいるのか。彼らはサマリヤを私の手から救い出したか。","tok":[["ハマテ"],["や"],["アルパデ"],["の"],["神々","かみがみ"],["は"],["今","いま"],["、"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["セファルワイム"],["の"],["神々","かみがみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["彼","かれ"],["ら"],["は"],["サマリヤ"],["を"],["私","わたくし"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["か"],["。"]]},{"verse":20,"text":"これらの国々のすべての神々のうち、だれが自分たちの国を私の手から救い出しただろうか。主がエルサレムを私の手から救い出すとでもいうのか。」","tok":[["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["すべて"],["の"],["神々","かみがみ"],["の"],["うち"],["、"],["だれ"],["が"],["自分","じぶん"],["たち"],["の"],["国","くに"],["を"],["私","わたくし"],["の"],["手","て"],["から"],["救い出しただろう","すくいだしただろう"],["か"],["。"],["主","ぬし"],["が"],["エルサレム"],["を"],["私","わたくし"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["と"],["で"],["も"],["いう"],["の"],["か"],["。"],["」"]]},{"verse":21,"text":"しかし人々は黙っており、彼に一言も答えなかった。「彼に答えるな」というのが、王の命令だったからである。","tok":[["しかし"],["人々","ひとびと"],["は"],["黙って","だまって"],["おり"],["、"],["彼","かれ"],["に"],["一言","ひとこと"],["も"],["答えなかった","こたえなかった"],["。"],["「"],["彼","かれ"],["に"],["答える","こたえる"],["な"],["」"],["と"],["いう"],["の"],["が"],["、"],["王","おう"],["の"],["命令","めいれい"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"ヒルキヤの子である宮内長官エルヤキム、書記シェブナ、アサフの子である参議ヨアフは、自分たちの衣を裂いてヒゼキヤのもとに行き、ラブ・シャケのことばを告げた。","tok":[["ヒルキヤ"],["の"],["子","こ"],["で"],["ある"],["宮内","くない"],["長官","ちょうかん"],["エルヤキム"],["、"],["書記","しょき"],["シェブナ"],["、"],["アサフ"],["の"],["子","こ"],["で"],["ある"],["参議","さんぎ"],["ヨアフ"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["衣","ころも"],["を"],["裂いて","さいて"],["ヒゼキヤ"],["の"],["もと"],["に"],["行き","いき"],["、"],["ラブ"],["・"],["シャケ"],["の"],["ことば"],["を"],["告げた","つげた"],["。"]]}]
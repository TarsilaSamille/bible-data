[{"verse":1,"text":"エッサイの根株から新芽が生え、その根から若枝が出て実を結ぶ。","tok":[["エッサイ"],["の"],["根株","ねかぶ"],["から"],["新芽","しんめ"],["が"],["生え","はえ"],["、"],["その"],["根","ね"],["から"],["若枝","わかえだ"],["が"],["出て","でて"],["実","じつ"],["を"],["結ぶ","むすぶ"],["。"]]},{"verse":2,"text":"その上に、主の霊がとどまる。／それは知恵と悟りの霊、はかりごとと能力の霊、主を知る知識と主を恐れる霊である。","tok":[["その"],["上","うえ"],["に"],["、"],["主","ぬし"],["の"],["霊","れい"],["が"],["とどまる"],["。"],["／"],["それ"],["は"],["知恵","ちえ"],["と"],["悟り","さとり"],["の"],["霊","れい"],["、"],["はかりごと"],["と"],["能力","のうりょく"],["の"],["霊","れい"],["、"],["主","ぬし"],["を"],["知る","しる"],["知識","ちしき"],["と"],["主","ぬし"],["を"],["恐れる","おそれる"],["霊","れい"],["で"],["ある"],["。"]]},{"verse":3,"text":"この方は主を恐れることを喜び、その目の見るところによってさばかず、その耳の聞くところによって判決を下さず、","tok":[["この"],["方","かた"],["は"],["主","ぬし"],["を"],["恐れる","おそれる"],["こと"],["を"],["喜び","よろこび"],["、"],["その"],["目","め"],["の"],["見る","みる"],["ところ"],["によって"],["さばかず"],["、"],["その"],["耳","みみ"],["の"],["聞く","きく"],["ところ"],["によって"],["判決","はんけつ"],["を"],["下さず","くださず"],["、"]]},{"verse":4,"text":"正義をもって寄るべのない者をさばき、公正をもって国の貧しい者のために判決を下し、口のむちで国を打ち、くちびるの息で悪者を殺す。","tok":[["正義","せいぎ"],["を"],["もって"],["寄るべ","よるべ"],["の"],["ない"],["者","もの"],["を"],["さばき"],["、"],["公正","こうせい"],["を"],["もって"],["国","くに"],["の"],["貧しい","まずしい"],["者","もの"],["の"],["ため"],["に"],["判決","はんけつ"],["を"],["下し","くだし"],["、"],["口","くち"],["の"],["むち"],["で"],["国","くに"],["を"],["打ち","うち"],["、"],["くちびる"],["の"],["息","いき"],["で"],["悪者","わるもの"],["を"],["殺す","ころす"],["。"]]},{"verse":5,"text":"正義はその腰の帯となり、真実はその胴の帯となる。","tok":[["正義","せいぎ"],["は"],["その"],["腰","こし"],["の"],["帯","おび"],["と"],["なり"],["、"],["真実","しんじつ"],["は"],["その"],["胴","どう"],["の"],["帯","おび"],["と"],["なる"],["。"]]},{"verse":6,"text":"狼は子羊とともに宿り、ひょうは子やぎとともに伏し、子牛、若獅子、肥えた家畜が共にいて、小さい子どもがこれを追っていく。","tok":[["狼","おおかみ"],["は"],["子羊","こひつじ"],["と"],["とも"],["に"],["宿り","やどり"],["、"],["ひょう"],["は"],["子やぎ","こやぎ"],["と"],["とも"],["に"],["伏し","ふし"],["、"],["子牛","こうし"],["、"],["若","わか"],["獅子","しし"],["、"],["肥えた","こえた"],["家畜","かちく"],["が"],["共","とも"],["に"],["いて"],["、"],["小さい","ちいさい"],["子ども","こども"],["が"],["これ"],["を"],["追って","おって"],["いく"],["。"]]},{"verse":7,"text":"雌牛と熊とは共に草をはみ、その子らは共に伏し、獅子も牛のようにわらを食う。","tok":[["雌牛","めうし"],["と"],["熊","くま"],["と"],["は"],["共","とも"],["に"],["草","くさ"],["を"],["はみ"],["、"],["その"],["子","こ"],["ら"],["は"],["共","とも"],["に"],["伏し","ふし"],["、"],["獅子","しし"],["も"],["牛","うし"],["の"],["よう"],["に"],["わら"],["を"],["食う","くう"],["。"]]},{"verse":8,"text":"乳飲み子はコブラの穴の上で戯れ、乳離れした子はまむしの子に手を伸べる。","tok":[["乳飲み子","ちのみご"],["は"],["コブラ"],["の"],["穴","あな"],["の"],["上","うえ"],["で"],["戯れ","たわむれ"],["、"],["乳離れ","ちばなれ"],["した"],["子","こ"],["は"],["まむし"],["の"],["子","こ"],["に"],["手","て"],["を"],["伸べる","のべる"],["。"]]},{"verse":9,"text":"わたしの聖なる山のどこにおいても、これらは害を加えず、そこなわない。／主を知ることが、海をおおう水のように、地を満たすからである。","tok":[["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["の"],["どこ"],["に"],["おいて"],["も"],["、"],["これ"],["ら"],["は"],["害","がい"],["を"],["加えず","くわえず"],["、"],["そこなわない"],["。"],["／"],["主","ぬし"],["を"],["知る","しる"],["こと"],["が"],["、"],["海","うみ"],["を"],["おおう"],["水","みず"],["の"],["よう"],["に"],["、"],["地","ち"],["を"],["満たす","みたす"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"その日、エッサイの根は、国々の民の旗として立ち、国々は彼を求め、彼のいこう所は栄光に輝く。","tok":[["その"],["日","ひ"],["、"],["エッサイ"],["の"],["根","ね"],["は"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["旗","はた"],["として"],["立ち","たち"],["、"],["国々","くにぐに"],["は"],["彼","かれ"],["を"],["求め","もとめ"],["、"],["彼","かれ"],["の"],["いこう"],["所","ところ"],["は"],["栄光","えいこう"],["に"],["輝く","かがやく"],["。"]]},{"verse":11,"text":"その日、主は再び御手を伸ばし、ご自分の民の残りを買い取られる。／残っている者をアッシリヤ、エジプト、パテロス、クシュ、エラム、シヌアル、ハマテ、海の島々から買い取られる。","tok":[["その"],["日","ひ"],["、"],["主","ぬし"],["は"],["再び","ふたたび"],["御手","おて"],["を"],["伸ばし","のばし"],["、"],["ご自分","ごじぶん"],["の"],["民","たみ"],["の"],["残り","のこり"],["を"],["買い取られる","かいとられる"],["。"],["／"],["残って","のこって"],["いる"],["者","もの"],["を"],["アッシリヤ"],["、"],["エジプト"],["、"],["パテロス"],["、"],["クシュ"],["、"],["エラム"],["、"],["シヌアル"],["、"],["ハマテ"],["、"],["海","うみ"],["の"],["島々","しまじま"],["から"],["買い取られる","かいとられる"],["。"]]},{"verse":12,"text":"主は、国々のために旗を揚げ、イスラエルの散らされた者を取り集め、ユダの追い散らされた者を／地の四隅から集められる。","tok":[["主","ぬし"],["は"],["、"],["国々","くにぐに"],["の"],["ため"],["に"],["旗","はた"],["を"],["揚げ","あげ"],["、"],["イスラエル"],["の"],["散らされた","ちらされた"],["者","もの"],["を"],["取り集め","とりあつめ"],["、"],["ユダ"],["の"],["追い散らされた","おいちらされた"],["者","もの"],["を"],["／"],["地","ち"],["の"],["四隅","よすみ"],["から"],["集められる","あつめられる"],["。"]]},{"verse":13,"text":"エフライムのねたみは去り、ユダに敵する者は断ち切られる。／エフライムはユダをねたまず、ユダもエフライムを敵としない。","tok":[["エフライム"],["の"],["ねたみ"],["は"],["去り","さり"],["、"],["ユダ"],["に"],["敵する","てきする"],["者","もの"],["は"],["断ち切られる","たちきられる"],["。"],["／"],["エフライム"],["は"],["ユダ"],["を"],["ねたまず"],["、"],["ユダ"],["も"],["エフライム"],["を"],["敵","てき"],["と"],["しない"],["。"]]},{"verse":14,"text":"彼らは、西の方、ペリシテ人の肩に飛びかかり、共に東の人々をかすめ奪う。／彼らはエドムとモアブにも手を伸ばし、アモン人も彼らに従う。","tok":[["彼","かれ"],["ら"],["は"],["、"],["西","にし"],["の"],["方","ほう"],["、"],["ペリシテ"],["人","にん"],["の"],["肩","かた"],["に"],["飛びかかり","とびかかり"],["、"],["共","とも"],["に"],["東","ひがし"],["の"],["人々","ひとびと"],["を"],["かすめ"],["奪う","うばう"],["。"],["／"],["彼","かれ"],["ら"],["は"],["エドム"],["と"],["モアブ"],["に"],["も"],["手","て"],["を"],["伸ばし","のばし"],["、"],["アモン人","あもんにん"],["も"],["彼","かれ"],["ら"],["に"],["従う","したがう"],["。"]]},{"verse":15,"text":"主はエジプトの海の入江を干上がらせ、また、その焼けつく風の中に／御手を川に向かって振り動かし、それを打って、七つの水無し川とし、くつばきのままで歩けるようにする。","tok":[["主","ぬし"],["は"],["エジプト"],["の"],["海","うみ"],["の"],["入江","いりえ"],["を"],["干上がらせ","ひあがらせ"],["、"],["また"],["、"],["その"],["焼けつく","やけつく"],["風","かぜ"],["の"],["中","なか"],["に"],["／"],["御手","おて"],["を"],["川","かわ"],["に"],["向かって","むかって"],["振り動かし","ふりうごかし"],["、"],["それ"],["を"],["打って","うって"],["、"],["七","なな"],["つ"],["の"],["水","みず"],["無し","なし"],["川","かわ"],["と"],["し"],["、"],["く"],["つばき"],["の"],["まま"],["で"],["歩ける","あるける"],["よう"],["に"],["する"],["。"]]},{"verse":16,"text":"残される御民の残りの者のために／アッシリヤからの大路が備えられる。／イスラエルがエジプトの国から上って来た日に、イスラエルのために備えられたように。","tok":[["残される","のこされる"],["御民","ごみん"],["の"],["残り","のこり"],["の"],["者","もの"],["の"],["ため"],["に"],["／"],["アッシリヤ"],["から"],["の"],["大路","おおじ"],["が"],["備えられる","そなえられる"],["。"],["／"],["イスラエル"],["が"],["エジプト"],["の"],["国","くに"],["から"],["上って","のぼって"],["来た","きた"],["日","ひ"],["に"],["、"],["イスラエル"],["の"],["ため"],["に"],["備えられた","そなえられた"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"ああ。渇いている者はみな、水を求めて出て来い。金のない者も。／さあ、穀物を買って食べよ。／さあ、金を払わないで、穀物を買い、代価を払わないで、ぶどう酒と乳を買え。","tok":[["ああ"],["。"],["渇いて","かわいて"],["いる"],["者","もの"],["は"],["みな"],["、"],["水","みず"],["を"],["求めて","もとめて"],["出て","でて"],["来い","こい"],["。"],["金","きん"],["の"],["ない"],["者","もの"],["も"],["。"],["／"],["さあ"],["、"],["穀物","こくもつ"],["を"],["買って","かって"],["食べ","たべ"],["よ"],["。"],["／"],["さあ"],["、"],["金","きん"],["を"],["払わないで","はらわないで"],["、"],["穀物","こくもつ"],["を"],["買い","かい"],["、"],["代価","だいか"],["を"],["払わないで","はらわないで"],["、"],["ぶどう酒","ぶどうしゅ"],["と"],["乳","ちち"],["を"],["買え","かえ"],["。"]]},{"verse":2,"text":"なぜ、あなたがたは、食糧にもならない物のために金を払い、腹を満たさない物のために労するのか。／わたしに聞き従い、良い物を食べよ。／そうすれば、あなたがたは脂肪で元気づこう。","tok":[["なぜ"],["、"],["あなた"],["がた"],["は"],["、"],["食糧","しょくりょう"],["に"],["も"],["ならない"],["物","もの"],["の"],["ため"],["に"],["金","かね"],["を"],["払い","はらい"],["、"],["腹","はら"],["を"],["満たさない","みたさない"],["物","もの"],["の"],["ため"],["に"],["労する","ろうする"],["の"],["か"],["。"],["／"],["わたし"],["に"],["聞き従い","ききしたがい"],["、"],["良い","よい"],["物","もの"],["を"],["食べ","たべ"],["よ"],["。"],["／"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["脂肪","しぼう"],["で"],["元","もと"],["気づこう","きづこう"],["。"]]},{"verse":3,"text":"耳を傾け、わたしのところに出て来い。／聞け。そうすれば、あなたがたは生きる。／わたしはあなたがたととこしえの契約、ダビデへの変わらない愛の契約を結ぶ。","tok":[["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["わたし"],["の"],["ところ"],["に"],["出て","でて"],["来い","こい"],["。"],["／"],["聞け","きけ"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["生きる","いきる"],["。"],["／"],["わたし"],["は"],["あなた"],["がた"],["と"],["とこしえ"],["の"],["契約","けいやく"],["、"],["ダビデ"],["へ"],["の"],["変わらない","かわらない"],["愛","あい"],["の"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"]]},{"verse":4,"text":"見よ。わたしは彼を諸国の民への証人とし、諸国の民の君主とし、司令官とした。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["へ"],["の"],["証人","しょうにん"],["と"],["し"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["君主","くんしゅ"],["と"],["し"],["、"],["司令官","しれいかん"],["と"],["した"],["。"]]},{"verse":5,"text":"見よ。／あなたの知らない国民をあなたが呼び寄せると、あなたを知らなかった国民が、あなたのところに走って来る。／これは、あなたの神、主のため、また、あなたを輝かせた／イスラエルの聖なる方のためである。","tok":[["見","み"],["よ"],["。"],["／"],["あなた"],["の"],["知らない","しらない"],["国民","こくみん"],["を"],["あなた"],["が"],["呼び寄せる","よびよせる"],["と"],["、"],["あなた"],["を"],["知らなかった","しらなかった"],["国民","こくみん"],["が"],["、"],["あなた"],["の"],["ところ"],["に"],["走って","はしって"],["来る","くる"],["。"],["／"],["これ"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["、"],["また"],["、"],["あなた"],["を"],["輝かせた","かがやかせた"],["／"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"主を求めよ。お会いできる間に。／近くにおられるうちに、呼び求めよ。","tok":[["主","ぬし"],["を"],["求めよ","もとめよ"],["。"],["お会い","おあい"],["できる"],["間","ま"],["に"],["。"],["／"],["近く","ちかく"],["に"],["おられる"],["うち"],["に"],["、"],["呼び求めよ","よびもとめよ"],["。"]]},{"verse":7,"text":"悪者はおのれの道を捨て、不法者はおのれのはかりごとを捨て去れ。／主に帰れ。そうすれば、主はあわれんでくださる。／私たちの神に帰れ。豊かに赦してくださるから。","tok":[["悪者","わるもの"],["は"],["おのれ"],["の"],["道","みち"],["を"],["捨て","すて"],["、"],["不法","ふほう"],["者","しゃ"],["は"],["おのれ"],["の"],["はかりごと"],["を"],["捨て去れ","すてされ"],["。"],["／"],["主に","おもに"],["帰れ","かえれ"],["。"],["そう"],["すれば"],["、"],["主","ぬし"],["は"],["あわれんで"],["くださる"],["。"],["／"],["私たち","わたしたち"],["の"],["神","かみ"],["に"],["帰れ","かえれ"],["。"],["豊か","ゆたか"],["に"],["赦して","ゆるして"],["くださる"],["から"],["。"]]},{"verse":8,"text":"「わたしの思いは、あなたがたの思いと異なり、わたしの道は、あなたがたの道と異なるからだ。／――主の御告げ――","tok":[["「"],["わたし"],["の"],["思い","おもい"],["は"],["、"],["あなた"],["がた"],["の"],["思い","おもい"],["と"],["異なり","ことなり"],["、"],["わたし"],["の"],["道","みち"],["は"],["、"],["あなた"],["がた"],["の"],["道","みち"],["と"],["異なる","ことなる"],["から"],["だ"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":9,"text":"天が地よりも高いように、わたしの道は、あなたがたの道よりも高く、わたしの思いは、あなたがたの思いよりも高い。","tok":[["天","てん"],["が"],["地","ち"],["より"],["も"],["高い","たかい"],["よう"],["に"],["、"],["わたし"],["の"],["道","みち"],["は"],["、"],["あなた"],["がた"],["の"],["道","みち"],["より"],["も"],["高く","たかく"],["、"],["わたし"],["の"],["思い","おもい"],["は"],["、"],["あなた"],["がた"],["の"],["思い","おもい"],["より"],["も"],["高い","たかい"],["。"]]},{"verse":10,"text":"雨や雪が天から降ってもとに戻らず、必ず地を潤し、それに物を生えさせ、芽を出させ、種蒔く者には種を与え、食べる者にはパンを与える。","tok":[["雨","あめ"],["や"],["雪","ゆき"],["が"],["天","てん"],["から"],["降って","ふって"],["もと"],["に"],["戻らず","もどらず"],["、"],["必ず","かならず"],["地","ち"],["を"],["潤し","うるおし"],["、"],["それ"],["に"],["物","もの"],["を"],["生えさせ","はえさせ"],["、"],["芽","め"],["を"],["出させ","ださせ"],["、"],["種蒔","たねまき"],["く者","くしゃ"],["に"],["は"],["種","しゅ"],["を"],["与え","あたえ"],["、"],["食べる","たべる"],["者","もの"],["に"],["は"],["パン"],["を"],["与える","あたえる"],["。"]]},{"verse":11,"text":"そのように、わたしの口から出るわたしのことばも、むなしく、わたしのところに帰っては来ない。／必ず、わたしの望む事を成し遂げ、わたしの言い送った事を成功させる。","tok":[["その"],["よう"],["に"],["、"],["わたし"],["の"],["口","くち"],["から"],["出る","でる"],["わたし"],["の"],["ことば"],["も"],["、"],["むなしく"],["、"],["わたし"],["の"],["ところ"],["に"],["帰って","かえって"],["は"],["来ない","こない"],["。"],["／"],["必ず","かならず"],["、"],["わたし"],["の"],["望む","のぞむ"],["事","こと"],["を"],["成し遂げ","なしとげ"],["、"],["わたし"],["の"],["言い送った","いいおくった"],["事","こと"],["を"],["成功","せいこう"],["させる"],["。"]]},{"verse":12,"text":"まことに、あなたがたは喜びをもって出て行き、安らかに導かれて行く。／山と丘は、あなたがたの前で喜びの歌声をあげ、野の木々もみな、手を打ち鳴らす。","tok":[["まこと"],["に"],["、"],["あなた"],["がた"],["は"],["喜び","よろこび"],["を"],["もって"],["出て","でて"],["行き","いき"],["、"],["安らか","やすらか"],["に"],["導かれて","みちびかれて"],["行く","いく"],["。"],["／"],["山","やま"],["と"],["丘","おか"],["は"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["で"],["喜び","よろこび"],["の"],["歌声","うたごえ"],["を"],["あげ"],["、"],["野","の"],["の"],["木々","きぎ"],["も"],["みな"],["、"],["手","て"],["を"],["打ち鳴らす","うちならす"],["。"]]},{"verse":13,"text":"いばらの代わりにもみの木が生え、おどろの代わりにミルトスが生える。／これは主の記念となり、絶えることのない永遠のしるしとなる。」","tok":[["いばら"],["の"],["代わり","かわり"],["に"],["もみ"],["の"],["木","き"],["が"],["生え","はえ"],["、"],["おどろ"],["の"],["代わり","かわり"],["に"],["ミルトス"],["が"],["生える","はえる"],["。"],["／"],["これ"],["は"],["主","ぬし"],["の"],["記念","きねん"],["と"],["なり"],["、"],["絶える","たえる"],["こと"],["の"],["ない"],["永遠","えいえん"],["の"],["しるし"],["と"],["なる"],["。"],["」"]]}]
[{"verse":1,"text":"これを聞け。ヤコブの家よ。／あなたはイスラエルの名で呼ばれ、ユダの源から出て、主の御名によって誓い、イスラエルの神を呼び求めるが、誠実をもってせず、また正義をもってしない。","tok":[["これ"],["を"],["聞け","きけ"],["。"],["ヤコブ"],["の"],["家","いえ"],["よ"],["。"],["／"],["あなた"],["は"],["イスラエル"],["の"],["名","な"],["で"],["呼ばれ","よばれ"],["、"],["ユダ"],["の"],["源","みなもと"],["から"],["出て","でて"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["誓い","ちかい"],["、"],["イスラエル"],["の"],["神","かみ"],["を"],["呼び求める","よびもとめる"],["が"],["、"],["誠実","せいじつ"],["を"],["もって"],["せず"],["、"],["また"],["正義","せいぎ"],["を"],["もって"],["しない"],["。"]]},{"verse":2,"text":"確かに彼らは聖なる都の名を名のり、イスラエルの神――その名は万軍の主――に／寄りかかっている。","tok":[["確か","たしか"],["に"],["彼","かれ"],["ら"],["は"],["聖","せい"],["なる"],["都","と"],["の"],["名","な"],["を"],["名のり","なのり"],["、"],["イスラエル"],["の"],["神","かみ"],["―"],["―"],["その"],["名","な"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["―"],["―"],["に"],["／"],["寄りかかって","よりかかって"],["いる"],["。"]]},{"verse":3,"text":"「先に起こった事は、前からわたしが告げていた。／それらはわたしの口から出、わたしはそれらを聞かせた。／にわかに、わたしは行い、それは成就した。","tok":[["「"],["先","さき"],["に"],["起こった","おこった"],["事","こと"],["は"],["、"],["前","まえ"],["から"],["わたし"],["が"],["告げて","つげて"],["いた"],["。"],["／"],["それ"],["ら"],["は"],["わたし"],["の"],["口","くち"],["から"],["出","で"],["、"],["わたし"],["は"],["それ"],["ら"],["を"],["聞かせた","きかせた"],["。"],["／"],["にわか"],["に"],["、"],["わたし"],["は"],["行い","おこない"],["、"],["それ"],["は"],["成就","じょうじゅ"],["した"],["。"]]},{"verse":4,"text":"あなたがかたくなであり、首筋は鉄の腱、額は青銅だと知っているので、","tok":[["あなた"],["が"],["かたくな"],["で"],["あり"],["、"],["首筋","くびすじ"],["は"],["鉄","てつ"],["の"],["腱","けん"],["、"],["額","がく"],["は"],["青銅","せいどう"],["だ"],["と"],["知って","しって"],["いる"],["ので"],["、"]]},{"verse":5,"text":"わたしは、かねてからあなたに告げ、まだ起こらないうちに、聞かせたのだ。／『私の偶像がこれをした』とか、『私の彫像や鋳た像がこれを命じた』とか／あなたが言わないためだ。","tok":[["わたし"],["は"],["、"],["かねて"],["から"],["あなた"],["に"],["告げ","つげ"],["、"],["まだ"],["起こらない","おこらない"],["うち"],["に"],["、"],["聞かせた","きかせた"],["の"],["だ"],["。"],["／"],["『"],["私","わたくし"],["の"],["偶像","ぐうぞう"],["が"],["これ"],["を"],["した"],["』"],["と"],["か"],["、"],["『"],["私","わたくし"],["の"],["彫像","ちょうぞう"],["や"],["鋳た","いた"],["像","ぞう"],["が"],["これ"],["を"],["命じた","めいじた"],["』"],["と"],["か"],["／"],["あなた"],["が"],["言わない","いわない"],["ため"],["だ"],["。"]]},{"verse":6,"text":"あなたは聞いた。さあ、これらすべてを見よ。／あなたがたは告げ知らせないのか。／わたしは今から、新しい事、あなたの知らない秘め事をあなたに聞かせよう。","tok":[["あなた"],["は"],["聞いた","きいた"],["。"],["さあ"],["、"],["これ"],["ら"],["すべて"],["を"],["見よ","みよ"],["。"],["／"],["あなた"],["がた"],["は"],["告げ知らせない","つげしらせない"],["の"],["か"],["。"],["／"],["わたし"],["は"],["今","いま"],["から"],["、"],["新しい","あたらしい"],["事","こと"],["、"],["あなた"],["の"],["知らない","しらない"],["秘め事","ひめごと"],["を"],["あなた"],["に"],["聞かせよう","きかせよう"],["。"]]},{"verse":7,"text":"それは今、創造された。ずっと前からではない。／きょうまで、あなたはこれを聞いたこともない。／『ああ、私は知っていた』と／あなたが言わないためだ。","tok":[["それ"],["は"],["今","いま"],["、"],["創造","そうぞう"],["された"],["。"],["ずっと"],["前","まえ"],["から"],["で"],["は"],["ない"],["。"],["／"],["きょう"],["まで"],["、"],["あなた"],["は"],["これ"],["を"],["聞いた","きいた"],["こと"],["も"],["ない"],["。"],["／"],["『"],["ああ"],["、"],["私","わたくし"],["は"],["知って","しって"],["いた"],["』"],["と"],["／"],["あなた"],["が"],["言わない","いわない"],["ため"],["だ"],["。"]]},{"verse":8,"text":"あなたは聞いたこともなく、知っていたこともない。／ずっと前から、あなたの耳は開かれていなかった。／わたしは、あなたがきっと裏切ること、母の胎内にいる時から／そむく者と呼ばれていることを、知っていたからだ。","tok":[["あなた"],["は"],["聞いた","きいた"],["こと"],["も"],["なく"],["、"],["知って","しって"],["いた"],["こと"],["も"],["ない"],["。"],["／"],["ずっと"],["前","まえ"],["から"],["、"],["あなた"],["の"],["耳","みみ"],["は"],["開かれて","ひらかれて"],["いなかった"],["。"],["／"],["わたし"],["は"],["、"],["あなた"],["が"],["きっと"],["裏切る","うらぎる"],["こと"],["、"],["母","はは"],["の"],["胎内","たいない"],["に"],["いる"],["時","とき"],["から"],["／"],["そむく"],["者","もの"],["と"],["呼ばれて","よばれて"],["いる"],["こと"],["を"],["、"],["知って","しって"],["いた"],["から"],["だ"],["。"]]},{"verse":9,"text":"わたしは、わたしの名のために、怒りを遅らせ、わたしの栄誉のために、これを押さえて、あなたを断ち滅ぼさなかった。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["怒り","いかり"],["を"],["遅らせ","おくらせ"],["、"],["わたし"],["の"],["栄誉","えいよ"],["の"],["ため"],["に"],["、"],["これ"],["を"],["押さえて","おさえて"],["、"],["あなた"],["を"],["断ち","たち"],["滅ぼさなかった","ほろぼさなかった"],["。"]]},{"verse":10,"text":"見よ。わたしはあなたを練ったが、銀の場合とは違う。／わたしは悩みの炉であなたを試みた。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["練った","ねった"],["が"],["、"],["銀","ぎん"],["の"],["場合","ばあい"],["と"],["は"],["違う","ちがう"],["。"],["／"],["わたし"],["は"],["悩み","なやみ"],["の"],["炉","ろ"],["で"],["あなた"],["を"],["試みた","こころみた"],["。"]]},{"verse":11,"text":"わたしのため、わたしのために、わたしはこれを行う。／どうしてわたしの名が汚されてよかろうか。／わたしはわたしの栄光を他の者には与えない。","tok":[["わたし"],["の"],["ため"],["、"],["わたし"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["これ"],["を"],["行う","おこなう"],["。"],["／"],["どう"],["して"],["わたし"],["の"],["名","な"],["が"],["汚されて","よごされて"],["よかろう"],["か"],["。"],["／"],["わたし"],["は"],["わたし"],["の"],["栄光","えいこう"],["を"],["他","ほか"],["の"],["者","もの"],["に"],["は"],["与えない","あたえない"],["。"]]},{"verse":12,"text":"わたしに聞け。ヤコブよ。／わたしが呼び出したイスラエルよ。／わたしがそれだ。／わたしは初めであり、また、終わりである。","tok":[["わたし"],["に"],["聞け","きけ"],["。"],["ヤコブ"],["よ"],["。"],["／"],["わたし"],["が"],["呼び出した","よびだした"],["イスラエル"],["よ"],["。"],["／"],["わたし"],["が"],["それ"],["だ"],["。"],["／"],["わたし"],["は"],["初め","はじめ"],["で"],["あり"],["、"],["また"],["、"],["終わり","おわり"],["で"],["ある"],["。"]]},{"verse":13,"text":"まことに、わたしの手が地の基を定め、わたしの右の手が天を引き延ばした。／わたしがそれらに呼びかけると、それらはこぞって立ち上がる。","tok":[["まこと"],["に"],["、"],["わたし"],["の"],["手","て"],["が"],["地","ち"],["の"],["基","もと"],["を"],["定め","さだめ"],["、"],["わたし"],["の"],["右","みぎ"],["の"],["手","て"],["が"],["天","てん"],["を"],["引き延ばした","ひきのばした"],["。"],["／"],["わたし"],["が"],["それ"],["ら"],["に"],["呼びかける","よびかける"],["と"],["、"],["それ"],["ら"],["は"],["こぞって"],["立ち上がる","たちあがる"],["。"]]},{"verse":14,"text":"あなたがた、みな集まって聞け。／だれがこれらの事を告げたのか。／主に愛される者が、主の喜ばれる事をバビロンにしむける。／主の御腕はカルデヤ人に向かう。","tok":[["あなた"],["がた"],["、"],["みな"],["集まって","あつまって"],["聞け","きけ"],["。"],["／"],["だれ"],["が"],["これ"],["ら"],["の"],["事","こと"],["を"],["告げた","つげた"],["の"],["か"],["。"],["／"],["主に","おもに"],["愛される","あいされる"],["者","もの"],["が"],["、"],["主","ぬし"],["の"],["喜ばれる","よろこばれる"],["事","こと"],["を"],["バビロン"],["に"],["しむける"],["。"],["／"],["主","ぬし"],["の"],["御腕","おうで"],["は"],["カルデヤ"],["人","にん"],["に"],["向かう","むかう"],["。"]]},{"verse":15,"text":"わたしが、このわたしが語り、そして彼を呼んだのだ。／わたしは彼を来させ、彼の行うことを成功させる。","tok":[["わたし"],["が"],["、"],["この"],["わたし"],["が"],["語り","かたり"],["、"],["そして"],["彼","かれ"],["を"],["呼んだ","よんだ"],["の"],["だ"],["。"],["／"],["わたし"],["は"],["彼","かれ"],["を"],["来させ","きたさせ"],["、"],["彼","かれ"],["の"],["行う","おこなう"],["こと"],["を"],["成功","せいこう"],["させる"],["。"]]},{"verse":16,"text":"わたしに近づいて、これを聞け。／わたしは初めから、隠れた所で語らなかった。／それが起こった時から、わたしはそこにいた。」／今、神である主は私を、その御霊とともに遣わされた。","tok":[["わたし"],["に"],["近づいて","ちかづいて"],["、"],["これ"],["を"],["聞け","きけ"],["。"],["／"],["わたし"],["は"],["初め","はじめ"],["から"],["、"],["隠れた","かくれた"],["所","ところ"],["で"],["語らなかった","かたらなかった"],["。"],["／"],["それ"],["が"],["起こった","おこった"],["時","とき"],["から"],["、"],["わたし"],["は"],["そこ"],["に"],["いた"],["。"],["」"],["／"],["今","いま"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["私","わたくし"],["を"],["、"],["その"],["御霊","みたま"],["と"],["とも"],["に"],["遣わされた","つかわされた"],["。"]]},{"verse":17,"text":"あなたを贖う主、イスラエルの聖なる方は／こう仰せられる。「わたしは、あなたの神、主である。わたしは、あなたに益になることを教え、あなたの歩むべき道にあなたを導く。","tok":[["あなた"],["を"],["贖う","あがなう"],["主","ぬし"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["は"],["／"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["あなた"],["に"],["益","えき"],["に"],["なる"],["こと"],["を"],["教え","おしえ"],["、"],["あなた"],["の"],["歩むべき","あゆむべき"],["道","みち"],["に"],["あなた"],["を"],["導く","みちびく"],["。"]]},{"verse":18,"text":"あなたがわたしの命令に耳を傾けさえすれば、あなたのしあわせは川のように、あなたの正義は海の波のようになるであろうに。","tok":[["あなた"],["が"],["わたし"],["の"],["命令","めいれい"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["さえ"],["すれば"],["、"],["あなた"],["の"],["しあわせ"],["は"],["川","かわ"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["正義","せいぎ"],["は"],["海","うみ"],["の"],["波","なみ"],["の"],["よう"],["に"],["なるで"],["あろう"],["に"],["。"]]},{"verse":19,"text":"あなたの子孫は砂のように、あなたの身から出る者は、真砂のようになるであろうに。その名はわたしの前から断たれることも、滅ぼされることもないであろうに。」","tok":[["あなた"],["の"],["子孫","しそん"],["は"],["砂","すな"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["身","み"],["から"],["出る","でる"],["者","もの"],["は"],["、"],["真砂","まさご"],["の"],["よう"],["に"],["なるで"],["あろう"],["に"],["。"],["その"],["名","な"],["は"],["わたし"],["の"],["前","まえ"],["から"],["断たれる","たたれる"],["こと"],["も"],["、"],["滅ぼされる","ほろぼされる"],["こと"],["も"],["ないで"],["あろう"],["に"],["。"],["」"]]},{"verse":20,"text":"バビロンから出よ。カルデヤからのがれよ。／喜びの歌声をあげて、これを告げ知らせよ。／地の果てにまで響き渡らせよ。／「主が、そのしもべヤコブを贖われた」と言え。","tok":[["バビロン"],["から"],["出","で"],["よ"],["。"],["カルデヤ"],["から"],["のがれ"],["よ"],["。"],["／"],["喜び","よろこび"],["の"],["歌声","うたごえ"],["を"],["あげて"],["、"],["これ"],["を"],["告げ知らせ","つげしらせ"],["よ"],["。"],["／"],["地","ち"],["の"],["果て","はて"],["に"],["まで"],["響き","ひびき"],["渡らせ","わたらせ"],["よ"],["。"],["／"],["「"],["主","ぬし"],["が"],["、"],["その"],["しもべ"],["ヤコブ"],["を"],["贖われた","あがなわれた"],["」"],["と"],["言え","いえ"],["。"]]},{"verse":21,"text":"主がかわいた地を通らせたときも、彼らは渇かなかった。／主は彼らのために岩から水を流れ出させ、岩を裂いて水をほとばしり出させた。","tok":[["主","ぬし"],["が"],["かわいた"],["地","ち"],["を"],["通らせた","とおらせた"],["とき"],["も"],["、"],["彼","かれ"],["ら"],["は"],["渇かなかった","かわかなかった"],["。"],["／"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["岩","いわ"],["から"],["水","みず"],["を"],["流れ出させ","ながれださせ"],["、"],["岩","いわ"],["を"],["裂いて","さいて"],["水","みず"],["を"],["ほとばしり出させた","ほとばしりでさせた"],["。"]]},{"verse":22,"text":"「悪者どもには平安がない」と主は仰せられる。","tok":[["「"],["悪者","わるもの"],["ども"],["に"],["は"],["平安","へいあん"],["が"],["ない"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]}]
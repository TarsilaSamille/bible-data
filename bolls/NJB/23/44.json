[{"verse":1,"text":"今、聞け、わたしのしもべヤコブ、わたしの選んだイスラエルよ。","tok":[["今","いま"],["、"],["聞け","きけ"],["、"],["わたし"],["の"],["しもべ"],["ヤコブ"],["、"],["わたし"],["の"],["選んだ","えらんだ"],["イスラエル"],["よ"],["。"]]},{"verse":2,"text":"あなたを造り、あなたを母の胎内にいる時から形造って、あなたを助ける主はこう仰せられる。／「恐れるな。わたしのしもべヤコブ、わたしの選んだエシュルンよ。","tok":[["あなた"],["を"],["造り","つくり"],["、"],["あなた"],["を"],["母","はは"],["の"],["胎内","たいない"],["に"],["いる"],["時","とき"],["から"],["形造って","かたちづくって"],["、"],["あなた"],["を"],["助ける","たすける"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["恐れる","おそれる"],["な"],["。"],["わたし"],["の"],["しもべ"],["ヤコブ"],["、"],["わたし"],["の"],["選んだ","えらんだ"],["エシュルン"],["よ"],["。"]]},{"verse":3,"text":"わたしは潤いのない地に水を注ぎ、かわいた地に豊かな流れを注ぎ、わたしの霊をあなたのすえに、わたしの祝福をあなたの子孫に注ごう。","tok":[["わたし"],["は"],["潤い","うるおい"],["の"],["ない"],["地","ち"],["に"],["水","みず"],["を"],["注ぎ","そそぎ"],["、"],["かわいた"],["地","ち"],["に"],["豊か","ゆたか"],["な"],["流れ","ながれ"],["を"],["注ぎ","そそぎ"],["、"],["わたし"],["の"],["霊","れい"],["を"],["あなた"],["の"],["すえ"],["に"],["、"],["わたし"],["の"],["祝福","しゅくふく"],["を"],["あなた"],["の"],["子孫","しそん"],["に"],["注ごう","そそごう"],["。"]]},{"verse":4,"text":"彼らは、流れのほとりの柳の木のように、青草の間に芽ばえる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["流れ","ながれ"],["の"],["ほとり"],["の"],["柳","やなぎ"],["の"],["木","き"],["の"],["よう"],["に"],["、"],["青草","あおくさ"],["の"],["間","あいだ"],["に"],["芽ばえる","めばえる"],["。"]]},{"verse":5,"text":"ある者は『私は主のもの』と言い、ある者はヤコブの名を名のり、ある者は手に『主のもの』としるして、イスラエルの名を名のる。」","tok":[["ある"],["者","もの"],["は"],["『"],["私","わたくし"],["は"],["主","ぬし"],["の"],["もの"],["』"],["と"],["言い","いい"],["、"],["ある"],["者","もの"],["は"],["ヤコブ"],["の"],["名","な"],["を"],["名のり","なのり"],["、"],["ある"],["者","もの"],["は"],["手","て"],["に"],["『"],["主","ぬし"],["の"],["もの"],["』"],["と"],["しるして"],["、"],["イスラエル"],["の"],["名","な"],["を"],["名のる","なのる"],["。"],["」"]]},{"verse":6,"text":"イスラエルの王である主、これを贖う方、万軍の主はこう仰せられる。／「わたしは初めであり、わたしは終わりである。／わたしのほかに神はない。","tok":[["イスラエル"],["の"],["王","おう"],["で"],["ある"],["主","ぬし"],["、"],["これ"],["を"],["贖う","あがなう"],["方","かた"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["わたし"],["は"],["初め","はじめ"],["で"],["あり"],["、"],["わたし"],["は"],["終わり","おわり"],["で"],["ある"],["。"],["／"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["。"]]},{"verse":7,"text":"わたしが永遠の民を起こしたときから、だれが、わたしのように宣言して、これを告げることができたか。／これをわたしの前で並べたててみよ。／彼らに未来の事、来たるべき事を／告げさせてみよ。","tok":[["わたし"],["が"],["永遠","えいえん"],["の"],["民","たみ"],["を"],["起こした","おこした"],["とき"],["から"],["、"],["だれ"],["が"],["、"],["わたし"],["の"],["よう"],["に"],["宣言","せんげん"],["して"],["、"],["これ"],["を"],["告げる","つげる"],["こと"],["が"],["できた"],["か"],["。"],["／"],["これ"],["を"],["わたし"],["の"],["前","まえ"],["で"],["並べたてて","ならべたてて"],["み"],["よ"],["。"],["／"],["彼","かれ"],["ら"],["に"],["未来","みらい"],["の"],["事","こと"],["、"],["来たるべき","きたるべき"],["事","こと"],["を"],["／"],["告げ","つげ"],["させて"],["み"],["よ"],["。"]]},{"verse":8,"text":"恐れるな、おののくな。／わたしが、もう古くからあなたに聞かせ、告げてきたではないか。／あなたがたはわたしの証人。／わたしのほかに神があろうか。／ほかに岩はない。わたしは知らない。","tok":[["恐れる","おそれる"],["な"],["、"],["おののく"],["な"],["。"],["／"],["わたし"],["が"],["、"],["もう"],["古く","ふるく"],["から"],["あなた"],["に"],["聞かせ","きかせ"],["、"],["告げて","つげて"],["きたで"],["は"],["ない"],["か"],["。"],["／"],["あなた"],["がた"],["は"],["わたし"],["の"],["証人","しょうにん"],["。"],["／"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["が"],["あろう"],["か"],["。"],["／"],["ほか"],["に"],["岩","いわ"],["は"],["ない"],["。"],["わたし"],["は"],["知らない","しらない"],["。"]]},{"verse":9,"text":"偶像を造る者はみな、むなしい。彼らの慕うものは何の役にも立たない。彼らの仕えるものは、見ることもできず、知ることもできない。彼らはただ恥を見るだけだ。","tok":[["偶像","ぐうぞう"],["を"],["造る","つくる"],["者","もの"],["は"],["みな"],["、"],["むなしい"],["。"],["彼","かれ"],["ら"],["の"],["慕う","したう"],["もの"],["は"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["。"],["彼","かれ"],["ら"],["の"],["仕える","つかえる"],["もの"],["は"],["、"],["見る","みる"],["こと"],["も"],["できず"],["、"],["知る","しる"],["こと"],["も"],["できない"],["。"],["彼","かれ"],["ら"],["は"],["ただ"],["恥","はじ"],["を"],["見る","みる"],["だけ"],["だ"],["。"]]},{"verse":10,"text":"だれが、いったい、何の役にも立たない神を造り、偶像を鋳たのだろうか。","tok":[["だれ"],["が"],["、"],["いったい"],["、"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["神","かみ"],["を"],["造り","つくり"],["、"],["偶像","ぐうぞう"],["を"],["鋳た","いた"],["の"],["だろう"],["か"],["。"]]},{"verse":11,"text":"見よ。その信徒たちはみな、恥を見る。それを細工した者が人間にすぎないからだ。彼らはみな集まり、立つがよい。彼らはおののいて共に恥を見る。","tok":[["見","み"],["よ"],["。"],["その"],["信徒","しんと"],["たち"],["は"],["みな"],["、"],["恥","はじ"],["を"],["見る","みる"],["。"],["それ"],["を"],["細工","さいく"],["した"],["者","もの"],["が"],["人間","にんげん"],["に"],["すぎない"],["から"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["集まり","あつまり"],["、"],["立つ","たつ"],["が"],["よい"],["。"],["彼","かれ"],["ら"],["は"],["おののいて"],["共","とも"],["に"],["恥","はじ"],["を"],["見る","みる"],["。"]]},{"verse":12,"text":"鉄で細工する者はなたを使い、炭火の上で細工し、金槌でこれを形造り、力ある腕でそれを造る。彼も腹がすくと力がなくなり、水を飲まないと疲れてしまう。","tok":[["鉄","てつ"],["で"],["細工","さいく"],["する"],["者","もの"],["は"],["なた"],["を"],["使い","つかい"],["、"],["炭火","すみび"],["の"],["上","うえ"],["で"],["細工","さいく"],["し"],["、"],["金槌","かなづち"],["で"],["これ"],["を"],["形造り","かたちづくり"],["、"],["力","ちから"],["ある"],["腕","うで"],["で"],["それ"],["を"],["造る","つくる"],["。"],["彼","かれ"],["も"],["腹","はら"],["が"],["すくと"],["力","ちから"],["が"],["なくなり"],["、"],["水","みず"],["を"],["飲まない","のまない"],["と"],["疲れて","つかれて"],["しまう"],["。"]]},{"verse":13,"text":"木で細工する者は、測りなわで測り、朱で輪郭をとり、かんなで削り、コンパスで線を引き、人の形に造り、人間の美しい姿に仕上げて、神殿に安置する。","tok":[["木","き"],["で"],["細工","さいく"],["する"],["者","もの"],["は"],["、"],["測り","はかり"],["なわ"],["で"],["測り","はかり"],["、"],["朱","しゅ"],["で"],["輪郭","りんかく"],["を"],["とり"],["、"],["かんな"],["で"],["削り","けずり"],["、"],["コンパス"],["で"],["線","せん"],["を"],["引き","ひき"],["、"],["人","ひと"],["の"],["形","かたち"],["に"],["造り","つくり"],["、"],["人間","にんげん"],["の"],["美しい","うつくしい"],["姿","すがた"],["に"],["仕上げて","しあげて"],["、"],["神殿","しんでん"],["に"],["安置","あんち"],["する"],["。"]]},{"verse":14,"text":"彼は杉の木を切り、あるいはうばめがしや樫の木を選んで、林の木の中で自分のために育てる。また、月桂樹を植えると、大雨が育てる。","tok":[["彼","かれ"],["は"],["杉","すぎ"],["の"],["木","き"],["を"],["切り","きり"],["、"],["あるいは"],["う"],["ばめ"],["が"],["し"],["や"],["樫","かし"],["の"],["木","き"],["を"],["選んで","えらんで"],["、"],["林","はやし"],["の"],["木","き"],["の"],["中","なか"],["で"],["自分","じぶん"],["の"],["ため"],["に"],["育てる","そだてる"],["。"],["また"],["、"],["月桂樹","げっけいじゅ"],["を"],["植える","うえる"],["と"],["、"],["大雨","おおあめ"],["が"],["育てる","そだてる"],["。"]]},{"verse":15,"text":"それは人間のたきぎになり、人はそのいくらかを取って暖まり、また、これを燃やしてパンを焼く。また、これで神を造って拝み、それを偶像に仕立てて、これにひれ伏す。","tok":[["それ"],["は"],["人間","にんげん"],["の"],["たきぎ"],["に"],["なり"],["、"],["人","ひと"],["は"],["その"],["いくら"],["か"],["を"],["取って","とって"],["暖まり","あたたまり"],["、"],["また"],["、"],["これ"],["を"],["燃やして","もやして"],["パン"],["を"],["焼く","やく"],["。"],["また"],["、"],["これ"],["で"],["神","かみ"],["を"],["造って","つくって"],["拝み","おがみ"],["、"],["それ"],["を"],["偶像","ぐうぞう"],["に"],["仕立てて","したてて"],["、"],["これ"],["に"],["ひれ伏す","ひれふす"],["。"]]},{"verse":16,"text":"その半分は火に燃やし、その半分で肉を食べ、あぶり肉をあぶって満腹する。また、暖まって、『ああ、暖まった。熱くなった』と言う。","tok":[["その"],["半分","はんぶん"],["は"],["火","ひ"],["に"],["燃やし","もやし"],["、"],["その"],["半分","はんぶん"],["で"],["肉","にく"],["を"],["食べ","たべ"],["、"],["あぶり肉","あぶりにく"],["を"],["あぶって"],["満腹","まんぷく"],["する"],["。"],["また"],["、"],["暖まって","あたたまって"],["、"],["『"],["ああ"],["、"],["暖まった","あたたまった"],["。"],["熱く","あつく"],["なった"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":17,"text":"その残りで神を造り、自分の偶像とし、それにひれ伏して拝み、それに祈って『私を救ってください。あなたは私の神だから』と言う。","tok":[["その"],["残り","のこり"],["で"],["神","かみ"],["を"],["造り","つくり"],["、"],["自分","じぶん"],["の"],["偶像","ぐうぞう"],["と"],["し"],["、"],["それ"],["に"],["ひれ伏して","ひれふして"],["拝み","おがみ"],["、"],["それ"],["に"],["祈って","いのって"],["『"],["私","わたくし"],["を"],["救って","すくって"],["ください"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["神","かみ"],["だ"],["から"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":18,"text":"彼らは知りもせず、悟りもしない。彼らの目は固くふさがって見ることもできず、彼らの心もふさがって悟ることもできない。","tok":[["彼","かれ"],["ら"],["は"],["知り","しり"],["も"],["せず"],["、"],["悟り","さとり"],["も"],["しない"],["。"],["彼","かれ"],["ら"],["の"],["目","め"],["は"],["固く","かたく"],["ふさがって"],["見る","みる"],["こと"],["も"],["できず"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["も"],["ふさがって"],["悟る","さとる"],["こと"],["も"],["できない"],["。"]]},{"verse":19,"text":"彼らは考えてもみず、知識も英知もないので、『私は、その半分を火に燃やし、その炭火でパンを焼き、肉をあぶって食べた。その残りで忌みきらうべき物を造り、木の切れ端の前にひれ伏すのだろうか』とさえ言わない。","tok":[["彼","かれ"],["ら"],["は"],["考えて","かんがえて"],["も"],["みず"],["、"],["知識","ちしき"],["も"],["英知","えいち"],["も"],["ない"],["ので"],["、"],["『"],["私","わたくし"],["は"],["、"],["その"],["半分","はんぶん"],["を"],["火","ひ"],["に"],["燃やし","もやし"],["、"],["その"],["炭火","すみび"],["で"],["パン"],["を"],["焼き","やき"],["、"],["肉","にく"],["を"],["あぶって"],["食べた","たべた"],["。"],["その"],["残り","のこり"],["で"],["忌みきらうべき","いみきらうべき"],["物","もの"],["を"],["造り","つくり"],["、"],["木","き"],["の"],["切れ端","きれはし"],["の"],["前","まえ"],["に"],["ひれ伏す","ひれふす"],["の"],["だろう"],["か"],["』"],["と"],["さえ"],["言わない","いわない"],["。"]]},{"verse":20,"text":"灰にあこがれる者の心は欺かれ、惑わされて、自分を救い出すことができず、『私の右の手には偽りがないのだろうか』とさえ言わない。","tok":[["灰","はい"],["に"],["あこがれる"],["者","もの"],["の"],["心","こころ"],["は"],["欺かれ","あざむかれ"],["、"],["惑わされて","まどわされて"],["、"],["自分","じぶん"],["を"],["救い出す","すくいだす"],["こと"],["が"],["できず"],["、"],["『"],["私","わたくし"],["の"],["右","みぎ"],["の"],["手","て"],["に"],["は"],["偽り","いつわり"],["が"],["ない"],["の"],["だろう"],["か"],["』"],["と"],["さえ"],["言わない","いわない"],["。"]]},{"verse":21,"text":"ヤコブよ。これらのことを覚えよ。／イスラエルよ。あなたはわたしのしもべ。／わたしが、あなたを造り上げた。／あなたは、わたし自身のしもべだ。／イスラエルよ。／あなたはわたしに忘れられることがない。","tok":[["ヤコブ"],["よ"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["覚え","おぼえ"],["よ"],["。"],["／"],["イスラエル"],["よ"],["。"],["あなた"],["は"],["わたし"],["の"],["しもべ"],["。"],["／"],["わたし"],["が"],["、"],["あなた"],["を"],["造り上げた","つくりあげた"],["。"],["／"],["あなた"],["は"],["、"],["わたし"],["自身","じしん"],["の"],["しもべ"],["だ"],["。"],["／"],["イスラエル"],["よ"],["。"],["／"],["あなた"],["は"],["わたし"],["に"],["忘れられる","わすれられる"],["こと"],["が"],["ない"],["。"]]},{"verse":22,"text":"わたしは、あなたのそむきの罪を雲のように、あなたの罪をかすみのようにぬぐい去った。／わたしに帰れ。／わたしは、あなたを贖ったからだ。」","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["そむき"],["の"],["罪","つみ"],["を"],["雲","くも"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["罪","つみ"],["を"],["かすみ"],["の"],["よう"],["に"],["ぬぐい去った","ぬぐいさった"],["。"],["／"],["わたし"],["に"],["帰れ","かえれ"],["。"],["／"],["わたし"],["は"],["、"],["あなた"],["を"],["贖った","あがなった"],["から"],["だ"],["。"],["」"]]},{"verse":23,"text":"天よ。喜び歌え。／主がこれを成し遂げられたから。／地のどん底よ。喜び叫べ。／山々よ。喜びの歌声をあげよ。／林とそのすべての木も。／主がヤコブを贖い、イスラエルのうちに、その栄光を現されるからだ。","tok":[["天","てん"],["よ"],["。"],["喜び歌え","よろこびうたえ"],["。"],["／"],["主","ぬし"],["が"],["これ"],["を"],["成し遂げられた","なしとげられた"],["から"],["。"],["／"],["地","ち"],["の"],["どん底","どんぞこ"],["よ"],["。"],["喜び叫べ","よろこびさけべ"],["。"],["／"],["山々","やまやま"],["よ"],["。"],["喜び","よろこび"],["の"],["歌声","うたごえ"],["を"],["あげ"],["よ"],["。"],["／"],["林","はやし"],["と"],["その"],["すべて"],["の"],["木","き"],["も"],["。"],["／"],["主","ぬし"],["が"],["ヤコブ"],["を"],["贖い","あがない"],["、"],["イスラエル"],["の"],["うち"],["に"],["、"],["その"],["栄光","えいこう"],["を"],["現される","あらわされる"],["から"],["だ"],["。"]]},{"verse":24,"text":"あなたを贖い、あなたを母の胎内にいる時から形造った方、主は／こう仰せられる。／「わたしは万物を造った主だ。／わたしはひとりで天を張り延ばし、ただ、わたしだけで、地を押し広げた。","tok":[["あなた"],["を"],["贖い","あがない"],["、"],["あなた"],["を"],["母","はは"],["の"],["胎内","たいない"],["に"],["いる"],["時","とき"],["から"],["形造った","かたちづくった"],["方","かた"],["、"],["主","ぬし"],["は"],["／"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["わたし"],["は"],["万物","ばんぶつ"],["を"],["造った","つくった"],["主","ぬし"],["だ"],["。"],["／"],["わたし"],["は"],["ひとり"],["で"],["天","てん"],["を"],["張り","はり"],["延ばし","のばし"],["、"],["ただ"],["、"],["わたし"],["だけ"],["で"],["、"],["地","ち"],["を"],["押し広げた","おしひろげた"],["。"]]},{"verse":25,"text":"わたしは自慢する者らのしるしを破り、占い師を狂わせ、知恵ある者を退けて、その知識を愚かにする。","tok":[["わたし"],["は"],["自慢","じまん"],["する"],["者","もの"],["ら"],["の"],["しるし"],["を"],["破り","やぶり"],["、"],["占い師","うらないし"],["を"],["狂わせ","くるわせ"],["、"],["知恵","ちえ"],["ある"],["者","もの"],["を"],["退けて","しりぞけて"],["、"],["その"],["知識","ちしき"],["を"],["愚か","おろか"],["に"],["する"],["。"]]},{"verse":26,"text":"わたしは、わたしのしもべのことばを成就させ、わたしの使者たちの計画を成し遂げさせる。／エルサレムに向かっては、『人が住むようになる』と言い、ユダの町々に向かっては、『町々は再建され、その廃墟はわたしが復興させる』と言う。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["しもべ"],["の"],["ことば"],["を"],["成就","じょうじゅ"],["させ"],["、"],["わたし"],["の"],["使者","ししゃ"],["たち"],["の"],["計画","けいかく"],["を"],["成し遂げさせる","なしとげさせる"],["。"],["／"],["エルサレム"],["に"],["向かって","むかって"],["は"],["、"],["『"],["人","ひと"],["が"],["住む","すむ"],["よう"],["に"],["なる"],["』"],["と"],["言い","いい"],["、"],["ユダ"],["の"],["町々","まちまち"],["に"],["向かって","むかって"],["は"],["、"],["『"],["町々","まちまち"],["は"],["再建","さいけん"],["され"],["、"],["その"],["廃墟","はいきょ"],["は"],["わたし"],["が"],["復興","ふっこう"],["させる"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":27,"text":"淵に向かっては、『干上がれ。／わたしはおまえの川々をからす』と言う。","tok":[["淵","ふち"],["に"],["向かって","むかって"],["は"],["、"],["『"],["干上がれ","ひあがれ"],["。"],["／"],["わたし"],["は"],["おまえ"],[
[{"verse":1,"text":"見よ。ひとりの王が正義によって治め、首長たちは公義によってつかさどる。","tok":[["見","み"],["よ"],["。"],["ひとり"],["の"],["王","おう"],["が"],["正義","せいぎ"],["によって"],["治め","おさめ"],["、"],["首長","しゅちょう"],["たち"],["は"],["公義","きみよし"],["によって"],["つかさどる"],["。"]]},{"verse":2,"text":"彼らはみな、風を避ける避け所、あらしを避ける隠れ場のようになり、砂漠にある水の流れ、かわききった地にある／大きな岩の陰のようになる。","tok":[["彼","かれ"],["ら"],["は"],["みな"],["、"],["風","かぜ"],["を"],["避ける","さける"],["避け所","よけしょ"],["、"],["あらし"],["を"],["避ける","さける"],["隠れ場","かくれば"],["の"],["よう"],["に"],["なり"],["、"],["砂漠","さばく"],["に"],["ある"],["水","みず"],["の"],["流れ","ながれ"],["、"],["かわき"],["きった"],["地","ち"],["に"],["ある"],["／"],["大きな","おおきな"],["岩","いわ"],["の"],["陰","かげ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":3,"text":"見る者は目を堅く閉ざさず、聞く者は耳を傾ける。","tok":[["見る","みる"],["者","もの"],["は"],["目","め"],["を"],["堅く","かたく"],["閉ざさず","とざさず"],["、"],["聞く","きく"],["者","もの"],["は"],["耳","みみ"],["を"],["傾ける","かたむける"],["。"]]},{"verse":4,"text":"気短な者の心も知識を悟り、どもりの舌も、はっきりと早口で語ることができる。","tok":[["気短","きみじか"],["な"],["者","もの"],["の"],["心","こころ"],["も"],["知識","ちしき"],["を"],["悟り","さとり"],["、"],["どもり"],["の"],["舌","した"],["も"],["、"],["はっきり"],["と"],["早口","はやくち"],["で"],["語る","かたる"],["こと"],["が"],["できる"],["。"]]},{"verse":5,"text":"もはや、しれ者が／高貴な人と呼ばれることがなく、ならず者が上流の人と言われることもない。","tok":[["もはや"],["、"],["しれ者","しれもの"],["が"],["／"],["高貴","こうき"],["な"],["人","ひと"],["と"],["呼ばれる","よばれる"],["こと"],["が"],["なく"],["、"],["ならず者","ならずもの"],["が"],["上流","じょうりゅう"],["の"],["人","ひと"],["と"],["言われる","いわれる"],["こと"],["も"],["ない"],["。"]]},{"verse":6,"text":"なぜなら、しれ者は恥ずべきことを語り、その心は不法をたくらんで、神を敬わず、主に向かって迷いごとを語り、飢えている者を飢えさせ、渇いている者に飲み物を飲ませないからだ。","tok":[["なぜ"],["なら"],["、"],["しれ者","しれもの"],["は"],["恥ずべき","はずべき"],["こと"],["を"],["語り","かたり"],["、"],["その"],["心","こころ"],["は"],["不法","ふほう"],["を"],["たくらんで"],["、"],["神","かみ"],["を"],["敬わず","うやまわず"],["、"],["主に","おもに"],["向かって","むかって"],["迷い","まよい"],["ごと"],["を"],["語り","かたり"],["、"],["飢えて","うえて"],["いる"],["者","もの"],["を"],["飢えさせ","うえさせ"],["、"],["渇いて","かわいて"],["いる"],["者","もの"],["に"],["飲み物","のみもの"],["を"],["飲ませない","のませない"],["から"],["だ"],["。"]]},{"verse":7,"text":"ならず者、そのやり方は悪い。／彼はみだらなことをたくらみ、貧しい者が正しいことを申し立てても、偽りを語って身分の低い者を滅ぼす。","tok":[["ならず者","ならずもの"],["、"],["その"],["やり方","やりかた"],["は"],["悪い","わるい"],["。"],["／"],["彼","かれ"],["は"],["みだら"],["な"],["こと"],["を"],["たくらみ"],["、"],["貧しい","まずしい"],["者","もの"],["が"],["正しい","ただしい"],["こと"],["を"],["申し立てて","もうしたてて"],["も"],["、"],["偽り","いつわり"],["を"],["語って","かたって"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":8,"text":"しかし、高貴な人は高貴なことを計画し、高貴なことを、いつもする。","tok":[["しかし"],["、"],["高貴","こうき"],["な"],["人","ひと"],["は"],["高貴","こうき"],["な"],["こと"],["を"],["計画","けいかく"],["し"],["、"],["高貴","こうき"],["な"],["こと"],["を"],["、"],["いつも"],["する"],["。"]]},{"verse":9,"text":"のんきな女たちよ。／立ち上がって、わたしの声を聞け。／うぬぼれている娘たちよ。／わたしの言うことに耳を傾けよ。","tok":[["のんき"],["な"],["女","おんな"],["たち"],["よ"],["。"],["／"],["立ち上がって","たちあがって"],["、"],["わたし"],["の"],["声","こえ"],["を"],["聞け","きけ"],["。"],["／"],["うぬぼれて"],["いる"],["娘","むすめ"],["たち"],["よ"],["。"],["／"],["わたし"],["の"],["言う","いう"],["こと"],["に"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"]]},{"verse":10,"text":"うぬぼれている女たちよ。／一年と少しの日がたつと、あなたがたはわななく。／ぶどうの収穫がなくなり、その取り入れもできなくなるからだ。","tok":[["うぬぼれて"],["いる"],["女","おんな"],["たち"],["よ"],["。"],["／"],["一","いち"],["年","ねん"],["と"],["少し","すこし"],["の"],["日","ひ"],["が"],["たつ"],["と"],["、"],["あなた"],["がた"],["は"],["わななく"],["。"],["／"],["ぶどう"],["の"],["収穫","しゅうかく"],["が"],["なくなり"],["、"],["その"],["取り入れ","とりいれ"],["も"],["できなく"],["なる"],["から"],["だ"],["。"]]},{"verse":11,"text":"のんきな女たちよ。おののけ。／うぬぼれている女たちよ。わななけ。／着物を脱ぎ、裸になり、腰に荒布をまとえ。","tok":[["のんき"],["な"],["女","おんな"],["たち"],["よ"],["。"],["おののけ"],["。"],["／"],["うぬぼれて"],["いる"],["女","おんな"],["たち"],["よ"],["。"],["わななけ"],["。"],["／"],["着物","きもの"],["を"],["脱ぎ","ぬぎ"],["、"],["裸","はだか"],["に"],["なり"],["、"],["腰","こし"],["に"],["荒布","あらめ"],["を"],["まとえ"],["。"]]},{"verse":12,"text":"胸を打って嘆け。／麗しい畑、実りの多いぶどうの木のために。","tok":[["胸","むね"],["を"],["打って","うって"],["嘆け","なげけ"],["。"],["／"],["麗しい","うるわしい"],["畑","はたけ"],["、"],["実り","みのり"],["の"],["多い","おおい"],["ぶどう"],["の"],["木","き"],["の"],["ため"],["に"],["。"]]},{"verse":13,"text":"いばらやおどろの生い茂る／わたしの民の土地のために。／そして、すべての楽しい家々、おごる都のために。","tok":[["いばら"],["や"],["おどろ"],["の"],["生い茂る","おいしげる"],["／"],["わたし"],["の"],["民","たみ"],["の"],["土地","とち"],["の"],["ため"],["に"],["。"],["／"],["そして"],["、"],["すべて"],["の"],["楽しい","たのしい"],["家々","いえいえ"],["、"],["おごる"],["都","と"],["の"],["ため"],["に"],["。"]]},{"verse":14,"text":"なぜなら、宮殿は見捨てられ、町の騒ぎもさびれ、オフェルと見張りの塔は、いつまでも荒地となり、野ろばの喜ぶ所、羊の群れの牧場となるからだ。","tok":[["なぜ"],["なら"],["、"],["宮殿","きゅうでん"],["は"],["見捨てられ","みすてられ"],["、"],["町","まち"],["の"],["騒ぎ","さわぎ"],["も"],["さびれ"],["、"],["オフェル"],["と"],["見張り","みはり"],["の"],["塔","とう"],["は"],["、"],["いつ"],["まで"],["も"],["荒地","あれち"],["と"],["なり"],["、"],["野","の"],["ろば"],["の"],["喜ぶ","よろこぶ"],["所","ところ"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["牧場","ぼくじょう"],["と"],["なる"],["から"],["だ"],["。"]]},{"verse":15,"text":"しかし、ついには、上から霊が私たちに注がれ、荒野が果樹園となり、果樹園が森とみなされるようになる。","tok":[["しかし"],["、"],["ついに"],["は"],["、"],["上","うえ"],["から"],["霊","れい"],["が"],["私たち","わたしたち"],["に"],["注がれ","そそがれ"],["、"],["荒野","こうや"],["が"],["果樹園","かじゅえん"],["と"],["なり"],["、"],["果樹園","かじゅえん"],["が"],["森","もり"],["と"],["みなされる"],["よう"],["に"],["なる"],["。"]]},{"verse":16,"text":"公正は荒野に宿り、義は果樹園に住む。","tok":[["公正","こうせい"],["は"],["荒野","こうや"],["に"],["宿り","やどり"],["、"],["義","ぎ"],["は"],["果樹園","かじゅえん"],["に"],["住む","すむ"],["。"]]},{"verse":17,"text":"義は平和をつくり出し、義はとこしえの平穏と信頼をもたらす。","tok":[["義","ぎ"],["は"],["平和","へいわ"],["を"],["つくり出し","つくりだし"],["、"],["義","ぎ"],["は"],["とこしえ"],["の"],["平穏","へいおん"],["と"],["信頼","しんらい"],["を"],["もたらす"],["。"]]},{"verse":18,"text":"わたしの民は、平和な住まい、安全な家、安らかないこいの場に住む。","tok":[["わたし"],["の"],["民","たみ"],["は"],["、"],["平和","へいわ"],["な"],["住まい","すまい"],["、"],["安全","あんぜん"],["な"],["家","いえ"],["、"],["安らか","やすらか"],["な"],["いこい"],["の"],["場","ば"],["に"],["住む","すむ"],["。"]]},{"verse":19,"text":"――雹が降ってあの森を倒し、あの町は全く卑しめられる。――","tok":[["―"],["―"],["雹","ひょう"],["が"],["降って","ふって"],["あの"],["森","もり"],["を"],["倒し","たおし"],["、"],["あの"],["町","まち"],["は"],["全く","まったく"],["卑しめられる","いやしめられる"],["。"],["―"],["―"]]},{"verse":20,"text":"ああ、幸いなことよ。／すべての水のほとりに種を蒔き、牛とろばとを放し飼いするあなたがたは。","tok":[["ああ"],["、"],["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["／"],["すべて
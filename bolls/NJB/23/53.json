[{"verse":1,"text":"私たちの聞いたことを、だれが信じたか。／主の御腕は、だれに現れたのか。","tok":[["私たち","わたしたち"],["の"],["聞いた","きいた"],["こと"],["を"],["、"],["だれ"],["が"],["信じた","しんじた"],["か"],["。"],["／"],["主","ぬし"],["の"],["御腕","おうで"],["は"],["、"],["だれ"],["に"],["現れた","あらわれた"],["の"],["か"],["。"]]},{"verse":2,"text":"彼は主の前に若枝のように芽ばえ、砂漠の地から出る根のように育った。／彼には、私たちが見とれるような姿もなく、輝きもなく、私たちが慕うような見ばえもない。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["前","まえ"],["に"],["若枝","わかえだ"],["の"],["よう"],["に"],["芽ばえ","めばえ"],["、"],["砂漠","さばく"],["の"],["地","ち"],["から"],["出る","でる"],["根","ね"],["の"],["よう"],["に"],["育った","そだった"],["。"],["／"],["彼","かれ"],["に"],["は"],["、"],["私たち","わたしたち"],["が"],["見とれる","みとれる"],["よう"],["な"],["姿","すがた"],["も"],["なく"],["、"],["輝き","かがやき"],["も"],["なく"],["、"],["私たち","わたしたち"],["が"],["慕う","したう"],["よう"],["な"],["見ばえ","みばえ"],["も"],["ない"],["。"]]},{"verse":3,"text":"彼はさげすまれ、人々からのけ者にされ、悲しみの人で病を知っていた。／人が顔をそむけるほどさげすまれ、私たちも彼を尊ばなかった。","tok":[["彼","かれ"],["は"],["さげすまれ"],["、"],["人々","ひとびと"],["から"],["のけ者","のけもの"],["に"],["され"],["、"],["悲しみ","かなしみ"],["の"],["人","ひと"],["で"],["病","やまい"],["を"],["知って","しって"],["いた"],["。"],["／"],["人","ひと"],["が"],["顔","かお"],["を"],["そむける"],["ほど"],["さげすまれ"],["、"],["私たち","わたしたち"],["も"],["彼","かれ"],["を"],["尊ばなかった","とうとばなかった"],["。"]]},{"verse":4,"text":"まことに、彼は私たちの病を負い、私たちの痛みをになった。／だが、私たちは思った。／彼は罰せられ、神に打たれ、苦しめられたのだと。","tok":[["まこと"],["に"],["、"],["彼","かれ"],["は"],["私たち","わたしたち"],["の"],["病","やまい"],["を"],["負い","おい"],["、"],["私たち","わたしたち"],["の"],["痛み","いたみ"],["を"],["に"],["なった"],["。"],["／"],["だ"],["が"],["、"],["私たち","わたしたち"],["は"],["思った","おもった"],["。"],["／"],["彼","かれ"],["は"],["罰せられ","ばっせられ"],["、"],["神","かみ"],["に"],["打たれ","うたれ"],["、"],["苦しめられた","くるしめられた"],["の"],["だ"],["と"],["。"]]},{"verse":5,"text":"しかし、彼は、私たちのそむきの罪のために刺し通され、私たちの咎のために砕かれた。／彼への懲らしめが私たちに平安をもたらし、彼の打ち傷によって、私たちはいやされた。","tok":[["しかし"],["、"],["彼","かれ"],["は"],["、"],["私たち","わたしたち"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["刺し通され","さしとおされ"],["、"],["私たち","わたしたち"],["の"],["咎","とが"],["の"],["ため"],["に"],["砕かれた","くだかれた"],["。"],["／"],["彼","かれ"],["へ"],["の"],["懲らしめ","こらしめ"],["が"],["私たち","わたしたち"],["に"],["平安","へいあん"],["を"],["もたらし"],["、"],["彼","かれ"],["の"],["打ち傷","うちきず"],["によって"],["、"],["私たち","わたしたち"],["は"],["いやされた"],["。"]]},{"verse":6,"text":"私たちはみな、羊のようにさまよい、おのおの、自分かってな道に向かって行った。／しかし、主は、私たちのすべての咎を／彼に負わせた。","tok":[["私たち","わたしたち"],["は"],["みな"],["、"],["羊","ひつじ"],["の"],["よう"],["に"],["さまよい"],["、"],["おのおの"],["、"],["自","じ"],["分かって","わかって"],["な"],["道","みち"],["に"],["向かって","むかって"],["行った","いった"],["。"],["／"],["しかし"],["、"],["主","ぬし"],["は"],["、"],["私たち","わたしたち"],["の"],["すべて"],["の"],["咎","とが"],["を"],["／"],["彼","かれ"],["に"],["負わせた","おわせた"],["。"]]},{"verse":7,"text":"彼は痛めつけられた。／彼は苦しんだが、口を開かない。／ほふり場に引かれて行く羊のように、毛を刈る者の前で黙っている雌羊のように、彼は口を開かない。","tok":[["彼","かれ"],["は"],["痛めつけられた","いためつけられた"],["。"],["／"],["彼","かれ"],["は"],["苦しんだ","くるしんだ"],["が"],["、"],["口","くち"],["を"],["開かない","ひらかない"],["。"],["／"],["ほふり場","ほふりじょう"],["に"],["引かれて","ひかれて"],["行く","いく"],["羊","ひつじ"],["の"],["よう"],["に"],["、"],["毛","け"],["を"],["刈る","かる"],["者","もの"],["の"],["前","まえ"],["で"],["黙って","だまって"],["いる"],["雌羊","めひつじ"],["の"],["よう"],["に"],["、"],["彼","かれ"],["は"],["口","くち"],["を"],["開かない","ひらかない"],["。"]]},{"verse":8,"text":"しいたげと、さばきによって、彼は取り去られた。／彼の時代の者で、だれが思ったことだろう。／彼がわたしの民のそむきの罪のために打たれ、生ける者の地から絶たれたことを。","tok":[["しいたげ"],["と"],["、"],["さばき"],["によって"],["、"],["彼","かれ"],["は"],["取り去られた","とりさられた"],["。"],["／"],["彼","かれ"],["の"],["時代","じだい"],["の"],["者","もの"],["で"],["、"],["だれ"],["が"],["思った","おもった"],["こと"],["だろう"],["。"],["／"],["彼","かれ"],["が"],["わたし"],["の"],["民","たみ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["打たれ","うたれ"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["から"],["絶たれた","たたれた"],["こと"],["を"],["。"]]},{"verse":9,"text":"彼の墓は悪者どもとともに設けられ、彼は富む者とともに葬られた。／彼は暴虐を行わず、その口に欺きはなかったが。","tok":[["彼","かれ"],["の"],["墓","はか"],["は"],["悪者","わるもの"],["ども"],["と"],["とも"],["に"],["設けられ","もうけられ"],["、"],["彼","かれ"],["は"],["富む","とむ"],["者","もの"],["と"],["とも"],["に"],["葬られた","ほうむられた"],["。"],["／"],["彼","かれ"],["は"],["暴虐","ぼうぎゃく"],["を"],["行わず","おこなわず"],["、"],["その"],["口","くち"],["に"],["欺き","あざむき"],["は"],["なかった"],["が"],["。"]]},{"verse":10,"text":"しかし、彼を砕いて、痛めることは／主のみこころであった。／もし彼が、自分のいのちを／罪過のためのいけにえとするなら、彼は末長く、子孫を見ることができ、主のみこころは彼によって成し遂げられる。","tok":[["しかし"],["、"],["彼","かれ"],["を"],["砕いて","くだいて"],["、"],["痛める","いためる"],["こと"],["は"],["／"],["主","ぬし"],["のみ"],["こころ"],["で"],["あった"],["。"],["／"],["もし"],["彼","かれ"],["が"],["、"],["自分","じぶん"],["の"],["いのち"],["を"],["／"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["と"],["するなら"],["、"],["彼","かれ"],["は"],["末長く","すえながく"],["、"],["子孫","しそん"],["を"],["見る","みる"],["こと"],["が"],["でき"],["、"],["主","ぬし"],["のみ"],["こころ"],["は"],["彼","かれ"],["によって"],["成し遂げられる","なしとげられる"],["。"]]},{"verse":11,"text":"彼は、自分のいのちの／激しい苦しみのあとを見て、満足する。／わたしの正しいしもべは、その知識によって多くの人を義とし、彼らの咎を彼がになう。","tok":[["彼","かれ"],["は"],["、"],["自分","じぶん"],["の"],["いのち"],["の"],["／"],["激しい","はげしい"],["苦しみ","くるしみ"],["の"],["あと"],["を"],["見て","みて"],["、"],["満足","まんぞく"],["する"],["。"],["／"],["わたし"],["の"],["正しい","ただしい"],["しもべ"],["は"],["、"],["その"],["知識","ちしき"],["によって"],["多く","おおく"],["の"],["人","ひと"],["を"],["義","ぎ"],["と"],["し"],["、"],["彼","かれ"],["ら"],["の"],["咎","とが"],["を"],["彼","かれ"],["が"],["になう"],["。"]]},{"verse":12,"text":"それゆえ、わたしは、多くの人々を彼に分け与え、彼は強者たちを分捕り物としてわかちとる。／彼が自分のいのちを死に明け渡し、そむいた人たちとともに数えられたからである。／彼は多くの人の罪を負い、そむいた人たちのためにとりなしをする。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["を"],["彼","かれ"],["に"],["分け与え","わけあたえ"],["、"],["彼","かれ"],["は"],["強者","きょうしゃ"],["たち"],["を"],["分捕り","ぶんどり"],["物","もの"],["として"],["わかちとる"],["。"],["／"],["彼","かれ"],["が"],["自分","じぶん"],["の"],["いのち"],["を"],["死に","しに"],["明け渡し","あけわたし"],["、"],["そむいた"],["人","ひと"],["たち"],["と"],["とも"],["に"],["数えられた","かぞえられた"],["から"],["で"],["ある"],["。"],["／"],["彼","かれ"],["は"],["多く","おおく"],["の"],["人","ひと"],["の"],["罪","つみ"],["を"],["負い","おい"],["、"],["そむいた"],["人","ひと"],["たち"],["の"],["ため"],["に"],["とり"],["なし"],["を"],["する"],["。"]]}]
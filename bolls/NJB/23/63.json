[{"verse":1,"text":"「エドムから来る者、ボツラから深紅の衣を着て来るこの者は、だれか。／その着物には威光があり、大いなる力をもって進んで来るこの者は。」「正義を語り、救うに力強い者、それがわたしだ。」","tok":[["「"],["エドム"],["から"],["来る","くる"],["者","もの"],["、"],["ボツラ"],["から"],["深紅","しんく"],["の"],["衣","ころも"],["を"],["着て","きて"],["来る","くる"],["この"],["者","もの"],["は"],["、"],["だれ"],["か"],["。"],["／"],["その"],["着物","きもの"],["に"],["は"],["威光","いこう"],["が"],["あり"],["、"],["大いなる","おおいなる"],["力","ちから"],["を"],["もって"],["進んで","すすんで"],["来る","くる"],["この"],["者","もの"],["は"],["。"],["」"],["「"],["正義","せいぎ"],["を"],["語り","かたり"],["、"],["救う","すくう"],["に"],["力強い","ちからづよい"],["者","もの"],["、"],["それ"],["が"],["わたし"],["だ"],["。"],["」"]]},{"verse":2,"text":"「なぜ、あなたの着物は赤く、あなたの衣は酒ぶねを踏む者のようなのか。」","tok":[["「"],["なぜ"],["、"],["あなた"],["の"],["着物","きもの"],["は"],["赤く","あかく"],["、"],["あなた"],["の"],["衣","ころも"],["は"],["酒","さか"],["ぶね"],["を"],["踏む","ふむ"],["者","もの"],["の"],["よう"],["な"],["の"],["か"],["。"],["」"]]},{"verse":3,"text":"「わたしはひとりで酒ぶねを踏んだ。／国々の民のうちに、わたしと事を共にする者はいなかった。／わたしは怒って彼らを踏み、憤って彼らを踏みにじった。／それで、彼らの血のしたたりが、わたしの衣にふりかかり、わたしの着物を、すっかり汚してしまった。","tok":[["「"],["わたし"],["は"],["ひとり"],["で"],["酒","さけ"],["ぶね"],["を"],["踏んだ","ふんだ"],["。"],["／"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["うち"],["に"],["、"],["わたし"],["と"],["事","こと"],["を"],["共","とも"],["に"],["する"],["者","もの"],["は"],["いなかった"],["。"],["／"],["わたし"],["は"],["怒って","おこって"],["彼","かれ"],["ら"],["を"],["踏み","ふみ"],["、"],["憤って","いきどおって"],["彼","かれ"],["ら"],["を"],["踏みにじった","ふみにじった"],["。"],["／"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["の"],["血","ち"],["の"],["した"],["たり"],["が"],["、"],["わたし"],["の"],["衣","ころも"],["に"],["ふりかかり"],["、"],["わたし"],["の"],["着物","きもの"],["を"],["、"],["すっかり"],["汚して","よごして"],["しまった"],["。"]]},{"verse":4,"text":"わたしの心のうちに復讐の日があり、わたしの贖いの年が来たからだ。","tok":[["わたし"],["の"],["心","こころ"],["の"],["うち"],["に"],["復讐","ふくしゅう"],["の"],["日","ひ"],["が"],["あり"],["、"],["わたし"],["の"],["贖い","あがない"],["の"],["年","とし"],["が"],["来た","きた"],["から"],["だ"],["。"]]},{"verse":5,"text":"わたしは見回したが、だれも助ける者はなく、いぶかったが、だれもささえる者はいなかった。／そこで、わたしの腕で救いをもたらし、わたしの憤りを、わたしのささえとした。","tok":[["わたし"],["は"],["見回した","みまわした"],["が"],["、"],["だれ"],["も"],["助ける","たすける"],["者","もの"],["は"],["なく"],["、"],["いぶかった"],["が"],["、"],["だれ"],["も"],["ささえる"],["者","もの"],["は"],["いなかった"],["。"],["／"],["そこ"],["で"],["、"],["わたし"],["の"],["腕","うで"],["で"],["救い","すくい"],["を"],["もたらし"],["、"],["わたし"],["の"],["憤り","いきどおり"],["を"],["、"],["わたし"],["の"],["ささえ"],["と"],["した"],["。"]]},{"verse":6,"text":"わたしは、怒って国々の民を踏みつけ、憤って彼らを踏みつぶし、彼らの血のしたたりを地に流した。」","tok":[["わたし"],["は"],["、"],["怒って","おこって"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["踏みつけ","ふみつけ"],["、"],["憤って","いきどおって"],["彼","かれ"],["ら"],["を"],["踏みつぶし","ふみつぶし"],["、"],["彼","かれ"],["ら"],["の"],["血","ち"],["の"],["した"],["たり"],["を"],["地","ち"],["に"],["流した","ながした"],["。"],["」"]]},{"verse":7,"text":"私は、主の恵みと、主の奇しいみわざをほめ歌おう。／主が私たちに報いてくださった／すべての事について、そのあわれみと、豊かな恵みによって／報いてくださったイスラエルの家への／豊かないつくしみについて。","tok":[["私","わたくし"],["は"],["、"],["主","ぬし"],["の"],["恵み","めぐみ"],["と"],["、"],["主","ぬし"],["の"],["奇しい","くすしい"],["みわざ"],["を"],["ほめ"],["歌おう","うたおう"],["。"],["／"],["主","ぬし"],["が"],["私たち","わたしたち"],["に"],["報いて","むくいて"],["くださった"],["／"],["すべて"],["の"],["事","こと"],["について"],["、"],["その"],["あわれみ"],["と"],["、"],["豊か","ゆたか"],["な"],["恵み","めぐみ"],["によって"],["／"],["報いて","むくいて"],["くださった"],["イスラエル"],["の"],["家","いえ"],["へ"],["の"],["／"],["豊か","ゆたか"],["な"],["いつくしみ"],["について"],["。"]]},{"verse":8,"text":"主は仰せられた。／「まことに彼らはわたしの民、偽りのない子たちだ」と。／こうして、主は彼らの救い主になられた。","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["／"],["「"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["、"],["偽り","いつわり"],["の"],["ない"],["子","こ"],["たち"],["だ"],["」"],["と"],["。"],["／"],["こう"],["して"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["救い主","すくいぬし"],["に"],["なられた"],["。"]]},{"verse":9,"text":"彼らが苦しむときには、いつも主も苦しみ、ご自身の使いが彼らを救った。／その愛とあわれみによって主は彼らを贖い、昔からずっと、彼らを背負い、抱いて来られた。","tok":[["彼","かれ"],["ら"],["が"],["苦しむ","くるしむ"],["とき"],["に"],["は"],["、"],["いつも"],["主","ぬし"],["も"],["苦しみ","くるしみ"],["、"],["ご自身","ごじしん"],["の"],["使い","つかい"],["が"],["彼","かれ"],["ら"],["を"],["救った","すくった"],["。"],["／"],["その"],["愛","あい"],["と"],["あわれみ"],["によって"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["贖い","あがない"],["、"],["昔","むかし"],["から"],["ずっと"],["、"],["彼","かれ"],["ら"],["を"],["背負い","せおい"],["、"],["抱いて","いだいて"],["来られた","こられた"],["。"]]},{"verse":10,"text":"しかし、彼らは逆らい、主の聖なる御霊を痛ませたので、主は彼らの敵となり、みずから彼らと戦われた。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["逆らい","さからい"],["、"],["主","ぬし"],["の"],["聖","せい"],["なる"],["御霊","ごれい"],["を"],["痛ませた","いたませた"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["敵","てき"],["と"],["なり"],["、"],["みずから"],["彼","かれ"],["ら"],["と"],["戦われた","たたかわれた"],["。"]]},{"verse":11,"text":"そのとき、主の民は、いにしえのモーセの日を思い出した。／「羊の群れの牧者たちとともに、彼らを海から上らせた方は、どこにおられるのか。／その中に主の聖なる御霊を置かれた方は、どこにおられるのか。","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["民","たみ"],["は"],["、"],["いにしえ"],["の"],["モーセ"],["の"],["日","ひ"],["を"],["思い出した","おもいだした"],["。"],["／"],["「"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["牧者","ぼくしゃ"],["たち"],["と"],["とも"],["に"],["、"],["彼","かれ"],["ら"],["を"],["海","うみ"],["から"],["上らせた","のぼらせた"],["方","ほう"],["は"],["、"],["どこ"],["に"],["おられる"],["の"],["か"],["。"],["／"],["その"],["中","なか"],["に"],["主","ぬし"],["の"],["聖","せい"],["なる"],["御霊","ごれい"],["を"],["置かれた","おかれた"],["方","ほう"],["は"],["、"],["どこ"],["に"],["おられる"],["の"],["か"],["。"]]},{"verse":12,"text":"その輝かしい御腕をモーセの右に進ませ、彼らの前で水を分け、永遠の名を成し、","tok":[["その"],["輝かしい","かがやかしい"],["御腕","おうで"],["を"],["モーセ"],["の"],["右","みぎ"],["に"],["進ませ","すすませ"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["水","みず"],["を"],["分け","わけ"],["、"],["永遠","えいえん"],["の"],["名","な"],["を"],["成し","なし"],["、"]]},{"verse":13,"text":"荒野の中を行く馬のように、つまずくことなく彼らに深みの底を／歩ませた方は、どこにおられるのか。","tok":[["荒野","こうや"],["の"],["中","なか"],["を"],["行く","いく"],["馬","うま"],["の"],["よう"],["に"],["、"],["つまずく"],["こと"],["なく"],["彼","かれ"],["ら"],["に"],["深み","ふかみ"],["の"],["底","そこ"],["を"],["／"],["歩ませた","あゆませた"],["方","ほう"],["は"],["、"],["どこ"],["に"],["おられる"],["の"],["か"],["。"]]},{"verse":14,"text":"家畜が谷に下るように、主の御霊が彼らをいこわせた。」／このようにして、あなたは、あなたの民を導き、あなたの輝かしい御名をあげられたのです。","tok":[["家畜","かちく"],["が"],["谷","たに"],["に"],["下る","くだる"],["よう"],["に"],["、"],["主","ぬし"],["の"],["御霊","ごれい"],["が"],["彼","かれ"],["ら"],["を"],["いこわせた"],["。"],["」"],["／"],["この"],["よう"],["に"],["して"],["、"],["あなた"],["は"],["、"],["あなた"],["の"],["民","たみ"],["を"],["導き","みちびき"],["、"],["あなた"],["の"],["輝かしい","かがやかしい"],["御名","ぎょめい"],["を"],["あげられた"],["の"],["です"],["。"]]},{"verse":15,"text":"どうか、天から見おろし、聖なる輝かしい御住まいからご覧ください。／あなたの熱心と、力あるみわざは、どこにあるのでしょう。／私へのあなたのたぎる思いとあわれみを、あなたは押さえておられるのですか。","tok":[["どう"],["か"],["、"],["天","てん"],["から"],["見おろし","みおろし"],["、"],["聖","せい"],["なる"],["輝かしい","かがやかしい"],["御住まい","おすまい"],["から"],["ご覧","ごらん"],["ください"],["。"],["／"],["あなた"],["の"],["熱心","ねっしん"],["と"],["、"],["力","ちから"],["ある"],["みわざ"],["は"],["、"],["どこ"],["に"],["ある"],["の"],["でしょう"],["。"],["／"],["私","わたくし"],["へ"],["の"],["あなた"],["の"],["たぎる"],["思い","おもい"],["と"],["あわれみ"],["を"],["、"],["あなた"],["は"],["押さえて","おさえて"],["おられる"],["の"],["です"],["か"],["。"]]},{"verse":16,"text":"まことに、あなたは私たちの父です。／たとい、アブラハムが私たちを知らず、イスラエルが私たちを認めなくても、主よ、あなたは、私たちの父です。／あなたの御名は、とこしえから／私たちの贖い主です。","tok":[["まこと"],["に"],["、"],["あなた"],["は"],["私たち","わたしたち"],["の"],["父","ちち"],["です"],["。"],["／"],["たとい"],["、"],["アブラハム"],["が"],["私たち","わたしたち"],["を"],["知らず","しらず"],["、"],["イスラエル"],["が"],["私たち","わたしたち"],["を"],["認めなくて","みとめなくて"],["も"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["、"],["私たち","わたしたち"],["の"],["父","ちち"],["です"],["。"],["／"],["あなた"],["の"],["御名","ぎょめい"],["は"],["、"],["とこしえ"],["から"],["／"],["私たち","わたしたち"],["の"],["贖い","あがない"],["主","ぬし"],["です"],["。"]]},{"verse":17,"text":"主よ。なぜあなたは、私たちをあなたの道から迷い出させ、私たちの心をかたくなにして、あなたを恐れないようにされるのですか。／あなたのしもべたち、あなたのゆずりの地の部族のために、どうかお帰りください。","tok":[["主","ぬし"],["よ"],["。"],["なぜ"],["あなた"],["は"],["、"],["私たち","わたしたち"],["を"],["あなた"],["の"],["道","みち"],["から"],["迷い出させ","まよいでさせ"],["、"],["私たち","わたしたち"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["、"],["あなた"],["を"],["恐れない","おそれない"],["よう"],["に"],["される"],["の"],["です"],["か"],["。"],["／"],["あなた"],["の"],["しもべ"],["たち"],["、"],["あなた"],["の"],["ゆずり"],["の"],["地","ち"],["の"],["部族","ぶぞく"],["の"],["ため"],["に"],["、"],["どう"],["か"],["お帰り","おかえり"],["ください"],["。"]]},{"verse":18,"text":"あなたの聖なる民がこの地を所有して間もなく、私たちの敵は、あなたの聖所を踏みつけました。","tok":[["あなた"],["の"],["聖","せい"],["なる"],["民","たみ"],["が"],["この"],["地","ち"],["を"],
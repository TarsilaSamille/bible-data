[{"verse":1,"text":"義人が滅びても心に留める者はなく、誠実な人が取り去られても、心を向ける者もいない。／まことに、義人はわざわいから取り去られて、","tok":[["義人","ぎじん"],["が"],["滅びて","ほろびて"],["も"],["心","こころ"],["に"],["留める","とめる"],["者","もの"],["は"],["なく"],["、"],["誠実","せいじつ"],["な"],["人","ひと"],["が"],["取り去られて","とりさられて"],["も"],["、"],["心","こころ"],["を"],["向ける","むける"],["者","もの"],["も"],["いない"],["。"],["／"],["まこと"],["に"],["、"],["義人","ぎじん"],["は"],["わざわい"],["から"],["取り去られて","とりさられて"],["、"]]},{"verse":2,"text":"平安に入り、まっすぐに歩む人は、自分の寝床で休むことができる。","tok":[["平安","へいあん"],["に"],["入り","はいり"],["、"],["まっすぐ"],["に"],["歩む","あゆむ"],["人","ひと"],["は"],["、"],["自分","じぶん"],["の"],["寝床","ねどこ"],["で"],["休む","やすむ"],["こと"],["が"],["できる"],["。"]]},{"verse":3,"text":"しかし、あなたがた、女卜者の子ら、姦夫と遊女のすえよ。／ここに近寄れ。","tok":[["しかし"],["、"],["あなた"],["がた"],["、"],["女","じょ"],["卜者","ぼくしゃ"],["の"],["子","こ"],["ら"],["、"],["姦夫","かんぷ"],["と"],["遊女","ゆうじょ"],["の"],["すえ"],["よ"],["。"],["／"],["ここ"],["に"],["近寄れ","ちかよれ"],["。"]]},{"verse":4,"text":"あなたがたは、だれをからかい、だれに向かって口を大きく開いて、舌を出すのか。／あなたがたはそむきの子ら、偽りのすえではないか。","tok":[["あなた"],["がた"],["は"],["、"],["だれ"],["を"],["からかい"],["、"],["だれ"],["に"],["向かって","むかって"],["口","くち"],["を"],["大きく","おおきく"],["開いて","ひらいて"],["、"],["舌","した"],["を"],["出す","だす"],["の"],["か"],["。"],["／"],["あなた"],["がた"],["は"],["そむき"],["の"],["子","こ"],["ら"],["、"],["偽り","いつわり"],["の"],["すえ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":5,"text":"あなたがたは、樫の木の間や、すべての生い茂る木の下で、身を焦がし、谷や、岩のはざまで／子どもをほふっているではないか。","tok":[["あなた"],["がた"],["は"],["、"],["樫","かし"],["の"],["木の間","このま"],["や"],["、"],["すべて"],["の"],["生い茂る","おいしげる"],["木","き"],["の"],["下","もと"],["で"],["、"],["身","み"],["を"],["焦がし","こがし"],["、"],["谷","たに"],["や"],["、"],["岩","いわ"],["の"],["はざま"],["で"],["／"],["子ども","こども"],["を"],["ほふって"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"谷川のなめらかな石がおまえの分け前、そこいらの石が、おまえの受ける割り当て。／それらに、おまえは、注ぎのぶどう酒を注ぎ、穀物のささげ物をささげているが、こんな物で、わたしが慰められようか。","tok":[["谷川","たにがわ"],["の"],["なめらか"],["な"],["石","いし"],["が"],["おまえ"],["の"],["分け前","わけまえ"],["、"],["そこ"],["いら"],["の"],["石","いし"],["が"],["、"],["おまえ"],["の"],["受ける","うける"],["割り当て","わりあて"],["。"],["／"],["それ"],["ら"],["に"],["、"],["おまえ"],["は"],["、"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注ぎ","そそぎ"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["ささげて"],["いる"],["が"],["、"],["こんな"],["物","もの"],["で"],["、"],["わたし"],["が"],["慰められよう","なぐさめられよう"],["か"],["。"]]},{"verse":7,"text":"そびえる高い山の上に、あなたは寝床を設け、そこにも、上って行って／あなたはいけにえをささげた。","tok":[["そびえる"],["高い","たかい"],["山","やま"],["の"],["上","うえ"],["に"],["、"],["あなた"],["は"],["寝床","ねどこ"],["を"],["設け","もうけ"],["、"],["そこ"],["に"],["も"],["、"],["上って","のぼって"],["行って","いって"],["／"],["あなた"],["は"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":8,"text":"あなたは、とびらと柱のうしろに、あなたを象徴する像を置いた。／あなたはわたしを捨てて、裸になり、寝床に上ってそれを広げ、彼らと契りを結び、彼らの寝床を愛し、その象徴物を見た。","tok":[["あなた"],["は"],["、"],["とびら"],["と"],["柱","はしら"],["の"],["うしろ"],["に"],["、"],["あなた"],["を"],["象徴","しょうちょう"],["する"],["像","ぞう"],["を"],["置いた","おいた"],["。"],["／"],["あなた"],["は"],["わたし"],["を"],["捨てて","すてて"],["、"],["裸","はだか"],["に"],["なり"],["、"],["寝床","ねどこ"],["に"],["上って","のぼって"],["それ"],["を"],["広げ","ひろげ"],["、"],["彼","かれ"],["ら"],["と"],["契り","ちぎり"],["を"],["結び","むすび"],["、"],["彼","かれ"],["ら"],["の"],["寝床","ねどこ"],["を"],["愛し","あいし"],["、"],["その"],["象徴物","しょうちょうぶつ"],["を"],["見た","みた"],["。"]]},{"verse":9,"text":"あなたは油を携えてモレクのところまで旅し、香料を増し加え、あなたの使者たちを遠くまで送り出し、よみにまでも下らせた。","tok":[["あなた"],["は"],["油","あぶら"],["を"],["携えて","たずさえて"],["モレク"],["の"],["ところ"],["まで"],["旅","たび"],["し"],["、"],["香料","こうりょう"],["を"],["増し加え","ましくわえ"],["、"],["あなた"],["の"],["使者","ししゃ"],["たち"],["を"],["遠く","とおく"],["まで"],["送り出し","おくりだし"],["、"],["よみ"],["に"],["まで"],["も"],["下らせた","くだらせた"],["。"]]},{"verse":10,"text":"あなたは、長い旅に疲れても、「あきらめた」とは言わなかった。／あなたは元気を回復し、弱らなかった。","tok":[["あなた"],["は"],["、"],["長い","ながい"],["旅","たび"],["に"],["疲れて","つかれて"],["も"],["、"],["「"],["あきらめた"],["」"],["と"],["は"],["言わなかった","いわなかった"],["。"],["／"],["あなた"],["は"],["元気","げんき"],["を"],["回復","かいふく"],["し"],["、"],["弱らなかった","よわらなかった"],["。"]]},{"verse":11,"text":"あなたは、だれにおじけ、だれを恐れて、まやかしを言うのか。／あなたはわたしを思い出さず、心にも留めなかった。／わたしが久しく、黙っていたので、わたしを恐れないのではないか。","tok":[["あなた"],["は"],["、"],["だれ"],["に"],["おじけ"],["、"],["だれ"],["を"],["恐れて","おそれて"],["、"],["まや
[{"verse":1,"text":"ああ。／エフライムの酔いどれの誇りとする冠、その美しい飾りのしぼんでゆく花。／これは、酔いつぶれた者たちの／肥えた谷の頂にある。","tok":[["ああ"],["。"],["／"],["エフライム"],["の"],["酔いどれ","よいどれ"],["の"],["誇り","ほこり"],["と"],["する"],["冠","かんむり"],["、"],["その"],["美しい","うつくしい"],["飾り","かざり"],["の"],["しぼんで"],["ゆく"],["花","はな"],["。"],["／"],["これ"],["は"],["、"],["酔いつぶれた","よいつぶれた"],["者","もの"],["たち"],["の"],["／"],["肥えた","こえた"],["谷","たに"],["の"],["頂","いただき"],["に"],["ある"],["。"]]},{"verse":2,"text":"見よ。主は強い、強いものを持っておられる。／それは、刺し通して荒れ狂う雹のあらしのようだ。／激しい勢いで押し流す豪雨のようだ。／主はこれを力いっぱい地に投げつける。","tok":[["見","み"],["よ"],["。"],["主","ぬし"],["は"],["強い","つよい"],["、"],["強い","つよい"],["もの"],["を"],["持って","もって"],["おられる"],["。"],["／"],["それ"],["は"],["、"],["刺し通して","さしとおして"],["荒れ狂う","あれくるう"],["雹","ひょう"],["の"],["あらし"],["の"],["よう"],["だ"],["。"],["／"],["激しい","はげしい"],["勢い","いきおい"],["で"],["押し流す","おしながす"],["豪雨","ごうう"],["の"],["よう"],["だ"],["。"],["／"],["主","ぬし"],["は"],["これ"],["を"],["力いっぱい","ちからいっぱい"],["地","ち"],["に"],["投げつける","なげつける"],["。"]]},{"verse":3,"text":"エフライムの酔いどれの誇りとする冠は、足の下に踏みにじられ、","tok":[["エフライム"],["の"],["酔いどれ","よいどれ"],["の"],["誇り","ほこり"],["と"],["する"],["冠","かんむり"],["は"],["、"],["足","あし"],["の"],["下","した"],["に"],["踏みにじられ","ふみにじられ"],["、"]]},{"verse":4,"text":"肥えた谷の頂にあって／これを美しく飾る花もしぼみ、夏前の初なりのいちじくの実のようになる。／だれかがそれを見つけると、それを手に取って、すぐのみこんでしまう。","tok":[["肥えた","こえた"],["谷","たに"],["の"],["頂","いただき"],["に"],["あって"],["／"],["これ"],["を"],["美しく","うつくしく"],["飾る","かざる"],["花","はな"],["も"],["しぼみ"],["、"],["夏","なつ"],["前","まえ"],["の"],["初なり","はつなり"],["の"],["いちじく"],["の"],["実","じつ"],["の"],["よう"],["に"],["なる"],["。"],["／"],["だれ"],["か"],["が"],["それ"],["を"],["見つける","みつける"],["と"],["、"],["それ"],["を"],["手","て"],["に"],["取って","とって"],["、"],["すぐ"],["のみこんで"],["しまう"],["。"]]},{"verse":5,"text":"その日、万軍の主は、民の残りの者にとって、美しい冠、栄えの飾り輪となり、","tok":[["その"],["日","ひ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["民","みん"],["の"],["残り","のこり"],["の"],["者","もの"],["にとって"],["、"],["美しい","うつくしい"],["冠","かんむり"],["、"],["栄え","はえ"],["の"],["飾り輪","かざりりん"],["と"],["なり"],["、"]]},{"verse":6,"text":"さばきの座に着く者にとって、さばきの霊となり、攻撃して来る者を城門で追い返す者にとって、力となられる。","tok":[["さばき"],["の"],["座","ざ"],["に"],["着く","つく"],["者","もの"],["にとって"],["、"],["さばき"],["の"],["霊","れい"],["と"],["なり"],["、"],["攻撃","こうげき"],["して"],["来る","くる"],["者","もの"],["を"],["城門","じょうもん"],["で"],["追い返す","おいかえす"],["者","もの"],["にとって"],["、"],["力","ちから"],["と"],["なられる"],["。"]]},{"verse":7,"text":"しかし、これらの者もまた、ぶどう酒のためによろめき、強い酒のためにふらつき、祭司も預言者も、強い酒のためによろめき、ぶどう酒のために混乱し、強い酒のためにふらつき、幻を見ながらよろめき、さばきを下すときよろける。","tok":[["しかし"],["、"],["これ"],["ら"],["の"],["者","もの"],["も"],["また"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["ため"],["に"],["よろめき"],["、"],["強い","つよい"],["酒","さけ"],["の"],["ため"],["に"],["ふらつき"],["、"],["祭司","さいし"],["も"],["預言者","よげんしゃ"],["も"],["、"],["強い","つよい"],["酒","さけ"],["の"],["ため"],["に"],["よろめき"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["ため"],["に"],["混乱","こんらん"],["し"],["、"],["強い","つよい"],["酒","さけ"],["の"],["ため"],["に"],["ふらつき"],["、"],["幻","まぼろし"],["を"],["見","み"],["ながら"],["よろめき"],["、"],["さばき"],["を"],["下す","くだす"],["とき"],["よろける"],["。"]]},{"verse":8,"text":"どの食卓も吐いた汚物でいっぱいで、余す所もない。","tok":[["どの"],["食卓","しょくたく"],["も"],["吐いた","はいた"],["汚物","おぶつ"],["で"],["いっぱい"],["で"],["、"],["余す","あます"],["所","ところ"],["も"],["ない"],["。"]]},{"verse":9,"text":"「彼はだれに知識を教えようとしているのか。／だれに啓示を悟らせようとしているのか。／乳離れした子にか。乳房を離された子にか。","tok":[["「"],["彼","かれ"],["は"],["だれ"],["に"],["知識","ちしき"],["を"],["教えよう","おしえよう"],["として"],["いる"],["の"],["か"],["。"],["／"],["だれ"],["に"],["啓示","けいじ"],["を"],["悟らせよう","さとらせよう"],["として"],["いる"],["の"],["か"],["。"],["／"],["乳離れ","ちばなれ"],["した"],["子","こ"],["に"],["か"],["。"],["乳房","ちぶさ"],["を"],["離された","はなされた"],["子","こ"],["に"],["か"],["。"]]},{"verse":10,"text":"彼は言っている。／『戒めに戒め、戒めに戒め、規則に規則、規則に規則、ここに少し、あそこに少し』と。」","tok":[["彼","かれ"],["は"],["言って","いって"],["いる"],["。"],["／"],["『"],["戒め","いましめ"],["に"],["戒め","いましめ"],["、"],["戒め","いましめ"],["に"],["戒め","いましめ"],["、"],["規則","きそく"],["に"],["規則","きそく"],["、"],["規則","きそく"],["に"],["規則","きそく"],["、"],["ここ"],["に"],["少し","すこし"],["、"],["あそこ"],["に"],["少し","すこし"],["』"],["と"],["。"],["」"]]},{"verse":11,"text":"まことに主は、もつれた舌で、外国のことばで、この民に語られる。","tok":[["まこと"],["に"],["主","ぬし"],["は"],["、"],["もつれた"],["舌","した"],["で"],["、"],["外国","がいこく"],["の"],["ことば"],["で"],["、"],["この"],["民","たみ"],["に"],["語られる","かたられる"],["。"]]},{"verse":12,"text":"主は、彼らに「ここにいこいがある。／疲れた者をいこわせよ。ここに休みがある」／と仰せられたのに、彼らは聞こうとはしなかった。","tok":[["主","ぬし"],["は"],["、"],["彼","かれ"],["ら"],["に"],["「"],["ここ"],["に"],["いこい"],["が"],["ある"],["。"],["／"],["疲れた","つかれた"],["者","もの"],["を"],["いこわせ"],["よ"],["。"],["ここ"],["に"],["休み","やすみ"],["が"],["ある"],["」"],["／"],["と"],["仰せられた","おおせられた"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["聞こう","きこう"],["と"],["は"],["しなかった"],["。"]]},{"verse":13,"text":"主は彼らに告げられる。／「戒めに戒め、戒めに戒め、規則に規則、規則に規則、ここに少し、あそこに少し。」／これは、彼らが歩くとき、うしろざまに倒れ、手足を折られ、わなにかかって／捕らえられるためである。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["に"],["告げられる","つげられる"],["。"],["／"],["「"],["戒め","いましめ"],["に"],["戒め","いましめ"],["、"],["戒め","いましめ"],["に"],["戒め","いましめ"],["、"],["規則","きそく"],["に"],["規則","きそく"],["、"],["規則","きそく"],["に"],["規則","きそく"],["、"],["ここ"],["に"],["少し","すこし"],["、"],["あそこ"],["に"],["少し","すこし"],["。"],["」"],["／"],["これ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["歩く","あるく"],["とき"],["、"],["うしろざま"],["に"],["倒れ","たおれ"],["、"],["手足","てあし"],["を"],["折られ","おられ"],["、"],["わな"],["に"],["かかって"],["／"],["捕らえられる","とらえられる"],["ため"],["で"],["ある"],["。"]]},{"verse":14,"text":"それゆえ、あざける者たち――／エルサレムにいてこの民を／物笑いの種にする者たちよ。／主のことばを聞け。","tok":[["それ"],["ゆえ"],["、"],["あざける"],["者","もの"],["たち"],["―"],["―"],["／"],["エルサレム"],["に"],["いて"],["この"],["民","たみ"],["を"],["／"],["物笑い","ものわらい"],["の"],["種","しゅ"],["に"],["する"],["者","もの"],["たち"],["よ"],["。"],["／"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":15,"text":"あなたがたは、こう言ったからだ。「私たちは死と契約を結び、よみと同盟を結んでいる。たとい、にわか水があふれ、越えて来ても、それは私たちには届かない。私たちは、まやかしを避け所とし、偽りに身を隠してきたのだから。」","tok":[["あなた"],["がた"],["は"],["、"],["こう"],["言った","いった"],["から"],["だ"],["。"],["「"],["私たち","わたしたち"],["は"],["死","し"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["よみ"],["と"],["同盟","どうめい"],["を"],["結んで","むすんで"],["いる"],["。"],["たとい"],["、"],["にわか"],["水","みず"],["が"],["あふれ"],["、"],["越えて","こえて"],["来て","きて"],["も"],["、"],["それ"],["は"],["私たち","わたしたち"],["に"],["は"],["届かない","とどかない"],["。"],["私たち","わたしたち"],["は"],["、"],["まやかし"],["を"],["避け","さけ"],["所","しょ"],["と"],["し"],["、"],["偽り","いつわり"],["に"],["身","み"],["を"],["隠して","かくして"],["きた"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":16,"text":"だから、神である主は、こう仰せられる。／「見よ。わたしはシオンに／一つの石を礎として据える。／これは、試みを経た石、堅く据えられた礎の、尊いかしら石。／これを信じる者は、あわてることがない。","tok":[["だ"],["から"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["シオン"],["に"],["／"],["一","ひと"],["つ"],["の"],["石","いし"],["を"],["礎","いしずえ"],["として"],["据える","すえる"],["。"],["／"],["これ"],["は"],["、"],["試み","こころみ"],["を"],["経た","へた"],["石","いし"],["、"],["堅く","かたく"],["据えられた","すえられた"],["礎","いしずえ"],["の"],["、"],["尊い","とうとい"],["かしら"],["石","いし"],["。"],["／"],["これ"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["あわてる"],["こと"],["が"],["ない"],["。"]]},{"verse":17,"text":"わたしは公正を、測りなわとし、正義を、おもりとする。／雹は、まやかしの避け所を一掃し、水は隠れ家を押し流す。","tok":[["わたし"],["は"],["公正","こうせい"],["を"],["、"],["測り","はかり"],["なわ"],["と"],["し"],["、"],["正義","せいぎ"],["を"],["、"],["おもり"],["と"],["する"],["。"],["／"],["雹","ひょう"],["は"],["、"],["まやかし"],["の"],["避け","さけ"],["所","しょ"],["を"],["一掃","いっそう"],["し"],["、"],["水","みず"],["は"],["隠れ家","かくれが"],["を"],["押し流す","おしながす"],["。"]]},{"verse":18,"text":"あなたがたの死との契約は解消され、よみとの同盟は成り立たない。／にわか水があふれ、越えて来ると、あなたがたはそれに踏みにじられる。","tok":[["あなた"],["がた"],["の"],["死","し"],["と"],["の"],["契約","けいやく"],["は"],["解消","かいしょう"],["され"],["、"],["よみ"],["と"],["の"],["同盟","どうめい"],["は"],["成り立たない","なりたたない"],["。"],["／"],["にわか"],["水","みず"],["が"],["あふれ"],["、"],["越えて","こえて"],["来る","くる"],["と"],["、"],["あなた"],["がた"],["は"],["それ"],["に"],["踏みにじられる","ふみにじられる"],["。"]]},{"verse":19,"text":"それは押し寄せるたびに、あなたがたを捕らえる。／それは朝ごとに押し寄せる。昼も夜も。／この啓示を悟らせることは全く恐ろしい。」","tok":[["それ"],["は"],["押し寄せる","おしよせる"],["たび"],["に"],["、"],["あなた"],["がた"],["を"],["捕らえる","とらえる"],["。"],["／"],["それ"],["は"],["朝","あさ"],["ごと"],["に"],["押し寄せる","おしよせる"],["。"],["昼","ひる"],["も"],["夜","よる"],["も"],["。"],["／"],["この"],["啓示","けいじ"],["を"],["悟らせる","さとらせる"],["こと"],["は"],["全く","まったく"],["恐ろしい","おそろしい"],["。"],["」"]]},{"verse":20,"text":"寝床は、身を伸ばすには短すぎ、毛布も、身をくるむには狭すぎるようになる。","tok":[["寝床","ねどこ"],["は"],["、"],["身","み"],["を"],["伸ばす","のばす"],["に"],["は"],["短","みじか"],["すぎ"],["、"],["毛布","もうふ"],["も"],["、"],["身","み"],["を"],["くるむ"],["に"],["は"],["狭","せま"],["すぎる"],["よう"],["に"],["なる"],["。"]]},{"verse":21,"text":"実に、主はペラツィムの山でのように起き上がり、ギブオンの谷でのように奮い立ち、そのみわざを行われる。／そのみわざは異なっている。／また、その働きをされる。／その働きは比類がない。","tok":[["実","じつ"],["に"],["、"],["主","ぬし"],["は"],["ペラツィム"],["の"],["山","やま"],["で"],["の"],["よう"],["に"],["起き上がり","おきあがり"],["、"],["ギブオン"],["の"],["谷","たに"],["で"],["の"],["よう"],["に"],["奮い立ち","ふるいたち"],["、"],["その"],["みわざ"],["を"],["行われる","おこなわれる"],["。"],["／"],["その"],["みわざ"],["は"],["異なって","ことなって"],["いる"],["。"],["／"],["また"],["、"],["その"],["働き","はたらき"],["を"],["される"],["。"],["／"],["その"],["働き","はたらき"],["は"],["比類","ひるい"],["が"],["ない"],["。"]]},{"verse":22,"text":"だから今、あなたがたはあざけり続けるな。／あなたがたを縛るかせが、きつくされるといけないから。／私は万軍の神、主から、全世界に下る決定的な全滅について／聞いているのだ。","tok":[["だ"],["から"],["今","いま"],["、"],["あなた"],["がた"],["は"],["あざけり"],["続ける","つづける"],["な"],["。"],["／"],["あなた"],["がた"],["を"],["縛る","しばる"],["かせが"],["、"],["きつく"],["される"],["と"],["いけない"],["から"],["。"],["／"],["私","わたくし"],["は"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["から"],["、"],["全","ぜん"],["世界","せかい"],["に"],["下る","くだる"],["決定的","けっていてき"],["な"],["全滅","ぜんめつ"],["について"],["／"],["聞いて","きいて"],["いる"],["の"],["だ"],["。"]]},{"verse":23,"text":"あなたがたは、私の声に耳を傾けて聞け。／私の言うことを、注意して聞け。","tok":[["あなた"],["がた"],["は"],["、"],["私","わたくし"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["聞け","きけ"],["。"],["／"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["、"],["注意","ちゅうい"],["して"],["聞け","きけ"],["。"]]},{"verse":24,"text":"農夫は、種を蒔くために、いつも耕して、その土地を起こし、まぐわでならしてばかりいるだろうか。","tok":[["農夫","のうふ"],["は"],["、"],["種","しゅ"],["を"],["蒔く","まく"],["ため"],["に"],["、"],["いつも"],["耕して","たがやして"],["、"],["その"],["土地","とち"],["を"],["起こし","おこし"],["、"],["まぐわ"],["で"],["ならして"],["ばかり"],["いるだろう"],["か"],["。"]]},{"verse":25,"text":"その地面をならしたら、ういきょうを蒔き、クミンの種を蒔き、小麦をうねに、大麦を定まった場所に、裸麦をその境に植えるではないか。","tok":[["その"],["地面","じめん"],["を"],["ならしたら"],["、"],["ういきょう"],["を"],["蒔き","まき"],["、"],["クミン"],["の"],["種","たね"],["を"],["蒔き","まき"],["、"],["小麦","こむぎ"],["を"],["うね"],["に"],["、"],["大麦","おおむぎ"],["を"],["定まった","さだまった"],["場所","ばしょ"],["に"],["、"],["裸麦","はだかむぎ"],["を"],["その"],["境","さかい"],["に"],["植えるで","うえるで"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"農夫を指図する神は、彼に正しく教えておられる。","tok":[["農夫","のうふ"],["を"],["指図","さしず"],["する"],["神","かみ"],["は"],["、"],["彼","かれ"],["に"],["正しく","ただしく"],["教えて","おしえて"],["おられる"],["。"]]},{"verse":27,"text":"ういきょうは打穀機で打たれず、クミンの上では脱穀車の車輪を回さない。／ういきょうは杖で、クミンは棒で打たれるからである。","tok":[["ういきょう"],["は"],["打","だ"],["穀","こく"],["機","き"],["で"],["打たれず","うたれず"],["、"],["クミン"],["の"],["上","うえ"],["で"],["は"],["脱穀車","だっこくしゃ"],["の"],["車輪","しゃりん"],["を"],["回さない","まわさない"],["。"],["／"],["ういきょう"],["は"],["杖","つえ"],["で"],["、"],["クミン"],["は"],["棒","ぼう"],["で"],["打たれる","うたれる"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"パンのための麦は砕かれない。／打穀をいつまでも続けることがないからだ。／脱穀車の車輪を回しても、馬がこれを砕きはしない。","tok":[["パン"],["の"],["ため"],["の"],["麦","むぎ"],["は"],["砕かれない","くだかれない"],["。"],["／"],["打","だ"],["穀","こく"],["を"],["いつ"],["まで"],["も"],["続ける","つづける"],["こと"],["が"],["ない"],["から"],["だ"],["。"],["／"],["脱穀車","だっこくしゃ"],["の"],["車輪","しゃりん"],["を"],["回して","まわして"],["も"],["、"],["馬","うま"],["が"],["これ"],["を"],["砕き","くだき"],["は"],["しない"],["。"]]},{"verse":29,"text":"これもまた、万軍の主のもとから出ることで、そのはかりごとは奇しく、そのおもんぱかりはすばらしい。","tok":[["これ"],["も"],["また"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["もと"],["から"],["出る","でる"],["こと"],["で"],["、"],["その"],["はかりごと"],["は"],["奇しく","くすしく"],["、"],["その"],["おもんぱかり"],["は"],["すばらしい"],["。"]]}]
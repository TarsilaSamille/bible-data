[{"verse":1,"text":"ああ、あなたが天を裂いて降りて来られると、山々は御前で揺れ動くでしょう。","tok":[["ああ"],["、"],["あなた"],["が"],["天","てん"],["を"],["裂いて","さいて"],["降りて","おりて"],["来られる","こられる"],["と"],["、"],["山々","やまやま"],["は"],["御前","ごぜん"],["で"],["揺れ動くでしょう","ゆれうごくでしょう"],["。"]]},{"verse":2,"text":"火が柴に燃えつき、火が水を沸き立たせるように、あなたの御名はあなたの敵に知られ、国々は御前で震えるでしょう。","tok":[["火","ひ"],["が"],["柴","しば"],["に"],["燃えつき","もえつき"],["、"],["火","ひ"],["が"],["水","みず"],["を"],["沸き立たせる","わきたたせる"],["よう"],["に"],["、"],["あなた"],["の"],["御名","ぎょめい"],["は"],["あなた"],["の"],["敵","てき"],["に"],["知られ","しられ"],["、"],["国々","くにぐに"],["は"],["御前","ごぜん"],["で"],["震えるでしょう","ふるえるでしょう"],["。"]]},{"verse":3,"text":"私たちが予想もしなかった恐ろしい事を／あなたが行われるとき、あなたが降りて来られると、山々は御前で揺れ動くでしょう。","tok":[["私たち","わたしたち"],["が"],["予想","よそう"],["も"],["しなかった"],["恐ろしい","おそろしい"],["事","こと"],["を"],["／"],["あなた"],["が"],["行われる","おこなわれる"],["とき"],["、"],["あなた"],["が"],["降りて","おりて"],["来られる","こられる"],["と"],["、"],["山々","やまやま"],["は"],["御前","ごぜん"],["で"],["揺れ動くでしょう","ゆれうごくでしょう"],["。"]]},{"verse":4,"text":"神を待ち望む者のために、このようにしてくださる神は、あなた以外にとこしえから聞いたこともなく、耳にしたこともなく、目で見たこともありません。","tok":[["神","かみ"],["を"],["待ち望む","まちのぞむ"],["者","もの"],["の"],["ため"],["に"],["、"],["この"],["よう"],["に"],["して"],["くださる"],["神","かみ"],["は"],["、"],["あなた"],["以外","いがい"],["に"],["とこしえ"],["から"],["聞いた","きいた"],["こと"],["も"],["なく"],["、"],["耳","みみ"],["に"],["した"],["こと"],["も"],["なく"],["、"],["目","め"],["で"],["見た","みた"],["こと"],["も"],["ありません"],["。"]]},{"verse":5,"text":"あなたは迎えてくださいます。／喜んで正義を行う者、あなたの道を歩み、あなたを忘れない者を。／ああ、あなたは怒られました。／私たちは昔から罪を犯し続けています。／それでも私たちは救われるでしょうか。","tok":[["あなた"],["は"],["迎えて","むかえて"],["くださいます"],["。"],["／"],["喜んで","よろこんで"],["正義","せいぎ"],["を"],["行う","おこなう"],["者","もの"],["、"],["あなた"],["の"],["道","みち"],["を"],["歩み","あゆみ"],["、"],["あなた"],["を"],["忘れない","わすれない"],["者","もの"],["を"],["。"],["／"],["ああ"],["、"],["あなた"],["は"],["怒られました","おこられました"],["。"],["／"],["私たち","わたしたち"],["は"],["昔","むかし"],["から"],["罪","つみ"],["を"],["犯し","おかし"],["続けて","つづけて"],["います"],["。"],["／"],["それ"],["で"],["も"],["私たち","わたしたち"],["は"],["救われるでしょう","すくわれるでしょう"],["か"],["。"]]},{"verse":6,"text":"私たちはみな、汚れた者のようになり、私たちの義はみな、不潔な着物のようです。／私たちはみな、木の葉のように枯れ、私たちの咎は風のように私たちを吹き上げます。","tok":[["私たち","わたしたち"],["は"],["みな"],["、"],["汚れた","よごれた"],["者","もの"],["の"],["よう"],["に"],["なり"],["、"],["私たち","わたしたち"],["の"],["義","ぎ"],["は"],["みな"],["、"],["不潔","ふけつ"],["な"],["着物","きもの"],["の"],["よう"],["です"],["。"],["／"],["私たち","わたしたち"],["は"],["みな"],["、"],["木の葉","このは"],["の"],["よう"],["に"],["枯れ","かれ"],["、"],["私たち","わたしたち"],["の"],["咎","とが"],["は"],["風","かぜ"],["の"],["よう"],["に"],["私たち","わたしたち"],["を"],["吹き上げます","ふきあげます"],["。"]]},{"verse":7,"text":"しかし、あなたの御名を呼ぶ者もなく、奮い立って、あなたにすがる者もいません。／あなたは私たちから御顔を隠し、私たちの咎のゆえに、私たちを弱められました。","tok":[["しかし"],["、"],["あなた"],["の"],["御名","ぎょめい"],["を"],["呼ぶ","よぶ"],["者","もの"],["も"],["なく"],["、"],["奮い立って","ふるいたって"],["、"],["あなた"],["に"],["すがる"],["者","もの"],["も"],["いません"],["。"],["／"],["あなた"],["は"],["私たち","わたしたち"],["から"],["御顔","おかお"],["を"],["隠し","かくし"],["、"],["私たち","わたしたち"],["の"],["咎","とが"],["の"],["ゆえ"],["に"],["、"],["私たち","わたしたち"],["を"],["弱められました","よわめられました"],["。"]]},{"verse":8,"text":"しかし、主よ。／今、あなたは私たちの父です。／私たちは粘土で、あなたは私たちの陶器師です。／私たちはみな、あなたの手で造られたものです。","tok":[["しかし"],["、"],["主","ぬし"],["よ"],["。"],["／"],["今","いま"],["、"],["あなた"],["は"],["私たち","わたしたち"],["の"],["父","ちち"],["です"],["。"],["／"],["私たち","わたしたち"],["は"],["粘土","ねんど"],["で"],["、"],["あなた"],["は"],["私たち","わたしたち"],["の"],["陶器師","とうきし"],["です"],["。"],["／"],["私たち","わたしたち"],["は"],["みな"],["、"],["あなた"],["の"],["手","て"],["で"],["造られた","つくられた"],["もの"],["です"],["。"]]},{"verse":9,"text":"主よ。どうかひどく怒らないでください。／いつまでも、咎を覚えないでください。／どうか今、私たちがみな、あなたの民であることに／目を留めてください。","tok":[["主","ぬし"],["よ"],["。"],["どう"],["か"],["ひどく"],["怒らないで","おこらないで"],["ください"],["。"],["／"],["いつ"],["まで"],["も"],["、"],["咎","とが"],["を"],["覚えないで","おぼえないで"],["ください"],["。"],["／"],["どう"],["か"],["今","いま"],["、"],["私たち","わたしたち"],["が"],["みな"],["、"],["あなた"],["の"],["民","たみ"],["で"],["ある"],["こと"],["に"],["／"],["目","め"],["を"],["留めて","とめて"],["ください"],["。"]]},{"verse":10,"text":"あなたの聖なる町々は荒野となっています。／シオンは荒野となり、エルサレムは荒れ果てています。","tok":[["あなた"],["の"],["聖","せい"],["なる"],["町々","まちまち"],["は"],["荒野","こうや"],["と"],["なって"],["います"],["。"],["／"],["シオン"],["は"],["荒野","こうや"],["と"],["なり"],["、"],["エルサレム"],["は"],["荒れ果てて","あれはてて"],["います"],["。"]]},{"verse":11,"text":"私たちの先祖があなたをほめたたえた／私たちの聖なる美しい宮は、火で焼かれ、私たちの宝とした物すべてが荒廃しました。","tok":[["私たち","わたしたち"],["の"],["先祖","せんぞ"],["が"],["あなた"],["を"],["ほめたたえた"],["／"],["私たち","わたしたち"],["の"],["聖","せい"],["なる"],["美しい","うつくしい"],["宮","みや"],["は"],["、"],["火","ひ"],["で"],["焼かれ","やかれ"],["、"],["私たち","わたしたち"],["の"],["宝","たから"],["と"],["した"],["物","もの"],["すべて"],["が"],["荒廃","こうはい"],["しました"],["。"]]},{"verse":12,"text":"主よ。これでも、あなたはじっとこらえ、黙って、私たちをこんなにも悩まされるのですか。","tok":[["主","ぬし"],["よ"],["。"],["これ"],["で"],["も"],["、"],["あなた"],["は"],["じっと"],["こらえ"],["、"],["黙って","だまって"],["、"],["私たち","わたしたち"],["を"],["こんな"],["に"],["も"],["悩まされる","なやまされる"],["の"],["です"],["か"],["。"]]}]
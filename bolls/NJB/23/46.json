[{"verse":1,"text":"「ベルはひざまずき、ネボはかがむ。／彼らの偶像は獣と家畜に載せられ、あなたがたの運ぶものは荷物となり、疲れた獣の重荷となる。","tok":[["「"],["ベル"],["は"],["ひざまずき"],["、"],["ネボ"],["は"],["かがむ"],["。"],["／"],["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["は"],["獣","けもの"],["と"],["家畜","かちく"],["に"],["載せられ","のせられ"],["、"],["あなた"],["がた"],["の"],["運ぶ","はこぶ"],["もの"],["は"],["荷物","にもつ"],["と"],["なり"],["、"],["疲れた","つかれた"],["獣","けもの"],["の"],["重荷","おもに"],["と"],["なる"],["。"]]},{"verse":2,"text":"彼らは共にかがみ、ひざまずく。／彼らは重荷を解くこともできず、彼ら自身もとりことなって行く。","tok":[["彼","かれ"],["ら"],["は"],["共","とも"],["に"],["かがみ"],["、"],["ひざまずく"],["。"],["／"],["彼","かれ"],["ら"],["は"],["重荷","おもに"],["を"],["解く","とく"],["こと"],["も"],["できず"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["も"],["とりこ"],["と"],["なって"],["行く","いく"],["。"]]},{"verse":3,"text":"わたしに聞け、ヤコブの家と、イスラエルの家の／すべての残りの者よ。／胎内にいる時からになわれており、生まれる前から運ばれた者よ。","tok":[["わたし"],["に"],["聞け","きけ"],["、"],["ヤコブ"],["の"],["家","いえ"],["と"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["／"],["すべて"],["の"],["残り","のこり"],["の"],["者","もの"],["よ"],["。"],["／"],["胎内","たいない"],["に"],["いる"],["時","とき"],["から"],["になわれて"],["おり"],["、"],["生まれる","うまれる"],["前","まえ"],["から"],["運ばれた","はこばれた"],["者","もの"],["よ"],["。"]]},{"verse":4,"text":"あなたがたが年をとっても、わたしは同じようにする。／あなたがたがしらがになっても、わたしは背負う。／わたしはそうしてきたのだ。／なお、わたしは運ぼう。／わたしは背負って、救い出そう。","tok":[["あなた"],["がた"],["が"],["年","とし"],["を"],["とって"],["も"],["、"],["わたし"],["は"],["同じ","おなじ"],["よう"],["に"],["する"],["。"],["／"],["あなた"],["がた"],["が"],["しらが"],["に"],["なって"],["も"],["、"],["わたし"],["は"],["背負う","せおう"],["。"],["／"],["わたし"],["は"],["そう"],["して"],["きた"],["の"],["だ"],["。"],["／"],["なお"],["、"],["わたし"],["は"],["運ぼう","はこぼう"],["。"],["／"],["わたし"],["は"],["背負って","せおって"],["、"],["救い出そう","すくいだそう"],["。"]]},{"verse":5,"text":"わたしをだれになぞらえて比べ、わたしをだれと並べて、なぞらえるのか。","tok":[["わたし"],["を"],["だれ"],["に"],["なぞらえて"],["比べ","くらべ"],["、"],["わたし"],["を"],["だれ"],["と"],["並べて","ならべて"],["、"],["なぞらえる"],["の"],["か"],["。"]]},{"verse":6,"text":"袋から金を惜しげなく出し、銀をてんびんで量る者たちは、金細工人を雇って、それで神を造り、これにひざまずいて、すぐ拝む。","tok":[["袋","ふくろ"],["から"],["金","かね"],["を"],["惜し","おし"],["げ"],["なく"],["出し","だし"],["、"],["銀","ぎん"],["を"],["てんびん"],["で"],["量る","はかる"],["者","もの"],["たち"],["は"],["、"],["金","きん"],["細工人","さいくにん"],["を"],["雇って","やとって"],["、"],["それ"],["で"],["神","かみ"],["を"],["造り","つくり"],["、"],["これ"],["に"],["ひざまずいて"],["、"],["すぐ"],["拝む","おがむ"],["。"]]},{"verse":7,"text":"彼らはこれを肩にかついで運び、下に置いて立たせる。／これはその場からもう動けない。／これに叫んでも答えず、悩みから救ってもくれない。","tok":[["彼","かれ"],["ら"],["は"],["これ"],["を"],["肩","かた"],["に"],["かついで"],["運び","はこび"],["、"],["下","した"],["に"],["置いて","おいて"],["立たせる","たたせる"],["。"],["／"],["これ"],["は"],["その"],["場","ば"],["から"],["もう"],["動けない","うごけない"],["。"],["／"],["これ"],["に"],["叫んで","さけんで"],["も"],["答えず","こたえず"],["、"],["悩み","なやみ"],["から"],["救って","すくって"],["も"],["くれない"],["。"]]},{"verse":8,"text":"このことを思い出し、しっかりせよ。／そむく者らよ。心に思い返せ。","tok":[["この"],["こと"],["を"],["思い出し","おもいだし"],["、"],["しっかり"],["せよ"],["。"],["／"],["そむく"],["者","もの"],["ら"],["よ"],["。"],["心","こころ"],["に"],["思い返せ","おもいかえせ"],["。"]]},{"verse":9,"text":"遠い大昔の事を思い出せ。／わたしが神である。ほかにはいない。／わたしのような神はいない。","tok":[["遠い","とおい"],["大昔","おおむかし"],["の"],["事","こと"],["を"],["思い出せ","おもいだせ"],["。"],["／"],["わたし"],["が"],["神","かみ"],["で"],["ある"],["。"],["ほか"],["に"],["は"],["いない"],["。"],["／"],["わたし"],["の"],["よう"],["な"],["神","かみ"],["は"],["いない"],["。"]]},{"verse":10,"text":"わたしは、終わりの事を初めから告げ、まだなされていない事を昔から告げ、『わたしのはかりごとは成就し、わたしの望む事をすべて成し遂げる』と言う。","tok":[["わたし"],["は"],["、"],["終わり","おわり"],["の"],["事","こと"],["を"],["初め","はじめ"],["から"],["告げ","つげ"],["、"],["まだ"],["なされて"],["いない"],["事","こと"],["を"],["昔","むかし"],["から"],["告げ","つげ"],["、"],["『"],["わたし"],["の"],["はかりごと"],["は"],["成就","じょうじゅ"],["し"],["、"],["わたし"],["の"],["望む","のぞむ"],["事","こと"],["を"],["すべて"],["成し遂げる","なしとげる"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":11,"text":"わたしは、東から猛禽を、遠い地から、わたしのはかりごとを行う者を呼ぶ。／わたしが語ると、すぐそれを行い、わたしが計ると、すぐそれをする。","tok":[["わたし"],["は"],["、"],["東","ひがし"],["から"],["猛禽","もうきん"],["を"],["、"],["遠い","とおい"],["地","ち"],["から"],["、"],["わたし"],["の"],["はかりごと"],["を"],["行う","おこなう"],["者","もの"],["を"],["呼ぶ","よぶ"],["。"],["／"],["わたし"],["が"],["語る","かたる"],["と"],["、"],["すぐ"],["それ"],["を"],["行い","おこない"],["、"],["わたし"],["が"],["計る","はかる"],["と"],["、"],["すぐ"],["それ"],["を"],["する"],["。"]]},{"verse":12,"text":"わたしに聞け。／強情な者、正義から遠ざかっている者たちよ。","tok":[["わたし"],["に"],["聞け","きけ"],["。"],["／"],["強情","ごうじょう"],["な"],["者","もの"],["、"],["正義","まさよし"],["から"],["遠ざかって","とおざかって"],["いる"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":13,"text":"わたしは、わたしの勝利を近づける。／それは遠くはない。／わたしの救いは遅れることがない。／わたしはシオンに救いを与え、イスラエルにわたしの光栄を与える。」","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["勝利","しょうり"],["を"],["近づける","ちかづける"],["。"],["／"],["それ"],["は"],["遠く","とおく"],["は"],["ない"],["。"],["／"],["わたし"],["の"],["救い","すくい"],["は"],["遅れる","おくれる"],["こと"],["が"],["ない"],["。"],["／"],["わたし"],["は"],["シオン"],["に"],["救い","すくい"],["を"],["与え","あたえ"],["、"],["イスラエル"],["に"],["わたし"],["の"],["光栄","こうえい"],["を"],["与える","あたえる"],["。"],["」"]]}]
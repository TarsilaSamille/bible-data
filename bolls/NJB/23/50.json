[{"verse":1,"text":"主はこう仰せられる。／「あなたがたの母親の離婚状は、どこにあるか。／わたしが彼女を追い出したというのなら。／あるいは、その債権者はだれなのか。／わたしがあなたがたを売ったというのなら。／見よ。あなたがたは、自分の咎のために売られ、あなたがたのそむきの罪のために、あなたがたの母親は追い出されたのだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["あなた"],["がた"],["の"],["母親","ははおや"],["の"],["離婚状","りこんじょう"],["は"],["、"],["どこ"],["に"],["ある"],["か"],["。"],["／"],["わたし"],["が"],["彼女","かのじょ"],["を"],["追い出した","おいだした"],["と"],["いう"],["の"],["なら"],["。"],["／"],["あるいは"],["、"],["その"],["債権者","さいけんしゃ"],["は"],["だれ"],["な"],["の"],["か"],["。"],["／"],["わたし"],["が"],["あなた"],["がた"],["を"],["売った","うった"],["と"],["いう"],["の"],["なら"],["。"],["／"],["見","み"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["の"],["咎","とが"],["の"],["ため"],["に"],["売られ","うられ"],["、"],["あなた"],["がた"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["母親","ははおや"],["は"],["追い出された","おいだされた"],["の"],["だ"],["。"]]},{"verse":2,"text":"なぜ、わたしが来たとき、だれもおらず、わたしが呼んだのに、だれも答えなかったのか。／わたしの手が短くて贖うことができないのか。／わたしには救い出す力がないと言うのか。／見よ。わたしは、しかって海を干上がらせ、多くの川を荒野とする。／その魚は水がなくて臭くなり、渇きのために死に絶える。","tok":[["なぜ"],["、"],["わたし"],["が"],["来た","きた"],["とき"],["、"],["だれ"],["も"],["おらず"],["、"],["わたし"],["が"],["呼んだ","よんだ"],["のに"],["、"],["だれ"],["も"],["答えなかった","こたえなかった"],["の"],["か"],["。"],["／"],["わたし"],["の"],["手","て"],["が"],["短くて","みじかくて"],["贖う","あがなう"],["こと"],["が"],["できない"],["の"],["か"],["。"],["／"],["わたし"],["に"],["は"],["救い出す","すくいだす"],["力","ちから"],["が"],["ない"],["と"],["言う","いう"],["の"],["か"],["。"],["／"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["しかって"],["海","うみ"],["を"],["干上がらせ","ひあがらせ"],["、"],["多く","おおく"],["の"],["川","かわ"],["を"],["荒野","あらの"],["と"],["する"],["。"],["／"],["その"],["魚","さかな"],["は"],["水","みず"],["が"],["なくて"],["臭く","くさく"],["なり"],["、"],["渇き","かわき"],["の"],["ため"],["に"],["死に絶える","しにたえる"],["。"]]},{"verse":3,"text":"わたしは天をやみでおおい、荒布をそのおおいとする。」","tok":[["わたし"],["は"],["天","てん"],["を"],["やみ"],["で"],["おおい"],["、"],["荒布","あらめ"],["を"],["その"],["おおい"],["と"],["する"],["。"],["」"]]},{"verse":4,"text":"神である主は、私に弟子の舌を与え、疲れた者をことばで励ますことを教え、朝ごとに、私を呼びさまし、私の耳を開かせて、私が弟子のように聞くようにされる。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["私","わたくし"],["に"],["弟子","でし"],["の"],["舌","した"],["を"],["与え","あたえ"],["、"],["疲れた","つかれた"],["者","もの"],["を"],["ことば"],["で"],["励ます","はげます"],["こと"],["を"],["教え","おしえ"],["、"],["朝","あさ"],["ごと"],["に"],["、"],["私","わたくし"],["を"],["呼びさまし","よびさまし"],["、"],["私","わたくし"],["の"],["耳","みみ"],["を"],["開かせて","ひらかせて"],["、"],["私","わたくし"],["が"],["弟子","でし"],["の"],["よう"],["に"],["聞く","きく"],["よう"],["に"],["される"],["。"]]},{"verse":5,"text":"神である主は、私の耳を開かれた。／私は逆らわず、うしろに退きもせず、","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["耳","みみ"],["を"],["開かれた","ひらかれた"],["。"],["／"],["私","わたくし"],["は"],["逆らわず","さからわず"],["、"],["うしろ"],["に"],["退き","しりぞき"],["も"],["せず"],["、"]]},{"verse":6,"text":"打つ者に私の背中をまかせ、ひげを抜く者に私の頬をまかせ、侮辱されても、つばきをかけられても、私の顔を隠さなかった。","tok":[["打つ","うつ"],["者","もの"],["に"],["私","わたくし"],["の"],["背中","せなか"],["を"],["まかせ"],["、"],["ひげ"],["を"],["抜く","ぬく"],["者","もの"],["に"],["私","わたくし"],["の"],["頬","ほお"],["を"],["まかせ"],["、"],["侮辱","ぶじょく"],["されて"],["も"],["、"],["つばき"],["を"],["かけられて"],["も"],["、"],["私","わたくし"],["の"],["顔","かお"],["を"],["隠さなかった","かくさなかった"],["。"]]},{"verse":7,"text":"しかし、神である主は、私を助ける。／それゆえ、私は、侮辱されなかった。／それゆえ、私は顔を火打石のようにし、恥を見てはならないと知った。","tok":[["しかし"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["私","わたくし"],["を"],["助ける","たすける"],["。"],["／"],["それ"],["ゆえ"],["、"],["私","わたくし"],["は"],["、"],["侮辱","ぶじょく"],["されなかった"],["。"],["／"],["それ"],["ゆえ"],["、"],["私","わたくし"],["は"],["顔","かお"],["を"],["火打石","ひうちいし"],["の"],["よう"],["に"],["し"],["、"],["恥","はじ"],["を"],["見て","みて"],["は"],["ならない"],["と"],["知った","しった"],["。"]]},{"verse":8,"text":"私を義とする方が近くにおられる。／だれが私と争うのか。／さあ、さばきの座に共に立とう。／どんな者が、私を訴えるのか。／私のところに出て来い。","tok":[["私","わたくし"],["を"],["義","ぎ"],["と"],["する"],["方","ほう"],["が"],["近く","ちかく"],["に"],["おられる"],["。"],["／"],["だれ"],["が"],["私","わたくし"],["と"],["争う","あらそう"],["の"],["か"],["。"],["／"],["さあ"],["、"],["さばき"],["の"],["座","ざ"],["に"],["共","とも"],["に"],["立とう","たとう"],["。"],["／"],["どんな"],["者","もの"],["が"],["、"],["私","わたくし"],["を"],["訴える","うったえる"],["の"],["か"],["。"],["／"],["私","わたくし"],["の"],["ところ"],["に"],["出て","でて"],["来い","こい"],["。"]]},{"verse":9,"text":"見よ。神である主が、私を助ける。／だれが私を罪に定めるのか。／見よ。彼らはみな、衣のように古び、しみが彼らを食い尽くす。","tok":[["見","み"],["よ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["、"],["私","わたくし"],["を"],["助ける","たすける"],["。"],["／"],["だれ"],["が"],["私","わたくし"],["を"],["罪","つみ"],["に"],["定める","さだめる"],["の"],["か"],["。"],["／"],["見","み"],["よ"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["衣","ころも"],["の"],["よう"],["に"],["古び","ふるび"],["、"],["しみ"],["が"],["彼","かれ"],["ら"],["を"],["食い","くい"],["尽くす","つくす"],["。"]]},{"verse":10,"text":"あなたがたのうち、だれが主を恐れ、そのしもべの声に聞き従うのか。／暗やみの中を歩き、光を持たない者は、主の御名に信頼し、自分の神に拠り頼め。","tok":[["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["が"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["その"],["しもべ"],["の"],["声","こえ"],["に"],["聞き従う","ききしたがう"],["の"],["か"],["。"],["／"],["暗やみ","くらやみ"],["の"],["中","なか"],["を"],["歩き","あるき"],["、"],["光","ひかり"],["を"],["持たない","もたない"],["者","もの"],["は"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["に"],["信頼","しんらい"],["し"],["、"],["自分","じぶん"],["の"],["神","かみ"],["に"],["拠り","より"],["頼め","たのめ"],["。"]]},{"verse":11,"text":"見よ。あなたがたはみな、火をともし、燃えさしを身に帯びている。／あなたがたは自分たちの火のあかりを持ち、火をつけた燃えさしを持って歩くがよい。／このことはわたしの手によって／あなたがたに起こり、あなたがたは、苦しみのうちに伏し倒れる。","tok":[["見","み"],["よ"],["。"],["あなた"],["がた"],["は"],["みな"],["、"],["火","ひ"],["を"],["ともし"],["、"],["燃えさし","もえさし"],["を"],["身","み"],["に"],["帯びて","おびて"],["いる"],["。"],["／"],["あなた"],["がた"],["は"],["自分","じぶん"],["たち"],["の"],["火","ひ"],["の"],["あかり"],["を"],["持ち","もち"],["、"],["火","ひ"],["を"],["つけた"],["燃えさし","もえさし"],["を"],["持って","もって"],["歩く","あるく"],["が"],["よい"],["。"],["／"],["この"],["こと"],["は"],["わたし"],["の"],["手","て"],["によって"],["／"],["あなた"],["がた"],["に"],["起こり","おこり"],["、"],["あなた"],["がた"],["は"],["、"],["苦しみ","くるしみ"],["の"],["うち"],["に"],["伏し","ふし"],["倒れる","たおれる"],["。"]]}]
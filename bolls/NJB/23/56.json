[{"verse":1,"text":"主はこう仰せられる。「公正を守り、正義を行え。わたしの救いが来るのは近く、わたしの義が現れるのも近いからだ。」","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["公正","こうせい"],["を"],["守り","まもり"],["、"],["正義","せいぎ"],["を"],["行え","おこなえ"],["。"],["わたし"],["の"],["救い","すくい"],["が"],["来る","くる"],["の"],["は"],["近く","ちかく"],["、"],["わたし"],["の"],["義","ぎ"],["が"],["現れる","あらわれる"],["の"],["も"],["近い","ちかい"],["から"],["だ"],["。"],["」"]]},{"verse":2,"text":"幸いなことよ。／安息日を守ってこれを汚さず、どんな悪事にもその手を出さない、このように行う人、これを堅く保つ人の子は。","tok":[["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["／"],["安息日","あんそくび"],["を"],["守って","まもって"],["これ"],["を"],["汚さず","よごさず"],["、"],["どんな"],["悪事","あくじ"],["に"],["も"],["その"],["手","て"],["を"],["出さない","ださない"],["、"],["この"],["よう"],["に"],["行う","おこなう"],["人","ひと"],["、"],["これ"],["を"],["堅く","かたく"],["保つ","たもつ"],["人","ひと"],["の"],["子","こ"],["は"],["。"]]},{"verse":3,"text":"主に連なる外国人は言ってはならない。／「主はきっと、私をその民から切り離される」と。／宦官も言ってはならない。／「ああ、私は枯れ木だ」と。","tok":[["主に","おもに"],["連なる","つらなる"],["外国人","がいこくじん"],["は"],["言って","いって"],["は"],["ならない"],["。"],["／"],["「"],["主","ぬし"],["は"],["きっと"],["、"],["私","わたくし"],["を"],["その"],["民","たみ"],["から"],["切り離される","きりはなされる"],["」"],["と"],["。"],["／"],["宦官","かんがん"],["も"],["言って","いって"],["は"],["ならない"],["。"],["／"],["「"],["ああ"],["、"],["私","わたくし"],["は"],["枯れ木","かれき"],["だ"],["」"],["と"],["。"]]},{"verse":4,"text":"まことに主はこう仰せられる。／「わたしの安息日を守り、わたしの喜ぶ事を選び、わたしの契約を堅く保つ宦官たちには、","tok":[["まこと"],["に"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["わたし"],["の"],["安息日","あんそくび"],["を"],["守り","まもり"],["、"],["わたし"],["の"],["喜ぶ","よろこぶ"],["事","こと"],["を"],["選び","えらび"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["堅く","かたく"],["保つ","たもつ"],["宦官","かんがん"],["たち"],["に"],["は"],["、"]]},{"verse":5,"text":"わたしの家、わたしの城壁のうちで、息子、娘たちにもまさる分け前と名を与え、絶えることのない永遠の名を与える。","tok":[["わたし"],["の"],["家","いえ"],["、"],["わたし"],["の"],["城壁","じょうへき"],["の"],["うち"],["で"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["に"],["も"],["まさる"],["分け前","わけまえ"],["と"],["名","な"],["を"],["与え","あたえ"],["、"],["絶える","たえる"],["こと"],["の"],["ない"],["永遠","えいえん"],["の"],["名","な"],["を"],["与える","あたえる"],["。"]]},{"verse":6,"text":"また、主に連なって主に仕え、主の名を愛して、そのしもべとなった外国人がみな、安息日を守ってこれを汚さず、わたしの契約を堅く保つなら、","tok":[["また"],["、"],["主に","おもに"],["連なって","つらなって"],["主に","おもに"],["仕え","つかえ"],["、"],["主","ぬし"],["の"],["名","な"],["を"],["愛して","あいして"],["、"],["その"],["しもべ"],["と"],["なった"],["外国人","がいこくじん"],["が"],["みな"],["、"],["安息日","あんそくび"],["を"],["守って","まもって"],["これ"],["を"],["汚さず","よごさず"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["堅く","かたく"],["保つなら","たもつなら"],["、"]]},{"verse":7,"text":"わたしは彼らを、わたしの聖なる山に連れて行き、わたしの祈りの家で彼らを楽しませる。彼らの全焼のいけにえやその他のいけにえは、わたしの祭壇の上で受け入れられる。わたしの家は、すべての民の祈りの家と呼ばれるからだ。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["に"],["連れて","つれて"],["行き","いき"],["、"],["わたし"],["の"],["祈り","いのり"],["の"],["家","いえ"],["で"],["彼","かれ"],["ら"],["を"],["楽しませる","たのしませる"],["。"],["彼","かれ"],["ら"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["や"],["その"],["他","た"],["の"],["いけにえ"],["は"],["、"],["わたし"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["受け入れられる","うけいれられる"],["。"],["わたし"],["の"],["家","いえ"],["は"],["、"],["すべて"],["の"],["民","たみ"],["の"],["祈り","いのり"],["の"],["家","いえ"],["と"],["呼ばれる","よばれる"],["から"],["だ"],["。"]]},{"verse":8,"text":"――イスラエルの散らされた者たちを集める神である主の御告げ――わたしは、すでに集められた者たちに、さらに集めて加えよう。」","tok":[["―"],["―"],["イスラエル"],["の"],["散らされた","ちらされた"],["者","もの"],["たち"],["を"],["集める","あつめる"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["は"],["、"],["すでに"],["集められた","あつめられた"],["者","もの"],["たち"],["に"],["、"],["さらに"],["集めて","あつめて"],["加えよう","くわえよう"],["。"],["」"]]},{"verse":9,"text":"野のすべての獣、林の中のすべての獣よ。／食べに来い。","tok":[["野","の"],["の"],["すべて"],["の"],["獣","けもの"],["、"],["林","はやし"],["の"],["中","なか"],["の"],["すべて"],["の"],["獣","けもの"],["よ"],["。"],["／"],["食べ","たべ"],["に"],["来い","こい"],["。"]]},{"verse":10,"text":"見張り人はみな目が見えず、知ることがない。／彼らはみな口のきけない犬、ほえることもできない。／あえいで、横になり、眠りをむさぼる。","tok":[["見張り","みはり"],["人","ひと"],["は"],["みな目","みなめ"],["が"],["見えず","みえず"],["、"],["知る","しる"],["こと"],["が"],["ない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["口","くち"],["の"],["きけない"],["犬","いぬ"],["、"],["ほえる"],["こと"],["も"],["できない"],["。"],["／"],["あえいで"],["、"],["横","よこ"],["に"],["なり"],["、"],["眠り","ねむり"],["を"],["むさぼる"],["。"]]},{"verse":11,"text":"この貪欲な犬どもは、足ることを知らない。／彼らは、悟ることも知らない牧者で、みな、自分かってな道に向かい、ひとり残らず自分の利得に向かって行く。","tok":[["この"],["貪欲","どんよく"],["な"],["犬","いぬ"],["ども"],["は"],["、"],["足る","たる"],["こと"],["を"],["知らない","しらない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["悟る","さとる"],["こと"],["も"],["知らない","しらない"],["牧者","ぼくしゃ"],["で"],["、"],["みな"],["、"],["自","じ"],["分かって","わかって"],["な"],["道","みち"],["に"],["向かい","むかい"],["、"],["ひとり"],["残らず","のこらず"],["自分","じぶん"],["の"],["利得","りとく"],["に"],["向かって","むかって"],["行く","いく"],["。"]]},{"verse":12,"text":"「やって来い。ぶどう酒を持って来るから、強い酒を浴びるほど飲もう。／あすもきょうと同じだろう。／もっと、すばらしいかもしれない。」","tok":[["「"],["やって"],["来い","こい"],["。"],["ぶどう酒","ぶどうしゅ"],["を"],["持って","もって"],["来る","くる"],["から"],["、"],["強い","つよい"],["酒","さけ"],["を"],["浴びる","あびる"],["ほど"],["飲もう","のもう"],["。"],["／"],["あす"],["も"],["きょう"],["と"],["同じ","おなじ"],["だろう"],["。"],["／"],["もっと"],["、"],["すばらしい"],["か"],["も"],["しれない"],["。"],["」"]]}]
[{"verse":1,"text":"シオンのために、わたしは黙っていない。／エルサレムのために、黙りこまない。／その義が朝日のように光を放ち、その救いが、たいまつのように燃えるまでは。","tok":[["シオン"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["黙って","だまって"],["いない"],["。"],["／"],["エルサレム"],["の"],["ため"],["に"],["、"],["黙りこまない","だまりこまない"],["。"],["／"],["その"],["義","ぎ"],["が"],["朝日","あさひ"],["の"],["よう"],["に"],["光","ひかり"],["を"],["放ち","はなち"],["、"],["その"],["救い","すくい"],["が"],["、"],["たいまつ"],["の"],["よう"],["に"],["燃える","もえる"],["まで"],["は"],["。"]]},{"verse":2,"text":"そのとき、国々はあなたの義を見、すべての王があなたの栄光を見る。／あなたは、主の口が名づける新しい名で呼ばれよう。","tok":[["その"],["とき"],["、"],["国々","くにぐに"],["は"],["あなた"],["の"],["義","ぎ"],["を"],["見","み"],["、"],["すべて"],["の"],["王","おう"],["が"],["あなた"],["の"],["栄光","えいこう"],["を"],["見る","みる"],["。"],["／"],["あなた"],["は"],["、"],["主","ぬし"],["の"],["口","くち"],["が"],["名づける","なづける"],["新しい","あたらしい"],["名","な"],["で"],["呼ばれよう","よばれよう"],["。"]]},{"verse":3,"text":"あなたは主の手にある輝かしい冠となり、あなたの神の手のひらにある／王のかぶり物となる。","tok":[["あなた"],["は"],["主","ぬし"],["の"],["手","て"],["に"],["ある"],["輝かしい","かがやかしい"],["冠","かんむり"],["と"],["なり"],["、"],["あなた"],["の"],["神","かみ"],["の"],["手のひら","てのひら"],["に"],["ある"],["／"],["王","おう"],["の"],["かぶり物","かぶりもの"],["と"],["なる"],["。"]]},{"verse":4,"text":"あなたはもう、「見捨てられている」と言われず、あなたの国はもう、「荒れ果てている」とは言われない。／かえって、あなたは／「わたしの喜びは、彼女にある」と呼ばれ、あなたの国は夫のある国と呼ばれよう。／主の喜びがあなたにあり、あなたの国が夫を得るからである。","tok":[["あなた"],["は"],["もう"],["、"],["「"],["見捨てられて","みすてられて"],["いる"],["」"],["と"],["言われず","いわれず"],["、"],["あなた"],["の"],["国","くに"],["は"],["もう"],["、"],["「"],["荒れ果てて","あれはてて"],["いる"],["」"],["と"],["は"],["言われない","いわれない"],["。"],["／"],["かえって"],["、"],["あなた"],["は"],["／"],["「"],["わたし"],["の"],["喜び","よろこび"],["は"],["、"],["彼女","かのじょ"],["に"],["ある"],["」"],["と"],["呼ばれ","よばれ"],["、"],["あなた"],["の"],["国","くに"],["は"],["夫","おっと"],["の"],["ある"],["国","くに"],["と"],["呼ばれよう","よばれよう"],["。"],["／"],["主","ぬし"],["の"],["喜び","よろこび"],["が"],["あなた"],["に"],["あり"],["、"],["あなた"],["の"],["国","くに"],["が"],["夫","おっと"],["を"],["得る","うる"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"若い男が若い女をめとるように、あなたの子らはあなたをめとり、花婿が花嫁を喜ぶように、あなたの神はあなたを喜ぶ。","tok":[["若い","わかい"],["男","おとこ"],["が"],["若い","わかい"],["女","おんな"],["を"],["めとる"],["よう"],["に"],["、"],["あなた"],["の"],["子","こ"],["ら"],["は"],["あなた"],["を"],["めとり"],["、"],["花婿","はなむこ"],["が"],["花嫁","はなよめ"],["を"],["喜ぶ","よろこぶ"],["よう"],["に"],["、"],["あなた"],["の"],["神","かみ"],["は"],["あなた"],["を"],["喜ぶ","よろこぶ"],["。"]]},{"verse":6,"text":"エルサレムよ。／わたしはあなたの城壁の上に見張り人を置いた。／昼の間も、夜の間も、彼らは決して黙っていてはならない。／主に覚えられている者たちよ。／黙りこんではならない。","tok":[["エルサレム"],["よ"],["。"],["／"],["わたし"],["は"],["あなた"],["の"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["見張り","みはり"],["人","ひと"],["を"],["置いた","おいた"],["。"],["／"],["昼","ひる"],["の"],["間","あいだ"],["も"],["、"],["夜","よる"],["の"],["間","あいだ"],["も"],["、"],["彼","かれ"],["ら"],["は"],["決して","けっして"],["黙って","だまって"],["いて"],["は"],["ならない"],["。"],["／"],["主に","おもに"],["覚えられて","おぼえられて"],["いる"],["者","もの"],["たち"],["よ"],["。"],["／"],["黙りこんで","だまりこんで"],["は"],["ならない"],["。"]]},{"verse":7,"text":"主がエルサレムを堅く立て、この地でエルサレムを栄誉とされるまで、黙っていてはならない。","tok":[["主","ぬし"],["が"],["エルサレム"],["を"],["堅く","かたく"],["立て","たて"],["、"],["この"],["地","ち"],["で"],["エルサレム"],["を"],["栄誉","えいよ"],["と"],["される"],["まで"],["、"],["黙って","だまって"],["いて"],["は"],["ならない"],["。"]]},{"verse":8,"text":"主は右の手と、力強い腕によって誓われた。／「わたしは再びあなたの穀物を、あなたの敵に食物として与えない。／あなたの労して作った新しいぶどう酒を、外国人に決して飲ませない。","tok":[["主","ぬし"],["は"],["右","みぎ"],["の"],["手","て"],["と"],["、"],["力強い","ちからづよい"],["腕","うで"],["によって"],["誓われた","ちかわれた"],["。"],["／"],["「"],["わたし"],["は"],["再び","ふたたび"],["あなた"],["の"],["穀物","こくもつ"],["を"],["、"],["あなた"],["の"],["敵","てき"],["に"],["食物","しょくもつ"],["として"],["与えない","あたえない"],["。"],["／"],["あなた"],["の"],["労して","ろうして"],["作った","つくった"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["を"],["、"],["外国人","がいこくじん"],["に"],["決して","けっして"],["飲ませない","のませない"],["。"]]},{"verse":9,"text":"取り入れをした者がそれを食べて、主をほめたたえ、ぶどうを取り集めた者が、わたしの聖所の庭で、それを飲む。」","tok":[["取り入れ","とりいれ"],["を"],["した"],["者","もの"],["が"],["それ"],["を"],["食べて","たべて"],["、"],["主","ぬし"],["を"],["ほめたたえ"],["、"],["ぶどう"],["を"],["取り集めた","とりあつめた"],["者","もの"],["が"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["の"],["庭","にわ"],["で"],["、"],["それ"],["を"],["飲む","のむ"],["。"],["」"]]},{"verse":10,"text":"通れ、通れ、城門を。／この民の道を整え、盛り上げ、土を盛り上げ、大路を造れ。／石を取り除いて国々の民の上に旗を揚げよ。","tok":[["通れ","とおれ"],["、"],["通れ","とおれ"],["、"],["城門","じょうもん"],["を"],["。"],["／"],["この"],["民","たみ"],["の"],["道","みち"],["を"],["整え","ととのえ"],["、"],["盛り上げ","もりあげ"],["、"],["土","つち"],["を"],["盛り上げ","もりあげ"],["、"],["大路","おおじ"],["を"],["造れ","つくれ"],["。"],["／"],["石","いし"],["を"],["取り除いて","とりのぞいて"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["旗","はた"],["を"],["揚げ","あげ"],["よ"],["。"]]},{"verse":11,"text":"見よ。／主は、地の果てまで聞こえるように仰せられた。／「シオンの娘に言え。／『見よ。あなたの救いが来る。／見よ。その報いは主とともにあり、その報酬は主の前にある』と。","tok":[["見","み"],["よ"],["。"],["／"],["主","ぬし"],["は"],["、"],["地","ち"],["の"],["果て","はて"],["まで"],["聞こえる","きこえる"],["よう"],["に"],["仰せられた","おおせられた"],["。"],["／"],["「"],["シオン"],["の"],["娘","むすめ"],["に"],["言え","いえ"],["。"],["／"],["『"],["見","み"],["よ"],["。"],["あなた"],["の"],["救い","すくい"],["が"],["来る","くる"],["。"],["／"],["見","み"],["よ"],["。"],["その"],["報い","むくい"],["は"],["主","ぬし"],["と"],["とも"],["に"],["あり"],["、"],["その"],["報酬","ほうしゅう"],["は"],["主","ぬし"],["の"],["前","まえ"],["に"],["ある"],["』"],["と"],["。"]]},{"verse":12,"text":"彼らは、聖なる民、主に贖われた者と呼ばれ、あなたは、尋ね求められる者、見捨てられない町と呼ばれる。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["聖","せい"],["なる"],["民","たみ"],["、"],["主に","おもに"],["贖われた","あがなわれた"],["者","もの"],["と"],["呼ばれ","よばれ"],["、"],["あなた"],["は"],["、"],["尋ね求められる","たずねもとめられる"],["者","もの"],["、"],["見捨てられない","みすてられない"],["町","まち"],["と"],["呼ばれる","よばれる"],["。"],["」"]]}]
[{"verse":1,"text":"見よ。主の御手が短くて救えないのではない。／その耳が遠くて、聞こえないのではない。","tok":[["見","み"],["よ"],["。"],["主","ぬし"],["の"],["御手","おて"],["が"],["短くて","みじかくて"],["救えない","すくえない"],["ので"],["は"],["ない"],["。"],["／"],["その"],["耳","みみ"],["が"],["遠くて","とおくて"],["、"],["聞こえない","きこえない"],["ので"],["は"],["ない"],["。"]]},{"verse":2,"text":"あなたがたの咎が、あなたがたと、あなたがたの神との仕切りとなり、あなたがたの罪が御顔を隠させ、聞いてくださらないようにしたのだ。","tok":[["あなた"],["がた"],["の"],["咎","とが"],["が"],["、"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["の"],["仕切り","しきり"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["が"],["御顔","おかお"],["を"],["隠させ","かくさせ"],["、"],["聞いて","きいて"],["くださらない"],["よう"],["に"],["した"],["の"],["だ"],["。"]]},{"verse":3,"text":"実に、あなたがたの手は血で汚れ、指は咎で汚れ、あなたがたのくちびるは偽りを語り、舌は不正をつぶやく。","tok":[["実","じつ"],["に"],["、"],["あなた"],["がた"],["の"],["手","て"],["は"],["血","ち"],["で"],["汚れ","よごれ"],["、"],["指","ゆび"],["は"],["咎","とが"],["で"],["汚れ","よごれ"],["、"],["あなた"],["がた"],["の"],["くちびる"],["は"],["偽り","いつわり"],["を"],["語り","かたり"],["、"],["舌","した"],["は"],["不正","ふせい"],["を"],["つぶやく"],["。"]]},{"verse":4,"text":"正しい訴えをする者はなく、真実をもって弁護する者もなく、むなしいことにたより、うそを言い、害毒をはらみ、悪意を産む。","tok":[["正しい","ただしい"],["訴え","うったえ"],["を"],["する"],["者","もの"],["は"],["なく"],["、"],["真実","しんじつ"],["を"],["もって"],["弁護","べんご"],["する"],["者","もの"],["も"],["なく"],["、"],["むなしい"],["こと"],["に"],["たより"],["、"],["うそ"],["を"],["言い","いい"],["、"],["害毒","がいどく"],["を"],["はらみ"],["、"],["悪意","あくい"],["を"],["産む","うむ"],["。"]]},{"verse":5,"text":"彼らはまむしの卵をかえし、くもの巣を織る。／その卵を食べる者は死に、卵をつぶすと、毒蛇がとび出す。","tok":[["彼","かれ"],["ら"],["は"],["まむし"],["の"],["卵","たまご"],["を"],["かえし"],["、"],["くも"],["の"],["巣","す"],["を"],["織る","おる"],["。"],["／"],["その"],["卵","たまご"],["を"],["食べる","たべる"],["者","もの"],["は"],["死に","しに"],["、"],["卵","たまご"],["を"],["つぶす"],["と"],["、"],["毒蛇","どくじゃ"],["が"],["とび出す","とびだす"],["。"]]},{"verse":6,"text":"そのくもの巣は着物にはならず、自分の作ったもので身をおおうこともできない。／彼らのわざは不義のわざ、彼らの手のなすことは、ただ暴虐。","tok":[["その"],["くも"],["の"],["巣","す"],["は"],["着物","きもの"],["に"],["は"],["ならず"],["、"],["自分","じぶん"],["の"],["作った","つくった"],["もの"],["で"],["身","み"],["を"],["おおう"],["こと"],["も"],["できない"],["。"],["／"],["彼","かれ"],["ら"],["の"],["わざ"],["は"],["不義","ふぎ"],["の"],["わざ"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["の"],["なす"],["こと"],["は"],["、"],["ただ"],["暴虐","ぼうぎゃく"],["。"]]},{"verse":7,"text":"彼らの足は悪に走り、罪のない者の血を流すのに速い。／彼らの思いは不義の思い。／破壊と破滅が彼らの大路にある。","tok":[["彼","かれ"],["ら"],["の"],["足","あし"],["は"],["悪","わる"],["に"],["走り","はしり"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["流す","ながす"],["のに"],["速い","はやい"],["。"],["／"],["彼","かれ"],["ら"],["の"],["思い","おもい"],["は"],["不義","ふぎ"],["の"],["思い","おもい"],["。"],["／"],["破壊","はかい"],["と"],["破滅","はめつ"],["が"],["彼","かれ"],["ら"],["の"],["大路","おおじ"],["に"],["ある"],["。"]]},{"verse":8,"text":"彼らは平和の道を知らず、その道筋には公義がない。／彼らは自分の通り道を曲げ、そこを歩む者はだれも、平和を知らない。","tok":[["彼","かれ"],["ら"],["は"],["平和","へいわ"],["の"],["道","みち"],["を"],["知らず","しらず"],["、"],["その"],["道筋","みちすじ"],["に"],["は"],["公義","きみよし"],["が"],["ない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["通り道","とおりみち"],["を"],["曲げ","まげ"],["、"],["そこ"],["を"],["歩む","あゆむ"],["者","もの"],["は"],["だれ"],["も"],["、"],["平和","へいわ"],["を"],["知らない","しらない"],["。"]]},{"verse":9,"text":"それゆえ、公義は私たちから遠ざかり、義は私たちに追いつかない。／私たちは光を待ち望んだが、見よ、やみ。／輝きを待ち望んだが、暗やみの中を歩む。","tok":[["それ"],["ゆえ"],["、"],["公義","きみよし"],["は"],["私たち","わたしたち"],["から"],["遠ざかり","とおざかり"],["、"],["義","ぎ"],["は"],["私たち","わたしたち"],["に"],["追いつかない","おいつかない"],["。"],["／"],["私たち","わたしたち"],["は"],["光","ひかり"],["を"],["待ち望んだ","まちのぞんだ"],["が"],["、"],["見よ","みよ"],["、"],["やみ"],["。"],["／"],["輝き","かがやき"],["を"],["待ち望んだ","まちのぞんだ"],["が"],["、"],["暗やみ","くらやみ"],["の"],["中","なか"],["を"],["歩む","あゆむ"],["。"]]},{"verse":10,"text":"私たちは盲人のように壁を手さぐりし、目のない者のように手さぐりする。／真昼でも、たそがれ時のようにつまずき、やみの中にいる死人のようだ。","tok":[["私たち","わたしたち"],["は"],["盲人","もうじん"],["の"],["よう"],["に"],["壁","かべ"],["を"],["手さぐり","てさぐり"],["し"],["、"],["目","め"],["の"],["ない"],["者","もの"],["の"],["よう"],["に"],["手さぐり","てさぐり"],["する"],["。"],["／"],["真昼","まひる"],["で"],["も"],["、"],["たそがれ時","たそがれどき"],["の"],["よう"],["に"],["つまずき"],["、"],["やみ"],["の"],["中","なか"],["に"],["いる"],["死人","しにん"],["の"],["よう"],["だ"],["。"]]},{"verse":11,"text":"私たちはみな、熊のようにほえ、鳩のようにうめきにうめく。／公義を待ち望むが、それはなく、救いを待ち望むが、それは私たちから遠く離れている。","tok":[["私たち","わたしたち"],["は"],["みな"],["、"],["熊","くま"],["の"],["よう"],["に"],["ほえ"],["、"],["鳩","はと"],["の"],["よう"],["に"],["うめき"],["に"],["うめく"],["。"],["／"],["公義","きみよし"],["を"],["待ち望む","まちのぞむ"],["が"],["、"],["それ"],["は"],["なく"],["、"],["救い","すくい"],["を"],["待ち望む","まちのぞむ"],["が"],["、"],["それ"],["は"],["私たち","わたしたち"],["から"],["遠く","とおく"],["離れて","はなれて"],["いる"],["。"]]},{"verse":12,"text":"それは、私たちがあなたの御前で／多くのそむきの罪を犯し、私たちの罪が、私たちに不利な証言をするからです。／私たちのそむきの罪は、私たちとともにあり、私たちは自分の咎を知っている。","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["が"],["あなた"],["の"],["御前","ごぜん"],["で"],["／"],["多く","おおく"],["の"],["そむき"],["の"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["私たち","わたしたち"],["の"],["罪","つみ"],["が"],["、"],["私たち","わたしたち"],["に"],["不利","ふり"],["な"],["証言","しょうげん"],["を"],["する"],["から"],["です"],["。"],["／"],["私たち","わたしたち"],["の"],["そむき"],["の"],["罪","つみ"],["は"],["、"],["私たち","わたしたち"],["と"],["とも"],["に"],["あり"],["、"],["私たち","わたしたち"],["は"],["自分","じぶん"],["の"],["咎","とが"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":13,"text":"私たちは、そむいて、主を否み、私たちの神に従うことをやめ、しいたげと反逆を語り、心に偽りのことばを抱いて、つぶやいている。","tok":[["私たち","わたしたち"],["は"],["、"],["そむいて"],["、"],["主","ぬし"],["を"],["否み","いなみ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["に"],["従う","したがう"],["こと"],["を"],["やめ"],["、"],["しいたげ"],["と"],["反逆","はんぎゃく"],["を"],["語り","かたり"],["、"],["心","こころ"],["に"],["偽り","いつわり"],["の"],["ことば"],["を"],["抱いて","いだいて"],["、"],["つぶやいて"],["いる"],["。"]]},{"verse":14,"text":"こうして公正は退けられ、正義は遠く離れて立っている。／真理は広場でつまずき、正直は中に入ることもできない。","tok":[["こう"],["して"],["公正","こうせい"],["は"],["退けられ","しりぞけられ"],["、"],["正義","せいぎ"],["は"],["遠く","とおく"],["離れて","はなれて"],["立って","たって"],["いる"],["。"],["／"],["真理","しんり"],["は"],["広場","ひろば"],["で"],["つまずき"],["、"],["正直","しょうじき"],["は"],["中","なか"],["に"],["入る","はいる"],["こと"],["も"],["できない"],["。"]]},{"verse":15,"text":"そこでは真理は失われ、悪から離れる者も、そのとりこになる。／主はこれを見て、公義のないのに心を痛められた。","tok":[["そこ"],["で"],["は"],["真理","しんり"],["は"],["失われ","うしなわれ"],["、"],["悪","わる"],["から"],["離れる","はなれる"],["者","もの"],["も"],["、"],["その"],["とりこ"],["に"],["なる"],["。"],["／"],["主","ぬし"],["は"],["これ"],["を"],["見て","みて"],["、"],["公義","きみよし"],["の"],["ない"],["のに"],["心","こころ"],["を"],["痛められた","いためられた"],["。"]]},{"verse":16,"text":"主は人のいないのを見、とりなす者のいないのに驚かれた。／そこで、ご自分の御腕で救いをもたらし、ご自分の義を、ご自分のささえとされた。","tok":[["主","ぬし"],["は"],["人","ひと"],["の"],["いない"],["の"],["を"],["見","み"],["、"],["とりなす"],["者","もの"],["の"],["いない"],["のに"],["驚かれた","おどろかれた"],["。"],["／"],["そこ"],["で"],["、"],["ご自分","ごじぶん"],["の"],["御腕","おうで"],["で"],["救い","すくい"],["を"],["もたらし"],["、"],["ご自分","ごじぶん"],["の"],["義","ぎ"],["を"],["、"],["ご自分","ごじぶん"],["の"],["ささえ"],["と"],["された"],["。"]]},{"verse":17,"text":"主は義をよろいのように着、救いのかぶとを頭にかぶり、復讐の衣を身にまとい、ねたみを外套として身をおおわれた。","tok":[["主","ぬし"],["は"],["義","ぎ"],["を"],["よろい"],["の"],["よう"],["に"],["着","き"],["、"],["救い","すくい"],["の"],["かぶと"],["を"],["頭","あたま"],["に"],["かぶり"],["、"],["復讐","ふくしゅう"],["の"],["衣","ころも"],["を"],["身","み"],["に"],["まとい"],["、"],["ねたみ"],["を"],["外套","がいとう"],["として"],["身","み"],["を"],["おおわれた"],["。"]]},{"verse":18,"text":"主は彼らのしうちに応じて報い、その仇には憤りを報い、その敵には報復をし、島々にも報復をする。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["しうち"],["に"],["応じて","おうじて"],["報い","むくい"],["、"],["その"],["仇","あだ"],["に"],["は"],["憤り","いきどおり"],["を"],["報い","むくい"],["、"],["その"],["敵","てき"],["に"],["は"],["報復","ほうふく"],["を"],["し"],["、"],["島々","しまじま"],["に"],["も"],["報復","ほうふく"],["を"],["する"],["。"]]},{"verse":19,"text":"そうして、西のほうでは、主の御名が、日の上るほうでは、主の栄光が恐れられる。／主は激しい流れのように来られ、その中で主の息が吹きまくっている。","tok":[["そう"],["して"],["、"],["西","にし"],["の"],["ほう"],["で"],["は"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["が"],["、"],["日","ひ"],["の"],["上る","のぼる"],["ほう"],["で"],["は"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["恐れられる","おそれられる"],["。"],["／"],["主","ぬし"],["は"],["激しい","はげしい"],["流れ","ながれ"],["の"],["よう"],["に"],["来られ","こられ"],["、"],["その"],["中","なか"],["で"],["主","ぬし"],["の"],["息","いき"],["が"],["吹き","ふき"],["まくって"],["いる"],["。"]]},{"verse":20,"text":"「しかし、シオンには贖い主として来る。／ヤコブの中の／そむきの罪を悔い改める者のところに来る。」／――主の御告げ――","tok":[["「"],["しかし"],["、"],["シオン"],["に"],["は"],["贖い","あがない"],["主","ぬし"],["として"],["来る","くる"],["。"],["／"],["ヤコブ"],["の"],["中","なか"],["の"],["／"],[
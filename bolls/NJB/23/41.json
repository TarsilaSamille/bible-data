[{"verse":1,"text":"島々よ。わたしの前で静まれ。／諸国の民よ。新しい力を得よ。／近寄って、今、語れ。／われわれは、こぞって、さばきの座に近づこう。","tok":[["島々","しまじま"],["よ"],["。"],["わたし"],["の"],["前","まえ"],["で"],["静まれ","しずまれ"],["。"],["／"],["諸国","しょこく"],["の"],["民","たみ"],["よ"],["。"],["新しい","あたらしい"],["力","ちから"],["を"],["得","え"],["よ"],["。"],["／"],["近寄って","ちかよって"],["、"],["今","いま"],["、"],["語れ","かたれ"],["。"],["／"],["われわれ"],["は"],["、"],["こぞって"],["、"],["さばき"],["の"],["座","ざ"],["に"],["近づこう","ちかづこう"],["。"]]},{"verse":2,"text":"だれが、ひとりの者を東から起こし、彼の行く先々で勝利を収めさせるのか。／彼の前に国々を渡し、王たちを踏みにじらせ、その剣で彼らをちりのようにし、その弓でわらのように吹き払う。","tok":[["だれ"],["が"],["、"],["ひとり"],["の"],["者","もの"],["を"],["東","ひがし"],["から"],["起こし","おこし"],["、"],["彼","かれ"],["の"],["行く","いく"],["先々","さきざき"],["で"],["勝利","しょうり"],["を"],["収めさせる","おさめさせる"],["の"],["か"],["。"],["／"],["彼","かれ"],["の"],["前","まえ"],["に"],["国々","くにぐに"],["を"],["渡し","わたし"],["、"],["王","おう"],["たち"],["を"],["踏みにじらせ","ふみにじらせ"],["、"],["その"],["剣","けん"],["で"],["彼","かれ"],["ら"],["を"],["ちり"],["の"],["よう"],["に"],["し"],["、"],["その"],["弓","ゆみ"],["で"],["わら"],["の"],["よう"],["に"],["吹き払う","ふきはらう"],["。"]]},{"verse":3,"text":"彼は彼らを追い、まだ歩いて行ったことのない道を／安全に通って行く。","tok":[["彼","かれ"],["は"],["彼","かれ"],["ら"],["を"],["追い","おい"],["、"],["まだ"],["歩いて","あるいて"],["行った","いった"],["こと"],["の"],["ない"],["道","みち"],["を"],["／"],["安全","あんぜん"],["に"],["通って","かよって"],["行く","いく"],["。"]]},{"verse":4,"text":"だれが、これを成し遂げたのか。／初めから代々の人々に呼びかけた者ではないか。／わたし、主こそ初めであり、また終わりとともにある。わたしがそれだ。","tok":[["だれ"],["が"],["、"],["これ"],["を"],["成し遂げた","なしとげた"],["の"],["か"],["。"],["／"],["初め","はじめ"],["から"],["代々","だいだい"],["の"],["人々","ひとびと"],["に"],["呼びかけた","よびかけた"],["者","もの"],["で"],["は"],["ない"],["か"],["。"],["／"],["わたし"],["、"],["主","ぬし"],["こそ"],["初め","はじめ"],["で"],["あり"],["、"],["また"],["終わり","おわり"],["と"],["とも"],["に"],["ある"],["。"],["わたし"],["が"],["それ"],["だ"],["。"]]},{"verse":5,"text":"島々は見て恐れた。／地の果ては震えながら／近づいて来た。","tok":[["島々","しまじま"],["は"],["見て","みて"],["恐れた","おそれた"],["。"],["／"],["地","ち"],["の"],["果て","はて"],["は"],["震え","ふるえ"],["ながら"],["／"],["近づいて","ちかづいて"],["来た","きた"],["。"]]},{"verse":6,"text":"彼らは互いに助け合い、その兄弟に「強くあれ」と言う。","tok":[["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["助け合い","たすけあい"],["、"],["その"],["兄弟","きょうだい"],["に"],["「"],["強く","つよく"],["あれ"],["」"],["と"],["言う","ゆう"],["。"]]},{"verse":7,"text":"鋳物師は金細工人を力づけ、金槌で打つ者は、鉄床をたたく者に、はんだづけについて「それで良い」と言い、釘で打ちつけて動かないようにする。","tok":[["鋳物師","いもじ"],["は"],["金","きん"],["細工人","さいくにん"],["を"],["力づけ","ちからづけ"],["、"],["金槌","かなづち"],["で"],["打つ","うつ"],["者","もの"],["は"],["、"],["鉄床","かなとこ"],["を"],["たたく"],["者","もの"],["に"],["、"],["はんだ"],["づけ"],["について"],["「"],["それ"],["で"],["良い","よい"],["」"],["と"],["言い","いい"],["、"],["釘","くぎ"],["で"],["打ちつけて","うちつけて"],["動かない","うごかない"],["よう"],["に"],["する"],["。"]]},{"verse":8,"text":"しかし、わたしのしもべ、イスラエルよ。／わたしが選んだヤコブ、わたしの友、アブラハムのすえよ。","tok":[["しかし"],["、"],["わたし"],["の"],["しもべ"],["、"],["イスラエル"],["よ"],["。"],["／"],["わたし"],["が"],["選んだ","えらんだ"],["ヤコブ"],["、"],["わたし"],["の"],["友","とも"],["、"],["アブラハム"],["の"],["すえ"],["よ"],["。"]]},{"verse":9,"text":"わたしは、あなたを地の果てから連れ出し、地のはるかな所からあなたを呼び出して言った。「あなたは、わたしのしもべ。わたしはあなたを選んで、捨てなかった。」","tok":[["わたし"],["は"],["、"],["あなた"],["を"],["地","ち"],["の"],["果て","はて"],["から"],["連れ出し","つれだし"],["、"],["地","ち"],["の"],["はるか"],["な"],["所","ところ"],["から"],["あなた"],["を"],["呼び出して","よびだして"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["わたし"],["の"],["しもべ"],["。"],["わたし"],["は"],["あなた"],["を"],["選んで","えらんで"],["、"],["捨てなかった","すてなかった"],["。"],["」"]]},{"verse":10,"text":"恐れるな。わたしはあなたとともにいる。／たじろぐな。わたしがあなたの神だから。／わたしはあなたを強め、あなたを助け、わたしの義の右の手で、あなたを守る。","tok":[["恐れる","おそれる"],["な"],["。"],["わたし"],["は"],["あなた"],["と"],["とも"],["に"],["いる"],["。"],["／"],["たじろぐ"],["な"],["。"],["わたし"],["が"],["あなた"],["の"],["神","かみ"],["だ"],["から"],["。"],["／"],["わたし"],["は"],["あなた"],["を"],["強め","つよめ"],["、"],["あなた"],["を"],["助け","たすけ"],["、"],["わたし"],["の"],["義","ぎ"],["の"],["右","みぎ"],["の"],["手","て"],["で"],["、"],["あなた"],["を"],["守る","まもる"],["。"]]},{"verse":11,"text":"見よ。あなたに向かっていきりたつ者はみな、恥を見、はずかしめを受け、あなたと争う者たちは、無いもののようになって滅びる。","tok":[["見","み"],["よ"],["。"],["あなた"],["に"],["向かって","むかって"],["いきりたつ"],["者","もの"],["は"],["みな"],["、"],["恥","はじ"],["を"],["見","み"],["、"],["はずかしめ"],["を"],["受け","うけ"],["、"],["あなた"],["と"],["争う","あらそう"],["者","もの"],["たち"],["は"],["、"],["無い","ない"],["もの"],["の"],["よう"],["に"],["なって"],["滅びる","ほろびる"],["。"]]},{"verse":12,"text":"あなたと言い争いをする者を捜しても、あなたは見つけることはできず、あなたと戦う者たちは、全くなくなってしまう。","tok":[["あなた"],["と"],["言い争い","いいあらそい"],["を"],["する"],["者","もの"],["を"],["捜して","さがして"],["も"],["、"],["あなた"],["は"],["見つける","みつける"],["こと"],["は"],["できず"],["、"],["あなた"],["と"],["戦う","たたかう"],["者","もの"],["たち"],["は"],["、"],["全く","まったく"],["なくなって"],["しまう"],["。"]]},{"verse":13,"text":"あなたの神、主であるわたしが、あなたの右の手を堅く握り、「恐れるな。わたしがあなたを助ける」／と言っているのだから。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["堅く","かたく"],["握り","にぎり"],["、"],["「"],["恐れる","おそれる"],["な"],["。"],["わたし"],["が"],["あなた"],["を"],["助ける","たすける"],["」"],["／"],["と"],["言って","いって"],["いる"],["の"],["だ"],["から"],["。"]]},{"verse":14,"text":"恐れるな。虫けらのヤコブ、イスラエルの人々。／わたしはあなたを助ける。／――主の御告げ――／あなたを贖う者はイスラエルの聖なる者。","tok":[["恐れる","おそれる"],["な"],["。"],["虫けら","むしけら"],["の"],["ヤコブ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["。"],["／"],["わたし"],["は"],["あなた"],["を"],["助ける","たすける"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["あなた"],["を"],["贖う","あがなう"],["者","もの"],["は"],["イスラエル"],["の"],["聖","せい"],["なる"],["者","もの"],["。"]]},{"verse":15,"text":"見よ。わたしはあなたを／鋭い、新しいもろ刃の打穀機とする。／あなたは、山々を踏みつけて粉々に砕く。／丘をもみがらのようにする。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["／"],["鋭い","するどい"],["、"],["新しい","あたらしい"],["もろ刃","もろは"],["の"],["打","だ"],["穀","こく"],["機","き"],["と"],["する"],["。"],["／"],["あなた"],["は"],["、"],["山々","やまやま"],["を"],["踏みつけて","ふみつけて"],["粉々","こなごな"],["に"],["砕く","くだく"],["。"],["／"],["丘","おか"],["を"],["もみがら"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":16,"text":"あなたがそれをあおぐと、風が運び去り、暴風がそれをまき散らす。／あなたは主によって喜び、イスラエルの聖なる者によって誇る。","tok":[["あなた"],["が"],["それ"],["を"],["あおぐ"],["と"],["、"],["風","かぜ"],["が"],["運び去り","はこびさり"],["、"],["暴風","ぼうふう"],["が"],["それ"],["を"],["まき散らす","まきちらす"],["。"],["／"],["あなた"],["は"],["主に","おもに"],["よって"],["喜び","よろこび"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["者","もの"],["によって"],["誇る","ほこる"],["。"]]},{"verse":17,"text":"悩んでいる者や貧しい者が水を求めても／水はなく、その舌は渇きで干からびるが、わたし、主は、彼らに答え、イスラエルの神は、彼らを見捨てない。","tok":[["悩んで","なやんで"],["いる"],["者","もの"],["や"],["貧しい","まずしい"],["者","もの"],["が"],["水","みず"],["を"],["求めて","もとめて"],["も"],["／"],["水","みず"],["は"],["なく"],["、"],["その"],["舌","した"],["は"],["渇き","かわき"],["で"],["干からびる","ひからびる"],["が"],["、"],["わたし"],["、"],["主","ぬし"],["は"],["、"],["彼","かれ"],["ら"],["に"],["答え","こたえ"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["を"],["見捨てない","みすてない"],["。"]]},{"verse":18,"text":"わたしは、裸の丘に川を開き、平地に泉をわかせる。／荒野を水のある沢とし、砂漠の地を水の源とする。","tok":[["わたし"],["は"],["、"],["裸","はだか"],["の"],["丘","おか"],["に"],["川","かわ"],["を"],["開き","ひらき"],["、"],["平地","へいち"],["に"],["泉","いずみ"],["を"],["わかせる"],["。"],["／"],["荒野","こうや"],["を"],["水","みず"],["の"],["ある"],["沢","さわ"],["と"],["し"],["、"],["砂漠","さばく"],["の"],["地","ち"],["を"],["水","みず"],["の"],["源","みなもと"],["と"],["する"],["。"]]},{"verse":19,"text":"わたしは荒野の中に杉や、アカシヤ、ミルトス、オリーブの木を植え、荒地にもみの木、すずかけ、檜も共に植える。","tok":[["わたし"],["は"],["荒野","こうや"],["の"],["中","なか"],["に"],["杉","すぎ"],["や"],["、"],["アカシヤ"],["、"],["ミルトス"],["、"],["オリーブ"],["の"],["木","き"],["を"],["植え","うえ"],["、"],["荒地","あれち"],["に"],["もみ"],["の"],["木","き"],["、"],["すずかけ"],["、"],["檜","ひのき"],["も"],["共","とも"],["に"],["植える","うえる"],["。"]]},{"verse":20,"text":"主の手がこのことをし、イスラエルの聖なる者がこれを創造したことを、彼らが見て知り、心に留めて、共に悟るためである。","tok":[["主","ぬし"],["の"],["手","て"],["が"],["この"],["こと"],["を"],["し"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["者","もの"],["が"],["これ"],["を"],["創造","そうぞう"],["した"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["が"],["見て","みて"],["知り","しり"],["、"],["心","こころ"],["に"],["留めて","とめて"],["、"],["共","とも"],["に"],["悟る","さとる"],["ため"],["で"],["ある"],["。"]]},{"verse":21,"text":"あなたがたの訴えを出せ、と主は仰せられる。／あなたがたの証拠を持って来い、と／ヤコブの王は仰せられる。","tok":[["あなた"],["がた"],["の"],["訴え","うったえ"],["を"],["出せ","だせ"],["、"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["／"],["あなた"],["がた"],["の"],["証拠","しょうこ"],["を"],["持って","もって"],["来い","こい"],["、"],["と"],["／"],["ヤコブ"],["の"],["王","おう"],["は"],["仰せられる","おおせられる"],["。"]]
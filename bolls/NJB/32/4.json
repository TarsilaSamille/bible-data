[{"verse":1,"text":"ところが、このことはヨナを非常に不愉快にさせた。ヨナは怒って、","tok":[["ところ"],["が"],["、"],["この"],["こと"],["は"],["ヨナ"],["を"],["非常","ひじょう"],["に"],["不愉快","ふゆかい"],["に"],["させた"],["。"],["ヨナ"],["は"],["怒って","おこって"],["、"]]},{"verse":2,"text":"主に祈って言った。「ああ、主よ。私がまだ国にいたときに、このことを申し上げたではありませんか。それで、私は初めタルシシュへのがれようとしたのです。私は、あなたが情け深くあわれみ深い神であり、怒るのにおそく、恵み豊かであり、わざわいを思い直されることを知っていたからです。","tok":[["主に","おもに"],["祈って","いのって"],["言った","いった"],["。"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["が"],["まだ"],["国","くに"],["に"],["いた"],["とき"],["に"],["、"],["この"],["こと"],["を"],["申し上げた","もうしあげた"],["で"],["は"],["ありません"],["か"],["。"],["それ"],["で"],["、"],["私","わたくし"],["は"],["初め","はじめ"],["タルシシュ"],["へ"],["のがれよう"],["と"],["した"],["の"],["です"],["。"],["私","わたくし"],["は"],["、"],["あなた"],["が"],["情け深く","なさけぶかく"],["あわれみ"],["深い","ふかい"],["神","かみ"],["で"],["あり"],["、"],["怒る","おこる"],["のに"],["おそく"],["、"],["恵み","めぐみ"],["豊か","ゆたか"],["で"],["あり"],["、"],["わざわい"],["を"],["思い直される","おもいなおされる"],["こと"],["を"],["知って","しって"],["いた"],["から"],["です"],["。"]]},{"verse":3,"text":"主よ。今、どうぞ、私のいのちを取ってください。私は生きているより死んだほうがましですから。」","tok":[["主","ぬし"],["よ"],["。"],["今","いま"],["、"],["どうぞ"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["取って","とって"],["ください"],["。"],["私","わたくし"],["は"],["生きて","いきて"],["いる"],["より"],["死んだ","しんだ"],["ほう"],["が"],["まし"],["です"],["から"],["。"],["」"]]},{"verse":4,"text":"主は仰せられた。「あなたは当然のことのように怒るのか。」","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["当然","とうぜん"],["の"],["こと"],["の"],["よう"],["に"],["怒る","おこる"],["の"],["か"],["。"],["」"]]},{"verse":5,"text":"ヨナは町から出て、町の東のほうにすわり、そこに自分で仮小屋を作り、町の中で何が起こるかを見きわめようと、その陰の下にすわっていた。","tok":[["ヨナ"],["は"],["町","まち"],["から"],["出て","でて"],["、"],["町","まち"],["の"],["東","ひがし"],["の"],["ほう"],["に"],["すわり"],["、"],["そこ"],["に"],["自分","じぶん"],["で"],["仮","かり"],["小屋","こや"],["を"],["作り","つくり"],["、"],["町","まち"],["の"],["中","なか"],["で"],["何","なん"],["が"],["起こる","おこる"],["か"],["を"],["見きわめよう","みきわめよう"],["と"],["、"],["その"],["陰","かげ"],["の"],["下","した"],["に"],["すわって"],["いた"],["。"]]},{"verse":6,"text":"神である主は一本のとうごまを備え、それをヨナの上をおおうように生えさせ、彼の頭の上の陰として、ヨナの不きげんを直そうとされた。ヨナはこのとうごまを非常に喜んだ。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["一本","いちぽん"],["の"],["とう"],["ごま"],["を"],["備え","そなえ"],["、"],["それ"],["を"],["ヨナ"],["の"],["上","うえ"],["を"],["おおう"],["よう"],["に"],["生えさせ","はえさせ"],["、"],["彼","かれ"],["の"],["頭","あたま"],["の"],["上","うえ"],["の"],["陰","かげ"],["として"],["、"],["ヨナ"],["の"],["不","ふ"],["きげん"],["を"],["直そう","なおそう"],["と"],["された"],["。"],["ヨナ"],["は"],["この"],["とう"],["ごま"],["を"],["非常","ひじょう"],["に"],["喜んだ","よろこんだ"],["。"]]},{"verse":7,"text":"しかし、神は、翌日の夜明けに、一匹の虫を備えられた。虫がそのとうごまをかんだので、とうごまは枯れた。","tok":[["しかし"],["、"],["神","かみ"],["は"],["、"],["翌日","よくじつ"],["の"],["夜明け","よあけ"],["に"],["、"],["一匹","いちひき"],["の"],["虫","むし"],["を"],["備えられた","そなえられた"],["。"],["虫","むし"],["が"],["その"],["とう"],["ごま"],["を"],["かんだ"],["ので"],["、"],["と"],["う"],["ごま"],["は"],["枯れた","かれた"],["。"]]},{"verse":8,"text":"太陽が上ったとき、神は焼けつくような東風を備えられた。太陽がヨナの頭に照りつけたので、彼は衰え果て、自分の死を願って言った。「私は生きているより死んだほうがましだ。」","tok":[["太陽","たいよう"],["が"],["上った","のぼった"],["とき"],["、"],["神","かみ"],["は"],["焼けつく","やけつく"],["よう"],["な"],["東風","とうふう"],["を"],["備えられた","そなえられた"],["。"],["太陽","たいよう"],["が"],["ヨナ"],["の"],["頭","あたま"],["に"],["照りつけた","てりつけた"],["ので"],["、"],["彼","かれ"],["は"],["衰え","おとろえ"],["果て","はて"],["、"],["自分","じぶん"],["の"],["死","し"],["を"],["願って","ねがって"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["生きて","いきて"],["いる"],["より"],["死んだ","しんだ"],["ほう"],["が"],["まし"],["だ"],["。"],["」"]]},{"verse":9,"text":"すると、神はヨナに仰せられた。「このとうごまのために、あなたは当然のことのように怒るのか。」ヨナは言った。「私が死ぬほど怒るのは当然のことです。」","tok":[["する"],["と"],["、"],["神","かみ"],["は"],["ヨナ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["この"],["とう"],["ごま"],["の"],["ため"],["に"],["、"],["あなた"],["は"],["当然","とうぜん"],["の"],["こと"],["の"],["よう"],["に"],["怒る","おこる"],["の"],["か"],["。"],["」"],["ヨナ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["死ぬ","しぬ"],["ほど"],["怒る","おこる"],["の"],["は"],["当然","とうぜん"],["の"],["こと"],["です"],["。"],["」"]]},{"verse":10,"text":"主は仰せられた。「あなたは、自分で骨折らず、育てもせず、一夜で生え、一夜で滅びたこのとうごまを惜しんでいる。","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["自分","じぶん"],["で"],["骨折らず","ほねおらず"],["、"],["育て","そだて"],["も"],["せず"],["、"],["一夜","いちや"],["で"],["生え","はえ"],["、"],["一夜","いちや"],["で"],["滅びた","ほろびた"],["この"],["とう"],["ごま"],["を"],["惜しんで","おしんで"],["いる"],["。"]]},{"verse":11,"text":"まして、わたしは、この大きな町ニネベを惜しまないでいられようか。そこには、右も左もわきまえない十二万以上の人間と、数多くの家畜とがいるではないか。」","tok":[["まして"],["、"],["わたし"],["は"],["、"],["この"],["大きな","おおきな"],["町","まち"],["ニネベ"],["を"],["惜しまないで","おしまないで"],["いられよう"],["か"],["。"],["そこ"],["に"],["は"],["、"],["右","みぎ"],["も"],["左","ひだり"],["も"],["わきまえない"],["十二万","じゅうにまん"],["以上","いじょう"],["の"],["人間","にんげん"],["と"],["、"],["数多く","かずおおく"],["の"],["家畜","かちく"],["と"],["が"],["いるで"],["は"],["ない"],["か"],["。"],["」"]]}]
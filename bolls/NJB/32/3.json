[{"verse":1,"text":"再びヨナに次のような主のことばがあった。","tok":[["再び","ふたたび"],["ヨナ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「立って、あの大きな町ニネベに行き、わたしがあなたに告げることばを伝えよ。」","tok":[["「"],["立って","たって"],["、"],["あの"],["大きな","おおきな"],["町","まち"],["ニネベ"],["に"],["行き","いき"],["、"],["わたし"],["が"],["あなた"],["に"],["告げる","つげる"],["ことば"],["を"],["伝え","つたえ"],["よ"],["。"],["」"]]},{"verse":3,"text":"ヨナは、主のことばのとおりに、立ってニネベに行った。ニネベは、行き巡るのに三日かかるほどの非常に大きな町であった。","tok":[["ヨナ"],["は"],["、"],["主","ぬし"],["の"],["ことば"],["の"],["とおり"],["に"],["、"],["立って","たって"],["ニネベ"],["に"],["行った","いった"],["。"],["ニネベ"],["は"],["、"],["行き","いき"],["巡る","めぐる"],["のに"],["三日","みっか"],["かかる"],["ほど"],["の"],["非常","ひじょう"],["に"],["大きな","おおきな"],["町","まち"],["で"],["あった"],["。"]]},{"verse":4,"text":"ヨナはその町に入って、まず一日目の道のりを歩き回って叫び、「もう四十日すると、ニネベは滅ぼされる」と言った。","tok":[["ヨナ"],["は"],["その"],["町","まち"],["に"],["入って","はいって"],["、"],["まず"],["一","いち"],["日目","にちめ"],["の"],["道のり","みちのり"],["を"],["歩き回って","あるきまわって"],["叫び","さけび"],["、"],["「"],["もう"],["四十日","しとか"],["する"],["と"],["、"],["ニネベ"],["は"],["滅ぼされる","ほろぼされる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"そこで、ニネベの人々は神を信じ、断食を呼びかけ、身分の高い者から低い者まで荒布を着た。","tok":[["そこ"],["で"],["、"],["ニネベ"],["の"],["人々","ひとびと"],["は"],["神","かみ"],["を"],["信じ","しんじ"],["、"],["断食","だんじき"],["を"],["呼びかけ","よびかけ"],["、"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["から"],["低い","ひくい"],["者","もの"],["まで"],["荒布","あらめ"],["を"],["着た","きた"],["。"]]},{"verse":6,"text":"このことがニネベの王の耳に入ると、彼は王座から立って、王服を脱ぎ、荒布をまとい、灰の中にすわった。","tok":[["この"],["こと"],["が"],["ニネベ"],["の"],["王","おう"],["の"],["耳","みみ"],["に"],["入る","はいる"],["と"],["、"],["彼","かれ"],["は"],["王座","おうざ"],["から"],["立って","たって"],["、"],["王","おう"],["服","ふく"],["を"],["脱ぎ","ぬぎ"],["、"],["荒布","あらめ"],["を"],["まとい"],["、"],["灰","はい"],["の"],["中","なか"],["に"],["すわった"],["。"]]},{"verse":7,"text":"王と大臣たちの命令によって、次のような布告がニネベに出された。「人も、獣も、牛も、羊もみな、何も味わってはならない。草をはんだり、水を飲んだりしてはならない。","tok":[["王","おう"],["と"],["大臣","だいじん"],["たち"],["の"],["命令","めいれい"],["によって"],["、"],["次","つぎ"],["の"],["よう"],["な"],["布告","ふこく"],["が"],["ニネベ"],["に"],["出された","だされた"],["。"],["「"],["人","ひと"],["も"],["、"],["獣","けもの"],["も"],["、"],["牛","うし"],["も"],["、"],["羊","ひつじ"],["も"],["みな"],["、"],["何","なん"],["も"],["味わって","あじわって"],["は"],["ならない"],["。"],["草","くさ"],["を"],["はん"],["だり"],["、"],["水","みず"],["を"],["飲ん","のん"],["だり"],["して"],["は"],["ならない"],["。"]]},{"verse":8,"text":"人も、家畜も、荒布を身にまとい、ひたすら神にお願いし、おのおの悪の道と、暴虐な行いから立ち返れ。","tok":[["人","ひと"],["も"],["、"],["家畜","かちく"],["も"],["、"],["荒布","あらめ"],["を"],["身","み"],["に"],["まとい"],["、"],["ひたすら"],["神","かみ"],["に"],["お願い","おねがい"],["し"],["、"],["おのおの"],["悪","わる"],["の"],["道","みち"],["と"],["、"],["暴虐","ぼうぎゃく"],["な"],["行い","おこない"],["から"],["立ち返れ","たちかえれ"],["。"]]},{"verse":9,"text":"もしかすると、神が思い直してあわれみ、その燃える怒りをおさめ、私たちは滅びないですむかもしれない。」","tok":[["もし"],["か"],["する"],["と"],["、"],["神","かみ"],["が"],["思い直して","おもいなおして"],["あわれみ"],["、"],["その"],["燃える","もえる"],["怒り","いかり"],["を"],["おさめ"],["、"],["私たち","わたしたち"],["は"],["滅びないで","ほろびないで"],["すむ"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":10,"text":"神は、彼らが悪の道から立ち返るために努力していることをご覧になった。それで、神は彼らに下すと言っておられたわざわいを思い直し、そうされなかった。","tok":[["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["悪","あく"],["の"],["道","みち"],["から"],["立ち返る","たちかえる"],["ため"],["に"],["努力","どりょく"],["して"],["いる"],["こと"],["を"],["ご覧","ごらん"],["に"],["なった"],["。"],["それ"],["で"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["に"],["下す","くだす"],["と"],["言って","いって"],["おられた"],["わざわい"],["を"],["思い直し","おもいなおし"],["、"],["そう"],["されなかった"],["。"]]}]
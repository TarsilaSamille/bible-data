[{"verse":1,"text":"アミタイの子ヨナに次のような主のことばがあった。","tok":[["アミタイ"],["の"],["子","こ"],["ヨナ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「立って、あの大きな町ニネベに行き、これに向かって叫べ。彼らの悪がわたしの前に上って来たからだ。」","tok":[["「"],["立って","たって"],["、"],["あの"],["大きな","おおきな"],["町","まち"],["ニネベ"],["に"],["行き","いき"],["、"],["これ"],["に"],["向かって","むかって"],["叫べ","さけべ"],["。"],["彼","かれ"],["ら"],["の"],["悪","あく"],["が"],["わたし"],["の"],["前","まえ"],["に"],["上って","のぼって"],["来た","きた"],["から"],["だ"],["。"],["」"]]},{"verse":3,"text":"しかしヨナは、主の御顔を避けてタルシシュへのがれようとし、立って、ヨッパに下った。彼は、タルシシュ行きの船を見つけ、船賃を払ってそれに乗り、主の御顔を避けて、みなといっしょにタルシシュへ行こうとした。","tok":[["しかし"],["ヨナ"],["は"],["、"],["主","ぬし"],["の"],["御顔","おかお"],["を"],["避けて","さけて"],["タルシシュ"],["へ"],["のがれよう"],["と"],["し"],["、"],["立って","たって"],["、"],["ヨッパ"],["に"],["下った","くだった"],["。"],["彼","かれ"],["は"],["、"],["タルシシュ"],["行き","いき"],["の"],["船","ふね"],["を"],["見つけ","みつけ"],["、"],["船賃","ふなちん"],["を"],["払って","はらって"],["それ"],["に"],["乗り","のり"],["、"],["主","ぬし"],["の"],["御顔","おかお"],["を"],["避けて","さけて"],["、"],["みなと"],["いっしょ"],["に"],["タルシシュ"],["へ"],["行こう","いこう"],["と"],["した"],["。"]]},{"verse":4,"text":"さて、主は大風を海に吹きつけられた。それで海に激しい暴風が起こり、船は難破しそうになった。","tok":[["さて"],["、"],["主","ぬし"],["は"],["大風","たいふう"],["を"],["海","うみ"],["に"],["吹きつけられた","ふきつけられた"],["。"],["それ"],["で"],["海","うみ"],["に"],["激しい","はげしい"],["暴風","ぼうふう"],["が"],["起こり","おこり"],["、"],["船","ふね"],["は"],["難破","なんぱ"],["し"],["そう"],["に"],["なった"],["。"]]},{"verse":5,"text":"水夫たちは恐れ、彼らはそれぞれ、自分の神に向かって叫び、船を軽くしようと船の積荷を海に投げ捨てた。しかし、ヨナは船底に降りて行って横になり、ぐっすり寝込んでいた。","tok":[["水夫","すいふ"],["たち"],["は"],["恐れ","おそれ"],["、"],["彼","かれ"],["ら"],["は"],["それぞれ"],["、"],["自分","じぶん"],["の"],["神","かみ"],["に"],["向かって","むかって"],["叫び","さけび"],["、"],["船","ふね"],["を"],["軽く","かるく"],["しよう"],["と"],["船","ふね"],["の"],["積荷","つみに"],["を"],["海","うみ"],["に"],["投げ捨てた","なげすてた"],["。"],["しかし"],["、"],["ヨナ"],["は"],["船底","ふなぞこ"],["に"],["降りて","おりて"],["行って","いって"],["横","よこ"],["に"],["なり"],["、"],["ぐっすり"],["寝込んで","ねこんで"],["いた"],["。"]]},{"verse":6,"text":"船長が近づいて来て彼に言った。「いったいどうしたことか。寝込んだりして。起きて、あなたの神にお願いしなさい。あるいは、神が私たちに心を留めてくださって、私たちは滅びないですむかもしれない。」","tok":[["船長","せんちょう"],["が"],["近づいて","ちかづいて"],["来て","きて"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["いったい"],["どう"],["した"],["こと"],["か"],["。"],["寝込ん","ねこん"],["だり"],["して"],["。"],["起きて","おきて"],["、"],["あなた"],["の"],["神","かみ"],["に"],["お願い","おねがい"],["し"],["なさい"],["。"],["あるいは"],["、"],["神","かみ"],["が"],["私たち","わたしたち"],["に"],["心","こころ"],["を"],["留めて","とめて"],["くださって"],["、"],["私たち","わたしたち"],["は"],["滅びないで","ほろびないで"],["すむ"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":7,"text":"みなは互いに言った。「さあ、くじを引いて、だれのせいで、このわざわいが私たちに降りかかったかを知ろう。」彼らがくじを引くと、そのくじはヨナに当たった。","tok":[["みな"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["くじ"],["を"],["引いて","ひいて"],["、"],["だれ"],["の"],["せい"],["で"],["、"],["この"],["わざわい"],["が"],["私たち","わたしたち"],["に"],["降りかかった","ふりかかった"],["か"],["を"],["知ろう","しろう"],["。"],["」"],["彼","かれ"],["ら"],["が"],["くじ"],["を"],["引く","ひく"],["と"],["、"],["その"],["くじ"],["は"],["ヨナ"],["に"],["当たった","あたった"],["。"]]},{"verse":8,"text":"そこで彼らはヨナに言った。「だれのせいで、このわざわいが私たちに降りかかったのか、告げてくれ。あなたの仕事は何か。あなたはどこから来たのか。あなたの国はどこか。いったいどこの民か。」","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["ヨナ"],["に"],["言った","いった"],["。"],["「"],["だれ"],["の"],["せい"],["で"],["、"],["この"],["わざわい"],["が"],["私たち","わたしたち"],["に"],["降りかかった","ふりかかった"],["の"],["か"],["、"],["告げて","つげて"],["くれ"],["。"],["あなた"],["の"],["仕事","しごと"],["は"],["何","なん"],["か"],["。"],["あなた"],["は"],["どこ"],["から"],["来た","きた"],["の"],["か"],["。"],["あなた"],["の"],["国","くに"],["は"],["どこ"],["か"],["。"],["いったい"],["どこ"],["の"],["民","たみ"],["か"],["。"],["」"]]},{"verse":9,"text":"ヨナは彼らに言った。「私はヘブル人です。私は海と陸を造られた天の神、主を恐れています。」","tok":[["ヨナ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["ヘブル人","へぶるにん"],["です"],["。"],["私","わたくし"],["は"],["海","うみ"],["と"],["陸","りく"],["を"],["造られた","つくられた"],["天","てん"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["恐れて","おそれて"],["います"],["。"],["」"]]},{"verse":10,"text":"それで人々は非常に恐れて、彼に言った。「何でそんなことをしたのか。」人々は、彼が主の御顔を避けてのがれようとしていることを知っていた。ヨナが先に、これを彼らに告げていたからである。","tok":[["それ"],["で"],["人々","ひとびと"],["は"],["非常","ひじょう"],["に"],["恐れて","おそれて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["何","なん"],["で"],["そんな"],["こと"],["を"],["した"],["の"],["か"],["。"],["」"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["が"],["主","ぬし"],["の"],["御顔","おかお"],["を"],["避けて","さけて"],["のがれよう"],["として"],["いる"],["こと"],["を"],["知って","しって"],["いた"],["。"],["ヨナ"],["が"],["先","さき"],["に"],["、"],["これ"],["を"],["彼","かれ"],["ら"],["に"],["告げて","つげて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"彼らはヨナに言った。「海が静まるために、私たちはあなたをどうしたらいいのか。」海がますます荒れてきたからである。","tok":[["彼","かれ"],["ら"],["は"],["ヨナ"],["に"],["言った","いった"],["。"],["「"],["海","うみ"],["が"],["静まる","しずまる"],["ため"],["に"],["、"],["私たち","わたしたち"],["は"],["あなた"],["を"],["どう"],["したら"],["いい"],["の"],["か"],["。"],["」"],["海","うみ"],["が"],["ますます"],["荒れて","あれて"],["きた"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"ヨナは彼らに言った。「私を捕らえて、海に投げ込みなさい。そうすれば、海はあなたがたのために静かになるでしょう。わかっています。この激しい暴風は、私のためにあなたがたを襲ったのです。」","tok":[["ヨナ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["を"],["捕らえて","とらえて"],["、"],["海","うみ"],["に"],["投げ込み","なげこみ"],["なさい"],["。"],["そう"],["すれば"],["、"],["海","うみ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["静か","しずか"],["に"],["なるでしょう"],["。"],["わかって"],["います"],["。"],["この"],["激しい","はげしい"],["暴風","ぼうふう"],["は"],["、"],["私","わたくし"],["の"],["ため"],["に"],["あなた"],["がた"],["を"],["襲った","おそった"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"その人たちは船を陸に戻そうとこいだがだめだった。海がますます、彼らに向かって荒れたからである。","tok":[["その"],["人","ひと"],["たち"],["は"],["船","ふね"],["を"],["陸","りく"],["に"],["戻そう","もどそう"],["と"],["こいだ"],["が"],["だめ"],["だった"],["。"],["海","うみ"],["が"],["ますます"],["、"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["荒れた","あれた"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"そこで彼らは主に願って言った。「ああ、主よ。どうか、この男のいのちのために、私たちを滅ぼさないでください。罪のない者の血を私たちに報いないでください。主よ。あなたはみこころにかなったことをなさるからです。」","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["主に","おもに"],["願って","ねがって"],["言った","いった"],["。"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["、"],["この"],["男","おとこ"],["の"],["いのち"],["の"],["ため"],["に"],["、"],["私たち","わたしたち"],["を"],["滅ぼさないで","ほろぼさないで"],["ください"],["。"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["私たち","わたしたち"],["に"],["報いないで","むくいないで"],["ください"],["。"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["みこころ"],["に"],["かなった"],["こと"],["を"],["なさる"],["から"],["です"],["。"],["」"]]},{"verse":15,"text":"こうして、彼らはヨナをかかえて海に投げ込んだ。すると、海は激しい怒りをやめて静かになった。","tok":[["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["ヨナ"],["を"],["かかえて"],["海","うみ"],["に"],["投げ込んだ","なげこんだ"],["。"],["する"],["と"],["、"],["海","うみ"],["は"],["激しい","はげしい"],["怒り","いかり"],["を"],["やめて"],["静か","しずか"],["に"],["なった"],["。"]]},{"verse":16,"text":"人々は非常に主を恐れ、主にいけにえをささげ、誓願を立てた。","tok":[["人々","ひとびと"],["は"],["非常","ひじょう"],["に"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["主に","おもに"],["いけにえ"],["を"],["ささげ"],["、"],["誓願","せいがん"],["を"],["立てた","たてた"],["。"]]},{"verse":17,"text":"主は大きな魚を備えて、ヨナをのみこませた。ヨナは三日三晩、魚の腹の中にいた。","tok":[["主","ぬし"],["は"],["大きな","おおきな"],["魚","さかな"],["を"],["備えて","そなえて"],["、"],["ヨナ"],["を"],["のみこませた"],["。"],["ヨナ"],["は"],["三日","みっか"],["三","さん"],["晩","ばん"],["、"],["魚","さかな"],["の"],["腹","はら"],["の"],["中","なか"],["に"],["いた"],["。"]]}]
[{"verse":1,"text":"ヨナは魚の腹の中から、彼の神、主に祈って、","tok":[["ヨナ"],["は"],["魚","さかな"],["の"],["腹","はら"],["の"],["中","なか"],["から"],["、"],["彼","かれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈って","いのって"],["、"]]},{"verse":2,"text":"言った。／「私が苦しみの中から主にお願いすると、主は答えてくださいました。／私がよみの腹の中から叫ぶと、あなたは私の声を聞いてくださいました。","tok":[["言った","いった"],["。"],["／"],["「"],["私","わたくし"],["が"],["苦しみ","くるしみ"],["の"],["中","なか"],["から"],["主に","おもに"],["お願い","おねがい"],["する"],["と"],["、"],["主","ぬし"],["は"],["答えて","こたえて"],["くださいました"],["。"],["／"],["私","わたくし"],["が"],["よみ"],["の"],["腹","はら"],["の"],["中","なか"],["から"],["叫ぶ","さけぶ"],["と"],["、"],["あなた"],["は"],["私","わたくし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["くださいました"],["。"]]},{"verse":3,"text":"あなたは私を海の真ん中の深みに／投げ込まれました。／潮の流れが私を囲み、あなたの波と大波がみな、私の上を越えて行きました。","tok":[["あなた"],["は"],["私","わたくし"],["を"],["海","うみ"],["の"],["真ん中","まんなか"],["の"],["深み","ふかみ"],["に"],["／"],["投げ込まれました","なげこまれました"],["。"],["／"],["潮","しお"],["の"],["流れ","ながれ"],["が"],["私","わたくし"],["を"],["囲み","かこみ"],["、"],["あなた"],["の"],["波","なみ"],["と"],["大波","おおなみ"],["が"],["みな"],["、"],["私","わたくし"],["の"],["上","うえ"],["を"],["越えて","こえて"],["行きました","いきました"],["。"]]},{"verse":4,"text":"私は言った。／『私はあなたの目の前から追われました。／しかし、もう一度、私はあなたの聖なる宮を／仰ぎ見たいのです』と。","tok":[["私","わたくし"],["は"],["言った","いった"],["。"],["／"],["『"],["私","わたくし"],["は"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["から"],["追われました","おわれました"],["。"],["／"],["しかし"],["、"],["もう"],["一度","いちど"],["、"],["私","わたくし"],["は"],["あなた"],["の"],["聖","せい"],["なる"],["宮","みや"],["を"],["／"],["仰ぎ見たい","あおぎみたい"],["の"],["です"],["』"],["と"],["。"]]},{"verse":5,"text":"水は、私ののどを絞めつけ、深淵は私を取り囲み、海草は私の頭にからみつきました。","tok":[["水","みず"],["は"],["、"],["私","わたくし"],["の"],["のど"],["を"],["絞め","しめ"],["つけ"],["、"],["深淵","しんえん"],["は"],["私","わたくし"],["を"],["取り囲み","とりかこみ"],["、"],["海草","かいそう"],["は"],["私","わたくし"],["の"],["頭","あたま"],["に"],["からみつきました"],["。"]]},{"verse":6,"text":"私は山々の根元まで下り、地のかんぬきが、いつまでも私の上にありました。／しかし、私の神、主よ。／あなたは私のいのちを／穴から引き上げてくださいました。","tok":[["私","わたくし"],["は"],["山々","やまやま"],["の"],["根元","ねもと"],["まで"],["下り","おり"],["、"],["地","ち"],["の"],["かんぬき"],["が"],["、"],["いつ"],["まで"],["も"],["私","わたくし"],["の"],["上","うえ"],["に"],["ありました"],["。"],["／"],["しかし"],["、"],["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["／"],["あなた"],["は"],["私","わたくし"],["の"],["いのち"],["を"],["／"],["穴","あな"],["から"],["引き上げて","ひきあげて"],["くださいました"],["。"]]},{"verse":7,"text":"私のたましいが私のうちに衰え果てたとき、私は主を思い出しました。／私の祈りはあなたに、あなたの聖なる宮に届きました。","tok":[["私","わたくし"],["の"],["たましい"],["が"],["私","わたくし"],["の"],["うち"],["に"],["衰え","おとろえ"],["果てた","はてた"],["とき"],["、"],["私","わたくし"],["は"],["主","ぬし"],["を"],["思い出しました","おもいだしました"],["。"],["／"],["私","わたくし"],["の"],["祈り","いのり"],["は"],["あなた"],["に"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["宮","みや"],["に"],["届きました","とどきました"],["。"]]},{"verse":8,"text":"むなしい偶像に心を留める者は、自分への恵みを捨てます。","tok":[["むなしい"],["偶像","ぐうぞう"],["に"],["心","こころ"],["を"],["留める","とめる"],["者","もの"],["は"],["、"],["自分","じぶん"],["へ"],["の"],["恵み","めぐみ"],["を"],["捨てます","すてます"],["。"]]},{"verse":9,"text":"しかし、私は、感謝の声をあげて、あなたにいけにえをささげ、私の誓いを果たしましょう。／救いは主のものです。」","tok":[["しかし"],["、"],["私","わたくし"],["は"],["、"],["感謝","かんしゃ"],["の"],["声","こえ"],["を"],["あげて"],["、"],["あなた"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["私","わたくし"],["の"],["誓い","ちかい"],["を"],["果たしましょう","はたしましょう"],["。"],["／"],["救い","すくい"],["は"],["主","ぬし"],["の"],["もの"],["です"],["。"],["」"]]},{"verse":10,"text":"主は、魚に命じ、ヨナを陸地に吐き出させた。","tok":[["主","ぬし"],["は"],["、"],["魚","さかな"],["に"],["命じ","めいじ"],["、"],["ヨナ"],["を"],["陸地","りくち"],["に"],["吐き出させた","はきださせた"],["。"]]}]
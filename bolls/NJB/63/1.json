[{"verse":1,"text":"長老から、選ばれた夫人とその子どもたちへ。私はあなたがたをほんとうに愛しています。私だけでなく、真理を知っている人々がみな、そうです。","tok":[["長老","ちょうろう"],["から"],["、"],["選ばれた","えらばれた"],["夫人","ふじん"],["と"],["その"],["子ども","こども"],["たち"],["へ"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["を"],["ほんとう"],["に"],["愛して","あいして"],["います"],["。"],["私","わたくし"],["だけ"],["で"],["なく"],["、"],["真理","しんり"],["を"],["知って","しって"],["いる"],["人々","ひとびと"],["が"],["みな"],["、"],["そう"],["です"],["。"]]},{"verse":2,"text":"このことは、私たちのうちに宿る真理によることです。そして真理はいつまでも私たちとともにあります。","tok":[["この"],["こと"],["は"],["、"],["私たち","わたしたち"],["の"],["うち"],["に"],["宿る","やどる"],["真理","しんり"],["に"],["よる"],["こと"],["です"],["。"],["そして"],["真理","しんり"],["は"],["いつ"],["まで"],["も"],["私たち","わたしたち"],["と"],["とも"],["に"],["あります"],["。"]]},{"verse":3,"text":"真理と愛のうちに、父なる神と御父の御子イエス・キリストからの恵みとあわれみと平安は、私たちとともにあります。","tok":[["真理","しんり"],["と"],["愛","あい"],["の"],["うち"],["に"],["、"],["父","ちち"],["なる"],["神","かみ"],["と"],["御父","おちち"],["の"],["御子","みこ"],["イエス"],["・"],["キリスト"],["から"],["の"],["恵み","めぐみ"],["と"],["あわれみ"],["と"],["平安","へいあん"],["は"],["、"],["私たち","わたしたち"],["と"],["とも"],["に"],["あります"],["。"]]},{"verse":4,"text":"あなたの子どもたちの中に、御父から私たちが受けた命令のとおりに真理のうちを歩んでいる人たちがあるのを知って、私は非常に喜んでいます。","tok":[["あなた"],["の"],["子ども","こども"],["たち"],["の"],["中","なか"],["に"],["、"],["御父","おちち"],["から"],["私たち","わたしたち"],["が"],["受けた","うけた"],["命令","めいれい"],["の"],["とおり"],["に"],["真理","しんり"],["の"],["うち"],["を"],["歩んで","あゆんで"],["いる"],["人","ひと"],["たち"],["が"],["ある"],["の"],["を"],["知って","しって"],["、"],["私","わたくし"],["は"],["非常","ひじょう"],["に"],["喜んで","よろこんで"],["います"],["。"]]},{"verse":5,"text":"そこで夫人よ。お願いしたいことがあります。それは私が新しい命令を書くのではなく、初めから私たちが持っていたものなのですが、私たちが互いに愛し合うということです。","tok":[["そこ"],["で"],["夫人","ふじん"],["よ"],["。"],["お願い","おねがい"],["したい"],["こと"],["が"],["あります"],["。"],["それ"],["は"],["私","わたくし"],["が"],["新しい","あたらしい"],["命令","めいれい"],["を"],["書く","かく"],["ので"],["は"],["なく"],["、"],["初め","はじめ"],["から"],["私たち","わたしたち"],["が"],["持って","もって"],["いた"],["もの"],["な"],["の"],["です"],["が"],["、"],["私たち","わたしたち"],["が"],["互い","たがい"],["に"],["愛し合う","あいしあう"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":6,"text":"愛とは、御父の命令に従って歩むことであり、命令とは、あなたがたが初めから聞いているとおり、愛のうちを歩むことです。","tok":[["愛","あい"],["と"],["は"],["、"],["御父","おちち"],["の"],["命令","めいれい"],["に"],["従って","したがって"],["歩む","あゆむ"],["こと"],["で"],["あり"],["、"],["命令","めいれい"],["と"],["は"],["、"],["あなた"],["がた"],["が"],["初め","はじめ"],["から"],["聞いて","きいて"],["いる"],["とおり"],["、"],["愛","あい"],["の"],["うち"],["を"],["歩む","あゆむ"],["こと"],["です"],["。"]]},{"verse":7,"text":"なぜお願いするかと言えば、人を惑わす者、すなわち、イエス・キリストが人として来られたことを告白しない者が大ぜい世に出て行ったからです。こういう者は惑わす者であり、反キリストです。","tok":[["なぜ"],["お願い","おねがい"],["する"],["か"],["と"],["言えば","いえば"],["、"],["人","ひと"],["を"],["惑わす","まどわす"],["者","もの"],["、"],["すなわち"],["、"],["イエス"],["・"],["キリスト"],["が"],["人","ひと"],["として"],["来られた","こられた"],["こと"],["を"],["告白","こくはく"],["しない"],["者","もの"],["が"],["大ぜい世","おおぜいせい"],["に"],["出て","でて"],["行った","いった"],["から"],["です"],["。"],["こう"],["いう"],["者","もの"],["は"],["惑わす","まどわす"],["者","もの"],["で"],["あり"],["、"],["反","はん"],["キリスト"],["です"],["。"]]},{"verse":8,"text":"よく気をつけて、私たちの労苦の実をだいなしにすることなく、豊かな報いを受けるようになりなさい。","tok":[["よく"],["気","き"],["を"],["つけて"],["、"],["私たち","わたしたち"],["の"],["労苦","ろうく"],["の"],["実","じつ"],["を"],["だいなし"],["に"],["する"],["こと"],["なく"],["、"],["豊か","ゆたか"],["な"],["報い","むくい"],["を"],["受ける","うける"],["よう"],["に"],["なり"],["なさい"],["。"]]},{"verse":9,"text":"だれでも行き過ぎをして、キリストの教えのうちにとどまらない者は、神を持っていません。その教えのうちにとどまっている者は、御父をも御子をも持っています。","tok":[["だれ"],["で"],["も"],["行き過ぎ","いきすぎ"],["を"],["して"],["、"],["キリスト"],["の"],["教え","おしえ"],["の"],["うち"],["に"],["とどまらない"],["者","もの"],["は"],["、"],["神","かみ"],["を"],["持って","もって"],["いません"],["。"],["その"],["教え","おしえ"],["の"],["うち"],["に"],["とどまって"],["いる"],["者","もの"],["は"],["、"],["御父","おちち"],["を"],["も"],["御子","みこ"],["を"],["も"],["持って","もって"],["います"],["。"]]},{"verse":10,"text":"あなたがたのところに来る人で、この教えを持って来ない者は、家に受け入れてはいけません。その人にあいさつのことばをかけてもいけません。","tok":[["あなた"],["がた"],["の"],["ところ"],["に"],["来る","くる"],["人","ひと"],["で"],["、"],["この"],["教え","おしえ"],["を"],["持って","もって"],["来ない","こない"],["者","もの"],["は"],["、"],["家","いえ"],["に"],["受け入れて","うけいれて"],["は"],["いけません"],["。"],["その"],["人","ひと"],["に"],["あいさつ"],["の"],["ことば"],["を"],["かけて"],["も"],["いけません"],["。"]]},{"verse":11,"text":"そういう人にあいさつすれば、その悪い行いをともにすることになります。","tok":[["そう"],["いう"],["人","ひと"],["に"],["あいさつ"],["すれば"],["、"],["その"],["悪い","わるい"],["行い","おこない"],["を"],["とも"],["に"],["する"],["こと"],["に"],["なります"],["。"]]},{"verse":12,"text":"あなたがたに書くべきことがたくさんありますが、紙と墨でしたくはありません。あなたがたのところに行って、顔を合わせて語りたいと思います。私たちの喜びが全きものとなるためにです。","tok":[["あなた"],["がた"],["に"],["書くべき","かくべき"],["こと"],["が"],["たくさん"],["あります"],["が"],["、"],["紙","かみ"],["と"],["墨","すみ"],["で"],["したく"],["は"],["ありません"],["。"],["あなた"],["がた"],["の"],["ところ"],["に"],["行って","いって"],["、"],["顔","かお"],["を"],["合わせて","あわせて"],["語りたい","かたりたい"],["と"],["思います","おもいます"],["。"],["私たち","わたしたち"],["の"],["喜び","よろこび"],["が"],["全","ぜん"],["きもの"],["と"],["なる"],["ため"],["に"],["です"],["。"]]},{"verse":13,"text":"選ばれたあなたの姉妹の子どもたちが、あなたによろしくと言っています。","tok":[["選ばれた","えらばれた"],["あなた"],["の"],["姉妹","しまい"],["の"],["子ども","こども"],["たち"],["が"],["、"],["あなた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]}]
[{"verse":1,"text":"祭司たちよ。／今、この命令があなたがたに下される。","tok":[["祭司","さいし"],["たち"],["よ"],["。"],["／"],["今","いま"],["、"],["この"],["命令","めいれい"],["が"],["あなた"],["がた"],["に"],["下される","くだされる"],["。"]]},{"verse":2,"text":"もし、あなたがたが聞き入れず、もし、わたしの名に栄光を帰することを／心に留めないなら、――万軍の主は仰せられる――／わたしは、あなたがたの中にのろいを送り、あなたがたへの祝福をのろいに変える。／もう、それをのろいに変えている。／あなたがたが、これを心に留めないからだ。","tok":[["もし"],["、"],["あなた"],["がた"],["が"],["聞き入れず","ききいれず"],["、"],["もし"],["、"],["わたし"],["の"],["名","な"],["に"],["栄光","えいこう"],["を"],["帰する","きする"],["こと"],["を"],["／"],["心","こころ"],["に"],["留めないなら","とめないなら"],["、"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"],["／"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["のろい"],["を"],["送り","おくり"],["、"],["あなた"],["が"],["たへ"],["の"],["祝福","しゅくふく"],["を"],["のろい"],["に"],["変える","かえる"],["。"],["／"],["もう"],["、"],["それ"],["を"],["のろい"],["に"],["変えて","かえて"],["いる"],["。"],["／"],["あなた"],["が"],["た"],["が"],["、"],["これ"],["を"],["心","こころ"],["に"],["留めない","とめない"],["から"],["だ"],["。"]]},{"verse":3,"text":"見よ。わたしは、あなたがたの子孫を責め、あなたがたの顔に糞をまき散らす。／あなたがたの祭りの糞を。／あなたがたはそれとともに投げ捨てられる。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["子孫","しそん"],["を"],["責め","せめ"],["、"],["あなた"],["がた"],["の"],["顔","かお"],["に"],["糞","ふん"],["を"],["まき散らす","まきちらす"],["。"],["／"],["あなた"],["がた"],["の"],["祭り","まつり"],["の"],["糞","ふん"],["を"],["。"],["／"],["あなた"],["がた"],["は"],["それ"],["と"],["とも"],["に"],["投げ捨てられる","なげすてられる"],["。"]]},{"verse":4,"text":"このとき、あなたがたは、わたしが、レビとのわたしの契約を保つために、あなたがたにこの命令を送ったことを知ろう。／――万軍の主は仰せられる――","tok":[["この"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["、"],["レビ"],["と"],["の"],["わたし"],["の"],["契約","けいやく"],["を"],["保つ","たもつ"],["ため"],["に"],["、"],["あなた"],["がた"],["に"],["この"],["命令","めいれい"],["を"],["送った","おくった"],["こと"],["を"],["知ろう","しろう"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":5,"text":"わたしの彼との契約は、いのちと平和であって、わたしは、それらを彼に与えた。／それは恐れであったので、彼は、わたしを恐れ、わたしの名の前におののいた。","tok":[["わたし"],["の"],["彼","かれ"],["と"],["の"],["契約","けいやく"],["は"],["、"],["いのち"],["と"],["平和","へいわ"],["で"],["あって"],["、"],["わたし"],["は"],["、"],["それ"],["ら"],["を"],["彼","かれ"],["に"],["与えた","あたえた"],["。"],["／"],["それ"],["は"],["恐れ","おそれ"],["で"],["あった"],["ので"],["、"],["彼","かれ"],["は"],["、"],["わたし"],["を"],["恐れ","おそれ"],["、"],["わたし"],["の"],["名","な"],["の"],["前","まえ"],["に"],["おののいた"],["。"]]},{"verse":6,"text":"彼の口には真理の教えがあり、彼のくちびるには不正がなかった。／平和と公正のうちに、彼はわたしとともに歩み、多くの者を罪から立ち返らせた。","tok":[["彼","かれ"],["の"],["口","くち"],["に"],["は"],["真理","しんり"],["の"],["教え","おしえ"],["が"],["あり"],["、"],["彼","かれ"],["の"],["くちびる"],["に"],["は"],["不正","ふせい"],["が"],["なかった"],["。"],["／"],["平和","へいわ"],["と"],["公正","こうせい"],["の"],["うち"],["に"],["、"],["彼","かれ"],["は"],["わたし"],["と"],["とも"],["に"],["歩み","あゆみ"],["、"],["多く","おおく"],["の"],["者","もの"],["を"],["罪","つみ"],["から"],["立ち返らせた","たちかえらせた"],["。"]]},{"verse":7,"text":"祭司のくちびるは知識を守り、人々は彼の口から教えを求める。／彼は万軍の主の使いであるからだ。","tok":[["祭司","さいし"],["の"],["くちびる"],["は"],["知識","ちしき"],["を"],["守り","まもり"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["の"],["口","くち"],["から"],["教え","おしえ"],["を"],["求める","もとめる"],["。"],["／"],["彼","かれ"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["使い","つかい"],["で"],["ある"],["から"],["だ"],["。"]]},{"verse":8,"text":"しかし、あなたがたは道からはずれ、多くの者を教えによってつまずかせ、レビとの契約をそこなった。／――万軍の主は仰せられる――","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["道","みち"],["から"],["はずれ"],["、"],["多く","おおく"],["の"],["者","もの"],["を"],["教え","おしえ"],["によって"],["つまずかせ"],["、"],["レビ"],["と"],["の"],["契約","けいやく"],["を"],["そこなった"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":9,"text":"わたしもまた、あなたがたを、すべての民にさげすまれ、軽んじられる者とする。／あなたがたがわたしの道を守らず、えこひいきをして教えたからだ。」","tok":[["わたし"],["も"],["また"],["、"],["あなた"],["がた"],["を"],["、"],["すべて"],["の"],["民","たみ"],["に"],["さげすまれ"],["、"],["軽んじられる","かろんじられる"],["者","もの"],["と"],["する"],["。"],["／"],["あなた"],["がた"],["が"],["わたし"],["の"],["道","みち"],["を"],["守らず","まもらず"],["、"],["えこ"],["ひいき"],["を"],["して"],["教えた","おしえた"],["から"],["だ"],["。"],["」"]]},{"verse":10,"text":"私たちはみな、ただひとりの父を持っているではないか。／ただひとりの神が、私たちを創造したではないか。／なぜ私たちは、互いに裏切り合い、私たちの先祖の契約を汚すのか。","tok":[["私たち","わたしたち"],["は"],["みな"],["、"],["ただ"],["ひとり"],["の"],["父","ちち"],["を"],["持って","もって"],["いるで"],["は"],["ない"],["か"],["。"],["／"],["ただ"],["ひとり"],["の"],["神","かみ"],["が"],["、"],["私たち","わたしたち"],["を"],["創造","そうぞう"],["したで"],["は"],["ない"],["か"],["。"],["／"],["なぜ"],["私たち","わたしたち"],["は"],["、"],["互い","たがい"],["に"],["裏切り","うらぎり"],["合い","あい"],["、"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["の"],["契約","けいやく"],["を"],["汚す","けがす"],["の"],["か"],["。"]]},{"verse":11,"text":"ユダは裏切り、イスラエルとエルサレムの中では／忌まわしいことが行われている。／まことにユダは、主の愛された主の聖所を汚し、外国の神の娘をめとった。","tok":[["ユダ"],["は"],["裏切り","うらぎり"],["、"],["イスラエル"],["と"],["エルサレム"],["の"],["中","なか"],["で"],["は"],["／"],["忌まわしい","いまわしい"],["こと"],["が"],["行われて","おこなわれて"],["いる"],["。"],["／"],["まこと"],["に"],["ユダ"],["は"],["、"],["主","ぬし"],["の"],["愛された","あいされた"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚し","よごし"],["、"],["外国","がいこく"],["の"],["神","かみ"],["の"],["娘","むすめ"],["を"],["めとった"],["。"]]},{"verse":12,"text":"どうか主が、このようなことをする者を、たといその者が／万軍の主にささげ物をささげても、ひとり残らずヤコブの天幕から／断ってくださるように。","tok":[["どう"],["か"],["主","ぬし"],["が"],["、"],["この"],["よう"],["な"],["こと"],["を"],["する"],["者","もの"],["を"],["、"],["たとい"],["その"],["者","もの"],["が"],["／"],["万","まん"],["軍","ぐん"],["の"],["主に","おもに"],["ささげ物","ささげもの"],["を"],["ささげて"],["も"],["、"],["ひとり"],["残らず","のこらず"],["ヤコブ"],["の"],["天幕","てんまく"],["から"],["／"],["断って","ことわって"],["くださる"],["よう"],["に"],["。"]]},{"verse":13,"text":"あなたがたはもう一つのことをしている。／あなたがたは、涙と、悲鳴と、嘆きで／主の祭壇をおおっている。／主がもうささげ物を顧みず、あなたがたの手から、それを喜んで受け取らないからだ。","tok":[["あなた"],["がた"],["は"],["もう"],["一","ひと"],["つ"],["の"],["こと"],["を"],["して"],["いる"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["涙","なみだ"],["と"],["、"],["悲鳴","ひめい"],["と"],["、"],["嘆き","なげき"],["で"],["／"],["主","ぬし"],["の"],["祭壇","さいだん"],["を"],["おおって"],["いる"],["。"],["／"],["主","ぬし"],["が"],["もう"],["ささげ物","ささげもの"],["を"],["顧みず","かえりみず"],["、"],["あなた"],["がた"],["の"],["手","て"],["から"],["、"],["それ"],["を"],["喜んで","よろこんで"],["受け取らない","うけとらない"],["から"],["だ"],["。"]]},{"verse":14,"text":"「なぜなのか」とあなたがたは言う。／それは主が、あなたとあなたの若い時の妻との証人であり、あなたがその妻を裏切ったからだ。／彼女はあなたの伴侶であり、あなたの契約の妻であるのに。","tok":[["「"],["なぜ"],["な"],["の"],["か"],["」"],["と"],["あなた"],["がた"],["は"],["言う","ゆう"],["。"],["／"],["それ"],["は"],["主","ぬし"],["が"],["、"],["あなた"],["と"],["あなた"],["の"],["若い","わかい"],["時","とき"],["の"],["妻","つま"],["と"],["の"],["証人","しょうにん"],["で"],["あり"],["、"],["あなた"],["が"],["その"],["妻","つま"],["を"],["裏切った","うらぎった"],["から"],["だ"],["。"],["／"],["彼女","かのじょ"],["は"],["あなた"],["の"],["伴侶","はんりょ"],["で"],["あり"],["、"],["あなた"],["の"],["契約","けいやく"],["の"],["妻","つま"],["で"],["ある"],["のに"],["。"]]},{"verse":15,"text":"神は人を一体に造られたのではないか。彼には、霊の残りがある。その一体の人は何を求めるのか。神の子孫ではないか。あなたがたは、あなたがたの霊に注意せよ。あなたの若い時の妻を裏切ってはならない。","tok":[["神","かみ"],["は"],["人","ひと"],["を"],["一体","いったい"],["に"],["造られた","つくられた"],["ので"],["は"],["ない"],["か"],["。"],["彼","かれ"],["に"],["は"],["、"],["霊","れい"],["の"],["残り","のこり"],["が"],["ある"],["。"],["その"],["一体","いったい"],["の"],["人","ひと"],["は"],["何","なん"],["を"],["求める","もとめる"],["の"],["か"],["。"],["神","かみ"],["の"],["子孫","しそん"],["で"],["は"],["ない"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["霊","れい"],["に"],["注意","ちゅうい"],["せよ"],["。"],["あなた"],["の"],["若い","わかい"],["時","とき"],["の"],["妻","つま"],["を"],["裏切って","うらぎって"],["は"],["ならない"],["。"]]},{"verse":16,"text":"「わたしは、離婚を憎む」とイスラエルの神、主は仰せられる。「わたしは、暴力でその着物をおおう」と万軍の主は仰せられる。あなたがたは、あなたがたの霊に注意せよ。裏切ってはならない。","tok":[["「"],["わたし"],["は"],["、"],["離婚","りこん"],["を"],["憎む","にくむ"],["」"],["と"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["「"],["わたし"],["は"],["、"],["暴力","ぼうりょく"],["で"],["その"],["着物","きもの"],["を"],["おおう"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["霊","れい"],["に"],["注意","ちゅうい"],["せよ"],["。"],["裏切って","うらぎって"],["は"],["ならない"],["。"]]},{"verse":17,"text":"あなたがたは、あなたがたのことばで主を煩わした。／しかし、あなたがたは言う。／「どのようにして、私たちは煩わしたのか。」／「悪を行う者もみな主の心にかなっている。／主は彼らを喜ばれる。／さばきの神はどこにいるのか」と／あなたがたは言っているのだ。","tok":[["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["ことば"],["で"],["主","ぬし"],["を"],["煩わした","わずらわした"],["。"],["／"],["しかし"],["、"],["あなた"],["がた"],["は"],["言う","ゆう"],["。"],["／"],["「"],["どの"],["よう"],["に"],["して"],["、"],["私たち","わたしたち"],["は"],["煩わした","わずらわした"],["の"],["か"],["。"],["」"],["／"],["「"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["も"],["みな"],["主","ぬし"],["の"],["心","こころ"],["に"],["かなって"],["いる"],["。"],["／"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["喜ばれる","よろこばれる"],["。"],["／"],["さばき"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["／"],["あなた"],["がた"],["は"],["言って","いって"],["いる"],["の"],["だ"],["。"]]}]
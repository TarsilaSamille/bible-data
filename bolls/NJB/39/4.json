[{"verse":1,"text":"見よ。その日が来る。／かまどのように燃えながら。／その日、すべて高ぶる者、すべて悪を行う者は、わらとなる。／来ようとしているその日は、彼らを焼き尽くし、根も枝も残さない。／――万軍の主は仰せられる――","tok":[["見","み"],["よ"],["。"],["その"],["日","ひ"],["が"],["来る","くる"],["。"],["／"],["かまど"],["の"],["よう"],["に"],["燃え","もえ"],["ながら"],["。"],["／"],["その"],["日","ひ"],["、"],["すべて"],["高ぶる","たかぶる"],["者","もの"],["、"],["すべて"],["悪","わる"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["わら"],["と"],["なる"],["。"],["／"],["来よう","こよう"],["として"],["いる"],["その"],["日","ひ"],["は"],["、"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くし","つくし"],["、"],["根","ね"],["も"],["枝","えだ"],["も"],["残さない","のこさない"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":2,"text":"しかし、わたしの名を恐れるあなたがたには、義の太陽が上り、その翼には、いやしがある。／あなたがたは外に出て、牛舎の子牛のようにはね回る。","tok":[["しかし"],["、"],["わたし"],["の"],["名","な"],["を"],["恐れる","おそれる"],["あなた"],["がた"],["に"],["は"],["、"],["義","ぎ"],["の"],["太陽","たいよう"],["が"],["上り","のぼり"],["、"],["その"],["翼","つばさ"],["に"],["は"],["、"],["いやし"],["が"],["ある"],["。"],["／"],["あなた"],["がた"],["は"],["外","そと"],["に"],["出て","でて"],["、"],["牛舎","ぎゅうしゃ"],["の"],["子牛","こうし"],["の"],["よう"],["に"],["はね"],["回る","まわる"],["。"]]},{"verse":3,"text":"あなたがたはまた、悪者どもを踏みつける。／彼らは、わたしが事を行う日に、あなたがたの足の下で灰となるからだ。／――万軍の主は仰せられる――","tok":[["あなた"],["がた"],["は"],["また"],["、"],["悪者","わるもの"],["ども"],["を"],["踏みつける","ふみつける"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["事","こと"],["を"],["行う","おこなう"],["日","ひ"],["に"],["、"],["あなた"],["がた"],["の"],["足","あし"],["の"],["下","もと"],["で"],["灰","はい"],["と"],["なる"],["から"],["だ"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":4,"text":"あなたがたは、わたしのしもべモーセの律法を記憶せよ。／それは、ホレブで、イスラエル全体のために、わたしが彼に命じたおきてと定めである。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["しもべ"],["モーセ"],["の"],["律法","りっぽう"],["を"],["記憶","きおく"],["せよ"],["。"],["／"],["それ"],["は"],["、"],["ホレブ"],["で"],["、"],["イスラエル"],["全体","ぜんたい"],["の"],["ため"],["に"],["、"],["わたし"],["が"],["彼","かれ"],["に"],["命じた","めいじた"],["おきて"],["と"],["定め","さだめ"],["で"],["ある"],["。"]]},{"verse":5,"text":"見よ。わたしは、主の大いなる恐ろしい日が来る前に、預言者エリヤをあなたがたに遣わす。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["主","ぬし"],["の"],["大いなる","おおいなる"],["恐ろしい","おそろしい"],["日","ひ"],["が"],["来る","くる"],["前","まえ"],["に"],["、"],["預言者","よげんしゃ"],["エリヤ"],["を"],["あなた"],["がた"],["に"],["遣わす","つかわす"],["。"]]},{"verse":6,"text":"彼は、父の心を子に向けさせ、子の心をその父に向けさせる。／それは、わたしが来て、のろいでこの地を打ち滅ぼさないためだ。」","tok":[["彼","かれ"],["は"],["、"],["父","ちち"],["の"],["心","こころ"],["を"],["子","こ"],["に"],["向けさせ","むけさせ"],["、"],["子","こ"],["の"],["心","こころ"],["を"],["その"],["父","ちち"],["に"],["向けさせる","むけさせる"],["。"],["／"],["それ"],["は"],["、"],["わたし"],["が"],["来て","きて"],["、"],["のろい"],["で"],["この"],["地","ち"],["を"],["打ち滅ぼさない","うちほろぼさない"],["ため"],["だ"],["。"],["」"]]}]
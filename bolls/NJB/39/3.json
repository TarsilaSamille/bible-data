[{"verse":1,"text":"「見よ。わたしは、わたしの使者を遣わす。／彼はわたしの前に道を整える。／あなたがたが尋ね求めている主が、突然、その神殿に来る。／あなたがたが望んでいる契約の使者が、見よ、来ている」と万軍の主は仰せられる。","tok":[["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["わたし"],["の"],["使者","ししゃ"],["を"],["遣わす","つかわす"],["。"],["／"],["彼","かれ"],["は"],["わたし"],["の"],["前","まえ"],["に"],["道","みち"],["を"],["整える","ととのえる"],["。"],["／"],["あなた"],["がた"],["が"],["尋ね求めて","たずねもとめて"],["いる"],["主","ぬし"],["が"],["、"],["突然","とつぜん"],["、"],["その"],["神殿","しんでん"],["に"],["来る","くる"],["。"],["／"],["あなた"],["がた"],["が"],["望んで","のぞんで"],["いる"],["契約","けいやく"],["の"],["使者","ししゃ"],["が"],["、"],["見よ","みよ"],["、"],["来て","きて"],["いる"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":2,"text":"だれが、この方の来られる日に耐えられよう。／だれが、この方の現れるとき立っていられよう。／まことに、この方は、精錬する者の火、布をさらす者の灰汁のようだ。","tok":[["だれ"],["が"],["、"],["この"],["方","かた"],["の"],["来られる","こられる"],["日","ひ"],["に"],["耐えられよう","たえられよう"],["。"],["／"],["だれ"],["が"],["、"],["この"],["方","かた"],["の"],["現れる","あらわれる"],["とき"],["立って","たって"],["いられよう"],["。"],["／"],["まこと"],["に"],["、"],["この"],["方","かた"],["は"],["、"],["精錬","せいれん"],["する"],["者","もの"],["の"],["火","ひ"],["、"],["布","ぬの"],["を"],["さらす"],["者","もの"],["の"],["灰汁","あく"],["の"],["よう"],["だ"],["。"]]},{"verse":3,"text":"この方は、銀を精錬し、これをきよめる者として座に着き、レビの子らをきよめ、彼らを金のように、銀のように純粋にする。／彼らは、主に、義のささげ物をささげる者となり、","tok":[["この"],["方","かた"],["は"],["、"],["銀","ぎん"],["を"],["精錬","せいれん"],["し"],["、"],["これ"],["を"],["きよめる"],["者","もの"],["として"],["座","ざ"],["に"],["着き","つき"],["、"],["レビ"],["の"],["子","こ"],["ら"],["を"],["きよめ"],["、"],["彼","かれ"],["ら"],["を"],["金","かね"],["の"],["よう"],["に"],["、"],["銀","ぎん"],["の"],["よう"],["に"],["純粋","じゅんすい"],["に"],["する"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["主に","おもに"],["、"],["義","ぎ"],["の"],["ささげ物","ささげもの"],["を"],["ささげる"],["者","もの"],["と"],["なり"],["、"]]},{"verse":4,"text":"ユダとエルサレムのささげ物は、昔の日のように、ずっと前の年のように、主を喜ばせる。","tok":[["ユダ"],["と"],["エルサレム"],["の"],["ささげ物","ささげもの"],["は"],["、"],["昔","むかし"],["の"],["日","ひ"],["の"],["よう"],["に"],["、"],["ずっと"],["前","まえ"],["の"],["年","とし"],["の"],["よう"],["に"],["、"],["主","ぬし"],["を"],["喜ばせる","よろこばせる"],["。"]]},{"verse":5,"text":"「わたしは、さばきのため、あなたがたのところに近づく。／わたしは、ためらうことなく証人となり、呪術者、姦淫を行う者、偽って誓う者、不正な賃金で雇い人をしいたげ、やもめやみなしごを苦しめる者、在留異国人を押しのけて、わたしを恐れない者たちに、向かう。／――万軍の主は仰せられる――","tok":[["「"],["わたし"],["は"],["、"],["さばき"],["の"],["ため"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["近づく","ちかづく"],["。"],["／"],["わたし"],["は"],["、"],["ためらう"],["こと"],["なく"],["証人","しょうにん"],["と"],["なり"],["、"],["呪術者","じゅじゅつしゃ"],["、"],["姦淫","かんいん"],["を"],["行う","おこなう"],["者","もの"],["、"],["偽","にせ"],["って"],["誓う","ちかう"],["者","もの"],["、"],["不正","ふせい"],["な"],["賃金","ちんぎん"],["で"],["雇い人","やといにん"],["を"],["しいたげ"],["、"],["やもめ"],["や"],["みなしご"],["を"],["苦しめる","くるしめる"],["者","もの"],["、"],["在留","ざいりゅう"],["異国人","いこくにん"],["を"],["押しのけて","おしのけて"],["、"],["わたし"],["を"],["恐れない","おそれない"],["者","もの"],["たち"],["に"],["、"],["向かう","むかう"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":6,"text":"主であるわたしは変わることがない。／ヤコブの子らよ。／あなたがたは、滅ぼし尽くされない。","tok":[["主","ぬし"],["で"],["ある"],["わたし"],["は"],["変わる","かわる"],["こと"],["が"],["ない"],["。"],["／"],["ヤコブ"],["の"],["子","こ"],["ら"],["よ"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["滅ぼし","ほろぼし"],["尽くされない","つくされない"],["。"]]},{"verse":7,"text":"あなたがたの先祖の時代から、あなたがたは、わたしのおきてを離れ、それを守らなかった。／わたしのところに帰れ。そうすれば、わたしもあなたがたのところに帰ろう。／――万軍の主は仰せられる――／しかし、あなたがたは、『どのようにして、私たちは帰ろうか』と言う。","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["時代","じだい"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["おきて"],["を"],["離れ","はなれ"],["、"],["それ"],["を"],["守らなかった","まもらなかった"],["。"],["／"],["わたし"],["の"],["ところ"],["に"],["帰れ","かえれ"],["。"],["そう"],["すれば"],["、"],["わたし"],["も"],["あなた"],["がた"],["の"],["ところ"],["に"],["帰ろう","かえろう"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"],["／"],["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["『"],["どの"],["よう"],["に"],["して"],["、"],["私たち","わたしたち"],["は"],["帰ろう","かえろう"],["か"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":8,"text":"人は神のものを盗むことができようか。／ところが、あなたがたは／わたしのものを盗んでいる。／しかも、あなたがたは言う。／『どのようにして、私たちはあなたのものを盗んだでしょうか。』／それは、十分の一と奉納物によってである。","tok":[["人","ひと"],["は"],["神","かみ"],["の"],["もの"],["を"],["盗む","ぬすむ"],["こと"],["が"],["できよう"],["か"],["。"],["／"],["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["／"],["わたし"],["の"],["もの"],["を"],["盗んで","ぬすんで"],["いる"],["。"],["／"],["しかも"],["、"],["あなた"],["がた"],["は"],["言う","ゆう"],["。"],["／"],["『"],["どの"],["よう"],["に"],["して"],["、"],["私たち","わたしたち"],["は"],["あなた"],["の"],["もの"],["を"],["盗んだでしょう","ぬすんだでしょう"],["か"],["。"],["』"],["／"],["それ"],["は"],["、"],["十分","じゅうぶん"],["の"],["一","いち"],["と"],["奉納物","ほうのうぶつ"],["によって"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたがたはのろいを受けている。／あなたがたは、わたしのものを盗んでいる。／この民全体が盗んでいる。","tok":[["あなた"],["がた"],["は"],["のろい"],["を"],["受けて","うけて"],["いる"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["もの"],["を"],["盗んで","ぬすんで"],["いる"],["。"],["／"],["この"],["民","みん"],["全体","ぜんたい"],["が"],["盗んで","ぬすんで"],["いる"],["。"]]},{"verse":10,"text":"十分の一をことごとく、宝物倉に携えて来て、わたしの家の食物とせよ。／こうしてわたしをためしてみよ。／――万軍の主は仰せられる――／わたしがあなたがたのために、天の窓を開き、あふれるばかりの祝福を／あなたがたに注ぐかどうかをためしてみよ。","tok":[["十分","じゅうぶん"],["の"],["一","いち"],["を"],["ことごとく"],["、"],["宝物倉","ほうもつそう"],["に"],["携えて","たずさえて"],["来て","きて"],["、"],["わたし"],["の"],["家","いえ"],["の"],["食物","しょくもつ"],["と"],["せよ"],["。"],["／"],["こう"],["して"],["わたし"],["を"],["ためして"],["み"],["よ"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"],["／"],["わたし"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["天","てん"],["の"],["窓","まど"],["を"],["開き","ひらき"],["、"],["あふれる"],["ばかり"],["の"],["祝福","しゅくふく"],["を"],["／"],["あなた"],["がた"],["に"],["注ぐ","そそぐ"],["か"],["どう"],["か"],["を"],["ためして"],["み"],["よ"],["。"]]},{"verse":11,"text":"わたしはあなたがたのために、いなごをしかって、あなたがたの土地の産物を滅ぼさないようにし、畑のぶどうの木が不作とならないようにする。／――万軍の主は仰せられる――","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["いなご"],["を"],["しかって"],["、"],["あなた"],["がた"],["の"],["土地","とち"],["の"],["産物","さんぶつ"],["を"],["滅ぼさない","ほろぼさない"],["よう"],["に"],["し"],["、"],["畑","はたけ"],["の"],["ぶどう"],["の"],["木","き"],["が"],["不作","ふさく"],["と"],["ならない"],["よう"],["に"],["する"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":12,"text":"すべての国民は、あなたがたをしあわせ者と言うようになる。／あなたがたが喜びの地となるからだ」と／万軍の主は仰せられる。","tok":[["すべて"],["の"],["国民","こくみん"],["は"],["、"],["あなた"],["がた"],["を"],["しあわせ者","しあわせもの"],["と"],["言う","いう"],["よう"],["に"],["なる"],["。"],["／"],["あなた"],["がた"],["が"],["喜び","よろこび"],["の"],["地","ち"],["と"],["なる"],["から"],["だ"],["」"],["と"],["／"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":13,"text":"「あなたがたはわたしに／かたくななことを言う」と主は仰せられる。／あなたがたは言う。「私たちはあなたに対して、何を言いましたか。」","tok":[["「"],["あなた"],["がた"],["は"],["わたし"],["に"],["／"],["かたくな"],["な"],["こと"],["を"],["言う","ゆう"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["／"],["あなた"],["がた"],["は"],["言う","ゆう"],["。"],["「"],["私たち","わたしたち"],["は"],["あなた"],["に対して","にたいして"],["、"],["何","なん"],["を"],["言いました","いいました"],["か"],["。"],["」"]]},{"verse":14,"text":"あなたがたは言う。／「神に仕えるのはむなしいことだ。／神の戒めを守っても、万軍の主の前で悲しんで歩いても、何の益になろう。","tok":[["あなた"],["がた"],["は"],["言う","ゆう"],["。"],["／"],["「"],["神","かみ"],["に"],["仕える","つかえる"],["の"],["は"],["むなしい"],["こと"],["だ"],["。"],["／"],["神","かみ"],["の"],["戒め","いましめ"],["を"],["守って","まもって"],["も"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["前","まえ"],["で"],["悲しんで","かなしんで"],["歩いて","あるいて"],["も"],["、"],["何","なん"],["の"],["益","えき"],["に"],["なろう"],["。"]]},{"verse":15,"text":"今、私たちは、高ぶる者をしあわせ者と言おう。／悪を行っても栄え、神を試みても罰を免れる」と。","tok":[["今","いま"],["、"],["私たち","わたしたち"],["は"],["、"],["高ぶる","たかぶる"],["者","もの"],["を"],["しあわせ者","しあわせもの"],["と"],["言おう","いおう"],["。"],["／"],["悪","あく"],["を"],["行って","おこなって"],["も"],["栄え","さかえ"],["、"],["神","かみ"],["を"],["試みて","こころみて"],["も"],["罰","ばつ"],["を"],["免れる","まぬがれる"],["」"],["と"],["。"]]},{"verse":16,"text":"そのとき、主を恐れる者たちが、互いに語り合った。／主は耳を傾けて、これを聞かれた。／主を恐れ、主の御名を尊ぶ者たちのために、主の前で、記憶の書がしるされた。","tok":[["その"],["とき"],["、"],["主","ぬし"],["を"],["恐れる","おそれる"],["者","もの"],["たち"],["が"],["、"],["互い","たがい"],["に"],["語り合った","かたりあった"],["。"],["／"],["主","ぬし"],["は"],["耳","みみ"],["を"],["傾けて","かたむけて"],["、"],["これ"],["を"],["聞かれた","きかれた"],["。"],["／"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["尊ぶ","とうとぶ"],["者","もの"],["たち"],["の"],["ため"],["に"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["、"],["記憶","きおく"],["の"],["書","しょ"],["が"],["しるされた"],["。"]]},{"verse":17,"text":"「彼らは、わたしのものとなる。／――万軍の主は仰せられる――／わたしが事を行う日に、わたしの宝となる。／人が自分に仕える子をあわれむように、わたしは彼らをあわれむ。","tok":[["「"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["もの"],["と"],["なる"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"],["／"],["わたし"],["が"],["事","こと"],["を"],["行う","おこなう"],["日","ひ"],["に"],["、"],["わたし"],["の"],["宝","たから"],["と"],["なる"],["。"],["／"],["人","ひと"],["が"],["自分","じぶん"],["に"],["仕える","つかえる"],["子","こ"],["を"],["あわれむ"],["よう"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あわれむ"],["。"]]},{"verse":18,"text":"あなたがたは再び、正しい人と悪者、神に仕える者と仕えない者との違いを／見るようになる。","tok":[["あなた"],["がた"],["は"],["再び","ふたたび"],["、"],["正しい","ただしい"],["人","ひと"],["と"],["悪者","わるもの"],["、"],["神","かみ"],["に"],["仕える","つかえる"],["者","もの"],["と"],["仕えない","つかえない"],["者","もの"],["と"],["の"],["違い","ちがい"],["を"],["／"],["見る","みる"],["よう"],["に"],["なる"],["。"]]}]
[{"verse":1,"text":"宣告。マラキを通してイスラエルにあった主のことば。","tok":[["宣告","せんこく"],["。"],["マラキ"],["を"],["通して","とおして"],["イスラエル"],["に"],["あった"],["主","ぬし"],["の"],["ことば"],["。"]]},{"verse":2,"text":"「わたしはあなたがたを愛している」と／主は仰せられる。／あなたがたは言う。／「どのように、あなたが私たちを／愛されたのですか」と。／「エサウはヤコブの兄ではなかったか。／――主の御告げ――／わたしはヤコブを愛した。","tok":[["「"],["わたし"],["は"],["あなた"],["がた"],["を"],["愛して","あいして"],["いる"],["」"],["と"],["／"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["／"],["あなた"],["がた"],["は"],["言う","ゆう"],["。"],["／"],["「"],["どの"],["よう"],["に"],["、"],["あなた"],["が"],["私たち","わたしたち"],["を"],["／"],["愛された","あいされた"],["の"],["です"],["か"],["」"],["と"],["。"],["／"],["「"],["エサウ"],["は"],["ヤコブ"],["の"],["兄","あに"],["で"],["は"],["なかった"],["か"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["ヤコブ"],["を"],["愛した","あいした"],["。"]]},{"verse":3,"text":"わたしはエサウを憎み、彼の山を荒れ果てた地とし、彼の継いだ地を荒野のジャッカルのものとした。」","tok":[["わたし"],["は"],["エサウ"],["を"],["憎み","にくみ"],["、"],["彼","かれ"],["の"],["山","やま"],["を"],["荒れ果てた","あれはてた"],["地","ち"],["と"],["し"],["、"],["彼","かれ"],["の"],["継いだ","ついだ"],["地","ち"],["を"],["荒野","あらの"],["の"],["ジャッカル"],["の"],["もの"],["と"],["した"],["。"],["」"]]},{"verse":4,"text":"たといエドムが、「私たちは打ち砕かれた。／だが、廃墟を建て直そう」と言っても、万軍の主はこう仰せられる。「彼らは建てるが、わたしは打ちこわす。彼らは、悪の国と言われ、主のとこしえにのろう民と呼ばれる。」","tok":[["たとい"],["エドム"],["が"],["、"],["「"],["私たち","わたしたち"],["は"],["打ち砕かれた","うちくだかれた"],["。"],["／"],["だ"],["が"],["、"],["廃墟","はいきょ"],["を"],["建て直そう","たてなおそう"],["」"],["と"],["言って","いって"],["も"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["彼","かれ"],["ら"],["は"],["建てる","たてる"],["が"],["、"],["わたし"],["は"],["打ちこわす","うちこわす"],["。"],["彼","かれ"],["ら"],["は"],["、"],["悪","あく"],["の"],["国","くに"],["と"],["言われ","いわれ"],["、"],["主","ぬし"],["の"],["とこしえ"],["に"],["のろう"],["民","たみ"],["と"],["呼ばれる","よばれる"],["。"],["」"]]},{"verse":5,"text":"あなたがたの目はこれを見て言おう。／「主はイスラエルの地境を越えて偉大な方だ」と。","tok":[["あなた"],["がた"],["の"],["目","め"],["は"],["これ"],["を"],["見て","みて"],["言おう","いおう"],["。"],["／"],["「"],["主","ぬし"],["は"],["イスラエル"],["の"],["地境","じざかい"],["を"],["越えて","こえて"],["偉大","いだい"],["な"],["方","ほう"],["だ"],["」"],["と"],["。"]]},{"verse":6,"text":"「子は父を敬い、しもべはその主人を敬う。／もし、わたしが父であるなら、どこに、わたしへの尊敬があるのか。／もし、わたしが主人であるなら、どこに、わたしへの恐れがあるのか。／――万軍の主は、あなたがたに仰せられる――／わたしの名をさげすむ祭司たち。／あなたがたは言う。／『どのようにして、私たちがあなたの名をさげすみましたか』と。","tok":[["「"],["子","こ"],["は"],["父","ちち"],["を"],["敬い","うやまい"],["、"],["しもべ"],["は"],["その"],["主人","しゅじん"],["を"],["敬う","うやまう"],["。"],["／"],["もし"],["、"],["わたし"],["が"],["父","ちち"],["で"],["あるなら"],["、"],["どこ"],["に"],["、"],["わたし"],["へ"],["の"],["尊敬","そんけい"],["が"],["ある"],["の"],["か"],["。"],["／"],["もし"],["、"],["わたし"],["が"],["主人","しゅじん"],["で"],["あるなら"],["、"],["どこ"],["に"],["、"],["わたし"],["へ"],["の"],["恐れ","おそれ"],["が"],["ある"],["の"],["か"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["に"],["仰せられる","おおせられる"],["―"],["―"],["／"],["わたし"],["の"],["名","な"],["を"],["さげすむ"],["祭司","さいし"],["たち"],["。"],["／"],["あなた"],["がた"],["は"],["言う","ゆう"],["。"],["／"],["『"],["どの"],["よう"],["に"],["して"],["、"],["私たち","わたしたち"],["が"],["あなた"],["の"],["名","な"],["を"],["さげすみました"],["か"],["』"],["と"],["。"]]},{"verse":7,"text":"あなたがたは、わたしの祭壇の上に汚れたパンをささげて、『どのようにして、私たちがあなたを汚しましたか』と言う。／『主の食卓はさげすまれてもよい』と／あなたがたは思っている。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["汚れた","よごれた"],["パン"],["を"],["ささげて"],["、"],["『"],["どの"],["よう"],["に"],["して"],["、"],["私たち","わたしたち"],["が"],["あなた"],["を"],["汚しました","よごしました"],["か"],["』"],["と"],["言う","ゆう"],["。"],["／"],["『"],["主","ぬし"],["の"],["食卓","しょくたく"],["は"],["さげすまれて"],["も"],["よい"],["』"],["と"],["／"],["あなた"],["がた"],["は"],["思って","おもって"],["いる"],["。"]]},{"verse":8,"text":"あなたがたは、盲目の獣をいけにえにささげるが、それは悪いことではないか。／足のなえたものや病気のものをささげるのは、悪いことではないか。／さあ、あなたの総督のところに／それを差し出してみよ。／彼はあなたをよみし、あなたを受け入れるだろうか。／――万軍の主は仰せられる――","tok":[["あなた"],["がた"],["は"],["、"],["盲目","もうもく"],["の"],["獣","けもの"],["を"],["いけにえ"],["に"],["ささげる"],["が"],["、"],["それ"],["は"],["悪い","わるい"],["こと"],["で"],["は"],["ない"],["か"],["。"],["／"],["足","あし"],["の"],["なえた"],["もの"],["や"],["病気","びょうき"],["の"],["もの"],["を"],["ささげる"],["の"],["は"],["、"],["悪い","わるい"],["こと"],["で"],["は"],["ない"],["か"],["。"],["／"],["さあ"],["、"],["あなた"],["の"],["総督","そうとく"],["の"],["ところ"],["に"],["／"],["それ"],["を"],["差し出して","さしだして"],["み"],["よ"],["。"],["／"],["彼","かれ"],["は"],["あなた"],["を"],["よみ"],["し"],["、"],["あなた"],["を"],["受け入れるだろう","うけいれるだろう"],["か"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":9,"text":"さあ、今、恵みを受けるために神に願ってみよ。／これはあなたがたの手によることだ。／神はあなたがたのうちだれかを、受け入れてくださるだろうか。／――万軍の主は仰せられる――","tok":[["さあ"],["、"],["今","いま"],["、"],["恵み","めぐみ"],["を"],["受ける","うける"],["ため"],["に"],["神","かみ"],["に"],["願って","ねがって"],["み"],["よ"],["。"],["／"],["これ"],["は"],["あなた"],["がた"],["の"],["手","て"],["に"],["よる"],["こと"],["だ"],["。"],["／"],["神","かみ"],["は"],["あなた"],["がた"],["の"],["うち"],["だれ"],["か"],["を"],["、"],["受け入れて","うけいれて"],["くださるだろう"],["か"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":10,"text":"あなたがたのうちにさえ、あなたがたがわたしの祭壇に、いたずらに火を点ずることがないように、戸を閉じる人は、だれかいないのか。／わたしは、あなたがたを喜ばない。／――万軍の主は仰せられる――／わたしは、あなたがたの手からのささげ物を／受け入れない。","tok":[["あなた"],["がた"],["の"],["うち"],["に"],["さえ"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["祭壇","さいだん"],["に"],["、"],["いたずら"],["に"],["火","ひ"],["を"],["点ずる","てんずる"],["こと"],["が"],["ない"],["よう"],["に"],["、"],["戸","と"],["を"],["閉じる","とじる"],["人","ひと"],["は"],["、"],["だれ"],["か"],["いない"],["の"],["か"],["。"],["／"],["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["喜ばない","よろこばない"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"],["／"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["手","て"],["から"],["の"],["ささげ物","ささげもの"],["を"],["／"],["受け入れない","うけいれない"],["。"]]},{"verse":11,"text":"日の出る所から、その沈む所まで、わたしの名は諸国の民の間であがめられ、すべての場所で、わたしの名のために、きよいささげ物がささげられ、香がたかれる。／わたしの名が諸国の民の間で／あがめられているからだ。／――万軍の主は仰せられる――","tok":[["日","ひ"],["の"],["出る","でる"],["所","ところ"],["から"],["、"],["その"],["沈む","しずむ"],["所","ところ"],["まで"],["、"],["わたし"],["の"],["名","な"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["間","あいだ"],["で"],["あがめられ"],["、"],["すべて"],["の"],["場所","ばしょ"],["で"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["きよい"],["ささげ物","ささげもの"],["が"],["ささげられ"],["、"],["香","こう"],["が"],["たかれる"],["。"],["／"],["わたし"],["の"],["名","な"],["が"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["間","あいだ"],["で"],["／"],["あがめられて"],["いる"],["から"],["だ"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":12,"text":"しかし、あなたがたは、『主の食卓は汚れている。／その果実も食物もさげすまれている』と言って、祭壇を冒瀆している。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["『"],["主","ぬし"],["の"],["食卓","しょくたく"],["は"],["汚れて","よごれて"],["いる"],["。"],["／"],["その"],["果実","かじつ"],["も"],["食物","しょくもつ"],["も"],["さげすまれて"],["いる"],["』"],["と"],["言って","いって"],["、"],["祭壇","さいだん"],["を"],["冒瀆","ぼうとく"],["して"],["いる"],["。"]]},{"verse":13,"text":"あなたがたはまた、『見よ。なんとうるさいことか』と言って、それを軽蔑する。／――万軍の主は仰せられる――／あなたがたは、かすめたもの、足のなえたもの、病気のものを連れて来て、ささげ物としてささげている。／わたしが、それをあなたがたの手から、喜んで、受け入れるだろうか。／――主は仰せられる――","tok":[["あなた"],["がた"],["は"],["また"],["、"],["『"],["見","み"],["よ"],["。"],["なん"],["と"],["うるさい"],["こと"],["か"],["』"],["と"],["言って","いって"],["、"],["それ"],["を"],["軽蔑","けいべつ"],["する"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"],["／"],["あなた"],["がた"],["は"],["、"],["かすめた"],["もの"],["、"],["足","あし"],["の"],["なえた"],["もの"],["、"],["病気","びょうき"],["の"],["もの"],["を"],["連れて","つれて"],["来て","きて"],["、"],["ささげ物","ささげもの"],["として"],["ささげて"],["いる"],["。"],["／"],["わたし"],["が"],["、"],["それ"],["を"],["あなた"],["がた"],["の"],["手","て"],["から"],["、"],["喜んで","よろこんで"],["、"],["受け入れるだろう","うけいれるだろう"],["か"],["。"],["／"],["―"],["―"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["―"],["―"]]},{"verse":14,"text":"群れのうちに雄の獣がいて、これをささげると誓いながら、損傷のあるのを主にささげるずるい者は、のろわれる。／わたしが大いなる王であり、わたしの名が諸国の民の間で、恐れられているからだ。／――万軍の主は仰せられる――","tok":[["群れ","むれ"],["の"],["うち"],["に"],["雄","おす"],["の"],["獣","けもの"],["が"],["いて"],["、"],["これ"],["を"],["ささげる"],["と"],["誓い","ちかい"],["ながら"],["、"],["損傷","そんしょう"],["の"],["ある"],["の"],["を"],["主に","おもに"],["ささげる"],["ずるい"],["者","もの"],["は"],["、"],["のろわれる"],["。"],["／"],["わたし"],["が"],["大いなる","おおいなる"],["王","おう"],["で"]
[{"verse":1,"text":"また、巨大なしるしが天に現れた。ひとりの女が太陽を着て、月を足の下に踏み、頭には十二の星の冠をかぶっていた。","tok":[["また"],["、"],["巨大","きょだい"],["な"],["しるし"],["が"],["天","てん"],["に"],["現れた","あらわれた"],["。"],["ひとり"],["の"],["女","おんな"],["が"],["太陽","たいよう"],["を"],["着て","きて"],["、"],["月","つき"],["を"],["足","あし"],["の"],["下","した"],["に"],["踏み","ふみ"],["、"],["頭","あたま"],["に"],["は"],["十二","じゅうに"],["の"],["星","ほし"],["の"],["冠","かんむり"],["を"],["かぶって"],["いた"],["。"]]},{"verse":2,"text":"この女は、みごもっていたが、産みの苦しみと痛みのために、叫び声をあげた。","tok":[["この"],["女","おんな"],["は"],["、"],["みごもって"],["いた"],["が"],["、"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["と"],["痛み","いたみ"],["の"],["ため"],["に"],["、"],["叫び声","さけびごえ"],["を"],["あげた"],["。"]]},{"verse":3,"text":"また、別のしるしが天に現れた。見よ。大きな赤い竜である。七つの頭と十本の角とを持ち、その頭には七つの冠をかぶっていた。","tok":[["また"],["、"],["別","べつ"],["の"],["しるし"],["が"],["天","てん"],["に"],["現れた","あらわれた"],["。"],["見","み"],["よ"],["。"],["大きな","おおきな"],["赤い","あかい"],["竜","りゅう"],["で"],["ある"],["。"],["七","なな"],["つ"],["の"],["頭","あたま"],["と"],["十本","じゅうぽん"],["の"],["角","かど"],["と"],["を"],["持ち","もち"],["、"],["その"],["頭","あたま"],["に"],["は"],["七","なな"],["つ"],["の"],["冠","かんむり"],["を"],["かぶって"],["いた"],["。"]]},{"verse":4,"text":"その尾は、天の星の三分の一を引き寄せると、それらを地上に投げた。また、竜は子を産もうとしている女の前に立っていた。彼女が子を産んだとき、その子を食い尽くすためであった。","tok":[["その"],["尾","お"],["は"],["、"],["天","てん"],["の"],["星","ほし"],["の"],["三分","さんぶん"],["の"],["一","いち"],["を"],["引き寄せる","ひきよせる"],["と"],["、"],["それ"],["ら"],["を"],["地上","ちじょう"],["に"],["投げた","なげた"],["。"],["また"],["、"],["竜","りゅう"],["は"],["子","こ"],["を"],["産もう","うもう"],["として"],["いる"],["女","おんな"],["の"],["前","まえ"],["に"],["立って","たって"],["いた"],["。"],["彼女","かのじょ"],["が"],["子","こ"],["を"],["産んだ","うんだ"],["とき"],["、"],["その"],["子","こ"],["を"],["食い","くい"],["尽くす","つくす"],["ため"],["で"],["あった"],["。"]]},{"verse":5,"text":"女は男の子を産んだ。この子は、鉄の杖をもって、すべての国々の民を牧するはずである。その子は神のみもと、その御座に引き上げられた。","tok":[["女","おんな"],["は"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["この"],["子","こ"],["は"],["、"],["鉄","てつ"],["の"],["杖","つえ"],["を"],["もって"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["牧","まき"],["する"],["はず"],["で"],["ある"],["。"],["その"],["子","こ"],["は"],["神","かみ"],["のみ"],["も"],["と"],["、"],["その"],["御座","ぎょざ"],["に"],["引き上げられた","ひきあげられた"],["。"]]},{"verse":6,"text":"女は荒野に逃げた。そこには、千二百六十日の間彼女を養うために、神によって備えられた場所があった。","tok":[["女","おんな"],["は"],["荒野","こうや"],["に"],["逃げた","にげた"],["。"],["そこ"],["に"],["は"],["、"],["千二百六十","せんにひゃくろくとう"],["日","か"],["の"],["間","あいだ"],["彼女","かのじょ"],["を"],["養う","やしなう"],["ため"],["に"],["、"],["神","かみ"],["によって"],["備えられた","そなえられた"],["場所","ばしょ"],["が"],["あった"],["。"]]},{"verse":7,"text":"さて、天に戦いが起こって、ミカエルと彼の使いたちは、竜と戦った。それで、竜とその使いたちは応戦したが、","tok":[["さて"],["、"],["天","てん"],["に"],["戦い","たたかい"],["が"],["起こって","おこって"],["、"],["ミカエル"],["と"],["彼","かれ"],["の"],["使い","つかい"],["たち"],["は"],["、"],["竜","りゅう"],["と"],["戦った","たたかった"],["。"],["それ"],["で"],["、"],["竜","りゅう"],["と"],["その"],["使い","つかい"],["たち"],["は"],["応戦","おうせん"],["した"],["が"],["、"]]},{"verse":8,"text":"勝つことができず、天にはもはや彼らのいる場所がなくなった。","tok":[["勝つ","かつ"],["こと"],["が"],["できず"],["、"],["天","てん"],["に"],["は"],["もはや"],["彼","かれ"],["ら"],["の"],["いる"],["場所","ばしょ"],["が"],["なくなった"],["。"]]},{"verse":9,"text":"こうして、この巨大な竜、すなわち、悪魔とか、サタンとか呼ばれて、全世界を惑わす、あの古い蛇は投げ落とされた。彼は地上に投げ落とされ、彼の使いどもも彼とともに投げ落とされた。","tok":[["こう"],["して"],["、"],["この"],["巨大","きょだい"],["な"],["竜","りゅう"],["、"],["すなわち"],["、"],["悪魔","あくま"],["と"],["か"],["、"],["サタン"],["と"],["か"],["呼ばれて","よばれて"],["、"],["全","ぜん"],["世界","せかい"],["を"],["惑わす","まどわす"],["、"],["あの"],["古い","ふるい"],["蛇","へび"],["は"],["投げ落とされた","なげおとされた"],["。"],["彼","かれ"],["は"],["地上","ちじょう"],["に"],["投げ落とされ","なげおとされ"],["、"],["彼","かれ"],["の"],["使い","つかい"],["ども"],["も"],["彼","かれ"],["と"],["とも"],["に"],["投げ落とされた","なげおとされた"],["。"]]},{"verse":10,"text":"そのとき私は、天で大きな声が、こう言うのを聞いた。「今や、私たちの神の救いと力と国と、また、神のキリストの権威が現れた。私たちの兄弟たちの告発者、日夜彼らを私たちの神の御前で訴えている者が投げ落とされたからである。","tok":[["その"],["とき"],["私","わたくし"],["は"],["、"],["天","てん"],["で"],["大きな","おおきな"],["声","こえ"],["が"],["、"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["今","いま"],["や"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["救い","すくい"],["と"],["力","ちから"],["と"],["国","くに"],["と"],["、"],["また"],["、"],["神","かみ"],["の"],["キリスト"],["の"],["権威","けんい"],["が"],["現れた","あらわれた"],["。"],["私たち","わたしたち"],["の"],["兄弟","きょうだい"],["たち"],["の"],["告発者","こくはつしゃ"],["、"],["日夜","にちや"],["彼","かれ"],["ら"],["を"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["訴えて","うったえて"],["いる"],["者","もの"],["が"],["投げ落とされた","なげおとされた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"兄弟たちは、小羊の血と、自分たちのあかしのことばのゆえに彼に打ち勝った。彼らは死に至るまでもいのちを惜しまなかった。","tok":[["兄弟","きょうだい"],["たち"],["は"],["、"],["小羊","こひつじ"],["の"],["血","ち"],["と"],["、"],["自分","じぶん"],["たち"],["の"],["あかし"],["の"],["ことば"],["の"],["ゆえ"],["に"],["彼","かれ"],["に"],["打ち勝った","うちかった"],["。"],["彼","かれ"],["ら"],["は"],["死","し"],["に"],["至る","いたる"],["まで"],["も"],["いのち"],["を"],["惜しまなかった","おしまなかった"],["。"]]},{"verse":12,"text":"それゆえ、天とその中に住む者たち。喜びなさい。しかし、地と海とには、わざわいが来る。悪魔が自分の時の短いことを知り、激しく怒って、そこに下ったからである。」","tok":[["それ"],["ゆえ"],["、"],["天","てん"],["と"],["その"],["中","なか"],["に"],["住む","すむ"],["者","もの"],["たち"],["。"],["喜び","よろこび"],["なさい"],["。"],["しかし"],["、"],["地","ち"],["と"],["海","うみ"],["と"],["に"],["は"],["、"],["わざわい"],["が"],["来る","くる"],["。"],["悪魔","あくま"],["が"],["自分","じぶん"],["の"],["時","とき"],["の"],["短い","みじかい"],["こと"],["を"],["知り","しり"],["、"],["激しく","はげしく"],["怒って","おこって"],["、"],["そこ"],["に"],["下った","くだった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":13,"text":"自分が地上に投げ落とされたのを知った竜は、男の子を産んだ女を追いかけた。","tok":[["自分","じぶん"],["が"],["地上","ちじょう"],["に"],["投げ落とされた","なげおとされた"],["の"],["を"],["知った","しった"],["竜","りゅう"],["は"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["女","おんな"],["を"],["追いかけた","おいかけた"],["。"]]},{"verse":14,"text":"しかし、女は大鷲の翼を二つ与えられた。自分の場所である荒野に飛んで行って、そこで一時と二時と半時の間、蛇の前をのがれて養われるためであった。","tok":[["しかし"],["、"],["女","おんな"],["は"],["大鷲","おおわし"],["の"],["翼","つばさ"],["を"],["二","ふた"],["つ"],["与えられた","あたえられた"],["。"],["自分","じぶん"],["の"],["場所","ばしょ"],["で"],["ある"],["荒野","あらの"],["に"],["飛んで","とんで"],["行って","いって"],["、"],["そこ"],["で"],["一時","いちじ"],["と"],["二","に"],["時","じ"],["と"],["半時","はんとき"],["の"],["間","あいだ"],["、"],["蛇","へび"],["の"],["前","まえ"],["を"],["のがれて"],["養われる","やしなわれる"],["ため"],["で"],["あった"],["。"]]},{"verse":15,"text":"ところが、蛇はその口から水を川のように女のうしろへ吐き出し、彼女を大水で押し流そうとした。","tok":[["ところ"],["が"],["、"],["蛇","へび"],["は"],["その"],["口","くち"],["から"],["水","みず"],["を"],["川","かわ"],["の"],["よう"],["に"],["女","おんな"],["の"],["うしろ"],["へ"],["吐き出し","はきだし"],["、"],["彼女","かのじょ"],["を"],["大水","おおみず"],["で"],["押し流そう","おしながそう"],["と"],["した"],["。"]]},{"verse":16,"text":"しかし、地は女を助け、その口を開いて、竜が口から吐き出した川を飲み干した。","tok":[["しかし"],["、"],["地","ち"],["は"],["女","おんな"],["を"],["助け","たすけ"],["、"],["その"],["口","くち"],["を"],["開いて","ひらいて"],["、"],["竜","りゅう"],["が"],["口","くち"],["から"],["吐き出した","はきだした"],["川","かわ"],["を"],["飲み干した","のみほした"],["。"]]},{"verse":17,"text":"すると、竜は女に対して激しく怒り、女の子孫の残りの者、すなわち、神の戒めを守り、イエスのあかしを保っている者たちと戦おうとして出て行った。","tok":[["する"],["と"],["、"],["竜","りゅう"],["は"],["女","おんな"],["に対して","にたいして"],["激しく","はげしく"],["怒り","おこり"],["、"],["女","おんな"],["の"],["子孫","しそん"],["の"],["残り","のこり"],["の"],["者","もの"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["戒め","いましめ"],["を"],["守り","まもり"],["、"],["イエス"],["の"],["あかし"],["を"],["保って","たもって"],["いる"],["者","もの"],["たち"],["と"],["戦おう","たたかおう"],["として"],["出て","でて"],["行った","いった"],["。"]]},{"verse":18,"text":"そして、彼は海べの砂の上に立った。","tok":[["そして"],["、"],["彼","かれ"],["は"],["海べ","うみべ"],["の"],["砂","すな"],["の"],["上","うえ"],["に"],["立った","たった"],["。"]]}]
[{"verse":1,"text":"また、私は、御座にすわっておられる方の右の手に巻き物があるのを見た。それは内側にも外側にも文字が書きしるされ、七つの封印で封じられていた。","tok":[["また"],["、"],["私","わたくし"],["は"],["、"],["御座","ぎょざ"],["に"],["すわって"],["おられる"],["方","かた"],["の"],["右","みぎ"],["の"],["手","て"],["に"],["巻き物","まきもの"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"],["それ"],["は"],["内側","うちがわ"],["に"],["も"],["外側","そとがわ"],["に"],["も"],["文字","もじ"],["が"],["書きしるされ","かきしるされ"],["、"],["七","なな"],["つ"],["の"],["封印","ふういん"],["で"],["封じられて","ふうじられて"],["いた"],["。"]]},{"verse":2,"text":"また私は、ひとりの強い御使いが、大声でふれ広めて、「巻き物を開いて、封印を解くのにふさわしい者はだれか」と言っているのを見た。","tok":[["また"],["私","わたくし"],["は"],["、"],["ひとり"],["の"],["強い","つよい"],["御使い","おつかい"],["が"],["、"],["大声","おおごえ"],["で"],["ふれ"],["広めて","ひろめて"],["、"],["「"],["巻き物","まきもの"],["を"],["開いて","ひらいて"],["、"],["封印","ふういん"],["を"],["解く","とく"],["のに"],["ふさわしい"],["者","もの"],["は"],["だれ"],["か"],["」"],["と"],["言って","いって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":3,"text":"しかし、天にも、地にも、地の下にも、だれひとりその巻き物を開くことのできる者はなく、見ることのできる者もいなかった。","tok":[["しかし"],["、"],["天","てん"],["に"],["も"],["、"],["地","ち"],["に"],["も"],["、"],["地","ち"],["の"],["下","した"],["に"],["も"],["、"],["だれ"],["ひとり"],["その"],["巻き物","まきもの"],["を"],["開く","ひらく"],["こと"],["の"],["できる"],["者","もの"],["は"],["なく"],["、"],["見る","みる"],["こと"],["の"],["できる"],["者","もの"],["も"],["いなかった"],["。"]]},{"verse":4,"text":"巻き物を開くのにも、見るのにも、ふさわしい者がだれも見つからなかったので、私は激しく泣いていた。","tok":[["巻き物","まきもの"],["を"],["開く","ひらく"],["のに"],["も"],["、"],["見る","みる"],["のに"],["も"],["、"],["ふさわしい"],["者","もの"],["が"],["だれ"],["も"],["見つからなかった","みつからなかった"],["ので"],["、"],["私","わたくし"],["は"],["激しく","はげしく"],["泣いて","ないて"],["いた"],["。"]]},{"verse":5,"text":"すると、長老のひとりが、私に言った。「泣いてはいけない。見なさい。ユダ族から出た獅子、ダビデの根が勝利を得たので、その巻き物を開いて、七つの封印を解くことができます。」","tok":[["する"],["と"],["、"],["長老","ちょうろう"],["の"],["ひとり"],["が"],["、"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["泣いて","ないて"],["は"],["いけない"],["。"],["見","み"],["なさい"],["。"],["ユダ族","ゆだぞく"],["から"],["出た","でた"],["獅子","しし"],["、"],["ダビデ"],["の"],["根","ね"],["が"],["勝利","しょうり"],["を"],["得た","えた"],["ので"],["、"],["その"],["巻き物","まきもの"],["を"],["開いて","ひらいて"],["、"],["七","なな"],["つ"],["の"],["封印","ふういん"],["を"],["解く","とく"],["こと"],["が"],["できます"],["。"],["」"]]},{"verse":6,"text":"さらに私は、御座――そこには、四つの生き物がいる――と、長老たちとの間に、ほふられたと見える小羊が立っているのを見た。これに七つの角と七つの目があった。その目は、全世界に遣わされた神の七つの御霊である。","tok":[["さらに"],["私","わたくし"],["は"],["、"],["御座","ぎょざ"],["―"],["―"],["そこ"],["に"],["は"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["が"],["いる"],["―"],["―"],["と"],["、"],["長老","ちょうろう"],["たち"],["と"],["の"],["間","あいだ"],["に"],["、"],["ほふられた"],["と"],["見える","みえる"],["小羊","こひつじ"],["が"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["これ"],["に"],["七","なな"],["つ"],["の"],["角","かど"],["と"],["七","なな"],["つ"],["の"],["目","め"],["が"],["あった"],["。"],["その"],["目","め"],["は"],["、"],["全","ぜん"],["世界","せかい"],["に"],["遣わされた","つかわされた"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["御霊","ごれい"],["で"],["ある"],["。"]]},{"verse":7,"text":"小羊は近づいて、御座にすわる方の右の手から、巻き物を受け取った。","tok":[["小羊","こひつじ"],["は"],["近づいて","ちかづいて"],["、"],["御座","ぎょざ"],["に"],["すわる"],["方","ほう"],["の"],["右","みぎ"],["の"],["手","て"],["から"],["、"],["巻き物","まきもの"],["を"],["受け取った","うけとった"],["。"]]},{"verse":8,"text":"彼が巻き物を受け取ったとき、四つの生き物と二十四人の長老は、おのおの、立琴と、香のいっぱい入った金の鉢とを持って、小羊の前にひれ伏した。この香は聖徒たちの祈りである。","tok":[["彼","かれ"],["が"],["巻き物","まきもの"],["を"],["受け取った","うけとった"],["とき"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["は"],["、"],["おのおの"],["、"],["立琴","たてごと"],["と"],["、"],["香","こう"],["の"],["いっぱい"],["入った","はいった"],["金","かね"],["の"],["鉢","ばち"],["と"],["を"],["持って","もって"],["、"],["小羊","こひつじ"],["の"],["前","まえ"],["に"],["ひれ伏した","ひれふした"],["。"],["この"],["香","こう"],["は"],["聖徒","せいと"],["たち"],["の"],["祈り","いのり"],["で"],["ある"],["。"]]},{"verse":9,"text":"彼らは、新しい歌を歌って言った。「あなたは、巻き物を受け取って、その封印を解くのにふさわしい方です。あなたは、ほふられて、その血により、あらゆる部族、国語、民族、国民の中から、神のために人々を贖い、","tok":[["彼","かれ"],["ら"],["は"],["、"],["新しい","あたらしい"],["歌","うた"],["を"],["歌って","うたって"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["巻き物","まきもの"],["を"],["受け取って","うけとって"],["、"],["その"],["封印","ふういん"],["を"],["解く","とく"],["のに"],["ふさわしい"],["方","ほう"],["です"],["。"],["あなた"],["は"],["、"],["ほふられて"],["、"],["その"],["血","ち"],["に"],["より"],["、"],["あらゆる"],["部族","ぶぞく"],["、"],["国語","こくご"],["、"],["民族","みんぞく"],["、"],["国民","こくみん"],["の"],["中","なか"],["から"],["、"],["神","かみ"],["の"],["ため"],["に"],["人々","ひとびと"],["を"],["贖い","あがない"],["、"]]},{"verse":10,"text":"私たちの神のために、この人々を王国とし、祭司とされました。彼らは地上を治めるのです。」","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["の"],["ため"],["に"],["、"],["この"],["人々","ひとびと"],["を"],["王国","おうこく"],["と"],["し"],["、"],["祭司","さいし"],["と"],["されました"],["。"],["彼","かれ"],["ら"],["は"],["地上","ちじょう"],["を"],["治める","おさめる"],["の"],["です"],["。"],["」"]]},{"verse":11,"text":"また私は見た。私は、御座と生き物と長老たちとの回りに、多くの御使いたちの声を聞いた。その数は万の幾万倍、千の幾千倍であった。","tok":[["また"],["私","わたくし"],["は"],["見た","みた"],["。"],["私","わたくし"],["は"],["、"],["御座","ぎょざ"],["と"],["生き物","いきもの"],["と"],["長老","ちょうろう"],["たち"],["と"],["の"],["回り","まわり"],["に"],["、"],["多く","おおく"],["の"],["御使い","おつかい"],["たち"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["その"],["数","すう"],["は"],["万","まん"],["の"],["幾","いく"],["万","まん"],["倍","ばい"],["、"],["千","せん"],["の"],["幾","いく"],["千","せん"],["倍","ばい"],["で"],["あった"],["。"]]},{"verse":12,"text":"彼らは大声で言った。「ほふられた小羊は、力と、富と、知恵と、勢いと、誉れと、栄光と、賛美を受けるにふさわしい方です。」","tok":[["彼","かれ"],["ら"],["は"],["大声","おおごえ"],["で"],["言った","いった"],["。"],["「"],["ほふられた"],["小羊","こひつじ"],["は"],["、"],["力","ちから"],["と"],["、"],["富","とみ"],["と"],["、"],["知恵","ちえ"],["と"],["、"],["勢い","いきおい"],["と"],["、"],["誉れ","ほまれ"],["と"],["、"],["栄光","えいこう"],["と"],["、"],["賛美","さんび"],["を"],["受ける","うける"],["に"],["ふさわしい"],["方","ほう"],["です"],["。"],["」"]]},{"verse":13,"text":"また私は、天と地と、地の下と、海の上のあらゆる造られたもの、およびその中にある生き物がこう言うのを聞いた。「御座にすわる方と、小羊とに、賛美と誉れと栄光と力が永遠にあるように。」","tok":[["また"],["私","わたくし"],["は"],["、"],["天","てん"],["と"],["地","ち"],["と"],["、"],["地","ち"],["の"],["下","した"],["と"],["、"],["海","うみ"],["の"],["上","うえ"],["の"],["あらゆる"],["造られた","つくられた"],["もの"],["、"],["および"],["その"],["中","なか"],["に"],["ある"],["生き物","いきもの"],["が"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["御座","ぎょざ"],["に"],["すわる"],["方","かた"],["と"],["、"],["小羊","こひつじ"],["と"],["に"],["、"],["賛美","さんび"],["と"],["誉れ","ほまれ"],["と"],["栄光","えいこう"],["と"],["力","ちから"],["が"],["永遠","えいえん"],["に"],["ある"],["よう"],["に"],["。"],["」"]]},{"verse":14,"text":"また、四つの生き物はアーメンと言い、長老たちはひれ伏して拝んだ。","tok":[["また"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["は"],["アーメン"],["と"],["言い","いい"],["、"],["長老","ちょうろう"],["たち"],["は"],["ひれ伏して","ひれふして"],["拝んだ","おがんだ"],["。"]]}]
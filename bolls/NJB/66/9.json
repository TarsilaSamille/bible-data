[{"verse":1,"text":"第五の御使いがラッパを吹き鳴らした。すると、私は一つの星が天から地上に落ちるのを見た。その星には底知れぬ穴を開くかぎが与えられた。","tok":[["第","だい"],["五","ご"],["の"],["御使い","おつかい"],["が"],["ラッパ"],["を"],["吹き鳴らした","ふきならした"],["。"],["する"],["と"],["、"],["私","わたくし"],["は"],["一","ひと"],["つ"],["の"],["星","ほし"],["が"],["天","てん"],["から"],["地上","ちじょう"],["に"],["落ちる","おちる"],["の"],["を"],["見た","みた"],["。"],["その"],["星","ほし"],["に"],["は"],["底","そこ"],["知れぬ","しれぬ"],["穴","あな"],["を"],["開く","ひらく"],["かぎ"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":2,"text":"その星が、底知れぬ穴を開くと、穴から大きな炉の煙のような煙が立ち上り、太陽も空も、この穴の煙によって暗くなった。","tok":[["その"],["星","ほし"],["が"],["、"],["底","そこ"],["知れぬ","しれぬ"],["穴","あな"],["を"],["開く","ひらく"],["と"],["、"],["穴","あな"],["から"],["大きな","おおきな"],["炉","ろ"],["の"],["煙","けむり"],["の"],["よう"],["な"],["煙","けむり"],["が"],["立ち上り","たちのぼり"],["、"],["太陽","たいよう"],["も"],["空","そら"],["も"],["、"],["この"],["穴","あな"],["の"],["煙","けむり"],["によって"],["暗く","くらく"],["なった"],["。"]]},{"verse":3,"text":"その煙の中から、いなごが地上に出て来た。彼らには、地のさそりの持つような力が与えられた。","tok":[["その"],["煙","けむり"],["の"],["中","なか"],["から"],["、"],["いなご"],["が"],["地上","ちじょう"],["に"],["出て","でて"],["来た","きた"],["。"],["彼","かれ"],["ら"],["に"],["は"],["、"],["地","ち"],["の"],["さそり"],["の"],["持つ","もつ"],["よう"],["な"],["力","ちから"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":4,"text":"そして彼らは、地の草やすべての青草や、すべての木には害を加えないで、ただ、額に神の印を押されていない人間にだけ害を加えるように言い渡された。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["、"],["地","ち"],["の"],["草","くさ"],["や"],["すべて"],["の"],["青草","あおくさ"],["や"],["、"],["すべて"],["の"],["木","き"],["に"],["は"],["害","がい"],["を"],["加えないで","くわえないで"],["、"],["ただ"],["、"],["額","がく"],["に"],["神","かみ"],["の"],["印","しるし"],["を"],["押されて","おされて"],["いない"],["人間","にんげん"],["に"],["だけ"],["害","がい"],["を"],["加える","くわえる"],["よう"],["に"],["言い渡された","いいわたされた"],["。"]]},{"verse":5,"text":"しかし、人間を殺すことは許されず、ただ五か月の間苦しめることだけが許された。その与えた苦痛は、さそりが人を刺したときのような苦痛であった。","tok":[["しかし"],["、"],["人間","にんげん"],["を"],["殺す","ころす"],["こと"],["は"],["許されず","ゆるされず"],["、"],["ただ"],["五","ご"],["か月","かげつ"],["の"],["間","あいだ"],["苦しめる","くるしめる"],["こと"],["だけ"],["が"],["許された","ゆるされた"],["。"],["その"],["与えた","あたえた"],["苦痛","くつう"],["は"],["、"],["さそり"],["が"],["人","ひと"],["を"],["刺した","さした"],["とき"],["の"],["よう"],["な"],["苦痛","くつう"],["で"],["あった"],["。"]]},{"verse":6,"text":"その期間には、人々は死を求めるが、どうしても見いだせず、死を願うが、死が彼らから逃げて行くのである。","tok":[["その"],["期間","きかん"],["に"],["は"],["、"],["人々","ひとびと"],["は"],["死","し"],["を"],["求める","もとめる"],["が"],["、"],["どう"],["して"],["も"],["見いだせず","みいだせず"],["、"],["死","し"],["を"],["願う","ねがう"],["が"],["、"],["死","し"],["が"],["彼","かれ"],["ら"],["から"],["逃げて","にげて"],["行く","いく"],["ので"],["ある"],["。"]]},{"verse":7,"text":"そのいなごの形は、出陣の用意の整った馬に似ていた。頭に金の冠のようなものを着け、顔は人間の顔のようであった。","tok":[["その"],["いなご"],["の"],["形","かたち"],["は"],["、"],["出陣","しゅつじん"],["の"],["用意","ようい"],["の"],["整った","ととのった"],["馬","うま"],["に"],["似て","にて"],["いた"],["。"],["頭","あたま"],["に"],["金","かね"],["の"],["冠","かんむり"],["の"],["よう"],["な"],["もの"],["を"],["着け","つけ"],["、"],["顔","かお"],["は"],["人間","にんげん"],["の"],["顔","かお"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":8,"text":"また女の髪のような毛があり、歯は、獅子の歯のようであった。","tok":[["また"],["女","おんな"],["の"],["髪","かみ"],["の"],["よう"],["な"],["毛","け"],["が"],["あり"],["、"],["歯","は"],["は"],["、"],["獅子","しし"],["の"],["歯","は"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":9,"text":"また、鉄の胸当てのような胸当てを着け、その翼の音は、多くの馬に引かれた戦車が、戦いに馳せつけるときの響きのようであった。","tok":[["また"],["、"],["鉄","てつ"],["の"],["胸当て","むねあて"],["の"],["よう"],["な"],["胸当て","むねあて"],["を"],["着け","つけ"],["、"],["その"],["翼","つばさ"],["の"],["音","おと"],["は"],["、"],["多く","おおく"],["の"],["馬","うま"],["に"],["引かれた","ひかれた"],["戦車","せんしゃ"],["が"],["、"],["戦い","たたかい"],["に"],["馳せつける","はせつける"],["とき"],["の"],["響き","ひびき"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":10,"text":"そのうえ彼らは、さそりのような尾と針とを持っており、尾には、五か月間人間に害を加える力があった。","tok":[["その"],["うえ"],["彼","かれ"],["ら"],["は"],["、"],["さそり"],["の"],["よう"],["な"],["尾","お"],["と"],["針","はり"],["と"],["を"],["持って","もって"],["おり"],["、"],["尾","お"],["に"],["は"],["、"],["五","ご"],["か月間","かげつかん"],["人間","にんげん"],["に"],["害","がい"],["を"],["加える","くわえる"],["力","ちから"],["が"],["あった"],["。"]]},{"verse":11,"text":"彼らは、底知れぬ所の御使いを王にいただいている。彼の名はヘブル語でアバドンといい、ギリシヤ語でアポリュオンという。","tok":[["彼","かれ"],["ら"],["は"],["、"],["底","そこ"],["知れぬ","しれぬ"],["所","ところ"],["の"],["御使い","おつかい"],["を"],["王","おう"],["に"],["いただいて"],["いる"],["。"],["彼","かれ"],["の"],["名","な"],["は"],["ヘブル"],["語","ご"],["で"],["アバドン"],["と"],["いい"],["、"],["ギリシヤ"],["語","ご"],["で"],["アポリュオン"],["と"],["いう"],["。"]]},{"verse":12,"text":"第一のわざわいは過ぎ去った。見よ。この後なお二つのわざわいが来る。","tok":[["第","だい"],["一","いち"],["の"],["わざわい"],["は"],["過ぎ去った","すぎさった"],["。"],["見","み"],["よ"],["。"],["この"],["後","あと"],["なお"],["二","ふた"],["つ"],["の"],["わざわい"],["が"],["来る","くる"],["。"]]},{"verse":13,"text":"第六の御使いがラッパを吹き鳴らした。すると、私は神の御前にある金の祭壇の四隅から出る声を聞いた。","tok":[["第","だい"],["六","ろく"],["の"],["御使い","おつかい"],["が"],["ラッパ"],["を"],["吹き鳴らした","ふきならした"],["。"],["する"],["と"],["、"],["私","わたくし"],["は"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["ある"],["金","かね"],["の"],["祭壇","さいだん"],["の"],["四隅","よすみ"],["から"],["出る","でる"],["声","こえ"],["を"],["聞いた","きいた"],["。"]]},{"verse":14,"text":"その声がラッパを持っている第六の御使いに言った。「大川ユーフラテスのほとりにつながれている四人の御使いを解き放せ。」","tok":[["その"],["声","こえ"],["が"],["ラッパ"],["を"],["持って","もって"],["いる"],["第","だい"],["六","ろく"],["の"],["御使い","おつかい"],["に"],["言った","いった"],["。"],["「"],["大川","おおかわ"],["ユーフラテス"],["の"],["ほとり"],["に"],["つながれて"],["いる"],["四人","よんにん"],["の"],["御使い","おつかい"],["を"],["解き放せ","ときはなせ"],["。"],["」"]]},{"verse":15,"text":"すると、定められた時、日、月、年のために用意されていた四人の御使いが、人類の三分の一を殺すために解き放された。","tok":[["する"],["と"],["、"],["定められた","さだめられた"],["時","とき"],["、"],["日","ひ"],["、"],["月","つき"],["、"],["年","ねん"],["の"],["ため"],["に"],["用意","ようい"],["されて"],["いた"],["四人","よんにん"],["の"],["御使い","おつかい"],["が"],["、"],["人類","じんるい"],["の"],["三分","さんぶん"],["の"],["一","いち"],["を"],["殺す","ころす"],["ため"],["に"],["解き放された","ときはなされた"],["。"]]},{"verse":16,"text":"騎兵の軍勢の数は二億であった。私はその数を聞いた。","tok":[["騎兵","きへい"],["の"],["軍勢","ぐんぜい"],["の"],["数","かず"],["は"],["二億","におく"],["で"],["あった"],["。"],["私","わたくし"],["は"],["その"],["数","かず"],["を"],["聞いた","きいた"],["。"]]},{"verse":17,"text":"私が幻の中で見た馬とそれに乗る人たちの様子はこうであった。騎兵は、火のような赤、くすぶった青、燃える硫黄の色の胸当てを着けており、馬の頭は、獅子の頭のようで、口からは火と煙と硫黄とが出ていた。","tok":[["私","わたくし"],["が"],["幻","まぼろし"],["の"],["中","なか"],["で"],["見た","みた"],["馬","うま"],["と"],["それ"],["に"],["乗る","のる"],["人","ひと"],["たち"],["の"],["様子","ようす"],["は"],["こう"],["で"],["あった"],["。"],["騎兵","きへい"],["は"],["、"],["火","ひ"],["の"],["よう"],["な"],["赤","あか"],["、"],["くすぶった"],["青","あお"],["、"],["燃える","もえる"],["硫黄","いおう"],["の"],["色","いろ"],["の"],["胸当て","むねあて"],["を"],["着けて","つけて"],["おり"],["、"],["馬","うま"],["の"],["頭","あたま"],["は"],["、"],["獅子","しし"],["の"],["頭","あたま"],["の"],["よう"],["で"],["、"],["口","くち"],["から"],["は"],["火","ひ"],["と"],["煙","けむり"],["と"],["硫黄","いおう"],["と"],["が"],["出て","でて"],["いた"],["。"]]},{"verse":18,"text":"これらの三つの災害、すなわち、彼らの口から出ている火と煙と硫黄とのために、人類の三分の一は殺された。","tok":[["これ"],["ら"],["の"],["三","みっ"],["つ"],["の"],["災害","さいがい"],["、"],["すなわち"],["、"],["彼","かれ"],["ら"],["の"],["口","くち"],["から"],["出て","でて"],["いる"],["火","ひ"],["と"],["煙","けむり"],["と"],["硫黄","いおう"],["と"],["の"],["ため"],["に"],["、"],["人類","じんるい"],["の"],["三分","さんぶん"],["の"],["一","いち"],["は"],["殺された","ころされた"],["。"]]},{"verse":19,"text":"馬の力はその口とその尾とにあって、その尾は蛇のようであり、それに頭があって、その頭で害を加えるのである。","tok":[["馬","うま"],["の"],["力","ちから"],["は"],["その"],["口","くち"],["と"],["その"],["尾","お"],["と"],["に"],["あって"],["、"],["その"],["尾","お"],["は"],["蛇","へび"],["の"],["よう"],["で"],["あり"],["、"],["それ"],["に"],["頭","あたま"],["が"],["あって"],["、"],["その"],["頭","あたま"],["で"],["害","がい"],["を"],["加える","くわえる"],["ので"],["ある"],["。"]]},{"verse":20,"text":"これらの災害によって殺されずに残った人々は、その手のわざを悔い改めないで、悪霊どもや、金、銀、銅、石、木で造られた、見ることも聞くことも歩くこともできない偶像を拝み続け、","tok":[["これ"],["ら"],["の"],["災害","さいがい"],["によって"],["殺されず","ころされず"],["に"],["残った","のこった"],["人々","ひとびと"],["は"],["、"],["その"],["手","て"],["の"],["わざ"],["を"],["悔い改めないで","くいあらためないで"],["、"],["悪霊","あくりょう"],["ども"],["や"],["、"],["金","きん"],["、"],["銀","ぎん"],["、"],["銅","どう"],["、"],["石","いし"],["、"],["木","き"],["で"],["造られた","つくられた"],["、"],["見る","みる"],["こと"],["も"],["聞く","きく"],["こと"],["も"],["歩く","あるく"],["こと"],["も"],["できない"],["偶像","ぐうぞう"],["を"],["拝み","おがみ"],["続け","つづけ"],["、"]]},{"verse":21,"text":"その殺人や、魔術や、不品行や、盗みを悔い改めなかった。","tok":[["その"],["殺人","さつじん"],["や"],["、"],["魔術","まじゅつ"],["や"],["、"],["不品行","ふひんこう"],["や"],["、"],["盗み","ぬすみ"],["を"],["悔い改めなかった","くいあらためなかった"],["。"]]}]
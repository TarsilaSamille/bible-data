[{"verse":1,"text":"また私は見た。見よ。小羊がシオンの山の上に立っていた。また小羊とともに十四万四千人の人たちがいて、その額には小羊の名と、小羊の父の名とがしるしてあった。","tok":[["また"],["私","わたくし"],["は"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["小羊","こひつじ"],["が"],["シオン"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["立って","たって"],["いた"],["。"],["また"],["小羊","こひつじ"],["と"],["とも"],["に"],["十四万四千","じゅうよんまんよんせん"],["人","にん"],["の"],["人","ひと"],["たち"],["が"],["いて"],["、"],["その"],["額","がく"],["に"],["は"],["小羊","こひつじ"],["の"],["名","な"],["と"],["、"],["小羊","こひつじ"],["の"],["父","ちち"],["の"],["名","な"],["と"],["が"],["しるして"],["あった"],["。"]]},{"verse":2,"text":"私は天からの声を聞いた。大水の音のようで、また、激しい雷鳴のようであった。また、私の聞いたその声は、立琴をひく人々が立琴をかき鳴らしている音のようでもあった。","tok":[["私","わたくし"],["は"],["天","てん"],["から"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["大水","おおみず"],["の"],["音","おと"],["の"],["よう"],["で"],["、"],["また"],["、"],["激しい","はげしい"],["雷鳴","らいめい"],["の"],["よう"],["で"],["あった"],["。"],["また"],["、"],["私","わたくし"],["の"],["聞いた","きいた"],["その"],["声","こえ"],["は"],["、"],["立琴","たてごと"],["を"],["ひく"],["人々","ひとびと"],["が"],["立琴","たてごと"],["を"],["かき鳴らして","かきならして"],["いる"],["音","おと"],["の"],["よう"],["で"],["も"],["あった"],["。"]]},{"verse":3,"text":"彼らは、御座の前と、四つの生き物および長老たちの前とで、新しい歌を歌った。しかし地上から贖われた十四万四千人のほかには、だれもこの歌を学ぶことができなかった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["御座","ぎょざ"],["の"],["前","まえ"],["と"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["および"],["長老","ちょうろう"],["たち"],["の"],["前","まえ"],["と"],["で"],["、"],["新しい","あたらしい"],["歌","うた"],["を"],["歌った","うたった"],["。"],["しかし"],["地上","ちじょう"],["から"],["贖われた","あがなわれた"],["十四万四千","じゅうよんまんよんせん"],["人","にん"],["の"],["ほか"],["に"],["は"],["、"],["だれ"],["も"],["この"],["歌","うた"],["を"],["学ぶ","まなぶ"],["こと"],["が"],["できなかった"],["。"]]},{"verse":4,"text":"彼らは女によって汚されたことのない人々である。彼らは童貞なのである。彼らは、小羊が行く所には、どこにでもついて行く。彼らは、神および小羊にささげられる初穂として、人々の中から贖われたのである。","tok":[["彼","かれ"],["ら"],["は"],["女","おんな"],["によって"],["汚された","よごされた"],["こと"],["の"],["ない"],["人々","ひとびと"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["童貞","どうてい"],["な"],["ので"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["小羊","こひつじ"],["が"],["行く","いく"],["所","ところ"],["に"],["は"],["、"],["どこ"],["に"],["で"],["も"],["ついて"],["行く","いく"],["。"],["彼","かれ"],["ら"],["は"],["、"],["神","かみ"],["および"],["小羊","こひつじ"],["に"],["ささげられる"],["初穂","はつほ"],["として"],["、"],["人々","ひとびと"],["の"],["中","なか"],["から"],["贖われた","あがなわれた"],["ので"],["ある"],["。"]]},{"verse":5,"text":"彼らの口には偽りがなかった。彼らは傷のない者である。","tok":[["彼","かれ"],["ら"],["の"],["口","くち"],["に"],["は"],["偽り","いつわり"],["が"],["なかった"],["。"],["彼","かれ"],["ら"],["は"],["傷","きず"],["の"],["ない"],["者","もの"],["で"],["ある"],["。"]]},{"verse":6,"text":"また私は、もうひとりの御使いが中天を飛ぶのを見た。彼は、地上に住む人々、すなわち、あらゆる国民、部族、国語、民族に宣べ伝えるために、永遠の福音を携えていた。","tok":[["また"],["私","わたくし"],["は"],["、"],["もう"],["ひとり"],["の"],["御使い","おつかい"],["が"],["中天","ちゅうてん"],["を"],["飛ぶ","とぶ"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["は"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["人々","ひとびと"],["、"],["すなわち"],["、"],["あらゆる"],["国民","こくみん"],["、"],["部族","ぶぞく"],["、"],["国語","こくご"],["、"],["民族","みんぞく"],["に"],["宣べ伝える","のべつたえる"],["ため"],["に"],["、"],["永遠","えいえん"],["の"],["福音","ふくいん"],["を"],["携えて","たずさえて"],["いた"],["。"]]},{"verse":7,"text":"彼は大声で言った。「神を恐れ、神をあがめよ。神のさばきの時が来たからである。天と地と海と水の源を創造した方を拝め。」","tok":[["彼","かれ"],["は"],["大声","おおごえ"],["で"],["言った","いった"],["。"],["「"],["神","かみ"],["を"],["恐れ","おそれ"],["、"],["神","かみ"],["を"],["あがめよ"],["。"],["神","かみ"],["の"],["さばき"],["の"],["時","とき"],["が"],["来た","きた"],["から"],["で"],["ある"],["。"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["と"],["水","みず"],["の"],["源","みなもと"],["を"],["創造","そうぞう"],["した"],["方","ほう"],["を"],["拝め","おがめ"],["。"],["」"]]},{"verse":8,"text":"また、第二の、別の御使いが続いてやって来て、言った。「大バビロンは倒れた。倒れた。激しい御怒りを引き起こすその不品行のぶどう酒を、すべての国々の民に飲ませた者。」","tok":[["また"],["、"],["第","だい"],["二","に"],["の"],["、"],["別","べつ"],["の"],["御使い","おつかい"],["が"],["続いて","つづいて"],["やって"],["来て","きて"],["、"],["言った","いった"],["。"],["「"],["大","だい"],["バビロン"],["は"],["倒れた","たおれた"],["。"],["倒れた","たおれた"],["。"],["激しい","はげしい"],["御怒り","おいかり"],["を"],["引き起こす","ひきおこす"],["その"],["不品行","ふひんこう"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["に"],["飲ませた","のませた"],["者","もの"],["。"],["」"]]},{"verse":9,"text":"また、第三の、別の御使いも、彼らに続いてやって来て、大声で言った。「もし、だれでも、獣とその像を拝み、自分の額か手かに刻印を受けるなら、","tok":[["また"],["、"],["第","だい"],["三","さん"],["の"],["、"],["別","べつ"],["の"],["御使い","おつかい"],["も"],["、"],["彼","かれ"],["ら"],["に"],["続いて","つづいて"],["やって"],["来て","きて"],["、"],["大声","おおごえ"],["で"],["言った","いった"],["。"],["「"],["もし"],["、"],["だれ"],["で"],["も"],["、"],["獣","けもの"],["と"],["その"],["像","ぞう"],["を"],["拝み","おがみ"],["、"],["自分","じぶん"],["の"],["額","がく"],["か"],["手","て"],["か"],["に"],["刻印","こくいん"],["を"],["受けるなら","うけるなら"],["、"]]},{"verse":10,"text":"そのような者は、神の怒りの杯に混ぜ物なしに注がれた神の怒りのぶどう酒を飲む。また、聖なる御使いたちと小羊との前で、火と硫黄とで苦しめられる。","tok":[["その"],["よう"],["な"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["怒り","いかり"],["の"],["杯","さかずき"],["に"],["混ぜ物","まぜもの"],["なし"],["に"],["注がれた","そそがれた"],["神","かみ"],["の"],["怒り","いかり"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["飲む","のむ"],["。"],["また"],["、"],["聖","せい"],["なる"],["御使い","おつかい"],["たち"],["と"],["小羊","こひつじ"],["と"],["の"],["前","まえ"],["で"],["、"],["火","ひ"],["と"],["硫黄","いおう"],["と"],["で"],["苦しめられる","くるしめられる"],["。"]]},{"verse":11,"text":"そして、彼らの苦しみの煙は、永遠にまでも立ち上る。獣とその像とを拝む者、まただれでも獣の名の刻印を受ける者は、昼も夜も休みを得ない。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["の"],["苦しみ","くるしみ"],["の"],["煙","けむり"],["は"],["、"],["永遠","えいえん"],["に"],["まで"],["も"],["立ち上る","たちのぼる"],["。"],["獣","けもの"],["と"],["その"],["像","ぞう"],["と"],["を"],["拝む","おがむ"],["者","もの"],["、"],["また"],["だれ"],["で"],["も"],["獣","けもの"],["の"],["名","な"],["の"],["刻印","こくいん"],["を"],["受ける","うける"],["者","もの"],["は"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["休み","やすみ"],["を"],["得ない","えない"],["。"]]},{"verse":12,"text":"神の戒めを守り、イエスに対する信仰を持ち続ける聖徒たちの忍耐はここにある。」","tok":[["神","かみ"],["の"],["戒め","いましめ"],["を"],["守り","まもり"],["、"],["イエス"],["に"],["対する","たいする"],["信仰","しんこう"],["を"],["持ち","もち"],["続ける","つづける"],["聖徒","せいと"],["たち"],["の"],["忍耐","にんたい"],["は"],["ここ"],["に"],["ある"],["。"],["」"]]},{"verse":13,"text":"また私は、天からこう言っている声を聞いた。「書きしるせ。『今から後、主にあって死ぬ死者は幸いである。』」御霊も言われる。「しかり。彼らはその労苦から解き放されて休むことができる。彼らの行いは彼らについて行くからである。」","tok":[["また"],["私","わたくし"],["は"],["、"],["天","てん"],["から"],["こう"],["言って","いって"],["いる"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["「"],["書きしるせ","かきしるせ"],["。"],["『"],["今","いま"],["から"],["後","あと"],["、"],["主に","おもに"],["あって"],["死ぬ","しぬ"],["死者","ししゃ"],["は"],["幸い","さいわい"],["で"],["ある"],["。"],["』"],["」"],["御霊","ごれい"],["も"],["言われる","いわれる"],["。"],["「"],["しかり"],["。"],["彼","かれ"],["ら"],["は"],["その"],["労苦","ろうく"],["から"],["解き放されて","ときはなされて"],["休む","やすむ"],["こと"],["が"],["できる"],["。"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["は"],["彼","かれ"],["ら"],["について"],["行く","いく"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":14,"text":"また、私は見た。見よ。白い雲が起こり、その雲に人の子のような方が乗っておられた。頭には金の冠をかぶり、手には鋭いかまを持っておられた。","tok":[["また"],["、"],["私","わたくし"],["は"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["白い","しろい"],["雲","くも"],["が"],["起こり","おこり"],["、"],["その"],["雲","くも"],["に"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["な"],["方","ほう"],["が"],["乗って","のって"],["おられた"],["。"],["頭","あたま"],["に"],["は"],["金","きん"],["の"],["冠","かんむり"],["を"],["かぶり"],["、"],["手","て"],["に"],["は"],["鋭い","するどい"],["かま"],["を"],["持って","もって"],["おられた"],["。"]]},{"verse":15,"text":"すると、もうひとりの御使いが聖所から出て来て、雲に乗っておられる方に向かって大声で叫んだ。「かまを入れて刈り取ってください。地の穀物は実ったので、取り入れる時が来ましたから。」","tok":[["する"],["と"],["、"],["もう"],["ひとり"],["の"],["御使い","おつかい"],["が"],["聖","せい"],["所","しょ"],["から"],["出て","でて"],["来て","きて"],["、"],["雲","くも"],["に"],["乗って","のって"],["おられる"],["方","かた"],["に"],["向かって","むかって"],["大声","おおごえ"],["で"],["叫んだ","さけんだ"],["。"],["「"],["かま"],["を"],["入れて","いれて"],["刈り取って","かりとって"],["ください"],["。"],["地","ち"],["の"],["穀物","こくもつ"],["は"],["実った","みのった"],["ので"],["、"],["取り入れる","とりいれる"],["時","とき"],["が"],["来ました","きました"],["から"],["。"],["」"]]},{"verse":16,"text":"そこで、雲に乗っておられる方が、地にかまを入れると地は刈り取られた。","tok":[["そこ"],["で"],["、"],["雲","くも"],["に"],["乗って","のって"],["おられる"],["方","ほう"],["が"],["、"],["地","ち"],["に"],["かま"],["を"],["入れる","いれる"],["と"],["地","ち"],["は"],["刈り取られた","かりとられた"],["。"]]},{"verse":17,"text":"また、もうひとりの御使いが、天の聖所から出て来たが、この御使いも、鋭いかまを持っていた。","tok":[["また"],["、"],["もう"],["ひとり"],["の"],["御使い","おつかい"],["が"],["、"],["天","てん"],["の"],["聖","せい"],["所","しょ"],["から"],["出て","でて"],["来た","きた"],["が"],["、"],["この"],["御使い","おつかい"],["も"],["、"],["鋭い","するどい"],["かま"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":18,"text":"すると、火を支配する権威を持ったもうひとりの御使いが、祭壇から出て来て、鋭いかまを持つ御使いに大声で叫んで言った。「その鋭いかまを入れ、地のぶどうのふさを刈り集めよ。ぶどうはすでに熟しているのだから。」","tok":[["する"],["と"],["、"],["火","ひ"],["を"],["支配","しはい"],["する"],["権威","けんい"],["を"],["持った","もった"],["もう"],["ひとり"],["の"],["御使い","おつかい"],["が"],["、"],["祭壇","さいだん"],["から"],["出て","でて"],["来て","きて"],["、"],["鋭い","するどい"],["かま"],["を"],["持つ","もつ"],["御使い","おつかい"],["に"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["その"],["鋭い","するどい"],["かま"],["を"],["入れ","いれ"],["、"],["地","ち"],["の"],["ぶどう"],["の"],["ふさ"],["を"],["刈り集めよ","かりあつめよ"],["。"],["ぶどう"],["は"],["すでに"],["熟して","じゅくして"],["いる"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":19,"text":"そこで御使いは地にかまを入れ、地のぶどうを刈り集めて、神の激しい怒りの大きな酒ぶねに投げ入れた。","tok":[["そこ"],["で"],["御使い","おつかい"],["は"],["地","ち"],["に"],["かま"],["を"],["入れ","いれ"],["、"],["地","ち"],["の"],["ぶどう"],["を"],["刈り集めて","かりあつめて"],["、"],["神","かみ"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["大きな","おおきな"],["酒","さけ"],["ぶね"],["に"],["投げ入れた","なげいれた"],["。"]]},{"verse":20,"text":"その酒ぶねは都の外で踏まれたが、血は、その酒ぶねから流れ出て、馬のくつわに届くほどになり、千六百スタディオンに広がった。","tok":[["その"],["酒","さけ"],["ぶね"],["は"],["都","と"],["の"],["外","そと"],["で"],["踏まれた","ふまれた"],["が"],["、"],["血","ち"],["は"],["、"],["その"],["酒","さけ"],["ぶね"],["から"],["流れ出て","ながれでて"],["、"],["馬","うま"],["の"],["くつわ"],["に"],["届く","とどく"],["ほど"],["に"],["なり"],["、"],["千六百","せんろくひゃく"],["スタディオン"],["に"],["広がった","ひろがった"],["。"]]}]
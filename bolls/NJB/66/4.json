[{"verse":1,"text":"その後、私は見た。見よ。天に一つの開いた門があった。また、先にラッパのような声で私に呼びかけるのが聞こえたあの初めの声が言った。「ここに上れ。この後、必ず起こる事をあなたに示そう。」","tok":[["その"],["後","ご"],["、"],["私","わたくし"],["は"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["天","てん"],["に"],["一","ひと"],["つ"],["の"],["開いた","ひらいた"],["門","もん"],["が"],["あった"],["。"],["また"],["、"],["先","さき"],["に"],["ラッパ"],["の"],["よう"],["な"],["声","こえ"],["で"],["私","わたくし"],["に"],["呼びかける","よびかける"],["の"],["が"],["聞こえた","きこえた"],["あの"],["初め","はじめ"],["の"],["声","こえ"],["が"],["言った","いった"],["。"],["「"],["ここ"],["に"],["上れ","のぼれ"],["。"],["この"],["後","ご"],["、"],["必ず","かならず"],["起こる","おこる"],["事","こと"],["を"],["あなた"],["に"],["示そう","しめそう"],["。"],["」"]]},{"verse":2,"text":"たちまち私は御霊に感じた。すると見よ。天に一つの御座があり、その御座に着いている方があり、","tok":[["たちまち"],["私","わたくし"],["は"],["御霊","ごれい"],["に"],["感じた","かんじた"],["。"],["する"],["と"],["見よ","みよ"],["。"],["天","てん"],["に"],["一","ひと"],["つ"],["の"],["御座","ぎょざ"],["が"],["あり"],["、"],["その"],["御座","ぎょざ"],["に"],["着いて","ついて"],["いる"],["方","ほう"],["が"],["あり"],["、"]]},{"verse":3,"text":"その方は、碧玉や赤めのうのように見え、その御座の回りには、緑玉のように見える虹があった。","tok":[["その"],["方","かた"],["は"],["、"],["碧玉","へきぎょく"],["や"],["赤","あか"],["めのう"],["の"],["よう"],["に"],["見え","みえ"],["、"],["その"],["御座","ぎょざ"],["の"],["回り","まわり"],["に"],["は"],["、"],["緑玉","りょくぎょく"],["の"],["よう"],["に"],["見える","みえる"],["虹","にじ"],["が"],["あった"],["。"]]},{"verse":4,"text":"また、御座の回りに二十四の座があった。これらの座には、白い衣を着て、金の冠を頭にかぶった二十四人の長老たちがすわっていた。","tok":[["また"],["、"],["御座","ぎょざ"],["の"],["回り","まわり"],["に"],["二十四","にじゅうよん"],["の"],["座","ざ"],["が"],["あった"],["。"],["これ"],["ら"],["の"],["座","ざ"],["に"],["は"],["、"],["白い","しろい"],["衣","ころも"],["を"],["着て","きて"],["、"],["金","きん"],["の"],["冠","かんむり"],["を"],["頭","あたま"],["に"],["かぶった"],["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["たち"],["が"],["すわって"],["いた"],["。"]]},{"verse":5,"text":"御座からいなずまと声と雷鳴が起こった。七つのともしびが御座の前で燃えていた。神の七つの御霊である。","tok":[["御座","ぎょざ"],["から"],["いなずま"],["と"],["声","こえ"],["と"],["雷鳴","らいめい"],["が"],["起こった","おこった"],["。"],["七","なな"],["つ"],["の"],["ともしび"],["が"],["御座","ぎょざ"],["の"],["前","まえ"],["で"],["燃えて","もえて"],["いた"],["。"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["御霊","ごれい"],["で"],["ある"],["。"]]},{"verse":6,"text":"御座の前は、水晶に似たガラスの海のようであった。御座の中央と御座の回りに、前もうしろも目で満ちた四つの生き物がいた。","tok":[["御座","ぎょざ"],["の"],["前","まえ"],["は"],["、"],["水晶","すいしょう"],["に"],["似た","にた"],["ガラス"],["の"],["海","うみ"],["の"],["よう"],["で"],["あった"],["。"],["御座","ぎょざ"],["の"],["中央","ちゅうおう"],["と"],["御座","ぎょざ"],["の"],["回り","まわり"],["に"],["、"],["前","まえ"],["も"],["うしろ"],["も"],["目","め"],["で"],["満ちた","みちた"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["が"],["いた"],["。"]]},{"verse":7,"text":"第一の生き物は、獅子のようであり、第二の生き物は雄牛のようであり、第三の生き物は人間のような顔を持ち、第四の生き物は空飛ぶ鷲のようであった。","tok":[["第","だい"],["一","いち"],["の"],["生き物","いきもの"],["は"],["、"],["獅子","しし"],["の"],["よう"],["で"],["あり"],["、"],["第","だい"],["二","に"],["の"],["生き物","いきもの"],["は"],["雄牛","おうし"],["の"],["よう"],["で"],["あり"],["、"],["第","だい"],["三","さん"],["の"],["生き物","いきもの"],["は"],["人間","にんげん"],["の"],["よう"],["な"],["顔","かお"],["を"],["持ち","もち"],["、"],["第","だい"],["四","よん"],["の"],["生き物","いきもの"],["は"],["空","そら"],["飛ぶ","とぶ"],["鷲","わし"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":8,"text":"この四つの生き物には、それぞれ六つの翼があり、その回りも内側も目で満ちていた。彼らは、昼も夜も絶え間なく叫び続けた。「聖なるかな、聖なるかな、聖なるかな。神であられる主、万物の支配者、昔いまし、今いまし、後に来られる方。」","tok":[["この"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["に"],["は"],["、"],["それぞれ"],["六","むい"],["つ"],["の"],["翼","つばさ"],["が"],["あり"],["、"],["その"],["回り","まわり"],["も"],["内側","うちがわ"],["も"],["目","め"],["で"],["満ちて","みちて"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["絶え間","たえま"],["なく"],["叫び","さけび"],["続けた","つづけた"],["。"],["「"],["聖","せい"],["なる"],["か"],["な"],["、"],["聖","せい"],["なる"],["か"],["な"],["、"],["聖","せい"],["なる"],["か"],["な"],["。"],["神","かみ"],["で"],["あられる"],["主","ぬし"],["、"],["万物","ばんぶつ"],["の"],["支配者","しはいしゃ"],["、"],["昔","むかし"],["いまし"],["、"],["今","いま"],["いまし"],["、"],["後","あと"],["に"],["来られる","こられる"],["方","かた"],["。"],["」"]]},{"verse":9,"text":"また、これらの生き物が、永遠に生きておられる、御座に着いている方に、栄光、誉れ、感謝をささげるとき、","tok":[["また"],["、"],["これ"],["ら"],["の"],["生き物","いきもの"],["が"],["、"],["永遠","えいえん"],["に"],["生きて","いきて"],["おられる"],["、"],["御座","ぎょざ"],["に"],["着いて","ついて"],["いる"],["方","かた"],["に"],["、"],["栄光","えいこう"],["、"],["誉れ","ほまれ"],["、"],["感謝","かんしゃ"],["を"],["ささげる"],["とき"],["、"]]},{"verse":10,"text":"二十四人の長老は御座に着いている方の御前にひれ伏して、永遠に生きておられる方を拝み、自分の冠を御座の前に投げ出して言った。","tok":[["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["は"],["御座","ぎょざ"],["に"],["着いて","ついて"],["いる"],["方","かた"],["の"],["御前","ごぜん"],["に"],["ひれ伏して","ひれふして"],["、"],["永遠","えいえん"],["に"],["生きて","いきて"],["おられる"],["方","かた"],["を"],["拝み","おがみ"],["、"],["自分","じぶん"],["の"],["冠","かんむり"],["を"],["御座","ぎょざ"],["の"],["前","まえ"],["に"],["投げ出して","なげだして"],["言った","いった"],["。"]]},{"verse":11,"text":"「主よ。われらの神よ。あなたは、栄光と誉れと力とを受けるにふさわしい方です。あなたは万物を創造し、あなたのみこころゆえに、万物は存在し、また創造されたのですから。」","tok":[["「"],["主","ぬし"],["よ"],["。"],["われ"],["ら"],["の"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["、"],["栄光","えいこう"],["と"],["誉れ","ほまれ"],["と"],["力","ちから"],["と"],["を"],["受ける","うける"],["に"],["ふさわしい"],["方","ほう"],["です"],["。"],["あなた"],["は"],["万物","ばんぶつ"],["を"],["創造","そうぞう"],["し"],["、"],["あなた"],["のみ"],["こころ"],["ゆえ"],["に"],["、"],["万物","ばんぶつ"],["は"],["存在","そんざい"],["し"],["、"],["また"],["創造","そうぞう"],["された"],["の"],["です"],["から"],["。"],["」"]]}]
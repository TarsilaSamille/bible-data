[{"verse":1,"text":"また、私は見た。小羊が七つの封印の一つを解いたとき、四つの生き物の一つが、雷のような声で「来なさい」と言うのを私は聞いた。","tok":[["また"],["、"],["私","わたくし"],["は"],["見た","みた"],["。"],["小羊","こひつじ"],["が"],["七","なな"],["つ"],["の"],["封印","ふういん"],["の"],["一","ひと"],["つ"],["を"],["解いた","といた"],["とき"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["の"],["一","ひと"],["つ"],["が"],["、"],["雷","かみなり"],["の"],["よう"],["な"],["声","こえ"],["で"],["「"],["来","き"],["なさい"],["」"],["と"],["言う","いう"],["の"],["を"],["私","わたくし"],["は"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"私は見た。見よ。白い馬であった。それに乗っている者は弓を持っていた。彼は冠を与えられ、勝利の上にさらに勝利を得ようとして出て行った。","tok":[["私","わたくし"],["は"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["白い","しろい"],["馬","うま"],["で"],["あった"],["。"],["それ"],["に"],["乗って","のって"],["いる"],["者","もの"],["は"],["弓","ゆみ"],["を"],["持って","もって"],["いた"],["。"],["彼","かれ"],["は"],["冠","かんむり"],["を"],["与えられ","あたえられ"],["、"],["勝利","しょうり"],["の"],["上","うえ"],["に"],["さらに"],["勝利","しょうり"],["を"],["得よう","えよう"],["として"],["出て","でて"],["行った","いった"],["。"]]},{"verse":3,"text":"小羊が第二の封印を解いたとき、私は、第二の生き物が、「来なさい」と言うのを聞いた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["二","に"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["とき"],["、"],["私","わたくし"],["は"],["、"],["第","だい"],["二","に"],["の"],["生き物","いきもの"],["が"],["、"],["「"],["来","き"],["なさい"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":4,"text":"すると、別の、火のように赤い馬が出て来た。これに乗っている者は、地上から平和を奪い取ることが許された。人々が、互いに殺し合うようになるためであった。また、彼に大きな剣が与えられた。","tok":[["する"],["と"],["、"],["別","べつ"],["の"],["、"],["火","ひ"],["の"],["よう"],["に"],["赤い","あかい"],["馬","うま"],["が"],["出て","でて"],["来た","きた"],["。"],["これ"],["に"],["乗って","のって"],["いる"],["者","もの"],["は"],["、"],["地上","ちじょう"],["から"],["平和","へいわ"],["を"],["奪い取る","うばいとる"],["こと"],["が"],["許された","ゆるされた"],["。"],["人々","ひとびと"],["が"],["、"],["互い","たがい"],["に"],["殺し合う","ころしあう"],["よう"],["に"],["なる"],["ため"],["で"],["あった"],["。"],["また"],["、"],["彼","かれ"],["に"],["大きな","おおきな"],["剣","けん"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":5,"text":"小羊が第三の封印を解いたとき、私は、第三の生き物が、「来なさい」と言うのを聞いた。私は見た。見よ。黒い馬であった。これに乗っている者は量りを手に持っていた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["三","さん"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["とき"],["、"],["私","わたくし"],["は"],["、"],["第","だい"],["三","さん"],["の"],["生き物","いきもの"],["が"],["、"],["「"],["来","き"],["なさい"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["私","わたくし"],["は"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["黒い","くろい"],["馬","うま"],["で"],["あった"],["。"],["これ"],["に"],["乗って","のって"],["いる"],["者","もの"],["は"],["量り","はかり"],["を"],["手","て"],["に"],["持って","もって"],["いた"],["。"]]},{"verse":6,"text":"すると私は、一つの声のようなものが、四つの生き物の間で、こう言うのを聞いた。「小麦一枡は一デナリ。大麦三枡も一デナリ。オリーブ油とぶどう酒に害を与えてはいけない。」","tok":[["する"],["と"],["私","わたくし"],["は"],["、"],["一","ひと"],["つ"],["の"],["声","こえ"],["の"],["よう"],["な"],["もの"],["が"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["の"],["間","あいだ"],["で"],["、"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["小麦","こむぎ"],["一","ひと"],["枡","ます"],["は"],["一","いち"],["デナリ"],["。"],["大麦","おおむぎ"],["三枡","みます"],["も"],["一","いち"],["デナリ"],["。"],["オリーブ油","おりーぶゆ"],["と"],["ぶどう酒","ぶどうしゅ"],["に"],["害","がい"],["を"],["与えて","あたえて"],["は"],["いけない"],["。"],["」"]]},{"verse":7,"text":"小羊が第四の封印を解いたとき、私は、第四の生き物の声が、「来なさい」と言うのを聞いた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["四","よん"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["とき"],["、"],["私","わたくし"],["は"],["、"],["第","だい"],["四","よん"],["の"],["生き物","いきもの"],["の"],["声","こえ"],["が"],["、"],["「"],["来","き"],["なさい"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":8,"text":"私は見た。見よ。青ざめた馬であった。これに乗っている者の名は死といい、そのあとにはハデスがつき従った。彼らに地上の四分の一を剣とききんと死病と地上の獣によって殺す権威が与えられた。","tok":[["私","わたくし"],["は"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["青ざめた","あおざめた"],["馬","うま"],["で"],["あった"],["。"],["これ"],["に"],["乗って","のって"],["いる"],["者","もの"],["の"],["名","な"],["は"],["死","し"],["と"],["いい"],["、"],["その"],["あと"],["に"],["は"],["ハデス"],["が"],["つき従った","つきしたがった"],["。"],["彼","かれ"],["ら"],["に"],["地上","ちじょう"],["の"],["四分","よんぶん"],["の"],["一","いち"],["を"],["剣","けん"],["と"],["ききん"],["と"],["死病","しびょう"],["と"],["地上","ちじょう"],["の"],["獣","けもの"],["によって"],["殺す","ころす"],["権威","けんい"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":9,"text":"小羊が第五の封印を解いたとき、私は、神のことばと、自分たちが立てたあかしとのために殺された人々のたましいが祭壇の下にいるのを見た。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["五","ご"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["とき"],["、"],["私","わたくし"],["は"],["、"],["神","かみ"],["の"],["ことば"],["と"],["、"],["自分","じぶん"],["たち"],["が"],["立てた","たてた"],["あかし"],["と"],["の"],["ため"],["に"],["殺された","ころされた"],["人々","ひとびと"],["の"],["たましい"],["が"],["祭壇","さいだん"],["の"],["下","した"],["に"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":10,"text":"彼らは大声で叫んで言った。「聖なる、真実な主よ。いつまでさばきを行わず、地に住む者に私たちの血の復讐をなさらないのですか。」","tok":[["彼","かれ"],["ら"],["は"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["聖","せい"],["なる"],["、"],["真実","しんじつ"],["な"],["主","ぬし"],["よ"],["。"],["いつ"],["まで"],["さばき"],["を"],["行わず","おこなわず"],["、"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["に"],["私たち","わたしたち"],["の"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["なさらない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":11,"text":"すると、彼らのひとりひとりに白い衣が与えられた。そして彼らは、「あなたがたと同じしもべ、また兄弟たちで、あなたがたと同じように殺されるはずの人々の数が満ちるまで、もうしばらくの間、休んでいなさい」と言い渡された。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["の"],["ひとりひとり"],["に"],["白い","しろい"],["衣","ころも"],["が"],["与えられた","あたえられた"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["、"],["「"],["あなた"],["がた"],["と"],["同じ","おなじ"],["しもべ"],["、"],["また"],["兄弟","きょうだい"],["たち"],["で"],["、"],["あなた"],["がた"],["と"],["同じ","おなじ"],["よう"],["に"],["殺される","ころされる"],["はず"],["の"],["人々","ひとびと"],["の"],["数","かず"],["が"],["満ちる","みちる"],["まで"],["、"],["もう"],["しばらく"],["の"],["間","あいだ"],["、"],["休んで","やすんで"],["い"],["なさい"],["」"],["と"],["言い渡された","いいわたされた"],["。"]]},{"verse":12,"text":"私は見た。小羊が第六の封印を解いたとき、大きな地震が起こった。そして、太陽は毛の荒布のように黒くなり、月の全面が血のようになった。","tok":[["私","わたくし"],["は"],["見た","みた"],["。"],["小羊","こひつじ"],["が"],["第","だい"],["六","ろく"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["とき"],["、"],["大きな","おおきな"],["地震","じしん"],["が"],["起こった","おこった"],["。"],["そして"],["、"],["太陽","たいよう"],["は"],["毛","け"],["の"],["荒布","あらめ"],["の"],["よう"],["に"],["黒く","くろく"],["なり"],["、"],["月","つき"],["の"],["全面","ぜんめん"],["が"],["血","ち"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":13,"text":"そして天の星が地上に落ちた。それは、いちじくが、大風に揺られて、青い実を振り落とすようであった。","tok":[["そして"],["天","てん"],["の"],["星","ほし"],["が"],["地上","ちじょう"],["に"],["落ちた","おちた"],["。"],["それ"],["は"],["、"],["いちじく"],["が"],["、"],["大風","おおふう"],["に"],["揺られて","ゆられて"],["、"],["青い","あおい"],["実","じつ"],["を"],["振り落とす","ふりおとす"],["よう"],["で"],["あった"],["。"]]},{"verse":14,"text":"天は、巻き物が巻かれるように消えてなくなり、すべての山や島がその場所から移された。","tok":[["天","てん"],["は"],["、"],["巻き物","まきもの"],["が"],["巻かれる","まかれる"],["よう"],["に"],["消えて","きえて"],["なくなり"],["、"],["すべて"],["の"],["山","やま"],["や"],["島","しま"],["が"],["その"],["場所","ばしょ"],["から"],["移された","うつされた"],["。"]]},{"verse":15,"text":"地上の王、高官、千人隊長、金持ち、勇者、あらゆる奴隷と自由人が、ほら穴と山の岩間に隠れ、","tok":[["地上","ちじょう"],["の"],["王","おう"],["、"],["高官","こうかん"],["、"],["千人","せんにん"],["隊長","たいちょう"],["、"],["金持ち","かねもち"],["、"],["勇者","ゆうしゃ"],["、"],["あらゆる"],["奴隷","どれい"],["と"],["自由人","じゆうにん"],["が"],["、"],["ほら穴","ほらあな"],["と"],["山","やま"],["の"],["岩間","いわま"],["に"],["隠れ","かくれ"],["、"]]},{"verse":16,"text":"山や岩に向かってこう言った。「私たちの上に倒れかかって、御座にある方の御顔と小羊の怒りとから、私たちをかくまってくれ。","tok":[["山","やま"],["や"],["岩","いわ"],["に"],["向かって","むかって"],["こう"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["倒れかかって","たおれかかって"],["、"],["御座","ぎょざ"],["に"],["ある"],["方","かた"],["の"],["御顔","おかお"],["と"],["小羊","こひつじ"],["の"],["怒り","いかり"],["と"],["から"],["、"],["私たち","わたしたち"],["を"],["かくまって"],["くれ"],["。"]]},{"verse":17,"text":"御怒りの大いなる日が来たのだ。だれがそれに耐えられよう。」","tok":[["御怒り","おいかり"],["の"],["大いなる","おおいなる"],["日","ひ"],["が"],["来た","きた"],["の"],["だ"],["。"],["だれ"],["が"],["それ"],["に"],["耐えられよう","たえられよう"],["。"],["」"]]}]
[{"verse":1,"text":"また私は、もうひとりの強い御使いが、雲に包まれて、天から降りて来るのを見た。その頭上には虹があって、その顔は太陽のようであり、その足は火の柱のようであった。","tok":[["また"],["私","わたくし"],["は"],["、"],["もう"],["ひとり"],["の"],["強い","つよい"],["御使い","おつかい"],["が"],["、"],["雲","くも"],["に"],["包まれて","つつまれて"],["、"],["天","てん"],["から"],["降りて","おりて"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["その"],["頭上","ずじょう"],["に"],["は"],["虹","にじ"],["が"],["あって"],["、"],["その"],["顔","かお"],["は"],["太陽","たいよう"],["の"],["よう"],["で"],["あり"],["、"],["その"],["足","あし"],["は"],["火","ひ"],["の"],["柱","はしら"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":2,"text":"その手には開かれた小さな巻き物を持ち、右足は海の上に、左足は地の上に置き、","tok":[["その"],["手","て"],["に"],["は"],["開かれた","ひらかれた"],["小さな","ちいさな"],["巻き物","まきもの"],["を"],["持ち","もち"],["、"],["右足","みぎあし"],["は"],["海","うみ"],["の"],["上","うえ"],["に"],["、"],["左足","ひだりあし"],["は"],["地","ち"],["の"],["上","うえ"],["に"],["置き","おき"],["、"]]},{"verse":3,"text":"獅子がほえるときのように大声で叫んだ。彼が叫んだとき、七つの雷がおのおの声を出した。","tok":[["獅子","しし"],["が"],["ほえる"],["とき"],["の"],["よう"],["に"],["大声","おおごえ"],["で"],["叫んだ","さけんだ"],["。"],["彼","かれ"],["が"],["叫んだ","さけんだ"],["とき"],["、"],["七","なな"],["つ"],["の"],["雷","かみなり"],["が"],["おのおの"],["声","こえ"],["を"],["出した","だした"],["。"]]},{"verse":4,"text":"七つの雷が語ったとき、私は書き留めようとした。すると、天から声があって、「七つの雷が言ったことは封じて、書きしるすな」と言うのを聞いた。","tok":[["七","なな"],["つ"],["の"],["雷","かみなり"],["が"],["語った","かたった"],["とき"],["、"],["私","わたくし"],["は"],["書き留めよう","かきとめよう"],["と"],["した"],["。"],["する"],["と"],["、"],["天","てん"],["から"],["声","こえ"],["が"],["あって"],["、"],["「"],["七","なな"],["つ"],["の"],["雷","かみなり"],["が"],["言った","いった"],["こと"],["は"],["封じて","ふうじて"],["、"],["書きしるす","かきしるす"],["な"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":5,"text":"それから、私の見た海と地との上に立つ御使いは、右手を天に上げて、","tok":[["それ"],["から"],["、"],["私","わたくし"],["の"],["見た","みた"],["海","うみ"],["と"],["地","ち"],["と"],["の"],["上","うえ"],["に"],["立つ","たつ"],["御使い","おつかい"],["は"],["、"],["右手","みぎて"],["を"],["天","てん"],["に"],["上げて","あげて"],["、"]]},{"verse":6,"text":"永遠に生き、天とその中にあるもの、地とその中にあるもの、海とその中にあるものを創造された方をさして、誓った。「もはや時が延ばされることはない。","tok":[["永遠","えいえん"],["に"],["生き","いき"],["、"],["天","てん"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["、"],["地","ち"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["、"],["海","うみ"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["を"],["創造","そうぞう"],["された"],["方","ほう"],["を"],["さして"],["、"],["誓った","ちかった"],["。"],["「"],["もはや"],["時","とき"],["が"],["延ばされる","のばされる"],["こと"],["は"],["ない"],["。"]]},{"verse":7,"text":"第七の御使いが吹き鳴らそうとしているラッパの音が響くその日には、神の奥義は、神がご自身のしもべである預言者たちに告げられたとおりに成就する。」","tok":[["第","だい"],["七","なな"],["の"],["御使い","おつかい"],["が"],["吹き鳴らそう","ふきならそう"],["として"],["いる"],["ラッパ"],["の"],["音","おと"],["が"],["響く","ひびく"],["その"],["日","ひ"],["に"],["は"],["、"],["神","かみ"],["の"],["奥義","おうぎ"],["は"],["、"],["神","かみ"],["が"],["ご自身","ごじしん"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["に"],["告げられた","つげられた"],["とおり"],["に"],["成就","じょうじゅ"],["する"],["。"],["」"]]},{"verse":8,"text":"それから、前に私が天から聞いた声が、また私に話しかけて言った。「さあ行って、海と地との上に立っている御使いの手にある、開かれた巻き物を受け取りなさい。」","tok":[["それ"],["から"],["、"],["前","まえ"],["に"],["私","わたくし"],["が"],["天","てん"],["から"],["聞いた","きいた"],["声","こえ"],["が"],["、"],["また"],["私","わたくし"],["に"],["話しかけて","はなしかけて"],["言った","いった"],["。"],["「"],["さあ"],["行って","いって"],["、"],["海","うみ"],["と"],["地","ち"],["と"],["の"],["上","うえ"],["に"],["立って","たって"],["いる"],["御使い","おつかい"],["の"],["手","て"],["に"],["ある"],["、"],["開かれた","ひらかれた"],["巻き物","まきもの"],["を"],["受け取り","うけとり"],["なさい"],["。"],["」"]]},{"verse":9,"text":"それで、私は御使いのところに行って、「その小さな巻き物を下さい」と言った。すると、彼は言った。「それを取って食べなさい。それはあなたの腹には苦いが、あなたの口には蜜のように甘い。」","tok":[["それ"],["で"],["、"],["私","わたくし"],["は"],["御使い","おつかい"],["の"],["ところ"],["に"],["行って","いって"],["、"],["「"],["その"],["小さな","ちいさな"],["巻き物","まきもの"],["を"],["下さい","ください"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["それ"],["を"],["取って","とって"],["食べ","たべ"],["なさい"],["。"],["それ"],["は"],["あなた"],["の"],["腹","はら"],["に"],["は"],["苦い","にがい"],["が"],["、"],["あなた"],["の"],["口","くち"],["に"],["は"],["蜜","みつ"],["の"],["よう"],["に"],["甘い","あまい"],["。"],["」"]]},{"verse":10,"text":"そこで、私は御使いの手からその小さな巻き物を取って食べた。すると、それは口には蜜のように甘かった。それを食べてしまうと、私の腹は苦くなった。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["御使い","おつかい"],["の"],["手","て"],["から"],["その"],["小さな","ちいさな"],["巻き物","まきもの"],["を"],["取って","とって"],["食べた","たべた"],["。"],["する"],["と"],["、"],["それ"],["は"],["口","くち"],["に"],["は"],["蜜","みつ"],["の"],["よう"],["に"],["甘かった","あまかった"],["。"],["それ"],["を"],["食べて","たべて"],["しまう"],["と"],["、"],["私","わたくし"],["の"],["腹","はら"],["は"],["苦く","にがく"],["なった"],["。"]]},{"verse":11,"text":"そのとき、彼らは私に言った。「あなたは、もう一度、もろもろの民族、国民、国語、王たちについて預言しなければならない。」","tok":[["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["もう"],["一度","いちど"],["、"],["もろもろ"],["の"],["民族","みんぞく"],["、"],["国民","こくみん"],["、"],["国語","こくご"],["、"],["王","おう"],["たち"],["について"],["預言","よげん"],["しなければ"],["ならない"],["。"],["」"]]}]
[{"verse":1,"text":"小羊が第七の封印を解いたとき、天に半時間ばかり静けさがあった。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["七","なな"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["とき"],["、"],["天","てん"],["に"],["半","はん"],["時間","じかん"],["ばかり"],["静けさ","しずけさ"],["が"],["あった"],["。"]]},{"verse":2,"text":"それから私は、神の御前に立つ七人の御使いを見た。彼らに七つのラッパが与えられた。","tok":[["それ"],["から"],["私","わたくし"],["は"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["立つ","たつ"],["七人","ななにん"],["の"],["御使い","おつかい"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["に"],["七","なな"],["つ"],["の"],["ラッパ"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":3,"text":"また、もうひとりの御使いが出て来て、金の香炉を持って祭壇のところに立った。彼にたくさんの香が与えられた。すべての聖徒の祈りとともに、御座の前にある金の祭壇の上にささげるためであった。","tok":[["また"],["、"],["もう"],["ひとり"],["の"],["御使い","おつかい"],["が"],["出て","でて"],["来て","きて"],["、"],["金","きん"],["の"],["香炉","こうろ"],["を"],["持って","もって"],["祭壇","さいだん"],["の"],["ところ"],["に"],["立った","たった"],["。"],["彼","かれ"],["に"],["たくさん"],["の"],["香","こう"],["が"],["与えられた","あたえられた"],["。"],["すべて"],["の"],["聖徒","せいと"],["の"],["祈り","いのり"],["と"],["とも"],["に"],["、"],["御座","ぎょざ"],["の"],["前","まえ"],["に"],["ある"],["金","かね"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["ささげる"],["ため"],["で"],["あった"],["。"]]},{"verse":4,"text":"香の煙は、聖徒たちの祈りとともに、御使いの手から神の御前に立ち上った。","tok":[["香","こう"],["の"],["煙","けむり"],["は"],["、"],["聖徒","せいと"],["たち"],["の"],["祈り","いのり"],["と"],["とも"],["に"],["、"],["御使い","おつかい"],["の"],["手","て"],["から"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["立ち上った","たちのぼった"],["。"]]},{"verse":5,"text":"それから、御使いは、その香炉を取り、祭壇の火でそれを満たしてから、地に投げつけた。すると、雷鳴と声といなずまと地震が起こった。","tok":[["それ"],["から"],["、"],["御使い","おつかい"],["は"],["、"],["その"],["香炉","こうろ"],["を"],["取り","とり"],["、"],["祭壇","さいだん"],["の"],["火","ひ"],["で"],["それ"],["を"],["満たして","みたして"],["から"],["、"],["地","ち"],["に"],["投げつけた","なげつけた"],["。"],["する"],["と"],["、"],["雷鳴","らいめい"],["と"],["声","こえ"],["と"],["いなずま"],["と"],["地震","じしん"],["が"],["起こった","おこった"],["。"]]},{"verse":6,"text":"すると、七つのラッパを持っていた七人の御使いはラッパを吹く用意をした。","tok":[["する"],["と"],["、"],["七","なな"],["つ"],["の"],["ラッパ"],["を"],["持って","もって"],["いた"],["七人","ななにん"],["の"],["御使い","おつかい"],["は"],["ラッパ"],["を"],["吹く","ふく"],["用意","ようい"],["を"],["した"],["。"]]},{"verse":7,"text":"第一の御使いがラッパを吹き鳴らした。すると、血の混じった雹と火とが現れ、地上に投げられた。そして地上の三分の一が焼け、木の三分の一も焼け、青草が全部焼けてしまった。","tok":[["第","だい"],["一","いち"],["の"],["御使い","おつかい"],["が"],["ラッパ"],["を"],["吹き鳴らした","ふきならした"],["。"],["する"],["と"],["、"],["血","ち"],["の"],["混じった","まじった"],["雹","ひょう"],["と"],["火","ひ"],["と"],["が"],["現れ","あらわれ"],["、"],["地上","ちじょう"],["に"],["投げられた","なげられた"],["。"],["そして"],["地上","ちじょう"],["の"],["三分","さんぶん"],["の"],["一","いち"],["が"],["焼け","やけ"],["、"],["木","き"],["の"],["三分","さんぶん"],["の"],["一","いち"],["も"],["焼け","やけ"],["、"],["青草","あおくさ"],["が"],["全部","ぜんぶ"],["焼けて","やけて"],["しまった"],["。"]]},{"verse":8,"text":"第二の御使いがラッパを吹き鳴らした。すると、火の燃えている大きな山のようなものが、海に投げ込まれた。そして海の三分の一が血となった。","tok":[["第","だい"],["二","に"],["の"],["御使い","おつかい"],["が"],["ラッパ"],["を"],["吹き鳴らした","ふきならした"],["。"],["する"],["と"],["、"],["火","ひ"],["の"],["燃えて","もえて"],["いる"],["大きな","おおきな"],["山","やま"],["の"],["よう"],["な"],["もの"],["が"],["、"],["海","うみ"],["に"],["投げ込まれた","なげこまれた"],["。"],["そして"],["海","うみ"],["の"],["三分","さんぶん"],["の"],["一","いち"],["が"],["血","ち"],["と"],["なった"],["。"]]},{"verse":9,"text":"すると、海の中にいた、いのちのあるものの三分の一が死に、舟の三分の一も打ちこわされた。","tok":[["する"],["と"],["、"],["海","うみ"],["の"],["中","なか"],["に"],["いた"],["、"],["いのち"],["の"],["ある"],["もの"],["の"],["三分","さんぶん"],["の"],["一","いち"],["が"],["死に","しに"],["、"],["舟","ふね"],["の"],["三分","さんぶん"],["の"],["一","いち"],["も"],["打ちこわされた","うちこわされた"],["。"]]},{"verse":10,"text":"第三の御使いがラッパを吹き鳴らした。すると、たいまつのように燃えている大きな星が天から落ちて来て、川々の三分の一とその水源に落ちた。","tok":[["第","だい"],["三","さん"],["の"],["御使い","おつかい"],["が"],["ラッパ"],["を"],["吹き鳴らした","ふきならした"],["。"],["する"],["と"],["、"],["たいまつ"],["の"],["よう"],["に"],["燃えて","もえて"],["いる"],["大きな","おおきな"],["星","ほし"],["が"],["天","てん"],["から"],["落ちて","おちて"],["来て","きて"],["、"],["川","かわ"],["々"],["の"],["三分","さんぶん"],["の"],["一","いち"],["と"],["その"],["水源","すいげん"],["に"],["落ちた","おちた"],["。"]]},{"verse":11,"text":"この星の名は苦よもぎと呼ばれ、川の水の三分の一は苦よもぎのようになった。水が苦くなったので、その水のために多くの人が死んだ。","tok":[["この"],["星","ほし"],["の"],["名","な"],["は"],["苦","く"],["よもぎ"],["と"],["呼ばれ","よばれ"],["、"],["川","かわ"],["の"],["水","みず"],["の"],["三分","さんぶん"],["の"],["一","いち"],["は"],["苦","く"],["よもぎ"],["の"],["よう"],["に"],["なった"],["。"],["水","みず"],["が"],["苦く","にがく"],["なった"],["ので"],["、"],["その"],["水","みず"],["の"],["ため"],["に"],["多く","おおく"],["の"],["人","ひと"],["が"],["死んだ","しんだ"],["。"]]},{"verse":12,"text":"第四の御使いがラッパを吹き鳴らした。すると、太陽の三分の一と、月の三分の一と、星の三分の一とが打たれたので、三分の一は暗くなり、昼の三分の一は光を失い、また夜も同様であった。","tok":[["第","だい"],["四","よん"],["の"],["御使い","おつかい"],["が"],["ラッパ"],["を"],["吹き鳴らした","ふきならした"],["。"],["する"],["と"],["、"],["太陽","たいよう"],["の"],["三分","さんぶん"],["の"],["一","いち"],["と"],["、"],["月","つき"],["の"],["三分","さんぶん"],["の"],["一","いち"],["と"],["、"],["星","ほし"],["の"],["三分","さんぶん"],["の"],["一","いち"],["と"],["が"],["打たれた","うたれた"],["ので"],["、"],["三分","さんぶん"],["の"],["一","いち"],["は"],["暗く","くらく"],["なり"],["、"],["昼","ひる"],["の"],["三分","さんぶん"],["の"],["一","いち"],["は"],["光","ひかり"],["を"],["失い","うしない"],["、"],["また"],["夜","よる"],["も"],["同様","どうよう"],["で"],["あった"],["。"]]},{"verse":13,"text":"また私は見た。一羽の鷲が中天を飛びながら、大声で言うのを聞いた。「わざわいが来る。わざわいが、わざわいが来る。地に住む人々に。あと三人の御使いがラッパを吹き鳴らそうとしている。」","tok":[["また"],["私","わたくし"],["は"],["見た","みた"],["。"],["一羽","ひとわ"],["の"],["鷲","わし"],["が"],["中天","ちゅうてん"],["を"],["飛び","とび"],["ながら"],["、"],["大声","おおごえ"],["で"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["わざわい"],["が"],["来る","くる"],["。"],["わざわい"],["が"],["、"],["わざわい"],["が"],["来る","くる"],["。"],["地","ち"],["に"],["住む","すむ"],["人々","ひとびと"],["に"],["。"],["あと"],["三人","さんにん"],["の"],["御使い","おつかい"],["が"],["ラッパ"],["を"],["吹き鳴らそう","ふきならそう"],["として"],["いる"],["。"],["」"]]}]
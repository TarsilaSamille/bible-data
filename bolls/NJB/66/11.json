[{"verse":1,"text":"それから、私に杖のような測りざおが与えられた。すると、こう言う者があった。「立って、神の聖所と祭壇と、また、そこで礼拝している人を測れ。","tok":[["それ"],["から"],["、"],["私","わたくし"],["に"],["杖","つえ"],["の"],["よう"],["な"],["測り","はかり"],["ざお"],["が"],["与えられた","あたえられた"],["。"],["する"],["と"],["、"],["こう"],["言う","いう"],["者","もの"],["が"],["あった"],["。"],["「"],["立って","たって"],["、"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["と"],["祭壇","さいだん"],["と"],["、"],["また"],["、"],["そこ"],["で"],["礼拝","れいはい"],["して"],["いる"],["人","ひと"],["を"],["測れ","はかれ"],["。"]]},{"verse":2,"text":"聖所の外の庭は、異邦人に与えられているゆえ、そのままに差し置きなさい。測ってはいけない。彼らは聖なる都を四十二か月の間踏みにじる。","tok":[["聖","せい"],["所","しょ"],["の"],["外","そと"],["の"],["庭","にわ"],["は"],["、"],["異邦人","いほうじん"],["に"],["与えられて","あたえられて"],["いる"],["ゆえ"],["、"],["そのまま"],["に"],["差し置き","さしおき"],["なさい"],["。"],["測って","はかって"],["は"],["いけない"],["。"],["彼","かれ"],["ら"],["は"],["聖","せい"],["なる"],["都","と"],["を"],["四十二","よんじゅうに"],["か月","かげつ"],["の"],["間","あいだ"],["踏みにじる","ふみにじる"],["。"]]},{"verse":3,"text":"それから、わたしがわたしのふたりの証人に許すと、彼らは荒布を着て千二百六十日の間預言する。」","tok":[["それ"],["から"],["、"],["わたし"],["が"],["わたし"],["の"],["ふたり"],["の"],["証人","しょうにん"],["に"],["許す","ゆるす"],["と"],["、"],["彼","かれ"],["ら"],["は"],["荒布","あらめ"],["を"],["着て","きて"],["千二百六十","せんにひゃくろくとう"],["日","か"],["の"],["間","あいだ"],["預言","よげん"],["する"],["。"],["」"]]},{"verse":4,"text":"彼らは全地の主の御前にある二本のオリーブの木、また二つの燭台である。","tok":[["彼","かれ"],["ら"],["は"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["ある"],["二本","にぽん"],["の"],["オリーブ"],["の"],["木","き"],["、"],["また"],["二","ふた"],["つ"],["の"],["燭台","しょくだい"],["で"],["ある"],["。"]]},{"verse":5,"text":"彼らに害を加えようとする者があれば、火が彼らの口から出て、敵を滅ぼし尽くす。彼らに害を加えようとする者があれば、必ずこのように殺される。","tok":[["彼","かれ"],["ら"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["する"],["者","もの"],["が"],["あれば"],["、"],["火","ひ"],["が"],["彼","かれ"],["ら"],["の"],["口","くち"],["から"],["出て","でて"],["、"],["敵","てき"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"],["彼","かれ"],["ら"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["する"],["者","もの"],["が"],["あれば"],["、"],["必ず","かならず"],["この"],["よう"],["に"],["殺される","ころされる"],["。"]]},{"verse":6,"text":"この人たちは、預言をしている期間は雨が降らないように天を閉じる力を持っており、また、水を血に変え、そのうえ、思うままに、何度でも、あらゆる災害をもって地を打つ力を持っている。","tok":[["この"],["人","ひと"],["たち"],["は"],["、"],["預言","よげん"],["を"],["して"],["いる"],["期間","きかん"],["は"],["雨","あめ"],["が"],["降らない","ふらない"],["よう"],["に"],["天","てん"],["を"],["閉じる","とじる"],["力","ちから"],["を"],["持って","もって"],["おり"],["、"],["また"],["、"],["水","みず"],["を"],["血","ち"],["に"],["変え","かえ"],["、"],["その"],["うえ"],["、"],["思う","おもう"],["まま"],["に"],["、"],["何度","なんど"],["で"],["も"],["、"],["あらゆる"],["災害","さいがい"],["を"],["もって"],["地","ち"],["を"],["打つ","うつ"],["力","ちから"],["を"],["持って","もって"],["いる"],["。"]]},{"verse":7,"text":"そして彼らがあかしを終えると、底知れぬ所から上って来る獣が、彼らと戦って勝ち、彼らを殺す。","tok":[["そして"],["彼","かれ"],["ら"],["が"],["あかし"],["を"],["終える","おえる"],["と"],["、"],["底","そこ"],["知れぬ","しれぬ"],["所","ところ"],["から"],["上って","のぼって"],["来る","くる"],["獣","けもの"],["が"],["、"],["彼","かれ"],["ら"],["と"],["戦って","たたかって"],["勝ち","かち"],["、"],["彼","かれ"],["ら"],["を"],["殺す","ころす"],["。"]]},{"verse":8,"text":"彼らの死体は、霊的な理解ではソドムやエジプトと呼ばれる大きな都の大通りにさらされる。彼らの主もその都で十字架につけられたのである。","tok":[["彼","かれ"],["ら"],["の"],["死体","したい"],["は"],["、"],["霊的","れいてき"],["な"],["理解","りかい"],["で"],["は"],["ソドム"],["や"],["エジプト"],["と"],["呼ばれる","よばれる"],["大きな","おおきな"],["都","と"],["の"],["大通り","おおどおり"],["に"],["さらされる"],["。"],["彼","かれ"],["ら"],["の"],["主","ぬし"],["も"],["その"],["都","と"],["で"],["十字架","じゅうじか"],["に"],["つけられた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"もろもろの民族、部族、国語、国民に属する人々が、三日半の間、彼らの死体をながめていて、その死体を墓に納めることを許さない。","tok":[["もろもろ"],["の"],["民族","みんぞく"],["、"],["部族","ぶぞく"],["、"],["国語","こくご"],["、"],["国民","こくみん"],["に"],["属する","ぞくする"],["人々","ひとびと"],["が"],["、"],["三日","みっか"],["半","はん"],["の"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["の"],["死体","したい"],["を"],["ながめて"],["いて"],["、"],["その"],["死体","したい"],["を"],["墓","はか"],["に"],["納める","おさめる"],["こと"],["を"],["許さない","ゆるさない"],["。"]]},{"verse":10,"text":"また地に住む人々は、彼らのことで喜び祝って、互いに贈り物を贈り合う。それは、このふたりの預言者が、地に住む人々を苦しめたからである。","tok":[["また"],["地","ち"],["に"],["住む","すむ"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["ら"],["の"],["こと"],["で"],["喜び祝って","よろこびいわって"],["、"],["互い","たがい"],["に"],["贈り物","おくりもの"],["を"],["贈り","おくり"],["合う","あう"],["。"],["それ"],["は"],["、"],["この"],["ふたり"],["の"],["預言者","よげんしゃ"],["が"],["、"],["地","ち"],["に"],["住む","すむ"],["人々","ひとびと"],["を"],["苦しめた","くるしめた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"しかし、三日半の後、神から出たいのちの息が、彼らに入り、彼らが足で立ち上がったので、それを見ていた人々は非常な恐怖に襲われた。","tok":[["しかし"],["、"],["三日","みっか"],["半","はん"],["の"],["後","あと"],["、"],["神","かみ"],["から"],["出た","でた"],["いのち"],["の"],["息","いき"],["が"],["、"],["彼","かれ"],["ら"],["に"],["入り","はいり"],["、"],["彼","かれ"],["ら"],["が"],["足","あし"],["で"],["立ち上がった","たちあがった"],["ので"],["、"],["それ"],["を"],["見て","みて"],["いた"],["人々","ひとびと"],["は"],["非常","ひじょう"],["な"],["恐怖","きょうふ"],["に"],["襲われた","おそわれた"],["。"]]},{"verse":12,"text":"そのときふたりは、天から大きな声がして、「ここに上れ」と言うのを聞いた。そこで、彼らは雲に乗って天に上った。彼らの敵はそれを見た。","tok":[["その"],["とき"],["ふたり"],["は"],["、"],["天","てん"],["から"],["大きな","おおきな"],["声","こえ"],["が"],["して"],["、"],["「"],["ここ"],["に"],["上れ","のぼれ"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["雲","くも"],["に"],["乗って","のって"],["天","てん"],["に"],["上った","のぼった"],["。"],["彼","かれ"],["ら"],["の"],["敵","てき"],["は"],["それ"],["を"],["見た","みた"],["。"]]},{"verse":13,"text":"そのとき、大地震が起こって、都の十分の一が倒れた。この地震のため七千人が死に、生き残った人々は、恐怖に満たされ、天の神をあがめた。","tok":[["その"],["とき"],["、"],["大地震","だいじしん"],["が"],["起こって","おこって"],["、"],["都","と"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["が"],["倒れた","たおれた"],["。"],["この"],["地震","じしん"],["の"],["ため"],["七千人","ななせんにん"],["が"],["死に","しに"],["、"],["生き残った","いきのこった"],["人々","ひとびと"],["は"],["、"],["恐怖","きょうふ"],["に"],["満たされ","みたされ"],["、"],["天","てん"],["の"],["神","かみ"],["を"],["あがめた"],["。"]]},{"verse":14,"text":"第二のわざわいは過ぎ去った。見よ。第三のわざわいがすぐに来る。","tok":[["第","だい"],["二","に"],["の"],["わざわい"],["は"],["過ぎ去った","すぎさった"],["。"],["見","み"],["よ"],["。"],["第","だい"],["三","さん"],["の"],["わざわい"],["が"],["すぐ"],["に"],["来る","くる"],["。"]]},{"verse":15,"text":"第七の御使いがラッパを吹き鳴らした。すると、天に大きな声々が起こって言った。「この世の国は私たちの主およびそのキリストのものとなった。主は永遠に支配される。」","tok":[["第","だい"],["七","なな"],["の"],["御使い","おつかい"],["が"],["ラッパ"],["を"],["吹き鳴らした","ふきならした"],["。"],["する"],["と"],["、"],["天","てん"],["に"],["大きな","おおきな"],["声々","こえごえ"],["が"],["起こって","おこって"],["言った","いった"],["。"],["「"],["この世","このよ"],["の"],["国","くに"],["は"],["私たち","わたしたち"],["の"],["主","ぬし"],["および"],["その"],["キリスト"],["の"],["もの"],["と"],["なった"],["。"],["主","ぬし"],["は"],["永遠","えいえん"],["に"],["支配","しはい"],["される"],["。"],["」"]]},{"verse":16,"text":"それから、神の御前で自分たちの座に着いている二十四人の長老たちも、地にひれ伏し、神を礼拝して、","tok":[["それ"],["から"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["自分","じぶん"],["たち"],["の"],["座","ざ"],["に"],["着いて","ついて"],["いる"],["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["たち"],["も"],["、"],["地","ち"],["に"],["ひれ伏し","ひれふし"],["、"],["神","かみ"],["を"],["礼拝","れいはい"],["して"],["、"]]},{"verse":17,"text":"言った。「万物の支配者、今いまし、昔います神である主。あなたが、その偉大な力を働かせて、王となられたことを感謝します。","tok":[["言った","いった"],["。"],["「"],["万物","ばんぶつ"],["の"],["支配者","しはいしゃ"],["、"],["今","いま"],["いまし"],["、"],["昔","むかし"],["います"],["神","かみ"],["で"],["ある"],["主","ぬし"],["。"],["あなた"],["が"],["、"],["その"],["偉大","いだい"],["な"],["力","ちから"],["を"],["働かせて","はたらかせて"],["、"],["王","おう"],["と"],["なられた"],["こと"],["を"],["感謝","かんしゃ"],["します"],["。"]]},{"verse":18,"text":"諸国の民は怒りました。しかし、あなたの御怒りの日が来ました。死者のさばかれる時、あなたのしもべである預言者たち、聖徒たち、また小さい者も大きい者もすべてあなたの御名を恐れかしこむ者たちに報いの与えられる時、地を滅ぼす者どもの滅ぼされる時です。」","tok":[["諸国","しょこく"],["の"],["民","たみ"],["は"],["怒りました","おこりました"],["。"],["しかし"],["、"],["あなた"],["の"],["御怒り","おいかり"],["の"],["日","ひ"],["が"],["来ました","きました"],["。"],["死者","ししゃ"],["の"],["さばかれる"],["時","とき"],["、"],["あなた"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["、"],["聖徒","せいと"],["たち"],["、"],["また"],["小さい","ちいさい"],["者","もの"],["も"],["大きい","おおきい"],["者","もの"],["も"],["すべて"],["あなた"],["の"],["御名","ぎょめい"],["を"],["恐れ","おそれ"],["かしこむ"],["者","もの"],["たち"],["に"],["報い","むくい"],["の"],["与えられる","あたえられる"],["時","とき"],["、"],["地","ち"],["を"],["滅ぼす","ほろぼす"],["者","もの"],["ども"],["の"],["滅ぼされる","ほろぼされる"],["時","とき"],["です"],["。"],["」"]]},{"verse":19,"text":"それから、天にある、神の神殿が開かれた。神殿の中に、契約の箱が見えた。また、いなずま、声、雷鳴、地震が起こり、大きな雹が降った。","tok":[["それ"],["から"],["、"],["天","てん"],["に"],["ある"],["、"],["神","かみ"],["の"],["神殿","しんでん"],["が"],["開かれた","ひらかれた"],["。"],["神殿","しんでん"],["の"],["中","なか"],["に"],["、"],["契約","けいやく"],["の"],["箱","ばこ"],["が"],["見えた","みえた"],["。"],["また"],["、"],["いなずま"],["、"],["声","こえ"],["、"],["雷鳴","らいめい"],["、"],["地震","じしん"],["が"],["起こり","おこり"],["、"],["大きな","おおきな"],["雹","ひょう"],["が"],["降った","ふった"],["。"]]}]
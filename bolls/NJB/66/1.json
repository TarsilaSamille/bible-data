[{"verse":1,"text":"イエス・キリストの黙示。これは、すぐに起こるはずの事をそのしもべたちに示すため、神がキリストにお与えになったものである。そしてキリストは、その御使いを遣わして、これをしもべヨハネにお告げになった。","tok":[["イエス"],["・"],["キリスト"],["の"],["黙示","もくし"],["。"],["これ"],["は"],["、"],["すぐ"],["に"],["起こる","おこる"],["はず"],["の"],["事","こと"],["を"],["その"],["しもべ"],["たち"],["に"],["示す","しめす"],["ため"],["、"],["神","かみ"],["が"],["キリスト"],["に"],["お与え","おあたえ"],["に"],["なった"],["もの"],["で"],["ある"],["。"],["そして"],["キリスト"],["は"],["、"],["その"],["御使い","おつかい"],["を"],["遣わして","つかわして"],["、"],["これ"],["を"],["しもべ"],["ヨハネ"],["に"],["お告げ","おつげ"],["に"],["なった"],["。"]]},{"verse":2,"text":"ヨハネは、神のことばとイエス・キリストのあかし、すなわち、彼の見たすべての事をあかしした。","tok":[["ヨハネ"],["は"],["、"],["神","かみ"],["の"],["ことば"],["と"],["イエス"],["・"],["キリスト"],["の"],["あかし"],["、"],["すなわち"],["、"],["彼","かれ"],["の"],["見た","みた"],["すべて"],["の"],["事","こと"],["を"],["あかし"],["した"],["。"]]},{"verse":3,"text":"この預言のことばを朗読する者と、それを聞いて、そこに書かれていることを心に留める人々は幸いである。時が近づいているからである。","tok":[["この"],["預言","よげん"],["の"],["ことば"],["を"],["朗読","ろうどく"],["する"],["者","もの"],["と"],["、"],["それ"],["を"],["聞いて","きいて"],["、"],["そこ"],["に"],["書かれて","かかれて"],["いる"],["こと"],["を"],["心","こころ"],["に"],["留める","とめる"],["人々","ひとびと"],["は"],["幸い","さいわい"],["で"],["ある"],["。"],["時","じ"],["が"],["近づいて","ちかづいて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"ヨハネから、アジヤにある七つの教会へ。今いまし、昔いまし、後に来られる方から、また、その御座の前におられる七つの御霊から、","tok":[["ヨハネ"],["から"],["、"],["アジヤ"],["に"],["ある"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["へ"],["。"],["今","いま"],["いまし"],["、"],["昔","むかし"],["いまし"],["、"],["後","あと"],["に"],["来られる","こられる"],["方","かた"],["から"],["、"],["また"],["、"],["その"],["御座","ぎょざ"],["の"],["前","まえ"],["に"],["おられる"],["七","なな"],["つ"],["の"],["御霊","ごれい"],["から"],["、"]]},{"verse":5,"text":"また、忠実な証人、死者の中から最初によみがえられた方、地上の王たちの支配者であるイエス・キリストから、恵みと平安が、あなたがたにあるように。イエス・キリストは私たちを愛して、その血によって私たちを罪から解き放ち、","tok":[["また"],["、"],["忠実","ちゅうじつ"],["な"],["証人","しょうにん"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["最初","さいしょ"],["に"],["よみがえられた"],["方","かた"],["、"],["地上","ちじょう"],["の"],["王","おう"],["たち"],["の"],["支配者","しはいしゃ"],["で"],["ある"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"],["イエス"],["・"],["キリスト"],["は"],["私たち","わたしたち"],["を"],["愛して","あいして"],["、"],["その"],["血","ち"],["によって"],["私たち","わたしたち"],["を"],["罪","つみ"],["から"],["解き放ち","ときはなち"],["、"]]},{"verse":6,"text":"また、私たちを王国とし、ご自分の父である神のために祭司としてくださった方である。キリストに栄光と力とが、とこしえにあるように。アーメン。","tok":[["また"],["、"],["私たち","わたしたち"],["を"],["王国","おうこく"],["と"],["し"],["、"],["ご自分","ごじぶん"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["の"],["ため"],["に"],["祭司","さいし"],["として"],["くださった"],["方","ほう"],["で"],["ある"],["。"],["キリスト"],["に"],["栄光","えいこう"],["と"],["力","ちから"],["と"],["が"],["、"],["とこしえ"],["に"],["ある"],["よう"],["に"],["。"],["アーメン"],["。"]]},{"verse":7,"text":"見よ、彼が、雲に乗って来られる。すべての目、ことに彼を突き刺した者たちが、彼を見る。地上の諸族はみな、彼のゆえに嘆く。しかり。アーメン。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["が"],["、"],["雲","くも"],["に"],["乗って","のって"],["来られる","こられる"],["。"],["すべて"],["の"],["目","め"],["、"],["こと"],["に"],["彼","かれ"],["を"],["突き刺した","つきさした"],["者","もの"],["たち"],["が"],["、"],["彼","かれ"],["を"],["見る","みる"],["。"],["地上","ちじょう"],["の"],["諸族","しょぞく"],["は"],["みな"],["、"],["彼","かれ"],["の"],["ゆえ"],["に"],["嘆く","なげく"],["。"],["しかり"],["。"],["アーメン"],["。"]]},{"verse":8,"text":"神である主、今いまし、昔いまし、後に来られる方、万物の支配者がこう言われる。「わたしはアルファであり、オメガである。」","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["、"],["今","いま"],["いまし"],["、"],["昔","むかし"],["いまし"],["、"],["後","あと"],["に"],["来られる","こられる"],["方","かた"],["、"],["万物","ばんぶつ"],["の"],["支配者","しはいしゃ"],["が"],["こう"],["言われる","いわれる"],["。"],["「"],["わたし"],["は"],["アルファ"],["で"],["あり"],["、"],["オメガ"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"私ヨハネは、あなたがたの兄弟であり、あなたがたとともにイエスにある苦難と御国と忍耐とにあずかっている者であって、神のことばとイエスのあかしとのゆえに、パトモスという島にいた。","tok":[["私","わたくし"],["ヨハネ"],["は"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["で"],["あり"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["イエス"],["に"],["ある"],["苦難","くなん"],["と"],["御国","みくに"],["と"],["忍耐","にんたい"],["と"],["に"],["あずかって"],["いる"],["者","もの"],["で"],["あって"],["、"],["神","かみ"],["の"],["ことば"],["と"],["イエス"],["の"],["あかし"],["と"],["の"],["ゆえ"],["に"],["、"],["パトモス"],["と"],["いう"],["島","しま"],["に"],["いた"],["。"]]},{"verse":10,"text":"私は、主の日に御霊に感じ、私のうしろにラッパの音のような大きな声を聞いた。","tok":[["私","わたくし"],["は"],["、"],["主","ぬし"],["の"],["日","ひ"],["に"],["御霊","ごれい"],["に"],["感じ","かんじ"],["、"],["私","わたくし"],["の"],["うしろ"],["に"],["ラッパ"],["の"],["音","おと"],["の"],["よう"],["な"],["大きな","おおきな"],["声","こえ"],["を"],["聞いた","きいた"],["。"]]},{"verse":11,"text":"その声はこう言った。「あなたの見ることを巻き物にしるして、七つの教会、すなわち、エペソ、スミルナ、ペルガモ、テアテラ、サルデス、フィラデルフィヤ、ラオデキヤに送りなさい。」","tok":[["その"],["声","こえ"],["は"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["の"],["見る","みる"],["こと"],["を"],["巻き物","まきもの"],["に"],["しるして"],["、"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["、"],["すなわち"],["、"],["エペソ"],["、"],["スミルナ"],["、"],["ペルガモ"],["、"],["テアテラ"],["、"],["サルデス"],["、"],["フィラデルフィヤ"],["、"],["ラオデキヤ"],["に"],["送り","おくり"],["なさい"],["。"],["」"]]},{"verse":12,"text":"そこで私は、私に語りかける声を見ようとして振り向いた。振り向くと、七つの金の燭台が見えた。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["私","わたくし"],["に"],["語りかける","かたりかける"],["声","こえ"],["を"],["見よう","みよう"],["として"],["振り向いた","ふりむいた"],["。"],["振り向く","ふりむく"],["と"],["、"],["七","なな"],["つ"],["の"],["金","かね"],["の"],["燭台","しょくだい"],["が"],["見えた","みえた"],["。"]]},{"verse":13,"text":"それらの燭台の真ん中には、足までたれた衣を着て、胸に金の帯を締めた、人の子のような方が見えた。","tok":[["それ"],["ら"],["の"],["燭台","しょくだい"],["の"],["真ん中","まんなか"],["に"],["は"],["、"],["足","あし"],["まで"],["たれた"],["衣","ころも"],["を"],["着て","きて"],["、"],["胸","むね"],["に"],["金","かね"],["の"],["帯","おび"],["を"],["締めた","しめた"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["な"],["方","ほう"],["が"],["見えた","みえた"],["。"]]},{"verse":14,"text":"その頭と髪の毛は、白い羊毛のように、また雪のように白く、その目は、燃える炎のようであった。","tok":[["その"],["頭","あたま"],["と"],["髪の毛","かみのけ"],["は"],["、"],["白い","しろい"],["羊毛","ようもう"],["の"],["よう"],["に"],["、"],["また"],["雪","ゆき"],["の"],["よう"],["に"],["白く","しろく"],["、"],["その"],["目","め"],["は"],["、"],["燃える","もえる"],["炎","ほのお"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":15,"text":"その足は、炉で精錬されて光り輝くしんちゅうのようであり、その声は大水の音のようであった。","tok":[["その"],["足","あし"],["は"],["、"],["炉","ろ"],["で"],["精錬","せいれん"],["されて"],["光り輝く","ひかりかがやく"],["しんちゅう"],["の"],["よう"],["で"],["あり"],["、"],["その"],["声","こえ"],["は"],["大水","おおみず"],["の"],["音","おと"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":16,"text":"また、右手に七つの星を持ち、口からは鋭い両刃の剣が出ており、顔は強く照り輝く太陽のようであった。","tok":[["また"],["、"],["右手","みぎて"],["に"],["七","なな"],["つ"],["の"],["星","ほし"],["を"],["持ち","もち"],["、"],["口","くち"],["から"],["は"],["鋭い","するどい"],["両刃","りょうば"],["の"],["剣","けん"],["が"],["出て","でて"],["おり"],["、"],["顔","かお"],["は"],["強く","つよく"],["照り輝く","てりかがやく"],["太陽","たいよう"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":17,"text":"それで私は、この方を見たとき、その足もとに倒れて死者のようになった。しかし彼は右手を私の上に置いてこう言われた。「恐れるな。わたしは、最初であり、最後であり、","tok":[["それ"],["で"],["私","わたくし"],["は"],["、"],["この"],["方","ほう"],["を"],["見た","みた"],["とき"],["、"],["その"],["足もと","あしもと"],["に"],["倒れて","たおれて"],["死者","ししゃ"],["の"],["よう"],["に"],["なった"],["。"],["しかし"],["彼","かれ"],["は"],["右手","みぎて"],["を"],["私","わたくし"],["の"],["上","うえ"],["に"],["置いて","おいて"],["こう"],["言われた","いわれた"],["。"],["「"],["恐れる","おそれる"],["な"],["。"],["わたし"],["は"],["、"],["最初","さいしょ"],["で"],["あり"],["、"],["最後","さいご"],["で"],["あり"],["、"]]},{"verse":18,"text":"生きている者である。わたしは死んだが、見よ、いつまでも生きている。また、死とハデスとのかぎを持っている。","tok":[["生きて","いきて"],["いる"],["者","もの"],["で"],["ある"],["。"],["わたし"],["は"],["死んだ","しんだ"],["が"],["、"],["見よ","みよ"],["、"],["いつ"],["まで"],["も"],["生きて","いきて"],["いる"],["。"],["また"],["、"],["死","し"],["と"],["ハデス"],["と"],["の"],["かぎ"],["を"],["持って","もって"],["いる"],["。"]]},{"verse":19,"text":"そこで、あなたの見た事、今ある事、この後に起こる事を書きしるせ。","tok":[["そこ"],["で"],["、"],["あなた"],["の"],["見た","みた"],["事","こと"],["、"],["今","いま"],["ある"],["事","こと"],["、"],["この"],["後","あと"],["に"],["起こる","おこる"],["事","こと"],["を"],["書きしるせ","かきしるせ"],["。"]]},{"verse":20,"text":"わたしの右の手の中に見えた七つの星と、七つの金の燭台について、その秘められた意味を言えば、七つの星は七つの教会の御使いたち、七つの燭台は七つの教会である。","tok":[["わたし"],["の"],["右","みぎ"],["の"],["手","て"],["の"],["中","なか"],["に"],["見えた","みえた"],["七","なな"],["つ"],["の"],["星","ほし"],["と"],["、"],["七","なな"],["つ"],["の"],["金","かね"],["の"],["燭台","しょくだい"],["について"],["、"],["その"],["秘められた","ひめられた"],["意味","いみ"],["を"],["言えば","いえば"],["、"],["七","なな"],["つ"],["の"],["星","ほし"],["は"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["の"],["御使
[{"verse":1,"text":"この後、私は見た。四人の御使いが地の四隅に立って、地の四方の風を堅く押さえ、地にも海にもどんな木にも、吹きつけないようにしていた。","tok":[["この"],["後","ご"],["、"],["私","わたくし"],["は"],["見た","みた"],["。"],["四人","よんにん"],["の"],["御使い","おつかい"],["が"],["地","ち"],["の"],["四隅","よすみ"],["に"],["立って","たって"],["、"],["地","ち"],["の"],["四方","しほう"],["の"],["風","かぜ"],["を"],["堅く","かたく"],["押さえ","おさえ"],["、"],["地","ち"],["に"],["も"],["海","うみ"],["に"],["も"],["どんな"],["木","き"],["に"],["も"],["、"],["吹きつけない","ふきつけない"],["よう"],["に"],["して"],["いた"],["。"]]},{"verse":2,"text":"また私は見た。もうひとりの御使いが、生ける神の印を持って、日の出るほうから上って来た。彼は、地をも海をもそこなう権威を与えられた四人の御使いたちに、大声で叫んで言った。","tok":[["また"],["私","わたくし"],["は"],["見た","みた"],["。"],["もう"],["ひとり"],["の"],["御使い","おつかい"],["が"],["、"],["生ける","いける"],["神","かみ"],["の"],["印","しるし"],["を"],["持って","もって"],["、"],["日","ひ"],["の"],["出る","でる"],["ほう"],["から"],["上って","のぼって"],["来た","きた"],["。"],["彼","かれ"],["は"],["、"],["地","ち"],["を"],["も"],["海","うみ"],["を"],["も"],["そこなう"],["権威","けんい"],["を"],["与えられた","あたえられた"],["四人","よんにん"],["の"],["御使い","おつかい"],["たち"],["に"],["、"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["言った","いった"],["。"]]},{"verse":3,"text":"「私たちが神のしもべたちの額に印を押してしまうまで、地にも海にも木にも害を与えてはいけない。」","tok":[["「"],["私たち","わたしたち"],["が"],["神","かみ"],["の"],["しもべ"],["たち"],["の"],["額","がく"],["に"],["印","しるし"],["を"],["押して","おして"],["しまう"],["まで"],["、"],["地","ち"],["に"],["も"],["海","うみ"],["に"],["も"],["木","き"],["に"],["も"],["害","がい"],["を"],["与えて","あたえて"],["は"],["いけない"],["。"],["」"]]},{"verse":4,"text":"それから私が、印を押された人々の数を聞くと、イスラエルの子孫のあらゆる部族の者が印を押されていて、十四万四千人であった。","tok":[["それ"],["から"],["私","わたくし"],["が"],["、"],["印","しるし"],["を"],["押された","おされた"],["人々","ひとびと"],["の"],["数","かず"],["を"],["聞く","きく"],["と"],["、"],["イスラエル"],["の"],["子孫","しそん"],["の"],["あらゆる"],["部族","ぶぞく"],["の"],["者","もの"],["が"],["印","しるし"],["を"],["押されて","おされて"],["いて"],["、"],["十四万四千","じゅうよんまんよんせん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":5,"text":"ユダの部族で印を押された者が一万二千人、ルベンの部族で一万二千人、ガドの部族で一万二千人、","tok":[["ユダ"],["の"],["部族","ぶぞく"],["で"],["印","しるし"],["を"],["押された","おされた"],["者","もの"],["が"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ルベン"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ガド"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":6,"text":"アセルの部族で一万二千人、ナフタリの部族で一万二千人、マナセの部族で一万二千人、","tok":[["アセル"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ナフタリ"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"],["マナセ"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":7,"text":"シメオンの部族で一万二千人、レビの部族で一万二千人、イッサカルの部族で一万二千人、","tok":[["シメオン"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"],["レビ"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"],["イッサカル"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":8,"text":"ゼブルンの部族で一万二千人、ヨセフの部族で一万二千人、ベニヤミンの部族で一万二千人、印を押された者がいた。","tok":[["ゼブルン"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ヨセフ"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ベニヤミン"],["の"],["部族","ぶぞく"],["で"],["一万二千","いちまんにせん"],["人","にん"],["、"],["印","しるし"],["を"],["押された","おされた"],["者","もの"],["が"],["いた"],["。"]]},{"verse":9,"text":"その後、私は見た。見よ。あらゆる国民、部族、民族、国語のうちから、だれにも数えきれぬほどの大ぜいの群衆が、白い衣を着、しゅろの枝を手に持って、御座と小羊との前に立っていた。","tok":[["その"],["後","ご"],["、"],["私","わたくし"],["は"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["あらゆる"],["国民","こくみん"],["、"],["部族","ぶぞく"],["、"],["民族","みんぞく"],["、"],["国語","こくご"],["の"],["うち"],["から"],["、"],["だれ"],["に"],["も"],["数え","かぞえ"],["きれぬ"],["ほど"],["の"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["、"],["白い","しろい"],["衣","ころも"],["を"],["着","き"],["、"],["しゅろ"],["の"],["枝","えだ"],["を"],["手","て"],["に"],["持って","もって"],["、"],["御座","ぎょざ"],["と"],["小羊","こひつじ"],["と"],["の"],["前","まえ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":10,"text":"彼らは、大声で叫んで言った。「救いは、御座にある私たちの神にあり、小羊にある。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["救い","すくい"],["は"],["、"],["御座","ぎょざ"],["に"],["ある"],["私たち","わたしたち"],["の"],["神","かみ"],["に"],["あり"],["、"],["小羊","こひつじ"],["に"],["ある"],["。"],["」"]]},{"verse":11,"text":"御使いたちはみな、御座と長老たちと四つの生き物との回りに立っていたが、彼らも御座の前にひれ伏し、神を拝して、","tok":[["御使い","おつかい"],["たち"],["は"],["みな"],["、"],["御座","ぎょざ"],["と"],["長老","ちょうろう"],["たち"],["と"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["の"],["回り","まわり"],["に"],["立って","たって"],["いた"],["が"],["、"],["彼","かれ"],["ら"],["も"],["御座","ぎょざ"],["の"],["前","まえ"],["に"],["ひれ伏し","ひれふし"],["、"],["神","かみ"],["を"],["拝して","はいして"],["、"]]},{"verse":12,"text":"言った。「アーメン。賛美と栄光と知恵と感謝と誉れと力と勢いが、永遠に私たちの神にあるように。アーメン。」","tok":[["言った","いった"],["。"],["「"],["アーメン"],["。"],["賛美","さんび"],["と"],["栄光","えいこう"],["と"],["知恵","ちえ"],["と"],["感謝","かんしゃ"],["と"],["誉れ","ほまれ"],["と"],["力","ちから"],["と"],["勢い","いきおい"],["が"],["、"],["永遠","えいえん"],["に"],["私たち","わたしたち"],["の"],["神","かみ"],["に"],["ある"],["よう"],["に"],["。"],["アーメン"],["。"],["」"]]},{"verse":13,"text":"長老のひとりが私に話しかけて、「白い衣を着ているこの人たちは、いったいだれですか。どこから来たのですか」と言った。","tok":[["長老","ちょうろう"],["の"],["ひとり"],["が"],["私","わたくし"],["に"],["話しかけて","はなしかけて"],["、"],["「"],["白い","しろい"],["衣","ころも"],["を"],["着て","きて"],["いる"],["この"],["人","ひと"],["たち"],["は"],["、"],["いったい"],["だれ"],["です"],["か"],["。"],["どこ"],["から"],["来た","きた"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"そこで、私は、「主よ。あなたこそ、ご存じです」と言った。すると、彼は私にこう言った。「彼らは、大きな患難から抜け出て来た者たちで、その衣を小羊の血で洗って、白くしたのです。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["、"],["「"],["主","ぬし"],["よ"],["。"],["あなた"],["こそ"],["、"],["ご存じ","ごぞんじ"],["です"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["私","わたくし"],["に"],["こう"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["、"],["大きな","おおきな"],["患難","かんなん"],["から"],["抜け出て","ぬけでて"],["来た","きた"],["者","もの"],["たち"],["で"],["、"],["その"],["衣","ころも"],["を"],["小羊","こひつじ"],["の"],["血","ち"],["で"],["洗って","あらって"],["、"],["白く","しろく"],["した"],["の"],["です"],["。"]]},{"verse":15,"text":"だから彼らは神の御座の前にいて、聖所で昼も夜も、神に仕えているのです。そして、御座に着いておられる方も、彼らの上に幕屋を張られるのです。","tok":[["だ"],["から"],["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["御座","ぎょざ"],["の"],["前","まえ"],["に"],["いて"],["、"],["聖","せい"],["所","しょ"],["で"],["昼","ひる"],["も"],["夜","よる"],["も"],["、"],["神","かみ"],["に"],["仕えて","つかえて"],["いる"],["の"],["です"],
[{"verse":1,"text":"また私は、御使いが底知れぬ所のかぎと大きな鎖とを手に持って、天から下って来るのを見た。","tok":[["また"],["私","わたくし"],["は"],["、"],["御使い","おつかい"],["が"],["底","そこ"],["知れぬ","しれぬ"],["所","ところ"],["の"],["かぎ"],["と"],["大きな","おおきな"],["鎖","くさり"],["と"],["を"],["手","て"],["に"],["持って","もって"],["、"],["天","てん"],["から"],["下って","くだって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":2,"text":"彼は、悪魔でありサタンである竜、あの古い蛇を捕らえ、これを千年の間縛って、","tok":[["彼","かれ"],["は"],["、"],["悪魔","あくま"],["で"],["あり"],["サタン"],["で"],["ある"],["竜","りゅう"],["、"],["あの"],["古い","ふるい"],["蛇","へび"],["を"],["捕らえ","とらえ"],["、"],["これ"],["を"],["千","せん"],["年","ねん"],["の"],["間","あいだ"],["縛って","しばって"],["、"]]},{"verse":3,"text":"底知れぬ所に投げ込んで、そこを閉じ、その上に封印して、千年の終わるまでは、それが諸国の民を惑わすことのないようにした。サタンは、そのあとでしばらくの間、解き放されなければならない。","tok":[["底","そこ"],["知れぬ","しれぬ"],["所","ところ"],["に"],["投げ込んで","なげこんで"],["、"],["そこ"],["を"],["閉じ","とじ"],["、"],["その"],["上","うえ"],["に"],["封印","ふういん"],["して"],["、"],["千","せん"],["年","ねん"],["の"],["終わる","おわる"],["まで"],["は"],["、"],["それ"],["が"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["惑わす","まどわす"],["こと"],["の"],["ない"],["よう"],["に"],["した"],["。"],["サタン"],["は"],["、"],["その"],["あと"],["で"],["しばらく"],["の"],["間","あいだ"],["、"],["解き放されなければ","ときはなされなければ"],["ならない"],["。"]]},{"verse":4,"text":"また私は、多くの座を見た。彼らはその上にすわった。そしてさばきを行う権威が彼らに与えられた。また私は、イエスのあかしと神のことばとのゆえに首をはねられた人たちのたましいと、獣やその像を拝まず、その額や手に獣の刻印を押されなかった人たちを見た。彼らは生き返って、キリストとともに、千年の間王となった。","tok":[["また"],["私","わたくし"],["は"],["、"],["多く","おおく"],["の"],["座","ざ"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["は"],["その"],["上","うえ"],["に"],["すわった"],["。"],["そして"],["さばき"],["を"],["行う","おこなう"],["権威","けんい"],["が"],["彼","かれ"],["ら"],["に"],["与えられた","あたえられた"],["。"],["また"],["私","わたくし"],["は"],["、"],["イエス"],["の"],["あかし"],["と"],["神","かみ"],["の"],["ことば"],["と"],["の"],["ゆえ"],["に"],["首","くび"],["を"],["はねられた"],["人","ひと"],["たち"],["の"],["たましい"],["と"],["、"],["獣","けもの"],["や"],["その"],["像","ぞう"],["を"],["拝まず","おがまず"],["、"],["その"],["額","がく"],["や"],["手","て"],["に"],["獣","けもの"],["の"],["刻印","こくいん"],["を"],["押されなかった","おされなかった"],["人","ひと"],["たち"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["は"],["生き返って","いきかえって"],["、"],["キリスト"],["と"],["とも"],["に"],["、"],["千","せん"],["年","ねん"],["の"],["間","あいだ"],["王","おう"],["と"],["なった"],["。"]]},{"verse":5,"text":"そのほかの死者は、千年の終わるまでは、生き返らなかった。これが第一の復活である。","tok":[["その"],["ほか"],["の"],["死者","ししゃ"],["は"],["、"],["千","せん"],["年","ねん"],["の"],["終わる","おわる"],["まで"],["は"],["、"],["生き返らなかった","いきかえらなかった"],["。"],["これ"],["が"],["第","だい"],["一","いち"],["の"],["復活","ふっかつ"],["で"],["ある"],["。"]]},{"verse":6,"text":"この第一の復活にあずかる者は幸いな者、聖なる者である。この人々に対しては、第二の死は、なんの力も持っていない。彼らは神とキリストとの祭司となり、キリストとともに、千年の間王となる。","tok":[["この"],["第","だい"],["一","いち"],["の"],["復活","ふっかつ"],["に"],["あずかる"],["者","もの"],["は"],["幸い","さいわい"],["な"],["者","もの"],["、"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["。"],["この"],["人々","ひとびと"],["に"],["対し","たいし"],["ては"],["、"],["第","だい"],["二","に"],["の"],["死","し"],["は"],["、"],["なん"],["の"],["力","ちから"],["も"],["持って","もって"],["いない"],["。"],["彼","かれ"],["ら"],["は"],["神","かみ"],["と"],["キリスト"],["と"],["の"],["祭司","さいし"],["と"],["なり"],["、"],["キリスト"],["と"],["とも"],["に"],["、"],["千","せん"],["年","ねん"],["の"],["間","あいだ"],["王","おう"],["と"],["なる"],["。"]]},{"verse":7,"text":"しかし千年の終わりに、サタンはその牢から解き放され、","tok":[["しかし"],["千","せん"],["年","ねん"],["の"],["終わり","おわり"],["に"],["、"],["サタン"],["は"],["その"],["牢","ろう"],["から"],["解き放され","ときはなされ"],["、"]]},{"verse":8,"text":"地の四方にある諸国の民、すなわち、ゴグとマゴグを惑わすために出て行き、戦いのために彼らを召集する。彼らの数は海べの砂のようである。","tok":[["地","ち"],["の"],["四方","しほう"],["に"],["ある"],["諸国","しょこく"],["の"],["民","たみ"],["、"],["すなわち"],["、"],["ゴグ"],["と"],["マゴグ"],["を"],["惑わす","まどわす"],["ため"],["に"],["出て","でて"],["行き","いき"],["、"],["戦い","たたかい"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["召集","しょうしゅう"],["する"],["。"],["彼","かれ"],["ら"],["の"],["数","かず"],["は"],["海べ","うみべ"],["の"],["砂","すな"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":9,"text":"彼らは、地上の広い平地に上って来て、聖徒たちの陣営と愛された都とを取り囲んだ。すると、天から火が降って来て、彼らを焼き尽くした。","tok":[["彼","かれ"],["ら"],["は"],["、"],["地上","ちじょう"],["の"],["広い","ひろい"],["平地","へいち"],["に"],["上って","のぼって"],["来て","きて"],["、"],["聖徒","せいと"],["たち"],["の"],["陣営","じんえい"],["と"],["愛された","あいされた"],["都","と"],["と"],["を"],["取り囲んだ","とりかこんだ"],["。"],["する"],["と"],["、"],["天","てん"],["から"],["火","ひ"],["が"],["降って","ふって"],["来て","きて"],["、"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くした","つくした"],["。"]]},{"verse":10,"text":"そして、彼らを惑わした悪魔は火と硫黄との池に投げ込まれた。そこは獣も、にせ預言者もいる所で、彼らは永遠に昼も夜も苦しみを受ける。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["を"],["惑わした","まどわした"],["悪魔","あくま"],["は"],["火","ひ"],["と"],["硫黄","いおう"],["と"],["の"],["池","いけ"],["に"],["投げ込まれた","なげこまれた"],["。"],["そこ"],["は"],["獣","けもの"],["も"],["、"],["にせ"],["預言者","よげんしゃ"],["も"],["いる"],["所","ところ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["永遠","えいえん"],["に"],["昼","ひる"],["も"],["夜","よる"],["も"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["。"]]},{"verse":11,"text":"また私は、大きな白い御座と、そこに着座しておられる方を見た。地も天もその御前から逃げ去って、あとかたもなくなった。","tok":[["また"],["私","わたくし"],["は"],["、"],["大きな","おおきな"],["白い","しろい"],["御座","ぎょざ"],["と"],["、"],["そこ"],["に"],["着座","ちゃくざ"],["して"],["おられる"],["方","かた"],["を"],["見た","みた"],["。"],["地","ち"],["も"],["天","てん"],["も"],["その"],["御前","ごぜん"],["から"],["逃げ去って","にげさって"],["、"],["あとかた"],["も"],["なくなった"],["。"]]},{"verse":12,"text":"また私は、死んだ人々が、大きい者も、小さい者も御座の前に立っているのを見た。そして、数々の書物が開かれた。また、別の一つの書物も開かれたが、それは、いのちの書であった。死んだ人々は、これらの書物に書きしるされているところに従って、自分の行いに応じてさばかれた。","tok":[["また"],["私","わたくし"],["は"],["、"],["死んだ","しんだ"],["人々","ひとびと"],["が"],["、"],["大きい","おおきい"],["者","もの"],["も"],["、"],["小さい","ちいさい"],["者","もの"],["も"],["御座","ぎょざ"],["の"],["前","まえ"],["に"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["そして"],["、"],["数々","かずかず"],["の"],["書物","しょもつ"],["が"],["開かれた","ひらかれた"],["。"],["また"],["、"],["別","べつ"],["の"],["一","ひと"],["つ"],["の"],["書物","しょもつ"],["も"],["開かれた","ひらかれた"],["が"],["、"],["それ"],["は"],["、"],["いのち"],["の"],["書","しょ"],["で"],["あった"],["。"],["死んだ","しんだ"],["人々","ひとびと"],["は"],["、"],["これ"],["ら"],["の"],["書物","しょもつ"],["に"],["書きしるされて","かきしるされて"],["いる"],["ところ"],["に"],["従って","したがって"],["、"],["自分","じぶん"],["の"],["行い","おこない"],["に"],["応じて","おうじて"],["さばかれた"],["。"]]},{"verse":13,"text":"海はその中にいる死者を出し、死もハデスも、その中にいる死者を出した。そして人々はおのおの自分の行いに応じてさばかれた。","tok":[["海","うみ"],["は"],["その"],["中","なか"],["に"],["いる"],["死者","ししゃ"],["を"],["出し","だし"],["、"],["死","し"],["も"],["ハデス"],["も"],["、"],["その"],["中","なか"],["に"],["いる"],["死者","ししゃ"],["を"],["出した","だした"],["。"],["そして"],["人々","ひとびと"],["は"],["おのおの"],["自分","じぶん"],["の"],["行い","おこない"],["に"],["応じて","おうじて"],["さばかれた"],["。"]]},{"verse":14,"text":"それから、死とハデスとは、火の池に投げ込まれた。これが第二の死である。","tok":[["それ"],["から"],["、"],["死","し"],["と"],["ハデス"],["と"],["は"],["、"],["火","ひ"],["の"],["池","いけ"],["に"],["投げ込まれた","なげこまれた"],["。"],["これ"],["が"],["第","だい"],["二","に"],["の"],["死","し"],["で"],["ある"],["。"]]},{"verse":15,"text":"いのちの書に名のしるされていない者はみな、この火の池に投げ込まれた。","tok":[["いのち"],["の"],["書","しょ"],["に"],["名","な"],["の"],["しるされて"],["いない"],["者","もの"],["は"],["みな"],["、"],["この"],["火","ひ"],["の"],["池","いけ"],["に"],["投げ込まれた","なげこまれた"],["。"]]}]
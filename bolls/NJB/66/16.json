[{"verse":1,"text":"また、私は、大きな声が聖所から出て、七人の御使いに言うのを聞いた。「行って、神の激しい怒りの七つの鉢を、地に向けてぶちまけよ。」","tok":[["また"],["、"],["私","わたくし"],["は"],["、"],["大きな","おおきな"],["声","こえ"],["が"],["聖","せい"],["所","しょ"],["から"],["出て","でて"],["、"],["七人","しちにん"],["の"],["御使い","おつかい"],["に"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["行って","いって"],["、"],["神","かみ"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["七","なな"],["つ"],["の"],["鉢","ばち"],["を"],["、"],["地","ち"],["に"],["向けて","むけて"],["ぶちまけよ"],["。"],["」"]]},{"verse":2,"text":"そこで、第一の御使いが出て行き、鉢を地に向けてぶちまけた。すると、獣の刻印を受けている人々と、獣の像を拝む人々に、ひどい悪性のはれものができた。","tok":[["そこ"],["で"],["、"],["第","だい"],["一","いち"],["の"],["御使い","おつかい"],["が"],["出て","でて"],["行き","いき"],["、"],["鉢","ばち"],["を"],["地","ち"],["に"],["向けて","むけて"],["ぶちまけた"],["。"],["する"],["と"],["、"],["獣","けもの"],["の"],["刻印","こくいん"],["を"],["受けて","うけて"],["いる"],["人々","ひとびと"],["と"],["、"],["獣","けもの"],["の"],["像","ぞう"],["を"],["拝む","おがむ"],["人々","ひとびと"],["に"],["、"],["ひどい"],["悪性","あくせい"],["の"],["はれもの"],["が"],["できた"],["。"]]},{"verse":3,"text":"第二の御使いが鉢を海にぶちまけた。すると、海は死者の血のような血になった。海の中のいのちのあるものは、みな死んだ。","tok":[["第","だい"],["二","に"],["の"],["御使い","おつかい"],["が"],["鉢","ばち"],["を"],["海","うみ"],["に"],["ぶちまけた"],["。"],["する"],["と"],["、"],["海","うみ"],["は"],["死者","ししゃ"],["の"],["血","ち"],["の"],["よう"],["な"],["血","ち"],["に"],["なった"],["。"],["海","うみ"],["の"],["中","なか"],["の"],["いのち"],["の"],["ある"],["もの"],["は"],["、"],["みな"],["死んだ","しんだ"],["。"]]},{"verse":4,"text":"第三の御使いが鉢を川と水の源とにぶちまけた。すると、それらは血になった。","tok":[["第","だい"],["三","さん"],["の"],["御使い","おつかい"],["が"],["鉢","ばち"],["を"],["川","かわ"],["と"],["水","みず"],["の"],["源","みなもと"],["と"],["に"],["ぶちまけた"],["。"],["する"],["と"],["、"],["それ"],["ら"],["は"],["血","ち"],["に"],["なった"],["。"]]},{"verse":5,"text":"また私は、水をつかさどる御使いがこう言うのを聞いた。「今いまし、昔います聖なる方。あなたは正しい方です。なぜならあなたは、このようなさばきをなさったからです。","tok":[["また"],["私","わたくし"],["は"],["、"],["水","みず"],["を"],["つかさどる"],["御使い","おつかい"],["が"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["今","いま"],["いまし"],["、"],["昔","むかし"],["います"],["聖","せい"],["なる"],["方","かた"],["。"],["あなた"],["は"],["正しい","ただしい"],["方","ほう"],["です"],["。"],["なぜ"],["なら"],["あなた"],["は"],["、"],["この"],["よう"],["な"],["さばき"],["を"],["なさった"],["から"],["です"],["。"]]},{"verse":6,"text":"彼らは聖徒たちや預言者たちの血を流しましたが、あなたは、その血を彼らに飲ませました。彼らは、そうされるにふさわしい者たちです。」","tok":[["彼","かれ"],["ら"],["は"],["聖徒","せいと"],["たち"],["や"],["預言者","よげんしゃ"],["たち"],["の"],["血","ち"],["を"],["流しました","ながしました"],["が"],["、"],["あなた"],["は"],["、"],["その"],["血","ち"],["を"],["彼","かれ"],["ら"],["に"],["飲ませました","のませました"],["。"],["彼","かれ"],["ら"],["は"],["、"],["そう"],["される"],["に"],["ふさわしい"],["者","もの"],["たち"],["です"],["。"],["」"]]},{"verse":7,"text":"また私は、祭壇がこう言うのを聞いた。「しかり。主よ。万物の支配者である神よ。あなたのさばきは真実な、正しいさばきです。」","tok":[["また"],["私","わたくし"],["は"],["、"],["祭壇","さいだん"],["が"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["しかり"],["。"],["主","ぬし"],["よ"],["。"],["万物","ばんぶつ"],["の"],["支配者","しはいしゃ"],["で"],["ある"],["神","かみ"],["よ"],["。"],["あなた"],["の"],["さばき"],["は"],["真実","しんじつ"],["な"],["、"],["正しい","ただしい"],["さばき"],["です"],["。"],["」"]]},{"verse":8,"text":"第四の御使いが鉢を太陽に向けてぶちまけた。すると、太陽は火で人々を焼くことを許された。","tok":[["第","だい"],["四","よん"],["の"],["御使い","おつかい"],["が"],["鉢","ばち"],["を"],["太陽","たいよう"],["に"],["向けて","むけて"],["ぶちまけた"],["。"],["する"],["と"],["、"],["太陽","たいよう"],["は"],["火","ひ"],["で"],["人々","ひとびと"],["を"],["焼く","やく"],["こと"],["を"],["許された","ゆるされた"],["。"]]},{"verse":9,"text":"こうして、人々は激しい炎熱によって焼かれた。しかも、彼らは、これらの災害を支配する権威を持つ神の御名に対してけがしごとを言い、悔い改めて神をあがめることをしなかった。","tok":[["こう"],["して"],["、"],["人々","ひとびと"],["は"],["激しい","はげしい"],["炎熱","えんねつ"],["によって"],["焼かれた","やかれた"],["。"],["しかも"],["、"],["彼","かれ"],["ら"],["は"],["、"],["これ"],["ら"],["の"],["災害","さいがい"],["を"],["支配","しはい"],["する"],["権威","けんい"],["を"],["持つ","もつ"],["神","かみ"],["の"],["御名","ぎょめい"],["に対して","にたいして"],["けが"],["し"],["ごと"],["を"],["言い","いい"],["、"],["悔い改めて","くいあらためて"],["神","かみ"],["を"],["あがめる"],["こと"],["を"],["しなかった"],["。"]]},{"verse":10,"text":"第五の御使いが鉢を獣の座にぶちまけた。すると、獣の国は暗くなり、人々は苦しみのあまり舌をかんだ。","tok":[["第","だい"],["五","ご"],["の"],["御使い","おつかい"],["が"],["鉢","ばち"],["を"],["獣","けもの"],["の"],["座","ざ"],["に"],["ぶちまけた"],["。"],["する"],["と"],["、"],["獣","けもの"],["の"],["国","くに"],["は"],["暗く","くらく"],["なり"],["、"],["人々","ひとびと"],["は"],["苦しみ","くるしみ"],["の"],["あまり"],["舌","した"],["を"],["かんだ"],["。"]]},{"verse":11,"text":"そして、その苦しみと、はれものとのゆえに、天の神に対してけがしごとを言い、自分の行いを悔い改めようとしなかった。","tok":[["そして"],["、"],["その"],["苦しみ","くるしみ"],["と"],["、"],["はれもの"],["と"],["の"],["ゆえ"],["に"],["、"],["天","てん"],["の"],["神","かみ"],["に対して","にたいして"],["けが"],["し"],["ごと"],["を"],["言い","いい"],["、"],["自分","じぶん"],["の"],["行い","おこない"],["を"],["悔い改めよう","くいあらためよう"],["と"],["しなかった"],["。"]]},{"verse":12,"text":"第六の御使いが鉢を大ユーフラテス川にぶちまけた。すると、水は、日の出るほうから来る王たちに道を備えるために、かれてしまった。","tok":[["第","だい"],["六","ろく"],["の"],["御使い","おつかい"],["が"],["鉢","ばち"],["を"],["大","だい"],["ユーフラテス"],["川","かわ"],["に"],["ぶちまけた"],["。"],["する"],["と"],["、"],["水","みず"],["は"],["、"],["日","ひ"],["の"],["出る","でる"],["ほう"],["から"],["来る","くる"],["王","おう"],["たち"],["に"],["道","みち"],["を"],["備える","そなえる"],["ため"],["に"],["、"],["かれて"],["しまった"],["。"]]},{"verse":13,"text":"また、私は竜の口と、獣の口と、にせ預言者の口とから、かえるのような汚れた霊どもが三つ出て来るのを見た。","tok":[["また"],["、"],["私","わたくし"],["は"],["竜","りゅう"],["の"],["口","くち"],["と"],["、"],["獣","けもの"],["の"],["口","くち"],["と"],["、"],["にせ"],["預言者","よげんしゃ"],["の"],["口","くち"],["と"],["から"],["、"],["かえる"],["の"],["よう"],["な"],["汚れた","よごれた"],["霊","れい"],["ども"],["が"],["三","みっ"],["つ"],["出て","でて"],["来る","くる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":14,"text":"彼らはしるしを行う悪霊どもの霊である。彼らは全世界の王たちのところに出て行く。万物の支配者である神の大いなる日の戦いに備えて、彼らを集めるためである。","tok":[["彼","かれ"],["ら"],["は"],["しるし"],["を"],["行う","おこなう"],["悪霊","あくりょう"],["ども"],["の"],["霊","れい"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["全","ぜん"],["世界","せかい"],["の"],["王","おう"],["たち"],["の"],["ところ"],["に"],["出て","でて"],["行く","いく"],["。"],["万物","ばんぶつ"],["の"],["支配者","しはいしゃ"],["で"],["ある"],["神","かみ"],["の"],["大いなる","おおいなる"],["日","ひ"],["の"],["戦い","たたかい"],["に"],["備えて","そなえて"],["、"],["彼","かれ"],["ら"],["を"],["集める","あつめる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"――見よ。わたしは盗人のように来る。目をさまして、身に着物を着け、裸で歩く恥を人に見られないようにする者は幸いである――","tok":[["―"],["―"],["見","み"],["よ"],["。"],["わたし"],["は"],["盗人","ぬすびと"],["の"],["よう"],["に"],["来る","くる"],["。"],["目","め"],["を"],["さまして"],["、"],["身","み"],["に"],["着物","きもの"],["を"],["着け","つけ"],["、"],["裸","はだか"],["で"],["歩く","あるく"],["恥","はじ"],["を"],["人","ひと"],["に"],["見られない","みられない"],["よう"],["に"],["する"],["者","もの"],["は"],["幸い","さいわい"],["で"],["ある"],["―"],["―"]]},{"verse":16,"text":"こうして彼らは、ヘブル語でハルマゲドンと呼ばれる所に王たちを集めた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["ヘブル"],["語","ご"],["で"],["ハルマゲドン"],["と"],["呼ばれる","よばれる"],["所","ところ"],["に"],["王","おう"],["たち"],["を"],["集めた","あつめた"],["。"]]},{"verse":17,"text":"第七の御使いが鉢を空中にぶちまけた。すると、大きな声が御座を出て、聖所の中から出て来て、「事は成就した」と言った。","tok":[["第","だい"],["七","なな"],["の"],["御使い","おつかい"],["が"],["鉢","ばち"],["を"],["空中","くうちゅう"],["に"],["ぶちまけた"],["。"],["する"],["と"],["、"],["大きな","おおきな"],["声","こえ"],["が"],["御座","ぎょざ"],["を"],["出て","でて"],["、"],["聖","せい"],["所","しょ"],["の"],["中","なか"],["から"],["出て","でて"],["来て","きて"],["、"],["「"],["事","こと"],["は"],["成就","じょうじゅ"],["した"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"すると、いなずまと声と雷鳴があり、大きな地震があった。この地震は人間が地上に住んで以来、かつてなかったほどのもので、それほどに大きな、強い地震であった。","tok":[["する"],["と"],["、"],["いなずま"],["と"],["声","こえ"],["と"],["雷鳴","らいめい"],["が"],["あり"],["、"],["大きな","おおきな"],["地震","じしん"],["が"],["あった"],["。"],["この"],["地震","じしん"],["は"],["人間","にんげん"],["が"],["地上","ちじょう"],["に"],["住んで","すんで"],["以来","いらい"],["、"],["かつて"],["なかった"],["ほど"],["の"],["もの"],["で"],["、"],["それ"],["ほど"],["に"],["大きな","おおきな"],["、"],["強い","つよい"],["地震","じしん"],["で"],["あった"],["。"]]},{"verse":19,"text":"また、あの大きな都は三つに裂かれ、諸国の民の町々は倒れた。そして、大バビロンは、神の前に覚えられて、神の激しい怒りのぶどう酒の杯を与えられた。","tok":[["また"],["、"],["あの"],["大きな","おおきな"],["都","と"],["は"],["三","みっ"],["つ"],["に"],["裂かれ","さかれ"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["町々","まちまち"],["は"],["倒れた","たおれた"],["。"],["そして"],["、"],["大","だい"],["バビロン"],["は"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["覚えられて","おぼえられて"],["、"],["神","かみ"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["ぶどう酒","ぶどうしゅ"],["の"],["杯","さかずき"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":20,"text":"島はすべて逃げ去り、山々は見えなくなった。","tok":[["島","しま"],["は"],["すべて"],["逃げ去り","にげさり"],["、"],["山々","やまやま"],["は"],["見えなく","みえなく"],["なった"],["。"]]},{"verse":21,"text":"また、一タラントほどの大きな雹が、人々の上に天から降って来た。人々は、この雹の災害のため、神にけがしごとを言った。その災害が非常に激しかったからである。","tok":[["また"],["、"],["一","いち"],["タラント"],["ほど"],["の"],["大きな","おおきな"],["雹","ひょう"],["が"],["、"],["人々","ひとびと"],["の"],["上","うえ"],["に"],["天","てん"],["から"],["降って","ふって"],["来た","きた"],["。"],["人々","ひとびと"],["は"],["、"],["この"],["雹","ひょう"],["の"],["災害","さいがい"],["の"],["ため"],["、"],["神","かみ"],["に"],["けが"],["し"],["ごと"],["を"],["言った","いった"],["。"],["その"],["災害","さいがい"],["が"],["非常","ひじょう"],["に"],["激しかった","はげしかった"],["から"],["で"],["ある"],["。"]]}]
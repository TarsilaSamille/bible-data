[{"verse":1,"text":"エペソにある教会の御使いに書き送れ。『右手に七つの星を持つ方、七つの金の燭台の間を歩く方が言われる。","tok":[["エペソ"],["に"],["ある"],["教会","きょうかい"],["の"],["御使い","おつかい"],["に"],["書き送れ","かきおくれ"],["。"],["『"],["右手","みぎて"],["に"],["七","なな"],["つ"],["の"],["星","ほし"],["を"],["持つ","もつ"],["方","かた"],["、"],["七","なな"],["つ"],["の"],["金","かね"],["の"],["燭台","しょくだい"],["の"],["間","あいだ"],["を"],["歩く","あるく"],["方","ほう"],["が"],["言われる","いわれる"],["。"]]},{"verse":2,"text":"「わたしは、あなたの行いとあなたの労苦と忍耐を知っている。また、あなたが、悪い者たちをがまんすることができず、使徒と自称しているが実はそうでない者たちをためして、その偽りを見抜いたことも知っている。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["と"],["あなた"],["の"],["労苦","ろうく"],["と"],["忍耐","にんたい"],["を"],["知って","しって"],["いる"],["。"],["また"],["、"],["あなた"],["が"],["、"],["悪い","わるい"],["者","もの"],["たち"],["を"],["がまん"],["する"],["こと"],["が"],["できず"],["、"],["使徒","しと"],["と"],["自称","じしょう"],["して"],["いる"],["が"],["実","じつ"],["は"],["そう"],["で"],["ない"],["者","もの"],["たち"],["を"],["ためして"],["、"],["その"],["偽り","いつわり"],["を"],["見抜いた","みぬいた"],["こと"],["も"],["知って","しって"],["いる"],["。"]]},{"verse":3,"text":"あなたはよく忍耐して、わたしの名のために耐え忍び、疲れたことがなかった。","tok":[["あなた"],["は"],["よく"],["忍耐","にんたい"],["して"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["耐え忍び","たえしのび"],["、"],["疲れた","つかれた"],["こと"],["が"],["なかった"],["。"]]},{"verse":4,"text":"しかし、あなたには非難すべきことがある。あなたは初めの愛から離れてしまった。","tok":[["しかし"],["、"],["あなた"],["に"],["は"],["非難","ひなん"],["すべき"],["こと"],["が"],["ある"],["。"],["あなた"],["は"],["初め","はじめ"],["の"],["愛","あい"],["から"],["離れて","はなれて"],["しまった"],["。"]]},{"verse":5,"text":"それで、あなたは、どこから落ちたかを思い出し、悔い改めて、初めの行いをしなさい。もしそうでなく、悔い改めることをしないならば、わたしは、あなたのところに行って、あなたの燭台をその置かれた所から取りはずしてしまおう。","tok":[["それ"],["で"],["、"],["あなた"],["は"],["、"],["どこ"],["から"],["落ちた","おちた"],["か"],["を"],["思い出し","おもいだし"],["、"],["悔い改めて","くいあらためて"],["、"],["初め","はじめ"],["の"],["行い","おこない"],["を"],["し"],["なさい"],["。"],["もし"],["そう"],["で"],["なく"],["、"],["悔い改める","くいあらためる"],["こと"],["を"],["しないならば"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["ところ"],["に"],["行って","いって"],["、"],["あなた"],["の"],["燭台","しょくだい"],["を"],["その"],["置かれた","おかれた"],["所","ところ"],["から"],["取りはずして","とりはずして"],["しまおう"],["。"]]},{"verse":6,"text":"しかし、あなたにはこのことがある。あなたはニコライ派の人々の行いを憎んでいる。わたしもそれを憎んでいる。","tok":[["しかし"],["、"],["あなた"],["に"],["は"],["この"],["こと"],["が"],["ある"],["。"],["あなた"],["は"],["ニコライ"],["派","は"],["の"],["人々","ひとびと"],["の"],["行い","おこない"],["を"],["憎んで","にくんで"],["いる"],["。"],["わたし"],["も"],["それ"],["を"],["憎んで","にくんで"],["いる"],["。"]]},{"verse":7,"text":"耳のある者は御霊が諸教会に言われることを聞きなさい。勝利を得る者に、わたしは神のパラダイスにあるいのちの木の実を食べさせよう。」』","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["御霊","ごれい"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["言われる","いわれる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["に"],["、"],["わたし"],["は"],["神","かみ"],["の"],["パラダイス"],["に"],["ある"],["いのち"],["の"],["木の実","このみ"],["を"],["食べさせよう","たべさせよう"],["。"],["」"],["』"]]},{"verse":8,"text":"また、スミルナにある教会の御使いに書き送れ。『初めであり、終わりである方、死んで、また生きた方が言われる。","tok":[["また"],["、"],["スミルナ"],["に"],["ある"],["教会","きょうかい"],["の"],["御使い","おつかい"],["に"],["書き送れ","かきおくれ"],["。"],["『"],["初め","はじめ"],["で"],["あり"],["、"],["終わり","おわり"],["で"],["ある"],["方","かた"],["、"],["死んで","しんで"],["、"],["また"],["生きた","いきた"],["方","ほう"],["が"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"「わたしは、あなたの苦しみと貧しさとを知っている。――しかしあなたは実際は富んでいる――またユダヤ人だと自称しているが、実はそうでなく、かえってサタンの会衆である人たちから、ののしられていることも知っている。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["苦しみ","くるしみ"],["と"],["貧し","まずし"],["さ"],["と"],["を"],["知って","しって"],["いる"],["。"],["―"],["―"],["しかし"],["あなた"],["は"],["実際","じっさい"],["は"],["富んで","とんで"],["いる"],["―"],["―"],["また"],["ユダヤ人","ゆだやじん"],["だ"],["と"],["自称","じしょう"],["して"],["いる"],["が"],["、"],["実","じつ"],["は"],["そう"],["で"],["なく"],["、"],["かえって"],["サタン"],["の"],["会衆","かいしゅう"],["で"],["ある"],["人","ひと"],["たち"],["から"],["、"],["ののしられて"],["いる"],["こと"],["も"],["知って","しって"],["いる"],["。"]]},{"verse":10,"text":"あなたが受けようとしている苦しみを恐れてはいけない。見よ。悪魔はあなたがたをためすために、あなたがたのうちのある人たちを牢に投げ入れようとしている。あなたがたは十日の間苦しみを受ける。死に至るまで忠実でありなさい。そうすれば、わたしはあなたにいのちの冠を与えよう。","tok":[["あなた"],["が"],["受けよう","うけよう"],["として"],["いる"],["苦しみ","くるしみ"],["を"],["恐れて","おそれて"],["は"],["いけない"],["。"],["見","み"],["よ"],["。"],["悪魔","あくま"],["は"],["あなた"],["がた"],["を"],["ためす"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["ある"],["人","ひと"],["たち"],["を"],["牢","ろう"],["に"],["投げ入れよう","なげいれよう"],["として"],["いる"],["。"],["あなた"],["がた"],["は"],["十日","とうか"],["の"],["間","あいだ"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["。"],["死","し"],["に"],["至る","いたる"],["まで"],["忠実","ちゅうじつ"],["で"],["あり"],["なさい"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["に"],["いのち"],["の"],["冠","かんむり"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":11,"text":"耳のある者は御霊が諸教会に言われることを聞きなさい。勝利を得る者は、決して第二の死によってそこなわれることはない。」』","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["御霊","ごれい"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["言われる","いわれる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["は"],["、"],["決して","けっして"],["第","だい"],["二","に"],["の"],["死","し"],["によって"],["そこなわれる"],["こと"],["は"],["ない"],["。"],["」"],["』"]]},{"verse":12,"text":"また、ペルガモにある教会の御使いに書き送れ。『鋭い、両刃の剣を持つ方がこう言われる。","tok":[["また"],["、"],["ペルガモ"],["に"],["ある"],["教会","きょうかい"],["の"],["御使い","おつかい"],["に"],["書き送れ","かきおくれ"],["。"],["『"],["鋭い","するどい"],["、"],["両刃","りょうば"],["の"],["剣","けん"],["を"],["持つ","もつ"],["方","かた"],["が"],["こう"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"「わたしは、あなたの住んでいる所を知っている。そこにはサタンの王座がある。しかしあなたは、わたしの名を堅く保って、わたしの忠実な証人アンテパスがサタンの住むあなたがたのところで殺されたときでも、わたしに対する信仰を捨てなかった。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["住んで","すんで"],["いる"],["所","ところ"],["を"],["知って","しって"],["いる"],["。"],["そこ"],["に"],["は"],["サタン"],["の"],["王座","おうざ"],["が"],["ある"],["。"],["しかし"],["あなた"],["は"],["、"],["わたし"],["の"],["名","な"],["を"],["堅く","かたく"],["保って","たもって"],["、"],["わたし"],["の"],["忠実","ちゅうじつ"],["な"],["証人","しょうにん"],["アンテパス"],["が"],["サタン"],["の"],["住む","すむ"],["あなた"],["がた"],["の"],["ところ"],["で"],["殺された","ころされた"],["とき"],["で"],["も"],["、"],["わたし"],["に"],["対する","たいする"],["信仰","しんこう"],["を"],["捨てなかった","すてなかった"],["。"]]},{"verse":14,"text":"しかし、あなたには少しばかり非難すべきことがある。あなたのうちに、バラムの教えを奉じている人々がいる。バラムはバラクに教えて、イスラエルの人々の前に、つまずきの石を置き、偶像の神にささげた物を食べさせ、また不品行を行わせた。","tok":[["しかし"],["、"],["あなた"],["に"],["は"],["少し","すこし"],["ばかり"],["非難","ひなん"],["すべき"],["こと"],["が"],["ある"],["。"],["あなた"],["の"],["うち"],["に"],["、"],["バラム"],["の"],["教え","おしえ"],["を"],["奉じて","ほうじて"],["いる"],["人々","ひとびと"],["が"],["いる"],["。"],["バラム"],["は"],["バラク"],["に"],["教えて","おしえて"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["、"],["つまずき"],["の"],["石","いし"],["を"],["置き","おき"],["、"],["偶像","ぐうぞう"],["の"],["神","かみ"],["に"],["ささげた"],["物","もの"],["を"],["食べさせ","たべさせ"],["、"],["また"],["不品行","ふひんこう"],["を"],["行わせた","おこなわせた"],["。"]]},{"verse":15,"text":"それと同じように、あなたのところにもニコライ派の教えを奉じている人々がいる。","tok":[["それ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["の"],["ところ"],["に"],["も"],["ニコライ"],["派","は"],["の"],["教え","おしえ"],["を"],["奉じて","ほうじて"],["いる"],["人々","ひとびと"],["が"],["いる"],["。"]]},{"verse":16,"text":"だから、悔い改めなさい。もしそうしないなら、わたしは、すぐにあなたのところに行き、わたしの口の剣をもって彼らと戦おう。","tok":[["だ"],["から"],["、"],["悔い改め","くいあらため"],["なさい"],["。"],["もし"],["そう"],["しないなら"],["、"],["わたし"],["は"],["、"],["すぐ"],["に"],["あなた"],["の"],["ところ"],["に"],["行き","いき"],["、"],["わたし"],["の"],["口","くち"],["の"],["剣","けん"],["を"],["もって"],["彼","かれ"],["ら"],["と"],["戦おう","たたかおう"],["。"]]},{"verse":17,"text":"耳のある者は御霊が諸教会に言われることを聞きなさい。わたしは勝利を得る者に隠れたマナを与える。また、彼に白い石を与える。その石には、それを受ける者のほかはだれも知らない、新しい名が書かれている。」』","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["御霊","ごれい"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["言われる","いわれる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["わたし"],["は"],["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["に"],["隠れた","かくれた"],["マナ"],["を"],["与える","あたえる"],["。"],["また"],["、"],["彼","かれ"],["に"],["白い","しろい"],["石","いし"],["を"],["与える","あたえる"],["。"],["その"],["石","いし"],["に"],["は"],["、"],["それ"],["を"],["受ける","うける"],["者","もの"],["の"],["ほか"],["は"],["だれ"],["も"],["知らない","しらない"],["、"],["新しい","あたらしい"],["名","な"],["が"],["書かれて","かかれて"],["いる"],["。"],["」"],["』"]]},{"verse":18,"text":"また、テアテラにある教会の御使いに書き送れ。『燃える炎のような目を持ち、その足は光り輝くしんちゅうのような、神の子が言われる。","tok":[["また"],["、"],["テアテラ"],["に"],["ある"],["教会","きょうかい"],["の"],["御使い","おつかい"],["に"],["書き送れ","かきおくれ"],["。"],["『"],["燃える","もえる"],["炎","ほのお"],["の"],["よう"],["な"],["目","め"],["を"],["持ち","もち"],["、"],["その"],["足","あし"],["は"],["光り輝く","ひかりかがやく"],["しんちゅう"],["の"],["よう"],["な"],["、"],["神","かみ"],["の"],["子","こ"],["が"],["言われる","いわれる"],["。"]]},{"verse":19,"text":"「わたしは、あなたの行いとあなたの愛と信仰と奉仕と忍耐を知っており、また、あなたの近ごろの行いが初めの行いにまさっていることも知っている。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["と"],["あなた"],["の"],["愛","あい"],["と"],["信仰","しんこう"],["と"],["奉仕","ほうし"],["と"],["忍耐","にんたい"],["を"],["知って","しって"],["おり"],["、"],["また"],["、"],["あなた"],["の"],["近ごろ","ちかごろ"],["の"],["行い","おこない"],["が"],["初め","はじめ"],["の"],["行い","おこない"],["に"],["まさって"],["いる"],["こと"],["も"],["知って","しって"],["いる"],["。"]]},{"verse":20,"text":"しかし、あなたには非難すべきことがある。あなたは、イゼベルという女をなすがままにさせている。この女は、預言者だと自称しているが、わたしのしもべたちを教えて誤りに導き、不品行を行わせ、偶像の神にささげた物を食べさせている。","tok":[["しかし"],["、"],["あなた"],["に"],["は"],["非難","ひなん"],["すべき"],["こと"],["が"],["ある"],["。"],["あなた"],["は"],["、"],["イゼベル"],["と"],["いう"],["女","おんな"],["を"],["なす"],["が"],["まま"],["に"],["させて"],["いる"],["。"],["この"],["女","おんな"],["は"],["、"],["預言者","よげんしゃ"],["だ"],["と"],["自称","じしょう"],["して"],["いる"],["が"],["、"],["わたし"],["の"],["しもべ"],["たち"],["を"],["教えて","おしえて"],["誤り","あやまり"],["に"],["導き","みちびき"],["、"],["不品行","ふひんこう"],["を"],["行わせ","おこなわせ"],["、"],["偶像","ぐうぞう"],["の"],["神","かみ"],["に"],["ささげた"],["物","もの"],["を"],["食べさせて","たべさせて"],["いる"],["。"]]},{"verse":21,"text":"わたしは悔い改める機会を与えたが、この女は不品行を悔い改めようとしない。","tok":[["わたし"],["は"],["悔い改める","くいあらためる"],["機会","きかい"],["を"],["与えた","あたえた"],["が"],["、"],["この"],["女","おんな"],["は"],["不品行","ふひんこう"],["を"],["悔い改めよう","くいあらためよう"],["と"],["しない"],["。"]]},{"verse":22,"text":"見よ。わたしは、この女を病の床に投げ込もう。また、この女と姦淫を行う者たちも、この女の行いを離れて悔い改めなければ、大きな患難の中に投げ込もう。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["この"],["女","おんな"],["を"],["病","やまい"],["の"],["床","ゆか"],["に"],["投げ込もう","なげこもう"],["。"],["また"],["、"],["この"],["女","おんな"],["と"],["姦淫","かんいん"],["を"],["行う","おこなう"],["者","もの"],["たち"],["も"],["、"],["この"],["女","おんな"],["の"],["行い","おこない"],["を"],["離れて","はなれて"],["悔い改めなければ","くいあらためなければ"],["、"],["大きな","おおきな"],["患難","かんなん"],["の"],["中","なか"],["に"],["投げ込もう","なげこもう"],["。"]]},{"verse":23,"text":"また、わたしは、この女の子どもたちをも死病によって殺す。こうして全教会は、わたしが人の思いと心を探る者であることを知るようになる。また、わたしは、あなたがたの行いに応じてひとりひとりに報いよう。","tok":[["また"],["、"],["わたし"],["は"],["、"],["この"],["女","おんな"],["の"],["子ども","こども"],["たち"],["を"],["も"],["死病","しびょう"],["によって"],["殺す","ころす"],["。"],["こう"],["して"],["全教","ぜんきょう"],["会","かい"],["は"],["、"],["わたし"],["が"],["人","ひと"],["の"],["思い","おもい"],["と"],["心","こころ"],["を"],["探る","さぐる"],["者","もの"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["また"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["行い","おこない"],["に"],["応じて","おうじて"],["ひとりひとり"],["に"],["報いよう","むくいよう"],["。"]]},{"verse":24,"text":"しかし、テアテラにいる人たちの中で、この教えを受け入れておらず、彼らの言うサタンの深いところをまだ知っていないあなたがたに言う。わたしはあなたがたに、ほかの重荷を負わせない。","tok":[["しかし"],["、"],["テアテラ"],["に"],["いる"],["人","ひと"],["たち"],["の"],["中","なか"],["で"],["、"],["この"],["教え","おしえ"],["を"],["受け入れて","うけいれて"],["おらず"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["サタン"],["の"],["深い","ふかい"],["ところ"],["を"],["まだ"],["知って","しって"],["いない"],["あなた"],["がた"],["に"],["言う","ゆう"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["ほか"],["の"],["重荷","おもに"],["を"],["負わせない","おわせない"],["。"]]},{"verse":25,"text":"ただ、あなたがたの持っているものを、わたしが行くまで、しっかりと持っていなさい。","tok":[["ただ"],["、"],["あなた"],["がた"],["の"],["持って","もって"],["いる"],["もの"],["を"],["、"],["わたし"],["が"],["行く","いく"],["まで"],["、"],["しっかり"],["と"],["持って","もって"],["い"],["なさい"],["。"]]},{"verse":26,"text":"勝利を得る者、また最後までわたしのわざを守る者には、諸国の民を支配する権威を与えよう。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["、"],["また"],["最後","さいご"],["まで"],["わたし"],["の"],["わざ"],["を"],["守る","まもる"],["者","もの"],["に"],["は"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["支配","しはい"],["する"],["権威","けんい"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":27,"text":"彼は、鉄の杖をもって土の器を打ち砕くようにして彼らを治める。わたし自身が父から支配の権威を受けているのと同じである。","tok":[["彼","かれ"],["は"],["、"],["鉄","てつ"],["の"],["杖","つえ"],["を"],["もって"],["土","つち"],["の"],["器","うつわ"],["を"],["打ち砕く","うちくだく"],["よう"],["に"],["して"],["彼","かれ"],["ら"],["を"],["治める","おさめる"],["。"],["わたし"],["自身","じしん"],["が"],["父","ちち"],["から"],["支配","しはい"],["の"],["権威","けんい"],["を"],["受けて","うけて"],["いる"],["の"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":28,"text":"また、彼に明けの明星を与えよう。","tok":[["また"],["、"],["彼","かれ"],["に"],["明け","あけ"],["の"],["明星","みょうじょう"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":29,"text":"耳のある者は御霊が諸教会に言われることを聞きなさい。」』","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["御霊","ごれい"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["言われる","いわれる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["」"],["』"]]}]
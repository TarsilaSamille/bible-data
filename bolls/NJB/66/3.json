[{"verse":1,"text":"また、サルデスにある教会の御使いに書き送れ。『神の七つの御霊、および七つの星を持つ方がこう言われる。「わたしは、あなたの行いを知っている。あなたは、生きているとされているが、実は死んでいる。","tok":[["また"],["、"],["サルデス"],["に"],["ある"],["教会","きょうかい"],["の"],["御使い","おつかい"],["に"],["書き送れ","かきおくれ"],["。"],["『"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["御霊","ごれい"],["、"],["および"],["七","なな"],["つ"],["の"],["星","ほし"],["を"],["持つ","もつ"],["方","かた"],["が"],["こう"],["言われる","いわれる"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["を"],["知って","しって"],["いる"],["。"],["あなた"],["は"],["、"],["生きて","いきて"],["いる"],["と"],["されて"],["いる"],["が"],["、"],["実","じつ"],["は"],["死んで","しんで"],["いる"],["。"]]},{"verse":2,"text":"目をさましなさい。そして死にかけているほかの人たちを力づけなさい。わたしは、あなたの行いが、わたしの神の御前に全うされたとは見ていない。","tok":[["目","め"],["を"],["さまし"],["なさい"],["。"],["そして"],["死","し"],["に"],["かけて"],["いる"],["ほか"],["の"],["人","ひと"],["たち"],["を"],["力づけ","ちからづけ"],["なさい"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["が"],["、"],["わたし"],["の"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["全う","まっとう"],["された"],["と"],["は"],["見て","みて"],["いない"],["。"]]},{"verse":3,"text":"だから、あなたがどのように受け、また聞いたのかを思い出しなさい。それを堅く守り、また悔い改めなさい。もし、目をさまさなければ、わたしは盗人のように来る。あなたには、わたしがいつあなたのところに来るか、決してわからない。","tok":[["だ"],["から"],["、"],["あなた"],["が"],["どの"],["よう"],["に"],["受け","うけ"],["、"],["また"],["聞いた","きいた"],["の"],["か"],["を"],["思い出し","おもいだし"],["なさい"],["。"],["それ"],["を"],["堅く","かたく"],["守り","まもり"],["、"],["また"],["悔い改め","くいあらため"],["なさい"],["。"],["もし"],["、"],["目","め"],["を"],["さまさなければ"],["、"],["わたし"],["は"],["盗人","ぬすびと"],["の"],["よう"],["に"],["来る","くる"],["。"],["あなた"],["に"],["は"],["、"],["わたし"],["が"],["いつ"],["あなた"],["の"],["ところ"],["に"],["来る","くる"],["か"],["、"],["決して","けっして"],["わからない"],["。"]]},{"verse":4,"text":"しかし、サルデスには、その衣を汚さなかった者が幾人かいる。彼らは白い衣を着て、わたしとともに歩む。彼らはそれにふさわしい者だからである。","tok":[["しかし"],["、"],["サルデス"],["に"],["は"],["、"],["その"],["衣","ころも"],["を"],["汚さなかった","よごさなかった"],["者","もの"],["が"],["幾人","いくにん"],["か"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["白い","しろい"],["衣","ころも"],["を"],["着て","きて"],["、"],["わたし"],["と"],["とも"],["に"],["歩む","あゆむ"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["に"],["ふさわしい"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"勝利を得る者は、このように白い衣を着せられる。そして、わたしは、彼の名をいのちの書から消すようなことは決してしない。わたしは彼の名をわたしの父の御前と御使いたちの前で言い表す。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["は"],["、"],["この"],["よう"],["に"],["白い","しろい"],["衣","ころも"],["を"],["着せられる","きせられる"],["。"],["そして"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["の"],["名","な"],["を"],["いのち"],["の"],["書","しょ"],["から"],["消す","けす"],["よう"],["な"],["こと"],["は"],["決して","けっして"],["しない"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["名","な"],["を"],["わたし"],["の"],["父","ちち"],["の"],["御前","ごぜん"],["と"],["御使い","おつかい"],["たち"],["の"],["前","まえ"],["で"],["言い表す","いいあらわす"],["。"]]},{"verse":6,"text":"耳のある者は御霊が諸教会に言われることを聞きなさい。」』","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["御霊","ごれい"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["言われる","いわれる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["」"],["』"]]},{"verse":7,"text":"また、フィラデルフィヤにある教会の御使いに書き送れ。『聖なる方、真実な方、ダビデのかぎを持っている方、彼が開くとだれも閉じる者がなく、彼が閉じるとだれも開く者がない、その方がこう言われる。","tok":[["また"],["、"],["フィラデルフィヤ"],["に"],["ある"],["教会","きょうかい"],["の"],["御使い","おつかい"],["に"],["書き送れ","かきおくれ"],["。"],["『"],["聖","せい"],["なる"],["方","かた"],["、"],["真実","しんじつ"],["な"],["方","かた"],["、"],["ダビデ"],["の"],["かぎ"],["を"],["持って","もって"],["いる"],["方","かた"],["、"],["彼","かれ"],["が"],["開く","ひらく"],["と"],["だれ"],["も"],["閉じる","とじる"],["者","もの"],["が"],["なく"],["、"],["彼","かれ"],["が"],["閉じる","とじる"],["と"],["だれ"],["も"],["開く","ひらく"],["者","もの"],["が"],["ない"],["、"],["その"],["方","ほう"],["が"],["こう"],["言われる","いわれる"],["。"]]},{"verse":8,"text":"「わたしは、あなたの行いを知っている。見よ。わたしは、だれも閉じることのできない門を、あなたの前に開いておいた。なぜなら、あなたには少しばかりの力があって、わたしのことばを守り、わたしの名を否まなかったからである。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["を"],["知って","しって"],["いる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["だれ"],["も"],["閉じる","とじる"],["こと"],["の"],["できない"],["門","もん"],["を"],["、"],["あなた"],["の"],["前","まえ"],["に"],["開いて","ひらいて"],["おいた"],["。"],["なぜ"],["なら"],["、"],["あなた"],["に"],["は"],["少し","すこし"],["ばかり"],["の"],["力","ちから"],["が"],["あって"],["、"],["わたし"],["の"],["ことば"],["を"],["守り","まもり"],["、"],["わたし"],["の"],["名","な"],["を"],["否まなかった","いなまなかった"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"見よ。サタンの会衆に属する者、すなわち、ユダヤ人だと自称しながら実はそうでなくて、うそを言っている者たちに、わたしはこうする。見よ。彼らをあなたの足もとに来てひれ伏させ、わたしがあなたを愛していることを知らせる。","tok":[["見","み"],["よ"],["。"],["サタン"],["の"],["会衆","かいしゅう"],["に"],["属する","ぞくする"],["者","もの"],["、"],["すなわち"],["、"],["ユダヤ人","ゆだやじん"],["だ"],["と"],["自称","じしょう"],["し"],["ながら"],["実","じつ"],["は"],["そう"],["で"],["なくて"],["、"],["うそ"],["を"],["言って","いって"],["いる"],["者","もの"],["たち"],["に"],["、"],["わたし"],["は"],["こう"],["する"],["。"],["見","み"],["よ"],["。"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["足もと","あしもと"],["に"],["来て","きて"],["ひれ伏させ","ひれふさせ"],["、"],["わたし"],["が"],["あなた"],["を"],["愛して","あいして"],["いる"],["こと"],["を"],["知らせる","しらせる"],["。"]]},{"verse":10,"text":"あなたが、わたしの忍耐について言ったことばを守ったから、わたしも、地上に住む者たちを試みるために、全世界に来ようとしている試練の時には、あなたを守ろう。","tok":[["あなた"],["が"],["、"],["わたし"],["の"],["忍耐","にんたい"],["について"],["言った","いった"],["ことば"],["を"],["守った","まもった"],["から"],["、"],["わたし"],["も"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["者","もの"],["たち"],["を"],["試みる","こころみる"],["ため"],["に"],["、"],["全","ぜん"],["世界","せかい"],["に"],["来よう","こよう"],["として"],["いる"],["試練","しれん"],["の"],["時","とき"],["に"],["は"],["、"],["あなた"],["を"],["守ろう","まもろう"],["。"]]},{"verse":11,"text":"わたしは、すぐに来る。あなたの冠をだれにも奪われないように、あなたの持っているものをしっかりと持っていなさい。","tok":[["わたし"],["は"],["、"],["すぐ"],["に"],["来る","くる"],["。"],["あなた"],["の"],["冠","かんむり"],["を"],["だれ"],["に"],["も"],["奪われない","うばわれない"],["よう"],["に"],["、"],["あなた"],["の"],["持って","もって"],["いる"],["もの"],["を"],["しっかり"],["と"],["持って","もって"],["い"],["なさい"],["。"]]},{"verse":12,"text":"勝利を得る者を、わたしの神の聖所の柱としよう。彼はもはや決して外に出て行くことはない。わたしは彼の上にわたしの神の御名と、わたしの神の都、すなわち、わたしの神のもとを出て天から下って来る新しいエルサレムの名と、わたしの新しい名とを書きしるす。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["を"],["、"],["わたし"],["の"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["の"],["柱","はしら"],["と"],["しよう"],["。"],["彼","かれ"],["は"],["もはや"],["決して","けっして"],["外","そと"],["に"],["出て","でて"],["行く","いく"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["上","うえ"],["に"],["わたし"],["の"],["神","かみ"],["の"],["御名","ぎょめい"],["と"],["、"],["わたし"],["の"],["神","かみ"],["の"],["都","と"],["、"],["すなわち"],["、"],["わたし"],["の"],["神","かみ"],["の"],["もと"],["を"],["出て","でて"],["天","てん"],["から"],["下って","くだって"],["来る","くる"],["新しい","あたらしい"],["エルサレム"],["の"],["名","な"],["と"],["、"],["わたし"],["の"],["新しい","あたらしい"],["名","な"],["と"],["を"],["書きしるす","かきしるす"],["。"]]},{"verse":13,"text":"耳のある者は御霊が諸教会に言われることを聞きなさい。」』","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["御霊","ごれい"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["言われる","いわれる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["」"],["』"]]},{"verse":14,"text":"また、ラオデキヤにある教会の御使いに書き送れ。『アーメンである方、忠実で、真実な証人、神に造られたものの根源である方がこう言われる。","tok":[["また"],["、"],["ラオデキヤ"],["に"],["ある"],["教会","きょうかい"],["の"],["御使い","おつかい"],["に"],["書き送れ","かきおくれ"],["。"],["『"],["アーメン"],["で"],["ある"],["方","かた"],["、"],["忠実","ちゅうじつ"],["で"],["、"],["真実","しんじつ"],["な"],["証人","しょうにん"],["、"],["神","かみ"],["に"],["造られた","つくられた"],["もの"],["の"],["根源","こんげん"],["で"],["ある"],["方","かた"],["が"],["こう"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"「わたしは、あなたの行いを知っている。あなたは、冷たくもなく、熱くもない。わたしはむしろ、あなたが冷たいか、熱いかであってほしい。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["を"],["知って","しって"],["いる"],["。"],["あなた"],["は"],["、"],["冷たく","つめたく"],["も"],["なく"],["、"],["熱く","あつく"],["も"],["ない"],["。"],["わたし"],["は"],["むしろ"],["、"],["あなた"],["が"],["冷たい","つめたい"],["か"],["、"],["熱い","あつい"],["か"],["で"],["あって"],["ほしい"],["。"]]},{"verse":16,"text":"このように、あなたはなまぬるく、熱くも冷たくもないので、わたしの口からあなたを吐き出そう。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["は"],["なまぬるく"],["、"],["熱く","あつく"],["も"],["冷たく","つめたく"],["も"],["ない"],["ので"],["、"],["わたし"],["の"],["口","くち"],["から"],["あなた"],["を"],["吐き出そう","はきだそう"],["。"]]},{"verse":17,"text":"あなたは、自分は富んでいる、豊かになった、乏しいものは何もないと言って、実は自分がみじめで、哀れで、貧しくて、盲目で、裸の者であることを知らない。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["は"],["富んで","とんで"],["いる"],["、"],["豊か","ゆたか"],["に"],["なった"],["、"],["乏しい","とぼしい"],["もの"],["は"],["何","なん"],["も"],["ない"],["と"],["言って","いって"],["、"],["実","じつ"],["は"],["自分","じぶん"],["が"],["みじめ"],["で"],["、"],["哀れ","あわれ"],["で"],["、"],["貧しくて","まずしくて"],["、"],["盲目","もうもく"],["で"],["、"],["裸","はだか"],["の"],["者","もの"],["で"],["ある"],["こと"],["を"],["知らない","しらない"],["。"]]},{"verse":18,"text":"わたしはあなたに忠告する。豊かな者となるために、火で精錬された金をわたしから買いなさい。また、あなたの裸の恥を現さないために着る白い衣を買いなさい。また、目が見えるようになるため、目に塗る目薬を買いなさい。","tok":[["わたし"],["は"],["あなた"],["に"],["忠告","ちゅうこく"],["する"],["。"],["豊か","ゆたか"],["な"],["者","もの"],["と"],["なる"],["ため"],["に"],["、"],["火","ひ"],["で"],["精錬","せいれん"],["された"],["金","かね"],["を"],["わたし"],["から"],["買い","かい"],["なさい"],["。"],["また"],["、"],["あなた"],["の"],["裸","はだか"],["の"],["恥","はじ"],["を"],["現さない","あらわさない"],["ため"],["に"],["着る","きる"],["白い","しろい"],["衣","ころも"],["を"],["買い","かい"],["なさい"],["。"],["また"],["、"],["目","め"],["が"],["見える","みえる"],["よう"],["に"],["なる"],["ため"],["、"],["目","め"],["に"],["塗る","ぬる"],["目薬","めぐすり"],["を"],["買い","かい"],["なさい"],["。"]]},{"verse":19,"text":"わたしは、愛する者をしかったり、懲らしめたりする。だから、熱心になって、悔い改めなさい。","tok":[["わたし"],["は"],["、"],["愛する","あいする"],["者","もの"],["を"],["しかっ"],["たり"],["、"],["懲らしめ","こらしめ"],["たり"],["する"],["。"],["だ"],["から"],["、"],["熱心","ねっしん"],["に"],["なって"],["、"],["悔い改め","くいあらため"],["なさい"],["。"]]},{"verse":20,"text":"見よ。わたしは、戸の外に立ってたたく。だれでも、わたしの声を聞いて戸をあけるなら、わたしは、彼のところに入って、彼とともに食事をし、彼もわたしとともに食事をする。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["戸","と"],["の"],["外","そと"],["に"],["立って","たって"],["たたく"],["。"],["だれ"],["で"],["も"],["、"],["わたし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["戸","と"],["を"],["あけるなら"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["の"],["ところ"],["に"],["入って","はいって"],["、"],["彼","かれ"],["と"],["とも"],["に"],["食事","しょくじ"],["を"],["し"],["、"],["彼","かれ"],["も"],["わたし"],["と"],["とも"],["に"],["食事","しょくじ"],["を"],["する"],["。"]]},{"verse":21,"text":"勝利を得る者を、わたしとともにわたしの座に着かせよう。それは、わたしが勝利を得て、わたしの父とともに父の御座に着いたのと同じである。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["を"],["、"],["わたし"],["と"],["とも"],["に"],["わたし"],["の"],["座","ざ"],["に"],["着かせよう","つかせよう"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["勝利","しょうり"],["を"],["得て","えて"],["、"],["わたし"],["の"],["父","ちち"],["と"],["とも"],["に"],["父","ちち"],["の"],["御座","ぎょざ"],["に"],["着いた","ついた"],["の"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":22,"text":"耳のある者は御霊が諸教会に言われることを聞きなさい。」』」","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["御霊","ごれい"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["言われる","いわれる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["」"],["』"],["」"]]}]
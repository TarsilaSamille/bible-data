[{"verse":1,"text":"主はこう仰せられる。／「モアブの犯した三つのそむきの罪、四つのそむきの罪のために、わたしはその刑罰を取り消さない。／彼がエドムの王の骨を焼いて灰にしたからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["モアブ"],["の"],["犯した","おかした"],["三","みっ"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["その"],["刑罰","けいばつ"],["を"],["取り消さない","とりけさない"],["。"],["／"],["彼","かれ"],["が"],["エドム"],["の"],["王","おう"],["の"],["骨","ほね"],["を"],["焼いて","やいて"],["灰","はい"],["に"],["した"],["から"],["だ"],["。"]]},{"verse":2,"text":"わたしはモアブに火を送ろう。／火はケリヨテの宮殿を焼き尽くす。／モアブは、どよめきのうちに、角笛の音と、ときの声のうちに死ぬ。","tok":[["わたし"],["は"],["モアブ"],["に"],["火","ひ"],["を"],["送ろう","おくろう"],["。"],["／"],["火","ひ"],["は"],["ケリヨテ"],["の"],["宮殿","きゅうでん"],["を"],["焼き","やき"],["尽くす","つくす"],["。"],["／"],["モアブ"],["は"],["、"],["どよめき"],["の"],["うち"],["に"],["、"],["角笛","つのぶえ"],["の"],["音","おと"],["と"],["、"],["とき"],["の"],["声","こえ"],["の"],["うち"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":3,"text":"わたしはさばきつかさを／そのうちから断ち滅ぼし、そのすべての首長たちを、彼とともに切り殺す」と主は仰せられる。","tok":[["わたし"],["は"],["さばき"],["つかさ"],["を"],["／"],["その"],["うち"],["から"],["断ち","たち"],["滅ぼし","ほろぼし"],["、"],["その"],["すべて"],["の"],["首長","しゅちょう"],["たち"],["を"],["、"],["彼","かれ"],["と"],["とも"],["に"],["切り殺す","きりころす"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":4,"text":"主はこう仰せられる。／「ユダの犯した三つのそむきの罪、四つのそむきの罪のために、わたしはその刑罰を取り消さない。／彼らが主のおしえを捨て、そのおきてを守らず、彼らの先祖たちが従ったまやかしものが／彼らを惑わしたからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["ユダ"],["の"],["犯した","おかした"],["三","みっ"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["その"],["刑罰","けいばつ"],["を"],["取り消さない","とりけさない"],["。"],["／"],["彼","かれ"],["ら"],["が"],["主","ぬし"],["の"],["おしえ"],["を"],["捨て","すて"],["、"],["その"],["おきて"],["を"],["守らず","まもらず"],["、"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["が"],["従った","したがった"],["まやかし"],["もの"],["が"],["／"],["彼","かれ"],["ら"],["を"],["惑わした","まどわした"],["から"],["だ"],["。"]]},{"verse":5,"text":"わたしはユダに火を送ろう。／火はエルサレムの宮殿を焼き尽くす。」","tok":[["わたし"],["は"],["ユダ"],["に"],["火","ひ"],["を"],["送ろう","おくろう"],["。"],["／"],["火","ひ"],["は"],["エルサレム"],["の"],["宮殿","きゅうでん"],["を"],["焼き","やき"],["尽くす","つくす"],["。"],["」"]]},{"verse":6,"text":"主はこう仰せられる。／「イスラエルの犯した三つのそむきの罪、四つのそむきの罪のために、わたしはその刑罰を取り消さない。／彼らが金と引き換えに正しい者を売り、一足のくつのために貧しい者を売ったからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["イスラエル"],["の"],["犯した","おかした"],["三","みっ"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["その"],["刑罰","けいばつ"],["を"],["取り消さない","とりけさない"],["。"],["／"],["彼","かれ"],["ら"],["が"],["金","かね"],["と"],["引き換え","ひきかえ"],["に"],["正しい","ただしい"],["者","もの"],["を"],["売り","うり"],["、"],["一足","ひとあし"],["の"],["くつ"],["の"],["ため"],["に"],["貧しい","まずしい"],["者","もの"],["を"],["売った","うった"],["から"],["だ"],["。"]]},{"verse":7,"text":"彼らは弱い者の頭を地のちりに踏みつけ、貧しい者の道を曲げ、父と子が同じ女のところに通って、わたしの聖なる名を汚している。","tok":[["彼","かれ"],["ら"],["は"],["弱い","よわい"],["者","もの"],["の"],["頭","あたま"],["を"],["地","ち"],["の"],["ちり"],["に"],["踏みつけ","ふみつけ"],["、"],["貧しい","まずしい"],["者","もの"],["の"],["道","みち"],["を"],["曲げ","まげ"],["、"],["父","ちち"],["と"],["子","こ"],["が"],["同じ","おなじ"],["女","おんな"],["の"],["ところ"],["に"],["通って","かよって"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚して","よごして"],["いる"],["。"]]},{"verse":8,"text":"彼らは、すべての祭壇のそばで、質に取った着物の上に横たわり、罰金で取り立てたぶどう酒を／彼らの神の宮で飲んでいる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["すべて"],["の"],["祭壇","さいだん"],["の"],["そば"],["で"],["、"],["質","しつ"],["に"],["取った","とった"],["着物","きもの"],["の"],["上","うえ"],["に"],["横たわり","よこたわり"],["、"],["罰金","ばっきん"],["で"],["取り立てた","とりたてた"],["ぶどう酒","ぶどうしゅ"],["を"],["／"],["彼","かれ"],["ら"],["の"],["神","かみ"],["の"],["宮","みや"],["で"],["飲んで","のんで"],["いる"],["。"]]},{"verse":9,"text":"エモリ人を彼らの前から滅ぼしたのは、このわたしだ。／彼らの背たけは杉の木のように高く、樫の木のように強かった。／しかし、わたしは／その上の実と下の根とを滅ぼした。","tok":[["エモリ"],["人","ひと"],["を"],["彼","かれ"],["ら"],["の"],["前","まえ"],["から"],["滅ぼした","ほろぼした"],["の"],["は"],["、"],["この"],["わたし"],["だ"],["。"],["／"],["彼","かれ"],["ら"],["の"],["背たけ","せたけ"],["は"],["杉","すぎ"],["の"],["木","き"],["の"],["よう"],["に"],["高く","たかく"],["、"],["樫","かし"],["の"],["木","き"],["の"],["よう"],["に"],["強かった","つよかった"],["。"],["／"],["しかし"],["、"],["わたし"],["は"],["／"],["その"],["上","うえ"],["の"],["実","じつ"],["と"],["下","した"],["の"],["根","ね"],["と"],["を"],["滅ぼした","ほろぼした"],["。"]]},{"verse":10,"text":"あなたがたをエジプトの地から連れ上り、荒野の中で四十年間あなたがたを導き、エモリ人の地を所有させたのは、このわたしだ。","tok":[["あなた"],["がた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ上り","つれのぼり"],["、"],["荒野","こうや"],["の"],["中","なか"],["で"],["四十","よんじゅう"],["年間","ねんかん"],["あなた"],["がた"],["を"],["導き","みちびき"],["、"],["エモリ人","えもりにん"],["の"],["地","ち"],["を"],["所有","しょゆう"],["させた"],["の"],["は"],["、"],["この"],["わたし"],["だ"],["。"]]},{"verse":11,"text":"わたしは、あなたがたの子たちから／預言者を起こし、あなたがたの若者から、ナジル人を起こした。／イスラエルの子らよ。／そうではなかったのか。――主の御告げ――","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["子","こ"],["たち"],["から"],["／"],["預言者","よげんしゃ"],["を"],["起こし","おこし"],["、"],["あなた"],["がた"],["の"],["若者","わかもの"],["から"],["、"],["ナジル人","なじるにん"],["を"],["起こした","おこした"],["。"],["／"],["イスラエル"],["の"],["子","こ"],["ら"],["よ"],["。"],["／"],["そう"],["で"],["は"],["なかった"],["の"],["か"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":12,"text":"それなのに、あなたがたはナジル人に酒を飲ませ、預言者には、命じて、預言するなと言った。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["ナジル人","なじるにん"],["に"],["酒","さけ"],["を"],["飲ませ","のませ"],["、"],["預言者","よげんしゃ"],["に"],["は"],["、"],["命じて","めいじて"],["、"],["預言","よげん"],["する"],["な"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"見よ。束を満載した車が押さえつけるように、わたしはあなたがたを押さえつける。","tok":[["見","み"],["よ"],["。"],["束","たば"],["を"],["満載","まんさい"],["した"],["車","くるま"],["が"],["押さえつける","おさえつける"],["よう"],["に"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["押さえつける","おさえつける"],["。"]]},{"verse":14,"text":"足の速い者も逃げ場を失い、強い者も力をふるうことができず、勇士もいのちを救うことができない。","tok":[["足","あし"],["の"],["速い","はやい"],["者","もの"],["も"],["逃げ場","にげば"],["を"],["失い","うしない"],["、"],["強い","つよい"],["者","もの"],["も"],["力","ちから"],["を"],["ふるう"],["こと"],["が"],["できず"],["、"],["勇士","ゆうし"],["も"],["いのち"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"]]},{"verse":15,"text":"弓を取る者も立っていることができず、足の速い者ものがれることができず、馬に乗る者もいのちを救うことができない。","tok":[["弓","ゆみ"],["を"],["取る","とる"],["者","もの"],["も"],["立って","たって"],["いる"],["こと"],["が"],["できず"],["、"],["足","あし"],["の"],["速い","はやい"],["者","もの"],["も"],["のがれる"],["こと"],["が"],["できず"],["、"],["馬","うま"],["に"],["乗る","のる"],["者","もの"],["も"],["いのち"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"]]},{"verse":16,"text":"勇士の中の強い者も、その日には裸で逃げる。／――主の御告げ――」","tok":[["勇士","ゆうし"],["の"],["中","なか"],["の"],["強い","つよい"],["者","もの"],["も"],["、"],["その"],["日","ひ"],["に"],["は"],["裸","はだか"],["で"],["逃げる","にげる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]}]
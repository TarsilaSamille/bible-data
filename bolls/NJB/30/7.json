[{"verse":1,"text":"神である主は、私にこのように示された。見よ。王が刈り取ったあとの二番草が生え始めたころ、主はいなごを造っておられた。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["私","わたくし"],["に"],["この"],["よう"],["に"],["示された","しめされた"],["。"],["見","み"],["よ"],["。"],["王","おう"],["が"],["刈り取った","かりとった"],["あと"],["の"],["二","に"],["番草","ばんそう"],["が"],["生え","はえ"],["始めた","はじめた"],["ころ"],["、"],["主","ぬし"],["は"],["いなご"],["を"],["造って","つくって"],["おられた"],["。"]]},{"verse":2,"text":"そのいなごが地の青草を食い尽くそうとしたとき、私は言った。「神、主よ。どうぞお赦しください。ヤコブはどうして生き残れましょう。彼は小さいのです。」","tok":[["その"],["いなご"],["が"],["地","ち"],["の"],["青草","あおくさ"],["を"],["食い","くい"],["尽くそう","つくそう"],["と"],["した"],["とき"],["、"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["どうぞ"],["お赦し","おゆるし"],["ください"],["。"],["ヤコブ"],["は"],["どう"],["して"],["生き残れましょう","いきのこれましょう"],["。"],["彼","かれ"],["は"],["小さい","ちいさい"],["の"],["です"],["。"],["」"]]},{"verse":3,"text":"主はこのことについて思い直し、「そのことは起こらない」と主は仰せられた。","tok":[["主","ぬし"],["は"],["この"],["こと"],["について"],["思い直し","おもいなおし"],["、"],["「"],["その"],["こと"],["は"],["起こらない","おこらない"],["」"],["と"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"]]},{"verse":4,"text":"神である主は、私にこのように示された。見よ。神である主は燃える火を呼んでおられた。火は大淵を焼き尽くし、割り当て地を焼き尽くそうとしていた。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["私","わたくし"],["に"],["この"],["よう"],["に"],["示された","しめされた"],["。"],["見","み"],["よ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["燃える","もえる"],["火","ひ"],["を"],["呼んで","よんで"],["おられた"],["。"],["火","ひ"],["は"],["大淵","おおふち"],["を"],["焼き","やき"],["尽くし","つくし"],["、"],["割り当て","わりあて"],["地","ち"],["を"],["焼き","やき"],["尽くそう","つくそう"],["として"],["いた"],["。"]]},{"verse":5,"text":"私は言った。「神、主よ。どうか、おやめください。ヤコブはどうして生き残れましょう。彼は小さいのです。」","tok":[["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["、"],["おやめ"],["ください"],["。"],["ヤコブ"],["は"],["どう"],["して"],["生き残れましょう","いきのこれましょう"],["。"],["彼","かれ"],["は"],["小さい","ちいさい"],["の"],["です"],["。"],["」"]]},{"verse":6,"text":"主はこのことについて思い直し、「このことも起こらない」と／神である主は仰せられた。","tok":[["主","ぬし"],["は"],["この"],["こと"],["について"],["思い直し","おもいなおし"],["、"],["「"],["この"],["こと"],["も"],["起こらない","おこらない"],["」"],["と"],["／"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"]]},{"verse":7,"text":"主は私にこのように示された。見よ。主は手に重りなわを持ち、重りなわで築かれた城壁の上に立っておられた。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["この"],["よう"],["に"],["示された","しめされた"],["。"],["見","み"],["よ"],["。"],["主","ぬし"],["は"],["手","て"],["に"],["重り","おもり"],["なわ"],["を"],["持ち","もち"],["、"],["重り","おもり"],["なわ"],["で"],["築かれた","きずかれた"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["立って","たって"],["おられた"],["。"]]},{"verse":8,"text":"主は私に仰せられた。「アモス。何を見ているのか。」私が「重りなわです」と言うと、主は仰せられた。／「見よ。わたしは重りなわを、わたしの民イスラエルの真ん中に垂れ下げよう。／わたしはもう二度と彼らを見過ごさない。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["アモス"],["。"],["何","なん"],["を"],["見て","みて"],["いる"],["の"],["か"],["。"],["」"],["私","わたくし"],["が"],["「"],["重り","おもり"],["なわ"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["／"],["「"],["見","み"],["よ"],["。"],["わたし"],["は"],["重り","おもり"],["なわ"],["を"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["真ん中","まんなか"],["に"],["垂れ下げよう","たれさげよう"],["。"],["／"],["わたし"],["は"],["もう"],["二","に"],["度","ど"],["と"],["彼","かれ"],["ら"],["を"],["見過ごさない","みすごさない"],["。"]]},{"verse":9,"text":"イサクの高き所は荒らされ、イスラエルの聖所は廃墟となる。／わたしは剣をもって、ヤロブアムの家に立ち向かう。」","tok":[["イサク"],["の"],["高き","たかき"],["所","ところ"],["は"],["荒らされ","あらされ"],["、"],["イスラエル"],["の"],["聖","せい"],["所","しょ"],["は"],["廃墟","はいきょ"],["と"],["なる"],["。"],["／"],["わたし"],["は"],["剣","けん"],["を"],["もって"],["、"],["ヤロブアム"],["の"],["家","いえ"],["に"],["立ち向かう","たちむかう"],["。"],["」"]]},{"verse":10,"text":"ベテルの祭司アマツヤは、イスラエルの王ヤロブアムに人を遣わしてこう言った。「イスラエルの家のただ中で、アモスはあなたに謀反を企てています。この国は彼のすべてのことばを受け入れることはできません。","tok":[["ベテル"],["の"],["祭司","さいし"],["アマツヤ"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["ヤロブアム"],["に"],["人","ひと"],["を"],["遣わして","つかわして"],["こう"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["家","いえ"],["の"],["ただ中","ただなか"],["で"],["、"],["アモス"],["は"],["あなた"],["に"],["謀反","むほん"],["を"],["企てて","くわだてて"],["います"],["。"],["この"],["国","くに"],["は"],["彼","かれ"],["の"],["すべて"],["の"],["ことば"],["を"],["受け入れる","うけいれる"],["こと"],["は"],["できません"],["。"]]},{"verse":11,"text":"アモスはこう言っています。『ヤロブアムは剣で死に、イスラエルはその国から必ず捕らえられて行く。』」","tok":[["アモス"],["は"],["こう"],["言って","いって"],["います"],["。"],["『"],["ヤロブアム"],["は"],["剣","けん"],["で"],["死に","しに"],["、"],["イスラエル"],["は"],["その"],["国","くに"],["から"],["必ず","かならず"],["捕らえられて","とらえられて"],["行く","いく"],["。"],["』"],["」"]]},{"verse":12,"text":"アマツヤはアモスに言った。「先見者よ。ユダの地へ逃げて行け。その地でパンを食べ、その地で預言せよ。","tok":[["アマツヤ"],["は"],["アモス"],["に"],["言った","いった"],["。"],["「"],["先見者","せんけんしゃ"],["よ"],["。"],["ユダ"],["の"],["地","ち"],["へ"],["逃げて","にげて"],["行け","いけ"],["。"],["その"],["地","ち"],["で"],["パン"],["を"],["食べ","たべ"],["、"],["その"],["地","ち"],["で"],["預言","よげん"],["せよ"],["。"]]},{"verse":13,"text":"ベテルでは二度と預言するな。ここは王の聖所、王宮のある所だから。」","tok":[["ベテル"],["で"],["は"],["二","に"],["度","ど"],["と"],["預言","よげん"],["する"],["な"],["。"],["ここ"],["は"],["王","おう"],["の"],["聖","せい"],["所","しょ"],["、"],["王宮","おうきゅう"],["の"],["ある"],["所","ところ"],["だ"],["から"],["。"],["」"]]},{"verse":14,"text":"アモスはアマツヤに答えて言った。「私は預言者ではなかった。預言者の仲間でもなかった。私は牧者であり、いちじく桑の木を栽培していた。","tok":[["アモス"],["は"],["アマツヤ"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["預言者","よげんしゃ"],["で"],["は"],["なかった"],["。"],["預言者","よげんしゃ"],["の"],["仲間","なかま"],["で"],["も"],["なかった"],["。"],["私","わたくし"],["は"],["牧者","ぼくしゃ"],["で"],["あり"],["、"],["いちじく"],["桑","くわ"],["の"],["木","き"],["を"],["栽培","さいばい"],["して"],["いた"],["。"]]},{"verse":15,"text":"ところが、主は群れを追っていた私をとり、主は私に仰せられた。『行って、わたしの民イスラエルに預言せよ』と。","tok":[["ところ"],["が"],["、"],["主","ぬし"],["は"],["群れ","むれ"],["を"],["追って","おって"],["いた"],["私","わたくし"],["を"],["とり"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["『"],["行って","いって"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["に"],["預言","よげん"],["せよ"],["』"],["と"],["。"]]},{"verse":16,"text":"今、主のことばを聞け。あなたは『イスラエルに向かって預言するな。イサクの家に向かって預言するな』と言っている。","tok":[["今","いま"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["あなた"],["は"],["『"],["イスラエル"],["に"],["向かって","むかって"],["預言","よげん"],["する"],["な"],["。"],["イサク"],["の"],["家","いえ"],["に"],["向かって","むかって"],["預言","よげん"],["する"],["な"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":17,"text":"それゆえ、主はこう仰せられる。／『あなたの妻は町で遊女となり、あなたの息子、娘たちは剣に倒れ、あなたの土地は測りなわで分割される。／あなたは汚れた地で死に、イスラエルはその国から／必ず捕らえられて行く。』」","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["『"],["あなた"],["の"],["妻","つま"],["は"],["町","まち"],["で"],["遊女","ゆうじょ"],["と"],["なり"],["、"],["あなた"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["は"],["剣","けん"],["に"],["倒れ","たおれ"],["、"],["あなた"],["の"],["土地","とち"],["は"],["測り","はかり"],["なわ"],["で"],["分割","ぶんかつ"],["される"],["。"],["／"],["あなた"],["は"],["汚れた","よごれた"],["地","ち"],["で"],["死に","しに"],["、"],["イスラエル"],["は"],["その"],["国","くに"],["から"],["／"],["必ず","かならず"],["捕らえられて","とらえられて"],["行く","いく"],["。"],["』"],["」"]]}]
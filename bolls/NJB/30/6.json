[{"verse":1,"text":"ああ。／シオンで安らかに住んでいる者、サマリヤの山に信頼している者、イスラエルの家が行って仕える国々の／最高の首長たち。","tok":[["ああ"],["。"],["／"],["シオン"],["で"],["安らか","やすらか"],["に"],["住んで","すんで"],["いる"],["者","もの"],["、"],["サマリヤ"],["の"],["山","やま"],["に"],["信頼","しんらい"],["して"],["いる"],["者","もの"],["、"],["イスラエル"],["の"],["家","いえ"],["が"],["行って","いって"],["仕える","つかえる"],["国々","くにぐに"],["の"],["／"],["最高","さいこう"],["の"],["首長","しゅちょう"],["たち"],["。"]]},{"verse":2,"text":"カルネに渡って行って見よ。／そこから大ハマテに行き、またペリシテ人のガテに下って行け。／あなたがたはこれらの王国より／すぐれているだろうか。／あるいは、彼らの領土は／あなたがたの領土より大きいだろうか。","tok":[["カルネ"],["に"],["渡って","わたって"],["行って","いって"],["見","み"],["よ"],["。"],["／"],["そこ"],["から"],["大","だい"],["ハマテ"],["に"],["行き","いき"],["、"],["また"],["ペリシテ"],["人","にん"],["の"],["ガテ"],["に"],["下って","くだって"],["行け","いけ"],["。"],["／"],["あなた"],["がた"],["は"],["これ"],["ら"],["の"],["王国","おうこく"],["より"],["／"],["すぐれて"],["いるだろう"],["か"],["。"],["／"],["あるいは"],["、"],["彼","かれ"],["ら"],["の"],["領土","りょうど"],["は"],["／"],["あなた"],["がた"],["の"],["領土","りょうど"],["より"],["大きいだろう","おおきいだろう"],["か"],["。"]]},{"verse":3,"text":"あなたがたは、わざわいの日を押しのけている、と思っているが、暴虐の時代を近づけている。","tok":[["あなた"],["がた"],["は"],["、"],["わざわい"],["の"],["日","ひ"],["を"],["押しのけて","おしのけて"],["いる"],["、"],["と"],["思って","おもって"],["いる"],["が"],["、"],["暴虐","ぼうぎゃく"],["の"],["時代","じだい"],["を"],["近づけて","ちかづけて"],["いる"],["。"]]},{"verse":4,"text":"象牙の寝台に横たわり、長いすに身を伸ばしている者は、群れのうちから子羊を、牛舎の中から子牛を取って食べている。","tok":[["象牙","ぞうげ"],["の"],["寝台","しんだい"],["に"],["横たわり","よこたわり"],["、"],["長いす","ながいす"],["に"],["身","み"],["を"],["伸ばして","のばして"],["いる"],["者","もの"],["は"],["、"],["群れ","むれ"],["の"],["うち"],["から"],["子羊","こひつじ"],["を"],["、"],["牛舎","ぎゅうしゃ"],["の"],["中","なか"],["から"],["子牛","こうし"],["を"],["取って","とって"],["食べて","たべて"],["いる"],["。"]]},{"verse":5,"text":"彼らは十弦の琴の音に合わせて即興の歌を作り、ダビデのように新しい楽器を考え出す。","tok":[["彼","かれ"],["ら"],["は"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["の"],["音","おと"],["に"],["合わせて","あわせて"],["即興","そっきょう"],["の"],["歌","うた"],["を"],["作り","つくり"],["、"],["ダビデ"],["の"],["よう"],["に"],["新しい","あたらしい"],["楽器","がっき"],["を"],["考え出す","かんがえだす"],["。"]]},{"verse":6,"text":"彼らは鉢から酒を飲み、最上の香油を身に塗るが、ヨセフの破滅のことで悩まない。","tok":[["彼","かれ"],["ら"],["は"],["鉢","ばち"],["から"],["酒","さけ"],["を"],["飲み","のみ"],["、"],["最上","さいじょう"],["の"],["香油","こうゆ"],["を"],["身","み"],["に"],["塗る","ぬる"],["が"],["、"],["ヨセフ"],["の"],["破滅","はめつ"],["の"],["こと"],["で"],["悩まない","なやまない"],["。"]]},{"verse":7,"text":"それゆえ、今、彼らは、最初の捕らわれ人として引いて行かれる。／身を伸ばしている者どもの宴会は／取り除かれる。","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["、"],["彼","かれ"],["ら"],["は"],["、"],["最初","さいしょ"],["の"],["捕らわれ","とらわれ"],["人","にん"],["として"],["引いて","ひいて"],["行かれる","いかれる"],["。"],["／"],["身","み"],["を"],["伸ばして","のばして"],["いる"],["者","もの"],["ども"],["の"],["宴会","えんかい"],["は"],["／"],["取り除かれる","とりのぞかれる"],["。"]]},{"verse":8,"text":"神である主は、ご自分にかけて誓われる。／――万軍の神、主の御告げ――／わたしはヤコブの誇りを忌みきらい、その宮殿を憎む。／わたしはこの町と、その中のすべての者を引き渡す。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["に"],["かけて"],["誓われる","ちかわれる"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["ヤコブ"],["の"],["誇り","ほこり"],["を"],["忌みきらい","いみきらい"],["、"],["その"],["宮殿","きゅうでん"],["を"],["憎む","にくむ"],["。"],["／"],["わたし"],["は"],["この"],["町","まち"],["と"],["、"],["その"],["中","なか"],["の"],["すべて"],["の"],["者","もの"],["を"],["引き渡す","ひきわたす"],["。"]]},{"verse":9,"text":"一つの家に十人残っても、その者たちも死ぬ。","tok":[["一","ひと"],["つ"],["の"],["家","いえ"],["に"],["十人","じゅうにん"],["残って","のこって"],["も"],["、"],["その"],["者","もの"],["たち"],["も"],["死ぬ","しぬ"],["。"]]},{"verse":10,"text":"親戚の者でこれを焼く者が／家から死体を持ち出すために、これを取り上げ、その家の奥にいる者に向かって言う。「あなたのところに、まだいるか。」彼は言う。「だれもいない。」また言う。「口をつぐめ。主の名を口にするな。」","tok":[["親戚","しんせき"],["の"],["者","もの"],["で"],["これ"],["を"],["焼く","やく"],["者","もの"],["が"],["／"],["家","いえ"],["から"],["死体","したい"],["を"],["持ち出す","もちだす"],["ため"],["に"],["、"],["これ"],["を"],["取り上げ","とりあげ"],["、"],["その"],["家","いえ"],["の"],["奥","おく"],["に"],["いる"],["者","もの"],["に"],["向かって","むかって"],["言う","ゆう"],["。"],["「"],["あなた"],["の"],["ところ"],["に"],["、"],["まだ"],["いる"],["か"],["。"],["」"],["彼","かれ"],["は"],["言う","ゆう"],["。"],["「"],["だれ"],["も"],["いない"],["。"],["」"],["また"],["言う","ゆう"],["。"],["「"],["口","くち"],["を"],["つぐめ"],["。"],["主","ぬし"],["の"],["名","な"],["を"],["口","くち"],["に"],["する"],["な"],["。"],["」"]]},{"verse":11,"text":"まことに、見よ、主は命じる。／大きな家を打ち砕き、小さな家を粉々にせよ。","tok":[["まこと"],["に"],["、"],["見よ","みよ"],["、"],["主","ぬし"],["は"],["命じる","めいじる"],["。"],["／"],["大きな","おおきな"],["家","いえ"],["を"],["打ち砕き","うちくだき"],["、"],["小さな","ちいさな"],["家","いえ"],["を"],["粉々","こなごな"],["に"],["せよ"],["。"]]},{"verse":12,"text":"馬は岩の上を走るだろうか。／人は牛で海を耕すだろうか。／あなたがたは、公義を毒に変え、正義の実を苦よもぎに変えた。","tok":[["馬","うま"],["は"],["岩","いわ"],["の"],["上","うえ"],["を"],["走るだろう","はしるだろう"],["か"],["。"],["／"],["人","ひと"],["は"],["牛","うし"],["で"],["海","うみ"],["を"],["耕すだろう","たがやすだろう"],["か"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["公義","きみよし"],["を"],["毒","どく"],["に"],["変え","かえ"],["、"],["正義","せいぎ"],["の"],["実","じつ"],["を"],["苦","く"],["よもぎ"],["に"],["変えた","かえた"],["。"]]},{"verse":13,"text":"あなたがたは、ロ・ダバルを喜び、「私たちは自分たちの力で／カルナイムを取ったではないか」と言う。","tok":[["あなた"],["がた"],["は"],["、"],["ロ"],["・"],["ダバル"],["を"],["喜び","よろこび"],["、"],["「"],["私たち","わたしたち"],["は"],["自分","じぶん"],["たち"],["の"],["力","ちから"],["で"],["／"],["カルナイム"],["を"],["取ったで","とったで"],["は"],["ない"],["か"],["」"],["と"],["言う","ゆう"],["。"]]},{"verse":14,"text":"「まことに、イスラエルの家よ、今、わたしは一つの民を起こして／あなたがたを攻める。／――万軍の神、主の御告げ――／彼らはレボ・ハマテからアラバの川筋まで、あなたがたをしいたげる。」","tok":[["「"],["まこと"],["に"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["今","いま"],["、"],["わたし"],["は"],["一","ひと"],["つ"],["の"],["民","たみ"],["を"],["起こして","おこして"],["／"],["あなた"],["がた"],["を"],["攻める","せめる"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["彼","かれ"],["ら"],["は"],["レボ"],["・"],["ハマテ"],["から"],["アラバ"],["の"],["川筋","かわすじ"],["まで"],["、"],["あなた"],["がた"],["を"],["しいたげる"],["。"],["」"]]}]
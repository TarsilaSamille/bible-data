[{"verse":1,"text":"神である主は、私にこのように示された。そこに一かごの夏のくだものがあった。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["私","わたくし"],["に"],["この"],["よう"],["に"],["示された","しめされた"],["。"],["そこ"],["に"],["一","いち"],["かご"],["の"],["夏","なつ"],["の"],["くだもの"],["が"],["あった"],["。"]]},{"verse":2,"text":"主は仰せられた。「アモス。何を見ているのか。」私が、「一かごの夏のくだものです」と言うと、主は私に仰せられた。／「わたしの民イスラエルに、終わりが来た。／わたしはもう二度と彼らを見過ごさない。","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["アモス"],["。"],["何","なん"],["を"],["見て","みて"],["いる"],["の"],["か"],["。"],["」"],["私","わたくし"],["が"],["、"],["「"],["一","いち"],["かご"],["の"],["夏","なつ"],["の"],["くだもの"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["／"],["「"],["わたし"],["の"],["民","みん"],["イスラエル"],["に"],["、"],["終わり","おわり"],["が"],["来た","きた"],["。"],["／"],["わたし"],["は"],["もう"],["二","に"],["度","ど"],["と"],["彼","かれ"],["ら"],["を"],["見過ごさない","みすごさない"],["。"]]},{"verse":3,"text":"その日には、神殿の歌声は泣きわめきとなる。／――神である主の御告げ――／多くのしかばねが、至る所に投げ捨てられる。／口をつぐめ。」","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["神殿","しんでん"],["の"],["歌声","うたごえ"],["は"],["泣きわめき","なきわめき"],["と"],["なる"],["。"],["／"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["多く","おおく"],["の"],["しかばね"],["が"],["、"],["至る所","いたるところ"],["に"],["投げ捨てられる","なげすてられる"],["。"],["／"],["口","くち"],["を"],["つぐめ"],["。"],["」"]]},{"verse":4,"text":"聞け。貧しい者たちを踏みつけ、地の悩む者たちを絶やす者よ。","tok":[["聞け","きけ"],["。"],["貧しい","まずしい"],["者","もの"],["たち"],["を"],["踏みつけ","ふみつけ"],["、"],["地","ち"],["の"],["悩む","なやむ"],["者","もの"],["たち"],["を"],["絶やす","たやす"],["者","もの"],["よ"],["。"]]},{"verse":5,"text":"あなたがたは言っている。／「新月の祭りはいつ終わるのか。／私たちは穀物を売りたいのだが。／安息日はいつ終わるのか。／麦を売りに出したいのだが。／エパを小さくし、シェケルを重くし、欺きのはかりで欺こう。","tok":[["あなた"],["がた"],["は"],["言って","いって"],["いる"],["。"],["／"],["「"],["新月","しんげつ"],["の"],["祭り","まつり"],["は"],["いつ"],["終わる","おわる"],["の"],["か"],["。"],["／"],["私たち","わたしたち"],["は"],["穀物","こくもつ"],["を"],["売りたい","うりたい"],["の"],["だ"],["が"],["。"],["／"],["安息日","あんそくび"],["は"],["いつ"],["終わる","おわる"],["の"],["か"],["。"],["／"],["麦","むぎ"],["を"],["売り","うり"],["に"],["出したい","だしたい"],["の"],["だ"],["が"],["。"],["／"],["エパ"],["を"],["小さく","ちいさく"],["し"],["、"],["シェケル"],["を"],["重く","おもく"],["し"],["、"],["欺き","あざむき"],["の"],["はかり"],["で"],["欺こう","あざむこう"],["。"]]},{"verse":6,"text":"弱い者を金で買い、貧しい者を一足のくつで買い取り、くず麦を売るために。」","tok":[["弱い","よわい"],["者","もの"],["を"],["金","かね"],["で"],["買い","かい"],["、"],["貧しい","まずしい"],["者","もの"],["を"],["一足","ひとあし"],["の"],["くつ"],["で"],["買い取り","かいとり"],["、"],["くず"],["麦","むぎ"],["を"],["売る","うる"],["ため"],["に"],["。"],["」"]]},{"verse":7,"text":"主はヤコブの誇りにかけて誓われる。／「わたしは、彼らのしていることをみな、いつまでも、決して忘れない。","tok":[["主","ぬし"],["は"],["ヤコブ"],["の"],["誇り","ほこり"],["に"],["かけて"],["誓われる","ちかわれる"],["。"],["／"],["「"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["して"],["いる"],["こと"],["を"],["みな"],["、"],["いつ"],["まで"],["も"],["、"],["決して","けっして"],["忘れない","わすれない"],["。"]]},{"verse":8,"text":"このために地は震えないだろうか。／地に住むすべての者は／泣き悲しまないだろうか。／地のすべてのものは／ナイル川のようにわき上がり、エジプト川のように、みなぎっては、また沈まないだろうか。","tok":[["この"],["ため"],["に"],["地","ち"],["は"],["震えないだろう","ふるえないだろう"],["か"],["。"],["／"],["地","ち"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["は"],["／"],["泣き悲しまないだろう","なきかなしまないだろう"],["か"],["。"],["／"],["地","ち"],["の"],["すべて"],["の"],["もの"],["は"],["／"],["ナイル"],["川","かわ"],["の"],["よう"],["に"],["わき上がり","わきあがり"],["、"],["エジプト"],["川","かわ"],["の"],["よう"],["に"],["、"],["みなぎって"],["は"],["、"],["また"],["沈まないだろう","しずまないだろう"],["か"],["。"]]},{"verse":9,"text":"その日には、――神である主の御告げ――／わたしは真昼に太陽を沈ませ、日盛りに地を暗くし、","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["真昼","まひる"],["に"],["太陽","たいよう"],["を"],["沈ませ","しずませ"],["、"],["日盛り","ひざかり"],["に"],["地","ち"],["を"],["暗く","くらく"],["し"],["、"]]},{"verse":10,"text":"あなたがたの祭りを喪に変え、あなたがたのすべての歌を哀歌に変え、すべての腰に荒布をまとわせ、すべての人の頭をそらせ、その日を、ひとり子を失ったときの喪のようにし、その終わりを苦い日のようにする。","tok":[["あなた"],["がた"],["の"],["祭り","まつり"],["を"],["喪","も"],["に"],["変え","かえ"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["歌","うた"],["を"],["哀歌","あいか"],["に"],["変え","かえ"],["、"],["すべて"],["の"],["腰","こし"],["に"],["荒布","あらめ"],["を"],["まとわせ"],["、"],["すべて"],["の"],["人","ひと"],["の"],["頭","あたま"],["を"],["そらせ"],["、"],["その"],["日","ひ"],["を"],["、"],["ひとり子","ひとりご"],["を"],["失った","うしなった"],["とき"],["の"],["喪","も"],["の"],["よう"],["に"],["し"],["、"],["その"],["終わり","おわり"],["を"],["苦い","にがい"],["日","ひ"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":11,"text":"見よ。その日が来る。／――神である主の御告げ――／その日、わたしは、この地にききんを送る。／パンのききんではない。／水に渇くのでもない。／実に、主のことばを聞くことのききんである。","tok":[["見","み"],["よ"],["。"],["その"],["日","ひ"],["が"],["来る","くる"],["。"],["／"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["この"],["地","ち"],["に"],["ききん"],["を"],["送る","おくる"],["。"],["／"],["パン"],["の"],["ききん"],["で"],["は"],["ない"],["。"],["／"],["水","みず"],["に"],["渇く","かわく"],["ので"],["も"],["ない"],["。"],["／"],["実","じつ"],["に"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["聞く","きく"],["こと"],["の"],["ききん"],["で"],["ある"],["。"]]},{"verse":12,"text":"彼らは海から海へとさまよい歩き、北から東へと、主のことばを捜し求めて、行き巡る。／しかしこれを見いだせない。","tok":[["彼","かれ"],["ら"],["は"],["海","うみ"],["から"],["海","うみ"],["へ"],["と"],["さまよい"],["歩き","あるき"],["、"],["北","きた"],["から"],["東","ひがし"],["へ"],["と"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["捜し求めて","さがしもとめて"],["、"],["行き","いき"],["巡る","めぐる"],["。"],["／"],["しかし"],["これ"],["を"],["見いだせない","みいだせない"],["。"]]},{"verse":13,"text":"その日には、美しい若い女も、若い男も、渇きのために衰え果てる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["美しい","うつくしい"],["若い","わかい"],["女","おんな"],["も"],["、"],["若い","わかい"],["男","おとこ"],["も"],["、"],["渇き","かわき"],["の"],["ため"],["に"],["衰え","おとろえ"],["果てる","はてる"],["。"]]},{"verse":14,"text":"サマリヤの罪過にかけて誓い、『ダンよ。あなたの神は生きている』と言い、『ベエル・シェバの道は生きている』と言う者は、倒れて、二度と起き上がれない。」","tok":[["サマリヤ"],["の"],["罪過","ざいか"],["に"],["かけて"],["誓い","ちかい"],["、"],["『"],["ダン"],["よ"],["。"],["あなた"],["の"],["神","かみ"],["は"],["生きて","いきて"],["いる"],["』"],["と"],["言い","いい"],["、"],["『"],["ベエル"],["・"],["シェバ"],["の"],["道","みち"],["は"],["生きて","いきて"],["いる"],["』"],["と"],["言う","いう"],["者","もの"],["は"],["、"],["倒れて","たおれて"],["、"],["二","に"],["度","ど"],["と"],["起き上がれない","おきあがれない"],["。"],["」"]]}]
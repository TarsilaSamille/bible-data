[{"verse":1,"text":"私は、祭壇のかたわらに立っておられる主を見た。／主は仰せられた。／「柱頭を打って、敷居が震えるようにせよ。／そのすべてを頭上で打ち砕け。／わたしは彼らの残った者を、剣で殺す。／彼らのうち、ひとりも逃げる者はなく、のがれる者もない。","tok":[["私","わたくし"],["は"],["、"],["祭壇","さいだん"],["の"],["かたわら"],["に"],["立って","たって"],["おられる"],["主","ぬし"],["を"],["見た","みた"],["。"],["／"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["／"],["「"],["柱頭","ちゅうとう"],["を"],["打って","うって"],["、"],["敷居","しきい"],["が"],["震える","ふるえる"],["よう"],["に"],["せよ"],["。"],["／"],["その"],["すべて"],["を"],["頭上","ずじょう"],["で"],["打ち砕け","うちくだけ"],["。"],["／"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["残った","のこった"],["者","もの"],["を"],["、"],["剣","けん"],["で"],["殺す","ころす"],["。"],["／"],["彼","かれ"],["ら"],["の"],["うち"],["、"],["ひとり"],["も"],["逃げる","にげる"],["者","もの"],["は"],["なく"],["、"],["のがれる"],["者","もの"],["も"],["ない"],["。"]]},{"verse":2,"text":"彼らが、よみに入り込んでも、わたしの手はそこから彼らを引き出し、彼らが天に上っても、わたしはそこから彼らを引き降ろす。","tok":[["彼","かれ"],["ら"],["が"],["、"],["よみ"],["に"],["入り込んで","はいりこんで"],["も"],["、"],["わたし"],["の"],["手","て"],["は"],["そこ"],["から"],["彼","かれ"],["ら"],["を"],["引き出し","ひきだし"],["、"],["彼","かれ"],["ら"],["が"],["天","てん"],["に"],["上って","のぼって"],["も"],["、"],["わたし"],["は"],["そこ"],["から"],["彼","かれ"],["ら"],["を"],["引き降ろす","ひきおろす"],["。"]]},{"verse":3,"text":"彼らがカルメルの頂に身を隠しても、わたしは捜して、そこから彼らを捕らえ出し、彼らがわたしの目を避けて／海の底に身を隠しても、わたしは蛇に命じて、そこで彼らをかませる。","tok":[["彼","かれ"],["ら"],["が"],["カルメル"],["の"],["頂","いただき"],["に"],["身","み"],["を"],["隠して","かくして"],["も"],["、"],["わたし"],["は"],["捜して","さがして"],["、"],["そこ"],["から"],["彼","かれ"],["ら"],["を"],["捕らえ","とらえ"],["出し","だし"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["目","め"],["を"],["避けて","さけて"],["／"],["海","うみ"],["の"],["底","そこ"],["に"],["身","み"],["を"],["隠して","かくして"],["も"],["、"],["わたし"],["は"],["蛇","へび"],["に"],["命じて","めいじて"],["、"],["そこ"],["で"],["彼","かれ"],["ら"],["を"],["かませる"],["。"]]},{"verse":4,"text":"もし、彼らが敵のとりことなって行っても、わたしは剣に命じて、その所で彼らを殺させる。／わたしはこの目で彼らを見る。／それは、わざわいのためで、幸いのためではない。」","tok":[["もし"],["、"],["彼","かれ"],["ら"],["が"],["敵","てき"],["の"],["とりこ"],["と"],["なって"],["行って","いって"],["も"],["、"],["わたし"],["は"],["剣","けん"],["に"],["命じて","めいじて"],["、"],["その"],["所","ところ"],["で"],["彼","かれ"],["ら"],["を"],["殺させる","ころさせる"],["。"],["／"],["わたし"],["は"],["この"],["目","め"],["で"],["彼","かれ"],["ら"],["を"],["見る","みる"],["。"],["／"],["それ"],["は"],["、"],["わざわい"],["の"],["ため"],["で"],["、"],["幸い","さいわい"],["の"],["ため"],["で"],["は"],["ない"],["。"],["」"]]},{"verse":5,"text":"万軍の神、主が、地に触れると、それは溶け、そこに住むすべての者は泣き悲しみ、地のすべてのものは／ナイル川のようにわき上がり、エジプト川のように沈む。","tok":[["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["地","ち"],["に"],["触れる","ふれる"],["と"],["、"],["それ"],["は"],["溶け","とけ"],["、"],["そこ"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["は"],["泣き悲しみ","なきかなしみ"],["、"],["地","ち"],["の"],["すべて"],["の"],["もの"],["は"],["／"],["ナイル"],["川","かわ"],["の"],["よう"],["に"],["わき上がり","わきあがり"],["、"],["エジプト"],["川","かわ"],["の"],["よう"],["に"],["沈む","しずむ"],["。"]]},{"verse":6,"text":"天に高殿を建て、地の上に丸天井を据え、海の水を呼んで、地の面に注がれる方、その名は主。","tok":[["天","てん"],["に"],["高殿","たかどの"],["を"],["建て","たて"],["、"],["地","ち"],["の"],["上","うえ"],["に"],["丸","まる"],["天井","てんじょう"],["を"],["据え","すえ"],["、"],["海","うみ"],["の"],["水","みず"],["を"],["呼んで","よんで"],["、"],["地","ち"],["の"],["面","めん"],["に"],["注がれる","そそがれる"],["方","かた"],["、"],["その"],["名","な"],["は"],["主","ぬし"],["。"]]},{"verse":7,"text":"「イスラエルの子ら。／あなたがたは、わたしにとって、クシュ人のようではないのか。／――主の御告げ――／わたしはイスラエルをエジプトの国から、ペリシテ人をカフトルから、アラムをキルから連れ上ったではないか。","tok":[["「"],["イスラエル"],["の"],["子","こ"],["ら"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["わたし"],["にとって"],["、"],["クシュ人","くしゅにん"],["の"],["よう"],["で"],["は"],["ない"],["の"],["か"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["イスラエル"],["を"],["エジプト"],["の"],["国","くに"],["から"],["、"],["ペリシテ"],["人","にん"],["を"],["カフトル"],["から"],["、"],["アラム"],["を"],["キル"],["から"],["連れ上ったで","つれのぼったで"],["は"],["ない"],["か"],["。"]]},{"verse":8,"text":"見よ。神である主の目が、罪を犯した王国に向けられている。／わたしはこれを地の面から根絶やしにする。／しかし、わたしはヤコブの家を、全く根絶やしにはしない。／――主の御告げ――","tok":[["見","み"],["よ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["目","め"],["が"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["王国","おうこく"],["に"],["向けられて","むけられて"],["いる"],["。"],["／"],["わたし"],["は"],["これ"],["を"],["地","ち"],["の"],["面","めん"],["から"],["根絶やし","ねだやし"],["に"],["する"],["。"],["／"],["しかし"],["、"],["わたし"],["は"],["ヤコブ"],["の"],["家","いえ"],["を"],["、"],["全く","まったく"],["根絶やし","ねだやし"],["に"],["は"],["しない"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":9,"text":"見よ。わたしは命じて、ふるいにかけるように、すべての国々の間でイスラエルの家をふるい、一つの石ころも地に落とさない。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["命じて","めいじて"],["、"],["ふるい"],["に"],["かける"],["よう"],["に"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["間","あいだ"],["で"],["イスラエル"],["の"],["家","いえ"],["を"],["ふるい"],["、"],["一","ひと"],["つ"],["の"],["石ころ","いしころ"],["も"],["地","ち"],["に"],["落とさない","おとさない"],["。"]]},{"verse":10,"text":"わたしの民の中の罪人はみな、剣で死ぬ。／彼らは『わざわいは私たちに近づかない。／私たちまでは及ばない』と言っている。","tok":[["わたし"],["の"],["民","たみ"],["の"],["中","なか"],["の"],["罪人","ざいにん"],["は"],["みな"],["、"],["剣","けん"],["で"],["死ぬ","しぬ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["『"],["わざわい"],["は"],["私たち","わたしたち"],["に"],["近づかない","ちかづかない"],["。"],["／"],["私たち","わたしたち"],["まで"],["は"],["及ばない","およばない"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":11,"text":"その日、わたしは／ダビデの倒れている仮庵を起こし、その破れを繕い、その廃墟を復興し、昔の日のようにこれを建て直す。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["／"],["ダビデ"],["の"],["倒れて","たおれて"],["いる"],["仮庵","かりあん"],["を"],["起こし","おこし"],["、"],["その"],["破れ","やぶれ"],["を"],["繕い","つくろい"],["、"],["その"],["廃墟","はいきょ"],["を"],["復興","ふっこう"],["し"],["、"],["昔","むかし"],["の"],["日","ひ"],["の"],["よう"],["に"],["これ"],["を"],["建て直す","たてなおす"],["。"]]},{"verse":12,"text":"これは彼らが、エドムの残りの者と、わたしの名がつけられた／すべての国々を手に入れるためだ。／――これをなされる主の御告げ――","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["、"],["エドム"],["の"],["残り","のこり"],["の"],["者","もの"],["と"],["、"],["わたし"],["の"],["名","な"],["が"],["つけられた"],["／"],["すべて"],["の"],["国々","くにぐに"],["を"],["手","て"],["に"],["入れる","いれる"],["ため"],["だ"],["。"],["／"],["―"],["―"],["これ"],["を"],["なされる"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":13,"text":"見よ。その日が来る。／――主の御告げ――／その日には、耕す者が刈る者に近寄り、ぶどうを踏む者が種蒔く者に近寄る。／山々は甘いぶどう酒をしたたらせ、すべての丘もこれを流す。","tok":[["見","み"],["よ"],["。"],["その"],["日","ひ"],["が"],["来る","くる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["その"],["日","ひ"],["に"],["は"],["、"],["耕す","たがやす"],["者","もの"],["が"],["刈る","かる"],["者","もの"],["に"],["近寄り","ちかより"],["、"],["ぶどう"],["を"],["踏む","ふむ"],["者","もの"],["が"],["種蒔","たねまき"],["く者","くしゃ"],["に"],["近寄る","ちかよる"],["。"],["／"],["山々","やまやま"],["は"],["甘い","あまい"],["ぶどう酒","ぶどうしゅ"],["を"],["したたらせ"],["、"],["すべて"],["の"],["丘","おか"],["も"],["これ"],["を"],["流す","ながす"],["。"]]},{"verse":14,"text":"わたしは、わたしの民イスラエルの繁栄を元どおりにする。／彼らは荒れた町々を建て直して住み、ぶどう畑を作って、そのぶどう酒を飲み、果樹園を作って、その実を食べる。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["する"],["。"],["／"],["彼","かれ"],["ら"],["は"],["荒れた","あれた"],["町々","まちまち"],["を"],["建て直して","たてなおして"],["住み","すみ"],["、"],["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["、"],["その"],["ぶどう酒","ぶどうしゅ"],["を"],["飲み","のみ"],["、"],["果樹園","かじゅえん"],["を"],["作って","つくって"],["、"],["その"],["実","じつ"],["を"],["食べる","たべる"],["。"]]},{"verse":15,"text":"わたしは彼らを彼らの地に植える。／彼らは、わたしが彼らに与えたその土地から、もう、引き抜かれることはない」と／あなたの神、主は、仰せられる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["彼","かれ"],["ら"],["の"],["地","ち"],["に"],["植える","うえる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["与えた","あたえた"],["その"],["土地","とち"],["から"],["、"],["もう"],["、"],["引き抜かれる","ひきぬかれる"],["こと"],["は"],["ない"],["」"],["と"],["／"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["仰せられる","おおせられる"],["。"]]}]
[{"verse":1,"text":"テコアの牧者のひとりであったアモスのことば。これはユダの王ウジヤの時代、イスラエルの王、ヨアシュの子ヤロブアムの時代、地震の二年前に、イスラエルについて彼が見たものである。","tok":[["テコア"],["の"],["牧者","ぼくしゃ"],["の"],["ひとり"],["で"],["あった"],["アモス"],["の"],["ことば"],["。"],["これ"],["は"],["ユダ"],["の"],["王","おう"],["ウジヤ"],["の"],["時代","じだい"],["、"],["イスラエル"],["の"],["王","おう"],["、"],["ヨアシュ"],["の"],["子","こ"],["ヤロブアム"],["の"],["時代","じだい"],["、"],["地震","じしん"],["の"],["二","に"],["年","ねん"],["前","まえ"],["に"],["、"],["イスラエル"],["について"],["彼","かれ"],["が"],["見た","みた"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"彼は言った。「主はシオンから叫び、エルサレムから声を出される。羊飼いの牧場はかわき、カルメルの頂は枯れる。」","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["シオン"],["から"],["叫び","さけび"],["、"],["エルサレム"],["から"],["声","こえ"],["を"],["出される","だされる"],["。"],["羊飼い","ひつじかい"],["の"],["牧場","ぼくじょう"],["は"],["かわき"],["、"],["カルメル"],["の"],["頂","いただき"],["は"],["枯れる","かれる"],["。"],["」"]]},{"verse":3,"text":"主はこう仰せられる。／「ダマスコの犯した三つのそむきの罪、四つのそむきの罪のために、わたしはその刑罰を取り消さない。／彼らが鉄の打穀機で／ギルアデを踏みにじったからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["ダマスコ"],["の"],["犯した","おかした"],["三","みっ"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["その"],["刑罰","けいばつ"],["を"],["取り消さない","とりけさない"],["。"],["／"],["彼","かれ"],["ら"],["が"],["鉄","てつ"],["の"],["打","だ"],["穀","こく"],["機","き"],["で"],["／"],["ギルアデ"],["を"],["踏みにじった","ふみにじった"],["から"],["だ"],["。"]]},{"verse":4,"text":"わたしはハザエルの家に火を送ろう。／火はベン・ハダデの宮殿を焼き尽くす。","tok":[["わたし"],["は"],["ハザエル"],["の"],["家","いえ"],["に"],["火","ひ"],["を"],["送ろう","おくろう"],["。"],["／"],["火","ひ"],["は"],["ベン"],["・"],["ハダデ"],["の"],["宮殿","きゅうでん"],["を"],["焼き","やき"],["尽くす","つくす"],["。"]]},{"verse":5,"text":"わたしは、ダマスコのかんぬきを折り、アベンの谷から、王座についている者を、ベテ・エデンから、笏を持っている者を／断ち滅ぼす。／アラムの民はキルへ捕らえ移される」と／主は仰せられる。","tok":[["わたし"],["は"],["、"],["ダマスコ"],["の"],["かんぬき"],["を"],["折り","おり"],["、"],["アベン"],["の"],["谷","たに"],["から"],["、"],["王座","おうざ"],["について"],["いる"],["者","もの"],["を"],["、"],["ベテ"],["・"],["エデン"],["から"],["、"],["笏","しゃく"],["を"],["持って","もって"],["いる"],["者","もの"],["を"],["／"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"],["／"],["アラム"],["の"],["民","たみ"],["は"],["キル"],["へ"],["捕らえ","とらえ"],["移される","うつされる"],["」"],["と"],["／"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":6,"text":"主はこう仰せられる。／「ガザの犯した三つのそむきの罪、四つのそむきの罪のために、わたしはその刑罰を取り消さない。／彼らがすべての者を捕囚の民として捕らえ移し、エドムに引き渡したからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["ガザ"],["の"],["犯した","おかした"],["三","みっ"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["その"],["刑罰","けいばつ"],["を"],["取り消さない","とりけさない"],["。"],["／"],["彼","かれ"],["ら"],["が"],["すべて"],["の"],["者","もの"],["を"],["捕囚","ほしゅう"],["の"],["民","たみ"],["として"],["捕らえ","とらえ"],["移し","うつし"],["、"],["エドム"],["に"],["引き渡した","ひきわたした"],["から"],["だ"],["。"]]},{"verse":7,"text":"わたしはガザの城壁に火を送ろう。／火はその宮殿を焼き尽くす。","tok":[["わたし"],["は"],["ガザ"],["の"],["城壁","じょうへき"],["に"],["火","ひ"],["を"],["送ろう","おくろう"],["。"],["／"],["火","ひ"],["は"],["その"],["宮殿","きゅうでん"],["を"],["焼き","やき"],["尽くす","つくす"],["。"]]},{"verse":8,"text":"わたしはアシュドデから、王座についている者を、アシュケロンから、笏を持っている者を／断ち滅ぼす。／わたしはエクロンにわたしの手を向け、ペリシテ人の残った者を滅ぼす」と／神である主は仰せられる。","tok":[["わたし"],["は"],["アシュドデ"],["から"],["、"],["王座","おうざ"],["について"],["いる"],["者","もの"],["を"],["、"],["アシュケロン"],["から"],["、"],["笏","しゃく"],["を"],["持って","もって"],["いる"],["者","もの"],["を"],["／"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"],["／"],["わたし"],["は"],["エクロン"],["に"],["わたし"],["の"],["手","て"],["を"],["向け","むけ"],["、"],["ペリシテ"],["人","にん"],["の"],["残った","のこった"],["者","もの"],["を"],["滅ぼす","ほろぼす"],["」"],["と"],["／"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":9,"text":"主はこう仰せられる。／「ツロの犯した三つのそむきの罪、四つのそむきの罪のために、わたしはその刑罰を取り消さない。／彼らがすべての者を捕囚の民として、エドムに引き渡し、兄弟の契りを覚えていなかったからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["ツロ"],["の"],["犯した","おかした"],["三","みっ"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["その"],["刑罰","けいばつ"],["を"],["取り消さない","とりけさない"],["。"],["／"],["彼","かれ"],["ら"],["が"],["すべて"],["の"],["者","もの"],["を"],["捕囚","ほしゅう"],["の"],["民","たみ"],["として"],["、"],["エドム"],["に"],["引き渡し","ひきわたし"],["、"],["兄弟","きょうだい"],["の"],["契り","ちぎり"],["を"],["覚えて","おぼえて"],["いなかった"],["から"],["だ"],["。"]]},{"verse":10,"text":"わたしはツロの城壁に火を送ろう。／火はその宮殿を焼き尽くす。」","tok":[["わたし"],["は"],["ツロ"],["の"],["城壁","じょうへき"],["に"],["火","ひ"],["を"],["送ろう","おくろう"],["。"],["／"],["火","ひ"],["は"],["その"],["宮殿","きゅうでん"],["を"],["焼き","やき"],["尽くす","つくす"],["。"],["」"]]},{"verse":11,"text":"主はこう仰せられる。／「エドムの犯した三つのそむきの罪、四つのそむきの罪のために、わたしはその刑罰を取り消さない。／彼が剣で自分の兄弟を追い、肉親の情をそこない、怒り続けて／いつまでも激しい怒りを保っていたからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["エドム"],["の"],["犯した","おかした"],["三","みっ"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["その"],["刑罰","けいばつ"],["を"],["取り消さない","とりけさない"],["。"],["／"],["彼","かれ"],["が"],["剣","けん"],["で"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["追い","おい"],["、"],["肉親","にくしん"],["の"],["情","じょう"],["を"],["そこない"],["、"],["怒り","おこり"],["続けて","つづけて"],["／"],["いつ"],["まで"],["も"],["激しい","はげしい"],["怒り","いかり"],["を"],["保って","たもって"],["いた"],["から"],["だ"],["。"]]},{"verse":12,"text":"わたしはテマンに火を送ろう。／火はボツラの宮殿を焼き尽くす。」","tok":[["わたし"],["は"],["テマン"],["に"],["火","ひ"],["を"],["送ろう","おくろう"],["。"],["／"],["火","ひ"],["は"],["ボツラ"],["の"],["宮殿","きゅうでん"],["を"],["焼き","やき"],["尽くす","つくす"],["。"],["」"]]},{"verse":13,"text":"主はこう仰せられる。／「アモン人の犯した三つのそむきの罪、四つのそむきの罪のために、わたしはその刑罰を取り消さない。／彼らが、自分たちの領土を広げるために、ギルアデの妊婦たちを切り裂いたからだ。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["アモン人","あもんにん"],["の"],["犯した","おかした"],["三","みっ"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["その"],["刑罰","けいばつ"],["を"],["取り消さない","とりけさない"],["。"],["／"],["彼","かれ"],["ら"],["が"],["、"],["自分","じぶん"],["たち"],["の"],["領土","りょうど"],["を"],["広げる","ひろげる"],["ため"],["に"],["、"],["ギルアデ"],["の"],["妊婦","にんぷ"],["たち"],["を"],["切り裂いた","きりさいた"],["から"],["だ"],["。"]]},{"verse":14,"text":"わたしはラバの城壁に火を放とう。／火はその宮殿を焼き尽くす。／これは戦いの日のときの声と、つむじ風の日の暴風のうちに起こる。","tok":[["わたし"],["は"],["ラバ"],["の"],["城壁","じょうへき"],["に"],["火","ひ"],["を"],["放とう","はなとう"],["。"],["／"],["火","ひ"],["は"],["その"],["宮殿","きゅうでん"],["を"],["焼き","やき"],["尽くす","つくす"],["。"],["／"],["これ"],["は"],["戦い","たたかい"],["の"],["日","ひ"],["の"],["とき"],["の"],["声","こえ"],["と"],["、"],["つむじ風","つむじかぜ"],["の"],["日","ひ"],["の"],["暴風","ぼうふう"],["の"],["うち"],["に"],["起こる","おこる"],["。"]]},{"verse":15,"text":"彼らの王は、その首長たちとともに、捕囚として連れて行かれる」と主は仰せられる。","tok":[["彼","かれ"],["ら"],["の"],["王","おう"],["は"],["、"],["その"],["首長","しゅちょう"],["たち"],["と"],["とも"],["に"],["、"],["捕囚","ほしゅう"],["として"],["連れて","つれて"],["行かれる","いかれる"],["」"],["と"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]}]
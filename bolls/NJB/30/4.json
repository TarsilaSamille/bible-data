[{"verse":1,"text":"聞け。このことばを。／サマリヤの山にいるバシャンの雌牛ども。／彼女らは弱い者たちをしいたげ、貧しい者たちを迫害し、自分の主人たちに、「何か持って来て、飲ませよ」と言う。","tok":[["聞け","きけ"],["。"],["この"],["ことば"],["を"],["。"],["／"],["サマリヤ"],["の"],["山","やま"],["に"],["いる"],["バシャン"],["の"],["雌牛","めうし"],["ども"],["。"],["／"],["彼女","かのじょ"],["ら"],["は"],["弱い","よわい"],["者","もの"],["たち"],["を"],["しいたげ"],["、"],["貧しい","まずしい"],["者","もの"],["たち"],["を"],["迫害","はくがい"],["し"],["、"],["自分","じぶん"],["の"],["主人","しゅじん"],["たち"],["に"],["、"],["「"],["何","なん"],["か"],["持って","もって"],["来て","きて"],["、"],["飲ませ","のませ"],["よ"],["」"],["と"],["言う","ゆう"],["。"]]},{"verse":2,"text":"神である主は、ご自分の聖にかけて／誓われた。／見よ。その日があなたがたの上にやって来る。／その日、彼らはあなたがたを釣り針にかけ、あなたがたを最後のひとりまで、もりにかけて引いて行く。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["ご自分","ごじぶん"],["の"],["聖","ひじり"],["に"],["かけて"],["／"],["誓われた","ちかわれた"],["。"],["／"],["見","み"],["よ"],["。"],["その"],["日","ひ"],["が"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["やって"],["来る","くる"],["。"],["／"],["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["釣り針","つりばり"],["に"],["かけ"],["、"],["あなた"],["がた"],["を"],["最後","さいご"],["の"],["ひとり"],["まで"],["、"],["もり"],["に"],["かけて"],["引いて","ひいて"],["行く","いく"],["。"]]},{"verse":3,"text":"あなたがたはみな、城壁の破れ口からまっすぐ出て行き、ハルモンは投げ出される。／――主の御告げ――","tok":[["あなた"],["がた"],["は"],["みな"],["、"],["城壁","じょうへき"],["の"],["破れ","やぶれ"],["口","くち"],["から"],["まっすぐ"],["出て","でて"],["行き","いき"],["、"],["ハルモン"],["は"],["投げ出される","なげだされる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":4,"text":"ベテルへ行って、そむけ。／ギルガルへ行って、ますますそむけ。／朝ごとにいけにえをささげ、三日ごとに十分の一のささげ物をささげよ。","tok":[["ベテル"],["へ"],["行って","いって"],["、"],["そむけ"],["。"],["／"],["ギルガル"],["へ"],["行って","いって"],["、"],["ますます"],["そむけ"],["。"],["／"],["朝","あさ"],["ごと"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["三日","みっか"],["ごと"],["に"],["十分","じゅうぶん"],["の"],["一","いち"],["の"],["ささげ物","ささげもの"],["を"],["ささげ"],["よ"],["。"]]},{"verse":5,"text":"感謝のささげ物として、種を入れたパンを焼き、進んでささげるささげ物を布告し、ふれ知らせよ。／イスラエルの子ら。／あなたがたはそうすることを好んでいる。／――神である主の御告げ――","tok":[["感謝","かんしゃ"],["の"],["ささげ物","ささげもの"],["として"],["、"],["種","しゅ"],["を"],["入れた","いれた"],["パン"],["を"],["焼き","やき"],["、"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["を"],["布告","ふこく"],["し"],["、"],["ふれ"],["知らせ","しらせ"],["よ"],["。"],["／"],["イスラエル"],["の"],["子","こ"],["ら"],["。"],["／"],["あなた"],["がた"],["は"],["そう"],["する"],["こと"],["を"],["好んで","このんで"],["いる"],["。"],["／"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":6,"text":"わたしもまた、あなたがたのあらゆる町で、あなたがたの歯をきれいにしておき、あなたがたのすべての場所で、パンに欠乏させた。／それでも、あなたがたは／わたしのもとに帰って来なかった。／――主の御告げ――","tok":[["わたし"],["も"],["また"],["、"],["あなた"],["がた"],["の"],["あらゆる"],["町","まち"],["で"],["、"],["あなた"],["がた"],["の"],["歯","は"],["を"],["きれい"],["に"],["して"],["おき"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["場所","ばしょ"],["で"],["、"],["パン"],["に"],["欠乏","けつぼう"],["させた"],["。"],["／"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["／"],["わたし"],["の"],["もと"],["に"],["帰って","かえって"],["来なかった","こなかった"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":7,"text":"わたしはまた、刈り入れまでなお三か月あるのに、あなたがたには雨をとどめ、一つの町には雨を降らせ、他の町には雨を降らせなかった。／一つの畑には雨が降り、雨の降らなかった他の畑はかわききった。","tok":[["わたし"],["は"],["また"],["、"],["刈り入れ","かりいれ"],["まで"],["なお"],["三","さん"],["か月","かげつ"],["ある"],["のに"],["、"],["あなた"],["がた"],["に"],["は"],["雨","あめ"],["を"],["とどめ"],["、"],["一","ひと"],["つ"],["の"],["町","まち"],["に"],["は"],["雨","あめ"],["を"],["降らせ","ふらせ"],["、"],["他","た"],["の"],["町","まち"],["に"],["は"],["雨","あめ"],["を"],["降らせなかった","ふらせなかった"],["。"],["／"],["一","ひと"],["つ"],["の"],["畑","はたけ"],["に"],["は"],["雨","あめ"],["が"],["降り","ふり"],["、"],["雨","あめ"],["の"],["降らなかった","ふらなかった"],["他","ほか"],["の"],["畑","はたけ"],["は"],["かわき"],["きった"],["。"]]},{"verse":8,"text":"二、三の町は水を飲むために／一つの町によろめいて行ったが、満ち足りることはなかった。／それでも、あなたがたは／わたしのもとに帰って来なかった。／――主の御告げ――","tok":[["二","に"],["、"],["三","さん"],["の"],["町","まち"],["は"],["水","みず"],["を"],["飲む","のむ"],["ため"],["に"],["／"],["一","ひと"],["つ"],["の"],["町","まち"],["に"],["よろめいて"],["行った","いった"],["が"],["、"],["満ち足りる","みちたりる"],["こと"],["は"],["なかった"],["。"],["／"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["／"],["わたし"],["の"],["もと"],["に"],["帰って","かえって"],["来なかった","こなかった"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":9,"text":"わたしは立ち枯れと黒穂病で、あなたがたを打った。／あなたがたの果樹園とぶどう畑、いちじくの木とオリーブの木がふえても、かみつくいなごが食い荒らした。／それでも、あなたがたは／わたしのもとに帰って来なかった。／――主の御告げ――","tok":[["わたし"],["は"],["立ち枯れ","たちがれ"],["と"],["黒穂病","くろほびょう"],["で"],["、"],["あなた"],["がた"],["を"],["打った","うった"],["。"],["／"],["あなた"],["がた"],["の"],["果樹園","かじゅえん"],["と"],["ぶどう"],["畑","はたけ"],["、"],["いちじく"],["の"],["木","き"],["と"],["オリーブ"],["の"],["木","き"],["が"],["ふえて"],["も"],["、"],["かみつく"],["いなご"],["が"],["食い荒らした","くいあらした"],["。"],["／"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["／"],["わたし"],["の"],["もと"],["に"],["帰って","かえって"],["来なかった","こなかった"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":10,"text":"わたしは、エジプトにしたように、疫病をあなたがたに送り、剣であなたがたの若者たちを殺し、あなたがたの馬を奪い去り、あなたがたの陣営に悪臭を上らせ、あなたがたの鼻をつかせた。／それでも、あなたがたは／わたしのもとに帰って来なかった。／――主の御告げ――","tok":[["わたし"],["は"],["、"],["エジプト"],["に"],["した"],["よう"],["に"],["、"],["疫病","やくびょう"],["を"],["あなた"],["がた"],["に"],["送り","おくり"],["、"],["剣","けん"],["で"],["あなた"],["がた"],["の"],["若者","わかもの"],["たち"],["を"],["殺し","ころし"],["、"],["あなた"],["がた"],["の"],["馬","うま"],["を"],["奪い去り","うばいさり"],["、"],["あなた"],["がた"],["の"],["陣営","じんえい"],["に"],["悪臭","あくしゅう"],["を"],["上らせ","のぼらせ"],["、"],["あなた"],["がた"],["の"],["鼻","はな"],["を"],["つかせた"],["。"],["／"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["／"],["わたし"],["の"],["もと"],["に"],["帰って","かえって"],["来なかった","こなかった"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":11,"text":"わたしは、あなたがたをくつがえした。／神がソドムとゴモラをくつがえしたように。／あなたがたは炎の中から取り出された／燃えさしのようであった。／それでも、あなたがたは／わたしのもとに帰って来なかった。／――主の御告げ――","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["くつがえした"],["。"],["／"],["神","かみ"],["が"],["ソドム"],["と"],["ゴモラ"],["を"],["くつがえした"],["よう"],["に"],["。"],["／"],["あなた"],["がた"],["は"],["炎","ほのお"],["の"],["中","なか"],["から"],["取り出された","とりだされた"],["／"],["燃えさし","もえさし"],["の"],["よう"],["で"],["あった"],["。"],["／"],["それ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["／"],["わたし"],["の"],["もと"],["に"],["帰って","かえって"],["来なかった","こなかった"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":12,"text":"それゆえ、イスラエルよ、わたしはあなたにこうしよう。／わたしはあなたにこのことをするから、イスラエル、あなたはあなたの神に会う備えをせよ。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["こう"],["しよう"],["。"],["／"],["わたし"],["は"],["あなた"],["に"],["この"],["こと"],["を"],["する"],["から"],["、"],["イスラエル"],["、"],["あなた"],["は"],["あなた"],["の"],["神","かみ"],["に"],["会う","あう"],["備え","そなえ"],["を"],["せよ"],["。"]]},{"verse":13,"text":"見よ。山々を造り、風を造り出し、人にその思いが何であるかを告げ、暁と暗やみを造り、地の高い所を歩まれる方、その名は万軍の神、主。","tok":[["見","み"],["よ"],["。"],["山々","やまやま"],["を"],["造り","つくり"],["、"],["風","かぜ"],["を"],["造り出し","つくりだし"],["、"],["人","ひと"],["に"],["その"],["思い","おもい"],["が"],["何","なん"],["で"],["ある"],["か"],["を"],["告げ","つげ"],["、"],["暁","あかつき"],["と"],["暗やみ","くらやみ"],["を"],["造り","つくり"],["、"],["地","ち"],["の"],["高い","たかい"],["所","ところ"],["を"],["歩まれる","あゆまれる"],["方","かた"],["、"],["その"],["名","な"],["は"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["。"]]}]
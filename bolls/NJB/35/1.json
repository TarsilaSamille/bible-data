[{"verse":1,"text":"預言者ハバククが預言した宣告。","tok":[["預言者","よげんしゃ"],["ハバクク"],["が"],["預言","よげん"],["した"],["宣告","せんこく"],["。"]]},{"verse":2,"text":"主よ。私が助けを求めて叫んでいますのに、あなたはいつまで、聞いてくださらないのですか。／私が「暴虐」とあなたに叫んでいますのに、あなたは救ってくださらないのですか。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["が"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んで","さけんで"],["います"],["のに"],["、"],["あなた"],["は"],["いつ"],["まで"],["、"],["聞いて","きいて"],["くださらない"],["の"],["です"],["か"],["。"],["／"],["私","わたくし"],["が"],["「"],["暴虐","ぼうぎゃく"],["」"],["と"],["あなた"],["に"],["叫んで","さけんで"],["います"],["のに"],["、"],["あなた"],["は"],["救って","すくって"],["くださらない"],["の"],["です"],["か"],["。"]]},{"verse":3,"text":"なぜ、あなたは私に、わざわいを見させ、労苦をながめておられるのですか。／暴行と暴虐は私の前にあり、闘争があり、争いが起こっています。","tok":[["なぜ"],["、"],["あなた"],["は"],["私","わたくし"],["に"],["、"],["わざわい"],["を"],["見させ","みさせ"],["、"],["労苦","ろうく"],["を"],["ながめて"],["おられる"],["の"],["です"],["か"],["。"],["／"],["暴行","ぼうこう"],["と"],["暴虐","ぼうぎゃく"],["は"],["私","わたくし"],["の"],["前","まえ"],["に"],["あり"],["、"],["闘争","とうそう"],["が"],["あり"],["、"],["争い","あらそい"],["が"],["起こって","おこって"],["います"],["。"]]},{"verse":4,"text":"それゆえ、律法は眠り、さばきはいつまでも行われません。／悪者が正しい人を取り囲み、さばきが曲げて行われています。","tok":[["それ"],["ゆえ"],["、"],["律法","りっぽう"],["は"],["眠り","ねむり"],["、"],["さばき"],["は"],["いつ"],["まで"],["も"],["行われません","おこなわれません"],["。"],["／"],["悪者","わるもの"],["が"],["正しい","ただしい"],["人","ひと"],["を"],["取り囲み","とりかこみ"],["、"],["さばき"],["が"],["曲げて","まげて"],["行われて","おこなわれて"],["います"],["。"]]},{"verse":5,"text":"異邦の民を見、目を留めよ。／驚き、驚け。／わたしは一つの事をあなたがたの時代にする。／それが告げられても、あなたがたは信じまい。","tok":[["異邦","いほう"],["の"],["民","たみ"],["を"],["見","み"],["、"],["目","め"],["を"],["留めよ","とめよ"],["。"],["／"],["驚き","おどろき"],["、"],["驚け","おどろけ"],["。"],["／"],["わたし"],["は"],["一","ひと"],["つ"],["の"],["事","こと"],["を"],["あなた"],["がた"],["の"],["時代","じだい"],["に"],["する"],["。"],["／"],["それ"],["が"],["告げられて","つげられて"],["も"],["、"],["あなた"],["がた"],["は"],["信じまい","しんじまい"],["。"]]},{"verse":6,"text":"見よ。わたしはカルデヤ人を起こす。／強暴で激しい国民だ。／これは、自分のものでない住まいを占領しようと、地を広く行き巡る。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["カルデヤ"],["人","ひと"],["を"],["起こす","おこす"],["。"],["／"],["強暴","きょうぼう"],["で"],["激しい","はげしい"],["国民","こくみん"],["だ"],["。"],["／"],["これ"],["は"],["、"],["自分","じぶん"],["の"],["もの"],["で"],["ない"],["住まい","すまい"],["を"],["占領","せんりょう"],["しよう"],["と"],["、"],["地","ち"],["を"],["広く","ひろく"],["行き","いき"],["巡る","めぐる"],["。"]]},{"verse":7,"text":"これは、ひどく恐ろしい。／自分自身でさばきを行い、威厳を現す。","tok":[["これ"],["は"],["、"],["ひどく"],["恐ろしい","おそろしい"],["。"],["／"],["自分","じぶん"],["自身","じしん"],["で"],["さばき"],["を"],["行い","おこない"],["、"],["威厳","いげん"],["を"],["現す","あらわす"],["。"]]},{"verse":8,"text":"その馬は、ひょうよりも速く、日暮れの狼よりも敏しょうだ。／その軍馬は、はね回る。／その騎兵は遠くからやって来て、鷲のように獲物を食おうと飛びかかる。","tok":[["その"],["馬","うま"],["は"],["、"],["ひょう"],["より"],["も"],["速く","はやく"],["、"],["日暮れ","ひぐれ"],["の"],["狼","おおかみ"],["より"],["も"],["敏しょう","びんしょう"],["だ"],["。"],["／"],["その"],["軍馬","ぐんば"],["は"],["、"],["はね"],["回る","まわる"],["。"],["／"],["その"],["騎兵","きへい"],["は"],["遠く","とおく"],["から"],["やって"],["来て","きて"],["、"],["鷲","わし"],["の"],["よう"],["に"],["獲物","えもの"],["を"],["食おう","くおう"],["と"],["飛びかかる","とびかかる"],["。"]]},{"verse":9,"text":"彼らは来て、みな暴虐をふるう。／彼らの顔を東風のように向け、彼らは砂のようにとりこを集める。","tok":[["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["みな"],["暴虐","ぼうぎゃく"],["を"],["ふるう"],["。"],["／"],["彼","かれ"],["ら"],["の"],["顔","かお"],["を"],["東風","とうふう"],["の"],["よう"],["に"],["向け","むけ"],["、"],["彼","かれ"],["ら"],["は"],["砂","すな"],["の"],["よう"],["に"],["とりこ"],["を"],["集める","あつめる"],["。"]]},{"verse":10,"text":"彼らは王たちをあざけり、君主たちをあざ笑う。／彼らはすべての要塞をあざ笑い、土を積み上げて、それを攻め取る。","tok":[["彼","かれ"],["ら"],["は"],["王","おう"],["たち"],["を"],["あざけり"],["、"],["君主","くんしゅ"],["たち"],["を"],["あざ笑う","あざわらう"],["。"],["／"],["彼","かれ"],["ら"],["は"],["すべて"],["の"],["要塞","ようさい"],["を"],["あざ笑い","あざわらい"],["、"],["土","つち"],["を"],["積み上げて","つみあげて"],["、"],["それ"],["を"],["攻め取る","せめとる"],["。"]]},{"verse":11,"text":"それから、風のように移って来て、過ぎて行く。／自分の力を自分の神とする者は罰せられる。","tok":[["それ"],["から"],["、"],["風","かぜ"],["の"],["よう"],["に"],["移って","うつって"],["来て","きて"],["、"],["過ぎて","すぎて"],["行く","いく"],["。"],["／"],["自分","じぶん"],["の"],["力","ちから"],["を"],["自分","じぶん"],["の"],["神","かみ"],["と"],["する"],["者","もの"],["は"],["罰せられる","ばっせられる"],["。"]]},{"verse":12,"text":"主よ。あなたは昔から、私の神、私の聖なる方ではありませんか。／私たちは死ぬことはありません。／主よ。あなたはさばきのために、彼を立て、岩よ、あなたは叱責のために、彼を据えられました。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["は"],["昔","むかし"],["から"],["、"],["私","わたくし"],["の"],["神","かみ"],["、"],["私","わたくし"],["の"],["聖","せい"],["なる"],["方","かた"],["で"],["は"],["ありません"],["か"],["。"],["／"],["私たち","わたしたち"],["は"],["死ぬ","しぬ"],["こと"],["は"],["ありません"],["。"],["／"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["さばき"],["の"],["ため"],["に"],["、"],["彼","かれ"],["を"],["立て","たて"],["、"],["岩","いわ"],["よ"],["、"],["あなた"],["は"],["叱責","しっせき"],["の"],["ため"],["に"],["、"],["彼","かれ"],["を"],["据えられました","すえられました"],["。"]]},{"verse":13,"text":"あなたの目はあまりきよくて、悪を見ず、労苦に目を留めることができないのでしょう。／なぜ、裏切り者をながめておられるのですか。／悪者が自分より正しい者をのみこむとき、なぜ黙っておられるのですか。","tok":[["あなた"],["の"],["目","め"],["は"],["あまり"],["きよくて"],["、"],["悪","あく"],["を"],["見ず","みず"],["、"],["労苦","ろうく"],["に"],["目","め"],["を"],["留める","とめる"],["こと"],["が"],["できない"],["の"],["でしょう"],["。"],["／"],["なぜ"],["、"],["裏切り者","うらぎりしゃ"],["を"],["ながめて"],["おられる"],["の"],["です"],["か"],["。"],["／"],["悪者","わるもの"],["が"],["自分","じぶん"],["より"],["正しい","ただしい"],["者","もの"],["を"],["のみこむ"],["とき"],["、"],["なぜ"],["黙って","だまって"],["おられる"],["の"],["です"],["か"],["。"]]},{"verse":14,"text":"あなたは人を海の魚のように、治める者のないはう虫のようにされます。","tok":[["あなた"],["は"],["人","ひと"],["を"],["海","うみ"],["の"],["魚","さかな"],["の"],["よう"],["に"],["、"],["治める","おさめる"],["者","もの"],["の"],["ない"],["は"],["う"],["虫","むし"],["の"],["よう"],["に"],["されます"],["。"]]},{"verse":15,"text":"彼は、このすべての者を釣り針で釣り上げ、これを網で引きずり上げ、引き網で集める。／こうして、彼は喜び楽しむ。","tok":[["彼","かれ"],["は"],["、"],["この"],["すべて"],["の"],["者","もの"],["を"],["釣り針","つりばり"],["で"],["釣り上げ","つりあげ"],["、"],["これ"],["を"],["網","あみ"],["で"],["引きずり","ひきずり"],["上げ","あげ"],["、"],["引き網","ひきあみ"],["で"],["集める","あつめる"],["。"],["／"],["こう"],["して"],["、"],["彼","かれ"],["は"],["喜び楽しむ","よろこびたのしむ"],["。"]]},{"verse":16,"text":"それゆえ、彼はその網にいけにえをささげ、その引き網に香をたく。／これらによって、彼の分け前が豊かになり、その食物も豊富になるからだ。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["は"],["その"],["網","あみ"],["に"],["いけにえ"],["を"],["ささげ"],["、"],["その"],["引き網","ひきあみ"],["に"],["香","こう"],["を"],["たく"],["。"],["／"],["これ"],["ら"],["によって"],["、"],["彼","かれ"],["の"],["分け前","わけまえ"],["が"],["豊か","ゆたか"],["に"],["なり"],["、"],["その"],["食物","しょくもつ"],["も"],["豊富","ほうふ"],["に"],["なる"],["から"],["だ"],["。"]]},{"verse":17,"text":"それゆえ、彼はいつもその網を使い続け、容赦なく、諸国の民を殺すのだろうか。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["は"],["いつも"],["その"],["網","あみ"],["を"],["使い","つかい"],["続け","つづけ"],["、"],["容赦","ようしゃ"],["なく"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["殺す","ころす"],["の"],["だろう"],["か"],["。"]]}]
[{"verse":1,"text":"私は、見張り所に立ち、とりでにしかと立って見張り、主が私に何を語り、私の訴えに何と答えるかを見よう。","tok":[["私","わたくし"],["は"],["、"],["見張り","みはり"],["所","しょ"],["に"],["立ち","たち"],["、"],["とりで"],["に"],["しかと"],["立って","たって"],["見張り","みはり"],["、"],["主","ぬし"],["が"],["私","わたくし"],["に"],["何","なん"],["を"],["語り","かたり"],["、"],["私","わたくし"],["の"],["訴え","うったえ"],["に"],["何","なん"],["と"],["答える","こたえる"],["か"],["を"],["見よう","みよう"],["。"]]},{"verse":2,"text":"主は私に答えて言われた。／幻を板の上に書いて確認せよ。／これを読む者が急使として走るために。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["／"],["幻","まぼろし"],["を"],["板","いた"],["の"],["上","うえ"],["に"],["書いて","かいて"],["確認","かくにん"],["せよ"],["。"],["／"],["これ"],["を"],["読む","よむ"],["者","もの"],["が"],["急使","きゅうし"],["として"],["走る","はしる"],["ため"],["に"],["。"]]},{"verse":3,"text":"この幻は、定めの時について証言しており、終わりについて告げ、まやかしを言ってはいない。／もしおそくなっても、それを待て。／それは必ず来る。遅れることはない。","tok":[["この"],["幻","まぼろし"],["は"],["、"],["定め","さだめ"],["の"],["時","とき"],["について"],["証言","しょうげん"],["して"],["おり"],["、"],["終わり","おわり"],["について"],["告げ","つげ"],["、"],["まやかし"],["を"],["言って","いって"],["は"],["いない"],["。"],["／"],["もし"],["おそく"],["なって"],["も"],["、"],["それ"],["を"],["待て","まて"],["。"],["／"],["それ"],["は"],["必ず","かならず"],["来る","くる"],["。"],["遅れる","おくれる"],["こと"],["は"],["ない"],["。"]]},{"verse":4,"text":"見よ。彼の心はうぬぼれていて、まっすぐでない。／しかし、正しい人はその信仰によって生きる。","tok":[["見","み"],["よ"],["。"],["彼","かれ"],["の"],["心","こころ"],["は"],["うぬぼれて"],["いて"],["、"],["まっすぐ"],["で"],["ない"],["。"],["／"],["しかし"],["、"],["正しい","ただしい"],["人","ひと"],["は"],["その"],["信仰","しんこう"],["によって"],["生きる","いきる"],["。"]]},{"verse":5,"text":"実にぶどう酒は欺くものだ。／高ぶる者は定まりがない。／彼はよみのようにのどを広げ、死のように、足ることを知らない。／彼はすべての国々を自分のもとに集め、すべての国々の民を自分のもとにかき集める。","tok":[["実","じつ"],["に"],["ぶどう酒","ぶどうしゅ"],["は"],["欺く","あざむく"],["もの"],["だ"],["。"],["／"],["高ぶる","たかぶる"],["者","もの"],["は"],["定まり","さだまり"],["が"],["ない"],["。"],["／"],["彼","かれ"],["は"],["よみ"],["の"],["よう"],["に"],["のど"],["を"],["広げ","ひろげ"],["、"],["死","し"],["の"],["よう"],["に"],["、"],["足る","たる"],["こと"],["を"],["知らない","しらない"],["。"],["／"],["彼","かれ"],["は"],["すべて"],["の"],["国々","くにぐに"],["を"],["自分","じぶん"],["の"],["もと"],["に"],["集め","あつめ"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["自分","じぶん"],["の"],["もと"],["に"],["かき集める","かきあつめる"],["。"]]},{"verse":6,"text":"これらはみな、彼についてあざけりの声をあげ、彼を皮肉り、風刺してこう言わないだろうか。「わざわいだ。自分のものでないものを増し加える者。――いつまでだろうか――その上に担保を重くする者。」","tok":[["これ"],["ら"],["は"],["みな"],["、"],["彼","かれ"],["について"],["あざけり"],["の"],["声","こえ"],["を"],["あげ"],["、"],["彼","かれ"],["を"],["皮肉り","ひにくり"],["、"],["風刺","ふうし"],["して"],["こう"],["言わないだろう","いわないだろう"],["か"],["。"],["「"],["わざわい"],["だ"],["。"],["自分","じぶん"],["の"],["もの"],["で"],["ない"],["もの"],["を"],["増し加える","ましくわえる"],["者","もの"],["。"],["―"],["―"],["いつ"],["まで"],["だろう"],["か"],["―"],["―"],["その"],["上","うえ"],["に"],["担保","たんぽ"],["を"],["重く","おもく"],["する"],["者","もの"],["。"],["」"]]},{"verse":7,"text":"あなたをかむ者が突然起き上がり、あなたを揺り動かす者が目ざめないだろうか。／あなたは彼らに奪い取られる。","tok":[["あなた"],["を"],["かむ"],["者","もの"],["が"],["突然","とつぜん"],["起き上がり","おきあがり"],["、"],["あなた"],["を"],["揺り動かす","ゆりうごかす"],["者","もの"],["が"],["目ざめないだろう","めざめないだろう"],["か"],["。"],["／"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["奪い取られる","うばいとられる"],["。"]]},{"verse":8,"text":"あなたが多くの国々を略奪したので、ほかのすべての国々の民が、あなたを略奪する。／あなたが人の血を流し、国や町や、そのすべての住民に／暴力をふるったためだ。","tok":[["あなた"],["が"],["多く","おおく"],["の"],["国々","くにぐに"],["を"],["略奪","りゃくだつ"],["した"],["ので"],["、"],["ほか"],["の"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["、"],["あなた"],["を"],["略奪","りゃくだつ"],["する"],["。"],["／"],["あなた"],["が"],["人","ひと"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["国","くに"],["や"],["町","まち"],["や"],["、"],["その"],["すべて"],["の"],["住民","じゅうみん"],["に"],["／"],["暴力","ぼうりょく"],["を"],["ふるった"],["ため"],["だ"],["。"]]},{"verse":9,"text":"わざわいだ。／自分の家のために不正な利得をむさぼり、わざわいの手からのがれるために、自分の巣を高い所に据える者。","tok":[["わざわい"],["だ"],["。"],["／"],["自分","じぶん"],["の"],["家","いえ"],["の"],["ため"],["に"],["不正","ふせい"],["な"],["利得","りとく"],["を"],["むさぼり"],["、"],["わざわい"],["の"],["手","て"],["から"],["のがれる"],["ため"],["に"],["、"],["自分","じぶん"],["の"],["巣","す"],["を"],["高い","たかい"],["所","ところ"],["に"],["据える","すえる"],["者","もの"],["。"]]},{"verse":10,"text":"あなたは自分の家のために恥ずべきことを計り、多くの国々の民を滅ぼした。／あなたのたましいは罪を犯した。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["家","いえ"],["の"],["ため"],["に"],["恥ずべき","はずべき"],["こと"],["を"],["計り","はかり"],["、"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["滅ぼした","ほろぼした"],["。"],["／"],["あなた"],["の"],["たましい"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["。"]]},{"verse":11,"text":"まことに、石は石垣から叫び、梁は家からこれに答える。","tok":[["まこと"],["に"],["、"],["石","いし"],["は"],["石垣","いしがき"],["から"],["叫び","さけび"],["、"],["梁","はり"],["は"],["家","いえ"],["から"],["これ"],["に"],["答える","こたえる"],["。"]]},{"verse":12,"text":"わざわいだ。／血で町を建て、不正で都を築き上げる者。","tok":[["わざわい"],["だ"],["。"],["／"],["血","ち"],["で"],["町","まち"],["を"],["建て","たて"],["、"],["不正","ふせい"],["で"],["都","と"],["を"],["築き上げる","きずきあげる"],["者","もの"],["。"]]},{"verse":13,"text":"これは、万軍の主によるのではないか。／国々の民は、ただ火で焼かれるために労し、諸国の民は、むなしく疲れ果てる。","tok":[["これ"],["は"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["に"],["よる"],["ので"],["は"],["ない"],["か"],["。"],["／"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["、"],["ただ"],["火","ひ"],["で"],["焼かれる","やかれる"],["ため"],["に"],["労し","ろうし"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["、"],["むなしく"],["疲れ","つかれ"],["果てる","はてる"],["。"]]},{"verse":14,"text":"まことに、水が海をおおうように、地は、主の栄光を知ることで満たされる。","tok":[["まこと"],["に"],["、"],["水","みず"],["が"],["海","うみ"],["を"],["おおう"],["よう"],["に"],["、"],["地","ち"],["は"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["を"],["知る","しる"],["こと"],["で"],["満たされる","みたされる"],["。"]]},{"verse":15,"text":"わざわいだ。／自分の友に飲ませ、毒を混ぜて酔わせ、その裸を見ようとする者。","tok":[["わざわい"],["だ"],["。"],["／"],["自分","じぶん"],["の"],["友","とも"],["に"],["飲ませ","のませ"],["、"],["毒","どく"],["を"],["混ぜて","まぜて"],["酔わせ","よわせ"],["、"],["その"],["裸","はだか"],["を"],["見よう","みよう"],["と"],["する"],["者","もの"],["。"]]},{"verse":16,"text":"あなたは栄光よりも恥で満ち足りている。／あなたも飲んで、陽の皮を見せよ。／主の右の手の杯は、あなたの上に巡って来て、恥があなたの栄光をおおう。","tok":[["あなた"],["は"],["栄光","えいこう"],["より"],["も"],["恥","はじ"],["で"],["満ち足りて","みちたりて"],["いる"],["。"],["／"],["あなた"],["も"],["飲んで","のんで"],["、"],["陽","ひ"],["の"],["皮","かわ"],["を"],["見せ","みせ"],["よ"],["。"],["／"],["主","ぬし"],["の"],["右","みぎ"],["の"],["手","て"],["の"],["杯","さかずき"],["は"],["、"],["あなた"],["の"],["上","うえ"],["に"],["巡って","めぐって"],["来て","きて"],["、"],["恥","はじ"],["が"],["あなた"],["の"],["栄光","えいこう"],["を"],["おおう"],["。"]]},{"verse":17,"text":"レバノンへの暴虐があなたをおおい、獣への残虐があなたを脅かす。／あなたが人の血を流し、国や町や、そのすべての住民に／暴力をふるったためだ。","tok":[["レバノン"],["へ"],["の"],["暴虐","ぼうぎゃく"],["が"],["あなた"],["を"],["おおい"],["、"],["獣","けもの"],["へ"],["の"],["残虐","ざんぎゃく"],["が"],["あなた"],["を"],["脅かす","おびやかす"],["。"],["／"],["あなた"],["が"],["人","ひと"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["国","くに"],["や"],["町","まち"],["や"],["、"],["その"],["すべて"],["の"],["住民","じゅうみん"],["に"],["／"],["暴力","ぼうりょく"],["を"],["ふるった"],["ため"],["だ"],["。"]]},{"verse":18,"text":"彫刻師の刻んだ彫像や鋳像、偽りを教える者が、何の役に立とう。／物言わぬ偽りの神々を造って、これを造った者が、それにたよったところで、何の役に立とう。","tok":[["彫刻師","ちょうこくし"],["の"],["刻んだ","きざんだ"],["彫像","ちょうぞう"],["や"],["鋳像","ちゅうぞう"],["、"],["偽り","いつわり"],["を"],["教える","おしえる"],["者","もの"],["が"],["、"],["何","なん"],["の"],["役","やく"],["に"],["立とう","たとう"],["。"],["／"],["物","もの"],["言わぬ","いわぬ"],["偽り","いつわり"],["の"],["神々","かみがみ"],["を"],["造って","つくって"],["、"],["これ"],["を"],["造った","つくった"],["者","もの"],["が"],["、"],["それ"],["に"],["たよった"],["ところ"],["で"],["、"],["何","なん"],["の"],["役","やく"],["に"],["立とう","たとう"],["。"]]},{"verse":19,"text":"わざわいだ。／木に向かって目をさませと言い、黙っている石に向かって起きろと言う者よ。／それは像だ。／それは金や銀をかぶせたもの。／その中には何の息もない。","tok":[["わざわい"],["だ"],["。"],["／"],["木","き"],["に"],["向かって","むかって"],["目","め"],["を"],["さませ"],["と"],["言い","いい"],["、"],["黙って","だまって"],["いる"],["石","いし"],["に"],["向かって","むかって"],["起きろ","おきろ"],["と"],["言う","いう"],["者","もの"],["よ"],["。"],["／"],["それ"],["は"],["像","ぞう"],["だ"],["。"],["／"],["それ"],["は"],["金","きん"],["や"],["銀","ぎん"],["を"],["かぶせた"],["もの"],["。"],["／"],["その"],["中","なか"],["に"],["は"],["何","なん"],["の"],["息","いき"],["も"],["ない"],["。"]]},{"verse":20,"text":"しかし主は、その聖なる宮におられる。／全地よ。その御前に静まれ。","tok":[["しかし"],["主","ぬし"],["は"],["、"],["その"],["聖","せい"],["なる"],["宮","みや"],["に"],["おられる"],["。"],["／"],["全地","ぜんち"],["よ"],["。"],["その"],["御前","ごぜん"],["に"],["静まれ","しずまれ"],["。"]]}]
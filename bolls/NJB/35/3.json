[{"verse":1,"text":"預言者ハバククの祈り。シグヨノテに合わせて。","tok":[["預言者","よげんしゃ"],["ハバクク"],["の"],["祈り","いのり"],["。"],["シグヨノテ"],["に"],["合わせて","あわせて"],["。"]]},{"verse":2,"text":"主よ。私はあなたのうわさを聞き、主よ、あなたのみわざを恐れました。／この年のうちに、それをくり返してください。／この年のうちに、それを示してください。／激しい怒りのうちにも、あわれみを忘れないでください。","tok":[["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["うわさ"],["を"],["聞き","きき"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["のみ"],["わざ"],["を"],["恐れました","おそれました"],["。"],["／"],["この"],["年","とし"],["の"],["うち"],["に"],["、"],["それ"],["を"],["くり返して","くりかえして"],["ください"],["。"],["／"],["この"],["年","とし"],["の"],["うち"],["に"],["、"],["それ"],["を"],["示して","しめして"],["ください"],["。"],["／"],["激しい","はげしい"],["怒り","いかり"],["の"],["うち"],["に"],["も"],["、"],["あわれみ"],["を"],["忘れないで","わすれないで"],["ください"],["。"]]},{"verse":3,"text":"神はテマンから来られ、聖なる方はパランの山から来られる。セラ／その尊厳は天をおおい、その賛美は地に満ちている。","tok":[["神","かみ"],["は"],["テマン"],["から"],["来られ","こられ"],["、"],["聖","せい"],["なる"],["方","かた"],["は"],["パラン"],["の"],["山","やま"],["から"],["来られる","こられる"],["。"],["セラ"],["／"],["その"],["尊厳","そんげん"],["は"],["天","てん"],["を"],["おおい"],["、"],["その"],["賛美","さんび"],["は"],["地","ち"],["に"],["満ちて","みちて"],["いる"],["。"]]},{"verse":4,"text":"輝きは光のよう。／ひらめきはその手から放たれ、そこに力が隠されている。","tok":[["輝き","かがやき"],["は"],["光","ひかり"],["の"],["よう"],["。"],["／"],["ひらめき"],["は"],["その"],["手","て"],["から"],["放たれ","はなたれ"],["、"],["そこ"],["に"],["力","ちから"],["が"],["隠されて","かくされて"],["いる"],["。"]]},{"verse":5,"text":"その御前を疫病が行き、熱病はそのうしろに従う。","tok":[["その"],["御前","ごぜん"],["を"],["疫病","やくびょう"],["が"],["行き","いき"],["、"],["熱病","ねつびょう"],["は"],["その"],["うしろ"],["に"],["従う","したがう"],["。"]]},{"verse":6,"text":"神は立って、地を測り、見渡して、諸国の民を震え上がらせる。／とこしえの山は打ち砕かれ、永遠の丘は低くされる。／しかし、その軌道は昔のまま。","tok":[["神","かみ"],["は"],["立って","たって"],["、"],["地","ち"],["を"],["測り","はかり"],["、"],["見渡して","みわたして"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["震え上がらせる","ふるえあがらせる"],["。"],["／"],["とこしえ"],["の"],["山","やま"],["は"],["打ち砕かれ","うちくだかれ"],["、"],["永遠","えいえん"],["の"],["丘","おか"],["は"],["低く","ひくく"],["される"],["。"],["／"],["しかし"],["、"],["その"],["軌道","きどう"],["は"],["昔","むかし"],["の"],["まま"],["。"]]},{"verse":7,"text":"私が見ると、クシャンの天幕は乱れ騒ぎ、ミデヤンの地の幕屋はわなないている。","tok":[["私","わたくし"],["が"],["見る","みる"],["と"],["、"],["クシャン"],["の"],["天幕","てんまく"],["は"],["乱れ騒ぎ","みだれさわぎ"],["、"],["ミデヤン"],["の"],["地","ち"],["の"],["幕屋","まくや"],["は"],["わなないて"],["いる"],["。"]]},{"verse":8,"text":"主よ。川に怒りを燃やされるのですか。／あなたの怒りを川に向けられるのですか。／それとも、あなたの憤りを海に向けられるのですか。／あなたは、馬に乗り、あなたの救いの戦車に乗って来られます。","tok":[["主","ぬし"],["よ"],["。"],["川","かわ"],["に"],["怒り","いかり"],["を"],["燃やされる","もやされる"],["の"],["です"],["か"],["。"],["／"],["あなた"],["の"],["怒り","いかり"],["を"],["川","かわ"],["に"],["向けられる","むけられる"],["の"],["です"],["か"],["。"],["／"],["それ"],["と"],["も"],["、"],["あなた"],["の"],["憤り","いきどおり"],["を"],["海","うみ"],["に"],["向けられる","むけられる"],["の"],["です"],["か"],["。"],["／"],["あなた"],["は"],["、"],["馬","うま"],["に"],["乗り","のり"],["、"],["あなた"],["の"],["救い","すくい"],["の"],["戦車","せんしゃ"],["に"],["乗って","のって"],["来られます","こられます"],["。"]]},{"verse":9,"text":"あなたの弓はおおいを取り払われ、ことばの杖の誓いが果たされます。セラ／あなたは地を裂いて川々とされます。","tok":[["あなた"],["の"],["弓","ゆみ"],["は"],["おおい"],["を"],["取り払われ","とりはらわれ"],["、"],["ことば"],["の"],["杖","つえ"],["の"],["誓い","ちかい"],["が"],["果たされます","はたされます"],["。"],["セラ"],["／"],["あなた"],["は"],["地","ち"],["を"],["裂いて","さいて"],["川","かわ"],["々"],["と"],["されます"],["。"]]},{"verse":10,"text":"山々はあなたを見て震え、豪雨は流れ去り、深い淵はその声を出し、その手を高く上げます。","tok":[["山々","やまやま"],["は"],["あなた"],["を"],["見て","みて"],["震え","ふるえ"],["、"],["豪雨","ごうう"],["は"],["流れ去り","ながれさり"],["、"],["深い","ふかい"],["淵","ふち"],["は"],["その"],["声","こえ"],["を"],["出し","だし"],["、"],["その"],["手","て"],["を"],["高く","たかく"],["上げます","あげます"],["。"]]},{"verse":11,"text":"太陽と月はその住みかにとどまります。／あなたの矢の光によって、あなたのきらめく槍の輝きによって、それらは動きます。","tok":[["太陽","たいよう"],["と"],["月","つき"],["は"],["その"],["住みか","すみか"],["に"],["とどまります"],["。"],["／"],["あなた"],["の"],["矢","や"],["の"],["光","ひかり"],["によって"],["、"],["あなた"],["の"],["きらめく"],["槍","やり"],["の"],["輝き","かがやき"],["によって"],["、"],["それ"],["ら"],["は"],["動きます","うごきます"],["。"]]},{"verse":12,"text":"あなたは、憤って、地を行き巡り、怒って、国々を踏みつけられます。","tok":[["あなた"],["は"],["、"],["憤って","いきどおって"],["、"],["地","ち"],["を"],["行き","いき"],["巡り","めぐり"],["、"],["怒って","おこって"],["、"],["国々","くにぐに"],["を"],["踏みつけられます","ふみつけられます"],["。"]]},{"verse":13,"text":"あなたは、ご自分の民を救うために出て来られ、あなたに油そそがれた者を救うために／出て来られます。／あなたは、悪者の家の頭を粉々に砕き、足もとから首まで裸にされます。セラ","tok":[["あなた"],["は"],["、"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["救う","すくう"],["ため"],["に"],["出て","でて"],["来られ","こられ"],["、"],["あなた"],["に"],["油","あぶら"],["そそがれた"],["者","もの"],["を"],["救う","すくう"],["ため"],["に"],["／"],["出て","でて"],["来られます","こられます"],["。"],["／"],["あなた"],["は"],["、"],["悪者","わるもの"],["の"],["家","いえ"],["の"],["頭","あたま"],["を"],["粉々","こなごな"],["に"],["砕き","くだき"],["、"],["足もと","あしもと"],["から"],["首","くび"],["まで"],["裸","はだか"],["に"],["されます"],["。"],["セラ"]]},{"verse":14,"text":"あなたは、戦士たちの頭に矢を刺し通されます。／彼らは隠れている貧しい者を／食い尽くす者のように、私をほしいままに追い散らそうと荒れ狂います。","tok":[["あなた"],["は"],["、"],["戦士","せんし"],["たち"],["の"],["頭","あたま"],["に"],["矢","や"],["を"],["刺し通されます","さしとおされます"],["。"],["／"],["彼","かれ"],["ら"],["は"],["隠れて","かくれて"],["いる"],["貧しい","まずしい"],["者","もの"],["を"],["／"],["食い","くい"],["尽くす","つくす"],["者","もの"],["の"],["よう"],["に"],["、"],["私","わたくし"],["を"],["ほしいまま"],["に"],["追い散らそう","おいちらそう"],["と"],["荒れ狂います","あれくるいます"],["。"]]},{"verse":15,"text":"あなたは、あなたの馬で海を踏みつけ、大水に、あわを立たせられます。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["馬","うま"],["で"],["海","うみ"],["を"],["踏みつけ","ふみつけ"],["、"],["大水","おおみず"],["に"],["、"],["あわ"],["を"],["立たせられます","たたせられます"],["。"]]},{"verse":16,"text":"私は聞き、私のはらわたはわななき、私のくちびるはその音のために震える。／腐れは私の骨のうちに入り、私の足もとはぐらつく。／私たちを攻める民に襲いかかる悩みの日を、私は静かに待とう。","tok":[["私","わたくし"],["は"],["聞き","きき"],["、"],["私","わたくし"],["の"],["はらわた"],["は"],["わななき"],["、"],["私","わたくし"],["の"],["くちびる"],["は"],["その"],["音","おと"],["の"],["ため"],["に"],["震える","ふるえる"],["。"],["／"],["腐れ","くされ"],["は"],["私","わたくし"],["の"],["骨","ほね"],["の"],["うち"],["に"],["入り","はいり"],["、"],["私","わたくし"],["の"],["足もと","あしもと"],["は"],["ぐらつく"],["。"],["／"],["私たち","わたしたち"],["を"],["攻める","せめる"],["民","たみ"],["に"],["襲いかかる","おそいかかる"],["悩み","なやみ"],["の"],["日","ひ"],["を"],["、"],["私","わたくし"],["は"],["静か","しずか"],["に"],["待とう","まとう"],["。"]]},{"verse":17,"text":"そのとき、いちじくの木は花を咲かせず、ぶどうの木は実をみのらせず、オリーブの木も実りがなく、畑は食物を出さない。／羊は囲いから絶え、牛は牛舎にいなくなる。","tok":[["その"],["とき"],["、"],["いちじく"],["の"],["木","き"],["は"],["花","はな"],["を"],["咲かせず","さかせず"],["、"],["ぶどう"],["の"],["木","き"],["は"],["実","じつ"],["を"],["みのらせず"],["、"],["オリーブ"],["の"],["木","き"],["も"],["実り","みのり"],["が"],["なく"],["、"],["畑","はたけ"],["は"],["食物","しょくもつ"],["を"],["出さない","ださない"],["。"],["／"],["羊","ひつじ"],["は"],["囲い","かこい"],["から"],["絶え","たえ"],["、"],["牛","うし"],["は"],["牛舎","ぎゅうしゃ"],["に"],["いなく"],["なる"],["。"]]},{"verse":18,"text":"しかし、私は主にあって喜び勇み、私の救いの神にあって喜ぼう。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["主に","おもに"],["あって"],["喜び勇み","よろこびいさみ"],["、"],["私","わたくし"],["の"],["救い","すくい"],["の"],["神","かみ"],["に"],["あって"],["喜ぼう","よろこぼう"],["。"]]},{"verse":19,"text":"私の主、神は、私の力。／私の足を雌鹿のようにし、私に高い所を歩ませる。／指揮者のために。弦楽器に合わせて。","tok":[["私","わたくし"],["の"],["主","ぬし"],["、"],["神","かみ"],["は"],["、"],["私","わたくし"],["の"],["力","ちから"],["。"],["／"],["私","わたくし"],["の"],["足","あし"],["を"],["雌鹿","めじか"],["の"],["よう"],["に"],["し"],["、"],["私","わたくし"],["に"],["高い","たかい"],["所","ところ"],["を"],["歩ませる","あゆませる"],["。"],["／"],["指揮者","しきしゃ"],["の"],["ため"],["に"],["。"],["弦楽器","げんがっき"],["に"],["合わせて","あわせて"],["。"]]}]
[{"verse":1,"text":"ダリヨス王の第二年の第七の月の二十一日に、預言者ハガイを通して、次のような主のことばがあった。","tok":[["ダリヨス"],["王","おう"],["の"],["第","だい"],["二","に"],["年","ねん"],["の"],["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["二十一","にじゅういち"],["日","にち"],["に"],["、"],["預言者","よげんしゃ"],["ハガイ"],["を"],["通して","とおして"],["、"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「シェアルティエルの子、ユダの総督ゼルバベルと、エホツァダクの子、大祭司ヨシュアと、民の残りの者とに次のように言え。","tok":[["「"],["シェアルティエル"],["の"],["子","こ"],["、"],["ユダ"],["の"],["総督","そうとく"],["ゼルバベル"],["と"],["、"],["エホツァダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["と"],["、"],["民","みん"],["の"],["残り","のこり"],["の"],["者","もの"],["と"],["に"],["次","つぎ"],["の"],["よう"],["に"],["言え","いえ"],["。"]]},{"verse":3,"text":"あなたがたのうち、以前の栄光に輝くこの宮を見たことのある、生き残った者はだれか。あなたがたは、今、これをどう見ているのか。あなたがたの目には、まるで無いに等しいのではないか。","tok":[["あなた"],["がた"],["の"],["うち"],["、"],["以前","いぜん"],["の"],["栄光","えいこう"],["に"],["輝く","かがやく"],["この"],["宮","みや"],["を"],["見た","みた"],["こと"],["の"],["ある"],["、"],["生き残った","いきのこった"],["者","もの"],["は"],["だれ"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["今","いま"],["、"],["これ"],["を"],["どう"],["見て","みて"],["いる"],["の"],["か"],["。"],["あなた"],["がた"],["の"],["目","め"],["に"],["は"],["、"],["まるで"],["無い","ない"],["に"],["等しい","ひとしい"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":4,"text":"しかし、ゼルバベルよ、今、強くあれ。――主の御告げ――エホツァダクの子、大祭司ヨシュアよ。強くあれ。この国のすべての民よ。強くあれ。――主の御告げ――仕事に取りかかれ。わたしがあなたがたとともにいるからだ。――万軍の主の御告げ――","tok":[["しかし"],["、"],["ゼルバベル"],["よ"],["、"],["今","いま"],["、"],["強く","つよく"],["あれ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["エホツァダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["よ"],["。"],["強く","つよく"],["あれ"],["。"],["この"],["国","くに"],["の"],["すべて"],["の"],["民","たみ"],["よ"],["。"],["強く","つよく"],["あれ"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["仕事","しごと"],["に"],["取りかかれ","とりかかれ"],["。"],["わたし"],["が"],["あなた"],["がた"],["と"],["とも"],["に"],["いる"],["から"],["だ"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":5,"text":"あなたがたがエジプトから出て来たとき、わたしがあなたがたと結んだ約束により、わたしの霊があなたがたの間で働いている。恐れるな。","tok":[["あなた"],["がた"],["が"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["とき"],["、"],["わたし"],["が"],["あなた"],["がた"],["と"],["結んだ","むすんだ"],["約束","やくそく"],["に"],["より"],["、"],["わたし"],["の"],["霊","れい"],["が"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["働いて","はたらいて"],["いる"],["。"],["恐れる","おそれる"],["な"],["。"]]},{"verse":6,"text":"まことに、万軍の主はこう仰せられる。しばらくして、もう一度、わたしは天と地と、海と陸とを揺り動かす。","tok":[["まこと"],["に"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["しばらく"],["して"],["、"],["もう"],["一度","いちど"],["、"],["わたし"],["は"],["天","てん"],["と"],["地","ち"],["と"],["、"],["海","うみ"],["と"],["陸","りく"],["と"],["を"],["揺り動かす","ゆりうごかす"],["。"]]},{"verse":7,"text":"わたしは、すべての国々を揺り動かす。すべての国々の宝物がもたらされ、わたしはこの宮を栄光で満たす。万軍の主は仰せられる。","tok":[["わたし"],["は"],["、"],["すべて"],["の"],["国々","くにぐに"],["を"],["揺り動かす","ゆりうごかす"],["。"],["すべて"],["の"],["国々","くにぐに"],["の"],["宝物","たからもの"],["が"],["もたらされ"],["、"],["わたし"],["は"],["この"],["宮","みや"],["を"],["栄光","えいこう"],["で"],["満たす","みたす"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":8,"text":"銀はわたしのもの。金もわたしのもの。――万軍の主の御告げ――","tok":[["銀","ぎん"],["は"],["わたし"],["の"],["もの"],["。"],["金","きん"],["も"],["わたし"],["の"],["もの"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":9,"text":"この宮のこれから後の栄光は、先のものよりまさろう。万軍の主は仰せられる。わたしはまた、この所に平和を与える。――万軍の主の御告げ――」","tok":[["この"],["宮","みや"],["の"],["これ"],["から"],["後","あと"],["の"],["栄光","えいこう"],["は"],["、"],["先","さき"],["の"],["もの"],["より"],["まさろう"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["また"],["、"],["この"],["所","ところ"],["に"],["平和","へいわ"],["を"],["与える","あたえる"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":10,"text":"ダリヨスの第二年の第九の月の二十四日、預言者ハガイに次のような主のことばがあった。","tok":[["ダリヨス"],["の"],["第","だい"],["二","に"],["年","ねん"],["の"],["第","だい"],["九","きゅう"],["の"],["月","つき"],["の"],["二十四日","にじゅうよんか"],["、"],["預言者","よげんしゃ"],["ハガイ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":11,"text":"「万軍の主はこう仰せられる。次の律法について、祭司たちに尋ねて言え。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["次","つぎ"],["の"],["律法","りっぽう"],["について"],["、"],["祭司","さいし"],["たち"],["に"],["尋ねて","たずねて"],["言え","いえ"],["。"]]},{"verse":12,"text":"もし人が聖なる肉を自分の着物のすそで運ぶとき、そのすそがパンや煮物、ぶどう酒や油、またどんな食物にでも触れたなら、それは聖なるものとなるか。」祭司たちは答えて「否」と言った。","tok":[["もし"],["人","ひと"],["が"],["聖","せい"],["なる"],["肉","にく"],["を"],["自分","じぶん"],["の"],["着物","きもの"],["の"],["すそ"],["で"],["運ぶ","はこぶ"],["とき"],["、"],["その"],["すそ"],["が"],["パン"],["や"],["煮物","にもの"],["、"],["ぶどう酒","ぶどうしゅ"],["や"],["油","あぶら"],["、"],["また"],["どんな"],["食物","しょくもつ"],["に"],["で"],["も"],["触れたなら","ふれたなら"],["、"],["それ"],["は"],["聖","せい"],["なる"],["もの"],["と"],["なる"],["か"],["。"],["」"],["祭司","さいし"],["たち"],["は"],["答えて","こたえて"],["「"],["否","いな"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"そこでハガイは言った。「もし死体によって汚れた人が、これらのどれにでも触れたなら、それは汚れるか。」祭司たちは答えて「汚れる」と言った。","tok":[["そこ"],["で"],["ハガイ"],["は"],["言った","いった"],["。"],["「"],["もし"],["死体","したい"],["によって"],["汚れた","よごれた"],["人","ひと"],["が"],["、"],["これ"],["ら"],["の"],["どれ"],["に"],["で"],["も"],["触れたなら","ふれたなら"],["、"],["それ"],["は"],["汚れる","よごれる"],["か"],["。"],["」"],["祭司","さいし"],["たち"],["は"],["答えて","こたえて"],["「"],["汚れる","よごれる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"ハガイはそれに応じて言った。「わたしにとっては、この民はそのようなものだ。この国もそのようである。――主の御告げ――彼らの手で作ったすべての物もそのようだ。彼らがそこにささげる物、それは汚れている。","tok":[["ハガイ"],["は"],["それ"],["に"],["応じて","おうじて"],["言った","いった"],["。"],["「"],["わたし"],["にとって"],["は"],["、"],["この"],["民","みん"],["は"],["その"],["よう"],["な"],["もの"],["だ"],["。"],["この"],["国","くに"],["も"],["その"],["よう"],["で"],["ある"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["彼","かれ"],["ら"],["の"],["手","て"],["で"],["作った","つくった"],["すべて"],["の"],["物","もの"],["も"],["その"],["よう"],["だ"],["。"],["彼","かれ"],["ら"],["が"],["そこ"],["に"],["ささげる"],["物","もの"],["、"],["それ"],["は"],["汚れて","よごれて"],["いる"],["。"]]},{"verse":15,"text":"さあ、今、あなたがたは、きょうから後のことをよく考えよ。主の神殿で石が積み重ねられる前は、","tok":[["さあ"],["、"],["今","いま"],["、"],["あなた"],["がた"],["は"],["、"],["きょう"],["から"],["後","あと"],["の"],["こと"],["を"],["よく"],["考え","かんがえ"],["よ"],["。"],["主","ぬし"],["の"],["神殿","しんでん"],["で"],["石","いし"],["が"],["積み重ねられる","つみかさねられる"],["前","まえ"],["は"],["、"]]},{"verse":16,"text":"あなたがたはどうであったか。二十の麦束の積んである所に行っても、ただ十束しかなく、五十おけを汲もうと酒ぶねに行っても、二十おけ分しかなかった。","tok":[["あなた"],["がた"],["は"],["どう"],["で"],["あった"],["か"],["。"],["二十","にじゅう"],["の"],["麦","むぎ"],["束","たば"],["の"],["積んで","つんで"],["ある"],["所","ところ"],["に"],["行って","いって"],["も"],["、"],["ただ"],["十束","とつか"],["しか"],["なく"],["、"],["五十","ごじゅう"],["おけ"],["を"],["汲もう","くもう"],["と"],["酒","さけ"],["ぶね"],["に"],["行って","いって"],["も"],["、"],["二十","にじゅう"],["おけ"],["分","ぶん"],["しか"],["なかった"],["。"]]},{"verse":17,"text":"わたしは、あなたがたを立ち枯れと黒穂病とで打ち、あなたがたの手がけた物をことごとく雹で打った。しかし、あなたがたのうちだれひとり、わたしに帰って来なかった。――主の御告げ――","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["立ち枯れ","たちがれ"],["と"],["黒穂病","くろほびょう"],["と"],["で"],["打ち","うち"],["、"],["あなた"],["がた"],["の"],["手がけた","てがけた"],["物","もの"],["を"],["ことごとく"],["雹","ひょう"],["で"],["打った","うった"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["うち"],["だれ"],["ひとり"],["、"],["わたし"],["に"],["帰って","かえって"],["来なかった","こなかった"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":18,"text":"さあ、あなたがたは、きょうから後のことをよく考えよ。すなわち、第九の月の二十四日、主の神殿の礎が据えられた日から後のことをよく考えよ。","tok":[["さあ"],["、"],["あなた"],["がた"],["は"],["、"],["きょう"],["から"],["後","あと"],["の"],["こと"],["を"],["よく"],["考え","かんがえ"],["よ"],["。"],["すなわち"],["、"],["第","だい"],["九","きゅう"],["の"],["月","つき"],["の"],["二十四日","にじゅうよんか"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["礎","いしずえ"],["が"],["据えられた","すえられた"],["日","ひ"],["から"],["後","あと"],["の"],["こと"],["を"],["よく"],["考え","かんがえ"],["よ"],["。"]]},{"verse":19,"text":"種はまだ穀物倉にあるだろうか。ぶどうの木、いちじくの木、ざくろの木、オリーブの木は、まだ実を結ばないだろうか。きょうから後、わたしは祝福しよう。」","tok":[["種","しゅ"],["は"],["まだ"],["穀物倉","こくもつそう"],["に"],["あるだろう"],["か"],["。"],["ぶどう"],["の"],["木","き"],["、"],["いちじく"],["の"],["木","き"],["、"],["ざくろ"],["の"],["木","き"],["、"],["オリーブ"],["の"],["木","き"],["は"],["、"],
[{"verse":1,"text":"ダリヨス王の第二年の第六の月の一日に、預言者ハガイを通して、シェアルティエルの子、ユダの総督ゼルバベルと、エホツァダクの子、大祭司ヨシュアとに、次のような主のことばがあった。","tok":[["ダリヨス"],["王","おう"],["の"],["第","だい"],["二","に"],["年","ねん"],["の"],["第","だい"],["六","ろく"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["、"],["預言者","よげんしゃ"],["ハガイ"],["を"],["通して","とおして"],["、"],["シェアルティエル"],["の"],["子","こ"],["、"],["ユダ"],["の"],["総督","そうとく"],["ゼルバベル"],["と"],["、"],["エホツァダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["と"],["に"],["、"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「万軍の主はこう仰せられる。この民は、主の宮を建てる時はまだ来ない、と言っている。」","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["この"],["民","みん"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["を"],["建てる","たてる"],["時","とき"],["は"],["まだ"],["来ない","こない"],["、"],["と"],["言って","いって"],["いる"],["。"],["」"]]},{"verse":3,"text":"ついで預言者ハガイを通して、次のような主のことばがあった。","tok":[["ついで"],["預言者","よげんしゃ"],["ハガイ"],["を"],["通して","とおして"],["、"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":4,"text":"「この宮が廃墟となっているのに、あなたがただけが板張りの家に住むべき時であろうか。","tok":[["「"],["この"],["宮","みや"],["が"],["廃墟","はいきょ"],["と"],["なって"],["いる"],["のに"],["、"],["あなた"],["がた"],["だけ"],["が"],["板張り","いたばり"],["の"],["家","いえ"],["に"],["住むべき","すむべき"],["時","とき"],["で"],["あろう"],["か"],["。"]]},{"verse":5,"text":"今、万軍の主はこう仰せられる。あなたがたの現状をよく考えよ。","tok":[["今","いま"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["の"],["現状","げんじょう"],["を"],["よく"],["考え","かんがえ"],["よ"],["。"]]},{"verse":6,"text":"あなたがたは、多くの種を蒔いたが少ししか取り入れず、食べたが飽き足らず、飲んだが酔えず、着物を着たが暖まらない。かせぐ者がかせいでも、穴のあいた袋に入れるだけだ。","tok":[["あなた"],["がた"],["は"],["、"],["多く","おおく"],["の"],["種","たね"],["を"],["蒔いた","まいた"],["が"],["少し","すこし"],["しか"],["取り入れず","とりいれず"],["、"],["食べた","たべた"],["が"],["飽き足らず","あきたらず"],["、"],["飲んだ","のんだ"],["が"],["酔えず","よえず"],["、"],["着物","きもの"],["を"],["着た","きた"],["が"],["暖まらない","あたたまらない"],["。"],["かせぐ"],["者","もの"],["が"],["かせいで"],["も"],["、"],["穴","あな"],["の"],["あいた"],["袋","ふくろ"],["に"],["入れる","いれる"],["だけ"],["だ"],["。"]]},{"verse":7,"text":"万軍の主はこう仰せられる。あなたがたの現状をよく考えよ。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["の"],["現状","げんじょう"],["を"],["よく"],["考え","かんがえ"],["よ"],["。"]]},{"verse":8,"text":"山に登り、木を運んで来て、宮を建てよ。そうすれば、わたしはそれを喜び、わたしの栄光を現そう。主は仰せられる。","tok":[["山","やま"],["に"],["登り","のぼり"],["、"],["木","き"],["を"],["運んで","はこんで"],["来て","きて"],["、"],["宮","みや"],["を"],["建て","たて"],["よ"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["それ"],["を"],["喜び","よろこび"],["、"],["わたし"],["の"],["栄光","えいこう"],["を"],["現そう","あらわそう"],["。"],["主","ぬし"],["は"],["仰せられる","おおせられる"],["。"]]},{"verse":9,"text":"あなたがたは多くを期待したが、見よ、わずかであった。あなたがたが家に持ち帰ったとき、わたしはそれを吹き飛ばした。それはなぜか。――万軍の主の御告げ――それは、廃墟となったわたしの宮のためだ。あなたがたがみな、自分の家のために走り回っていたからだ。","tok":[["あなた"],["がた"],["は"],["多く","おおく"],["を"],["期待","きたい"],["した"],["が"],["、"],["見よ","みよ"],["、"],["わずか"],["で"],["あった"],["。"],["あなた"],["がた"],["が"],["家","いえ"],["に"],["持ち帰った","もちかえった"],["とき"],["、"],["わたし"],["は"],["それ"],["を"],["吹き飛ばした","ふきとばした"],["。"],["それ"],["は"],["なぜ"],["か"],["。"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["それ"],["は"],["、"],["廃墟","はいきょ"],["と"],["なった"],["わたし"],["の"],["宮","みや"],["の"],["ため"],["だ"],["。"],["あなた"],["がた"],["が"],["みな"],["、"],["自分","じぶん"],["の"],["家","いえ"],["の"],["ため"],["に"],["走り回って","はしりまわって"],["いた"],["から"],["だ"],["。"]]},{"verse":10,"text":"それゆえ、天はあなたがたのために露を降らすことをやめ、地は産物を差し止めた。","tok":[["それ"],["ゆえ"],["、"],["天","てん"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["露","ろ"],["を"],["降らす","ふらす"],["こと"],["を"],["やめ"],["、"],["地","ち"],["は"],["産物","さんぶつ"],["を"],["差し止めた","さしとめた"],["。"]]},{"verse":11,"text":"わたしはまた、地にも、山々にも、穀物にも、新しいぶどう酒にも、油にも、地が生やす物にも、人にも、家畜にも、手によるすべての勤労の実にも、ひでりを呼び寄せた。」","tok":[["わたし"],["は"],["また"],["、"],["地","ち"],["に"],["も"],["、"],["山々","やまやま"],["に"],["も"],["、"],["穀物","こくもつ"],["に"],["も"],["、"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["に"],["も"],["、"],["油","あぶら"],["に"],["も"],["、"],["地","ち"],["が"],["生やす","はやす"],["物","もの"],["に"],["も"],["、"],["人","ひと"],["に"],["も"],["、"],["家畜","かちく"],["に"],["も"],["、"],["手","て"],["に"],["よる"],["すべて"],["の"],["勤労","きんろう"],["の"],["実","じつ"],["に"],["も"],["、"],["ひでり"],["を"],["呼び寄せた","よびよせた"],["。"],["」"]]},{"verse":12,"text":"そこで、シェアルティエルの子ゼルバベルと、エホツァダクの子、大祭司ヨシュアと、民のすべての残りの者とは、彼らの神、主の御声と、また、彼らの神、主が遣わされた預言者ハガイのことばとに聞き従った。民は主の前で恐れた。","tok":[["そこ"],["で"],["、"],["シェアルティエル"],["の"],["子","こ"],["ゼルバベル"],["と"],["、"],["エホツァダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["と"],["、"],["民","みん"],["の"],["すべて"],["の"],["残り","のこり"],["の"],["者","もの"],["と"],["は"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["と"],["、"],["また"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["遣わされた","つかわされた"],["預言者","よげんしゃ"],["ハガイ"],["の"],["ことば"],["と"],["に"],["聞き従った","ききしたがった"],["。"],["民","たみ"],["は"],["主","ぬし"],["の"],["前","まえ"],["で"],["恐れた","おそれた"],["。"]]},{"verse":13,"text":"そのとき、主の使いハガイは、主から使命を受けて、民にこう言った。「わたしは、あなたがたとともにいる。――主の御告げ――」","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["使い","つかい"],["ハガイ"],["は"],["、"],["主","ぬし"],["から"],["使命","しめい"],["を"],["受けて","うけて"],["、"],["民","みん"],["に"],["こう"],["言った","いった"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["いる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":14,"text":"主は、シェアルティエルの子、ユダの総督ゼルバベルの心と、エホツァダクの子、大祭司ヨシュアの心と、民のすべての残りの者の心とを奮い立たせたので、彼らは彼らの神、万軍の主の宮に行って、仕事に取りかかった。","tok":[["主","ぬし"],["は"],["、"],["シェアルティエル"],["の"],["子","こ"],["、"],["ユダ"],["の"],["総督","そうとく"],["ゼルバベル"],["の"],["心","こころ"],["と"],["、"],["エホツァダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["の"],["心","こころ"],["と"],["、"],["民","みん"],["の"],["すべて"],["の"],["残り","のこり"],["の"],["者","もの"],["の"],["心","こころ"],["と"],["を"],["奮い立たせた","ふるいたたせた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["宮","みや"],["に"],["行って","いって"],["、"],["仕事","しごと"],["に"],["取りかかった","とりかかった"],["。"]]},{"verse":15,"text":"それは第六の月の二十四日のことであった。","tok":[["それ"],["は"],["第","だい"],["六","ろく"],["の"],["月","つき"],["の"],["二十四日","にじゅうよんか"],["の"],["こと"],["で"],["あった"],["。"]]}]
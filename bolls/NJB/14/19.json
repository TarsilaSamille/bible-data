[{"verse":1,"text":"ユダの王ヨシャパテは無事に自分の家に帰り、エルサレムに戻った。","tok":[["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["は"],["無事","ぶじ"],["に"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰り","かえり"],["、"],["エルサレム"],["に"],["戻った","もどった"],["。"]]},{"verse":2,"text":"すると、先見者ハナニの子エフーが彼の前に出向いて来て、ヨシャパテ王に言った。「悪者を助けるべきでしょうか。あなたは主を憎む者たちを愛してよいのでしょうか。これによって、あなたの上に、主の前から怒りが下ります。","tok":[["する"],["と"],["、"],["先見者","せんけんしゃ"],["ハナニ"],["の"],["子","こ"],["エフー"],["が"],["彼","かれ"],["の"],["前","まえ"],["に"],["出向いて","でむいて"],["来て","きて"],["、"],["ヨシャパテ"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["悪者","わるもの"],["を"],["助けるべきでしょう","たすけるべきでしょう"],["か"],["。"],["あなた"],["は"],["主","ぬし"],["を"],["憎む","にくむ"],["者","もの"],["たち"],["を"],["愛して","あいして"],["よい"],["の"],["でしょう"],["か"],["。"],["これ"],["によって"],["、"],["あなた"],["の"],["上","うえ"],["に"],["、"],["主","ぬし"],["の"],["前","まえ"],["から"],["怒り","いかり"],["が"],["下ります","くだります"],["。"]]},{"verse":3,"text":"しかし、あなたには、良いことも幾つか見られます。あなたはこの地からアシェラ像を除き去り、心を定めて常に神を求めて来られました。」","tok":[["しかし"],["、"],["あなた"],["に"],["は"],["、"],["良い","よい"],["こと"],["も"],["幾つ","いくつ"],["か"],["見られます","みられます"],["。"],["あなた"],["は"],["この"],["地","ち"],["から"],["アシェラ"],["像","ぞう"],["を"],["除き去り","のぞきさり"],["、"],["心","こころ"],["を"],["定めて","さだめて"],["常","つね"],["に"],["神","かみ"],["を"],["求めて","もとめて"],["来られました","こられました"],["。"],["」"]]},{"verse":4,"text":"ヨシャパテはエルサレムに住んだ。それから、彼はもう一度ベエル・シェバからエフライムの山地に至る民の中へ出て行き、彼らをその父祖の神、主に立ち返らせた。","tok":[["ヨシャパテ"],["は"],["エルサレム"],["に"],["住んだ","すんだ"],["。"],["それ"],["から"],["、"],["彼","かれ"],["は"],["もう"],["一度","いちど"],["ベエル"],["・"],["シェバ"],["から"],["エフライム"],["の"],["山地","さんち"],["に"],["至る","いたる"],["民","たみ"],["の"],["中","なか"],["へ"],["出て","でて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["を"],["その"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主に","おもに"],["立ち返らせた","たちかえらせた"],["。"]]},{"verse":5,"text":"さらに、彼はこの地、すなわち、ユダにあるすべての城壁のある町々にさばきつかさを立て、町ごとにこれを任命し、","tok":[["さらに"],["、"],["彼","かれ"],["は"],["この"],["地","ち"],["、"],["すなわち"],["、"],["ユダ"],["に"],["ある"],["すべて"],["の"],["城壁","じょうへき"],["の"],["ある"],["町々","まちまち"],["に"],["さばき"],["つかさ"],["を"],["立て","たて"],["、"],["町","まち"],["ごと"],["に"],["これ"],["を"],["任命","にんめい"],["し"],["、"]]},{"verse":6,"text":"さばきつかさたちにこう言った。「あなたがたは自分のする事に注意しなさい。あなたがたがさばくのは、人のためではなく、主のためだからです。この方は、さばきが行われるとき、あなたがたとともにおられるのです。","tok":[["さばき"],["つかさ"],["たち"],["に"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["する"],["事","こと"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"],["あなた"],["がた"],["が"],["さばく"],["の"],["は"],["、"],["人","ひと"],["の"],["ため"],["で"],["は"],["なく"],["、"],["主","ぬし"],["の"],["ため"],["だ"],["から"],["です"],["。"],["この"],["方","かた"],["は"],["、"],["さばき"],["が"],["行われる","おこなわれる"],["とき"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["おられる"],["の"],["です"],["。"]]},{"verse":7,"text":"今、主への恐れがあなたがたにあるように。忠実に行いなさい。私たちの神、主には、不正も、えこひいきも、わいろを取ることもないからです。」","tok":[["今","いま"],["、"],["主","ぬし"],["へ"],["の"],["恐れ","おそれ"],["が"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"],["忠実","ちゅうじつ"],["に"],["行い","おこない"],["なさい"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["に"],["は"],["、"],["不正","ふせい"],["も"],["、"],["えこ"],["ひいき"],["も"],["、"],["わいろ"],["を"],["取る","とる"],["こと"],["も"],["ない"],["から"],["です"],["。"],["」"]]},{"verse":8,"text":"なお、ヨシャパテはエルサレムでは、レビ人と祭司の中から、またイスラエルに属する一族のかしらたちの中から、主のさばき、および訴訟に携わる者たちを任命していた。エルサレムに帰ったとき、","tok":[["なお"],["、"],["ヨシャパテ"],["は"],["エルサレム"],["で"],["は"],["、"],["レビ人","れびにん"],["と"],["祭司","さいし"],["の"],["中","なか"],["から"],["、"],["また"],["イスラエル"],["に"],["属する","ぞくする"],["一族","いちぞく"],["の"],["かしら"],["たち"],["の"],["中","なか"],["から"],["、"],["主","ぬし"],["の"],["さばき"],["、"],["および"],["訴訟","そしょう"],["に"],["携わる","たずさわる"],["者","もの"],["たち"],["を"],["任命","にんめい"],["して"],["いた"],["。"],["エルサレム"],["に"],["帰った","かえった"],["とき"],["、"]]},{"verse":9,"text":"彼はこの人々に次のように命じた。「あなたがたは、主を恐れ、忠実に、また全き心をもって、このように行わなければなりません。10おのおのの町に住んでいるあなたがたの兄弟たちから、あるいは互いの流血事件について、あるいは律法、命令、おきて、定めなどについて、あなたがたのところに訴訟が持ち込まれた場合には、いつでも、あなたがたは、彼らが主に対して罪を負い、その結果、あなたがたとあなたがたの兄弟たちの上に御怒りが下ることのないよう、彼らに警告を与えなければなりません。あなたがたはこのように行いなさい。そうすれば罪を負わずに済むのです。","tok":[["彼","かれ"],["は"],["この"],["人々","ひとびと"],["に"],["次","つぎ"],["の"],["よう"],["に"],["命じた","めいじた"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["忠実","ちゅうじつ"],["に"],["、"],["また"],["全","ぜん"],["き"],["心","こころ"],["を"],["もって"],["、"],["この"],["よう"],["に"],["行わなければ","おこなわなければ"],["なりません"],["。"],["10"],["おのおの"],["の"],["町","まち"],["に"],["住んで","すんで"],["いる"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["たち"],["から"],["、"],["あるいは"],["互い","たがい"],["の"],["流血","りゅうけつ"],["事件","じけん"],["について"],["、"],["あるいは"],["律法","りっぽう"],["、"],["命令","めいれい"],["、"],["おきて"],["、"],["定め","さだめ"],["など"],["について"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["訴訟","そしょう"],["が"],["持ち込まれた","もちこまれた"],["場合","ばあい"],["に"],["は"],["、"],["いつ"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["、"],["彼","かれ"],["ら"],["が"],["主","ぬし"],["に対して","にたいして"],["罪","つみ"],["を"],["負い","おい"],["、"],["その"],["結果","けっか"],["、"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["たち"],["の"],["上","うえ"],["に"],["御怒り","おいかり"],["が"],["下る","くだる"],["こと"],["の"],["ない"],["よう"],["、"],["彼","かれ"],["ら"],["に"],["警告","けいこく"],["を"],["与えなければ","あたえなければ"],["なりません"],["。"],["あなた"],["がた"],["は"],["この"],["よう"],["に"],["行い","おこない"],["なさい"],["。"],["そう"],["すれば"],["罪","つみ"],["を"],["負わず","おわず"],["に"],["済む","すむ"],["の"],["です"],["。"]]},{"verse":11,"text":"ご覧なさい。あなたがたの上のかしら、祭司アマルヤは、主の事がら全体に当たります。また、ユダの家のつかさイシュマエルの子ゼバデヤは王の事がら全体に当たってくれます。さらに、あなたがたの前のレビ人はつかさです。勇気を出して実行しなさい。主が善人とともにいてくださるように。」","tok":[["ご覧","ごらん"],["なさい"],["。"],["あなた"],["がた"],["の"],["上","うえ"],["の"],["かしら"],["、"],["祭司","さいし"],["アマルヤ"],["は"],["、"],["主","ぬし"],["の"],["事がら","ことがら"],["全体","ぜんたい"],["に"],["当たります","あたります"],["。"],["また"],["、"],["ユダ"],["の"],["家","いえ"],["の"],["つかさ"],["イシュマエル"],["の"],["子","こ"],["ゼバデヤ"],["は"],["王","おう"],["の"],["事がら","ことがら"],["全体","ぜんたい"],["に"],["当たって","あたって"],["くれます"],["。"],["さらに"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["の"],["レビ人","れびにん"],["は"],["つかさ"],["です"],["。"],["勇気","ゆうき"],["を"],["出して","だして"],["実行","じっこう"],["し"],["なさい"],["。"],["主","ぬし"],["が"],["善人","ぜんにん"],["と"],["とも"],["に"],["いて"],["くださる"],["よう"],["に"],["。"],["」"]]}]
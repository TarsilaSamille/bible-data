[{"verse":1,"text":"アマツヤは二十五歳で王となり、エルサレムで二十九年間、王であった。彼の母の名はエホアダンといい、エルサレムの出であった。","tok":[["アマツヤ"],["は"],["二十五歳","にじゅうごさい"],["で"],["王","おう"],["と"],["なり"],["、"],["エルサレム"],["で"],["二十九","にじゅうきゅう"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"],["彼","かれ"],["の"],["母","はは"],["の"],["名","な"],["は"],["エホアダン"],["と"],["いい"],["、"],["エルサレム"],["の"],["出","で"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼は主の目にかなうことを行ったが、全き心をもってではなかった。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["かなう"],["こと"],["を"],["行った","おこなった"],["が"],["、"],["全","ぜん"],["き"],["心","こころ"],["を"],["もって"],["で"],["は"],["なかった"],["。"]]},{"verse":3,"text":"彼の王国が強くなると、彼は自分の父、王を打ち殺した家来たちを殺した。","tok":[["彼","かれ"],["の"],["王国","おうこく"],["が"],["強く","つよく"],["なる"],["と"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["父","ちち"],["、"],["王","おう"],["を"],["打ち殺した","うちころした"],["家来","けらい"],["たち"],["を"],["殺した","ころした"],["。"]]},{"verse":4,"text":"しかし、彼らの子どもたちは殺さなかった。それは、モーセの書の律法にしるされているところによったからである。主はこう命じておられた。「父親が子どものために殺されてはならない。子どもが父親のために殺されてはならない。人が殺されるのは、自分の罪のためでなければならないからである。」","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["の"],["子ども","こども"],["たち"],["は"],["殺さなかった","ころさなかった"],["。"],["それ"],["は"],["、"],["モーセ"],["の"],["書","しょ"],["の"],["律法","りっぽう"],["に"],["しるされて"],["いる"],["ところ"],["に"],["よった"],["から"],["で"],["ある"],["。"],["主","ぬし"],["は"],["こう"],["命じて","めいじて"],["おられた"],["。"],["「"],["父親","ちちおや"],["が"],["子ども","こども"],["の"],["ため"],["に"],["殺されて","ころされて"],["は"],["ならない"],["。"],["子ども","こども"],["が"],["父親","ちちおや"],["の"],["ため"],["に"],["殺されて","ころされて"],["は"],["ならない"],["。"],["人","ひと"],["が"],["殺される","ころされる"],["の"],["は"],["、"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ため"],["で"],["なければ"],["ならない"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"アマツヤはユダを召集し、ユダおよびベニヤミン全員を、千人隊の長、百人隊の長の下に、父祖の家ごとに整列させた。こうして、二十歳以上の者を登録し、従軍して槍と大盾を手にする精鋭三十万人を得た。","tok":[["アマツヤ"],["は"],["ユダ"],["を"],["召集","しょうしゅう"],["し"],["、"],["ユダ"],["および"],["ベニヤミン"],["全員","ぜんいん"],["を"],["、"],["千人隊","せんにんたい"],["の"],["長","ちょう"],["、"],["百人隊","ひゃくにんたい"],["の"],["長","ちょう"],["の"],["下","した"],["に"],["、"],["父祖","ふそ"],["の"],["家","いえ"],["ごと"],["に"],["整列","せいれつ"],["させた"],["。"],["こう"],["して"],["、"],["二十歳","はたち"],["以上","いじょう"],["の"],["者","もの"],["を"],["登録","とうろく"],["し"],["、"],["従軍","じゅうぐん"],["して"],["槍","やり"],["と"],["大","だい"],["盾","たて"],["を"],["手","て"],["に"],["する"],["精鋭","せいえい"],["三十万人","さんじゅうまんにん"],["を"],["得た","えた"],["。"]]},{"verse":6,"text":"さらに、彼はイスラエルから、銀百タラントで、十万人の勇士を雇った。","tok":[["さらに"],["、"],["彼","かれ"],["は"],["イスラエル"],["から"],["、"],["銀","ぎん"],["百","ひゃく"],["タラント"],["で"],["、"],["十万人","じゅうまんにん"],["の"],["勇士","ゆうし"],["を"],["雇った","やとった"],["。"]]},{"verse":7,"text":"神の人が彼のもとに来て言った。「王よ。イスラエルの軍勢をあなたとともに行かせてはなりません。主は、イスラエル、すなわち、すべてのエフライム族とは、共におられないからです。","tok":[["神","かみ"],["の"],["人","ひと"],["が"],["彼","かれ"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["王","おう"],["よ"],["。"],["イスラエル"],["の"],["軍勢","ぐんぜい"],["を"],["あなた"],["と"],["とも"],["に"],["行かせて","いかせて"],["は"],["なりません"],["。"],["主","ぬし"],["は"],["、"],["イスラエル"],["、"],["すなわち"],["、"],["すべて"],["の"],["エフライム"],["族","ぞく"],["と"],["は"],["、"],["共","とも"],["に"],["おられない"],["から"],["です"],["。"]]},{"verse":8,"text":"それでも、あなたが行くと言われるのなら、そうしなさい。雄々しく戦いなさい。神は敵の前にあなたをつまずかせられます。神には、助ける力があり、つまずかせる力もあるからです。」","tok":[["それ"],["で"],["も"],["、"],["あなた"],["が"],["行く","いく"],["と"],["言われる","いわれる"],["の"],["なら"],["、"],["そう"],["し"],["なさい"],["。"],["雄々しく","おおしく"],["戦い","たたかい"],["なさい"],["。"],["神","かみ"],["は"],["敵","てき"],["の"],["前","まえ"],["に"],["あなた"],["を"],["つまずかせられます"],["。"],["神","かみ"],["に"],["は"],["、"],["助ける","たすける"],["力","ちから"],["が"],["あり"],["、"],["つまずかせる"],["力","ちから"],["も"],["ある"],["から"],["です"],["。"],["」"]]},{"verse":9,"text":"アマツヤは神の人に言った。「では、イスラエルの軍勢に与えた百タラントはどうしたらよいのか。」神の人は答えた。「主はそれよりも多くのものをあなたに与えることがおできになります。」","tok":[["アマツヤ"],["は"],["神","かみ"],["の"],["人","ひと"],["に"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["イスラエル"],["の"],["軍勢","ぐんぜい"],["に"],["与えた","あたえた"],["百","ひゃく"],["タラント"],["は"],["どう"],["したら"],["よい"],["の"],["か"],["。"],["」"],["神","かみ"],["の"],["人","ひと"],["は"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["は"],["それ"],["より"],["も"],["多く","おおく"],["の"],["もの"],["を"],["あなた"],["に"],["与える","あたえる"],["こと"],["が"],["おでき"],["に"],["なります"],["。"],["」"]]},{"verse":10,"text":"そこで、アマツヤは、エフライムから彼のもとに来た軍隊を取り分けて、彼らの所に帰したので、彼らはユダに向かって怒りを激しく燃やし、怒りに燃えながら、自分たちのところへ帰った。","tok":[["そこ"],["で"],["、"],["アマツヤ"],["は"],["、"],["エフライム"],["から"],["彼","かれ"],["の"],["もと"],["に"],["来た","きた"],["軍隊","ぐんたい"],["を"],["取り分けて","とりわけて"],["、"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["帰した","かえした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ユダ"],["に"],["向かって","むかって"],["怒り","いかり"],["を"],["激しく","はげしく"],["燃やし","もやし"],["、"],["怒り","いかり"],["に"],["燃え","もえ"],["ながら"],["、"],["自分","じぶん"],["たち"],["の"],["ところ"],["へ"],["帰った","かえった"],["。"]]},{"verse":11,"text":"アマツヤは奮い立って、その民を率いて塩の谷に行き、セイルの者たち一万人を打った。","tok":[["アマツヤ"],["は"],["奮い立って","ふるいたって"],["、"],["その"],["民","たみ"],["を"],["率いて","ひきいて"],["塩","しお"],["の"],["谷","たに"],["に"],["行き","いき"],["、"],["セイル"],["の"],["者","もの"],["たち"],["一万人","いちまんにん"],["を"],["打った","うった"],["。"]]},{"verse":12,"text":"ユダ族は一万人を生けどりにして、彼らを岩の頂上に連れて行き、その岩の頂上から、彼らを投げ落とした。彼らはひとり残らず砕かれてしまった。","tok":[["ユダ族","ゆだぞく"],["は"],["一万人","いちまんにん"],["を"],["生けどり","いけどり"],["に"],["して"],["、"],["彼","かれ"],["ら"],["を"],["岩","いわ"],["の"],["頂上","ちょうじょう"],["に"],["連れて","つれて"],["行き","いき"],["、"],["その"],["岩","いわ"],["の"],["頂上","ちょうじょう"],["から"],["、"],["彼","かれ"],["ら"],["を"],["投げ落とした","なげおとした"],["。"],["彼","かれ"],["ら"],["は"],["ひとり"],["残らず","のこらず"],["砕かれて","くだかれて"],["しまった"],["。"]]},{"verse":13,"text":"アマツヤが自分とともに戦いに行かせずに帰した軍隊の者たちは、サマリヤからベテ・ホロンに及ぶユダの町々に突入し、三千人を打って、多くの物をかすめ奪った。","tok":[["アマツヤ"],["が"],["自分","じぶん"],["と"],["とも"],["に"],["戦い","たたかい"],["に"],["行かせず","いかせず"],["に"],["帰した","かえした"],["軍隊","ぐんたい"],["の"],["者","もの"],["たち"],["は"],["、"],["サマリヤ"],["から"],["ベテ"],["・"],["ホロン"],["に"],["及ぶ","およぶ"],["ユダ"],["の"],["町々","まちまち"],["に"],["突入","とつにゅう"],["し"],["、"],["三千人","さんせんにん"],["を"],["打って","うって"],["、"],["多く","おおく"],["の"],["物","もの"],["を"],["かすめ"],["奪った","うばった"],["。"]]},{"verse":14,"text":"アマツヤは、エドム人を打ち殺して帰って来て後、セイルの者たちの神々を持ち帰り、これを自分の神々として立て、その前に伏し拝み、これに香をたいた。","tok":[["アマツヤ"],["は"],["、"],["エドム人","えどむにん"],["を"],["打ち殺して","うちころして"],["帰って","かえって"],["来て","きて"],["後","あと"],["、"],["セイル"],["の"],["者","もの"],["たち"],["の"],["神々","かみがみ"],["を"],["持ち帰り","もちかえり"],["、"],["これ"],["を"],["自分","じぶん"],["の"],["神々","かみがみ"],["として"],["立て","たて"],["、"],["その"],["前","まえ"],["に"],["伏し拝み","ふしおがみ"],["、"],["これ"],["に"],["香","こう"],["を"],["たいた"],["。"]]},{"verse":15,"text":"そこで、主はアマツヤに向かって怒りを燃やし、彼のもとに預言者を遣わして、彼に仰せられた。「なぜ、あなたは、あなたの手からその民を救い出すこともできないような神々を求めたのか。」","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["アマツヤ"],["に"],["向かって","むかって"],["怒り","いかり"],["を"],["燃やし","もやし"],["、"],["彼","かれ"],["の"],["もと"],["に"],["預言者","よげんしゃ"],["を"],["遣わして","つかわして"],["、"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["なぜ"],["、"],["あなた"],["は"],["、"],["あなた"],["の"],["手","て"],["から"],["その"],["民","たみ"],["を"],["救い出す","すくいだす"],["こと"],["も"],["できない"],["よう"],["な"],["神々","かみがみ"],["を"],["求めた","もとめた"],["の"],["か"],["。"],["」"]]},{"verse":16,"text":"彼が王に語っているうちに、王は彼に言った。「私たちはあなたを王の議官に任じたのか。身のためを思ってやめなさい。なぜ、打ち殺されるようなことをするのか。」そこで、預言者はやめて言った。「私は神があなたを滅ぼそうと計画しておられるのを知りました。あなたがこれを行い、私の勧めを聞かなかったからです。」","tok":[["彼","かれ"],["が"],["王","おう"],["に"],["語って","かたって"],["いる"],["うち"],["に"],["、"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["あなた"],["を"],["王","おう"],["の"],["議官","ぎかん"],["に"],["任じた","にんじた"],["の"],["か"],["。"],["身","み"],["の"],["ため"],["を"],["思って","おもって"],["やめ"],["なさい"],["。"],["なぜ"],["、"],["打ち殺される","うちころされる"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["。"],["」"],["そこ"],["で"],["、"],["預言者","よげんしゃ"],["は"],["やめて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["神","かみ"],["が"],["あなた"],["を"],["滅ぼそう","ほろぼそう"],["と"],["計画","けいかく"],["して"],["おられる"],["の"],["を"],["知りました","しりました"],["。"],["あなた"],["が"],["これ"],["を"],["行い","おこない"],["、"],["私","わたくし"],["の"],["勧め","すすめ"],["を"],["聞かなかった","きかなかった"],["から"],["です"],["。"],["」"]]},{"verse":17,"text":"そののち、ユダの王アマツヤは、よく考えたうえで、エフーの子エホアハズの子、イスラエルの王ヨアシュに、使者を送って言った。「さあ、勝敗を決めようではないか。」","tok":[["その"],["のち"],["、"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["は"],["、"],["よく"],["考えた","かんがえた"],["うえ"],["で"],["、"],["エフー"],["の"],["子","こ"],["エホアハズ"],["の"],["子","こ"],["、"],["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["に"],["、"],["使者","ししゃ"],["を"],["送って","おくって"],["言った","いった"],["。"],["「"],["さあ"],["、"],["勝敗","しょうはい"],["を"],["決め","きめ"],["よう"],["で"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":18,"text":"すると、イスラエルの王ヨアシュは、ユダの王アマツヤに使者を送って言った。「レバノンのあざみが、レバノンの杉に使者を送って、『あなたの娘を私の息子の嫁にくれないか』と言ったが、レバノンの野の獣が通り過ぎて、そのあざみを踏みにじった。","tok":[["する"],["と"],["、"],["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["は"],["、"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["に"],["使者","ししゃ"],["を"],["送って","おくって"],["言った","いった"],["。"],["「"],["レバノン"],["の"],["あざみ"],["が"],["、"],["レバノン"],["の"],["杉","すぎ"],["に"],["使者","ししゃ"],["を"],["送って","おくって"],["、"],["『"],["あなた"],["の"],["娘","むすめ"],["を"],["私","わたくし"],["の"],["息子","むすこ"],["の"],["嫁","よめ"],["に"],["くれない"],["か"],["』"],["と"],["言った","いった"],["が"],["、"],["レバノン"],["の"],["野","の"],["の"],["獣","けもの"],["が"],["通り過ぎて","とおりすぎて"],["、"],["その"],["あざみ"],["を"],["踏みにじった","ふみにじった"],["。"]]},{"verse":19,"text":"あなたは、どうだ、自分はエドムを打ち破ったと言った。あなたの心は高ぶり、誇っている。今は、自分の家にとどまっていなさい。なぜ、争いをしかけてわざわいを求め、あなたもユダも共に倒れようとするのか。」","tok":[["あなた"],["は"],["、"],["どう"],["だ"],["、"],["自分","じぶん"],["は"],["エドム"],["を"],["打ち破った","うちやぶった"],["と"],["言った","いった"],["。"],["あなた"],["の"],["心","こころ"],["は"],["高ぶり","たかぶり"],["、"],["誇って","ほこって"],["いる"],["。"],["今","いま"],["は"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["とどまって"],["い"],["なさい"],["。"],["なぜ"],["、"],["争い","あらそい"],["を"],["しかけて"],["わざわい"],["を"],["求め","もとめ"],["、"],["あなた"],["も"],["ユダ"],["も"],["共","とも"],["に"],["倒れよう","たおれよう"],["と"],["する"],["の"],["か"],["。"],["」"]]},{"verse":20,"text":"しかし、アマツヤは聞き入れなかった。それは、神から出たことで、彼らがエドムの神々を求めたので、彼らを敵の手に渡すためであった。","tok":[["しかし"],["、"],["アマツヤ"],["は"],["聞き入れなかった","ききいれなかった"],["。"],["それ"],["は"],["、"],["神","かみ"],["から"],["出た","でた"],["こと"],["で"],["、"],["彼","かれ"],["ら"],["が"],["エドム"],["の"],["神々","かみがみ"],["を"],["求めた","もとめた"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡す","わたす"],["ため"],["で"],["あった"],["。"]]},{"verse":21,"text":"そこで、イスラエルの王ヨアシュは攻め上った。それで彼とユダの王アマツヤは、ユダのベテ・シェメシュで対戦したが、","tok":[["そこ"],["で"],["、"],["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["は"],["攻め上った","せめのぼった"],["。"],["それ"],["で"],["彼","かれ"],["と"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["は"],["、"],["ユダ"],["の"],["ベテ"],["・"],["シェメシュ"],["で"],["対戦","たいせん"],["した"],["が"],["、"]]},{"verse":22,"text":"ユダはイスラエルに打ち負かされ、おのおの自分の天幕に逃げ帰った。","tok":[["ユダ"],["は"],["イスラエル"],["に"],["打ち負かされ","うちまかされ"],["、"],["おのおの"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["逃げ帰った","にげかえった"],["。"]]},{"verse":23,"text":"イスラエルの王ヨアシュは、エホアハズの子ヨアシュの子、ユダの王アマツヤを、ベテ・シェメシュで捕らえ、エルサレムに連れて来たうえ、エルサレムの城壁をエフライムの門から隅の門まで、四百キュビトにわたって打ちこわした。","tok":[["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["は"],["、"],["エホアハズ"],["の"],["子","こ"],["ヨアシュ"],["の"],["子","こ"],["、"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["を"],["、"],["ベテ"],["・"],["シェメシュ"],["で"],["捕らえ","とらえ"],["、"],["エルサレム"],["に"],["連れて","つれて"],["来た","きた"],["うえ"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["エフライム"],["の"],["門","もん"],["から"],["隅","すみ"],["の"],["門","もん"],["まで"],["、"],["四百","よんひゃく"],["キュビト"],["に"],["わたって"],["打ちこわした","うちこわした"],["。"]]},{"verse":24,"text":"またオベデ・エドムの管理していた神の宮にあったすべての金と銀、およびすべての器具、それに王宮の財宝と人質を取って、サマリヤに帰った。","tok":[["また"],["オベデ"],["・"],["エドム"],["の"],["管理","かんり"],["して"],["いた"],["神","かみ"],["の"],["宮","みや"],["に"],["あった"],["すべて"],["の"],["金","かね"],["と"],["銀","ぎん"],["、"],["および"],["すべて"],["の"],["器具","きぐ"],["、"],["それ"],["に"],["王宮","おうきゅう"],["の"],["財宝","ざいほう"],["と"],["人質","ひとじち"],["を"],["取って","とって"],["、"],["サマリヤ"],["に"],["帰った","かえった"],["。"]]},{"verse":25,"text":"ユダの王ヨアシュの子アマツヤは、イスラエルの王エホアハズの子ヨアシュの死んで後、なお十五年生きながらえた。","tok":[["ユダ"],["の"],["王","おう"],["ヨアシュ"],["の"],["子","こ"],["アマツヤ"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["エホアハズ"],["の"],["子","こ"],["ヨアシュ"],["の"],["死んで","しんで"],["後","あと"],["、"],["なお"],["十五","じゅうご"],["年","ねん"],["生きながらえた","いきながらえた"],["。"]]},{"verse":26,"text":"アマツヤのその他の業績は、最初から最後まで、ユダとイスラエルの王たちの書にまさしくしるされているではないか。","tok":[["アマツヤ"],["の"],["その"],["他","た"],["の"],["業績","ぎょうせき"],["は"],["、"],["最初","さいしょ"],["から"],["最後","さいご"],["まで"],["、"],["ユダ"],["と"],["イスラエル"],["の"],["王","おう"],["たち"],["の"],["書","しょ"],["に"],["まさしく"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":27,"text":"アマツヤが主から離れた時、エルサレムで人々が彼に対して謀反を企てたので、彼はラキシュに逃げた。しかし、彼らはラキシュまで追いかけて、そこで彼を殺した。","tok":[["アマツヤ"],["が"],["主","ぬし"],["から"],["離れた","はなれた"],["時","とき"],["、"],["エルサレム"],["で"],["人々","ひとびと"],["が"],["彼","かれ"],["に対して","にたいして"],["謀反","むほん"],["を"],["企てた","くわだてた"],["ので"],["、"],["彼","かれ"],["は"],["ラキシュ"],["に"],["逃げた","にげた"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["ラキシュ"],["まで"],["追いかけて","おいかけて"],["、"],["そこ"],["で"],["彼","かれ"],["を"],["殺した","ころした"],["。"]]},{"verse":28,"text":"彼らは、彼を馬にのせて行って、ユダの町に先祖たちといっしょに葬った。","tok":[["彼","かれ"],["ら"],["は"],["、"],["彼","かれ"],["を"],["馬","うま"],["に"],["のせて"],["行って","いって"],["、"],["ユダ"],["の"],["町","まち"],["に"],["先祖","せんぞ"],["たち"],["と"],["いっしょ"],["に"],["葬った","ほうむった"],["。"]]}]
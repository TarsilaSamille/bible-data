[{"verse":1,"text":"これらすべてのことが終わると、そこにいた全イスラエルは、ユダの町々に出て行き、石の柱を打ちこわし、アシェラ像を切り落とし、全ユダとベニヤミンの中から、エフライムとマナセの中から、高き所と祭壇を取りこわして、絶ち滅ぼした。そして、イスラエル人はみな、おのおのその所有地、それぞれの町へ帰って行った。","tok":[["これ"],["ら"],["すべて"],["の"],["こと"],["が"],["終わる","おわる"],["と"],["、"],["そこ"],["に"],["いた"],["全","ぜん"],["イスラエル"],["は"],["、"],["ユダ"],["の"],["町々","まちまち"],["に"],["出て","でて"],["行き","いき"],["、"],["石","いし"],["の"],["柱","はしら"],["を"],["打ちこわし","うちこわし"],["、"],["アシェラ"],["像","ぞう"],["を"],["切り落とし","きりおとし"],["、"],["全","ぜん"],["ユダ"],["と"],["ベニヤミン"],["の"],["中","なか"],["から"],["、"],["エフライム"],["と"],["マナセ"],["の"],["中","なか"],["から"],["、"],["高き","たかき"],["所","ところ"],["と"],["祭壇","さいだん"],["を"],["取りこわして","とりこわして"],["、"],["絶ち","たち"],["滅ぼした","ほろぼした"],["。"],["そして"],["、"],["イスラエル"],["人","にん"],["は"],["みな"],["、"],["おのおの"],["その"],["所有地","しょゆうち"],["、"],["それぞれ"],["の"],["町","まち"],["へ"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":2,"text":"ヒゼキヤは、祭司とレビ人の組を定め、祭司とレビ人に、それぞれその奉仕に応じて、おのおのの組ごとに、全焼のいけにえと和解のいけにえをささげさせ、さらに、主の宿営の門で仕え、感謝し、ほめたたえさせた。","tok":[["ヒゼキヤ"],["は"],["、"],["祭司","さいし"],["と"],["レビ人","れびにん"],["の"],["組","くみ"],["を"],["定め","さだめ"],["、"],["祭司","さいし"],["と"],["レビ人","れびにん"],["に"],["、"],["それぞれ"],["その"],["奉仕","ほうし"],["に"],["応じて","おうじて"],["、"],["おのおの"],["の"],["組","くみ"],["ごと"],["に"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["和解","わかい"],["の"],["いけにえ"],["を"],["ささげさせ"],["、"],["さらに"],["、"],["主","ぬし"],["の"],["宿営","しゅくえい"],["の"],["門","もん"],["で"],["仕え","つかえ"],["、"],["感謝","かんしゃ"],["し"],["、"],["ほめたたえさせた"],["。"]]},{"verse":3,"text":"また、主の律法にしるされているとおりに、朝夕の全焼のいけにえ、安息日、新月の祭り、例祭ごとにささげる全焼のいけにえのため、王の分は王の財産から出した。","tok":[["また"],["、"],["主","ぬし"],["の"],["律法","りっぽう"],["に"],["しるされて"],["いる"],["とおり"],["に"],["、"],["朝夕","あさゆう"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["、"],["安息日","あんそくび"],["、"],["新月","しんげつ"],["の"],["祭り","まつり"],["、"],["例祭","れいさい"],["ごと"],["に"],["ささげる"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["ため"],["、"],["王","おう"],["の"],["分","ぶん"],["は"],["王","おう"],["の"],["財産","ざいさん"],["から"],["出した","だした"],["。"]]},{"verse":4,"text":"さらに彼は、エルサレムに住む民に、祭司とレビ人の分を与えるように命じた。祭司とレビ人が主の律法に専念するためであった。","tok":[["さらに"],["彼","かれ"],["は"],["、"],["エルサレム"],["に"],["住む","すむ"],["民","たみ"],["に"],["、"],["祭司","さいし"],["と"],["レビ人","れびにん"],["の"],["分","ぶん"],["を"],["与える","あたえる"],["よう"],["に"],["命じた","めいじた"],["。"],["祭司","さいし"],["と"],["レビ人","れびにん"],["が"],["主","ぬし"],["の"],["律法","りっぽう"],["に"],["専念","せんねん"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":5,"text":"この命令が広まるとともに、イスラエルの人たちは、穀物、新しいぶどう酒、油、蜜など、すべての野の収穫の初物をたくさん持って来た。彼らはすべてのものの十分の一を豊富に携えて来た。","tok":[["この"],["命令","めいれい"],["が"],["広まる","ひろまる"],["と"],["とも"],["に"],["、"],["イスラエル"],["の"],["人","ひと"],["たち"],["は"],["、"],["穀物","こくもつ"],["、"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["、"],["油","あぶら"],["、"],["蜜","みつ"],["など"],["、"],["すべて"],["の"],["野","の"],["の"],["収穫","しゅうかく"],["の"],["初物","はつもの"],["を"],["たくさん"],["持って","もって"],["来た","きた"],["。"],["彼","かれ"],["ら"],["は"],["すべて"],["の"],["もの"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["豊富","ほうふ"],["に"],["携えて","たずさえて"],["来た","きた"],["。"]]},{"verse":6,"text":"ユダの町々に住むイスラエルと、ユダの人たちもまた、牛や羊の十分の一と、彼らの神、主に聖別した聖なるささげ物の十分の一を携えて来て、あちらこちらに山と積んだ。","tok":[["ユダ"],["の"],["町々","まちまち"],["に"],["住む","すむ"],["イスラエル"],["と"],["、"],["ユダ"],["の"],["人","ひと"],["たち"],["も"],["また"],["、"],["牛","うし"],["や"],["羊","ひつじ"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["と"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主に","おもに"],["聖別","せいべつ"],["した"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["携えて","たずさえて"],["来て","きて"],["、"],["あちらこちら"],["に"],["山","やま"],["と"],["積んだ","つんだ"],["。"]]},{"verse":7,"text":"第三の月に、彼らは積み始め、第七の月に終わった。","tok":[["第","だい"],["三","さん"],["の"],["月","つき"],["に"],["、"],["彼","かれ"],["ら"],["は"],["積み","つみ"],["始め","はじめ"],["、"],["第","だい"],["七","なな"],["の"],["月","つき"],["に"],["終わった","おわった"],["。"]]},{"verse":8,"text":"ヒゼキヤとつかさたちは、入って来て、積んだ山を見、主とその民イスラエルをほめたたえ、祝福した。","tok":[["ヒゼキヤ"],["と"],["つかさ"],["たち"],["は"],["、"],["入って","はいって"],["来て","きて"],["、"],["積んだ","つんだ"],["山","やま"],["を"],["見","み"],["、"],["主","ぬし"],["と"],["その"],["民","みん"],["イスラエル"],["を"],["ほめたたえ"],["、"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":9,"text":"それから、ヒゼキヤは、その積んだ山について、祭司とレビ人に説明を求めた。","tok":[["それ"],["から"],["、"],["ヒゼキヤ"],["は"],["、"],["その"],["積んだ","つんだ"],["山","やま"],["について"],["、"],["祭司","さいし"],["と"],["レビ人","れびにん"],["に"],["説明","せつめい"],["を"],["求めた","もとめた"],["。"]]},{"verse":10,"text":"すると、ツァドクの家のかしら、祭司アザルヤが彼に答えて言った。「人々が奉納物を主の宮に携えて来始めてから、食べて、満ち足り、たくさん残りました。主が御民を祝福されたからです。その残りがこんなにたくさんあるのです。」","tok":[["する"],["と"],["、"],["ツァドク"],["の"],["家","いえ"],["の"],["かしら"],["、"],["祭司","さいし"],["アザルヤ"],["が"],["彼","かれ"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["人々","ひとびと"],["が"],["奉納物","ほうのうぶつ"],["を"],["主","ぬし"],["の"],["宮","みや"],["に"],["携えて","たずさえて"],["来","き"],["始めて","はじめて"],["から"],["、"],["食べて","たべて"],["、"],["満ち足り","みちたり"],["、"],["たくさん"],["残りました","のこりました"],["。"],["主","ぬし"],["が"],["御民","ごみん"],["を"],["祝福","しゅくふく"],["された"],["から"],["です"],["。"],["その"],["残り","のこり"],["が"],["こんな"],["に"],["たくさん"],["ある"],["の"],["です"],["。"],["」"]]},{"verse":11,"text":"そこで、ヒゼキヤが主の宮の脇部屋を整えるよう命じたので、彼らは整えて、","tok":[["そこ"],["で"],["、"],["ヒゼキヤ"],["が"],["主","ぬし"],["の"],["宮","みや"],["の"],["脇部屋","わきべや"],["を"],["整える","ととのえる"],["よう"],["命じた","めいじた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["整えて","ととのえて"],["、"]]},{"verse":12,"text":"その奉納物と十分の一と聖なるささげ物を忠実に携え入れた。彼らを指図したつかさは、レビ人カナヌヤであり、その兄弟シムイは、副指揮者であった。","tok":[["その"],["奉納物","ほうのうぶつ"],["と"],["十分","じゅうぶん"],["の"],["一","いち"],["と"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["を"],["忠実","ちゅうじつ"],["に"],["携え","たずさえ"],["入れた","いれた"],["。"],["彼","かれ"],["ら"],["を"],["指図","さしず"],["した"],["つかさ"],["は"],["、"],["レビ人","れびにん"],["カナヌヤ"],["で"],["あり"],["、"],["その"],["兄弟","きょうだい"],["シムイ"],["は"],["、"],["副","ふく"],["指揮者","しきしゃ"],["で"],["あった"],["。"]]},{"verse":13,"text":"エヒエル、アザズヤ、ナハテ、アサエル、エリモテ、エホザバデ、エリエル、イスマクヤ、マハテ、ベナヤは、ヒゼキヤ王と神の宮のつかさアザルヤの任命によって、カナヌヤとその兄弟シムイを助けて、管理者となった。","tok":[["エヒエル"],["、"],["アザズヤ"],["、"],["ナハテ"],["、"],["アサエル"],["、"],["エリモテ"],["、"],["エホザバデ"],["、"],["エリエル"],["、"],["イスマクヤ"],["、"],["マハテ"],["、"],["ベナヤ"],["は"],["、"],["ヒゼキヤ"],["王","おう"],["と"],["神","かみ"],["の"],["宮","みや"],["の"],["つかさ"],["アザルヤ"],["の"],["任命","にんめい"],["によって"],["、"],["カナヌヤ"],["と"],["その"],["兄弟","きょうだい"],["シムイ"],["を"],["助けて","たすけて"],["、"],["管理者","かんりしゃ"],["と"],["なった"],["。"]]},{"verse":14,"text":"また、レビ人イムナの子コレは東の門の門衛であったが、神に進んでささげるささげ物をつかさどり、主の奉納物と最も聖なるささげ物を分配した。","tok":[["また"],["、"],["レビ人","れびにん"],["イムナ"],["の"],["子","こ"],["コレ"],["は"],["東","ひがし"],["の"],["門","もん"],["の"],["門衛","もんえい"],["で"],["あった"],["が"],["、"],["神","かみ"],["に"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["を"],["つかさどり"],["、"],["主","ぬし"],["の"],["奉納物","ほうのうぶつ"],["と"],["最も","もっとも"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["を"],["分配","ぶんぱい"],["した"],["。"]]},{"verse":15,"text":"彼の下には、エデン、ミヌヤミン、ヨシュア、シェマヤ、アマルヤ、シェカヌヤがいて、忠実に祭司の町々にとどまり、彼らの兄弟たちに、各組にしたがい、上の者にも下の者にも分配した。","tok":[["彼","かれ"],["の"],["下","した"],["に"],["は"],["、"],["エデン"],["、"],["ミヌヤミン"],["、"],["ヨシュア"],["、"],["シェマヤ"],["、"],["アマルヤ"],["、"],["シェカヌヤ"],["が"],["いて"],["、"],["忠実","ちゅうじつ"],["に"],["祭司","さいし"],["の"],["町々","まちまち"],["に"],["とどまり"],["、"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["たち"],["に"],["、"],["各","かく"],["組","くみ"],["に"],["したがい"],["、"],["上","うえ"],["の"],["者","もの"],["に"],["も"],["下","した"],["の"],["者","もの"],["に"],["も"],["分配","ぶんぱい"],["した"],["。"]]},{"verse":16,"text":"ただし、三歳以上の男子で、すべて毎日の日課として、組ごとに任務につき奉仕に当たるために、主の宮に入る者として系図に載せられた人々は、別であった。","tok":[["ただし"],["、"],["三歳","さんさい"],["以上","いじょう"],["の"],["男子","だんし"],["で"],["、"],["すべて"],["毎日","まいにち"],["の"],["日課","にっか"],["として"],["、"],["組","くみ"],["ごと"],["に"],["任務","にんむ"],["に"],["つき"],["奉仕","ほうし"],["に"],["当たる","あたる"],["ため"],["に"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["入る","はいる"],["者","もの"],["として"],["系図","けいず"],["に"],["載せられた","のせられた"],["人々","ひとびと"],["は"],["、"],["別","べつ"],["で"],["あった"],["。"]]},{"verse":17,"text":"父祖の家ごとに祭司として系図に載せられた者、および、二十歳以上のレビ人で系図に載せられた者で、組別にその任務につく人々も別であった。","tok":[["父祖","ふそ"],["の"],["家","いえ"],["ごと"],["に"],["祭司","さいし"],["として"],["系図","けいず"],["に"],["載せられた","のせられた"],["者","もの"],["、"],["および"],["、"],["二十歳","はたち"],["以上","いじょう"],["の"],["レビ人","れびにん"],["で"],["系図","けいず"],["に"],["載せられた","のせられた"],["者","もの"],["で"],["、"],["組","くみ"],["別","べつ"],["に"],["その"],["任務","にんむ"],["に"],["つく"],["人々","ひとびと"],["も"],["別","べつ"],["で"],["あった"],["。"]]},{"verse":18,"text":"また、全集団のうち、すべて系図に載せられた幼児、妻たち、息子たち、娘たちに分配した。彼らは、聖なるささげ物を、忠実に、聖なる物として扱ったからである。","tok":[["また"],["、"],["全","ぜん"],["集団","しゅうだん"],["の"],["うち"],["、"],["すべて"],["系図","けいず"],["に"],["載せられた","のせられた"],["幼児","ようじ"],["、"],["妻たち","つまたち"],["、"],["息子","むすこ"],["たち"],["、"],["娘","むすめ"],["たち"],["に"],["分配","ぶんぱい"],["した"],["。"],["彼","かれ"],["ら"],["は"],["、"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["を"],["、"],["忠実","ちゅうじつ"],["に"],["、"],["聖","せい"],["なる"],["物","もの"],["として"],["扱った","あつかった"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"おのおのの町の放牧地の野にいたアロンの子らである祭司たちのためには、どの町にも、その名の示された者たちがいて、祭司たちのすべての男子、および、レビ人ですべて系図に載せられている者に、その受ける分を与えた。","tok":[["おのおの"],["の"],["町","まち"],["の"],["放牧","ほうぼく"],["地","ち"],["の"],["野","の"],["に"],["いた"],["アロン"],["の"],["子","こ"],["ら"],["で"],["ある"],["祭司","さいし"],["たち"],["の"],["ため"],["に"],["は"],["、"],["どの"],["町","まち"],["に"],["も"],["、"],["その"],["名","な"],["の"],["示された","しめされた"],["者","もの"],["たち"],["が"],["いて"],["、"],["祭司","さいし"],["たち"],["の"],["すべて"],["の"],["男子","だんし"],["、"],["および"],["、"],["レビ人","れびにん"],["で"],["すべて"],["系図","けいず"],["に"],["載せられて","のせられて"],["いる"],["者","もの"],["に"],["、"],["その"],["受ける","うける"],["分","ぶん"],["を"],["与えた","あたえた"],["。"]]},{"verse":20,"text":"ヒゼキヤはユダ全国にこのように行い、その神、主の目の前に、良いこと、正しいこと、誠実なことを行った。","tok":[["ヒゼキヤ"],["は"],["ユダ"],["全国","ぜんこく"],["に"],["この"],["よう"],["に"],["行い","おこない"],["、"],["その"],["神","かみ"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["、"],["良い","よい"],["こと"],["、"],["正しい","ただしい"],["こと"],["、"],["誠実","せいじつ"],["な"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":21,"text":"彼は、彼が始めたすべてのわざにおいて、すなわち、神の宮の奉仕、律法、命令において神に求め、心を尽くして行い、その目的を果たした。","tok":[["彼","かれ"],["は"],["、"],["彼","かれ"],["が"],["始めた","はじめた"],["すべて"],["の"],["わざ"],["に"],["おいて"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["宮","みや"],["の"],["奉仕","ほうし"],["、"],["律法","りっぽう"],["、"],["命令","めいれい"],["に"],["おいて"],["神","かみ"],["に"],["求め","もとめ"],["、"],["心","こころ"],["を"],["尽くして","つくして"],["行い","おこない"],["、"],["その"],["目的","もくてき"],["を"],["果たした","はたした"],["。"]]}]
[{"verse":1,"text":"これらの誠実なことが示されて後、アッシリヤの王セナケリブが来て、ユダに入り、城壁のある町々に対して陣を敷いた。そこに攻め入ろうと思ったのである。","tok":[["これ"],["ら"],["の"],["誠実","せいじつ"],["な"],["こと"],["が"],["示されて","しめされて"],["後","あと"],["、"],["アッシリヤ"],["の"],["王","おう"],["セナケリブ"],["が"],["来て","きて"],["、"],["ユダ"],["に"],["入り","はいり"],["、"],["城壁","じょうへき"],["の"],["ある"],["町々","まちまち"],["に対して","にたいして"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["そこ"],["に"],["攻め入ろう","せめいろう"],["と"],["思った","おもった"],["ので"],["ある"],["。"]]},{"verse":2,"text":"ヒゼキヤは、セナケリブが攻め入って、エルサレムに向かって戦おうとしているのを見たので、","tok":[["ヒゼキヤ"],["は"],["、"],["セナケリブ"],["が"],["攻め入って","せめいって"],["、"],["エルサレム"],["に"],["向かって","むかって"],["戦おう","たたかおう"],["として"],["いる"],["の"],["を"],["見た","みた"],["ので"],["、"]]},{"verse":3,"text":"彼のつかさたち、勇士たちと相談し、この町の外にある泉の水をふさごうとした。彼らは王を支持した。","tok":[["彼","かれ"],["の"],["つかさ"],["たち"],["、"],["勇士","ゆうし"],["たち"],["と"],["相談","そうだん"],["し"],["、"],["この"],["町","まち"],["の"],["外","そと"],["に"],["ある"],["泉","いずみ"],["の"],["水","みず"],["を"],["ふさごう"],["と"],["した"],["。"],["彼","かれ"],["ら"],["は"],["王","おう"],["を"],["支持","しじ"],["した"],["。"]]},{"verse":4,"text":"そこで、多くの民が集まり、すべての泉と、この地を流れている川をふさいで言った。「アッシリヤの王たちに、攻め入らせ、豊富な水を見つけさせてたまるものか。」","tok":[["そこ"],["で"],["、"],["多く","おおく"],["の"],["民","たみ"],["が"],["集まり","あつまり"],["、"],["すべて"],["の"],["泉","いずみ"],["と"],["、"],["この"],["地","ち"],["を"],["流れて","ながれて"],["いる"],["川","かわ"],["を"],["ふさいで"],["言った","いった"],["。"],["「"],["アッシリヤ"],["の"],["王","おう"],["たち"],["に"],["、"],["攻め入らせ","せめいらせ"],["、"],["豊富","ほうふ"],["な"],["水","みず"],["を"],["見つけさせて","みつけさせて"],["たまる"],["もの"],["か"],["。"],["」"]]},{"verse":5,"text":"それから、彼は奮い立って、くずれていた城壁を全部建て直し、さらに、やぐらを上に上げ、外側にもう一つの城壁を築き、ダビデの町ミロを強固にした。そのうえ、彼は大量の投げ槍と盾を作った。","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["奮い立って","ふるいたって"],["、"],["くずれて"],["いた"],["城壁","じょうへき"],["を"],["全部","ぜんぶ"],["建て直し","たてなおし"],["、"],["さらに"],["、"],["やぐら"],["を"],["上","うえ"],["に"],["上げ","あげ"],["、"],["外側","そとがわ"],["に"],["もう"],["一","ひと"],["つ"],["の"],["城壁","じょうへき"],["を"],["築き","きずき"],["、"],["ダビデ"],["の"],["町","まち"],["ミロ"],["を"],["強固","きょうこ"],["に"],["した"],["。"],["その"],["うえ"],["、"],["彼","かれ"],["は"],["大量","たいりょう"],["の"],["投げ槍","なげやり"],["と"],["盾","たて"],["を"],["作った","つくった"],["。"]]},{"verse":6,"text":"彼は、民の上に戦時の隊長たちを立て、彼らを町の門の広場に召集し、彼らに励ましのことばを与えて言った。","tok":[["彼","かれ"],["は"],["、"],["民","みん"],["の"],["上","うえ"],["に"],["戦時","せんじ"],["の"],["隊長","たいちょう"],["たち"],["を"],["立て","たて"],["、"],["彼","かれ"],["ら"],["を"],["町","まち"],["の"],["門","もん"],["の"],["広場","ひろば"],["に"],["召集","しょうしゅう"],["し"],["、"],["彼","かれ"],["ら"],["に"],["励まし","はげまし"],["の"],["ことば"],["を"],["与えて","あたえて"],["言った","いった"],["。"]]},{"verse":7,"text":"「強くあれ。雄々しくあれ。アッシリヤの王に、彼とともにいるすべての大軍に、恐れをなしてはならない。おびえてはならない。彼とともにいる者よりも大いなる方が私たちとともにおられるからである。","tok":[["「"],["強く","つよく"],["あれ"],["。"],["雄々しく","おおしく"],["あれ"],["。"],["アッシリヤ"],["の"],["王","おう"],["に"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["すべて"],["の"],["大軍","たいぐん"],["に"],["、"],["恐れ","おそれ"],["を"],["なして"],["は"],["ならない"],["。"],["おびえて"],["は"],["ならない"],["。"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["者","もの"],["より"],["も"],["大いなる","おおいなる"],["方","ほう"],["が"],["私たち","わたしたち"],["と"],["とも"],["に"],["おられる"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"彼とともにいる者は肉の腕であり、私たちとともにおられる方は、私たちの神、主、私たちを助け、私たちの戦いを戦ってくださる方である。」民はユダの王ヒゼキヤのことばによって奮い立った。","tok":[["彼","かれ"],["と"],["とも"],["に"],["いる"],["者","もの"],["は"],["肉","にく"],["の"],["腕","うで"],["で"],["あり"],["、"],["私たち","わたしたち"],["と"],["とも"],["に"],["おられる"],["方","かた"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["、"],["私たち","わたしたち"],["を"],["助け","たすけ"],["、"],["私たち","わたしたち"],["の"],["戦い","たたかい"],["を"],["戦って","たたかって"],["くださる"],["方","かた"],["で"],["ある"],["。"],["」"],["民","みん"],["は"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["の"],["ことば"],["によって"],["奮い立った","ふるいたった"],["。"]]},{"verse":9,"text":"この後、アッシリヤの王セナケリブは、その家来たちをエルサレムに遣わして、――彼自身はその全軍を率いてラキシュを攻めていた――ユダの王ヒゼキヤとエルサレムにいたすべてのユダの人々に向かって言わせた。","tok":[["この"],["後","ご"],["、"],["アッシリヤ"],["の"],["王","おう"],["セナケリブ"],["は"],["、"],["その"],["家来","けらい"],["たち"],["を"],["エルサレム"],["に"],["遣わして","つかわして"],["、"],["―"],["―"],["彼","かれ"],["自身","じしん"],["は"],["その"],["全軍","ぜんぐん"],["を"],["率いて","ひきいて"],["ラキシュ"],["を"],["攻めて","せめて"],["いた"],["―"],["―"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["と"],["エルサレム"],["に"],["いた"],["すべて"],["の"],["ユダ"],["の"],["人々","ひとびと"],["に"],["向かって","むかって"],["言わせた","いわせた"],["。"]]},{"verse":10,"text":"「アッシリヤの王セナケリブはこう言っておられる。おまえたちは何に拠り頼んで、エルサレムの包囲の中でじっとしているのか。","tok":[["「"],["アッシリヤ"],["の"],["王","おう"],["セナケリブ"],["は"],["こう"],["言って","いって"],["おられる"],["。"],["おまえ"],["たち"],["は"],["何","なん"],["に"],["拠り","より"],["頼んで","たのんで"],["、"],["エルサレム"],["の"],["包囲","ほうい"],["の"],["中","なか"],["で"],["じっと"],["して"],["いる"],["の"],["か"],["。"]]},{"verse":11,"text":"ヒゼキヤは、『私たちの神、主は、アッシリヤの王の手から私たちを救い出される』と言って、おまえたちをそそのかし、飢えと渇きで、おまえたちを死なせようとしているではないか。","tok":[["ヒゼキヤ"],["は"],["、"],["『"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["アッシリヤ"],["の"],["王","おう"],["の"],["手","て"],["から"],["私たち","わたしたち"],["を"],["救い出される","すくいだされる"],["』"],["と"],["言って","いって"],["、"],["おまえ"],["たち"],["を"],["そそのかし"],["、"],["飢え","うえ"],["と"],["渇き","かわき"],["で"],["、"],["おまえ"],["たち"],["を"],["死なせよう","しなせよう"],["として"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":12,"text":"あの主ではないのか。その高き所と祭壇をヒゼキヤは取り除いておいて、ユダとエルサレムに向かい、『あなたがたは、ただ一つの祭壇の前で拝み、その上で香をたかなければならない』と言ったのだ。","tok":[["あの"],["主","ぬし"],["で"],["は"],["ない"],["の"],["か"],["。"],["その"],["高き","たかき"],["所","ところ"],["と"],["祭壇","さいだん"],["を"],["ヒゼキヤ"],["は"],["取り除いて","とりのぞいて"],["おいて"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["向かい","むかい"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["ただ"],["一","ひと"],["つ"],["の"],["祭壇","さいだん"],["の"],["前","まえ"],["で"],["拝み","おがみ"],["、"],["その"],["上","うえ"],["で"],["香","こう"],["を"],["たかなければ"],["ならない"],["』"],["と"],["言った","いった"],["の"],["だ"],["。"]]},{"verse":13,"text":"おまえたちは、私と私の先祖たちが地のすべての国々の民に対して、何をしてきたかを知らないのか。地の国々の神々が彼らの国を私の手から救い出すことができたか。","tok":[["おまえ"],["たち"],["は"],["、"],["私","わたくし"],["と"],["私","わたくし"],["の"],["先祖","せんぞ"],["たち"],["が"],["地","ち"],["の"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["に対して","にたいして"],["、"],["何","なん"],["を"],["して"],["きた"],["か"],["を"],["知らない","しらない"],["の"],["か"],["。"],["地","ち"],["の"],["国々","くにぐに"],["の"],["神々","かみがみ"],["が"],["彼","かれ"],["ら"],["の"],["国","くに"],["を"],["私","わたくし"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["こと"],["が"],["できた"],["か"],["。"]]},{"verse":14,"text":"私の先祖たちが聖絶したこれらの国々の神々のうち、どの神が私の手からその民を救い出すことができたか。おまえたちの神が私の手からおまえたちを救い出すことができるというのか。","tok":[["私","わたくし"],["の"],["先祖","せんぞ"],["たち"],["が"],["聖","せい"],["絶した","ぜっした"],["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["神々","かみがみ"],["の"],["うち"],["、"],["どの"],["神","かみ"],["が"],["私","わたくし"],["の"],["手","て"],["から"],["その"],["民","たみ"],["を"],["救い出す","すくいだす"],["こと"],["が"],["できた"],["か"],["。"],["おまえ"],["たち"],["の"],["神","かみ"],["が"],["私","わたくし"],["の"],["手","て"],["から"],["おまえ"],["たち"],["を"],["救い出す","すくいだす"],["こと"],["が"],["できる"],["と"],["いう"],["の"],["か"],["。"]]},{"verse":15,"text":"今、おまえたちは、ヒゼキヤにごまかされるな。このようにそそのかされてはならない。彼を信じてはならない。どのような国、どのような王国のどのような神も、その民を私の手から、私の先祖たちの手から救い出すことはできない。まして、おまえたちの神は、おまえたちを私の手から救い出すことはできない。」","tok":[["今","いま"],["、"],["おまえ"],["たち"],["は"],["、"],["ヒゼキヤ"],["に"],["ごまかされる"],["な"],["。"],["この"],["よう"],["に"],["そそのかされて"],["は"],["ならない"],["。"],["彼","かれ"],["を"],["信じて","しんじて"],["は"],["ならない"],["。"],["どのような"],["国","くに"],["、"],["どのような"],["王国","おうこく"],["の"],["どのような"],["神","かみ"],["も"],["、"],["その"],["民","たみ"],["を"],["私","わたくし"],["の"],["手","て"],["から"],["、"],["私","わたくし"],["の"],["先祖","せんぞ"],["たち"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["こと"],["は"],["できない"],["。"],["まして"],["、"],["おまえ"],["たち"],["の"],["神","かみ"],["は"],["、"],["おまえ"],["たち"],["を"],["私","わたくし"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":16,"text":"彼の家来たちは、なおも、神である主とそのしもべヒゼキヤに逆らって弁舌をふるった。","tok":[["彼","かれ"],["の"],["家来","けらい"],["たち"],["は"],["、"],["なお"],["も"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["と"],["その"],["しもべ"],["ヒゼキヤ"],["に"],["逆らって","さからって"],["弁舌","べんぜつ"],["を"],["ふるった"],["。"]]},{"verse":17,"text":"彼は手紙を書いて、イスラエルの神、主をそしり、主に逆らって言った。「私の手から自分たちの民を救い出さなかった地の国々の神々と同じように、ヒゼキヤの神も、その民を私の手から救い出せない。」","tok":[["彼","かれ"],["は"],["手紙","てがみ"],["を"],["書いて","かいて"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["そしり"],["、"],["主に","おもに"],["逆らって","さからって"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["手","て"],["から"],["自分","じぶん"],["たち"],["の"],["民","たみ"],["を"],["救い出さなかった","すくいださなかった"],["地","ち"],["の"],["国々","くにぐに"],["の"],["神々","かみがみ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["ヒゼキヤ"],["の"],["神","かみ"],["も"],["、"],["その"],["民","たみ"],["を"],["私","わたくし"],["の"],["手","て"],["から"],["救い出せない","すくいだせない"],["。"],["」"]]},{"verse":18,"text":"さらに、彼らは城壁の上にいたエルサレムの民に向かい、ユダのことばで大声に呼ばわり、彼らを恐れさせ、おじけさせて、この町を取ろうとした。","tok":[["さらに"],["、"],["彼","かれ"],["ら"],["は"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["いた"],["エルサレム"],["の"],["民","たみ"],["に"],["向かい","むかい"],["、"],["ユダ"],["の"],["ことば"],["で"],["大声","おおごえ"],["に"],["呼ばわり","よばわり"],["、"],["彼","かれ"],["ら"],["を"],["恐れさせ","おそれさせ"],["、"],["おじけさせて"],["、"],["この"],["町","まち"],["を"],["取ろう","とろう"],["と"],["した"],["。"]]},{"verse":19,"text":"このように、彼らは、エルサレムの神について、人の手で造ったこの地の民の神々についてと同じように、語ったのである。","tok":[["この"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["は"],["、"],["エルサレム"],["の"],["神","かみ"],["について"],["、"],["人","ひと"],["の"],["手","て"],["で"],["造った","つくった"],["この"],["地","ち"],["の"],["民","たみ"],["の"],["神々","かみがみ"],["について"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["語った","かたった"],["ので"],["ある"],["。"]]},{"verse":20,"text":"そこで、ヒゼキヤ王とアモツの子預言者イザヤは、このことのゆえに、祈りをささげ、天に叫び求めた。","tok":[["そこ"],["で"],["、"],["ヒゼキヤ"],["王","おう"],["と"],["アモツ"],["の"],["子","こ"],["預言者","よげんしゃ"],["イザヤ"],["は"],["、"],["この"],["こと"],["の"],["ゆえ"],["に"],["、"],["祈り","いのり"],["を"],["ささげ"],["、"],["天","てん"],["に"],["叫び","さけび"],["求めた","もとめた"],["。"]]},{"verse":21,"text":"すると、主はひとりの御使いを遣わし、アッシリヤの王の陣営にいたすべての勇士、隊長、首長を全滅させた。そこで、彼は恥じて国へ帰り、彼の神の宮に入ったが、自分の身から出た子どもたちが、その所で、彼を剣にかけて倒した。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["ひとり"],["の"],["御使い","おつかい"],["を"],["遣わし","つかわし"],["、"],["アッシリヤ"],["の"],["王","おう"],["の"],["陣営","じんえい"],["に"],["いた"],["すべて"],["の"],["勇士","ゆうし"],["、"],["隊長","たいちょう"],["、"],["首長","しゅちょう"],["を"],["全滅","ぜんめつ"],["させた"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["は"],["恥じて","はじて"],["国","くに"],["へ"],["帰り","かえり"],["、"],["彼","かれ"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["入った","はいった"],["が"],["、"],["自分","じぶん"],["の"],["身","み"],["から"],["出た","でた"],["子ども","こども"],["たち"],["が"],["、"],["その"],["所","ところ"],["で"],["、"],["彼","かれ"],["を"],["剣","けん"],["に"],["かけて"],["倒した","たおした"],["。"]]},{"verse":22,"text":"こうして、主は、アッシリヤの王セナケリブの手、および、すべての者の手から、ヒゼキヤとエルサレムの住民とを救い、四方から彼らを守り導かれた。","tok":[["こう"],["して"],["、"],["主","ぬし"],["は"],["、"],["アッシリヤ"],["の"],["王","おう"],["セナケリブ"],["の"],["手","て"],["、"],["および"],["、"],["すべて"],["の"],["者","もの"],["の"],["手","て"],["から"],["、"],["ヒゼキヤ"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["と"],["を"],["救い","すくい"],["、"],["四方","しほう"],["から"],["彼","かれ"],["ら"],["を"],["守り導かれた","まもりみちびかれた"],["。"]]},{"verse":23,"text":"多くの人々が主への贈り物を携え、ユダの王ヒゼキヤに贈るえりすぐりの品々を持って、エルサレムに来るようになり、この時以来、彼はすべての国々から尊敬の目で見られるようになった。","tok":[["多く","おおく"],["の"],["人々","ひとびと"],["が"],["主","ぬし"],["へ"],["の"],["贈り物","おくりもの"],["を"],["携え","たずさえ"],["、"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["に"],["贈る","おくる"],["えりすぐり"],["の"],["品々","しなじな"],["を"],["持って","もって"],["、"],["エルサレム"],["に"],["来る","くる"],["よう"],["に"],["なり"],["、"],["この"],["時","とき"],["以来","いらい"],["、"],["彼","かれ"],["は"],["すべて"],["の"],["国々","くにぐに"],["から"],["尊敬","そんけい"],["の"],["目","め"],["で"],["見られる","みられる"],["よう"],["に"],["なった"],["。"]]},{"verse":24,"text":"そのころ、ヒゼキヤは病気になって死にかかったが、彼が主に祈ったとき、主は彼に答え、しるしを与えられた。","tok":[["その"],["ころ"],["、"],["ヒゼキヤ"],["は"],["病気","びょうき"],["に"],["なって"],["死にかかった","しにかかった"],["が"],["、"],["彼","かれ"],["が"],["主に","おもに"],["祈った","いのった"],["とき"],["、"],["主","ぬし"],["は"],["彼","かれ"],["に"],["答え","こたえ"],["、"],["しるし"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":25,"text":"ところが、ヒゼキヤは、自分に与えられた恵みにしたがって報いようとせず、かえってその心を高ぶらせた。そこで、彼の上に、また、ユダとエルサレムの上に御怒りが下った。","tok":[["ところ"],["が"],["、"],["ヒゼキヤ"],["は"],["、"],["自分","じぶん"],["に"],["与えられた","あたえられた"],["恵み","めぐみ"],["に"],["したがって"],["報いよう","むくいよう"],["と"],["せず"],["、"],["かえって"],["その"],["心","こころ"],["を"],["高ぶらせた","たかぶらせた"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["、"],["また"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["上","うえ"],["に"],["御怒り","おいかり"],["が"],["下った","くだった"],["。"]]},{"verse":26,"text":"しかしヒゼキヤが、その心の高ぶりを捨ててへりくだり、彼およびエルサレムの住民もそうしたので、主の怒
[{"verse":1,"text":"アサの治世の第三十六年に、イスラエルの王バシャはユダに上って来て、ユダの王アサのもとにだれも出入りできないようにするためにラマを築いた。","tok":[["アサ"],["の"],["治世","ちせい"],["の"],["第","だい"],["三十六","さんじゅうろく"],["年","ねん"],["に"],["、"],["イスラエル"],["の"],["王","おう"],["バシャ"],["は"],["ユダ"],["に"],["上って","のぼって"],["来て","きて"],["、"],["ユダ"],["の"],["王","おう"],["アサ"],["の"],["もと"],["に"],["だれ"],["も"],["出入り","でいり"],["できない"],["よう"],["に"],["する"],["ため"],["に"],["ラマ"],["を"],["築いた","きずいた"],["。"]]},{"verse":2,"text":"アサは主の宮と王宮との宝物倉から銀と金を取り出し、ダマスコに住むアラムの王ベン・ハダデのもとに送り届けて言った。","tok":[["アサ"],["は"],["主","ぬし"],["の"],["宮","みや"],["と"],["王宮","おうきゅう"],["と"],["の"],["宝物倉","ほうもつそう"],["から"],["銀","ぎん"],["と"],["金","かね"],["を"],["取り出し","とりだし"],["、"],["ダマスコ"],["に"],["住む","すむ"],["アラム"],["の"],["王","おう"],["ベン"],["・"],["ハダデ"],["の"],["もと"],["に"],["送り届けて","おくりとどけて"],["言った","いった"],["。"]]},{"verse":3,"text":"「私の父とあなたの父上の間にあったように、私とあなたの間に同盟を結びましょう。ご覧ください。私はあなたに銀と金を送りました。どうか、イスラエルの王バシャとの同盟を破棄し、彼が私のもとから離れ去るようにしてください。」","tok":[["「"],["私","わたくし"],["の"],["父","ちち"],["と"],["あなた"],["の"],["父上","ちちじょう"],["の"],["間","あいだ"],["に"],["あった"],["よう"],["に"],["、"],["私","わたくし"],["と"],["あなた"],["の"],["間","あいだ"],["に"],["同盟","どうめい"],["を"],["結びましょう","むすびましょう"],["。"],["ご覧","ごらん"],["ください"],["。"],["私","わたくし"],["は"],["あなた"],["に"],["銀","ぎん"],["と"],["金","かね"],["を"],["送りました","おくりました"],["。"],["どう"],["か"],["、"],["イスラエル"],["の"],["王","おう"],["バシャ"],["と"],["の"],["同盟","どうめい"],["を"],["破棄","はき"],["し"],["、"],["彼","かれ"],["が"],["私","わたくし"],["の"],["もと"],["から"],["離れ去る","はなれさる"],["よう"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":4,"text":"ベン・ハダデはアサ王の願いを聞き入れ、自分の配下の将校たちをイスラエルの町々に差し向けたところ、彼らはイヨンと、ダンと、アベル・マイム、および、ナフタリに属するすべての倉庫の町々を打った。","tok":[["ベン"],["・"],["ハダデ"],["は"],["アサ"],["王","おう"],["の"],["願い","ねがい"],["を"],["聞き入れ","ききいれ"],["、"],["自分","じぶん"],["の"],["配下","はいか"],["の"],["将校","しょうこう"],["たち"],["を"],["イスラエル"],["の"],["町々","まちまち"],["に"],["差し向けた","さしむけた"],["ところ"],["、"],["彼","かれ"],["ら"],["は"],["イヨン"],["と"],["、"],["ダン"],["と"],["、"],["アベル"],["・"],["マイム"],["、"],["および"],["、"],["ナフタリ"],["に"],["属する","ぞくする"],["すべて"],["の"],["倉庫","そうこ"],["の"],["町々","まちまち"],["を"],["打った","うった"],["。"]]},{"verse":5,"text":"バシャはこれを聞くと、ラマを築くのを中止し、その工事をやめさせた。","tok":[["バシャ"],["は"],["これ"],["を"],["聞く","きく"],["と"],["、"],["ラマ"],["を"],["築く","きずく"],["の"],["を"],["中止","ちゅうし"],["し"],["、"],["その"],["工事","こうじ"],["を"],["やめさせた"],["。"]]},{"verse":6,"text":"アサ王はユダの人々をみな連れて行き、バシャが建築に用いたラマの石材と木材を運び出させたうえ、これを用いてゲバとミツパを建てた。","tok":[["アサ"],["王","おう"],["は"],["ユダ"],["の"],["人々","ひとびと"],["を"],["みな"],["連れて","つれて"],["行き","いき"],["、"],["バシャ"],["が"],["建築","けんちく"],["に"],["用いた","もちいた"],["ラマ"],["の"],["石材","せきざい"],["と"],["木材","もくざい"],["を"],["運び出させた","はこびださせた"],["うえ"],["、"],["これ"],["を"],["用いて","もちいて"],["ゲバ"],["と"],["ミツパ"],["を"],["建てた","たてた"],["。"]]},{"verse":7,"text":"そのとき、予見者ハナニがユダの王アサのもとに来て、彼に言った。「あなたはアラムの王に拠り頼み、あなたの神、主に拠り頼みませんでした。それゆえ、アラム王の軍勢はあなたの手からのがれ出たのです。","tok":[["その"],["とき"],["、"],["予見者","よけんしゃ"],["ハナニ"],["が"],["ユダ"],["の"],["王","おう"],["アサ"],["の"],["もと"],["に"],["来て","きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["アラム"],["の"],["王","おう"],["に"],["拠り","より"],["頼み","たのみ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["拠り","より"],["頼みませんでした","たのみませんでした"],["。"],["それ"],["ゆえ"],["、"],["アラム"],["王","おう"],["の"],["軍勢","ぐんぜい"],["は"],["あなた"],["の"],["手","て"],["から"],["のがれ出た","のがれでた"],["の"],["です"],["。"]]},{"verse":8,"text":"あのクシュ人とルブ人は大軍勢ではなかったでしょうか。戦車と騎兵は非常におびただしかったではありませんか。しかし、あなたが主に拠り頼んだとき、主は彼らをあなたの手に渡されたのです。","tok":[["あの"],["クシュ人","くしゅにん"],["と"],["ルブ人","るぶにん"],["は"],["大","だい"],["軍勢","ぐんぜい"],["で"],["は"],["なかったでしょう"],["か"],["。"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["は"],["非常","ひじょう"],["に"],["おびただしかったで"],["は"],["ありません"],["か"],["。"],["しかし"],["、"],["あなた"],["が"],["主","ぬし"],["に"],["拠り","より"],["頼んだ","たのんだ"],["とき"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["手","て"],["に"],["渡された","わたされた"],["の"],["です"],["。"]]},{"verse":9,"text":"主はその御目をもって、あまねく全地を見渡し、その心がご自分と全く一つになっている人々に御力をあらわしてくださるのです。あなたは、このことについて愚かなことをしました。今から、あなたは数々の戦いに巻き込まれます。」","tok":[["主","ぬし"],["は"],["その"],["御目","おめ"],["を"],["もって"],["、"],["あまねく"],["全地","ぜんち"],["を"],["見渡し","みわたし"],["、"],["その"],["心","こころ"],["が"],["ご自分","ごじぶん"],["と"],["全く","まったく"],["一","ひと"],["つ"],["に"],["なって"],["いる"],["人々","ひとびと"],["に"],["御力","おちから"],["を"],["あらわして"],["くださる"],["の"],["です"],["。"],["あなた"],["は"],["、"],["この"],["こと"],["について"],["愚か","おろか"],["な"],["こと"],["を"],["しました"],["。"],["今","いま"],["から"],["、"],["あなた"],["は"],["数々","かずかず"],["の"],["戦い","たたかい"],["に"],["巻き込まれます","まきこまれます"],["。"],["」"]]},{"verse":10,"text":"すると、アサはこの予見者に対して怒りを発し、彼に足かせをかけた。このことで、彼に対し激しい怒りをいだいたからである。アサはこのとき、民のうちのある者を踏みにじった。","tok":[["する"],["と"],["、"],["アサ"],["は"],["この"],["予見者","よけんしゃ"],["に対して","にたいして"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["彼","かれ"],["に"],["足かせ","あしかせ"],["を"],["かけた"],["。"],["この"],["こと"],["で"],["、"],["彼","かれ"],["に"],["対し","たいし"],["激しい","はげしい"],["怒り","いかり"],["を"],["いだいた"],["から"],["で"],["ある"],["。"],["アサ"],["は"],["この"],["とき"],["、"],["民","みん"],["の"],["うち"],["の"],["ある"],["者","もの"],["を"],["踏みにじった","ふみにじった"],["。"]]},{"verse":11,"text":"見よ。アサの業績は、最初から最後まで、ユダとイスラエルの王たちの書にまさしくしるされている。","tok":[["見","み"],["よ"],["。"],["アサ"],["の"],["業績","ぎょうせき"],["は"],["、"],["最初","さいしょ"],["から"],["最後","さいご"],["まで"],["、"],["ユダ"],["と"],["イスラエル"],["の"],["王","おう"],["たち"],["の"],["書","しょ"],["に"],["まさしく"],["しるされて"],["いる"],["。"]]},{"verse":12,"text":"それから、アサはその治世の第三十九年に、両足とも病気にかかった。彼の病は重かった。ところが、その病の中でさえ、彼は主を求めることをしないで、逆に医者を求めた。","tok":[["それ"],["から"],["、"],["アサ"],["は"],["その"],["治世","ちせい"],["の"],["第","だい"],["三十九","さんじゅうきゅう"],["年","ねん"],["に"],["、"],["両足","りょうあし"],["とも"],["病気","びょうき"],["に"],["かかった"],["。"],["彼","かれ"],["の"],["病","やまい"],["は"],["重かった","おもかった"],["。"],["ところ"],["が"],["、"],["その"],["病","やまい"],["の"],["中","なか"],["で"],["さえ"],["、"],["彼","かれ"],["は"],["主","ぬし"],["を"],["求める","もとめる"],["こと"],["を"],["しないで"],["、"],["逆","ぎゃく"],["に"],["医者","いしゃ"],["を"],["求めた","もとめた"],["。"]]},{"verse":13,"text":"アサは、彼の先祖たちとともに眠った。すなわち、その治世の第四十一年に死んだ。","tok":[["アサ"],["は"],["、"],["彼","かれ"],["の"],["先祖","せんぞ"],["たち"],["と"],["とも"],["に"],["眠った","ねむった"],["。"],["すなわち"],["、"],["その"],["治世","ちせい"],["の"],["第","だい"],["四十一","よんじゅういち"],["年","ねん"],["に"],["死んだ","しんだ"],["。"]]},{"verse":14,"text":"そこで、人々は、彼が自分のためにダビデの町に掘っておいた墓に彼を葬り、香料の混合法にしたがって作ったかおりの高い香油や香料に満ちたふしどに彼を横たえた。そして、彼のために非常にたくさんの香をたいた。","tok":[["そこ"],["で"],["、"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["が"],["自分","じぶん"],["の"],["ため"],["に"],["ダビデ"],["の"],["町","まち"],["に"],["掘って","ほって"],["おいた"],["墓","はか"],["に"],["彼","かれ"],["を"],["葬り","ほうむり"],["、"],["香料","こうりょう"],["の"],["混合","こんごう"],["法","ほう"],["に"],["したがって"],["作った","つくった"],["かおり"],["の"],["高い","たかい"],["香油","こうゆ"],["や"],["香料","こうりょう"],["に"],["満ちた","みちた"],["ふし"],["ど"],["に"],["彼","かれ"],["を"],["横たえた","よこたえた"],["。"],["そして"],["、"],["彼","かれ"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["たくさん"],["の"],["香","こう"],["を"],["たいた"],["。"]]}]
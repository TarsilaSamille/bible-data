[{"verse":1,"text":"エルサレムの住民は、彼の末子アハズヤを彼の代わりに王とした。アラビヤ人とともに陣営に攻めて来た略奪隊が年長の子らを全部殺してしまったからである。こうして、ユダの王ヨラムの子アハズヤが王となった。","tok":[["エルサレム"],["の"],["住民","じゅうみん"],["は"],["、"],["彼","かれ"],["の"],["末子","ばっし"],["アハズヤ"],["を"],["彼","かれ"],["の"],["代わり","かわり"],["に"],["王","おう"],["と"],["した"],["。"],["アラビヤ"],["人","にん"],["と"],["とも"],["に"],["陣営","じんえい"],["に"],["攻めて","せめて"],["来た","きた"],["略奪隊","りゃくだつたい"],["が"],["年長","ねんちょう"],["の"],["子","こ"],["ら"],["を"],["全部","ぜんぶ"],["殺して","ころして"],["しまった"],["から"],["で"],["ある"],["。"],["こう"],["して"],["、"],["ユダ"],["の"],["王","おう"],["ヨラム"],["の"],["子","こ"],["アハズヤ"],["が"],["王","おう"],["と"],["なった"],["。"]]},{"verse":2,"text":"アハズヤは四十二歳で王となり、エルサレムで一年間、王であった。彼の母の名はアタルヤといい、オムリの孫娘であった。","tok":[["アハズヤ"],["は"],["四十二歳","よんじゅうにさい"],["で"],["王","おう"],["と"],["なり"],["、"],["エルサレム"],["で"],["一","いち"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"],["彼","かれ"],["の"],["母","はは"],["の"],["名","な"],["は"],["アタルヤ"],["と"],["いい"],["、"],["オムリ"],["の"],["孫娘","まごむすめ"],["で"],["あった"],["。"]]},{"verse":3,"text":"彼もまた、アハブの家の道に歩んだ。彼の母が彼の助言者で、悪を行わせたからである。","tok":[["彼","かれ"],["も"],["また"],["、"],["アハブ"],["の"],["家","いえ"],["の"],["道","みち"],["に"],["歩んだ","あゆんだ"],["。"],["彼","かれ"],["の"],["母","はは"],["が"],["彼","かれ"],["の"],["助言者","じょげんしゃ"],["で"],["、"],["悪","あく"],["を"],["行わせた","おこなわせた"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼はアハブの家にならって主の目の前に悪を行った。その父の死後、彼らが助言者となって、彼を滅びに至らせたのである。","tok":[["彼","かれ"],["は"],["アハブ"],["の"],["家","いえ"],["に"],["ならって"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行った","おこなった"],["。"],["その"],["父","ちち"],["の"],["死後","しご"],["、"],["彼","かれ"],["ら"],["が"],["助言者","じょげんしゃ"],["と"],["なって"],["、"],["彼","かれ"],["を"],["滅び","ほろび"],["に"],["至らせた","いたらせた"],["ので"],["ある"],["。"]]},{"verse":5,"text":"彼はこの人々の助言を重んじて行動し、イスラエルの王アハブの子ヨラムとともに、アラムの王ハザエルと戦うため、ラモテ・ギルアデに行ったが、アラム人はヨラムに傷を負わせた。","tok":[["彼","かれ"],["は"],["この"],["人々","ひとびと"],["の"],["助言","じょげん"],["を"],["重んじて","おもんじて"],["行動","こうどう"],["し"],["、"],["イスラエル"],["の"],["王","おう"],["アハブ"],["の"],["子","こ"],["ヨラム"],["と"],["とも"],["に"],["、"],["アラム"],["の"],["王","おう"],["ハザエル"],["と"],["戦う","たたかう"],["ため"],["、"],["ラモテ"],["・"],["ギルアデ"],["に"],["行った","いった"],["が"],["、"],["アラム人","あらむにん"],["は"],["ヨラム"],["に"],["傷","きず"],["を"],["負わせた","おわせた"],["。"]]},{"verse":6,"text":"彼は、アラムの王ハザエルと戦ったときにラマで負わされた傷をいやすため、イズレエルに帰って来た。ユダの王ヨラムの子アハズヤは、アハブの子ヨラムが病気であったので、彼を見舞いにイズレエルに下って行った。","tok":[["彼","かれ"],["は"],["、"],["アラム"],["の"],["王","おう"],["ハザエル"],["と"],["戦った","たたかった"],["とき"],["に"],["ラマ"],["で"],["負わされた","おわされた"],["傷","きず"],["を"],["いやす"],["ため"],["、"],["イズレエル"],["に"],["帰って","かえって"],["来た","きた"],["。"],["ユダ"],["の"],["王","おう"],["ヨラム"],["の"],["子","こ"],["アハズヤ"],["は"],["、"],["アハブ"],["の"],["子","こ"],["ヨラム"],["が"],["病気","びょうき"],["で"],["あった"],["ので"],["、"],["彼","かれ"],["を"],["見舞い","みまい"],["に"],["イズレエル"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":7,"text":"ヨラムのもとに行くことによって、アハズヤが滅びたのは、神から出たことであった。彼はそこに着くと、ヨラムとともにニムシの子エフーに向かって出て行った。これは、主がアハブの家を断ち滅ぼすために油をそそがれた人である。","tok":[["ヨラム"],["の"],["もと"],["に"],["行く","いく"],["こと"],["によって"],["、"],["アハズヤ"],["が"],["滅びた","ほろびた"],["の"],["は"],["、"],["神","かみ"],["から"],["出た","でた"],["こと"],["で"],["あった"],["。"],["彼","かれ"],["は"],["そこ"],["に"],["着く","つく"],["と"],["、"],["ヨラム"],["と"],["とも"],["に"],["ニムシ"],["の"],["子","こ"],["エフー"],["に"],["向かって","むかって"],["出て","でて"],["行った","いった"],["。"],["これ"],["は"],["、"],["主","ぬし"],["が"],["アハブ"],["の"],["家","いえ"],["を"],["断ち","たち"],["滅ぼす","ほろぼす"],["ため"],["に"],["油","あぶら"],["を"],["そそがれた"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":8,"text":"エフーは、アハブの家にさばきを行ったとき、アハズヤに仕えていたユダのつかさたちと、アハズヤの兄弟たちの子らとを見つけたので、これらの人々を殺した。","tok":[["エフー"],["は"],["、"],["アハブ"],["の"],["家","いえ"],["に"],["さばき"],["を"],["行った","おこなった"],["とき"],["、"],["アハズヤ"],["に"],["仕えて","つかえて"],["いた"],["ユダ"],["の"],["つかさ"],["たち"],["と"],["、"],["アハズヤ"],["の"],["兄弟","きょうだい"],["たち"],["の"],["子","こ"],["ら"],["と"],["を"],["見つけた","みつけた"],["ので"],["、"],["これ"],["ら"],["の"],["人々","ひとびと"],["を"],["殺した","ころした"],["。"]]},{"verse":9,"text":"彼がアハズヤを捜したので、人々は彼を捕らえた。彼はサマリヤに身を隠していたのである。こうして、人々は、彼をエフーのもとに引いて来て殺したが、これは心を尽くして主を求めたヨシャパテの子であると言って、彼を葬った。アハズヤの家は王国を治める力を失った。","tok":[["彼","かれ"],["が"],["アハズヤ"],["を"],["捜した","さがした"],["ので"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["捕らえた","とらえた"],["。"],["彼","かれ"],["は"],["サマリヤ"],["に"],["身","み"],["を"],["隠して","かくして"],["いた"],["ので"],["ある"],["。"],["こう"],["して"],["、"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["を"],["エフー"],["の"],["もと"],["に"],["引いて","ひいて"],["来て","きて"],["殺した","ころした"],["が"],["、"],["これ"],["は"],["心","こころ"],["を"],["尽くして","つくして"],["主","ぬし"],["を"],["求めた","もとめた"],["ヨシャパテ"],["の"],["子","こ"],["で"],["ある"],["と"],["言って","いって"],["、"],["彼","かれ"],["を"],["葬った","ほうむった"],["。"],["アハズヤ"],["の"],["家","いえ"],["は"],["王国","おうこく"],["を"],["治める","おさめる"],["力","ちから"],["を"],["失った","うしなった"],["。"]]},{"verse":10,"text":"アハズヤの母アタルヤは、自分の子が死んだと知ると、ただちにユダの家に属する王の一族をことごとく滅ぼした。","tok":[["アハズヤ"],["の"],["母","はは"],["アタルヤ"],["は"],["、"],["自分","じぶん"],["の"],["子","こ"],["が"],["死んだ","しんだ"],["と"],["知る","しる"],["と"],["、"],["ただちに"],["ユダ"],["の"],["家","いえ"],["に"],["属する","ぞくする"],["王","おう"],["の"],["一族","いちぞく"],["を"],["ことごとく"],["滅ぼした","ほろぼした"],["。"]]},{"verse":11,"text":"しかし、王の娘エホシェバが、殺される王の子たちの中から、アハズヤの子ヨアシュを盗み出し、彼とそのうばとを寝具をしまう小部屋に入れた。こうして、ヨラム王の娘、祭司エホヤダの妻、エホシェバは、――彼女がアハズヤの妹であったので――ヨアシュをアタルヤから隠した。アタルヤはこの子を殺さなかった。","tok":[["しかし"],["、"],["王","おう"],["の"],["娘","むすめ"],["エホシェバ"],["が"],["、"],["殺される","ころされる"],["王","おう"],["の"],["子","こ"],["たち"],["の"],["中","なか"],["から"],["、"],["アハズヤ"],["の"],["子","こ"],["ヨアシュ"],["を"],["盗み出し","ぬすみだし"],["、"],["彼","かれ"],["と"],["そのう"],["ばと"],["を"],["寝具","しんぐ"],["を"],["しまう"],["小","こ"],["部屋","へや"],["に"],["入れた","いれた"],["。"],["こう"],["して"],["、"],["ヨラム"],["王","おう"],["の"],["娘","むすめ"],["、"],["祭司","さいし"],["エホヤダ"],["の"],["妻","つま"],["、"],["エホシェバ"],["は"],["、"],["―"],["―"],["彼女","かのじょ"],["が"],["アハズヤ"],["の"],["妹","いもうと"],["で"],["あった"],["ので"],["―"],["―"],["ヨアシュ"],["を"],["アタルヤ"],["から"],["隠した","かくした"],["。"],["アタルヤ"],["は"],["この"],["子","こ"],["を"],["殺さなかった","ころさなかった"],["。"]]},{"verse":12,"text":"こうして、彼はこの人々とともに、神の宮に六年の間、身を隠していた。その間、アタルヤがこの国の王であった。","tok":[["こう"],["して"],["、"],["彼","かれ"],["は"],["この"],["人々","ひとびと"],["と"],["とも"],["に"],["、"],["神","かみ"],["の"],["宮","みや"],["に"],["六","ろく"],["年","ねん"],["の"],["間","あいだ"],["、"],["身","み"],["を"],["隠して","かくして"],["いた"],["。"],["その"],["間","かん"],["、"],["アタルヤ"],["が"],["この"],["国","くに"],["の"],["王","おう"],["で"],["あった"],["。"]]}]
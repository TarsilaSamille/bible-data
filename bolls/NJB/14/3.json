[{"verse":1,"text":"こうして、ソロモンは、主がその父ダビデにご自身を現された所、すなわちエルサレムのモリヤ山上で主の家の建設に取りかかった。彼はそのため、エブス人オルナンの打ち場にある、ダビデの指定した所に、場所を定めた。","tok":[["こう"],["して"],["、"],["ソロモン"],["は"],["、"],["主","ぬし"],["が"],["その"],["父","ちち"],["ダビデ"],["に"],["ご自身","ごじしん"],["を"],["現された","あらわされた"],["所","ところ"],["、"],["すなわち"],["エルサレム"],["の"],["モリヤ"],["山上","やまじょう"],["で"],["主","ぬし"],["の"],["家","いえ"],["の"],["建設","けんせつ"],["に"],["取りかかった","とりかかった"],["。"],["彼","かれ"],["は"],["その"],["ため"],["、"],["エブス人","えぶすにん"],["オルナン"],["の"],["打ち","うち"],["場","ば"],["に"],["ある"],["、"],["ダビデ"],["の"],["指定","してい"],["した"],["所","ところ"],["に"],["、"],["場所","ばしょ"],["を"],["定めた","さだめた"],["。"]]},{"verse":2,"text":"彼が建設に取りかかったのは、その治世の第四年、第二の月の二日であった。","tok":[["彼","かれ"],["が"],["建設","けんせつ"],["に"],["取りかかった","とりかかった"],["の"],["は"],["、"],["その"],["治世","ちせい"],["の"],["第","だい"],["四","よん"],["年","ねん"],["、"],["第","だい"],["二","に"],["の"],["月","つき"],["の"],["二日","ふたか"],["で"],["あった"],["。"]]},{"verse":3,"text":"神の家を建てるために、ソロモンの据えた礎は次のとおりである。長さは先代の尺度のキュビトにしたがって六十キュビト。幅は二十キュビト。","tok":[["神","かみ"],["の"],["家","いえ"],["を"],["建てる","たてる"],["ため"],["に"],["、"],["ソロモン"],["の"],["据えた","すえた"],["礎","いしずえ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["長さ","ながさ"],["は"],["先代","せんだい"],["の"],["尺度","しゃくど"],["の"],["キュビト"],["に"],["したがって"],["六十","ろくじゅう"],["キュビト"],["。"],["幅","はば"],["は"],["二十","にじゅう"],["キュビト"],["。"]]},{"verse":4,"text":"前の玄関は、長さが神殿の幅と同じ二十キュビト、高さは百二十キュビトとし、その内側には純金を着せた。","tok":[["前","まえ"],["の"],["玄関","げんかん"],["は"],["、"],["長さ","ながさ"],["が"],["神殿","しんでん"],["の"],["幅","はば"],["と"],["同じ","おなじ"],["二十","にじゅう"],["キュビト"],["、"],["高さ","たかさ"],["は"],["百二十","ひゃくにじゅう"],["キュビト"],["と"],["し"],["、"],["その"],["内側","うちがわ"],["に"],["は"],["純金","じゅんきん"],["を"],["着せた","きせた"],["。"]]},{"verse":5,"text":"この大きな家はもみの木材でおおい、良質の金を着せ、さらに、その上になつめやしの木の彫刻と鎖を置き、","tok":[["この"],["大きな","おおきな"],["家","いえ"],["は"],["もみ"],["の"],["木材","もくざい"],["で"],["おおい"],["、"],["良質","りょうしつ"],["の"],["金","かね"],["を"],["着せ","きせ"],["、"],["さらに"],["、"],["その"],["上","うえ"],["に"],["なつめやし"],["の"],["木","き"],["の"],["彫刻","ちょうこく"],["と"],["鎖","くさり"],["を"],["置き","おき"],["、"]]},{"verse":6,"text":"宝石の装飾でこの神殿をおおった。ここに用いた金はパルワイムの金であった。","tok":[["宝石","ほうせき"],["の"],["装飾","そうしょく"],["で"],["この"],["神殿","しんでん"],["を"],["おおった"],["。"],["ここ"],["に"],["用いた","もちいた"],["金","かね"],["は"],["パルワイム"],["の"],["金","かね"],["で"],["あった"],["。"]]},{"verse":7,"text":"この神殿の梁にも、敷居にも、壁にも、とびらにも金を着せ、壁にはケルビムを刻んだ。","tok":[["この"],["神殿","しんでん"],["の"],["梁","はり"],["に"],["も"],["、"],["敷居","しきい"],["に"],["も"],["、"],["壁","かべ"],["に"],["も"],["、"],["とびら"],["に"],["も"],["金","きん"],["を"],["着せ","きせ"],["、"],["壁","かべ"],["に"],["は"],["ケルビム"],["を"],["刻んだ","きざんだ"],["。"]]},{"verse":8,"text":"ついで、至聖所を造ったが、その長さはこの神殿の幅と同じ二十キュビト、その幅も二十キュビトとし、これに六百タラントに当たる良質の金を着せた。","tok":[["つい"],["で"],["、"],["至聖所","しせいしょ"],["を"],["造った","つくった"],["が"],["、"],["その"],["長さ","ながさ"],["は"],["この"],["神殿","しんでん"],["の"],["幅","はば"],["と"],["同じ","おなじ"],["二十","にじゅう"],["キュビト"],["、"],["その"],["幅","はば"],["も"],["二十","にじゅう"],["キュビト"],["と"],["し"],["、"],["これ"],["に"],["六百","ろくひゃく"],["タラント"],["に"],["当たる","あたる"],["良質","りょうしつ"],["の"],["金","かね"],["を"],["着せた","きせた"],["。"]]},{"verse":9,"text":"釘の重さは金五十シェケルであった。屋上の間にも金を着せた。","tok":[["釘","くぎ"],["の"],["重さ","おもさ"],["は"],["金","きん"],["五十","ごじゅう"],["シェケル"],["で"],["あった"],["。"],["屋上","おくじょう"],["の"],["間","あいだ"],["に"],["も"],["金","きん"],["を"],["着せた","きせた"],["。"]]},{"verse":10,"text":"至聖所の中に、鋳物のケルビムを二つ作り、これに金を着せた。","tok":[["至聖所","しせいしょ"],["の"],["中","なか"],["に"],["、"],["鋳物","いもの"],["の"],["ケルビム"],["を"],["二","ふた"],["つ"],["作り","つくり"],["、"],["これ"],["に"],["金","かね"],["を"],["着せた","きせた"],["。"]]},{"verse":11,"text":"そのケルビムの翼は、長さが二十キュビトあった。一方のケルブの一つの翼は五キュビトであって、神殿の壁にまで届いており、片方の翼も五キュビトであって、他方のケルブの翼にまで届いていた。","tok":[["その"],["ケルビム"],["の"],["翼","つばさ"],["は"],["、"],["長さ","ながさ"],["が"],["二十","にじゅう"],["キュビト"],["あった"],["。"],["一方","いっぽう"],["の"],["ケルブ"],["の"],["一","ひと"],["つ"],["の"],["翼","つばさ"],["は"],["五","ご"],["キュビト"],["で"],["あって"],["、"],["神殿","しんでん"],["の"],["壁","かべ"],["に"],["まで"],["届いて","とどいて"],["おり"],["、"],["片方","かたほう"],["の"],["翼","つばさ"],["も"],["五","ご"],["キュビト"],["で"],["あって"],["、"],["他方","たほう"],["の"],["ケルブ"],["の"],["翼","つばさ"],["に"],["まで"],["届いて","とどいて"],["いた"],["。"]]},{"verse":12,"text":"もう一方のケルブの一つの翼も五キュビトであって、神殿の壁にまで届いており、片方の翼も五キュビトであって、他方のケルブの翼につながっていた。","tok":[["もう"],["一方","いっぽう"],["の"],["ケルブ"],["の"],["一","ひと"],["つ"],["の"],["翼","つばさ"],["も"],["五","ご"],["キュビト"],["で"],["あって"],["、"],["神殿","しんでん"],["の"],["壁","かべ"],["に"],["まで"],["届いて","とどいて"],["おり"],["、"],["片方","かたほう"],["の"],["翼","つばさ"],["も"],["五","ご"],["キュビト"],["で"],["あって"],["、"],["他方","たほう"],["の"],["ケルブ"],["の"],["翼","つばさ"],["に"],["つながって"],["いた"],["。"]]},{"verse":13,"text":"これらのケルビムの翼は、広げられており、二十キュビトあった。これらは、その足で立ち、その顔は神殿のほうに向いていた。","tok":[["これ"],["ら"],["の"],["ケルビム"],["の"],["翼","つばさ"],["は"],["、"],["広げられて","ひろげられて"],["おり"],["、"],["二十","にじゅう"],["キュビト"],["あった"],["。"],["これ"],["ら"],["は"],["、"],["その"],["足","あし"],["で"],["立ち","たち"],["、"],["その"],["顔","かお"],["は"],["神殿","しんでん"],["の"],["ほう"],["に"],["向いて","むいて"],["いた"],["。"]]},{"verse":14,"text":"それから彼は、青、紫、紅、および白亜麻布の垂れ幕を作り、その上にケルビムの模様を縫いつけた。","tok":[["それ"],["から"],["彼","かれ"],["は"],["、"],["青","あお"],["、"],["紫","むらさき"],["、"],["紅","くれない"],["、"],["および"],["白亜","はくあ"],["麻布","あざぶ"],["の"],["垂れ幕","たれまく"],["を"],["作り","つくり"],["、"],["その"],["上","うえ"],["に"],["ケルビム"],["の"],["模様","もよう"],["を"],["縫いつけた","ぬいつけた"],["。"]]},{"verse":15,"text":"彼は、神殿の前に柱を二本作った。三十五キュビトの高さのもので、その頂にある柱頭は五キュビトであった。","tok":[["彼","かれ"],["は"],["、"],["神殿","しんでん"],["の"],["前","まえ"],["に"],["柱","はしら"],["を"],["二本","にぽん"],["作った","つくった"],["。"],["三十五","さんじゅうご"],["キュビト"],["の"],["高さ","たかさ"],["の"],["もの"],["で"],["、"],["その"],["頂","いただき"],["に"],["ある"],["柱頭","ちゅうとう"],["は"],["五","ご"],["キュビト"],["で"],["あった"],["。"]]},{"verse":16,"text":"さらに、彼は内堂に鎖を作り、これを柱の頂に取りつけ、ざくろを百作り、鎖のところに取りつけた。","tok":[["さらに"],["、"],["彼","かれ"],["は"],["内","うち"],["堂","どう"],["に"],["鎖","くさり"],["を"],["作り","つくり"],["、"],["これ"],["を"],["柱","はしら"],["の"],["頂","いただき"],["に"],["取りつけ","とりつけ"],["、"],["ざくろ"],["を"],["百","ひゃく"],["作り","つくり"],["、"],["鎖","くさり"],["の"],["ところ"],["に"],["取りつけた","とりつけた"],["。"]]},{"verse":17,"text":"それから、彼はこれらの柱を本堂の前に、一つを右側に、もう一つを左側に立てた。右側の柱にヤキンという名をつけ、左側の柱にボアズという名をつけた。","tok":[["それ"
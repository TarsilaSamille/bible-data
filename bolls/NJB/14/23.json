[{"verse":1,"text":"その第七年目に、エホヤダは奮い立って、エロハムの子アザルヤ、ヨハナンの子イシュマエル、オベデの子アザルヤ、アダヤの子マアセヤ、ジクリの子エリシャファテなど、百人隊の長たちを連れて来て、彼と契約を結ばせた。","tok":[["その"],["第","だい"],["七","なな"],["年目","ねんめ"],["に"],["、"],["エホヤダ"],["は"],["奮い立って","ふるいたって"],["、"],["エロハム"],["の"],["子","こ"],["アザルヤ"],["、"],["ヨハナン"],["の"],["子","こ"],["イシュマエル"],["、"],["オベデ"],["の"],["子","こ"],["アザルヤ"],["、"],["アダヤ"],["の"],["子","こ"],["マアセヤ"],["、"],["ジクリ"],["の"],["子","こ"],["エリシャファテ"],["など"],["、"],["百人隊","ひゃくにんたい"],["の"],["長","なが"],["たち"],["を"],["連れて","つれて"],["来て","きて"],["、"],["彼","かれ"],["と"],["契約","けいやく"],["を"],["結ばせた","むすばせた"],["。"]]},{"verse":2,"text":"それで彼らはユダを巡回し、ユダのすべての町々からレビ人を集め、イスラエルの一族のかしらたちを集めたので、彼らはエルサレムに来た。","tok":[["それ"],["で"],["彼","かれ"],["ら"],["は"],["ユダ"],["を"],["巡回","じゅんかい"],["し"],["、"],["ユダ"],["の"],["すべて"],["の"],["町々","まちまち"],["から"],["レビ人","れびにん"],["を"],["集め","あつめ"],["、"],["イスラエル"],["の"],["一族","いちぞく"],["の"],["かしら"],["たち"],["を"],["集めた","あつめた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["エルサレム"],["に"],["来た","きた"],["。"]]},{"verse":3,"text":"こうして、全集団が神の宮で王と契約を結んだ。そのとき、彼はこう言った。「ご覧のとおり、主がダビデの子孫について約束されたように、王の子が王となるのです。","tok":[["こう"],["して"],["、"],["全","ぜん"],["集団","しゅうだん"],["が"],["神","かみ"],["の"],["宮","みや"],["で"],["王","おう"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"],["その"],["とき"],["、"],["彼","かれ"],["は"],["こう"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["の"],["とおり"],["、"],["主","ぬし"],["が"],["ダビデ"],["の"],["子孫","しそん"],["について"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["王","おう"],["の"],["子","こ"],["が"],["王","おう"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":4,"text":"あなたがたのなすべきことはこうです。あなたがた、祭司、レビ人の三分の一は安息日に勤務し、入口にいる門衛となる。","tok":[["あなた"],["がた"],["の"],["なすべき"],["こと"],["は"],["こう"],["です"],["。"],["あなた"],["がた"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["の"],["三分","さんぶん"],["の"],["一","いち"],["は"],["安息日","あんそくび"],["に"],["勤務","きんむ"],["し"],["、"],["入口","いりぐち"],["に"],["いる"],["門衛","もんえい"],["と"],["なる"],["。"]]},{"verse":5,"text":"三分の一は王宮におり、他の三分の一は礎の門にいる。すべての民は主の宮の庭にいる。","tok":[["三分","さんぶん"],["の"],["一","いち"],["は"],["王宮","おうきゅう"],["に"],["おり"],["、"],["他","た"],["の"],["三分","さんぶん"],["の"],["一","いち"],["は"],["礎","いしずえ"],["の"],["門","もん"],["に"],["いる"],["。"],["すべて"],["の"],["民","たみ"],["は"],["主","ぬし"],["の"],["宮","みや"],["の"],["庭","にわ"],["に"],["いる"],["。"]]},{"verse":6,"text":"祭司と、レビ人で仕えている者たちは聖であるから、入ってもよいが、それ以外の者は、主の宮に入ってはならない。すべての民は主の戒めを守らなければならない。","tok":[["祭司","さいし"],["と"],["、"],["レビ人","れびにん"],["で"],["仕えて","つかえて"],["いる"],["者","もの"],["たち"],["は"],["聖","せい"],["で"],["ある"],["から"],["、"],["入って","はいって"],["も"],["よい"],["が"],["、"],["それ"],["以外","いがい"],["の"],["者","もの"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["入って","はいって"],["は"],["ならない"],["。"],["すべて"],["の"],["民","たみ"],["は"],["主","ぬし"],["の"],["戒め","いましめ"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":7,"text":"レビ人は、おのおの武器を手にし、王の回りを取り囲みなさい。宮に入って来る者は殺されなければならない。あなたがたは、王が入るときにも、出るときにも、いつも王とともにいなさい。」","tok":[["レビ人","れびにん"],["は"],["、"],["おのおの"],["武器","ぶき"],["を"],["手","て"],["に"],["し"],["、"],["王","おう"],["の"],["回り","まわり"],["を"],["取り囲み","とりかこみ"],["なさい"],["。"],["宮","みや"],["に"],["入って","はいって"],["来る","くる"],["者","もの"],["は"],["殺されなければ","ころされなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["、"],["王","おう"],["が"],["入る","はいる"],["とき"],["に"],["も"],["、"],["出る","でる"],["とき"],["に"],["も"],["、"],["いつも"],["王","おう"],["と"],["とも"],["に"],["い"],["なさい"],["。"],["」"]]},{"verse":8,"text":"レビ人およびすべてのユダの人々は、すべて祭司エホヤダが命じたとおりに行った。おのおの自分の部下、すなわち安息日に勤務する者、安息日に勤務しない者を率いていた。祭司エホヤダが各組の任を解かなかったからである。","tok":[["レビ人","れびにん"],["および"],["すべて"],["の"],["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["すべて"],["祭司","さいし"],["エホヤダ"],["が"],["命じた","めいじた"],["とおり"],["に"],["行った","いった"],["。"],["おのおの"],["自分","じぶん"],["の"],["部下","ぶか"],["、"],["すなわち"],["安息日","あんそくび"],["に"],["勤務","きんむ"],["する"],["者","もの"],["、"],["安息日","あんそくび"],["に"],["勤務","きんむ"],["しない"],["者","もの"],["を"],["率いて","ひきいて"],["いた"],["。"],["祭司","さいし"],["エホヤダ"],["が"],["各","かく"],["組","くみ"],["の"],["任","にん"],["を"],["解かなかった","とかなかった"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"祭司エホヤダは百人隊の長たちに、神の宮にあったダビデ王の槍、盾、および丸い小盾を与えた。","tok":[["祭司","さいし"],["エホヤダ"],["は"],["百人隊","ひゃくにんたい"],["の"],["長","なが"],["たち"],["に"],["、"],["神","かみ"],["の"],["宮","みや"],["に"],["あった"],["ダビデ"],["王","おう"],["の"],["槍","やり"],["、"],["盾","たて"],["、"],["および"],["丸い","まるい"],["小","こ"],["盾","たて"],["を"],["与えた","あたえた"],["。"]]},{"verse":10,"text":"彼はすべての民にひとりひとり手に投げ槍を持たせて、神殿の右側から神殿の左側まで、祭壇と神殿に向かって王の回りに立たせた。","tok":[["彼","かれ"],["は"],["すべて"],["の"],["民","たみ"],["に"],["ひとりひとり"],["手","て"],["に"],["投げ槍","なげやり"],["を"],["持たせて","もたせて"],["、"],["神殿","しんでん"],["の"],["右側","みぎがわ"],["から"],["神殿","しんでん"],["の"],["左側","ひだりがわ"],["まで"],["、"],["祭壇","さいだん"],["と"],["神殿","しんでん"],["に"],["向かって","むかって"],["王","おう"],["の"],["回り","まわり"],["に"],["立たせた","たたせた"],["。"]]},{"verse":11,"text":"こうして彼らは、王の子を連れ出し、彼に王冠をかぶらせ、さとしの書を渡して、彼を王と宣言した。そしてエホヤダとその子たちが彼に油をそそぎ、「王さま。ばんざい」と叫んだ。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["王","おう"],["の"],["子","こ"],["を"],["連れ出し","つれだし"],["、"],["彼","かれ"],["に"],["王冠","おうかん"],["を"],["かぶらせ"],["、"],["さとし"],["の"],["書","しょ"],["を"],["渡して","わたして"],["、"],["彼","かれ"],["を"],["王","おう"],["と"],["宣言","せんげん"],["した"],["。"],["そして"],["エホヤダ"],["と"],["その"],["子","こ"],["たち"],["が"],["彼","かれ"],["に"],["油","あぶら"],["を"],["そそぎ"],["、"],["「"],["王","おう"],["さま"],["。"],["ばんざい"],["」"],["と"],["叫んだ","さけんだ"],["。"]]},{"verse":12,"text":"アタルヤは、王をほめたたえている民と近衛兵の声を聞いて、主の宮の民のところに行った。","tok":[["アタルヤ"],["は"],["、"],["王","おう"],["を"],["ほめたたえて"],["いる"],["民","たみ"],["と"],["近衛兵","このえへい"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["民","たみ"],["の"],["ところ"],["に"],["行った","いった"],["。"]]},{"verse":13,"text":"見ると、なんと、王が入口の柱のそばに立っていた。王のかたわらに、隊長たちやラッパ手たちがいた。一般の人々がみな喜んでラッパを吹き鳴らしており、歌うたいたちが楽器を手にし、賛美の拍子をとっていた。アタルヤは自分の衣服を引き裂き、「謀反だ。謀反だ」と言った。","tok":[["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["王","おう"],["が"],["入口","いりぐち"],["の"],["柱","はしら"],["の"],["そば"],["に"],["立って","たって"],["いた"],["。"],["王","おう"],["の"],["かたわら"],["に"],["、"],["隊長","たいちょう"],["たち"],["や"],["ラッパ"],["手","て"],["たち"],["が"],["いた"],["。"],["一般","いっぱん"],["の"],["人々","ひとびと"],["が"],["みな"],["喜んで","よろこんで"],["ラッパ"],["を"],["吹き鳴らして","ふきならして"],["おり"],["、"],["歌うたい","うたうたい"],["たち"],["が"],["楽器","がっき"],["を"],["手","て"],["に"],["し"],["、"],["賛美","さんび"],["の"],["拍子","ひょうし"],["を"],["とって"],["いた"],["。"],["アタルヤ"],["は"],["自分","じぶん"],["の"],["衣服","いふく"],["を"],["引き裂き","ひきさき"],["、"],["「"],["謀反","むほん"],["だ"],["。"],["謀反","むほん"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"すると、祭司エホヤダは、部隊をゆだねられた百人隊の長たちを呼び出して、彼らに言った。「この女を列の間から連れ出せ。この女に従って来る者は剣で殺されなければならない。」祭司が「この女を主の宮で殺してはならない」と言ったからである。","tok":[["する"],["と"],["、"],["祭司","さいし"],["エホヤダ"],["は"],["、"],["部隊","ぶたい"],["を"],["ゆだねられた"],["百人隊","ひゃくにんたい"],["の"],["長","なが"],["たち"],["を"],["呼び出して","よびだして"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["この"],["女","おんな"],["を"],["列","れつ"],["の"],["間","あいだ"],["から"],["連れ出せ","つれだせ"],["。"],["この"],["女","おんな"],["に"],["従って","したがって"],["来る","くる"],["者","もの"],["は"],["剣","けん"],["で"],["殺されなければ","ころされなければ"],["ならない"],["。"],["」"],["祭司","さいし"],["が"],["「"],["この"],["女","おんな"],["を"],["主","ぬし"],["の"],["宮","みや"],["で"],["殺して","ころして"],["は"],["ならない"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"彼らは彼女を取り押さえ、彼女が馬の門の出入口を通って、王宮に着いたとき、そこで彼女を殺した。","tok":[["彼","かれ"],["ら"],["は"],["彼女","かのじょ"],["を"],["取り押さえ","とりおさえ"],["、"],["彼女","かのじょ"],["が"],["馬","うま"],["の"],["門","もん"],["の"],["出入","でいり"],["口","くち"],["を"],["通って","とおって"],["、"],["王宮","おうきゅう"],["に"],["着いた","ついた"],["とき"],["、"],["そこ"],["で"],["彼女","かのじょ"],["を"],["殺した","ころした"],["。"]]},{"verse":16,"text":"エホヤダは、彼とすべての民と王との間で、主の民となるという契約を結んだ。","tok":[["エホヤダ"],["は"],["、"],["彼","かれ"],["と"],["すべて"],["の"],["民","たみ"],["と"],["王","おう"],["と"],["の"],["間","あいだ"],["で"],["、"],["主","ぬし"],["の"],["民","たみ"],["と"],["なる"],["と"],["いう"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":17,"text":"民はみなバアルの宮に行って、それを取りこわし、その祭壇とその像を打ち砕き、バアルの祭司マタンを祭壇の前で殺した。","tok":[["民","みん"],["は"],["みな"],["バアル"],["の"],["宮","みや"],["に"],["行って","いって"],["、"],["それ"],["を"],["取りこわし","とりこわし"],["、"],["その"],["祭壇","さいだん"],["と"],["その"],["像","ぞう"],["を"],["打ち砕き","うちくだき"],["、"],["バアル"],["の"],["祭司","さいし"],["マタン"],["を"],["祭壇","さいだん"],["の"],["前","まえ"],["で"],["殺した","ころした"],["。"]]},{"verse":18,"text":"エホヤダは、主の宮の管理を定めて、これをレビ人の祭司の手にゆだねた。彼らは、モーセの律法にしるされているとおり、ダビデの指示に基づいて、喜びと歌とをもって主の全焼のいけにえをささげさせるようにと、ダビデが組分けをして主の宮に配属した人々である。","tok":[["エホヤダ"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["管理","かんり"],["を"],["定めて","さだめて"],["、"],["これ"],["を"],["レビ人","れびにん"],["の"],["祭司","さいし"],["の"],["手","て"],["に"],["ゆだねた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["モーセ"],["の"],["律法","りっぽう"],["に"],["しるされて"],["いる"],["とおり"],["、"],["ダビデ"],["の"],["指示","しじ"],["に"],["基づいて","もとづいて"],["、"],["喜び","よろこび"],["と"],["歌","うた"],["と"],["を"],["もって"],["主","ぬし"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげさせる"],["よう"],["に"],["と"],["、"],["ダビデ"],["が"],["組分け","くみわけ"],["を"],["して"],["主","ぬし"],["の"],["宮","みや"],["に"],["配属","はいぞく"],["した"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":19,"text":"さらに、彼は主の宮の門に、門衛たちを立て、どんなことで汚れた者であっても、だれひとり入り込ませないようにした。","tok":[["さらに"],["、"],["彼","かれ"],["は"],["主","ぬし"],["の"],["宮","みや"],["の"],["門","もん"],["に"],["、"],["門衛","もんえい"],["たち"],["を"],["立て","たて"],["、"],["どんな"],["こと"],["で"],["汚れた","よごれた"],["者","もの"],["で"],["あって"],["も"],["、"],["だれ"],["ひとり"],["入り込ませない","はいりこませない"],["よう"],["に"],["した"],["。"]]},{"verse":20,"text":"彼は百人隊の長たち、貴人たち、民の支配者たちとすべての一般の人々を率いて、王を主の宮から連れ下った。彼らは上の門をくぐって王宮に入り、王を王国の王座に着かせた。","tok":[["彼","かれ"],["は"],["百人隊","ひゃくにんたい"],["の"],["長","なが"],["たち"],["、"],["貴人","きじん"],["たち"],["、"],["民","みん"],["の"],["支配者","しはいしゃ"],["たち"],["と"],["すべて"],["の"],["一般","いっぱん"],["の"],["人々","ひとびと"],["を"],["率いて","ひきいて"],["、"],["王","おう"],["を"],["主","ぬし"],["の"],["宮","みや"],["から"],["連れ","つれ"],["下った","くだった"],["。"],["彼","かれ"],["ら"],["は"],["上","うえ"],["の"],["門","もん"],["を"],["くぐって"],["王宮","おうきゅう"],["に"],["入り","はいり"],["、"],["王","おう"],["を"],["王国","おうこく"],["の"],["王座","おうざ"],["に"],["着かせた","つかせた"],["。"]]},{"verse":21,"text":"一般の人々はみな喜び、この町は平穏であった。彼らはアタルヤを剣にかけて殺したからである。","tok":[["一般","いっぱん"],["の"],["人々","ひとびと"],["は"],["みな"],["喜び","よろこび"],["、"],["この"],["町","まち"],["は"],["平穏","へいおん"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["アタルヤ"],["を"],["剣","けん"],["に"],["かけて"],["殺した","ころした"],["から"],["で"],["ある"],["。"]]}]
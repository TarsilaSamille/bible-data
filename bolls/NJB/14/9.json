"],["の"],["事績","じせき"],["と"],["あなた"],["の"],["知恵","ちえ"],["と"],["について"],["聞き及んで","ききおよんで"],["おりました"],["こと"],["は"],["ほんとう"],["でした"],["。"]]},{"verse":6,"text":"実は、私は、自分で来て、自分の目で見るまでは、彼らの言うことを信じなかったのですが、驚いたことに、私にはあなたの知恵の半分も知らされていなかったのです。あなたは、私の聞いていたうわさを上回る方でした。","tok":[["実","じつ"],["は"],["、"],["私","わたくし"],["は"],["、"],["自分","じぶん"],["で"],["来て","きて"],["、"],["自分","じぶん"],["の"],["目","め"],["で"],["見る","みる"],["まで"],["は"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["信じなかった","しんじなかった"],["の"],["です"],["が"],["、"],["驚いた","おどろいた"],["こと"],["に"],["、"],["私","わたくし"],["に"],["は"],["あなた"],["の"],["知恵","ちえ"],["の"],["半分","はんぶん"],["も"],["知らされて","しらされて"],["いなかった"],["の"],["です"],["。"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["聞いて","きいて"],["いた"],["うわさ"],["を"],["上回る","うわまわる"],["方","かた"],["でした"],["。"]]},{"verse":7,"text":"なんとしあわせなことでしょう。あなたにつく人たちは。なんとしあわせなことでしょう。いつもあなたの前に立って、あなたの知恵を聞くことのできるこの、あなたの家来たちは。","tok":[["なん"],["と"],["しあわせ"],["な"],["こと"],["でしょう"],["。"],["あなた"],["に"],["つく"],["人","ひと"],["たち"],["は"],["。"],["なん"],["と"],["しあわせ"],["な"],["こと"],["でしょう"],["。"],["いつも"],["あなた"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["あなた"],["の"],["知恵","ちえ"],["を"],["聞く","きく"],["こと"],["の"],["できる"],["この"],["、"],["あなた"],["の"],["家来","けらい"],["たち"],["は"],["。"]]},{"verse":8,"text":"あなたを喜ばれ、その王座にあなたを着かせて、あなたの神、主のために王とされたあなたの神、主はほむべきかな。あなたの神はイスラエルを愛して、これをとこしえにゆるがぬものとされたので、彼らの上にあなたを王として与え、公正と正義とを行わせられるのです。」","tok":[["あなた"],["を"],["喜ばれ","よろこばれ"],["、"],["その"],["王座","おうざ"],["に"],["あなた"],["を"],["着かせて","つかせて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["王","おう"],["と"],["された"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["あなた"],["の"],["神","かみ"],["は"],["イスラエル"],["を"],["愛して","あいして"],["、"],["これ"],["を"],["とこしえ"],["に"],["ゆるがぬ"],["もの"],["と"],["された"],["ので"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["あなた"],["を"],["王","おう"],["として"],["与え","あたえ"],["、"],["公正","こうせい"],["と"],["正義","まさよし"],["と"],["を"],["行わせられる","おこなわせられる"],["の"],["です"],["。"],["」"]]},{"verse":9,"text":"彼女は百二十タラ
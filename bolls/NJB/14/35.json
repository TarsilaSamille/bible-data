[{"verse":1,"text":"さて、ヨシヤはエルサレムで主に過越のいけにえをささげた。人々は第一の月の十四日に過越のいけにえをほふった。","tok":[["さて"],["、"],["ヨシヤ"],["は"],["エルサレム"],["で"],["主に","おもに"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげた"],["。"],["人々","ひとびと"],["は"],["第","だい"],["一","いち"],["の"],["月","つき"],["の"],["十四日","じゅうよんか"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ほふった"],["。"]]},{"verse":2,"text":"彼は祭司たちを任命してその任務につかせ、彼らを力づけて、主の宮の奉仕に当たらせた。","tok":[["彼","かれ"],["は"],["祭司","さいし"],["たち"],["を"],["任命","にんめい"],["して"],["その"],["任務","にんむ"],["に"],["つかせ"],["、"],["彼","かれ"],["ら"],["を"],["力づけて","ちからづけて"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["奉仕","ほうし"],["に"],["当たらせた","あたらせた"],["。"]]},{"verse":3,"text":"それから、彼は、全イスラエルを教え導く者であり、主の聖なる者であるレビ人たちに言った。「聖なる箱を、イスラエルの王ダビデの子ソロモンが建てた宮に据えなさい。もう、あなたがたにとって肩の重荷にはなるまい。そこで今、あなたがたの神、主と、主の民イスラエルに仕えなさい。","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["、"],["全","ぜん"],["イスラエル"],["を"],["教え導く","おしえみちびく"],["者","もの"],["で"],["あり"],["、"],["主","ぬし"],["の"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["レビ人","れびにん"],["たち"],["に"],["言った","いった"],["。"],["「"],["聖","せい"],["なる"],["箱","ばこ"],["を"],["、"],["イスラエル"],["の"],["王","おう"],["ダビデ"],["の"],["子","こ"],["ソロモン"],["が"],["建てた","たてた"],["宮","みや"],["に"],["据え","すえ"],["なさい"],["。"],["もう"],["、"],["あなた"],["がた"],["にとって"],["肩","かた"],["の"],["重荷","おもに"],["に"],["は"],["なるまい"],["。"],["そこ"],["で"],["今","いま"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["と"],["、"],["主","ぬし"],["の"],["民","みん"],["イスラエル"],["に"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":4,"text":"イスラエルの王ダビデの文書およびその子ソロモンの書きつけのとおりに、父祖の家ごとに、組分けに従って、用意をしなさい。","tok":[["イスラエル"],["の"],["王","おう"],["ダビデ"],["の"],["文書","ぶんしょ"],["および"],["その"],["子","こ"],["ソロモン"],["の"],["書きつけ","かきつけ"],["の"],["とおり"],["に"],["、"],["父祖","ふそ"],["の"],["家","いえ"],["ごと"],["に"],["、"],["組分け","くみわけ"],["に"],["従って","したがって"],["、"],["用意","ようい"],["を"],["し"],["なさい"],["。"]]},{"verse":5,"text":"あなたがたの同胞であるこの民の者たちが属している父祖の家の区分に従って、聖所に立ちなさい。レビ人にとって、一族の分があるようにしなさい。","tok":[["あなた"],["がた"],["の"],["同胞","どうほう"],["で"],["ある"],["この"],["民","たみ"],["の"],["者","もの"],["たち"],["が"],["属して","ぞくして"],["いる"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["区分","くぶん"],["に"],["従って","したがって"],["、"],["聖","せい"],["所","しょ"],["に"],["立ち","たち"],["なさい"],["。"],["レビ人","れびにん"],["にとって"],["、"],["一族","いちぞく"],["の"],["分","ぶん"],["が"],["ある"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":6,"text":"それから、過越のいけにえをほふり、身を聖別し、あなたがたの同胞のために用意をして、モーセを通して示された主のことばのとおりに行いなさい。」","tok":[["それ"],["から"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ほふり"],["、"],["身","み"],["を"],["聖別","せいべつ"],["し"],["、"],["あなた"],["がた"],["の"],["同胞","どうほう"],["の"],["ため"],["に"],["用意","ようい"],["を"],["して"],["、"],["モーセ"],["を"],["通して","とおして"],["示された","しめされた"],["主","ぬし"],["の"],["ことば"],["の"],["とおり"],["に"],["行い","おこない"],["なさい"],["。"],["」"]]},{"verse":7,"text":"ヨシヤは民の者たちに羊の群れ、すなわち、子羊とやぎの子を贈った。すべては、そこにいたすべての人の過越のいけにえのためであった。その数は三万、牛は三千。これらは王の財産の中から出された。","tok":[["ヨシヤ"],["は"],["民","みん"],["の"],["者","もの"],["たち"],["に"],["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["すなわち"],["、"],["子羊","こひつじ"],["と"],["やぎ"],["の"],["子","こ"],["を"],["贈った","おくった"],["。"],["すべて"],["は"],["、"],["そこ"],["に"],["いた"],["すべて"],["の"],["人","ひと"],["の"],["過越","すぎこし"],["の"],["いけにえ"],["の"],["ため"],["で"],["あった"],["。"],["その"],["数","すう"],["は"],["三万","さんまん"],["、"],["牛","うし"],["は"],["三千","さんせん"],["。"],["これ"],["ら"],["は"],["王","おう"],["の"],["財産","ざいさん"],["の"],["中","なか"],["から"],["出された","だされた"],["。"]]},{"verse":8,"text":"彼のつかさたちも、民および祭司たち、レビ人たちに、進んでささげるささげ物として贈り物をした。神の宮のつかさ、ヒルキヤ、ゼカリヤ、エヒエルも、祭司たちに過越のいけにえとして羊二千六百頭、牛三百頭を与えた。","tok":[["彼","かれ"],["の"],["つかさ"],["たち"],["も"],["、"],["民","みん"],["および"],["祭司","さいし"],["たち"],["、"],["レビ人","れびにん"],["たち"],["に"],["、"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["として"],["贈り物","おくりもの"],["を"],["した"],["。"],["神","かみ"],["の"],["宮","みや"],["の"],["つかさ"],["、"],["ヒルキヤ"],["、"],["ゼカリヤ"],["、"],["エヒエル"],["も"],["、"],["祭司","さいし"],["たち"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["として"],["羊","ひつじ"],["二千六百","にせんろくひゃく"],["頭","とう"],["、"],["牛","うし"],["三百頭","さんひゃくとう"],["を"],["与えた","あたえた"],["。"]]},{"verse":9,"text":"さらに、レビ人のつかさたち、すなわち、カナヌヤとその兄弟シェマヤ、ネタヌエル、およびハシャブヤ、エイエル、エホザバデも、レビ人に過越のいけにえとして羊五千頭、牛五百頭を贈った。","tok":[["さらに"],["、"],["レビ人","れびにん"],["の"],["つかさ"],["たち"],["、"],["すなわち"],["、"],["カナヌヤ"],["と"],["その"],["兄弟","きょうだい"],["シェマヤ"],["、"],["ネタヌエル"],["、"],["および"],["ハシャブヤ"],["、"],["エイエル"],["、"],["エホザバデ"],["も"],["、"],["レビ人","れびにん"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["として"],["羊","ひつじ"],["五千頭","ごせんとう"],["、"],["牛","うし"],["五百頭","ごひゃくとう"],["を"],["贈った","おくった"],["。"]]},{"verse":10,"text":"こうして、奉仕の用意ができたので、王の命令のとおりに、祭司たちはおのおのの定めの場所に立ち、レビ人はおのおのの組分けに従って立った。","tok":[["こう"],["して"],["、"],["奉仕","ほうし"],["の"],["用意","ようい"],["が"],["できた"],["ので"],["、"],["王","おう"],["の"],["命令","めいれい"],["の"],["とおり"],["に"],["、"],["祭司","さいし"],["たち"],["は"],["おのおの"],["の"],["定め","さだめ"],["の"],["場所","ばしょ"],["に"],["立ち","たち"],["、"],["レビ人","れびにん"],["は"],["おのおの"],["の"],["組分け","くみわけ"],["に"],["従って","したがって"],["立った","たった"],["。"]]},{"verse":11,"text":"彼らが過越のいけにえをほふると、祭司たちは彼らの手から血を受け取って注ぎかけ、レビ人は皮をはいだ。","tok":[["彼","かれ"],["ら"],["が"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ほふる"],["と"],["、"],["祭司","さいし"],["たち"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["血","ち"],["を"],["受け取って","うけとって"],["注ぎ","そそぎ"],["かけ"],["、"],["レビ人","れびにん"],["は"],["皮","かわ"],["を"],["はいだ"],["。"]]},{"verse":12,"text":"それから、彼らは全焼のいけにえを取り除き、これを民の者たちの父祖の家の各区分に渡し、モーセの書にしるされているとおりに主にささげさせた。牛についても同様にした。","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["取り除き","とりのぞき"],["、"],["これ"],["を"],["民","たみ"],["の"],["者","もの"],["たち"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["各","かく"],["区分","くぶん"],["に"],["渡し","わたし"],["、"],["モーセ"],["の"],["書","しょ"],["に"],["しるされて"],["いる"],["とおり"],["に"],["主に","おもに"],["ささげさせた"],["。"],["牛","うし"],["について"],["も"],["同様","どうよう"],["に"],["した"],["。"]]},{"verse":13,"text":"それから、彼らは定めのとおりに、過越のいけにえに火を加えて調理し、聖別されたささげ物を、なべ、かま、平なべなどで調理して、民たち全員のもとに急いで運んだ。","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["定め","さだめ"],["の"],["とおり"],["に"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["に"],["火","ひ"],["を"],["加えて","くわえて"],["調理","ちょうり"],["し"],["、"],["聖別","せいべつ"],["された"],["ささげ物","ささげもの"],["を"],["、"],["なべ"],["、"],["かま"],["、"],["平なべ","ひらなべ"],["など"],["で"],["調理","ちょうり"],["して"],["、"],["民","たみ"],["たち"],["全員","ぜんいん"],["の"],["もと"],["に"],["急いで","いそいで"],["運んだ","はこんだ"],["。"]]},{"verse":14,"text":"そのあとで、彼らは自分たちや祭司たちのための用意をした。アロンの子らである祭司たちは、夜になるまで、全焼のいけにえと脂肪をささげていたからである。そこでレビ人は、自分たちや、アロンの子らである祭司たちのための用意をした。","tok":[["その"],["あと"],["で"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["や"],["祭司","さいし"],["たち"],["の"],["ため"],["の"],["用意","ようい"],["を"],["した"],["。"],["アロン"],["の"],["子","こ"],["ら"],["で"],["ある"],["祭司","さいし"],["たち"],["は"],["、"],["夜","よる"],["に"],["なる"],["まで"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["脂肪","しぼう"],["を"],["ささげて"],["いた"],["から"],["で"],["ある"],["。"],["そこ"],["で"],["レビ人","れびにん"],["は"],["、"],["自分","じぶん"],["たち"],["や"],["、"],["アロン"],["の"],["子","こ"],["ら"],["で"],["ある"],["祭司","さいし"],["たち"],["の"],["ため"],["の"],["用意","ようい"],["を"],["した"],["。"]]},{"verse":15,"text":"アサフの子らである歌うたいたちは、ダビデ、アサフ、ヘマン、および、王の先見者エドトンの命令のとおりに、その役目についていた。また、門衛たちは、それぞれの門を守っていた。彼らのうちだれも、その奉仕を離れる必要がなかった。彼らの同族であるレビ人が彼らのための用意をしたからである。","tok":[["アサフ"],["の"],["子","こ"],["ら"],["で"],["ある"],["歌うたい","うたうたい"],["たち"],["は"],["、"],["ダビデ"],["、"],["アサフ"],["、"],["ヘマン"],["、"],["および"],["、"],["王","おう"],["の"],["先見者","せんけんしゃ"],["エドトン"],["の"],["命令","めいれい"],["の"],["とおり"],["に"],["、"],["その"],["役目","やくめ"],["について"],["いた"],["。"],["また"],["、"],["門衛","もんえい"],["たち"],["は"],["、"],["それぞれ"],["の"],["門","もん"],["を"],["守って","まもって"],["いた"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["だれ"],["も"],["、"],["その"],["奉仕","ほうし"],["を"],["離れる","はなれる"],["必要","ひつよう"],["が"],["なかった"],["。"],["彼","かれ"],["ら"],["の"],["同族","どうぞく"],["で"],["ある"],["レビ人","れびにん"],["が"],["彼","かれ"],["ら"],["の"],["ため"],["の"],["用意","ようい"],["を"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"こうして、この日に、すべて主への奉仕の用意ができ、ヨシヤ王の命令のとおりに過越のいけにえをささげ、主の祭壇で全焼のいけにえをささげるばかりになったので、","tok":[["こう"],["して"],["、"],["この"],["日","ひ"],["に"],["、"],["すべて"],["主","ぬし"],["へ"],["の"],["奉仕","ほうし"],["の"],["用意","ようい"],["が"],["でき"],["、"],["ヨシヤ"],["王","おう"],["の"],["命令","めいれい"],["の"],["とおり"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["主","ぬし"],["の"],["祭壇","さいだん"],["で"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげる"],["ばかり"],["に"],["なった"],["ので"],["、"]]},{"verse":17,"text":"そこにいたイスラエル人は、そのとき、過越のいけにえをささげ、七日間、種を入れないパンの祭りを行った。","tok":[["そこ"],["に"],["いた"],["イスラエル"],["人","にん"],["は"],["、"],["その"],["とき"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["七","なな"],["日間","かかん"],["、"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["の"],["祭り","まつり"],["を"],["行った","おこなった"],["。"]]},{"verse":18,"text":"預言者サムエルの時代からこのかた、イスラエルでこのような過越のいけにえがささげられたことはなかった。イスラエルのどの王も、ここでヨシヤが行い、祭司たちとレビ人、および、そこにいた全ユダとイスラエル、さらに、エルサレムの住民たちがささげたような過越のいけにえをささげたことはなかった。","tok":[["預言者","よげんしゃ"],["サムエル"],["の"],["時代","じだい"],["から"],["このかた"],["、"],["イスラエル"],["で"],["この"],["よう"],["な"],["過越","すぎこし"],["の"],["いけにえ"],["が"],["ささげられた"],["こと"],["は"],["なかった"],["。"],["イスラエル"],["の"],["どの"],["王","おう"],["も"],["、"],["ここ"],["で"],["ヨシヤ"],["が"],["行い","おこない"],["、"],["祭司","さいし"],["たち"],["と"],["レビ人","れびにん"],["、"],["および"],["、"],["そこ"],["に"],["いた"],["全","ぜん"],["ユダ"],["と"],["イスラエル"],["、"],["さらに"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["たち"],["が"],["ささげた"],["よう"],["な"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげた"],["こと"],["は"],["なかった"],["。"]]},{"verse":19,"text":"ヨシヤの治世の第十八年に、この過越のいけにえがささげられた。","tok":[["ヨシヤ"],["の"],["治世","ちせい"],["の"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["に"],["、"],["この"],["過越","すぎこし"],["の"],["いけにえ"],["が"],["ささげられた"],["。"]]},{"verse":20,"text":"すべてこのように、ヨシヤが宮を整えて後、エジプトの王ネコが、ユーフラテス河畔のカルケミシュで戦うために上って来た。そこでヨシヤは、彼を迎え撃ちに出て行った。","tok":[["すべて"],["この"],["よう"],["に"],["、"],["ヨシヤ"],["が"],["宮","みや"],["を"],["整えて","ととのえて"],["後","あと"],["、"],["エジプト"],["の"],["王","おう"],["ネコ"],["が"],["、"],["ユーフラテス"],["河畔","かはん"],["の"],["カルケミシュ"],["で"],["戦う","たたかう"],["ため"],["に"],["上って","のぼって"],["来た","きた"],["。"],["そこ"],["で"],["ヨシヤ"],["は"],["、"],["彼","かれ"],["を"],["迎え撃ち","むかえうち"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":21,"text":"ところが、ネコは彼のもとに使者を遣わして言った。「ユダの王よ。私とあなたと何の関係があるのですか。きょうは、あなたを攻めに来たのではありません。私の戦う家へ行くところなのです。神は、早く行けと命じておられます。私とともにおられる神に逆らわずに、控えていなさい。さもなければ、神があなたを滅ぼされます。」","tok":[["ところ"],["が"],["、"],["ネコ"],["は"],["彼","かれ"],["の"],["もと"],["に"],["使者","ししゃ"],["を"],["遣わして","つかわして"],["言った","いった"],["。"],["「"],["ユダ"],["の"],["王","おう"],["よ"],["。"],["私","わたくし"],["と"],["あなた"],["と"],["何","なん"],["の"],["関係","かんけい"],["が"],["ある"],["の"],["です"],["か"],["。"],["きょう"],["は"],["、"],["あなた"],["を"],["攻め","せめ"],["に"],["来た","きた"],["ので"],["は"],["ありません"],["。"],["私","わたくし"],["の"],["戦う","たたかう"],["家","いえ"],["へ"],["行く","いく"],["ところ"],["な"],["の"],["です"],["。"],["神","かみ"],["は"],["、"],["早く","はやく"],["行け","いけ"],["と"],["命じて","めいじて"],["おられます"],["。"],["私","わたくし"],["と"],["とも"],["に"],["おられる"],["神","かみ"],["に"],["逆らわず","さからわず"],["に"],["、"],["控えて","ひかえて"],["い"],["なさい"],["。"],["さも"],["なければ"],["、"],["神","かみ"],["が"],["あなた"],["を"],["滅ぼされます","ほろぼされます"],["。"],["」"]]},{"verse":22,"text":"しかし、ヨシヤは身を引かず、かえって、彼と戦おうとして変装し、神の御口から出たネコのことばを聞かなかった。そして、メギドの平地で戦うために行った。","tok":[["しかし"],["、"],["ヨシヤ"],["は"],["身","み"],["を"],["引かず","ひかず"],["、"],["かえって"],["、"],["彼","かれ"],["と"],["戦おう","たたかおう"],["として"],["変装","へんそう"],["し"],["、"],["神","かみ"],["の"],["御口","おくち"],["から"],["出た","でた"],["ネコ"],["の"],["ことば"],["を"],["聞かなかった","きかなかった"],["。"],["そして"],["、"],["メギド"],["の"],["平地","へいち"],["で"],["戦う","たたかう"],["ため"],["に"],["行った","いった"],["。"]]},{"verse":23,"text":"射手たちがヨシヤ王を射たとき、王は家来たちに言った。「私を降ろしてくれ。傷を負ったのだ。」","tok":[["射手","いて"],["たち"],["が"],["ヨシヤ"],["王","おう"],["を"],["射た","いた"],["とき"],["、"],["王","おう"],["は"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["を"],["降ろして","おろして"],["くれ"],["。"],["傷","きず"],["を"],["負った","おった"],["の"],["だ"],["。"],["」"]]},{"verse":24,"text":"そこで、家来たちは彼を戦車から降ろし、彼の持っていた第二の車に乗せた。そして、彼をエルサレムに連れ帰った。彼は死んだので、その先祖たちの墓に葬られた。全ユダとエルサレムはヨシヤのために喪に服した。","tok":[["そこ"],["で"],["、"],["家来","けらい"],["たち"],["は"],["彼","かれ"],["を"],["戦車","せんしゃ"],["から"],["降ろし","おろし"],["、"],["彼","かれ"],["の"],["持って","もって"],["いた"],["第","だい"],["二","に"],["の"],["車","くるま"],["に"],["乗せた","のせた"],["。"],["そして"],["、"],["彼","かれ"],["を"],["エルサレム"],["に"],["連れ帰った","つれかえった"],["。"],["彼","かれ"],["は"],["死んだ","しんだ"],["ので"],["、"],["その"],["先祖","せんぞ"],["たち"],["の"],["墓","はか"],["に"],["葬られた","ほうむられた"],["。"],["全","ぜん"],["ユダ"],["と"],["エルサレム"],["は"],["ヨシヤ"],["の"],["ため"],["に"],["喪","も"],["に"],["服した","ふくした"],["。"]]},{"verse":25,"text":"エレミヤはヨシヤのために哀歌を作った。そして、男女の歌うたいはみな、今日に至るまで、彼らの哀歌の中でヨシヤのことを語り、これをイスラエルのために慣例としている。これらは哀歌にまさしくしるされている。","tok":[["エレミヤ"],["は"],["ヨシヤ"],["の"],["ため"],["に"],["哀歌","あいか"],["を"],["作った","つくった"],["。"],["そして"],["、"],["男女","だんじょ"],["の"],["歌うたい","うたうたい"],["は"],["みな"],["、"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["彼","かれ"],["ら"],["の"],["哀歌","あいか"],["の"],["中","なか"],["で"],["ヨシヤ"],["の"],["こと"],["を"],["語り","かたり"],["、"],["これ"],["を"],["イスラエル"],["の"],["ため"],["に"],["慣例","かんれい"],["として"],["いる"],["。"],["これ"],["ら"],["は"],["哀歌","あいか"],["に"],["まさしく"],["しるされて"],["いる"],["。"]]},{"verse":26,"text":"ヨシヤのその他の業績、すなわち、主の律法にしるされているところに従った彼の忠実な行為、","tok":[["ヨシヤ"],["の"],["その"],["他","た"],["の"],["業績","ぎょうせき"],["、"],["すなわち"],["、"],["主","ぬし"],["の"],["律法","りっぽう"],["に"],["しるされて"],["いる"],["ところ"],["に"],["従った","したがった"],["彼","かれ"],["の"],["忠実","ちゅうじつ"],["な"],["行為","こうい"],["、"]]},{"verse":27,"text":"彼の業績は、最初から最後まで、イスラエルとユダの王たちの書にまさしくしるされている。","tok":[["彼","かれ"],["の"],["業績","ぎょうせき"],["は"],["、"],["最初","さいしょ"],["から"],["最後","さいご"],["まで"],["、"],["イスラエル"],["と"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["書","しょ"],["に"],["まさしく"],["しるされて"],["いる"],["。"]]}]
[{"verse":1,"text":"さて、ダビデの子ソロモンは、ますます王権を強固にした。彼の神、主は彼とともにおられ、彼を並みはずれて偉大な者とされた。","tok":[["さて"],["、"],["ダビデ"],["の"],["子","こ"],["ソロモン"],["は"],["、"],["ますます"],["王権","おうけん"],["を"],["強固","きょうこ"],["に"],["した"],["。"],["彼","かれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["彼","かれ"],["と"],["とも"],["に"],["おられ"],["、"],["彼","かれ"],["を"],["並み","なみ"],["は"],["ずれて"],["偉大","いだい"],["な"],["者","もの"],["と"],["された"],["。"]]},{"verse":2,"text":"ソロモンは全イスラエル、千人隊、百人隊の長、さばきつかさ、および一族のかしらである、全イスラエルの上に立つ者すべてに向かって語り、","tok":[["ソロモン"],["は"],["全","ぜん"],["イスラエル"],["、"],["千人隊","せんにんたい"],["、"],["百人隊","ひゃくにんたい"],["の"],["長","ちょう"],["、"],["さばきつ"],["か"],["さ"],["、"],["および"],["一族","いちぞく"],["の"],["かしら"],["で"],["ある"],["、"],["全","ぜん"],["イスラエル"],["の"],["上","うえ"],["に"],["立つ","たつ"],["者","もの"],["すべて"],["に"],["向かって","むかって"],["語り","かたり"],["、"]]},{"verse":3,"text":"ソロモンおよび彼とともにいた全集団はギブオンにある高き所に行った。そこには、主のしもべモーセが荒野で造った神の会見の天幕があったからである。","tok":[["ソロモン"],["および"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["全","ぜん"],["集団","しゅうだん"],["は"],["ギブオン"],["に"],["ある"],["高き","たかき"],["所","ところ"],["に"],["行った","いった"],["。"],["そこ"],["に"],["は"],["、"],["主","ぬし"],["の"],["しもべ"],["モーセ"],["が"],["荒野","あらの"],["で"],["造った","つくった"],["神","かみ"],["の"],["会見","かいけん"],["の"],["天幕","てんまく"],["が"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"――しかし、神の箱については、ダビデはこれをキルヤテ・エアリムから、ダビデがそのために定めておいた場所に運び上らせた。箱のために天幕をエルサレムに張っておいたからである――","tok":[["―"],["―"],["しかし"],["、"],["神","かみ"],["の"],["箱","ばこ"],["について"],["は"],["、"],["ダビデ"],["は"],["これ"],["を"],["キルヤテ"],["・"],["エアリム"],["から"],["、"],["ダビデ"],["が"],["その"],["ため"],["に"],["定めて","さだめて"],["おいた"],["場所","ばしょ"],["に"],["運び","はこび"],["上らせた","のぼらせた"],["。"],["箱","ばこ"],["の"],["ため"],["に"],["天幕","てんまく"],["を"],["エルサレム"],["に"],["張って","はって"],["おいた"],["から"],["で"],["ある"],["―"],["―"]]},{"verse":5,"text":"また、フルの子ウリの子のベツァルエルが造った青銅の祭壇を主の幕屋の前に置き、ソロモンと会衆は主に求めた。","tok":[["また"],["、"],["フル"],["の"],["子","こ"],["ウリ"],["の"],["子","こ"],["の"],["ベツァルエル"],["が"],["造った","つくった"],["青銅","せいどう"],["の"],["祭壇","さいだん"],["を"],["主","ぬし"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["に"],["置き","おき"],["、"],["ソロモン"],["と"],["会衆","かいしゅう"],["は"],["主に","おもに"],["求めた","もとめた"],["。"]]},{"verse":6,"text":"ソロモンはその所で主の前にある青銅の祭壇の上に――その壇は会見の天幕の所にあった――いけにえをささげた。すなわち、その上で一千頭の全焼のいけにえをささげた。","tok":[["ソロモン"],["は"],["その"],["所","ところ"],["で"],["主","ぬし"],["の"],["前","まえ"],["に"],["ある"],["青銅","せいどう"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["―"],["―"],["その"],["壇","だん"],["は"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["所","ところ"],["に"],["あった"],["―"],["―"],["いけにえ"],["を"],["ささげた"],["。"],["すなわち"],["、"],["その"],["上","うえ"],["で"],["一千頭","いちせんとう"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":7,"text":"その夜、神がソロモンに現れて、彼に仰せられた。「あなたに何を与えようか。願え。」","tok":[["その"],["夜","よる"],["、"],["神","かみ"],["が"],["ソロモン"],["に"],["現れて","あらわれて"],["、"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["に"],["何","なん"],["を"],["与えよう","あたえよう"],["か"],["。"],["願え","ねがえ"],["。"],["」"]]},{"verse":8,"text":"ソロモンは神に言った。「あなたは私の父ダビデに大いなる恵みを施されましたが、今度は父に代わって私を王とされました。","tok":[["ソロモン"],["は"],["神","かみ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["の"],["父","ちち"],["ダビデ"],["に"],["大いなる","おおいなる"],["恵み","めぐみ"],["を"],["施されました","ほどこされました"],["が"],["、"],["今度","こんど"],["は"],["父","ちち"],["に"],["代わって","かわって"],["私","わたくし"],["を"],["王","おう"],["と"],["されました"],["。"]]},{"verse":9,"text":"そこで今、神、主よ、私の父ダビデになさったあなたの約束を堅く守ってください。あなたは、地のちりのようにおびただしい民の上に、私を王とされたからです。","tok":[["そこ"],["で"],["今","いま"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["私","わたくし"],["の"],["父","ちち"],["ダビデ"],["に"],["なさった"],["あなた"],["の"],["約束","やくそく"],["を"],["堅く","かたく"],["守って","まもって"],["ください"],["。"],["あなた"],["は"],["、"],["地","ち"],["の"],["ちり"],["の"],["よう"],["に"],["おびただしい"],["民","たみ"],["の"],["上","うえ"],["に"],["、"],["私","わたくし"],["を"],["王","おう"],["と"],["された"],["から"],["です"],["。"]]},{"verse":10,"text":"今、知恵と知識を私に下さい。そうすれば、私はこの民の前に出はいりいたします。さもなければ、だれに、この大いなる、あなたの民をさばくことができましょうか。」","tok":[["今","いま"],["、"],["知恵","ちえ"],["と"],["知識","ちしき"],["を"],["私","わたくし"],["に"],["下さい","ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["は"],["この"],["民","たみ"],["の"],["前","まえ"],["に"],["出はいり","ではいり"],["いたします"],["。"],["さも"],["なければ"],["、"],["だれ"],["に"],["、"],["この"],["大いなる","おおいなる"],["、"],["あなた"],["の"],["民","たみ"],["を"],["さばく"],["こと"],["が"],["できましょう"],["か"],["。"],["」"]]},{"verse":11,"text":"神はソロモンに仰せられた。「そのようなことがあなたの心にあり、あなたが富をも、財宝をも、誉れをも、あなたを憎む者たちのいのちをも求めず、さらに長寿をも求めず、むしろ、わたしがあなたを立ててわたしの民の王とした、その民をさばくことができるようにと、自分のために知恵と知識を求めたので、","tok":[["神","かみ"],["は"],["ソロモン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["その"],["よう"],["な"],["こと"],["が"],["あなた"],["の"],["心","こころ"],["に"],["あり"],["、"],["あなた"],["が"],["富","とみ"],["を"],["も"],["、"],["財宝","ざいほう"],["を"],["も"],["、"],["誉れ","ほまれ"],["を"],["も"],["、"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["たち"],["の"],["いのち"],["を"],["も"],["求めず","もとめず"],["、"],["さらに"],["長寿","ちょうじゅ"],["を"],["も"],["求めず","もとめず"],["、"],["むしろ"],["、"],["わたし"],["が"],["あなた"],["を"],["立てて","たてて"],["わたし"],["の"],["民","たみ"],["の"],["王","おう"],["と"],["した"],["、"],["その"],["民","たみ"],["を"],["さばく"],["こと"],["が"],["できる"],["よう"],["に"],["と"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["知恵","ちえ"],["と"],["知識","ちしき"],["を"],["求めた","もとめた"],["ので"],["、"]]},{"verse":12,"text":"その知恵と知識とはあなたのものとなった。そのうえ、わたしはあなたの前の、また後の王たちにもないほどの富と財宝と誉れとをあなたに与えよう。」","tok":[["その"],["知恵","ちえ"],["と"],["知識","ちしき"],["と"],["は"],["あなた"],["の"],["もの"],["と"],["なった"],["。"],["その"],["うえ"],["、"],["わたし"],["は"],["あなた"],["の"],["前","まえ"],["の"],["、"],["また"],["後","あと"],["の"],["王","おう"],["たち"],["に"],["も"],["ない"],["ほど"],["の"],["富","とみ"],["と"],["財宝","ざいほう"],["と"],["誉れ","ほまれ"],["と"],["を"],["あなた"],["に"],["与えよう","あたえよう"],["。"],["」"]]},{"verse":13,"text":"こうして、ソロモンはギブオンにある高き所から出て行き、会見の天幕の前を去ってエルサレムに行き、イスラエルの王となった。","tok":[["こう"],["して"],["、"],["ソロモン"],["は"],["ギブオン"],["に"],["ある"],["高き","たかき"],["所","ところ"],["から"],["出て","でて"],["行き","いき"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["の"],["前","まえ"],["を"],["去って","さって"],["エルサレム"],["に"],["行き","いき"],["、"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["。"]]},{"verse":14,"text":"ソロモンは戦車と騎兵を集めたが、戦車一千四百台と、騎兵一万二千人が彼のもとに集まった。そこで、彼はこれらを戦車の町々に配置し、また、エルサレムの王のもとにも置いた。","tok":[["ソロモン"],["は"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["を"],["集めた","あつめた"],["が"],["、"],["戦車","せんしゃ"],["一千四百","いちせんよんひゃく"],["台","だい"],["と"],["、"],["騎兵","きへい"],["一万二千","いちまんにせん"],["人","にん"],["が"],["彼","かれ"],["の"],["もと"],["に"],["集まった","あつまった"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["は"],["これ"],["ら"],["を"],["戦車","せんしゃ"],["の"],["町々","まちまち"],["に"],["配置","はいち"],["し"],["、"],["また"],["、"],["エルサレム"],["の"],["王","おう"],["の"],["もと"],["に"],["も"],["置いた","おいた"],["。"]]},{"verse":15,"text":"王は銀と金とをエルサレムで石のように用い、杉の木を低地のいちじく桑の木のように大量に用いた。","tok":[["王","おう"],["は"],["銀","ぎん"],["と"],["金","かね"],["と"],["を"],["エルサレム"],["で"],["石","いし"],["の"],["よう"],["に"],["用い","もちい"],["、"],["杉","すぎ"],["の"],["木","き"],["を"],["低地","ていち"],["の"],["いちじく"],["桑","くわ"],["の"],["木","き"],["の"],["よう"],["に"],["大量","たいりょう"],["に"],["用いた","もちいた"],["。"]]},{"verse":16,"text":"ソロモンの所有していた馬は、エジプトとケベの輸出品であった。それは王の御用達が代価を払って、ケベから手に入れたものであった。","tok":[["ソロモン"],["の"],["所有","しょゆう"],["して"],["いた"],["馬","うま"],["は"],["、"],["エジプト"],["と"],["ケベ"],["の"],["輸出品","ゆしゅつひん"],["で"],["あった"],["。"],["それ"],["は"],["王","おう"],["の"],["御用達","ごようたし"],["が"],["代価","だいか"],["を"],["払って","はらって"],["、"],["ケベ"],["から"],["手","て"],["に"],["入れた","いれた"],["もの"],["で"],["あった"],["。"]]},{"verse":17,"text":"彼らはエジプトから、戦車を銀六百、馬を銀百五十で買い上げ、輸入していた。同様に、ヘテ人のすべての王も、アラムの王たちも、彼らの仲買で輸入した。","tok":[["彼","かれ"],["ら"],["は"],["エジプト"],["から"],["、"],["戦車","せんしゃ"],["を"],["銀","ぎん"],["六百","ろくひゃく"],["、"],["馬","うま"],["を"],["銀","ぎん"],["百五十","ひゃくごじゅう"],["で"],["買い上げ","かいあげ"],["、"],["輸入","ゆにゅう"],["して"],["いた"],["。"],["同様","どうよう"],["に"],["、"],["ヘテ人","へてにん"],["の"],["すべて"],["の"],["王","おう"],["も"],["、"],["アラム"],["の"],["王","おう"],["たち"],["も"],["、"],["彼","かれ"],["ら"],["の"],["仲買","なかがい"],["で"],["輸入","ゆにゅう"],["した"],["。"]]}]
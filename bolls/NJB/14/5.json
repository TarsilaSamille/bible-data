[{"verse":1,"text":"こうして、ソロモンが主の宮のためにしたすべての工事が完成した。そこで、ソロモンは父ダビデが聖別した物、すなわち、銀、金、各種の器具類を運び入れ、神の宮の宝物倉に納めた。","tok":[["こう"],["して"],["、"],["ソロモン"],["が"],["主","ぬし"],["の"],["宮","みや"],["の"],["ため"],["に"],["した"],["すべて"],["の"],["工事","こうじ"],["が"],["完成","かんせい"],["した"],["。"],["そこ"],["で"],["、"],["ソロモン"],["は"],["父","ちち"],["ダビデ"],["が"],["聖別","せいべつ"],["した"],["物","もの"],["、"],["すなわち"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["各種","かくしゅ"],["の"],["器具類","きぐるい"],["を"],["運び入れ","はこびいれ"],["、"],["神","かみ"],["の"],["宮","みや"],["の"],["宝物倉","ほうもつそう"],["に"],["納めた","おさめた"],["。"]]},{"verse":2,"text":"そのとき、ソロモンはイスラエルの長老たち、およびイスラエル人の部族のかしらたちと一族の長たちをすべて、エルサレムに召集した。ダビデの町シオンから主の契約の箱を運び上るためであった。","tok":[["その"],["とき"],["、"],["ソロモン"],["は"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["、"],["および"],["イスラエル"],["人","にん"],["の"],["部族","ぶぞく"],["の"],["かしら"],["たち"],["と"],["一族","いちぞく"],["の"],["長","なが"],["たち"],["を"],["すべて"],["、"],["エルサレム"],["に"],["召集","しょうしゅう"],["した"],["。"],["ダビデ"],["の"],["町","まち"],["シオン"],["から"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["運び","はこび"],["上る","のぼる"],["ため"],["で"],["あった"],["。"]]},{"verse":3,"text":"イスラエルのすべての人々は、第七の新月の祭りに王のもとに集まった。","tok":[["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["は"],["、"],["第","だい"],["七","なな"],["の"],["新月","しんげつ"],["の"],["祭り","まつり"],["に"],["王","おう"],["の"],["もと"],["に"],["集まった","あつまった"],["。"]]},{"verse":4,"text":"こうして、イスラエルの長老全員が到着したところで、レビ人たちは箱をにない、","tok":[["こう"],["して"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["全員","ぜんいん"],["が"],["到着","とうちゃく"],["した"],["ところ"],["で"],["、"],["レビ人","れびにん"],["たち"],["は"],["箱","ばこ"],["を"],["にない"],["、"]]},{"verse":5,"text":"箱と会見の天幕と天幕にあったすべての聖なる用具とを運び上った。これらのものを祭司たち、レビ人たちが運び上った。","tok":[["箱","ばこ"],["と"],["会見","かいけん"],["の"],["天幕","てんまく"],["と"],["天幕","てんまく"],["に"],["あった"],["すべて"],["の"],["聖","せい"],["なる"],["用具","ようぐ"],["と"],["を"],["運び","はこび"],["上った","のぼった"],["。"],["これ"],["ら"],["の"],["もの"],["を"],["祭司","さいし"],["たち"],["、"],["レビ人","れびにん"],["たち"],["が"],["運び","はこび"],["上った","のぼった"],["。"]]},{"verse":6,"text":"ソロモン王と彼のところに集まったイスラエルの全会衆は、箱の前に行き、羊や牛の群れをいけにえとしてささげたが、その数があまりに多くて数えることも調べることもできなかった。","tok":[["ソロモン"],["王","おう"],["と"],["彼","かれ"],["の"],["ところ"],["に"],["集まった","あつまった"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["箱","ばこ"],["の"],["前","まえ"],["に"],["行き","いき"],["、"],["羊","ひつじ"],["や"],["牛","うし"],["の"],["群れ","むれ"],["を"],["いけにえ"],["として"],["ささげた"],["が"],["、"],["その"],["数","かず"],["が"],["あまり"],["に"],["多くて","おおくて"],["数える","かぞえる"],["こと"],["も"],["調べる","しらべる"],["こと"],["も"],["できなかった"],["。"]]},{"verse":7,"text":"それから、祭司たちは主の契約の箱を、定めの場所、すなわち神殿の内堂である至聖所のケルビムの翼の下に運び入れた。","tok":[["それ"],["から"],["、"],["祭司","さいし"],["たち"],["は"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["、"],["定め","さだめ"],["の"],["場所","ばしょ"],["、"],["すなわち"],["神殿","しんでん"],["の"],["内堂","うちどう"],["で"],["ある"],["至聖所","しせいしょ"],["の"],["ケルビム"],["の"],["翼","つばさ"],["の"],["下","した"],["に"],["運び入れた","はこびいれた"],["。"]]},{"verse":8,"text":"ケルビムは箱の所の上に翼を広げた。ケルビムは箱とそのかつぎ棒とを上からおおった。","tok":[["ケルビム"],["は"],["箱","ばこ"],["の"],["所","ところ"],["の"],["上","うえ"],["に"],["翼","つばさ"],["を"],["広げた","ひろげた"],["。"],["ケルビム"],["は"],["箱","ばこ"],["と"],["その"],["かつぎ棒","かつぎぼう"],["と"],["を"],["上","うえ"],["から"],["おおった"],["。"]]},{"verse":9,"text":"そのかつぎ棒は長かったので、棒の先が内堂の前の聖所から見えていたが、外からは見えなかった。それは、今日までそこにある。","tok":[["その"],["かつぎ棒","かつぎぼう"],["は"],["長かった","ながかった"],["ので"],["、"],["棒","ぼう"],["の"],["先","さき"],["が"],["内","ない"],["堂","どう"],["の"],["前","まえ"],["の"],["聖","せい"],["所","しょ"],["から"],["見えて","みえて"],["いた"],["が"],["、"],["外","そと"],["から"],["は"],["見えなかった","みえなかった"],["。"],["それ"],["は"],["、"],["今日","きょう"],["まで"],["そこ"],["に"],["ある"],["。"]]},{"verse":10,"text":"箱の中には、二枚の板のほかには何も入っていなかった。これは、イスラエル人がエジプトから出て来たとき、主が彼らと契約を結ばれたときに、モーセがホレブで入れたものである。","tok":[["箱","ばこ"],["の"],["中","なか"],["に"],["は"],["、"],["二枚","にまい"],["の"],["板","いた"],["の"],["ほか"],["に"],["は"],["何","なん"],["も"],["入って","はいって"],["いなかった"],["。"],["これ"],["は"],["、"],["イスラエル"],["人","にん"],["が"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["とき"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["結ばれた","むすばれた"],["とき"],["に"],["、"],["モーセ"],["が"],["ホレブ"],["で"],["入れた","いれた"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"祭司たちが聖所から出て来たとき、――列席したすべての祭司が各組の務めの順序にかかわらず身を聖別した。","tok":[["祭司","さいし"],["たち"],["が"],["聖","せい"],["所","しょ"],["から"],["出て","でて"],["来た","きた"],["とき"],["、"],["―"],["―"],["列席","れっせき"],["した"],["すべて"],["の"],["祭司","さいし"],["が"],["各","かく"],["組","くみ"],["の"],["務め","つとめ"],["の"],["順序","じゅんじょ"],["に"],["かかわらず"],["身","み"],["を"],["聖別","せいべつ"],["した"],["。"]]},{"verse":12,"text":"また、歌うたいであるレビ人全員も、すなわち、アサフもヘマンもエドトンも彼らの子らも彼らの兄弟たちも、白亜麻布を身にまとい、シンバル、十弦の琴および立琴を手にして、祭壇の東側に立ち、百二十人の祭司たちも彼らとともにいて、ラッパを吹き鳴らしていた――","tok":[["また"],["、"],["歌うたい","うたうたい"],["で"],["ある"],["レビ人","れびにん"],["全員","ぜんいん"],["も"],["、"],["すなわち"],["、"],["アサフ"],["も"],["ヘマン"],["も"],["エドトン"],["も"],["彼","かれ"],["ら"],["の"],["子","こ"],["ら"],["も"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["たち"],["も"],["、"],["白亜","はくあ"],["麻布","あざぶ"],["を"],["身","み"],["に"],["まとい"],["、"],["シンバル"],["、"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["および"],["立琴","たてごと"],["を"],["手","て"],["に"],["して"],["、"],["祭壇","さいだん"],["の"],["東側","ひがしがわ"],["に"],["立ち","たち"],["、"],["百二","ひゃくに"],["十人","じゅうにん"],["の"],["祭司","さいし"],["たち"],["も"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["いて"],["、"],["ラッパ"],["を"],["吹き鳴らして","ふきならして"],["いた"],["―"],["―"]]},{"verse":13,"text":"ラッパを吹き鳴らす者、歌うたいたちが、まるでひとりででもあるかのように一致して歌声を響かせ、主を賛美し、ほめたたえた。そして、ラッパとシンバルとさまざまの楽器をかなでて声をあげ、「主はまことにいつくしみ深い。その恵みはとこしえまで」と主に向かって賛美した。そのとき、その宮、すなわち主の宮は雲で満ちた。","tok":[["ラッパ"],["を"],["吹き鳴らす","ふきならす"],["者","もの"],["、"],["歌うたい","うたうたい"],["たち"],["が"],["、"],["まるで"],["ひとり"],["で"],["で"],["も"],["ある"],["か"],["の"],["よう"],["に"],["一致","いっち"],["して"],["歌声","うたごえ"],["を"],["響かせ","ひびかせ"],["、"],["主","ぬし"],["を"],["賛美","さんび"],["し"],["、"],["ほめたたえた"],["。"],["そして"],["、"],["ラッパ"],["と"],["シンバル"],["と"],["さまざま"],["の"],["楽器","がっき"],["を"],["かなでて"],["声","こえ"],["を"],["あげ"],["、"],["「"],["主","ぬし"],["は"],["まこと"],["に"],["いつくしみ"],["深い","ぶかい"],["。"],["その"],["恵み","めぐみ"],["は"],["とこしえ"],["まで"],["」"],["と"],["主","ぬし"],["に"],["向かって","むかって"],["賛美","さんび"],["した"],["。"],["その"],["とき"],["、"],["その"],["宮","みや"],["、"],["すなわち"],["主","ぬし"],["の"],["宮","みや"],["は"],["雲","くも"],["で"],["満ちた","みちた"],["。"]]},{"verse":14,"text":"祭司たちは、その雲にさえぎられ、そこに立って仕えることができなかった。主の栄光が神の宮に満ちたからである。","tok":[["祭司","さいし"],["たち"],["は"],["、"],["その"],["雲","くも"],["に"],["さえぎられ"],["、"],["そこ"],["に"],["立って","たって"],["仕える","つかえる"],["こと"],["が"],["できなかった"],["。"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["神","かみ"],["の"],["宮","みや"],["に"],["満ちた","みちた"],["から"],["で"],["ある"],["。"]]}]
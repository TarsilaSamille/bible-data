[{"verse":1,"text":"ソロモンが主の宮と自分の宮殿を二十年かかって建て終わったとき、","tok":[["ソロモン"],["が"],["主","ぬし"],["の"],["宮","みや"],["と"],["自分","じぶん"],["の"],["宮殿","きゅうでん"],["を"],["二十","にじゅう"],["年","ねん"],["かかって"],["建て","たて"],["終わった","おわった"],["とき"],["、"]]},{"verse":2,"text":"ソロモンは、フラムがソロモンに返した町々を建て直し、そこにイスラエル人を住ませた。","tok":[["ソロモン"],["は"],["、"],["フラム"],["が"],["ソロモン"],["に"],["返した","かえした"],["町々","まちまち"],["を"],["建て直し","たてなおし"],["、"],["そこ"],["に"],["イスラエル"],["人","にん"],["を"],["住ませた","すませた"],["。"]]},{"verse":3,"text":"ソロモンはハマテ・ツォバに出て行き、これに打ち勝った。","tok":[["ソロモン"],["は"],["ハマテ"],["・"],["ツォバ"],["に"],["出て","でて"],["行き","いき"],["、"],["これ"],["に"],["打ち勝った","うちかった"],["。"]]},{"verse":4,"text":"ついで、彼は荒野にタデモルを建て、倉庫の町々はすべて、これをハマテに建てた。","tok":[["つい"],["で"],["、"],["彼","かれ"],["は"],["荒野","こうや"],["に"],["タデモル"],["を"],["建て","たて"],["、"],["倉庫","そうこ"],["の"],["町々","まちまち"],["は"],["すべて"],["、"],["これ"],["を"],["ハマテ"],["に"],["建てた","たてた"],["。"]]},{"verse":5,"text":"さらに、彼は上ベテ・ホロンと下ベテ・ホロンを建てた。これは、城壁と門とかんぬきのある防備の町々であった。","tok":[["さらに"],["、"],["彼","かれ"],["は"],["上","うえ"],["ベテ"],["・"],["ホロン"],["と"],["下","した"],["ベテ"],["・"],["ホロン"],["を"],["建てた","たてた"],["。"],["これ"],["は"],["、"],["城壁","じょうへき"],["と"],["門","もん"],["と"],["かんぬき"],["の"],["ある"],["防備","ぼうび"],["の"],["町々","まちまち"],["で"],["あった"],["。"]]},{"verse":6,"text":"バアラテ、およびソロモンの所有のすべての倉庫の町々、戦車のためのすべての町々、騎兵のための町々、ソロモンがエルサレムや、レバノンや、すべての領地に建てたいと切に願っていたものすべてを彼は建設した。","tok":[["バアラテ"],["、"],["および"],["ソロモン"],["の"],["所有","しょゆう"],["の"],["すべて"],["の"],["倉庫","そうこ"],["の"],["町々","まちまち"],["、"],["戦車","せんしゃ"],["の"],["ため"],["の"],["すべて"],["の"],["町々","まちまち"],["、"],["騎兵","きへい"],["の"],["ため"],["の"],["町々","まちまち"],["、"],["ソロモン"],["が"],["エルサレム"],["や"],["、"],["レバノン"],["や"],["、"],["すべて"],["の"],["領地","りょうち"],["に"],["建てたい","たてたい"],["と"],["切に","せつに"],["願って","ねがって"],["いた"],["もの"],["すべて"],["を"],["彼","かれ"],["は"],["建設","けんせつ"],["した"],["。"]]},{"verse":7,"text":"イスラエルの出でないヘテ人、エモリ人、ペリジ人、ヒビ人、エブス人の生き残りの民全員、","tok":[["イスラエル"],["の"],["出でない","いでない"],["ヘテ人","へてにん"],["、"],["エモリ人","えもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["生き残り","いきのこり"],["の"],["民","みん"],["全員","ぜんいん"],["、"]]},{"verse":8,"text":"すなわち、イスラエル人が滅ぼし尽くさなかった人々の跡を継いでこの地に生き残った彼らの子孫に当たる人々を、ソロモンは苦役に徴用した。今日もそうである。","tok":[["すなわち"],["、"],["イスラエル"],["人","にん"],["が"],["滅ぼし","ほろぼし"],["尽くさなかった","つくさなかった"],["人々","ひとびと"],["の"],["跡","あと"],["を"],["継いで","ついで"],["この"],["地","ち"],["に"],["生き残った","いきのこった"],["彼","かれ"],["ら"],["の"],["子孫","しそん"],["に"],["当たる","あたる"],["人々","ひとびと"],["を"],["、"],["ソロモン"],["は"],["苦役","くえき"],["に"],["徴用","ちょうよう"],["した"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":9,"text":"しかし、ソロモンはイスラエル人を自分の仕事をさせる奴隷にはしなかった。彼らは戦士であり、彼の補佐官の長であり、戦車隊と騎兵隊の長であったからである。","tok":[["しかし"],["、"],["ソロモン"],["は"],["イスラエル"],["人","にん"],["を"],["自分","じぶん"],["の"],["仕事","しごと"],["を"],["させる"],["奴隷","どれい"],["に"],["は"],["しなかった"],["。"],["彼","かれ"],["ら"],["は"],["戦士","せんし"],["で"],["あり"],["、"],["彼","かれ"],["の"],["補佐官","ほさかん"],["の"],["長","ちょう"],["で"],["あり"],["、"],["戦車隊","せんしゃたい"],["と"],["騎兵隊","きへいたい"],["の"],["長","ちょう"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"また、ソロモン王に属する者で、監督をする者の長は二百五十人であって、民を指揮していた。","tok":[["また"],["、"],["ソロモン"],["王","おう"],["に"],["属する","ぞくする"],["者","もの"],["で"],["、"],["監督","かんとく"],["を"],["する"],["者","もの"],["の"],["長","ちょう"],["は"],["二百五","にひゃくご"],["十人","じゅうにん"],["で"],["あって"],["、"],["民","みん"],["を"],["指揮","しき"],["して"],["いた"],["。"]]},{"verse":11,"text":"ソロモンはパロの娘を、ダビデの町から彼女のために建てた家に連れて上った。「私の妻はイスラエルの王ダビデの家に住んではならない。主の箱を迎え入れた所は聖なる所だからである」と彼が言ったからである。","tok":[["ソロモン"],["は"],["パロ"],["の"],["娘","むすめ"],["を"],["、"],["ダビデ"],["の"],["町","まち"],["から"],["彼女","かのじょ"],["の"],["ため"],["に"],["建てた","たてた"],["家","いえ"],["に"],["連れて","つれて"],["上った","のぼった"],["。"],["「"],["私","わたくし"],["の"],["妻","つま"],["は"],["イスラエル"],["の"],["王","おう"],["ダビデ"],["の"],["家","いえ"],["に"],["住んで","すんで"],["は"],["ならない"],["。"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["迎え入れた","むかえいれた"],["所","ところ"],["は"],["聖","せい"],["なる"],["所","ところ"],["だ"],["から"],["で"],["ある"],["」"],["と"],["彼","かれ"],["が"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"それから、ソロモンは、彼が玄関の前に建て
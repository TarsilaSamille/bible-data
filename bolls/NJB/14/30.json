[{"verse":1,"text":"さて、ヒゼキヤは全イスラエルとユダに使いを遣わし、またエフライムとマナセに手紙を書いて、エルサレムにある主の宮に来て、イスラエルの神、主に過越のいけにえをささげるよう呼びかけた。","tok":[["さて"],["、"],["ヒゼキヤ"],["は"],["全","ぜん"],["イスラエル"],["と"],["ユダ"],["に"],["使い","つかい"],["を"],["遣わし","つかわし"],["、"],["また"],["エフライム"],["と"],["マナセ"],["に"],["手紙","てがみ"],["を"],["書いて","かいて"],["、"],["エルサレム"],["に"],["ある"],["主","ぬし"],["の"],["宮","みや"],["に"],["来て","きて"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげる"],["よう"],["呼びかけた","よびかけた"],["。"]]},{"verse":2,"text":"王とそのつかさたちとエルサレムの全集団は、第二の月に過越のいけにえをささげようと決議した。","tok":[["王","おう"],["と"],["その"],["つかさ"],["たち"],["と"],["エルサレム"],["の"],["全","ぜん"],["集団","しゅうだん"],["は"],["、"],["第","だい"],["二","に"],["の"],["月","つき"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげよう"],["と"],["決議","けつぎ"],["した"],["。"]]},{"verse":3,"text":"というのは、身を聖別した祭司たちは十分な数に達しておらず、民もエルサレムに集まっていなかったので、そのときには、ささげることができなかったからである。","tok":[["と"],["いう"],["の"],["は"],["、"],["身","み"],["を"],["聖別","せいべつ"],["した"],["祭司","さいし"],["たち"],["は"],["十分","じゅうぶん"],["な"],["数","かず"],["に"],["達して","たっして"],["おらず"],["、"],["民","みん"],["も"],["エルサレム"],["に"],["集まって","あつまって"],["いなかった"],["ので"],["、"],["その"],["とき"],["に"],["は"],["、"],["ささげる"],["こと"],["が"],["できなかった"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"こうして、王と、全集団がこれを正しいと見たので、","tok":[["こう"],["して"],["、"],["王","おう"],["と"],["、"],["全","ぜん"],["集団","しゅうだん"],["が"],["これ"],["を"],["正しい","ただしい"],["と"],["見た","みた"],["ので"],["、"]]},{"verse":5,"text":"彼らはベエル・シェバからダンに至るまで、全イスラエルにおふれを出し、上って来て、エルサレムでイスラエルの神、主に過越のいけにえをささげるよう呼びかけることに決定した。しるされているとおりにささげる者が、多くはいなかったからである。","tok":[["彼","かれ"],["ら"],["は"],["ベエル"],["・"],["シェバ"],["から"],["ダン"],["に"],["至る","いたる"],["まで"],["、"],["全","ぜん"],["イスラエル"],["に"],["おふれ"],["を"],["出し","だし"],["、"],["上って","のぼって"],["来て","きて"],["、"],["エルサレム"],["で"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげる"],["よう"],["呼びかける","よびかける"],["こと"],["に"],["決定","けってい"],["した"],["。"],["しるされて"],["いる"],["とおり"],["に"],["ささげる"],["者","もの"],["が"],["、"],["多く","おおく"],["は"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"そこで、近衛兵は、王とそのつかさたちの手紙を携えて、イスラエルとユダの全土を行き巡り、王の命令のとおりに言った。「イスラエルの人たちよ。アブラハム、イサク、イスラエルの神、主に立ち返りなさい。そうすれば、主は、あなたがたに残された、アッシリヤの王たちの手をのがれた者たちのところに、帰って来てくださいます。","tok":[["そこ"],["で"],["、"],["近衛兵","このえへい"],["は"],["、"],["王","おう"],["と"],["その"],["つかさ"],["たち"],["の"],["手紙","てがみ"],["を"],["携えて","たずさえて"],["、"],["イスラエル"],["と"],["ユダ"],["の"],["全土","ぜんど"],["を"],["行き","いき"],["巡り","めぐり"],["、"],["王","おう"],["の"],["命令","めいれい"],["の"],["とおり"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["人","ひと"],["たち"],["よ"],["。"],["アブラハム"],["、"],["イサク"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["立ち返り","たちかえり"],["なさい"],["。"],["そう"],["すれば"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["に"],["残された","のこされた"],["、"],["アッシリヤ"],["の"],["王","おう"],["たち"],["の"],["手","て"],["を"],["のがれた"],["者","もの"],["たち"],["の"],["ところ"],["に"],["、"],["帰って","かえって"],["来て","きて"],["くださいます"],["。"]]},{"verse":7,"text":"あなたがたは、父祖の神、主に対して不信の罪を犯したあなたがたの父たち、兄弟たちのようになってはいけません。あなたがたが自分の目で見ているとおり、主は彼らを恐怖に渡されたのです。","tok":[["あなた"],["がた"],["は"],["、"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主に","おもに"],["対して","たいして"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["あなた"],["がた"],["の"],["父","ちち"],["たち"],["、"],["兄弟","きょうだい"],["たち"],["の"],["よう"],["に"],["なって"],["は"],["いけません"],["。"],["あなた"],["がた"],["が"],["自分","じぶん"],["の"],["目","め"],["で"],["見て","みて"],["いる"],["とおり"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["恐怖","きょうふ"],["に"],["渡された","わたされた"],["の"],["です"],["。"]]},{"verse":8,"text":"今、あなたがたは、自分の父たちのようにうなじのこわい者であってはなりません。主に服従しなさい。主がとこしえに聖別された聖所に入り、あなたがたの神、主に仕えなさい。そうすれば、主の燃える怒りがあなたがたから離れるでしょう。","tok":[["今","いま"],["、"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["の"],["父","ちち"],["たち"],["の"],["よう"],["に"],["うなじ"],["の"],["こわい"],["者","もの"],["で"],["あって"],["は"],["なりません"],["。"],["主に","おもに"],["服従","ふくじゅう"],["し"],["なさい"],["。"],["主","ぬし"],["が"],["とこしえ"],["に"],["聖別","せいべつ"],["された"],["聖所","しょうしょ"],["に"],["入り","はいり"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"],["そう"],["すれば"],["、"],["主","ぬし"],["の"],["燃える","もえる"],["怒り","いかり"],["が"],["あなた"],["がた"],["から"],["離れるでしょう","はなれるでしょう"],["。"]]},{"verse":9,"text":"あなたがたが主に立ち返るなら、あなたがたの兄弟や子たちは、彼らをとりこにした人々のあわれみを受け、この地に帰って来るでしょう。あなたがたの神、主は、情け深く、あわれみ深い方であり、もし、あなたがたが主に立ち返るなら、あなたがたから御顔をそむけるようなことは決してなさいません。」","tok":[["あなた"],["がた"],["が"],["主に","おもに"],["立ち返るなら","たちかえるなら"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["や"],["子","こ"],["たち"],["は"],["、"],["彼","かれ"],["ら"],["を"],["とりこ"],["に"],["した"],["人々","ひとびと"],["の"],["あわれみ"],["を"],["受け","うけ"],["、"],["この"],["地","ち"],["に"],["帰って","かえって"],["来るでしょう","くるでしょう"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["情け深く","なさけぶかく"],["、"],["あわれみ"],["深い","ふかい"],["方","ほう"],["で"],["あり"],["、"],["もし"],["、"],["あなた"],["がた"],["が"],["主に","おもに"],["立ち返るなら","たちかえるなら"],["、"],["あなた"],["がた"],["から"],["御顔","おかお"],["を"],["そむける"],["よう"],["な"],["こと"],["は"],["決して","けっして"],["なさいません"],["。"],["」"]]},{"verse":10,"text":"こうして、近衛兵は、エフライムとマナセから、ゼブルンの地に至るまで、町から町へと行き巡ったが、人々は彼らを物笑いにし、あざけった。","tok":[["こう"],["して"],["、"],["近衛兵","このえへい"],["は"],["、"],["エフライム"],["と"],["マナセ"],["から"],["、"],["ゼブルン"],["の"],["地","ち"],["に"],["至る","いたる"],["まで"],["、"],["町","まち"],["から"],["町","まち"],["へ"],["と"],["行き","いき"],["巡った","めぐった"],["が"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["を"],["物笑い","ものわらい"],["に"],["し"],["、"],["あざけった"],["。"]]},{"verse":11,"text":"ただ、アシェル、マナセおよびゼブルンのある人々はへりくだって、エルサレムに上って来た。","tok":[["ただ"],["、"],["アシェル"],["、"],["マナセ"],["および"],["ゼブルン"],["の"],["ある"],["人々","ひとびと"],["は"],["へりくだって"],["、"],["エルサレム"],["に"],["上って","のぼって"],["来た","きた"],["。"]]},{"verse":12,"text":"また、ユダには、神の御手が臨み、人々は心を一つにして、主のことばのとおりに王とそのつかさたちの命令を行った。","tok":[["また"],["、"],["ユダ"],["に"],["は"],["、"],["神","かみ"],["の"],["御手","おて"],["が"],["臨み","のぞみ"],["、"],["人々","ひとびと"],["は"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["して"],["、"],["主","ぬし"],["の"],["ことば"],["の"],["とおり"],["に"],["王","おう"],["と"],["その"],["つかさ"],["たち"],["の"],["命令","めいれい"],["を"],["行った","おこなった"],["。"]]},{"verse":13,"text":"こうして、多くの民が第二の月に、種を入れないパンの祭りを行おうとエルサレムに集まった。おびただしい大集団であった。","tok":[["こう"],["して"],["、"],["多く","おおく"],["の"],["民","たみ"],["が"],["第","だい"],["二","に"],["の"],["月","つき"],["に"],["、"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["の"],["祭り","まつり"],["を"],["行おう","おこなおう"],["と"],["エルサレム"],["に"],["集まった","あつまった"],["。"],["おびただしい"],["大","だい"],["集団","しゅうだん"],["で"],["あった"],["。"]]},{"verse":14,"text":"彼らは立ち上がり、エルサレムにあった祭壇を取り除き、すべての香の壇を取り除いて、キデロン川に投げ捨てた。","tok":[["彼","かれ"],["ら"],["は"],["立ち上がり","たちあがり"],["、"],["エルサレム"],["に"],["あった"],["祭壇","さいだん"],["を"],["取り除き","とりのぞき"],["、"],["すべて"],["の"],["香","こう"],["の"],["壇","だん"],["を"],["取り除いて","とりのぞいて"],["、"],["キデロン"],["川","かわ"],["に"],["投げ捨てた","なげすてた"],["。"]]},{"verse":15,"text":"そして、第二の月の十四日に、過越のいけにえをほふった。祭司とレビ人は恥じて身を聖別し、全焼のいけにえを主の宮に携えて来た。","tok":[["そして"],["、"],["第","だい"],["二","に"],["の"],["月","つき"],["の"],["十四日","じゅうよんか"],["に"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ほふった"],["。"],["祭司","さいし"],["と"],["レビ人","れびにん"],["は"],["恥じて","はじて"],["身","み"],["を"],["聖別","せいべつ"],["し"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["主","ぬし"],["の"],["宮","みや"],["に"],["携えて","たずさえて"],["来た","きた"],["。"]]},{"verse":16,"text":"彼らは、神の人モーセの律法に従って、おのおのその定めの場所に立った。祭司はレビ人の手から受け取った血を注いだ。","tok":[["彼","かれ"],["ら"],["は"],["、"],["神","かみ"],["の"],["人","ひと"],["モーセ"],["の"],["律法","りっぽう"],["に"],["従って","したがって"],["、"],["おのおの"],["その"],["定め","さだめ"],["の"],["場所","ばしょ"],["に"],["立った","たった"],["。"],["祭司","さいし"],["は"],["レビ人","れびにん"],["の"],["手","て"],["から"],["受け取った","うけとった"],["血","ち"],["を"],["注いだ","そそいだ"],["。"]]},{"verse":17,"text":"集団の中には、身を聖別していなかった者が多かったので、レビ人が、きよくないすべての人々のために、過越のいけにえをほふる役目につき、これを聖別して主にささげた。","tok":[["集団","しゅうだん"],["の"],["中","なか"],["に"],["は"],["、"],["身","み"],["を"],["聖別","せいべつ"],["して"],["いなかった"],["者","もの"],["が"],["多かった","おおかった"],["ので"],["、"],["レビ人","れびにん"],["が"],["、"],["きよく"],["ない"],["すべて"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ほふる"],["役目","やくめ"],["に"],["つき"],["、"],["これ"],["を"],["聖別","せいべつ"],["して"],["主に","おもに"],["ささげた"],["。"]]},{"verse":18,"text":"民のうち大ぜいの者、すなわち、エフライムとマナセ、イッサカルとゼブルンの多くの者は、身をきよめておらず、しかも、しるされているのと異なったやり方で、過越のいけにえを食べてしまったので、ヒゼキヤは、彼らのために祈って言った。「いつくしみ深い主よ。このことの贖いをしてください。","tok":[["民","みん"],["の"],["うち"],["大ぜい","おおぜい"],["の"],["者","もの"],["、"],["すなわち"],["、"],["エフライム"],["と"],["マナセ"],["、"],["イッサカル"],["と"],["ゼブルン"],["の"],["多く","おおく"],["の"],["者","もの"],["は"],["、"],["身","み"],["を"],["きよめて"],["おらず"],["、"],["しかも"],["、"],["しるされて"],["いる"],["の"],["と"],["異なった","ことなった"],["やり方","やりかた"],["で"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["食べて","たべて"],["しまった"],["ので"],["、"],["ヒゼキヤ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["祈って","いのって"],["言った","いった"],["。"],["「"],["いつくしみ"],["深い","ふかい"],["主","ぬし"],["よ"],["。"],["この"],["こと"],["の"],["贖い","あがない"],["を"],["して"],["ください"],["。"]]},{"verse":19,"text":"彼らは、心を定めて神、彼らの父祖の神、主を求めたのですが、聖なるもののきよめのとおりにはいたしませんでした。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["心","こころ"],["を"],["定めて","さだめて"],["神","かみ"],["、"],["彼","かれ"],["ら"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["求めた","もとめた"],["の"],["です"],["が"],["、"],["聖","せい"],["なる"],["もの"],["の"],["きよめ"],["の"],["とおり"],["に"],["は"],["いたしませんでした"],["。"],["」"]]},{"verse":20,"text":"主はヒゼキヤの願いを聞かれ、民をいやされた。","tok":[["主","ぬし"],["は"],["ヒゼキヤ"],["の"],["願い","ねがい"],["を"],["聞かれ","きかれ"],["、"],["民","みん"],["を"],["いやされた"],["。"]]},{"verse":21,"text":"こうして、エルサレムにいたイスラエル人は、大きな喜びをもって七日の間、種を入れないパンの祭りを行った。レビ人と祭司は、毎日、主に向かって強い調べの楽器をかなで、主をほめたたえた。","tok":[["こう"],["して"],["、"],["エルサレム"],["に"],["いた"],["イスラエル"],["人","にん"],["は"],["、"],["大きな","おおきな"],["喜び","よろこび"],["を"],["もって"],["七日","ななか"],["の"],["間","あいだ"],["、"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["の"],["祭り","まつり"],["を"],["行った","おこなった"],["。"],["レビ人","れびにん"],["と"],["祭司","さいし"],["は"],["、"],["毎日","まいにち"],["、"],["主に","おもに"],["向かって","むかって"],["強い","つよい"],["調べ","しらべ"],["の"],["楽器","がっき"],["を"],["かな"],["で"],["、"],["主","ぬし"],["を"],["ほめたたえた"],["。"]]},{"verse":22,"text":"ヒゼキヤは、主の務めによく通じているすべてのレビ人の心に語りかけた。そこで彼らは、和解のいけにえをささげ、彼らの父祖の神、主に告白をしつつ、七日間、祝いの食物にあずかった。","tok":[["ヒゼキヤ"],["は"],["、"],["主","ぬし"],["の"],["務め","つとめ"],["に"],["よく"],["通じて","つうじて"],["いる"],["すべて"],["の"],["レビ人","れびにん"],["の"],["心","こころ"],
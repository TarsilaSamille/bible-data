[{"verse":1,"text":"こうして、ヨシャパテには富と誉れとが豊かに与えられたが、彼はアハブと縁を結んだ。","tok":[["こう"],["して"],["、"],["ヨシャパテ"],["に"],["は"],["富","とみ"],["と"],["誉れ","ほまれ"],["と"],["が"],["豊か","ゆたか"],["に"],["与えられた","あたえられた"],["が"],["、"],["彼","かれ"],["は"],["アハブ"],["と"],["縁","えん"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":2,"text":"何年かたって後、彼が、サマリヤに下ってアハブのもとに行ったとき、アハブは彼および彼とともにいた民のために、おびただしい羊や牛の群れをほふったうえ、彼を誘い込んで、ラモテ・ギルアデに攻め上らせようとした。","tok":[["何","なん"],["年","ねん"],["かた"],["って"],["後","あと"],["、"],["彼","かれ"],["が"],["、"],["サマリヤ"],["に"],["下って","くだって"],["アハブ"],["の"],["もと"],["に"],["行った","いった"],["とき"],["、"],["アハブ"],["は"],["彼","かれ"],["および"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["民","たみ"],["の"],["ため"],["に"],["、"],["おびただしい"],["羊","ひつじ"],["や"],["牛","うし"],["の"],["群れ","むれ"],["を"],["ほふった"],["うえ"],["、"],["彼","かれ"],["を"],["誘い込んで","さそいこんで"],["、"],["ラモテ"],["・"],["ギルアデ"],["に"],["攻め上らせよう","せめのぼらせよう"],["と"],["した"],["。"]]},{"verse":3,"text":"そのとき、イスラエルの王アハブはユダの王ヨシャパテに言った。「私とともにラモテ・ギルアデに行ってくれませんか。」すると、彼は答えた。「私とあなたとは同じようなもの、私の民はあなたの民と同じようなものです。あなたとともに戦いに臨みましょう。」","tok":[["その"],["とき"],["、"],["イスラエル"],["の"],["王","おう"],["アハブ"],["は"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["と"],["とも"],["に"],["ラモテ"],["・"],["ギルアデ"],["に"],["行って","いって"],["くれません"],["か"],["。"],["」"],["する"],["と"],["、"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["と"],["あなた"],["と"],["は"],["同じ","おなじ"],["よう"],["な"],["もの"],["、"],["私","わたくし"],["の"],["民","たみ"],["は"],["あなた"],["の"],["民","たみ"],["と"],["同じ","おなじ"],["よう"],["な"],["もの"],["です"],["。"],["あなた"],["と"],["とも"],["に"],["戦い","たたかい"],["に"],["臨みましょう","のぞみましょう"],["。"],["」"]]},{"verse":4,"text":"ヨシャパテは、イスラエルの王に言った。「まず、主のことばを伺ってみてください。」","tok":[["ヨシャパテ"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["まず"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["伺って","うかがって"],["みて"],["ください"],["。"],["」"]]},{"verse":5,"text":"そこで、イスラエルの王は四百人の預言者を召し集めて、彼らに尋ねた。「私たちはラモテ・ギルアデに戦いに行くべきだろうか。それとも、私はやめるべきだろうか。」彼らは答えた。「上って行きなさい。そうすれば、神は王の手にこれを渡されます。」","tok":[["そこ"],["で"],["、"],["イスラエル"],["の"],["王","おう"],["は"],["四百人","よんひゃくにん"],["の"],["預言者","よげんしゃ"],["を"],["召し集めて","めしあつめて"],["、"],["彼","かれ"],["ら"],["に"],["尋ねた","たずねた"],["。"],["「"],["私たち","わたしたち"],["は"],["ラモテ"],["・"],["ギルアデ"],["に"],["戦い","たたかい"],["に"],["行くべきだろう","いくべきだろう"],["か"],["。"],["それ"],["と"],["も"],["、"],["私","わたくし"],["は"],["やめるべきだろう"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["上って","のぼって"],["行き","いき"],["なさい"],["。"],["そう"],["すれば"],["、"],["神","かみ"],["は"],["王","おう"],["の"],["手","て"],["に"],["これ"],["を"],["渡されます","わたされます"],["。"],["」"]]},{"verse":6,"text":"ところが、ヨシャパテは、「ここには、私たちがみこころを求めることのできる主の預言者がほかにいないのですか」と言った。","tok":[["ところ"],["が"],["、"],["ヨシャパテ"],["は"],["、"],["「"],["ここ"],["に"],["は"],["、"],["私たち","わたしたち"],["が"],["みこころ"],["を"],["求める","もとめる"],["こと"],["の"],["できる"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["が"],["ほか"],["に"],["いない"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"イスラエルの王はヨシャパテに答えた。「いや、ほかにもうひとり、私たちが主のみこころを求めることのできる者がいます。しかし、私は彼を憎んでいます。彼は私について、決して良いことは預言せず、いつも悪いことばかりを預言するからです。それは、イムラの子ミカヤです。」すると、ヨシャパテは言った。「王よ。そういうふうには言わないでください。」","tok":[["イスラエル"],["の"],["王","おう"],["は"],["ヨシャパテ"],["に"],["答えた","こたえた"],["。"],["「"],["いや"],["、"],["ほか"],["に"],["もう"],["ひとり"],["、"],["私たち","わたしたち"],["が"],["主","ぬし"],["のみ"],["こころ"],["を"],["求める","もとめる"],["こと"],["の"],["できる"],["者","もの"],["が"],["います"],["。"],["しかし"],["、"],["私","わたくし"],["は"],["彼","かれ"],["を"],["憎んで","にくんで"],["います"],["。"],["彼","かれ"],["は"],["私","わたくし"],["について"],["、"],["決して","けっして"],["良い","よい"],["こと"],["は"],["預言","よげん"],["せず"],["、"],["いつも"],["悪い","わるい"],["こと"],["ばかり"],["を"],["預言","よげん"],["する"],["から"],["です"],["。"],["それ"],["は"],["、"],["イムラ"],["の"],["子","こ"],["ミカヤ"],["です"],["。"],["」"],["する"],["と"],["、"],["ヨシャパテ"],["は"],["言った","いった"],["。"],["「"],["王","おう"],["よ"],["。"],["そう"],["いう"],["ふう"],["に"],["は"],["言わないで","いわないで"],["ください"],["。"],["」"]]},{"verse":8,"text":"そこで、イスラエルの王はひとりの宦官を呼び寄せ、「急いで、イムラの子ミカヤを呼んで来なさい」と命じた。","tok":[["そこ"],["で"],["、"],["イスラエル"],["の"],["王","おう"],["は"],["ひとり"],["の"],["宦官","かんがん"],["を"],["呼び寄せ","よびよせ"],["、"],["「"],["急いで","いそいで"],["、"],["イムラ"],["の"],["子","こ"],["ミカヤ"],["を"],["呼んで","よんで"],["来","き"],["なさい"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":9,"text":"イスラエルの王と、ユダの王ヨシャパテは、おのおの王服を着て、王の座に着き、サマリヤの門の入口にある打ち場にすわっていた。預言者はみな、ふたりの前で預言していた。","tok":[["イスラエル"],["の"],["王","おう"],["と"],["、"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["は"],["、"],["おのおの"],["王","おう"],["服","ふく"],["を"],["着て","きて"],["、"],["王","おう"],["の"],["座","ざ"],["に"],["着き","つき"],["、"],["サマリヤ"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["ある"],["打ち","うち"],["場","ば"],["に"],["すわって"],["いた"],["。"],["預言者","よげんしゃ"],["は"],["みな"],["、"],["ふたり"],["の"],["前","まえ"],["で"],["預言","よげん"],["して"],["いた"],["。"]]},{"verse":10,"text":"そのとき、ケナアナの子ゼデキヤは、王のために鉄の角を作って言った。「主はこう仰せられます。『これらの角で、あなたはアラムを突いて、絶滅させなければならない。』」","tok":[["その"],["とき"],["、"],["ケナアナ"],["の"],["子","こ"],["ゼデキヤ"],["は"],["、"],["王","おう"],["の"],["ため"],["に"],["鉄","てつ"],["の"],["角","かど"],["を"],["作って","つくって"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["これ"],["ら"],["の"],["角","かど"],["で"],["、"],["あなた"],["は"],["アラム"],["を"],["突いて","ついて"],["、"],["絶滅","ぜつめつ"],["させなければ"],["ならない"],["。"],["』"],["」"]]},{"verse":11,"text":"ほかの預言者たちもみな、同じように預言して言った。「ラモテ・ギルアデに攻め上って勝利を得なさい。主は王の手にこれを渡されます。」","tok":[["ほか"],["の"],["預言者","よげんしゃ"],["たち"],["も"],["みな"],["、"],["同じ","おなじ"],["よう"],["に"],["預言","よげん"],["して"],["言った","いった"],["。"],["「"],["ラモテ"],["・"],["ギルアデ"],["に"],["攻め上って","せめのぼって"],["勝利","しょうり"],["を"],["得","え"],["なさい"],["。"],["主","ぬし"],["は"],["王","おう"],["の"],["手","て"],["に"],["これ"],["を"],["渡されます","わたされます"],["。"],["」"]]},{"verse":12,"text":"さて、ミカヤを呼びに行った使いの者はミカヤに告げて言った。「いいですか。預言者たちは口をそろえて、王に対し良いことを述べています。お願いですから、あなたもみなと同じように語り、良いことを述べてください。」","tok":[["さて"],["、"],["ミカヤ"],["を"],["呼び","よび"],["に"],["行った","いった"],["使い","つかい"],["の"],["者","もの"],["は"],["ミカヤ"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["いいです"],["か"],["。"],["預言者","よげんしゃ"],["たち"],["は"],["口","くち"],["を"],["そろえて"],["、"],["王","おう"],["に"],["対し","たいし"],["良い","よい"],["こと"],["を"],["述べて","のべて"],["います"],["。"],["お願い","おねがい"],["です"],["から"],["、"],["あなた"],["も"],["みなと"],["同じ","おなじ"],["よう"],["に"],["語り","かたり"],["、"],["良い","よい"],["こと"],["を"],["述べて","のべて"],["ください"],["。"],["」"]]},{"verse":13,"text":"すると、ミカヤは答えた。「主は生きておられる。私の神が告げられることを、そのまま述べよう。」","tok":[["する"],["と"],["、"],["ミカヤ"],["は"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["私","わたくし"],["の"],["神","かみ"],["が"],["告げられる","つげられる"],["こと"],["を"],["、"],["そのまま"],["述べよう","のべよう"],["。"],["」"]]},{"verse":14,"text":"彼が王のもとに着くと、王は彼に言った。「ミカヤ。私たちはラモテ・ギルアデに戦いに行くべきだろうか。それとも、私はやめるべきだろうか。」すると、彼は答えた。「攻め上って勝利を得なさい。彼らはあなたがたの手に渡されます。」","tok":[["彼","かれ"],["が"],["王","おう"],["の"],["もと"],["に"],["着く","つく"],["と"],["、"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["ミカヤ"],["。"],["私たち","わたしたち"],["は"],["ラモテ"],["・"],["ギルアデ"],["に"],["戦い","たたかい"],["に"],["行くべきだろう","いくべきだろう"],["か"],["。"],["それ"],["と"],["も"],["、"],["私","わたくし"],["は"],["やめるべきだろう"],["か"],["。"],["」"],["する"],["と"],["、"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["攻め上って","せめのぼって"],["勝利","しょうり"],["を"],["得","え"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡されます","わたされます"],["。"],["」"]]},{"verse":15,"text":"すると、王は彼に言った。「いったい、私が何度あなたに誓わせたら、あなたは主の名によって真実だけを私に告げるようになるのか。」","tok":[["する"],["と"],["、"],["王","おう"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["いったい"],["、"],["私","わたくし"],["が"],["何度","なんど"],["あなた"],["に"],["誓わせたら","ちかわせたら"],["、"],["あなた"],["は"],["主","ぬし"],["の"],["名","な"],["によって"],["真実","しんじつ"],["だけ"],["を"],["私","わたくし"],["に"],["告げる","つげる"],["よう"],["に"],["なる"],["の"],["か"],["。"],["」"]]},{"verse":16,"text":"彼は答えた。「私は全イスラエルが、山々に散らされているのを見た。まるで、飼い主のいない羊の群れのように。そのとき、主は仰せられた。『彼らには主人がいない。彼らをおのおのその家に無事に帰さなければならない。』」","tok":[["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["全","ぜん"],["イスラエル"],["が"],["、"],["山々","やまやま"],["に"],["散らされて","ちらされて"],["いる"],["の"],["を"],["見た","みた"],["。"],["まるで"],["、"],["飼い主","かいぬし"],["の"],["いない"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["よう"],["に"],["。"],["その"],["とき"],["、"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["『"],["彼","
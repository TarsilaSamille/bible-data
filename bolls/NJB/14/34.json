が"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["携え","たずさえ"],["入れられた","いれられた"],["金","かね"],["を"],["取り出して","とりだして"],["いた"],["とき"],["、"],["祭司","さいし"],["ヒルキヤ"],["は"],["、"],["モーセ"],["を"],["通して","とおして"],["示された","しめされた"],["主","ぬし"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["発見","はっけん"],["した"],["。"]]},{"verse":15,"text":"そのときすぐ、ヒルキヤは書記シャファンに対してこう言った。「私は主の宮で律法の書を見つけました。」ヒルキヤがその書物をシャファンに渡すと、","tok":[["その"],["とき"],["すぐ"],["、"],["ヒルキヤ"],["は"],["書記","しょき"],["シャファン"],["に対して","にたいして"],["こう"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["主","ぬし"],["の"],["宮","みや"],["で"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["見つけました","みつけました"],["。"],["」"],["ヒルキヤ"],["が"],["その"],["書物","しょもつ"],["を"],["シャファン"],["に"],["渡す","わたす"],["と"],["、"]]},{"verse":16,"text":"シャファンは、その書物を王のもとに携えて行き、さらに王に報告して言った。「しもべにゆだねられたことは、すべてやらせております。","tok":[["シャファン"],["は"],["、"],["その"],["書物","しょもつ"],["を"],["王","おう"],["の"],["もと"],["に"],["携えて","たずさえて"],["行き","いき"],["、"],["さらに"],["王","おう"],["に"],["報告","ほうこく"],["して"],["言った","いった"],["。"],["「"],["しもべ"],["に"],["ゆだねられた"],["こと"],["は"],["、"],["すべて"],["やらせて"],["おります"],["。"]]},{"verse":17,"text":"彼らは主の宮にあった金を箱からあけて、これを監督者たちの手に、工事をしている者たちの手に渡しました。」","tok":[["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["宮","みや"],["に"],["あった"],["金","かね"],["を"],["箱","ばこ"],["から"],["あけて"],["、"],["これ"],["を"],["監督者","かんとくしゃ"],["たち"],["の"],["手","て"],["に"],["、"],["工事","こうじ"],["を"],["して"],["いる"],["者","もの"],["たち"],["の"],["手","て"],["に"],["渡しました","わたしました"],["。"],["」"]]},{"verse":18,"text":"ついで、書記シャファンは王に告げて、言った。「祭司ヒルキヤが私に一つの書物を渡してくれました。」そして、シャファンは王の前でそれを朗読した。","tok":[["つい"],["で"],["、"],["書記","しょき"],["シャファン"],["は"],["王","おう"],["に"],["告げて","つげて"],["、"],["言った","いった"],["。"],["「"],["祭司","さいし"],["ヒルキヤ"],["が"],["私","わたくし"],["に"],["一","ひと"],["つ"],["の"],["書物","しょもつ"],["を"],["渡して","わたして"],["くれました"],["。"],["」"],["そして"],["、"],["シャファン"],["は"],["王","おう"],["の"],["前","まえ"],["で"],["それ"],["を"],["朗読","ろうどく"],["した"],["。"]]},{"verse":19,"text":"王は律法のことばを聞いたとき、自分の衣を裂いた。","tok":[["王","おう"],["は"],["律法","りっぽう"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["裂いた","さいた"],["。"]]},{"verse":20,"text":"王はヒルキヤ、シャファンの子アヒカム、ミカの子アブドン、書記シャファン、王の家来アサヤに命じて言った。","tok":[["王","おう"],["は"],["ヒルキヤ"],["、"],["シャファン"],["の"],["子","こ"],["アヒカム"],["、"],["ミカ"],["の"],["子","こ"],["アブドン"],["、"],["書記","しょき"],["シャファン"],["、"],["王","おう"],["の"],["家来","けらい"],["アサヤ"],["に"],["命じて","めいじて"],["言った","いった"],["。"]]},{"verse":21,"text":"「行って、見つかった書物のことばについて、私のため、イスラエルとユダの残りの者のために、主のみこころを求めなさい。私たちの先祖が、主のことばを守らず、すべてこの書にしるされているとおりに行わなかったため、私たちの上に注がれた主の憤りは激しいから。」","tok":[["「"],["行って","いって"],["、"],["見つかった","みつかった"],["書物","しょもつ"],["の"],["ことば"],["について"],["、"],["私","わたくし"],["の"],["ため"],["、"],["イスラエル"],["と"],["ユダ"],["の"],["残り","のこり"],["の"],["者","もの"],["の"],["ため"],["に"],["、"],["主","ぬし"],["のみ"],["こころ"],["を"],["求め","もとめ"],["なさい"],["。"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["が"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["守らず","まもらず"],["、"],["すべて"],["この"],["書","しょ"],["に"],["しるされて"],["いる"],["とおり"],["に"],["行わなかった","おこなわなかった"],["ため"],["、"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["注がれた","そそがれた"],["主","ぬし"],["の"],["憤り","いきどおり"],["は"],["激しい","はげしい"],["から"],["。"],["」"]]},{"verse":22,"text":"そこで、ヒルキヤ、および、王の指名した人々は、女預言者フルダのもとに行った。彼女は、ハスラの子トクハテの子、装束係シャルムの妻で、エルサレムの第二区に住んでいた。彼らがその旨を彼女に伝えると、","tok":[["そこ"],["で"],["、"],["ヒルキヤ"],["、"],["および"],["、"],["王","おう"],["の"],["指名","しめい"],["した"],["人々","ひとびと"],["は"],["、"],["女","おんな"],["預言者","よげんしゃ"],["フルダ"],["の"],["もと"],["に"],["行った","いった"],["。"],["彼女","かのじょ"],["は"],["、"],["ハスラ"],["の"],["子","こ"],["トクハテ"],["の"],["子","こ"],["、"],["装束","しょうぞく"],["係","かかり"],["シャルム"],["の"],["妻","つま"],["で"],["、"],["エルサレム"],["の"],["第","だい"],["二区","にく"],["に"],["住んで","すんで"],["いた"],["。"],["彼","かれ"],["ら"],["が"],["その"],["旨","むね"],["を"],["彼女","かのじょ"],["に"],["伝える","つたえる"],["と"],["、"]]},{"verse":23,"text":"彼女は彼らに答えた。「イスラエルの神、主は、こう仰せられます。『あなたがたをわたしのもとに遣わした人に告げよ。","tok":[["彼女","かのじょ"],["は"],["彼","かれ"],["ら"],["に"],["答えた","こたえた"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられます","おおせられます"],["。"],["『"],["あなた"],["がた"],["を"],["わたし"],["の"],["もと"],["に"],["遣わした","つかわした"],["人","ひと"],["に"],["告げ","つげ"],["よ"],["。"]]},{"verse":24,"text":"主はこう仰せられる。見よ。わたしは、この場所とその住民の上にわざわいをもたらす。彼らがユダの王の前で読み上げた書物にしるされているすべてののろいをもたらす。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["この"],["場所","ばしょ"],["と"],["その"],["住民","じゅうみん"],["の"],["上","うえ"],["に"],["わざわい"],["を"],["もたらす"],["。"],["彼","かれ"],["ら"],["が"],["ユダ"],["の"],["王","おう"],["の"],["前","まえ"],["で"],["読み上げた","よみあげた"],["書物","しょもつ"],["に"],["しるされて"],["いる"],["すべて"],["の"],["のろい"],["を"],["もたらす"],["。"]]},{"verse":25,"text":"彼らはわたしを捨て、ほかの神々に香をたき、彼らのすべての手のわざで、わたしの怒りを引き起こすようにした。わたしの憤りはこの場所に注がれ、消えることがない。』","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["を"],["捨て","すて"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["、"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["手","て"],["の"],["わざ"],["で"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こす","ひきおこす"],["よう"],["に"],["した"],["。"],["わたし"],["の"],["憤り","いきどおり"],["は"],["この"],["場所","ばしょ"],["に"],["注がれ","そそがれ"],["、"],["消える","きえる"],["こと"],["が"],["ない"],["。"],["』"]]},{"verse":26,"text":"主に尋ねるために、あなたがたを遣わしたユダの王には、こう言わなければなりません。『あなたが聞いたことばについて、イスラエルの神、主は、こう仰せられます。","tok":[["主に","おもに"],["尋ねる","たずねる"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["遣わした","つかわした"],["ユダ"],["の"],["王","おう"],["に"],["は"],["、"],["こう"],["言わなければ","いわなければ"],["なりません"],["。"],["『"],["あなた"],["が"],["聞いた","きいた"],["ことば"],["について"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["こう"],["仰せられます","おおせられます"],["。"]]},{"verse":27,"text":"あなたが、この場所とその住民についての神のことばを聞いたとき、あなたは心を痛め、神の前にへりくだり、わたしの前にへりくだって自分の衣を裂き、わたしの前で泣いたので、わたしもまた、あなたの願いを聞き入れる。――主の御告げです――","tok":[["あなた"],["が"],["、"],["この"],["場所","ばしょ"],["と"],["その"],["住民","じゅうみん"],["について"],["の"],["神","かみ"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["あなた"],["は"],["心","こころ"],["を"],["痛め","いため"],["、"],["神","かみ"],["の"],["前","まえ"],["に"],["へりくだり"],["、"],["わたし"],["の"],["前","まえ"],["に"],["へりくだって"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["裂き","さき"],["、"],["わたし"],["の"],["前","まえ"],["で"],["泣いた","ないた"],["ので"],["、"],["わたし"],["も"],["また"],["、"],["あなた"],["の"],["願い","ねがい"],["を"],["聞き入れる","ききいれる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["です"],["―"],["―"]]},{"verse":28,"text":"見よ。わたしは、あなたを先祖たちのもとに集めよう。あなたは安らかに自分の墓に集められる。それで、あなたは自分の目で、わたしがこの場所とその住民にもたらすすべてのわざわいを見ることがない。』」彼らはそれを王に報告した。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["あなた"],["を"],["先祖","せんぞ"],["たち"],["の"],["もと"],["に"],["集めよう","あつめよう"],["。"],["あなた"],["は"],["安らか","やすらか"],["に"],["自分","じぶん"],["の"],["墓","はか"],["に"],["集められる","あつめられる"],["。"],["それ"],["で"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["目","め"],["で"],["、"],["わたし"],["が"],["この"],["場所","ばしょ"],["と"],["その"],["住民","じゅうみん"],["に"],["もたらす"],["すべて"],["の"],["わざわい"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"],["』"],["」"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["王","おう"],["に"],["報告","ほうこく"],["した"],["。"]]},{"verse":29,"text":"すると、王は使者を遣わして、ユダとエルサレムの長老をひとり残らず集めた。","tok":[["する"],["と"],["、"],["王","おう"],["は"],["使者","ししゃ"],["を"],["遣わして","つかわして"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["長老","ちょうろう"],["を"],["ひとり"],["残らず","のこらず"],["集めた","あつめた"],["。"]]},{"verse":30,"text":"王は主の宮へ上って行った。ユダのすべての人、エルサレムの住民、祭司とレビ人、および、上の者も下の者も、すべての民が行った。そこで彼は主の宮で発見された契約の書のことばをみな、彼らに読み聞かせた。","tok":[["王","おう"],["は"],["主","ぬし"],["の"],["宮","みや"],["へ"],["上って","のぼって"],["行った","いった"],["。"],["ユダ"],["の"],["すべて"],["の"],["人","ひと"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["、"],["祭司","さいし"],["と"],["レビ人","れびにん"],["、"],["および"],["、"],["上","うえ"],["の"],["者","もの"],["も"],["下","した"],["の"],["者","もの"],["も"],["、"],["すべて"],["の"],["民","たみ"],["が"],["行った","おこなった"],["。"],["そこ"],["で"],["彼","かれ"],["は"],["主","ぬし"],["の"],["宮","みや"],["で"],["発見","はっけん"],["された"],["契約","けいやく"],["の"],["書","しょ"],["の"],["ことば"],["を"],["みな"],["、"],["彼","かれ"],["ら"],["に"],["読み聞かせた","よみきかせた"],["。"]]},{"verse":31,"text":"それから、王はその定めの場所に立ち、主の前に契約を結び、主に従って歩み、心を尽くし、精神を尽くして、主の命令と、あかしと、おきてを守り、この書物にしるされている契約のことばを行うことを誓った。","tok":[["それ"],["から"],["、"],["王","おう"],["は"],["その"],["定め","さだめ"],["の"],["場所","ばしょ"],["に"],["立ち","たち"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["主に","おもに"],["従って","したがって"],["歩み","あゆみ"],["、"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["精神","せいしん"],["を"],["尽くして","つくして"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["と"],["、"],["あかし"],["と"],["、"],["おきて"],["を"],["守り","まもり"],["、"],["この"],["書物","しょもつ"],["に"],["しるされて"],["いる"],["契約","けいやく"],["の"],["ことば"],["を"],["行う","おこなう"],["こと"],["を"],["誓った","ちかった"],["。"]]},{"verse":32,"text":"彼はエルサレムとベニヤミンにいるすべての者を堅く立たせた。エルサレムの住民は、その父祖の神である神の契約に従って行動した。","tok":[["彼","かれ"],["は"],["エルサレム"],["と"],["ベニヤミン"],["に"],["いる"],["すべて"],["の"],["者","もの"],["を"],["堅く","かたく"],["立たせた","たたせた"],["。"],["エルサレム"],["の"],["住民","じゅうみん"],["は"],["、"],["その"],["父祖","ふそ"],["の"],["神","かみ"],["で"],["ある"],["神","かみ"],["の"],["契約","けいやく"],["に"],["従って","したがって"],["行動","こうどう"],["した"],["。"]]},{"verse":33,"text":"ヨシヤはイスラエル人の全地から、忌みきらうべきものを除き去り、イスラエルにいるすべての者を、その神、主に仕えさせた。彼の生きている間、彼らはその父祖の神、主に従う道からはずれなかった。","tok":[["ヨシヤ"],["は"],["イスラエル"],["人","にん"],["の"],["全地","ぜんち"],["から"],["、"],["忌みきらうべき","いみきらうべき"],["もの"],["を"],["除き去り","のぞきさり"],["、"],["イスラエル"],["に"],["いる"],["すべて"],["の"],["者","もの"],["を"],["、"],["その"],["神","かみ"],["、"],["主に","おもに"],["仕えさせた","つかえさせた"],["。"],["彼","かれ"],["の"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["は"],["その"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主に","おもに"],["従う","したがう"],["道","みち"],["から"],["はずれなかった"],["。"]]}]
"],["彼","かれ"],["の"],["すべて"],["の"],["妻","つま"],["、"],["そばめ"],["に"],["まさって"],["アブシャロム"],["の"],["娘","むすめ"],["マアカ"],["を"],["愛した","あいした"],["。"],["彼","かれ"],["は"],["妻","つま"],["を"],["十八人","じゅうはちにん"],["、"],["そばめ"],["を"],["六","ろく"],["十人","じゅうにん"],["持って","もって"],["おり"],["、"],["二十八人","にじゅうはちにん"],["の"],["息子","むすこ"],["、"],["六","ろく"],["十人","じゅうにん"],["の"],["娘","むすめ"],["を"],["もうけた"],["。"]]},{"verse":22,"text":"レハブアムはマアカの子アビヤを立ててかしらとし、彼の兄弟たちの間でつかさとした。彼を王にしようと考えたからである。","tok":[["レハブアム"],["は"],["マアカ"],["の"],["子","こ"],["アビヤ"],["を"],["立てて","たてて"],["かしら"],["と"],["し"],["、"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["の"],["間","あいだ"],["で"],["つかさ"],["と"],["した"],["。"],["彼","かれ"],["を"],["王","おう"],["に"],["しよう"],["と"],["考えた","かんがえた"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"彼は賢く事を行い、その子どもたちを全部、ユダとベニヤミンの全土、すなわちすべての防備の町々に分散させたうえ、彼らにたくさんの食糧を供給し、多くの妻を捜し与えた。","tok":[["彼","かれ"],["は"],["賢く","かしこく"],["事","こと"],["を"],["行い","おこない"],["、"],["その"],["子ども","こども"],["たち"],["を"],["全部","ぜんぶ"],["、"],["ユダ"],["と"],["ベニヤミン"],["の"],["全土","ぜんど"],["、"],["すなわち"],["すべて"],["の"],["防備","ぼうび"],["の"],["町々","まちまち"],["に"],["分散","ぶんさん"],["させた"],["うえ"],["、"],["彼","かれ"],["ら"],["に"],["たくさん"],["の"],["食糧","しょくりょう"],["を"],["供給","きょうきゅう"],["し"],["、"],["多く","おおく"],["の"],["妻","つま"],["を"],["捜し","さがし"],["与えた","あたえた"],["。"]]}]
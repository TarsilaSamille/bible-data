[{"verse":1,"text":"レハブアムはエルサレムに帰り、ユダとベニヤミンの家から選抜戦闘員十八万を召集し、王国をレハブアムのもとに取り戻すため、イスラエルと戦おうとした。","tok":[["レハブアム"],["は"],["エルサレム"],["に"],["帰り","かえり"],["、"],["ユダ"],["と"],["ベニヤミン"],["の"],["家","いえ"],["から"],["選抜","せんばつ"],["戦闘員","せんとういん"],["十八万","じゅうはちまん"],["を"],["召集","しょうしゅう"],["し"],["、"],["王国","おうこく"],["を"],["レハブアム"],["の"],["もと"],["に"],["取り戻す","とりもどす"],["ため"],["、"],["イスラエル"],["と"],["戦おう","たたかおう"],["と"],["した"],["。"]]},{"verse":2,"text":"すると、神の人シェマヤに次のような主のことばがあった。","tok":[["する"],["と"],["、"],["神","かみ"],["の"],["人","ひと"],["シェマヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":3,"text":"「ユダの王、ソロモンの子レハブアム、および、ユダとベニヤミンに属する全イスラエルに告げて言え。","tok":[["「"],["ユダ"],["の"],["王","おう"],["、"],["ソロモン"],["の"],["子","こ"],["レハブアム"],["、"],["および"],["、"],["ユダ"],["と"],["ベニヤミン"],["に"],["属する","ぞくする"],["全","ぜん"],["イスラエル"],["に"],["告げて","つげて"],["言え","いえ"],["。"]]},{"verse":4,"text":"『主はこう仰せられる。上って行ってはならない。あなたがたの兄弟たちと戦ってはならない。おのおの自分の家に帰れ。わたしがこうなるようにしむけたのだから。』」そこで、彼らは主のことばに聞き従い、ヤロブアムを目ざして進む行軍を中止して、引き返した。","tok":[["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["上って","のぼって"],["行って","いって"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["たち"],["と"],["戦って","たたかって"],["は"],["ならない"],["。"],["おのおの"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰れ","かえれ"],["。"],["わたし"],["が"],["こう"],["なる"],["よう"],["に"],["しむけた"],["の"],["だ"],["から"],["。"],["』"],["」"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["ことば"],["に"],["聞き従い","ききしたがい"],["、"],["ヤロブアム"],["を"],["目ざして","めざして"],["進む","すすむ"],["行軍","こうぐん"],["を"],["中止","ちゅうし"],["して"],["、"],["引き返した","ひきかえした"],["。"]]},{"verse":5,"text":"レハブアムはエルサレムに住み、ユダの中に防備の町々を建てた。","tok":[["レハブアム"],["は"],["エルサレム"],["に"],["住み","すみ"],["、"],["ユダ"],["の"],["中","なか"],["に"],["防備","ぼうび"],["の"],["町々","まちまち"],["を"],["建てた","たてた"],["。"]]},{"verse":6,"text":"すなわち、ベツレヘムとエタムとテコア、","tok":[["すなわち"],["、"],["ベツレヘム"],["と"],["エタム"],["と"],["テコア"],["、"]]},{"verse":7,"text":"ベテ・ツルとソコとアドラム、","tok":[["ベテ"],["・"],["ツル"],["と"],["ソコ"],["と"],["アドラム"],["、"]]},{"verse":8,"text":"ガテとマレシャとジフ、","tok":[["ガテ"],["と"],["マレシャ"],["と"],["ジフ"],["、"]]},{"verse":9,"text":"アドライムとラキシュとアゼカ、","tok":[["アドライム"],["と"],["ラキシュ"],["と"],["アゼカ"],["、"]]},{"verse":10,"text":"ツォルアとアヤロンとヘブロン。これらはユダとベニヤミンの中にあり、防備の町々であった。","tok":[["ツォルア"],["と"],["アヤロン"],["と"],["ヘブロン"],["。"],["これ"],["ら"],["は"],["ユダ"],["と"],["ベニヤミン"],["の"],["中","なか"],["に"],["あり"],["、"],["防備","ぼうび"],["の"],["町々","まちまち"],["で"],["あった"],["。"]]},{"verse":11,"text":"さらに、彼は防備を固めて、その中に隊長を置き、糧食、油、ぶどう酒をたくわえた。","tok":[["さらに"],["、"],["彼","かれ"],["は"],["防備","ぼうび"],["を"],["固めて","かためて"],["、"],["その"],["中","なか"],["に"],["隊長","たいちょう"],["を"],["置き","おき"],["、"],["糧食","りょうしょく"],["、"],["油","あぶら"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["たくわえた"],["。"]]},{"verse":12,"text":"またすべての町ごとに大盾と槍を置き、これらの町をますます強固にした。こうして、ユダとベニヤミンは彼の側についた。","tok":[["また"],["すべて"],["の"],["町","まち"],["ごと"],["に"],["大","だい"],["盾","たて"],["と"],["槍","やり"],["を"],["置き","おき"],["、"],["これ"],["ら"],["の"],["町","まち"],["を"],["ますます"],["強固","きょうこ"],["に"],["した"],["。"],["こう"],["して"],["、"],["ユダ"],["と"],["ベニヤミン"],["は"],["彼","かれ"],["の"],["側","がわ"],["に"],["ついた"],["。"]]},{"verse":13,"text":"イスラエル全土の祭司たち、レビ人たちは、あらゆる地域から出て来て、彼の側についた。","tok":[["イスラエル"],["全土","ぜんど"],["の"],["祭司","さいし"],["たち"],["、"],["レビ人","れびにん"],["たち"],["は"],["、"],["あらゆる"],["地域","ちいき"],["から"],["出て","でて"],["来て","きて"],["、"],["彼","かれ"],["の"],["側","がわ"],["に"],["ついた"],["。"]]},{"verse":14,"text":"実は、レビ人は自分たちの放牧地と所有地を捨てて、ユダとエルサレムに来たのである。ヤロブアムとその子らが、主の祭司としての彼らの職を解き、","tok":[["実","じつ"],["は"],["、"],["レビ人","れびにん"],["は"],["自分","じぶん"],["たち"],["の"],["放牧","ほうぼく"],["地","ち"],["と"],["所有地","しょゆうち"],["を"],["捨てて","すてて"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["来た","きた"],["ので"],["ある"],["。"],["ヤロブアム"],["と"],["その"],["子","こ"],["ら"],["が"],["、"],["主","ぬし"],["の"],["祭司","さいし"],["として"],["の"],["彼","かれ"],["ら"],["の"],["職","しょく"],["を"],["解き","とき"],["、"]]},{"verse":15,"text":"自分のために祭司たちを任命して、彼が造った高き所と雄やぎと子牛に仕えさせたからである。","tok":[["自分","じぶん"],["の"],["ため"],["に"],["祭司","さいし"],["たち"],["を"],["任命","にんめい"],["して"],["、"],["彼","かれ"],["が"],["造った","つくった"],["高き","たかき"],["所","とこ
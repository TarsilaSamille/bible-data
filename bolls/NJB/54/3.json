[{"verse":1,"text":"「人がもし監督の職につきたいと思うなら、それはすばらしい仕事を求めることである」ということばは真実です。","tok":[["「"],["人","ひと"],["が"],["もし"],["監督","かんとく"],["の"],["職","しょく"],["に"],["つきたい"],["と"],["思うなら","おもうなら"],["、"],["それ"],["は"],["すばらしい"],["仕事","しごと"],["を"],["求める","もとめる"],["こと"],["で"],["ある"],["」"],["と"],["いう"],["ことば"],["は"],["真実","しんじつ"],["です"],["。"]]},{"verse":2,"text":"ですから、監督はこういう人でなければなりません。すなわち、非難されるところがなく、ひとりの妻の夫であり、自分を制し、慎み深く、品位があり、よくもてなし、教える能力があり、","tok":[["です"],["から"],["、"],["監督","かんとく"],["は"],["こう"],["いう"],["人","ひと"],["で"],["なければ"],["なりません"],["。"],["すなわち"],["、"],["非難","ひなん"],["される"],["ところ"],["が"],["なく"],["、"],["ひとり"],["の"],["妻","つま"],["の"],["夫","おっと"],["で"],["あり"],["、"],["自分","じぶん"],["を"],["制し","せいし"],["、"],["慎み深く","つつしみぶかく"],["、"],["品位","ひんい"],["が"],["あり"],["、"],["よく"],["もてなし"],["、"],["教える","おしえる"],["能力","のうりょく"],["が"],["あり"],["、"]]},{"verse":3,"text":"酒飲みでなく、暴力をふるわず、温和で、争わず、金銭に無欲で、","tok":[["酒飲み","さけのみ"],["で"],["なく"],["、"],["暴力","ぼうりょく"],["を"],["ふるわず"],["、"],["温和","おんわ"],["で"],["、"],["争わず","あらそわず"],["、"],["金銭","きんせん"],["に"],["無欲","むよく"],["で"],["、"]]},{"verse":4,"text":"自分の家庭をよく治め、十分な威厳をもって子どもを従わせている人です。","tok":[["自分","じぶん"],["の"],["家庭","かてい"],["を"],["よく"],["治め","おさめ"],["、"],["十分","じゅうぶん"],["な"],["威厳","いげん"],["を"],["もって"],["子ども","こども"],["を"],["従わせて","したがわせて"],["いる"],["人","ひと"],["です"],["。"]]},{"verse":5,"text":"――自分自身の家庭を治めることを知らない人が、どうして神の教会の世話をすることができるでしょう――","tok":[["―"],["―"],["自分","じぶん"],["自身","じしん"],["の"],["家庭","かてい"],["を"],["治める","おさめる"],["こと"],["を"],["知らない","しらない"],["人","ひと"],["が"],["、"],["どう"],["して"],["神","かみ"],["の"],["教会","きょうかい"],["の"],["世話","せわ"],["を"],["する"],["こと"],["が"],["できるでしょう"],["―"],["―"]]},{"verse":6,"text":"また、信者になったばかりの人であってはいけません。高慢になって、悪魔と同じさばきを受けることにならないためです。","tok":[["また"],["、"],["信者","しんじゃ"],["に"],["なった"],["ばかり"],["の"],["人","ひと"],["で"],["あって"],["は"],["いけません"],["。"],["高慢","こうまん"],["に"],["なって"],["、"],["悪魔","あくま"],["と"],["同じ","おなじ"],["さばき"],["を"],["受ける","うける"],["こと"],["に"],["ならない"],["ため"],["です"],["。"]]},{"verse":7,"text":"また、教会外の人々にも評判の良い人でなければいけません。そしりを受け、悪魔のわなに陥らないためです。","tok":[["また"],["、"],["教会外","きょうかいがい"],["の"],["人々","ひとびと"],["に"],["も"],["評判","ひょうばん"],["の"],["良い","よい"],["人","ひと"],["で"],["なければ"],["いけません"],["。"],["そ"],["しり"],["を"],["受け","うけ"],["、"],["悪魔","あくま"],["の"],["わな"],["に"],["陥らない","おちいらない"],["ため"],["です"],["。"]]},{"verse":8,"text":"執事もまたこういう人でなければなりません。謹厳で、二枚舌を使わず、大酒飲みでなく、不正な利をむさぼらず、","tok":[["執事","しつじ"],["も"],["また"],["こう"],["いう"],["人","ひと"],["で"],["なければ"],["なりません"],["。"],["謹厳","きんげん"],["で"],["、"],["二枚舌","にまいじた"],["を"],["使わず","つかわず"],["、"],["大","だい"],["酒飲み","さけのみ"],["で"],["なく"],["、"],["不正","ふせい"],["な"],["利","り"],["を"],["むさぼらず"],["、"]]},{"verse":9,"text":"きよい良心をもって信仰の奥義を保っている人です。","tok":[["きよい"],["良心","りょうしん"],["を"],["もって"],["信仰","しんこう"],["の"],["奥義","おうぎ"],["を"],["保って","たもって"],["いる"],["人","ひと"],["です"],["。"]]},{"verse":10,"text":"まず審査を受けさせなさい。そして、非難される点がなければ、執事の職につかせなさい。","tok":[["まず"],["審査","しんさ"],["を"],["受けさせ","うけさせ"],["なさい"],["。"],["そして"],["、"],["非難","ひなん"],["される"],["点","てん"],["が"],["なければ"],["、"],["執事","しつじ"],["の"],["職","しょく"],["に"],["つかせ"],["なさい"],["。"]]},{"verse":11,"text":"婦人執事も、威厳があり、悪口を言わず、自分を制し、すべてに忠実な人でなければなりません。","tok":[["婦人","ふじん"],["執事","しつじ"],["も"],["、"],["威厳","いげん"],["が"],["あり"],["、"],["悪口","わるぐち"],["を"],["言わず","いわず"],["、"],["自分","じぶん"],["を"],["制し","せいし"],["、"],["すべて"],["に"],["忠実","ちゅうじつ"],["な"],["人","ひと"],["で"],["なければ"],["なりません"],["。"]]},{"verse":12,"text":"執事は、ひとりの妻の夫であって、子どもと家庭をよく治める人でなければなりません。","tok":[["執事","しつじ"],["は"],["、"],["ひとり"],["の"],["妻","つま"],["の"],["夫","おっと"],["で"],["あって"],["、"],["子ども","こども"],["と"],["家庭","かてい"],["を"],["よく"],["治める","おさめる"],["人","ひと"],["で"],["なければ"],["なりません"],["。"]]},{"verse":13,"text":"というのは、執事の務めをりっぱに果たした人は、良い地歩を占め、また、キリスト・イエスを信じる信仰について強い確信を持つことができるからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["執事","しつじ"],["の"],["務め","つとめ"],["を"],["りっぱ"],["に"],["果たした","はたした"],["人","ひと"],["は"],["、"],["良い","よい"],["地歩","ちほ"],["を"],["占め","しめ"],["、"],["また"],["、"],["キリスト"],["・"],["イエス"],["を"],["信じる","しんじる"],["信仰","しんこう"],["について"],["強い","つよい"],["確信","かくしん"],["を"],["持つ","もつ"],["こと"],["が"],["できる"],["から"],["です"],["。"]]},{"verse":14,"text":"私は、近いうちにあなたのところに行きたいと思いながらも、この手紙を書いています。","tok":[["私","わたくし"],["は"],["、"],["近い","ちかい"],["うち"],["に"],["あなた"],["の"],["ところ"],["に"],["行きたい","いきたい"],["と"],["思い","おもい"],["ながら"],["も"],["、"],["この"],["手紙","てがみ"],["を"],["書いて","かいて"],["います"],["。"]]},{"verse":15,"text":"それは、たとい私がおそくなった場合でも、神の家でどのように行動すべきかを、あなたが知っておくためです。神の家とは生ける神の教会のことであり、その教会は、真理の柱また土台です。","tok":[["それ"],["は"],["、"],["たとい"],["私","わたくし"],["が"],["おそく"],["なった"],["場合","ばあい"],["で"],["も"],["、"],["神","かみ"],["の"],["家","いえ"],["で"],["どの"],["よう"],["に"],["行動","こうどう"],["すべき"],["か"],["を"],["、"],["あなた"],["が"],["知って","しって"],["おく"],["ため"],["です"],["。"],["神","かみ"],["の"],["家","いえ"],["と"],["は"],["生ける","いける"],["神","かみ"],["の"],["教会","きょうかい"],["の"],["こと"],["で"],["あり"],["、"],["その"],["教会","きょうかい"],["は"],["、"],["真理","しんり"],["の"],["柱","はしら"],["また"],["土台","どだい"],["です"],["。"]]},{"verse":16,"text":"確かに偉大なのはこの敬虔の奥義です。「キリストは肉において現れ、霊において義と宣言され、御使いたちに見られ、諸国民の間に宣べ伝えられ、世界中で信じられ、栄光のうちに上げられた。」","tok":[["確か","たしか"],["に"],["偉大","いだい"],["な"],["の"],["は"],["この"],["敬虔","けいけん"],["の"],["奥義","おうぎ"],["です"],["。"],["「"],["キリスト"],["は"],["肉","にく"],["に"],["おいて"],["現れ","あらわれ"],["、"],["霊","れい"],["に"],["おいて"],["義","ぎ"],["と"],["宣言","せんげん"],["され"],["、"],["御使い","おつかい"],["たち"],["に"],["見られ","みられ"],["、"],["諸","しょ"],["国民","こくみん"],["の"],["間","あいだ"],["に"],["宣べ伝えられ","のべつたえられ"],["、"],["世界中","せかいじゅう"],["で"],["信じられ","しんじられ"],["、"],["栄光","えいこう"],["の"],["うち"],["に"],["上げられた","あげられた"],["。"],["」"]]}]
[{"verse":1,"text":"そこで、まず初めに、このことを勧めます。すべての人のために、また王とすべての高い地位にある人たちのために願い、祈り、とりなし、感謝がささげられるようにしなさい。","tok":[["そこ"],["で"],["、"],["まず"],["初め","はじめ"],["に"],["、"],["この"],["こと"],["を"],["勧めます","すすめます"],["。"],["すべて"],["の"],["人","ひと"],["の"],["ため"],["に"],["、"],["また"],["王","おう"],["と"],["すべて"],["の"],["高い","たかい"],["地位","ちい"],["に"],["ある"],["人","ひと"],["たち"],["の"],["ため"],["に"],["願い","ねがい"],["、"],["祈り","いのり"],["、"],["とりなし"],["、"],["感謝","かんしゃ"],["が"],["ささげられる"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":2,"text":"それは、私たちが敬虔に、また、威厳をもって、平安で静かな一生を過ごすためです。","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["が"],["敬虔","けいけん"],["に"],["、"],["また"],["、"],["威厳","いげん"],["を"],["もって"],["、"],["平安","へいあん"],["で"],["静か","しずか"],["な"],["一生","いっしょう"],["を"],["過ごす","すごす"],["ため"],["です"],["。"]]},{"verse":3,"text":"そうすることは、私たちの救い主である神の御前において良いことであり、喜ばれることなのです。","tok":[["そう"],["する"],["こと"],["は"],["、"],["私たち","わたしたち"],["の"],["救い主","すくいぬし"],["で"],["ある"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["おいて"],["良い","よい"],["こと"],["で"],["あり"],["、"],["喜ばれる","よろこばれる"],["こと"],["な"],["の"],["です"],["。"]]},{"verse":4,"text":"神は、すべての人が救われて、真理を知るようになるのを望んでおられます。","tok":[["神","かみ"],["は"],["、"],["すべて"],["の"],["人","ひと"],["が"],["救われて","すくわれて"],["、"],["真理","しんり"],["を"],["知る","しる"],["よう"],["に"],["なる"],["の"],["を"],["望んで","のぞんで"],["おられます"],["。"]]},{"verse":5,"text":"神は唯一です。また、神と人との間の仲介者も唯一であって、それは人としてのキリスト・イエスです。","tok":[["神","かみ"],["は"],["唯一","ゆいいつ"],["です"],["。"],["また"],["、"],["神","かみ"],["と"],["人","ひと"],["と"],["の"],["間","あいだ"],["の"],["仲介者","ちゅうかいしゃ"],["も"],["唯一","ゆいいつ"],["で"],["あって"],["、"],["それ"],["は"],["人","ひと"],["として"],["の"],["キリスト"],["・"],["イエス"],["です"],["。"]]},{"verse":6,"text":"キリストは、すべての人の贖いの代価として、ご自身をお与えになりました。これが時至ってなされたあかしなのです。","tok":[["キリスト"],["は"],["、"],["すべて"],["の"],["人","ひと"],["の"],["贖い","あがない"],["の"],["代価","だいか"],["として"],["、"],["ご自身","ごじしん"],["を"],["お与え","おあたえ"],["に"],["なりました"],["。"],["これ"],["が"],["時","とき"],["至って","いたって"],["なされた"],["あかし"],["な"],["の"],["です"],["。"]]},{"verse":7,"text":"そのあかしのために、私は宣伝者また使徒に任じられ――私は真実を言っており、うそは言いません――信仰と真理を異邦人に教える教師とされました。","tok":[["その"],["あかし"],["の"],["ため"],["に"],["、"],["私","わたくし"],["は"],["宣伝者","せんでんしゃ"],["また"],["使徒","しと"],["に"],["任じられ","にんじられ"],["―"],["―"],["私","わたくし"],["は"],["真実","しんじつ"],["を"],["言って","いって"],["おり"],["、"],["うそ"],["は"],["言いません","いいません"],["―"],["―"],["信仰","しんこう"],["と"],["真理","しんり"],["を"],["異邦人","いほうじん"],["に"],["教える","おしえる"],["教師","きょうし"],["と"],["されました"],["。"]]},{"verse":8,"text":"ですから、私は願うのです。男は、怒ったり言い争ったりすることなく、どこででもきよい手を上げて祈るようにしなさい。","tok":[["です"],["から"],["、"],["私","わたくし"],["は"],["願う","ねがう"],["の"],["です"],["。"],["男","おとこ"],["は"],["、"],["怒っ","おこっ"],["たり"],["言い争っ","いいあらそっ"],["たり"],["する"],["こと"],["なく"],["、"],["どこ"],["で"],["で"],["も"],["きよい"],["手","て"],["を"],["上げて","あげて"],["祈る","いのる"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":9,"text":"同じように女も、つつましい身なりで、控えめに慎み深く身を飾り、はでな髪の形とか、金や真珠や高価な衣服によってではなく、","tok":[["同じ","おなじ"],["よう"],["に"],["女","おんな"],["も"],["、"],["つつましい"],["身なり","みなり"],["で"],["、"],["控えめ","ひかえめ"],["に"],["慎み深く","つつしみぶかく"],["身","み"],["を"],["飾り","かざり"],["、"],["はで"],["な"],["髪","かみ"],["の"],["形","かたち"],["と"],["か"],["、"],["金","きん"],["や"],["真珠","しんじゅ"],["や"],["高価","こうか"],["な"],["衣服","いふく"],["によって"],["で"],["は"],["なく"],["、"]]},{"verse":10,"text":"むしろ、神を敬うと言っている女にふさわしく、良い行いを自分の飾りとしなさい。","tok":[["むしろ"],["、"],["神","かみ"],["を"],["敬う","うやまう"],["と"],["言って","いって"],["いる"],["女","おんな"],["に"],["ふさわしく"],["、"],["良い","よい"],["行い","おこない"],["を"],["自分","じぶん"],["の"],["飾り","かざり"],["と"],["し"],["なさい"],["。"]]},{"verse":11,"text":"女は、静かにして、よく従う心をもって教えを受けなさい。","tok":[["女","おんな"],["は"],["、"],["静か","しずか"],["に"],["して"],["、"],["よく"],["従う","したがう"],["心","こころ"],["を"],["もって"],["教え","おしえ"],["を"],["受け","うけ"],["なさい"],["。"]]},{"verse":12,"text":"私は、女が教えたり男を支配したりすることを許しません。ただ、静かにしていなさい。","tok":[["私","わたくし"],["は"],["、"],["女","おんな"],["が"],["教え","おしえ"],["たり"],["男","おとこ"],["を"],["支配","しはい"],["し"],["たり"],["する"],["こと"],["を"],["許しません","ゆるしません"],["。"],["ただ"],["、"],["静か","しずか"],["に"],["して"],["い"],["なさい"],["。"]]},{"verse":13,"text":"アダムが初めに造られ、次にエバが造られたからです。","tok":[["アダム"],["が"],["初め","はじめ"],["に"],["造られ","つくられ"],["、"],["次","つぎ"],["に"],["エバ"],["が"],["造られた","つくられた"],["から"],["です"],["。"]]},{"verse":14,"text":"また、アダムは惑わされなかったが、女は惑わされてしまい、あやまちを犯しました。","tok":[["また"],["、"],["アダム"],["は"],["惑わされなかった","まどわされなかった"],["が"],["、"],["女","おんな"],["は"],["惑わされて","まどわされて"],["しまい"],["、"],["あやまち"],["を"],["犯しました","おかしました"],["。"]]},{"verse":15,"text":"しかし、女が慎みをもって、信仰と愛と聖さとを保つなら、子を産むことによって救われます。","tok":[["しかし"],["、"],["女","おんな"],["が"],["慎み","つつしみ"],["を"],["もって"],["、"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["聖","きよ"],["さ"],["と"],["を"],["保つなら","たもつなら"],["、"],["子","こ"],["を"],["産む","うむ"],["こと"],["によって"],["救われます","すくわれます"],["。"]]}]
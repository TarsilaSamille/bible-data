[{"verse":1,"text":"私たちの救い主なる神と私たちの望みなるキリスト・イエスとの命令による、キリスト・イエスの使徒パウロから、","tok":[["私たち","わたしたち"],["の"],["救い主","すくいぬし"],["なる"],["神","かみ"],["と"],["私たち","わたしたち"],["の"],["望み","のぞみ"],["なる"],["キリスト"],["・"],["イエス"],["と"],["の"],["命令","めいれい"],["に"],["よる"],["、"],["キリスト"],["・"],["イエス"],["の"],["使徒","しと"],["パウロ"],["から"],["、"]]},{"verse":2,"text":"信仰による真実のわが子テモテへ。父なる神と私たちの主なるキリスト・イエスから、恵みとあわれみと平安とがありますように。","tok":[["信仰","しんこう"],["に"],["よる"],["真実","しんじつ"],["の"],["わが"],["子","こ"],["テモテ"],["へ"],["。"],["父","ちち"],["なる"],["神","かみ"],["と"],["私たち","わたしたち"],["の"],["主","ぬし"],["なる"],["キリスト"],["・"],["イエス"],["から"],["、"],["恵み","めぐみ"],["と"],["あわれみ"],["と"],["平安","へいあん"],["と"],["が"],["あります"],["よう"],["に"],["。"]]},{"verse":3,"text":"私がマケドニヤに出発するとき、あなたにお願いしたように、あなたは、エペソにずっととどまっていて、ある人たちが違った教えを説いたり、","tok":[["私","わたくし"],["が"],["マケドニヤ"],["に"],["出発","しゅっぱつ"],["する"],["とき"],["、"],["あなた"],["に"],["お願い","おねがい"],["した"],["よう"],["に"],["、"],["あなた"],["は"],["、"],["エペソ"],["に"],["ずっと"],["とどまって"],["いて"],["、"],["ある"],["人","ひと"],["たち"],["が"],["違った","ちがった"],["教え","おしえ"],["を"],["説い","とい"],["たり"],["、"]]},{"verse":4,"text":"果てしのない空想話と系図とに心を奪われたりしないように命じてください。そのようなものは、論議を引き起こすだけで、信仰による神の救いのご計画の実現をもたらすものではありません。","tok":[["果てし","はてし"],["の"],["ない"],["空想","くうそう"],["話","はなし"],["と"],["系図","けいず"],["と"],["に"],["心","こころ"],["を"],["奪われ","うばわれ"],["たり"],["しない"],["よう"],["に"],["命じて","めいじて"],["ください"],["。"],["その"],["よう"],["な"],["もの"],["は"],["、"],["論議","ろんぎ"],["を"],["引き起こす","ひきおこす"],["だけ"],["で"],["、"],["信仰","しんこう"],["に"],["よる"],["神","かみ"],["の"],["救い","すくい"],["の"],["ご計画","ごけいかく"],["の"],["実現","じつげん"],["を"],["もたらす"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":5,"text":"この命令は、きよい心と正しい良心と偽りのない信仰とから出て来る愛を、目標としています。","tok":[["この"],["命令","めいれい"],["は"],["、"],["きよい"],["心","こころ"],["と"],["正しい","ただしい"],["良心","りょうしん"],["と"],["偽り","いつわり"],["の"],["ない"],["信仰","しんこう"],["と"],["から"],["出て","でて"],["来る","くる"],["愛","あい"],["を"],["、"],["目標","もくひょう"],["として"],["います"],["。"]]},{"verse":6,"text":"ある人たちはこの目当てを見失い、わき道にそれて無益な議論に走り、","tok":[["ある"],["人","ひと"],["たち"],["は"],["この"],["目当て","めあて"],["を"],["見失い","みうしない"],["、"],["わき道","わきみち"],["に"],["それ"],["て"],["無益","むえき"],["な"],["議論","ぎろん"],["に"],["走り","はしり"],["、"]]},{"verse":7,"text":"律法の教師でありたいと望みながら、自分の言っていることも、また強く主張していることについても理解していません。","tok":[["律法","りっぽう"],["の"],["教師","きょうし"],["で"],["ありたい"],["と"],["望み","のぞみ"],["ながら"],["、"],["自分","じぶん"],["の"],["言って","いって"],["いる"],["こと"],["も"],["、"],["また"],["強く","つよく"],["主張","しゅちょう"],["して"],["いる"],["こと"],["について"],["も"],["理解","りかい"],["して"],["いません"],["。"]]},{"verse":8,"text":"しかし私たちは知っています。律法は、もし次のことを知っていて正しく用いるならば、良いものです。","tok":[["しかし"],["私たち","わたしたち"],["は"],["知って","しって"],["います"],["。"],["律法","りっぽう"],["は"],["、"],["もし"],["次","つぎ"],["の"],["こと"],["を"],["知って","しって"],["いて"],["正しく","ただしく"],["用いるならば","もちいるならば"],["、"],["良い","よい"],["もの"],["です"],["。"]]},{"verse":9,"text":"すなわち、律法は、正しい人のためにあるのではなく、律法を無視する不従順な者、不敬虔な罪人、汚らわしい俗物、父や母を殺す者、人を殺す者、","tok":[["すなわち"],["、"],["律法","りっぽう"],["は"],["、"],["正しい","ただしい"],["人","ひと"],["の"],["ため"],["に"],["ある"],["ので"],["は"],["なく"],["、"],["律法","りっぽう"],["を"],["無視","むし"],["する"],["不","ふ"],["従順","じゅうじゅん"],["な"],["者","もの"],["、"],["不","ふ"],["敬虔","けいけん"],["な"],["罪人","ざいにん"],["、"],["汚らわしい","けがらわしい"],["俗物","ぞくぶつ"],["、"],["父","ちち"],["や"],["母","はは"],["を"],["殺す","ころす"],["者","もの"],["、"],["人","ひと"],["を"],["殺す","ころす"],["者","もの"],["、"]]},{"verse":10,"text":"不品行な者、男色をする者、人を誘拐する者、うそをつく者、偽証をする者などのため、またそのほか健全な教えにそむく事のためにあるのです。","tok":[["不品行","ふひんこう"],["な"],["者","もの"],["、"],["男色","だんしょく"],["を"],["する"],["者","もの"],["、"],["人","ひと"],["を"],["誘拐","ゆうかい"],["する"],["者","もの"],["、"],["うそ"],["を"],["つく"],["者","もの"],["、"],["偽証","ぎしょう"],["を"],["する"],["者","もの"],["など"],["の"],["ため"],["、"],["また"],["その"],["ほか"],["健全","けんぜん"],["な"],["教え","おしえ"],["に"],["そむく"],["事","こと"],["の"],["ため"],["に"],["ある"],["の"],["です"],["。"]]},{"verse":11,"text":"祝福に満ちた神の、栄光の福音によれば、こうなのであって、私はその福音をゆだねられたのです。","tok":[["祝福","しゅくふく"],["に"],["満ちた","みちた"],["神","かみ"],["の"],["、"],["栄光","えいこう"],["の"],["福音","ふくいん"],["に"],["よれば"],["、"],["こう"],["な"],["ので"],["あって"],["、"],["私","わたくし"],["は"],["その"],["福音","ふくいん"],["を"],["ゆだねられた"],["の"],["です"],["。"]]},{"verse":12,"text":"私は、私を強くしてくださる私たちの主キリスト・イエスに感謝をささげています。なぜなら、キリストは、私をこの務めに任命して、私を忠実な者と認めてくださったからです。","tok":[["私","わたくし"],["は"],["、"],["私","わたくし"],["を"],["強く","つよく"],["して"],["くださる"],["私たち","わたしたち"],["の"],["主","ぬし"],["キリスト"],["・"],["イエス"],["に"],["感謝","かんしゃ"],["を"],["ささげて"],["います"],["。"],["なぜ"],["なら"],["、"],["キリスト"],["は"],["、"],["私","わたくし"],["を"],["この"],["務め","つとめ"],["に"],["任命","にんめい"],["して"],["、"],["私","わたくし"],["を"],["忠実","ちゅうじつ"],["な"],["者","もの"],["と"],["認めて","みとめて"],["くださった"],["から"],["です"],["。"]]},{"verse":13,"text":"私は以前は、神をけがす者、迫害する者、暴力をふるう者でした。それでも、信じていないときに知らないでしたことなので、あわれみを受けたのです。","tok":[["私","わたくし"],["は"],["以前","いぜん"],["は"],["、"],["神","かみ"],["を"],["けがす"],["者","もの"],["、"],["迫害","はくがい"],["する"],["者","もの"],["、"],["暴力","ぼうりょく"],["を"],["ふるう"],["者","もの"],["でした"],["。"],["それ"],["で"],["も"],["、"],["信じて","しんじて"],["いない"],["とき"],["に"],["知らないでした","しらないでした"],["こと"],["な"],["ので"],["、"],["あわれみ"],["を"],["受けた","うけた"],["の"],["です"],["。"]]},{"verse":14,"text":"私たちの主の、この恵みは、キリスト・イエスにある信仰と愛とともに、ますます満ちあふれるようになりました。","tok":[["私たち","わたしたち"],["の"],["主","ぬし"],["の"],["、"],["この"],["恵み","めぐみ"],["は"],["、"],["キリスト"],["・"],["イエス"],["に"],["ある"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["とも"],["に"],["、"],["ますます"],["満ちあふれる","みちあふれる"],["よう"],["に"],["なりました"],["。"]]},{"verse":15,"text":"「キリスト・イエスは、罪人を救うためにこの世に来られた」ということばは、まことであり、そのまま受け入れるに値するものです。私はその罪人のかしらです。","tok":[["「"],["キリスト"],["・"],["イエス"],["は"],["、"],["罪人","ざいにん"],["を"],["救う","すくう"],["ため"],["に"],["この世","このよ"],["に"],["来られた","こられた"],["」"],["と"],["いう"],["ことば"],["は"],["、"],["まこと"],["で"],["あり"],["、"],["そのまま"],["受け入れる","うけいれる"],["に"],["値","あたい"],["する"],["もの"],["です"],["。"],["私","わたくし"],["は"],["その"],["罪人","ざいにん"],["の"],["かしら"],["です"],["。"]]},{"verse":16,"text":"しかし、そのような私があわれみを受けたのは、イエス・キリストが、今後彼を信じて永遠のいのちを得ようとしている人々の見本にしようと、まず私に対してこの上ない寛容を示してくださったからです。","tok":[["しかし"],["、"],["その"],["よう"],["な"],["私","わたくし"],["が"],["あわれみ"],["を"],["受けた","うけた"],["の"],["は"],["、"],["イエス"],["・"],["キリスト"],["が"],["、"],["今後","こんご"],["彼","かれ"],["を"],["信じて","しんじて"],["永遠","えいえん"],["の"],["いのち"],["を"],["得よう","えよう"],["として"],["いる"],["人々","ひとびと"],["の"],["見本","みほん"],["に"],["しよう"],["と"],["、"],["まず"],["私","わたくし"],["に対して","にたいして"],["この"],["上","うえ"],["ない"],["寛容","かんよう"],["を"],["示して","しめして"],["くださった"],["から"],["です"],["。"]]},{"verse":17,"text":"どうか、世々の王、すなわち、滅びることなく、目に見えない唯一の神に、誉れと栄えとが世々限りなくありますように。アーメン。","tok":[["どう"],["か"],["、"],["世々","せいせい"],["の"],["王","おう"],["、"],["すなわち"],["、"],["滅びる","ほろびる"],["こと"],["なく"],["、"],["目","め"],["に"],["見えない","みえない"],["唯一","ゆいいつ"],["の"],["神","かみ"],["に"],["、"],["誉れ","ほまれ"],["と"],["栄え","はえ"],["と"],["が"],["世々","せいせい"],["限りなく","かぎりなく"],["あります"],["よう"],["に"],["。"],["アーメン"],["。"]]},{"verse":18,"text":"私の子テモテよ。以前あなたについてなされた預言に従って、私はあなたにこの命令をゆだねます。それは、あなたがあの預言によって、信仰と正しい良心を保ち、勇敢に戦い抜くためです。","tok":[["私","わたくし"],["の"],["子","こ"],["テモテ"],["よ"],["。"],["以前","いぜん"],["あなた"],["について"],["なされた"],["預言","よげん"],["に"],["従って","したがって"],["、"],["私","わたくし"],["は"],["あなた"],["に"],["この"],["命令","めいれい"],["を"],["ゆだねます"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["あの"],["預言","よげん"],["によって"],["、"],["信仰","しんこう"],["と"],["正しい","ただしい"],["良心","りょうしん"],["を"],["保ち","たもち"],["、"],["勇敢","ゆうかん"],["に"],["戦い","たたかい"],["抜く","ぬく"],["ため"],["です"],["。"]]},{"verse":19,"text":"ある人たちは、正しい良心を捨てて、信仰の破船に会いました。","tok":[["ある"],["人","ひと"],["たち"],["は"],["、"],["正しい","ただしい"],["良心","りょうしん"],["を"],["捨てて","すてて"],["、"],["信仰","しんこう"],["の"],["破船","はせん"],["に"],["会いました","あいました"],["。"]]},{"verse":20,"text":"その中には、ヒメナオとアレキサンデルがいます。私は、彼らをサタンに引き渡しました。それは、神をけがしてはならないことを、彼らに学ばせるためです。","tok":[["その"],["中","なか"],["に"],["は"],["、"],["ヒメナオ"],["と"],["アレキサンデル"],["が"],["います"],["。"],["私","わたくし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["サタン"],["に"],["引き渡しました","ひきわたしました"],["。"],["それ"],["は"],["、"],["神","かみ"],["を"],["けがして"],["は"],["ならない"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["に"],["学ばせる","まなばせる"],["ため"],["です"],["。"]]}]
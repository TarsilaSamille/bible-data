[{"verse":1,"text":"しかし、御霊が明らかに言われるように、後の時代になると、ある人たちは惑わす霊と悪霊の教えとに心を奪われ、信仰から離れるようになります。","tok":[["しかし"],["、"],["御霊","ごれい"],["が"],["明らか","あきらか"],["に"],["言われる","いわれる"],["よう"],["に"],["、"],["後","あと"],["の"],["時代","じだい"],["に"],["なる"],["と"],["、"],["ある"],["人","ひと"],["たち"],["は"],["惑わす","まどわす"],["霊","れい"],["と"],["悪霊","あくりょう"],["の"],["教え","おしえ"],["と"],["に"],["心","こころ"],["を"],["奪われ","うばわれ"],["、"],["信仰","しんこう"],["から"],["離れる","はなれる"],["よう"],["に"],["なります"],["。"]]},{"verse":2,"text":"それは、うそつきどもの偽善によるものです。彼らは良心が麻痺しており、","tok":[["それ"],["は"],["、"],["うそつき"],["ども"],["の"],["偽善","ぎぜん"],["に"],["よる"],["もの"],["です"],["。"],["彼","かれ"],["ら"],["は"],["良心","りょうしん"],["が"],["麻痺","まひ"],["して"],["おり"],["、"]]},{"verse":3,"text":"結婚することを禁じたり、食物を断つことを命じたりします。しかし食物は、信仰があり、真理を知っている人が感謝して受けるようにと、神が造られた物です。","tok":[["結婚","けっこん"],["する"],["こと"],["を"],["禁じ","きんじ"],["たり"],["、"],["食物","しょくもつ"],["を"],["断つ","たつ"],["こと"],["を"],["命じ","めいじ"],["たり"],["します"],["。"],["しかし"],["食物","しょくもつ"],["は"],["、"],["信仰","しんこう"],["が"],["あり"],["、"],["真理","しんり"],["を"],["知って","しって"],["いる"],["人","ひと"],["が"],["感謝","かんしゃ"],["して"],["受ける","うける"],["よう"],["に"],["と"],["、"],["神","かみ"],["が"],["造られた","つくられた"],["物","もの"],["です"],["。"]]},{"verse":4,"text":"神が造られた物はみな良い物で、感謝して受けるとき、捨てるべき物は何一つありません。","tok":[["神","かみ"],["が"],["造られた","つくられた"],["物","もの"],["は"],["みな"],["良い","よい"],["物","もの"],["で"],["、"],["感謝","かんしゃ"],["して"],["受ける","うける"],["とき"],["、"],["捨てるべき","すてるべき"],["物","もの"],["は"],["何","なん"],["一","ひと"],["つ"],["ありません"],["。"]]},{"verse":5,"text":"神のことばと祈りとによって、聖められるからです。","tok":[["神","かみ"],["の"],["ことば"],["と"],["祈り","いのり"],["と"],["によって"],["、"],["聖","せい"],["められる"],["から"],["です"],["。"]]},{"verse":6,"text":"これらのことを兄弟たちに教えるなら、あなたはキリスト・イエスのりっぱな奉仕者になります。信仰のことばと、あなたが従って来た良い教えのことばとによって養われているからです。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["兄弟","きょうだい"],["たち"],["に"],["教えるなら","おしえるなら"],["、"],["あなた"],["は"],["キリスト"],["・"],["イエス"],["の"],["りっぱ"],["な"],["奉仕者","ほうししゃ"],["に"],["なります"],["。"],["信仰","しんこう"],["の"],["ことば"],["と"],["、"],["あなた"],["が"],["従って","したがって"],["来た","きた"],["良い","よい"],["教え","おしえ"],["の"],["ことば"],["と"],["によって"],["養われて","やしなわれて"],["いる"],["から"],["です"],["。"]]},{"verse":7,"text":"俗悪で愚にもつかぬ空想話を避けなさい。むしろ、敬虔のために自分を鍛練しなさい。","tok":[["俗悪","ぞくあく"],["で"],["愚","ぐ"],["に"],["も"],["つかぬ"],["空想","くうそう"],["話","はなし"],["を"],["避け","さけ"],["なさい"],["。"],["むしろ"],["、"],["敬虔","けいけん"],["の"],["ため"],["に"],["自分","じぶん"],["を"],["鍛練","たんれん"],["し"],["なさい"],["。"]]},{"verse":8,"text":"肉体の鍛練もいくらかは有益ですが、今のいのちと未来のいのちが約束されている敬虔は、すべてに有益です。","tok":[["肉体","にくたい"],["の"],["鍛練","たんれん"],["も"],["いくら"],["か"],["は"],["有益","ゆうえき"],["です"],["が"],["、"],["今","いま"],["の"],["いのち"],["と"],["未来","みらい"],["の"],["いのち"],["が"],["約束","やくそく"],["されて"],["いる"],["敬虔","けいけん"],["は"],["、"],["すべて"],["に"],["有益","ゆうえき"],["です"],["。"]]},{"verse":9,"text":"このことばは、真実であり、そのまま受け入れるに値することばです。","tok":[["この"],["ことば"],["は"],["、"],["真実","しんじつ"],["で"],["あり"],["、"],["そのまま"],["受け入れる","うけいれる"],["に"],["値","あたい"],["する"],["ことば"],["です"],["。"]]},{"verse":10,"text":"私たちはそのために労し、また苦心しているのです。それは、すべての人々、ことに信じる人々の救い主である、生ける神に望みを置いているからです。","tok":[["私たち","わたしたち"],["は"],["その"],["ため"],["に"],["労し","ろうし"],["、"],["また"],["苦心","くしん"],["して"],["いる"],["の"],["です"],["。"],["それ"],["は"],["、"],["すべて"],["の"],["人々","ひとびと"],["、"],["こと"],["に"],["信じる","しんじる"],["人々","ひとびと"],["の"],["救い主","すくいぬし"],["で"],["ある"],["、"],["生ける","いける"],["神","かみ"],["に"],["望み","のぞみ"],["を"],["置いて","おいて"],["いる"],["から"],["です"],["。"]]},{"verse":11,"text":"これらのことを命じ、また教えなさい。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["命じ","めいじ"],["、"],["また"],["教え","おしえ"],["なさい"],["。"]]},{"verse":12,"text":"年が若いからといって、だれにも軽く見られないようにしなさい。かえって、ことばにも、態度にも、愛にも、信仰にも、純潔にも信者の模範になりなさい。","tok":[["年","ねん"],["が"],["若い","わかい"],["から"],["と"],["いって"],["、"],["だれ"],["に"],["も"],["軽く","かるく"],["見られない","みられない"],["よう"],["に"],["し"],["なさい"],["。"],["かえって"],["、"],["ことば"],["に"],["も"],["、"],["態度","たいど"],["に"],["も"],["、"],["愛","あい"],["に"],["も"],["、"],["信仰","しんこう"],["に"],["も"],["、"],["純潔","じゅんけつ"],["に"],["も"],["信者","しんじゃ"],["の"],["模範","もはん"],["に"],["なり"],["なさい"],["。"]]},{"verse":13,"text":"私が行くまで、聖書の朗読と勧めと教えとに専念しなさい。","tok":[["私","わたくし"],["が"],["行く","いく"],["まで"],["、"],["聖書","せいしょ"],["の"],["朗読","ろうどく"],["と"],["勧め","すすめ"],["と"],["教え","おしえ"],["と"],["に"],["専念","せんねん"],["し"],["なさい"],["。"]]},{"verse":14,"text":"長老たちによる按手を受けたとき、預言によって与えられた、あなたのうちにある聖霊の賜物を軽んじてはいけません。","tok":[["長老","ちょうろう"],["たち"],["に"],["よる"],["按手","あんしゅ"],["を"],["受けた","うけた"],["とき"],["、"],["預言","よげん"],["によって"],["与えられた","あたえられた"],["、"],["あなた"],["の"],["うち"],["に"],["ある"],["聖霊","せいれい"],["の"],["賜物","たまもの"],["を"],["軽んじて","かろんじて"],["は"],["いけません"],["。"]]},{"verse":15,"text":"これらの務めに心を砕き、しっかりやりなさい。そうすれば、あなたの進歩はすべての人に明らかになるでしょう。","tok":[["これ"],["ら"],["の"],["務め","つとめ"],["に"],["心","こころ"],["を"],["砕き","くだき"],["、"],["しっかり"],["やり"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["進歩","しんぽ"],["は"],["すべて"],["の"],["人","ひと"],["に"],["明らか","あきらか"],["に"],["なるでしょう"],["。"]]},{"verse":16,"text":"自分自身にも、教える事にも、よく気をつけなさい。あくまでそれを続けなさい。そうすれば、自分自身をも、またあなたの教えを聞く人たちをも救うことになります。","tok":[["自分","じぶん"],["自身","じしん"],["に"],["も"],["、"],["教える","おしえる"],["事","こと"],["に"],["も"],["、"],["よく"],["気","き"],["を"],["つけ"],["なさい"],["。"],["あくまで"],["それ"],["を"],["続け","つづけ"],["なさい"],["。"],["そう"],["すれば"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["も"],["、"],["また"],["あなた"],["の"],["教え","おしえ"],["を"],["聞く","きく"],["人","ひと"],["たち"],["を"],["も"],["救う","すくう"],["こと"],["に"],["なります"],["。"]]}]
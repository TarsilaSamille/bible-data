[{"verse":1,"text":"神のみこころによるキリスト・イエスの使徒パウロから、キリスト・イエスにある忠実なエペソの聖徒たちへ。","tok":[["神","かみ"],["のみ"],["こころ"],["に"],["よる"],["キリスト"],["・"],["イエス"],["の"],["使徒","しと"],["パウロ"],["から"],["、"],["キリスト"],["・"],["イエス"],["に"],["ある"],["忠実","ちゅうじつ"],["な"],["エペソ"],["の"],["聖徒","せいと"],["たち"],["へ"],["。"]]},{"verse":2,"text":"私たちの父なる神と主イエス・キリストから、恵みと平安があなたがたの上にありますように。","tok":[["私たち","わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"]]},{"verse":3,"text":"私たちの主イエス・キリストの父なる神がほめたたえられますように。神はキリストにあって、天にあるすべての霊的祝福をもって私たちを祝福してくださいました。","tok":[["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["が"],["ほめたたえられます"],["よう"],["に"],["。"],["神","かみ"],["は"],["キリスト"],["に"],["あって"],["、"],["天","てん"],["に"],["ある"],["すべて"],["の"],["霊的","れいてき"],["祝福","しゅくふく"],["を"],["もって"],["私たち","わたしたち"],["を"],["祝福","しゅくふく"],["して"],["くださいました"],["。"]]},{"verse":4,"text":"すなわち、神は私たちを世界の基の置かれる前から彼にあって選び、御前で聖く、傷のない者にしようとされました。","tok":[["すなわち"],["、"],["神","かみ"],["は"],["私たち","わたしたち"],["を"],["世界","せかい"],["の"],["基","もと"],["の"],["置かれる","おかれる"],["前","まえ"],["から"],["彼","かれ"],["に"],["あって"],["選び","えらび"],["、"],["御前","ごぜん"],["で"],["聖く","きよく"],["、"],["傷","きず"],["の"],["ない"],["者","もの"],["に"],["しよう"],["と"],["されました"],["。"]]},{"verse":5,"text":"神は、みむねとみこころのままに、私たちをイエス・キリストによってご自分の子にしようと、愛をもってあらかじめ定めておられました。","tok":[["神","かみ"],["は"],["、"],["みむね"],["と"],["みこころ"],["の"],["まま"],["に"],["、"],["私たち","わたしたち"],["を"],["イエス"],["・"],["キリスト"],["によって"],["ご自分","ごじぶん"],["の"],["子","こ"],["に"],["しよう"],["と"],["、"],["愛","あい"],["を"],["もって"],["あらかじめ"],["定めて","さだめて"],["おられました"],["。"]]},{"verse":6,"text":"それは、神がその愛する方にあって私たちに与えてくださった恵みの栄光が、ほめたたえられるためです。","tok":[["それ"],["は"],["、"],["神","かみ"],["が"],["その"],["愛する","あいする"],["方","ほう"],["に"],["あって"],["私たち","わたしたち"],["に"],["与えて","あたえて"],["くださった"],["恵み","めぐみ"],["の"],["栄光","えいこう"],["が"],["、"],["ほめたたえられる"],["ため"],["です"],["。"]]},{"verse":7,"text":"この
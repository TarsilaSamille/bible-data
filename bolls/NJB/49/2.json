[{"verse":1,"text":"あなたがたは自分の罪過と罪との中に死んでいた者であって、","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["の"],["罪過","ざいか"],["と"],["罪","つみ"],["と"],["の"],["中","なか"],["に"],["死んで","しんで"],["いた"],["者","もの"],["で"],["あって"],["、"]]},{"verse":2,"text":"そのころは、それらの罪の中にあってこの世の流れに従い、空中の権威を持つ支配者として今も不従順の子らの中に働いている霊に従って、歩んでいました。","tok":[["その"],["ころ"],["は"],["、"],["それ"],["ら"],["の"],["罪","つみ"],["の"],["中","なか"],["に"],["あって"],["この世","このよ"],["の"],["流れ","ながれ"],["に"],["従い","したがい"],["、"],["空中","くうちゅう"],["の"],["権威","けんい"],["を"],["持つ","もつ"],["支配者","しはいしゃ"],["として"],["今","いま"],["も"],["不","ふ"],["従順","じゅうじゅん"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["に"],["働いて","はたらいて"],["いる"],["霊","れい"],["に"],["従って","したがって"],["、"],["歩んで","あゆんで"],["いました"],["。"]]},{"verse":3,"text":"私たちもみな、かつては不従順の子らの中にあって、自分の肉の欲の中に生き、肉と心の望むままを行い、ほかの人たちと同じように、生まれながら御怒りを受けるべき子らでした。","tok":[["私たち","わたしたち"],["も"],["みな"],["、"],["かつて"],["は"],["不","ふ"],["従順","じゅうじゅん"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["に"],["あって"],["、"],["自分","じぶん"],["の"],["肉","にく"],["の"],["欲","よく"],["の"],["中","なか"],["に"],["生き","いき"],["、"],["肉","にく"],["と"],["心","こころ"],["の"],["望む","のぞむ"],["まま"],["を"],["行い","おこない"],["、"],["ほか"],["の"],["人","ひと"],["たち"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["生まれ","うまれ"],["ながら"],["御怒り","おいかり"],["を"],["受けるべき","うけるべき"],["子","こ"],["ら"],["でした"],["。"]]},{"verse":4,"text":"しかし、あわれみ豊かな神は、私たちを愛してくださったその大きな愛のゆえに、","tok":[["しかし"],["、"],["あわれみ"],["豊か","ゆたか"],["な"],["神","かみ"],["は"],["、"],["私たち","わたしたち"],["を"],["愛して","あいして"],["くださった"],["その"],["大きな","おおきな"],["愛","あい"],["の"],["ゆえ"],["に"],["、"]]},{"verse":5,"text":"罪過の中に死んでいたこの私たちをキリストとともに生かし、――あなたがたが救われたのは、ただ恵みによるのです――","tok":[["罪過","ざいか"],["の"],["中","なか"],["に"],["死んで","しんで"],["いた"],["この"],["私たち","わたしたち"],["を"],["キリスト"],["と"],["とも"],["に"],["生かし","いかし"],["、"],["―"],["―"],["あなた"],["がた"],["が"],["救われた","すくわれた"],["の"],["は"],["、"],["ただ"],["恵み","めぐみ"],["に"],["よる"],["の"],["です"],["―"],["―"]]},{"verse":6,"text":"キリスト・イエスにおいて、ともによみがえらせ、ともに天の所にすわらせてくださいました。","tok":[["キリスト"],["・"],["イエス"],["に"],["おいて"],["、"],["とも"],["に"],["よみがえらせ"],["、"],["とも"],["に"],["天","てん"],["の"],["所","ところ"],["に"],["すわらせて"],["くださいました"],["。"]]},{"verse":7,"text":"それは、あとに来る世々において、このすぐれて豊かな御恵みを、キリスト・イエスにおいて私たちに賜る慈愛によって明らかにお示しになるためでした。","tok":[["それ"],["は"],["、"],["あと"],["に"],["来る","くる"],["世々","せいせい"],["に"],["おいて"],["、"],["この"],["すぐれて"],["豊か","ゆたか"],["な"],["御恵み","おめぐみ"],["を"],["、"],["キリスト"],["・"],["イエス"],["に"],["おいて"],["私たち","わたしたち"],["に"],["賜る","たまわる"],["慈愛","じあい"],["によって"],["明らか","あきらか"],["に"],["お示し","おしめし"],["に"],["なる"],["ため"],["でした"],["。"]]},{"verse":8,"text":"あなたがたは、恵みのゆえに、信仰によって救われたのです。それは、自分自身から出たことではなく、神からの賜物です。","tok":[["あなた"],["がた"],["は"],["、"],["恵み","めぐみ"],["の"],["ゆえ"],["に"],["、"],["信仰","しんこう"],["によって"],["救われた","すくわれた"],["の"],["です"],["。"],["それ"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["から"],["出た","でた"],["こと"],["で"],["は"],["なく"],["、"],["神","かみ"],["から"],["の"],["賜物","たまもの"],["です"],["。"]]},{"verse":9,"text":"行いによるのではありません。だれも誇ることのないためです。","tok":[["行い","おこない"],["に"],["よる"],["ので"],["は"],["ありません"],["。"],["だれ"],["も"],["誇る","ほこる"],["こと"],["の"],["ない"],["ため"],["です"],["。"]]},{"verse":10,"text":"私たちは神の作品であって、良い行いをするためにキリスト・イエスにあって造られたのです。神は、私たちが良い行いに歩むように、その良い行いをもあらかじめ備えてくださったのです。","tok":[["私たち","わたしたち"],["は"],["神","かみ"],["の"],["作品","さくひん"],["で"],["あって"],["、"],["良い","よい"],["行い","おこない"],["を"],["する"],["ため"],["に"],["キリスト"],["・"],["イエス"],["に"],["あって"],["造られた","つくられた"],["の"],["です"],["。"],["神","かみ"],["は"],["、"],["私たち","わたしたち"],["が"],["良い","よい"],["行い","おこない"],["に"],["歩む","あゆむ"],["よう"],["に"],["、"],["その"],["良い","よい"],["行い","おこない"],["を"],["も"],["あらかじめ"],["備えて","そなえて"],["くださった"],["の"],["です"],["。"]]},{"verse":11,"text":"ですから、思い出してください。あなたがたは、以前は肉において異邦人でした。すなわち、肉において人の手による、いわゆる割礼を持つ人々からは、無割礼の人々と呼ばれる者であって、","tok":[["です"],["から"],["、"],["思い出して","おもいだして"],["ください"],["。"],["あなた"],["がた"],["は"],["、"],["以前","いぜん"],["は"],["肉","にく"],["に"],["おいて"],["異邦人","いほうじん"],["でした"],["。"],["すなわち"],["、"],["肉","にく"],["に"],["おいて"],["人","ひと"],["の"],["手","て"],["に"],["よる"],["、"],["いわゆる"],["割礼","かつれい"],["を"],["持つ","もつ"],["人々","ひとびと"],["から"],["は"],["、"],["無","む"],["割礼","かつれい"],["の"],["人々","ひとびと"],["と"],["呼ばれる","よばれる"],["者","もの"],["で"],["あって"],["、"]]},{"verse":12,"text":"そのころのあなたがたは、キリストから離れ、イスラエルの国から除外され、約束の契約については他国人であり、この世にあって望みもなく、神もない人たちでした。","tok":[["その"],["ころ"],["の"],["あなた"],["がた"],["は"],["、"],["キリスト"],["から"],["離れ","はなれ"],["、"],["イスラエル"],["の"],["国","くに"],["から"],["除外","じょがい"],["され"],["、"],["約束","やくそく"],["の"],["契約","けいやく"],["について"],["は"],["他国人","たこくにん"],["で"],["あり"],["、"],["この世","このよ"],["に"],["あって"],["望み","のぞみ"],["も"],["なく"],["、"],["神","かみ"],["も"],["ない"],["人","ひと"],["たち"],["でした"],["。"]]},{"verse":13,"text":"しかし、以前は遠く離れていたあなたがたも、今ではキリスト・イエスの中にあることにより、キリストの血によって近い者とされたのです。","tok":[["しかし"],["、"],["以前","いぜん"],["は"],["遠く","とおく"],["離れて","はなれて"],["いた"],["あなた"],["がた"],["も"],["、"],["今","いま"],["で"],["は"],["キリスト"],["・"],["イエス"],["の"],["中","なか"],["に"],["ある"],["こと"],["に"],["より"],["、"],["キリスト"],["の"],["血","ち"],["によって"],["近い","ちかい"],["者","もの"],["と"],["された"],["の"],["です"],["。"]]},{"verse":14,"text":"キリストこそ私たちの平和であり、二つのものを一つにし、隔ての壁を打ちこわし、","tok":[["キリスト"],["こそ"],["私たち","わたしたち"],["の"],["平和","へいわ"],["で"],["あり"],["、"],["二","ふた"],["つ"],["の"],["もの"],["を"],["一","ひと"],["つ"],["に"],["し"],["、"],["隔て","へだて"],["の"],["壁","かべ"],["を"],["打ちこわし","うちこわし"],["、"]]},{"verse":15,"text":"ご自分の肉において、敵意を廃棄された方です。敵意とは、さまざまの規定から成り立っている戒めの律法なのです。このことは、二つのものをご自身において新しいひとりの人に造り上げて、平和を実現するためであり、","tok":[["ご自分","ごじぶん"],["の"],["肉","にく"],["に"],["おいて"],["、"],["敵意","てきい"],["を"],["廃棄","はいき"],["された"],["方","ほう"],["です"],["。"],["敵意","てきい"],["と"],["は"],["、"],["さまざま"],["の"],["規定","きてい"],["から"],["成り立って","なりたって"],["いる"],["戒め","いましめ"],["の"],["律法","りっぽう"],["な"],["の"],["です"],["。"],["この"],["こと"],["は"],["、"],["二","ふた"],["つ"],["の"],["もの"],["を"],["ご自身","ごじしん"],["に"],["おいて"],["新しい","あたらしい"],["ひとり"],["の"],["人","ひと"],["に"],["造り上げて","つくりあげて"],["、"],["平和","へいわ"],["を"],["実現","じつげん"],["する"],["ため"],["で"],["あり"],["、"]]},{"verse":16,"text":"また、両者を一つのからだとして、十字架によって神と和解させるためなのです。敵意は十字架によって葬り去られました。","tok":[["また"],["、"],["両者","りょうしゃ"],["を"],["一","ひと"],["つ"],["の"],["からだ"],["として"],["、"],["十字架","じゅうじか"],["によって"],["神","かみ"],["と"],["和解","わかい"],["させる"],["ため"],["な"],["の"],["です"],["。"],["敵意","てきい"],["は"],["十字架","じゅうじか"],["によって"],["葬り去られました","ほうむりさられました"],["。"]]},{"verse":17,"text":"それからキリストは来られて、遠くにいたあなたがたに平和を宣べ、近くにいた人たちにも平和を宣べられました。","tok":[["それ"],["から"],["キリスト"],["は"],["来られて","こられて"],["、"],["遠く","とおく"],["に"],["いた"],["あなた"],["がた"],["に"],["平和","へいわ"],["を"],["宣べ","のべ"],["、"],["近く","ちかく"],["に"],["いた"],["人","ひと"],["たち"],["に"],["も"],["平和","へいわ"],["を"],["宣べられました","のべられました"],["。"]]},{"verse":18,"text":"私たちは、このキリストによって、両者ともに一つの御霊において、父のみもとに近づくことができるのです。","tok":[["私たち","わたしたち"],["は"],["、"],["この"],["キリスト"],["によって"],["、"],["両者","りょうしゃ"],["とも"],["に"],["一","ひと"],["つ"],["の"],["御霊","ごれい"],["に"],["おいて"],["、"],["父","ちち"],["のみ"],["もと"],["に"],["近づく","ちかづく"],["こと"],["が"],["できる"],["の"],["です"],["。"]]},{"verse":19,"text":"こういうわけで、あなたがたは、もはや他国人でも寄留者でもなく、今は聖徒たちと同じ国民であり、神の家族なのです。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["あなた"],["がた"],["は"],["、"],["もはや"],["他国人","たこくにん"],["で"],["も"],["寄留者","きりゅうしゃ"],["で"],["も"],["なく"],["、"],["今","いま"],["は"],["聖徒","せいと"],["たち"],["と"],["同じ","おなじ"],["国民","こくみん"],["で"],["あり"],["、"],["神","かみ"],["の"],["家族","かぞく"],["な"],["の"],["です"],["。"]]},{"verse":20,"text":"あなたがたは使徒と預言者という土台の上に建てられており、キリスト・イエスご自身がその礎石です。","tok":[["あなた"],["がた"],["は"],["使徒","しと"],["と"],["預言者","よげんしゃ"],["と"],["いう"],["土台","どだい"],["の"],["上","うえ"],["に"],["建てられて","たてられて"],["おり"],["、"],["キリスト"],["・"],["イエス"],["ご自身","ごじしん"],["が"],["その"],["礎石","そせき"],["です"],["。"]]},{"verse":21,"text":"この方にあって、組み合わされた建物の全体が成長し、主にある聖なる宮となるのであり、","tok":[["この"],["方","かた"],["に"],["あって"],["、"],["組み合わされた","くみあわされた"],["建物","たてもの"],["の"],["全体","ぜんたい"],["が"],["成長","せいちょう"],["し"],["、"],["主に","おもに"],["ある"],["聖","せい"],["なる"],["宮","みや"],["と"],["なる"],["ので"],["あり"],["、"]]},{"verse":22,"text":"このキリストにあって、あなたがたもともに建てられ、御霊によって神の御住まいとなるのです。","tok":[["この"],["キリスト"],["に"],["あって"],["、"],["あなた"],["が"],["たもと"],["も"],["に"],["建てられ","たてられ"],["、"],["御霊","ごれい"],["によって"],["神","かみ"],["の"],["御住まい","おすまい"],["と"],["なる"],["の"],["です"],["。"]]}]
[{"verse":1,"text":"さて、主の囚人である私はあなたがたに勧めます。召されたあなたがたは、その召しにふさわしく歩みなさい。","tok":[["さて"],["、"],["主","ぬし"],["の"],["囚人","しゅうじん"],["で"],["ある"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["勧めます","すすめます"],["。"],["召された","めされた"],["あなた"],["がた"],["は"],["、"],["その"],["召し","めし"],["に"],["ふさわしく"],["歩み","あゆみ"],["なさい"],["。"]]},{"verse":2,"text":"謙遜と柔和の限りを尽くし、寛容を示し、愛をもって互いに忍び合い、","tok":[["謙遜","けんそん"],["と"],["柔和","にゅうわ"],["の"],["限り","かぎり"],["を"],["尽くし","つくし"],["、"],["寛容","かんよう"],["を"],["示し","しめし"],["、"],["愛","あい"],["を"],["もって"],["互い","たがい"],["に"],["忍び","しのび"],["合い","あい"],["、"]]},{"verse":3,"text":"平和のきずなで結ばれて御霊の一致を熱心に保ちなさい。","tok":[["平和","へいわ"],["の"],["きずな"],["で"],["結ばれて","むすばれて"],["御霊","ごれい"],["の"],["一致","いっち"],["を"],["熱心","ねっしん"],["に"],["保ち","たもち"],["なさい"],["。"]]},{"verse":4,"text":"からだは一つ、御霊は一つです。あなたがたが召されたとき、召しのもたらした望みが一つであったのと同じです。","tok":[["からだ"],["は"],["一","ひと"],["つ"],["、"],["御霊","ごれい"],["は"],["一","ひと"],["つ"],["です"],["。"],["あなた"],["がた"],["が"],["召された","めされた"],["とき"],["、"],["召し","めし"],["の"],["もたらした"],["望み","のぞみ"],["が"],["一","ひと"],["つ"],["で"],["あった"],["の"],["と"],["同じ","おなじ"],["です"],["。"]]},{"verse":5,"text":"主は一つ、信仰は一つ、バプテスマは一つです。","tok":[["主","ぬし"],["は"],["一","ひと"],["つ"],["、"],["信仰","しんこう"],["は"],["一","ひと"],["つ"],["、"],["バプテスマ"],["は"],["一","ひと"],["つ"],["です"],["。"]]},{"verse":6,"text":"すべてのものの上にあり、すべてのものを貫き、すべてのもののうちにおられる、すべてのものの父なる神は一つです。","tok":[["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["あり"],["、"],["すべて"],["の"],["もの"],["を"],["貫き","つらぬき"],["、"],["すべて"],["の"],["もの"],["の"],["うち"],["に"],["おられる"],["、"],["すべて"],["の"],["もの"],["の"],["父","ちち"],["なる"],["神","かみ"],["は"],["一","ひと"],["つ"],["です"],["。"]]},{"verse":7,"text":"しかし、私たちはひとりひとり、キリストの賜物の量りに従って恵みを与えられました。","tok":[["しかし"],["、"],["私たち","わたしたち"],["は"],["ひとりひとり"],["、"],["キリスト"],["の"],["賜物","たまもの"],["の"],["量り","はかり"],["に"],["従って","したがって"],["恵み","めぐみ"],["を"],["与えられました","あたえられました"],["。"]]},{"verse":8,"text":"そこで、こう言われています。「高い所に上られたとき、彼は多くの捕虜を引き連れ、人々に賜物を分け与えられた。」","tok":[["そこ"],["で"],["、"],["こう"],["言われて","いわれて"],["います"],["。"],["「"],["高い","たかい"],["所","ところ"],["に"],["上られた","のぼられた"],["とき"],["、"],["彼","かれ"],["は"],["多く","おおく"],["の"],["捕虜","ほりょ"],["を"],["引き連れ","ひきつれ"],["、"],["人々","ひとびと"],["に"],["賜物","たまもの"],["を"],["分け与えられた","わけあたえられた"],["。"],["」"]]},{"verse":9,"text":"――この「上られた」ということばは、彼がまず地の低い所に下られた、ということでなくて何でしょう。","tok":[["―"],["―"],["この"],["「"],["上られた","のぼられた"],["」"],["と"],["いう"],["ことば"],["は"],["、"],["彼","かれ"],["が"],["まず"],["地","ち"],["の"],["低い","ひくい"],["所","ところ"],["に"],["下られた","くだられた"],["、"],["と"],["いう"],["こと"],["で"],["なくて"],["何","なん"],["でしょう"],["。"]]},{"verse":10,"text":"この下られた方自身が、すべてのものを満たすために、もろもろの天よりも高く上られた方なのです――","tok":[["この"],["下られた","くだられた"],["方","ほう"],["自身","じしん"],["が"],["、"],["すべて"],["の"],["もの"],["を"],["満たす","みたす"],["ため"],["に"],["、"],["もろもろ"],["の"],["天","てん"],["より"],["も"],["高く","たかく"],["上られた","のぼられた"],["方","ほう"],["な"],["の"],["です"],["―"],["―"]]},{"verse":11,"text":"こうして、キリストご自身が、ある人を使徒、ある人を預言者、ある人を伝道者、ある人を牧師また教師として、お立てになったのです。","tok":[["こう"],["して"],["、"],["キリスト"],["ご自身","ごじしん"],["が"],["、"],["ある"],["人","ひと"],["を"],["使徒","しと"],["、"],["ある"],["人","ひと"],["を"],["預言者","よげんしゃ"],["、"],["ある"],["人","ひと"],["を"],["伝道者","でんどうしゃ"],["、"],["ある"],["人","ひと"],["を"],["牧師","ぼくし"],["また"],["教師","きょうし"],["として"],["、"],["お立て","おたて"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":12,"text":"それは、聖徒たちを整えて奉仕の働きをさせ、キリストのからだを建て上げるためであり、","tok":[["それ"],["は"],["、"],["聖徒","せいと"],["たち"],["を"],["整えて","ととのえて"],["奉仕","ほうし"],["の"],["働き","はたらき"],["を"],["させ"],["、"],["キリスト"],["の"],["からだ"],["を"],["建て","たて"],["上げる","あげる"],["ため"],["で"],["あり"],["、"]]},{"verse":13,"text":"ついに、私たちがみな、信仰の一致と神の御子に関する知識の一致とに達し、完全におとなになって、キリストの満ち満ちた身たけにまで達するためです。","tok":[["ついに"],["、"],["私たち","わたしたち"],["が"],["みな"],["、"],["信仰","しんこう"],["の"],["一致","いっち"],["と"],["神","かみ"],["の"],["御子","みこ"],["に"],["関する","かんする"],["知識","ちしき"],["の"],["一致","いっち"],["と"],["に"],["達し","たっし"],["、"],["完全","かんぜん"],["に"],["おとな"],["に"],["なって"],["、"],["キリスト"],["の"],["満ち満ちた","みちみちた"],["身","み"],["たけ"],["に"],["まで"],["達する","たっする"],["ため"],["です"],["。"]]},{"verse":14,"text":"それは、私たちがもはや、子どもではなくて、人の悪巧みや、人を欺く悪賢い策略に
[{"verse":1,"text":"ネブカデネザル王が、全土に住むすべての諸民、諸国、諸国語の者たちに書き送る。／あなたがたに平安が豊かにあるように。","tok":[["ネブカデネザル"],["王","おう"],["が"],["、"],["全土","ぜんど"],["に"],["住む","すむ"],["すべて"],["の"],["諸民","しょみん"],["、"],["諸国","しょこく"],["、"],["諸国","しょこく"],["語","ご"],["の"],["者","もの"],["たち"],["に"],["書き送る","かきおくる"],["。"],["／"],["あなた"],["がた"],["に"],["平安","へいあん"],["が"],["豊か","ゆたか"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":2,"text":"いと高き神が私に行われたしるしと奇蹟とを知らせることは、私の喜びとするところである。","tok":[["いと"],["高き","たかき"],["神","かみ"],["が"],["私","わたくし"],["に"],["行われた","おこなわれた"],["しるし"],["と"],["奇蹟","きせき"],["と"],["を"],["知らせる","しらせる"],["こと"],["は"],["、"],["私","わたくし"],["の"],["喜び","よろこび"],["と"],["する"],["ところ"],["で"],["ある"],["。"]]},{"verse":3,"text":"そのしるしのなんと偉大なことよ。／その奇蹟のなんと力強いことよ。／その国は永遠にわたる国、その主権は代々限りなく続く。","tok":[["その"],["しるし"],["の"],["なん"],["と"],["偉大","いだい"],["な"],["こと"],["よ"],["。"],["／"],["その"],["奇蹟","きせき"],["の"],["なん"],["と"],["力強い","ちからづよい"],["こと"],["よ"],["。"],["／"],["その"],["国","くに"],["は"],["永遠","えいえん"],["に"],["わたる"],["国","くに"],["、"],["その"],["主権","しゅけん"],["は"],["代々","だいだい"],["限りなく","かぎりなく"],["続く","つづく"],["。"]]},{"verse":4,"text":"私、ネブカデネザルが私の家で気楽にしており、私の宮殿で栄えていたとき、","tok":[["私","わたくし"],["、"],["ネブカデネザル"],["が"],["私","わたくし"],["の"],["家","いえ"],["で"],["気楽","きらく"],["に"],["して"],["おり"],["、"],["私","わたくし"],["の"],["宮殿","きゅうでん"],["で"],["栄えて","さかえて"],["いた"],["とき"],["、"]]},{"verse":5,"text":"私は一つの夢を見たが、それが私を恐れさせた。私の寝床での様々な幻想と頭に浮かんだ幻が、私を脅かした。","tok":[["私","わたくし"],["は"],["一","ひと"],["つ"],["の"],["夢","ゆめ"],["を"],["見た","みた"],["が"],["、"],["それ"],["が"],["私","わたくし"],["を"],["恐れさせた","おそれさせた"],["。"],["私","わたくし"],["の"],["寝床","ねどこ"],["で"],["の"],["様々","さまざま"],["な"],["幻想","げんそう"],["と"],["頭","あたま"],["に"],["浮かんだ","うかんだ"],["幻","まぼろし"],["が"],["、"],["私","わたくし"],["を"],["脅かした","おびやかした"],["。"]]},{"verse":6,"text":"それで、私は命令を下し、バビロンの知者をことごとく私の前に連れて来させて、その夢の解き明かしをさせようとした。","tok":[["それ"],["で"],["、"],["私","わたくし"],["は"],["命令","めいれい"],["を"],["下し","くだし"],["、"],["バビロン"],["の"],["知者","ちしゃ"],["を"],["ことごとく"],["私","わたくし"],["の"],["前","まえ"],["に"],["連れて","つれて"],["来させて","きさせて"],["、"],["その"],["夢","ゆめ"],["の"],["解き明かし","ときあかし"],["を"],["させよう"],["と"],["した"],["。"]]},{"verse":7,"text":"そこで、呪法師、呪文師、カルデヤ人、星占いたちが来たとき、私は彼らにその夢を告げたが、彼らはその解き明かしを私に知らせることができなかった。","tok":[["そこ"],["で"],["、"],["呪法師","じゅほうし"],["、"],["呪文師","じゅもんし"],["、"],["カルデヤ"],["人","にん"],["、"],["星","ほし"],["占い","うらない"],["たち"],["が"],["来た","きた"],["とき"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["に"],["その"],["夢","ゆめ"],["を"],["告げた","つげた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その"],["解き明かし","ときあかし"],["を"],["私","わたくし"],["に"],["知らせる","しらせる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":8,"text":"しかし最後に、ダニエルが私の前に来た。――彼の名は私の神の名にちなんでベルテシャツァルと呼ばれ、彼には聖なる神の霊があった。――私はその夢を彼に告げた。","tok":[["しかし"],["最後","さいご"],["に"],["、"],["ダニエル"],["が"],["私","わたくし"],["の"],["前","まえ"],["に"],["来た","きた"],["。"],["―"],["―"],["彼","かれ"],["の"],["名","な"],["は"],["私","わたくし"],["の"],["神","かみ"],["の"],["名","な"],["に"],["ちなんで"],["ベルテシャツァル"],["と"],["呼ばれ","よばれ"],["、"],["彼","かれ"],["に"],["は"],["聖","せい"],["なる"],["神","かみ"],["の"],["霊","れい"],["が"],["あった"],["。"],["―"],["―"],["私","わたくし"],["は"],["その"],["夢","ゆめ"],["を"],["彼","かれ"],["に"],["告げた","つげた"],["。"]]},{"verse":9,"text":"「呪法師の長ベルテシャツァル。私は、聖なる神の霊があなたにあり、どんな秘密もあなたにはむずかしくないことを知っている。私の見た夢の幻はこうだ。その解き明かしをしてもらいたい。","tok":[["「"],["呪法師","じゅほうし"],["の"],["長","ちょう"],["ベルテシャツァル"],["。"],["私","わたくし"],["は"],["、"],["聖","せい"],["なる"],["神","かみ"],["の"],["霊","れい"],["が"],["あなた"],["に"],["あり"],["、"],["どんな"],["秘密","ひみつ"],["も"],["あなた"],["に"],["は"],["むずかしく"],["ない"],["こと"],["を"],["知って","しって"],["いる"],["。"],["私","わたくし"],["の"],["見た","みた"],["夢","ゆめ"],["の"],["幻","まぼろし"],["は"],["こう"],["だ"],["。"],["その"],["解き明かし","ときあかし"],["を"],["して"],["もらいたい"],["。"]]},{"verse":10,"text":"私の寝床で頭に浮かんだ幻、私の見た幻はこうだ。見ると、地の中央に木があった。それは非常に高かった。","tok":[["私","わたくし"],["の"],["寝床","ねどこ"],["で"],["頭","あたま"],["に"],["浮かんだ","うかんだ"],["幻","まぼろし"],["、"],["私","わたくし"],["の"],["見た","みた"],["幻","まぼろし"],["は"],["こう"],["だ"],["。"],["見る","みる"],["と"],["、"],["地","ち"],["の"],["中央","ちゅうおう"],["に"],["木","き"],["が"],["あった"],["。"],["それ"],["は"],["非常","ひじょう"],["に"],["高かった","たかかった"],["。"]]},{"verse":11,"text":"その木は生長して強くなり、その高さは天に届いて、地の果てのどこからもそれが見えた。","tok":[["その"],["木","き"],["は"],["生長","せいちょう"],["して"],["強く","つよく"],["なり"],["、"],["その"],["高さ","たかさ"],["は"],["天","てん"],["に"],["届いて","とどいて"],["、"],["地","ち"],["の"],["果て","はて"],["の"],["どこ"],["から"],["も"],["それ"],["が"],["見えた","みえた"],["。"]]},{"verse":12,"text":"葉は美しく、実も豊かで、それにはすべてのものの食糧があった。その下では野の獣がいこい、その枝には空の鳥が住み、すべての肉なるものはそれによって養われた。","tok":[["葉","は"],["は"],["美しく","うつくしく"],["、"],["実","じつ"],["も"],["豊か","ゆたか"],["で"],["、"],["それ"],["に"],["は"],["すべて"],["の"],["もの"],["の"],["食糧","しょくりょう"],["が"],["あった"],["。"],["その"],["下","もと"],["で"],["は"],["野","の"],["の"],["獣","けもの"],["が"],["いこい"],["、"],["その"],["枝","えだ"],["に"],["は"],["空","そら"],["の"],["鳥","とり"],["が"],["住み","すみ"],["、"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["は"],["それ"],["によって"],["養われた","やしなわれた"],["。"]]},{"verse":13,"text":"私が見た幻、寝床で頭に浮かんだ幻の中に、見ると、ひとりの見張りの者、聖なる者が天から降りて来た。","tok":[["私","わたくし"],["が"],["見た","みた"],["幻","まぼろし"],["、"],["寝床","ねどこ"],["で"],["頭","あたま"],["に"],["浮かんだ","うかんだ"],["幻","まぼろし"],["の"],["中","なか"],["に"],["、"],["見る","みる"],["と"],["、"],["ひとり"],["の"],["見張り","みはり"],["の"],["者","もの"],["、"],["聖","せい"],["なる"],["者","もの"],["が"],["天","てん"],["から"],["降りて","おりて"],["来た","きた"],["。"]]},{"verse":14,"text":"彼は大声で叫んで、こう言った。『その木を切り倒し、枝を切り払え。その葉を振り落とし、実を投げ散らせ。獣をその下から、鳥をその枝から追い払え。","tok":[["彼","かれ"],["は"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["、"],["こう"],["言った","いった"],["。"],["『"],["その"],["木","き"],["を"],["切り倒し","きりたおし"],["、"],["枝","えだ"],["を"],["切り払え","きりはらえ"],["。"],["その"],["葉","は"],["を"],["振り落とし","ふりおとし"],["、"],["実","じつ"],["を"],["投げ","なげ"],["散らせ","ちらせ"],["。"],["獣","けもの"],["を"],["その"],["下","した"],["から"],["、"],["鳥","とり"],["を"],["その"],["枝","えだ"],["から"],["追い払え","おいはらえ"],["。"]]},{"verse":15,"text":"ただし、その根株を地に残し、これに鉄と青銅の鎖をかけて、野の若草の中に置き、天の露にぬれさせて、地の草を獣と分け合うようにせよ。","tok":[["ただし"],["、"],["その"],["根株","ねかぶ"],["を"],["地","ち"],["に"],["残し","のこし"],["、"],["これ"],["に"],["鉄","てつ"],["と"],["青銅","せいどう"],["の"],["鎖","くさり"],["を"],["かけて"],["、"],["野","の"],["の"],["若草","わかくさ"],["の"],["中","なか"],["に"],["置き","おき"],["、"],["天","てん"],["の"],["露","ろ"],["に"],["ぬれさせて"],["、"],["地","ち"],["の"],["草","くさ"],["を"],["獣","けもの"],["と"],["分け合う","わけあう"],["よう"],["に"],["せよ"],["。"]]},{"verse":16,"text":"その心を、人間の心から変えて、獣の心をそれに与え、七つの時をその上に過ごさせよ。","tok":[["その"],["心","こころ"],["を"],["、"],["人間","にんげん"],["の"],["心","こころ"],["から"],["変えて","かえて"],["、"],["獣","けもの"],["の"],["心","こころ"],["を"],["それ"],["に"],["与え","あたえ"],["、"],["七","なな"],["つ"],["の"],["時","とき"],["を"],["その"],["上","うえ"],["に"],["過ごさせ","すごさせ"],["よ"],["。"]]},{"verse":17,"text":"この宣言は見張りの者たちの布告によるもの、この決定は聖なる者たちの命令によるものだ。それは、いと高き方が人間の国を支配し、これをみこころにかなう者に与え、また人間の中の最もへりくだった者をその上に立てることを、生ける者が知るためである。』","tok":[["この"],["宣言","せんげん"],["は"],["見張り","みはり"],["の"],["者","もの"],["たち"],["の"],["布告","ふこく"],["に"],["よる"],["もの"],["、"],["この"],["決定","けってい"],["は"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["命令","めいれい"],["に"],["よる"],["もの"],["だ"],["。"],["それ"],["は"],["、"],["いと"],["高き","たかき"],["方","ほう"],["が"],["人間","にんげん"],["の"],["国","くに"],["を"],["支配","しはい"],["し"],["、"],["これ"],["を"],["みこころ"],["に"],["かなう"],["者","もの"],["に"],["与え","あたえ"],["、"],["また"],["人間","にんげん"],["の"],["中","なか"],["の"],["最も","もっとも"],["へりくだった"],["者","もの"],["を"],["その"],["上","うえ"],["に"],["立てる","たてる"],["こと"],["を"],["、"],["生ける","いける"],["者","もの"],["が"],["知る","しる"],["ため"],["で"],["ある"],["。"],["』"]]},{"verse":18,"text":"私、ネブカデネザル王が見た夢とはこれだ。ベルテシャツァルよ。あなたはその解き明かしを述べよ。私の国の知者たちはだれも、その解き明かしを私に知らせることができない。しかし、あなたにはできる。あなたには、聖なる神の霊があるからだ。」","tok":[["私","わたくし"],["、"],["ネブカデネザル"],["王","おう"],["が"],["見た","みた"],["夢","ゆめ"],["と"],["は"],["これ"],["だ"],["。"],["ベルテシャツァル"],["よ"],["。"],["あなた"],["は"],["その"],["解き明かし","ときあかし"],["を"],["述べ","のべ"],["よ"],["。"],["私","わたくし"],["の"],["国","くに"],["の"],["知者","ちしゃ"],["たち"],["は"],["だれ"],["も"],["、"],["その"],["解き明かし","ときあかし"],["を"],["私","わたくし"],["に"],["知らせる","しらせる"],["こと"],["が"],["できない"],["。"],["しかし"],["、"],["あなた"],["に"],["は"],["できる"],["。"],["あなた"],["に"],["は"],["、"],["聖","せい"],["なる"],["神","かみ"],["の"],["霊","れい"],["が"],["ある"],["から"],["だ"],["。"],["」"]]},{"verse":19,"text":"そのとき、ベルテシャツァルと呼ばれていたダニエルは、しばらくの間、驚きすくみ、おびえた。王は話しかけて言った。「ベルテシャツァル。あなたはこの夢と解き明かしを恐れることはない。」ベルテシャツァルは答えて言った。「わが主よ。どうか、この夢があなたを憎む者たちに当てはまり、その解き明かしがあなたの敵に当てはまりますように。","tok":[["その"],["とき"],["、"],["ベルテシャツァル"],["と"],["呼ばれて","よばれて"],["いた"],["ダニエル"],["は"],["、"],["しばらく"],["の"],["間","あいだ"],["、"],["驚き","おどろき"],["すくみ"],["、"],["おびえた"],["。"],["王","おう"],["は"],["話しかけて","はなしかけて"],["言った","いった"],["。"],["「"],["ベルテシャツァル"],["。"],["あなた"],["は"],["この"],["夢","ゆめ"],["と"],["解き明かし","ときあかし"],["を"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["」"],["ベルテシャツァル"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["わが"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["、"],["この"],["夢","ゆめ"],["が"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["たち"],["に"],["当てはまり","あてはまり"],["、"],["その"],["解き明かし","ときあかし"],["が"],["あなた"],["の"],["敵","てき"],["に"],["当てはまります","あてはまります"],["よう"],["に"],["。"]]},{"verse":20,"text":"あなたがご覧になった木、すなわち、生長して強くなり、その高さは天に届いて、地のどこからも見え、","tok":[["あなた"],["が"],["ご覧","ごらん"],["に"],["なった"],["木","き"],["、"],["すなわち"],["、"],["生長","せいちょう"],["して"],["強く","つよく"],["なり"],["、"],["その"],["高さ","たかさ"],["は"],["天","てん"],["に"],["届いて","とどいて"],["、"],["地","ち"],["の"],["どこ"],["から"],["も"],["見え","みえ"],["、"]]},{"verse":21,"text":"その葉は美しく、実も豊かで、それにはすべてのものの食糧があり、その下に野の獣が住み、その枝に空の鳥が宿った木、","tok":[["その"],["葉","は"],["は"],["美しく","うつくしく"],["、"],["実","じつ"],["も"],["豊か","ゆたか"],["で"],["、"],["それ"],["に"],["は"],["すべて"],["の"],["もの"],["の"],["食糧","しょくりょう"],["が"],["あり"],["、"],["その"],["下","した"],["に"],["野","の"],["の"],["獣","けもの"],["が"],["住み","すみ"],["、"],["その"],["枝","えだ"],["に"],["空","そら"],["の"],["鳥","とり"],["が"],["宿った","やどった"],["木","き"],["、"]]},{"verse":22,"text":"王さま、その木はあなたです。あなたは大きくなって強くなり、あなたの偉大さは増し加わって天に達し、あなたの主権は地の果てにまで及んでいます。","tok":[["王","おう"],["さま"],["、"],["その"],["木","き"],["は"],["あなた"],["です"],["。"],["あなた"],["は"],["大きく","おおきく"],["なって"],["強く","つよく"],["なり"],["、"],["あなた"],["の"],["偉大","いだい"],["さ"],["は"],["増し","まし"],["加わって","くわわって"],["天","てん"],["に"],["達し","たっし"],["、"],["あなた"],["の"],["主権","しゅけん"],["は"],["地","ち"],["の"],["果て","はて"],["に"],["まで"],["及んで","およんで"],["います"],["。"]]},{"verse":23,"text":"しかし王は、ひとりの見張りの者、聖なる者が天から降りて来てこう言うのをご覧になりました。『この木
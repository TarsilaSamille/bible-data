[{"verse":1,"text":"メディヤ族のアハシュエロスの子ダリヨスが、カルデヤ人の国の王となったその元年、","tok":[["メディヤ"],["族","ぞく"],["の"],["アハシュエロス"],["の"],["子","こ"],["ダリヨス"],["が"],["、"],["カルデヤ"],["人","にん"],["の"],["国","くに"],["の"],["王","おう"],["と"],["なった"],["その"],["元年","がんねん"],["、"]]},{"verse":2,"text":"すなわち、その治世の第一年に、私、ダニエルは、預言者エレミヤにあった主のことばによって、エルサレムの荒廃が終わるまでの年数が七十年であることを、文書によって悟った。","tok":[["すなわち"],["、"],["その"],["治世","ちせい"],["の"],["第","だい"],["一","いち"],["年","ねん"],["に"],["、"],["私","わたくし"],["、"],["ダニエル"],["は"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["あった"],["主","ぬし"],["の"],["ことば"],["によって"],["、"],["エルサレム"],["の"],["荒廃","こうはい"],["が"],["終わる","おわる"],["まで"],["の"],["年数","ねんすう"],["が"],["七十","ななじゅう"],["年","ねん"],["で"],["ある"],["こと"],["を"],["、"],["文書","ぶんしょ"],["によって"],["悟った","さとった"],["。"]]},{"verse":3,"text":"そこで私は、顔を神である主に向けて祈り、断食をし、荒布を着、灰をかぶって、願い求めた。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["顔","かお"],["を"],["神","かみ"],["で"],["ある"],["主","ぬし"],["に"],["向けて","むけて"],["祈り","いのり"],["、"],["断食","だんじき"],["を"],["し"],["、"],["荒布","あらめ"],["を"],["着","き"],["、"],["灰","はい"],["を"],["かぶって"],["、"],["願い求めた","ねがいもとめた"],["。"]]},{"verse":4,"text":"私は、私の神、主に祈り、告白して言った。「ああ、私の主、大いなる恐るべき神。あなたを愛し、あなたの命令を守る者には、契約を守り、恵みを下さる方。","tok":[["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈り","いのり"],["、"],["告白","こくはく"],["して"],["言った","いった"],["。"],["「"],["ああ"],["、"],["私","わたくし"],["の"],["主","ぬし"],["、"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["神","かみ"],["。"],["あなた"],["を"],["愛し","あいし"],["、"],["あなた"],["の"],["命令","めいれい"],["を"],["守る","まもる"],["者","もの"],["に"],["は"],["、"],["契約","けいやく"],["を"],["守り","まもり"],["、"],["恵み","めぐみ"],["を"],["下さる","くださる"],["方","かた"],["。"]]},{"verse":5,"text":"私たちは罪を犯し、不義をなし、悪を行い、あなたにそむき、あなたの命令と定めとを離れました。","tok":[["私たち","わたしたち"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["不義","ふぎ"],["を"],["なし"],["、"],["悪","あく"],["を"],["行い","おこない"],["、"],["あなた"],["に"],["そむき"],["、"],["あなた"],["の"],["命令","めいれい"],["と"],["定め","さだめ"],["と"],["を"],["離れました","はなれました"],["。"]]},{"verse":6,"text":"私たちはまた、あなたのしもべである預言者たちが御名によって、私たちの王たち、首長たち、先祖たち、および一般の人すべてに語ったことばに、聞き従いませんでした。","tok":[["私たち","わたしたち"],["は"],["また"],["、"],["あなた"],["の"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["が"],["御名","ぎょめい"],["によって"],["、"],["私たち","わたしたち"],["の"],["王","おう"],["たち"],["、"],["首長","しゅちょう"],["たち"],["、"],["先祖","せんぞ"],["たち"],["、"],["および"],["一般","いっぱん"],["の"],["人","ひと"],["すべて"],["に"],["語った","かたった"],["ことば"],["に"],["、"],["聞き従いませんでした","ききしたがいませんでした"],["。"]]},{"verse":7,"text":"主よ。正義はあなたのものですが、不面目は私たちのもので、今日あるとおり、ユダの人々、エルサレムの住民のもの、また、あなたが追い散らされたあらゆる国々で、近く、あるいは遠くにいるすべてのイスラエル人のものです。これは、彼らがあなたに逆らった不信の罪のためです。","tok":[["主","ぬし"],["よ"],["。"],["正義","まさよし"],["は"],["あなた"],["の"],["もの"],["です"],["が"],["、"],["不面目","ふめんぼく"],["は"],["私たち","わたしたち"],["の"],["もの"],["で"],["、"],["今日","きょう"],["ある"],["と"],["おり"],["、"],["ユダ"],["の"],["人々","ひとびと"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["の"],["もの"],["、"],["また"],["、"],["あなた"],["が"],["追い散らされた","おいちらされた"],["あらゆる"],["国々","くにぐに"],["で"],["、"],["近く","ちかく"],["、"],["あるいは"],["遠く","とおく"],["に"],["いる"],["すべて"],["の"],["イスラエル"],["人","にん"],["の"],["もの"],["です"],["。"],["これ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["逆らった","さからった"],["不信","ふしん"],["の"],["罪","つみ"],["の"],["ため"],["です"],["。"]]},{"verse":8,"text":"主よ。不面目は、あなたに罪を犯した私たちと私たちの王たち、首長たち、および先祖たちのものです。","tok":[["主","ぬし"],["よ"],["。"],["不面目","ふめんぼく"],["は"],["、"],["あなた"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["私たち","わたしたち"],["と"],["私たち","わたしたち"],["の"],["王","おう"],["たち"],["、"],["首長","しゅちょう"],["たち"],["、"],["および"],["先祖","せんぞ"],["たち"],["の"],["もの"],["です"],["。"]]},{"verse":9,"text":"あわれみと赦しとは、私たちの神、主のものです。これは私たちが神にそむいたからです。","tok":[["あわれみ"],["と"],["赦し","ゆるし"],["と"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["もの"],["です"],["。"],["これ"],["は"],["私たち","わたしたち"],["が"],["神","かみ"],["に"],["そむいた"],["から"],["です"],["。"]]},{"verse":10,"text":"私たちは、私たちの神、主の御声に聞き従わず、神がそのしもべである預言者たちによって私たちに下さった律法に従って歩みませんでした。","tok":[["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["神","かみ"],["が"],["その"],["しもべ"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["によって"],["私たち","わたしたち"],["に"],["下さった","くださった"],["律法","りっぽう"],["に"],["従って","したがって"],["歩みませんでした","あゆみませんでした"],["。"]]},{"verse":11,"text":"イスラエル人はみな、あなたの律法を犯して離れ去り、御声に聞き従いませんでした。そこで、神のしもべモーセの律法に書かれているのろいと誓いが、私たちの上にふりかかりました。私たちが神に罪を犯したからです。","tok":[["イスラエル"],["人","にん"],["は"],["みな"],["、"],["あなた"],["の"],["律法","りっぽう"],["を"],["犯して","おかして"],["離れ去り","はなれさり"],["、"],["御声","おこえ"],["に"],["聞き従いませんでした","ききしたがいませんでした"],["。"],["そこ"],["で"],["、"],["神","かみ"],["の"],["しもべ"],["モーセ"],["の"],["律法","りっぽう"],["に"],["書かれて","かかれて"],["いる"],["のろい"],["と"],["誓い","ちかい"],["が"],["、"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["ふりかかりました"],["。"],["私たち","わたしたち"],["が"],["神","かみ"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["です"],["。"]]},{"verse":12,"text":"神は、大きなわざわいを私たちにもたらすと、かつて私たちと、私たちをさばいたさばきつかさたちに対して告げられたみことばを、成就されたのです。エルサレムの上に下ったほどのわざわいは、今まで天下になかったことです。","tok":[["神","かみ"],["は"],["、"],["大きな","おおきな"],["わざわい"],["を"],["私たち","わたしたち"],["に"],["もたらす"],["と"],["、"],["かつて"],["私たち","わたしたち"],["と"],["、"],["私たち","わたしたち"],["を"],["さばいた"],["さばき"],["つかさ"],["たち"],["に対して","にたいして"],["告げられた","つげられた"],["みことば"],["を"],["、"],["成就","じょうじゅ"],["された"],["の"],["です"],["。"],["エルサレム"],["の"],["上","うえ"],["に"],["下った","くだった"],["ほど"],["の"],["わざわい"],["は"],["、"],["今まで","いままで"],["天下","てんか"],["に"],["なかった"],["こと"],["です"],["。"]]},{"verse":13,"text":"このわざわいはすべて、モーセの律法に書かれているように、私たちの上に下りましたが、私たちは、不義から立ち返り、あなたの真理を悟れるよう、私たちの神、主に、お願いもしませんでした。","tok":[["この"],["わざわい"],["は"],["すべて"],["、"],["モーセ"],["の"],["律法","りっぽう"],["に"],["書かれて","かかれて"],["いる"],["よう"],["に"],["、"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["下りました","くだりました"],["が"],["、"],["私たち","わたしたち"],["は"],["、"],["不義","ふぎ"],["から"],["立ち返り","たちかえり"],["、"],["あなた"],["の"],["真理","しんり"],["を"],["悟れる","さとれる"],["よう"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["お願い","おねがい"],["も"],["しませんでした"],["。"]]},{"verse":14,"text":"主はそのわざわいの見張りをしておられ、それを私たちの上に下しました。私たちの神、主のみわざは、すべて正しいのです。私たちが、御声に聞き従わなかったからです。","tok":[["主","ぬし"],["は"],["その"],["わざわい"],["の"],["見張り","みはり"],["を"],["して"],["お
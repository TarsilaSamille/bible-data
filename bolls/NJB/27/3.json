[{"verse":1,"text":"ネブカデネザル王は金の像を造った。その高さは六十キュビト、その幅は六キュビトであった。彼はこれをバビロン州のドラの平野に立てた。","tok":[["ネブカデネザル"],["王","おう"],["は"],["金","きん"],["の"],["像","ぞう"],["を"],["造った","つくった"],["。"],["その"],["高さ","たかさ"],["は"],["六十","ろくじゅう"],["キュビト"],["、"],["その"],["幅","はば"],["は"],["六","ろく"],["キュビト"],["で"],["あった"],["。"],["彼","かれ"],["は"],["これ"],["を"],["バビロン"],["州","しゅう"],["の"],["ドラ"],["の"],["平野","へいや"],["に"],["立てた","たてた"],["。"]]},{"verse":2,"text":"そして、ネブカデネザル王は人を遣わして、太守、長官、総督、参議官、財務官、司法官、保安官、および諸州のすべての高官を召集し、ネブカデネザル王が立てた像の奉献式に出席させることにした。","tok":[["そして"],["、"],["ネブカデネザル"],["王","おう"],["は"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["太守","たいしゅ"],["、"],["長官","ちょうかん"],["、"],["総督","そうとく"],["、"],["参議官","さんぎかん"],["、"],["財務官","ざいむかん"],["、"],["司法官","しほうかん"],["、"],["保安官","ほあんかん"],["、"],["および"],["諸州","しょしゅう"],["の"],["すべて"],["の"],["高官","こうかん"],["を"],["召集","しょうしゅう"],["し"],["、"],["ネブカデネザル"],["王","おう"],["が"],["立てた","たてた"],["像","ぞう"],["の"],["奉献","ほうけん"],["式","しき"],["に"],["出席","しゅっせき"],["させる"],["こと"],["に"],["した"],["。"]]},{"verse":3,"text":"そこで太守、長官、総督、参議官、財務官、司法官、保安官、および諸州のすべての高官は、ネブカデネザル王が立てた像の奉献式に集まり、ネブカデネザルが立てた像の前に立った。","tok":[["そこ"],["で"],["太守","たいしゅ"],["、"],["長官","ちょうかん"],["、"],["総督","そうとく"],["、"],["参議官","さんぎかん"],["、"],["財務官","ざいむかん"],["、"],["司法官","しほうかん"],["、"],["保安官","ほあんかん"],["、"],["および"],["諸州","しょしゅう"],["の"],["すべて"],["の"],["高官","こうかん"],["は"],["、"],["ネブカデネザル"],["王","おう"],["が"],["立てた","たてた"],["像","ぞう"],["の"],["奉献","ほうけん"],["式","しき"],["に"],["集まり","あつまり"],["、"],["ネブカデネザル"],["が"],["立てた","たてた"],["像","ぞう"],["の"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":4,"text":"伝令官は大声で叫んだ。「諸民、諸国、諸国語の者たちよ。あなたがたにこう命じられている。","tok":[["伝令官","でんれいかん"],["は"],["大声","おおごえ"],["で"],["叫んだ","さけんだ"],["。"],["「"],["諸民","しょみん"],["、"],["諸国","しょこく"],["、"],["諸国","しょこく"],["語","ご"],["の"],["者","もの"],["たち"],["よ"],["。"],["あなた"],["がた"],["に"],["こう"],["命じられて","めいじられて"],["いる"],["。"]]},{"verse":5,"text":"あなたがたが角笛、二管の笛、立琴、三角琴、ハープ、風笛、および、もろもろの楽器の音を聞くときは、ひれ伏して、ネブカデネザル王が立てた金の像を拝め。","tok":[["あなた"],["がた"],["が"],["角笛","つのぶえ"],["、"],["二","に"],["管","かん"],["の"],["笛","ふえ"],["、"],["立琴","たてごと"],["、"],["三角","さんかく"],["琴","こと"],["、"],["ハープ"],["、"],["風笛","ふうてき"],["、"],["および"],["、"],["もろもろ"],["の"],["楽器","がっき"],["の"],["音","おと"],["を"],["聞く","きく"],["とき"],["は"],["、"],["ひれ伏して","ひれふして"],["、"],["ネブカデネザル"],["王","おう"],["が"],["立てた","たてた"],["金","かね"],["の"],["像","ぞう"],["を"],["拝め","おがめ"],["。"]]},{"verse":6,"text":"ひれ伏して拝まない者はだれでも、ただちに火の燃える炉の中に投げ込まれる。」","tok":[["ひれ伏して","ひれふして"],["拝まない","おがまない"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["ただちに"],["火","ひ"],["の"],["燃える","もえる"],["炉","ろ"],["の"],["中","なか"],["に"],["投げ込まれる","なげこまれる"],["。"],["」"]]},{"verse":7,"text":"それで、民がみな、角笛、二管の笛、立琴、三角琴、ハープ、および、もろもろの楽器の音を聞いたとき、諸民、諸国、諸国語の者たちは、ひれ伏して、ネブカデネザル王が立てた金の像を拝んだ。","tok":[["それ"],["で"],["、"],["民","みん"],["が"],["みな"],["、"],["角笛","つのぶえ"],["、"],["二","に"],["管","かん"],["の"],["笛","ふえ"],["、"],["立琴","たてごと"],["、"],["三角","さんかく"],["琴","こと"],["、"],["ハープ"],["、"],["および"],["、"],["もろもろ"],["の"],["楽器","がっき"],["の"],["音","おと"],["を"],["聞いた","きいた"],["とき"],["、"],["諸民","しょみん"],["、"],["諸国","しょこく"],["、"],["諸国","しょこく"],["語","ご"],["の"],["者","もの"],["たち"],["は"],["、"],["ひれ伏して","ひれふして"],["、"],["ネブカデネザル"],["王","おう"],["が"],["立てた","たてた"],["金","かね"],["の"],["像","ぞう"],["を"],["拝んだ","おがんだ"],["。"]]},{"verse":8,"text":"こういうことがあったその時、あるカルデヤ人たちが進み出て、ユダヤ人たちを訴えた。","tok":[["こう"],["いう"],["こと"],["が"],["あった"],["その"],["時","とき"],["、"],["ある"],["カルデヤ"],["人","ひと"],["たち"],["が"],["進み出て","すすみでて"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["を"],["訴えた","うったえた"],["。"]]},{"verse":9,"text":"彼らはネブカデネザル王に告げて言った。「王よ。永遠に生きられますように。","tok":[["彼","かれ"],["ら"],["は"],["ネブカデネザル"],["王","おう"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["王","おう"],["よ"],["。"],["永遠","えいえん"],["に"],["生きられます","いきられます"],["よう"],["に"],["。"]]},{"verse":10,"text":"王よ。あなたは、『角笛、二管の笛、立琴、三角琴、ハープ、風笛、および、もろもろの楽器の音を聞く者は、すべてひれ伏して金の像を拝め。","tok":[["王","おう"],["よ"],["。"],["あなた"],["は"],["、"],["『"],["角笛","つのぶえ"],["、"],["二","に"],["管","かん"],["の"],["笛","ふえ"],["、"],["立琴","たてごと"],["、"],["三角","さんかく"],["琴","こと"],["、"],["ハープ"],["、"],["風笛","ふうてき"],["、"],["および"],["、"],["もろもろ"],["の"],["楽器","がっき"],["の"],["音","おと"],["を"],["聞く","きく"],["者","もの"],["は"],["、"],["すべて"],["ひれ伏して","ひれふして"],["金","きん"],["の"],["像","ぞう"],["を"],["拝め","おがめ"],["。"]]},{"verse":11,"text":"ひれ伏して拝まない者はだれでも、火の燃える炉の中へ投げ込め』と命令されました。","tok":[["ひれ伏して","ひれふして"],["拝まない","おがまない"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["火","ひ"],["の"],["燃える","もえる"],["炉","ろ"],["の"],["中","なか"],["へ"],["投げ込め","なげこめ"],["』"],["と"],["命令","めいれい"],["されました"],["。"]]},{"verse":12,"text":"ここに、あなたが任命してバビロン州の事務をつかさどらせたユダヤ人シャデラク、メシャク、アベデ・ネゴがおります。王よ。この者たちはあなたを無視して、あなたの神々に仕えず、あなたが立てた金の像を拝みもいたしません。」","tok":[["ここ"],["に"],["、"],["あなた"],["が"],["任命","にんめい"],["して"],["バビロン"],["州","しゅう"],["の"],["事務","じむ"],["を"],["つかさどらせた"],["ユダヤ人","ゆだやじん"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["が"],["おります"],["。"],["王","おう"],["よ"],["。"],["この"],["者","もの"],["たち"],["は"],["あなた"],["を"],["無視","むし"],["して"],["、"],["あなた"],["の"],["神々","かみがみ"],["に"],["仕えず","つかえず"],["、"],["あなた"],["が"],["立てた","たてた"],["金","かね"],["の"],["像","ぞう"],["を"],["拝み","おがみ"],["も"],["いたしません"],["。"],["」"]]},{"verse":13,"text":"そこでネブカデネザルは怒りたけり、シャデラク、メシャク、アベデ・ネゴを連れて来いと命じた。それでこの人たちは王の前に連れて来られた。","tok":[["そこ"],["で"],["ネブカデネザル"],["は"],["怒り","いかり"],["たけり"],["、"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["を"],["連れて","つれて"],["来い","こい"],["と"],["命じた","めいじた"],["。"],["それ"],["で"],["この"],["人","ひと"],["たち"],["は"],["王","おう"],["の"],["前","まえ"],["に"],["連れて","つれて"],["来られた","こられた"],["。"]]},{"verse":14,"text":"ネブカデネザルは彼らに言った。「シャデラク、メシャク、アベデ・ネゴ。あなたがたは私の神々に仕えず、また私が立てた金の像を拝みもしないというが、ほんとうか。","tok":[["ネブカデネザル"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["。"],["あなた"],["がた"],["は"],["私","わたくし"],["の"],["神々","かみがみ"],["に"],["仕えず","つかえず"],["、"],["また"],["私","わたくし"],["が"],["立てた","たてた"],["金","かね"],["の"],["像","ぞう"],["を"],["拝み","おがみ"],["も"],["しない"],["と"],["いう"],["が"],["、"],["ほんとう"],["か"],["。"]]},{"verse":15,"text":"もしあなたがたが、角笛、二管の笛、立琴、三角琴、ハープ、風笛、および、もろもろの楽器の音を聞くときに、ひれ伏して、私が造った像を拝むなら、それでよし。しかし、もし拝まないなら、あなたがたはただちに火の燃える炉の中に投げ込まれる。どの神が、私の手からあなたがたを救い出せよう。」","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["角笛","つのぶえ"],["、"],["二","に"],["管","かん"],["の"],["笛","ふえ"],["、"],["立琴","たてごと"],["、"],["三角","さんかく"],["琴","こと"],["、"],["ハープ"],["、"],["風笛","ふうてき"],["、"],["および"],["、"],["もろもろ"],["の"],["楽器","がっき"],["の"],["音","おと"],["を"],["聞く","きく"],["とき"],["に"],["、"],["ひれ伏して","ひれふして"],["、"],["私","わたくし"],["が"],["造った","つくった"],["像","ぞう"],["を"],["拝むなら","おがむなら"],["、"],["それ"],["で"],["よし"],["。"],["しかし"],["、"],["もし"],["拝まないなら","おがまないなら"],["、"],["あなた"],["がた"],["は"],["ただちに"],["火","ひ"],["の"],["燃える","もえる"],["炉","ろ"],["の"],["中","なか"],["に"],["投げ込まれる","なげこまれる"],["。"],["どの"],["神","かみ"],["が"],["、"],["私","わたくし"],["の"],["手","て"],["から"],["あなた"],["がた"],["を"],["救い出せよう","すくいだせよう"],["。"],["」"]]},{"verse":16,"text":"シャデラク、メシャク、アベデ・ネゴはネブカデネザル王に言った。「私たちはこのことについて、あなたにお答えする必要はありません。","tok":[["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["は"],["ネブカデネザル"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["この"],["こと"],["について"],["、"],["あなた"],["に"],["お答え","おこたえ"],["する"],["必要","ひつよう"],["は"],["ありません"],["。"]]},{"verse":17,"text":"もし、そうなれば、私たちの仕える神は、火の燃える炉から私たちを救い出すことができます。王よ。神は私たちをあなたの手から救い出します。","tok":[["もし"],["、"],["そう"],["なれば"],["、"],["私たち","わたしたち"],["の"],["仕える","つかえる"],["神","かみ"],["は"],["、"],["火","ひ"],["の"],["燃える","もえる"],["炉","ろ"],["から"],["私たち","わたしたち"],["を"],["救い出す","すくいだす"],["こと"],["が"],["できます"],["。"],["王","おう"],["よ"],["。"],["神","かみ"],["は"],["私たち","わたしたち"],["を"],["あなた"],["の"],["手","て"],["から"],["救い出します","すくいだします"],["。"]]},{"verse":18,"text":"しかし、もしそうでなくても、王よ、ご承知ください。私たちはあなたの神々に仕えず、あなたが立てた金の像を拝むこともしません。」","tok":[["しかし"],["、"],["もし"],["そう"],["で"],["なくて"],["も"],["、"],["王","おう"],["よ"],["、"],["ご承知","ごしょうち"],["ください"],["。"],["私たち","わたしたち"],["は"],["あなた"],["の"],["神々","かみがみ"],["に"],["仕えず","つかえず"],["、"],["あなた"],["が"],["立てた","たてた"],["金","かね"],["の"],["像","ぞう"],["を"],["拝む","おがむ"],["こと"],["も"],["しません"],["。"],["」"]]},{"verse":19,"text":"すると、ネブカデネザルは怒りに満ち、シャデラク、メシャク、アベデ・ネゴに対する顔つきが変わった。彼は炉を普通より七倍熱くせよと命じた。","tok":[["する"],["と"],["、"],["ネブカデネザル"],["は"],["怒り","いかり"],["に"],["満ち","みち"],["、"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["に"],["対する","たいする"],["顔つき","かおつき"],["が"],["変わった","かわった"],["。"],["彼","かれ"],["は"],["炉","ろ"],["を"],["普通","ふつう"],["より"],["七","なな"],["倍","ばい"],["熱く","あつく"],["せよ"],["と"],["命じた","めいじた"],["。"]]},{"verse":20,"text":"また彼の軍隊の中の力強い者たちに、シャデラク、メシャク、アベデ・ネゴを縛って、火の燃える炉に投げ込めと命じた。","tok":[["また"],["彼","かれ"],["の"],["軍隊","ぐんたい"],["の"],["中","なか"],["の"],["力強い","ちからづよい"],["者","もの"],["たち"],["に"],["、"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["を"],["縛って","しばって"],["、"],["火","ひ"],["の"],["燃える","もえる"],["炉","ろ"],["に"],["投げ込め","なげこめ"],["と"],["命じた","めいじた"],["。"]]},{"verse":21,"text":"そこで、この人たちは、上着や下着やかぶり物の衣服を着たまま縛られて、火の燃える炉の中に投げ込まれた。","tok":[["そこ"],["で"],["、"],["この"],["人","ひと"],["たち"],["は"],["、"],["上着","うわぎ"],["や"],["下着","したぎ"],["や"],["かぶり物","かぶりもの"],["の"],["衣服","いふく"],["を"],["着た","きた"],["まま"],["縛られて","しばられて"],["、"],["火","ひ"],["の"],["燃える","もえる"],["炉","ろ"],["の"],["中","なか"],["に"],["投げ込まれた","なげこまれた"],["。"]]},{"verse":22,"text":"王の命令がきびしく、炉がはなはだ熱かったので、シャデラク、メシャク、アベデ・ネゴを連れて来た者たちは、その火炎に焼き殺された。","tok":[["王","おう"],["の"],["命令","めいれい"],["が"],["きびしく"],["、"],["炉","ろ"],["が"],["はなはだ"],["熱かった","あつかった"],["ので"],["、"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["を"],["連れて","つれて"],["来た","きた"],["者","もの"],["たち"],["は"],["、"],["その"],["火炎","かえん"],["に"],["焼き殺された","やきころされた"],["。"]]},{"verse":23,"text":"シャデラク、メシャク、アベデ・ネゴの三人は、縛られたままで、火の燃える炉の中に落ち込んだ。","tok":[["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["の"],["三人","さんにん"],["は"],["、"],["縛られた","しばられた"],["まま"],["で"],["、"],["火","ひ"],["の"],["燃える","もえる"],["炉","ろ"],["の"],["中","なか"],["に"],["落ち込んだ","おちこんだ"],["。"]]},{"verse":24,"text":"そのとき、ネブカデネザル王は驚き、急いで立ち上がり、その顧問たちに尋ねて言った。「私たちは三人の者を縛って火の中に投げ込んだのではなかったか。」彼らは王に答えて言った。「王さま。そのとおりでございます。」","tok":[["その"],["とき"],["、"],["ネブカデネザル"],["王","おう"],["は"],["驚き","おどろき"],["、"],["急いで","いそいで"],["立ち上がり","たちあがり"],["、"],["その"],["顧問","こもん"],["たち"],["に"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["三人","さんにん"],["の"],["者","もの"],["を"],["縛って","しばって"],["火","ひ"],["の"],["中","なか"],["に"],["投げ込んだ","なげこんだ"],["ので"],["は"],["なかった"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["王","おう"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["王","おう"],["さま"],["。"],["その"],["とおり"],["で"],["ございます"],["。"],["」"]]},{"verse":25,"text":"すると王は言った。「だが、私には、火の中をなわを解かれて歩いている四人の者が見える。しかも彼らは何の害も受けていない。第四の者の姿は神々の子のようだ。」","tok":[["する"],["と"],["王","おう"],["は"],["言った","いった"],["。"],["「"],["だ"],["が"],["、"],["私","わたくし"],["に"],["は"],["、"],["火","ひ"],["の"],["中","なか"],["を"],["なわ"],["を"],["解かれて","とかれて"],["歩いて","あるいて"],["いる"],["四人","よんにん"],["の"],["者","もの"],["が"],["見える","みえる"],["。"],["しかも"],["彼","かれ"],["ら"],["は"],["何","なん"],["の"],["害","がい"],["も"],["受けて","うけて"],["いない"],["。"],["第","だい"],["四","よん"],["の"],["者","もの"],["の"],["姿","すがた"],["は"],["神々","かみがみ"],["の"],["子","こ"],["の"],["よう"],["だ"],["。"],["」"]]},{"verse":26,"text":"それから、ネブカデネザルは火の燃える炉の口に近づいて言った。「シャデラク、メシャク、アベデ・ネゴ。いと高き神のしもべたち。すぐ出て来なさい。」そこで、シャデラク、メシャク、アベデ・ネゴは火の中から出て来た。","tok":[["それ"],["から"],["、"],["ネブカデネザル"],["は"],["火","ひ"],["の"],["燃える","もえる"],["炉","ろ"],["の"],["口","くち"],["に"],["近づいて","ちかづいて"],["言った","いった"],["。"],["「"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["。"],["いと"],["高き","たかき"],["神","かみ"],["の"],["しもべ"],["たち"],["。"],["すぐ"],["出て","でて"],["来","き"],["なさい"],["。"],["」"],["そこ"],["で"],["、"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["は"],["火","ひ"],["の"],["中","なか"],["から"],["出て","でて"],["来た","きた"],["。"]]},{"verse":27,"text":"太守、長官、総督、王の顧問たちが集まり、この人たちを見たが、火は彼らのからだにはききめがなく、その頭の毛も焦げず、上着も以前と変わらず、火のにおいもしなかった。","tok":[["太守","たいしゅ"],["、"],["長官","ちょうかん"],["、"],["総督","そうとく"],["、"],["王","おう"],["の"],["顧問","こもん"],["たち"],["が"],["集まり","あつまり"],["、"],["この"],["人","ひと"],["たち"],["を"],["見た","みた"],["が"],["、"],["火","ひ"],["は"],["彼","かれ"],["ら"],["の"],["からだ"],["に"],["は"],["きき"],["め"],["が"],["なく"],["、"],["その"],["頭","あたま"],["の"],["毛","け"],["も"],["焦げず","こげず"],["、"],["上着","うわぎ"],["も"],["以前","いぜん"],["と"],["変わらず","かわらず"],["、"],["火","ひ"],["の"],["におい"],["も"],["しなかった"],["。"]]},{"verse":28,"text":"ネブカデネザルは言った。「ほむべきかな、シャデラク、メシャク、アベデ・ネゴの神。神は御使いを送って、王の命令にそむき、自分たちのからだを差し出しても、神に信頼し、自分たちの神のほかはどんな神にも仕えず、また拝まないこのしもべたちを救われた。","tok":[["ネブカデネザル"],["は"],["言った","いった"],["。"],["「"],["ほ"],["むべき"],["か"],["な"],["、"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["の"],["神","かみ"],["。"],["神","かみ"],["は"],["御使い","おつかい"],["を"],["送って","おくって"],["、"],["王","おう"],["の"],["命令","めいれい"],["に"],["そむき"],["、"],["自分","じぶん"],["たち"],["の"],["からだ"],["を"],["差し出して","さしだして"],["も"],["、"],["神","かみ"],["に"],["信頼","しんらい"],["し"],["、"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["の"],["ほか"],["は"],["どんな"],["神","かみ"],["に"],["も"],["仕えず","つかえず"],["、"],["また"],["拝まない","おがまない"],["この"],["しもべ"],["たち"],["を"],["救われた","すくわれた"],["。"]]},{"verse":29,"text":"それゆえ、私は命令する。諸民、諸国、諸国語の者のうち、シャデラク、メシャク、アベデ・ネゴの神を侮る者はだれでも、その手足は切り離され、その家をごみの山とさせる。このように救い出すことのできる神は、ほかにないからだ。」","tok":[["それ"],["ゆえ"],["、"],["私","わたくし"],["は"],["命令","めいれい"],["する"],["。"],["諸民","しょみん"],["、"],["諸国","しょこく"],["、"],["諸国","しょこく"],["語","ご"],["の"],["者","もの"],["の"],["うち"],["、"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["の"],["神","かみ"],["を"],["侮る","あなどる"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["その"],["手足","てあし"],["は"],["切り離され","きりはなされ"],["、"],["その"],["家","いえ"],["を"],["ごみ"],["の"],["山","やま"],["と"],["させる"],["。"],["この"],["よう"],["に"],["救い出す","すくいだす"],["こと"],["の"],["できる"],["神","かみ"],["は"],["、"],["ほか"],["に"],["ない"],["から"],["だ"],["。"],["」"]]},{"verse":30,"text":"それから王は、シャデラク、メシャク、アベデ・ネゴをバビロン州で栄えさせた。","tok":[["それ"],["から"],["王","おう"],["は"],["、"],["シャデラク"],["、"],["メシャク"],["、"],["アベデ"],["・"],["ネゴ"],["を"],["バビロン"],["州","しゅう"],["で"],["栄えさせた","さかえさせた"],["。"]]}]
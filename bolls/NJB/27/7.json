[{"verse":1,"text":"バビロンの王ベルシャツァルの元年に、ダニエルは寝床で、一つの夢、頭に浮かんだ幻を見て、その夢を書きしるし、そのあらましを語った。","tok":[["バビロン"],["の"],["王","おう"],["ベルシャツァル"],["の"],["元年","がんねん"],["に"],["、"],["ダニエル"],["は"],["寝床","ねどこ"],["で"],["、"],["一","ひと"],["つ"],["の"],["夢","ゆめ"],["、"],["頭","あたま"],["に"],["浮かんだ","うかんだ"],["幻","まぼろし"],["を"],["見て","みて"],["、"],["その"],["夢","ゆめ"],["を"],["書きしるし","かきしるし"],["、"],["その"],["あらまし"],["を"],["語った","かたった"],["。"]]},{"verse":2,"text":"ダニエルは言った。「私が夜、幻を見ていると、突然、天の四方の風が大海をかき立て、","tok":[["ダニエル"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["夜","よる"],["、"],["幻","まぼろし"],["を"],["見て","みて"],["いる"],["と"],["、"],["突然","とつぜん"],["、"],["天","てん"],["の"],["四方","しほう"],["の"],["風","かぜ"],["が"],["大海","たいかい"],["を"],["かき立て","かきたて"],["、"]]},{"verse":3,"text":"四頭の大きな獣が海から上がって来た。その四頭はそれぞれ異なっていた。","tok":[["四頭","よんとう"],["の"],["大きな","おおきな"],["獣","けもの"],["が"],["海","うみ"],["から"],["上がって","あがって"],["来た","きた"],["。"],["その"],["四頭","よんとう"],["は"],["それぞれ"],["異なって","ことなって"],["いた"],["。"]]},{"verse":4,"text":"第一のものは獅子のようで、鷲の翼をつけていた。見ていると、その翼は抜き取られ、地から起こされ、人間のように二本の足で立たされて、人間の心が与えられた。","tok":[["第","だい"],["一","いち"],["の"],["もの"],["は"],["獅子","しし"],["の"],["よう"],["で"],["、"],["鷲","わし"],["の"],["翼","つばさ"],["を"],["つけて"],["いた"],["。"],["見て","みて"],["いる"],["と"],["、"],["その"],["翼","つばさ"],["は"],["抜き取られ","ぬきとられ"],["、"],["地","ち"],["から"],["起こされ","おこされ"],["、"],["人間","にんげん"],["の"],["よう"],["に"],["二本","にぽん"],["の"],["足","あし"],["で"],["立たされて","たたされて"],["、"],["人間","にんげん"],["の"],["心","こころ"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":5,"text":"また突然、熊に似たほかの第二の獣が現れた。その獣は横ざまに寝ていて、その口のきばの間には三本の肋骨があった。するとそれに、『起き上がって、多くの肉を食らえ』との声がかかった。","tok":[["また"],["突然","とつぜん"],["、"],["熊","くま"],["に"],["似た","にた"],["ほか"],["の"],["第","だい"],["二","に"],["の"],["獣","けもの"],["が"],["現れた","あらわれた"],["。"],["その"],["獣","けもの"],["は"],["横ざま","よこざま"],["に"],["寝て","ねて"],["いて"],["、"],["その"],["口","くち"],["の"],["きば"],["の"],["間","あいだ"],["に"],["は"],["三本","さんぽん"],["の"],["肋骨","あばらぼね"],["が"],["あった"],["。"],["する"],["と"],["それ"],["に"],["、"],["『"],["起き上がって","おきあがって"],["、"],["多く","おおく"],["の"],["肉","にく"],["を"],["食らえ","くらえ"],["』"],["と"],["の"],["声","こえ"],["が"],["かかった"],["。"]]},{"verse":6,"text":"この後、見ていると、また突然、ひょうのようなほかの獣が現れた。その背には四つの鳥の翼があり、その獣には四つの頭があった。そしてそれに主権が与えられた。","tok":[["この"],["後","ご"],["、"],["見て","みて"],["いる"],["と"],["、"],["また"],["突然","とつぜん"],["、"],["ひょう"],["の"],["よう"],["な"],["ほか"],["の"],["獣","けもの"],["が"],["現れた","あらわれた"],["。"],["その"],["背","せ"],["に"],["は"],["四","よん"],["つ"],["の"],["鳥","とり"],["の"],["翼","つばさ"],["が"],["あり"],["、"],["その"],["獣","けもの"],["に"],["は"],["四","よん"],["つ"],["の"],["頭","あたま"],["が"],["あった"],["。"],["そして"],["それ"],["に"],["主権","しゅけん"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":7,"text":"その後また、私が夜の幻を見ていると、突然、第四の獣が現れた。それは恐ろしく、ものすごく、非常に強くて、大きな鉄のきばを持っており、食らって、かみ砕いて、その残りを足で踏みつけた。これは前に現れたすべての獣と異なり、十本の角を持っていた。","tok":[["その後","そのあと"],["また"],["、"],["私","わたくし"],["が"],["夜","よる"],["の"],["幻","まぼろし"],["を"],["見て","みて"],["いる"],["と"],["、"],["突然","とつぜん"],["、"],["第","だい"],["四","よん"],["の"],["獣","けもの"],["が"],["現れた","あらわれた"],["。"],["それ"],["は"],["恐ろしく","おそろしく"],["、"],["ものすごく"],["、"],["非常","ひじょう"],["に"],["強くて","つよくて"],["、"],["大きな","おおきな"],["鉄","てつ"],["の"],["きば"],["を"],["持って","もって"],["おり"],["、"],["食らって","くらって"],["、"],["かみ砕いて","かみくだいて"],["、"],["その"],["残り","のこり"],["を"],["足","あし"],["で"],["踏みつけた","ふみつけた"],["。"],["これ"],["は"],["前","まえ"],["に"],["現れた","あらわれた"],["すべて"],["の"],["獣","けもの"],["と"],["異なり","ことなり"],["、"],["十本","じゅうぽん"],["の"],["角","かど"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":8,"text":"私がその角を注意して見ていると、その間から、もう一本の小さな角が出て来たが、その角のために、初めの角のうち三本が引き抜かれた。よく見ると、この角には、人間の目のような目があり、大きなことを語る口があった。","tok":[["私","わたくし"],["が"],["その"],["角","かど"],["を"],["注意","ちゅうい"],["して"],["見て","みて"],["いる"],["と"],["、"],["その"],["間","あいだ"],["から"],["、"],["もう"],["一本","いちぽん"],["の"],["小さな","ちいさな"],["角","かど"],["が"],["出て","でて"],["来た","きた"],["が"],["、"],["その"],["角","かど"],["の"],["ため"],["に"],["、"],["初め","はじめ"],["の"],["角","かど"],["の"],["うち"],["三本","さんぽん"],["が"],["引き抜かれた","ひきぬかれた"],["。"],["よく"],["見る","みる"],["と"],["、"],["この"],["角","かど"],["に"],["は"],["、"],["人間","にんげん"],["の"],["目","め"],["の"],["よう"],["な"],["目","め"],["が"],[
[{"verse":1,"text":"ユダの王エホヤキムの治世の第三年に、バビロンの王ネブカデネザルがエルサレムに来て、これを包囲した。","tok":[["ユダ"],["の"],["王","おう"],["エホヤキム"],["の"],["治世","ちせい"],["の"],["第","だい"],["三","さん"],["年","ねん"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["が"],["エルサレム"],["に"],["来て","きて"],["、"],["これ"],["を"],["包囲","ほうい"],["した"],["。"]]},{"verse":2,"text":"主がユダの王エホヤキムと神の宮の器具の一部とを彼の手に渡されたので、彼はそれをシヌアルの地にある彼の神の宮に持ち帰り、その器具を彼の神の宝物倉に納めた。","tok":[["主","ぬし"],["が"],["ユダ"],["の"],["王","おう"],["エホヤキム"],["と"],["神","かみ"],["の"],["宮","みや"],["の"],["器具","きぐ"],["の"],["一部","いちぶ"],["と"],["を"],["彼","かれ"],["の"],["手","て"],["に"],["渡された","わたされた"],["ので"],["、"],["彼","かれ"],["は"],["それ"],["を"],["シヌアル"],["の"],["地","ち"],["に"],["ある"],["彼","かれ"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["持ち帰り","もちかえり"],["、"],["その"],["器具","きぐ"],["を"],["彼","かれ"],["の"],["神","かみ"],["の"],["宝物倉","ほうもつそう"],["に"],["納めた","おさめた"],["。"]]},{"verse":3,"text":"王は宦官の長アシュペナズに命じて、イスラエル人の中から、王族か貴族を数人選んで連れて来させた。","tok":[["王","おう"],["は"],["宦官","かんがん"],["の"],["長","ちょう"],["アシュペナズ"],["に"],["命じて","めいじて"],["、"],["イスラエル"],["人","にん"],["の"],["中","なか"],["から"],["、"],["王族","おうぞく"],["か"],["貴族","きぞく"],["を"],["数人","すうにん"],["選んで","えらんで"],["連れて","つれて"],["来させた","きさせた"],["。"]]},{"verse":4,"text":"その少年たちは、身に何の欠陥もなく、容姿は美しく、あらゆる知恵に秀で、知識に富み、思慮深く、王の宮廷に仕えるにふさわしい者であり、また、カルデヤ人の文学とことばとを教えるにふさわしい者であった。","tok":[["その"],["少年","しょうねん"],["たち"],["は"],["、"],["身","み"],["に"],["何","なん"],["の"],["欠陥","けっかん"],["も"],["なく"],["、"],["容姿","ようし"],["は"],["美しく","うつくしく"],["、"],["あらゆる"],["知恵","ちえ"],["に"],["秀で","ひいで"],["、"],["知識","ちしき"],["に"],["富み","とみ"],["、"],["思慮","しりょ"],["深く","ふかく"],["、"],["王","おう"],["の"],["宮廷","きゅうてい"],["に"],["仕える","つかえる"],["に"],["ふさわしい"],["者","もの"],["で"],["あり"],["、"],["また"],["、"],["カルデヤ"],["人","にん"],["の"],["文学","ぶんがく"],["と"],["ことば"],["と"],["を"],["教える","おしえる"],["に"],["ふさわしい"],["者","もの"],["で"],["あった"],["。"]]},{"verse":5,"text":"王は、王の食べるごちそうと王の飲むぶどう酒から、毎日の分を彼らに割り当て、三年間、彼らを養育することにし、そのあとで彼らが王に仕えるようにした。","tok":[["王","おう"],["は"],["、"],["王","おう"],["の"],["食べる","たべる"],["ごちそう"],["と"],["王","おう"],["の"],["飲む","のむ"],["ぶどう酒","ぶどうしゅ"],["から"],["、"],["毎日","まいにち"],["の"],["分","ぶん"],["を"],["彼","かれ"],["ら"],["に"],["割り当て","わりあて"],["、"],["三","さん"],["年間","ねんかん"],["、"],["彼","かれ"],["ら"],["を"],["養育","よういく"],["する"],["こと"],["に"],["し"],["、"],["その"],["あと"],["で"],["彼","かれ"],["ら"],["が"],["王","おう"],["に"],["仕える","つかえる"],["よう"],["に"],["した"],["。"]]},{"verse":6,"text":"彼らのうちには、ユダ部族のダニエル、ハナヌヤ、ミシャエル、アザルヤがいた。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["に"],["は"],["、"],["ユダ"],["部族","ぶぞく"],["の"],["ダニエル"],["、"],["ハナヌヤ"],["、"],["ミシャエル"],["、"],["アザルヤ"],["が"],["いた"],["。"]]},{"verse":7,"text":"宦官の長は彼らにほかの名をつけ、ダニエルにはベルテシャツァル、ハナヌヤにはシャデラク、ミシャエルにはメシャク、アザルヤにはアベデ・ネゴと名をつけた。","tok":[["宦官","かんがん"],["の"],["長","ちょう"],["は"],["彼","かれ"],["ら"],["に"],["ほか"],["の"],["名","な"],["を"],["つけ"],["、"],["ダニエル"],["に"],["は"],["ベルテシャツァル"],["、"],["ハナヌヤ"],["に"],["は"],["シャデラク"],["、"],["ミシャエル"],["に"],["は"],["メシャク"],["、"],["アザルヤ"],["に"],["は"],["アベデ"],["・"],["ネゴ"],["と"],["名","な"],["を"],["つけた"],["。"]]},{"verse":8,"text":"ダニエルは、王の食べるごちそうや王の飲むぶどう酒で身を汚すまいと心に定め、身を汚さないようにさせてくれ、と宦官の長に願った。","tok":[["ダニエル"],["は"],["、"],["王","おう"],["の"],["食べる","たべる"],["ごちそう"],["や"],["王","おう"],["の"],["飲む","のむ"],["ぶどう酒","ぶどうしゅ"],["で"],["身","み"],["を"],["汚すまい","よごすまい"],["と"],["心","こころ"],["に"],["定め","さだめ"],["、"],["身","み"],["を"],["汚さない","よごさない"],["よう"],["に"],["させて"],["くれ"],["、"],["と"],["宦官","かんがん"],["の"],["長","ちょう"],["に"],["願った","ねがった"],["。"]]},{"verse":9,"text":"神は宦官の長に、ダニエルを愛しいつくしむ心を与えられた。","tok":[["神","かみ"],["は"],["宦官","かんがん"],["の"],["長","ちょう"],["に"],["、"],["ダニエル"],["を"],["愛し","あいし"],["いつくしむ"],["心","こころ"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":10,"text":"宦官の長はダニエルに言った。「私は、あなたがたの食べ物と飲み物とを定めた王さまを恐れている。もし王さまが、あなたがたの顔に、あなたがたと同年輩の少年より元気がないのを見たなら、王さまはきっと私を罰するだろう。」","tok":[["宦官","かんがん"],["の"],["長","ちょう"],["は"],["ダニエル"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["の"],["食べ物","たべもの"],["と"],["飲み物","のみもの"],["と"],["を"],["定めた","さだめた"],["王","おう"],["さま"],["を"],["恐れて","おそれて"],["いる"],["。"],["もし"],["王","おう"],["さま"],["が"],["、"],["あなた"],["がた"],["の"],["顔","かお"],["に"],["、"],["あなた"],["がた"],["と"],["同年輩","どうねんぱい"],["の"],["少年","しょうねん"],["より"],["元気","げんき"],["が"],["ない"],["の"],["を"],["見たなら","みたなら"],["、"],["王","おう"],["さま"],["は"],["きっと"],["私","わたくし"],["を"],["罰するだろう","ばっするだろう"],["。"],["」"]]},{"verse":11,"text":"そこで、ダニエルは、宦官の長がダニエル、ハナヌヤ、ミシャエル、アザルヤのために任命した世話役に言った。","tok":[["そこ"],["で"],["、"],["ダニエル"],["は"],["、"],["宦官","かんがん"],["の"],["長","ちょう"],["が"],["ダニエル"],["、"],["ハナヌヤ"],["、"],["ミシャエル"],["、"],["アザルヤ"],["の"],["ため"],["に"],["任命","にんめい"],["した"],["世話役","せわやく"],["に"],["言った","いった"],["。"]]},{"verse":12,"text":"「どうか十日間、しもべたちをためしてください。私たちに野菜を与えて食べさせ、水を与えて飲ませてください。","tok":[["「"],["どう"],["か"],["十","とう"],["日間","かかん"],["、"],["しもべ"],["たち"],["を"],["ためして"],["ください"],["。"],["私たち","わたしたち"],["に"],["野菜","やさい"],["を"],["与えて","あたえて"],["食べさせ","たべさせ"],["、"],["水","みず"],["を"],["与えて","あたえて"],["飲ませて","のませて"],["ください"],["。"]]},{"verse":13,"text":"そのようにして、私たちの顔色と、王さまの食べるごちそうを食べている少年たちの顔色とを見比べて、あなたの見るところに従ってこのしもべたちを扱ってください。」","tok":[["その"],["よう"],["に"],["して"],["、"],["私たち","わたしたち"],["の"],["顔色","かおいろ"],["と"],["、"],["王","おう"],["さま"],["の"],["食べる","たべる"],["ごちそう"],["を"],["食べて","たべて"],["いる"],["少年","しょうねん"],["たち"],["の"],["顔色","かおいろ"],["と"],["を"],["見比べて","みくらべて"],["、"],["あなた"],["の"],["見る","みる"],["ところ"],["に"],["従って","したがって"],["この"],["しもべ"],["たち"],["を"],["扱って","あつかって"],["ください"],["。"],["」"]]},{"verse":14,"text":"世話役は彼らのこの申し出を聞き入れて、十日間、彼らをためしてみた。","tok":[["世話役","せわやく"],["は"],["彼","かれ"],["ら"],["の"],["この"],["申し出","もうしで"],["を"],["聞き入れて","ききいれて"],["、"],["十","とう"],["日間","かかん"],["、"],["彼","かれ"],["ら"],["を"],["ためして"],["みた"],["。"]]},{"verse":15,"text":"十日の終わりになると、彼らの顔色は、王の食べるごちそうを食べているどの少年よりも良く、からだも肥えていた。","tok":[["十日","とうか"],["の"],["終わり","おわり"],["に"],["なる"],["と"],["、"],["彼","かれ"],["ら"],["の"],["顔色","かおいろ"],["は"],["、"],["王","おう"],["の"],["食べる","たべる"],["ごちそう"],["を"],["食べて","たべて"],["いる"],["どの"],["少年","しょうねん"],["より"],["も"],["良く","よく"],["、"],["からだ"],["も"],["肥えて","こえて"],["いた"],["。"]]},{"verse":16,"text":"そこで世話役は、彼らの食べるはずだったごちそうと、飲むはずだったぶどう酒とを取りやめて、彼らに野菜を与えることにした。","tok":[["そこ"],["で"],["世話役","せわやく"],["は"],["、"],["彼","かれ"],["ら"],["の"],["食べる","たべる"],["はず"],["だった"],["ごちそう"],["と"],["、"],["飲む","のむ"],["はず"],["だった"],["ぶどう酒","ぶどうしゅ"],["と"],["を"],["取りやめて","とりやめて"],["、"],["彼","かれ"],["ら"],["に"],["野菜","やさい"],["を"],["与える","あたえる"],["こと"],["に"],["した"],["。"]]},{"verse":17,"text":"神はこの四人の少年に、知識と、あらゆる文学を悟る力と知恵を与えられた。ダニエルは、すべての幻と夢とを解くことができた。","tok":[["神","かみ"],["は"],["この"],["四人","よんにん"],["の"],["少年","しょうねん"],["に"],["、"],["知識","ちしき"],["と"],["、"],["あらゆる"],["文学","ぶんがく"],["を"],["悟る","さとる"],["力","ちから"],["と"],["知恵","ちえ"],["を"],["与えられた","あたえられた"],["。"],["ダニエル"],["は"],["、"],["すべて"],["の"],["幻","まぼろし"],["と"],["夢","ゆめ"],["と"],["を"],["解く","とく"],["こと"],["が"],["できた"],["。"]]},{"verse":18,"text":"彼らを召し入れるために王が命じておいた日数の終わりになって、宦官の長は彼らをネブカデネザルの前に連れて来た。","tok":[["彼","かれ"],["ら"],["を"],["召し入れる","めしいれる"],["ため"],["に"],["王","おう"],["が"],["命じて","めいじて"],["おいた"],["日数","にっすう"],["の"],["終わり","おわり"],["に"],["なって"],["、"],["宦官","かんがん"],["の"],["長","ちょう"],["は"],["彼","かれ"],["ら"],["を"],["ネブカデネザル"],["の"],["前","まえ"],["に"],["連れて","つれて"],["来た","きた"],["。"]]},{"verse":19,"text":"王が彼らと話してみると、みなのうちでだれもダニエル、ハナヌヤ、ミシャエル、アザルヤに並ぶ者はなかった。そこで彼らは王に仕えることになった。","tok":[["王","おう"],["が"],["彼","かれ"],["ら"],["と"],["話して","はなして"],["みる"],["と"],["、"],["みな"],["の"],["うち"],["で"],["だれ"],["も"],["ダニエル"],["、"],["ハナヌヤ"],["、"],["ミシャエル"],["、"],["アザルヤ"],["に"],["並ぶ","ならぶ"],["者","もの"],["は"],["なかった"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["王","おう"],["に"],["仕える","つかえる"],["こと"],["に"],["なった"],["。"]]},{"verse":20,"text":"王が彼らに尋ねてみると、知恵と悟りのあらゆる面で、彼らは国中のどんな呪法師、呪文師よりも十倍もまさっているということがわかった。","tok":[["王","おう"],["が"],["彼","かれ"],["ら"],["に"],["尋ねて","たずねて"],["みる"],["と"],["、"],["知恵","ちえ"],["と"],["悟り","さとり"],["の"],["あらゆる"],["面","めん"],["で"],["、"],["彼","かれ"],["ら"],["は"],["国中","くにちゅう"],["の"],["どんな"],["呪法師","じゅほうし"],["、"],["呪文師","じゅもんし"],["より"],["も"],["十","じゅう"],["倍","ばい"],["も"],["まさって"],["いる"],["と"],["いう"],["こと"],["が"],["わかった"],["。"]]},{"verse":21,"text":"ダニエルはクロス王の元年までそこにいた。","tok":[["ダニエル"],["は"],["クロス"],["王","おう"],["の"],["元年","がんねん"],["まで"],["そこ"],["に"],["いた"],["。"]]}]
[{"verse":1,"text":"ネブカデネザルの治世の第二年に、ネブカデネザルは、幾つかの夢を見、そのために心が騒ぎ、眠れなかった。","tok":[["ネブカデネザル"],["の"],["治世","ちせい"],["の"],["第","だい"],["二","に"],["年","ねん"],["に"],["、"],["ネブカデネザル"],["は"],["、"],["幾つ","いくつ"],["か"],["の"],["夢","ゆめ"],["を"],["見","み"],["、"],["その"],["ため"],["に"],["心","こころ"],["が"],["騒ぎ","さわぎ"],["、"],["眠れなかった","ねむれなかった"],["。"]]},{"verse":2,"text":"そこで王は、呪法師、呪文師、呪術者、カルデヤ人を呼び寄せて、王のためにその夢を解き明かすように命じた。彼らが来て王の前に立つと、","tok":[["そこ"],["で"],["王","おう"],["は"],["、"],["呪法師","じゅほうし"],["、"],["呪文師","じゅもんし"],["、"],["呪術者","じゅじゅつしゃ"],["、"],["カルデヤ"],["人","ひと"],["を"],["呼び寄せて","よびよせて"],["、"],["王","おう"],["の"],["ため"],["に"],["その"],["夢","ゆめ"],["を"],["解き明かす","ときあかす"],["よう"],["に"],["命じた","めいじた"],["。"],["彼","かれ"],["ら"],["が"],["来て","きて"],["王","おう"],["の"],["前","まえ"],["に"],["立つ","たつ"],["と"],["、"]]},{"verse":3,"text":"王は彼らに言った。「私は夢を見たが、その夢を解きたくて私の心は騒いでいる。」","tok":[["王","おう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["夢","ゆめ"],["を"],["見た","みた"],["が"],["、"],["その"],["夢","ゆめ"],["を"],["解きたくて","ときたくて"],["私","わたくし"],["の"],["心","こころ"],["は"],["騒いで","さわいで"],["いる"],["。"],["」"]]},{"verse":4,"text":"カルデヤ人たちは王に告げて言った。――アラム語で――「王よ。永遠に生きられますように。どうぞその夢をしもべたちにお話しください。そうすれば、私たちはその解き明かしをいたしましょう。」","tok":[["カルデヤ"],["人","ひと"],["たち"],["は"],["王","おう"],["に"],["告げて","つげて"],["言った","いった"],["。"],["―"],["―"],["アラム"],["語","ご"],["で"],["―"],["―"],["「"],["王","おう"],["よ"],["。"],["永遠","えいえん"],["に"],["生きられます","いきられます"],["よう"],["に"],["。"],["どうぞ"],["その"],["夢","ゆめ"],["を"],["しもべ"],["たち"],["に"],["お話し","おはなし"],["ください"],["。"],["そう"],["すれば"],["、"],["私たち","わたしたち"],["は"],["その"],["解き明かし","ときあかし"],["を"],["いたしましょう"],["。"],["」"]]},{"verse":5,"text":"王は答えてカルデヤ人たちに言った。「私の言うことにまちがいはない。もし、あなたがたがその夢とその解き明かしとを私に知らせることができなければ、あなたがたの手足を切り離させ、あなたがたの家を滅ぼしてごみの山とさせる。","tok":[["王","おう"],["は"],["答えて","こたえて"],["カルデヤ"],["人","ひと"],["たち"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["言う","いう"],["こと"],["に"],["まちがい"],["は"],["ない"],["。"],["もし"],["、"],["あなた"],["がた"],["が"],["その"],["夢","ゆめ"],["と"],["その"],["解き明かし","ときあかし"],["と"],["を"],["私","わたくし"],["に"],["知らせる","しらせる"],["こと"],["が"],["できなければ"],["、"],["あなた"],["がた"],["の"],["手足","てあし"],["を"],["切り離させ","きりはなさせ"],["、"],["あなた"],["がた"],["の"],["家","いえ"],["を"],["滅ぼして","ほろぼして"],["ごみ"],["の"],["山","やま"],["と"],["させる"],["。"]]},{"verse":6,"text":"しかし、もし夢と解き明かしとを知らせたら、贈り物と報酬と大きな光栄とを私から受けよう。だから、夢と解き明かしとを私に知らせよ。」","tok":[["しかし"],["、"],["もし"],["夢","ゆめ"],["と"],["解き明かし","ときあかし"],["と"],["を"],["知らせたら","しらせたら"],["、"],["贈り物","おくりもの"],["と"],["報酬","ほうしゅう"],["と"],["大きな","おおきな"],["光栄","こうえい"],["と"],["を"],["私","わたくし"],["から"],["受けよう","うけよう"],["。"],["だ"],["から"],["、"],["夢","ゆめ"],["と"],["解き明かし","ときあかし"],["と"],["を"],["私","わたくし"],["に"],["知らせ","しらせ"],["よ"],["。"],["」"]]},{"verse":7,"text":"彼らは再び答えて言った。「王よ。しもべたちにその夢をお話しください。そうすれば、解き明かしてごらんにいれます。」","tok":[["彼","かれ"],["ら"],["は"],["再び","ふたたび"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["王","おう"],["よ"],["。"],["しもべ"],["たち"],["に"],["その"],["夢","ゆめ"],["を"],["お話し","おはなし"],["ください"],["。"],["そう"],["すれば"],["、"],["解き明かして","ときあかして"],["ごらん"],["に"],["いれます"],["。"],["」"]]},{"verse":8,"text":"王は答えて言った。「私には、はっきりわかっている。あなたがたは私の言うことにまちがいはないのを見てとって、時をかせごうとしているのだ。","tok":[["王","おう"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["は"],["、"],["はっきり"],["わかって"],["いる"],["。"],["あなた"],["がた"],["は"],["私","わたくし"],["の"],["言う","いう"],["こと"],["に"],["まちがい"],["は"],["ない"],["の"],["を"],["見て","みて"],["とって"],["、"],["時","とき"],["を"],["かせごう"],["として"],["いる"],["の"],["だ"],["。"]]},{"verse":9,"text":"もしあなたがたがその夢を私に知らせないなら、あなたがたへの判決はただ一つ。あなたがたは時が移り変わるまで、偽りと欺きのことばを私の前に述べようと決めてかかっている。だから、どんな夢かを私に話せ。そうすれば、あなたがたがその解き明かしを私に示せるかどうか、私にわかるだろう。」","tok":[["もし"],["あなた"],["がた"],["が"],["その"],["夢","ゆめ"],["を"],["私","わたくし"],["に"],["知らせないなら","しらせないなら"],["、"],["あなた"],["が"],["たへ"],["の"],["判決","はんけつ"],["は"],["ただ"],["一","ひと"],["つ"],["。"],["あなた"],["がた"],["は"],["時","とき"],["が"],["移り変わる","うつりかわる"],["まで"],["、"],["偽り","いつわり"],["と"],["欺き","あざむき"],["の"],["ことば"],["を"],["私","わたくし"],["の"],["前","まえ"],["に"],["述べよう","のべよう"],["と"],["決めて","きめて"],["かかって"],["いる"],["。"],["だ"],["から"],["、"],["どんな"],["夢","ゆめ"],["か"],["を"],["私","わたくし"],["に"],["話せ","はなせ"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["が"],["その"],["解き明かし","ときあかし"],["を"],["私","わたくし"],["に"],["示せる","しめせる"],["か"],["どう"],["か"],["、"],["私","わたくし"],["に"],["わかるだろう"],["。"],["」"]]},{"verse":10,"text":"カルデヤ人たちは王の前に答えて言った。「この地上には、王の言われることを示すことのできる者はひとりもありません。どんな偉大な権力のある王でも、このようなことを呪法師や呪文師、あるいはカルデヤ人に尋ねたことはかつてありません。","tok":[["カルデヤ"],["人","ひと"],["たち"],["は"],["王","おう"],["の"],["前","まえ"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["この"],["地上","ちじょう"],["に"],["は"],["、"],["王","おう"],["の"],["言われる","いわれる"],["こと"],["を"],["示す","しめす"],["こと"],["の"],["できる"],["者","もの"],["は"],["ひとり"],["も"],["ありません"],["。"],["どんな"],["偉大","いだい"],["な"],["権力","けんりょく"],["の"],["ある"],["王","おう"],["で"],["も"],["、"],["この"],["よう"],["な"],["こと"],["を"],["呪法師","じゅほうし"],["や"],["呪文師","じゅもんし"],["、"],["あるいは"],["カルデヤ"],["人","にん"],["に"],["尋ねた","たずねた"],["こと"],["は"],["かつて"],["ありません"],["。"]]},{"verse":11,"text":"王のお尋ねになることは、むずかしいことです。肉なる者とその住まいを共にされない神々以外には、それを王の前に示すことのできる者はいません。」","tok":[["王","おう"],["の"],["お尋ね","おたずね"],["に"],["なる"],["こと"],["は"],["、"],["むずかしい"],["こと"],["です"],["。"],["肉","にく"],["なる"],["者","もの"],["と"],["その"],["住まい","すまい"],["を"],["共","とも"],["に"],["されない"],["神々","かみがみ"],["以外","いがい"],["に"],["は"],["、"],["それ"],["を"],["王","おう"],["の"],["前","まえ"],["に"],["示す","しめす"],["こと"],["の"],["できる"],["者","もの"],["は"],["いません"],["。"],["」"]]},{"verse":12,"text":"王は怒り、大いにたけり狂い、バビロンの知者をすべて滅ぼせと命じた。","tok":[["王","おう"],["は"],["怒り","おこり"],["、"],["大いに","おおいに"],["たけり狂い","たけりくるい"],["、"],["バビロン"],["の"],["知者","ちしゃ"],["を"],["すべて"],["滅ぼせ","ほろぼせ"],["と"],["命じた","めいじた"],["。"]]},{"verse":13,"text":"この命令が発せられたので、知者たちは殺されることになった。また人々はダニエルとその同僚をも捜して殺そうとした。","tok":[["この"],["命令","めいれい"],["が"],["発せられた","はっせられた"],["ので"],["、"],["知者","ちしゃ"],["たち"],["は"],["殺される","ころされる"],["こと"],["に"],["なった"],["。"],["また"],["人々","ひとびと"],["は"],["ダニエル"],["と"],["その"],["同僚","どうりょう"],["を"],["も"],["捜して","さがして"],["殺そう","ころそう"],["と"],["した"],["。"]]},{"verse":14,"text":"そのとき、ダニエルは、バビロンの知者たちを殺すために出て来た王の侍従長アルヨクに、知恵と思慮とをもって応対した。","tok":[["その"],["とき"],["、"],["ダニエル"],["は"],["、"],["バビロン"],["の"],["知者","ちしゃ"],["たち"],["を"],["殺す","ころす"],["ため"],["に"],["出て","でて"],["来た","きた"],["王","おう"],["の"],["侍従長","じじゅうちょう"],["アルヨク"],["に"],["、"],["知恵","ちえ"],["と"],["思慮","しりょ"],["と"],["を"],["もって"],["応対","おうたい"],["した"],["。"]]},{"verse":15,"text":"彼は王の全権を受けたアルヨクにこう言った。「どうしてそんなにきびしい命令が王から出たのでしょうか。」それで、アルヨクは事の次第をダニエルに知らせた。","tok":[["彼","かれ"],["は"],["王","おう"],["の"],["全権","ぜんけん"],["を"],["受けた","うけた"],["アルヨク"],["に"],["こう"],["言った","いった"],["。"],["「"],["どう"],["して"],["そんな"],["に"],["きびしい"],["命令","めいれい"],["が"],["王","おう"],["から"],["出た","でた"],["の"],["でしょう"],["か"],["。"],["」"],["それ"],["で"],["、"],["アルヨク"],["は"],["事","こと"],["の"],["次第","しだい"],["を"],["ダニエル"],["に"],["知らせた","しらせた"],["。"]]},{"verse":16,"text":"ダニエルは王のところに行き、王にその解き明かしをするため、しばらくの時を与えてくれるように願った。","tok":[["ダニエル"],["は"],["王","おう"],["の"],["ところ"],["に"],["行き","いき"],["、"],["王","おう"],["に"],["その"],["解き明かし","ときあかし"],["を"],["する"],["ため"],["、"],["しばらく"],["の"],["時","とき"],["を"],["与えて","あたえて"],["くれる"],["よう"],["に"],["願った","ねがった"],["。"]]},{"verse":17,"text":"それから、ダニエルは自分の家に帰り、彼の同僚のハナヌヤ、ミシャエル、アザルヤにこのことを知らせた。","tok":[["それ"],["から"],["、"],["ダニエル"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰り","かえり"],["、"],["彼","かれ"],["の"],["同僚","どうりょう"],["の"],["ハナヌヤ"],["、"],["ミシャエル"],["、"],["アザルヤ"],["に"],["この"],["こと"],["を"],["知らせた","しらせた"],["。"]]},{"verse":18,"text":"彼らはこの秘密について、天の神のあわれみを請い、ダニエルとその同僚が他のバビロンの知者たちとともに滅ぼされることのないようにと願った。","tok":[["彼","かれ"],["ら"],["は"],["この"],["秘密","ひみつ"],["について"],["、"],["天","てん"],["の"],["神","かみ"],["の"],["あわれみ"],["を"],["請い","こい"],["、"],["ダニエル"],["と"],["その"],["同僚","どうりょう"],["が"],["他","ほか"],["の"],["バビロン"],["の"],["知者","ちしゃ"],["たち"],["と"],["とも"],["に"],["滅ぼされる","ほろぼされる"],["こと"],["の"],["ない"],["よう"],["に"],["と"],["願った","ねがった"],["。"]]},{"verse":19,"text":"そのとき、夜の幻のうちにこの秘密がダニエルに啓示されたので、ダニエルは天の神をほめたたえた。","tok":[["その"],["とき"],["、"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["うち"],["に"],["この"],["秘密","ひみつ"],["が"],["ダニエル"],["に"],["啓示","けいじ"],["された"],["ので"],["、"],["ダニエル"],["は"],["天","てん"],["の"],["神","かみ"],["を"],["ほめたたえた"],["。"]]},{"verse":20,"text":"ダニエルはこう言った。／「神の御名は／とこしえからとこしえまで／ほむべきかな。／知恵と力は神のもの。","tok":[["ダニエル"],["は"],["こう"],["言った","いった"],["。"],["／"],["「"],["神","かみ"],["の"],["御名","ぎょめい"],["は"],["／"],["とこしえ"],["から"],["とこしえ"],["まで"],["／"],["ほ"],["むべき"],["か"],["な"],["。"],["／"],["知恵","ちえ"],["と"],["力","ちから"],["は"],["神","かみ"],["の"],["もの"],["。"]]},{"verse":21,"text":"神は季節と時を変え、王を廃し、王を立て、知者には知恵を、理性のある者には知識を授けられる。","tok":[["神","かみ"],["は"],["季節","きせつ"],["と"],["時","とき"],["を"],["変え","かえ"],["、"],["王","おう"],["を"],["廃し","はいし"],["、"],["王","おう"],["を"],["立て","たて"],["、"],["知者","ちしゃ"],["に"],["は"],["知恵","ちえ"],["を"],["、"],["理性","りせい"],["の"],["ある"],["者","もの"],["に"],["は"],["知識","ちしき"],["を"],["授けられる","さずけられる"],["。"]]},{"verse":22,"text":"神は、深くて測り知れないことも、隠されていることもあらわし、暗黒にあるものを知り、ご自身に光を宿す。","tok":[["神","かみ"],["は"],["、"],["深くて","ふかくて"],["測り知れない","はかりしれない"],["こと"],["も"],["、"],["隠されて","かくされて"],["いる"],["こと"],["も"],["あらわし"],["、"],["暗黒","あんこく"],["に"],["ある"],["もの"],["を"],["知り","しり"],["、"],["ご自身","ごじしん"],["に"],["光","ひかり"],["を"],["宿す","やどす"],["。"]]},{"verse":23,"text":"私の先祖の神。／私はあなたに感謝し、あなたを賛美します。／あなたは私に知恵と力とを賜い、今、私たちがあなたに請いねがったことを／私に知らせ、王のことを私たちに知らせてくださいました。」","tok":[["私","わたくし"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["。"],["／"],["私","わたくし"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["あなた"],["を"],["賛美","さんび"],["します"],["。"],["／"],["あなた"],["は"],["私","わたくし"],["に"],["知恵","ちえ"],["と"],["力","ちから"],["と"],["を"],["賜い","たまい"],["、"],["今","いま"],["、"],["私たち","わたしたち"],["が"],["あなた"],["に"],["請い","こい"],["ねがった"],["こと"],["を"],["／"],["私","わたくし"],["に"],["知らせ","しらせ"],["、"],["王","おう"],["の"],["こと"],["を"],["私たち","わたしたち"],["に"],["知らせて","しらせて"],["くださいました"],["。"],["」"]]},{"verse":24,"text":"それからダニエルは、王がバビロンの知者たちを滅ぼすように命じておいたアルヨクのもとに行き、彼にこう言った。「バビロンの知者たちを滅ぼしてはなりません。私を王の前に連れて行ってください。私が王に解き明かしを示します。」","tok":[["それ"],["から"],["ダニエル"],["は"],["、"],["王","おう"],["が"],["バビロン"],["の"],["知者","ちしゃ"],["たち"],["を"],["滅ぼす","ほろぼす"],["よう"],["に"],["命じて","めいじて"],["おいた"],["アルヨク"],["の"],["もと"],["に"],["行き","いき"],["、"],["彼","かれ"],["に"],["こう"],["言った","いった"],["。"],["「"],["バビロン"],["の"],["知者","ちしゃ"],["たち"],["を"],["滅ぼして","ほろぼして"],["は"],["なりません"],["。"],["私","わたくし"],["を"],["王","おう"],["の"],["前","まえ"],["に"],["連れて","つれて"],["行って","いって"],["ください"],["。"],["私","わたくし"],["が"],["王","おう"],["に"],["解き明かし","ときあかし"],["を"],["示します","しめします"],["。"],["」"]]},{"verse":25,"text":"そこで、アルヨクは急いでダニエルを王の前に連れて行き、王にこう言った。「ユダからの捕虜の中に、王に解き明かしのできるひとりの男を見つけました。」","tok":[["そこ"],["で"],["、"],["アルヨク"],["は"],["急いで","いそいで"],["ダニエル"],["を"],["王","おう"],["の"],["前","まえ"],["に"],["連れて","つれて"],["行き","いき"],["、"],["王","おう"],["に"],["こう"],["言った","いった"],["。"],["「"],["ユダ"],["から"],["の"],["捕虜","ほりょ"],["の"],["中","なか"],["に"],["、"],["王","おう"],["に"],["解き明かし","ときあかし"],["の"],["できる"],["ひとり"],["の"],["男","おとこ"],["を"],["見つけました","みつけました"],["。"],["」"]]},{"verse":26,"text":"それで王は、ベルテシャツァルという名のダニエルに言った。「あなたは私が見た夢と、その解き明かしを私に示すことができるのか。」","tok":[["それ"],["で"],["王","おう"],["は"],["、"],["ベルテシャツァル"],["と"],["いう"],["名","な"],["の"],["ダニエル"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["が"],["見た","みた"],["夢","ゆめ"],["と"],["、"],["その"],["解き明かし","ときあかし"],["を"],["私","わたくし"],["に"],["示す","しめす"],["こと"],["が"],["できる"],["の"],["か"],["。"],["」"]]},{"verse":27,"text":"ダニエルは王に答えて言った。「王が求められる秘密は、知者、呪文師、呪法師、星占いも王に示すことはできません。","tok":[["ダニエル"],["は"],["王","おう"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["王","おう"],["が"],["求められる","もとめられる"],["秘密","ひみつ"],["は"],["、"],["知者","ちしゃ"],["、"],["呪文師","じゅもんし"],["、"],["呪法師","じゅほうし"],["、"],["星","ほし"],["占い","うらない"],["も"],["王","おう"],["に"],["示す","しめす"],["こと"],["は"],["できません"],["。"]]},{"verse":28,"text":"しかし、天に秘密をあらわすひとりの神がおられ、この方が終わりの日に起こることをネブカデネザル王に示されたのです。あなたの夢と、寝床であなたの頭に浮かんだ幻はこれです。","tok":[["しかし"],["、"],["天","てん"],["に"],["秘密","ひみつ"],["を"],["あらわす"],["ひとり"],["の"],["神","かみ"],["が"],["おられ"],["、"],["この"],["方","ほう"],["が"],["終わり","おわり"],["の"],["日","ひ"],["に"],["起こる","おこる"],["こと"],["を"],["ネブカデネザル"],["王","おう"],["に"],["示された","しめされた"],["の"],["です"],["。"],["あなた"],["の"],["夢","ゆめ"],["と"],["、"],["寝床","ねどこ"],["で"],["あなた"],["の"],["頭","あたま"],["に"],["浮かんだ","うかんだ"],["幻","まぼろし"],["は"],["これ"],["です"],["。"]]},{"verse":29,"te
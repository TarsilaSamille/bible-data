[{"verse":1,"text":"その時、あなたの国の人々を守る大いなる君、ミカエルが立ち上がる。国が始まって以来、その時まで、かつてなかったほどの苦難の時が来る。しかし、その時、あなたの民で、あの書にしるされている者はすべて救われる。","tok":[["その"],["時","とき"],["、"],["あなた"],["の"],["国","くに"],["の"],["人々","ひとびと"],["を"],["守る","まもる"],["大いなる","おおいなる"],["君","きみ"],["、"],["ミカエル"],["が"],["立ち上がる","たちあがる"],["。"],["国","くに"],["が"],["始まって","はじまって"],["以来","いらい"],["、"],["その"],["時","とき"],["まで"],["、"],["かつて"],["なかった"],["ほど"],["の"],["苦難","くなん"],["の"],["時","とき"],["が"],["来る","くる"],["。"],["しかし"],["、"],["その"],["時","とき"],["、"],["あなた"],["の"],["民","たみ"],["で"],["、"],["あの"],["書","しょ"],["に"],["しるされて"],["いる"],["者","もの"],["は"],["すべて"],["救われる","すくわれる"],["。"]]},{"verse":2,"text":"地のちりの中に眠っている者のうち、多くの者が目をさます。ある者は永遠のいのちに、ある者はそしりと永遠の忌みに。","tok":[["地","ち"],["の"],["ちり"],["の"],["中","なか"],["に"],["眠って","ねむって"],["いる"],["者","もの"],["の"],["うち"],["、"],["多く","おおく"],["の"],["者","もの"],["が"],["目","め"],["を"],["さます"],["。"],["ある"],["者","もの"],["は"],["永遠","えいえん"],["の"],["いのち"],["に"],["、"],["ある"],["者","もの"],["は"],["そしり"],["と"],["永遠","えいえん"],["の"],["忌み","いみ"],["に"],["。"]]},{"verse":3,"text":"思慮深い人々は大空の輝きのように輝き、多くの者を義とした者は、世々限りなく、星のようになる。","tok":[["思慮","しりょ"],["深い","ふかい"],["人々","ひとびと"],["は"],["大空","おおぞら"],["の"],["輝き","かがやき"],["の"],["よう"],["に"],["輝き","かがやき"],["、"],["多く","おおく"],["の"],["者","もの"],["を"],["義","ぎ"],["と"],["した"],["者","もの"],["は"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["、"],["星","ほし"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":4,"text":"ダニエルよ。あなたは終わりの時まで、このことばを秘めておき、この書を封じておけ。多くの者は知識を増そうと探り回ろう。」","tok":[["ダニエル"],["よ"],["。"],["あなた"],["は"],["終わり","おわり"],["の"],["時","とき"],["まで"],["、"],["この"],["ことば"],["を"],["秘めて","ひめて"],["おき"],["、"],["この"],["書","しょ"],["を"],["封じて","ふうじて"],["おけ"],["。"],["多く","おおく"],["の"],["者","もの"],["は"],["知識","ちしき"],["を"],["増そう","まそう"],["と"],["探り回ろう","さぐりまわろう"],["。"],["」"]]},{"verse":5,"text":"私、ダニエルが見ていると、見よ、ふたりの人が立っていて、ひとりは川のこちら岸に、ほかのひとりは川の向こう岸にいた。","tok":[["私","わたくし"],["、"],["ダニエル"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["ふたり"],["の"],["人","ひと"],["が"],["立って","たって"],["いて"],["、"],["ひとり"],["は"],["川","かわ"],["の"],["こちら岸","こちらぎし"],["に"],["、"],["ほか"],["の"],["ひとり"],["は"],["川","かわ"],["の"],["向こう岸","むこうぎし"],["に"],["いた"],["。"]]},{"verse":6,"text":"それで私は、川の水の上にいる、あの亜麻布の衣を着た人に言った。「この不思議なことは、いつになって終わるのですか。」","tok":[["それ"],["で"],["私","わたくし"],["は"],["、"],["川","かわ"],["の"],["水","みず"],["の"],["上","うえ"],["に"],["いる"],["、"],["あの"],["亜","あ"],["麻布","あざぶ"],["の"],["衣","ころも"],["を"],["着た","きた"],["人","ひと"],["に"],["言った","いった"],["。"],["「"],["この"],["不思議","ふしぎ"],["な"],["こと"],["は"],["、"],["いつ"],["に"],["なって"],["終わる","おわる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":7,"text":"すると私は、川の水の上にいる、あの亜麻布の衣を着た人が語るのを聞いた。彼は、その右手と左手を天に向けて上げ、永遠に生きる方をさして誓って言った。「それは、ひと時とふた時と半時である。聖なる民の勢力を打ち砕くことが終わったとき、これらすべてのことが成就する。」","tok":[["する"],["と"],["私","わたくし"],["は"],["、"],["川","かわ"],["の"],["水","みず"],["の"],["上","うえ"],["に"],["いる"],["、"],["あの"],["亜","あ"],["麻布","あざぶ"],["の"],["衣","ころも"],["を"],["着た","きた"],["人","ひと"],["が"],["語る","かたる"],["の"],["を"],["聞いた","きいた"],["。"],["彼","かれ"],["は"],["、"],["その"],["右手","みぎて"],["と"],["左手","ひだりて"],["を"],["天","てん"],["に"],["向けて","むけて"],["上げ","あげ"],["、"],["永遠","えいえん"],["に"],["生きる","いきる"],["方","かた"],["を"],["さして"],["誓って","ちかって"],["言った","いった"],["。"],["「"],["それ"],["は"],["、"],["ひと時","ひととき"],["と"],["ふた"],["時","じ"],["と"],["半時","はんとき"],["で"],["ある"],["。"],["聖","せい"],["なる"],["民","たみ"],["の"],["勢力","せいりょく"],["を"],["打ち砕く","うちくだく"],["こと"],["が"],["終わった","おわった"],["とき"],["、"],["これ"],["ら"],["すべて"],["の"],["こと"],["が"],["成就","じょうじゅ"],["する"],["。"],["」"]]},{"verse":8,"text":"私はこれを聞いたが、悟ることができなかった。そこで、私は尋ねた。「わが主よ。この終わりは、どうなるのでしょう。」","tok":[["私","わたくし"],["は"],["これ"],["を"],["聞いた","きいた"],["が"],["、"],["悟る","さとる"],["こと"],["が"],["できなかった"],["。"],["そこ"],["で"],["、"],["私","わたくし"],["は"],["尋ねた","たずねた"],["。"],["「"],["わが"],["主","ぬし"],["よ"],["。"],["この"],["終わり","おわり"],["は"],["、"],["どう"],["なる"],["の"],["でしょう"],["。"],["」"]]},{"verse":9,"text":"彼は言った。「ダニエルよ。行け。このことばは、終わりの時まで、秘められ、封じられているからだ。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["ダニエル"],["よ"],["。"],["行け","いけ"],["。"],["この"],["ことば"],["は"],["、"],["終わり","おわり"],["の"],["時","とき"],["まで"],["、"],["秘められ","ひめられ"],["、"],["封じられて","ふうじられて"],["いる"],["から"],["だ"],["。"]]},{"verse":10,"text":"多くの者は、身を清め、白くし、こうして練られる。悪者どもは悪を行い、ひとりも悟る者がいない。しかし、思慮深い人々は悟る。","tok":[["多く","おおく"],["の"],["者","もの"],["は"],["、"],["身","み"],["を"],["清め","きよめ"],["、"],["白く","しろく"],["し"],["、"],["こう"],["して"],["練られる","ねられる"],["。"],["悪者","わるもの"],["ども"],["は"],["悪","あく"],["を"],["行い","おこない"],["、"],["ひとり"],["も"],["悟る","さとる"],["者","もの"],["が"],["いない"],["。"],["しかし"],["、"],["思慮","しりょ"],["深い","ふかい"],["人々","ひとびと"],["は"],["悟る","さとる"],["。"]]},{"verse":11,"text":"常供のささげ物が取り除かれ、荒らす忌むべきものが据えられる時から千二百九十日がある。","tok":[["常供","つねとも"],["の"],["ささげ物","ささげもの"],["が"],["取り除かれ","とりのぞかれ"],["、"],["荒らす","あらす"],["忌むべき","いむべき"],["もの"],["が"],["据えられる","すえられる"],["時","とき"],["から"],["千二百九十","せんにひゃくきゅうとう"],["日","か"],["が"],["ある"],["。"]]},{"verse":12,"text":"幸いなことよ。忍んで待ち、千三百三十五日に達する者は。","tok":[["幸い","さいわい"],["な"],["こと"],["よ"],["。"],["忍んで","しのんで"],["待ち","まち"],["、"],["千三百三十五","せんさんひゃくさんじゅうご"],["日","にち"],["に"],["達する","たっする"],["者","もの"],["は"],["。"]]},{"verse":13,"text":"あなたは終わりまで歩み、休みに入れ。あなたは時の終わりに、あなたの割り当ての地に立つ。」","tok":[["あなた"],["は"],["終わり","おわり"],["まで"],["歩み","あゆみ"],["、"],["休み","やすみ"],["に"],["入れ","いれ"],["。"],["あなた"],["は"],["時","とき"],["の"],["終わり","おわり"],["に"],["、"],["あなた"],["の"],["割り当て","わりあて"],["の"],["地","ち"],["に"],["立つ","たつ"],["。"],["」"]]}]
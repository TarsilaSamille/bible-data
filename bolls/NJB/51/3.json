[{"verse":1,"text":"こういうわけで、もしあなたがたが、キリストとともによみがえらされたのなら、上にあるものを求めなさい。そこにはキリストが、神の右に座を占めておられます。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["もし"],["あなた"],["が"],["た"],["が"],["、"],["キリスト"],["と"],["とも"],["に"],["よみがえらされた"],["の"],["なら"],["、"],["上","うえ"],["に"],["ある"],["もの"],["を"],["求め","もとめ"],["なさい"],["。"],["そこ"],["に"],["は"],["キリスト"],["が"],["、"],["神","かみ"],["の"],["右","みぎ"],["に"],["座","ざ"],["を"],["占めて","しめて"],["おられます"],["。"]]},{"verse":2,"text":"あなたがたは、地上のものを思わず、天にあるものを思いなさい。","tok":[["あなた"],["がた"],["は"],["、"],["地上","ちじょう"],["の"],["もの"],["を"],["思わず","おもわず"],["、"],["天","てん"],["に"],["ある"],["もの"],["を"],["思い","おもい"],["なさい"],["。"]]},{"verse":3,"text":"あなたがたはすでに死んでおり、あなたがたのいのちは、キリストとともに、神のうちに隠されてあるからです。","tok":[["あなた"],["がた"],["は"],["すでに"],["死んで","しんで"],["おり"],["、"],["あなた"],["がた"],["の"],["いのち"],["は"],["、"],["キリスト"],["と"],["とも"],["に"],["、"],["神","かみ"],["の"],["うち"],["に"],["隠されて","かくされて"],["ある"],["から"],["です"],["。"]]},{"verse":4,"text":"私たちのいのちであるキリストが現れると、そのときあなたがたも、キリストとともに、栄光のうちに現れます。","tok":[["私たち","わたしたち"],["の"],["いのち"],["で"],["ある"],["キリスト"],["が"],["現れる","あらわれる"],["と"],["、"],["その"],["とき"],["あなた"],["がた"],["も"],["、"],["キリスト"],["と"],["とも"],["に"],["、"],["栄光","えいこう"],["の"],["うち"],["に"],["現れます","あらわれます"],["。"]]},{"verse":5,"text":"ですから、地上のからだの諸部分、すなわち、不品行、汚れ、情欲、悪い欲、そしてむさぼりを殺してしまいなさい。このむさぼりが、そのまま偶像礼拝なのです。","tok":[["です"],["から"],["、"],["地上","ちじょう"],["の"],["からだ"],["の"],["諸","しょ"],["部分","ぶぶん"],["、"],["すなわち"],["、"],["不品行","ふひんこう"],["、"],["汚れ","よごれ"],["、"],["情欲","じょうよく"],["、"],["悪い","わるい"],["欲","よく"],["、"],["そして"],["むさぼり"],["を"],["殺して","ころして"],["しまい"],["なさい"],["。"],["この"],["むさぼり"],["が"],["、"],["そのまま"],["偶像","ぐうぞう"],["礼拝","れいはい"],["な"],["の"],["です"],["。"]]},{"verse":6,"text":"このようなことのために、神の怒りが下るのです。","tok":[["この"],["よう"],["な"],["こと"],["の"],["ため"],["に"],["、"],["神","かみ"],["の"],["怒り","いかり"],["が"],["下る","くだる"],["の"],["です"],["。"]]},{"verse":7,"text":"あなたがたも、以前、そのようなものの中に生きていたときは、そのような歩み方をしていました。","tok":[["あなた"],["がた"],["も"],["、"],["以前","いぜん"],["、"],["その"],["よう"],["な"],["もの"],["の"],["中","なか"],["に"],["生きて","いきて"],["いた"],["とき"],["は"],["、"],["その"],["よう"],["な"],["歩み","あゆみ"],["方","かた"],["を"],["して"],["いました"],["。"]]},{"verse":8,"text":"しかし今は、あなたがたも、すべてこれらのこと、すなわち、怒り、憤り、悪意、そしり、あなたがたの口から出る恥ずべきことばを、捨ててしまいなさい。","tok":[["しかし"],["今","いま"],["は"],["、"],["あなた"],["がた"],["も"],["、"],["すべて"],["これ"],["ら"],["の"],["こと"],["、"],["すなわち"],["、"],["怒り","いかり"],["、"],["憤り","いきどおり"],["、"],["悪意","あくい"],["、"],["そしり"],["、"],["あなた"],["がた"],["の"],["口","くち"],["から"],["出る","でる"],["恥ずべき","はずべき"],["ことば"],["を"],["、"],["捨てて","すてて"],["しまい"],["なさい"],["。"]]},{"verse":9,"text":"互いに偽りを言ってはいけません。あなたがたは、古い人をその行いといっしょに脱ぎ捨てて、","tok":[["互い","たがい"],["に"],["偽り","いつわり"],["を"],["言って","いって"],["は"],["いけません"],["。"],["あなた"],["がた"],["は"],["、"],["古い","ふるい"],["人","ひと"],["を"],["その"],["行い","おこない"],["と"],["いっしょ"],["に"],["脱ぎ捨てて","ぬぎすてて"],["、"]]},{"verse":10,"text":"新しい人を着たのです。新しい人は、造り主のかたちに似せられてますます新しくされ、真の知識に至るのです。","tok":[["新しい","あたらしい"],["人","ひと"],["を"],["着た","きた"],["の"],["です"],["。"],["新しい","あたらしい"],["人","ひと"],["は"],["、"],["造り主","つくりぬし"],["の"],["かたち"],["に"],["似せられて","にせられて"],["ますます"],["新しく","あたらしく"],["され"],["、"],["真","しん"],["の"],["知識","ちしき"],["に"],["至る","いたる"],["の"],["です"],["。"]]},{"verse":11,"text":"そこには、ギリシヤ人とユダヤ人、割礼の有無、未開人、スクテヤ人、奴隷と自由人というような区別はありません。キリストがすべてであり、すべてのうちにおられるのです。","tok":[["そこ"],["に"],["は"],["、"],["ギリシヤ"],["人","にん"],["と"],["ユダヤ人","ゆだやじん"],["、"],["割礼","かつれい"],["の"],["有無","うむ"],["、"],["未開人","みかいにん"],["、"],["スクテヤ"],["人","にん"],["、"],["奴隷","どれい"],["と"],["自由人","じゆうにん"],["と"],["いう"],["よう"],["な"],["区別","くべつ"],["は"],["ありません"],["。"],["キリスト"],["が"],["すべて"],["で"],["あり"],["、"],["すべて"],["の"],["うち"],["に"],["おられる"],["の"],["です"],["。"]]},{"verse":12,"text":"それゆえ、神に選ばれた者、聖なる、愛されている者として、あなたがたは深い同情心、慈愛、謙遜、柔和、寛容を身に着けなさい。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["に"],["選ばれた","えらばれた"],["者","もの"],["、"],["聖","せい"],["なる"],["、"],["愛されて","あいされて"],["いる"],["者","もの"],["として"],["、"],["あなた"],["がた"],["は"],["深い","ふかい"],["同情心","どうじょうしん"],["、"],["慈愛","じあい"],["、"],["謙遜","けんそん"],["、"],["柔和","にゅうわ"],["、"],["寛容","かんよう"],["を"],["身","み"],["に"],["着け","つけ"],["なさい"],["。"]]},{"verse":13,"text":"互いに忍び合い、だれかがほかの人に不満を抱くことがあっても、互いに赦し合いなさい。主があなたがたを赦してくださったように、あなたがたもそうしなさい。","tok":[["互い","たがい"],["に"],["忍び","しのび"],["合い","あい"],["、"],["だれ"],["か"],["が"],["ほか"],["の"],["人","ひと"],["に"],["不満","ふまん"],["を"],["抱く","いだく"],["こと"],["が"],["あって"],["も"],["、"],["互い","たがい"],["に"],["赦し","ゆるし"],["合い","あい"],["なさい"],["。"],["主","ぬし"],["が"],["あなた"],["がた"],["を"],["赦して","ゆるして"],["くださった"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["そう"],["し"],["なさい"],["。"]]},{"verse":14,"text":"そして、これらすべての上に、愛を着けなさい。愛は結びの帯として完全なものです。","tok":[["そして"],["、"],["これ"],["ら"],["すべて"],["の"],["上","うえ"],["に"],["、"],["愛","あい"],["を"],["着け","つけ"],["なさい"],["。"],["愛","あい"],["は"],["結び","むすび"],["の"],["帯","おび"],["として"],["完全","かんぜん"],["な"],["もの"],["です"],["。"]]},{"verse":15,"text":"キリストの平和が、あなたがたの心を支配するようにしなさい。そのためにこそあなたがたも召されて一体となったのです。また、感謝の心を持つ人になりなさい。","tok":[["キリスト"],["の"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["支配","しはい"],["する"],["よう"],["に"],["し"],["なさい"],["。"],["その"],["ため"],["に"],["こそ"],["あなた"],["がた"],["も"],["召されて","めされて"],["一体","いったい"],["と"],["なった"],["の"],["です"],["。"],["また"],["、"],["感謝","かんしゃ"],["の"],["心","こころ"],["を"],["持つ","もつ"],["人","ひと"],["に"],["なり"],["なさい"],["。"]]},{"verse":16,"text":"キリストのことばを、あなたがたのうちに豊かに住まわせ、知恵を尽くして互いに教え、互いに戒め、詩と賛美と霊の歌とにより、感謝にあふれて心から神に向かって歌いなさい。","tok":[["キリスト"],["の"],["ことば"],["を"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["豊か","ゆたか"],["に"],["住まわせ","すまわせ"],["、"],["知恵","ちえ"],["を"],["尽くして","つくして"],["互い","たがい"],["に"],["教え","おしえ"],["、"],["互い","たがい"],["に"],["戒め","いましめ"],["、"],["詩","し"],["と"],["賛美","さんび"],["と"],["霊","れい"],["の"],["歌","うた"],["と"],["に"],["より"],["、"],["感謝","かんしゃ"],["に"],["あふれて"],["心","こころ"],["から"],["神","かみ"],["に"],["向かって","むかって"],["歌い","うたい"],["なさい"],["。"]]},{"verse":17,"text":"あなたがたのすることは、ことばによると行いによるとを問わず、すべて主イエスの名によってなし、主によって父なる神に感謝しなさい。","tok":[["あなた"],["がた"],["の"],["する"],["こと"],["は"],["、"],["ことば"],["に"],["よる"],["と"],["行い","おこない"],["に"],["よる"],["と"],["を"],["問わず","とわず"],["、"],["すべて"],["主","ぬし"],["イエス"],["の"],["名","な"],["によって"],["なし"],["、"],["主に","おもに"],["よって"],["父","ちち"],["なる"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["なさい"],["。"]]},{"verse":18,"text":"妻たちよ。主にある者にふさわしく、夫に従いなさい。","tok":[["妻たち","つまたち"],["よ"],["。"],["主に","おもに"],["ある"],["者","もの"],["に"],["ふさわしく"],["、"],["夫","おっと"],["に"],["従い","したがい"],["なさい"],["。"]]},{"verse":19,"text":"夫たちよ。妻を愛しなさい。つらく当たってはいけません。","tok":[["夫","おっと"],["たち"],["よ"],["。"],["妻","つま"],["を"],["愛し","あいし"],["なさい"],["。"],["つらく"],["当たって","あたって"],["は"],["いけません"],["。"]]},{"verse":20,"text":"子どもたちよ。すべてのことについて、両親に従いなさい。それは主に喜ばれることだからです。","tok":[["子ども","こども"],["たち"],["よ"],["。"],["すべて"],["の"],["こと"],["について"],["、"],["両親","りょうしん"],["に"],["従い","したがい"],["なさい"],["。"],["それ"],["は"],["主に","おもに"],["喜ばれる","よろこばれる"],["こと"],["だ"],["から"],["です"],["。"]]},{"verse":21,"text":"父たちよ。子どもをおこらせてはいけません。彼らを気落ちさせないためです。","tok":[["父","ちち"],["たち"],["よ"],["。"],["子ども","こども"],["を"],["おこらせて"],["は"],["いけません"],["。"],["彼","かれ"],["ら"],["を"],["気落ち","きおち"],["させない"],["ため"],["です"],["。"]]},{"verse":22,"text":"奴隷たちよ。すべてのことについて、地上の主人に従いなさい。人のごきげんとりのような、うわべだけの仕え方ではなく、主を恐れかしこみつつ、真心から従いなさい。","tok":[["奴隷","どれい"],["たち"],["よ"],["。"],["すべて"],["の"],["こと"],["について"],["、"],["地上","ちじょう"],["の"],["主人","しゅじん"],["に"],["従い","したがい"],["なさい"],["。"],["人","ひと"],["の"],["ごきげん"],["とり"],["の"],["よう"],["な"],["、"],["うわべ"],["だけ"],["の"],["仕え","つかえ"],["方","かた"],["で"],["は"],["なく"],["、"],["主","ぬし"],["を"],["恐れ","おそれ"],["かしこみ"],["つつ"],["、"],["真心","まごころ"],["から"],["従い","したがい"],["なさい"],["。"]]},{"verse":23,"text":"何をするにも、人に対してではなく、主に対してするように、心からしなさい。","tok":[["何","なん"],["を"],["する"],["に"],["も"],["、"],["人","ひと"],["に対して","にたいして"],["で"],["は"],["なく"],["、"],["主に","おもに"],["対して","たいして"],["する"],["よう"],["に"],["、"],["心","こころ"],["から"],["し"],["なさい"],["。"]]},{"verse":24,"text":"あなたがたは、主から報いとして、御国を相続させていただくことを知っています。あなたがたは主キリストに仕えているのです。","tok":[["あなた"],["がた"],["は"],["、"],["主","ぬし"],["から"],["報い","むくい"],["として"],["、"],["御国","みくに"],["を"],["相続","そうぞく"],["させて"],["いただく"],["こと"],["を"],["知って","しって"],["います"],["。"],["あなた"],["がた"],["は"],["主","しゅ"],["キリスト"],["に"],["仕えて","つかえて"],["いる"],
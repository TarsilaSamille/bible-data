[{"verse":1,"text":"あなたがたとラオデキヤの人たちと、そのほか直接私の顔を見たことのない人たちのためにも、私がどんなに苦闘しているか、知ってほしいと思います。","tok":[["あなた"],["がた"],["と"],["ラオデキヤ"],["の"],["人","ひと"],["たち"],["と"],["、"],["その"],["ほか"],["直接","ちょくせつ"],["私","わたくし"],["の"],["顔","かお"],["を"],["見た","みた"],["こと"],["の"],["ない"],["人","ひと"],["たち"],["の"],["ため"],["に"],["も"],["、"],["私","わたくし"],["が"],["どんな"],["に"],["苦闘","くとう"],["して"],["いる"],["か"],["、"],["知って","しって"],["ほしい"],["と"],["思います","おもいます"],["。"]]},{"verse":2,"text":"それは、この人たちが心に励ましを受け、愛によって結び合わされ、理解をもって豊かな全き確信に達し、神の奥義であるキリストを真に知るようになるためです。","tok":[["それ"],["は"],["、"],["この"],["人","ひと"],["たち"],["が"],["心","こころ"],["に"],["励まし","はげまし"],["を"],["受け","うけ"],["、"],["愛","あい"],["によって"],["結び合わされ","むすびあわされ"],["、"],["理解","りかい"],["を"],["もって"],["豊か","ゆたか"],["な"],["全","ぜん"],["き"],["確信","かくしん"],["に"],["達し","たっし"],["、"],["神","かみ"],["の"],["奥義","おうぎ"],["で"],["ある"],["キリスト"],["を"],["真","しん"],["に"],["知る","しる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":3,"text":"このキリストのうちに、知恵と知識との宝がすべて隠されているのです。","tok":[["この"],["キリスト"],["の"],["うち"],["に"],["、"],["知恵","ちえ"],["と"],["知識","ちしき"],["と"],["の"],["宝","たから"],["が"],["すべて"],["隠されて","かくされて"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"私がこう言うのは、だれもまことしやかな議論によって、あなたがたをあやまちに導くことのないためです。","tok":[["私","わたくし"],["が"],["こう"],["言う","いう"],["の"],["は"],["、"],["だれ"],["も"],["まことしやか"],["な"],["議論","ぎろん"],["によって"],["、"],["あなた"],["がた"],["を"],["あやまち"],["に"],["導く","みちびく"],["こと"],["の"],["ない"],["ため"],["です"],["。"]]},{"verse":5,"text":"私は、肉体においては離れていても、霊においてはあなたがたといっしょにいて、あなたがたの秩序とキリストに対する堅い信仰とを見て喜んでいます。","tok":[["私","わたくし"],["は"],["、"],["肉体","にくたい"],["に"],["おいて"],["は"],["離れて","はなれて"],["いて"],["も"],["、"],["霊","れい"],["に"],["おいて"],["は"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["いて"],["、"],["あなた"],["がた"],["の"],["秩序","ちつじょ"],["と"],["キリスト"],["に"],["対する","たいする"],["堅い","かたい"],["信仰","しんこう"],["と"],["を"],["見て","みて"],["喜んで","よろこんで"],["います"],["。"]]},{"verse":6,"text":"あなたがたは、このように主キリスト・イエスを受け入れたのですから、彼にあって歩みなさい。","tok":[["あなた"],["がた"],["は"],["、"],["この"],["よう"],["に"],["主","ぬし"],["キリスト"],["・"],["イエス"],["を"],["受け入れた","うけいれた"],["の"],["です"],["から"],["、"],["彼","かれ"],["に"],["あって"],["歩み","あゆみ"],["なさい"],["。"]]},{"verse":7,"text":"キリストの中に根ざし、また建てられ、また、教えられたとおり信仰を堅くし、あふれるばかり感謝しなさい。","tok":[["キリスト"],["の"],["中","なか"],["に"],["根ざし","ねざし"],["、"],["また"],["建てられ","たてられ"],["、"],["また"],["、"],["教えられた","おしえられた"],["とおり"],["信仰","しんこう"],["を"],["堅く","かたく"],["し"],["、"],["あふれる"],["ばかり"],["感謝","かんしゃ"],["し"],["なさい"],["。"]]},{"verse":8,"text":"あのむなしい、だましごとの哲学によってだれのとりこにもならぬよう、注意しなさい。それは人の言い伝えによるもの、この世の幼稚な教えによるものであって、キリストによるものではありません。","tok":[["あの"],["むなしい"],["、"],["だまし"],["ごと"],["の"],["哲学","てつがく"],["によって"],["だれ"],["の"],["とりこ"],["に"],["も"],["ならぬ"],["よう"],["、"],["注意","ちゅうい"],["し"],["なさい"],["。"],["それ"],["は"],["人","ひと"],["の"],["言い伝え","いいつたえ"],["に"],["よる"],["もの"],["、"],["この世","このよ"],["の"],["幼稚","ようち"],["な"],["教え","おしえ"],["に"],["よる"],["もの"],["で"],["あって"],["、"],["キリスト"],["に"],["よる"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":9,"text":"キリストのうちにこそ、神の満ち満ちたご性質が形をとって宿っています。","tok":[["キリスト"],["の"],["うち"],["に"],["こそ"],["、"],["神","かみ"],["の"],["満ち満ちた","みちみちた"],["ご性質","ごせいしつ"],["が"],["形","かたち"],["を"],["とって"],["宿って","やどって"],["います"],["。"]]},{"verse":10,"text":"そしてあなたがたは、キリストにあって、満ち満ちているのです。キリストはすべての支配と権威のかしらです。","tok":[["そして"],["あなた"],["がた"],["は"],["、"],["キリスト"],["に"],["あって"],["、"],["満ち満ちて","みちみちて"],["いる"],["の"],["です"],["。"],["キリスト"],["は"],["すべて"],["の"],["支配","しはい"],["と"],["権威","けんい"],["の"],["かしら"],["です"],["。"]]},{"verse":11,"text":"キリストにあって、あなたがたは人の手によらない割礼を受けました。肉のからだを脱ぎ捨て、キリストの割礼を受けたのです。","tok":[["キリスト"],["に"],["あって"],["、"],["あなた"],["がた"],["は"],["人","ひと"],["の"],["手","て"],["に"],["よらない"],["割礼","かつれい"],["を"],["受けました","うけました"],["。"],["肉","にく"],["の"],["からだ"],["を"],["脱ぎ捨て","ぬぎすて"],["、"],["キリスト"],["の"],["割礼","かつれい"],["を"],["受けた","うけた"],["の"],["です"],["。"]]},{"verse":12,"text":"あなたがたは、バプテスマによってキリストとともに葬られ、また、キリストを死者の中からよみがえらせた神の力を信じる信仰によって、キリストとともによみがえらされたのです。","tok":[["あなた"],["がた"],["は"],["、"],["バプテスマ"],["によって"],["キリスト"],["と"],["とも"],["に"],["葬られ","ほうむられ"],["、"],["また"],["、"],["キリスト"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせた"],["神","かみ"],["の"],["力","ちから"],["を"],["信じる","しんじる"],["信仰","しんこう"],["によって"],["、"],["キリスト"],["と"],["とも"],["に"],["よみがえらされた"],["の"],["です"],["。"]]},{"verse":13,"text":"あなたがたは罪によって、また肉の割礼がなくて死んだ者であったのに、神は、そのようなあなたがたを、キリストとともに生かしてくださいました。それは、私たちのすべての罪を赦し、","tok":[["あなた"],["がた"],["は"],["罪","つみ"],["によって"],["、"],["また"],["肉","にく"],["の"],["割礼","かつれい"],["が"],["なくて"],["死んだ","しんだ"],["者","もの"],["で"],["あった"],["のに"],["、"],["神","かみ"],["は"],["、"],["その"],["よう"],["な"],["あなた"],["がた"],["を"],["、"],["キリスト"],["と"],["とも"],["に"],["生かして","いかして"],["くださいました"],["。"],["それ"],["は"],["、"],["私たち","わたしたち"],["の"],["すべて"],["の"],["罪","つみ"],["を"],["赦し","ゆるし"],["、"]]},{"verse":14,"text":"いろいろな定めのために私たちに不利な、いや、私たちを責め立てている債務証書を無効にされたからです。神はこの証書を取りのけ、十字架に釘づけにされました。","tok":[["いろいろ"],["な"],["定め","さだめ"],["の"],["ため"],["に"],["私たち","わたしたち"],["に"],["不利","ふり"],["な"],["、"],["いや"],["、"],["私たち","わたしたち"],["を"],["責め立てて","せめたてて"],["いる"],["債務","さいむ"],["証書","しょうしょ"],["を"],["無効","むこう"],["に"],["された"],["から"],["です"],["。"],["神","かみ"],["は"],["この"],["証書","しょうしょ"],["を"],["取りのけ","とりのけ"],["、"],["十字架","じゅうじか"],["に"],["釘づけ","くぎづけ"],["に"],["されました"],["。"]]},{"verse":15,"text":"神は、キリストにおいて、すべての支配と権威の武装を解除してさらしものとし、彼らを捕虜として凱旋の行列に加えられました。","tok":[["神","かみ"],["は"],["、"],["キリスト"],["に"],["おいて"],["、"],["すべて"],["の"],["支配","しはい"],["と"],["権威","けんい"],["の"],["武装","ぶそう"],["を"],["解除","かいじょ"],["して"],["さらしもの"],["と"],["し"],["、"],["彼","かれ"],["ら"],["を"],["捕虜","ほりょ"],["として"],["凱旋","がいせん"],["の"],["行列","ぎょうれつ"],["に"],["加えられました","くわえられました"],["。"]]},{"verse":16,"text":"こういうわけですから、食べ物と飲み物について、あるいは、祭りや新月や安息日のことについて、だれにもあなたがたを批評させてはなりません。","tok":[["こう"],["いう"],["わけ"],["です"],["から"],["、"],["食べ物","たべもの"],["と"],["飲み物","のみもの"],["について"],["、"],["あるいは"],["、"],["祭り","まつり"],["や"],["新月","しんげつ"],["や"],["安息日","あんそくび"],["の"],["こと"],["について"],["、"],["だれ"],["に"],["も"],["あなた"],["がた"],["を"],["批評","ひひょう"],["させて"],["は"],["なりません"],["。"]]},{"verse":17,"text":"これらは、次に来るものの影であって、本体はキリストにあるのです。","tok":[["これ"],["ら"],["は"],["、"],["次","つぎ"],["に"],["来る","くる"],["もの"],["の"],["影","かげ"],["で"],["あって"],["、"],["本体","ほんたい"],["は"],["キリスト"],["に"],["ある"],["の"],["です"],["。"]]},{"verse":18,"text":"あなたがたは、ことさらに自己卑下をしようとしたり、御使い礼拝をしようとする者に、ほうびをだまし取られてはなりません。彼らは幻を見たことに安住して、肉の思いによっていたずらに誇り、","tok":[["あなた"],["がた"],["は"],["、"],["こと"],["さらに"],["自己","じこ"],["卑下","ひげ"],["を"],["しよう"],["と"],["し"],["たり"],["、"],["御使い","おつかい"],["礼拝","れいはい"],["を"],["しよう"],["と"],["する"],["者","もの"],["に"],["、"],["ほうび"],["を"],["だまし取られて","だましとられて"],["は"],["なりません"],["。"],["彼","かれ"],["ら"],["は"],["幻","まぼろし"],["を"],["見た","みた"],["こと"],["に"],["安住","あんじゅう"],["して"],["、"],["肉","にく"],["の"],["思い","おもい"],["によって"],["いたずら"],["に"],["誇り","ほこり"],["、"]]},{"verse":19,"text":"かしらに堅く結びつくことをしません。このかしらがもとになり、からだ全体は、関節と筋によって養われ、結び合わされて、神によって成長させられるのです。","tok":[["かしら"],["に"],["堅く","かたく"],["結びつく","むすびつく"],["こと"],["を"],["しません"],["。"],["この"],["かしら"],["が"],["もと"],["に"],["なり"],["、"],["からだ"],["全体","ぜんたい"],["は"],["、"],["関節","かんせつ"],["と"],["筋","すじ"],["によって"],["養われ","やしなわれ"],["、"],["結び合わされて","むすびあわされて"],["、"],["神","かみ"],["によって"],["成長","せいちょう"],["させられる"],["の"],["です"],["。"]]},{"verse":20,"text":"もしあなたがたが、キリストとともに死んで、この世の幼稚な教えから離れたのなら、どうして、まだこの世の生き方をしているかのように、","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["キリスト"],["と"],["とも"],["に"],["死んで","しんで"],["、"],["この世","このよ"],["の"],["幼稚","ようち"],["な"],["教え","おしえ"],["から"],["離れた","はなれた"],["の"],["なら"],["、"],["どう"],["して"],["、"],["まだ"],["この世","このよ"],["の"],["生き方","いきかた"],["を"],["して"],["いる"],["か"],["の"],["よう"],["に"],["、"]]},{"verse":21,"text":"「すがるな。味わうな。さわるな」というような定めに縛られるのですか。","tok":[["「"],["すがる"],["な"],["。"],["味わう","あじわう"],["な"],["。"],["さわる"],["な"],["」"],["と"],["いう"],["よう"],["な"],["定め","さだめ"],["に"],["縛られる","しばられる"],["の"],["です"],["か"],["。"]]},{"verse":22,"text":"そのようなものはすべて、用いれば滅びるものについてであって、人間の戒めと教えによるものです。","tok":[["その"],["よう"],["な"],["もの"],["は"],["すべて"],["、"],["用いれば","もちいれば"],["滅びる","ほろびる"],["もの"],["について"],["で"],["あって"],["、"],["人間","にんげん"],["の"],["戒め","いましめ"],["と"],["教え","おしえ"],["に"],["よる"],["もの"],["です"],["。"]]},{"verse":23,"text":"そのようなものは、人間の好き勝手な礼拝とか、謙遜とか、または、肉体の苦行などのゆえに賢いもののように見えますが、肉のほしいままな欲望に対しては、何のききめもないのです。","tok":[["その"],["よう"],["な"],["もの"],["は"],["、"],["人間","にんげん"],["の"],["好き勝手","すきかって"],["な"],["礼拝","れいはい"],["と"],["か"],["、"],["謙遜","けんそん"],["と"],["か"],["、"],["また"],["は"],["、"],["肉体","にくたい"],["の"],["苦行","くぎょう"],["など"],["の"],["ゆえ"],["に"],["賢い","かしこい"],["もの"],["の"],["よう"],["に"],["見えます","みえます"],["が"],["、"],["肉","にく"],["の"],["ほしいまま"],["な"],["欲望","よくぼう"],["に"],["対し","たいし"],["ては"],["、"],["何","なん"],["の"],["きき"],["め"],["も"],["ない"],["の"],["です"],["。"]]}]
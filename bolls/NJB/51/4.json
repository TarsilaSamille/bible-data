[{"verse":1,"text":"主人たちよ。あなたがたは、自分たちの主も天におられることを知っているのですから、奴隷に対して正義と公平を示しなさい。","tok":[["主人","しゅじん"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["主","ぬし"],["も"],["天","てん"],["に"],["おられる"],["こと"],["を"],["知って","しって"],["いる"],["の"],["です"],["から"],["、"],["奴隷","どれい"],["に対して","にたいして"],["正義","まさよし"],["と"],["公平","こうへい"],["を"],["示し","しめし"],["なさい"],["。"]]},{"verse":2,"text":"目をさまして、感謝をもって、たゆみなく祈りなさい。","tok":[["目","め"],["を"],["さまして"],["、"],["感謝","かんしゃ"],["を"],["もって"],["、"],["たゆみなく"],["祈り","いのり"],["なさい"],["。"]]},{"verse":3,"text":"同時に、私たちのためにも、神がみことばのために門を開いてくださって、私たちがキリストの奥義を語れるように、祈ってください。この奥義のために、私は牢に入れられています。","tok":[["同時","どうじ"],["に"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["も"],["、"],["神がみ","かみがみ"],["ことば"],["の"],["ため"],["に"],["門","もん"],["を"],["開いて","ひらいて"],["くださって"],["、"],["私たち","わたしたち"],["が"],["キリスト"],["の"],["奥義","おうぎ"],["を"],["語れる","かたれる"],["よう"],["に"],["、"],["祈って","いのって"],["ください"],["。"],["この"],["奥義","おうぎ"],["の"],["ため"],["に"],["、"],["私","わたくし"],["は"],["牢","ろう"],["に"],["入れられて","いれられて"],["います"],["。"]]},{"verse":4,"text":"また、私がこの奥義を、当然語るべき語り方で、はっきり語れるように、祈ってください。","tok":[["また"],["、"],["私","わたくし"],["が"],["この"],["奥義","おうぎ"],["を"],["、"],["当然","とうぜん"],["語るべき","かたるべき"],["語り","かたり"],["方","かた"],["で"],["、"],["はっきり"],["語れる","かたれる"],["よう"],["に"],["、"],["祈って","いのって"],["ください"],["。"]]},{"verse":5,"text":"外部の人に対して賢明にふるまい、機会を十分に生かして用いなさい。","tok":[["外部","がいぶ"],["の"],["人","ひと"],["に対して","にたいして"],["賢明","けんめい"],["に"],["ふるまい"],["、"],["機会","きかい"],["を"],["十分","じゅうぶん"],["に"],["生かして","いかして"],["用い","もちい"],["なさい"],["。"]]},{"verse":6,"text":"あなたがたのことばが、いつも親切で、塩味のきいたものであるようにしなさい。そうすれば、ひとりひとりに対する答え方がわかります。","tok":[["あなた"],["がた"],["の"],["ことば"],["が"],["、"],["いつも"],["親切","しんせつ"],["で"],["、"],["塩味","しおあじ"],["の"],["きいた"],["もの"],["で"],["ある"],["よう"],["に"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["ひとりひとり"],["に"],["対する","たいする"],["答え","こたえ"],["方","かた"],["が"],["わかります"],["。"]]},{"verse":7,"text":"私の様子については、主にあって愛する兄弟、忠実な奉仕者、同労のしもべであるテキコが、あなたがたに一部始終を知らせるでしょう。","tok":[["私","わたくし"],["の"],["様子","ようす"],["について"],["は"],["、"],["主に","おもに"],["あって"],["愛する","あいする"],["兄弟","きょうだい"],["、"],["忠実","ちゅうじつ"],["な"],["奉仕者","ほうししゃ"],["、"],["同労","どうろう"],["の"],["しもべ"],["で"],["ある"],["テキコ"],["が"],["、"],["あなた"],["がた"],["に"],["一部","いちぶ"],["始終","しじゅう"],["を"],["知らせるでしょう","しらせるでしょう"],["。"]]},{"verse":8,"text":"私がテキコをあなたがたのもとに送るのは、あなたがたが私たちの様子を知り、彼によって心に励ましを受けるためにほかなりません。","tok":[["私","わたくし"],["が"],["テキコ"],["を"],["あなた"],["がた"],["の"],["もと"],["に"],["送る","おくる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["私たち","わたしたち"],["の"],["様子","ようす"],["を"],["知り","しり"],["、"],["彼","かれ"],["によって"],["心","こころ"],["に"],["励まし","はげまし"],["を"],["受ける","うける"],["ため"],["に"],["ほか"],["なりません"],["。"]]},{"verse":9,"text":"また彼は、あなたがたの仲間のひとりで、忠実な愛する兄弟オネシモといっしょに行きます。このふたりが、こちらの様子をみな知らせてくれるでしょう。","tok":[["また"],["彼","かれ"],["は"],["、"],["あなた"],["がた"],["の"],["仲間","なかま"],["の"],["ひとり"],["で"],["、"],["忠実","ちゅうじつ"],["な"],["愛する","あいする"],["兄弟","きょうだい"],["オネシモ"],["と"],["いっしょ"],["に"],["行きます","いきます"],["。"],["この"],["ふたり"],["が"],["、"],["こちら"],["の"],["様子","ようす"],["を"],["みな"],["知らせて","しらせて"],["くれるでしょう"],["。"]]},{"verse":10,"text":"私といっしょに囚人となっているアリスタルコが、あなたがたによろしくと言っています。バルナバのいとこであるマルコも同じです――この人については、もし彼があなたがたのところに行ったなら、歓迎するようにという指示をあなたがたは受けています。――","tok":[["私","わたくし"],["と"],["いっしょ"],["に"],["囚人","しゅうじん"],["と"],["なって"],["いる"],["アリスタルコ"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["バルナバ"],["の"],["いとこ"],["で"],["ある"],["マルコ"],["も"],["同じ","おなじ"],["です"],["―"],["―"],["この"],["人","ひと"],["について"],["は"],["、"],["もし"],["彼","かれ"],["が"],["あなた"],["がた"],["の"],["ところ"],["に"],["行ったなら","いったなら"],["、"],["歓迎","かんげい"],["する"],["よう"],["に"],["と"],["いう"],["指示","しじ"],["を"],["あなた"],["がた"],["は"],["受けて","うけて"],["います"],["。"],["―"],["―"]]},{"verse":11,"text":"ユストと呼ばれるイエスもよろしくと言っています。割礼を受けた人では、この人たちだけが、神の国のために働く私の同労者です。また、彼らは私を激励する者となってくれました。","tok":[["ユスト"],["と"],["呼ばれる","よばれる"],["イエス"],["も"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["割礼","かつれい"],["を"],["受けた","うけた"],["人","ひと"],["で"],["は"],["、"],["この"],["人","ひと"],["たち"],["だけ"],["が"],["、"],["神","かみ"],["の"],["国","くに"],["の"],["ため"],["に"],["働く","はたらく"],["私","わたくし"],["の"],["同労者","どうろうしゃ"],["です"],["。"],["また"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["を"],["激励","げきれい"],["する"],["者","もの"],["と"],["なって"],["くれました"],["。"]]},{"verse":12,"text":"あなたがたの仲間のひとり、キリスト・イエスのしもべエパフラスが、あなたがたによろしくと言っています。彼はいつも、あなたがたが完全な人となり、また神のすべてのみこころを十分に確信して立つことができるよう、あなたがたのために祈りに励んでいます。","tok":[["あなた"],["がた"],["の"],["仲間","なかま"],["の"],["ひとり"],["、"],["キリスト"],["・"],["イエス"],["の"],["しもべ"],["エパフラス"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["彼","かれ"],["は"],["いつも"],["、"],["あなた"],["がた"],["が"],["完全","かんぜん"],["な"],["人となり","ひととなり"],["、"],["また"],["神","かみ"],["の"],["すべて"],["のみ"],["こころ"],["を"],["十分","じゅうぶん"],["に"],["確信","かくしん"],["して"],["立つ","たつ"],["こと"],["が"],["できる"],["よう"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["祈り","いのり"],["に"],["励んで","はげんで"],["います"],["。"]]},{"verse":13,"text":"私はあかしします。彼はあなたがたのために、またラオデキヤとヒエラポリスにいる人々のために、非常に苦労しています。","tok":[["私","わたくし"],["は"],["あかし"],["します"],["。"],["彼","かれ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["また"],["ラオデキヤ"],["と"],["ヒエラポリス"],["に"],["いる"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["非常","ひじょう"],["に"],["苦労","くろう"],["して"],["います"],["。"]]},{"verse":14,"text":"愛する医者ルカ、それにデマスが、あなたがたによろしくと言っています。","tok":[["愛する","あいする"],["医者","いしゃ"],["ルカ"],["、"],["それ"],["に"],["デマス"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":15,"text":"どうか、ラオデキヤの兄弟たちに、またヌンパとその家にある教会に、よろしく言ってください。","tok":[["どう"],["か"],["、"],["ラオデキヤ"],["の"],["兄弟","きょうだい"],["たち"],["に"],["、"],["また"],["ヌンパ"],["と"],["その"],["家","いえ"],["に"],["ある"],["教会","きょうかい"],["に"],["、"],["よろしく"],["言って","いって"],["ください"],["。"]]},{"verse":16,"text":"この手紙があなたがたのところで読まれたなら、ラオデキヤ人の教会でも読まれるようにしてください。あなたがたのほうも、ラオデキヤから回って来る手紙を読んでください。","tok":[["この"],["手紙","てがみ"],["が"],["あなた"],["がた"],["の"],["ところ"],["で"],["読まれたなら","よまれたなら"],["、"],["ラオデキヤ"],["人","にん"],["の"],["教会","きょうかい"],["で"],["も"],["読まれる","よまれる"],["よう"],["に"],["して"],["ください"],["。"],["あなた"],["がた"],["の"],["ほう"],["も"],["、"],["ラオデキヤ"],["から"],["回って","まわって"],["来る","くる"],["手紙","てがみ"],["を"],["読んで","よんで"],["ください"],["。"]]},{"verse":17,"text":"アルキポに、「主にあって受けた務めを、注意してよく果たすように」と言ってください。","tok":[["アルキポ"],["に"],["、"],["「"],["主に","おもに"],["あって"],["受けた","うけた"],["務め","つとめ"],["を"],["、"],["注意","ちゅうい"],["して"],["よく"],["果たす","はたす"],["よう"],["に"],["」"],["と"],["言って","いって"],["ください"],["。"]]},{"verse":18,"text":"パウロが自筆であいさつを送ります。私が牢につながれていることを覚えていてください。どうか、恵みがあなたがたとともにありますように。","tok":[["パウロ"],["が"],["自筆","じひつ"],["で"],["あいさつ"],["を"],["送ります","おくります"],["。"],["私","わたくし"],["が"],["牢","ろう"],["に"],["つながれて"],["いる"],["こと"],["を"],["覚えて","おぼえて"],["いて"],["ください"],["。"],["どう"],["か"],["、"],["恵み","めぐみ"],["が"],["あなた"],["がた"],["と"],["とも"],["に"],["あります"],["よう"],["に"],["。"]]}]
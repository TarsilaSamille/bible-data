[{"verse":1,"text":"ダビデは彼とともにいる民を調べて、彼らの上に千人隊の長、百人隊の長を任命した。","tok":[["ダビデ"],["は"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["民","たみ"],["を"],["調べて","しらべて"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["千人隊","せんにんたい"],["の"],["長","ちょう"],["、"],["百人隊","ひゃくにんたい"],["の"],["長","ちょう"],["を"],["任命","にんめい"],["した"],["。"]]},{"verse":2,"text":"ダビデは民の三分の一をヨアブの指揮のもとに、三分の一をヨアブの兄弟ツェルヤの子アビシャイの指揮のもとに、三分の一をガテ人イタイの指揮のもとに配置した。王は民に言った。「私自身もあなたがたといっしょに出たい。」","tok":[["ダビデ"],["は"],["民","みん"],["の"],["三分","さんぶん"],["の"],["一","いち"],["を"],["ヨアブ"],["の"],["指揮","しき"],["の"],["もと"],["に"],["、"],["三分","さんぶん"],["の"],["一","いち"],["を"],["ヨアブ"],["の"],["兄弟","きょうだい"],["ツェルヤ"],["の"],["子","こ"],["アビシャイ"],["の"],["指揮","しき"],["の"],["もと"],["に"],["、"],["三分","さんぶん"],["の"],["一","いち"],["を"],["ガテ"],["人","ひと"],["イタイ"],["の"],["指揮","しき"],["の"],["もと"],["に"],["配置","はいち"],["した"],["。"],["王","おう"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["私自身","わたしじしん"],["も"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["出たい","でたい"],["。"],["」"]]},{"verse":3,"text":"すると民は言った。「あなたが出てはいけません。私たちがどんなに逃げても、彼らは私たちのことは何とも思わないでしょう。たとい私たちの半分が死んでも、彼らは私たちのことは心に留めないでしょう。しかし、あなたは私たちの一万人に当たります。今、あなたは町にいて私たちを助けてくださるほうが良いのです。」","tok":[["する"],["と"],["民","たみ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["が"],["出て","でて"],["は"],["いけません"],["。"],["私たち","わたしたち"],["が"],["どんな"],["に"],["逃げて","にげて"],["も"],["、"],["彼","かれ"],["ら"],["は"],["私たち","わたしたち"],["の"],["こと"],["は"],["何","なん"],["と"],["も"],["思わないでしょう","おもわないでしょう"],["。"],["たとい"],["私たち","わたしたち"],["の"],["半分","はんぶん"],["が"],["死んで","しんで"],["も"],["、"],["彼","かれ"],["ら"],["は"],["私たち","わたしたち"],["の"],["こと"],["は"],["心","こころ"],["に"],["留めないでしょう","とめないでしょう"],["。"],["しかし"],["、"],["あなた"],["は"],["私たち","わたしたち"],["の"],["一万人","いちまんにん"],["に"],["当たります","あたります"],["。"],["今","いま"],["、"],["あなた"],["は"],["町","まち"],["に"],["いて"],["私たち","わたしたち"],["を"],["助けて","たすけて"],["くださる"],["ほう"],["が"],["良い","よい"],["の"],["です"],["。"],["」"]]},{"verse":4,"text":"王は彼らに言った。「あなたがたが良いと思うことを、私はしよう。」王は門のそばに立ち、すべての民は、百人、千人ごとに出て行った。","tok":[["王","おう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["が"],["良い","よい"],["と"],["思う","おもう"],["こと"],["を"],["、"],["私","わたくし"],["は"],["しよう"],["。"],["」"],["王","おう"],["は"],["門","もん"],["の"],["そば"],["に"],["立ち","たち"],["、"],["すべて"],["の"],["民","たみ"],["は"],["、"],["百人","ひゃくにん"],["、"],["千人","せんにん"],["ごと"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":5,"text":"王はヨアブ、アビシャイ、イタイに命じて言った。「私に免じて、若者アブシャロムをゆるやかに扱ってくれ。」民はみな、王が隊長たち全部にアブシャロムのことについて命じているのを聞いていた。","tok":[["王","おう"],["は"],["ヨアブ"],["、"],["アビシャイ"],["、"],["イタイ"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["免じて","めんじて"],["、"],["若者","わかもの"],["アブシャロム"],["を"],["ゆるやか"],["に"],["扱って","あつかって"],["くれ"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["王","おう"],["が"],["隊長","たいちょう"],["たち"],["全部","ぜんぶ"],["に"],["アブシャロム"],["の"],["こと"],["について"],["命じて","めいじて"],["いる"],["の"],["を"],["聞いて","きいて"],["いた"],["。"]]},{"verse":6,"text":"こうして、民はイスラエルを迎え撃つために戦場へ出て行った。戦いはエフライムの森で行われた。","tok":[["こう"],["して"],["、"],["民","みん"],["は"],["イスラエル"],["を"],["迎え撃つ","むかえうつ"],["ため"],["に"],["戦場","せんじょう"],["へ"],["出て","でて"],["行った","いった"],["。"],["戦い","たたかい"],["は"],["エフライム"],["の"],["森","もり"],["で"],["行われた","おこなわれた"],["。"]]},{"verse":7,"text":"イスラエルの民はそこでダビデの家来たちに打ち負かされ、その日、その場所で多くの打たれた者が出、二万人が倒れた。","tok":[["イスラエル"],["の"],["民","たみ"],["は"],["そこ"],["で"],["ダビデ"],["の"],["家来","けらい"],["たち"],["に"],["打ち負かされ","うちまかされ"],["、"],["その"],["日","ひ"],["、"],["その"],["場所","ばしょ"],["で"],["多く","おおく"],["の"],["打たれた","うたれた"],["者","もの"],["が"],["出","で"],["、"],["二万人","にまんにん"],["が"],["倒れた","たおれた"],["。"]]},{"verse":8,"text":"戦いはこの地一帯に散り広がり、この日、剣で倒された者よりも、密林で行き倒れになった者のほうが多かった。","tok":[["戦い","たたかい"],["は"],["この"],["地","ち"],["一帯","いったい"],["に"],["散り広がり","ちりひろがり"],["、"],["この"],["日","ひ"],["、"],["剣","けん"],["で"],["倒された","たおされた"],["者","もの"],["より"],["も"],["、"],["密林","みつりん"],["で"],["行き倒れ","いきだおれ"],["に"],["なった"],["者","もの"],["の"],["ほう"],["が"],["多かった","おおかった"],["。"]]},{"verse":9,"text":"アブシャロムはダビデの家来たちに出会った。アブシャロムは騾馬に乗っていたが、騾馬が大きな樫の木の茂った枝の下を通ったとき、アブシャロムの頭が樫の木に引っ掛かり、彼は宙づりになった。彼が乗っていた騾馬はそのまま行った。","tok":[["アブシャロム"],["は"],["ダビデ"],["の"],["家来","けらい"],["たち"],["に"],["出会った","であった"],["。"],["アブシャロム"],["は"],["騾馬","らば"],["に"],["乗って","のって"],["いた"],["が"],["、"],["騾馬","らば"],["が"],["大きな","おおきな"],["樫","かし"],["の"],["木","き"],["の"],["茂った","しげった"],["枝","えだ"],["の"],["下","した"],["を"],["通った","とおった"],["とき"],["、"],["アブシャロム"],["の"],["頭","あたま"],["が"],["樫","かし"],["の"],["木","き"],["に"],["引っ掛かり","ひっかかり"],["、"],["彼","かれ"],["は"],["宙づり","ちゅうづり"],["に"],["なった"],["。"],["彼","かれ"],["が"],["乗って","のって"],["いた"],["騾馬","らば"],["は"],["そのまま"],["行った","いった"],["。"]]},{"verse":10,"text":"ひとりの男がそれを見て、ヨアブに告げて言った。「今、アブシャロムが樫の木に引っ掛かっているのを見て来ました。」","tok":[["ひとり"],["の"],["男","おとこ"],["が"],["それ"],["を"],["見て","みて"],["、"],["ヨアブ"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["今","いま"],["、"],["アブシャロム"],["が"],["樫","かし"],["の"],["木","き"],["に"],["引っ掛かって","ひっかかって"],["いる"],["の"],["を"],["見て","みて"],["来ました","きました"],["。"],["」"]]},{"verse":11,"text":"ヨアブはこれを告げた者に言った。「いったい、おまえはそれを見ていて、なぜその場で地に打ち落とさなかったのか。私がおまえに銀十枚と帯一本を与えたのに。」","tok":[["ヨアブ"],["は"],["これ"],["を"],["告げた","つげた"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["いったい"],["、"],["おまえ"],["は"],["それ"],["を"],["見て","みて"],["いて"],["、"],["なぜ"],["その"],["場","ば"],["で"],["地","ち"],["に"],["打ち落とさなかった","うちおとさなかった"],["の"],["か"],["。"],["私","わたくし"],["が"],["おまえ"],["に"],["銀","ぎん"],["十枚","じゅうまい"],["と"],["帯","おび"],["一本","いちぽん"],["を"],["与えた","あたえた"],["のに"],["。"],["」"]]},{"verse":12,"text":"その男はヨアブに言った。「たとい、私の手に銀千枚をいただいても、王のお子さまに手は下せません。王は私たちの聞いているところで、あなたとアビシャイとイタイとに、『若者アブシャロムに手を出すな』と言って、お命じになっているからです。","tok":[["その"],["男","おとこ"],["は"],["ヨアブ"],["に"],["言った","いった"],["。"],["「"],["たとい"],["、"],["私","わたくし"],["の"],["手","て"],["に"],["銀","ぎん"],["千枚","せんまい"],["を"],["いただいて"],["も"],["、"],["王","おう"],["の"],["お子さま","おこさま"],["に"],["手","て"],["は"],["下せません","くだせません"],["。"],["王","おう"],["は"],["私たち","わたしたち"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["、"],["あなた"],["と"],["アビシャイ"],["と"],["イタイ"],["と"],["に"],["、"],["『"],["若者","わかもの"],["アブシャロム"],["に"],["手","て"],["を"],["出す","だす"],["な"],["』"],["と"],["言って","いって"],["、"],["お命じ","おめいじ"],["に"],["なって"],["いる"],["から"],["です"],["。"]]},{"verse":13,"text":"もし、私が自分のいのちをかけて、命令にそむいていたとしても、王には、何も隠すことはできません。そのとき、あなたは知らぬ顔をなさるでしょう。」","tok":[["もし"],["、"],["私","わたくし"],["が"],["自分","じぶん"],["の"],["いのち"],["を"],["かけて"],["、"],["命令","めいれい"],["に"],["そむいて"],["いた"],["として"],["も"],["、"],["王","おう"],["に"],["は"],["、"],["何","なん"],["も"],["隠す","かくす"],["こと"],["は"],["できません"],["。"],["その"],["とき"],["、"],["あなた"],["は"],["知らぬ","しらぬ"],["顔","かお"],["を"],["なさるでしょう"],["。"],["」"]]},{"verse":14,"text":"ヨアブは、「こうしておまえとぐずぐずしてはおられない」と言って、手に三本の槍を取り、まだ樫の木の真ん中に引っ掛かったまま生きていたアブシャロムの心臓を突き通した。","tok":[["ヨアブ"],["は"],["、"],["「"],["こう"],["して"],["おまえ"],["と"],["ぐずぐず"],["して"],["は"],["おられない"],["」"],["と"],["言って","いって"],["、"],["手","て"],["に"],["三本","さんぽん"],["の"],["槍","やり"],["を"],["取り","とり"],["、"],["まだ"],["樫","かし"],["の"],["木","き"],["の"],["真ん中","まんなか"],["に"],["引っ掛かった","ひっかかった"],["まま"],["生きて","いきて"],["いた"],["アブシャロム"],["の"],["心臓","しんぞう"],["を"],["突き通した","つきとおした"],["。"]]},{"verse":15,"text":"ヨアブの道具持ちの十人の若者たちも、アブシャロムを取り巻いて彼を打ち殺した。","tok":[["ヨアブ"],["の"],["道具持ち","どうぐもち"],["の"],["十人","じゅうにん"],["の"],["若者","わかもの"],["たち"],["も"],["、"],["アブシャロム"],["を"],["取り巻いて","とりまいて"],["彼","かれ"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":16,"text":"ヨアブが角笛を吹き鳴らすと、民はイスラエルを追うのをやめて帰って来た。ヨアブが民を引き止めたからである。","tok":[["ヨアブ"],["が"],["角笛","つのぶえ"],["を"],["吹き鳴らす","ふきならす"],["と"],["、"],["民","みん"],["は"],["イスラエル"],["を"],["追う","おう"],["の"],["を"],["やめて"],["帰って","かえって"],["来た","きた"],["。"],["ヨアブ"],["が"],["民","たみ"],["を"],["引き止めた","ひきとめた"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"人々はアブシャロムを取り降ろし、森の中の深い穴に投げ込み、その上に非常に大きな石くれの山を積み上げた。イスラエルはみな、おのおの自分の天幕に逃げ帰っていた。","tok":[["人々","ひとびと"],["は"],["アブシャロム"],["を"],["取り降ろし","とりおろし"],["、"],["森","もり"],["の"],["中","なか"],["の"],["深い","ふかい"],["穴","あな"],["に"],["投げ込み","なげこみ"],["、"],["その"],["上","うえ"],["に"],["非常","ひじょう"],["に"],["大きな","おおきな"],["石くれ","いしくれ"],["の"],["山","やま"],["を"],["積み上げた","つみあげた"],["。"],["イスラエル"],["は"],["みな"],["、"],["おのおの"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["逃げ帰って","にげかえって"],["いた"],["。"]]},{"verse":18,"text":"アブシャロムは存命中、王の谷に自分のために一本の柱を立てていた。「私の名を覚えてくれる
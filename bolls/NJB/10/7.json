,["国々","くにぐに"],["と"],["その"],["神々","かみがみ"],["から"],["贖って","あがなって"],["くださいました"],["。"]]},{"verse":24,"text":"こうして、あなたの民イスラエルをとこしえまでもあなたの民として立てられました。主よ。あなたは彼らの神となられました。","tok":[["こう"],["して"],["、"],["あなた"],["の"],["民","みん"],["イスラエル"],["を"],["とこしえ"],["まで"],["も"],["あなた"],["の"],["民","たみ"],["として"],["立てられました","たてられました"],["。"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なられました"],["。"]]},{"verse":25,"text":"どうか、神、主よ。あなたが、このしもべとその家について約束されたことを、とこしえまでも守り、あなたの約束どおりに行ってください。","tok":[["どう"],["か"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["が"],["、"],["この"],["しもべ"],["と"],["その"],["家","いえ"],["について"],["約束","やくそく"],["された"],["こと"],["を"],["、"],["とこしえ"],["まで"],["も"],["守り","まもり"],["、"],["あなた"],["の"],["約束","やくそく"],["どおり"],["に"],["行って","いって"],["ください"],["。"]]},{"verse":26,"text":"あなたの御名がとこしえまでもあがめられ、『万軍の主はイスラエルの神』と言われますように。あなたのしもべダビデの家が御前に堅く立つことができますように。","tok":[["あなた"],["の"],["御名","ぎょめい"],["が"],["とこしえ"],["まで"],["も"],["あがめられ"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["イスラエル"],["の"],["神","かみ"],["』"],["と"],["言われます","いわれます"],["よう"],["に"],["。"],["あなた"],["の"],["しもべ"],["ダビデ"],["の"],["家","いえ"],["が"],["御前","ごぜん"],["に"],["堅く","かたく"],["立つ","たつ"],["こと"],["が"],["できます"],["よう"],["に"],["。"]]},{"verse":27,"text":"イスラエルの神、万軍の主よ。あなたは、このしもべの耳にはっきり、『わたしが、あなたのために家を建てる』と言われました。それゆえ、このしもべは、この祈りをあなたに祈る勇気を得たのです。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["、"],["この"],["しもべ"],["の"],["耳","みみ"],["に"],["はっきり"],["、"],["『"],["わたし"],["が"],["、"],["あなた"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てる","たてる"],["』"],["と"],["言われました","いわれました"],["。"],["それ"],["ゆえ"],["、"],["この"],["しもべ"],["は"],["、"],["この"],["祈り","いのり"],["を"],["あなた"],["に"],["祈る","いのる"],["勇気","ゆうき"],["を"],["得た","えた"],["の"],["です"],["。"]]},{"verse":28,"text":"今、神、主よ。あなたこそ神であられます。あなたのおことばはまことです。あなたは、このしもべに、この良いことを約束してくださいました。","tok":[["今","いま"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["こそ"],["神","かみ"],["で"],["あられます"],["。"],["あなた"],["の"],["おこと
[{"verse":1,"text":"王が自分の家に住み、主が周囲のすべての敵から守って、彼に安息を与えられたとき、","tok":[["王","おう"],["が"],["自分","じぶん"],["の"],["家","いえ"],["に"],["住み","すみ"],["、"],["主","ぬし"],["が"],["周囲","しゅうい"],["の"],["すべて"],["の"],["敵","てき"],["から"],["守って","まもって"],["、"],["彼","かれ"],["に"],["安息","あんそく"],["を"],["与えられた","あたえられた"],["とき"],["、"]]},{"verse":2,"text":"王は預言者ナタンに言った。「ご覧ください。この私が杉材の家に住んでいるのに、神の箱は天幕の中にとどまっています。」","tok":[["王","おう"],["は"],["預言者","よげんしゃ"],["ナタン"],["に"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["ください"],["。"],["この"],["私","わたくし"],["が"],["杉材","すぎざい"],["の"],["家","いえ"],["に"],["住んで","すんで"],["いる"],["のに"],["、"],["神","かみ"],["の"],["箱","ばこ"],["は"],["天幕","てんまく"],["の"],["中","なか"],["に"],["とどまって"],["います"],["。"],["」"]]},{"verse":3,"text":"すると、ナタンは王に言った。「さあ、あなたの心にあることをみな行いなさい。主があなたとともにおられるのですから。」","tok":[["する"],["と"],["、"],["ナタン"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["あなた"],["の"],["心","こころ"],["に"],["ある"],["こと"],["を"],["みな"],["行い","おこない"],["なさい"],["。"],["主","ぬし"],["が"],["あなた"],["と"],["とも"],["に"],["おられる"],["の"],["です"],["から"],["。"],["」"]]},{"verse":4,"text":"その夜のことである。次のような主のことばがナタンにあった。","tok":[["その"],["夜","よる"],["の"],["こと"],["で"],["ある"],["。"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["ナタン"],["に"],["あった"],["。"]]},{"verse":5,"text":"「行って、わたしのしもべダビデに言え。／主はこう仰せられる。あなたはわたしのために、わたしの住む家を建てようとしているのか。","tok":[["「"],["行って","いって"],["、"],["わたし"],["の"],["しもべ"],["ダビデ"],["に"],["言え","いえ"],["。"],["／"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["は"],["わたし"],["の"],["ため"],["に"],["、"],["わたし"],["の"],["住む","すむ"],["家","いえ"],["を"],["建てよう","たてよう"],["として"],["いる"],["の"],["か"],["。"]]},{"verse":6,"text":"わたしは、エジプトからイスラエル人を導き上った日以来、今日まで、家に住んだことはなく、天幕、すなわち幕屋にいて、歩んできた。","tok":[["わたし"],["は"],["、"],["エジプト"],["から"],["イスラエル"],["人","にん"],["を"],["導き","みちびき"],["上った","のぼった"],["日","ひ"],["以来","いらい"],["、"],["今日","きょう"],["まで"],["、"],["家","いえ"],["に"],["住んだ","すんだ"],["こと"],["は"],["なく"],["、"],["天幕","てんまく"],["、"],["すなわち"],["幕屋","まくや"],["に"],["いて"],["、"],["歩んで","あゆんで"],["きた"],["。"]]},{"verse":7,"text"
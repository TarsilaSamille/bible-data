["は"],["ない"],["。"],["不正","ふせい"],["な"],["者","もの"],["たち"],["も"],["、"],["初め","はじめ"],["の"],["ころ"],["の"],["よう"],["に"],["重ねて","かさねて"],["民","みん"],["を"],["苦しめる","くるしめる"],["こと"],["は"],["ない"],["。"]]},{"verse":11,"text":"それは、わたしが、わたしの民イスラエルの上にさばきつかさを任命したころのことである。わたしはあなたをすべての敵から守って、安息を与える。さらに主はあなたに告げる。『主はあなたのために一つの家を造る。』","tok":[["それ"],["は"],["、"],["わたし"],["が"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["上","うえ"],["に"],["さばき"],["つかさ"],["を"],["任命","にんめい"],["した"],["ころ"],["の"],["こと"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["を"],["すべて"],["の"],["敵","てき"],["から"],["守って","まもって"],["、"],["安息","あんそく"],["を"],["与える","あたえる"],["。"],["さらに"],["主","ぬし"],["は"],["あなた"],["に"],["告げる","つげる"],["。"],["『"],["主","ぬし"],["は"],["あなた"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["家","いえ"],["を"],["造る","つくる"],["。"],["』"]]},{"verse":12,"text":"あなたの日数が満ち、あなたがあなたの先祖たちとともに眠るとき、わたしは、あなたの身から出る世継ぎの子を、あなたのあとに起こし、彼の王国を確立させる。","tok":[["あなた"],["の"],["日数","にっすう"],["が"],["満ち","みち"],["、"],["あなた"],["が"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["と"],["とも"],["に"],["眠る","ねむる"],["とき"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["身","み"],["から"],["出る","でる"],["世継ぎ","よつぎ"],["の"],["子","こ"],["を"],["、"],["あなた"],["の"],["あと"],["に"],["起こし","おこし"],["、"],["彼","かれ"],["の"],["王国","おうこく"],["を"],["確立","かくりつ"],["させる"],["。"]]},{"verse":13,"text":"彼はわたしの名のために一つの家を建て、わたしはその王国の王座をとこしえまでも堅く立てる。","tok":[["彼","かれ"],["は"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["家","いえ"],["を"],["建て","たて"],["、"],["わたし"],["は"],["その"],["王国","おうこく"],["の"],["王座","おうざ"],["を"],["とこしえ"],["まで"],["も"],["堅く","かたく"],["立てる","たてる"],["。"]]},{"verse":14,"text":"わたしは彼にとって父となり、彼はわたしにとって子となる。もし彼が罪を犯すときは、わたしは人の杖、人の子のむちをもって彼を懲らしめる。","tok":[["わたし"],["は"],["彼","かれ"],["にとって"],["父","ちち"],["と"],["なり"],["、"],["彼","かれ"],["は"],["わたし"],["にとって"],["子","こ"],["と"],["なる"],["。"],["もし"],["彼","かれ"],["が"],["罪","つみ"],["を"],["犯す","おかす"],["とき"],["は"],["、"],["わたし"],["は"],["人","ひと"],["の"],["杖","つえ"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["むち"],["を"],["もって"],["彼","かれ"],["を"],["懲らしめる","こらしめる"],["。"]]},{"verse":15,"text":"しかし、わたしは、あなたの前からサウルを取り除いて、わたしの恵みをサウルから取り去ったが、わたしの恵みをそのように、彼から取り去ることはない。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["前","まえ"],["から"],["サウル"],["を"],["取り除いて","とりのぞいて"],["、"],["わたし"],["の"],["恵み","めぐみ"],["を"],["サウル"],["から"],["取り去った","とりさった"],["が"],["、"],["わたし"],["の"],["恵み","めぐみ"],["を"],["その"],["よう"],["に"],["、"],["彼","かれ"],["から"],["取り去る","とりさる"],["こと"],["は"],["ない"],["。"]]},{"verse":16,"text":"あなたの家とあなたの王国とは、わたしの前にとこしえまでも続き、あなたの王座はとこしえまでも堅く立つ。」","tok":[["あなた"],["の"],["家","いえ"],["と"],["あなた"],["の"],["王国","おうこく"],["と"],["は"],["、"],["わたし"],["の"],["前","まえ"],["に"],["とこしえ"],["まで"],["も"],["続き","つづき"],["、"],["あなた"],["の"],["王座","おうざ"],["は"],["とこしえ"],["まで"],["も"],["堅く","かたく"],["立つ","たつ"],["。"],["」"]]},{"verse":17,"text":"ナタンはこれらすべてのことばと、これらすべての幻とを、そのままダビデに告げた。","tok":[["ナタン"],["は"],["これ"],["ら"],["すべて"],["の"],["ことば"],["と"],["、"],["これ"],["ら"],["すべて"],["の"],["幻","まぼろし"],["と"],["を"],["、"],["そのまま"],["ダビデ"],["に"],["告げた","つげた"],["。"]]},{"verse":18,"text":"ダビデ王は行って主の前に座し、そして言った。「神、主よ。私がいったい何者であり、私の家が何であるからというので、あなたはここまで私を導いてくださったのですか。","tok":[["ダビデ"],["王","おう"],["は"],["行って","いって"],["主","ぬし"],["の"],["前","まえ"],["に"],["座し","ざし"],["、"],["そして"],["言った","いった"],["。"],["「"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["が"],["いったい"],["何者","なにもの"],["で"],["あり"],["、"],["私","わたくし"],["の"],["家","いえ"],["が"],["何","なん"],["で"],["ある"],["から"],["と"],["いう"],["ので"],["、"],["あなた"],["は"],["ここ"],["まで"],["私","わたくし"],["を"],["導いて","みちびいて"],["くださった"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"神、主よ。この私はあなたの御目には取るに足りない者でしたのに、あなたは、このしもべの家にも、はるか先のことまで告げてくださいました。神、主よ。これが人の定めでしょうか。","tok":[["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["この"],["私","わたくし"],["は"],["あなた"],["の"],["御目","おめ"],["に"],["は"],["取る","とる"],["に"],["足りない","たりない"],["者","もの"],["でした"],["のに"],["、"],["あなた"],["は"],["、"],["この"],["しもべ"],["の"],["家","いえ"],["に"],["も"],["、"],["はるか"],["先","さき"],["の"],["こと"],["まで"],["告げて","つげて"],["くださいました"],["。"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["これ"],["が"],["人","ひと"],["の"],["定め","さだ
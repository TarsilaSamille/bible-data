[{"verse":1,"text":"サウルの子イシュ・ボシェテは、アブネルがヘブロンで死んだことを聞いて、気力を失った。イスラエル人もみな、うろたえた。","tok":[["サウル"],["の"],["子","こ"],["イシュ"],["・"],["ボシェテ"],["は"],["、"],["アブネル"],["が"],["ヘブロン"],["で"],["死んだ","しんだ"],["こと"],["を"],["聞いて","きいて"],["、"],["気力","きりょく"],["を"],["失った","うしなった"],["。"],["イスラエル"],["人","にん"],["も"],["みな"],["、"],["うろたえた"],["。"]]},{"verse":2,"text":"サウルの子イシュ・ボシェテのもとに、ふたりの略奪隊の隊長がいた。ひとりの名はバアナ、もうひとりの名はレカブといって、ふたりともベニヤミン族のベエロテ人リモンの子であった。というのは、ベエロテもベニヤミンに属するとみなされていたからである。","tok":[["サウル"],["の"],["子","こ"],["イシュ"],["・"],["ボシェテ"],["の"],["もと"],["に"],["、"],["ふたり"],["の"],["略奪隊","りゃくだつたい"],["の"],["隊長","たいちょう"],["が"],["いた"],["。"],["ひとり"],["の"],["名","な"],["は"],["バアナ"],["、"],["もう"],["ひとり"],["の"],["名","な"],["は"],["レカブ"],["と"],["いって"],["、"],["ふたり"],["とも"],["ベニヤミン"],["族","ぞく"],["の"],["ベエロテ"],["人","にん"],["リモン"],["の"],["子","こ"],["で"],["あった"],["。"],["と"],["いう"],["の"],["は"],["、"],["ベエロテ"],["も"],["ベニヤミン"],["に"],["属する","ぞくする"],["と"],["みなされて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"ベエロテ人はギタイムに逃げて、寄留者となった。今日もそうである。","tok":[["ベエロテ"],["人","にん"],["は"],["ギタイム"],["に"],["逃げて","にげて"],["、"],["寄留者","きりゅうしゃ"],["と"],["なった"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":4,"text":"さて、サウルの子ヨナタンに、足の不自由な子がひとりいた。その子は、サウルとヨナタンの悲報がイズレエルからもたらされたとき五歳であった。うばがこの子を抱いて逃げるとき、あまり急いで逃げたので、この子を落とし、そのために足のなえた者になった。この子の名はメフィボシェテといった。","tok":[["さて"],["、"],["サウル"],["の"],["子","こ"],["ヨナタン"],["に"],["、"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["子","こ"],["が"],["ひとり"],["いた"],["。"],["その"],["子","こ"],["は"],["、"],["サウル"],["と"],["ヨナタン"],["の"],["悲報","ひほう"],["が"],["イズレエル"],["から"],["もたらされた"],["とき"],["五歳","ごさい"],["で"],["あった"],["。"],["うば"],["が"],["この"],["子","こ"],["を"],["抱いて","いだいて"],["逃げる","にげる"],["とき"],["、"],["あまり"],["急いで","いそいで"],["逃げた","にげた"],["ので"],["、"],["この"],["子","こ"],["を"],["落とし","おとし"],["、"],["その"],["ため"],["に"],["足","あし"],["の"],["なえた"],["者","もの"],["に"],["なった"],["。"],["この"],["子","こ"],["の"],["名","な"],["は"],["メフィボシェテ"],["と"],["いった"],["。"]]},{"verse":5,"text":"ベエロテ人リモンの子のレカブとバアナが、日盛りに、イシュ・ボシェテの家にやって来たが、ちょうどその時、イシュ・ボシェテは昼寝をしていた。","tok":[["ベエロテ"],["人","にん"],["リモン"],["の"],["子","こ"],["の"],["レカブ"],["と"],["バアナ"],["が"],["、"],["日盛り","ひざかり"],["に"],["、"],["イシュ"],["・"],["ボシェテ"],["の"],["家","いえ"],["に"],["やって"],["来た","きた"],["が"],["、"],["ちょうど"],["その"],["時","とき"],["、"],["イシュ"],["・"],["ボシェテ"],["は"],["昼寝","ひるね"],["を"],["して"],["いた"],["。"]]},{"verse":6,"text":"彼らは、小麦を取りに家の中まで入り込み、そこで、彼の下腹を突いて殺した。レカブとその兄弟バアナはのがれた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["小麦","こむぎ"],["を"],["取り","とり"],["に"],["家","いえ"],["の"],["中","なか"],["まで"],["入り込み","はいりこみ"],["、"],["そこ"],["で"],["、"],["彼","かれ"],["の"],["下腹","したはら"],["を"],["突いて","ついて"],["殺した","ころした"],["。"],["レカブ"],["と"],["その"],["兄弟","きょうだい"],["バアナ"],["は"],["のがれた"],["。"]]},{"verse":7,"text":"彼らが家に入ったとき、イシュ・ボシェテは寝室の寝床で寝ていたので、彼らは彼を突き殺して首をはね、その首を持って、一晩中、アラバへの道を歩いた。","tok":[["彼","かれ"],["ら"],["が"],["家","いえ"],["に"],["入った","はいった"],["とき"],["、"],["イシュ"],["・"],["ボシェテ"],["は"],["寝室","しんしつ"],["の"],["寝床","ねどこ"],["で"],["寝て","ねて"],["いた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["を"],["突き殺して","つきころして"],["首","くび"],["を"],["はね"],["、"],["その"],["首","くび"],["を"],["持って","もって"],["、"],["一","いち"],["晩中","ばんちゅう"],["、"],["アラバ"],["へ"],["の"],["道","みち"],["を"],["歩いた","あるいた"],["。"]]},{"verse":8,"text":"彼らはイシュ・ボシェテの首をヘブロンのダビデのもとに持って来て、王に言った。「ご覧ください。これは、あなたのいのちをねらっていたあなたの敵、サウルの子イシュ・ボシェテの首です。主は、きょう、わが主、王のために、サウルとその子孫に復讐されたのです。」","tok":[["彼","かれ"],["ら"],["は"],["イシュ"],["・"],["ボシェテ"],["の"],["首","くび"],["を"],["ヘブロン"],["の"],["ダビデ"],["の"],["もと"],["に"],["持って","もって"],["来て","きて"],["、"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["ください"],["。"],["これ"],["は"],["、"],["あなた"],["の"],["いのち"],["を"],["ねらって"],["いた"],["あなた"],["の"],["敵","てき"],["、"],["サウル"],["の"],["子","こ"],["イシュ"],["・"],["ボシェテ"],["の"],["首","くび"],["です"],["。"],["主","ぬし"],["は"],["、"],["きょう"],["、"],["わが"],["主","ぬし"],["、"],["王","おう"],["の"],["ため"],["に"],["、"],["サウル"],["と"],["その"],["子孫","しそん"],["に"],["復讐","ふくしゅう"],["された"],["の"],["です"],["。"],["」"]]},{"verse":9,"text":"すると、ダビデは、ベエロテ人リモンの子レカブとその兄弟バアナに答えて言った。「私のいのちをあらゆる苦難から救い出してくださった主は生きておられる。","tok":[["する"],["と"],["、"],["ダビデ"],["は"],["、"],["ベエロテ"],["人","にん"],["リモン"],["の"],["子","こ"],["レカブ"],["と"],["その"],["兄弟","きょうだい"],["バアナ"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["いのち"],["を"],["あらゆる"],["苦難","くなん"],["から"],["救い出して","すくいだして"],["くださった"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"]]},{"verse":10,"text":"かつて私に、『ご覧ください。サウルは死にました』と告げて、自分自身では、良い知らせをもたらしたつもりでいた者を、私は捕らえて、ツィケラグで殺した。それが、その良い知らせの報いであった。","tok":[["かつて"],["私","わたくし"],["に"],["、"],["『"],["ご覧","ごらん"],["ください"],["。"],["サウル"],["は"],["死にました","しにました"],["』"],["と"],["告げて","つげて"],["、"],["自分","じぶん"],["自身","じしん"],["で"],["は"],["、"],["良い","よい"],["知らせ","しらせ"],["を"],["もたらした"],["つもり"],["で"],["いた"],["者","もの"],["を"],["、"],["私","わたくし"],["は"],["捕らえて","とらえて"],["、"],["ツィケラグ"],["で"],["殺した","ころした"],["。"],["それ"],["が"],["、"],["その"],["良い","よい"],["知らせ","しらせ"],["の"],["報い","むくい"],["で"],["あった"],["。"]]},{"verse":11,"text":"まして、この悪者どもが、ひとりの正しい人を、その家の中の、しかも寝床の上で殺したときはなおのこと、今、私は彼の血の責任をおまえたちに問い、この地からおまえたちを除き去らないでおられようか。」","tok":[["まして"],["、"],["この"],["悪者","わるもの"],["ども"],["が"],["、"],["ひとり"],["の"],["正しい","ただしい"],["人","ひと"],["を"],["、"],["その"],["家","いえ"],["の"],["中","なか"],["の"],["、"],["しかも"],["寝床","ねどこ"],["の"],["上","うえ"],["で"],["殺した","ころした"],["とき"],["は"],["なお"],["の"],["こと"],["、"],["今","いま"],["、"],["私","わたくし"],["は"],["彼","かれ"],["の"],["血","ち"],["の"],["責任","せきにん"],["を"],["おまえ"],["たち"],["に"],["問い","とい"],["、"],["この"],["地","ち"],["から"],["おまえ"],["たち"],["を"],["除き去らないで","のぞきさらないで"],["おられよう"],["か"],["。"],["」"]]},{"verse":12,"text":"ダビデが命じたので、若者たちは彼らを殺し、手、足を切り離した。そして、ヘブロンの池のほとりで木につるした。しかし、イシュ・ボシェテの首は、ヘブロンにあるアブネルの墓に持って行き、そこに葬った。","tok":[["ダビデ"],["が"],["命じた","めいじた"],["ので"],["、"],["若者","わかもの"],["たち"],["は"],["彼","かれ"],["ら"],["を"],["殺し","ころし"],["、"],["手","て"],["、"],["足","あし"],["を"],["切り離した","きりはなした"],["。"],["そして"],["、"],["ヘブロン"],["の"],["池","いけ"],["の"],["ほとり"],["で"],["木","き"],["に"],["つるした"],["。"],["しかし"],["、"],["イシュ"],["・"],["ボシェテ"],["の"],["首","くび"],["は"],["、"],["ヘブロン"],["に"],["ある"],["アブネル"],["の"],["墓","はか"],["に"],["持って","もって"],["行き","いき"],["、"],["そこ"],["に"],["葬った","ほうむった"],["。"]]}]
[{"verse":1,"text":"ダビデの時代に、三年間引き続いてききんがあった。そこでダビデが主のみこころを伺うと、主は仰せられた。「サウルとその一族に、血を流した罪がある。彼がギブオン人たちを殺したからだ。」","tok":[["ダビデ"],["の"],["時代","じだい"],["に"],["、"],["三","さん"],["年間","ねんかん"],["引き続いて","ひきつづいて"],["ききん"],["が"],["あった"],["。"],["そこ"],["で"],["ダビデ"],["が"],["主","ぬし"],["のみ"],["こころ"],["を"],["伺う","うかがう"],["と"],["、"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["サウル"],["と"],["その"],["一族","いちぞく"],["に"],["、"],["血","ち"],["を"],["流した","ながした"],["罪","つみ"],["が"],["ある"],["。"],["彼","かれ"],["が"],["ギブオン"],["人","にん"],["たち"],["を"],["殺した","ころした"],["から"],["だ"],["。"],["」"]]},{"verse":2,"text":"そこで王はギブオン人たちを呼び出して、彼らに言った。――ギブオンの人たちはイスラエル人ではなく、エモリ人の生き残りであって、イスラエル人は、彼らと盟約を結んでいたのであるが、サウルが、イスラエルとユダの人々への熱心のあまり、彼らを打ち殺してしまおうとしたのであった。――","tok":[["そこ"],["で"],["王","おう"],["は"],["ギブオン"],["人","にん"],["たち"],["を"],["呼び出して","よびだして"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["―"],["―"],["ギブオン"],["の"],["人","ひと"],["たち"],["は"],["イスラエル"],["人","にん"],["で"],["は"],["なく"],["、"],["エモリ人","えもりにん"],["の"],["生き残り","いきのこり"],["で"],["あって"],["、"],["イスラエル"],["人","にん"],["は"],["、"],["彼","かれ"],["ら"],["と"],["盟約","めいやく"],["を"],["結んで","むすんで"],["いた"],["ので"],["ある"],["が"],["、"],["サウル"],["が"],["、"],["イスラエル"],["と"],["ユダ"],["の"],["人々","ひとびと"],["へ"],["の"],["熱心","ねっしん"],["の"],["あまり"],["、"],["彼","かれ"],["ら"],["を"],["打ち殺して","うちころして"],["しまおう"],["と"],["した"],["ので"],["あった"],["。"],["―"],["―"]]},{"verse":3,"text":"ダビデはギブオン人たちに言った。「あなたがたのために、私は何をしなければならないのか。私が何を償ったら、あなたがたは主のゆずりの地を祝福できるのか。」","tok":[["ダビデ"],["は"],["ギブオン"],["人","にん"],["たち"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["私","わたくし"],["は"],["何","なん"],["を"],["しなければ"],["ならない"],["の"],["か"],["。"],["私","わたくし"],["が"],["何","なん"],["を"],["償ったら","つぐなったら"],["、"],["あなた"],["がた"],["は"],["主","ぬし"],["の"],["ゆずり"],["の"],["地","ち"],["を"],["祝福","しゅくふく"],["できる"],["の"],["か"],["。"],["」"]]},{"verse":4,"text":"ギブオン人たちは彼に言った。「私たちとサウル、およびその一族との間の問題は、銀や金のことではありません。また私たちがイスラエルのうちで、人を殺すことでもありません。」そこでダビデが言った。「それでは私があなたがたに何をしたらよいと言うのか。」","tok":[["ギブオン"],["人","にん"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["と"],["サウル"],["、"],["および"],["その"],["一族","いちぞく"],["と"],["の"],["間","あいだ"],["の"],["問題","もんだい"],["は"],["、"],["銀","ぎん"],["や"],["金","きん"],["の"],["こと"],["で"],["は"],["ありません"],["。"],["また"],["私たち","わたしたち"],["が"],["イスラエル"],["の"],["うち"],["で"],["、"],["人","ひと"],["を"],["殺す","ころす"],["こと"],["で"],["も"],["ありません"],["。"],["」"],["そこ"],["で"],["ダビデ"],["が"],["言った","いった"],["。"],["「"],["それ"],["で"],["は"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["何","なん"],["を"],["したら"],["よい"],["と"],["言う","いう"],["の"],["か"],["。"],["」"]]},{"verse":5,"text":"彼らは王に言った。「私たちを絶ち滅ぼそうとした者、私たちを滅ぼしてイスラエルの領土のどこにも、おらせないようにたくらんだ者、","tok":[["彼","かれ"],["ら"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["を"],["絶ち","たち"],["滅ぼそう","ほろぼそう"],["と"],["した"],["者","もの"],["、"],["私たち","わたしたち"],["を"],["滅ぼして","ほろぼして"],["イスラエル"],["の"],["領土","りょうど"],["の"],["どこ"],["に"],["も"],["、"],["おらせない"],["よう"],["に"],["たくらんだ"],["者","もの"],["、"]]},{"verse":6,"text":"その者の子ども七人を、私たちに引き渡してください。私たちは、主の選ばれたサウルのギブアで、主のために、彼らをさらし者にします。」王は言った。「引き渡そう。」","tok":[["その"],["者","もの"],["の"],["子ども","こども"],["七人","ななにん"],["を"],["、"],["私たち","わたしたち"],["に"],["引き渡して","ひきわたして"],["ください"],["。"],["私たち","わたしたち"],["は"],["、"],["主","ぬし"],["の"],["選ばれた","えらばれた"],["サウル"],["の"],["ギブア"],["で"],["、"],["主","ぬし"],["の"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["さらし者","さらしもの"],["に"],["します"],["。"],["」"],["王","おう"],["は"],["言った","いった"],["。"],["「"],["引き渡そう","ひきわたそう"],["。"],["」"]]},{"verse":7,"text":"しかし王は、サウルの子ヨナタンの子メフィボシェテを惜しんだ。それは、ダビデとサウルの子ヨナタンとの間で主に誓った誓いのためであった。","tok":[["しかし"],["王","おう"],["は"],["、"],["サウル"],["の"],["子","こ"],["ヨナタン"],["の"],["子","こ"],["メフィボシェテ"],["を"],["惜しんだ","おしんだ"],["。"],["それ"],["は"],["、"],["ダビデ"],["と"],["サウル"],["の"],["子","こ"],["ヨナタン"],["と"],["の"],["間","あいだ"],["で"],["主","ぬし"],["に"],["誓った","ちかった"],["誓い","ちかい"],["の"],["ため"],["で"],["あった"],["。"]]},{"verse":8,"text":"王は、アヤの娘リツパがサウルに産んだふたりの子アルモニとメフィボシェテ、それに、サウルの娘メラブがメホラ人バルジライの子アデリエルに産んだ五人の子を取って、","tok":[["王","おう"],["は"],["、"],["アヤ"],["の"],["娘","むすめ"],["リツパ"],["が"],["サウル"],["に"],["産んだ","うんだ"],["ふたり"],["の"],["子","こ"],["アルモニ"],["と"],["メフィボシェテ"],["、"],["それ"],["に"],["、"],["サウル"],["の"],["娘","むすめ"],["メラブ"],["が"],["メホラ人","めほらにん"],["バルジライ"],["の"],["子","こ"],["アデリエル"],["に"],["産んだ","うんだ"],["五人","ごにん"],["の"],["子","こ"],["を"],["取って","とって"],["、"]]},{"verse":9,"text":"彼らをギブオン人の手に渡した。それで彼らは、この者たちを山の上で主の前に、さらし者にした。これら七人はいっしょに殺された。彼らは、刈り入れ時の初め、大麦の刈り入れの始まったころ、死刑に処せられた。","tok":[["彼","かれ"],["ら"],["を"],["ギブオン"],["人","にん"],["の"],["手","て"],["に"],["渡した","わたした"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["この"],["者","もの"],["たち"],["を"],["山","やま"],["の"],["上","うえ"],["で"],["主","ぬし"],["の"],["前","まえ"],["に"],["、"],["さらし者","さらしもの"],["に"],["した"],["。"],["これ"],["ら"],["七人","ななにん"],["は"],["いっしょ"],["に"],["殺された","ころされた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["刈り入れ","かりいれ"],["時","とき"],["の"],["初め","はじめ"],["、"],["大麦","おおむぎ"],["の"],["刈り入れ","かりいれ"],["の"],["始まった","はじまった"],["ころ"],["、"],["死刑","しけい"],["に"],["処せられた","しょせられた"],["。"]]},{"verse":10,"text":"アヤの娘リツパは、荒布を脱いで、それを岩の上に敷いてすわり、刈り入れの始まりから雨が天から彼らの上に降るときまで、昼には空の鳥が、夜には野の獣が死体に近寄らないようにした。","tok":[["アヤ"],["の"],["娘","むすめ"],["リツパ"],["は"],["、"],["荒布","あらめ"],["を"],["脱いで","ぬいで"],["、"],["それ"],["を"],["岩","いわ"],["の"],["上","うえ"],["に"],["敷いて","しいて"],["すわり"],["、"],["刈り入れ","かりいれ"],["の"],["始まり","はじまり"],["から"],["雨","あめ"],["が"],["天","てん"],["から"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["降る","ふる"],["とき"],["まで"],["、"],["昼","ひる"],["に"],["は"],["空","そら"],["の"],["鳥","とり"],["が"],["、"],["夜","よる"],["に"],["は"],["野","の"],["の"],["獣","けもの"],["が"],["死体","したい"],["に"],["近寄らない","ちかよらない"],["よう"],["に"],["した"],["。"]]},{"verse":11,"text":"サウルのそばめアヤの娘リツパのしたことはダビデに知らされた。","tok":[["サウル"],["の"],["そばめ"],["アヤ"],["の"],["娘","むすめ"],["リツパ"],["の"],["した"],["こと"],["は"],["ダビデ"],["に"],["知らされた","しらされた"],["。"]]},{"verse":12,"text":"すると、ダビデは行って、サウルの骨とその子ヨナタンの骨を、ヤベシュ・ギルアデの者たちのところから取って来た。これは、ペリシテ人がサウルをギルボアで殺した日に、ペリシテ人が彼らをさらしたベテ・シャンの広場から、彼らが盗んで行ったものであった。","tok":[["する"],["と"],["、"],["ダビデ"],["は"],["行って","いって"],["、"],["サウル"],["の"],["骨","ほね"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["を"],["、"],["ヤベシュ"],["・"],["ギルアデ"],["の"],["者","もの"],["たち"],["の"],["ところ"],["から"],["取って","とって"],["来た","きた"],["。"],["これ"],["は"],["、"],["ペリシテ"],["人","にん"],["が"],["サウル"],["を"],["ギルボア"],["で"],["殺した","ころした"],["日","ひ"],["に"],["、"],["ペリシテ"],["人","にん"],["が"],["彼","かれ"],["ら"],["を"],["さらした"],["ベテ"],["・"],["シャン"],["の"],["広場","ひろば"],["から"],["、"],["彼","かれ"],["ら"],["が"],["盗んで","ぬすんで"],["行った","いった"],["もの"],["で"],["あった"],["。"]]},{"verse":13,"text":"ダビデがサウルの骨とその子ヨナタンの骨をそこから携えて上ると、人々は、さらし者にされた者たちの骨を集めた。","tok":[["ダビデ"],["が"],["サウル"],["の"],["骨","ほね"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["を"],["そこ"],["から"],["携えて","たずさえて"],["上る","のぼる"],["と"],["、"],["人々","ひとびと"],["は"],["、"],["さらし者","さらしもの"],["に"],["された"],["者","もの"],["たち"],["の"],["骨","ほね"],["を"],["集めた","あつめた"],["。"]]},{"verse":14,"text":"こうして、彼らはサウルとその子ヨナタンの骨を、ベニヤミンの地のツェラにあるサウルの父キシュの墓に葬り、すべて王が命じたとおりにした。その後、神はこの国の祈りに心を動かされた。","tok":[["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["を"],["、"],["ベニヤミン"],["の"],["地","ち"],["の"],["ツェラ"],["に"],["ある"],["サウル"],["の"],["父","ちち"],["キシュ"],["の"],["墓","はか"],["に"],["葬り","ほうむり"],["、"],["すべて"],["王","おう"],["が"],["命じた","めいじた"],["とおり"],["に"],["した"],["。"],["その"],["後","ご"],["、"],["神","かみ"],["は"],["この"],["国","くに"],["の"],["祈り","いのり"],["に"],["心","こころ"],["を"],["動かされた","うごかされた"],["。"]]},{"verse":15,"text":"ペリシテ人はまた、イスラエルに戦いをしかけた。ダビデは自分の家来たちを連れて下り、ペリシテ人と戦ったが、ダビデは疲れていた。","tok":[["ペリシテ"],["人","にん"],["は"],["また"],["、"],["イスラエル"],["に"],["戦い","たたかい"],["を"],["しかけた"],["。"],["ダビデ"],["は"],["自分","じぶん"],["の"],["家来","けらい"],["たち"],["を"],["連れて","つれて"],["下り","くだり"],["、"],["ペリシテ"],["人","にん"],["と"],["戦った","たたかった"],["が"],["、"],["ダビデ"],["は"],["疲れて","つかれて"],["いた"],["。"]]},{"verse":16,"text":"それで、ラファの子孫のひとりであったイシュビ・ベノブは、ダビデを殺そうと考えた。彼の槍の重さは青銅で三百シェケル。そして彼は新しい剣を帯びていた。","tok":[["それ"],["で"],["、"],["ラファ"],["の"],["子孫","しそん"],["の"],["ひとり"],["で"],["あった"],["イシュビ"],["・"],["ベノブ"],["は"],["、"],["ダビデ"],["を"],["殺そう","ころそう"],["と"],["考えた","かんがえた"],["。"],["彼","かれ"],["の"],["槍","やり"],["の"],["重さ","おもさ"],["は"],["青銅","せいどう"],["で"],["三百","さんひゃく"],["シェケル"],["。"],["そして"],["彼","かれ"],["は"],["新しい","あたらしい"],["剣","けん"],["を"],["帯びて","おびて"],["いた"],["。"]]},{"verse":17,"text":"しかし、ツェルヤの子アビシャイはダビデを助け、このペリシテ人を打ち殺した。そのとき、ダビデの部下たちは彼に誓って言った。「あなたは、もうこれから、われわれといっしょに、戦いに出ないでください。あなたがイスラエルのともしびを消さないために。」","tok":[["しかし"],["、"],["ツェルヤ"],["の"],["子","こ"],["アビシャイ"],["は"],["ダビデ"],["を"],["助け","たすけ"],["、"],["この"],["ペリシテ"],["人","にん"],["を"],["打ち殺した","うちころした"],["。"],["その"],["とき"],["、"],["ダビデ"],["の"],["部下","ぶか"],["たち"],["は"],["彼","かれ"],["に"],["誓って","ちかって"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["もう"],["これ"],["から"],["、"],["われわれ"],["と"],["いっしょ"],["に"],["、"],["戦い","たたかい"],["に"],["出ないで","でないで"],["ください"],["。"],["あなた"],["が"],["イスラエル"],["の"],["ともしび"],["を"],["消さない","けさない"],["ため"],["に"],["。"],["」"]]},{"verse":18,"text":"その後、ゴブでまたペリシテ人との戦いがあり、そのとき、フシャ人シベカイは、ラファの子孫のサフを打ち殺した。","tok":[["その"],["後","ご"],["、"],["ゴブ"],["で"],["また"],["ペリシテ"],["人","にん"],["と"],["の"],["戦い","たたかい"],["が"],["あり"],["、"],["その"],["とき"],["、"],["フシャ"],["人","ひと"],["シベカイ"],["は"],["、"],["ラファ"],["の"],["子孫","しそん"],["の"],["サフ"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":19,"text":"ゴブでまたペリシテ人との戦いがあったとき、ベツレヘム人ヤイルの子エルハナンは、ガテ人ゴリヤテの兄弟ラフミを打ち殺した。ラフミの槍の柄は、機織りの巻き棒のようであった。","tok":[["ゴブ"],["で"],["また"],["ペリシテ"],["人","にん"],["と"],["の"],["戦い","たたかい"],["が"],["あった"],["とき"],["、"],["ベツレヘム"],["人","にん"],["ヤイル"],["の"],["子","こ"],["エルハナン"],["は"],["、"],["ガテ人","がてにん"],["ゴリヤテ"],["の"],["兄弟","きょうだい"],["ラフミ"],["を"],["打ち殺した","うちころした"],["。"],["ラフミ"],["の"],["槍","やり"],["の"],["柄","がら"],["は"],["、"],["機織り","はたおり"],["の"],["巻き","まき"],["棒","ぼう"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":20,"text":"さらにガテで戦いがあったとき、そこに、手の指、足の指が六本ずつで、合計二十四本指の闘士がいた。彼もまた、ラファの子孫であった。","tok":[["さらに"],["ガテ"],["で"],["戦い","たたかい"],["が"],["あった"],["とき"],["、"],["そこ"],["に"],["、"],["手","て"],["の"],["指","ゆび"],["、"],["足","あし"],["の"],["指","ゆび"],["が"],["六本","ろくぽん"],["ずつ"],["で"],["、"],["合計","ごうけい"],["二十四本","にじゅうよんぽん"],["指","ゆび"],["の"],["闘士","とうし"],["が"],["いた"],["。"],["彼","かれ"],["も"],["また"],["、"],["ラファ"],["の"],["子孫","しそん"],["で"],["あった"],["。"]]},{"verse":21,"text":"彼はイスラエルをそしったが、ダビデの兄弟シムアの子ヨナタンが彼を打ち殺した。","tok":[["彼","かれ"],["は"],["イスラエル"],["を"],["そしった"],["が"],["、"],["ダビデ"],["の"],["兄弟","きょうだい"],["シムア"],["の"],["子","こ"],["ヨナタン"],["が"],["彼","かれ"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":22,"text":"これら四人はガテのラファの子孫で、ダビデとその家来たちの手にかかって倒れた。","tok":[["これ"],["ら"],["四人","よんにん"],["は"],["ガテ"],["の"],["ラファ"],["の"],["子孫","しそん"],["で"],["、"],["ダビデ"],["と"],["その"],["家来","けらい"],["たち"],["の"],["手","て"],["に"],["かかって"],["倒れた","たおれた"],["。"]]}]
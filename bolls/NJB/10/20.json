[{"verse":1,"text":"たまたまそこに、よこしまな者で、名をシェバという者がいた。彼はベニヤミン人ビクリの子であった。彼は角笛を吹き鳴らして言った。「ダビデには、われわれのための割り当て地がない。エッサイの子には、われわれのためのゆずりの地がない。イスラエルよ。おのおの自分の天幕に帰れ。」","tok":[["たまたま"],["そこ"],["に"],["、"],["よこしま"],["な"],["者","もの"],["で"],["、"],["名","な"],["を"],["シェバ"],["と"],["いう"],["者","もの"],["が"],["いた"],["。"],["彼","かれ"],["は"],["ベニヤミン"],["人","にん"],["ビクリ"],["の"],["子","こ"],["で"],["あった"],["。"],["彼","かれ"],["は"],["角笛","つのぶえ"],["を"],["吹き鳴らして","ふきならして"],["言った","いった"],["。"],["「"],["ダビデ"],["に"],["は"],["、"],["われわれ"],["の"],["ため"],["の"],["割り当て","わりあて"],["地","ち"],["が"],["ない"],["。"],["エッサイ"],["の"],["子","こ"],["に"],["は"],["、"],["われわれ"],["の"],["ため"],["の"],["ゆずり"],["の"],["地","ち"],["が"],["ない"],["。"],["イスラエル"],["よ"],["。"],["おのおの"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["帰れ","かえれ"],["。"],["」"]]},{"verse":2,"text":"そのため、すべてのイスラエル人は、ダビデから離れて、ビクリの子シェバに従って行った。しかし、ユダの人々はヨルダン川からエルサレムまで、自分たちの王につき従って行った。","tok":[["その"],["ため"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["は"],["、"],["ダビデ"],["から"],["離れて","はなれて"],["、"],["ビクリ"],["の"],["子","こ"],["シェバ"],["に"],["従って","したがって"],["行った","いった"],["。"],["しかし"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["ヨルダン"],["川","かわ"],["から"],["エルサレム"],["まで"],["、"],["自分","じぶん"],["たち"],["の"],["王","おう"],["に"],["つき従って","つきしたがって"],["行った","いった"],["。"]]},{"verse":3,"text":"ダビデはエルサレムの自分の王宮に入った。王は、王宮の留守番に残しておいた十人のそばめをとり、監視つきの家を与えて養ったが、王は彼女たちのところには通わなかった。それで彼女たちは、一生、やもめとなって、死ぬ日まで閉じ込められていた。","tok":[["ダビデ"],["は"],["エルサレム"],["の"],["自分","じぶん"],["の"],["王宮","おうきゅう"],["に"],["入った","はいった"],["。"],["王","おう"],["は"],["、"],["王宮","おうきゅう"],["の"],["留守番","るすばん"],["に"],["残して","のこして"],["おいた"],["十人","じゅうにん"],["の"],["そばめ"],["を"],["とり"],["、"],["監視","かんし"],["つき"],["の"],["家","いえ"],["を"],["与えて","あたえて"],["養った","やしなった"],["が"],["、"],["王","おう"],["は"],["彼女","かのじょ"],["たち"],["の"],["ところ"],["に"],["は"],["通わなかった","かよわなかった"],["。"],["それ"],["で"],["彼女","かのじょ"],["たち"],["は"],["、"],["一生","いっしょう"],["、"],["やもめ"],["と"],["なって"],["、"],["死ぬ","しぬ"],["日","ひ"],["まで"],["閉じ込められて","とじこめられて"],["いた"],["。"]]},{"verse":4,"text":"さて、王はアマサに言った。「私のために、ユダの人々を三日のうちに召集し、あなたも、ここに帰って来なさい。」","tok":[["さて"],["、"],["王","おう"],["は"],["アマサ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["ため"],["に"],["、"],["ユダ"],["の"],["人々","ひとびと"],["を"],["三日","みっか"],["の"],["うち"],["に"],["召集","しょうしゅう"],["し"],["、"],["あなた"],["も"],["、"],["ここ"],["に"],["帰って","かえって"],["来","き"],["なさい"],["。"],["」"]]},{"verse":5,"text":"そこでアマサは、ユダの人々を召集するために出て行ったが、指定された期限に間に合わなかった。","tok":[["そこ"],["で"],["アマサ"],["は"],["、"],["ユダ"],["の"],["人々","ひとびと"],["を"],["召集","しょうしゅう"],["する"],["ため"],["に"],["出て","でて"],["行った","いった"],["が"],["、"],["指定","してい"],["された"],["期限","きげん"],["に"],["間に合わなかった","まにあわなかった"],["。"]]},{"verse":6,"text":"ダビデはアビシャイに言った。「今や、ビクリの子シェバは、アブシャロムよりも、もっとひどいわざわいを、われわれにしかけるに違いない。あなたは、私の家来を引き連れて彼を追いなさい。でないと彼は城壁のある町に入って、のがれてしまうだろう。」","tok":[["ダビデ"],["は"],["アビシャイ"],["に"],["言った","いった"],["。"],["「"],["今","いま"],["や"],["、"],["ビクリ"],["の"],["子","こ"],["シェバ"],["は"],["、"],["アブシャロム"],["より"],["も"],["、"],["もっと"],["ひどい"],["わざわい"],["を"],["、"],["われわれ"],["に"],["しかける"],["に"],["違い","ちがい"],["ない"],["。"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["家来","けらい"],["を"],["引き連れて","ひきつれて"],["彼","かれ"],["を"],["追い","おい"],["なさい"],["。"],["で"],["ない"],["と"],["彼","かれ"],["は"],["城壁","じょうへき"],["の"],["ある"],["町","まち"],["に"],["入って","はいって"],["、"],["のがれて"],["しまうだろう"],["。"],["」"]]},{"verse":7,"text":"それで、ヨアブの部下と、ケレテ人と、ペレテ人と、すべての勇士たちとは、アビシャイのあとに続いて出て行った。彼らはエルサレムを出て、ビクリの子シェバのあとを追った。","tok":[["それ"],["で"],["、"],["ヨアブ"],["の"],["部下","ぶか"],["と"],["、"],["ケレテ人","けれてにん"],["と"],["、"],["ペレテ人","ぺれてにん"],["と"],["、"],["すべて"],["の"],["勇士","ゆうし"],["たち"],["と"],["は"],["、"],["アビシャイ"],["の"],["あと"],["に"],["続いて","つづいて"],["出て","でて"],["行った","いった"],["。"],["彼","かれ"],["ら"],["は"],["エルサレム"],["を"],["出て","でて"],["、"],["ビクリ"],["の"],["子","こ"],["シェバ"],["の"],["あと"],["を"],["追った","おった"],["。"]]},{"verse":8,"text":"彼らがギブオンにある大きな石のそばに来たとき、アマサが彼らの前にやって来た。ヨアブは自分のよろいを身に着け、さやに納めた剣を腰の上に帯で結びつけていた。彼が進み出ると、剣が落ちた。","tok":[["彼","かれ"],["ら"],["が"],["ギブオン"],["に"],["ある"],["大きな","おおきな"],["石","いし"],["の"],["そば"],["に"],["来た","きた"],["とき"],["、"],["アマサ"],["が"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["やって"],["来た","きた"],["。"],["ヨアブ"],["は"],["自分","じぶん"],["の"],["よろい"],["を"],["身","み"],["に"],["着け","つけ"],["、"],["さや"],["に"],["納めた","おさめた"],["剣","けん"],["を"],["腰","こし"],["の"],["上","うえ"],["に"],["帯","おび"],["で"],["結びつけて","むすびつけて"],["いた"],["。"],["彼","かれ"],["が"],["進み出る","すすみでる"],["と"],["、"],["剣","けん"],["が"],["落ちた","おちた"],["。"]]},{"verse":9,"text":"ヨアブはアマサに、「兄弟。おまえは元気か」と言って、アマサに口づけしようとして、右手でアマサのひげをつかんだ。","tok":[["ヨアブ"],["は"],["アマサ"],["に"],["、"],["「"],["兄弟","きょうだい"],["。"],["おまえ"],["は"],["元気","げんき"],["か"],["」"],["と"],["言って","いって"],["、"],["アマサ"],["に"],["口づけ","くちづけ"],["しよう"],["として"],["、"],["右手","みぎて"],["で"],["アマサ"],["の"],["ひげ"],["を"],["つかんだ"],["。"]]},{"verse":10,"text":"アマサはヨアブの手にある剣に気をつけていなかった。ヨアブが彼の下腹を刺したので、はらわたが地面に流れ出た。この一突きでアマサは死んだ。／それからヨアブとその兄弟アビシャイは、ビクリの子シェバのあとを追った。","tok":[["アマサ"],["は"],["ヨアブ"],["の"],["手","て"],["に"],["ある"],["剣","けん"],["に"],["気","き"],["を"],["つけて"],["いなかった"],["。"],["ヨアブ"],["が"],["彼","かれ"],["の"],["下腹","したはら"],["を"],["刺した","さした"],["ので"],["、"],["はらわた"],["が"],["地面","じめん"],["に"],["流れ出た","ながれでた"],["。"],["この"],["一","いち"],["突き","つき"],["で"],["アマサ"],["は"],["死んだ","しんだ"],["。"],["／"],["それ"],["から"],["ヨアブ"],["と"],["その"],["兄弟","きょうだい"],["アビシャイ"],["は"],["、"],["ビクリ"],["の"],["子","こ"],["シェバ"],["の"],["あと"],["を"],["追った","おった"],["。"]]},{"verse":11,"text":"そのとき、ヨアブに仕える若い者のひとりがアマサのそばに立って言った。「ヨアブにつく者、ダビデに味方する者は、ヨアブに従え。」","tok":[["その"],["とき"],["、"],["ヨアブ"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["の"],["ひとり"],["が"],["アマサ"],["の"],["そば"],["に"],["立って","たって"],["言った","いった"],["。"],["「"],["ヨアブ"],["に"],["つく"],["者","もの"],["、"],["ダビデ"],["に"],["味方","みかた"],["する"],["者","もの"],["は"],["、"],["ヨアブ"],["に"],["従え","したがえ"],["。"],["」"]]},{"verse":12,"text":"アマサは大路の真ん中で、血まみれになってころがっていた。この若い者は、民がみな立ち止まるのを見て、アマサを大路から野原に運んだ。そのかたわらを通る者がみな、立ち止まるのを見ると、彼の上に着物を掛けた。","tok":[["アマサ"],["は"],["大路","おおじ"],["の"],["真ん中","まんなか"],["で"],["、"],["血まみれ","ちまみれ"],["に"],["なって"],["ころがって"],["いた"],["。"],["この"],["若い","わかい"],["者","もの"],["は"],["、"],["民","みん"],["が"],["みな"],["立ち止まる","たちどまる"],["の"],["を"],["見て","みて"],["、"],["アマサ"],["を"],["大路","おおじ"],["から"],["野原","のはら"],["に"],["運んだ","はこんだ"],["。"],["その"],["かたわら"],["を"],["通る","とおる"],["者","もの"],["が"],["みな"],["、"],["立ち止まる","たちどまる"],["の"],["を"],["見る","みる"],["と"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["着物","きもの"],["を"],["掛けた","かけた"],["。"]]},{"verse":13,"text":"アマサが大路から移されると、みなヨアブのあとについて進み、ビクリの子シェバを追った。","tok":[["アマサ"],["が"],["大路","おおじ"],["から"],["移される","うつされる"],["と"],["、"],["みな"],["ヨアブ"],["の"],["あと"],["について"],["進み","すすみ"],["、"],["ビクリ"],["の"],["子","こ"],["シェバ"],["を"],["追った","おった"],["。"]]},{"verse":14,"text":"シェバはイスラエルの全部族のうちを通って、アベル・ベテ・マアカへ行った。すべてのベリ人は集まって来て、彼に従った。","tok":[["シェバ"],["は"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["の"],["うち"],["を"],["通って","とおって"],["、"],["アベル"],["・"],["ベテ"],["・"],["マアカ"],["へ"],["行った","いった"],["。"],["すべて"],["の"],["ベリ人","べりにん"],["は"],["集まって","あつまって"],["来て","きて"],["、"],["彼","かれ"],["に"],["従った","したがった"],["。"]]},{"verse":15,"text":"しかし、人々はアベル・ベテ・マアカに来て、彼を包囲し、この町に向かって塁を築いた。それは外壁に向かって立てられた。ヨアブにつく民はみな、城壁を破壊して倒そうとしていた。","tok":[["しかし"],["、"],["人々","ひとびと"],["は"],["アベル"],["・"],["ベテ"],["・"],["マアカ"],["に"],["来て","きて"],["、"],["彼","かれ"],["を"],["包囲","ほうい"],["し"],["、"],["この"],["町","まち"],["に"],["向かって","むかって"],["塁","るい"],["を"],["築いた","きずいた"],["。"],["それ"],["は"],["外壁","がいへき"],["に"],["向かって","むかって"],["立てられた","たてられた"],["。"],["ヨアブ"],["に"],["つく"],["民","たみ"],["は"],["みな"],["、"],["城壁","じょうへき"],["を"],["破壊","はかい"],["して"],["倒そう","たおそう"],["として"],["いた"],["。"]]},{"verse":16,"text":"そのとき、この町から、ひとりの知恵のある女が叫んだ。「聞いてください。聞いてください。ヨアブにこう言ってください。ここまで近づいてください。あなたにお話ししたいのです。」","tok":[["その"],["とき"],["、"],["この"],["町","まち"],["から"],["、"],["ひとり"],["の"],["知恵","ちえ"],["の"],["ある"],["女","おんな"],["が"],["叫んだ","さけんだ"],["。"],["「"],["聞いて","きいて"],["ください"],["。"],["聞いて","きいて"],["ください"],["。"],["ヨアブ"],["に"],["こう"],["言って","いって"],["ください"],["。"],["ここ"],["まで"],["近づいて","ちかづいて"],["ください"],["。"],["あなた"],["に"],["お話し","おはなし"],["したい"],["の"],["です"],["。"],["」"]]},{"verse":17,"text":"ヨアブが彼女のほうに近づくと、この女は、「あなたがヨアブですか」と尋ねた。彼は答えた。「そうだ。」すると女は言った。「このはしためのことばを聞いてください。」彼は答えた。「私が聞こう。」","tok":[["ヨアブ"],["が"],["彼女","かのじょ"],["の"],["ほう"],["に"],["近づく","ちかづく"],["と"],["、"],["この"],["女","おんな"],["は"],["、"],["「"],["あなた"],["が"],["ヨアブ"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["そう"],["だ"],["。"],["」"],["する"],["と"],["女","おんな"],["は"],["言った","いった"],["。"],["「"],["この"],["はし"],["ため"],["の"],["ことば"],["を"],["聞いて","きいて"],["ください"],["。"],["」"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["が"],["聞こう","きこう"],["。"],["」"]]},{"verse":18,"text":"すると女はこう言った。「昔、人々は『アベルで尋ねてみなければならない』と言って、事を決めるのがならわしでした。","tok":[["する"],["と"],["女","おんな"],["は"],["こう"],["言った","いった"],["。"],["「"],["昔","むかし"],["、"],["人々","ひとびと"],["は"],["『"],["アベル"],["で"],["尋ねて","たずねて"],["みなければ"],["ならない"],["』"],["と"],["言って","いって"],["、"],["事","こと"],["を"],["決める","きめる"],["の"],["が"],["ならわし"],["でした"],["。"]]},{"verse":19,"text":"私は、イスラエルのうちで平和な、忠実な者のひとりです。あなたは、イスラエルの母である町を滅ぼそうとしておられます。あなたはなぜ、主のゆずりの地を、のみ尽くそうとされるのですか。」","tok":[["私","わたくし"],["は"],["、"],["イスラエル"],["の"],["うち"],["で"],["平和","へいわ"],["な"],["、"],["忠実","ちゅうじつ"],["な"],["者","もの"],["の"],["ひとり"],["です"],["。"],["あなた"],["は"],["、"],["イスラエル"],["の"],["母","はは"],["で"],["ある"],["町","まち"],["を"],["滅ぼそう","ほろぼそう"],["として"],["おられます"],["。"],["あなた"],["は"],["なぜ"],["、"],["主","ぬし"],["の"],["ゆずり"],["の"],["地","ち"],["を"],["、"],["のみ"],["尽くそう","つくそう"],["と"],["される"],["の"],["です"],["か"],["。"],["」"]]},{"verse":20,"text":"ヨアブは答えて言った。「絶対にそんなことはない。のみ尽くしたり、滅ぼしたりするなど、とてもできないことだ。","tok":[["ヨアブ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ない"],["。"],["のみ"],["尽くし","つくし"],["たり"],["、"],["滅ぼし","ほろぼし"],["たり"],["する"],["など"],["、"],["とても"],["できない"],["こと"],["だ"],["。"]]},{"verse":21,"text":"そうではない。実はビクリの子で、その名をシェバというエフライムの山地の出の男が、ダビデ王にそむいたのだ。この男だけを引き渡してくれたら、私はこの町から引き揚げよう。」するとこの女はヨアブに言った。「では、その男の首を城壁の上からあなたのところに投げ落としてごらんにいれます。」","tok":[["そう"],["で"],["は"],["ない"],["。"],["実","じつ"],["は"],["ビクリ"],["の"],["子","こ"],["で"],["、"],["その"],["名","な"],["を"],["シェバ"],["と"],["いう"],["エフライム"],["の"],["山地","さんち"],["の"],["出","で"],["の"],["男","おとこ"],["が"],["、"],["ダビデ"],["王","おう"],["に"],["そむいた"],["の"],["だ"],["。"],["この"],["男","おとこ"],["だけ"],["を"],["引き渡して","ひきわたして"],["くれたら"],["、"],["私","わたくし"],["は"],["この"],["町","まち"],["から"],["引き揚げよう","ひきあげよう"],["。"],["」"],["する"],["と"],["この"],["女","おんな"],["は"],["ヨアブ"],["に"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["その"],["男","おとこ"],["の"],["首","くび"],["を"],["城壁","じょうへき"],["の"],["上","うえ"],["から"],["あなた"],["の"],["ところ"],["に"],["投げ落として","なげおとして"],["ごらん"],["に"],["いれます"],["。"],["」"]]},{"verse":22,"text":"この女はその知恵を用いてすべての民のところに行った。それで彼らはビクリの子シェバの首をはね、それをヨアブのもとに投げた。ヨアブが角笛を吹き鳴らしたので、人々は町から散って行って、めいめい自分の天幕へ帰った。ヨアブはエルサレムの王のところに戻った。","tok":[["この"],["女","おんな"],["は"],["その"],["知恵","ちえ"],["を"],["用いて","もちいて"],["すべて"],["の"],["民","たみ"],["の"],["ところ"],["に"],["行った","いった"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["ビクリ"],["の"],["子","こ"],["シェバ"],["の"],["首","くび"],["を"],["はね"],["、"],["それ"],["を"],["ヨアブ"],["の"],["もと"],["に"],["投げた","なげた"],["。"],["ヨアブ"],["が"],["角笛","つのぶえ"],["を"],["吹き鳴らした","ふきならした"],["ので"],["、"],["人々","ひとびと"],["は"],["町","まち"],["から"],["散って","ちって"],["行って","いって"],["、"],["めいめい"],["自分","じぶん"],["の"],["天幕","てんまく"],["へ"],["帰った","かえった"],["。"],["ヨアブ"],["は"],["エルサレム"],["の"],["王","おう"],["の"],["ところ"],["に"],["戻った","もどった"],["。"]]},{"verse":23,"text":"さて、ヨアブはイスラエルの全軍の長であった。エホヤダの子ベナヤはケレテ人とペレテ人の長。","tok":[["さて"],["、"],["ヨアブ"],["は"],["イスラエル"],["の"],["全軍","ぜんぐん"],["の"],["長","ちょう"],["で"],["あった"],["。"],["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["は"],["ケレテ人","けれてにん"],["と"],["ペレテ人","ぺれてにん"],["の"],["長","ちょう"],["。"]]},{"verse":24,"text":"アドラムは役務長官。アヒルデの子ヨシャパテは参議。","tok":[["アドラム"],["は"],["役務","えきむ"],["長官","ちょうかん"],["。"],["アヒルデ"],["の"],["子","こ"],["ヨシャパテ"],["は"],["参議","さんぎ"],["。"]]},{"verse":25,"text":"シェワは書記。ツァドクとエブヤタルは祭司。","tok":[["シェワ"],["は"],["書記","しょき"],["。"],["ツァドク"],["と"],["エブヤタル"],["は"],["祭司","さいし"],["。"]]},{"verse":26,"text":"ヤイル人イラもダビデの祭司であった。","tok":[["ヤイル人","やいるにん"],["イラ"],["も"],["ダビデ"],["の"],["祭司","さいし"],["で"],["あった"],["。"]]}]
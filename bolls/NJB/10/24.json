[{"verse":1,"text":"さて、再び主の怒りが、イスラエルに向かって燃え上がった。主は「さあ、イスラエルとユダの人口を数えよ」と言って、ダビデを動かして彼らに向かわせた。","tok":[["さて"],["、"],["再び","ふたたび"],["主","ぬし"],["の"],["怒り","いかり"],["が"],["、"],["イスラエル"],["に"],["向かって","むかって"],["燃え上がった","もえあがった"],["。"],["主","ぬし"],["は"],["「"],["さあ"],["、"],["イスラエル"],["と"],["ユダ"],["の"],["人口","じんこう"],["を"],["数えよ","かぞえよ"],["」"],["と"],["言って","いって"],["、"],["ダビデ"],["を"],["動かして","うごかして"],["彼","かれ"],["ら"],["に"],["向かわせた","むかわせた"],["。"]]},{"verse":2,"text":"王は側近の軍隊の長ヨアブに言った。「さあ、ダンからベエル・シェバに至るまでのイスラエルの全部族の間を行き巡り、その民を登録し、私に、民の数を知らせなさい。」","tok":[["王","おう"],["は"],["側近","そっきん"],["の"],["軍隊","ぐんたい"],["の"],["長","ちょう"],["ヨアブ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["ダン"],["から"],["ベエル"],["・"],["シェバ"],["に"],["至る","いたる"],["まで"],["の"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["の"],["間","あいだ"],["を"],["行き","いき"],["巡り","めぐり"],["、"],["その"],["民","たみ"],["を"],["登録","とうろく"],["し"],["、"],["私","わたくし"],["に"],["、"],["民","みん"],["の"],["数","かず"],["を"],["知らせ","しらせ"],["なさい"],["。"],["」"]]},{"verse":3,"text":"すると、ヨアブは王に言った。「あなたの神、主が、この民を今より百倍も増してくださいますように。王さまが、親しくこれをご覧になりますように。ところで、王さまは、なぜ、このようなことを望まれるのですか。」","tok":[["する"],["と"],["、"],["ヨアブ"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["この"],["民","たみ"],["を"],["今","いま"],["より"],["百","ひゃく"],["倍","ばい"],["も"],["増して","まして"],["くださいます"],["よう"],["に"],["。"],["王","おう"],["さま"],["が"],["、"],["親しく","したしく"],["これ"],["を"],["ご覧","ごらん"],["に"],["なります"],["よう"],["に"],["。"],["ところ"],["で"],["、"],["王","おう"],["さま"],["は"],["、"],["なぜ"],["、"],["この"],["よう"],["な"],["こと"],["を"],["望まれる","のぞまれる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":4,"text":"しかし王は、ヨアブと将校たちを説き伏せたので、ヨアブと将校たちは、王の前から去って、イスラエルの民を登録しに出かけた。","tok":[["しかし"],["王","おう"],["は"],["、"],["ヨアブ"],["と"],["将校","しょうこう"],["たち"],["を"],["説き伏せた","ときふせた"],["ので"],["、"],["ヨアブ"],["と"],["将校","しょうこう"],["たち"],["は"],["、"],["王","おう"],["の"],["前","まえ"],["から"],["去って","さって"],["、"],["イスラエル"],["の"],["民","たみ"],["を"],["登録","とうろく"],["し"],["に"],["出かけた","でかけた"],["。"]]},{"verse":5,"text":"彼らはヨルダン川を渡って、ガドの谷の真ん中にある町、ヤゼルに向かって右側にあるアロエルに宿営し、","tok":[["彼","かれ"],["ら"],["は"],["ヨルダン"],["川","かわ"],["を"],["渡って","わたって"],["、"],["ガド"],["の"],["谷","たに"],["の"],["真ん中","まんなか"],["に"],["ある"],["町","まち"],["、"],["ヤゼル"],["に"],["向かって","むかって"],["右側","みぎがわ"],["に"],["ある"],["アロエル"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":6,"text":"それから、ギルアデとタフティム・ホデシの地に行き、さらにダン・ヤアンに行き、シドンに回った。","tok":[["それ"],["から"],["、"],["ギルアデ"],["と"],["タフティム"],["・"],["ホデシ"],["の"],["地","ち"],["に"],["行き","いき"],["、"],["さらに"],["ダン"],["・"],["ヤアン"],["に"],["行き","いき"],["、"],["シドン"],["に"],["回った","まわった"],["。"]]},{"verse":7,"text":"そしてツロの要塞に行き、ヒビ人やカナン人のすべての町々に行き、それからユダのネゲブへ出て行って、ベエル・シェバに来た。","tok":[["そして"],["ツロ"],["の"],["要塞","ようさい"],["に"],["行き","いき"],["、"],["ヒビ人","ひびにん"],["や"],["カナン人","かなんにん"],["の"],["すべて"],["の"],["町々","まちまち"],["に"],["行き","いき"],["、"],["それ"],["から"],["ユダ"],["の"],["ネゲブ"],["へ"],["出て","でて"],["行って","いって"],["、"],["ベエル"],["・"],["シェバ"],["に"],["来た","きた"],["。"]]},{"verse":8,"text":"こうして彼らは全土を行き巡り、九か月と二十日の後にエルサレムに帰って来た。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["全土","ぜんど"],["を"],["行き","いき"],["巡り","めぐり"],["、"],["九","きゅう"],["か月","かげつ"],["と"],["二十日","にとうか"],["の"],["後","あと"],["に"],["エルサレム"],["に"],["帰って","かえって"],["来た","きた"],["。"]]},{"verse":9,"text":"そして、ヨアブは民の登録人数を王に報告した。イスラエルには剣を使う兵士が八十万、ユダの兵士は五十万人であった。","tok":[["そして"],["、"],["ヨアブ"],["は"],["民","みん"],["の"],["登録","とうろく"],["人数","にんずう"],["を"],["王","おう"],["に"],["報告","ほうこく"],["した"],["。"],["イスラエル"],["に"],["は"],["剣","けん"],["を"],["使う","つかう"],["兵士","へいし"],["が"],["八十万","はちじゅうまん"],["、"],["ユダ"],["の"],["兵士","へいし"],["は"],["五十万人","ごじゅうまんにん"],["で"],["あった"],["。"]]},{"verse":10,"text":"ダビデは、民を数えて後、良心のとがめを感じた。そこで、ダビデは主に言った。「私は、このようなことをして、大きな罪を犯しました。主よ。今、あなたのしもべの咎を見のがしてください。私はほんとうに愚かなことをしました。」","tok":[["ダビデ"],["は"],["、"],["民","みん"],["を"],["数えて","かぞえて"],["後","あと"],["、"],["良心","りょうしん"],["の"],["とがめ"],["を"],["感じた","かんじた"],["。"],["そこ"],["で"],["、"],["ダビデ"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["この"],["よう"],["な"],["こと"],["を"],["して"],["、"],["大きな","おおきな"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["主","ぬし"],["よ"],["。"],["今","いま"],["、"],["あなた"],["の"],["しもべ"],["の"],["咎","とが"],["を"],["見のがして","みのがして"],["ください"],["。"],["私","わたくし"],["は"],["ほんとう"],["に"],["愚か","おろか"],["な"],["こと"],["を"],["しました"],["。"],["」"]]},{"verse":11,"text":"朝ダビデが起きると、次のような主のことばがダビデの先見者である預言者ガドにあった。","tok":[["朝","あさ"],["ダビデ"],["が"],["起きる","おきる"],["と"],["、"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["ダビデ"],["の"],["先見者","せんけんしゃ"],["で"],["ある"],["預言者","よげんしゃ"],["ガド"],["に"],["あった"],["。"]]},{"verse":12,"text":"「行って、ダビデに告げよ。『主はこう仰せられる。わたしがあなたに負わせる三つのことがある。そのうち一つを選べ。わたしはあなたのためにそれをしよう。』」","tok":[["「"],["行って","いって"],["、"],["ダビデ"],["に"],["告げ","つげ"],["よ"],["。"],["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["が"],["あなた"],["に"],["負わせる","おわせる"],["三","みっ"],["つ"],["の"],["こと"],["が"],["ある"],["。"],["その"],["うち"],["一","ひと"],["つ"],["を"],["選べ","えらべ"],["。"],["わたし"],["は"],["あなた"],["の"],["ため"],["に"],["それ"],["を"],["しよう"],["。"],["』"],["」"]]},{"verse":13,"text":"ガドはダビデのもとに行き、彼に告げて言った。「七年間のききんが、あなたの国に来るのがよいか。三か月間、あなたは仇の前を逃げ、仇があなたを追うのがよいか。三日間、あなたの国に疫病があるのがよいか。今、よく考えて、私を遣わされた方に、何と答えたらよいかを決めてください。」","tok":[["ガド"],["は"],["ダビデ"],["の"],["もと"],["に"],["行き","いき"],["、"],["彼","かれ"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["七","なな"],["年間","ねんかん"],["の"],["ききん"],["が"],["、"],["あなた"],["の"],["国","くに"],["に"],["来る","くる"],["の"],["が"],["よい"],["か"],["。"],["三","さん"],["か月間","かげつかん"],["、"],["あなた"],["は"],["仇","あだ"],["の"],["前","まえ"],["を"],["逃げ","にげ"],["、"],["仇","あだ"],["が"],["あなた"],["を"],["追う","おう"],["の"],["が"],["よい"],["か"],["。"],["三","みっ"],["日間","かかん"],["、"],["あなた"],["の"],["国","くに"],["に"],["疫病","やくびょう"],["が"],["ある"],["の"],["が"],["よい"],["か"],["。"],["今","いま"],["、"],["よく"],["考えて","かんがえて"],["、"],["私","わたくし"],["を"],["遣わされた","つかわされた"],["方","ほう"],["に"],["、"],["何","なん"],["と"],["答えたら","こたえたら"],["よい"],["か"],["を"],["決めて","きめて"],["ください"],["。"],["」"]]},{"verse":14,"text":"ダビデはガドに言った。「それは私には非常につらいことです。主の手に陥ることにしましょう。主のあわれみは深いからです。人の手には陥りたくありません。」","tok":[["ダビデ"],["は"],["ガド"],["に"],["言った","いった"],["。"],["「"],["それ"],["は"],["私","わたくし"],["に"],["は"],["非常","ひじょう"],["に"],["つらい"],["こと"],["です"],["。"],["主","ぬし"],["の"],["手","て"],["に"],["陥る","おちいる"],["こと"],["に"],["しましょう"],["。"],["主","ぬし"],["の"],["あわれみ"],["は"],["深い","ぶかい"],["から"],["です"],["。"],["人","ひと"],["の"],["手","て"],["に"],["は"],["陥りたく","おちいりたく"],["ありません"],["。"],["」"]]},{"verse":15,"text":"すると、主は、その朝から、定められた時まで、イスラエルに疫病を下されたので、ダンからベエル・シェバに至るまで、民のうち七万人が死んだ。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["、"],["その"],["朝","あさ"],["から"],["、"],["定められた","さだめられた"],["時","とき"],["まで"],["、"],["イスラエル"],["に"],["疫病","やくびょう"],["を"],["下された","くだされた"],["ので"],["、"],["ダン"],["から"],["ベエル"],["・"],["シェバ"],["に"],["至る","いたる"],["まで"],["、"],["民","みん"],["の"],["うち"],["七万人","ななまんにん"],["が"],["死んだ","しんだ"],["。"]]},{"verse":16,"text":"御使いが、エルサレムに手を伸べて、これを滅ぼそうとしたとき、主はわざわいを下すことを思い直し、民を滅ぼしている御使いに仰せられた。「もう十分だ。あなたの手を引け。」主の使いは、エブス人アラウナの打ち場のかたわらにいた。","tok":[["御使い","おつかい"],["が"],["、"],["エルサレム"],["に"],["手","て"],["を"],["伸べて","のべて"],["、"],["これ"],["を"],["滅ぼそう","ほろぼそう"],["と"],["した"],["とき"],["、"],["主","ぬし"],["は"],["わざわい"],["を"],["下す","くだす"],["こと"],["を"],["思い直し","おもいなおし"],["、"],["民","みん"],["を"],["滅ぼして","ほろぼして"],["いる"],["御使い","おつかい"],["に"],["仰せられた","おおせられた"],["。"],["「"],["もう"],["十分","じゅうぶん"],["だ"],["。"],["あなた"],["の"],["手","て"],["を"],["引け","ひけ"],["。"],["」"],["主","ぬし"],["の"],["使い","つかい"],["は"],["、"],["エブス人","えぶすにん"],["アラウナ"],["の"],["打ち","うち"],["場","ば"],["の"],["かたわら"],["に"],["いた"],["。"]]},{"verse":17,"text":"ダビデは、民を打っている御使いを見たとき、主に言った。「罪を犯したのは、この私です。私が悪いことをしたのです。この羊の群れがいったい何をしたというのでしょう。どうか、あなたの御手を、私と私の一家に下してください。」","tok":[["ダビデ"],["は"],["、"],["民","みん"],["を"],["打って","うって"],["いる"],["御使い","おつかい"],["を"],["見た","みた"],["とき"],["、"],["主に","おもに"],["言った","いった"],["。"],["「"],["罪","つみ"],["を"],["犯した","おかした"],["の"],["は"],["、"],["この"],["私","わたくし"],["です"],["。"],["私","わたくし"],["が"],["悪い","わるい"],["こと"],["を"],["した"],["の"],["です"],["。"],["この"],["羊","ひつじ"],["の"],["群れ","むれ"],["が"],["いったい"],["何","なん"],["を"],["した"],["と"],["いう"],["の"],["でしょう"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["御手","おて"],["を"],["、"],["私","わたくし"],["と"],["私","わたくし"],["の"],["一家","いっか"],["に"],["下して","くだして"],["ください"],["。"],["」"]]},{"verse":18,"text":"その日、ガドはダビデのところに来て、彼に言った。「エブス人アラウナの打ち場に上って行って、主のために祭壇を築きなさい。」","tok":[["その"],["日","ひ"],["、"],["ガド"],["は"],["ダビデ"],["の"],["ところ"],["に"],["来て","きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["エブス人","えぶすにん"],["アラウナ"],["の"],["打ち","うち"],["場","ば"],["に"],["上って","のぼって"],["行って","いって"],["、"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["なさい"],["。"],["」"]]},{"verse":19,"text":"そこでダビデは、ガドのことばのとおりに、主が命じられたとおりに、上って行った。","tok":[["そこ"],["で"],["ダビデ"],["は"],["、"],["ガド"],["の"],["ことば"],["の"],["とおり"],["に"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":20,"text":"アラウナが見おろすと、王とその家来たちが自分のほうに進んで来るのが見えた。それで、アラウナは出て来て、地にひれ伏して、王に礼をした。","tok":[["アラウナ"],["が"],["見おろす","みおろす"],["と"],["、"],["王","おう"],["と"],["その"],["家来","けらい"],["たち"],["が"],["自分","じぶん"],["の"],["ほう"],["に"],["進んで","すすんで"],["来る","くる"],["の"],["が"],["見えた","みえた"],["。"],["それ"],["で"],["、"],["アラウナ"],["は"],["出て","でて"],["来て","きて"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["、"],["王","おう"],["に"],["礼","れい"],["を"],["した"],["。"]]},{"verse":21,"text":"アラウナは言った。「なぜ、王さまは、このしもべのところにおいでになるのですか。」そこでダビデは言った。「あなたの打ち場を買って、主のために祭壇を建てるためです。神罰が民に及ばないようになるためです。」","tok":[["アラウナ"],["は"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["王","おう"],["さま"],["は"],["、"],["この"],["しもべ"],["の"],["ところ"],["に"],["おいで"],["に"],["なる"],["の"],["です"],["か"],["。"],["」"],["そこ"],["で"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["の"],["打ち","うち"],["場","ば"],["を"],["買って","かって"],["、"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["建てる","たてる"],["ため"],["です"],["。"],["神罰","しんばつ"],["が"],["民","たみ"],["に"],["及ばない","およばない"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["」"]]},{"verse":22,"text":"アラウナはダビデに言った。「王さま。お気に召す物を取って、おささげください。ご覧ください。ここに全焼のいけにえのための牛がいます。たきぎにできる打穀機や牛の用具もあります。","tok":[["アラウナ"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["さま"],["。"],["お気","おき"],["に"],["召す","めす"],["物","もの"],["を"],["取って","とって"],["、"],["おささげ"],["ください"],["。"],["ご覧","ごらん"],["ください"],["。"],["ここ"],["に"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["ため"],["の"],["牛","うし"],["が"],["います"],["。"],["たきぎ"],["に"],["できる"],["打","だ"],["穀","こく"],["機","き"],["や"],["牛","うし"],["の"],["用具","ようぐ"],["も"],["あります"],["。"]]},{"verse":23,"text":"王さま。このアラウナはすべてを王に差し上げます。」アラウナはさらに王に言った。「あなたの神、主が、あなたのささげ物を受け入れてくださいますように。」","tok":[["王","おう"],["さま"],["。"],["この"],["アラウナ"],["は"],["すべて"],["を"],["王","おう"],["に"],["差し上げます","さしあげます"],["。"],["」"],["アラウナ"],["は"],["さらに"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["の"],["ささげ物","ささげもの"],["を"],["受け入れて","うけいれて"],["くださいます"],["よう"],["に"],["。"],["」"]]},{"verse":24,"text":"しかし王はアラウナに言った。「いいえ、私はどうしても、代金を払って、あなたから買いたいのです。費用もかけずに、私の神、主に、全焼のいけにえをささげたくありません。」そしてダビデは、打ち場と牛とを銀五十シェケルで買った。","tok":[["しかし"],["王","おう"],["は"],["アラウナ"],["に"],["言った","いった"],["。"],["「"],["いいえ"],["、"],["私","わたくし"],["は"],["どう"],["して"],["も"],["、"],["代金","だいきん"],["を"],["払って","はらって"],["、"],["あなた"],["から"],["買いたい","かいたい"],["の"],["です"],["。"],["費用","ひよう"],["も"],["かけず"],["に"],["、"],["私","わたくし"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげたく"],["ありません"],["。"],["」"],["そして"],["ダビデ"],["は"],["、"],["打ち","うち"],["場","ば"],["と"],["牛","うし"],["と"],["を"],["銀","ぎん"],["五十","ごじゅう"],["シェケル"],["で"],["買った","かった"],["。"]]},{"verse":25,"text":"こうしてダビデは、そこに主のために祭壇を築き、全焼のいけにえと和解のいけにえとをささげた。主が、この国の祈りに心を動かされたので、神罰はイスラエルに及ばないようになった。","tok":[["こう"],["して"],["ダビデ"],["は"],["、"],["そこ"],["に"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["和解","わかい"],["の"],["いけにえ"],["と"],["を"],["ささげた"],["。"],["主","ぬし"],["が"],["、"],["この"],["国","くに"],["の"],["祈り","いのり"],["に"],["心","こころ"],["を"],["動かされた","うごかされた"],["ので"],["、"],["神罰","しんばつ"],["は"],["イスラエル"],["に"],["及ばない","およばない"],["よう"],["に"],["なった"],["。"]]}]
[{"verse":1,"text":"アヒトフェルはさらにアブシャロムに言った。「私に一万二千人を選ばせてください。私は今夜、ダビデのあとを追って出発し、","tok":[["アヒトフェル"],["は"],["さらに"],["アブシャロム"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["一万二千","いちまんにせん"],["人","にん"],["を"],["選ばせて","えらばせて"],["ください"],["。"],["私","わたくし"],["は"],["今夜","こんや"],["、"],["ダビデ"],["の"],["あと"],["を"],["追って","おって"],["出発","しゅっぱつ"],["し"],["、"]]},{"verse":2,"text":"彼を襲います。ダビデは疲れて気力を失っているでしょう。私が、彼を恐れさせれば、彼といっしょにいるすべての民は逃げましょう。私は王だけを打ち殺します。","tok":[["彼","かれ"],["を"],["襲います","おそいます"],["。"],["ダビデ"],["は"],["疲れて","つかれて"],["気力","きりょく"],["を"],["失って","うしなって"],["いるでしょう"],["。"],["私","わたくし"],["が"],["、"],["彼","かれ"],["を"],["恐れさせれば","おそれさせれば"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["いる"],["すべて"],["の"],["民","たみ"],["は"],["逃げましょう","にげましょう"],["。"],["私","わたくし"],["は"],["王","おう"],["だけ"],["を"],["打ち殺します","うちころします"],["。"]]},{"verse":3,"text":"私はすべての民をあなたのもとに連れ戻します。すべての者が帰って来るとき、あなたが求めているのはただひとりだけですから、民はみな、穏やかになるでしょう。」","tok":[["私","わたくし"],["は"],["すべて"],["の"],["民","たみ"],["を"],["あなた"],["の"],["もと"],["に"],["連れ戻します","つれもどします"],["。"],["すべて"],["の"],["者","もの"],["が"],["帰って","かえって"],["来る","くる"],["とき"],["、"],["あなた"],["が"],["求めて","もとめて"],["いる"],["の"],["は"],["ただ"],["ひとり"],["だけ"],["です"],["から"],["、"],["民","みん"],["は"],["みな"],["、"],["穏やか","おだやか"],["に"],["なるでしょう"],["。"],["」"]]},{"verse":4,"text":"このことばはアブシャロムとイスラエルの全長老の気に入った。","tok":[["この"],["ことば"],["は"],["アブシャロム"],["と"],["イスラエル"],["の"],["全","ぜん"],["長老","ちょうろう"],["の"],["気","き"],["に"],["入った","いった"],["。"]]},{"verse":5,"text":"しかしアブシャロムは言った。「アルキ人フシャイを呼び出し、彼の言うことも聞いてみよう。」","tok":[["しかし"],["アブシャロム"],["は"],["言った","いった"],["。"],["「"],["アルキ人","あるきにん"],["フシャイ"],["を"],["呼び出し","よびだし"],["、"],["彼","かれ"],["の"],["言う","いう"],["こと"],["も"],["聞いて","きいて"],["みよう"],["。"],["」"]]},{"verse":6,"text":"フシャイがアブシャロムのところに来ると、アブシャロムは彼に次のように言った。「アヒトフェルはこのように言ったが、われわれは彼のことばに従ってよいものだろうか。もしいけなければ、あなたの意見を述べてみなさい。」","tok":[["フシャイ"],["が"],["アブシャロム"],["の"],["ところ"],["に"],["来る","くる"],["と"],["、"],["アブシャロム"],["は"],["彼","かれ"],["に"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"],["「"],["アヒトフェル"],["は"],["この"],["よう"],["に"],["言った","いった"],["が"],["、"],["われわれ"],["は"],["彼","かれ"],["の"],["ことば"],["に"],["従って","したがって"],["よい"],["もの"],["だろう"],["か"],["。"],["もし"],["いけなければ"],["、"],["あなた"],["の"],["意見","いけん"],["を"],["述べて","のべて"],["み"],["なさい"],["。"],["」"]]},{"verse":7,"text":"するとフシャイはアブシャロムに言った。「このたびアヒトフェルの立てたはかりごとは良くありません。」","tok":[["する"],["と"],["フシャイ"],["は"],["アブシャロム"],["に"],["言った","いった"],["。"],["「"],["この"],["たび"],["アヒトフェル"],["の"],["立てた","たてた"],["はかりごと"],["は"],["良く","よく"],["ありません"],["。"],["」"]]},{"verse":8,"text":"フシャイはさらに言った。「あなたは父上とその部下が戦士であることをご存じです。しかも彼らは、野で子を奪われた雌熊のように気が荒くなっています。また、あなたの父上は戦いに慣れた方ですから、民といっしょには夜を過ごさないでしょう。","tok":[["フシャイ"],["は"],["さらに"],["言った","いった"],["。"],["「"],["あなた"],["は"],["父","ちち"],["上","うえ"],["と"],["その"],["部下","ぶか"],["が"],["戦士","せんし"],["で"],["ある"],["こと"],["を"],["ご存じ","ごぞんじ"],["です"],["。"],["しかも"],["彼","かれ"],["ら"],["は"],["、"],["野","の"],["で"],["子","こ"],["を"],["奪われた","うばわれた"],["雌熊","めすぐま"],["の"],["よう"],["に"],["気","き"],["が"],["荒く","あらく"],["なって"],["います"],["。"],["また"],["、"],["あなた"],["の"],["父上","ちちじょう"],["は"],["戦い","たたかい"],["に"],["慣れた","なれた"],["方","ほう"],["です"],["から"],["、"],["民","みん"],["と"],["いっしょ"],["に"],["は"],["夜","よる"],["を"],["過ごさないでしょう","すごさないでしょう"],["。"]]},{"verse":9,"text":"きっと今、ほら穴か、どこか、そんな所に隠れておられましょう。もし、民のある者が最初に倒れたら、それを聞く者は、『アブシャロムに従う民のうちに打たれた者が出た』と言うでしょう。","tok":[["きっと"],["今","いま"],["、"],["ほら穴","ほらあな"],["か"],["、"],["どこ"],["か"],["、"],["そんな"],["所","ところ"],["に"],["隠れて","かくれて"],["おられましょう"],["。"],["もし"],["、"],["民","みん"],["の"],["ある"],["者","もの"],["が"],["最初","さいしょ"],["に"],["倒れたら","たおれたら"],["、"],["それ"],["を"],["聞く","きく"],["者","もの"],["は"],["、"],["『"],["アブシャロム"],["に"],["従う","したがう"],["民","たみ"],["の"],["うち"],["に"],["打たれた","うたれた"],["者","もの"],["が"],["出た","でた"],["』"],["と"],["言うでしょう","ゆうでしょう"],["。"]]},{"verse":10,"text":"そうなると、たとい、獅子のような心を持つ力ある者でも、気がくじけます。全イスラエルは、あなたの父上が勇士であり、彼に従う者が力ある者であるのをよく知っています。","tok":[["そう"],["なる"],["と"],["、"],["たとい"],["、"],["獅子","しし"],["の"],["よう"],["な"],["心","こころ"],["を"],["持つ","もつ"],["力","ちから"],["ある"],["者","もの"],["で"],["も"],["、"],["気","き"],["が"],["くじけます"],["。"],["全","ぜん"],["イスラエル"],["は"],["、"],["あなた"],["の"],["父","ちち"],["上","うえ"],["が"],["勇士","ゆうし"],["で"],["あり"],["、"],["彼","かれ"],["に"],["従う","したがう"],["者","もの"],["が"],["力","ちから"],["ある"],["者","もの"],["で"],["ある"],["の"],["を"],["よく"],["知って","しって"],["います"],["。"]]},{"verse":11,"text":"私のはかりごとはこうです。全イスラエルをダンからベエル・シェバに至るまで、海辺の砂のように数多くあなたのところに集めて、あなた自身が戦いに出られることです。","tok":[["私","わたくし"],["の"],["はかりごと"],["は"],["こう"],["です"],["。"],["全","ぜん"],["イスラエル"],["を"],["ダン"],["から"],["ベエル"],["・"],["シェバ"],["に"],["至る","いたる"],["まで"],["、"],["海辺","うみべ"],["の"],["砂","すな"],["の"],["よう"],["に"],["数多く","かずおおく"],["あなた"],["の"],["ところ"],["に"],["集めて","あつめて"],["、"],["あなた"],["自身","じしん"],["が"],["戦い","たたかい"],["に"],["出られる","でられる"],["こと"],["です"],["。"]]},{"verse":12,"text":"われわれは、彼を見つけしだい、その場で彼を攻め、露が地面に降りるように彼を襲い、彼や、共にいるすべての兵士たちを、ひとりも生かしておかないのです。","tok":[["われわれ"],["は"],["、"],["彼","かれ"],["を"],["見つけ","みつけ"],["しだい"],["、"],["その"],["場","ば"],["で"],["彼","かれ"],["を"],["攻め","せめ"],["、"],["露","ろ"],["が"],["地面","じめん"],["に"],["降りる","おりる"],["よう"],["に"],["彼","かれ"],["を"],["襲い","おそい"],["、"],["彼","かれ"],["や"],["、"],["共","とも"],["に"],["いる"],["すべて"],["の"],["兵士","へいし"],["たち"],["を"],["、"],["ひとり"],["も"],["生かして","いかして"],["おかない"],["の"],["です"],["。"]]},{"verse":13,"text":"もし彼がさらにどこかの町に入るなら、全イスラエルでその町に綱をかけ、その町を川まで引きずって行って、そこに一つの石ころも残らないようにしましょう。」","tok":[["もし"],["彼","かれ"],["が"],["さらに"],["どこ"],["か"],["の"],["町","まち"],["に"],["入るなら","はいるなら"],["、"],["全","ぜん"],["イスラエル"],["で"],["その"],["町","まち"],["に"],["綱","つな"],["を"],["かけ"],["、"],["その"],["町","まち"],["を"],["川","かわ"],["まで"],["引きずって","ひきずって"],["行って","いって"],["、"],["そこ"],["に"],["一","ひと"],["つ"],["の"],["石ころ","いしころ"],["も"],["残らない","のこらない"],["よう"],["に"],["しましょう"],["。"],["」"]]},{"verse":14,"text":"アブシャロムとイスラエルの民はみな言った。「アルキ人フシャイのはかりごとは、アヒトフェルのはかりごとよりも良い。」これは主がアブシャロムにわざわいをもたらそうとして、主がアヒトフェルのすぐれたはかりごとを打ちこわそうと決めておられたからであった。","tok":[["アブシャロム"],["と"],["イスラエル"],["の"],["民","たみ"],["は"],["みな"],["言った","いった"],["。"],["「"],["アルキ人","あるきにん"],["フシャイ"],["の"],["はかりごと"],["は"],["、"],["アヒトフェル"],["の"],["はかりごと"],["より"],["も"],["良い","よい"],["。"],["」"],["これ"],["は"],["主","ぬし"],["が"],["アブシャロム"],["に"],["わざわい"],["を"],["もたらそう"],["として"],["、"],["主","ぬし"],["が"],["アヒトフェル"],["の"],["すぐれた"],["はかりごと"],["を"],["打ちこわそう","うちこわそう"],["と"],["決めて","きめて"],["おられた"],["から"],["で"],["あった"],["。"]]},{"verse":15,"text":"フシャイは祭司ツァドクとエブヤタルに言った。「アヒトフェルは、アブシャロムとイスラエルの長老たちにこれこれの助言をしたが、私は、これこれの助言をした。","tok":[["フシャイ"],["は"],["祭司","さいし"],["ツァドク"],["と"],["エブヤタル"],["に"],["言った","いった"],["。"],["「"],["アヒトフェル"],["は"],["、"],["アブシャロム"],["と"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["に"],["これ"],["これ"],["の"],["助言","じょげん"],["を"],["した"],["が"],["、"],["私","わたくし"],["は"],["、"],["これ"],["これ"],["の"],["助言","じょげん"],["を"],["した"],["。"]]},{"verse":16,"text":"今、急いで人をやり、ダビデに、『今夜は荒野の草原で夜を過ごしてはいけません。ほんとうに、ぜひ、あちらへ渡って行かなければなりません。でないと、王をはじめ、いっしょにいる民全部にわざわいが降りかかるでしょう』と告げなさい。」","tok":[["今","いま"],["、"],["急いで","いそいで"],["人","ひと"],["を"],["やり"],["、"],["ダビデ"],["に"],["、"],["『"],["今夜","こんや"],["は"],["荒野","こうや"],["の"],["草原","そうげん"],["で"],["夜","よる"],["を"],["過ごして","すごして"],["は"],["いけません"],["。"],["ほんとう"],["に"],["、"],["ぜひ"],["、"],["あちら"],["へ"],["渡って","わたって"],["行かなければ","いかなければ"],["なりません"],["。"],["で"],["ない"],["と"],["、"],["王","おう"],["を"],["はじめ"],["、"],["いっしょ"],["に"],["いる"],["民","たみ"],["全部","ぜんぶ"],["に"],["わざわい"],["が"],["降りかかるでしょう","ふりかかるでしょう"],["』"],["と"],["告げ","つげ"],["なさい"],["。"],["」"]]},{"verse":17,"text":"ヨナタンとアヒマアツはエン・ロゲルにとどまっていたが、ひとりの女奴隷が行って彼らに告げ、彼らがダビデ王に告げに行くようになっていた。これは彼らが町に入るのを見られることのないためであった。","tok":[["ヨナタン"],["と"],["アヒマアツ"],["は"],["エン"],["・"],["ロゲル"],["に"],["とどまって"],["いた"],["が"],["、"],["ひとり"],["の"],["女","おんな"],["奴隷","どれい"],["が"],["行って","いって"],["彼","かれ"],["ら"],["に"],["告げ","つげ"],["、"],["彼","かれ"],["ら"],["が"],["ダビデ"],["王","おう"],["に"],["告げ","つげ"],["に"],["行く","いく"],["よう"],["に"],["なって"],["いた"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["が"],["町","まち"],["に"],["入る","はいる"],["の"],["を"],["見られる","みられる"],["こと"],["の"],["ない"],["ため"],["で"],["あった"],["。"]]},{"verse":18,"text":"ところが、ひとりの若者が彼らを見て、アブシャロムに告げた。そこで彼らふたりは急いで去り、バフリムに住むある人の家に行った。その人の庭に井戸があったので、彼らはその中に降りた。","tok":[["ところ"],["が"],["、"],["ひとり"],["の"],["若者","わかもの"],["が"],["彼","かれ"],["ら"],["を"],["見て","みて"],["、"],["アブシャロム"],["に"],["告げた","つげた"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["ふたり"],["は"],["急いで","いそいで"],["去り","さり"],["、"],["バフリム"],["に"],["住む","すむ"],["ある"],["人","ひと"],["の"],["家","いえ"],["に"],["行った","いった"],["。"],["その"],["人","ひと"],["の"],["庭","にわ"],["に"],["井戸","いど"],["が"],["あった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["その"],["中","なか"],["に"],["降りた","おりた"],["。"]]},{"verse":19,"text":"その人の妻は、おおいを持って来て、井戸の口の上に広げ、その上に麦をまき散らしたので、だれにも知られなかった。","tok":[["その"],["人","ひと"],["の"],["妻","つま"],["は"],["、"],["おおい"],["を"],["持って","もって"],["来て","きて"],["、"],["井戸","いど"],["の"],["口","くち"],["の"],["上","うえ"],["に"],["広げ","ひろげ"],["、"],["その"],["上","うえ"],["に"],["麦","むぎ"],["を"],["まき散らした","まきちらした"],["ので"],["、"],["だれ"],["に"],["も"],["知られなかった","しられなかった"],["。"]]},{"verse":20,"text":"アブシャロムの家来たちが、その女の家に来て言った。「アヒマアツとヨナタンはどこにいるのか。」女は彼らに答えた。「あの人たちは、ここを通り過ぎて川のほうへ行きました。」彼らは、捜したが見つけることができなかったので、エルサレムへ帰った。","tok":[["アブシャロム"],["の"],["家来","けらい"],["たち"],["が"],["、"],["その"],["女","おんな"],["の"],["家","いえ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["アヒマアツ"],["と"],["ヨナタン"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["」"],["女","おんな"],["は"],["彼","かれ"],["ら"],["に"],["答えた","こたえた"],["。"],["「"],["あの"],["人","ひと"],["たち"],["は"],["、"],["ここ"],["を"],["通り過ぎて","とおりすぎて"],["川","かわ"],["の"],["ほう"],["へ"],["行きました","いきました"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["捜した","さがした"],["が"],["見つける","みつける"],["こと"],["が"],["できなかった"],["ので"],["、"],["エルサレム"],["へ"],["帰った","かえった"],["。"]]},{"verse":21,"text":"彼らが去って後、ふたりは井戸から上がって来て、ダビデ王に知らせに行った。彼らはダビデに言った。「さあ、急いで川を渡ってください。アヒトフェルがあなたがたに対してこれこれのはかりごとを立てたからです。」","tok":[["彼","かれ"],["ら"],["が"],["去って","さって"],["後","あと"],["、"],["ふたり"],["は"],["井戸","いど"],["から"],["上がって","あがって"],["来て","きて"],["、"],["ダビデ"],["王","おう"],["に"],["知らせ","しらせ"],["に"],["行った","いった"],["。"],["彼","かれ"],["ら"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["急いで","いそいで"],["川","かわ"],["を"],["渡って","わたって"],["ください"],["。"],["アヒトフェル"],["が"],["あなた"],["がた"],["に対して","にたいして"],["これ"],["これ"],["の"],["はかりごと"],["を"],["立てた","たてた"],["から"],["です"],["。"],["」"]]},{"verse":22,"text":"そこで、ダビデと、ダビデのもとにいたすべての者たちとは出発して、ヨルダン川を渡った。夜明けまでにヨルダン川を渡りきれなかった者はひとりもいなかった。","tok":[["そこ"],["で"],["、"],["ダビデ"],["と"],["、"],["ダビデ"],["の"],["もと"],["に"],["いた"],["すべて"],["の"],["者","もの"],["たち"],["と"],["は"],["出発","しゅっぱつ"],["して"],["、"],["ヨルダン"],["川","かわ"],["を"],["渡った","わたった"],["。"],["夜明け","よあけ"],["まで"],["に"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["きれなかった"],["者","もの"],["は"],["ひとり"],["も"],["いなかった"],["。"]]},{"verse":23,"text":"アヒトフェルは、自分のはかりごとが行われないのを見て、ろばに鞍を置き、自分の町の家に帰って行き、家を整理して、首をくくって死に、彼の父の墓に葬られた。","tok":[["アヒトフェル"],["は"],["、"],["自分","じぶん"],["の"],["はかりごと"],["が"],["行われない","おこなわれない"],["の"],["を"],["見て","みて"],["、"],["ろば"],["に"],["鞍","くら"],["を"],["置き","おき"],["、"],["自分","じぶん"],["の"],["町","まち"],["の"],["家","いえ"],["に"],["帰って","かえって"],["行き","いき"],["、"],["家","いえ"],["を"],["整理","せいり"],["して"],["、"],["首","くび"],["を"],["くくって"],["死に","しに"],["、"],["彼","かれ"],["の"],["父","ちち"],["の"],["墓","はか"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":24,"text":"ダビデがマハナイムに着いたとき、アブシャロムは、彼とともにいるイスラエルのすべての人々とヨルダン川を渡った。","tok":[["ダビデ"],["が"],["マハナイム"],["に"],["着いた","ついた"],["とき"],["、"],["アブシャロム"],["は"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["と"],["ヨルダン"],["川","かわ"],["を"],["渡った","わたった"],["。"]]},{"verse":25,"text":"アブシャロムはアマサをヨアブの代わりに軍団長に任命していた。アマサは、ヨアブの母ツェルヤの妹ナハシュの娘アビガルと結婚したイシュマエル人イテラという人の息子であった。","tok":[["アブシャロム"],["は"],["アマサ"],["を"],["ヨアブ"],["の"],["代わり","かわり"],["に"],["軍団長","ぐんだんちょう"],["に"],["任命","にんめい"],["して"],["いた"],["。"],["アマサ"],["は"],["、"],["ヨアブ"],["の"],["母","はは"],["ツェルヤ"],["の"],["妹","いもうと"],["ナハシュ"],["の"],["娘","むすめ"],["アビガル"],["と"],["結婚","けっこん"],["した"],["イシュマエル"],["人","にん"],["イテラ"],["と"],["いう"],["人","ひと"],["の"],["息子","むすこ"],["で"],["あった"],["。"]]},{"verse":26,"text":"こうして、イスラエルとアブシャロムはギルアデの地に陣を敷いた。","tok":[["こう"],["して"],["、"],["イスラエル"],["と"],["アブシャロム"],["は"],["ギルアデ"],["の"],["地","ち"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"]]},{"verse":27,"text":"ダビデがマハナイムに来たとき、アモン人でラバの出のナハシュの子ショビと、ロ・デバルの出のアミエルの子マキルと、ログリムの出のギルアデ人バルジライとは、","tok":[["ダビデ"],["が"],["マハナイム"],["に"],["来た","きた"],["とき"],["、"],["アモン人","あもんにん"],["で"],["ラバ"],["の"],["出","で"],["の"],["ナハシュ"],["の"],["子","こ"],["ショビ"],["と"],["、"],["ロ"],["・"],["デバル"],["の"],["出","で"],["の"],["アミエル"],["の"],["子","こ"],["マキル"],["と"],["、"],["ログリム"],["の"],["出","で"],["の"],["ギルアデ"],["人","にん"],["バルジライ"],["と"],["は"],["、"]]},{"verse":28,"text":"寝台、鉢、土器、小麦、大麦、小麦粉、炒り麦、そら豆、レンズ豆、炒り麦、","tok":[["寝台","しんだい"],["、"],["鉢","ばち"],["、"],["土器","どき"],["、"],["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["小麦粉","こむぎこ"],["、"],["炒り","いり"],["麦","むぎ"],["、"],["そら豆","そらまめ"],["、"],["レンズ"],["豆","まめ"],["、"],["炒り","いり"],["麦","むぎ"],["、"]]},{"verse":29,"text":"蜂蜜、凝乳、羊、牛酪を、ダビデとその一行の食糧として持って来た。彼らは民が荒野で飢えて疲れ、渇いていると思ったからである。","tok":[["蜂蜜","はちみつ"],["、"],["凝乳","ぎょうにゅう"],["、"],["羊","ひつじ"],["、"],["牛酪","ぎゅうらく"],["を"],["、"],["ダビデ"],["と"],["その"],["一行","いっこう"],["の"],["食糧","しょくりょう"],["として"],["持って","もって"],["来た","きた"],["。"],["彼","かれ"],["ら"],["は"],["民","みん"],["が"],["荒野","あらの"],["で"],["飢えて","うえて"],["疲れ","つかれ"],["、"],["渇いて","かわいて"],["いる"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]}]
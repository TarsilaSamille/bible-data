[{"verse":1,"text":"サウルの死後、ダビデはアマレク人を打ち破って帰り、二日間、ツィケラグに滞在した。","tok":[["サウル"],["の"],["死後","しご"],["、"],["ダビデ"],["は"],["アマレク"],["人","にん"],["を"],["打ち破って","うちやぶって"],["帰り","かえり"],["、"],["二","ふた"],["日間","かかん"],["、"],["ツィケラグ"],["に"],["滞在","たいざい"],["した"],["。"]]},{"verse":2,"text":"三日目に、突然、ひとりの男がサウルの陣営からやって来た。その着物は裂け、頭には土をかぶっていた。彼は、ダビデのところに来ると、地にひれ伏して、礼をした。","tok":[["三日目","みっかめ"],["に"],["、"],["突然","とつぜん"],["、"],["ひとり"],["の"],["男","おとこ"],["が"],["サウル"],["の"],["陣営","じんえい"],["から"],["やって"],["来た","きた"],["。"],["その"],["着物","きもの"],["は"],["裂け","さけ"],["、"],["頭","あたま"],["に"],["は"],["土","つち"],["を"],["かぶって"],["いた"],["。"],["彼","かれ"],["は"],["、"],["ダビデ"],["の"],["ところ"],["に"],["来る","くる"],["と"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["、"],["礼","れい"],["を"],["した"],["。"]]},{"verse":3,"text":"ダビデは言った。「どこから来たのか。」彼はダビデに言った。「イスラエルの陣営からのがれて来ました。」","tok":[["ダビデ"],["は"],["言った","いった"],["。"],["「"],["どこ"],["から"],["来た","きた"],["の"],["か"],["。"],["」"],["彼","かれ"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["陣営","じんえい"],["から"],["のがれて"],["来ました","きました"],["。"],["」"]]},{"verse":4,"text":"ダビデは彼に言った。「状況はどうか、話してくれ。」すると彼は言った。「民は戦場から逃げ、また民の多くは倒れて死に、サウルも、その子ヨナタンも死にました。」","tok":[["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["状況","じょうきょう"],["は"],["どう"],["か"],["、"],["話して","はなして"],["くれ"],["。"],["」"],["する"],["と"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["民","みん"],["は"],["戦場","せんじょう"],["から"],["逃げ","にげ"],["、"],["また"],["民","みん"],["の"],["多く","おおく"],["は"],["倒れて","たおれて"],["死に","しに"],["、"],["サウル"],["も"],["、"],["その"],["子","こ"],["ヨナタン"],["も"],["死にました","しにました"],["。"],["」"]]},{"verse":5,"text":"ダビデは、その報告をもたらした若者に言った。「サウルとその子ヨナタンが死んだことを、どうして知ったのか。」","tok":[["ダビデ"],["は"],["、"],["その"],["報告","ほうこく"],["を"],["もたらした"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["が"],["死んだ","しんだ"],["こと"],["を"],["、"],["どう"],["して"],["知った","しった"],["の"],["か"],["。"],["」"]]},{"verse":6,"text":"報告をもたらした若者は言った。「私は、たまたま、ギルボア山にいましたが、ちょうどその時、サウルは槍にもたれ、戦車と騎兵があの方に押し迫っていました。","tok":[["報告","ほうこく"],["を"],["もたらした"],["若者","わかもの"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["たまたま"],["、"],["ギルボア"],["山","やま"],["に"],["いました"],["が"],["、"],["ちょうど"],["その"],["時","とき"],["、"],["サウル"],["は"],["槍","やり"],["に"],["もたれ"],["、"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["が"],["あの"],["方","かた"],["に"],["押し迫って","おしせまって"],["いました"],["。"]]},{"verse":7,"text":"サウルが振り返って、私を見て呼びました。私が『はい』と答えると、","tok":[["サウル"],["が"],["振り返って","ふりかえって"],["、"],["私","わたくし"],["を"],["見て","みて"],["呼びました","よびました"],["。"],["私","わたくし"],["が"],["『"],["はい"],["』"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":8,"text":"サウルは私に、『おまえはだれだ』と言いましたので、『私はアマレク人です』と答えますと、","tok":[["サウル"],["は"],["私","わたくし"],["に"],["、"],["『"],["おまえ"],["は"],["だれ"],["だ"],["』"],["と"],["言いました","いいました"],["ので"],["、"],["『"],["私","わたくし"],["は"],["アマレク"],["人","にん"],["です"],["』"],["と"],["答えます","こたえます"],["と"],["、"]]},{"verse":9,"text":"サウルが、『さあ、近寄って、私を殺してくれ。まだ息があるのに、ひどいけいれんが起こった』と言いました。","tok":[["サウル"],["が"],["、"],["『"],["さあ"],["、"],["近寄って","ちかよって"],["、"],["私","わたくし"],["を"],["殺して","ころして"],["くれ"],["。"],["まだ"],["息","いき"],["が"],["ある"],["のに"],["、"],["ひどい"],["けいれん"],["が"],["起こった","おこった"],["』"],["と"],["言いました","いいました"],["。"]]},{"verse":10,"text":"そこで私は近寄って、あの方を殺しました。もう倒れて生きのびることができないとわかったからです。私はその頭にあった王冠と、腕についていた腕輪を取って、ここに、あなたさまのところに持ってまいりました。」","tok":[["そこ"],["で"],["私","わたくし"],["は"],["近寄って","ちかよって"],["、"],["あの"],["方","ほう"],["を"],["殺しました","ころしました"],["。"],["もう"],["倒れて","たおれて"],["生きのびる","いきのびる"],["こと"],["が"],["できない"],["と"],["わかった"],["から"],["です"],["。"],["私","わたくし"],["は"],["その"],["頭","あたま"],["に"],["あった"],["王冠","おうかん"],["と"],["、"],["腕","うで"],["について"],["いた"],["腕輪","うでわ"],["を"],["取って","とって"],["、"],["ここ"],["に"],["、"],["あなた"],["さま"],["の"],["ところ"],["に"],["持って","もって"],["まいりました"],["。"],["」"]]},{"verse":11,"text":"すると、ダビデは自分の衣をつかんで裂いた。そこにいた家来たちもみな、そのようにした。","tok":[["する"],["と"],["、"],["ダビデ"],["は"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["つかんで"],["裂いた","さいた"],["。"],["そこ"],["に"],["いた"],["家来","けらい"],["たち"],["も"],["みな"],["、"],["その"],["よう"],["に"],["した"],["。"]]},{"verse":12,"text":"彼らは、サウルのため、その子ヨナタンのため、また、主の民のため、イスラエルの家のためにいたみ悲しんで泣き、夕方まで断食した。彼らが剣に倒れたからである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["サウル"],["の"],["ため"],["、"],["その"],["子","こ"],["ヨナタン"],["の"],["ため"],["、"],["また"],["、"],["主","ぬし"],["の"],["民","たみ"],["の"],["ため"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["ため"],["に"],["いたみ悲しんで","いたみかなしんで"],["泣き","なき"],["、"],["夕方","ゆうがた"],["まで"],["断食","だんじき"],["した"],["。"],["彼","かれ"],["ら"],["が"],["剣","けん"],["に"],["倒れた","たおれた"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"ダビデは自分に報告した若者に言った。「おまえはどこの者か。」若者は答えた。「私はアマレク人で、在留異国人の子です。」","tok":[["ダビデ"],["は"],["自分","じぶん"],["に"],["報告","ほうこく"],["した"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["は"],["どこ"],["の"],["者","もの"],["か"],["。"],["」"],["若者","わかもの"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["アマレク"],["人","にん"],["で"],["、"],["在留","ざいりゅう"],["異国人","いこくにん"],["の"],["子","こ"],["です"],["。"],["」"]]},{"verse":14,"text":"ダビデは言った。「主に油そそがれた方に、手を下して殺すのを恐れなかったとは、どうしたことか。」","tok":[["ダビデ"],["は"],["言った","いった"],["。"],["「"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","ほう"],["に"],["、"],["手","て"],["を"],["下して","くだして"],["殺す","ころす"],["の"],["を"],["恐れなかった","おそれなかった"],["と"],["は"],["、"],["どう"],["した"],["こと"],["か"],["。"],["」"]]},{"verse":15,"text":"ダビデは若者のひとりを呼んで言った。「近寄って、これを打て。」そこで彼を打ち殺した。","tok":[["ダビデ"],["は"],["若者","わかもの"],["の"],["ひとり"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["近寄って","ちかよって"],["、"],["これ"],["を"],["打て","うて"],["。"],["」"],["そこ"],["で"],["彼","かれ"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":16,"text":"そのとき、ダビデは彼に言った。「おまえの血は、おまえの頭にふりかかれ。おまえ自身の口で、『私は主に油そそがれた方を殺した』と言って証言したからである。」","tok":[["その"],["とき"],["、"],["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["の"],["血","ち"],["は"],["、"],["おまえ"],["の"],["頭","あたま"],["に"],["ふり"],["かかれ"],["。"],["おまえ"],["自身","じしん"],["の"],["口","くち"],["で"],["、"],["『"],["私","わたくし"],["は"],["主に","おもに"],["油","あぶら"],["そそがれた"],["方","ほう"],["を"],["殺した","ころした"],["』"],["と"],["言って","いって"],["証言","しょうげん"],["した"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":17,"text":"ダビデは、サウルのため、その子ヨナタンのために、この哀歌を作り、","tok":[["ダビデ"],["は"],["、"],["サウル"],["の"],["ため"],["、"],["その"],["子","こ"],["ヨナタン"],["の"],["ため"],["に"],["、"],["この"],["哀歌","あいか"],["を"],["作り","つくり"],["、"]]},{"verse":18,"text":"この弓の歌をユダの子らに教えるように命じた。これはヤシャルの書にしるされている。","tok":[["この"],["弓","ゆみ"],["の"],["歌","うた"],["を"],["ユダ"],["の"],["子","こ"],["ら"],["に"],["教える","おしえる"],["よう"],["に"],["命じた","めいじた"],["。"],["これ"],["は"],["ヤシャル"],["の"],["書","しょ"],["に"],["しるされて"],["いる"],["。"]]},{"verse":19,"text":"「イスラエルの誉れは、おまえの高き所で殺された。／ああ、勇士たちは倒れた。","tok":[["「"],["イスラエル"],["の"],["誉れ","ほまれ"],["は"],["、"],["おまえ"],["の"],["高き","たかき"],["所","ところ"],["で"],["殺された","ころされた"],["。"],["／"],["ああ"],["、"],["勇士","ゆうし"],["たち"],["は"],["倒れた","たおれた"],["。"]]},{"verse":20,"text":"これをガテに告げるな。／アシュケロンのちまたに告げ知らせるな。／ペリシテ人の娘らを喜ばせないために。／割礼のない者の娘らを勝ち誇らせないために。","tok":[["これ"],["を"],["ガテ"],["に"],["告げる","つげる"],["な"],["。"],["／"],["アシュケロン"],["の"],["ちまた"],["に"],["告げ知らせる","つげしらせる"],["な"],["。"],["／"],["ペリシテ"],["人","にん"],["の"],["娘","むすめ"],["ら"],["を"],["喜ばせない","よろこばせない"],["ため"],["に"],["。"],["／"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["の"],["娘","むすめ"],["ら"],["を"],["勝ち誇らせない","かちほこらせない"],["ため"],["に"],["。"]]},{"verse":21,"text":"ギルボアの山々よ。／お前たちの上に、露は降りるな。雨も降るな。／いけにえがささげられた野の上にも。／そこでは勇士たちの盾は汚され、サウルの盾に油も塗られなかった。","tok":[["ギルボア"],["の"],["山々","やまやま"],["よ"],["。"],["／"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["、"],["露","ろ"],["は"],["降りる","おりる"],["な"],["。"],["雨","あめ"],["も"],["降る","ふる"],["な"],["。"],["／"],["いけにえ"],["が"],["ささげられた"],["野","の"],["の"],["上","うえ"],["に"],["も"],["。"],["／"],["そこ"],["で"],["は"],["勇士","ゆうし"],["たち"],["の"],["盾","たて"],["は"],["汚され","よごされ"],["、"],["サウル"],["の"],["盾","たて"],["に"],["油","あぶら"],["も"],["塗られなかった","ぬられなかった"],["。"]]},{"verse":22,"text":"ただ、殺された者の血、勇士たちのあぶらのほかは。／ヨナタンの弓は、退いたことがなく、サウルの剣は、むなしく帰ったことがなかった。","tok":[["ただ"],["、"],["殺された","ころされた"],["者","もの"],["の"],["血","ち"],["、"],["勇士","ゆうし"],["たち"],["の"],["あぶら"],["の"],["ほか"],["は"],["。"],["／"],["ヨナタン"],["の"],["弓","ゆみ"],["は"],["、"],["退いた","しりぞいた"],["こと"],["が"],["なく"],["、"],["サウル"],["の"],["剣","けん"],["は"],["、"],["むなしく"],["帰った","かえった"],["こと"],["が"],["なかった"],["。"]]},{"verse":23,"text":"サウルもヨナタンも、愛される、りっぱな人だった。／生きているときにも、死ぬときにも離れることなく、鷲よりも速く、雄獅子よりも強かった。","tok":[["サウル"],["も"],["ヨナタン"],["も"],["、"],["愛される","あいされる"],["、"],["りっぱ"],["な"],["人","ひと"],["だった"],["。"],["／"],["生きて","いきて"],["いる"],["とき"],["に"],["も"],["、"],["死ぬ","しぬ"],["とき"],["に"],["も"],["離れる","はなれる"],["こと"],["なく"],["、"],["鷲","わし"],["より"],["も"],["速く","はやく"],["、"],["雄","ゆう"],["獅子","しし"],["より"],["も"],["強かった","つよかった"],["。"]]},{"verse":24,"text":"イスラエルの娘らよ。／サウルのために泣け。／サウルは紅の薄絹をおまえたちにまとわせ、おまえたちの装いに金の飾りをつけてくれた。","tok":[["イスラエル"],["の"],["娘","むすめ"],["ら"],["よ"],["。"],["／"],["サウル"],["の"],["ため"],["に"],["泣け","なけ"],["。"],["／"],["サウル"],["は"],["紅","くれない"],["の"],["薄絹","うすぎぬ"],["を"],["おまえ"],["たち"],["に"],["まとわせ"],["、"],["おまえ"],["たち"],["の"],["装い","よそおい"],["に"],["金","かね"],["の"],["飾り","かざり"],["を"],["つけて"],["くれた"],["。"]]},{"verse":25,"text":"ああ、勇士たちは戦いのさなかに倒れた。／ヨナタンはおまえの高き所で殺された。","tok":[["ああ"],["、"],["勇士","ゆうし"],["たち"],["は"],["戦い","たたかい"],["の"],["さなか"],["に"],["倒れた","たおれた"],["。"],["／"],["ヨナタン"],["は"],["おまえ"],["の"],["高き","たかき"],["所","ところ"],["で"],["殺された","ころされた"],["。"]]},{"verse":26,"text":"あなたのために私は悲しむ。／私の兄弟ヨナタンよ。／あなたは私を大いに喜ばせ、あなたの私への愛は、女の愛にもまさって、すばらしかった。","tok":[["あなた"],["の"],["ため"],["に"],["私","わたくし"],["は"],["悲しむ","かなしむ"],["。"],["／"],["私","わたくし"],["の"],["兄弟","きょうだい"],["ヨナタン"],["よ"],["。"],["／"],["あなた"],["は"],["私","わたくし"],["を"],["大いに","おおいに"],["喜ばせ","よろこばせ"],["、"],["あなた"],["の"],["私","わたくし"],["へ"],["の"],["愛","あい"],["は"],["、"],["女","おんな"],["の"],["愛","あい"],["に"],["も"],["まさって"],["、"],["すばらしかった"],["。"]]},{"verse":27,"text":"ああ、勇士たちは倒れた。／戦いの器はうせた。」","tok":[["ああ"],["、"],["勇士","ゆうし"],["たち"],["は"],["倒れた","たおれた"],["。"],["／"],["戦い","たたかい"],["の"],["器","うつわ"],["は"],["うせた"],["。"],["」"]]}]
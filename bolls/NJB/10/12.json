[{"verse":1,"text":"主がナタンをダビデのところに遣わされたので、彼はダビデのところに来て言った。「ある町にふたりの人がいました。ひとりは富んでいる人、ひとりは貧しい人でした。","tok":[["主","ぬし"],["が"],["ナタン"],["を"],["ダビデ"],["の"],["ところ"],["に"],["遣わされた","つかわされた"],["ので"],["、"],["彼","かれ"],["は"],["ダビデ"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["ある"],["町","まち"],["に"],["ふたり"],["の"],["人","ひと"],["が"],["いました"],["。"],["ひとり"],["は"],["富んで","とんで"],["いる"],["人","ひと"],["、"],["ひとり"],["は"],["貧しい","まずしい"],["人","ひと"],["でした"],["。"]]},{"verse":2,"text":"富んでいる人には、非常に多くの羊と牛の群れがいますが、","tok":[["富んで","とんで"],["いる"],["人","ひと"],["に"],["は"],["、"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["羊","ひつじ"],["と"],["牛","うし"],["の"],["群れ","むれ"],["が"],["います"],["が"],["、"]]},{"verse":3,"text":"貧しい人は、自分で買って来て育てた一頭の小さな雌の子羊のほかは、何も持っていませんでした。子羊は彼とその子どもたちといっしょに暮らし、彼と同じ食物を食べ、同じ杯から飲み、彼のふところでやすみ、まるで彼の娘のようでした。","tok":[["貧しい","まずしい"],["人","ひと"],["は"],["、"],["自分","じぶん"],["で"],["買って","かって"],["来て","きて"],["育てた","そだてた"],["一頭","いちとう"],["の"],["小さな","ちいさな"],["雌","めす"],["の"],["子羊","こひつじ"],["の"],["ほか"],["は"],["、"],["何","なん"],["も"],["持って","もって"],["いませんでした"],["。"],["子羊","こひつじ"],["は"],["彼","かれ"],["と"],["その"],["子ども","こども"],["たち"],["と"],["いっしょ"],["に"],["暮らし","くらし"],["、"],["彼","かれ"],["と"],["同じ","おなじ"],["食物","しょくもつ"],["を"],["食べ","たべ"],["、"],["同じ","おなじ"],["杯","さかずき"],["から"],["飲み","のみ"],["、"],["彼","かれ"],["の"],["ふところ"],["で"],["やすみ"],["、"],["まるで"],["彼","かれ"],["の"],["娘","むすめ"],["の"],["よう"],["でした"],["。"]]},{"verse":4,"text":"あるとき、富んでいる人のところにひとりの旅人が来ました。彼は自分のところに来た旅人のために自分の羊や牛の群れから取って調理するのを惜しみ、貧しい人の雌の子羊を取り上げて、自分のところに来た人のために調理しました。」","tok":[["ある"],["とき"],["、"],["富んで","とんで"],["いる"],["人","ひと"],["の"],["ところ"],["に"],["ひとり"],["の"],["旅人","たびびと"],["が"],["来ました","きました"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["ところ"],["に"],["来た","きた"],["旅人","たびびと"],["の"],["ため"],["に"],["自分","じぶん"],["の"],["羊","ひつじ"],["や"],["牛","うし"],["の"],["群れ","むれ"],["から"],["取って","とって"],["調理","ちょうり"],["する"],["の"],["を"],["惜しみ","おしみ"],["、"],["貧しい","まずしい"],["人","ひと"],["の"],["雌","めす"],["の"],["子羊","こひつじ"],["を"],["取り上げて","とりあげて"],["、"],["自分","じぶん"],["の"],["ところ"],["に"],["来た","きた"],["人","ひと"],["の"],["ため"],["に"],["調理","ちょうり"],["しました"],["。"],["」"]]},{"verse":5,"text":"すると、ダビデは、その男に対して激しい怒りを燃やし、ナタンに言った。「主は生きておられる。そんなことをした男は死刑だ。","tok":[["する"],["と"],["、"],["ダビデ"],["は"],["、"],["その"],["男","おとこ"],["に対して","にたいして"],["激しい","はげしい"],["怒り","いかり"],["を"],["燃やし","もやし"],["、"],["ナタン"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["そんな"],["こと"],["を"],["した"],["男","おとこ"],["は"],["死刑","しけい"],["だ"],["。"]]},{"verse":6,"text":"その男は、あわれみの心もなく、そんなことをしたのだから、その雌の子羊を四倍にして償わなければならない。」","tok":[["その"],["男","おとこ"],["は"],["、"],["あわれみ"],["の"],["心","こころ"],["も"],["なく"],["、"],["そんな"],["こと"],["を"],["した"],["の"],["だ"],["から"],["、"],["その"],["雌","めす"],["の"],["子羊","こひつじ"],["を"],["四","よん"],["倍","ばい"],["に"],["して"],["償わなければ","つぐなわなければ"],["ならない"],["。"],["」"]]},{"verse":7,"text":"ナタンはダビデに言った。「あなたがその男です。イスラエルの神、主はこう仰せられる。『わたしはあなたに油をそそいで、イスラエルの王とし、サウルの手からあなたを救い出した。","tok":[["ナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["その"],["男","おとこ"],["です"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["そそいで"],["、"],["イスラエル"],["の"],["王","おう"],["と"],["し"],["、"],["サウル"],["の"],["手","て"],["から"],["あなた"],["を"],["救い出した","すくいだした"],["。"]]},{"verse":8,"text":"さらに、あなたの主人の家を与え、あなたの主人の妻たちをあなたのふところに渡し、イスラエルとユダの家も与えた。それでも少ないというのなら、わたしはあなたにもっと多くのものを増し加えたであろう。","tok":[["さらに"],["、"],["あなた"],["の"],["主人","しゅじん"],["の"],["家","いえ"],["を"],["与え","あたえ"],["、"],["あなた"],["の"],["主人","しゅじん"],["の"],["妻たち","つまたち"],["を"],["あなた"],["の"],["ふところ"],["に"],["渡し","わたし"],["、"],["イスラエル"],["と"],["ユダ"],["の"],["家","いえ"],["も"],["与えた","あたえた"],["。"],["それ"],["で"],["も"],["少ない","すくない"],["と"],["いう"],["の"],["なら"],["、"],["わたし"],["は"],["あなた"],["に"],["もっと"],["多く","おおく"],["の"],["もの"],["を"],["増し加えたで","ましくわえたで"],["あろう"],["。"]]},{"verse":9,"text":"それなのに、どうしてあなたは主のことばをさげすみ、わたしの目の前に悪を行ったのか。あなたはヘテ人ウリヤを剣で打ち、その妻を自分の妻にした。あなたが彼をアモン人の剣で切り殺したのだ。","tok":[["それ"],["な"],["のに"],["、"],["どう"],["して"],["あなた"],["は"],["主","ぬし"],["の"],["ことば"],["を"],["さげすみ"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行った","おこなった"],["の"],["か"],["。"],["あなた"],["は"],["ヘテ人","へてにん"],["ウリヤ"],["を"],["剣","けん"],["で"],["打ち","うち"],["、"],["その"],["妻","つま"],["を"],["自分","じぶん"],["の"],["妻","つま"],["に"],["した"],["。"],["あなた"],["が"],["彼","かれ"],["を"],["アモン人","あもんにん"],["の"],["剣","けん"],["で"],["切り殺した","きりころした"],["の"],["だ"],["。"]]},{"verse":10,"text":"今や剣は、いつまでもあなたの家から離れない。あなたがわたしをさげすみ、ヘテ人ウリヤの妻を取り、自分の妻にしたからである。』","tok":[["今","いま"],["や"],["剣","けん"],["は"],["、"],["いつ"],["まで"],["も"],["あなた"],["の"],["家","いえ"],["から"],["離れない","はなれない"],["。"],["あなた"],["が"],["わたし"],["を"],["さげすみ"],["、"],["ヘテ人","へてにん"],["ウリヤ"],["の"],["妻","つま"],["を"],["取り","とり"],["、"],["自分","じぶん"],["の"],["妻","つま"],["に"],["した"],["から"],["で"],["ある"],["。"],["』"]]},{"verse":11,"text":"主はこう仰せられる。『聞け。わたしはあなたの家の中から、あなたの上にわざわいを引き起こす。あなたの妻たちをあなたの目の前で取り上げ、あなたの友に与えよう。その人は、白昼公然と、あなたの妻たちと寝るようになる。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["聞け","きけ"],["。"],["わたし"],["は"],["あなた"],["の"],["家","いえ"],["の"],["中","なか"],["から"],["、"],["あなた"],["の"],["上","うえ"],["に"],["わざわい"],["を"],["引き起こす","ひきおこす"],["。"],["あなた"],["の"],["妻たち","つまたち"],["を"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["取り上げ","とりあげ"],["、"],["あなた"],["の"],["友","とも"],["に"],["与えよう","あたえよう"],["。"],["その"],["人","ひと"],["は"],["、"],["白昼","はくちゅう"],["公然","こうぜん"],["と"],["、"],["あなた"],["の"],["妻たち","つまたち"],["と"],["寝る","ねる"],["よう"],["に"],["なる"],["。"]]},{"verse":12,"text":"あなたは隠れて、それをしたが、わたしはイスラエル全部の前で、太陽の前で、このことを行おう。』」","tok":[["あなた"],["は"],["隠れて","かくれて"],["、"],["それ"],["を"],["した"],["が"],["、"],["わたし"],["は"],["イスラエル"],["全部","ぜんぶ"],["の"],["前","まえ"],["で"],["、"],["太陽","たいよう"],["の"],["前","まえ"],["で"],["、"],["この"],["こと"],["を"],["行おう","おこなおう"],["。"],["』"],["」"]]},{"verse":13,"text":"ダビデはナタンに言った。「私は主に対して罪を犯した。」ナタンはダビデに言った。「主もまた、あなたの罪を見過ごしてくださった。あなたは死なない。","tok":[["ダビデ"],["は"],["ナタン"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["主に","おもに"],["対して","たいして"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["」"],["ナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["も"],["また"],["、"],["あなた"],["の"],["罪","つみ"],["を"],["見過ごして","みすごして"],["くださった"],["。"],["あなた"],["は"],["死なない","しなない"],["。"]]},{"verse":14,"text":"しかし、あなたはこのことによって、主の敵に大いに侮りの心を起こさせたので、あなたに生まれる子は必ず死ぬ。」","tok":[["しかし"],["、"],["あなた"],["は"],["この"],["こと"],["によって"],["、"],["主","ぬし"],["の"],["敵","てき"],["に"],["大いに","おおいに"],["侮り","あなどり"],["の"],["心","こころ"],["を"],["起こさせた","おこさせた"],["ので"],["、"],["あなた"],["に"],["生まれる","うまれる"],["子","こ"],["は"],["必ず","かならず"],["死ぬ","しぬ"],["。"],["」"]]},{"verse":15,"text":"こうしてナタンは自分の家へ戻った。／主は、ウリヤの妻がダビデに産んだ子を打たれたので、その子は病気になった。","tok":[["こう"],["して"],["ナタン"],["は"],["自分","じぶん"],["の"],["家","いえ"],["へ"],["戻った","もどった"],["。"],["／"],["主","ぬし"],["は"],["、"],["ウリヤ"],["の"],["妻","つま"],["が"],["ダビデ"],["に"],["産んだ","うんだ"],["子","こ"],["を"],["打たれた","うたれた"],["ので"],["、"],["その"],["子","こ"],["は"],["病気","びょうき"],["に"],["なった"],["。"]]},{"verse":16,"text":"ダビデはその子のために神に願い求め、断食をして、引きこもり、一晩中、地に伏していた。","tok":[["ダビデ"],["は"],["その"],["子","こ"],["の"],["ため"],["に"],["神","かみ"],["に"],["願い求め","ねがいもとめ"],["、"],["断食","だんじき"],["を"],["して"],["、"],["引きこもり","ひきこもり"],["、"],["一","いち"],["晩中","ばんちゅう"],["、"],["地","ち"],["に"],["伏して","ふして"],["いた"],["。"]]},{"verse":17,"text":"彼の家の長老たちは彼のそばに立って、彼を地から起こそうとしたが、ダビデは起きようともせず、彼らといっしょに食事を取ろうともしなかった。","tok":[["彼","かれ"],["の"],["家","いえ"],["の"],["長老","ちょうろう"],["たち"],["は"],["彼","かれ"],["の"],["そば"],["に"],["立って","たって"],["、"],["彼","かれ"],["を"],["地","ち"],["から"],["起こそう","おこそう"],["と"],["した"],["が"],["、"],["ダビデ"],["は"],["起きよう","おきよう"],["と"],["も"],["せず"],["、"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["取ろう","とろう"],["と"],["も"],["しなかった"],["。"]]},{"verse":18,"text":"七日目に子どもは死んだが、ダビデの家来たちは、その子が死んだことをダビデに告げるのを恐れた。「王はあの子が生きている時、われわれが話しても、言うことを聞かなかった。どうしてあの子が死んだことを王に言えようか。王は何か悪い事をされるかもしれない」と彼らが思ったからである。","tok":[["七日目","ななかめ"],["に"],["子ども","こども"],["は"],["死んだ","しんだ"],["が"],["、"],["ダビデ"],["の"],["家来","けらい"],["たち"],["は"],["、"],["その"],["子","こ"],["が"],["死んだ","しんだ"],["こと"],["を"],["ダビデ"],["に"],["告げる","つげる"],["の"],["を"],["恐れた","おそれた"],["。"],["「"],["王","おう"],["は"],["あの"],["子","こ"],["が"],["生きて","いきて"],["いる"],["時","とき"],["、"],["われわれ"],["が"],["話して","はなして"],["も"],["、"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"],["どう"],["して"],["あの"],["子","こ"],["が"],["死んだ","しんだ"],["こと"],["を"],["王","おう"],["に"],["言えよう","いえよう"],["か"],["。"],["王","おう"],["は"],["何","なん"],["か"],["悪い","わるい"],["事","こと"],["を"],["される"],["か"],["も"],["しれない"],["」"],["と"],["彼","かれ"],["ら"],["が"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"しかしダビデは、家来たちがひそひそ話し合っているのを見て、子どもが死んだことを悟った。それでダビデは家来たちに言った。「子どもは死んだのか。」彼らは言った。「なくなられました。」","tok":[["しかし"],["ダビデ"],["は"],["、"],["家来","けらい"],["たち"],["が"],["ひそひそ"],["話し合って","はなしあって"],["いる"],["の"],["を"],["見て","みて"],["、"],["子ども","こども"],["が"],["死んだ","しんだ"],["こと"],["を"],["悟った","さとった"],["。"],["それ"],["で"],["ダビデ"],["は"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["子ども","こども"],["は"],["死んだ","しんだ"],["の"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["なくなられました"],["。"],["」"]]},{"verse":20,"text":"するとダビデは地から起き上がり、からだを洗って身に油を塗り、着物を着替えて、主の宮に入り、礼拝をしてから、自分の家へ帰った。そして食事の用意をさせて、食事をとった。","tok":[["する"],["と"],["ダビデ"],["は"],["地","ち"],["から"],["起き上がり","おきあがり"],["、"],["からだ"],["を"],["洗って","あらって"],["身","み"],["に"],["油","あぶら"],["を"],["塗り","ぬり"],["、"],["着物","きもの"],["を"],["着替えて","きがえて"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["入り","はいり"],["、"],["礼拝","れいはい"],["を"],["して"],["から"],["、"],["自分","じぶん"],["の"],["家","いえ"],["へ"],["帰った","かえった"],["。"],["そして"],["食事","しょくじ"],["の"],["用意","ようい"],["を"],["させて"],["、"],["食事","しょくじ"],["を"],["とった"],["。"]]},{"verse":21,"text":"すると家来たちが彼に言った。「あなたのなさったこのことは、いったいどういうことですか。お子さまが生きておられる時は断食をして泣かれたのに、お子さまがなくなられると、起き上がり、食事をなさるとは。」","tok":[["する"],["と"],["家来","けらい"],["たち"],["が"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["なさった"],["この"],["こと"],["は"],["、"],["いったい"],["どういう"],["こと"],["です"],["か"],["。"],["お子さま","おこさま"],["が"],["生きて","いきて"],["おられる"],["時","とき"],["は"],["断食","だんじき"],["を"],["して"],["泣かれた","なかれた"],["のに"],["、"],["お子さま","おこさま"],["が"],["なくなられる"],["と"],["、"],["起き上がり","おきあがり"],["、"],["食事","しょくじ"],["を"],["なさる"],["と"],["は"],["。"],["」"]]},{"verse":22,"text":"ダビデは言った。「子どもがまだ生きている時に私が断食をして泣いたのは、もしかすると、主が私をあわれみ、子どもが生きるかもしれない、と思ったからだ。","tok":[["ダビデ"],["は"],["言った","いった"],["。"],["「"],["子ども","こども"],["が"],["まだ"],["生きて","いきて"],["いる"],["時","とき"],["に"],["私","わたくし"],["が"],["断食","だんじき"],["を"],["して"],["泣いた","ないた"],["の"],["は"],["、"],["もし"],["か"],["する"],["と"],["、"],["主","ぬし"],["が"],["私","わたくし"],["を"],["あわれみ"],["、"],["子ども","こども"],["が"],["生きる","いきる"],["か"],["も"],["しれない"],["、"],["と"],["思った","おもった"],["から"],["だ"],["。"]]},{"verse":23,"text":"しかし今、子どもは死んでしまった。私はなぜ、断食をしなければならないのか。あの子をもう一度、呼び戻せるであろうか。私はあの子のところに行くだろうが、あの子は私のところに戻っては来ない。」","tok":[["しかし"],["今","いま"],["、"],["子ども","こども"],["は"],["死んで","しんで"],["しまった"],["。"],["私","わたくし"],["は"],["なぜ"],["、"],["断食","だんじき"],["を"],["しなければ"],["ならない"],["の"],["か"],["。"],["あの"],["子","こ"],["を"],["もう"],["一度","いちど"],["、"],["呼び戻せるで","よびもどせるで"],["あろう"],["か"],["。"],["私","わたくし"],["は"],["あの"],["子","こ"],["の"],["ところ"],["に"],["行くだろう","いくだろう"],["が"],["、"],["あの"],["子","こ"],["は"],["私","わたくし"],["の"],["ところ"],["に"],["戻って","もどって"],["は"],["来ない","こない"],["。"],["」"]]},{"verse":24,"text":"ダビデは妻バテ・シェバを慰め、彼女のところに入り、彼女と寝た。彼女が男の子を産んだとき、彼はその名をソロモンと名づけた。主はその子を愛されたので、","tok":[["ダビデ"],["は"],["妻","つま"],["バテ"],["・"],["シェバ"],["を"],["慰め","なぐさめ"],["、"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入り","はいり"],["、"],["彼女","かのじょ"],["と"],["寝た","ねた"],["。"],["彼女","かのじょ"],["が"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["とき"],["、"],["彼","かれ"],["は"],["その"],["名","な"],["を"],["ソロモン"],["と"],["名づけた","なづけた"],["。"],["主","ぬし"],["は"],["その"],["子","こ"],["を"],["愛された","あいされた"],["ので"],["、"]]},{"verse":25,"text":"預言者ナタンを遣わして、主のために、その名をエディデヤと名づけさせた。","tok":[["預言者","よげんしゃ"],["ナタン"],["を"],["遣わして","つかわして"],["、"],["主","ぬし"],["の"],["ため"],["に"],["、"],["その"],["名","な"],["を"],["エディデヤ"],["と"],["名づけさせた","なづけさせた"],["。"]]},{"verse":26,"text":"さて、ヨアブはアモン人のラバと戦い、この王の町を攻め取った。","tok":[["さて"],["、"],["ヨアブ"],["は"],["アモン人","あもんにん"],["の"],["ラバ"],["と"],["戦い","たたかい"],["、"],["この"],["王","おう"],["の"],["町","まち"],["を"],["攻め取った","せめとった"],["。"]]},{"verse":27,"text":"ヨアブはダビデに使者を送って言った。「私はラバと戦って、水の町を攻め取りました。","tok":[["ヨアブ"],["は"],["ダビデ"],["に"],["使者","ししゃ"],["を"],["送って","おくって"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["ラバ"],["と"],["戦って","たたかって"],["、"],["水","みず"],["の"],["町","まち"],["を"],["攻め取りました","せめとりました"],["。"]]},{"verse":28,"text":"しかし今、民の残りの者たちを集めて、この町に対して陣を敷き、あなたがこれを攻め取ってください。私がこの町を取り、この町に私の名がつけられるといけませんから。」","tok":[["しかし"],["今","いま"],["、"],["民","みん"],["の"],["残り","のこり"],["の"],["者","もの"],["たち"],["を"],["集めて","あつめて"],["、"],["この"],["町","まち"],["に対して","にたいして"],["陣","じん"],["を"],["敷き","しき"],["、"],["あなた"],["が"],["これ"],["を"],["攻め取って","せめとって"],["ください"],["。"],["私","わたくし"],["が"],["この"],["町","まち"],["を"],["取り","とり"],["、"],["この"],["町","まち"],["に"],["私","わたくし"],["の"],["名","な"],["が"],["つけられる"],["と"],["いけません"],["から"],["。"],["」"]]},{"verse":29,"text":"そこでダビデは民のすべてを集めて、ラバに進んで行き、これと戦って、攻め取った。","tok":[["そこ"],["で"],["ダビデ"],["は"],["民","みん"],["の"],["すべて"],["を"],["集めて","あつめて"],["、"],["ラバ"],["に"],["進んで","すすんで"],["行き","いき"],["、"],["これ"],["と"],["戦って","たたかって"],["、"],["攻め取った","せめとった"],["。"]]},{"verse":30,"text":"彼は彼らの王の冠をその頭から取った。その重さは金一タラントで、宝石がはめ込まれていた。その冠はダビデの頭に置かれた。彼はまた、その町から非常に多くの分捕り物を持ってきた。","tok":[["彼","かれ"],["は"],["彼","かれ"],["ら"],["の"],["王","おう"],["の"],["冠","かんむり"],["を"],["その"],["頭","あたま"],["から"],["取った","とった"],["。"],["その"],["重さ","おもさ"],["は"],["金","きん"],["一","いち"],["タラント"],["で"],["、"],["宝石","ほうせき"],["が"],["はめ込まれて","はめこまれて"],["いた"],["。"],["その"],["冠","かんむり"],["は"],["ダビデ"],["の"],["頭","あたま"],["に"],["置かれた","おかれた"],["。"],["彼","かれ"],["は"],["また"],["、"],["その"],["町","まち"],["から"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["分","ぶん"],["捕り物","とりもの"],["を"],["持って","もって"],["きた"],["。"]]},{"verse":31,"text":"彼はその町の人々を連れてきて、石のこぎりや、鉄のつるはし、鉄の斧を使う仕事につかせ、れんが作りの仕事をさせた。ダビデはアモン人のすべての町々に対して、このようにした。こうして、ダビデと民のすべてはエルサレムに帰った。","tok":[["彼","かれ"],["は"],["その"],["町","まち"],["の"],["人々","ひとびと"],["を"],["連れて","つれて"],["きて"],["、"],["石","いし"],["のこぎり"],["や"],["、"],["鉄","てつ"],["の"],["つるはし"],["、"],["鉄","てつ"],["の"],["斧","おの"],["を"],["使う","つかう"],["仕事",
[{"verse":1,"text":"年が改まり、王たちが出陣するころ、ダビデは、ヨアブと自分の家来たちとイスラエルの全軍とを戦いに出した。彼らはアモン人を滅ぼし、ラバを包囲した。しかしダビデはエルサレムにとどまっていた。","tok":[["年","ねん"],["が"],["改まり","あらたまり"],["、"],["王","おう"],["たち"],["が"],["出陣","しゅつじん"],["する"],["ころ"],["、"],["ダビデ"],["は"],["、"],["ヨアブ"],["と"],["自分","じぶん"],["の"],["家来","けらい"],["たち"],["と"],["イスラエル"],["の"],["全軍","ぜんぐん"],["と"],["を"],["戦い","たたかい"],["に"],["出した","だした"],["。"],["彼","かれ"],["ら"],["は"],["アモン人","あもんにん"],["を"],["滅ぼし","ほろぼし"],["、"],["ラバ"],["を"],["包囲","ほうい"],["した"],["。"],["しかし"],["ダビデ"],["は"],["エルサレム"],["に"],["とどまって"],["いた"],["。"]]},{"verse":2,"text":"ある夕暮れ時、ダビデは床から起き上がり、王宮の屋上を歩いていると、ひとりの女が、からだを洗っているのが屋上から見えた。その女は非常に美しかった。","tok":[["ある"],["夕暮れ","ゆうぐれ"],["時","とき"],["、"],["ダビデ"],["は"],["床","ゆか"],["から"],["起き上がり","おきあがり"],["、"],["王宮","おうきゅう"],["の"],["屋上","おくじょう"],["を"],["歩いて","あるいて"],["いる"],["と"],["、"],["ひとり"],["の"],["女","おんな"],["が"],["、"],["からだ"],["を"],["洗って","あらって"],["いる"],["の"],["が"],["屋上","おくじょう"],["から"],["見えた","みえた"],["。"],["その"],["女","おんな"],["は"],["非常","ひじょう"],["に"],["美しかった","うつくしかった"],["。"]]},{"verse":3,"text":"ダビデは人をやって、その女について調べたところ、「あれはヘテ人ウリヤの妻で、エリアムの娘バテ・シェバではありませんか」との報告を受けた。","tok":[["ダビデ"],["は"],["人","ひと"],["を"],["やって"],["、"],["その"],["女","おんな"],["について"],["調べた","しらべた"],["ところ"],["、"],["「"],["あれ"],["は"],["ヘテ人","へてにん"],["ウリヤ"],["の"],["妻","つま"],["で"],["、"],["エリアム"],["の"],["娘","むすめ"],["バテ"],["・"],["シェバ"],["で"],["は"],["ありません"],["か"],["」"],["と"],["の"],["報告","ほうこく"],["を"],["受けた","うけた"],["。"]]},{"verse":4,"text":"ダビデは使いの者をやって、その女を召し入れた。女が彼のところに来たので、彼はその女と寝た。――その女は月のものの汚れをきよめていた――それから女は自分の家へ帰った。","tok":[["ダビデ"],["は"],["使い","つかい"],["の"],["者","もの"],["を"],["やって"],["、"],["その"],["女","おんな"],["を"],["召し入れた","めしいれた"],["。"],["女","おんな"],["が"],["彼","かれ"],["の"],["ところ"],["に"],["来た","きた"],["ので"],["、"],["彼","かれ"],["は"],["その"],["女","おんな"],["と"],["寝た","ねた"],["。"],["―"],["―"],["その"],["女","おんな"],["は"],["月","つき"],["の"],["もの"],["の"],["汚れ","よごれ"],["を"],["きよめて"],["いた"],["―"],["―"],["それ"],["から"],["女","おんな"],["は"],["自分","じぶん"],["の"],["家","いえ"],["へ"],["帰った","かえった"],["。"]]},{"verse":5,"text":"女はみごもったので、ダビデに人をやって、告げて言った。「私はみごもりました。」","tok":[["女","おんな"],["は"],["みごもった"],["ので"],["、"],["ダビデ"],["に"],["人","ひと"],["を"],["やって"],["、"],["告げて","つげて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["みごもりました"],["。"],["」"]]},{"verse":6,"text":"ダビデはヨアブのところに人をやって、「ヘテ人ウリヤを私のところに送れ」と言わせた。それでヨアブはウリヤをダビデのところに送った。","tok":[["ダビデ"],["は"],["ヨアブ"],["の"],["ところ"],["に"],["人","ひと"],["を"],["やって"],["、"],["「"],["ヘテ人","へてにん"],["ウリヤ"],["を"],["私","わたくし"],["の"],["ところ"],["に"],["送れ","おくれ"],["」"],["と"],["言わせた","いわせた"],["。"],["それ"],["で"],["ヨアブ"],["は"],["ウリヤ"],["を"],["ダビデ"],["の"],["ところ"],["に"],["送った","おくった"],["。"]]},{"verse":7,"text":"ウリヤが彼のところに入って来ると、ダビデは、ヨアブは無事でいるか、兵士たちも変わりないか、戦いもうまくいっているか、と尋ねた。","tok":[["ウリヤ"],["が"],["彼","かれ"],["の"],["ところ"],["に"],["入って","はいって"],["来る","くる"],["と"],["、"],["ダビデ"],["は"],["、"],["ヨアブ"],["は"],["無事","ぶじ"],["で"],["いる"],["か"],["、"],["兵士","へいし"],["たち"],["も"],["変わり","かわり"],["ない"],["か"],["、"],["戦い","たたかい"],["も"],["うまく"],["いって"],["いる"],["か"],["、"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":8,"text":"それからダビデはウリヤに言った。「家に帰って、あなたの足を洗いなさい。」ウリヤが王宮から出て行くと、王からの贈り物が彼のあとに続いた。","tok":[["それ"],["から"],["ダビデ"],["は"],["ウリヤ"],["に"],["言った","いった"],["。"],["「"],["家","いえ"],["に"],["帰って","かえって"],["、"],["あなた"],["の"],["足","あし"],["を"],["洗い","あらい"],["なさい"],["。"],["」"],["ウリヤ"],["が"],["王宮","おうきゅう"],["から"],["出て","でて"],["行く","いく"],["と"],["、"],["王","おう"],["から"],["の"],["贈り物","おくりもの"],["が"],["彼","かれ"],["の"],["あと"],["に"],["続いた","つづいた"],["。"]]},{"verse":9,"text":"しかしウリヤは、王宮の門のあたりで、自分の主君の家来たちみなといっしょに眠り、自分の家には帰らなかった。","tok":[["しかし"],["ウリヤ"],["は"],["、"],["王宮","おうきゅう"],["の"],["門","もん"],["の"],["あたり"],["で"],["、"],["自分","じぶん"],["の"],["主君","しゅくん"],["の"],["家来","けらい"],["たち"],["みなと"],["いっしょ"],["に"],["眠り","ねむり"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["は"],["帰らなかった","かえらなかった"],["。"]]},{"verse":10,"text":"ダビデは、ウリヤが自分の家には帰らなかった、という知らせを聞いて、ウリヤに言った。「あなたは遠征して来たのではないか。なぜ、自分の家に帰らなかったのか。」","tok":[["ダビデ"],["は"],["、"],["ウリヤ"],["が"],["自分","じぶん"],["の"],["家","いえ"],["に"],["は"],["帰らなかった","かえらなかった"],["、"],["と"],["いう"],["知らせ","しらせ"],["を"],["聞いて","きいて"],["、"],["ウリヤ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["遠征","えんせい"],["して"],["来た","きた"],["ので"],["は"],["ない"],["か"],["。"],["なぜ"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰らなかった","かえらなかった"],["の"],["か"],["。"],["」"]]},{"verse":11,"text":"ウリヤはダビデに言った。「神の箱も、イスラエルも、ユダも仮庵に住み、私の主人ヨアブも、私の主人の家来たちも戦場で野営しています。それなのに、私だけが家に帰り、飲み食いして、妻と寝ることができましょうか。あなたの前に、あなたのたましいの前に誓います。私は決してそのようなことをいたしません。」","tok":[["ウリヤ"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["の"],["箱","ばこ"],["も"],["、"],["イスラエル"],["も"],["、"],["ユダ"],["も"],["仮庵","かりあん"],["に"],["住み","すみ"],["、"],["私","わたくし"],["の"],["主人","しゅじん"],["ヨアブ"],["も"],["、"],["私","わたくし"],["の"],["主人","しゅじん"],["の"],["家来","けらい"],["たち"],["も"],["戦場","せんじょう"],["で"],["野営","やえい"],["して"],["います"],["。"],["それ"],["な"],["のに"],["、"],["私","わたくし"],["だけ"],["が"],["家","いえ"],["に"],["帰り","かえり"],["、"],["飲み食い","のみくい"],["して"],["、"],["妻","つま"],["と"],["寝る","ねる"],["こと"],["が"],["できましょう"],["か"],["。"],["あなた"],["の"],["前","まえ"],["に"],["、"],["あなた"],["の"],["たましい"],["の"],["前","まえ"],["に"],["誓います","ちかいます"],["。"],["私","わたくし"],["は"],["決して","けっして"],["その"],["よう"],["な"],["こと"],["を"],["いたしません"],["。"],["」"]]},{"verse":12,"text":"ダビデはウリヤに言った。「では、きょうもここにとどまるがよい。あすになったらあなたを送り出そう。」それでウリヤはその日と翌日エルサレムにとどまることになった。","tok":[["ダビデ"],["は"],["ウリヤ"],["に"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["きょう"],["も"],["ここ"],["に"],["とどまる"],["が"],["よい"],["。"],["あす"],["に"],["なったら"],["あなた"],["を"],["送り出そう","おくりだそう"],["。"],["」"],["それ"],["で"],["ウリヤ"],["は"],["その"],["日","ひ"],["と"],["翌日","よくじつ"],["エルサレム"],["に"],["とどまる"],["こと"],["に"],["なった"],["。"]]},{"verse":13,"text":"ダビデは彼を招いて、自分の前で食べたり飲んだりさせ、彼を酔わせた。夕方、ウリヤは出て行って、自分の主君の家来たちといっしょに自分の寝床で寝た。そして自分の家には行かなかった。","tok":[["ダビデ"],["は"],["彼","かれ"],["を"],["招いて","まねいて"],["、"],["自分","じぶん"],["の"],["前","まえ"],["で"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["させ"],["、"],["彼","かれ"],["を"],["酔わせた","よわせた"],["。"],["夕方","ゆうがた"],["、"],["ウリヤ"],["は"],["出て","でて"],["行って","いって"],["、"],["自分","じぶん"],["の"],["主君","しゅくん"],["の"],["家来","けらい"],["たち"],["と"],["いっしょ"],["に"],["自分","じ
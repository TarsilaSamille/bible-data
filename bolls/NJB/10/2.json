[{"verse":1,"text":"この後、ダビデは主に伺って言った。「ユダの一つの町へ上って行くべきでしょうか。」すると主は彼に、「上って行け」と仰せられた。ダビデが、「どこへ上るのでしょうか」と聞くと、主は、「ヘブロンへ」と仰せられた。","tok":[["この"],["後","ご"],["、"],["ダビデ"],["は"],["主に","おもに"],["伺って","うかがって"],["言った","いった"],["。"],["「"],["ユダ"],["の"],["一","ひと"],["つ"],["の"],["町","まち"],["へ"],["上って","のぼって"],["行くべきでしょう","いくべきでしょう"],["か"],["。"],["」"],["する"],["と"],["主","ぬし"],["は"],["彼","かれ"],["に"],["、"],["「"],["上って","のぼって"],["行け","いけ"],["」"],["と"],["仰せられた","おおせられた"],["。"],["ダビデ"],["が"],["、"],["「"],["どこ"],["へ"],["上る","のぼる"],["の"],["でしょう"],["か"],["」"],["と"],["聞く","きく"],["と"],["、"],["主","ぬし"],["は"],["、"],["「"],["ヘブロン"],["へ"],["」"],["と"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"そこでダビデは、ふたりの妻、イズレエル人アヒノアムと、ナバルの妻であったカルメル人アビガイルといっしょに、そこへ上って行った。","tok":[["そこ"],["で"],["ダビデ"],["は"],["、"],["ふたり"],["の"],["妻","つま"],["、"],["イズレエル"],["人","にん"],["アヒノアム"],["と"],["、"],["ナバル"],["の"],["妻","つま"],["で"],["あった"],["カルメル"],["人","にん"],["アビガイル"],["と"],["いっしょ"],["に"],["、"],["そこ"],["へ"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":3,"text":"ダビデは、自分とともにいた人々を、その家族といっしょに連れて上った。こうして彼らはヘブロンの町々に住んだ。","tok":[["ダビデ"],["は"],["、"],["自分","じぶん"],["と"],["とも"],["に"],["いた"],["人々","ひとびと"],["を"],["、"],["その"],["家族","かぞく"],["と"],["いっしょ"],["に"],["連れて","つれて"],["上った","のぼった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["ヘブロン"],["の"],["町々","まちまち"],["に"],["住んだ","すんだ"],["。"]]},{"verse":4,"text":"そこへユダの人々がやって来て、ダビデに油をそそいでユダの家の王とした。／ヤベシュ・ギルアデの人々がサウルを葬った、ということがダビデに知らされたとき、","tok":[["そこ"],["へ"],["ユダ"],["の"],["人々","ひとびと"],["が"],["やって"],["来て","きて"],["、"],["ダビデ"],["に"],["油","あぶら"],["を"],["そそいで"],["ユダ"],["の"],["家","いえ"],["の"],["王","おう"],["と"],["した"],["。"],["／"],["ヤベシュ"],["・"],["ギルアデ"],["の"],["人々","ひとびと"],["が"],["サウル"],["を"],["葬った","ほうむった"],["、"],["と"],["いう"],["こと"],["が"],["ダビデ"],["に"],["知らされた","しらされた"],["とき"],["、"]]},{"verse":5,"text":"ダビデはヤベシュ・ギルアデの人々に使いを送り、彼らに言った。「あなたがたの主君サウルに、このような真実を尽くして、彼を葬ったあなたがたに、主の祝福があるように。","tok":[["ダビデ"],["は"],["ヤベシュ"],["・"],["ギルアデ"],["の"],["人々","ひとびと"],["に"],["使い","つかい"],["を"],["送り","おくり"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["主君","しゅくん"],["サウル"],["に"],["、"],["この"],["よう"],["な"],["真実","しんじつ"],["を"],["尽くして","つくして"],["、"],["彼","かれ"],["を"],["葬った","ほうむった"],["あなた"],["がた"],["に"],["、"],["主","ぬし"],["の"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":6,"text":"今、主があなたがたに恵みとまことを施してくださるように。この私も、あなたがたがこのようなことをしたので、善をもって報いよう。","tok":[["今","いま"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["に"],["恵み","めぐみ"],["と"],["まこと"],["を"],["施して","ほどこして"],["くださる"],["よう"],["に"],["。"],["この"],["私","わたくし"],["も"],["、"],["あなた"],["がた"],["が"],["この"],["よう"],["な"],["こと"],["を"],["した"],["ので"],["、"],["善","ぜん"],["を"],["もって"],["報いよう","むくいよう"],["。"]]},{"verse":7,"text":"さあ、強くあれ。勇気のある者となれ。あなたがたの主君サウルは死んだが、ユダの家は私に油をそそいで、彼らの王としたのだ。」","tok":[["さあ"],["、"],["強く","つよく"],["あれ"],["。"],["勇気","ゆうき"],["の"],["ある"],["者","もの"],["と"],["なれ"],["。"],["あなた"],["がた"],["の"],["主君","しゅくん"],["サウル"],["は"],["死んだ","しんだ"],["が"],["、"],["ユダ"],["の"],["家","いえ"],["は"],["私","わたくし"],["に"],["油","あぶら"],["を"],["そそいで"],["、"],["彼","かれ"],["ら"],["の"],["王","おう"],["と"],["した"],["の"],["だ"],["。"],["」"]]},{"verse":8,"text":"一方、サウルの将軍であったネルの子アブネルは、サウルの子イシュ・ボシェテをマハナイムに連れて行き、","tok":[["一方","いっぽう"],["、"],["サウル"],["の"],["将軍","しょうぐん"],["で"],["あった"],["ネル"],["の"],["子","こ"],["アブネル"],["は"],["、"],["サウル"],["の"],["子","こ"],["イシュ"],["・"],["ボシェテ"],["を"],["マハナイム"],["に"],["連れて","つれて"],["行き","いき"],["、"]]},{"verse":9,"text":"彼をギルアデ、アシュル人、イズレエル、エフライム、ベニヤミン、全イスラエルの王とした。","tok":[["彼","かれ"],["を"],["ギルアデ"],["、"],["アシュル"],["人","にん"],["、"],["イズレエル"],["、"],["エフライム"],["、"],["ベニヤミン"],["、"],["全","ぜん"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["。"]]},{"verse":10,"text":"サウルの子イシュ・ボシェテは、四十歳でイスラエルの王となり、二年間、王であった。ただ、ユダの家だけはダビデに従った。","tok":[["サウル"],["の"],["子","こ"],["イシュ"],["・"],["ボシェテ"],["は"],["、"],["四十歳","よんじゅうさい"],["で"],["イスラエル"],["の"],["王","おう"],["と"],["なり"],["、"],["二","に"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"],["ただ"],["、"],["ユダ"],["の"],["家","いえ"],["だけ"],["は"],["ダビデ"],["に"],["従った","したがった"],["。"]]},{"verse":11,"text":"ダビデがヘブロンでユダの家の王であった期間は、七年六か月であった。","tok":[["ダビデ"],["が"],["ヘブロン"],["で"],["ユダ"],["の"],["家","いえ"],["の"],["王","おう"],["で"],["あった"],["期間","きかん"],["は"],["、"],["七","なな"],["年","ねん"],["六","ろく"],["か月","かげつ"],["で"],["あった"],["。"]]},{"verse":12,"text":"ネルの子アブネルは、サウルの子イシュ・ボシェテの家来たちといっしょにマハナイムを出て、ギブオンへ向かった。","tok":[["ネル"],["の"],["子","こ"],["アブネル"],["は"],["、"],["サウル"],["の"],["子","こ"],["イシュ"],["・"],["ボシェテ"],["の"],["家来","けらい"],["たち"],["と"],["いっしょ"],["に"],["マハナイム"],["を"],["出て","でて"],["、"],["ギブオン"],["へ"],["向かった","むかった"],["。"]]},{"verse":13,"text":"一方、ツェルヤの子ヨアブも、ダビデの家来たちといっしょに出て行った。こうして彼らはギブオンの池のそばで出会った。一方は池のこちら側に、他方は池の向こう側にとどまった。","tok":[["一方","いっぽう"],["、"],["ツェルヤ"],["の"],["子","こ"],["ヨアブ"],["も"],["、"],["ダビデ"],["の"],["家来","けらい"],["たち"],["と"],["いっしょ"],["に"],["出て","でて"],["行った","いった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["ギブオン"],["の"],["池","いけ"],["の"],["そば"],["で"],["出会った","であった"],["。"],["一方","いっぽう"],["は"],["池","いけ"],["の"],["こちら側","こちらがわ"],["に"],["、"],["他方","たほう"],["は"],["池","いけ"],["の"],["向こう側","むこうがわ"],["に"],["とどまった"],["。"]]},{"verse":14,"text":"アブネルはヨアブに言った。「さあ、若い者たちを出して、われわれの前で闘技をさせよう。」ヨアブは言った。「出そう。」","tok":[["アブネル"],["は"],["ヨアブ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["若い","わかい"],["者","もの"],["たち"],["を"],["出して","だして"],["、"],["われわれ"],["の"],["前","まえ"],["で"],["闘技","とうぎ"],["を"],["させよう"],["。"],["」"],["ヨアブ"],["は"],["言った","いった"],["。"],["「"],["出","で"],["そう"],["。"],["」"]]},{"verse":15,"text":"そこで、ベニヤミンとサウルの子イシュ・ボシェテの側から十二人、ダビデの家来たちから十二人が順番に出て行った。","tok":[["そこ"],["で"],["、"],["ベニヤミン"],["と"],["サウル"],["の"],["子","こ"],["イシュ"],["・"],["ボシェテ"],["の"],["側","がわ"],["から"],["十二人","じゅうににん"],["、"],["ダビデ"],["の"],["家来","けらい"],["たち"],["から"],["十二人","じゅうににん"],["が"],["順番","じゅんばん"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":16,"text":"彼らは互いに相手の頭をつかみ、相手のわき腹に剣を刺し、一つになって倒れた。それでその所はヘルカテ・ハツリムと呼ばれた。それはギブオンにある。","tok":[["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["相手","あいて"],["の"],["頭","あたま"],["を"],["つかみ"],["、"],["相手","あいて"],["の"],["わき腹","わきばら"],["に"],["剣","けん"],["を"],["刺し","さし"],["、"],["一","ひと"],["つ"],["に"],["なって"],["倒れた","たおれた"],["。"],["それ"],["で"],["その"],["所","ところ"],["は"],["ヘルカテ"],["・"],["ハツリム"],["と"],["呼ばれた","よばれた"],["。"],["それ"],["は"],["ギブオン"],["に"],["ある"],["。"]]},{"verse":17,"text":"その日、戦いは激しさをきわめ、アブネルとイスラエルの兵士たちは、ダビデの家来たちに打ち負かされた。","tok":[["その"],["日","ひ"],["、"],["戦い","たたかい"],["は"],["激し","はげし"],["さ"],["を"],["きわめ"],["、"],["アブネル"],["と"],["イスラエル"],["の"],["兵士","へいし"],["たち"],["は"],["、"],["ダビデ"],["の"],["家来","けらい"],["たち"],["に"],["打ち負かされた","うちまかされた"],["。"]]},{"verse":18,"text":"そこに、ツェルヤの三人の息子、ヨアブ、アビシャイ、アサエルが居合わせた。アサエルは野にいるかもしかのように、足が早かった。","tok":[["そこ"],["に"],["、"],["ツェルヤ"],["の"],["三人","さんにん"],["の"],["息子","むすこ"],["、"],["ヨアブ"],["、"],["アビシャイ"],["、"],["アサエル"],["が"],["居合わせた","いあわせた"],["。"],["アサエル"],["は"],["野","の"],["に"],["いる"],["かもしか"],["の"],["よう"],["に"],["、"],["足","あし"],["が"],["早かった","はやかった"],["。"]]},{"verse":19,"text":"アサエルはアブネルのあとを追った。右にも左にもそれずに、アブネルを追った。","tok":[["アサエル"],["は"],["アブネル"],["の"],["あと"],["を"],["追った","おった"],["。"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それず"],["に"],["、"],["アブネル"],["を"],["追った","おった"],["。"]]},{"verse":20,"text":"アブネルは振り向いて言った。「おまえはアサエルか。」彼は答えた。「そうだ。」","tok":[["アブネル"],["は"],["振り向いて","ふりむいて"],["言った","いった"],["。"],["「"],["おまえ"],["は"],["アサエル"],["か"],["。"],["」"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["そう"],["だ"],["。"],["」"]]},{"verse":21,"text":"アブネルは彼に言った。「右か左にそれて、若者のひとりを捕らえ、その者からはぎ取れ。」しかしアサエルは、アブネルを追うのをやめず、ほかへ行こうともしなかった。","tok":[["アブネル"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["右","みぎ"],["か"],["左","ひだり"],["に"],["それて"],["、"],["若者","わかもの"],["の"],["ひとり"],["を"],["捕らえ","とらえ"],["、"],["その"],["者","もの"],["から"],["はぎ取れ","はぎとれ"],["。"],["」"],["しかし"],["アサエル"],["は"],["、"],["アブネル"],["を"],["追う","おう"],["の"],["を"],["やめず"],["、"],["ほか"],["へ"],["行こう","いこう"],["と"],["も"],["しなかった"],["。"]]},{"verse":22,"text":"アブネルはもう一度アサエルに言った。「私を追うのをやめて、ほかへ行け。なんでおまえを地に打ち倒すことができよう。どうしておまえの兄弟ヨアブに顔向けができよう。」","tok":[["アブネル"],["は"],["もう"],["一度","いちど"],["アサエル"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["を"],["追う","おう"],["の"],["を"],["やめて"],["、"],["ほか"],["へ"],["行け","いけ"],["。"],["なん"],["で"],["おまえ"],["を"],["地","ち"],["に"],["打ち倒す","うちたおす"],["こと"],["が"],["できよう"],["。"],["どう"],["して"],["おまえ"],["の"],["兄弟","きょうだい"],["ヨアブ"],["に"],["顔向け","かおむけ"],["が"],["できよう"],["。"],["」"]]},{"verse":23,"text":"それでもアサエルは、ほかへ行こうとはしなかった。それでアブネルは、槍の石突きで彼の下腹を突き刺した。槍はアサエルを突き抜けた。アサエルはその場に倒れて、そこで死んだ。アサエルが倒れて死んだ場所に来た者はみな、立ち止まった。","tok":[["それ"],["で"],["も"],["アサエル"],["は"],["、"],["ほか"],["へ"],["行こう","いこう"],["と"],["は"],["しなかった"],["。"],["それ"],["で"],["アブネル"],["は"],["、"],["槍","やり"],["の"],["石突き","いしづき"],["で"],["彼","かれ"],["の"],["下腹","したはら"],["を"],["突き刺した","つきさした"],["。"],["槍","やり"],["は"],["アサエル"],["を"],["突き抜けた","つきぬけた"],["。"],["アサエル"],["は"],["その"],["場","ば"],["に"],["倒れて","たおれて"],["、"],["そこ"],["で"],["死んだ","しんだ"],["。"],["アサエル"],["が"],["倒れて","たおれて"],["死んだ","しんだ"],["場所","ばしょ"],["に"],["来た","きた"],["者","もの"],["は"],["みな"],["、"],["立ち止まった","たちどまった"],["。"]]},{"verse":24,"text":"しかしヨアブとアビシャイは、アブネルのあとを追った。彼らがアマの丘に来たとき太陽が沈んだ。アマはギブオンの荒野の道沿いにあるギアハの手前にあった。","tok":[["しかし"],["ヨアブ"],["と"],["アビシャイ"],["は"],["、"],["アブネル"],["の"],["あと"],["を"],["追った","おった"],["。"],["彼","かれ"],["ら"],["が"],["アマ"],["の"],["丘","おか"],["に"],["来た","きた"],["とき"],["太陽","たいよう"],["が"],["沈んだ","しずんだ"],["。"],["アマ"],["は"],["ギブオン"],["の"],["荒野","あらの"],["の"],["道沿い","みちぞい"],["に"],["ある"],["ギアハ"],["の"],["手前","てまえ"],["に"],["あった"],["。"]]},{"verse":25,"text":"ベニヤミン人はアブネルに従って集まり、一団となって、そこの丘の頂上に立った。","tok":[["ベニヤミン"],["人","にん"],["は"],["アブネル"],["に"],["従って","したがって"],["集まり","あつまり"],["、"],["一団","いちだん"],["と"],["なって"],["、"],["そこ"],["の"],["丘","おか"],["の"],["頂上","ちょうじょう"],["に"],["立った","たった"],["。"]]},{"verse":26,"text":"アブネルはヨアブに呼びかけて言った。「いつまでも剣が人を滅ぼしてよいものか。その果ては、ひどいことになるのを知らないのか。いつになったら、兵士たちに、自分の兄弟たちを追うのをやめて帰れ、と命じるつもりか。」","tok":[["アブネル"],["は"],["ヨアブ"],["に"],["呼びかけて","よびかけて"],["言った","いった"],["。"],["「"],["いつ"],["まで"],["も"],["剣","けん"],["が"],["人","ひと"],["を"],["滅ぼして","ほろぼして"],["よい"],["もの"],["か"],["。"],["その"],["果て","はて"],["は"],["、"],["ひどい"],["こと"],["に"],["なる"],["の"],["を"],["知らない","しらない"],["の"],["か"],["。"],["いつ"],["に"],["なったら"],["、"],["兵士","へいし"],["たち"],["に"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["た
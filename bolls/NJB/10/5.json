[{"verse":1,"text":"イスラエルの全部族は、ヘブロンのダビデのもとに来てこう言った。「ご覧のとおり、私たちはあなたの骨肉です。","tok":[["イスラエル"],["の"],["全部族","ぜんぶぞく"],["は"],["、"],["ヘブロン"],["の"],["ダビデ"],["の"],["もと"],["に"],["来て","きて"],["こう"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["の"],["とおり"],["、"],["私たち","わたしたち"],["は"],["あなた"],["の"],["骨肉","こつにく"],["です"],["。"]]},{"verse":2,"text":"これまで、サウルが私たちの王であった時でさえ、イスラエルを動かしていたのは、あなたでした。しかも、主はあなたに言われました。『あなたがわたしの民イスラエルを牧し、あなたがイスラエルの君主となる。』」","tok":[["これ"],["まで"],["、"],["サウル"],["が"],["私たち","わたしたち"],["の"],["王","おう"],["で"],["あった"],["時","とき"],["で"],["さえ"],["、"],["イスラエル"],["を"],["動かして","うごかして"],["いた"],["の"],["は"],["、"],["あなた"],["でした"],["。"],["しかも"],["、"],["主","ぬし"],["は"],["あなた"],["に"],["言われました","いわれました"],["。"],["『"],["あなた"],["が"],["わたし"],["の"],["民","みん"],["イスラエル"],["を"],["牧","まき"],["し"],["、"],["あなた"],["が"],["イスラエル"],["の"],["君主","くんしゅ"],["と"],["なる"],["。"],["』"],["」"]]},{"verse":3,"text":"イスラエルの全長老がヘブロンの王のもとに来たとき、ダビデ王は、ヘブロンで主の前に、彼らと契約を結び、彼らはダビデに油をそそいでイスラエルの王とした。","tok":[["イスラエル"],["の"],["全","ぜん"],["長老","ちょうろう"],["が"],["ヘブロン"],["の"],["王","おう"],["の"],["もと"],["に"],["来た","きた"],["とき"],["、"],["ダビデ"],["王","おう"],["は"],["、"],["ヘブロン"],["で"],["主","ぬし"],["の"],["前","まえ"],["に"],["、"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["彼","かれ"],["ら"],["は"],["ダビデ"],["に"],["油","あぶら"],["を"],["そそいで"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["。"]]},{"verse":4,"text":"ダビデは三十歳で王となり、四十年間、王であった。","tok":[["ダビデ"],["は"],["三十歳","さんじゅうさい"],["で"],["王","おう"],["と"],["なり"],["、"],["四十","よんじゅう"],["年間","ねんかん"],["、"],["王","おう"],["で"],["あった"],["。"]]},{"verse":5,"text":"ヘブロンで七年六か月、ユダを治め、エルサレムで三十三年、全イスラエルとユダを治めた。","tok":[["ヘブロン"],["で"],["七","なな"],["年","ねん"],["六","ろく"],["か月","かげつ"],["、"],["ユダ"],["を"],["治め","おさめ"],["、"],["エルサレム"],["で"],["三十三","さんじゅうさん"],["年","ねん"],["、"],["全","ぜん"],["イスラエル"],["と"],["ユダ"],["を"],["治めた","おさめた"],["。"]]},{"verse":6,"text":"王とその部下がエルサレムに来て、その地の住民エブス人のところに行ったとき、彼らはダビデに言った。「あなたはここに来ることはできない。目の見えない者、足のなえた者でさえ、あなたを追い出せる。」彼らは、ダビデがここに来ることができない、と考えていたからであった。","tok":[["王","おう"],["と"],["その"],["部下","ぶか"],["が"],["エルサレム"],["に"],["来て","きて"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["エブス人","えぶすにん"],["の"],["ところ"],["に"],["行った","いった"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["ここ"],["に"],["来る","くる"],["こと"],["は"],["できない"],["。"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["、"],["足","あし"],["の"],["なえた"],["者","もの"],["で"],["さえ"],["、"],["あなた"],["を"],["追い出せる","おいだせる"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["ダビデ"],["が"],["ここ"],["に"],["来る","くる"],["こと"],["が"],["できない"],["、"],["と"],["考えて","かんがえて"],["いた"],["から"],["で"],["あった"],["。"]]},{"verse":7,"text":"しかし、ダビデはシオンの要害を攻め取った。これが、ダビデの町である。","tok":[["しかし"],["、"],["ダビデ"],["は"],["シオン"],["の"],["要害","ようがい"],["を"],["攻め取った","せめとった"],["。"],["これ"],["が"],["、"],["ダビデ"],["の"],["町","まち"],["で"],["ある"],["。"]]},{"verse":8,"text":"その日ダビデは、「だれでもエブス人を打とうとする者は、水汲みの地下道を抜けて、ダビデが憎む、目の見えない者、足のなえた者を打て」と言った。このため、「目の見えない者、足のなえた者は宮に入ってはならない」と言われている。","tok":[["その"],["日","ひ"],["ダビデ"],["は"],["、"],["「"],["だれ"],["で"],["も"],["エブス"],["人","ひと"],["を"],["打とう","うとう"],["と"],["する"],["者","もの"],["は"],["、"],["水汲み","みずくみ"],["の"],["地下","ちか"],["道","どう"],["を"],["抜けて","ぬけて"],["、"],["ダビデ"],["が"],["憎む","にくむ"],["、"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["、"],["足","あし"],["の"],["なえた"],["者","もの"],["を"],["打て","うて"],["」"],["と"],["言った","いった"],["。"],["この"],["ため"],["、"],["「"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["、"],["足","あし"],["の"],["なえた"],["者","もの"],["は"],["宮","みや"],["に"],["入って","はいって"],["は"],["ならない"],["」"],["と"],["言われて","いわれて"],["いる"],["。"]]},{"verse":9,"text":"こうしてダビデはこの要害を住まいとして、これをダビデの町と呼んだ。ダビデはミロから内側にかけて、回りに城壁を建てた。","tok":[["こう"],["して"],["ダビデ"],["は"],["この"],["要害","ようがい"],["を"],["住まい","すまい"],["として"],["、"],["これ"],["を"],["ダビデ"],["の"],["町","まち"],["と"],["呼んだ","よんだ"],["。"],["ダビデ"],["は"],["ミロ"],["から"],["内側","うちがわ"],["に"],["かけて"],["、"],["回り","まわり"],["に"],["城壁","じょうへき"],["を"],["建てた","たてた"],["。"]]},{"verse":10,"text":"ダビデはますます大いなる者となり、万軍の神、主が彼とともにおられた。","tok":[["ダビデ"],["は"],["ますます"],["大いなる","おおいなる"],["者","もの"],["と"],["なり"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["彼","かれ"],["と"],["とも"],["に"],["おられた"],["。"]]},{"verse":11,"text":"ツロの王ヒラムは、ダビデのもとに使者を送り、杉材、大工、石工を送った。彼らはダビデのために王宮を建てた。","tok":[["ツロ"],["の"],["王","おう"],["ヒラム"],["は"],["、"],["ダビデ"],["の"],["もと"],["に"],["使者","ししゃ"],["を"],["送り","おくり"],["、"],["杉材","すぎざい"],["、"],["大工","だいく"],["、"],["石工","せっこう"],["を"],["送った","おくった"],["。"],["彼","かれ"],["ら"],["は"],["ダビデ"],["の"],["ため"],["に"],["王宮","おうきゅう"],["を"],["建てた","たてた"],["。"]]},{"verse":12,"text":"ダビデは、主が彼をイスラエルの王として堅く立て、ご自分の民イスラエルのために、彼の王国を盛んにされたのを知った。","tok":[["ダビデ"],["は"],["、"],["主","ぬし"],["が"],["彼","かれ"],["を"],["イスラエル"],["の"],["王","おう"],["として"],["堅く","かたく"],["立て","たて"],["、"],["ご自分","ごじぶん"],["の"],["民","みん"],["イスラエル"],["の"],["ため"],["に"],["、"],["彼","かれ"],["の"],["王国","おうこく"],["を"],["盛ん","さかん"],["に"],["された"],["の"],["を"],["知った","しった"],["。"]]},{"verse":13,"text":"ダビデはヘブロンから来て後、エルサレムで、さらにそばめたちと妻たちをめとった。ダビデにはさらに、息子、娘たちが生まれた。","tok":[["ダビデ"],["は"],["ヘブロン"],["から"],["来て","きて"],["後","あと"],["、"],["エルサレム"],["で"],["、"],["さらに"],["そばめ"],["たち"],["と"],["妻たち","つまたち"],["を"],["めとった"],["。"],["ダビデ"],["に"],["は"],["さらに"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["が"],["生まれた","うまれた"],["。"]]},{"verse":14,"text":"エルサレムで彼に生まれた子の名は次のとおり。シャムア、ショバブ、ナタン、ソロモン、","tok":[["エルサレム"],["で"],["彼","かれ"],["に"],["生まれた","うまれた"],["子","こ"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["。"],["シャムア"],["、"],["ショバブ"],["、"],["ナタン"],["、"],["ソロモン"],["、"]]},{"verse":15,"text":"イブハル、エリシュア、ネフェグ、ヤフィア、","tok":[["イブハル"],["、"],["エリシュア"],["、"],["ネフェグ"],["、"],["ヤフィア"],["、"]]},{"verse":16,"text":"エリシャマ、エルヤダ、エリフェレテであった。","tok":[["エリシャマ"],["、"],["エルヤダ"],["、"],["エリフェレテ"],["で"],["あった"],["。"]]},{"verse":17,"text":"ペリシテ人は、ダビデが油をそそがれてイスラエルの王となったことを聞いた。そこでペリシテ人はみな、ダビデをねらって上って来た。ダビデはそれと聞き、要害に下って行った。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["ダビデ"],["が"],["油","あぶら"],["を"],["そそがれて"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["こと"],["を"],["聞いた","きいた"],["。"],["そこ"],["で"],["ペリシテ"],["人","にん"],["は"],["みな"],["、"],["ダビデ"],["を"],["ねらって"],["上って","のぼって"],["来た","きた"],["。"],["ダビデ"],["は"],["それ"],["と"],["聞き","きき"],["、"],["要害","ようがい"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":18,"text":"ペリシテ人は来て、レファイムの谷間に展開した。","tok":[["ペリシテ"],["人","にん"],["は"],["来て","きて"],["、"],["レファイム"],["の"],["谷間","たにま"],["に"],["展開","てんかい"],["した"],["。"]]},{"verse":19,"text":"そこで、ダビデは主に伺って言った。「ペリシテ人を攻めに上るべきでしょうか。彼らを私の手に渡してくださるでしょうか。」すると主はダビデに仰せられた。「上れ。わたしは必ず、ペリシテ人をあなたの手に渡すから。」","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["主に","おもに"],["伺って","うかがって"],["言った","いった"],["。"],["「"],["ペリシテ"],["人","にん"],["を"],["攻め","せめ"],["に"],["上るべきでしょう","のぼるべきでしょう"],["か"],["。"],["彼","かれ"],["ら"],["を"],["私","わたくし"],["の"],["手","て"],["に"],["渡して","わたして"],["くださるでしょう"],["か"],["。"],["」"],["する"],["と"],["主","ぬし"],["は"],["ダビデ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["上れ","のぼれ"],["。"],["わたし"],["は"],["必ず","かならず"],["、"],["ペリシテ"],["人","にん"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["から"],["。"],["」"]]},{"verse":20,"text":"それで、ダビデはバアル・ペラツィムに行き、そこで彼らを打った。そして言った。「主は、水が破れ出るように、私の前で私の敵を破られた。」それゆえ彼は、その場所の名をバアル・ペラツィムと呼んだ。","tok":[["それ"],["で"],["、"],["ダビデ"],["は"],["バアル"],["・"],["ペラツィム"],["に"],["行き","いき"],["、"],["そこ"],["で"],["彼","かれ"],["ら"],["を"],["打った","うった"],["。"],["そして"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["、"],["水","みず"],["が"],["破れ","やぶれ"],["出る","でる"],["よう"],["に"],["、"],["私","わたくし"],["の"],["前","まえ"],["で"],["私","わたくし"],["の"],["敵","てき"],["を"],["破られた","やぶられた"],["。"],["」"],["それ"],["ゆえ"],["彼","かれ"],["は"],["、"],["その"],["場所","ばしょ"],["の"],["名","な"],["を"],["バアル"],["・"],["ペラツィム"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":21,"text":"彼らが自分たちの偶像を置き去りにして行ったので、ダビデとその部下はそれらを運んで捨てた。","tok":[["彼","かれ"],["ら"],["が"],["自分","じぶん"],["たち"],["の"],["偶像","ぐうぞう"],["を"],["置き去り","おきざり"],["に"],["して"],["行った","いった"],["ので"],["、"],["ダビデ"],["と"],["その"],["部下","ぶか"],["は"],["それ"],["ら"],["を"],["運んで","はこんで"],["捨てた","すてた"],["。"]]},{"verse":22,"text":"ところがペリシテ人は、なおもまた上って来て、レファイムの谷間に展開した。","tok":[["ところ"],["が"],["ペリシテ"],["人","にん"],["は"],["、"],["なお"],["も"],["また"],["上って","のぼって"],["来て","きて"],["、"],["レファイム"],["の"],["谷間","たにま"],["に"],["展開","てんかい"],["した"],["。"]]},{"verse":23,"text":"そこで、ダビデが主に伺ったところ、主は仰せられた。「上って行くな。彼らのうしろに回って行き、バルサム樹の林の前から彼らに向かえ。","tok":[["そこ"],["で"],["、"],["ダビデ"],["が"],["主に","おもに"],["伺った","うかがった"],["ところ"],["、"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["上って","のぼって"],["行く","いく"],["な"],["。"],["彼","かれ"],["ら"],["の"],["うしろ"],["に"],["回って","まわって"],["行き","いき"],["、"],["バルサム"],["樹","じゅ"],["の"],["林","はやし"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["に"],["向かえ","むかえ"],["。"]]},{"verse":24,"text":"バルサム樹の林の上から行進の音が聞こえたら、そのとき、あなたは攻め上れ。そのとき、主はすでに、ペリシテ人の陣営を打つために、あなたより先に出ているから。」","tok":[["バルサム"],["樹","じゅ"],["の"],["林","はやし"],["の"],["上","うえ"],["から"],["行進","こうしん"],["の"],["音","おと"],["が"],["聞こえたら","きこえたら"],["、"],["その"],["とき"],["、"],["あなた"],["は"],["攻め上れ","せめのぼれ"],["。"],["その"],["とき"],["、"],["主","ぬし"],["は"],["すでに"],["、"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["を"],["打つ","うつ"],["ため"],["に"],["、"],["あなた"],["より"],["先","さき"],["に"],["出て","でて"],["いる"],["から"],["。"],["」"]]},{"verse":25,"text":"ダビデは、主が彼に命じたとおりにし、ゲバからゲゼルに至るまでのペリシテ人を打った。","tok":[["ダビデ"],["は"],["、"],["主","ぬし"],["が"],["彼","かれ"],["に"],["命じた","めいじた"],["とおり"],["に"],["し"],["、"],["ゲバ"],["から"],["ゲゼル"],["に"],["至る","いたる"],["まで"],["の"],["ペリシテ"],["人","にん"],["を"],["打った","うった"],["。"]]}]
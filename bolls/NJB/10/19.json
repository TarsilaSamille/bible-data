[{"verse":1,"text":"そうこうするうちに、ヨアブに、「今、王は泣いて、アブシャロムのために、喪に服しておられる」という報告がされた。","tok":[["そうこう"],["する"],["うち"],["に"],["、"],["ヨアブ"],["に"],["、"],["「"],["今","いま"],["、"],["王","おう"],["は"],["泣いて","ないて"],["、"],["アブシャロム"],["の"],["ため"],["に"],["、"],["喪","も"],["に"],["服して","ふくして"],["おられる"],["」"],["と"],["いう"],["報告","ほうこく"],["が"],["された"],["。"]]},{"verse":2,"text":"それで、この日の勝利は、すべての民の嘆きとなった。この日、民が、王がその子のために悲しんでいる、ということを聞いたからである。","tok":[["それ"],["で"],["、"],["この"],["日","ひ"],["の"],["勝利","しょうり"],["は"],["、"],["すべて"],["の"],["民","たみ"],["の"],["嘆き","なげき"],["と"],["なった"],["。"],["この"],["日","ひ"],["、"],["民","みん"],["が"],["、"],["王","おう"],["が"],["その"],["子","こ"],["の"],["ため"],["に"],["悲しんで","かなしんで"],["いる"],["、"],["と"],["いう"],["こと"],["を"],["聞いた","きいた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"民はその日、まるで戦場から逃げて恥じている民がこっそり帰るように、町にこっそり帰って来た。","tok":[["民","みん"],["は"],["その"],["日","ひ"],["、"],["まるで"],["戦場","せんじょう"],["から"],["逃げて","にげて"],["恥じて","はじて"],["いる"],["民","たみ"],["が"],["こっそり"],["帰る","かえる"],["よう"],["に"],["、"],["町","まち"],["に"],["こっそり"],["帰って","かえって"],["来た","きた"],["。"]]},{"verse":4,"text":"王は顔をおおい、大声で、「わが子アブシャロム。アブシャロムよ。わが子よ。わが子よ」と叫んでいた。","tok":[["王","おう"],["は"],["顔","かお"],["を"],["おおい"],["、"],["大声","おおごえ"],["で"],["、"],["「"],["わが"],["子","こ"],["アブシャロム"],["。"],["アブシャロム"],["よ"],["。"],["わが"],["子","こ"],["よ"],["。"],["わが"],["子","こ"],["よ"],["」"],["と"],["叫んで","さけんで"],["いた"],["。"]]},{"verse":5,"text":"ヨアブは王の家に行き、王に言った。「あなたは、きょう、あなたのいのちと、あなたの息子、娘たちのいのち、それに、あなたの妻やそばめたちのいのちを救ったあなたの家来たち全部に、きょう、恥をかかせました。","tok":[["ヨアブ"],["は"],["王","おう"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["きょう"],["、"],["あなた"],["の"],["いのち"],["と"],["、"],["あなた"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["の"],["いのち"],["、"],["それ"],["に"],["、"],["あなた"],["の"],["妻","つま"],["や"],["そばめ"],["たち"],["の"],["いのち"],["を"],["救った","すくった"],["あなた"],["の"],["家来","けらい"],["たち"],["全部","ぜんぶ"],["に"],["、"],["きょう"],["、"],["恥","はじ"],["を"],["かかせました"],["。"]]},{"verse":6,"text":"あなたは、あなたを憎む者を愛し、あなたを愛する者を憎まれるからです。あなたは、きょう、隊長たちも家来たちも、あなたにとっては取るに足りないことを明らかにされました。今、私は知りました。もしアブシャロムが生き、われわれがみな、きょう死んだのなら、あなたの目にかなったのでしょう。","tok":[["あなた"],["は"],["、"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["を"],["愛し","あいし"],["、"],["あなた"],["を"],["愛する","あいする"],["者","もの"],["を"],["憎まれる","にくまれる"],["から"],["です"],["。"],["あなた"],["は"],["、"],["きょう"],["、"],["隊長","たいちょう"],["たち"],["も"],["家来","けらい"],["たち"],["も"],["、"],["あなた"],["にとって"],["は"],["取る","とる"],["に"],["足りない","たりない"],["こと"],["を"],["明らか","あきらか"],["に"],["されました"],["。"],["今","いま"],["、"],["私","わたくし"],["は"],["知りました","しりました"],["。"],["もし"],["アブシャロム"],["が"],["生き","いき"],["、"],["われわれ"],["が"],["みな"],["、"],["きょう"],["死んだ","しんだ"],["の"],["なら"],["、"],["あなた"],["の"],["目","め"],["に"],["かなった"],["の"],["でしょう"],["。"]]},{"verse":7,"text":"それで今、立って外に行き、あなたの家来たちに、ねんごろに語ってください。私は主によって誓います。あなたが外においでにならなければ、今夜、だれひとりあなたのそばに、とどまらないでしょう。そうなれば、そのわざわいは、あなたの幼いころから今に至るまでにあなたに降りかかった、どんなわざわいよりもひどいでしょう。」","tok":[["それ"],["で"],["今","いま"],["、"],["立って","たって"],["外","そと"],["に"],["行き","いき"],["、"],["あなた"],["の"],["家来","けらい"],["たち"],["に"],["、"],["ねんごろ"],["に"],["語って","かたって"],["ください"],["。"],["私","わたくし"],["は"],["主に","おもに"],["よって"],["誓います","ちかいます"],["。"],["あなた"],["が"],["外","そと"],["に"],["おいで"],["に"],["ならなければ"],["、"],["今夜","こんや"],["、"],["だれ"],["ひとり"],["あなた"],["の"],["そば"],["に"],["、"],["とどまらないでしょう"],["。"],["そう"],["なれば"],["、"],["その"],["わざわい"],["は"],["、"],["あなた"],["の"],["幼い","おさない"],["ころ"],["から"],["今","いま"],["に"],["至る","いたる"],["まで"],["に"],["あなた"],["に"],["降りかかった","ふりかかった"],["、"],["どんな"],["わざわい"],["より"],["も"],["ひどいでしょう"],["。"],["」"]]},{"verse":8,"text":"それで、王は立って、門のところにすわった。人々がすべての民に、「見よ。王は門のところにすわっておられる」と知らせたので、すべての民は、王の前にやって来た。／一方、イスラエル人は、おのおの自分たちの天幕に逃げ帰っていた。","tok":[["それ"],["で"],["、"],["王","おう"],["は"],["立って","たって"],["、"],["門","もん"],["の"],["ところ"],["に"],["すわった"],["。"],["人々","ひとびと"],["が"],["すべて"],["の"],["民","たみ"],["に"],["、"],["「"],["見","み"],["よ"],["。"],["王","おう"],["は"],["門","もん"],["の"],["ところ"],["に"],["すわって"],["おられる"],["」"],["と"],["知らせた","しらせた"],["ので"],["、"],["すべて"],["の"],["民","たみ"],["は"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["やって"],["来た","きた"],["。"],["／"],["一方","いっぽう"],["、"],["イスラエル"],["人","にん"],["は"],["、"],["おのおの"],["自分","じぶん"],["たち"],["の"],["天幕","てんまく"],["に"],["逃げ帰って","にげかえって"],["いた"],["。"]]},{"verse":9,"text":"民はみな、イスラエルの全部族の間で、こう言って争っていた。「王は敵の手から、われわれを救い出してくださった。王はわれわれをペリシテ人の手から助け出してくださった。ところが今、王はアブシャロムのために国外に逃げておられる。","tok":[["民","みん"],["は"],["みな"],["、"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["の"],["間","あいだ"],["で"],["、"],["こう"],["言って","いって"],["争って","あらそって"],["いた"],["。"],["「"],["王","おう"],["は"],["敵","てき"],["の"],["手","て"],["から"],["、"],["われわれ"],["を"],["救い出して","すくいだして"],["くださった"],["。"],["王","おう"],["は"],["われわれ"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["助け出して","たすけだして"],["くださった"],["。"],["ところ"],["が"],["今","いま"],["、"],["王","おう"],["は"],["アブシャロム"],["の"],["ため"],["に"],["国外","こくがい"],["に"],["逃げて","にげて"],["おられる"],["。"]]},{"verse":10,"text":"われわれが油をそそいで王としたアブシャロムは、戦いで死んでしまった。それなのに、あなたがたは今、王を連れ戻すために、なぜ何もしないでいるのか。」","tok":[["われわれ"],["が"],["油","あぶら"],["を"],["そそいで"],["王","おう"],["と"],["した"],["アブシャロム"],["は"],["、"],["戦い","たたかい"],["で"],["死んで","しんで"],["しまった"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["今","いま"],["、"],["王","おう"],["を"],["連れ戻す","つれもどす"],["ため"],["に"],["、"],["なぜ"],["何","なん"],["も"],["しないで"],["いる"],["の"],["か"],["。"],["」"]]},{"verse":11,"text":"ダビデ王は祭司ツァドクとエブヤタルに人をやって言わせた。「ユダの長老たちにこう言って告げなさい。『全イスラエルの言っていることが、ここの家にいる王の耳に届いたのに、あなたがたは、なぜ王をその王宮に連れ戻すのをためらっているのか。","tok":[["ダビデ"],["王","おう"],["は"],["祭司","さいし"],["ツァドク"],["と"],["エブヤタル"],["に"],["人","ひと"],["を"],["やって"],["言わせた","いわせた"],["。"],["「"],["ユダ"],["の"],["長老","ちょうろう"],["たち"],["に"],["こう"],["言って","いって"],["告げ","つげ"],["なさい"],["。"],["『"],["全","ぜん"],["イスラエル"],["の"],["言って","いって"],["いる"],["こと"],["が"],["、"],["ここ"],["の"],["家","いえ"],["に"],["いる"],["王","おう"],["の"],["耳","みみ"],["に"],["届いた","とどいた"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["なぜ"],["王","おう"],["を"],["その"],["王宮","おうきゅう"],["に"],["連れ戻す","つれもどす"],["の"],["を"],["ためらって"],["いる"],["の"],["か"],["。"]]},{"verse":12,"text":"あなたがたは、私の兄弟、私の骨肉だ。それなのに、なぜ王を連れ戻すのをためらっているのか。』","tok":[["あなた"],["がた"],["は"],["、"],["私","わたくし"],["の"],["兄弟","きょうだい"],["、"],["私","わたくし"],["の"],["骨肉","こつにく"],["だ"],["。"],["それ"],["な"],["のに"],["、"],["なぜ"],["王","おう"],["を"],["連れ戻す","つれもどす"],["の"],["を"],["ためらって"],["いる"],["の"],["か"],["。"],["』"]]},{"verse":13,"text":"またアマサにも言わなければならない。『あなたは、私の骨肉ではないか。もしあなたが、ヨアブに代わってこれからいつまでも、私の将軍にならないなら、神がこの私を幾重にも罰せられるように。』」","tok":[["また"],["アマサ"],["に"],["も"],["言わなければ","いわなければ"],["ならない"],["。"],["『"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["骨肉","こつにく"],["で"],["は"],["ない"],["か"],["。"],["もし"],["あなた"],["が"],["、"],["ヨアブ"],["に"],["代わって","かわって"],["これ"],["から"],["いつ"],["まで"],["も"],["、"],["私","わたくし"],["の"],["将軍","しょうぐん"],["に"],["ならないなら"],["、"],["神","かみ"],["が"],["この"],["私","わたくし"],["を"],["幾重","いくえ"],["に"],["も"],["罰せられる","ばっせられる"],["よう"],["に"],["。"],["』"],["」"]]},{"verse":14,"text":"こうしてダビデは、すべてのユダの人々を、あたかもひとりの人の心のように自分になびかせた。ユダの人々は王のもとに人をやって、「あなたも、あなたの家来たちもみな、お帰りください」と言った。","tok":[["こう"],["して"],["ダビデ"],["は"],["、"],["すべて"],["の"],["ユダ"],["の"],["人々","ひとびと"],["を"],["、"],["あたかも"],["ひとり"],["の"],["人","ひと"],["の"],["心","こころ"],["の"],["よう"],["に"],["自分","じぶん"],["に"],["なびかせた"],["。"],["ユダ"],["の"],["人々","ひとびと"],["は"],["王","おう"],["の"],["もと"],["に"],["人","ひと"],["を"],["やって"],["、"],["「"],["あなた"],["も"],["、"],["あなた"],["の"],["家来","けらい"],["たち"],["も"],["みな"],["、"],["お帰り","おかえり"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"そこで王は帰途につき、ヨルダン川に着くと、ユダの人々は、王を迎えてヨルダン川を渡らせるためにギルガルに来た。","tok":[["そこ"],["で"],["王","おう"],["は"],["帰途","きと"],["に"],["つき"],["、"],["ヨルダン"],["川","かわ"],["に"],["着く","つく"],["と"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["王","おう"],["を"],["迎えて","むかえて"],["ヨルダン"],["川","かわ"],["を"],["渡らせる","わたらせる"],["ため"],["に"],["ギルガル"],["に"],["来た","きた"],["。"]]},{"verse":16,"text":"バフリムの出のベニヤミン人、ゲラの子シムイは、ダビデ王を迎えようと、急いでユダの人々といっしょに下って来た。","tok":[["バフリム"],["の"],["出","で"],["の"],["ベニヤミン"],["人","にん"],["、"],["ゲラ"],["の"],["子","こ"],["シムイ"],["は"],["、"],["ダビデ"],["王","おう"],["を"],["迎えよう","むかえよう"],["と"],["、"],["急いで","いそいで"],["ユダ"],["の"],["人々","ひとびと"],["と"],["いっしょ"],["に"],["下って","くだって"],["来た","きた"],["。"]]},{"verse":
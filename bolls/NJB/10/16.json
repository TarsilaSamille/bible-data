[{"verse":1,"text":"ダビデは山の頂から少し下った。見ると、メフィボシェテのしもべツィバが王を迎えに来ていた。彼は、鞍を置いた一くびきのろばに、パン二百個、干しぶどう百ふさ、夏のくだもの百個、ぶどう酒一袋を載せていた。","tok":[["ダビデ"],["は"],["山","やま"],["の"],["頂","いただき"],["から"],["少し","すこし"],["下った","くだった"],["。"],["見る","みる"],["と"],["、"],["メフィボシェテ"],["の"],["しもべ"],["ツィバ"],["が"],["王","おう"],["を"],["迎え","むかえ"],["に"],["来て","きて"],["いた"],["。"],["彼","かれ"],["は"],["、"],["鞍","くら"],["を"],["置いた","おいた"],["一","いち"],["く"],["びき"],["の"],["ろば"],["に"],["、"],["パン"],["二百個","にひゃくこ"],["、"],["干し","ほし"],["ぶどう"],["百","ひゃく"],["ふ"],["さ"],["、"],["夏","なつ"],["の"],["くだもの"],["百個","ひゃくこ"],["、"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["袋","ふくろ"],["を"],["載せて","のせて"],["いた"],["。"]]},{"verse":2,"text":"王はツィバに尋ねた。「これらは何のためか。」ツィバは答えた。「二頭のろばは王の家族がお乗りになるため、パンと夏のくだものは若い者たちが食べるため、ぶどう酒は荒野で疲れた者が飲むためです。」","tok":[["王","おう"],["は"],["ツィバ"],["に"],["尋ねた","たずねた"],["。"],["「"],["これ"],["ら"],["は"],["何","なん"],["の"],["ため"],["か"],["。"],["」"],["ツィバ"],["は"],["答えた","こたえた"],["。"],["「"],["二頭","にとう"],["の"],["ろば"],["は"],["王","おう"],["の"],["家族","かぞく"],["が"],["お乗り","おのり"],["に"],["なる"],["ため"],["、"],["パン"],["と"],["夏","なつ"],["の"],["くだもの"],["は"],["若い","わかい"],["者","もの"],["たち"],["が"],["食べる","たべる"],["ため"],["、"],["ぶどう酒","ぶどうしゅ"],["は"],["荒野","こうや"],["で"],["疲れた","つかれた"],["者","もの"],["が"],["飲む","のむ"],["ため"],["です"],["。"],["」"]]},{"verse":3,"text":"王は言った。「あなたの主人の息子はどこにいるか。」ツィバは王に言った。「今、エルサレムにおられます。あの人は、『きょう、イスラエルの家は、私の父の王国を私に返してくれる』と言っていました。」","tok":[["王","おう"],["は"],["言った","いった"],["。"],["「"],["あなた"],["の"],["主人","しゅじん"],["の"],["息子","むすこ"],["は"],["どこ"],["に"],["いる"],["か"],["。"],["」"],["ツィバ"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["今","いま"],["、"],["エルサレム"],["に"],["おられます"],["。"],["あの"],["人","ひと"],["は"],["、"],["『"],["きょう"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["私","わたくし"],["の"],["父","ちち"],["の"],["王国","おうこく"],["を"],["私","わたくし"],["に"],["返して","かえして"],["くれる"],["』"],["と"],["言って","いって"],["いました"],["。"],["」"]]},{"verse":4,"text":"すると王はツィバに言った。「メフィボシェテのものはみな、今、あなたのものだ。」ツィバが言った。「王さま。あなたのご好意にあずかることができますように、伏してお願いいたします。」","tok":[["する"],["と"],["王","おう"],["は"],["ツィバ"],["に"],["言った","いった"],["。"],["「"],["メフィボシェテ"],["の"],["もの"],["は"],["みな"],["、"],["今","いま"],["、"],["あなた"],["の"],["もの"],["だ"],["。"],["」"],["ツィバ"],["が"],["言った","いった"],["。"],["「"],["王","おう"],["さま"],["。"],["あなた"],["の"],["ご好意","ごこうい"],["に"],["あずかる"],["こと"],["が"],["できます"],["よう"],["に"],["、"],["伏して","ふして"],["お願い","おねがい"],["いたします"],["。"],["」"]]},{"verse":5,"text":"ダビデ王がバフリムまで来ると、ちょうど、サウルの家の一族のひとりが、そこから出て来た。その名はシムイといってゲラの子で、盛んにのろいのことばを吐きながら出て来た。","tok":[["ダビデ"],["王","おう"],["が"],["バフリム"],["まで"],["来る","くる"],["と"],["、"],["ちょうど"],["、"],["サウル"],["の"],["家","いえ"],["の"],["一族","いちぞく"],["の"],["ひとり"],["が"],["、"],["そこ"],["から"],["出て","でて"],["来た","きた"],["。"],["その"],["名","な"],["は"],["シムイ"],["と"],["いって"],["ゲラ"],["の"],["子","こ"],["で"],["、"],["盛ん","さかん"],["に"],["のろい"],["の"],["ことば"],["を"],["吐き","はき"],["ながら"],["出て","でて"],["来た","きた"],["。"]]},{"verse":6,"text":"そしてダビデとダビデ王のすべての家来たちに向かって石を投げつけた。民と勇士たちはみな、王の右左にいた。","tok":[["そして"],["ダビデ"],["と"],["ダビデ"],["王","おう"],["の"],["すべて"],["の"],["家来","けらい"],["たち"],["に"],["向かって","むかって"],["石","いし"],["を"],["投げつけた","なげつけた"],["。"],["民","たみ"],["と"],["勇士","ゆうし"],["たち"],["は"],["みな"],["、"],["王","おう"],["の"],["右左","みぎひだり"],["に"],["いた"],["。"]]},{"verse":7,"text":"シムイはのろってこう言った。「出て行け、出て行け。血まみれの男、よこしまな者。","tok":[["シムイ"],["は"],["のろって"],["こう"],["言った","いった"],["。"],["「"],["出て","でて"],["行け","いけ"],["、"],["出て","でて"],["行け","いけ"],["。"],["血まみれ","ちまみれ"],["の"],["男","おとこ"],["、"],["よこしま"],["な"],["者","もの"],["。"]]},{"verse":8,"text":"主がサウルの家のすべての血をおまえに報いたのだ。サウルに代わって王となったおまえに。主はおまえの息子アブシャロムの手に王位を渡した。今、おまえはわざわいに会うのだ。おまえは血まみれの男だから。」","tok":[["主","ぬし"],["が"],["サウル"],["の"],["家","いえ"],["の"],["すべて"],["の"],["血","ち"],["を"],["おまえ"],["に"],["報いた","むくいた"],["の"],["だ"],["。"],["サウル"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["おまえ"],["に"],["。"],["主","ぬし"],["は"],["おまえ"],["の"],["息子","むすこ"],["アブシャロム"],["の"],["手","て"],["に"],["王位","おうい"],["を"],["渡した","わたした"],["。"],["今","いま"],["、"],["おまえ"],["は"],["わざわい"],["に"],["会う","あう"],["の"],["だ"],["。"],["おまえ"],["は"],["血まみれ","ちまみれ"],["の"],["男","おとこ"],["だ"],["から"],["。"],["」"]]},{"verse":9,"text":"すると、ツェルヤの子アビシャイが王に言った。「この死に犬めが、王さまをのろってよいものですか。行って、あの首をはねさせてください。」","tok":[["する"],["と"],["、"],["ツェルヤ"],["の"],["子","こ"],["アビシャイ"],["が"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["この"],["死","し"],["に"],["犬","いぬ"],["め"],["が"],["、"],["王","おう"],["さま"],["を"],["のろって"],["よい"],["もの"],["です"],["か"],["。"],["行って","いって"],["、"],["あの"],["首","くび"],["を"],["はねさせて"],["ください"],["。"],["」"]]},{"verse":10,"text":"王は言った。「ツェルヤの子らよ。これは私のことで、あなたがたには、かかわりのないことだ。彼がのろうのは、主が彼に、『ダビデをのろえ』と言われたからだ。だれが彼に、『おまえはどうしてこういうことをするのだ』と言えようか。」","tok":[["王","おう"],["は"],["言った","いった"],["。"],["「"],["ツェルヤ"],["の"],["子","こ"],["ら"],["よ"],["。"],["これ"],["は"],["私","わたくし"],["の"],["こと"],["で"],["、"],["あなた"],["がた"],["に"],["は"],["、"],["かかわり"],["の"],["ない"],["こと"],["だ"],["。"],["彼","かれ"],["が"],["のろう"],["の"],["は"],["、"],["主","ぬし"],["が"],["彼","かれ"],["に"],["、"],["『"],["ダビデ"],["を"],["のろえ"],["』"],["と"],["言われた","いわれた"],["から"],["だ"],["。"],["だれ"],["が"],["彼","かれ"],["に"],["、"],["『"],["おまえ"],["は"],["どう"],["して"],["こう"],["いう"],["こと"],["を"],["する"],["の"],["だ"],["』"],["と"],["言えよう","いえよう"],["か"],["。"],["」"]]},{"verse":11,"text":"ダビデはアビシャイと彼のすべての家来たちに言った。「見よ。私の身から出た私の子さえ、私のいのちをねらっている。今、このベニヤミン人としては、なおさらのことだ。ほうっておきなさい。彼にのろわせなさい。主が彼に命じられたのだから。","tok":[["ダビデ"],["は"],["アビシャイ"],["と"],["彼","かれ"],["の"],["すべて"],["の"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["見","み"],["よ"],["。"],["私","わたくし"],["の"],["身","み"],["から"],["出た","でた"],["私","わたくし"],["の"],["子","こ"],["さえ"],["、"],["私","わたくし"],["の"],["いのち"],["を"],["ねらって"],["いる"],["。"],["今","いま"],["、"],["この"],["ベニヤミン"],["人","にん"],["として"],["は"],["、"],["なおさら"],["の"],["こと"],["だ"],["。"],["ほうって"],["おき"],["なさい"],["。"],["彼","かれ"],["に"],["のろわせ"],["なさい"],["。"],["主","ぬし"],["が"],["彼","かれ"],["に"],["命じられた","めいじられた"],["の"],["だ"],["から"],["。"]]},{"verse":12,"text":"たぶん、主は私の心をご覧になり、主は、きょうの彼ののろいに代えて、私にしあわせを報いてくださるだろう。」","tok":[["たぶん"],["、"],["主","ぬし"],["は"],["私","わたくし"],["の"],["心","こころ"],["を"],["ご覧","ごらん"],["に"],["なり"],["、"],["主","ぬし"],["は"],["、"],["きょう"],["の"],["彼","かれ"],["の"],["のろい"],["に"],["代えて","かえて"],["、"],["私","わたくし"],["に"],["しあわせ"],["を"],["報いて","むくいて"],["くださるだろう"],["。"],["」"]]},{"verse":13,"text":"ダビデと彼の部下たちは道を進んで行った。シムイは、山の中腹をダビデと平行して歩きながら、のろったり、石を投げたり、ちりをかけたりしていた。","tok":[["ダビデ"],["と"],["彼","かれ"],["の"],["部下","ぶか"],["たち"],["は"],["道","みち"],["を"],["進んで","すすんで"],["行った","いった"],["。"],["シムイ"],["は"],["、"],["山","やま"],["の"],["中腹","ちゅうふく"],["を"],["ダビデ"],["と"],["平行","へいこう"],["して"],["歩き","あるき"],["ながら"],["、"],["のろっ"],["たり"],["、"],["石","いし"],["を"],["投げ","なげ"],["たり"],["、"],["ちり"],["を"],["かけ"],["たり"],["して"],["いた"],["。"]]},{"verse":14,"text":"王も、王とともに行った民もみな、疲れたので、そこでひと息ついた。","tok":[["王","おう"],["も"],["、"],["王","おう"],["と"],["とも"],["に"],["行った","いった"],["民","たみ"],["も"],["みな"],["、"],["疲れた","つかれた"],["ので"],["、"],["そこ"],["で"],["ひと息","ひといき"],["ついた"],["。"]]},{"verse":15,"text":"アブシャロムとすべての民、イスラエル人はエルサレムに入った。アヒトフェルもいっしょであった。","tok":[["アブシャロム"],["と"],["すべて"],["の"],["民","たみ"],["、"],["イスラエル"],["人","にん"],["は"],["エルサレム"],["に"],["入った","はいった"],["。"],["アヒトフェル"],["も"],["いっしょ"],["で"],["あった"],["。"]]},{"verse":16,"text":"ダビデの友アルキ人フシャイがアブシャロムのところに来たとき、フシャイはアブシャロムに言った。「王さま。ばんざい。王さま。ばんざい。」","tok":[["ダビデ"],["の"],["友","とも"],["アルキ人","あるきにん"],["フシャイ"],["が"],["アブシャロム"],["の"],["ところ"],["に"],["来た","きた"],["とき"],["、"],["フシャイ"],["は"],["アブシャロム"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["さま"],["。"],["ばんざい"],["。"],["王","おう"],["さま"],["。"],["ばんざい"],["。"],["」"]]},{"verse":17,"text":"アブシャロムはフシャイに言った。「これが、あなたの友への忠誠のあらわれなのか。なぜ、あなたは、あなたの友といっしょに行かなかったのか。」","tok":[["アブシャロム"],["は"],["フシャイ"],["に"],["言った","いった"],["。"],["「"],["これ"],["が"],["、"],["あなた"],["の"],["友","とも"],["へ"],["の"],["忠誠","ちゅうせい"],["の"],["あらわれ"],["な"],["の"],["か"],["。"],["なぜ"],["、"],["あなた"],["は"],["、"],["あなた"],["の"],["友","とも"],["と"],["いっしょ"],["に"],["行かなかった","いかなかった"],["の"],["か"],["。"],["」"]]},{"verse":18,"text":"フシャイはアブシャロムに答えた。「いいえ、主と、この民、イスラエルのすべての人々とが選んだ方に私はつき、その方といっしょにいたいのです。","tok":[["フシャイ"],["は"],["アブシャロム"],["に"],["答えた","こたえた"],["。"],["「"],["いいえ"],["、"],["主","ぬし"],["と"],["、"],["この"],["民","たみ"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["と"],["が"],["選んだ","えらんだ"],["方","ほう"],["に"],["私","わたくし"],["は"],["つき"],["、"],["その"],["方","かた"],["と"],["いっしょ"],["に"],["いたい"],["の"],["です"],["。"]]},{"verse":19,"text":"また、私はだれに仕えるべきでしょう。私の友の子に仕えるべきではありませんか。私はあなたの父上に仕えたように、あなたにもお仕えいたします。」","tok":[["また"],["、"],["私","わたくし"],["は"],["だれ"],["に"],["仕えるべきでしょう","つかえるべきでしょう"],["。"],["私","わたくし"],["の"],["友","とも"],["の"],["子","こ"],["に"],["仕えるべきで","つかえるべきで"],["は"],["ありません"],["か"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["父上","ちちじょう"],["に"],["仕えた","つかえた"],["よう"],["に"],["、"],["あなた"],["に"],["も"],["お仕え","おつかえ"],["いたします"],["。"],["」"]]},{"verse":20,"text":"それで、アブシャロムはアヒトフェルに言った。「あなたがたは相談して、われわれはどうしたらよいか、意見を述べなさい。」","tok":[["それ"],["で"],["、"],["アブシャロム"],["は"],["アヒトフェル"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["相談","そうだん"],["して"],["、"],["われわれ"],["は"],["どう"],["したら"],["よい"],["か"],["、"],["意見","いけん"],["を"],["述べ","のべ"],["なさい"],["。"],["」"]]},{"verse":21,"text":"アヒトフェルはアブシャロムに言った。「父上が王宮の留守番に残したそばめたちのところにお入りください。全イスラエルが、あなたは父上に憎まれるようなことをされたと聞くなら、あなたに、くみする者はみな、勇気を出すでしょう。」","tok":[["アヒトフェル"],["は"],["アブシャロム"],["に"],["言った","いった"],["。"],["「"],["父","ちち"],["上","うえ"],["が"],["王宮","おうきゅう"],["の"],["留守番","るすばん"],["に"],["残した","のこした"],["そばめ"],["たち"],["の"],["ところ"],["に"],["お入り","おはいり"],["ください"],["。"],["全","ぜん"],["イスラエル"],["が"],["、"],["あなた"],["は"],["父上","ちちじょう"],["に"],["憎まれる","にくまれる"],["よう"],["な"],["こと"],["を"],["された"],["と"],["聞くなら","きくなら"],["、"],["あなた"],["に"],["、"],["くみする"],["者","もの"],["は"],["みな"],["、"],["勇気","ゆうき"],["を"],["出すでしょう","だすでしょう"],["。"],["」"]]},{"verse":22,"text":"こうしてアブシャロムのために屋上に天幕が張られ、アブシャロムは全イスラエルの目の前で、父のそばめたちのところに入った。","tok":[["こう"],["して"],["アブシャロム"],["の"],["ため"],["に"],["屋上","おくじょう"],["に"],["天幕","てんまく"],["が"],["張られ","はられ"],["、"],["アブシャロム"],["は"],["全","ぜん"],["イスラエル"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["父","ちち"],["の"],["そばめ"],["たち"],["の"],["ところ"],["に"],["入った","はいった"],["。"]]},{"verse":23,"text":"当時、アヒトフェルの進言する助言は、人が神のことばを伺って得ることばのようであった。アヒトフェルの助言はみな、ダビデにもアブシャロムにもそのように思われた。","tok":[["当時","とうじ"],["、"],["アヒトフェル"],["の"],["進言","しんげん"],["する"],["助言","じょげん"],["は"],["、"],["人","ひと"],["が"],["神","かみ"],["の"],["ことば"],["を"],["伺って","うかがって"],["得る","える"],["ことば"],["の"],["よう"],["で"],["あった"],["。"],["アヒトフェル"],["の"],["助言","じょげん"],["は"],["みな"],["、"],["ダビデ"],["に"],["も"],["アブシャロム"],["に"],["も"],["その"],["よう"],["に"],["思われた","おもわれた"],["。"]]}]
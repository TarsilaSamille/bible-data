],["。"],["」"],["アブシャロム"],["の"],["家来","けらい"],["たち"],["は"],["畑","はたけ"],["に"],["火","ひ"],["を"],["つけた"],["。"]]},{"verse":31,"text":"するとヨアブはアブシャロムの家にやって来て、彼に言った。「なぜ、あなたの家来たちは、私の畑に火をつけたのですか。」","tok":[["する"],["と"],["ヨアブ"],["は"],["アブシャロム"],["の"],["家","いえ"],["に"],["やって"],["来て","きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["あなた"],["の"],["家来","けらい"],["たち"],["は"],["、"],["私","わたくし"],["の"],["畑","はたけ"],["に"],["火","ひ"],["を"],["つけた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":32,"text":"アブシャロムはヨアブに答えた。「私はあなたのところに人をやり、ここに来てくれ、と言わせたではないか。私はあなたを王のもとに遣わし、『なぜ、私をゲシュルから帰って来させたのですか。あそこにとどまっていたほうが、まだ、ましでしたのに』と言ってもらいたかったのだ。今、私は王の顔を拝したい。もし私に咎があるなら、王に殺されてもかまわない。」","tok":[["アブシャロム"],["は"],["ヨアブ"],["に"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["あなた"],["の"],["ところ"],["に"],["人","ひと"],["を"],["やり"],["、"],["ここ"],["に"],["来て","きて"],["くれ"],["、"],["と"],["言わせたで","いわせたで"],["は"],["ない"],["か"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["王","おう"],["の"],["もと"],["に"],["遣わし","つかわし"],["、"],["『"],["なぜ"],["、"],["私","わたくし"],["を"],["ゲシュル"],["から"],["帰って","かえって"],["来させた","きさせた"],["の"],["です"],["か"],["。"],["あそこ"],["に"],["とどまって"],["いた"],["ほう"],["が"],["、"],["まだ"],["、"],["まし"],["でした"],["のに"],["』"],["と"],["言って","いって"],["もらいたかった"],["の"],["だ"],["。"],["今","いま"],["、"],["私","わたくし"],["は"],["王","おう"],["の"],["顔","かお"],["を"],["拝したい","はいしたい"],["。"],["もし"],["私","わたくし"],["に"],["咎","とが"],["が"],["あるなら"],["、"],["王","おう"],["に"],["殺されて","ころされて"],["も"],["かまわない"],["。"],["」"]]},{"verse":33,"text":"それで、ヨアブは王のところに行き、王に告げたので、王はアブシャロムを呼び寄せた。アブシャロムは王のところに来て、王の前で地にひれ伏して礼をした。王はアブシャロムに口づけした。","tok":[["それ"],["で"],["、"],["ヨアブ"],["は"],["王","おう"],["の"],["ところ"],["に"],["行き","いき"],["、"],["王","おう"],["に"],["告げた","つげた"],["ので"],["、"],["王","おう"],["は"],["アブシャロム"],["を"],["呼び寄せた","よびよせた"],["。"],["アブシャロム"],["は"],["王","おう"],["の"],["ところ"],["に"],["来て","きて"],["、"],["王","おう"],["の"],["前","まえ"],["で"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["礼","れい"],["を"],["した"],["。"],["王","おう"],["は"],["アブシャロム"],["に"],["口づけ","くちづけ"],["した"],["。"]]}]
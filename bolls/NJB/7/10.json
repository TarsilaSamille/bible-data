[{"verse":1,"text":"さて、アビメレクの後、イスラエルを救うために、イッサカル人、ドドの子プワの息子トラが立ち上がった。彼はエフライムの山地にあるシャミルに住んだ。","tok":[["さて"],["、"],["アビメレク"],["の"],["後","あと"],["、"],["イスラエル"],["を"],["救う","すくう"],["ため"],["に"],["、"],["イッサカル"],["人","にん"],["、"],["ドド"],["の"],["子","こ"],["プワ"],["の"],["息子","むすこ"],["トラ"],["が"],["立ち上がった","たちあがった"],["。"],["彼","かれ"],["は"],["エフライム"],["の"],["山地","さんち"],["に"],["ある"],["シャミル"],["に"],["住んだ","すんだ"],["。"]]},{"verse":2,"text":"彼は、二十三年間、イスラエルをさばいて後、死んでシャミルに葬られた。","tok":[["彼","かれ"],["は"],["、"],["二十三","にじゅうさん"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["さばいて"],["後","あと"],["、"],["死んで","しんで"],["シャミル"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":3,"text":"彼の後にギルアデ人ヤイルが立ち上がり、二十二年間、イスラエルをさばいた。","tok":[["彼","かれ"],["の"],["後","あと"],["に"],["ギルアデ"],["人","にん"],["ヤイル"],["が"],["立ち上がり","たちあがり"],["、"],["二十二","にじゅうに"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":4,"text":"彼には三十人の息子がいて、三十頭のろばに乗り、三十の町を持っていたが、それは今日まで、ハボテ・ヤイルと呼ばれ、ギルアデの地にある。","tok":[["彼","かれ"],["に"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["息子","むすこ"],["が"],["いて"],["、"],["三十頭","さんじゅうとう"],["の"],["ろば"],["に"],["乗り","のり"],["、"],["三十","さんじゅう"],["の"],["町","まち"],["を"],["持って","もって"],["いた"],["が"],["、"],["それ"],["は"],["今日","きょう"],["まで"],["、"],["ハボテ"],["・"],["ヤイル"],["と"],["呼ばれ","よばれ"],["、"],["ギルアデ"],["の"],["地","ち"],["に"],["ある"],["。"]]},{"verse":5,"text":"ヤイルは死んでカモンに葬られた。","tok":[["ヤイル"],["は"],["死んで","しんで"],["カモン"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":6,"text":"またイスラエル人は、主の目の前に重ねて悪を行い、バアルや、アシュタロテ、アラムの神々、シドンの神々、モアブの神々、アモン人の神々、ペリシテ人の神々に仕えた。こうして彼らは主を捨て、主に仕えなかった。","tok":[["また"],["イスラエル"],["人","にん"],["は"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["重ねて","かさねて"],["悪","あく"],["を"],["行い","おこない"],["、"],["バアル"],["や"],["、"],["アシュタロテ"],["、"],["アラム"],["の"],["神々","かみがみ"],["、"],["シドン"],["の"],["神々","かみがみ"],["、"],["モアブ"],["の"],["神々","かみがみ"],["、"],["アモン人","あもんにん"],["の"],["神々","かみがみ"],["、"],["ペリシテ"],["人","にん"],["の"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["を"],["捨て","すて"],["、"],["主に","おもに"],["仕えなかった","つかえなかった"],["。"]]},{"verse":7,"text":"主の怒りはイスラエルに向かって燃え上がり、彼らをペリシテ人の手とアモン人の手に売り渡された。","tok":[["主","ぬし"],["の"],["怒り","いかり"],["は"],["イスラエル"],["に"],["向かって","むかって"],["燃え上がり","もえあがり"],["、"],["彼","かれ"],["ら"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["と"],["アモン人","あもんにん"],["の"],["手","て"],["に"],["売り渡された","うりわたされた"],["。"]]},{"verse":8,"text":"それで彼らはその年、イスラエル人を打ち砕き、苦しめた。彼らはヨルダン川の向こう側のギルアデにあるエモリ人の地にいたイスラエル人をみな、十八年の間、苦しめた。","tok":[["それ"],["で"],["彼","かれ"],["ら"],["は"],["その"],["年","とし"],["、"],["イスラエル"],["人","にん"],["を"],["打ち砕き","うちくだき"],["、"],["苦しめた","くるしめた"],["。"],["彼","かれ"],["ら"],["は"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["の"],["ギルアデ"],["に"],["ある"],["エモリ人","えもりにん"],["の"],["地","ち"],["に"],["いた"],["イスラエル"],["人","にん"],["を"],["みな"],["、"],["十八","じゅうはち"],["年","ねん"],["の"],["間","あいだ"],["、"],["苦しめた","くるしめた"],["。"]]},{"verse":9,"text":"アモン人がヨルダン川を渡って、ユダ、ベニヤミン、およびエフライムの家と戦ったとき、イスラエルは非常な苦境に立った。","tok":[["アモン人","あもんにん"],["が"],["ヨルダン"],["川","かわ"],["を"],["渡って","わたって"],["、"],["ユダ"],["、"],["ベニヤミン"],["、"],["および"],["エフライム"],["の"],["家","いえ"],["と"],["戦った","たたかった"],["とき"],["、"],["イスラエル"],["は"],["非常","ひじょう"],["な"],["苦境","くきょう"],["に"],["立った","たった"],["。"]]},{"verse":10,"text":"そのとき、イスラエル人は主に叫んで言った。「私たちは、あなたに罪を犯しました。私たちの神を捨ててバアルに仕えたのです。」","tok":[["その"],["とき"],["、"],["イスラエル"],["人","にん"],["は"],["主に","おもに"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["あなた"],["に"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["を"],["捨てて","すてて"],["バアル"],["に"],["仕えた","つかえた"],["の"],["です"],["。"],["」"]]},{"verse":11,"text":"すると、主はイスラエル人に仰せられた。「わたしは、かつてエジプト人、エモリ人、アモン人、ペリシテ人から、あなたがたを救ったではないか。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["イスラエル"],["人","にん"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["、"],["かつて"],["エジプト"],["人","にん"],["、"],["エモリ人","えもりにん"],["、"],["アモン人","あもんにん"],["、"],["ペリシテ"],["人","にん"],["から"],["、"],["あなた"],["がた"],["を"],["救ったで","すくったで"],["は"],["ない"],["か"],["。"]]},{"verse":12,"text":"シドン人、アマレク人、マオン人が、あなたがたをしいたげたが、あなたがたがわたしに叫んだとき、わたしはあなたがたを彼らの手から救った。","tok":[["シドン人","しどんにん"],["、"],["アマレク"],["人","にん"],["、"],["マオン人","まおんにん"],["が"],["、"],["あなた"],["がた"],["を"],["しいたげた"],["が"],["、"],["あなた"],["がた"],["が"],["わたし"],["に"],["叫んだ","さけんだ"],["とき"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["救った","すくった"],["。"]]},{"verse":13,"text":"しかし、あなたがたはわたしを捨てて、ほかの神々に仕えた。だから、わたしはこれ以上あなたがたを救わない。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["捨てて","すてて"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["。"],["だ"],["から"],["、"],["わたし"],["は"],["これ"],["以上","いじょう"],["あなた"],["がた"],["を"],["救わない","すくわない"],["。"]]},{"verse":14,"text":"行け。そして、あなたがたが選んだ神々に叫べ。あなたがたの苦難の時には、彼らが救うがよい。」","tok":[["行け","いけ"],["。"],["そして"],["、"],["あなた"],["がた"],["が"],["選んだ","えらんだ"],["神々","かみがみ"],["に"],["叫べ","さけべ"],["。"],["あなた"],["がた"],["の"],["苦難","くなん"],["の"],["時","とき"],["に"],["は"],["、"],["彼","かれ"],["ら"],["が"],["救う","すくう"],["が"],["よい"],["。"],["」"]]},{"verse":15,"text":"すると、イスラエル人は主に言った。「私たちは罪を犯しました。あなたがよいと思われることを何でも私たちにしてください。ただ、どうか、きょう、私たちを救い出してください。」","tok":[["する"],["と"],["、"],["イスラエル"],["人","にん"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["あなた"],["が"],["よい"],["と"],["思われる","おもわれる"],["こと"],["を"],["何","なん"],["で"],["も"],["私たち","わたしたち"],["に"],["して"],["ください"],["。"],["ただ"],["、"],["どう"],["か"],["、"],["きょう"],["、"],["私たち","わたしたち"],["を"],["救い出して","すくいだして"],["ください"],["。"],["」"]]},{"verse":16,"text":"彼らが自分たちのうちから外国の神々を取り去って、主に仕えたので、主は、イスラエルの苦しみを見るに忍びなくなった。","tok":[["彼","かれ"],["ら"],["が"],["自分","じぶん"],["たち"],["の"],["うち"],["から"],["外国","がいこく"],["の"],["神々","かみがみ"],["を"],["取り去って","とりさって"],["、"],["主に","おもに"],["仕えた","つかえた"],["ので"],["、"],["主","ぬし"],["は"],["、"],["イスラエル"],["の"],["苦しみ","くるしみ"],["を"],["見る","みる"],["に"],["忍びなく","しのびなく"],["なった"],["。"]]},{"verse":17,"text":"このころ、アモン人が呼び集められ、ギルアデに陣を敷いた。一方、イスラエル人も集まって、ミツパに陣を敷いた。","tok":[["この"],["ころ"],["、"],["アモン人","あもんにん"],["が"],["呼び集められ","よびあつめられ"],["、"],["ギルアデ"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["一方","いっぽう"],[
[{"verse":1,"text":"その後、イスラエル人はまた、主の目の前に悪を行った。エフデは死んでいた。","tok":[["その"],["後","ご"],["、"],["イスラエル"],["人","にん"],["は"],["また"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行った","おこなった"],["。"],["エフデ"],["は"],["死んで","しんで"],["いた"],["。"]]},{"verse":2,"text":"それで、主はハツォルで治めていたカナンの王ヤビンの手に彼らを売り渡した。ヤビンの将軍はシセラで、彼はハロシェテ・ハゴイムに住んでいた。","tok":[["それ"],["で"],["、"],["主","ぬし"],["は"],["ハツォル"],["で"],["治めて","おさめて"],["いた"],["カナン"],["の"],["王","おう"],["ヤビン"],["の"],["手","て"],["に"],["彼","かれ"],["ら"],["を"],["売り渡した","うりわたした"],["。"],["ヤビン"],["の"],["将軍","しょうぐん"],["は"],["シセラ"],["で"],["、"],["彼","かれ"],["は"],["ハロシェテ"],["・"],["ハゴイム"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":3,"text":"彼は鉄の戦車九百両を持ち、そのうえ二十年の間、イスラエル人をひどく圧迫したので、イスラエル人は主に叫び求めた。","tok":[["彼","かれ"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["九百","きゅうひゃく"],["両","りょう"],["を"],["持ち","もち"],["、"],["その"],["うえ"],["二十","にじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["イスラエル"],["人","にん"],["を"],["ひどく"],["圧迫","あっぱく"],["した"],["ので"],["、"],["イスラエル"],["人","にん"],["は"],["主に","おもに"],["叫び","さけび"],["求めた","もとめた"],["。"]]},{"verse":4,"text":"そのころ、ラピドテの妻で女預言者デボラがイスラエルをさばいていた。","tok":[["その"],["ころ"],["、"],["ラピドテ"],["の"],["妻","つま"],["で"],["女","おんな"],["預言者","よげんしゃ"],["デボラ"],["が"],["イスラエル"],["を"],["さばいて"],["いた"],["。"]]},{"verse":5,"text":"彼女はエフライムの山地のラマとベテルとの間にあるデボラのなつめやしの木の下にいつもすわっていたので、イスラエル人は彼女のところに上って来て、さばきを受けた。","tok":[["彼女","かのじょ"],["は"],["エフライム"],["の"],["山地","さんち"],["の"],["ラマ"],["と"],["ベテル"],["と"],["の"],["間","あいだ"],["に"],["ある"],["デボラ"],["の"],["なつめやし"],["の"],["木","き"],["の"],["下","した"],["に"],["いつも"],["すわって"],["いた"],["ので"],["、"],["イスラエル"],["人","にん"],["は"],["彼女","かのじょ"],["の"],["ところ"],["に"],["上って","のぼって"],["来て","きて"],["、"],["さばき"],["を"],["受けた","うけた"],["。"]]},{"verse":6,"text":"あるとき、デボラは使いを送って、ナフタリのケデシュからアビノアムの子バラクを呼び寄せ、彼に言った。「イスラエルの神、主はこう命じられたではありませんか。『タボル山に進軍せよ。ナフタリ族とゼブルン族のうちから一万人を取れ。","tok":[["ある"],["とき"],["、"],["デボラ"],["は"],["使い","つかい"],["を"],["送って","おくって"],["、"],["ナフタリ"],["の"],["ケデシュ"],["から"],["アビノアム"],["の"],["子","こ"],["バラク"],["を"],["呼び寄せ","よびよせ"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["命じられたで","めいじられたで"],["は"],["ありません"],["か"],["。"],["『"],["タボル山","たぼるさん"],["に"],["進軍","しんぐん"],["せよ"],["。"],["ナフタリ"],["族","ぞく"],["と"],["ゼブルン"],["族","ぞく"],["の"],["うち"],["から"],["一万人","いちまんにん"],["を"],["取れ","とれ"],["。"]]},{"verse":7,"text":"わたしはヤビンの将軍シセラとその戦車と大軍とをキション川のあなたのところに引き寄せ、彼をあなたの手に渡す。』」","tok":[["わたし"],["は"],["ヤビン"],["の"],["将軍","しょうぐん"],["シセラ"],["と"],["その"],["戦車","せんしゃ"],["と"],["大軍","たいぐん"],["と"],["を"],["キション"],["川","かわ"],["の"],["あなた"],["の"],["ところ"],["に"],["引き寄せ","ひきよせ"],["、"],["彼","かれ"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["』"],["」"]]},{"verse":8,"text":"バラクは彼女に言った。「もしあなたが私といっしょに行ってくださるなら、行きましょう。しかし、もしあなたが私といっしょに行ってくださらないなら、行きません。」","tok":[["バラク"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["もし"],["あなた"],["が"],["私","わたくし"],["と"],["いっしょ"],["に"],["行って","いって"],["くださるなら"],["、"],["行きましょう","いきましょう"],["。"],["しかし"],["、"],["もし"],["あなた"],["が"],["私","わたくし"],["と"],["いっしょ"],["に"],["行って","いって"],["くださらないなら"],["、"],["行きません","いきません"],["。"],["」"]]},{"verse":9,"text":"そこでデボラは言った。「私は必ずあなたといっしょに行きます。けれども、あなたが行こうとしている道では、あなたは光栄を得ることはできません。主はシセラをひとりの女の手に売り渡されるからです。」こうして、デボラは立ってバラクといっしょにケデシュへ行った。","tok":[["そこ"],["で"],["デボラ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["必ず","かならず"],["あなた"],["と"],["いっしょ"],["に"],["行きます","いきます"],["。"],["けれど"],["も"],["、"],["あなた"],["が"],["行こう","いこう"],["として"],["いる"],["道","みち"],["で"],["は"],["、"],["あなた"],["は"],["光栄","こうえい"],["を"],["得る","える"],["こと"],["は"],["できません"],["。"],["主","ぬし"],["は"],["シセラ"],["を"],["ひとり"],["の"],["女","おんな"],["の"],["手","て"],["に"],["売り渡される","うりわたされる"],["から"],["です"],["。"],["」"],["こう"],["して"],["、"],["デボラ"],["は"],["立って","たって"],["バラク"],["と"],["いっしょ"],["に"],["ケデシュ"],["へ"],["行った","いった"],["。"]]},{"verse":10,"text":"バラクはゼブルンとナフタリをケデシュに呼び集め、一万人を引き連れて上った。デボラも彼といっしょに上った。","tok":[["バラク"],["は"],["ゼブルン"],["と"],["ナフタリ"],["を"],["ケデシュ"],["に"],["呼び集め","よびあつめ"],["、"],["一万人","いちまんにん"],["を"],["引き連れて","ひきつれて"],["上った","のぼった"],["。"],["デボラ"],["も"],["彼","かれ"],["と"],["いっしょ"],["に"],["上った","のぼった"],["。"]]},{"verse":11,"text":"ケニ人ヘベルは、モーセの義兄弟ホバブの子孫のカインから離れて、ケデシュの近くのツァアナニムの樫の木のそばで天幕を張っていた。","tok":[["ケニ"],["人","ひと"],["ヘベル"],["は"],["、"],["モーセ"],["の"],["義","ぎ"],["兄弟","きょうだい"],["ホバブ"],["の"],["子孫","しそん"],["の"],["カイン"],["から"],["離れて","はなれて"],["、"],["ケデシュ"],["の"],["近く","ちかく"],["の"],["ツァアナニム"],["の"],["樫","かし"],["の"],["木","き"],["の"],["そば"],["で"],["天幕","てんまく"],["を"],["張って","はって"],["いた"],["。"]]},{"verse":12,"text":"一方シセラは、アビノアムの子バラクがタボル山に登った、と知らされたので、","tok":[["一方","いっぽう"],["シセラ"],["は"],["、"],["アビノアム"],["の"],["子","こ"],["バラク"],["が"],["タボル山","たぼるさん"],["に"],["登った","のぼった"],["、"],["と"],["知らされた","しらされた"],["ので"],["、"]]},{"verse":13,"text":"シセラは鉄の戦車九百両全部と、自分といっしょにいた民をみな、ハロシェテ・ハゴイムからキション川に呼び集めた。","tok":[["シセラ"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["九百","きゅうひゃく"],["両","りょう"],["全部","ぜんぶ"],["と"],["、"],["自分","じぶん"],["と"],["いっしょ"],["に"],["いた"],["民","たみ"],["を"],["みな"],["、"],["ハロシェテ"],["・"],["ハゴイム"],["から"],["キション"],["川","かわ"],["に"],["呼び集めた","よびあつめた"],["。"]]},{"verse":14,"text":"そこで、デボラはバラクに言った。「さあ、やりなさい。きょう、主があなたの手にシセラを渡される。主はあなたの前に出て行かれるではありませんか。」それで、バラクはタボル山から下り、一万人が彼について行った。","tok":[["そこ"],["で"],["、"],["デボラ"],["は"],["バラク"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["やり"],["なさい"],["。"],["きょう"],["、"],["主","ぬし"],["が"],["あなた"],["の"],["手","て"],["に"],["シセラ"],["を"],["渡される","わたされる"],["。"],["主","ぬし"],["は"],["あなた"],["の"],["前","まえ"],["に"],["出て","でて"],["行かれるで","いかれるで"],["は"],["ありません"],["か"],["。"],["」"],["それ"],["で"],["、"],["バラク"],["は"],["タボル"],["山","やま"],["から"],["下り","くだり"],["、"],["一万人","いちまんにん"],["が"],["彼","かれ"],["について"],["行った","いった"],["。"]]},{"verse":15,"text":"主がシセラとそのすべての戦車と、すべての陣営の者をバラクの前に剣の刃でかき乱したので、シセラは戦車から飛び降り、徒歩で逃げた。","tok":[["主","ぬし"],["が"],["シセラ"],["と"],["その"],["すべて"],["の"],["戦車","せんしゃ"],["と"],["、"],["すべて"],["の"],["陣営","じんえい"],["の"],["者","もの"],["を"],["バラク"],["の"],["前","まえ"],["に"],["剣","けん"],["の"],["刃","は"],["で"],["かき乱した","かきみだした"],["ので"],["、"],["シセラ"],["は"],["戦車","せんしゃ"],["から"],["飛び降り","とびおり"],["、"],["徒歩","とほ"],["で"],["逃げた","にげた"],["。"]]},{"verse":16,"text":"バラクは戦車と陣営をハロシェテ・ハゴイムに追いつめた。こうして、シセラの陣営の者はみな剣の刃に倒れ、残された者はひとりもいなかった。","tok":[["バラク"],["は"],["戦車","せんしゃ"],["と"],["陣営","じんえい"],["を"],["ハロシェテ"],["・"],["ハゴイム"],["に"],["追いつめた","おいつめた"],["。"],["こう"],["して"],["、"],["シセラ"],["の"],["陣営","じんえい"],["の"],["者","もの"],["は"],["みな"],["剣","けん"],["の"],["刃","は"],["に"],["倒れ","たおれ"],["、"],["残された","のこされた"],["者","もの"],["は"],["ひとり"],["も"],["いなかった"],["。"]]},{"verse":17,"text":"しかし、シセラは徒歩でケニ人ヘベルの妻ヤエルの天幕に逃げて来た。ハツォルの王ヤビンとケニ人ヘベルの家とは親しかったからである。","tok":[["しかし"],["、"],["シセラ"],["は"],["徒歩","とほ"],["で"],["ケニ"],["人","ひと"],["ヘベル"],["の"],["妻","つま"],["ヤエル"],["の"],["天幕","てんまく"],["に"],["逃げて","にげて"],["来た","きた"],["。"],["ハツォル"],["の"],["王","おう"],["ヤビン"],["と"],["ケニ"],["人","ひと"],["ヘベル"],["の"],["家","いえ"],["と"],["は"],["親しかった","したしかった"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"ヤエルはシセラを迎えに出て来て、彼に言った。「お立ち寄りください、ご主人さま。私のところにお立ち寄りください。ご心配には及びません。」シセラが彼女の天幕に入ったので、ヤエルは彼に毛布を掛けた。","tok":[["ヤエル"],["は"],["シセラ"],["を"],["迎え","むかえ"],["に"],["出て","でて"],["来て","きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["お立ち寄り","おたちより"],["ください"],["、"],["ご主人","ごしゅじん"],["さま"],["。"],["私","わたくし"],["の"],["ところ"],["に"],["お立ち寄り","おたちより"],["ください"],["。"],["ご心配","ごしんぱい"],["に"],["は"],["及びません","およびません"],["。"],["」"],["シセラ"],["が"],["彼女","かのじょ"],["の"],["天幕","てんまく"],["に"],["入った","はいった"],["ので"],["、"],["ヤエル"],["は"],["彼","かれ"],["に"],["毛布","もうふ"],["を"],["掛けた","かけた"],["。"]]},{"verse":19,"text":"シセラはヤエルに言った。「どうか、水を少し飲ませてください。のどが渇いているから。」ヤエルは乳の皮袋をあけて、彼に飲ませ、また彼をおおった。","tok":[["シセラ"],["は"],["ヤエル"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["水","みず"],["を"],["少し","すこし"],["飲ませて","のませて"],["ください"],["。"],["のど"],["が"],["渇いて","かわいて"],["いる"],["から"],["。"],["」"],["ヤエル"],["は"],["乳","ちち"],["の"],["皮袋","かわぶくろ"],["を"],["あけて"],["、"],["彼","かれ"],["に"],["飲ませ","のませ"],["、"],["また"],["彼","かれ"],["を"],["おおった"],["。"]]},{"verse":20,"text":"シセラはまた彼女に言った。「天幕の入口に立っていてください。もしだれかが来て、『ここにだれかいないか』とあなたに尋ねたら、『いない』と言ってください。」","tok":[["シセラ"],["は"],["また"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["立って","たって"],["いて"],["ください"],["。"],["もし"],["だれ"],["か"],["が"],["来て","きて"],["、"],["『"],["ここ"],["に"],["だれ"],["か"],["いない"],["か"],["』"],["と"],["あなた"],["に"],["尋ねたら","たずねたら"],["、"],["『"],["いない"],["』"],["と"],["言って","いって"],["ください"],["。"],["」"]]},{"verse":21,"text":"だが、ヘベルの妻ヤエルは天幕の鉄のくいを取ると、手に槌を持ってそっと彼のところへ近づき、彼のこめかみに鉄のくいを打ち込んで地に刺し通した。彼は疲れていたので、熟睡していた。こうして彼は死んだ。","tok":[["だ"],["が"],["、"],["ヘベル"],["の"],["妻","つま"],["ヤエル"],["は"],["天幕","てんまく"],["の"],["鉄","てつ"],["の"],["くい"],["を"],["取る","とる"],["と"],["、"],["手","て"],["に"],["槌","つち"],["を"],["持って","もって"],["そっと"],["彼","かれ"],["の"],["ところ"],["へ"],["近づき","ちかづき"],["、"],["彼","かれ"],["の"],["こめかみ"],["に"],["鉄","てつ"],["の"],["くい"],["を"],["打ち込んで","うちこんで"],["地","ち"],["に"],["刺し通した","さしとおした"],["。"],["彼","かれ"],["は"],["疲れて","つかれて"],["いた"],["ので"],["、"],["熟睡","じゅくすい"],["して"],["いた"],["。"],["こう"],["して"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":22,"text":"ちょうどその時、バラクがシセラを追って来たので、ヤエルは彼を迎えに出て、言った。「さあ、あなたの捜している人をお見せしましょう。」彼がヤエルのところに来ると、そこに、シセラは倒れて死んでおり、そのこめかみには鉄のくいが刺さっていた。","tok":[["ちょうど"],["その"],["時","とき"],["、"],["バラク"],["が"],["シセラ"],["を"],["追って","おって"],["来た","きた"],["ので"],["、"],["ヤエル"],["は"],["彼","かれ"],["を"],["迎え","むかえ"],["に"],["出て","でて"],["、"],["言った","いった"],["。"],["「"],["さあ"],["、"],["あなた"],["の"],["捜して","さがして"],["いる"],["人","ひと"],["を"],["お見せ","おみせ"],["しましょう"],["。"],["」"],["彼","かれ"],["が"],["ヤエル"],["の"],["ところ"],["に"],["来る","くる"],["と"],["、"],["そこ"],["に"],["、"],["シセラ"],["は"],["倒れて","たおれて"],["死んで","しんで"],["おり"],["、"],["その"],["こめかみ"],["に"],["は"],["鉄","てつ"],["の"],["くい"],["が"],["刺さって","ささって"],["いた"],["。"]]},{"verse":23,"text":"こうして神はその日、イスラエル人の前でカナンの王ヤビンを服従させた。","tok":[["こう"],["して"],["神","かみ"],["は"],["その"],["日","ひ"],["、"],["イスラエル"],["人","にん"],["の"],["前","まえ"],["で"],["カナン"],["の"],["王","おう"],["ヤビン"],["を"],["服従","ふくじゅう"],["させた"],["。"]]},{"verse":24,"text":"それから、イスラエル人の勢力がますますカナンの王ヤビンを圧するようになり、ついにカナンの王ヤビンを断ち滅ぼした。","tok":[["それ"],["から"],["、"],["イスラエル"],["人","にん"],["の"],["勢力","せいりょく"],["が"],["ますます"],["カナン"],["の"],["王","おう"],["ヤビン"],["を"]
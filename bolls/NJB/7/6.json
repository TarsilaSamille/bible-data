[{"verse":1,"text":"イスラエル人はまた、主の目の前に悪を行った。そこで、主は七年の間、彼らをミデヤン人の手に渡した。","tok":[["イスラエル"],["人","にん"],["は"],["また"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行った","おこなった"],["。"],["そこ"],["で"],["、"],["主","ぬし"],["は"],["七","なな"],["年","ねん"],["の"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["を"],["ミデヤン"],["人","にん"],["の"],["手","て"],["に"],["渡した","わたした"],["。"]]},{"verse":2,"text":"こうして、ミデヤン人の勢力はイスラエルを押さえたので、イスラエル人はミデヤン人を避けて、山々にある洞窟や、ほら穴や、要害を自分たちのものにした。","tok":[["こう"],["して"],["、"],["ミデヤン"],["人","にん"],["の"],["勢力","せいりょく"],["は"],["イスラエル"],["を"],["押さえた","おさえた"],["ので"],["、"],["イスラエル"],["人","にん"],["は"],["ミデヤン"],["人","にん"],["を"],["避けて","さけて"],["、"],["山々","やまやま"],["に"],["ある"],["洞窟","どうくつ"],["や"],["、"],["ほら穴","ほらあな"],["や"],["、"],["要害","ようがい"],["を"],["自分","じぶん"],["たち"],["の"],["もの"],["に"],["した"],["。"]]},{"verse":3,"text":"イスラエル人が種を蒔くと、いつでもミデヤン人や、アマレク人や、東の人々が上って来て、イスラエル人を襲った。","tok":[["イスラエル"],["人","にん"],["が"],["種","たね"],["を"],["蒔く","まく"],["と"],["、"],["いつ"],["で"],["も"],["ミデヤン"],["人","にん"],["や"],["、"],["アマレク"],["人","にん"],["や"],["、"],["東","ひがし"],["の"],["人々","ひとびと"],["が"],["上って","のぼって"],["来て","きて"],["、"],["イスラエル"],["人","にん"],["を"],["襲った","おそった"],["。"]]},{"verse":4,"text":"そしてイスラエル人に対して陣を敷き、その地の産物を荒らして、ガザに至るまで、イスラエルに羊や牛やろばのためのえささえも残さなかった。","tok":[["そして"],["イスラエル"],["人","にん"],["に対して","にたいして"],["陣","じん"],["を"],["敷き","しき"],["、"],["その"],["地","ち"],["の"],["産物","さんぶつ"],["を"],["荒らして","あらして"],["、"],["ガザ"],["に"],["至る","いたる"],["まで"],["、"],["イスラエル"],["に"],["羊","ひつじ"],["や"],["牛","うし"],["や"],["ろば"],["の"],["ため"],["の"],["えさ"],["さえ"],["も"],["残さなかった","のこさなかった"],["。"]]},{"verse":5,"text":"彼らが自分たちの家畜と天幕を持って上って来たからである。彼らはいなごの大群のようにしてやって来た。彼らとそのらくだは数えきれないほどであった。しかも、彼らは国を荒らすために入って来たのであった。","tok":[["彼","かれ"],["ら"],["が"],["自分","じぶん"],["たち"],["の"],["家畜","かちく"],["と"],["天幕","てんまく"],["を"],["持って","もって"],["上って","のぼって"],["来た","きた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["いなご"],["の"],["大群","たいぐん"],["の"],["よう"],["に"],["して"],["やって"],["来た","きた"],["。"],["彼","かれ"],["ら"],["と"],["その"],["らくだ"],["は"],["数え","かぞえ"],["きれない"],["ほど"],["で"],["あった"],["。"],["しかも"],["、"],["彼","かれ"],["ら"],["は"],["国","くに"],["を"],["荒らす","あらす"],["ため"],["に"],["入って","はいって"],["来た","きた"],["ので"],["あった"],["。"]]},{"verse":6,"text":"それで、イスラエルはミデヤン人のために非常に弱くなっていった。すると、イスラエル人は主に叫び求めた。","tok":[["それ"],["で"],["、"],["イスラエル"],["は"],["ミデヤン"],["人","にん"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["弱く","よわく"],["なって"],["いった"],["。"],["する"],["と"],["、"],["イスラエル"],["人","にん"],["は"],["主に","おもに"],["叫び","さけび"],["求めた","もとめた"],["。"]]},{"verse":7,"text":"イスラエル人がミデヤン人のために主に叫び求めたとき、","tok":[["イスラエル"],["人","にん"],["が"],["ミデヤン"],["人","にん"],["の"],["ため"],["に"],["主に","おもに"],["叫び","さけび"],["求めた","もとめた"],["とき"],["、"]]},{"verse":8,"text":"主はイスラエル人にひとりの預言者を遣わした。預言者は彼らに言った。「イスラエルの神、主はこう仰せられる。／わたしはあなたがたをエジプトから上らせ、あなたがたを奴隷の家から連れ出した。","tok":[["主","ぬし"],["は"],["イスラエル"],["人","にん"],["に"],["ひとり"],["の"],["預言者","よげんしゃ"],["を"],["遣わした","つかわした"],["。"],["預言者","よげんしゃ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["わたし"],["は"],["あなた"],["がた"],["を"],["エジプト"],["から"],["上らせ","のぼらせ"],["、"],["あなた"],["がた"],["を"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["連れ出した","つれだした"],["。"]]},{"verse":9,"text":"わたしはあなたがたをエジプト人の手と、すべてあなたがたを圧迫する者の手から助け出し、あなたがたの前から彼らを追い出して、その国をあなたがたに与えた。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["エジプト"],["人","にん"],["の"],["手","て"],["と"],["、"],["すべて"],["あなた"],["がた"],["を"],["圧迫","あっぱく"],["する"],["者","もの"],["の"],["手","て"],["から"],["助け出し","たすけだし"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い出して","おいだして"],["、"],["その"],["国","くに"],["を"],["あなた"],["がた"],["に"],["与えた","あたえた"],["。"]]},{"verse":10,"text":"それでわたしはあなたがたに言った。『わたしはあなたがたの神、主である。あなたがたが住んでいる国のエモリ人の神々を恐れてはならない。』ところが、あなたがたはわたしの声に聞き従わなかった。」","tok":[["それ"],["で"],["わたし"],["は"],["あなた"],["がた"],["に"],["言った","いった"],["。"],["『"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"],["あなた"],["がた"],["が"],["住んで","すんで"],["いる"],["国","くに"],["の"],["エモリ人","えもりにん"],["の"],["神々","かみがみ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["』"],["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["声","こえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"],["」"]]},{"verse":11,"text":"さて主の使いが来て、アビエゼル人ヨアシュに属するオフラにある樫の木の下にすわった。このとき、ヨアシュの子ギデオンはミデヤン人からのがれて、酒ぶねの中で小麦を打っていた。","tok":[["さて"],["主","ぬし"],["の"],["使い","つかい"],["が"],["来て","きて"],["、"],["アビエゼル"],["人","にん"],["ヨアシュ"],["に"],["属する","ぞくする"],["オフラ"],["に"],["ある"],["樫","かし"],["の"],["木","き"],["の"],["下","した"],["に"],["すわった"],["。"],["この"],["とき"],["、"],["ヨアシュ"],["の"],["子","こ"],["ギデオン"],["は"],["ミデヤン"],["人","にん"],["から"],["のがれて"],["、"],["酒","さけ"],["ぶね"],["の"],["中","なか"],["で"],["小麦","こむぎ"],["を"],["打って","うって"],["いた"],["。"]]},{"verse":12,"text":"主の使いが彼に現れて言った。「勇士よ。主があなたといっしょにおられる。」","tok":[["主","ぬし"],["の"],["使い","つかい"],["が"],["彼","かれ"],["に"],["現れて","あらわれて"],["言った","いった"],["。"],["「"],["勇士","ゆうし"],["よ"],["。"],["主","ぬし"],["が"],["あなた"],["と"],["いっしょ"],["に"],["おられる"],["。"],["」"]]},{"verse":13,"text":"ギデオンはその御使いに言った。「ああ、主よ。もし主が私たちといっしょにおられるなら、なぜこれらのことがみな、私たちに起こったのでしょうか。私たちの先祖たちが、『主は私たちをエジプトから上らせたではないか』と言って、私たちに話したあの驚くべきみわざはみな、どこにありますか。今、主は私たちを捨てて、ミデヤン人の手に渡されました。」","tok":[["ギデオン"],["は"],["その"],["御使い","おつかい"],["に"],["言った","いった"],["。"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["。"],["もし"],["主","ぬし"],["が"],["私たち","わたしたち"],["と"],["いっしょ"],["に"],["おられるなら"],["、"],["なぜ"],["これ"],["ら"],["の"],["こと"],["が"],["みな"],["、"],["私たち","わたしたち"],["に"],["起こった","おこった"],["の"],["でしょう"],["か"],["。"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["たち"],["が"],["、"],["『"],["主","ぬし"],["は"],["私たち","わたしたち"],["を"],["エジプト"],["から"],["上らせたで","のぼらせたで"],["は"],["ない"],["か"],["』"],["と"],["言って","いって"],["、"],["私たち","わたしたち"],["に"],["話した","はなした"],["あの"],["驚くべき","おどろくべき"],["みわざ"],["は"],["みな"],["、"],["どこ"],["に"],["あります"],["か"],["。"],["今","いま"],["、"],["主","ぬし"],["は"],["私たち","わたしたち"],["を"],["捨てて","すてて"],["、"],["ミデヤン"],["人","にん"],["の"],["手","て"],["に"],["渡されました","わたされました"],["。"],["」"]]},{"verse":14,"text":"すると、主は彼に向かって仰せられた。「あなたのその力で行き、イスラエルをミデヤン人の手から救え。わたしがあなたを遣わすのではないか。」","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["彼","かれ"],["に"],["向かって","むかって"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["その"],["力","ちから"],["で"],["行き","いき"],["、"],["イスラエル"],["を"],["ミデヤン"],["人","にん"],["の"],["手","て"],["から"],["救え","すくえ"],["。"],["わたし"],["が"],["あなた"],["を"],["遣わす","つかわす"],["ので"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":15,"text":"ギデオンは言った。「ああ、主よ。私にどのようにしてイスラエルを救うことができましょう。ご存じのように、私の分団はマナセのうちで最も弱く、私は父の家で一番若いのです。」","tok":[["ギデオン"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["に"],["どの"],["よう"],["に"],["して"],["イスラエル"],["を"],["救う","すくう"],["こと"],["が"],["できましょう"],["。"],["ご存じ","ごぞんじ"],["の"],["よう"],["に"],["、"],["私","わたくし"],["の"],["分団","ぶんだん"],["は"],["マナセ"],["の"],["うち"],["で"],["最も","もっとも"],["弱く","よわく"],["、"],["私","わたくし"],["は"],["父","ちち"],["の"],["家","いえ"],["で"],["一番","いちばん"],["若い","わかい"],["の"],["です"],["。"],["」"]]},{"verse":16,"text":"主はギデオンに仰せられた。「わたしはあなたといっしょにいる。だからあなたはひとりを打ち殺すようにミデヤン人を打ち殺そう。」","tok":[["主","ぬし"],["は"],["ギデオン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["あなた"],["と"],["いっしょ"],["に"],["いる"],["。"],["だ"],["から"],["あなた"],["は"],["ひとり"],["を"],["打ち殺す","うちころす"],["よう"],["に"],["ミデヤン"],["人","にん"],["を"],["打ち殺そう","うちころそう"],["。"],["」"]]},{"verse":17,"text":"すると、ギデオンは言った。「お願いです。私と話しておられるのがあなたであるというしるしを、私に見せてください。","tok":[["する"],["と"],["、"],["ギデオン"],["は"],["言った","いった"],["。"],["「"],["お願い","おねがい"],["です"],["。"],["私","わたくし"],["と"],["話して","はなして"],["おられる"],["の"],["が"],["あなた"],["で"],["ある"],["と"],["いう"],["しるし"],["を"],["、"],["私","わたくし"],["に"],["見せて","みせて"],["ください"],["。"]]},{"verse":18,"text":"どうか、私が贈り物を持って来て、あなたのところに戻り、御前にそれを供えるまで、ここを離れないでください。」それで、主は、「あなたが戻って来るまで待とう」と仰せられた。","tok":[["どう"],["か"],["、"],["私","わたくし"],["が"],["贈り物","おくりもの"],["を"],["持って","もって"],["来て","きて"],["、"],["あなた"],["の"],["ところ"],["に"],["戻り","もどり"],["、"],["御前","ごぜん"],["に"],["それ"],["を"],["供える","そなえる"],["まで"],["、"],["ここ"],["を"],["離れないで","はなれないで"],["ください"],["。"],["」"],["それ"],["で"],["、"],["主","ぬし"],["は"],["、"],["「"],["あなた"],["が"],["戻って","もどって"],["来る","くる"],["まで"],["待とう","まとう"],["」"],["と"],["仰せられた","おおせられた"],["。"]]},{"verse":19,"text":"ギデオンはうちに入り、一匹のやぎの子を料理し、一エパの粉で種を入れないパンを作り、その肉をかごに入れ、また吸い物をなべに入れ、樫の木の下にいる方のところに持って来て、供えた。","tok":[["ギデオン"],["は"],["うち"],["に"],["入り","はいり"],["、"],["一匹","いちひき"],["の"],["やぎ"],["の"],["子","こ"],["を"],["料理","りょうり"],["し"],["、"],["一","いち"],["エパ"],["の"],["粉","こな"],["で"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["を"],["作り","つくり"],["、"],["その"],["肉","にく"],["を"],["かご"],["に"],["入れ","いれ"],["、"],["また"],["吸い物","すいもの"],["を"],["なべ"],["に"],["入れ","いれ"],["、"],["樫","かし"],["の"],["木","き"],["の"],["下","した"],["に"],["いる"],["方","かた"],["の"],["ところ"],["に"],["持って","もって"],["来て","きて"],["、"],["供えた","そなえた"],["。"]]},{"verse":20,"text":"すると、神の使いはギデオンに言った。「肉と種を入れないパンを取って、この岩の上に置き、その吸い物を注げ。」それで彼はそのようにした。","tok":[["する"],["と"],["、"],["神","かみ"],["の"],["使い","つかい"],["は"],["ギデオン"],["に"],["言った","いった"],["。"],["「"],["肉","にく"],["と"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["を"],["取って","とって"],["、"],["この"],["岩","いわ"],["の"],["上","うえ"],["に"],["置き","おき"],["、"],["その"],["吸い物","すいもの"],["を"],["注げ","そそげ"],["。"],["」"],["それ"],["で"],["彼","かれ"],["は"],["その"],["よう"],["に"],["した"],["。"]]},{"verse":21,"text":"すると主の使いは、その手にしていた杖の先を伸ばして、肉と種を入れないパンに触れた。すると、たちまち火が岩から燃え上がって、肉と種を入れないパンを焼き尽くしてしまった。主の使いは去って見えなくなった。","tok":[["する"],["と"],["主","ぬし"],["の"],["使い","つかい"],["は"],["、"],["その"],["手","て"],["に"],["して"],["いた"],["杖","つえ"],["の"],["先","さき"],["を"],["伸ばして","のばして"],["、"],["肉","にく"],["と"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["に"],["触れた","ふれた"],["。"],["する"],["と"],["、"],["たちまち"],["火","ひ"],["が"],["岩","いわ"],["から"],["燃え上がって","もえあがって"],["、"],["肉","にく"],["と"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["を"],["焼き","やき"],["尽くして","つくして"],["しまった"],["。"],["主","ぬし"],["の"],["使い","つかい"],["は"],["去って","さって"],["見えなく","みえなく"],["なった"],["。"]]},{"verse":22,"text":"これで、この方が主の使いであったことがわかった。それで、ギデオンは言った。「ああ、神、主よ。私は面と向かって主の使いを見てしまいました。」","tok":[["これ"],["で"],["、"],["この"],["方","ほう"],["が"],["主","ぬし"],["の"],["使い","つかい"],["で"],["あった"],["こと"],["が"],["わかった"],["。"],["それ"],["で"],["、"],["ギデオン"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["面","めん"],["と"],["向かって","むかって"],["主","ぬし"],["の"],["使い","つかい"],["を"],["見て","みて"],["しまいました"],["。"],["」"]]},{"verse":23,"text":"すると、主はギデオンに仰せられた。「安心しなさい。恐れるな。あなたは死なない。」","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["ギデオン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["安心","あんしん"],["し"],["なさい"],["。"],["恐れる","おそれる"],["な"],["。"],["あなた"],["は"],["死なない","しなない"],["。"],["」"]]},{"verse":24,"text":"そこで、ギデオンはそこに主のために祭壇を築いて、これをアドナイ・シャロムと名づけた。これは今日まで、アビエゼル人のオフラに残っている。","tok":[["そこ"],["で"],["、"],["ギデオン"],["は"],["そこ"],["に"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["これ"],["を"],["アドナイ"],["・"],["シャロム"],["と"],["名づけた","なづけた"],["。"],["これ"],["は"],["今日","きょう"],["まで"],["、"],["アビエゼル"],["人","にん"],["の"],["オフラ"],["に"],["残って","のこって"],["いる"],["。"]]},{"verse":25,"text":"その夜、主はギデオンに仰せられた。「あなたの父の雄牛、七歳の第二の雄牛を取り、あなたの父が持っているバアルの祭壇を取りこわし、そのそばのアシェラ像を切り倒せ。","tok":[["その"],["夜","よる"],["、"],["主","ぬし"],["は"],["ギデオン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["父","ちち"],["の"],["雄牛","おうし"],["、"],["七歳","ななさい"],["の"],["第","だい"],["二","に"],["の"],["雄牛","おうし"],["を"],["取り","とり"],["、"],["あなた"],["の"],["父","ちち"],["が"],["持って","もって"],["いる"],["バアル"],["の"],["祭壇","さいだん"],["を"],["取りこわし","とりこわし"],["、"],["その"],["そば"],["の"],["アシェラ"],["像","ぞう"],["を"],["切り倒せ","きりたおせ"],["。"]]},{"verse":26,"text":"そのとりでの頂上に、あなたの神、主のために石を積んで祭壇を築け。あの第二の雄牛を取り、切り倒したアシェラ像の木で全焼のいけにえをささげよ。」","tok":[["その"],["とりで"],["の"],["頂上","ちょうじょう"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["石","いし"],["を"],["積んで","つんで"],["祭壇","さいだん"],["を"],["築け","きずけ"],["。"],["あの"],["第","だい"],["二","に"],["の"],["雄牛","おうし"],["を"],["取り","とり"],["、"],["切り倒した","きりたおした"],["アシェラ"],["像","ぞう"],["の"],["木","き"],["で"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげ"],["よ"],["。"],["」"]]},{"verse":27,"text":"そこで、ギデオンは、自分のしもべの中から十人を引き連れて、主が言われたとおりにした。彼は父の家の者や、町の人々を恐れたので、昼間それをせず、夜それを行った。","tok":[["そこ"],["で"],["、"],["ギデオン"],["は"],["、"],["自分","じぶん"],["の"],["しもべ"],["の"],["中","なか"],["から"],["十人","じゅうにん"],["を"],["引き連れて","ひきつれて"],["、"],["主","ぬし"],["が"],["言われた","いわれた"],["とおり"],["に"],["した"],["。"],["彼","かれ"],["は"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["や"],["、"],["町","まち"],["の"],["人々","ひとびと"],["を"],["恐れた","おそれた"],["ので"],["、"],["昼間","ひるま"],["それ"],["を"],["せず"],["、"],["夜","よる"],["それ"],["を"],["行った","おこなった"],["。"]]},{"verse":28,"text":"町の人々が翌朝早く起きて見ると、バアルの祭壇は取りこわされ、そのそばにあったアシェラ像は切り倒され、新しく築かれた祭壇の上には、第二の雄牛がささげられていた。","tok":[["町","まち"],["の"],["人々","ひとびと"],["が"],["翌朝","よくあさ"],["早く","はやく"],["起きて","おきて"],["見る","みる"],["と"],["、"],["バアル"],["の"],["祭壇","さいだん"],["は"],["取りこわされ","とりこわされ"],["、"],["その"],["そば"],["に"],["あった"],["アシェラ"],["像","ぞう"],["は"],["切り倒され","きりたおされ"],["、"],["新しく","あたらしく"],["築かれた","きずかれた"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["は"],["、"],["第","だい"],["二","に"],["の"],["雄牛","おうし"],["が"],["ささげられて"],["いた"],["。"]]},{"verse":29,"text":"そこで、彼らは互いに言った。「だれがこういうことをしたのだろう。」それから、彼らは調べて、尋ね回り、「ヨアシュの子ギデオンがこれをしたのだ」と言った。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["だれ"],["が"],["こう"],["いう"],["こと"],["を"],["した"],["の"],["だろう"],["。"],["」"],["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["調べて","しらべて"],["、"],["尋ね回り","たずねまわり"],["、"],["「"],["ヨアシュ"],["の"],["子","こ"],["ギデオン"],["が"],["これ"],["を"],["した"],["の"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":30,"text":"ついで、町の人々はヨアシュに言った。「あなたの息子を引っ張り出して殺しなさい。あれはバアルの祭壇を取りこわし、そばにあったアシェラ像も切り倒したのだ。」","tok":[["つい"],["で"],["、"],["町","まち"],["の"],["人々","ひとびと"],["は"],["ヨアシュ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["息子","むすこ"],["を"],["引っ張り","ひっぱり"],["出して","だして"],["殺し","ころし"],["なさい"],["。"],["あれ"],["は"],["バアル"],["の"],["祭壇","さいだん"],["を"],["取りこわし","とりこわし"],["、"],["そば"],["に"],["あった"],["アシェラ"],["像","ぞう"],["も"],["切り倒した","きりたおした"],["の"],["だ"],["。"],["」"]]},{"verse":31,"text":"すると、ヨアシュは自分に向かって立っているすべての者に言った。「あなたがたは、バアルのために争っているのか。それとも、彼を救おうとするのか。バアルのために争う者は、朝までに殺されてしまう。もしバアルが神であるなら、自分の祭壇が取りこわされたのだから、自分で争えばよいのだ。」","tok":[["する"],["と"],["、"],["ヨアシュ"],["は"],["自分","じぶん"],["に"],["向かって","むかって"],["立って","たって"],["いる"],["す
[{"verse":1,"text":"それで、エルバアル、すなわちギデオンと、彼といっしょにいた民はみな、朝早くハロデの泉のそばに陣を敷いた。ミデヤン人の陣営は、彼の北に当たり、モレの山沿いの谷にあった。","tok":[["それ"],["で"],["、"],["エルバアル"],["、"],["すなわち"],["ギデオン"],["と"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["いた"],["民","たみ"],["は"],["みな"],["、"],["朝","あさ"],["早く","はやく"],["ハロデ"],["の"],["泉","いずみ"],["の"],["そば"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["ミデヤン"],["人","にん"],["の"],["陣営","じんえい"],["は"],["、"],["彼","かれ"],["の"],["北","きた"],["に"],["当たり","あたり"],["、"],["モレ"],["の"],["山沿い","やまぞい"],["の"],["谷","たに"],["に"],["あった"],["。"]]},{"verse":2,"text":"そのとき、主はギデオンに仰せられた。「あなたといっしょにいる民は多すぎるから、わたしはミデヤン人を彼らの手に渡さない。イスラエルが『自分の手で自分を救った』と言って、わたしに向かって誇るといけないから。","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["ギデオン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["と"],["いっしょ"],["に"],["いる"],["民","たみ"],["は"],["多","おお"],["すぎる"],["から"],["、"],["わたし"],["は"],["ミデヤン"],["人","にん"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡さない","わたさない"],["。"],["イスラエル"],["が"],["『"],["自分","じぶん"],["の"],["手","て"],["で"],["自分","じぶん"],["を"],["救った","すくった"],["』"],["と"],["言って","いって"],["、"],["わたし"],["に"],["向かって","むかって"],["誇る","ほこる"],["と"],["いけない"],["から"],["。"]]},{"verse":3,"text":"今、民に聞こえるように告げ、『恐れ、おののく者はみな帰りなさい。ギルアデ山から離れなさい』と言え。」すると、民のうちから二万二千人が帰って行き、一万人が残った。4すると、主はギデオンに仰せられた。「民はまだ多すぎる。彼らを連れて水のところに下って行け。わたしはそこで、あなたのために彼らをためそう。わたしがあなたに、『この者はあなたといっしょに行かなければならない』と言うなら、その者は、あなたといっしょに行かなければならない。またわたしがあなたに、『この者はあなたといっしょに行ってはならない』と言う者はだれも、行ってはならない。」","tok":[["今","いま"],["、"],["民","みん"],["に"],["聞こえる","きこえる"],["よう"],["に"],["告げ","つげ"],["、"],["『"],["恐れ","おそれ"],["、"],["おののく"],["者","もの"],["は"],["みな"],["帰り","かえり"],["なさい"],["。"],["ギルアデ"],["山","やま"],["から"],["離れ","はなれ"],["なさい"],["』"],["と"],["言え","いえ"],["。"],["」"],["する"],["と"],["、"],["民","みん"],["の"],["うち"],["から"],["二万二千","にまんにせん"],["人","にん"],["が"],["帰って","かえって"],["行き","いき"],["、"],["一万人","いちまんにん"],["が"],["残った","のこった"],["。"],["4"],["する"],["と"],["、"],["主","ぬし"],["は"],["ギデオン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["民","みん"],["は"],["まだ"],["多","おお"],["すぎる"],["。"],["彼","かれ"],["ら"],["を"],["連れて","つれて"],["水","みず"],["の"],["ところ"],["に"],["下って","くだって"],["行け","いけ"],["。"],["わたし"],["は"],["そこ"],["で"],["、"],["あなた"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["ため"],["そう"],["。"],["わたし"],["が"],["あなた"],["に"],["、"],["『"],["この"],["者","もの"],["は"],["あなた"],["と"],["いっしょ"],["に"],["行かなければ","いかなければ"],["ならない"],["』"],["と"],["言うなら","ゆうなら"],["、"],["その"],["者","もの"],["は"],["、"],["あなた"],["と"],["いっしょ"],["に"],["行かなければ","いかなければ"],["ならない"],["。"],["また"],["わたし"],["が"],["あなた"],["に"],["、"],["『"],["この"],["者","もの"],["は"],["あなた"],["と"],["いっしょ"],["に"],["行って","いって"],["は"],["ならない"],["』"],["と"],["言う","いう"],["者","もの"],["は"],["だれ"],["も"],["、"],["行って","いって"],["は"],["ならない"],["。"],["」"]]},{"verse":5,"text":"そこでギデオンは民を連れて、水のところに下って行った。すると、主はギデオンに仰せられた。「犬がなめるように、舌で水をなめる者は残らず別にしておき、また、ひざをついて飲む者も残らずそうせよ。」","tok":[["そこ"],["で"],["ギデオン"],["は"],["民","みん"],["を"],["連れて","つれて"],["、"],["水","みず"],["の"],["ところ"],["に"],["下って","くだって"],["行った","いった"],["。"],["する"],["と"],["、"],["主","ぬし"],["は"],["ギデオン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["犬","いぬ"],["が"],["なめる"],["よう"],["に"],["、"],["舌","した"],["で"],["水","みず"],["を"],["なめる"],["者","もの"],["は"],["残らず","のこらず"],["別","べつ"],["に"],["して"],["おき"],["、"],["また"],["、"],["ひざ"],["を"],["ついて"],["飲む","のむ"],["者","もの"],["も"],["残らず","のこらず"],["そう"],["せよ"],["。"],["」"]]},{"verse":6,"text":"そのとき、口に手を当てて水をなめた者の数は三百人であった。残りの民はみな、ひざをついて水を飲んだ。","tok":[["その"],["とき"],["、"],["口","くち"],["に"],["手","て"],["を"],["当てて","あてて"],["水","みず"],["を"],["なめた"],["者","もの"],["の"],["数","かず"],["は"],["三百人","さんひゃくにん"],["で"],["あった"],["。"],["残り","のこり"],["の"],["民","たみ"],["は"],["みな"],["、"],["ひざ"],["を"],["ついて"],["水","みず"],["を"],["飲んだ","のんだ"],["。"]]},{"verse":7,"text":"そこで主はギデオンに仰せられた。「手で水をなめた三百人で、わたしはあなたがたを救い、ミデヤン人をあなたの手に渡す。残りの民はみな、それぞれ自分の家に帰らせよ。」","tok":[["そこ"],["で"],["主","ぬし"],["は"],["ギデオン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["手","て"],["で"],["水","みず"],["を"],["なめた"],["三百人","さんひゃくにん"],["で"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["救い","すくい"],["、"],["ミデヤン"],["人","にん"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["残り","のこり"],["の"],["民","たみ"],["は"],["みな"],["、"],["それぞれ"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰らせ","かえらせ"],["よ"],["。"],["」"]]},{"verse":8,"text":"そこで彼らは民の糧食と角笛を手に取った。こうして、ギデオンはイスラエル人をみな、それぞれ自分の天幕に送り返し、三百人の者だけを引き止めた。ミデヤン人の陣営は、彼から見て下の谷にあった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["民","みん"],["の"],["糧食","りょうしょく"],["と"],["角笛","つのぶえ"],["を"],["手","て"],["に"],["取った","とった"],["。"],["こう"],["して"],["、"],["ギデオン"],["は"],["イスラエル"],["人","にん"],["を"],["みな"],["、"],["それぞれ"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["送り返し","おくりかえし"],["、"],["三百人","さんひゃくにん"],["の"],["者","もの"],["だけ"],["を"],["引き止めた","ひきとめた"],["。"],["ミデヤン"],["人","にん"],["の"],["陣営","じんえい"],["は"],["、"],["彼","かれ"],["から"],["見て","みて"],["下","した"],["の"],["谷","たに"],["に"],["あった"],["。"]]},{"verse":9,"text":"その夜、主はギデオンに仰せられた。「立って、あの陣営に攻め下れ。それをあなたの手に渡したから。","tok":[["その"],["夜","よる"],["、"],["主","ぬし"],["は"],["ギデオン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["立って","たって"],["、"],["あの"],["陣営","じんえい"],["に"],["攻め下れ","せめくだれ"],["。"],["それ"],["を"],["あなた"],["の"],["手","て"],["に"],["渡した","わたした"],["から"],["。"]]},{"verse":10,"text":"しかし、もし下って行くことを恐れるなら、あなたに仕える若い者プラといっしょに陣営に下って行き、","tok":[["しかし"],["、"],["もし"],["下って","くだって"],["行く","いく"],["こと"],["を"],["恐れるなら","おそれるなら"],["、"],["あなた"],["に"],["仕える","つかえる"],["若い","わかい"],["者","もの"],["プラ"],["と"],["いっしょ"],["に"],["陣営","じんえい"],["に"],["下って","くだって"],["行き","いき"],["、"]]},{"verse":11,"text":"彼らが何と言っているかを聞け。そのあとで、あなたは、勇気を出して、陣営に攻め下らなければならない。」そこで、ギデオンと若い者プラとは、陣営の中の編隊の端に下って行った。","tok":[["彼","かれ"],["ら"],["が"],["何","なん"],["と"],["言って","いって"],["いる"],["か"],["を"],["聞け","きけ"],["。"],["その"],["あと"],["で"],["、"],["あなた"],["は"],["、"],["勇気","ゆうき"],["を"],["出して","だして"],["、"],["陣営","じんえい"],["に"],["攻め下らなければ","せめくだらなければ"],["ならない"],["。"],["」"],["そこ"],["で"],["、"],["ギデオン"],["と"],["若い","わかい"],["者","もの"],["プラ"],["と"],["は"],["、"],["陣営","じんえい"],["の"],["中","なか"],["の"],["編隊","へんたい"],["の"],["端","はし"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":12,"text":"そこには、ミデヤン人や、アマレク人や、東の人々がみな、いなごのように大ぜい、谷に伏していた。そのらくだは、海辺の砂のように多くて数えきれなかった。","tok":[["そこ"],["に"],["は"],["、"],["ミデヤン"],["人","にん"],["や"],["、"],["アマレク"],["人","にん"],["や"],["、"],["東","ひがし"],["の"],["人々","ひとびと"],["が"],["みな"],["、"],["いなご"],["の"],["よう"],["に"],["大ぜい","おおぜい"],["、"],["谷","たに"],["に"],["伏して","ふして"],["いた"],["。"],["その"],["らくだ"],["は"],["、"],["海辺","うみべ"],["の"],["砂","すな"],["の"],["よう"],["に"],["多くて","おおくて"],["数え","かぞえ"],["きれなかった"],["。"]]},{"verse":13,"text":"ギデオンがそこに行ってみると、ひとりの者が仲間に夢の話をしていた。ひとりが言うには、「私は今、夢を見た。見ると、大麦のパンのかたまりが一つ、ミデヤン人の陣営にころがって来て、天幕の中にまで入り、それを打ったので、それは倒れた。ひっくり返って、天幕は倒れてしまった。」","tok":[["ギデオン"],["が"],["そこ"],["に"],["行って","いって"],["みる"],["と"],["、"],["ひとり"],["の"],["者","もの"],["が"],["仲間","なかま"],["に"],["夢","ゆめ"],["の"],["話","はなし"],["を"],["して"],["いた"],["。"],["ひとり"],["が"],["言う","ゆう"],["に"],["は"],["、"],["「"],["私","わたくし"],["は"],["今","いま"],["、"],["夢","ゆめ"],["を"],["見た","みた"],["。"],["見る","みる"],["と"],["、"],["大麦","おおむぎ"],["の"],["パン"],["の"],["かたまり"],["が"],["一","ひと"],["つ"],["、"],["ミデヤン"],["人","にん"],["の"],["陣営","じんえい"],["に"],["ころがって"],["来て","きて"],["、"],["天幕","てんまく"],["の"],["中","なか"],["に"],["まで"],["入り","はいり"],["、"],["それ"],["を"],["打った","うった"],["ので"],["、"],["それ"],["は"],["倒れた","たおれた"],["。"],["ひっくり返って","ひっくりかえって"],["、"],["天幕","てんまく"],["は"],["倒れて","たおれて"],["しまった"],["。"],["」"]]},{"verse":14,"text":"すると、その仲間は答えて言った。「それはイスラエル人ヨアシュの子ギデオンの剣にほかならない。神が彼の手にミデヤンと、陣営全部を渡されたのだ。」","tok":[["する"],["と"],["、"],["その"],["仲間","なかま"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["それ"],["は"],["イスラエル"],["人","にん"],["ヨアシュ"],["の"],["子","こ"],["ギデオン"],["の"],["剣","けん"],["に"],["ほか"],["ならない"],["。"],["神","かみ"],["が"],["彼","かれ"],["の"],["手","て"],["に"],["ミデヤン"],["と"],["、"],["陣営","じんえい"],["全部","ぜんぶ"],["を"],["渡された","わたされた"],["の"],["だ"],["。"],["」"]]},{"verse":15,"text":"ギデオンはこの夢の話とその解釈を聞いたとき、主を礼拝した。そして、イスラエルの陣営に戻って言った。「立て。主はミデヤン人の陣営をあなたがたの手に下さった。」","tok":[["ギデオン"],["は"],["この"],["夢","ゆめ"],["の"],["話","はなし"],["と"],["その"],["解釈","かいしゃく"],["を"],["聞いた","きいた"],["とき"],["、"],["主","ぬし"],["を"],["礼拝","れいはい"],["した"],["。"],["そして"],["、"],["イスラエル"],["の"],["陣営","じんえい"],["に"],["戻って","もどって"],["言った","いった"],["。"],["「"],["立て","たて"],["。"],["主","ぬし"],["は"],["ミデヤン"],["人","にん"],["の"],["陣営","じんえい"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["下さった","くださった"],["。"],["」"]]},{"verse":16,"text":"そして、彼は三百人を三隊に分け、全員の手に角笛とからつぼとを持たせ、そのつぼの中にたいまつを入れさせた。","tok":[["そして"],["、"],["彼","かれ"],["は"],["三百人","さんひゃくにん"],["を"],["三隊","さんたい"],["に"],["分け","わけ"],["、"],["全員","ぜんいん"],["の"],["手","て"],["に"],["角笛","つのぶえ"],["と"],["からつ"],["ぼと"],["を"],["持たせ","もたせ"],["、"],["その"],["つぼ"],["の"],["中","なか"],["に"],["たいまつ"],["を"],["入れさせた","いれさせた"],["。"]]},{"verse":17,"text":"それから、彼らに言った。「私を見て、あなたがたも同じようにしなければならない。見よ。私が陣営の端に着いたら、私がするように、あなたがたもそうしなければならない。","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["を"],["見て","みて"],["、"],["あなた"],["がた"],["も"],["同じ","おなじ"],["よう"],["に"],["しなければ"],["ならない"],["。"],["見","み"],["よ"],["。"],["私","わたくし"],["が"],["陣営","じんえい"],["の"],["端","はし"],["に"],["着いたら","ついたら"],["、"],["私","わたくし"],["が"],["する"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["そう"],["しなければ"],["ならない"],["。"]]},{"verse":18,"text":"私と、私といっしょにいる者がみな、角笛を吹いたなら、あなたがたもまた、全陣営の回りで角笛を吹き鳴らし、『主のためだ。ギデオンのためだ』と言わなければならない。」","tok":[["私","わたくし"],["と"],["、"],["私","わたくし"],["と"],["いっしょ"],["に"],["いる"],["者","もの"],["が"],["みな"],["、"],["角笛","つのぶえ"],["を"],["吹いたなら","ふいたなら"],["、"],["あなた"],["がた"],["も"],["また"],["、"],["全","ぜん"],["陣営","じんえい"],["の"],["回りで","まわりで"],["角笛","つのぶえ"],["を"],["吹き鳴らし","ふきならし"],["、"],["『"],["主","ぬし"],["の"],["ため"],["だ"],["。"],["ギデオン"],["の"],["ため"],["だ"],["』"],["と"],["言わなければ","いわなければ"],["ならない"],["。"],["」"]]},{"verse":19,"text":"ギデオンと、彼といっしょにいた百人の者が、真夜中の夜番の始まる時、陣営の端に着いた。ちょうどその時、番兵の交替をしたばかりであった。それで、彼らは角笛を吹き鳴らし、その手に持っていたつぼを打ちこわした。","tok":[["ギデオン"],["と"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["いた"],["百人","ひゃくにん"],["の"],["者","もの"],["が"],["、"],["真夜中","まよなか"],["の"],["夜番","よばん"],["の"],["始まる","はじまる"],["時","とき"],["、"],["陣営","じんえい"],["の"],["端","はし"],["に"],["着いた","ついた"],["。"],["ちょうど"],["その"],["時","とき"],["、"],["番兵","ばんぺい"],["の"],["交替","こうたい"],["を"],["した"],["ばかり"],["で"],["あった"],["。"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["角笛","つのぶえ"],["を"],["吹き鳴らし","ふきならし"],["、"],["その"],["手","て"],["に"],["持って","もって"],["いた"],["つぼ"],["を"],["打ちこわした","うちこわした"],["。"]]},{"verse":20,"text":"三隊の者が角笛を吹き鳴らして、つぼを打ち砕き、それから左手にたいまつを堅く握り、右手に吹き鳴らす角笛を堅く握って、「主の剣、ギデオンの剣だ」と叫び、","tok":[["三隊","さんたい"],["の"],["者","もの"],["が"],["角笛","つのぶえ"],["を"],["吹き鳴らして","ふきならして"],["、"],["つぼ"],["を"],["打ち砕き","うちくだき"],["、"],["それ"],["から"],["左手","ひだりて"],["に"],["たいまつ"],["を"],["堅く","かたく"],["握り","にぎり"],["、"],["右手","みぎて"],["に"],["吹き鳴らす","ふきならす"],["角笛","つのぶえ"],["を"],["堅く","かたく"],["握って","にぎって"],["、"],["「"],["主","ぬし"],["の"],["剣","けん"],["、"],["ギデオン"],["の"],["剣","けん"],["だ"],["」"],["と"],["叫び","さけび"],["、"]]},{"verse":21,"text":"それぞれ陣営の周囲の持ち場に着いたので、陣営の者はみな走り出し、大声をあげて逃げた。","tok":[["それぞれ"],["陣営","じんえい"],["の"],["周囲","しゅうい"],["の"],["持ち場","もちば"],["に"],["着いた","ついた"],["ので"],["、"],["陣営","じんえい"],["の"],["者","もの"],["は"],["みな"],["走り","はしり"],["出し","だし"],["、"],["大声","おおごえ"],["を"],["あげて"],["逃げた","にげた"],["。"]]},{"verse":22,"text":"三百人が角笛を吹き鳴らしている間に、主は、陣営の全面にわたって、同士打ちが起こるようにされた。それで陣営はツェレラのほうのベテ・ハシタや、タバテの近くのアベル・メホラの端まで逃げた。","tok":[["三百人","さんひゃくにん"],["が"],["角笛","つのぶえ"],["を"],["吹き鳴らして","ふきならして"],["いる"],["間","あいだ"],["に"],["、"],["主","ぬし"],["は"],["、"],["陣営","じんえい"],["の"],["全面","ぜんめん"],["に"],["わたって"],["、"],["同士打ち","どうしうち"],["が"],["起こる","おこる"],["よう"],["に"],["された"],["。"],["それ"],["で"],["陣営","じんえい"],["は"],["ツェレラ"],["の"],["ほう"],["の"],["ベテ"],["・"],["ハシタ"],["や"],["、"],["タバテ"],["の"],["近く","ちかく"],["の"],["アベル"],["・"],["メホラ"],["の"],["端","はし"],["まで"],["逃げた","にげた"],["。"]]},{"verse":23,"text":"イスラエル人はナフタリと、アシェルと、全マナセから呼び集められ、彼らはミデヤン人を追撃した。","tok":[["イスラエル"],["人","にん"],["は"],["ナフタリ"],["と"],["、"],["アシェル"],["と"],["、"],["全","ぜん"],["マナセ"],["から"],["呼び集められ","よびあつめられ"],["、"],["彼","かれ"],["ら"],["は"],["ミデヤン"],["人","にん"],["を"],["追撃","ついげき"],["した"],["。"]]},{"verse":24,"text":"ついで、ギデオンはエフライムの山地全域に使者を送って言った。「降りて来て、ミデヤン人を攻めなさい。ベテ・バラまでの流れと、ヨルダン川を攻め取りなさい。」そこでエフライム人はみな呼び集められ、彼らはベテ・バラまでの流れと、ヨルダン川を攻め取った。","tok":[["つい"],["で"],["、"],["ギデオン"],["は"],["エフライム"],["の"],["山地","さんち"],["全域","ぜんいき"],["に"],["使者","ししゃ"],["を"],["送って","おくって"],["言った","いった"],["。"],["「"],
[{"verse":1,"text":"そのころ、イスラエルには王がなかった。そのころ、ダン人の部族は、自分たちの住む相続地を求めていた。イスラエルの諸部族の中にあって、相続地はその時まで彼らに割り当てられていなかったからである。","tok":[["その"],["ころ"],["、"],["イスラエル"],["に"],["は"],["王","おう"],["が"],["なかった"],["。"],["その"],["ころ"],["、"],["ダン人","だんにん"],["の"],["部族","ぶぞく"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["住む","すむ"],["相続","そうぞく"],["地","ち"],["を"],["求めて","もとめて"],["いた"],["。"],["イスラエル"],["の"],["諸","しょ"],["部族","ぶぞく"],["の"],["中","なか"],["に"],["あって"],["、"],["相続","そうぞく"],["地","ち"],["は"],["その"],["時","とき"],["まで"],["彼","かれ"],["ら"],["に"],["割り当てられて","わりあてられて"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"そこで、ダン族は、彼らの諸氏族全体のうちから五人の者、ツォルアとエシュタオルからの勇士たちを派遣して、土地を偵察し、調べることにした。それで、彼らに言った。「行って、あの地を調べなさい。」彼らはエフライムの山地のミカの家に行って、そこで一夜を明かした。","tok":[["そこ"],["で"],["、"],["ダン族","だんぞく"],["は"],["、"],["彼","かれ"],["ら"],["の"],["諸","しょ"],["氏族","しぞく"],["全体","ぜんたい"],["の"],["うち"],["から"],["五人","ごにん"],["の"],["者","もの"],["、"],["ツォルア"],["と"],["エシュタオル"],["から"],["の"],["勇士","ゆうし"],["たち"],["を"],["派遣","はけん"],["して"],["、"],["土地","とち"],["を"],["偵察","ていさつ"],["し"],["、"],["調べる","しらべる"],["こと"],["に"],["した"],["。"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["行って","いって"],["、"],["あの"],["地","ち"],["を"],["調べ","しらべ"],["なさい"],["。"],["」"],["彼","かれ"],["ら"],["は"],["エフライム"],["の"],["山地","さんち"],["の"],["ミカ"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["そこ"],["で"],["一夜","いちや"],["を"],["明かした","あかした"],["。"]]},{"verse":3,"text":"彼らはミカの家のそばに来、あのレビ人の若者の声に気づいた。そこで、そこに立ち寄り、彼に言った。「だれがあなたをここに連れて来たのですか。ここで何をしているのですか。ここに何の用事があるのですか。」","tok":[["彼","かれ"],["ら"],["は"],["ミカ"],["の"],["家","いえ"],["の"],["そば"],["に"],["来","き"],["、"],["あの"],["レビ人","れびにん"],["の"],["若者","わかもの"],["の"],["声","こえ"],["に"],["気づいた","きづいた"],["。"],["そこ"],["で"],["、"],["そこ"],["に"],["立ち寄り","たちより"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["だれ"],["が"],["あなた"],["を"],["ここ"],["に"],["連れて","つれて"],["来た","きた"],["の"],["です"],["か"],["。"],["ここ"],["で"],["何","なん"],["を"],["して"],["いる"],["の"],["です"],["か"],["。"],["ここ"],["に"],["何","なん"],["の"],["用事","ようじ"],["が"],["ある"],["の"],["です"],["か"],["。"],["」"]]},{"verse":4,"text":"その若者は彼らに言った。「ミカが、かくかくのことを私にしてくれて、私を雇い、私は彼の祭司になったのです。」","tok":[["その"],["若者","わかもの"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["ミカ"],["が"],["、"],["かくかく"],["の"],["こと"],["を"],["私","わたくし"],["に"],["して"],["くれて"],["、"],["私","わたくし"],["を"],["雇い","やとい"],["、"],["私","わたくし"],["は"],["彼","かれ"],["の"],["祭司","さいし"],["に"],["なった"],["の"],["です"],["。"],["」"]]},{"verse":5,"text":"彼らはその若者に言った。「どうぞ、神に伺ってください。私たちのしているこの旅が、成功するかどうかを知りたいのです。」","tok":[["彼","かれ"],["ら"],["は"],["その"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["どうぞ"],["、"],["神","かみ"],["に"],["伺って","うかがって"],["ください"],["。"],["私たち","わたしたち"],["の"],["して"],["いる"],["この"],["旅","たび"],["が"],["、"],["成功","せいこう"],["する"],["か"],["どう"],["か"],["を"],["知りたい","しりたい"],["の"],["です"],["。"],["」"]]},{"verse":6,"text":"その祭司は彼らに言った。「安心して行きなさい。あなたがたのしている旅は、主が認めておられます。」","tok":[["その"],["祭司","さいし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["。"],["あなた"],["がた"],["の"],["して"],["いる"],["旅","たび"],["は"],["、"],["主","ぬし"],["が"],["認めて","みとめて"],["おられます"],["。"],["」"]]},{"verse":7,"text":"五人の者は進んで行って、ライシュに着き、そこの住民を見ると、彼らは安らかに住んでおり、シドン人のならわしに従って、平穏で安心しきっていた。この地には足りないものは何もなく、押さえつける者もなかった。彼らはシドン人から遠く離れており、そのうえ、だれとも交渉がなかった。","tok":[["五人","ごにん"],["の"],["者","もの"],["は"],["進んで","すすんで"],["行って","いって"],["、"],["ライシュ"],["に"],["着き","つき"],["、"],["そこ"],["の"],["住民","じゅうみん"],["を"],["見る","みる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["安らか","やすらか"],["に"],["住んで","すんで"],["おり"],["、"],["シドン人","しどんにん"],["の"],["ならわし"],["に"],["従って","したがって"],["、"],["平穏","へいおん"],["で"],["安心","あんしん"],["し"],["きって"],["いた"],["。"],["この"],["地","ち"],["に"],["は"],["足りない","たりない"],["もの"],["は"],["何","なん"],["も"],["なく"],["、"],["押さえつける","おさえつける"],["者","もの"],["も"],["なかった"],["。"],["彼","かれ"],["ら"],["は"],["シドン人","しどんにん"],["から"],["遠く","とおく"],["離れて","はなれて"],["おり"],["、"],["その"],["うえ"],["、"],["だれ"],["と"],["も"],["交渉","こうしょう"],["が"],["なかった"],["。"]]},{"verse":8,"text":"五人の者がツォルアとエシュタオルの身内の者たちのところに帰って来たとき、身内の者たちは彼らに、どうだったかと尋ねた。","tok":[["五人","ごにん"],["の"],["者","もの"],["が"],["ツォルア"],["と"],["エシュタオル"],["の"],["身内","みうち"],["の"],["者","もの"],["たち"],["の"],["ところ"],["に"],["帰って","かえって"],["来た","きた"],["とき"],["、"],["身内","みうち"],["の"],["者","もの"],["たち"],["は"],["彼","かれ"],["ら"],["に"],["、"],["どう"],["だった"],["か"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":9,"text":"そこで、彼らは言った。「さあ、彼らのところへ攻め上ろう。私たちはその土地を見たが、実に、すばらしい。あなたがたはためらっている。ぐずぐずせずに進んで行って、あの地を占領しよう。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["さあ"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["へ"],["攻め上ろう","せめのぼろう"],["。"],["私たち","わたしたち"],["は"],["その"],["土地","とち"],["を"],["見た","みた"],["が"],["、"],["実","じつ"],["に"],["、"],["すばらしい"],["。"],["あなた"],["がた"],["は"],["ためらって"],["いる"],["。"],["ぐずぐず"],["せず"],["に"],["進んで","すすんで"],["行って","いって"],["、"],["あの"],["地","ち"],["を"],["占領","せんりょう"],["しよう"],["。"]]},{"verse":10,"text":"あなたがたが行くときは、安心しきっている民のところに行けるのだ。しかもその地は広々としている。神はそれをあなたがたの手に渡しておられる。その場所には、地にあるもので足りないものは何もない。」","tok":[["あなた"],["がた"],["が"],["行く","いく"],["とき"],["は"],["、"],["安心","あんしん"],["し"],["きって"],["いる"],["民","たみ"],["の"],["ところ"],["に"],["行ける","いける"],["の"],["だ"],["。"],["しかも"],["その"],["地","ち"],["は"],["広々","ひろびろ"],["として"],["いる"],["。"],["神","かみ"],["は"],["それ"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡して","わたして"],["おられる"],["。"],["その"],["場所","ばしょ"],["に"],["は"],["、"],["地","ち"],["に"],["ある"],["もの"],["で"],["足りない","たりない"],["もの"],["は"],["何","なん"],["も"],["ない"],["。"],["」"]]},{"verse":11,"text":"そこで、ダン人の氏族の者六百人は武具を身に着けて、そこ、ツォルアとエシュタオルから旅立ち、","tok":[["そこ"],["で"],["、"],["ダン人","だんにん"],["の"],["氏族","しぞく"],["の"],["者","もの"],["六百人","ろくひゃくにん"],["は"],["武具","ぶぐ"],["を"],["身","み"],["に"],["着けて","つけて"],["、"],["そこ"],["、"],["ツォルア"],["と"],["エシュタオル"],["から"],["旅立ち","たびだち"],["、"]]},{"verse":12,"text":"上って行って、ユダのキルヤテ・エアリムに宿営した。それで、その所はマハネ・ダンと呼ばれた。今日もそうである。それはキルヤテ・エアリムの西にある。","tok":[["上って","のぼって"],["行って","いって"],["、"],["ユダ"],["の"],["キルヤテ"],["・"],["エアリム"],["に"],["宿営","しゅくえい"],["した"],["。"],["それ"],["で"],["、"],["その"],["所","ところ"],["は"],["マハネ"],["・"],["ダン"],["と"],["呼ばれた","よばれた"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"],["それ"],["は"],["キルヤテ"],["・"],["エアリム"],["の"],["西","にし"],["に"],["ある"],["。"]]},{"verse":13,"text":"彼らはさらにそこからエフライムの山地へと進み、ミカの家に着いた。","tok":[["彼","かれ"],["ら"],["は"],["さらに"],["そこ"],["から"],["エフライム"],["の"],["山地","さんち"],["へ"],["と"],["進み","すすみ"],["、"],["ミカ"],["の"],["家","いえ"],["に"],["着いた","ついた"],["。"]]},{"verse":14,"text":"そのとき、あのライシュの地を偵察に行った五人の者は、その身内の者たちに告げて言った。「これらの建物の中にエポデやテラフィム、彫像や鋳像があるのを知っているか。今あなたがたは何をなすべきかを知りなさい。」","tok":[["その"],["とき"],["、"],["あの"],["ライシュ"],["の"],["地","ち"],["を"],["偵察","ていさつ"],["に"],["行った","いった"],["五人","ごにん"],["の"],["者","もの"],["は"],["、"],["その"],["身内","みうち"],["の"],["者","もの"],["たち"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["これ"],["ら"],["の"],["建物","たてもの"],["の"],["中","なか"],["に"],["エポデ"],["や"],["テラフィム"],["、"],["彫像","ちょうぞう"],["や"],["鋳像","ちゅうぞう"],["が"],["ある"],["の"],["を"],["知って","しって"],["いる"],["か"],["。"],["今","いま"],["あなた"],["がた"],["は"],["何","なん"],["を"],["なすべき"],["か"],["を"],["知り","しり"],["なさい"],["。"],["」"]]},{"verse":15,"text":"そこで、彼らは、そちらのほうに行き、あのレビ人の若者の家ミカの家に来て、彼の安否を尋ねた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["、"],["そちら"],["の"],["ほう"],["に"],["行き","いき"],["、"],["あの"],["レビ人","れびにん"],["の"],["若者","わかもの"],["の"],["家","いえ"],["ミカ"],["の"],["家","いえ"],["に"],["来て","きて"],["、"],["彼","かれ"],["の"],["安否","あんぴ"],["を"],["尋ねた","たずねた"],["。"]]},{"verse":16,"text":"武具を身に着けた六百人のダンの人々は、門の入口のところに立っていた。","tok":[["武具","ぶぐ"],["を"],["身","み"],["に"],["着けた","つけた"],["六百人","ろくひゃくにん"],["の"],["ダン"],["の"],["人々","ひとびと"],["は"],["、"],["門","もん"],["の"],["入口","いりぐち"],["の"],["ところ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":17,"text":"あの地を偵察に行った五人の者は上って行き、そこに入り、彫像とエポデとテラフィムと鋳像を取った。祭司は武具を身に着けた六百人の者と、門の入口のところに立っていた。","tok":[["あの"],["地","ち"],["を"],["偵察","ていさつ"],["に"],["行った","いった"],["五人","ごにん"],["の"],["者","もの"],["は"],["上って","のぼって"],["行き","いき"],["、"],["そこ"],["に"],["入り","はいり"],["、"],["彫像","ちょうぞう"],["と"],["エポデ"],["と"],["テラフィム"],["と"],["鋳像","ちゅうぞう"],["を"],["取った","とった"],["。"],["祭司","さいし"],["は"],["武具","ぶぐ"],["を"],["身","み"],["に"],["着けた","つけた"],["六百人","ろくひゃくにん"],["の"],["者","もの"],["と"],["、"],["門","もん"],["の"],["入口","いりぐち"],["の"],["ところ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":18,"text":"五人の者がミカの家に入り、彫像とエポデとテラフィムと鋳像を取った。そのとき祭司は彼らに言った。「あなたがたは何をしているのか。」","tok":[["五人","ごにん"],["の"],["者","もの"],["が"],["ミカ"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],["彫像","ちょうぞう"],["と"],["エポデ"],["と"],["テラフィム"],["と"],["鋳像","ちゅうぞう"],["を"],["取った","とった"],["。"],["その"],["とき"],["祭司","さいし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["何","なん"],["を"],["して"],["いる"],["の"],["か"],["。"],["」"]]},{"verse":19,"text":"彼らは祭司に言った。「黙っていてください。あなたの手を口に当てて、私たちといっしょに来て、私たちのために父となり、また祭司となってください。あなたはひとりの家の祭司になるのと、イスラエルで部族または氏族の祭司になるのと、どちらがよいですか。」","tok":[["彼","かれ"],["ら"],["は"],["祭司","さいし"],["に"],["言った","いった"],["。"],["「"],["黙って","だまって"],["いて"],["ください"],["。"],["あなた"],["の"],["手","て"],["を"],["口","くち"],["に"],["当てて","あてて"],["、"],["私たち","わたしたち"],["と"],["いっしょ"],["に"],["来て","きて"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["父","ちち"],["と"],["なり"],["、"],["また"],["祭司","さいし"],["と"],["なって"],["ください"],["。"],["あなた"],["は"],["ひとり"],["の"],["家","いえ"],["の"],["祭司","さいし"],["に"],["なる"],["の"],["と"],["、"],["イスラエル"],["で"],["部族","ぶぞく"],["また"],["は"],["氏族","しぞく"],["の"],["祭司","さいし"],["に"],["なる"],["の"],["と"],["、"],["どちら"],["が"],["よいです"],["か"],["。"],["」"]]},{"verse":20,"text":"祭司の心ははずんだ。彼はエポデとテラフィムと彫像を取り、この人々の中に入って行った。","tok":[["祭司","さいし"],["の"],["心","こころ"],["は"],["はずんだ"],["。"],["彼","かれ"],["は"],["エポデ"],["と"],["テラフィム"],["と"],["彫像","ちょうぞう"],["を"],["取り","とり"],["、"],["この"],["人々","ひとびと"],["の"],["中","なか"],["に"],["入って","はいって"],["行った","いった"],["。"]]},{"verse":21,"text":"そこで、彼らは子どもや家畜や貴重品を先にして引き返して行った。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["子ども","こども"],["や"],["家畜","かちく"],["や"],["貴重品","きちょうひん"],["を"],["先","さき"],["に"],["して"],["引き返して","ひきかえして"],["行った","いった"],["。"]]},{"verse":22,"text":"彼らがミカの家からかなり離れると、ミカは家の近くの家にいた人々を集め、ダン族に追いついた。","tok":[["彼","かれ"],["ら"],["が"],["ミカ"],["の"],["家","いえ"],["から"],["かなり"],["離れる","はなれる"],["と"],["、"],["ミカ"],["は"],["家","いえ"],["の"],["近く","ちかく"],["の"],["家","いえ"],["に"],["いた"],["人々","ひとびと"],["を"],["集め","あつめ"],["、"],["ダン族","だんぞく"],["に"],["追いついた","おいついた"],["。"]]},{"verse":23,"text":"彼らがダン族に呼びかけたとき、彼らは振り向いて、ミカに言った。「あなたは、どうしたのだ。人を集めたりして。」","tok":[["彼","かれ"],["ら"],["が"],["ダン族","だんぞく"],["に"],["呼びかけた","よびかけた"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["振り向いて","ふりむいて"],["、"],["ミカ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["どう"],["した"],["の"],["だ"],["。"],["人","ひと"],["を"],["集め","あつめ"],["たり"],["して"],["。"],["」"]]},{"verse":24,"text":"すると、ミカは言った。「あなたがたは私の造った神々と、それに祭司とを取って行った。私のところには何が残っていますか。私に向かって『どうしたのだ』と言うのは、いったい何事です。」","tok":[["する"],["と"],["、"],["ミカ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["私","わたくし"],["の"],["造った","つくった"],["神々","かみがみ"],["と"],["、"],["それ"],["に"],["祭司","さいし"],["と"],["を"],["取って","とって"],["行った","いった"],["。"],["私","わたくし"],["の"],["ところ"],["に"],["は"],["何","なん"],["が"],["残って","のこって"],["います"],["か"],["。"],["私","わたくし"],["に"],["向かって","むかって"],["『"],["どう"],["した"],["の"],["だ"],["』"],["と"],["言う","いう"],["の"],["は"],["、"],["いったい"],["何事","なにごと"],["です"],["。"],["」"]]},{"verse":25,"text":"そこで、ダン族はミカに言った。「あなたの声が私たちの中で聞こえないようにせよ。でなければ、気の荒い連中があなたがたに撃ちかかろう。あなたは、自分のいのちも、家族のいのちも失おう。」","tok":[["そこ"],["で"],["、"],["ダン族","だんぞく"],["は"],["ミカ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["声","こえ"],["が"],["私たち","わたしたち"],["の"],["中","なか"],["で"],["聞こえない","きこえない"],["よう"],["に"],["せよ"],["。"],["で"],["なければ"],["、"],["気","き"],["の"],["荒い","あらい"],["連中","れんちゅう"],["が"],["あなた"],["がた"],["に"],["撃ち","うち"],["かかろう"],["。"],["あなた"],["は"],["、"],["自分","じぶん"],["の"],["いのち"],["も"],["、"],["家族","かぞく"],["の"],["いのち"],["も"],["失おう","うしなおう"],["。"],["」"]]},{"verse":26,"text":"こうして、ダン族は去って行った。ミカは、彼らが自分よりも強いのを見てとり、向きを変えて、自分の家に帰った。","tok":[["こう"],["して"],["、"],["ダン族","だんぞく"],["は"],["去って","さって"],["行った","いった"],["。"],["ミカ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["自分","じぶん"],["より"],["も"],["強い","つよい"],["の"],["を"],["見て","みて"],["とり"],["、"],["向き","むき"],["を"],["変えて","かえて"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰った","かえった"],["。"]]},{"verse":27,"text":"彼らは、ミカが造った物と、ミカの祭司とを取って、ライシュに行き、平穏で安心しきっている民を襲い、剣の刃で彼らを打ち、火でその町を焼いた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["ミカ"],["が"],["造った","つくった"],["物","もの"],["と"],["、"],["ミカ"],["の"],["祭司","さいし"],["と"],["を"],["取って","とって"],["、"],["ライシュ"],["に"],["行き","いき"],["、"],["平穏","へいおん"],["で"],["安心","あんしん"],["し"],["きって"],["いる"],["民","たみ"],["を"],["襲い","おそい"],["、"],["剣","けん"],["の"],["刃","は"],["で"],["彼","かれ"],["ら"],["を"],["打ち","うち"],["、"],["火","ひ"],["で"],["その"],["町","まち"],["を"],["焼いた","やいた"],["。"]]},{"verse":28,"text":"その町はシドンから遠く離れており、そのうえ、だれとも交渉がなかったので、救い出す者がいなかった。その町はベテ・レホブの近くの谷にあった。彼らは町を建てて、そこに住んだ。","tok":[["その"],["町","まち"],["は"],["シドン"],["から"],["遠く","とおく"],["離れて","はなれて"],["おり"],["、"],["その"],["うえ"],["、"],["だれ"],["と"],["も"],["交渉","こうしょう"],["が"],["なかった"],["ので"],["、"],["救い出す","すくいだす"],["者","もの"],["が"],["いなかった"],["。"],["その"],["町","まち"],["は"],["ベテ"],["・"],["レホブ"],["の"],["近く","ちかく"],["の"],["谷","たに"],["に"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["町","まち"],["を"],["建てて","たてて"],["、"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":29,"text":"そして、彼らはイスラエルに生まれた自分たちの先祖ダンの名にちなんで、その町にダンという名をつけた。その町のもとの名はライシュであった。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["に"],["生まれた","うまれた"],["自分","じぶん"],["たち"],["の"],["先祖","せんぞ"],["ダン"],["の"],["名","な"],["に"],["ちなんで"],["、"],["その"],["町","まち"],["に"],["ダン"],["と"],["いう"],["名","な"],["を"],["つけた"],["。"],["その"],["町","まち"],["の"],["もと"],["の"],["名","な"],["は"],["ライシュ"],["で"],["あった"],["。"]]},{"verse":30,"text":"さて、ダン族は自分たちのために彫像を立てた。モーセの子ゲルショムの子ヨナタンとその子孫が、国の捕囚の日まで、ダン部族の祭司であった。","tok":[["さて"],["、"],["ダン族","だんぞく"],["は"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["彫像","ちょうぞう"],["を"],["立てた","たてた"],["。"],["モーセ"],["の"],["子","こ"],["ゲルショム"],["の"],["子","こ"],["ヨナタン"],["と"],["その"],["子孫","しそん"],["が"],["、"],["国","くに"],["の"],["捕囚","ほしゅう"],["の"],["日","ひ"],["まで"],["、"],["ダン"],["部族","ぶぞく"],["の"],["祭司","さいし"],["で"],["あった"],["。"]]},{"verse":31,"text":"こうして、神の宮がシロにあった間中、彼らはミカの造った彫像を自分たちのために立てた。","tok":[["こう"],["して"],["、"],["神","かみ"],["の"],["宮","みや"],["が"],["シロ"],["に"],["あった"],["間中","まなか"],["、"],["彼","かれ"],["ら"],["は"],["ミカ"],["の"],["造った","つくった"],["彫
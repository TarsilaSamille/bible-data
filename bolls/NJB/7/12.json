[{"verse":1,"text":"エフライム人が集まって、ツァフォンへ進んだとき、彼らはエフタに言った。「なぜ、あなたは、あなたとともに行くように私たちに呼びかけずに、進んで行ってアモン人と戦ったのか。私たちはあなたの家をあなたもろとも火で焼き払う。」","tok":[["エフライム"],["人","にん"],["が"],["集まって","あつまって"],["、"],["ツァフォン"],["へ"],["進んだ","すすんだ"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["エフタ"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["あなた"],["は"],["、"],["あなた"],["と"],["とも"],["に"],["行く","いく"],["よう"],["に"],["私たち","わたしたち"],["に"],["呼びかけず","よびかけず"],["に"],["、"],["進んで","すすんで"],["行って","いって"],["アモン人","あもんにん"],["と"],["戦った","たたかった"],["の"],["か"],["。"],["私たち","わたしたち"],["は"],["あなた"],["の"],["家","いえ"],["を"],["あなた"],["もろとも"],["火","ひ"],["で"],["焼き払う","やきはらう"],["。"],["」"]]},{"verse":2,"text":"そこでエフタは彼らに言った。「かつて、私と私の民とがアモン人と激しく争ったとき、私はあなたがたを呼び集めたが、あなたがたは私を彼らの手から救ってくれなかった。","tok":[["そこ"],["で"],["エフタ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["かつて"],["、"],["私","わたくし"],["と"],["私","わたくし"],["の"],["民","たみ"],["と"],["が"],["アモン人","あもんにん"],["と"],["激しく","はげしく"],["争った","あらそった"],["とき"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["を"],["呼び集めた","よびあつめた"],["が"],["、"],["あなた"],["がた"],["は"],["私","わたくし"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["救って","すくって"],["くれなかった"],["。"]]},{"verse":3,"text":"あなたがたが私を救ってくれないことがわかったので、私は自分のいのちをかけてアモン人のところへ進んで行った。そのとき、主は彼らを私の手に渡された。なぜ、あなたがたは、きょう、私のところに上って来て、私と戦おうとするのか。」","tok":[["あなた"],["がた"],["が"],["私","わたくし"],["を"],["救って","すくって"],["くれない"],["こと"],["が"],["わかった"],["ので"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["いのち"],["を"],["かけて"],["アモン人","あもんにん"],["の"],["ところ"],["へ"],["進んで","すすんで"],["行った","いった"],["。"],["その"],["とき"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["私","わたくし"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"],["なぜ"],["、"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["上って","のぼって"],["来て","きて"],["、"],["私","わたくし"],["と"],["戦おう","たたかおう"],["と"],["する"],["の"],["か"],["。"],["」"]]},{"verse":4,"text":"そして、エフタはギルアデの人々をみな集めて、エフライムと戦った。ギルアデの人々はエフライムを打ち破った。これはエフライムが、「ギルアデ人よ。あなたがたはエフライムとマナセのうちにいるエフライムの逃亡者だ」と言ったからである。","tok":[["そして"],["、"],["エフタ"],["は"],["ギルアデ"],["の"],["人々","ひとびと"],["を"],["みな"],["集めて","あつめて"],["、"],["エフライム"],["と"],["戦った","たたかった"],["。"],["ギルアデ"],["の"],["人々","ひとびと"],["は"],["エフライム"],["を"],["打ち破った","うちやぶった"],["。"],["これ"],["は"],["エフライム"],["が"],["、"],["「"],["ギルアデ"],["人","ひと"],["よ"],["。"],["あなた"],["がた"],["は"],["エフライム"],["と"],["マナセ"],["の"],["うち"],["に"],["いる"],["エフライム"],["の"],["逃亡者","とうぼうしゃ"],["だ"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"ギルアデ人はさらに、エフライムに面するヨルダン川の渡し場を攻め取った。エフライムの逃亡者が、「渡らせてくれ」と言うとき、ギルアデの人々はその者に、「あなたはエフライム人か」と尋ね、その者が「そうではない」と答えると、","tok":[["ギルアデ"],["人","にん"],["は"],["さらに"],["、"],["エフライム"],["に"],["面する","めんする"],["ヨルダン"],["川","かわ"],["の"],["渡し場","わたしば"],["を"],["攻め取った","せめとった"],["。"],["エフライム"],["の"],["逃亡者","とうぼうしゃ"],["が"],["、"],["「"],["渡らせて","わたらせて"],["くれ"],["」"],["と"],["言う","いう"],["とき"],["、"],["ギルアデ"],["の"],["人々","ひとびと"],["は"],["その"],["者","もの"],["に"],["、"],["「"],["あなた"],["は"],["エフライム"],["人","にん"],["か"],["」"],["と"],["尋ね","たずね"],["、"],["その"],["者","もの"],["が"],["「"],["そう"],["で"],["は"],["ない"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":6,"text":"その者に、「『シボレテ』と言え」と言い、その者が「スィボレテ」と言って、正しく発音できないと、その者をつかまえて、ヨルダン川の渡し場で殺した。そのとき、四万二千人のエフライム人が倒れた。","tok":[["その"],["者","もの"],["に"],["、"],["「"],["『"],["シボレテ"],["』"],["と"],["言え","いえ"],["」"],["と"],["言い","いい"],["、"],["その"],["者","もの"],["が"],["「"],["スィボレテ"],["」"],["と"],["言って","いって"],["、"],["正しく","まさしく"],["発音","はつおん"],["できない"],["と"],["、"],["その"],["者","もの"],["を"],["つかまえて"],["、"],["ヨルダン"],["川","かわ"],["の"],["渡し場","わたしば"],["で"],["殺した","ころした"],["。"],["その"],["とき"],["、"],["四万二千","よんまんにせん"],["人","にん"],["の"],["エフライム"],["人","にん"],["が"],["倒れた","たおれた"],["。"]]},{"verse":7,"text":"こうして、エフタはイスラエルを六年間、さばいた。ギルアデ人エフタは死んで、ギルアデの町に葬られた。","tok":[["こう"],["して"],["、"],["エフタ"],["は"],["イスラエル"],["を"],["六","ろく"],["年間","ねんかん"],["、"],["さばいた"],["。"],["ギルアデ"],["人","にん"],["エフタ"],["は"],["死んで","しんで"],["、"],["ギルアデ"],["の"],["町","まち"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":8,"text":"彼の後に、ベツレヘムの出のイブツァンがイスラエルをさばいた。","tok":[["彼","かれ"],["の"],["後","あと"],["に"],["、"],["ベツレヘム"],["の"],["出","で"],["の"],["イブツァン"],["が"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":9,"text":"彼には三十人の息子がいた。また彼は三十人の娘を自分の氏族以外の者にとつがせ、自分の息子たちのために、よそから三十人の娘たちをめとった。彼は七年間、イスラエルをさばいた。","tok":[["彼","かれ"],["に"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["息子","むすこ"],["が"],["いた"],["。"],["また"],["彼","かれ"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["娘","むすめ"],["を"],["自分","じぶん"],["の"],["氏族","しぞく"],["以外","いがい"],["の"],["者","もの"],["に"],["とつがせ"],["、"],["自分","じぶん"],["の"],["息子","むすこ"],["たち"],["の"],["ため"],["に"],["、"],["よそ"],["から"],["三","さん"],["十人","じゅうにん"],["の"],["娘","むすめ"],["たち"],["を"],["めとった"],["。"],["彼","かれ"],["は"],["七","なな"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":10,"text":"イブツァンは死んで、ベツレヘムに葬られた。","tok":[["イブツァン"],["は"],["死んで","しんで"],["、"],["ベツレヘム"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":11,"text":"彼の後に、ゼブルン人エロンがイスラエルをさばいた。彼は十年間、イスラエルをさばいた。","tok":[["彼","かれ"],["の"],["後","あと"],["に"],["、"],["ゼブルン"],["人","にん"],["エロン"],["が"],["イスラエル"],["を"],["さばいた"],["。"],["彼","かれ"],["は"],["十","じゅう"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":12,"text":"ゼブルン人エロンは死んで、ゼブルンの地のアヤロンに葬られた。","tok":[["ゼブルン"],["人","にん"],["エロン"],["は"],["死んで","しんで"],["、"],["ゼブルン"],["の"],["地","ち"],["の"],["アヤロン"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":13,"text":"彼の後に、ピルアトン人ヒレルの子アブドンがイスラエルをさばいた。","tok":[["彼","かれ"],["の"],["後","あと"],["に"],["、"],["ピルアトン"],["人","にん"],["ヒレル"],["の"],["子","こ"],["アブドン"],["が"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":14,"text":"彼には四十人の息子と三十人の孫がいて、七十頭のろばに乗っていた。彼は八年間、イスラエルをさばいた。","tok":[["彼","かれ"],["に"],["は"],["四","よん"],["十人","じゅうにん"],["の"],["息子","むすこ"],["と"],["三","さん"],["十人","じゅうにん"],["の"],["孫","まご"],["が"],["いて"],["、"],["七十頭","ななじゅうとう"],["の"],["ろば"],["に"],["乗って","のって"],["いた"],["。"],["彼","かれ"],["は"],["八","はち"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["さばいた"],["。"]]},{"verse":15,"text":"ピルアトン人ヒレルの子アブドンは死んで、アマレク人の山地にあるエフライムの地のピルアトンに葬られた。","tok":[["ピルアトン"],["人","にん"],["ヒレル"],["の"],["子","こ"],["アブドン"],["は"],["死んで","しんで"],["、"],["アマレク"],["人","にん"],["の"],["山地","さんち"],["に"],["ある"],["エフライム"],["の"
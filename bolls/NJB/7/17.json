[{"verse":1,"text":"エフライムの山地の出で、その名をミカという人がいた。","tok":[["エフライム"],["の"],["山地","さんち"],["の"],["出","で"],["で"],["、"],["その"],["名","な"],["を"],["ミカ"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"]]},{"verse":2,"text":"彼は母に言った。「あなたが、銀千百枚を盗まれたとき、のろって言われたことが、私の耳に入りました。実は、私がその銀を持っています。私がそれを盗んだのです。」すると、母は言った。「主が私の息子を祝福されますように。」","tok":[["彼","かれ"],["は"],["母","はは"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["、"],["銀","ぎん"],["千百枚","せんひゃくまい"],["を"],["盗まれた","ぬすまれた"],["とき"],["、"],["のろって"],["言われた","いわれた"],["こと"],["が"],["、"],["私","わたくし"],["の"],["耳","みみ"],["に"],["入りました","はいりました"],["。"],["実","じつ"],["は"],["、"],["私","わたくし"],["が"],["その"],["銀","ぎん"],["を"],["持って","もって"],["います"],["。"],["私","わたくし"],["が"],["それ"],["を"],["盗んだ","ぬすんだ"],["の"],["です"],["。"],["」"],["する"],["と"],["、"],["母","はは"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["私","わたくし"],["の"],["息子","むすこ"],["を"],["祝福","しゅくふく"],["されます"],["よう"],["に"],["。"],["」"]]},{"verse":3,"text":"彼が母にその銀千百枚を返したとき、母は言った。「私の手でその銀を聖別して主にささげ、わが子のために、それで彫像と鋳像を造りましょう。今は、それをあなたに返します。」","tok":[["彼","かれ"],["が"],["母","はは"],["に"],["その"],["銀","ぎん"],["千百枚","せんひゃくまい"],["を"],["返した","かえした"],["とき"],["、"],["母","はは"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["手","て"],["で"],["その"],["銀","ぎん"],["を"],["聖別","せいべつ"],["して"],["主に","おもに"],["ささげ"],["、"],["わが"],["子","こ"],["の"],["ため"],["に"],["、"],["それ"],["で"],["彫像","ちょうぞう"],["と"],["鋳像","ちゅうぞう"],["を"],["造りましょう","つくりましょう"],["。"],["今","いま"],["は"],["、"],["それ"],["を"],["あなた"],["に"],["返します","かえします"],["。"],["」"]]},{"verse":4,"text":"しかし彼は母にその銀を返した。そこで母は銀二百枚を取って、それを銀細工人に与えた。すると、彼はそれで彫像と鋳像を造った。それがミカの家にあった。","tok":[["しかし"],["彼","かれ"],["は"],["母","はは"],["に"],["その"],["銀","ぎん"],["を"],["返した","かえした"],["。"],["そこ"],["で"],["母","はは"],["は"],["銀","ぎん"],["二百枚","にひゃくまい"],["を"],["取って","とって"],["、"],["それ"],["を"],["銀","ぎん"],["細工人","さいくにん"],["に"],["与えた","あたえた"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["それ"],["で"],["彫像","ちょうぞう"],["と"],["鋳像","ちゅうぞう"],["を"],["造った","つくった"],["。"],["それ"],["が"],["ミカ"],["の"],["家","いえ"],["に"],["あった"],["。"]]},{"verse":5,"text":"このミカという人は神の宮を持っていた。それで彼はエポデとテラフィムを作り、その息子のひとりを任命して、自分の祭司としていた。","tok":[["この"],["ミカ"],["と"],["いう"],["人","ひと"],["は"],["神","かみ"],["の"],["宮","みや"],["を"],["持って","もって"],["いた"],["。"],["それ"],["で"],["彼","かれ"],["は"],["エポデ"],["と"],["テラフィム"],["を"],["作り","つくり"],["、"],["その"],["息子","むすこ"],["の"],["ひとり"],["を"],["任命","にんめい"],["して"],["、"],["自分","じぶん"],["の"],["祭司","さいし"],["として"],["いた"],["。"]]},{"verse":6,"text":"そのころ、イスラエルには王がなく、めいめいが自分の目に正しいと見えることを行っていた。","tok":[["その"],["ころ"],["、"],["イスラエル"],["に"],["は"],["王","おう"],["が"],["なく"],["、"],["めいめい"],["が"],["自分","じぶん"],["の"],["目","め"],["に"],["正しい","ただしい"],["と"],["見える","みえる"],["こと"],["を"],["行って","おこなって"],["いた"],["。"]]},{"verse":7,"text":"ユダのベツレヘムの出の、ユダの氏族に属するひとりの若者がいた。彼はレビ人で、そこに滞在していた。","tok":[["ユダ"],["の"],["ベツレヘム"],["の"],["出","で"],["の"],["、"],["ユダ"],["の"],["氏族","しぞく"],["に"],["属する","ぞくする"],["ひとり"],["の"],["若者","わかもの"],["が"],["いた"],["。"],["彼","かれ"],["は"],["レビ人","れびにん"],["で"],["、"],["そこ"],["に"],["滞在","たいざい"],["して"],["いた"],["。"]]},{"verse":8,"text":"その人がユダのベツレヘムの町を出て、滞在する所を見つけに、旅を続けてエフライムの山地のミカの家まで来たとき、","tok":[["その"],["人","ひと"],["が"],["ユダ"],["の"],["ベツレヘム"],["の"],["町","まち"],["を"],["出て","でて"],["、"],["滞在","たいざい"],["する"],["所","ところ"],["を"],["見つけ","みつけ"],["に"],["、"],["旅","たび"],["を"],["続けて","つづけて"],["エフライム"],["の"],["山地","さんち"],["の"],["ミカ"],["の"],["家","いえ"],["まで"],["来た","きた"],["とき"],["、"]]},{"verse":9,"text":"ミカは彼に言った。「あなたはどこから来たのですか。」彼は答えた。「私はユダのベツレヘムから来たレビ人です。私は滞在する所を見つけようとして、歩いているのです。」","tok":[["ミカ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["どこ"],["から"],["来た","きた"],["の"],["です"],["か"],["。"],["」"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["ユダ"],["の"],["ベツレヘム"],["から"],["来た","きた"],["レビ人","れびにん"],["です"],["。"],["私","わたくし"],["は"],["滞在","たいざい"],["する"],["所","ところ"],["を"],["見つけよう","みつけよう"],["として"],["、"],["歩いて","あるいて"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":10,"text":"そこでミカは言った。「私といっしょに住んで、私のために父となり、また祭司となってください。あなたに毎年、銀十枚と、衣服ひとそろいと、あなたの生活費をあげます。」それで、このレビ人は同意した。","tok":[["そこ"],["で"],["ミカ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["と"],["いっしょ"],["に"],["住んで","すんで"],["、"],["私","わたくし"],["の"],["ため"],["に"],["父","ちち"],["と"],["なり"],["、"],["また"],["祭司","さいし"],["と"],["なって"],["ください"],["。"],["あなた"],["に"],["毎年","まいとし"],["、"],["銀","ぎん"],["十枚","じゅうまい"],["と"],["、"],["衣服","いふく"],["ひとそろい"],["と"],["、"],["あなた"],["の"],["生活費","せいかつひ"],["を"],["あげます"],["。"],["」"],["それ"],["で"],["、"],["この"],["レビ人","れびにん"],["は"],["同意","どうい"],["した"],["。"]]},{"verse":11,"text":"このレビ人は心を決めてその人といっしょに住むことにした。この若者は彼の息子のひとりのようになった。","tok":[["この"],["レビ人","れびにん"],["は"],["心","こころ"],["を"],["決めて","きめて"],["その"],["人","ひと"],["と"],["いっしょ"],["に"],["住む","すむ"],["こと"],["に"],["した"],["。"],["この"],["若者","わかもの"],["は"],["彼","かれ"],["の"],["息子","むすこ"],["の"],["ひとり"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":12,"text":"ミカがこのレビ人を任命したので、この若者は彼の祭司となり、ミカの家にいた。","tok":[["ミカ"],["が"],["この"],["レビ人","れびにん"],["を"],["任命","にんめい"],["した"],["ので"],["、"],["この"],["若者","わかもの"],["は"],["彼","かれ"],["の"],["祭司","さいし"],["と"],["なり"],["、"],["ミカ"],["の"],["家","いえ"],["に"],["いた"],["。"]]},{"verse":13,"text":"そこで、ミカは言った。「私は主が私をしあわせにしてくださることをいま知った。レビ人を私の祭司に得たから。」","tok":[["そこ"],["で"],["、"],["ミカ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["主","ぬし"],["が"],["私","わたくし"],["を"],["しあわせ"],["に"],["して"],["くださる"],["こと"],["を"],["いま"],["知った","しった"],["。"],["レビ人","れびにん"],["を"],["私","わたくし"],["の"],["祭司","さいし"],["に"],["得た","えた"],["から"],["。"],["」"]]}]
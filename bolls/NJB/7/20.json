[{"verse":1,"text":"そこで、ダンからベエル・シェバ、およびギルアデの地に至るイスラエル人はみな、出て来て、その会衆は、こぞってミツパの主のところに集まった。","tok":[["そこ"],["で"],["、"],["ダン"],["から"],["ベエル"],["・"],["シェバ"],["、"],["および"],["ギルアデ"],["の"],["地","ち"],["に"],["至る","いたる"],["イスラエル"],["人","にん"],["は"],["みな"],["、"],["出て","でて"],["来て","きて"],["、"],["その"],["会衆","かいしゅう"],["は"],["、"],["こぞって"],["ミツパ"],["の"],["主","ぬし"],["の"],["ところ"],["に"],["集まった","あつまった"],["。"]]},{"verse":2,"text":"イスラエルの全部族、民全体のかしらたち、四十万の剣を使う歩兵が神の民の集まりに出た。","tok":[["イスラエル"],["の"],["全部族","ぜんぶぞく"],["、"],["民","みん"],["全体","ぜんたい"],["の"],["かしら"],["たち"],["、"],["四十万","しじま"],["の"],["剣","けん"],["を"],["使う","つかう"],["歩兵","ふひょう"],["が"],["神","かみ"],["の"],["民","たみ"],["の"],["集まり","あつまり"],["に"],["出た","でた"],["。"]]},{"verse":3,"text":"――ベニヤミン族は、イスラエル人がミツパに上って来たことを聞いた――イスラエル人は、「こんな悪い事がどうして起こったのか、話してください」と言った。","tok":[["―"],["―"],["ベニヤミン"],["族","ぞく"],["は"],["、"],["イスラエル"],["人","にん"],["が"],["ミツパ"],["に"],["上って","のぼって"],["来た","きた"],["こと"],["を"],["聞いた","きいた"],["―"],["―"],["イスラエル"],["人","にん"],["は"],["、"],["「"],["こんな"],["悪い","わるい"],["事","こと"],["が"],["どう"],["して"],["起こった","おこった"],["の"],["か"],["、"],["話して","はなして"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"殺された女の夫であるレビ人は答えて言った。「私は、そばめといっしょに、ベニヤミンに属するギブアに行き、一夜を明かそうとしました。","tok":[["殺された","ころされた"],["女","おんな"],["の"],["夫","おっと"],["で"],["ある"],["レビ人","れびにん"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["そばめ"],["と"],["いっしょ"],["に"],["、"],["ベニヤミン"],["に"],["属する","ぞくする"],["ギブア"],["に"],["行き","いき"],["、"],["一夜","いちや"],["を"],["明かそう","あかそう"],["と"],["しました"],["。"]]},{"verse":5,"text":"すると、ギブアの者たちは私を襲い、夜中に私のいる家を取り囲み、私を殺そうと計りましたが、彼らは私のそばめに暴行を加えました。それで彼女は死にました。","tok":[["する"],["と"],["、"],["ギブア"],["の"],["者","もの"],["たち"],["は"],["私","わたくし"],["を"],["襲い","おそい"],["、"],["夜中","よなか"],["に"],["私","わたくし"],["の"],["いる"],["家","いえ"],["を"],["取り囲み","とりかこみ"],["、"],["私","わたくし"],["を"],["殺そう","ころそう"],["と"],["計りました","はかりました"],["が"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["の"],["そばめ"],["に"],["暴行","ぼうこう"],["を"],["加えました","くわえました"],["。"],["それ"],["で"],["彼女","かのじょ"],["は"],["死にました","しにました"],["。"]]},{"verse":6,"text":"そこで私は、そばめをつかみ、彼女を切り分け、それをイスラエルの相続地の全地に送りました。これは、彼らがイスラエルの中で、みだらな恥ずべきことを行ったからです。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["そばめ"],["を"],["つかみ"],["、"],["彼女","かのじょ"],["を"],["切り分け","きりわけ"],["、"],["それ"],["を"],["イスラエル"],["の"],["相続","そうぞく"],["地","ち"],["の"],["全地","ぜんち"],["に"],["送りました","おくりました"],["。"],["これ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["イスラエル"],["の"],["中","なか"],["で"],["、"],["みだら"],["な"],["恥ずべき","はずべき"],["こと"],["を"],["行った","おこなった"],["から"],["です"],["。"]]},{"verse":7,"text":"さあ、あなたがたイスラエル人のすべてよ。今ここで、意見を述べて、相談してください。」","tok":[["さあ"],["、"],["あなた"],["がた"],["イスラエル"],["人","にん"],["の"],["すべて"],["よ"],["。"],["今","いま"],["ここ"],["で"],["、"],["意見","いけん"],["を"],["述べて","のべて"],["、"],["相談","そうだん"],["して"],["ください"],["。"],["」"]]},{"verse":8,"text":"そこで、民はみな、こぞって立ち上がって言った。「私たちは、だれも自分の天幕に帰らない。だれも自分の家に戻らない。","tok":[["そこ"],["で"],["、"],["民","みん"],["は"],["みな"],["、"],["こぞって"],["立ち上がって","たちあがって"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["だれ"],["も"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["帰らない","かえらない"],["。"],["だれ"],["も"],["自分","じぶん"],["の"],["家","いえ"],["に"],["戻らない","もどらない"],["。"]]},{"verse":9,"text":"今、私たちがギブアに対してしようとしていることはこうだ。くじを引いて、攻め上ろう。","tok":[["今","いま"],["、"],["私たち","わたしたち"],["が"],["ギブア"],["に対して","にたいして"],["しよう"],["として"],["いる"],["こと"],["は"],["こう"],["だ"],["。"],["くじ"],["を"],["引いて","ひいて"],["、"],["攻め上ろう","せめのぼろう"],["。"]]},{"verse":10,"text":"私たちは、イスラエルの全部族について、百人につき十人、千人につき百人、一万人につき千人をとって、民のための糧食を持って行かせ、民がベニヤミンのギブアに行って、ベニヤミンがイスラエルでしたこのすべての恥ずべき行いに対して、報復させよう。」","tok":[["私たち","わたしたち"],["は"],["、"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["について"],["、"],["百人","ひゃくにん"],["に"],["つき"],["十人","じゅうにん"],["、"],["千人","せんにん"],["に"],["つき"],["百人","ひゃくにん"],["、"],["一万人","いちまんにん"],["に"],["つき"],["千人","せんにん"],["を"],["とって"],["、"],["民","みん"],["の"],["ため"],["の"],["糧食","りょうしょく"],["を"],["持って","もって"],["行かせ","いかせ"],["、"],["民","みん"],["が"],["ベニヤミン"],["の"],["ギブア"],["に"],["行って","いって"],["、"],["ベニヤミン"],["が"],["イスラエル"],["でした"],["この"],["すべて"],["の"],["恥ずべき","はずべき"],["行い","おこない"],["に対して","にたいして"],["、"],["報復","ほうふく"],["させよう"],["。"],["」"]]},{"verse":11,"text":"こうして、イスラエル人はみな団結し、こぞってその町に集まって来た。","tok":[["こう"],["して"],["、"],["イスラエル"],["人","にん"],["は"],["みな"],["団結","だんけつ"],["し"],["、"],["こぞって"],["その"],["町","まち"],["に"],["集まって","あつまって"],["来た","きた"],["。"]]},{"verse":12,"text":"それから、イスラエルの諸部族は、ベニヤミンの諸族のすべてに人をやって言わせた。「あなたがたのうちに起こったあの悪い事は、何ということか。","tok":[["それ"],["から"],["、"],["イスラエル"],["の"],["諸","しょ"],["部族","ぶぞく"],["は"],["、"],["ベニヤミン"],["の"],["諸族","しょぞく"],["の"],["すべて"],["に"],["人","ひと"],["を"],["やって"],["言わせた","いわせた"],["。"],["「"],["あなた"],["がた"],["の"],["うち"],["に"],["起こった","おこった"],["あの"],["悪い","わるい"],["事","こと"],["は"],["、"],["何","なん"],["と"],["いう"],["こと"],["か"],["。"]]},{"verse":13,"text":"今、ギブアにいるあのよこしまな者たちを渡せ。彼らを殺して、イスラエルから悪を除き去ろう。」ベニヤミン族は、自分たちの同族イスラエル人の言うことに聞き従おうとしなかった。","tok":[["今","いま"],["、"],["ギブア"],["に"],["いる"],["あの"],["よこしま"],["な"],["者","もの"],["たち"],["を"],["渡せ","わたせ"],["。"],["彼","かれ"],["ら"],["を"],["殺して","ころして"],["、"],["イスラエル"],["から"],["悪","あく"],["を"],["除き去ろう","のぞきさろう"],["。"],["」"],["ベニヤミン"],["族","ぞく"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["同族","どうぞく"],["イスラエル"],["人","にん"],["の"],["言う","いう"],["こと"],["に"],["聞き従おう","ききしたがおう"],["と"],["しなかった"],["。"]]},{"verse":14,"text":"それどころか、ベニヤミン族は町々からギブアに集まり、イスラエル人との戦いに出て行こうとした。","tok":[["それ"],["どころ"],["か"],["、"],["ベニヤミン"],["族","ぞく"],["は"],["町々","まちまち"],["から"],["ギブア"],["に"],["集まり","あつまり"],["、"],["イスラエル"],["人","にん"],["と"],["の"],["戦い","たたかい"],["に"],["出て","でて"],["行こう","いこう"],["と"],["した"],["。"]]},{"verse":15,"text":"その日、ベニヤミン族は、町々から二万六千人の剣を使う者を召集した。そのほかにギブアの住民のうちから七百人の精鋭を召集した。","tok":[["その"],["日","ひ"],["、"],["ベニヤミン"],["族","ぞく"],["は"],["、"],["町々","まちまち"],["から"],["二万六千","にまんろくせん"],["人","にん"],["の"],["剣","けん"],["を"],["使う","つかう"],["者","もの"],["を"],["召集","しょうしゅう"],["した"],["。"],["その"],["ほか"],["に"],["ギブア"],["の"],["住民","じゅうみん"],["の"],["うち"],["から"],["七百人","ななひゃくにん"],["の"],["精鋭","せいえい"],["を"],["召集","しょうしゅう"],["した"],["。"]]},{"verse":16,"text":"この民全体のうちに、左ききの精鋭が七百人いた。彼らはみな、一本の毛をねらって石を投げて、失敗することがなかった。","tok":[["この"],["民","みん"],["全体","ぜんたい"],["の"],["うち"],["に"],["、"],["左きき","ひだりきき"],["の"],["精鋭","せいえい"],["が"],["七百人","ななひゃくにん"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["一本","いちぽん"],["の"],["毛","け"],["を"],["ねらって"],["石","いし"],["を"],["投げて","なげて"],["、"],["失敗","しっぱい"],["する"],["こと"],["が"],["なかった"],["。"]]},{"verse":17,"text":"イスラエル人は、ベニヤミンを除いて、剣を使う者四十万人を召集した。彼らはみな、戦士であった。","tok":[["イスラエル"],["人","にん"],["は"],["、"],["ベニヤミン"],["を"],["除いて","のぞいて"],["、"],["剣","けん"],["を"],["使う","つかう"],["者","もの"],["四十万人","しじまにん"],["を"],["召集","しょうしゅう"],["した"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["戦士","せんし"],["で"],["あった"],["。"]]},{"verse":18,"text":"イスラエル人は立ち上がって、ベテルに上り、神に伺って言った。「私たちのため、だれが最初に上って行って、ベニヤミン族と戦うのでしょうか。」すると、主は仰せられた。「ユダが最初だ。」","tok":[["イスラエル"],["人","にん"],["は"],["立ち上がって","たちあがって"],["、"],["ベテル"],["に"],["上り","のぼり"],["、"],["神","かみ"],["に"],["伺って","うかがって"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["の"],["ため"],["、"],["だれ"],["が"],["最初","さいしょ"],["に"],["上って","のぼって"],["行って","いって"],["、"],["ベニヤミン"],["族","ぞく"],["と"],["戦う","たたかう"],["の"],["でしょう"],["か"],["。"],["」"],["する"],["と"],["、"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["ユダ"],["が"],["最初","さいしょ"],["だ"],["。"],["」"]]},{"verse":19,"text":"朝になると、イスラエル人は立ち上がり、ギブアに対して陣を敷いた。","tok":[["朝","あさ"],["に"],["なる"],["と"],["、"],["イスラエル"],["人","にん"],["は"],["立ち上がり","たちあがり"],["、"],["ギブア"],["に対して","にたいして"],["陣","じん"],["を"],["敷いた","しいた"],["。"]]},{"verse":20,"text":"イスラエル人はベニヤミンとの戦いに出て行った。そのとき、イスラエル人はギブアで彼らと戦うための陣ぞなえをした。","tok":[["イスラエル"],["人","にん"],["は"],["ベニヤミン"],["と"],["の"],["戦い","たたかい"],["に"],["出て","でて"],["行った","いった"],["。"],["その"],["とき"],["、"],["イスラエル"],["人","にん"],["は"],["ギブア"],["で"],["彼","かれ"],["ら"],["と"],["戦う","たたかう"],["ため"],["の"],["陣","じん"],["ぞ"],["なえ"],["を"],["した"],["。"]]},{"verse":21,"text":"ベニヤミン族はギブアから出て来て、その日、イスラエル人二万二千人をその場で殺した。","tok":[["ベニヤミン"],["族","ぞく"],["は"],["ギブア"],["から"],["出て","でて"],["来て","きて"],["、"],["その"],["日","ひ"],["、"],["イスラエル"],["人","にん"],["二万二千","にまんにせん"],["人","にん"],["を"],["その"],["場","ば"],["で"],["殺した","ころした"],["。"]]},{"verse":22,"text":"しかし、この民、イスラエル人
[{"verse":1,"text":"さて、ヨシュアの死後、イスラエル人は主に伺って言った。「だれが私たちのために最初に上って行って、カナン人と戦わなければならないでしょうか。」","tok":[["さて"],["、"],["ヨシュア"],["の"],["死後","しご"],["、"],["イスラエル"],["人","にん"],["は"],["主に","おもに"],["伺って","うかがって"],["言った","いった"],["。"],["「"],["だれ"],["が"],["私たち","わたしたち"],["の"],["ため"],["に"],["最初","さいしょ"],["に"],["上って","のぼって"],["行って","いって"],["、"],["カナン人","かなんにん"],["と"],["戦わなければ","たたかわなければ"],["ならないでしょう"],["か"],["。"],["」"]]},{"verse":2,"text":"すると、主は仰せられた。「ユダが上って行かなければならない。見よ。わたしは、その地を彼の手に渡した。」","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["ユダ"],["が"],["上って","のぼって"],["行かなければ","いかなければ"],["ならない"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["その"],["地","ち"],["を"],["彼","かれ"],["の"],["手","て"],["に"],["渡した","わたした"],["。"],["」"]]},{"verse":3,"text":"そこで、ユダは自分の兄弟シメオンに言った。「私に割り当てられた地に私といっしょに上ってください。カナン人と戦うのです。私も、あなたに割り当てられた地にあなたといっしょに行きます。」そこでシメオンは彼といっしょに行った。","tok":[["そこ"],["で"],["、"],["ユダ"],["は"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["シメオン"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["割り当てられた","わりあてられた"],["地","ち"],["に"],["私","わたくし"],["と"],["いっしょ"],["に"],["上って","のぼって"],["ください"],["。"],["カナン人","かなんにん"],["と"],["戦う","たたかう"],["の"],["です"],["。"],["私","わたくし"],["も"],["、"],["あなた"],["に"],["割り当てられた","わりあてられた"],["地","ち"],["に"],["あなた"],["と"],["いっしょ"],["に"],["行きます","いきます"],["。"],["」"],["そこ"],["で"],["シメオン"],["は"],["彼","かれ"],["と"],["いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":4,"text":"ユダが上って行ったとき、主はカナン人とペリジ人を彼らの手に渡されたので、彼らはベゼクで一万人を打った。","tok":[["ユダ"],["が"],["上って","のぼって"],["行った","いった"],["とき"],["、"],["主","ぬし"],["は"],["カナン人","かなんにん"],["と"],["ペリジ人","ぺりじにん"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡された","わたされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ベゼク"],["で"],["一万人","いちまんにん"],["を"],["打った","うった"],["。"]]},{"verse":5,"text":"彼らはベゼクでアドニ・ベゼクに出会ったとき、彼と戦ってカナン人とペリジ人を打った。","tok":[["彼","かれ"],["ら"],["は"],["ベゼク"],["で"],["アドニ"],["・"],["ベゼク"],["に"],["出会った","であった"],["とき"],["、"],["彼","かれ"],["と"],["戦って","たたかって"],["カナン人","かなんにん"],["と"],["ペリジ人","ぺりじにん"],["を"],["打った","うった"],["。"]]},{"verse":6,"text":"ところが、アドニ・ベゼクが逃げたので、彼らはあとを追って彼を捕らえ、その手足の親指を切り取った。","tok":[["ところ"],["が"],["、"],["アドニ"],["・"],["ベゼク"],["が"],["逃げた","にげた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["あと"],["を"],["追って","おって"],["彼","かれ"],["を"],["捕らえ","とらえ"],["、"],["その"],["手足","てあし"],["の"],["親指","おやゆび"],["を"],["切り取った","きりとった"],["。"]]},{"verse":7,"text":"すると、アドニ・ベゼクは言った。「私の食卓の下で、手足の親指を切り取られた七十人の王たちが、パンくずを集めていたものだ。神は私がしたとおりのことを、私に報いられた。」それから、彼らはアドニ・ベゼクをエルサレムに連れて行ったが、彼はそこで死んだ。","tok":[["する"],["と"],["、"],["アドニ"],["・"],["ベゼク"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["食卓","しょくたく"],["の"],["下","もと"],["で"],["、"],["手足","てあし"],["の"],["親指","おやゆび"],["を"],["切り取られた","きりとられた"],["七","なな"],["十人","じゅうにん"],["の"],["王","おう"],["たち"],["が"],["、"],["パン"],["くず"],["を"],["集めて","あつめて"],["いた"],["もの"],["だ"],["。"],["神","かみ"],["は"],["私","わたくし"],["が"],["した"],["とおり"],["の"],["こと"],["を"],["、"],["私","わたくし"],["に"],["報いられた","むくいられた"],["。"],["」"],["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["アドニ"],["・"],["ベゼク"],["を"],["エルサレム"],["に"],["連れて","つれて"],["行った","いった"],["が"],["、"],["彼","かれ"],["は"],["そこ"],["で"],["死んだ","しんだ"],["。"]]},{"verse":8,"text":"また、ユダ族はエルサレムを攻めて、これを取り、剣の刃でこれを打ち破り、町に火をつけた。","tok":[["また"],["、"],["ユダ族","ゆだぞく"],["は"],["エルサレム"],["を"],["攻めて","せめて"],["、"],["これ"],["を"],["取り","とり"],["、"],["剣","けん"],["の"],["刃","は"],["で"],["これ"],["を"],["打ち破り","うちやぶり"],["、"],["町","まち"],["に"],["火","ひ"],["を"],["つけた"],["。"]]},{"verse":9,"text":"その後、ユダ族は山地やネゲブや低地に住んでいるカナン人と戦うために下って行った。","tok":[["その"],["後","ご"],["、"],["ユダ族","ゆだぞく"],["は"],["山地","さんち"],["や"],["ネゲブ"],["や"],["低地","ていち"],["に"],["住んで","すんで"],["いる"],["カナン人","かなんにん"],["と"],["戦う","たたかう"],["ため"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":10,"text":"ユダはヘブロンに住んでいるカナン人を攻めた。ヘブロンの名は以前はキルヤテ・アルバであった。彼らはシェシャイとアヒマンとタルマイを打ち破った。","tok":[["ユダ"],["は"],["ヘブロン"],["に"],["住んで","すんで"],["いる"],["カナン人","かなんにん"],["を"],["攻めた","せめた"],["。"],["ヘブロン"],["の"],["名","な"],["は"],["以前","いぜん"],["は"],["キルヤテ"],["・"],["アルバ"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["シェシャイ"],["と"],["アヒマン"],["と"],["タルマイ"],["を"],["打ち破った","うちやぶった"],["。"]]},{"verse":11,"text":"ユダはそこから進んでデビルの住民を攻めた。デビルの名は以前はキルヤテ・セフェルであった。","tok":[["ユダ"],["は"],["そこ"],["から"],["進んで","すすんで"],["デビル"],["の"],["住民","じゅうみん"],["を"],["攻めた","せめた"],["。"],["デビル"],["の"],["名","な"],["は"],["以前","いぜん"],["は"],["キルヤテ"],["・"],["セフェル"],["で"],["あった"],["。"]]},{"verse":12,"text":"そのときカレブは言った。「キルヤテ・セフェルを打って、これを取る者には、私の娘アクサを妻として与えよう。」","tok":[["その"],["とき"],["カレブ"],["は"],["言った","いった"],["。"],["「"],["キルヤテ"],["・"],["セフェル"],["を"],["打って","うって"],["、"],["これ"],["を"],["取る","とる"],["者","もの"],["に"],["は"],["、"],["私","わたくし"],["の"],["娘","むすめ"],["アクサ"],["を"],["妻","つま"],["として"],["与えよう","あたえよう"],["。"],["」"]]},{"verse":13,"text":"ケナズの子で、カレブの弟オテニエルがそれを取ったので、カレブは娘アクサを彼に妻として与えた。","tok":[["ケナズ"],["の"],["子","こ"],["で"],["、"],["カレブ"],["の"],["弟","おとうと"],["オテニエル"],["が"],["それ"],["を"],["取った","とった"],["ので"],["、"],["カレブ"],["は"],["娘","むすめ"],["アクサ"],["を"],["彼","かれ"],["に"],["妻","つま"],["として"],["与えた","あたえた"],["。"]]},{"verse":14,"text":"彼女がとつぐとき、オテニエルは彼女をそそのかして、畑を父に求めることにした。彼女がろばから降りたので、カレブは彼女に、「何がほしいのか」と尋ねた。","tok":[["彼女","かのじょ"],["が"],["とつぐ"],["とき"],["、"],["オテニエル"],["は"],["彼女","かのじょ"],["を"],["そそのかして"],["、"],["畑","はたけ"],["を"],["父","ちち"],["に"],["求める","もとめる"],["こと"],["に"],["した"],["。"],["彼女","かのじょ"],["が"],["ろば"],["から"],["降りた","おりた"],["ので"],["、"],["カレブ"],["は"],["彼女","かのじょ"],["に"],["、"],["「"],["何","なん"],["が"],["ほしい"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":15,"text":"アクサは彼に言った。「どうか私に祝いの品を下さい。あなたはネゲブの地に私を送るのですから、水の泉を私に下さい。」そこでカレブは、上の泉と下の泉とを彼女に与えた。","tok":[["アクサ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["私","わたくし"],["に"],["祝い","いわい"],["の"],["品","しな"],["を"],["下さい","ください"],["。"],["あなた"],["は"],["ネゲブ"],["の"],["地","ち"],["に"],["私","わたくし"],["を"],["送る","おくる"],["の"],["です"],["から"],["、"],["水","みず"],["の"],["泉","いずみ"],["を"],["私","わたくし"],["に"],["下さい","ください"],["。"],["」"],["そこ"],["で"],["カレブ"],["は"],["、"],["上","うえ"],["の"],["泉","いずみ"],["と"],["下","した"],["の"],["泉","いずみ"],["と"],["を"],["彼女","かのじょ"],["に"],["与えた","あたえた"],["。"]]},{"verse":16,"text":"モーセの義兄弟であるケニ人の子孫は、ユダ族といっしょに、なつめやしの町からアラデの南にあるユダの荒野に上って行って、民とともに住んだ。","tok":[["モーセ"],["の"],["義兄弟","ぎけいてい"],["で"],["ある"],["ケニ"],["人","ひと"],["の"],["子孫","しそん"],["は"],["、"],["ユダ族","ゆだぞく"],["と"],["いっしょ"],["に"],["、"],["なつめやし"],["の"],["町","まち"],["から"],["アラデ"],["の"],["南","みなみ"],["に"],["ある"],["ユダ"],["の"],["荒野","あらの"],["に"],["上って","のぼって"],["行って","いって"],["、"],["民","みん"],["と"],["とも"],["に"],["住んだ","すんだ"],["。"]]},{"verse":17,"text":"ユダは兄弟シメオンといっしょに行って、ツェファテに住んでいたカナン人を打ち、それを聖絶し、その町にホルマという名をつけた。","tok":[["ユダ"],["は"],["兄弟","きょうだい"],["シメオン"],["と"],["いっしょ"],["に"],["行って","いって"],["、"],["ツェファテ"],["に"],["住んで","すんで"],["いた"],["カナン人","かなんにん"],["を"],["打ち","うち"],["、"],["それ"],["を"],["聖","せい"],["絶し","ぜっし"],["、"],["その"],["町","まち"],["に"],["ホルマ"],["と"],["いう"],["名","な"],["を"],["つけた"],["。"]]},{"verse":18,"text":"ついで、ユダはガザとその地域、アシュケロンとその地域、エクロンとその地域を攻め取った。","tok":[["つい"],["で"],["、"],["ユダ"],["は"],["ガザ"],["と"],["その"],["地域","ちいき"],["、"],["アシュケロン"],["と"],["その"],["地域","ちいき"],["、"],["エクロン"],["と"],["その"],["地域","ちいき"],["を"],["攻め取った","せめとった"],["。"]]},{"verse":19,"text":"主がユダとともにおられたので、ユダは山地を占領した。しかし、谷の住民は鉄の戦車を持っていたので、ユダは彼らを追い払わなかった。","tok":[["主","ぬし"],["が"],["ユダ"],["と"],["とも"],["に"],["おられた"],["ので"],["、"],["ユダ"],["は"],["山地","さんち"],["を"],["占領","せんりょう"],["した"],["。"],["しかし"],["、"],["谷","たに"],["の"],["住民","じゅうみん"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["を"],["持って","もって"],["いた"],["ので"],["、"],["ユダ"],["は"],["彼","かれ"],["ら"],["を"],["追い払わなかった","おいはらわなかった"],["。"]]},{"verse":20,"text":"彼らはモーセが約束したとおり、ヘブロンをカレブに与えたので、カレブはその所からアナクの三人の息子を追い払った。","tok":[["彼","かれ"],["ら"],["は"],["モーセ"],["が"],["約束","やくそく"],["した"],["とおり"],["、"],["ヘブロン"],["を"],["カレブ"],["に"],["与えた","あたえた"],["ので"],["、"],["カレブ"],["は"],["その"],["所","ところ"],["から"],["アナク"],["の"],["三人","さんにん"],["の"],["息子","むすこ"],["を"],["追い払った","おいはらった"],["。"]]},{"verse":21,"text":"ベニヤミン族はエルサレムに住んでいたエブス人を追い払わなかったので、エブス人は今日までベニヤミン族といっしょにエルサレムに住んでいる。","tok":[["ベニヤミン"],["族","ぞく"],["は"],["エルサレム"],["に"],["住んで","すんで"],["いた"],["エブス人","えぶすにん"],["を"],["追い払わなかった","おいはらわなかった"],["ので"],["、"],["エブス人","えぶすにん"],["は"],["今日","きょう"],["まで"],["ベニヤミン"],["族","ぞく"],["と"],["いっしょ"],["に"],["エルサレム"],["に"],["住んで","すんで"],["いる"],["。"]]},{"verse":22,"text":"ヨセフの一族もまた、ベテルに上って行った。主は彼らとともにおられた。","tok":[["ヨセフ"],["の"],["一族","いちぞく"],["も"],["また"],["、"],["ベテル"],["に"],["上って","のぼって"],["行った","いった"],["。"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["おられた"],["。"]]},{"verse":23,"text":"ヨセフの一族はベテルを探った。この町の名は以前はルズであった。","tok":[["ヨセフ"],["の"],["一族","いちぞく"],["は"],["ベテル"],["を"],["探った","さぐった"],["。"],["この"],["町","まち"],["の"],["名","な"],["は"],["以前","いぜん"],["は"],["ルズ"],["で"],["あった"],["。"]]},{"verse":24,"text":"見張りの者は、ひとりの人がその町から出て来るのを見て、その者に言った。「この町の出入口を教えてくれないか。私たちは、あなたにまことを尽くすから。」","tok":[["見張り","みはり"],["の"],["者","もの"],["は"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["その"],["町","まち"],["から"],["出て","でて"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["その"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["この"],["町","まち"],["の"],["出入","でいり"],["口","くち"],["を"],["教えて","おしえて"],["くれない"],["か"],["。"],["私たち","わたしたち"],["は"],["、"],["あなた"],["に"],["まこと"],["を"],["尽くす","つくす"],["から"],["。"],["」"]]},{"verse":25,"text":"彼が町の出入口を教えたので、彼らは剣の刃でこの町を打った。しかし、その者とその氏族の者全部は自由にしてやった。","tok":[["彼","かれ"],["が"],["町","まち"],["の"],["出入","でいり"],["口","くち"],["を"],["教えた","おしえた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["剣","けん"],["の"],["刃","は"],["で"],["この"],["町","まち"],["を"],["打った","うった"],["。"],["しかし"],["、"],["その"],["者","もの"],["と"],["その"],["氏族","しぞく"],["の"],["者","もの"],["全部","ぜんぶ"],["は"],["自由","じゆう"],["に"],["して"],["やった"],["。"]]},{"verse":26,"text":"そこで、その者はヘテ人の地に行って、一つの町を建て、その名をルズと呼んだ。これが今日までその名である。","tok":[["そこ"],["で"],["、"],["その"],["者","もの"],["は"],["ヘテ人","へてにん"],["の"],["地","ち"],["に"],["行って","いって"],["、"],["一","ひと"],["つ"],["の"],["町","まち"],["を"],["建て","たて"],["、"],["その"],["名","な"],["を"],["ルズ"],["と"],["呼んだ","よんだ"],["。"],["これ"],["が"],["今日","きょう"],["まで"],["その"],["名","な"],["で"],["ある"],["。"]]},{"verse":27,"text":"マナセはベテ・シェアンとそれに属する村落、タナクとそれに属する村落、ドルの住民とそれに属する村落、イブレアムの住民とそれに属する村落、メギドの住民とそれに属する村落は占領しなかった。それで、カナン人はその土地に住みとおした。","tok":[["マナセ"],["は"],["ベテ"],["・"],["シェアン"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["タナク"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["ドル"],["の"],["住民","じゅうみん"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["イブレアム"],["の"],["住民","じゅうみん"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["メギド"],["の"],["住民","じゅうみん"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["は"],["占領","せんりょう"],["しなかった"],["。"],["それ"],["で"],["、"],["カナン人","かなんにん"],["は"],["その"],["土地","とち"],["に"],["住み","すみ"],["とおした"],["。"]]},{"verse":28,"text":"イスラエルは、強くなってから、カナン人を苦役に服させたが、彼らを追い払ってしまうことはなかった。","tok":[["イスラエル"],["は"],["、"],["強く","つよく"],["なって"],["から"],["、"],["カナン人","かなんにん"],["を"],["苦役","くえき"],["に"],["服させた","ふくさせた"],["が"],["、"],["彼","かれ"],["ら"],["を"],["追い払って","おいはらって"],["しまう"],["こと"],["は"],["なかった"],["。"]]},{"verse":29,"text":"エフライムはゲゼルの住民カナン人を追い払わなかった。それで、カナン人はゲゼルで彼らの中に住んだ。","tok":[["エフライム"],["は"],["ゲゼル"],["の"],["住民","じゅうみん"],["カナン人","かなんにん"],["を"],["追い払わなかった","おいはらわなかった"],["。"],["それ"],["で"],["、"],["カナン人","かなんにん"],["は"],["ゲゼル"],["で"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["住んだ","すんだ"],["。"]]},{"verse":30,"text":"ゼブルンはキテロンの住民とナハラルの住民を追い払わなかった。それで、カナン人は彼らの中に住み、苦役に服した。","tok":[["ゼブルン"],["は"],["キテロン"],["の"],["住民","じゅうみん"],["と"],["ナハラル"],["の"],["住民","じゅうみん"],["を"],["追い払わなかった","おいはらわなかった"],["。"],["それ"],["で"],["、"],["カナン人","かなんにん"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["住み","すみ"],["、"],["苦役","くえき"],["に"],["服した","ふくした"],["。"]]},{"verse":31,"text":"アシェルはアコの住民や、シドンの住民や、またマハレブ、アクジブ、ヘルバ、アフェク、レホブの住民を追い払わなかった。","tok":[["アシェル"],["は"],["アコ"],["の"],["住民","じゅうみん"],["や"],["、"],["シドン"],["の"],["住民","じゅうみん"],["や"],["、"],["また"],["マハレブ"],["、"],["アクジブ"],["、"],["ヘルバ"],["、"],["アフェク"],["、"],["レホブ"],["の"],["住民","じゅうみん"],["を"],["追い払わなかった","おいはらわなかった"],["。"]]},{"verse":32,"text":"そして、アシェル人は、その土地に住むカナン人の中に住みついた。彼らを追い払わなかったからである。","tok":[["そして"],["、"],["アシェル"],["人","にん"],["は"],["、"],["その"],["土地","とち"],["に"],["住む","すむ"],["カナン人","かなんにん"],["の"],["中","なか"],["に"],["住みついた","すみついた"],["。"],["彼","かれ"],["ら"],["を"],["追い払わなかった","おいはらわなかった"],["から"],["で"],["ある"],["。"]]
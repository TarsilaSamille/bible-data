,["麻布","あざぶ"],["の"],["着物","きもの"],["三十","さんじゅう"],["着","ちゃく"],["と"],["晴れ着","はれぎ"],["三十","さんじゅう"],["着","ちゃく"],["と"],["を"],["私","わたくし"],["に"],["下さい","ください"],["。"],["」"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["あなた"],["の"],["なぞ"],["を"],["かけて"],["、"],["私たち","わたしたち"],["に"],["聞かせて","きかせて"],["ください"],["。"],["」"]]},{"verse":14,"text":"そこで、サムソンは彼らに言った。「食らうものから食べ物が出、強いものから甘い物が出た。」彼らは三日たっても、そのなぞを明かすことができなかった。","tok":[["そこ"],["で"],["、"],["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["食らう","くらう"],["もの"],["から"],["食べ物","たべもの"],["が"],["出","で"],["、"],["強い","つよい"],["もの"],["から"],["甘い","あまい"],["物","もの"],["が"],["出た","でた"],["。"],["」"],["彼","かれ"],["ら"],["は"],["三日","みっか"],["たって"],["も"],["、"],["その"],["なぞ"],["を"],["明かす","あかす"],["こと"],["が"],["できなかった"],["。"]]},{"verse":15,"text":"四日目になって、彼らはサムソンの妻に言った。「あなたの夫をくどいて、あのなぞを私たちに明かしてください。さもないと、私たちは火であなたとあなたの父の家とを焼き払ってしまう。あなたがたは私たちからはぎ取るために招待したのですか。そうではないでしょう。」","tok":[["四日目","よんかめ"],["に"],["なって"],["、"],["彼","かれ"],["ら"],["は"],["サムソン"],["の"],["妻","つま"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["夫","おっと"],["を"],["くどいて"],["、"],["あの"],["なぞ"],["を"],["私たち","わたしたち"],["に"],["明かして","あかして"],["ください"],["。"],["さも"],["ない"],["と"],["、"],["私たち","わたしたち"],["は"],["火","ひ"],["で"],["あなた"],["と"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["と"],["を"],["焼き払って","やきはらって"],["しまう"],["。"],["あなた"],["がた"],["は"],["私たち","わたしたち"],["から"],["はぎ取る","はぎとる"],["ため"],["に"],["招待","しょうたい"],["した"],["の"],["です"],["か"],["。"],["そう"],["で"],["は"],["ないでしょう"],["。"],["」"]]},{"verse":16,"text":"そこで、サムソンの妻は夫に泣きすがって言った。「あなたは私を憎んでばかりいて、私を愛してくださいません。あなたは私の民の人々に、なぞをかけて、それを私に解いてくださいません。」すると、サムソンは彼女に言った。「ご覧。私は父にも母にもそれを明かしてはいない。あなたに、明かさなければならないのか。」","tok":[["そこ"],["で"],["、"],["サムソン"],["の"],["妻","つま"],["は"],["夫","おっと"],["に"],["泣き","なき"],["すがって"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["を"],["憎んで","にくんで"],["ばかり"],["いて"],["、"],["私","わたくし"],["を"],["愛して","あいして"],["くださいません"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["に"],["、"],["なぞ
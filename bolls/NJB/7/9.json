[{"verse":1,"text":"さて、エルバアルの子アビメレクは、シェケムにいる自分の母の身内の者たちのところに行き、彼らと母の一族の氏族全員に告げて言った。","tok":[["さて"],["、"],["エルバアル"],["の"],["子","こ"],["アビメレク"],["は"],["、"],["シェケム"],["に"],["いる"],["自分","じぶん"],["の"],["母","はは"],["の"],["身内","みうち"],["の"],["者","もの"],["たち"],["の"],["ところ"],["に"],["行き","いき"],["、"],["彼","かれ"],["ら"],["と"],["母","はは"],["の"],["一族","いちぞく"],["の"],["氏族","しぞく"],["全員","ぜんいん"],["に"],["告げて","つげて"],["言った","いった"],["。"]]},{"verse":2,"text":"「どうかシェケムのすべての者に、よく言って聞かせてください。／エルバアルの息子七十人がみなで、あなたがたを治めるのと、ただひとりがあなたがたを治めるのと、あなたがたにとって、どちらがよいか。私があなたがたの骨肉であることを思い起こしてください。」","tok":[["「"],["どう"],["か"],["シェケム"],["の"],["すべて"],["の"],["者","もの"],["に"],["、"],["よく"],["言って","いって"],["聞かせて","きかせて"],["ください"],["。"],["／"],["エルバアル"],["の"],["息子","むすこ"],["七","なな"],["十人","じゅうにん"],["が"],["みな"],["で"],["、"],["あなた"],["がた"],["を"],["治める","おさめる"],["の"],["と"],["、"],["ただ"],["ひとり"],["が"],["あなた"],["がた"],["を"],["治める","おさめる"],["の"],["と"],["、"],["あなた"],["がた"],["にとって"],["、"],["どちら"],["が"],["よい"],["か"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["の"],["骨肉","こつにく"],["で"],["ある"],["こと"],["を"],["思い起こして","おもいおこして"],["ください"],["。"],["」"]]},{"verse":3,"text":"アビメレクの母の身内の者たちが、彼に代わって、これらのことをみな、シェケムのすべての者に言って聞かせたとき、彼らの心はアビメレクに傾いた。彼らは「彼は私たちの身内の者だ」と思ったからである。","tok":[["アビメレク"],["の"],["母","はは"],["の"],["身内","みうち"],["の"],["者","もの"],["たち"],["が"],["、"],["彼","かれ"],["に"],["代わって","かわって"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["みな"],["、"],["シェケム"],["の"],["すべて"],["の"],["者","もの"],["に"],["言って","いって"],["聞かせた","きかせた"],["とき"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["は"],["アビメレク"],["に"],["傾いた","かたむいた"],["。"],["彼","かれ"],["ら"],["は"],["「"],["彼","かれ"],["は"],["私たち","わたしたち"],["の"],["身内","みうち"],["の"],["者","もの"],["だ"],["」"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼らはバアル・ベリテの宮から銀七十シェケルを取り出して彼に与えた。アビメレクはそれで、ごろつきの、ずうずうしい者たちを雇った。彼らはアビメレクのあとについた。","tok":[["彼","かれ"],["ら"],["は"],["バアル"],["・"],["ベリテ"],["の"],["宮","みや"],["から"],["銀","ぎん"],["七十","ななじゅう"],["シェケル"],["を"],["取り出して","とりだして"],["彼","かれ"],["に"],["与えた","あたえた"],["。"],["アビメレク"],["は"],["それ"],["で"],["、"],["ごろつき"],["の"],["、"],["ずうずうしい"],["者","もの"],["たち"],["を"],["雇った","やとった"],["。"],["彼","かれ"],["ら"],["は"],["アビメレク"],["の"],["あと"],["に"],["ついた"],["。"]]},{"verse":5,"text":"それから、アビメレクはオフラにある彼の父の家に行って、自分の兄弟であるエルバアルの息子たち七十人を一つの石の上で殺した。しかし、エルバアルの末子ヨタムは隠れていたので生き残った。","tok":[["それ"],["から"],["、"],["アビメレク"],["は"],["オフラ"],["に"],["ある"],["彼","かれ"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["で"],["ある"],["エルバアル"],["の"],["息子","むすこ"],["たち"],["七","なな"],["十人","じゅうにん"],["を"],["一","ひと"],["つ"],["の"],["石","いし"],["の"],["上","うえ"],["で"],["殺した","ころした"],["。"],["しかし"],["、"],["エルバアル"],["の"],["末子","ばっし"],["ヨタム"],["は"],["隠れて","かくれて"],["いた"],["ので"],["生き残った","いきのこった"],["。"]]},{"verse":6,"text":"それで、シェケムの者とベテ・ミロの者はみな集まり、出かけて行って、シェケムにある石の柱のそばの樫の木のところで、アビメレクを王とした。","tok":[["それ"],["で"],["、"],["シェケム"],["の"],["者","もの"],["と"],["ベテ"],["・"],["ミロ"],["の"],["者","もの"],["は"],["みな"],["集まり","あつまり"],["、"],["出かけて","でかけて"],["行って","いって"],["、"],["シェケム"],["に"],["ある"],["石","いし"],["の"],["柱","はしら"],["の"],["そば"],["の"],["樫","かし"],["の"],["木","き"],["の"],["ところ"],["で"],["、"],["アビメレク"],["を"],["王","おう"],["と"],["した"],["。"]]},{"verse":7,"text":"このことがヨタムに告げられたとき、彼は行って、ゲリジム山の頂上に立ち、声を張り上げ、彼らに叫んで言った。「シェケムの者たち。私に聞け。そうすれば神はあなたがたに聞いてくださろう。","tok":[["この"],["こと"],["が"],["ヨタム"],["に"],["告げられた","つげられた"],["とき"],["、"],["彼","かれ"],["は"],["行って","いって"],["、"],["ゲリジム"],["山","さん"],["の"],["頂上","ちょうじょう"],["に"],["立ち","たち"],["、"],["声","こえ"],["を"],["張り上げ","はりあげ"],["、"],["彼","かれ"],["ら"],["に"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["シェケム"],["の"],["者","もの"],["たち"],["。"],["私","わたくし"],["に"],["聞け","きけ"],["。"],["そう"],["すれば"],["神","かみ"],["は"],["あなた"],["がた"],["に"],["聞いて","きいて"],["くださろう"],["。"]]},{"verse":8,"text":"木々が自分たちの王を立てて油をそそごうと出かけた。彼らはオリーブの木に言った。『私たちの王となってください。』","tok":[["木々","きぎ"],["が"],["自分","じぶん"],["たち"],["の"],["王","おう"],["を"],["立てて","たてて"],["油","あぶら"],["を"],["そそごう"],["と"],["出かけた","でかけた"],["。"],["彼","かれ"],["ら"],["は"],["オリーブ"],["の"],["木","き"],["に"],["言った","いった"],["。"],["『"],["私たち","わたしたち"],["の"],["王","おう"],["と"],["なって"],["ください"],["。"],["』"]]},{"verse":9,"text":"すると、オリーブの木は彼らに言った。『私は神と人とをあがめるために使われる私の油を捨て置いて、木々の上にそよぐために出かけなければならないだろうか。』","tok":[["する"],["と"],["、"],["オリーブ"],["の"],["木","き"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["『"],["私","わたくし"],["は"],["神","かみ"],["と"],["人","ひと"],["と"],["を"],["あがめる"],["ため"],["に"],["使われる","つかわれる"],["私","わたくし"],["の"],["油","あぶら"],["を"],["捨て置いて","すておいて"],["、"],["木々","きぎ"],["の"],["上","うえ"],["に"],["そよぐ"],["ため"],["に"],["出かけなければ","でかけなければ"],["ならないだろう"],["か"],["。"],["』"]]},{"verse":10,"text":"ついで、木々はいちじくの木に言った。『来て、私たちの王となってください。』","tok":[["つい"],["で"],["、"],["木々","きぎ"],["は"],["いちじく"],["の"],["木","き"],["に"],["言った","いった"],["。"],["『"],["来て","きて"],["、"],["私たち","わたしたち"],["の"],["王","おう"],["と"],["なって"],["ください"],["。"],["』"]]},{"verse":11,"text":"しかし、いちじくの木は彼らに言った。『私は、私の甘みと私の良い実を捨て置いて、木々の上にそよぐために出かけなければならないだろうか。』","tok":[["しかし"],["、"],["いちじく"],["の"],["木","き"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["『"],["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["甘み","あまみ"],["と"],["私","わたくし"],["の"],["良い","よい"],["実","じつ"],["を"],["捨て置いて","すておいて"],["、"],["木々","きぎ"],["の"],["上","うえ"],["に"],["そよぐ"],["ため"],["に"],["出かけなければ","でかけなければ"],["ならないだろう"],["か"],["。"],["』"]]},{"verse":12,"text":"それから、木々はぶどうの木に言った。『来て、私たちの王となってください。』","tok":[["それ"],["から"],["、"],["木々","きぎ"],["は"],["ぶどう"],["の"],["木","き"],["に"],["言った","いった"],["。"],["『"],["来て","きて"],["、"],["私たち","わたしたち"],["の"],["王","おう"],["と"],["なって"],["ください"],["。"],["』"]]},{"verse":13,"text":"しかし、ぶどうの木は彼らに言った。『私は、神と人とを喜ばせる私の新しいぶどう酒を捨て置いて、木々の上にそよぐために出かけなければならないだろうか。』","tok":[["しかし"],["、"],["ぶどう"],["の"],["木","き"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["『"],["私","わたくし"],["は"],["、"],["神","かみ"],["と"],["人","ひと"],["と"],["を"],["喜ばせる","よろこばせる"],["私","わたくし"],["の"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["を"],["捨て置いて","すておいて"],["、"],["木々","きぎ"],["の"],["上","うえ"],["に"],["そよぐ"],["ため"],["に"],["出かけなければ","でかけなければ"],["ならないだろう"],["か"],["。"],["』"]]},{"verse":14,"text":"そこで、すべての木がいばらに言った。『来て、私たちの王となってください。』","tok":[["そこ"],["で"],["、"],["すべて"],["の"],["木","き"],["が"],["いばら"],["に"],["言った","いった"],["。"],["『"],["来て","きて"],["、"],["私たち","わたしたち"],["の"],["王","おう"],["と"],["なって"],["ください"],["。"],["』"]]},{"verse":15,"text":"すると、いばらは木々に言った。『もしあなたがたがまことをもって私に油をそそぎ、あなたがたの王とするなら、来て、私の陰に身を避けよ。そうでなければ、いばらから火が出て、レバノンの杉の木を焼き尽くそう。』","tok":[["する"],["と"],["、"],["いばら"],["は"],["木々","きぎ"],["に"],["言った","いった"],["。"],["『"],["もし"],["あなた"],["がた"],["が"],["まこと"],["を"],["もって"],["私","わたくし"],["に"],["油","あぶら"],["を"],["そそぎ"],["、"],["あなた"],["がた"],["の"],["王","おう"],["と"],["するなら"],["、"],["来て","きて"],["、"],["私","わたくし"],["の"],["陰","かげ"],["に"],["身","み"],["を"],["避けよ","さけよ"],["。"],["そう"],["で"],["なければ"],["、"],["いばら"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["レバノン"],["の"],["杉","すぎ"],["の"],["木","き"],["を"],["焼き","やき"],["尽くそう","つくそう"],["。"],["』"]]},{"verse":16,"text":"今、あなたがたはまことと真心をもって行動して、アビメレクを王にしたのか。あなたがたはエルバアルとその家族とを、ねんごろに取り扱い、彼のてがらに報いたのか。","tok":[["今","いま"],["、"],["あなた"],["がた"],["は"],["まこと"],["と"],["真心","まごころ"],["を"],["もって"],["行動","こうどう"],["して"],["、"],["アビメレク"],["を"],["王","おう"],["に"],["した"],["の"],["か"],["。"],["あなた"],["がた"],["は"],["エルバアル"],["と"],["その"],["家族","かぞく"],["と"],["を"],["、"],["ねんごろ"],["に"],["取り扱い","とりあつかい"],["、"],["彼","かれ"],["の"],["てがら"],["に"],["報いた","むくいた"],["の"],["か"],["。"]]},{"verse":17,"text":"私の父は、あなたがたのために戦い、自分のいのちをかけて、あなたがたをミデヤン人の手から助け出したのだ。","tok":[["私","わたくし"],["の"],["父","ちち"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["戦い","たたかい"],["、"],["自分","じぶん"],["の"],["いのち"],["を"],["かけて"],["、"],["あなた"],["がた"],["を"],["ミデヤン"],["人","にん"],["の"],["手","て"],["から"],["助け出した","たすけだした"],["の"],["だ"],["。"]]},{"verse":18,"text":"あなたがたは、きょう、私の父の家にそむいて立ち上がり、その息子たち七十人を、一つの石の上で殺し、女奴隷の子アビメレクをあなたがたの身内の者だからというので、シェケムの者たちの王として立てた。","tok":[["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["私","わたくし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["そむいて"],["立ち上がり","たちあがり"],["、"],["その"],["息子","むすこ"],["たち"],["七","なな"],["十人","じゅうにん"],["を"],["、"],["一","ひと"],["つ"],["の"],["石","いし"],["の"],["上","うえ"],["で"],["殺し","ころし"],["、"],["女","じょ"],["奴隷","どれい"],["の"],["子","こ"],["アビメレク"],["を"],["あなた"],["がた"],["の"],["身内","みうち"],["の"],["者","もの"],["だ"],["から"],["と"],["いう"],["ので"],["、"],["シェケム"],["の"],["者","もの"],["たち"],["の"],["王","おう"],["として"],["立てた","たてた"],["。"]]},{"verse":19,"text":"もしあなたがたが、きょう、エルバアルと、その家族とにまことと真心をもって行動したのなら、あなたがたはアビメレクを喜び、彼もまた、あなたがたを喜ぶがよい。","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["きょう"],["、"],["エルバアル"],["と"],["、"],["その"],["家族","かぞく"],["と"],["に"],["まこと"],["と"],["真心","まごころ"],["を"],["もって"],["行動","こうどう"],["した"],["の"],["なら"],["、"],["あなた"],["がた"],["は"],["アビメレク"],["を"],["喜び","よろこび"],["、"],["彼","かれ"],["も"],["また"],["、"],["あなた"],["がた"],["を"],["喜ぶ","よろこぶ"],["が"],["よい"],["。"]]},{"verse":20,"text":"そうでなかったなら、アビメレクから火が出て、シェケムとベテ・ミロの者たちを食い尽くし、シェケムとベテ・ミロの者たちから火が出て、アビメレクを食い尽くそう。」","tok":[["そう"],["で"],["なかったなら"],["、"],["アビメレク"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["シェケム"],["と"],["ベテ"],["・"],["ミロ"],["の"],["者","もの"],["たち"],["を"],["食い","くい"],["尽くし","つくし"],["、"],["シェケム"],["と"],["ベテ"],["・"],["ミロ"],["の"],["者","もの"],["たち"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["アビメレク"],["を"],["食い","くい"],["尽くそう","つくそう"],["。"],["」"]]},{"verse":21,"text":"それから、ヨタムは逃げ去り、ベエルに行き、兄弟アビメレクを避けてそこに住んだ。","tok":[["それ"],["から"],["、"],["ヨタム"],["は"],["逃げ去り","にげさり"],["、"],["ベエル"],["に"],["行き","いき"],["、"],["兄弟","きょうだい"],["アビメレク"],["を"],["避けて","さけて"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":22,"text":"アビメレクは三年間、イスラエルを支配した。","tok":[["アビメレク"],["は"],["三","さん"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["支配","しはい"],["した"],["。"]]},{"verse":23,"text":"神は、アビメレクとシェケムの者たちの間にわざわいの霊を送ったので、シェケムの者たちはアビメレクを裏切った。","tok":[["神","かみ"],["は"],["、"],["アビメレク"],["と"],["シェケム"],["の"],["者","もの"],["たち"],["の"],["間","あいだ"],["に"],["わざわい"],["の"],["霊","れい"],["を"],["送った","おくった"],["ので"],["、"],["シェケム"],["の"],["者","もの"],["たち"],["は"],["アビメレク"],["を"],["裏切った","うらぎった"],["。"]]},{"verse":24,"text":"そのためエルバアルの七十人の息子たちへの暴虐が再現し、彼らの血が、彼らを殺した兄弟アビメレクと、アビメレクに加勢して彼の兄弟たちを殺したシェケムの者たちの上に臨んだ。","tok":[["その"],["ため"],["エルバアル"],["の"],["七","なな"],["十人","じゅうにん"],["の"],["息子","むすこ"],["たち"],["へ"],["の"],["暴虐","ぼうぎゃく"],["が"],["再現","さいげん"],["し"],["、"],["彼","かれ"],["ら"],["の"],["血","ち"],["が"],["、"],["彼","かれ"],["ら"],["を"],["殺した","ころした"],["兄弟","きょうだい"],["アビメレク"],["と"],["、"],["アビメレク"],["に"],["加勢","かせい"],["して"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["を"],["殺した","ころした"],["シェケム"],["の"],["者","もの"],["たち"],["の"],["上","うえ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":25,"text":"シェケムの者たちは、山々の頂上に彼を待ち伏せる者たちを置いたので、彼らは道でそばを過ぎるすべての者を略奪した。やがて、このことがアビメレクに告げられた。","tok":[["シェケム"],["の"],["者","もの"],["たち"],["は"],["、"],["山々","やまやま"],["の"],["頂上","ちょうじょう"],["に"],["彼","かれ"],["を"],["待ち伏せる","まちぶせる"],["者","もの"],["たち"],["を"],["置いた","おいた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["道","みち"],["で"],["そば"],["を"],["過ぎる","すぎる"],["すべて"],["の"],["者","もの"],["を"],["略奪","りゃくだつ"],["した"],["。"],["やがて"],["、"],["この"],["こと"],["が"],["アビメレク"],["に"],["告げられた","つげられた"],["。"]]},{"verse":26,"text":"エベデの子ガアルとその身内の者たちが来て、シェケムを通りかかったとき、シェケムの者たちは彼を信用した。","tok":[["エベデ"],["の"],["子","こ"],["ガアル"],["と"],["その"],["身内","みうち"],["の"],["者","もの"],["たち"],["が"],["来て","きて"],["、"],["シェケム"],["を"],["通りかかった","とおりかかった"],["とき"],["、"],["シェケム"],["の"],["者","もの"],["たち"],["は"],["彼","かれ"],["を"],["信用","しんよう"],["した"],["。"]]},{"verse":27,"text":"そこで彼らは畑に出て行って、ぶどうを収穫して、踏んだ。そして祭りをし、自分たちの神の宮に入って行って、飲み食いし、アビメレクをののしった。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["畑","はたけ"],["に"],["出て","でて"],["行って","いって"],["、"],["ぶどう"],["を"],["収穫","しゅうかく"],["して"],["、"],["踏んだ","ふんだ"],["。"],["そして"],["祭り","まつり"],["を"],["し"],["、"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["入って","はいって"],["行って","いって"],["、"],["飲み食い","のみくい"],["し"],["、"],["アビメレク"],["を"],["ののしった"],["。"]]},{"verse":28,"text":"そのとき、エベデの子ガアルは言った。「アビメレクとは何者か。シェケムとは何者か。われわれが彼に仕えなければならないとは。アビメレクはエルバアルの子、ゼブルはアビメレクの役人ではないか。シェケムの父ハモルの人々に仕えなさい。なぜわれわれはアビメレクに仕えなければならないのか。","tok":[["その"],["とき"],["、"],["エベデ"],["の"],["子","こ"],["ガアル"],["は"],["言った","いった"],["。"],["「"],["アビメレク"],["と"],["は"],["何者","なにもの"],["か"],["。"],["シェケム"],["と"],["は"],["何者","なにもの"],["か"],["。"],["われわれ"],["が"],["彼","かれ"],["に"],["仕えなければ","つかえなければ"],["ならない"],["と"],["は"],["。"],["アビメレク"],["は"],["エルバアル"],["の"],["子","こ"],["、"],["ゼブル"],["は"],["アビメレク"],["の"],["役人","やくにん"],["で"],["は"],["ない"],["か"],["。"],["シェケム"],["の"],["父","ちち"],["ハモル"],["の"],["人々","ひとびと"],["に"],["仕え","つかえ"],["なさい"],["。"],["なぜ"],["われわれ"],["は"],["アビメレク"],["に"],["仕えなければ","つかえなければ"],["ならない"],["の"],["か"],["。"]]},{"verse":29,"text":"だれか、この民を私の手に与えてくれないものか。そうすれば私はアビメレクを追い出すのだが。」そして彼はアビメレクに言った。「おまえの軍勢をふやして、出て来い。」","tok":[["だれ"],["か"],["、"],["この"],["民","たみ"],["を"],["私","わたくし"],["の"],["手","て"],["に"],["与えて","あたえて"],["くれない"],["もの"],["か"],["。"],["そう"],["すれば"],["私","わたくし"],["は"],["アビメレク"],["を"],["追い出す","おいだす"],["の"],["だ"],["が"],["。"],["」"],["そして"],["彼","かれ"],["は"],["アビメレク"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["の"],["軍勢","ぐんぜい"],["を"],["ふやして"],["、"],["出て","でて"],["来い","こい"],["。"],["」"]]},{"verse":30,"text":"この町のつかさゼブルは、エベデの子ガアルの言ったことを聞いて、怒りを燃やし、","tok":[["この"],["町","まち"],["の"],["つかさ"],["ゼブル"],["は"],["、"],["エベデ"],["の"],["子","こ"],["ガアル"],["の"],["言った","いった"],["こと"],["を"],["聞いて","きいて"],["、"],["怒り","いかり"],["を"],["燃やし","もやし"],["、"]]},{"verse":31,"text":"トルマにいるアビメレクのところに使者を送って言わせた。「今、エベデの子ガアルとその身内の者たちがシェケムに来ています。今、彼らは町を、あなたにそむかせようとしています。","tok":[["トルマ"],["に"],["いる"],["アビメレク"],["の"],["ところ"],["に"],["使者","ししゃ"],["を"],["送って","おくって"],["言わせた","いわせた"],["。"],["「"],["今","いま"],["、"],["エベデ"],["の"],["子","こ"],["ガアル"],["と"],["その"],["身内","みうち"],["の"],["者","もの"],["たち"],["が"],["シェケム"],["に"],["来て","きて"],["います"],["。"],["今","いま"],["、"],["彼","かれ"],["ら"],["は"],["町","まち"],["を"],["、"],["あなた"],["に"],["そむかせよう"],["として"],["います"],["。"]]},{"verse":32,"text":"今、あなたとあなたとともにいる民は、夜のうちに立って、野で待ち伏せなさい。","tok":[["今","いま"],["、"],["あなた"],["と"],["あなた"],["と"],["とも"],["に"],["いる"],["民","たみ"],["は"],["、"],["夜","よる"],["の"],["うち"],["に"],["立って","たって"],["、"],["野","の"],["で"],["待ち伏せ","まちぶせ"],["なさい"],["。"]]},{"verse":33,"text":"朝早く、太陽が上るころ、町に突入しなさい。すると、ガアルと、彼とともにいる民は、あなたに向かって出て来るでしょう。あなたは好機をつかんで、彼らを攻撃することができます。」","tok":[["朝","あさ"],["早く","はやく"],["、"],["太陽","たいよう"],["が"],["上る","のぼる"],["ころ"],["、"],["町","まち"],["に"],["突入","とつにゅう"],["し"],["なさい"],["。"],["する"],["と"],["、"],["ガアル"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いる"],["民","たみ"],["は"],["、"],["あなた"],["に"],["向かって","むかって"],["出て","でて"],["来るでしょう","くるでしょう"],["。"],["あなた"],["は"],["好機","こうき"],["を"],["つかんで"],["、"],["彼","かれ"],["ら"],["を"],["攻撃","こうげき"],["する"],["こと"],["が"],["できます"],["。"],["」"]]},{"verse":34,"text":"そこでアビメレクと、彼とともにいた民はみな、夜のうちに立って、四隊に分かれてシェケムに向かって待ち伏せた。","tok":[["そこ"],["で"],["アビメレク"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["民","たみ"],["は"],["みな"],["、"],["夜","よる"],["の"],["うち"],["に"],["立って","たって"],["、"],["四隊","よんたい"],["に"],["分かれて","わかれて"],["シェケム"],["に"],["向かって","むかって"],["待ち伏せた","まちぶせた"],["。"]]},{"verse":35,"text":"エベデの子ガアルが出て来て、町の門の入口に立ったとき、アビメレクと、彼とともにいた民は、待ち伏せしていた所から立ち上がった。","tok":[["エベデ"],["の"],["子","こ"],["ガアル"],["が"],["出て","でて"],["来て","きて"],["、"],["町","まち"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["立った","たった"],["とき"],["、"],["アビメレク"],["と"],["、"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["民","たみ"],["は"],["、"],["待ち伏せ","まちぶせ"],["して"],["いた"],["所","ところ"],["から"],["立ち上がった","たちあがった"],["。"]]},{"verse":36,"text":"ガアルはその民を見て、ゼブルに言った。「あれ、山々の頂から民が降りて来る。」すると、ゼブルは彼に言った。「あなたは、山々の影が人のように見えるのです。」","tok":[["ガアル"],["は"],["その"],["民","たみ"],["を"],["見て","みて"],["、"],["ゼブル"],["に"],["言った","いった"],["。"],["「"],["あれ"],["、"],["山々","やまやま"],["の"],["頂","いただき"],["から"],["民","たみ"],["が"],["降りて","おりて"],["来る","くる"],["。"],["」"],["する"],["と"],["、"],["ゼブル"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["山々","やまやま"],["の"],["影","かげ"],["が"],["人","ひと"],["の"],["よう"],["に"],["見える","みえる"],["の"],["です"],["。"],["」"]]},{"verse":37,"text":"ガアルはまた言った。「いや。人々がこの地の一番高い所から降りて来る。また一隊がメオヌニムの樫の木のほうから来る。」","tok":[["ガアル"],["は"],["また"],["言った","いった"],["。"],["「"],["いや"],["。"],["人々","ひとびと"],["が"],["この"],["地","ち"],["の"],["一番","いちばん"],["高い","たかい"],["所","ところ"],["から"],["降りて","おりて"],["来る","くる"],["。"],["また"],["一隊","いったい"],["が"],["メオヌニム"],["の"],["樫","かし"],["の"],["木","き"],["の"],["ほう"],["から"],["来る","くる"],["。"],["」"]]},{"verse":38,"text":"すると、ゼブルは彼に言った。「『アビメレクとは何者か。われわれが彼に仕えなければならないとは』と言ったあなたの口は、いったいどこにあるのですか。あなたが見くびったのは、この民ではありませんか。さあ
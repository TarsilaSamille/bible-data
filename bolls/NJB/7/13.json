[{"verse":1,"text":"イスラエル人はまた、主の目の前に悪を行ったので、主は四十年間、彼らをペリシテ人の手に渡された。","tok":[["イスラエル"],["人","にん"],["は"],["また"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行った","おこなった"],["ので"],["、"],["主","ぬし"],["は"],["四十","よんじゅう"],["年間","ねんかん"],["、"],["彼","かれ"],["ら"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"]]},{"verse":2,"text":"さて、ダン人の氏族で、その名をマノアというツォルアの出のひとりの人がいた。彼の妻は不妊の女で、子どもを産んだことがなかった。","tok":[["さて"],["、"],["ダン人","だんにん"],["の"],["氏族","しぞく"],["で"],["、"],["その"],["名","な"],["を"],["マノア"],["と"],["いう"],["ツォルア"],["の"],["出","で"],["の"],["ひとり"],["の"],["人","ひと"],["が"],["いた"],["。"],["彼","かれ"],["の"],["妻","つま"],["は"],["不妊","ふにん"],["の"],["女","おんな"],["で"],["、"],["子ども","こども"],["を"],["産んだ","うんだ"],["こと"],["が"],["なかった"],["。"]]},{"verse":3,"text":"主の使いがその女に現れて、彼女に言った。「見よ。あなたは不妊の女で、子どもを産まなかったが、あなたはみごもり、男の子を産む。","tok":[["主","ぬし"],["の"],["使い","つかい"],["が"],["その"],["女","おんな"],["に"],["現れて","あらわれて"],["、"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["見","み"],["よ"],["。"],["あなた"],["は"],["不妊","ふにん"],["の"],["女","おんな"],["で"],["、"],["子ども","こども"],["を"],["産まなかった","うまなかった"],["が"],["、"],["あなた"],["は"],["みごもり"],["、"],["男の子","おとこのこ"],["を"],["産む","うむ"],["。"]]},{"verse":4,"text":"今、気をつけなさい。ぶどう酒や強い酒を飲んではならない。汚れた物をいっさい食べてはならない。","tok":[["今","いま"],["、"],["気","き"],["を"],["つけ"],["なさい"],["。"],["ぶどう酒","ぶどうしゅ"],["や"],["強い","つよい"],["酒","さけ"],["を"],["飲んで","のんで"],["は"],["ならない"],["。"],["汚れた","よごれた"],["物","もの"],["を"],["いっさい"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"見よ。あなたはみごもっていて、男の子を産もうとしている。その子の頭にかみそりを当ててはならない。その子は胎内にいるときから神へのナジル人であるからだ。彼はイスラエルをペリシテ人の手から救い始める。」","tok":[["見","み"],["よ"],["。"],["あなた"],["は"],["みごもって"],["いて"],["、"],["男の子","おとこのこ"],["を"],["産もう","うもう"],["として"],["いる"],["。"],["その"],["子","こ"],["の"],["頭","あたま"],["に"],["かみそり"],["を"],["当てて","あてて"],["は"],["ならない"],["。"],["その"],["子","こ"],["は"],["胎内","たいない"],["に"],["いる"],["とき"],["から"],["神","かみ"],["へ"],["の"],["ナジル人","なじるにん"],["で"],["ある"],["から"],["だ"],["。"],["彼","かれ"],["は"],["イスラエル"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["救い","すくい"],["始める","はじめる"],["。"],["」"]]},{"verse":6,"text":"その女は夫のところに行き、次のように言った。「神の人が私のところに来られました。その姿は神の使いの姿のようで、とても恐ろしゅうございました。私はその方がどちらから来られたか伺いませんでした。その方も私に名をお告げになりませんでした。","tok":[["その"],["女","おんな"],["は"],["夫","おっと"],["の"],["ところ"],["に"],["行き","いき"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["の"],["人","ひと"],["が"],["私","わたくし"],["の"],["ところ"],["に"],["来られました","こられました"],["。"],["その"],["姿","すがた"],["は"],["神","かみ"],["の"],["使い","つかい"],["の"],["姿","すがた"],["の"],["よう"],["で"],["、"],["とても"],["恐ろしゅう","おそろしゅう"],["ございました"],["。"],["私","わたくし"],["は"],["その"],["方","ほう"],["が"],["どちら"],["から"],["来られた","こられた"],["か"],["伺いませんでした","うかがいませんでした"],["。"],["その"],["方","かた"],["も"],["私","わたくし"],["に"],["名","な"],["を"],["お告げ","おつげ"],["に"],["なりませんでした"],["。"]]},{"verse":7,"text":"けれども、その方は私に言われました。『見よ。あなたはみごもっていて、男の子を産もうとしている。今、ぶどう酒や強い酒を飲んではならない。汚れた物をいっさい食べてはならない。その子は胎内にいるときから死ぬ日まで、神へのナジル人であるからだ。』」","tok":[["けれど"],["も"],["、"],["その"],["方","かた"],["は"],["私","わたくし"],["に"],["言われました","いわれました"],["。"],["『"],["見","み"],["よ"],["。"],["あなた"],["は"],["みごもって"],["いて"],["、"],["男の子","おとこのこ"],["を"],["産もう","うもう"],["として"],["いる"],["。"],["今","いま"],["、"],["ぶどう酒","ぶどうしゅ"],["や"],["強い","つよい"],["酒","さけ"],["を"],["飲んで","のんで"],["は"],["ならない"],["。"],["汚れた","よごれた"],["物","もの"],["を"],["いっさい"],["食べて","たべて"],["は"],["ならない"],["。"],["その"],["子","こ"],["は"],["胎内","たいない"],["に"],["いる"],["とき"],["から"],["死ぬ","しぬ"],["日","ひ"],["まで"],["、"],["神","かみ"],["へ"],["の"],["ナジル人","なじるにん"],["で"],["ある"],["から"],["だ"],["。"],["』"],["」"]]},{"verse":8,"text":"そこで、マノアは主に願って言った。「ああ、主よ。どうぞ、あなたが遣わされたあの神の人をまた、私たちのところに来させてください。私たちが、生まれて来る子に、何をすればよいか、教えてください。」","tok":[["そこ"],["で"],["、"],["マノア"],["は"],["主に","おもに"],["願って","ねがって"],["言った","いった"],["。"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["。"],["どうぞ"],["、"],["あなた"],["が"],["遣わされた","つかわされた"],["あの"],["神","かみ"],["の"],["人","ひと"],["を"],["また"],["、"],["私たち","わたしたち"],["の"],["ところ"],["に"],["来させて","きさせて"],["ください"],["。"],["私たち","わたしたち"],["が"],["、"],["生まれて","うまれて"],["来る","くる"],["子","こ"],["に"],["、"],["何","なん"],["を"],["すれば"],["よい"],["か"],["、"],["教えて","おしえて"],["ください"],["。"],["」"]]},{"verse":9,"text":"神は、マノアの声を聞き入れられたので、神の使いが再びこの女のところに来た。彼女は、畑にすわっており、夫マノアは彼女といっしょにいなかった。","tok":[["神","かみ"],["は"],["、"],["マノア"],["の"],["声","こえ"],["を"],["聞き入れられた","ききいれられた"],["ので"],["、"],["神","かみ"],["の"],["使い","つかい"],["が"],["再び","ふたたび"],["この"],["女","おんな"],["の"],["ところ"],["に"],["来た","きた"],["。"],["彼女","かのじょ"],["は"],["、"],["畑","はたけ"],["に"],["すわって"],["おり"],["、"],["夫","おっと"],["マノア"],["は"],["彼女","かのじょ"],["と"],["いっしょ"],["に"],["いなかった"],["。"]]},{"verse":10,"text":"それで、この女は急いで走って行き、夫に告げて言った。「早く。あの日、私のところに来られたあの方が、また私に現れました。」","tok":[["それ"],["で"],["、"],["この"],["女","おんな"],["は"],["急いで","いそいで"],["走って","はしって"],["行き","いき"],["、"],["夫","おっと"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["早く","はやく"],["。"],["あの"],["日","ひ"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["来られた","こられた"],["あの"],["方","ほう"],["が"],["、"],["また"],["私","わたくし"],["に"],["現れました","あらわれました"],["。"],["」"]]},{"verse":11,"text":"マノアは立ち上がって妻のあとについて行き、その方のところに行って尋ねた。「この女にお話しになった方はあなたなのですか。」その方は言った。「わたしだ。」","tok":[["マノア"],["は"],["立ち上がって","たちあがって"],["妻","つま"],["の"],["あと"],["について"],["行き","いき"],["、"],["その"],["方","かた"],["の"],["ところ"],["に"],["行って","いって"],["尋ねた","たずねた"],["。"],["「"],["この"],["女","おんな"],["に"],["お話し","おはなし"],["に"],["なった"],["方","ほう"],["は"],["あなた"],["な"],["の"],["です"],["か"],["。"],["」"],["その"],["方","かた"],["は"],["言った","いった"],["。"],["「"],["わたし"],["だ"],["。"],["」"]]},{"verse":12,"text":"マノアは言った。「今、あなたのおことばは実現するでしょう。その子のための定めとならわしはどのようにすべきでしょうか。」","tok":[["マノア"],["は"],["言った","いった"],["。"],["「"],["今","いま"],["、"],["あなた"],["の"],["おことば"],["は"],["実現","じつげん"],["するでしょう"],["。"],["その"],["子","こ"],["の"],["ため"],["の"],["定め","さだめ"],["と"],["ならわし"],["は"],["どの"],["よう"],["に"],["すべきでしょう"],["か"],["。"],["」"]]},{"verse":13,"text":"すると、主の使いはマノアに言った。「わたしがこの女に言ったことすべてに気をつけなければならない。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["使い","つかい"],["は"],["マノア"],["に"],["言った","いった"],["。"],["「"],["わたし"],["が"],["この"],["女","おんな"],["に"],["言った","いった"],["こと"],["すべて"],["に"],["気","き"],["を"],["つけなければ"],["ならない"],["。"]]},{"verse":14,"text":"ぶどうの木からできる物はいっさい食べてはならない。ぶどう酒や、強い酒も飲んではならない。汚れた物はいっさい食べてはならない。わたしが彼女に命令したことはみな、守らなければならない。」","tok":[["ぶどう"],["の"],["木","き"],["から"],["できる"],["物","もの"],["は"],["いっさい"],["食べて","たべて"],["は"],["ならない"],["。"],["ぶどう酒","ぶどうしゅ"],["や"],["、"],["強い","つよい"],["酒","さけ"],["も"],["飲んで","のんで"],["は"],["ならない"],["。"],["汚れた","よごれた"],["物","もの"],["は"],["いっさい"],["食べて","たべて"],["は"],["ならない"],["。"],["わたし"],["が"],["彼女","かのじょ"],["に"],["命令","めいれい"],["した"],["こと"],["は"],["みな"],["、"],["守らなければ","まもらなければ"],["ならない"],["。"],["」"]]},{"verse":15,"text":"マノアは主の使いに言った。「私たちにあなたをお引き止めできますでしょうか。あなたのために子やぎを料理したいのですが。」","tok":[["マノア"],["は"],["主","ぬし"],["の"],["使い","つかい"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["に"],["あなた"],["を"],["お引き止め","おひきとめ"],["できますでしょう"],["か"],["。"],["あなた"],["の"],["ため"],["に"],["子やぎ","こやぎ"],["を"],["料理","りょうり"],["したい"],["の"],["です"],["が"],["。"],["」"]]},{"verse":16,"text":"すると、主の使いはマノアに言った。「たとい、あなたがわたしを引き止めても、わたしはあなたの食物は食べない。もし全焼のいけにえをささげたいなら、それは主にささげなさい。」マノアはその方が主の使いであることを知らなかったのである。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["使い","つかい"],["は"],["マノア"],["に"],["言った","いった"],["。"],["「"],["たとい"],["、"],["あなた"],["が"],["わたし"],["を"],["引き止めて","ひきとめて"],["も"],["、"],["わたし"],["は"],["あなた"],["の"],["食物","しょくもつ"],["は"],["食べない","たべない"],["。"],["もし"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげたいなら"],["、"],["それ"],["は"],["主に","おもに"],["ささげ"],["なさい"],["。"],["」"],["マノア"],["は"],["その"],["方","ほう"],["が"],["主","ぬし"],["の"],["使い","つかい"],["で"],["ある"],["こと"],["を"],["知らなかった","しらなかった"],["ので"],["ある"],["。"]]},{"verse":17,"text":"そこで、マノアは主の使いに言った。「お名まえは何とおっしゃるのですか。あなたのおことばが実現しましたら、私たちは、あなたをほめたたえたいのです。」","tok":[["そこ"],["で"],["、"],["マノア"],["は"],["主","ぬし"],["の"],["使い","つかい"],["に"],["言った","いった"],["。"],["「"],["お名まえ","おなまえ"],["は"],["何","なん"],["と"],["おっしゃる"],["の"],["です"],["か"],["。"],["あなた"],["の"],["おことば"],["が"],["実現","じつげん"],["しましたら"],["、"],["私たち","わたしたち"],["は"],["、"],["あなた"],["を"],["ほめたたえたい"],["の"],["です"],["。"],["」"]]},{"verse":18,"text":"主の使いは彼に言った。「なぜ、あなたはそれを聞こうとするのか。わたしの名は不思議という。」","tok":[["主","ぬし"],["の"],["使い","つかい"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["あなた"],["は"],["それ"],["を"],["聞こう","きこう"],["と"],["する"],["の"],["か"],["。"],["わたし"],["の"],["名","な"],["は"],["不思議","ふしぎ"],["と"],["いう"],["。"],["」"]]},{"verse":19,"text":"そこでマノアは、子やぎと穀物のささげ物を取り、それを岩の上で主にささげた。主はマノアとその妻が見ているところで、不思議なことをされた。","tok":[["そこ"],["で"],["マノア"],["は"],["、"],["子やぎ","こやぎ"],["と"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["取り","とり"],["、"],["それ"],["を"],["岩","いわ"],["の"],["上","うえ"],["で"],["主に","おもに"],["ささげた"],["。"],["主","ぬし"],["は"],["マノア"],["と"],["その"],["妻","つま"],["が"],["見て","みて"],["いる"],["ところ"],["で"],["、"],["不思議","ふしぎ"],["な"],["こと"],["を"],["された"],["。"]]},{"verse":20,"text":"炎が祭壇から天に向かって上ったとき、マノアとその妻の見ているところで、主の使いは祭壇の炎の中を上って行った。彼らは地にひれ伏した。","tok":[["炎","ほのお"],["が"],["祭壇","さいだん"],["から"],["天","てん"],["に"],["向かって","むかって"],["上った","のぼった"],["とき"],["、"],["マノア"],["と"],["その"],["妻","つま"],["の"],["見て","みて"],["いる"],["ところ"],["で"],["、"],["主","ぬし"],["の"],["使い","つかい"],["は"],["祭壇","さいだん"],["の"],["炎","ほのお"],["の"],["中","なか"],["を"],["上って","のぼって"],["行った","いった"],["。"],["彼","かれ"],["ら"],["は"],["地","ち"],["に"],["ひれ伏した","ひれふした"],["。"]]},{"verse":21,"text":"――主の使いは再びマノアとその妻に現れなかった――そのとき、マノアは、この方が主の使いであったのを知った。","tok":[["―"],["―"],["主","ぬし"],["の"],["使い","つかい"],["は"],["再び","ふたたび"],["マノア"],["と"],["その"],["妻","つま"],["に"],["現れなかった","あらわれなかった"],["―"],["―"],["その"],["とき"],["、"],["マノア"],["は"],["、"],["この"],["方","ほう"],["が"],["主","ぬし"],["の"],["使い","つかい"],["で"],["あった"],["の"],["を"],["知った","しった"],["。"]]},{"verse":22,"text":"それで、マノアは妻に言った。「私たちは神を見たので、必ず死ぬだろう。」","tok":[["それ"],["で"],["、"],["マノア"],["は"],["妻","つま"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["神","かみ"],["を"],["見た","みた"],["ので"],["、"],["必ず","かならず"],["死ぬだろう","しぬだろう"],["。"],["」"]]},{"verse":23,"text":"妻は彼に言った。「もし私たちを殺そうと思われたのなら、主は私たちの手から、全焼のいけにえと穀物のささげ物をお受けにならなかったでしょう。これらのことをみな、私たちにお示しにならなかったでしょうし、いましがた、こうしたことを私たちにお告げにならなかったでしょう。」","tok":[["妻","つま"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["もし"],["私たち","わたしたち"],["を"],["殺そう","ころそう"],["と"],["思われた","おもわれた"],["の"],["なら"],["、"],["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["手","て"],["から"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["お受け","おうけ"],["に"],["ならなかったでしょう"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["みな"],["、"],["私たち","わたしたち"],["に"],["お示し","おしめし"],["に"],["ならなかったでしょう"],["し"],["、"],["いましがた"],["、"],["こう"],["した"],["こと"],["を"],["私たち","わたしたち"],["に"],["お告げ","おつげ"],["に"],["ならなかったでしょう"],["。"],["」"]]},{"verse":24,"text":"その後、この女は男の子を産み、その名をサムソンと呼んだ。その子は大きくなり、主は彼を祝福された。","tok":[["その"],["後","ご"],["、"],["この"],["女","おんな"],["は"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["その"],["名","な"],["を"],["サムソン"],["と"],["呼んだ","よんだ"],["。"],["その"],["子","こ"],["は"],["大きく","おおきく"],["なり"],["、"],["主","ぬし"],["は"],["彼","かれ"],["を"],["祝福","しゅくふく"],["された"],["。"]]},{"verse":25,"text":"そして、主の霊は、ツォルアとエシュタオルとの間のマハネ・ダンで彼を揺り動かし始めた。","tok":[["そして"],["、"],["主","ぬし"],["の"],["霊","れい"],["は"],["、"],["ツォルア"],["と"],["エシュタオル"],["と"],["の"],["間","あいだ"],["の"],["マハネ"],["・"],["ダン"],["で"],["彼","かれ"],["を"],["揺り動かし","ゆりうごかし"],["始めた","はじめた"],["。"]]}]
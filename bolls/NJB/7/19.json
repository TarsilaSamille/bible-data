[{"verse":1,"text":"イスラエルに王がなかった時代のこと、ひとりのレビ人が、エフライムの山地の奥に滞在していた。この人は、そばめとして、ユダのベツレヘムからひとりの女をめとった。","tok":[["イスラエル"],["に"],["王","おう"],["が"],["なかった"],["時代","じだい"],["の"],["こと"],["、"],["ひとり"],["の"],["レビ人","れびにん"],["が"],["、"],["エフライム"],["の"],["山地","さんち"],["の"],["奥","おく"],["に"],["滞在","たいざい"],["して"],["いた"],["。"],["この"],["人","ひと"],["は"],["、"],["そばめ"],["として"],["、"],["ユダ"],["の"],["ベツレヘム"],["から"],["ひとり"],["の"],["女","おんな"],["を"],["めとった"],["。"]]},{"verse":2,"text":"ところが、そのそばめは彼をきらって、彼のところを去り、ユダのベツレヘムの自分の父の家に行き、そこに四か月の間いた。","tok":[["ところ"],["が"],["、"],["その"],["そばめ"],["は"],["彼","かれ"],["を"],["きらって"],["、"],["彼","かれ"],["の"],["ところ"],["を"],["去り","さり"],["、"],["ユダ"],["の"],["ベツレヘム"],["の"],["自分","じぶん"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["そこ"],["に"],["四","よん"],["か月","かげつ"],["の"],["間","あいだ"],["いた"],["。"]]},{"verse":3,"text":"そこで、彼女の夫は、ねんごろに話をして彼女を引き戻すために、若い者と一くびきのろばを連れ、彼女のあとを追って出かけた。彼女が夫を自分の父の家に連れて入ったとき、娘の父は彼を見て、喜んで迎えた。","tok":[["そこ"],["で"],["、"],["彼女","かのじょ"],["の"],["夫","おっと"],["は"],["、"],["ねんごろ"],["に"],["話","はなし"],["を"],["して"],["彼女","かのじょ"],["を"],["引き戻す","ひきもどす"],["ため"],["に"],["、"],["若い","わかい"],["者","もの"],["と"],["一","いち"],["く"],["びき"],["の"],["ろば"],["を"],["連れ","つれ"],["、"],["彼女","かのじょ"],["の"],["あと"],["を"],["追って","おって"],["出かけた","でかけた"],["。"],["彼女","かのじょ"],["が"],["夫","おっと"],["を"],["自分","じぶん"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["連れて","つれて"],["入った","はいった"],["とき"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["彼","かれ"],["を"],["見て","みて"],["、"],["喜んで","よろこんで"],["迎えた","むかえた"],["。"]]},{"verse":4,"text":"娘の父であるしゅうとが引き止めたので、彼は、しゅうとといっしょに三日間とどまった。こうして、彼らは食べたり飲んだりして、夜を過ごした。","tok":[["娘","むすめ"],["の"],["父","ちち"],["で"],["ある"],["しゅうと"],["が"],["引き止めた","ひきとめた"],["ので"],["、"],["彼","かれ"],["は"],["、"],["しゅうと"],["と"],["いっしょ"],["に"],["三","みっ"],["日間","かかん"],["とどまった"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["して"],["、"],["夜","よる"],["を"],["過ごした","すごした"],["。"]]},{"verse":5,"text":"四日目になって朝早く、彼は出かけようとして立ち上がった。すると、娘の父は婿に言った。「少し食事をして元気をつけ、そのあとで出かけなさい。」","tok":[["四日目","よんかめ"],["に"],["なって"],["朝","あさ"],["早く","はやく"],["、"],["彼","かれ"],["は"],["出かけよう","でかけよう"],["として"],["立ち上がった","たちあがった"],["。"],["する"],["と"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["婿","むこ"],["に"],["言った","いった"],["。"],["「"],["少し","すこし"],["食事","しょくじ"],["を"],["して"],["元気","げんき"],["を"],["つけ"],["、"],["その"],["あと"],["で"],["出かけ","でかけ"],["なさい"],["。"],["」"]]},{"verse":6,"text":"それで、彼らふたりは、すわって共に食べたり飲んだりした。娘の父はその人に言った。「どうぞ、もう一晩泊まることにして、楽しみなさい。」","tok":[["それ"],["で"],["、"],["彼","かれ"],["ら"],["ふたり"],["は"],["、"],["すわって"],["共","とも"],["に"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["した"],["。"],["娘","むすめ"],["の"],["父","ちち"],["は"],["その"],["人","ひと"],["に"],["言った","いった"],["。"],["「"],["どうぞ"],["、"],["もう"],["一","いち"],["晩","ばん"],["泊まる","とまる"],["こと"],["に"],["して"],["、"],["楽しみ","たのしみ"],["なさい"],["。"],["」"]]},{"verse":7,"text":"その人が出かけようとして立ち上がると、しゅうとが彼にしきりに勧めたので、彼はまたそこに泊まって一夜を明かした。","tok":[["その"],["人","ひと"],["が"],["出かけよう","でかけよう"],["として"],["立ち上がる","たちあがる"],["と"],["、"],["しゅうと"],["が"],["彼","かれ"],["に"],["しきり"],["に"],["勧めた","すすめた"],["ので"],["、"],["彼","かれ"],["は"],["また"],["そこ"],["に"],["泊まって","とまって"],["一夜","いちや"],["を"],["明かした","あかした"],["。"]]},{"verse":8,"text":"五日目の朝早く、彼が出かけようとすると、娘の父は言った。「どうぞ、元気をつけて、日が傾くまで、ゆっくりしていなさい。」そこで、彼らふたりは食事をした。","tok":[["五日目","いつかめ"],["の"],["朝","あさ"],["早く","はやく"],["、"],["彼","かれ"],["が"],["出かけよう","でかけよう"],["と"],["する"],["と"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["言った","いった"],["。"],["「"],["どうぞ"],["、"],["元気","げんき"],["を"],["つけて"],["、"],["日","ひ"],["が"],["傾く","かたむく"],["まで"],["、"],["ゆっくり"],["して"],["い"],["なさい"],["。"],["」"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["ふたり"],["は"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":9,"text":"それから、その人が自分のそばめと、若い者を連れて、出かけようとすると、娘の父であるしゅうとは彼に言った。「ご覧なさい。もう日が暮れかかっています。どうぞ、もう一晩お泊まりなさい。もう日も傾いています。ここに泊まって、楽しみなさい。あすの朝早く旅立って、家に帰ればいいでしょう。」","tok":[["それ"],["から"],["、"],["その"],["人","ひと"],["が"],["自分","じぶん"],["の"],["そばめ"],["と"],["、"],["若い","わかい"],["者","もの"],["を"],["連れて","つれて"],["、"],["出かけよう","でかけよう"],["と"],["する"],["と"],["、"],["娘","むすめ"],["の"],["父","ちち"],["で"],["ある"],["しゅうと"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["なさい"],["。"],["もう"],["日","ひ"],["が"],["暮れ","くれ"],["かかって"],["います"],["。"],["どうぞ"],["、"],["もう"],["一","いち"],["晩","ばん"],["お泊まり","おとまり"],["なさい"],["。"],["もう"],["日","ひ"],["も"],["傾いて","かたむいて"],["います"],["。"],["ここ"],["に"],["泊まって","とまって"],["、"],["楽しみ","たのしみ"],["なさい"],["。"],["あす"],["の"],["朝","あさ"],["早く","はやく"],["旅立って","たびだって"],["、"],["家","いえ"],["に"],["帰れば","かえれば"],["いいでしょう"],["。"],["」"]]},{"verse":10,"text":"その人は泊まりたくなかったので、立ち上がって出て行き、エブスすなわちエルサレムの向かい側にやって来た。鞍をつけた一くびきのろばと彼のそばめとが、いっしょだった。","tok":[["その"],["人","ひと"],["は"],["泊まりたく","とまりたく"],["なかった"],["ので"],["、"],["立ち上がって","たちあがって"],["出て","でて"],["行き","いき"],["、"],["エブス"],["すなわち"],["エルサレム"],["の"],["向かい側","むかいがわ"],["に"],["やって"],["来た","きた"],["。"],["鞍","くら"],["を"],["つけた"],["一","いち"],["く"],["びき"],["の"],["ろば"],["と"],["彼","かれ"],["の"],["そばめ"],["と"],["が"],["、"],["いっしょ"],["だった"],["。"]]},{"verse":11,"text":"彼らがエブスの近くに来たとき、日は非常に低くなっていた。それで、若い者は主人に言った。「さあ、このエブス人の町に寄り道して、そこで一夜を明かしましょう。」","tok":[["彼","かれ"],["ら"],["が"],["エブス"],["の"],["近く","ちかく"],["に"],["来た","きた"],["とき"],["、"],["日","ひ"],["は"],["非常","ひじょう"],["に"],["低く","ひくく"],["なって"],["いた"],["。"],["それ"],["で"],["、"],["若い","わかい"],["者","もの"],["は"],["主人","しゅじん"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["この"],["エブス人","えぶすにん"],["の"],["町","まち"],["に"],["寄り道","よりみち"],["して"],["、"],["そこ"],["で"],["一夜","いちや"],["を"],["明かしましょう","あかしましょう"],["。"],["」"]]},{"verse":12,"text":"すると、彼の主人は言った。「私たちは、イスラエル人ではない外国人の町には立ち寄らない。さあ、ギブアまで進もう。」","tok":[["する"],["と"],["、"],["彼","かれ"],["の"],["主人","しゅじん"],["は"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["イスラエル"],["人","にん"],["で"],["は"],["ない"],["外国人","がいこくじん"],["の"],["町","まち"],["に"],["は"],["立ち寄らない","たちよらない"],["。"],["さあ"],["、"],["ギブア"],["まで"],["進もう","すすもう"],["。"],["」"]]},{"verse":13,"text":"それから、彼は若い者に言った。「さあ、ギブアかラマのどちらかの地に着いて、そこで一夜を明かそう。」","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["若い","わかい"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["ギブア"],["か"],["ラマ"],["の"],["どちら"],["か"],["の"],["地","ち"],["に"],["着いて","ついて"],["、"],["そこ"],["で"],["一夜","いちや"],["を"],["明かそう","あかそう"],["。"],["」"]]},{"verse":14,"text":"こうして、彼らは進んで行った。彼らがベニヤミンに属するギブアの近くに来たとき、日は沈んだ。","tok":[["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["進んで","すすんで"],["行った","いった"],["。"],["彼","かれ"],["ら"],["が"],["ベニヤミン"],["に"],["属する","ぞくする"],["ギブア"],["の"],["近く","ちかく"],["に"],["来た","きた"],["とき"],["、"],["日","ひ"],["は"],["沈んだ","しずんだ"],["。"]]},{"verse":15,"text":"彼らはギブアに行って泊まろうとして、そこに立ち寄り、町に入って行って、広場にすわった。だれも彼らを迎えて家に泊めてくれる者がいなかったからである。","tok":[["彼","かれ"],["ら"],["は"],["ギブア"],["に"],["行って","いって"],["泊まろう","とまろう"],["として"],["、"],["そこ"],["に"],["立ち寄り","たちより"],["、"],["町","まち"],["に"],["入って","はいって"],["行って","いって"],["、"],["広場","ひろば"],["に"],["すわった"],["。"],["だれ"],["も"],["彼","かれ"],["ら"],["を"],["迎えて","むかえて"],["家","いえ"],["に"],["泊めて","とめて"],["くれる"],["者","もの"],["が"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"そこへ、夕暮れになって野ら仕事から帰ったひとりの老人がやって来た。この人はエフライムの山地の人で、ギブアに滞在していた。この土地の者たちはベニヤミン族であった。","tok":[["そこ"],["へ"],["、"],["夕暮れ","ゆうぐれ"],["に"],["なって"],["野","の"],["ら"],["仕事","しごと"],["から"],["帰った","かえった"],["ひとり"],["の"],["老人","ろうじん"],["が"],["やって"],["来た","きた"],["。"],["この"],["人","ひと"],["は"],["エフライム"],["の"],["山地","さんち"],["の"],["人","ひと"],["で"],["、"],["ギブア"],["に"],["滞在","たいざい"],["して"],["いた"],["。"],["この"],["土地","とち"],["の"],["者","もの"],["たち"],["は"],["ベニヤミン"],["族","ぞく"],["で"],["あった"],["。"]]},{"verse":17,"text":"目を上げて、町の広場にいる旅人を見たとき、この老人は、「どちらへおいでですか。どちらからおいでになったのですか」と尋ねた。","tok":[["目","め"],["を"],["上げて","あげて"],["、"],["町","まち"],["の"],["広場","ひろば"],["に"],["いる"],["旅人","たびびと"],["を"],["見た","みた"],["とき"],["、"],["この"],["老人","ろうじん"],["は"],["、"],["「"],["どちら"],["へ"],["おいでです"],["か"],["。"],["どちら"],["から"],["おいで"],["に"],["なった"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":18,"text":"そこで、その人は彼に言った。「私たちは、ユダのベツレヘムから、エフライムの山地の奥まで旅を続けているのです。私はその奥地の者です。ユダのベツレヘムまで行って来ました。今、主の宮へ帰る途中ですが、だれも私を家に迎えてくれる者がありません。","tok":[["そこ"],["で"],["、"],["その"],["人","ひと"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["ユダ"],["の"],["ベツレヘム"],["から"],["、"],["エフライム"],["の"],["山地","さんち"],["の"],["奥","おく"],["まで"],["旅","たび"],["を"],["続けて","つづけて"],["いる"],["の"],["です"],["。"],["私","わたくし"],["は"],["その"],["奥地","おくち"],["の"],["者","もの"],["です"],["。"],["ユダ"],["の"],["ベツレヘム"],["まで"],["行って","いって"],["来ました","きました"],["。"],["今","いま"],["、"],["主","ぬし"],["の"],["宮","みや"],["へ"],["帰る","かえる"],["途中","とちゅう"],["です"],["が"],["、"],["だれ"],["も"],["私","わたくし"],["を"],["家","いえ"],["に"],["迎えて","むかえて"],["くれる"],["者","もの"],["が"],["ありません"],["。"]]},{"verse":19,"text":"私たちのろばのためには、わらも飼葉もあり、また、私と、妻と、私たちといっしょにいる若い者とのためにはパンも酒もあります。足りないものは何もありません。」","tok":[["私たち","わたしたち"],["の"],["ろば"],["の"],["ため"],["に"],["は"],["、"],["わら"],["も"],["飼葉","かいば"],["も"],["あり"],["、"],["また"],["、"],["私","わたくし"],["と"],["、"],["妻","つま"],["と"],["、"],["私たち","わたしたち"],["と"],["いっしょ"],["に"],["いる"],["若い","わかい"],["者","もの"],["と"],["の"],["ため"],["に"],["は"],["パン"],["も"],["酒","さけ"],["も"],["あります"],["。"],["足りない","たりない"],["もの"],["は"],["何","なん"],["も"],["ありません"],["。"],["」"]]},{"verse":20,"text":"すると、この老人は言った。「安心なさい。ただ、足りないものはみな、私に任せて。ただ広場では夜を過ごさないでください。」","tok":[["する"],["と"],["、"],["この"],["老人","ろうじん"],["は"],["言った","いった"],["。"],["「"],["安心","あんしん"],["なさい"],["。"],["ただ"],["、"],["足りない","たりない"],["もの"],["は"],["みな"],["、"],["私","わたくし"],["に"],["任せて","まかせて"],["。"],["ただ"],["広場","ひろば"],["で"],["は"],["夜","よる"],["を"],["過ごさないで","すごさないで"],["ください"],["。"],["」"]]},{"verse":21,"text":"こうして彼は、この人を自分の家に連れて行き、ろばに、まぐさをやった。彼らは足を洗って、食べたり飲んだりした。","tok":[["こう"],["して"],["彼","かれ"],["は"],["、"],["この"],["人","ひと"],["を"],["自分","じぶん"],["の"],["家","いえ"],["に"],["連れて","つれて"],["行き","いき"],["、"],["ろば"],["に"],["、"],["まぐさ"],["を"],["やった"],["。"],["彼","かれ"],["ら"],["は"],["足","あし"],["を"],["洗って","あらって"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["した"],["。"]]},{"verse":22,"text":"彼らが楽しんでいると、町の者で、よこしまな者たちが、その家を取り囲んで、戸をたたき続けた。そして彼らは、その家の主人である老人に言った。「あなたの家に来たあの男を引き出せ。あの男を知りたい。」","tok":[["彼","かれ"],["ら"],["が"],["楽しんで","たのしんで"],["いる"],["と"],["、"],["町","まち"],["の"],["者","もの"],["で"],["、"],["よこしま"],["な"],["者","もの"],["たち"],["が"],["、"],["その"],["家","いえ"],["を"],["取り囲んで","とりかこんで"],["、"],["戸","と"],["を"],["たたき"],["続けた","つづけた"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["、"],["その"],["家","いえ"],["の"],["主人","しゅじん"],["で"],["ある"],["老人","ろうじん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["家","いえ"],["に"],["来た","きた"],["あの"],["男","おとこ"],["を"],["引き出せ","ひきだせ"],["。"],["あの"],["男","おとこ"],["を"],["知りたい","しりたい"],["。"],["」"]]},{"verse":23,"text":"そこで、家の主人であるその人は彼らのところに出て行って言った。「いけない。兄弟たちよ。どうか悪いことはしないでくれ。この人が私の家に入って後に、そんな恥ずべきことはしないでくれ。","tok":[["そこ"],["で"],["、"],["家","いえ"],["の"],["主人","しゅじん"],["で"],["ある"],["その"],["人","ひと"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["出て","でて"],["行って","いって"],["言った","いった"],["。"],["「"],["いけない"],["。"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["どう"],["か"],["悪い","わるい"],["こと"],["は"],["しないで"],["くれ"],["。"],["この"],["人","ひと"],["が"],["私","わたくし"],["の"],["家","いえ"],["に"],["入って","はいって"],["後","あと"],["に"],["、"],["そんな"],["恥ずべき","はずべき"],["こと"],["は"],["しないで"],["くれ"],["。"]]},{"verse":24,"text":"ここに処女の私の娘と、あの人のそばめがいる。今、ふたりを連れ出すから、彼らをはずかしめて、あなたがたの好きなようにしなさい。あの人には、そのような恥ずべきことはしないでくれ。」","tok":[["ここ"],["に"],["処女","しょじょ"],["の"],["私","わたくし"],["の"],["娘","むすめ"],["と"],["、"],["あの"],["人","ひと"],["の"],["そばめ"],["が"],["いる"],["。"],["今","いま"],["、"],["ふたり"],["を"],["連れ出す","つれだす"],["から"],["、"],["彼","かれ"],["ら"],["を"],["はずかしめて"],["、"],["あなた"],["がた"],["の"],["好き","すき"],["な"],["よう"],["に"],["し"],["なさい"],["。"],["あの"],["人","ひと"],["に"],["は"],["、"],["その"],["よう"],["な"],["恥ずべき","はずべき"],["こと"],["は"],["しないで"],["くれ"],["。"],["」"]]},{"verse":25,"text":"しかし、人々は彼に聞こうとしなかった。そこで、その人は自分のそばめをつかんで、外の彼らのところへ出した。すると、彼らは彼女を犯して、夜通し、朝まで暴行を加え、夜が明けかかるころ彼女を放した。","tok":[["しかし"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["に"],["聞こう","きこう"],["と"],["しなかった"],["。"],["そこ"],["で"],["、"],["その"],["人","ひと"],["は"],["自分","じぶん"],["の"],["そばめ"],["を"],["つかんで"],["、"],["外","そと"],["の"],["彼","かれ"],["ら"],["の"],["ところ"],["へ"],["出した","だした"],["。"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["彼女","かのじょ"],["を"],["犯して","おかして"],["、"],["夜通し","よどおし"],["、"],["朝","あさ"],["まで"],["暴行","ぼうこう"],["を"],["加え","くわえ"],["、"],["夜","よる"],["が"],["明けかかる","あけかかる"],["ころ"],["彼女","かのじょ"],["を"],["放した","はなした"],["。"]]},{"verse":26,"text":"夜明け前に、その女は自分の主人のいるその人の家の戸口に来て倒れ、明るくなるまでそこにいた。","tok":[["夜明け","よあけ"],["前","まえ"],["に"],["、"],["その"],["女","おんな"],["は"],["自分","じぶん"],["の"],["主人","しゅじん"],["の"],["いる"],["その"],["人","ひと"],["の"],["家","いえ"],["の"],["戸口","とぐち"],["に"],["来て","きて"],["倒れ","たおれ"],["、"],["明るく","あかるく"],["なる"],["まで"],["そこ"],["に"],["いた"],["。"]]},{"verse":27,"text":"その女の主人は、朝になって起き、家の戸を開いて、旅に出ようとして外に出た。見ると、そこに自分のそばめであるその女が、手を敷居にかけて、家の入口に倒れていた。","tok":[["その"],["女","おんな"],["の"],["主人","しゅじん"],["は"],["、"],["朝","あさ"],["に"],["なって"],["起き","おき"],["、"],["家","いえ"],["の"],["戸","と"],["を"],["開いて","ひらいて"],["、"],["旅","たび"],["に"],["出よう","でよう"],["として"],["外","そと"],["に"],["出た","でた"],["。"],["見る","みる"],["と"],["、"],["そこ"],["に"],["自分","じぶん"],["の"],["そばめ"],["で"],["ある"],["その"],["女","おんな"],["が"],["、"],["手","て"],["を"],["敷居","しきい"],["に"],["かけて"],["、"],["家","いえ"],["の"],["入口","いりぐち"],["に"],["倒れて","たおれて"],["いた"],["。"]]},{"verse":28,"text":"それで、彼はその女に、「立ちなさい。行こう」と言ったが、何の返事もなかった。それで、その人は彼女をろばに乗せ、立って自分の所へ向かって行った。","tok":[["それ"],["で"],["、"],["彼","かれ"],["は"],["その"],["女","おんな"],["に"],["、"],["「"],["立ち","たち"],["なさい"],["。"],["行こう","いこう"],["」"],["と"],["言った","いった"],["が"],["、"],["何","なん"],["の"],["返事","へんじ"],["も"],["なかった"],["。"],["それ"],["で"],["、"],["その"],["人","ひと"],["は"],["彼女","かのじょ"],["を"],["ろば"],["に"],["乗せ","のせ"],["、"],["立って","たって"],["自分","じぶん"],["の"],["所","ところ"],["へ"],["向かって","むかって"],["行った","いった"],["。"]]},{"verse":29,"text":"彼は自分の家に着くと、刀を取り、自分のそばめをつかんで、その死体を十二の部分に切り分けて、イスラエルの国中に送った。","tok":[["彼","かれ"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["着く","つく"],["と"],["、"],["刀","かたな"],["を"],["取り","とり"],["、"],["自分","じぶん"],["の"],["そばめ"],["を"],["つかんで"],["、"],["その"],["死体","したい"],["を"],["十二","じゅうに"],["の"],["部分","ぶぶん"],["に"],["切り分けて","きりわけて"],["、"],["イスラエル"],["の"],["国中","くにちゅう"],["に"],["送った","おくった"],["。"]]},{"verse":30,"text":"それを見た者はみな言った。「イスラエル人がエジプトの地から上って来た日から今日まで、こんなことは起こったこともなければ、見たこともない。このことをよく考えて、相談をし、意見を述べよ。」","tok":[["それ"],["を"],["見た","みた"],["者","もの"],["は"],["みな"],["言った","い
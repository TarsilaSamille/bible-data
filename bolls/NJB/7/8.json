[{"verse":1,"text":"そのとき、エフライム人はギデオンに言った。「あなたは、私たちに何ということをしたのですか。ミデヤン人と戦いに行ったとき、私たちに呼びかけなかったとは。」こうして彼らはギデオンを激しく責めた。","tok":[["その"],["とき"],["、"],["エフライム"],["人","にん"],["は"],["ギデオン"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["私たち","わたしたち"],["に"],["何","なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["です"],["か"],["。"],["ミデヤン"],["人","にん"],["と"],["戦い","たたかい"],["に"],["行った","いった"],["とき"],["、"],["私たち","わたしたち"],["に"],["呼びかけなかった","よびかけなかった"],["と"],["は"],["。"],["」"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["ギデオン"],["を"],["激しく","はげしく"],["責めた","せめた"],["。"]]},{"verse":2,"text":"ギデオンは彼らに言った。「今、あなたがたのしたことに比べたら、私がいったい何をしたというのですか。アビエゼルのぶどうの収穫よりも、エフライムの取り残した実のほうが、よかったのではありませんか。","tok":[["ギデオン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["今","いま"],["、"],["あなた"],["がた"],["の"],["した"],["こと"],["に"],["比べたら","くらべたら"],["、"],["私","わたくし"],["が"],["いったい"],["何","なん"],["を"],["した"],["と"],["いう"],["の"],["です"],["か"],["。"],["アビエゼル"],["の"],["ぶどう"],["の"],["収穫","しゅうかく"],["より"],["も"],["、"],["エフライム"],["の"],["取り残した","とりのこした"],["実","じつ"],["の"],["ほう"],["が"],["、"],["よかった"],["ので"],["は"],["ありません"],["か"],["。"]]},{"verse":3,"text":"神はあなたがたの手にミデヤン人の首長オレブとゼエブを渡されました。あなたがたに比べたら、私に何ができたのでしょう。」ギデオンがこのことを話すと、そのとき彼らの怒りは和らいだ。","tok":[["神","かみ"],["は"],["あなた"],["がた"],["の"],["手","て"],["に"],["ミデヤン"],["人","にん"],["の"],["首長","しゅちょう"],["オレブ"],["と"],["ゼエブ"],["を"],["渡されました","わたされました"],["。"],["あなた"],["がた"],["に"],["比べたら","くらべたら"],["、"],["私","わたくし"],["に"],["何","なん"],["が"],["できた"],["の"],["でしょう"],["。"],["」"],["ギデオン"],["が"],["この"],["こと"],["を"],["話す","はなす"],["と"],["、"],["その"],["とき"],["彼","かれ"],["ら"],["の"],["怒り","いかり"],["は"],["和らいだ","やわらいだ"],["。"]]},{"verse":4,"text":"それからギデオンは、彼に従う三百人の人々とヨルダン川を渡った。彼らは疲れていたが、追撃を続けた。","tok":[["それ"],["から"],["ギデオン"],["は"],["、"],["彼","かれ"],["に"],["従う","したがう"],["三百人","さんひゃくにん"],["の"],["人々","ひとびと"],["と"],["ヨルダン"],["川","かわ"],["を"],["渡った","わたった"],["。"],["彼","かれ"],["ら"],["は"],["疲れて","つかれて"],["いた"],["が"],["、"],["追撃","ついげき"],["を"],["続けた","つづけた"],["。"]]},{"verse":5,"text":"彼はスコテの人々に言った。「どうか、私について来ている民にパンを下さい。彼らは疲れているが、私はミデヤン人の王ゼバフとツァルムナを追っているのです。」","tok":[["彼","かれ"],["は"],["スコテ"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["私","わたくし"],["について"],["来て","きて"],["いる"],["民","たみ"],["に"],["パン"],["を"],["下さい","ください"],["。"],["彼","かれ"],["ら"],["は"],["疲れて","つかれて"],["いる"],["が"],["、"],["私","わたくし"],["は"],["ミデヤン"],["人","にん"],["の"],["王","おう"],["ゼバフ"],["と"],["ツァルムナ"],["を"],["追って","おって"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":6,"text":"すると、スコテのつかさたちは言った。「ゼバフとツァルムナの手首を、今、あなたは手にしているのでしょうか。私たちがあなたの軍団にパンを与えなければならないなどとは。」","tok":[["する"],["と"],["、"],["スコテ"],["の"],["つかさ"],["たち"],["は"],["言った","いった"],["。"],["「"],["ゼバフ"],["と"],["ツァルムナ"],["の"],["手首","てくび"],["を"],["、"],["今","いま"],["、"],["あなた"],["は"],["手","て"],["に"],["して"],["いる"],["の"],["でしょう"],["か"],["。"],["私たち","わたしたち"],["が"],["あなた"],["の"],["軍団","ぐんだん"],["に"],["パン"],["を"],["与えなければ","あたえなければ"],["ならない"],["など"],["と"],["は"],["。"],["」"]]},{"verse":7,"text":"そこでギデオンは言った。「そういうことなら、主が私の手にゼバフとツァルムナを渡されるとき、私は荒野のいばらやとげで、あなたがたを踏みつけてやる。」","tok":[["そこ"],["で"],["ギデオン"],["は"],["言った","いった"],["。"],["「"],["そう"],["いう"],["こと"],["なら"],["、"],["主","ぬし"],["が"],["私","わたくし"],["の"],["手","て"],["に"],["ゼバフ"],["と"],["ツァルムナ"],["を"],["渡される","わたされる"],["とき"],["、"],["私","わたくし"],["は"],["荒野","こうや"],["の"],["いばら"],["や"],["とげ"],["で"],["、"],["あなた"],["がた"],["を"],["踏みつけて","ふみつけて"],["やる"],["。"],["」"]]},{"verse":8,"text":"ギデオンはそこからペヌエルに上って行き、同じように彼らに言った。すると、ペヌエルの人々もスコテの人々が答えたように彼に答えた。","tok":[["ギデオン"],["は"],["そこ"],["から"],["ペヌエル"],["に"],["上って","のぼって"],["行き","いき"],["、"],["同じ","おなじ"],["よう"],["に"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["する"],["と"],["、"],["ペヌエル"],["の"],["人々","ひとびと"],["も"],["スコテ"],["の"],["人々","ひとびと"],["が"],["答えた","こたえた"],["よう"],["に"],["彼","かれ"],["に"],["答えた","こたえた"],["。"]]},{"verse":9,"text":"それでギデオンはまたペヌエルの人々に言った。「私が無事に帰って来たら、このやぐらをたたきこわしてやる。」","tok":[["それ"],["で"],["ギデオン"],["は"],["また"],["ペヌエル"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["無事","ぶじ"],["に"],["帰って","かえって"],["来たら","きたら"],["、"],["この"],["やぐら"],["を"],["たたきこわして"],["やる"],["。"],["」"]]},{"verse":10,"text":"ゼバフとツァルムナはカルコルにいたが、約一万五千からなるその陣営の者も彼らといっしょにいた。これは東の人々の陣営全体のうち生き残った者のすべてであった。剣を使う者十二万人が、すでに倒されていたからである。","tok":[["ゼバフ"],["と"],["ツァルムナ"],["は"],["カルコル"],["に"],["いた"],["が"],["、"],["約","やく"],["一万五千","いちまんごせん"],["から"],["なる"],["その"],["陣営","じんえい"],["の"],["者","もの"],["も"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["いた"],["。"],["これ"],["は"],["東","ひがし"],["の"],["人々","ひとびと"],["の"],["陣営","じんえい"],["全体","ぜんたい"],["の"],["うち"],["生き残った","いきのこった"],["者","もの"],["の"],["すべて"],["で"],["あった"],["。"],["剣","けん"],["を"],["使う","つかう"],["者","もの"],["十二万人","じゅうにまんにん"],["が"],["、"],["すでに"],["倒されて","たおされて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"そこでギデオンは、ノバフとヨグボハの東の天幕に住む人々の道に沿って上って行き、陣営を打った。陣営は油断していた。","tok":[["そこ"],["で"],["ギデオン"],["は"],["、"],["ノバ"],["フと"],["ヨグボハ"],["の"],["東","ひがし"],["の"],["天幕","てんまく"],["に"],["住む","すむ"],["人々","ひとびと"],["の"],["道","みち"],["に"],["沿って","そって"],["上って","のぼって"],["行き","いき"],["、"],["陣営","じんえい"],["を"],["打った","うった"],["。"],["陣営","じんえい"],["は"],["油断","ゆだん"],["して"],["いた"],["。"]]},{"verse":12,"text":"ゼバフとツァルムナは逃げたが、ギデオンは彼らを追って、ミデヤンのふたりの王ゼバフとツァルムナを捕らえ、その全陣営をろうばいさせた。","tok":[["ゼバフ"],["と"],["ツァルムナ"],["は"],["逃げた","にげた"],["が"],["、"],["ギデオン"],["は"],["彼","かれ"],["ら"],["を"],["追って","おって"],["、"],["ミデヤン"],["の"],["ふたり"],["の"],["王","おう"],["ゼバフ"],["と"],["ツァルムナ"],["を"],["捕らえ","とらえ"],["、"],["その"],["全","ぜん"],["陣営","じんえい"],["を"],["ろうばい"],["させた"],["。"]]},{"verse":13,"text":"それから、ヨアシュの子ギデオンは、ヘレスの坂道を通って戦いから帰って来た。","tok":[["それ"],["から"],["、"],["ヨアシュ"],["の"],["子","こ"],["ギデオン"],["は"],["、"],["ヘレス"],["の"],["坂道","さかみち"],["を"],["通って","とおって"],["戦い","たたかい"],["から"],["帰って","かえって"],["来た","きた"],["。"]]},{"verse":14,"text":"そのとき、彼はスコテの人々の中からひとりの若者を捕らえ、尋問した。すると、彼はギデオンのために、スコテのつかさたちと七十七人の長老たちの名を書いた。","tok":[["その"],["とき"],["、"],["彼","かれ"],["は"],["スコテ"],["の"],["人々","ひとびと"],["の"],["中","なか"],["から"],["ひとり"],["の"],["若者","わかもの"],["を"],["捕らえ","とらえ"],["、"],["尋問","じんもん"],["した"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["ギデオン"],["の"],["ため"],["に"],["、"],["スコテ"],["の"],["つかさ"],["たち"],["と"],["七十七人","ななじゅうしちにん"],["の"],["長老","ちょうろう"],["たち"],["の"],["名","な"],["を"],["書いた","かいた"],["。"]]},{"verse":15,"text":"そこで、ギデオンはスコテの人々のところに行って、言った。「あなたがたが、『ゼバフとツァルムナの手首を、今、あなたは手にしているのか。私たちがあなたに従う疲れた人たちにパンを与えなければならないなどとは』と言って、私をそしったそのゼバフとツァルムナが、ここにいる。」","tok":[["そこ"],["で"],["、"],["ギデオン"],["は"],["スコテ"],["の"],["人々","ひとびと"],["の"],["ところ"],["に"],["行って","いって"],["、"],["言った","いった"],["。"],["「"],["あなた"],["が"],["た"],["が"],["、"],["『"],["ゼバフ"],["と"],["ツァルムナ"],["の"],["手首","てくび"],["を"],["、"],["今","いま"],["、"],["あなた"],["は"],["手","て"],["に"],["して"],["いる"],["の"],["か"],["。"],["私たち","わたしたち"],["が"],["あなた"],["に"],["従う","したがう"],["疲れた","つかれた"],["人","ひと"],["たち"],["に"],["パン"],["を"],["与えなければ","あたえなければ"],["ならない"],["など"],["と"],["は"],["』"],["と"],["言って","いって"],["、"],["私","わたくし"],["を"],["そしった"],["その"],["ゼバフ"],["と"],["ツァルムナ"],["が"],["、"],["ここ"],["に"],["いる"],["。"],["」"]]},{"verse":16,"text":"そしてギデオンは、その町の長老たちを捕らえ、また荒野のいばらや、とげを取って、それでスコテの人々に思い知らせた。","tok":[["そして"],["ギデオン"],["は"],["、"],["その"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["を"],["捕らえ","とらえ"],["、"],["また"],["荒野","こうや"],["の"],["いばら"],["や"],["、"],["とげ"],["を"],["取って","とって"],["、"],["それ"],["で"],["スコテ"],["の"],["人々","ひとびと"],["に"],["思い知らせた","おもいしらせた"],["。"]]},{"verse":17,"text":"また彼はペヌエルのやぐらをたたきこわして、町の人々を殺した。","tok":[["また"],["彼","かれ"],["は"],["ペヌエル"],["の"],["やぐら"],["を"],["たたきこわして"],["、"],["町","まち"],["の"],["人々","ひとびと"],["を"],["殺した","ころした"],["。"]]},{"verse":18,"text":"それから、ギデオンはゼバフとツァルムナに言った。「おまえたちがタボルで殺した人たちは、どこにいるのか。」すると彼らは答えた。「あの人たちは、あなたのような人でした。どの人も王の子たちに似ていました。」","tok":[["それ"],["から"],["、"],["ギデオン"],["は"],["ゼバフ"],["と"],["ツァルムナ"],["に"],["言った","いった"],["。"],["「"],["おまえ"],["たち"],["が"],["タボル"],["で"],["殺した","ころした"],["人","ひと"],["たち"],["は"],["、"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["」"],["する"],["と"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["あの"],["人","ひと"],["たち"],["は"],["、"],["あなた"],["の"],["よう"],["な"],["人","ひと"],["でした"],["。"],["どの"],["人","ひと"],["も"],["王","おう"],["の"],["子","こ"],["たち"],["に"],["似て","にて"],["いました"],["。"],["」"]]},{"verse":19,"text":"ギデオンは言った。「彼らは私の兄弟、私の母の息子たちだ。主は生きておられる。おまえたちが彼らを生かしておいてくれたなら、私はおまえたちを殺しはしないのだが。」","tok":[["ギデオン"],["は"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["の"],["兄弟","きょうだい"],["、"],["私","わたくし"],["の"],["母","はは"],["の"],["息子","むすこ"],["たち"],["だ"],["。"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["おまえ"],["たち"],["が"],["彼","かれ"],["ら"],["を"],["生かして","いかして"],["おいて"],["くれたなら"],["、"],["私","わたくし"],["は"],["おまえ"],["たち"],["を"],["殺し","ころし"],["は"],["しない"],["の"],["だ"],["が"],["。"],["」"]]},{"verse":20,"text":"そしてギデオンは自分の長男エテルに「立って、彼らを殺しなさい」と言ったが、その若者は自分の剣を抜かなかった。彼はまだ若かったので、恐ろしかったからである。","tok":[["そして"],["ギデオン"],["は"],["自分","じぶん"],["の"],["長男","ちょうなん"],["エテル"],["に"],["「"],["立って","たって"],["、"],["彼","かれ"],["ら"],["を"],["殺し","ころし"],["なさい"],["」"],["と"],["言った","いった"],["が"],["、"],["その"],["若者","わかもの"],["は"],["自分","じぶん"],["の"],["剣","けん"],["を"],["抜かなかった","ぬかなかった"],["。"],["彼","かれ"],["は"],["まだ"],["若かった","わかかった"],["ので"],["、"],["恐ろしかった","おそろしかった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"そこで、ゼバフとツァルムナは言った。「立って、あなたが私たちに撃ちかかりなさい。人の勇気はそれぞれ違うのですから。」すると、ギデオンは立って、ゼバフとツァルムナを殺し、彼らのらくだの首に掛けてあった三日月形の飾りを取った。","tok":[["そこ"],["で"],["、"],["ゼバフ"],["と"],["ツァルムナ"],["は"],["言った","いった"],["。"],["「"],["立って","たって"],["、"],["あなた"],["が"],["私たち","わたしたち"],["に"],["撃ち","うち"],["かかり"],["なさい"],["。"],["人","ひと"],["の"],["勇気","ゆうき"],["は"],["それぞれ"],["違う","ちがう"],["の"],["です"],["から"],["。"],["」"],["する"],["と"],["、"],["ギデオン"],["は"],["立って","たって"],["、"],["ゼバフ"],["と"],["ツァルムナ"],["を"],["殺し","ころし"],["、"],["彼","かれ"],["ら"],["の"],["らくだ"],["の"],["首","くび"],["に"],["掛けて","かけて"],["あった"],["三日月形","みかつきけい"],["の"],["飾り","かざり"],["を"],["取った","とった"],["。"]]},{"verse":22,"text":"そのとき、イスラエル人はギデオンに言った。「あなたも、あなたのご子息も、あなたの孫も、私たちを治めてください。あなたが私たちをミデヤン人の手から救ったのですから。」","tok":[["その"],["とき"],["、"],["イスラエル"],["人","にん"],["は"],["ギデオン"],["に"],["言った","いった"],["。"],["「"],["あなた"],["も"],["、"],["あなた"],["の"],["ご子息","ごしそく"],["も"],["、"],["あなた"],["の"],["孫","まご"],["も"],["、"],["私たち","わたしたち"],["を"],["治めて","おさめて"],["ください"],["。"],["あなた"],["が"],["私たち","わたしたち"],["を"],["ミデヤン"],["人","にん"],["の"],["手","て"],["から"],["救った","すくった"],["の"],["です"],["から"],["。"],["」"]]},{"verse":23,"text":"しかしギデオンは彼らに言った。「私はあなたがたを治めません。また、私の息子もあなたがたを治めません。主があなたがたを治められます。」","tok":[["しかし"],["ギデオン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["あなた"],["がた"],["を"],["治めません","おさめません"],["。"],["また"],["、"],["私","わたくし"],["の"],["息子","むすこ"],["も"],["あなた"],["がた"],["を"],["治めません","おさめません"],["。"],["主","ぬし"],["が"],["あなた"],["がた"],["を"],["治められます","おさめられます"],["。"],["」"]]},{"verse":24,"text":"ついで、ギデオンは彼らに言った。「あなたがたに一つ、お願いしたい。ひとりひとり、自分の分捕り物の耳輪を私に下さい。」――殺された者たちはイシュマエル人であったので、金の耳輪をつけていたからである――","tok":[["つい"],["で"],["、"],["ギデオン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["に"],["一","ひと"],["つ"],["、"],["お願い","おねがい"],["したい"],["。"],["ひとりひとり"],["、"],["自分","じぶん"],["の"],["分","ぶん"],["捕り物","とりもの"],["の"],["耳輪","みみわ"],["を"],["私","わたくし"],["に"],["下さい","ください"],["。"],["」"],["―"],["―"],["殺された","ころされた"],["者","もの"],["たち"],["は"],["イシュマエル"],["人","にん"],["で"],["あった"],["ので"],["、"],["金","きん"],["の"],["耳輪","みみわ"],["を"],["つけて"],["いた"],["から"],["で"],["ある"],["―"],["―"]]},{"verse":25,"text":"すると、彼らは「差し上げますとも」と答えて、一枚の上着を広げ、ひとりひとりその分捕り物の耳輪をその中に投げ込んだ。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["「"],["差し上げます","さしあげます"],["とも"],["」"],["と"],["答えて","こたえて"],["、"],["一枚","いちまい"],["の"],["上着","うわぎ"],["を"],["広げ","ひろげ"],["、"],["ひとりひとり"],["その"],["分","ぶん"],["捕り物","とりもの"],["の"],["耳輪","みみわ"],["を"],["その"],["中","なか"],["に"],["投げ込んだ","なげこんだ"],["。"]]},{"verse":26,"text":"ギデオンが願った金の耳輪の目方は金で一千七百シェケルであった。このほかに、三日月形の飾りや、垂れ飾りや、ミデヤンの王たちの着ていた赤紫の衣、またほかに、彼らのらくだの首の回りに掛けていた首飾りなどもあった。","tok":[["ギデオン"],["が"],["願った","ねがった"],["金","かね"],["の"],["耳輪","みみわ"],["の"],["目方","めかた"],["は"],["金","きん"],["で"],["一千七百","いちせんななひゃく"],["シェケル"],["で"],["あった"],["。"],["この"],["ほか"],["に"],["、"],["三日月形","みかつきけい"],["の"],["飾り","かざり"],["や"],["、"],["垂れ","たれ"],["飾り","かざり"],["や"],["、"],["ミデヤン"],["の"],["王","おう"],["たち"],["の"],["着て","きて"],["いた"],["赤紫","あかむらさき"],["の"],["衣","ころも"],["、"],["また"],["ほか"],["に"],["、"],["彼","かれ"],["ら"],["の"],["らくだ"],["の
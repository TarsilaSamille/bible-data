[{"verse":1,"text":"さて、主の使いがギルガルからボキムに上って来て言った。「わたしはあなたがたをエジプトから上らせて、あなたがたの先祖に誓った地に連れて来て言った。『わたしはあなたがたとの契約を決して破らない。","tok":[["さて"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["ギルガル"],["から"],["ボキム"],["に"],["上って","のぼって"],["来て","きて"],["言った","いった"],["。"],["「"],["わたし"],["は"],["あなた"],["がた"],["を"],["エジプト"],["から"],["上らせて","のぼらせて"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["誓った","ちかった"],["地","ち"],["に"],["連れて","つれて"],["来て","きて"],["言った","いった"],["。"],["『"],["わたし"],["は"],["あなた"],["がた"],["と"],["の"],["契約","けいやく"],["を"],["決して","けっして"],["破らない","やぶらない"],["。"]]},{"verse":2,"text":"あなたがたはこの地の住民と契約を結んではならない。彼らの祭壇を取りこわさなければならない。』ところが、あなたがたはわたしの声に聞き従わなかった。なぜこのようなことをしたのか。","tok":[["あなた"],["がた"],["は"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["を"],["取りこわさなければ","とりこわさなければ"],["ならない"],["。"],["』"],["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["声","こえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"],["なぜ"],["この"],["よう"],["な"],["こと"],["を"],["した"],["の"],["か"],["。"]]},{"verse":3,"text":"それゆえわたしは言う。『わたしはあなたがたの前から彼らを追い出さない。彼らはあなたがたの敵となり、彼らの神々はあなたがたにとってわなとなる。』」","tok":[["それ"],["ゆえ"],["わたし"],["は"],["言う","ゆう"],["。"],["『"],["わたし"],["は"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い出さない","おいださない"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["の"],["敵","てき"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["は"],["あなた"],["がた"],["にとって"],["わ"],["な"],["と"],["なる"],["。"],["』"],["」"]]},{"verse":4,"text":"主の使いがこれらのことばをイスラエル人全体に語ったとき、民は声をあげて泣いた。","tok":[["主","ぬし"],["の"],["使い","つかい"],["が"],["これ"],["ら"],["の"],["ことば"],["を"],["イスラエル"],["人","にん"],["全体","ぜんたい"],["に"],["語った","かたった"],["とき"],["、"],["民","みん"],["は"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":5,"text":"それで、その場所の名をボキムと呼んだ。彼らはその場所で主にいけにえをささげた。","tok":[["それ"],["で"],["、"],["その"],["場所","ばしょ"],["の"],["名","な"],["を"],["ボキム"],["と"],["呼んだ","よんだ"],["。"],["彼","かれ"],["ら"],["は"],["その"],["場所","ばしょ"],["で"],["主に","おもに"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":6,"text":"ヨシュアが民を送り出したので、イスラエル人はそれぞれ地を自分の相続地として占領するために出て行った。","tok":[["ヨシュア"],["が"],["民","たみ"],["を"],["送り出した","おくりだした"],["ので"],["、"],["イスラエル"],["人","にん"],["は"],["それぞれ"],["地","ち"],["を"],["自分","じぶん"],["の"],["相続","そうぞく"],["地","ち"],["として"],["占領","せんりょう"],["する"],["ため"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":7,"text":"民は、ヨシュアの生きている間、また、ヨシュアのあとまで生き残って主がイスラエルに行われたすべての大きなわざを見た長老たちの生きている間、主に仕えた。","tok":[["民","みん"],["は"],["、"],["ヨシュア"],["の"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["また"],["、"],["ヨシュア"],["の"],["あと"],["まで"],["生き残って","いきのこって"],["主","ぬし"],["が"],["イスラエル"],["に"],["行われた","おこなわれた"],["すべて"],["の"],["大きな","おおきな"],["わざ"],["を"],["見た","みた"],["長老","ちょうろう"],["たち"],["の"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["主に","おもに"],["仕えた","つかえた"],["。"]]},{"verse":8,"text":"主のしもべ、ヌンの子ヨシュアは百十歳で死んだ。","tok":[["主","ぬし"],["の"],["しもべ"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["百十歳","ひゃくとうさい"],["で"],["死んだ","しんだ"],["。"]]},{"verse":9,"text":"人々は彼を、エフライムの山地、ガアシュ山の北にある彼の相続の地境ティムナテ・ヘレスに葬った。","tok":[["人々","ひとびと"],["は"],["彼","かれ"],["を"],["、"],["エフライム"],["の"],["山地","さんち"],["、"],["ガアシュ"],["山","やま"],["の"],["北","きた"],["に"],["ある"],["彼","かれ"],["の"],["相続","そうぞく"],["の"],["地境","じざかい"],["ティムナテ"],["・"],["ヘレス"],["に"],["葬った","ほうむった"],["。"]]},{"verse":10,"text":"その同世代の者もみな、その先祖のもとに集められたが、彼らのあとに、主を知らず、また、主がイスラエルのためにされたわざも知らないほかの世代が起こった。","tok":[["その"],["同世代","どうせだい"],["の"],["者","もの"],["も"],["みな"],["、"],["その"],["先祖","せんぞ"],["の"],["もと"],["に"],["集められた","あつめられた"],["が"],["、"],["彼","かれ"],["ら"],["の"],["あと"],["に"],["、"],["主","ぬし"],["を"],["知らず","しらず"],["、"],["また"],["、"],["主","ぬし"],["が"],["イスラエル"],["の"],["ため"],["に"],["された"],["わざ"],["も"],["知らない","しらない"],["ほか"],["の"],["世代","せだい"],["が"],["起こった","おこった"],["。"]]},{"verse":11,"text":"それで、イスラエル人は主の目の前に悪を行い、バアルに仕えた。","tok":[["それ"],["で"],["、"],["イスラエル"],["人","にん"],["は"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行い","おこない"],["、"],["バアル"],["に"],["仕えた","つかえた"],["。"]]},{"verse":12,"text":"彼らは、エジプトの地から自分たちを連れ出した父祖の神、主を捨てて、ほかの神々、彼らの回りにいる国々の民の神々に従い、それらを拝み、主を怒らせた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["エジプト"],["の"],["地","ち"],["から"],["自分","じぶん"],["たち"],["を"],["連れ出した","つれだした"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["捨てて","すてて"],["、"],["ほか"],["の"],["神々","かみがみ"],["、"],["彼","かれ"],["ら"],["の"],["回り","まわり"],["に"],["いる"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["それ"],["ら"],["を"],["拝み","おがみ"],["、"],["主","ぬし"],["を"],["怒らせた","おこらせた"],["。"]]},{"verse":13,"text":"彼らが主を捨てて、バアルとアシュタロテに仕えたので、","tok":[["彼","かれ"],["ら"],["が"],["主","ぬし"],["を"],["捨てて","すてて"],["、"],["バアル"],["と"],["アシュタロテ"],["に"],["仕えた","つかえた"],["ので"],["、"]]},{"verse":14,"text":"主の怒りがイスラエルに向かって燃え上がり、主は彼らを略奪者の手に渡して、彼らを略奪させた。主は回りの敵の手に彼らを売り渡した。それで、彼らはもはや、敵の前に立ち向かうことができなかった。","tok":[["主","ぬし"],["の"],["怒り","いかり"],["が"],["イスラエル"],["に"],["向かって","むかって"],["燃え上がり","もえあがり"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["略奪者","りゃくだつしゃ"],["の"],["手","て"],["に"],["渡して","わたして"],["、"],["彼","かれ"],["ら"],["を"],["略奪","りゃくだつ"],["させた"],["。"],["主","ぬし"],["は"],["回り","まわり"],["の"],["敵","てき"],["の"],["手","て"],["に"],["彼","かれ"],["ら"],["を"],["売り渡した","うりわたした"],["。"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["もはや"],["、"],["敵","てき"],["の"],["前","まえ"],["に"],["立ち向かう","たちむかう"],["こと"],["が"],["できなかった"],["。"]]},{"verse":15,"text":"彼らがどこへ出て行っても、主の手が彼らにわざわいをもたらした。主が告げ、主が彼らに誓われたとおりであった。それで、彼らは非常に苦しんだ。","tok":[["彼","かれ"],["ら"],["が"],["どこ"],["へ"],["出て","でて"],["行って","いって"],["も"],["、"],["主","ぬし"],["の"],["手","て"],["が"],["彼","かれ"],["ら"],["に"],["わざわい"],["を"],["もたらした"],["。"],["主","ぬし"],["が"],["告げ","つげ"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["に"],["誓われた","ちかわれた"],["とおり"],["で"],["あった"],["。"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["非常","ひじょう"],["に"],["苦しんだ","くるしんだ"],["。"]]},{"verse":16,"text":"そのとき、主はさばきつかさを起こして、彼らを略奪する者の手から救われた。","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["さばき"],["つかさ"],["を"],["起こして","おこして"],["、"],["彼","かれ"],["ら"],["を"],["略奪","りゃくだつ"],["する"],["者","もの"],["の"],["手","て"],["から"],["救われた","すくわれた"],["。"]]},{"verse":17,"text":"ところが、彼らはそのさばきつかさにも聞き従わず、ほかの神々を慕って淫行を行い、それを拝み、彼らの先祖たちが主の命令に聞き従って歩んだ道から、またたくまにそれて、先祖たちのようには行わなかった。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その"],["さばき"],["つかさ"],["に"],["も"],["聞き従わず","ききしたがわず"],["、"],["ほか"],["の"],["神々","かみがみ"],["を"],["慕って","したって"],["淫行","いんこう"],["を"],["行い","おこない"],["、"],["それ"],["を"],["拝み","おがみ"],["、"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["が"],["主","ぬし"],["の"],["命令","めいれい"],["に"],["聞き従って","ききしたがって"],["歩んだ","あゆんだ"],["道","みち"],["から"],["、"],["またたく"],["ま"],["に"],["それて"],["、"],["先祖","せんぞ"],["たち"],["の"],["よう"],["に"],["は"],["行わなかった","おこなわなかった"],["。"]]},{"verse":18,"text":"主が彼らのためにさばきつかさを起こされる場合は、主はさばきつかさとともにおられ、そのさばきつかさの生きている間は、敵の手から彼らを救われた。これは、圧迫し、苦しめる者のために彼らがうめいたので、主があわれまれたからである。","tok":[["主","ぬし"],["が"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["さばき"],["つかさ"],["を"],["起こされる","おこされる"],["場合","ばあい"],["は"],["、"],["主","ぬし"],["は"],["さばきつ"],["か"],["さ"],["と"],["とも"],["に"],["おられ"],["、"],["その"],["さばき"],["つかさ"],["の"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["敵","てき"],["の"],["手","て"],["から"],["彼","かれ"],["ら"],["を"],["救われた","すくわれた"],["。"],["これ"],["は"],["、"],["圧迫","あっぱく"],["し"],["、"],["苦しめる","くるしめる"],["者","もの"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["が"],["うめいた"],["ので"],["、"],["主","ぬし"],["が"],["あわれまれた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"しかし、さばきつかさが死ぬと、彼らはいつも逆戻りして、先祖たちよりも、いっそう堕落して、ほかの神々に従い、それに仕え、それを拝んだ。彼らはその行いや、頑迷な生き方を捨てなかった。","tok":[["しかし"],["、"],["さばき"],["つかさ"],["が"],["死ぬ","しぬ"],["と"],["、"],["彼","かれ"],["ら"],["は"],["いつも"],["逆戻り","ぎゃくもどり"],["して"],["、"],["先祖","せんぞ"],["たち"],["より"],["も"],["、"],["いっそう"],["堕落","だらく"],["して"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["それ"],["に"],["仕え","つかえ"],["、"],["それ"],["を"],["拝んだ","おがんだ"],["。"],["彼","かれ"],["ら"],["は"],["その"],["行い","おこない"],["や"],["、"],["頑迷","がんめい"],["な"],["生き方","いきかた"],["を"],["捨てなかった","すてなかった"],["。"]]},{"verse":20,"text":"それで、主の怒りがイスラエルに向かって燃え上がった。主は仰せられた。「この民は、わたしが彼らの先祖たちに命じたわたしの契約を破り、わたしの声に聞き従わなかったから、","tok":[["それ"],["で"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["が"],["イスラエル"],["に"],["向かって","むかって"],["燃え上がった","もえあがった"],["。"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["この"],["民","みん"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["に"],["命じた","めいじた"],["わたし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["から"],["、"]]},{"verse":21,"text":"わたしもまた、ヨシュアが死んだとき残していた国民を、彼らの前から一つも追い払わない。","tok":[["わたし"],["も"],["また"],["、"],["ヨシュア"],["が"],["死んだ","しんだ"],["とき"],["残して","のこして"],["いた"],["国民","こくみん"],["を"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["から"],["一","ひと"],["つ"],["も"],["追い払わない","おいはらわない"],["。"]]},{"verse":22,"text":"彼らの先祖たちが主の道を守って歩んだように、彼らもそれを守って歩むかどうか、これらの国民によってイスラエルを試みるためである。」","tok":[["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["が"],["主","ぬし"],["の"],["道","みち"],["を"],["守って","まもって"],["歩んだ","あゆんだ"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["それ"],["を"],["守って","まもって"],["歩む","あゆむ"],["か"],["どう"],["か"],["、"],["これ"],["ら"],["の"],["国民","こくみん"],["によって"],["イスラエル"],["を"],["試みる","こころみる"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":23,"text":"こうして、主はこれらの国民をただちに追い出さないで、残しておき、ヨシュアの手に渡されなかったのである。","tok":[["こう"],["して"],["、"],["主","ぬし"],["は"],["これ"],["ら"],["の"],["国民","こくみん"],["を"],["ただちに"],["追い出さないで","おいださないで"],["、"],["残して","のこして"],["おき"],["、"],["ヨシュア"],["の"],["手","て"],["に"],["渡されなかった","わたされなかった"],["ので"],["ある"],["。"]]}]
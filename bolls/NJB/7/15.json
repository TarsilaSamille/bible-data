[{"verse":1,"text":"しばらくたって、小麦の刈り入れの時に、サムソンは一匹の子やぎを持って自分の妻をたずね、「私の妻の部屋に入りたい」と言ったが、彼女の父は、入らせなかった。","tok":[["しばらく"],["たって"],["、"],["小麦","こむぎ"],["の"],["刈り入れ","かりいれ"],["の"],["時","とき"],["に"],["、"],["サムソン"],["は"],["一匹","いちひき"],["の"],["子やぎ","こやぎ"],["を"],["持って","もって"],["自分","じぶん"],["の"],["妻","つま"],["を"],["たずね"],["、"],["「"],["私","わたくし"],["の"],["妻","つま"],["の"],["部屋","へや"],["に"],["入りたい","はいりたい"],["」"],["と"],["言った","いった"],["が"],["、"],["彼女","かのじょ"],["の"],["父","ちち"],["は"],["、"],["入らせなかった","はいらせなかった"],["。"]]},{"verse":2,"text":"彼女の父は言った。「私は、あなたがほんとうにあの娘をきらったものと思って、あれをあなたの客のひとりにやりました。あれの妹のほうが、あれよりもきれいではありませんか。どうぞ、あれの代わりに妹をあなたのものとしてください。」","tok":[["彼女","かのじょ"],["の"],["父","ちち"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["あなた"],["が"],["ほんとう"],["に"],["あの"],["娘","むすめ"],["を"],["きらった"],["もの"],["と"],["思って","おもって"],["、"],["あれ"],["を"],["あなた"],["の"],["客","きゃく"],["の"],["ひとり"],["に"],["やりました"],["。"],["あれ"],["の"],["妹","いもうと"],["の"],["ほう"],["が"],["、"],["あれ"],["より"],["も"],["きれい"],["で"],["は"],["ありません"],["か"],["。"],["どうぞ"],["、"],["あれ"],["の"],["代わり","かわり"],["に"],["妹","いもうと"],["を"],["あなた"],["の"],["もの"],["として"],["ください"],["。"],["」"]]},{"verse":3,"text":"すると、サムソンは彼らに言った。「今度、私がペリシテ人に害を加えても、私には何の罪もない。」","tok":[["する"],["と"],["、"],["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["今度","こんど"],["、"],["私","わたくし"],["が"],["ペリシテ"],["人","にん"],["に"],["害","がい"],["を"],["加えて","くわえて"],["も"],["、"],["私","わたくし"],["に"],["は"],["何","なん"],["の"],["罪","つみ"],["も"],["ない"],["。"],["」"]]},{"verse":4,"text":"それからサムソンは出て行って、ジャッカルを三百匹捕らえ、たいまつを取り、尾と尾をつなぎ合わせて、二つの尾の間にそれぞれ一つのたいまつを取りつけ、","tok":[["それ"],["から"],["サムソン"],["は"],["出て","でて"],["行って","いって"],["、"],["ジャッカル"],["を"],["三百匹","さんひゃくひき"],["捕らえ","とらえ"],["、"],["たいまつ"],["を"],["取り","とり"],["、"],["尾","お"],["と"],["尾","お"],["を"],["つなぎ合わせて","つなぎあわせて"],["、"],["二","ふた"],["つ"],["の"],["尾","お"],["の"],["間","あいだ"],["に"],["それぞれ"],["一","ひと"],["つ"],["の"],["たいまつ"],["を"],["取りつけ","とりつけ"],["、"]]},{"verse":5,"text":"そのたいまつに火をつけ、そのジャッカルをペリシテ人の麦畑の中に放して、たばねて積んである麦から、立穂、オリーブ畑に至るまでを燃やした。","tok":[["その"],["たいまつ"],["に"],["火","ひ"],["を"],["つけ"],["、"],["その"],["ジャッカル"],["を"],["ペリシテ"],["人","にん"],["の"],["麦畑","むぎばたけ"],["の"],["中","なか"],["に"],["放して","はなして"],["、"],["たばねて"],["積んで","つんで"],["ある"],["麦","むぎ"],["から"],["、"],["立穂","りつほ"],["、"],["オリーブ"],["畑","はたけ"],["に"],["至る","いたる"],["まで"],["を"],["燃やした","もやした"],["。"]]},{"verse":6,"text":"それで、ペリシテ人は言った。「だれがこういうことをしたのか。」また言った。「あのティムナ人の婿サムソンだ。あれが、彼の妻を取り上げて客のひとりにやったからだ。」それで、ペリシテ人は上って来て、彼女とその父を火で焼いた。","tok":[["それ"],["で"],["、"],["ペリシテ"],["人","にん"],["は"],["言った","いった"],["。"],["「"],["だれ"],["が"],["こう"],["いう"],["こと"],["を"],["した"],["の"],["か"],["。"],["」"],["また"],["言った","いった"],["。"],["「"],["あの"],["ティムナ"],["人","にん"],["の"],["婿","むこ"],["サムソン"],["だ"],["。"],["あれ"],["が"],["、"],["彼","かれ"],["の"],["妻","つま"],["を"],["取り上げて","とりあげて"],["客","きゃく"],["の"],["ひとり"],["に"],["やった"],["から"],["だ"],["。"],["」"],["それ"],["で"],["、"],["ペリシテ"],["人","にん"],["は"],["上って","のぼって"],["来て","きて"],["、"],["彼女","かのじょ"],["と"],["その"],["父","ちち"],["を"],["火","ひ"],["で"],["焼いた","やいた"],["。"]]},{"verse":7,"text":"すると、サムソンは彼らに言った。「あなたがたがこういうことをするなら、私は必ずあなたがたに復讐する。そのあとで、私は手を引こう。」","tok":[["する"],["と"],["、"],["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["が"],["こう"],["いう"],["こと"],["を"],["するなら"],["、"],["私","わたくし"],["は"],["必ず","かならず"],["あなた"],["がた"],["に"],["復讐","ふくしゅう"],["する"],["。"],["その"],["あと"],["で"],["、"],["私","わたくし"],["は"],["手","て"],["を"],["引こう","ひこう"],["。"],["」"]]},{"verse":8,"text":"そして、サムソンは彼らを取りひしいで、激しく打った。それから、サムソンは下って行って、エタムの岩の裂け目に住んだ。","tok":[["そして"],["、"],["サムソン"],["は"],["彼","かれ"],["ら"],["を"],["取りひしいで","とりひしいで"],["、"],["激しく","はげしく"],["打った","うった"],["。"],["それ"],["から"],["、"],["サムソン"],["は"],["下って","くだって"],["行って","いって"],["、"],["エタム"],["の"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":9,"text":"ペリシテ人が上って行って、ユダに対して陣を敷き、レヒを攻めたとき、","tok":[["ペリシテ"],["人","にん"],["が"],["上って","のぼって"],["行って","いって"],["、"],["ユダ"],["に対して","にたいして"],["陣","じん"],["を"],["敷き","しき"],["、"],["レヒ"],["を"],["攻めた","せめた"],["とき"],["、"]]},{"verse":10,"text":"ユダの人々は言った。「なぜ、あなたがたは、私たちを攻めに上って来たのか。」彼らは言った。「われわれはサムソンを縛って、彼がわれわれにしたように、彼にもしてやるために上って来たのだ。」","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["を"],["攻め","せめ"],["に"],["上って","のぼって"],["来た","きた"],["の"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["われわれ"],["は"],["サムソン"],["を"],["縛って","しばって"],["、"],["彼","かれ"],["が"],["われわれ"],["に"],["した"],["よう"],["に"],["、"],["彼","かれ"],["に"],["も"],["して"],["やる"],["ため"],["に"],["上って","のぼって"],["来た","きた"],["の"],["だ"],["。"],["」"]]},{"verse":11,"text":"そこで、ユダの人々三千人がエタムの岩の裂け目に下って行って、サムソンに言った。「あなたはペリシテ人が私たちの支配者であることを知らないのか。あなたはどうしてこんなことをしてくれたのか。」すると、サムソンは彼らに言った。「彼らが私にしたとおり、私は彼らにしたのだ。」","tok":[["そこ"],["で"],["、"],["ユダ"],["の"],["人々","ひとびと"],["三千人","さんせんにん"],["が"],["エタム"],["の"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["下って","くだって"],["行って","いって"],["、"],["サムソン"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["ペリシテ"],["人","にん"],["が"],["私たち","わたしたち"],["の"],["支配者","しはいしゃ"],["で"],["ある"],["こと"],["を"],["知らない","しらない"],["の"],["か"],["。"],["あなた"],["は"],["どう"],["して"],["こんな"],["こと"],["を"],["して"],["くれた"],["の"],["か"],["。"],["」"],["する"],["と"],["、"],["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["が"],["私","わたくし"],["に"],["した"],["とおり"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["に"],["した"],["の"],["だ"],["。"],["」"]]},{"verse":12,"text":"彼らはサムソンに言った。「私たちはあなたを縛って、ペリシテ人の手に渡すために下って来たのだ。」サムソンは彼らに言った。「あなたがたは私に撃ちかからないと誓いなさい。」","tok":[["彼","かれ"],["ら"],["は"],["サムソン"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["あなた"],["を"],["縛って","しばって"],["、"],["ペリシテ"],["人","にん"],["の"],["手","て"],["に"],["渡す","わたす"],["ため"],["に"],["下って","くだって"],["来た","きた"],["の"],["だ"],["。"],["」"],["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["私","わたくし"],["に"],["撃ち","うち"],["かからない"],["と"],["誓い","ちかい"],["なさい"],["。"],["」"]]},{"verse":13,"text":"すると、彼らはサムソンに言った。「決してしない。ただあなたをしっかり縛って、彼らの手に渡すだけだ。私たちは決してあなたを殺さない。」こうして、彼らは二本の新しい綱で彼を縛り、その岩から彼を引き上げた。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["サムソン"],["に"],["言った","いった"],["。"],["「"],["決して","けっして"],["しない"],["。"],["ただ"],["あなた"],["を"],["しっかり"],["縛って","しばって"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡す","わたす"],["だけ"],["だ"],["。"],["私たち","わたしたち"],["は"],["決して","けっして"],["あなた"],["を"],["殺さない","ころさない"],["。"],["」"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["二本","にぽん"],["の"],["新しい","あたらしい"],["綱","つな"],["で"],["彼","かれ"],["を"],["縛り","しばり"],["、"],["その"],["岩","いわ"],["から"],["彼","かれ"],["を"],["引き上げた","ひきあげた"],["。"]]},{"verse":14,"text":"サムソンがレヒに来たとき、ペリシテ人は大声をあげて彼に近づいた。すると、主の霊が激しく彼の上に下り、彼の腕にかかっていた綱は火のついた亜麻糸のようになって、そのなわめが手から解け落ちた。","tok":[["サムソン"],["が"],["レヒ"],["に"],["来た","きた"],["とき"],["、"],["ペリシテ"],["人","にん"],["は"],["大声","おおごえ"],["を"],["あげて"],["彼","かれ"],["に"],["近づいた","ちかづいた"],["。"],["する"],["と"],["、"],["主","ぬし"],["の"],["霊","れい"],["が"],["激しく","はげしく"],["彼","かれ"],["の"],["上","うえ"],["に"],["下り","くだり"],["、"],["彼","かれ"],["の"],["腕","うで"],["に"],["かかって"],["いた"],["綱","つな"],["は"],["火","ひ"],["の"],["ついた"],["亜麻","あま"],["糸","いと"],["の"],["よう"],["に"],["なって"],["、"],["その"],["なわ"],["め"],["が"],["手","て"],["から"],["解け落ちた","ほどけおちた"],["。"]]},{"verse":15,"text":"サムソンは、生新しいろばのあご骨を見つけ、手を差し伸べて、それを取り、それで千人を打ち殺した。","tok":[["サムソン"],["は"],["、"],["生新しい","なまあたらしい"],["ろば"],["の"],["あご骨","あごぼね"],["を"],["見つけ","みつけ"],["、"],["手","て"],["を"],["差し伸べて","さしのべて"],["、"],["それ"],["を"],["取り","とり"],["、"],["それ"],["で"],["千人","せんにん"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":16,"text":"そして、サムソンは言った。「ろばのあご骨で、山と積み上げた。ろばのあご骨で、千人を打ち殺した。」","tok":[["そして"],["、"],["サムソン"],["は"],["言った","いった"],["。"],["「"],["ろば"],["の"],["あご骨","あごぼね"],["で"],["、"],["山","やま"],["と"],["積み上げた","つみあげた"],["。"],["ろば"],["の"],["あご骨","あごぼね"],["で"],["、"],["千人","せんにん"],["を"],["打ち殺した","うちころした"],["。"],["」"]]},{"verse":17,"text":"こう言い終わったとき、彼はそのあご骨を投げ捨てた。彼はその場所を、ラマテ・レヒと名づけた。","tok":[["こう"],["言い","いい"],["終わった","おわった"],["とき"],["、"],["彼","かれ"],["は"],["その"],["あご骨","あごぼね"],["を"],["投げ捨てた","なげすてた"],["。"],["彼","かれ"],["は"],["その"],["場所","ばしょ"],["を"],["、"],["ラマテ"],["・"],["レヒ"],["と"],["名づけた","なづけた"],["。"]]},{"verse":18,"text":"そのとき、彼はひどく渇きを覚え、主に呼び求めて言った。「あなたは、しもべの手で、この大きな救いを与えられました。しかし、今、私はのどが渇いて死にそうで、無割礼の者どもの手に落ちようとしています。」","tok":[["その"],["とき"],["、"],["彼","かれ"],["は"],["ひどく"],["渇き","かわき"],["を"],["覚え","おぼえ"],["、"],["主に","おもに"],["呼び求めて","よびもとめて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["しもべ"],["の"],["手","て"],["で"],["、"],["この"],["大きな","おおきな"],["救い","すくい"],["を"],["与えられました","あたえられました"],["。"],["しかし"],["、"],["今","いま"],["、"],["私","わたくし"],["は"],["のど"],["が"],["渇いて","かわいて"],["死に","しに"],["そう"],["で"],["、"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["ども"],["の"],["手","て"],["に"],["落ちよう","おちよう"],["として"],["います"],["。"],["」"]]},{"verse":19,"text":"すると、神はレヒにあるくぼんだ所を裂かれ、そこから水が出た。サムソンは水を飲んで元気を回復して生き返った。それゆえその名は、エン・ハコレと呼ばれた。それは今日もレヒにある。","tok":[["する"],["と"],["、"],["神","かみ"],["は"],["レヒ"],["に"],["ある"],["くぼんだ"],["所","ところ"],["を"],["裂かれ","さかれ"],["、"],["そこ"],["から"],["水","みず"],["が"],["出た","でた"],["。"],["サムソン"],["は"],["水","みず"],["を"],["飲んで","のんで"],["元気","げんき"],["を"],["回復","かいふく"],["して"],["生き返った","いきかえった"],["。"],["それ"],["ゆえ"],["その"],["名","な"],["は"],["、"],["エン"],["・"],["ハコレ"],["と"],["呼ばれた","よばれた"],["。"],["それ"],["は"],["今日","きょう"],["も"],["レヒ"],["に"],["ある"],["。"]]},{"verse":20,"text":"こうして、サムソンはペリシテ人の時代に二十年間、イスラエルをさばいた。","tok":[["こう"],["して"],["、"],["サムソン"],["は"],["ペリシテ"],["人","にん"],["の"],["時代","じだい"],["に"],["二十","にじゅう"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["さばいた"],["。"]]}]
[{"verse":1,"text":"さて、ギルアデ人エフタは勇士であったが、彼は遊女の子であった。エフタの父親はギルアデであった。","tok":[["さて"],["、"],["ギルアデ"],["人","にん"],["エフタ"],["は"],["勇士","ゆうし"],["で"],["あった"],["が"],["、"],["彼","かれ"],["は"],["遊女","ゆうじょ"],["の"],["子","こ"],["で"],["あった"],["。"],["エフタ"],["の"],["父親","ちちおや"],["は"],["ギルアデ"],["で"],["あった"],["。"]]},{"verse":2,"text":"ギルアデの妻も、男の子たちを産んだ。この妻の子たちが成長したとき、彼らはエフタを追い出して、彼に言った。「あなたはほかの女の子だから、私たちの父の家を受け継いではいけない。」","tok":[["ギルアデ"],["の"],["妻","つま"],["も"],["、"],["男の子","おとこのこ"],["たち"],["を"],["産んだ","うんだ"],["。"],["この"],["妻","つま"],["の"],["子","こ"],["たち"],["が"],["成長","せいちょう"],["した"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["エフタ"],["を"],["追い出して","おいだして"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["ほか"],["の"],["女の子","おんなのこ"],["だ"],["から"],["、"],["私たち","わたしたち"],["の"],["父","ちち"],["の"],["家","いえ"],["を"],["受け継いで","うけついで"],["は"],["いけない"],["。"],["」"]]},{"verse":3,"text":"そこで、エフタは兄弟たちのところから逃げて行き、トブの地に住んだ。すると、エフタのところに、ごろつきが集まって来て、彼といっしょに出歩いた。","tok":[["そこ"],["で"],["、"],["エフタ"],["は"],["兄弟","きょうだい"],["たち"],["の"],["ところ"],["から"],["逃げて","にげて"],["行き","いき"],["、"],["トブ"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["。"],["する"],["と"],["、"],["エフタ"],["の"],["ところ"],["に"],["、"],["ごろつき"],["が"],["集まって","あつまって"],["来て","きて"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["出歩いた","であるいた"],["。"]]},{"verse":4,"text":"それからしばらくたって、アモン人がイスラエルに戦争をしかけてきた。","tok":[["それ"],["から"],["しばらく"],["たって"],["、"],["アモン人","あもんにん"],["が"],["イスラエル"],["に"],["戦争","せんそう"],["を"],["しかけて"],["きた"],["。"]]},{"verse":5,"text":"アモン人がイスラエルに戦争をしかけてきたとき、ギルアデの長老たちはトブの地からエフタを連れて来ようと出かけて行き、","tok":[["アモン人","あもんにん"],["が"],["イスラエル"],["に"],["戦争","せんそう"],["を"],["しかけて"],["きた"],["とき"],["、"],["ギルアデ"],["の"],["長老","ちょうろう"],["たち"],["は"],["トブ"],["の"],["地","ち"],["から"],["エフタ"],["を"],["連れて","つれて"],["来よう","こよう"],["と"],["出かけて","でかけて"],["行き","いき"],["、"]]},{"verse":6,"text":"エフタに言った。「来て、私たちの首領になってください。そしてアモン人と戦いましょう。」","tok":[["エフタ"],["に"],["言った","いった"],["。"],["「"],["来て","きて"],["、"],["私たち","わたしたち"],["の"],["首領","しゅりょう"],["に"],["なって"],["ください"],["。"],["そして"],["アモン人","あもんにん"],["と"],[
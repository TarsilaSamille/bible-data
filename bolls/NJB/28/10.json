[{"verse":1,"text":"イスラエルは／多くの実を結ぶよく茂ったぶどうの木であった。／多く実を結ぶにしたがって、それだけ祭壇をふやし、その地が豊かになるにしたがって、それだけ多くの美しい石の柱を立てた。","tok":[["イスラエル"],["は"],["／"],["多く","おおく"],["の"],["実","じつ"],["を"],["結ぶ","むすぶ"],["よく"],["茂った","しげった"],["ぶどう"],["の"],["木","き"],["で"],["あった"],["。"],["／"],["多く","おおく"],["実","じつ"],["を"],["結ぶ","むすぶ"],["に"],["したがって"],["、"],["それ"],["だけ"],["祭壇","さいだん"],["を"],["ふやし"],["、"],["その"],["地","ち"],["が"],["豊か","ゆたか"],["に"],["なる"],["に"],["したがって"],["、"],["それ"],["だけ"],["多く","おおく"],["の"],["美しい","うつくしい"],["石","いし"],["の"],["柱","はしら"],["を"],["立てた","たてた"],["。"]]},{"verse":2,"text":"彼らの心は二心だ。／今、彼らはその刑罰を受けなければならない。／主は彼らの祭壇をこわし、彼らの石の柱を砕かれる。","tok":[["彼","かれ"],["ら"],["の"],["心","こころ"],["は"],["二心","にしん"],["だ"],["。"],["／"],["今","いま"],["、"],["彼","かれ"],["ら"],["は"],["その"],["刑罰","けいばつ"],["を"],["受けなければ","うけなければ"],["ならない"],["。"],["／"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["を"],["こわし"],["、"],["彼","かれ"],["ら"],["の"],["石","いし"],["の"],["柱","はしら"],["を"],["砕かれる","くだかれる"],["。"]]},{"verse":3,"text":"今、彼らは言う。／「私たちには王がない。／私たちが主を恐れなかったからだ。／だが、王は私たちに何ができよう」と。","tok":[["今","いま"],["、"],["彼","かれ"],["ら"],["は"],["言う","ゆう"],["。"],["／"],["「"],["私たち","わたしたち"],["に"],["は"],["王","おう"],["が"],["ない"],["。"],["／"],["私たち","わたしたち"],["が"],["主","ぬし"],["を"],["恐れなかった","おそれなかった"],["から"],["だ"],["。"],["／"],["だ"],["が"],["、"],["王","おう"],["は"],["私たち","わたしたち"],["に"],["何","なん"],["が"],["できよう"],["」"],["と"],["。"]]},{"verse":4,"text":"彼らはむだ口をきき、むなしい誓いを立てて契約を結ぶ。／だから、さばきは／畑のうねの毒草のように生いでる。","tok":[["彼","かれ"],["ら"],["は"],["むだ口","むだぐち"],["を"],["きき"],["、"],["むなしい"],["誓い","ちかい"],["を"],["立てて","たてて"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"],["／"],["だ"],["から"],["、"],["さばき"],["は"],["／"],["畑","はたけ"],["の"],["うね"],["の"],["毒草","どくそう"],["の"],["よう"],["に"],["生いでる","いいでる"],["。"]]},{"verse":5,"text":"サマリヤの住民は、ベテ・アベンの子牛のためにおののく。／その民はこのために喪に服し、偶像に仕える祭司たちもこのために喪に服する。／彼らは、その栄光のために悲しもう。／栄光が子牛から去ったからだ。","tok":[["サマリヤ"],["の"],["住民","じゅうみん"],["は"],["、"],["ベテ"],["・"],["アベン"],["の"],["子牛","こうし"],["の"],["ため"],["に"],["おののく"],["。"],["／"],["その"],["民","みん"],["は"],["この"],["ため"],["に"],["喪","も"],["に"],["服し","ふくし"],["、"],["偶像","ぐうぞう"],["に"],["仕える","つかえる"],["祭司","さいし"],["たち"],["も"],["この"],["ため"],["に"],["喪","も"],["に"],["服する","ふくする"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["その"],["栄光","えいこう"],["の"],["ため"],["に"],["悲しもう","かなしもう"],["。"],["／"],["栄光","えいこう"],["が"],["子牛","こうし"],["から"],["去った","さった"],["から"],["だ"],["。"]]},{"verse":6,"text":"その子牛はアッシリヤに持ち去られ、大王への贈り物となる。／エフライムは恥を受け取り、イスラエルは自分のはかりごとで恥を見る。","tok":[["その"],["子牛","こうし"],["は"],["アッシリヤ"],["に"],["持ち去られ","もちさられ"],["、"],["大王","だいおう"],["へ"],["の"],["贈り物","おくりもの"],["と"],["なる"],["。"],["／"],["エフライム"],["は"],["恥","はじ"],["を"],["受け取り","うけとり"],["、"],["イスラエル"],["は"],["自分","じぶん"],["の"],["はかりごと"],["で"],["恥","はじ"],["を"],["見る","みる"],["。"]]},{"verse":7,"text":"サマリヤは滅びうせ、その王は水の面の木切れのようだ。","tok":[["サマリヤ"],["は"],["滅び","ほろび"],["うせ"],["、"],["その"],["王","おう"],["は"],["水","みず"],["の"],["面","めん"],["の"],["木切れ","きぎれ"],["の"],["よう"],["だ"],["。"]]},{"verse":8,"text":"イスラエルの罪である／アベンの高き所も滅ぼされ、いばらとあざみが、彼らの祭壇の上におい茂る。／彼らは山々に向かって、「私たちをおおえ」と言い、丘に向かって、「私たちの上に落ちかかれ」と言おう。","tok":[["イスラエル"],["の"],["罪","つみ"],["で"],["ある"],["／"],["アベン"],["の"],["高き","たかき"],["所","ところ"],["も"],["滅ぼされ","ほろぼされ"],["、"],["いばら"],["と"],["あざみ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["おい茂る","おいしげる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["山々","やまやま"],["に"],["向かって","むかって"],["、"],["「"],["私たち","わたしたち"],["を"],["おおえ"],["」"],["と"],["言い","いい"],["、"],["丘","おか"],["に"],["向かって","むかって"],["、"],["「"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["落ちかかれ","おちかかれ"],["」"],["と"],["言おう","いおう"],["。"]]},{"verse":9,"text":"イスラエルよ。ギブアの日々よりこのかた、あなたは罪を犯してきた。／彼らはそこで同じことを行っている。／戦いはギブアで、この不法な民を襲わないだろうか。","tok":[["イスラエル"],["よ"],["。"],["ギブア"],["の"],["日々","ひび"],["より"],["このかた"],["、"],["あなた"],["は"],["罪","つみ"],["を"],["犯して","おかして"],["きた"],["。"],["／"],["彼","かれ"],["ら"],["は"],["そこ"],["で"],["同じ","おなじ"],["こと"],["を"],["行って","おこなって"],["いる"],["。"],["／"],["戦い","たたかい"],["は"],["ギブア"],["で"],["、"],["この"],["不法","ふほう"],["な"],["民","たみ"],["を"],["襲わないだろう","おそわないだろう"],["か"],["。"]]},{"verse":10,"text":"わたしは彼らを懲らしめようと思う。／彼らが二つの不義のために捕らえられるとき、国々の民は集められて彼らを攻める。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["懲らしめよう","こらしめよう"],["と"],["思う","おもう"],["。"],["／"],["彼","かれ"],["ら"],["が"],["二","ふた"],["つ"],["の"],["不義","ふぎ"],["の"],["ため"],["に"],["捕らえられる","とらえられる"],["とき"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["集められて","あつめられて"],["彼","かれ"],["ら"],["を"],["攻める","せめる"],["。"]]},{"verse":11,"text":"エフライムは飼いならされた雌の子牛であって、麦打ち場で踏むことを好んでいた。／わたしはその美しい首にくびきを掛けた。／わたしはエフライムに乗り、ユダは耕し、ヤコブはまぐわをひく。","tok":[["エフライム"],["は"],["飼いならされた","かいならされた"],["雌","めす"],["の"],["子牛","こうし"],["で"],["あって"],["、"],["麦打ち","むぎうち"],["場","ば"],["で"],["踏む","ふむ"],["こと"],["を"],["好んで","このんで"],["いた"],["。"],["／"],["わたし"],["は"],["その"],["美しい","うつくしい"],["首","くび"],["に"],["くびき"],["を"],["掛けた","かけた"],["。"],["／"],["わたし"],["は"],["エフライム"],["に"],["乗り","のり"],["、"],["ユダ"],["は"],["耕し","たがやし"],["、"],["ヤコブ"],["は"],["まぐわ"],["を"],["ひく"],["。"]]},{"verse":12,"text":"あなたがたは正義の種を蒔き、誠実の実を刈り入れよ。／あなたがたは耕地を開拓せよ。／今が、主を求める時だ。／ついに、主は来て、正義をあなたがたに注がれる。","tok":[["あなた"],["がた"],["は"],["正義","せいぎ"],["の"],["種","たね"],["を"],["蒔き","まき"],["、"],["誠実","せいじつ"],["の"],["実","じつ"],["を"],["刈り入れよ","かりいれよ"],["。"],["／"],["あなた"],["がた"],["は"],["耕地","こうち"],["を"],["開拓","かいたく"],["せよ"],["。"],["／"],["今","いま"],["が"],["、"],["主","ぬし"],["を"],["求める","もとめる"],["時","とき"],["だ"],["。"],["／"],["ついに"],["、"],["主","ぬし"],["は"],["来て","きて"],["、"],["正義","せいぎ"],["を"],["あなた"],["がた"],["に"],["注がれる","そそがれる"],["。"]]},{"verse":13,"text":"あなたがたは悪を耕し、不正を刈り取り、偽りの実を食べていた。／これはあなたが、自分の行いや、多くの勇士に拠り頼んだからだ。","tok":[["あなた"],["がた"],["は"],["悪","あく"],["を"],["耕し","たがやし"],["、"],["不正","ふせい"],["を"],["刈り取り","かりとり"],["、"],["偽り","いつわり"],["の"],["実","じつ"],["を"],["食べて","たべて"],["いた"],["。"],["／"],["これ"],["は"],["あなた"],["が"],["、"],["自分","じぶん"],["の"],["行い","おこない"],["や"],["、"],["多く","おおく"],["の"],["勇士","ゆうし"],["に"],["拠り","より"],["頼んだ","たのんだ"],["から"],["だ"],["。"]]},{"verse":14,"text":"あなたの民の中では騒動が起こり、あなたの要塞はみな打ち滅ぼされる。／シャレマンが／ベテ・アレベルを踏みにじったように。／その戦いの日には、母親が、その子どもたちの上で／八つ裂きにされた。","tok":[["あなた"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["は"],["騒動","そうどう"],["が"],["起こり","おこり"],["、"],["あなた"],["の"],["要塞","ようさい"],["は"],["みな"],["打ち滅ぼされる","うちほろぼされる"],["。"],["／"],["シャレマン"],["が"],["／"],["ベテ"],["・"],["アレベル"],["を"],["踏みにじった","ふみにじった"],["よう"],["に"],["。"],["／"],["その"],["戦い","たたかい"],["の"],["日","ひ"],["に"],["は"],["、"],["母親","ははおや"],["が"],["、"],["その"],["子ども","こども"],["たち"],["の"],["上","うえ"],["で"],["／"],["八つ裂き","やつざき"],["に"],["された"],["。"]]},{"verse":15,"text":"イスラエルの家よ。／あなたがたの悪があまりにもひどいので、わたしはこのようにあなたがたにも行う。／イスラエルの王は夜明けに全く滅ぼされる。","tok":[["イスラエル"],["の"],["家","いえ"],["よ"],["。"],["／"],["あなた"],["がた"],["の"],["悪","あく"],["が"],["あまり"],["に"],["も"],["ひどい"],["ので"],["、"],["わたし"],["は"],["この"],["よう"],["に"],["あなた"],["がた"],["に"],["も"],["行う","おこなう"],["。"],["／"],["イスラエル"],["の"],["王","おう"],["は"],["夜明け","よあけ"],["に"],["全く","まったく"],["滅ぼされる","ほろぼされる"],["。"]]}]
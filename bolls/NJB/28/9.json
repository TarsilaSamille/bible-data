[{"verse":1,"text":"イスラエルよ。／国々の民のように喜び楽しむな。／あなたは自分の神にそむいて姦淫をし、すべての麦打ち場で受ける姦淫の報酬を／愛したからだ。","tok":[["イスラエル"],["よ"],["。"],["／"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["よう"],["に"],["喜び楽しむ","よろこびたのしむ"],["な"],["。"],["／"],["あなた"],["は"],["自分","じぶん"],["の"],["神","かみ"],["に"],["そむいて"],["姦淫","かんいん"],["を"],["し"],["、"],["すべて"],["の"],["麦打ち","むぎうち"],["場","ば"],["で"],["受ける","うける"],["姦淫","かんいん"],["の"],["報酬","ほうしゅう"],["を"],["／"],["愛した","あいした"],["から"],["だ"],["。"]]},{"verse":2,"text":"麦打ち場も酒ぶねも彼らを養わない。／新しいぶどう酒も欺く。","tok":[["麦打ち","むぎうち"],["場","ば"],["も"],["酒","さか"],["ぶね"],["も"],["彼","かれ"],["ら"],["を"],["養わない","やしなわない"],["。"],["／"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["も"],["欺く","あざむく"],["。"]]},{"verse":3,"text":"彼らは主の地にとどまらず、エフライムはエジプトに帰り、アッシリヤで汚れた物を食べよう。","tok":[["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["地","ち"],["に"],["とどまらず"],["、"],["エフライム"],["は"],["エジプト"],["に"],["帰り","かえり"],["、"],["アッシリヤ"],["で"],["汚れた","よごれた"],["物","もの"],["を"],["食べよう","たべよう"],["。"]]},{"verse":4,"text":"彼らは主にぶどう酒を注がず、彼らのいけにえで主を喜ばせない。／彼らのパンは喪中のパンのようで、すべてこれを食べる者は汚れた者になる。／彼らのパンは彼ら自身のためだけであって、主の宮に持ち込むことはできない。","tok":[["彼","かれ"],["ら"],["は"],["主に","おもに"],["ぶどう酒","ぶどうしゅ"],["を"],["注がず","そそがず"],["、"],["彼","かれ"],["ら"],["の"],["いけにえ"],["で"],["主","ぬし"],["を"],["喜ばせない","よろこばせない"],["。"],["／"],["彼","かれ"],["ら"],["の"],["パン"],["は"],["喪中","もちゅう"],["の"],["パン"],["の"],["よう"],["で"],["、"],["すべて"],["これ"],["を"],["食べる","たべる"],["者","もの"],["は"],["汚れた","よごれた"],["者","もの"],["に"],["なる"],["。"],["／"],["彼","かれ"],["ら"],["の"],["パン"],["は"],["彼","かれ"],["ら"],["自身","じしん"],["の"],["ため"],["だけ"],["で"],["あって"],["、"],["主","ぬし"],["の"],["宮","みや"],["に"],["持ち込む","もちこむ"],["こと"],["は"],["できない"],["。"]]},{"verse":5,"text":"あなたがたは例祭の日、主の祭りの日には何をしようとするのか。","tok":[["あなた"],["がた"],["は"],["例祭","れいさい"],["の"],["日","ひ"],["、"],["主","ぬし"],["の"],["祭り","まつり"],["の"],["日","ひ"],["に"],["は"],["何","なん"],["を"],["しよう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":6,"text":"見よ。彼らが破壊をのがれても、エジプトは彼らを集め、モフが彼らを葬る。／彼らの宝としている銀は、いらくさが勝ち取り、あざみが彼らの天幕に生える。","tok":[["見","み"],["よ"],["。"],["彼","かれ"],["ら"],["が"],["破壊","はかい"],["を"],["のがれて"],["も"],["、"],["エジプト"],["は"],["彼","かれ"],["ら"],["を"],["集め","あつめ"],["、"],["モフ"],["が"],["彼","かれ"],["ら"],["を"],["葬る","ほうむる"],["。"],["／"],["彼","かれ"],["ら"],["の"],["宝","たから"],["として"],["いる"],["銀","ぎん"],["は"],["、"],["いらくさ"],["が"],["勝ち取り","かちとり"],["、"],["あざみ"],["が"],["彼","かれ"],["ら"],["の"],["天幕","てんまく"],["に"],["生える","はえる"],["。"]]},{"verse":7,"text":"刑罰の日が来た。報復の日が来た。／イスラエルは知るがよい。／預言者は愚か者、霊の人は狂った者だ。／これはあなたのひどい不義のため、ひどい憎しみのためである。","tok":[["刑罰","けいばつ"],["の"],["日","ひ"],["が"],["来た","きた"],["。"],["報復","ほうふく"],["の"],["日","ひ"],["が"],["来た","きた"],["。"],["／"],["イスラエル"],["は"],["知る","しる"],["が"],["よい"],["。"],["／"],["預言者","よげんしゃ"],["は"],["愚か者","おろかもの"],["、"],["霊","れい"],["の"],["人","ひと"],["は"],["狂った","くるった"],["者","もの"],["だ"],["。"],["／"],["これ"],["は"],["あなた"],["の"],["ひどい"],["不義","ふぎ"],["の"],["ため"],["、"],["ひどい"],["憎しみ","にくしみ"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"エフライムの見張り人は、私の神とともにある。／しかし、預言者は、すべての道にしかけるわなだ。／彼の神の家には憎しみがある。","tok":[["エフライム"],["の"],["見張り","みはり"],["人","ひと"],["は"],["、"],["私","わたくし"],["の"],["神","かみ"],["と"],["とも"],["に"],["ある"],["。"],["／"],["しかし"],["、"],["預言者","よげんしゃ"],["は"],["、"],["すべて"],["の"],["道","みち"],["に"],["しかける"],["わな"],["だ"],["。"],["／"],["彼","かれ"],["の"],["神","かみ"],["の"],["家","いえ"],["に"],["は"],["憎しみ","にくしみ"],["が"],["ある"],["。"]]},{"verse":9,"text":"彼らはギブアの日のように、真底まで堕落した。／主は彼らの不義を覚え、その罪を罰する。","tok":[["彼","かれ"],["ら"],["は"],["ギブア"],["の"],["日","ひ"],["の"],["よう"],["に"],["、"],["真底","しんそこ"],["まで"],["堕落","だらく"],["した"],["。"],["／"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["不義","ふぎ"],["を"],["覚え","おぼえ"],["、"],["その"],["罪","つみ"],["を"],["罰する","ばっする"],["。"]]},{"verse":10,"text":"わたしはイスラエルを、荒野のぶどうのように見、あなたがたの先祖を、いちじくの木の初なりの実のように見ていた。／ところが彼らはバアル・ペオルへ行き、恥ずべきものに身をゆだね、彼らの愛している者と同じように、彼ら自身、忌むべきものとなった。","tok":[["わたし"],["は"],["イスラエル"],["を"],["、"],["荒野","こうや"],["の"],["ぶどう"],["の"],["よう"],["に"],["見","み"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["、"],["いちじく"],["の"],["木","き"],["の"],["初なり","はつなり"],["の"],["実","じつ"],["の"],["よう"],["に"],["見て","みて"],["いた"],["。"],["／"],["ところ"],["が"],["彼","かれ"],["ら"],["は"],["バアル"],["・"],["ペオル"],["へ"],["行き","いき"],["、"],["恥ずべき","はずべき"],["もの"],["に"],["身","み"],["を"],["ゆだね"],["、"],["彼","かれ"],["ら"],["の"],["愛して","あいして"],["いる"],["者","もの"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["、"],["忌むべき","いむべき"],["もの"],["と"],["なった"],["。"]]},{"verse":11,"text":"エフライムの栄光は鳥のように飛び去り、もう産むことも、みごもることも、はらむこともない。","tok":[["エフライム"],["の"],["栄光","えいこう"],["は"],["鳥","とり"],["の"],["よう"],["に"],["飛び去り","とびさり"],["、"],["もう"],["産む","うむ"],["こと"],["も"],["、"],["みごもる"],["こと"],["も"],["、"],["はらむ"],["こと"],["も"],["ない"],["。"]]},{"verse":12,"text":"たとい彼らが子を育てても、わたしはひとり残らずその子を失わせる。／わたしが彼らを離れるとき、まことに、彼らにわざわいが来る。","tok":[["たとい"],["彼","かれ"],["ら"],["が"],["子","こ"],["を"],["育てて","そだてて"],["も"],["、"],["わたし"],["は"],["ひとり"],["残らず","のこらず"],["その"],["子","こ"],["を"],["失わせる","うしなわせる"],["。"],["／"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["離れる","はなれる"],["とき"],["、"],["まこと"],["に"],["、"],["彼","かれ"],["ら"],["に"],["わざわい"],["が"],["来る","くる"],["。"]]},{"verse":13,"text":"わたしが見たエフライムは、牧場に植えられたツロのようであったが、今や、エフライムはその子らを、ほふり場に連れて行かなければならない。","tok":[["わたし"],["が"],["見た","みた"],["エフライム"],["は"],["、"],["牧場","ぼくじょう"],["に"],["植えられた","うえられた"],["ツロ"],["の"],["よう"],["で"],["あった"],["が"],["、"],["今","いま"],["や"],["、"],["エフライム"],["は"],["その"],["子","こ"],["ら"],["を"],["、"],["ほふり場","ほふりじょう"],["に"],["連れて","つれて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":14,"text":"主よ。彼らに与えてください。／何をお与えになりますか。／はらまない胎と、乳の出ない乳房とを／彼らに与えてください。","tok":[["主","ぬし"],["よ"],["。"],["彼","かれ"],["ら"],["に"],["与えて","あたえて"],["ください"],["。"],["／"],["何","なん"],["を"],["お与え","おあたえ"],["に"],["なります"],["か"],["。"],["／"],["はらまない"],["胎","はら"],["と"],["、"],["乳","ちち"],["の"],["出ない","でない"],["乳房","ちぶさ"],["と"],["を"],["／"],["彼","かれ"],["ら"],["に"],["与えて","あたえて"],["ください"],["。"]]},{"verse":15,"text":"彼らのすべての悪はギルガルにある。／わたしはその所で彼らを憎んだ。／彼らの悪い行いのために、彼らをわたしの宮から追い出し、重ねて彼らを愛さない。／その首長たちはみな頑迷な者だ。","tok":[["彼","かれ"],["ら"],["の"],["すべて"],["の"],["悪","あく"],["は"],["ギルガル"],["に"],["ある"],["。"],["／"],["わたし"],["は"],["その"],["所","ところ"],["で"],["彼","かれ"],["ら"],["を"],["憎んだ","にくんだ"],["。"],["／"],["彼","かれ"],["ら"],["の"],["悪い","わるい"],["行い","おこない"],["の"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["宮","みや"],["から"],["追い出し","おいだし"],["、"],["重ねて","かさねて"],["彼","かれ"],["ら"],["を"],["愛さない","あいさない"],["。"],["／"],["その"],["首長","しゅちょう"],["たち"],["は"],["みな"],["頑迷","がんめい"],["な"],["者","もの"],["だ"],["。"]]},{"verse":16,"text":"エフライムは打たれ、その根は枯れて、実を結ばない。／たとい彼らが子を産んでも、わたしはその胎の中のいとし子を殺す。","tok":[["エフライム"],["は"],["打たれ","うたれ"],["、"],["その"],["根","ね"],["は"],["枯れて","かれて"],["、"],["実","じつ"],["を"],["結ばない","むすばない"],["。"],["／"],["たとい"],["彼","かれ"],["ら"],["が"],["子","こ"],["を"],["産んで","うんで"],["も"],["、"],["わたし"],["は"],["その"],["胎","はら"],["の"],["中","なか"],["の"],["いとし子","いとしご"],["を"],["殺す","ころす"],["。"]]},{"verse":17,"text":"私の神は彼らを退ける。／それは、彼らが神に聞き従わなかったからだ。／彼らは諸国の民のうちに、さすらい人となる。","tok":[["私","わたくし"],["の"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["退ける","しりぞける"],["。"],["／"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["神","かみ"],["に"],["聞き従わなかった","ききしたがわなかった"],["から"],["だ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["うち"],["に"],["、"],["さすらい人","さすらいびと"],["と"],["なる"],["。"]]}]
[{"verse":1,"text":"イスラエル人よ。／主のことばを聞け。／主はこの地に住む者と言い争われる。／この地には真実がなく、誠実がなく、神を知ることもないからだ。","tok":[["イスラエル"],["人","にん"],["よ"],["。"],["／"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["／"],["主","ぬし"],["は"],["この"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["と"],["言い争われる","いいあらそわれる"],["。"],["／"],["この"],["地","ち"],["に"],["は"],["真実","しんじつ"],["が"],["なく"],["、"],["誠実","せいじつ"],["が"],["なく"],["、"],["神","かみ"],["を"],["知る","しる"],["こと"],["も"],["ない"],["から"],["だ"],["。"]]},{"verse":2,"text":"ただ、のろいと、欺きと、人殺しと、盗みと、姦通がはびこり、流血に流血が続いている。","tok":[["ただ"],["、"],["のろい"],["と"],["、"],["欺き","あざむき"],["と"],["、"],["人殺し","ひとごろし"],["と"],["、"],["盗み","ぬすみ"],["と"],["、"],["姦通","かんつう"],["が"],["はびこり"],["、"],["流血","りゅうけつ"],["に"],["流血","りゅうけつ"],["が"],["続いて","つづいて"],["いる"],["。"]]},{"verse":3,"text":"それゆえ、この地は喪に服し、ここに住む者はみな、野の獣、空の鳥とともに／打ちしおれ、海の魚さえも絶え果てる。","tok":[["それ"],["ゆえ"],["、"],["この"],["地","ち"],["は"],["喪","も"],["に"],["服し","ふくし"],["、"],["ここ"],["に"],["住む","すむ"],["者","もの"],["は"],["みな"],["、"],["野","の"],["の"],["獣","けもの"],["、"],["空","そら"],["の"],["鳥","とり"],["と"],["とも"],["に"],["／"],["打ちしおれ","うちしおれ"],["、"],["海","うみ"],["の"],["魚","さかな"],["さえ"],["も"],["絶え","たえ"],["果てる","はてる"],["。"]]},{"verse":4,"text":"だれもとがめてはならない。／だれも責めてはならない。／しかし祭司よ。わたしはあなたをなじる。","tok":[["だれ"],["も"],["とがめて"],["は"],["ならない"],["。"],["／"],["だれ"],["も"],["責めて","せめて"],["は"],["ならない"],["。"],["／"],["しかし"],["祭司","さいし"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["なじる"],["。"]]},{"verse":5,"text":"あなたは昼つまずき、預言者もまた、あなたとともに夜つまずく。／わたしはあなたの母を滅ぼす。","tok":[["あなた"],["は"],["昼","ひる"],["つまずき"],["、"],["預言者","よげんしゃ"],["も"],["また"],["、"],["あなた"],["と"],["とも"],["に"],["夜","よる"],["つまずく"],["。"],["／"],["わたし"],["は"],["あなた"],["の"],["母","はは"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":6,"text":"わたしの民は知識がないので滅ぼされる。／あなたが知識を退けたので、わたしはあなたを退けて、わたしの祭司としない。／あなたは神のおしえを忘れたので、わたしもまた、あなたの子らを忘れよう。","tok":[["わたし"],["の"],["民","たみ"],["は"],["知識","ちしき"],["が"],["ない"],["ので"],["滅ぼされる","ほろぼされる"],["。"],["／"],["あなた"],["が"],["知識","ちしき"],["を"],["退けた","しりぞけた"],["ので"],["、"],["わたし"],["は"],["あなた"],["を"],["退けて","しりぞけて"],["、"],["わたし"],["の"],["祭司","さいし"],["と"],["しない"],["。"],["／"],["あなた"],["は"],["神","かみ"],["の"],["おしえ"],["を"],["忘れた","わすれた"],["ので"],["、"],["わたし"],["も"],["また"],["、"],["あなた"],["の"],["子","こ"],["ら"],["を"],["忘れよう","わすれよう"],["。"]]},{"verse":7,"text":"彼らはふえるにしたがって、ますます、わたしに罪を犯した。／わたしは彼らの栄光を恥に変える。","tok":[["彼","かれ"],["ら"],["は"],["ふえる"],["に"],["したがって"],["、"],["ますます"],["、"],["わたし"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["／"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["栄光","えいこう"],["を"],["恥","はじ"],["に"],["変える","かえる"],["。"]]},{"verse":8,"text":"彼らはわたしの民の罪を食いものにし、彼らの咎に望みをかけている。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["の"],["罪","つみ"],["を"],["食いもの","くいもの"],["に"],["し"],["、"],["彼","かれ"],["ら"],["の"],["咎","とが"],["に"],["望み","のぞみ"],["を"],["かけて"],["いる"],["。"]]},{"verse":9,"text":"だから、民も祭司も同じようになる。／わたしはその行いに報い、そのわざの仕返しをする。","tok":[["だ"],["から"],["、"],["民","みん"],["も"],["祭司","さいし"],["も"],["同じ","おなじ"],["よう"],["に"],["なる"],["。"],["／"],["わたし"],["は"],["その"],["行い","おこない"],["に"],["報い","むくい"],["、"],["その"],["わざ"],["の"],["仕返し","しかえし"],["を"],["する"],["。"]]},{"verse":10,"text":"彼らは食べても、満たされず、姦淫しても、ふえることはない。／彼らは主を捨てて、姦淫を続けるからだ。","tok":[["彼","かれ"],["ら"],["は"],["食べて","たべて"],["も"],["、"],["満たされず","みたされず"],["、"],["姦淫","かんいん"],["して"],["も"],["、"],["ふえる"],["こと"],["は"],["ない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["を"],["捨てて","すてて"],["、"],["姦淫","かんいん"],["を"],["続ける","つづける"],["から"],["だ"],["。"]]},{"verse":11,"text":"ぶどう酒と新しいぶどう酒は思慮を失わせる。","tok":[["ぶどう酒","ぶどうしゅ"],["と"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["は"],["思慮","しりょ"],["を"],["失わせる","うしなわせる"],["。"]]},{"verse":12,"text":"わたしの民は木に伺いを立て、その杖は彼らに事を告げる。／これは、姦淫の霊が彼らを迷わせ、彼らが自分たちの神を見捨てて／姦淫をしたからだ。","tok":[["わたし"],["の"],["民","たみ"],["は"],["木","き"],["に"],["伺い","うかがい"],["を"],["立て","たて"],["、"],["その"],["杖","つえ"],["は"],["彼","かれ"],["ら"],["に"],["事","こと"],["を"],["告げる","つげる"],["。"],["／"],["これ"],["は"],["、"],["姦淫","かんいん"],["の"],["霊","れい"],["が"],["彼","かれ"],["ら"],["を"],["迷わせ","まよわせ"],["、"],["彼","かれ"],["ら"],["が"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["を"],["見捨てて","みすてて"],["／"],["姦淫","かんいん"],["を"],["した"],["から"],["だ"],["。"]]},{"verse":13,"text":"彼らは山々の頂でいけにえをささげ、丘の上、また、樫の木、ポプラ、テレビンの木の下で香をたく。／その木陰がここちよいからだ。／それゆえ、あなたがたの娘は姦淫をし、あなたがたの嫁は姦通をする。","tok":[["彼","かれ"],["ら"],["は"],["山々","やまやま"],["の"],["頂","いただき"],["で"],["いけにえ"],["を"],["ささげ"],["、"],["丘","おか"],["の"],["上","うえ"],["、"],["また"],["、"],["樫","かし"],["の"],["木","き"],["、"],["ポプラ"],["、"],["テレビン"],["の"],["木","き"],["の"],["下","もと"],["で"],["香","こう"],["を"],["たく"],["。"],["／"],["その"],["木陰","こかげ"],["が"],["ここちよい"],["から"],["だ"],["。"],["／"],["それ"],["ゆえ"],["、"],["あなた"],["がた"],["の"],["娘","むすめ"],["は"],["姦淫","かんいん"],["を"],["し"],["、"],["あなた"],["がた"],["の"],["嫁","よめ"],["は"],["姦通","かんつう"],["を"],["する"],["。"]]},{"verse":14,"text":"わたしは、あなたがたの娘が姦淫をしても／罰しない。／また、あなたがたの嫁が姦通をしても罰しない。／それは男たちが遊女とともに離れ去り、神殿娼婦とともに／いけにえをささげているからだ。／悟りのない民は踏みつけられる。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["娘","むすめ"],["が"],["姦淫","かんいん"],["を"],["して"],["も"],["／"],["罰しない","ばっしない"],["。"],["／"],["また"],["、"],["あなた"],["がた"],["の"],["嫁","よめ"],["が"],["姦通","かんつう"],["を"],["して"],["も"],["罰しない","ばっしない"],["。"],["／"],["それ"],["は"],["男","おとこ"],["たち"],["が"],["遊女","ゆうじょ"],["と"],["とも"],["に"],["離れ去り","はなれさり"],["、"],["神殿","しんでん"],["娼婦","しょうふ"],["と"],["とも"],["に"],["／"],["いけにえ"],["を"],["ささげて"],["いる"],["から"],["だ"],["。"],["／"],["悟り","さとり"],["の"],["ない"],["民","たみ"],["は"],["踏みつけられる","ふみつけられる"],["。"]]},{"verse":15,"text":"イスラエルよ。あなたは姦淫をしても、ユダに罪を犯させてはならない。／ギルガルに行ってはならない。／ベテ・アベンに上ってはならない。／「主は生きておられる」と言って／誓ってはならない。","tok":[["イスラエル"],["よ"],["。"],["あなた"],["は"],["姦淫","かんいん"],["を"],["して"],["も"],["、"],["ユダ"],["に"],["罪","つみ"],["を"],["犯させて","おかさせて"],["は"],["ならない"],["。"],["／"],["ギルガル"],["に"],["行って","いって"],["は"],["ならない"],["。"],["／"],["ベテ"],["・"],["アベン"],["に"],["上って","のぼって"],["は"],["ならない"],["。"],["／"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["」"],["と"],["言って","いって"],["／"],["誓って","ちかって"],["は"],["ならない"],["。"]]},{"verse":16,"text":"まことに、イスラエルは／かたくなな雌牛のようにかたくなだ。／しかし今、主は、彼らを広い所にいる子羊のように養う。","tok":[["まこと"],["に"],["、"],["イスラエル"],["は"],["／"],["かたくな"],["な"],["雌牛","めうし"],["の"],["よう"],["に"],["かたくな"],["だ"],["。"],["／"],["しかし"],["今","いま"],["、"],["主","ぬし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["広い","ひろい"],["所","ところ"],["に"],["いる"],["子羊","こひつじ"],["の"],["よう"],["に"],["養う","やしなう"],["。"]]},{"verse":17,"text":"エフライムは偶像に、くみしている。／そのなすにまかせよ。","tok":[["エフライム"],["は"],["偶像","ぐうぞう"],["に"],["、"],["くみして"],["いる"],["。"],["／"],["その"],["なす"],["に"],["まかせ"],["よ"],["。"]]},{"verse":18,"text":"彼らは飲酒にふけり、淫行を重ね、彼らのみだらなふるまいで恥を愛した。","tok":[["彼","かれ"],["ら"],["は"],["飲酒","いんしゅ"],["に"],["ふけり"],["、"],["淫行","いんこう"],["を"],["重ね","かさね"],["、"],["彼","かれ"],["ら"],["の"],["みだら"],["な"],["ふるまい"],["で"],["恥","はじ"],["を"],["愛した","あいした"],["。"]]},{"verse":19,"text":"風はその翼で彼らを吹き飛ばす。／彼らは自分たちの祭壇のために恥を見る。","tok":[["風","かぜ"],["は"],["その"],["翼","つばさ"],["で"],["彼","かれ"],["ら"],["を"],["吹き飛ばす","ふきとばす"],["。"],["／"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["祭壇","さいだん"],["の"],["ため"],["に"],["恥","はじ"],["を"],["見る","みる"],["。"]]}]
[{"verse":1,"text":"「さあ、主に立ち返ろう。／主は私たちを引き裂いたが、また、いやし、私たちを打ったが、また、包んでくださるからだ。","tok":[["「"],["さあ"],["、"],["主に","おもに"],["立ち返ろう","たちかえろう"],["。"],["／"],["主","ぬし"],["は"],["私たち","わたしたち"],["を"],["引き裂いた","ひきさいた"],["が"],["、"],["また"],["、"],["いやし"],["、"],["私たち","わたしたち"],["を"],["打った","うった"],["が"],["、"],["また"],["、"],["包んで","つつんで"],["くださる"],["から"],["だ"],["。"]]},{"verse":2,"text":"主は二日の後、私たちを生き返らせ、三日目に私たちを立ち上がらせる。／私たちは、御前に生きるのだ。","tok":[["主","ぬし"],["は"],["二日","ふたか"],["の"],["後","あと"],["、"],["私たち","わたしたち"],["を"],["生き返らせ","いきかえらせ"],["、"],["三日目","みっかめ"],["に"],["私たち","わたしたち"],["を"],["立ち上がらせる","たちあがらせる"],["。"],["／"],["私たち","わたしたち"],["は"],["、"],["御前","ごぜん"],["に"],["生きる","いきる"],["の"],["だ"],["。"]]},{"verse":3,"text":"私たちは、知ろう。／主を知ることを切に追い求めよう。／主は暁の光のように、確かに現れ、大雨のように、私たちのところに来、後の雨のように、地を潤される。」","tok":[["私たち","わたしたち"],["は"],["、"],["知ろう","しろう"],["。"],["／"],["主","ぬし"],["を"],["知る","しる"],["こと"],["を"],["切に","せつに"],["追い求めよう","おいもとめよう"],["。"],["／"],["主","ぬし"],["は"],["暁","あかつき"],["の"],["光","ひかり"],["の"],["よう"],["に"],["、"],["確か","たしか"],["に"],["現れ","あらわれ"],["、"],["大雨","おおあめ"],["の"],["よう"],["に"],["、"],["私たち","わたしたち"],["の"],["ところ"],["に"],["来","き"],["、"],["後","あと"],["の"],["雨","あめ"],["の"],["よう"],["に"],["、"],["地","ち"],["を"],["潤される","うるおされる"],["。"],["」"]]},{"verse":4,"text":"エフライムよ。わたしはあなたに何をしようか。／ユダよ。わたしはあなたに何をしようか。／あなたがたの誠実は朝もやのようだ。／朝早く消え去る露のようだ。","tok":[["エフライム"],["よ"],["。"],["わたし"],["は"],["あなた"],["に"],["何","なん"],["を"],["しよう"],["か"],["。"],["／"],["ユダ"],["よ"],["。"],["わたし"],["は"],["あなた"],["に"],["何","なん"],["を"],["しよう"],["か"],["。"],["／"],["あなた"],["がた"],["の"],["誠実","せいじつ"],["は"],["朝もや","あさもや"],["の"],["よう"],["だ"],["。"],["／"],["朝","あさ"],["早く","はやく"],["消え去る","きえさる"],["露","ろ"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"それゆえ、わたしは預言者たちによって、彼らを切り倒し、わたしの口のことばで彼らを殺す。／わたしのさばきは光のように現れる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["預言者","よげんしゃ"],["たち"],["によって"],["、"],["彼","かれ"],["ら"],["を"],["切り倒し","きりたおし"],["、"],["わたし"],["の"],["口","くち"],["の"],["ことば"],["で"],["彼","かれ"],["ら"],["を"],["殺す","ころす"],["。"],["／"],["わたし"],["の"],["さばき"],["は"],["光","ひかり"],["の"],["よう"],["に"],["現れる","あらわれる"],["。"]]},{"verse":6,"text":"わたしは誠実を喜ぶが、いけにえは喜ばない。／全焼のいけにえより、むしろ神を知ることを喜ぶ。","tok":[["わたし"],["は"],["誠実","せいじつ"],["を"],["喜ぶ","よろこぶ"],["が"],["、"],["いけにえ"],["は"],["喜ばない","よろこばない"],["。"],["／"],["全焼","ぜんしょう"],["の"],["いけにえ"],["より"],["、"],["むしろ"],["神","かみ"],["を"],["知る","しる"],["こと"],["を"],["喜ぶ","よろこぶ"],["。"]]},{"verse":7,"text":"ところが、彼らはアダムのように契約を破り、その時わたしを裏切った。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["アダム"],["の"],["よう"],["に"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["その"],["時","とき"],["わたし"],["を"],["裏切った","うらぎった"],["。"]]},{"verse":8,"text":"ギルアデは不法を行う者の町、血の足跡に満ちている。","tok":[["ギルアデ"],["は"],["不法","ふほう"],["を"],["行う","おこなう"],["者","もの"],["の"],["町","まち"],["、"],["血","ち"],["の"],["足跡","あしあと"],["に"],["満ちて","みちて"],["いる"],["。"]]},{"verse":9,"text":"盗賊が人を待ち伏せするように、祭司たちは仲間を組み、シェケムへの道で人を殺し、彼らは実にみだらなことをする。","tok":[["盗賊","とうぞく"],["が"],["人","ひと"],["を"],["待ち伏せ","まちぶせ"],["する"],["よう"],["に"],["、"],["祭司","さいし"],["たち"],["は"],["仲間","なかま"],["を"],["組み","くみ"],["、"],["シェケム"],["へ"],["の"],["道","みち"],["で"],["人","ひと"],["を"],["殺し","ころし"],["、"],["彼","かれ"],["ら"],["は"],["実","じつ"],["に"],["みだら"],["な"],["こと"],["を"],["する"],["。"]]},{"verse":10,"text":"イスラエルの家にわたしは恐るべきことを見た。／エフライムは姦淫をし、イスラエルは身を汚している。","tok":[["イスラエル"],["の"],["家","いえ"],["に"],["わたし"],["は"],["恐るべき","おそるべき"],["こと"],["を"],["見た","みた"],["。"],["／"],["エフライム"],["は"],["姦淫","かんいん"],["を"],["し"],["、"],["イスラエル"],["は"],["身","み"],["を"],["汚して","よごして"],["いる"],["。"]]},{"verse":11,"text":"ユダよ。わたしが、わたしの民の繁栄を元どおりにするとき、あなたのためにも刈り入れが定まっている。","tok":[["ユダ"],["よ"],["。"],["わたし"],["が"],["、"],["わたし"],["の"],["民","たみ"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["する"],["とき"],["、"],["あなた"],["の"],["ため"],["に"],["も"],["刈り入れ","かりいれ"],["が"],["定まって","さだまって"],["いる"],["。"]]}]
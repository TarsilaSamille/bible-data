[{"verse":1,"text":"あなたがたの兄弟には、「わたしの民」と言い、あなたがたの姉妹には、「愛される者」と言え。","tok":[["あなた"],["がた"],["の"],["兄弟","きょうだい"],["に"],["は"],["、"],["「"],["わたし"],["の"],["民","みん"],["」"],["と"],["言い","いい"],["、"],["あなた"],["がた"],["の"],["姉妹","しまい"],["に"],["は"],["、"],["「"],["愛される","あいされる"],["者","もの"],["」"],["と"],["言え","いえ"],["。"]]},{"verse":2,"text":"「あなたがたの母をとがめよ。とがめよ。／彼女はわたしの妻ではなく、わたしは彼女の夫ではないからだ。／彼女の顔から姦淫を取り除き、その乳房の間から姦通を取り除け。","tok":[["「"],["あなた"],["がた"],["の"],["母","はは"],["を"],["とがめよ"],["。"],["とがめ"],["よ"],["。"],["／"],["彼女","かのじょ"],["は"],["わたし"],["の"],["妻","つま"],["で"],["は"],["なく"],["、"],["わたし"],["は"],["彼女","かのじょ"],["の"],["夫","おっと"],["で"],["は"],["ない"],["から"],["だ"],["。"],["／"],["彼女","かのじょ"],["の"],["顔","かお"],["から"],["姦淫","かんいん"],["を"],["取り除き","とりのぞき"],["、"],["その"],["乳房","ちぶさ"],["の"],["間","あいだ"],["から"],["姦通","かんつう"],["を"],["取り除け","とりのぞけ"],["。"]]},{"verse":3,"text":"そうでなければ、わたしは、彼女の着物をはいで裸にし、生まれた日のようにして彼女をさらし、彼女を荒野のようにし、砂漠のようにし、渇きで彼女を死なせよう。","tok":[["そう"],["で"],["なければ"],["、"],["わたし"],["は"],["、"],["彼女","かのじょ"],["の"],["着物","きもの"],["を"],["はいで"],["裸","はだか"],["に"],["し"],["、"],["生まれた","うまれた"],["日","ひ"],["の"],["よう"],["に"],["して"],["彼女","かのじょ"],["を"],["さらし"],["、"],["彼女","かのじょ"],["を"],["荒野","あらの"],["の"],["よう"],["に"],["し"],["、"],["砂漠","さばく"],["の"],["よう"],["に"],["し"],["、"],["渇き","かわき"],["で"],["彼女","かのじょ"],["を"],["死なせよう","しなせよう"],["。"]]},{"verse":4,"text":"わたしは彼女の子らを愛さない。／彼らは姦淫の子らであるから。","tok":[["わたし"],["は"],["彼女","かのじょ"],["の"],["子","こ"],["ら"],["を"],["愛さない","あいさない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["姦淫","かんいん"],["の"],["子","こ"],["ら"],["で"],["ある"],["から"],["。"]]},{"verse":5,"text":"彼らの母は姦淫をし、彼らをはらんで恥をさらし、そして言った。／『私は恋人たちのあとを追う。／彼らは私にパンと水、羊毛と麻、油と飲み物を与えてくれる』と。","tok":[["彼","かれ"],["ら"],["の"],["母","はは"],["は"],["姦淫","かんいん"],["を"],["し"],["、"],["彼","かれ"],["ら"],["を"],["はらんで"],["恥","はじ"],["を"],["さらし"],["、"],["そして"],["言った","いった"],["。"],["／"],["『"],["私","わたくし"],["は"],["恋人","こいびと"],["たち"],["の"],["あと"],["を"],["追う","おう"],["。"],["／"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["に"],["パン"],["と"],["水","みず"],["、"],["羊毛","ようもう"],["と"],["麻","あさ"],["、"],["油","あぶら"],["と"],["飲み物","のみもの"],["を"],["与えて","あたえて"],["くれる"],["』"],["と"],["。"]]},{"verse":6,"text":"それゆえ、わたしは、いばらで彼女の道に垣を立て、彼女が通い路を見いださないように、石垣を立てよう。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["いばら"],["で"],["彼女","かのじょ"],["の"],["道","みち"],["に"],["垣","かき"],["を"],["立て","たて"],["、"],["彼女","かのじょ"],["が"],["通い路","かよいじ"],["を"],["見いださない","みいださない"],["よう"],["に"],["、"],["石垣","いしがき"],["を"],["立てよう","たてよう"],["。"]]},{"verse":7,"text":"彼女は恋人たちのあとを追って行こう。／しかし、彼らに追いつくことはない。／彼らを捜し求めよう。／しかし、見つけ出すことはない。／彼女は言う。／『私は行って、初めの夫に戻ろう。／あの時は、今よりも私はしあわせだったから。』","tok":[["彼女","かのじょ"],["は"],["恋人","こいびと"],["たち"],["の"],["あと"],["を"],["追って","おって"],["行こう","いこう"],["。"],["／"],["しかし"],["、"],["彼","かれ"],["ら"],["に"],["追いつく","おいつく"],["こと"],["は"],["ない"],["。"],["／"],["彼","かれ"],["ら"],["を"],["捜し求めよう","さがしもとめよう"],["。"],["／"],["しかし"],["、"],["見つけ","みつけ"],["出す","だす"],["こと"],["は"],["ない"],["。"],["／"],["彼女","かのじょ"],["は"],["言う","ゆう"],["。"],["／"],["『"],["私","わたくし"],["は"],["行って","いって"],["、"],["初め","はじめ"],["の"],["夫","おっと"],["に"],["戻ろう","もどろう"],["。"],["／"],["あの"],["時","とき"],["は"],["、"],["今","いま"],["より"],["も"],["私","わたくし"],["は"],["しあわせ"],["だった"],["から"],["。"],["』"]]},{"verse":8,"text":"彼女に穀物と新しいぶどう酒と油とを与えた者、また、バアルのために使った銀と金とを／多く与えた者が、わたしであるのを、彼女は知らなかった。","tok":[["彼女","かのじょ"],["に"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["油","あぶら"],["と"],["を"],["与えた","あたえた"],["者","もの"],["、"],["また"],["、"],["バアル"],["の"],["ため"],["に"],["使った","つかった"],["銀","ぎん"],["と"],["金","かね"],["と"],["を"],["／"],["多く","おおく"],["与えた","あたえた"],["者","もの"],["が"],["、"],["わたし"],["で"],["ある"],["の"],["を"],["、"],["彼女","かのじょ"],["は"],["知らなかった","しらなかった"],["。"]]},{"verse":9,"text":"それゆえ、わたしは、その時になって、わたしの穀物を、その季節になって、わたしの新しいぶどう酒を取り戻し、また、彼女の裸をおおうための／わたしの羊毛と麻とをはぎ取ろう。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["その"],["時","とき"],["に"],["なって"],["、"],["わたし"],["の"],["穀物","こくもつ"],["を"],["、"],["その"],["季節","きせつ"],["に"],["なって"],["、"],["わたし"],["の"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["を"],["取り戻し","とりもどし"],["、"],["また"],["、"],["彼女","かのじょ"],["の"],["裸","はだか"],["を"],["おおう"],["ため"],["の"],["／"],["わたし"],["の"],["羊毛","ようもう"],["と"],["麻","あさ"],["と"],["を"],["はぎ取ろう","はぎとろう"],["。"]]},{"verse":10,"text":"今、わたしは彼女の恥を、恋人たちの目の前にあばく。／だれも彼女を／わたしの手から救い出せる者はない。","tok":[["今","いま"],["、"],["わたし"],["は"],["彼女","かのじょ"],["の"],["恥","はじ"],["を"],["、"],["恋人","こいびと"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あばく"],["。"],["／"],["だれ"],["も"],["彼女","かのじょ"],["を"],["／"],["わたし"],["の"],["手","て"],["から"],["救い出せる","すくいだせる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":11,"text":"わたしは彼女のすべての喜び、祭り、新月の祭り、安息日、すべての例祭を、やめさせる。","tok":[["わたし"],["は"],["彼女","かのじょ"],["の"],["すべて"],["の"],["喜び","よろこび"],["、"],["祭り","まつり"],["、"],["新月","しんげつ"],["の"],["祭り","まつり"],["、"],["安息日","あんそくび"],["、"],["すべて"],["の"],["例祭","れいさい"],["を"],["、"],["やめさせる"],["。"]]},{"verse":12,"text":"それから、わたしは彼女が／『これは私の恋人たちが払ってくれた報酬』／と言っていた彼女のぶどうの木と、いちじくの木とを荒れすたらせ、これを林にして、野の獣にこれを食べさせる。","tok":[["それ"],["から"],["、"],["わたし"],["は"],["彼女","かのじょ"],["が"],["／"],["『"],["これ"],["は"],["私","わたくし"],["の"],["恋人","こいびと"],["たち"],["が"],["払って","はらって"],["くれた"],["報酬","ほうしゅう"],["』"],["／"],["と"],["言って","いって"],["いた"],["彼女","かのじょ"],["の"],["ぶどう"],["の"],["木","き"],["と"],["、"],["いちじく"],["の"],["木","き"],["と"],["を"],["荒れ","あれ"],["すたらせ"],["、"],["これ"],["を"],["林","はやし"],["に"],["して"],["、"],["野","の"],["の"],["獣","けもの"],["に"],["これ"],["を"],["食べさせる","たべさせる"],["。"]]},{"verse":13,"text":"わたしは、彼女がバアルに香をたき、耳輪や飾りを身につけて、恋人たちを慕って行き、わたしを忘れてバアルに仕えた日々に報いる。／――主の御告げ――","tok":[["わたし"],["は"],["、"],["彼女","かのじょ"],["が"],["バアル"],["に"],["香","こう"],["を"],["たき"],["、"],["耳輪","みみわ"],["や"],["飾り","かざり"],["を"],["身","み"],["に"],["つけて"],["、"],["恋人","こいびと"],["たち"],["を"],["慕って","したって"],["行き","いき"],["、"],["わたし"],["を"],["忘れて","わすれて"],["バアル"],["に"],["仕えた","つかえた"],["日々","ひび"],["に"],["報いる","むくいる"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":14,"text":"それゆえ、見よ、わたしは彼女をくどいて／荒野に連れて行き、優しく彼女に語ろう。","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["彼女","かのじょ"],["を"],["くどいて"],["／"],["荒野","こうや"],["に"],["連れて","つれて"],["行き","いき"],["、"],["優しく","やさしく"],["彼女","かのじょ"],["に"],["語ろう","かたろう"],["。"]]},{"verse":15,"text":"わたしはその所を彼女のためにぶどう畑にし、アコルの谷を望みの門としよう。／彼女が若かった日のように、彼女がエジプトの国から／上って来たときのように、彼女はその所で答えよう。","tok":[["わたし"],["は"],["その"],["所","ところ"],["を"],["彼女","かのじょ"],["の"],["ため"],["に"],["ぶどう"],["畑","はたけ"],["に"],["し"],["、"],["アコル"],["の"],["谷","たに"],["を"],["望み","のぞみ"],["の"],["門","もん"],["と"],["しよう"],["。"],["／"],["彼女","かのじょ"],["が"],["若かった","わかかった"],["日","ひ"],["の"],["よう"],["に"],["、"],["彼女","かのじょ"],["が"],["エジプト"],["の"],["国","くに"],["から"],["／"],["上って","のぼって"],["来た","きた"],["とき"],["の"],["よう"],["に"],["、"],["彼女","かのじょ"],["は"],["その"],["所","ところ"],["で"],["答えよう","こたえよう"],["。"]]},{"verse":16,"text":"その日、――主の御告げ――／あなたはわたしを『私の夫』と呼び、もう、わたしを『私のバアル』とは呼ぶまい。","tok":[["その"],["日","ひ"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["あなた"],["は"],["わたし"],["を"],["『"],["私","わたくし"],["の"],["夫","おっと"],["』"],["と"],["呼び","よび"],["、"],["もう"],["、"],["わたし"],["を"],["『"],["私","わたくし"],["の"],["バアル"],["』"],["と"],["は"],["呼ぶまい","よぶまい"],["。"]]},{"verse":17,"text":"わたしはバアルたちの名を／彼女の口から取り除く。／その名はもう覚えられることはない。","tok":[["わたし"],["は"],["バアル"],["たち"],["の"],["名","な"],["を"],["／"],["彼女","かのじょ"],["の"],["口","くち"],["から"],["取り除く","とりのぞく"],["。"],["／"],["その"],["名","な"],["は"],["もう"],["覚えられる","おぼえられる"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"その日、わたしは彼らのために、野の獣、空の鳥、地をはうものと契約を結び、弓と剣と戦いを地から絶やし、彼らを安らかに休ませる。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["、"],["野","の"],["の"],["獣","けもの"],["、"],["空","そら"],["の"],["鳥","とり"],["、"],["地","ち"],["を"],["はう"],["もの"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["弓","ゆみ"],["と"],["剣","けん"],["と"],["戦い","たたかい"],["を"],["地","ち"],["から"],["絶やし","たやし"],["、"],["彼","かれ"],["ら"],["を"],["安らか","やすらか"],["に"],["休ませる","やすませる"],["。"]]},{"verse":19,"text":"わたしはあなたと永遠に契りを結ぶ。／正義と公義と、恵みとあわれみをもって、契りを結ぶ。","tok":[["わたし"],["は"],["あなた"],["と"],["永遠","えいえん"],["に"],["契り","ちぎり"],["を"],["結ぶ","むすぶ"],["。"],["／"],["正義","まさよし"],["と"],["公義","きみよし"],["と"],["、"],["恵み","めぐみ"],["と"],["あわれみ"],["を"],["もって"],["、"],["契り","ちぎり"],["を"],["結ぶ","むすぶ"],["。"]]},{"verse":20,"text":"わたしは真実をもってあなたと契りを結ぶ。／このとき、あなたは主を知ろう。","tok":[["わたし"],["は"],["真実","しんじつ"],["を"],["もって"],["あなた"],["と"],["契り","ちぎり"],["を"],["結ぶ","むすぶ"],["。"],["／"],["この"],["とき"],["、"],["あなた"],["は"],["主","ぬし"],["を"],["知ろう","しろう"],["。"]]},{"verse":21,"text":"その日、わたしは答える。――主の御告げ――／わたしは天に答え、天は地に答える。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["答える","こたえる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["天","てん"],["に"],["答え","こたえ"],["、"],["天","てん"],["は"],["地","ち"],["に"],["答える","こたえる"],["。"]]},{"verse":22,"text":"地は穀物と新しいぶどう酒と油とに答え、それらはイズレエルに答える。","tok":[["地","ち"],["は"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["油","あぶら"],["と"],["に"],["答え","こたえ"],["、"],["それ"],["ら"],["は"],["イズレエル"],["に"],["答える","こたえる"],["。"]]},{"verse":23,"text":"わたしは彼をわたしのために地にまき散らし、『愛されない者』を愛し、『わたしの民でない者』を、『あなたはわたしの民』と言う。／彼は『あなたは私の神』と言おう。」","tok":[["わたし"],["は"],["彼","かれ"],["を"],["わたし"],["の"],["ため"],["に"],["地","ち"],["に"],["まき散らし","まきちらし"],["、"],["『"],["愛されない","あいされない"],["者","もの"],["』"],["を"],["愛し","あいし"],["、"],["『"],["わたし"],["の"],["民","たみ"],["で"],["ない"],["者","もの"],["』"],["を"],["、"],["『"],["あなた"],["は"],["わたし"],["の"],["民","みん"],["』"],["と"],["言う","ゆう"],["。"],["／"],["彼","かれ"],["は"],["『"],["あなた"],["は"],["私","わたくし"],["の"],["神","かみ"],["』"],["と"],["言おう","いおう"],["。"],["」"]]}]
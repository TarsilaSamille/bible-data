[{"verse":1,"text":"ユダの王ウジヤ、ヨタム、アハズ、ヒゼキヤの時代、イスラエルの王、ヨアシュの子ヤロブアムの時代に、ベエリの子ホセアにあった主のことば。","tok":[["ユダ"],["の"],["王","おう"],["ウジヤ"],["、"],["ヨタム"],["、"],["アハズ"],["、"],["ヒゼキヤ"],["の"],["時代","じだい"],["、"],["イスラエル"],["の"],["王","おう"],["、"],["ヨアシュ"],["の"],["子","こ"],["ヤロブアム"],["の"],["時代","じだい"],["に"],["、"],["ベエリ"],["の"],["子","こ"],["ホセア"],["に"],["あった"],["主","ぬし"],["の"],["ことば"],["。"]]},{"verse":2,"text":"主がホセアに語り始められたとき、主はホセアに仰せられた。「行って、姦淫の女をめとり、姦淫の子らを引き取れ。この国は主を見捨てて、はなはだしい淫行にふけっているからだ。」","tok":[["主","ぬし"],["が"],["ホセア"],["に"],["語り","かたり"],["始められた","はじめられた"],["とき"],["、"],["主","ぬし"],["は"],["ホセア"],["に"],["仰せられた","おおせられた"],["。"],["「"],["行って","いって"],["、"],["姦淫","かんいん"],["の"],["女","おんな"],["を"],["めとり"],["、"],["姦淫","かんいん"],["の"],["子","こ"],["ら"],["を"],["引き取れ","ひきとれ"],["。"],["この"],["国","くに"],["は"],["主","ぬし"],["を"],["見捨てて","みすてて"],["、"],["はなはだしい"],["淫行","いんこう"],["に"],["ふけって"],["いる"],["から"],["だ"],["。"],["」"]]},{"verse":3,"text":"そこで彼は行って、ディブライムの娘ゴメルをめとった。彼女はみごもって、彼に男の子を産んだ。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["行って","いって"],["、"],["ディブ"],["ライム"],["の"],["娘","むすめ"],["ゴメル"],["を"],["めとった"],["。"],["彼女","かのじょ"],["は"],["みごもって"],["、"],["彼","かれ"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":4,"text":"主は彼に仰せられた。「あなたはその子をイズレエルと名づけよ。しばらくして、わたしはイズレエルの血をエフーの家に報い、イスラエルの家の王国を取り除くからだ。","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["その"],["子","こ"],["を"],["イズレエル"],["と"],["名づけよ","なづけよ"],["。"],["しばらく"],["して"],["、"],["わたし"],["は"],["イズレエル"],["の"],["血","ち"],["を"],["エフー"],["の"],["家","いえ"],["に"],["報い","むくい"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["王国","おうこく"],["を"],["取り除く","とりのぞく"],["から"],["だ"],["。"]]},{"verse":5,"text":"その日、わたしは、イズレエルの谷でイスラエルの弓を折る。」","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["イズレエル"],["の"],["谷","たに"],["で"],["イスラエル"],["の"],["弓","ゆみ"],["を"],["折る","おる"],["。"],["」"]]},{"verse":6,"text":"ゴメルはまたみごもって、女の子を産んだ。主は彼に仰せられた。「その子をロ・ルハマと名づけよ。わたしはもう二度とイスラエルの家を愛することはなく、決して彼らを赦さないからだ。","tok":[["ゴメル"],["は"],["また"],["みごもって"],["、"],["女の子","おんなのこ"],["を"],["産んだ","うんだ"],["。"],["主","ぬし"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["その"],["子","こ"],["を"],["ロ"],["・"],["ルハマ"],["と"],["名づけよ","なづけよ"],["。"],["わたし"],["は"],["もう"],["二","に"],["度","ど"],["と"],["イスラエル"],["の"],["家","いえ"],["を"],["愛する","あいする"],["こと"],["は"],["なく"],["、"],["決して","けっして"],["彼","かれ"],["ら"],["を"],["赦さない","ゆるさない"],["から"],["だ"],["。"]]},{"verse":7,"text":"しかし、わたしはユダの家を愛し、彼らの神、主によって彼らを救う。しかし、わたしは弓、剣、戦い、および馬、騎兵によって彼らを救うのではない。」","tok":[["しかし"],["、"],["わたし"],["は"],["ユダ"],["の"],["家","いえ"],["を"],["愛し","あいし"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主に","おもに"],["よって"],["彼","かれ"],["ら"],["を"],["救う","すくう"],["。"],["しかし"],["、"],["わたし"],["は"],["弓","ゆみ"],["、"],["剣","けん"],["、"],["戦い","たたかい"],["、"],["および"],["馬","うま"],["、"],["騎兵","きへい"],["によって"],["彼","かれ"],["ら"],["を"],["救う","すくう"],["ので"],["は"],["ない"],["。"],["」"]]},{"verse":8,"text":"ゴメルは、ロ・ルハマを乳離れさせてから、みごもって男の子を産んだ。","tok":[["ゴメル"],["は"],["、"],["ロ"],["・"],["ルハマ"],["を"],["乳離れ","ちばなれ"],["させて"],["から"],["、"],["みごもって"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":9,"text":"主は仰せられた。「その子をロ・アミと名づけよ。あなたがたはわたしの民ではなく、わたしはあなたがたの神ではないからだ。」","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["その"],["子","こ"],["を"],["ロ"],["・"],["アミ"],["と"],["名づけよ","なづけよ"],["。"],["あなた"],["がた"],["は"],["わたし"],["の"],["民","たみ"],["で"],["は"],["なく"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["で"],["は"],["ない"],["から"],["だ"],["。"],["」"]]},{"verse":10,"text":"イスラエル人の数は、海の砂のようになり、量ることも数えることもできなくなる。彼らは、「あなたがたはわたしの民ではない」と言われた所で、「あなたがたは生ける神の子らだ」と言われるようになる。","tok":[["イスラエル"],["人","にん"],["の"],["数","かず"],["は"],["、"],["海","うみ"],["の"],["砂","すな"],["の"],["よう"],["に"],["なり"],["、"],["量る","はかる"],["こと"],["も"],["数える","かぞえる"],["こと"],["も"],["できなく"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["の"],["民","たみ"],["で"],["は"],["ない"],["」"],["と"],["言われた","いわれた"],["所","ところ"],["で"],["、"],["「"],["あなた"],["がた"],["は"],["生ける","いける"],["神","かみ"],["の"],["子","こ"],["ら"],["だ"],["」"],["と"],["言われる","いわれる"],["よう"],["に"],["なる"],["。"]]},{"verse":11,"text":"ユダの人々とイスラエルの人々は、一つに集められ、彼らは、ひとりのかしらを立てて、国々から上って来る。イズレエルの日は大いなるものとなるからである。","tok":[["ユダ"],["の"],["人々","ひとびと"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["一","ひと"],["つ"],["に"],["集められ","あつめられ"],["、"],["彼","かれ"],["ら"],["は"],["、"],["ひとり"],["の"],["かしら"],["を"],["立てて","たてて"],["、"],["国々","くにぐに"],["から"],["上って","のぼって"],["来る","くる"],["。"],["イズレエル"],["の"],["日","ひ"],["は"],["大いなる","おおいなる"],["もの"],["と"],["なる"],["から"],["で"],["ある"],["。"]]}]
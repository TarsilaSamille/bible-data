[{"verse":1,"text":"エフライムが震えながら語ったとき、主はイスラエルの中であがめられた。／しかし、エフライムは、バアルにより罪を犯して死んだ。","tok":[["エフライム"],["が"],["震え","ふるえ"],["ながら"],["語った","かたった"],["とき"],["、"],["主","ぬし"],["は"],["イスラエル"],["の"],["中","なか"],["で"],["あがめられた"],["。"],["／"],["しかし"],["、"],["エフライム"],["は"],["、"],["バアル"],["に"],["より"],["罪","ざい"],["を"],["犯して","おかして"],["死んだ","しんだ"],["。"]]},{"verse":2,"text":"彼らは今も罪を重ね、銀で鋳物の像を造り、自分の考えで偶像を造った。／これはみな、職人の造った物。／彼らはこれについて言う。／「いけにえをささげる者は子牛に口づけせよ」と。","tok":[["彼","かれ"],["ら"],["は"],["今","いま"],["も"],["罪","つみ"],["を"],["重ね","かさね"],["、"],["銀","ぎん"],["で"],["鋳物","いもの"],["の"],["像","ぞう"],["を"],["造り","つくり"],["、"],["自分","じぶん"],["の"],["考え","かんがえ"],["で"],["偶像","ぐうぞう"],["を"],["造った","つくった"],["。"],["／"],["これ"],["は"],["みな"],["、"],["職人","しょくにん"],["の"],["造った","つくった"],["物","もの"],["。"],["／"],["彼","かれ"],["ら"],["は"],["これ"],["について"],["言う","ゆう"],["。"],["／"],["「"],["いけにえ"],["を"],["ささげる"],["者","もの"],["は"],["子牛","こうし"],["に"],["口づけ","くちづけ"],["せよ"],["」"],["と"],["。"]]},{"verse":3,"text":"それゆえ、彼らは朝もやのように、朝早く消え去る露のように、打ち場から吹き散らされるもみがらのように、また、窓から出て行く煙のようになる。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["は"],["朝もや","あさもや"],["の"],["よう"],["に"],["、"],["朝","あさ"],["早く","はやく"],["消え去る","きえさる"],["露","ろ"],["の"],["よう"],["に"],["、"],["打ち","うち"],["場","ば"],["から"],["吹き散らされる","ふきちらされる"],["もみがら"],["の"],["よう"],["に"],["、"],["また"],["、"],["窓","まど"],["から"],["出て","でて"],["行く","いく"],["煙","けむり"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":4,"text":"しかし、わたしは、エジプトの国にいたときから、あなたの神、主である。／あなたはわたしのほかに神を知らない。／わたしのほかに救う者はいない。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["エジプト"],["の"],["国","くに"],["に"],["いた"],["とき"],["から"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"],["／"],["あなた"],["は"],["わたし"],["の"],["ほか"],["に"],["神","かみ"],["を"],["知らない","しらない"],["。"],["／"],["わたし"],["の"],["ほか"],["に"],["救う","すくう"],["者","もの"],["は"],["いない"],["。"]]},{"verse":5,"text":"このわたしは荒野で、かわいた地で、あなたを知っていた。","tok":[["この"],["わたし"],["は"],["荒野","あらの"],["で"],["、"],["かわいた"],["地","ち"],["で"],["、"],["あなた"],["を"],["知って","しって"],["いた"],["。"]]},{"verse":6,"text":"しかし、彼らは牧
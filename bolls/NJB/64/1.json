[{"verse":1,"text":"長老から、愛するガイオへ。私はあなたをほんとうに愛しています。","tok":[["長老","ちょうろう"],["から"],["、"],["愛する","あいする"],["ガイオ"],["へ"],["。"],["私","わたくし"],["は"],["あなた"],["を"],["ほんとう"],["に"],["愛して","あいして"],["います"],["。"]]},{"verse":2,"text":"愛する者よ。あなたが、たましいに幸いを得ているようにすべての点でも幸いを得、また健康であるように祈ります。","tok":[["愛する","あいする"],["者","もの"],["よ"],["。"],["あなた"],["が"],["、"],["たましい"],["に"],["幸い","さいわい"],["を"],["得て","えて"],["いる"],["よう"],["に"],["すべて"],["の"],["点","てん"],["で"],["も"],["幸い","さいわい"],["を"],["得","え"],["、"],["また"],["健康","けんこう"],["で"],["ある"],["よう"],["に"],["祈ります","いのります"],["。"]]},{"verse":3,"text":"兄弟たちがやって来ては、あなたが真理に歩んでいるその真実を証言してくれるので、私は非常に喜んでいます。","tok":[["兄弟","きょうだい"],["たち"],["が"],["やって"],["来て","きて"],["は"],["、"],["あなた"],["が"],["真理","しんり"],["に"],["歩んで","あゆんで"],["いる"],["その"],["真実","しんじつ"],["を"],["証言","しょうげん"],["して"],["くれる"],["ので"],["、"],["私","わたくし"],["は"],["非常","ひじょう"],["に"],["喜んで","よろこんで"],["います"],["。"]]},{"verse":4,"text":"私の子どもたちが真理に歩んでいることを聞くことほど、私にとって大きな喜びはありません。","tok":[["私","わたくし"],["の"],["子ども","こども"],["たち"],["が"],["真理","しんり"],["に"],["歩んで","あゆんで"],["いる"],["こと"],["を"],["聞く","きく"],["こと"],["ほど"],["、"],["私","わたくし"],["にとって"],["大きな","おおきな"],["喜び","よろこび"],["は"],["ありません"],["。"]]},{"verse":5,"text":"愛する者よ。あなたが、旅をしているあの兄弟たちのために行っているいろいろなことは、真実な行いです。","tok":[["愛する","あいする"],["者","もの"],["よ"],["。"],["あなた"],["が"],["、"],["旅","たび"],["を"],["して"],["いる"],["あの"],["兄弟","きょうだい"],["たち"],["の"],["ため"],["に"],["行って","いって"],["いる"],["いろいろ"],["な"],["こと"],["は"],["、"],["真実","しんじつ"],["な"],["行い","おこない"],["です"],["。"]]},{"verse":6,"text":"彼らは教会の集まりであなたの愛についてあかししました。あなたが神にふさわしいしかたで彼らを次の旅に送り出してくれるなら、それはりっぱなことです。","tok":[["彼","かれ"],["ら"],["は"],["教会","きょうかい"],["の"],["集まり","あつまり"],["で"],["あなた"],["の"],["愛","あい"],["について"],["あかし"],["しました"],["。"],["あなた"],["が"],["神","かみ"],["に"],["ふさわしい"],["しかた"],["で"],["彼","かれ"],["ら"],["を"],["次","つぎ"],["の"],["旅","たび"],["に"],["送り出して","おくりだして"],["くれるなら"],["、"],["それ"],["は"],["りっぱ"],["な"],["こと"],["です"],["。"]]},{"verse":7,"text":"彼らは御名のために出て行きました。異邦人からは何も受けていません。","tok":[["彼","かれ"],["ら"],["は"],["御名","ぎょめい"],["の"],["ため"],["に"],["出て","でて"],["行きました","いきました"],["。"],["異邦人","いほうじん"],["から"],["は"],["何","なん"],["も"],["受けて","うけて"],["いません"],["。"]]},{"verse":8,"text":"ですから、私たちはこのような人々をもてなすべきです。そうすれば、私たちは真理のために彼らの同労者となれるのです。","tok":[["です"],["から"],["、"],["私たち","わたしたち"],["は"],["この"],["よう"],["な"],["人々","ひとびと"],["を"],["もてなすべきです"],["。"],["そう"],["すれば"],["、"],["私たち","わたしたち"],["は"],["真理","しんり"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["の"],["同労者","どうろうしゃ"],["と"],["なれる"],["の"],["です"],["。"]]},{"verse":9,"text":"私は教会に対して少しばかり書き送ったのですが、彼らの中でかしらになりたがっているデオテレペスが、私たちの言うことを聞き入れません。","tok":[["私","わたくし"],["は"],["教会","きょうかい"],["に対して","にたいして"],["少し","すこし"],["ばかり"],["書き送った","かきおくった"],["の"],["です"],["が"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["で"],["かしら"],["に"],["なりたがって"],["いる"],["デオテレペス"],["が"],["、"],["私たち","わたしたち"],["の"],["言う","いう"],["こと"],["を"],["聞き入れません","ききいれません"],["。"]]},{"verse":10,"text":"それで、私が行ったら、彼のしている行為を取り上げるつもりです。彼は意地悪いことばで私たちをののしり、それでもあきたらずに、自分が兄弟たちを受け入れないばかりか、受け入れたいと思う人々の邪魔をし、教会から追い出しているのです。","tok":[["それ"],["で"],["、"],["私","わたくし"],["が"],["行ったら","いったら"],["、"],["彼","かれ"],["の"],["して"],["いる"],["行為","こうい"],["を"],["取り上げる","とりあげる"],["つもり"],["です"],["。"],["彼","かれ"],["は"],["意地","いじ"],["悪い","わるい"],["ことば"],["で"],["私たち","わたしたち"],["を"],["ののしり"],["、"],["それ"],["で"],["も"],["あきたらず"],["に"],["、"],["自分","じぶん"],["が"],["兄弟","きょうだい"],["たち"],["を"],["受け入れない","うけいれない"],["ばかり"],["か"],["、"],["受け入れたい","うけいれたい"],["と"],["思う","おもう"],["人々","ひとびと"],["の"],["邪魔","じゃま"],["を"],["し"],["、"],["教会","きょうかい"],["から"],["追い出して","おいだして"],["いる"],["の"],["です"],["。"]]},{"verse":11,"text":"愛する者よ。悪を見ならわないで、善を見ならいなさい。善を行う者は神から出た者であり、悪を行う者は神を見たことのない者です。","tok":[["愛する","あいする"],["者","もの"],["よ"],["。"],["悪","あく"],["を"],["見ならわないで","みならわないで"],["、"],["善","ぜん"],["を"],["見ならい","みならい"],["なさい"],["。"],["善","ぜん"],["を"],["行う","おこなう"],["者","もの"],["は"],["神","かみ"],["から"],["出た","でた"],["者","もの"],["で"],["あり"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["は"],["神","かみ"],["を"],["見た","みた"],["こと"],["の"],["ない"],["者","もの"],["です"],["。"]]},{"verse":12,"text":"デメテリオはみなの人からも、また真理そのものからも証言されています。私たちも証言します。私たちの証言が真実であることは、あなたも知っているところです。","tok":[["デメテリオ"],["は"],["みな"],["の"],["人","ひと"],["から"],["も"],["、"],["また"],["真理","しんり"],["その"],["もの"],["から"],["も"],["証言","しょうげん"],["されて"],["います"],["。"],["私たち","わたしたち"],["も"],["証言","しょうげん"],["します"],["。"],["私たち","わたしたち"],["の"],["証言","しょうげん"],["が"],["真実","しんじつ"],["で"],["ある"],["こと"],["は"],["、"],["あなた"],["も"],["知って","しって"],["いる"],["ところ"],["です"],["。"]]},{"verse":13,"text":"あなたに書き送りたいことがたくさんありましたが、筆と墨でしたくはありません。","tok":[["あなた"],["に"],["書き送りたい","かきおくりたい"],["こと"],["が"],["たくさん"],["ありました"],["が"],["、"],["筆","ふで"],["と"],["墨","すみ"],["で"],["したく"],["は"],["ありません"],["。"]]},{"verse":14,"text":"間もなくあなたに会いたいと思います。そして顔を合わせて話し合いましょう。","tok":[["間","ま"],["も"],["なく"],["あなた"],["に"],["会いたい","あいたい"],["と"],["思います","おもいます"],["。"],["そして"],["顔","かお"],["を"],["合わせて","あわせて"],["話し合いましょう","はなしあいましょう"],["。"]]},{"verse":15,"text":"平安があなたにありますように。友人たちが、あなたによろしくと言っています。そちらの友人たちひとりひとりによろしく言ってください。","tok":[["平安","へいあん"],["が"],["あなた"],["に"],["あります"],["よう"],["に"],["。"],["友人","ゆうじん"],["たち"],["が"],["、"],["あなた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["そちら"],["の"],["友人","ゆうじん"],["たち"],["ひとりひとり"],["に"],["よろしく"],["言って","いって"],["ください"],["。"]]}]
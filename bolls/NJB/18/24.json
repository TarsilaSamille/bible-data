[{"verse":1,"text":"なぜ、全能者によって時が隠されていないのに、神を知る者たちがその日を見ないのか。","tok":[["なぜ"],["、"],["全能者","ぜんのうしゃ"],["によって"],["時","とき"],["が"],["隠されて","かくされて"],["いない"],["のに"],["、"],["神","かみ"],["を"],["知る","しる"],["者","もの"],["たち"],["が"],["その"],["日","ひ"],["を"],["見ない","みない"],["の"],["か"],["。"]]},{"verse":2,"text":"ある者は地境を動かし、群れを奪い取ってこれを飼い、","tok":[["ある"],["者","もの"],["は"],["地境","じざかい"],["を"],["動かし","うごかし"],["、"],["群れ","むれ"],["を"],["奪い取って","うばいとって"],["これ"],["を"],["飼い","かい"],["、"]]},{"verse":3,"text":"みなしごのろばを連れ去り、やもめの牛を質に取り、","tok":[["みなしご"],["の"],["ろば"],["を"],["連れ去り","つれさり"],["、"],["やもめ"],["の"],["牛","うし"],["を"],["質","しつ"],["に"],["取り","とり"],["、"]]},{"verse":4,"text":"貧しい者を道から押しのける。／その地の哀れな人々は、共に身を隠す。","tok":[["貧しい","まずしい"],["者","もの"],["を"],["道","みち"],["から"],["押しのける","おしのける"],["。"],["／"],["その"],["地","ち"],["の"],["哀れ","あわれ"],["な"],["人々","ひとびと"],["は"],["、"],["共","とも"],["に"],["身","み"],["を"],["隠す","かくす"],["。"]]},{"verse":5,"text":"見よ。荒野の野ろばを。／彼らは、出て行き、荒れた地で獲物を求めて捜し回り、自分の子らのためにえさを求める。","tok":[["見","み"],["よ"],["。"],["荒野","こうや"],["の"],["野","の"],["ろば"],["を"],["。"],["／"],["彼","かれ"],["ら"],["は"],["、"],["出て","でて"],["行き","いき"],["、"],["荒れた","あれた"],["地","ち"],["で"],["獲物","えもの"],["を"],["求めて","もとめて"],["捜し回り","さがしまわり"],["、"],["自分","じぶん"],["の"],["子","こ"],["ら"],["の"],["ため"],["に"],["えさ"],["を"],["求める","もとめる"],["。"]]},{"verse":6,"text":"飼葉を畑で刈り取り、悪者のぶどう畑をかすめる。","tok":[["飼葉","かいば"],["を"],["畑","はたけ"],["で"],["刈り取り","かりとり"],["、"],["悪者","わるもの"],["の"],["ぶどう"],["畑","はたけ"],["を"],["かすめる"],["。"]]},{"verse":7,"text":"彼らは着る物もなく、裸で夜を明かし、寒さの中でも身をおおう物がない。","tok":[["彼","かれ"],["ら"],["は"],["着る","きる"],["物","もの"],["も"],["なく"],["、"],["裸","はだか"],["で"],["夜","よる"],["を"],["明かし","あかし"],["、"],["寒さ","さむさ"],["の"],["中","なか"],["で"],["も"],["身","み"],["を"],["おおう"],["物","もの"],["が"],["ない"],["。"]]},{"verse":8,"text":"山のあらしでずぶぬれになり、避け所もなく、岩を抱く。","tok":[["山","やま"],["の"],["あらし"],["で"],["ずぶぬれ"],["に"],["なり"],["、"],["避け","さけ"],["所","しょ"],["も"],["なく"],["、"],["岩","いわ"],["を"],["抱く","いだく"],["。"]]},{"verse":9,"text":"彼らはみなしごを乳房からもぎ取り、貧しい者の持ち物を質に取る。","tok":[["彼","かれ"],["ら"],["は"],["みなしご"],["を"],["乳房","ちぶさ"],["から"],["もぎ取り","もぎとり"],["、"],["貧しい","まずしい"],["者","もの"],["の"],["持ち物","もちもの"],["を"],["質","しつ"],["に"],["取る","とる"],["。"]]},{"verse":10,"text":"彼らは着る物もなく、裸で歩き、飢えながら麦束をになう。","tok":[["彼","かれ"],["ら"],["は"],["着る","きる"],["物","もの"],["も"],["なく"],["、"],["裸","はだか"],["で"],["歩き","あるき"],["、"],["飢え","うえ"],["ながら"],["麦","むぎ"],["束","たば"],["を"],["になう"],["。"]]},{"verse":11,"text":"その植え込みの間で油をしぼり、酒ぶねを踏みながら、なお渇く。","tok":[["その"],["植え込み","うえこみ"],["の"],["間","あいだ"],["で"],["油","あぶら"],["を"],["しぼり"],["、"],["酒","さけ"],["ぶね"],["を"],["踏み","ふみ"],["ながら"],["、"],["なお"],["渇く","かわく"],["。"]]},{"verse":12,"text":"人の住む町からうめき声が起こり、傷ついた者のたましいは助けを求めて叫ぶ。／しかし、神はその愚痴に心を留められない。","tok":[["人","ひと"],["の"],["住む","すむ"],["町","まち"],["から"],["うめき声","うめきごえ"],["が"],["起こり","おこり"],["、"],["傷ついた","きずついた"],["者","もの"],["の"],["たましい"],["は"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫ぶ","さけぶ"],["。"],["／"],["しかし"],["、"],["神","かみ"],["は"],["その"],["愚痴","ぐち"],["に"],["心","こころ"],["を"],["留められない","とめられない"],["。"]]},{"verse":13,"text":"これらの者は光に反逆する者で、光の道を認めず、また、その通り道にとどまらない。","tok":[["これ"],["ら"],["の"],["者","もの"],["は"],["光","ひかり"],["に"],["反逆","はんぎゃく"],["する"],["者","もの"],["で"],["、"],["光","ひかり"],["の"],["道","みち"],["を"],["認めず","みとめず"],["、"],["また"],["、"],["その"],["通り道","とおりみち"],["に"],["とどまらない"],["。"]]},{"verse":14,"text":"人殺しは、夜明けに起き上がり、哀れな者や貧しい者を殺し、夜には盗人のようになる。","tok":[["人殺し","ひとごろし"],["は"],["、"],["夜明け","よあけ"],["に"],["起き上がり","おきあがり"],["、"],["哀れ","あわれ"],["な"],["者","もの"],["や"],["貧しい","まずしい"],["者","もの"],["を"],["殺し","ころし"],["、"],["夜","よる"],["に"],["は"],["盗人","ぬすびと"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":15,"text":"姦通する者の目は夕暮れを待ちもうけ、「私に気づく目はない」と言い、その顔におおう物を当てる。","tok":[["姦通","かんつう"],["する"],["者","もの"],["の"],["目","め"],["は"],["夕暮れ","ゆうぐれ"],["を"],["待ちもうけ","まちもうけ"],["、"],["「"],["私","わたくし"],["に"],["気づく","きづく"],["目","め"],["は"],["ない"],["」"],["と"],["言い","いい"],["、"],["その"],["顔","かお"],["に"],["おおう"],["物","もの"],["を"],["当てる","あてる"],["。"]]},{"verse":16,"text":"彼は暗くなってから、家々に侵入する。／昼間は閉じこもって光を知らない。","tok":[["彼","かれ"],["は"],["暗く","くらく"]
[{"verse":1,"text":"私の霊は乱れ、私の日は尽き、私のものは墓場だけ。","tok":[["私","わたくし"],["の"],["霊","れい"],["は"],["乱れ","みだれ"],["、"],["私","わたくし"],["の"],["日","ひ"],["は"],["尽き","つき"],["、"],["私","わたくし"],["の"],["もの"],["は"],["墓場","はかば"],["だけ"],["。"]]},{"verse":2,"text":"しかも、あざける者らが、私とともにおり、私の目は彼らの敵意の中で夜を過ごす。","tok":[["しかも"],["、"],["あざける"],["者","もの"],["ら"],["が"],["、"],["私","わたくし"],["と"],["とも"],["に"],["おり"],["、"],["私","わたくし"],["の"],["目","め"],["は"],["彼","かれ"],["ら"],["の"],["敵意","てきい"],["の"],["中","なか"],["で"],["夜","よる"],["を"],["過ごす","すごす"],["。"]]},{"verse":3,"text":"どうか、私を保証する者を／あなたのそばに置いてください。／ほかにだれか誓ってくれる者がありましょうか。","tok":[["どう"],["か"],["、"],["私","わたくし"],["を"],["保証","ほしょう"],["する"],["者","もの"],["を"],["／"],["あなた"],["の"],["そば"],["に"],["置いて","おいて"],["ください"],["。"],["／"],["ほか"],["に"],["だれ"],["か"],["誓って","ちかって"],["くれる"],["者","もの"],["が"],["ありましょう"],["か"],["。"]]},{"verse":4,"text":"あなたが彼らの心を閉じて／悟ることがないようにされたからです。／それゆえ、あなたは彼らを高められないでしょう。","tok":[["あなた"],["が"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["閉じて","とじて"],["／"],["悟る","さとる"],["こと"],["が"],["ない"],["よう"],["に"],["された"],["から"],["です"],["。"],["／"],["それ"],["ゆえ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["高められないでしょう","たかめられないでしょう"],["。"]]},{"verse":5,"text":"分け前を得るために友の告げ口をする者、その子らの目は衰え果てる。","tok":[["分け前","わけまえ"],["を"],["得る","える"],["ため"],["に"],["友","とも"],["の"],["告げ口","つげぐち"],["を"],["する"],["者","もの"],["、"],["その"],["子","こ"],["ら"],["の"],["目","め"],["は"],["衰え","おとろえ"],["果てる","はてる"],["。"]]},{"verse":6,"text":"神は私を民の物笑いとされた。／私は顔につばきをかけられる者となった。","tok":[["神","かみ"],["は"],["私","わたくし"],["を"],["民","たみ"],["の"],["物笑い","ものわらい"],["と"],["された"],["。"],["／"],["私","わたくし"],["は"],["顔","かお"],["に"],["つばき"],["を"],["かけられる"],["者","もの"],["と"],["なった"],["。"]]},{"verse":7,"text":"私の目は悲しみのためにかすみ、私のからだは影のようだ。","tok":[["私","わたくし"],["の"],["目","め"],["は"],["悲しみ","かなしみ"],["の"],["ため"],["に"],["かすみ"],["、"],["私","わたくし"],["の"],["からだ"],["は"],["影","かげ"],["の"],["よう"],["だ"],["。"]]},{"verse":8,"text":"正しい者はこのことに驚き、罪のない者は神を敬わない者に向かって憤る。","tok":[["正しい","ただしい"],["者","もの"],["は"],["この"],["こと"],["に"],["驚き","おどろき"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["は"],["神","かみ"],["を"],["敬わない","うやまわない"],["者","もの"],["に"],["向かって","むかって"],["憤る","いきどおる"],["。"]]},{"verse":9,"text":"義人は自分の道を保ち、手のきよい人は力を増し加える。","tok":[["義人","ぎじん"],["は"],["自分","じぶん"],["の"],["道","みち"],["を"],["保ち","たもち"],["、"],["手","て"],["の"],["きよい"],["人","ひと"],["は"],["力","ちから"],["を"],["増し加える","ましくわえる"],["。"]]},{"verse":10,"text":"だが、あなたがたはみな、帰って来るがよい。／私はあなたがたの中に／ひとりの知恵のある者も見いだすまい。","tok":[["だ"],["が"],["、"],["あなた"],["がた"],["は"],["みな"],["、"],["帰って","かえって"],["来る","くる"],["が"],["よい"],["。"],["／"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["中","なか"],["に"],["／"],["ひとり"],["の"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["も"],["見いだすまい","みいだすまい"],["。"]]},{"verse":11,"text":"私の日は過ぎ去り、私の企て、私の心に抱いたことも破れ去った。","tok":[["私","わたくし"],["の"],["日","ひ"],["は"],["過ぎ去り","すぎさり"],["、"],["私","わたくし"],["の"],["企て","くわだて"],["、"],["私","わたくし"],["の"],["心","こころ"],["に"],["抱いた","いだいた"],["こと"],["も"],["破れ去った","やぶれさった"],["。"]]},{"verse":12,"text":"「夜は昼に変えられ、やみから光が近づく」と言うが、","tok":[["「"],["夜","よる"],["は"],["昼","ひる"],["に"],["変えられ","かえられ"],["、"],["やみ"],["から"],["光","ひかり"],["が"],["近づく","ちかづく"],["」"],["と"],["言う","ゆう"],["が"],["、"]]},{"verse":13,"text":"もし私が、よみを私の住みかとして望み、やみに私の寝床をのべ、","tok":[["もし"],["私","わたくし"],["が"],["、"],["よみ"],["を"],["私","わたくし"],["の"],["住みか","すみか"],["として"],["望み","のぞみ"],["、"],["やみ"],["に"],["私","わたくし"],["の"],["寝床","ねどこ"],["を"],["のべ"],["、"]]},{"verse":14,"text":"その穴に向かって、「おまえは私の父だ」と言い、うじに向かって、「私の母、私の姉妹」と言うのなら、","tok":[["その"],["穴","あな"],["に"],["向かって","むかって"],["、"],["「"],["おまえ"],["は"],["私","わたくし"],["の"],["父","ちち"],["だ"],["」"],["と"],["言い","いい"],["、"],["うじ"],["に"],["向かって","むかって"],["、"],["「"],["私","わたくし"],["の"],["母","はは"],["、"],["私","わたくし"],["の"],["姉妹","しまい"],["」"],["と"],["言う","いう"],["の"],["なら"],["、"]]},{"verse":15,"text":"私の望みはいったいどこにあるのか。／だれが、私の望みを見つけよう。","tok":[["私","わたくし"],["の"],["望み","のぞみ"],["は"],["いったい"],["どこ"],["に"],["ある"],["の"],["か"],["。"],["／"],["だれ"],["が"],["、"],["私","わたくし"],["の"],["望み","のぞみ"],["を"],["見つけよう","みつけよう"],["。"]]},{"verse":16,"text":"よみの深みに下っても、あるいは、共にちりの
[{"verse":1,"text":"ヨブは主に答えて言った。","tok":[["ヨブ"],["は"],["主に","おもに"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":2,"text":"あなたには、すべてができること、あなたは、どんな計画も成し遂げられることを、私は知りました。","tok":[["あなた"],["に"],["は"],["、"],["すべて"],["が"],["できる"],["こと"],["、"],["あなた"],["は"],["、"],["どんな"],["計画","けいかく"],["も"],["成し遂げられる","なしとげられる"],["こと"],["を"],["、"],["私","わたくし"],["は"],["知りました","しりました"],["。"]]},{"verse":3,"text":"知識もなくて、摂理をおおい隠す者は、だれか。／まことに、私は、自分で悟りえないことを告げました。／自分でも知りえない不思議を。","tok":[["知識","ちしき"],["も"],["なくて"],["、"],["摂理","せつり"],["を"],["おおい隠す","おおいかくす"],["者","もの"],["は"],["、"],["だれ"],["か"],["。"],["／"],["まこと"],["に"],["、"],["私","わたくし"],["は"],["、"],["自分","じぶん"],["で"],["悟り","さとり"],["えない"],["こと"],["を"],["告げました","つげました"],["。"],["／"],["自分","じぶん"],["で"],["も"],["知り","しり"],["えない"],["不思議","ふしぎ"],["を"],["。"]]},{"verse":4,"text":"さあ聞け。わたしが語る。／わたしがあなたに尋ねる。わたしに示せ。","tok":[["さあ"],["聞け","きけ"],["。"],["わたし"],["が"],["語る","かたる"],["。"],["／"],["わたし"],["が"],["あなた"],["に"],["尋ねる","たずねる"],["。"],["わたし"],["に"],["示せ","しめせ"],["。"]]},{"verse":5,"text":"私はあなたのうわさを耳で聞いていました。／しかし、今、この目であなたを見ました。","tok":[["私","わたくし"],["は"],["あなた"],["の"],["うわさ"],["を"],["耳","みみ"],["で"],["聞いて","きいて"],["いました"],["。"],["／"],["しかし"],["、"],["今","いま"],["、"],["この"],["目","め"],["で"],["あなた"],["を"],["見ました","みました"],["。"]]},{"verse":6,"text":"それで私は自分をさげすみ、ちりと灰の中で悔いています。","tok":[["それ"],["で"],["私","わたくし"],["は"],["自分","じぶん"],["を"],["さげすみ"],["、"],["ちり"],["と"],["灰","はい"],["の"],["中","なか"],["で"],["悔いて","くいて"],["います"],["。"]]},{"verse":7,"text":"さて、主がこれらのことばをヨブに語られて後、主はテマン人エリファズに仰せられた。「わたしの怒りはあなたとあなたのふたりの友に向かって燃える。それは、あなたがたがわたしについて真実を語らず、わたしのしもべヨブのようではなかったからだ。","tok":[["さて"],["、"],["主","ぬし"],["が"],["これ"],["ら"],["の"],["ことば"],["を"],["ヨブ"],["に"],["語られて","かたられて"],["後","あと"],["、"],["主","ぬし"],["は"],["テマン人","てまんにん"],["エリファズ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["の"],["怒り","いかり"],["は"],["あなた"],["と"],["あなた"],["の"],["ふたり"],["の"],["友","とも"],["に"],["向かって","むかって"],["燃える","もえる"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["わたし"],["について"],["真実","しんじつ"],["を"],["語らず","かたら
[{"verse":1,"text":"シュアハ人ビルダデが答えて言った。","tok":[["シュアハ"],["人","にん"],["ビルダデ"],["が"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":2,"text":"主権と恐れとは神のもの。／神はその高き所で平和をつくる。","tok":[["主権","しゅけん"],["と"],["恐れ","おそれ"],["と"],["は"],["神","かみ"],["の"],["もの"],["。"],["／"],["神","かみ"],["は"],["その"],["高き","たかき"],["所","ところ"],["で"],["平和","へいわ"],["を"],["つくる"],["。"]]},{"verse":3,"text":"その軍勢の数ほどのものがほかにあろうか。／その光に照らされないものがだれかいようか。","tok":[["その"],["軍勢","ぐんぜい"],["の"],["数","かず"],["ほど"],["の"],["もの"],["が"],["ほか"],["に"],["あろう"],["か"],["。"],["／"],["その"],["光","ひかり"],["に"],["照らされない","てらされない"],["もの"],["が"],["だれ"],["か"],["いよう"],["か"],["。"]]},{"verse":4,"text":"人はどうして神の前に正しくありえようか。／女から生まれた者が、どうしてきよくありえようか。","tok":[["人","ひと"],["は"],["どう"],["して"],["神","かみ"],["の"],["前","まえ"],["に"],["正しく","ただしく"],["あり"],["えよう"],["か"],["。"],["／"],["女","おんな"],["から"],["生まれた","うまれた"],["者","もの"],["が"],["、"],["どう"],["して"],["きよく"],["あり"],["えよう"],["か"],["。"]]},{"verse":5,"text":"ああ、神の目には／月さえも輝きがなく、星もきよくない。","tok":[["ああ"],["、"],["神","かみ"],["の"],["目","め"],["に"],["は"],["／"],["月","つき"],["さえ"],["も"],["輝き","かがやき"],["が"],["なく"],["、"],["星","ほし"],["も"],["きよく"],["ない"],["。"]]},{"verse":6,"text":"ましてうじである人間、虫けらの人の子はなおさらである。","tok":[["まして"],["うじ"],["で"],["ある"],["人間","にんげん"],["、"],["虫けら","むしけら"],["の"],["人","ひと"],["の"],["子","こ"],["は"],["なおさら"],["で"],["ある"],["。"]]}]
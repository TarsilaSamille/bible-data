[{"verse":1,"text":"ヨブはまた、自分の格言を取り上げて言った。","tok":[["ヨブ"],["は"],["また"],["、"],["自分","じぶん"],["の"],["格言","かくげん"],["を"],["取り上げて","とりあげて"],["言った","いった"],["。"]]},{"verse":2,"text":"ああ、できれば、私は、昔の月日のようであったらよいのに。／神が私を守ってくださった／日々のようであったらよいのに。","tok":[["ああ"],["、"],["できれば"],["、"],["私","わたくし"],["は"],["、"],["昔","むかし"],["の"],["月日","つきひ"],["の"],["よう"],["で"],["あったら"],["よい"],["のに"],["。"],["／"],["神","かみ"],["が"],["私","わたくし"],["を"],["守って","まもって"],["くださった"],["／"],["日々","ひび"],["の"],["よう"],["で"],["あったら"],["よい"],["のに"],["。"]]},{"verse":3,"text":"あのとき、神のともしびが私の頭を照らし、その光によって私はやみを歩いた。","tok":[["あの"],["とき"],["、"],["神","かみ"],["の"],["ともしび"],["が"],["私","わたくし"],["の"],["頭","あたま"],["を"],["照らし","てらし"],["、"],["その"],["光","ひかり"],["によって"],["私","わたくし"],["は"],["やみ"],["を"],["歩いた","あるいた"],["。"]]},{"verse":4,"text":"私がまだ壮年であったころ、神は天幕の私に語りかけてくださった。","tok":[["私","わたくし"],["が"],["まだ"],["壮年","そうねん"],["で"],["あった"],["ころ"],["、"],["神","かみ"],["は"],["天幕","てんまく"],["の"],["私","わたくし"],["に"],["語りかけて","かたりかけて"],["くださった"],["。"]]},{"verse":5,"text":"全能者がまだ私とともにおられたとき、私の子どもたちは、私の回りにいた。","tok":[["全能者","ぜんのうしゃ"],["が"],["まだ"],["私","わたくし"],["と"],["とも"],["に"],["おられた"],["とき"],["、"],["私","わたくし"],["の"],["子ども","こども"],["たち"],["は"],["、"],["私","わたくし"],["の"],["回り","まわり"],["に"],["いた"],["。"]]},{"verse":6,"text":"あのとき、私の足跡は乳で洗われ、岩は私に油の流れを注ぎ出してくれたのに。","tok":[["あの"],["とき"],["、"],["私","わたくし"],["の"],["足跡","あしあと"],["は"],["乳","ちち"],["で"],["洗われ","あらわれ"],["、"],["岩","いわ"],["は"],["私","わたくし"],["に"],["油","あぶら"],["の"],["流れ","ながれ"],["を"],["注ぎ","そそぎ"],["出して","だして"],["くれた"],["のに"],["。"]]},{"verse":7,"text":"私は町の門に出て行き、私のすわる所を広場に設けた。","tok":[["私","わたくし"],["は"],["町","まち"],["の"],["門","もん"],["に"],["出て","でて"],["行き","いき"],["、"],["私","わたくし"],["の"],["すわる"],["所","ところ"],["を"],["広場","ひろば"],["に"],["設けた","もうけた"],["。"]]},{"verse":8,"text":"若者たちは私を見て身をひき、年老いた者も起き上がって立った。","tok":[["若者","わかもの"],["たち"],["は"],["私","わたくし"],["を"],["見て","みて"],["身","み"],["を"],["ひき"],["、"],["年老いた","としおいた"],["者","もの"],["も"],["起き上がって","おきあがって"],["立った","たった"],["。"]]},{"verse":9,"text":"つかさたちは黙ってしまい、手を口に当て
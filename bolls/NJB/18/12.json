[{"verse":1,"text":"そこでヨブが答えて言った。","tok":[["そこ"],["で"],["ヨブ"],["が"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":2,"text":"確かにあなたがたは人だ。／あなたがたが死ぬと、知恵も共に死ぬ。","tok":[["確か","たしか"],["に"],["あなた"],["がた"],["は"],["人","ひと"],["だ"],["。"],["／"],["あなた"],["がた"],["が"],["死ぬ","しぬ"],["と"],["、"],["知恵","ちえ"],["も"],["共","とも"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":3,"text":"私にも、あなたがたと同様に、悟りがある。／私はあなたがたに劣らない。／だれかこれくらいのことを／知らない者があろうか。","tok":[["私","わたくし"],["に"],["も"],["、"],["あなた"],["がた"],["と"],["同様","どうよう"],["に"],["、"],["悟り","さとり"],["が"],["ある"],["。"],["／"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["劣らない","おとらない"],["。"],["／"],["だれ"],["か"],["これ"],["くらい"],["の"],["こと"],["を"],["／"],["知らない","しらない"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":4,"text":"私は、神を呼び、神が答えてくださった者であるのに、私は自分の友の物笑いとなっている。／潔白で正しい者が物笑いとなっている。","tok":[["私","わたくし"],["は"],["、"],["神","かみ"],["を"],["呼び","よび"],["、"],["神","かみ"],["が"],["答えて","こたえて"],["くださった"],["者","もの"],["で"],["ある"],["のに"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["友","とも"],["の"],["物笑い","ものわらい"],["と"],["なって"],["いる"],["。"],["／"],["潔白","けっぱく"],["で"],["正しい","ただしい"],["者","もの"],["が"],["物笑い","ものわらい"],["と"],["なって"],["いる"],["。"]]},{"verse":5,"text":"安らかだと思っている者は／衰えている者をさげすみ、足のよろめく者を押し倒す。","tok":[["安らか","やすらか"],["だ"],["と"],["思って","おもって"],["いる"],["者","もの"],["は"],["／"],["衰えて","おとろえて"],["いる"],["者","もの"],["を"],["さげすみ"],["、"],["足","あし"],["の"],["よろめく"],["者","もの"],["を"],["押し倒す","おしたおす"],["。"]]},{"verse":6,"text":"荒らす者の天幕は栄え、神を怒らせる者は安らかである。／神がご自分の手でそうさせる者は。","tok":[["荒らす","あらす"],["者","もの"],["の"],["天幕","てんまく"],["は"],["栄え","さかえ"],["、"],["神","かみ"],["を"],["怒らせる","おこらせる"],["者","もの"],["は"],["安らか","やすらか"],["で"],["ある"],["。"],["／"],["神","かみ"],["が"],["ご自分","ごじぶん"],["の"],["手","て"],["で"],["そう"],["させる"],["者","もの"],["は"],["。"]]},{"verse":7,"text":"しかし、獣に尋ねてみよ。／それがあなたに教えるだろう。／空の鳥に尋ねてみよ。／それがあなたに告げるだろう。","tok":[["しかし"],["、"],["獣","けもの"],["に"],["尋ねて","たずねて"],["み"],["よ"],["。"],["／"],["それ"],["が"],["あなた"],["に"],["教えるだろう","おしえるだろう"],["。"],["／"],["空","そら"],["の"],["鳥","とり"],["に"],["尋ねて","たずねて"],["み"],["よ"],["。"],["／"],["それ"],["が"],["あなた"],["に"],["告げるだろう","つげるだろう"],["。"]]},{"verse":8,"text":"あるいは地に話しかけよ。／それがあなたに教えるだろう。／海の魚もあなたに語るだろう。","tok":[["あるいは"],["地","ち"],["に"],["話しかけ","はなしかけ"],["よ"],["。"],["／"],["それ"],["が"],["あなた"],["に"],["教えるだろう","おしえるだろう"],["。"],["／"],["海","うみ"],["の"],["魚","さかな"],["も"],["あなた"],["に"],["語るだろう","かたるだろう"],["。"]]},{"verse":9,"text":"これらすべてのもののうち、主の御手がこれをなさったことを、知らないものがあろうか。","tok":[["これ"],["ら"],["すべて"],["の"],["もの"],["の"],["うち"],["、"],["主","ぬし"],["の"],["御手","おて"],["が"],["これ"],["を"],["なさった"],["こと"],["を"],["、"],["知らない","しらない"],["もの"],["が"],["あろう"],["か"],["。"]]},{"verse":10,"text":"すべての生き物のいのちと、すべての人間の息とは、その御手のうちにある。","tok":[["すべて"],["の"],["生き物","いきもの"],["の"],["いのち"],["と"],["、"],["すべて"],["の"],["人間","にんげん"],["の"],["息","いき"],["と"],["は"],["、"],["その"],["御手","おて"],["の"],["うち"],["に"],["ある"],["。"]]},{"verse":11,"text":"口が食物の味を知るように、耳はことばを聞き分けないだろうか。","tok":[["口","くち"],["が"],["食物","しょくもつ"],["の"],["味","あじ"],["を"],["知る","しる"],["よう"],["に"],["、"],["耳","みみ"],["は"],["ことば"],["を"],["聞き分けないだろう","ききわけないだろう"],["か"],["。"]]},{"verse":12,"text":"老いた者に知恵があり、年のたけた者に英知があるのか。","tok":[["老いた","おいた"],["者","もの"],["に"],["知恵","ちえ"],["が"],["あり"],["、"],["年","ねん"],["の"],["たけた"],["者","もの"],["に"],["英知","えいち"],["が"],["ある"],["の"],["か"],["。"]]},{"verse":13,"text":"知恵と力とは神とともにあり、思慮と英知も神のものだ。","tok":[["知恵","ちえ"],["と"],["力","ちから"],["と"],["は"],["神","かみ"],["と"],["とも"],["に"],["あり"],["、"],["思慮","しりょ"],["と"],["英知","えいち"],["も"],["神","かみ"],["の"],["もの"],["だ"],["。"]]},{"verse":14,"text":"見よ。神が打ちこわすと、それは二度と建て直せない。／人を閉じ込めると、それはあけられない。","tok":[["見","み"],["よ"],["。"],["神","かみ"],["が"],["打ちこわす","うちこわす"],["と"],["、"],["それ"],["は"],["二","に"],["度","ど"],["と"],["建て直せない","たてなおせない"],["。"],["／"],["人","ひと"],["を"],["閉じ込める","とじこめる"],["と"],["、"],["それ"],["は"],["あけられない"],["。"]]},{"verse":15,"text":"見よ。神が水を引き止めると、それはかれ、水を送ると、地をくつがえす。","tok":[["見","み"],["よ"],["。"],["神","かみ"],["が"],["水","みず"],["を"],["引き止める","ひきとめる"],["と"],["、"],["それ"],["は"],["かれ"],["、"],["水","みず"],["を"],["送る","おくる"],["と"],["、"],["地","ち"],["を"],["くつがえす"],["。"]]}
[{"verse":1,"text":"まことに、銀には鉱山があり、金には精錬する所がある。","tok":[["まこと"],["に"],["、"],["銀","ぎん"],["に"],["は"],["鉱山","こうざん"],["が"],["あり"],["、"],["金","きん"],["に"],["は"],["精錬","せいれん"],["する"],["所","ところ"],["が"],["ある"],["。"]]},{"verse":2,"text":"鉄は土から取られ、銅は石を溶かして取る。","tok":[["鉄","てつ"],["は"],["土","つち"],["から"],["取られ","とられ"],["、"],["銅","どう"],["は"],["石","いし"],["を"],["溶かして","とかして"],["取る","とる"],["。"]]},{"verse":3,"text":"人はやみを目当てとし、その隅々にまで行って、暗やみと暗黒の石を捜し出す。","tok":[["人","ひと"],["は"],["やみ"],["を"],["目当て","めあて"],["と"],["し"],["、"],["その"],["隅々","すみずみ"],["に"],["まで"],["行って","いって"],["、"],["暗やみ","くらやみ"],["と"],["暗黒","あんこく"],["の"],["石","いし"],["を"],["捜し出す","さがしだす"],["。"]]},{"verse":4,"text":"彼は、人里離れた所に、縦坑を掘り込み、行きかう人に忘れられ、人から離れてそこにぶら下がり、揺れ動く。","tok":[["彼","かれ"],["は"],["、"],["人里","ひとざと"],["離れた","はなれた"],["所","ところ"],["に"],["、"],["縦坑","たてこう"],["を"],["掘り込み","ほりこみ"],["、"],["行きかう","ゆきかう"],["人","ひと"],["に"],["忘れられ","わすれられ"],["、"],["人","ひと"],["から"],["離れて","はなれて"],["そこ"],["に"],["ぶら下がり","ぶらさがり"],["、"],["揺れ動く","ゆれうごく"],["。"]]},{"verse":5,"text":"地そのものは、そこから食物を出すが、その下は火のように沸き返っている。","tok":[["地","ち"],["その"],["もの"],["は"],["、"],["そこ"],["から"],["食物","しょくもつ"],["を"],["出す","だす"],["が"],["、"],["その"],["下","した"],["は"],["火","ひ"],["の"],["よう"],["に"],["沸き返って","わきかえって"],["いる"],["。"]]},{"verse":6,"text":"その石はサファイヤの出るもと、そのちりには金がある。","tok":[["その"],["石","いし"],["は"],["サファイヤ"],["の"],["出る","でる"],["もと"],["、"],["その"],["ちり"],["に"],["は"],["金","きん"],["が"],["ある"],["。"]]},{"verse":7,"text":"その通り道は猛禽も知らず、はやぶさの目もこれをねらったことがない。","tok":[["その"],["通り道","とおりみち"],["は"],["猛禽","もうきん"],["も"],["知らず","しらず"],["、"],["はやぶさ"],["の"],["目","め"],["も"],["これ"],["を"],["ねらった"],["こと"],["が"],["ない"],["。"]]},{"verse":8,"text":"誇り高い獣もこれを踏まず、たける獅子もここを通ったことがない。","tok":[["誇り","ほこり"],["高い","たかい"],["獣","けもの"],["も"],["これ"],["を"],["踏まず","ふまず"],["、"],["たける"],["獅子","しし"],["も"],["ここ"],["を"],["通った","とおった"],["こと"],["が"],["ない"],["。"]]},{"verse":9,"text":"彼は堅い岩に手を加え、山々をその基からくつがえす。","tok":[["彼","かれ"],["は"],["堅い","かたい"],["岩","いわ"],["に"],["手","て"],["を"],["加え","くわえ"],["、"],["山々","やまやま"],["を"],["そ
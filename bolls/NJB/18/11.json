[{"verse":1,"text":"ナアマ人ツォファルが答えて言った。","tok":[["ナアマ人","なあまにん"],["ツォファル"],["が"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":2,"text":"ことば数が多ければ、言い返しがないであろうか。／舌の人が義とされるのだろうか。","tok":[["ことば"],["数","すう"],["が"],["多ければ","おおければ"],["、"],["言い返し","いいかえし"],["が"],["ないで"],["あろう"],["か"],["。"],["／"],["舌","した"],["の"],["人","ひと"],["が"],["義","ぎ"],["と"],["される"],["の"],["だろう"],["か"],["。"]]},{"verse":3,"text":"あなたのおしゃべりは人を黙らせる。／あなたはあざけるが、だれもあなたを恥じさせる者がない。","tok":[["あなた"],["の"],["おしゃべり"],["は"],["人","ひと"],["を"],["黙らせる","だまらせる"],["。"],["／"],["あなた"],["は"],["あざける"],["が"],["、"],["だれ"],["も"],["あなた"],["を"],["恥じさせる","はじさせる"],["者","もの"],["が"],["ない"],["。"]]},{"verse":4,"text":"あなたは言う。／「私の主張は純粋だ。／あなたの目にも、きよい」と。","tok":[["あなた"],["は"],["言う","ゆう"],["。"],["／"],["「"],["私","わたくし"],["の"],["主張","しゅちょう"],["は"],["純粋","じゅんすい"],["だ"],["。"],["／"],["あなた"],["の"],["目","め"],["に"],["も"],["、"],["きよい"],["」"],["と"],["。"]]},{"verse":5,"text":"ああ、神がもし語りかけ、あなたに向かって／くちびるを開いてくださったなら、","tok":[["ああ"],["、"],["神","かみ"],["が"],["もし"],["語りかけ","かたりかけ"],["、"],["あなた"],["に"],["向かって","むかって"],["／"],["くちびる"],["を"],["開いて","ひらいて"],["くださったなら"],["、"]]},{"verse":6,"text":"神は知恵の奥義をあなたに告げ、すぐれた知性を倍にしてくださるものを。／知れ。神はあなたのために、あなたの罪を忘れてくださることを。","tok":[["神","かみ"],["は"],["知恵","ちえ"],["の"],["奥義","おうぎ"],["を"],["あなた"],["に"],["告げ","つげ"],["、"],["すぐれた"],["知性","ちせい"],["を"],["倍","ばい"],["に"],["して"],["くださる"],["もの"],["を"],["。"],["／"],["知れ","しれ"],["。"],["神","かみ"],["は"],["あなた"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["罪","つみ"],["を"],["忘れて","わすれて"],["くださる"],["こと"],["を"],["。"]]},{"verse":7,"text":"あなたは神の深さを見抜くことができようか。／全能者の極限を見つけることができようか。","tok":[["あなた"],["は"],["神","かみ"],["の"],["深さ","ふかさ"],["を"],["見抜く","みぬく"],["こと"],["が"],["できよう"],["か"],["。"],["／"],["全能者","ぜんのうしゃ"],["の"],["極限","きょくげん"],["を"],["見つける","みつける"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":8,"text":"それは天よりも高い。あなたに何ができよう。／それはよみよりも深い。あなたが何を知りえよう。","tok":[["それ"],["は"],["天","てん"],["より"],["も"],["高い","たかい"],["。"],["あなた"],["に"],["何","なん"],["が"],["できよう"],["。"],["／"],["それ"],["は"],["よみ"],["より"],["も"],["深い","ぶかい"],["。"],["あなた"],["が"],["何","なん"],["を"],["知り","しり"],["えよう"],["。"]]},{"verse":9,"text":"それを計れば、地よりも長く、海よりも広い。","tok":[["それ"],["を"],["計れば","はかれば"],["、"],["地","ち"],["より"],["も"],["長く","ながく"],["、"],["海","うみ"],["より"],["も"],["広い","ひろい"],["。"]]},{"verse":10,"text":"もし、神が通り過ぎ、あるいは閉じ込め、あるいは呼び集めるなら、だれがそれを引き止めえようか。","tok":[["もし"],["、"],["神","かみ"],["が"],["通り過ぎ","とおりすぎ"],["、"],["あるいは"],["閉じ込め","とじこめ"],["、"],["あるいは"],["呼び集めるなら","よびあつめるなら"],["、"],["だれ"],["が"],["それ"],["を"],["引き止め","ひきとめ"],["えよう"],["か"],["。"]]},{"verse":11,"text":"神は不信実な者どもを知っておられる。／神はその悪意を見て、これに気がつかないであろうか。","tok":[["神","かみ"],["は"],["不","ふ"],["信実","しんじつ"],["な"],["者","もの"],["ども"],["を"],["知って","しって"],["おられる"],["。"],["／"],["神","かみ"],["は"],["その"],["悪意","あくい"],["を"],["見て","みて"],["、"],["これ"],["に"],["気","き"],["が"],["つかないで"],["あろう"],["か"],["。"]]},{"verse":12,"text":"無知な人間も賢くなり、野ろばの子も、人として生まれる。","tok":[["無知","むち"],["な"],["人間","にんげん"],["も"],["賢く","かしこく"],["なり"],["、"],["野","の"],["ろば"],["の"],["子","こ"],["も"],["、"],["人","ひと"],["として"],["生まれる","うまれる"],["。"]]},{"verse":13,"text":"もし、あなたが心を定め、あなたの手を神に向かって差し伸べるなら、","tok":[["もし"],["、"],["あなた"],["が"],["心","こころ"],["を"],["定め","さだめ"],["、"],["あなた"],["の"],["手","て"],["を"],["神","かみ"],["に"],["向かって","むかって"],["差し伸べるなら","さしのべるなら"],["、"]]},{"verse":14,"text":"――あなたの手に悪があれば、それを捨て、あなたの天幕に不正を住まわせるな――","tok":[["―"],["―"],["あなた"],["の"],["手","て"],["に"],["悪","あく"],["が"],["あれば"],["、"],["それ"],["を"],["捨て","すて"],["、"],["あなた"],["の"],["天幕","てんまく"],["に"],["不正","ふせい"],["を"],["住まわせる","すまわせる"],["な"],["―"],["―"]]},{"verse":15,"text":"そうすれば、あなたは必ず、汚れのないあなたの顔を上げることができ、堅く立って恐れることがない。","tok":[["そう"],["すれば"],["、"],["あなた"],["は"],["必ず","かならず"],["、"],["汚れ","よごれ"],["の"],["ない"],["あなた"],["の"],["顔","かお"],["を"],["上げる","あげる"],["こと"],["が"],["でき"],["、"],["堅く","かたく"],["立って","たって"],["恐れる","おそれる"],["こと"],["が"],["ない"],["。"]]},{"verse":16,"text":"こうしてあなたは労苦を忘れ、流れ去った水のように、これを思い出そう。","tok":[["こう"],["して"],["あなた"],["は"],["労苦","ろうく"],["を"],["忘れ","わすれ"],["、"],["流れ去った","ながれさった"],["水","みず"],["の"],["よう"],["に"],["、"],["これ"],["を"],["思い出そう","おもいだそう"],
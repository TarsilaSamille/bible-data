[{"verse":1,"text":"ある日のこと、神の子らが主の前に来て立ったとき、サタンもいっしょに来て、主の前に立った。","tok":[["ある"],["日","ひ"],["の"],["こと"],["、"],["神","かみ"],["の"],["子","こ"],["ら"],["が"],["主","ぬし"],["の"],["前","まえ"],["に"],["来て","きて"],["立った","たった"],["とき"],["、"],["サタン"],["も"],["いっしょ"],["に"],["来て","きて"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":2,"text":"主はサタンに仰せられた。「おまえはどこから来たのか。」サタンは主に答えて言った。「地を行き巡り、そこを歩き回って来ました。」","tok":[["主","ぬし"],["は"],["サタン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["おまえ"],["は"],["どこ"],["から"],["来た","きた"],["の"],["か"],["。"],["」"],["サタン"],["は"],["主に","おもに"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["地","ち"],["を"],["行き","いき"],["巡り","めぐり"],["、"],["そこ"],["を"],["歩き回って","あるきまわって"],["来ました","きました"],["。"],["」"]]},{"verse":3,"text":"主はサタンに仰せられた。「おまえはわたしのしもべヨブに心を留めたか。彼のように潔白で正しく、神を恐れ、悪から遠ざかっている者はひとりも地上にはいない。彼はなお、自分の誠実を堅く保っている。おまえは、わたしをそそのかして、何の理由もないのに彼を滅ぼそうとしたが。」","tok":[["主","ぬし"],["は"],["サタン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["おまえ"],["は"],["わたし"],["の"],["しもべ"],["ヨブ"],["に"],["心","こころ"],["を"],["留めた","とめた"],["か"],["。"],["彼","かれ"],["の"],["よう"],["に"],["潔白","けっぱく"],["で"],["正しく","ただしく"],["、"],["神","かみ"],["を"],["恐れ","おそれ"],["、"],["悪","わる"],["から"],["遠ざかって","とおざかって"],["いる"],["者","もの"],["は"],["ひとり"],["も"],["地上","ちじょう"],["に"],["は"],["いない"],["。"],["彼","かれ"],["は"],["なお"],["、"],["自分","じぶん"],["の"],["誠実","せいじつ"],["を"],["堅く","かたく"],["保って","たもって"],["いる"],["。"],["おまえ"],["は"],["、"],["わたし"],["を"],["そそのかして"],["、"],["何","なん"],["の"],["理由","りゆう"],["も"],["ない"],["のに"],["彼","かれ"],["を"],["滅ぼそう","ほろぼそう"],["と"],["した"],["が"],["。"],["」"]]},{"verse":4,"text":"サタンは主に答えて言った。「皮の代わりには皮をもってします。人は自分のいのちの代わりには、すべての持ち物を与えるものです。","tok":[["サタン"],["は"],["主に","おもに"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["皮","かわ"],["の"],["代わり","かわり"],["に"],["は"],["皮","かわ"],["を"],["もって"],["します"],["。"],["人","ひと"],["は"],["自分","じぶん"],["の"],["いのち"],["の"],["代わり","かわり"],["に"],["は"],["、"],["すべて"],["の"],["持ち物","もちもの"],["を"],["与える","あたえる"],["もの"],["です"],["。"]]},{"verse":5,"text":"しかし、今あなたの手を伸べ、彼の骨と肉とを打ってください。彼はきっと、あなたをのろうに違いありません。」","tok":[["しかし"],["、"],["今","いま"],["あなた"],["の"],["手","て"],["を"],["伸べ","のべ"],["、"],["彼","かれ"],["の"],["骨","ほね"],["と"],["肉","にく"],["と"],["を"],["打って","うって"],["ください"],["。"],["彼","かれ"],["は"],["きっと"],["、"],["あなた"],["を"],["のろう"],["に"],["違い","ちがい"],["ありません"],["。"],["」"]]},{"verse":6,"text":"主はサタンに仰せられた。「では、彼をおまえの手に任せる。ただ彼のいのちには触れるな。」","tok":[["主","ぬし"],["は"],["サタン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["で"],["は"],["、"],["彼","かれ"],["を"],["おまえ"],["の"],["手","て"],["に"],["任せる","まかせる"],["。"],["ただ"],["彼","かれ"],["の"],["いのち"],["に"],["は"],["触れる","ふれる"],["な"],["。"],["」"]]},{"verse":7,"text":"サタンは主の前から出て行き、ヨブの足の裏から頭の頂まで、悪性の腫物で彼を打った。","tok":[["サタン"],["は"],["主","ぬし"],["の"],["前","まえ"],["から"],["出て","でて"],["行き","いき"],["、"],["ヨブ"],["の"],["足","あし"],["の"],["裏","うら"],["から"],["頭","あたま"],["の"],["頂","いただき"],["まで"],["、"],["悪性","あくせい"],["の"],["腫物","はれもの"],["で"],["彼","かれ"],["を"],["打った","うった"],["。"]]},{"verse":8,"text":"ヨブは土器のかけらを取って自分の身をかき、また灰の中にすわった。","tok":[["ヨブ"],["は"],["土器","かわらけ"],["の"],["かけら"],["を"],["取って","とって"],["自分","じぶん"],["の"],["身","み"],["を"],["かき"],["、"],["また"],["灰","はい"],["の"],["中","なか"],["に"],["すわった"],["。"]]},{"verse":9,"text":"すると彼の妻が彼に言った。「それでもなお、あなたは自分の誠実を堅く保つのですか。神をのろって死になさい。」","tok":[["する"],["と"],["彼","かれ"],["の"],["妻","つま"],["が"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["それ"],["で"],["も"],["なお"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["誠実","せいじつ"],["を"],["堅く","かたく"],["保つ","たもつ"],["の"],["です"],["か"],["。"],["神","かみ"],["を"],["のろって"],["死に","しに"],["なさい"],["。"],["」"]]},{"verse":10,"text":"しかし、彼は彼女に言った。「あなたは愚かな女が言うようなことを言っている。私たちは幸いを神から受けるのだから、わざわいをも受けなければならないではないか。」ヨブはこのようになっても、罪を犯すようなことを口にしなかった。","tok":[["しかし"],["、"],["彼","かれ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["愚か","おろか"],["な"],["女","おんな"],["が"],["言う","いう"],["よう"],["な"],["こと"],["を"],["言って","いって"],["いる"],["。"],["私たち","わたしたち"],["は"],["幸い","さいわい"],["を"],["神","かみ"],["から"],["受ける","うける"],["の"],["だ"],["から"],["、"],["わざわい"],["を"],["も"],["受けなければ","うけなければ"],["ならないで"],["は"],["ない"],["か"],["。"],["」"],["ヨブ"],["は"],["この"],["よう"],["に"],["なって"],["も"],["、"],["罪","つみ"],["を"],["犯す","おかす"],["よう"],["な"],["こと"],["を"],["口","くち"],["に"],["しなかった"],["。"]]},{"verse":11,"text":"そのうちに、ヨブの三人の友は、ヨブに降りかかったこのすべてのわざわいのことを聞き、それぞれ自分の所からたずねて来た。すなわち、テマン人エリファズ、シュアハ人ビルダデ、ナアマ人ツォファルである。彼らはヨブに悔やみを言って慰めようと互いに打ち合わせて来た。","tok":[["その"],["うち"],["に"],["、"],["ヨブ"],["の"],["三人","さんにん"],["の"],["友","とも"],["は"],["、"],["ヨブ"],["に"],["降りかかった","ふりかかった"],["この"],["すべて"],["の"],["わざわい"],["の"],["こと"],["を"],["聞き","きき"],["、"],["それぞれ"],["自分","じぶん"],["の"],["所","ところ"],["から"],["たずねて"],["来た","きた"],["。"],["すなわち"],["、"],["テマン人","てまんにん"],["エリファズ"],["、"],["シュアハ"],["人","にん"],["ビルダデ"],["、"],["ナアマ人","なあまにん"],["ツォファル"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["ヨブ"],["に"],["悔やみ","くやみ"],["を"],["言って","いって"],["慰めよう","なぐさめよう"],["と"],["互い","たがい"],["に"],["打ち合わせて","うちあわせて"],["来た","きた"],["。"]]},{"verse":12,"text":"彼らは遠くから目を上げて彼を見たが、それがヨブであることが見分けられないほどだった。彼らは声をあげて泣き、おのおの、自分の上着を引き裂き、ちりを天に向かって投げ、自分の頭の上にまき散らした。","tok":[["彼","かれ"],["ら"],["は"],["遠く","とおく"],["から"],["目","め"],["を"],["上げて","あげて"],["彼","かれ"],["を"],["見た","みた"],["が"],["、"],["それ"],["が"],["ヨブ"],["で"],["ある"],["こと"],["が"],["見分けられない","みわけられない"],["ほど"],["だった"],["。"],["彼","かれ"],["ら"],["は"],["声","こえ"],["を"],["あげて"],["泣き","なき"],["、"],["おのおの"],["、"],["自分","じぶん"],["の"],["上着","うわぎ"],["を"],["引き裂き","ひきさき"],["、"],["ちり"],["を"],["天","てん"],["に"],["向かって","むかって"],["投げ","なげ"],["、"],["自分","じぶん"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["まき散らした","まきちらした"],["。"]]},{"verse":13,"text":"こうして、彼らは彼とともに七日七夜、地にすわっていたが、だれも一言も彼に話しかけなかった。彼の痛みがあまりにもひどいのを見たからである。","tok":[["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["と"],["とも"],["に"],["七","しち"],["日","にち"],["七夜","しちや"],["、"],["地","ち"],["に"],["すわって"],["いた"],["が"],["、"],["だれ"],["も"],["一言","ひとこと"],["も"],["彼","かれ"],["に"],["話しかけなかった","はなしかけなかった"],["。"],["彼","かれ"],["の"],["痛み","いたみ"],["が"],["あまり"],["に"],["も"],["ひどい"],["の"],["を"],["見た","みた"],["から"],["で"],["ある"],["。"]]}]
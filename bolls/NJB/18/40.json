[{"verse":1,"text":"主はさらに、ヨブに答えて仰せられた。","tok":[["主","ぬし"],["は"],["さらに"],["、"],["ヨブ"],["に"],["答えて","こたえて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"非難する者が全能者と争おうとするのか。／神を責める者は、それを言いたててみよ。","tok":[["非難","ひなん"],["する"],["者","もの"],["が"],["全能者","ぜんのうしゃ"],["と"],["争おう","あらそおう"],["と"],["する"],["の"],["か"],["。"],["／"],["神","かみ"],["を"],["責める","せめる"],["者","もの"],["は"],["、"],["それ"],["を"],["言いたてて","いいたてて"],["み"],["よ"],["。"]]},{"verse":3,"text":"ヨブは主に答えて言った。","tok":[["ヨブ"],["は"],["主に","おもに"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":4,"text":"ああ、私はつまらない者です。／あなたに何と口答えできましょう。／私はただ手を口に当てるばかりです。","tok":[["ああ"],["、"],["私","わたくし"],["は"],["つまらない"],["者","もの"],["です"],["。"],["／"],["あなた"],["に"],["何","なん"],["と"],["口答え","くちごたえ"],["できましょう"],["。"],["／"],["私","わたくし"],["は"],["ただ"],["手","て"],["を"],["口","くち"],["に"],["当てる","あてる"],["ばかり"],["です"],["。"]]},{"verse":5,"text":"一度、私は語りましたが、もう口答えしません。／二度と、私はくり返しません。","tok":[["一度","いちど"],["、"],["私","わたくし"],["は"],["語りました","かたりました"],["が"],["、"],["もう"],["口答え","くちごたえ"],["しません"],["。"],["／"],["二","に"],["度","ど"],["と"],["、"],["私","わたくし"],["は"],["くり返しません","くりかえしません"],["。"]]},{"verse":6,"text":"主はあらしの中からヨブに答えて仰せられた。","tok":[["主","ぬし"],["は"],["あらし"],["の"],["中","なか"],["から"],["ヨブ"],["に"],["答えて","こたえて"],["仰せられた","おおせられた"],["。"]]},{"verse":7,"text":"さあ、あなたは勇士のように腰に帯を締めよ。／わたしはあなたに尋ねる。わたしに示せ。","tok":[["さあ"],["、"],["あなた"],["は"],["勇士","ゆうし"],["の"],["よう"],["に"],["腰","こし"],["に"],["帯","おび"],["を"],["締めよ","しめよ"],["。"],["／"],["わたし"],["は"],["あなた"],["に"],["尋ねる","たずねる"],["。"],["わたし"],["に"],["示せ","しめせ"],["。"]]},{"verse":8,"text":"あなたはわたしのさばきを無効にするつもりか。／自分を義とするために、わたしを罪に定めるのか。","tok":[["あなた"],["は"],["わたし"],["の"],["さばき"],["を"],["無効","むこう"],["に"],["する"],["つもり"],["か"],["。"],["／"],["自分","じぶん"],["を"],["義","ぎ"],["と"],["する"],["ため"],["に"],["、"],["わたし"],["を"],["罪","つみ"],["に"],["定める","さだめる"],["の"],["か"],["。"]]},{"verse":9,"text":"あなたには神のような腕があるのか。／神のような声で雷鳴をとどろき渡らせるのか。","tok":[["あなた"],["に"],["は"],["神","かみ"],["の"],["よう"],["な"],["腕","うで"],["が"],["ある"],["の"],["か"],["。"],["／"],["神","かみ"],["の"],["
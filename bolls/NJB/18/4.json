[{"verse":1,"text":"すると、テマン人エリファズが話しかけて言った。","tok":[["する"],["と"],["、"],["テマン人","てまんにん"],["エリファズ"],["が"],["話しかけて","はなしかけて"],["言った","いった"],["。"]]},{"verse":2,"text":"もし、だれかがあなたにあえて語りかけたら、あなたはそれに耐えられようか。／しかし、だれが黙っておられよう。","tok":[["もし"],["、"],["だれ"],["か"],["が"],["あなた"],["に"],["あえて"],["語りかけたら","かたりかけたら"],["、"],["あなた"],["は"],["それ"],["に"],["耐えられよう","たえられよう"],["か"],["。"],["／"],["しかし"],["、"],["だれ"],["が"],["黙って","だまって"],["おられよう"],["。"]]},{"verse":3,"text":"見よ。あなたは多くの人を訓戒し、弱った手を力づけた。","tok":[["見","み"],["よ"],["。"],["あなた"],["は"],["多く","おおく"],["の"],["人","ひと"],["を"],["訓戒","くんかい"],["し"],["、"],["弱った","よわった"],["手","て"],["を"],["力づけた","ちからづけた"],["。"]]},{"verse":4,"text":"あなたのことばはつまずく者を起こし、くずおれるひざをしっかり立たせた。","tok":[["あなた"],["の"],["ことば"],["は"],["つまずく"],["者","もの"],["を"],["起こし","おこし"],["、"],["くずおれる"],["ひざ"],["を"],["しっかり"],["立たせた","たたせた"],["。"]]},{"verse":5,"text":"だが、今これがあなたにふりかかると、あなたは、これに耐えられない。／これがあなたを打つと、あなたはおびえている。","tok":[["だ"],["が"],["、"],["今","いま"],["これ"],["が"],["あなた"],["に"],["ふりかかる"],["と"],["、"],["あなた"],["は"],["、"],["これ"],["に"],["耐えられない","たえられない"],["。"],["／"],["これ"],["が"],["あなた"],["を"],["打つ","うつ"],["と"],["、"],["あなた"],["は"],["おびえて"],["いる"],["。"]]},{"verse":6,"text":"あなたが神を恐れていることは／あなたの確信ではないか。／あなたの望みは／あなたの潔白な行いではないか。","tok":[["あなた"],["が"],["神","かみ"],["を"],["恐れて","おそれて"],["いる"],["こと"],["は"],["／"],["あなた"],["の"],["確信","かくしん"],["で"],["は"],["ない"],["か"],["。"],["／"],["あなた"],["の"],["望み","のぞみ"],["は"],["／"],["あなた"],["の"],["潔白","けっぱく"],["な"],["行い","おこない"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":7,"text":"さあ思い出せ。／だれか罪がないのに滅びた者があるか。／どこに正しい人で絶たれた者があるか。","tok":[["さあ"],["思い出せ","おもいだせ"],["。"],["／"],["だれ"],["か"],["罪","つみ"],["が"],["ない"],["のに"],["滅びた","ほろびた"],["者","もの"],["が"],["ある"],["か"],["。"],["／"],["どこ"],["に"],["正しい","ただしい"],["人","ひと"],["で"],["絶たれた","たたれた"],["者","もの"],["が"],["ある"],["か"],["。"]]},{"verse":8,"text":"私の見るところでは、不幸を耕し、害毒を蒔く者が、それを刈り取るのだ。","tok":[["私","わたくし"],["の"],["見る","みる"],["ところ"],["で"],["は"],["、"],["不幸","ふこう"],["を"],["耕し","たがやし"],["、"],["害毒","がいどく"],["を"],["蒔く","まく"],["者","もの"],["が"
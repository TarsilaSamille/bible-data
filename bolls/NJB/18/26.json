[{"verse":1,"text":"ヨブは答えて言った。","tok":[["ヨブ"],["は"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":2,"text":"あなたは無力な者をどのようにして助けたのか。／力のない腕をどのようにして救ったのか。","tok":[["あなた"],["は"],["無力","むりょく"],["な"],["者","もの"],["を"],["どの"],["よう"],["に"],["して"],["助けた","たすけた"],["の"],["か"],["。"],["／"],["力","ちから"],["の"],["ない"],["腕","うで"],["を"],["どの"],["よう"],["に"],["して"],["救った","すくった"],["の"],["か"],["。"]]},{"verse":3,"text":"知恵のない者をどのようにしていさめ、豊かなすぐれた知性を示したのか。","tok":[["知恵","ちえ"],["の"],["ない"],["者","もの"],["を"],["どの"],["よう"],["に"],["して"],["いさめ"],["、"],["豊か","ゆたか"],["な"],["すぐれた"],["知性","ちせい"],["を"],["示した","しめした"],["の"],["か"],["。"]]},{"verse":4,"text":"あなたはだれに対してことばを告げているのか。／だれの息があなたから出たのか。","tok":[["あなた"],["は"],["だれ"],["に対して","にたいして"],["ことば"],["を"],["告げて","つげて"],["いる"],["の"],["か"],["。"],["／"],["だれ"],["の"],["息","いき"],["が"],["あなた"],["から"],["出た","でた"],["の"],["か"],["。"]]},{"verse":5,"text":"死者の霊は、水とそこに住むものとの下にあって震える。","tok":[["死者","ししゃ"],["の"],["霊","れい"],["は"],["、"],["水","みず"],["と"],["そこ"],["に"],["住む","すむ"],["もの"],["と"],["の"],["下","した"],["に"],["あって"],["震える","ふるえる"],["。"]]},{"verse":6,"text":"よみも神の前では裸であり、滅びの淵もおおわれない。","tok":[["よみ"],["も"],["神","かみ"],["の"],["前","まえ"],["で"],["は"],["裸","はだか"],["で"],["あり"],["、"],["滅び","ほろび"],["の"],["淵","ふち"],["も"],["おおわれない"],["。"]]},{"verse":7,"text":"神は北を虚空に張り、地を何もない上に掛けられる。","tok":[["神","かみ"],["は"],["北","きた"],["を"],["虚空","こくう"],["に"],["張り","はり"],["、"],["地","ち"],["を"],["何","なん"],["も"],["ない"],["上","うえ"],["に"],["掛けられる","かけられる"],["。"]]},{"verse":8,"text":"神は水を濃い雲の中に包まれるが、その下の雲は裂けない。","tok":[["神","かみ"],["は"],["水","みず"],["を"],["濃い","こい"],["雲","くも"],["の"],["中","なか"],["に"],["包まれる","つつまれる"],["が"],["、"],["その"],["下","した"],["の"],["雲","くも"],["は"],["裂けない","さけない"],["。"]]},{"verse":9,"text":"神は御座の面をおおい、その上に雲を広げ、","tok":[["神","かみ"],["は"],["御座","ぎょざ"],["の"],["面","めん"],["を"],["おおい"],["、"],["その"],["上","うえ"],["に"],["雲","くも"],["を"],["広げ","ひろげ"],["、"]]},{"verse":10,"text":"水の面に円を描いて、光とやみとの境とされた。","tok":[["水","みず"],["の"],["面","めん"],["に"],["円","えん"],["を"],["描いて","えがいて"],["、"],["光","ひかり"],["と"],["や
[{"verse":1,"text":"エリフはさらに続けて言った。","tok":[["エリフ"],["は"],["さらに"],["続けて","つづけて"],["言った","いった"],["。"]]},{"verse":2,"text":"あなたはこのことを正義によると思うのか。／「私の義は神からだ」とでも言うのか。","tok":[["あなた"],["は"],["この"],["こと"],["を"],["正義","せいぎ"],["に"],["よる"],["と"],["思う","おもう"],["の"],["か"],["。"],["／"],["「"],["私","わたくし"],["の"],["義","ぎ"],["は"],["神","かみ"],["から"],["だ"],["」"],["と"],["で"],["も"],["言う","いう"],["の"],["か"],["。"]]},{"verse":3,"text":"あなたは言っている。／「何があなたの役に立つのでしょうか。／私が罪を犯さないと、どんな利益がありましょうか」と。","tok":[["あなた"],["は"],["言って","いって"],["いる"],["。"],["／"],["「"],["何","なん"],["が"],["あなた"],["の"],["役","やく"],["に"],["立つ","たつ"],["の"],["でしょう"],["か"],["。"],["／"],["私","わたくし"],["が"],["罪","つみ"],["を"],["犯さない","おかさない"],["と"],["、"],["どんな"],["利益","りえき"],["が"],["ありましょう"],["か"],["」"],["と"],["。"]]},{"verse":4,"text":"私はあなたと、またあなたとともにいるあなたの友人たちに／答えて言おう。","tok":[["私","わたくし"],["は"],["あなた"],["と"],["、"],["また"],["あなた"],["と"],["とも"],["に"],["いる"],["あなた"],["の"],["友人","ゆうじん"],["たち"],["に"],["／"],["答えて","こたえて"],["言おう","いおう"],["。"]]},{"verse":5,"text":"天を仰ぎ見よ。／あなたより、はるかに高い雲を見よ。","tok":[["天","てん"],["を"],["仰ぎ見","あおぎみ"],["よ"],["。"],["／"],["あなた"],["より"],["、"],["はるか"],["に"],["高い","たかい"],["雲","くも"],["を"],["見よ","みよ"],["。"]]},{"verse":6,"text":"あなたが罪を犯しても、神に対して何ができよう。／あなたのそむきの罪が多くても、あなたは神に何をなしえようか。","tok":[["あなた"],["が"],["罪","つみ"],["を"],["犯して","おかして"],["も"],["、"],["神","かみ"],["に対して","にたいして"],["何","なん"],["が"],["できよう"],["。"],["／"],["あなた"],["の"],["そむき"],["の"],["罪","つみ"],["が"],["多くて","おおくて"],["も"],["、"],["あなた"],["は"],["神","かみ"],["に"],["何","なん"],["を"],["なし"],["えよう"],["か"],["。"]]},{"verse":7,"text":"あなたが正しくても、あなたは神に何を与ええようか。／神は、あなたの手から何を受けられるだろうか。","tok":[["あなた"],["が"],["正しくて","ただしくて"],["も"],["、"],["あなた"],["は"],["神","かみ"],["に"],["何","なん"],["を"],["与え","あたえ"],["えよう"],["か"],["。"],["／"],["神","かみ"],["は"],["、"],["あなた"],["の"],["手","て"],["から"],["何","なん"],["を"],["受けられるだろう","うけられるだろう"],["か"],["。"]]},{"verse":8,"text":"あなたの悪は、ただ、あなたのような人間に、あなたの正しさは、ただ、人の子に、かかわりを持つだけだ。","tok":[["あなた"],["の"],["悪","あく"],["は"],["、"],["ただ"],["、"],["あなた"],["の"],["よう"],["な"],["人間","にん
[{"verse":1,"text":"この三人の者はヨブに答えるのをやめた。それはヨブが自分は正しいと思っていたからである。","tok":[["この"],["三人","さんにん"],["の"],["者","もの"],["は"],["ヨブ"],["に"],["答える","こたえる"],["の"],["を"],["やめた"],["。"],["それ"],["は"],["ヨブ"],["が"],["自分","じぶん"],["は"],["正しい","ただしい"],["と"],["思って","おもって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"すると、ラム族のブズ人、バラクエルの子エリフが怒りを燃やした。彼がヨブに向かって怒りを燃やしたのは、ヨブが神よりもむしろ自分自身を義としたからである。","tok":[["する"],["と"],["、"],["ラム族","らむぞく"],["の"],["ブズ人","ぶずにん"],["、"],["バラクエル"],["の"],["子","こ"],["エリフ"],["が"],["怒り","いかり"],["を"],["燃やした","もやした"],["。"],["彼","かれ"],["が"],["ヨブ"],["に"],["向かって","むかって"],["怒り","いかり"],["を"],["燃やした","もやした"],["の"],["は"],["、"],["ヨブ"],["が"],["神","かみ"],["より"],["も"],["むしろ"],["自分","じぶん"],["自身","じしん"],["を"],["義","ぎ"],["と"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼はまた、その三人の友に向かっても怒りを燃やした。彼らがヨブを罪ある者としながら、言い返すことができなかったからである。","tok":[["彼","かれ"],["は"],["また"],["、"],["その"],["三人","さんにん"],["の"],["友","とも"],["に"],["向かって","むかって"],["も"],["怒り","いかり"],["を"],["燃やした","もやした"],["。"],["彼","かれ"],["ら"],["が"],["ヨブ"],["を"],["罪","つみ"],["ある"],["者","もの"],["と"],["し"],["ながら"],["、"],["言い返す","いいかえす"],["こと"],["が"],["できなかった"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"エリフはヨブに語りかけようと待っていた。彼らが自分よりも年長だったからである。","tok":[["エリフ"],["は"],["ヨブ"],["に"],["語りかけよう","かたりかけよう"],["と"],["待って","まって"],["いた"],["。"],["彼","かれ"],["ら"],["が"],["自分","じぶん"],["より"],["も"],["年長","ねんちょう"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"しかし、エリフは三人の者の口に答えがないのを見て、怒りを燃やした。","tok":[["しかし"],["、"],["エリフ"],["は"],["三人","さんにん"],["の"],["者","もの"],["の"],["口","くち"],["に"],["答え","こたえ"],["が"],["ない"],["の"],["を"],["見て","みて"],["、"],["怒り","いかり"],["を"],["燃やした","もやした"],["。"]]},{"verse":6,"text":"ブズ人、バラクエルの子エリフは答えて言った。／私は若く、あなたがたは年寄りだ。／だから、わきに控えて、遠慮し、あなたがたに私の意見を述べなかった。","tok":[["ブズ人","ぶずにん"],["、"],["バラクエル"],["の"],["子","こ"],["エリフ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["／"],["私","わたくし"],["は"],["若く","わかく"],["、"],["あなた"],["がた"],["は"],["年寄り","としより"],["だ"],["。"],["／"],["だ"],["から"],["、"],["わき"],["に"],["控えて","ひかえて"],["、"],["遠慮","えんりょ"],["し"],["、"],["あなた"],["がた"],["に"],["私","わたくし"],["の"],["意見","いけん"],["を"],["述べなかった","のべなかった"],["。"]]},{"verse":7,"text":"私は思った。／「日を重ねた者が語り、年の多い者が知恵を教える」と。","tok":[["私","わたくし"],["は"],["思った","おもった"],["。"],["／"],["「"],["日","ひ"],["を"],["重ねた","かさねた"],["者","もの"],["が"],["語り","かたり"],["、"],["年","ねん"],["の"],["多い","おおい"],["者","もの"],["が"],["知恵","ちえ"],["を"],["教える","おしえる"],["」"],["と"],["。"]]},{"verse":8,"text":"しかし、人の中には確かに霊がある。／全能者の息が人に悟りを与える。","tok":[["しかし"],["、"],["人","ひと"],["の"],["中","なか"],["に"],["は"],["確か","たしか"],["に"],["霊","れい"],["が"],["ある"],["。"],["／"],["全能者","ぜんのうしゃ"],["の"],["息","いき"],["が"],["人","ひと"],["に"],["悟り","さとり"],["を"],["与える","あたえる"],["。"]]},{"verse":9,"text":"年長者が知恵深いわけではない。／老人が道理をわきまえるわけでもない。","tok":[["年長者","ねんちょうしゃ"],["が"],["知恵","ちえ"],["深い","ふかい"],["わけ"],["で"],["は"],["ない"],["。"],["／"],["老人","ろうじん"],["が"],["道理","どうり"],["を"],["わきまえる"],["わけ"],["で"],["も"],["ない"],["。"]]},{"verse":10,"text":"だから、私は言う。「私の言うことを聞いてくれ。私も、また私の意見を述べよう。」","tok":[["だ"],["から"],["、"],["私","わたくし"],["は"],["言う","ゆう"],["。"],["「"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["くれ"],["。"],["私","わたくし"],["も"],["、"],["また"],["私","わたくし"],["の"],["意見","いけん"],["を"],["述べよう","のべよう"],["。"],["」"]]},{"verse":11,"text":"今まで私はあなたがたの言うことに期待し、あなたがたの言い分を調べ上げるまで、あなたがたの意見に耳を傾けていた。","tok":[["今まで","いままで"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["言う","いう"],["こと"],["に"],["期待","きたい"],["し"],["、"],["あなた"],["がた"],["の"],["言い分","いいぶん"],["を"],["調べ上げる","しらべあげる"],["まで"],["、"],["あなた"],["がた"],["の"],["意見","いけん"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["いた"],["。"]]},{"verse":12,"text":"私はあなたがたに注意を払っていたのに、ヨブに罪を認めさせる者はなく、あなたがたのうちで／彼のことばに答える者もいない。","tok":[["私","わたくし"],["は"],["あなた"],["がた"],["に"],["注意","ちゅうい"],["を"],["払って","はらって"],["いた"],["のに"],["、"],["ヨブ"],["に"],["罪","つみ"],["を"],["認めさせる","みとめさせる"],["者","もの"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["うち"],["で"],["／"],["彼","かれ"],["の"],["ことば"],["に"],["答える","こたえる"],["者","もの"],["も"],["いない"],["。"]]},{"verse":13,"text":"だが、おそらくあなたがたは言おう。／「私たちは知恵を見いだした。／人ではなく、神が彼を吹き払った」と。","tok":[["だ"],["が"],["、"],["おそらく"],["あなた"],["がた"],["は"],["言おう","いおう"],["。"],["／"],["「"],["私たち","わたしたち"],["は"],["知恵","ちえ"],["を"],["見いだした","みいだした"],["。"],["／"],["人","ひと"],["で"],["は"],["なく"],["、"],["神","かみ"],["が"],["彼","かれ"],["を"],["吹き払った","ふきはらった"],["」"],["と"],["。"]]},{"verse":14,"text":"彼はまだ私に向かって／ことばを並べたててはいない。／私はあなたがたのような言い方では／彼に答えまい。","tok":[["彼","かれ"],["は"],["まだ"],["私","わたくし"],["に"],["向かって","むかって"],["／"],["ことば"],["を"],["並べたてて","ならべたてて"],["は"],["いない"],["。"],["／"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["よう"],["な"],["言い方","いいかた"],["で"],["は"],["／"],["彼","かれ"],["に"],["答えまい","こたえまい"],["。"]]},{"verse":15,"text":"彼らはあきれて、もう答えない。／彼らの言うことばもなくなった。","tok":[["彼","かれ"],["ら"],["は"],["あきれて"],["、"],["もう"],["答えない","こたえない"],["。"],["／"],["彼","かれ"],["ら"],["の"],["言う","いう"],["ことば"],["も"],["なくなった"],["。"]]},{"verse":16,"text":"彼らが語らず、そのままじっと答えないからといって、私は待っていなければならないだろうか。","tok":[["彼","かれ"],["ら"],["が"],["語らず","かたらず"],["、"],["そのまま"],["じっと"],["答えない","こたえない"],["から"],["と"],["いって"],["、"],["私","わたくし"],["は"],["待って","まって"],["いなければ"],["ならないだろう"],["か"],["。"]]},{"verse":17,"text":"私は私で自分の言い分を言い返し、私の意見を述べてみよう。","tok":[["私","わたくし"],["は"],["私","わたくし"],["で"],["自分","じぶん"],["の"],["言い分","いいぶん"],["を"],["言い返し","いいかえし"],["、"],["私","わたくし"],["の"],["意見","いけん"],["を"],["述べて","のべて"],["みよう"],["。"]]},{"verse":18,"text":"私にはことばがあふれており、一つの霊が私を圧迫している。私の腹を。","tok":[["私","わたくし"],["に"],["は"],["ことば"],["が"],["あふれて"],["おり"],["、"],["一","ひと"],["つ"],["の"],["霊","れい"],["が"],["私","わたくし"],["を"],["圧迫","あっぱく"],["して"],["いる"],["。"],["私","わたくし"],["の"],["腹","はら"],["を"],["。"]]},{"verse":19,"text":"今、私の腹は抜け口のないぶどう酒のようだ。／新しいぶどう酒の皮袋のように、今にも張り裂けようとしている。","tok":[["今","いま"],["、"],["私","わたくし"],["の"],["腹","はら"],["は"],["抜け口","ぬけぐち"],["の"],["ない"],["ぶどう酒","ぶどうしゅ"],["の"],["よう"],["だ"],["。"],["／"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["の"],["皮袋","かわぶくろ"],["の"],["よう"],["に"],["、"],["今","いま"],["に"],["も"],["張り裂けよう","はりさけよう"],["として"],["いる"],["。"]]},{"verse":20,"text":"私は語って、気分を晴らしたい。／くちびるを開いて答えたい。","tok":[["私","わたくし"],["は"],["語って","かたって"],["、"],["気分","きぶん"],["を"],["晴らしたい","はらしたい"],["。"],["／"],["くちびる"],["を"],["開いて","ひらいて"],["答えたい","こたえたい"],["。"]]},{"verse":21,"text":"私はだれをもひいきしない。／どんな人にもへつらわない。","tok":[["私","わたくし"],["は"],["だれ"],["を"],["も"],["ひいき"],["しない"],["。"],["／"],["どんな"],["人","ひと"],["に"],["も"],["へつらわない"],["。"]]},{"verse":22,"text":"へつらうことを知らないから。／そうでなければ、私を造った方は／今すぐ、私を奪い去ろう。","tok":[["へつらう"],["こと"],["を"],["知らない","しらない"],["から"],["。"],["／"],["そう"],["で"],["なければ"],["、"],["私","わたくし"],["を"],["造った","つくった"],["方","ほう"],["は"],["／"],["今","いま"],["すぐ"],["、"],["私","わたくし"],["を"],["奪い去ろう","うばいさろう"],["。"]]}]
[{"verse":1,"text":"シオンで角笛を吹き鳴らし、わたしの聖なる山でときの声をあげよ。／この地に住むすべての者は、わななけ。／主の日が来るからだ。その日は近い。","tok":[["シオン"],["で"],["角笛","つのぶえ"],["を"],["吹き鳴らし","ふきならし"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["で"],["とき"],["の"],["声","こえ"],["を"],["あげ"],["よ"],["。"],["／"],["この"],["地","ち"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["は"],["、"],["わななけ"],["。"],["／"],["主","ぬし"],["の"],["日","ひ"],["が"],["来る","くる"],["から"],["だ"],["。"],["その"],["日","ひ"],["は"],["近い","ちかい"],["。"]]},{"verse":2,"text":"やみと、暗黒の日。／雲と、暗やみの日。／山々に広がる暁の光のように数多く強い民。／このようなことは昔から起こったことがなく、これから後の代々の時代にも再び起こらない。","tok":[["やみ"],["と"],["、"],["暗黒","あんこく"],["の"],["日","ひ"],["。"],["／"],["雲","くも"],["と"],["、"],["暗やみ","くらやみ"],["の"],["日","ひ"],["。"],["／"],["山々","やまやま"],["に"],["広がる","ひろがる"],["暁","あかつき"],["の"],["光","ひかり"],["の"],["よう"],["に"],["数多く","かずおおく"],["強い","つよい"],["民","たみ"],["。"],["／"],["この"],["よう"],["な"],["こと"],["は"],["昔","むかし"],["から"],["起こった","おこった"],["こと"],["が"],["なく"],["、"],["これ"],["から"],["後","あと"],["の"],["代々","だいだい"],["の"],["時代","じだい"],["に"],["も"],["再び","ふたたび"],["起こらない","おこらない"],["。"]]},{"verse":3,"text":"彼らの前では、火が焼き尽くし、彼らのうしろでは、炎がなめ尽くす。／彼らの来る前には、この国はエデンの園のようであるが、彼らの去ったあとでは、荒れ果てた荒野となる。／これからのがれるものは一つもない。","tok":[["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["は"],["、"],["火","ひ"],["が"],["焼き","やき"],["尽くし","つくし"],["、"],["彼","かれ"],["ら"],["の"],["うしろ"],["で"],["は"],["、"],["炎","ほのお"],["が"],["なめ"],["尽くす","つくす"],["。"],["／"],["彼","かれ"],["ら"],["の"],["来る","くる"],["前","まえ"],["に"],["は"],["、"],["この"],["国","くに"],["は"],["エデン"],["の"],["園","その"],["の"],["よう"],["で"],["ある"],["が"],["、"],["彼","かれ"],["ら"],["の"],["去った","さった"],["あと"],["で"],["は"],["、"],["荒れ果てた","あれはてた"],["荒野","あらの"],["と"],["なる"],["。"],["／"],["これ"],["から"],["のがれる"],["もの"],["は"],["一","ひと"],["つ"],["も"],["ない"],["。"]]},{"verse":4,"text":"その有様は馬のようで、軍馬のように、駆け巡る。","tok":[["その"],["有様","ありさま"],["は"],["馬","うま"],["の"],["よう"],["で"],["、"],["軍馬","ぐんば"],["の"],["よう"],["に"],["、"],["駆け巡る","かけめぐる"],["。"]]},{"verse":5,"text":"さながら戦車のきしるよう、彼らは山々の頂をとびはねる。／それは刈り株を焼き尽くす火の炎の音のよう、戦いの備えをした強い民のようである。","tok":[["さながら"],["戦車","せんしゃ"],["の"],["きしる"],["よう"],["、"],["彼","かれ"],["ら"],["は"],["山々","やまやま"],["の"],["頂","いただき"],["を"],["とびはねる"],["。"],["／"],["それ"],["は"],["刈り株","かりかぶ"],["を"],["焼き","やき"],["尽くす","つくす"],["火","ひ"],["の"],["炎","ほのお"],["の"],["音","おと"],["の"],["よう"],["、"],["戦い","たたかい"],["の"],["備え","そなえ"],["を"],["した"],["強い","つよい"],["民","たみ"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":6,"text":"その前で国々の民はもだえ苦しみ、みなの顔は青ざめる。","tok":[["その"],["前","まえ"],["で"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["もだえ苦しみ","もだえくるしみ"],["、"],["みな"],["の"],["顔","かお"],["は"],["青ざめる","あおざめる"],["。"]]},{"verse":7,"text":"それは勇士のように走り、戦士のように城壁をよじのぼる。／それぞれ自分の道を進み、進路を乱さない。","tok":[["それ"],["は"],["勇士","ゆうし"],["の"],["よう"],["に"],["走り","はしり"],["、"],["戦士","せんし"],["の"],["よう"],["に"],["城壁","じょうへき"],["を"],["よじのぼる"],["。"],["／"],["それぞれ"],["自分","じぶん"],["の"],["道","みち"],["を"],["進み","すすみ"],["、"],["進路","しんろ"],["を"],["乱さない","みださない"],["。"]]},{"verse":8,"text":"互いに押し合わず、めいめい自分の大路を進んで行く。／投げ槍がふりかかっても、止まらない。","tok":[["互い","たがい"],["に"],["押し合わず","おしあわず"],["、"],["めいめい"],["自分","じぶん"],["の"],["大路","おおじ"],["を"],["進んで","すすんで"],["行く","いく"],["。"],["／"],["投げ槍","なげやり"],["が"],["ふりかかって"],["も"],["、"],["止まらない","とまらない"],["。"]]},{"verse":9,"text":"それは町を襲い、城壁の上を走り、家々によじのぼり、盗人のように窓から入り込む。","tok":[["それ"],["は"],["町","まち"],["を"],["襲い","おそい"],["、"],["城壁","じょうへき"],["の"],["上","うえ"],["を"],["走り","はしり"],["、"],["家々","いえいえ"],["に"],["よじのぼり"],["、"],["盗人","ぬすびと"],["の"],["よう"],["に"],["窓","まど"],["から"],["入り込む","はいりこむ"],["。"]]},{"verse":10,"text":"その面前で地は震い、天は揺れる。／太陽も月も暗くなり、星もその光を失う。","tok":[["その"],["面前","めんぜん"],["で"],["地","ち"],["は"],["震い","ふるい"],["、"],["天","てん"],["は"],["揺れる","ゆれる"],["。"],["／"],["太陽","たいよう"],["も"],["月","つき"],["も"],["暗く","くらく"],["なり"],["、"],["星","ほし"],["も"],["その"],["光","ひかり"],["を"],["失う","うしなう"],["。"]]},{"verse":11,"text":"主は、ご自身の軍勢の先頭に立って／声をあげられる。／その隊の数は非常に多く、主の命令を行う者は力強い。／主の日は偉大で、非常に恐ろしい。／だれがこの日に耐えられよう。","tok":[["主","ぬし"],["は"],["、"],["ご自身","ごじしん"],["の"],["軍勢","ぐんぜい"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["／"],["声","こえ"],["を"],["あげられる"],["。"],["／"],["その"],["隊","たい"],["の"],["数","かず"],["は"],["非常","ひじょう"],["に"],["多く","おおく"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["を"],["行う","おこなう"],["者","もの"],["は"],["力強い","ちからづよい"],["。"],["／"],["主","ぬし"],["の"],["日","ひ"],["は"],["偉大","いだい"],["で"],["、"],["非常","ひじょう"],["に"],["恐ろしい","おそろしい"],["。"],["／"],["だれ"],["が"],["この"],["日","ひ"],["に"],["耐えられよう","たえられよう"],["。"]]},{"verse":12,"text":"「しかし、今、――主の御告げ――／心を尽くし、断食と、涙と、嘆きとをもって、わたしに立ち返れ。」","tok":[["「"],["しかし"],["、"],["今","いま"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["断食","だんじき"],["と"],["、"],["涙","なみだ"],["と"],["、"],["嘆き","なげき"],["と"],["を"],["もって"],["、"],["わたし"],["に"],["立ち返れ","たちかえれ"],["。"],["」"]]},{"verse":13,"text":"あなたがたの着物ではなく、あなたがたの心を引き裂け。／あなたがたの神、主に立ち返れ。／主は情け深く、あわれみ深く、怒るのにおそく、恵み豊かで、わざわいを思い直してくださるからだ。","tok":[["あなた"],["がた"],["の"],["着物","きもの"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["引き裂け","ひきさけ"],["。"],["／"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["立ち返れ","たちかえれ"],["。"],["／"],["主","ぬし"],["は"],["情け深く","なさけぶかく"],["、"],["あわれみ"],["深く","ふかく"],["、"],["怒る","おこる"],["のに"],["おそく"],["、"],["恵み","めぐみ"],["豊か","ゆたか"],["で"],["、"],["わざわい"],["を"],["思い直して","おもいなおして"],["くださる"],["から"],["だ"],["。"]]},{"verse":14,"text":"主が思い直して、あわれみ、そのあとに祝福を残し、また、あなたがたの神、主への／穀物のささげ物と注ぎのぶどう酒とを／残してくださらないとだれが知ろう。","tok":[["主","ぬし"],["が"],["思い直して","おもいなおして"],["、"],["あわれみ"],["、"],["その"],["あと"],["に"],["祝福","しゅくふく"],["を"],["残し","のこし"],["、"],["また"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["へ"],["の"],["／"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["と"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["と"],["を"],["／"],["残して","のこして"],["くださらない"],["と"],["だれ"],["が"],["知ろう","しろう"],["。"]]},{"verse":15,"text":"シオンで角笛を吹き鳴らせ。／断食の布告をし、きよめの集会のふれを出せ。","tok":[["シオン"],["で"],["角笛","つのぶえ"],["を"],["吹き鳴らせ","ふきならせ"],["。"],["／"],["断食","だんじき"],["の"],["布告","ふこく"],["を"],["し"],["、"],["きよめ"],["の"],["集会","しゅうかい"],["の"],["ふれ"],["を"],["出せ","だせ"],["。"]]},{"verse":16,"text":"民を集め、集会を召集せよ。／老人たちを集め、幼子、乳飲み子も寄せ集めよ。／花婿を寝室から、花嫁を自分の部屋から呼び出せ。","tok":[["民","みん"],["を"],["集め","あつめ"],["、"],["集会","しゅうかい"],["を"],["召集","しょうしゅう"],["せよ"],["。"],["／"],["老人","ろうじん"],["たち"],["を"],["集め","あつめ"],["、"],["幼子","おさなご"],["、"],["乳飲み子","ちのみご"],["も"],["寄せ集めよ","よせあつめよ"],["。"],["／"],["花婿","はなむこ"],["を"],["寝室","しんしつ"],["から"],["、"],["花嫁","はなよめ"],["を"],["自分","じぶん"],["の"],["部屋","へや"],["から"],["呼び出せ","よびだせ"],["。"]]},{"verse":17,"text":"主に仕える祭司たちは、神殿の玄関の間と祭壇との間で、泣いて言え。「主よ。あなたの民をあわれんでください。あなたのゆずりの地を、諸国の民のそしりとしたり、物笑いの種としたりしないでください。国々の民の間に、『彼らの神はどこにいるのか』と言わせておいてよいのでしょうか。」","tok":[["主に","おもに"],["仕える","つかえる"],["祭司","さいし"],["たち"],["は"],["、"],["神殿","しんでん"],["の"],["玄関","げんかん"],["の"],["間","あいだ"],["と"],["祭壇","さいだん"],["と"],["の"],["間","あいだ"],["で"],["、"],["泣いて","ないて"],["言え","いえ"],["。"],["「"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["民","たみ"],["を"],["あわれんで"],["ください"],["。"],["あなた"],["の"],["ゆずり"],["の"],["地","ち"],["を"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["そしり"],["と"],["し"],["たり"],["、"],["物笑い","ものわらい"],["の"],["種","しゅ"],["と"],["し"],["たり"],["しないで"],["ください"],["。"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["、"],["『"],["彼","かれ"],["ら"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["』"],["と"],["言わせて","いわせて"],["おいて"],["よい"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":18,"text":"主はご自分の地をねたむほど愛し、ご自分の民をあわれまれた。","tok":[["主","ぬし"],["は"],["ご自分","ごじぶん"],["の"],["地","ち"],["を"],["ねたむ"],["ほど"],["愛し","あいし"],["、"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["あわれまれた"],["。"]]},{"verse":19,"text":"主は民に答えて仰せられた。「今、わたしは穀物と新しいぶどう酒と油とをあなたがたに送る。あなたがたは、それで満足する。わたしは、二度とあなたがたを、諸国の民の間で、そしりとしない。","tok":[["主","ぬし"],["は"],["民","みん"],["に"],["答えて","こたえて"],["仰せられた","おおせられた"],["。"],["「"],["今","いま"],["、"],["わたし"],["は"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["油","あぶら"],["と"],["を"],["あなた"],["がた"],["に"],["送る","おくる"],["。"],["あなた"],["がた"],["は"],["、"],["それ"],["で"],["満足","まんぞく"],["する"],["。"],["わたし"],["は"],["、"],["二","に"],["度","ど"],["と"],["あなた"],["がた"],["を"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["間","あいだ"],["で"],["、"],["そしり"],["と"],["しない"],["。"]]},{"verse":20,"text":"わたしは北から来るものを、あなたがたから遠ざけ、それを荒廃した砂漠の地へ追いやり、その前衛を東の海に、その後衛を西の海に追いやる。その悪臭が立ち上り、その腐ったにおいが立ち上る。主が大いなることをしたからだ。」","tok":[["わたし"],["は"],["北","きた"],["から"],["来る","くる"],["もの"],["を"],["、"],["あなた"],["がた"],["から"],["遠ざけ","とおざけ"],["、"],["それ"],["を"],["荒廃","こうはい"],["した"],["砂漠","さばく"],["の"],["地","ち"],["へ"],["追いやり","おいやり"],["、"],["その"],["前衛","ぜんえい"],["を"],["東","ひがし"],["の"],["海","うみ"],["に"],["、"],["その"],["後衛","こうえい"],["を"],["西","にし"],["の"],["海","うみ"],["に"],["追いやる","おいやる"],["。"],["その"],["悪臭","あくしゅう"],["が"],["立ち上り","たちのぼり"],["、"],["その"],["腐った","くさった"],["におい"],["が"],["立ち上る","たちのぼる"],["。"],["主","ぬし"],["が"],["大いなる","おおいなる"],["こと"],["を"],["した"],["から"],["だ"],["。"],["」"]]},{"verse":21,"text":"地よ。恐れるな。楽しみ喜べ。／主が大いなることをされたからだ。","tok":[["地","ち"],["よ"],["。"],["恐れる","おそれる"],["な"],["。"],["楽しみ","たのしみ"],["喜べ","よろこべ"],["。"],["／"],["主","ぬし"],["が"],["大いなる","おおいなる"],["こと"],["を"],["された"],["から"],["だ"],["。"]]},{"verse":22,"text":"野の獣たちよ。恐れるな。／荒野の牧草はもえ出る。／木はその実をみのらせ、いちじくの木と、ぶどうの木とは豊かにみのる。","tok":[["野","の"],["の"],["獣","けもの"],["たち"],["よ"],["。"],["恐れる","おそれる"],["な"],["。"],["／"],["荒野","こうや"],["の"],["牧草","ぼくそう"],["は"],["もえ出る","もえでる"],["。"],["／"],["木","き"],["は"],["その"],["実","じつ"],["を"],["みのらせ"],["、"],["いちじく"],["の"],["木","き"],["と"],["、"],["ぶどう"],["の"],["木","き"],["と"],["は"],["豊か","ゆたか"],["に"],["みのる"],["。"]]},{"verse":23,"text":"シオンの子らよ。／あなたがたの神、主にあって、楽しみ喜べ。／主は、あなたがたを義とするために、初めの雨を賜り、大雨を降らせ、前のように、初めの雨と後の雨とを／降らせてくださるからだ。","tok":[["シオン"],["の"],["子","こ"],["ら"],["よ"],["。"],["／"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["あって"],["、"],["楽しみ","たのしみ"],["喜べ","よろこべ"],["。"],["／"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["を"],["義","ぎ"],["と"],["する"],["ため"],["に"],["、"],["初め","はじめ"],["の"],["雨","あめ"],["を"],["賜り","たまわり"],["、"],["大雨","おおあめ"],["を"],["降らせ","ふらせ"],["、"],["前","まえ"],["の"],["よう"],["に"],["、"],["初め","はじめ"],["の"],["雨","あめ"],["と"],["後","あと"],["の"],["雨","あめ"],["と"],["を"],["／"],["降らせて","ふらせて"],["くださる"],["から"],["だ"],["。"]]},{"verse":24,"text":"打ち場は穀物で満ち、石がめは新しいぶどう酒と油とであふれる。","tok":[["打ち","うち"],["場","ば"],["は"],["穀物","こくもつ"],["で"],["満ち","みち"],["、"],["石がめ","いしがめ"],["は"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["油","あぶら"],["と"],["で"],["あふれる"],["。"]]},{"verse":25,"text":"いなご、ばった、食い荒らすいなご、かみつくいなご、わたしがあなたがたの間に送った大軍勢が、食い尽くした年々を、わたしはあなたがたに償おう。","tok":[["いなご"],["、"],["ばった"],["、"],["食い荒らす","くいあらす"],["いなご"],["、"],["かみつく"],["いなご"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["送った","おくった"],["大軍勢","たいぐんぜい"],["が"],["、"],["食い","くい"],["尽くした","つくした"],["年々","ねんねん"],["を"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["償おう","つぐなおう"],["。"]]},{"verse":26,"text":"あなたがたは飽きるほど食べて満足し、あなたがたに不思議なことをしてくださった／あなたがたの神、主の名をほめたたえよう。／わたしの民は永遠に恥を見ることはない。","tok":[["あなた"],["がた"],["は"],["飽きる","あきる"],["ほど"],["食べて","たべて"],["満足","まんぞく"],["し"],["、"],["あなた"],["がた"],["に"],["不思議","ふしぎ"],["な"],["こと"],["を"],["して"],["くださった"],["／"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["名","な"],["を"],["ほめたたえよう"],["。"],["／"],["わたし"],["の"],["民","たみ"],["は"],["永遠","えいえん"],["に"],["恥","はじ"],["を"],["見る","みる"],["こと"],["は"],["ない"],["。"]]},{"verse":27,"text":"あなたがたは、イスラエルの真ん中にわたしがいることを知り、わたしがあなたがたの神、主であり、ほかにはないことを知る。／わたしの民は永遠に恥を見ることはない。","tok":[["あなた"],["がた"],["は"],["、"],["イスラエル"],["の"],["真ん中","まんなか"],["に"],["わたし"],["が"],["いる"],["こと"],["を"],["知り","しり"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["あり"],["、"],["ほか"],["に"],["は"],["ない"],["こと"],["を"],["知る","しる"],["。"],["／"],["わたし"],["の"],["民","たみ"],["は"],["永遠","えいえん"],["に"],["恥","はじ"],["を"],["見る","みる"],["こと"],["は"],["ない"],["。"]]},{"verse":28,"text":"その後、わたしは、わたしの霊をすべての人に注ぐ。／あなたがたの息子や娘は預言し、年寄りは夢を見、若い男は幻を見る。","tok":[["その"],["後","ご"],["、"],["わたし"],["は"],["、"],["わたし"],["の"],["霊","れい"],["を"],["すべて"],["の"],["人","ひと"],["に"],["注ぐ","そそぐ"],["。"],["／"],["あなた"],["がた"],["の"],["息子","むすこ"],["や"],["娘","むすめ"],["は"],["預言","よげん"],["し"],["、"],["年寄り","としより"],["は"],["夢","ゆめ"],["を"],["見","み"],["、"],["若い","わかい"],["男","おとこ"],["は"],["幻","まぼろし"],["を"],["見る","みる"],["。"]]},{"verse":29,"text":"その日、わたしは、しもべにも、はしためにも、わたしの霊を注ぐ。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["しもべ"],["に"],["も"],["、"],["はし"],["ため"],["に"],["も"],["、"],["わたし"],["の"],["霊","れい"],["を"],["注ぐ","そそぐ"],["。"]]},{"verse":30,"text":"わたしは天と地に、不思議なしるしを現す。／血と火と煙の柱である。","tok":[["わたし"],["は"],["天","てん"],["と"],["地","ち"],["に"],["、"],["不思議","ふしぎ"],["な"],["しるし"],["を"],["現す","あらわす"],["。"],["／"],["血","ち"],["と"],["火","ひ"],["と"],["煙","けむり"],["の"],["柱","はしら"],["で"],["ある"],["。"]]},{"verse":31,"text":"主の大いなる恐るべき日が来る前に、太陽はやみとなり、月は血に変わる。","tok":[["主","ぬし"],["の"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["日","ひ"],["が"],["来る","くる"],["前","まえ"],["に"],["、"],["太陽","たいよう"],["は"],["やみ"],["と"],["なり"],["、"],["月","つき"],["は"],["血","ち"],["に"],["変わる","かわる"],["。"]]},{"verse":32,"text":"しかし、主の名を呼ぶ者はみな救われる。／主が仰せられたように、シオンの山、エルサレムに、のがれる者があるからだ。／その生き残った者のうちに、主が呼ばれる者がいる。","tok":[["しかし"],["、"],["主","ぬし"],["の"],["名","な"],["を"],["呼ぶ","よぶ"],["者","もの"],["は"],["みな"],["救われる","すくわれる"],["。"],["／"],["主","ぬし"],["が"],["仰せられた","おおせられた"],["よう"],["に"],["、"],["シオン"],["の"],["山","やま"],["、"],["エルサレム"],["に"],["、"],["のがれる"],["者","もの"],["が"],["ある"],["から"],["だ"],["。"],["／"],["その"],["生き残った","いきのこった"],["者","もの"],["の"],["うち"],["に"],["、"],["主","ぬし"],["が"],["呼ばれる","よばれる"],["者","もの"],["が"],["いる"],["。"]]}]
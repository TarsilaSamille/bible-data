[{"verse":1,"text":"ユダの王、アモンの子ヨシヤの時代に、クシの子ゼパニヤにあった主のことば。クシはゲダルヤの子、ゲダルヤはアマルヤの子、アマルヤはヒゼキヤの子である。","tok":[["ユダ"],["の"],["王","おう"],["、"],["アモン"],["の"],["子","こ"],["ヨシヤ"],["の"],["時代","じだい"],["に"],["、"],["クシ"],["の"],["子","こ"],["ゼパニヤ"],["に"],["あった"],["主","ぬし"],["の"],["ことば"],["。"],["クシ"],["は"],["ゲダルヤ"],["の"],["子","こ"],["、"],["ゲダルヤ"],["は"],["アマルヤ"],["の"],["子","こ"],["、"],["アマルヤ"],["は"],["ヒゼキヤ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":2,"text":"わたしは必ず地の面から、すべてのものを取り除く。／――主の御告げ――","tok":[["わたし"],["は"],["必ず","かならず"],["地","ち"],["の"],["面","めん"],["から"],["、"],["すべて"],["の"],["もの"],["を"],["取り除く","とりのぞく"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":3,"text":"わたしは人と獣を取り除き、空の鳥と海の魚を取り除く。／わたしは、悪者どもをつまずかせ、人を地の面から断ち滅ぼす。／――主の御告げ――","tok":[["わたし"],["は"],["人","ひと"],["と"],["獣","けもの"],["を"],["取り除き","とりのぞき"],["、"],["空","そら"],["の"],["鳥","とり"],["と"],["海","うみ"],["の"],["魚","さかな"],["を"],["取り除く","とりのぞく"],["。"],["／"],["わたし"],["は"],["、"],["悪者","わるもの"],["ども"],["を"],["つまずかせ"],["、"],["人","ひと"],["を"],["地","ち"],["の"],["面","めん"],["から"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":4,"text":"わたしの手を、ユダの上に、エルサレムのすべての住民の上に伸ばす。／わたしはこの場所から、バアルの残りの者と、偶像に仕える祭司たちの名とを、その祭司たちとともに断ち滅ぼす。","tok":[["わたし"],["の"],["手","て"],["を"],["、"],["ユダ"],["の"],["上","うえ"],["に"],["、"],["エルサレム"],["の"],["すべて"],["の"],["住民","じゅうみん"],["の"],["上","うえ"],["に"],["伸ばす","のばす"],["。"],["／"],["わたし"],["は"],["この"],["場所","ばしょ"],["から"],["、"],["バアル"],["の"],["残り","のこり"],["の"],["者","もの"],["と"],["、"],["偶像","ぐうぞう"],["に"],["仕える","つかえる"],["祭司","さいし"],["たち"],["の"],["名","な"],["と"],["を"],["、"],["その"],["祭司","さいし"],["たち"],["と"],["とも"],["に"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"]]},{"verse":5,"text":"また、屋上で天の万象を拝む者ども、また、主に誓いを立てて礼拝しながら、ミルコムに誓いを立てる者ども、","tok":[["また"],["、"],["屋上","おくじょう"],["で"],["天","てん"],["の"],["万象","ばんしょう"],["を"],["拝む","おがむ"],["者","もの"],["ども"],["、"],["また"],["、"],["主に","おもに"],["誓い","ちかい"],["を"],["立てて","たてて"],["礼拝","れいはい"],["し"],["ながら"],["、"],["ミルコム"],["に"],["誓い","ちかい"],["を"],["立てる","たてる"],["者","もの"],["ども"],["、"]]},{"verse":6,"text":"また、主に従うことをやめ、主を尋ね求めず、主を求めない者どもを断ち滅ぼす。","tok":[["また"],["、"],["主に","おもに"],["従う","したがう"],["こと"],["を"],["やめ"],["、"],["主","ぬし"],["を"],["尋ね求めず","たずねもとめず"],["、"],["主","ぬし"],["を"],["求めない","もとめない"],["者","もの"],["ども"],["を"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"]]},{"verse":7,"text":"神である主の前に静まれ。／主の日は近い。主が一頭のほふる獣を備え、主に招かれた者を聖別されたからだ。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["前","まえ"],["に"],["静まれ","しずまれ"],["。"],["／"],["主","ぬし"],["の"],["日","ひ"],["は"],["近い","ちかい"],["。"],["主","ぬし"],["が"],["一頭","いちとう"],["の"],["ほふる"],["獣","けもの"],["を"],["備え","そなえ"],["、"],["主に","おもに"],["招かれた","まねかれた"],["者","もの"],["を"],["聖別","せいべつ"],["された"],["から"],["だ"],["。"]]},{"verse":8,"text":"主が獣をほふる日に、わたしは首長たちや王子たち、外国の服をまとったすべての者を罰する。","tok":[["主","ぬし"],["が"],["獣","けもの"],["を"],["ほふる"],["日","ひ"],["に"],["、"],["わたし"],["は"],["首長","しゅちょう"],["たち"],["や"],["王子","おうじ"],["たち"],["、"],["外国","がいこく"],["の"],["服","ふく"],["を"],["まとった"],["すべて"],["の"],["者","もの"],["を"],["罰する","ばっする"],["。"]]},{"verse":9,"text":"その日、わたしは、神殿の敷居によじのぼるすべての者、自分の主人の家を暴虐と欺きで満たす者どもを／罰する。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["神殿","しんでん"],["の"],["敷居","しきい"],["に"],["よじのぼる"],["すべて"],["の"],["者","もの"],["、"],["自分","じぶん"],["の"],["主人","しゅじん"],["の"],["家","いえ"],["を"],["暴虐","ぼうぎゃく"],["と"],["欺きで","あざむきで"],["満たす","みたす"],["者","もの"],["ども"],["を"],["／"],["罰する","ばっする"],["。"]]},{"verse":10,"text":"その日には、――主の御告げ――／魚の門から叫び声が、第二区から嘆き声が、丘からは大いなる破滅の響きが起こる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["魚","さかな"],["の"],["門","もん"],["から"],["叫び声","さけびごえ"],["が"],["、"],["第","だい"],["二区","にく"],["から"],["嘆き","なげき"],["声","こえ"],["が"],["、"],["丘","おか"],["から"],["は"],["大いなる","おおいなる"],["破滅","はめつ"],["の"],["響き","ひびき"],["が"],["起こる","おこる"],["。"]]},{"verse":11,"text":"泣きわめけ。マクテシュ区に住む者どもよ。／商人はみな滅びうせ、銀を量る者もみな断ち滅ぼされるからだ。","tok":[["泣きわめけ","なきわめけ"],["。"],["マクテシュ"],["区","く"],["に"],["住む","すむ"],["者","もの"],["ども"],["よ"],["。"],["／"],["商人","しょうにん"],["は"],["みな"],["滅び","ほろび"],["うせ"],["、"],["銀","ぎん"],["を"],["量る","はかる"],["者","もの"],["も"],["みな"],["断ち","たち"],["滅ぼされる","ほろぼされる"],["から"],["だ"],["。"]]},{"verse":12,"text":"その時、わたしは、ともしびをかざして、エルサレムを捜し、そのぶどう酒のかすの上によどんでいて、「主は良いことも、悪いこともしない」と／心の中で言っている者どもを罰する。","tok":[["その"],["時","とき"],["、"],["わたし"],["は"],["、"],["ともしび"],["を"],["かざして"],["、"],["エルサレム"],["を"],["捜し","さがし"],["、"],["その"],["ぶどう酒","ぶどうしゅ"],["の"],["かす"],["の"],["上","うえ"],["に"],["よどんで"],["いて"],["、"],["「"],["主","ぬし"],["は"],["良い","よい"],["こと"],["も"],["、"],["悪い","わるい"],["こと"],["も"],["しない"],["」"],["と"],["／"],["心","こころ"],["の"],["中","なか"],["で"],["言って","いって"],["いる"],["者","もの"],["ども"],["を"],["罰する","ばっする"],["。"]]},{"verse":13,"text":"彼らの財産は略奪され、彼らの家は荒れ果てる。／彼らは家を建てても、それに住めず、ぶどう畑を作っても、そのぶどう酒を飲めない。","tok":[["彼","かれ"],["ら"],["の"],["財産","ざいさん"],["は"],["略奪","りゃくだつ"],["され"],["、"],["彼","かれ"],["ら"],["の"],["家","いえ"],["は"],["荒れ果てる","あれはてる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["家","いえ"],["を"],["建てて","たてて"],["も"],["、"],["それ"],["に"],["住めず","すめず"],["、"],["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["も"],["、"],["その"],["ぶどう酒","ぶどうしゅ"],["を"],["飲めない","のめない"],["。"]]},{"verse":14,"text":"主の大いなる日は近い。／それは近く、非常に早く来る。／聞け。主の日を。勇士も激しく叫ぶ。","tok":[["主","ぬし"],["の"],["大いなる","おおいなる"],["日","ひ"],["は"],["近い","ちかい"],["。"],["／"],["それ"],["は"],["近く","ちかく"],["、"],["非常","ひじょう"],["に"],["早く","はやく"],["来る","くる"],["。"],["／"],["聞け","きけ"],["。"],["主","ぬし"],["の"],["日","ひ"],["を"],["。"],["勇士","ゆうし"],["も"],["激しく","はげしく"],["叫ぶ","さけぶ"],["。"]]},{"verse":15,"text":"その日は激しい怒りの日、苦難と苦悩の日、荒廃と滅亡の日、やみと暗黒の日、雲と暗やみの日、","tok":[["その"],["日","ひ"],["は"],["激しい","はげしい"],["怒り","いかり"],["の"],["日","ひ"],["、"],["苦難","くなん"],["と"],["苦悩","くのう"],["の"],["日","ひ"],["、"],["荒廃","こうはい"],["と"],["滅亡","めつぼう"],["の"],["日","ひ"],["、"],["やみ"],["と"],["暗黒","あんこく"],["の"],["日","ひ"],["、"],["雲","くも"],["と"],["暗やみ","くらやみ"],["の"],["日","ひ"],["、"]]},{"verse":16,"text":"角笛とときの声の日、城壁のある町々と高い四隅の塔が襲われる日だ。","tok":[["角笛","つのぶえ"],["と"],["とき"],["の"],["声","こえ"],["の"],["日","ひ"],["、"],["城壁","じょうへき"],["の"],["ある"],["町々","まちまち"],["と"],["高い","たかい"],["四隅","よすみ"],["の"],["塔","とう"],["が"],["襲われる","おそわれる"],["日","ひ"],["だ"],["。"]]},{"verse":17,"text":"わたしは人を苦しめ、人々は盲人のように歩く。／彼らは主に罪を犯したからだ。／彼らの血はちりのように振りまかれ、彼らのはらわたは糞のようにまき散らされる。","tok":[["わたし"],["は"],["人","ひと"],["を"],["苦しめ","くるしめ"],["、"],["人々","ひとびと"],["は"],["盲人","もうじん"],["の"],["よう"],["に"],["歩く","あるく"],["。"],["／"],["彼","かれ"],["ら"],["は"],["主に","おもに"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["だ"],["。"],["／"],["彼","かれ"],["ら"],["の"],["血","ち"],["は"],["ちり"],["の"],["よう"],["に"],["振りまかれ","ふりまかれ"],["、"],["彼","かれ"],["ら"],["の"],["はらわた"],["は"],["糞","ふん"],["の"],["よう"],["に"],["まき散らされる","まきちらされる"],["。"]]},{"verse":18,"text":"彼らの銀も、彼らの金も、主の激しい怒りの日に彼らを救い出せない。／そのねたみの火で、全土は焼き払われる。／主は実に、地に住むすべての者を／たちまち滅ぼし尽くす。","tok":[["彼","かれ"],["ら"],["の"],["銀","ぎん"],["も"],["、"],["彼","かれ"],["ら"],["の"],["金","かね"],["も"],["、"],["主","ぬし"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["日","ひ"],["に"],["彼","かれ"],["ら"],["を"],["救い出せない","すくいだせない"],["。"],["／"],["その"],["ねたみ"],["の"],["火","ひ"],["で"],["、"],["全土","ぜんど"],["は"],["焼き払われる","やきはらわれる"],["。"],["／"],["主","ぬし"],["は"],["実","じつ"],["に"],["、"],["地","ち"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["を"],["／"],["たちまち"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"]]}]
[{"verse":1,"text":"恥知らずの国民よ。こぞって集まれ、集まれ。","tok":[["恥","はじ"],["知らず","しらず"],["の"],["国民","こくみん"],["よ"],["。"],["こぞって"],["集まれ","あつまれ"],["、"],["集まれ","あつまれ"],["。"]]},{"verse":2,"text":"昼間、吹き散らされるもみがらのように、あなたがたがならないうちに。／主の燃える怒りが、まだあなたがたを襲わないうちに。／主の怒りの日が、まだあなたがたを襲わないうちに。","tok":[["昼間","ひるま"],["、"],["吹き散らされる","ふきちらされる"],["もみがら"],["の"],["よう"],["に"],["、"],["あなた"],["がた"],["がならない"],["うち"],["に"],["。"],["／"],["主","ぬし"],["の"],["燃える","もえる"],["怒り","いかり"],["が"],["、"],["まだ"],["あなた"],["がた"],["を"],["襲わない","おそわない"],["うち"],["に"],["。"],["／"],["主","ぬし"],["の"],["怒り","いかり"],["の"],["日","ひ"],["が"],["、"],["まだ"],["あなた"],["がた"],["を"],["襲わない","おそわない"],["うち"],["に"],["。"]]},{"verse":3,"text":"主の定めを行う／この国のすべてのへりくだる者よ。／主を尋ね求めよ。／義を求めよ。柔和を求めよ。／そうすれば、主の怒りの日にかくまわれるかもしれない。","tok":[["主","ぬし"],["の"],["定め","さだめ"],["を"],["行う","おこなう"],["／"],["この"],["国","くに"],["の"],["すべて"],["の"],["へりくだる"],["者","もの"],["よ"],["。"],["／"],["主","ぬし"],["を"],["尋ね求めよ","たずねもとめよ"],["。"],["／"],["義","ぎ"],["を"],["求めよ","もとめよ"],["。"],["柔和","にゅうわ"],["を"],["求めよ","もとめよ"],["。"],["／"],["そう"],["すれば"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["の"],["日","ひ"],["に"],["かくまわれる"],["か"],["も"],["しれない"],["。"]]},{"verse":4,"text":"だが、ガザは捨てられ、アシュケロンは荒れ果てる。／アシュドデは真昼に追い払われ、エクロンは根こぎにされる。","tok":[["だ"],["が"],["、"],["ガザ"],["は"],["捨てられ","すてられ"],["、"],["アシュケロン"],["は"],["荒れ果てる","あれはてる"],["。"],["／"],["アシュドデ"],["は"],["真昼","まひる"],["に"],["追い払われ","おいはらわれ"],["、"],["エクロン"],["は"],["根こぎ","ねこぎ"],["に"],["される"],["。"]]},{"verse":5,"text":"ああ。海辺に住む者たち。／ケレテ人の国。／主のことばはおまえたちに向けられている。／ペリシテ人の国カナン。／わたしはおまえを消し去って、住む者がいないようにする。","tok":[["ああ"],["。"],["海辺","うみべ"],["に"],["住む","すむ"],["者","もの"],["たち"],["。"],["／"],["ケレテ人","けれてにん"],["の"],["国","くに"],["。"],["／"],["主","ぬし"],["の"],["ことば"],["は"],["おまえ"],["たち"],["に"],["向けられて","むけられて"],["いる"],["。"],["／"],["ペリシテ"],["人","にん"],["の"],["国","くに"],["カナン"],["。"],["／"],["わたし"],["は"],["おまえ"],["を"],["消し去って","けしさって"],["、"],["住む","すむ"],["者","もの"],["が"],["いない"],["よう"],["に"],["する"],["。"]]},{"verse":6,"text":"海辺よ。おまえは牧場となり、牧者たちの牧草地となり、羊の囲い場となる。","tok":[["海辺","うみべ"],["よ"],["。"],["おまえ"],["は"],["牧場","ぼくじょう"],["と"],["なり"],["、"],["牧者","ぼくしゃ"],["たち"],["の"],["牧草地","ぼくそうち"],["と"],["なり"],["、"],["羊","ひつじ"],["の"],["囲い場","かこいば"],["と"],["なる"],["。"]]},{"verse":7,"text":"海辺はユダの家の残りの者の所有となる。／彼らは海辺で羊を飼い、日が暮れると、アシュケロンの家々で横になる。／彼らの神、主が、彼らを訪れ、彼らの繁栄を元どおりにするからだ。","tok":[["海辺","うみべ"],["は"],["ユダ"],["の"],["家","いえ"],["の"],["残り","のこり"],["の"],["者","もの"],["の"],["所有","しょゆう"],["と"],["なる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["海辺","うみべ"],["で"],["羊","ひつじ"],["を"],["飼い","かい"],["、"],["日","ひ"],["が"],["暮れる","くれる"],["と"],["、"],["アシュケロン"],["の"],["家々","いえいえ"],["で"],["横","よこ"],["に"],["なる"],["。"],["／"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["彼","かれ"],["ら"],["を"],["訪れ","おとずれ"],["、"],["彼","かれ"],["ら"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["する"],["から"],["だ"],["。"]]},{"verse":8,"text":"わたしはモアブのそしりと、アモン人のののしりを聞いた。／彼らはわたしの民をそしり、その領土に向かって高ぶった。","tok":[["わたし"],["は"],["モアブ"],["の"],["そしり"],["と"],["、"],["アモン人","あもんにん"],["の"],["ののしり"],["を"],["聞いた","きいた"],["。"],["／"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["を"],["そしり"],["、"],["その"],["領土","りょうど"],["に"],["向かって","むかって"],["高ぶった","たかぶった"],["。"]]},{"verse":9,"text":"それゆえ、わたしは誓って言う。／――イスラエルの神、万軍の主の御告げ――／モアブは必ずソドムのようになり、アモン人はゴモラのようになり、いらくさの茂る所、塩の穴、とこしえの荒れ果てた地となる。／わたしの民の残りの者が、そこをかすめ奪う。／わたしの国民の生き残りの者が、そこを受け継ぐ。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["誓って","ちかって"],["言う","ゆう"],["。"],["／"],["―"],["―"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["モアブ"],["は"],["必ず","かならず"],["ソドム"],["の"],["よう"],["に"],["なり"],["、"],["アモン人","あもんにん"],["は"],["ゴモラ"],["の"],["よう"],["に"],["なり"],["、"],["いらくさ"],["の"],["茂る","しげる"],["所","ところ"],["、"],["塩","しお"],["の"],["穴","あな"],["、"],["とこしえ"],["の"],["荒れ果てた","あれはてた"],["地","ち"],["と"],["なる"],["。"],["／"],["わたし"],["の"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["が"],["、"],["そこ"],["を"],["かすめ"],["奪う","うばう"],["。"],["／"],["わたし"],["の"],["国民","こくみん"],["の"],["生き残り","いきのこり"],["の"],["者","もの"],["が"],["、"],["そこ"],["を"],["受け継ぐ","うけつぐ"],["。"]]},{"verse":10,"text":"これは、彼らの高慢のためだ。彼らが万軍の主の民をそしり、これに向かって高ぶったからだ。","tok":[["これ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["高慢","こうまん"],["の"],["ため"],["だ"],["。"],["彼","かれ"],["ら"],["が"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["民","たみ"],["を"],["そしり"],["、"],["これ"],["に"],["向かって","むかって"],["高ぶった","たかぶった"],["から"],["だ"],["。"]]},{"verse":11,"text":"主は彼らを脅かし、地のすべての神々を消し去る。そのとき、人々はみな、自分のいる所で主を礼拝し、国々のすべての島々も主を礼拝する。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["脅かし","おびやかし"],["、"],["地","ち"],["の"],["すべて"],["の"],["神々","かみがみ"],["を"],["消し去る","けしさる"],["。"],["その"],["とき"],["、"],["人々","ひとびと"],["は"],["みな"],["、"],["自分","じぶん"],["の"],["いる"],["所","ところ"],["で"],["主","ぬし"],["を"],["礼拝","れいはい"],["し"],["、"],["国々","くにぐに"],["の"],["すべて"],["の"],["島々","しまじま"],["も"],["主","ぬし"],["を"],["礼拝","れいはい"],["する"],["。"]]},{"verse":12,"text":"あなたがた、クシュ人も、わたしの剣で刺し殺される。","tok":[["あなた"],["がた"],["、"],["クシュ人","くしゅにん"],["も"],["、"],["わたし"],["の"],["剣","けん"],["で"],["刺し殺される","さしころされる"],["。"]]},{"verse":13,"text":"主は手を北に差し伸べ、アッシリヤを滅ぼし、ニネベを荒れ果てた地とし、荒野のようにし、砂漠とする。","tok":[["主","ぬし"],["は"],["手","て"],["を"],["北","きた"],["に"],["差し伸べ","さしのべ"],["、"],["アッシリヤ"],["を"],["滅ぼし","ほろぼし"],["、"],["ニネベ"],["を"],["荒れ果てた","あれはてた"],["地","ち"],["と"],["し"],["、"],["荒野","こうや"],["の"],["よう"],["に"],["し"],["、"],["砂漠","さばく"],["と"],["する"],["。"]]},{"verse":14,"text":"その中に、獣の群れ、あらゆる地の獣が伏し、ペリカンと針ねずみはその柱頭をねぐらとし、ふくろうはその窓で鳴き、烏は敷居で鳴く。／主が、杉でつくったこの町をあばかれたからだ。","tok":[["その"],["中","なか"],["に"],["、"],["獣","けもの"],["の"],["群れ","むれ"],["、"],["あらゆる"],["地","ち"],["の"],["獣","けもの"],["が"],["伏し","ふし"],["、"],["ペリカン"],["と"],["針ねずみ","はりねずみ"],["は"],["その"],["柱頭","ちゅうとう"],["を"],["ねぐら"],["と"],["し"],["、"],["ふくろう"],["は"],["その"],["窓","まど"],["で"],["鳴き","なき"],["、"],["烏","からす"],["は"],["敷居","しきい"],["で"],["鳴く","なく"],["。"],["／"],["主","ぬし"],["が"],["、"],["杉","すぎ"],["で"],["つくった"],["この"],["町","まち"],["を"],["あばかれた"],["から"],["だ"],["。"]]},{"verse":15,"text":"これが、安らかに過ごし、心の中で、「私だけは特別だ」と言った／あのおごった町なのか。／ああ、その町は荒れ果てて、獣の伏す所となる。／そこを通り過ぎる者はみな、あざけって、手を振ろう。","tok":[["これ"],["が"],["、"],["安らか","やすらか"],["に"],["過ごし","すごし"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["「"],["私","わたくし"],["だけ"],["は"],["特別","とくべつ"],["だ"],["」"],["と"],["言った","いった"],["／"],["あの"],["おごった"],["町","まち"],["な"],["の"],["か"],["。"],["／"],["ああ"],["、"],["その"],["町","まち"],["は"],["荒れ果てて","あれはてて"],["、"],["獣","けもの"],["の"],["伏す","ふす"],["所","ところ"],["と"],["なる"],["。"],["／"],["そこ"],["を"],["通り過ぎる","とおりすぎる"],["者","もの"],["は"],["みな"],["、"],["あざけって"],["、"],["手","て"],["を"],["振ろう","ふろう"],["。"]]}]
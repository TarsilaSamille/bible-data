[{"verse":1,"text":"ああ。／反逆と汚れに満ちた暴力の町。","tok":[["ああ"],["。"],["／"],["反逆","はんぎゃく"],["と"],["汚れ","よごれ"],["に"],["満ちた","みちた"],["暴力","ぼうりょく"],["の"],["町","まち"],["。"]]},{"verse":2,"text":"呼びかけを聞こうともせず、懲らしめを受け入れようともせず、主に信頼せず、神に近づこうともしない。","tok":[["呼びかけ","よびかけ"],["を"],["聞こう","きこう"],["と"],["も"],["せず"],["、"],["懲らしめ","こらしめ"],["を"],["受け入れよう","うけいれよう"],["と"],["も"],["せず"],["、"],["主に","おもに"],["信頼","しんらい"],["せず"],["、"],["神","かみ"],["に"],["近づこう","ちかづこう"],["と"],["も"],["しない"],["。"]]},{"verse":3,"text":"その首長たちは、町の中にあってほえたける雄獅子。／そのさばきつかさたちは、日暮れの狼だ。／朝まで骨をかじってはいない。","tok":[["その"],["首長","しゅちょう"],["たち"],["は"],["、"],["町","まち"],["の"],["中","なか"],["に"],["あって"],["ほえ"],["たける"],["雄","おす"],["獅子","しし"],["。"],["／"],["その"],["さばき"],["つかさ"],["たち"],["は"],["、"],["日暮れ","ひぐれ"],["の"],["狼","おおかみ"],["だ"],["。"],["／"],["朝","あさ"],["まで"],["骨","ほね"],["を"],["かじって"],["は"],["いない"],["。"]]},{"verse":4,"text":"その預言者たちは、ずうずうしく、裏切る者。／その祭司たちは、聖なる物を汚し、律法を犯す。","tok":[["その"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["ずうずうしく"],["、"],["裏切る","うらぎる"],["者","もの"],["。"],["／"],["その"],["祭司","さいし"],["たち"],["は"],["、"],["聖","せい"],["なる"],["物","もの"],["を"],["汚し","よごし"],["、"],["律法","りっぽう"],["を"],["犯す","おかす"],["。"]]},{"verse":5,"text":"主は、その町の中にあって正しく、不正を行わない。／朝ごとに、ご自分の公義を残らず明るみに示す。／しかし、不正をする者は恥を知らない。","tok":[["主","ぬし"],["は"],["、"],["その"],["町","まち"],["の"],["中","なか"],["に"],["あって"],["正しく","ただしく"],["、"],["不正","ふせい"],["を"],["行わない","おこなわない"],["。"],["／"],["朝","あさ"],["ごと"],["に"],["、"],["ご自分","ごじぶん"],["の"],["公義","きみよし"],["を"],["残らず","のこらず"],["明るみ","あかるみ"],["に"],["示す","しめす"],["。"],["／"],["しかし"],["、"],["不正","ふせい"],["を"],["する"],["者","もの"],["は"],["恥","はじ"],["を"],["知らない","しらない"],["。"]]},{"verse":6,"text":"わたしは諸国の民を断ち滅ぼした。／その四隅の塔は荒れ果てた。／わたしが彼らの通りを廃墟としたので、通り過ぎる者はだれもいない。／彼らの町々は荒れすたれてひとりの人もおらず、住む者もない。","tok":[["わたし"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["断ち","たち"],["滅ぼした","ほろぼした"],["。"],["／"],["その"],["四隅","よすみ"],["の"],["塔","とう"],["は"],["荒れ果てた","あれはてた"],["。"],["／"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["通り","とおり"],["を"],["廃墟","はいきょ"],["と"],["した"],["ので"],["、"],["通り過ぎる","とおりすぎる"],["者","もの"],["は"],["だれ"],["も"],["いない"],["。"],["／"],["彼","かれ"],["ら"],["の"],["町々","まちまち"],["は"],["荒れ","あれ"],["すたれて"],["ひとり"],["の"],["人","ひと"],["も"],["おらず"],["、"],["住む","すむ"],["者","もの"],["も"],["ない"],["。"]]},{"verse":7,"text":"わたしは言った。「あなたはただ、わたしを恐れ、懲らしめを受けよ。そうすれば、わたしがこの町を罰したにもかかわらず、その住まいは断ち滅ぼされまい。確かに、彼らは、くり返してあらゆる悪事を行ったが。」","tok":[["わたし"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["ただ"],["、"],["わたし"],["を"],["恐れ","おそれ"],["、"],["懲らしめ","こらしめ"],["を"],["受けよ","うけよ"],["。"],["そう"],["すれば"],["、"],["わたし"],["が"],["この"],["町","まち"],["を"],["罰した","ばっした"],["に"],["も"],["かかわらず"],["、"],["その"],["住まい","すまい"],["は"],["断ち","たち"],["滅ぼされまい","ほろぼされまい"],["。"],["確か","たしか"],["に"],["、"],["彼","かれ"],["ら"],["は"],["、"],["くり返して","くりかえして"],["あらゆる"],["悪事","あくじ"],["を"],["行った","おこなった"],["が"],["。"],["」"]]},{"verse":8,"text":"それゆえ、わたしを待て。／――主の御告げ――／わたしが証人として立つ日を待て。／わたしは諸国の民を集め、もろもろの王国をかき集めてさばき、わたしの憤りと燃える怒りを／ことごとく彼らに注ぐ。／まことに、全地はわたしのねたみの火によって、焼き尽くされる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["を"],["待て","まて"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["が"],["証人","しょうにん"],["として"],["立つ","たつ"],["日","ひ"],["を"],["待て","まて"],["。"],["／"],["わたし"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["集め","あつめ"],["、"],["もろもろ"],["の"],["王国","おうこく"],["を"],["かき集めて","かきあつめて"],["さばき"],["、"],["わたし"],["の"],["憤り","いきどおり"],["と"],["燃える","もえる"],["怒り","いかり"],["を"],["／"],["ことごとく"],["彼","かれ"],["ら"],["に"],["注ぐ","そそぐ"],["。"],["／"],["まこと"],["に"],["、"],["全地","ぜんち"],["は"],["わたし"],["の"],["ねたみ"],["の"],["火","ひ"],["によって"],["、"],["焼き","やき"],["尽くされる","つくされる"],["。"]]},{"verse":9,"text":"そのとき、わたしは、国々の民のくちびるを変えてきよくする。／彼らはみな主の御名によって祈り、一つになって主に仕える。","tok":[["その"],["とき"],["、"],["わたし"],["は"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["くちびる"],["を"],["変えて","かえて"],["きよく"],["する"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["祈り","いのり"],["、"],["一","ひと"],["つ"],["に"],["なって"],["主に","おもに"],["仕える","つかえる"],["。"]]},{"verse":10,"text":"クシュの川の向こうから、わたしに願い事をする者、わたしに散らされた者たちが／贈り物を持って来る。","tok":[["クシュ"],["の"],["川","かわ"],["の"],["向こう","むこう"],["から"],["、"],["わたし"],["に"],["願い事","ねがいごと"],["を"],["する"],["者","もの"],["、"],["わたし"],["に"],["散らされた","ちらされた"],["者","もの"],["たち"],["が"],["／"],["贈り物","おくりもの"],["を"],["持って","もって"],["来る","くる"],["。"]]},{"verse":11,"text":"その日には、あなたは、わたしに逆らったすべてのしわざのために、恥を見ることはない。／そのとき、わたしは、あなたの中からおごり高ぶる者どもを取り去り、あなたはわたしの聖なる山で、二度と高ぶることはない。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["あなた"],["は"],["、"],["わたし"],["に"],["逆らった","さからった"],["すべて"],["の"],["しわざ"],["の"],["ため"],["に"],["、"],["恥","はじ"],["を"],["見る","みる"],["こと"],["は"],["ない"],["。"],["／"],["その"],["とき"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["中","なか"],["から"],["おごり高ぶる","おごりたかぶる"],["者","もの"],["ども"],["を"],["取り去り","とりさり"],["、"],["あなた"],["は"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["で"],["、"],["二","に"],["度","ど"],["と"],["高ぶる","たかぶる"],["こと"],["は"],["ない"],["。"]]},{"verse":12,"text":"わたしは、あなたのうちに、へりくだった、寄るべのない民を残す。／彼らはただ主の御名に身を避ける。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["うち"],["に"],["、"],["へりくだった"],["、"],["寄るべ","よるべ"],["の"],["ない"],["民","たみ"],["を"],["残す","のこす"],["。"],["／"],["彼","かれ"],["ら"],["は"],["ただ"],["主","ぬし"],["の"],["御名","ぎょめい"],["に"],["身","み"],["を"],["避ける","さける"],["。"]]},{"verse":13,"text":"イスラエルの残りの者は不正を行わず、偽りを言わない。／彼らの口の中には欺きの舌はない。／まことに彼らは草を食べて伏す。／彼らを脅かす者はない。","tok":[["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["は"],["不正","ふせい"],["を"],["行わず","おこなわず"],["、"],["偽り","いつわり"],["を"],["言わない","いわない"],["。"],["／"],["彼","かれ"],["ら"],["の"],["口","くち"],["の"],["中","なか"],["に"],["は"],["欺き","あざむき"],["の"],["舌","した"],["は"],["ない"],["。"],["／"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["草","くさ"],["を"],["食べて","たべて"],["伏す","ふす"],["。"],["／"],["彼","かれ"],["ら"],["を"],["脅かす","おびやかす"],["者","もの"],["は"],["ない"],["。"]]},{"verse":14,"text":"シオンの娘よ。喜び歌え。／イスラエルよ。喜び叫べ。／エルサレムの娘よ。心の底から、喜び勝ち誇れ。","tok":[["シオン"],["の"],["娘","むすめ"],["よ"],["。"],["喜び歌え","よろこびうたえ"],["。"],["／"],["イスラエル"],["よ"],["。"],["喜び叫べ","よろこびさけべ"],["。"],["／"],["エルサレム"],["の"],["娘","むすめ"],["よ"],["。"],["心","こころ"],["の"],["底","そこ"],["から"],["、"],["喜び","よろこび"],["勝ち誇れ","かちほこれ"],["。"]]},{"verse":15,"text":"主はあなたへの宣告を取り除き、あなたの敵を追い払われた。／イスラエルの王、主は、あなたのただ中におられる。／あなたはもう、わざわいを恐れない。","tok":[["主","ぬし"],["は"],["あなた"],["へ"],["の"],["宣告","せんこく"],["を"],["取り除き","とりのぞき"],["、"],["あなた"],["の"],["敵","てき"],["を"],["追い払われた","おいはらわれた"],["。"],["／"],["イスラエル"],["の"],["王","おう"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["ただ中","ただなか"],["に"],["おられる"],["。"],["／"],["あなた"],["は"],["もう"],["、"],["わざわい"],["を"],["恐れない","おそれない"],["。"]]},{"verse":16,"text":"その日、エルサレムはこう言われる。／シオンよ。恐れるな。気力を失うな。","tok":[["その"],["日","ひ"],["、"],["エルサレム"],["は"],["こう"],["言われる","いわれる"],["。"],["／"],["シオン"],["よ"],["。"],["恐れる","おそれる"],["な"],["。"],["気力","きりょく"],["を"],["失う","うしなう"],["な"],["。"]]},{"verse":17,"text":"あなたの神、主は、あなたのただ中におられる。／救いの勇士だ。／主は喜びをもってあなたのことを楽しみ、その愛によって安らぎを与える。／主は高らかに歌ってあなたのことを喜ばれる。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["ただ中","ただなか"],["に"],["おられる"],["。"],["／"],["救い","すくい"],["の"],["勇士","ゆうし"],["だ"],["。"],["／"],["主","ぬし"],["は"],["喜び","よろこび"],["を"],["もって"],["あなた"],["の"],["こと"],["を"],["楽しみ","たのしみ"],["、"],["その"],["愛","あい"],["によって"],["安らぎ","やすらぎ"],["を"],["与える","あたえる"],["。"],["／"],["主","ぬし"],["は"],["高らか","たからか"],["に"],["歌って","うたって"],["あなた"],["の"],["こと"],["を"],["喜ばれる","よろこばれる"],["。"]]},{"verse":18,"text":"例祭から離れて悲しむ者たちをわたしは集める。／彼らはあなたからのもの。／そしりはシオンへの警告である。","tok":[["例祭","れいさい"],["から"],["離れて","はなれて"],["悲しむ","かなしむ"],["者","もの"],["たち"],["を"],["わたし"],["は"],["集める","あつめる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["あなた"],["から"],["の"],["もの"],["。"],["／"],["そしり"],["は"],["シオン"],["へ"],["の"],["警告","けいこく"],["で"],["ある"],["。"]]},{"verse":19,"text":"見よ。その時、わたしはあなたを苦しめたすべての者を罰し、足のなえた者を救い、散らされた者を集める。／わたしは彼らの恥を栄誉に変え、全地でその名をあげさせよう。","tok":[["見","み"],["よ"],["。"],["その"],["時","とき"],["、"],["わたし"],["は"],["あなた"],["を"],["苦しめた","くるしめた"],["すべて"],["の"],["者","もの"],["を"],["罰し","ばっし"],["、"],["足","あし"],["の"],["なえた"],["者","もの"],["を"],["救い","すくい"],["、"],["散らされた","ちらされた"],["者","もの"],["を"],["集める","あつめる"],["。"],["／"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["恥","はじ"],["を"],["栄誉","えいよ"],["に"],["変え","かえ"],["、"]
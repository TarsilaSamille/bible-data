[{"verse":1,"text":"オバデヤの幻。／神である主は、エドムについてこう仰せられる。／私たちは主から知らせを聞いた。／使者が国々の間に送られた。「立ち上がれ。エドムに立ち向かい戦おう。」","tok":[["オバデヤ"],["の"],["幻","まぼろし"],["。"],["／"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["エドム"],["について"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["私たち","わたしたち"],["は"],["主","ぬし"],["から"],["知らせ","しらせ"],["を"],["聞いた","きいた"],["。"],["／"],["使者","ししゃ"],["が"],["国々","くにぐに"],["の"],["間","あいだ"],["に"],["送られた","おくられた"],["。"],["「"],["立ち上がれ","たちあがれ"],["。"],["エドム"],["に"],["立ち向かい","たちむかい"],["戦おう","たたかおう"],["。"],["」"]]},{"verse":2,"text":"見よ。わたしはあなたを国々の中の小さい者、ひどくさげすまれる者とする。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["国々","くにぐに"],["の"],["中","なか"],["の"],["小さい","ちいさい"],["者","もの"],["、"],["ひどく"],["さげすまれる"],["者","もの"],["と"],["する"],["。"]]},{"verse":3,"text":"あなたの心の高慢は自分自身を欺いた。／あなたは岩の裂け目に住み、高い所を住まいとし、「だれが私を地に引きずり降ろせようか」と／心のうちに言っている。","tok":[["あなた"],["の"],["心","こころ"],["の"],["高慢","こうまん"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["欺いた","あざむいた"],["。"],["／"],["あなた"],["は"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["住み","すみ"],["、"],["高い","たかい"],["所","ところ"],["を"],["住まい","すまい"],["と"],["し"],["、"],["「"],["だれ"],["が"],["私","わたくし"],["を"],["地","ち"],["に"],["引きずり","ひきずり"],["降ろせよう","おろせよう"],["か"],["」"],["と"],["／"],["心","こころ"],["の"],["うち"],["に"],["言って","いって"],["いる"],["。"]]},{"verse":4,"text":"あなたが鷲のように高く上っても、星の間に巣を作っても、わたしはそこから引き降ろす。／――主の御告げ――","tok":[["あなた"],["が"],["鷲","わし"],["の"],["よう"],["に"],["高く","たかく"],["上って","のぼって"],["も"],["、"],["星","ほし"],["の"],["間","あいだ"],["に"],["巣","す"],["を"],["作って","つくって"],["も"],["、"],["わたし"],["は"],["そこ"],["から"],["引き降ろす","ひきおろす"],["。"],["／"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":5,"text":"盗人があなたのところに来れば、夜、荒らす者が来れば、あなたは荒らされ、彼らは気のすむまで盗まないだろうか。／ぶどうを収穫する者が／あなたのところに来るなら、彼らは取り残しの実を残さないだろうか。","tok":[["盗人","ぬすびと"],["が"],["あなた"],["の"],["ところ"],["に"],["来れば","くれば"],["、"],["夜","よる"],["、"],["荒らす","あらす"],["者","もの"],["が"],["来れば","くれば"],["、"],["あなた"],["は"],["荒らされ","あらされ"],["、"],["彼","かれ"],["ら"],["は"],["気","き"],["の"],["すむ"],["まで"],["盗まないだろう","ぬすまないだろう"],["か"],["。"],["／"],["ぶどう"],["を"],["収穫","しゅうかく"],["する"],["者","もの"],["が"],["／"],["あなた"],["の"],["ところ"],["に"],["来るなら","くるなら"],["、"],["彼","かれ"],["ら"],["は"],["取り残し","とりのこし"],["の"],["実","じつ"],["を"],["残さないだろう","のこさないだろう"],["か"],["。"]]},{"verse":6,"text":"ああ、エサウは捜し出され、その宝は見つけ出される。","tok":[["ああ"],["、"],["エサウ"],["は"],["捜し出され","さがしだされ"],["、"],["その"],["宝","たから"],["は"],["見つけ","みつけ"],["出される","だされる"],["。"]]},{"verse":7,"text":"あなたの同盟者がみな、あなたを欺き、あなたを国境まで送り返し、あなたの親しい友があなたを征服し、あなたのパンを食べていた者が、あなたの足の下にわなをしかける。／それでも彼はそれを悟らない。","tok":[["あなた"],["の"],["同盟者","どうめいしゃ"],["が"],["みな"],["、"],["あなた"],["を"],["欺き","あざむき"],["、"],["あなた"],["を"],["国境","こっきょう"],["まで"],["送り返し","おくりかえし"],["、"],["あなた"],["の"],["親しい","したしい"],["友","とも"],["が"],["あなた"],["を"],["征服","せいふく"],["し"],["、"],["あなた"],["の"],["パン"],["を"],["食べて","たべて"],["いた"],["者","もの"],["が"],["、"],["あなた"],["の"],["足","あし"],["の"],["下","した"],["に"],["わな"],["を"],["しかける"],["。"],["／"],["それ"],["で"],["も"],["彼","かれ"],["は"],["それ"],["を"],["悟らない","さとらない"],["。"]]},{"verse":8,"text":"その日には、――主の御告げ――／わたしは、エドムから知恵ある者たちを、エサウの山から英知を／消し去らないであろうか。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["、"],["エドム"],["から"],["知恵","ちえ"],["ある"],["者","もの"],["たち"],["を"],["、"],["エサウ"],["の"],["山","やま"],["から"],["英知","えいち"],["を"],["／"],["消し去らないで","けしさらないで"],["あろう"],["か"],["。"]]},{"verse":9,"text":"テマンよ。あなたの勇士たちはおびえる。／虐殺によって、エサウの山から、ひとり残らず絶やされよう。","tok":[["テマン"],["よ"],["。"],["あなた"],["の"],["勇士","ゆうし"],["たち"],["は"],["おびえる"],["。"],["／"],["虐殺","ぎゃくさつ"],["によって"],["、"],["エサウ"],["の"],["山","やま"],["から"],["、"],["ひとり"],["残らず","のこらず"],["絶やされよう","たやされよう"],["。"]]},{"verse":10,"text":"あなたの兄弟、ヤコブへの暴虐のために、恥があなたをおおい、あなたは永遠に絶やされる。","tok":[["あなた"],["の"],["兄弟","きょうだい"],["、"],["ヤコブ"],["へ"],["の"],["暴虐","ぼうぎゃく"],["の"],["ため"],["に"],["、"],["恥","はじ"],["が"],["あなた"],["を"],["おおい"],["、"],["あなた"],["は"],["永遠","えいえん"],["に"],["絶やされる","たやされる"],["。"]]},{"verse":11,"text":"他国人がエルサレムの財宝を奪い去り、外国人がその門に押し入り、エルサレムをくじ引きにして取った日、あなたもまた彼らのうちのひとりのように、知らぬ顔で立っていた。","tok":[["他国人","たこくにん"],["が"],["エルサレム"],["の"],["財宝","ざいほう"],["を"],["奪い去り","うばいさり"],["、"],["外国人","がいこくじん"],["が"],["その"],["門","もん"],["に"],["押し入り","おしいり"],["、"],["エルサレム"],["を"],["くじ引き","くじびき"],["に"],["して"],["取った","とった"],["日","ひ"],["、"],["あなた"],["も"],["また"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["ひとり"],["の"],["よう"],["に"],["、"],["知らぬ","しらぬ"],["顔","かお"],["で"],["立って","たって"],["いた"],["。"]]},{"verse":12,"text":"あなたの兄弟の日、その災難の日を、あなたはただ、ながめているな。／ユダの子らの滅びの日に、彼らのことで喜ぶな。／その苦難の日に大口を開くな。","tok":[["あなた"],["の"],["兄弟","きょうだい"],["の"],["日","ひ"],["、"],["その"],["災難","さいなん"],["の"],["日","ひ"],["を"],["、"],["あなた"],["は"],["ただ"],["、"],["ながめて"],["いる"],["な"],["。"],["／"],["ユダ"],["の"],["子","こ"],["ら"],["の"],["滅び","ほろび"],["の"],["日","ひ"],["に"],["、"],["彼","かれ"],["ら"],["の"],["こと"],["で"],["喜ぶ","よろこぶ"],["な"],["。"],["／"],["その"],["苦難","くなん"],["の"],["日","ひ"],["に"],["大口","おおぐち"],["を"],["開く","ひらく"],["な"],["。"]]},{"verse":13,"text":"彼らのわざわいの日に、あなたは、わたしの民の門に、入るな。／そのわざわいの日に、あなたは、その困難をながめているな。／そのわざわいの日に、彼らの財宝に手を伸ばすな。","tok":[["彼","かれ"],["ら"],["の"],["わざわい"],["の"],["日","ひ"],["に"],["、"],["あなた"],["は"],["、"],["わたし"],["の"],["民","たみ"],["の"],["門","もん"],["に"],["、"],["入る","はいる"],["な"],["。"],["／"],["その"],["わざわい"],["の"],["日","ひ"],["に"],["、"],["あなた"],["は"],["、"],["その"],["困難","こんなん"],["を"],["ながめて"],["いる"],["な"],["。"],["／"],["その"],["わざわい"],["の"],["日","ひ"],["に"],["、"],["彼","かれ"],["ら"],["の"],["財宝","ざいほう"],["に"],["手","て"],["を"],["伸ばす","のばす"],["な"],["。"]]},{"verse":14,"text":"そののがれる者を断つために、別れ道に立ちふさがるな。／その苦難の日に、彼らの生き残った者を引き渡すな。","tok":[["その"],["の"],["が"],["れる"],["者","もの"],["を"],["断つ","たつ"],["ため"],["に"],["、"],["別れ道","わかれみち"],["に"],["立ちふさがる","たちふさがる"],["な"],["。"],["／"],["その"],["苦難","くなん"],["の"],["日","ひ"],["に"],["、"],["彼","かれ"],["ら"],["の"],["生き残った","いきのこった"],["者","もの"],["を"],["引き渡す","ひきわたす"],["な"],["。"]]},{"verse":15,"text":"主の日はすべての国々の上に近づいている。／あなたがしたように、あなたにもされる。／あなたの報いは、あなたの頭上に返る。","tok":[["主","ぬし"],["の"],["日","ひ"],["は"],["すべて"],["の"],["国々","くにぐに"],["の"],["上","うえ"],["に"],["近づいて","ちかづいて"],["いる"],["。"],["／"],["あなた"],["が"],["した"],["よう"],["に"],["、"],["あなた"],["に"],["も"],["される"],["。"],["／"],["あなた"],["の"],["報い","むくい"],["は"],["、"],["あなた"],["の"],["頭上","ずじょう"],["に"],["返る","かえる"],["。"]]},{"verse":16,"text":"あなたがたがわたしの聖なる山で飲んだように、すべての国々も飲み続け、飲んだり、すすったりして、彼らは今までになかった者のようになるだろう。","tok":[["あなた"],["がた"],["が"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["で"],["飲んだ","のんだ"],["よう"],["に"],["、"],["すべて"],["の"],["国々","くにぐに"],["も"],["飲み","のみ"],["続け","つづけ"],["、"],["飲ん","のん"],["だり"],["、"],["すすっ"],["たり"],["して"],["、"],["彼","かれ"],["ら"],["は"],["今まで","いままで"],["に"],["なかった"],["者","もの"],["の"],["よう"],["に"],["なるだろう"],["。"]]},{"verse":17,"text":"しかし、シオンの山には、のがれた者がいるようになり、そこは聖地となる。／ヤコブの家はその領地を所有する。","tok":[["しかし"],["、"],["シオン"],["の"],["山","やま"],["に"],["は"],["、"],["のがれた"],["者","もの"],["が"],["いる"],["よう"],["に"],["なり"],["、"],["そこ"],["は"],["聖地","せいち"],["と"],["なる"],["。"],["／"],["ヤコブ"],["の"],["家","いえ"],["は"],["その"],["領地","りょうち"],["を"],["所有","しょゆう"],["する"],["。"]]},{"verse":18,"text":"ヤコブの家は火となり、ヨセフの家は炎となり、エサウの家は刈り株となる。／火と炎はわらに燃えつき、これを焼き尽くし、エサウの家には生き残る者がいなくなる、と／主は告げられた。","tok":[["ヤコブ"],["の"],["家","いえ"],["は"],["火","ひ"],["と"],["なり"],["、"],["ヨセフ"],["の"],["家","いえ"],["は"],["炎","ほのお"],["と"],["なり"],["、"],["エサウ"],["の"],["家","いえ"],["は"],["刈り株","かりかぶ"],["と"],["なる"],["。"],["／"],["火","ひ"],["と"],["炎","ほのお"],["は"],["わら"],["に"],["燃えつき","もえつき"],["、"],["これ"],["を"],["焼き","やき"],["尽くし","つくし"],["、"],["エサウ"],["の"],["家","いえ"],["に"],["は"],["生き残る","いきのこる"],["者","もの"],["が"],["いなく"],["なる"],["、"],["と"],["／"],["主","ぬし"],["は"],["告げられた","つげられた"],["。"]]},{"verse":19,"text":"ネゲブの人々はエサウの山を、低地の人々はペリシテ人の国を占領する。／また彼らはエフライムの平野と、サマリヤの平野とを占領し、ベニヤミンはギルアデを占領する。","tok":[["ネゲブ"],["の"],["人々","ひとびと"],["は"],["エサウ"],["の"],["山","やま"],["を"],["、"],["低地","ていち"],["の"],["人々","ひとびと"],["は"],["ペリシテ"],["人","にん"],["の"],["国","くに"],["を"],["占領","せんりょう"],["する"],["。"],["／"],["また"],["彼","かれ"],["ら"],["は"],["エフライム"],["の"],["平野","へいや"],["と"],["、"],["サマリヤ"],["の"],["平野","へいや"],["と"],["を"],["占領","せんりょう"],["し"],["、"],["ベニヤミン"],["は"],["ギルアデ"],["を"],["占領","せんりょう"],["する"],["。"]]},{"verse":20,"text":"イスラエルの子らで、この塁の捕囚の民は／カナン人の国をツァレファテまで、セファラデに
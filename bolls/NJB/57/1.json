[{"verse":1,"text":"キリスト・イエスの囚人であるパウロ、および兄弟テモテから、私たちの愛する同労者ピレモンへ。","tok":[["キリスト"],["・"],["イエス"],["の"],["囚人","しゅうじん"],["で"],["ある"],["パウロ"],["、"],["および"],["兄弟","きょうだい"],["テモテ"],["から"],["、"],["私たち","わたしたち"],["の"],["愛する","あいする"],["同労者","どうろうしゃ"],["ピレモン"],["へ"],["。"]]},{"verse":2,"text":"また、姉妹アピヤ、私たちの戦友アルキポ、ならびにあなたの家にある教会へ。","tok":[["また"],["、"],["姉妹","しまい"],["アピヤ"],["、"],["私たち","わたしたち"],["の"],["戦友","せんゆう"],["アルキポ"],["、"],["ならびに"],["あなた"],["の"],["家","いえ"],["に"],["ある"],["教会","きょうかい"],["へ"],["。"]]},{"verse":3,"text":"私たちの父なる神と主イエス・キリストから、恵みと平安があなたがたの上にありますように。","tok":[["私たち","わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"]]},{"verse":4,"text":"私は、祈りのうちにあなたのことを覚え、いつも私の神に感謝しています。","tok":[["私","わたくし"],["は"],["、"],["祈り","いのり"],["の"],["うち"],["に"],["あなた"],["の"],["こと"],["を"],["覚え","おぼえ"],["、"],["いつも"],["私","わたくし"],["の"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":5,"text":"それは、主イエスに対してあなたが抱いている信仰と、すべての聖徒に対するあなたの愛とについて聞いているからです。","tok":[["それ"],["は"],["、"],["主","しゅ"],["イエス"],["に対して","にたいして"],["あなた"],["が"],["抱いて","いだいて"],["いる"],["信仰","しんこう"],["と"],["、"],["すべて"],["の"],["聖徒","せいと"],["に"],["対する","たいする"],["あなた"],["の"],["愛","あい"],["と"],["について"],["聞いて","きいて"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"私たちの間でキリストのためになされているすべての良い行いをよく知ることによって、あなたの信仰の交わりが生きて働くものとなりますように。","tok":[["私たち","わたしたち"],["の"],["間","あいだ"],["で"],["キリスト"],["の"],["ため"],["に"],["なされて"],["いる"],["すべて"],["の"],["良い","よい"],["行い","おこない"],["を"],["よく"],["知る","しる"],["こと"],["によって"],["、"],["あなた"],["の"],["信仰","しんこう"],["の"],["交わり","まじわり"],["が"],["生きて","いきて"],["働く","はたらく"],["もの"],["と"],["なります"],["よう"],["に"],["。"]]},{"verse":7,"text":"私はあなたの愛から多くの喜びと慰めとを受けました。それは、聖徒たちの心が、兄弟よ、あなたによって力づけられたからです。","tok":[["私","わたくし"],["は"],["あなた"],["の"],["愛","あい"],["から"],["多く","おおく"],["の"],["喜び","よろこび"],["と"],["慰め","なぐさめ"],["と"],["を"],["受けました","うけました"],["。"],["それ"],["は"],["、"],["聖徒","せいと"],["たち"],["の"],["心","こころ"],["が"],["、"],["兄弟","きょうだい"],["よ"],["、"],["あなた"],["によって"],["力づけられた","ちからづけられた"],["から"],["です"],["。"]]},{"verse":8,"text":"私は、あなたのなすべきことを、キリストにあって少しもはばからず命じることができるのですが、こういうわけですから、","tok":[["私","わたくし"],["は"],["、"],["あなた"],["の"],["なすべき"],["こと"],["を"],["、"],["キリスト"],["に"],["あって"],["少し","すこし"],["も"],["はばからず"],["命じる","めいじる"],["こと"],["が"],["できる"],["の"],["です"],["が"],["、"],["こう"],["いう"],["わけ"],["です"],["から"],["、"]]},{"verse":9,"text":"むしろ愛によって、あなたにお願いしたいと思います。年老いて、今はまたキリスト・イエスの囚人となっている私パウロが、","tok":[["むしろ"],["愛","あい"],["によって"],["、"],["あなた"],["に"],["お願い","おねがい"],["したい"],["と"],["思います","おもいます"],["。"],["年老いて","としおいて"],["、"],["今","いま"],["は"],["また"],["キリスト"],["・"],["イエス"],["の"],["囚人","しゅうじん"],["と"],["なって"],["いる"],["私","わたくし"],["パウロ"],["が"],["、"]]},{"verse":10,"text":"獄中で生んだわが子オネシモのことを、あなたにお願いしたいのです。","tok":[["獄中","ごくちゅう"],["で"],["生んだ","うんだ"],["わが"],["子","こ"],["オネシモ"],["の"],["こと"],["を"],["、"],["あなた"],["に"],["お願い","おねがい"],["したい"],["の"],["です"],["。"]]},{"verse":11,"text":"彼は、前にはあなたにとって役に立たない者でしたが、今は、あなたにとっても私にとっても、役に立つ者となっています。","tok":[["彼","かれ"],["は"],["、"],["前","まえ"],["に"],["は"],["あなた"],["にとって"],["役","やく"],["に"],["立たない","たたない"],["者","もの"],["でした"],["が"],["、"],["今","いま"],["は"],["、"],["あなた"],["にとって"],["も"],["私","わたくし"],["にとって"],["も"],["、"],["役","やく"],["に"],["立つ","たつ"],["者","もの"],["と"],["なって"],["います"],["。"]]},{"verse":12,"text":"そのオネシモを、あなたのもとに送り返します。彼は私の心そのものです。","tok":[["その"],["オネシモ"],["を"],["、"],["あなた"],["の"],["もと"],["に"],["送り返します","おくりかえします"],["。"],["彼","かれ"],["は"],["私","わたくし"],["の"],["心","こころ"],["その"],["もの"],["です"],["。"]]},{"verse":13,"text":"私は、彼を私のところにとどめておき、福音のために獄中にいる間、あなたに代わって私のために仕えてもらいたいとも考えましたが、","tok":[["私","わたくし"],["は"],["、"],["彼","かれ"],["を"],["私","わたくし"],["の"],["ところ"],["に"],["とどめて"],["おき"],["、"],["福音","ふくいん"],["の"],["ため"],["に"],["獄中","ごくちゅう"],["に"],["いる"],["間","あいだ"],["、"],["あなた"],["に"],["代わって","かわって"],["私","わたくし"],["の"],["ため"],["に"],["仕えて","つかえて"],["もらいたい"],["と"],["も"],["考えました","かんがえました"],["が"],["、"]]},{"verse":14,"text":"あなたの同意なしには何一つすまいと思いま
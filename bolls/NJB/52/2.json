[{"verse":1,"text":"兄弟たち。あなたがたが知っているとおり、私たちがあなたがたのところに行ったことは、むだではありませんでした。","tok":[["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["の"],["ところ"],["に"],["行った","いった"],["こと"],["は"],["、"],["むだ"],["で"],["は"],["ありませんでした"],["。"]]},{"verse":2,"text":"ご承知のように、私たちはまずピリピで苦しみに会い、はずかしめを受けたのですが、私たちの神によって、激しい苦闘の中でも大胆に神の福音をあなたがたに語りました。","tok":[["ご承知","ごしょうち"],["の"],["よう"],["に"],["、"],["私たち","わたしたち"],["は"],["まず"],["ピリピ"],["で"],["苦しみ","くるしみ"],["に"],["会い","あい"],["、"],["はずかしめ"],["を"],["受けた","うけた"],["の"],["です"],["が"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["によって"],["、"],["激しい","はげしい"],["苦闘","くとう"],["の"],["中","なか"],["で"],["も"],["大胆","だいたん"],["に"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["あなた"],["がた"],["に"],["語りました","かたりました"],["。"]]},{"verse":3,"text":"私たちの勧めは、迷いや不純な心から出ているものではなく、だましごとでもありません。","tok":[["私たち","わたしたち"],["の"],["勧め","すすめ"],["は"],["、"],["迷い","まよい"],["や"],["不純","ふじゅん"],["な"],["心","こころ"],["から"],["出て","でて"],["いる"],["もの"],["で"],["は"],["なく"],["、"],["だまし"],["ごと"],["で"],["も"],["ありません"],["。"]]},{"verse":4,"text":"私たちは神に認められて福音をゆだねられた者ですから、それにふさわしく、人を喜ばせようとしてではなく、私たちの心をお調べになる神を喜ばせようとして語るのです。","tok":[["私たち","わたしたち"],["は"],["神","かみ"],["に"],["認められて","みとめられて"],["福音","ふくいん"],["を"],["ゆだねられた"],["者","もの"],["です"],["から"],["、"],["それ"],["に"],["ふさわしく"],["、"],["人","ひと"],["を"],["喜ばせよう","よろこばせよう"],["として"],["で"],["は"],["なく"],["、"],["私たち","わたしたち"],["の"],["心","こころ"],["を"],["お調べ","おしらべ"],["に"],["なる"],["神","かみ"],["を"],["喜ばせよう","よろこばせよう"],["として"],["語る","かたる"],["の"],["です"],["。"]]},{"verse":5,"text":"ご存じのとおり、私たちは今まで、へつらいのことばを用いたり、むさぼりの口実を設けたりしたことはありません。神がそのことの証人です。","tok":[["ご存じ","ごぞんじ"],["の"],["とおり"],["、"],["私たち","わたしたち"],["は"],["今まで","いままで"],["、"],["へつらい"],["の"],["ことば"],["を"],["用い","もちい"],["たり"],["、"],["むさぼり"],["の"],["口実","こうじつ"],["を"],["設け","もうけ"],["たり"],["した"],["こと"],["は"],["ありません"],["。"],["神","かみ"],["が"],["その"],["こと"],["の"],["証人","しょうにん"],["です"],["。"]]},{"verse":6,"text":"また、キリストの使徒たちとして権威を主張することもできたのですが、私たちは、あなたがたからも、ほかの人々からも、人からの名誉を受けようとはしませんでした。","tok":[["また"],["、"],["キリスト"],["の"],["使徒","しと"],["たち"],["として"],["権威","けんい"],["を"],["主張","しゅちょう"],["する"],["こと"],["も"],["できた"],["の"],["です"],["が"],["、"],["私たち","わたしたち"],["は"],["、"],["あなた"],["がた"],["から"],["も"],["、"],["ほか"],["の"],["人々","ひとびと"],["から"],["も"],["、"],["人","ひと"],["から"],["の"],["名誉","めいよ"],["を"],["受けよう","うけよう"],["と"],["は"],["しませんでした"],["。"]]},{"verse":7,"text":"それどころか、あなたがたの間で、母がその子どもたちを養い育てるように、優しくふるまいました。","tok":[["それ"],["どころ"],["か"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["、"],["母","はは"],["が"],["その"],["子ども","こども"],["たち"],["を"],["養い育てる","やしないそだてる"],["よう"],["に"],["、"],["優しく","やさしく"],["ふるまいました"],["。"]]},{"verse":8,"text":"このようにあなたがたを思う心から、ただ神の福音だけではなく、私たち自身のいのちまでも、喜んであなたがたに与えたいと思ったのです。なぜなら、あなたがたは私たちの愛する者となったからです。","tok":[["この"],["よう"],["に"],["あなた"],["がた"],["を"],["思う","おもう"],["心","こころ"],["から"],["、"],["ただ"],["神","かみ"],["の"],["福音","ふくいん"],["だけ"],["で"],["は"],["なく"],["、"],["私たち","わたしたち"],["自身","じしん"],["の"],["いのち"],["まで"],["も"],["、"],["喜んで","よろこんで"],["あなた"],["がた"],["に"],["与えたい","あたえたい"],["と"],["思った","おもった"],["の"],["です"],["。"],["なぜ"],["なら"],["、"],["あなた"],["がた"],["は"],["私たち","わたしたち"],["の"],["愛する","あいする"],["者","もの"],["と"],["なった"],["から"],["です"],["。"]]},{"verse":9,"text":"兄弟たち。あなたがたは、私たちの労苦と苦闘を覚えているでしょう。私たちはあなたがたのだれにも負担をかけまいとして、昼も夜も働きながら、神の福音をあなたがたに宣べ伝えました。","tok":[["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["の"],["労苦","ろうく"],["と"],["苦闘","くとう"],["を"],["覚えて","おぼえて"],["いるでしょう"],["。"],["私たち","わたしたち"],["は"],["あなた"],["がた"],["の"],["だれ"],["に"],["も"],["負担","ふたん"],["を"],["かけまい"],["として"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["働き","はたらき"],["ながら"],["、"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["あなた"],["がた"],["に"],["宣べ伝えました","のべつたえました"],["。"]]},{"verse":10,"text":"また、信者であるあなたがたに対して、私たちが敬虔に、正しく、また責められるところがないようにふるまったことは、あなたがたがあかしし、神もあかししてくださることです。","tok":[["また"],["、"],["信者","しんじゃ"],["で"],["ある"],["あなた"],["がた"],["に対して","にたいして"],["、"],["私たち","わたしたち"],["が"],["敬虔","けいけん"],["に"],["、"],["正しく","ただしく"],["、"],["また"],["責められる","せめられる"],["ところ"],["が"],["ない"],["よう"],["に"],["ふるまった"],["こと"],["は"],["、"],["あなた"],["がた"],["が"],["あかし"],["し"],["、"],["神","かみ"],["も"],["あかし"],["して"],["くださる"],["こと"],["です"],["。"]]},{"verse":11,"text":"また、ご承知のとおり、私たちは父がその子どもに対してするように、あなたがたひとりひとりに、","tok":[["また"],["、"],["ご承知","ごしょうち"],["の"],["とおり"],["、"],["私たち","わたしたち"],["は"],["父","ちち"],["が"],["その"],["子ども","こども"],["に対して","にたいして"],["する"],["よう"],["に"],["、"],["あなた"],["がた"],["ひとりひとり"],["に"],["、"]]},{"verse":12,"text":"ご自身の御国と栄光とに召してくださる神にふさわしく歩むように勧めをし、慰めを与え、おごそかに命じました。","tok":[["ご自身","ごじしん"],["の"],["御国","みくに"],["と"],["栄光","えいこう"],["と"],["に"],["召して","めして"],["くださる"],["神","かみ"],["に"],["ふさわしく"],["歩む","あゆむ"],["よう"],["に"],["勧め","すすめ"],["を"],["し"],["、"],["慰め","なぐさめ"],["を"],["与え","あたえ"],["、"],["おごそか"],["に"],["命じました","めいじました"],["。"]]},{"verse":13,"text":"こういうわけで、私たちとしてもまた、絶えず神に感謝しています。あなたがたは、私たちから神の使信のことばを受けたとき、それを人間のことばとしてではなく、事実どおりに神のことばとして受け入れてくれたからです。この神のことばは、信じているあなたがたのうちに働いているのです。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["私たち","わたしたち"],["として"],["も"],["また"],["、"],["絶えず","たえず"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["います"],["。"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["から"],["神","かみ"],["の"],["使信","ししん"],["の"],["ことば"],["を"],["受けた","うけた"],["とき"],["、"],["それ"],["を"],["人間","にんげん"],["の"],["ことば"],["として"],["で"],["は"],["なく"],["、"],["事実","じじつ"],["どおり"],["に"],["神","かみ"],["の"],["ことば"],["として"],["受け入れて","うけいれて"],["くれた"],["から"],["です"],["。"],["この"],["神","かみ"],["の"],["ことば"],["は"],["、"],["信じて","しんじて"],["いる"],["あなた"],["がた"],["の"],["うち"],["に"],["働いて","はたらいて"],["いる"],["の"],["です"],["。"]]},{"verse":14,"text":"兄弟たち。あなたがたはユダヤの、キリスト・イエスにある神の諸教会にならう者となったのです。彼らがユダヤ人に苦しめられたのと同じように、あなたがたも自分の国の人に苦しめられたのです。","tok":[["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["は"],["ユダヤ"],["の"],["、"],["キリスト"],["・"],["イエス"],["に"],["ある"],["神","かみ"],["の"],["諸教","しょきょう"],["会","かい"],["に"],["ならう"],["者","もの"],["と"],["なった"],["の"],["です"],["。"],["彼","かれ"],["ら"],["が"],["ユダヤ人","ゆだやじん"],["に"],["苦しめられた","くるしめられた"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["自分","じぶん"],["の"],["国","くに"],["の"],["人","ひと"],["に"],["苦しめられた","くるしめられた"],["の"],["です"],["。"]]},{"verse":15,"text":"ユダヤ人は、主であられるイエスをも、預言者たちをも殺し、また私たちをも追い出し、神に喜ばれず、すべての人の敵となっています。","tok":[["ユダヤ人","ゆだやじん"],["は"],["、"],["主","ぬし"],["で"],["あられる"],["イエス"],["を"],["も"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["も"],["殺し","ころし"],["、"],["また"],["私たち","わたしたち"],["を"],["も"],["追い出し","おいだし"],["、"],["神","かみ"],["に"],["喜ばれず","よろこばれず"],["、"],["すべて"],["の"],["人","ひと"],["の"],["敵","てき"],["と"],["なって"],["います"],["。"]]},{"verse":16,"text":"彼らは、私たちが異邦人の救いのために語るのを妨げ、このようにして、いつも自分の罪を満たしています。しかし、御怒りは彼らの上に臨んで窮みに達しました。","tok":[["彼","かれ"],["ら"],["は"],["、"],["私たち","わたしたち"],["が"],["異邦人","いほうじん"],["の"],["救い","すくい"],["の"],["ため"],["に"],["語る","かたる"],["の"],["を"],["妨げ","さまたげ"],["、"],["この"],["よう"],["に"],["して"],["、"],["いつも"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["満たして","みたして"],["います"],["。"],["しかし"],["、"],["御怒り","おいかり"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["臨んで","のぞんで"],["窮み","きわみ"],["に"],["達しました","たっしました"],["。"]]},{"verse":17,"text":"兄弟たちよ。私たちは、しばらくの間あなたがたから引き離されたので――といっても、顔を見ないだけで、心においてではありませんが、――なおさらのこと、あなたがたの顔を見たいと切に願っていました。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["私たち","わたしたち"],["は"],["、"],["しばらく"],["の"],["間","あいだ"],["あなた"],["がた"],["から"],["引き離された","ひきはなされた"],["ので"],["―"],["―"],["と"],["いって"],["も"],["、"],["顔","かお"],["を"],["見ない","みない"],["だけ"],["で"],["、"],["心","こころ"],["に"],["おいて"],["で"],["は"],["ありません"],["が"],["、"],["―"],["―"],["なおさら"],["の"],["こと"],["、"],["あなた"],["がた"],["の"],["顔","かお"],["を"],["見たい","みたい"],["と"],["切に","せつに"],["願って","ねがって"],["いました"],["。"]]},{"verse":18,"text":"それで私たちは、あなたがたのところに行こうとしました。このパウロは一度ならず二度までも心を決めたのです。しかし、サタンが私たちを妨げました。","tok":[["それ"],["で"],["私たち","わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["行こう","いこう"],["と"],["しました"],["。"],["この"],["パウロ"],["は"],["一度","いちど"],["ならず"],["二","に"],["度","ど"],["まで"],["も"],["心","こころ"],["を"],["決めた","きめた"],["の"],["です"],["。"],["しかし"],["、"],["サタン"],["が"],["私たち","わたしたち"],["を"],["妨げました","さまたげました"],["。"]]},{"verse":19,"text":"私たちの主イエスが再び来られるとき、御前で私たちの望み、喜び、誇りの冠となるのはだれでしょう。あなたがたではありませんか
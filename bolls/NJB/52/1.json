[{"verse":1,"text":"パウロ、シルワノ、テモテから、父なる神および主イエス・キリストにあるテサロニケ人の教会へ。恵みと平安があなたがたの上にありますように。","tok":[["パウロ"],["、"],["シルワノ"],["、"],["テモテ"],["から"],["、"],["父","ちち"],["なる"],["神","かみ"],["および"],["主","しゅ"],["イエス"],["・"],["キリスト"],["に"],["ある"],["テサロニケ"],["人","にん"],["の"],["教会","きょうかい"],["へ"],["。"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"]]},{"verse":2,"text":"私たちは、いつもあなたがたすべてのために神に感謝し、祈りのときにあなたがたを覚え、","tok":[["私たち","わたしたち"],["は"],["、"],["いつも"],["あなた"],["がた"],["すべて"],["の"],["ため"],["に"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["、"],["祈り","いのり"],["の"],["とき"],["に"],["あなた"],["がた"],["を"],["覚え","おぼえ"],["、"]]},{"verse":3,"text":"絶えず、私たちの父なる神の御前に、あなたがたの信仰の働き、愛の労苦、主イエス・キリストへの望みの忍耐を思い起こしています。","tok":[["絶えず","たえず"],["、"],["私たち","わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["の"],["働き","はたらき"],["、"],["愛","あい"],["の"],["労苦","ろうく"],["、"],["主","しゅ"],["イエス"],["・"],["キリスト"],["へ"],["の"],["望み","のぞみ"],["の"],["忍耐","にんたい"],["を"],["思い起こして","おもいおこして"],["います"],["。"]]},{"verse":4,"text":"神に愛されている兄弟たち。あなたがたが神に選ばれた者であることは私たちが知っています。","tok":[["神","かみ"],["に"],["愛されて","あいされて"],["いる"],["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["が"],["神","かみ"],["に"],["選ばれた","えらばれた"],["者","もの"],["で"],["ある"],["こと"],["は"],["私たち","わたしたち"],["が"],["知って","しって"],["います"],["。"]]},{"verse":5,"text":"なぜなら、私たちの福音があなたがたに伝えられたのは、ことばだけによったのではなく、力と聖霊と強い確信とによったからです。また、私たちがあなたがたのところで、あなたがたのために、どのようにふるまったかは、あなたがたが知っています。","tok":[["なぜ"],["なら"],["、"],["私たち","わたしたち"],["の"],["福音","ふくいん"],["が"],["あなた"],["がた"],["に"],["伝えられた","つたえられた"],["の"],["は"],["、"],["ことば"],["だけ"],["に"],["よった"],["ので"],["は"],["なく"],["、"],["力","ちから"],["と"],["聖霊","せいれい"],["と"],["強い","つよい"],["確信","かくしん"],["と"],["に"],["よった"],["から"],["です"],["。"],["また"],["、"],["私たち","わたしたち"],["が"],["あなた"],["がた"],["の"],["ところ"],["で"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["どの"],["よう"],["に"],["ふるまった"],["か"],["は"],["、"],["あなた"],["がた"],["が"],["知って","しって"],["います"],["。"]]},{"verse":6,"text":"あなたがたも、多くの苦難の中で、聖霊による喜びをもってみことばを受け入れ、私たちと主とにならう者になりました。","tok":[["あなた"],["がた"],["も"],["、"],["多く","おおく"],["の"],["苦難","くなん"],["の"],["中","なか"],["で"],["、"],["聖霊","せいれい"],["に"],["よる"],["喜び","よろこび"],["を"],["もって"],["み"],["ことば"],["を"],["受け入れ","うけいれ"],["、"],["私たち","わたしたち"],["と"],["主","ぬし"],["と"],["に"],["ならう"],["者","もの"],["に"],["なりました"],["。"]]},{"verse":7,"text":"こうして、あなたがたは、マケドニヤとアカヤとのすべての信者の模範になったのです。","tok":[["こう"],["して"],["、"],["あなた"],["がた"],["は"],["、"],["マケドニヤ"],["と"],["アカヤ"],["と"],["の"],["すべて"],["の"],["信者","しんじゃ"],["の"],["模範","もはん"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":8,"text":"主のことばが、あなたがたのところから出てマケドニヤとアカヤに響き渡っただけでなく、神に対するあなたがたの信仰はあらゆる所に伝わっているので、私たちは何も言わなくてよいほどです。","tok":[["主","ぬし"],["の"],["ことば"],["が"],["、"],["あなた"],["がた"],["の"],["ところ"],["から"],["出て","でて"],["マケドニヤ"],["と"],["アカヤ"],["に"],["響き","ひびき"],["渡った","わたった"],["だけ"],["で"],["なく"],["、"],["神","かみ"],["に"],["対する","たいする"],["あなた"],["がた"],["の"],["信仰","しんこう"],["は"],["あらゆる"],["所","ところ"],["に"],["伝わって","つたわって"],["いる"],["ので"],["、"],["私たち","わたしたち"],["は"],["何","なん"],["も"],["言わなくて","いわなくて"],["よい"],["ほど"],["です"],["。"]]},{"verse":9,"text":"私たちがどのようにあなたがたに受け入れられたか、また、あなたがたがどのように偶像から神に立ち返って、生けるまことの神に仕えるようになり、","tok":[["私たち","わたしたち"],["が"],["どの"],["よう"],["に"],["あなた"],["がた"],["に"],["受け入れられた","うけいれられた"],["か"],["、"],["また"],["、"],["あなた"],["がた"],["が"],["どの"],["よう"],["に"],["偶像","ぐうぞう"],["から"],["神","かみ"],["に"],["立ち返って","たちかえって"],["、"],["生ける","いける"],["まこと"],["の"],["神","かみ"],["に"],["仕える","つかえる"],["よう"],["に"],["なり"],["、"]]},{"verse":10,"text":"また、神が死者の中からよみがえらせなさった御子、すなわち、やがて来る御怒りから私たちを救い出してくださるイエスが天から来られるのを待ち望むようになったか、それらのことは他の人々が言い広めているのです。","tok":[["また"],["、"],["神","かみ"],["が"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせ"],["なさった"],["御子","みこ"],["、"],["すなわち"],["、"],["やがて"],["来る","くる"],["御怒り","おいかり"],["から"],["私たち","わたしたち"],["を"],["救い出して","すくいだして"],["くださる"],["イエス"],["が"],["天","てん"],["から"],["来られる","こられる"],["の"],["を"],["待ち望む","まちのぞむ"],["よう"],["に"],["なった"],["か"],["、"],["それ"],["ら"],["の"],["こと"],["は"],["他","た"],["の"],["人々","ひとびと"],["が"],["言い広めて","いいひろめて"],["いる"],["の"],["です"],["。"]]}]
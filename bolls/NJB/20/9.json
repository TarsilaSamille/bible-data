[{"verse":1,"text":"知恵は自分の家を建て、七つの柱を据え、","tok":[["知恵","ちえ"],["は"],["自分","じぶん"],["の"],["家","いえ"],["を"],["建て","たて"],["、"],["七","なな"],["つ"],["の"],["柱","はしら"],["を"],["据え","すえ"],["、"]]},{"verse":2,"text":"いけにえをほふり、ぶどう酒に混ぜ物をし、その食卓も整え、","tok":[["いけにえ"],["を"],["ほふり"],["、"],["ぶどう酒","ぶどうしゅ"],["に"],["混ぜ物","まぜもの"],["を"],["し"],["、"],["その"],["食卓","しょくたく"],["も"],["整え","ととのえ"],["、"]]},{"verse":3,"text":"小娘にことづけて、町の高い所で告げさせた。","tok":[["小娘","こむすめ"],["に"],["ことづけて"],["、"],["町","まち"],["の"],["高い","たかい"],["所","ところ"],["で"],["告げさせた","つげさせた"],["。"]]},{"verse":4,"text":"「わきまえのない者はだれでも、ここに来なさい」と。／また、思慮に欠けた者に言う。","tok":[["「"],["わきまえ"],["の"],["ない"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["ここ"],["に"],["来","き"],["なさい"],["」"],["と"],["。"],["／"],["また"],["、"],["思慮","しりょ"],["に"],["欠けた","かけた"],["者","もの"],["に"],["言う","ゆう"],["。"]]},{"verse":5,"text":"「わたしの食事を食べに来なさい。／わたしの混ぜ合わせたぶどう酒を飲み、","tok":[["「"],["わたし"],["の"],["食事","しょくじ"],["を"],["食べ","たべ"],["に"],["来","き"],["なさい"],["。"],["／"],["わたし"],["の"],["混ぜ合わせた","まぜあわせた"],["ぶどう酒","ぶどうしゅ"],["を"],["飲み","のみ"],["、"]]},{"verse":6,"text":"わきまえのないことを捨てて、生きなさい。／悟りのある道を、まっすぐ歩みなさい」と。","tok":[["わきまえ"],["の"],["ない"],["こと"],["を"],["捨てて","すてて"],["、"],["生き","いき"],["なさい"],["。"],["／"],["悟り","さとり"],["の"],["ある"],["道","みち"],["を"],["、"],["まっすぐ"],["歩み","あゆみ"],["なさい"],["」"],["と"],["。"]]},{"verse":7,"text":"あざける者を戒める者は、自分が恥を受け、悪者を責める者は、自分が傷を受ける。","tok":[["あざける"],["者","もの"],["を"],["戒める","いましめる"],["者","もの"],["は"],["、"],["自分","じぶん"],["が"],["恥","はじ"],["を"],["受け","うけ"],["、"],["悪者","わるもの"],["を"],["責める","せめる"],["者","もの"],["は"],["、"],["自分","じぶん"],["が"],["傷","きず"],["を"],["受ける","うける"],["。"]]},{"verse":8,"text":"あざける者を責めるな。／おそらく、彼はあなたを憎むだろう。／知恵のある者を責めよ。／そうすれば、彼はあなたを愛するだろう。","tok":[["あざける"],["者","もの"],["を"],["責める","せめる"],["な"],["。"],["／"],["おそらく"],["、"],["彼","かれ"],["は"],["あなた"],["を"],["憎むだろう","にくむだろう"],["。"],["／"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["を"],["責めよ","せめよ"],["。"],["／"],["そう"],["すれば"],["、"],["彼","かれ"],["は"],["あなた"],["を"],["愛するだろう","あいするだろう"],["。"]]},{"verse":9,"text":"知恵のある者に与えよ。／彼はますます
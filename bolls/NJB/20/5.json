[{"verse":1,"text":"わが子よ。私の知恵に心を留め、私の英知に耳を傾けよ。","tok":[["わが"],["子","こ"],["よ"],["。"],["私","わたくし"],["の"],["知恵","ちえ"],["に"],["心","こころ"],["を"],["留め","とめ"],["、"],["私","わたくし"],["の"],["英知","えいち"],["に"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"]]},{"verse":2,"text":"これは、分別を守り、あなたのくちびるが知識を保つためだ。","tok":[["これ"],["は"],["、"],["分別","ぶんべつ"],["を"],["守り","まもり"],["、"],["あなた"],["の"],["くちびる"],["が"],["知識","ちしき"],["を"],["保つ","たもつ"],["ため"],["だ"],["。"]]},{"verse":3,"text":"他国の女のくちびるは蜂の巣の蜜をしたたらせ、その口は油よりもなめらかだ。","tok":[["他国","たこく"],["の"],["女","おんな"],["の"],["くちびる"],["は"],["蜂の巣","はちのす"],["の"],["蜜","みつ"],["を"],["したたらせ"],["、"],["その"],["口","くち"],["は"],["油","あぶら"],["より"],["も"],["なめらか"],["だ"],["。"]]},{"verse":4,"text":"しかし、その終わりは苦よもぎのように苦く、もろ刃の剣のように鋭い。","tok":[["しかし"],["、"],["その"],["終わり","おわり"],["は"],["苦","く"],["よもぎ"],["の"],["よう"],["に"],["苦く","にがく"],["、"],["もろ刃","もろは"],["の"],["剣","けん"],["の"],["よう"],["に"],["鋭い","するどい"],["。"]]},{"verse":5,"text":"その足は死に下り、その歩みはよみに通じている。","tok":[["その"],["足","あし"],["は"],["死","し"],["に"],["下り","くだり"],["、"],["その"],["歩み","あゆみ"],["は"],["よみ"],["に"],["通じて","つうじて"],["いる"],["。"]]},{"verse":6,"text":"その女はいのちの道に心を配らず、その道筋は確かでないが、彼女はそれを知らない。","tok":[["その"],["女","おんな"],["は"],["いのち"],["の"],["道","みち"],["に"],["心","こころ"],["を"],["配らず","くばらず"],["、"],["その"],["道筋","みちすじ"],["は"],["確か","たしか"],["で"],["ない"],["が"],["、"],["彼女","かのじょ"],["は"],["それ"],["を"],["知らない","しらない"],["。"]]},{"verse":7,"text":"子どもらよ。今、私に聞け。／私の言うことばから離れるな。","tok":[["子ども","こども"],["ら"],["よ"],["。"],["今","いま"],["、"],["私","わたくし"],["に"],["聞け","きけ"],["。"],["／"],["私","わたくし"],["の"],["言う","いう"],["ことば"],["から"],["離れる","はなれる"],["な"],["。"]]},{"verse":8,"text":"あなたの道を彼女から遠ざけ、その家の門に近づくな。","tok":[["あなた"],["の"],["道","みち"],["を"],["彼女","かのじょ"],["から"],["遠ざけ","とおざけ"],["、"],["その"],["家","いえ"],["の"],["門","もん"],["に"],["近づく","ちかづく"],["な"],["。"]]},{"verse":9,"text":"そうでないと、あなたの尊厳を他人に渡し、あなたの年を残忍な者に渡すだろう。","tok":[["そう"],["で"],["ない"],["と"],["、"],["あなた"],["の"],["尊厳","そんげん"],["を"],["他人","たにん"],["に"],["渡し","わたし"],["、"],["あなた"],["の"],["年","とし"],["を"],["残忍","ざんにん"],
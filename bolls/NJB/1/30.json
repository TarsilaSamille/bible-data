[{"verse":1,"text":"ラケルは自分がヤコブに子を産んでいないのを見て、姉を嫉妬し、ヤコブに言った。「私に子どもを下さい。でなければ、私は死んでしまいます。」","tok":[["ラケル"],["は"],["自分","じぶん"],["が"],["ヤコブ"],["に"],["子","こ"],["を"],["産んで","うんで"],["いない"],["の"],["を"],["見て","みて"],["、"],["姉","あね"],["を"],["嫉妬","しっと"],["し"],["、"],["ヤコブ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["子ども","こども"],["を"],["下さい","ください"],["。"],["で"],["なければ"],["、"],["私","わたくし"],["は"],["死んで","しんで"],["しまいます"],["。"],["」"]]},{"verse":2,"text":"ヤコブはラケルに怒りを燃やして言った。「私が神に代わることができようか。おまえの胎内に子を宿らせないのは神なのだ。」","tok":[["ヤコブ"],["は"],["ラケル"],["に"],["怒り","いかり"],["を"],["燃やして","もやして"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["神","かみ"],["に"],["代わる","かわる"],["こと"],["が"],["できよう"],["か"],["。"],["おまえ"],["の"],["胎内","たいない"],["に"],["子","こ"],["を"],["宿らせない","やどらせない"],["の"],["は"],["神","かみ"],["な"],["の"],["だ"],["。"],["」"]]},{"verse":3,"text":"すると彼女は言った。「では、私のはしためのビルハがいます。彼女のところに入り、彼女が私のひざの上に子を産むようにしてください。そうすれば私が彼女によって子どもの母になれましょう。」","tok":[["する"],["と"],["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["私","わたくし"],["の"],["はし"],["ため"],["の"],["ビルハ"],["が"],["います"],["。"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入り","はいり"],["、"],["彼女","かのじょ"],["が"],["私","わたくし"],["の"],["ひざ"],["の"],["上","うえ"],["に"],["子","こ"],["を"],["産む","うむ"],["よう"],["に"],["して"],["ください"],["。"],["そう"],["すれば"],["私","わたくし"],["が"],["彼女","かのじょ"],["によって"],["子ども","こども"],["の"],["母","はは"],["に"],["なれましょう"],["。"],["」"]]},{"verse":4,"text":"ラケルは女奴隷ビルハを彼に妻として与えたので、ヤコブは彼女のところに入った。","tok":[["ラケル"],["は"],["女","じょ"],["奴隷","どれい"],["ビルハ"],["を"],["彼","かれ"],["に"],["妻","つま"],["として"],["与えた","あたえた"],["ので"],["、"],["ヤコブ"],["は"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入った","はいった"],["。"]]},{"verse":5,"text":"ビルハはみごもり、ヤコブに男の子を産んだ。","tok":[["ビルハ"],["は"],["みごもり"],["、"],["ヤコブ"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":6,"text":"そこでラケルは、「神は私をかばってくださり、私の声を聞き入れて、私に男の子を賜った」と言った。それゆえ、その子をダンと名づけた。","tok":[["そこ"],["で"],["ラケル"],["は"],["、"],["「"],["神","かみ"],["は"],["私","わたくし"],["を"],["かばって"],["くださり"],["、"],["私","わたくし"],["の"],["声","こえ"],["を"],["聞き入れて","ききいれて"],["、"],["私","わたくし"],["に"],["男の子","おとこのこ"],["を"],["賜った","たまわった"],["」"],["と"],["言った","いった"],["。"],["それ"],["ゆえ"],["、"],["その"],["子","こ"],["を"],["ダン"],["と"],["名づけた","なづけた"],["。"]]},{"verse":7,"text":"ラケルの女奴隷ビルハは、またみごもって、ヤコブに二番目の男の子を産んだ。","tok":[["ラケル"],["の"],["女","おんな"],["奴隷","どれい"],["ビルハ"],["は"],["、"],["また"],["みごもって"],["、"],["ヤコブ"],["に"],["二番目","にばんめ"],["の"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":8,"text":"そこでラケルは、「私は姉と死に物狂いの争いをして、ついに勝った」と言って、その子をナフタリと名づけた。","tok":[["そこ"],["で"],["ラケル"],["は"],["、"],["「"],["私","わたくし"],["は"],["姉","あね"],["と"],["死に","しに"],["物狂い","ものぐるい"],["の"],["争い","あらそい"],["を"],["して"],["、"],["ついに"],["勝った","かった"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["ナフタリ"],["と"],["名づけた","なづけた"],["。"]]},{"verse":9,"text":"さてレアは自分が子を産まなくなったのを見て、彼女の女奴隷ジルパをとって、ヤコブに妻として与えた。","tok":[["さて"],["レア"],["は"],["自分","じぶん"],["が"],["子","こ"],["を"],["産まなく","うまなく"],["なった"],["の"],["を"],["見て","みて"],["、"],["彼女","かのじょ"],["の"],["女","おんな"],["奴隷","どれい"],["ジルパ"],["を"],["とって"],["、"],["ヤコブ"],["に"],["妻","つま"],["として"],["与えた","あたえた"],["。"]]},{"verse":10,"text":"レアの女奴隷ジルパがヤコブに男の子を産んだとき、","tok":[["レア"],["の"],["女","おんな"],["奴隷","どれい"],["ジルパ"],["が"],["ヤコブ"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["とき"],["、"]]},{"verse":11,"text":"レアは、「幸運が来た」と言って、その子をガドと名づけた。","tok":[["レア"],["は"],["、"],["「"],["幸運","こううん"],["が"],["来た","きた"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["ガド"],["と"],["名づけた","なづけた"],["。"]]},{"verse":12,"text":"レアの女奴隷ジルパがヤコブに二番目の男の子を産んだとき、","tok":[["レア"],["の"],["女","おんな"],["奴隷","どれい"],["ジルパ"],["が"],["ヤコブ"],["に"],["二番目","にばんめ"],["の"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["とき"],["、"]]},{"verse":13,"text":"レアは、「なんとしあわせなこと。女たちは、私をしあわせ者と呼ぶでしょう」と言って、その子をアシェルと名づけた。","tok":[["レア"],["は"],["、"],["「"],["なん"],["と"],["しあわせ"],["な"],["こと"],["。"],["女","おんな"],["たち"],["は"],["、"],["私","わたくし"],["を"],["しあわせ者","しあわせもの"],["と"],["呼ぶでしょう","よぶでしょう"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["アシェル"],["と"],["名づけた","なづけた"],["。"]]},{"verse":14,"text":"さて、ルベ
[{"verse":1,"text":"アブラムが九十九歳になったとき主はアブラムに現れ、こう仰せられた。「わたしは全能の神である。あなたはわたしの前を歩み、全き者であれ。","tok":[["アブラム"],["が"],["九十九歳","きゅうじゅうきゅうさい"],["に"],["なった"],["とき"],["主","ぬし"],["は"],["アブラム"],["に"],["現れ","あらわれ"],["、"],["こう"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["全能","ぜんのう"],["の"],["神","かみ"],["で"],["ある"],["。"],["あなた"],["は"],["わたし"],["の"],["前","まえ"],["を"],["歩み","あゆみ"],["、"],["全","ぜん"],["き者","きしゃ"],["で"],["あれ"],["。"]]},{"verse":2,"text":"わたしは、わたしの契約を、わたしとあなたとの間に立てる。わたしは、あなたをおびただしくふやそう。」","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["、"],["わたし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["に"],["立てる","たてる"],["。"],["わたし"],["は"],["、"],["あなた"],["を"],["おびただしく"],["ふやそう"],["。"],["」"]]},{"verse":3,"text":"アブラムは、ひれ伏した。神は彼に告げて仰せられた。","tok":[["アブラム"],["は"],["、"],["ひれ伏した","ひれふした"],["。"],["神","かみ"],["は"],["彼","かれ"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":4,"text":"「わたしは、この、わたしの契約をあなたと結ぶ。あなたは多くの国民の父となる。","tok":[["「"],["わたし"],["は"],["、"],["この"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["あなた"],["と"],["結ぶ","むすぶ"],["。"],["あなた"],["は"],["多く","おおく"],["の"],["国民","こくみん"],["の"],["父","ちち"],["と"],["なる"],["。"]]},{"verse":5,"text":"あなたの名は、もう、アブラムと呼んではならない。あなたの名はアブラハムとなる。わたしが、あなたを多くの国民の父とするからである。","tok":[["あなた"],["の"],["名","な"],["は"],["、"],["もう"],["、"],["アブラム"],["と"],["呼んで","よんで"],["は"],["ならない"],["。"],["あなた"],["の"],["名","な"],["は"],["アブラハム"],["と"],["なる"],["。"],["わたし"],["が"],["、"],["あなた"],["を"],["多く","おおく"],["の"],["国民","こくみん"],["の"],["父","ちち"],["と"],["する"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"わたしは、あなたの子孫をおびただしくふやし、あなたを幾つかの国民とする。あなたから、王たちが出て来よう。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["おびただしく"],["ふやし"],["、"],["あなた"],["を"],["幾つ","いくつ"],["か"],["の"],["国民","こくみん"],["と"],["する"],["。"],["あなた"],["から"],["、"],["王","おう"],["たち"],["が"],["出て","でて"],["来よう","こよう"],["。"]]},{"verse":7,"text":"わたしは、わたしの契約を、わたしとあなたとの間に、そしてあなたの後のあなたの子孫との間に、代々にわたる永遠の契約として立てる。わたしがあなたの神、あなたの後の子孫の神となるためである。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["、"],["わたし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["に"],["、"],["そして"],["あなた"],["の"],["後","あと"],["の"],["あなた"],["の"],["子孫","しそん"],["と"],["の"],["間","あいだ"],["に"],["、"],["代々","だいだい"],["に"],["わたる"],["永遠","えいえん"],["の"],["契約","けいやく"],["として"],["立てる","たてる"],["。"],["わたし"],["が"],["あなた"],["の"],["神","かみ"],["、"],["あなた"],["の"],["後","あと"],["の"],["子孫","しそん"],["の"],["神","かみ"],["と"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"わたしは、あなたが滞在している地、すなわちカナンの全土を、あなたとあなたの後のあなたの子孫に永遠の所有として与える。わたしは、彼らの神となる。」","tok":[["わたし"],["は"],["、"],["あなた"],["が"],["滞在","たいざい"],["して"],["いる"],["地","ち"],["、"],["すなわち"],["カナン"],["の"],["全土","ぜんど"],["を"],["、"],["あなた"],["と"],["あなた"],["の"],["後","あと"],["の"],["あなた"],["の"],["子孫","しそん"],["に"],["永遠","えいえん"],["の"],["所有","しょゆう"],["として"],["与える","あたえる"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"],["」"]]},{"verse":9,"text":"ついで、神はアブラハムに仰せられた。「あなたは、あなたの後のあなたの子孫とともに、代々にわたり、わたしの契約を守らなければならない。","tok":[["つい"],["で"],["、"],["神","かみ"],["は"],["アブラハム"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["あなた"],["の"],["後","あと"],["の"],["あなた"],["の"],["子孫","しそん"],["と"],["とも"],["に"],["、"],["代々","だいだい"],["に"],["わたり"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":10,"text":"次のことが、わたしとあなたがたと、またあなたの後のあなたの子孫との間で、あなたがたが守るべきわたしの契約である。あなたがたの中のすべての男子は割礼を受けなさい。","tok":[["次","つぎ"],["の"],["こと"],["が"],["、"],["わたし"],["と"],["あなた"],["がた"],["と"],["、"],["また"],["あなた"],["の"],["後","あと"],["の"],["あなた"],["の"],["子孫","しそん"],["と"],["の"],["間","あいだ"],["で"],["、"],["あなた"],["がた"],["が"],["守るべき","まもるべき"],["わたし"],["の"],["契約","けいやく"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["中","なか"],["の"],["すべて"],["の"],["男子","だんし"],["は"],["割礼","かつれい"],["を"],["受け","うけ"],["なさい"],["。"]]},{"verse":11,"text":"あなたがたは、あなたがたの包皮の肉を切り捨てなさい。それが、わたしとあなたがたの間の契約のしるしである。","tok":[["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["包皮","ほうひ"],["の"],["肉","にく"],["を"],["切り捨て","きりすて"],["なさい"],["。"],["それ"],["が"],["、"],["わたし"],["と"],["あなた"],["がた"],["の"],["間","あいだ"],["の"],["契約","けいやく"],["の"],["しるし"],["で"],["ある"],["。"]]},{"verse":12,"text":"あなたがたの中の男子はみな、代々にわたり、生まれて八日目に、割礼を受けなければならない。家で生まれたしもべも、外国人から金で買い取られたあなたの子孫ではない者も。","tok":[["あなた"],["がた"],["の"],["中","なか"],["の"],["男子","だんし"],["は"],["みな"],["、"],["代々","だいだい"],["に"],["わたり"],["、"],["生まれて","うまれて"],["八日目","ようかめ"],["に"],["、"],["割礼","かつれい"],["を"],["受けなければ","うけなければ"],["ならない"],["。"],["家","いえ"],["で"],["生まれた","うまれた"],["しもべ"],["も"],["、"],["外国人","がいこくじん"],["から"],["金","かね"],["で"],["買い取られた","かいとられた"],["あなた"],["の"],["子孫","しそん"],["で"],["は"],["ない"],["者","もの"],["も"],["。"]]},{"verse":13,"text":"あなたの家で生まれたしもべも、あなたが金で買い取った者も、必ず割礼を受けなければならない。わたしの契約は、永遠の契約として、あなたがたの肉の上にしるされなければならない。","tok":[["あなた"],["の"],["家","いえ"],["で"],["生まれた","うまれた"],["しもべ"],["も"],["、"],["あなた"],["が"],["金","かね"],["で"],["買い取った","かいとった"],["者","もの"],["も"],["、"],["必ず","かならず"],["割礼","かつれい"],["を"],["受けなければ","うけなければ"],["ならない"],["。"],["わたし"],["の"],["契約","けいやく"],["は"],["、"],["永遠","えいえん"],["の"],["契約","けいやく"],["として"],["、"],["あなた"],["がた"],["の"],["肉","にく"],["の"],["上","うえ"],["に"],["しるされなければ"],["ならない"],["。"]]},{"verse":14,"text":"包皮の肉を切り捨てられていない無割礼の男、そのような者は、その民から断ち切られなければならない。わたしの契約を破ったのである。」","tok":[["包皮","ほうひ"],["の"],["肉","にく"],["を"],["切り捨てられて","きりすてられて"],["いない"],["無","む"],["割礼","かつれい"],["の"],["男","おとこ"],["、"],["その"],["よう"],["な"],["者","もの"],["は"],["、"],["その"],["民","たみ"],["から"],["断ち切られなければ","たちきられなければ"],["ならない"],["。"],["わたし"],["の"],["契約","けいやく"],["を"],["破った","やぶった"],["ので"],["ある"],["。"],["」"]]},{"verse":15,"text":"また、神はアブラハムに仰せられた。「あなたの妻サライのことだが、その名をサライと呼んではならない。その名はサラとなるからだ。","tok":[["また"],["、"],["神","かみ"],["は"],["アブラハム"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["妻","つま"],["サライ"],["の"],["こと"],["だ"],["が"],["、"],["その"],["名","な"],["を"],["サライ"],["と"],["呼んで","よんで"],["は"],["ならない"],["。"],["その"],["名","な"],["は"],["サラ"],["と"],["なる"],["から"],["だ"],["。"]]},{"verse":16,"text":"わたしは彼女を祝福しよう。確かに、彼女によって、あなたにひとりの男の子を与えよう。わたしは彼女を祝福する。彼女は国々の母となり、国々の民の王たちが、彼女から出て来る。」","tok":[["わたし"],["は"],["彼女","かのじょ"],["を"],["祝福","しゅくふく"],["しよう"],["。"],["確か","たしか"],["に"],["、"],["彼女","かのじょ"],["によって"],["、"],["あなた"],["に"],["ひとり"],["の"],["男の子","おとこのこ"],["を"],["与えよう","あたえよう"],["。"],["わたし"],["は"],["彼女","かのじょ"],["を"],["祝福","しゅくふく"],["する"],["。"],["彼女","かのじょ"],["は"],["国々","くにぐに"],["の"],["母","はは"],["と"],["なり"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["王","おう"],["たち"],["が"],["、"],["彼女","かのじょ"],["から"],["出て","でて"],["来る","くる"],["。"],["」"]]},{"verse":17,"text":"アブラハムはひれ伏し、そして笑ったが、心の中で言った。「百歳の者に子どもが生まれようか。サラにしても、九十歳の女が子を産むことができようか。」","tok":[["アブラハム"],["は"],["ひれ伏し","ひれふし"],["、"],["そして"],["笑った","わらった"],["が"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["言った","いった"],["。"],["「"],["百歳","ひゃくさい"],["の"],["者","もの"],["に"],["子ども","こども"],["が"],["生まれよう","うまれよう"],["か"],["。"],["サラ"],["に"],["して"],["も"],["、"],["九十歳","きゅうじゅうさい"],["の"],["女","おんな"],["が"],["子","こ"],["を"],["産む","うむ"],["こと"],["が"],["できよう"],["か"],["。"],["」"]]},{"verse":18,"text":"そして、アブラハムは神に申し上げた。「どうかイシュマエルが、あなたの御前で生きながらえますように。」","tok":[["そして"],["、"],["アブラハム"],["は"],["神","かみ"],["に"],["申し上げた","もうしあげた"],["。"],["「"],["どう"],["か"],["イシュマエル"],["が"],["、"],["あなた"],["の"],["御前","ごぜん"],["で"],["生きながらえます","いきながらえます"],["よう"],["に"],["。"],["」"]]},{"verse":19,"text":"すると神は仰せられた。「いや、あなたの妻サラが、あなたに男の子を産むのだ。あなたはその子をイサクと名づけなさい。わたしは彼とわたしの契約を立て、それを彼の後の子孫のために永遠の契約とする。","tok":[["する"],["と"],["神","かみ"],["は"],["仰せられた","おおせられた"],["。"],["「"],["いや"],["、"],["あなた"],["の"],["妻","つま"],["サラ"],["が"],["、"],["あなた"],["に"],["男の子","おとこのこ"],["を"],["産む","うむ"],["の"],["だ"],["。"],["あなた"],["は"],["その"],["子","こ"],["を"],["イサク"],["と"],["名づけ","なづけ"],["なさい"],["。"],["わたし"],["は"],["彼","かれ"],["と"],["わたし"],["の"],["契約","けいやく"],["を"],["立て","たて"],["、"],["それ"],["を"],["彼","かれ"],["の"],["後","あと"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["永遠","えいえん"],["の"],["契約","けいやく"],["と"],["する"],["。"]]},{"verse":20,"text":"イシュマエルについては、あなたの言うことを聞き入れた。確かに、わたしは彼を祝福し、彼の子孫をふやし、非常に多く増し加えよう。彼は十二人の族長たちを生む。わたしは彼を大いなる国民としよう。","tok":[["イシュマエル"],["について"],["は"],["、"],["あなた"],["の"],["言う","いう"],["こと"],["を"],["聞き入れた","ききいれた"],["。"],["確か","たしか"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["祝福","しゅくふく"],["し"],["、"],["彼","かれ"],["の"],["子孫","しそん"],["を"],["ふやし"],["、"],["非常","ひじょう"],["に"],["多く","おおく"],["増し加えよう","ましくわえよう"],["。"],["彼","かれ"],["は"],["十二人","じゅうににん"],["の"],["族長","ぞくちょう"],["たち"],["を"],["生む","うむ"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["しよう"],["。"]]},{"verse":21,"text":"しかしわたしは、来年の今ごろサラがあなたに産むイサクと、わたしの契約を立てる。」","tok":[["しかし"],["わたし"],["は"],["、"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["サラ"],["が"],["あなた"],["に"],["産む","うむ"],["イサク"],["と"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["立てる","たてる"],["。"],["」"]]},{"verse":22,"text":"神はアブラハムと語り終えられると、彼から離れて上られた。","tok":[["神","かみ"],["は"],["アブラハム"],["と"],["語り","かたり"],["終えられる","おえられる"],["と"],["、"],["彼","かれ"],["から"],["離れて","はなれて"],["上られた","のぼられた"],["。"]]},{"verse":23,"text":"そこでアブラハムは、その子イシュマエルと家で生まれたしもべ、また金で買い取った者、アブラハムの家の人々のうちのすべての男子を集め、神が彼にお告げになったとおり、その日のうちに、彼らの包皮の肉を切り捨てた。","tok":[["そこ"],["で"],["アブラハム"],["は"],["、"],["その"],["子","こ"],["イシュマエル"],["と"],["家","いえ"],["で"],["生まれた","うまれた"],["しもべ"],["、"],["また"],["金","きん"],["で"],["買い取った","かいとった"],["者","もの"],["、"],["アブラハム"],["の"],["家","いえ"],["の"],["人々","ひとびと"],["の"],["うち"],["の"],["すべて"],["の"],["男子","だんし"],["を"],["集め","あつめ"],["、"],["神","かみ"],["が"],["彼","かれ"],["に"],["お告げ","おつげ"],["に"],["なった"],["とおり"],["、"],["その"],["日","ひ"],["の"],["うち"],["に"],["、"],["彼","かれ"],["ら"],["の"],["包皮","ほうひ"],["の"],["肉","にく"],["を"],["切り捨てた","きりすてた"],["。"]]},{"verse":24,"text":"アブラハムが包皮の肉を切り捨てられたときは、九十九歳であった。","tok":[["アブラハム"],["が"],["包皮","ほうひ"],["の"],["肉","にく"],["を"],["切り捨てられた","きりすてられた"],["とき"],["は"],["、"],["九十九歳","きゅうじゅうきゅうさい"],["で"],["あった"],["。"]]},{"verse":25,"text":"その子イシュマエルが包皮の肉を切り捨てられたときは、十三歳であった。","tok":[["その"],["子","こ"],["イシュマエル"],["が"],["包皮","ほうひ"],["の"],["肉","にく"],["を"],["切り捨てられた","きりすてられた"],["とき"],["は"],["、"],["十三歳","じゅうさんさい"],["で"],["あった"],["。"]]},{"verse":26,"text":"アブラハムとその子イシュマエルは、その日のうちに割礼を受けた。","tok":[["アブラハム"],["と"],["その"],["子","こ"],["イシュマエル"],["は"],["、"],["その"],["日","ひ"],["の"],["うち"],["に"],["割礼","かつれい"],["を"],["受けた","うけた"],["。"]]},{"verse":27,"text":"彼の家の男たち、すなわち、家で生まれた奴隷、外国人から金で買い取った者もみな、彼といっしょに割礼を受けた。","tok":[["彼","かれ"],["の"],["家","いえ"],["の"],["男","おとこ"],["たち"],["、"],["すなわち"],["、"],["家","いえ"],["で"],["生まれた","うまれた"],["奴隷","どれい"],["、"],["外国人","がいこくじん"],["から"],["金","かね"],["で"],["買い取った","かいとった"],["者","もの"],["も"],["みな"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["割礼","かつれい"],["を"],["受けた","うけた"],["。"]]}]
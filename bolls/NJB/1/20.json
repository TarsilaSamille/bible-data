[{"verse":1,"text":"アブラハムは、そこからネゲブの地方へ移り、カデシュとシュルの間に住みついた。ゲラルに滞在中、","tok":[["アブラハム"],["は"],["、"],["そこ"],["から"],["ネゲブ"],["の"],["地方","ちほう"],["へ"],["移り","うつり"],["、"],["カデシュ"],["と"],["シュル"],["の"],["間","あいだ"],["に"],["住みついた","すみついた"],["。"],["ゲラル"],["に"],["滞在中","たいざいちゅう"],["、"]]},{"verse":2,"text":"アブラハムは、自分の妻サラのことを、「これは私の妹です」と言ったので、ゲラルの王アビメレクは、使いをやって、サラを召し入れた。","tok":[["アブラハム"],["は"],["、"],["自分","じぶん"],["の"],["妻","つま"],["サラ"],["の"],["こと"],["を"],["、"],["「"],["これ"],["は"],["私","わたくし"],["の"],["妹","いもうと"],["です"],["」"],["と"],["言った","いった"],["ので"],["、"],["ゲラル"],["の"],["王","おう"],["アビメレク"],["は"],["、"],["使い","つかい"],["を"],["やって"],["、"],["サラ"],["を"],["召し入れた","めしいれた"],["。"]]},{"verse":3,"text":"ところが、神は、夜、夢の中で、アビメレクのところに来られ、そして仰せられた。「あなたが召し入れた女のために、あなたは死ななければならない。あの女は夫のある身である。」","tok":[["ところ"],["が"],["、"],["神","かみ"],["は"],["、"],["夜","よる"],["、"],["夢","ゆめ"],["の"],["中","なか"],["で"],["、"],["アビメレク"],["の"],["ところ"],["に"],["来られ","こられ"],["、"],["そして"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["が"],["召し入れた","めしいれた"],["女","おんな"],["の"],["ため"],["に"],["、"],["あなた"],["は"],["死ななければ","しななければ"],["ならない"],["。"],["あの"],["女","おんな"],["は"],["夫","おっと"],["の"],["ある"],["身","み"],["で"],["ある"],["。"],["」"]]},{"verse":4,"text":"アビメレクはまだ、彼女に近づいていなかったので、こう言った。「主よ。あなたは正しい国民をも殺されるのですか。","tok":[["アビメレク"],["は"],["まだ"],["、"],["彼女","かのじょ"],["に"],["近づいて","ちかづいて"],["いなかった"],["ので"],["、"],["こう"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["正しい","ただしい"],["国民","こくみん"],["を"],["も"],["殺される","ころされる"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"彼は私に、『これは私の妹だ』と言ったではありませんか。そして、彼女自身も『これは私の兄だ』と言ったのです。私は正しい心と汚れない手で、このことをしたのです。」","tok":[["彼","かれ"],["は"],["私","わたくし"],["に"],["、"],["『"],["これ"],["は"],["私","わたくし"],["の"],["妹","いもうと"],["だ"],["』"],["と"],["言ったで","いったで"],["は"],["ありません"],["か"],["。"],["そして"],["、"],["彼女","かのじょ"],["自身","じしん"],["も"],["『"],["これ"],["は"],["私","わたくし"],["の"],["兄","あに"],["だ"],["』"],["と"],["言った","いった"],["の"],["です"],["。"],["私","わたくし"],["は"],["正しい","ただしい"],["心","こころ"],["と"],["汚れない","よごれない"],["手","て"],["で"],["、"],["この"],["こと"],["を"],["した"],["の"],["です"],["。"],["」"]]},{"verse":6,"text":"神は夢の中で、彼に仰せられた。「そうだ。あなたが正しい心でこの事をしたのを、わたし自身よく知っていた。それでわたしも、あなたがわたしに罪を犯さないようにしたのだ。それゆえ、わたしは、あなたが彼女に触れることを許さなかったのだ。","tok":[["神","かみ"],["は"],["夢","ゆめ"],["の"],["中","なか"],["で"],["、"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["そう"],["だ"],["。"],["あなた"],["が"],["正しい","ただしい"],["心","こころ"],["で"],["この"],["事","こと"],["を"],["した"],["の"],["を"],["、"],["わたし"],["自身","じしん"],["よく"],["知って","しって"],["いた"],["。"],["それ"],["で"],["わたし"],["も"],["、"],["あなた"],["が"],["わたし"],["に"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["した"],["の"],["だ"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["あなた"],["が"],["彼女","かのじょ"],["に"],["触れる","ふれる"],["こと"],["を"],["許さなかった","ゆるさなかった"],["の"],["だ"],["。"]]},{"verse":7,"text":"今、あの人の妻を返していのちを得なさい。あの人は預言者であって、あなたのために祈ってくれよう。しかし、あなたが返さなければ、あなたも、あなたに属するすべての者も、必ず死ぬことをわきまえなさい。」","tok":[["今","いま"],["、"],["あの"],["人","ひと"],["の"],["妻","つま"],["を"],["返して","かえして"],["いのち"],["を"],["得","え"],["なさい"],["。"],["あの"],["人","ひと"],["は"],["預言者","よげんしゃ"],["で"],["あって"],["、"],["あなた"],["の"],["ため"],["に"],["祈って","いのって"],["くれよう"],["。"],["しかし"],["、"],["あなた"],["が"],["返さなければ","かえさなければ"],["、"],["あなた"],["も"],["、"],["あなた"],["に"],["属する","ぞくする"],["すべて"],["の"],["者","もの"],["も"],["、"],["必ず","かならず"],["死ぬ","しぬ"],["こと"],["を"],["わきまえ"],["なさい"],["。"],["」"]]},{"verse":8,"text":"翌朝早く、アビメレクは彼のしもべを全部呼び寄せ、これらのことをみな語り聞かせたので、人々は非常に恐れた。","tok":[["翌朝","よくあさ"],["早く","はやく"],["、"],["アビメレク"],["は"],["彼","かれ"],["の"],["しもべ"],["を"],["全部","ぜんぶ"],["呼び寄せ","よびよせ"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["みな"],["語り聞かせた","かたりきかせた"],["ので"],["、"],["人々","ひとびと"],["は"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":9,"text":"それから、アビメレクはアブラハムを呼び寄せて言った。「あなたは何ということを、してくれたのか。あなたが私と私の王国とに、こんな大きな罪をもたらすとは、いったい私がどんな罪をあなたに犯したのか。あなたはしてはならないことを、私にしたのだ。」","tok":[["それ"],["から"],["、"],["アビメレク"],["は"],["アブラハム"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["何","なん"],["と"],["いう"],["こと"],["を"],["、"],["して"],["くれた"],["の"],["か"],["。"],["あなた"],["が"],["私","わたくし"],["と"],["私","わたくし"],["の"],["王国","おうこく"],["と"],["に"],["、"],["こんな"],["大きな","おおきな"],["罪","つみ"],["を"],["もたらす"],["と"],["は"],["、"],["いったい"],["私","わたくし"],["が"],["どんな"],["罪","つみ"],["を"],["あなた"],["に"],["犯した","おかした"],["の"],["か"],["。"],["あなた"],["は"],["して"],["は"],["ならない"],["こと"],["を"],["、"],["私","わたくし"],["に"],["した"],["の"],["だ"],["。"],["」"]]},{"verse":10,"text":"また、アビメレクはアブラハムに言った。「あなたはどういうつもりで、こんなことをしたのか。」","tok":[["また"],["、"],["アビメレク"],["は"],["アブラハム"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["どういう"],["つもり"],["で"],["、"],["こんな"],["こと"],["を"],["した"],["の"],["か"],["。"],["」"]]},{"verse":11,"text":"アブラハムは答えた。「この地方には、神を恐れることが全くないので、人々が私の妻のゆえに、私を殺すと思ったからです。","tok":[["アブラハム"],["は"],["答えた","こたえた"],["。"],["「"],["この"],["地方","ちほう"],["に"],["は"],["、"],["神","かみ"],["を"],["恐れる","おそれる"],["こと"],["が"],["全く","まったく"],["ない"],["ので"],["、"],["人々","ひとびと"],["が"],["私","わたくし"],["の"],["妻","つま"],["の"],["ゆえ"],["に"],["、"],["私","わたくし"],["を"],["殺す","ころす"],["と"],["思った","おもった"],["から"],["です"],["。"]]},{"verse":12,"text":"また、ほんとうに、あれは私の妹です。あの女は私の父の娘ですが、私の母の娘ではありません。それが私の妻になったのです。","tok":[["また"],["、"],["ほんとう"],["に"],["、"],["あれ"],["は"],["私","わたくし"],["の"],["妹","いもうと"],["です"],["。"],["あの"],["女","おんな"],["は"],["私","わたくし"],["の"],["父","ちち"],["の"],["娘","むすめ"],["です"],["が"],["、"],["私","わたくし"],["の"],["母","はは"],["の"],["娘","むすめ"],["で"],["は"],["ありません"],["。"],["それ"],["が"],["私","わたくし"],["の"],["妻","つま"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":13,"text":"神が私を父の家からさすらいの旅に出されたとき、私は彼女に、『こうして、あなたの愛を私のために尽くしておくれ。私たちが行くどこででも、私のことを、この人は私の兄です、と言っておくれ』と頼んだのです。」","tok":[["神","かみ"],["が"],["私","わたくし"],["を"],["父","ちち"],["の"],["家","いえ"],["から"],["さすらい"],["の"],["旅","たび"],["に"],["出された","だされた"],["とき"],["、"],["私","わたくし"],["は"],["彼女","かのじょ"],["に"],["、"],["『"],["こう"],["して"],["、"],["あなた"],["の"],["愛","あい"],["を"],["私","わたくし"],["の"],["ため"],["に"],["尽くして","つくして"],["おくれ"],["。"],["私たち","わたしたち"],["が"],["行く","いく"],["どこ"],["で"],["で"],["も"],["、"],["私","わたくし"],["の"],["こと"],["を"],["、"],["この"],["人","ひと"],["は"],["私","わたくし"],["の"],["兄","あに"],["です"],["、"],["と"],["言って","いって"],["おくれ"],["』"],["と"],["頼んだ","たのんだ"],["の"],["です"],["。"],["」"]]},{"verse":14,"text":"そこで、アビメレクは、羊の群れと牛の群れと男女の奴隷たちを取って来て、アブラハムに与え、またアブラハムの妻サラを彼に返した。","tok":[["そこ"],["で"],["、"],["アビメレク"],["は"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["と"],["牛","うし"],["の"],["群れ","むれ"],["と"],["男女","だんじょ"],["の"],["奴隷","どれい"],["たち"],["を"],["取って","とって"],["来て","きて"],["、"],["アブラハム"],["に"],["与え","あたえ"],["、"],["また"],["アブラハム"],["の"],["妻","つま"],["サラ"],["を"],["彼","かれ"],["に"],["返した","かえした"],["。"]]},{"verse":15,"text":"そして、アビメレクは言った。「見よ。私の領地があなたの前に広がっている。あなたの良いと思う所に住みなさい。」","tok":[["そして"],["、"],["アビメレク"],["は"],["言った","いった"],["。"],["「"],["見","み"],["よ"],["。"],["私","わたくし"],["の"],["領地","りょうち"],["が"],["あなた"],["の"],["前","まえ"],["に"],["広がって","ひろがって"],["いる"],["。"],["あなた"],["の"],["良い","よい"],["と"],["思う","おもう"],["所","ところ"],["に"],["住み","すみ"],["なさい"],["。"],["」"]]},{"verse":16,"text":"彼はまたサラに言った。「ここに、銀千枚をあなたの兄に与える。きっと、これはあなたといっしょにいるすべての人の前で、あなたを守るものとなろう。これですべて、正しいとされよう。」","tok":[["彼","かれ"],["は"],["また"],["サラ"],["に"],["言った","いった"],["。"],["「"],["ここ"],["に"],["、"],["銀","ぎん"],["千枚","せんまい"],["を"],["あなた"],["の"],["兄","あに"],["に"],["与える","あたえる"],["。"],["きっと"],["、"],["これ"],["は"],["あなた"],["と"],["いっしょ"],["に"],["いる"],["すべて"],["の"],["人","ひと"],["の"],["前","まえ"],["で"],["、"],["あなた"],["を"],["守る","まもる"],["もの"],["と"],["なろう"],["。"],["これ"],["で"],["すべて"],["、"],["正しい","ただしい"],["と"],["されよう"],["。"],["」"]]},{"verse":17,"text":"そこで、アブラハムは神に祈った。神はアビメレクとその妻、および、はしためたちをいやされたので、彼らはまた子を産むようになった。","tok":[["そこ"],["で"],["、"],["アブラハム"],["は"],["神","かみ"],["に"],["祈った","いのった"],["。"],["神","かみ"],["は"],["アビメレク"],["と"],["その"],["妻","つま"],["、"],["および"],["、"],["はし"],["ため"],["たち"],["を"],["いやされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["また子","またこ"],["を"],["産む","うむ"],["よう"],["に"],["なった"],["。"]]},{"verse":18,"text":"主が、アブラハムの妻、サラのゆえに、アビメレクの家のすべての胎を堅く閉じておられたからである。","tok":[["主","ぬし"],["が"],["、"],["アブラハム"],["の"],["妻","つま"],["、"],["サラ"],["の"],["ゆえ"],["に"],["、"],["アビメレク"],["の"],["家","いえ"],["の"],["すべて"],["の"],["胎","はら"],["を"],["堅く","かたく"],["閉じて","とじて"],["おられた"],["から"],["で"],["ある"],["。"]]}]
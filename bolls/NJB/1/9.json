[{"verse":1,"text":"それで、神はノアと、その息子たちを祝福して、彼らに仰せられた。「生めよ。ふえよ。地に満ちよ。","tok":[["それ"],["で"],["、"],["神","かみ"],["は"],["ノア"],["と"],["、"],["その"],["息子","むすこ"],["たち"],["を"],["祝福","しゅくふく"],["して"],["、"],["彼","かれ"],["ら"],["に"],["仰せられた","おおせられた"],["。"],["「"],["生め","うめ"],["よ"],["。"],["ふえ"],["よ"],["。"],["地","ち"],["に"],["満ち","みち"],["よ"],["。"]]},{"verse":2,"text":"野の獣、空の鳥、――地の上を動くすべてのもの――それに海の魚、これらすべてはあなたがたを恐れておののこう。わたしはこれらをあなたがたにゆだねている。","tok":[["野","の"],["の"],["獣","けもの"],["、"],["空","そら"],["の"],["鳥","とり"],["、"],["―"],["―"],["地","ち"],["の"],["上","うえ"],["を"],["動く","うごく"],["すべて"],["の"],["もの"],["―"],["―"],["それ"],["に"],["海","うみ"],["の"],["魚","さかな"],["、"],["これ"],["ら"],["すべて"],["は"],["あなた"],["がた"],["を"],["恐れて","おそれて"],["おののこう"],["。"],["わたし"],["は"],["これ"],["ら"],["を"],["あなた"],["がた"],["に"],["ゆだねて"],["いる"],["。"]]},{"verse":3,"text":"生きて動いているものはみな、あなたがたの食物である。緑の草と同じように、すべてのものをあなたがたに与えた。","tok":[["生きて","いきて"],["動いて","うごいて"],["いる"],["もの"],["は"],["みな"],["、"],["あなた"],["がた"],["の"],["食物","しょくもつ"],["で"],["ある"],["。"],["緑","みどり"],["の"],["草","くさ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["すべて"],["の"],["もの"],["を"],["あなた"],["がた"],["に"],["与えた","あたえた"],["。"]]},{"verse":4,"text":"しかし、肉は、そのいのちである血のあるままで食べてはならない。","tok":[["しかし"],["、"],["肉","にく"],["は"],["、"],["その"],["いのち"],["で"],["ある"],["血","ち"],["の"],["ある"],["まま"],["で"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"わたしはあなたがたのいのちのためには、あなたがたの血の価を要求する。わたしはどんな獣にでも、それを要求する。また人にも、兄弟である者にも、人のいのちを要求する。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["いのち"],["の"],["ため"],["に"],["は"],["、"],["あなた"],["がた"],["の"],["血","ち"],["の"],["価","あたい"],["を"],["要求","ようきゅう"],["する"],["。"],["わたし"],["は"],["どんな"],["獣","けもの"],["に"],["で"],["も"],["、"],["それ"],["を"],["要求","ようきゅう"],["する"],["。"],["また"],["人","ひと"],["に"],["も"],["、"],["兄弟","きょうだい"],["で"],["ある"],["者","もの"],["に"],["も"],["、"],["人","ひと"],["の"],["いのち"],["を"],["要求","ようきゅう"],["する"],["。"]]},{"verse":6,"text":"人の血を流す者は、人によって、血を流される。神は人を神のかたちにお造りになったから。","tok":[["人","ひと"],["の"],["血","ち"],["を"],["流す","ながす"],["者","もの"],["は"],["、"],["人","ひと"],["によって"],["、"],["血","ち"],["を"],["流される","ながされる"],["。"],["神","かみ"],["は"],["人","ひと"],["を"],["神","かみ"],["の"],["かたち"],["に"],["お造り","おつくり"],["に"],["なった"],["から"],["。"]]},{"verse":7,"text":"あなたがたは生めよ。ふえよ。地に群がり、地にふえよ。」","tok":[["あなた"],["がた"],["は"],["生めよ","うめよ"],["。"],["ふえ"],["よ"],["。"],["地","ち"],["に"],["群がり","むらがり"],["、"],["地","ち"],["に"],["ふえ"],["よ"],["。"],["」"]]},{"verse":8,"text":"神はノアと、彼といっしょにいる息子たちに告げて仰せられた。","tok":[["神","かみ"],["は"],["ノア"],["と"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["いる"],["息子","むすこ"],["たち"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":9,"text":"「さあ、わたしはわたしの契約を立てよう。あなたがたと、そしてあなたがたの後の子孫と。","tok":[["「"],["さあ"],["、"],["わたし"],["は"],["わたし"],["の"],["契約","けいやく"],["を"],["立てよう","たてよう"],["。"],["あなた"],["がた"],["と"],["、"],["そして"],["あなた"],["がた"],["の"],["後","あと"],["の"],["子孫","しそん"],["と"],["。"]]},{"verse":10,"text":"また、あなたがたといっしょにいるすべての生き物と。鳥、家畜、それにあなたがたといっしょにいるすべての野の獣、箱舟から出て来たすべてのもの、地のすべての生き物と。","tok":[["また"],["、"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["いる"],["すべて"],["の"],["生き物","いきもの"],["と"],["。"],["鳥","とり"],["、"],["家畜","かちく"],["、"],["それ"],["に"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["いる"],["すべて"],["の"],["野","の"],["の"],["獣","けもの"],["、"],["箱舟","はこぶね"],["から"],["出て","でて"],["来た","きた"],["すべて"],["の"],["もの"],["、"],["地","ち"],["の"],["すべて"],["の"],["生き物","いきもの"],["と"],["。"]]},{"verse":11,"text":"わたしはあなたがたと契約を立てる。すべて肉なるものは、もはや大洪水の水では断ち切られない。もはや大洪水が地を滅ぼすようなことはない。」","tok":[["わたし"],["は"],["あなた"],["がた"],["と"],["契約","けいやく"],["を"],["立てる","たてる"],["。"],["すべて"],["肉","にく"],["なる"],["もの"],["は"],["、"],["もはや"],["大洪水","だいこうずい"],["の"],["水","みず"],["で"],["は"],["断ち切られない","たちきられない"],["。"],["もはや"],["大洪水","だいこうずい"],["が"],["地","ち"],["を"],["滅ぼす","ほろぼす"],["よう"],["な"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":12,"text":"さらに神は仰せられた。「わたしとあなたがた、およびあなたがたといっしょにいるすべての生き物との間に、わたしが代々永遠にわたって結ぶ契約のしるしは、これである。","tok":[["さらに"],["神","かみ"],["は"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["と"],["あなた"],["がた"],["、"],["および"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["いる"],["すべて"],["の"],["生き物","いきもの"],["と"],["の"],["間","あいだ"],["に"],["、"],["わたし"],["が"],["代々","だいだい"],["永遠","えいえん"],["に"],["わたって"],["結ぶ","むすぶ"],["契約","けいやく"],["の"],["しるし"],["は"],["、"],["これ"],["で"],["ある"],["。"]]},{"verse":13,"text":"わたしは雲の中に、わたしの虹を立てる。それはわたしと地との間の契約のしるしとなる。","tok":[["わたし"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["、"],["わたし"],["の"],["虹","にじ"],["を"],["立てる","たてる"],["。"],["それ"],["は"],["わたし"],["と"],["地","ち"],["と"],["の"],["間","あいだ"],["の"],["契約","けいやく"],["の"],["しるし"],["と"],["なる"],["。"]]},{"verse":14,"text":"わたしが地の上に雲を起こすとき、虹が雲の中に現れる。","tok":[["わたし"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["雲","くも"],["を"],["起こす","おこす"],["とき"],["、"],["虹","にじ"],["が"],["雲","くも"],["の"],["中","なか"],["に"],["現れる","あらわれる"],["。"]]},{"verse":15,"text":"わたしは、わたしとあなたがたとの間、およびすべて肉なる生き物との間の、わたしの契約を思い出すから、大水は、すべての肉なるものを滅ぼす大洪水とは決してならない。","tok":[["わたし"],["は"],["、"],["わたし"],["と"],["あなた"],["がた"],["と"],["の"],["間","あいだ"],["、"],["および"],["すべて"],["肉","にく"],["なる"],["生き物","いきもの"],["と"],["の"],["間","あいだ"],["の"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["思い出す","おもいだす"],["から"],["、"],["大水","おおみず"],["は"],["、"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["を"],["滅ぼす","ほろぼす"],["大洪水","だいこうずい"],["と"],["は"],["決して","けっして"],["ならない"],["。"]]},{"verse":16,"text":"虹が雲の中にあるとき、わたしはそれを見て、神と、すべての生き物、地上のすべて肉なるものとの間の永遠の契約を思い出そう。」","tok":[["虹","にじ"],["が"],["雲","くも"],["の"],["中","なか"],["に"],["ある"],["とき"],["、"],["わたし"],["は"],["それ"],["を"],["見て","みて"],["、"],["神","かみ"],["と"],["、"],["すべて"],["の"],["生き物","いきもの"],["、"],["地上","ちじょう"],["の"],["すべて"],["肉","にく"],["なる"],["もの"],["と"],["の"],["間","あいだ"],["の"],["永遠","えいえん"],["の"],["契約","けいやく"],["を"],["思い出そう","おもいだそう"],["。"],["」"]]},{"verse":17,"text":"こうして神はノアに仰せられた。「これが、わたしと、地上のすべての肉なるものとの間に立てた契約のしるしである。」","tok":[["こう"],["して"],["神","かみ"],["は"],["ノア"],["に"],["仰せられた","おおせられた"],["。"],["「"],["これ"],["が"],["、"],["わたし"],["と"],["、"],["地上","ちじょう"],["の"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["と"],["の"],["間","あいだ"],["に"],["立てた","たてた"],["契約","けいやく"],["の"],["しるし"],["で"],["ある"],["。"],["」"]]},{"verse":18,"text":"箱舟から出て来たノアの息子たちは、セム、ハム、ヤペテであった。ハムはカナンの父である。","tok":[["箱舟","は
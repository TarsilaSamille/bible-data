[{"verse":1,"text":"主は、約束されたとおり、サラを顧みて、仰せられたとおりに主はサラになさった。","tok":[["主","ぬし"],["は"],["、"],["約束","やくそく"],["された"],["とおり"],["、"],["サラ"],["を"],["顧みて","かえりみて"],["、"],["仰せられた","おおせられた"],["とおり"],["に"],["主","ぬし"],["は"],["サラ"],["に"],["なさった"],["。"]]},{"verse":2,"text":"サラはみごもり、そして神がアブラハムに言われたその時期に、年老いたアブラハムに男の子を産んだ。","tok":[["サラ"],["は"],["みごもり"],["、"],["そして"],["神","かみ"],["が"],["アブラハム"],["に"],["言われた","いわれた"],["その"],["時期","じき"],["に"],["、"],["年老いた","としおいた"],["アブラハム"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":3,"text":"アブラハムは、自分に生まれた子、サラが自分に産んだ子をイサクと名づけた。","tok":[["アブラハム"],["は"],["、"],["自分","じぶん"],["に"],["生まれた","うまれた"],["子","こ"],["、"],["サラ"],["が"],["自分","じぶん"],["に"],["産んだ","うんだ"],["子","こ"],["を"],["イサク"],["と"],["名づけた","なづけた"],["。"]]},{"verse":4,"text":"そしてアブラハムは、神が彼に命じられたとおり、八日目になった自分の子イサクに割礼を施した。","tok":[["そして"],["アブラハム"],["は"],["、"],["神","かみ"],["が"],["彼","かれ"],["に"],["命じられた","めいじられた"],["とおり"],["、"],["八日目","ようかめ"],["に"],["なった"],["自分","じぶん"],["の"],["子","こ"],["イサク"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["。"]]},{"verse":5,"text":"アブラハムは、その子イサクが生まれたときは百歳であった。","tok":[["アブラハム"],["は"],["、"],["その"],["子","こ"],["イサク"],["が"],["生まれた","うまれた"],["とき"],["は"],["百歳","ひゃくさい"],["で"],["あった"],["。"]]},{"verse":6,"text":"サラは言った。「神は私を笑われました。聞く者はみな、私に向かって笑うでしょう。」","tok":[["サラ"],["は"],["言った","いった"],["。"],["「"],["神","かみ"],["は"],["私","わたくし"],["を"],["笑われました","わらわれました"],["。"],["聞く","きく"],["者","もの"],["は"],["みな"],["、"],["私","わたくし"],["に"],["向かって","むかって"],["笑うでしょう","わらうでしょう"],["。"],["」"]]},{"verse":7,"text":"また彼女は言った。「だれがアブラハムに、『サラが子どもに乳を飲ませる』と告げたでしょう。ところが私は、あの年寄りに子を産みました。」","tok":[["また"],["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["だれ"],["が"],["アブラハム"],["に"],["、"],["『"],["サラ"],["が"],["子ども","こども"],["に"],["乳","ちち"],["を"],["飲ませる","のませる"],["』"],["と"],["告げたでしょう","つげたでしょう"],["。"],["ところ"],["が"],["私","わたくし"],["は"],["、"],["あの"],["年寄り","としより"],["に"],["子","こ"],["を"],["産みました","うみました"],["。"],["」"]]},{"verse":8,"text":"その子は育って乳離れした。アブラハムはイサクの乳離れの日に、盛大な宴会を催した。","tok":[["その"],["子","こ"],["は"],["育って","そだって"],["乳離れ","ちばなれ"],["した"],["。"],["アブラハム"],["は"],["イサク"],["の"],["乳離れ","ちばなれ"],["の"],["日","ひ"],["に"],["、"],["盛大","せいだい"],["な"],["宴会","えんかい"],["を"],["催した","もよおした"],["。"]]},{"verse":9,"text":"そのとき、サラは、エジプトの女ハガルがアブラハムに産んだ子が、自分の子イサクをからかっているのを見た。","tok":[["その"],["とき"],["、"],["サラ"],["は"],["、"],["エジプト"],["の"],["女","おんな"],["ハガル"],["が"],["アブラハム"],["に"],["産んだ","うんだ"],["子","こ"],["が"],["、"],["自分","じぶん"],["の"],["子","こ"],["イサク"],["を"],["からかって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":10,"text":"それでアブラハムに言った。「このはしためを、その子といっしょに追い出してください。このはしための子は、私の子イサクといっしょに跡取りになるべきではありません。」","tok":[["それ"],["で"],["アブラハム"],["に"],["言った","いった"],["。"],["「"],["この"],["はし"],["ため"],["を"],["、"],["その"],["子","こ"],["と"],["いっしょ"],["に"],["追い出して","おいだして"],["ください"],["。"],["この"],["はし"],["ため"],["の"],["子","こ"],["は"],["、"],["私","わたくし"],["の"],["子","こ"],["イサク"],["と"],["いっしょ"],["に"],["跡取り","あととり"],["に"],["なるべきで"],["は"],["ありません"],["。"],["」"]]},{"verse":11,"text":"このことは、自分の子に関することなので、アブラハムは、非常に悩んだ。","tok":[["この"],["こと"],["は"],["、"],["自分","じぶん"],["の"],["子","こ"],["に"],["関する","かんする"],["こと"],["な"],["ので"],["、"],["アブラハム"],["は"],["、"],["非常","ひじょう"],["に"],["悩んだ","なやんだ"],["。"]]},{"verse":12,"text":"すると、神はアブラハムに仰せられた。「その少年と、あなたのはしためのことで、悩んではならない。サラがあなたに言うことはみな、言うとおりに聞き入れなさい。イサクから出る者が、あなたの子孫と呼ばれるからだ。","tok":[["する"],["と"],["、"],["神","かみ"],["は"],["アブラハム"],["に"],["仰せられた","おおせられた"],["。"],["「"],["その"],["少年","しょうねん"],["と"],["、"],["あなた"],["の"],["はし"],["ため"],["の"],["こと"],["で"],["、"],["悩んで","なやんで"],["は"],["ならない"],["。"],["サラ"],["が"],["あなた"],["に"],["言う","いう"],["こと"],["は"],["みな"],["、"],["言う","いう"],["とおり"],["に"],["聞き入れ","ききいれ"],["なさい"],["。"],["イサク"],["から"],["出る","でる"],["者","もの"],["が"],["、"],["あなた"],["の"],["子孫","しそん"],["と"],["呼ばれる","よばれる"],["から"],["だ"],["。"]]},{"verse":13,"text":"しかしはしための子も、わたしは一つの国民としよう。彼もあなたの子だから。」","tok":[["しかし"],["は"],["し"],["ため"],["の"],["子","こ"],["も"],["、"],["わたし"],["は"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["と"],["しよう"],["。"],["彼","かれ"],["も"],["あなた"],["の"],["子","こ"],["だ"],["から"],["。"],["」"]]},{"verse":14,"text":"翌朝早く、
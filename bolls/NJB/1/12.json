[{"verse":1,"text":"主はアブラムに仰せられた。「あなたは、あなたの生まれ故郷、あなたの父の家を出て、わたしが示す地へ行きなさい。","tok":[["主","ぬし"],["は"],["アブラム"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["あなた"],["の"],["生まれ","うまれ"],["故郷","こきょう"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["を"],["出て","でて"],["、"],["わたし"],["が"],["示す","しめす"],["地","ち"],["へ"],["行き","いき"],["なさい"],["。"]]},{"verse":2,"text":"そうすれば、わたしはあなたを大いなる国民とし、あなたを祝福し、あなたの名を大いなるものとしよう。あなたの名は祝福となる。","tok":[["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["し"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["名","な"],["を"],["大いなる","おおいなる"],["もの"],["と"],["しよう"],["。"],["あなた"],["の"],["名","な"],["は"],["祝福","しゅくふく"],["と"],["なる"],["。"]]},{"verse":3,"text":"あなたを祝福する者をわたしは祝福し、あなたをのろう者をわたしはのろう。地上のすべての民族は、あなたによって祝福される。」","tok":[["あなた"],["を"],["祝福","しゅくふく"],["する"],["者","もの"],["を"],["わたし"],["は"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["を"],["の"],["ろう者","ろうしゃ"],["を"],["わたし"],["は"],["のろう"],["。"],["地上","ちじょう"],["の"],["すべて"],["の"],["民族","みんぞく"],["は"],["、"],["あなた"],["によって"],["祝福","しゅくふく"],["される"],["。"],["」"]]},{"verse":4,"text":"アブラムは主がお告げになったとおりに出かけた。ロトも彼といっしょに出かけた。アブラムがハランを出たときは、七十五歳であった。","tok":[["アブラム"],["は"],["主","ぬし"],["が"],["お告げ","おつげ"],["に"],["なった"],["とおり"],["に"],["出かけた","でかけた"],["。"],["ロト"],["も"],["彼","かれ"],["と"],["いっしょ"],["に"],["出かけた","でかけた"],["。"],["アブラム"],["が"],["ハラン"],["を"],["出た","でた"],["とき"],["は"],["、"],["七十五歳","ななじゅうごさい"],["で"],["あった"],["。"]]},{"verse":5,"text":"アブラムは妻のサライと、おいのロトと、彼らが得たすべての財産と、ハランで加えられた人々を伴い、カナンの地に行こうとして出発した。こうして彼らはカナンの地に入った。","tok":[["アブラム"],["は"],["妻","つま"],["の"],["サライ"],["と"],["、"],["おい"],["の"],["ロト"],["と"],["、"],["彼","かれ"],["ら"],["が"],["得た","えた"],["すべて"],["の"],["財産","ざいさん"],["と"],["、"],["ハラン"],["で"],["加えられた","くわえられた"],["人々","ひとびと"],["を"],["伴い","ともない"],["、"],["カナン"],["の"],["地","ち"],["に"],["行こう","いこう"],["として"],["出発","しゅっぱつ"],["した"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["カナン"],["の"],["地","ち"],["に"],["入った","はいった"],["。"]]},{"verse":6,"text":"アブラムはその地を通って行き、シェケムの場、モレの樫の木のところまで来た。当時、その地にはカナン人がいた。","tok":[["アブラム"],["は"],["その"],["地","ち"],["を"],["通って","とおって"],["行き","いき"],["、"],["シェケム"],["の"],["場","ば"],["、"],["モレ"],["の"],["樫","かし"],["の"],["木","き"],["の"],["ところ"],["まで"],["来た","きた"],["。"],["当時","とうじ"],["、"],["その"],["地","ち"],["に"],["は"],["カナン人","かなんにん"],["が"],["いた"],["。"]]},{"verse":7,"text":"そのころ、主がアブラムに現れ、そして「あなたの子孫に、わたしはこの地を与える」と仰せられた。アブラムは自分に現れてくださった主のために、そこに祭壇を築いた。","tok":[["その"],["ころ"],["、"],["主","ぬし"],["が"],["アブラム"],["に"],["現れ","あらわれ"],["、"],["そして"],["「"],["あなた"],["の"],["子孫","しそん"],["に"],["、"],["わたし"],["は"],["この"],["地","ち"],["を"],["与える","あたえる"],["」"],["と"],["仰せられた","おおせられた"],["。"],["アブラム"],["は"],["自分","じぶん"],["に"],["現れて","あらわれて"],["くださった"],["主","ぬし"],["の"],["ため"],["に"],["、"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]},{"verse":8,"text":"彼はそこからベテルの東にある山のほうに移動して天幕を張った。西にはベテル、東にはアイがあった。彼は主のため、そこに祭壇を築き、主の御名によって祈った。","tok":[["彼","かれ"],["は"],["そこ"],["から"],["ベテル"],["の"],["東","ひがし"],["に"],["ある"],["山","やま"],["の"],["ほう"],["に"],["移動","いどう"],["して"],["天幕","てんまく"],["を"],["張った","はった"],["。"],["西","にし"],["に"],["は"],["ベテル"],["、"],["東","ひがし"],["に"],["は"],["アイ"],["が"],["あった"],["。"],["彼","かれ"],["は"],["主","ぬし"],["の"],["ため"],["、"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["祈った","いのった"],["。"]]},{"verse":9,"text":"それから、アブラムはなおも進んで、ネゲブのほうへと旅を続けた。","tok":[["それ"],["から"],["、"],["アブラム"],["は"],["なお"],["も"],["進んで","すすんで"],["、"],["ネゲブ"],["の"],["ほう"],["へ"],["と"],["旅","たび"],["を"],["続けた","つづけた"],["。"]]},{"verse":10,"text":"さて、この地にはききんがあったので、アブラムはエジプトのほうにしばらく滞在するために、下って行った。この地のききんは激しかったからである。","tok":[["さて"],["、"],["この"],["地","ち"],["に"],["は"],["ききん"],["が"],["あった"],["ので"],["、"],["アブラム"],["は"],["エジプト"],["の"],["ほう"],["に"],["しばらく"],["滞在","たいざい"],["する"],["ため"],["に"],["、"],["下って","くだって"],["行った","いった"],["。"],["この"],["地","ち"],["の"],["ききん"],["は"],["激しかった","はげしかった"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"彼はエジプトに近づき、そこに入ろうとするとき、妻のサライに言った。「聞いておくれ。あなたが見目麗しい女だということを私は知っている。","tok":[["彼","かれ"],["は"],["エジプト"],["に"],["近づき","ちかづき"],["、"],["そこ"],["に"],["入ろう","はいろう"],["と"],["する"],["とき"],["、"],["妻","つま"],["の"],["サライ"],["に"],["言った","いった"],["。"],["「"],["聞いて","きいて"],["おくれ"],["。"],["あなた"],["が"],["見目","みめ"],["麗しい","うるわしい"],["女","おんな"],["だ"],["と"],["いう"],["こと"],["を"],["私","わたくし"],["は"],["知って","しって"],["いる"],["。"]]},{"verse":12,"text":"エジプト人は、あなたを見るようになると、この女は彼の妻だと言って、私を殺すが、あなたは生かしておくだろう。","tok":[["エジプト"],["人","にん"],["は"],["、"],["あなた"],["を"],["見る","みる"],["よう"],["に"],["なる"],["と"],["、"],["この"],["女","おんな"],["は"],["彼","かれ"],["の"],["妻","つま"],["だ"],["と"],["言って","いって"],["、"],["私","わたくし"],["を"],["殺す","ころす"],["が"],["、"],["あなた"],["は"],["生かして","いかして"],["おくだろう"],["。"]]},{"verse":13,"text":"どうか、私の妹だと言ってくれ。そうすれば、あなたのおかげで私にも良くしてくれ、あなたのおかげで私は生きのびるだろう。」","tok":[["どう"],["か"],["、"],["私","わたくし"],["の"],["妹","いもうと"],["だ"],["と"],["言って","いって"],["くれ"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["おかげ"],["で"],["私","わたくし"],["に"],["も"],["良く","よく"],["して"],["くれ"],["、"],["あなた"],["の"],["おかげ"],["で"],["私","わたくし"],["は"],["生きのびるだろう","いきのびるだろう"],["。"],["」"]]},{"verse":14,"text":"アブラムがエジプトに入って行くと、エジプト人は、その女が非常に美しいのを見た。","tok":[["アブラム"],["が"],["エジプト"],["に"],["入って","はいって"],["行く","いく"],["と"],["、"],["エジプト"],["人","にん"],["は"],["、"],["その"],["女","おんな"],["が"],["非常","ひじょう"],["に"],["美しい","うつくしい"],["の"],["を"],["見た","みた"],["。"]]},{"verse":15,"text":"パロの高官たちが彼女を見て、パロに彼女を推賞したので、彼女はパロの宮廷に召し入れられた。","tok":[["パロ"],["の"],["高官","こうかん"],["たち"],["が"],["彼女","かのじょ"],["を"],["見て","みて"],["、"],["パロ"],["に"],["彼女","かのじょ"],["を"],["推賞","すいしょう"],["した"],["ので"],["、"],["彼女","かのじょ"],["は"],["パロ"],["の"],["宮廷","きゅうてい"],["に"],["召し入れられた","めしいれられた"],["。"]]},{"verse":16,"text":"パロは彼女のために、アブラムによくしてやり、それでアブラムは羊の群れ、牛の群れ、ろば、それに男女の奴隷、雌ろば、らくだを所有するようになった。","tok":[["パロ"],["は"],["彼女","かのじょ"],["の"],["ため"],["に"],["、"],["アブラム"],["に"],["よく"],["して"],["やり"],["、"],["それ"],["で"],["アブラム"],["は"],["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["牛","うし"],["の"],["群れ","むれ"],["、"],["ろば"],["、"],["それ"],["に"],["男女","だんじょ"],["の"],["奴隷","どれい"],["、"],["雌","めす"],["ろば"],["、"],["らくだ"],["を"],["所有","しょゆう"],["する"],["よう"],["に"],["なった"],["。"]]},{"verse":17,"text":"しかし、主はアブラムの妻サライのことで、パロと、その家をひどい災害で痛めつけた。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["アブラム"],["の"],["妻","つま"],["サライ"],["の"],["こと"],["で"],["、"],["パロ"],["と"],["、"],["その"],["家","いえ"],["を"],["ひどい"],["災害","さいがい"],["で"],["痛めつけた","いためつけた"],["。"]]},{"verse":18,"text":"そこでパロはアブラムを呼び寄せて言った。「あなたは私にいったい何ということをしたのか。なぜ彼女があなたの妻であることを、告げなかったのか。","tok":[["そこ"],["で"],["パロ"],["は"],["アブラム"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["に"],["いったい"],["何","なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["か"],["。"],["なぜ"],["彼女","かのじょ"],["が"],["あなた"],["の"],["妻","つま"],["で"],["ある"],["こと"],["を"],["、"],["告げなかった","つげなかった"],["の"],["か"],["。"]]},{"verse":19,"text":"なぜ彼女があなたの妹だと言ったのか。だから、私は彼女を私の妻として召し入れていた。しかし、さあ今、あなたの妻を連れて行きなさい。」","tok":[["なぜ"],["彼女","かのじょ"],["が"],["あなた"],["の"],["妹","いもうと"],["だ"],["と"],["言った","いった"],["の"],["か"],["。"],["だ"],["から"],["、"],["私","わたくし"],["は"],["彼女","かのじょ"],["を"],["私","わたくし"],["の"],["妻","つま"],["として"],["召し入れて","めしいれて"],["いた"],["。"],["しかし"],["、"],["さあ"],["今","いま"],["、"],["あなた"],["の"],["妻","つま"],["を"],["連れて","つれて"],["行き","いき"],["なさい"],["。"],["」"]]},{"verse":20,"text":"パロはアブラムについて部下に命じた。彼らは彼を、彼の妻と、彼のすべての所有物とともに送り出した。","tok":[["パロ"],["は"],["アブラム"],["について"],["部下","ぶか"],["に"],["命じた","めいじた"],["。"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["を"],["、"],["彼","かれ"],["の"],["妻","つま"],["と"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["所有物","しょゆうぶつ"],["と"],["とも"],["に"],["送り出した","おくりだした"],["。"]]}]
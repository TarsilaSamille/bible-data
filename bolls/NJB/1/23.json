[{"verse":1,"text":"サラの一生、サラが生きた年数は百二十七年であった。","tok":[["サラ"],["の"],["一生","いっしょう"],["、"],["サラ"],["が"],["生きた","いきた"],["年数","ねんすう"],["は"],["百二十七","ひゃくにじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":2,"text":"サラはカナンの地のキルヤテ・アルバ、すなわちヘブロンで死んだ。アブラハムは来てサラのために嘆き、泣いた。","tok":[["サラ"],["は"],["カナン"],["の"],["地","ち"],["の"],["キルヤテ"],["・"],["アルバ"],["、"],["すなわち"],["ヘブロン"],["で"],["死んだ","しんだ"],["。"],["アブラハム"],["は"],["来て","きて"],["サラ"],["の"],["ため"],["に"],["嘆き","なげき"],["、"],["泣いた","ないた"],["。"]]},{"verse":3,"text":"それからアブラハムは、その死者のそばから立ち上がり、ヘテ人たちに告げて言った。","tok":[["それ"],["から"],["アブラハム"],["は"],["、"],["その"],["死者","ししゃ"],["の"],["そば"],["から"],["立ち上がり","たちあがり"],["、"],["ヘテ人","へてにん"],["たち"],["に"],["告げて","つげて"],["言った","いった"],["。"]]},{"verse":4,"text":"「私はあなたがたの中に居留している異国人ですが、あなたがたのところで私有の墓地を私に譲っていただきたい。そうすれば私のところから移して、死んだ者を葬ることができるのです。」","tok":[["「"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["中","なか"],["に"],["居留","きょりゅう"],["して"],["いる"],["異国人","いこくにん"],["です"],["が"],["、"],["あなた"],["がた"],["の"],["ところ"],["で"],["私有","しゆう"],["の"],["墓地","ぼち"],["を"],["私","わたくし"],["に"],["譲って","ゆずって"],["いただきたい"],["。"],["そう"],["すれば"],["私","わたくし"],["の"],["ところ"],["から"],["移して","うつして"],["、"],["死んだ","しんだ"],["者","もの"],["を"],["葬る","ほうむる"],["こと"],["が"],["できる"],["の"],["です"],["。"],["」"]]},{"verse":5,"text":"ヘテ人たちはアブラハムに答えて言った。","tok":[["ヘテ人","へてにん"],["たち"],["は"],["アブラハム"],["に"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":6,"text":"「ご主人。私たちの言うことを聞き入れてください。あなたは私たちの間にあって、神のつかさです。私たちの最上の墓地に、なくなられた方を葬ってください。私たちの中で、だれひとり、なくなられた方を葬る墓地を拒む者はおりません。」","tok":[["「"],["ご主人","ごしゅじん"],["。"],["私たち","わたしたち"],["の"],["言う","いう"],["こと"],["を"],["聞き入れて","ききいれて"],["ください"],["。"],["あなた"],["は"],["私たち","わたしたち"],["の"],["間","あいだ"],["に"],["あって"],["、"],["神","かみ"],["の"],["つかさ"],["です"],["。"],["私たち","わたしたち"],["の"],["最上","さいじょう"],["の"],["墓地","ぼち"],["に"],["、"],["なくなられた"],["方","ほう"],["を"],["葬って","ほうむって"],["ください"],["。"],["私たち","わたしたち"],["の"],["中","なか"],["で"],["、"],["だれ"],["ひとり"],["、"],["なくなられた"],["方","ほう"],["を"],["葬る","ほうむる"],["墓地","ぼち"],["を"],["拒む","こばむ"],["者","もの"],["は"],["おりません"],["。"],["」"]]},{"verse":7,"text":"そこでアブラハムは立って、その土地の人々、ヘテ人にていねいにおじぎをして、","tok":[["そこ"],["で"],["アブラハム"],["は"],["立って","たって"],["、"],["その"],["土地","とち"],["の"],["人々","ひとびと"],["、"],["ヘテ人","へてにん"],["に"],["ていねい"],["に"],["おじぎ"],["を"],["して"],["、"]]},{"verse":8,"text":"彼らに告げて言った。「死んだ者を私のところから移して葬ることが、あなたがたのおこころであれば、私の言うことを聞いて、ツォハルの子エフロンに交渉して、","tok":[["彼","かれ"],["ら"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["死んだ","しんだ"],["者","もの"],["を"],["私","わたくし"],["の"],["ところ"],["から"],["移して","うつして"],["葬る","ほうむる"],["こと"],["が"],["、"],["あなた"],["がた"],["の"],["おこころ"],["で"],["あれば"],["、"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["、"],["ツォハル"],["の"],["子","こ"],["エフロン"],["に"],["交渉","こうしょう"],["して"],["、"]]},{"verse":9,"text":"彼の畑地の端にある彼の所有のマクペラのほら穴を私に譲ってくれるようにしてください。彼があなたがたの間でその畑地に十分な価をつけて、私に私有の墓地として譲ってくれるようにしてください。」","tok":[["彼","かれ"],["の"],["畑地","はたち"],["の"],["端","はし"],["に"],["ある"],["彼","かれ"],["の"],["所有","しょゆう"],["の"],["マクペラ"],["の"],["ほら穴","ほらあな"],["を"],["私","わたくし"],["に"],["譲って","ゆずって"],["くれる"],["よう"],["に"],["して"],["ください"],["。"],["彼","かれ"],["が"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["その"],["畑地","はたち"],["に"],["十分","じゅうぶん"],["な"],["価","あたい"],["を"],["つけて"],["、"],["私","わたくし"],["に"],["私有","しゆう"],["の"],["墓地","ぼち"],["として"],["譲って","ゆずって"],["くれる"],["よう"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":10,"text":"エフロンはヘテ人たちの間にすわっていた。ヘテ人のエフロンは、その町の門に入って来たヘテ人たちみなが聞いているところで、アブラハムに答えて言った。","tok":[["エフロン"],["は"],["ヘテ人","へてにん"],["たち"],["の"],["間","あいだ"],["に"],["すわって"],["いた"],["。"],["ヘテ人","へてにん"],["の"],["エフロン"],["は"],["、"],["その"],["町","まち"],["の"],["門","もん"],["に"],["入って","はいって"],["来た","きた"],["ヘテ人","へてにん"],["たち"],["みな"],["が"],["聞いて","きいて"],["いる"],["ところ"],["で"],["、"],["アブラハム"],["に"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":11,"text":"「ご主人。どうか、私の言うことを聞き入れてください。畑地をあなたに差し上げます。そこにあるほら穴も、差し上げます。私の国の人々の前で、それをあなたに差し上げます。なくなられた方を、葬ってください。」","tok":[["「"],["ご主人","ごしゅじん"],["。"],["どう"],["か"],["、"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞き入れて","ききいれて"],["ください"],["。"],["畑地","はたち"],["を"],["あなた"],["に"],["差し上げます","さしあげます"],["。"],["そこ"],["に"],["ある"],["ほら穴","ほらあな"],["も"],["、"],["差し上げます","さしあげます"],["。"],["私","わたくし"],["の"],["国","くに"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["、"],["それ"],["を"],["あなた"],["に"],["差し上げます","さしあげます"],["。"],["なくなられた"],["方","ほう"],["を"],["、"],["葬って","ほうむって"],["ください"],["。"],["」"]]},{"verse":12,"text":"アブラハムは、その土地の人々におじぎをし、","tok":[["アブラハム"],["は"],["、"],["その"],["土地","とち"],["の"],["人々","ひとびと"],["に"],["おじぎ"],["を"],["し"],["、"]]},{"verse":13,"text":"その土地の人々の聞いているところで、エフロンに告げて言った。「もしあなたが許してくださるなら、私の言うことを聞き入れてください。私は畑地の代価をお払いします。どうか私から受け取ってください。そうすれば、死んだ者をそこに葬ることができます。」","tok":[["その"],["土地","とち"],["の"],["人々","ひとびと"],["の"],["聞いて","きいて"],["いる"],["ところ"],["で"],["、"],["エフロン"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["もし"],["あなた"],["が"],["許して","ゆるして"],["くださるなら"],["、"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞き入れて","ききいれて"],["ください"],["。"],["私","わたくし"],["は"],["畑地","はたち"],["の"],["代価","だいか"],["を"],["お払い","おはらい"],["します"],["。"],["どう"],["か"],["私","わたくし"],["から"],["受け取って","うけとって"],["ください"],["。"],["そう"],["すれば"],["、"],["死んだ","しんだ"],["者","もの"],["を"],["そこ"],["に"],["葬る","ほうむる"],["こと"],["が"],["できます"],["。"],["」"]]},{"verse":14,"text":"エフロンはアブラハムに答えて言った。","tok":[["エフロン"],["は"],["アブラハム"],["に"],["答えて","こたえて"],["言った","いった"],["。"]]},{"verse":15,"text":"「ではご主人。私の言うことを聞いてください。銀四百シェケルの土地、それなら私とあなたとの間では、何ほどのこともないでしょう。どうぞ、なくなられた方を葬ってください。」","tok":[["「"],["で"],["は"],["ご主人","ごしゅじん"],["。"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["ください"],["。"],["銀","ぎん"],["四百","よんひゃく"],["シェケル"],["の"],["土地","とち"],["、"],["それ"],["なら"],["私","わたくし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["で"],["は"],["、"],["何","なん"],["ほど"],["の"],["こと"],["も"],["ないでしょう"],["。"],["どうぞ"],["、"],["なくなられた"],["方","ほう"],["を"],["葬って","ほうむって"],["ください"],["。"],["」"]]},{"verse":16,"text":"アブラハムはエフロンの申し出を聞き入れ、エフロンがヘテ人たちの聞いているところでつけた代価、通り相場で銀四百シェケルを計ってエフロンに渡した。","tok":[["アブラハム"],["は"],["エフロン"],["の"],["申し出","もうしで"],["を"],["聞き入れ","ききいれ"],["、"],["エフロン"],["が"],["ヘテ人","へてにん"],["たち"],["の"],["聞いて","きいて"],["いる"],["
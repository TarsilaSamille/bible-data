[{"verse":1,"text":"イスラエルは、彼に属するすべてのものといっしょに出発し、ベエル・シェバに来たとき、父イサクの神にいけにえをささげた。","tok":[["イスラエル"],["は"],["、"],["彼","かれ"],["に"],["属する","ぞくする"],["すべて"],["の"],["もの"],["と"],["いっしょ"],["に"],["出発","しゅっぱつ"],["し"],["、"],["ベエル"],["・"],["シェバ"],["に"],["来た","きた"],["とき"],["、"],["父","ちち"],["イサク"],["の"],["神","かみ"],["に"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":2,"text":"神は、夜の幻の中でイスラエルに、「ヤコブよ、ヤコブよ」と言って呼ばれた。彼は答えた。「はい。ここにいます。」","tok":[["神","かみ"],["は"],["、"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["中","なか"],["で"],["イスラエル"],["に"],["、"],["「"],["ヤコブ"],["よ"],["、"],["ヤコブ"],["よ"],["」"],["と"],["言って","いって"],["呼ばれた","よばれた"],["。"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["はい"],["。"],["ここ"],["に"],["います"],["。"],["」"]]},{"verse":3,"text":"すると仰せられた。「わたしは神、あなたの父の神である。エジプトに下ることを恐れるな。わたしはそこで、あなたを大いなる国民にするから。","tok":[["する"],["と"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["神","かみ"],["、"],["あなた"],["の"],["父","ちち"],["の"],["神","かみ"],["で"],["ある"],["。"],["エジプト"],["に"],["下る","くだる"],["こと"],["を"],["恐れる","おそれる"],["な"],["。"],["わたし"],["は"],["そこ"],["で"],["、"],["あなた"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["に"],["する"],["から"],["。"]]},{"verse":4,"text":"わたし自身があなたといっしょにエジプトに下り、また、わたし自身が必ずあなたを再び導き上る。ヨセフの手はあなたの目を閉じてくれるであろう。」","tok":[["わたし"],["自身","じしん"],["が"],["あなた"],["と"],["いっしょ"],["に"],["エジプト"],["に"],["下り","くだり"],["、"],["また"],["、"],["わたし"],["自身","じしん"],["が"],["必ず","かならず"],["あなた"],["を"],["再び","ふたたび"],["導き","みちびき"],["上る","のぼる"],["。"],["ヨセフ"],["の"],["手","て"],["は"],["あなた"],["の"],["目","め"],["を"],["閉じて","とじて"],["くれるで"],["あろう"],["。"],["」"]]},{"verse":5,"text":"それから、ヤコブはベエル・シェバを立った。イスラエルの子らは、ヤコブを乗せるためにパロが送った車に、父ヤコブと自分たちの子や妻を乗せ、","tok":[["それ"],["から"],["、"],["ヤコブ"],["は"],["ベエル"],["・"],["シェバ"],["を"],["立った","たった"],["。"],["イスラエル"],["の"],["子","こ"],["ら"],["は"],["、"],["ヤコブ"],["を"],["乗せる","のせる"],["ため"],["に"],["パロ"],["が"],["送った","おくった"],["車","くるま"],["に"],["、"],["父","ちち"],["ヤコブ"],["と"],["自分","じぶん"],["たち"],["の"],["子","こ"],["や"],["妻","つま"],["を"],["乗せ","のせ"],["、"]]},{"verse":6,"text":"また彼らは家畜とカナンの地で得た財産も持って行った。こうしてヤコブはそのすべての子孫といっしょにエジプトに来た。","tok":[["また"],["彼","かれ"],["ら"],["は"],["家畜","かちく"],["と"],["カナン"],["の"],["地","ち"],["で"],["得た","えた"],["財産","ざいさん"],["も"],["持って","もって"],["行った","いった"],["。"],["こう"],["して"],["ヤコブ"],["は"],["その"],["すべて"],["の"],["子孫","しそん"],["と"],["いっしょ"],["に"],["エジプト"],["に"],["来た","きた"],["。"]]},{"verse":7,"text":"すなわち、彼は、自分の息子たちと孫たち、自分の娘たちと孫娘たち、こうしてすべての子孫を連れてエジプトに来た。","tok":[["すなわち"],["、"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["の"],["息子","むすこ"],["たち"],["と"],["孫","まご"],["たち"],["、"],["自分","じぶん"],["の"],["娘","むすめ"],["たち"],["と"],["孫娘","まごむすめ"],["たち"],["、"],["こう"],["して"],["すべて"],["の"],["子孫","しそん"],["を"],["連れて","つれて"],["エジプト"],["に"],["来た","きた"],["。"]]},{"verse":8,"text":"エジプトに来たイスラエルの子――ヤコブとその子――の名は次のとおりである。ヤコブの長子ルベン。","tok":[["エジプト"],["に"],["来た","きた"],["イスラエル"],["の"],["子","こ"],["―"],["―"],["ヤコブ"],["と"],["その"],["子","こ"],["―"],["―"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ヤコブ"],["の"],["長子","ちょうし"],["ルベン"],["。"]]},{"verse":9,"text":"ルベンの子はエノク、パル、ヘツロン、カルミ。","tok":[["ルベン"],["の"],["子","こ"],["は"],["エノク"],["、"],["パル"],["、"],["ヘツロン"],["、"],["カルミ"],["。"]]},{"verse":10,"text":"シメオンの子はエムエル、ヤミン、オハデ、ヤキン、ツォハル、カナンの女の産んだ子サウル。","tok":[["シメオン"],["の"],["子","こ"],["は"],["エムエル"],["、"],["ヤミン"],["、"],["オハデ"],["、"],["ヤキン"],["、"],["ツォハル"],["、"],["カナン"],["の"],["女","おんな"],["の"],["産んだ","うんだ"],["子","こ"],["サウル"],["。"]]},{"verse":11,"text":"レビの子はゲルション、ケハテ、メラリ。","tok":[["レビ"],["の"],["子","こ"],["は"],["ゲルション"],["、"],["ケハテ"],["、"],["メラリ"],["。"]]},{"verse":12,"text":"ユダの子はエル、オナン、シェラ、ペレツ、ゼラフ。しかしエルとオナンはカナンの地で死んだ。ペレツの子はヘツロンとハムルであった。","tok":[["ユダ"],["の"],["子","こ"],["は"],["エル"],["、"],["オナン"],["、"],["シェラ"],["、"],["ペレツ"],["、"],["ゼラフ"],["。"],["しかし"],["エル"],["と"],["オナン"],["は"],["カナン"],["の"],["地","ち"],["で"],["死んだ","しんだ"],["。"],["ペレツ"],["の"],["子","こ"],["は"],["ヘツロン"],["と"],["ハムル"],["で"],["あった"],["。"]]},{"verse":13,"text":"イッサカルの子はトラ、プワ、ヨブ、シムロン。","tok":[["イッサカル"],["の"],["子","こ"],["は"],["トラ"],["、"],["プワ"],["、"],["ヨブ"],["、"],["シムロン"],["。"]]},{"verse":14,"text":"ゼブルンの子はセレデ、エロン、ヤフレエル。","tok":[["ゼブルン"],["の"],["子","こ"],["は"],["セレデ"],["、"],["エロン"],["、"],["ヤフレエル"],["。"]]},{"verse":15,"text":"これらはレアがパダン・アラムでヤコブに産んだ子で、それにその娘ディナがあり、彼の息子、娘たちの総勢は三十三人。","tok":[["これ"],["ら"],["は"],["レア"],["が"],["パダン"],["・"],["アラム"],["で"],["ヤコブ"],["に"],["産んだ","うんだ"],["子","こ"],["で"],["、"],["それ"],["に"],["その"],["娘","むすめ"],["ディナ"],["が"],["あり"],["、"],["彼","かれ"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["の"],["総勢","そうぜい"],["は"],["三十三人","さんじゅうさんにん"],["。"]]},{"verse":16,"text":"ガドの子はツィフヨン、ハギ、シュニ、エツボン、エリ、アロディ、アルエリ。","tok":[["ガド"],["の"],["子","こ"],["は"],["ツィフヨン"],["、"],["ハギ"],["、"],["シュニ"],["、"],["エツボン"],["、"],["エリ"],["、"],["アロディ"],["、"],["アルエリ"],["。"]]},{"verse":17,"text":"アシェルの子はイムナ、イシュワ、イシュビ、ベリアとその妹セラフ。ベリアの子はヘベル、マルキエル。","tok":[["アシェル"],["の"],["子","こ"],["は"],["イムナ"],["、"],["イシュワ"],["、"],["イシュビ"],["、"],["ベリア"],["と"],["その"],["妹","いもうと"],["セラフ"],["。"],["ベリア"],["の"],["子","こ"],["は"],["ヘベル"],["、"],["マルキエル"],["。"]]},{"verse":18,"text":"これらは、ラバンが娘レアに与えたジルパの子である。彼女がヤコブに産んだのは十六人であった。","tok":[["これ"],["ら"],["は"],["、"],["ラバン"],["が"],["娘","むすめ"],["レア"],["に"],["与えた","あたえた"],["ジルパ"],["の"],["子","こ"],["で"],["ある"],["。"],["彼女","かのじょ"],["が"],["ヤコブ"],["に"],["産んだ","うんだ"],["の"],["は"],["十六人","じゅうろくにん"],["で"],["あった"],["。"]]},{"verse":19,"text":"ヤコブの妻ラケルの子はヨセフとベニヤミンである。","tok":[["ヤコブ"],["の"],["妻","つま"],["ラケル"],["の"],["子","こ"],["は"],["ヨセフ"],["と"],["ベニヤミン"],["で"],["ある"],["。"]]},{"verse":20,"text":"ヨセフにはエジプトの地で子どもが生まれた。それはオンの祭司ポティ・フェラの娘アセナテが彼に産んだマナセとエフライムである。","tok":[["ヨセフ"],["に"],["は"],["エジプト"],["の"],["地","ち"],["で"],["子ども","こども"],["が"],["生まれた","うまれた"],["。"],["それ"],["は"],["オン"],["の"],["祭司","さいし"],["ポティ"],["・"],["フェラ"],["の"],["娘","むすめ"],["アセナテ"],["が"],["彼","かれ"],["に"],["産んだ","うんだ"],["マナセ"],["と"],["エフライム"],["で"],["ある"],["。"]]},{"verse":21,"text":"ベニヤミンの子はベラ、ベケル、アシュベル、ゲラ、ナアマン、エヒ、ロシュ、ムピム、フピム、アルデ。","tok":[["ベニヤミン"],["の"],["子","こ"],["は"],["ベラ"],["、"],["ベケル"],["、"],["アシュベル"],["、"],["ゲラ"],["、"],["ナアマン"],["、"],["エヒ"],["、"],["ロシュ"],["、"],["ムピム"],["、"],["フピム"],["、"],["アルデ"],["。"]]},{"verse":22,"text":"これらはラケルがヤコブに産んだ子で、みなで十四人である。","tok":[["これ"],["ら"],["は"],["ラケル"],["が"],["ヤコブ"],["に"],["産んだ","うんだ"],["子","こ"],["で"],["、"],["みな"],["で"],["十四人","じゅうよんにん"],["で"],["ある"],["。"]]},{"verse":23,"text":"ダンの子はフシム。","tok":[["ダン"],["の"],["子","こ"],["は"],["フシム"],["。"]]},{"verse":24,"text":"ナフタリの子はヤフツェエル、グニ、エツェル、シレム。","tok":[["ナフタリ"],["の"],["子","こ"],["は"],["ヤフツェエル"],["、"],["グニ"],["、"],["エツェル"],["、"],["シレム"],["。"]]},{"verse":25,"text":"これらはラバンが娘ラケルに与えたビルハの子である。彼女がヤコブに産んだのはみなで七人であった。","tok":[["これ"],["ら"],["は"],["ラバン"],["が"],["娘","むすめ"],["ラケル"],["に"],["与えた","あたえた"],["ビルハ"],["の"],["子","こ"],["で"],["ある"],["。"],["彼女","かのじょ"],["が"],["ヤコブ"],["に"],["産んだ","うんだ"],["の"],["は"],["みな"],["で"],["七人","ななにん"],["で"],["あった"],["。"]]},{"verse":26,"text":"ヤコブに属する者、すなわち、ヤコブから生まれた子でエジプトへ行った者は、ヤコブの息子たちの妻は別として、みなで六十六人であった。","tok":[["ヤコブ"],["に"],["属する","ぞくする"],["者","もの"],["、"],["すなわち"],["、"],["ヤコブ"],["から"],["生まれた","うまれた"],["子","こ"],["で"],["エジプト"],["へ"],["行った","いった"],["者","もの"],["は"],["、"],["ヤコブ"],["の"],["息子","むすこ"],["たち"],["の"],["妻","つま"],["は"],["別","べつ"],["として"],["、"],["みな"],["で"],["六十六人","ろくじゅうろくにん"],["で"],["あった"],["。"]]},{"verse":27,"text":"エジプトでヨセフに生まれた子らはふたりで、エジプトに行ったヤコブの家族はみなで七十人であった。","tok":[["エジプト"],["で"],["ヨセフ"],["に"],["生まれた","うまれた"],["子","こ"],["ら"],["は"],["ふたり"],["で"],["、"],["エジプト"],["に"],["行った","いった"],["ヤコブ"],["の"],["家族","かぞく"],["は"],["みな"],["で"],["七","なな"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":28,"text":"さて、ヤコブはユダを先にヨセフのところに遣わしてゴシェンへの道を示させた。それから彼らはゴシェンの地に行った。","tok":[["さて"],["、"],["ヤコブ"],["は"],["ユダ"],["を"],["先","さき"],["に"],["ヨセフ"],["の"],["ところ"],["に"],["遣わして","つかわして"],["ゴシェン"],["へ"],["の"],["道","みち"],["を"],["示させた","しめさせた"],["。"],["それ"],["から"],["彼","かれ"],["ら"],["は"],["ゴシェン"],["の"],["地","ち"],["に"],["行った","いった"],["。"]]},{"verse":29,"text":"ヨセフは車を整え、父イスラエルを迎えるためにゴシェンへ上った。そして父に会うなり、父の首に抱きつき、その首にすがって泣き続けた。","tok":[["ヨセフ"],["は"],["車","くるま"],["を"],["整え","ととのえ"],["、"],["父","ちち"],["イスラエル"],["を"],["迎える","むかえる"],["ため"],["に"],["ゴシェン"],["へ"],["上った","のぼった"],["。"],["そして"],["父","ちち"],["に"],["会う","あう"],["なり"],["、"],["父","ちち"],["の"],["首","くび"],["に"],["抱きつき","だきつき"],["、"],["その"],["首","くび"],["に"],["すがって"],["泣き","なき"],["続けた","つづけた"],["。"]]},{"verse":30,"text":"イスラエルはヨセフに言った。「もう今、私は死んでもよい。この目であなたが生きているのを見たからには。」","tok":[["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["もう"],["今","いま"],["、"],["私","わたくし"],["は"],["死んで","しんで"],["も"],["よい"],["。"],["この"],["目","め"],["で"],["あなた"],["が"],["生きて","いきて"],["いる"],["の"],["を"],["見た","みた"],["から"],["に"],["は"],["。"],["」"]]},{"verse":31,"text":"ヨセフは兄弟たちや父の家族の者たちに言った。「私はパロのところに知らせに行き、申しましょう。『カナンの地にいた私の兄弟と父の家族の者たちが私のところに来ました。","tok":[["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["や"],["父","ちち"],["の"],["家族","かぞく"],["の"],["者","もの"],["たち"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["パロ"],["の"],["ところ"],["に"],["知らせ","しらせ"],["に"],["行き","いき"],["、"],["申しましょう","もうしましょう"],["。"],["『"],["カナン"],["の"],["地","ち"],["に"],["いた"],["私","わたくし"],["の"],["兄弟","きょうだい"],["と"],["父","ちち"],["の"],["家族","かぞく"],["の"],["者","もの"],["たち"],["が"],["私","わたくし"],["の"],["ところ"],["に"],["来ました","きました"],["。"]]},{"verse":32,"text":"この人たちは羊を飼う者です。家畜を飼っていた者です。彼らは、自分たちの羊と牛と彼らのものすべてを連れて来ました。』","tok":[["この"],["人","ひと"],["たち"],["は"],["羊","ひつじ"],["を"],["飼う","かう"],["者","もの"],["です"],["。"],["家畜","かちく"],["を"],["飼って","かって"],["いた"],["者","もの"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["羊","ひつじ"],["と"],["牛","うし"],["と"],["彼","かれ"],["ら"],["の"],["もの"],["すべて"],["を"],["連れて","つれて"],["来ました","きました"],["。"],["』"]]},{"verse":33,"text":"パロがあなたがたを呼び寄せて、『あなたがたの職業は何か』と聞くようなときには、","tok":[["パロ"],["が"],["あなた"],["がた"],["を"],["呼び寄せて","よびよせて"],["、"],["『"],["あなた"],["がた"],["の"],["職業","しょくぎょう"],["は"],["何","なん"],["か"],["』"],["と"],["聞く","きく"],["よう"],["な"],["とき"],["に"],["は"],["、"]]},{"verse":34,"text":"あなたがたは答えなさい。『あなたのしもべどもは若い時から今まで、私たちも、また私たちの先祖も家畜を飼う者でございます』と。そうすれば、あなたがたはゴシェンの地に住むことができるでしょう。羊を飼う者はすべて、エジプト人に忌みきらわれているからです。」","tok":[["あなた"],["がた"],["は"],["答え","こたえ"],["なさい"],["。"],["『"],["あなた"],["の"],["しもべ"],["ども"],["は"],["若い","わかい"],["時","とき"],["から"],["今まで","いままで"],["、"],["私たち","わたしたち"],["も"],["、"],["また"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["も"],["家畜","かちく"],["を"],["飼う","かう"],["者","もの"],["で"],["ございます"],["』"],["と"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["ゴシェン"],["の"],["地","ち"],["に"],["住む","すむ"],["こと"],["が"],["できるでしょう"],["。"],["羊","ひつじ"],["を"],["飼う","かう"],["者","もの"],["は"],["すべて"],["、"],["エジプト"],["人","にん"],["に"],["忌みきらわれて","いみきらわれて"],["いる"],["から"],["です"],["。"],["」"]]}]
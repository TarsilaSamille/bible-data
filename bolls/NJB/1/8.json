[{"verse":1,"text":"神は、ノアと、箱舟の中に彼といっしょにいたすべての獣や、すべての家畜とを心に留めておられた。それで、神が地の上に風を吹き過ぎさせると、水は引き始めた。","tok":[["神","かみ"],["は"],["、"],["ノア"],["と"],["、"],["箱舟","はこぶね"],["の"],["中","なか"],["に"],["彼","かれ"],["と"],["いっしょ"],["に"],["いた"],["すべて"],["の"],["獣","けもの"],["や"],["、"],["すべて"],["の"],["家畜","かちく"],["と"],["を"],["心","こころ"],["に"],["留めて","とめて"],["おられた"],["。"],["それ"],["で"],["、"],["神","かみ"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["風","かぜ"],["を"],["吹き過ぎさせる","ふきすぎさせる"],["と"],["、"],["水","みず"],["は"],["引き","ひき"],["始めた","はじめた"],["。"]]},{"verse":2,"text":"また、大いなる水の源と天の水門が閉ざされ、天からの大雨が、とどめられた。","tok":[["また"],["、"],["大いなる","おおいなる"],["水","みず"],["の"],["源","みなもと"],["と"],["天","てん"],["の"],["水門","すいもん"],["が"],["閉ざされ","とざされ"],["、"],["天","てん"],["から"],["の"],["大雨","おおあめ"],["が"],["、"],["とどめられた"],["。"]]},{"verse":3,"text":"そして、水は、しだいに地から引いていった。水は百五十日の終わりに減り始め、","tok":[["そして"],["、"],["水","みず"],["は"],["、"],["しだい"],["に"],["地","ち"],["から"],["引いて","ひいて"],["いった"],["。"],["水","みず"],["は"],["百五十日","ひゃくごとうか"],["の"],["終わり","おわり"],["に"],["減り","へり"],["始め","はじめ"],["、"]]},{"verse":4,"text":"箱舟は、第七の月の十七日に、アララテの山の上にとどまった。","tok":[["箱舟","はこぶね"],["は"],["、"],["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["十七","じゅうなな"],["日","にち"],["に"],["、"],["アララテ"],["の"],["山","やま"],["の"],["上","うえ"],["に"],["とどまった"],["。"]]},{"verse":5,"text":"水は第十の月まで、ますます減り続け、第十の月の一日に、山々の頂が現れた。","tok":[["水","みず"],["は"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["まで"],["、"],["ますます"],["減り","へり"],["続け","つづけ"],["、"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["、"],["山々","やまやま"],["の"],["頂","いただき"],["が"],["現れた","あらわれた"],["。"]]},{"verse":6,"text":"四十日の終わりになって、ノアは、自分の造った箱舟の窓を開き、","tok":[["四十日","よんとうか"],["の"],["終わり","おわり"],["に"],["なって"],["、"],["ノア"],["は"],["、"],["自分","じぶん"],["の"],["造った","つくった"],["箱舟","はこぶね"],["の"],["窓","まど"],["を"],["開き","ひらき"],["、"]]},{"verse":7,"text":"烏を放った。するとそれは、水が地からかわききるまで、出たり、戻ったりしていた。","tok":[["烏","からす"],["を"],["放った","はなった"],["。"],["する"],["と"],["それ"],["は"],["、"],["水","みず"],["が"],["地","ち"],["から"],["かわき"],["きる"],["まで"],["、"],["出","で"],["たり"],["、"],["戻っ","もどっ"],["たり"],["して"],["いた"],["。"]]},{"verse":8,"text":"また、彼は水が地の面から引いたかどうかを見るために、鳩を彼のもとから放った。","tok":[["また"],["、"],["彼","かれ"],["は"],["水","みず"],["が"],["地","ち"],["の"],["面","めん"],["から"],["引いた","ひいた"],["か"],["どう"],["か"],["を"],["見る","みる"],["ため"],["に"],["、"],["鳩","はと"],["を"],["彼","かれ"],["の"],["もと"],["から"],["放った","はなった"],["。"]]},{"verse":9,"text":"鳩は、その足を休める場所が見あたらなかったので、箱舟の彼のもとに帰って来た。水が全地の面にあったからである。彼は手を差し伸べて鳩を捕らえ、箱舟の自分のところに入れた。","tok":[["鳩","はと"],["は"],["、"],["その"],["足","あし"],["を"],["休める","やすめる"],["場所","ばしょ"],["が"],["見あたらなかった","みあたらなかった"],["ので"],["、"],["箱舟","はこぶね"],["の"],["彼","かれ"],["の"],["もと"],["に"],["帰って","かえって"],["来た","きた"],["。"],["水","みず"],["が"],["全地","ぜんち"],["の"],["面","めん"],["に"],["あった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["手","て"],["を"],["差し伸べて","さしのべて"],["鳩","はと"],["を"],["捕らえ","とらえ"],["、"],["箱舟","はこぶね"],["の"],["自分","じぶん"],["の"],["ところ"],["に"],["入れた","いれた"],["。"]]},{"verse":10,"text":"それからなお七日待って、再び鳩を箱舟から放った。","tok":[["それ"],["から"],["なお"],["七","なな"],["日","にち"],["待って","まって"],["、"],["再び","ふたたび"],["鳩","はと"],["を"],["箱舟","はこぶね"],["から"],["放った","はなった"],["。"]]},{"verse":11,"text":"鳩は夕方になって、彼のもとに帰って来た。すると見よ。むしり取ったばかりのオリーブの若葉がそのくちばしにあるではないか。それで、ノアは水が地から引いたのを知った。","tok":[["鳩","はと"],["は"],["夕方","ゆうがた"],["に"],["なって"],["、"],["彼","かれ"],["の"],["もと"],["に"],["帰って","かえって"],["来た","きた"],["。"],["する"],["と"],["見よ","みよ"],["。"],["むしり取った","むしりとった"],["ばかり"],["の"],["オリーブ"],["の"],["若葉","わかば"],["が"],["その"],["くちばし"],["に"],["ある"],["で"],["は"],["ない"],["か"],["。"],["それ"],["で"],["、"],["ノア"],["は"],["水","みず"],["が"],["地","ち"],["から"],["引いた","ひいた"],["の"],["を"],["知った","しった"],["。"]]},{"verse":12,"text":"それからなお、七日待って、彼は鳩を放った。鳩はもう彼のところに戻って来なかった。","tok":[["それ"],["から"],["なお"],["、"],["七","なな"],["日","にち"],["待って","まって"],["、"],["彼","かれ"],["は"],["鳩","はと"],["を"],["放った","はなった"],["。"],["鳩","はと"],["は"],["もう"],["彼","かれ"],["の"],["ところ"],["に"],["戻って","もどって"],["来なかった","こなかった"],["。"]]},{"verse":13,"text":"ノアの生涯の第六百一年の第一の月の一日になって、水は地上からかわき始めた。ノアが、箱舟のおおいを取り去って、ながめると、見よ、地の面は、かわいていた。","tok":[["ノア"],["の"],["生涯","しょうがい"],["の"],["第","だい"],["六百一","ろくひゃくいち"],["年","ねん"],["の"],["第","だい"],["一","いち"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["なって"],["、"],["水","みず"],["は"],["地上","ちじょう"],["から"],["かわき"],["始めた","はじめた"],["。"],["ノア"],["が"],["、"],["箱舟","はこぶね"],["の"],["おおい"],["を"],["取り去って","とりさって"],["、"],["ながめる"],["と"],["、"],["見よ","みよ"],["、"],["地","ち"],["の"],["面","めん"],["は"],["、"],["かわいて"],["いた"],["。"]]},{"verse":14,"text":"第二の月の二十七日、地はかわききった。","tok":[["第","だい"],["二","に"],["の"],["月","つき"],["の"],["二十七日","にじゅうななか"],["、"],["地","ち"],["は"],["かわき"],["きった"],["。"]]},{"verse":15,"text":"そこで、神はノアに告げて仰せられた。","tok":[["そこ"],["で"],["、"],["神","かみ"],["は"],["ノア"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":16,"text":"「あなたは、あなたの妻と、あなたの息子たちと、息子たちの妻といっしょに箱舟から出なさい。","tok":[["「"],["あなた"],["は"],["、"],["あなた"],["の"],["妻","つま"],["と"],["、"],["あなた"],["の"],["息子","むすこ"],["たち"],["と"],["、"],["息子","むすこ"],["たち"],["の"],["妻","つま"],["と"],["いっしょ"],["に"],["箱舟","はこぶね"],["から"],["出","で"],["なさい"],["。"]]},{"verse":17,"text":"あなたといっしょにいるすべての肉なるものの生き物、すなわち鳥や家畜や地をはうすべてのものを、あなたといっしょに連れ出しなさい。それらが地に群がり、地の上で生み、そしてふえるようにしなさい。」","tok":[["あなた"],["と"],["いっしょ"],["に"],["いる"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["の"],["生き物","いきもの"],["、"],["すなわち"],["鳥","とり"],["や"],["家畜","かちく"],["や"],["地","ち"],["を"],["はう"],["すべて"],["の"],["もの"],["を"],["、"],["あなた"],["と"],["いっしょ"],["に"],["連れ出し","つれだし"],["なさい"],["。"],["それ"],["ら"],["が"],["地","ち"],["に"],["群がり","むらがり"],["、"],["地","ち"],["の"],["上","うえ"],["で"],["生み","うみ"],["、"],["そして"],["ふえる"],["よう"],["に"],["し"],["なさい"],["。"],["」"]]},{"verse":18,"text":"そこで、ノアは、息子たちや彼の妻や、息子たちの妻といっしょに外に出た。","tok":[["そこ"],["で"],["、"],["ノア"],["は"],["、"],["息子","むすこ"],["たち"],["や"],["彼","かれ"],["の"],["妻","つま"],["や"],["、"],["息子","むすこ"],["たち"],["の"],["妻","つま"],["と"],["いっしょ"],["に"],["外","そと"],["に"],["出た","でた"],["。"]]},{"verse":19,"text":"すべての獣、すべてのはうもの、すべての鳥、すべて地の上を動くものは、おのおのその種類にしたがって、箱舟から出て来た。","tok":[["すべて"],["の"],["獣","けもの"],["、"],["すべて"],["の"],["はう"],["もの"],["、"],["すべて"],["の"],["鳥","とり"],["、"],["すべて"]
[{"verse":1,"text":"さてヤコブはラバンの息子たちが、「ヤコブはわれわれの父の物をみな取った。父の物でこのすべての富をものにしたのだ」と言っているのを聞いた。","tok":[["さて"],["ヤコブ"],["は"],["ラバン"],["の"],["息子","むすこ"],["たち"],["が"],["、"],["「"],["ヤコブ"],["は"],["われわれ"],["の"],["父","ちち"],["の"],["物","もの"],["を"],["みな"],["取った","とった"],["。"],["父","ちち"],["の"],["物","もの"],["で"],["この"],["すべて"],["の"],["富","とみ"],["を"],["もの"],["に"],["した"],["の"],["だ"],["」"],["と"],["言って","いって"],["いる"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"ヤコブもまた、彼に対するラバンの態度が、以前のようではないのに気づいた。","tok":[["ヤコブ"],["も"],["また"],["、"],["彼","かれ"],["に"],["対する","たいする"],["ラバン"],["の"],["態度","たいど"],["が"],["、"],["以前","いぜん"],["の"],["よう"],["で"],["は"],["ない"],["のに"],["気づいた","きづいた"],["。"]]},{"verse":3,"text":"主はヤコブに仰せられた。「あなたが生まれた、あなたの先祖の国に帰りなさい。わたしはあなたとともにいる。」","tok":[["主","ぬし"],["は"],["ヤコブ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["が"],["生まれた","うまれた"],["、"],["あなた"],["の"],["先祖","せんぞ"],["の"],["国","くに"],["に"],["帰り","かえり"],["なさい"],["。"],["わたし"],["は"],["あなた"],["と"],["とも"],["に"],["いる"],["。"],["」"]]},{"verse":4,"text":"そこでヤコブは使いをやって、ラケルとレアを自分の群れのいる野に呼び寄せ、","tok":[["そこ"],["で"],["ヤコブ"],["は"],["使い","つかい"],["を"],["やって"],["、"],["ラケル"],["と"],["レア"],["を"],["自分","じぶん"],["の"],["群れ","むれ"],["の"],["いる"],["野","の"],["に"],["呼び寄せ","よびよせ"],["、"]]},{"verse":5,"text":"彼女たちに言った。「私はあなたがたの父の態度が以前のようではないのに気がついている。しかし私の父の神は私とともにおられるのだ。","tok":[["彼女","かのじょ"],["たち"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["態度","たいど"],["が"],["以前","いぜん"],["の"],["よう"],["で"],["は"],["ない"],["のに"],["気","き"],["が"],["ついて"],["いる"],["。"],["しかし"],["私","わたくし"],["の"],["父","ちち"],["の"],["神","かみ"],["は"],["私","わたくし"],["と"],["とも"],["に"],["おられる"],["の"],["だ"],["。"]]},{"verse":6,"text":"あなたがたが知っているように、私はあなたがたの父に、力を尽くして仕えた。","tok":[["あなた"],["がた"],["が"],["知って","しって"],["いる"],["よう"],["に"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["の"],["父","ちち"],["に"],["、"],["力","ちから"],["を"],["尽くして","つくして"],["仕えた","つかえた"],["。"]]},{"verse":7,"text":"それなのに、あなたがたの父は、私を欺き、私の報酬を幾度も変えた。しかし神は、彼が私に害を加えるようにされなかった。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["は"],["、"],["私","わたくし"],["を"],["欺き","あざむき"],["、"],["私","わたくし"],["の"],["報酬","ほうしゅう"],["を"],["幾度","いくど"],["も"],["変えた","かえた"],["。"],["しかし"],["神","かみ"],["は"],["、"],["彼","かれ"],["が"],["私","わたくし"],["に"],["害","がい"],["を"],["加える","くわえる"],["よう"],["に"],["されなかった"],["。"]]},{"verse":8,"text":"彼が、『ぶち毛のものはあなたの報酬になる』と言えば、すべての群れがぶち毛のものを産んだ。また、『しま毛のものはあなたの報酬になる』と言えば、すべての群れが、しま毛のものを産んだ。","tok":[["彼","かれ"],["が"],["、"],["『"],["ぶち"],["毛","け"],["の"],["もの"],["は"],["あなた"],["の"],["報酬","ほうしゅう"],["に"],["なる"],["』"],["と"],["言えば","いえば"],["、"],["すべて"],["の"],["群れ","むれ"],["が"],["ぶち"],["毛","け"],["の"],["もの"],["を"],["産んだ","うんだ"],["。"],["また"],["、"],["『"],["しま"],["毛","け"],["の"],["もの"],["は"],["あなた"],["の"],["報酬","ほうしゅう"],["に"],["なる"],["』"],["と"],["言えば","いえば"],["、"],["すべて"],["の"],["群れ","むれ"],["が"],["、"],["しま"],["毛","け"],["の"],["もの"],["を"],["産んだ","うんだ"],["。"]]},{"verse":9,"text":"こうして神が、あなたがたの父の家畜を取り上げて、私に下さったのだ。","tok":[["こう"],["して"],["神","かみ"],["が"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["の"],["家畜","かちく"],["を"],["取り上げて","とりあげて"],["、"],["私","わたくし"],["に"],["下さった","くださった"],["の"],["だ"],["。"]]},{"verse":10,"text":"群れにさかりがついたとき、私が夢の中で目を上げて見ると、群れにかかっている雄やぎは、しま毛のもの、ぶち毛のもの、また、まだら毛のものであった。","tok":[["群れ","むれ"],["に"],["さかり"],["が"],["ついた"],["とき"],["、"],["私","わたくし"],["が"],["夢","ゆめ"],["の"],["中","なか"],["で"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["群れ","むれ"],["に"],["かかって"],["いる"],["雄","おす"],["やぎ"],["は"],["、"],["しま"],["毛","け"],["の"],["もの"],["、"],["ぶち"],["毛","け"],["の"],["もの"],["、"],["また"],["、"],["まだら"],["毛","け"],["の"],["もの"],["で"],["あった"],["。"]]},{"verse":11,"text":"そして神の使いが夢の中で私に言われた。『ヤコブよ。』私は『はい』と答えた。","tok":[["そして"],["神","かみ"],["の"],["使い","つかい"],["が"],["夢","ゆめ"],["の"],["中","なか"],["で"],["私","わたくし"],["に"],["言われた","いわれた"],["。"],["『"],["ヤコブ"],["よ"],["。"],["』"],["私","わたくし"],["は"],["『"],["はい"],["』"],["と"],["答えた","こたえた"],["。"]]},{"verse":12,"text":"すると御使いは言われた。『目を上げて見よ。群れにかかっている雄やぎはみな、しま毛のもの、ぶち毛のもの、まだら毛のものである。ラバンがあなたにしてきたことはみな、わたしが見た。","tok":[["する"],["と"],["御使い","おつかい"],["は"]
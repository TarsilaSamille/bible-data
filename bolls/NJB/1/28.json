[{"verse":1,"text":"イサクはヤコブを呼び寄せ、彼を祝福し、そして彼に命じて言った。「カナンの娘たちの中から妻をめとってはならない。","tok":[["イサク"],["は"],["ヤコブ"],["を"],["呼び寄せ","よびよせ"],["、"],["彼","かれ"],["を"],["祝福","しゅくふく"],["し"],["、"],["そして"],["彼","かれ"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["カナン"],["の"],["娘","むすめ"],["たち"],["の"],["中","なか"],["から"],["妻","つま"],["を"],["めとって"],["は"],["ならない"],["。"]]},{"verse":2,"text":"さあ、立って、パダン・アラムの、おまえの母の父ベトエルの家に行き、そこで母の兄ラバンの娘たちの中から妻をめとりなさい。","tok":[["さあ"],["、"],["立って","たって"],["、"],["パダン"],["・"],["アラム"],["の"],["、"],["おまえ"],["の"],["母","はは"],["の"],["父","ちち"],["ベトエル"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["そこ"],["で"],["母","はは"],["の"],["兄","あに"],["ラバン"],["の"],["娘","むすめ"],["たち"],["の"],["中","なか"],["から"],["妻","つま"],["を"],["めとり"],["なさい"],["。"]]},{"verse":3,"text":"全能の神がおまえを祝福し、多くの子どもを与え、おまえをふえさせてくださるように。そして、おまえが多くの民のつどいとなるように。","tok":[["全能","ぜんのう"],["の"],["神","かみ"],["が"],["おまえ"],["を"],["祝福","しゅくふく"],["し"],["、"],["多く","おおく"],["の"],["子ども","こども"],["を"],["与え","あたえ"],["、"],["おまえ"],["を"],["ふえさせて"],["くださる"],["よう"],["に"],["。"],["そして"],["、"],["おまえ"],["が"],["多く","おおく"],["の"],["民","たみ"],["の"],["つどい"],["と"],["なる"],["よう"],["に"],["。"]]},{"verse":4,"text":"神はアブラハムの祝福を、おまえと、おまえとともにいるおまえの子孫とに授け、神がアブラハムに下さった地、おまえがいま寄留しているこの地を継がせてくださるように。」","tok":[["神","かみ"],["は"],["アブラハム"],["の"],["祝福","しゅくふく"],["を"],["、"],["おまえ"],["と"],["、"],["おまえ"],["と"],["とも"],["に"],["いる"],["おまえ"],["の"],["子孫","しそん"],["と"],["に"],["授け","さずけ"],["、"],["神","かみ"],["が"],["アブラハム"],["に"],["下さった","くださった"],["地","ち"],["、"],["おまえ"],["が"],["いま"],["寄留","きりゅう"],["して"],["いる"],["この"],["地","ち"],["を"],["継がせて","つがせて"],["くださる"],["よう"],["に"],["。"],["」"]]},{"verse":5,"text":"こうしてイサクはヤコブを送り出した。彼はパダン・アラムへ行って、ヤコブとエサウの母リベカの兄、アラム人ベトエルの子ラバンのところに行った。","tok":[["こう"],["して"],["イサク"],["は"],["ヤコブ"],["を"],["送り出した","おくりだした"],["。"],["彼","かれ"],["は"],["パダン"],["・"],["アラム"],["へ"],["行って","いって"],["、"],["ヤコブ"],["と"],["エサウ"],["の"],["母","はは"],["リベカ"],["の"],["兄","あに"],["、"],["アラム人","あらむにん"],["ベトエル"],["の"],["子","こ"],["ラバン"],["の"],["ところ"],["に"],["行った","いった"],["。"]]},{"verse":6,"text":"エサウは、イサクがヤコブを祝福し、彼をパダン・アラムに送り出して、そこから妻をめとるように、彼を祝福して彼に命じ、カナンの娘たちから妻をめとってはならないと言ったこと、","tok":[["エサウ"],["は"],["、"],["イサク"],["が"],["ヤコブ"],["を"],["祝福","しゅくふく"],["し"],["、"],["彼","かれ"],["を"],["パダン"],["・"],["アラム"],["に"],["送り出して","おくりだして"],["、"],["そこ"],["から"],["妻","つま"],["を"],["めとる"],["よう"],["に"],["、"],["彼","かれ"],["を"],["祝福","しゅくふく"],["して"],["彼","かれ"],["に"],["命じ","めいじ"],["、"],["カナン"],["の"],["娘","むすめ"],["たち"],["から"],["妻","つま"],["を"],["めとって"],["は"],["ならない"],["と"],["言った","いった"],["こと"],["、"]]},{"verse":7,"text":"またヤコブが、父と母の言うことに聞き従ってパダン・アラムへ行ったことに気づいた。","tok":[["また"],["ヤコブ"],["が"],["、"],["父","ちち"],["と"],["母","はは"],["の"],["言う","いう"],["こと"],["に"],["聞き従って","ききしたがって"],["パダン"],["・"],["アラム"],["へ"],["行った","いった"],["こと"],["に"],["気づいた","きづいた"],["。"]]},{"verse":8,"text":"エサウはまた、カナンの娘たちが父イサクの気に入らないのに気づいた。","tok":[["エサウ"],["は"],["また"],["、"],["カナン"],["の"],["娘","むすめ"],["たち"],["が"],["父","ちち"],["イサク"],["の"],["気","き"],["に"],["入らない","いらない"],["のに"],["気づいた","きづいた"],["。"]]},{"verse":9,"text":"それでエサウはイシュマエルのところに行き、今ある妻たちのほかに、アブラハムの子イシュマエルの娘で、ネバヨテの妹マハラテを妻としてめとった。","tok":[["それ"],["で"],["エサウ"],["は"],["イシュマエル"],["の"],["ところ"],["に"],["行き","いき"],["、"],["今","いま"],["ある"],["妻たち","つまたち"],["の"],["ほか"],["に"],["、"],["アブラハム"],["の"],["子","こ"],["イシュマエル"],["の"],["娘","むすめ"],["で"],["、"],["ネバヨテ"],["の"],["妹","いもうと"],["マハラテ"],["を"],["妻","つま"],["として"],["めとった"],["。"]]},{"verse":10,"text":"ヤコブはベエル・シェバを立って、ハランへと旅立った。","tok":[["ヤコブ"],["は"],["ベエル"],["・"],["シェバ"],["を"],["立って","たって"],["、"],["ハラン"],["へ"],["と"],["旅立った","たびだった"],["。"]]},{"verse":11,"text":"ある所に着いたとき、ちょうど日が沈んだので、そこで一夜を明かすことにした。彼はその所の石の一つを取り、それを枕にして、その場所で横になった。","tok":[["ある"],["所","ところ"],["に"],["着いた","ついた"],["とき"],["、"],["ちょうど"],["日","ひ"],["が"],["沈んだ","しずんだ"],["ので"],["、"],["そこ"],["で"],["一夜","いちや"],["を"],["明かす","あかす"],["こと"],["に"],["した"],["。"],["彼","かれ"],["は"],["その"],["所","ところ"],["の"],["石","いし"],["の"],["一","ひと"],["つ"],["を"],["取り","とり"],["、"],["それ"],["を"],["枕","まくら"],["に"],["して"],["、"],["その"],["場所","ばしょ"],["で"],["横","よこ"],["に"],["なった"],["。"]]},{"verse":12,"text":"そのうちに、彼は夢を見た。見よ。一つのはしごが地に向けて立てられている。その頂は天に届き、見よ、神の使いたちが、そのはしごを上り下りしている。","tok":[["その"],["うち"],["に"],["、"],["彼","かれ"],["は"],["夢","ゆめ"],["を"],["見た","みた"],["。"],["見","み"],["よ"],["。"],["一","ひと"],["つ"],["の"],["はしご"],["が"],["地","ち"],["に"],["向けて","むけて"],["立てられて","たてられて"],["いる"],["。"],["その"],["頂","いただき"],["は"],["天","てん"],["に"],["届き","とどき"],["、"],["見よ","みよ"],["、"],["神","かみ"],["の"],["使い","つかい"],["たち"],["が"],["、"],["その"],["はしご"],["を"],["上り下り","のぼりおり"],["して"],["いる"],["。"]]},{"verse":13,"text":"そして、見よ。主が彼のかたわらに立っておられた。そして仰せられた。「わたしはあなたの父アブラハムの神、イサクの神、主である。わたしはあなたが横たわっているこの地を、あなたとあなたの子孫とに与える。","tok":[["そして"],["、"],["見","み"],["よ"],["。"],["主","ぬし"],["が"],["彼","かれ"],["の"],["かたわら"],["に"],["立って","たって"],["おられた"],["。"],["そして"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["あなた"],["の"],["父","ちち"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["が"],["横たわって","よこたわって"],["いる"],["この"],["地","ち"],["を"],["、"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["と"],["に"],["与える","あたえる"],["。"]]},{"verse":14,"text":"あなたの子孫は地のちりのように多くなり、あなたは、西、東、北、南へと広がり、地上のすべての民族は、あなたとあなたの子孫によって祝福される。","tok":[["あなた"],["の"],["子孫","しそん"],["は"],["地","ち"],["の"],["ちり"],["の"],["よう"],["に"],["多く","おおく"],["なり"],["、"],["あなた"],["は"],["、"],["西","にし"],["、"],["東","ひがし"],["、"],["北","きた"],["、"],["南","みなみ"],["へ"],["と"],["広がり","ひろがり"],["、"],["地上","ちじょう"],["の"],["すべて"],["の"],["民族","みんぞく"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["によって"],["祝福","しゅくふく"],["される"],["。"]]},{"verse":15,"text":"見よ。わたしはあなたとともにあり、あなたがどこへ行っても、あなたを守り、あなたをこの地に連れ戻そう。わたしは、あなたに約束したことを成し遂げるまで、決してあなたを捨てない。」","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["と"],["とも"],["に"],["あり"],["、"],["あなた"],["が"],["どこ"],["へ"],["行って","いって"],["も"],["、"],["あなた"],["を"],["守り","まもり"],["、"],["あなた"],["を"],["この"],["地","ち"],["に"],["連れ戻そう","つれもどそう"],["。"],["わたし"],["は"],["、"],["あなた"],["に"],["約束","やくそく"],["した"],["こと"],["を"],["成し遂げる","なしとげる"],["まで"],["、"],["決して","けっして"],["あなた"],["を"],["捨てない","すてない"],["。"],["」"]]},{"verse":16,"text":"ヤコブは眠りからさめて、「まことに主がこの所におられるのに、私はそれを知らなかった」と言った。","tok":[["ヤコブ"],["は"],["眠り","ねむり"],["から"],["さめて"],["、"],["「"],["まこと"],["に"],["主","ぬし"],["が"],["この"],["所","ところ"],["に"],["おられる"],["のに"],["、"],["私","わたくし"],["は"],["それ"],["を"],["知らなかった","しらなかった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"彼は恐れおののいて、また言った。「この場所は、なんとおそれおおいことだろう。こここそ神の家にほかならない。ここは天の門だ。」","tok":[["彼","かれ"],["は"],["恐れおののいて","おそれおののいて"],["、"],["また"],["言った","いった"],["。"],["「"],["この"],["場所","ばしょ"],["は"],["、"],["なん"],["と"],["おそれおおい"],["こと"],["だろう"],["。"],["ここ"],["こそ"],["神","かみ"],["の"],["家","いえ"],["に"],["ほか"],["ならない"],["。"],["ここ"],["は"],["天","てん"],["の"],["門","もん"],["だ"],["。"],["」"]]},{"verse":18,"text":"翌朝早く、ヤコブは自分が枕にした石を取り、それを石の柱として立て、その上に油をそそいだ。","tok":[["翌朝","よくあさ"],["早く","はやく"],["、"],["ヤコブ"],["は"],["自分","じぶん"],["が"],["枕","まくら"],["に"],["した"],["石","いし"],["を"],["取り","とり"],["、"],["それ"],["を"],["石","いし"],["の"],["柱","はしら"],["として"],["立て","たて"],["、"],["その"],["上","うえ"],["に"],["油","あぶら"],["を"],["そそいだ"],["。"]]},{"verse":19,"text":"そして、その場所の名をベテルと呼んだ。しかし、その町の名は、以前はルズであった。","tok":[["そして"],["、"],["その"],["場所","ばしょ"],["の"],["名","な"],["を"],["ベテル"],["と"],["呼んだ","よんだ"],["。"],["しかし"],["、"],["その"],["町","まち"],["の"],["名","な"],["は"],["、"],["以前","いぜん"],["は"],["ルズ"],["で"],["あった"],["。"]]},{"verse":20,"text":"それからヤコブは誓願を立てて言った。「神が私とともにおられ、私が行くこの旅路を守り、食べるパンと着る着物を賜り、","tok":[["それ"],["から"],["ヤコブ"],["は"],["誓願","せいがん"],["を"],["立てて","たてて"],["言った","いった"],["。"],["「"],["神","かみ"],["が"],["私","わたくし"],["と"],["とも"],["に"],["おられ"],["、"],["私","わたくし"],["が"],["行く","いく"],["この"],["旅路","たびじ"],["を"],["守り","まもり"],["、"],["食べる","たべる"],["パン"],["と"],["着る","きる"],["着物","きもの"],["を"],["賜り","たまわり"],["、"]]},{"verse":21,"text":"無事に父の家に帰らせてくださり、こうして主が私の神となられるなら、","tok":[["無事","ぶじ"],["に"],["父","ちち"],["の"],["家","いえ"],["に"],["帰らせて","かえらせて"],["くださり"],["、"],["こう"],["して"],["主","ぬし"],["が"],["私","わたくし"],["の"],["神","かみ"],["と"],["なられるなら"],["、"]]},{"verse":22,"text":"石の柱として立てたこの石は神の家となり、すべてあなたが私に賜る物の十分の一を必ずささげます。」","tok":[["石","いし"],["の"],["柱","はしら"],["として"],["立てた","たてた"],["この"],["石","いし"],["は"],["神","かみ"],["の"],["家","いえ"],["と"],["なり"],["、"],["すべて"],["あなた"],["が"],["私","わたくし"],["に"],["賜る","たまわる"],["物","もの"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["必ず","かならず"],["ささげます"],["。"],["」"]]}]
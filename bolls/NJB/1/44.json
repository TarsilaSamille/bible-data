[{"verse":1,"text":"さて、ヨセフは家の管理者に命じて言った。「あの人々の袋を彼らに運べるだけの食糧で満たし、おのおのの銀を彼らの袋の口に入れておけ。","tok":[["さて"],["、"],["ヨセフ"],["は"],["家","いえ"],["の"],["管理者","かんりしゃ"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["あの"],["人々","ひとびと"],["の"],["袋","ふくろ"],["を"],["彼","かれ"],["ら"],["に"],["運べる","はこべる"],["だけ"],["の"],["食糧","しょくりょう"],["で"],["満たし","みたし"],["、"],["おのおの"],["の"],["銀","ぎん"],["を"],["彼","かれ"],["ら"],["の"],["袋","ふくろ"],["の"],["口","くち"],["に"],["入れて","いれて"],["おけ"],["。"]]},{"verse":2,"text":"また、私の杯、あの銀の杯を一番年下の者の袋の口に、穀物の代金といっしょに入れておけ。」彼はヨセフの言いつけどおりにした。","tok":[["また"],["、"],["私","わたくし"],["の"],["杯","さかずき"],["、"],["あの"],["銀","ぎん"],["の"],["杯","さかずき"],["を"],["一番","いちばん"],["年下","としした"],["の"],["者","もの"],["の"],["袋","ふくろ"],["の"],["口","くち"],["に"],["、"],["穀物","こくもつ"],["の"],["代金","だいきん"],["と"],["いっしょ"],["に"],["入れて","いれて"],["おけ"],["。"],["」"],["彼","かれ"],["は"],["ヨセフ"],["の"],["言いつけ","いいつけ"],["どおり"],["に"],["した"],["。"]]},{"verse":3,"text":"明け方、人々はろばといっしょに送り出された。","tok":[["明け方","あけがた"],["、"],["人々","ひとびと"],["は"],["ろば"],["と"],["いっしょ"],["に"],["送り出された","おくりだされた"],["。"]]},{"verse":4,"text":"彼らが町を出てまだ遠くへ行かないうちに、ヨセフは家の管理者に言った。「さあ、あの人々のあとを追え。追いついたら彼らに、『なぜ、あなたがたは悪をもって善に報いるのか。","tok":[["彼","かれ"],["ら"],["が"],["町","まち"],["を"],["出て","でて"],["まだ"],["遠く","とおく"],["へ"],["行かない","いかない"],["うち"],["に"],["、"],["ヨセフ"],["は"],["家","いえ"],["の"],["管理者","かんりしゃ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["あの"],["人々","ひとびと"],["の"],["あと"],["を"],["追え","おえ"],["。"],["追いついたら","おいついたら"],["彼","かれ"],["ら"],["に"],["、"],["『"],["なぜ"],["、"],["あなた"],["がた"],["は"],["悪","あく"],["を"],["もって"],["善","ぜん"],["に"],["報いる","むくいる"],["の"],["か"],["。"]]},{"verse":5,"text":"これは、私の主人が、これで飲み、また、これでいつもまじないをしておられるのではないか。あなたがたのしたことは悪らつだ』と言うのだ。」","tok":[["これ"],["は"],["、"],["私","わたくし"],["の"],["主人","しゅじん"],["が"],["、"],["これ"],["で"],["飲み","のみ"],["、"],["また"],["、"],["これ"],["で"],["いつも"],["まじない"],["を"],["して"],["おられる"],["ので"],["は"],["ない"],["か"],["。"],["あなた"],["がた"],["の"],["した"],["こと"],["は"],["悪らつ","あくらつ"],["だ"],["』"],["と"],["言う","いう"],["の"],["だ"],["。"],["」"]]},{"verse":6,"text":"彼は彼らに追いついて、このことばを彼らに告げた。","tok":[["彼","かれ"],["は"],["彼","かれ"],["ら"],["に"],["追いついて","おいついて"],["、"],["この"],["ことば"],["を"],["彼","かれ"],["ら"],["に"],["告げた","つげた"],["。"]]},{"verse":7,"text":"すると、彼らは言った。「あなたさまは、なぜそのようなことをおっしゃるのですか。しもべどもがそんなことをするなどとは、とんでもないことです。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["あなた"],["さま"],["は"],["、"],["なぜ"],["その"],["よう"],["な"],["こと"],["を"],["おっしゃる"],["の"],["です"],["か"],["。"],["しもべ"],["ども"],["が"],["そんな"],["こと"],["を"],["する"],["など"],["と"],["は"],["、"],["とんでも"],["ない"],["こと"],["です"],["。"]]},{"verse":8,"text":"私たちが、袋の口から見つけた銀でさえ、カナンの地からあなたのもとへ返しに来たではありませんか。どうしてあなたのご主人の家から銀や金を盗んだりいたしましょう。","tok":[["私たち","わたしたち"],["が"],["、"],["袋","ふくろ"],["の"],["口","くち"],["から"],["見つけた","みつけた"],["銀","ぎん"],["で"],["さえ"],["、"],["カナン"],["の"],["地","ち"],["から"],["あなた"],["の"],["もと"],["へ"],["返し","かえし"],["に"],["来たで","きたで"],["は"],["ありません"],["か"],["。"],["どう"],["して"],["あなた"],["の"],["ご主人","ごしゅじん"],["の"],["家","いえ"],["から"],["銀","ぎん"],["や"],["金","きん"],["を"],["盗ん","ぬすん"],["だり"],["いたしましょう"],["。"]]},{"verse":9,"text":"しもべどものうちのだれからでも、それが見つかった者は殺してください。そして私たちもまた、ご主人の奴隷となりましょう。」","tok":[["しもべ"],["ども"],["の"],["うち"],["の"],["だれ"],["から"],["で"],["も"],["、"],["それ"],["が"],["見つかった","みつかった"],["者","もの"],["は"],["殺して","ころして"],["ください"],["。"],["そして"],["私たち","わたしたち"],["も"],["また"],["、"],["ご主人","ごしゅじん"],["の"],["奴隷","どれい"],["と"],["なりましょう"],["。"],["」"]]},{"verse":10,"text":"彼は言った。「今度も、あなたがたの言うことはもっともだが、それが見つかった者は、私の奴隷となり、他の者は無罪としよう。」","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["今度","こんど"],["も"],["、"],["あなた"],["がた"],["の"],["言う","いう"],["こと"],["は"],["もっとも"],["だ"],["が"],["、"],["それ"],["が"],["見つかった","みつかった"],["者","もの"],["は"],["、"],["私","わたくし"],["の"],["奴隷","どれい"],["と"],["なり"],["、"],["他","た"],["の"],["者","もの"],["は"],["無罪","むざい"],["と"],["しよう"],["。"],["」"]]},{"verse":11,"text":"そこで、彼らは急いで自分の袋を地に降ろし、おのおのその袋を開いた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["急いで","いそいで"],["自分","じぶん"],["の"],["袋","ふくろ"],["を"],["地","ち"],["に"],["降ろし","おろし"],["、"],["おのおの"],["その"],["袋","ふくろ"],["を"],["開いた","ひらいた"],["。"]]},{"verse":12,"text":"彼は年長の者から調べ始めて年下の者で終わった。ところがその杯はベニヤミンの袋から見つかった。","tok":[["彼","かれ"],["は"],["年長","ねんちょう"],["の"],["者","もの"],["から"],["調べ","しらべ"],["始めて","はじめて"],["年下","としした"],["の"],["者","もの"],["で"],["終わった","おわった"],["。"],["ところ"],["が"],["その"],["杯","さかずき"],["は"],["ベニヤミン"],["の"],["袋","ふくろ"],["から"],["見つかった","みつかった"],["。"]]},{"verse":13,"text":"そこで彼らは着物を引き裂き、おのおのろばに荷を負わせて町に引き返した。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["着物","きもの"],["を"],["引き裂き","ひきさき"],["、"],["おのおの"],["ろば"],["に"],["荷","に"],["を"],["負わせて","おわせて"],["町","まち"],["に"],["引き返した","ひきかえした"],["。"]]},{"verse":14,"text":"ユダと兄弟たちがヨセフの家に入って行ったとき、ヨセフはまだそこにいた。彼らはヨセフの前で顔を地に伏せた。","tok":[["ユダ"],["と"],["兄弟","きょうだい"],["たち"],["が"],["ヨセフ"],["の"],["家","いえ"],["に"],["入って","はいって"],["行った","いった"],["とき"],["、"],["ヨセフ"],["は"],["まだ"],["そこ"],["に"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["ヨセフ"],["の"],["前","まえ"],["で"],["顔","かお"],["を"],["地","ち"],["に"],["伏せた","ふせた"],["。"]]},{"verse":15,"text":"ヨセフは彼らに言った。「あなたがたのしたこのしわざは、何だ。私のような者はまじないをするということを知らなかったのか。」","tok":[["ヨセフ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["した"],["この"],["しわざ"],["は"],["、"],["何","なん"],["だ"],["。"],["私","わたくし"],["の"],["よう"],["な"],["者","もの"],["は"],["まじない"],["を"],["する"],["と"],["いう"],["こと"],["を"],["知らなかった","しらなかった"],["の"],["か"],["。"],["」"]]},{"verse":16,"text":"ユダが答えた。「私たちはあなたさまに何を申せましょう。何の申し開きができましょう。また何と言って弁解することができましょう。神がしもべどもの咎をあばかれたのです。今このとおり、私たちも、そして杯を持っているのを見つかった者も、あなたさまの奴隷となりましょう。」","tok":[["ユダ"],["が"],["答えた","こたえた"],["。"],["「"],["私たち","わたしたち"],["は"],["あなた"],["さま"],["に"],["何","なん"],["を"],["申せましょう","もうせましょう"],["。"],["何","なん"],["の"],["申し開き","もうしひらき"],["が"],["できましょう"],["。"],["また"],["何","なん"],["と"],["言って","いって"],["弁解","べんかい"],["する"],["こと"],["が"],["できましょう"],["。"],["神","かみ"],["が"],["しもべ"],["ども"],["の"],["咎","とが"],["を"],["あばかれた"],["の"],["です"],["。"],["今","いま"],["この"],["とおり"],["、"],["私たち","わたしたち"],["も"],["、"],["そして"],["杯","さかずき"],["を"],["持って","もって"],["いる"],["の"],["を"],["見つかった","みつかった"],["者","もの"],["も"],["、"],["あなた"],["さま"],["の"],["奴隷","どれい"],["と"],["なりましょう"],["。"],["」"]]},{"verse":17,"text":"しかし、ヨセフは言った。「そんなことはとんでもないことだ。杯を持っているのを見つかった者だけが、私の奴隷となればよい。ほかのあなたがたは安心して父のもとへ帰るがよい。」","tok":[["しかし"],["、"],["ヨセフ"],["は"],["言った","いった"],["。"],["「"],["そんな"],["こと"],["は"],["とんでも"],["ない"],["こと"],["だ"],["。"],["杯","さかずき"],["を"],["持って","もって"],["いる"],["の"],["を"],["見つかった","みつかった"],["者","もの"],["だけ"],["が"],["、"],["私","わたくし"],["の"],["奴隷","どれい"],["と"],["なれば"],["よい"],["。"],["ほか"],["の"],["あなた"],["がた"],["は"],["安心","あんしん"],["して"],["父","ちち"],["の"],["もと"],["へ"],["帰る","かえる"],["が"],["よい"],["。"],["」"]]},{"verse":18,"text":"すると、ユダが彼に近づいて言った。「あなたさま。どうかあなたのしもべの申し上げることに耳を貸してください。そして、どうかしもべを激しくお怒りにならないでください。あなたはパロのようなお方なのですから。","tok":[["する"],["と"],["、"],["ユダ"],["が"],["彼","かれ"],["に"],["近づいて","ちかづいて"],["言った","いった"],["。"],["「"],["あなた"],["さま"],["。"],["どう"],["か"],["あなた"],["の"],["しもべ"],["の"],["申し上げる","もうしあげる"],["こと"],["に"],["耳","みみ"],["を"],["貸して","かして"],["ください"],["。"],["そして"],["、"],["どう"],["か"],["しもべ"],["を"],["激しく","はげしく"],["お怒り","おいかり"],["に"],["ならないで"],["ください"],["。"],["あなた"],["は"],["パロ"],["の"],["よう"],["な"],["お方","おかた"],["な"],["の"],["です"],["から"],["。"]]},{"verse":19,"text":"あなたさまは、しもべどもに、あなたがたに父や弟があるかとお尋ねになりました。","tok":[["あなた"],["さま"],["は"],["、"],["しもべ"],["ども"],["に"],["、"],["あなた"],["がた"],["に"],["父","ちち"],["や"],["弟","おとうと"],["が"],["ある"],["か"],["と"],["お尋ね","おたずね"],["に"],["なりました"],["。"]]},{"verse":20,"text":"それで、私たちはあなたさまに、『私たちには年老いた父と、年寄り子の末の弟がおります。そしてその兄は死にました。彼だけがその母に残されましたので、父は彼を愛しています』と申し上げました。","tok":[["それ"],["で"],["、"],["私たち","わたしたち"],["は"],["あなた"],["さま"],["に"],["、"],["『"],["私たち","わたしたち"],["に"],["は"],["年老いた","としおいた"],["父","ちち"],["と"],["、"],["年寄り","としより"],["子","こ"],["の"],["末","すえ"],["の"],["弟","おとうと"],["が"],["おります"],["。"],["そして"],["その"],["兄","あに"],["は"],["死にました","しにました"],["。"],["彼","かれ"],["だけ"],["が"],["その"],["母","はは"],["に"],["残されました","のこされました"],["ので"],["、"],["父","ちち"],["は"],["彼","かれ"],["を"],["愛して","あいして"],["います"],["』"],["と"],["申し上げました","もうしあげました"],["。"]]},{"verse":21,"text":"するとあなたは、しもべどもに、『彼を私のところに連れて来い。私はこの目で彼を見たい』と言われました。","tok":[["する"],["と"],["あなた"],["は"],["、"],["しもべ"],["ども"],["に"],["、"],["『"],["彼","かれ"],["を"],["私","わたくし"],["の"],["ところ"],["に"],["連れて","つれて"],["来い","こい"],["。"],["私","わたくし"],["は"],["この"],["目","め"],["で"],["彼","かれ"],["を"],["見たい","みたい"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":22,"text":"それで、私たちはあなたさまに、『その子は父親と離れることはできません。父親と離れたら、父親は死ぬでしょう』と申し上げました。","tok":[["それ"],["で"],["、"],["私たち","わたしたち"],["は"],["あなた"],["さま"],["に"],["、"],["『"],["その"],["子","こ"],["は"],["父親","ちちおや"],["と"],["離れる","はなれる"],["こと"],["は"],["できません"],["。"],["父親","ちちおや"],["と"],["離れたら","はなれたら"],["、"],["父親","ちちおや"],["は"],["死ぬでしょう","しぬでしょう"],["』"],["と"],["申し上げました","もうしあげました"],["。"]]},{"verse":23,"text":"しかし、あなたはしもべどもに言われました。『末の弟といっしょに下って来なければ、二度とあなたがたは私の顔を見ることはできない。』","tok":[["しかし"],["、"],["あなた"],["は"],["しもべ"],["ども"],["に"],["言われました","いわれました"],["。"],["『"],["末","まつ"],["の"],["弟","おとうと"],["と"],["いっしょ"],["に"],["下って","くだって"],["来なければ","こなければ"],["、"],["二","に"],["度","ど"],["と"],["あなた"],["がた"],["は"],["私","わたくし"],["の"],["顔","かお"],["を"],["見る","みる"],["こと"],["は"],["できない"],["。"],["』"]]},{"verse":24,"text":"それで、私たちは、あなたのしもべである私の父のもとに帰ったとき、父にあなたさまのおことばを伝えました。","tok":[["それ"],["で"],["、"],["私たち","わたしたち"],["は"],["、"],["あなた"],["の"],["しもべ"],["で"],["ある"],["私","わたくし"],["の"],["父","ちち"],["の"],["もと"],["に"],["帰った","かえった"],["とき"],["、"],["父","ちち"],["に"],["あなた"],["さま"],["の"],["おことば"],["を"],["伝えました","つたえました"],["。"]]},{"verse":25,"text":"それから私たちの父が、『また行って、われわれのために少し食糧を買って来てくれ』と言ったので、","tok":[["それ"],["から"],["私たち","わたしたち"],["の"],["父","ちち"],["が"],["、"],["『"],["また"],["行って","いって"],["、"],["われわれ"],["の"],["ため"],["に"],["少し","すこし"],["食糧","しょくりょう"],["を"],["買って","かって"],["来て","きて"],["くれ"],["』"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":26,"text":"私たちは、『私たちは下って行くことはできません。もし、末の弟が私たちといっしょなら、私たちは下って行きます。というのは、末の弟といっしょでなければあの方のお顔を見ることはできないのです』と答えました。","tok":[["私たち","わたしたち"],["は"],["、"],["『"],["私たち","わたしたち"],["は"],["下って","くだって"],["行く","いく"],["こと"],["は"],["できません"],["。"],["もし"],["、"],["末","すえ"],["の"],["弟","おとうと"],["が"],["私たち","わたしたち"],["と"],["いっしょ"],["なら"],["、"],["私たち","わたしたち"],["は"],["下って","くだって"],["行きます","いきます"],["。"],["と"],["いう"],["の"],["は"],["、"],["末","すえ"],["の"],["弟","おとうと"],["と"],["いっしょ"],["で"],["なければ"],["あの"],["方","かた"],["の"],["お顔","おかお"],["を"],["見る","みる"],["こと"],["は"],["できない"],["の"],["です"],["』"],["と"],["答えました","こたえました"],["。"]]},{"verse":27,"text":"すると、あなたのしもべである私の父が言いました。『あなたがたも知っているように、私の妻はふたりの子を産んだ。","tok":[["する"],["と"],["、"],["あなた"],["の"],["しもべ"],["で"],["ある"],["私","わたくし"],["の"],["父","ちち"],["が"],["言いました","いいました"],["。"],["『"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["よう"],["に"],["、"],["私","わたくし"],["の"],["妻","つま"],["は"],["ふたり"],["の"],["子","こ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":28,"text":"そしてひとりは私のところから出て行ったきりだ。確かに裂き殺されてしまったのだ、と私は言った。そして、それ以来、今まで私は彼を見ない。","tok":[["そして"],["ひとり"],["は"],["私","わたくし"],["の"],["ところ"],["から"],["出て","でて"],["行った","いった"],["きり"],["だ"],["。"],["確か","たしか"],["に"],["裂き","さき"],["殺されて","ころされて"],["しまった"],["の"],["だ"],["、"],["と"],["私","わたくし"],["は"],["言った","いった"],["。"],["そして"],["、"],["それ"],["以来","いらい"],["、"],["今まで","いままで"],["私","わたくし"],["は"],["彼","かれ"],["を"],["見ない","みない"],["。"]]},{"verse":29,"text":"あなたがたがこの子をも私から取ってしまって、この子にわざわいが起こるなら、あなたがたは、しらが頭の私を、苦しみながらよみに下らせることになるのだ。』","tok":[["あなた"],["がた"],["が"],["この"],["子","こ"],["を"],["も"],["私","わたくし"],["から"],["取って","とって"],["しまって"],["、"],["この"],["子","こ"],["に"],["わざわい"],["が"],["起こるなら","おこるなら"],["、"],["あなた"],["がた"],["は"],["、"],["しらが頭","しらがあたま"],["の"],["私","わたくし"],["を"],["、"],["苦しみ","くるしみ"],["ながら"],["よみ"],["に"],["下らせる","くだらせる"],["こと"],["に"],["なる"],["の"],["だ"],["。"],["』"]]},{"verse":30,"text":"私が今、あなたのしもべである私の父のもとへ帰ったとき、あの子が私たちといっしょにいなかったら、父のいのちは彼のいのちにかかっているのですから、","tok":[["私","わたくし"],["が"],["今","いま"],["、"],["あなた"],["の"],["しもべ"],["で"],["ある"],["私","わたくし"],["の"],["父","ちち"],["の"],["もと"],["へ"],["帰った","かえった"],["とき"],["、"],["あの"],["子","こ"],["が"],["私たち","わたしたち"],["と"],["いっしょ"],["に"],["いなかったら"],["、"],["父","ちち"],["の"],["いのち"],["は"],["彼","かれ"],["の"],["いのち"],["に"],["かかって"],["いる"],["の"],["です"],["から"],["、"]]},{"verse":31,"text":"あの子がいないのを見たら、父は死んでしまうでしょう。そして、しもべどもが、あなたのしもべであるしらが頭の私たちの父を、悲しみな
[{"verse":1,"text":"そのふたりの御使いは夕暮れにソドムに着いた。ロトはソドムの門のところにすわっていた。ロトは彼らを見るなり、立ち上がって彼らを迎え、顔を地につけて伏し拝んだ。","tok":[["その"],["ふたり"],["の"],["御使い","おつかい"],["は"],["夕暮れ","ゆうぐれ"],["に"],["ソドム"],["に"],["着いた","ついた"],["。"],["ロト"],["は"],["ソドム"],["の"],["門","もん"],["の"],["ところ"],["に"],["すわって"],["いた"],["。"],["ロト"],["は"],["彼","かれ"],["ら"],["を"],["見る","みる"],["なり"],["、"],["立ち上がって","たちあがって"],["彼","かれ"],["ら"],["を"],["迎え","むかえ"],["、"],["顔","かお"],["を"],["地","ち"],["に"],["つけて"],["伏し拝んだ","ふしおがんだ"],["。"]]},{"verse":2,"text":"そして言った。「さあ、ご主人。どうか、あなたがたのしもべの家に立ち寄り、足を洗って、お泊まりください。そして、朝早く旅を続けてください。」すると彼らは言った。「いや、わたしたちは広場に泊まろう。」","tok":[["そして"],["言った","いった"],["。"],["「"],["さあ"],["、"],["ご主人","ごしゅじん"],["。"],["どう"],["か"],["、"],["あなた"],["がた"],["の"],["しもべ"],["の"],["家","いえ"],["に"],["立ち寄り","たちより"],["、"],["足","あし"],["を"],["洗って","あらって"],["、"],["お泊まり","おとまり"],["ください"],["。"],["そして"],["、"],["朝","あさ"],["早く","はやく"],["旅","たび"],["を"],["続けて","つづけて"],["ください"],["。"],["」"],["する"],["と"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["いや"],["、"],["わたしたち"],["は"],["広場","ひろば"],["に"],["泊まろう","とまろう"],["。"],["」"]]},{"verse":3,"text":"しかし、彼がしきりに勧めたので、彼らは彼のところに向かい、彼の家の中に入った。ロトは彼らのためにごちそうを作り、パン種を入れないパンを焼いた。こうして彼らは食事をした。","tok":[["しかし"],["、"],["彼","かれ"],["が"],["しきり"],["に"],["勧めた","すすめた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["の"],["ところ"],["に"],["向かい","むかい"],["、"],["彼","かれ"],["の"],["家","いえ"],["の"],["中","なか"],["に"],["入った","はいった"],["。"],["ロト"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["ごちそう"],["を"],["作り","つくり"],["、"],["パン種","ぱんだね"],["を"],["入れない","いれない"],["パン"],["を"],["焼いた","やいた"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":4,"text":"彼らが床につかないうちに、町の者たち、ソドムの人々が、若い者から年寄りまで、すべての人が、町の隅々から来て、その家を取り囲んだ。","tok":[["彼","かれ"],["ら"],["が"],["床","ゆか"],["に"],["つかない"],["うち"],["に"],["、"],["町","まち"],["の"],["者","もの"],["たち"],["、"],["ソドム"],["の"],["人々","ひとびと"],["が"],["、"],["若い","わかい"],["者","もの"],["から"],["年寄り","としより"],["まで"],["、"],["すべて"],["の"],["人","ひと"],["が"],["、"],["町","まち"],["の"],["隅々","すみずみ"],["から"],["来て","きて"],["、"],["その"],["家","いえ"],["を"],["取り囲んだ","とりかこんだ"],["。"]]},{"verse":5,"text":"そしてロトに向かって叫んで言った。「今夜おまえのところにやって来た男たちはどこにいるのか。ここに連れ出せ。彼らをよく知りたいのだ。」","tok":[["そして"],["ロト"],["に"],["向かって","むかって"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["今夜","こんや"],["おまえ"],["の"],["ところ"],["に"],["やって"],["来た","きた"],["男","おとこ"],["たち"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["ここ"],["に"],["連れ出せ","つれだせ"],["。"],["彼","かれ"],["ら"],["を"],["よく"],["知りたい","しりたい"],["の"],["だ"],["。"],["」"]]},{"verse":6,"text":"ロトは戸口にいる彼らのところに出て、うしろの戸をしめた。","tok":[["ロト"],["は"],["戸口","とぐち"],["に"],["いる"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["出て","でて"],["、"],["うしろ"],["の"],["戸","と"],["を"],["しめた"],["。"]]},{"verse":7,"text":"そして言った。「兄弟たちよ。どうか悪いことはしないでください。","tok":[["そして"],["言った","いった"],["。"],["「"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["どう"],["か"],["悪い","わるい"],["こと"],["は"],["しないで"],["ください"],["。"]]},{"verse":8,"text":"お願いですから。私にはまだ男を知らないふたりの娘があります。娘たちをみなの前に連れて来ますから、あなたがたの好きなようにしてください。ただ、あの人たちには何もしないでください。あの人たちは私の屋根の下に身を寄せたのですから。」","tok":[["お願い","おねがい"],["です"],["から"],["。"],["私","わたくし"],["に"],["は"],["まだ"],["男","おとこ"],["を"],["知らない","しらない"],["ふたり"],["の"],["娘","むすめ"],["が"],["あります"],["。"],["娘","むすめ"],["たち"],["を"],["みな"],["の"],["前","まえ"],["に"],["連れて","つれて"],["来ます","きます"],["から"],["、"],["あなた"],["がた"],["の"],["好き","すき"],["な"],["よう"],["に"],["して"],["ください"],["。"],["ただ"],["、"],["あの"],["人","ひと"],["たち"],["に"],["は"],["何","なん"],["も"],["しないで"],["ください"],["。"],["あの"],["人","ひと"],["たち"],["は"],["私","わたくし"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["身","み"],["を"],["寄せた","よせた"],["の"],["です"],["から"],["。"],["」"]]},{"verse":9,"text":"しかし彼らは言った。「引っ込んでいろ。」そしてまた言った。「こいつはよそ者として来たくせに、さばきつかさのようにふるまっている。さあ、おまえを、あいつらよりもひどいめに会わせてやろう。」彼らはロトのからだを激しく押しつけ、戸を破ろうと近づいて来た。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["引っ込んで","ひっこんで"],["いろ"],["。"],["」"],["そして"],["また"],["言った","いった"],["。"],["「"],["こいつ"],["は"],["よそ者","よそもの"],["として"],["来た","きた"],["くせ"],["に"],["、"],["さばき"],["つかさ"],["の"],["よう"],["に"],["ふるまって"],["いる"],["。"],["さあ"],["、"],["おまえ"],["を"],["、"],["あいつ"],["ら"],["より"],["も"],["ひどい"],["め"],["に"],["会わせて","あわせて"],["やろう"],["。"],["」"],["彼","かれ"],["ら"],["は"],["ロト"],["の"],["からだ"],["を"],["激しく","はげしく"],["押しつけ","おしつけ"],["、"],["戸","と"],["を"],["破ろう","やぶろう"],["と"],["近づいて","ちかづいて"],["来た","きた"],["。"]]},{"verse":10,"text":"すると、あの人たちが手を差し伸べて、ロトを自分たちのいる家の中に連れ込んで、戸をしめた。","tok":[["する"],["と"],["、"],["あの"],["人","ひと"],["たち"],["が"],["手","て"],["を"],["差し伸べて","さしのべて"],["、"],["ロト"],["を"],["自分","じぶん"],["たち"],["の"],["いる"],["家","いえ"],["の"],["中","なか"],["に"],["連れ込んで","つれこんで"],["、"],["戸","と"],["を"],["しめた"],["。"]]},{"verse":11,"text":"家の戸口にいた者たちは、小さい者も大きい者もみな、目つぶしをくらったので、彼らは戸口を見つけるのに疲れ果てた。","tok":[["家","いえ"],["の"],["戸口","とぐち"],["に"],["いた"],["者","もの"],["たち"],["は"],["、"],["小さい","ちいさい"],["者","もの"],["も"],["大きい","おおきい"],["者","もの"],["も"],["みな"],["、"],["目つぶし","めつぶし"],["を"],["くらった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["戸口","とぐち"],["を"],["見つける","みつける"],["のに"],["疲れ","つかれ"],["果てた","はてた"],["。"]]},{"verse":12,"text":"ふたりはロトに言った。「ほかにあなたの身内の者がここにいますか。あなたの婿やあなたの息子、娘、あるいはこの町にいるあなたの身内の者をみな、この場所から連れ出しなさい。","tok":[["ふたり"],["は"],["ロト"],["に"],["言った","いった"],["。"],["「"],["ほか"],["に"],["あなた"],["の"],["身内","みうち"],["の"],["者","もの"],["が"],["ここ"],["に"],["います"],["か"],["。"],["あなた"],["の"],["婿","むこ"],["や"],["あなた"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["あるいは"],["この"],["町","まち"],["に"],["いる"],["あなた"],["の"],["身内","みうち"],["の"],["者","もの"],["を"],["みな"],["、"],["この"],["場所","ばしょ"],["から"],["連れ出し","つれだし"],["なさい"],["。"]]},{"verse":13,"text":"わたしたちはこの場所を滅ぼそうとしているからです。彼らに対する叫びが主の前で大きくなったので、主はこの町を滅ぼすために、わたしたちを遣わされたのです。」","tok":[["わたしたち"],["は"],["この"],["場所","ばしょ"],["を"],["滅ぼそう","ほろぼそう"],["として"],["いる"],["から"],["です"],["。"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["叫び","さけび"],["が"],["主","ぬし"],["の"],["前","まえ"],["で"],["大きく","おおきく"],["なった"],["ので"],["、"],["主","ぬし"],["は"],["この"],["町","まち"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["、"],["わたしたち"],["を"],["遣わされた","つかわされた"],["の"],["です"],["。"],["」"]]},{"verse":14,"text":"そこでロトは出て行き、娘たちをめとった婿たちに告げて言った。「立ってこの場所から出て行きなさい。主がこの町を滅ぼそうとしておられるから。」しかし、彼の婿たちには、それは冗談のように思われた。","tok":[["そこ"],["で"],["ロト"],["は"],["出て","でて"],["行き","いき"],["、"],["娘","むすめ"],["たち"],["を"],["めとった"],["婿","むこ"],["たち"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["立って","たって"],["この"],["場所","ばしょ"],["から"],["出て","でて"],["行き","いき"],["なさい"],["。"],["主","ぬし"],["が"],["この"],["町","まち"],["を"],["滅ぼそう","ほろぼそう"],["として"],["おられる"],["から"],["。"],["」"],["しかし"],["、"],["彼","かれ"],["の"],["婿","むこ"],["たち"],["に"],["は"],["、"],["それ"],["は"],["冗談","じょうだん"],["の"],["よう"],["に"],["思われた","おもわれた"],["。"]]},{"verse":15,"text":"夜が明けるころ、御使いたちはロトを促して言った。「さあ立って、あなたの妻と、ここにいるふたりの娘たちを連れて行きなさい。さもないと、あなたはこの町の咎のために滅ぼし尽くされてしまおう。」","tok":[["夜","よる"],["が"],["明ける","あける"],["ころ"],["、"],["御使い","おつかい"],["たち"],["は"],["ロト"],["を"],["促して","うながして"],["言った","いった"],["。"],["「"],["さあ"],["立って","たって"],["、"],["あなた"],["の"],["妻","つま"],["と"],["、"],["ここ"],["に"],["いる"],["ふたり"],["の"],["娘","むすめ"],["たち"],["を"],["連れて","つれて"],["行き","いき"],["なさい"],["。"],["さも"],["ない"],["と"],["、"],["あなた"],["は"],["この"],["町","まち"],["の"],["咎","とが"],["の"],["ため"],["に"],["滅ぼし","ほろぼし"],["尽くされて","つくされて"],["しまおう"],["。"],["」"]]},{"verse":16,"text":"しかし彼はためらっていた。すると、その人たちは彼の手と彼の妻の手と、ふたりの娘の手をつかんだ。――主の彼に対するあわれみによる。そして彼らを連れ出し、町の外に置いた。","tok":[["しかし"],["彼","かれ"],["は"],["ためらって"],["いた"],["。"],["する"],["と"],["、"],["その"],["人","ひと"],["たち"],["は"],["彼","かれ"],["の"],["手","て"],["と"],["彼","かれ"],["の"],["妻","つま"],["の"],["手","て"],["と"],["、"],["ふたり"],["の"],["娘","むすめ"],["の"],["手","て"],["を"],["つかんだ"],["。"],["―"],["―"],["主","ぬし"],["の"],["彼","かれ"],["に"],["対する","たいする"],["あわれみ"],["に"],["よる"],["。"],["そして"],["彼","かれ"],["ら"],["を"],["連れ出し","つれだし"],["、"],["町","まち"],["の"],["外","そと"],["に"],["置いた","おいた"],["。"]]},{"verse":17,"text":"彼らを外のほうに連れ出したとき、そのひとりは言った。「いのちがけで逃げなさい。うしろを振り返ってはいけない。この低地のどこででも立ち止まってはならない。山に逃げなさい。さもないと滅ぼされてしまう。」","tok":[["彼","かれ"],["ら"],["を"],["外","そと"],["の"],["ほう"],["に"],["連れ出した","つれだした"],["とき"],["、"],["その"],["ひとり"],["は"],["言った","いった"],["。"],["「"],["いのちがけ"],["で"],["逃げ","にげ"],["なさい"],["。"],["うしろ"],["を"],["振り返って","ふりかえって"],["は"],["いけない"],["。"],["この"],["低地","ていち"],["の"],["どこ"],["で"],["で"],
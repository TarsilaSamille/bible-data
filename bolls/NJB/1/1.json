[{"verse":1,"text":"初めに、神が天と地を創造した。","tok":[["初め","はじめ"],["に"],["、"],["神","かみ"],["が"],["天","てん"],["と"],["地","ち"],["を"],["創造","そうぞう"],["した"],["。"]]},{"verse":2,"text":"地は茫漠として何もなかった。やみが大水の上にあり、神の霊が水の上を動いていた。","tok":[["地","ち"],["は"],["茫漠","ぼうばく"],["として"],["何","なん"],["も"],["なかった"],["。"],["やみ"],["が"],["大水","おおみず"],["の"],["上","うえ"],["に"],["あり"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["水","みず"],["の"],["上","うえ"],["を"],["動いて","うごいて"],["いた"],["。"]]},{"verse":3,"text":"神は仰せられた。「光があれ。」すると光があった。","tok":[["神","かみ"],["は"],["仰せられた","おおせられた"],["。"],["「"],["光","ひかり"],["が"],["あれ"],["。"],["」"],["する"],["と"],["光","ひかり"],["が"],["あった"],["。"]]},{"verse":4,"text":"神は光を見て良しとされた。神は光とやみとを区別された。","tok":[["神","かみ"],["は"],["光","ひかり"],["を"],["見て","みて"],["良し","よし"],["と"],["された"],["。"],["神","かみ"],["は"],["光","ひかり"],["と"],["やみ"],["と"],["を"],["区別","くべつ"],["された"],["。"]]},{"verse":5,"text":"神は光を昼と名づけ、やみを夜と名づけられた。夕があり、朝があった。第一日。","tok":[["神","かみ"],["は"],["光","ひかり"],["を"],["昼","ひる"],["と"],["名づけ","なづけ"],["、"],["やみ"],["を"],["夜","よる"],["と"],["名づけられた","なづけられた"],["。"],["夕","ゆう"],["が"],["あり"],["、"],["朝","あさ"],["が"],["あった"],["。"],["第","だい"],["一","いち"],["日","にち"],["。"]]},{"verse":6,"text":"神は仰せられた。「大空が水の真っただ中にあれ。水と水との間に区別があれ。」","tok":[["神","かみ"],["は"],["仰せられた","おおせられた"],["。"],["「"],["大空","おおぞら"],["が"],["水","みず"],["の"],["真っただ中","まっただなか"],["に"],["あれ"],["。"],["水","みず"],["と"],["水","みず"],["と"],["の"],["間","あいだ"],["に"],["区別","くべつ"],["が"],["あれ"],["。"],["」"]]},{"verse":7,"text":"神は大空を造り、大空の下の水と、大空の上の水とを区別された。そのようになった。","tok":[["神","かみ"],["は"],["大空","おおぞら"],["を"],["造り","つくり"],["、"],["大空","おおぞら"],["の"],["下","した"],["の"],["水","みず"],["と"],["、"],["大空","おおぞら"],["の"],["上","うえ"],["の"],["水","みず"],["と"],["を"],["区別","くべつ"],["された"],["。"],["その"],["よう"],["に"],["なった"],["。"]]},{"verse":8,"text":"神は大空を天と名づけられた。夕があり、朝があった。第二日。","tok":[["神","かみ"],["は"],["大空","おおぞら"],["を"],["天","てん"],["と"],["名づけられた","なづけられた"],["。"],["夕","ゆう"],["が"],["あり"],["、"],["朝","あさ"],["が"],["あった"],["。"],["第","だい"],["二","に"],["日","にち"],["。"]]},{"verse":9,"text":"神は仰せられた。「
[{"verse":1,"text":"これはノアの息子、セム、ハム、ヤペテの歴史である。大洪水の後に、彼らに子どもが生まれた。","tok":[["これ"],["は"],["ノア"],["の"],["息子","むすこ"],["、"],["セム"],["、"],["ハム"],["、"],["ヤペテ"],["の"],["歴史","れきし"],["で"],["ある"],["。"],["大洪水","だいこうずい"],["の"],["後","あと"],["に"],["、"],["彼","かれ"],["ら"],["に"],["子ども","こども"],["が"],["生まれた","うまれた"],["。"]]},{"verse":2,"text":"ヤペテの子孫はゴメル、マゴグ、マダイ、ヤワン、トバル、メシェク、ティラス。","tok":[["ヤペテ"],["の"],["子孫","しそん"],["は"],["ゴメル"],["、"],["マゴグ"],["、"],["マダイ"],["、"],["ヤワン"],["、"],["トバル"],["、"],["メシェク"],["、"],["ティラス"],["。"]]},{"verse":3,"text":"ゴメルの子孫はアシュケナズ、リファテ、トガルマ。","tok":[["ゴメル"],["の"],["子孫","しそん"],["は"],["アシュケナズ"],["、"],["リファテ"],["、"],["トガルマ"],["。"]]},{"verse":4,"text":"ヤワンの子孫はエリシャ、タルシシュ、キティム人、ドダニム人。","tok":[["ヤワン"],["の"],["子孫","しそん"],["は"],["エリシャ"],["、"],["タルシシュ"],["、"],["キティム"],["人","にん"],["、"],["ドダニム"],["人","にん"],["。"]]},{"verse":5,"text":"これらから海沿いの国々が分かれ出て、その地方により、氏族ごとに、それぞれ国々の国語があった。","tok":[["これ"],["ら"],["から"],["海沿い","うみぞい"],["の"],["国々","くにぐに"],["が"],["分かれ出て","わかれでて"],["、"],["その"],["地方","ちほう"],["に"],["より"],["、"],["氏族","しぞく"],["ごと"],["に"],["、"],["それぞれ"],["国々","くにぐに"],["の"],["国語","こくご"],["が"],["あった"],["。"]]},{"verse":6,"text":"ハムの子孫はクシュ、ミツライム、プテ、カナン。","tok":[["ハム"],["の"],["子孫","しそん"],["は"],["クシュ"],["、"],["ミツライム"],["、"],["プテ"],["、"],["カナン"],["。"]]},{"verse":7,"text":"クシュの子孫はセバ、ハビラ、サブタ、ラマ、サブテカ。ラマの子孫はシェバ、デダン。","tok":[["クシュ"],["の"],["子孫","しそん"],["は"],["セバ"],["、"],["ハビラ"],["、"],["サブタ"],["、"],["ラマ"],["、"],["サブテカ"],["。"],["ラマ"],["の"],["子孫","しそん"],["は"],["シェバ"],["、"],["デダン"],["。"]]},{"verse":8,"text":"クシュはニムロデを生んだ。ニムロデは地上で最初の権力者となった。","tok":[["クシュ"],["は"],["ニムロデ"],["を"],["生んだ","うんだ"],["。"],["ニムロデ"],["は"],["地上","ちじょう"],["で"],["最初","さいしょ"],["の"],["権力者","けんりょくしゃ"],["と"],["なった"],["。"]]},{"verse":9,"text":"彼は主のおかげで、力ある猟師になったので、「主のおかげで、力ある猟師ニムロデのようだ」と言われるようになった。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["おかげ"],["で"],["、"],["力","ちから"],["ある"],["猟師","りょうし"],["に"],["なった"],["ので"],["、"],["「"],["主","ぬし"],["の"],["おかげ"],["で"],["、"],["力","ちから"],["ある"],["猟師","りょうし"],["ニムロデ"],["の"],["よう"],["だ"],["」"],["と"],["言われる","いわれる"],["よう"],["に"],["なった"],["。"]]},{"verse":10,"text":"彼の王国の初めは、バベル、エレク、アカデであって、みな、シヌアルの地にあった。","tok":[["彼","かれ"],["の"],["王国","おうこく"],["の"],["初め","はじめ"],["は"],["、"],["バベル"],["、"],["エレク"],["、"],["アカデ"],["で"],["あって"],["、"],["みな"],["、"],["シヌアル"],["の"],["地","ち"],["に"],["あった"],["。"]]},{"verse":11,"text":"その地から彼は、アシュルに進出し、ニネベ、レホボテ・イル、ケラフ、","tok":[["その"],["地","ち"],["から"],["彼","かれ"],["は"],["、"],["アシュル"],["に"],["進出","しんしゅつ"],["し"],["、"],["ニネベ"],["、"],["レホボテ"],["・"],["イル"],["、"],["ケラフ"],["、"]]},{"verse":12,"text":"およびニネベとケラフとの間のレセンを建てた。それは大きな町であった。","tok":[["および"],["ニネベ"],["と"],["ケラ"],["フと"],["の"],["間","あいだ"],["の"],["レセン"],["を"],["建てた","たてた"],["。"],["それ"],["は"],["大きな","おおきな"],["町","まち"],["で"],["あった"],["。"]]},{"verse":13,"text":"ミツライムはルデ人、アナミム人、レハビム人、ナフトヒム人、","tok":[["ミツライム"],["は"],["ルデ人","るでにん"],["、"],["アナミム"],["人","にん"],["、"],["レハビム"],["人","にん"],["、"],["ナフトヒム"],["人","にん"],["、"]]},{"verse":14,"text":"パテロス人、カスルヒム人――これからペリシテ人が出た――、カフトル人を生んだ。","tok":[["パテロス"],["人","にん"],["、"],["カスルヒム"],["人","にん"],["―"],["―"],["これ"],["から"],["ペリシテ"],["人","にん"],["が"],["出た","でた"],["―"],["―"],["、"],["カフトル"],["人","にん"],["を"],["生んだ","うんだ"],["。"]]},{"verse":15,"text":"カナンは長子シドン、ヘテ、","tok":[["カナン"],["は"],["長子","ちょうし"],["シドン"],["、"],["ヘテ"],["、"]]},{"verse":16,"text":"エブス人、エモリ人、ギルガシ人、","tok":[["エブス人","えぶすにん"],["、"],["エモリ人","えもりにん"],["、"],["ギルガシ"],["人","にん"],["、"]]},{"verse":17,"text":"ヒビ人、アルキ人、シニ人、","tok":[["ヒビ人","ひびにん"],["、"],["アルキ人","あるきにん"],["、"],["シニ人","しににん"],["、"]]},{"verse":18,"text":"アルワデ人、ツェマリ人、ハマテ人を生んだ。その後、カナン人の諸氏族が分かれ出た。","tok":[["アルワデ"],["人","にん"],["、"],["ツェマリ"],["人","にん"],["、"],["ハマテ人","はまてにん"],["を"],["生んだ","うんだ"],["。"],["その"],["後","ご"],["、"],["カナン人","かなんにん"],["の"],["諸","しょ"],["氏族","しぞく"],["が"],["分かれ出た","わかれでた"],["。"]]},{"verse":19,"text":"それでカナン人の領土は、シドンからゲラルに向かってガザに至り、ソドム、ゴモラ、アデマ、ツェボイムに向かってレシャにまで及んだ。","tok":[["それ"],["で"],["カナン人","かなんにん"],["の"],["領土","りょうど"],["は"],["、"],["シドン"],["から"],["ゲラル"],["に"],["向かって","むかって"],["ガザ"],["に"],["至り","いたり"],["、"],["ソドム"],["、"],["ゴモラ"],["、"],["アデマ"],["、"],["ツェボイム"],["に"],["向かって","むかって"],["レシャ"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":20,"text":"以上が、その氏族、その国語ごとに、その地方、その国により示したハムの子孫である。","tok":[["以上","いじょう"],["が"],["、"],["その"],["氏族","しぞく"],["、"],["その"],["国語","こくご"],["ごと"],["に"],["、"],["その"],["地方","ちほう"],["、"],["その"],["国","くに"],["に"],["より"],["示した","しめした"],["ハム"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":21,"text":"セムにも子が生まれた。セムはエベルのすべての子孫の先祖であって、ヤペテの兄であった。","tok":[["セム"],["に"],["も"],["子","こ"],["が"],["生まれた","うまれた"],["。"],["セム"],["は"],["エベル"],["の"],["すべて"],["の"],["子孫","しそん"],["の"],["先祖","せんぞ"],["で"],["あって"],["、"],["ヤペテ"],["の"],["兄","あに"],["で"],["あった"],["。"]]},{"verse":22,"text":"セムの子孫はエラム、アシュル、アルパクシャデ、ルデ、アラム。","tok":[["セム"],["の"],["子孫","しそん"],["は"],["エラム"],["、"],["アシュル"],["、"],["アルパクシャデ"],["、"],["ルデ"],["、"],["アラム"],["。"]]},{"verse":23,"text":"アラムの子孫はウツ、フル、ゲテル、マシュ。","tok":[["アラム"],["の"],["子孫","しそん"],["は"],["ウツ"],["、"],["フル"],["、"],["ゲテル"],["、"],["マシュ"],["。"]]},{"verse":24,"text":"アルパクシャデはシェラフを生み、シェラフはエベルを生んだ。","tok":[["アルパクシャデ"],["は"],["シェラフ"],["を"],["生み","うみ"],["、"],["シェラフ"],["は"],["エベル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":25,"text":"エベルにはふたりの男の子が生まれ、ひとりの名はペレグであった。彼の時代に地が分けられたからである。もうひとりの兄弟の名はヨクタンであった。","tok":[["エベル"],["に"],["は"],["ふたり"],["の"],["男の子","おとこのこ"],["が"],["生まれ","うまれ"],["、"],["ひとり"],["の"],["名","な"],["は"],["ペレグ"],["で"],["あった"],["。"],["彼","かれ"],["の"],["時代","じだい"],["に"],["地","ち"],["が"],["分けられた","わけられた"],["から"],["で"],["ある"],["。"],["もう"],["ひとり"],["の"],["兄弟","きょうだい"],["の"],["名","な"],["は"],["ヨクタン"],["で"],["あった"],["。"]]},{"verse":26,"text":"ヨクタンは、アルモダデ、シェレフ、ハツァルマベテ、エラフ、","tok":[["ヨクタン"],["は"],["、"],["アルモダデ"],["、"],["シェレフ"],["、"],["ハツァルマベテ"],["、"],["エラフ"],["、"]]},{"verse":27,"text":"ハドラム、ウザル、ディクラ、","tok":[["ハドラム"],["、"],["ウザル"],["、"],["ディクラ"],["、"]]},{"verse":28,"text":"オバル、アビマエル、シェバ、","tok":[["オバル"],["、"],["アビマエル"],["、"],["シェバ"],["、"]]},{"verse":29,"text":"オフィル、ハビラ、ヨバブを生んだ。これらはみな、ヨクタンの子孫であった。","tok":[["オフィル"],["、"],["ハビラ"],["、"],["ヨバブ"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["は"],["みな"],["、"],["ヨクタン"],["の"],["子孫","しそん"],["で"],["あった"],["。"]]},{"verse":30,"text":"彼らの定住地は、メシャからセファルに及ぶ東の高原地帯であった。","tok":[["彼","かれ"],["ら"],["の"],["定住","ていじゅう"],["地","ち"],["は"],["、"],["メシャ"],["から"],["セファル"],["に"],["及ぶ","およぶ"],["東","ひがし"],["の"],["高原","こうげん"],["地帯","ちたい"],["で"],["あった"],["。"]]},{"verse":31,"text":"以上は、それぞれ氏族、国語、地方、国ごとに示したセムの子孫である。","tok":[["以上","いじょう"],["は"],["、"],["それぞれ"],["氏族","しぞく"],["、"],["国語","こくご"],["、"],["地方","ちほう"],["、"],["国","くに"],["ごと"],["に"],["示した","しめした"],["セム"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":32,"text":"以上が、その国々にいる、ノアの子孫の諸氏族の家系である。大洪水の後にこれらから、諸国の民が地上に分かれ出たのであった。","tok":[["以上","いじょう"],["が"],["、"],["その"],["国々","くにぐに"],["に"],["いる"],["、"],["ノア"],["の"],["子孫","しそん"],["の"],["諸","しょ"],["氏族","しぞく"],["の"],["家系","かけい"],["で"],["ある"],["。"],["大洪水","だいこうずい"],["の"],["後","あと"],["に"],["これ"],["ら"],["から"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["が"],["地上","ちじょう"],["に"],["分かれ出た","わかれでた"],["ので"],["あった"],["。"]]}]
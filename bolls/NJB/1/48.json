[{"verse":1,"text":"これらのことの後、ヨセフに「あなたの父上は病気です」と告げる者があったので、彼はそのふたりの子、マナセとエフライムを連れて行った。","tok":[["これ"],["ら"],["の"],["こと"],["の"],["後","あと"],["、"],["ヨセフ"],["に"],["「"],["あなた"],["の"],["父上","ちちじょう"],["は"],["病気","びょうき"],["です"],["」"],["と"],["告げる","つげる"],["者","もの"],["が"],["あった"],["ので"],["、"],["彼","かれ"],["は"],["その"],["ふたり"],["の"],["子","こ"],["、"],["マナセ"],["と"],["エフライム"],["を"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":2,"text":"ある人がヤコブに告げて、「あなたの子ヨセフがあなたのもとにおいでです」と言ったので、イスラエルは力をふりしぼって床にすわった。","tok":[["ある"],["人","ひと"],["が"],["ヤコブ"],["に"],["告げて","つげて"],["、"],["「"],["あなた"],["の"],["子","こ"],["ヨセフ"],["が"],["あなた"],["の"],["もと"],["に"],["おいでです"],["」"],["と"],["言った","いった"],["ので"],["、"],["イスラエル"],["は"],["力","ちから"],["を"],["ふりしぼって"],["床","ゆか"],["に"],["すわった"],["。"]]},{"verse":3,"text":"ヤコブはヨセフに言った。「全能の神がカナンの地ルズで私に現れ、私を祝福して、","tok":[["ヤコブ"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["全能","ぜんのう"],["の"],["神","かみ"],["が"],["カナン"],["の"],["地","ち"],["ルズ"],["で"],["私","わたくし"],["に"],["現れ","あらわれ"],["、"],["私","わたくし"],["を"],["祝福","しゅくふく"],["して"],["、"]]},{"verse":4,"text":"私に仰せられた。『わたしはあなたに多くの子を与えよう。あなたをふやし、あなたを多くの民のつどいとし、またこの地をあなたの後の子孫に与え、永久の所有としよう。』","tok":[["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["『"],["わたし"],["は"],["あなた"],["に"],["多く","おおく"],["の"],["子","こ"],["を"],["与えよう","あたえよう"],["。"],["あなた"],["を"],["ふやし"],["、"],["あなた"],["を"],["多く","おおく"],["の"],["民","たみ"],["の"],["つどい"],["と"],["し"],["、"],["また"],["この"],["地","ち"],["を"],["あなた"],["の"],["後","あと"],["の"],["子孫","しそん"],["に"],["与え","あたえ"],["、"],["永久","えいきゅう"],["の"],["所有","しょゆう"],["と"],["しよう"],["。"],["』"]]},{"verse":5,"text":"今、私がエジプトに来る前に、エジプトの地で生まれたあなたのふたりの子は、私の子となる。エフライムとマナセはルベンやシメオンと同じように私の子にする。","tok":[["今","いま"],["、"],["私","わたくし"],["が"],["エジプト"],["に"],["来る","くる"],["前","まえ"],["に"],["、"],["エジプト"],["の"],["地","ち"],["で"],["生まれた","うまれた"],["あなた"],["の"],["ふたり"],["の"],["子","こ"],["は"],["、"],["私","わたくし"],["の"],["子","こ"],["と"],["なる"],["。"],["エフライム"],["と"],["マナセ"],["は"],["ルベン"],["や"],["シメオン"],["と"],["同じ","おなじ"],["よう"],["に"],["私","わたくし"],["の"],["子","こ"],["に"],["する"],["。"]]},{"verse":6,"text":"しかしあとからあなたに生まれる子どもたちはあなたのものになる。しかし、彼らが家を継ぐ場合、彼らは、彼らの兄たちの名を名のらなければならない。","tok":[["しかし"],["あと"],["から"],["あなた"],["に"],["生まれる","うまれる"],["子ども","こども"],["たち"],["は"],["あなた"],["の"],["もの"],["に"],["なる"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["が"],["家","いえ"],["を"],["継ぐ","つぐ"],["場合","ばあい"],["、"],["彼","かれ"],["ら"],["は"],["、"],["彼","かれ"],["ら"],["の"],["兄たち","あにたち"],["の"],["名","な"],["を"],["名のらなければ","なのらなければ"],["ならない"],["。"]]},{"verse":7,"text":"私のことを言えば、私がパダンから帰って来たとき、その途上カナンの地で、悲しいことに、ラケルが死んだ。そこからエフラテに行くには、なお道のりがあったが、私はエフラテ、すなわちベツレヘムへの道のその場所に彼女を葬った。」","tok":[["私","わたくし"],["の"],["こと"],["を"],["言えば","いえば"],["、"],["私","わたくし"],["が"],["パダン"],["から"],["帰って","かえって"],["来た","きた"],["とき"],["、"],["その"],["途上","とじょう"],["カナン"],["の"],["地","ち"],["で"],["、"],["悲しい","かなしい"],["こと"],["に"],["、"],["ラケル"],["が"],["死んだ","しんだ"],["。"],["そこ"],["から"],["エフラテ"],["に"],["行く","いく"],["に"],["は"],["、"],["なお"],["道のり","みちのり"],["が"],["あった"],["が"],["、"],["私","わたくし"],["は"],["エフラテ"],["、"],["すなわち"],["ベツレヘム"],["へ"],["の"],["道","みち"],["の"],["その"],["場所","ばしょ"],["に"],["彼女","かのじょ"],["を"],["葬った","ほうむった"],["。"],["」"]]},{"verse":8,"text":"イスラエルはヨセフの子らに気づいて言った。「これはだれか。」","tok":[["イスラエル"],["は"],["ヨセフ"],["の"],["子","こ"],["ら"],["に"],["気づいて","きづいて"],["言った","いった"],["。"],["「"],["これ"],["は"],["だれ"],["か"],["。"],["」"]]},{"verse":9,"text":"ヨセフは父に答えた。「神がここで私に授けてくださった子どもです。」すると父は、「彼らを私のところに連れて来なさい。私は彼らを祝福しよう」と言った。","tok":[["ヨセフ"],["は"],["父","ちち"],["に"],["答えた","こたえた"],["。"],["「"],["神","かみ"],["が"],["ここ"],["で"],["私","わたくし"],["に"],["授けて","さずけて"],["くださった"],["子ども","こども"],["です"],["。"],["」"],["する"],["と"],["父","ちち"],["は"],["、"],["「"],["彼","かれ"],["ら"],["を"],["私","わたくし"],["の"],["ところ"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["しよう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"イスラエルの目は老齢のためにかすんでいて、見ることができなかった。それでヨセフが彼らを父のところに近寄らせると、父は彼らに口づけし、彼らを抱いた。","tok":[["イスラエル"],["の"],["目","め"],["は"],["老齢","ろうれい"],["の"],["ため"],["に"],["かすんで"],["いて"],["、"],["見る","みる"],["こと"],["が"],["できなかった"],["。"],["それ"],["で"],["ヨセフ"],["が"],["彼","かれ"],["ら"],["を"],["父","ちち"],["の"],["ところ"],["に"],["近寄らせる","ちかよらせる"],["と"],["、"],["父","ちち"],["は"],["彼","かれ"],["ら"],["に"],["口づけ","くちづけ"],["し"],["、"],["彼","かれ"],["ら"],["を"],["抱いた","いだいた"],["。"]]},{"verse":11,"text":"イスラエルはヨセフに言った。「私はあなたの顔が見られようとは思わなかったのに、今こうして、神はあなたの子どもをも私に見させてくださった。」","tok":[["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["あなた"],["の"],["顔","かお"],["が"],["見られよう","みられよう"],["と"],["は"],["思わなかった","おもわなかった"],["のに"],["、"],["今","いま"],["こう"],["して"],["、"],["神","かみ"],["は"],["あなた"],["の"],["子ども","こども"],["を"],["も"],["私","わたくし"],["に"],["見させて","みさせて"],["くださった"],["。"],["」"]]},{"verse":12,"text":"ヨセフはヤコブのひざから彼らを引き寄せて、顔を地につけて、伏し拝んだ。","tok":[["ヨセフ"],["は"],["ヤコブ"],["の"],["ひざ"],["から"],["彼","かれ"],["ら"],["を"],["引き寄せて","ひきよせて"],["、"],["顔","かお"],["を"],["地","ち"],["に"],["つけて"],["、"],["伏し拝んだ","ふしおがんだ"],["。"]]},{"verse":13,"text":"それからヨセフはふたりを、エフライムは自分の右手に取ってイスラエルの左手に向かわせ、マナセは自分の左手に取ってイスラエルの右手に向かわせて、彼に近寄らせた。","tok":[["それ"],["から"],["ヨセフ"],["は"],["ふたり"],["を"],["、"],["エフライム"],["は"],["自分","じぶん"],["の"],["右手","みぎて"],["に"],["取って","とって"],["イスラエル"],["の"],["左手","ひだりて"],["に"],["向かわせ","むかわせ"],["、"],["マナセ"],["は"],["自分","じぶん"],["の"],["左手","ひだりて"],["に"],["取って","とって"],["イスラエル"],["の"],["右手","みぎて"],["に"],["向かわせて","むかわせて"],["、"],["彼","かれ"],["に"],["近寄らせた","ちかよらせた"],["。"]]},{"verse":14,"text":"すると、イスラエルは、右手を伸ばして、弟であるエフライムの頭の上に置き、左手をマナセの頭の上に置いた。マナセが長子であるのに、彼は手を交差して置いたのである。","tok":[["する"],["と"],["、"],["イスラエル"],["は"],["、"],["右手","みぎて"],["を"],["伸ばして","のばして"],["、"],["弟","おとうと"],["で"],["ある"],["エフライム"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["置き","おき"],["、"],["左手","ひだりて"],["を"],["マナセ"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["置いた","おいた"],["。"],["マナセ"],["が"],["長子","ちょうし"],["で"],["ある"],["のに"],["、"],["彼","かれ"],["は"],["手","て"],["を"],["交差","こうさ"],["して"],["置いた","おいた"],["ので"],["ある"],["。"]]},{"verse":15,"text":"それから、ヨセフを祝福して言った。「私の先祖アブラハムとイサクが、その御前に歩んだ神。きょうのこの日まで、ずっと私の羊飼いであられた神。","tok":[["それ"],["から"],["、"],["ヨセフ"],["を"],["祝福","しゅくふく"],["して"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["先祖","せんぞ"],["アブラハム"],["と"],["イサク"],["が"],["、"],["その"],["御前","ごぜん"],["に"],["歩んだ","あゆんだ"],["神","かみ"],["。"],["きょう"],["の"],["この"],["日","ひ"],["まで"],["、"],["ずっと"],["私","わたくし"],["の"],["羊飼い","ひつじかい"],["で"],["あられた"],["神","かみ"],["。"]]},{"verse":16,"text":"すべてのわざわいから私を贖われた御使い。この子どもたちを祝福してください。私の名が先祖アブラハムとイサクの名とともに、彼らのうちにとなえ続けられますように。また彼らが地のまなかで、豊かにふえますように。」","tok":[["すべて"],["の"],["わざわい"],["から"],["私","わたくし"],["を"],["贖われた","あがなわれた"],["御使い","おつかい"],["。"],["この"],["子ども","こども"],["たち"],["を"],["祝福","しゅくふく"],["して"],["ください"],["。"],["私","わたくし"],["の"],["名","な"],["が"],["先祖","せんぞ"],["アブラハム"],["と"],["イサク"],["の"],["名","な"],["と"],["とも"],["に"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["となえ"],["続けられます","つづけられます"],["よう"],["に"],["。"],["また"],["彼","かれ"],["ら"],["が"],["地","ち"],["の"],["ま"],["なか"],["で"],["、"],["豊か","ゆたか"],["に"],["ふえます"],["よう"],["に"],["。"],["」"]]},{"verse":17,"text":"ヨセフは父が右手をエフライムの頭の上に置いたのを見て、それはまちがっていると思い、父の手をつかんで、それをエフライムの頭からマナセの頭へ移そうとした。","tok":[["ヨセフ"],["は"],["父","ちち"],["が"],["右手","みぎて"],["を"],["エフライム"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["置いた","おいた"],["の"],["を"],["見て","みて"],["、"],["それ"],["は"],["まちがって"],["いる"],["と"],["思い","おもい"],["、"],["父","ちち"],["の"],["手","て"],["を"],["つかんで"],["、"],["それ"],["を"],["エフライム"],["の"],["頭","あたま"],["から"],["マナセ"],["の"],["頭","あたま"],["へ"],["移そう","うつそう"],["と"],["した"],["。"]]},{"verse":18,"text":"ヨセフは父に言った。「父上。そうではありません。こちらが長子なのですから、あなたの右の手を、こちらの頭に置いてください。」","tok":[["ヨセフ"],["は"],["父","ちち"],["に"],["言った","いった"],["。"],["「"],["父上","ちちじょう"],["。"],["そう"],["で"],["は"],["ありません"],["。"],["こちら"],["が"],["長子","ちょうし"],["な"],["の"],["です"],["から"],["、"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["、"],["こちら"],["の"],["頭","あたま"],["に"],["置いて","おいて"],["ください"],["。"],["」"]]},{"verse":19,"text":"しかし、父は拒んで言った。「わかっている。わが子よ。私にはわかっている。彼もまた一つの民となり、また大いなる者となるであろう。しかし弟は彼よりも大きくなり、その子孫は国々を満たすほど多くなるであろう。」","tok":[["しかし"],["、"],["父","ちち"],["は"],["拒んで","こばんで"],["言った","いった"],["。"],["「"],["わかって"],["いる"],["。"],["わが"],["子","こ"],["よ"],["。"],["私","わたくし"],["に"],["は"],["わかって"],["いる"],["。"],["彼","かれ"],["も"],["また"],["一","ひと"],["つ"],["の"],["民","たみ"],["と"],["なり"],["、"],["また"],["大いなる","おおいなる"],["者","もの"],["と"],["なるで"],["あろう"],["。"],["しかし"],["弟","おとうと"],["は"],["彼","かれ"],["より"],["も"],["大きく","おおきく"],["なり"],["、"],["その"],["子孫","しそん"],["は"],["国々","くにぐに"],["を"],["満たす","みたす"],["ほど"],["多く","おおく"],["なるで"],["あろう"],["。"],["」"]]},{"verse":20,"text":"そして彼はその日、彼らを祝福して言った。「あなたがたによって、イスラエルは祝福のことばを述べる。『神があなたをエフライムやマナセのようになさるように。』」こうして、彼はエフライムをマナセの先にした。","tok":[["そして"],["彼","かれ"],["は"],["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["によって"],["、"],["イスラエル"],["は"],["祝福","しゅくふく"],["の"],["ことば"],["を"],["述べる","のべる"],["。"],["『"],["神","かみ"],["が"],["あなた"],["を"],["エフライム"],["や"],["マナセ"],["の"],["よう"],["に"],["なさる"],["よう"],["に"],["。"],["』"],["」"],["こう"],["して"],["、"],["彼","かれ"],["は"],["エフライム"],["を"],["マナセ"],["の"],["先","さき"],["に"],["した"],["。"]]},{"verse":21,"text":"イスラエルはヨセフに言った。「私は今、死のうとしている。しかし、神はあなたがたとともにおられ、あなたがたをあなたがたの先祖の地に帰してくださる。","tok":[["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["今","いま"],["、"],["死のう","しのう"],["として"],["いる"],["。"],["しかし"],["、"],["神","かみ"],["は"],["あなた"],["がた"],["と"],["とも"],["に"],["おられ"],["、"],["あなた"],["がた"],["を"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["地","ち"],["に"],["帰して","かえして"],["くださる"],["。"]]},{"verse":22,"text":"私は、あなたの兄弟よりも、むしろあなたに、私が剣と弓とをもってエモリ人の手から取ったあのシェケムを与えよう。」","tok":[["私","わたくし"],["は"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["より"],["も"],["、"],["むしろ"],["あなた"],["に"],["、"],["私","わたくし"],["が"],["剣","けん"],["と"],["弓","ゆみ"],["と"],["を"],["もって"],["エモリ人","えもりにん"],["の"],["手","て"],["から"],["取った","とった"],["あの"],["シェケム"],["を"],["与えよう","あたえよう"],["。"],["」"]]}]
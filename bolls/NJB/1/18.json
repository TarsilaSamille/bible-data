[{"verse":1,"text":"主はマムレの樫の木のそばで、アブラハムに現れた。彼は日の暑いころ、天幕の入口にすわっていた。","tok":[["主","ぬし"],["は"],["マムレ"],["の"],["樫","かし"],["の"],["木","き"],["の"],["そば"],["で"],["、"],["アブラハム"],["に"],["現れた","あらわれた"],["。"],["彼","かれ"],["は"],["日","ひ"],["の"],["暑い","あつい"],["ころ"],["、"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["すわって"],["いた"],["。"]]},{"verse":2,"text":"彼が目を上げて見ると、三人の人が彼に向かって立っていた。彼は、見るなり、彼らを迎えるために天幕の入口から走って行き、地にひれ伏して礼をした。","tok":[["彼","かれ"],["が"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["三人","さんにん"],["の"],["人","ひと"],["が"],["彼","かれ"],["に"],["向かって","むかって"],["立って","たって"],["いた"],["。"],["彼","かれ"],["は"],["、"],["見る","みる"],["なり"],["、"],["彼","かれ"],["ら"],["を"],["迎える","むかえる"],["ため"],["に"],["天幕","てんまく"],["の"],["入口","いりぐち"],["から"],["走って","はしって"],["行き","いき"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["礼","れい"],["を"],["した"],["。"]]},{"verse":3,"text":"そして言った。「ご主人。お気に召すなら、どうか、あなたのしもべのところを素通りなさらないでください。","tok":[["そして"],["言った","いった"],["。"],["「"],["ご主人","ごしゅじん"],["。"],["お気","おき"],["に"],["召すなら","めすなら"],["、"],["どう"],["か"],["、"],["あなた"],["の"],["しもべ"],["の"],["ところ"],["を"],["素通り","すどおり"],["なさらないで"],["ください"],["。"]]},{"verse":4,"text":"少しばかりの水を持って来させますから、あなたがたの足を洗い、この木の下でお休みください。","tok":[["少し","すこし"],["ばかり"],["の"],["水","みず"],["を"],["持って","もって"],["来させます","きさせます"],["から"],["、"],["あなた"],["がた"],["の"],["足","あし"],["を"],["洗い","あらい"],["、"],["この"],["木","き"],["の"],["下","もと"],["で"],["お休み","おやすみ"],["ください"],["。"]]},{"verse":5,"text":"私は少し食べ物を持ってまいります。それで元気を取り戻してください。それから、旅を続けられるように。せっかく、あなたがたのしもべのところをお通りになるのですから。」彼らは答えた。「あなたの言ったとおりにしてください。」","tok":[["私","わたくし"],["は"],["少し","すこし"],["食べ物","たべもの"],["を"],["持って","もって"],["まいります"],["。"],["それ"],["で"],["元気","げんき"],["を"],["取り戻して","とりもどして"],["ください"],["。"],["それ"],["から"],["、"],["旅","たび"],["を"],["続けられる","つづけられる"],["よう"],["に"],["。"],["せっかく"],["、"],["あなた"],["がた"],["の"],["しもべ"],["の"],["ところ"],["を"],["お通り","おとおり"],["に"],["なる"],["の"],["です"],["から"],["。"],["」"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["言った","いった"],["とおり"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":6,"text":"そこで、アブラハムは天幕のサラのところに急いで戻って、言った。「早く、三セアの上等の小麦粉をこねて、パン菓子を作っておくれ。」","tok":[["そこ"],["で"],["、"],["アブラハム"],["は"],["天幕","てんまく"],["の"],["サラ"],["の"],["ところ"],["に"],["急いで","いそいで"],["戻って","もどって"],["、"],["言った","いった"],["。"],["「"],["早く","はやく"],["、"],["三","さん"],["セア"],["の"],["上等","じょうとう"],["の"],["小麦粉","こむぎこ"],["を"],["こねて"],["、"],["パン"],["菓子","かし"],["を"],["作って","つくって"],["おくれ"],["。"],["」"]]},{"verse":7,"text":"そしてアブラハムは牛のところに走って行き、柔らかくて、おいしそうな子牛を取り、若い者に渡した。若い者は手早くそれを料理した。","tok":[["そして"],["アブラハム"],["は"],["牛","うし"],["の"],["ところ"],["に"],["走って","はしって"],["行き","いき"],["、"],["柔らかくて","やわらかくて"],["、"],["おいし"],["そう"],["な"],["子牛","こうし"],["を"],["取り","とり"],["、"],["若い","わかい"],["者","もの"],["に"],["渡した","わたした"],["。"],["若い","わかい"],["者","もの"],["は"],["手早く","てばやく"],["それ"],["を"],["料理","りょうり"],["した"],["。"]]},{"verse":8,"text":"それからアブラハムは、凝乳と牛乳と、それに、料理した子牛を持って来て、彼らの前に供えた。彼は、木の下で彼らに給仕をしていた。こうして彼らは食べた。","tok":[["それ"],["から"],["アブラハム"],["は"],["、"],["凝乳","ぎょうにゅう"],["と"],["牛乳","ぎゅうにゅう"],["と"],["、"],["それ"],["に"],["、"],["料理","りょうり"],["した"],["子牛","こうし"],["を"],["持って","もって"],["来て","きて"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["供えた","そなえた"],["。"],["彼","かれ"],["は"],["、"],["木","き"],["の"],["下","もと"],["で"],["彼","かれ"],["ら"],["に"],["給仕","きゅうじ"],["を"],["して"],["いた"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["食べた","たべた"],["。"]]},{"verse":9,"text":"彼らはアブラハムに尋ねた。「あなたの妻サラはどこにいますか。」それで「天幕の中にいます」と答えた。","tok":[["彼","かれ"],["ら"],["は"],["アブラハム"],["に"],["尋ねた","たずねた"],["。"],["「"],["あなた"],["の"],["妻","つま"],["サラ"],["は"],["どこ"],["に"],["います"],["か"],["。"],["」"],["それ"],["で"],["「"],["天幕","てんまく"],["の"],["中","なか"],["に"],["います"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":10,"text":"するとひとりが言った。「わたしは来年の今ごろ、必ずあなたのところに戻って来ます。そのとき、あなたの妻サラには、男の子ができている。」サラはその人のうしろの天幕の入口で、聞いていた。","tok":[["する"],["と"],["ひとり"],["が"],["言った","いった"],["。"],["「"],["わたし"],["は"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["、"],["必ず","かならず"],["あなた"],["の"],["ところ"],["に"],["戻って","もどって"],["来ます","きます"],["。"],["その"],["とき"],["、"],["あなた"],["の"],["妻","つま"],["サラ"],["に"],["は"],["、"],["男の子","おとこのこ"],["が"],["できて"],["いる"],["。"],["」"],["サラ"],["は"],["その"],["人","ひと"],["の"],["うしろ"],["の"],["天幕","てんまく"],["の"],["入口","いりぐち"],["で"],["、"],["聞いて","きいて"],["いた"],["。"]]},{"verse":11,"text":"アブラハムとサラは年を重ねて老人になっており、サラには普通の女にあることがすでに止まっていた。","tok":[["アブラハム"],["と"],["サラ"],["は"],["年","とし"],["を"],["重ねて","かさねて"],["老人","ろうじん"],["に"],["なって"],["おり"],["、"],["サラ"],["に"],["は"],["普通","ふつう"],["の"],["女","おんな"],["に"],["ある"],["こと"],["が"],["すでに"],["止まって","とまって"],["いた"],["。"]]},{"verse":12,"text":"それでサラは心の中で笑ってこう言った。「老いぼれてしまったこの私に、何の楽しみがあろう。それに主人も年寄りで。」","tok":[["それ"],["で"],["サラ"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["笑って","わらって"],["こう"],["言った","いった"],["。"],["「"],["老いぼれて","おいぼれて"],["しまった"],["この"],["私","わたくし"],["に"],["、"],["何","なん"],["の"],["楽しみ","たのしみ"],["が"],["あろう"],["。"],["それ"],["に"],["主人","しゅじん"],["も"],["年寄り","としより"],["で"],["。"],["」"]]},{"verse":13,"text":"そこで、主がアブラハムに仰せられた。「サラはなぜ『私はほんとうに子を産めるだろうか。こんなに年をとっているのに』と言って笑うのか。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["が"],["アブラハム"],["に"],["仰せられた","おおせられた"],["。"],["「"],["サラ"],["は"],["なぜ"],["『"],["私","わたくし"],["は"],["ほんとう"],["に"],["子","こ"],["を"],["産めるだろう","うめるだろう"],["か"],["。"],["こんな"],["に"],["年","とし"],["を"],["とって"],["いる"],["のに"],["』"],["と"],["言って","いって"],["笑う","わらう"],["の"],["か"],["。"]]},{"verse":14,"text":"主に不可能なことがあろうか。わたしは来年の今ごろ、定めた時に、あなたのところに戻って来る。そのとき、サラには男の子ができている。」","tok":[["主に","おもに"],["不可能","ふかのう"],["な"],["こと"],["が"],["あろう"],["か"],["。"],["わたし"],["は"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["、"],["定めた","さだめた"],["時","とき"],["に"],["、"],["あなた"],["の"],["ところ"],["に"],["戻って","もどって"],["来る","くる"],["。"],["その"],["とき"],["、"],["サラ"],["に"],["は"],["男の子","おとこのこ"],["が"],["できて"],["いる"],["。"],["」"]]},{"verse":15,"text":"サラは「私は笑いませんでした」と言って打ち消した。恐ろしかったのである。しかし主は仰せられた。「いや、確かにあなたは笑った。」","tok":[["サラ"],["は"],["「"],["私","わたくし"],["は"],["笑いませんでした","わらいませんでした"],["」"],["と"],["言って","いって"],["打ち消した","うちけした"],["。"],["恐ろしかった","おそろしかった"],["ので"],["ある"],["。"],["しかし"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["いや"],["、"],["確か","たしか"],["に"],["あなた"],["は"],["笑った","わらった"],["。"],["」"]]},{"verse":16,"text":"その人たちは、そこを立って、ソドムを見おろすほうへ上って行った。アブラハムも彼らを見送るために、彼らといっしょに歩いていた。","tok":[["その"],["人","ひと"],["たち"],["は"],["、"],["そこ"],["を"],["立って","たって"],["、"],["ソドム"],["を"],["見おろす","みおろす"],["ほう"],["へ"],["上って","のぼって"],["行った","いった"],["。"],["アブラハム"],["も"],["彼","かれ"],["ら"],["を"],["見送る","みおくる"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["歩いて","あるいて"],["いた"],["。"]]},{"verse":17,"text":"主はこう考えられた。「わたしがしようとしていることを、アブラハムに隠しておくべきだろうか。","tok":[["主","ぬし"],["は"],["こう"],["考えられた","かんがえられた"],["。"],["「"],["わたし"],["が"],["しよう"],["として"],["いる"],["こと"],["を"],["、"],["アブラハム"],["に"],["隠して","かくして"],["おくべきだろう"],["か"],["。"]]},{"verse":18,"text":"アブラハムは必ず大いなる強い国民となり、地のすべての国々は、彼によって祝福される。","tok":[["アブラハム"],["は"],["必ず","かならず"],["大いなる","おおいなる"],["強い","つよい"],["国民","こくみん"],["と"],["なり"],["、"],["地","ち"],["の"],["すべて"],["の"],["国々","くにぐに"],["は"],["、"],["彼","かれ"],["によって"],["祝福","しゅくふく"],["される"],["。"]]},{"verse":19,"text":"わたしが彼を選び出したのは、彼がその子らと、彼の後の家族とに命じて主の道を守らせ、正義と公正とを行わせるため、主が、アブラハムについて約束したことを、彼の上に成就するためである。」","tok":[["わたし"],["が"],["彼","かれ"],["を"],["選び出した","えらびだした"],["の"],["は"],["、"],["彼","かれ"],["が"],["その"],["子","こ"],["ら"],["と"],["、"],["彼","かれ"],["の"],["後","あと"],["の"],["家族","かぞく"],["と"],["に"],["命じて","めいじて"],["主","ぬし"],["の"],["道","みち"],["を"],["守らせ","まもらせ"],["、"],["正義","まさよし"],["と"],["公正","こうせい"],["と"],["を"],["行わせる","おこなわせる"],["ため"],["、"],["主","ぬし"],["が"],["、"],["アブラハム"],["について"],["約束","やくそく"],["した"],["こと"],["を"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["成就","じょうじゅ"],["する"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":20,"text":"そこで主は仰せられた。「ソドムとゴモラの叫びは非常に大きく、また彼らの罪はきわめて重い。","tok":[["そこ"],["で"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["ソドム"],["と"],["ゴモラ"],["の"],["叫び","さけび"],["は"],["非常","ひじょう"],["に"],["大きく","おおきく"],["、"],["また"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["は"],["きわめて"],["重い","おもい"],["。"]]},{"verse":21,"text":"わたしは下って行って、わたしに届いた叫びどおりに、彼らが実際に行っているかどうかを見よう。わたしは知りたいのだ。」","tok":[["わたし"],["は"],["下って","くだって"],["行って","いって"],["、"],["わたし"],["に"],["届いた","とどいた"],["叫び","さけび"],["どおり"],["に"],["、"],["彼","かれ"],["ら"],["が"],["実際","じっさい"],["に"],["行って","いって"],["いる"],["か"],["どう"],["か"],["を"],["見よう","みよう"],["。"],["わたし"],["は"],["知りたい","しりたい"],["の"],["だ"],["。"],["」"]]},{"verse":22,"text":"その人たちはそこからソドムのほうへと進んで行った。アブラハムはまだ、主の前に立っていた。","tok":[["その"],["人","ひと"],["たち"],["は"],["そこ"],["から"],["ソドム"],["の"],["ほう"],["へ"],["と"],["進んで","すすんで"],["行った","いった"],["。"],["アブラハム"],["は"],["まだ"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":23,"text":"アブラハムは近づいて申し上げた。「あなたはほんとうに、正しい者を、悪い者といっしょに滅ぼし尽くされるのですか。","tok":[["アブラハム"],["は"],["近づいて","ちかづいて"],["申し上げた","もうしあげた"],["。"],["「"],["あなた"],["は"],["ほんとう"],["に"],["、"],["正しい","ただしい"],["者","もの"],["を"],["、"],["悪い","わるい"],["者","もの"],["と"],["いっしょ"],["に"],["滅ぼし","ほろぼし"],["尽くされる","つくされる"],["の"],["です"],["か"],["。"]]},{"verse":24,"text":"もしや、その町の中に五十人の正しい者がいるかもしれません。ほんとうに滅ぼしてしまわれるのですか。その中にいる五十人の正しい者のために、その町をお赦しにはならないのですか。","tok":[["もし"],["や"],["、"],["その"],["町","まち"],["の"],["中","なか"],["に"],["五","ご"],["十人","じゅうにん"],["の"],["正しい","ただしい"],["者","もの"],["が"],["いる"],["か"],["も"],["しれません"],["。"],["ほんとう"],["に"],["滅ぼして","ほろぼして"],["しまわれる"],["の"],["です"],["か"],["。"],["その"],["中","なか"],["に"],["いる"],["五","ご"],["十人","じゅうにん"],["の"],["正しい","ただしい"],["者","もの"],["の"],["ため"],["に"],["、"],["その"],["町","まち"],["を"],["お赦し","おゆるし"],["に"],["は"],["ならない"],["の"],["です"],["か"],["。"]]},{"verse":25,"text":"正しい者を悪い者といっしょに殺し、そのため、正しい者と悪い者とが同じようになるというようなことを、あなたがなさるはずがありません。とてもありえないことです。全世界をさばくお方は、公義を行うべきではありませんか。」","tok":[["正しい","ただしい"],["者","もの"],["を"],["悪い","わるい"],["者","もの"],["と"],["いっしょ"],["に"],["殺し","ころし"],["、"],["その"],["ため"],["、"],["正しい","ただしい"],["者","もの"],["と"],["悪い","わるい"],["者","もの"],["と"],["が"],["同じ","おなじ"],["よう"],["に"],["なる"],["と"],["いう"],["よう"],["な"],["こと"],["を"],["、"],["あなた"],["が"],["なさる"],["はず"],["が"],["ありません"],["。"],["とても"],["あり"],["えない"],["こと"],["です"],["。"],["全","ぜん"],["世界","せかい"],["を"],["さばく"],["お方","おかた"],["は"],["、"],["公義","きみよし"],["を"],["行うべきで","おこなうべきで"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":26,"text":"主は答えられた。「もしソドムで、わたしが五十人の正しい者を町の中に見つけたら、その人たちのために、その町全部を赦そう。」","tok":[["主","ぬし"],["は"],["答えられた","こたえられた"],["。"],["「"],["もし"],["ソドム"],["で"],["、"],["わたし"],["が"],["五","ご"],["十人","じゅうにん"],["の"],["正しい","ただしい"],["者","もの"],["を"],["町","まち"],["の"],["中","なか"],["に"],["見つけたら","みつけたら"],["、"],["その"],["人","ひと"],["たち"],["の"],["ため"],["に"],["、"],["その"],["町","まち"],["全部","ぜんぶ"],["を"],["赦そう","ゆるそう"],["。"],["」"]]},{"verse":27,"text":"アブラハムは答えて言った。「私はちりや灰にすぎませんが、あえて主に申し上げるのをお許しください。","tok":[["アブラハム"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["ちり"],["や"],["灰","はい"],["に"],["すぎません"],["が"],["、"],["あえて"],["主に","おもに"],["申し上げる","もうしあげる"],["の"],["を"],["お許し","おゆるし"],["ください"],["。"]]},{"verse":28,"text":"もしや五十人の正しい者に五人不足しているかもしれません。その五人のために、あなたは町の全部を滅ぼされるでしょうか。」主は仰せられた。「滅ぼすまい。もしそこにわたしが四十五人を見つけたら。」","tok":[["もし"],["や"],["五","ご"],["十人","じゅうにん"],["の"],["正しい","ただしい"],["者","もの"],["に"],["五人","ごにん"],["不足","ふそく"],["して"],["いる"],["か"],["も"],["しれません"],["。"],["その"],["五人","ごにん"],["の"],["ため"],["に"],["、"],["あなた"],["は"],["町","まち"],["の"],["全部","ぜんぶ"],["を"],["滅ぼされるでしょう","ほろぼされるでしょう"],["か"],["。"],["」"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["滅ぼすまい","ほろぼすまい"],["。"],["もし"],["そこ"],["に"],["わたし"],["が"],["四十五人","よんじゅうごにん"],["を"],["見つけたら","みつけたら"],["。"],["」"]]},{"verse":29,"text":"そこで、再び尋ねて申し上げた。「もしやそこに四十人見つかるかもしれません。」すると仰せられた。「滅ぼすまい。その四十人のために。」","tok":[["そこ"],["で"],["、"],["再び","ふたたび"],["尋ねて","たずねて"],["申し上げた","もうしあげた"],["。"],["「"],["もし"],["や"],["そこ"],["に"],["四","よん"],["十人","じゅうにん"],["見つかる","みつかる"],["か"],["も"],["しれません"],["。"],["」"],["する"],["と"],["仰せられた","おおせられた"],["。"],["「"],["滅ぼすまい","ほろぼすまい"],["。"],["その"],["四","よん"],["十人","じゅうにん"],["の"],["ため"],["に"],["。"],["」"]]},{"verse":30,"text":"また彼は言った。「主よ。どうかお怒りにならないで、私に言わせてください。もしやそこに三十人見つかるかもしれません。」主は仰せられた。「滅ぼすまい。もしそこにわたしが三十人を見つけたら。」","tok":[["また"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["お怒り","おいかり"],["に"],["ならないで"],["、"],["私","わたくし"],["に"],["言わせて","いわせて"],["ください"],["。"],["もし"],["や"],["そこ"],["に"],["三","さん"],["十人","じゅうにん"],
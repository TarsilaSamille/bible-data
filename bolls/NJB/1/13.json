[{"verse":1,"text":"それで、アブラムは、エジプトを出て、ネゲブに上った。彼と、妻のサライと、すべての所有物と、ロトもいっしょであった。","tok":[["それ"],["で"],["、"],["アブラム"],["は"],["、"],["エジプト"],["を"],["出て","でて"],["、"],["ネゲブ"],["に"],["上った","のぼった"],["。"],["彼","かれ"],["と"],["、"],["妻","つま"],["の"],["サライ"],["と"],["、"],["すべて"],["の"],["所有物","しょゆうぶつ"],["と"],["、"],["ロト"],["も"],["いっしょ"],["で"],["あった"],["。"]]},{"verse":2,"text":"アブラムは家畜と銀と金とに非常に富んでいた。","tok":[["アブラム"],["は"],["家畜","かちく"],["と"],["銀","ぎん"],["と"],["金","かね"],["と"],["に"],["非常","ひじょう"],["に"],["富んで","とんで"],["いた"],["。"]]},{"verse":3,"text":"彼はネゲブから旅を続けて、ベテルまで、すなわち、ベテルとアイの間で、初めに天幕を張った所まで来た。","tok":[["彼","かれ"],["は"],["ネゲブ"],["から"],["旅","たび"],["を"],["続けて","つづけて"],["、"],["ベテル"],["まで"],["、"],["すなわち"],["、"],["ベテル"],["と"],["アイ"],["の"],["間","あいだ"],["で"],["、"],["初め","はじめ"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["所","ところ"],["まで"],["来た","きた"],["。"]]},{"verse":4,"text":"そこは彼が以前に築いた祭壇の場所である。その所でアブラムは、主の御名によって祈った。","tok":[["そこ"],["は"],["彼","かれ"],["が"],["以前","いぜん"],["に"],["築いた","きずいた"],["祭壇","さいだん"],["の"],["場所","ばしょ"],["で"],["ある"],["。"],["その"],["所","ところ"],["で"],["アブラム"],["は"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["祈った","いのった"],["。"]]},{"verse":5,"text":"アブラムといっしょに行ったロトもまた、羊の群れや牛の群れ、天幕を所有していた。","tok":[["アブラム"],["と"],["いっしょ"],["に"],["行った","いった"],["ロト"],["も"],["また"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["や"],["牛","うし"],["の"],["群れ","むれ"],["、"],["天幕","てんまく"],["を"],["所有","しょゆう"],["して"],["いた"],["。"]]},{"verse":6,"text":"その地は彼らがいっしょに住むのに十分ではなかった。彼らの持ち物が多すぎたので、彼らがいっしょに住むことができなかったのである。","tok":[["その"],["地","ち"],["は"],["彼","かれ"],["ら"],["が"],["いっしょ"],["に"],["住む","すむ"],["のに"],["十分","じゅうぶん"],["で"],["は"],["なかった"],["。"],["彼","かれ"],["ら"],["の"],["持ち物","もちもの"],["が"],["多","おお"],["すぎた"],["ので"],["、"],["彼","かれ"],["ら"],["が"],["いっしょ"],["に"],["住む","すむ"],["こと"],["が"],["できなかった"],["ので"],["ある"],["。"]]},{"verse":7,"text":"そのうえ、アブラムの家畜の牧者たちとロトの家畜の牧者たちとの間に、争いが起こった。またそのころ、その地にはカナン人とペリジ人が住んでいた。","tok":[["その"],["うえ"],["、"],["アブラム"],["の"],["家畜","かちく"],["の"],["牧者","ぼくしゃ"],["たち"],["と"],["ロト"],["の"],["家畜","かちく"],["の"],["牧者","ぼくしゃ"],["たち"],["と"],["の"],["間","あいだ"],["に"],["、"],["争い","あらそい"],["が"],["起こった","おこった"],["。"],["また"],["その"],["ころ"],["、"],["その"],["地","ち"],["に"],["は"],["カナン人","かなんにん"],["と"],["ペリジ人","ぺりじにん"],["が"],["住んで","すんで"],["いた"],["。"]]},{"verse":8,"text":"そこで、アブラムはロトに言った。「どうか私とあなたとの間、また私の牧者たちとあなたの牧者たちとの間に、争いがないようにしてくれ。私たちは、親類同士なのだから。","tok":[["そこ"],["で"],["、"],["アブラム"],["は"],["ロト"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["私","わたくし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["、"],["また"],["私","わたくし"],["の"],["牧者","ぼくしゃ"],["たち"],["と"],["あなた"],["の"],["牧者","ぼくしゃ"],["たち"],["と"],["の"],["間","あいだ"],["に"],["、"],["争い","あらそい"],["が"],["ない"],["よう"],["に"],["して"],["くれ"],["。"],["私たち","わたしたち"],["は"],["、"],["親類同士","しんるいどうし"],["な"],["の"],["だ"],["から"],["。"]]},{"verse":9,"text":"全地はあなたの前にあるではないか。私から別れてくれないか。もしあなたが左に行けば、私は右に行こう。もしあなたが右に行けば、私は左に行こう。」","tok":[["全地","ぜんち"],["は"],["あなた"],["の"],["前","まえ"],["に"],["ある"],["で"],["は"],["ない"],["か"],["。"],["私","わたくし"],["から"],["別れて","わかれて"],["くれない"],["か"],["。"],["もし"],["あなた"],["が"],["左","ひだり"],["に"],["行けば","いけば"],["、"],["私","わたくし"],["は"],["右","みぎ"],["に"],["行こう","いこう"],["。"],["もし"],["あなた"],["が"],["右","みぎ"],["に"],["行けば","いけば"],["、"],["私","わたくし"],["は"],["左","ひだり"],["に"],["行こう","いこう"],["。"],["」"]]},{"verse":10,"text":"ロトが目を上げてヨルダンの低地全体を見渡すと、主がソドムとゴモラを滅ぼされる以前であったので、その地はツォアルのほうに至るまで、主の園のように、またエジプトの地のように、どこもよく潤っていた。","tok":[["ロト"],["が"],["目","め"],["を"],["上げて","あげて"],["ヨルダン"],["の"],["低地","ていち"],["全体","ぜんたい"],["を"],["見渡す","みわたす"],["と"],["、"],["主","ぬし"],["が"],["ソドム"],["と"],["ゴモラ"],["を"],["滅ぼされる","ほろぼされる"],["以前","いぜん"],["で"],["あった"],["ので"],["、"],["その"],["地","ち"],["は"],["ツォアル"],["の"],["ほう"],["に"],["至る","いたる"],["まで"],["、"],["主","ぬし"],["の"],["園","その"],["の"],["よう"],["に"],["、"],["また"],["エジプト"],["の"],["地","ち"],["の"],["よう"],["に"],["、"],["どこ"],["も"],["よく"],["潤って","うるおって"],["いた"],["。"]]},{"verse":11,"text":"それで、ロトはそのヨルダンの低地全体を選び取り、その後、東のほうに移動した。こうして彼らは互いに別れた。","tok":[["それ"],["で"],["、"],["ロト"],["は"],["その"],["ヨルダン"],["の"],["低地","ていち"],["全体","ぜんたい"],["を"],["選び取り","えらびとり"],["、"],["その"],["後","ご"],["、"],["東","ひがし"],["の"],["ほう"],["に"],["移動","いどう"],["した"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["別れた","わかれた"],["。"]]},{"verse":12,"text":"アブラムはカナンの地に住んだが、ロトは低地の町々に住んで、ソドムの近くまで天幕を張った。","tok":[["アブラム"],["は"],["カナン"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["が"],["、"],["ロト"],["は"],["低地","ていち"],["の"],["町々","まちまち"],["に"],["住んで","すんで"],["、"],["ソドム"],["の"],["近く","ちかく"],["まで"],["天幕","てんまく"],["を"],["張った","はった"],["。"]]},{"verse":13,"text":"ところが、ソドムの人々はよこしまな者で、主に対しては非常な罪人であった。","tok":[["ところ"],["が"],["、"],["ソドム"],["の"],["人々","ひとびと"],["は"],["よこしま"],["な"],["者","もの"],["で"],["、"],["主に","おもに"],["対して","たいして"],["は"],["非常","ひじょう"],["な"],["罪人","ざいにん"],["で"],["あった"],["。"]]},{"verse":14,"text":"ロトがアブラムと別れて後、主はアブラムに仰せられた。「さあ、目を上げて、あなたがいる所から北と南、東と西を見渡しなさい。","tok":[["ロト"],["が"],["アブラム"],["と"],["別れて","わかれて"],["後","あと"],["、"],["主","ぬし"],["は"],["アブラム"],["に"],["仰せられた","おおせられた"],["。"],["「"],["さあ"],["、"],["目","め"],["を"],["上げて","あげて"],["、"],["あなた"],["が"],["いる"],["所","ところ"],["から"],["北","きた"],["と"],["南","みなみ"],["、"],["東","ひがし"],["と"],["西","にし"],["を"],["見渡し","みわたし"],["なさい"],["。"]]},{"verse":15,"text":"わたしは、あなたが見渡しているこの地全部を、永久にあなたとあなたの子孫とに与えよう。","tok":[["わたし"],["は"],["、"],["あなた"],["が"],["見渡して","みわたして"],["いる"],["この"],["地","ち"],["全部","ぜんぶ"],["を"],["、"],["永久","えいきゅう"],["に"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["と"],["に"],["与えよう","あたえよう"],["。"]]},{"verse":16,"text":"わたしは、あなたの子孫を地のちりのようにならせる。もし人が地のちりを数えることができれば、あなたの子孫をも数えることができよう。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["地","ち"],["の"],["ちり"],["の"],["よう"],["に"],["ならせる"],["。"],["もし"],["人","ひと"],["が"],["地","ち"],["の"],["ちり"],["を"],["数える","かぞえる"],["こと"],["が"],["できれば"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["も"],["数える","かぞえる"],["こと"],["が"],["できよう"],["。"]]},{"verse":17,"text":"立って、その地を縦と横に歩き回りなさい。わたしがあなたに、その地を与えるのだから。」","tok":[["立って","たって"],["、"],["その"],["地","ち"],["を"],["縦","たて"],["と"],["横","よこ"],["に"],["歩き回り","あるきまわり"],["なさい"],["。"],["わたし"],["が"],["あなた"],["に"],["、"],["その"],["地","ち"],["を"],["与える","あたえる"],[
[{"verse":1,"text":"さて、全地は一つのことば、一つの話しことばであった。","tok":[["さて"],["、"],["全地","ぜんち"],["は"],["一","ひと"],["つ"],["の"],["ことば"],["、"],["一","ひと"],["つ"],["の"],["話しことば","はなしことば"],["で"],["あった"],["。"]]},{"verse":2,"text":"そのころ、人々は東のほうから移動して来て、シヌアルの地に平地を見つけ、そこに定住した。","tok":[["その"],["ころ"],["、"],["人々","ひとびと"],["は"],["東","ひがし"],["の"],["ほう"],["から"],["移動","いどう"],["して"],["来て","きて"],["、"],["シヌアル"],["の"],["地","ち"],["に"],["平地","へいち"],["を"],["見つけ","みつけ"],["、"],["そこ"],["に"],["定住","ていじゅう"],["した"],["。"]]},{"verse":3,"text":"彼らは互いに言った。「さあ、れんがを作ってよく焼こう。」彼らは石の代わりにれんがを用い、粘土の代わりに瀝青を用いた。","tok":[["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["れんが"],["を"],["作って","つくって"],["よく"],["焼こう","やこう"],["。"],["」"],["彼","かれ"],["ら"],["は"],["石","いし"],["の"],["代わり","かわり"],["に"],["れんが"],["を"],["用い","もちい"],["、"],["粘土","ねんど"],["の"],["代わり","かわり"],["に"],["瀝青","れきせい"],["を"],["用いた","もちいた"],["。"]]},{"verse":4,"text":"そのうちに彼らは言うようになった。「さあ、われわれは町を建て、頂が天に届く塔を建て、名をあげよう。われわれが全地に散らされるといけないから。」","tok":[["その"],["うち"],["に"],["彼","かれ"],["ら"],["は"],["言う","いう"],["よう"],["に"],["なった"],["。"],["「"],["さあ"],["、"],["われわれ"],["は"],["町","まち"],["を"],["建て","たて"],["、"],["頂","いただき"],["が"],["天","てん"],["に"],["届く","とどく"],["塔","とう"],["を"],["建て","たて"],["、"],["名","な"],["を"],["あげよう"],["。"],["われわれ"],["が"],["全地","ぜんち"],["に"],["散らされる","ちらされる"],["と"],["いけない"],["から"],["。"],["」"]]},{"verse":5,"text":"そのとき主は人間の建てた町と塔をご覧になるために降りて来られた。","tok":[["その"],["とき"],["主","ぬし"],["は"],["人間","にんげん"],["の"],["建てた","たてた"],["町","まち"],["と"],["塔","とう"],["を"],["ご覧","ごらん"],["に"],["なる"],["ため"],["に"],["降りて","おりて"],["来られた","こられた"],["。"]]},{"verse":6,"text":"主は仰せになった。「彼らがみな、一つの民、一つのことばで、このようなことをし始めたのなら、今や彼らがしようと思うことで、とどめられることはない。","tok":[["主","ぬし"],["は"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["彼","かれ"],["ら"],["が"],["みな"],["、"],["一","ひと"],["つ"],["の"],["民","たみ"],["、"],["一","ひと"],["つ"],["の"],["ことば"],["で"],["、"],["この"],["よう"],["な"],["こと"],["を"],["し"],["始めた","はじめた"],["の"],["なら"],["、"],["今","いま"],["や"],["彼","かれ"],["ら"],["が"],["しよう"],["と"],["思う","おもう"],["こと"],["で
[{"verse":1,"text":"さて、アブラハムの時代にあった先のききんとは別に、この国にまたききんがあった。それでイサクはゲラルのペリシテ人の王アビメレクのところへ行った。","tok":[["さて"],["、"],["アブラハム"],["の"],["時代","じだい"],["に"],["あった"],["先","さき"],["の"],["ききん"],["と"],["は"],["別","べつ"],["に"],["、"],["この"],["国","くに"],["に"],["また"],["ききん"],["が"],["あった"],["。"],["それ"],["で"],["イサク"],["は"],["ゲラル"],["の"],["ペリシテ"],["人","にん"],["の"],["王","おう"],["アビメレク"],["の"],["ところ"],["へ"],["行った","いった"],["。"]]},{"verse":2,"text":"主はイサクに現れて仰せられた。「エジプトへは下るな。わたしがあなたに示す地に住みなさい。","tok":[["主","ぬし"],["は"],["イサク"],["に"],["現れて","あらわれて"],["仰せられた","おおせられた"],["。"],["「"],["エジプト"],["へ"],["は"],["下る","くだる"],["な"],["。"],["わたし"],["が"],["あなた"],["に"],["示す","しめす"],["地","ち"],["に"],["住み","すみ"],["なさい"],["。"]]},{"verse":3,"text":"あなたはこの地に、滞在しなさい。わたしはあなたとともにいて、あなたを祝福しよう。それはわたしが、これらの国々をすべて、あなたとあなたの子孫に与えるからだ。こうしてわたしは、あなたの父アブラハムに誓った誓いを果たすのだ。","tok":[["あなた"],["は"],["この"],["地","ち"],["に"],["、"],["滞在","たいざい"],["し"],["なさい"],["。"],["わたし"],["は"],["あなた"],["と"],["とも"],["に"],["いて"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["しよう"],["。"],["それ"],["は"],["わたし"],["が"],["、"],["これ"],["ら"],["の"],["国々","くにぐに"],["を"],["すべて"],["、"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["に"],["与える","あたえる"],["から"],["だ"],["。"],["こう"],["して"],["わたし"],["は"],["、"],["あなた"],["の"],["父","ちち"],["アブラハム"],["に"],["誓った","ちかった"],["誓い","ちかい"],["を"],["果たす","はたす"],["の"],["だ"],["。"]]},{"verse":4,"text":"そしてわたしは、あなたの子孫を空の星のように増し加え、あなたの子孫に、これらの国々をみな与えよう。こうして地のすべての国々は、あなたの子孫によって祝福される。","tok":[["そして"],["わたし"],["は"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["空","そら"],["の"],["星","ほし"],["の"],["よう"],["に"],["増し加え","ましくわえ"],["、"],["あなた"],["の"],["子孫","しそん"],["に"],["、"],["これ"],["ら"],["の"],["国々","くにぐに"],["を"],["みな"],["与えよう","あたえよう"],["。"],["こう"],["して"],["地","ち"],["の"],["すべて"],["の"],["国々","くにぐに"],["は"],["、"],["あなた"],["の"],["子孫","しそん"],["によって"],["祝福","しゅくふく"],["される"],["。"]]},{"verse":5,"text":"これはアブラハムがわたしの声に聞き従い、わたしの戒めと命令とおきてとおしえを守ったからである。」","tok":[["これ"],["は"],["アブラハム"],["が"],["わたし"],["の"],["声","こえ"],["に"],["聞き従い","ききしたがい"],["、"],["わたし"],["の"],["戒め","いましめ"],["と"],["命令","めいれい"],["と"],["おきて"],["と"],["おしえ"],["を"],["守った","まもった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":6,"text":"イサクがゲラルに住んでいるとき、","tok":[["イサク"],["が"],["ゲラル"],["に"],["住んで","すんで"],["いる"],["とき"],["、"]]},{"verse":7,"text":"その土地の人々が彼の妻のことを尋ねた。すると彼は、「あれは私の妻です」と言うのを恐れて、「あれは私の妹です」と答えた。リベカが美しかったので、リベカのことでこの土地の人々が自分を殺しはしないかと思ったからである。","tok":[["その"],["土地","とち"],["の"],["人々","ひとびと"],["が"],["彼","かれ"],["の"],["妻","つま"],["の"],["こと"],["を"],["尋ねた","たずねた"],["。"],["する"],["と"],["彼","かれ"],["は"],["、"],["「"],["あれ"],["は"],["私","わたくし"],["の"],["妻","つま"],["です"],["」"],["と"],["言う","いう"],["の"],["を"],["恐れて","おそれて"],["、"],["「"],["あれ"],["は"],["私","わたくし"],["の"],["妹","いもうと"],["です"],["」"],["と"],["答えた","こたえた"],["。"],["リベカ"],["が"],["美しかった","うつくしかった"],["ので"],["、"],["リベカ"],["の"],["こと"],["で"],["この"],["土地","とち"],["の"],["人々","ひとびと"],["が"],["自分","じぶん"],["を"],["殺し","ころし"],["は"],["しない"],["か"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"イサクがそこに滞在して、かなりたったある日、ペリシテ人の王アビメレクが窓から見おろしていると、なんと、イサクがその妻のリベカを愛撫しているのが見えた。","tok":[["イサク"],["が"],["そこ"],["に"],["滞在","たいざい"],["して"],["、"],["かなり"],["たった"],["ある"],["日","ひ"],["、"],["ペリシテ"],["人","にん"],["の"],["王","おう"],["アビメレク"],["が"],["窓","まど"],["から"],["見おろして","みおろして"],["いる"],["と"],["、"],["なん"],["と"],["、"],["イサク"],["が"],["その"],["妻","つま"],["の"],["リベカ"],["を"],["愛撫","あいぶ"],["して"],["いる"],["の"],["が"],["見えた","みえた"],["。"]]},{"verse":9,"text":"それでアビメレクはイサクを呼び寄せて言った。「確かに、あの女はあなたの妻だ。なぜあなたは『あれは私の妹です』と言ったのだ。」それでイサクは、「彼女のことで殺されはしないかと思ったからです」と答えた。","tok":[["それ"],["で"],["アビメレク"],["は"],["イサク"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["確か","たしか"],["に"],["、"],["あの"],["女","おんな"],["は"],["あなた"],["の"],["妻","つま"],["だ"],["。"],["なぜ"],["あなた"],["は"],["『"],["あれ"],["は"],["私","わたくし"],["の"],["妹","いもうと"],["です"],["』"],["と"],["言った","いった"],["の"],["だ"],["。"],["」"],["それ"],["で"],["イサク"],["は"],["、"],["「"],["彼女","かのじょ"],["の"],["こと"],["で"],["殺され","ころされ"],["は"],["しない"],["か"],["と"],["思った","おもった"],["から"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":10,"text":"アビメレクは言った。「何ということをしてくれたのだ。もう少しで、民のひとりがあなたの妻と寝て、あなたはわれわれに罪を負わせるところだった。」","tok":[["アビメレク"],["は"],["言った","いった"],["。"],["「"],["何","なん"],["と"],["いう"],["こと"],["を"],["して"],["くれた"],["の"],["だ"],["。"],["もう"],["少し","すこし"],["で"],["、"],["民","みん"],["の"],["ひとり"],["が"],["あなた"],["の"],["妻","つま"],["と"],["寝て","ねて"],["、"],["あなた"],["は"],["われわれ"],["に"],["罪","つみ"],["を"],["負わせる","おわせる"],["ところ"],["だった"],["。"],["」"]]},{"verse":11,"text":"そこでアビメレクはすべての民に命じて言った。「この人と、この人の妻に触れる者は、必ず殺される。」","tok":[["そこ"],["で"],["アビメレク"],["は"],["すべて"],["の"],["民","たみ"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["この"],["人","ひと"],["と"],["、"],["この"],["人","ひと"],["の"],["妻","つま"],["に"],["触れる","ふれる"],["者","もの"],["は"],["、"],["必ず","かならず"],["殺される","ころされる"],["。"],["」"]]},{"verse":12,"text":"イサクはその地に種を蒔き、その年に百倍の収穫を見た。主が彼を祝福してくださったのである。","tok":[["イサク"],["は"],["その"],["地","ち"],["に"],["種","しゅ"],["を"],["蒔き","まき"],["、"],["その"],["年","とし"],["に"],["百","ひゃく"],["倍","ばい"],["の"],["収穫","しゅうかく"],["を"],["見た","みた"],["。"],["主","ぬし"],["が"],["彼","かれ"],["を"],["祝福","しゅくふく"],["して"],["くださった"],["ので"],["ある"],["。"]]},{"verse":13,"text":"こうして、この人は富み、ますます栄えて、非常に裕福になった。","tok":[["こう"],["して"],["、"],["この"],["人","ひと"],["は"],["富み","とみ"],["、"],["ますます"],["栄えて","さかえて"],["、"],["非常","ひじょう"],["に"],["裕福","ゆうふく"],["に"],["なった"],["。"]]},{"verse":14,"text":"彼が羊の群れや、牛の群れ、それに多くのしもべたちを持つようになったので、ペリシテ人は彼をねたんだ。","tok":[["彼","かれ"],["が"],["羊","ひつじ"],["の"],["群れ","むれ"],["や"],["、"],["牛","うし"],["の"],["群れ","むれ"],["、"],["それ"],["に"],["多く","おおく"],["の"],["しもべ"],["たち"],["を"],["持つ","もつ"],["よう"],["に"],["なった"],["ので"],["、"],["ペリシテ"],["人","にん"],["は"],["彼","かれ"],["を"],["ねたんだ"],["。"]]},{"verse":15,"text":"それでペリシテ人は、イサクの父アブラハムの時代に、父のしもべたちが掘ったすべての井戸に土を満たしてこれをふさいだ。","tok":[["それ"],["で"],["ペリシテ"],["人","にん"],["は"],["、"],["イサク"],["の"],["父","ちち"],["アブラハム"],["の"],["時代","じだい"],["に"],["、"],["父","ちち"],["の"],["しもべ"],["たち"],["が"],["掘った","ほった"],["すべて"],["の"],["井戸","いど"],["に"],["土","つち"],["を"],["満たして","みたして"],["これ"],["を"],["ふさいだ"],["。"]]},{"verse":16,"text":"そうしてアビメレクはイサクに言った。「あなたは、われわれよりはるかに強くなったから、われわれのところから出て行ってくれ。」","tok":[["そう"],["して"],["アビメレク"],["は"],["イサク"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["われわれ"],["より"],["はるか"],["に"],["強く","つよく"],["なった"],["から"],["、"],["われわれ"],["の"],["ところ"],["から"],["出て","でて"],["行って","いって"],["くれ"],["。"],["」"]]},{"verse":17,"text":"イサクはそこを去って、ゲラルの谷間に天幕を張り、そこに住んだ。","tok":[["イサク"],["は"],["そこ"],["を"],["去って","さって"],["、"],["ゲラル"],["の"],["谷間","たにま"],["に"],["天幕","てんまく"],["を"],["張り","はり"],["、"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":18,"text":"イサクは、彼の父アブラハムの時代に掘ってあった井戸を、再び掘った。それらはペリシテ人がアブラハムの死後、ふさいでいたものである。イサクは、父がそれらにつけていた名と同じ名をそれらにつけた。","tok":[["イサク"],["は"],["、"],["彼","かれ"],["の"],["父","ちち"],["アブラハム"],["の"],["時代","じだい"],["に"],["掘って","ほって"],["あった"],["井戸","いど"],["を"],["、"],["再び","ふたたび"],["掘った","ほった"],["。"],["それ"],["ら"],["は"],["ペリシテ"],["人","にん"],["が"],["アブラハム"],["の"],["死後","しご"],["、"],["ふさいで"],["いた"],["もの"],["で"],["ある"],["。"],["イサク"],["は"],["、"],["父","ちち"],["が"],["それ"],["ら"],["に"],["つけて"],["いた"],["名","な"],["と"],["同じ","おなじ"],["名","な"],["を"],["それ"],["ら"],["に"],["つけた"],["。"]]},{"verse":19,"text":"イサクのしもべたちが谷間を掘っているとき、そこに湧き水の出る井戸を見つけた。","tok":[["イサク"],["の"],["しもべ"],["たち"],["が"],["谷間","たにま"],["を"],["掘って","ほって"],["いる"],["とき"],["、"],["そこ"],["に"],["湧き水","わきみず"],["の"],["出る","でる"],["井戸","いど"],["を"],["見つけた","みつけた"],["。"]]},{"verse":20,"text":"ところが、ゲラルの羊飼いたちは「この水はわれわれのものだ」と言って、イサクの羊飼いたちと争った。それで、イサクはその井戸の名をエセクと呼んだ。それは彼らがイサクと争ったからである。","tok":[["ところ"],["が"],["、"],["ゲラル"],["の"],["羊飼い","ひつじかい"],["たち"],["は"],["「"],["この"],["水","みず"],["は"],["われわれ"],["の"],["もの"],["だ"],["」"],["と"],["言って","いって"],["、"],["イサク"],["の"],["羊飼い","ひつじかい"],["たち"],["と"],["争った","あらそった"],["。"],["それ"],["で"],["、"],["イサク"],["は"],["その"],["井戸","いど"],["の"],["名","な"],["を"],["エセク"],["と"],["呼んだ","よんだ"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["イサク"],["と"],["争った","あらそった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"しもべたちは、もう一つの井戸を掘った。ところが、それについても彼らが争ったので、その名をシテナと呼んだ。","tok":[["しもべ"],["たち"],["は"],["、"],["もう"],["一","ひと"],["つ"],["の"],["井戸","いど"],["を"],["掘った","ほった"],["。"],["ところ"],["が"],["、"],["それ"],["について"],["も"],["彼","かれ"],["ら"],["が"],["争った","あらそった"],["ので"],["、"],["その"],["名","な"],["を"],["シテナ"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":22,"text":"イサクはそこから移って、ほかの井戸を掘った。その井戸については争いがなかったので、その名をレホボテと呼んだ。そして彼は言った。「今や、主は私たちに広い所を与えて、私たちがこの地でふえるようにしてくださった。」","tok":[["イサク"],["は"],["そこ"],["から"],["移って","うつって"],["、"],["ほか"],["の"],["井戸","いど"],["を"],["掘った","ほった"],["。"],["その"],["井戸","いど"],["について"],["は"],["争い","あらそい"],["が"],["なかった"],["ので"],["、"],["その"],["名","な"],["を"],["レホボテ"],["と"],["呼んだ","よんだ"],["。"],["そして"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["今","いま"],["や"],["、"],["主","ぬし"],["は"],["私たち","わたしたち"],["に"],["広い","ひろい"],["所","ところ"],["を"],["与えて","あたえて"],["、"],["私たち","わたしたち"],["が"],["この"],["地","ち"],["で"],["ふえる"],["よう"],["に"],["して"],["くださった"],["。"],["」"]]},{"verse":23,"text":"彼はそこからベエル・シェバに上った。","tok":[["彼","かれ"],["は"],["そこ"],["から"],["ベエル"],["・"],["シェバ"],["に"],["上った","のぼった"],["。"]]},{"verse":24,"text":"主はその夜、彼に現れて仰せられた。「わたしはあなたの父アブラハムの神である。恐れてはならない。わたしがあなたとともにいる。わたしはあなたを祝福し、あなたの子孫を増し加えよう。わたしのしもべアブラハムのゆえに。」","tok":[["主","ぬし"],["は"],["その"],["夜","よる"],["、"],["彼","かれ"],["に"],["現れて","あらわれて"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["あなた"],["の"],["父","ちち"],["アブラハム"],["の"],["神","かみ"],["で"],["ある"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["が"],["あなた"],["と"],["とも"],["に"],["いる"],["。"],["わたし"],["は"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["増し加えよう","ましくわえよう"],["。"],["わたし"],["の"],["しもべ"],["アブラハム"],["の"],["ゆえ"],["に"],["。"],["」"]]},{"verse":25,"text":"イサクはそこに祭壇を築き、主の御名によって祈った。彼はそこに天幕を張り、イサクのしもべらは、そこに井戸を掘った。","tok":[["イサク"],["は"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["祈った","いのった"],["。"],["彼","かれ"],["は"],["そこ"],["に"],["天幕","てんまく"],["を"],["張り","はり"],["、"],["イサク"],["の"],["しもべ"],["ら"],["は"],["、"],["そこ"],["に"],["井戸","いど"],["を"],["掘った","ほった"],["。"]]},{"verse":26,"text":"そのころ、アビメレクは友人のアフザテとその将軍ピコルと、ゲラルからイサクのところにやって来た。","tok":[["その"],["ころ"],["、"],["アビメレク"],["は"],["友人","ゆうじん"],["の"],["アフザテ"],["と"],["その"],["将軍","しょうぐん"],["ピコル"],["と"],["、"],["ゲラル"],["から"],["イサク"],["の"],["ところ"],["に"],["やって"],["来た","きた"],["。"]]},{"verse":27,"text":"イサクは彼らに言った。「なぜ、あなたがたは私のところに来たのですか。あなたがたは私を憎んで、あなたがたのところから私を追い出したのに。」","tok":[["イサク"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["あなた"],["がた"],["は"],["私","わたくし"],["の"],["ところ"],["に"],["来た","きた"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["は"],["私","わたくし"],["を"],["憎んで","にくんで"],["、"],["あなた"],["がた"],["の"],["ところ"],["から"],["私","わたくし"],["を"],["追い出した","おいだした"],["のに"],["。"],["」"]]},{"verse":28,"text":"それで彼らは言った。「私たちは、主があなたとともにおられることを、はっきり見たのです。それで私たちは申し出をします。どうか、私たちの間で、すなわち、私たちとあなたとの間で誓いを立ててください。あなたと契約を結びたいのです。","tok":[["それ"],["で"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["主","ぬし"],["が"],["あなた"],["と"],["とも"],["に"],["おられる"],["こと"],["を"],["、"],["はっきり"],["見た","みた"],["の"],["です"],["。"],["それ"],["で"],["私たち","わたしたち"],["は"],["申し出","もうしで"],["を"],["します"],["。"],["どう"],["か"],["、"],["私たち","わたしたち"],["の"],["間","あいだ"],["で"],["、"],["すなわち"],["、"],["私たち","わたしたち"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["で"],["誓い","ちかい"],["を"],["立てて","たてて"],["ください"],["。"],["あなた"],["と"],["契約","けいやく"],["を"],["結びたい","むすびたい"],["の"],["です"],["。"]]},{"verse":29,"text":"それは、私たちがあなたに手出しをせず、ただ、あなたに良いことだけをして、平和のうちにあなたを送り出したように、あなたも私たちに害を加えないということです。あなたは今、主に祝福されています。」","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["が"],["あなた"],["に"],["手出し","てだし"],["を"],["せず"],["、"],["ただ"],["、"],["あなた"],["に"],["良い","よい"],["こと"],["だけ"],["を"],["して"],["、"],["平和","へいわ"],["の"],["うち"],["に"],["あなた"],["を"],["送り出した","おくりだした"],["よう"],["に"],["、"],["あなた"],["も"],["私たち","わたしたち"],["に"],["害","がい"],["を"],["加えない","くわえない"],["と"],["いう"],["こと"],["です"],["。"],["あなた"],["は"],["今","いま"],["、"],["主に","おもに"],["祝福","しゅくふく"],["されて"],["います"],["。"],["」"]]},{"verse":30,"text":"そこでイサクは彼らのために宴会を催し、彼らは飲んだり、食べたりした。","tok":[["そこ"],["で"],["イサク"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["宴会","えんかい"],["を"],["催し","もよおし"],["、"],["彼","かれ"],["ら"],["は"],["飲ん","のん"],["だり"],["、"],["食べ","たべ"],["たり"],["した"],["。"]]},{"verse":31,"text":"翌朝早く、彼らは互いに契約を結んだ。イサクは彼らを送り出し、彼らは平和のうちに彼のところから去って行った。","tok":[["翌朝","よくあさ"],["早く","はやく"],["、"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"],["イサク"],["は"],["彼","かれ"],["ら"],["を"],["送り出し","おくりだし"],["、"],["彼","かれ"],["ら"],["は"],["平和","へいわ"],["の"],["うち"],["に"],["彼","かれ"],["の"],["ところ"],["から"],["去って","さって"],["行った","いった"],["。"]]},{"verse":32,"text":"ちょうどその日、イサクのしもべたちが帰って来て、彼らが掘り当てた井戸のことについて彼に告げて言った。「私どもは水を見つけました。」","tok":[["ちょうど"],["その"],["日","ひ"],["、"],["イサク"],["の"],["しもべ"],["たち"],["が"],["帰って","かえって"],["来て","きて"],["、"],["彼","かれ"],["ら"],["が"],["掘り当てた","ほりあてた"],["井戸","いど"],["の"],["こと"],["について"],["彼","かれ"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["私","わたくし"],["ども"],["は"],["水","みず"],["を"],["見つけました","みつけました"],["。"],["」"]]},{"verse":33,"text":"そこで彼は、その井戸をシブアと呼んだ。それゆえ、その町の名は、今日に至るまで、ベエル・シェバという。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["、"],["その"],["井戸","いど"],["を"],["シブア"],["と"],["呼んだ","よんだ"],["。"],["それ"],["ゆえ"],["、"],["その"],["町","まち"],["の"],["名","な"],["は"],["、"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["ベエル"],["・"],["シェバ"],["と"],["いう"],["。"]]},{"verse":34,"text":"エサウは四十歳になって、ヘテ人ベエリの娘エフディテとヘテ人エロンの娘バセマテとを妻にめとった。","tok":[["エサウ"],["は"],["四十歳","よんじゅうさい"],["に"],["なって"],["、"],["ヘテ人","へてにん"],["ベエリ"],["の"],["娘","むすめ"],["エフディテ"],["と"],["ヘテ人","へてにん"],["エロン"],["の"],["娘","むすめ"],["バセマテ"],["と"],["を"],["妻","つま"],["に"],["めとった"],["。"]]},{"verse":35,"text":"彼女たちはイサクとリベカにとって悩みの種となった。","tok":[["彼女","かのじょ"],["たち"],["は"],["イサク"],["と"],["リベカ"],["にとって"],["悩み","なやみ"],["の"],["種","しゅ"],["と"],["なった"],["。"]]}]
[{"verse":1,"text":"さて、神である主が造られたあらゆる野の獣のうちで、蛇が一番狡猾であった。蛇は女に言った。「あなたがたは、園のどんな木からも食べてはならない、と神は、ほんとうに言われたのですか。」","tok":[["さて"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["造られた","つくられた"],["あらゆる"],["野","の"],["の"],["獣","けもの"],["の"],["うち"],["で"],["、"],["蛇","へび"],["が"],["一番","いちばん"],["狡猾","こうかつ"],["で"],["あった"],["。"],["蛇","へび"],["は"],["女","おんな"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["園","その"],["の"],["どんな"],["木","き"],["から"],["も"],["食べて","たべて"],["は"],["ならない"],["、"],["と"],["神","かみ"],["は"],["、"],["ほんとう"],["に"],["言われた","いわれた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":2,"text":"女は蛇に言った。「私たちは、園にある木の実を食べてよいのです。","tok":[["女","おんな"],["は"],["蛇","へび"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["園","その"],["に"],["ある"],["木の実","このみ"],["を"],["食べて","たべて"],["よい"],["の"],["です"],["。"]]},{"verse":3,"text":"しかし、園の中央にある木の実について、神は、『あなたがたは、それを食べてはならない。それに触れてもいけない。あなたがたが死ぬといけないからだ』と仰せになりました。」","tok":[["しかし"],["、"],["園","その"],["の"],["中央","ちゅうおう"],["に"],["ある"],["木の実","このみ"],["について"],["、"],["神","かみ"],["は"],["、"],["『"],["あなた"],["がた"],["は"],["、"],["それ"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["それ"],["に"],["触れて","ふれて"],["も"],["いけない"],["。"],["あなた"],["がた"],["が"],["死ぬ","しぬ"],["と"],["いけない"],["から"],["だ"],["』"],["と"],["仰せ","おおせ"],["に"],["なりました"],["。"],["」"]]},{"verse":4,"text":"そこで、蛇は女に言った。「あなたがたは決して死にません。","tok":[["そこ"],["で"],["、"],["蛇","へび"],["は"],["女","おんな"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["決して","けっして"],["死にません","しにません"],["。"]]},{"verse":5,"text":"あなたがたがそれを食べるその時、あなたがたの目が開け、あなたがたが神のようになり、善悪を知るようになることを神は知っているのです。」","tok":[["あなた"],["がた"],["が"],["それ"],["を"],["食べる","たべる"],["その"],["時","とき"],["、"],["あなた"],["がた"],["の"],["目","め"],["が"],["開け","あけ"],["、"],["あなた"],["がた"],["が"],["神","かみ"],["の"],["よう"],["に"],["なり"],["、"],["善悪","ぜんあく"],["を"],["知る","しる"],["よう"],["に"],["なる"],["こと"],["を"],["神","かみ"],["は"],["知って","しって"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":6,"text":"そこで女が見ると、その木は、まことに食べるのに良く、目に慕わしく、賢くするというその木はいかにも好ましかった。それで女はその実を取って食べ、いっしょにいた夫にも与えたので、夫も食べた。","tok":[["そこ"],["で"],["女","おんな"],["が"],["見る","みる"],["と"],["、"],["その"],["木","き"],["は"],["、"],["まこと"],["に"],["食べる","たべる"],["のに"],["良く","よく"],["、"],["目","め"],["に"],["慕わしく","したわしく"],["、"],["賢く","かしこく"],["する"],["と"],["いう"],["その"],["木","き"],["は"],["いかに"],["も"],["好ましかった","このましかった"],["。"],["それ"],["で"],["女","おんな"],["は"],["その"],["実","じつ"],["を"],["取って","とって"],["食べ","たべ"],["、"],["いっしょ"],["に"],["いた"],["夫","おっと"],["に"],["も"],["与えた","あたえた"],["ので"],["、"],["夫","おっと"],["も"],["食べた","たべた"],["。"]]},{"verse":7,"text":"このようにして、ふたりの目は開かれ、それで彼らは自分たちが裸であることを知った。そこで、彼らは、いちじくの葉をつづり合わせて、自分たちの腰のおおいを作った。","tok":[["この"],["よう"],["に"],["して"],["、"],["ふたり"],["の"],["目","め"],["は"],["開かれ","ひらかれ"],["、"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["が"],["裸","はだか"],["で"],["ある"],["こと"],["を"],["知った","しった"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["、"],["いちじく"],["の"],["葉","は"],["を"],["つづり合わせて","つづりあわせて"],["、"],["自分","じぶん"],["たち"],["の"],["腰","こし"],["の"],["おおい"],["を"],["作った","つくった"],["。"]]},{"verse":8,"text":"そよ風の吹くころ、彼らは園を歩き回られる神である主の声を聞いた。それで人とその妻は、神である主の御顔を避けて園の木の間に身を隠した。","tok":[["そよ風","そよかぜ"],["の"],["吹く","ふく"],["ころ"],["、"],["彼","かれ"],["ら"],["は"],["園","その"],["を"],["歩き回られる","あるきまわられる"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["それ"],["で"],["人","ひと"],["と"],["その"],["妻","つま"],["は"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御顔","おかお"],["を"],["避けて","さけて"],["園","その"],["の"],["木の間","このま"],["に"],["身","み"],["を"],["隠した","かくした"],["。"]]},{"verse":9,"text":"神である主は、人に呼びかけ、彼に仰せられた。「あなたは、どこにいるのか。」","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["人","ひと"],["に"],["呼びかけ","よびかけ"],["、"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["」"]]},{"verse":10,"text":"彼は答えた。「私は園で、あなたの声を聞きました。それで私は裸なので、恐れて、隠れました。」","tok":[["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["園","その"],["で"],["、"],["あなた"],["の"],["声","こえ"],["を"],["聞きました","ききました"],["。"],["それ"],["で"],["私","わたくし"],["は"],["裸","はだか"],["な"],["ので"],["、"],["恐れて","おそれて"],["、"],["隠れました","かくれました"],["。"],["」"]]},{"verse":11,"text":"すると、仰せになった。「あなたが裸であるのを、だれがあなたに教えたのか。あなたは、食べてはならない、と命じておいた木から食べたのか。」","tok":[["する"],["と"],["、"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["あなた"],["が"],["裸","はだか"],["で"],["ある"],["の"],["を"],["、"],["だれ"],["が"],["あなた"],["に"],["教えた","おしえた"],["の"],["か"],["。"],["あなた"],["は"],["、"],["食べて","たべて"],["は"],["ならない"],["、"],["と"],["命じて","めいじて"],["おいた"],["木","き"],["から"],["食べた","たべた"],["の"],["か"],["。"],["」"]]},{"verse":12,"text":"人は言った。「あなたが私のそばに置かれたこの女が、あの木から取って私にくれたので、私は食べたのです。」","tok":[["人","ひと"],["は"],["言った","いった"],["。"],["「"],["あなた"],["が"],["私","わたくし"],["の"],["そば"],["に"],["置かれた","おかれた"],["この"],["女","おんな"],["が"],["、"],["あの"],["木","き"],["から"],["取って","とって"],["私","わたくし"],["に"],["くれた"],["ので"],["、"],["私","わたくし"],["は"],["食べた","たべた"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"そこで、神である主は女に仰せられた。「あなたは、いったいなんということをしたのか。」女は答えた。「蛇が私を惑わしたのです。それで私は食べたのです。」","tok":[["そこ"],["で"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["女","おんな"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["いったい"],["なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["か"],["。"],["」"],["女","おんな"],["は"],["答えた","こたえた"],["。"],["「"],["蛇","へび"],["が"],["私","わたくし"],["を"],["惑わした","まどわした"],["の"],["です"],["。"],["それ"],["で"],["私","わたくし"],["は"],["食べた","たべた"],["の"],["です"],["。"],["」"]]},{"verse":14,"text":"神である主は蛇に仰せられた。「おまえが、こんな事をしたので、おまえは、あらゆる家畜、あらゆる野の獣よりものろわれる。おまえは、一生、腹ばいで歩き、ちりを食べなければならない。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["蛇","へび"],["に"],["仰せられた","おおせられた"],["。"],["「"],["おまえ"],["が"],["、"],["こんな"],["事","こと"],["を"],["した"],["ので"],["、"],["おまえ"],["は"],["、"],["あらゆる"],["家畜","かちく"],["、"],["あらゆる"],["野","の"],["の"],["獣","けもの"],["より"],["も"],["のろわれる"],["。"],["おまえ"],["は"],["、"],["一生","いっしょう"],["、"],["腹ばい","はらばい"],["で"],["歩き","あるき"],["、"],["ちり"],["を"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":15,"text":"わたしは、おまえと女との間に、また、おまえの子孫と女の子孫との間に、敵意を置く。彼は、おまえの頭を踏み砕き、おまえは、彼のかかとにかみつく。」","tok":[["わたし"],["は"],["、"],["おまえ"],["と"],["女","おんな"],["と"],["の"],["間","あいだ"],["に"],["、"],["また"],["、"],["おまえ"],["の"],["子孫","しそん"],["と"],["女","おんな"],["の"],["子孫","しそん"],["と"],["の"],["間","あいだ"],["に"],["、"],["敵意","てきい"],["を"],["置く","おく"],["。"],["彼","かれ"],["は"],["、"],["おまえ"],["の"],["頭","あたま"],["を"],["踏み砕き","ふみくだき"],["、"],["おまえ"],["は"],["、"],["彼","かれ"],["の"],["かかと"],["に"],["かみつく"],["。"],["」"]]},{"verse":16,"text":"女にはこう仰せられた。「わたしは、あなたのうめきと苦しみを大いに増す。あなたは、苦しんで子を産まなければならない。しかも、あなたは夫を恋い慕うが、彼は、あなたを支配することになる。」","tok":[["女","おんな"],["に"],["は"],["こう"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["の"],["うめき"],["と"],["苦しみ","くるしみ"],["を"],["大いに","おおいに"],["増す","ます"],["。"],["あなた"],["は"],["、"],["苦しんで","くるしんで"],["子","こ"],["を"],["産まなければ","うまなければ"],["ならない"],["。"],["しかも"],["、"],["あなた"],["は"],["夫","おっと"],["を"],["恋い慕う","こいしたう"],["が"],["、"],["彼","かれ"],["は"],["、"],["あなた"],["を"],["支配","しはい"],["する"],["こと"],["に"],["なる"],["。"],["」"]]},{"verse":17,"text":"また、人に仰せられた。「あなたが、妻の声に聞き従い、食べてはならないとわたしが命じておいた木から食べたので、土地は、あなたのゆえにのろわれてしまった。あなたは、一生、苦しんで食を得なければならない。","tok":[["また"],["、"],["人","ひと"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["が"],["、"],["妻","つま"],["の"],["声","こえ"],["に"],["聞き従い","ききしたがい"],["、"],["食べて","たべて"],["は"],["ならない"],["と"],["わたし"],["が"],["命じて","めいじて"],["おいた"],["木","き"],["から"],["食べた","たべた"],["ので"],["、"],["土地","とち"],["は"],["、"],["あなた"],["の"],["ゆえ"],["に"],["のろわれて"],["しまった"],["。"],["あなた"],["は"],["、"],["一生","いっしょう"],["、"],["苦しんで","くるしんで"],["食","しょく"],["を"],["得なければ","えなければ"],["ならない"],["。"]]},{"verse":18,"text":"土地は、あなたのために、いばらとあざみを生えさせ、あなたは、野の草を食べなければならない。","tok":[["土地","とち"],["は"],["、"],["あなた"],["の"],["ため"],["に"],["、"],["いばら"],["と"],["あざみ"],["を"],["生えさせ","はえさせ"],["、"],["あなた"],["は"],["、"],["野","の"],["の"],["草","くさ"],["を"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":19,"text":"あなたは、顔に汗を流して糧を得、ついに、あなたは土に帰る。あなたはそこから取られたのだから。あなたはちりだから、ちりに帰らなければならない。」","tok":[["あなた"],["は"],["、"],["顔","かお"],["に"],["汗","あせ"],["を"],["流して","ながして"],["糧","かて"],["を"],["得","え"],["、"],["ついに"],["、"],["あなた"],["は"],["土","つち"],["に"],["帰る","かえる"],["。"],["あなた"],["は"],["そこ"],["から"],["取られた","とられた"],["の"],["だ"],["から"],["。"],["あなた"],["は"],["ちり"],["だ"],["から"],["、"],["ちり"],["に"],["帰らなければ","かえらなければ"],["ならない"],["。"],["」"]]},{"verse":20,"text":"さて、人は、その妻の名をエバと呼んだ。それは、彼女がすべて生きているものの母であったからである。","tok":[["さて"],["、"],["人","ひと"],["は"],["、"],["その"],["妻","つま"],["の"],["名","な"],["を"],["エバ"],["と"],["呼んだ","よんだ"],["。"],["それ"],["は"],["、"],["彼女","かのじょ"],["が"],["すべて"],["生きて","いきて"],["いる"],["もの"],["の"],["母","はは"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"神である主は、アダムとその妻のために、皮の衣を作り、彼らに着せてくださった。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["アダム"],["と"],["その"],["妻","つま"],["の"],["ため"],["に"],["、"],["皮","かわ"],["の"],["衣","ころも"],["を"],["作り","つくり"],["、"],["彼","かれ"],["ら"],["に"],["着せて","きせて"],["くださった"],["。"]]},{"verse":22,"text":"神である主は仰せられた。「見よ。人はわれわれのひとりのようになり、善悪を知るようになった。今、彼が、手を伸ばし、いのちの木からも取って食べ、永遠に生きないように。」","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["見","み"],["よ"],["。"],["人","ひと"],["は"],["われわれ"],["の"],["ひとり"],["の"],["よう"],["に"],["なり"],["、"],["善悪","ぜんあく"],["を"],["知る","しる"],["よう"],["に"],["なった"],["。"],["今","いま"],["、"],["彼","かれ"],["が"],["、"],["手","て"],["を"],["伸ばし","のばし"],["、"],["いのち"],["の"],["木","き"],["から"],["も"],["取って","とって"],["食べ","たべ"],["、"],["永遠","えいえん"],["に"],["生きない","いきない"],["よう"],["に"],["。"],["」"]]},{"verse":23,"text":"そこで神である主は、人をエデンの園から追い出されたので、人は自分がそこから取り出された土を耕すようになった。","tok":[["そこ"],["で"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["人","ひと"],["を"],["エデン"],["の"],["園","その"],["から"],["追い出された","おいだされた"],["ので"],["、"],["人","ひと"],["は"],["自分","じぶん"],["が"],["そこ"],["から"],["取り出された","とりだされた"],["土","つち"],["を"],["耕す","たがやす"],["よう"],["に"],["なった"],["。"]]},{"verse":24,"text":"こうして、神は人を追放して、いのちの木への道を守るために、エデンの園の東に、ケルビムと輪を描いて回る炎の剣を置かれた。","tok":[["こう"],["して"],["、"],["神","かみ"],["は"],["人","ひと"],["を"],["追放","ついほう"],["して"],["、"],["いのち"],["の"],["木","き"],["へ"],["の"],["道","みち"],["を"],["守る","まもる"],["ため"],["に"],["、"],["エデン"],["の"],["園","その"],["の"],["東","ひがし"],["に"],["、"],["ケルビム"],["と"],["輪","わ"],["を"],["描いて","えがいて"],["回る","まわる"],["炎","ほのお"],["の"],["剣","けん"],["を"],["置かれた","おかれた"],["。"]]}]
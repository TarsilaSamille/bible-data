[{"verse":1,"text":"神はヤコブに仰せられた。「立ってベテルに上り、そこに住みなさい。そしてそこに、あなたが兄エサウからのがれていたとき、あなたに現れた神のために祭壇を築きなさい。」","tok":[["神","かみ"],["は"],["ヤコブ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["立って","たって"],["ベテル"],["に"],["上り","のぼり"],["、"],["そこ"],["に"],["住み","すみ"],["なさい"],["。"],["そして"],["そこ"],["に"],["、"],["あなた"],["が"],["兄","あに"],["エサウ"],["から"],["のがれて"],["いた"],["とき"],["、"],["あなた"],["に"],["現れた","あらわれた"],["神","かみ"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["なさい"],["。"],["」"]]},{"verse":2,"text":"それでヤコブは自分の家族と、自分といっしょにいるすべての者とに言った。「あなたがたの中にある異国の神々を取り除き、身をきよめ、着物を着替えなさい。","tok":[["それ"],["で"],["ヤコブ"],["は"],["自分","じぶん"],["の"],["家族","かぞく"],["と"],["、"],["自分","じぶん"],["と"],["いっしょ"],["に"],["いる"],["すべて"],["の"],["者","もの"],["と"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["中","なか"],["に"],["ある"],["異国","いこく"],["の"],["神々","かみがみ"],["を"],["取り除き","とりのぞき"],["、"],["身","み"],["を"],["きよめ"],["、"],["着物","きもの"],["を"],["着替え","きがえ"],["なさい"],["。"]]},{"verse":3,"text":"そうして私たちは立って、ベテルに上って行こう。私はそこで、私の苦難の日に私に答え、私の歩いた道に、いつも私とともにおられた神に祭壇を築こう。」","tok":[["そう"],["して"],["私たち","わたしたち"],["は"],["立って","たって"],["、"],["ベテル"],["に"],["上って","のぼって"],["行こう","いこう"],["。"],["私","わたくし"],["は"],["そこ"],["で"],["、"],["私","わたくし"],["の"],["苦難","くなん"],["の"],["日","ひ"],["に"],["私","わたくし"],["に"],["答え","こたえ"],["、"],["私","わたくし"],["の"],["歩いた","あるいた"],["道","みち"],["に"],["、"],["いつも"],["私","わたくし"],["と"],["とも"],["に"],["おられた"],["神","かみ"],["に"],["祭壇","さいだん"],["を"],["築こう","きずこう"],["。"],["」"]]},{"verse":4,"text":"彼らは手にしていたすべての異国の神々と、耳につけていた耳輪とをヤコブに渡した。それでヤコブはそれらをシェケムの近くにある樫の木の下に隠した。","tok":[["彼","かれ"],["ら"],["は"],["手","て"],["に"],["して"],["いた"],["すべて"],["の"],["異国","いこく"],["の"],["神々","かみがみ"],["と"],["、"],["耳","みみ"],["に"],["つけて"],["いた"],["耳輪","みみわ"],["と"],["を"],["ヤコブ"],["に"],["渡した","わたした"],["。"],["それ"],["で"],["ヤコブ"],["は"],["それ"],["ら"],["を"],["シェケム"],["の"],["近く","ちかく"],["に"],["ある"],["樫","かし"],["の"],["木","き"],["の"],["下","した"],["に"],["隠した","かくした"],["。"]]},{"verse":5,"text":"彼らが旅立つと、神からの恐怖が回りの町々に下ったので、彼らはヤコブの子らのあとを追わなかった。","tok":[["彼","かれ"],["ら"],["が"],["旅立つ","たびだつ"],["と"],["、"],["神","かみ"],["から"],["の"],["恐怖","きょうふ"],["が"],["回り","まわり"],["の"],["町々","まちまち"],["に"],["下った","くだった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ヤコブ"],["の"],["子","こ"],["ら"],["の"],["あと"],["を"],["追わなかった","おわなかった"],["。"]]},{"verse":6,"text":"ヤコブは、自分とともにいたすべての人々といっしょに、カナンの地にあるルズ、すなわち、ベテルに来た。","tok":[["ヤコブ"],["は"],["、"],["自分","じぶん"],["と"],["とも"],["に"],["いた"],["すべて"],["の"],["人々","ひとびと"],["と"],["いっしょ"],["に"],["、"],["カナン"],["の"],["地","ち"],["に"],["ある"],["ルズ"],["、"],["すなわち"],["、"],["ベテル"],["に"],["来た","きた"],["。"]]},{"verse":7,"text":"ヤコブはそこに祭壇を築き、その場所をエル・ベテルと呼んだ。それはヤコブが兄からのがれていたとき、神がそこで彼に現れたからである。","tok":[["ヤコブ"],["は"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["その"],["場所","ばしょ"],["を"],["エル"],["・"],["ベテル"],["と"],["呼んだ","よんだ"],["。"],["それ"],["は"],["ヤコブ"],["が"],["兄","あに"],["から"],["のがれて"],["いた"],["とき"],["、"],["神","かみ"],["が"],["そこ"],["で"],["彼","かれ"],["に"],["現れた","あらわれた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"リベカのうばデボラは死に、ベテルの下手にある樫の木の下に葬られた。それでその木の名はアロン・バクテと呼ばれた。","tok":[["リベカ"],["の"],["うば"],["デボラ"],["は"],["死に","しに"],["、"],["ベテル"],["の"],["下手","へた"],["に"],["ある"],["樫","かし"],["の"],["木","き"],["の"],["下","した"],["に"],["葬られた","ほうむられた"],["。"],["それ"],["で"],["その"],["木","き"],["の"],["名","な"],["は"],["アロン"],["・"],["バクテ"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":9,"text":"こうしてヤコブがパダン・アラムから帰って来たとき、神は再び彼に現れ、彼を祝福された。","tok":[["こう"],["して"],["ヤコブ"],["が"],["パダン"],["・"],["アラム"],["から"],["帰って","かえって"],["来た","きた"],["とき"],["、"],["神","かみ"],["は"],["再び","ふたたび"],["彼","かれ"],["に"],["現れ","あらわれ"],["、"],["彼","かれ"],["を"],["祝福","しゅくふく"],["された"],["。"]]},{"verse":10,"text":"神は彼に仰せられた。「あなたの名はヤコブであるが、あなたの名は、もう、ヤコブと呼んではならない。あなたの名はイスラエルでなければならない。」それで彼は自分の名をイスラエルと呼んだ。","tok":[["神","かみ"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["名","な"],["は"],["ヤコブ"],["で"],["ある"],["が"],["、"],["あなた"],["の"],["名","な"],["は"],["、"],["もう"],["、"],["ヤコブ"],["と"],["呼んで","よんで"],["は"],["ならない"],["。"],["あなた"],["の"],["名","な"],["は"],["イスラエル"],["で"],["なければ"],["ならない"],["。"],["」"],["それ"],["で"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["名","な"],["を"],["イスラエル"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":11,"text":"神はまた彼に仰せられた。「わたしは全能の神である。生めよ。ふえよ。一つの国民、諸国の民のつどいが、あなたから出て、王たちがあなたの腰から出る。","tok":[["神","かみ"],["は"],["また"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["わたし"],["は"],["全能","ぜんのう"],["の"],["神","かみ"],["で"],["ある"],["。"],["生め","うめ"],["よ"],["。"],["ふえ"],["よ"],["。"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["つどい"],["が"],["、"],["あなた"],["から"],["出て","でて"],["、"],["王","おう"],["たち"],["が"],["あなた"],["の"],["腰","こし"],["から"],["出る","でる"],["。"]]},{"verse":12,"text":"わたしはアブラハムとイサクに与えた地を、あなたに与え、あなたの後の子孫にもその地を与えよう。」","tok":[["わたし"],["は"],["アブラハム"],["と"],["イサク"],["に"],["与えた","あたえた"],["地","ち"],["を"],["、"],["あなた"],["に"],["与え","あたえ"],["、"],["あなた"],["の"],["後","あと"],["の"],["子孫","しそん"],["に"],["も"],["その"],["地","ち"],["を"],["与えよう","あたえよう"],["。"],["」"]]},{"verse":13,"text":"神は彼に語られたその所で、彼を離れて上られた。","tok":[["神","かみ"],["は"],["彼","かれ"],["に"],["語られた","かたられた"],["その"],["所","ところ"],["で"],["、"],["彼","かれ"],["を"],["離れて","はなれて"],["上られた","のぼられた"],["。"]]},{"verse":14,"text":"ヤコブは、神が彼に語られたその場所に柱、すなわち、石の柱を立て、その上に注ぎのぶどう酒を注ぎ、またその上に油をそそいだ。","tok":[["ヤコブ"],["は"],["、"],["神","かみ"],["が"],["彼","かれ"],["に"],["語られた","かたられた"],["その"],["場所","ばしょ"],["に"],["柱","はしら"],["、"],["すなわち"],["、"],["石","いし"],["の"],["柱","はしら"],["を"],["立て","たて"],["、"],["その"],["上","うえ"],["に"],["注ぎ","そそぎ"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注ぎ","そそぎ"],["、"],["また"],["その"],["上","うえ"],["に"],["油","あぶら"],["を"],["そそいだ"],["。"]]},{"verse":15,"text":"ヤコブは、神が自分と語られたその所をベテルと名づけた。","tok":[["ヤコブ"],["は"],["、"],["神","かみ"],["が"],["自分","じぶん"],["と"],["語られた","かたられた"],["その"],["所","ところ"],["を"],["ベテル"],["と"],["名づけた","なづけた"],["。"]]},{"verse":16,"text":"彼らがベテルを旅立って、エフラテまで行くにはまだかなりの道のりがあるとき、ラケルは産気づいて、ひどい陣痛で苦しんだ。","tok":[["彼","かれ"],["ら"],["が"],["ベテル"],["を"],["旅立って","たびだって"],["、"],["エフラテ"],["まで"],["行く","いく"],["に"],["は"],["まだか"],["なり"],["の"],["道のり","みちのり"],["が"],["ある"],["とき"],["、"],["ラケル"],["は"],["産気","さんけ"],["づいて"],["、"],["ひどい"],["陣痛","じんつう"],["で"],["苦しんだ","くるしんだ"],["。"]]},{"verse":17,"text":"彼女がひどい陣痛で苦しんでいるとき、助産婦は彼女に、「心配なさるな。今度も男のお子さんです」と告げた。","tok":[["彼女","かのじょ"],["が"],["ひどい"],["陣痛","じんつう"],["で"],["苦しんで","くるしんで"],["いる"],["とき"],["、"],["助産婦","じょさんぷ"],["は"],["彼女","かのじょ"],["に"],["、"],["「"],["心配","しんぱい"],["なさる"],["な"],["。"],["今度","こんど"],["も"],["男","おとこ"],["の"],["お子さん","おこさん"],["です"],["」"],["と"],["告げた","つげた"],["。"]]},{"verse":18,"text":"彼女が死に臨み、そのたましいが離れ去ろうとするとき、彼女はその子の名をベン・オニと呼んだ。しかし、その子の父はベニヤミンと名づけた。","tok":[["彼女","かのじょ"],["が"],["死","し"],["に"],["臨み","のぞみ"],["、"],["その"],["たましい"],["が"],["離れ去ろう","はなれさろう"],["と"],["する"],["とき"],["、"],["彼女","かのじょ"],["は"],["その"],["子","こ"],["の"],["名","な"],["を"],["ベン"],["・"],["オニ"],["と"],["呼んだ","よんだ"],["。"],["しかし"],["、"],["その"],["子","こ"],["の"],["父","ちち"],["は"],["ベニヤミン"],["と"],["名づけた","なづけた"],["。"]]},{"verse":19,"text":"こうしてラケルは死んだ。彼女はエフラテ、今日のベツレヘムへの道に葬られた。","tok":[["こう"],["して"],["ラケル"],["は"],["死んだ","しんだ"],["。"],["彼女","かのじょ"],["は"],["エフラテ"],["、"],["今日","きょう"],["の"],["ベツレヘム"],["へ"],["の"],["道","みち"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":20,"text":"ヤコブは彼女の墓の上に石の柱を立てた。それはラケルの墓の石の柱として今日に至っている。","tok":[["ヤコブ"],["は"],["彼女","かのじょ"],["の"],["墓","はか"],["の"],["上","うえ"],["に"],["石","いし"],["の"],["柱","はしら"],["を"],["立てた","たてた"],["。"],["それ"],["は"],["ラケル"],["の"],["墓","はか"],["の"],["石","いし"],["の"],["柱","はしら"],["として"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":21,"text":"イスラエルは旅を続け、ミグダル・エデルのかなたに天幕を張った。","tok":[["イスラエル"],["は"],["旅","たび"],["を"],["続け","つづけ"],["、"],["ミグダル"],["・"],["エデル"],["の"],["かなた"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["。"]]},{"verse":22,"text":"イスラエルがその地に住んでいたころ、ルベンは父のそばめビルハのところに行って、これと寝た。イスラエルはこのことを聞いた。さて、ヤコブの子は十二人であった。","tok":[["イスラエル"],["が"],["その"],["地","ち"],["に"],["住んで","すんで"],["いた"],["ころ"],["、"],["ルベン"],["は"],["父","ちち"],["の"],["そばめ"],["ビルハ"],["の"],["ところ"],["に"],["行って","いって"],["、"],["これ"],["と"],["寝た","ねた"],["。"],["イスラエル"],["は"],["この"],["こと"],["を"],["聞いた","きいた"],["。"],["さて"],["、"],["ヤコブ"],["の"],["子","こ"],["は"],["十二人","じゅうににん"],["で"],["あった"],["。"]]},{"verse":23,"text":"レアの子はヤコブの長
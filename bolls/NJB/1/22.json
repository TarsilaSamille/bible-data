[{"verse":1,"text":"これらの出来事の後、神はアブラハムを試練に会わせられた。神は彼に、「アブラハムよ」と呼びかけられると、彼は、「はい。ここにおります」と答えた。","tok":[["これ"],["ら"],["の"],["出来事","できごと"],["の"],["後","あと"],["、"],["神","かみ"],["は"],["アブラハム"],["を"],["試練","しれん"],["に"],["会わせられた","あわせられた"],["。"],["神","かみ"],["は"],["彼","かれ"],["に"],["、"],["「"],["アブラハム"],["よ"],["」"],["と"],["呼びかけられる","よびかけられる"],["と"],["、"],["彼","かれ"],["は"],["、"],["「"],["はい"],["。"],["ここ"],["に"],["おります"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":2,"text":"神は仰せられた。「あなたの子、あなたの愛しているひとり子イサクを連れて、モリヤの地に行きなさい。そしてわたしがあなたに示す一つの山の上で、全焼のいけにえとしてイサクをわたしにささげなさい。」","tok":[["神","かみ"],["は"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["子","こ"],["、"],["あなた"],["の"],["愛して","あいして"],["いる"],["ひとり"],["子","こ"],["イサク"],["を"],["連れて","つれて"],["、"],["モリヤ"],["の"],["地","ち"],["に"],["行き","いき"],["なさい"],["。"],["そして"],["わたし"],["が"],["あなた"],["に"],["示す","しめす"],["一","ひと"],["つ"],["の"],["山","やま"],["の"],["上","うえ"],["で"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["イサク"],["を"],["わたし"],["に"],["ささげ"],["なさい"],["。"],["」"]]},{"verse":3,"text":"翌朝早く、アブラハムはろばに鞍をつけ、ふたりの若い者と息子イサクとをいっしょに連れて行った。彼は全焼のいけにえのためのたきぎを割った。こうして彼は、神がお告げになった場所へ出かけて行った。","tok":[["翌朝","よくあさ"],["早く","はやく"],["、"],["アブラハム"],["は"],["ろば"],["に"],["鞍","くら"],["を"],["つけ"],["、"],["ふたり"],["の"],["若い","わかい"],["者","もの"],["と"],["息子","むすこ"],["イサク"],["と"],["を"],["いっしょ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["彼","かれ"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["ため"],["の"],["たきぎ"],["を"],["割った","わった"],["。"],["こう"],["して"],["彼","かれ"],["は"],["、"],["神","かみ"],["が"],["お告げ","おつげ"],["に"],["なった"],["場所","ばしょ"],["へ"],["出かけて","でかけて"],["行った","いった"],["。"]]},{"verse":4,"text":"三日目に、アブラハムが目を上げると、その場所がはるかかなたに見えた。","tok":[["三日目","みっかめ"],["に"],["、"],["アブラハム"],["が"],["目","め"],["を"],["上げる","あげる"],["と"],["、"],["その"],["場所","ばしょ"],["が"],["はるか"],["かなた"],["に"],["見えた","みえた"],["。"]]},{"verse":5,"text":"それでアブラハムは若い者たちに、「あなたがたは、ろばといっしょに、ここに残っていなさい。私と子どもとはあそこに行き、礼拝をして、あなたがたのところに戻って来る」と言った。","tok":[["それ"],["で"],["アブラハム"],["は"],["若い","わかい"],["者","もの"],["たち"],["に"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["ろば"],["と"],["いっしょ"],["に"],["、"],["ここ"],["に"],["残って","のこって"],["い"],["なさい"],["。"],["私","わたくし"],["と"],["子ども","こども"],["と"],["は"],["あそこ"],["に"],["行き","いき"],["、"],["礼拝","れいはい"],["を"],["して"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["戻って","もどって"],["来る","くる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"アブラハムは全焼のいけにえのためのたきぎを取り、それをその子イサクに負わせ、火と刀とを自分の手に取り、ふたりはいっしょに進んで行った。","tok":[["アブラハム"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["ため"],["の"],["たきぎ"],["を"],["取り","とり"],["、"],["それ"],["を"],["その"],["子","こ"],["イサク"],["に"],["負わせ","おわせ"],["、"],["火","ひ"],["と"],["刀","かたな"],["と"],["を"],["自分","じぶん"],["の"],["手","て"],["に"],["取り","とり"],["、"],["ふたり"],["は"],["いっしょ"],["に"],["進んで","すすんで"],["行った","いった"],["。"]]},{"verse":7,"text":"イサクは父アブラハムに話しかけて言った。「お父さん。」すると彼は、「何だ。イサク」と答えた。イサクは尋ねた。「火とたきぎはありますが、全焼のいけにえのための羊は、どこにあるのですか。」","tok":[["イサク"],["は"],["父","ちち"],["アブラハム"],["に"],["話しかけて","はなしかけて"],["言った","いった"],["。"],["「"],["お父さん","おとうさん"],["。"],["」"],["する"],["と"],["彼","かれ"],["は"],["、"],["「"],["何","なん"],["だ"],["。"],["イサク"],["」"],["と"],["答えた","こたえた"],["。"],["イサク"],["は"],["尋ねた","たずねた"],["。"],["「"],["火","ひ"],["と"],["たきぎ"],["は"],["あります"],["が"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["ため"],["の"],["羊","ひつじ"],["は"],["、"],["どこ"],["に"],["ある"],["の"],["です"],["か"],["。"],["」"]]},{"verse":8,"text":"アブラハムは答えた。「イサク。神ご自身が全焼のいけにえの羊を備えてくださるのだ。」こうしてふたりはいっしょに歩き続けた。","tok":[["アブラハム"],["は"],["答えた","こたえた"],["。"],["「"],["イサク"],["。"],["神","かみ"],["ご自身","ごじしん"],["が"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["羊","ひつじ"],["を"],["備えて","そなえて"],["くださる"],["の"],["だ"],["。"],["」"],["こう"],["して"],["ふたり"],["は"],["いっしょ"],["に"],["歩き","あるき"],["続けた","つづけた"],["。"]]},{"verse":9,"text":"ふたりは神がアブラハムに告げられた場所に着き、アブラハムはその所に祭壇を築いた。そうしてたきぎを並べ、自分の子イサクを縛り、祭壇の上のたきぎの上に置いた。","tok":[["ふたり"],["は"],["神","かみ"],["が"],["アブラハム"],["に"],["告げられた","つげられた"],["場所","ばしょ"],["に"],["着き","つき"],["、"],["アブラハム"],["は"],["その"],["所","ところ"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"],["そう"],["して"],["たきぎ"],["を"],["並べ","ならべ"],["、"],["自分","じぶん"],["の"],["子","こ"],["イサク"],["を"],["縛り","しばり"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["の"],["たきぎ"],["の"],["上","うえ"],["に"],["置いた","おいた"],["。"]]},{"verse":10,"text":"アブラハムは手を伸ばし、刀を取って自分の子をほふろうとした。","tok":[["アブラハム"],["は"],["手","て"],["を"],["伸ばし","のばし"],["、"],["刀","かたな"],["を"],["取って","とって"],["自分","じぶん"],["の"],["子","こ"],["を"],["ほふろう"],["と"],["した"],["。"]]},{"verse":11,"text":"そのとき、主の使いが天から彼を呼び、「アブラハム。アブラハム」と仰せられた。彼は答えた。「はい。ここにおります。」","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["天","てん"],["から"],["彼","かれ"],["を"],["呼び","よび"],["、"],["「"],["アブラハム"],["。"],["アブラハム"],["」"],["と"],["仰せられた","おおせられた"],["。"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["はい"],["。"],["ここ"],["に"],["おります"],["。"],["」"]]},{"verse":12,"text":"御使いは仰せられた。「あなたの手を、その子に下してはならない。その子に何もしてはならない。今、わたしは、あなたが神を恐れることがよくわかった。あなたは、自分の子、自分のひとり子さえ惜しまないでわたしにささげた。」","tok":[["御使い","おつかい"],["は"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["の"],["手","て"],["を"],["、"],["その"],["子","こ"],["に"],["下して","くだして"],["は"],["ならない"],["。"],["その"],["子","こ"],["に"],["何","なん"],["も"],["して"],["は"],["ならない"],["。"],["今","いま"],["、"],["わたし"],["は"],["、"],["あなた"],["が"],["神","かみ"],["を"],["恐れる","おそれる"],["こと"],["が"],["よく"],["わかった"],["。"],["あなた"],["は"],["、"],["自分","じぶん"],["の"],["子","こ"],["、"],["自分","じぶん"],["の"],["ひとり"],["子","こ"],["さえ"],["惜しまないで","おしまないで"],["わたし"],["に"],["ささげた"],["。"],["」"]]},{"verse":13,"text":"アブラハムが目を上げて見ると、見よ、角をやぶにひっかけている一頭の雄羊がいた。アブラハムは行って、その雄羊を取り、それを自分の子の代わりに、全焼のいけにえとしてささげた。","tok":[["アブラハム"],["が"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["角","かど"],["を"],["やぶ"],["に"],["ひっかけて"],["いる"],["一頭","いちとう"],["の"],["雄羊","おひつじ"],["が"],["いた"],["。"],["アブラハム"],["は"],["行って","いって"],["、"],["その"],["雄羊","おひつじ"],["を"],["取り","とり"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["子","こ"],["の"],["代わり","かわり"],["に"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["ささげた"],["。"]]},{"verse":14,"text":"そうしてアブラハムは、その場所を、アドナイ・イルエと名づけた。今日でも、「主の山の上には備えがある」と言い伝えられている。","tok":[["そう"],["して"],["アブラハム"],["は"],["、"],["その"],["場所","ばしょ"],["を"],["、"],["アドナイ"],["・"],["イルエ"],[
[{"verse":1,"text":"アブラハムは年を重ねて、老人になっていた。主は、あらゆる面でアブラハムを祝福しておられた。","tok":[["アブラハム"],["は"],["年","とし"],["を"],["重ねて","かさねて"],["、"],["老人","ろうじん"],["に"],["なって"],["いた"],["。"],["主","ぬし"],["は"],["、"],["あらゆる"],["面","めん"],["で"],["アブラハム"],["を"],["祝福","しゅくふく"],["して"],["おられた"],["。"]]},{"verse":2,"text":"そのころ、アブラハムは、自分の全財産を管理している家の最年長のしもべに、こう言った。「あなたの手を私のももの下に入れてくれ。","tok":[["その"],["ころ"],["、"],["アブラハム"],["は"],["、"],["自分","じぶん"],["の"],["全","ぜん"],["財産","ざいさん"],["を"],["管理","かんり"],["して"],["いる"],["家","いえ"],["の"],["最年長","さいねんちょう"],["の"],["しもべ"],["に"],["、"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["の"],["手","て"],["を"],["私","わたくし"],["の"],["もも"],["の"],["下","した"],["に"],["入れて","いれて"],["くれ"],["。"]]},{"verse":3,"text":"私はあなたに、天の神、地の神である主にかけて誓わせる。私がいっしょに住んでいるカナン人の娘の中から、私の息子の妻をめとってはならない。","tok":[["私","わたくし"],["は"],["あなた"],["に"],["、"],["天","てん"],["の"],["神","かみ"],["、"],["地","ち"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["に"],["かけて"],["誓わせる","ちかわせる"],["。"],["私","わたくし"],["が"],["いっしょ"],["に"],["住んで","すんで"],["いる"],["カナン人","かなんにん"],["の"],["娘","むすめ"],["の"],["中","なか"],["から"],["、"],["私","わたくし"],["の"],["息子","むすこ"],["の"],["妻","つま"],["を"],["めとって"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたは私の生まれ故郷に行き、私の息子イサクのために妻を迎えなさい。」","tok":[["あなた"],["は"],["私","わたくし"],["の"],["生まれ","うまれ"],["故郷","こきょう"],["に"],["行き","いき"],["、"],["私","わたくし"],["の"],["息子","むすこ"],["イサク"],["の"],["ため"],["に"],["妻","つま"],["を"],["迎え","むかえ"],["なさい"],["。"],["」"]]},{"verse":5,"text":"しもべは彼に言った。「もしかして、その女の人が、私についてこの国へ来ようとしない場合、お子を、あなたの出身地へ連れ戻さなければなりませんか。」","tok":[["しもべ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["もし"],["か"],["して"],["、"],["その"],["女","おんな"],["の"],["人","ひと"],["が"],["、"],["私","わたくし"],["について"],["この"],["国","くに"],["へ"],["来よう","こよう"],["と"],["しない"],["場合","ばあい"],["、"],["お子","おこ"],["を"],["、"],["あなた"],["の"],["出身地","しゅっしんち"],["へ"],["連れ戻さなければ","つれもどさなければ"],["なりません"],["か"],["。"],["」"]]},{"verse":6,"text":"アブラハムは彼に言った。「私の息子をあそこへ連れ帰らないように気をつけなさい。","tok":[["アブラハム"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["息子","むすこ"],["を"],["あそこ"],["へ"],["連れ帰らない","つれかえらない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":7,"text":"私を、私の父の家、私の生まれ故郷から連れ出し、私に誓って、『あなたの子孫にこの地を与える』と約束して仰せられた天の神、主は、御使いをあなたの前に遣わされる。あなたは、あそこで私の息子のために妻を迎えなさい。","tok":[["私","わたくし"],["を"],["、"],["私","わたくし"],["の"],["父","ちち"],["の"],["家","いえ"],["、"],["私","わたくし"],["の"],["生まれ","うまれ"],["故郷","こきょう"],["から"],["連れ出し","つれだし"],["、"],["私","わたくし"],["に"],["誓って","ちかって"],["、"],["『"],["あなた"],["の"],["子孫","しそん"],["に"],["この"],["地","ち"],["を"],["与える","あたえる"],["』"],["と"],["約束","やくそく"],["して"],["仰せられた","おおせられた"],["天","てん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["御使い","おつかい"],["を"],["あなた"],["の"],["前","まえ"],["に"],["遣わされる","つかわされる"],["。"],["あなた"],["は"],["、"],["あそこ"],["で"],["私","わたくし"],["の"],["息子","むすこ"],["の"],["ため"],["に"],["妻","つま"],["を"],["迎え","むかえ"],["なさい"],["。"]]},{"verse":8,"text":"もし、その女があなたについて来ようとしないなら、あなたはこの私との誓いから解かれる。ただし、私の息子をあそこへ連れ帰ってはならない。」","tok":[["もし"],["、"],["その"],["女","おんな"],["が"],["あなた"],["について"],["来よう","こよう"],["と"],["しないなら"],["、"],["あなた"],["は"],["この"],["私","わたくし"],["と"],["の"],["誓い","ちかい"],["から"],["解かれる","とかれる"],["。"],["ただし"],["、"],["私","わたくし"],["の"],["息子","むすこ"],["を"],["あそこ"],["へ"],["連れ帰って","つれかえって"],["は"],["ならない"],["。"],["」"]]},{"verse":9,"text":"それでしもべは、その手を主人であるアブラハムのももの下に入れ、このことについて彼に誓った。","tok":[["それ"],["で"],["しもべ"],["は"],["、"],["その"],["手","て"],["を"],["主人","しゅじん"],["で"],["ある"],["アブラハム"],["の"],["もも"],["の"],["下","した"],["に"],["入れ","いれ"],["、"],["この"],["こと"],["について"],["彼","かれ"],["に"],["誓った","ちかった"],["。"]]},{"verse":10,"text":"しもべは主人のらくだの中から十頭のらくだを取り、そして出かけた。また主人のあらゆる貴重な品々を持って行った。彼は立ってアラム・ナハライムのナホルの町へ行った。","tok":[["しもべ"],["は"],["主人","しゅじん"],["の"],["らくだ"],["の"],["中","なか"],["から"],["十頭","じゅうとう"],["の"],["らくだ"],["を"],["取り","とり"],["、"],["そして"],["出かけた","でかけた"],["。"],["また"],["主人","しゅじん"],["の"],["あらゆる"],["貴重","きちょう"],["な"],["品々","しなじな"],["を"],["持って","もって"],["行った","いった"],["。"],["彼","かれ"],["は"],["立って","たって"],["アラム"],["・"],["ナハライム"],["の"],["ナホル"],["の"],["町","まち"],["へ"],["行った","いった"],["。"]]},{"verse":11,"text":"彼は夕暮れ時、女たちが水を
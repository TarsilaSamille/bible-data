[{"verse":1,"text":"ヨセフは、そばに立っているすべての人の前で、自分を制することができなくなって、「みなを、私のところから出しなさい」と叫んだ。ヨセフが兄弟たちに自分のことを明かしたとき、彼のそばに立っている者はだれもいなかった。","tok":[["ヨセフ"],["は"],["、"],["そば"],["に"],["立って","たって"],["いる"],["すべて"],["の"],["人","ひと"],["の"],["前","まえ"],["で"],["、"],["自分","じぶん"],["を"],["制する","せいする"],["こと"],["が"],["できなく"],["なって"],["、"],["「"],["みな"],["を"],["、"],["私","わたくし"],["の"],["ところ"],["から"],["出し","だし"],["なさい"],["」"],["と"],["叫んだ","さけんだ"],["。"],["ヨセフ"],["が"],["兄弟","きょうだい"],["たち"],["に"],["自分","じぶん"],["の"],["こと"],["を"],["明かした","あかした"],["とき"],["、"],["彼","かれ"],["の"],["そば"],["に"],["立って","たって"],["いる"],["者","もの"],["は"],["だれ"],["も"],["いなかった"],["。"]]},{"verse":2,"text":"しかし、ヨセフが声をあげて泣いたので、エジプト人はそれを聞き、パロの家の者もそれを聞いた。","tok":[["しかし"],["、"],["ヨセフ"],["が"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["ので"],["、"],["エジプト"],["人","にん"],["は"],["それ"],["を"],["聞き","きき"],["、"],["パロ"],["の"],["家","いえ"],["の"],["者","もの"],["も"],["それ"],["を"],["聞いた","きいた"],["。"]]},{"verse":3,"text":"ヨセフは兄弟たちに言った。「私はヨセフです。父上はお元気ですか。」兄弟たちはヨセフを前にして驚きのあまり、答えることができなかった。","tok":[["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["ヨセフ"],["です"],["。"],["父上","ちちじょう"],["は"],["お元気","おげんき"],["です"],["か"],["。"],["」"],["兄弟","きょうだい"],["たち"],["は"],["ヨセフ"],["を"],["前","まえ"],["に"],["して"],["驚き","おどろき"],["の"],["あまり"],["、"],["答える","こたえる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":4,"text":"ヨセフは兄弟たちに言った。「どうか私に近寄ってください。」彼らが近寄ると、ヨセフは言った。「私はあなたがたがエジプトに売った弟のヨセフです。","tok":[["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["私","わたくし"],["に"],["近寄って","ちかよって"],["ください"],["。"],["」"],["彼","かれ"],["ら"],["が"],["近寄る","ちかよる"],["と"],["、"],["ヨセフ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["あなた"],["がた"],["が"],["エジプト"],["に"],["売った","うった"],["弟","おとうと"],["の"],["ヨセフ"],["です"],["。"]]},{"verse":5,"text":"今、私をここに売ったことで心を痛めたり、怒ったりしてはなりません。神はいのちを救うために、あなたがたより先に、私を遣わしてくださったのです。","tok":[["今","いま"],["、"],["私","わたくし"],["を"],["ここ"],["に"],["売った","うった"],["こと"],["で"],["心","こころ"],["を"],["痛め","いため"],["たり"],["、"],["怒っ","おこっ"],["たり"],["して"],["は"],["なりません"],["。"],["神","かみ"],["は"],["いのち"],["を"],["救う","すくう"],["ため"],["に"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["、"],["私","わたくし"],["を"],["遣わして","つかわして"],["くださった"],["の"],["です"],["。"]]},{"verse":6,"text":"この二年の間、国中にききんがあったが、まだあと五年は耕すことも刈り入れることもないでしょう。","tok":[["この"],["二","に"],["年","ねん"],["の"],["間","あいだ"],["、"],["国中","くにちゅう"],["に"],["ききん"],["が"],["あった"],["が"],["、"],["まだ"],["あと"],["五","ご"],["年","ねん"],["は"],["耕す","たがやす"],["こと"],["も"],["刈り入れる","かりいれる"],["こと"],["も"],["ないでしょう"],["。"]]},{"verse":7,"text":"それで神は私をあなたがたより先にお遣わしになりました。それは、あなたがたのために残りの者をこの地に残し、また、大いなる救いによってあなたがたを生きながらえさせるためだったのです。","tok":[["それ"],["で"],["神","かみ"],["は"],["私","わたくし"],["を"],["あなた"],["が"],["たより"],["先","さき"],["に"],["お遣わし","おつかわし"],["に"],["なりました"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["残り","のこり"],["の"],["者","もの"],["を"],["この"],["地","ち"],["に"],["残し","のこし"],["、"],["また"],["、"],["大いなる","おおいなる"],["救い","すくい"],["によって"],["あなた"],["がた"],["を"],["生きながらえさせる","いきながらえさせる"],["ため"],["だった"],["の"],["です"],["。"]]},{"verse":8,"text":"だから、今、私をここに遣わしたのは、あなたがたではなく、実に、神なのです。神は私をパロには父とし、その全家の主とし、またエジプト全土の統治者とされたのです。","tok":[["だ"],["から"],["、"],["今","いま"],["、"],["私","わたくし"],["を"],["ここ"],["に"],["遣わした","つかわした"],["の"],["は"],["、"],["あなた"],["がた"],["で"],["は"],["なく"],["、"],["実","じつ"],["に"],["、"],["神","かみ"],["な"],["の"],["です"],["。"],["神","かみ"],["は"],["私","わたくし"],["を"],["パロ"],["に"],["は"],["父","ちち"],["と"],["し"],["、"],["その"],["全","ぜん"],["家","いえ"],["の"],["主","ぬし"],["と"],["し"],["、"],["また"],["エジプト"],["全土","ぜんど"],["の"],["統治者","とうちしゃ"],["と"],["された"],["の"],["です"],["。"]]},{"verse":9,"text":"それで、あなたがたは急いで父上のところに上って行き、言ってください。『あなたの子ヨセフがこう言いました。神は私をエジプト全土の主とされました。ためらわずに私のところに下って来てください。","tok":[["それ"],["で"],["、"],["あなた"],["がた"],["は"],["急いで","いそいで"],["父上","ちちじょう"],["の"],["ところ"],["に"],["上って","のぼって"],["行き","いき"],["、"],["言って","いって"],["ください"],["。"],["『"],["あなた"],["の"],["子","こ"],["ヨセフ"],["が"],["こう"],["言いました","いいました"],["。"],["神","かみ"],["は"],["私","わたくし"],["を"],["エジプト"],["全土","ぜんど"],["の"],["主","ぬし"],["と"],["されました"],["。"],["ためらわず"],["に"],["私","わたくし"],["の"],["ところ"],["に"],["下って","くだって"],["来て","きて"],["ください"],["。"]]},{"verse":10,"text":"あなたはゴシェンの地に住み、私の近くにいることになります。あなたも、あなたの子と孫、羊と牛、またあなたのものすべて。","tok":[["あなた"],["は"],["ゴシェン"],["の"],["地","ち"],["に"],["住み","すみ"],["、"],["私","わたくし"],["の"],["近く","ちかく"],["に"],["いる"],["こと"],["に"],["なります"],["。"],["あなた"],["も"],["、"],["あなた"],["の"],["子","こ"],["と"],["孫","まご"],["、"],["羊","ひつじ"],["と"],["牛","うし"],["、"],["また"],["あなた"],["の"],["もの"],["すべて"],["。"]]},{"verse":11,"text":"ききんはあと五年続きますから、あなたも家族も、また、すべてあなたのものが、困ることのないように、私はあなたをそこで養いましょう』と。","tok":[["ききん"],["は"],["あと"],["五","ご"],["年","ねん"],["続きます","つづきます"],["から"],["、"],["あなた"],["も"],["家族","かぞく"],["も"],["、"],["また"],["、"],["すべて"],["あなた"],["の"],["もの"],["が"],["、"],["困る","こまる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["私","わたくし"],["は"],["あなた"],["を"],["そこ"],["で"],["養いましょう","やしないましょう"],["』"],["と"],["。"]]},{"verse":12,"text":"さあ、あなたがたも、私の弟ベニヤミンも自分の目でしかと見てください。あなたがたに話しているのは、この私の口です。","tok":[["さあ"],["、"],["あなた"],["がた"],["も"],["、"],["私","わたくし"],["の"],["弟","おとうと"],["ベニヤミン"],["も"],["自分","じぶん"],["の"],["目","め"],["でし"],["か"],["と"],["見て","みて"],["ください"],["。"],["あなた"],["がた"],["に"],["話して","はなして"],["いる"],["の"],["は"],["、"],["この"],["私","わたくし"],["の"],["口","くち"],["です"],["。"]]},{"verse":13,"text":"あなたがたは、エジプトでの私のすべての栄誉とあなたがたが見たいっさいのこととを私の父上に告げ、急いで私の父上をここにお連れしてください。」","tok":[["あなた"],["がた"],["は"],["、"],["エジプト"],["で"],["の"],["私","わたくし"],["の"],["すべて"],["の"],["栄誉","えいよ"],["と"],["あなた"],["がた"],["が"],["見た","みた"],["いっさい"],["の"],["こと"],["と"],["を"],["私","わたくし"],["の"],["父上","ちちじょう"],["に"],["告げ","つげ"],["、"],["急いで","いそいで"],["私","わたくし"],["の"],["父上","ちちじょう"],["を"],["ここ"],["に"],["お連れ","おつれ"],["して"],["ください"],["。"],["」"]]},{"verse":14,"text":"それから、彼は弟ベニヤミンの首を抱いて泣いた。ベニヤミンも彼の首を抱いて泣いた。","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["弟","おとうと"],["ベニヤミン"],["の"],["首","くび"],["を"],["抱いて","いだいて"],["泣いた","ないた"],["。"],["ベニヤミン"],["も"],["彼","かれ"],["の"],["首","くび"],["を"],["抱いて","いだいて"],["泣いた","ないた"],["。"]]},{"verse":15,"text":"彼はまた、すべての兄弟に口づけし、彼らを抱いて泣いた。そのあとで、兄弟たちは彼と語り合った。","tok":[["彼","かれ"],["は"],["また"],["、"],["すべて"],["の"],["兄弟","きょうだい"],["に"],["口づけ","くちづけ"],["し"],["、"],["彼","かれ"],["ら"],["を"],["抱いて","いだいて"],["泣いた","ないた"],["。"],["その"],["あと"],["で"],["、"],["兄弟","きょうだい"],["たち"],["は"],["彼","かれ"],["と"],["語り合った","かたりあった"],["。"]]},{"verse":16,"text":"ヨセフの兄弟たちが来たという知らせが、パロの家に伝えられると、パロもその家臣たちも喜んだ。","tok":[["ヨセフ"],["の"],["兄弟","きょうだい"],["たち"],["が"],["来た","きた"],["と"],["いう"],["知らせ","しらせ"],["が"],["、"],["パロ"],["の"],["家","いえ"],["に"],["伝えられる","つたえられる"],["と"],["、"],["パロ"],["も"],["その"],["家臣","かしん"],["たち"],["も"],["喜んだ","よろこんだ"],["。"]]},{"verse":17,"text":"パロはヨセフに言った。「あなたの兄弟たちに言いなさい。『こうしなさい。あなたがたの家畜に荷を積んで、すぐカナンの地へ行き、","tok":[["パロ"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["兄弟","きょうだい"],["たち"],["に"],["言い","いい"],["なさい"],["。"],["『"],["こう"],["し"],["なさい"],["。"],["あなた"],["がた"],["の"],["家畜","かちく"],["に"],["荷","に"],["を"],["積んで","つんで"],["、"],["すぐ"],["カナン"],["の"],["地","ち"],["へ"],["行き","いき"],["、"]]},{"verse":18,"text":"あなたがたの父と家族とを連れて、私のもとへ来なさい。私はあなたがたにエジプトの最良の地を与え、地の最も良い物を食べさせる。』","tok":[["あなた"],["がた"],["の"],["父","ちち"],["と"],["家族","かぞく"],["と"],["を"],["連れて","つれて"],["、"],["私","わたくし"],["の"],["もと"],["へ"],["来","き"],["なさい"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["エジプト"],["の"],["最良","さいりょう"],["の"],["地","ち"],["を"],["与え","あたえ"],["、"],["地","ち"],["の"],["最も","もっとも"],["良い","よい"],["物","もの"],["を"],["食べさせる","たべさせる"],["。"],["』"]]},{"verse":19,"text":"あなたは命じなさい。『こうしなさい。子どもたちと妻たちのために、エジプトの地から車を持って行き、あなたがたの父を乗せて来なさい。","tok":[["あなた"],["は"],["命じ","めいじ"],["なさい"],["。"],["『"],["こう"],["し"],["なさい"],["。"],["子ども","こども"],["たち"],["と"],["妻たち","つまたち"],["の"],["ため"],["に"],["、"],["エジプト"],["の"],["地","ち"],["から"],["車","くるま"],["を"],["持って","もって"],["行き","いき"],["、"],["あなた"],["がた"],["の"],["父","ちち"],["を"],["乗せて","のせて"],["来","き"],["なさい"],["。"]]},{"verse":20,"text":"家財に未練を残してはならない。エジプト全土の最良の物は、あなたがたのものだから』と。」","tok":[["家財","かざい"],["に"],["未練","みれん"],["を"],["残して","のこして"],["は"],["ならない"],["。"],["エジプト"],["全土","ぜんど"],["の"],["最良","さいりょう"],["の"],["物","もの"],["は"],["、"],["あなた"],["がた"],["の"],["もの"],["だ"],["から"],["』"],["と"],["。"],["」"]]},{"verse":21,"text":"イスラエルの子らは、そのようにした。ヨセフはパロの命により、彼らに車を与え、また道中のための食糧をも与えた。","tok":[["イスラエル"],["の"],["子","こ"],["ら"],["は"],["、"],["その"],["よう"],["に"],["した"],["。"],["ヨセフ"],["は"],["パロ"],["の"],["命","いのち"],["に"],["より"],["、"],["彼","かれ"],["ら"],["に"],["車","くるま"],["を"],["与え","あたえ"],["、"],["また"],["道中","どうちゅう"],["の"],["ため"],["の"],["食糧","しょくりょう"],["を"],["も"],["与えた","あたえた"],["。"]]},{"verse":22,"text":"彼らすべてにめいめい晴れ着を与えたが、ベニヤミンには銀三百枚と晴れ着五枚とを与えた。","tok":[["彼","かれ"],["ら"],["すべて"],["に"],["めいめい"],["晴れ着","はれぎ"],["を"],["与えた","あたえた"],["が"],["、"],["ベニヤミン"],["に"],["は"],["銀","ぎん"],["三百枚","さんひゃくまい"],["と"],["晴れ着","はれぎ"],["五枚","ごまい"],["と"],["を"],["与えた","あたえた"],["。"]]},{"verse":23,"text":"父には次のような物を贈った。エジプトの最良の物を積んだ十頭のろば、それと穀物とパンと父の道中の食糧とを積んだ十頭の雌ろばであった。","tok":[["父","ちち"],["に"],["は"],["次","つぎ"],["の"],["よう"],["な"],["物","もの"],["を"],["贈った","おくった"],["。"],["エジプト"],["の"],["最良","さいりょう"],["の"],["物","もの"],["を"],["積んだ","つんだ"],["十頭","じゅうとう"],["の"],["ろば"],["、"],["それ"],["と"],["穀物","こくもつ"],["と"],["パン"],["と"],["父","ちち"],["の"],["道中","どうちゅう"],["の"],["食糧","しょくりょう"],["と"],["を"],["積んだ","つんだ"],["十頭","じゅうとう"],["の"],["雌","めす"],["ろば"],["で"],["あった"],["。"]]},{"verse":24,"text":"こうしてヨセフは兄弟たちを送り出し、彼らが出発するとき、彼らに言った。「途中で言い争わないでください。」","tok":[["こう"],["して"],["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["を"],["送り出し","おくりだし"],["、"],["彼","かれ"],["ら"],["が"],["出発","しゅっぱつ"],["する"],["とき"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["途中","とちゅう"],["で"],["言い争わないで","いいあらそわないで"],["ください"],["。"],["」"]]},{"verse":25,"text":"彼らはこうしてエジプトから上って、カナンの地に入り、彼らの父ヤコブのもとへ行った。","tok":[["彼","かれ"],["ら"],["は"],["こう"],["して"],["エジプト"],["から"],["上って","のぼって"],["、"],["カナン"],["の"],["地","ち"],["に"],["入り","はいり"],["、"],["彼","かれ"],["ら"],["の"],["父","ちち"],["ヤコブ"],["の"],["もと"],["へ"],["行った","いった"],["。"]]},{"verse":26,"text":"彼らは父に告げて言った。「ヨセフはまだ生きています。しかもエジプト全土を支配しているのは彼です。」しかし父はぼんやりしていた。彼らを信じることができなかったからである。","tok":[["彼","かれ"],["ら"],["は"],["父","ちち"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["ヨセフ"],["は"],["まだ"],["生きて","いきて"],["います"],["。"],["しかも"],["エジプト"],["全土","ぜんど"],["を"],["支配","しはい"],["して"],["いる"],["の"],["は"],["彼","かれ"],["です"],["。"],["」"],["しかし"],["父","ちち"],["は"],["ぼんやり"],["して"],["いた"],["。"],["彼","かれ"],["ら"],["を"],["信じる","しんじる"],["こと"],["が"],["できなかった"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"彼らはヨセフが話したことを残らず話して聞かせ、彼はヨセフが自分を乗せるために送ってくれた車を見た。すると彼らの父ヤコブは元気づいた。","tok":[["彼","かれ"],["ら"],["は"],["ヨセフ"],["が"],["話した","はなした"],["こと"],["を"],["残らず","のこらず"],["話して","はなして"],["聞かせ","きかせ"],["、"],["彼","かれ"],["は"],["ヨセフ"],["が"],["自分","じぶん"],["を"],["乗せる","のせる"],["ため"],["に"],["送って","おくって"],["くれた"],["車","くるま"],["を"],["見た","みた"],["。"],["する"],["と"],["彼","かれ"],["ら"],["の"],["父","ちち"],["ヤコブ"],["は"],["元気","げんき"],["づいた"],["。"]]},{"verse":28,"text":"イスラエルは言った。「それで十分だ。私の子ヨセフがまだ生きているとは。私は死なないうちに彼に会いに行こう。」","tok":[["イスラエル"],["は"],["言った","いった"],["。"],["「"],["それ"],["で"],["十分","じゅうぶん"],["だ"],["。"],["私","わたくし"],["の"],["子","こ"],["ヨセフ"],["が"],["まだ"],["生きて","いきて"],["いる"],["と"],["は"],["。"],["私","わたくし"],["は"],["死なない","しなない"],["うち"],["に"],["彼","かれ"],["に"],["会い","あい"],["に"],["行こう","いこう"],["。"],["」"]]}]
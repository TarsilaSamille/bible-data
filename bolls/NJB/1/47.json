[{"verse":1,"text":"ヨセフはパロのところに行き、告げて言った。「私の父と兄弟たちと、羊の群れ、牛の群れ、そして彼らのものすべてがカナンの地からまいりました。そして今ゴシェンの地におります。」","tok":[["ヨセフ"],["は"],["パロ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["告げて","つげて"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["と"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["牛","うし"],["の"],["群れ","むれ"],["、"],["そして"],["彼","かれ"],["ら"],["の"],["もの"],["すべて"],["が"],["カナン"],["の"],["地","ち"],["から"],["まいりました"],["。"],["そして"],["今","いま"],["ゴシェン"],["の"],["地","ち"],["に"],["おります"],["。"],["」"]]},{"verse":2,"text":"彼は兄弟の中から五人を連れて、パロに引き合わせた。","tok":[["彼","かれ"],["は"],["兄弟","きょうだい"],["の"],["中","なか"],["から"],["五人","ごにん"],["を"],["連れて","つれて"],["、"],["パロ"],["に"],["引き合わせた","ひきあわせた"],["。"]]},{"verse":3,"text":"パロはヨセフの兄弟たちに尋ねた。「あなたがたの職業は何か。」彼らはパロに答えた。「あなたのしもべどもは羊を飼う者で、私たちも、また私たちの先祖もそうでございます。」","tok":[["パロ"],["は"],["ヨセフ"],["の"],["兄弟","きょうだい"],["たち"],["に"],["尋ねた","たずねた"],["。"],["「"],["あなた"],["がた"],["の"],["職業","しょくぎょう"],["は"],["何","なん"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["パロ"],["に"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["しもべ"],["ども"],["は"],["羊","ひつじ"],["を"],["飼う","かう"],["者","もの"],["で"],["、"],["私たち","わたしたち"],["も"],["、"],["また"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["も"],["そう"],["で"],["ございます"],["。"],["」"]]},{"verse":4,"text":"彼らはまたパロに言った。「この地に寄留しようとして私たちはまいりました。カナンの地はききんが激しくて、しもべどもの羊のための牧草がございませんので。それでどうか、あなたのしもべどもをゴシェンの地に住ませてください。」","tok":[["彼","かれ"],["ら"],["は"],["また"],["パロ"],["に"],["言った","いった"],["。"],["「"],["この"],["地","ち"],["に"],["寄留","きりゅう"],["しよう"],["として"],["私たち","わたしたち"],["は"],["まいりました"],["。"],["カナン"],["の"],["地","ち"],["は"],["ききん"],["が"],["激しくて","はげしくて"],["、"],["しもべ"],["ども"],["の"],["羊","ひつじ"],["の"],["ため"],["の"],["牧草","ぼくそう"],["が"],["ございません"],["ので"],["。"],["それ"],["で"],["どう"],["か"],["、"],["あなた"],["の"],["しもべ"],["ども"],["を"],["ゴシェン"],["の"],["地","ち"],["に"],["住ませて","すませて"],["ください"],["。"],["」"]]},{"verse":5,"text":"その後、パロはヨセフに言った。「あなたの父と兄弟たちとがあなたのところに来た。","tok":[["その"],["後","ご"],["、"],["パロ"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["と"],["が"],["あなた"],["の"],["ところ"],["に"],["来た","きた"],["。"]]},{"verse":6,"text":"エジプトの地はあなたの前にある。最も良い地にあなたの父と兄弟たちとを住ませなさい。彼らはゴシェンの地に住むようにしなさい。もし彼らの中に力のある者がいるのを知っていたら、その者を私の家畜の係長としなさい。」","tok":[["エジプト"],["の"],["地","ち"],["は"],["あなた"],["の"],["前","まえ"],["に"],["ある"],["。"],["最も","もっとも"],["良い","よい"],["地","ち"],["に"],["あなた"],["の"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["と"],["を"],["住ませ","すませ"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["ゴシェン"],["の"],["地","ち"],["に"],["住む","すむ"],["よう"],["に"],["し"],["なさい"],["。"],["もし"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["力","ちから"],["の"],["ある"],["者","もの"],["が"],["いる"],["の"],["を"],["知って","しって"],["いたら"],["、"],["その"],["者","もの"],["を"],["私","わたくし"],["の"],["家畜","かちく"],["の"],["係長","かかりちょう"],["と"],["し"],["なさい"],["。"],["」"]]},{"verse":7,"text":"それから、ヨセフは父ヤコブを連れて来て、パロの前に立たせた。ヤコブはパロにあいさつした。","tok":[["それ"],["から"],["、"],["ヨセフ"],["は"],["父","ちち"],["ヤコブ"],["を"],["連れて","つれて"],["来て","きて"],["、"],["パロ"],["の"],["前","まえ"],["に"],["立たせた","たたせた"],["。"],["ヤコブ"],["は"],["パロ"],["に"],["あいさつ"],["した"],["。"]]},{"verse":8,"text":"パロはヤコブに尋ねた。「あなたの年は、幾つになりますか。」","tok":[["パロ"],["は"],["ヤコブ"],["に"],["尋ねた","たずねた"],["。"],["「"],["あなた"],["の"],["年","とし"],["は"],["、"],["幾つ","いくつ"],["に"],["なります"],["か"],["。"],["」"]]},{"verse":9,"text":"ヤコブはパロに答えた。「私のたどった年月は百三十年です。私の齢の年月はわずかで、ふしあわせで、私の先祖のたどった齢の年月には及びません。」","tok":[["ヤコブ"],["は"],["パロ"],["に"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["の"],["たどった"],["年月","としつき"],["は"],["百三十","ひゃくさんじゅう"],["年","ねん"],["です"],["。"],["私","わたくし"],["の"],["齢","とし"],["の"],["年月","としつき"],["は"],["わずか"],["で"],["、"],["ふしあわせ"],["で"],["、"],["私","わたくし"],["の"],["先祖","せんぞ"],["の"],["たどった"],["齢","とし"],["の"],["年月","としつき"],["に"],["は"],["及びません","およびません"],["。"],["」"]]},{"verse":10,"text":"ヤコブはパロにあいさつして、パロの前を立ち去った。","tok":[["ヤコブ"],["は"],["パロ"],["に"],["あいさつ"],["して"],["、"],["パロ"],["の"],["前","まえ"],["を"],["立ち去った","たちさった"],["。"]]},{"verse":11,"text":"ヨセフは、パロの命じたとおりに、彼の父と兄弟たちを住ませ、彼らにエジプトの地で最も良い地、ラメセスの地を所有として与えた。","tok":[["ヨセフ"],["は"],["、"],["パロ"],["の"],["命じた","めいじた"],["とおり"],["に"],["、"],["彼","かれ"],["の"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["を"],["住ませ","すませ"],["、"],["彼","かれ"],["ら"],["に"],["エジプト"],["の"],["地","ち"],["で"],["最も","もっとも"],["良い","よい"],["地","ち"],["、"],["ラメセス"],["の"],["地","ち"],["を"],["所有","しょゆう"],["として"],["与えた","あたえた"],["。"]]},{"verse":12,"text":"またヨセフは父や兄弟たちや父の全家族、幼い子どもに至るまで、食物を与えて養った。","tok":[["また"],["ヨセフ"],["は"],["父","ちち"],["や"],["兄弟","きょうだい"],["たち"],["や"],["父","ちち"],["の"],["全","ぜん"],["家族","かぞく"],["、"],["幼い","おさない"],["子ども","こども"],["に"],["至る","いたる"],["まで"],["、"],["食物","しょくもつ"],["を"],["与えて","あたえて"],["養った","やしなった"],["。"]]},{"verse":13,"text":"ききんが非常に激しかったので、全地に食物がなく、エジプトの地もカナンの地もききんのために衰え果てた。","tok":[["ききん"],["が"],["非常","ひじょう"],["に"],["激しかった","はげしかった"],["ので"],["、"],["全地","ぜんち"],["に"],["食物","しょくもつ"],["が"],["なく"],["、"],["エジプト"],["の"],["地","ち"],["も"],["カナン"],["の"],["地","ち"],["も"],["ききん"],["の"],["ため"],["に"],["衰え","おとろえ"],["果てた","はてた"],["。"]]},{"verse":14,"text":"それで、ヨセフはエジプトの地とカナンの地にあったすべての銀を集めた。それは人々が買った穀物の代金であるが、ヨセフはその銀をパロの家に納めた。","tok":[["それ"],["で"],["、"],["ヨセフ"],["は"],["エジプト"],["の"],["地","ち"],["と"],["カナン"],["の"],["地","ち"],["に"],["あった"],["すべて"],["の"],["銀","ぎん"],["を"],["集めた","あつめた"],["。"],["それ"],["は"],["人々","ひとびと"],["が"],["買った","かった"],["穀物","こくもつ"],["の"],["代金","だいきん"],["で"],["ある"],["が"],["、"],["ヨセフ"],["は"],["その"],["銀","ぎん"],["を"],["パロ"],["の"],["家","いえ"],["に"],["納めた","おさめた"],["。"]]},{"verse":15,"text":"エジプトの地とカナンの地に銀が尽きたとき、エジプト人がみなヨセフのところに来て言った。「私たちに食物を下さい。銀が尽きたからといって、どうして私たちがあなたさまの前に死んでよいでしょう。」","tok":[["エジプト"],["の"],["地","ち"],["と"],["カナン"],["の"],["地","ち"],["に"],["銀","ぎん"],["が"],["尽きた","つきた"],["とき"],["、"],["エジプト"],["人","にん"],["が"],["みな"],["ヨセフ"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["に"],["食物","しょくもつ"],["を"],["下さい","ください"],["。"],["銀","ぎん"],["が"],["尽きた","つきた"],["から"],["と"],["いって"],["、"],["どう"],["して"],["私たち","わたしたち"],["が"],["あなた"],["さま"],["の"],["前","まえ"],["に"],["死んで","しんで"],["よいでしょう"],["。"],["」"]]},{"verse":16,"text":"ヨセフは言った。「あなたがたの家畜をよこしなさい。銀が尽きたのなら、家畜と引き替えに与えよう。」","tok":[["ヨセフ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["家畜","かちく"],["を"],["よこし"],["なさい"],["。"],["銀","ぎん"],["が"],["尽きた","つきた"],["の"],["なら"],["、"],["家畜","かちく"],["と"],["引き替え","ひきかえ"],["に"],["与えよう","あたえよう"],["。"],["」"]]},{"verse":17,"text":"彼らがヨセフのところに家畜を引いて来たので、ヨセフは馬、羊の群れ、牛の群れ、およびろばと引き替えに、食物を彼らに与えた。こうして彼はその年、すべての家畜と引き替えた食物で彼らを切り抜けさせた。","tok":[["彼","かれ"],["ら"],["が"],["ヨセフ"],["の"],["ところ"],["に"],["家畜","かちく"],["を"],["引いて","ひいて"],["来た","きた"],["ので"],["、"],["ヨセフ"],["は"],["馬","うま"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["牛","うし"],["の"],["群れ","むれ"],["、"],["および"],["ろば"],["と"],["引き替え","ひきかえ"],["に"],["、"],["食物","しょくもつ"],["を"],["彼","かれ"],["ら"],["に"],["与えた","あたえた"],["。"],["こう"],["して"],["彼","かれ"],["は"],["その"],["年","とし"],["、"],["すべて"],["の"],["家畜","かちく"],["と"],["引き替えた","ひきかえた"],["食物","しょくもつ"],["で"],["彼","かれ"],["ら"],["を"],["切り抜けさせた","きりぬけさせた"],["。"]]},{"verse":18,"text":"やがてその年も終わり、次の年、人々はまたヨセフのところに来て言った。「私たちはあなたさまに何も隠しません。私たちの銀も尽き、家畜の群れもあなたさまのものになったので、私たちのからだと農地のほかには、あなたさまの前に何も残っていません。","tok":[["やがて"],["その"],["年","とし"],["も"],["終わり","おわり"],["、"],["次","つぎ"],["の"],["年","とし"],["、"],["人々","ひとびと"],["は"],["また"],["ヨセフ"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["あなた"],["さま"],["に"],["何","なん"],["も"],["隠しません","かくしません"],["。"],["私たち","わたしたち"],["の"],["銀","ぎん"],["も"],["尽き","つき"],["、"],["家畜","かちく"],["の"],["群れ","むれ"],["も"],["あなた"],["さま"],["の"],["もの"],["に"],["なった"],["ので"],["、"],["私たち","わたしたち"],["の"],["からだ"],["と"],["農地","のうち"],["の"],["ほか"],["に"],["は"],["、"],["あなた"],["さま"],["の"],["前","まえ"],["に"],["何","なん"],["も"],["残って","のこって"],["いません"],["。"]]},{"verse":19,"text":"私たちはどうして農地といっしょにあなたさまの前で死んでよいでしょう。食物と引き替えに私たちと私たちの農地とを買い取ってください。私たちは農地といっしょにパロの奴隷となりましょう。どうか種を下さい。そうすれば私たちは生きて、死なないでしょう。そして、土地も荒れないでしょう。」","tok":[["私たち","わたしたち"],["は"],["どう"],["して"],["農地","のうち"],["と"],["いっしょ"],["に"],["あなた"],["さま"],["の"],["前","まえ"],["で"],["死んで","しんで"],["よいでしょう"],["。"],["食物","しょくもつ"],["と"],["引き替え","ひきかえ"],["に"],["私たち","わたしたち"],["と"],["私たち","わたしたち"],["の"],["農地","のうち"],["と"],["を"],["買い取って","かいとって"],["ください"],["。"],["私たち","わたしたち"],["は"],["農地","のうち"],["と"],["いっしょ"],["に"],["パロ"],["の"],["奴隷","どれい"],["と"],["なりましょう"],["。"],["どう"],["か"],["種","たね"],["を"],["下さい","ください"],["。"],["そう"],["すれば"],["私たち","わたしたち"],["は"],["生きて","いきて"],["、"],["死なないでしょう","しなないでしょう"],["。"],["そして"],["、"],["土地","とち"],["も"],["荒れないでしょう","あれないでしょう"],["。"],["」"]]},{"verse":20,"text":"それでヨセフはエジプトの全農地を、パロのために買い取った。ききんがエジプト人にきびしかったので、彼らがみな、その畑地を売ったからである。こうしてその土地はパロのものとなった。","tok":[["それ"],["で"],["ヨセフ"],["は"],["エジプト"],["の"],["全","ぜん"],["農地","のうち"],["を"],["、"],["パロ"],["の"],["ため"],["に"],["買い取った","かいとった"],["。"],["ききん"],["が"],["エジプト"],["人","にん"],["に"],["きびしかった"],["ので"],["、"],["彼","かれ"],["ら"],["が"],["みな"],["、"],["その"],["畑地","はたち"],["を"],["売った","うった"],["から"],["で"],["ある"],["。"],["こう"],["して"],["その"],["土地","とち"],["は"],["パロ"],["の"],["もの"],["と"],["なった"],["。"]]},{"verse":21,"text":"彼は民を、エジプトの領土の端から端まで町々に移動させた。","tok":[["彼","かれ"],["は"],["民","みん"],["を"],["、"],["エジプト"],["の"],["領土","りょうど"],["の"],["端","はし"],["から"],["端","はし"],["まで"],["町々","まちまち"],["に"],["移動","いどう"],["させた"],["。"]]},{"verse":22,"text":"ただ祭司たちの土地は買い取らなかった。祭司たちにはパロからの給与があって、彼らはパロが与える給与によって生活していたので、その土地を売らなかったからである。","tok":[["ただ"],["祭司","さいし"],["たち"],["の"],["土地","とち"],["は"],["買い取らなかった","かいとらなかった"],["。"],["祭司","さいし"],["たち"],["に"],["は"],["パロ"],["から"],["の"],["給与","きゅうよ"],["が"],["あって"],["、"],["彼","かれ"],["ら"],["は"],["パロ"],["が"],["与える","あたえる"],["給与","きゅうよ"],["によって"],["生活","せいかつ"],["して"],["いた"],["ので"],["、"],["その"],["土地","とち"],["を"],["売らなかった","うらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"ヨセフは民に言った。「私は、今、あなたがたとあなたがたの土地を買い取って、パロのものとしたのだから。さあ、ここにあなたがたへの種がある。これを地に蒔かなければならない。","tok":[["ヨセフ"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["今","いま"],["、"],["あなた"],["がた"],["と"],["あなた"],["がた"],["の"],["土地","とち"],["を"],["買い取って","かいとって"],["、"],["パロ"],["の"],["もの"],["と"],["した"],["の"],["だ"],["から"],["。"],["さあ"],["、"],["ここ"],["に"],["あなた"],["が"],["たへ"],["の"],["種","たね"],["が"],["ある"],["。"],["これ"],["を"],["地","ち"],["に"],["蒔かなければ","まかなければ"],["ならない"],["。"]]},{"verse":24,"text":"収穫の時になったら、その五分の一はパロに納め、五分の四はあなたがたのものとし、畑の種のため、またあなたがたの食糧のため、またあなたがたの家族の者のため、またあなたがたの幼い子どもたちの食糧としなければならない。」","tok":[["収穫","しゅうかく"],["の"],["時","とき"],["に"],["なったら"],["、"],["その"],["五分","ごぶん"],["の"],["一","いち"],["は"],["パロ"],["に"],["納め","おさめ"],["、"],["五分","ごぶん"],["の"],["四","よん"],["は"],["あなた"],["がた"],["の"],["もの"],["と"],["し"],["、"],["畑","はたけ"],["の"],["種","しゅ"],["の"],["ため"],["、"],["また"],["あなた"],["がた"],["の"],["食糧","しょくりょう"],["の"],["ため"],["、"],["また"],["あなた"],["がた"],["の"],["家族","かぞく"],["の"],["者","もの"],["の"],["ため"],["、"],["また"],["あなた"],["がた"],["の"],["幼い","おさない"],["子ども","こども"],["たち"],["の"],["食糧","しょくりょう"],["と"],["しなければ"],["ならない"],["。"],["」"]]},{"verse":25,"text":"すると彼らは言った。「あなたさまは私たちを生かしてくださいました。私たちは、あなたのお恵みをいただいてパロの奴隷となりましょう。」","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["あなた"],["さま"],["は"],["私たち","わたしたち"],["を"],["生かして","いかして"],["くださいました"],["。"],["私たち","わたしたち"],["は"],["、"],["あなた"],["の"],["お恵み","おめぐみ"],["を"],["いただいて"],["パロ"],["の"],["奴隷","どれい"],["と"],["なりましょう"],["。"],["」"]]},{"verse":26,"text":"ヨセフはエジプトの土地について、五分の一はパロのものとしなくてはならないとの一つのおきてを定めた。これは今日に及んでいる。ただし祭司の土地だけはパロのものとならなかった。","tok":[["ヨセフ"],["は"],["エジプト"],["の"],["土地","とち"],["について"],["、"],["五分","ごぶん"],["の"],["一","いち"],["は"],["パロ"],["の"],["もの"],["と"],["しなくて"],["は"],["ならない"],["と"],["の"],["一","ひと"],["つ"],["の"],["おきて"],["を"],["定めた","さだめた"],["。"],["これ"],["は"],["今日","きょう"],["に"],["及んで","およんで"],["いる"],["。"],["ただし"],["祭司","さいし"],["の"],["土地","とち"],["だけ"],["は"],["パロ"],["の"],["もの"],["と"],["ならなかった"],["。"]]},{"verse":27,"text":"さて、イスラエルはエジプトの国でゴシェンの地に住んだ。彼らはそこに所有地を得、多くの子を生み、非常にふえた。","tok":[["さて"],["、"],["イスラエル"],["は"],["エジプト"],["の"],["国","くに"],["で"],["ゴシェン"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["。"],["彼","かれ"],["ら"],["は"],["そこ"],["に"],["所有地","しょゆうち"],["を"],["得","え"],["、"],["多く","おおく"],["の"],["子","こ"],["を"],["生み","うみ"],["、"],["非常","ひじょう"],["に"],["ふえた"],["。"]]},{"verse":28,"text":"ヤコブはエジプトの地で十七年生きながらえたので、ヤコブの一生の年は百四十七年であった。","tok":[["ヤコブ"],["は"],["エジプト"],["の"],["地","ち"],["で"],["十七","じゅうなな"],["年","ねん"],["生きながらえた","いきながらえた"],["ので"],["、"],["ヤコブ"],["の"],["一生","いっしょう"],["の"],["年","とし"],["は"],["百四十七","ひゃくよんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":29,"text":"イスラエルに死ぬべき日が近づいたとき、その子ヨセフを呼び寄せて言った。「もしあなたの心にかなうなら、どうかあなたの手を私のももの下に入れ、私に愛と真実を尽くしてくれ。どうか私をエジプトの地に葬らないでくれ。","tok":[["イスラエル"],["に"],["死ぬべき","しぬべき"],["日","ひ"],["が"],["近づいた","ちかづいた"],["とき"],["、"],["その"],["子","こ"],["ヨセフ"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["もし"],["あなた"],["の"],["心","こころ"],["に"],["かなうなら"],["、"],["どう"],["か"],["あなた"],["の"],["手","て"],["を"],["私","わたくし"],["の"],["もも"],["の"],["下","した"],["に"],["入れ","いれ"],["、"],["私","わたくし"],["に"],["愛","あい"],["と"],["真実","しんじつ"],["を"],["尽くして","つくして"],["くれ"],["。"],["どう"],["か"],["私","わたくし"],["を"],["エジプト"],["の"],["地","ち"],["に"],["葬らないで","ほうむらないで"],["くれ"],["。"]]},{"verse":30,"text":"私が先祖たちとともに眠りについたなら、私をエジプトから運び出して、先祖たちの墓に葬ってくれ。」するとヨセフは言った。「私はきっと、あなたの言われたとおりにいたします。」","tok":[["私","わたくし"],["が"],["先祖","せんぞ"],["たち"],["と"],["とも"],["に"],["眠り","ねむり"],["に"],["ついたなら"],["、"],["私","わたくし"],["を"],["エジプト"],["から"],["運び出して","はこびだして"],["、"],["先祖","せんぞ"],["たち"],["の"],["墓","はか"],["に"],["葬って","ほうむって"],["くれ"],["。"],["」"],["する"],["と"],["ヨセフ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["きっと"],["、"],["あなた"],["の"],["言われた","いわれた"],["とおり"],["に"],["いたします"],["。"],["」"]]},{"verse":31,"text":"それでイスラエルは言った。「私に誓ってくれ。」そこでヨセフは彼に誓った。イスラエルは床に寝たまま、おじぎをした。","tok":[["それ"],["で"],["イスラエル"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["誓って","ちかって"],["くれ"],["。"],["」"],["そこ"],["で"],["ヨセフ"],["は"],["彼","かれ"],["に"],["誓った","ちかった"],["。"],["イスラエル"],["は"],["床","ゆか"],["に"],["寝た","ねた"],["まま"],["、"],["おじぎ"],["を"],["した"],["。"]]}]
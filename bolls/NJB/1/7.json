[{"verse":1,"text":"主はノアに仰せられた。「あなたとあなたの全家族とは、箱舟に入りなさい。あなたがこの時代にあって、わたしの前に正しいのを、わたしが見たからである。","tok":[["主","ぬし"],["は"],["ノア"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["と"],["あなた"],["の"],["全","ぜん"],["家族","かぞく"],["と"],["は"],["、"],["箱舟","はこぶね"],["に"],["入り","はいり"],["なさい"],["。"],["あなた"],["が"],["この"],["時代","じだい"],["に"],["あって"],["、"],["わたし"],["の"],["前","まえ"],["に"],["正しい","ただしい"],["の"],["を"],["、"],["わたし"],["が"],["見た","みた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたは、すべてのきよい動物の中から雄と雌、七つがいずつ、きよくない動物の中から雄と雌、一つがいずつ、","tok":[["あなた"],["は"],["、"],["すべて"],["の"],["きよい"],["動物","どうぶつ"],["の"],["中","なか"],["から"],["雄","おす"],["と"],["雌","めす"],["、"],["七","なな"],["つがい"],["ずつ"],["、"],["きよく"],["ない"],["動物","どうぶつ"],["の"],["中","なか"],["から"],["雄","おす"],["と"],["雌","めす"],["、"],["一","ひと"],["つ"],["がい"],["ずつ"],["、"]]},{"verse":3,"text":"また空の鳥の中からも雄と雌、七つがいずつを取りなさい。それはその種類が全地の面で生き残るためである。","tok":[["また"],["空","そら"],["の"],["鳥","とり"],["の"],["中","なか"],["から"],["も"],["雄","おす"],["と"],["雌","めす"],["、"],["七","なな"],["つがい"],["ずつ"],["を"],["取り","とり"],["なさい"],["。"],["それ"],["は"],["その"],["種類","しゅるい"],["が"],["全地","ぜんち"],["の"],["面","めん"],["で"],["生き残る","いきのこる"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"それは、あと七日たつと、わたしは、地の上に四十日四十夜、雨を降らせ、わたしが造ったすべての生き物を地の面から消し去るからである。」","tok":[["それ"],["は"],["、"],["あと"],["七","しち"],["日","にち"],["たつ"],["と"],["、"],["わたし"],["は"],["、"],["地","ち"],["の"],["上","うえ"],["に"],["四十日","よんとうか"],["四十","よんじゅう"],["夜","よる"],["、"],["雨","あめ"],["を"],["降らせ","ふらせ"],["、"],["わたし"],["が"],["造った","つくった"],["すべて"],["の"],["生き物","いきもの"],["を"],["地","ち"],["の"],["面","めん"],["から"],["消し去る","けしさる"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"ノアは、すべて主が命じられたとおりにした。","tok":[["ノア"],["は"],["、"],["すべて"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"]]},{"verse":6,"text":"大洪水が起こり、大水が地の上にあったとき、ノアは六百歳であった。","tok":[["大洪水","だいこうずい"],["が"],["起こり","おこり"],["、"],["大水","おおみず"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["あった"],["とき"],["、"],["ノア"],["は"],["六百歳","ろくひゃくさい"],["で"],["あった"],["。"]]},{"verse":7,"text":"ノアは、自分の息子たちや自分の妻、それに息子たちの妻といっしょに、大洪水の大水を避けるために箱舟に入った。","tok":[["ノア"],["は"],["、"],["自分","じぶん"],["の"],["息子","むすこ"],["たち"],["や"],["自分","じぶん"],["の"],["妻","つま"],["、"],["それ"],["に"],["息子","むすこ"],["たち"],["の"],["妻","つま"],["と"],["いっしょ"],["に"],["、"],["大洪水","だいこうずい"],["の"],["大水","おおみず"],["を"],["避ける","さける"],["ため"],["に"],["箱舟","はこぶね"],["に"],["入った","はいった"],["。"]]},{"verse":8,"text":"きよい動物、きよくない動物、鳥、地をはうすべてのものの中から、","tok":[["きよい"],["動物","どうぶつ"],["、"],["きよく"],["ない"],["動物","どうぶつ"],["、"],["鳥","とり"],["、"],["地","ち"],["を"],["はう"],["すべて"],["の"],["もの"],["の"],["中","なか"],["から"],["、"]]},{"verse":9,"text":"神がノアに命じられたとおり、雄と雌二匹ずつが箱舟の中のノアのところに入って来た。","tok":[["神","かみ"],["が"],["ノア"],["に"],["命じられた","めいじられた"],["とおり"],["、"],["雄","おす"],["と"],["雌","めす"],["二匹","にひき"],["ずつ"],["が"],["箱舟","はこぶね"],["の"],["中","なか"],["の"],["ノア"],["の"],["ところ"],["に"],["入って","はいって"],["来た","きた"],["。"]]},{"verse":10,"text":"それから七日たって大洪水の大水が地の上に起こった。","tok":[["それ"],["から"],["七","なな"],["日","にち"],["たって"],["大洪水","だいこうずい"],["の"],["大水","おおみず"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["起こった","おこった"],["。"]]},{"verse":11,"text":"ノアの生涯の六百年目の第二の月の十七日、その日に、巨大な大いなる水の源が、ことごとく張り裂け、天の水門が開かれた。","tok":[["ノア"],["の"],["生涯","しょうがい"],["の"],["六百","ろくひゃく"],["年目","ねんめ"],["の"],["第","だい"],["二","に"],["の"],["月","つき"],["の"],["十七日","じゅうななか"],["、"],["その"],["日","ひ"],["に"],["、"],["巨大","きょだい"],["な"],["大いなる","おおいなる"],["水","みず"],["の"],["源","みなもと"],["が"],["、"],["ことごとく"],["張り裂け","はりさけ"],["、"],["天","てん"],["の"],["水門","すいもん"],["が"],["開かれた","ひらかれた"],["。"]]},{"verse":12,"text":"そして、大雨は、四十日四十夜、地の上に降った。","tok":[["そして"],["、"],["大雨","おおあめ"],["は"],["、"],["四十日","よんとうか"],["四十","よんじゅう"],["夜","よる"],["、"],["地","ち"],["の"],["上","うえ"],["に"],["降った","ふった"],["。"]]},{"verse":13,"text":"ちょうどその同じ日に、ノアは、ノアの息子たちセム、ハム、ヤペテ、またノアの妻と息子たちの三人の妻といっしょに箱舟に入った。","tok":[["ちょうど"],["その"],["同じ","おなじ"],["日","ひ"],["に"],["、"],["ノア"],["は"],["、"],["ノア"],["の"],["息子","むすこ"],["たち"],["セム"],["、"],["ハム"],["、"],["ヤペテ"],["、"],["また"],["ノア"],["の"],["妻","つま"],["と"],["息子","むすこ"],["たち"],["の"],["三人","さんにん"],["の"],["妻","つま"],["と"],["いっしょ
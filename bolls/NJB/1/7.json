],["山々","やまやま"],["も"],["、"],["すべて"],["おおわれた"],["。"]]},{"verse":20,"text":"水は、その上さらに十五キュビト増し加わったので、山々はおおわれてしまった。","tok":[["水","みず"],["は"],["、"],["その"],["上","うえ"],["さらに"],["十五","じゅうご"],["キュビト"],["増し","まし"],["加わった","くわわった"],["ので"],["、"],["山々","やまやま"],["は"],["おおわれて"],["しまった"],["。"]]},{"verse":21,"text":"こうして地の上を動いていたすべての肉なるものは、鳥も家畜も獣も地に群生するすべてのものも、またすべての人も死に絶えた。","tok":[["こう"],["して"],["地","ち"],["の"],["上","うえ"],["を"],["動いて","うごいて"],["いた"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["は"],["、"],["鳥","とり"],["も"],["家畜","かちく"],["も"],["獣","けもの"],["も"],["地","ち"],["に"],["群生","ぐんせい"],["する"],["すべて"],["の"],["もの"],["も"],["、"],["また"],["すべて"],["の"],["人","ひと"],["も"],["死に絶えた","しにたえた"],["。"]]},{"verse":22,"text":"いのちの息を吹き込まれたもので、かわいた地の上にいたものはみな死んだ。","tok":[["いのち"],["の"],["息","いき"],["を"],["吹き込まれた","ふきこまれた"],["もの"],["で"],["、"],["かわいた"],["地","ち"],["の"],["上","うえ"],["に"],["いた"],["もの"],["は"],["みな"],["死んだ","しんだ"],["。"]]},{"verse":23,"text":"こうして、主は地上のすべての生き物を、人をはじめ、動物、はうもの、空の鳥に至るまで消し去った。それらは、地から消し去られた。ただノアと、彼といっしょに箱舟にいたものたちだけが残った。","tok":[["こう"],["して"],["、"],["主","ぬし"],["は"],["地上","ちじょう"],["の"],["すべて"],["の"],["生き物","いきもの"],["を"],["、"],["人","ひと"],["を"],["はじめ"],["、"],["動物","どうぶつ"],["、"],["は"],["う"],["もの"],["、"],["空","そら"],["の"],["鳥","とり"],["に"],["至る","いたる"],["まで"],["消し去った","けしさった"],["。"],["それ"],["ら"],["は"],["、"],["地","ち"],["から"],["消し去られた","けしさられた"],["。"],["ただ"],["ノア"],["と"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["箱舟","はこぶね"],["に"],["いた"],["もの"],["たち"],["だけ"],["が"],["残った","のこった"],["。"]]},{"verse":24,"text":"水は、百五十日間、地の上にふえ続けた。","tok":[["水","みず"],["は"],["、"],["百五十","ひゃくごとう"],["日間","かかん"],["、"],["地","ち"],["の"],["上","うえ"],["に"],["ふえ"],["続けた","つづけた"],["。"]]}]
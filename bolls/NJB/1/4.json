[{"verse":1,"text":"人は、その妻エバを知った。彼女はみごもってカインを産み、「私は、主によってひとりの男子を得た」と言った。","tok":[["人","ひと"],["は"],["、"],["その"],["妻","つま"],["エバ"],["を"],["知った","しった"],["。"],["彼女","かのじょ"],["は"],["みごもって"],["カイン"],["を"],["産み","うみ"],["、"],["「"],["私","わたくし"],["は"],["、"],["主に","おもに"],["よって"],["ひとり"],["の"],["男子","だんし"],["を"],["得た","えた"],["」"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"彼女は、それからまた、弟アベルを産んだ。アベルは羊を飼う者となり、カインは土を耕す者となった。","tok":[["彼女","かのじょ"],["は"],["、"],["それ"],["から"],["また"],["、"],["弟","おとうと"],["アベル"],["を"],["産んだ","うんだ"],["。"],["アベル"],["は"],["羊","ひつじ"],["を"],["飼う","かう"],["者","もの"],["と"],["なり"],["、"],["カイン"],["は"],["土","つち"],["を"],["耕す","たがやす"],["者","もの"],["と"],["なった"],["。"]]},{"verse":3,"text":"ある時期になって、カインは、地の作物から主へのささげ物を持って来たが、","tok":[["ある"],["時期","じき"],["に"],["なって"],["、"],["カイン"],["は"],["、"],["地","ち"],["の"],["作物","さくもつ"],["から"],["主","ぬし"],["へ"],["の"],["ささげ物","ささげもの"],["を"],["持って","もって"],["来た","きた"],["が"],["、"]]},{"verse":4,"text":"アベルもまた彼の羊の初子の中から、それも最上のものを持って来た。主はアベルとそのささげ物とに目を留められた。","tok":[["アベル"],["も"],["また"],["彼","かれ"],["の"],["羊","ひつじ"],["の"],["初子","ういご"],["の"],["中","なか"],["から"],["、"],["それ"],["も"],["最上","さいじょう"],["の"],["もの"],["を"],["持って","もって"],["来た","きた"],["。"],["主","ぬし"],["は"],["アベル"],["と"],["その"],["ささげ物","ささげもの"],["と"],["に"],["目","め"],["を"],["留められた","とめられた"],["。"]]},{"verse":5,"text":"だが、カインとそのささげ物には目を留められなかった。それで、カインはひどく怒り、顔を伏せた。","tok":[["だ"],["が"],["、"],["カイン"],["と"],["その"],["ささげ物","ささげもの"],["に"],["は"],["目","め"],["を"],["留められなかった","とめられなかった"],["。"],["それ"],["で"],["、"],["カイン"],["は"],["ひどく"],["怒り","おこり"],["、"],["顔","かお"],["を"],["伏せた","ふせた"],["。"]]},{"verse":6,"text":"そこで、主は、カインに仰せられた。「なぜ、あなたは憤っているのか。なぜ、顔を伏せているのか。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["、"],["カイン"],["に"],["仰せられた","おおせられた"],["。"],["「"],["なぜ"],["、"],["あなた"],["は"],["憤って","いきどおって"],["いる"],["の"],["か"],["。"],["なぜ"],["、"],["顔","かお"],["を"],["伏せて","ふせて"],["いる"],["の"],["か"],["。"]]},{"verse":7,"text":"あなたが正しく行ったのであれば、受け入れられる。ただし、あなたが正しく行っていないのなら、罪は戸口で待ち伏せして、あなたを恋い慕っている。だが、あなたは、それを治めるべきである。」","tok":[["あなた"],["が"],["正しく","ただしく"],["行った","いった"],["ので"],["あれば"],["、"],["受け入れられる","うけいれられる"],["。"],["ただし"],["、"],["あなた"],["が"],["正しく","ただしく"],["行って","いって"],["いない"],["の"],["なら"],["、"],["罪","つみ"],["は"],["戸口","とぐち"],["で"],["待ち伏せ","まちぶせ"],["して"],["、"],["あなた"],["を"],["恋い慕って","こいしたって"],["いる"],["。"],["だ"],["が"],["、"],["あなた"],["は"],["、"],["それ"],["を"],["治めるべきで","おさめるべきで"],["ある"],["。"],["」"]]},{"verse":8,"text":"しかし、カインは弟アベルに話しかけた。「野に行こうではないか。」そして、ふたりが野にいたとき、カインは弟アベルに襲いかかり、彼を殺した。","tok":[["しかし"],["、"],["カイン"],["は"],["弟","おとうと"],["アベル"],["に"],["話しかけた","はなしかけた"],["。"],["「"],["野","の"],["に"],["行こうで","いこうで"],["は"],["ない"],["か"],["。"],["」"],["そして"],["、"],["ふたり"],["が"],["野","の"],["に"],["いた"],["とき"],["、"],["カイン"],["は"],["弟","おとうと"],["アベル"],["に"],["襲いかかり","おそいかかり"],["、"],["彼","かれ"],["を"],["殺した","ころした"],["。"]]},{"verse":9,"text":"主はカインに、「あなたの弟アベルは、どこにいるのか」と問われた。カインは答えた。「知りません。私は、自分の弟の番人なのでしょうか。」","tok":[["主","ぬし"],["は"],["カイン"],["に"],["、"],["「"],["あなた"],["の"],["弟","おとうと"],["アベル"],["は"],["、"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["問われた","とわれた"],["。"],["カイン"],["は"],["答えた","こたえた"],["。"],["「"],["知りません","しりません"],["。"],["私","わたくし"],["は"],["、"],["自分","じぶん"],["の"],["弟","おとうと"],["の"],["番人","ばんにん"],["な"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":10,"text":"そこで、仰せられた。「あなたは、いったいなんということをしたのか。聞け。あなたの弟の血が、その土地からわたしに叫んでいる。","tok":[["そこ"],["で"],["、"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["、"],["いったい"],["なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["か"],["。"],["聞け","きけ"],["。"],["あなた"],["の"],["弟","おとうと"],["の"],["血","ち"],["が"],["、"],["その"],["土地","とち"],["から"],["わたし"],["に"],["叫んで","さけんで"],["いる"],["。"]]},{"verse":11,"text":"今や、あなたはその土地にのろわれている。その土地は口を開いてあなたの手から、あなたの弟の血を受けた。","tok":[["今","いま"],["や"],["、"],["あなた"],["は"],["その"],["土地","とち"],["に"],["のろわれて"],["いる"],["。"],["その"],["土地","とち"],["は"],["口","くち"],["を"],["開いて","ひらいて"],["あなた"],["の"],["手","て"],["から"],["、"],["あなた"],["の"],["弟","おとうと"],["の"],["血","ち"],["を"],["受けた","うけた"],["。"]]},{"verse":12,"text":"それで、あなたがその土地を耕しても、土地はもはや、あなたのためにその力を生じない。あなたは地上をさまよい歩くさすらい人となるのだ。」","tok":[["それ"],["で"],["、"],["あなた"],["が"],["その"],["土地","とち"],["を"],["耕して","たがやして"],["も"],["、"],["土地","とち"],["は"],["もはや"],["、"],["あなた"],["の"],["ため"],["に"],["その"],["力","ちから"],["を"],["生じない","しょうじない"],["。"],["あなた"],["は"],["地上","ちじょう"],["を"],["さまよい"],["歩く","あるく"],["さすらい人","さすらいびと"],["と"],["なる"],["の"],["だ"],["。"],["」"]]},{"verse":13,"text":"カインは主に申し上げた。「私の咎は、大きすぎて、にないきれません。","tok":[["カイン"],["は"],["主に","おもに"],["申し上げた","もうしあげた"],["。"],["「"],["私","わたくし"],["の"],["咎","とが"],["は"],["、"],["大き","おおき"],["すぎて"],["、"],["にない"],["きれません"],["。"]]},{"verse":14,"text":"ああ、あなたはきょう私をこの土地から追い出されたので、私はあなたの御顔から隠れ、地上をさまよい歩くさすらい人とならなければなりません。それで、私に出会う者はだれでも、私を殺すでしょう。」","tok":[["ああ"],["、"],["あなた"],["は"],["きょう"],["私","わたくし"],["を"],["この"],["土地","とち"],["から"],["追い出された","おいだされた"],["ので"],["、"],["私","わたくし"],["は"],["あなた"],["の"],["御顔","おかお"],["から"],["隠れ","かくれ"],["、"],["地上","ちじょう"],["を"],["さまよい"],["歩く","あるく"],["さすらい人","さすらいびと"],["と"],["ならなければ"],["なりません"],["。"],["それ"],["で"],["、"],["私","わたくし"],["に"],["出会う","であう"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["私","わたくし"],["を"],["殺すでしょう","ころすでしょう"],["。"],["」"]]},{"verse":15,"text":"主は彼に仰せられた。「それだから、だれでもカインを殺す者は、七倍の復讐を受ける。」そこで主は、彼に出会う者が、だれも彼を殺すことのないように、カインに一つのしるしを下さった。","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["それ"],["だ"],["から"],["、"],["だれ"],["で"],["も"],["カイン"],["を"],["殺す","ころす"],["者","もの"],["は"],["、"],["七","なな"],["倍","ばい"],["の"],["復讐","ふくしゅう"],["を"],["受ける","うける"],["。"],["」"],["そこ"],["で"],["主","ぬし"],["は"],["、"],["彼","かれ"],["に"],["出会う","であう"],["者","もの"],["が"],["、"],["だれ"],["も"],["彼","かれ"],["を"],["殺す","ころす"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["カイン"],["に"],["一","ひと"],["つ"],["の"],["しるし"],["を"],["下さった","くださった"],["。"]]},{"verse":16,"text":"それで、カインは、主の前から去って、エデンの東、ノデの地に住みついた。","tok":[["それ"],["で"],["、"],["カイン"],["は"],["、"],["主","ぬし"],["の"],["前","まえ"],["から"],["去って","さって"],["、"],["エデン"],["の"],["東","ひがし"],["、"],["ノデ"],["の"],["地","ち"],["に"],["住みついた","すみついた"],["。"]]},{"verse":17,"text":"カインはその妻を知った。彼女はみごもり、エノクを産んだ。カインは町を建てていたので、自分の子の名にちなんで、その町にエノクという名をつけた。","tok":[["カイン"],["は"],["その"],["妻","つま"],["を"],["知った","しった"],["。"],["彼女","かのじょ"],["は"],["みごもり"],["、"],["エノク"],["を"],["産んだ","うんだ"],["。"],["カイン"],["は"],["町","まち"],["を"],["建てて","たてて"],["いた"],["ので"],["、"],["自分","じぶん"],["の"],["子","こ"],["の"],["名","な"],["に"],["ちなんで"],["、"],["その"],["町","まち"],["に"],["エノク"],["と"],["いう"],["名","な"],["を"],["つけた"],["。"]]},{"verse":18,"text":"エノクにはイラデが生まれた。イラデにはメフヤエルが生まれ、メフヤエルにはメトシャエルが生まれ、メトシャエルにはレメクが生まれた。","tok":[["エノク"],["に"],["は"],["イラデ"],["が"],["生まれた","うまれた"],["。"],["イラデ"],["に"],["は"],["メフヤエル"],["が"],["生まれ","うまれ"],["、"],["メフヤエル"],["に"],["は"],["メトシャエル"],["が"],["生まれ","うまれ"],["、"],["メトシャエル"],["に"],["は"],["レメク"],["が"],["生まれた","うまれた"],["。"]]},{"verse":19,"text":"レメクはふたりの妻をめとった。ひとりの名はアダ、他のひとりの名はツィラであった。","tok":[["レメク"],["は"],["ふたり"],["の"],["妻","つま"],["を"],["めとった"],["。"],["ひとり"],["の"],["名","な"],["は"],["アダ"],["、"],["他","た"],["の"],["ひとり"],["の"],["名","な"],["は"],["ツィラ"],["で"],["あった"],["。"]]},{"verse":20,"text":"アダはヤバルを産んだ。ヤバルは天幕に住む者、家畜を飼う者の先祖となった。","tok":[["アダ"],["は"],["ヤバル"],["を"],["産んだ","うんだ"],["。"],["ヤバル"],["は"],["天幕","てんまく"],["に"],["住む","すむ"],["者","もの"],["、"],["家畜","かちく"],["を"],["飼う","かう"],["者","もの"],["の"],["先祖","せんぞ"],["と"],["なった"],["。"]]},{"verse":21,"text":"その弟の名はユバルであった。彼は立琴と笛を巧みに奏するすべての者の先祖となった。","tok":[["その"],["弟","おとうと"],["の"],["名","な"],["は"],["ユバル"],["で"],["あった"],["。"],["彼","かれ"],["は"],["立琴","たてごと"],["と"],["笛","ふえ"],["を"],["巧み","たくみ"],["に"],["奏する","そうする"],["すべて"],["の"],["者","もの"],["の"],["先祖","せんぞ"],["と"],["なった"],["。"]]},{"verse":22,"text":"ツィラもまた、トバル・カインを産んだ。彼は青銅と鉄のあらゆる用具の鍛冶屋であった。トバル・カインの妹は、ナアマであった。","tok":[["ツィラ"],["も"],["また"],["、"],["トバル"],["・"],["カイン"],["を"],["産んだ","うんだ"],["。"],["彼","かれ"],["は"],["青銅","せいどう"],["と"],["鉄","てつ"],["の"],["あらゆる"],["用具","ようぐ"],["の"],["鍛冶屋","かじや"],["で"],["あった"],["。"],["トバル"],["・"],["カイン"],["の"],["妹","いもうと"],["は"],["、"],["ナアマ"],["で"],["あった"],["。"]]},{"verse":23,"text":"さて、レメクはその妻たちに言った。「アダとツィラよ。私の声を聞け。レメクの妻たちよ。私の言うことに耳を傾けよ。私の受けた傷のためには、ひとりの人を、私の受けた打ち傷のためには、ひとりの若者を殺した。","tok":[["さて"],["、"],["レメク"],["は"],["その"],["妻たち","つまたち"],["に"],["言った","いった"],["。"],["「"],["アダ"],["と"],["ツィラ"],["よ"],["。"],["私","わたくし"],["の"],["声","こえ"],["を"],["聞け","きけ"],["。"],["レメク"],["の"],["妻たち","つまたち"],["よ"],["。"],["私","わたくし"],["の"],["言う","いう"],["こと"],["に"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["私","わたくし"],["の"],["受けた","うけた"],["傷","きず"],["の"],["ため"],["に"],["は"],["、"],["ひとり"],["の"],["人","ひと"],["を"],["、"],["私","わたくし"],["の"],["受けた","うけた"],["打ち傷","うちきず"],["の"],["ため"],["に"],["は"],["、"],["ひとり"],["の"],["若者","わかもの"],["を"],["殺した","ころした"],["。"]]},{"verse":24,"text":"カインに七倍の復讐があれば、レメクには七十七倍。」","tok":[["カイン"],["に"],["七","しち"],["倍","ばい"],["の"],["復讐","ふくしゅう"],["が"],["あれば"],["、"],["レメク"],["に"],["は"],["七十七","ななじゅうなな"],["倍","ばい"],["。"],["」"]]},{"verse":25,"text":"アダムは、さらに、その妻を知った。彼女は男の子を産み、その子をセツと名づけて言った。「カインがアベルを殺したので、彼の代わりに、神は私にもうひとりの子を授けられたから。」","tok":[["アダム"],["は"],["、"],["さらに"],["、"],["その"],["妻","つま"],["を"],["知った","しった"],["。"],["彼女","かのじょ"],["は"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["その"],["子","こ"],["を"],["セツ"],["と"],["名づけて","なづけて"],["言った","いった"],["。"],["「"],["カイン"],["が"],["アベル"],["を"],["殺した","ころした"],["ので"],["、"],["彼","かれ"],["の"],["代わり","かわり"],["に"],["、"],["神","かみ"],["は"],["私","わたくし"],["に"],["もう"],["ひとり"],["の"],["子","こ"],["を"],["授けられた","さずけられた"],["から"],["。"],["」"]]},{"verse":26,"text":"セツにもまた男の子が生まれた。彼は、その子をエノシュと名づけた。そのとき、人々は主の御名によって祈ることを始めた。","tok":[["セツ"],["に"],["も"],["また"],["男の子","おとこのこ"],["が"],["生まれた","うまれた"],["。"],["彼","かれ"],["は"],["、"],["その"],["子","こ"],["を"],["エノシュ"],["と"],["名づけた","なづけた"],["。"],["その"],["とき"],["、"],["人々","ひとびと"],["は"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["祈る","いのる"],["こと"],["を"],["始めた","はじめた"],["。"]]}]
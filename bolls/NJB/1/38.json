[{"verse":1,"text":"そのころのことであった。ユダは兄弟たちから離れて下って行き、その名をヒラというアドラム人の近くで天幕を張った。","tok":[["その"],["ころ"],["の"],["こと"],["で"],["あった"],["。"],["ユダ"],["は"],["兄弟","きょうだい"],["たち"],["から"],["離れて","はなれて"],["下って","くだって"],["行き","いき"],["、"],["その"],["名","な"],["を"],["ヒラ"],["と"],["いう"],["アドラム"],["人","にん"],["の"],["近く","ちかく"],["で"],["天幕","てんまく"],["を"],["張った","はった"],["。"]]},{"verse":2,"text":"そこでユダは、あるカナン人で、その名をシュアという人の娘を見そめ、彼女をめとって彼女のところに入った。","tok":[["そこ"],["で"],["ユダ"],["は"],["、"],["ある"],["カナン人","かなんにん"],["で"],["、"],["その"],["名","な"],["を"],["シュア"],["と"],["いう"],["人","ひと"],["の"],["娘","むすめ"],["を"],["見そめ","みそめ"],["、"],["彼女","かのじょ"],["を"],["めとって"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入った","はいった"],["。"]]},{"verse":3,"text":"彼女はみごもり、男の子を産んだ。彼はその子をエルと名づけた。","tok":[["彼女","かのじょ"],["は"],["みごもり"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["彼","かれ"],["は"],["その"],["子","こ"],["を"],["エル"],["と"],["名づけた","なづけた"],["。"]]},{"verse":4,"text":"彼女はまたみごもって、男の子を産み、その子をオナンと名づけた。","tok":[["彼女","かのじょ"],["は"],["また"],["みごもって"],["、"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["その"],["子","こ"],["を"],["オナン"],["と"],["名づけた","なづけた"],["。"]]},{"verse":5,"text":"彼女はさらにまた男の子を産み、その子をシェラと名づけた。彼女がシェラを産んだとき、彼はケジブにいた。","tok":[["彼女","かのじょ"],["は"],["さらに"],["また"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["その"],["子","こ"],["を"],["シェラ"],["と"],["名づけた","なづけた"],["。"],["彼女","かのじょ"],["が"],["シェラ"],["を"],["産んだ","うんだ"],["とき"],["、"],["彼","かれ"],["は"],["ケジブ"],["に"],["いた"],["。"]]},{"verse":6,"text":"ユダは、その長子エルにタマルという妻を迎えた。","tok":[["ユダ"],["は"],["、"],["その"],["長子","ちょうし"],["エル"],["に"],["タマル"],["と"],["いう"],["妻","つま"],["を"],["迎えた","むかえた"],["。"]]},{"verse":7,"text":"しかしユダの長子エルは主を怒らせていたので、主は彼を殺した。","tok":[["しかし"],["ユダ"],["の"],["長子","ちょうし"],["エル"],["は"],["主","ぬし"],["を"],["怒らせて","おこらせて"],["いた"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["を"],["殺した","ころした"],["。"]]},{"verse":8,"text":"それでユダはオナンに言った。「あなたは兄嫁のところに入り、義弟としての務めを果たしなさい。そしてあなたの兄のために子孫を起こすようにしなさい。」","tok":[["それ"],["で"],["ユダ"],["は"],["オナン"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["兄嫁","あによめ"],["の"],["ところ"],["に"],["入り","はいり"],["、"],["義弟","ぎてい"],["として"],["の"],["務め","つとめ"],["を"],["果たし","はたし"],["なさい"],["。"],["そして"],["あなた"],["の"],["兄","あに"],["の"],["ため"],["に"],["子孫","しそん"],["を"],["起こす","おこす"],["よう"],["に"],["し"],["なさい"],["。"],["」"]]},{"verse":9,"text":"しかしオナンは、その生まれる子が自分のものとならないのを知っていたので、兄に子孫を与えないために、兄嫁のところに入ると、地に流していた。","tok":[["しかし"],["オナン"],["は"],["、"],["その"],["生まれる","うまれる"],["子","こ"],["が"],["自分","じぶん"],["の"],["もの"],["と"],["ならない"],["の"],["を"],["知って","しって"],["いた"],["ので"],["、"],["兄","あに"],["に"],["子孫","しそん"],["を"],["与えない","あたえない"],["ため"],["に"],["、"],["兄嫁","あによめ"],["の"],["ところ"],["に"],["入る","はいる"],["と"],["、"],["地","ち"],["に"],["流して","ながして"],["いた"],["。"]]},{"verse":10,"text":"彼のしたことは主を怒らせたので、主は彼をも殺した。","tok":[["彼","かれ"],["の"],["した"],["こと"],["は"],["主","ぬし"],["を"],["怒らせた","おこらせた"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["を"],["も"],["殺した","ころした"],["。"]]},{"verse":11,"text":"そこでユダは、嫁のタマルに、「わが子シェラが成人するまで、あなたの父の家でやもめのままでいなさい」と言った。それはシェラもまた、兄たちのように死ぬといけないと思ったからである。タマルは父の家に行き、そこに住むようになった。","tok":[["そこ"],["で"],["ユダ"],["は"],["、"],["嫁","よめ"],["の"],["タマル"],["に"],["、"],["「"],["わが"],["子","こ"],["シェラ"],["が"],["成人","せいじん"],["する"],["まで"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["で"],["やもめ"],["の"],["まま"],["で"],["い"],["なさい"],["」"],["と"],["言った","いった"],["。"],["それ"],["は"],["シェラ"],["も"],["また"],["、"],["兄たち","あにたち"],["の"],["よう"],["に"],["死ぬ","しぬ"],["と"],["いけない"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"],["タマル"],["は"],["父","ちち"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["そこ"],["に"],["住む","すむ"],["よう"],["に"],["なった"],["。"]]},{"verse":12,"text":"かなり日がたって、シュアの娘であったユダの妻が死んだ。その喪が明けたとき、ユダは、羊の群れの毛を切るために、その友人でアドラム人のヒラといっしょに、ティムナへ上って行った。","tok":[["かなり"],["日","ひ"],["が"],["たって"],["、"],["シュア"],["の"],["娘","むすめ"],["で"],["あった"],["ユダ"],["の"],["妻","つま"],["が"],["死んだ","しんだ"],["。"],["その"],["喪","も"],["が"],["明けた","あけた"],["とき"],["、"],["ユダ"],["は"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["毛","け"],["を"],["切る","きる"],["ため"],["に"],["、"],["その"],["友人","ゆうじん"],["で"],["アドラム"],["人","にん"],["の"],["ヒラ"],["と"],["いっしょ"],["に"],["、"],["ティムナ"],["へ"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":13,"text":"そのとき、タマルに、「ご覧。あなたのしゅうとが羊の毛を切るためにティムナに上って来ていますよ」と告げる者があった。","tok":[["その"],["とき"],["、"],["タマル"],["に"],["、"],["「"],["ご覧","ごらん"],["。"],["あなた"],["の"],["しゅうと"],["が"],["羊","ひつじ"],["の"],["毛","け"],["を"],["切る","きる"],["ため"],["に"],["ティムナ"],["に"],["上って","のぼって"],["来て","きて"],["います"],["よ"],["」"],["と"],["告げる","つげる"],["者","もの"],["が"],["あった"],["。"]]},{"verse":14,"text":"それでタマルは、やもめの服を脱ぎ、ベールをかぶり、着替えをして、ティムナへの道にあるエナイムの入口にすわっていた。それはシェラが成人したのに、自分がその妻にされないのを知っていたからである。","tok":[["それ"],["で"],["タマル"],["は"],["、"],["やもめ"],["の"],["服","ふく"],["を"],["脱ぎ","ぬぎ"],["、"],["ベール"],["を"],["かぶり"],["、"],["着替え","きがえ"],["を"],["して"],["、"],["ティムナ"],["へ"],["の"],["道","みち"],["に"],["ある"],["エナイム"],["の"],["入口","いりぐち"],["に"],["すわって"],["いた"],["。"],["それ"],["は"],["シェラ"],["が"],["成人","せいじん"],["した"],["のに"],["、"],["自分","じぶん"],["が"],["その"],["妻","つま"],["に"],["されない"],["の"],["を"],["知って","しって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"ユダは、彼女を見たとき、彼女が顔をおおっていたので遊女だと思い、","tok":[["ユダ"],["は"],["、"],["彼女","かのじょ"],["を"],["見た","みた"],["とき"],["、"],["彼女","かのじょ"],["が"],["顔","かお"],["を"],["おおって"],["いた"],["ので"],["遊女","ゆうじょ"],["だ"],["と"],["思い","おもい"],["、"]]},{"verse":16,"text":"道ばたの彼女のところに行き、「さあ、あなたのところに入ろう」と言った。彼はその女が自分の嫁だとは知らなかったからである。彼女は、「私のところにお入りになれば、何を私に下さいますか」と言った。","tok":[["道ばた","みちばた"],["の"],["彼女","かのじょ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["「"],["さあ"],["、"],["あなた"],["の"],["ところ"],["に"],["入ろう","はいろう"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["は"],["その"],["女","おんな"],["が"],["自分","じぶん"],["の"],["嫁","よめ"],["だ"],["と"],["は"],["知らなかった","しらなかった"],["から"],["で"],["ある"],["。"],["彼女","かのじょ"],["は"],["、"],["「"],["私","わたくし"],["の"],["ところ"],["に"],["お入り","おいり"],["に"],["なれば"],["、"],["何","なん"],["を"],["私","わたくし"],["に"],["下さいます","くださいます"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"彼が、「群れの中から子やぎを送ろう」と言うと、彼女は、「それを送ってくださるまで、何かおしるしを下されば」と言った。","tok":[["彼","かれ"],["が"],["、"],["「"],["群れ","むれ"],["の"],["中","なか"],["から"],["子やぎ","こやぎ"],["を"],["送ろう","おくろう"],
[{"verse":1,"text":"アブラムの妻サライは、彼に子どもを産まなかった。彼女にはエジプト人の女奴隷がいて、その名をハガルといった。","tok":[["アブラム"],["の"],["妻","つま"],["サライ"],["は"],["、"],["彼","かれ"],["に"],["子ども","こども"],["を"],["産まなかった","うまなかった"],["。"],["彼女","かのじょ"],["に"],["は"],["エジプト"],["人","にん"],["の"],["女","おんな"],["奴隷","どれい"],["が"],["いて"],["、"],["その"],["名","な"],["を"],["ハガル"],["と"],["いった"],["。"]]},{"verse":2,"text":"サライはアブラムに言った。「ご存じのように、主は私が子どもを産めないようにしておられます。どうぞ、私の女奴隷のところにお入りください。たぶん彼女によって、私は子どもの母になれるでしょう。」アブラムはサライの言うことを聞き入れた。","tok":[["サライ"],["は"],["アブラム"],["に"],["言った","いった"],["。"],["「"],["ご存じ","ごぞんじ"],["の"],["よう"],["に"],["、"],["主","ぬし"],["は"],["私","わたくし"],["が"],["子ども","こども"],["を"],["産めない","うめない"],["よう"],["に"],["して"],["おられます"],["。"],["どうぞ"],["、"],["私","わたくし"],["の"],["女","おんな"],["奴隷","どれい"],["の"],["ところ"],["に"],["お入り","おはいり"],["ください"],["。"],["たぶん"],["彼女","かのじょ"],["によって"],["、"],["私","わたくし"],["は"],["子ども","こども"],["の"],["母","はは"],["に"],["なれるでしょう"],["。"],["」"],["アブラム"],["は"],["サライ"],["の"],["言う","いう"],["こと"],["を"],["聞き入れた","ききいれた"],["。"]]},{"verse":3,"text":"アブラムの妻サライは、アブラムがカナンの土地に住んでから十年後に、彼女の女奴隷のエジプト人ハガルを連れて来て、夫アブラムに妻として与えた。","tok":[["アブラム"],["の"],["妻","つま"],["サライ"],["は"],["、"],["アブラム"],["が"],["カナン"],["の"],["土地","とち"],["に"],["住んで","すんで"],["から"],["十","じゅう"],["年後","ねんご"],["に"],["、"],["彼女","かのじょ"],["の"],["女","おんな"],["奴隷","どれい"],["の"],["エジプト"],["人","にん"],["ハガル"],["を"],["連れて","つれて"],["来て","きて"],["、"],["夫","おっと"],["アブラム"],["に"],["妻","つま"],["として"],["与えた","あたえた"],["。"]]},{"verse":4,"text":"彼はハガルのところに入った。そして彼女はみごもった。彼女は自分がみごもったのを知って、自分の女主人を見下げるようになった。","tok":[["彼","かれ"],["は"],["ハガル"],["の"],["ところ"],["に"],["入った","はいった"],["。"],["そして"],["彼女","かのじょ"],["は"],["みごもった"],["。"],["彼女","かのじょ"],["は"],["自分","じぶん"],["が"],["みごもった"],["の"],["を"],["知って","しって"],["、"],["自分","じぶん"],["の"],["女","おんな"],["主人","しゅじん"],["を"],["見下げる","みさげる"],["よう"],["に"],["なった"],["。"]]},{"verse":5,"text":"そこでサライはアブラムに言った。「私に対するこの横柄さは、あなたのせいです。私自身が私の女奴隷をあなたのふところに与えたのですが、彼女は自分がみごもっているのを見て、私を見下げるようになりました。主が、私とあなたの間をおさばきになりますように。」","tok":[["そこ"],["で"],["サライ"],["は"],["アブラム"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["対する","たいする"],["この"],["横柄","おうへい"],["さ"],["は"],["、"],["あなた"],["の"],["せい"],["です"],["。"],["私自身","わたしじしん"],["が"],["私","わたくし"],["の"],["女","おんな"],["奴隷","どれい"],["を"],["あなた"],["の"],["ふところ"],["に"],["与えた","あたえた"],["の"],["です"],["が"],["、"],["彼女","かのじょ"],["は"],["自分","じぶん"],["が"],["みごもって"],["いる"],["の"],["を"],["見て","みて"],["、"],["私","わたくし"],["を"],["見下げる","みさげる"],["よう"],["に"],["なりました"],["。"],["主","ぬし"],["が"],["、"],["私","わたくし"],["と"],["あなた"],["の"],["間","あいだ"],["を"],["おさばき"],["に"],["なります"],["よう"],["に"],["。"],["」"]]},{"verse":6,"text":"アブラムはサライに言った。「ご覧。あなたの女奴隷は、あなたの手の中にある。彼女をあなたの好きなようにしなさい。」それで、サライが彼女をいじめたので、彼女はサライのもとから逃げ去った。","tok":[["アブラム"],["は"],["サライ"],["に"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["。"],["あなた"],["の"],["女","おんな"],["奴隷","どれい"],["は"],["、"],["あなた"],["の"],["手","て"],["の"],["中","なか"],["に"],["ある"],["。"],["彼女","かのじょ"],["を"],["あなた"],["の"],["好き","すき"],["な"],["よう"],["に"],["し"],["なさい"],["。"],["」"],["それ"],["で"],["、"],["サライ"],["が"],["彼女","かのじょ"],["を"],["いじめた"],["ので"],["、"],["彼女","かのじょ"],["は"],["サライ"],["の"],["もと"],["から"],["逃げ去った","にげさった"],["。"]]},{"verse":7,"text":"主の使いは、荒野の泉のほとり、シュルへの道にある泉のほとりで、彼女を見つけ、","tok":[["主","ぬし"],["の"],["使い","つかい"],["は"],["、"],["荒野","こうや"],["の"],["泉","いずみ"],["の"],["ほとり"],["、"],["シュル"],["へ"],["の"],["道","みち"],["に"],["ある"],["泉","いずみ"],["の"],["ほとり"],["で"],["、"],["彼女","かのじょ"],["を"],["見つけ","みつけ"],["、"]]},{"verse":8,"text":"「サライの女奴隷ハガル。あなたはどこから来て、どこへ行くのか」と尋ねた。彼女は答えた。「私の女主人サライのところから逃げているところです。」","tok":[["「"],["サライ"],["の"],["女","おんな"],["奴隷","どれい"],["ハガル"],["。"],["あなた"],["は"],["どこ"],["から"],["来て","きて"],["、"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["彼女","かのじょ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["の"],["女","おんな"],["主人","しゅじん"],["サライ"],["の"],["ところ"],["から"],["逃げて","にげて"],["いる"],["ところ"],["です"],["。"],["」"]]},{"verse":9,"text":"そこで、主の使いは彼女に言った。「あなたの女主人のもとに帰りなさい。そして、彼女のもとで身を低くしなさい。」","tok":[["そこ"],["で"],["、"],["主","ぬし"],["の"],["使い","つかい"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["女","おんな"],["主人","しゅじん"],["の"],["もと"],["に"],["帰り","かえり"],["なさい"],["。"],["そして"],["、"],["彼女","かのじょ"],["の"],["もと"],["で"],["身","み"],["を"],["低く","ひくく"],["し"],["なさい"],["。"],["」"]]},{"verse":10,"text":"また、主の使いは彼女に言った。「あなたの子孫は、わたしが大いにふやすので、数えきれないほどになる。」","tok":[["また"],["、"],["主","ぬし"],["の"],["使い","つかい"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["子孫","しそん"],["は"],["、"],["わたし"],["が"],["大いに","おおいに"],["ふやす"],["ので"],["、"],["数え","かぞえ"],["きれない"],["ほど"],["に"],["なる"],["。"],["」"]]},{"verse":11,"text":"さらに、主の使いは彼女に言った。「見よ。あなたはみごもっている。男の子を産もうとしている。その子をイシュマエルと名づけなさい。主があなたの苦しみを聞き入れられたから。","tok":[["さらに"],["、"],["主","ぬし"],["の"],["使い","つかい"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["見","み"],["よ"],["。"],["あなた"],["は"],["みごもって"],["いる"],["。"],["男の子","おとこのこ"],["を"],["産もう","うもう"],["として"],["いる"],["。"],["その"],["子","こ"],["を"],["イシュマエル"],["と"],["名づけ","なづけ"],["なさい"],["。"],["主","ぬし"],["が"],["あなた"],["の"],["苦しみ","くるしみ"],["を"],["聞き入れられた","ききいれられた"],["から"],["。"]]},{"verse":12,"text":"彼は野生のろばのような人となり、その手は、すべての人に逆らい、すべての人の手も、彼に逆らう。彼はすべての兄弟に敵対して住もう。」","tok":[["彼","かれ"],["は"],["野生","やせい"],["の"],["ろば"],["の"],["よう"],["な"],["人となり","ひととなり"],["、"],["その"],["手","て"],["は"],["、"],["すべて"],["の"],["人","ひと"],["に"],["逆らい","さからい"],["、"],["すべて"],["の"],["人","ひと"],["の"],["手","て"],["も"],["、"],["彼","かれ"],["に"],["逆らう","さからう"],["。"],["彼","かれ"],["は"],["すべて"],["の"],["兄弟","きょうだい"],["に"],["敵対","てきたい"],["して"],["住もう","すもう"],["。"],["」"]]},{"verse":13,"text":"そこで、彼女は自分に語りかけられた主の名を「あなたはエル・ロイ」と呼んだ。それは、「ご覧になる方のうしろを私が見て、なおもここにいるとは」と彼女が言ったからである。","tok":[["そこ"],["で"],["、"],["彼女","かのじょ"],["は"],["自分","じぶん"],["に"],["語りかけられた","かたりかけられた"],["主","ぬし"],["の"],["名","な"],["を"],["「"],["あなた"],["は"],["エル"],["・"],["ロイ"],["」"],["と"],["呼んだ","よんだ"],["。"],["それ"],["は"],["、"],["「"],["ご覧","ごらん"],["に"],["なる"],["方","かた"],["の"],["うしろ"],["を"],["私","わたくし"],["が"],["見て","みて"],["、"],["なお"],["も"],["ここ"],["に"],["いる"],["と"],["は"],["」"],["と"],["彼女","かのじょ"],["が"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"それゆえ、その井戸は、ベエル・ラハイ・ロイと呼ばれた。それは、カデシュとベレデの間にある。","tok":[["それ"],["ゆえ"],["、"],["その"],["井戸","いど"],["は"],["、"],["ベエル"],["・"],["ラハイ"],["・"],["ロイ"],["と"],["呼ばれた","よばれた"],["。"],["それ"],["は"],["、"],["カデシュ"],["と"],["ベレデ"],["の"],["間","あいだ"],["に"],["ある"],["。"]]},{"verse":15,"text":"ハガルは、アブラムに男の子を産んだ。アブラムは、ハガルが産んだその男の子をイシュマエルと名づけた。","tok":[["ハガル"],["は"],["、"],["アブラム"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["アブラム"],["は"],["、"],["ハガル"],["が"],["産んだ","うんだ"],["その"],["男の子","おとこのこ"],["を"],["イシュマエル"],["と"],["名づけた","なづけた"],["。"]]},{"verse":16,"text":"ハガルがアブラムにイシュマエルを産んだとき、アブラムは八十六歳であった。","tok":[["ハガル"],["が"],["アブラム"],["に"],["イシュマエル"],["を"],["産んだ","うんだ"],["とき"],["、"],["アブラム"],["は"],["八十六歳","はちじゅうろくさい"],["で"],["あった"],["。"]]}]
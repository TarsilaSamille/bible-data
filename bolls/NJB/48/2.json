[{"verse":1,"text":"それから十四年たって、私は、バルナバといっしょに、テトスも連れて、再びエルサレムに上りました。","tok":[["それ"],["から"],["十四","じゅうよん"],["年","ねん"],["たって"],["、"],["私","わたくし"],["は"],["、"],["バルナバ"],["と"],["いっしょ"],["に"],["、"],["テトス"],["も"],["連れて","つれて"],["、"],["再び","ふたたび"],["エルサレム"],["に"],["上りました","のぼりました"],["。"]]},{"verse":2,"text":"それは啓示によって上ったのです。そして、異邦人の間で私の宣べている福音を、人々の前に示し、おもだった人たちには個人的にそうしました。それは、私が力を尽くしていま走っていること、またすでに走ったことが、むだにならないためでした。","tok":[["それ"],["は"],["啓示","けいじ"],["によって"],["上った","のぼった"],["の"],["です"],["。"],["そして"],["、"],["異邦人","いほうじん"],["の"],["間","あいだ"],["で"],["私","わたくし"],["の"],["宣べて","のべて"],["いる"],["福音","ふくいん"],["を"],["、"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["示し","しめし"],["、"],["おも"],["だった"],["人","ひと"],["たち"],["に"],["は"],["個人的","こじんてき"],["に"],["そう"],["しました"],["。"],["それ"],["は"],["、"],["私","わたくし"],["が"],["力","ちから"],["を"],["尽くして","つくして"],["いま"],["走って","はしって"],["いる"],["こと"],["、"],["また"],["すでに"],["走った","はしった"],["こと"],["が"],["、"],["むだ"],["に"],["ならない"],["ため"],["でした"],["。"]]},{"verse":3,"text":"しかし、私といっしょにいたテトスでさえ、ギリシヤ人であったのに、割礼を強いられませんでした。","tok":[["しかし"],["、"],["私","わたくし"],["と"],["いっしょ"],["に"],["いた"],["テトス"],["で"],["さえ"],["、"],["ギリシヤ"],["人","にん"],["で"],["あった"],["のに"],["、"],["割礼","かつれい"],["を"],["強いられませんでした","しいられませんでした"],["。"]]},{"verse":4,"text":"実は、忍び込んだにせ兄弟たちがいたので、強いられる恐れがあったのです。彼らは私たちを奴隷に引き落とそうとして、キリスト・イエスにあって私たちの持つ自由をうかがうために忍び込んでいたのです。","tok":[["実","じつ"],["は"],["、"],["忍び込んだ","しのびこんだ"],["にせ"],["兄弟","きょうだい"],["たち"],["が"],["いた"],["ので"],["、"],["強いられる","しいられる"],["恐れ","おそれ"],["が"],["あった"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["私たち","わたしたち"],["を"],["奴隷","どれい"],["に"],["引き落とそう","ひきおとそう"],["として"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["私たち","わたしたち"],["の"],["持つ","もつ"],["自由","じゆう"],["を"],["うかがう"],["ため"],["に"],["忍び込んで","しのびこんで"],["いた"],["の"],["です"],["。"]]},{"verse":5,"text":"私たちは彼らに一時も譲歩しませんでした。それは福音の真理があなたがたの間で常に保たれるためです。","tok":[["私たち","わたしたち"],["は"],["彼","かれ"],["ら"],["に"],["一","いち"],["時","じ"],["も"],["譲歩","じょうほ"],["しませんでした"],["。"],["それ"],["は"],["福音","ふくいん"],["の"],["真理","しんり"],["が"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["常","つね"],["に"],["保たれる","たもたれる"],["ため"],["です"],["。"]]},{"verse":6,"text":"そして、おもだった者と見られていた人たちからは、――彼らがどれほどの人たちであるにしても、私には問題ではありません。神は人を分け隔てなさいません――そのおもだった人たちは、私に対して、何もつけ加えることをしませんでした。","tok":[["そして"],["、"],["おも"],["だった"],["者","もの"],["と"],["見られて","みられて"],["いた"],["人","ひと"],["たち"],["から"],["は"],["、"],["―"],["―"],["彼","かれ"],["ら"],["が"],["どれ"],["ほど"],["の"],["人","ひと"],["たち"],["で"],["ある"],["に"],["して"],["も"],["、"],["私","わたくし"],["に"],["は"],["問題","もんだい"],["で"],["は"],["ありません"],["。"],["神","かみ"],["は"],["人","ひと"],["を"],["分け隔て","わけへだて"],["なさいません"],["―"],["―"],["その"],["おも"],["だった"],["人","ひと"],["たち"],["は"],["、"],["私","わたくし"],["に対して","にたいして"],["、"],["何","なん"],["も"],["つけ加える","つけくわえる"],["こと"],["を"],["しませんでした"],["。"]]},{"verse":7,"text":"それどころか、ペテロが割礼を受けた者への福音をゆだねられているように、私が割礼を受けない者への福音をゆだねられていることを理解してくれました。","tok":[["それ"],["どころ"],["か"],["、"],["ペテロ"],["が"],["割礼","かつれい"],["を"],["受けた","うけた"],["者","もの"],["へ"],["の"],["福音","ふくいん"],["を"],["ゆだねられて"],["いる"],["よう"],["に"],["、"],["私","わたくし"],["が"],["割礼","かつれい"],["を"],["受けない","うけない"],["者","もの"],["へ"],["の"],["福音","ふくいん"],["を"],["ゆだねられて"],["いる"],["こと"],["を"],["理解","りかい"],["して"],["くれました"],["。"]]},{"verse":8,"text":"ペテロにみわざをなして、割礼を受けた者への使徒となさった方が、私にもみわざをなして、異邦人への使徒としてくださったのです。","tok":[["ペテロ"],["に"],["みわざ"],["を"],["なして"],["、"],["割礼","かつれい"],["を"],["受けた","うけた"],["者","もの"],["へ"],["の"],["使徒","しと"],["と"],["なさった"],["方","ほう"],["が"],["、"],["私","わたくし"],["に"],["もみ"],["わざ"],["を"],["なして"],["、"],["異邦人","いほうじん"],["へ"],["の"],["使徒","しと"],["として"],["くださった"],["の"],["です"],["。"]]},{"verse":9,"text":"そして、私に与えられたこの恵みを認め、柱として重んじられているヤコブとケパとヨハネが、私とバルナバに、交わりのしるしとして右手を差し伸べました。それは、私たちが異邦人のところへ行き、彼らが割礼を受けた人々のところへ行くためです。","tok":[["そして"],["、"],["私","わたくし"],["に"],["与えられた","あたえられた"],["この"],["恵み","めぐみ"],["を"],["認め","みとめ"],["、"],["柱","はしら"],["として"],["重んじられて","おもんじられて"],["いる"],["ヤコブ"],["と"],["ケパ"],["と"],["ヨハネ"],["が"],["、"],["私","わたくし"],["と"],["バルナバ"],["に"],["、"],["交わり","まじわり"],["の"],["しるし"],["として"],["右手","みぎて"],["を"],["差し伸べました","さしのべました"],["。"],["それ"],["は"],["、"],["私たち","わたしたち"],["が"],["異邦人","いほうじん"],["の"],["ところ"],["へ"],["行き","いき"],["、"],["彼","かれ"],["ら"],["が"],["割礼","かつれい"],["を"],["受けた","うけた"],["人々","ひとびと"],["の"],["ところ"],["へ"],["行く","いく"],["ため"],["です"],["。"]]},{"verse":10,"text":"ただ私たちが貧しい人たちをいつも顧みるようにとのことでしたが、そのことなら私も大いに努めて来たところです。","tok":[["ただ"],["私たち","わたしたち"],["が"],["貧しい","まずしい"],["人","ひと"],["たち"],["を"],["いつも"],["顧みる","かえりみる"],["よう"],["に"],["と"],["の"],["こと"],["でした"],["が"],["、"],["その"],["こと"],["なら"],["私","わたくし"],["も"],["大いに","おおいに"],["努めて","つとめて"],["来た","きた"],["ところ"],["です"],["。"]]},{"verse":11,"text":"ところが、ケパがアンテオケに来たとき、彼に非難すべきことがあったので、私は面と向かって抗議しました。","tok":[["ところ"],["が"],["、"],["ケパ"],["が"],["アンテオケ"],["に"],["来た","きた"],["とき"],["、"],["彼","かれ"],["に"],["非難","ひなん"],["すべき"],["こと"],["が"],["あった"],["ので"],["、"],["私","わたくし"],["は"],["面","めん"],["と"],["向かって","むかって"],["抗議","こうぎ"],["しました"],["。"]]},{"verse":12,"text":"なぜなら、彼は、ある人々がヤコブのところから来る前は異邦人といっしょに食事をしていたのに、その人々が来ると、割礼派の人々を恐れて、だんだんと異邦人から身を引き、離れて行ったからです。","tok":[["なぜ"],["なら"],["、"],["彼","かれ"],["は"],["、"],["ある"],["人々","ひとびと"],["が"],["ヤコブ"],["の"],["ところ"],["から"],["来る","くる"],["前","まえ"],["は"],["異邦人","いほうじん"],["と"],["いっしょ"],["に"],["食事","しょくじ"],["を"],["して"],["いた"],["のに"],["、"],["その"],["人々","ひとびと"],["が"],["来る","くる"],["と"],["、"],["割礼派","かつれいは"],["の"],["人々","ひとびと"],["を"],["恐れて","おそれて"],["、"],["だんだん"],["と"],["異邦人","いほうじん"],["から"],["身","み"],["を"],["引き","ひき"],["、"],["離れて","はなれて"],["行った","いった"],["から"],["です"],["。"]]},{"verse":13,"text":"そして、ほかのユダヤ人たちも、彼といっしょに本心を偽った行動をとり、バルナバまでもその偽りの行動に引き込まれてしまいました。","tok":[["そして"],["、"],["ほか"],["の"],["ユダヤ人","ゆだやじん"],["たち"],["も"],["、"],["彼","かれ"],["と"],["いっしょ"],["に"],["本心","ほんしん"],["を"],["偽った","いつわった"],["行動","こうどう"],["を"],["とり"],["、"],["バルナバ"],["まで"],["も"],["その"],["偽り","いつわり"],["の"],["行動","こうどう"],["に"],["引き込まれて","ひきこまれて"],["しまいました"],["。"]]},{"verse":14,"text":"しかし、彼らが福音の真理についてまっすぐに歩んでいないのを見て、私はみなの面前でケパにこう言いました。「あなたは、自分がユダヤ人でありながらユダヤ人のようには生活せず、異邦人のように生活していたのに、どうして異邦人に対して、ユダヤ人の生活を強いるのですか。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["が"],["福音","ふくいん"],["の"],["真理","しんり"],["について"],["まっすぐ"],["に"],["歩んで","あゆんで"],["いない"],["の"],["を"],["見て","みて"],["、"],["私","わたくし"],["は"],["みな"],["の"],["面前","めんぜん"],["で"],["ケパ"],["に"],["こう"],["言いました","いいました"],["。"],["「"],["あなた"],["は"],["、"],["自分","じぶん"],["が"],["ユダヤ人","ゆだやじん"],["で"],["あり"],["ながら"],["ユダヤ人","ゆだやじん"],["の"],["よう"],["に"],["は"],["生活","せいかつ"],["せず"],["、"],["異邦人","いほうじん"],["の"],["よう"],["に"],["生活","せいかつ"],["して"],["いた"],["のに"],["、"],["どう"],["して"],["異邦人","いほうじん"],["に対して","にたいして"],["、"],["ユダヤ人","ゆだやじん"],["の"],["生活","せいかつ"],["を"],["強いる","しいる"],["の"],["です"],["か"],["。"]]},{"verse":15,"text":"私たちは、生まれながらのユダヤ人であって、異邦人のような罪人ではありません。","tok":[["私たち","わたしたち"],["は"],["、"],["生まれ","うまれ"],["ながら"],["の"],["ユダヤ人","ゆだやじん"],["で"],["あって"],["、"],["異邦人","いほうじん"],["の"],["よう"],["な"],["罪人","ざいにん"],["で"],["は"],["ありません"],["。"]]},{"verse":16,"text":"しかし、人は律法の行いによっては義と認められず、ただキリスト・イエスを信じる信仰によって義と認められる、ということを知ったからこそ、私たちもキリスト・イエスを信じたのです。これは、律法の行いによってではなく、キリストを信じる信仰によって義と認められるためです。なぜなら、律法の行いによって義と認められる者は、ひとりもいないからです。","tok":[["しかし"],["、"],["人","ひと"],["は"],["律法","りっぽう"],["の"],["行い","おこない"],["によって"],["は"],["義","ぎ"],["と"],["認められず","みとめられず"],["、"],["ただ"],["キリスト"],["・"],["イエス"],["を"],["信じる","しんじる"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["認められる","みとめられる"],["、"],["と"],["いう"],["こと"],["を"],["知った","しった"],["から"],["こそ"],["、"],["私たち","わたしたち"],["も"],["キリスト"],["・"],["イエス"],["を"],["信じた","しんじた"],["の"],["です"],["。"],["これ"],["は"],["、"],["律法","りっぽう"],["の"],["行い","おこない"],["によって"],["で"],["は"],["なく"],["、"],["キリスト"],["を"],["信じる","しんじる"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["認められる","みとめられる"],["ため"],["です"],["。"],["なぜ"],["なら"],["、"],["律法","りっぽう"],["の"],["行い","おこない"],["によって"],["義","ぎ"],["と"],["認められる","みとめられる"],["者","もの"],["は"],["、"],["ひとり"],["も"],["いない"],["から"],["です"],["。"]]},{"verse":17,"text":"しかし、もし私たちが、キリストにあって義と認められることを求めながら、私たち自身も罪人であることがわかるのなら、キリストは罪の助成者なのでしょうか。そんなことは絶対にありえないことです。","tok":[["しかし"],["、"],["もし"],["私たち","わたしたち"],["が"],["、"],["キリスト"],["に"],["あって"],["義","ぎ"],["と"],["認められる","みとめられる"],["こと"],["を"],["求め","もとめ"],["ながら"],["、"],["私たち","わたしたち"],["自身","じしん"],["も"],["罪人","ざいにん"],["で"],["ある"],["こと"],["が"],["わかる"],["の"],["なら"],["、"],["キリスト"],["は"],["罪","つみ"],["の"],["助成者","じょせいしゃ"],["な"],["の"],["でしょう"],["か"],["。"],["そんな"],["こと"],["は"],["絶対","ぜったい"],["に"],["あり"],["えない"],["こと"],["です"],["。"]]},{"verse":18,"text":"けれども、もし私が前に打ちこわしたものをもう一度建てるなら、私は自分自身を違反者にしてしまうのです。","tok":[["けれど"],["も"],["、"],["もし"],["私","わたくし"],["が"],["前","まえ"],["に"],["打ちこわした","うちこわした"],["もの"],["を"],["もう"],["一度","いちど"],["建てるなら","たてるなら"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["違反者","いはんしゃ"],["に"],["して"],["しまう"],["の"],["です"],["。"]]},{"verse":19,"text":"しかし私は、神に生きるために、律法によって律法に死にました。","tok":[["しかし"],["私","わたくし"],["は"],["、"],["神","かみ"],["に"],["生きる","いきる"],["ため"],["に"],["、"],["律法","りっぽう"],["によって"],["律法","りっぽう"],["に"],["死にました","しにました"],["。"]]},{"verse":20,"text":"私はキリストとともに十字架につけられました。もはや私が生きているのではなく、キリストが私のうちに生きておられるのです。いま私が肉にあって生きているのは、私を愛し私のためにご自身をお捨てになった神の御子を信じる信仰によっているのです。","tok":[["私","わたくし"],["は"],["キリスト"],["と"],["とも"],["に"],["十字架","じゅうじか"],["に"],["つけられました"],["。"],["もはや"],["私","わたくし"],["が"],["生きて","いきて"],["いる"],["ので"],["は"],["なく"],["、"],["キリスト"],["が"],["私","わたくし"],["の"],["うち"],["に"],["生きて","いきて"],["おられる"],["の"],["です"],["。"],["いま"],["私","わたくし"],["が"],["肉","にく"],["に"],["あって"],["生きて","いきて"],["いる"],["の"],["は"],["、"],["私","わたくし"],["を"],["愛し","あいし"],["私","わたくし"],["の"],["ため"],["に"],["ご自身","ごじしん"],["を"],["お捨て","おすて"],["に"],["なった"],["神","かみ"],["の"],["御子","みこ"],["を"],["信じる","しんじる"],["信仰","しんこう"],["によって"],["いる"],["の"],["です"],["。"]]},{"verse":21,"text":"私は神の恵みを無にはしません。もし義が律法によって得られるとしたら、それこそキリストの死は無意味です。」","tok":[["私","わたくし"],["は"],["神","かみ"],["の"],["恵み","めぐみ"],["を"],["無","む"],["に"],["は"],["しません"],["。"],["もし"],["義","ぎ"],["が"],["律法","りっぽう"],["によって"],["得られる","えられる"],["と"],["したら"],["、"],["それ"],["こそ"],["キリスト"],["の"],["死","し"],["は"],["無意味","むいみ"],["です"],["。"],["」"]]}]
[{"verse":1,"text":"兄弟たちよ。もしだれかがあやまちに陥ったなら、御霊の人であるあなたがたは、柔和な心でその人を正してあげなさい。また、自分自身も誘惑に陥らないように気をつけなさい。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["もし"],["だれ"],["か"],["が"],["あやまち"],["に"],["陥ったなら","おちいったなら"],["、"],["御霊","ごれい"],["の"],["人","ひと"],["で"],["ある"],["あなた"],["がた"],["は"],["、"],["柔和","にゅうわ"],["な"],["心","こころ"],["で"],["その"],["人","ひと"],["を"],["正して","ただして"],["あげ"],["なさい"],["。"],["また"],["、"],["自分","じぶん"],["自身","じしん"],["も"],["誘惑","ゆうわく"],["に"],["陥らない","おちいらない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":2,"text":"互いの重荷を負い合い、そのようにしてキリストの律法を全うしなさい。","tok":[["互い","たがい"],["の"],["重荷","おもに"],["を"],["負い","おい"],["合い","あい"],["、"],["その"],["よう"],["に"],["して"],["キリスト"],["の"],["律法","りっぽう"],["を"],["全う","まっとう"],["し"],["なさい"],["。"]]},{"verse":3,"text":"だれでも、りっぱでもない自分を何かりっぱでもあるかのように思うなら、自分を欺いているのです。","tok":[["だれ"],["で"],["も"],["、"],["りっぱ"],["で"],["も"],["ない"],["自分","じぶん"],["を"],["何","なん"],["か"],["りっぱ"],["で"],["も"],["ある"],["か"],["の"],["よう"],["に"],["思うなら","おもうなら"],["、"],["自分","じぶん"],["を"],["欺いて","あざむいて"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"おのおの自分の行いをよく調べてみなさい。そうすれば、誇れると思ったことも、ただ自分だけの誇りで、ほかの人に対して誇れることではないでしょう。","tok":[["おのおの"],["自分","じぶん"],["の"],["行い","おこない"],["を"],["よく"],["調べて","しらべて"],["み"],["なさい"],["。"],["そう"],["すれば"],["、"],["誇れる","ほこれる"],["と"],["思った","おもった"],["こと"],["も"],["、"],["ただ"],["自分","じぶん"],["だけ"],["の"],["誇り","ほこり"],["で"],["、"],["ほか"],["の"],["人","ひと"],["に対して","にたいして"],["誇れる","ほこれる"],["こと"],["で"],["は"],["ないでしょう"],["。"]]},{"verse":5,"text":"人にはおのおの、負うべき自分自身の重荷があるのです。","tok":[["人","ひと"],["に"],["は"],["おのおの"],["、"],["負うべき","おうべき"],["自分","じぶん"],["自身","じしん"],["の"],["重荷","おもに"],["が"],["ある"],["の"],["です"],["。"]]},{"verse":6,"text":"みことばを教えられる人は、教える人とすべての良いものを分け合いなさい。","tok":[["みことば"],["を"],["教えられる","おしえられる"],["人","ひと"],["は"],["、"],["教える","おしえる"],["人","ひと"],["と"],["すべて"],["の"],["良い","よい"],["もの"],["を"],["分け合い","わけあい"],["なさい"],["。"]]},{"verse":7,"text":"思い違いをしてはいけません。神は侮られるような方ではありません。人は種を蒔けば、その刈り取りもすることになります。","tok":[["思い違い","おもいちがい"],["を"],["して"],["は"],["いけません"],["。"],["神","かみ"],["は"],["侮られる","あなどられる"],["よう"],["な"],["方","かた"],["で"],["は"],["ありません"],["。"],["人","ひと"],["は"],["種","しゅ"],["を"],["蒔けば","まけば"],["、"],["その"],["刈り取り","かりとり"],["も"],["する"],["こと"],["に"],["なります"],["。"]]},{"verse":8,"text":"自分の肉のために蒔く者は、肉から滅びを刈り取り、御霊のために蒔く者は、御霊から永遠のいのちを刈り取るのです。","tok":[["自分","じぶん"],["の"],["肉","にく"],["の"],["ため"],["に"],["蒔く","まく"],["者","もの"],["は"],["、"],["肉","にく"],["から"],["滅び","ほろび"],["を"],["刈り取り","かりとり"],["、"],["御霊","ごれい"],["の"],["ため"],["に"],["蒔く","まく"],["者","もの"],["は"],["、"],["御霊","ごれい"],["から"],["永遠","えいえん"],["の"],["いのち"],["を"],["刈り取る","かりとる"],["の"],["です"],["。"]]},{"verse":9,"text":"善を行うのに飽いてはいけません。失望せずにいれば、時期が来て、刈り取ることになります。","tok":[["善","ぜん"],["を"],["行う","おこなう"],["のに"],["飽い","あい"],["ては"],["いけません"],["。"],["失望","しつぼう"],["せず"],["に"],["いれば"],["、"],["時期","じき"],["が"],["来て","きて"],["、"],["刈り取る","かりとる"],["こと"],["に"],["なります"],["。"]]},{"verse":10,"text":"ですから、私たちは、機会のあるたびに、すべての人に対して、特に信仰の家族の人たちに善を行いましょう。","tok":[["です"],["から"],["、"],["私たち","わたしたち"],["は"],["、"],["機会","きかい"],["の"],["ある"],["たび"],["に"],["、"],["すべて"],["の"],["人","ひと"],["に対して","にたいして"],["、"],["特に","とくに"],["信仰","しんこう"],["の"],["家族","かぞく"],["の"],["人","ひと"],["たち"],["に"],["善","ぜん"],["を"],["行いましょう","おこないましょう"],["。"]]},{"verse":11,"text":"ご覧のとおり、私は今こんなに大きな字で、自分のこの手であなたがたに書いています。","tok":[["ご覧","ごらん"],["の"],["とおり"],["、"],["私","わたくし"],["は"],["今","いま"],["こんな"],["に"],["大きな","おおきな"],["字","じ"],["で"],["、"],["自分","じぶん"],["の"],["この"],["手","て"],["で"],["あなた"],["がた"],["に"],["書いて","かいて"],["います"],["。"]]},{"verse":12,"text":"あなたがたに割礼を強制する人たちは、肉において外見を良くしたい人たちです。彼らはただ、キリストの十字架のために迫害を受けたくないだけなのです。","tok":[["あなた"],["がた"],["に"],["割礼","かつれい"],["を"],["強制","きょうせい"],["する"],["人","ひと"],["たち"],["は"],["、"],["肉","にく"],["に"],["おいて"],["外見","がいけん"],["を"],["良く","よく"],["したい"],["人","ひと"],["たち"],["です"],["。"],["彼","かれ"],["ら"],["は"],["ただ"],["、"],["キリスト"],["の"],["十字架","じゅうじか"],["の"],["ため"],["に"],["迫害","はくがい"],["を"],["受けたく","うけたく"],["ない"],["だけ"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"なぜなら、割礼を受けた人たちは、自分自身が律法を守っていません。それなのに彼らがあなたがたに割礼を受けさせようとするのは、あなたがたの肉を誇りたいためなのです。","tok":[["なぜ"],["なら"],["、"],["割礼","かつれい"],["を"],["受けた","うけた"],["人","ひと"],["たち"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["が"],["律法","りっぽう"],["を"],["守って","まもって"],["いません"],["。"],["それ"],["な"],["のに"],["彼","かれ"],["ら"],["が"],["あなた"],["がた"],["に"],["割礼","かつれい"],["を"],["受けさせよう","うけさせよう"],["と"],["する"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["肉","にく"],["を"],["誇りたい","ほこりたい"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":14,"text":"しかし私には、私たちの主イエス・キリストの十字架以外に誇りとするものが決してあってはなりません。この十字架によって、世界は私に対して十字架につけられ、私も世界に対して十字架につけられたのです。","tok":[["しかし"],["私","わたくし"],["に"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["十字架","じゅうじか"],["以外","いがい"],["に"],["誇り","ほこり"],["と"],["する"],["もの"],["が"],["決して","けっして"],["あって"],["は"],["なりません"],["。"],["この"],["十字架","じゅうじか"],["によって"],["、"],["世界","せかい"],["は"],["私","わたくし"],["に対して","にたいして"],["十字架","じゅうじか"],["に"],["つけられ"],["、"],["私","わたくし"],["も"],["世界","せかい"],["に対して","にたいして"],["十字架","じゅうじか"],["に"],["つけられた"],["の"],["です"],["。"]]},{"verse":15,"text":"割礼を受けているか受けていないかは、大事なことではありません。大事なのは新しい創造です。","tok":[["割礼","かつれい"],["を"],["受けて","うけて"],["いる"],["か"],["受けて","うけて"],["いない"],["か"],["は"],["、"],["大事","だいじ"],["な"],["こと"],["で"],["は"],["ありません"],["。"],["大事","だいじ"],["な"],["の"],["は"],["新しい","あたらしい"],["創造","そうぞう"],["です"],["。"]]},{"verse":16,"text":"どうか、この基準に従って進む人々、すなわち神のイスラエルの上に、平安とあわれみがありますように。","tok":[["どう"],["か"],["、"],["この"],["基準","きじゅん"],["に"],["従って","したがって"],["進む","すすむ"],["人々","ひとびと"],["、"],["すなわち"],["神","かみ"],["の"],["イスラエル"],["の"],["上","うえ"],["に"],["、"],["平安","へいあん"],["と"],["あわれみ"],["が"],["あります"],["よう"],["に"],["。"]]},{"verse":17,"text":"これからは、だれも私を煩わさないようにしてください。私は、この身に、イエスの焼き印を帯びているのですから。","tok":[["これ"],["から"],["は"],["、"],["だれ"],["も"],["私","わたくし"],["を"],["煩わさない","わずらわさない"],["よう"],["に"],["して"],["ください"],["。"],["私","わたくし"],["は"],["、"],["この"],["身","み"],["に"],["、"],["イエス"],["の"],["焼き印","やきいん"],["を"],["帯びて","おびて"],["いる"],["の"],["です"],["から"],["。"]]},{"verse":18,"text":"どうか、私たちの主イエス・キリストの恵みが、兄弟たちよ、あなたがたの霊とともにありますように。アーメン。
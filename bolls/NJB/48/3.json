[{"verse":1,"text":"ああ愚かなガラテヤ人。十字架につけられたイエス・キリストが、あなたがたの目の前に、あんなにはっきり示されたのに、だれがあなたがたを迷わせたのですか。","tok":[["ああ"],["愚か","おろか"],["な"],["ガラテヤ"],["人","にん"],["。"],["十字架","じゅうじか"],["に"],["つけられた"],["イエス"],["・"],["キリスト"],["が"],["、"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["に"],["、"],["あんな"],["に"],["はっきり"],["示された","しめされた"],["のに"],["、"],["だれ"],["が"],["あなた"],["がた"],["を"],["迷わせた","まよわせた"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"ただこれだけをあなたがたから聞いておきたい。あなたがたが御霊を受けたのは、律法を行ったからですか。それとも信仰をもって聞いたからですか。","tok":[["ただ"],["これ"],["だけ"],["を"],["あなた"],["がた"],["から"],["聞いて","きいて"],["おきたい"],["。"],["あなた"],["がた"],["が"],["御霊","ごれい"],["を"],["受けた","うけた"],["の"],["は"],["、"],["律法","りっぽう"],["を"],["行った","おこなった"],["から"],["です"],["か"],["。"],["それ"],["と"],["も"],["信仰","しんこう"],["を"],["もって"],["聞いた","きいた"],["から"],["です"],["か"],["。"]]},{"verse":3,"text":"あなたがたはどこまで道理がわからないのですか。御霊で始まったあなたがたが、いま肉によって完成されるというのですか。","tok":[["あなた"],["がた"],["は"],["どこ"],["まで"],["道理","どうり"],["が"],["わからない"],["の"],["です"],["か"],["。"],["御霊","ごれい"],["で"],["始まった","はじまった"],["あなた"],["が"],["た"],["が"],["、"],["いま"],["肉","にく"],["によって"],["完成","かんせい"],["される"],["と"],["いう"],["の"],["です"],["か"],["。"]]},{"verse":4,"text":"あなたがたがあれほどのことを経験したのは、むだだったのでしょうか。万が一にもそんなことはないでしょうが。","tok":[["あなた"],["がた"],["が"],["あれ"],["ほど"],["の"],["こと"],["を"],["経験","けいけん"],["した"],["の"],["は"],["、"],["むだ"],["だった"],["の"],["でしょう"],["か"],["。"],["万が一","まんがいち"],["に"],["も"],["そんな"],["こと"],["は"],["ないでしょう"],["が"],["。"]]},{"verse":5,"text":"とすれば、あなたがたに御霊を与え、あなたがたの間で奇蹟を行われた方は、あなたがたが律法を行ったから、そうなさったのですか。それともあなたがたが信仰をもって聞いたからですか。","tok":[["と"],["すれば"],["、"],["あなた"],["がた"],["に"],["御霊","ごれい"],["を"],["与え","あたえ"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["奇蹟","きせき"],["を"],["行われた","おこなわれた"],["方","ほう"],["は"],["、"],["あなた"],["がた"],["が"],["律法","りっぽう"],["を"],["行った","おこなった"],["から"],["、"],["そう"],["なさった"],["の"],["です"],["か"],["。"],["それ"],["と"],["も"],["あなた"],["がた"],["が"],["信仰","しんこう"],["を"],["もって"],["聞いた","きいた"],["から"],["です"],["か"],["。"]]},{"verse":6,"text":"アブラハムは神を信じ、それが彼の義とみなされました。それと同じことです。","tok":[["アブラハム"],["は"],["神","かみ"],["を"],["信じ","しんじ"],["、"],["それ"],["が"],["彼","かれ"],["の"],["義","ぎ"],["と"],["みなされました"],["。"],["それ"],["と"],["同じ","おなじ"],["こと"],["です"],["。"]]},{"verse":7,"text":"ですから、信仰による人々こそアブラハムの子孫だと知りなさい。","tok":[["です"],["から"],["、"],["信仰","しんこう"],["に"],["よる"],["人々","ひとびと"],["こそ"],["アブラハム"],["の"],["子孫","しそん"],["だ"],["と"],["知り","しり"],["なさい"],["。"]]},{"verse":8,"text":"聖書は、神が異邦人をその信仰によって義と認めてくださることを、前から知っていたので、アブラハムに対し、「あなたによってすべての国民が祝福される」と前もって福音を告げたのです。","tok":[["聖書","せいしょ"],["は"],["、"],["神","かみ"],["が"],["異邦人","いほうじん"],["を"],["その"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["認めて","みとめて"],["くださる"],["こと"],["を"],["、"],["前","まえ"],["から"],["知って","しって"],["いた"],["ので"],["、"],["アブラハム"],["に"],["対し","たいし"],["、"],["「"],["あなた"],["によって"],["すべて"],["の"],["国民","こくみん"],["が"],["祝福","しゅくふく"],["される"],["」"],["と"],["前もって","まえもって"],["福音","ふくいん"],["を"],["告げた","つげた"],["の"],["です"],["。"]]},{"verse":9,"text":"そういうわけで、信仰による人々が、信仰の人アブラハムとともに、祝福を受けるのです。","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["信仰","しんこう"],["に"],["よる"],["人々","ひとびと"],["が"],["、"],["信仰","しんこう"],["の"],["人","ひと"],["アブラハム"],["と"],["とも"],["に"],["、"],["祝福","しゅくふく"],["を"],["受ける","うける"],["の"],["です"],["。"]]},{"verse":10,"text":"というのは、律法の行いによる人々はすべて、のろいのもとにあるからです。こう書いてあります。「律法の書に書いてある、すべてのことを堅く守って実行しなければ、だれでもみな、のろわれる。」","tok":[["と"],["いう"],["の"],["は"],["、"],["律法","りっぽう"],["の"],["行い","おこない"],["に"],["よる"],["人々","ひとびと"],["は"],["すべて"],["、"],["のろい"],["の"],["もと"],["に"],["ある"],["から"],["です"],["。"],["こう"],["書いて","かいて"],["あります"],["。"],["「"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["書いて","かいて"],["ある"],["、"],["すべて"],["の"],["こと"],["を"],["堅く","かたく"],["守って","まもって"],["実行","じっこう"],["しなければ"],["、"],["だれ"],["で"],["も"],["みな"],["、"],["のろわれる"],["。"],["」"]]},{"verse":11,"text":"ところが、律法によって神の前に義と認められる者が、だれもいないということは明らかです。「義人は信仰によって生きる」のだからです。","tok":[["ところ"],["が"],["、"],["律法","りっぽう"],["によって"],["神","かみ"],["の"],["前","まえ"],["に"],["義","ぎ"],["と"],["認められる","みとめられる"],["者","もの"],["が"],["、"],["だれ"],["も"],["いない"],["と"],["いう"],["こと"],["は"],["明らか","あきらか"],["です"],["。"],["「"],["義人","ぎじん"],["は"],["信仰","しんこう"],["によって"],["生きる","いきる"],["」"],["の"],["だ"],["から"],["です"],["。"]]},{"verse":12,"text":"しかし律法は、「信仰による」のではありません。「律法を行う者はこの律法によって生きる」のです。","tok":[["しかし"],["律法","りっぽう"],["は"],["、"],["「"],["信仰","しんこう"],["に"],["よる"],["」"],["ので"],["は"],["ありません"],["。"],["「"],["律法","りっぽう"],["を"],["行う","おこなう"],["者","もの"],["は"],["この"],["律法","りっぽう"],["によって"],["生きる","いきる"],["」"],["の"],["です"],["。"]]},{"verse":13,"text":"キリストは、私たちのためにのろわれたものとなって、私たちを律法ののろいから贖い出してくださいました。なぜなら、「木にかけられる者はすべてのろわれたものである」と書いてあるからです。","tok":[["キリスト"],["は"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["のろわれた"],["もの"],["と"],["なって"],["、"],["私たち","わたしたち"],["を"],["律法","りっぽう"],["の"],["のろい"],["から"],["贖い","あがない"],["出して","だして"],["くださいました"],["。"],["なぜ"],["なら"],["、"],["「"],["木","き"],["に"],["かけられる"],["者","もの"],["は"],["すべて"],["のろわれた"],["もの"],["で"],["ある"],["」"],["と"],["書いて","かいて"],["ある"],["から"],["です"],["。"]]},{"verse":14,"text":"このことは、アブラハムへの祝福が、キリスト・イエスによって異邦人に及ぶためであり、その結果、私たちが信仰によって約束の御霊を受けるためなのです。","tok":[["この"],["こと"],["は"],["、"],["アブラハム"],["へ"],["の"],["祝福","しゅくふく"],["が"],["、"],["キリスト"],["・"],["イエス"],["によって"],["異邦人","いほうじん"],["に"],["及ぶ","およぶ"],["ため"],["で"],["あり"],["、"],["その"],["結果","けっか"],["、"],["私たち","わたしたち"],["が"],["信仰","しんこう"],["によって"],["約束","やくそく"],["の"],["御霊","ごれい"],["を"],["受ける","うける"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":15,"text":"兄弟たち。人間の場合にたとえてみましょう。人間の契約でも、いったん結ばれたら、だれもそれを無効にしたり、それにつけ加えたりはしません。","tok":[["兄弟","きょうだい"],["たち"],["。"],["人間","にんげん"],["の"],["場合","ばあい"],["に"],["たとえて"],["みましょう"],["。"],["人間","にんげん"],["の"],["契約","けいやく"],["で"],["も"],["、"],["いったん"],["結ばれたら","むすばれたら"],["、"],["だれ"],["も"],["それ"],["を"],["無効","むこう"],["に"],["し"],["たり"],["、"],["それ"],["に"],["つけ加え","つけくわえ"],["たり"],["は"],["しません"],["。"]]},{"verse":16,"text":"ところで、約束は、アブラハムとそのひとりの子孫に告げられました。神は「子孫たちに」と言って、多数をさすことはせず、ひとりをさして、「あなたの子孫に」と言っておられます。その方はキリストです。","tok":[["ところ"],["で"],["、"],["約束","やくそく"],["は"],["、"],["アブラハム"],["と"],["その"],["ひとり"],["の"],["子孫","しそん"],["に"],["告げられました","つげられました"],["。"],["神","かみ"],["は"],["「"],["子孫","しそん"],["たち"],["に"],["」"],["と"],["言って","いって"],["、"],["多数","たすう"],["を"],["さす"],["こと"],["は"],["せず"],["、"],["ひとり"],["を"],["さして"],["、"],["「"],["あなた"],["の"],["子孫","しそん"],["に"],["」"],["と"],["言って","いって"],["おられます"],["。"],["その"],["方","かた"],["は"],["キリスト"],["です"],["。"]]},{"verse":17,"text":"私の言おうとすることはこうです。先に神によって結ばれた契約は、その後四百三十年たってできた律法によって取り消されたり、その約束が無効とされたりすることがないということです。","tok":[["私","わたくし"],["の"],["言おう","いおう"],["と"],["する"],["こと"],["は"],["こう"],["です"],["。"],["先","さき"],["に"],["神","かみ"],["によって"],["結ばれた","むすばれた"],["契約","けいやく"],["は"],["、"],["その"],["後","ご"],["四百三十","よんひゃくさんじゅう"],["年","ねん"],["たって"],["できた"],["律法","りっぽう"],["によって"],["取り消され","とりけされ"],["たり"],["、"],["その"],["約束","やくそく"],["が"],["無効","むこう"],["と"],["され"],["たり"],["する"],["こと"],["が"],["ない"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":18,"text":"なぜなら、相続がもし律法によるのなら、もはや約束によるのではないからです。ところが、神は約束を通してアブラハムに相続の恵みを下さったのです。","tok":[["なぜ"],["なら"],["、"],["相続","そうぞく"],["が"],["もし"],["律法","りっぽう"],["に"],["よる"],["の"],["なら"],["、"],["もはや"],["約束","やくそく"],["に"],["よる"],["ので"],["は"],["ない"],["から"],["です"],["。"],["ところ"],["が"],["、"],["神","かみ"],["は"],["約束","やくそく"],["を"],["通して","とおして"],["アブラハム"],["に"],["相続","そうぞく"],["の"],["恵み","めぐみ"],["を"],["下さった","くださった"],["の"],["です"],["。"]]},{"verse":19,"text":"では、律法とは何でしょうか。それは約束をお受けになった、この子孫が来られるときまで、違反を示すためにつけ加えられたもので、御使いたちを通して仲介者の手で定められたのです。","tok":[["で"],["は"],["、"],["律法","りっぽう"],["と"],["は"],["何","なん"],["でしょう"],["か"],["。"],["それ"],["は"],["約束","やくそく"],["を"],["お受け","おうけ"],["に"],["なった"],["、"],["この"],["子孫","しそん"],["が"],["来られる","こられる"],["とき"],["まで"],["、"],["違反","いはん"],["を"],["示す","しめす"],["ため"],["に"],["つけ加えられた","つけくわえられた"],["もの"],["で"],["、"],["御使い","おつかい"],["たち"],["を"],["通して","とおして"],["仲介者","ちゅうかいしゃ"],["の"],["手","て"],["で"],["定められた","さだめられた"],["の"],["です"],["。"]]},{"verse":20,"text":"仲介者は一方だけに属するものではありません。しかし約束を賜る神は唯一者です。","tok":[["仲介者","ちゅうかいしゃ"],["は"],["一方","いっぽう"],["だけ"],["に"],["属する","ぞくする"],["もの"],["で"],["は"],["ありません"],["。"],["しかし"],["約束","やくそく"],["を"],["賜る","たまわる"],["神","かみ"],["は"],["唯一者","ゆいいつしゃ"],["です"],["。"]]},{"verse":21,"text":"とすると、律法は神の約束に反するのでしょうか。絶対にそんなことはありません。もしも、与えられた律法がいのちを与えることのできるものであったなら、義は確かに律法によるものだったでしょう。","tok":[["と"],["する"],["と"],["、"],["律法","りっぽう"],["は"],["神","かみ"],["の"],["約束","やくそく"],["に"],["反する","はんする"],["の"],["でしょう"],["か"],["。"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"],["もし"],["も"],["、"],["与えられた","あたえられた"],["律法","りっぽう"],["が"],["いのち"],["を"],["与える","あたえる"],["こと"],["の"],["できる"],["もの"],["で"],["あったなら"],["、"],["義","ぎ"],["は"],["確か","たしか"],["に"],["律法","りっぽう"],["に"],["よる"],["もの"],["だったでしょう"],["。"]]},{"verse":22,"text":"しかし聖書は、逆に、すべての人を罪の下に閉じ込めました。それは約束が、イエス・キリストに対する信仰によって、信じる人々に与えられるためです。","tok":[["しかし"],["聖書","せいしょ"],["は"],["、"],["逆","ぎゃく"],["に"],["、"],["すべて"],["の"],["人","ひと"],["を"],["罪","つみ"],["の"],["下","した"],["に"],["閉じ込めました","とじこめました"],["。"],["それ"],["は"],["約束","やくそく"],["が"],["、"],["イエス"],["・"],["キリスト"],["に"],["対する","たいする"],["信仰","しんこう"],["によって"],["、"],["信じる","しんじる"],["人々","ひとびと"],["に"],["与えられる","あたえられる"],["ため"],["です"],["。"]]},{"verse":23,"text":"信仰が現れる以前には、私たちは律法の監督の下に置かれ、閉じ込められていましたが、それは、やがて示される信仰が得られるためでした。","tok":[["信仰","しんこう"],["が"],["現れる","あらわれる"],["以前","いぜん"],["に"],["は"],["、"],["私たち","わたしたち"],["は"],["律法","りっぽう"],["の"],["監督","かんとく"],["の"],["下","した"],["に"],["置かれ","おかれ"],["、"],["閉じ込められて","とじこめられて"],["いました"],["が"],["、"],["それ"],["は"],["、"],["やがて"],["示される","しめされる"],["信仰","しんこう"],["が"],["得られる","えられる"],["ため"],["でした"],["。"]]},{"verse":24,"text":"こうして、律法は私たちをキリストへ導くための私たちの養育係となりました。私たちが信仰によって義と認められるためなのです。","tok":[["こう"],["して"],["、"],["律法","りっぽう"],["は"],["私たち","わたしたち"],["を"],["キリスト"],["へ"],["導く","みちびく"],["ため"],["の"],["私たち","わたしたち"],["の"],["養育","よういく"],["係","かかり"],["と"],["なりました"],["。"],["私たち","わたしたち"],["が"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["認められる","みとめられる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":25,"text":"しかし、信仰が現れた以上、私たちはもはや養育係の下にはいません。","tok":[["しかし"],["、"],["信仰","しんこう"],["が"],["現れた","あらわれた"],["以上","いじょう"],["、"],["私たち","わたしたち"],["は"],["もはや"],["養育","よういく"],["係","かかり"],["の"],["下","した"],["に"],["は"],["いません"],["。"]]},{"verse":26,"text":"あなたがたはみな、キリスト・イエスに対する信仰によって、神の子どもです。","tok":[["あなた"],["がた"],["は"],["みな"],["、"],["キリスト"],["・"],["イエス"],["に"],["対する","たいする"],["信仰","しんこう"],["によって"],["、"],["神","かみ"],["の"],["子ども","こども"],["です"],["。"]]},{"verse":27,"text":"バプテスマを受けてキリストにつく者とされたあなたがたはみな、キリストをその身に着たのです。","tok":[["バプテスマ"],["を"],["受けて","うけて"],["キリスト"],["に"],["つく"],["者","もの"],["と"],["された"],["あなた"],["がた"],["は"],["みな"],["、"],["キリスト"],["を"],["その"],["身","み"],["に"],["着た","きた"],["の"],["です"],["。"]]},{"verse":28,"text":"ユダヤ人もギリシヤ人もなく、奴隷も自由人もなく、男子も女子もありません。なぜなら、あなたがたはみな、キリスト・イエスにあって、一つだからです。","tok":[["ユダヤ人","ゆだやじん"],["も"],["ギリシヤ"],["人","にん"],["も"],["なく"],["、"],["奴隷","どれい"],["も"],["自由人","じゆうにん"],["も"],["なく"],["、"],["男子","だんし"],["も"],["女子","じょし"],["も"],["ありません"],["。"],["なぜ"],["なら"],["、"],["あなた"],["がた"],["は"],["みな"],["、"],["キリスト"],["・"],["イエス"],["に"],["あって"],["、"],["一","ひと"],["つ"],["だ"],["から"],["です"],["。"]]},{"verse":29,"text":"もしあなたがたがキリストのものであれば、それによってアブラハムの子孫であり、約束による相続人なのです。","tok":[["もし"],["あなた"],["がた"],["が"],["キリスト"],["の"],["もの"],["で"],["あれば"],["、"],["それ"],["によって"],["アブラハム"],["の"],["子孫","しそん"],["で"],["あり"],["、"],["約束","やくそく"],["に"],["よる"],["相続人","そうぞくにん"],["な"],["の"],["です"],["。"]]}]
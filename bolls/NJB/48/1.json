[{"verse":1,"text":"使徒となったパウロ――私が使徒となったのは、人間から出たことでなく、また人間の手を通したことでもなく、イエス・キリストと、キリストを死者の中からよみがえらせた父なる神によったのです――","tok":[["使徒","しと"],["と"],["なった"],["パウロ"],["―"],["―"],["私","わたくし"],["が"],["使徒","しと"],["と"],["なった"],["の"],["は"],["、"],["人間","にんげん"],["から"],["出た","でた"],["こと"],["で"],["なく"],["、"],["また"],["人間","にんげん"],["の"],["手","て"],["を"],["通した","とおした"],["こと"],["で"],["も"],["なく"],["、"],["イエス"],["・"],["キリスト"],["と"],["、"],["キリスト"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせた"],["父","ちち"],["なる"],["神","かみ"],["に"],["よった"],["の"],["です"],["―"],["―"]]},{"verse":2,"text":"および私とともにいるすべての兄弟たちから、ガラテヤの諸教会へ。","tok":[["および"],["私","わたくし"],["と"],["とも"],["に"],["いる"],["すべて"],["の"],["兄弟","きょうだい"],["たち"],["から"],["、"],["ガラテヤ"],["の"],["諸教","しょきょう"],["会","かい"],["へ"],["。"]]},{"verse":3,"text":"どうか、私たちの父なる神と主イエス・キリストから、恵みと平安があなたがたの上にありますように。","tok":[["どう"],["か"],["、"],["私たち","わたしたち"],["の"],["父","ちち"],["なる"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"]]},{"verse":4,"text":"キリストは、今の悪の世界から私たちを救い出そうとして、私たちの罪のためにご自身をお捨てになりました。私たちの神であり父である方のみこころによったのです。","tok":[["キリスト"],["は"],["、"],["今","いま"],["の"],["悪","あく"],["の"],["世界","せかい"],["から"],["私たち","わたしたち"],["を"],["救い出そう","すくいだそう"],["として"],["、"],["私たち","わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["ご自身","ごじしん"],["を"],["お捨て","おすて"],["に"],["なりました"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["で"],["あり"],["父","ちち"],["で"],["ある"],["方","かた"],["のみ"],["こころ"],["に"],["よった"],["の"],["です"],["。"]]},{"verse":5,"text":"どうか、この神に栄光がとこしえにありますように。アーメン。","tok":[["どう"],["か"],["、"],["この"],["神","かみ"],["に"],["栄光","えいこう"],["が"],["とこしえ"],["に"],["あります"],["よう"],["に"],["。"],["アーメン"],["。"]]},{"verse":6,"text":"私は、キリストの恵みをもってあなたがたを召してくださったその方を、あなたがたがそんなにも急に見捨てて、ほかの福音に移って行くのに驚いています。","tok":[["私","わたくし"],["は"],["、"],["キリスト"],["の"],["恵み","めぐみ"],["を"],["もって"],["あなた"],["がた"],["を"],["召して","めして"],["くださった"],["その"],["方","ほう"],["を"],["、"],["あなた"],["がた"],["が"],["そんな"],["に"],["も"],["急","きゅう"],["に"],["見捨てて","みすてて"],["、"],["ほか"],["の"],["福音","ふくいん"],["に"],["移って","うつって"],["行く","いく"],["のに"],["驚いて","おどろいて"],["います"],["。"]]},{"verse":7,"text":"ほかの福音といっても、もう一つ別に福音があるのではありません。あなたがたをかき乱す者たちがいて、キリストの福音を変えてしまおうとしているだけです。","tok":[["ほか"],["の"],["福音","ふくいん"],["と"],["いって"],["も"],["、"],["もう"],["一","ひと"],["つ"],["別","べつ"],["に"],["福音","ふくいん"],["が"],["ある"],["ので"],["は"],["ありません"],["。"],["あなた"],["がた"],["を"],["かき乱す","かきみだす"],["者","もの"],["たち"],["が"],["いて"],["、"],["キリスト"],["の"],["福音","ふくいん"],["を"],["変えて","かえて"],["しまおう"],["として"],["いる"],["だけ"],["です"],["。"]]},{"verse":8,"text":"しかし、私たちであろうと、天の御使いであろうと、もし私たちが宣べ伝えた福音に反することをあなたがたに宣べ伝えるなら、その者はのろわれるべきです。","tok":[["しかし"],["、"],["私たち","わたしたち"],["で"],["あろう"],["と"],["、"],["天","てん"],["の"],["御使い","おつかい"],["で"],["あろう"],["と"],["、"],["もし"],["私たち","わたしたち"],["が"],["宣べ伝えた","のべつたえた"],["福音","ふくいん"],["に"],["反する","はんする"],["こと"],["を"],["あなた"],["がた"],["に"],["宣べ伝えるなら","のべつたえるなら"],["、"],["その"],["者","もの"],["は"],["のろわれるべきです"],["。"]]},{"verse":9,"text":"私たちが前に言ったように、今もう一度私は言います。もしだれかが、あなたがたの受けた福音に反することを、あなたがたに宣べ伝えているなら、その者はのろわれるべきです。","tok":[["私たち","わたしたち"],["が"],["前","まえ"],["に"],["言った","いった"],["よう"],["に"],["、"],["今","いま"],["もう"],["一度","いちど"],["私","わたくし"],["は"],["言います","いいます"],["。"],["もし"],["だれ"],["か"],["が"],["、"],["あなた"],["がた"],["の"],["受けた","うけた"],["福音","ふくいん"],["に"],["反する","はんする"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["宣べ伝えて","のべつたえて"],["いるなら"],["、"],["その"],["者","もの"],["は"],["のろわれるべきです"],["。"]]},{"verse":10,"text":"いま私は人に取り入ろうとしているのでしょうか。いや。神に、でしょう。あるいはまた、人の歓心を買おうと努めているのでしょうか。もし私がいまなお人の歓心を買おうとするようなら、私はキリストのしもべとは言えません。","tok":[["いま"],["私","わたくし"],["は"],["人","ひと"],["に"],["取り入ろう","とりいろう"],["として"],["いる"],["の"],["でしょう"],["か"],["。"],["いや"],["。"],["神","かみ"],["に"],["、"],["でしょう"],["。"],["あるいは"],["また"],["、"],["人","ひと"],["の"],["歓心","かんしん"],["を"],["買おう","かおう"],["と"],["努めて","つとめて"],["いる"],["の"],["でしょう"],["か"],["。"],["もし"],["私","わたくし"],["が"],["いま"],["な"],["お人","おひと"],["の"],["歓心","かんしん"],["を"],["買おう","かおう"],["と"],["する"],["よう"],["なら"],["、"],["私","わたくし"],["は"],["キリスト"],["の"],["しもべ"],["と"],["は"],["言えません","いえません"],["。"]]},{"verse":11,"text":"兄弟たちよ。私はあなたがたに知らせましょう。私が宣べ伝えた福音は、人間によるものではありません。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["知らせましょう","しらせましょう"],["。"],["私","わたくし"],["が"],["宣べ伝えた","のべつたえた"],["福音","ふくいん"],["は"],["、"],["人間","にんげん"],["に"],["よる"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":12,"text":"私はそれを人間からは受けなかったし、また教えられもしませんでした。ただイエス・キリストの啓示によって受けたのです。","tok":[["私","わたくし"],["は"],["それ"],["を"],["人間","にんげん"],["から"],["は"],["受けなかった","うけなかった"],["し"],["、"],["また"],["教えられ","おしえられ"],["も"],["しませんでした"],["。"],["ただ"],["イエス"],["・"],["キリスト"],["の"],["啓示","けいじ"],["によって"],["受けた","うけた"],["の"],["です"],["。"]]},{"verse":13,"text":"以前ユダヤ教徒であったころの私の行動は、あなたがたがすでに聞いているところです。私は激しく神の教会を迫害し、これを滅ぼそうとしました。","tok":[["以前","いぜん"],["ユダヤ教","ゆだやきょう"],["徒","と"],["で"],["あった"],["ころ"],["の"],["私","わたくし"],["の"],["行動","こうどう"],["は"],["、"],["あなた"],["がた"],["が"],["すでに"],["聞いて","きいて"],["いる"],["ところ"],["です"],["。"],["私","わたくし"],["は"],["激しく","はげしく"],["神","かみ"],["の"],["教会","きょうかい"],["を"],["迫害","はくがい"],["し"],["、"],["これ"],["を"],["滅ぼそう","ほろぼそう"],["と"],["しました"],["。"]]},{"verse":14,"text":"また私は、自分と同族で同年輩の多くの者たちに比べ、はるかにユダヤ教に進んでおり、先祖からの伝承に人一倍熱心でした。","tok":[["また"],["私","わたくし"],["は"],["、"],["自分","じぶん"],["と"],["同族","どうぞく"],["で"],["同年輩","どうねんぱい"],["の"],["多く","おおく"],["の"],["者","もの"],["たち"],["に"],["比べ","くらべ"],["、"],["はるか"],["に"],["ユダヤ教","ゆだやきょう"],["に"],["進んで","すすんで"],["おり"],["、"],["先祖","せんぞ"],["から"],["の"],["伝承","でんしょう"],["に"],["人一倍","ひといちばい"],["熱心","ねっしん"],["でした"],["。"]]},{"verse":15,"text":"けれども、生まれたときから私を選び分け、恵みをもって召してくださった方が、","tok":[["けれど"],["も"],["、"],["生まれた","うまれた"],["とき"],["から"],["私","わたくし"],["を"],["選び分け","えらびわけ"],["、"],["恵み","めぐみ"],["を"],["もって"],["召して","めして"],["くださった"],["方","ほう"],["が"],["、"]]},{"verse":16,"text":"異邦人の間に御子を宣べ伝えさせるために、御子を私のうちに啓示することをよしとされたとき、私はすぐに、人には相談せず、","tok":[["異邦人","いほうじん"],["の"],["間","あいだ"],["に"],["御子","みこ"],["を"],["宣べ伝えさせる","のべつたえさせる"],["ため"],["に"],["、"],["御子","みこ"],["を"],["私","わたくし"],["の"],["うち"],["に"],["啓示","けいじ"],["する"],["こと"],["を"],["よし"],["と"],["された"],["とき"],["、"],["私","わたくし"],["は"],["すぐ"],["に"],["、"],["人","ひと"],["に"],["は"],["相談","そうだん"],["せず"],["、"]]},{"verse":17,"text":"先輩の使徒たちに会うためにエルサレムにも上らず、アラビヤに出て行き、またダマスコに戻りました。","tok":[["先輩","せんぱい"],["の"],["使徒","しと"],["たち"],["に"],["会う","あう"],["ため"],["に"],["エルサレム"],["に"],["も"],["上らず","のぼらず"],["、"],["アラビヤ"],["に"],["出て","でて"],["行き","いき"],["、"],["また"],["ダマスコ"],["に"],["戻りました","もどりました"],["。"]]},{"verse":18,"text":"それから三年後に、私はケパをたずねてエルサレムに上り、彼のもとに十五日間滞在しました。","tok":[["それ"],["から"],["三","さん"],["年後","ねんご"],["に"],["、"],["私","わたくし"],["は"],["ケパ"],["を"],["たずねて"],["エルサレム"],["に"],["上り","のぼり"],["、"],["彼","かれ"],["の"],["もと"],["に"],["十五","じゅうご"],["日間","にちかん"],["滞在","たいざい"],["しました"],["。"]]},{"verse":19,"text":"しかし、主の兄弟ヤコブは別として、ほかの使徒にはだれにも会いませんでした。","tok":[["しかし"],["、"],["主","ぬし"],["の"],["兄弟","きょうだい"],["ヤコブ"],["は"],["別","べつ"],["として"],["、"],["ほか"],["の"],["使徒","しと"],["に"],["は"],["だれ"],["に"],["も"],["会いませんでした","あいませんでした"],["。"]]},{"verse":20,"text":"私があなたがたに書いていることには、神の御前で申しますが、偽りはありません。","tok":[["私","わたくし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["こと"],["に"],["は"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["申します","もうします"],["が"],["、"],["偽り","いつわり"],["は"],["ありません"],["。"]]},{"verse":21,"text":"それから、私はシリヤおよびキリキヤの地方に行きました。","tok":[["それ"],["から"],["、"],["私","わたくし"],["は"],["シリヤ"],["および"],["キリキヤ"],["の"],["地方","ちほう"],["に"],["行きました","いきました"],["。"]]},{"verse":22,"text":"しかし、キリストにあるユダヤの諸教会には顔を知られていませんでした。","tok":[["しかし"],["、"],["キリスト"],["に"],["ある"],["ユダヤ"],["の"],["諸教","しょきょう"],["会","かい"],["に"],["は"],["顔","かお"],["を"],["知られて","しられて"],["いませんでした"],["。"]]},{"verse":23,"text":"けれども、「以前私たちを迫害した者が、そのとき滅ぼそうとした信仰を今は宣べ伝えている」と聞いてだけはいたので、","tok":[["けれど"],["も"],["、"],["「"],["以前","いぜん"],["私たち","わたしたち"],["を"],["迫害","はくがい"],["した"],["者","もの"],["が"],["、"],["その"],["とき"],["滅ぼそう","ほろぼそう"],["と"],["した"],["信仰","しんこう"],["を"],["今","いま"],["は"],["宣べ伝えて","のべつたえて"],["いる"],["」"],["と"],["聞いて","きいて"],["だけ"],["は"],["いた"],["ので"],["、"]]},{"verse":24,"text":"彼らは私のことで神をあがめていました。","tok":[["彼","かれ"
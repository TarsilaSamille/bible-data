[{"verse":1,"text":"イエス・キリストのしもべであり使徒であるシモン・ペテロから、私たちの神であり救い主であるイエス・キリストの義によって私たちと同じ尊い信仰を受けた方々へ。","tok":[["イエス"],["・"],["キリスト"],["の"],["しもべ"],["で"],["あり"],["使徒","しと"],["で"],["ある"],["シモン"],["・"],["ペテロ"],["から"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["で"],["あり"],["救い主","すくいぬし"],["で"],["ある"],["イエス"],["・"],["キリスト"],["の"],["義","ぎ"],["によって"],["私たち","わたしたち"],["と"],["同じ","おなじ"],["尊い","とうとい"],["信仰","しんこう"],["を"],["受けた","うけた"],["方々","かたがた"],["へ"],["。"]]},{"verse":2,"text":"神と私たちの主イエスを知ることによって、恵みと平安が、あなたがたの上にますます豊かにされますように。","tok":[["神","かみ"],["と"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["を"],["知る","しる"],["こと"],["によって"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["ますます"],["豊か","ゆたか"],["に"],["されます"],["よう"],["に"],["。"]]},{"verse":3,"text":"というのは、私たちをご自身の栄光と徳によってお召しになった方を私たちが知ったことによって、主イエスの、神としての御力は、いのちと敬虔に関するすべてのことを私たちに与えるからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["私たち","わたしたち"],["を"],["ご自身","ごじしん"],["の"],["栄光","えいこう"],["と"],["徳","とく"],["によって"],["お召し","おめし"],["に"],["なった"],["方","ほう"],["を"],["私たち","わたしたち"],["が"],["知った","しった"],["こと"],["によって"],["、"],["主","しゅ"],["イエス"],["の"],["、"],["神","かみ"],["として"],["の"],["御力","おちから"],["は"],["、"],["いのち"],["と"],["敬虔","けいけん"],["に"],["関する","かんする"],["すべて"],["の"],["こと"],["を"],["私たち","わたしたち"],["に"],["与える","あたえる"],["から"],["です"],["。"]]},{"verse":4,"text":"その栄光と徳によって、尊い、すばらしい約束が私たちに与えられました。それは、あなたがたが、その約束のゆえに、世にある欲のもたらす滅びを免れ、神のご性質にあずかる者となるためです。","tok":[["その"],["栄光","えいこう"],["と"],["徳","とく"],["によって"],["、"],["尊い","とうとい"],["、"],["すばらしい"],["約束","やくそく"],["が"],["私たち","わたしたち"],["に"],["与えられました","あたえられました"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["その"],["約束","やくそく"],["の"],["ゆえ"],["に"],["、"],["世","よ"],["に"],["ある"],["欲","よく"],["の"],["もたらす"],["滅び","ほろび"],["を"],["免れ","まぬがれ"],["、"],["神","かみ"],["の"],["ご性質","ごせいしつ"],["に"],["あずかる"],["者","もの"],["と"],["なる"],["ため"],["です"],["。"]]},{"verse":5,"text":"こういうわけですから、あなたがたは、あらゆる努力をして、信仰には徳を、徳には知識を、","tok":[["こう"],["いう"],["わけ"],["です"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["あらゆる"],["努力","どりょく"],["を"],["して"],["、"],["信仰","しんこう"],["に"],["は"],["徳","とく"],["を"],["、"],["徳","とく"],["に"],["は"],["知識","ちしき"],["を"],["、"]]},{"verse":6,"text":"知識には自制を、自制には忍耐を、忍耐には敬虔を、","tok":[["知識","ちしき"],["に"],["は"],["自制","じせい"],["を"],["、"],["自制","じせい"],["に"],["は"],["忍耐","にんたい"],["を"],["、"],["忍耐","にんたい"],["に"],["は"],["敬虔","けいけん"],["を"],["、"]]},{"verse":7,"text":"敬虔には兄弟愛を、兄弟愛には愛を加えなさい。","tok":[["敬虔","けいけん"],["に"],["は"],["兄弟","きょうだい"],["愛","あい"],["を"],["、"],["兄弟","きょうだい"],["愛","あい"],["に"],["は"],["愛","あい"],["を"],["加え","くわえ"],["なさい"],["。"]]},{"verse":8,"text":"これらがあなたがたに備わり、ますます豊かになるなら、あなたがたは、私たちの主イエス・キリストを知る点で、役に立たない者とか、実を結ばない者になることはありません。","tok":[["これ"],["ら"],["が"],["あなた"],["がた"],["に"],["備わり","そなわり"],["、"],["ますます"],["豊か","ゆたか"],["に"],["なるなら"],["、"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["を"],["知る","しる"],["点","てん"],["で"],["、"],["役","やく"],["に"],["立たない","たたない"],["者","もの"],["と"],["か"],["、"],["実","じつ"],["を"],["結ばない","むすばない"],["者","もの"],["に"],["なる"],["こと"],["は"],["ありません"],["。"]]},{"verse":9,"text":"これらを備えていない者は、近視眼であり、盲目であって、自分の以前の罪がきよめられたことを忘れてしまったのです。","tok":[["これ"],["ら"],["を"],["備えて","そなえて"],["いない"],["者","もの"],["は"],["、"],["近視眼","きんしがん"],["で"],["あり"],["、"],["盲目","もうもく"],["で"],["あって"],["、"],["自分","じぶん"],["の"],["以前","いぜん"],["の"],["罪","つみ"],["が"],["きよめられた"],["こと"],["を"],["忘れて","わすれて"],["しまった"],["の"],["です"],["。"]]},{"verse":10,"text":"ですから、兄弟たちよ。ますます熱心に、あなたがたの召されたことと選ばれたこととを確かなものとしなさい。これらのことを行っていれば、つまずくことなど決してありません。","tok":[["です"],["から"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["。"],["ますます"],["熱心","ねっしん"],["に"],["、"],["あなた"],["がた"],["の"],["召された","めされた"],["こと"],["と"],["選ばれた","えらばれた"],["こと"],["と"],["を"],["確か","たしか"],["な"],["もの"],["と"],["し"],["なさい"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["行って","おこなって"],["いれば"],["、"],["つまずく"],["こと"],["など"],["決して","けっして"],["ありません"],["。"]]},{"verse":11,"text":"このようにあなたがたは、私たちの主であり救い主であるイエス・キリストの永遠の御国に入る恵みを豊かに加えられるのです。","tok":[["この"],["よう"],["に"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["で"],["あり"],["救い主","すくいぬし"],["で"],["ある"],["イエス"],["・"],["キリスト"],["の"],["永遠","えいえん"],["の"],["御国","おくに"],["に"],["入る","はいる"],["恵み","めぐみ"],["を"],["豊か","ゆたか"],["に"],["加えられる","くわえられる"],["の"],["です"],["。"]]},{"verse":12,"text":"ですから、すでにこれらのことを知っており、現に持っている真理に堅く立っているあなたがたであるとはいえ、私はいつもこれらのことを、あなたがたに思い起こさせようとするのです。","tok":[["です"],["から"],["、"],["すでに"],["これ"],["ら"],["の"],["こと"],["を"],["知って","しって"],["おり"],["、"],["現に","げんに"],["持って","もって"],["いる"],["真理","しんり"],["に"],["堅く","かたく"],["立って","たって"],["いる"],["あなた"],["がた"],["で"],["ある"],["と"],["は"],["いえ"],["、"],["私","わたくし"],["は"],["いつも"],["これ"],["ら"],["の"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["思い起こさせよう","おもいおこさせよう"],["と"],["する"],["の"],["です"],["。"]]},{"verse":13,"text":"私が地上の幕屋にいる間は、これらのことを思い起こさせることによって、あなたがたを奮い立たせることを、私のなすべきことと思っています。","tok":[["私","わたくし"],["が"],["地上","ちじょう"],["の"],["幕屋","まくや"],["に"],["いる"],["間","あいだ"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["思い起こさせる","おもいおこさせる"],["こと"],["によって"],["、"],["あなた"],["がた"],["を"],["奮い立たせる","ふるいたたせる"],["こと"],["を"],["、"],["私","わたくし"],["の"],["なすべき"],["こと"],["と"],["思って","おもって"],["います"],["。"]]},{"verse":14,"text":"それは、私たちの主イエス・キリストも、私にはっきりお示しになったとおり、私がこの幕屋を脱ぎ捨てるのが間近に迫っているのを知っているからです。","tok":[["それ"],["は"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["も"],["、"],["私","わたくし"],["に"],["はっきり"],["お示し","おしめし"],["に"],["なった"],["とおり"],["、"],["私","わたくし"],["が"],["この"],["幕屋","まくや"],["を"],["脱ぎ捨てる","ぬぎすてる"],["の"],["が"],["間近","まじか"],["に"],["迫って","せまって"],["いる"],["の"],["を"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":15,"text":"また、私の去った後に、あなたがたがいつでもこれらのことを思い起こせるよう、私は努めたいのです。","tok":[["また"],["、"],["私","わたくし"],["の"],["去った","さった"],["後","あと"],["に"],["、"],["あなた"],["がた"],["が"],["いつ"],["で"],["も"],["これ"],["ら"],["の"],["こと"],["を"],["思い起こせる","おもいおこせる"],["よう"],["、"],["私","わたくし"],["は"],["努めたい","つとめたい"],["の"],["です"],["。"]]},{"verse":16,"text":"私たちは、あなたがたに、私たちの主イエス・キリストの力と来臨とを知らせましたが、それは、うまく考え出した作り話に従ったのではありません。この私たちは、キリストの威光の目撃者なのです。","tok":[["私たち","わたしたち"],["は"],["、"],["あなた"],["がた"],["に"],["、"],["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["力","ちから"],["と"],["来臨","らいりん"],["と"],["を"],["知らせました","しらせました"],["が"],["、"],["それ"],["は"],["、"],["うまく"],["考え出した","かんがえだした"],["作り話","つくりばなし"],["に"],["従った","したがった"],["ので"],["は"],["ありません"],["。"],["この"],["私たち","わたしたち"],["は"],["、"],["キリスト"],["の"],["威光","いこう"],["の"],["目撃者","もくげきしゃ"],["な"],["の"],["です"],["。"]]},{"verse":17,"text":"キリストが父なる神から誉れと栄光をお受けになったとき、おごそかな、栄光の神から、こういう御声がかかりました。「これはわたしの愛する子、わたしの喜ぶ者である。」","tok":[["キリスト"],["が"],["父","ちち"],["なる"],["神","かみ"],["から"],["誉れ","ほまれ"],["と"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なった"],["とき"],["、"],["おごそか"],["な"],["、"],["栄光","えいこう"],["の"],["神","かみ"],["から"],["、"],["こう"],["いう"],["御声","おこえ"],["が"],["かかりました"],["。"],["「"],["これ"],["は"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["、"],["わたし"],["の"],["喜ぶ","よろこぶ"],["者","もの"],["で"],["ある"],["。"],["」"]]},{"verse":18,"text":"私たちは聖なる山で主イエスとともにいたので、天からかかったこの御声を、自分自身で聞いたのです。","tok":[["私たち","わたしたち"],["は"],["聖","せい"],["なる"],["山","やま"],["で"],["主","ぬし"],["イエス"],["と"],["とも"],["に"],["いた"],["ので"],["、"],["天","てん"],["から"],["かかった"],["この"],["御声","おこえ"],["を"],["、"],["自分","じぶん"],["自身","じしん"],["で"],["聞いた","きいた"],["の"],["です"],["。"]]},{"verse":19,"text":"また、私たちは、さらに確かな預言のみことばを持っています。夜明けとなって、明けの明星があなたがたの心の中に上るまでは、暗い所を照らすともしびとして、それに目を留めているとよいのです。","tok":[["また"],["、"],["私たち","わたしたち"],["は"],["、"],["さらに"],["確か","たしか"],["な"],["預言","よげん"],["の"],["みことば"],["を"],["持って","もって"],["います"],["。"],["夜明け","よあけ"],["と"],["なって"],["、"],["明け","あけ"],["の"],["明星","みょうじょう"],["が"],["あなた"],["がた"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["上る","のぼる"],["まで"],["は"],["、"],["暗い","くらい"],["所","ところ"],["を"],["照らす","てらす"],["ともしび"],["として"],["、"],["それ"],["に"],["目","め"],["を"],["留めて","とめて"],["いる"],["と"],["よい"],["の"],["です"],["。"]]},{"verse":20,"text":"それには何よりも次のことを知っていなければいけません。すなわち、聖書の預言はみな、人の私的解釈を施してはならない、ということです。","tok":[["それ"],["に"],["は"],["何","なん"],["より"],["も"],["次","つぎ"],["の"],["こと"],["を"],["知って","しって"],["いなければ"],["いけません"],["。"],["すなわち"],["、"],["聖書","せいしょ"],["の"],["預言","よげん"],["は"],["みな"],["、"],["人","ひと"],["の"],["私的","してき"],["解釈","かいしゃく"],["を"],["施して","ほどこして"],["は"],["ならない"],["、"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":21,"text":"なぜなら、預言は決して人間の意志によってもたらされたのではなく、聖霊に動かされた人たちが、神からのことばを語ったのだからです。","tok":[["なぜ"],["なら"],["、"],["預言","よげん"],["は"],["決して","けっして"],["人間","にんげん"],["の"],["意志","いし"],["によって"],["もたらされた"],["ので"],["は"],["なく"],["、"],["聖霊","せいれい"],["に"],["動かされた","うごかされた"],["人","ひと"],["たち"],["が"],["、"],["神","かみ"],["から"],["の"],["ことば"],["を"],["語った","かたった"],["の"],["だ"],["から"],["です"],["。"]]}]
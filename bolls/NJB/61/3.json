[{"verse":1,"text":"愛する人たち。いま私がこの第二の手紙をあなたがたに書き送るのは、これらの手紙により、記憶を呼びさまさせて、あなたがたの純真な心を奮い立たせるためなのです。","tok":[["愛する","あいする"],["人","ひと"],["たち"],["。"],["いま"],["私","わたくし"],["が"],["この"],["第","だい"],["二","に"],["の"],["手紙","てがみ"],["を"],["あなた"],["がた"],["に"],["書き送る","かきおくる"],["の"],["は"],["、"],["これ"],["ら"],["の"],["手紙","てがみ"],["に"],["より"],["、"],["記憶","きおく"],["を"],["呼びさまさせて","よびさまさせて"],["、"],["あなた"],["がた"],["の"],["純真","じゅんしん"],["な"],["心","こころ"],["を"],["奮い立たせる","ふるいたたせる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":2,"text":"それは、聖なる預言者たちによって前もって語られたみことばと、あなたがたの使徒たちが語った、主であり救い主である方の命令とを思い起こさせるためなのです。","tok":[["それ"],["は"],["、"],["聖","せい"],["なる"],["預言者","よげんしゃ"],["たち"],["によって"],["前もって","まえもって"],["語られた","かたられた"],["みことば"],["と"],["、"],["あなた"],["がた"],["の"],["使徒","しと"],["たち"],["が"],["語った","かたった"],["、"],["主","ぬし"],["で"],["あり"],["救い主","すくいぬし"],["で"],["ある"],["方","かた"],["の"],["命令","めいれい"],["と"],["を"],["思い起こさせる","おもいおこさせる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":3,"text":"まず第一に、次のことを知っておきなさい。終わりの日に、あざける者どもがやって来てあざけり、自分たちの欲望に従って生活し、","tok":[["まず"],["第","だい"],["一","いち"],["に"],["、"],["次","つぎ"],["の"],["こと"],["を"],["知って","しって"],["おき"],["なさい"],["。"],["終わり","おわり"],["の"],["日","ひ"],["に"],["、"],["あざける"],["者","もの"],["ども"],["が"],["やって"],["来て","きて"],["あざけり"],["、"],["自分","じぶん"],["たち"],["の"],["欲望","よくぼう"],["に"],["従って","したがって"],["生活","せいかつ"],["し"],["、"]]},{"verse":4,"text":"次のように言うでしょう。「キリストの来臨の約束はどこにあるのか。父祖たちが眠った時からこのかた、何事も創造の初めからのままではないか。」","tok":[["次","つぎ"],["の"],["よう"],["に"],["言うでしょう","ゆうでしょう"],["。"],["「"],["キリスト"],["の"],["来臨","らいりん"],["の"],["約束","やくそく"],["は"],["どこ"],["に"],["ある"],["の"],["か"],["。"],["父祖","ふそ"],["たち"],["が"],["眠った","ねむった"],["時","とき"],["から"],["このかた"],["、"],["何事","なにごと"],["も"],["創造","そうぞう"],["の"],["初め","はじめ"],["から"],["の"],["まま"],["で"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":5,"text":"こう言い張る彼らは、次のことを見落としています。すなわち、天は古い昔からあり、地は神のことばによって水から出て、水によって成ったのであって、","tok":[["こう"],["言い張る","いいはる"],["彼","かれ"],["ら"],["は"],["、"],["次","つぎ"],["の"],["こと"],["を"],["見落として","みおとして"],["います"],["。"],["すなわち"],["、"],["天","てん"],["は"],["古い","ふるい"],["昔","むかし"],["から"],["あり"],["、"],["地","ち"],["は"],["神","かみ"],["の"],["ことば"],["によって"],["水","みず"],["から"],["出て","でて"],["、"],["水","みず"],["によって"],["成った","なった"],["ので"],["あって"],["、"]]},{"verse":6,"text":"当時の世界は、その水により、洪水におおわれて滅びました。","tok":[["当時","とうじ"],["の"],["世界","せかい"],["は"],["、"],["その"],["水","みず"],["に"],["より"],["、"],["洪水","こうずい"],["に"],["おおわれて"],["滅びました","ほろびました"],["。"]]},{"verse":7,"text":"しかし、今の天と地は、同じみことばによって、火に焼かれるためにとっておかれ、不敬虔な者どものさばきと滅びとの日まで、保たれているのです。","tok":[["しかし"],["、"],["今","いま"],["の"],["天","てん"],["と"],["地","ち"],["は"],["、"],["同じ","おなじ"],["みことば"],["によって"],["、"],["火","ひ"],["に"],["焼かれる","やかれる"],["ため"],["にとって"],["おかれ"],["、"],["不","ふ"],["敬虔","けいけん"],["な"],["者","もの"],["ども"],["の"],["さばき"],["と"],["滅び","ほろび"],["と"],["の"],["日","ひ"],["まで"],["、"],["保たれて","たもたれて"],["いる"],["の"],["です"],["。"]]},{"verse":8,"text":"しかし、愛する人たち。あなたがたは、この一事を見落としてはいけません。すなわち、主の御前では、一日は千年のようであり、千年は一日のようです。","tok":[["しかし"],["、"],["愛する","あいする"],["人","ひと"],["たち"],["。"],["あなた"],["がた"],["は"],["、"],["この"],["一事","いちじ"],["を"],["見落として","みおとして"],["は"],["いけません"],["。"],["すなわち"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["は"],["、"],["一","いち"],["日","にち"],["は"],["千","せん"],["年","ねん"],["の"],["よう"],["で"],["あり"],["、"],["千","せん"],["年","ねん"],["は"],["一","いち"],["日","にち"],["の"],["よう"],["です"],["。"]]},{"verse":9,"text":"主は、ある人たちがおそいと思っているように、その約束のことを遅らせておられるのではありません。かえって、あなたがたに対して忍耐深くあられるのであって、ひとりでも滅びることを望まず、すべての人が悔い改めに進むことを望んでおられるのです。","tok":[["主","ぬし"],["は"],["、"],["ある"],["人","ひと"],["たち"],["が"],["おそい"],["と"],["思って","おもって"],["いる"],["よう"],["に"],["、"],["その"],["約束","やくそく"],["の"],["こと"],["を"],["遅らせて","おくらせて"],["おられる"],["ので"],["は"],["ありません"],["。"],["かえって"],["、"],["あなた"],["がた"],["に対して","にたいして"],["忍耐","にんたい"],["深く","ふかく"],["あられる"],["ので"],["あって"],["、"],["ひとり"],["で"],["も"],["滅びる","ほろびる"],["こと"],["を"],["望まず","のぞまず"],["、"],["すべて"],["の"],["人","ひと"],["が"],["悔い改め","くいあらため"],["に"],["進む","すすむ"],["こと"],["を"],["望んで","のぞんで"],["おられる"],["の"],["です"],["。"]]},{"verse":10,"text":"しかし、主の日は、盗人のようにやって来ます。その日には、天は大きな響きをたてて消えうせ
[{"verse":1,"text":"しかし、イスラエルの中には、にせ預言者も出ました。同じように、あなたがたの中にも、にせ教師が現れるようになります。彼らは、滅びをもたらす異端をひそかに持ち込み、自分たちを買い取ってくださった主を否定するようなことさえして、自分たちの身にすみやかな滅びを招いています。","tok":[["しかし"],["、"],["イスラエル"],["の"],["中","なか"],["に"],["は"],["、"],["にせ"],["預言者","よげんしゃ"],["も"],["出ました","でました"],["。"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["も"],["、"],["にせ"],["教師","きょうし"],["が"],["現れる","あらわれる"],["よう"],["に"],["なります"],["。"],["彼","かれ"],["ら"],["は"],["、"],["滅び","ほろび"],["を"],["もたらす"],["異端","いたん"],["を"],["ひそか"],["に"],["持ち込み","もちこみ"],["、"],["自分","じぶん"],["たち"],["を"],["買い取って","かいとって"],["くださった"],["主","ぬし"],["を"],["否定","ひてい"],["する"],["よう"],["な"],["こと"],["さえ"],["して"],["、"],["自分","じぶん"],["たち"],["の"],["身","み"],["に"],["すみやか"],["な"],["滅び","ほろび"],["を"],["招いて","まねいて"],["います"],["。"]]},{"verse":2,"text":"そして、多くの者が彼らの好色にならい、そのために真理の道がそしりを受けるのです。","tok":[["そして"],["、"],["多く","おおく"],["の"],["者","もの"],["が"],["彼","かれ"],["ら"],["の"],["好色","こうしょく"],["に"],["ならい"],["、"],["その"],["ため"],["に"],["真理","しんり"],["の"],["道","みち"],["が"],["そ"],["しり"],["を"],["受ける","うける"],["の"],["です"],["。"]]},{"verse":3,"text":"また彼らは、貪欲なので、作り事のことばをもってあなたがたを食い物にします。彼らに対するさばきは、昔から怠りなく行われており、彼らが滅ぼされないままでいることはありません。","tok":[["また"],["彼","かれ"],["ら"],["は"],["、"],["貪欲","どんよく"],["な"],["ので"],["、"],["作り事","つくりごと"],["の"],["ことば"],["を"],["もって"],["あなた"],["がた"],["を"],["食い物","くいもの"],["に"],["します"],["。"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["さばき"],["は"],["、"],["昔","むかし"],["から"],["怠り","おこたり"],["なく"],["行われて","おこなわれて"],["おり"],["、"],["彼","かれ"],["ら"],["が"],["滅ぼされない","ほろぼされない"],["まま"],["で"],["いる"],["こと"],["は"],["ありません"],["。"]]},{"verse":4,"text":"神は、罪を犯した御使いたちを、容赦せず、地獄に引き渡し、さばきの時まで暗やみの穴の中に閉じ込めてしまわれました。","tok":[["神","かみ"],["は"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["御使い","おつかい"],["たち"],["を"],["、"],["容赦","ようしゃ"],["せず"],["、"],["地獄","じごく"],["に"],["引き渡し","ひきわたし"],["、"],["さばき"],["の"],["時","とき"],["まで"],["暗やみ","くらやみ"],["の"],["穴","あな"],["の"],["中","なか"],["に"],["閉じ込めて","とじこめて"],["しまわれました"],["。"]]},{"verse":5,"text":"また、昔の世界を赦さず、義を宣べ伝えたノアたち八人の者を保護し、不敬虔な世界に洪水を起こされました。","tok":[["また"],["、"],["昔","むかし"],["の"],["世界","せかい"],["を"],["赦さず","ゆるさず"],["、"],["義","ぎ"],["を"],["宣べ伝えた","のべつたえた"],["ノア"],["たち"],["八人","はちにん"],["の"],["者","もの"],["を"],["保護","ほご"],["し"],["、"],["不","ふ"],["敬虔","けいけん"],["な"],["世界","せかい"],["に"],["洪水","こうずい"],["を"],["起こされました","おこされました"],["。"]]},{"verse":6,"text":"また、ソドムとゴモラの町を破滅に定めて灰にし、以後の不敬虔な者へのみせしめとされました。","tok":[["また"],["、"],["ソドム"],["と"],["ゴモラ"],["の"],["町","まち"],["を"],["破滅","はめつ"],["に"],["定めて","さだめて"],["灰","はい"],["に"],["し"],["、"],["以後","いご"],["の"],["不","ふ"],["敬虔","けいけん"],["な"],["者","もの"],["へ"],["の"],["みせしめ"],["と"],["されました"],["。"]]},{"verse":7,"text":"また、無節操な者たちの好色なふるまいによって悩まされていた義人ロトを救い出されました。","tok":[["また"],["、"],["無節操","むせっそう"],["な"],["者","もの"],["たち"],["の"],["好色","こうしょく"],["な"],["ふるまい"],["によって"],["悩まされて","なやまされて"],["いた"],["義人","ぎじん"],["ロト"],["を"],["救い出されました","すくいだされました"],["。"]]},{"verse":8,"text":"というのは、この義人は、彼らの間に住んでいましたが、不法な行いを見聞きして、日々その正しい心を痛めていたからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["この"],["義人","ぎじん"],["は"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["住んで","すんで"],["いました"],["が"],["、"],["不法","ふほう"],["な"],["行い","おこない"],["を"],["見聞き","みきき"],["して"],["、"],["日々","ひび"],["その"],["正しい","ただしい"],["心","こころ"],["を"],["痛めて","いためて"],["いた"],["から"],["です"],["。"]]},{"verse":9,"text":"これらのことでわかるように、主は、敬虔な者たちを誘惑から救い出し、不義な者どもを、さばきの日まで、懲罰のもとに置くことを心得ておられるのです。","tok":[["これ"],["ら"],["の"],["こと"],["で"],["わかる"],["よう"],["に"],["、"],["主","ぬし"],["は"],["、"],["敬虔","けいけん"],["な"],["者","もの"],["たち"],["を"],["誘惑","ゆうわく"],["から"],["救い出し","すくいだし"],["、"],["不義","ふぎ"],["な"],["者","もの"],["ども"],["を"],["、"],["さばき"],["の"],["日","ひ"],["まで"],["、"],["懲罰","ちょうばつ"],["の"],["もと"],["に"],["置く","おく"],["こと"],["を"],["心得て","こころえて"],["おられる"],["の"],["です"],["。"]]},{"verse":10,"text":"汚れた情欲を燃やし、肉に従って歩み、権威を侮る者たちに対しては、特にそうなのです。彼らは、大胆不敵な、尊大な者たちで、栄誉ある人たちをそしって、恐れるところがありません。","tok":[["汚れた","よごれた"],["情欲","じょうよく"],["を"],["燃やし","もやし"],["、"],["肉","にく"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"],["権威","けんい"],["を"],["侮る","あなどる"],["者","もの"],["たち"],["に"],["対し","たいし"],["ては"],["、"],["特に","とくに"],["そう"],["な"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["大胆","だいたん"],["不敵","ふてき"],["な"],["、"],["尊大","そんだい"],["な"],["者","もの"],["たち"],["で"],["、"],["栄誉","えいよ"],["ある"],["人","ひと"],["たち"],["を"],["そしって"],["、"],["恐れる","おそれる"],["ところ"],["が"],["ありません"],["。"]]},{"verse":11,"text":"それに比べると、御使いたちは、勢いにも力にもまさっているにもかかわらず、主の御前に彼らをそしって訴えることはしません。","tok":[["それ"],["に"],["比べる","くらべる"],["と"],["、"],["御使い","おつかい"],["たち"],["は"],["、"],["勢い","いきおい"],["に"],["も"],["力","ちから"],["に"],["も"],["まさって"],["いる"],["に"],["も"],["かかわらず"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["彼","かれ"],["ら"],["を"],["そしって"],["訴える","うったえる"],["こと"],["は"],["しません"],["。"]]},{"verse":12,"text":"ところがこの者どもは、捕らえられ殺されるために自然に生まれついた、理性のない動物と同じで、自分が知りもしないことをそしるのです。それで動物が滅ぼされるように、彼らも滅ぼされてしまうのです。","tok":[["ところ"],["が"],["この"],["者","もの"],["ども"],["は"],["、"],["捕らえられ","とらえられ"],["殺される","ころされる"],["ため"],["に"],["自然","しぜん"],["に"],["生まれついた","うまれついた"],["、"],["理性","りせい"],["の"],["ない"],["動物","どうぶつ"],["と"],["同じ","おなじ"],["で"],["、"],["自分","じぶん"],["が"],["知り","しり"],["も"],["しない"],["こと"],["を"],["そしる"],["の"],["です"],["。"],["それ"],["で"],["動物","どうぶつ"],["が"],["滅ぼされる","ほろぼされる"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["滅ぼされて","ほろぼされて"],["しまう"],["の"],["です"],["。"]]},{"verse":13,"text":"彼らは不義の報いとして損害を受けるのです。彼らは昼のうちから飲み騒ぐことを楽しみと考えています。彼らは、しみや傷のようなもので、あなたがたといっしょに宴席に連なるときに自分たちのだましごとを楽しんでいるのです。","tok":[["彼","かれ"],["ら"],["は"],["不義","ふぎ"],["の"],["報い","むくい"],["として"],["損害","そんがい"],["を"],["受ける","うける"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["昼","ひる"],["の"],["うち"],["から"],["飲み騒ぐ","のみさわぐ"],["こと"],["を"],["楽しみ","たのしみ"],["と"],["考えて","かんがえて"],["います"],["。"],["彼","かれ"],["ら"],["は"],["、"],["しみ"],["や"],["傷","きず"],["の"],["よう"],["な"],["もの"],["で"],["、"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["宴席","えんせき"],["に"],["連なる","つらなる"],["とき"],["に"],["自分","じぶん"],["たち"],["の"],["だまし"],["ごと"],["を"],["楽しんで","たのしんで"],["いる"],["の"],["です"],["。"]]},{"verse":14,"text":"その目は淫行に満ちており、罪に関しては飽くことを知らず、心の定まらない者たちを誘惑し、その心は欲に目がありません。彼らはのろいの子です。","tok":[["その"],["目","め"],["は"],["淫行","いんこう"],["に"],["満ちて","みちて"],["おり"],["、"],["罪","つみ"],["に関して","にかんして"],["は"],["飽く","あく"],["こと"],["を"],["知らず","しらず"],["、"],["心","こころ"],["の"],["定まらない","さだまらない"],["者","もの"],["たち"],["を"],["誘惑","ゆうわく"],["し"],["、"],["その"],["心","こころ"],["は"],["欲","よく"],["に"],["目","め"],["が"],["ありません"],["。"],["彼","かれ"],["ら"],["は"],["のろい"],["の"],["子","こ"],["です"],["。"]]},{"verse":15,"text":"彼らは正しい道を捨ててさまよっています。不義の報酬を愛したベオルの子バラムの道に従ったのです。","tok":[["彼","かれ"],["ら"],["は"],["正しい","ただしい"],["道","みち"],["を"],["捨てて","すてて"],["さまよって"],["います"],["。"],["不義","ふぎ"],["の"],["報酬","ほうしゅう"],["を"],["愛した","あいした"],["ベオル"],["の"],["子","こ"],["バラム"],["の"],["道","みち"],["に"],["従った","したがった"],["の"],["です"],["。"]]},{"verse":16,"text":"しかし、バラムは自分の罪をとがめられました。ものを言うことのないろばが、人間の声でものを言い、この預言者の狂った振舞いをはばんだのです。","tok":[["しかし"],["、"],["バラム"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["とがめられました"],["。"],["もの"],["を"],["言う","いう"],["こと"],["の"],["ない"],["ろば"],["が"],["、"],["人間","にんげん"],["の"],["声","こえ"],["で"],["もの"],["を"],["言い","いい"],["、"],["この"],["預言者","よげんしゃ"],["の"],["狂った","くるった"],["振舞い","ふるまい"],["を"],["はばんだ"],["の"],["です"],["。"]]},{"verse":17,"text":"この人たちは、水のない泉、突風に吹き払われる霧です。彼らに用意されているものは、まっ暗なやみです。","tok":[["この"],["人","ひと"],["たち"],["は"],["、"],["水","みず"],["の"],["ない"],["泉","いずみ"],["、"],["突風","とっぷう"],["に"],["吹き払われる","ふきはらわれる"],["霧","きり"],["です"],["。"],["彼","かれ"],["ら"],["に"],["用意","ようい"],["されて"],["いる"],["もの"],["は"],["、"],["まっ暗","まっくら"],["な"],["やみ"],["です"],["。"]]},{"verse":18,"text":"彼らは、むなしい大言壮語を吐いており、誤った生き方をしていて、ようやくそれをのがれようとしている人々を肉欲と好色によって誘惑し、","tok":[["彼","かれ"],["ら"],["は"],["、"],["むなしい"],["大言","たいげん"],["壮語","そうご"],["を"],["吐いて","はいて"],["おり"],["、"],["誤った","あやまった"],["生き方","いきかた"],["を"],["して"],["いて"],["、"],["ようやく"],["それ"],["を"],["のがれよう"],["として"],["いる"],["人々","ひとびと"],["を"],["肉欲","にくよく"],["と"],["好色","こうしょく"],["によって"],["誘惑","ゆうわく"],["し"],["、"]]},{"verse":19,"text":"その人たちに自由を約束しながら、自分自身が滅びの奴隷なのです。人はだれかに征服されれば、その征服者の奴隷となったのです。","tok":[["その"],["人","ひと"],["たち"],["に"],["自由","じゆう"],["を"],["約束","やくそく"],["し"],["ながら"],["、"],["自分","じぶん"],["自身","じしん"],["が"],["滅び","ほろび"],["の"],["奴隷","どれい"],["な"],["の"],["です"],["。"],["人","ひと"],["は"],["だれ"],["か"],["に"],["征服","せいふく"],["されれば"],["、"],["その"],["征服者","せいふくしゃ"],["の"],["奴隷","どれい"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":20,"text":"主であり救い主であるイエス・キリストを知ることによって世の汚れからのがれ、その後再びそれに巻き込まれて征服されるなら、そのような人たちの終わりの状態は、初めの状態よりももっと悪いものとなります。","tok":[["主","ぬし"],["で"],["あり"],["救い主","すくいぬし"],["で"],["ある"],["イエス"],["・"],["キリスト"],["を"],["知る","しる"],["こと"],["によって"],["世","よ"],["の"],["汚れ","よごれ"],["から"],["のがれ"],["、"],["その後","そのあと"],["再び","ふたたび"],["それ"],["に"],["巻き込まれて","まきこまれて"],["征服","せいふく"],["されるなら"],["、"],["その"],["よう"],["な"],["人","ひと"],["たち"],["の"],["終わり","おわり"],["の"],["状態","じょうたい"],["は"],["、"],["初め","はじめ"],["の"],["状態","じょうたい"],["より"],["も"],["もっと"],["悪い","わるい"],["もの"],["と"],["なります"],["。"]]},{"verse":21,"text":"義の道を知っていながら、自分に伝えられたその聖なる命令にそむくよりは、それを知らなかったほうが、彼らにとってよかったのです。","tok":[["義","ぎ"],["の"],["道","みち"],["を"],["知って","しって"],["い"],["ながら"],["、"],["自分","じぶん"],["に"],["伝えられた","つたえられた"],["その"],["聖","せい"],["なる"],["命令","めいれい"],["に"],["そむく"],["より"],["は"],["、"],["それ"],["を"],["知らなかった","しらなかった"],["ほう"],["が"],["、"],["彼","かれ"],["ら"],["にとって"],["よかった"],["の"],["です"],["。"]]},{"verse":22,"text":"彼らに起こったことは、「犬は自分の吐いた物に戻る」とか、「豚は身を洗って、またどろの中にころがる」とかいう、ことわざどおりです。","tok":[["彼","かれ"],["ら"],["に"],["起こった","おこった"],["こと"],["は"],["、"],["「"],["犬","いぬ"],["は"],["自分","じぶん"],["の"],["吐いた","はいた"],["物","もの"],["に"],["戻る","もどる"],["」"],["と"],["か"],["、"],["「"],["豚","ぶた"],["は"],["身","み"],["を"],["洗って","あらって"],["、"],["また"],["どろ"],["の"],["中","なか"],["に"],["ころがる"],["」"],["と"],["か"],["いう"],["、"],["ことわざ"],["どおり"],["です"],["。"]]}]
[{"verse":1,"text":"そのとき、弟子たちがイエスのところに来て言った。「それでは、天の御国では、だれが一番偉いのでしょうか。」","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["イエス"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["それ"],["で"],["は"],["、"],["天","てん"],["の"],["御国","おくに"],["で"],["は"],["、"],["だれ"],["が"],["一番","いちばん"],["偉い","えらい"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":2,"text":"そこで、イエスは小さい子どもを呼び寄せ、彼らの真ん中に立たせて、","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["小さい","ちいさい"],["子ども","こども"],["を"],["呼び寄せ","よびよせ"],["、"],["彼","かれ"],["ら"],["の"],["真ん中","まんなか"],["に"],["立たせて","たたせて"],["、"]]},{"verse":3,"text":"言われた。「まことに、あなたがたに告げます。あなたがたも悔い改めて子どもたちのようにならない限り、決して天の御国には、入れません。","tok":[["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["あなた"],["がた"],["も"],["悔い改めて","くいあらためて"],["子ども","こども"],["たち"],["の"],["よう"],["に"],["ならない"],["限り","かぎり"],["、"],["決して","けっして"],["天","てん"],["の"],["御国","おくに"],["に"],["は"],["、"],["入れません","いれません"],["。"]]},{"verse":4,"text":"だから、この子どものように、自分を低くする者が、天の御国で一番偉い人です。","tok":[["だ"],["から"],["、"],["この"],["子ども","こども"],["の"],["よう"],["に"],["、"],["自分","じぶん"],["を"],["低く","ひくく"],["する"],["者","もの"],["が"],["、"],["天","てん"],["の"],["御国","おくに"],["で"],["一番","いちばん"],["偉い","えらい"],["人","ひと"],["です"],["。"]]},{"verse":5,"text":"また、だれでも、このような子どものひとりを、わたしの名のゆえに受け入れる者は、わたしを受け入れるのです。","tok":[["また"],["、"],["だれ"],["で"],["も"],["、"],["この"],["よう"],["な"],["子ども","こども"],["の"],["ひとり"],["を"],["、"],["わたし"],["の"],["名","な"],["の"],["ゆえ"],["に"],["受け入れる","うけいれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["受け入れる","うけいれる"],["の"],["です"],["。"]]},{"verse":6,"text":"しかし、わたしを信じるこの小さい者たちのひとりにでもつまずきを与えるような者は、大きい石臼を首にかけられて、湖の深みでおぼれ死んだほうがましです。","tok":[["しかし"],["、"],["わたし"],["を"],["信じる","しんじる"],["この"],["小さい","ちいさい"],["者","もの"],["たち"],["の"],["ひとり"],["に"],["で"],["も"],["つまずき"],["を"],["与える","あたえる"],["よう"],["な"],["者","もの"],["は"],["、"],["大きい","おおきい"],["石臼","いしうす"],["を"],["首","くび"],["に"],["かけられて"],["、"],["湖","みずうみ"],["の"],["深み","ふかみ"],["で"],["おぼれ死んだ","おぼれしんだ"],["ほう"],["が"],["まし"],["です"],["。"]]},{"verse":7,"text":"つまずきを与えるこの世はわざわいだ。つまずきが起こるのは避けられないが、つまずきをもたらす者はわざわいだ。","tok":[["つまずき"],["を"],["与える","あたえる"],["この世","このよ"],["は"],["わざわい"],["だ"],["。"],["つまずき"],["が"],["起こる","おこる"],["の"],["は"],["避けられない","さけられない"],["が"],["、"],["つまずき"],["を"],["もたらす"],["者","もの"],["は"],["わざわい"],["だ"],["。"]]},{"verse":8,"text":"もし、あなたの手か足の一つがあなたをつまずかせるなら、それを切って捨てなさい。片手片足でいのちに入るほうが、両手両足そろっていて永遠の火に投げ入れられるよりは、あなたにとってよいことです。","tok":[["もし"],["、"],["あなた"],["の"],["手","て"],["か"],["足","あし"],["の"],["一","ひと"],["つ"],["が"],["あなた"],["を"],["つまずかせるなら"],["、"],["それ"],["を"],["切って","きって"],["捨て","すて"],["なさい"],["。"],["片手","かたて"],["片足","かたあし"],["で"],["いのち"],["に"],["入る","はいる"],["ほう"],["が"],["、"],["両手","りょうて"],["両足","りょうあし"],["そろって"],["いて"],["永遠","えいえん"],["の"],["火","ひ"],["に"],["投げ入れられる","なげいれられる"],["より"],["は"],["、"],["あなた"],["にとって"],["よい"],["こと"],["です"],["。"]]},{"verse":9,"text":"また、もし、あなたの一方の目が、あなたをつまずかせるなら、それをえぐり出して捨てなさい。片目でいのちに入るほうが、両目そろっていて燃えるゲヘナに投げ入れられるよりは、あなたにとってよいことです。","tok":[["また"],["、"],["もし"],["、"],["あなた"],["の"],["一方","いっぽう"],["の"],["目","め"],["が"],["、"],["あなた"],["を"],["つまずかせるなら"],["、"],["それ"],["を"],["えぐり出して","えぐりだして"],["捨て","すて"],["なさい"],["。"],["片目","かため"],["で"],["いのち"],["に"],["入る","はいる"],["ほう"],["が"],["、"],["両目","りょうめ"],["そろって"],["いて"],["燃える","もえる"],["ゲヘナ"],["に"],["投げ入れられる","なげいれられる"],["より"],["は"],["、"],["あなた"],["にとって"],["よい"],["こと"],["です"],["。"]]},{"verse":10,"text":"あなたがたは、この小さい者たちを、ひとりでも見下げたりしないように気をつけなさい。まことに、あなたがたに告げます。彼らの天の御使いたちは、天におられるわたしの父の御顔をいつも見ているからです。","tok":[["あなた"],["がた"],["は"],["、"],["この"],["小さい","ちいさい"],["者","もの"],["たち"],["を"],["、"],["ひとり"],["で"],["も"],["見下げ","みさげ"],["たり"],["しない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["彼","かれ"],["ら"],["の"],["天","てん"],["の"],["御使い","おつかい"],["たち"],["は"],["、"],["天","てん"],["に"],["おられる"],["わたし"],["の"],["父","ちち"],["の"],["御顔","おかお"],["を"],["いつも"],["見て","みて"],["いる"],["から"],["です"],["。"]]},{"verse":11,"text":"〔人の子は、失われている者を救うために来たのです。〕","tok":[["〔"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["失われて","うしなわれて"],["いる"],["者","もの"],["を"],["救う","すくう"],["ため"],["に"],["来た","きた"],["の"],["です"],["。"],["〕"]]},{"verse":12,"text":"あなたがたはどう思いますか。もし、だれかが百匹の羊を持っていて、そのうちの一匹が迷い出たとしたら、その人は九十九匹を山に残して、迷った一匹を捜しに出かけないでしょうか。","tok":[["あなた"],["がた"],["は"],["どう"],["思います","おもいます"],["か"],["。"],["もし"],["、"],["だれ"],["か"],["が"],["百匹","ひゃくひき"],["の"],["羊","ひつじ"],["を"],["持って","もって"],["いて"],["、"],["その"],["うち"],["の"],["一匹","いちひき"],["が"],["迷い出た","まよいでた"],["と"],["したら"],["、"],["その"],["人","ひと"],["は"],["九十九匹","きゅうじゅうきゅうひき"],["を"],["山","やま"],["に"],["残して","のこして"],["、"],["迷った","まよった"],["一匹","いちひき"],["を"],["捜し","さがし"],["に"],["出かけないでしょう","でかけないでしょう"],["か"],["。"]]},{"verse":13,"text":"そして、もし、いたとなれば、まことに、あなたがたに告げます。その人は迷わなかった九十九匹の羊以上にこの一匹を喜ぶのです。","tok":[["そして"],["、"],["もし"],["、"],["いた"],["と"],["なれば"],["、"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["その"],["人","ひと"],["は"],["迷わなかった","まよわなかった"],["九十九匹","きゅうじゅうきゅうひき"],["の"],["羊","ひつじ"],["以上","いじょう"],["に"],["この"],["一匹","いちひき"],["を"],["喜ぶ","よろこぶ"],["の"],["です"],["。"]]},{"verse":14,"text":"このように、この小さい者たちのひとりが滅びることは、天にいますあなたがたの父のみこころではありません。","tok":[["この"],["よう"],["に"],["、"],["この"],["小さい","ちいさい"],["者","もの"],["たち"],["の"],["ひとり"],["が"],["滅びる","ほろびる"],["こと"],["は"],["、"],["天","てん"],["に"],["います"],["あなた"],["がた"],["の"],["父","ちち"],["のみ"],["こころ"],["で"],["は"],["ありません"],["。"]]},{"verse":15,"text":"また、もし、あなたの兄弟が罪を犯したなら、行って、ふたりだけのところで責めなさい。もし聞き入れたら、あなたは兄弟を得たのです。","tok":[["また"],["、"],["もし"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["が"],["罪","つみ"],["を"],["犯したなら","おかしたなら"],["、"],["行って","いって"],["、"],["ふたり"],["だけ"],["の"],["ところ"],["で"],["責め","せめ"],["なさい"],["。"],["もし"],["聞き入れたら","ききいれたら"],["、"],["あなた"],["は"],["兄弟","きょうだい"],["を"],["得た","えた"],["の"],["です"],["。"]]},{"verse":16,"text":"もし聞き入れないなら、ほかにひとりかふたりをいっしょに連れて行きなさい。ふたりか三人の証人の口によって、すべての事実が確認されるためです。","tok":[["もし"],["聞き入れないなら","ききいれないなら"],["、"],["ほか"],["に"],["ひとり"],["か"],["ふたり"],["を"],["いっしょ"],["に"],["連れて","つれて"],["行き","いき"],["なさい"],["。"],["ふたり"],["か"],["三人","さんにん"],["の"],["証人","しょうにん"],["の"],["口","くち"],["によって"],["、"],["すべて"],["の"],["事実
:[["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["もし"],["あなた"],["がた"],["の"],["義","ぎ"],["が"],["、"],["律法学者","りっぽうがくしゃ"],["や"],["パリサイ"],["人","にん"],["の"],["義","ぎ"],["に"],["まさる"],["もの"],["で"],["ないなら"],["、"],["あなた"],["がた"],["は"],["決して","けっして"],["天","てん"],["の"],["御国","おくに"],["に"],["、"],["入れません","いれません"],["。"]]},{"verse":21,"text":"昔の人々に、『人を殺してはならない。人を殺す者はさばきを受けなければならない』と言われたのを、あなたがたは聞いています。","tok":[["昔","むかし"],["の"],["人々","ひとびと"],["に"],["、"],["『"],["人","ひと"],["を"],["殺して","ころして"],["は"],["ならない"],["。"],["人","ひと"],["を"],["殺す","ころす"],["者","もの"],["は"],["さばき"],["を"],["受けなければ","うけなければ"],["ならない"],["』"],["と"],["言われた","いわれた"],["の"],["を"],["、"],["あなた"],["がた"],["は"],["聞いて","きいて"],["います"],["。"]]},{"verse":22,"text":"しかし、わたしはあなたがたに言います。兄弟に向かって腹を立てる者は、だれでもさばきを受けなければなりません。兄弟に向かって『能なし』と言うような者は、最高議会に引き渡されます。また、『ばか者』と言うような者は燃えるゲヘナに投げ込まれます。","tok":[["しかし"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言います","いいます"],["。"],["兄弟","きょうだい"],["に"],["向かって","むかって"],["腹","はら"],["を"],["立てる","たてる"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["さばき"],["を"],["受けなければ","うけなければ"],["なりません"],["。"],["兄弟","きょうだい"],["に"],["向かって","むかって"],["『"],["能","のう"],["なし"],["』"],["と"],["言う","いう"],["よう"],["な"],["者","もの"],["は"],["、"],["最高","さいこう"],["議会","ぎかい"],["に"],["引き渡されます","ひきわたされます"],["。"],["また"],["、"],["『"],["ばか者","ばかしゃ"],["』"],["と"],["言う","いう"],["よう"],["な"],["者","もの"],["は"],["燃える","もえる"],["ゲヘナ"],["に"],["投げ込まれます","なげこまれます"],["。"]]},{"verse":23,"text":"だから、祭壇の上に供え物をささげようとしているとき、もし兄弟に恨まれていることをそこで思い出したなら、","tok":[["だ"],["から"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["供え物","そなえもの"],["を"],["ささげよう"],["として"],["いる"],["とき"],["、"],["もし"],["兄弟","きょうだい"],["に"],["恨まれて","うらまれて"],["いる"],["こと"],["を"],["そこ"],["で"],["思い出したなら","おもいだしたなら"],["、"]]},{"verse":24,"text":"供え物はそこに、祭壇の前に置いたままにして、出て行って、まずあなたの兄弟と仲直りをしなさい。それから、来て、その供え物をささげなさい。","tok":[["供え物","そなえもの"],["は"],["そこ"],["に"],["、"],["祭壇","さいだん"],["の"],["前","まえ"],["に"],["置いた","おいた"],["まま"],["に"],["して"],["、"],["出て","でて"],["行って","いって"],["、"],["まず"],["あなた"],["の"],["兄弟","きょうだい"],["と
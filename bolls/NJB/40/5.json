[{"verse":1,"text":"この群衆を見て、イエスは山に登り、おすわりになると、弟子たちがみもとに来た。","tok":[["この"],["群衆","ぐんしゅう"],["を"],["見て","みて"],["、"],["イエス"],["は"],["山","やま"],["に"],["登り","のぼり"],["、"],["おすわり"],["に"],["なる"],["と"],["、"],["弟子","でし"],["たち"],["が"],["みもと"],["に"],["来た","きた"],["。"]]},{"verse":2,"text":"そこで、イエスは口を開き、彼らに教えて、言われた。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["口","くち"],["を"],["開き","ひらき"],["、"],["彼","かれ"],["ら"],["に"],["教えて","おしえて"],["、"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"「心の貧しい者は幸いです。天の御国はその人たちのものだから。","tok":[["「"],["心","こころ"],["の"],["貧しい","まずしい"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["天","てん"],["の"],["御国","みくに"],["は"],["その"],["人","ひと"],["たち"],["の"],["もの"],["だ"],["から"],["。"]]},{"verse":4,"text":"悲しむ者は幸いです。その人たちは慰められるから。","tok":[["悲しむ","かなしむ"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["その"],["人","ひと"],["たち"],["は"],["慰められる","なぐさめられる"],["から"],["。"]]},{"verse":5,"text":"柔和な者は幸いです。その人たちは地を受け継ぐから。","tok":[["柔和","にゅうわ"],["な"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["その"],["人","ひと"],["たち"],["は"],["地","ち"],["を"],["受け継ぐ","うけつぐ"],["から"],["。"]]},{"verse":6,"text":"義に飢え渇く者は幸いです。その人たちは満ち足りるから。","tok":[["義","ぎ"],["に"],["飢え渇く","うえかわく"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["その"],["人","ひと"],["たち"],["は"],["満ち足りる","みちたりる"],["から"],["。"]]},{"verse":7,"text":"あわれみ深い者は幸いです。その人たちはあわれみを受けるから。","tok":[["あわれみ"],["深い","ふかい"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["その"],["人","ひと"],["たち"],["は"],["あわれみ"],["を"],["受ける","うける"],["から"],["。"]]},{"verse":8,"text":"心のきよい者は幸いです。その人たちは神を見るから。","tok":[["心","こころ"],["の"],["きよい"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["その"],["人","ひと"],["たち"],["は"],["神","かみ"],["を"],["見る","みる"],["から"],["。"]]},{"verse":9,"text":"平和をつくる者は幸いです。その人たちは神の子どもと呼ばれるから。","tok":[["平和","へいわ"],["を"],["つくる"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["その"],["人","ひと"],["たち"],["は"],["神","かみ"],["の"],["子ども","こども"],["と"],["呼ばれる","よばれる"],["から"],["。"]]},{"verse":10,"text":"義のために迫害されている者は幸いです。天の御国はその人たちのものだから。","tok":[["義","ぎ"],["の"],["ため"],["に"],["迫害","はくがい"],["されて"],["いる"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["天","てん"],["の"],["御国","みくに"],["は"],["その"],["人","ひと"],["たち"],["の"],["もの"],["だ"],["から"],["。"]]},{"verse":11,"text":"わたしのために人々があなたがたをののしり、迫害し、ありもしないことで悪口を浴びせるとき、あなたがたは幸いです。","tok":[["わたし"],["の"],["ため"],["に"],["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["ののしり"],["、"],["迫害","はくがい"],["し"],["、"],["あり"],["も"],["しない"],["こと"],["で"],["悪口","わるぐち"],["を"],["浴びせる","あびせる"],["とき"],["、"],["あなた"],["がた"],["は"],["幸い","さいわい"],["です"],["。"]]},{"verse":12,"text":"喜びなさい。喜びおどりなさい。天ではあなたがたの報いは大きいから。あなたがたより前にいた預言者たちを、人々はそのように迫害したのです。","tok":[["喜び","よろこび"],["なさい"],["。"],["喜び","よろこび"],["おどり"],["なさい"],["。"],["天","てん"],["で"],["は"],["あなた"],["がた"],["の"],["報い","むくい"],["は"],["大きい","おおきい"],["から"],["。"],["あなた"],["が"],["たより"],["前","まえ"],["に"],["いた"],["預言者","よげんしゃ"],["たち"],["を"],["、"],["人々","ひとびと"],["は"],["その"],["よう"],["に"],["迫害","はくがい"],["した"],["の"],["です"],["。"]]},{"verse":13,"text":"あなたがたは、地の塩です。もし塩が塩けをなくしたら、何によって塩けをつけるのでしょう。もう何の役にも立たず、外に捨てられて、人々に踏みつけられるだけです。","tok":[["あなた"],["がた"],["は"],["、"],["地","ち"],["の"],["塩","しお"],["です"],["。"],["もし"],["塩","しお"],["が"],["塩け","しおけ"],["を"],["なくしたら"],["、"],["何","なん"],["によって"],["塩け","しおけ"],["を"],["つける"],["の"],["でしょう"],["。"],["もう"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立たず","たたず"],["、"],["外","そと"],["に"],["捨てられて","すてられて"],["、"],["人々","ひとびと"],["に"],["踏みつけられる","ふみつけられる"],["だけ"],["です"],["。"]]},{"verse":14,"text":"あなたがたは、世界の光です。山の上にある町は隠れる事ができません。","tok":[["あなた"],["がた"],["は"],["、"],["世界","せかい"],["の"],["光","ひかり"],["です"],["。"],["山","やま"],["の"],["上","うえ"],["に"],["ある"],["町","まち"],["は"],["隠れる","かくれる"],["事","こと"],["が"],["できません"],["。"]]},{"verse":15,"text":"また、あかりをつけて、それを枡の下に置く者はありません。燭台の上に置きます。そうすれば、家にいる人々全部を照らします。","tok":[["また"],["、"],["あかり"],["を"],["つけて"],["、"],["それ"],["を"],["枡","ます"],["の"],["下","した"],["に"],["置く","おく"],["者","もの"],["は"],["ありません"],["。"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["置きます","おきます"],["。"],["そう"],["すれば"],["、"],["家","いえ"],["に"],["いる"],["人々","ひとびと"],["全部","ぜんぶ"],["を"],["照らします","てらします"],["。"]]},{"verse":16,"text":"このよ
[{"verse":1,"text":"さて、安息日が終わって、週の初めの日の明け方、マグダラのマリヤと、ほかのマリヤが墓を見に来た。","tok":[["さて"],["、"],["安息日","あんそくび"],["が"],["終わって","おわって"],["、"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["の"],["明け方","あけがた"],["、"],["マグダラ"],["の"],["マリヤ"],["と"],["、"],["ほか"],["の"],["マリヤ"],["が"],["墓","はか"],["を"],["見","み"],["に"],["来た","きた"],["。"]]},{"verse":2,"text":"すると、大きな地震が起こった。それは、主の使いが天から降りて来て、石をわきへころがして、その上にすわったからである。","tok":[["する"],["と"],["、"],["大きな","おおきな"],["地震","じしん"],["が"],["起こった","おこった"],["。"],["それ"],["は"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["天","てん"],["から"],["降りて","おりて"],["来て","きて"],["、"],["石","いし"],["を"],["わき"],["へ"],["ころがして"],["、"],["その"],["上","うえ"],["に"],["すわった"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"その顔は、いなずまのように輝き、その衣は雪のように白かった。","tok":[["その"],["顔","かお"],["は"],["、"],["いなずま"],["の"],["よう"],["に"],["輝き","かがやき"],["、"],["その"],["衣","ころも"],["は"],["雪","ゆき"],["の"],["よう"],["に"],["白かった","しろかった"],["。"]]},{"verse":4,"text":"番兵たちは、御使いを見て恐ろしさのあまり震え上がり、死人のようになった。","tok":[["番兵","ばんぺい"],["たち"],["は"],["、"],["御使い","おつかい"],["を"],["見て","みて"],["恐ろし","おそろし"],["さ"],["の"],["あまり"],["震え上がり","ふるえあがり"],["、"],["死人","しにん"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":5,"text":"すると、御使いは女たちに言った。「恐れてはいけません。あなたがたが十字架につけられたイエスを捜しているのを、私は知っています。","tok":[["する"],["と"],["、"],["御使い","おつかい"],["は"],["女","おんな"],["たち"],["に"],["言った","いった"],["。"],["「"],["恐れて","おそれて"],["は"],["いけません"],["。"],["あなた"],["がた"],["が"],["十字架","じゅうじか"],["に"],["つけられた"],["イエス"],["を"],["捜して","さがして"],["いる"],["の"],["を"],["、"],["私","わたくし"],["は"],["知って","しって"],["います"],["。"]]},{"verse":6,"text":"ここにはおられません。前から言っておられたように、よみがえられたからです。来て、納めてあった場所を見てごらんなさい。","tok":[["ここ"],["に"],["は"],["おられません"],["。"],["前","まえ"],["から"],["言って","いって"],["おられた"],["よう"],["に"],["、"],["よみがえられた"],["から"],["です"],["。"],["来て","きて"],["、"],["納めて","おさめて"],["あった"],["場所","ばしょ"],["を"],["見て","みて"],["ごらん"],["なさい"],["。"]]},{"verse":7,"text":"ですから急いで行って、お弟子たちにこのことを知らせなさい。イエスが死人の中からよみがえられたこと、そして、あなたがたより先にガリラヤに行かれ、あなたがたは、そこで、お会いできるということです。では、これだけはお伝えしました。」","tok":[["です"],["から"],["急いで","いそいで"],["行って","いって"],["、"],["お弟子","おでし"],["たち"],["に"],["この"],["こと"],["を"],["知らせ","しらせ"],["なさい"],["。"],["イエス"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえられた"],["こと"],["、"],["そして"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["ガリラヤ"],["に"],["行かれ","いかれ"],["、"],["あなた"],["がた"],["は"],["、"],["そこ"],["で"],["、"],["お会い","おあい"],["できる"],["と"],["いう"],["こと"],["です"],["。"],["で"],["は"],["、"],["これ"],["だけ"],["は"],["お伝え","おつたえ"],["しました"],["。"],["」"]]},{"verse":8,"text":"そこで、彼女たちは、恐ろしくはあったが大喜びで、急いで墓を離れ、弟子たちに知らせに走って行った。","tok":[["そこ"],["で"],["、"],["彼女","かのじょ"],["たち"],["は"],["、"],["恐ろしく","おそろしく"],["は"],["あった"],["が"],["大喜び","おおよろこび"],["で"],["、"],["急いで","いそいで"],["墓","はか"],["を"],["離れ","はなれ"],["、"],["弟子","でし"],["たち"],["に"],["知らせ","しらせ"],["に"],["走って","はしって"],["行った","いった"],["。"]]},{"verse":9,"text":"すると、イエスが彼女たちに出会って、「おはよう」と言われた。彼女たちは近寄って御足を抱いてイエスを拝んだ。","tok":[["する"],["と"],["、"],["イエス"],["が"],["彼女","かのじょ"],["たち"],["に"],["出会って","であって"],["、"],["「"],["おはよう"],["」"],["と"],["言われた","いわれた"],["。"],["彼女","かのじょ"],["たち"],["は"],["近寄って","ちかよって"],["御足","おあし"],["を"],["抱いて","いだいて"],["イエス"],["を"],["拝んだ","おがんだ"],["。"]]},{"verse":10,"text":"すると、イエスは言われた。「恐れてはいけません。行って、わたしの兄弟たちに、ガリラヤに行くように言いなさい。そこでわたしに会えるのです。」","tok":[["する"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["恐れて","おそれて"],["は"],["いけません"],["。"],["行って","いって"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["に"],["、"],["ガリラヤ"],["に"],["行く","いく"],["よう"],["に"],["言い","いい"],["なさい"],["。"],["そこ"],["で"],["わたし"],["に"],["会える","あえる"],["の"],["です"],["。"],["」"]]},{"verse":11,"text":"女たちが行き着かないうちに、もう、数人の番兵が都に来て、起こった事を全部、祭司長たちに報告した。","tok":[["女","おんな"],["たち"],["が"],["行き着かない","いきつかない"],["うち"],["に"],["、"],["もう"],["、"],["数人","すうにん"],["の"],["番兵","ばんぺい"],["が"],["都","と"],["に"],["来て","きて"],["、"],["起こった","おこった"],["事","こと"],["を"],["全部","ぜんぶ"],["、"],["祭司長","さいしちょう"],["たち"],["に"],["報告","ほうこく"],["した"],["。"]]},{"verse":12,"text":"そこで、祭司長たちは民の長老たちとともに集まって協議し、兵士たちに多額の金を与えて、","tok":[["そこ"],["で"],["、"],["祭司長","さいしちょう"],["たち"],["は"],["民","みん"],["の"],["長老","ちょうろう"],["たち"],["と"],["とも"],["に"],["集まって","あつまって"],["協議","きょうぎ"],["し"],["、"],["兵士","へいし"],["たち"],["に"],["多額","たがく"],["の"],["金","かね"],["を"],["与えて","あたえて"],["、"]]},{"verse":13,"text":"こう言った。「『夜、私たちが眠っている間に、弟子たちがやって来て、イエスを盗んで行った』と言うのだ。","tok":[["こう"],["言った","いった"],["。"],["「"],["『"],["夜","よる"],["、"],["私たち","わたしたち"],["が"],["眠って","ねむって"],["いる"],["間","あいだ"],["に"],["、"],["弟子","でし"],["たち"],["が"],["やって"],["来て","きて"],["、"],["イエス"],["を"],["盗んで","ぬすんで"],["行った","いった"],["』"],["と"],["言う","いう"],["の"],["だ"],["。"]]},{"verse":14,"text":"もし、このことが総督の耳に入っても、私たちがうまく説得して、あなたがたには心配をかけないようにするから。」","tok":[["もし"],["、"],["この"],["こと"],["が"],["総督","そうとく"],["の"],["耳","みみ"],["に"],["入って","はいって"],["も"],["、"],["私たち","わたしたち"],["が"],["うまく"],["説得","せっとく"],["して"],["、"],["あなた"],["がた"],["に"],["は"],["心配","しんぱい"],["を"],["かけない"],["よう"],["に"],["する"],["から"],["。"],["」"]]},{"verse":15,"text":"そこで、彼らは金をもらって、指図されたとおりにした。それで、この話が広くユダヤ人の間に広まって今日に及んでいる。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["金","きん"],["を"],["もらって"],["、"],["指図","さしず"],["された"],["とおり"],["に"],["した"],["。"],["それ"],["で"],["、"],["この"],["話","はなし"],["が"],["広く","ひろく"],["ユダヤ人","ゆだやじん"],["の"],["間","あいだ"],["に"],["広まって","ひろまって"],["今日","きょう"],["に"],["及んで","およんで"],["いる"],["。"]]},{"verse":16,"text":"しかし、十一人の弟子たちは、ガリラヤに行って、イエスの指示された山に登った。","tok":[["しかし"],["、"],["十一人","じゅういちにん"],["の"],["弟子","でし"],["たち"],["は"],["、"],["ガリラヤ"],["に"],["行って","いって"],["、"],["イエス"],["の"],["指示","しじ"],["された"],["山","やま"],["に"],["登った","のぼった"],["。"]]},{"verse":17,"text":"そして、イエスにお会いしたとき、彼らは礼拝した。しかし、ある者は疑った。","tok":[["そして"],["、"],["イエス"],["に"],["お会い","おあい"],["した"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["礼拝","れいはい"],["した"],["。"],["しかし"],["、"],["ある"],["者","もの"],["は"],["疑った","うたがった"],["。"]]},{"verse":18,"text":"イエスは近づいて来て、彼らにこう言われた。「わたしには天においても、地においても、いっさいの権威が与えられています。","tok":[["イエス"],["は"],["近づいて","ちかづいて"],["来て","きて"],["、"],["彼","かれ"],["ら"],["に"],["こう"],["言われた","いわれた"],["。"],["「"],["わたし"],["に"],["は"],["天","てん"],["に"],["おいて"],["も"],["、"],["地","ち"],["に"],["おいて"],["も"],["、"],["いっさい"],["の"],["権威","けんい"],["が"],["与えられて","あたえられて"],["います"],["。"]]},{"verse":19,"text":"それゆえ、あなたがたは行って、あらゆる国の人々を弟子としなさい。そして、父、子、聖霊の御名によってバプテスマを授け、","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["行って","いって"],["、"],["あらゆる"],["国","くに"],["の"],["人々","ひとびと"],["を"],["弟子","でし"],["と"],["し"],["なさい"],["。"],["そして"],["、"],["父","ちち"],["、"],["子","こ"],["、"],["聖霊","せいれい"],["の"],["御名","ぎょめい"],["によって"],["バプテスマ"],["を"],["授け","さずけ"],["、"]]},{"verse":20,"text":"また、わたしがあなたがたに命じておいたすべてのことを守るように、彼らを教えなさい。見よ。わたしは、世の終わりまで、いつも、あなたがたとともにいます。」","tok":[["また"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["命じて","めいじて"],["おいた"],["すべて"],["の"],["こと"],["を"],["守る","まもる"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["教え","おしえ"],["なさい"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["世","よ"],["の"],["終わり","おわり"],["まで"],["、"],["いつも"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["います"],["。"],["」"]]}]
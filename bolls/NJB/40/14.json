],["の"],["ところ"],["に"],["行かれた","いかれた"],["。"]]},{"verse":26,"text":"弟子たちは、イエスが湖の上を歩いておられるのを見て、「あれは幽霊だ」と言って、おびえてしまい、恐ろしさのあまり、叫び声を上げた。","tok":[["弟子","でし"],["たち"],["は"],["、"],["イエス"],["が"],["湖","みずうみ"],["の"],["上","うえ"],["を"],["歩いて","あるいて"],["おられる"],["の"],["を"],["見て","みて"],["、"],["「"],["あれ"],["は"],["幽霊","ゆうれい"],["だ"],["」"],["と"],["言って","いって"],["、"],["おびえて"],["しまい"],["、"],["恐ろし","おそろし"],["さ"],["の"],["あまり"],["、"],["叫び声","さけびごえ"],["を"],["上げた","あげた"],["。"]]},{"verse":27,"text":"しかし、イエスはすぐに彼らに話しかけ、「しっかりしなさい。わたしだ。恐れることはない」と言われた。","tok":[["しかし"],["、"],["イエス"],["は"],["すぐ"],["に"],["彼","かれ"],["ら"],["に"],["話しかけ","はなしかけ"],["、"],["「"],["しっかり"],["し"],["なさい"],["。"],["わたし"],["だ"],["。"],["恐れる","おそれる"],["こと"],["は"],["ない"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":28,"text":"すると、ペテロが答えて言った。「主よ。もし、あなたでしたら、私に、水の上を歩いてここまで来い、とお命じになってください。」","tok":[["する"],["と"],["、"],["ペテロ"],["が"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["もし"],["、"],["あなた"],["でしたら"],["、"],["私","わたくし"],["に"],["、"],["水","みず"],["の"],["上","うえ"],["を"],["歩いて","あるいて"],["ここ"],["まで"],["来い","こい"],["、"],["と"],["お命じ","おめいじ"],["に"],["なって"],["ください"],["。"],["」"]]},{"verse":29,"text":"イエスは「来なさい」と言われた。そこで、ペテロは舟から出て、水の上を歩いてイエスのほうに行った。","tok":[["イエス"],["は"],["「"],["来","き"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["そこ"],["で"],["、"],["ペテロ"],["は"],["舟","ふね"],["から"],["出て","でて"],["、"],["水","みず"],["の"],["上","うえ"],["を"],["歩いて","あるいて"],["イエス"],["の"],["ほう"],["に"],["行った","いった"],["。"]]},{"verse":30,"text":"ところが、風を見て、こわくなり、沈みかけたので叫び出し、「主よ。助けてください」と言った。","tok":[["ところ"],["が"],["、"],["風","かぜ"],["を"],["見て","みて"],["、"],["こわく"],["なり"],["、"],["沈みかけた","しずみかけた"],["ので"],["叫び出し","さけびだし"],["、"],["「"],["主","ぬし"],["よ"],["。"],["助けて","たすけて"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":31,"text":"そこで、イエスはすぐに手を伸ばして、彼をつかんで言われた。「信仰の薄い人だな。なぜ疑うのか。」","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["すぐ"],["に"],["手","て"],["を"],["伸ばして","のばして"],["、"],["彼","かれ"],["を"],["つかんで"],["言われた","いわれた"],["。"],["「"],["信仰","しんこう"],["の"],["薄い","うすい"],["人","ひと"],["だ"],["な"],["。"],["なぜ"],["疑う","うたがう"],["の"],["か"],["。"],["」"]]},{"verse":32,"text":"そして、ふたりが舟に乗り移ると、風がやんだ。","tok":[["そして"],["、"],["ふたり"],["が"],["舟","ふね"],["に"],["乗り移る","のりうつる"],["と"],["、"],["風","かぜ"],["が"],["やんだ"],["。"]]},{"verse":33,"text":"そこで、舟の中にいた者たちは、イエスを拝んで、「確かにあなたは神の子です」と言った。","tok":[["そこ"],["で"],["、"],["舟","ふね"],["の"],["中","なか"],["に"],["いた"],["者","もの"],["たち"],["は"],["、"],["イエス"],["を"],["拝んで","おがんで"],["、"],["「"],["確か","たしか"],["に"],["あなた"],["は"],["神","かみ"],["の"],["子","こ"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":34,"text":"彼らは湖を渡ってゲネサレの地に着いた。","tok":[["彼","かれ"],["ら"],["は"],["湖","みずうみ"],["を"],["渡って","わたって"],["ゲネサレ"],["の"],["地","ち"],["に"],["着いた","ついた"],["。"]]},{"verse":35,"text":"すると、その地の人々は、イエスと気がついて、付近の地域にくまなく知らせ、病人という病人をみな、みもとに連れて来た。","tok":[["する"],["と"],["、"],["その"],["地","ち"],["の"],["人々","ひとびと"],["は"],["、"],["イエス"],["と"],["気","き"],["が"],["ついて"],["、"],["付近","ふきん"],["の"],["地域","ちいき"],["に"],["くまなく"],["知らせ","しらせ"],["、"],["病人","びょうにん"],["と"],["いう"],["病人","びょうにん"],["を"],["みな"],["、"],["みもと"],["に"],["連れて","つれて"],["来た","きた"],["。"]]},{"verse":36,"text":"そして、せめて彼らに、着物のふさにでもさわらせてやってくださいと、イエスにお願いした。そして、さわった人々はみな、いやされた。","tok":[["そして"],["、"],["せめて"],["彼","かれ"],["ら"],["に"],["、"],["着物","きもの"],["の"],["ふさに"],["で"],["も"],["さわらせて"],["やって"],["ください"],["と"],["、"],["イエス"],["に"],["お願い","おねがい"],["した"],["。"],["そして"],["、"],["さわった"],["人々","ひとびと"],["は"],["みな"],["、"],["いやされた"],["。"]]}]
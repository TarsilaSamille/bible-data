[{"verse":1,"text":"そのころ、国主ヘロデは、イエスのうわさを聞いて、","tok":[["その"],["ころ"],["、"],["国主","こくしゅ"],["ヘロデ"],["は"],["、"],["イエス"],["の"],["うわさ"],["を"],["聞いて","きいて"],["、"]]},{"verse":2,"text":"侍従たちに言った。「あれはバプテスマのヨハネだ。ヨハネが死人の中からよみがえったのだ。だから、あんな力が彼のうちに働いているのだ。」","tok":[["侍従","じじゅう"],["たち"],["に"],["言った","いった"],["。"],["「"],["あれ"],["は"],["バプテスマ"],["の"],["ヨハネ"],["だ"],["。"],["ヨハネ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえった"],["の"],["だ"],["。"],["だ"],["から"],["、"],["あんな"],["力","ちから"],["が"],["彼","かれ"],["の"],["うち"],["に"],["働いて","はたらいて"],["いる"],["の"],["だ"],["。"],["」"]]},{"verse":3,"text":"実は、このヘロデは、自分の兄弟ピリポの妻ヘロデヤのことで、ヨハネを捕らえて縛り、牢に入れたのであった。","tok":[["実","じつ"],["は"],["、"],["この"],["ヘロデ"],["は"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["ピリポ"],["の"],["妻","つま"],["ヘロデヤ"],["の"],["こと"],["で"],["、"],["ヨハネ"],["を"],["捕らえて","とらえて"],["縛り","しばり"],["、"],["牢","ろう"],["に"],["入れた","いれた"],["ので"],["あった"],["。"]]},{"verse":4,"text":"それは、ヨハネが彼に、「あなたが彼女をめとるのは不法です」と言い張ったからである。","tok":[["それ"],["は"],["、"],["ヨハネ"],["が"],["彼","かれ"],["に"],["、"],["「"],["あなた"],["が"],["彼女","かのじょ"],["を"],["めとる"],["の"],["は"],["不法","ふほう"],["です"],["」"],["と"],["言い張った","いいはった"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"ヘロデはヨハネを殺したかったが、群衆を恐れた。というのは、彼らはヨハネを預言者と認めていたからである。","tok":[["ヘロデ"],["は"],["ヨハネ"],["を"],["殺したかった","ころしたかった"],["が"],["、"],["群衆","ぐんしゅう"],["を"],["恐れた","おそれた"],["。"],["と"],["いう"],["の"],["は"],["、"],["彼","かれ"],["ら"],["は"],["ヨハネ"],["を"],["預言者","よげんしゃ"],["と"],["認めて","みとめて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"たまたまヘロデの誕生祝いがあって、ヘロデヤの娘がみなの前で踊りを踊ってヘロデを喜ばせた。","tok":[["たまたま"],["ヘロデ"],["の"],["誕生","たんじょう"],["祝い","いわい"],["が"],["あって"],["、"],["ヘロデヤ"],["の"],["娘","むすめ"],["が"],["みな"],["の"],["前","まえ"],["で"],["踊り","おどり"],["を"],["踊って","おどって"],["ヘロデ"],["を"],["喜ばせた","よろこばせた"],["。"]]},{"verse":7,"text":"それで、彼は、その娘に、願う物は何でも必ず上げると、誓って堅い約束をした。","tok":[["それ"],["で"],["、"],["彼","かれ"],["は"],["、"],["その"],["娘","むすめ"],["に"],["、"],["願う","ねがう"],["物","もの"],["は"],["何","なん"],["で"],["も"],["必ず","かならず"],["上げる","あげる"],["と"],["、"],["誓って","ちかって"],["堅い","かたい"],["約束","やくそく"],["を"],["した"],["。"]]},{"verse":8,"text":"ところが、娘は母親にそそのかされて、こう言った。「今ここに、バプテスマのヨハネの首を盆に載せて私に下さい。」","tok":[["ところ"],["が"],["、"],["娘","むすめ"],["は"],["母親","ははおや"],["に"],["そそのかされて"],["、"],["こう"],["言った","いった"],["。"],["「"],["今","いま"],["ここ"],["に"],["、"],["バプテスマ"],["の"],["ヨハネ"],["の"],["首","くび"],["を"],["盆","ぼん"],["に"],["載せて","のせて"],["私","わたくし"],["に"],["下さい","ください"],["。"],["」"]]},{"verse":9,"text":"王は心を痛めたが、自分の誓いもあり、また列席の人々の手前もあって、与えるように命令した。","tok":[["王","おう"],["は"],["心","こころ"],["を"],["痛めた","いためた"],["が"],["、"],["自分","じぶん"],["の"],["誓い","ちかい"],["も"],["あり"],["、"],["また"],["列席","れっせき"],["の"],["人々","ひとびと"],["の"],["手前","てまえ"],["も"],["あって"],["、"],["与える","あたえる"],["よう"],["に"],["命令","めいれい"],["した"],["。"]]},{"verse":10,"text":"彼は人をやって、牢の中でヨハネの首をはねさせた。","tok":[["彼","かれ"],["は"],["人","ひと"],["を"],["やって"],["、"],["牢","ろう"],["の"],["中","なか"],["で"],["ヨハネ"],["の"],["首","くび"],["を"],["はねさせた"],["。"]]},{"verse":11,"text":"そして、その首は盆に載せて運ばれ、少女に与えられたので、少女はそれを母親のところに持って行った。","tok":[["そして"],["、"],["その"],["首","くび"],["は"],["盆","ぼん"],["に"],["載せて","のせて"],["運ばれ","はこばれ"],["、"],["少女","しょうじょ"],["に"],["与えられた","あたえられた"],["ので"],["、"],["少女","しょうじょ"],["は"],["それ"],["を"],["母親","ははおや"],["の"],["ところ"],["に"],["持って","もって"],["行った","いった"],["。"]]},{"verse":12,"text":"それから、ヨハネの弟子たちがやって来て、死体を引き取って葬った。そして、イエスのところに行って報告した。","tok":[["それ"],["から"],["、"],["ヨハネ"],["の"],["弟子","でし"],["たち"],["が"],["やって"],["来て","きて"],["、"],["死体","したい"],["を"],["引き取って","ひきとって"],["葬った","ほうむった"],["。"],["そして"],["、"],["イエス"],["の"],["ところ"],["に"],["行って","いって"],["報告","ほうこく"],["した"],["。"]]},{"verse":13,"text":"イエスはこのことを聞かれると、舟でそこを去り、自分だけで寂しい所に行かれた。すると、群衆がそれと聞いて、町々から、歩いてイエスのあとを追った。","tok":[["イエス"],["は"],["この"],["こと"],["を"],["聞かれる","きかれる"],["と"],["、"],["舟","ふね"],["で"],["そこ"],["を"],["去り","さり"],["、"],["自分","じぶん"],["だけ"],["で"],["寂しい","さびしい"],["所","ところ"],["に"],["行かれた","いかれた"],["。"],["する"],["と"],["、"],["群衆","ぐんしゅう"],["が"],["それ"],["と"],["聞いて","きいて"],["、"],["町々","まちまち"],["から"],["、"],["歩いて","あるいて"],["イエス"],["の"],["あと"],["を"],["追った","おった"],["。"]]},{"verse":14,"text
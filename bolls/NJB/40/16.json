[{"verse":1,"text":"パリサイ人やサドカイ人たちがみそばに寄って来て、イエスをためそうとして、天からのしるしを見せてくださいと頼んだ。","tok":[["パリサイ"],["人","にん"],["や"],["サドカイ"],["人","にん"],["たち"],["が"],["みそば"],["に"],["寄って","よって"],["来て","きて"],["、"],["イエス"],["を"],["ためそう"],["として"],["、"],["天","てん"],["から"],["の"],["しるし"],["を"],["見せて","みせて"],["ください"],["と"],["頼んだ","たのんだ"],["。"]]},{"verse":2,"text":"しかし、イエスは彼らに答えて言われた。「あなたがたは、夕方には、『夕焼けだから晴れる』と言うし、","tok":[["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["夕方","ゆうがた"],["に"],["は"],["、"],["『"],["夕焼け","ゆうやけ"],["だ"],["から"],["晴れる","はれる"],["』"],["と"],["言う","ゆう"],["し"],["、"]]},{"verse":3,"text":"朝には、『朝焼けでどんよりしているから、きょうは荒れ模様だ』と言う。そんなによく、空模様の見分け方を知っていながら、なぜ時のしるしを見分けることができないのですか。","tok":[["朝","あさ"],["に"],["は"],["、"],["『"],["朝焼け","あさやけ"],["で"],["どんより"],["して"],["いる"],["から"],["、"],["きょう"],["は"],["荒れ","あれ"],["模様","もよう"],["だ"],["』"],["と"],["言う","ゆう"],["。"],["そんな"],["に"],["よく"],["、"],["空模様","そらもよう"],["の"],["見分け","みわけ"],["方","かた"],["を"],["知って","しって"],["い"],["ながら"],["、"],["なぜ"],["時","とき"],["の"],["しるし"],["を"],["見分ける","みわける"],["こと"],["が"],["できない"],["の"],["です"],["か"],["。"]]},{"verse":4,"text":"悪い、姦淫の時代はしるしを求めています。しかし、ヨナのしるしのほかには、しるしは与えられません。」そう言って、イエスは彼らを残して去って行かれた。","tok":[["悪い","わるい"],["、"],["姦淫","かんいん"],["の"],["時代","じだい"],["は"],["しるし"],["を"],["求めて","もとめて"],["います"],["。"],["しかし"],["、"],["ヨナ"],["の"],["しるし"],["の"],["ほか"],["に"],["は"],["、"],["しるし"],["は"],["与えられません","あたえられません"],["。"],["」"],["そう"],["言って","いって"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["残して","のこして"],["去って","さって"],["行かれた","いかれた"],["。"]]},{"verse":5,"text":"弟子たちは向こう岸に行ったが、パンを持って来るのを忘れた。","tok":[["弟子","でし"],["たち"],["は"],["向こう岸","むこうぎし"],["に"],["行った","いった"],["が"],["、"],["パン"],["を"],["持って","もって"],["来る","くる"],["の"],["を"],["忘れた","わすれた"],["。"]]},{"verse":6,"text":"イエスは彼らに言われた。「パリサイ人やサドカイ人たちのパン種には注意して気をつけなさい。」","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["パリサイ"],["人","にん"],["や"],["サドカイ"],["人","にん"],["たち"],["の"],["パン種","ぱんだね"],["に"],["は"],["注意","ちゅうい"],["して"],["気","き"],["を"],["つけ"],["なさい"],["。"],["」"]]},{"verse":7,"text":"すると、彼らは、「これは私たちがパンを持って来なかったからだ」と言って、議論を始めた。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["これ"],["は"],["私たち","わたしたち"],["が"],["パン"],["を"],["持って","もって"],["来なかった","こなかった"],["から"],["だ"],["」"],["と"],["言って","いって"],["、"],["議論","ぎろん"],["を"],["始めた","はじめた"],["。"]]},{"verse":8,"text":"イエスはそれに気づいて言われた。「あなたがた、信仰の薄い人たち。パンがないからだなどと、なぜ論じ合っているのですか。","tok":[["イエス"],["は"],["それ"],["に"],["気づいて","きづいて"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["、"],["信仰","しんこう"],["の"],["薄い","うすい"],["人","ひと"],["たち"],["。"],["パン"],["が"],["ない"],["からだ"],["など"],["と"],["、"],["なぜ"],["論じ合って","ろんじあって"],["いる"],["の"],["です"],["か"],["。"]]},{"verse":9,"text":"まだわからないのですか、覚えていないのですか。五つのパンを五千人に分けてあげて、なお幾かご集めましたか。","tok":[["まだ"],["わからない"],["の"],["です"],["か"],["、"],["覚えて","おぼえて"],["いない"],["の"],["です"],["か"],["。"],["五","いつ"],["つ"],["の"],["パン"],["を"],["五千人","ごせんにん"],["に"],["分けて","わけて"],["あげて"],["、"],["なお"],["幾","いく"],["かご"],["集めました","あつめました"],["か"],["。"]]},{"verse":10,"text":"また、七つのパンを四千人に分けてあげて、なお幾かご集めましたか。","tok":[["また"],["、"],["七","なな"],["つ"],["の"],["パン"],["を"],["四千人","よんせんにん"],["に"],["分けて","わけて"],["あげて"],["、"],["なお"],["幾","いく"],["かご"],["集めました","あつめました"],["か"],["。"]]},{"verse":11,"text":"わたしの言ったのは、パンのことなどではないことが、どうしてあなたがたには、わからないのですか。ただ、パリサイ人やサドカイ人たちのパン種に気をつけることです。」","tok":[["わたし"],["の"],["言った","いった"],["の"],["は"],["、"],["パン"],["の"],["こと"],["など"],["で"],["は"],["ない"],["こと"],["が"],["、"],["どう"],["して"],["あなた"],["がた"],["に"],["は"],["、"],["わからない"],["の"],["です"],["か"],["。"],["ただ"],["、"],["パリサイ"],["人","にん"],["や"],["サドカイ"],["人","にん"],["たち"],["の"],["パン種","ぱんだね"],["に"],["気","き"],["を"],["つける"],["こと"],["です"],["。"],["」"]]},{"verse":12,"text":"彼らはようやく、イエスが気をつけよと言われたのは、パン種のことではなくて、パリサイ人やサドカイ人たちの教えのことであることを悟った。","tok":[["彼","かれ"],["ら"],["は"],["ようやく"],["、"],["イエス"],["が"],["気","き"],["を"],["つけよ"],["と"],["言われた","いわれた"],["の"],["は"],["、"],["パン種","ぱんだね"],["の"],["こと"],["で"],["は"],["なくて"],["、"],["パリサイ"],["人","にん"],["や"],["サドカイ"],["人","にん"],["たち"],["の"],["教え","おしえ"],["の"],["こと"],["で"],["ある"],["こと"],["を"],["悟った","さとった"],["。"]]},{"verse":13,"text":"さて、ピリポ・カイザリヤの地方に行かれたとき、イエスは弟子たちに尋ねて言われた。「人々は人の子をだれだと言っていますか。」","tok":[["さて"],["、"],["ピリポ"],["・"],["カイザリヤ"],["の"],["地方","ちほう"],["に"],["行かれた","いかれた"],["とき"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["尋ねて","たずねて"],["言われた","いわれた"],["。"],["「"],["人々","ひとびと"],["は"],["人","ひと"],["の"],["子","こ"],["を"],["だれ"],["だ"],["と"],["言って","いって"],["います"],["か"],["。"],["」"]]},{"verse":14,"text":"彼らは言った。「バプテスマのヨハネだと言う人もあり、エリヤだと言う人もあります。またほかの人たちはエレミヤだとか、また預言者のひとりだとも言っています。」","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["バプテスマ"],["の"],["ヨハネ"],["だ"],["と"],["言う","いう"],["人","ひと"],["も"],["あり"],["、"],["エリヤ"],["だ"],["と"],["言う","いう"],["人","ひと"],["も"],["あります"],["。"],["また"],["ほか"],["の"],["人","ひと"],["たち"],["は"],["エレミヤ"],["だ"],["と"],["か"],["、"],["また"],["預言者","よげんしゃ"],["の"],["ひとり"],["だ"],["と"],["も"],["言って","いって"],["います"],["。"],["」"]]},{"verse":15,"text":"イエスは彼らに言われた。「あなたがたは、わたしをだれだと言いますか。」","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["わたし"],["を"],["だれ"],["だ"],["と"],["言います","いいます"],["か"],["。"],["」"]]},{"verse":16,"text":"シモン・ペテロが答えて言った。「あなたは、生ける神の御子キリストです。」","tok":[["シモン"],["・"],["ペテロ"],["が"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["生ける","いける"],["神","かみ"],["の"],["御子","みこ"],["キリスト"],["です"],["。"],["」"]]},{"verse":17,"text":"するとイエスは、彼に答えて言われた。「バルヨナ・シモン。あなたは幸いです。このことをあなたに明らかに示したのは人間ではなく、天にいますわたしの父です。","tok":[["する"],["と"],["イエス"],["は"],["、"],["彼","かれ"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["バルヨナ"],["・"],["シモン"],["。"],["あなた"],["は"],["幸い","さいわい"],["です"],["。"],["この"],["こと"],["を"],["あなた"],["に"],["明らか","あきらか"],["に"],["示した","しめした"],["の"],["は"],["人間","にんげん"],["で"],["は"],["なく"],["、"],["天","てん"],["に"],["います"],["わたし"],["の"],["父","ちち"],["です"],["。"]]},{"verse":18,"text":"ではわたしもあなたに言います。あなたはペテロです。わたしはこの岩の上にわたしの教会を建てます。ハデスの門もそれには打ち勝てません。","tok":[["で"],["は"],["わたし"],["も"],["あなた"],["に"],["言います","いいます"],["。"],["あなた"],["は"],["ペテロ"],["です"],["。"],["わたし"],["は"],["この"],["岩","いわ"],["の"],["上","うえ"],["に"],["わたし"],["の"],["教会","きょうかい"],["を"],["建てます","たてます"],["。"],["ハデス"],["の"],["門","もん"],["も"],["それ"],["に"],["は"],["打ち勝てません","うちかてません"],["。"]]},{"verse":19,"text":"わたしは、あなたに天の御国のかぎを上げます。何でもあなたが地上でつなぐなら、それは天においてもつながれており、あなたが地上で解くなら、それは天においても解かれています。」","tok":[["わたし"],["は"],["、"],["あなた"],["に"],["天","てん"],["の"],["御国","みくに"],["の"],["かぎ"],["を"],["上げます","あげます"],["。"],["何","なん"],["で"],["も"],["あなた"],["が"],["地上","ちじょう"],["で"],["つなぐなら"],["、"],["それ"],["は"],["天","てん"],["に"],["おいて"],["も"],["つながれて"],["おり"],["、"],["あなた"],["が"],["地上","ちじょう"],["で"],["解くなら","とくなら"],["、"],["それ"],["は"],["天","てん"],["に"],["おいて"],["も"],["解かれて","とかれて"],["います"],["。"],["」"]]},{"verse":20,"text":"そのとき、イエスは、ご自分がキリストであることをだれにも言ってはならない、と弟子たちを戒められた。","tok":[["その"],["とき"],["、"],["イエス"],["は"],["、"],["ご自分","ごじぶん"],["が"],["キリスト"],["で"],["ある"],["こと"],["を"],["だれ"],["に"],["も"],["言って","いって"],["は"],["ならない"],["、"],["と"],["弟子","でし"],["たち"],["を"],["戒められた","いましめられた"],["。"]]},{"verse":21,"text":"その時から、イエス・キリストは、ご自分がエルサレムに行って、長老、祭司長、律法学者たちから多くの苦しみを受け、殺され、そして三日目によみがえらなければならないことを弟子たちに示し始められた。","tok":[["その"],["時","とき"],["から"],["、"],["イエス"],["・"],["キリスト"],["は"],["、"],["ご自分","ごじぶん"],["が"],["エルサレム"],["に"],["行って","いって"],["、"],["長老","ちょうろう"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["から"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["殺され","ころされ"],["、"],["そして"],["三日目","みっかめ"],["に"],["よみがえらなければ"],["ならない"],["こと"],["を"],["弟子","でし"],["たち"],["に"],["示し","しめし"],["始められた","はじめられた"],["。"]]},{"verse":22,"text":"するとペテロは、イエスを引き寄せて、いさめ始めた。「主よ。神の御恵みがありますように。そんなことが、あなたに起こるはずはありません。」","tok":[["する"],["と"],["ペテロ"],["は"],["、"],["イエス"],["を"],["引き寄せて","ひきよせて"],["、"],["いさめ"],["始めた","はじめた"],["。"],["「"],["主","ぬし"],["よ"],["。"],["神","かみ"],["の"],["御恵み","おめぐみ"],["が"],["あります"],["よう"],["に"],["。"],["そんな"],["こと"],["が"],["、"],["あなた"],["に"],["起こる","おこる"],["はず"],["は"],["ありません"],["。"],["」"]]},{"verse":23,"text":"しかし、イエスは振り向いて、ペテロに言われた。「下がれ。サタン。あなたはわたしの邪魔をするものだ。あなたは神のことを思わないで、人のことを思っている。」","tok":[["しかし"],["、"],["イエス"],["は"],["振り向いて","ふりむいて"],["、"],["ペテロ"],["に"],["言われた","いわれた"],["。"],["「"],["下がれ","さがれ"],["。"],["サタン"],["。"],["あなた"],["は"],["わたし"],["の"],["邪魔","じゃま"],["を"],["する"],["もの"],["だ"],["。"],["あなた"],["は"],["神","かみ"],["の"],["こと"],["を"],["思わないで","おもわないで"],["、"],["人","ひと"],["の"],["こと"],["を"],["思って","おもって"],["いる"],["。"],["」"]]},{"verse":24,"text":"それから、イエスは弟子たちに言われた。「だれでもわたしについて来たいと思うなら、自分を捨て、自分の十字架を負い、そしてわたしについて来なさい。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["だれ"],["で"],["も"],["わたし"],["について"],["来たい","きたい"],["と"],["思うなら","おもうなら"],["、"],["自分","じぶん"],["を"],["捨て","すて"],["、"],["自分","じぶん"],["の"],["十字架","じゅうじか"],["を"],["負い","おい"],["、"],["そして"],["わたし"],["について"],["来","き"],["なさい"],["。"]]},{"verse":25,"text":"いのちを救おうと思う者はそれを失い、わたしのためにいのちを失う者は、それを見いだすのです。","tok":[["いのち"],["を"],["救おう","すくおう"],["と"],["思う","おもう"],["者","もの"],["は"],["それ"],["を"],["失い","うしない"],["、"],["わたし"],["の"],["ため"],["に"],["いのち"],["を"],["失う","うしなう"],["者","もの"],["は"],["、"],["それ"],["を"],["見いだす","みいだす"],["の"],["です"],["。"]]},{"verse":26,"text":"人は、たとい全世界を手に入れても、まことのいのちを損じたら、何の得がありましょう。そのいのちを買い戻すのには、人はいったい何を差し出せばよいでしょう。","tok":[["人","ひと"],["は"],["、"],["たとい"],["全","ぜん"],["世界","せかい"],["を"],["手","て"],["に"],["入れて","いれて"],["も"],["、"],["まこと"],["の"],["いのち"],["を"],["損じたら","そんじたら"],["、"],["何","なん"],["の"],["得","とく"],["が"],["ありましょう"],["。"],["その"],["いのち"],["を"],["買い戻す","かいもどす"],["のに"],["は"],["、"],["人","ひと"],["は"],["いったい"],["何","なん"],["を"],["差し出せば","さしだせば"],["よいでしょう"],["。"]]},{"verse":27,"text":"人の子は父の栄光を帯びて、御使いたちとともに、やがて来ようとしているのです。その時には、おのおのその行いに応じて報いをします。","tok":[["人","ひと"],["の"],["子","こ"],["は"],["父","ちち"],["の"],["栄光","えいこう"],["を"],["帯びて","おびて"],["、"],["御使い","おつかい"],["たち"],["と"],["とも"],["に"],["、"],["やがて"],["来よう","こよう"],["として"],["いる"],["の"],["です"],["。"],["その"],["時","とき"],["に"],["は"],["、"],["おのおの"],["その"],["行い","おこない"],["に"],["応じて","おうじて"],["報い","むくい"],["を"],["します"],["。"]]},{"verse":28,"text":"まことに、あなたがたに告げます。ここに立っている人々の中には、人の子が御国とともに来るのを見るまでは、決して死を味わわない人々がいます。」","tok":[["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["ここ"],["に"],["立って","たって"],["いる"],["人々","ひとびと"],["の"],["中","なか"],["に"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["御国","みくに"],["と"],["とも"],["に"],["来る","くる"],["の"],["を"],["見る","みる"],["まで"],["は"],["、"],["決して","けっして"],["死","し"],["を"],["味わわない","あじわわない"],["人々","ひとびと"],["が"],["います"],["。"],["」"]]}]
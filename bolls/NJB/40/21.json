[{"verse":1,"text":"それから、彼らはエルサレムに近づき、オリーブ山のふもとのベテパゲまで来た。そのとき、イエスは、弟子をふたり使いに出して、","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["は"],["エルサレム"],["に"],["近づき","ちかづき"],["、"],["オリーブ"],["山","さん"],["の"],["ふもと"],["の"],["ベテパゲ"],["まで"],["来た","きた"],["。"],["その"],["とき"],["、"],["イエス"],["は"],["、"],["弟子","でし"],["を"],["ふたり"],["使い","つかい"],["に"],["出して","だして"],["、"]]},{"verse":2,"text":"言われた。「向こうの村へ行きなさい。そうするとすぐに、ろばがつながれていて、いっしょにろばの子がいるのに気がつくでしょう。それをほどいて、わたしのところに連れて来なさい。","tok":[["言われた","いわれた"],["。"],["「"],["向こう","むこう"],["の"],["村","むら"],["へ"],["行き","いき"],["なさい"],["。"],["そう"],["する"],["と"],["すぐ"],["に"],["、"],["ろば"],["が"],["つながれて"],["いて"],["、"],["いっしょ"],["に"],["ろば"],["の"],["子","こ"],["が"],["いる"],["のに"],["気","き"],["が"],["つくでしょう"],["。"],["それ"],["を"],["ほどいて"],["、"],["わたし"],["の"],["ところ"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"]]},{"verse":3,"text":"もしだれかが何か言ったら、『主がお入用なのです』と言いなさい。そうすれば、すぐに渡してくれます。」","tok":[["もし"],["だれ"],["か"],["が"],["何","なん"],["か"],["言ったら","いったら"],["、"],["『"],["主","ぬし"],["が"],["お入用","おにゅうよう"],["な"],["の"],["です"],["』"],["と"],["言い","いい"],["なさい"],["。"],["そう"],["すれば"],["、"],["すぐ"],["に"],["渡して","わたして"],["くれます"],["。"],["」"]]},{"verse":4,"text":"これは、預言者を通して言われた事が成就するために起こったのである。","tok":[["これ"],["は"],["、"],["預言者","よげんしゃ"],["を"],["通して","とおして"],["言われた","いわれた"],["事","こと"],["が"],["成就","じょうじゅ"],["する"],["ため"],["に"],["起こった","おこった"],["ので"],["ある"],["。"]]},{"verse":5,"text":"「シオンの娘に伝えなさい。／『見よ。あなたの王があなたのところに来られる。／柔和で、ろばの背に乗って、それも、荷物を運ぶろばの子に乗って。』」","tok":[["「"],["シオン"],["の"],["娘","むすめ"],["に"],["伝え","つたえ"],["なさい"],["。"],["／"],["『"],["見","み"],["よ"],["。"],["あなた"],["の"],["王","おう"],["が"],["あなた"],["の"],["ところ"],["に"],["来られる","こられる"],["。"],["／"],["柔和","にゅうわ"],["で"],["、"],["ろば"],["の"],["背","せ"],["に"],["乗って","のって"],["、"],["それ"],["も"],["、"],["荷物","にもつ"],["を"],["運ぶ","はこぶ"],["ろば"],["の"],["子","こ"],["に"],["乗って","のって"],["。"],["』"],["」"]]},{"verse":6,"text":"そこで、弟子たちは行って、イエスが命じられたとおりにした。","tok":[["そこ"],["で"],["、"],["弟子","でし"],["たち"],["は"],["行って","いって"],["、"],["イエス"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"]]},{"verse":7,"text":"そして、ろばと、ろばの子とを連れて来て、自分たちの上着をその上に掛けた。イエスはそれに乗られた。","tok":[["そして"],["、"],["ろば"],["と"],["、"],["ろば"],["の"],["子","こ"],["と"],["を"],["連れて","つれて"],["来て","きて"],["、"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["その"],["上","うえ"],["に"],["掛けた","かけた"],["。"],["イエス"],["は"],["それ"],["に"],["乗られた","のられた"],["。"]]},{"verse":8,"text":"すると、群衆のうち大ぜいの者が、自分たちの上着を道に敷き、また、ほかの人々は、木の枝を切って来て、道に敷いた。","tok":[["する"],["と"],["、"],["群衆","ぐんしゅう"],["の"],["うち"],["大ぜい","おおぜい"],["の"],["者","もの"],["が"],["、"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["道","みち"],["に"],["敷き","しき"],["、"],["また"],["、"],["ほか"],["の"],["人々","ひとびと"],["は"],["、"],["木","き"],["の"],["枝","えだ"],["を"],["切って","きって"],["来て","きて"],["、"],["道","みち"],["に"],["敷いた","しいた"],["。"]]},{"verse":9,"text":"そして、群衆は、イエスの前を行く者も、あとに従う者も、こう言って叫んでいた。「ダビデの子にホサナ。祝福あれ。主の御名によって来られる方に。ホサナ。いと高き所に。」","tok":[["そして"],["、"],["群衆","ぐんしゅう"],["は"],["、"],["イエス"],["の"],["前","まえ"],["を"],["行く","いく"],["者","もの"],["も"],["、"],["あと"],["に"],["従う","したがう"],["者","もの"],["も"],["、"],["こう"],["言って","いって"],["叫んで","さけんで"],["いた"],["。"],["「"],["ダビデ"],["の"],["子","こ"],["に"],["ホサナ"],["。"],["祝福","しゅくふく"],["あれ"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["来られる","こられる"],["方","かた"],["に"],["。"],["ホサナ"],["。"],["いと"],["高き","たかき"],["所","ところ"],["に"],["。"],["」"]]},{"verse":10,"text":"こうして、イエスがエルサレムに入られると、都中がこぞって騒ぎ立ち、「この方は、どういう方なのか」と言った。","tok":[["こう"],["して"],["、"],["イエス"],["が"],["エルサレム"],["に"],["入られる","はいられる"],["と"],["、"],["都中","とちゅう"],["が"],["こぞって"],["騒ぎ立ち","さわぎたち"],["、"],["「"],["この"],["方","かた"],["は"],["、"],["どういう"],["方","ほう"],["な"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":11,"text":"群衆は、「この方は、ガリラヤのナザレの、預言者イエスだ」と言った。","tok":[["群衆","ぐんしゅう"],["は"],["、"],["「"],["この"],["方","かた"],["は"],["、"],["ガリラヤ"],["の"],["ナザレ"],["の"],["、"],["預言者","よげんしゃ"],["イエス"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"それから、イエスは宮に入って、宮の中で売り買いする者たちをみな追い出し、両替人の台や、鳩を売る者たちの腰掛けを倒された。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["宮","みや"],["に"],["入って","はいって"],["、"],["宮","みや"],["の"],["中","なか"],["で"],["売り買い","うりかい"],["する"],["者","もの"],["たち"],["を"],["みな"],["追い出し","おいだし"],["、"],["両替人","りょうがえにん"],["の"],["台","だい"],["や"],["、"],["鳩","はと"],["を"],["売る","うる"],["者","もの"],["たち"],["の"],["腰掛け","こしかけ"],["を"],["倒された","たおされた"],["。"]]},{"verse":13,"text":"そして彼らに言われた。「『わたしの家は祈りの家と呼ばれる』と書いてある。それなのに、あなたがたはそれを強盗の巣にしている。」","tok":[["そして"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["『"],["わたし"],["の"],["家","いえ"],["は"],["祈り","いのり"],["の"],["家","いえ"],["と"],["呼ばれる","よばれる"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["強盗","ごうとう"],["の"],["巣","す"],["に"],["して"],["いる"],["。"],["」"]]},{"verse":14,"text":"また、宮の中で、盲人や足のなえた人たちがみもとに来たので、イエスは彼らをいやされた。","tok":[["また"],["、"],["宮","みや"],["の"],["中","なか"],["で"],["、"],["盲人","もうじん"],["や"],["足","あし"],["の"],["なえた"],["人","ひと"],["たち"],["が"],["みもと"],["に"],["来た","きた"],["ので"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["いやされた"],["。"]]},{"verse":15,"text":"ところが、祭司長、律法学者たちは、イエスのなさった驚くべきいろいろのことを見、また宮の中で子どもたちが「ダビデの子にホサナ」と言って叫んでいるのを見て腹を立てた。","tok":[["ところ"],["が"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["イエス"],["の"],["なさった"],["驚くべき","おどろくべき"],["いろいろ"],["の"],["こと"],["を"],["見","み"],["、"],["また"],["宮","みや"],["の"],["中","なか"],["で"],["子ども","こども"],["たち"],["が"],["「"],["ダビデ"],["の"],["子","こ"],["に"],["ホサナ"],["」"],["と"],["言って","いって"],["叫んで","さけんで"],["いる"],["の"],["を"],["見て","みて"],["腹","はら"],["を"],["立てた","たてた"],["。"]]},{"verse":16,"text":"そしてイエスに言った。「あなたは、子どもたちが何と言っているか、お聞きですか。」イエスは言われた。「聞いています。『あなたは幼子と乳飲み子たちの口に賛美を用意された』とあるのを、あなたがたは読まなかったのですか。」","tok":[["そして"],["イエス"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["子ども","こども"],["たち"],["が"],["何","なん"],["と"],["言って","いって"],["いる"],["か"],["、"],["お聞きです","おききです"],["か"],["。"],["」"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["聞いて","きいて"],["います"],["。"],["『"],["あなた"],["は"],["幼子","おさなご"],["と"],["乳飲み子","ちのみご"],["たち"],["の"],["口","くち"],["に"],["賛美","さんび"],["を"],["用意","ようい"],["された"],["』"],["と"],["ある"],["の"],["を"],["、"],["あなた"],["がた"],["は"],["読まなかった","よまなかった"],["の"],["です"],["か"],["。"],["」"]]},{"verse":17,"text":"イエスは彼らをあとに残し、都を出てベタニヤに行き、そこに泊まられた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["を"],["あと"],["に"],["残し","のこし"],["、"],["都","と"],["を"],["出て","でて"],["ベタニヤ"],["に"],["行き","いき"],["、"],["そこ"],["に"],["泊まられた","とまられた"],["。"]]},{"verse":18,"text":"翌朝、イエスは都に帰る途中、空腹を覚えられた。","tok":[["翌朝","よくあさ"],["、"],["イエス"],["は"],["都","と"],["に"],["帰る","かえる"],["途中","とちゅう"],["、"],["空腹","くうふく"],["を"],["覚えられた","おぼえられた"],["。"]]},{"verse":19,"text":"道ばたにいちじくの木が見えたので、近づいて行かれたが、葉のほかは何もないのに気づかれた。それで、イエスはその木に「おまえの実は、もういつまでも、ならないように」と言われた。すると、たちまちいちじくの木は枯れた。","tok":[["道ばた","みちばた"],["に"],["いちじく"],["の"],["木","き"],["が"],["見えた","みえた"],["ので"],["、"],["近づいて","ちかづいて"],["行かれた","いかれた"],["が"],["、"],["葉","は"],["の"],["ほか"],["は"],["何","なん"],["も"],["ない"],["のに"],["気づかれた","きづかれた"],["。"],["それ"],["で"],["、"],["イエス"],["は"],["その"],["木","き"],["に"],["「"],["おまえ"],["の"],["実","じつ"],["は"],["、"],["もう"],["いつ"],["まで"],["も"],["、"],["ならない"],["よう"],["に"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["、"],["たちまち"],["いちじく"],["の"],["木","き"],["は"],["枯れた","かれた"],["。"]]},{"verse":20,"text":"弟子たちは、これを見て、驚いて言った。「どうして、こうすぐにいちじくの木が枯れたのでしょうか。」","tok":[["弟子","でし"],["たち"],["は"],["、"],["これ"],["を"],["見て","みて"],["、"],["驚いて","おどろいて"],["言った","いった"],["。"],["「"],["どう"],["して"],["、"],["こう"],["すぐ"],["に"],["いちじく"],["の"],["木","き"],["が"],["枯れた","かれた"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":21,"text":"イエスは答えて言われた。「まことに、あなたがたに告げます。もし、あなたがたが、信仰を持ち、疑うことがなければ、いちじくの木になされたようなことができるだけでなく、たとい、この山に向かって、『動いて、海に入れ』と言っても、そのとおりになります。","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["もし"],["、"],["あなた"],["が"],["た"],["が"],["、"],["信仰","しんこう"],["を"],["持ち","もち"],["、"],["疑う","うたがう"],["こと"],["が"],["なければ"],["、"],["いちじく"],["の"],["木","き"],["に"],["なされた"],["よう"],["な"],["こと"],["が"],["できる"],["だけ"],["で"],["なく"],["、"],["たとい"],["、"],["この"],["山","やま"],["に"],["向かって","むかって"],["、"],["『"],["動いて","うごいて"],["、"],["海","うみ"],["に"],["入れ","いれ"],["』"],["と"],["言って","いって"],["も"],["、"],["その"],["とおり"],["に"],["なります"],["。"]]},{"verse":22,"text":"あなたがたが信じて祈り求めるものなら、何でも与えられます。」","tok":[["あなた"],["がた"],["が"],["信じて","しんじて"],["祈り求める","いのりもとめる"],["もの"],["なら"],["、"],["何","なん"],["で"],["も"],["与えられます","あたえられます"],["。"],["」"]]},{"verse":23,"text":"それから、イエスが宮に入って、教えておられると、祭司長、民の長老たちが、みもとに来て言った。「何の権威によって、これらのことをしておられるのですか。だれが、あなたにその権威を授けたのですか。」","tok":[["それ"],["から"],["、"],["イエス"],["が"],["宮","みや"],["に"],["入って","はいって"],["、"],["教えて","おしえて"],["おられる"],["と"],["、"],["祭司長","さいしちょう"],["、"],["民","みん"],["の"],["長老","ちょうろう"],["たち"],["が"],["、"],["みもと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["何","なん"],["の"],["権威","けんい"],["によって"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["して"],["おられる"],["の"],["です"],["か"],["。"],["だれ"],["が"],["、"],["あなた"],["に"],["その"],["権威","けんい"],["を"],["授けた","さずけた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":24,"text":"イエスは答えて、こう言われた。「わたしも一言あなたがたに尋ねましょう。もし、あなたがたが答えるなら、わたしも何の権威によって、これらのことをしているかを話しましょう。","tok":[["イエス"],["は"],["答えて","こたえて"],["、"],["こう"],["言われた","いわれた"],["。"],["「"],["わたし"],["も"],["一言","ひとこと"],["あなた"],["がた"],["に"],["尋ねましょう","たずねましょう"],["。"],["もし"],["、"],["あなた"],["がた"],["が"],["答えるなら","こたえるなら"],["、"],["わたし"],["も"],["何","なん"],["の"],["権威","けんい"],["によって"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["して"],["いる"],["か"],["を"],["話しましょう","はなしましょう"],["。"]]},{"verse":25,"text":"ヨハネのバプテスマは、どこから来たものですか。天からですか。それとも人からですか。」すると、彼らはこう言いながら、互いに論じ合った。「もし、天から、と言えば、それならなぜ、彼を信じなかったか、と言うだろう。","tok":[["ヨハネ"],["の"],["バプテスマ"],["は"],["、"],["どこ"],["から"],["来た","きた"],["もの"],["です"],["か"],["。"],["天","てん"],["から"],["です"],["か"],["。"],["それ"],["と"],["も"],["人","ひと"],["から"],["です"],["か"],["。"],["」"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["こう"],["言い","いい"],["ながら"],["、"],["互い","たがい"],["に"],["論じ合った","ろんじあった"],["。"],["「"],["もし"],["、"],["天","てん"],["から"],["、"],["と"],["言えば","いえば"],["、"],["それ"],["なら"],["なぜ"],["、"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["か"],["、"],["と"],["言うだろう","ゆうだろう"],["。"]]},{"verse":26,"text":"しかし、もし、人から、と言えば、群衆がこわい。彼らはみな、ヨハネを預言者と認めているのだから。」","tok":[["しかし"],["、"],["もし"],["、"],["人","ひと"],["から"],["、"],["と"],["言えば","いえば"],["、"],["群衆","ぐんしゅう"],["が"],["こわい"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["ヨハネ"],["を"],["預言者","よげんしゃ"],["と"],["認めて","みとめて"],["いる"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":27,"text":"そこで、彼らはイエスに答えて、「わかりません」と言った。イエスもまた彼らにこう言われた。「わたしも、何の権威によってこれらのことをするのか、あなたがたに話すまい。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["答えて","こたえて"],["、"],["「"],["わかりません"],["」"],["と"],["言った","いった"],["。"],["イエス"],["も"],["また"],["彼","かれ"],["ら"],["に"],["こう"],["言われた","いわれた"],["。"],["「"],["わたし"],["も"],["、"],["何","なん"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["話すまい","はなすまい"],["。"]]},{"verse":28,"text":"ところで、あなたがたは、どう思いますか。／ある人にふたりの息子がいた。その人は兄のところに来て、『きょう、ぶどう園に行って働いてくれ』と言った。","tok":[["ところ"],["で"],["、"],["あなた"],["がた"],["は"],["、"],["どう"],["思います","おもいます"],["か"],["。"],["／"],["ある"],["人","ひと"],["に"],["ふたり"],["の"],["息子","むすこ"],["が"],["いた"],["。"],["その"],["人","ひと"],["は"],["兄","あに"],["の"],["ところ"],["に"],["来て","きて"],["、"],["『"],["きょう"],["、"],["ぶどう園","ぶどうえん"],["に"],["行って","いって"],["働いて","はたらいて"],["くれ"],["』"],["と"],["言った","いった"],["。"]]},{"verse":29,"text":"兄は答えて『行きます。お父さん』と言ったが、行かなかった。","tok":[["兄","あに"],["は"],["答えて","こたえて"],["『"],["行きます","いきます"],["。"],["お父さん","おとうさん"],["』"],["と"],["言った","いった"],["が"],["、"],["行かなかった","いかなかった"],["。"]]},{"verse":30,"text":"それから、弟のところに来て、同じように言った。ところが、弟は答えて『行きたくありません』と言ったが、あとから悪かったと思って出かけて行った。","tok":[["それ"],["から"],["、"],["弟","おとうと"],["の"],["ところ"],["に"],["来て","きて"],["、"],["同じ","おなじ"],["よう"],["に"],["言った","いった"],["。"],["ところ"],["が"],["、"],["弟","おとうと"],["は"],["答えて","こたえて"],["『"],["行きたく","いきたく"],["ありません"],["』"],["と"],["言った","いった"],["が"],["、"],["あと"],["から"],["悪かった","わるかった"],["と"],["思って","おもって"],["出かけて","でかけて"],["行った","いった"],["。"]]},{"verse":31,"text":"ふたりのうちどちらが、父の願ったとおりにしたのでしょう。」彼らは言った。「あとの者です。」イエスは彼らに言われた。「まことに、あなたがたに告げます。取税人や遊女たちのほうが、あなたがたより先に神の国に入っているのです。","tok":[["ふたり"],["の"],["うち"],["どちら"],["が"],["、"],["父","ちち"],["の"],["願った","ねがった"],["とおり"],["に"],["した"],["の"],["でしょう"],["。"],["」"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["あと"],["の"],["者","もの"],["です"],["。"],["」"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["取","とり"],["税人","ぜいにん"],["や"],["遊女","ゆうじょ"],["たち"],["の"],["ほう"],["が"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["神","かみ"],["の"],["国","くに"],["に"],["入って","はいって"],["いる"],["の"],["です"],["。"]]},{"verse":32,"text":"というのは、あなたがたは、ヨハネが義の道を持って来たのに、彼を信じなかった。しかし、取税人や遊女たちは彼を信じたからです。しかもあなたがたは、それを見ながら、あとになって悔いることもせず、彼を信じなかったのです。","tok":[["と"],["いう"],["の"],["は"],["、"],["あなた"],["がた"],["は"],["、"],["ヨハネ"],["が"],["義","ぎ"],["の"],["道","みち"],["を"],["持って","もって"],["来た","きた"],["のに"],["、"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["。"],["しかし"],["、"],["取","とり"],["税人","ぜいにん"],["や"],["遊女","ゆうじょ"],["たち"],["は"],["彼","かれ"],["を"],["信じた","しんじた"],["から"],["です"],["。"],["しかも"],["あなた"],["がた"],["は"],["、"],["それ"],["を"],["見","み"],["ながら"],["、"],["あと"],["に"],["なって"],["悔いる","くいる"],["こと"],["も"],["せず"],["、"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["の"],["です"],["。"]]},{"verse":33,"text":"もう一つのたとえを聞きなさい。／ひとりの、家の主人がいた。彼はぶどう園を造って、垣を巡らし、その中に酒ぶねを掘り、やぐらを建て、それを農夫たちに貸して、旅に出かけた。","tok":[["もう"],["一","ひと"],["つ"],["の"],["たとえ"],["を"],["聞き","きき"],["なさい"],["。"],["／"],["ひとり"],["の"],["、"],["家","いえ"],["の"],["主人","しゅじん"],["が"],["いた"],["。"],["彼","かれ"],["は"],["ぶどう園","ぶどうえん"],["を"],["造って","つくって"],["、"],["垣","かき"],["を"],["巡らし","めぐらし"],["、"],["その"],["中","なか"],["に"],["酒","さけ"],["ぶね"],["を"],["掘り","ほり"],["、"],["やぐら"],["を"],["建て","たて"],["、"],["それ"],["を"],["農夫","のうふ"],["たち"],["に"],["貸して","かして"],["、"],["旅","たび"],["に"],["出かけた","でかけた"],["。"]]},{"verse":34,"text":"さて、収穫の時が近づいたので、主人は自分の分を受け取ろうとして、農夫たちのところへしもべたちを遣わした。","tok":[["さて"],["、"],["収穫","しゅうかく"],["の"],["時","とき"],["が"],["近づいた","ちかづいた"],["ので"],["、"],["主人","しゅじん"],["は"],["自分","じぶん"],["の"],["分","ぶん"],["を"],["受け取ろう","うけとろう"],["として"],["、"],["農夫","のうふ"],["たち"],["の"],["ところ"],["へ"],["しもべ"],["たち"],["を"],["遣わした","つかわした"],["。"]]},{"verse":35,"text":"すると、農夫たちは、そのしもべたちをつかまえて、ひとりは袋だたきにし、もうひとりは殺し、もうひとりは石で打った。","tok":[["する"],["と"],["、"],["農夫","のうふ"],["たち"],["は"],["、"],["その"],["しもべ"],["たち"],["を"],["つかまえて"],["、"],["ひとり"],["は"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["もう"],["ひとり"],["は"],["殺し","ころし"],["、"],["もう"],["ひとり"],["は"],["石","いし"],["で"],["打った","うった"],["。"]]},{"verse":36,"text":"そこでもう一度、前よりももっと多くの別のしもべたちを遣わしたが、やはり同じような扱いをした。","tok":[["そこ"],["で"],["もう"],["一度","いちど"],["、"],["前","まえ"],["より"],["も"],["もっと"],["多く","おおく"],["の"],["別","べつ"],["の"],["しもべ"],["たち"],["を"],["遣わした","つかわした"],["が"],["、"],["やはり"],["同じ","おなじ"],["よう"],["な"],["扱い","あつかい"],["を"],["した"],["。"]]},{"verse":37,"text":"しかし、そのあと、その主人は、『私の息子なら、敬ってくれるだろう』と言って、息子を遣わした。","tok":[["しかし"],["、"],["その"],["あと"],["、"],["その"],["主人","しゅじん"],["は"],["、"],["『"],["私","わたくし"],["の"],["息子","むすこ"],["なら"],["、"],["敬って","うやまって"],["くれるだろう"],["』"],["と"],["言って","いって"],["、"],["息子","むすこ"],["を"],["遣わした","つかわした"],["。"]]},{"verse":38,"text":"すると、農夫たちは、その子を見て、こう話し合った。『あれはあと取りだ。さあ、あれを殺して、あれのものになるはずの財産を手に入れようではないか。』","tok":[["する"],["と"],["、"],["農夫","のうふ"],["たち"],["は"],["、"],["その"],["子","こ"],["を"],["見て","みて"],["、"],["こう"],["話し合った","はなしあった"],["。"],["『"],["あれ"],["は"],["あと"],["取り","とり"],["だ"],["。"],["さあ"],["、"],["あれ"],["を"],["殺して","ころして"],["、"],["あれ"],["の"],["もの"],["に"],["なる"],["はず"],["の"],["財産","ざいさん"],["を"],["手","て"],["に"],["入れ","いれ"],["よう"],["で"],["は"],["ない"],["か"],["。"],["』"]]},{"verse":39,"text":"そして、彼をつかまえて、ぶどう園の外に追い出して殺してしまった。","tok":[["そして"],["、"],["彼","かれ"],["を"],["つかまえて"],["、"],["ぶどう園","ぶどうえん"],["の"],["外","そと"],["に"],["追い出して","おいだして"],["殺して","ころして"],["しまった"],["。"]]},{"verse":40,"text":"この場合、ぶどう園の主人が帰って来たら、その農夫たちをどうするでしょう。」","tok":[["この"],["場合","ばあい"],["、"],["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["が"],["帰って","かえって"],["来たら","きたら"],["、"],["その"],["農夫","のうふ"],["たち"],["を"],["どう"],["するでしょう"],["。"],["」"]]},{"verse":41,"text":"彼らはイエスに言った。「その悪党どもを情け容赦なく殺して、そのぶどう園を、季節にはきちんと収穫を納める別の農夫たちに貸すに違いありません。」","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["その"],["悪党","あくとう"],["ども"],["を"],["情け","なさけ"],["容赦","ようしゃ"],["なく"],["殺して","ころして"],["、"],["その"],["ぶどう園","ぶどうえん"],["を"],["、"],["季節","きせつ"],["に"],["は"],["きちんと"],["収穫","しゅうかく"],["を"],["納める","おさめる"],["別","べつ"],["の"],["農夫","のうふ"],["たち"],["に"],["貸す","かす"],["に"],["違い","ちがい"],["ありません"],["。"],["」"]]},{"verse":42,"text":"イエスは彼らに言われた。「あなたがたは、次の聖書のことばを読んだことがないのですか。／『家を建てる者たちの見捨てた石。／それが礎の石になった。／これは主のなさったことだ。／私たちの目には、不思議なことである。』","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["次","つぎ"],["の"],["聖書","せいしょ"],["の"],["ことば"],["を"],["読んだ","よんだ"],["こと"],["が"],["ない"],["の"],["です"],["か"],["。"],["／"],["『"],["家","いえ"],["を"],["建てる","たてる"],["者","もの"],["たち"],["の"],["見捨てた","みすてた"],["石","いし"],["。"],["／"],["それ"],["が"],["礎","いしずえ"],["の"],["石","いし"],["に"],["なった"],["。"],["／"],["これ"],["は"],["主","ぬし"],["の"],["なさった"],["こと"],["だ"],["。"],["／"],["私たち","わたしたち"],["の"],["目","め"],["に"],["は"],["、"],["不思議","ふしぎ"],["な"],["こと"],["で"],["ある"],["。"],["』"]]},{"verse":43,"text":"だから、わたしはあなたがたに言います。神の国はあなたがたから取り去られ、神の国の実を結ぶ国民に与えられます。","tok":[["だ"],["から"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言います","いいます"],["。"],["神","かみ"],["の"],["国","くに"],["は"],["あなた"],["が"],["た"],["から"],["取り去られ","とりさられ"],["、"],["神","かみ"],["の"],["国","くに"],["の"],["実","じつ"],["を"],["結ぶ","むすぶ"],["国民","こくみん"],["に"],["与えられます","あたえられます"],["。"]]},{"verse":44,"text":"また、この石の上に落ちる者は、粉々に砕かれ、この石が人の上に落ちれば、その人を粉みじんに飛ばしてしまいます。」","tok":[["また"],["、"],["この"],["石","いし"],["の"],["上","うえ"],["に"],["落ちる","おちる"],["者","もの"],["は"],["、"],["粉々","こなごな"],["に"],["砕かれ","くだかれ"],["、"],["この"],["石","いし"],["が"],["人","ひと"],["の"],["上","うえ"],["に"],["落ちれば","おちれば"],["、"],["その"],["人","ひと"],["を"],["粉","こな"],["みじん"],["に"],["飛ばして","とばして"],["しまいます"],["。"],["」"]]},{"verse":45,"text":"祭司長たちとパリサイ人たちは、イエスのこれらのたとえを聞いたとき、自分たちをさして話しておられることに気づいた。","tok":[["祭司長","さいしちょう"],["たち"],["と"],["パリサイ"],["人","にん"],["たち"],["は"],["、"],["イエス"],["の"],["これ"],["ら"],["の"],["たとえ"],["を"],["聞いた","きいた"],["とき"],["、"],["自分","じぶん"],["たち"],["を"],["さして"],["話して","はなして"],["おられる"],["こと"],["に"],["気づいた","きづいた"],["。"]]},{"verse":46,"text":"それでイエスを捕らえようとしたが、群衆を恐れた。群衆はイエスを預言者と認めていたからである。","tok":[["それ"],["で"],["イエス"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["が"],["、"],["群衆","ぐんしゅう"],["を"],["恐れた","おそれた"],["。"],["群衆","ぐんしゅう"],["は"],["イエス"],["を"],["預言者","よげんしゃ"],["と"],["認めて","みとめて"],["いた"],["から"],["で"],["ある"],["。"]]}]
。","tok":[["まこと"],["に"],["、"],["おまえ"],["たち"],["に"],["告げます","つげます"],["。"],["これ"],["ら"],["の"],["報い","むくい"],["は"],["みな"],["、"],["この"],["時代","じだい"],["の"],["上","うえ"],["に"],["来ます","きます"],["。"]]},{"verse":37,"text":"ああ、エルサレム、エルサレム。預言者たちを殺し、自分に遣わされた人たちを石で打つ者。わたしは、めんどりがひなを翼の下に集めるように、あなたの子らを幾たび集めようとしたことか。それなのに、あなたがたはそれを好まなかった。","tok":[["ああ"],["、"],["エルサレム"],["、"],["エルサレム"],["。"],["預言者","よげんしゃ"],["たち"],["を"],["殺し","ころし"],["、"],["自分","じぶん"],["に"],["遣わされた","つかわされた"],["人","ひと"],["たち"],["を"],["石","いし"],["で"],["打つ","うつ"],["者","もの"],["。"],["わたし"],["は"],["、"],["めんどり"],["が"],["ひな"],["を"],["翼","つばさ"],["の"],["下","した"],["に"],["集める","あつめる"],["よう"],["に"],["、"],["あなた"],["の"],["子","こ"],["ら"],["を"],["幾","いく"],["たび"],["集めよう","あつめよう"],["と"],["した"],["こと"],["か"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["好まなかった","このまなかった"],["。"]]},{"verse":38,"text":"見なさい。あなたがたの家は荒れ果てたままに残される。","tok":[["見","み"],["なさい"],["。"],["あなた"],["がた"],["の"],["家","いえ"],["は"],["荒れ果てた","あれはてた"],["まま"],["に"],["残される","のこされる"],["。"]]},{"verse":39,"text":"あなたがたに告げます。『祝福あれ。主の御名によって来られる方に』とあなたがたが言うときまで、あなたがたは今後決してわたしを見ることはありません。」","tok":[["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["『"],["祝福","しゅくふく"],["あれ"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["来られる","こられる"],["方","かた"],["に"],["』"],["と"],["あなた"],["がた"],["が"],["言う","いう"],["とき"],["まで"],["、"],["あなた"],["がた"],["は"],["今後","こんご"],["決して","けっして"],["わたし"],["を"],["見る","みる"],["こと"],["は"],["ありません"],["。"],["」"]]}]
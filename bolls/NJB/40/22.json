[{"verse":1,"text":"イエスはもう一度たとえをもって彼らに話された。","tok":[["イエス"],["は"],["もう"],["一度","いちど"],["たとえ"],["を"],["もって"],["彼","かれ"],["ら"],["に"],["話された","はなされた"],["。"]]},{"verse":2,"text":"「天の御国は、王子のために結婚の披露宴を設けた王にたとえることができます。","tok":[["「"],["天","てん"],["の"],["御国","みくに"],["は"],["、"],["王子","おうじ"],["の"],["ため"],["に"],["結婚","けっこん"],["の"],["披露宴","ひろうえん"],["を"],["設けた","もうけた"],["王","おう"],["に"],["たとえる"],["こと"],["が"],["できます"],["。"]]},{"verse":3,"text":"王は、招待しておいたお客を呼びに、しもべたちを遣わしたが、彼らは来たがらなかった。","tok":[["王","おう"],["は"],["、"],["招待","しょうたい"],["して"],["おいた"],["お客","おきゃく"],["を"],["呼び","よび"],["に"],["、"],["しもべ"],["たち"],["を"],["遣わした","つかわした"],["が"],["、"],["彼","かれ"],["ら"],["は"],["来たがらなかった","きたがらなかった"],["。"]]},{"verse":4,"text":"それで、もう一度、次のように言いつけて、別のしもべたちを遣わした。『お客に招いておいた人たちにこう言いなさい。「さあ、食事の用意ができました。雄牛も太った家畜もほふって、何もかも整いました。どうぞ宴会にお出かけください。」』","tok":[["それ"],["で"],["、"],["もう"],["一度","いちど"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言いつけて","いいつけて"],["、"],["別","べつ"],["の"],["しもべ"],["たち"],["を"],["遣わした","つかわした"],["。"],["『"],["お客","おきゃく"],["に"],["招いて","まねいて"],["おいた"],["人","ひと"],["たち"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["「"],["さあ"],["、"],["食事","しょくじ"],["の"],["用意","ようい"],["が"],["できました"],["。"],["雄牛","おうし"],["も"],["太った","ふとった"],["家畜","かちく"],["も"],["ほふって"],["、"],["何","なん"],["も"],["か"],["も"],["整いました","ととのいました"],["。"],["どうぞ"],["宴会","えんかい"],["に"],["お出かけ","おでかけ"],["ください"],["。"],["」"],["』"]]},{"verse":5,"text":"ところが、彼らは気にもかけず、ある者は畑に、別の者は商売に出て行き、","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["気","き"],["に"],["も"],["かけず"],["、"],["ある"],["者","もの"],["は"],["畑","はたけ"],["に"],["、"],["別","べつ"],["の"],["者","もの"],["は"],["商売","しょうばい"],["に"],["出て","でて"],["行き","いき"],["、"]]},{"verse":6,"text":"そのほかの者たちは、王のしもべたちをつかまえて恥をかかせ、そして殺してしまった。","tok":[["その"],["ほか"],["の"],["者","もの"],["たち"],["は"],["、"],["王","おう"],["の"],["しもべ"],["たち"],["を"],["つかまえて"],["恥","はじ"],["を"],["かかせ"],["、"],["そして"],["殺して","ころして"],["しまった"],["。"]]},{"verse":7,"text":"王は怒って、兵隊を出して、その人殺しどもを滅ぼし、彼らの町を焼き払った。","tok":[["王","おう"],["は"],["怒って","おこって"],["、"],["兵隊","へいたい"],["を"],["出し
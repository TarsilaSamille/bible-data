[{"verse":1,"text":"イエスは、これらの話をすべて終えると、弟子たちに言われた。","tok":[["イエス"],["は"],["、"],["これ"],["ら"],["の"],["話","はなし"],["を"],["すべて"],["終える","おえる"],["と"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"]]},{"verse":2,"text":"「あなたがたの知っているとおり、二日たつと過越の祭りになります。人の子は十字架につけられるために引き渡されます。」","tok":[["「"],["あなた"],["がた"],["の"],["知って","しって"],["いる"],["とおり"],["、"],["二日","ふたか"],["たつ"],["と"],["過越","すぎこし"],["の"],["祭り","まつり"],["に"],["なります"],["。"],["人","ひと"],["の"],["子","こ"],["は"],["十字架","じゅうじか"],["に"],["つけられる"],["ため"],["に"],["引き渡されます","ひきわたされます"],["。"],["」"]]},{"verse":3,"text":"そのころ、祭司長、民の長老たちは、カヤパという大祭司の家の庭に集まり、","tok":[["その"],["ころ"],["、"],["祭司長","さいしちょう"],["、"],["民","みん"],["の"],["長老","ちょうろう"],["たち"],["は"],["、"],["カヤパ"],["と"],["いう"],["大","だい"],["祭司","さいし"],["の"],["家","いえ"],["の"],["庭","にわ"],["に"],["集まり","あつまり"],["、"]]},{"verse":4,"text":"イエスをだまして捕らえ、殺そうと相談した。","tok":[["イエス"],["を"],["だまして"],["捕らえ","とらえ"],["、"],["殺そう","ころそう"],["と"],["相談","そうだん"],["した"],["。"]]},{"verse":5,"text":"しかし、彼らは、「祭りの間はいけない。民衆の騒ぎが起こるといけないから」と話していた。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["祭り","まつり"],["の"],["間","あいだ"],["は"],["いけない"],["。"],["民衆","みんしゅう"],["の"],["騒ぎ","さわぎ"],["が"],["起こる","おこる"],["と"],["いけない"],["から"],["」"],["と"],["話して","はなして"],["いた"],["。"]]},{"verse":6,"text":"さて、イエスがベタニヤで、ツァラアトに冒された人シモンの家におられると、","tok":[["さて"],["、"],["イエス"],["が"],["ベタニヤ"],["で"],["、"],["ツァラアト"],["に"],["冒された","おかされた"],["人","ひと"],["シモン"],["の"],["家","いえ"],["に"],["おられる"],["と"],["、"]]},{"verse":7,"text":"ひとりの女がたいへん高価な香油の入った石膏のつぼを持ってみもとに来て、食卓に着いておられたイエスの頭に香油を注いだ。","tok":[["ひとり"],["の"],["女","おんな"],["が"],["たいへん"],["高価","こうか"],["な"],["香油","こうゆ"],["の"],["入った","はいった"],["石膏","せっこう"],["の"],["つぼ"],["を"],["持って","もって"],["み"],["もと"],["に"],["来て","きて"],["、"],["食卓","しょくたく"],["に"],["着いて","ついて"],["おられた"],["イエス"],["の"],["頭","あたま"],["に"],["香油","こうゆ"],["を"],["注いだ","そそいだ"],["。"]]},{"verse":8,"text":"弟子たちはこれを見て、憤慨して言った。「何のために、こんなむだなことをするのか。","tok":[["弟子","でし"],["たち"],["は"],["これ"],["を"],["見て","みて"],["、"],["憤慨","ふんがい"],["して"],["言った","いった"],["。"],["「"],
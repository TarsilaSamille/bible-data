[{"verse":1,"text":"イエスが山から降りて来られると、多くの群衆がイエスに従った。","tok":[["イエス"],["が"],["山","やま"],["から"],["降りて","おりて"],["来られる","こられる"],["と"],["、"],["多く","おおく"],["の"],["群衆","ぐんしゅう"],["が"],["イエス"],["に"],["従った","したがった"],["。"]]},{"verse":2,"text":"すると、ツァラアトに冒された人がみもとに来て、ひれ伏して言った。「主よ。お心一つで、私をきよくしていただけます。」","tok":[["する"],["と"],["、"],["ツァラアト"],["に"],["冒された","おかされた"],["人","ひと"],["が"],["みもと"],["に"],["来て","きて"],["、"],["ひれ伏して","ひれふして"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["お心","おこころ"],["一","ひと"],["つ"],["で"],["、"],["私","わたくし"],["を"],["きよく"],["して"],["いただけます"],["。"],["」"]]},{"verse":3,"text":"イエスは手を伸ばして、彼にさわり、「わたしの心だ。きよくなれ」と言われた。すると、すぐに彼のツァラアトはきよめられた。","tok":[["イエス"],["は"],["手","て"],["を"],["伸ばして","のばして"],["、"],["彼","かれ"],["に"],["さわり"],["、"],["「"],["わたし"],["の"],["心","こころ"],["だ"],["。"],["きよく"],["なれ"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["、"],["すぐ"],["に"],["彼","かれ"],["の"],["ツァラアト"],["は"],["きよめられた"],["。"]]},{"verse":4,"text":"イエスは彼に言われた。「気をつけて、だれにも話さないようにしなさい。ただ、人々へのあかしのために、行って、自分を祭司に見せなさい。そして、モーセの命じた供え物をささげなさい。」","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["気","き"],["を"],["つけて"],["、"],["だれ"],["に"],["も"],["話さない","はなさない"],["よう"],["に"],["し"],["なさい"],["。"],["ただ"],["、"],["人々","ひとびと"],["へ"],["の"],["あかし"],["の"],["ため"],["に"],["、"],["行って","いって"],["、"],["自分","じぶん"],["を"],["祭司","さいし"],["に"],["見せ","みせ"],["なさい"],["。"],["そして"],["、"],["モーセ"],["の"],["命じた","めいじた"],["供え物","そなえもの"],["を"],["ささげ"],["なさい"],["。"],["」"]]},{"verse":5,"text":"イエスがカペナウムに入られると、ひとりの百人隊長がみもとに来て、懇願して、","tok":[["イエス"],["が"],["カペナウム"],["に"],["入られる","はいられる"],["と"],["、"],["ひとり"],["の"],["百人","ひゃくにん"],["隊長","たいちょう"],["が"],["みもと"],["に"],["来て","きて"],["、"],["懇願","こんがん"],["して"],["、"]]},{"verse":6,"text":"言った。「主よ。私のしもべが中風で、家に寝ていて、ひどく苦しんでいます。」","tok":[["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["しもべ"],["が"],["中風","ちゅうぶ"],["で"],["、"],["家","いえ"],["に"],["寝て","ねて"],["いて"],["、"],["ひどく"],["苦しんで","くるしんで"],["います"],["。"],["」"]]},{"verse":7,"text":"イエスは彼に言われた。「行って、直してあげよう。」","tok":[["イエス"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["行って","いって"],["、"],["直して","なおして"],["あげよう"],["。"],["」"]]},{"verse":8,"text":"しかし、百人隊長は答えて言った。「主よ。あなたを私の屋根の下にお入れする資格は、私にはありません。ただ、おことばを下さい。そうすれば、私のしもべは直ります。","tok":[["しかし"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["あなた"],["を"],["私","わたくし"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["お入れ","おいれ"],["する"],["資格","しかく"],["は"],["、"],["私","わたくし"],["に"],["は"],["ありません"],["。"],["ただ"],["、"],["おことば"],["を"],["下さい","ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["の"],["しもべ"],["は"],["直ります","なおります"],["。"]]},{"verse":9,"text":"と申しますのは、私も権威の下にある者ですが、私自身の下にも兵士たちがいまして、そのひとりに『行け』と言えば行きますし、別の者に『来い』と言えば来ます。また、しもべに『これをせよ』と言えば、そのとおりにいたします。」","tok":[["と"],["申します","もうします"],["の"],["は"],["、"],["私","わたくし"],["も"],["権威","けんい"],["の"],["下","した"],["に"],["ある"],["者","もの"],["です"],["が"],["、"],["私自身","わたしじしん"],["の"],["下","した"],["に"],["も"],["兵士","へいし"],["たち"],["が"],["いまして"],["、"],["その"],["ひとり"],["に"],["『"],["行け","いけ"],["』"],["と"],["言えば","いえば"],["行きます","いきます"],["し"],["、"],["別","べつ"],["の"],["者","もの"],["に"],["『"],["来い","こい"],["』"],["と"],["言えば","いえば"],["来ます","きます"],["。"],["また"],["、"],["しもべ"],["に"],["『"],["これ"],["を"],["せよ"],["』"],["と"],["言えば","いえば"],["、"],["その"],["とおり"],["に"],["いたします"],["。"],["」"]]},{"verse":10,"text":"イエスは、これを聞いて驚かれ、ついて来た人たちにこう言われた。「まことに、あなたがたに告げます。わたしはイスラエルのうちのだれにも、このような信仰を見たことがありません。","tok":[["イエス"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["驚かれ","おどろかれ"],["、"],["ついて"],["来た","きた"],["人","ひと"],["たち"],["に"],["こう"],["言われた","いわれた"],["。"],["「"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["わたし"],["は"],["イスラエル"],["の"],["うち"],["の"],["だれ"],["に"],["も"],["、"],["この"],["よう"],["な"],["信仰","しんこう"],["を"],["見た","みた"],["こと"],["が"],["ありません"],["。"]]},{"verse":11,"text":"あなたがたに言いますが、たくさんの人が東からも西からも来て、天の御国で、アブラハム、イサク、ヤコブといっしょに食卓に着きます。","tok":[["あなた"],["がた"],["に"],["言います","いいます"],["が"],["、"],["たくさん"],["の"],["人","ひと"],["が"],["東","ひがし"],["から"],["も"],["西","にし"],["から"],["も"],["来て","きて"],["、"],["天","てん"],["の"],["御国","おくに"],["で"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["と"],["いっしょ"],["に"],["食卓","しょくたく"],["に"],["着きます","つきます"],["。"]]},{"verse":12,"text":"しかし、御国の子らは外の暗やみに放り出され、そこで泣いて歯ぎしりするのです。」","tok":[["しかし"],["、"],["御国","みくに"],["の"],["子","こ"],["ら"],["は"],["外","そと"],["の"],["暗やみ","くらやみ"],["に"],["放り出され","ほうりだされ"],["、"],["そこ"],["で"],["泣いて","ないて"],["歯ぎしり","はぎしり"],["する"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"それから、イエスは百人隊長に言われた。「さあ行きなさい。あなたの信じたとおりになるように。」すると、ちょうどその時、そのしもべはいやされた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["百人","ひゃくにん"],["隊長","たいちょう"],["に"],["言われた","いわれた"],["。"],["「"],["さあ"],["行き","いき"],["なさい"],["。"],["あなた"],["の"],["信じた","しんじた"],["とおり"],["に"],["なる"],["よう"],["に"],["。"],["」"],["する"],["と"],["、"],["ちょうど"],["その"],["時","とき"],["、"],["その"],["しもべ"],["は"],["いやされた"],["。"]]},{"verse":14,"text":"それから、イエスは、ペテロの家に来られて、ペテロのしゅうとめが熱病で床に着いているのをご覧になった。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["、"],["ペテロ"],["の"],["家","いえ"],["に"],["来られて","こられて"],["、"],["ペテロ"],["の"],["しゅうとめ"],["が"],["熱病","ねつびょう"],["で"],["床","ゆか"],["に"],["着いて","ついて"],["いる"],["の"],["を"],["ご覧","ごらん"],["に"],["なった"],["。"]]},{"verse":15,"text":"イエスが手にさわられると、熱がひき、彼女は起きてイエスをもてなした。","tok":[["イエス"],["が"],["手","て"],["に"],["さわられる"],["と"],["、"],["熱","ねつ"],["が"],["ひき"],["、"],["彼女","かのじょ"],["は"],["起きて","おきて"],["イエス"],["を"],["もてなした"],["。"]]},{"verse":16,"text":"夕方になると、人々は悪霊につかれた者を大ぜい、みもとに連れて来た。そこで、イエスはみことばをもって霊どもを追い出し、また病気の人々をみないやされた。","tok":[["夕方","ゆうがた"],["に"],["なる"],["と"],["、"],["人々","ひとびと"],["は"],["悪霊","あくりょう"],["に"],["つかれた"],["者","もの"],["を"],["大ぜい","おおぜい"],["、"],["みもと"],["に"],["連れて","つれて"],["来た","きた"],["。"],["そこ"],["で"],["、"],["イエス"],["は"],["みことば"],["を"],["もって"],["霊","れい"],["ども"],["を"],["追い出し","おいだし"],["、"],["また"],["病気","びょうき"],["の"],["人々","ひとびと"],["を"],["みない"],["や"],["された"],["。"]]},{"verse":17,"text":"これは、預言者イザヤを通して言われた事が成就するためであった。「彼が私たちのわずらいを身に引き受け、私たちの病を背負った。」","tok":[["これ"],["は"],["、"],["預言者","よげんしゃ"],["イザヤ"],["を"],["通して","とおして"],["言われた","いわれた"],["事","こと"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"
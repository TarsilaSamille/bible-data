[{"verse":1,"text":"天の御国は、自分のぶどう園で働く労務者を雇いに朝早く出かけた主人のようなものです。","tok":[["天","てん"],["の"],["御国","みくに"],["は"],["、"],["自分","じぶん"],["の"],["ぶどう園","ぶどうえん"],["で"],["働く","はたらく"],["労務者","ろうむしゃ"],["を"],["雇い","やとい"],["に"],["朝","あさ"],["早く","はやく"],["出かけた","でかけた"],["主人","しゅじん"],["の"],["よう"],["な"],["もの"],["です"],["。"]]},{"verse":2,"text":"彼は、労務者たちと一日一デナリの約束ができると、彼らをぶどう園にやった。","tok":[["彼","かれ"],["は"],["、"],["労務者","ろうむしゃ"],["たち"],["と"],["一","いち"],["日","にち"],["一","いち"],["デナリ"],["の"],["約束","やくそく"],["が"],["できる"],["と"],["、"],["彼","かれ"],["ら"],["を"],["ぶどう園","ぶどうえん"],["に"],["やった"],["。"]]},{"verse":3,"text":"それから、九時ごろに出かけてみると、別の人たちが市場に立っており、何もしないでいた。","tok":[["それ"],["から"],["、"],["九","きゅう"],["時","じ"],["ごろ"],["に"],["出かけて","でかけて"],["みる"],["と"],["、"],["別","べつ"],["の"],["人","ひと"],["たち"],["が"],["市場","しじょう"],["に"],["立って","たって"],["おり"],["、"],["何","なん"],["も"],["しないで"],["いた"],["。"]]},{"verse":4,"text":"そこで、彼はその人たちに言った。『あなたがたも、ぶどう園に行きなさい。相当のものを上げるから。』","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["その"],["人","ひと"],["たち"],["に"],["言った","いった"],["。"],["『"],["あなた"],["がた"],["も"],["、"],["ぶどう園","ぶどうえん"],["に"],["行き","いき"],["なさい"],["。"],["相当","そうとう"],["の"],["もの"],["を"],["上げる","あげる"],["から"],["。"],["』"]]},{"verse":5,"text":"彼らは出て行った。それからまた、十二時ごろと三時ごろに出かけて行って、同じようにした。","tok":[["彼","かれ"],["ら"],["は"],["出て","でて"],["行った","いった"],["。"],["それ"],["から"],["また"],["、"],["十二","じゅうに"],["時","じ"],["ごろ"],["と"],["三","さん"],["時","じ"],["ごろ"],["に"],["出かけて","でかけて"],["行って","いって"],["、"],["同じ","おなじ"],["よう"],["に"],["した"],["。"]]},{"verse":6,"text":"また、五時ごろ出かけてみると、別の人たちが立っていたので、彼らに言った。『なぜ、一日中仕事もしないでここにいるのですか。』","tok":[["また"],["、"],["五","ご"],["時","じ"],["ごろ"],["出かけて","でかけて"],["みる"],["と"],["、"],["別","べつ"],["の"],["人","ひと"],["たち"],["が"],["立って","たって"],["いた"],["ので"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["『"],["なぜ"],["、"],["一","いち"],["日","にち"],["中","なか"],["仕事","しごと"],["も"],["しないで"],["ここ"],["に"],["いる"],["の"],["です"],["か"],["。"],["』"]]},{"verse":7,"text":"彼らは言った。『だれも雇ってくれないからです。』彼は言った。『あなたがたも、ぶどう園に行きなさい。』","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"
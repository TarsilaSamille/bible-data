[{"verse":1,"text":"イエスは舟に乗って湖を渡り、自分の町に帰られた。","tok":[["イエス"],["は"],["舟","ふね"],["に"],["乗って","のって"],["湖","みずうみ"],["を"],["渡り","わたり"],["、"],["自分","じぶん"],["の"],["町","まち"],["に"],["帰られた","かえられた"],["。"]]},{"verse":2,"text":"すると、人々が中風の人を床に寝かせたままで、みもとに運んで来た。イエスは彼らの信仰を見て、中風の人に、「子よ。しっかりしなさい。あなたの罪は赦された」と言われた。","tok":[["する"],["と"],["、"],["人々","ひとびと"],["が"],["中風","ちゅうぶ"],["の"],["人","ひと"],["を"],["床","ゆか"],["に"],["寝かせた","ねかせた"],["まま"],["で"],["、"],["みもと"],["に"],["運んで","はこんで"],["来た","きた"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["信仰","しんこう"],["を"],["見て","みて"],["、"],["中風","ちゅうぶ"],["の"],["人","ひと"],["に"],["、"],["「"],["子","こ"],["よ"],["。"],["しっかり"],["し"],["なさい"],["。"],["あなた"],["の"],["罪","つみ"],["は"],["赦された","ゆるされた"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"すると、律法学者たちは、心の中で、「この人は神をけがしている」と言った。","tok":[["する"],["と"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["「"],["この"],["人","ひと"],["は"],["神","かみ"],["を"],["けがして"],["いる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"イエスは彼らの心の思いを知って言われた。「なぜ、心の中で悪いことを考えているのか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["の"],["心","こころ"],["の"],["思い","おもい"],["を"],["知って","しって"],["言われた","いわれた"],["。"],["「"],["なぜ"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["悪い","わるい"],["こと"],["を"],["考えて","かんがえて"],["いる"],["の"],["か"],["。"]]},{"verse":5,"text":"『あなたの罪は赦された』と言うのと、『起きて歩け』と言うのと、どちらがやさしいか。","tok":[["『"],["あなた"],["の"],["罪","つみ"],["は"],["赦された","ゆるされた"],["』"],["と"],["言う","いう"],["の"],["と"],["、"],["『"],["起きて","おきて"],["歩け","あるけ"],["』"],["と"],["言う","いう"],["の"],["と"],["、"],["どちら"],["が"],["やさしい"],["か"],["。"]]},{"verse":6,"text":"人の子が地上で罪を赦す権威を持っていることを、あなたがたに知らせるために。」こう言って、それから中風の人に、「起きなさい。寝床をたたんで、家に帰りなさい」と言われた。","tok":[["人","ひと"],["の"],["子","こ"],["が"],["地上","ちじょう"],["で"],["罪","つみ"],["を"],["赦す","ゆるす"],["権威","けんい"],["を"],["持って","もって"],["いる"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["知らせる","しらせる"],["ため"],["に"],["。"],["」"],["こう"],["言って","いって"],["、"],["それ"],["から"],["中風","ちゅうぶ"],["の"],["人","ひと"],["に"],["、"],["「"],["起き","おき"],["なさ
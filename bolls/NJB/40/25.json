[{"verse":1,"text":"そこで、天の御国は、たとえて言えば、それぞれがともしびを持って、花婿を出迎える十人の娘のようです。","tok":[["そこ"],["で"],["、"],["天","てん"],["の"],["御国","みくに"],["は"],["、"],["たとえて"],["言えば","いえば"],["、"],["それぞれ"],["が"],["ともしび"],["を"],["持って","もって"],["、"],["花婿","はなむこ"],["を"],["出迎える","でむかえる"],["十人","じゅうにん"],["の"],["娘","むすめ"],["の"],["よう"],["です"],["。"]]},{"verse":2,"text":"そのうち五人は愚かで、五人は賢かった。","tok":[["その"],["うち"],["五人","ごにん"],["は"],["愚か","おろか"],["で"],["、"],["五人","ごにん"],["は"],["賢かった","かしこかった"],["。"]]},{"verse":3,"text":"愚かな娘たちは、ともしびは持っていたが、油を用意しておかなかった。","tok":[["愚か","おろか"],["な"],["娘","むすめ"],["たち"],["は"],["、"],["ともしび"],["は"],["持って","もって"],["いた"],["が"],["、"],["油","あぶら"],["を"],["用意","ようい"],["して"],["おかなかった"],["。"]]},{"verse":4,"text":"賢い娘たちは、自分のともしびといっしょに、入れ物に油を入れて持っていた。","tok":[["賢い","かしこい"],["娘","むすめ"],["たち"],["は"],["、"],["自分","じぶん"],["の"],["ともしび"],["と"],["いっしょ"],["に"],["、"],["入れ物","いれもの"],["に"],["油","あぶら"],["を"],["入れて","いれて"],["持って","もって"],["いた"],["。"]]},{"verse":5,"text":"花婿が来るのが遅れたので、みな、うとうとして眠り始めた。","tok":[["花婿","はなむこ"],["が"],["来る","くる"],["の"],["が"],["遅れた","おくれた"],["ので"],["、"],["みな"],["、"],["うとうと"],["して"],["眠り","ねむり"],["始めた","はじめた"],["。"]]},{"verse":6,"text":"ところが、夜中になって、『そら、花婿だ。迎えに出よ』と叫ぶ声がした。","tok":[["ところ"],["が"],["、"],["夜中","よなか"],["に"],["なって"],["、"],["『"],["そら"],["、"],["花婿","はなむこ"],["だ"],["。"],["迎え","むかえ"],["に"],["出よ","でよ"],["』"],["と"],["叫ぶ","さけぶ"],["声","こえ"],["が"],["した"],["。"]]},{"verse":7,"text":"娘たちは、みな起きて、自分のともしびを整えた。","tok":[["娘","むすめ"],["たち"],["は"],["、"],["みな"],["起きて","おきて"],["、"],["自分","じぶん"],["の"],["ともしび"],["を"],["整えた","ととのえた"],["。"]]},{"verse":8,"text":"ところが愚かな娘たちは、賢い娘たちに言った。『油を少し私たちに分けてください。私たちのともしびは消えそうです。』","tok":[["ところ"],["が"],["愚か","おろか"],["な"],["娘","むすめ"],["たち"],["は"],["、"],["賢い","かしこい"],["娘","むすめ"],["たち"],["に"],["言った","いった"],["。"],["『"],["油","あぶら"],["を"],["少し","すこし"],["私たち","わたしたち"],["に"],["分けて","わけて"],["ください"],["。"],["私たち","わたしたち"],["の"],["ともしび"],["は"],["消え","きえ"],["そう"],["です"],["。"],["』"]]},{"verse":9,"text":"しかし、賢い娘たちは答えて言った。『いいえ、あなたがたに分けてあげるにはとうてい足りません。それよりも店に行って、自分のをお買いなさい。』","t
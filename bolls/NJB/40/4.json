[{"verse":1,"text":"さて、イエスは、悪魔の試みを受けるため、御霊に導かれて荒野に上って行かれた。","tok":[["さて"],["、"],["イエス"],["は"],["、"],["悪魔","あくま"],["の"],["試み","こころみ"],["を"],["受ける","うける"],["ため"],["、"],["御霊","ごれい"],["に"],["導かれて","みちびかれて"],["荒野","こうや"],["に"],["上って","のぼって"],["行かれた","いかれた"],["。"]]},{"verse":2,"text":"そして、四十日四十夜断食したあとで、空腹を覚えられた。","tok":[["そして"],["、"],["四十日","よんとうか"],["四十夜","よんじゅうや"],["断食","だんじき"],["した"],["あと"],["で"],["、"],["空腹","くうふく"],["を"],["覚えられた","おぼえられた"],["。"]]},{"verse":3,"text":"すると、試みる者が近づいて来て言った。「あなたが神の子なら、この石がパンになるように、命じなさい。」","tok":[["する"],["と"],["、"],["試みる","こころみる"],["者","もの"],["が"],["近づいて","ちかづいて"],["来て","きて"],["言った","いった"],["。"],["「"],["あなた"],["が"],["神","かみ"],["の"],["子","こ"],["なら"],["、"],["この"],["石","いし"],["が"],["パン"],["に"],["なる"],["よう"],["に"],["、"],["命じ","めいじ"],["なさい"],["。"],["」"]]},{"verse":4,"text":"イエスは答えて言われた。「『人はパンだけで生きるのではなく、神の口から出る一つ一つのことばによる』と書いてある。」","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["『"],["人","ひと"],["は"],["パン"],["だけ"],["で"],["生きる","いきる"],["ので"],["は"],["なく"],["、"],["神","かみ"],["の"],["口","くち"],["から"],["出る","でる"],["一","ひと"],["つ"],["一","ひと"],["つ"],["の"],["ことば"],["に"],["よる"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["」"]]},{"verse":5,"text":"すると、悪魔はイエスを聖なる都に連れて行き、神殿の頂に立たせて、","tok":[["する"],["と"],["、"],["悪魔","あくま"],["は"],["イエス"],["を"],["聖","せい"],["なる"],["都","と"],["に"],["連れて","つれて"],["行き","いき"],["、"],["神殿","しんでん"],["の"],["頂","いただき"],["に"],["立たせて","たたせて"],["、"]]},{"verse":6,"text":"言った。「あなたが神の子なら、下に身を投げてみなさい。『神は御使いたちに命じて、その手にあなたをささえさせ、あなたの足が石に打ち当たることのないようにされる』と書いてありますから。」","tok":[["言った","いった"],["。"],["「"],["あなた"],["が"],["神","かみ"],["の"],["子","こ"],["なら"],["、"],["下","した"],["に"],["身","み"],["を"],["投げて","なげて"],["み"],["なさい"],["。"],["『"],["神","かみ"],["は"],["御使い","おつかい"],["たち"],["に"],["命じて","めいじて"],["、"],["その"],["手","て"],["に"],["あなた"],["を"],["ささえさせ"],["、"],["あなた"],["の"],["足","あし"],["が"],["石","いし"],["に"],["打ち当たる","うちあたる"],["こと"],["の"],["ない"],["よう"],["に"],["される"],["』"],["と"],["書いて","かいて"],["あります"],["から"],["。"],["」"]]},{"verse":7,"text":"イエスは言われた。「『あなたの神である主を試みてはならない』とも書いてある。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["『"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["を"],["試みて","こころみて"],["は"],["ならない"],["』"],["と"],["も"],["書いて","かいて"],["ある"],["。"],["」"]]},{"verse":8,"text":"今度は悪魔は、イエスを非常に高い山に連れて行き、この世のすべての国々とその栄華を見せて、","tok":[["今度","こんど"],["は"],["悪魔","あくま"],["は"],["、"],["イエス"],["を"],["非常","ひじょう"],["に"],["高い","たかい"],["山","やま"],["に"],["連れて","つれて"],["行き","いき"],["、"],["この世","このよ"],["の"],["すべて"],["の"],["国々","くにぐに"],["と"],["その"],["栄華","えいが"],["を"],["見せて","みせて"],["、"]]},{"verse":9,"text":"言った。「もしひれ伏して私を拝むなら、これを全部あなたに差し上げましょう。」","tok":[["言った","いった"],["。"],["「"],["もし"],["ひれ伏して","ひれふして"],["私","わたくし"],["を"],["拝むなら","おがむなら"],["、"],["これ"],["を"],["全部","ぜんぶ"],["あなた"],["に"],["差し上げましょう","さしあげましょう"],["。"],["」"]]},{"verse":10,"text":"イエスは言われた。「引き下がれ、サタン。『あなたの神である主を拝み、主にだけ仕えよ』と書いてある。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["引き下がれ","ひきさがれ"],["、"],["サタン"],["。"],["『"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["を"],["拝み","おがみ"],["、"],["主に","おもに"],["だけ"],["仕え","つかえ"],["よ"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["」"]]},{"verse":11,"text":"すると悪魔はイエスを離れて行き、見よ、御使いたちが近づいて来て仕えた。","tok":[["する"],["と"],["悪魔","あくま"],["は"],["イエス"],["を"],["離れて","はなれて"],["行き","いき"],["、"],["見よ","みよ"],["、"],["御使い","おつかい"],["たち"],["が"],["近づいて","ちかづいて"],["来て","きて"],["仕えた","つかえた"],["。"]]},{"verse":12,"text":"ヨハネが捕らえられたと聞いてイエスは、ガリラヤへ立ちのかれた。","tok":[["ヨハネ"],["が"],["捕らえられた","とらえられた"],["と"],["聞いて","きいて"],["イエス"],["は"],["、"],["ガリラヤ"],["へ"],["立ちのかれた","たちのかれた"],["。"]]},{"verse":13,"text":"そしてナザレを去って、カペナウムに来て住まわれた。ゼブルンとナフタリとの境にある、湖のほとりの町である。","tok":[["そして"],["ナザレ"],["を"],["去って","さって"],["、"],["カペナウム"],["に"],["来て","きて"],["住まわれた","すまわれた"],["。"],["ゼブルン"],["と"],["ナフタリ"],["と"],["の"],["境","さかい"],["に"],["ある"],["、"],["湖","みずうみ"],["の"],["ほとり"],["の"],["町","まち"],["で"],["ある"],["。"]]},{"verse":14,"text":"これは、預言者イザヤを通して言われた事が、成就するためであった。すなわち、","tok":[["これ"],["は"],["、"],["預言者","よげんしゃ"],["イザヤ"],["を"],["通して","とおして"],["言われた","いわれた"],["事","こと"],["が"],["、"],["成就","じょうじゅ"],["する"],["ため"],["で"],["あった"],["。"],["すなわち"],["、"]]},{"verse":15,"text":"「ゼブルンの地とナフタリの地、湖に向かう道、ヨルダンの向こう岸、異邦人のガリラヤ。","tok":[["「"],["ゼブルン"],["の"],["地","ち"],["と"],["ナフタリ"],["の"],["地","ち"],["、"],["湖","みずうみ"],["に"],["向かう","むかう"],["道","みち"],["、"],["ヨルダン"],["の"],["向こう岸","むこうぎし"],["、"],["異邦人","いほうじん"],["の"],["ガリラヤ"],["。"]]},{"verse":16,"text":"暗やみの中にすわっていた民は偉大な光を見、死の地と死の陰にすわっていた人々に、光が上った。」","tok":[["暗やみ","くらやみ"],["の"],["中","なか"],["に"],["すわって"],["いた"],["民","たみ"],["は"],["偉大","いだい"],["な"],["光","ひかり"],["を"],["見","み"],["、"],["死","し"],["の"],["地","ち"],["と"],["死","し"],["の"],["陰","かげ"],["に"],["すわって"],["いた"],["人々","ひとびと"],["に"],["、"],["光","ひかり"],["が"],["上った","のぼった"],["。"],["」"]]},{"verse":17,"text":"この時から、イエスは宣教を開始して、言われた。「悔い改めなさい。天の御国が近づいたから。」","tok":[["この"],["時","とき"],["から"],["、"],["イエス"],["は"],["宣教","せんきょう"],["を"],["開始","かいし"],["して"],["、"],["言われた","いわれた"],["。"],["「"],["悔い改め","くいあらため"],["なさい"],["。"],["天","てん"],["の"],["御国","みくに"],["が"],["近づいた","ちかづいた"],["から"],["。"],["」"]]},{"verse":18,"text":"イエスがガリラヤ湖のほとりを歩いておられたとき、ふたりの兄弟、ペテロと呼ばれるシモンとその兄弟アンデレをご覧になった。彼らは湖で網を打っていた。漁師だったからである。","tok":[["イエス"],["が"],["ガリラヤ"],["湖","こ"],["の"],["ほとり"],["を"],["歩いて","あるいて"],["おられた"],["とき"],["、"],["ふたり"],["の"],["兄弟","きょうだい"],["、"],["ペテロ"],["と"],["呼ばれる","よばれる"],["シモン"],["と"],["その"],["兄弟","きょうだい"],["アンデレ"],["を"],["ご覧","ごらん"],["に"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["湖","みずうみ"],["で"],["網","あみ"],["を"],["打って","うって"],["いた"],["。"],["漁師","りょうし"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"イエスは彼らに言われた。「わたしについて来なさい。あなたがたを、人間をとる漁師にしてあげよう。」","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["について"],["来","き"],["なさい"],["。"],["あなた"],["がた"],["を"],["、"],["人間","にんげん"],["を"],["とる"],["漁師","りょうし"],["に"],["して"],["あげよう"],["。"],["」"]]},{"verse":20,"text":"彼らはすぐに網を捨てて従った。","tok":[["彼","かれ"],["ら"],["は"],["すぐ"],["に"],["網","あみ"],["を"],["捨てて","すてて"],["従った","したがった"],["。"]]},{"verse":21,"text":"そこからなお行かれると、イエスは、別のふたりの兄弟、ゼベダイの子ヤコブとその兄弟ヨハネが、父ゼベダイといっしょに舟の中で網を繕っているのをご覧になり、ふたりをお呼びになった。","tok":[["そこ"],["から"],["なお"],["行かれる","いかれる"],["と"],["、"],["イエス"],["は"],["、"],["別","べつ"],["の"],["ふたり"],["の"],["兄弟","きょうだい"],["、"],["ゼベダイ"],["の"],["子","こ"],["ヤコブ"],["と"],["その"],["兄弟","きょうだい"],["ヨハネ"],["が"],["、"],["父","ちち"],["ゼベダイ"],["と"],["いっしょ"],["に"],["舟","ふね"],["の"],["中","なか"],["で"],["網","あみ"],["を"],["繕って","つくろって"],["いる"],["の"],["を"],["ご覧","ごらん"],["に"],["なり"],["、"],["ふたり"],["を"],["お"],["呼び","よび"],["に"],["なった"],["。"]]},{"verse":22,"text":"彼らはすぐに舟も父も残してイエスに従った。","tok":[["彼","かれ"],["ら"],["は"],["すぐ"],["に"],["舟","ふね"],["も"],["父","ちち"],["も"],["残して","のこして"],["イエス"],["に"],["従った","したがった"],["。"]]},{"verse":23,"text":"イエスはガリラヤ全土を巡って、会堂で教え、御国の福音を宣べ伝え、民の中のあらゆる病気、あらゆるわずらいを直された。","tok":[["イエス"],["は"],["ガリラヤ"],["全土","ぜんど"],["を"],["巡って","めぐって"],["、"],["会堂","かいどう"],["で"],["教え","おしえ"],["、"],["御国","みくに"],["の"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["、"],["民","みん"],["の"],["中","なか"],["の"],["あらゆる"],["病気","びょうき"],["、"],["あらゆる"],["わずらい"],["を"],["直された","なおされた"],["。"]]},{"verse":24,"text":"イエスのうわさはシリヤ全体に広まった。それで人々は、さまざまな病気や痛みに苦しむ病人、悪霊につかれた人、てんかんの人、中風の人などをみな、みもとに連れて来た。イエスは彼らをいやされた。","tok":[["イエス"],["の"],["うわさ"],["は"],["シリヤ"],["全体","ぜんたい"],["に"],["広まった","ひろまった"],["。"],["それ"],["で"],["人々","ひとびと"],["は"],["、"],["さまざま"],["な"],["病気","びょうき"],["や"],["痛み","いたみ"],["に"],["苦しむ","くるしむ"],["病人","びょうにん"],["、"],["悪霊","あくりょう"],["に"],["つかれた"],["人","ひと"],["、"],["てんかん"],["の"],["人","ひと"],["、"],["中風","ちゅうぶ"],["の"],["人","ひと"],["など"],["を"],["みな"],["、"],["みもと"],["に"],["連れて","つれて"],["来た","きた"],["。"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["いやされた"],["。"]]},{"verse":25,"text":"こうしてガリラヤ、デカポリス、エルサレム、ユダヤおよびヨルダンの向こう岸から大ぜいの群衆がイエスにつき従った。","tok":[["こう"],["して"],["ガリラヤ"],["、"],["デカポリス"],["、"],["エルサレム"],["、"],["ユダヤ"],["および"],["ヨルダン"],["の"],["向こう岸","むこうぎし"],["から"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["イエス"],["に"],["つき従った","つきしたがった"],["。"]]}]
[{"verse":1,"text":"そのころ、バプテスマのヨハネが現れ、ユダヤの荒野で教えを宣べて、言った。","tok":[["その"],["ころ"],["、"],["バプテスマ"],["の"],["ヨハネ"],["が"],["現れ","あらわれ"],["、"],["ユダヤ"],["の"],["荒野","あらの"],["で"],["教え","おしえ"],["を"],["宣べて","のべて"],["、"],["言った","いった"],["。"]]},{"verse":2,"text":"「悔い改めなさい。天の御国が近づいたから。」","tok":[["「"],["悔い改め","くいあらため"],["なさい"],["。"],["天","てん"],["の"],["御国","みくに"],["が"],["近づいた","ちかづいた"],["から"],["。"],["」"]]},{"verse":3,"text":"この人は預言者イザヤによって、「荒野で叫ぶ者の声がする。／『主の道を用意し、主の通られる道をまっすぐにせよ。』」／と言われたその人である。","tok":[["この"],["人","ひと"],["は"],["預言者","よげんしゃ"],["イザヤ"],["によって"],["、"],["「"],["荒野","こうや"],["で"],["叫ぶ","さけぶ"],["者","もの"],["の"],["声","こえ"],["が"],["する"],["。"],["／"],["『"],["主","ぬし"],["の"],["道","みち"],["を"],["用意","ようい"],["し"],["、"],["主","ぬし"],["の"],["通られる","とおられる"],["道","みち"],["を"],["まっすぐ"],["に"],["せよ"],["。"],["』"],["」"],["／"],["と"],["言われた","いわれた"],["その"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":4,"text":"このヨハネは、らくだの毛の着物を着、腰には皮の帯を締め、その食べ物はいなごと野蜜であった。","tok":[["この"],["ヨハネ"],["は"],["、"],["らくだ"],["の"],["毛","け"],["の"],["着物","きもの"],["を"],["着","き"],["、"],["腰","こし"],["に"],["は"],["皮","かわ"],["の"],["帯","おび"],["を"],["締め","しめ"],["、"],["その"],["食べ物","たべもの"],["は"],["いなご"],["と"],["野","の"],["蜜","みつ"],["で"],["あった"],["。"]]},{"verse":5,"text":"さて、エルサレム、ユダヤ全土、ヨルダン川沿いの全地域の人々がヨハネのところへ出て行き、","tok":[["さて"],["、"],["エルサレム"],["、"],["ユダヤ"],["全土","ぜんど"],["、"],["ヨルダン"],["川沿い","かわぞい"],["の"],["全","ぜん"],["地域","ちいき"],["の"],["人々","ひとびと"],["が"],["ヨハネ"],["の"],["ところ"],["へ"],["出て","でて"],["行き","いき"],["、"]]},{"verse":6,"text":"自分の罪を告白して、ヨルダン川で彼からバプテスマを受けた。","tok":[["自分","じぶん"],["の"],["罪","つみ"],["を"],["告白","こくはく"],["して"],["、"],["ヨルダン"],["川","かわ"],["で"],["彼","かれ"],["から"],["バプテスマ"],["を"],["受けた","うけた"],["。"]]},{"verse":7,"text":"しかし、パリサイ人やサドカイ人が大ぜいバプテスマを受けに来るのを見たとき、ヨハネは彼らに言った。／「まむしのすえたち。だれが必ず来る御怒りをのがれるように教えたのか。","tok":[["しかし"],["、"],["パリサイ"],["人","にん"],["や"],["サドカイ"],["人","にん"],["が"],["大ぜい","おおぜい"],["バプテスマ"],["を"],["受け","うけ"],["に"],["来る","くる"],["の"],["を"],["見た","みた"],["とき"],["、"],["ヨハネ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["／"],["「"],["まむし"],["の"],["すえ"],["たち"],["。"],["だれ"],["が"],["必ず","かならず"],["来る","くる"],["御怒り","おいかり"],["を"],["のがれる"],["よう"],["に"],["教えた","おしえた"],["の"],["か"],["。"]]},{"verse":8,"text":"それなら、悔い改めにふさわしい実を結びなさい。","tok":[["それ"],["なら"],["、"],["悔い改め","くいあらため"],["に"],["ふさわしい"],["実","じつ"],["を"],["結び","むすび"],["なさい"],["。"]]},{"verse":9,"text":"『われわれの父はアブラハムだ』と心の中で言うような考えではいけない。あなたがたに言っておくが、神は、この石ころからでも、アブラハムの子孫を起こすことがおできになるのです。","tok":[["『"],["われわれ"],["の"],["父","ちち"],["は"],["アブラハム"],["だ"],["』"],["と"],["心","こころ"],["の"],["中","なか"],["で"],["言う","いう"],["よう"],["な"],["考え","かんがえ"],["で"],["は"],["いけない"],["。"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["が"],["、"],["神","かみ"],["は"],["、"],["この"],["石ころ","いしころ"],["から"],["で"],["も"],["、"],["アブラハム"],["の"],["子孫","しそん"],["を"],["起こす","おこす"],["こと"],["が"],["おでき"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":10,"text":"斧もすでに木の根元に置かれています。だから、良い実を結ばない木は、みな切り倒されて、火に投げ込まれます。","tok":[["斧","おの"],["も"],["すでに"],["木","き"],["の"],["根元","ねもと"],["に"],["置かれて","おかれて"],["います"],["。"],["だ"],["から"],["、"],["良い","よい"],["実","じつ"],["を"],["結ばない","むすばない"],["木","き"],["は"],["、"],["みな"],["切り倒されて","きりたおされて"],["、"],["火","ひ"],["に"],["投げ込まれます","なげこまれます"],["。"]]},{"verse":11,"text":"私は、あなたがたが悔い改めるために、水のバプテスマを授けていますが、私のあとから来られる方は、私よりもさらに力のある方です。私はその方のはきものを脱がせてあげる値うちもありません。その方は、あなたがたに聖霊と火とのバプテスマをお授けになります。","tok":[["私","わたくし"],["は"],["、"],["あなた"],["がた"],["が"],["悔い改める","くいあらためる"],["ため"],["に"],["、"],["水","みず"],["の"],["バプテスマ"],["を"],["授けて","さずけて"],["います"],["が"],["、"],["私","わたくし"],["の"],["あと"],["から"],["来られる","こられる"],["方","かた"],["は"],["、"],["私","わたくし"],["より"],["も"],["さらに"],["力","ちから"],["の"],["ある"],["方","かた"],["です"],["。"],["私","わたくし"],["は"],["その"],["方","かた"],["の"],["はきもの"],["を"],["脱がせて","ぬがせて"],["あげる"],["値うち","ねうち"],["も"],["ありません"],["。"],["その"],["方","かた"],["は"],["、"],["あなた"],["がた"],["に"],["聖霊","せいれい"],["と"],["火","ひ"],["と"],["の"],["バプテスマ"],["を"],["お授け","おさずけ"],["に"],["なります"],["。"]]},{"verse":12,"text":"手に箕を持っておられ、ご自分の脱穀場をすみずみまできよめられます。麦を倉に納め、殻を消えない火で焼き尽くされます。」","tok":[["手","て"],["に"],["箕","み"],["を"],["持って","もって"],["おられ"],["、"],["ご自分","ごじぶん"],["の"],["脱穀場","だっこくじょう"],["を"],["すみずみ"],["まで"],["きよめられます"],["。"],["麦","むぎ"],["を"],["倉","くら"],["に"],["納め","おさめ"],["、"],["殻","から"],["を"],["消えない","きえない"],["火","ひ"],["で"],["焼き","やき"],["尽くされます","つくされます"],["。"],["」"]]},{"verse":13,"text":"さて、イエスは、ヨハネからバプテスマを受けるために、ガリラヤからヨルダンにお着きになり、ヨハネのところに来られた。","tok":[["さて"],["、"],["イエス"],["は"],["、"],["ヨハネ"],["から"],["バプテスマ"],["を"],["受ける","うける"],["ため"],["に"],["、"],["ガリラヤ"],["から"],["ヨルダン"],["に"],["お着き","おつき"],["に"],["なり"],["、"],["ヨハネ"],["の"],["ところ"],["に"],["来られた","こられた"],["。"]]},{"verse":14,"text":"しかし、ヨハネはイエスにそうさせまいとして、言った。「私こそ、あなたからバプテスマを受けるはずですのに、あなたが、私のところにおいでになるのですか。」","tok":[["しかし"],["、"],["ヨハネ"],["は"],["イエス"],["に"],["そう"],["させまい"],["として"],["、"],["言った","いった"],["。"],["「"],["私","わたくし"],["こそ"],["、"],["あなた"],["から"],["バプテスマ"],["を"],["受ける","うける"],["はず"],["です"],["のに"],["、"],["あなた"],["が"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["おいで"],["に"],["なる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":15,"text":"ところが、イエスは答えて言われた。「今はそうさせてもらいたい。このようにして、すべての正しいことを実行するのは、わたしたちにふさわしいのです。」そこで、ヨハネは承知した。","tok":[["ところ"],["が"],["、"],["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["今","いま"],["は"],["そう"],["させて"],["もらいたい"],["。"],["この"],["よう"],["に"],["して"],["、"],["すべて"],["の"],["正しい","ただしい"],["こと"],["を"],["実行","じっこう"],["する"],["の"],["は"],["、"],["わたしたち"],["に"],["ふさわしい"],["の"],["です"],["。"],["」"],["そこ"],["で"],["、"],["ヨハネ"],["は"],["承知","しょうち"],["した"],["。"]]},{"verse":16,"text":"こうして、イエスはバプテスマを受けて、すぐに水から上がられた。すると、天が開け、神の御霊が鳩のように下って、自分の上に来られるのをご覧になった。","tok":[["こう"],["して"],["、"],["イエス"],["は"],["バプテスマ"],["を"],["受けて","うけて"],["、"],["すぐ"],["に"],["水","みず"],["から"],["上がられた","あがられた"],["。"],["する"],["と"],["、"],["天","てん"],["が"],["開け","あけ"],["、"],["神","かみ"],["の"],["御霊","ごれい"],["が"],["鳩","はと"],["の"],["よう"],["に"],["下って","くだって"],["、"],["自分","じぶん"],["の"],["上","うえ"],["に"],["来られる","こられる"],["の"],["を"],["ご覧","ごらん"],["に"],["なった"],["。"]]},{"verse":17,"text":"また、天からこう告げる声が聞こえた。「これは、わたしの愛する子、わたしはこれを喜ぶ。」","tok":[["また"],["、"],["天","てん"],["から"],["こう"],["告
[{"verse":1,"text":"イエスが、ヘロデ王の時代に、ユダヤのベツレヘムでお生まれになったとき、見よ、東方の博士たちがエルサレムにやって来て、こう言った。","tok":[["イエス"],["が"],["、"],["ヘロデ"],["王","おう"],["の"],["時代","じだい"],["に"],["、"],["ユダヤ"],["の"],["ベツレヘム"],["で"],["お生まれ","おうまれ"],["に"],["なった"],["とき"],["、"],["見よ","みよ"],["、"],["東方","とうほう"],["の"],["博士","はかせ"],["たち"],["が"],["エルサレム"],["に"],["やって"],["来て","きて"],["、"],["こう"],["言った","いった"],["。"]]},{"verse":2,"text":"「ユダヤ人の王としてお生まれになった方はどこにおいでになりますか。私たちは、東のほうでその方の星を見たので、拝みにまいりました。」","tok":[["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["として"],["お生まれ","おうまれ"],["に"],["なった"],["方","ほう"],["は"],["どこ"],["に"],["おいで"],["に"],["なります"],["か"],["。"],["私たち","わたしたち"],["は"],["、"],["東","ひがし"],["の"],["ほう"],["で"],["その"],["方","かた"],["の"],["星","ほし"],["を"],["見た","みた"],["ので"],["、"],["拝み","おがみ"],["に"],["まいりました"],["。"],["」"]]},{"verse":3,"text":"それを聞いて、ヘロデ王は恐れ惑った。エルサレム中の人も王と同様であった。","tok":[["それ"],["を"],["聞いて","きいて"],["、"],["ヘロデ"],["王","おう"],["は"],["恐れ","おそれ"],["惑った","まどった"],["。"],["エルサレム"],["中","ちゅう"],["の"],["人","ひと"],["も"],["王","おう"],["と"],["同様","どうよう"],["で"],["あった"],["。"]]},{"verse":4,"text":"そこで、王は、民の祭司長たち、学者たちをみな集めて、キリストはどこで生まれるのかと問いただした。","tok":[["そこ"],["で"],["、"],["王","おう"],["は"],["、"],["民","みん"],["の"],["祭司長","さいしちょう"],["たち"],["、"],["学者","がくしゃ"],["たち"],["を"],["みな"],["集めて","あつめて"],["、"],["キリスト"],["は"],["どこ"],["で"],["生まれる","うまれる"],["の"],["か"],["と"],["問いただした","といただした"],["。"]]},{"verse":5,"text":"彼らは王に言った。「ユダヤのベツレヘムです。預言者によってこう書かれているからです。","tok":[["彼","かれ"],["ら"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["ユダヤ"],["の"],["ベツレヘム"],["です"],["。"],["預言者","よげんしゃ"],["によって"],["こう"],["書かれて","かかれて"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"『ユダの地、ベツレヘム。／あなたはユダを治める者たちの中で、決して一番小さくはない。／わたしの民イスラエルを治める支配者が、あなたから出るのだから。』」","tok":[["『"],["ユダ"],["の"],["地","ち"],["、"],["ベツレヘム"],["。"],["／"],["あなた"],["は"],["ユダ"],["を"],["治める","おさめる"],["者","もの"],["たち"],["の"],["中","なか"],["で"],["、"],["決して","けっして"],["一番","いちばん"],["小さく","ちいさく"],["は"],["ない"],["。"],["／"],["わたし"],["の"],["民","みん"],["イスラエル"],["を"],["治める","おさめる"],["支配者","しはいしゃ"],["が"],["、"],["あなた"],["から"],["出る","でる"],["の"],["だ"],["から"],["。"],["』"],["」"]]},{"verse":7,"text":"そこで、ヘロデはひそかに博士たちを呼んで、彼らから星の出現の時間を突き止めた。","tok":[["そこ"],["で"],["、"],["ヘロデ"],["は"],["ひそか"],["に"],["博士","はかせ"],["たち"],["を"],["呼んで","よんで"],["、"],["彼","かれ"],["ら"],["から"],["星","ほし"],["の"],["出現","しゅつげん"],["の"],["時間","じかん"],["を"],["突き止めた","つきとめた"],["。"]]},{"verse":8,"text":"そして、こう言って彼らをベツレヘムに送った。「行って幼子のことを詳しく調べ、わかったら知らせてもらいたい。私も行って拝むから。」","tok":[["そして"],["、"],["こう"],["言って","いって"],["彼","かれ"],["ら"],["を"],["ベツレヘム"],["に"],["送った","おくった"],["。"],["「"],["行って","いって"],["幼子","おさなご"],["の"],["こと"],["を"],["詳しく","くわしく"],["調べ","しらべ"],["、"],["わかったら"],["知らせて","しらせて"],["もらいたい"],["。"],["私","わたくし"],["も"],["行って","いって"],["拝む","おがむ"],["から"],["。"],["」"]]},{"verse":9,"text":"彼らは王の言ったことを聞いて出かけた。すると、見よ、東方で見た星が彼らを先導し、ついに幼子のおられる所まで進んで行き、その上にとどまった。","tok":[["彼","かれ"],["ら"],["は"],["王","おう"],["の"],["言った","いった"],["こと"],["を"],["聞いて","きいて"],["出かけた","でかけた"],["。"],["する"],["と"],["、"],["見よ","みよ"],["、"],["東方","とうほう"],["で"],["見た","みた"],["星","ほし"],["が"],["彼","かれ"],["ら"],["を"],["先導","せんどう"],["し"],["、"],["ついに"],["幼子","おさなご"],["の"],["おられる"],["所","ところ"],["まで"],["進んで","すすんで"],["行き","いき"],["、"],["その"],["上","うえ"],["に"],["とどまった"],["。"]]},{"verse":10,"text":"その星を見て、彼らはこの上もなく喜んだ。","tok":[["その"],["星","ほし"],["を"],["見て","みて"],["、"],["彼","かれ"],["ら"],["は"],["この"],["上","うえ"],["も"],["なく"],["喜んだ","よろこんだ"],["。"]]},{"verse":11,"text":"そしてその家に入って、母マリヤとともにおられる幼子を見、ひれ伏して拝んだ。そして、宝の箱をあけて、黄金、乳香、没薬を贈り物としてささげた。","tok":[["そして"],["その"],["家","いえ"],["に"],["入って","はいって"],["、"],["母","はは"],["マリヤ"],["と"],["とも"],["に"],["おられる"],["幼子","おさなご"],["を"],["見","み"],["、"],["ひれ伏して","ひれふして"],["拝んだ","おがんだ"],["。"],["そして"],["、"],["宝","たから"],["の"],["箱","ばこ"],["を"],["あけて"],["、"],["黄金","おうごん"],["、"],["乳香","にゅうこう"],["、"],["没薬","もつやく"],["を"],["贈り物","おくりもの"],["として"],["ささげた"],["。"]]},{"verse":12,"text":"それから、夢でヘロデのところへ戻るなという戒めを受けたので、別の道から自分の国へ帰って行った。","tok":[["それ"],["から"],["、"],["夢","ゆめ"],["で"],["ヘロデ"],["の"],["ところ"],["へ"],["戻る","もどる"],["な"],["と"],["いう"],["戒め","いましめ"],["を"],["受けた","うけた"],["ので"],["、"],["別","べつ"],["の"],["道","みち"],["から"],["自分","じぶん"],["の"],["国","くに"],["へ"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":13,"text":"彼らが帰って行ったとき、見よ、主の使いが夢でヨセフに現れて言った。「立って、幼子とその母を連れ、エジプトへ逃げなさい。そして、私が知らせるまで、そこにいなさい。ヘロデがこの幼子を捜し出して殺そうとしています。」","tok":[["彼","かれ"],["ら"],["が"],["帰って","かえって"],["行った","いった"],["とき"],["、"],["見よ","みよ"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["夢","ゆめ"],["で"],["ヨセフ"],["に"],["現れて","あらわれて"],["言った","いった"],["。"],["「"],["立って","たって"],["、"],["幼子","おさなご"],["と"],["その"],["母","はは"],["を"],["連れ","つれ"],["、"],["エジプト"],["へ"],["逃げ","にげ"],["なさい"],["。"],["そして"],["、"],["私","わたくし"],["が"],["知らせる","しらせる"],["まで"],["、"],["そこ"],["に"],["い"],["なさい"],["。"],["ヘロデ"],["が"],["この"],["幼子","おさなご"],["を"],["捜し出して","さがしだして"],["殺そう","ころそう"],["として"],["います"],["。"],["」"]]},{"verse":14,"text":"そこで、ヨセフは立って、夜のうちに幼子とその母を連れてエジプトに立ちのき、","tok":[["そこ"],["で"],["、"],["ヨセフ"],["は"],["立って","たって"],["、"],["夜","よる"],["の"],["うち"],["に"],["幼子","おさなご"],["と"],["その"],["母","はは"],["を"],["連れて","つれて"],["エジプト"],["に"],["立ちのき","たちのき"],["、"]]},{"verse":15,"text":"ヘロデが死ぬまでそこにいた。これは、主が預言者を通して、「わたしはエジプトから、わたしの子を呼び出した」と言われた事が成就するためであった。","tok":[["ヘロデ"],["が"],["死ぬ","しぬ"],["まで"],["そこ"],["に"],["いた"],["。"],["これ"],["は"],["、"],["主","ぬし"],["が"],["預言者","よげんしゃ"],["を"],["通して","とおして"],["、"],["「"],["わたし"],["は"],["エジプト"],["から"],["、"],["わたし"],["の"],["子","こ"],["を"],["呼び出した","よびだした"],["」"],["と"],["言われた","いわれた"],["事","こと"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":16,"text":"その後、ヘロデは、博士たちにだまされたことがわかると、非常におこって、人をやって、ベツレヘムとその近辺の二歳以下の男の子をひとり残らず殺させた。その年齢は博士たちから突き止めておいた時間から割り出したのである。","tok":[["その"],["後","ご"],["、"],["ヘロデ"],["は"],["、"],["博士","はかせ"],["たち"],["に"],["だまされた"],["こと"],["が"],["わかる"],["と"],["、"],["非常","ひじょう"],["に"],["おこって"],["、"],["人","ひと"],["を"],["やって"],["、"],["ベツレヘム"],["と"],["その"],["近辺","きんぺん"],["の"],["二歳","にさい"],["以下","いか"],["の"],["男の子","おとこのこ"],["を"],["ひとり"],["残らず","のこらず"],["殺させた","ころさせた"],["。"],["その"],["年齢","ねんれい"],["は"],["博士","はかせ"],["たち"],["から"],["突き止めて","つきとめて"],["おいた"],["時間","じかん"],["から"],["割り出した","わりだした"],["ので"],["ある"],["。"]]},{"verse":17,"text":"そのとき、預言者エレミヤを通して言われた事が成就した。","tok":[["その"],["とき"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["を"],["通して","とおして"],["言われた","いわれた"],["事","こと"],["が"],["成就","じょうじゅ"],["した"],["。"]]},{"verse":18,"text":"「ラマで声がする。／泣き、そして嘆き叫ぶ声。／ラケルがその子らのために泣いている。／ラケルは慰められることを拒んだ。／子らがもういないからだ。」","tok":[["「"],["ラマ"],["で"],["声","こえ"],["が"],["する"],["。"],["／"],["泣き","なき"],["、"],["そして"],["嘆き叫ぶ","なげきさけぶ"],["声","こえ"],["。"],["／"],["ラケル"],["が"],["その"],["子","こ"],["ら"],["の"],["ため"],["に"],["泣いて","ないて"],["いる"],["。"],["／"],["ラケル"],["は"],["慰められる","なぐさめられる"],["こと"],["を"],["拒んだ","こばんだ"],["。"],["／"],["子","こ"],["ら"],["が"],["もう"],["いない"],["から"],["だ"],["。"],["」"]]},{"verse":19,"text":"ヘロデが死ぬと、見よ、主の使いが、夢でエジプトにいるヨセフに現れて、言った。","tok":[["ヘロデ"],["が"],["死ぬ","しぬ"],["と"],["、"],["見よ","みよ"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["、"],["夢","ゆめ"],["で"],["エジプト"],["に"],["いる"],["ヨセフ"],["に"],["現れて","あらわれて"],["、"],["言った","いった"],["。"]]},{"verse":20,"text":"「立って、幼子とその母を連れて、イスラエルの地に行きなさい。幼子のいのちをつけねらっていた人たちは死にました。」","tok":[["「"],["立って","たって"],["、"],["幼子","おさなご"],["と"],["その"],["母","はは"],["を"],["連れて","つれて"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["行き","いき"],["なさい"],["。"],["幼子","おさなご"],["の"],["いのち"],["を"],["つけねらって"],["いた"],["人","ひと"],["たち"],["は"],["死にました","しにました"],["。"],["」"]]},{"verse":21,"text":"そこで、彼は立って、幼子とその母を連れて、イスラエルの地に入った。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["立って","たって"],["、"],["幼子","おさなご"],["と"],["その"],["母","はは"],["を"],["連れて","つれて"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["入った","はいった"],["。"]]},{"verse":22,"text":"しかし、アケラオが父ヘロデに代わってユダヤを治めていると聞いたので、そこに行ってとどまることを恐れた。そして、夢で戒めを受けたので、ガリラヤ地方に立ちのいた。","tok":[["しかし"],["、"],["アケラオ"],["が"],["父","ちち"],["ヘロデ"],["に"],["代わって","かわって"],["ユダヤ"],["を"],["治めて","おさめて"],["いる"],["と"],["聞いた","きいた"],["ので"],["、"],["そこ"],["に"],["行って","いって"],["とどまる"],["こと"],["を"],["恐れた","おそれた"],["。"],["そして"],["、"],["夢","ゆめ"],["で"],["戒め","いましめ"],["を"],["受けた","うけた"],["ので"],["、"],["ガリラヤ"],["地方","ちほう"],["に"],["立ちのいた","たちのいた"],["。"]]},{"verse":23,"text":"そして、ナザレという町に行って住んだ。これは預言者たちを通して「この方はナザレ人と呼ばれる」と言われた事が成就するためであった。","tok":[["そして"],["、"],["ナザレ"],["と"],["いう"],["町","まち"],["に"],["行って","いって"],["住んだ","すんだ"],["。"],["これ"],["は"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["「"],["この"],["方","かた"],["は"],["ナザレ人","なざれにん"],["と"],["呼ばれる","よばれる"],["」"],["と"],["言われた","いわれた"],["事","こと"],["が"],["成就","じょうじゅ"],["する"],["ため"],["で"],["あった"],["。"]]}]
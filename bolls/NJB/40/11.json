[{"verse":1,"text":"イエスはこのように十二弟子に注意を与え、それを終えられると、彼らの町々で教えたり宣べ伝えたりするため、そこを立ち去られた。","tok":[["イエス"],["は"],["この"],["よう"],["に"],["十二","じゅうに"],["弟子","でし"],["に"],["注意","ちゅうい"],["を"],["与え","あたえ"],["、"],["それ"],["を"],["終えられる","おえられる"],["と"],["、"],["彼","かれ"],["ら"],["の"],["町々","まちまち"],["で"],["教え","おしえ"],["たり"],["宣べ伝え","のべつたえ"],["たり"],["する"],["ため"],["、"],["そこ"],["を"],["立ち去られた","たちさられた"],["。"]]},{"verse":2,"text":"さて、獄中でキリストのみわざについて聞いたヨハネは、その弟子たちに託して、","tok":[["さて"],["、"],["獄中","ごくちゅう"],["で"],["キリスト"],["の"],["みわざ"],["について"],["聞いた","きいた"],["ヨハネ"],["は"],["、"],["その"],["弟子","でし"],["たち"],["に"],["託して","たくして"],["、"]]},{"verse":3,"text":"イエスにこう言い送った。「おいでになるはずの方は、あなたですか。それとも、私たちは別の方を待つべきでしょうか。」","tok":[["イエス"],["に"],["こう"],["言い送った","いいおくった"],["。"],["「"],["おいで"],["に"],["なる"],["はず"],["の"],["方","ほう"],["は"],["、"],["あなた"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["私たち","わたしたち"],["は"],["別","べつ"],["の"],["方","ほう"],["を"],["待つべきでしょう","まつべきでしょう"],["か"],["。"],["」"]]},{"verse":4,"text":"イエスは答えて、彼らに言われた。「あなたがたは行って、自分たちの聞いたり見たりしていることをヨハネに報告しなさい。","tok":[["イエス"],["は"],["答えて","こたえて"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["は"],["行って","いって"],["、"],["自分","じぶん"],["たち"],["の"],["聞い","きい"],["たり"],["見","み"],["たり"],["して"],["いる"],["こと"],["を"],["ヨハネ"],["に"],["報告","ほうこく"],["し"],["なさい"],["。"]]},{"verse":5,"text":"目の見えない者が見、足のなえた者が歩き、ツァラアトに冒された者がきよめられ、耳の聞こえない者が聞き、死人が生き返り、貧しい者たちに福音が宣べ伝えられている。","tok":[["目","め"],["の"],["見えない","みえない"],["者","もの"],["が"],["見","み"],["、"],["足","あし"],["の"],["なえた"],["者","もの"],["が"],["歩き","あるき"],["、"],["ツァラアト"],["に"],["冒された","おかされた"],["者","もの"],["が"],["きよめられ"],["、"],["耳","みみ"],["の"],["聞こえない","きこえない"],["者","もの"],["が"],["聞き","きき"],["、"],["死人","しにん"],["が"],["生き返り","いきかえり"],["、"],["貧しい","まずしい"],["者","もの"],["たち"],["に"],["福音","ふくいん"],["が"],["宣べ伝えられて","のべつたえられて"],["いる"],["。"]]},{"verse":6,"text":"だれでもわたしにつまずかない者は幸いです。」","tok":[["だれ"],["で"],["も"],["わたし"],["に"],["つまずかない"],["者","もの"],["は"],["幸い","さいわい"],["です"],["。"],["」"]]},{"verse":7,"text":"この人たちが行ってしまうと、イエスは、ヨハネについて群衆に話しだされた。「あなたがたは、何を見に荒野に出て行ったのですか。風に揺れる葦ですか。","tok":[["この"],["人","ひと"],["たち"],["が"],["行って","いって"],["しまう"],["と"],["、"],["イエス"],["は"],["、"],["ヨハネ"],["について"],["群衆","ぐんしゅう"],["に"],["話し","はなし"],["だされた"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["何","なん"],["を"],["見","み"],["に"],["荒野","あらの"],["に"],["出て","でて"],["行った","いった"],["の"],["です"],["か"],["。"],["風","かぜ"],["に"],["揺れる","ゆれる"],["葦","あし"],["です"],["か"],["。"]]},{"verse":8,"text":"でなかったら、何を見に行ったのですか。柔らかい着物を着た人ですか。柔らかい着物を着た人なら王の宮殿にいます。","tok":[["で"],["なかったら"],["、"],["何","なん"],["を"],["見","み"],["に"],["行った","いった"],["の"],["です"],["か"],["。"],["柔らかい","やわらかい"],["着物","きもの"],["を"],["着た","きた"],["人","ひと"],["です"],["か"],["。"],["柔らかい","やわらかい"],["着物","きもの"],["を"],["着た","きた"],["人","ひと"],["なら"],["王","おう"],["の"],["宮殿","きゅうでん"],["に"],["います"],["。"]]},{"verse":9,"text":"でなかったら、なぜ行ったのですか。預言者を見るためですか。そのとおり。だが、わたしが言いましょう。預言者よりもすぐれた者をです。","tok":[["で"],["なかったら"],["、"],["なぜ"],["行った","いった"],["の"],["です"],["か"],["。"],["預言者","よげんしゃ"],["を"],["見る","みる"],["ため"],["です"],["か"],["。"],["その"],["とおり"],["。"],["だ"],["が"],["、"],["わたし"],["が"],["言いましょう","いいましょう"],["。"],["預言者","よげんしゃ"],["より"],["も"],["すぐれた"],["者","もの"],["を"],["です"],["。"]]},{"verse":10,"text":"この人こそ、『見よ、わたしは使いをあなたの前に遣わし、あなたの道を、あなたの前に備えさせよう。』／と書かれているその人です。","tok":[["この"],["人","ひと"],["こそ"],["、"],["『"],["見よ","みよ"],["、"],["わたし"],["は"],["使い","つかい"],["を"],["あなた"],["の"],["前","まえ"],["に"],["遣わし","つかわし"],["、"],["あなた"],["の"],["道","みち"],["を"],["、"],["あなた"],["の"],["前","まえ"],["に"],["備えさせよう","そなえさせよう"],["。"],["』"],["／"],["と"],["書かれて","かかれて"],["いる"],["その"],["人","ひと"],["です"],["。"]]},{"verse":11,"text":"まことに、あなたがたに告げます。女から生まれた者の中で、バプテスマのヨハネよりすぐれた人は出ませんでした。しかも、天の御国の一番小さい者でも、彼より偉大です。","tok":[["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["女","おんな"],["から"],["生まれた","うまれた"],["者","もの"],["の"],["中","なか"],["で"],["、"],["バプテスマ"],["の"],["ヨハネ"],["より"],["すぐれた"],["人","ひと"],["は"],["出ませんでした","でませんでした"],["。"],["しかも"],["、"],["天","てん"],["の"],["御国","みくに"],["の"],["一番","いちばん"],["小さい","ちいさい"],["者","もの"],["で"],["も"],["、"],["彼","かれ"],["よ
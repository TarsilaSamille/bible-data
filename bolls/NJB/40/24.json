[{"verse":1,"text":"イエスが宮を出て行かれるとき、弟子たちが近寄って来て、イエスに宮の建物をさし示した。","tok":[["イエス"],["が"],["宮","みや"],["を"],["出て","でて"],["行かれる","いかれる"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["近寄って","ちかよって"],["来て","きて"],["、"],["イエス"],["に"],["宮","みや"],["の"],["建物","たてもの"],["を"],["さし示した","さししめした"],["。"]]},{"verse":2,"text":"そこで、イエスは彼らに答えて言われた。「このすべての物に目をみはっているのでしょう。まことに、あなたがたに告げます。ここでは、石がくずされずに、積まれたまま残ることは決してありません。」","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["この"],["すべて"],["の"],["物","もの"],["に"],["目","め"],["を"],["みはって"],["いる"],["の"],["でしょう"],["。"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["ここ"],["で"],["は"],["、"],["石","いし"],["が"],["くずされず"],["に"],["、"],["積まれた","つまれた"],["まま"],["残る","のこる"],["こと"],["は"],["決して","けっして"],["ありません"],["。"],["」"]]},{"verse":3,"text":"イエスがオリーブ山ですわっておられると、弟子たちが、ひそかにみもとに来て言った。「お話しください。いつ、そのようなことが起こるのでしょう。あなたの来られる時や世の終わりには、どんな前兆があるのでしょう。」","tok":[["イエス"],["が"],["オリーブ"],["山","さん"],["で"],["すわって"],["おられる"],["と"],["、"],["弟子","でし"],["たち"],["が"],["、"],["ひそか"],["に"],["みもと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["お話し","おはなし"],["ください"],["。"],["いつ"],["、"],["その"],["よう"],["な"],["こと"],["が"],["起こる","おこる"],["の"],["でしょう"],["。"],["あなた"],["の"],["来られる","こられる"],["時","とき"],["や"],["世","よ"],["の"],["終わり","おわり"],["に"],["は"],["、"],["どんな"],["前兆","ぜんちょう"],["が"],["ある"],["の"],["でしょう"],["。"],["」"]]},{"verse":4,"text":"そこで、イエスは彼らに答えて言われた。「人に惑わされないように気をつけなさい。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["に"],["惑わされない","まどわされない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":5,"text":"わたしの名を名のる者が大ぜい現れ、『私こそキリストだ』と言って、多くの人を惑わすでしょう。","tok":[["わたし"],["の"],["名","な"],["を"],["名のる","なのる"],["者","もの"],["が"],["大ぜい","おおぜい"],["現れ","あらわれ"],["、"],["『"],["私","わたくし"],["こそ"],["キリスト"],["だ"],["』"],["と"],["言って","いって"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["惑わすでしょう","まどわすでしょう"],["。"]]},{"verse":6,"text":"また、戦争のことや、戦争のうわさを聞くでしょうが、気をつけて、あわてないようにしなさい。これらは必ず起こることです。しかし、終わりが来たのではありません。","tok":[["また"],["、"],["戦争","せんそう"],["の"],["こと"],["や"],["、"],["戦争","せんそう"],["の"],["うわさ"],["を"],["聞くでしょう","きくでしょう"],["が"],["、"],["気","き"],["を"],["つけて"],["、"],["あわてない"],["よう"],["に"],["し"],["なさい"],["。"],["これ"],["ら"],["は"],["必ず","かならず"],["起こる","おこる"],["こと"],["です"],["。"],["しかし"],["、"],["終わり","おわり"],["が"],["来た","きた"],["ので"],["は"],["ありません"],["。"]]},{"verse":7,"text":"民族は民族に、国は国に敵対して立ち上がり、方々にききんと地震が起こります。","tok":[["民族","みんぞく"],["は"],["民族","みんぞく"],["に"],["、"],["国","くに"],["は"],["国","くに"],["に"],["敵対","てきたい"],["して"],["立ち上がり","たちあがり"],["、"],["方々","かたがた"],["に"],["ききん"],["と"],["地震","じしん"],["が"],["起こります","おこります"],["。"]]},{"verse":8,"text":"しかし、そのようなことはみな、産みの苦しみの初めなのです。","tok":[["しかし"],["、"],["その"],["よう"],["な"],["こと"],["は"],["みな"],["、"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["の"],["初め","はじめ"],["な"],["の"],["です"],["。"]]},{"verse":9,"text":"そのとき、人々は、あなたがたを苦しいめに会わせ、殺します。また、わたしの名のために、あなたがたはすべての国の人々に憎まれます。","tok":[["その"],["とき"],["、"],["人々","ひとびと"],["は"],["、"],["あなた"],["がた"],["を"],["苦しい","くるしい"],["め"],["に"],["会わせ","あわせ"],["、"],["殺します","ころします"],["。"],["また"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["は"],["すべて"],["の"],["国","くに"],["の"],["人々","ひとびと"],["に"],["憎まれます","にくまれます"],["。"]]},{"verse":10,"text":"また、そのときは、人々が大ぜいつまずき、互いに裏切り、憎み合います。","tok":[["また"],["、"],["その"],["とき"],["は"],["、"],["人々","ひとびと"],["が"],["大ぜい","おおぜい"],["つまずき"],["、"],["互い","たがい"],["に"],["裏切り","うらぎり"],["、"],["憎み合います","にくみあいます"],["。"]]},{"verse":11,"text":"また、にせ預言者が多く起こって、多くの人々を惑わします。","tok":[["また"],["、"],["にせ"],["預言者","よげんしゃ"],["が"],["多く","おおく"],["起こって","おこって"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["を"],["惑わします","まどわします"],["。"]]},{"verse":12,"text":"不法がはびこるので、多くの人たちの愛は冷たくなります。","tok":[["不法","ふほう"],["が"],["はびこる"],["ので"],["、"],["多く","おおく"],["の"],["人","ひと"],["たち"],["の"],["愛","あい"],["は"],["冷たく","つめたく"],["なります"],["。"]]},{"verse":13,"text":"しかし、最後まで耐え忍ぶ者は救われます。","tok":[["しかし"],["、"],["最後","さいご"],["まで"],["耐え忍ぶ","たえしのぶ"],["者","もの"],["は"],["救われます","すくわれます"],["。"]]},{"verse":14,
[{"verse":1,"text":"そのころ、パリサイ人や律法学者たちが、エルサレムからイエスのところに来て、言った。","tok":[["その"],["ころ"],["、"],["パリサイ"],["人","にん"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["、"],["エルサレム"],["から"],["イエス"],["の"],["ところ"],["に"],["来て","きて"],["、"],["言った","いった"],["。"]]},{"verse":2,"text":"「あなたのお弟子たちは、なぜ長老たちの言い伝えを犯すのですか。パンを食べるときに手を洗っていないではありませんか。」","tok":[["「"],["あなた"],["の"],["お弟子","おでし"],["たち"],["は"],["、"],["なぜ"],["長老","ちょうろう"],["たち"],["の"],["言い伝え","いいつたえ"],["を"],["犯す","おかす"],["の"],["です"],["か"],["。"],["パン"],["を"],["食べる","たべる"],["とき"],["に"],["手","て"],["を"],["洗って","あらって"],["いないで"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":3,"text":"そこで、イエスは彼らに答えて言われた。「なぜ、あなたがたも、自分たちの言い伝えのために神の戒めを犯すのですか。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["なぜ"],["、"],["あなた"],["がた"],["も"],["、"],["自分","じぶん"],["たち"],["の"],["言い伝え","いいつたえ"],["の"],["ため"],["に"],["神","かみ"],["の"],["戒め","いましめ"],["を"],["犯す","おかす"],["の"],["です"],["か"],["。"]]},{"verse":4,"text":"神は『あなたの父と母を敬え』、また『父や母をののしる者は死刑に処せられる』と言われたのです。","tok":[["神","かみ"],["は"],["『"],["あなた"],["の"],["父","ちち"],["と"],["母","はは"],["を"],["敬え","うやまえ"],["』"],["、"],["また"],["『"],["父","ちち"],["や"],["母","はは"],["を"],["ののしる"],["者","もの"],["は"],["死刑","しけい"],["に"],["処せられる","しょせられる"],["』"],["と"],["言われた","いわれた"],["の"],["です"],["。"]]},{"verse":5,"text":"それなのに、あなたがたは、『だれでも、父や母に向かって、私からあなたのために差し上げられる物は、供え物になりましたと言う者は、","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["『"],["だれ"],["で"],["も"],["、"],["父","ちち"],["や"],["母","はは"],["に"],["向かって","むかって"],["、"],["私","わたくし"],["から"],["あなた"],["の"],["ため"],["に"],["差し上げられる","さしあげられる"],["物","もの"],["は"],["、"],["供え物","そなえもの"],["に"],["なりました"],["と"],["言う","いう"],["者","もの"],["は"],["、"]]},{"verse":6,"text":"その物をもって父や母を尊んではならない』と言っています。こうしてあなたがたは、自分たちの言い伝えのために、神のことばを無にしてしまいました。","tok":[["その"],["物","もの"],["を"],["もって"],["父","ちち"],["や"],["母","はは"],["を"],["尊んで","とうとんで"],["は"],["ならない"],["』"],["と"],["言って","いって"],["います"],["。"],["こう"],["して"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["言い伝え","いいつたえ"],["の"],["ため"],["に"],["、"],["神","かみ"],["の"],["ことば"],["を"],["無","む"],["に"],["して"],["しまいました"],["。"]]},{"verse":7,"text":"偽善者たち。イザヤはあなたがたについて預言しているが、まさにそのとおりです。","tok":[["偽善者","ぎぜんしゃ"],["たち"],["。"],["イザヤ"],["は"],["あなた"],["がた"],["について"],["預言","よげん"],["して"],["いる"],["が"],["、"],["まさに"],["その"],["とおり"],["です"],["。"]]},{"verse":8,"text":"『この民は、口先ではわたしを敬うが、その心は、わたしから遠く離れている。","tok":[["『"],["この"],["民","みん"],["は"],["、"],["口先","くちさき"],["で"],["は"],["わたし"],["を"],["敬う","うやまう"],["が"],["、"],["その"],["心","こころ"],["は"],["、"],["わたし"],["から"],["遠く","とおく"],["離れて","はなれて"],["いる"],["。"]]},{"verse":9,"text":"彼らが、わたしを拝んでも、むだなことである。／人間の教えを、教えとして教えるだけだから。』」","tok":[["彼","かれ"],["ら"],["が"],["、"],["わたし"],["を"],["拝んで","おがんで"],["も"],["、"],["むだ"],["な"],["こと"],["で"],["ある"],["。"],["／"],["人間","にんげん"],["の"],["教え","おしえ"],["を"],["、"],["教え","おしえ"],["として"],["教える","おしえる"],["だけ"],["だ"],["から"],["。"],["』"],["」"]]},{"verse":10,"text":"イエスは群衆を呼び寄せて言われた。「聞いて悟りなさい。","tok":[["イエス"],["は"],["群衆","ぐんしゅう"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["。"],["「"],["聞いて","きいて"],["悟り","さとり"],["なさい"],["。"]]},{"verse":11,"text":"口に入る物は人を汚しません。しかし、口から出るもの、これが人を汚します。」","tok":[["口","くち"],["に"],["入る","はいる"],["物","もの"],["は"],["人","ひと"],["を"],["汚しません","よごしません"],["。"],["しかし"],["、"],["口","くち"],["から"],["出る","でる"],["もの"],["、"],["これ"],["が"],["人","ひと"],["を"],["汚します","よごします"],["。"],["」"]]},{"verse":12,"text":"そのとき、弟子たちが、近寄って来て、イエスに言った。「パリサイ人が、みことばを聞いて、腹を立てたのをご存じですか。」","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["、"],["近寄って","ちかよって"],["来て","きて"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["パリサイ"],["人","にん"],["が"],["、"],["みことば"],["を"],["聞いて","きいて"],["、"],["腹","はら"],["を"],["立てた","たてた"],["の"],["を"],["ご存じ","ごぞんじ"],["です"],["か"],["。"],["」"]]},{"verse":13,"text":"しかし、イエスは答えて言われた。「わたしの天の父がお植えにならなかった木は、みな根こそぎにされます。","tok":[["しかし"],["、"],["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["わたし"],["の"],["天","てん"],["の"],["父","ちち"],["が"],["お植え","おうえ"],["に"],["ならなかった"],["木","き"],["は"],["、"],["みな"],["根こそぎ","ねこそぎ"],["に"],["されます"],["。"]]},{"verse":14,"text":"彼らのことは放っておきなさい。彼らは盲人を手引きする盲人です。もし、盲人が盲人を手引きするなら、ふたりとも穴に落ち込むのです。」","tok":[["彼","かれ"],["ら"],["の"],["こと"],["は"],["放って","ほうって"],["おき"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["盲人","もうじん"],["を"],["手引き","てびき"],["する"],["盲人","もうじん"],["です"],["。"],["もし"],["、"],["盲人","もうじん"],["が"],["盲人","もうじん"],["を"],["手引き","てびき"],["するなら"],["、"],["ふたり"],["とも"],["穴","あな"],["に"],["落ち込む","おちこむ"],["の"],["です"],["。"],["」"]]},{"verse":15,"text":"そこで、ペテロは、イエスに答えて言った。「私たちに、そのたとえを説明してください。」","tok":[["そこ"],["で"],["、"],["ペテロ"],["は"],["、"],["イエス"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["に"],["、"],["その"],["たとえ"],["を"],["説明","せつめい"],["して"],["ください"],["。"],["」"]]},{"verse":16,"text":"イエスは言われた。「あなたがたも、まだわからないのですか。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["も"],["、"],["まだ"],["わからない"],["の"],["です"],["か"],["。"]]},{"verse":17,"text":"口に入る物はみな、腹に入り、かわやに捨てられることを知らないのですか。","tok":[["口","くち"],["に"],["入る","はいる"],["物","もの"],["は"],["みな"],["、"],["腹","はら"],["に"],["入り","はいり"],["、"],["かわや"],["に"],["捨てられる","すてられる"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"]]},{"verse":18,"text":"しかし、口から出るものは、心から出て来ます。それは人を汚します。","tok":[["しかし"],["、"],["口","くち"],["から"],["出る","でる"],["もの"],["は"],["、"],["心","こころ"],["から"],["出て","でて"],["来ます","きます"],["。"],["それ"],["は"],["人","ひと"],["を"],["汚します","よごします"],["。"]]},{"verse":19,"text":"悪い考え、殺人、姦淫、不品行、盗み、偽証、ののしりは心から出て来るからです。","tok":[["悪い","わるい"],["考え","かんがえ"],["、"],["殺人","さつじん"],["、"],["姦淫","かんいん"],["、"],["不品行","ふひんこう"],["、"],["盗み","ぬすみ"],["、"],["偽証","ぎしょう"],["、"],["ののしり"],["は"],["心","こころ"],["から"],["出て","でて"],["来る","くる"],["から"],["です"],["。"]]},{"verse":20,"text":"これらは、人を汚すものです。しかし、洗わない手で食べることは人を汚しません。」","tok":[["これ"],["ら"],["は"],["、"],["人","ひと"],["を"],["汚す","けがす"],["もの"],["です"],["。"],["しかし"],["、"],["洗わない","あらわない"],["手","て"],["で"],["食べる","たべる"],["こと"],["は"],["人","ひと"],["を"],["汚しません","よごしません"],["。"],["」"]]},{"verse":21,"text":"それから、イエスはそこを去って、ツロとシドンの地方に立ちのかれた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["そこ"],["を"],["去って","さって"],["、"],["ツロ"],["と"],["
[{"verse":1,"text":"それから六日たって、イエスは、ペテロとヤコブとその兄弟ヨハネだけを連れて、高い山に導いて行かれた。","tok":[["それ"],["から"],["六日","むいか"],["たって"],["、"],["イエス"],["は"],["、"],["ペテロ"],["と"],["ヤコブ"],["と"],["その"],["兄弟","きょうだい"],["ヨハネ"],["だけ"],["を"],["連れて","つれて"],["、"],["高い","たかい"],["山","やま"],["に"],["導いて","みちびいて"],["行かれた","いかれた"],["。"]]},{"verse":2,"text":"そして彼らの目の前で、御姿が変わり、御顔は太陽のように輝き、御衣は光のように白くなった。","tok":[["そして"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["御姿","おすがた"],["が"],["変わり","かわり"],["、"],["御顔","おかお"],["は"],["太陽","たいよう"],["の"],["よう"],["に"],["輝き","かがやき"],["、"],["御衣","ぎょい"],["は"],["光","ひかり"],["の"],["よう"],["に"],["白く","しろく"],["なった"],["。"]]},{"verse":3,"text":"しかも、モーセとエリヤが現れてイエスと話し合っているではないか。","tok":[["しかも"],["、"],["モーセ"],["と"],["エリヤ"],["が"],["現れて","あらわれて"],["イエス"],["と"],["話し合って","はなしあって"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":4,"text":"すると、ペテロが口出ししてイエスに言った。「先生。私たちがここにいることは、すばらしいことです。もし、およろしければ、私が、ここに三つの幕屋を造ります。あなたのために一つ、モーセのために一つ、エリヤのために一つ。」","tok":[["する"],["と"],["、"],["ペテロ"],["が"],["口出し","くちだし"],["して"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["私たち","わたしたち"],["が"],["ここ"],["に"],["いる"],["こと"],["は"],["、"],["すばらしい"],["こと"],["です"],["。"],["もし"],["、"],["およろしければ"],["、"],["私","わたくし"],["が"],["、"],["ここ"],["に"],["三","みっ"],["つ"],["の"],["幕屋","まくや"],["を"],["造ります","つくります"],["。"],["あなた"],["の"],["ため"],["に"],["一","ひと"],["つ"],["、"],["モーセ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["、"],["エリヤ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["。"],["」"]]},{"verse":5,"text":"彼がまだ話している間に、見よ、光り輝く雲がその人々を包み、そして、雲の中から、「これは、わたしの愛する子、わたしはこれを喜ぶ。彼の言うことを聞きなさい」と言う声がした。","tok":[["彼","かれ"],["が"],["まだ"],["話して","はなして"],["いる"],["間","あいだ"],["に"],["、"],["見よ","みよ"],["、"],["光り輝く","ひかりかがやく"],["雲","くも"],["が"],["その"],["人々","ひとびと"],["を"],["包み","つつみ"],["、"],["そして"],["、"],["雲","くも"],["の"],["中","なか"],["から"],["、"],["「"],["これ"],["は"],["、"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["、"],["わたし"],["は"],["これ"],["を"],["喜ぶ","よろこぶ"],["。"],["彼","かれ"],["の"],["言う","いう"],["こと"],["を"],["聞き","きき"],["なさい"],["」"],["と"],["言う","いう"],["声","こえ"],["が"],["した"],["。"]]},{"verse":6,"text":"弟子たちは、この声を聞くと、ひれ伏して非常にこわがった。","tok":[["弟子","でし"],["たち"],["は"],["、"],["この"],["声","こえ"],["を"],["聞く","きく"],["と"],["、"],["ひれ伏して","ひれふして"],["非常","ひじょう"],["に"],["こわ"],["がっ"],["た"],["。"]]},{"verse":7,"text":"すると、イエスが来られて、彼らに手を触れ、「起きなさい。こわがることはない」と言われた。","tok":[["する"],["と"],["、"],["イエス"],["が"],["来られて","こられて"],["、"],["彼","かれ"],["ら"],["に"],["手","て"],["を"],["触れ","ふれ"],["、"],["「"],["起き","おき"],["なさい"],["。"],["こわ"],["がる"],["こと"],["は"],["ない"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"それで、彼らが目を上げて見ると、だれもいなくて、ただイエスおひとりだけであった。","tok":[["それ"],["で"],["、"],["彼","かれ"],["ら"],["が"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["だれ"],["も"],["いなくて"],["、"],["ただ"],["イエス"],["おひとり"],["だけ"],["で"],["あった"],["。"]]},{"verse":9,"text":"彼らが山を降りるとき、イエスは彼らに、「人の子が死人の中からよみがえるときまでは、いま見た幻をだれにも話してはならない」と命じられた。","tok":[["彼","かれ"],["ら"],["が"],["山","やま"],["を"],["降りる","おりる"],["とき"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえる"],["とき"],["まで"],["は"],["、"],["いま"],["見た","みた"],["幻","まぼろし"],["を"],["だれ"],["に"],["も"],["話して","はなして"],["は"],["ならない"],["」"],["と"],["命じられた","めいじられた"],["。"]]},{"verse":10,"text":"そこで、弟子たちは、イエスに尋ねて言った。「すると、律法学者たちが、まずエリヤが来るはずだと言っているのは、どうしてでしょうか。」","tok":[["そこ"],["で"],["、"],["弟子","でし"],["たち"],["は"],["、"],["イエス"],["に"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["する"],["と"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["、"],["まず"],["エリヤ"],["が"],["来る","くる"],["はず"],["だ"],["と"],["言って","いって"],["いる"],["の"],["は"],["、"],["どう"],["して"],["でしょう"],["か"],["。"],["」"]]},{"verse":11,"text":"イエスは答えて言われた。「エリヤが来て、すべてのことを立て直すのです。","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["エリヤ"],["が"],["来て","きて"],["、"],["すべて"],["の"],["こと"],["を"],["立て直す","たてなおす"],["の"],["です"],["。"]]},{"verse":12,"text":"しかし、わたしは言います。エリヤはもうすでに来たのです。ところが彼らはエリヤを認めようとせず、彼に対して好き勝手なことをしたのです。人の子もまた、彼らから同じように苦しめられようとしています。」","tok":[["しかし"],["、"],["わたし"],["は"],["言います","いいます"],["。"],["エリヤ"],["は"],["もう"],["すでに"],["来た","きた"],["の"],["です"],["。"],["ところ"],["が"],["彼","かれ"],["ら"],["は"],["エリヤ"],["を"],["認めよう","みとめよう"],["と"],["せず"],["、"],["彼","かれ"],["に対して","にたいして"],["好き勝手","すきかって"],["な"],["こと"],["を"],["した"],["の"],["です"],["。"],["人","ひと"],["の"],["子","こ"],["も"],["また"],["、"],["彼","かれ"],["ら"],["から"],["同じ","おなじ"],["よう"],["に"],["苦しめられよう","くるしめられよう"],["として"],["います"],["。"],["」"]]},{"verse":13,"text":"そのとき、弟子たちは、イエスがバプテスマのヨハネのことを言われたのだと気づいた。","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["は"],["、"],["イエス"],["が"],["バプテスマ"],["の"],["ヨハネ"],["の"],["こと"],["を"],["言われた","いわれた"],["の"],["だ"],["と"],["気づいた","きづいた"],["。"]]},{"verse":14,"text":"彼らが群衆のところに来たとき、ひとりの人がイエスのそば近くに来て、御前にひざまずいて言った。","tok":[["彼","かれ"],["ら"],["が"],["群衆","ぐんしゅう"],["の"],["ところ"],["に"],["来た","きた"],["とき"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["イエス"],["の"],["そば"],["近く","ちかく"],["に"],["来て","きて"],["、"],["御前","ごぜん"],["に"],["ひざまずいて"],["言った","いった"],["。"]]},{"verse":15,"text":"「主よ。私の息子をあわれんでください。てんかんで、たいへん苦しんでおります。何度も何度も火の中に落ちたり、水の中に落ちたりいたします。","tok":[["「"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["息子","むすこ"],["を"],["あわれんで"],["ください"],["。"],["てんかん"],["で"],["、"],["たいへん"],["苦しんで","くるしんで"],["おります"],["。"],["何度","なんど"],["も"],["何度","なんど"],["も"],["火","ひ"],["の"],["中","なか"],["に"],["落ち","おち"],["たり"],["、"],["水","みず"],["の"],["中","なか"],["に"],["落ち","おち"],["たり"],["いたします"],["。"]]},{"verse":16,"text":"そこで、その子をお弟子たちのところに連れて来たのですが、直すことができませんでした。」","tok":[["そこ"],["で"],["、"],["その"],["子","こ"],["を"],["お"],["弟子","でし"],["たち"],["の"],["ところ"],["に"],["連れて","つれて"],["来た","きた"],["の"],["です"],["が"],["、"],["直す","なおす"],["こと"],["が"],["できませんでした"],["。"],["」"]]},{"verse":17,"text":"イエスは答えて言われた。「ああ、不信仰な、曲がった今の世だ。いつまであなたがたといっしょにいなければならないのでしょう。いつまであなたがたにがまんしていなければならないのでしょう。その子をわたしのところに連れて来なさい。」","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["ああ"],["、"],["不","ふ"],["信仰","しんこう"],["な"],["、"],["曲がった","まがった"],["今","いま"],["の"],["世","よ"],["だ"],["。"],["いつ"],["まで"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["いなければ"],["ならない"],["の"],["でしょう"],["。"],["いつ"],["まで"],["あなた"],["がた"],["に"],["がまん"],["して"],["いなければ"],["ならない"],["の"],["でしょう"],["。"],["その"],["子","こ"],["を"],["わたし"],["の"],["ところ"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"],["」"]]},{"verse":18,"text":"そして、イエスがその子をおしかりになると、悪霊は彼から出て行き、その子はその時から直った。","tok":[["そして"],["、"],["イエス"],["が"],["その"],["子","こ"],["を"],["おしかり"],["に"],["なる"],["と"],["、"],["悪霊","あくりょう"],["は"],["彼","かれ"],["から"],["出て","でて"],["行き","いき"],["、"],["その"],["子","こ"],["は"],["その"],["時","とき"],["から"],["直った","なおった"],["。"]]},{"verse":19,"text":"そのとき、弟子たちはそっとイエスのもとに来て、言った。「なぜ、私たちには悪霊を追い出せなかったのですか。」","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["は"],["そっと"],["イエス"],["の"],["もと"],["に"],["来て","きて"],["、"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["私たち","わたしたち"],["に"],["は"],["悪霊","あくりょう"],["を"],["追い出せなかった","おいだせなかった"],["の"],["です"],["か"],["。"],["」"]]},{"verse":20,"text":"イエスは言われた。「あなたがたの信仰が薄いからです。まことに、あなたがたに告げます。もし、からし種ほどの信仰があったら、この山に、『ここからあそこに移れ』と言えば移るのです。どんなことでも、あなたがたにできないことはありません。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["の"],["信仰","しんこう"],["が"],["薄い","うすい"],["から"],["です"],["。"],["まこと"],["に"],["、"],["あなた"],["がた"],["に"],["告げます","つげます"],["。"],["もし"],["、"],["からし"],["種","しゅ"],["ほど"],["の"],["信仰","しんこう"],["が"],["あったら"],["、"],["この"],["山","やま"],["に"],["、"],["『"],["ここ"],["から"],["あそこ"],["に"],["移れ","うつれ"],["』"],["と"],["言えば","いえば"],["移る","うつる"],["の"],["です"],["。"],["どんな"],["こと"],["で"],["も"],["、"],["あなた"],["がた"],["に"],["できない"],["こと"],["は"],["ありません"],["。"]]},{"verse":21,"text":"〔ただし、この種のものは、祈りと断食によらなければ出て行きません。〕」","tok":[["〔"],["ただし"],["、"],["この"],["種","しゅ"],["の"],["もの"],["は"],["、"],["祈り","いのり"],["と"],["断食","だんじき"],["に"],["よらなければ"],["出て","でて"],["行きません","いきません"],["。"],["〕"],["」"]]},{"verse":22,"text":"彼らがガリラヤに集まっていたとき、イエスは彼らに言われた。「人の子は、いまに人々の手に渡されます。","tok":[["彼","かれ"],["ら"],["が"],["ガリラヤ"],["に"],["集まって","あつまって"],["いた"],["とき"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["いま"],["に"],["人々","ひとびと"],["の"],["手","て"],["に"],["渡されます","わたされます"],["。"]]},{"verse":23,"text":"そして彼らに殺されるが、三日目によみがえります。」すると、彼らは非常に悲しんだ。","tok":[["そして"],["彼","かれ"],["ら"],["に"],["殺される","ころされる"],["が"],["、"],["三日目","みっかめ"],["に"],["よみがえります"],["。"],["」"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["非常","ひじょう"],["に"],["悲しんだ","かなしんだ"],["。"]]},{"verse":24,"text":"また、彼らがカペナウムに来たとき、宮の納入金を集める人たちが、ペテロのところに来て言った。「あなたがたの先生は、宮の納入金を納めないのですか。」","tok":[["また"],["、"],["彼","かれ"],["ら"],["が"],["カペナウム"],["に"],["来た","きた"],["とき"],["、"],["宮","みや"],["の"],["納入金","のうにゅうきん"],["を"],["集める","あつめる"],["人","ひと"],["たち"],["が"],["、"],["ペテロ"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["先生","せんせい"],["は"],["、"],["宮","みや"],["の"],["納入金","のうにゅうきん"],["を"],["納めない","おさめない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":25,"text":"彼は「納めます」と言って、家に入ると、先にイエスのほうからこう言い出された。「シモン。どう思いますか。世の王たちはだれから税や貢を取り立てますか。自分の子どもたちからですか、それともほかの人たちからですか。」","tok":[["彼","かれ"],["は"],["「"],["納めます","おさめます"],["」"],["と"],["言って","いって"],["、"],["家","いえ"],["に"],["入る","はいる"],["と"],["、"],["先","さき"],["に"],["イエス"],["の"],["ほう"],["から"],["こう"],["言い","いい"],["出された","だされた"],["。"],["「"],["シモン"],["。"],["どう"],["思います","おもいます"],["か"],["。"],["世","よ"],["の"],["王","おう"],["たち"],["は"],["だれ"],["から"],["税","ぜい"],["や"],["貢","みつぎ"],["を"],["取り立てます","とりたてます"],["か"],["。"],["自分","じぶん"],["の"],["子ども","こども"],["たち"],["から"],["です"],["か"],["、"],["それ"],["と"],["も"],["ほか"],["の"],["人","ひと"],["たち"],["から"],["です"],["か"],["。"],["」"]]},{"verse":26,"text":"ペテロが「ほかの人たちからです」と言うと、イエスは言われた。「では、子どもたちにはその義務がないのです。","tok":[["ペテロ"],["が"],["「"],["ほか"],["の"],["人","ひと"],["たち"],["から"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["で"],["は"],["、"],["子ども","こども"],["たち"],["に"],["は"],["その"],["義務","ぎむ"],["が"],["ない"],["の"],["です"],["。"]]},{"verse":27,"text":"しかし、彼らにつまずきを与えないために、湖に行って釣りをして、最初に釣れた魚を取りなさい。その口をあけるとスタテル一枚が見つかるから、それを取って、わたしとあなたとの分として納めなさい。」","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["に"],["つまずき"],["を"],["与えない","あたえない"],["ため"],["に"],["、"],["湖","みずうみ"],["に"],["行って","いって"],["釣り","つり"],["を"],["して"],["、"],["最初","さいしょ"],["に"],["釣れた","つれた"],["魚","さかな"],["を"],["取り","とり"],["なさい"],["。"],["その"],["口","くち"],["を"],["あける"],["と"],["スタテル"],["一枚","いちまい"],["が"],["見つかる","みつかる"],["から"],["、"],["それ"],["を"],["取って","とって"],["、"],["わたし"],["と"],["あなた"],["と"],["の"],["分","ぶん"],["として"],["納め","おさめ"],["なさい"],["。"],["」"]]}]
[{"verse":1,"text":"主はヨシュアに告げて仰せられた。","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「イスラエル人に告げて言え。／わたしがモーセを通してあなたがたに告げておいた、のがれの町をあなたがたのために定め、","tok":[["「"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["／"],["わたし"],["が"],["モーセ"],["を"],["通して","とおして"],["あなた"],["がた"],["に"],["告げて","つげて"],["おいた"],["、"],["のがれ"],["の"],["町","まち"],["を"],["あなた"],["がた"],["の"],["ため"],["に"],["定め","さだめ"],["、"]]},{"verse":3,"text":"あやまって、知らずに人を殺した殺人者が、そこに逃げ込むことのできるようにしなさい。その町々は、あなたがたが血の復讐をする者からのがれる場所となる。","tok":[["あやまって"],["、"],["知らず","しらず"],["に"],["人","ひと"],["を"],["殺した","ころした"],["殺人者","さつじんしゃ"],["が"],["、"],["そこ"],["に"],["逃げ込む","にげこむ"],["こと"],["の"],["できる"],["よう"],["に"],["し"],["なさい"],["。"],["その"],["町々","まちまち"],["は"],["、"],["あなた"],["がた"],["が"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["から"],["のがれる"],["場所","ばしょ"],["と"],["なる"],["。"]]},{"verse":4,"text":"人が、これらの町の一つに逃げ込む場合、その者は、その町の門の入口に立ち、その町の長老たちに聞こえるように、そのわけを述べなさい。彼らは、自分たちの町に彼を受け入れ、彼に一つの場所を与え、彼は、彼らとともに住む。","tok":[["人","ひと"],["が"],["、"],["これ"],["ら"],["の"],["町","まち"],["の"],["一","ひと"],["つ"],["に"],["逃げ込む","にげこむ"],["場合","ばあい"],["、"],["その"],["者","もの"],["は"],["、"],["その"],["町","まち"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["立ち","たち"],["、"],["その"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["に"],["聞こえる","きこえる"],["よう"],["に"],["、"],["その"],["わけ"],["を"],["述べ","のべ"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["町","まち"],["に"],["彼","かれ"],["を"],["受け入れ","うけいれ"],["、"],["彼","かれ"],["に"],["一","ひと"],["つ"],["の"],["場所","ばしょ"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["は"],["、"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["住む","すむ"],["。"]]},{"verse":5,"text":"たとい、血の復讐をする者がその者を追って来ても、殺人者をその手に渡してはならない。彼は知らずに隣人を打ち殺したのであって、以前からその人を憎んでいたのではないからである。","tok":[["たとい"],["、"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["が"],["その"],["者","もの"],["を"],["追って","おって"],["来て","きて"],["も"],["、"],["殺人者","さつじんしゃ"],["を"],["その"],["手","て"],["に"],["渡して","わたして"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["知らず","しらず"],["に"],["隣人","りんじん"],["を"],["打ち殺した","うちころした"],["ので"],["あって"],["、"],["以前","いぜん"],["から"],["その"],["人","ひと"],["を"],["憎んで","にくんで"],["いた"],["ので"],["は"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"その者は会衆の前に立ってさばきを受けるまで、あるいは、その時の大祭司が死ぬまで、その町に住まなければならない。それから後、殺人者は、自分の町、自分の家、自分が逃げて来たその町に帰って行くことができる。」","tok":[["その"],["者","もの"],["は"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立って","たって"],["さばき"],["を"],["受ける","うける"],["まで"],["、"],["あるいは"],["、"],["その"],["時","とき"],["の"],["大","だい"],["祭司","さいし"],["が"],["死ぬ","しぬ"],["まで"],["、"],["その"],["町","まち"],["に"],["住まなければ","すまなければ"],["ならない"],["。"],["それ"],["から"],["後","あと"],["、"],["殺人者","さつじんしゃ"],["は"],["、"],["自分","じぶん"],["の"],["町","まち"],["、"],["自分","じぶん"],["の"],["家","いえ"],["、"],["自分","じぶん"],["が"],["逃げて","にげて"],["来た","きた"],["その"],["町","まち"],["に"],["帰って","かえって"],["行く","いく"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":7,"text":"それで彼らは、ナフタリの山地にあるガリラヤのケデシュと、エフライムの山地にあるシェケムと、ユダの山地にあるキルヤテ・アルバ、すなわちヘブロンとを聖別した。","tok":[["それ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["ナフタリ"],["の"],["山地","さんち"],["に"],["ある"],["ガリラヤ"],["の"],["ケデシュ"],["と"],["、"],["エフライム"],["の"],["山地","さんち"],["に"],["ある"],["シェケム"],["と"],["、"],["ユダ"],["の"],["山地","さんち"],["に"],["ある"],["キルヤテ"],["・"],["アルバ"],["、"],["すなわち"],["ヘブロン"],["と"],["を"],["聖別","せいべつ"],["した"],["。"]]},{"verse":8,"text":"エリコのあたりのヨルダン川の向こう側、東のほうでは、ルベン部族から、高地の荒野にあるベツェルを、ガド部族から、ギルアデのラモテを、マナセ部族から、バシャンのゴランをこれに当てた。","tok":[["エリコ"],["の"],["あたり"],["の"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["、"],["東","ひがし"],["の"],["ほう"],["で"],["は"],["、"],["ルベン"],["部族","ぶぞく"],["から"],["、"],["高地","こうち"],["の"],["荒野","あらの"],["に"],["ある"],["ベツェル"],["を"],["、"],["ガド"],["部族","ぶぞく"],["から"],["、"],["ギルアデ"],["の"],["ラモテ"],["を"],["、"],["マナセ"],["部族","ぶぞく"],["から"],["、"],["バシャン"],["の"],["ゴラン"],["を"],["これ"],["に"],["当てた","あてた"],["。"]]},{"verse":9,"text":"これらは、すべてのイスラエル人、および、彼らの間の在留異国人のために設けられた町々で、すべて、あやまって人を殺した者が、そこに逃げ込むためである。会衆の前に立たないうちに、血の復讐をする者の手によって死ぬことがないためである。","tok":[["これ"],["ら"],["は"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["、"],["および"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["の"],["在留","ざいりゅう"],["異国人","いこくにん"],["の"],["ため"],["に"],["設けられた","もうけられた"],["町々","まちまち"],["で"],["、"],["すべて"],["、"],["あやまって"],["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["が"],["、"],["そこ"],["に"],["逃げ込む","にげこむ"],["ため"],["で"],["ある"],["。"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立たない","たたない"],["うち"],["に"],["、"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["の"],["手","て"],["によって"],["死ぬ","しぬ"],["こと"],["が"],["ない"],["ため"],["で"],["ある"],["。"]]}]
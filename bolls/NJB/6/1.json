[{"verse":1,"text":"さて、主のしもべモーセが死んで後、主はモーセの従者、ヌンの子ヨシュアに告げて仰せられた。","tok":[["さて"],["、"],["主","ぬし"],["の"],["しもべ"],["モーセ"],["が"],["死んで","しんで"],["後","あと"],["、"],["主","ぬし"],["は"],["モーセ"],["の"],["従者","じゅうしゃ"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「わたしのしもべモーセは死んだ。今、あなたとこのすべての民は立って、このヨルダン川を渡り、わたしがイスラエルの人々に与えようとしている地に行け。","tok":[["「"],["わたし"],["の"],["しもべ"],["モーセ"],["は"],["死んだ","しんだ"],["。"],["今","いま"],["、"],["あなた"],["と"],["この"],["すべて"],["の"],["民","たみ"],["は"],["立って","たって"],["、"],["この"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["、"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与えよう","あたえよう"],["として"],["いる"],["地","ち"],["に"],["行け","いけ"],["。"]]},{"verse":3,"text":"あなたがたが足の裏で踏む所はことごとく、わたしがモーセに約束したとおり、あなたがたに与えている。","tok":[["あなた"],["がた"],["が"],["足","あし"],["の"],["裏","うら"],["で"],["踏む","ふむ"],["所","ところ"],["は"],["ことごとく"],["、"],["わたし"],["が"],["モーセ"],["に"],["約束","やくそく"],["した"],["とおり"],["、"],["あなた"],["がた"],["に"],["与えて","あたえて"],["いる"],["。"]]},{"verse":4,"text":"あなたがたの領土は、この荒野とあのレバノンから、大河ユーフラテス、ヘテ人の全土および日の入るほうの大海に至るまでである。","tok":[["あなた"],["がた"],["の"],["領土","りょうど"],["は"],["、"],["この"],["荒野","こうや"],["と"],["あの"],["レバノン"],["から"],["、"],["大河","たいが"],["ユーフラテス"],["、"],["ヘテ人","へてにん"],["の"],["全土","ぜんど"],["および"],["日","ひ"],["の"],["入る","はいる"],["ほう"],["の"],["大海","たいかい"],["に"],["至る","いたる"],["まで"],["で"],["ある"],["。"]]},{"verse":5,"text":"あなたの一生の間、だれひとりとしてあなたの前に立ちはだかる者はいない。わたしは、モーセとともにいたように、あなたとともにいよう。わたしはあなたを見放さず、あなたを見捨てない。","tok":[["あなた"],["の"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["だれ"],["ひとり"],["として"],["あなた"],["の"],["前","まえ"],["に"],["立ちはだかる","たちはだかる"],["者","もの"],["は"],["いない"],["。"],["わたし"],["は"],["、"],["モーセ"],["と"],["とも"],["に"],["いた"],["よう"],["に"],["、"],["あなた"],["と"],["とも"],["に"],["いよう"],["。"],["わたし"],["は"],["あなた"],["を"],["見放さず","みはなさず"],["、"],["あなた"],["を"],["見捨てない","みすてない"],["。"]]},{"verse":6,"text":"強くあれ。雄々しくあれ。わたしが彼らに与えるとその先祖たちに誓った地を、あなたは、この民に継がせなければならないからだ。","tok":[["強く","つよく"],["あれ"],["。"],["雄々しく","おおしく"],["あれ"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["と"],["その"],["先祖","せんぞ"],["たち"],["に"],["誓った","ちかった"],["地","ち"],["を"],["、"],["あなた"],["は"],["、"],["この"],["民","たみ"],["に"],["継がせなければ","つがせなければ"],["ならない"],["から"],["だ"],["。"]]},{"verse":7,"text":"ただ強く、雄々しくあって、わたしのしもべモーセがあなたに命じたすべての律法を守り行え。これを離れて右にも左にもそれてはならない。それは、あなたが行く所ではどこででも、あなたが栄えるためである。","tok":[["ただ"],["強く","つよく"],["、"],["雄々しく","おおしく"],["あって"],["、"],["わたし"],["の"],["しもべ"],["モーセ"],["が"],["あなた"],["に"],["命じた","めいじた"],["すべて"],["の"],["律法","りっぽう"],["を"],["守り","まもり"],["行え","おこなえ"],["。"],["これ"],["を"],["離れて","はなれて"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それ"],["て"],["は"],["ならない"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["行く","いく"],["所","ところ"],["で"],["は"],["どこ"],["で"],["で"],["も"],["、"],["あなた"],["が"],["栄える","さかえる"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"この律法の書を、あなたの口から離さず、昼も夜もそれを口ずさまなければならない。そのうちにしるされているすべてのことを守り行うためである。そうすれば、あなたのすることで繁栄し、また栄えることができるからである。","tok":[["この"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["、"],["あなた"],["の"],["口","くち"],["から"],["離さず","はなさず"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["それ"],["を"],["口ずさまなければ","くちずさまなければ"],["ならない"],["。"],["その"],["うち"],["に"],["しるされて"],["いる"],["すべて"],["の"],["こと"],["を"],["守り","まもり"],["行う","おこなう"],["ため"],["で"],["ある"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["する"],["こと"],["で"],["繁栄","はんえい"],["し"],["、"],["また"],["栄える","さかえる"],["こと"],["が"],["できる"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"わたしはあなたに命じたではないか。強くあれ。雄々しくあれ。恐れてはならない。おののいてはならない。あなたの神、主が、あなたの行く所どこにでも、あなたとともにあるからである。」","tok":[["わたし"],["は"],["あなた"],["に"],["命じたで","めいじたで"],["は"],["ない"],["か"],["。"],["強く","つよく"],["あれ"],["。"],["雄々しく","おおしく"],["あれ"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おののいて"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["の"],["行く","いく"],["所","ところ"],["どこ"],["に"],["で"],["も"],["、"],["あなた"],["と"],["とも"],["に"],["ある"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":10,"text":"そこで、ヨシュアは民のつかさたちに命じて言った。","tok":[["そこ"],["で"],["、"],["ヨシュア"],["は"],["民","みん"],["の"],["つかさ"],["たち"],["に"],["命じて","めいじて"],["言った","いった"],["。"]]},{"verse":11,"text":"「宿営の中を巡って、民に命じて、『糧食の準備をしなさい。三日のうちに、あなたがたはこのヨルダン川を渡って、あなたがたの神、主があなたがたに与えて所有させようとしておられる地を占領するために、進んで行こうとしているのだから』と言いなさい。」","tok":[["「"],["宿営","しゅくえい"],["の"],["中","なか"],["を"],["巡って","めぐって"],["、"],["民","みん"],["に"],["命じて","めいじて"],["、"],["『"],["糧食","りょうしょく"],["の"],["準備","じゅんび"],["を"],["し"],["なさい"],["。"],["三日","みっか"],["の"],["うち"],["に"],["、"],["あなた"],["がた"],["は"],["この"],["ヨルダン"],["川","かわ"],["を"],["渡って","わたって"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["に"],["与えて","あたえて"],["所有","しょゆう"],["させよう"],["として"],["おられる"],["地","ち"],["を"],["占領","せんりょう"],["する"],["ため"],["に"],["、"],["進んで","すすんで"],["行こう","いこう"],["として"],["いる"],["の"],["だ"],["から"],["』"],["と"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":12,"text":"ヨシュアは、ルベン人、ガド人、およびマナセの半部族に、こう言った。","tok":[["ヨシュア"],["は"],["、"],["ルベン人","るべんにん"],["、"],["ガド人","がどにん"],["、"],["および"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["、"],["こう"],["言った","いった"],["。"]]},{"verse":13,"text":"「主のしもべモーセがあなたがたに命じて、『あなたがたの神、主は、あなたがたに安住の地を与え、あなたがたにこの地を与える』と言ったことばを思い出しなさい。","tok":[["「"],["主","ぬし"],["の"],["しもべ"],["モーセ"],["が"],["あなた"],["がた"],["に"],["命じて","めいじて"],["、"],["『"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["に"],["安住","あんじゅう"],["の"],["地","ち"],["を"],["与え","あたえ"],["、"],["あなた"],["がた"],["に"],["この"],["地","ち"],["を"],["与える","あたえる"],["』"],["と"],["言った","いった"],["ことば"],["を"],["思い出し","おもいだし"],["なさい"],["。"]]},{"verse":14,"text":"あなたがたの妻子と家畜とは、モーセがあなたがたに与えたヨルダン川のこちら側の地に、とどまらなければならない。しかし、あなたがたのうちの勇士は、みな編隊を組んで、あなたがたの同族よりも先に渡って、彼らを助けなければならない。","tok":[["あなた"],["がた"],["の"],["妻子","さいし"],["と"],["家畜","かちく"],["と"],["は"],["、"],["モーセ"],["が"],["あなた"],["がた"],["に"],["与えた","あたえた"],["ヨルダン"],["川","かわ"],["の"],["こちら側","こちらがわ"],["の"],["地","ち"],["に"],["、"],["とどまらなければ"],["ならない"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["勇士","ゆうし"],["は"],["、"],["みな"],["編隊","へんたい"],["を"],["組んで","くんで"],["、"],["あなた"],["がた"],["の"],["同族","どうぞく"],["より"],["も"],["先","さき"],["に"],["渡って","わたって"],["、"],["彼","かれ"],["ら"],["を"],["助けなければ","たすけなければ"],["ならない"],["。"]]},{"verse":15,"text":"主が、あなたがたと同様、あなたがたの同族にも安住の地を与え、彼らもまた、あなたがたの神、主が与えようとしておられる地を所有するようになったなら、あなたがたは、主のしもべモーセがあなたがたに与えたヨルダン川のこちら側、日の上る方にある、あなたがたの所有地に帰って、それを所有することができる。」","tok":[["主","ぬし"],["が"],["、"],["あなた"],["がた"],["と"],["同様","どうよう"],["、"],["あなた"],["がた"],["の"],["同族","どうぞく"],["に"],["も"],["安住","あんじゅう"],["の"],["地","ち"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["ら"],["も"],["また"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えよう","あたえよう"],["として"],["おられる"],["地","ち"],["を"],["所有","しょゆう"],["する"],["よう"],["に"],["なったなら"],["、"],["あなた"],["がた"],["は"],["、"],["主","ぬし"],["の"],["しもべ"],["モーセ"],["が"],["あなた"],["がた"],["に"],["与えた","あたえた"],["ヨルダン"],["川","かわ"],["の"],["こちら側","こちらがわ"],["、"],["日","ひ"],["の"],["上る","のぼる"],["方","かた"],["に"],["ある"],["、"],["あなた"],["がた"],["の"],["所有地","しょゆうち"],["に"],["帰って","かえって"],["、"],["それ"],["を"],["所有","しょゆう"],["する"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":16,"text":"彼らはヨシュアに答えて言った。「あなたが私たちに命じたことは、何でも行います。また、あなたが遣わす所、どこへでもまいります。","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あなた"],["が"],["私たち","わたしたち"],["に"],["命じた","めいじた"],["こと"],["は"],["、"],["何","なん"],["で"],["も"],["行います","おこないます"],["。"],["また"],["、"],["あなた"],["が"],["遣わす","つかわす"],["所","ところ"],["、"],["どこ"],["へ"],["で"],["も"],["まいります"],["。"]]},{"verse":17,"text":"私たちは、モーセに聞き従ったように、あなたに聞き従います。ただ、あなたの神、主が、モーセとともにおられたように、あなたとともにおられますように。","tok":[["私たち","わたしたち"],["は"],["、"],["モーセ"],["に"],["聞き従った","ききしたがった"],["よう"],["に"],["、"],["あなた"],["に"],["聞き従います","ききしたがいます"],["。"],["ただ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["モーセ"],["と"],["とも"],["に"],["おられた"],["よう"],["に"],["、"],["あなた"],["と"],["とも"],["に"],["おられます"],["よう"],["に"],["。"]]},{"verse":18,"text":"あなたの命令に逆らい、あなたが私たちに命じるどんなことばにも聞き従わない者があれば、その者は殺されなければなりません。ただ強く、雄々しくあってください。」","tok":[["あなた"],["の"],["命令","めいれい"],["に"],["逆らい","さからい"],["、"],["あなた"],["が"],["私たち","わたしたち"],["に"],["命じる","めいじる"],["どんな"],["ことば"],["に"],["も"],["聞き従わない","ききし
[{"verse":1,"text":"ヨセフ族が、くじで割り当てられた地の境界線は、東、エリコのあたりのヨルダン川、すなわちエリコの水から荒野に出、エリコから山地を上ってベテルに至り、","tok":[["ヨセフ族","よせふぞく"],["が"],["、"],["くじ"],["で"],["割り当てられた","わりあてられた"],["地","ち"],["の"],["境界線","きょうかいせん"],["は"],["、"],["東","ひがし"],["、"],["エリコ"],["の"],["あたり"],["の"],["ヨルダン"],["川","かわ"],["、"],["すなわち"],["エリコ"],["の"],["水","みず"],["から"],["荒野","あらの"],["に"],["出","で"],["、"],["エリコ"],["から"],["山地","さんち"],["を"],["上って","のぼって"],["ベテル"],["に"],["至り","いたり"],["、"]]},{"verse":2,"text":"ベテルからルズに出て、アルキ人の領土アタロテに進み、","tok":[["ベテル"],["から"],["ルズ"],["に"],["出て","でて"],["、"],["アルキ人","あるきにん"],["の"],["領土","りょうど"],["アタロテ"],["に"],["進み","すすみ"],["、"]]},{"verse":3,"text":"西のほう、ヤフレテ人の領土に下り、下ベテ・ホロンの地境、さらにゲゼルに至り、その終わりは海であった。","tok":[["西","にし"],["の"],["ほう"],["、"],["ヤフレテ"],["人","にん"],["の"],["領土","りょうど"],["に"],["下り","くだり"],["、"],["下","した"],["ベテ"],["・"],["ホロン"],["の"],["地境","じざかい"],["、"],["さらに"],["ゲゼル"],["に"],["至り","いたり"],["、"],["その"],["終わり","おわり"],["は"],["海","うみ"],["で"],["あった"],["。"]]},{"verse":4,"text":"こうして、ヨセフ族、マナセとエフライムは、彼らの相続地を受けた。","tok":[["こう"],["して"],["、"],["ヨセフ族","よせふぞく"],["、"],["マナセ"],["と"],["エフライム"],["は"],["、"],["彼","かれ"],["ら"],["の"],["相続","そうぞく"],["地","ち"],["を"],["受けた","うけた"],["。"]]},{"verse":5,"text":"エフライム族の諸氏族の地域は、次のとおりである。彼らの相続地の東の境界線は、アテロテ・アダルから上ベテ・ホロンに至り、","tok":[["エフライム"],["族","ぞく"],["の"],["諸","しょ"],["氏族","しぞく"],["の"],["地域","ちいき"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["の"],["相続","そうぞく"],["地","ち"],["の"],["東","ひがし"],["の"],["境界線","きょうかいせん"],["は"],["、"],["アテロテ"],["・"],["アダル"],["から"],["上","うえ"],["ベテ"],["・"],["ホロン"],["に"],["至り","いたり"],["、"]]},{"verse":6,"text":"その境界線は、西に向かって、北方のミクメタテに出、その境界線は、東に回ってタアナテ・シロに至り、そこからヤノアハの東に進み、","tok":[["その"],["境界線","きょうかいせん"],["は"],["、"],["西","にし"],["に"],["向かって","むかって"],["、"],["北方","ほっぽう"],["の"],["ミクメタテ"],["に"],["出","で"],["、"],["その"],["境界線","きょうかいせん"],["は"],["、"],["東","ひがし"],["に"],["回って","まわって"],["タアナテ"],["・"],["シロ"],["に"],["至り","いたり"],["、"],["そこ"],["から"],["ヤノアハ"],["の"],["東","ひがし"],["に"],["進み","すすみ"],["、"]]},{"verse":7,"text":"ヤノアハからアタロテとナアラに下り、それからエリコに達し、ヨルダン川に出る。","tok":[["ヤノアハ"],["から"],["アタロテ"],["と"],["ナアラ"],["に"],["下り","くだり"],["、"],["それ"],["から"],["エリコ"],["に"],["達し","たっし"],["、"],["ヨルダン"],["川","かわ"],["に"],["出る","でる"],["。"]]},{"verse":8,"text":"西の境界線は、タプアハからカナ川に行き、その終わりは海であった。これが、エフライム部族の諸氏族の相続地であった。","tok":[["西","にし"],["の"],["境界線","きょうかいせん"],["は"],["、"],["タプアハ"],["から"],["カナ"],["川","かわ"],["に"],["行き","いき"],["、"],["その"],["終わり","おわり"],["は"],["海","うみ"],["で"],["あった"],["。"],["これ"],["が"],["、"],["エフライム"],["部族","ぶぞく"],["の"],["諸","しょ"],["氏族","しぞく"],["の"],["相続","そうぞく"],["地","ち"],["で"],["あった"],["。"]]},{"verse":9,"text":"このほかに、マナセ族の相続地の中に、エフライム族のために取り分けられた町々、そのすべての町々と、それに属する村々とがあった。","tok":[["この"],["ほか"],["に"],["、"],["マナセ族","まなせぞく"],["の"],["相続","そうぞく"],["地","ち"],["の"],["中","なか"],["に"],["、"],["エフライム"],["族","ぞく"],["の"],["ため"],["に"],["取り分けられた","とりわけられた"],["町々","まちまち"],["、"],["その"],["すべて"],["の"],["町々","まちまち"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["村々","むらむら"],["と"],["が"],["あった"],["。"]]},{"verse":10,"text":"彼らはゲゼルに住むカナン人を追い払わなかったので、カナン人はエフライムの中に住んでいた。今日もそうである。カナン人は苦役に服する奴隷となった。","tok":[["彼","かれ"],["ら"],["は"],["ゲゼル"],["に"],["住む","すむ"],["カナン人","かなんにん"],["を"],["追い払わなかった","おいはらわなかった"],["ので"],["、"],["カナン人","かなんにん"],["は"],["エフライム"],["の"],["中","なか"],["に"],["住んで","すんで"],["いた"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"],["カナン人","かなんにん"],["は"],["苦役","くえき"],["に"],["服する","ふくする"],["奴隷","どれい"],["と"],["なった"],["。"]]}]
[{"verse":1,"text":"ヨシュアは翌朝早く、イスラエル人全部といっしょに、シティムを出発してヨルダン川の川岸まで行き、それを渡る前に、そこに泊まった。","tok":[["ヨシュア"],["は"],["翌朝","よくあさ"],["早く","はやく"],["、"],["イスラエル"],["人","にん"],["全部","ぜんぶ"],["と"],["いっしょ"],["に"],["、"],["シティム"],["を"],["出発","しゅっぱつ"],["して"],["ヨルダン"],["川","かわ"],["の"],["川岸","かわぎし"],["まで"],["行き","いき"],["、"],["それ"],["を"],["渡る","わたる"],["前","まえ"],["に"],["、"],["そこ"],["に"],["泊まった","とまった"],["。"]]},{"verse":2,"text":"三日たってから、つかさたちは宿営の中を巡り、","tok":[["三日","みっか"],["たって"],["から"],["、"],["つかさ"],["たち"],["は"],["宿営","しゅくえい"],["の"],["中","なか"],["を"],["巡り","めぐり"],["、"]]},{"verse":3,"text":"民に命じて言った。「あなたがたは、あなたがたの神、主の契約の箱を見、レビ人の祭司たちが、それをかついでいるのを見たなら、あなたがたのいる所を発って、そのうしろを進まなければならない。","tok":[["民","みん"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["見","み"],["、"],["レビ人","れびにん"],["の"],["祭司","さいし"],["たち"],["が"],["、"],["それ"],["を"],["かついで"],["いる"],["の"],["を"],["見たなら","みたなら"],["、"],["あなた"],["がた"],["の"],["いる"],["所","ところ"],["を"],["発って","たって"],["、"],["その"],["うしろ"],["を"],["進まなければ","すすまなければ"],["ならない"],["。"]]},{"verse":4,"text":"あなたがたと箱との間には、約二千キュビトの距離をおかなければならない。それに近づいてはならない。それは、あなたがたの行くべき道を知るためである。あなたがたは、今までこの道を通ったことがないからだ。」","tok":[["あなた"],["がた"],["と"],["箱","ばこ"],["と"],["の"],["間","あいだ"],["に"],["は"],["、"],["約","やく"],["二千","にせん"],["キュビト"],["の"],["距離","きょり"],["を"],["おかなければ"],["ならない"],["。"],["それ"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["行くべき","いくべき"],["道","みち"],["を"],["知る","しる"],["ため"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["今まで","いままで"],["この"],["道","みち"],["を"],["通った","とおった"],["こと"],["が"],["ない"],["から"],["だ"],["。"],["」"]]},{"verse":5,"text":"ヨシュアは民に言った。「あなたがたの身をきよめなさい。あす、主が、あなたがたのうちで不思議を行われるから。」","tok":[["ヨシュア"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["身","み"],["を"],["きよめ"],["なさい"],["。"],["あす"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["で"],["不思議","ふしぎ"],["を"],["行われる","おこなわれる"],["から"],["。"],["」"]]},{"verse":6,"text":"ヨシュアは祭司たちに命じて言った。「契約の箱をかつぎ、民の先頭に立って渡りなさい。」そこで、彼らは契約の箱をかつぎ、民の先頭に立って行った。","tok":[["ヨシュア"],["は"],["祭司","さいし"],["たち"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["かつぎ"],["、"],["民","みん"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["渡り","わたり"],["なさい"],["。"],["」"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["かつぎ"],["、"],["民","みん"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["行った","いった"],["。"]]},{"verse":7,"text":"主はヨシュアに仰せられた。「きょうから、わたしはイスラエル全体の見ている前で、あなたを大いなる者としよう。それは、わたしがモーセとともにいたように、あなたとともにいることを、彼らが知るためである。","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["仰せられた","おおせられた"],["。"],["「"],["きょう"],["から"],["、"],["わたし"],["は"],["イスラエル"],["全体","ぜんたい"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["あなた"],["を"],["大いなる","おおいなる"],["者","もの"],["と"],["しよう"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["モーセ"],["と"],["とも"],["に"],["いた"],["よう"],["に"],["、"],["あなた"],["と"],["とも"],["に"],["いる"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["が"],["知る","しる"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたは契約の箱をかつぐ祭司たちに命じてこう言え。『ヨルダン川の水ぎわに来たとき、あなたがたはヨルダン川の中に立たなければならない。』」","tok":[["あなた"],["は"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["かつぐ"],["祭司","さいし"],["たち"],["に"],["命じて","めいじて"],["こう"],["言え","いえ"],["。"],["『"],["ヨルダン"],["川","かわ"],["の"],["水ぎわ","みずぎわ"],["に"],["来た","きた"],["とき"],["、"],["あなた"],["がた"],["は"],["ヨルダン"],["川","かわ"],["の"],["中","なか"],["に"],["立たなければ","たたなければ"],["ならない"],["。"],["』"],["」"]]},{"verse":9,"text":"ヨシュアはイスラエル人に言った。「ここに近づき、あなたがたの神、主のことばを聞きなさい。」","tok":[["ヨシュア"],["は"],["イスラエル"],["人","にん"],["に"],["言った","いった"],["。"],["「"],["ここ"],["に"],["近づき","ちかづき"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["聞き","きき"],["なさい"],["。"],["」"]]},{"verse":10,"text":"ヨシュアは言った。「生ける神があなたがたのうちにおられ、あなたがたの前から、カナン人、ヘテ人、ヒビ人、ペリジ人、ギルガシ人、エモリ人、エブス人を、必ず追い払われることを、次のことで知らなければならない。","tok":[["ヨシュア"],["は"],["言った","いった"],["。"],["「"],["生ける","いける"],["神","かみ"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["おられ"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["、"],["カナン人","かなんにん"],["、"],["ヘテ人","へてにん"],["、"],["ヒビ人","ひびにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ギルガシ"],["人","にん"],["、"],["エモリ人","えもりにん"],["、"],["エブス"],["人","ひと"],["を"],["、"],["必ず","かならず"],["追い払われる","おいはらわれる"],["こと"],["を"],["、"],["次","つぎ"],["の"],["こと"],["で"],["知らなければ","しらなければ"],["ならない"],["。"]]},{"verse":11,"text":"見よ。全地の主の契約の箱が、あなたがたの先頭に立って、ヨルダン川を渡ろうとしている。","tok":[["見","み"],["よ"],["。"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["が"],["、"],["あなた"],["がた"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["、"],["ヨルダン"],["川","かわ"],["を"],["渡ろう","わたろう"],["として"],["いる"],["。"]]},{"verse":12,"text":"今、部族ごとにひとりずつ、イスラエルの部族の中から十二人を選び出しなさい。","tok":[["今","いま"],["、"],["部族","ぶぞく"],["ごと"],["に"],["ひとり"],["ずつ"],["、"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["中","なか"],["から"],["十二人","じゅうににん"],["を"],["選び出し","えらびだし"],["なさい"],["。"]]},{"verse":13,"text":"全地の主である主の箱をかつぐ祭司たちの足の裏が、ヨルダン川の水の中にとどまると、ヨルダン川の水は、上から流れ下って来る水がせきとめられ、せきをなして立つようになる。」","tok":[["全地","ぜんち"],["の"],["主","ぬし"],["で"],["ある"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["かつぐ"],["祭司","さいし"],["たち"],["の"],["足","あし"],["の"],["裏","うら"],["が"],["、"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["の"],["中","なか"],["に"],["とどまる"],["と"],["、"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["は"],["、"],["上","うえ"],["から"],["流れ下って","ながれくだって"],["来る","くる"],["水","みず"],["が"],["せきとめられ"],["、"],["せき"],["を"],["なして"],["立つ","たつ"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":14,"text":"民がヨルダン川を渡るために、天幕を発ったとき、契約の箱をかつぐ祭司たちは民の先頭にいた。","tok":[["民","みん"],["が"],["ヨルダン"],["川","かわ"],["を"],["渡る","わたる"],["ため"],["に"],["、"],["天幕","てんまく"],["を"],["発った","たった"],["とき"],["、"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["かつぐ"],["祭司","さいし"],["たち"],["は"],["民","みん"],["の"],["先頭","せんとう"],["に"],["いた"],["。"]]},{"verse":15,"text":"箱をかつぐ者がヨルダン川まで来て、箱をかつぐ祭司たちの足が水ぎわに浸ったとき、――ヨルダン川は刈り入れの間中、岸いっぱいにあふれるのだが――","tok":[["箱","ばこ"],["を"],["かつぐ"],["者","もの"],["が"],["ヨルダン"],["川","かわ"],["まで"],["来て","きて"],["、"],["箱","ばこ"],["を"],["かつぐ"],["祭司","さいし"],["たち"],["の"],["足","あし"],["が"],["水ぎわ","みずぎわ"],["に"],["浸った","ひたった"],["とき"],["、"],["―"],["―"],["ヨルダン"],["川","かわ"],["は"],["刈り入れ","かりいれ"],["の"],["間中","まなか"],["、"],["岸","きし"],["いっぱい"],["に"],["あふれる"],["の"],["だ"],["が"],["―"],["―"]]},{"verse":16,"text":"上から流れ下る水はつっ立って、はるかかなたのツァレタンのそばにある町アダムのところで、せきをなして立ち、アラバの海、すなわち塩の海のほうに流れ下る水は完全にせきとめられた。民はエリコに面するところを渡った。","tok":[["上","うえ"],["から"],["流れ下る","ながれくだる"],["水","みず"],["は"],["つっ立って","つったって"],["、"],["はるか"],["かなた"],["の"],["ツァレタン"],["の"],["そば"],["に"],["ある"],["町","まち"],["アダム"],["の"],["ところ"],["で"],["、"],["せき"],["を"],["なして"],["立ち","たち"],["、"],["アラバ"],["の"],["海","うみ"],["、"],["すなわち"],["塩","しお"],["の"],["海","うみ"],["の"],["ほう"],["に"],["流れ下る","ながれくだる"],["水","みず"],["は"],["完全","かんぜん"],["に"],["せきとめられた"],["。"],["民","たみ"],["は"],["エリコ"],["に"],["面する","めんする"],["ところ"],["を"],["渡った","わたった"],["。"]]},{"verse":17,"text":"主の契約の箱をかつぐ祭司たちがヨルダン川の真ん中のかわいた地にしっかりと立つうちに、イスラエル全体は、かわいた地を通り、ついに民はすべてヨルダン川を渡り終わった。","tok":[["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["かつぐ"],["祭司","さいし"],["たち"],["が"],["ヨルダン"],["川","かわ"],["の"],["真ん中","まんなか"],["の"],["かわいた"],["地","ち"],["に"],["しっかり"],["と"],["立つ","たつ"],["うち"],["に"],["、"],["イスラエル"],["全体","ぜんたい"],["は"],["、"],["かわいた"],["地","ち"],["を"],["通り","とおり"],["、"],["ついに"],["民","たみ"],["は"],["すべて"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["終わった","おわった"],["。"]]}]
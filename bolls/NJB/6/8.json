[{"verse":1,"text":"主はヨシュアに仰せられた。「恐れてはならない。おののいてはならない。戦う民全部を連れてアイに攻め上れ。見よ。わたしはアイの王と、その民、その町、その地を、あなたの手に与えた。","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["仰せられた","おおせられた"],["。"],["「"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おののいて"],["は"],["ならない"],["。"],["戦う","たたかう"],["民","みん"],["全部","ぜんぶ"],["を"],["連れて","つれて"],["アイ"],["に"],["攻め上れ","せめのぼれ"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["アイ"],["の"],["王","おう"],["と"],["、"],["その"],["民","たみ"],["、"],["その"],["町","まち"],["、"],["その"],["地","ち"],["を"],["、"],["あなた"],["の"],["手","て"],["に"],["与えた","あたえた"],["。"]]},{"verse":2,"text":"あなたがエリコとその王にしたとおりに、アイとその王にもせよ。ただし、その分捕り物と家畜だけは、あなたがたの戦利品としてよい。あなたは町のうしろに伏兵を置け。」","tok":[["あなた"],["が"],["エリコ"],["と"],["その"],["王","おう"],["に"],["した"],["とおり"],["に"],["、"],["アイ"],["と"],["その"],["王","おう"],["に"],["も"],["せよ"],["。"],["ただし"],["、"],["その"],["分","ぶん"],["捕り物","とりもの"],["と"],["家畜","かちく"],["だけ"],["は"],["、"],["あなた"],["がた"],["の"],["戦利品","せんりひん"],["として"],["よい"],["。"],["あなた"],["は"],["町","まち"],["の"],["うしろ"],["に"],["伏兵","ふくへい"],["を"],["置け","おけ"],["。"],["」"]]},{"verse":3,"text":"そこで、ヨシュアは戦う民全部と、アイに上って行く準備をした。ヨシュアは勇士たち三万人を選び、彼らを夜のうちに派遣した。","tok":[["そこ"],["で"],["、"],["ヨシュア"],["は"],["戦う","たたかう"],["民","みん"],["全部","ぜんぶ"],["と"],["、"],["アイ"],["に"],["上って","のぼって"],["行く","いく"],["準備","じゅんび"],["を"],["した"],["。"],["ヨシュア"],["は"],["勇士","ゆうし"],["たち"],["三万人","さんまんにん"],["を"],["選び","えらび"],["、"],["彼","かれ"],["ら"],["を"],["夜","よる"],["の"],["うち"],["に"],["派遣","はけん"],["した"],["。"]]},{"verse":4,"text":"そのとき、ヨシュアは彼らに命じて言った。「聞きなさい。あなたがたは町のうしろから町に向かう伏兵である。町からあまり遠く離れないで、みな用意をしていなさい。","tok":[["その"],["とき"],["、"],["ヨシュア"],["は"],["彼","かれ"],["ら"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["聞き","きき"],["なさい"],["。"],["あなた"],["がた"],["は"],["町","まち"],["の"],["うしろ"],["から"],["町","まち"],["に"],["向かう","むかう"],["伏兵","ふくへい"],["で"],["ある"],["。"],["町","まち"],["から"],["あまり"],["遠く","とおく"],["離れないで","はなれないで"],["、"],["みな"],["用意","ようい"],["を"],["して"],["い"],["なさい"],["。"]]},{"verse":5,"text":"私と私とともにいる民はすべて、町に近づく。彼らがこの前と同じように、私たちに向かって出て来るなら、私たちは彼らの前で、逃げよう。","tok":[["私","わたくし"],["と"],["私","わたくし"],["と"],["とも"],["に"],["いる"],["民","たみ"],["は"],["すべて"],["、"],["町","まち"],["に"],["近づく","ちかづく"],["。"],["彼","かれ"],["ら"],["が"],["この"],["前","まえ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["私たち","わたしたち"],["に"],["向かって","むかって"],["出て","でて"],["来るなら","くるなら"],["、"],["私たち","わたしたち"],["は"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["、"],["逃げよう","にげよう"],["。"]]},{"verse":6,"text":"彼らが私たちを追って出て、私たちは彼らを町からおびき出すことになる。彼らは、『われわれの前から逃げて行く。前と同じことだ』と言うだろうから。そうして私たちは彼らの前から逃げる。","tok":[["彼","かれ"],["ら"],["が"],["私たち","わたしたち"],["を"],["追って","おって"],["出て","でて"],["、"],["私たち","わたしたち"],["は"],["彼","かれ"],["ら"],["を"],["町","まち"],["から"],["おびき出す","おびきだす"],["こと"],["に"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["、"],["『"],["われわれ"],["の"],["前","まえ"],["から"],["逃げて","にげて"],["行く","いく"],["。"],["前","まえ"],["と"],["同じ","おなじ"],["こと"],["だ"],["』"],["と"],["言うだろう","ゆうだろう"],["から"],["。"],["そう"],["して"],["私たち","わたしたち"],["は"],["彼","かれ"],["ら"],["の"],["前","まえ"],["から"],["逃げる","にげる"],["。"]]},{"verse":7,"text":"あなたがたは伏している所から立ち上がり、町を占領しなければならない。あなたがたの神、主が、それをあなたがたの手に渡される。","tok":[["あなた"],["がた"],["は"],["伏して","ふして"],["いる"],["所","ところ"],["から"],["立ち上がり","たちあがり"],["、"],["町","まち"],["を"],["占領","せんりょう"],["しなければ"],["ならない"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["それ"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡される","わたされる"],["。"]]},{"verse":8,"text":"その町を取ったら、その町に火をかけなければならない。主の言いつけどおりに行わなければならない。見よ。私はあなたがたに命じた。」","tok":[["その"],["町","まち"],["を"],["取ったら","とったら"],["、"],["その"],["町","まち"],["に"],["火","ひ"],["を"],["かけなければ"],["ならない"],["。"],["主","ぬし"],["の"],["言いつけ","いいつけ"],["どおり"],["に"],["行わなければ","おこなわなければ"],["ならない"],["。"],["見","み"],["よ"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["命じた","めいじた"],["。"],["」"]]},{"verse":9,"text":"こうして、ヨシュアは彼らを派遣した。彼らは待ち伏せの場所へ行き、アイの西方、ベテルとアイの間にとどまった。ヨシュアはその夜、民の中で夜を過ごした。","tok":[["こう"],["して"],["、"],["ヨシュア"],["は"],["彼","かれ"],["ら"],["を"],["派遣","はけん"],["した"],["。"],["彼","かれ"],["ら"],["は"],["待ち伏せ","まちぶせ"],["の"],["場所","ばしょ"],["へ"],["行き","いき"],["、"],["アイ"],["の"],["西方","せいほう"],["、"],["ベテル"],["と"],["アイ"],["の"],["間","あいだ"],["に"],["とどまった"],["。"],["ヨシュア"],["は"],["その"],["夜","よる"],["、"],["民","みん"],["の"],["中","なか"],["で"],["夜","よる"],["を"],["過ごした","すごした"],["。"]]},{"verse":10,"text":"ヨシュアは翌朝早く民を召集し、イスラエルの長老たちといっしょに、民の先頭に立って、アイに上って行った。","tok":[["ヨシュア"],["は"],["翌朝","よくあさ"],["早く","はやく"],["民","たみ"],["を"],["召集","しょうしゅう"],["し"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["と"],["いっしょ"],["に"],["、"],["民","みん"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["、"],["アイ"],["に"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":11,"text":"彼とともにいた戦う民はみな、上って行って、町の前に近づき、アイの北側に陣を敷いた。彼とアイとの間には、一つの谷があった。","tok":[["彼","かれ"],["と"],["とも"],["に"],["いた"],["戦う","たたかう"],["民","たみ"],["は"],["みな"],["、"],["上って","のぼって"],["行って","いって"],["、"],["町","まち"],["の"],["前","まえ"],["に"],["近づき","ちかづき"],["、"],["アイ"],["の"],["北側","きたがわ"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["彼","かれ"],["と"],["アイ"],["と"],["の"],["間","あいだ"],["に"],["は"],["、"],["一","ひと"],["つ"],["の"],["谷","たに"],["が"],["あった"],["。"]]},{"verse":12,"text":"彼が約五千人を取り、町の西側、ベテルとアイの間に伏兵として配置してから、","tok":[["彼","かれ"],["が"],["約","やく"],["五千人","ごせんにん"],["を"],["取り","とり"],["、"],["町","まち"],["の"],["西側","にしがわ"],["、"],["ベテル"],["と"],["アイ"],["の"],["間","あいだ"],["に"],["伏兵","ふくへい"],["として"],["配置","はいち"],["して"],["から"],["、"]]},{"verse":13,"text":"民は町の北に全陣営を置き、後陣を町の西に置いた。ヨシュアは、その夜、谷の中で夜を過ごした。","tok":[["民","みん"],["は"],["町","まち"],["の"],["北","きた"],["に"],["全","ぜん"],["陣営","じんえい"],["を"],["置き","おき"],["、"],["後陣","こうじん"],["を"],["町","まち"],["の"],["西","にし"],["に"],["置いた","おいた"],["。"],["ヨシュア"],["は"],["、"],["その"],["夜","よる"],["、"],["谷","たに"],["の"],["中","なか"],["で"],["夜","よる"],["を"],["過ごした","すごした"],["。"]]},{"verse":14,"text":"アイの王が気づくとすぐ、町の人々は、急いで、朝早くイスラエルを迎えて戦うために、出て来た。王とその民全部はアラバの前の定められた所に出て来た。しかし王は、町のうしろに、伏兵がいることを知らなかった。","tok":[["アイ"],["の"],["王","おう"],["が"],["気づく","きづく"],["と"],["すぐ"],["、"],["町","まち"],["の"],["人々","ひとびと"],["は"],["、"],["急いで","いそいで"],["、"],["朝","あさ"],["早く","はやく"],["イスラエル"],["を"],["迎えて","むかえて"],["戦う","たたかう"],["ため"],["に"],["、"],["出て","でて"],["来た","きた"],["。"],["王","おう"],["と"],["その"],["民","みん"],["全部","ぜ
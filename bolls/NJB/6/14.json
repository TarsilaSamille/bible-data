[{"verse":1,"text":"イスラエル人がカナンの地で相続地の割り当てをした地は次のとおりである。その地を祭司エルアザルと、ヌンの子ヨシュアと、イスラエル人の部族の一族のかしらたちが、彼らに割り当て、","tok":[["イスラエル"],["人","にん"],["が"],["カナン"],["の"],["地","ち"],["で"],["相続","そうぞく"],["地","ち"],["の"],["割り当て","わりあて"],["を"],["した"],["地","ち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["その"],["地","ち"],["を"],["祭司","さいし"],["エルアザル"],["と"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["、"],["イスラエル"],["人","にん"],["の"],["部族","ぶぞく"],["の"],["一族","いちぞく"],["の"],["かしら"],["たち"],["が"],["、"],["彼","かれ"],["ら"],["に"],["割り当て","わりあて"],["、"]]},{"verse":2,"text":"主がモーセを通して命じたとおりに、九部族と半部族とにくじで相続地を割り当てた。","tok":[["主","ぬし"],["が"],["モーセ"],["を"],["通して","とおして"],["命じた","めいじた"],["とおり"],["に"],["、"],["九","きゅう"],["部族","ぶぞく"],["と"],["半","はん"],["部族","ぶぞく"],["と"],["に"],["くじ"],["で"],["相続","そうぞく"],["地","ち"],["を"],["割り当てた","わりあてた"],["。"]]},{"verse":3,"text":"モーセはすでに二部族と半部族とに、ヨルダン川の向こう側で相続地を与えており、またレビ人には、彼らの中で相続地を与えなかったからであり、","tok":[["モーセ"],["は"],["すでに"],["二部族","にぶぞく"],["と"],["半","はん"],["部族","ぶぞく"],["と"],["に"],["、"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["で"],["相続","そうぞく"],["地","ち"],["を"],["与えて","あたえて"],["おり"],["、"],["また"],["レビ人","れびにん"],["に"],["は"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["で"],["相続","そうぞく"],["地","ち"],["を"],["与えなかった","あたえなかった"],["から"],["で"],["あり"],["、"]]},{"verse":4,"text":"ヨセフの子孫が、マナセとエフライムの二部族になっていたからである。彼らは、レビ族には、その住むための町々と彼らの所有になる家畜のための放牧地を除いては、その地で割り当て地を与えなかった。","tok":[["ヨセフ"],["の"],["子孫","しそん"],["が"],["、"],["マナセ"],["と"],["エフライム"],["の"],["二部族","にぶぞく"],["に"],["なって"],["いた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["レビ族","れびぞく"],["に"],["は"],["、"],["その"],["住む","すむ"],["ため"],["の"],["町々","まちまち"],["と"],["彼","かれ"],["ら"],["の"],["所有","しょゆう"],["に"],["なる"],["家畜","かちく"],["の"],["ため"],["の"],["放牧","ほうぼく"],["地","ち"],["を"],["除いて","のぞいて"],["は"],["、"],["その"],["地","ち"],["で"],["割り当て","わりあて"],["地","ち"],["を"],["与えなかった","あたえなかった"],["。"]]},{"verse":5,"text":"イスラエル人は、主がモーセに命じたとおりに行って、その地を割り当てた。","tok":[["イスラエル"],["人","にん"],["は"],["、"],["主","ぬし"],["が"],["モーセ"],["に"],["命じた","めいじた"],["とおり"],["に"],["行って","いって"],["、"],["その"],["地","ち"],["を"],["割り当てた","わりあてた"],["。"]]},{"verse":6,"text":"ときに、ユダ族がギルガルでヨシュアのところに近づいて来た。そして、ケナズ人エフネの子カレブが、ヨシュアに言った。「主がカデシュ・バルネアで、私とあなたについて、神の人モーセに話されたことを、あなたはご存じのはずです。","tok":[["とき"],["に"],["、"],["ユダ族","ゆだぞく"],["が"],["ギルガル"],["で"],["ヨシュア"],["の"],["ところ"],["に"],["近づいて","ちかづいて"],["来た","きた"],["。"],["そして"],["、"],["ケナズ人","けなずにん"],["エフネ"],["の"],["子","こ"],["カレブ"],["が"],["、"],["ヨシュア"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["カデシュ"],["・"],["バルネア"],["で"],["、"],["私","わたくし"],["と"],["あなた"],["について"],["、"],["神","かみ"],["の"],["人","ひと"],["モーセ"],["に"],["話された","はなされた"],["こと"],["を"],["、"],["あなた"],["は"],["ご存じ","ごぞんじ"],["の"],["はず"],["です"],["。"]]},{"verse":7,"text":"主のしもべモーセがこの地を偵察するために、私をカデシュ・バルネアから遣わしたとき、私は四十歳でした。そのとき、私は自分の心の中にあるとおりを彼に報告しました。","tok":[["主","ぬし"],["の"],["しもべ"],["モーセ"],["が"],["この"],["地","ち"],["を"],["偵察","ていさつ"],["する"],["ため"],["に"],["、"],["私","わたくし"],["を"],["カデシュ"],["・"],["バルネア"],["から"],["遣わした","つかわした"],["とき"],["、"],["私","わたくし"],["は"],["四十歳","よんじゅうさい"],["でした"],["。"],["その"],["とき"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["ある"],["とおり"],["を"],["彼","かれ"],["に"],["報告","ほうこく"],["しました"],["。"]]},{"verse":8,"text":"私といっしょに上って行った私の身内の者たちは、民の心をくじいたのですが、私は私の神、主に従い通しました。","tok":[["私","わたくし"],["と"],["いっしょ"],["に"],["上って","のぼって"],["行った","いった"],["私","わたくし"],["の"],["身内","みうち"],["の"],["者","もの"],["たち"],["は"],["、"],["民","みん"],["の"],["心","こころ"],["を"],["くじいた"],["の"],["です"],["が"],["、"],["私","わたくし"],["は"],["私","わたくし"],["の"],["神","かみ"],["、"],["主に","おもに"],["従い","したがい"],["通しました","とおしました"],["。"]]},{"verse":9,"text":"そこでその日、モーセは誓って、『あなたの足が踏み行く地は、必ず永久に、あなたとあなたの子孫の相続地となる。あなたが、私の神、主に従い通したからである』と言いました。","tok":[["そこ"],["で"],["その"],["日","ひ"],["、"],["モーセ"],["は"],["誓って","ちかって"],["、"],["『"],["あなた"],["の"],["足","あし"],["が"],["踏み","ふみ"],["行く","いく"],["地","ち"],["は"],["、"],["必ず","かならず"],["永久","えいきゅう"],["に"],["、"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["の"],["相続","そうぞく"],["地","ち"],["と"],["なる"],["。"],["あなた"],["が"],["、"],["私","わたくし"],["の"],["神","かみ"],["、"],["主に","おもに"],["従い","したがい"],["通した","とおした"],["から"],["で"],["ある"],["』"],["と"],["言いました","いいました"],["。"]]},{"verse":10,"text":"今、ご覧のとおり、主がこのことばをモーセに告げられた時からこのかた、イスラエルが荒野を歩いた四十五年間、主は約束されたとおりに、私を生きながらえさせてくださいました。今や私は、きょうでもう八十五歳になります。","tok":[["今","いま"],["、"],["ご覧","ごらん"],["の"],["とおり"],["、"],["主","ぬし"],["が"],["この"],["ことば"],["を"],["モーセ"],["に"],["告げられた","つげられた"],["時","とき"],["から"],["このかた"],["、"],["イスラエル"],["が"],["荒野","あらの"],["を"],["歩いた","あるいた"],["四十五","よんじゅうご"],["年間","ねんかん"],["、"],["主","ぬし"],["は"],["約束","やくそく"],["された"],["とおり"],["に"],["、"],["私","わたくし"],["を"],["生きながらえさせて","いきながらえさせて"],["くださいました"],["。"],["今","いま"],["や"],["私","わたくし"],["は"],["、"],["きょう"],["で"],["もう"],["八十五歳","はちじゅうごさい"],["に"],["なります"],["。"]]},{"verse":11,"text":"しかも、モーセが私を遣わした日のように、今も壮健です。私の今の力は、あの時の力と同様、戦争にも、また日常の出入りにも耐えるのです。","tok":[["しかも"],["、"],["モーセ"],["が"],["私","わたくし"],["を"],["遣わした","つかわした"],["日","ひ"],["の"],["よう"],["に"],["、"],["今","いま"],["も"],["壮健","そうけん"],["です"],["。"],["私","わたくし"],["の"],["今","いま"],["の"],["力","ちから"],["は"],["、"],["あの"],["時","とき"],["の"],["力","ちから"],["と"],["同様","どうよう"],["、"],["戦争","せんそう"],["に"],["も"],["、"],["また"],["日常","にちじょう"],["の"],["出入り","でいり"],["に"],["も"],["耐える","たえる"],["の"],["です"],["。"]]},{"verse":12,"text":"どうか今、主があの日に約束されたこの山地を私に与えてください。あの日、あなたが聞いたように、そこにはアナク人がおり、城壁のある大きな町々があったのです。主が私とともにいてくだされば、主が約束されたように、私は彼らを追い払うことができましょう。」","tok":[["どう"],["か"],["今","いま"],["、"],["主","ぬし"],["が"],["あの"],["日","ひ"],["に"],["約束","やくそく"],["された"],["この"],["山地","さんち"],["を"],["私","わたくし"],["に"],["与えて","あたえて"],["ください"],["。"],["あの"],["日","ひ"],["、"],["あなた"],["が"],["聞いた","きいた"],["よう"],["に"],["、"],["そこ"],["に"],["は"],["アナク人","あなくにん"],["が"],["おり"],["、"],["城壁","じょうへき"],["の"],["ある"],["大きな","おおきな"],["町々","まちまち"],["が"],["あった"],["の"],["です"],["。"],["主","ぬし"],["が"],["私","わたくし"],["と"],["とも"],["に"],["いて"],["くだされば"],["、"],["主","ぬし"],["が"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["を"],["追い払う","おいはらう"],["こと"],["が"],["できましょう"],["。"],["」"]]},{"verse":13,"text":"それでヨシュアは、エフネの子カレブを祝福し、彼にヘブロンを相続地として与えた。","tok":[["それ"],["で"],["ヨシュア"],["は"],["、"],["エフネ"],["の"],["子","こ"],["カレブ"],["を"],["祝福","しゅくふく"],["し"],["、"],["彼","かれ"],["に"],["ヘブロン"],["を"],["相続","そうぞく"],["地","ち"],["として"],["与えた","あたえた"],["。"]]},{"verse":14,"text":"それで、ヘブロンは、ケナズ人エフネの子カレブの相続地となった。今日もそうである。それは、彼がイスラエルの神、主に従い通したからである。","tok":[["それ"],["で"],["、"],["ヘブロン"],["は"],["、"],["ケナズ人","けなずにん"],["エフネ"],["の"],["子","こ"],["カレブ"],["の"],["相続","そうぞく"],["地","ち"],["と"],["なった"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"],["それ"],["は"],["、"],["彼","かれ"],["が"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["従い","したがい"],["通した","とおした"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"ヘブロンの名は、以前はキルヤテ・アルバであった。アルバというのは、アナク人の中の最も偉大な人物であった。そして、その地に戦争はやんだ。","tok":[["ヘブロン"],["の"],["名","な"],["は"],["、"],["以前","いぜん"],["は"],["キルヤテ"],["・"],["アルバ"],["で"],["あった"],["。"],["アルバ"],["と"],["いう"],["の"],["は"],["、"],["アナク人","あなくにん"],["の"],["中","なか"],["の"],["最も","もっとも"],["偉大","いだい"],["な"],["人物","じんぶつ"],["で"],["あった"],["。"],["そして"],["、"],["その"],["地","ち"],["に"],["戦争","せんそう"],["は"],["やんだ"],["。"]]}]
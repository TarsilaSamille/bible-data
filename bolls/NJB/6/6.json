],["もの"],["だ"],["から"],["、"],["主","ぬし"],["の"],["宝物倉","ほうもつそう"],["に"],["持ち込まなければ","もちこまなければ"],["ならない"],["。"],["」"]]},{"verse":20,"text":"そこで、民はときの声をあげ、祭司たちは角笛を吹き鳴らした。民が角笛の音を聞いて、大声でときの声をあげるや、城壁がくずれ落ちた。そこで民はひとり残らず、まっすぐ町へ上って行き、その町を攻め取った。","tok":[["そこ"],["で"],["、"],["民","みん"],["は"],["とき"],["の"],["声","こえ"],["を"],["あげ"],["、"],["祭司","さいし"],["たち"],["は"],["角笛","つのぶえ"],["を"],["吹き鳴らした","ふきならした"],["。"],["民","たみ"],["が"],["角笛","つのぶえ"],["の"],["音","おと"],["を"],["聞いて","きいて"],["、"],["大声","おおごえ"],["で"],["とき"],["の"],["声","こえ"],["を"],["あげる"],["や"],["、"],["城壁","じょうへき"],["が"],["くずれ落ちた","くずれおちた"],["。"],["そこ"],["で"],["民","たみ"],["は"],["ひとり"],["残らず","のこらず"],["、"],["まっすぐ"],["町","まち"],["へ"],["上って","のぼって"],["行き","いき"],["、"],["その"],["町","まち"],["を"],["攻め取った","せめとった"],["。"]]},{"verse":21,"text":"彼らは町にあるものは、男も女も、若い者も年寄りも、また牛、羊、ろばも、すべて剣の刃で聖絶した。","tok":[["彼","かれ"],["ら"],["は"],["町","まち"],["に"],["ある"],["もの"],["は"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["、"],["若い","わかい"],["者","もの"],["も"],["年寄り","としより"],["も"],["、"],["また"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["ろば"],["も"],["、"],["すべて"],["剣","けん"],["の"],["刃","は"],["で"],["聖","せい"],["絶した","ぜっした"],["。"]]},{"verse":22,"text":"ヨシュアはこの地を偵察したふたりの者に言った。「あなたがたがあの遊女に誓ったとおり、あの女の家に行って、その女とその女に属するすべての者を連れ出しなさい。」","tok":[["ヨシュア"],["は"],["この"],["地","ち"],["を"],["偵察","ていさつ"],["した"],["ふたり"],["の"],["者","もの"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["が"],["あの"],["遊女","ゆうじょ"],["に"],["誓った","ちかった"],["とおり"],["、"],["あの"],["女","おんな"],["の"],["家","いえ"],["に"],["行って","いって"],["、"],["その"],["女","おんな"],["と"],["その"],["女","おんな"],["に"],["属する","ぞくする"],["すべて"],["の"],["者","もの"],["を"],["連れ出し","つれだし"],["なさい"],["。"],["」"]]},{"verse":23,"text":"斥候になったその若者たちは、行って、ラハブとその父、母、兄弟、そのほか彼女に属するすべての者を連れ出し、また、彼女の親族をみな連れ出して、イスラエルの宿営の外にとどめておいた。","tok":[["斥候","せっこう"],["に"],["なった"],["その"],["若者","わかもの"],["たち"],["は"],["、"],["行って","いって"],["、"],["ラハブ"],["と"],["その"],["父","ちち"],["、"],["母","はは"],["、"],["兄弟","きょうだい"],["、"],["その"],["ほか"],["彼女","かのじょ"],["に"],["属する","ぞくする"],["すべて"],["の"],["者","もの"],["を"],["連れ出し","つれだし"],["、"],["また"],["、"],["彼女","かのじょ"],["の"],["親族","しんぞく"],["を"],["みな"],["連れ出して","つれだして"],["、"],["イスラエル"],["の"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["とどめて"],["おいた"],["。"]]},{"verse":24,"text":"彼らは町とその中のすべてのものを火で焼いた。ただ銀、金、および青銅の器、鉄の器は、主の宮の宝物倉に納めた。","tok":[["彼","かれ"],["ら"],["は"],["町","まち"],["と"],["その"],["中","なか"],["の"],["すべて"],["の"],["もの"],["を"],["火","ひ"],["で"],["焼いた","やいた"],["。"],["ただ"],["銀","ぎん"],["、"],["金","きん"],["、"],["および"],["青銅","せいどう"],["の"],["器","うつわ"],["、"],["鉄","てつ"],["の"],["器","うつわ"],["は"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["宝物倉","ほうもつそう"],["に"],["納めた","おさめた"],["。"]]},{"verse":25,"text":"しかし、遊女ラハブとその父の家族と彼女に属するすべての者とは、ヨシュアが生かしておいたので、ラハブはイスラエルの中に住んだ。今日もそうである。これは、ヨシュアがエリコを偵察させるために遣わした使者たちを、ラハブがかくまったからである。","tok":[["しかし"],["、"],["遊女","ゆうじょ"],["ラハブ"],["と"],["その"],["父","ちち"],["の"],["家族","かぞく"],["と"],["彼女","かのじょ"],["に"],["属する","ぞくする"],["すべて"],["の"],["者","もの"],["と"],["は"],["、"],["ヨシュア"],["が"],["生かして","いかして"],["おいた"],["ので"],["、"],["ラハブ"],["は"],["イスラエル"],["の"],["中","なか"],["に"],["住んだ","すんだ"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"],["これ"],["は"],["、"],["ヨシュア"],["が"],["エリコ"],["を"],["偵察","ていさつ"],["させる"],["ため"],["に"],["遣わした","つかわした"],["使者","ししゃ"],["たち"],["を"],["、"],["ラハブ"],["が"],["かくまった"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"ヨシュアは、そのとき、誓って言った。「この町エリコの再建を企てる者は、主の前にのろわれよ。その礎を据える者は長子を失い、その門を建てる者は末の子を失う。」","tok":[["ヨシュア"],["は"],["、"],["その"],["とき"],["、"],["誓って","ちかって"],["言った","いった"],["。"],["「"],["この"],["町","まち"],["エリコ"],["の"],["再建","さいけん"],["を"],["企てる","くわだてる"],["者","もの"],["は"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["のろわれ"],["よ"],["。"],["その"],["礎","いしずえ"],["を"],["据える","すえる"],["者","もの"],["は"],["長子","ちょうし"],["を"],["失い","うしない"],["、"],["その"],["門","もん"],["を"],["建てる","たてる"],["者","もの"],["は"],["末","すえ"],["の"],["子","こ"],["を"],["失う","うしなう"],["。"],["」"]]},{"verse":27,"text":"主がヨシュアとともにおられたので、そのうわさは地にあまねく広まった。","tok":[["主","ぬし"],["が"],["ヨシュア"],["と"],["とも"],["に"],["おられた"],["ので"],["、"],["その"],["うわさ"],["は"],["地","ち"],["に"],["あまねく"],["広まった","ひろまった"],["。"]]}]
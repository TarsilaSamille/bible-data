[{"verse":1,"text":"マナセ部族が、くじで割り当てられた地は次のとおりである。マナセはヨセフの長子であった。マナセの長子で、ギルアデの父であるマキルは戦士であったので、ギルアデとバシャンが彼のものとなった。","tok":[["マナセ"],["部族","ぶぞく"],["が"],["、"],["くじ"],["で"],["割り当てられた","わりあてられた"],["地","ち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["マナセ"],["は"],["ヨセフ"],["の"],["長子","ちょうし"],["で"],["あった"],["。"],["マナセ"],["の"],["長子","ちょうし"],["で"],["、"],["ギルアデ"],["の"],["父","ちち"],["で"],["ある"],["マキル"],["は"],["戦士","せんし"],["で"],["あった"],["ので"],["、"],["ギルアデ"],["と"],["バシャン"],["が"],["彼","かれ"],["の"],["もの"],["と"],["なった"],["。"]]},{"verse":2,"text":"さらにそれはマナセ族のほかの諸氏族、アビエゼル族、ヘレク族、アスリエル族、シェケム族、ヘフェル族、シェミダ族のものになった。これらは、ヨセフの子マナセの男子の子孫の諸氏族である。","tok":[["さらに"],["それ"],["は"],["マナセ族","まなせぞく"],["の"],["ほか"],["の"],["諸氏族","しょしぞく"],["、"],["アビエゼル"],["族","ぞく"],["、"],["ヘレク族","へれくぞく"],["、"],["アスリエル"],["族","ぞく"],["、"],["シェケム"],["族","ぞく"],["、"],["ヘフェル"],["族","ぞく"],["、"],["シェミダ"],["族","ぞく"],["の"],["もの"],["に"],["なった"],["。"],["これ"],["ら"],["は"],["、"],["ヨセフ"],["の"],["子","こ"],["マナセ"],["の"],["男子","だんし"],["の"],["子孫","しそん"],["の"],["諸氏族","しょしぞく"],["で"],["ある"],["。"]]},{"verse":3,"text":"ところが、マナセの子マキルの子ギルアデの子ヘフェルの子ツェロフハデには、娘だけで息子がなかった。その娘たちの名は、マフラ、ノア、ホグラ、ミルカ、ティルツァであった。","tok":[["ところ"],["が"],["、"],["マナセ"],["の"],["子","こ"],["マキル"],["の"],["子","こ"],["ギルアデ"],["の"],["子","こ"],["ヘフェル"],["の"],["子","こ"],["ツェロフハデ"],["に"],["は"],["、"],["娘","むすめ"],["だけ"],["で"],["息子","むすこ"],["が"],["なかった"],["。"],["その"],["娘","むすめ"],["たち"],["の"],["名","な"],["は"],["、"],["マフラ"],["、"],["ノア"],["、"],["ホグラ"],["、"],["ミルカ"],["、"],["ティルツァ"],["で"],["あった"],["。"]]},{"verse":4,"text":"彼女たちは、祭司エルアザルと、ヌンの子ヨシュアと、族長たちとの前に進み出て、「私たちの親類の間で、私たちにも相続地を与えるように、主はモーセに命じられました」と言ったので、ヨシュアは主の命令で、彼女たちの父の兄弟たちの間で、彼女たちに相続地を与えた。","tok":[["彼女","かのじょ"],["たち"],["は"],["、"],["祭司","さいし"],["エルアザル"],["と"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["、"],["族長","ぞくちょう"],["たち"],["と"],["の"],["前","まえ"],["に"],["進み出て","すすみでて"],["、"],["「"],["私たち","わたしたち"],["の"],["親類","しんるい"],["の"],["間","あいだ"],["で"],["、"],["私たち","わたしたち"],["に"],["も"],["相続","そうぞく"],["地","ち"],["を"],["与える","あたえる"],["よう"],["に"],["、"],["主","ぬし"],["は"],["モーセ"],["に"],["命じられました","めいじられました"],["」"],["と"],["言った","いった"],["ので"],["、"],["ヨシュア"],["は"],["主","ぬし"],["の"],["命令","めいれい"],["で"],["、"],["彼女","かのじょ"],["たち"],["の"],["父","ちち"],["の"],["兄弟","きょうだい"],["たち"],["の"],["間","あいだ"],["で"],["、"],["彼女","かのじょ"],["たち"],["に"],["相続","そうぞく"],["地","ち"],["を"],["与えた","あたえた"],["。"]]},{"verse":5,"text":"こうして、マナセはヨルダン川の向こう側のギルアデとバシャンの地のほかに、なお十の割り当て地があてがわれた。","tok":[["こう"],["して"],["、"],["マナセ"],["は"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["の"],["ギルアデ"],["と"],["バシャン"],["の"],["地","ち"],["の"],["ほか"],["に"],["、"],["なお"],["十","じゅう"],["の"],["割り当て","わりあて"],["地","ち"],["が"],["あてがわれた"],["。"]]},{"verse":6,"text":"マナセの娘たちが、彼の息子たちの間に、相続地を受けたからである。ギルアデの地は、マナセのほかの子孫のものとなった。","tok":[["マナセ"],["の"],["娘","むすめ"],["たち"],["が"],["、"],["彼","かれ"],["の"],["息子","むすこ"],["たち"],["の"],["間","あいだ"],["に"],["、"],["相続","そうぞく"],["地","ち"],["を"],["受けた","うけた"],["から"],["で"],["ある"],["。"],["ギルアデ"],["の"],["地","ち"],["は"],["、"],["マナセ"],["の"],["ほか"],["の"],["子孫","しそん"],["の"],["もの"],["と"],["なった"],["。"]]},{"verse":7,"text":"マナセの境界線は、アシェルからシェケムに面したミクメタテに向かい、その境界線は、さらに南に行って、エン・タプアハの住民のところに至った。","tok":[["マナセ"],["の"],["境界線","きょうかいせん"],["は"],["、"],["アシェル"],["から"],["シェケム"],["に"],["面した","めんした"],["ミクメタテ"],["に"],["向かい","むかい"],["、"],["その"],["境界線","きょうかいせん"],["は"],["、"],["さらに"],["南","みなみ"],["に"],["行って","いって"],["、"],["エン"],["・"],["タプアハ"],["の"],["住民","じゅうみん"],["の"],["ところ"],["に"],["至った","いたった"],["。"]]},{"verse":8,"text":"タプアハの地は、マナセのものであったが、マナセの境界に近いタプアハは、エフライム族のものであった。","tok":[["タプアハ"],["の"],["地","ち"],["は"],["、"],["マナセ"],["の"],["もの"],["で"],["あった"],["が"],["、"],["マナセ"],["の"],["境界","きょうかい"],["に"],["近い","ちかい"],["タプアハ"],["は"],["、"],["エフライム"],["族","ぞく"],["の"],["もの"],["で"],["あった"],["。"]]},{"verse":9,"text":"またその境界線は、カナ川に下り、川の南に向かった。そこの町々は、マナセの町々の中にあって、エフライムのものであった。マナセの境界線は、川の北で、その終わりは海であった。","tok":[["また"],["その"],["境界線","きょうかいせん"],["は"],["、"],["カナ"],["川","かわ"],["に"],["下り","くだり"],["、"],["川","かわ"],["の"],["南","みなみ"],["に"],["向かった","むかった"],["。"],["そこ"],["の"],["町々","まちまち"],["は"],["、"],["マナセ"],["の"],["町々","まちまち"],["の"],["中","なか"],["に"],["あって"],["、"],["エフライム"],["の"],["もの"],["で"],["あった"],["。"],["マナセ"],["の"],["境界線","きょうかいせん"],["は"],["、"],["川","かわ"],["の"],["北","きた"],["で"],["、"],["その"],["終わり","おわり"],["は"],["海","うみ"],["で"],["あった"],["。"]]},{"verse":10,"text":"その南は、エフライムのもの、北はマナセのものであった。海がその境界となった。マナセは、北はアシェルに、東はイッサカルに達していた。","tok":[["その"],["南","みなみ"],["は"],["、"],["エフライム"],["の"],["もの"],["、"],["北","きた"],["は"],["マナセ"],["の"],["もの"],["で"],["あった"],["。"],["海","うみ"],["が"],["その"],["境界","きょうかい"],["と"],["なった"],["。"],["マナセ"],["は"],["、"],["北","きた"],["は"],["アシェル"],["に"],["、"],["東","ひがし"],["は"],["イッサカル"],["に"],["達して","たっして"],["いた"],["。"]]},{"verse":11,"text":"またマナセには、イッサカルとアシェルの中に、ベテ・シェアンとそれに属する村落、イブレアムとそれに属する村落、ドルの住民とそれに属する村落、エン・ドルの住民とそれに属する村落、タナクの住民とそれに属する村落、メギドの住民とそれに属する村落があった。この第三番目は高地であった。","tok":[["また"],["マナセ"],["に"],["は"],["、"],["イッサカル"],["と"],["アシェル"],["の"],["中","なか"],["に"],["、"],["ベテ"],["・"],["シェアン"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["イブレアム"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["ドル"],["の"],["住民","じゅうみん"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["エン"],["・"],["ドル"],["の"],["住民","じゅうみん"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["タナク"],["の"],["住民","じゅうみん"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["メギド"],["の"],["住民","じゅうみん"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["が"],["あった"],["。"],["この"],["第","だい"],["三番目","さんばんめ"],["は"],["高地","こうち"],["で"],["あった"],["。"]]},{"verse":12,"text":"しかしマナセ族は、これらの町々を占領することができなかった。カナン人はこの土地に住みとおした。","tok":[["しかし"],["マナセ族","まなせぞく"],["は"],["、"],["これ"],["ら"],["の"],["町々","まちまち"],["を"],["占領","せんりょう"],["する"],["こと"],["が"],["できなかった"],["。"],["カナン人","かなんにん"],["は"],["この"],["土地","とち"],["に"],["住み","すみ"],["とおした"],["。"]]},{"verse":13,"text":"イスラエル人は、強くなってから、カナン人に苦役を課したが、彼らを追い払ってしまうことはなかった。","tok":[["イスラエル"],["人","にん"],["は"],["、"],["強く","つよく"],["なって"],["から"],["、"],["カナン人","かなんにん"],["に"],["苦役","くえき"],["を"],["課した","かした"],["が"],["、"],["彼","かれ"],["ら"],["を"],["追い払って","おいはらって"],["しまう"],["こと"],["は"],["なかった"],["。"]]},{"verse":14,"text":"ヨセフ族はヨシュアに告げて言った。「主が今まで私を祝福されたので、私は数の多い民になりました。あなたはなぜ、私にただ一つのくじによる相続地、ただ一つの割り当て地しか分けてくださらなかったのですか。」","tok":[["ヨセフ族","よせふぞく"],["は"],["ヨシュア"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["今まで","いままで"],["私","わたくし"],["を"],["祝福","しゅくふく"],["された"],["ので"],["、"],["私","わたくし"],["は"],["数","すう"],["の"],["多い","おおい"],["民","たみ"],["に"],["なりました"],["。"],["あなた"],["は"],["なぜ"],["、"],["私","わたくし"],["に"],["ただ"],["一","ひと"],["つ"],["の"],["くじ"],["に"],["よる"],["相続","そうぞく"],["地","ち"],["、"],["ただ"],["一","ひと"],["つ"],["の"],["割り当て","わりあて"],["地","ち"],["しか"],["分けて","わけて"],["くださらなかった"],["の"],["です"],["か"],["。"],["」"]]},{"verse":15,"text":"ヨシュアは彼らに言った。「もしもあなたが数の多い民であるなら、ペリジ人やレファイム人の地の森に上って行って、そこを自分で切り開くがよい。エフライムの山地は、あなたには狭すぎるのだから。」","tok":[["ヨシュア"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["もし"],["も"],["あなた"],["が"],["数","かず"],["の"],["多い","おおい"],["民","たみ"],["で"],["あるなら"],["、"],["ペリジ人","ぺりじにん"],["や"],["レファイム"],["人","にん"],["の"],["地","ち"],["の"],["森","もり"],["に"],["上って","のぼって"],["行って","いって"],["、"],["そこ"],["を"],["自分","じぶん"],["で"],["切り開く","きりひらく"],["が"],["よい"],["。"],["エフライム"],["の"],["山地","さんち"],["は"],["、"],["あなた"],["に"],["は"],["狭","せま"],["すぎる"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":16,"text":"ヨセフ族は答えた。「山地は私どもには十分ではありません。それに、谷間の地に住んでいるカナン人も、ベテ・シェアンとそれに属する村落にいる者も、イズレエルの谷にいる者もみな、鉄の戦車を持っています。」","tok":[["ヨセフ族","よせふぞく"],["は"],["答えた","こたえた"],["。"],["「"],["山地","さんち"],["は"],["私","わたくし"],["ども"],["に"],["は"],["十分","じゅうぶん"],["で"],["は"],["ありません"],["。"],["それ"],["に"],["、"],["谷間","たにま"],["の"],["地","ち"],["に"],["住んで","すんで"],["いる"],["カナン人","かなんにん"],["も"],["、"],["ベテ"],["・"],["シェアン"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["に"],["いる"],["者","もの"],["も"],["、"],["イズレエル"],["の"],["谷","たに"],["に"],["いる"],["者","もの"],["も"],["みな"],["、"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["を"],["持って","もって"],["います"],["。"],["」"]]},{"verse":17,"text":"するとヨシュアは、ヨセフ家の者、エフライムとマナセにこう言った。「あなたは数の多い民で、大きな力を持っている。あなたは、ただ一つのくじによる割り当て地だけを持っていてはならない。","tok":[["する"],["と"],["ヨシュア"],["は"],["、"],["ヨセフ家","よせふか"],["の"],["者","もの"],["、"],["エフライム"],["と"],["マナセ"],["に"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["は"],["数","すう"],["の"],["多い","おおい"],["民","たみ"],["で"],["、"],["大きな","おおきな"],["力","ちから"],["を"],["持って","もって"],["いる"],["。"],["あなた"],["は"],["、"],["ただ"],["一","ひと"],["つ"],["の"],["くじ"],["に"],["よる"],["割り当て","わりあて"],["地","ち"],["だけ"],["を"],["持って","もって"],["いて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"山地もあなたのものとしなければならない。それが森であっても、切り開いて、その終わる所まで、あなたのものとしなければならない。カナン人は鉄の戦車を持っていて、強いのだから、あなたは彼らを追い払わなければならないのだ。」","tok":[["山地","さんち"],["も"],["あなた"],["の"],["もの"],["と"],["しなければ"],["ならない"],["。"],["それ"],["が"],["森","もり"],["で"],["あって"],["も"],["、"],["切り開いて","きりひらいて"],["、"],["その"],["終わる","おわる"],["所","ところ"],["まで"],["、"],["あなた"],["の"],["もの"],["と"],["しなければ"],["ならない"],["。"],["カナン人","かなんにん"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["を"],["持って","もって"],["いて"],["、"],["強い","つよい"],["の"],["だ"],["から"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["追い払わなければ","おいはらわなければ"],["ならない"],["の"],["だ"],["。"],["」"]]}]
[{"verse":1,"text":"ヨルダン川のこちら側、西のほうにいたエモリ人のすべての王たちと、海辺にいるカナン人のすべての王たちとは、主がイスラエル人の前でヨルダン川の水をからし、ついに彼らが渡って来たことを聞いて、イスラエル人のために彼らの心がしなえ、彼らのうちに、もはや勇気がなくなってしまった。","tok":[["ヨルダン"],["川","かわ"],["の"],["こちら側","こちらがわ"],["、"],["西","にし"],["の"],["ほう"],["に"],["いた"],["エモリ人","えもりにん"],["の"],["すべて"],["の"],["王","おう"],["たち"],["と"],["、"],["海辺","うみべ"],["に"],["いる"],["カナン人","かなんにん"],["の"],["すべて"],["の"],["王","おう"],["たち"],["と"],["は"],["、"],["主","ぬし"],["が"],["イスラエル"],["人","にん"],["の"],["前","まえ"],["で"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["を"],["からし"],["、"],["ついに"],["彼","かれ"],["ら"],["が"],["渡って","わたって"],["来た","きた"],["こと"],["を"],["聞いて","きいて"],["、"],["イスラエル"],["人","にん"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["の"],["心","こころ"],["が"],["しなえ"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["、"],["もはや"],["勇気","ゆうき"],["が"],["なくなって"],["しまった"],["。"]]},{"verse":2,"text":"そのとき、主はヨシュアに仰せられた。「火打石の小刀を作り、もう一度イスラエル人に割礼をせよ。」","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["ヨシュア"],["に"],["仰せられた","おおせられた"],["。"],["「"],["火打石","ひうちいし"],["の"],["小刀","こがたな"],["を"],["作り","つくり"],["、"],["もう"],["一度","いちど"],["イスラエル"],["人","にん"],["に"],["割礼","かつれい"],["を"],["せよ"],["。"],["」"]]},{"verse":3,"text":"そこで、ヨシュアは自分で火打石の小刀を作り、ギブアテ・ハアラロテで、イスラエル人に割礼を施した。","tok":[["そこ"],["で"],["、"],["ヨシュア"],["は"],["自分","じぶん"],["で"],["火打石","ひうちいし"],["の"],["小刀","こがたな"],["を"],["作り","つくり"],["、"],["ギブアテ"],["・"],["ハアラロテ"],["で"],["、"],["イスラエル"],["人","にん"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["。"]]},{"verse":4,"text":"ヨシュアがすべての民に割礼を施した理由はこうである。エジプトから出て来た者のうち、男子、すなわち戦士たちはすべて、エジプトを出て後、途中、荒野で死んだ。","tok":[["ヨシュア"],["が"],["すべて"],["の"],["民","たみ"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["理由","りゆう"],["は"],["こう"],["で"],["ある"],["。"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["者","もの"],["の"],["うち"],["、"],["男子","だんし"],["、"],["すなわち"],["戦士","せんし"],["たち"],["は"],["すべて"],["、"],["エジプト"],["を"],["出て","でて"],["後","あと"],["、"],["途中","とちゅう"],["、"],["荒野","こうや"],["で"],["死んだ","しんだ"],["。"]]},{"verse":5,"text":"その出て来た民は、すべて割礼を受けていたが、エジプトを出て後、途中、荒野で生まれた民は、だれも割礼を受けていなかったからである。","tok":[["その"],["出て","でて"],["来た","きた"],["民","たみ"],["は"],["、"],["すべて"],["割礼","かつれい"],["を"],["受けて","うけて"],["いた"],["が"],["、"],["エジプト"],["を"],["出て","でて"],["後","あと"],["、"],["途中","とちゅう"],["、"],["荒野","こうや"],["で"],["生まれた","うまれた"],["民","たみ"],["は"],["、"],["だれ"],["も"],["割礼","かつれい"],["を"],["受けて","うけて"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"イスラエル人は、四十年間、荒野を旅していて、エジプトから出て来た民、すなわち戦士たちは、ことごとく死に絶えてしまったからである。彼らは主の御声に聞き従わなかったので、主が私たちに与えると彼らの先祖たちに誓われた地、乳と蜜の流れる地を、主は彼らには見せないと誓われたのであった。","tok":[["イスラエル"],["人","にん"],["は"],["、"],["四十","よんじゅう"],["年間","ねんかん"],["、"],["荒野","こうや"],["を"],["旅","たび"],["して"],["いて"],["、"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["民","たみ"],["、"],["すなわち"],["戦士","せんし"],["たち"],["は"],["、"],["ことごとく"],["死に絶えて","しにたえて"],["しまった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["ので"],["、"],["主","ぬし"],["が"],["私たち","わたしたち"],["に"],["与える","あたえる"],["と"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["地","ち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["を"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["に"],["は"],["見せない","みせない"],["と"],["誓われた","ちかわれた"],["ので"],["あった"],["。"]]},{"verse":7,"text":"主は彼らに代わって、その息子たちを起こされた。ヨシュアは、彼らが無割礼の者で、途中で割礼を受けていなかったので、彼らに割礼を施した。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["に"],["代わって","かわって"],["、"],["その"],["息子","むすこ"],["たち"],["を"],["起こされた","おこされた"],["。"],["ヨシュア"],["は"],["、"],["彼","かれ"],["ら"],["が"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["で"],["、"],["途中","とちゅう"],["で"],["割礼","かつれい"],["を"],["受けて","うけて"],["いなかった"],["ので"],["、"],["彼","かれ"],["ら"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["。"]]},{"verse":8,"text":"民のすべてが割礼を完了したとき、彼らは傷が直るまで、宿営の自分たちのところにとどまった。","tok":[["民","みん"],["の"],["すべて"],["が"],["割礼","かつれい"],["を"],["完了","かんりょう"],["した"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["傷","きず"],["が"],["直る","なおる"],["まで"],["、"],["宿営","しゅくえい"],["の"],["自分","じぶん"],["たち"],["の"],["ところ"],["に"],["とどまった"],["。"]]},{"verse":9,"text":"すると、主はヨシュアに仰せられた。「きょう、わたしはエジプトのそしりを、あなたがたから取り除いた。」それで、その所の名は、ギルガルと呼ばれた。今日もそうである。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["ヨシュア"],["に"],["仰せられた","おおせられた"],["。"],["「"],["きょう"],["、"],["わたし"],["は"],["エジプト"],["の"],["そ"],["しり"],["を"],["、"],["あなた"],["がた"],["から"],["取り除いた","とりのぞいた"],["。"],["」"],["それ"],["で"],["、"],["その"],["所","ところ"],["の"],["名","な"],["は"],["、"],["ギルガル"],["と"],["呼ばれた","よばれた"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":10,"text":"イスラエル人が、ギルガルに宿営しているとき、その月の十四日の夕方、エリコの草原で彼らは過越のいけにえをささげた。","tok":[["イスラエル"],["人","にん"],["が"],["、"],["ギルガル"],["に"],["宿営","しゅくえい"],["して"],["いる"],["とき"],["、"],["その"],["月","つき"],["の"],["十四日","じゅうよんか"],["の"],["夕方","ゆうがた"],["、"],["エリコ"],["の"],["草原","そうげん"],["で"],["彼","かれ"],["ら"],["は"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":11,"text":"過越のいけにえをささげた翌日、彼らはその地の産物、「種を入れないパン」と、炒り麦を食べた。その日のうちであった。","tok":[["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげた"],["翌日","よくじつ"],["、"],["彼","かれ"],["ら"],["は"],["その"],["地","ち"],["の"],["産物","さんぶつ"],["、"],["「"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["」"],["と"],["、"],["炒り","いり"],["麦","むぎ"],["を"],["食べた","たべた"],["。"],["その"],["日","ひ"],["の"],["うち"],["で"],["あった"],["。"]]},{"verse":12,"text":"彼らがその地の産物を食べた翌日から、マナの降ることはやみ、イスラエル人には、もうマナはなかった。それで、彼らはその年のうちにカナンの地で収穫した物を食べた。","tok":[["彼","かれ"],["ら"],["が"],["その"],["地","ち"],["の"],["産物","さんぶつ"],["を"],["食べた","たべた"],["翌日","よくじつ"],["から"],["、"],["マナ"],["の"],["降る","ふる"],["こと"],["は"],["やみ"],["、"],["イスラエル"],["人","にん"],["に"],["は"],["、"],["もう"],["マナ"],["は"],["なかった"],["。"],["それ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["その"],["年","とし"],["の"],["うち"],["に"],["カナン"],["の"],["地","ち"],["で"],["収穫","しゅうかく"],["した"],["物","もの"],["を"],["食べた","たべた"],["。"]]},{"verse":13,"text":"さて、ヨシュアがエリコの近くにいたとき、彼が目を上げて見ると、見よ、ひとりの人が抜き身の剣を手に持って、彼の前方に立っていた。ヨシュアはその人のところへ行って、言った。「あなたは、私たちの味方ですか。それとも私たちの敵なのですか。」","tok":[["さて"],["、"],["ヨシュア"],["が"],["エリコ"],["の"],["近く","ちかく"],["に"],["いた"],["とき"],["、"],["彼","かれ"],["が"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["抜き身","ぬきみ"],["の"],["剣","けん"],["を"],["手","て"],["に"],["持って","もって"],["、"],["彼","かれ"],["の"],["前方","ぜんぽう"],["に"],["立って","たって"],["いた"],["。"],["ヨシュア"],["は"],["その"],["人","ひと"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["私たち","わたしたち"],["の"],["味方","みかた"],["です"],["か"],["。"],["それ"],["と"],["も"],["私たち","わたしたち"],["の"],["敵","てき"],["な"],["の"],["です"],["か"],["。"],["」"]]},{"verse":14,"text":"すると彼は言った。「いや、わたしは主の軍の将として、今、来たのだ。」そこで、ヨシュアは顔を地につけて伏し拝み、彼に言った。「わが主は、何をそのしもべに告げられるのですか。」","tok":[["する"],["と"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["いや"],["、"],["わたし"],["は"],["主","ぬし"],["の"],["軍","ぐん"],["の"],["将","しょう"],["として"],["、"],["今","いま"],["、"],["来た","きた"],["の"],["だ"],["。"],["」"],["そこ"],["で"],["、"],["ヨシュア"],["は"],["顔","かお"],["を"],["地","ち"],["に"],["つけて"],["伏し拝み","ふしおがみ"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["わが"],["主","ぬし"],["は"],["、"],["何","なん"],["を"],["その"],["しもべ"],["に"],["告げられる","つげられる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":15,"text":"すると、主の軍の将はヨシュアに言った。「あなたの足のはきものを脱げ。あなたの立っている場所は聖なる所である。」そこで、ヨシュアはそのようにした。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["軍","ぐん"],["の"],["将","しょう"],["は"],["ヨシュア"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["足","あし"],["の"],["はきもの"],["を"],["脱げ","ぬげ"],["。"],["あなた"],["の"],["立って","たって"],["いる"],["場所","ばしょ"],["は"],["聖","せい"],["なる"],["所","ところ"],["で"],["ある"],["。"],["」"],["そこ"],["で"],["、"],["ヨシュア"],["は"],["その"],["よう"],["に"],["した"],["。"]]}]
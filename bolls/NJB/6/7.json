[{"verse":1,"text":"しかしイスラエルの子らは、聖絶のもののことで不信の罪を犯し、ユダ部族のゼラフの子ザブディの子であるカルミの子アカンが、聖絶のもののいくらかを取った。そこで、主の怒りはイスラエル人に向かって燃え上がった。","tok":[["しかし"],["イスラエル"],["の"],["子","こ"],["ら"],["は"],["、"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["の"],["こと"],["で"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["ユダ"],["部族","ぶぞく"],["の"],["ゼラフ"],["の"],["子","こ"],["ザブディ"],["の"],["子","こ"],["で"],["ある"],["カルミ"],["の"],["子","こ"],["アカン"],["が"],["、"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["の"],["いくら"],["か"],["を"],["取った","とった"],["。"],["そこ"],["で"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["イスラエル"],["人","にん"],["に"],["向かって","むかって"],["燃え上がった","もえあがった"],["。"]]},{"verse":2,"text":"ヨシュアはエリコから人々をベテルの東、ベテ・アベンの近くにあるアイに遣わすとき、その人々に次のように言った。「上って行って、あの地を偵察して来なさい。」そこで、人々は上って行って、アイを偵察した。","tok":[["ヨシュア"],["は"],["エリコ"],["から"],["人々","ひとびと"],["を"],["ベテル"],["の"],["東","ひがし"],["、"],["ベテ"],["・"],["アベン"],["の"],["近く","ちかく"],["に"],["ある"],["アイ"],["に"],["遣わす","つかわす"],["とき"],["、"],["その"],["人々","ひとびと"],["に"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"],["「"],["上って","のぼって"],["行って","いって"],["、"],["あの"],["地","ち"],["を"],["偵察","ていさつ"],["して"],["来","き"],["なさい"],["。"],["」"],["そこ"],["で"],["、"],["人々","ひとびと"],["は"],["上って","のぼって"],["行って","いって"],["、"],["アイ"],["を"],["偵察","ていさつ"],["した"],["。"]]},{"verse":3,"text":"彼らはヨシュアのもとに帰って来て言った。「民を全部行かせないでください。二、三千人ぐらいを上らせて、アイを打たせるといいでしょう。彼らはわずかなのですから、民を全部やって、骨折らせるようなことはしないでください。」","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["の"],["もと"],["に"],["帰って","かえって"],["来て","きて"],["言った","いった"],["。"],["「"],["民","みん"],["を"],["全部","ぜんぶ"],["行かせないで","いかせないで"],["ください"],["。"],["二","に"],["、"],["三千人","さんせんにん"],["ぐらい"],["を"],["上らせて","のぼらせて"],["、"],["アイ"],["を"],["打たせる","うたせる"],["と"],["いいでしょう"],["。"],["彼","かれ"],["ら"],["は"],["わずか"],["な"],["の"],["です"],["から"],["、"],["民","みん"],["を"],["全部","ぜんぶ"],["やって"],["、"],["骨折らせる","ほねおらせる"],["よう"],["な"],["こと"],["は"],["しないで"],["ください"],["。"],["」"]]},{"verse":4,"text":"そこで、民のうち、およそ三千人がそこに上ったが、彼らはアイの人々の前から逃げた。","tok":[["そこ"],["で"],["、"],["民","みん"],["の"],["うち"],["、"],["およそ"],["三千人","さんせんにん"],["が"],["そこ"],["に"],["上った","のぼった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["アイ"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["から"],["逃げた","にげた"],["。"]]},{"verse":5,"text":"アイの人々は、彼らの中の約三十六人を打ち殺し、彼らを門の前からシェバリムまで追って、下り坂で彼らを打ったので、民の心がしなえ、水のようになった。","tok":[["アイ"],["の"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["の"],["約","やく"],["三十六人","さんじゅうろくにん"],["を"],["打ち殺し","うちころし"],["、"],["彼","かれ"],["ら"],["を"],["門","もん"],["の"],["前","まえ"],["から"],["シェバリム"],["まで"],["追って","おって"],["、"],["下り坂","くだりざか"],["で"],["彼","かれ"],["ら"],["を"],["打った","うった"],["ので"],["、"],["民","みん"],["の"],["心","こころ"],["が"],["しなえ"],["、"],["水","みず"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":6,"text":"ヨシュアは着物を裂き、イスラエルの長老たちといっしょに、主の箱の前で、夕方まで地にひれ伏し、自分たちの頭にちりをかぶった。","tok":[["ヨシュア"],["は"],["着物","きもの"],["を"],["裂き","さき"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["と"],["いっしょ"],["に"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["の"],["前","まえ"],["で"],["、"],["夕方","ゆうがた"],["まで"],["地","ち"],["に"],["ひれ伏し","ひれふし"],["、"],["自分","じぶん"],["たち"],["の"],["頭","あたま"],["に"],["ちり"],["を"],["かぶった"],["。"]]},{"verse":7,"text":"ヨシュアは言った。「ああ、神、主よ。あなたはどうしてこの民にヨルダン川をあくまでも渡らせて、私たちをエモリ人の手に渡して、滅ぼそうとされるのですか。私たちは心を決めてヨルダン川の向こう側に居残ればよかったのです。","tok":[["ヨシュア"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["どう"],["して"],["この"],["民","たみ"],["に"],["ヨルダン"],["川","かわ"],["を"],["あくまで"],["も"],["渡らせて","わたらせて"],["、"],["私たち","わたしたち"],["を"],["エモリ人","えもりにん"],["の"],["手","て"],["に"],["渡して","わたして"],["、"],["滅ぼそう","ほろぼそう"],["と"],["される"],["の"],["です"],["か"],["。"],["私たち","わたしたち"],["は"],["心","こころ"],["を"],["決めて","きめて"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["に"],["居残れば","いのこれば"],["よかった"],["の"],["です"],["。"]]},{"verse":8,"text":"ああ、主よ。イスラエルが敵の前に背を見せた今となっては、何を申し上げることができましょう。","tok":[["ああ"],["、"],["主","ぬし"],["よ"],["。"],["イスラエル"],["が"],["敵","てき"],["の"],["前","まえ"],["に"],["背","せ"],["を"],["見せた","みせた"],["今","いま"],["と"],["なって"],["は"],["、"],["何","なん"],["を"],["申し上げる","もうしあげる"],["こと"],["が"],["できましょう"],["。"]]},{"verse":9,"text":"カナン人や、この地の住民がみな、これを聞いて、私たちを攻め囲み、私たちの名を地から断ってしまうでしょう。あなたは、あなたの大いなる御名のために何をなさろうとするのですか。」","tok":[["カナン人","かなんにん"],["や"],["、"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["が"],["みな"],["、"],["これ"],["を"],["聞いて","きいて"],["、"],["私たち","わたしたち"],["を"],["攻め囲み","せめかこみ"],["、"],["私たち","わたしたち"],["の"],["名","な"],["を"],["地","ち"],["から"],["断って","ことわって"],["しまうでしょう"],["。"],["あなた"],["は"],["、"],["あなた"],["の"],["大いなる","おおいなる"],["御名","ぎょめい"],["の"],["ため"],["に"],["何","なん"],["を"],["なさろう"],["と"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":10,"text":"主はヨシュアに仰せられた。／「立て。あなたはどうしてそのようにひれ伏しているのか。","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["仰せられた","おおせられた"],["。"],["／"],["「"],["立て","たて"],["。"],["あなた"],["は"],["どう"],["して"],["その"],["よう"],["に"],["ひれ伏して","ひれふして"],["いる"],["の"],["か"],["。"]]},{"verse":11,"text":"イスラエルは罪を犯した。現に、彼らは、わたしが彼らに命じたわたしの契約を破り、聖絶のものの中から取り、盗み、偽って、それを自分たちのものの中に入れさえした。","tok":[["イスラエル"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["現に","げんに"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["わたし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["の"],["中","なか"],["から"],["取り","とり"],["、"],["盗み","ぬすみ"],["、"],["偽って","いつわって"],["、"],["それ"],["を"],["自分","じぶん"],["たち"],["の"],["もの"],["の"],["中","なか"],["に"],["入れ","いれ"],["さえ"],["した"],["。"]]},{"verse":12,"text":"だから、イスラエル人は敵の前に立つことができず、敵に背を見せたのだ。彼らが聖絶のものとなったからである。あなたがたのうちから、その聖絶のものを一掃してしまわないなら、わたしはもはやあなたがたとともにはいない。","tok":[["だ"],["から"],["、"],["イスラエル"],["人","にん"],["は"],["敵","てき"],["の"],["前","まえ"],["に"],["立つ","たつ"],["こと"],["が"],["できず"],["、"],["敵","てき"],["に"],["背","せ"],["を"],["見せた","みせた"],["の"],["だ"],["。"],["彼","かれ"],["ら"],["が"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["と"],["なった"],["から"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["うち"],["から"],["、"],["その"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["を"],["一掃","いっそう"],["して"],["しまわないなら"],["、"],["わたし"],["は"],["もはや"],["あなた"],["がた"],["と"],["とも"],["に"],["は"],["いない"],["。"]]},{"verse":13,"text":"立て。民をきよめよ。そして言え。／あなたがたは、あすのために身をきよめなさい。イスラエルの神、主がこう仰せられるからだ。『イスラエルよ。あなたのうちに、聖絶のものがある。あなたがたがその聖絶のものを、あなたがたのうちから除き去るまで、敵の前に立つことはできない。","tok":[["立て","たて"],["。"],["民","たみ"],["を"],["きよめよ"],["。"],["そして"],["言え","いえ"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["あす"],["の"],["ため"],["に"],["身","み"],["を"],["きよめ"],["なさい"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["こう"],["仰せられる","おおせられる"],["から"],["だ"],["。"],["『"],["イスラエル"],["よ"],["。"],["あなた"],["の"],["うち"],["に"],["、"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["が"],["ある"],["。"],["あなた"],["がた"],["が"],["その"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["を"],["、"],["あなた"],["がた"],["の"],["うち"],["から"],["除き去る","のぞきさる"],["まで"],["、"],["敵","てき"],["の"],["前","まえ"],["に"],["立つ","たつ"],["こと"],["は"],["できない"],["。"]]},{"verse":14,"text":"あしたの朝、あなたがたは部族ごとに進み出なければならない。主がくじで取り分ける部族は、氏族ごとに進みいで、主が取り分ける氏族は、家族ごとに進みいで、主が取り分ける家族は、男ひとりひとり進み出なければならない。","tok":[["あした"],["の"],["朝","あさ"],["、"],["あなた"],["がた"],["は"],["部族","ぶぞく"],["ごと"],["に"],["進み出なければ","すすみでなければ"],["ならない"],["。"],["主","ぬし"],["が"],["くじ"],["で"],["取り分ける","とりわける"],["部族","ぶぞく"],["は"],["、"],["氏族","しぞく"],["ごと"],["に"],["進み","すすみ"],["いで"],["、"],["主","ぬし"],["が"],["取り分ける","とりわける"],["氏族","しぞく"],["は"],["、"],["家族","かぞく"],["ごと"],["に"],["進み","すすみ"],["いで"],["、"],["主","ぬし"],["が"],["取り分ける","とりわける"],["家族","かぞく"],["は"],["、"],["男","おとこ"],["ひとりひとり"],["進み出なければ","すすみでなければ"],["ならない"],["。"]]},{"verse":15,"text":"その聖絶のものを持っている者が取り分けられたなら、その者は、所有物全部といっしょに、火で焼かれなければならない。彼が主の契約を破り、イスラエルの中で恥辱になることをしたからである。』」","tok":[["その"],["聖","せい"],["絶","ぜっ"],["の"],["もの"],["を"],["持って","もって"],["いる"],["者","もの"],["が"],["取り分けられたなら","とりわけられたなら"],["、"],["その"],["者","もの"],["は"],["、"],["所有物","しょゆうぶつ"],["全部","ぜんぶ"],["と"],["いっしょ"],["に"],["、"],["火","ひ"],["で"],["焼かれなければ","やかれなければ"],["ならない"],["。"],["彼","かれ"],["が"],["主","ぬし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["イスラエル"],["の"],["中","なか"],["で"],["恥辱","ちじょく"],["に"],["なる"],["こと"],["を"],["した"],["から"],["で"],["ある"],["。"],["』"],["」"]]},{"verse":16,"text":"そこで、ヨシュアは翌朝早く、イスラエルを部族ごとに進み出させた。するとユダの部族がくじで取り分けられた。","tok":[["そこ"],["で"],["、"],["ヨシュア"],["は"],["翌朝","よくあさ"],["早く","はやく"],["、"],["イスラエル"],["を"],["部族","ぶぞく"],["ごと"],["に"],["進み","すすみ"],["出させた","ださせた"],["。"],["する"],["と"],["ユダ"],["の"],["部族","ぶぞく"],["が"],["くじ"],["で"],["取り分けられた","とりわけられた"],["。"]]},{"verse":17,"text":"ユダの氏族を進み出させると、ゼラフ人の氏族が取られた。ゼラフ人の氏族を男ひとりひとり進み出させると、ザブディが取られた。","tok":[["ユダ"],["の"],["氏族","しぞく"],["を"],["進み","すすみ"],["出させる","ださせる"],["と"],["、"],["ゼラフ人","ぜらふにん"],["の"],["氏族","しぞく"],["が"],["取られた","とられた"],["。"],["ゼラフ人","ぜらふにん"],["の"],["氏族","しぞく"],["を"],["男","おとこ"],["ひとりひとり"],["進み出させる","すすみでさせる"],["と"],["、"],["ザブディ"],["が"],["取られた","とられた"],["。"]]},{"verse":18,"text":"ザブディの家族を男ひとりひとり進み出させると、ユダの部族のゼラフの子ザブディの子カルミの子のアカンが取られた。","tok":[["ザブディ"],["の"],["家族","かぞく"],["を"],["男","おとこ"],["ひとりひとり"],["進み出させる","すすみでさせる"],["と"],["、"],["ユダ"],["の"],["部族","ぶぞく"],["の"],["ゼラフ"],["の"],["子","こ"],["ザブディ"],["の"],["子","こ"],["カルミ"],["の"],["子","こ"],["の"],["アカン"],["が"],["取られた","とられた"],["。"]]},{"verse":19,"text":"そこで、ヨシュアはアカンに言った。「わが子よ。イスラエルの神、主に栄光を帰し、主に告白しなさい。あなたが何をしたのか私に告げなさい。私に隠してはいけない。」","tok":[["そこ"],["で"],["、"],["ヨシュア"],["は"],["アカン"],["に"],["言った","いった"],["。"],["「"],["わが"],["子","こ"],["よ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["栄光","えいこう"],["を"],["帰し","かえし"],["、"],["主に","おもに"],["告白","こくはく"],["し"],["なさい"],["。"],["あなた"],["が"],["何","なん"],["を"],["した"],["の"],["か"],["私","わたくし"],["に"],["告げ","つげ"],["なさい"],["。"],["私","わたくし"],["に"],["隠して","かくして"],["は"],["いけない"],["。"],["」"]]},{"verse":20,"text":"アカンはヨシュアに答えて言った。「ほんとうに、私はイスラエルの神、主に対して罪を犯しました。私は次のようなことをいたしました。","tok":[["アカン"],["は"],["ヨシュア"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["ほんとう"],["に"],["、"],["私","わたくし"],["は"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["対して","たいして"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["私","わたくし"],["は"],["次","つぎ"],["の"],["よう"],["な"],["こと"],["を"],["いたしました"],["。"]]},{"verse":21,"text":"私は、分捕り物の中に、シヌアルの美しい外套一枚と、銀二百シェケルと、目方五十シェケルの金の延べ棒一本があるのを見て、欲しくなり、それらを取りました。それらは今、私の天幕の中の地に隠してあり、銀はその下にあります。」","tok":[["私","わたくし"],["は"],["、"],["分","ぶん"],["捕り物","とりもの"],["の"],["中","なか"],["に"],["、"],["シヌアル"],["の"],["美しい","うつくしい"],["外套","がいとう"],["一枚","いちまい"],["と"],["、"],["銀","ぎん"],["二百","にひゃく"],["シェケル"],["と"],["、"],["目方","めかた"],["五十","ごじゅう"],["シェケル"],["の"],["金","かね"],["の"],["延べ棒","のべぼう"],["一本","いちぽん"],["が"],["ある"],["の"],["を"],["見て","みて"],["、"],["欲しく","ほしく"],["なり"],["、"],["それ"],["ら"],["を"],["取りました","とりました"],["。"],["それ"],["ら"],["は"],["今","いま"],["、"],["私","わたくし"],["の"],["天幕","てんまく"],["の"],["中","なか"],["の"],["地","ち"],["に"],["隠して","かくして"],["あり"],["、"],["銀","ぎん"],["は"],["その"],["下","した"],["に"],["あります"],["。"],["」"]]},{"verse":22,"text":"そこで、ヨシュアが使いたちを遣わした。彼らは天幕に走って行った。そして、見よ、それらが彼の天幕に隠してあって、銀はその下にあった。","tok":[["そこ"],["で"],["、"],["ヨシュア"],["が"],["使い","つかい"],["たち"],["を"],["遣わした","つかわした"],["。"],["彼","かれ"],["ら"],["は"],["天幕","てんまく"],["に"],["走って","はしって"],["行った","いった"],["。"],["そして"],["、"],["見よ","みよ"],["、"],["それ"],["ら"],["が"],["彼","かれ"],["の"],["天幕","てんまく"],["に"],["隠して","かくして"],["あって"],["、"],["銀","ぎん"],["は"],["その"],["下","した"],["に"],["あった"],["。"]]},{"verse":23,"text":"彼らは、それらを天幕の中から取り出して、ヨシュアと全イスラエル人のところに持って来た。彼らは、それらを主の前に置いた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["それ"],["ら"],["を"],["天幕","てんまく"],["の"],["中","なか"],["から"],["取り出して","とりだして"],["、"],["ヨシュア"],["と"],["全","ぜん"],["イスラエル"],["人","にん"],["の"],["ところ"],["に"],["持って","もって"],["来た","きた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["それ"],["ら"],["を"],["主","ぬし"],["の"],["前","まえ"],["に"],["置いた","おいた"],["。"]]},{"verse":24,"text":"ヨシュアは全イスラエルとともに、ゼラフの子アカンと、銀や、外套、金の延べ棒、および彼の息子、娘、牛、ろば、羊、天幕、それに、彼の所有物全部を取って、アコルの谷へ連れて行った。","tok":[["ヨシュア"],["は"],["全","ぜん"],["イスラエル"],["と"],["とも"],["に"],["、"],["ゼラフ"],["の"],["子","こ"],["アカン"],["と"],["、"],["銀","ぎん"],["や"],["、"],["外套","がいとう"],["、"],["金","きん"],["の"],["延べ棒","のべぼう"],["、"],["および"],["彼","かれ"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["牛","うし"],["、"],["ろば"],["、"],["羊","ひつじ"],["、"],["天幕","てんまく"],["、"],["それ"],["に"],["、"],["彼","かれ"],["の"],["所有物","しょゆうぶつ"],["全部","ぜんぶ"],["を"],["取って","とって"],["、"],["アコル"],["の"],["谷","たに"],["へ"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":25,"text":"そこでヨシュアは言った。「なぜあなたは私たちにわざわいをもたらしたのか。主は、きょう、あなたにわざわいをもたらされる。」全イスラエルは彼を石で打ち殺し、彼らのものを火で焼き、それらに石を投げつけた。","tok":[["そこ"],["で"],["ヨシュア"],["は"],["言った","いった"],["。"],["「"],["なぜ"],["あなた"],["は"],["私たち","わたしたち"],["に"],["わざわい"],["を"],["もたらした"],["の"],["か"],["。"],["主","ぬし"],["は"],["、"],["きょう"],["、"],["あなた"],["に"],["わざわい"],["を"],["もたらされる"],["。"],["」"],["全","ぜん"],["イスラエル"],["は"],["彼","かれ"],["を"],["石","いし"],["で"],["打ち殺し","うちころし"],["、"],["彼","かれ"],["ら"],["の"],["もの"],["を"],["火","ひ"],["で"],["焼き","やき"],["、"],["それ"],["ら"],["に"],["石","いし"],["を"],["投げつけた","なげつけた"],["。"]]},{"verse":26,"text":"こうして彼らは、アカンの上に、大きな、石くれの山を積み上げた。今日もそのままである。そこで、主は燃える怒りをやめられた。そういうわけで、その所の名は、アコルの谷と呼ばれた。今日もそうである。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["アカン"],["の"],["上","うえ"],["に"],["、"],["大きな","おおきな"],["、"],["石くれ","いしくれ"],["の"],["山","やま"],["を"],["積み上げた","つみあげた"],["。"],["今日","きょう"],["も"],["そのまま"],["で"],["ある"],["。"],["そこ"],["で"],["、"],["主","ぬし"],["は"],["燃える","もえる"],["怒り","いかり"],["を"],["やめられた"],["。"],["そう"],["いう"],["わけ"],["で"],["、"],["その"],["所","ところ"],["の"],["名","な"],["は"],["、"],["アコル"],["の"],["谷","たに"],["と"],["呼ばれた","よばれた"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"]]}]
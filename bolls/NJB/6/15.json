[{"verse":1,"text":"ユダ族の諸氏族が、くじで割り当てられた地は、エドムの国境に至り、その南端は、南のほうのツィンの荒野であった。","tok":[["ユダ族","ゆだぞく"],["の"],["諸","しょ"],["氏族","しぞく"],["が"],["、"],["くじ"],["で"],["割り当てられた","わりあてられた"],["地","ち"],["は"],["、"],["エドム"],["の"],["国境","こっきょう"],["に"],["至り","いたり"],["、"],["その"],["南端","なんたん"],["は"],["、"],["南","みなみ"],["の"],["ほう"],["の"],["ツィン"],["の"],["荒野","あらの"],["で"],["あった"],["。"]]},{"verse":2,"text":"その南の境界線は、塩の海の端、南に面する入江から、","tok":[["その"],["南","みなみ"],["の"],["境界線","きょうかいせん"],["は"],["、"],["塩","しお"],["の"],["海","うみ"],["の"],["端","はし"],["、"],["南","みなみ"],["に"],["面する","めんする"],["入江","いりえ"],["から"],["、"]]},{"verse":3,"text":"アクラビムの坂の南に出て、ツィンに進み、カデシュ・バルネアの南から上って、ヘツロンに進み、さらにアダルに上って、カルカに回り、","tok":[["アクラビム"],["の"],["坂","さか"],["の"],["南","みなみ"],["に"],["出て","でて"],["、"],["ツィン"],["に"],["進み","すすみ"],["、"],["カデシュ"],["・"],["バルネア"],["の"],["南","みなみ"],["から"],["上って","のぼって"],["、"],["ヘツロン"],["に"],["進み","すすみ"],["、"],["さらに"],["アダル"],["に"],["上って","のぼって"],["、"],["カルカ"],["に"],["回り","まわり"],["、"]]},{"verse":4,"text":"アツモンに進んで、エジプト川に出て、その境界線の終わりは海である。これが、あなたがたの南の境界線である。","tok":[["アツモン"],["に"],["進んで","すすんで"],["、"],["エジプト"],["川","かわ"],["に"],["出て","でて"],["、"],["その"],["境界線","きょうかいせん"],["の"],["終わり","おわり"],["は"],["海","うみ"],["で"],["ある"],["。"],["これ"],["が"],["、"],["あなた"],["がた"],["の"],["南","みなみ"],["の"],["境界線","きょうかいせん"],["で"],["ある"],["。"]]},{"verse":5,"text":"東の境界線は、塩の海であって、ヨルダン川の川口までで、北側の境界線は、ヨルダン川の川口の湖の入江から始まり、","tok":[["東","ひがし"],["の"],["境界線","きょうかいせん"],["は"],["、"],["塩","しお"],["の"],["海","うみ"],["で"],["あって"],["、"],["ヨルダン"],["川","かわ"],["の"],["川口","かわぐち"],["まで"],["で"],["、"],["北側","きたがわ"],["の"],["境界線","きょうかいせん"],["は"],["、"],["ヨルダン"],["川","かわ"],["の"],["川口","かわぐち"],["の"],["湖","みずうみ"],["の"],["入江","いりえ"],["から"],["始まり","はじまり"],["、"]]},{"verse":6,"text":"境界線は、ベテ・ホグラに上り、ベテ・ハアラバの北に進み、境界線は、ルベンの子ボハンの石に上って行き、","tok":[["境界線","きょうかいせん"],["は"],["、"],["ベテ"],["・"],["ホグラ"],["に"],["上り","のぼり"],["、"],["ベテ"],["・"],["ハアラバ"],["の"],["北","きた"],["に"],["進み","すすみ"],["、"],["境界線","きょうかいせん"],["は"],["、"],["ルベン"],["の"],["子","こ"],["ボハン"],["の"],["石","いし"],["に"],["上って","のぼって"],["行き","いき"],["、"]]},{"verse":7,"text":"境界線はまた、アコルの谷からデビルに上り、川の南側のアドミムの坂の反対側にあるギルガルに向かって北に向かう。また境界線はエン・シェメシュの水に進み、その終わりはエン・ロゲルであった。","tok":[["境界線","きょうかいせん"],["は"],["また"],["、"],["アコル"],["の"],["谷","たに"],["から"],["デビル"],["に"],["上り","のぼり"],["、"],["川","かわ"],["の"],["南側","みなみがわ"],["の"],["アドミム"],["の"],["坂","さか"],["の"],["反対","はんたい"],["側","がわ"],["に"],["ある"],["ギルガル"],["に"],["向かって","むかって"],["北","きた"],["に"],["向かう","むかう"],["。"],["また"],["境界線","きょうかいせん"],["は"],["エン"],["・"],["シェメシュ"],["の"],["水","みず"],["に"],["進み","すすみ"],["、"],["その"],["終わり","おわり"],["は"],["エン"],["・"],["ロゲル"],["で"],["あった"],["。"]]},{"verse":8,"text":"またその境界線は、ベン・ヒノムの谷を上って、南のほう、エブス人のいる傾斜地、すなわちエルサレムに至る。また境界線は、西のほうヒノムの谷を見おろす山の頂に上る。この谷はレファイムの谷の北のほうの端にある。","tok":[["また"],["その"],["境界線","きょうかいせん"],["は"],["、"],["ベン"],["・"],["ヒノム"],["の"],["谷","たに"],["を"],["上って","のぼって"],["、"],["南","みなみ"],["の"],["ほう"],["、"],["エブス人","えぶすにん"],["の"],["いる"],["傾斜地","けいしゃち"],["、"],["すなわち"],["エルサレム"],["に"],["至る","いたる"],["。"],["また"],["境界線","きょうかいせん"],["は"],["、"],["西","にし"],["の"],["ほう"],["ヒノム"],["の"],["谷","たに"],["を"],["見おろす","みおろす"],["山","やま"],["の"],["頂","いただき"],["に"],["上る","のぼる"],["。"],["この"],["谷","たに"],["は"],["レファイム"],["の"],["谷","たに"],["の"],["北","きた"],["の"],["ほう"],["の"],["端","はし"],["に"],["ある"],["。"]]},{"verse":9,"text":"それからその境界線は、この山の頂から、メ・ネフトアハの泉のほうに折れ、エフロン山の町々に出て、それから境界線は、バアラ、すなわちキルヤテ・エアリムのほうに折れる。","tok":[["それ"],["から"],["その"],["境界線","きょうかいせん"],["は"],["、"],["この"],["山","やま"],["の"],["頂","いただき"],["から"],["、"],["メ"],["・"],["ネフトアハ"],["の"],["泉","いずみ"],["の"],["ほう"],["に"],["折れ","おれ"],["、"],["エフロン"],["山","やま"],["の"],["町々","まちまち"],["に"],["出て","でて"],["、"],["それ"],["から"],["境界線","きょうかいせん"],["は"],["、"],["バアラ"],["、"],["すなわち"],["キルヤテ"],["・"],["エアリム"],["の"],["ほう"],["に"],["折れる","おれる"],["。"]]},{"verse":10,"text":"またその境界線は、バアラから西に回って、セイル山に至り、エアリム山の北側、すなわちケサロンに進み、ベテ・シェメシュに下り、さらにティムナに進み、","tok":[["また"],["その"],["境界線","きょうかいせん"],["は"],["、"],["バアラ"],["から"],["西","にし"],["に"],["回って","まわって"],["、"],["セイル山","せいるさん"],["に"],["至り","いたり"],["、"],["エアリム"],["山","さん"],["の"],["北側","きたがわ"],["、"],["すなわち"],["ケサロン"],["に"],["進み","すすみ"],["、"],["ベテ"],["・"],["シェメシュ"],["に"],["下り","くだり"],["、"],["さらに"],["ティムナ"],["に"],["進み","すすみ"],["、"]]},{"verse":11,"text":"その境界線は、エクロンの北側に出て、それから境界線は、シカロンのほうに折れ、バアラ山に進み、ヤブネエルに出て、その境界線の終わりは海であった。","tok":[["その"],["境界線","きょうかいせん"],["は"],["、"],["エクロン"],["の"],["北側","きたがわ"],["に"],["出て","でて"],["、"],["それ"],["から"],["境界線","きょうかいせん"],["は"],["、"],["シカロン"],["の"],["ほう"],["に"],["折れ","おれ"],["、"],["バアラ"],["山","やま"],["に"],["進み","すすみ"],["、"],["ヤブネエル"],["に"],["出て","でて"],["、"],["その"],["境界線","きょうかいせん"],["の"],["終わり","おわり"],["は"],["海","うみ"],["で"],["あった"],["。"]]},{"verse":12,"text":"また西の境界線は、大海とその沿岸であった。これが、ユダ族の諸氏族の周囲の境界線であった。","tok":[["また"],["西","にし"],["の"],["境界線","きょうかいせん"],["は"],["、"],["大海","たいかい"],["と"],["その"],["沿岸","えんがん"],["で"],["あった"],["。"],["これ"],["が"],["、"],["ユダ族","ゆだぞく"],["の"],["諸","しょ"],["氏族","しぞく"],["の"],["周囲","しゅうい"],["の"],["境界線","きょうかいせん"],["で"],["あった"],["。"]]},{"verse":13,"text":"ヨシュアは、主の命令で、エフネの子カレブに、ユダ族の中で、キルヤテ・アルバ、すなわちヘブロンを割り当て地として与えた。アルバはアナクの父であった。","tok":[["ヨシュア"],["は"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["で"],["、"],["エフネ"],["の"],["子","こ"],["カレブ"],["に"],["、"],["ユダ族","ゆだぞく"],["の"],["中","なか"],["で"],["、"],["キルヤテ"],["・"],["アルバ"],["、"],["すなわち"],["ヘブロン"],["を"],["割り当て","わりあて"],["地","ち"],["として"],["与えた","あたえた"],["。"],["アルバ"],["は"],["アナク"],["の"],["父","ちち"],["で"],["あった"],["。"]]},{"verse":14,"text":"カレブは、その所からアナクの三人の息子、シェシャイ、アヒマン、タルマイを追い払った。これらはアナクの子どもである。","tok":[["カレブ"],["は"],["、"],["その"],["所","ところ"],["から"],["アナク"],["の"],["三人","さんにん"],["の"],["息子","むすこ"],["、"],["シェシャイ"],["、"],["アヒマン"],["、"],["タルマイ"],["を"],["追い払った","おいはらった"],["。"],["これ"],["ら"],["は"],["アナク"],["の"],["子ども","こども"],["で"],["ある"],["。"]]},{"verse":15,"text":"その後、その所から彼は、デビルの住民のところに攻め上った。デビルの名は、以前はキルヤテ・セフェルであった。","tok":[["その"],["後","ご"],["、"],["その"],["所","ところ"],["から"],["彼","かれ"],["は"],["、"],["デビル"],["の"],["住民","じゅうみん"],["の"],["ところ"],["に"],["攻め上った","せめのぼった"],["。"],["デビル"],["の"],["名","な"],["は"],["、"],["以前","いぜん"],["は"],["キルヤテ"],["・"],["セフェル"],["で"],["あった"],["。"]]},{"verse":16,"text":"そのとき、カレブは言った。「キルヤテ・セフェルを打って、これを取る者には、私の娘アクサを妻として与えよう。」","tok":[["その"],["とき"],["、"],["カレブ"],["は"],["言った","いった"],["。"],["「"],["キルヤテ"],["・"],["セフェル"],["を"],["打って","うって"],["、"],["これ"],["を"],["取る","とる"],["者","もの"],["に"],["は"],["、"],["私","わたくし"],["の"],["娘","むすめ"],["アクサ"],["を"],["妻","つま"],["として"],["与えよう","あたえよう"],["。"],["」"]]},{"verse":17,"text":"ケナズの子で、カレブの兄弟オテニエルがそれを取ったので、カレブは娘アクサを、彼に妻として与えた。","tok":[["ケナズ"],["の"],["子","こ"],["で"],["、"],["カレブ"],["の"],["兄弟","きょうだい"],["オテニエル"],["が"],["それ"],["を"],["取った","とった"],["ので"],["、"],["カレブ"],["は"],["娘","むすめ"],["アクサ"],["を"],["、"],["彼","かれ"],["に"],["妻","つま"],["として"],["与えた","あたえた"],["。"]]},{"verse":18,"text":"彼女がとつぐとき、オテニエルは彼女をそそのかして、畑を父に求めることにした。彼女がろばから降りたので、カレブは彼女に、「何がほしいのか」と尋ねた。","tok":[["彼女","かのじょ"],["が"],["とつぐ"],["とき"],["、"],["オテニエル"],["は"],["彼女","かのじょ"],["を"],["そそのかして"],["、"],["畑","はたけ"],["を"],["父","ちち"],["に"],["求める","もとめる"],["こと"],["に"],["した"],["。"],["彼女","かのじょ"],["が"],["ろば"],["から"],["降りた","おりた"],["ので"],["、"],["カレブ"],["は"],["彼女","かのじょ"],["に"],["、"],["「"],["何","なん"],["が"],["ほしい"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":19,"text":"彼女は言った。「私に祝いの品を下さい。あなたはネゲブの地に私を送るのですから、水の泉を私に下さい。」そこで彼は、上の泉と下の泉とを彼女に与えた。","tok":[["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["祝い","いわい"],["の"],["品","しな"],["を"],["下さい","ください"],["。"],["あなた"],["は"],["ネゲブ"],["の"],["地","ち"],["に"],["私","わたくし"],["を"],["送る","おくる"],["の"],["です"],["から"],["、"],["水","みず"],["の"],["泉","いずみ"],["を"],["私","わたくし"],["に"],["下さい","ください"],["。"],["」"],["そこ"],["で"],["彼","かれ"],["は"],["、"],["上","うえ"],["の"],["泉","いずみ"],["と"],["下","した"],["の"],["泉","いずみ"],["と"],["を"],["彼女","かのじょ"],["に"],["与えた","あたえた"],["。"]]},{"verse":20,"text":"ユダ部族の諸氏族の相続地は次のとおり。","tok":[["ユダ"],["部族","ぶぞく"],["の"],["諸","しょ"],["氏族","しぞく"],["の"],["相続","そうぞく"],["地","ち"],["は"],["次","つぎ"],["の"],["とおり"],["。"]]},{"verse":21,"text":"ユダ部族が、エドムの国境のほうに持っていた最南端の町々は、カブツェエル、エデル、ヤグル、","tok":[["ユダ"],["部族","ぶぞく"],["が"],["、"],["エドム"],["の"],["国境","こっきょう"],["の"],["ほう"],["に"],["持って","もって"],["いた"],["最南端","さいなんたん"],["の"]
[{"verse":1,"text":"第二番目のくじは、シメオン、すなわちシメオン部族の諸氏族に当たった。彼らの相続地は、ユダ族の相続地の中にあった。","tok":[["第","だい"],["二番目","にばんめ"],["の"],["くじ"],["は"],["、"],["シメオン"],["、"],["すなわち"],["シメオン"],["部族","ぶぞく"],["の"],["諸","しょ"],["氏族","しぞく"],["に"],["当たった","あたった"],["。"],["彼","かれ"],["ら"],["の"],["相続","そうぞく"],["地","ち"],["は"],["、"],["ユダ族","ゆだぞく"],["の"],["相続","そうぞく"],["地","ち"],["の"],["中","なか"],["に"],["あった"],["。"]]},{"verse":2,"text":"彼らの相続地は、ベエル・シェバ、シェバ、モラダ、","tok":[["彼","かれ"],["ら"],["の"],["相続","そうぞく"],["地","ち"],["は"],["、"],["ベエル"],["・"],["シェバ"],["、"],["シェバ"],["、"],["モラダ"],["、"]]},{"verse":3,"text":"ハツァル・シュアル、バラ、エツェム、","tok":[["ハツァル"],["・"],["シュアル"],["、"],["バラ"],["、"],["エツェム"],["、"]]},{"verse":4,"text":"エルトラデ、ベトル、ホルマ、","tok":[["エルトラデ"],["、"],["ベトル"],["、"],["ホルマ"],["、"]]},{"verse":5,"text":"ツィケラグ、ベテ・マルカボテ、ハツァル・スサ、","tok":[["ツィケラグ"],["、"],["ベテ"],["・"],["マルカボテ"],["、"],["ハツァル"],["・"],["スサ"],["、"]]},{"verse":6,"text":"ベテ・レバオテ、シャルヘンで、十三の町と、それらに属する村々。","tok":[["ベテ"],["・"],["レバオテ"],["、"],["シャルヘン"],["で"],["、"],["十三","じゅうさん"],["の"],["町","まち"],["と"],["、"],["それ"],["ら"],["に"],["属する","ぞくする"],["村々","むらむら"],["。"]]},{"verse":7,"text":"アイン、リモン、エテル、アシャン。四つの町と、それらに属する村々、","tok":[["アイン"],["、"],["リモン"],["、"],["エテル"],["、"],["アシャン"],["。"],["四","よん"],["つ"],["の"],["町","まち"],["と"],["、"],["それ"],["ら"],["に"],["属する","ぞくする"],["村々","むらむら"],["、"]]},{"verse":8,"text":"および、これらの町々の周囲にあって、バアラテ・ベエル、南のラマまでのすべての村々であった。これがシメオン部族の諸氏族の相続地であった。","tok":[["および"],["、"],["これ"],["ら"],["の"],["町々","まちまち"],["の"],["周囲","しゅうい"],["に"],["あって"],["、"],["バアラテ"],["・"],["ベエル"],["、"],["南","みなみ"],["の"],["ラマ"],["まで"],["の"],["すべて"],["の"],["村々","むらむら"],["で"],["あった"],["。"],["これ"],["が"],["シメオン"],["部族","ぶぞく"],["の"],["諸","しょ"],["氏族","しぞく"],["の"],["相続","そうぞく"],["地","ち"],["で"],["あった"],["。"]]},{"verse":9,"text":"シメオン族の相続地は、ユダ族の割り当て地から取られた。それは、ユダ族の割り当て地が彼らには広すぎたので、シメオン族は彼らの相続地の中に割り当て地を持ったのである。","tok":[["シメオン"],["族","ぞく"],["の"],["相続","そうぞく"],["地","ち"],["は"],["、"],["ユダ族","ゆだぞく"],["の"],["割り当て","わりあて"],["地","ち"],["から"],["取られた","とられた"],["。"],["それ"],["は"],["、"],["ユダ族","ゆだぞく"],["の"
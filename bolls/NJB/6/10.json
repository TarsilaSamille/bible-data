[{"verse":1,"text":"さて、エルサレムの王アドニ・ツェデクは、ヨシュアがアイを攻め取って、それを聖絶し、先にエリコとその王にしたようにアイとその王にもしたこと、またギブオンの住民がイスラエルと和を講じて、彼らの中にいることを聞き、","tok":[["さて"],["、"],["エルサレム"],["の"],["王","おう"],["アドニ"],["・"],["ツェデク"],["は"],["、"],["ヨシュア"],["が"],["アイ"],["を"],["攻め取って","せめとって"],["、"],["それ"],["を"],["聖","せい"],["絶し","ぜっし"],["、"],["先","さき"],["に"],["エリコ"],["と"],["その"],["王","おう"],["に"],["した"],["よう"],["に"],["アイ"],["と"],["その"],["王","おう"],["に"],["も"],["した"],["こと"],["、"],["また"],["ギブオン"],["の"],["住民","じゅうみん"],["が"],["イスラエル"],["と"],["和","わ"],["を"],["講じて","こうじて"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["いる"],["こと"],["を"],["聞き","きき"],["、"]]},{"verse":2,"text":"大いに恐れた。それは、ギブオンが大きな町であって、王国の都の一つのようであり、またアイよりも大きくて、そこの人々はみな勇士たちであったからである。","tok":[["大いに","おおいに"],["恐れた","おそれた"],["。"],["それ"],["は"],["、"],["ギブオン"],["が"],["大きな","おおきな"],["町","まち"],["で"],["あって"],["、"],["王国","おうこく"],["の"],["都","と"],["の"],["一","ひと"],["つ"],["の"],["よう"],["で"],["あり"],["、"],["また"],["アイ"],["より"],["も"],["大きくて","おおきくて"],["、"],["そこ"],["の"],["人々","ひとびと"],["は"],["みな"],["勇士","ゆうし"],["たち"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"それで、エルサレムの王アドニ・ツェデクは、ヘブロンの王ホハム、ヤルムテの王ピルアム、ラキシュの王ヤフィア、エグロンの王デビルに使いをやって言った。","tok":[["それ"],["で"],["、"],["エルサレム"],["の"],["王","おう"],["アドニ"],["・"],["ツェデク"],["は"],["、"],["ヘブロン"],["の"],["王","おう"],["ホハム"],["、"],["ヤルムテ"],["の"],["王","おう"],["ピルアム"],["、"],["ラキシュ"],["の"],["王","おう"],["ヤフィア"],["、"],["エグロン"],["の"],["王","おう"],["デビル"],["に"],["使い","つかい"],["を"],["やって"],["言った","いった"],["。"]]},{"verse":4,"text":"「私のところに上って来て、私を助けてください。私たちはギブオンを打ちましょう。ギブオンがヨシュア、イスラエル人と和を講じたから。」","tok":[["「"],["私","わたくし"],["の"],["ところ"],["に"],["上って","のぼって"],["来て","きて"],["、"],["私","わたくし"],["を"],["助けて","たすけて"],["ください"],["。"],["私たち","わたしたち"],["は"],["ギブオン"],["を"],["打ちましょう","うちましょう"],["。"],["ギブオン"],["が"],["ヨシュア"],["、"],["イスラエル"],["人","にん"],["と"],["和","わ"],["を"],["講じた","こうじた"],["から"],["。"],["」"]]},{"verse":5,"text":"それで、エモリ人の五人の王たち、エルサレムの王、ヘブロンの王、ヤルムテの王、ラキシュの王、エグロンの王とその全陣営は、相集まり、上って行って、ギブオンに向かって陣を敷き、それを攻めて戦った。","tok":[["それ"],["で"],["、"],["エモリ人","えもりにん"],["の"],["五人","ごにん"],["の"],["王","おう"],["たち"],["、"],["エルサレム"],["の"],["王","おう"],["、"],["ヘブロン"],["の"],["王","おう"],["、"],["ヤルムテ"],["の"],["王","おう"],["、"],["ラキシュ"],["の"],["王","おう"],["、"],["エグロン"],["の"],["王","おう"],["と"],["その"],["全","ぜん"],["陣営","じんえい"],["は"],["、"],["相","あい"],["集まり","あつまり"],["、"],["上って","のぼって"],["行って","いって"],["、"],["ギブオン"],["に"],["向かって","むかって"],["陣","じん"],["を"],["敷き","しき"],["、"],["それ"],["を"],["攻めて","せめて"],["戦った","たたかった"],["。"]]},{"verse":6,"text":"ギブオンの人々は、ギルガルの陣営のヨシュアのところに使いをやって言った。「あなたのしもべどもからあなたの手を引かないで、早く、私たちのところに上って来て私たちを救い、助けてください。山地に住むエモリ人の王たちがみな集まって、私たちに向かっているからです。」","tok":[["ギブオン"],["の"],["人々","ひとびと"],["は"],["、"],["ギルガル"],["の"],["陣営","じんえい"],["の"],["ヨシュア"],["の"],["ところ"],["に"],["使い","つかい"],["を"],["やって"],["言った","いった"],["。"],["「"],["あなた"],["の"],["しもべ"],["ども"],["から"],["あなた"],["の"],["手","て"],["を"],["引かないで","ひかないで"],["、"],["早く","はやく"],["、"],["私たち","わたしたち"],["の"],["ところ"],["に"],["上って","のぼって"],["来て","きて"],["私たち","わたしたち"],["を"],["救い","すくい"],["、"],["助けて","たすけて"],["ください"],["。"],["山地","さんち"],["に"],["住む","すむ"],["エモリ人","えもりにん"],["の"],["王","おう"],["たち"],["が"],["みな"],["集まって","あつまって"],["、"],["私たち","わたしたち"],["に"],["向かって","むかって"],["いる"],["から"],["です"],["。"],["」"]]},{"verse":7,"text":"そこでヨシュアは、すべての戦う民と、すべての勇士たちとを率いて、ギルガルから上って行った。","tok":[["そこ"],["で"],["ヨシュア"],["は"],["、"],["すべて"],["の"],["戦う","たたかう"],["民","たみ"],["と"],["、"],["すべて"],["の"],["勇士","ゆうし"],["たち"],["と"],["を"],["率いて","ひきいて"],["、"],["ギルガル"],["から"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":8,"text":"主はヨシュアに仰せられた。「彼らを恐れてはならない。わたしが彼らをあなたの手に渡したからだ。彼らのうち、ひとりとしてあなたの前に立ち向かうことのできる者はいない。」","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["仰せられた","おおせられた"],["。"],["「"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["手","て"],["に"],["渡した","わたした"],["から"],["だ"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["、"],["ひとり"],["として"],["あなた"],["の"],["前","まえ"],["に"],["立ち向かう","たちむかう"],["こと"],["の"],["できる"],["者","もの"],["は"],["いない"],["。"],["」"]]},{"verse":9,"text":"それで、ヨシュアは夜通しギルガルから上って行って、突然彼らを襲った。","tok":[["それ"],["で"],["、"],["ヨシュア"],["は"],["夜通し","よどおし"],["ギルガル"],["から"],["上って","のぼって"],["行って","いって"],["、"],["突然","とつぜん"],["彼","かれ"],["ら"],["を"],["襲った","おそった"],["。"]]},{"verse":10,"text":"主が彼らをイスラエルの前でかき乱したので、イスラエルはギブオンで彼らを激しく打ち殺し、ベテ・ホロンの上り坂を通って彼らを追い、アゼカとマケダまで行って彼らを打った。","tok":[["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["イスラエル"],["の"],["前","まえ"],["で"],["かき乱した","かきみだした"],["ので"],["、"],["イスラエル"],["は"],["ギブオン"],["で"],["彼","かれ"],["ら"],["を"],["激しく","はげしく"],["打ち殺し","うちころし"],["、"],["ベテ"],["・"],["ホロン"],["の"],["上り坂","のぼりざか"],["を"],["通って","とおって"],["彼","かれ"],["ら"],["を"],["追い","おい"],["、"],["アゼカ"],["と"],["マケダ"],["まで"],["行って","いって"],["彼","かれ"],["ら"],["を"],["打った","うった"],["。"]]},{"verse":11,"text":"彼らがイスラエルの前から逃げて、ベテ・ホロンの下り坂にいたとき、主は天から彼らの上に大きな石を降らし、アゼカに至るまでそうしたので、彼らは死んだ。イスラエル人が剣で殺した者よりも、雹の石で死んだ者のほうが多かった。","tok":[["彼","かれ"],["ら"],["が"],["イスラエル"],["の"],["前","まえ"],["から"],["逃げて","にげて"],["、"],["ベテ"],["・"],["ホロン"],["の"],["下り坂","くだりざか"],["に"],["いた"],["とき"],["、"],["主","ぬし"],["は"],["天","てん"],["から"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["大きな","おおきな"],["石","いし"],["を"],["降らし","ふらし"],["、"],["アゼカ"],["に"],["至る","いたる"],["まで"],["そう"],["した"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["死んだ","しんだ"],["。"],["イスラエル"],["人","にん"],["が"],["剣","けん"],["で"],["殺した","ころした"],["者","もの"],["より"],["も"],["、"],["雹","ひょう"],["の"],["石","いし"],["で"],["死んだ","しんだ"],["者","もの"],["の"],["ほう"],["が"],["多かった","おおかった"],["。"]]},{"verse":12,"text":"主がエモリ人をイスラエル人の前に渡したその日、ヨシュアは主に語り、イスラエルの見ている前で言った。「日よ。ギブオンの上で動くな。月よ。アヤロンの谷で。」","tok":[["主","ぬし"],["が"],["エモリ人","えもりにん"],["を"],["イスラエル"],["人","にん"],["の"],["前","まえ"],["に"],["渡した","わたした"],["その"],["日","ひ"],["、"],["ヨシュア"],["は"],["主","ぬし"],["に"],["語り","かたり"],["、"],["イスラエル"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["言った","いった"],["。"],["「"],["日","ひ"],["よ"],["。"],["ギブオン"],["の"],["上","うえ"],["で"],["動く","うごく"],["な"],["。"],["月","つき"],["よ"],["。"],["アヤロン"],["の"],["谷","たに"],["で"],["。"],["」"]]},{"verse":13,"text":"民がその敵に復讐するまで、日は動かず、月はとどまった。／これは、ヤシャルの書にしるされているではないか。こうして、日は天のまなかにとどまって、まる一日ほど出て来ることを急がなかった。","tok":[["民","みん"],["が"],["その"],["敵","てき"],["に"],["復讐","ふくしゅう"],["する"],["まで"],["、"],["日","ひ"],["は"],["動かず","うごかず"],["、"],["月","つき"],["は"],["とどまった"],["。"],["／"],["これ"],["は"],["、"],["ヤシャル"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"],["こう"],["して"],["、"],["日","ひ"],["は"],["天","てん"],["の"],["まなか"],["に"],["とどまって"],["、"],["まる"],["一","いち"],["日","にち"],["ほど"],["出て","でて"],["来る","くる"],["こと"],["を"],["急がなかった","いそがなかった"],["。"]]},{"verse":14,"text":"主が人の声を聞き入れたこのような日は、先にもあとにもなかった。主がイスラエルのために戦ったからである。","tok":[["主","ぬし"],["が"],["人","ひと"],["の"],["声","こえ"],["を"],["聞き入れた","ききいれた"],["この"],["よう"],["な"],["日","ひ"],["は"],["、"],["先","さき"],["に"],["も"],["あと"],["に"],["も"],["なかった"],["。"],["主","ぬし"],["が"],["イスラエル"],["の"],["ため"],["に"],["戦った","たたかった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"ヨシュアは、全イスラエルを率いてギルガルの陣営に引き揚げた。","tok":[["ヨシュア"],["は"],["、"],["全","ぜん"],["イスラエル"],["を"],["率いて","ひきいて"],["ギルガル"],["の"],["陣営","じんえい"],["に"],["引き揚げた","ひきあげた"],["。"]]},{"verse":16,"text":"これらの五人の王たちは逃げて、マケダのほら穴に隠れた。","tok":[["これ"],["ら"],["の"],["五人","ごにん"],["の"],["王","おう"],["たち"],["は"],["逃げて","にげて"],["、"],["マケダ"],["の"],["ほら穴","ほらあな"],["に"],["隠れた","かくれた"],["。"]]},{"verse":17,"text":"その後、マケダのほら穴に隠れている五人の王たちが見つかったという知らせがヨシュアに入った。","tok":[["その"],["後","ご"],["、"],["マケダ"],["の"],["ほら穴","ほらあな"],["に"],["隠れて","かくれて"],["いる"],["五人","ごにん"],["の"],["王","おう"],["たち"],["が"],["見つかった","みつかった"],["と"],["いう"],["知らせ","しらせ"],["が"],["ヨシュア"],["に"],["入った","はいった"],["。"]]},{"verse":18,"text":"そこでヨシュアは言った。「ほら穴の口に大きな石をころがし、そのそばに人を置いて、彼らを見張りなさい。","tok":[["そこ"],["で"],["ヨシュア"],["は"],["言った","いった"],["。"],["「"],["ほら穴","ほらあな"],["の"],["口","くち"],["に"],["大きな","おおきな"],["石","いし"],["を"],["ころがし"],["、"],["その"],["そば"],["に"],["人","ひと"],["を"],["置いて","おいて"],["、"],["彼","かれ"],["ら"],["を"],["見張り","みはり"],["なさい"],["。"]]},{"verse":19,"text":"しかしあなたがたはそこにとどまってはならない。敵のあとを追い、彼らのしんがりを攻撃しなさい。彼らの町に入らせてはならない。あなたがたの神、主が彼らをあなたがたの手に渡されたからだ。」","tok":[["しかし"],["あなた"],["がた"],["は"],["そこ"],["に"],["とどまって"],["は"],["ならない"],["。"],["敵","てき"],["の"],["あと"],["を"],["追い"
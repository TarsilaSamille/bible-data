[{"verse":1,"text":"ヌンの子ヨシュアは、シティムからひそかにふたりの者を斥候として遣わして、言った。「行って、あの地とエリコを偵察しなさい。」彼らは行って、ラハブという名の遊女の家に入り、そこに泊まった。","tok":[["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["、"],["シティム"],["から"],["ひそか"],["に"],["ふたり"],["の"],["者","もの"],["を"],["斥候","せっこう"],["として"],["遣わして","つかわして"],["、"],["言った","いった"],["。"],["「"],["行って","いって"],["、"],["あの"],["地","ち"],["と"],["エリコ"],["を"],["偵察","ていさつ"],["し"],["なさい"],["。"],["」"],["彼","かれ"],["ら"],["は"],["行って","いって"],["、"],["ラハブ"],["と"],["いう"],["名","な"],["の"],["遊女","ゆうじょ"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],["そこ"],["に"],["泊まった","とまった"],["。"]]},{"verse":2,"text":"エリコの王に、「今、イスラエル人のある者たちが、今夜この地を探るために、入って来ました」と告げる者があったので、","tok":[["エリコ"],["の"],["王","おう"],["に"],["、"],["「"],["今","いま"],["、"],["イスラエル"],["人","にん"],["の"],["ある"],["者","もの"],["たち"],["が"],["、"],["今夜","こんや"],["この"],["地","ち"],["を"],["探る","さぐる"],["ため"],["に"],["、"],["入って","はいって"],["来ました","きました"],["」"],["と"],["告げる","つげる"],["者","もの"],["が"],["あった"],["ので"],["、"]]},{"verse":3,"text":"エリコの王はラハブのところに人をやって言った。「あなたのところに来て、あなたの家に入った者たちを連れ出しなさい。その者たちは、この地のすべてを探るために来たのだから。」","tok":[["エリコ"],["の"],["王","おう"],["は"],["ラハブ"],["の"],["ところ"],["に"],["人","ひと"],["を"],["やって"],["言った","いった"],["。"],["「"],["あなた"],["の"],["ところ"],["に"],["来て","きて"],["、"],["あなた"],["の"],["家","いえ"],["に"],["入った","はいった"],["者","もの"],["たち"],["を"],["連れ出し","つれだし"],["なさい"],["。"],["その"],["者","もの"],["たち"],["は"],["、"],["この"],["地","ち"],["の"],["すべて"],["を"],["探る","さぐる"],["ため"],["に"],["来た","きた"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":4,"text":"ところが、この女はそのふたりの人をかくまって、こう言った。「その人たちは私のところに来ました。しかし、私はその人たちがどこから来たのか知りませんでした。","tok":[["ところ"],["が"],["、"],["この"],["女","おんな"],["は"],["その"],["ふたり"],["の"],["人","ひと"],["を"],["かくまって"],["、"],["こう"],["言った","いった"],["。"],["「"],["その"],["人","ひと"],["たち"],["は"],["私","わたくし"],["の"],["ところ"],["に"],["来ました","きました"],["。"],["しかし"],["、"],["私","わたくし"],["は"],["その"],["人","ひと"],["たち"],["が"],["どこ"],["から"],["来た","きた"],["の"],["か"],["知りませんでした","しりませんでした"],["。"]]},{"verse":5,"text":"その人たちは、暗くなって、門が閉じられるころ、出て行きました。その人たちがどこへ行ったのか存じません。急いで彼らのあとを追ってごらんなさい。追いつけるでしょう。」","tok":[["その"],["人","ひと"],["たち"],["は"],["、"],["暗く","くらく"],["なって"],["、"],["門","もん"],["が"],["閉じられる","とじられる"],["ころ"],["、"],["出て","でて"],["行きました","いきました"],["。"],["その"],["人","ひと"],["たち"],["が"],["どこ"],["へ"],["行った","いった"],["の"],["か"],["存じません","ぞんじません"],["。"],["急いで","いそいで"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追って","おって"],["ごらん"],["なさい"],["。"],["追いつけるでしょう","おいつけるでしょう"],["。"],["」"]]},{"verse":6,"text":"彼女はふたりを屋上に連れて行き、屋上に並べてあった亜麻の茎の中に隠していたのである。","tok":[["彼女","かのじょ"],["は"],["ふたり"],["を"],["屋上","おくじょう"],["に"],["連れて","つれて"],["行き","いき"],["、"],["屋上","おくじょう"],["に"],["並べて","ならべて"],["あった"],["亜麻","あま"],["の"],["茎","くき"],["の"],["中","なか"],["に"],["隠して","かくして"],["いた"],["ので"],["ある"],["。"]]},{"verse":7,"text":"彼らはその人たちのあとを追って、ヨルダン川の道を渡し場へ向かった。彼らがあとを追って出て行くと、門はすぐ閉じられた。","tok":[["彼","かれ"],["ら"],["は"],["その"],["人","ひと"],["たち"],["の"],["あと"],["を"],["追って","おって"],["、"],["ヨルダン"],["川","かわ"],["の"],["道","みち"],["を"],["渡し場","わたしば"],["へ"],["向かった","むかった"],["。"],["彼","かれ"],["ら"],["が"],["あと"],["を"],["追って","おって"],["出て","でて"],["行く","いく"],["と"],["、"],["門","もん"],["は"],["すぐ"],["閉じられた","とじられた"],["。"]]},{"verse":8,"text":"ふたりの人がまだ寝ないうちに、彼女は屋上の彼らのところに上って来て、","tok":[["ふたり"],["の"],["人","ひと"],["が"],["まだ"],["寝ない","ねない"],["うち"],["に"],["、"],["彼女","かのじょ"],["は"],["屋上","おくじょう"],["の"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["上って","のぼって"],["来て","きて"],["、"]]},{"verse":9,"text":"その人たちに言った。「主がこの地をあなたがたに与えておられること、私たちはあなたがたのことで恐怖に襲われており、この地の住民もみな、あなたがたのことで震えおののいていることを、私は知っています。","tok":[["その"],["人","ひと"],["たち"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["この"],["地","ち"],["を"],["あなた"],["がた"],["に"],["与えて","あたえて"],["おられる"],["こと"],["、"],["私たち","わたしたち"],["は"],["あなた"],["がた"],["の"],["こと"],["で"],["恐怖","きょうふ"],["に"],["襲われて","おそわれて"],["おり"],["、"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["も"],["みな"],["、"],["あなた"],["がた"],["の"],["こと"],["で"],["震えおののいて","ふるえおののいて"],["いる"],["こと"],["を"],["、"],["私","わたくし"],["は"],["知って","しって"],["います"],["。"]]},{"verse":10,"text":"あなたがたがエジプトから出て来られたとき、主があなたがたの前で、葦の海の水をからされたこと、また、あなたがたがヨルダン川の向こう側にいたエモリ人のふたりの王シホンとオグにされたこと、彼らを聖絶したことを、私たちは聞いているからです。","tok":[["あなた"],["がた"],["が"],["エジプト"],["から"],["出て","でて"],["来られた","こられた"],["とき"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["で"],["、"],["葦","あし"],["の"],["海","うみ"],["の"],["水","みず"],["を"],["からされた"],["こと"],["、"],["また"],["、"],["あなた"],["がた"],["が"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["に"],["いた"],["エモリ人","えもりにん"],["の"],["ふたり"],["の"],["王","おう"],["シホン"],["と"],["オグ"],["に"],["された"],["こと"],["、"],["彼","かれ"],["ら"],["を"],["聖","せい"],["絶した","ぜっした"],["こと"],["を"],["、"],["私たち","わたしたち"],["は"],["聞いて","きいて"],["いる"],["から"],["です"],["。"]]},{"verse":11,"text":"私たちは、それを聞いたとき、あなたがたのために、心がしなえて、もうだれにも、勇気がなくなってしまいました。あなたがたの神、主は、上は天、下は地において神であられるからです。","tok":[["私たち","わたしたち"],["は"],["、"],["それ"],["を"],["聞いた","きいた"],["とき"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["心","こころ"],["が"],["しなえて"],["、"],["もう"],["だれ"],["に"],["も"],["、"],["勇気","ゆうき"],["が"],["なくなって"],["しまいました"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["上","うえ"],["は"],["天","てん"],["、"],["下","した"],["は"],["地","ち"],["に"],["おいて"],["神","かみ"],["で"],["あられる"],["から"],["です"],["。"]]},{"verse":12,"text":"どうか、私があなたがたに真実を尽くしたように、あなたがたもまた私の父の家に真実を尽くすと、今、主にかけて私に誓ってください。そして、私に確かな証拠を下さい。","tok":[["どう"],["か"],["、"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["真実","しんじつ"],["を"],["尽くした","つくした"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["また"],["私","わたくし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["真実","しんじつ"],["を"],["尽くす","つくす"],["と"],["、"],["今","いま"],["、"],["主","ぬし"],["に"],["かけて"],["私","わたくし"],["に"],["誓って","ちかって"],["ください"],["。"],["そして"],["、"],["私","わたくし"],["に"],["確か","たしか"],["な"],["証拠","しょうこ"],["を"],["下さい","ください"],["。"]]},{"verse":13,"text":"私の父、母、兄弟、姉妹、また、すべて彼らに属する者を生かし、私たちのいのちを死から救い出してください。」","tok":[["私","わたくし"],["の"],["父","ちち"],["、"],["母","はは"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["、"],["また"],["、"],["すべて"],["彼","かれ"],["ら"],["に"],["属する","ぞくする"],["者","もの"],["を"],["生かし","いかし"],["、"],["私たち","わたしたち"],["の"],["いのち"],["を"],["死","し"],["から"],["救い出して","すくいだして"],["ください"],["。"],["」"]]},{"verse":14,"text":"その人たちは、彼女に言った。「あなたがたが、私たちのこのことをしゃべらなければ、私たちはいのちにかけて誓おう。主が私たちにこの地を与えてくださるとき、私たちはあなたに真実と誠実を尽くそう。」","tok":[["その"],["人","ひと"],["たち"],["は"],["、"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["た"],["が"],["、"],["私たち","わたしたち"],["の"],["この"],["こと"],["を"],["しゃべらなければ"],["、"],["私たち","わたしたち"],["は"],["いのち"],["に"],["かけて"],["誓おう","ちかおう"],["。"],["主","ぬし"],["が"],["私たち","わたしたち"],["に"],["この"],["地","ち"],["を"],["与えて","あたえて"],["くださる"],["とき"],["、"],["私たち","わたしたち"],["は"],["あなた"],["に"],["真実","しんじつ"],["と"],["誠実","せいじつ"],["を"],["尽くそう","つくそう"],["。"],["」"]]},{"verse":15,"text":"そこで、ラハブは綱で彼らを窓からつり降ろした。彼女の家は城壁の中に建て込まれていて、彼女はその城壁の中に住んでいたからである。","tok":[["そこ"],["で"],["、"],["ラハブ"],["は"],["綱","つな"],["で"],["彼","かれ"],["ら"],["を"],["窓","まど"],["から"],["つり"],["降ろした","おろした"],["。"],["彼女","かのじょ"],["の"],["家","いえ"],["は"],["城壁","じょうへき"],["の"],["中","なか"],["に"],["建て込まれて","たてこまれて"],["いて"],["、"],["彼女","かのじょ"],["は"],["その"],["城壁","じょうへき"],["の"],["中","なか"],["に"],["住んで","すんで"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"彼女は彼らに言った。「追っ手に出会わないように、あなたがたは山地のほうへ行き、追っ手が引き返すまで三日間、そこで身を隠していてください。それから帰って行かれたらよいでしょう。」","tok":[["彼女","かのじょ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["追っ手","おって"],["に"],["出会わない","であわない"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["山地","さんち"],["の"],["ほう"],["へ"],["行き","いき"],["、"],["追っ手","おって"],["が"],["引き返す","ひきかえす"],["まで"],["三","みっ"],["日間","かかん"],["、"],["そこ"],["で"],["身","み"],["を"],["隠して","かくして"],["いて"],["ください"],["。"],["それ"],["から"],["帰って","かえって"],["行かれたら","いかれたら"],["よいでしょう"],["。"],["」"]]},{"verse":17,"text":"その人たちは彼女に言った。「あなたが私たちに誓わせたこのあなたの誓いから、私たちは解かれる。","tok":[["その"],["人","ひと"],["たち"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["私たち","わたしたち"],["に"],["誓わせた","ちかわせた"],["この"],["あなた"],["の"],["誓い","ちかい"],["から"],["、"],["私たち","わたしたち"],["は"],["解かれる","とかれる"],["。"]]},{"verse":18,"text":"私たちが、この地に入って来たなら、あなたは、私たちをつり降ろした窓に、この赤いひもを結びつけておかなければならない。また、あなたの父と母、兄弟、また、あなたの父の家族を全部、あなたの家に集めておかなければならない。","tok":[["私たち","わたしたち"],["が"],["、"],["この"],["地","ち"],["に"],["入って","はいって"],["来たなら","きたなら"],["、"],["あなた"],["は"],["、"],["私たち","わたしたち"],["を"],["つり"],["降ろした","おろした"],["窓","まど"],["に"],["、"],["この"],["赤い","あかい"],["ひも"],["を"],["結びつけて","むすびつけて"],["おかなければ"],["ならない"],["。"],["また"],["、"],["あなた"],["の"],["父","ちち"],["と"],["母","はは"],["、"],["兄弟","きょうだい"],["、"],["また"],["、"],["あなた"],["の"],["父","ちち"],["の"],["家族","かぞく"],["を"],["全部","ぜんぶ"],["、"],["あなた"],["の"],["家","いえ"],["に"],["集めて","あつめて"],["おかなければ"],["ならない"],["。"]]},{"verse":19,"text":"あなたの家の戸口から外へ出る者があれば、その血はその者自身のこうべに帰する。私たちは誓いから解かれる。しかし、あなたといっしょに家の中にいる者に手をかけるなら、その血は私たちのこうべに帰する。","tok":[["あなた"],["の"],["家","いえ"],["の"],["戸口","とぐち"],["から"],["外","そと"],["へ"],["出る","でる"],["者","もの"],["が"],["あれば"],["、"],["その"],["血","ち"],["は"],["その"],["者","もの"],["自身","じしん"],["の"],["こうべ"],["に"],["帰する","きする"],["。"],["私たち","わたしたち"],["は"],["誓い","ちかい"],["から"],["解かれる","とかれる"],["。"],["しかし"],["、"],["あなた"],["と"],["いっしょ"],["に"],["家","いえ"],["の"],["中","なか"],["に"],["いる"],["者","もの"],["に"],["手","て"],["を"],["かけるなら"],["、"],["その"],["血","ち"],["は"],["私たち","わたしたち"],["の"],["こうべ"],["に"],["帰する","きする"],["。"]]},{"verse":20,"text":"だが、もしあなたが私たちのこのことをしゃべるなら、あなたが私たちに誓わせたあなたの誓いから私たちは解かれる。」","tok":[["だ"],["が"],["、"],["もし"],["あなた"],["が"],["私たち","わたしたち"],["の"],["この"],["こと"],["を"],["しゃべるなら"],["、"],["あなた"],["が"],["私たち","わたしたち"],["に"],["誓わせた","ちかわせた"],["あなた"],["の"],["誓い","ちかい"],["から"],["私たち","わたしたち"],["は"],["解かれる","とかれる"],["。"],["」"]]},{"verse":21,"text":"ラハブは言った。「おことばどおりにいたしましょう。」こうして、彼女は彼らを送り出したので、彼らは去った。そして彼女は窓に赤いひもを結んだ。","tok":[["ラハブ"],["は"],["言った","いった"],["。"],["「"],["おことば"],["どおり"],["に"],["いたしましょう"],["。"],["」"],["こう"],["して"],["、"],["彼女","かのじょ"],["は"],["彼","かれ"],["ら"],["を"],["送り出した","おくりだした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["去った","さった"],["。"],["そして"],["彼女","かのじょ"],["は"],["窓","まど"],["に"],["赤い","あかい"],["ひも"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":22,"text":"彼らは去って山地のほうへ行き、追っ手が引き返すまで三日間、そこにとどまった。追っ手は彼らを道中くまなく捜したが、見つけることができなかった。","tok":[["彼","かれ"],["ら"],["は"],["去って","さって"],["山地","さんち"],["の"],["ほう"],["へ"],["行き","いき"],["、"],["追っ手","おって"],["が"],["引き返す","ひきかえす"],["まで"],["三","みっ"],["日間","かかん"],["、"],["そこ"],["に"],["とどまった"],["。"],["追っ手","おって"],["は"],["彼","かれ"],["ら"],["を"],["道中","どうちゅう"],["くまなく"],["捜した","さがした"],["が"],["、"],["見つける","みつける"],["こと"],["が"],["できなかった"],["。"]]},{"verse":23,"text":"ふたりの人は、帰途につき、山を下り、川を渡り、ヌンの子ヨシュアのところに来て、その身に起こったことを、ことごとく話した。","tok":[["ふたり"],["の"],["人","ひと"],["は"],["、"],["帰途","きと"],["に"],["つき"],["、"],["山","やま"],["を"],["下り","おり"],["、"],["川","かわ"],["を"],["渡り","わたり"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["の"],["ところ"],["に"],["来て","きて"],["、"],["その"],["身","み"],["に"],["起こった","おこった"],["こと"],["を"],["、"],["ことごとく"],["話した","はなした"],["。"]]},{"verse":24,"text":"それから、ヨシュアにこう言った。「主は、あの地をことごとく私たちの手に渡されました。そればかりか、あの地の住民はみな、私たちのことで震えおののいています。」","tok":[["それ"],["から"],["、"],["ヨシュア"],["に"],["こう"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["、"],["あの"],["地","ち"],["を"],["ことごとく"],["私たち","わたしたち"],["の"],["手","て"],["に"],["渡されました","わたされました"],["。"],["それ"],["ばかり"],["か"],["、"],["あの"],["地","ち"],["の"],["住民","じゅうみん"],["は"],["みな"],["、"],["私たち","わたしたち"],["の"],["こと"],["で"],["震えおののいて","ふるえおののいて"],["います"],["。"],["」"]]}]
[{"verse":1,"text":"イスラエル人は、ヨルダン川の向こう側、日の上る方で、アルノン川からヘルモン山まで、それと東アラバの全部を打ち、それを占領したが、その地の王たちは次のとおりである。","tok":[["イスラエル"],["人","にん"],["は"],["、"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["、"],["日","ひ"],["の"],["上る","のぼる"],["方","ほう"],["で"],["、"],["アルノン"],["川","かわ"],["から"],["ヘルモン"],["山","やま"],["まで"],["、"],["それ"],["と"],["東","ひがし"],["アラバ"],["の"],["全部","ぜんぶ"],["を"],["打ち","うち"],["、"],["それ"],["を"],["占領","せんりょう"],["した"],["が"],["、"],["その"],["地","ち"],["の"],["王","おう"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"エモリ人の王シホン。彼はヘシュボンに住み、アルノン川の縁にあるアロエル、川の中部とギルアデの半分、アモン人の国境のヤボク川までを支配していた。","tok":[["エモリ人","えもりにん"],["の"],["王","おう"],["シホン"],["。"],["彼","かれ"],["は"],["ヘシュボン"],["に"],["住み","すみ"],["、"],["アルノン"],["川","かわ"],["の"],["縁","えん"],["に"],["ある"],["アロエル"],["、"],["川","かわ"],["の"],["中部","ちゅうぶ"],["と"],["ギルアデ"],["の"],["半分","はんぶん"],["、"],["アモン人","あもんにん"],["の"],["国境","こっきょう"],["の"],["ヤボク"],["川","かわ"],["まで"],["を"],["支配","しはい"],["して"],["いた"],["。"]]},{"verse":3,"text":"またアラバを、東のキネレテ湖までと、東のアラバの海、すなわち塩の海、ベテ・ハエシモテの道まで、南はピスガの傾斜地のふもとまで支配していた。","tok":[["また"],["アラバ"],["を"],["、"],["東","ひがし"],["の"],["キネレテ"],["湖","こ"],["まで"],["と"],["、"],["東","ひがし"],["の"],["アラバ"],["の"],["海","うみ"],["、"],["すなわち"],["塩","しお"],["の"],["海","うみ"],["、"],["ベテ"],["・"],["ハエシモテ"],["の"],["道","みち"],["まで"],["、"],["南","みなみ"],["は"],["ピスガ"],["の"],["傾斜地","けいしゃち"],["の"],["ふもと"],["まで"],["支配","しはい"],["して"],["いた"],["。"]]},{"verse":4,"text":"また、レファイムの生き残りのひとりであったバシャンの王オグの領土。彼は、アシュタロテとエデレイに住み、","tok":[["また"],["、"],["レファイム"],["の"],["生き残り","いきのこり"],["の"],["ひとり"],["で"],["あった"],["バシャン"],["の"],["王","おう"],["オグ"],["の"],["領土","りょうど"],["。"],["彼","かれ"],["は"],["、"],["アシュタロテ"],["と"],["エデレイ"],["に"],["住み","すみ"],["、"]]},{"verse":5,"text":"ヘルモン山、サルカ、ゲシュル人とマアカ人の国境に至るバシャンの全土、およびギルアデの半分、ヘシュボンの王シホンの国境までを支配していた。","tok":[["ヘルモン"],["山","やま"],["、"],["サルカ"],["、"],["ゲシュル"],["人","にん"],["と"],["マアカ人","まあかにん"],["の"],["国境","こっきょう"],["に"],["至る","いたる"],["バシャン"],["の"],["全土","ぜんど"],["、"],["および"],["ギルアデ"],["の"],["半分","はんぶん"],["、"],["ヘシュボン"],["の"],["王","
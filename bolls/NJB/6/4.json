[{"verse":1,"text":"民がすべてヨルダン川を渡り終わったとき、主はヨシュアに告げて仰せられた。","tok":[["民","みん"],["が"],["すべて"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["終わった","おわった"],["とき"],["、"],["主","ぬし"],["は"],["ヨシュア"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":2,"text":"「民の中から十二人、部族ごとにひとりずつを選び出し、","tok":[["「"],["民","みん"],["の"],["中","なか"],["から"],["十二人","じゅうににん"],["、"],["部族","ぶぞく"],["ごと"],["に"],["ひとり"],["ずつ"],["を"],["選び出し","えらびだし"],["、"]]},{"verse":3,"text":"彼らに命じて言え。『ヨルダン川の真ん中で、祭司たちの足が堅く立ったその所から十二の石を取り、それを持って来て、あなたがたが今夜泊まる宿営地にそれを据えよ。』」","tok":[["彼","かれ"],["ら"],["に"],["命じて","めいじて"],["言え","いえ"],["。"],["『"],["ヨルダン"],["川","かわ"],["の"],["真ん中","まんなか"],["で"],["、"],["祭司","さいし"],["たち"],["の"],["足","あし"],["が"],["堅く","かたく"],["立った","たった"],["その"],["所","ところ"],["から"],["十二","じゅうに"],["の"],["石","いし"],["を"],["取り","とり"],["、"],["それ"],["を"],["持って","もって"],["来て","きて"],["、"],["あなた"],["がた"],["が"],["今夜","こんや"],["泊まる","とまる"],["宿営","しゅくえい"],["地","ち"],["に"],["それ"],["を"],["据え","すえ"],["よ"],["。"],["』"],["」"]]},{"verse":4,"text":"そこで、ヨシュアはイスラエルの人々の中から、部族ごとにひとりずつ、あらかじめ用意しておいた十二人の者を召し出した。","tok":[["そこ"],["で"],["、"],["ヨシュア"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["中","なか"],["から"],["、"],["部族","ぶぞく"],["ごと"],["に"],["ひとり"],["ずつ"],["、"],["あらかじめ"],["用意","ようい"],["して"],["おいた"],["十二人","じゅうににん"],["の"],["者","もの"],["を"],["召し出した","めしだした"],["。"]]},{"verse":5,"text":"ヨシュアは彼らに言った。「ヨルダン川の真ん中の、あなたがたの神、主の箱の前に渡って行って、イスラエルの子らの部族の数に合うように、各自、石一つずつを背負って来なさい。","tok":[["ヨシュア"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["ヨルダン"],["川","かわ"],["の"],["真ん中","まんなか"],["の"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["の"],["前","まえ"],["に"],["渡って","わたって"],["行って","いって"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["部族","ぶぞく"],["の"],["数","かず"],["に"],["合う","あう"],["よう"],["に"],["、"],["各自","かくじ"],["、"],["石","いし"],["一","ひと"],["つ"],["ずつ"],["を"],["背負って","せおって"],["来","き"],["なさい"],["。"]]},{"verse":6,"text":"それがあなたがたの間で、しるしとなるためである。後になって、あなたがたの子どもたちが、『これらの石はあなたがたにとってどういうものなのですか』と聞いたなら、","tok":[["それ"],["が"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["、"],["しるし"],["と"],["なる"],["ため"],["で"],["ある"],["。"],["後","あと"],["に"],["なって"],["、"],["あなた"],["がた"],["の"],["子ども","こども"],["たち"],["が"],["、"],["『"],["これ"],["ら"],["の"],["石","いし"],["は"],["あなた"],["がた"],["にとって"],["どういう"],["もの"],["な"],["の"],["です"],["か"],["』"],["と"],["聞いたなら","きいたなら"],["、"]]},{"verse":7,"text":"あなたがたは彼らに言わなければならない。『ヨルダン川の水は、主の契約の箱の前でせきとめられた。箱がヨルダン川を渡るとき、ヨルダン川の水がせきとめられた。これらの石は永久にイスラエル人の記念なのだ。』」","tok":[["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["に"],["言わなければ","いわなければ"],["ならない"],["。"],["『"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["は"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["の"],["前","まえ"],["で"],["せきとめられた"],["。"],["箱","ばこ"],["が"],["ヨルダン"],["川","かわ"],["を"],["渡る","わたる"],["とき"],["、"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["が"],["せきとめられた"],["。"],["これ"],["ら"],["の"],["石","いし"],["は"],["永久","えいきゅう"],["に"],["イスラエル"],["人","にん"],["の"],["記念","きねん"],["な"],["の"],["だ"],["。"],["』"],["」"]]},{"verse":8,"text":"イスラエルの人々は、ヨシュアが命じたとおりにした。主がヨシュアに告げたとおり、イスラエルの子らの部族の数に合うように、ヨルダン川の真ん中から十二の石を取り、それを宿営地に運び、そこに据えた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["ヨシュア"],["が"],["命じた","めいじた"],["とおり"],["に"],["した"],["。"],["主","ぬし"],["が"],["ヨシュア"],["に"],["告げた","つげた"],["とおり"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["部族","ぶぞく"],["の"],["数","かず"],["に"],["合う","あう"],["よう"],["に"],["、"],["ヨルダン"],["川","かわ"],["の"],["真ん中","まんなか"],["から"],["十二","じゅうに"],["の"],["石","いし"],["を"],["取り","とり"],["、"],["それ"],["を"],["宿営","しゅくえい"],["地","ち"],["に"],["運び","はこび"],["、"],["そこ"],["に"],["据えた","すえた"],["。"]]},{"verse":9,"text":"――ヨシュアはヨルダン川の真ん中で、契約の箱をかつぐ祭司たちの足の立っていた場所の下にあった十二の石を、立てたのである。それが今日までそこにある――","tok":[["―"],["―"],["ヨシュア"],["は"],["ヨルダン"],["川","かわ"],["の"],["真ん中","まんなか"],["で"],["、"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["かつぐ"],["祭司","さいし"],["たち"],["の"],["足","あし"],["の"],["立って","たって"],["いた"],["場所","ばしょ"],["の"],["下","した"],["に"],["あった"],["十二","じゅうに"],["の"],["石","いし"],["を"],["、"],["立てた","たてた"],["ので"],["ある"],["。"],["それ"],["が"],["今日","きょう"],["まで"],["そこ"],["に"],["ある"],["―"],["―"]]},{"verse":10,"text"
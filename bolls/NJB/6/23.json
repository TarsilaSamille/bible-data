[{"verse":1,"text":"主が周囲のすべての敵から守って、イスラエルに安住を許されて後、多くの日がたち、ヨシュアは年を重ねて老人になっていた。","tok":[["主","ぬし"],["が"],["周囲","しゅうい"],["の"],["すべて"],["の"],["敵","てき"],["から"],["守って","まもって"],["、"],["イスラエル"],["に"],["安住","あんじゅう"],["を"],["許されて","ゆるされて"],["後","あと"],["、"],["多く","おおく"],["の"],["日","ひ"],["が"],["たち"],["、"],["ヨシュア"],["は"],["年","とし"],["を"],["重ねて","かさねて"],["老人","ろうじん"],["に"],["なって"],["いた"],["。"]]},{"verse":2,"text":"ヨシュアは全イスラエル、その長老たちや、かしらたちや、さばきつかさたち、およびつかさたちを呼び寄せて彼らに言った。「私は年を重ねて、老人になった。","tok":[["ヨシュア"],["は"],["全","ぜん"],["イスラエル"],["、"],["その"],["長老","ちょうろう"],["たち"],["や"],["、"],["かしら"],["たち"],["や"],["、"],["さばき"],["つかさ"],["たち"],["、"],["および"],["つかさ"],["たち"],["を"],["呼び寄せて","よびよせて"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["年","とし"],["を"],["重ねて","かさねて"],["、"],["老人","ろうじん"],["に"],["なった"],["。"]]},{"verse":3,"text":"あなたがたは、あなたがたの神、主が、あなたがたのために、これらすべての国々に行ったことをことごとく見た。あなたがたのために戦ったのは、あなたがたの神、主だからである。","tok":[["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["これ"],["ら"],["すべて"],["の"],["国々","くにぐに"],["に"],["行った","いった"],["こと"],["を"],["ことごとく"],["見た","みた"],["。"],["あなた"],["がた"],["の"],["ため"],["に"],["戦った","たたかった"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"見よ。私は、ヨルダン川から日の入るほうの大海まで、これらの残っている国々と、すでに私が断ち滅ぼしたすべての国々とを、相続地として、くじによってあなたがたの部族に分け与えた。","tok":[["見","み"],["よ"],["。"],["私","わたくし"],["は"],["、"],["ヨルダン"],["川","かわ"],["から"],["日","ひ"],["の"],["入る","はいる"],["ほう"],["の"],["大海","たいかい"],["まで"],["、"],["これ"],["ら"],["の"],["残って","のこって"],["いる"],["国々","くにぐに"],["と"],["、"],["すでに"],["私","わたくし"],["が"],["断ち","たち"],["滅ぼした","ほろぼした"],["すべて"],["の"],["国々","くにぐに"],["と"],["を"],["、"],["相続","そうぞく"],["地","ち"],["として"],["、"],["くじ"],["によって"],["あなた"],["がた"],["の"],["部族","ぶぞく"],["に"],["分け与えた","わけあたえた"],["。"]]},{"verse":5,"text":"あなたがたの神、主ご自身が、あなたがたの前から彼らを追いやり、あなたがたの目の前から追い払う。あなたがたは、あなたがたの神、主があなたがたに告げたように、彼らの地を占領しなければならない。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["ご自身","ごじしん"],["が"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追いやり","おいやり"],["、"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["から"],["追い払う","おいはらう"],["。"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["に"],["告げた","つげた"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["地","ち"],["を"],["占領","せんりょう"],["しなければ"],["ならない"],["。"]]},{"verse":6,"text":"あなたがたは、モーセの律法の書にしるされていることを、ことごとく断固として守り行い、そこから右にも左にもそれてはならない。","tok":[["あなた"],["がた"],["は"],["、"],["モーセ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["しるされて"],["いる"],["こと"],["を"],["、"],["ことごとく"],["断固","だんこ"],["として"],["守り","まもり"],["行い","おこない"],["、"],["そこ"],["から"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それ"],["て"],["は"],["ならない"],["。"]]},{"verse":7,"text":"あなたがたは、これらの国民、あなたがたの中に残っているこれらの国民と交わってはならない。彼らの神々の名を口にしてはならない。それらによって誓ってはならない。それらに仕えてはならない。それらを拝んではならない。","tok":[["あなた"],["がた"],["は"],["、"],["これ"],["ら"],["の"],["国民","こくみん"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["残って","のこって"],["いる"],["これ"],["ら"],["の"],["国民","こくみん"],["と"],["交わって","まじわって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["の"],["名","な"],["を"],["口","くち"],["に"],["して"],["は"],["ならない"],["。"],["それ"],["ら"],["によって"],["誓って","ちかって"],["は"],["ならない"],["。"],["それ"],["ら"],["に"],["仕えて","つかえて"],["は"],["ならない"],["。"],["それ"],["ら"],["を"],["拝んで","おがんで"],["は"],["ならない"],["。"]]},{"verse":8,"text":"ただ、今日までしてきたように、あなたがたの神、主にすがらなければならない。","tok":[["ただ"],["、"],["今日","きょう"],["まで"],["して"],["きた"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["すがらなければ"],["ならない"],["。"]]},{"verse":9,"text":"主が、大きくて強い国々を、あなたがたの前から追い払ったので、今日まで、だれもあなたがたの前に立ちはだかることのできる者はいなかった。","tok":[["主","ぬし"],["が"],["、"],["大きくて","おおきくて"],["強い","つよい"],["国々","くにぐに"],["を"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["追い払った","おいはらった"],["ので"],["、"],["今日","きょう"],["まで"],["、"],["だれ"],["も"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["立ちはだかる","たちはだかる"],["こと"],["の"],["できる"],["者","もの"],["は"],["いなかった"],["。"]]},{"verse":10,"text":"あなたがたのひとりだけで千人を追うことができる。あなたがたの神、主ご自身が、あなたがたに約束したとおり、あなたがたのために戦われるからである。","tok":[["あなた"],["がた"],["の"],["ひとり"],["だけ"],["で"],["千人","せんにん"],["を"],["追う","おう"],["こと"],["が"],["できる"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["ご自身","ごじしん"],["が"],["、"],["あなた"],["がた"],["に"],["約束","やくそく"],["した"],["とおり"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["戦われる","たたかわれる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"あなたがたは、十分に気をつけて、あなたがたの神、主を愛しなさい。","tok":[["あなた"],["がた"],["は"],["、"],["十分","じゅうぶん"],["に"],["気","き"],["を"],["つけて"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["愛し","あいし"],["なさい"],["。"]]},{"verse":12,"text":"しかし、もしもあなたがたが、もう一度堕落して、これらの国民の生き残っている者、すなわち、あなたがたの中に残っている者たちと親しく交わり、彼らと互いに縁を結び、あなたがたが彼らの中に入って行き、彼らもあなたがたの中に入って来るなら、","tok":[["しかし"],["、"],["もし"],["も"],["あなた"],["が"],["た"],["が"],["、"],["もう"],["一度","いちど"],["堕落","だらく"],["して"],["、"],["これ"],["ら"],["の"],["国民","こくみん"],["の"],["生き残って","いきのこって"],["いる"],["者","もの"],["、"],["すなわち"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["残って","のこって"],["いる"],["者","もの"],["たち"],["と"],["親しく","したしく"],["交わり","まじわり"],["、"],["彼","かれ"],["ら"],["と"],["互い","たがい"],["に"],["縁","えん"],["を"],["結び","むすび"],["、"],["あなた"],["がた"],["が"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["入って","はいって"],["行き","いき"],["、"],["彼","かれ"],["ら"],["も"],["あなた"],["がた"],["の"],["中","なか"],["に"],["入って","はいって"],["来るなら","くるなら"],["、"]]},{"verse":13,"text":"あなたがたの神、主は、もはやこれらの国民を、あなたがたの前から追い払わないことを、しかと知らなければならない。彼らは、あなたがたにとって、わなとなり、落とし穴となり、あなたがたのわき腹にむちとなり、あなたがたの目にとげとなり、あなたがたはついに、あなたがたの神、主があなたがたに与えたこの良い地から、滅びうせる。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["もはや"],["これ"],["ら"],["の"],["国民","こくみん"],["を"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["追い払わない","おいはらわない"],["こと"],["を"],["、"],["しかと"],["知らなければ","しらなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["にとって"],["、"],["わな"],["と"],["なり"],["、"],["落とし穴","おとしあな"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["わき腹","わきばら"],["に"],["むち"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["目","め"],["に"],["とげ"],["と"],["なり"],["、"],["あなた"],["がた"],["は"],["ついに"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["に"],["与えた","あたえた"],["この"],["良い","よい"],["地","ち"],["から"],["、"],["滅び","ほろび"],["うせる"],["。"]]},{"verse":14,"text":"見よ。きょう、私は世のすべての人の行く道を行こうとしている。あなたがたは、心を尽くし、精神を尽くして知らなければならない。あなたがたの神、主が、あなたがたについて約束したすべての良いことが一つもたがわなかったことを。それは、一つもたがわず、みな、あなたがたのために実現した。","tok":[["見","み"],["よ"],["。"],["きょう"],["、"],["私","わたくし"],["は"],["世","よ"],["の"],["すべて"],["の"],["人","ひと"],["の"],["行く","いく"],["道","みち"],["を"],["行こう","いこう"],["として"],["いる"],["。"],["あなた"],["がた"],["は"],["、"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["精神","せいしん"],["を"],["尽くして","つくして"],["知らなければ","しらなければ"],["ならない"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["について"],["約束","やくそく"],["した"],["すべて"],["の"],["良い","よい"],["こと"],["が"],["一","ひと"],["つ"],["も"],["たがわなかった"],["こと"],["を"],["。"],["それ"],["は"],["、"],["一","ひと"],["つ"],["も"],["たがわず"],["、"],["みな"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["実現","じつげん"],["した"],["。"]]},{"verse":15,"text":"あなたがたの神、主があなたがたについて約束したすべての良いことが、あなたがたに実現したように、主はまた、すべての悪いことをあなたがたにもたらし、ついには、あなたがたの神、主が、あなたがたに与えたこの良い地から、あなたがたを根絶やしにする。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["について"],["約束","やくそく"],["した"],["すべて"],["の"],["良い","よい"],["こと"],["が"],["、"],["あなた"],["がた"],["に"],["実現","じつげん"],["した"],["よう"],["に"],["、"],["主","ぬし"],["は"],["また"],["、"],["すべて"],["の"],["悪い","わるい"],["こと"],["を"],["あなた"],["がた"],["に"],["もたらし"],["、"],["ついに"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["に"],["与えた","あたえた"],["この"],["良い","よい"],["地","ち"],["から"],["、"],["あなた"],["がた"],["を"],["根絶やし","ねだやし"],["に"],["する"],["。"]]},{"verse":16,"text":"主があなたがたに命じたあなたがたの神、主の契約を、あなたがたが破り、行って、ほかの神々に仕え、それらを拝むなら、主の怒りはあなたがたに向かって燃え上がり、あなたがたは主があなたがたに与えられたこの良い地から、ただちに滅びうせる。」","tok":[["主","ぬし"],["が"],["あなた"],["がた"],["に"],["命じた","めいじた"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["契約","けいやく"],[
[{"verse":1,"text":"ヨシュアはイスラエルの全部族をシェケムに集め、イスラエルの長老たち、そのかしらたち、さばきつかさたち、つかさたちを呼び寄せた。彼らが神の前に立ったとき、","tok":[["ヨシュア"],["は"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["を"],["シェケム"],["に"],["集め","あつめ"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["、"],["その"],["かしら"],["たち"],["、"],["さばき"],["つかさ"],["たち"],["、"],["つかさ"],["たち"],["を"],["呼び寄せた","よびよせた"],["。"],["彼","かれ"],["ら"],["が"],["神","かみ"],["の"],["前","まえ"],["に"],["立った","たった"],["とき"],["、"]]},{"verse":2,"text":"ヨシュアはすべての民に言った。「イスラエルの神、主はこう仰せられる。『あなたがたの先祖たち、アブラハムの父で、ナホルの父でもあるテラは、昔、ユーフラテス川の向こうに住んでおり、ほかの神々に仕えていた。","tok":[["ヨシュア"],["は"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["、"],["アブラハム"],["の"],["父","ちち"],["で"],["、"],["ナホル"],["の"],["父","ちち"],["で"],["も"],["ある"],["テラ"],["は"],["、"],["昔","むかし"],["、"],["ユーフラテス"],["川","かわ"],["の"],["向こう","むこう"],["に"],["住んで","すんで"],["おり"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕えて","つかえて"],["いた"],["。"]]},{"verse":3,"text":"わたしは、あなたがたの先祖アブラハムを、ユーフラテス川の向こうから連れて来て、カナンの全土を歩かせ、彼の子孫を増し、彼にイサクを与えた。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["アブラハム"],["を"],["、"],["ユーフラテス"],["川","かわ"],["の"],["向こう","むこう"],["から"],["連れて","つれて"],["来て","きて"],["、"],["カナン"],["の"],["全土","ぜんど"],["を"],["歩かせ","あるかせ"],["、"],["彼","かれ"],["の"],["子孫","しそん"],["を"],["増し","まし"],["、"],["彼","かれ"],["に"],["イサク"],["を"],["与えた","あたえた"],["。"]]},{"verse":4,"text":"ついで、わたしは、イサクにヤコブとエサウを与え、エサウにはセイルの山地を与えて、それを所有させた。ヤコブと彼の子らはエジプトに下った。","tok":[["つい"],["で"],["、"],["わたし"],["は"],["、"],["イサク"],["に"],["ヤコブ"],["と"],["エサウ"],["を"],["与え","あたえ"],["、"],["エサウ"],["に"],["は"],["セイル"],["の"],["山地","さんち"],["を"],["与えて","あたえて"],["、"],["それ"],["を"],["所有","しょゆう"],["させた"],["。"],["ヤコブ"],["と"],["彼","かれ"],["の"],["子","こ"],["ら"],["は"],["エジプト"],["に"],["下った","くだった"],["。"]]},{"verse":5,"text":"それからわたしは、モーセとアロンを遣わし、エジプトに災害を下した。わたしがその真ん中で行ったとおりである。その後、あなたがたを連れ出した。","tok":[["それ"],["から"],["わたし"],["は"],["、"],["モーセ"],["と"],["アロン"],["を"],["遣わし","つかわし"],["、"],["エジプト"],["に"],["災害","さいがい"],["を"],["下した","くだした"],["。"],["わたし"],["が"],["その"],["真ん中","まんなか"],["で"],["行った","おこなった"],["とおり"],["で"],["ある"],["。"],["その"],["後","ご"],["、"],["あなた"],["がた"],["を"],["連れ出した","つれだした"],["。"]]},{"verse":6,"text":"わたしが、あなたがたの先祖たちをエジプトから連れ出し、あなたがたが海に来たとき、エジプト人は、戦車と騎兵とをもってあなたがたの先祖たちのあとを追い、葦の海まで来た。","tok":[["わたし"],["が"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["を"],["エジプト"],["から"],["連れ出し","つれだし"],["、"],["あなた"],["がた"],["が"],["海","うみ"],["に"],["来た","きた"],["とき"],["、"],["エジプト"],["人","にん"],["は"],["、"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["と"],["を"],["もって"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["の"],["あと"],["を"],["追い","おい"],["、"],["葦","あし"],["の"],["海","うみ"],["まで"],["来た","きた"],["。"]]},{"verse":7,"text":"あなたがたが主に叫び求めたので、主はあなたがたとエジプト人との間に暗やみを置き、海に彼らを襲いかからせ、彼らをおおわれた。あなたがたは、わたしがエジプトで行ったことをその目で見てから、長い間、荒野に住んだ。","tok":[["あなた"],["がた"],["が"],["主に","おもに"],["叫び","さけび"],["求めた","もとめた"],["ので"],["、"],["主","ぬし"],["は"],["あなた"],["がた"],["と"],["エジプト"],["人","にん"],["と"],["の"],["間","あいだ"],["に"],["暗やみ","くらやみ"],["を"],["置き","おき"],["、"],["海","うみ"],["に"],["彼","かれ"],["ら"],["を"],["襲いかからせ","おそいかからせ"],["、"],["彼","かれ"],["ら"],["を"],["おおわれた"],["。"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["エジプト"],["で"],["行った","おこなった"],["こと"],["を"],["その"],["目","め"],["で"],["見て","みて"],["から"],["、"],["長い","ながい"],["間","あいだ"],["、"],["荒野","こうや"],["に"],["住んだ","すんだ"],["。"]]},{"verse":8,"text":"それからわたしはヨルダン川の向こう側に住んでいたエモリ人の地に、あなたがたを導き入れた。彼らはあなたがたと戦ったが、わたしは彼らをあなたがたの手に渡したので、あなたがたはその地を占領した。わたしが、あなたがたの前から彼らを根絶やしにしたからである。","tok":[["それ"],["から"],["わたし"],["は"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["に"],["住んで","すんで"],["いた"],["エモリ人","えもりにん"],["の"],["地","ち"],["に"],["、"],["あなた"],["がた"],["を"],["導き入れた","みちびきいれた"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["と"],["戦った","たたかった"],["が"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡した","わたした"],["ので"],["、"],["あなた"],["がた"],["は"],["その"],["地","ち"],["を"],["占領","せんりょう"],["した"],["。"],["わたし"],["が"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["根絶やし","ねだやし"],["に"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"それから、モアブの王ツィポルの子バラクが立って、イスラエルと戦い、ベオルの子バラムに人をやって彼を呼び寄せ、あなたがたをのろわせようとした。","tok":[["それ"],["から"],["、"],["モアブ"],["の"],["王","おう"],["ツィポル"],["の"],["子","こ"],["バラク"],["が"],["立って","たって"],["、"],["イスラエル"],["と"],["戦い","たたかい"],["、"],["ベオル"],["の"],["子","こ"],["バラム"],["に"],["人","ひと"],["を"],["やって"],["彼","かれ"],["を"],["呼び寄せ","よびよせ"],["、"],["あなた"],["がた"],["を"],["のろわせよう"],["と"],["した"],["。"]]},{"verse":10,"text":"わたしはバラムに聞こうとしなかった。彼は、かえって、あなたがたを祝福し、わたしはあなたがたを彼の手から救い出した。","tok":[["わたし"],["は"],["バラム"],["に"],["聞こう","きこう"],["と"],["しなかった"],["。"],["彼","かれ"],["は"],["、"],["かえって"],["、"],["あなた"],["がた"],["を"],["祝福","しゅくふく"],["し"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["彼","かれ"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["。"]]},{"verse":11,"text":"あなたがたはヨルダン川を渡ってエリコに来た。エリコの者たちや、エモリ人、ペリジ人、カナン人、ヘテ人、ギルガシ人、ヒビ人、エブス人があなたがたと戦ったが、わたしは彼らを、あなたがたの手に渡した。","tok":[["あなた"],["がた"],["は"],["ヨルダン"],["川","かわ"],["を"],["渡って","わたって"],["エリコ"],["に"],["来た","きた"],["。"],["エリコ"],["の"],["者","もの"],["たち"],["や"],["、"],["エモリ人","えもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["カナン人","かなんにん"],["、"],["ヘテ人","へてにん"],["、"],["ギルガシ"],["人","にん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス"],["人","ひと"],["が"],["あなた"],["がた"],["と"],["戦った","たたかった"],["が"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡した","わたした"],["。"]]},{"verse":12,"text":"わたしは、あなたがたの前にくまばちを送ったので、くまばちがエモリ人のふたりの王をあなたがたの前から追い払った。あなたがたの剣にもよらず、またあなたがたの弓にもよらなかった。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["くまばち"],["を"],["送った","おくった"],["ので"],["、"],["くまばち"],["が"],["エモリ人","えもりにん"],["の"],["ふたり"],["の"],["王","おう"],["を"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["追い払った","おいはらった"],["。"],["あなた"],["がた"],["の"],["剣","けん"],["に"],["も"],["よらず"],["、"],["また"],["あなた"],["がた"],["の"],["弓","ゆみ"],["に"],["も"],["よらなかった"],["。"]]},{"verse":13,"text":"わたしは、あなたがたが得るのに労しなかった地と、あなたがたが建てなかった町々を、あなたがたに与えたので、あなたがたはそこに住み、自分で植えなかったぶどう畑とオリーブ畑で食べている。』","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["が"],["得る","える"],["のに"],["労しなかった","ろうしなかった"],["地","ち"],["と"],["、"],["あなた"],["がた"],["が"],["建てなかった","たてなかった"],["町々","まちまち"],["を"],["、"],["あなた"],["がた"],["に"],["与えた","あたえた"],["ので"],["、"],["あなた"],["がた"],["は"],["そこ"],["に"],["住み","すみ"],["、"],["自分","じぶん"],["で"],["植えなかった","うえなかった"],["ぶどう"],["畑","はたけ"],["と"],["オリーブ"],["畑","はたけ"],["で"],["食べて","たべて"],["いる"],["。"],["』"]]},{"verse":14,"text":"今、あなたがたは主を恐れ、誠実と真実をもって主に仕えなさい。あなたがたの先祖たちが川の向こう、およびエジプトで仕えた神々を除き去り、主に仕えなさい。","tok":[["今","いま"],["、"],["あなた"],["がた"],["は"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["誠実","せいじつ"],["と"],["真実","しんじつ"],["を"],["もって"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["が"],["川","かわ"],["の"],["向こう","むこう"],["、"],["および"],["エジプト"],["で"],["仕えた","つかえた"],["神々","かみがみ"],["を"],["除き去り","のぞきさり"],["、"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":15,"text":"もしも主に仕えることがあなたがたの気に入らないなら、川の向こうにいたあなたがたの先祖たちが仕えた神々でも、今あなたがたが住んでいる地のエモリ人の神々でも、あなたがたが仕えようと思うものを、どれでも、きょう選ぶがよい。私と私の家とは、主に仕える。」","tok":[["もし"],["も"],["主に","おもに"],["仕える","つかえる"],["こと"],["が"],["あなた"],["がた"],["の"],["気","き"],["に"],["入らないなら","いらないなら"],["、"],["川","かわ"],["の"],["向こう","むこう"],["に"],["いた"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["が"],["仕えた","つかえた"],["神々","かみがみ"],["で"],["も"],["、"],["今","いま"],["あなた"],["がた"],["が"],["住んで","すんで"],["いる"],["地","ち"],["の"],["エモリ人","えもりにん"],["の"],["神々","かみがみ"],["で"],["も"],["、"],["あなた"],["がた"],["が"],["仕えよう","つかえよう"],["と"],["思う","おもう"],["もの"],["を"],["、"],["どれ"],["で"],["も"],["、"],["きょう"],["選ぶ","えらぶ"],["が"],["よい"],["。"],["私","わたくし"],["と"],["私","わたくし"],["の"],["家","いえ"],["と"],["は"],["、"],["主に","おもに"],["仕える","つかえる"],["。"],["」"]]},{"verse":16,"text":"すると、民は答えて言った。「私たちが主を捨てて、ほかの神々に仕えるなど、絶対にそんなことはありません。","tok":[["する"],["と"],["、"],["民","みん"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["が"],["主","ぬし"],["を"],["捨てて","すてて"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕える","つかえる"],["など"],["、"],["絶対","ぜったい"],["に"],["そんな"],["こと"],["は"],["ありません"],["。"]]},{"verse":17,"text":"私たちの神、主は、私たちと私たちの先祖たちを、エジプトの地、奴隷の家から導き上られた方、私たちの目の前で、あの数々の大きなしるしを行い、私たちの行くすべての道で、私たちの通ったすべての民の中で、私たちを守られた方だからです。","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["私たち","わたしたち"],["と"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["たち"],["を"],["、"],["エジプト"],["の"],["地","ち"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["導き","みちびき"],["上られた","のぼられた"],["方","かた"],["、"],["私たち","わたしたち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["あの"],["数々","かずかず"],["の"],["大きな","おおきな"],["しるし"],["を"],["行い","おこない"],["、"],["私たち","わたしたち"],["の"],["行く","いく"],["すべて"],["の"],["道","みち"],["で"],["、"],["私たち","わたしたち"],["の"],["通った","かよった"],["すべて"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["、"],["私たち","わたしたち"],["を"],["守られた","まもられた"],["方","ほう"],["だ"],["から"],["です"],["。"]]},{"verse":18,"text":"主はまた、すべての民、この地に住んでいたエモリ人をも、私たちの前から追い払われました。私たちもまた、主に仕えます。主が私たちの神だからです。」","tok":[["主","ぬし"],["は"],["また"],["、"],["すべて"],["の"],["民","たみ"],["、"],["この"],["地","ち"],["に"],["住んで","すんで"],["いた"],["エモリ人","えもりにん"],["を"],["も"],["、"],["私たち","わたしたち"],["の"],["前","まえ"],["から"],["追い払われました","おいはらわれました"],["。"],["私たち","わたしたち"],["も"],["また"],["、"],["主に","おもに"],["仕えます","つかえます"],["。"],["主","ぬし"],["が"],["私たち","わたしたち"],["の"],["神","かみ"],["だ"],["から"],["です"],["。"],["」"]]},{"verse":19,"text":"すると、ヨシュアは民に言った。「あなたがたは主に仕えることはできないであろう。主は聖なる神であり、ねたむ神である。あなたがたのそむきも、罪も赦さないからである。","tok":[["する"],["と"],["、"],["ヨシュア"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["主に","おもに"],["仕える","つかえる"],["こと"],["は"],["できないで"],["あろう"],["。"],["主","ぬし"],["は"],["聖","せい"],["なる"],["神","かみ"],["で"],["あり"],["、"],["ねたむ"],["神","かみ"],["で"],["ある"],["。"],["あなた"],["がた"],["の"],["そむき"],["も"],["、"],["罪","つみ"],["も"],["赦さない","ゆるさない"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"もしあなたがたが主を捨てて、外国の神々に仕えるなら、あなたがたをしあわせにして後も、主はもう一度あなたがたにわざわいを下し、あなたがたを滅ぼし尽くす。」","tok":[["もし"],["あなた"],["がた"],["が"],["主","ぬし"],["を"],["捨てて","すてて"],["、"],["外国","がいこく"],["の"],["神々","かみがみ"],["に"],["仕えるなら","つかえるなら"],["、"],["あなた"],["がた"],["を"],["しあわせ"],["に"],["して"],["後","あと"],["も"],["、"],["主","
[{"verse":1,"text":"愛する者たち。霊だからといって、みな信じてはいけません。それらの霊が神からのものかどうかを、ためしなさい。なぜなら、にせ預言者がたくさん世に出て来たからです。","tok":[["愛する","あいする"],["者","もの"],["たち"],["。"],["霊","れい"],["だ"],["から"],["と"],["いって"],["、"],["みな"],["信じて","しんじて"],["は"],["いけません"],["。"],["それ"],["ら"],["の"],["霊","れい"],["が"],["神","かみ"],["から"],["の"],["もの"],["か"],["どう"],["か"],["を"],["、"],["ためし"],["なさい"],["。"],["なぜ"],["なら"],["、"],["にせ"],["預言者","よげんしゃ"],["が"],["たくさん"],["世","せい"],["に"],["出て","でて"],["来た","きた"],["から"],["です"],["。"]]},{"verse":2,"text":"人となって来たイエス・キリストを告白する霊はみな、神からのものです。それによって神からの霊を知りなさい。","tok":[["人","ひと"],["と"],["なって"],["来た","きた"],["イエス"],["・"],["キリスト"],["を"],["告白","こくはく"],["する"],["霊","れい"],["は"],["みな"],["、"],["神","かみ"],["から"],["の"],["もの"],["です"],["。"],["それ"],["によって"],["神","かみ"],["から"],["の"],["霊","れい"],["を"],["知り","しり"],["なさい"],["。"]]},{"verse":3,"text":"イエスを告白しない霊はどれ一つとして神から出たものではありません。それは反キリストの霊です。あなたがたはそれが来ることを聞いていたのですが、今それが世に来ているのです。","tok":[["イエス"],["を"],["告白","こくはく"],["しない"],["霊","れい"],["は"],["どれ"],["一","ひと"],["つ"],["として"],["神","かみ"],["から"],["出た","でた"],["もの"],["で"],["は"],["ありません"],["。"],["それ"],["は"],["反","はん"],["キリスト"],["の"],["霊","れい"],["です"],["。"],["あなた"],["がた"],["は"],["それ"],["が"],["来る","くる"],["こと"],["を"],["聞いて","きいて"],["いた"],["の"],["です"],["が"],["、"],["今","いま"],["それ"],["が"],["世","よ"],["に"],["来て","きて"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"子どもたちよ。あなたがたは神から出た者です。そして彼らに勝ったのです。あなたがたのうちにおられる方が、この世のうちにいる、あの者よりも力があるからです。","tok":[["子ども","こども"],["たち"],["よ"],["。"],["あなた"],["がた"],["は"],["神","かみ"],["から"],["出た","でた"],["者","もの"],["です"],["。"],["そして"],["彼","かれ"],["ら"],["に"],["勝った","かった"],["の"],["です"],["。"],["あなた"],["がた"],["の"],["うち"],["に"],["おられる"],["方","ほう"],["が"],["、"],["この世","このよ"],["の"],["うち"],["に"],["いる"],["、"],["あの"],["者","もの"],["より"],["も"],["力","ちから"],["が"],["ある"],["から"],["です"],["。"]]},{"verse":5,"text":"彼らはこの世の者です。ですから、この世のことばを語り、この世もまた彼らの言うことに耳を傾けます。","tok":[["彼","かれ"],["ら"],["は"],["この世","このよ"],["の"],["者","もの"],["です"],["。"],["です"],["から"],["、"],["この世","このよ"],["の"],["ことば"],["を"],["語り","かたり"],["、"],["この世","このよ"],["も"],["また"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["に"],["耳","みみ"],["を"],["傾けます","かたむけます"],["。"]]},{"verse":6,"text":"私たちは神から出た者です。神を知っている者は、私たちの言うことに耳を傾け、神から出ていない者は、私たちの言うことに耳を貸しません。私たちはこれで真理の霊と偽りの霊とを見分けます。","tok":[["私たち","わたしたち"],["は"],["神","かみ"],["から"],["出た","でた"],["者","もの"],["です"],["。"],["神","かみ"],["を"],["知って","しって"],["いる"],["者","もの"],["は"],["、"],["私たち","わたしたち"],["の"],["言う","いう"],["こと"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["神","かみ"],["から"],["出て","でて"],["いない"],["者","もの"],["は"],["、"],["私たち","わたしたち"],["の"],["言う","いう"],["こと"],["に"],["耳","みみ"],["を"],["貸しません","かしません"],["。"],["私たち","わたしたち"],["は"],["これ"],["で"],["真理","しんり"],["の"],["霊","れい"],["と"],["偽り","いつわり"],["の"],["霊","れい"],["と"],["を"],["見分けます","みわけます"],["。"]]},{"verse":7,"text":"愛する者たち。私たちは、互いに愛し合いましょう。愛は神から出ているのです。愛のある者はみな神から生まれ、神を知っています。","tok":[["愛する","あいする"],["者","もの"],["たち"],["。"],["私たち","わたしたち"],["は"],["、"],["互い","たがい"],["に"],["愛し合いましょう","あいしあいましょう"],["。"],["愛","あい"],["は"],["神","かみ"],["から"],["出て","でて"],["いる"],["の"],["です"],["。"],["愛","あい"],["の"],["ある"],["者","もの"],["は"],["みな"],["神","かみ"],["から"],["生まれ","うまれ"],["、"],["神","かみ"],["を"],["知って","しって"],["います"],["。"]]},{"verse":8,"text":"愛のない者に、神はわかりません。なぜなら神は愛だからです。","tok":[["愛","あい"],["の"],["ない"],["者","もの"],["に"],["、"],["神","かみ"],["は"],["わかりません"],["。"],["なぜ"],["なら"],["神","かみ"],["は"],["愛","あい"],["だ"],["から"],["です"],["。"]]},{"verse":9,"text":"神はそのひとり子を世に遣わし、その方によって私たちに、いのちを得させてくださいました。ここに、神の愛が私たちに示されたのです。","tok":[["神","かみ"],["は"],["その"],["ひとり"],["子","こ"],["を"],["世","よ"],["に"],["遣わし","つかわし"],["、"],["その"],["方","かた"],["によって"],["私たち","わたしたち"],["に"],["、"],["いのち"],["を"],["得させて","えさせて"],["くださいました"],["。"],["ここ"],["に"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["私たち","わたしたち"],["に"],["示された","しめされた"],["の"],["です"],["。"]]},{"verse":10,"text":"私たちが神を愛したのではなく、神が私たちを愛し、私たちの罪のために、なだめの供え物としての御子を遣わされました。ここに愛があるのです。","tok":[["私たち","わたしたち"],["が"],["神","かみ"],["を"],["愛した","あいした"],["ので"],["は"],["なく"],["、"],["神","かみ"],["が"],["私たち","わたしたち"],["を"],["愛し","あいし"],["、"],["私たち","わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["なだめ"],["の"],["供え物","そなえもの"],["として"],["の"],["御子","みこ"],["を"],["遣わされました","つかわされました"],["。"],["ここ"],["に"],["愛","あい"],["が"],["ある"],["の"],["です"],["。"]]},{"verse":11,"text":"愛する者たち。神がこれほどまでに私たちを愛してくださったのなら、私たちもまた互いに愛し合うべきです。","tok":[["愛する","あいする"],["者","もの"],["たち"],["。"],["神","かみ"],["が"],["これ"],["ほど"],["まで"],["に"],["私たち","わたしたち"],["を"],["愛して","あいして"],["くださった"],["の"],["なら"],["、"],["私たち","わたしたち"],["も"],["また"],["互い","たがい"],["に"],["愛し合うべきです","あいしあうべきです"],["。"]]},{"verse":12,"text":"いまだかつて、だれも神を見た者はありません。もし私たちが互いに愛し合うなら、神は私たちのうちにおられ、神の愛が私たちのうちに全うされるのです。","tok":[["いまだ"],["かつて"],["、"],["だれ"],["も"],["神","かみ"],["を"],["見た","みた"],["者","もの"],["は"],["ありません"],["。"],["もし"],["私たち","わたしたち"],["が"],["互い","たがい"],["に"],["愛し合うなら","あいしあうなら"],["、"],["神","かみ"],["は"],["私たち","わたしたち"],["の"],["うち"],["に"],["おられ"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["私たち","わたしたち"],["の"],["うち"],["に"],["全う","まっとう"],["される"],["の"],["です"],["。"]]},{"verse":13,"text":"神は私たちに御霊を与えてくださいました。それによって、私たちが神のうちにおり、神も私たちのうちにおられることがわかります。","tok":[["神","かみ"],["は"],["私たち","わたしたち"],["に"],["御霊","ごれい"],["を"],["与えて","あたえて"],["くださいました"],["。"],["それ"],["によって"],["、"],["私たち","わたしたち"],["が"],["神","かみ"],["の"],["うち"],["に"],["おり"],["、"],["神","かみ"],["も"],["私たち","わたしたち"],["の"],["うち"],["に"],["おられる"],["こと"],["が"],["わかります"],["。"]]},{"verse":14,"text":"私たちは、御父が御子を世の救い主として遣わされたのを見て、今そのあかしをしています。","tok":[["私たち","わたしたち"],["は"],["、"],["御父","おちち"],["が"],["御子","みこ"],["を"],["世","よ"],["の"],["救い主","すくいぬし"],["として"],["遣わされた","つかわされた"],["の"],["を"],["見て","みて"],["、"],["今","いま"],["その"],["あかし"],["を"],["して"],["います"],["。"]]},{"verse":15,"text":"だれでも、イエスを神の御子と告白するなら、神はその人のうちにおられ、その人も神のうちにいます。","tok":[["だれ"],["で"],["も"],["、"],["イエス"],["を"],["神","かみ"],["の"],["御子","みこ"],["と"],["告白","こくはく"],["するなら"],["、"],["神","かみ"],["は"],["その"],["人","ひと"],["の"],["うち"],["に"],["おられ"],["、"],["その"],["人","ひと"],["も"],["神","かみ"],["の"],["うち"],["に"],["います"],["。"]]},{"verse":16,"text":"私たちは、私たちに対する神の愛を知り、また信じています。神は愛です。愛のうちにいる者は神のうちにおり、神もその人のうちにおられます。","tok":[["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["に"],["対する","たいする"],["神","かみ"],["の"],["愛","あい"],["を"],["知り","しり"],["、"],["また"],["信じて","しんじて"],["います"],["。"],["神","かみ"],["は"],["愛","あい"],["です"],["。"],["愛","あい"],["の"],["うち"],["に"],["いる"],["者","もの"],["は"],["神","かみ"],["の"],["うち"],["に"],["おり"],["、"],["神","かみ"],["も"],["その"],["人","ひと"],["の"],["うち"],["に"],["おられます"],["。"]]},{"verse":17,"text":"このことによって、愛が私たちにおいても完全なものとなりました。それは私たちが、さばきの日にも大胆さを持つことができるためです。なぜなら、私たちもこの世にあってキリストと同じような者であるからです。","tok":[["この"],["こと"],["によって"],["、"],["愛","あい"],["が"],["私たち","わたしたち"],["に"],["おいて"],["も"],["完全","かんぜん"],["な"],["もの"],["と"],["なりました"],["。"],["それ"],["は"],["私たち","わたしたち"],["が"],["、"],["さばき"],["の"],["日","ひ"],["に"],["も"],["大胆","だいたん"],["さ"],["を"],["持つ","もつ"],["こと"],["が"],["できる"],["ため"],["です"],["。"],["なぜ"],["なら"],["、"],["私たち","わたしたち"],["も"],["この世","このよ"],["に"],["あって"],["キリスト"],["と"],["同じ","おなじ"],["よう"],["な"],["者","もの"],["で"],["ある"],["から"],["です"],["。"]]},{"verse":18,"text":"愛には恐れがありません。全き愛は恐れを締め出します。なぜなら恐れには刑罰が伴っているからです。恐れる者の愛は、全きものとなっていないのです。","tok":[["愛","あい"],["に"],["は"],["恐れ","おそれ"],["が"],["ありません"],["。"],["全","ぜん"],["き"],["愛","あい"],["は"],["恐れ","おそれ"],["を"],["締め出します","しめだします"],["。"],["なぜ"],["なら"],["恐れ","おそれ"],["に"],["は"],["刑罰","けいばつ"],["が"],["伴って","ともなって"],["いる"],["から"],["です"],["。"],["恐れる","おそれる"],["者","もの"],["の"],["愛","あい"],["は"],["、"],["全","ぜん"],["きもの"],["と"],["なって"],["いない"],["の"],["です"],["。"]]},{"verse":19,"text":"私たちは愛しています。神がまず私たちを愛してくださったからです。","tok":[["私たち","わたしたち"],["は"],["愛して","あいして"],["います"],["。"],["神","かみ"],["が"],["まず"],["私たち","わたしたち"],["を"],["愛して","あいして"],["くださった"],["から"],["です"],["。"]]},{"verse":20,"text":"神を愛すると言いながら兄弟を憎んでいるなら、その人は偽り者です。目に見える兄弟を愛していない者に、目に見えない神を愛することはできません。","tok":[["神","かみ"],["を"],["愛する","あいする"],["と"],["言い","いい"],["ながら"],["兄弟","きょうだい"],["を"],["憎んで","にくんで"],["いるなら"],["、"],["その"],["人","ひと"],["は"],["偽り者","いつわりしゃ"],["です"],["。"],["目","め"],["に"],["見える","みえる"],["兄弟","きょうだい"],["を"],["愛して","あいして"],["いない"],["者","もの"],["に"],["、"],["目","め"],["に"],["見えない","みえない"],["神","かみ"],["を"],["愛する","あいする"],["こと"],["は"],["できません"],["。"]]},{"verse":21,"text":"神を愛する者は、兄弟をも愛すべきです。私たちはこの命令をキリストから受けています。","tok":[["神","かみ"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["兄弟","きょうだい"],["を"],["も"],["愛すべきです","あいすべきです"],["。"],["私たち","わたしたち"],["は"],["この"],["命令","めいれい"],["を"],["キリスト"],["から"],["受けて","うけて"],["います"],["。"]]}]
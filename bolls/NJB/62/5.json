[{"verse":1,"text":"イエスがキリストであると信じる者はだれでも、神によって生まれたのです。生んでくださった方を愛する者はだれでも、その方によって生まれた者をも愛します。","tok":[["イエス"],["が"],["キリスト"],["で"],["ある"],["と"],["信じる","しんじる"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["神","かみ"],["によって"],["生まれた","うまれた"],["の"],["です"],["。"],["生んで","うんで"],["くださった"],["方","ほう"],["を"],["愛する","あいする"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["その"],["方","かた"],["によって"],["生まれた","うまれた"],["者","もの"],["を"],["も"],["愛します","あいします"],["。"]]},{"verse":2,"text":"私たちが神を愛してその命令を守るなら、そのことによって、私たちが神の子どもたちを愛していることがわかります。","tok":[["私たち","わたしたち"],["が"],["神","かみ"],["を"],["愛して","あいして"],["その"],["命令","めいれい"],["を"],["守るなら","まもるなら"],["、"],["その"],["こと"],["によって"],["、"],["私たち","わたしたち"],["が"],["神","かみ"],["の"],["子ども","こども"],["たち"],["を"],["愛して","あいして"],["いる"],["こと"],["が"],["わかります"],["。"]]},{"verse":3,"text":"神を愛するとは、神の命令を守ることです。その命令は重荷とはなりません。","tok":[["神","かみ"],["を"],["愛する","あいする"],["と"],["は"],["、"],["神","かみ"],["の"],["命令","めいれい"],["を"],["守る","まもる"],["こと"],["です"],["。"],["その"],["命令","めいれい"],["は"],["重荷","おもに"],["と"],["は"],["なりません"],["。"]]},{"verse":4,"text":"なぜなら、神によって生まれた者はみな、世に勝つからです。私たちの信仰、これこそ、世に打ち勝った勝利です。","tok":[["なぜ"],["なら"],["、"],["神","かみ"],["によって"],["生まれた","うまれた"],["者","もの"],["は"],["みな"],["、"],["世","よ"],["に"],["勝つ","かつ"],["から"],["です"],["。"],["私たち","わたしたち"],["の"],["信仰","しんこう"],["、"],["これ"],["こそ"],["、"],["世","よ"],["に"],["打ち勝った","うちかった"],["勝利","しょうり"],["です"],["。"]]},{"verse":5,"text":"世に勝つ者とはだれでしょう。イエスを神の御子と信じる者ではありませんか。","tok":[["世","よ"],["に"],["勝つ","かつ"],["者","もの"],["と"],["は"],["だれ"],["でしょう"],["。"],["イエス"],["を"],["神","かみ"],["の"],["御子","みこ"],["と"],["信じる","しんじる"],["者","もの"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":6,"text":"このイエス・キリストは、水と血とによって来られた方です。ただ水によってだけでなく、水と血とによって来られたのです。そして、あかしをする方は御霊です。御霊は真理だからです。","tok":[["この"],["イエス"],["・"],["キリスト"],["は"],["、"],["水","みず"],["と"],["血","ち"],["と"],["によって"],["来られた","こられた"],["方","ほう"],["です"],["。"],["ただ"],["水","みず"],["によって"],["だけ"],["で"],["なく"],["、"],["水","みず"],["と"],["血","ち"],["と"],["によって"],["来られた","こられた"],["の"],["です"],["。"],["そして"],["、"],["あかし"],["を"],["する"],["方","ほう"],["は"],["御霊","みたま"],["です"],["。"],["御霊","ごれい"],["は"],["真理","しんり"],["だ"],["から"],["です"],["。"]]},{"verse":7,"text":"あかしするものが三つあります。","tok":[["あかし"],["する"],["もの"],["が"],["三","みっ"],["つ"],["あります"],["。"]]},{"verse":8,"text":"御霊と水と血です。この三つが一つとなるのです。","tok":[["御霊","ごれい"],["と"],["水","みず"],["と"],["血","ち"],["です"],["。"],["この"],["三","みっ"],["つ"],["が"],["一","ひと"],["つ"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":9,"text":"もし、私たちが人間のあかしを受け入れるなら、神のあかしはそれにまさるものです。御子についてあかしされたことが神のあかしだからです。","tok":[["もし"],["、"],["私たち","わたしたち"],["が"],["人間","にんげん"],["の"],["あかし"],["を"],["受け入れるなら","うけいれるなら"],["、"],["神","かみ"],["の"],["あかし"],["は"],["それ"],["に"],["まさる"],["もの"],["です"],["。"],["御子","みこ"],["について"],["あかし"],["された"],["こと"],["が"],["神","かみ"],["の"],["あかし"],["だ"],["から"],["です"],["。"]]},{"verse":10,"text":"神の御子を信じる者は、このあかしを自分の心の中に持っています。神を信じない者は、神を偽り者とするのです。神が御子についてあかしされたことを信じないからです。","tok":[["神","かみ"],["の"],["御子","みこ"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["この"],["あかし"],["を"],["自分","じぶん"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["持って","もって"],["います"],["。"],["神","かみ"],["を"],["信じない","しんじない"],["者","もの"],["は"],["、"],["神","かみ"],["を"],["偽り","いつわり"],["者","もの"],["と"],["する"],["の"],["です"],["。"],["神","かみ"],["が"],["御子","みこ"],["について"],["あかし"],["された"],["こと"],["を"],["信じない","しんじない"],["から"],["です"],["。"]]},{"verse":11,"text":"そのあかしとは、神が私たちに永遠のいのちを与えられたということ、そしてこのいのちが御子のうちにあるということです。","tok":[["その"],["あかし"],["と"],["は"],["、"],["神","かみ"],["が"],["私たち","わたしたち"],["に"],["永遠","えいえん"],["の"],["いのち"],["を"],["与えられた","あたえられた"],["と"],["いう"],["こと"],["、"],["そして"],["この"],["いのち"],["が"],["御子","みこ"],["の"],["うち"],["に"],["ある"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":12,"text":"御子を持つ者はいのちを持っており、神の御子を持たない者はいのちを持っていません。","tok":[["御子","みこ"],["を"],["持つ","もつ"],["者","もの"],["は"],["いのち"],["を"],["持って","もって"],["おり"],["、"],["神","かみ"],["の"],["御子","みこ"],["を"],["持たない","もたない"],["者","もの"],["は"],["いのち"],["を"],["持って","もって"],["いません"],["。"]]},{"verse":13,"text":"私が神の御子の名を信じているあなたがたに対してこれらのことを書いたのは、あなたがたが永遠のいのちを持っていることを、あなたがたによくわからせるためです。","tok":[["私","わたくし"],["が"],["神","かみ"],["の"],["御子","みこ"],["の"],["名","な"],["を"],["信じて","しんじて"],["いる"],["あなた"],["がた"],["に対して","にたいして"],["これ"],["ら"],["の"],["こと"],["を"],["書いた","かいた"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["永遠","えいえん"],["の"],["いのち"],["を"],["持って","もって"],["いる"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["よく"],["わからせる"],["ため"],["です"],["。"]]},{"verse":14,"text":"何事でも神のみこころにかなう願いをするなら、神はその願いを聞いてくださるということ、これこそ神に対する私たちの確信です。","tok":[["何事","なにごと"],["で"],["も"],["神","かみ"],["のみ"],["こころ"],["に"],["かなう"],["願い","ねがい"],["を"],["するなら"],["、"],["神","かみ"],["は"],["その"],["願い","ねがい"],["を"],["聞いて","きいて"],["くださる"],["と"],["いう"],["こと"],["、"],["これ"],["こそ"],["神","かみ"],["に"],["対する","たいする"],["私たち","わたしたち"],["の"],["確信","かくしん"],["です"],["。"]]},{"verse":15,"text":"私たちの願う事を神が聞いてくださると知れば、神に願ったその事は、すでにかなえられたと知るのです。","tok":[["私たち","わたしたち"],["の"],["願う","ねがう"],["事","こと"],["を"],["神","かみ"],["が"],["聞いて","きいて"],["くださる"],["と"],["知れば","しれば"],["、"],["神","かみ"],["に"],["願った","ねがった"],["その"],["事","こと"],["は"],["、"],["すでに"],["かなえられた"],["と"],["知る","しる"],["の"],["です"],["。"]]},{"verse":16,"text":"だれでも兄弟が死に至らない罪を犯しているのを見たなら、神に求めなさい。そうすれば神はその人のために、死に至らない罪を犯している人々に、いのちをお与えになります。死に至る罪があります。この罪については、願うようにとは言いません。","tok":[["だれ"],["で"],["も"],["兄弟","きょうだい"],["が"],["死","し"],["に"],["至らない","いたらない"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["の"],["を"],["見たなら","みたなら"],["、"],["神","かみ"],["に"],["求め","もとめ"],["なさい"],["。"],["そう"],["すれば"],["神","かみ"],["は"],["その"],["人","ひと"],["の"],["ため"],["に"],["、"],["死","し"],["に"],["至らない","いたらない"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["人々","ひとびと"],["に"],["、"],["いのち"],["を"],["お与え","おあたえ"],["に"],["なります"],["。"],["死","し"],["に"],["至る","いたる"],["罪","つみ"],["が"],["あります"],["。"],["この"],["罪","つみ"],["について"],["は"],["、"],["願う","ねがう"],["よう"],["に"],["と"],["は"],["言いません","いいません"],["。"]]},{"verse":17,"text":"不正はみな罪ですが、死に至らない罪があります。","tok":[["不正","ふせい"],["は"],["みな"],["罪","つみ"],["です"],["が"],["、"],["死","し"],["に"],["至らない","いたらない"],["罪","つみ"],["が"],["あります"],["。"]]},{"verse":18,"text":"神によって生まれた者はだれも罪を犯さないことを、私たちは知っています。神から生まれた方が彼を守っていてくださるので、悪い者は彼に触れることができないのです。","tok":[["神","かみ"],["によって"],["生まれた","うまれた"],["者","もの"],["は"],["だれ"],["も"],["罪","つみ"],["を"],["犯さない","おかさない"],["こと"],["を"],["、"],["私たち","わたしたち"],["は"],["知って","しって"],["います"],["。"],["神","かみ"],["から"],["生まれた","うまれた"],["方","ほう"],["が"],["彼","かれ"],["を"],["守って","まもって"],["いて"],["くださる"],["ので"],["、"],["悪い","わるい"],["者","もの"],["は"],["彼","かれ"],["に"],["触れる","ふれる"],["こと"],["が"],["できない"],["の"],["です"],["。"]]},{"verse":19,"text":"私たちは神からの者であり、世全体は悪い者の支配下にあることを知っています。","tok":[["私たち","わたしたち"],["は"],["神","かみ"],["から"],["の"],["者","もの"],["で"],["あり"],["、"],["世","よ"],["全体","ぜんたい"],["は"],["悪い","わるい"],["者","もの"],["の"],["支配下","しはいか"],["に"],["ある"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":20,"text":"しかし、神の御子が来て、真実な方を知る理解力を私たちに与えてくださったことを知っています。それで私たちは、真実な方のうちに、すなわち御子イエス・キリストのうちにいるのです。この方こそ、まことの神、永遠のいのちです。","tok":[["しかし"],["、"],["神","かみ"],["の"],["御子","みこ"],["が"],["来て","きて"],["、"],["真実","しんじつ"],["な"],["方","ほう"],["を"],["知る","しる"],["理解力","りかいりょく"],["を"],["私たち","わたしたち"],["に"],["与えて","あたえて"],["くださった"],["こと"],["を"],["知って","しって"],["います"],["。"],["それ"],["で"],["私たち","わたしたち"],["は"],["、"],["真実","しんじつ"],["な"],["方","ほう"],["の"],["うち"],["に"],["、"],["すなわち"],["御子","みこ"],["イエス"],["・"],["キリスト"],["の"],["うち"],["に"],["いる"],["の"],["です"],["。"],["この"],["方","かた"],["こそ"],["、"],["まこと"],["の"],["神","かみ"],["、"],["永遠","えいえん"],["の"],["いのち"],["です"],["。"]]},{"verse":21,"text":"子どもたちよ。偶像を警戒しなさい。","tok":[["子ども","こども"],["たち"],["よ"],["。"],["偶像","ぐうぞう"],["を"],["警戒","けいかい"],["し"],["なさい"],["。"]]}]
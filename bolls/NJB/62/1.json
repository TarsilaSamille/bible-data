[{"verse":1,"text":"初めからあったもの、私たちが聞いたもの、目で見たもの、じっと見、また手でさわったもの、すなわち、いのちのことばについて、","tok":[["初め","はじめ"],["から"],["あった"],["もの"],["、"],["私たち","わたしたち"],["が"],["聞いた","きいた"],["もの"],["、"],["目","め"],["で"],["見た","みた"],["もの"],["、"],["じっと"],["見","み"],["、"],["また"],["手","て"],["で"],["さわった"],["もの"],["、"],["すなわち"],["、"],["いのち"],["の"],["ことば"],["について"],["、"]]},{"verse":2,"text":"――このいのちが現れ、私たちはそれを見たので、そのあかしをし、あなたがたにこの永遠のいのちを伝えます。すなわち、御父とともにあって、私たちに現された永遠のいのちです。――","tok":[["―"],["―"],["この"],["いのち"],["が"],["現れ","あらわれ"],["、"],["私たち","わたしたち"],["は"],["それ"],["を"],["見た","みた"],["ので"],["、"],["その"],["あかし"],["を"],["し"],["、"],["あなた"],["がた"],["に"],["この"],["永遠","えいえん"],["の"],["いのち"],["を"],["伝えます","つたえます"],["。"],["すなわち"],["、"],["御父","おちち"],["と"],["とも"],["に"],["あって"],["、"],["私たち","わたしたち"],["に"],["現された","あらわされた"],["永遠","えいえん"],["の"],["いのち"],["です"],["。"],["―"],["―"]]},{"verse":3,"text":"私たちの見たこと、聞いたことを、あなたがたにも伝えるのは、あなたがたも私たちと交わりを持つようになるためです。私たちの交わりとは、御父および御子イエス・キリストとの交わりです。","tok":[["私たち","わたしたち"],["の"],["見た","みた"],["こと"],["、"],["聞いた","きいた"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["も"],["伝える","つたえる"],["の"],["は"],["、"],["あなた"],["がた"],["も"],["私たち","わたしたち"],["と"],["交わり","まじわり"],["を"],["持つ","もつ"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["私たち","わたしたち"],["の"],["交わり","まじわり"],["と"],["は"],["、"],["御父","おちち"],["および"],["御子","みこ"],["イエス"],["・"],["キリスト"],["と"],["の"],["交わり","まじわり"],["です"],["。"]]},{"verse":4,"text":"私たちがこれらのことを書き送るのは、私たちの喜びが全きものとなるためです。","tok":[["私たち","わたしたち"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["書き送る","かきおくる"],["の"],["は"],["、"],["私たち","わたしたち"],["の"],["喜び","よろこび"],["が"],["全","ぜん"],["きもの"],["と"],["なる"],["ため"],["です"],["。"]]},{"verse":5,"text":"神は光であって、神のうちには暗いところが少しもない。これが、私たちがキリストから聞いて、あなたがたに伝える知らせです。","tok":[["神","かみ"],["は"],["光","ひかり"],["で"],["あって"],["、"],["神","かみ"],["の"],["うち"],["に"],["は"],["暗い","くらい"],["ところ"],["が"],["少し","すこし"],["も"],["ない"],["。"],["これ"],["が"],["、"],["私たち","わたしたち"],["が"],["キリスト"],["から"],["聞いて","きいて"],["、"],["あなた"],["がた"],["に"],["伝える","つたえる"],["知らせ","しらせ"],["です"],["。"]]},{"verse":6,"text":"もし私たちが、神と交わりがあると言っていながら、しかもやみの中を歩んでいるなら、私たちは偽りを言っているのであって、真理を行ってはいません。","tok":[["もし"],["私たち","わたしたち"],["が"],["、"],["神","かみ"],["と"],["交わり","まじわり"],["が"],["ある"],["と"],["言って","いって"],["い"],["ながら"],["、"],["しかも"],["やみ"],["の"],["中","なか"],["を"],["歩んで","あゆんで"],["いるなら"],["、"],["私たち","わたしたち"],["は"],["偽り","いつわり"],["を"],["言って","いって"],["いる"],["ので"],["あって"],["、"],["真理","しんり"],["を"],["行って","おこなって"],["は"],["いません"],["。"]]},{"verse":7,"text":"しかし、もし神が光の中におられるように、私たちも光の中を歩んでいるなら、私たちは互いに交わりを保ち、御子イエスの血はすべての罪から私たちをきよめます。","tok":[["しかし"],["、"],["もし"],["神","かみ"],["が"],["光","ひかり"],["の"],["中","なか"],["に"],["おられる"],["よう"],["に"],["、"],["私たち","わたしたち"],["も"],["光","ひかり"],["の"],["中","なか"],["を"],["歩んで","あゆんで"],["いるなら"],["、"],["私たち","わたしたち"],["は"],["互い","たがい"],["に"],["交わり","まじわり"],["を"],["保ち","たもち"],["、"],["御子","みこ"],["イエス"],["の"],["血","ち"],["は"],["すべて"],["の"],["罪","つみ"],["から"],["私たち","わたしたち"],["を"],["きよめます"],["。"]]},{"verse":8,"text":"もし、罪はないと言うなら、私たちは自分を欺いており、真理は私たちのうちにありません。","tok":[["もし"],["、"],["罪","つみ"],["は"],["ない"],["と"],["言うなら","ゆうなら"],["、"],["私たち","わたしたち"],["は"],["自分","じぶん"],["を"],["欺いて","あざむいて"],["おり"],["、"],["真理","しんり"],["は"],["私たち","わたしたち"],["の"],["うち"],["に"],["ありません"],["。"]]},{"verse":9,"text":"もし、私たちが自分の罪を言い表すなら、神は真実で正しい方ですから、その罪を赦し、すべての悪から私たちをきよめてくださいます。","tok":[["もし"],["、"],["私たち","わたしたち"],["が"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["言い表すなら","いいあらわすなら"],["、"],["神","かみ"],["は"],["真実","しんじつ"],["で"],["正しい","ただしい"],["方","ほう"],["です"],["から"],["、"],["その"],["罪","つみ"],["を"],["赦し","ゆるし"],["、"],["すべて"],["の"],["悪","あく"],["から"],["私たち","わたしたち"],["を"],["きよめて"],["くださいます"],["。"]]},{"verse":10,"text":"もし、罪を犯してはいないと言うなら、私たちは神を偽り者とするのです。神のみことばは私たちのうちにありません。","tok":[["もし"],["、"],["罪","つみ"],["を"],["犯して","おかして"],["は"],["いない"],["と"],["言うなら","ゆうなら"],["、"],["私たち","わたしたち"],["は"],["神","かみ"],["を"],["偽り","いつわり"],["者","もの"],["と"],["する"],["の"],["です"],["。"],["神","かみ"],["のみ"],["ことば"],["は"],["私たち","わたしたち"],["の"],["うち"],["に"],["ありません"],["。"]]}]
[{"verse":1,"text":"私たちが神の子どもと呼ばれるために、――事実、いま私たちは神の子どもです――御父はどんなにすばらしい愛を与えてくださったことでしょう。世が私たちを知らないのは、御父を知らないからです。","tok":[["私たち","わたしたち"],["が"],["神","かみ"],["の"],["子ども","こども"],["と"],["呼ばれる","よばれる"],["ため"],["に"],["、"],["―"],["―"],["事実","じじつ"],["、"],["いま"],["私たち","わたしたち"],["は"],["神","かみ"],["の"],["子ども","こども"],["です"],["―"],["―"],["御父","おちち"],["は"],["どんな"],["に"],["すばらしい"],["愛","あい"],["を"],["与えて","あたえて"],["くださった"],["こと"],["でしょう"],["。"],["世","よ"],["が"],["私たち","わたしたち"],["を"],["知らない","しらない"],["の"],["は"],["、"],["御父","おちち"],["を"],["知らない","しらない"],["から"],["です"],["。"]]},{"verse":2,"text":"愛する者たち。私たちは、今すでに神の子どもです。後の状態はまだ明らかにされていません。しかし、キリストが現れたなら、私たちはキリストに似た者となることがわかっています。なぜならそのとき、私たちはキリストのありのままの姿を見るからです。","tok":[["愛する","あいする"],["者","もの"],["たち"],["。"],["私たち","わたしたち"],["は"],["、"],["今","いま"],["すでに"],["神","かみ"],["の"],["子ども","こども"],["です"],["。"],["後","あと"],["の"],["状態","じょうたい"],["は"],["まだ"],["明らか","あきらか"],["に"],["されて"],["いません"],["。"],["しかし"],["、"],["キリスト"],["が"],["現れたなら","あらわれたなら"],["、"],["私たち","わたしたち"],["は"],["キリスト"],["に"],["似た","にた"],["者","もの"],["と"],["なる"],["こと"],["が"],["わかって"],["います"],["。"],["なぜ"],["なら"],["その"],["とき"],["、"],["私たち","わたしたち"],["は"],["キリスト"],["の"],["ありのまま"],["の"],["姿","すがた"],["を"],["見る","みる"],["から"],["です"],["。"]]},{"verse":3,"text":"キリストに対するこの望みをいだく者はみな、キリストが清くあられるように、自分を清くします。","tok":[["キリスト"],["に"],["対する","たいする"],["この"],["望み","のぞみ"],["を"],["いだく"],["者","もの"],["は"],["みな"],["、"],["キリスト"],["が"],["清く","きよく"],["あられる"],["よう"],["に"],["、"],["自分","じぶん"],["を"],["清く","きよく"],["します"],["。"]]},{"verse":4,"text":"罪を犯している者はみな、不法を行っているのです。罪とは律法に逆らうことなのです。","tok":[["罪","つみ"],["を"],["犯して","おかして"],["いる"],["者","もの"],["は"],["みな"],["、"],["不法","ふほう"],["を"],["行って","おこなって"],["いる"],["の"],["です"],["。"],["罪","つみ"],["と"],["は"],["律法","りっぽう"],["に"],["逆らう","さからう"],["こと"],["な"],["の"],["です"],["。"]]},{"verse":5,"text":"キリストが現れたのは罪を取り除くためであったことを、あなたがたは知っています。キリストには何の罪もありません。","tok":[["キリスト"],["が"],["現れた","あらわれた"],["の"],["は"],["罪","つみ"],["を"],["取り除く","とりのぞく"],["ため"],["で"],["あった"],["こと"],["を"],["、"],["あなた"],["がた"],["は"],["知って","しって"],["います"],["。"],["キリスト"],["に"],["は"],["何","なん"],["の"],["罪","つみ"],["も"],["ありません"],["。"]]},{"verse":6,"text":"だれでもキリストのうちにとどまる者は、罪を犯しません。罪を犯す者はだれも、キリストを見てもいないし、知ってもいないのです。","tok":[["だれ"],["で"],["も"],["キリスト"],["の"],["うち"],["に"],["とどまる"],["者","もの"],["は"],["、"],["罪","つみ"],["を"],["犯しません","おかしません"],["。"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["は"],["だれ"],["も"],["、"],["キリスト"],["を"],["見て","みて"],["も"],["いない"],["し"],["、"],["知って","しって"],["も"],["いない"],["の"],["です"],["。"]]},{"verse":7,"text":"子どもたちよ。だれにも惑わされてはいけません。義を行う者は、キリストが正しくあられるのと同じように正しいのです。","tok":[["子ども","こども"],["たち"],["よ"],["。"],["だれ"],["に"],["も"],["惑わされて","まどわされて"],["は"],["いけません"],["。"],["義","ぎ"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["キリスト"],["が"],["正しく","ただしく"],["あられる"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["正しい","ただしい"],["の"],["です"],["。"]]},{"verse":8,"text":"罪を犯している者は、悪魔から出た者です。悪魔は初めから罪を犯しているからです。神の子が現れたのは、悪魔のしわざを打ちこわすためです。","tok":[["罪","つみ"],["を"],["犯して","おかして"],["いる"],["者","もの"],["は"],["、"],["悪魔","あくま"],["から"],["出た","でた"],["者","もの"],["です"],["。"],["悪魔","あくま"],["は"],["初め","はじめ"],["から"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["から"],["です"],["。"],["神","かみ"],["の"],["子","こ"],["が"],["現れた","あらわれた"],["の"],["は"],["、"],["悪魔","あくま"],["の"],["しわざ"],["を"],["打ちこわす","うちこわす"],["ため"],["です"],["。"]]},{"verse":9,"text":"だれでも神から生まれた者は、罪を犯しません。なぜなら、神の種がその人のうちにとどまっているからです。その人は神から生まれたので、罪を犯すことができないのです。","tok":[["だれ"],["で"],["も"],["神","かみ"],["から"],["生まれた","うまれた"],["者","もの"],["は"],["、"],["罪","つみ"],["を"],["犯しません","おかしません"],["。"],["なぜ"],["なら"],["、"],["神","かみ"],["の"],["種","たね"],["が"],["その"],["人","ひと"],["の"],["うち"],["に"],["とどまって"],["いる"],["から"],["です"],["。"],["その"],["人","ひと"],["は"],["神","かみ"],["から"],["生まれた","うまれた"],["ので"],["、"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["が"],["できない"],["の"],["です"],["。"]]},{"verse":10,"text":"そのことによって、神の子どもと悪魔の子どもとの区別がはっきりします。義を行わない者はだれも、神から出た者ではありません。兄弟を愛さない者もそうです。","tok":[["その"],["こと"],["によって"],["、"],["神","かみ"],["の"],["子ども","こども"],["と"],["悪魔","あくま"],["の"],["子ども","こども"],["と"],["の"],["区別","くべつ"],["が"],["はっきり"],["します"],["。"],["義","ぎ"],["を"],["行わない","おこなわない"],["者","もの"],["は"],["だれ"],["も"],["、"],["神","かみ"],["から"],["出た","でた"],["者","もの"],["で"],["は"],["ありません"],["。"],["兄弟","きょうだい"],["を"],["愛さない","あいさない"],["者","もの"],["も"],["そう"],["です"],["。"]]},{"verse":11,"text":"互いに愛し合うべきであるということは、あなたがたが初めから聞いている教えです。","tok":[["互い","たがい"],["に"],["愛し合うべきで","あいしあうべきで"],["ある"],["と"],["いう"],["こと"],["は"],["、"],["あなた"],["がた"],["が"],["初め","はじめ"],["から"],["聞いて","きいて"],["いる"],["教え","おしえ"],["です"],["。"]]},{"verse":12,"text":"カインのようであってはいけません。彼は悪い者から出た者で、兄弟を殺しました。なぜ兄弟を殺したのでしょう。自分の行いは悪く、兄弟の行いは正しかったからです。","tok":[["カイン"],["の"],["よう"],["で"],["あって"],["は"],["いけません"],["。"],["彼","かれ"],["は"],["悪い","わるい"],["者","もの"],["から"],["出た","でた"],["者","もの"],["で"],["、"],["兄弟","きょうだい"],["を"],["殺しました","ころしました"],["。"],["なぜ"],["兄弟","きょうだい"],["を"],["殺した","ころした"],["の"],["でしょう"],["。"],["自分","じぶん"],["の"],["行い","おこない"],["は"],["悪く","わるく"],["、"],["兄弟","きょうだい"],["の"],["行い","おこない"],["は"],["正しかった","ただしかった"],["から"],["です"],["。"]]},{"verse":13,"text":"兄弟たち。世があなたがたを憎んでも、驚いてはいけません。","tok":[["兄弟","きょうだい"],["たち"],["。"],["世","よ"],["が"],["あなた"],["がた"],["を"],["憎んで","にくんで"],["も"],["、"],["驚いて","おどろいて"],["は"],["いけません"],["。"]]},{"verse":14,"text":"私たちは、自分が死からいのちに移ったことを知っています。それは、兄弟を愛しているからです。愛さない者は、死のうちにとどまっているのです。","tok":[["私たち","わたしたち"],["は"],["、"],["自分","じぶん"],["が"],["死","し"],["から"],["いのち"],["に"],["移った","うつった"],["こと"],["を"],["知って","しって"],["います"],["。"],["それ"],["は"],["、"],["兄弟","きょうだい"],["を"],["愛して","あいして"],["いる"],["から"],["です"],["。"],["愛さない","あいさない"],["者","もの"],["は"],["、"],["死","し"],["の"],["うち"],["に"],["とどまって"],["いる"],["の"],["です"],["。"]]},{"verse":15,"text":"兄弟を憎む者はみな、人殺しです。いうまでもなく、だれでも人を殺す者のうちに、永遠のいのちがとどまっていることはないのです。","tok":[["兄弟","きょうだい"],["を"],["憎む","にくむ"],["者","もの"],["は"],["みな"],["、"],["人殺し","ひとごろし"],["です"],["。"],["いう"],["まで"],["も"],["なく"],["、"],["だれ"],["で"],["も"],["人","ひと"],["を"],["殺す","ころす"],["者","もの"],["の"],["うち"],["に"],["、"],["永遠","えいえん"],["の"],["いのち"],["が"],["とどまって"],["いる"],["こと"],["は"],["ない"],["の"],["です"],["。"]]},{"verse":16,"text":"キリストは、私たちのために、ご自分のいのちをお捨てになりました。それによって私たちに愛がわかったのです。ですから私たちは、兄弟のために、いのちを捨てるべきです。","tok":[["キリスト"],["は"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["、"],["ご自分","ごじぶん"],["の"],["いのち"],["を"],["お捨て","おすて"],["に"],["なりました"],["。"],["それ"],["によって"],["私たち","わたしたち"],["に"],["愛","あい"],["が"],["わかった"],["の"],["です"],["。"],["です"],["から"],["私たち","わたしたち"],["は"],["、"],["兄弟","きょうだい"],["の"],["ため"],["に"],["、"],["いのち"],["を"],["捨てるべきです","すてるべきです"],["。"]]},{"verse":17,"text":"世の富を持ちながら、兄弟が困っているのを見ても、あわれみの心を閉ざすような者に、どうして神の愛がとどまっているでしょう。","tok":[["世","よ"],["の"],["富","とみ"],["を"],["持ち","もち"],["ながら"],["、"],["兄弟","きょうだい"],["が"],["困って","こまって"],["いる"],["の"],["を"],["見て","みて"],["も"],["、"],["あわれみ"],["の"],["心","こころ"],["を"],["閉ざす","とざす"],["よう"],["な"],["者","もの"],["に"],["、"],["どう"],["して"],["神","かみ"],["の"],["愛","あい"],["が"],["とどまって"],["いるでしょう"],["。"]]},{"verse":18,"text":"子どもたちよ。私たちは、ことばや口先だけで愛することをせず、行いと真実をもって愛そうではありませんか。","tok":[["子ども","こども"],["たち"],["よ"],["。"],["私たち","わたしたち"],["は"],["、"],["ことば"],["や"],["口先","くちさき"],["だけ"],["で"],["愛する","あいする"],["こと"],["を"],["せず"],["、"],["行い","おこない"],["と"],["真実","しんじつ"],["を"],["もって"],["愛そうで","あいそうで"],["は"],["ありません"],["か"],["。"]]},{"verse":19,"text":"それによって、私たちは、自分が真理に属するものであることを知り、そして、神の御前に心を安らかにされるのです。","tok":[["それ"],["によって"],["、"],["私たち","わたしたち"],["は"],["、"],["自分","じぶん"],["が"],["真理","しんり"],["に"],["属する","ぞくする"],["もの"],["で"],["ある"],["こと"],["を"],["知り","しり"],["、"],["そして"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["心","こころ"],["を"],["安らか","やすらか"],["に"],["される"],["の"],["です"],["。"]]},{"verse":20,"text":"たとい自分の心が責めてもです。なぜなら、神は私たちの心よりも大きく、そして何もかもご存じだからです。","tok":[["たとい"],["自分","じぶん"],["の"],["心","こころ"],["が"],["責めて","せめて"],["も"],["です"],["。"],["なぜ"],["なら"],["、"],["神","かみ"],["は"],["私たち","わたしたち"],["の"],["心","こころ"],["より"],["も"],["大きく","おおきく"],["、"],["そして"],["何","なん"],["も"],["か"],["も"],["ご存じ","ごぞんじ"],["だ"],["から"],["です"],["。"]]},{"verse":21,"text":"愛する者たち。もし自分の心に責められなければ、大胆に神の御前に出ることができ、","tok":[["愛する","あいする"],["者","もの"],["たち"],["。"],["もし"],["自分","じぶん"],["の"],["心","こころ"],["に"],["責められなければ","せめられなければ"],["、"],["大胆","だいたん"],["に"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["出る","でる"],["こと"],["が"],["でき"],["、"]]},{"verse":22,"text":"また求めるものは何でも神からいただくことができます。なぜなら、私たちが神の命令を守り、神に喜ばれることを行っているからです。","tok":[["また"],["求める","もとめる"],["もの"],["は"],["何","なん"],["で"],["も"],["神","かみ"],["から"],["いただく"],["こと"],["が"],["できます"],["。"],["なぜ"],["なら"],["、"],["私たち","わたしたち"],["が"],["神","かみ"],["の"],["命令","めいれい"],["を"],["守り","まもり"],["、"],["神","かみ"],["に"],["喜ばれる","よろこばれる"],["こと"],["を"],["行って","おこなって"],["いる"],["から"],["です"],["。"]]},{"verse":23,"text":"神の命令とは、私たちが御子イエス・キリストの御名を信じ、キリストが命じられたとおりに、私たちが互いに愛し合うことです。","tok":[["神","かみ"],["の"],["命令","めいれい"],["と"],["は"],["、"],["私たち","わたしたち"],["が"],["御子","みこ"],["イエス"],["・"],["キリスト"],["の"],["御名","ぎょめい"],["を"],["信じ","しんじ"],["、"],["キリスト"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["私たち","わたしたち"],["が"],["互い","たがい"],["に"],["愛し合う","あいしあう"],["こと"],["です"],["。"]]},{"verse":24,"text":"神の命令を守る者は神のうちにおり、神もまたその人のうちにおられます。神が私たちのうちにおられるということは、神が私たちに与えてくださった御霊によって知るのです。","tok":[["神","かみ"],["の"],["命令","めいれい"],["を"],["守る","まもる"],["者","もの"],["は"],["神","かみ"],["の"],["うち"],["に"],["おり"],["、"],["神","かみ"],["も"],["また"],["その"],["人","ひと"],["の"],["うち"],["に"],["おられます"],["。"],["神","かみ"],["が"],["私たち","わたしたち"],["の"],["うち"],["に"],["おられる"],["と"],["いう"],["こと"],["は"],["、"],["神","かみ"],["が"],["私たち","わたしたち"],["に"],["与えて","あたえて"],["くださった"],["御霊","ごれい"],["によって"],["知る","しる"],["の"],["です"],["。"]]}]
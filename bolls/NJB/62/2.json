[{"verse":1,"text":"私の子どもたち。私がこれらのことを書き送るのは、あなたがたが罪を犯さないようになるためです。もしだれかが罪を犯すことがあれば、私たちには、御父の前で弁護する方がいます。義なるイエス・キリストです。","tok":[["私","わたくし"],["の"],["子ども","こども"],["たち"],["。"],["私","わたくし"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["書き送る","かきおくる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["もし"],["だれ"],["か"],["が"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["が"],["あれば"],["、"],["私たち","わたしたち"],["に"],["は"],["、"],["御父","おちち"],["の"],["前","まえ"],["で"],["弁護","べんご"],["する"],["方","ほう"],["が"],["います"],["。"],["義","ぎ"],["なる"],["イエス"],["・"],["キリスト"],["です"],["。"]]},{"verse":2,"text":"この方こそ、私たちの罪のための――私たちの罪だけでなく、世全体のための――なだめの供え物です。","tok":[["この"],["方","かた"],["こそ"],["、"],["私たち","わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["の"],["―"],["―"],["私たち","わたしたち"],["の"],["罪","つみ"],["だけ"],["で"],["なく"],["、"],["世","よ"],["全体","ぜんたい"],["の"],["ため"],["の"],["―"],["―"],["なだめ"],["の"],["供え物","そなえもの"],["です"],["。"]]},{"verse":3,"text":"もし、私たちが神の命令を守るなら、それによって、私たちは神を知っていることがわかります。","tok":[["もし"],["、"],["私たち","わたしたち"],["が"],["神","かみ"],["の"],["命令","めいれい"],["を"],["守るなら","まもるなら"],["、"],["それ"],["によって"],["、"],["私たち","わたしたち"],["は"],["神","かみ"],["を"],["知って","しって"],["いる"],["こと"],["が"],["わかります"],["。"]]},{"verse":4,"text":"神を知っていると言いながら、その命令を守らない者は、偽り者であり、真理はその人のうちにありません。","tok":[["神","かみ"],["を"],["知って","しって"],["いる"],["と"],["言い","いい"],["ながら"],["、"],["その"],["命令","めいれい"],["を"],["守らない","まもらない"],["者","もの"],["は"],["、"],["偽り者","いつわりしゃ"],["で"],["あり"],["、"],["真理","しんり"],["は"],["その"],["人","ひと"],["の"],["うち"],["に"],["ありません"],["。"]]},{"verse":5,"text":"しかし、みことばを守っている者なら、その人のうちには、確かに神の愛が全うされているのです。それによって、私たちが神のうちにいることがわかります。","tok":[["しかし"],["、"],["みことば"],["を"],["守って","まもって"],["いる"],["者","もの"],["なら"],["、"],["その"],["人","ひと"],["の"],["うち"],["に"],["は"],["、"],["確か","たしか"],["に"],["神","かみ"],["の"],["愛","あい"],["が"],["全う","まっとう"],["されて"],["いる"],["の"],["です"],["。"],["それ"],["によって"],["、"],["私たち","わたしたち"],["が"],["神","かみ"],["の"],["うち"],["に"],["いる"],["こと"],["が"],["わかります"],["。"]]},{"verse":6,"text":"神のうちにとどまっていると言う者は、自分でもキリストが歩まれたように歩まなければなりません。","tok":[["神","かみ"],["の"],["うち"],["に"],["とどまって"],["いる"],["と"],["言う","いう"],["者","もの"],["は"],["、"],["自分","じぶん"],["で"],["も"],["キリスト"],["が"],["歩まれた","あゆまれた"],["よう"],["に"],["歩まなければ","あゆまなければ"],["なりません"],["。"]]},{"verse":7,"text":"愛する者たち。私はあなたがたに新しい命令を書いているのではありません。むしろ、これはあなたがたが初めから持っていた古い命令です。その古い命令とは、あなたがたがすでに聞いている、みことばのことです。","tok":[["愛する","あいする"],["者","もの"],["たち"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["新しい","あたらしい"],["命令","めいれい"],["を"],["書いて","かいて"],["いる"],["ので"],["は"],["ありません"],["。"],["むしろ"],["、"],["これ"],["は"],["あなた"],["がた"],["が"],["初め","はじめ"],["から"],["持って","もって"],["いた"],["古い","ふるい"],["命令","めいれい"],["です"],["。"],["その"],["古い","ふるい"],["命令","めいれい"],["と"],["は"],["、"],["あなた"],["がた"],["が"],["すでに"],["聞いて","きいて"],["いる"],["、"],["みことば"],["の"],["こと"],["です"],["。"]]},{"verse":8,"text":"しかし、私は新しい命令としてあなたがたに書き送ります。これはキリストにおいて真理であり、あなたがたにとっても真理です。なぜなら、やみが消え去り、まことの光がすでに輝いているからです。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["新しい","あたらしい"],["命令","めいれい"],["として"],["あなた"],["がた"],["に"],["書き送ります","かきおくります"],["。"],["これ"],["は"],["キリスト"],["に"],["おいて"],["真理","しんり"],["で"],["あり"],["、"],["あなた"],["がた"],["にとって"],["も"],["真理","しんり"],["です"],["。"],["なぜ"],["なら"],["、"],["やみ"],["が"],["消え去り","きえさり"],["、"],["まこと"],["の"],["光","ひかり"],["が"],["すでに"],["輝いて","かがやいて"],["いる"],["から"],["です"],["。"]]},{"verse":9,"text":"光の中にいると言いながら、兄弟を憎んでいる者は、今もなお、やみの中にいるのです。","tok":[["光","ひかり"],["の"],["中","なか"],["に"],["いる"],["と"],["言い","いい"],["ながら"],["、"],["兄弟","きょうだい"],["を"],["憎んで","にくんで"],["いる"],["者","もの"],["は"],["、"],["今","いま"],["も"],["なお"],["、"],["やみ"],["の"],["中","なか"],["に"],["いる"],["の"],["です"],["。"]]},{"verse":10,"text":"兄弟を愛する者は、光の中にとどまり、つまずくことがありません。","tok":[["兄弟","きょうだい"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["光","ひかり"],["の"],["中","なか"],["に"],["とどまり"],["、"],["つまずく"],["こと"],["が"],["ありません"],["。"]]},{"verse":11,"text":"兄弟を憎む者は、やみの中におり、やみの中を歩んでいるのであって、自分がどこへ行くのか知らないのです。やみが彼の目を見えなくしたからです。","tok":[["兄弟","きょうだい"],["を"],["憎む","にくむ"],["者","もの"],["は"],["、"],["やみ"],["の"],["中","なか"],["に"],["おり"],["、"],["やみ"],["の"],["中","なか"],["を"],["歩んで","あゆんで"],["いる"],["ので"],["あって"],["、"],["自分","じぶん"],["が"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["知らない","しらない"],["の"],["です"],["。"],["やみ"],["が"],["彼","かれ"],["の"],["目","め"],["を"],["見えなく","みえなく"],["した"],["から"],["です"],["。"]]},{"verse":12,"text":"子どもたちよ。私があなたがたに書き送るのは、主の御名によって、あなたがたの罪が赦されたからです。","tok":[["子ども","こども"],["たち"],["よ"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["書き送る","かきおくる"],["の"],["は"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["、"],["あなた"],["がた"],["の"],["罪","つみ"],["が"],["赦された","ゆるされた"],["から"],["です"],["。"]]},{"verse":13,"text":"父たちよ。私があなたがたに書き送るのは、あなたがたが、初めからおられる方を、知ったからです。若い者たちよ。私があなたがたに書き送るのは、あなたがたが悪い者に打ち勝ったからです。","tok":[["父","ちち"],["たち"],["よ"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["書き送る","かきおくる"],["の"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["初め","はじめ"],["から"],["おられる"],["方","かた"],["を"],["、"],["知った","しった"],["から"],["です"],["。"],["若い","わかい"],["者","もの"],["たち"],["よ"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["書き送る","かきおくる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["悪い","わるい"],["者","もの"],["に"],["打ち勝った","うちかった"],["から"],["です"],["。"]]},{"verse":14,"text":"小さい者たちよ。私があなたがたに書いて来たのは、あなたがたが御父を知ったからです。父たちよ。私があなたがたに書いて来たのは、あなたがたが、初めからおられる方を、知ったからです。若い者たちよ。私があなたがたに書いて来たのは、あなたがたが強い者であり、神のみことばが、あなたがたのうちにとどまり、そして、あなたがたが悪い者に打ち勝ったからです。","tok":[["小さい","ちいさい"],["者","もの"],["たち"],["よ"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["来た","きた"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["御父","おちち"],["を"],["知った","しった"],["から"],["です"],["。"],["父","ちち"],["たち"],["よ"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["来た","きた"],["の"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["初め","はじめ"],["から"],["おられる"],["方","かた"],["を"],["、"],["知った","しった"],["から"],["です"],["。"],["若い","わかい"],["者","もの"],["たち"],["よ"],["。"],["私","わたくし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["来た","きた"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["強い","つよい"],["者","もの"],["で"],["あり"],["、"],["神","かみ"],["のみ"],["ことば"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["とどまり"],["、"],["そして"],["、"],["あなた"],["がた"],["が"],["悪い","わるい"],["者","もの"],["に"],["打ち勝った","うちかった"],["から"],["です"],["。"]]},{"verse":15,"text":"世をも、世にあるものをも、愛してはなりません。もしだれでも世を愛しているなら、その人のうちに御父を愛する愛はありません。","tok":[["世","よ"],["を"],["も"],["、"],["世","よ"],["に"],["ある"],["もの"],["を"],["も"],["、"],["愛して","あいして"],["は"],["なりません"],["。"],["もし"],["だれ"],["で"],["も"],["世","よ"],["を"],["愛して","あいして"],["いるなら"],["、"],["その"],["人","ひと"],["の"],["うち"],["に"],["御父","おちち"],["を"],["愛する","あいする"],["愛","あい"],["は"],["ありません"],["。"]]},{"verse":16,"text":"すべての世にあるもの、すなわち、肉の欲、目の欲、暮らし向きの自慢などは、御父から出たものではなく、この世から出たものだからです。","tok":[["すべて"],["の"],["世","よ"],["に"],["ある"],["もの"],["、"],["すなわち"],["、"],["肉","にく"],["の"],["欲","よく"],["、"],["目","め"],["の"],["欲","よく"],["、"],["暮らし向き","くらしむき"],["の"],["自慢","じまん"],["など"],["は"],["、"],["御父","おちち"],["から"],["出た","でた"],["もの"],["で"],["は"],["なく"],["、"],["この世","このよ"],["から"],["出た","でた"],["もの"],["だ"],["から"],["です"],["。"]]},{"verse":17,"text":"世と世の欲は滅び去ります。しかし、神のみこころを行う者は、いつまでもながらえます。","tok":[["世","よ"],["と"],["世","よ"],["の"],["欲","よく"],["は"],["滅び去ります","ほろびさります"],["。"],["しかし"],["、"],["神","かみ"],["のみ"],["こころ"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["いつ"],["まで"],["も"],["ながらえます"],["。"]]},{"verse":18,"text":"小さい者たちよ。今は終わりの時です。あなたがたが反キリストの来ることを聞いていたとおり、今や多くの反キリストが現れています。それによって、今が終わりの時であることがわかります。","tok":[["小さい","ちいさい"],["者","もの"],["たち"],["よ"],["。"],["今","いま"],["は"],["終わり","おわり"],["の"],["時","とき"],["です"],["。"],["あなた"],["がた"],["が"],["反","はん"],["キリスト"],["の"],["来る","くる"],["こと"],["を"],["聞いて","きいて"],["いた"],["とおり"],["、"],["今","いま"],["や"],["多く","おおく"],["の"],["反","はん"],["キリスト"],["が"],["現れて","あらわれて"],["います"],["。"],["それ"],["によって"],["、"],["今","いま"],["が"],["終わり","おわり"],["の"],["時","とき"],["で"],["ある"],["こと"],["が"],["わかります"],["。"]]},{"verse":19,"text":"彼らは私たちの中から出て行きましたが、もともと私たちの仲間ではなかったのです。もし私たちの仲間であったのなら、私たちといっしょにとどまっていたことでしょう。しかし、そうなったのは、彼らがみな私たちの仲間でなかったことが明らかにされるためなのです。","tok":[["彼","かれ"],["ら"],["は"],["私たち","わたしたち"],["の"],["中","なか"],["から"],["出て","でて"],["行きました","いきました"],["が"],
,["自分","じぶん"],["たち"],["の"],["うち"],["に"],["とどまらせ"],["なさい"],["。"],["もし"],["初め","はじめ"],["から"],["聞いた","きいた"],["こと"],["が"],["とどまって"],["いるなら"],["、"],["あなた"],["がた"],["も"],["御子","みこ"],["および"],["御父","おちち"],["の"],["うち"],["に"],["とどまる"],["の"],["です"],["。"]]},{"verse":25,"text":"それがキリストご自身の私たちにお与えになった約束であって、永遠のいのちです。","tok":[["それ"],["が"],["キリスト"],["ご自身","ごじしん"],["の"],["私たち","わたしたち"],["に"],["お与え","おあたえ"],["に"],["なった"],["約束","やくそく"],["で"],["あって"],["、"],["永遠","えいえん"],["の"],["いのち"],["です"],["。"]]},{"verse":26,"text":"私は、あなたがたを惑わそうとする人たちについて以上のことを書いて来ました。","tok":[["私","わたくし"],["は"],["、"],["あなた"],["がた"],["を"],["惑わそう","まどわそう"],["と"],["する"],["人","ひと"],["たち"],["について"],["以上","いじょう"],["の"],["こと"],["を"],["書いて","かいて"],["来ました","きました"],["。"]]},{"verse":27,"text":"あなたがたの場合は、キリストから受けたそそぎの油があなたがたのうちにとどまっています。それで、だれからも教えを受ける必要がありません。彼の油がすべてのことについてあなたがたを教えるように、――その教えは真理であって偽りではありません――また、その油があなたがたに教えたとおりに、あなたがたはキリストのうちにとどまるのです。","tok":[["あなた"],["がた"],["の"],["場合","ばあい"],["は"],["、"],["キリスト"],["から"],["受けた","うけた"],["そそぎ"],["の"],["油","あぶら"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["とどまって"],["います"],["。"],["それ"],["で"],["、"],["だれ"],["から"],["も"],["教え","おしえ"],["を"],["受ける","うける"],["必要","ひつよう"],["が"],["ありません"],["。"],["彼","かれ"],["の"],["油","あぶら"],["が"],["すべて"],["の"],["こと"],["について"],["あなた"],["がた"],["を"],["教える","おしえる"],["よう"],["に"],["、"],["―"],["―"],["その"],["教え","おしえ"],["は"],["真理","しんり"],["で"],["あって"],["偽り","いつわり"],["で"],["は"],["ありません"],["―"],["―"],["また"],["、"],["その"],["油","あぶら"],["が"],["あなた"],["がた"],["に"],["教えた","おしえた"],["とおり"],["に"],["、"],["あなた"],["がた"],["は"],["キリスト"],["の"],["うち"],["に"],["とどまる"],["の"],["です"],["。"]]},{"verse":28,"text":"そこで、子どもたちよ。キリストのうちにとどまっていなさい。それは、キリストが現れるとき、私たちが信頼を持ち、その来臨のときに、御前で恥じ入るということのないためです。","tok":[["そこ"],["で"],["、"],["子ども","こども"],["たち"],["よ"],["。"],["キリスト"],["の"],["うち"],["に"],["とどまって"],["い"],["なさい"],["。"],["それ"],["は"],["、"],["キリスト"],["が"],["現れる","あらわれる"],["とき"],["、"],["私たち","わたしたち"],["が"],["信頼","しんらい"],["を"],["持ち","もち"],["、"],["その"],["来臨","らいりん"],["の"],["とき"],["に"],["、"],["御前","ごぜん"],["で"],["恥じ入る","はじいる"],["と"],["いう"],["こと"],["の"],["ない"],["ため"],["です"],["。"]]},{"verse":29,"text":"もしあなたがたが、神は正しい方であると知っているなら、義を行う者がみな神から生まれたこともわかるはずです。","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["神","かみ"],["は"],["正しい","ただしい"],["方","ほう"],["で"],["ある"],["と"],["知って","しって"],["いるなら"],["、"],["義","ぎ"],["を"],["行う","おこなう"],["者","もの"],["が"],["みな"],["神","かみ"],["から"],["生まれた","うまれた"],["こと"],["も"],["わかる"],["はず"],["です"],["。"]]}]
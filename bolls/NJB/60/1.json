[{"verse":1,"text":"イエス・キリストの使徒ペテロから、ポント、ガラテヤ、カパドキヤ、アジヤ、ビテニヤに散って寄留している、選ばれた人々、すなわち、","tok":[["イエス"],["・"],["キリスト"],["の"],["使徒","しと"],["ペテロ"],["から"],["、"],["ポント"],["、"],["ガラテヤ"],["、"],["カパドキヤ"],["、"],["アジヤ"],["、"],["ビテニヤ"],["に"],["散って","ちって"],["寄留","きりゅう"],["して"],["いる"],["、"],["選ばれた","えらばれた"],["人々","ひとびと"],["、"],["すなわち"],["、"]]},{"verse":2,"text":"父なる神の予知に従い、御霊の聖めによって、イエス・キリストに従うように、またその血の注ぎかけを受けるように選ばれた人々へ。どうか、恵みと平安が、あなたがたの上にますます豊かにされますように。","tok":[["父","ちち"],["なる"],["神","かみ"],["の"],["予知","よち"],["に"],["従い","したがい"],["、"],["御霊","ごれい"],["の"],["聖","きよ"],["め"],["によって"],["、"],["イエス"],["・"],["キリスト"],["に"],["従う","したがう"],["よう"],["に"],["、"],["また"],["その"],["血","ち"],["の"],["注ぎ","そそぎ"],["かけ"],["を"],["受ける","うける"],["よう"],["に"],["選ばれた","えらばれた"],["人々","ひとびと"],["へ"],["。"],["どう"],["か"],["、"],["恵み","めぐみ"],["と"],["平安","へいあん"],["が"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["ますます"],["豊か","ゆたか"],["に"],["されます"],["よう"],["に"],["。"]]},{"verse":3,"text":"私たちの主イエス・キリストの父なる神がほめたたえられますように。神は、ご自分の大きなあわれみのゆえに、イエス・キリストが死者の中からよみがえられたことによって、私たちを新しく生まれさせて、生ける望みを持つようにしてくださいました。","tok":[["私たち","わたしたち"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["父","ちち"],["なる"],["神","かみ"],["が"],["ほめたたえられます"],["よう"],["に"],["。"],["神","かみ"],["は"],["、"],["ご自分","ごじぶん"],["の"],["大きな","おおきな"],["あわれみ"],["の"],["ゆえ"],["に"],["、"],["イエス"],["・"],["キリスト"],["が"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえられた"],["こと"],["によって"],["、"],["私たち","わたしたち"],["を"],["新しく","あたらしく"],["生まれさせて","うまれさせて"],["、"],["生ける","いける"],["望み","のぞみ"],["を"],["持つ","もつ"],["よう"],["に"],["して"],["くださいました"],["。"]]},{"verse":4,"text":"また、朽ちることも汚れることも、消えて行くこともない資産を受け継ぐようにしてくださいました。これはあなたがたのために、天にたくわえられているのです。","tok":[["また"],["、"],["朽ちる","くちる"],["こと"],["も"],["汚れる","よごれる"],["こと"],["も"],["、"],["消えて","きえて"],["行く","いく"],["こと"],["も"],["ない"],["資産","しさん"],["を"],["受け継ぐ","うけつぐ"],["よう"],["に"],["して"],["くださいました"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["天","てん"],["に"],["たくわえられて"],["いる"],["の"],["です"],["。"]]},{"verse":5,"text":"あなたがたは、信仰により、神の御力によって守られており、終わりのときに現されるように用意されている救いをいただくのです。","tok":[["あなた"],["がた"],["は"],["、"],["信仰","しんこう"],["に"],["より"],["、"],["神","かみ"],["の"],["御力","おちから"],["によって"],["守られて","まもられて"],["おり"],["、"],["終わり","おわり"],["の"],["とき"],["に"],["現される","あらわされる"],["よう"],["に"],["用意","ようい"],["されて"],["いる"],["救い","すくい"],["を"],["いただく"],["の"],["です"],["。"]]},{"verse":6,"text":"そういうわけで、あなたがたは大いに喜んでいます。いまは、しばらくの間、さまざまの試練の中で、悲しまなければならないのですが、","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["あなた"],["がた"],["は"],["大いに","おおいに"],["喜んで","よろこんで"],["います"],["。"],["いま"],["は"],["、"],["しばらく"],["の"],["間","あいだ"],["、"],["さまざま"],["の"],["試練","しれん"],["の"],["中","なか"],["で"],["、"],["悲しまなければ","かなしまなければ"],["ならない"],["の"],["です"],["が"],["、"]]},{"verse":7,"text":"あなたがたの信仰の試練は、火で精錬されつつなお朽ちて行く金よりも尊く、イエス・キリストの現れのときに称賛と光栄と栄誉になることがわかります。","tok":[["あなた"],["がた"],["の"],["信仰","しんこう"],["の"],["試練","しれん"],["は"],["、"],["火","ひ"],["で"],["精錬","せいれん"],["され"],["つつ"],["なお"],["朽ちて","くちて"],["行く","いく"],["金","かね"],["より"],["も"],["尊く","とうとく"],["、"],["イエス"],["・"],["キリスト"],["の"],["現れ","あらわれ"],["の"],["とき"],["に"],["称賛","しょうさん"],["と"],["光栄","こうえい"],["と"],["栄誉","えいよ"],["に"],["なる"],["こと"],["が"],["わかります"],["。"]]},{"verse":8,"text":"あなたがたはイエス・キリストを見たことはないけれども愛しており、いま見てはいないけれども信じており、ことばに尽くすことのできない、栄えに満ちた喜びにおどっています。","tok":[["あなた"],["がた"],["は"],["イエス"],["・"],["キリスト"],["を"],["見た","みた"],["こと"],["は"],["ない"],["けれど"],["も"],["愛して","あいして"],["おり"],["、"],["いま"],["見て","みて"],["は"],["いない"],["けれど"],["も"],["信じて","しんじて"],["おり"],["、"],["ことば"],["に"],["尽くす","つくす"],["こと"],["の"],["できない"],["、"],["栄え","はえ"],["に"],["満ちた","みちた"],["喜び","よろこび"],["に"],["おどって"],["います"],["。"]]},{"verse":9,"text":"これは、信仰の結果である、たましいの救いを得ているからです。","tok":[["これ"],["は"],["、"],["信仰","しんこう"],["の"],["結果","けっか"],["で"],["ある"],["、"],["たましい"],["の"],["救い","すくい"],["を"],["得て","えて"],["いる"],["から"],["です"],["。"]]},{"verse":10,"text":"この救いについては、あなたがたに対する恵みについて預言した預言者たちも、熱心に尋ね、細かく調べました。","tok":[["この"],["救い","すくい"],["について"],["は"],["、"],["あなた"],["がた"],["に"],["対する","たいする"],["恵み","めぐみ"],["について"],["預言","よげん"],["した"],["預言者","よげんしゃ"],["たち"],["も"],["、"],["熱心","ねっしん"],["に"],["尋ね","たずね"],["、"],["細かく","こまかく"],["調べました","しらべました"],["。"]]},{"verse":11,"text":"彼らは、自分たちのうちにおられるキリストの御霊が、キリストの苦難とそれに続く栄光を前もってあかしされたとき、だれを、また、どのような時をさして言われたのかを調べたのです。","tok":[["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["うち"],["に"],["おられる"],["キリスト"],["の"],["御霊","ごれい"],["が"],["、"],["キリスト"],["の"],["苦難","くなん"],["と"],["それ"],["に"],["続く","つづく"],["栄光","えいこう"],["を"],["前もって","まえもって"],["あかし"],["された"],["とき"],["、"],["だれ"],["を"],["、"],["また"],["、"],["どのような"],["時","とき"],["を"],["さして"],["言われた","いわれた"],["の"],["か"],["を"],["調べた","しらべた"],["の"],["です"],["。"]]},{"verse":12,"text":"彼らは、それらのことが、自分たちのためではなく、あなたがたのための奉仕であるとの啓示を受けました。そして今や、それらのことは、天から送られた聖霊によってあなたがたに福音を語った人々を通して、あなたがたに告げ知らされたのです。それは御使いたちもはっきり見たいと願っていることなのです。","tok":[["彼","かれ"],["ら"],["は"],["、"],["それ"],["ら"],["の"],["こと"],["が"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["の"],["ため"],["の"],["奉仕","ほうし"],["で"],["ある"],["と"],["の"],["啓示","けいじ"],["を"],["受けました","うけました"],["。"],["そして"],["今","いま"],["や"],["、"],["それ"],["ら"],["の"],["こと"],["は"],["、"],["天","てん"],["から"],["送られた","おくられた"],["聖霊","せいれい"],["によって"],["あなた"],["がた"],["に"],["福音","ふくいん"],["を"],["語った","かたった"],["人々","ひとびと"],["を"],["通して","とおして"],["、"],["あなた"],["がた"],["に"],["告げ知らされた","つげしらされた"],["の"],["です"],["。"],["それ"],["は"],["御使い","おつかい"],["たち"],["も"],["はっきり"],["見たい","みたい"],["と"],["願って","ねがって"],["いる"],["こと"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"ですから、あなたがたは、心を引き締め、身を慎み、イエス・キリストの現れのときあなたがたにもたらされる恵みを、ひたすら待ち望みなさい。","tok":[["です"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["心","こころ"],["を"],["引き締め","ひきしめ"],["、"],["身","み"],["を"],["慎み","つつしみ"],["、"],["イエス"],["・"],["キリスト"],["の"],["現れ","あらわれ"],["の"],["とき"],["あなた"],["がた"],["に"],["もたらされる"],["恵み","めぐみ"],["を"],["、"],["ひたすら"],["待ち望み","まちのぞみ"],["なさい"],["。"]]},{"verse":14,"text":"従順な子どもとなり、以前あなたがたが無知であったときのさまざまな欲望に従わず、","tok":[["従順","じゅうじゅん"],["な"],["子ども","こども"],["と"],["なり"],["、"],["以前","いぜん"],["あなた"],["がた"],["が"],["無知","むち"],["で"],["あった"],["とき"],["の"],["さまざま"],["な"],["欲望","よくぼう"],["に"],["従わず","したがわず"],["、"]]},{"verse":15,"text":"あなたがたを召してくださった聖なる方にならって、あなたがた自身も、あらゆる行いにおいて聖なるものとされなさい。","tok":[["あなた"],["がた"],["を"],["召して","めして"],["くださった"],["聖","せい"],["なる"],["方","かた"],["に"],["ならって"],["、"],["あなた"],["がた"],["自身","じしん"],["も"],["、"],["あらゆる"],["行い","おこない"],["に"],["おいて"],["聖","せい"],["なる"],["もの"],["と"],["され"],["なさい"],["。"]]},{"verse":16,"text":"それは、「わたしが聖であるから、あなたがたも、聖でなければならない」と書いてあるからです。","tok":[["それ"],["は"],["、"],["「"],["わたし"],["が"],["聖","せい"],["で"],["ある"],["から"],["、"],["あなた"],["がた"],["も"],["、"],["聖","せい"],["で"],["なければ"],["ならない"],["」"],["と"],["書いて","かいて"],["ある"],["から"],["です"],["。"]]},{"verse":17,"text":"また、人をそれぞれのわざに従って公平にさばかれる方を父と呼んでいるのなら、あなたがたが地上にしばらくとどまっている間の時を、恐れかしこんで過ごしなさい。","tok":[["また"],["、"],["人","ひと"],["を"],["それぞれ"],["の"],["わざ"],["に"],["従って","したがって"],["公平","こうへい"],["に"],["さばかれる"],["方","かた"],["を"],["父","ちち"],["と"],["呼んで","よんで"],["いる"],["の"],["なら"],["、"],["あなた"],["がた"],["が"],["地上","ちじょう"],["に"],["しばらく"],["とどまって"],["いる"],["間","あいだ"],["の"],["時","とき"],["を"],["、"],["恐れ","おそれ"],["か"],["しこんで"],["過ごし","すごし"],["なさい"],["。"]]},{"verse":18,"text":"ご承知のように、あなたがたが父祖伝来のむなしい生き方から贖い出されたのは、銀や金のような朽ちる物にはよらず、","tok":[["ご承知","ごしょうち"],["の"],["よう"],["に"],["、"],["あなた"],["がた"],["が"],["父祖","ふそ"],["伝来","でんらい"],["の"],["むなしい"],["生き方","いきかた"],["から"],["贖い","あがない"],["出された","だされた"],["の"],["は"],["、"],["銀","ぎん"],["や"],["金","きん"],["の"],["よう"],["な"],["朽ちる","くちる"],["物","もの"],["に"],["は"],["よらず"],["、"]]},{"verse":19,"text":"傷もなく汚れもない小羊のようなキリストの、尊い血によったのです。","tok":[["傷","きず"],["も"],["なく"],["汚れ","よごれ"],["も"],["ない"],["小羊","こひつじ"],["の"],["よう"],["な"],["キリスト"],["の"],["、"],["尊い","とうとい"],["血","ち"],["に"],["よった"],["の"],["です"],["。"]]},{"verse":20,"text":"キリストは、世の始まる前から知られていましたが、この終わりの時に、あなたがたのために、現れてくださいました。","tok":[["キリスト"],["は"],["、"],["世","よ"],["の"],["始まる","はじまる"],["前","まえ"],["から"],["知られて","しられて"],["いました"],["が"],["、"],["この"],["終わり","おわり"],["の"],["時","とき"],["に"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["現れて","あらわれて"],["くださいました"],["。"]]},{"verse":21,"text":"あなたがたは、死者の中からこのキリストをよみがえらせて彼に栄光を与えられた神を、キリストによって信じる人々です。このようにして、あなたがたの信仰と希望は神にかかっているのです。","tok":[["あなた"],["がた"],["は"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["この"],["キリスト"],["を"],["よみがえらせて"],["彼","かれ"],["に"],["栄光","えいこう"],["を"],["与えられた","あたえられた"],["神","かみ"],["を"],["、"],["キリスト"],["によって"],["信じる","しんじる"],["人々","ひとびと"],["です"],["。"],["この"],["よう"],["に"],["して"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["と"],["希望","きぼう"],["は"],["神","かみ"],["に"],["かかって"],["いる"],["の"],["です"],["。"]]},{"verse":22,"text":"あなたがたは、真理に従うことによって、たましいを清め、偽りのない兄弟愛を抱くようになったのですから、互いに心から熱く愛し合いなさい。","tok":[["あなた"],["がた"],["は"],["、"],["真理","しんり"],["に"],["従う","したがう"],["こと"],["によって"],["、"],["たましい"],["を"],["清め","きよめ"],["、"],["偽り","いつわり"],["の"],["ない"],["兄弟","きょうだい"],["愛","あい"],["を"],["抱く","いだく"],["よう"],["に"],["なった"],["の"],["です"],["から"],["、"],["互い","たがい"],["に"],["心","こころ"],["から"],["熱く","あつく"],["愛し合い","あいしあい"],["なさい"],["。"]]},{"verse":23,"text":"あなたがたが新しく生まれたのは、朽ちる種からではなく、朽ちない種からであり、生ける、いつまでも変わることのない、神のことばによるのです。","tok":[["あなた"],["がた"],["が"],["新しく","あたらしく"],["生まれた","うまれた"],["の"],["は"],["、"],["朽ちる","くちる"],["種","しゅ"],["から"],["で"],["は"],["なく"],["、"],["朽ちない","くちない"],["種","しゅ"],["から"],["で"],["あり"],["、"],["生ける","いける"],["、"],["いつ"],["まで"],["も"],["変わる","かわる"],["こと"],["の"],["ない"],["、"],["神","かみ"],["の"],["ことば"],["に"],["よる"],["の"],["です"],["。"]]},{"verse":24,"text":"「人はみな草のようで、その栄えは、みな草の花のようだ。／草はしおれ、花は散る。","tok":[["「"],["人","ひと"],["は"],["みな"],["草","くさ"],["の"],["よう"],["で"],["、"],["その"],["栄え","はえ"],["は"],["、"],["みな"],["草","くさ"],["の"],["花","はな"],["の"],["よう"],["だ"],["。"],["／"],["草","くさ"],["は"],["しおれ"],["、"],["花","はな"],["は"],["散る","ちる"],["。"]]},{"verse":25,"text":"しかし、主のことばは、とこしえに変わることがない。」／とあるからです。あなたがたに宣べ伝えられた福音のことばがこれです。","tok":[["しかし"],["、"],["主","ぬし"],["の"],["ことば"],["は"],["、"],["とこしえ"],["に"],["変わる","かわる"],["こと"],["が"],["ない"],["。"],["」"],["／"],["と"],["ある"],["から"],["です"],["。"],["あなた"],["がた"],["に"],["宣べ伝えられた","のべつたえられた"],["福音","ふくいん"],["の"],["ことば"],["が"],["これ"],["です"],["。"]]}]
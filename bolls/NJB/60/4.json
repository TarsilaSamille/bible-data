[{"verse":1,"text":"このように、キリストは肉体において苦しみを受けられたのですから、あなたがたも同じ心構えで自分自身を武装しなさい。肉体において苦しみを受けた人は、罪とのかかわりを断ちました。","tok":[["この"],["よう"],["に"],["、"],["キリスト"],["は"],["肉体","にくたい"],["に"],["おいて"],["苦しみ","くるしみ"],["を"],["受けられた","うけられた"],["の"],["です"],["から"],["、"],["あなた"],["がた"],["も"],["同じ","おなじ"],["心構え","こころがまえ"],["で"],["自分","じぶん"],["自身","じしん"],["を"],["武装","ぶそう"],["し"],["なさい"],["。"],["肉体","にくたい"],["に"],["おいて"],["苦しみ","くるしみ"],["を"],["受けた","うけた"],["人","ひと"],["は"],["、"],["罪","つみ"],["と"],["の"],["かかわり"],["を"],["断ちました","たちました"],["。"]]},{"verse":2,"text":"こうしてあなたがたは、地上の残された時を、もはや人間の欲望のためではなく、神のみこころのために過ごすようになるのです。","tok":[["こう"],["して"],["あなた"],["がた"],["は"],["、"],["地上","ちじょう"],["の"],["残された","のこされた"],["時","とき"],["を"],["、"],["もはや"],["人間","にんげん"],["の"],["欲望","よくぼう"],["の"],["ため"],["で"],["は"],["なく"],["、"],["神","かみ"],["のみ"],["こころ"],["の"],["ため"],["に"],["過ごす","すごす"],["よう"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":3,"text":"あなたがたは、異邦人たちがしたいと思っていることを行い、好色、情欲、酔酒、遊興、宴会騒ぎ、忌むべき偶像礼拝などにふけったものですが、それは過ぎ去った時で、もう十分です。","tok":[["あなた"],["がた"],["は"],["、"],["異邦人","いほうじん"],["たち"],["が"],["したい"],["と"],["思って","おもって"],["いる"],["こと"],["を"],["行い","おこない"],["、"],["好色","こうしょく"],["、"],["情欲","じょうよく"],["、"],["酔酒","すいしゅ"],["、"],["遊興","ゆうきょう"],["、"],["宴会","えんかい"],["騒ぎ","さわぎ"],["、"],["忌むべき","いむべき"],["偶像","ぐうぞう"],["礼拝","れいはい"],["など"],["に"],["ふけった"],["もの"],["です"],["が"],["、"],["それ"],["は"],["過ぎ去った","すぎさった"],["時","とき"],["で"],["、"],["もう"],["十分","じゅうぶん"],["です"],["。"]]},{"verse":4,"text":"彼らは、あなたがたが自分たちといっしょに度を過ごした放蕩に走らないので不思議に思い、また悪口を言います。","tok":[["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["が"],["自分","じぶん"],["たち"],["と"],["いっしょ"],["に"],["度","ど"],["を"],["過ごした","すごした"],["放蕩","ほうとう"],["に"],["走らない","はしらない"],["ので"],["不思議","ふしぎ"],["に"],["思い","おもい"],["、"],["また"],["悪口","わるぐち"],["を"],["言います","いいます"],["。"]]},{"verse":5,"text":"彼らは、生きている人々をも死んだ人々をも、すぐにもさばこうとしている方に対し、申し開きをしなければなりません。","tok":[["彼","かれ"],["ら"],["は"],["、"],["生きて","いきて"],["いる"],["人々","ひとびと"],["を"],["も"],["死んだ","しんだ"],["人々","ひとびと"],["を"],["も"],["、"],["すぐ"],["に"],["も"],["さばこう"],["として"],["いる"],["方","かた"],["に"],["対し","たいし"],["、"],["申し開き","もうしひらき"],["を"],["しなければ"],["なりません"],["。"]]},{"verse":6,"text":"というのは、死んだ人々にも福音が宣べ伝えられていたのですが、それはその人々が肉体においては人間としてさばきを受けるが、霊においては神によって生きるためでした。","tok":[["と"],["いう"],["の"],["は"],["、"],["死んだ","しんだ"],["人々","ひとびと"],["に"],["も"],["福音","ふくいん"],["が"],["宣べ伝えられて","のべつたえられて"],["いた"],["の"],["です"],["が"],["、"],["それ"],["は"],["その"],["人々","ひとびと"],["が"],["肉体","にくたい"],["に"],["おいて"],["は"],["人間","にんげん"],["として"],["さばき"],["を"],["受ける","うける"],["が"],["、"],["霊","れい"],["に"],["おいて"],["は"],["神","かみ"],["によって"],["生きる","いきる"],["ため"],["でした"],["。"]]},{"verse":7,"text":"万物の終わりが近づきました。ですから、祈りのために、心を整え身を慎みなさい。","tok":[["万物","ばんぶつ"],["の"],["終わり","おわり"],["が"],["近づきました","ちかづきました"],["。"],["です"],["から"],["、"],["祈り","いのり"],["の"],["ため"],["に"],["、"],["心","こころ"],["を"],["整え","ととのえ"],["身","み"],["を"],["慎み","つつしみ"],["なさい"],["。"]]},{"verse":8,"text":"何よりもまず、互いに熱心に愛し合いなさい。愛は多くの罪をおおうからです。","tok":[["何","なん"],["より"],["も"],["まず"],["、"],["互い","たがい"],["に"],["熱心","ねっしん"],["に"],["愛し合い","あいしあい"],["なさい"],["。"],["愛","あい"],["は"],["多く","おおく"],["の"],["罪","つみ"],["を"],["おおう"],["から"],["です"],["。"]]},{"verse":9,"text":"つぶやかないで、互いに親切にもてなし合いなさい。","tok":[["つぶやかないで"],["、"],["互い","たがい"],["に"],["親切","しんせつ"],["に"],["もてなし"],["合い","あい"],["なさい"],["。"]]},{"verse":10,"text":"それぞれが賜物を受けているのですから、神のさまざまな恵みの良い管理者として、その賜物を用いて、互いに仕え合いなさい。","tok":[["それぞれ"],["が"],["賜物","たまもの"],["を"],["受けて","うけて"],["いる"],["の"],["です"],["から"],["、"],["神","かみ"],["の"],["さまざま"],["な"],["恵み","めぐみ"],["の"],["良い","よい"],["管理者","かんりしゃ"],["として"],["、"],["その"],["賜物","たまもの"],["を"],["用いて","もちいて"],["、"],["互い","たがい"],["に"],["仕え","つかえ"],["合い","あい"],["なさい"],["。"]]},{"verse":11,"text":"語る人があれば、神のことばにふさわしく語り、奉仕する人があれば、神が豊かに備えてくださる力によって、それにふさわしく奉仕しなさい。それは、すべてのことにおいて、イエス・キリストを通して神があがめられるためです。栄光と支配が世々限りなくキリストにありますように。アーメン。","tok":[["語る","かたる"],["人","ひと"],["が"],["あれば"],["、"],["神","かみ"],["の"],["ことば"],["に"],["ふさわしく"],["語り","かたり"],["、"],["奉仕","ほうし"],["する"],["人","ひと"],["が"],["あれば"],["、"],["神","かみ"],["が"],["豊か","ゆたか"],["に"],["備えて","そなえて"],["くださる"],["力","ちから"],["によって"],["、"],["それ"],["に"],["ふさわしく"],["奉仕","ほうし"],["し"],["なさい"],["。"],["それ"],["は"],["、"],["すべて"],["の"],["こと"],["に"],["おいて"],["、"],["イエス"],["・"],["キリスト"],["を"],["通して","とおして"],["神","かみ"],["が"],["あがめられる"],["ため"],["です"],["。"],["栄光","えいこう"],["と"],["支配","しはい"],["が"],["世々","せいせい"],["限りなく","かぎりなく"],["キリスト"],["に"],["あります"],["よう"],["に"],["。"],["アーメン"],["。"]]},{"verse":12,"text":"愛する者たち。あなたがたを試みるためにあなたがたの間に燃えさかる火の試練を、何か思いがけないことが起こったかのように驚き怪しむことなく、","tok":[["愛する","あいする"],["者","もの"],["たち"],["。"],["あなた"],["がた"],["を"],["試みる","こころみる"],["ため"],["に"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["燃えさかる","もえさかる"],["火","ひ"],["の"],["試練","しれん"],["を"],["、"],["何","なん"],["か"],["思いがけない","おもいがけない"],["こと"],["が"],["起こった","おこった"],["か"],["の"],["よう"],["に"],["驚き怪しむ","おどろきあやしむ"],["こと"],["なく"],["、"]]},{"verse":13,"text":"むしろ、キリストの苦しみにあずかれるのですから、喜んでいなさい。それは、キリストの栄光が現れるときにも、喜びおどる者となるためです。","tok":[["むしろ"],["、"],["キリスト"],["の"],["苦しみ","くるしみ"],["に"],["あずかれる"],["の"],["です"],["から"],["、"],["喜んで","よろこんで"],["い"],["なさい"],["。"],["それ"],["は"],["、"],["キリスト"],["の"],["栄光","えいこう"],["が"],["現れる","あらわれる"],["とき"],["に"],["も"],["、"],["喜び","よろこび"],["おどる"],["者","もの"],["と"],["なる"],["ため"],["です"],["。"]]},{"verse":14,"text":"もしキリストの名のために非難を受けるなら、あなたがたは幸いです。なぜなら、栄光の御霊、すなわち神の御霊が、あなたがたの上にとどまってくださるからです。","tok":[["もし"],["キリスト"],["の"],["名","な"],["の"],["ため"],["に"],["非難","ひなん"],["を"],["受けるなら","うけるなら"],["、"],["あなた"],["がた"],["は"],["幸い","さいわい"],["です"],["。"],["なぜ"],["なら"],["、"],["栄光","えいこう"],["の"],["御霊","ごれい"],["、"],["すなわち"],["神","かみ"],["の"],["御霊","ごれい"],["が"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["とどまって"],["くださる"],["から"],["です"],["。"]]},{"verse":15,"text":"あなたがたのうちのだれも、人殺し、盗人、悪を行う者、みだりに他人に干渉する者として苦しみを受けるようなことがあってはなりません。","tok":[["あなた"],["がた"],["の"],["うち"],["の"],["だれ"],["も"],["、"],["人殺し","ひとごろし"],["、"],["盗人","ぬすびと"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["、"],["みだり"],["に"],["他人","たにん"],["に"],["干渉","かんしょう"],["する"],["者","もの"],["として"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["よう"],["な"],["こと"],["が"],["あって"],["は"],["なりません"],["。"]]},{"verse":16,"text":"しかし、キリスト者として苦しみを受けるのなら、恥じることはありません。かえって、この名のゆえに神をあがめなさい。","tok":[["しかし"],["、"],["キリスト"],["者","しゃ"],["として"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["の"],["なら"],["、"],["恥じる","はじる"],["こと"],["は"],["ありません"],["。"],["かえって"],["、"],["この"],["名","な"],["の"],["ゆえ"],["に"],["神","かみ"],["を"],["あがめ"],["なさい"],["。"]]},{"verse":17,"text":"なぜなら、さばきが神の家から始まる時が来ているからです。さばきが、まず私たちから始まるのだとしたら、神の福音に従わない人たちの終わりは、どうなることでしょう。","tok":[["なぜ"],["なら"],["、"],["さばき"],["が"],["神","かみ"],["の"],["家","いえ"],["から"],["始まる","はじまる"],["時","とき"],["が"],["来て","きて"],["いる"],["から"],["です"],["。"],["さばき"],["が"],["、"],["まず"],["私たち","わたしたち"],["から"],["始まる","はじまる"],["の"],["だ"],["と"],["したら"],["、"],["神","かみ"],["の"],["福音","ふくいん"],["に"],["従わない","したがわない"],["人","ひと"],["たち"],["の"],["終わり","おわり"],["は"],["、"],["どう"],["なる"],["こと"],["でしょう"],["。"]]},{"verse":18,"text":"義人がかろうじて救われるのだとしたら、神を敬わない者や罪人たちは、いったいどうなるのでしょう。","tok":[["義人","ぎじん"],["が"],["かろうじて"],["救われる","すくわれる"],["の"],["だ"],["と"],["したら"],["、"],["神","かみ"],["を"],["敬わない","うやまわない"],["者","もの"],["や"],["罪人","ざいにん"],["たち"],["は"],["、"],["いったい"],["どう"],["なる"],["の"],["でしょう"],["。"]]},{"verse":19,"text":"ですから、神のみこころに従ってなお苦しみに会っている人々は、善を行うにあたって、真実であられる創造者に自分のたましいをお任せしなさい。","tok":[["です"],["から"],["、"],["神","かみ"],["のみ"],["こころ"],["に"],["従って","したがって"],["なお"],["苦しみ","くるしみ"],["に"],["会って","あって"],["いる"],["人々","ひとびと"],["は"],["、"],["善","ぜん"],["を"],["行う","おこなう"],["に"],["あたって"],["、"],["真実","しんじつ"],["で"],["あられる"],["創造者","そうぞうしゃ"],["に"],["自分","じぶん"],["の"],["たましい"],["を"],["お任せ","おまかせ"],["し"],["なさい"],["。"]]}]
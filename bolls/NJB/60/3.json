[{"verse":1,"text":"同じように、妻たちよ。自分の夫に服従しなさい。たとい、みことばに従わない夫であっても、妻の無言のふるまいによって、神のものとされるようになるためです。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["妻たち","つまたち"],["よ"],["。"],["自分","じぶん"],["の"],["夫","おっと"],["に"],["服従","ふくじゅう"],["し"],["なさい"],["。"],["たとい"],["、"],["みことば"],["に"],["従わない","したがわない"],["夫","おっと"],["で"],["あって"],["も"],["、"],["妻","つま"],["の"],["無言","むごん"],["の"],["ふるまい"],["によって"],["、"],["神","かみ"],["の"],["もの"],["と"],["される"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":2,"text":"それは、あなたがたの、神を恐れかしこむ清い生き方を彼らが見るからです。","tok":[["それ"],["は"],["、"],["あなた"],["がた"],["の"],["、"],["神","かみ"],["を"],["恐れ","おそれ"],["かしこむ"],["清い","きよい"],["生き方","いきかた"],["を"],["彼","かれ"],["ら"],["が"],["見る","みる"],["から"],["です"],["。"]]},{"verse":3,"text":"あなたがたは、髪を編んだり、金の飾りをつけたり、着物を着飾るような外面的なものでなく、","tok":[["あなた"],["がた"],["は"],["、"],["髪","かみ"],["を"],["編ん","あん"],["だり"],["、"],["金","きん"],["の"],["飾り","かざり"],["を"],["つけ"],["たり"],["、"],["着物","きもの"],["を"],["着飾る","きかざる"],["よう"],["な"],["外面的","がいめんてき"],["な"],["もの"],["で"],["なく"],["、"]]},{"verse":4,"text":"むしろ、柔和で穏やかな霊という朽ちることのないものを持つ、心の中の隠れた人がらを飾りにしなさい。これこそ、神の御前に価値あるものです。","tok":[["むしろ"],["、"],["柔和","にゅうわ"],["で"],["穏やか","おだやか"],["な"],["霊","れい"],["と"],["いう"],["朽ちる","くちる"],["こと"],["の"],["ない"],["もの"],["を"],["持つ","もつ"],["、"],["心","こころ"],["の"],["中","なか"],["の"],["隠れた","かくれた"],["人がら","ひとがら"],["を"],["飾り","かざり"],["に"],["し"],["なさい"],["。"],["これ"],["こそ"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["価値","かち"],["ある"],["もの"],["です"],["。"]]},{"verse":5,"text":"むかし神に望みを置いた敬虔な婦人たちも、このように自分を飾って、夫に従ったのです。","tok":[["むかし"],["神","かみ"],["に"],["望み","のぞみ"],["を"],["置いた","おいた"],["敬虔","けいけん"],["な"],["婦人","ふじん"],["たち"],["も"],["、"],["この"],["よう"],["に"],["自分","じぶん"],["を"],["飾って","かざって"],["、"],["夫","おっと"],["に"],["従った","したがった"],["の"],["です"],["。"]]},{"verse":6,"text":"たとえばサラも、アブラハムを主と呼んで彼に従いました。あなたがたも、どんなことをも恐れないで善を行えば、サラの子となるのです。","tok":[["たとえば"],["サラ"],["も"],["、"],["アブラハム"],["を"],["主","ぬし"],["と"],["呼んで","よんで"],["彼","かれ"],["に"],["従いました","したがいました"],["。"],["あなた"],["がた"],["も"],["、"],["どんな"],["こと"],["を"],["も"],["恐れ
[{"verse":1,"text":"そこで、私は、あなたがたのうちの長老たちに、同じく長老のひとり、キリストの苦難の証人、また、やがて現れる栄光にあずかる者として、お勧めします。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["長老","ちょうろう"],["たち"],["に"],["、"],["同じく","おなじく"],["長老","ちょうろう"],["の"],["ひとり"],["、"],["キリスト"],["の"],["苦難","くなん"],["の"],["証人","しょうにん"],["、"],["また"],["、"],["やがて"],["現れる","あらわれる"],["栄光","えいこう"],["に"],["あずかる"],["者","もの"],["として"],["、"],["お勧め","おすすめ"],["します"],["。"]]},{"verse":2,"text":"あなたがたのうちにいる、神の羊の群れを、牧しなさい。強制されてするのではなく、神に従って、自分から進んでそれをなし、卑しい利得を求める心からではなく、心を込めてそれをしなさい。","tok":[["あなた"],["がた"],["の"],["うち"],["に"],["いる"],["、"],["神","かみ"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["、"],["牧","まき"],["し"],["なさい"],["。"],["強制","きょうせい"],["されて"],["する"],["ので"],["は"],["なく"],["、"],["神","かみ"],["に"],["従って","したがって"],["、"],["自分","じぶん"],["から"],["進んで","すすんで"],["それ"],["を"],["なし"],["、"],["卑しい","いやしい"],["利得","りとく"],["を"],["求める","もとめる"],["心","こころ"],["から"],["で"],["は"],["なく"],["、"],["心","こころ"],["を"],["込めて","こめて"],["それ"],["を"],["し"],["なさい"],["。"]]},{"verse":3,"text":"あなたがたは、その割り当てられている人たちを支配するのではなく、むしろ群れの模範となりなさい。","tok":[["あなた"],["がた"],["は"],["、"],["その"],["割り当てられて","わりあてられて"],["いる"],["人","ひと"],["たち"],["を"],["支配","しはい"],["する"],["ので"],["は"],["なく"],["、"],["むしろ"],["群れ","むれ"],["の"],["模範","もはん"],["と"],["なり"],["なさい"],["。"]]},{"verse":4,"text":"そうすれば、大牧者が現れるときに、あなたがたは、しぼむことのない栄光の冠を受けるのです。","tok":[["そう"],["すれば"],["、"],["大","だい"],["牧者","ぼくしゃ"],["が"],["現れる","あらわれる"],["とき"],["に"],["、"],["あなた"],["がた"],["は"],["、"],["しぼむ"],["こと"],["の"],["ない"],["栄光","えいこう"],["の"],["冠","かんむり"],["を"],["受ける","うける"],["の"],["です"],["。"]]},{"verse":5,"text":"同じように、若い人たちよ。長老たちに従いなさい。みな互いに謙遜を身に着けなさい。神は高ぶる者に敵対し、へりくだる者に恵みを与えられるからです。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["若い","わかい"],["人","ひと"],["たち"],["よ"],["。"],["長老","ちょうろう"],["たち"],["に"],["従い","したがい"],["なさい"],["。"],["みな"],["互い","たがい"],["に"],["謙遜","けんそん"],["を"],["身","み"],["に"],["着け","つけ"],["なさい"],["。"],["神","かみ"],["は"],["高ぶる","たかぶる"],["者","もの"],["に"],["敵対","てきたい"],["し"],["、"],["へりくだる"],["者","もの"],["に"],["恵み","めぐみ"],["を"],["与えられる","あたえられる"],["から"],["です"],["。"]]},{"verse":6,"text":"ですから、あなたがたは、神の力強い御手の下にへりくだりなさい。神が、ちょうど良い時に、あなたがたを高くしてくださるためです。","tok":[["です"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["神","かみ"],["の"],["力強い","ちからづよい"],["御手","おて"],["の"],["下","した"],["に"],["へりくだり"],["なさい"],["。"],["神","かみ"],["が"],["、"],["ちょうど"],["良い","よい"],["時","とき"],["に"],["、"],["あなた"],["がた"],["を"],["高く","たかく"],["して"],["くださる"],["ため"],["です"],["。"]]},{"verse":7,"text":"あなたがたの思い煩いを、いっさい神にゆだねなさい。神があなたがたのことを心配してくださるからです。","tok":[["あなた"],["がた"],["の"],["思い煩い","おもいわずらい"],["を"],["、"],["いっさい"],["神","かみ"],["に"],["ゆだね"],["なさい"],["。"],["神","かみ"],["が"],["あなた"],["がた"],["の"],["こと"],["を"],["心配","しんぱい"],["して"],["くださる"],["から"],["です"],["。"]]},{"verse":8,"text":"身を慎み、目をさましていなさい。あなたがたの敵である悪魔が、ほえたける獅子のように、食い尽くすべきものを捜し求めながら、歩き回っています。","tok":[["身","み"],["を"],["慎み","つつしみ"],["、"],["目","め"],["を"],["さまして"],["い"],["なさい"],["。"],["あなた"],["がた"],["の"],["敵","てき"],["で"],["ある"],["悪魔","あくま"],["が"],["、"],["ほえ"],["たける"],["獅子","しし"],["の"],["よう"],["に"],["、"],["食い","くい"],["尽くすべき","つくすべき"],["もの"],["を"],["捜し求め","さがしもとめ"],["ながら"],["、"],["歩き回って","あるきまわって"],["います"],["。"]]},{"verse":9,"text":"堅く信仰に立って、この悪魔に立ち向かいなさい。ご承知のように、世にあるあなたがたの兄弟である人々は同じ苦しみを通って来たのです。","tok":[["堅く","かたく"],["信仰","しんこう"],["に"],["立って","たって"],["、"],["この"],["悪魔","あくま"],["に"],["立ち向かい","たちむかい"],["なさい"],["。"],["ご承知","ごしょうち"],["の"],["よう"],["に"],["、"],["世","よ"],["に"],["ある"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["人々","ひとびと"],["は"],["同じ","おなじ"],["苦しみ","くるしみ"],["を"],["通って","とおって"],["来た","きた"],["の"],["です"],["。"]]},{"verse":10,"text":"あらゆる恵みに満ちた神、すなわち、あなたがたをキリストにあってその永遠の栄光の中に招き入れてくださった神ご自身が、あなたがたをしばらくの苦しみのあとで完全にし、堅く立たせ、強くし、不動の者としてくださいます。","tok":[["あらゆる"],["恵み","めぐみ"],["に"],["満ちた","みちた"],["神","かみ"],["、"],["すなわち"],["、"],["あなた"],["がた"],["を"],["キリスト"],["に"],["あって"],["その"],["永遠","えいえん"],["の"],["栄光","えいこう"],["の"],["中","なか"],["に"],["招き入れて","まねきいれて"],["くださった"],["神","かみ"],["ご自身","ごじしん"],["が"],["、"],["あなた"],["がた"],["を"],["しばらく"],["の"],["苦しみ","くるしみ"],["の"],["あと"],["で"],["完全","かんぜん"],["に"],["し"],["、"],["堅く","かたく"],["立たせ","たたせ"],["、"],["強く","つよく"],["し"],["、"],["不動","ふどう"],["の"],["者","もの"],["として"],["くださいます"],["。"]]},{"verse":11,"text":"どうか、神のご支配が世々限りなくありますように。アーメン。","tok":[["どう"],["か"],["、"],["神","かみ"],["の"],["ご支配","ごしはい"],["が"],["世々","せいせい"],["限りなく","かぎりなく"],["あります"],["よう"],["に"],["。"],["アーメン"],["。"]]},{"verse":12,"text":"私の認めている忠実な兄弟シルワノによって、私はここに簡潔に書き送り、勧めをし、これが神の真の恵みであることをあかししました。この恵みの中に、しっかりと立っていなさい。","tok":[["私","わたくし"],["の"],["認めて","みとめて"],["いる"],["忠実","ちゅうじつ"],["な"],["兄弟","きょうだい"],["シルワノ"],["によって"],["、"],["私","わたくし"],["は"],["ここ"],["に"],["簡潔","かんけつ"],["に"],["書き送り","かきおくり"],["、"],["勧め","すすめ"],["を"],["し"],["、"],["これ"],["が"],["神","かみ"],["の"],["真","しん"],["の"],["恵み","めぐみ"],["で"],["ある"],["こと"],["を"],["あかし"],["しました"],["。"],["この"],["恵み","めぐみ"],["の"],["中","なか"],["に"],["、"],["しっかり"],["と"],["立って","たって"],["い"],["なさい"],["。"]]},{"verse":13,"text":"バビロンにいる、あなたがたとともに選ばれた婦人がよろしくと言っています。また私の子マルコもよろしくと言っています。","tok":[["バビロン"],["に"],["いる"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["選ばれた","えらばれた"],["婦人","ふじん"],["が"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["また"],["私","わたくし"],["の"],["子","こ"],["マルコ"],["も"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":14,"text":"愛の口づけをもって互いにあいさつをかわしなさい。／キリストにあるあなたがたすべての者に、平安がありますように。","tok":[["愛","あい"],["の"],["口づけ","くちづけ"],["を"],["もって"],["互い","たがい"],["に"],["あいさつ"],["を"],["かわし"],["なさい"],["。"],["／"],["キリスト"],["に"],["ある"],["あなた"],["がた"],["すべて"],["の"],["者","もの"],["に"],["、"],["平安","へいあん"],["が"],["あります"],["よう"],["に"],["。"]]}]
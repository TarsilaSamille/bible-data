[{"verse":1,"text":"これらの出来事の後、ペルシヤの王アルタシャスタの治世に、エズラという人がいた。このエズラはセラヤの子、順次さかのぼって、アザルヤの子、ヒルキヤの子、","tok":[["これ"],["ら"],["の"],["出来事","できごと"],["の"],["後","あと"],["、"],["ペルシヤ"],["の"],["王","おう"],["アルタシャスタ"],["の"],["治世","ちせい"],["に"],["、"],["エズラ"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["この"],["エズラ"],["は"],["セラヤ"],["の"],["子","こ"],["、"],["順次","じゅんじ"],["さかのぼって"],["、"],["アザルヤ"],["の"],["子","こ"],["、"],["ヒルキヤ"],["の"],["子","こ"],["、"]]},{"verse":2,"text":"シャルムの子、ツァドクの子、アヒトブの子、","tok":[["シャルム"],["の"],["子","こ"],["、"],["ツァドク"],["の"],["子","こ"],["、"],["アヒトブ"],["の"],["子","こ"],["、"]]},{"verse":3,"text":"アマルヤの子、アザルヤの子、メラヨテの子、","tok":[["アマルヤ"],["の"],["子","こ"],["、"],["アザルヤ"],["の"],["子","こ"],["、"],["メラヨテ"],["の"],["子","こ"],["、"]]},{"verse":4,"text":"ゼラヘヤの子、ウジの子、ブキの子、","tok":[["ゼラヘヤ"],["の"],["子","こ"],["、"],["ウジ"],["の"],["子","こ"],["、"],["ブキ"],["の"],["子","こ"],["、"]]},{"verse":5,"text":"アビシュアの子、ピネハスの子、エルアザルの子、このエルアザルは祭司のかしらアロンの子である。","tok":[["アビシュア"],["の"],["子","こ"],["、"],["ピネハス"],["の"],["子","こ"],["、"],["エルアザル"],["の"],["子","こ"],["、"],["この"],["エルアザル"],["は"],["祭司","さいし"],["の"],["かしら"],["アロン"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":6,"text":"エズラはバビロンから上って来た者であるが、イスラエルの神、主が賜ったモーセの律法に通じている学者であった。彼の神、主の御手が彼の上にあったので、王は彼の願いをみなかなえた。","tok":[["エズラ"],["は"],["バビロン"],["から"],["上って","のぼって"],["来た","きた"],["者","もの"],["で"],["ある"],["が"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["賜った","たまわった"],["モーセ"],["の"],["律法","りっぽう"],["に"],["通じて","つうじて"],["いる"],["学者","がくしゃ"],["で"],["あった"],["。"],["彼","かれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御手","おて"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["あった"],["ので"],["、"],["王","おう"],["は"],["彼","かれ"],["の"],["願い","ねがい"],["を"],["みな"],["かなえた"],["。"]]},{"verse":7,"text":"アルタシャスタ王の第七年にも、イスラエル人のある者たち、および、祭司、レビ人、歌うたい、門衛、宮に仕えるしもべたちのある者たちが、エルサレムに上って来た。","tok":[["アルタシャスタ"],["王","おう"],["の"],["第","だい"],["七","なな"],["年","ねん"],["に"],["も"],["、"],["イスラエル"],["人","にん"],["の"],["ある"],["者","もの"],["たち"],["、"],["および"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["、"],["歌うたい","うたうたい"],["、"],["
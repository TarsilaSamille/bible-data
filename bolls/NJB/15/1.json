[{"verse":1,"text":"ペルシヤの王クロスの第一年に、エレミヤにより告げられた主のことばを実現するために、主はペルシヤの王クロスの霊を奮い立たせたので、王は王国中におふれを出し、文書にして言った。","tok":[["ペルシヤ"],["の"],["王","おう"],["クロス"],["の"],["第","だい"],["一","いち"],["年","ねん"],["に"],["、"],["エレミヤ"],["に"],["より"],["告げられた","つげられた"],["主","ぬし"],["の"],["ことば"],["を"],["実現","じつげん"],["する"],["ため"],["に"],["、"],["主","ぬし"],["は"],["ペルシヤ"],["の"],["王","おう"],["クロス"],["の"],["霊","れい"],["を"],["奮い立たせた","ふるいたたせた"],["ので"],["、"],["王","おう"],["は"],["王国中","おうこくちゅう"],["に"],["おふれ"],["を"],["出し","だし"],["、"],["文書","ぶんしょ"],["に"],["して"],["言った","いった"],["。"]]},{"verse":2,"text":"「ペルシヤの王クロスは言う。『天の神、主は、地のすべての王国を私に賜った。この方はユダにあるエルサレムに、ご自分のために宮を建てることを私にゆだねられた。","tok":[["「"],["ペルシヤ"],["の"],["王","おう"],["クロス"],["は"],["言う","ゆう"],["。"],["『"],["天","てん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["地","ち"],["の"],["すべて"],["の"],["王国","おうこく"],["を"],["私","わたくし"],["に"],["賜った","たまわった"],["。"],["この"],["方","かた"],["は"],["ユダ"],["に"],["ある"],["エルサレム"],["に"],["、"],["ご自分","ごじぶん"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てる","たてる"],["こと"],["を"],["私","わたくし"],["に"],["ゆだねられた"],["。"]]},{"verse":3,"text":"あなたがた、すべて主の民に属する者はだれでも、その神がその者とともにおられるように。その者はユダにあるエルサレムに上り、イスラエルの神、主の宮を建てるようにせよ。この方はエルサレムにおられる神である。","tok":[["あなた"],["がた"],["、"],["すべて"],["主","ぬし"],["の"],["民","たみ"],["に"],["属する","ぞくする"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["その"],["神","かみ"],["が"],["その"],["者","もの"],["と"],["とも"],["に"],["おられる"],["よう"],["に"],["。"],["その"],["者","もの"],["は"],["ユダ"],["に"],["ある"],["エルサレム"],["に"],["上り","のぼり"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["宮","みや"],["を"],["建てる","たてる"],["よう"],["に"],["せよ"],["。"],["この"],["方","かた"],["は"],["エルサレム"],["に"],["おられる"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":4,"text":"残る者はみな、その者を援助するようにせよ。どこに寄留しているにしても、その所から、その土地の人々が、エルサレムにある神の宮のために進んでささげるささげ物のほか、銀、金、財貨、家畜をもって援助せよ。』」","tok":[["残る","のこる"],["者","もの"],["は"],["みな"],["、"],["その"],["者","もの"],["を"],["援助","えんじょ"],["する"],["よう"],["に"],["せよ"],["。"],["どこ"],["に"],["寄留","きりゅう"],["して"],["いる"],["に"],["して"],["も"],["、"],["その"],["所","ところ"],["から"],["、"],["その"],["土地","とち"],["の"],["人々","ひとびと"],["が"],["、"],["エルサレム"],["に"],["ある"],["神","かみ"],["の"],["宮","みや"],["の"],["ため"],["に"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["の"],["ほか"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["財貨","ざいか"],["、"],["家畜","かちく"],["を"],["もって"],["援助","えんじょ"],["せよ"],["。"],["』"],["」"]]},{"verse":5,"text":"そこで、ユダとベニヤミンの一族のかしらたち、祭司たち、レビ人たち、すなわち、神にその霊を奮い立たされた者はみな、エルサレムにある主の宮を建てるために上って行こうと立ち上がった。","tok":[["そこ"],["で"],["、"],["ユダ"],["と"],["ベニヤミン"],["の"],["一族","いちぞく"],["の"],["かしら"],["たち"],["、"],["祭司","さいし"],["たち"],["、"],["レビ人","れびにん"],["たち"],["、"],["すなわち"],["、"],["神","かみ"],["に"],["その"],["霊","れい"],["を"],["奮い立たされた","ふるいたたされた"],["者","もの"],["は"],["みな"],["、"],["エルサレム"],["に"],["ある"],["主","ぬし"],["の"],["宮","みや"],["を"],["建てる","たてる"],["ため"],["に"],["上って","のぼって"],["行こう","いこう"],["と"],["立ち上がった","たちあがった"],["。"]]},{"verse":6,"text":"彼らの回りの人々はみな、銀の器具、金、財貨、家畜、えりすぐりの品々、そのほか進んでささげるあらゆるささげ物をもって彼らを力づけた。","tok":[["彼","かれ"],["ら"],["の"],["回り","まわり"],["の"],["人々","ひとびと"],["は"],["みな"],["、"],["銀","ぎん"],["の"],["器具","きぐ"],["、"],["金","きん"],["、"],["財貨","ざいか"],["、"],["家畜","かちく"],["、"],["えりすぐり"],["の"],["品々","しなじな"],["、"],["その"],["ほか"],["進んで","すすんで"],["ささげる"],["あらゆる"],["ささげ物","ささげもの"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["力づけた","ちからづけた"],["。"]]},{"verse":7,"text":"クロス王は、ネブカデネザルがエルサレムから持って来て、自分の神々の宮に置いていた主の宮の用具を運び出した。","tok":[["クロス"],["王","おう"],["は"],["、"],["ネブカデネザル"],["が"],["エルサレム"],["から"],["持って","もって"],["来て","きて"],["、"],["自分","じぶん"],["の"],["神々","かみがみ"],["の"],["宮","みや"],["に"],["置いて","おいて"],["いた"],["主","ぬし"],["の"],["宮","みや"],["の"],["用具","ようぐ"],["を"],["運び出した","はこびだした"],["。"]]},{"verse":8,"text":"すなわち、ペルシヤの王クロスは宝庫係ミテレダテに命じてこれを取り出し、その数を調べさせ、それをユダの君主シェシュバツァルに渡した。","tok":[["すなわち"],["、"],["ペルシヤ"],["の"],["王","おう"],["クロス"],["は"],["宝庫","ほうこ"],["係","かかり"],["ミテレダテ"],["に"],["命じて","めいじて"],["これ"],["を"],["取り出し","とりだし"],["、"],["その"],["数","かず"],["を"],["調べさせ","しらべさせ"],["、"],["それ"],["を"],["ユダ"],["の"],["君主","くんしゅ"],["シェシュバツァル"],["に"],["渡した","わたした"],["。"]]},{"verse":9,"text":"その数は次のとおりであった。金の皿三十、銀の皿一千、香炉二十九、","tok":[["その"],["数","すう"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["あった"],["。"],["金","きん"],["の"],["皿","さら"],["三十","さんじゅう"],["、"],["銀","ぎん"],["の"],["皿","さら"],["一千","いちせん"],["、"],["香炉","こうろ"],["二十九","にじゅうきゅう"],["、"]]},{"verse":10,"text":"金の鉢三十、二級品の銀の鉢四百十、その他の用具一千。","tok":[["金","きん"],["の"],["鉢","ばち"],["三十","さんじゅう"],["、"],["二級品","にきゅうひん"],["の"],["銀","ぎん"],["の"],["鉢","ばち"],["四百十","よんひゃくとう"],["、"],["その"],["他","た"],["の"],["用具","ようぐ"],["一千","いちせん"],["。"]]},{"verse":11,"text":"金、銀の用具は全部で五千四百あった。捕囚の民がバビロンからエルサレムに連れて来られたとき、シェシュバツァルはこれらの物をみないっしょに携えて上った。","tok":[["金","きん"],["、"],["銀","ぎん"],["の"],["用具","ようぐ"],["は"],["全部","ぜんぶ"],["で"],["五千四百","ごせんよんひゃく"],["あった"],["。"],["捕囚","ほしゅう"],["の"],["民","たみ"],["が"],["バビロン"],["から"],["エルサレム"],["に"],["連れて","つれて"],["来られた","こられた"],["とき"],["、"],["シェシュバツァル"],["は"],["これ"],["ら"],["の"],["物","もの"],["を"],["みないっしょ"],["に"],["携えて","たずさえて"],["上った","のぼった"],["。"]]}]
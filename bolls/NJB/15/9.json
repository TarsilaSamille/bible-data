[{"verse":1,"text":"これらのことが終わって後、つかさたちが私のところに近づいて来て次のように言った。「イスラエルの民や、祭司や、レビ人は、カナン人、ヘテ人、ペリジ人、エブス人、アモン人、モアブ人、エジプト人、エモリ人などの、忌みきらうべき国々の民と縁を絶つことなく、","tok":[["これ"],["ら"],["の"],["こと"],["が"],["終わって","おわって"],["後","あと"],["、"],["つかさ"],["たち"],["が"],["私","わたくし"],["の"],["ところ"],["に"],["近づいて","ちかづいて"],["来て","きて"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["民","たみ"],["や"],["、"],["祭司","さいし"],["や"],["、"],["レビ人","れびにん"],["は"],["、"],["カナン人","かなんにん"],["、"],["ヘテ人","へてにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["エブス人","えぶすにん"],["、"],["アモン人","あもんにん"],["、"],["モアブ人","もあぶにん"],["、"],["エジプト"],["人","にん"],["、"],["エモリ人","えもりにん"],["など"],["の"],["、"],["忌みきらうべき","いみきらうべき"],["国々","くにぐに"],["の"],["民","たみ"],["と"],["縁","えん"],["を"],["絶つ","たつ"],["こと"],["なく"],["、"]]},{"verse":2,"text":"かえって、彼らも、その息子たちも、これらの国々の娘をめとり、聖なる種族がこれらの国々の民と混じり合ってしまいました。しかも、つかさたち、代表者たちがこの不信の罪の張本人なのです。」","tok":[["かえって"],["、"],["彼","かれ"],["ら"],["も"],["、"],["その"],["息子","むすこ"],["たち"],["も"],["、"],["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["娘","むすめ"],["を"],["めとり"],["、"],["聖","せい"],["なる"],["種族","しゅぞく"],["が"],["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["と"],["混じり合って","まじりあって"],["しまいました"],["。"],["しかも"],["、"],["つかさ"],["たち"],["、"],["代表者","だいひょうしゃ"],["たち"],["が"],["この"],["不信","ふしん"],["の"],["罪","つみ"],["の"],["張本人","ちょうほんにん"],["な"],["の"],["です"],["。"],["」"]]},{"verse":3,"text":"私はこのことを聞いて、着物と上着を裂き、髪の毛とひげを引き抜き、色を失ってすわってしまった。","tok":[["私","わたくし"],["は"],["この"],["こと"],["を"],["聞いて","きいて"],["、"],["着物","きもの"],["と"],["上着","うわぎ"],["を"],["裂き","さき"],["、"],["髪の毛","かみのけ"],["と"],["ひげ"],["を"],["引き抜き","ひきぬき"],["、"],["色","いろ"],["を"],["失って","うしなって"],["すわって"],["しまった"],["。"]]},{"verse":4,"text":"捕囚から帰って来た人々の不信の罪のことで、イスラエルの神のことばを恐れている者はみな、私のところに集まって来た。私は夕方のささげ物の時刻まで、色を失ってじっとすわっていた。","tok":[["捕囚","ほしゅう"],["から"],["帰って","かえって"],["来た","きた"],["人々","ひとびと"],["の"],["不信","ふしん"],["の"],["罪","つみ"],["の"],["こと"],["で"],["、"],["イスラエル"],["の"],["神","かみ"],["の"],["ことば"],["を"],["恐れて","おそれて"],["いる"],["者","もの"],["は"],["みな"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["集まって","あつまって"],["来た","きた"],["。"],["私","わたくし"],["は"],["夕方","ゆうがた"],["の"],["ささげ物","ささげもの"],["の"],["時刻","じこく"],["まで"],["、"],["色","いろ"],["を"],["失って","うしなって"],["じっと"],["すわって"],["いた"],["。"]]},{"verse":5,"text":"夕方のささげ物の時刻になって、私は気を取り戻し、着物と上着を裂いたまま、ひざまずき、私の神、主に向かって手を差し伸ばし、祈って、","tok":[["夕方","ゆうがた"],["の"],["ささげ物","ささげもの"],["の"],["時刻","じこく"],["に"],["なって"],["、"],["私","わたくし"],["は"],["気","き"],["を"],["取り戻し","とりもどし"],["、"],["着物","きもの"],["と"],["上着","うわぎ"],["を"],["裂いた","さいた"],["まま"],["、"],["ひざまずき"],["、"],["私","わたくし"],["の"],["神","かみ"],["、"],["主に","おもに"],["向かって","むかって"],["手","て"],["を"],["差し伸ばし","さしのばし"],["、"],["祈って","いのって"],["、"]]},{"verse":6,"text":"言った。「私の神よ。私は恥を受け、私の神であるあなたに向かって顔を上げるのも恥ずかしく思います。私たちの咎は私たちの頭より高く増し加わり、私たちの罪過は大きく天にまで達したからです。","tok":[["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["神","かみ"],["よ"],["。"],["私","わたくし"],["は"],["恥","はじ"],["を"],["受け","うけ"],["、"],["私","わたくし"],["の"],["神","かみ"],["で"],["ある"],["あなた"],["に"],["向かって","むかって"],["顔","かお"],["を"],["上げる","あげる"],["の"],["も"],["恥ずかしく","はずかしく"],["思います","おもいます"],["。"],["私たち","わたしたち"],["の"],["咎","とが"],["は"],["私たち","わたしたち"],["の"],["頭","あたま"],["より"],["高く","たかく"],["増し","まし"],["加わり","くわわり"],["、"],["私たち","わたしたち"],["の"],["罪過","ざいか"],["は"],["大きく","おおきく"],["天","てん"],["に"],["まで"],["達した","たっした"],["から"],["です"],["。"]]},{"verse":7,"text":"私たちの先祖の時代から今日まで、私たちは大きな罪過の中にありました。私たちのその咎のため、私たちや、私たちの王、祭司たちは、よその国々の王たちの手に渡され、剣にかけられ、とりこにされ、かすめ奪われ、恥を見せられて、今日あるとおりです。","tok":[["私たち","わたしたち"],["の"],["先祖","せんぞ"],["の"],["時代","じだい"],["から"],["今日","きょう"],["まで"],["、"],["私たち","わたしたち"],["は"],["大きな","おおきな"],["罪過","ざいか"],["の"],["中","なか"],["に"],["ありました"],["。"],["私たち","わたしたち"],["の"],["その"],["咎","とが"],["の"],["ため"],["、"],["私たち","わたしたち"],["や"],["、"],["私たち","わたしたち"],["の"],["王","おう"],["、"],["祭司","さいし"],["たち"],["は"],["、"],["よそ"],["の"],["国々","くにぐに"],["の"],["王","おう"],["たち"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["剣","けん"],["に"],["かけられ"],["、"],["とりこ"],["に"],["され"],["、"],["かすめ"],["奪われ","うばわれ"],["、"],["恥","はじ"],["を"],["見せられて","みせられて"],["、"],["今日","きょう"],["ある"],["とおり"],["です"],["。"]]},{"verse":8,"text":"しかし、今、しばらくの間、私たちの神、主のあわれみによって、私たちに、のがれた者を残しておき、私たちのためにご自分の聖なる所の中に一つの釘を与えてくださいました。これは、私たちの神が私たちの目を明るくし、奴隷の身の私たちをしばらく生き返らせてくださるためでした。","tok":[["しかし"],["、"],["今","いま"],["、"],["しばらく"],["の"],["間","あいだ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["あわれみ"],["によって"],["、"],["私たち","わたしたち"],["に"],["、"],["のがれた"],["者","もの"],["を"],["残して","のこして"],["おき"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["ご自分","ごじぶん"],["の"],["聖","せい"],["なる"],["所","ところ"],["の"],["中","なか"],["に"],["一","ひと"],["つ"],["の"],["釘","くぎ"],["を"],["与えて","あたえて"],["くださいました"],["。"],["これ"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["が"],["私たち","わたしたち"],["の"],["目","め"],["を"],["明るく","あかるく"],["し"],["、"],["奴隷","どれい"],["の"],["身","み"],["の"],["私たち","わたしたち"],["を"],["しばらく"],["生き返らせて","いきかえらせて"],["くださる"],["ため"],["でした"],["。"]]},{"verse":9,"text":"事実、私たちは奴隷です。しかし、私たちの神は、この奴隷の身の私たちを見捨てることなく、かえって、ペルシヤの王たちによって、私たちに恵みを施し、私たちを生かして、私たちの神の宮を再建させ、その廃墟を建て直させ、ユダとエルサレムに石垣を下さいました。","tok":[["事実","じじつ"],["、"],["私たち","わたしたち"],["は"],["奴隷","どれい"],["です"],["。"],["しかし"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["は"],["、"],["この"],["奴隷","どれい"],["の"],["身","み"],["の"],["私たち","わたしたち"],["を"],["見捨てる","みすてる"],["こと"],["なく"],["、"],["かえって"],["、"],["ペルシヤ"],["の"],["王","おう"],["たち"],["によって"],["、"],["私たち","わたしたち"],["に"],["恵み","めぐみ"],["を"],["施し","ほどこし"],["、"],["私たち","わたしたち"],["を"],["生かして","いかして"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["宮","みや"],["を"],["再建","さいけん"],["させ"],["、"],["その"],["廃墟","はいきょ"],["を"],["建て直させ","たてなおさせ"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["石垣","いしがき"],["を"],["下さいました","くださいました"],["。"]]},{"verse":10,"text":"今、こうなってからは、何と申し上げたらよいのでしょう。私たちの神よ。私たちはあなたの命令を捨てたからです。","tok":[["今","いま"],["、"],["こう"],["なって"],["から"],["は"],["、"],["何","なん"],["と"],["申し上げたら","もうしあげたら"],["よい"],["の"],["でしょう"],["。"],["私たち","わたしたち"],["の"],["神","かみ"],["よ"],["。"],["私たち","わたしたち"],["は"],["あなた"],["の"],["命令","めいれい"],["を"],["捨てた","すてた"],["から"],["です"],["。"]]},{"verse":11,"text":"あなたは、あなたのしもべ、預言者たちによって、こう命じておられました。『あなたがたが、入って行って所有しようとしている地は、そこの国々の民の、忌みきらうべき行いによって汚された汚らわしい地であり、その隅々まで、彼らの汚れで満たされている。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["しもべ"],["、"],["預言者","よげんしゃ"],["たち"],["によって"],["、"],["こう"],["命じて","めいじて"],["おられました"],["。"],["『"],["あなた"],["が"],["た"],["が"],["、"],["入って","はいって"],["行って","いって"],["所有","しょゆう"],["しよう"],["として"],["いる"],["地","ち"],["は"],["、"],["そこ"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["、"],["忌みきらうべき","いみきらうべき"],["行い","おこない"],["によって"],["汚された","よごされた"],["汚らわしい","けがらわしい"],["地","ち"],["で"],["あり"],["、"],["その"],["隅々","すみずみ"],["まで"],["、"],["彼","かれ"],["ら"],["の"],["汚れ","よごれ"],["で"],["満たされて","みたされて"],["いる"],["。"]]},{"verse":12,"text":"だから、今、あなたがたの娘を彼らの息子にとつがせてはならない。また、彼らの娘をあなたがたの息子にめとってはならない。永久に彼らの平安も、しあわせも求めてはならない。そうすれば、あなたがたは強くなり、その地の良い物を食べ、これを永久にあなたがたの子孫のために所有することができる』と。","tok":[["だ"],["から"],["、"],["今","いま"],["、"],["あなた"],["がた"],["の"],["娘","むすめ"],["を"],["彼","かれ"],["ら"],["の"],["息子","むすこ"],["に"],["とつがせて"],["は"],["ならない"],["。"],["また"],["、"],["彼","かれ"],["ら"],["の"],["娘","むすめ"],["を"],["あなた"],["がた"],["の"],["息子","むすこ"],["に"],["めとって"],["は"],["ならない"],["。"],["永久","えいきゅう"],["に"],["彼","かれ"],["ら"],["の"],["平安","へいあん"],["も"],["、"],["しあわせ"],["も"],["求めて","もとめて"],["は"],["ならない"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["強く","つよく"],["なり"],["、"],["その"],["地","ち"],["の"],["良い","よい"],["物","もの"],["を"],["食べ","たべ"],["、"],["これ"],["を"],["永久","えいきゅう"],["に"],["あなた"],["がた"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["所有","しょゆう"],["する"],["こと"],["が"],["できる"],["』"],["と"],["。"]]},{"verse":13,"text":"私たちの悪い行いと、大きな罪過のために、これらすべてのことが私たちの上に起こって後、――事実、私たちの神、あなたは、私たちの咎の受けるべき刑罰よりも軽く罰し、このようにのがれた者を私たちに残してくださいました――","tok":[["私たち","わたしたち"],["の"],["悪い","わるい"],["行い","おこない"],["と"],["、"],["大きな","おおきな"],["罪過","ざいか"],["の"],["ため"],["に"],["、"],["これ"],["ら"],["すべて"],["の"],["こと"],["が"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["起こって","おこって"],["後","あと"],["、"],["―"],["―"],["事実","じじつ"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["あなた"],["は"],["、"],["私たち","わたしたち"],["の"],["咎","とが"],["の"],["受けるべき","うけるべき"],["刑罰","けいばつ"],["より"],["も"],["軽く","かるく"],["罰し","ばっし"],["、"],["この"],["よう"],["に"],["のがれた"],["者","もの"],["を"],["私たち","わたしたち"],["に"],["残して","のこして"],["くださいました"],["―"],["―"]]},{"verse":14,"text":"私たちは再び、あなたの命令を破って、忌みきらうべき行いをするこれらの民と互いに縁を結んでよいのでしょうか。あなたは私たちを怒り、ついには私たちを絶ち滅ぼし、生き残った者も、のがれた者もいないようにされるのではないでしょうか。","tok":[["私たち","わたしたち"],["は"],["再び","ふたたび"],["、"],["あなた"],["の"],["命令","めいれい"],["を"],["破って","やぶって"],["、"],["忌みきらうべき","いみきらうべき"],["行い","おこない"],["を"],["する"],["これ"],["ら"],["の"],["民","たみ"],["と"],["互い","たがい"],["に"],["縁","えん"],["を"],["結んで","むすんで"],["よい"],["の"],["でしょう"],["か"],["。"],["あなた"],["は"],["私たち","わたしたち"],["を"],["怒り","おこり"],["、"],["ついに"],["は"],["私たち","わたしたち"],["を"],["絶ち","たち"],["滅ぼし","ほろぼし"],["、"],["生き残った","いきのこった"],["者","もの"],["も"],["、"],["のがれた"],["者","もの"],["も"],["いない"],["よう"],["に"],["される"],["ので"],["は"],["ないでしょう"],["か"],["。"]]},{"verse":15,"text":"イスラエルの神、主。あなたは正しい方です。まことに、今日あるように、私たちは、のがれた者として残されています。ご覧ください。私たちは罪過の中であなたの御前におります。このような状態で、だれもあなたの御前に立つことはできないのに。」","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["。"],["あなた"],["は"],["正しい","ただしい"],["方","ほう"],["です"],["。"],["まこと"],["に"],["、"],["今日","きょう"],["ある"],["よう"],["に"],["、"],["私たち","わたしたち"],["は"],["、"],["のがれた"],["者","もの"],["として"],["残されて","のこされて"],["います"],["。"],["ご覧","ごらん"],["ください"],["。"],["私たち","わたしたち"],["は"],["罪過","ざいか"],["の"],["中","なか"],["で"],["あなた"],["の"],["御前","ごぜん"],["に"],["おります"],["。"],["この"],["よう"],["な"],["状態","じょうたい"],["で"],["、"],["だれ"],["も"],["あなた"],["の"],["御前","ごぜん"],["に"],["立つ","たつ"],["こと"],["は"],["できない"],["のに"],["。"],["」"]]}]
[{"verse":1,"text":"さて、預言者ハガイとイドの子ゼカリヤの、ふたりの預言者は、ユダとエルサレムにいるユダヤ人に、彼らとともにおられるイスラエルの神の名によって預言した。","tok":[["さて"],["、"],["預言者","よげんしゃ"],["ハガイ"],["と"],["イド"],["の"],["子","こ"],["ゼカリヤ"],["の"],["、"],["ふたり"],["の"],["預言者","よげんしゃ"],["は"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["いる"],["ユダヤ人","ゆだやじん"],["に"],["、"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["おられる"],["イスラエル"],["の"],["神","かみ"],["の"],["名","な"],["によって"],["預言","よげん"],["した"],["。"]]},{"verse":2,"text":"そこで、シェアルティエルの子ゼルバベルと、エホツァダクの子ヨシュアは立ち上がり、エルサレムにある神の宮を建て始めた。神の預言者たちも彼らといっしょにいて、彼らを助けた。","tok":[["そこ"],["で"],["、"],["シェアルティエル"],["の"],["子","こ"],["ゼルバベル"],["と"],["、"],["エホツァダク"],["の"],["子","こ"],["ヨシュア"],["は"],["立ち上がり","たちあがり"],["、"],["エルサレム"],["に"],["ある"],["神","かみ"],["の"],["宮","みや"],["を"],["建て","たて"],["始めた","はじめた"],["。"],["神","かみ"],["の"],["預言者","よげんしゃ"],["たち"],["も"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["いて"],["、"],["彼","かれ"],["ら"],["を"],["助けた","たすけた"],["。"]]},{"verse":3,"text":"そのとき、川向こうの総督タテナイと、シェタル・ボズナイと、その同僚とがやって来て、こう言った。「だれがあなたがたに命令を下して、この宮を建て、この城壁を修復させようとしたのか。」","tok":[["その"],["とき"],["、"],["川向こう","かわむこう"],["の"],["総督","そうとく"],["タテナイ"],["と"],["、"],["シェタル"],["・"],["ボズナイ"],["と"],["、"],["その"],["同僚","どうりょう"],["と"],["が"],["やって"],["来て","きて"],["、"],["こう"],["言った","いった"],["。"],["「"],["だれ"],["が"],["あなた"],["がた"],["に"],["命令","めいれい"],["を"],["下して","くだして"],["、"],["この"],["宮","みや"],["を"],["建て","たて"],["、"],["この"],["城壁","じょうへき"],["を"],["修復","しゅうふく"],["させよう"],["と"],["した"],["の"],["か"],["。"],["」"]]},{"verse":4,"text":"そしてまた、「この建物を建てている者たちの名は何というのか」と尋ねた。","tok":[["そして"],["また"],["、"],["「"],["この"],["建物","たてもの"],["を"],["建てて","たてて"],["いる"],["者","もの"],["たち"],["の"],["名","な"],["は"],["何","なん"],["と"],["いう"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":5,"text":"しかし、ユダヤ人の長老たちの上には神の目が注がれていたので、このことがダリヨスに報告され、ついで、このことについての書状が来るまで、この者たちは彼らの働きをやめさせることができなかった。","tok":[["しかし"],["、"],["ユダヤ人","ゆだやじん"],["の"],["長老","ちょうろう"],["たち"],["の"],["上","うえ"],["に"],["は"],["神","かみ"],["の"],["目","め"],["が"],["注がれて","そそがれて"],["いた"],["ので"],["、"],["この"],["こと"],["が"],["ダリヨス"],["に"],["報告","ほうこく"],["され"],["、"],["つい"],["で"],["、"],["この"],["こと"],["について"],["の"],["書状","しょじょう"],["が"],["来る","くる"],["まで"],["、"],["この"],["者","もの"],["たち"],["は"],["彼","かれ"],["ら"],["の"],["働き","はたらき"],["を"],["やめさせる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":6,"text":"川向こうの総督タテナイと、シェタル・ボズナイと、その同僚の川向こうにいる知事たちが、ダリヨス王に書き送った手紙の写しは次のとおりである。","tok":[["川向こう","かわむこう"],["の"],["総督","そうとく"],["タテナイ"],["と"],["、"],["シェタル"],["・"],["ボズナイ"],["と"],["、"],["その"],["同僚","どうりょう"],["の"],["川向こう","かわむこう"],["に"],["いる"],["知事","ちじ"],["たち"],["が"],["、"],["ダリヨス"],["王","おう"],["に"],["書き送った","かきおくった"],["手紙","てがみ"],["の"],["写し","うつし"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":7,"text":"すなわち、彼らが王に送った報告には次のように書かれてあった。／「ダリヨス王に全き平安がありますように。","tok":[["すなわち"],["、"],["彼","かれ"],["ら"],["が"],["王","おう"],["に"],["送った","おくった"],["報告","ほうこく"],["に"],["は"],["次","つぎ"],["の"],["よう"],["に"],["書かれて","かかれて"],["あった"],["。"],["／"],["「"],["ダリヨス"],["王","おう"],["に"],["全","ぜん"],["き"],["平安","へいあん"],["が"],["あります"],["よう"],["に"],["。"]]},{"verse":8,"text":"王にお知らせいたします。私たちはユダの州に行き、あの大いなる神の宮に行ってみましたが、それは大きな石で建てられており、壁には木材が組まれていました。その工事は彼らの手で着々と進められ、順調にはかどっています。","tok":[["王","おう"],["に"],["お知らせ","おしらせ"],["いたします"],["。"],["私たち","わたしたち"],["は"],["ユダ"],["の"],["州","しゅう"],["に"],["行き","いき"],["、"],["あの"],["大いなる","おおいなる"],["神","かみ"],["の"],["宮","みや"],["に"],["行って","いって"],["みました"],["が"],["、"],["それ"],["は"],["大きな","おおきな"],["石","いし"],["で"],["建てられて","たてられて"],["おり"],["、"],["壁","かべ"],["に"],["は"],["木材","もくざい"],["が"],["組まれて","くまれて"],["いました"],["。"],["その"],["工事","こうじ"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["で"],["着々","ちゃくちゃく"],["と"],["進められ","すすめられ"],["、"],["順調","じゅんちょう"],["に"],["はかどって"],["います"],["。"]]},{"verse":9,"text":"そこで、私たちはその長老たちに尋ねて、彼らに次のように言いました。『だれがあなたがたに命令を下して、この宮を建て、この城壁を修復させようとしたのか。』","tok":[["そこ"],["で"],["、"],["私たち","わたしたち"],["は"],["その"],["長老","ちょうろう"],["たち"],["に"],["尋ねて","たずねて"],["、"],["彼","かれ"],["ら"],["に"],["次","つぎ"],["の"],["よう"],["に"],["言いました","いいました"],["。"],["『"],["だれ"],["が"],["あなた"],["がた"],["に"],["命令","めいれい"],["を"],["下して","くだして"],["、"],["この"],["宮","みや"],["を"],["建て","たて"],["、"],["この"],["城壁","じょうへき"],["を"],["修復","しゅうふく"],["させよう"],["と"],["した"],["の"],["か"],["。"],["』"]]},{"verse":10,"text":"私たちはまた、あなたにお知らせするために彼らにその名を尋ねました。それは、彼らのかしらになっている者の名を書きしるすためでした。","tok":[["私たち","わたしたち"],["は"],["また"],["、"],["あなた"],["に"],["お知らせ","おしらせ"],["する"],["ため"],["に"],["彼","かれ"],["ら"],["に"],["その"],["名","な"],["を"],["尋ねました","たずねました"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["かしら"],["に"],["なって"],["いる"],["者","もの"],["の"],["名","な"],["を"],["書きしるす","かきしるす"],["ため"],["でした"],["。"]]},{"verse":11,"text":"すると、彼らは次のように私たちに返事をよこして言いました。『私たちは天と地の神のしもべであり、ずっと昔から建てられていた宮を建て直しているのです。それはイスラエルの大王が建てて、完成させたものです。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["次","つぎ"],["の"],["よう"],["に"],["私たち","わたしたち"],["に"],["返事","へんじ"],["を"],["よこして"],["言いました","いいました"],["。"],["『"],["私たち","わたしたち"],["は"],["天","てん"],["と"],["地","ち"],["の"],["神","かみ"],["の"],["しもべ"],["で"],["あり"],["、"],["ずっと"],["昔","むかし"],["から"],["建てられて","たてられて"],["いた"],["宮","みや"],["を"],["建て直して","たてなおして"],["いる"],["の"],["です"],["。"],["それ"],["は"],["イスラエル"],["の"],["大王","だいおう"],["が"],["建てて","たてて"],["、"],["完成","かんせい"],["させた"],["もの"],["です"],["。"]]},{"verse":12,"text":"しかし、私たちの先祖が、天の神を怒らせたので、神は彼らをカルデヤ人であるバビロンの王ネブカデネザルの手に渡されました。そこで、彼はこの宮を破壊し、民を捕らえてバビロンに移したのです。","tok":[["しかし"],["、"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["が"],["、"],["天","てん"],["の"],["神","かみ"],["を"],["怒らせた","おこらせた"],["ので"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["カルデヤ"],["人","にん"],["で"],["ある"],["バビロン"],["の"],["王","おう"],["ネブカデネザル"],["の"],["手","て"],["に"],["渡されました","わたされました"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["は"],["この"],["宮","みや"],["を"],["破壊","はかい"],["し"],["、"],["民","みん"],["を"],["捕らえて","とらえて"],["バビロン"],["に"],["移した","うつした"],["の"],["です"],["。"]]},{"verse":13,"text":"しかし、バビロンの王クロスの第一年に、クロス王はこの神の宮を再建するよう命令を下しました。","tok":[["しかし"],["、"],["バビロン"],["の"],["王","おう"],["クロス"],["の"],["第","だい"],["一","いち"],["年","ねん"],["に"],["、"],["クロス"],["王","おう"],["は"],["この"],["神","かみ"],["の"],["宮","みや"],["を"],["再建","さいけん"],["する"],["よう"],["命令","めいれい"],["を"],["下しました","くだしました"],["。"]]},{"verse":14,"text":"クロス王はまた、ネブカデネザルがエルサレムの神殿から取って、バビロンの神殿に運んで来た神の宮の金、銀の器具を、バビロンの神殿から取り出し、自分が総督に任命したシェシュバツァルという名の者にそれを渡しました。","tok":[["クロス"],["王","おう"],["は"],["また"],["、"],["ネブカデネザル"],["が"],["エルサレム"],["の"],["神殿","しんでん"],["から"],["取って","とって"],["、"],["バビロン"],["の"],["神殿","しんでん"],["に"],["運んで","はこんで"],["来た","きた"],["神","かみ"],["の"],["宮","みや"],["の"],["金","かね"],["、"],["銀","ぎん"],["の"],["器具","きぐ"],["を"],["、"],["バビロン"],["の"],["神殿","しんでん"],["から"],["取り出し","とりだし"],["、"],["自分","じぶん"],["が"],["総督","そうとく"],["に"],["任命","にんめい"],["した"],["シェシュバツァル"],["と"],["いう"],["名","な"],["の"],["者","もの"],["に"],["それ"],["を"],["渡しました","わたしました"],["。"]]},{"verse":15,"text":"そして、シェシュバツァルに、これらの器具を携えて行って、エルサレムの神殿に納め、神の宮をもとの所に再建せよと言いました。","tok":[["そして"],["、"],["シェシュバツァル"],["に"],["、"],["これ"],["ら"],["の"],["器具","きぐ"],["を"],["携えて","たずさえて"],["行って","いって"],["、"],["エルサレム"],["の"],["神殿","しんでん"],["に"],["納め","おさめ"],["、"],["神","かみ"],["の"],["宮","みや"],["を"],["もと"],["の"],["所","ところ"],["に"],["再建","さいけん"],["せよ"],["と"],["言いました","いいました"],["。"]]},{"verse":16,"text":"そこで、このシェシュバツァルは来て、エルサレムの神の宮の礎を据えました。その時から今に至るまで、建て続けていますが、まだ完成していません。』","tok":[["そこ"],["で"],["、"],["この"],["シェシュバツァル"],["は"],["来て","きて"],["、"],["エルサレム"],["の"],["神","かみ"],["の"],["宮","みや"],["の"],["礎","いしずえ"],["を"],["据えました","すえました"],["。"],["その"],["時","とき"],["から"],["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["建て","たて"],["続けて","つづけて"],["います"],["が"],["、"],["まだ"],["完成","かんせい"],["して"],["いません"],["。"],["』"]]},{"verse":17,"text":"ですから今、王さま、もしもよろしければ、あのバビロンにある王の宝物倉を捜させて、エルサレムにあるこの神の宮を建てるためにクロス王からの命令が下されたかどうかをお調べください。そして、このことについての王のご意見を私たちにお伝えください。」","tok":[["です"],["から"],["今","いま"],["、"],["王","おう"],["さま"],["、"],["もし"],["も"],["よろしければ"],["、"],["あの"],["バビロン"],["に"],["ある"],["王","おう"],["の"],["宝物倉","ほうもつそう"],["を"],["捜させて","さがさせて"],["、"],["エルサレム"],["に"],["ある"],["この"],["神","かみ"],["の"],["宮","みや"],["を"],["建てる","たてる"],["ため"],["に"],["クロス"],["王","おう"],["から"],["の"],["命令","めいれい"],["が"],["下された","くだされた"],["か"],["どう"],["か"],["を"],["お調べ","おしらべ"],["ください"],["。"],["そして"],["、"],["この"],["こと"],["について"],["の"],["王","おう"],["の"],["ご意見","ごいけん"],["を"],["私たち","わたしたち"],["に"],["お伝え","おつたえ"],["ください"],["。"],["」"]]}]
[{"verse":1,"text":"エズラが神の宮の前でひれ伏し、涙ながらに祈って告白しているとき、イスラエルのうちから男や女や子どもの大集団が彼のところに集まって来て、民は激しく涙を流して泣いた。","tok":[["エズラ"],["が"],["神","かみ"],["の"],["宮","みや"],["の"],["前","まえ"],["で"],["ひれ伏し","ひれふし"],["、"],["涙","なみだ"],["ながら"],["に"],["祈って","いのって"],["告白","こくはく"],["して"],["いる"],["とき"],["、"],["イスラエル"],["の"],["うち"],["から"],["男","おとこ"],["や"],["女","おんな"],["や"],["子ども","こども"],["の"],["大","だい"],["集団","しゅうだん"],["が"],["彼","かれ"],["の"],["ところ"],["に"],["集まって","あつまって"],["来て","きて"],["、"],["民","みん"],["は"],["激しく","はげしく"],["涙","なみだ"],["を"],["流して","ながして"],["泣いた","ないた"],["。"]]},{"verse":2,"text":"そのとき、エラムの子孫のひとりエヒエルの子シェカヌヤが、エズラに答えて言った。「私たちは、私たちの神に対して不信の罪を犯し、この地の民である外国の女をめとりました。しかし、このことについては、イスラエルに、今なお望みがあります。","tok":[["その"],["とき"],["、"],["エラム"],["の"],["子孫","しそん"],["の"],["ひとり"],["エヒエル"],["の"],["子","こ"],["シェカヌヤ"],["が"],["、"],["エズラ"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["に対して","にたいして"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["この"],["地","ち"],["の"],["民","たみ"],["で"],["ある"],["外国","がいこく"],["の"],["女","おんな"],["を"],["めとりました"],["。"],["しかし"],["、"],["この"],["こと"],["について"],["は"],["、"],["イスラエル"],["に"],["、"],["今","いま"],["な"],["お望み","おのぞみ"],["が"],["あります"],["。"]]},{"verse":3,"text":"今、私たちは、私たちの神に契約を結び、主の勧告と、私たちの神の命令を恐れる人々の勧告に従って、これらの妻たちと、その子どもたちをみな、追い出しましょう。律法に従ってこれを行いましょう。","tok":[["今","いま"],["、"],["私たち","わたしたち"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["に"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["主","ぬし"],["の"],["勧告","かんこく"],["と"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["命令","めいれい"],["を"],["恐れる","おそれる"],["人々","ひとびと"],["の"],["勧告","かんこく"],["に"],["従って","したがって"],["、"],["これ"],["ら"],["の"],["妻たち","つまたち"],["と"],["、"],["その"],["子ども","こども"],["たち"],["を"],["みな"],["、"],["追い出しましょう","おいだしましょう"],["。"],["律法","りっぽう"],["に"],["従って","したがって"],["これ"],["を"],["行いましょう","おこないましょう"],["。"]]},{"verse":4,"text":"立ち上がってください。このことはあなたの肩にかかっています。私たちはあなたに協力します。勇気を出して、実行してください。」","tok":[["立ち上がって","たちあがって"],["ください"],["。"],["この"],["こと"],["は"],["あなた"],["の"],["肩","かた"],["に"],["かかって"],["います"],["。"],["私たち","わたしたち"],["は"],["あなた"],["に"],["協力","きょうりょく"],["します"],["。"],["勇気","ゆうき"],["を"],["出して","だして"],["、"],["実行","じっこう"],["して"],["ください"],["。"],["」"]]},{"verse":5,"text":"そこで、エズラは立ち上がり、祭司や、レビ人や、全イスラエルのつかさたちに、この提案を実行するように誓わせたので、彼らは誓った。","tok":[["そこ"],["で"],["、"],["エズラ"],["は"],["立ち上がり","たちあがり"],["、"],["祭司","さいし"],["や"],["、"],["レビ人","れびにん"],["や"],["、"],["全","ぜん"],["イスラエル"],["の"],["つかさ"],["たち"],["に"],["、"],["この"],["提案","ていあん"],["を"],["実行","じっこう"],["する"],["よう"],["に"],["誓わせた","ちかわせた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["誓った","ちかった"],["。"]]},{"verse":6,"text":"エズラは神の宮の前を去って、エルヤシブの子ヨハナンの部屋に行き、パンも食べず、水も飲まずにそこで夜を過ごした。捕囚から帰って来た人々の不信の罪を嘆き悲しんでいたからである。","tok":[["エズラ"],["は"],["神","かみ"],["の"],["宮","みや"],["の"],["前","まえ"],["を"],["去って","さって"],["、"],["エルヤシブ"],["の"],["子","こ"],["ヨハナン"],["の"],["部屋","へや"],["に"],["行き","いき"],["、"],["パン"],["も"],["食べず","たべず"],["、"],["水","みず"],["も"],["飲まず","のまず"],["に"],["そこ"],["で"],["夜","よる"],["を"],["過ごした","すごした"],["。"],["捕囚","ほしゅう"],["から"],["帰って","かえって"],["来た","きた"],["人々","ひとびと"],["の"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["嘆き悲しんで","なげきかなしんで"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"そこで、彼らは、捕囚から帰って来た者はみなエルサレムに集合するようにと、ユダとエルサレムにおふれを出した。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["、"],["捕囚","ほしゅう"],["から"],["帰って","かえって"],["来た","きた"],["者","もの"],["は"],["みな"],["エルサレム"],["に"],["集合","しゅうごう"],["する"],["よう"],["に"],["と"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["おふれ"],["を"],["出した","だした"],["。"]]},{"verse":8,"text":"それには、つかさたちや長老たちの勧告に従って、三日のうちに出頭しない者はだれでも、その全財産は聖絶され、その者は、捕囚から帰って来た人々の集団から切り離されることになっていた。","tok":[["それ"],["に"],["は"],["、"],["つかさ"],["たち"],["や"],["長老","ちょうろう"],["たち"],["の"],["勧告","かんこく"],["に"],["従って","したがって"],["、"],["三日","みっか"],["の"],["うち"],["に"],["出頭","しゅっとう"],["しない"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["その"],["全","ぜん"],["財産","ざいさん"],["は"],["聖","せい"],["絶","ぜっ"],["され"],["、"],["その"],["者","もの"],["は"],["、"],["捕囚","ほしゅう"],["から"],["帰って","かえって"],["来た","きた"],["人々","ひとびと"],["の"],["集団","しゅうだん"],["から"],["切り離される","きりはなされる"],["こと"],["に"],["なって"],["いた"],["。"]]},{"verse":9,"text":"それで、ユダとベニヤミンの男はみな、三日のうちに、エルサレムに集まって来た。それは第九の月の二十日であった。こうして、すべての民は神の宮の前の広場にすわり、このことと、大雨のために震えていた。","tok":[["それ"],["で"],["、"],["ユダ"],["と"],["ベニヤミン"],["の"],["男","おとこ"],["は"],["みな"],["、"],["三日","みっか"],["の"],["うち"],["に"],["、"],["エルサレム"],["に"],["集まって","あつまって"],["来た","きた"],["。"],["それ"],["は"],["第","だい"],["九","きゅう"],["の"],["月","つき"],["の"],["二十日","にとうか"],["で"],["あった"],["。"],["こう"],["して"],["、"],["すべて"],["の"],["民","たみ"],["は"],["神","かみ"],["の"],["宮","みや"],["の"],["前","まえ"],["の"],["広場","ひろば"],["に"],["すわり"],["、"],["この"],["こと"],["と"],["、"],["大雨","おおあめ"],["の"],["ため"],["に"],["震えて","ふるえて"],["いた"],["。"]]},{"verse":10,"text":"祭司エズラは立ち上がって、彼らに言った。「あなたがたは、不信の罪を犯した。外国の女をめとって、イスラエルの罪過を増し加えた。","tok":[["祭司","さいし"],["エズラ"],["は"],["立ち上がって","たちあがって"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["外国","がいこく"],["の"],["女","おんな"],["を"],["めとって"],["、"],["イスラエル"],["の"],["罪過","ざいか"],["を"],["増し加えた","ましくわえた"],["。"]]},{"verse":11,"text":"だから今、あなたがたの父祖の神、主に告白して、その御旨にかなったことをしなさい。この地の民と、外国の女から離れなさい。」","tok":[["だ"],["から"],["今","いま"],["、"],["あなた"],["がた"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主に","おもに"],["告白","こくはく"],["して"],["、"],["その"],["御旨","おむね"],["に"],["かなった"],["こと"],["を"],["し"],["なさい"],["。"],["この"],["地","ち"],["の"],["民","たみ"],["と"],["、"],["外国","がいこく"],["の"],["女","おんな"],["から"],["離れ","はなれ"],["なさい"],["。"],["」"]]},{"verse":12,"text":"全集団は大声をあげて答えて言った。「必ずあなたの言われたとおりにします。","tok":[["全","ぜん"],["集団","しゅうだん"],["は"],["大声","おおごえ"],["を"],["あげて"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["必ず","かならず"],["あなた"],["の"],["言われた","いわれた"],["とおり"],["に"],["します"],["。"]]},{"verse":13,"text":"しかし、民は大ぜいであり、また、大雨の季節ですから、私たちは外に立っていることができません。しかも、これは一日や二日の仕事でもありません。このことでは、私たちの多くの者がそむいているのですから。","tok":[["しかし"],["、"],["民","みん"],["は"],["大ぜい","おおぜい"],["で"],["あり"],["、"],["また"],["、"],["大雨","おおあめ"],["の"],["季節","きせつ"],["です"],["から"],["、"],["私たち","わたしたち"],["は"],["外","そと"],["に"],["立って","たって"],["いる"],["こと"],["が"],["できません"],["。"],["しかも"],["、"],["これ"],["は"],["一","いち"],["日","にち"],["や"],["二日","ふたか"],["の"],["仕事","しごと"],["で"],["も"],["ありません"],["。"],["この"],["こと"],["で"],["は"],["、"],["私たち","わたしたち"],["の"],["多く","おおく"],["の"],["者","もの"],["が"],["そむいて"],["いる"],["の"],["です"],["から"],["。"]]},{"verse":14,"text":"私たちのつかさたちは全集団に代わって、ここにとどまっていただきたい。そして、私たちの町で外国の女をめとった者がみな、定まった時に、それぞれの町の長老たちとさばきつかさたちといっしょに出て来るようにしていただきたい。そうすれば、このことについての私たちの神の燃える怒りは、私たちから遠ざかるでしょう。」","tok":[["私たち","わたしたち"],["の"],["つかさ"],["たち"],["は"],["全","ぜん"],["集団","しゅうだん"],["に"],["代わって","かわって"],["、"],["ここ"],["に"],["とどまって"],["いただきたい"],["。"],["そして"],["、"],["私たち","わたしたち"],["の"],["町","まち"],["で"],["外国","がいこく"],["の"],["女","おんな"],["を"],["めとった"],["者","もの"],["が"],["みな"],["、"],["定まった","さだまった"],["時","とき"],["に"],["、"],["それぞれ"],["の"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["と"],["さばき"],["つかさ"],["たち"],["と"],["いっしょ"],["に"],["出て","でて"],["来る","くる"],["よう"],["に"],["して"],["いただきたい"],["。"],["そう"],["すれば"],["、"],["この"],["こと"],["について"],["の"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["燃える","もえる"],["怒り","いかり"],["は"],["、"],["私たち","わたしたち"],["から"],["遠ざかるでしょう","とおざかるでしょう"],["。"],["」"]]},{"verse":15,"text":"アサエルの子ヨナタンとティクワの子ヤフゼヤだけは、メシュラムとレビ人シャベタイの支持を得て、これに反対したが、","tok":[["アサエル"],["の"],["子","こ"],["ヨナタン"],["と"],["ティクワ"],["の"],["子","こ"],["ヤフゼヤ"],["だけ"],["は"],["、"],["メシュラム"],["と"],["レビ人","れびにん"],["シャベタイ"],["の"],["支持","しじ"],["を"],["得て","えて"],["、"],["これ"],["に"],["反対","はんたい"],["した"],["が"],["、"]]},{"verse":16,"text":"捕囚から帰って来た人々は、その提案どおりにした。祭司エズラは、彼らの一族のために、一族のかしらのある者たちをみな、名ざしで選び出した。こうして、彼らはこのことを調べるために、第十の月の一日に会議を始め、","tok":[["捕囚","ほしゅう"],["から"],["帰って","かえって"],["来た","きた"],["人々","ひとびと"],["は"],["、"],["その"],["提案","ていあん"],["どおり"],["に"],["した"],["。"],["祭司","さいし"],["エズラ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["一族","いちぞく"],["の"],["ため"],["に"],["、"],["一族","いちぞく"],["の"],["かしら"],["の"],["ある"],["者","もの"],["たち"],["を"],["みな"],["、"],["名ざし","なざし"],["で"],["選び出した","えらびだした"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["この"],["こと"],["を"],["調べる","しらべる"],["ため"],["に"],["、"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["会議","かいぎ"],["を"],["始め","はじめ"],["、"]]},{"verse":17,"text":"第一の月の一日までに、外国の女をめとった男たちについて、みな調べ終えた。","tok":[["第","だい"],["一","いち"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["まで"],["に"],["、"],["外国","がいこく"],["の"],["女","おんな"],["を"],["めとった"],["男","おとこ"],["たち"],["について"],["、"],["みな"],["調べ","しらべ"],["終えた","おえた"],["。"]]},{"verse":18,"text":"祭司の子らのうちで、外国の女をめとった者がわかったが、それはエホツァダクの子ヨシュアの子たちと、その兄弟たちのうちから、マアセヤ、エリエゼル、ヤリブ、ゲダルヤであった。","tok":[["祭司","さいし"],["の"],["子","こ"],["ら"],["の"],["うち"],["で"],["、"],["外国","がいこく"],["の"],["女","おんな"],["を"],["めとった"],["者","もの"],["が"],["わかった"],["が"],["、"],["それ"],["は"],["エホツァダク"],["の"],["子","こ"],["ヨシュア"],["の"],["子","こ"],["たち"],["と"],["、"],["その"],["兄弟","きょうだい"],["たち"],["の"],["うち"],["から"],["、"],["マアセヤ"],["、"],["エリエゼル"],["、"],["ヤリブ"],["、"],["ゲダルヤ"],["で"],["あった"],["。"]]},{"verse":19,"text":"彼らはその妻を出すという誓いをして、彼らの罪過のために、雄羊一頭を罪過のためのいけにえとしてささげた。","tok":[["彼","かれ"],["ら"],["は"],["その"],["妻","つま"],["を"],["出す","だす"],["と"],["いう"],["誓い","ちかい"],["を"],["して"],["、"],["彼","かれ"],["ら"],["の"],["罪過","ざいか"],["の"],["ため"],["に"],["、"],["雄羊","おひつじ"],["一頭","いちとう"],["を"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["として"],["ささげた"],["。"]]},{"verse":20,"text":"イメル族のうちでは、ハナニとゼバデヤ。","tok":[["イメル族","いめるぞく"],["の"],["うち"],["で"],["は"],["、"],["ハナニ"],["と"],["ゼバデヤ"],["。"]]},{"verse":21,"text":"ハリム族のうちでは、マアセヤ、エリヤ、シェマヤ、エヒエル、ウジヤ。","tok":[["ハリム族","はりむぞく"],["の"],["うち"],["で"],["は"],["、"],["マアセヤ"],["、"],["エリヤ"],["、"],["シェマヤ"],["、"],["エヒエル"],["、"],["ウジヤ"],["。"]]},{"verse":22,"text":"パシュフル族のうちでは、エルヨエナイ、マアセヤ、イシュマエル、ネタヌエル、エホザバデ、エルアサ。","tok":[["パシュフル"],["族","ぞく"],["の"],["うち"],["で"],["は"],["、"],["エルヨエナイ"],["、"],["マアセヤ"],["、"],["イシュマエル"],["、"],["ネタヌエル"],["、"],["エホザバデ"],["、"],["エルアサ"],["。"]]},{"verse":23,"text":"レビ人のうちでは、エホザバデ、シムイ、ケラヤ――すなわちケリタ――、ペタヘヤ、ユダ、エリエゼル。","tok":[["レビ人","れびにん"],["の"],["うち"],["で"],["は"],["、"],["エホザバデ"],["、"],["シムイ"],["、"],["ケラヤ"],["―"],["―"],["すなわち"],["ケリタ"],["―"],["―"],["、"],["ペタヘヤ"],["、"],["ユダ"],["、"],["エリエゼル"],["。"]]},
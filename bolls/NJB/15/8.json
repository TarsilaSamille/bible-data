[{"verse":1,"text":"アルタシャスタ王の治世に、バビロンから私といっしょに上って来た一族のかしらとその系図の記載は次のとおりである。","tok":[["アルタシャスタ"],["王","おう"],["の"],["治世","ちせい"],["に"],["、"],["バビロン"],["から"],["私","わたくし"],["と"],["いっしょ"],["に"],["上って","のぼって"],["来た","きた"],["一族","いちぞく"],["の"],["かしら"],["と"],["その"],["系図","けいず"],["の"],["記載","きさい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"ピネハス族からはゲルショム。イタマル族からはダニエル。ダビデ族からは、ハトシュ。","tok":[["ピネハス"],["族","ぞく"],["から"],["は"],["ゲルショム"],["。"],["イタマル"],["族","ぞく"],["から"],["は"],["ダニエル"],["。"],["ダビデ族","だびでぞく"],["から"],["は"],["、"],["ハトシュ"],["。"]]},{"verse":3,"text":"ハトシュはシェカヌヤの孫。パルオシュ族からは、ゼカリヤと、系図に載せられた同行の者、男子百五十名。","tok":[["ハトシュ"],["は"],["シェカヌヤ"],["の"],["孫","まご"],["。"],["パルオシュ"],["族","ぞく"],["から"],["は"],["、"],["ゼカリヤ"],["と"],["、"],["系図","けいず"],["に"],["載せられた","のせられた"],["同行","どうこう"],["の"],["者","もの"],["、"],["男子","だんし"],["百五十","ひゃくごじゅう"],["名","めい"],["。"]]},{"verse":4,"text":"パハテ・モアブ族からは、ゼラヘヤの子エルエホエナイと、同行の男子二百名。","tok":[["パハテ"],["・"],["モアブ族","もあぶぞく"],["から"],["は"],["、"],["ゼラヘヤ"],["の"],["子","こ"],["エルエホエナイ"],["と"],["、"],["同行","どうこう"],["の"],["男子","だんし"],["二百","にひゃく"],["名","めい"],["。"]]},{"verse":5,"text":"ザト族からは、ヤハジエルの子シェカヌヤと、同行の男子三百名。","tok":[["ザト族","ざとぞく"],["から"],["は"],["、"],["ヤハジエル"],["の"],["子","こ"],["シェカヌヤ"],["と"],["、"],["同行","どうこう"],["の"],["男子","だんし"],["三百","さんひゃく"],["名","めい"],["。"]]},{"verse":6,"text":"アディン族からは、ヨナタンの子エベデと、同行の男子五十名。","tok":[["アディン"],["族","ぞく"],["から"],["は"],["、"],["ヨナタン"],["の"],["子","こ"],["エベデ"],["と"],["、"],["同行","どうこう"],["の"],["男子","だんし"],["五十","ごじゅう"],["名","めい"],["。"]]},{"verse":7,"text":"エラム族からは、アタルヤの子エシャヤと、同行の男子七十名。","tok":[["エラム族","えらむぞく"],["から"],["は"],["、"],["アタルヤ"],["の"],["子","こ"],["エシャヤ"],["と"],["、"],["同行","どうこう"],["の"],["男子","だんし"],["七十","ななじゅう"],["名","めい"],["。"]]},{"verse":8,"text":"シェファテヤ族からは、ミカエルの子ゼバデヤと、同行の男子八十名。","tok":[["シェファテヤ"],["族","ぞく"],["から"],["は"],["、"],["ミカエル"],["の"],["子","こ"],["ゼバデヤ"],["と"],["、"],["同行","どうこう"],["の"],["男子","だんし"],["八十","はちじゅう"],["名","めい"],["。"]]},{"verse":9,"text":"ヨアブ族からは、エヒエルの子オバデヤと、同行の男子二百十八名。","tok":[["ヨアブ族","よ
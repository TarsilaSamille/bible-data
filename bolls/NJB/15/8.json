,["エリエゼル"],["、"],["アリエル"],["、"],["シェマヤ"],["、"],["エルナタン"],["、"],["ヤリブ"],["、"],["エルナタン"],["、"],["ナタン"],["、"],["ゼカリヤ"],["、"],["メシュラム"],["と"],["、"],["教師","きょうし"],["エホヤリブ"],["、"],["エルナタン"],["を"],["呼び集め","よびあつめ"],["、"]]},{"verse":17,"text":"彼らをカシフヤ地方のかしらイドのもとに遣わした。私は彼らにことばを授けて、私たちの神の宮に仕える者たちを連れて来るように、カシフヤ地方にいるイドとその兄弟の宮に仕えるしもべたちに命じた。","tok":[["彼","かれ"],["ら"],["を"],["カシフヤ"],["地方","ちほう"],["の"],["かしら"],["イド"],["の"],["もと"],["に"],["遣わした","つかわした"],["。"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["に"],["ことば"],["を"],["授けて","さずけて"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["宮","みや"],["に"],["仕える","つかえる"],["者","もの"],["たち"],["を"],["連れて","つれて"],["来る","くる"],["よう"],["に"],["、"],["カシフヤ"],["地方","ちほう"],["に"],["いる"],["イド"],["と"],["その"],["兄弟","きょうだい"],["の"],["宮","みや"],["に"],["仕える","つかえる"],["しもべ"],["たち"],["に"],["命じた","めいじた"],["。"]]},{"verse":18,"text":"私たちの神の恵みの御手が私たちの上にあったので、彼らはイスラエルの子、レビの子、マフリの子孫のうちから思慮深い人、シェレベヤと、その子たち、およびその兄弟たち十八名を私たちのところに連れて来た。","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["の"],["恵み","めぐみ"],["の"],["御手","おて"],["が"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["あった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["子","こ"],["、"],["レビ"],["の"],["子","こ"],["、"],["マフリ"],["の"],["子孫","しそん"],["の"],["うち"],["から"],["思慮","しりょ"],["深い","ふかい"],["人","ひと"],["、"],["シェレベヤ"],["と"],["、"],["その"],["子","こ"],["たち"],["、"],["および"],["その"],["兄弟","きょうだい"],["たち"],["十八","じゅうはち"],["名","めい"],["を"],["私たち","わたしたち"],["の"],["ところ"],["に"],["連れて","つれて"],["来た","きた"],["。"]]},{"verse":19,"text":"また、ハシャブヤとともに、メラリの子孫のうちからエシャヤと、その兄弟と、その子たち二十名、","tok":[["また"],["、"],["ハシャブヤ"],["と"],["とも"],["に"],["、"],["メラリ"],["の"],["子孫","しそん"],["の"],["うち"],["から"],["エシャヤ"],["と"],["、"],["その"],["兄弟","きょうだい"],["と"],["、"],["その"],["子","こ"],["たち"],["二十","にじゅう"],["名","めい"],["、"]]},{"verse":20,"text":"および、ダビデとつかさたちにより、レビ人に奉仕するよう任命されていた宮に仕えるしもべたちのうちから、二百二十名の宮に仕えるしもべたちを連れて来た。これらの者はみな、指名された者であった。","tok":[["および"],["、"],["ダビデ"],["と"],["つかさ"],["たち"],["に"],["より"],["、"],["レビ人","れびにん"],["に"],["奉仕","ほうし"],["する"],["よう"],["任命","にんめい"],["されて"],["いた"],["宮","みや"],["に"],
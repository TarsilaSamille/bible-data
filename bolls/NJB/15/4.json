[{"verse":1,"text":"ユダとベニヤミンの敵たちは、捕囚から帰って来た人々が、イスラエルの神、主のために神殿を建てていると聞いて、","tok":[["ユダ"],["と"],["ベニヤミン"],["の"],["敵","てき"],["たち"],["は"],["、"],["捕囚","ほしゅう"],["から"],["帰って","かえって"],["来た","きた"],["人々","ひとびと"],["が"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["建てて","たてて"],["いる"],["と"],["聞いて","きいて"],["、"]]},{"verse":2,"text":"ゼルバベルと一族のかしらたちのところに近づいて来て、言った。「私たちも、あなたがたといっしょに建てたい。私たちは、あなたがたと同様、あなたがたの神を求めているのです。アッシリヤの王エサル・ハドンが、私たちをここに連れて来た時以来、私たちはあなたがたの神に、いけにえをささげてきました。」","tok":[["ゼルバベル"],["と"],["一族","いちぞく"],["の"],["かしら"],["たち"],["の"],["ところ"],["に"],["近づいて","ちかづいて"],["来て","きて"],["、"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["も"],["、"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["建てたい","たてたい"],["。"],["私たち","わたしたち"],["は"],["、"],["あなた"],["がた"],["と"],["同様","どうよう"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["を"],["求めて","もとめて"],["いる"],["の"],["です"],["。"],["アッシリヤ"],["の"],["王","おう"],["エサル"],["・"],["ハドン"],["が"],["、"],["私たち","わたしたち"],["を"],["ここ"],["に"],["連れて","つれて"],["来た","きた"],["時","とき"],["以来","いらい"],["、"],["私たち","わたしたち"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["に"],["、"],["いけにえ"],["を"],["ささげて"],["きました"],["。"],["」"]]},{"verse":3,"text":"しかし、ゼルバベルとヨシュアとその他のイスラエルの一族のかしらたちは、彼らに言った。「私たちの神のために宮を建てることについて、あなたがたと私たちとは何の関係もない。ペルシヤの王、クロス王が私たちに命じたとおり、私たちだけで、イスラエルの神、主のために宮を建てるつもりだ。」","tok":[["しかし"],["、"],["ゼルバベル"],["と"],["ヨシュア"],["と"],["その"],["他","た"],["の"],["イスラエル"],["の"],["一族","いちぞく"],["の"],["かしら"],["たち"],["は"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てる","たてる"],["こと"],["について"],["、"],["あなた"],["がた"],["と"],["私たち","わたしたち"],["と"],["は"],["何","なん"],["の"],["関係","かんけい"],["も"],["ない"],["。"],["ペルシヤ"],["の"],["王","おう"],["、"],["クロス"],["王","おう"],["が"],["私たち","わたしたち"],["に"],["命じた","めいじた"],["とおり"],["、"],["私たち","わたしたち"],["だけ"],["で"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てる","たてる"],["つもり"],["だ"],["。"],["」"]]},{"verse":4,"text":"すると、その地の民は、建てさせまいとして、ユダの民の気力を失わせ、彼らをおどした。","tok":[["する"],["と"],["、"],["その"],["地","ち"],["の"],["民","たみ"],["は"],["、"],["建てさせまい","たてさせまい"],["として"],["、"],["ユダ"],["の"],["民","たみ"],["の"],["気力","きりょく"],["を"],["失わせ","うしなわせ"],["、"],["彼","かれ"],["ら"],["を"],["おどした"],["。"]]},{"verse":5,"text":"さらに、議官を買収して彼らに反対させ、この計画を打ちこわそうとした。このことはペルシヤの王クロスの時代からペルシヤの王ダリヨスの治世の時まで続いた。","tok":[["さらに"],["、"],["議官","ぎかん"],["を"],["買収","ばいしゅう"],["して"],["彼","かれ"],["ら"],["に"],["反対","はんたい"],["させ"],["、"],["この"],["計画","けいかく"],["を"],["打ちこわそう","うちこわそう"],["と"],["した"],["。"],["この"],["こと"],["は"],["ペルシヤ"],["の"],["王","おう"],["クロス"],["の"],["時代","じだい"],["から"],["ペルシヤ"],["の"],["王","おう"],["ダリヨス"],["の"],["治世","ちせい"],["の"],["時","とき"],["まで"],["続いた","つづいた"],["。"]]},{"verse":6,"text":"アハシュエロスの治世、すなわちその治世の初めに、彼らはユダとエルサレムの住民を非難する一通の告訴状を書いた。","tok":[["アハシュエロス"],["の"],["治世","ちせい"],["、"],["すなわち"],["その"],["治世","ちせい"],["の"],["初め","はじめ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["ユダ"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["を"],["非難","ひなん"],["する"],["一通","いちつう"],["の"],["告訴状","こくそじょう"],["を"],["書いた","かいた"],["。"]]},{"verse":7,"text":"また、アルタシャスタの時代に、ビシュラム、ミテレダテ、タベエルとその他の同僚は、ペルシヤの王アルタシャスタに書き送った。その手紙はアラム語の文字で書かれ、アラム語で述べられていた。","tok":[["また"],["、"],["アルタシャスタ"],["の"],["時代","じだい"],["に"],["、"],["ビシュラム"],["、"],["ミテレダテ"],["、"],["タベエル"],["と"],["その"],["他","た"],["の"],["同僚","どうりょう"],["は"],["、"],["ペルシヤ"],["の"],["王","おう"],["アルタシャスタ"],["に"],["書き送った","かきおくった"],["。"],["その"],["手紙","てがみ"],["は"],["アラム"],["語","ご"],["の"],["文字","もじ"],["で"],["書かれ","かかれ"],["、"],["アラム"],["語","ご"],["で"],["述べられて","のべられて"],["いた"],["。"]]},{"verse":8,"text":"参事官レフム、書記官シムシャイはエルサレムを非難して、次のような手紙をアルタシャスタ王に書き送った。","tok":[["参事官","さんじかん"],["レフム"],["、"],["書記官","しょきかん"],["シムシャイ"],["は"],["エルサレム"],["を"],["非難","ひなん"],["して"],["、"],["次","つぎ"],["の"],["よう"],["な"],["手紙","てがみ"],["を"],["アルタシャスタ"],["王","おう"],["に"],["書き送った","かきおくった"],["。"]]},{"verse":9,"text":"すなわち、参事官レフム、書記官シムシャイ、その他の同僚、裁判官、使節、役人、官吏、エレク人、バビロン人、シュシャンの人々、すなわち、エラム人、","tok":[["すなわち"],["、"],["参事官","さんじかん"],["レフム"],["、"],["書記官","しょきかん"],["シムシャイ"],["、"],["その"],["他","た"],["の"],["同僚","どうりょう"],["、"],["裁判官","さいばんかん"],["、"],["使節","しせつ"],["、"],["役人","やくにん"],["、"],["官吏","かんり"],["、"],["エレク人","えれくにん"],["、"],["バビロン"],["人","にん"],["、"],["シュシャン"],["の"],["人々","ひとびと"],["、"],["すなわち"],["、"],["エラム人","えらむにん"],["、"]]},{"verse":10,"text":"その他、名声高い大王オスナパルがサマリヤの町と川向こうのその他の地に引いて行って住まわせた民たちが、書き送った。さて、","tok":[["その"],["他","た"],["、"],["名声","めいせい"],["高い","たかい"],["大王","だいおう"],["オスナパル"],["が"],["サマリヤ"],["の"],["町","まち"],["と"],["川向こう","かわむこう"],["の"],["その"],["他","た"],["の"],["地","ち"],["に"],["引いて","ひいて"],["行って","いって"],["住まわせた","すまわせた"],["民","たみ"],["たち"],["が"],["、"],["書き送った","かきおくった"],["。"],["さて"],["、"]]},{"verse":11,"text":"彼らが送ったその手紙の写しは次のとおりである。／「川向こうの者、あなたのしもべたちから、アルタシャスタ王へ。さて、","tok":[["彼","かれ"],["ら"],["が"],["送った","おくった"],["その"],["手紙","てがみ"],["の"],["写し","うつし"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["／"],["「"],["川向こう","かわむこう"],["の"],["者","もの"],["、"],["あなた"],["の"],["しもべ"],["たち"],["から"],["、"],["アルタシャスタ"],["王","おう"],["へ"],["。"],["さて"],["、"]]},{"verse":12,"text":"王にお知らせいたします。あなたのところから、こちらに来たユダヤ人たちはエルサレムに行き、あの反抗的で危険な町を再建しています。その城壁を修復し、その礎もすでに据えられています。","tok":[["王","おう"],["に"],["お知らせ","おしらせ"],["いたします"],["。"],["あなた"],["の"],["ところ"],["から"],["、"],["こちら"],["に"],["来た","きた"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["エルサレム"],["に"],["行き","いき"],["、"],["あの"],["反抗的","はんこうてき"],["で"],["危険","きけん"],["な"],["町","まち"],["を"],["再建","さいけん"],["して"],["います"],["。"],["その"],["城壁","じょうへき"],["を"],["修復","しゅうふく"],["し"],["、"],["その"],["礎","いしずえ"],["も"],["すでに"],["据えられて","すえられて"],["います"],["。"]]},{"verse":13,"text":"今、王にお知らせいたします。もしこの町が再建され、城壁が修復されたら、彼らはみつぎ、関税、税金を納めなくなるでしょう。そうすれば、王の収入に損害を与えることになりましょう。","tok":[["今","いま"],["、"],["王","おう"],["に"],["お知らせ","おしらせ"],["いたします"],["。"],["もし"],["この"],["町","まち"],["が"],["再建","さいけん"],["され"],["、"],["城壁","じょうへき"],["が"],["修復","しゅうふく"],["されたら"],["、"],["彼","かれ"],["ら"],["は"],["みつぎ"],["、"],["関税","かんぜい"],["、"],["税金","ぜいきん"],["を"],["納めなく","おさめなく"],["なるでしょう"],["。"],["そう"],["すれば"],["、"],["王","おう"],["の"],["収入","しゅうにゅう"],["に"],["損害","そんがい"],["を"],["与える","あたえる"],["こと"],["に"],["なりましょう"],["。"]]},{"verse":14,"text":"さて、私たちは王宮の恩恵を受けておりますから、王のはずかしめを見るのに耐えられません。それゆえ、私たちは人を遣わして、王にお知らせするのです。","tok":[["さて"],["、"],["私たち","わたしたち"],["は"],["王宮","おうきゅう"],["の"],["恩恵","おんけい"],["を"],["受けて","うけて"],["おります"],["から"],["、"],["王","おう"],["の"],["はずかし"],["め"],["を"],["見る","みる"],["のに"],["耐えられません","たえられません"],["。"],["それ"],["ゆえ"],["、"],["私たち","わたしたち"],["は"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["王","おう"],["に"],["お知らせ","おしらせ"],["する"],["の"],["です"],["。"]]},{"verse":15,"text":"あなたの先祖の記録文書をお調べになれば、この町が反抗的な町で、王たちと諸州に損害を与え、また昔からこの町で反逆が行われたことを、その記録文書の中に見て、おわかりになるでしょう。この町が滅ぼされたのも、そのためです。","tok":[["あなた"],["の"],["先祖","せんぞ"],["の"],["記録","きろく"],["文書","ぶんしょ"],["を"],["お調べ","おしらべ"],["に"],["なれば"],["、"],["この"],["町","まち"],["が"],["反抗的","はんこうてき"],["な"],["町","まち"],["で"],["、"],["王","おう"],["たち"],["と"],["諸州","しょしゅう"],["に"],["損害","そんがい"],["を"],["与え","あたえ"],["、"],["また"],["昔","むかし"],["から"],["この"],["町","まち"],["で"],["反逆","はんぎゃく"],["が"],["行われた","おこなわれた"],["こと"],["を"],["、"],["その"],["記録","きろく"],["文書","ぶんしょ"],["の"],["中","なか"],["に"],["見て","みて"],["、"],["おわかり"],["に"],["なるでしょう"],["。"],["この"],["町","まち"],["が"],["滅ぼされた","ほろぼされた"],["の"],["も"],["、"],["その"],["ため"],["です"],["。"]]},{"verse":16,"text":"私たちは王にお知らせします。もしこの町が再建され、城壁が修復されたら、あなたはこのために川向こうの領土を失ってしまわれるでしょう。」","tok":[["私たち","わたしたち"],["は"],["王","おう"],["に"],["お知らせ","おしらせ"],["します"],["。"],["もし"],["この"],["町","まち"],["が"],["再建","さいけん"],["され"],["、"],["城壁","じょうへき"],["が"],["修復","しゅうふく"],["されたら"],["、"],["あなた"],["は"],["この"],["ため"],["に"],["川向こう","かわむこう"],["の"],["領土","りょうど"],["を"],["失って","うしなって"],["しまわれるでしょう"],["。"],["」"]]},{"verse":17,"text":"王は参事官レフム、書記官シムシャイ、およびサマリヤと川向こうのその他の地に住んでいる彼らの同僚に返事を送った。／「平安があるように。さて、","tok":[["王","おう"],["は"],["参事官","さんじかん"],["レフム"],["、"],["書記官","しょきかん"],["シムシャイ"],["、"],["および"],["サマリヤ"],["と"],["川向こう","かわむこう"],["の"],["その"],["他","た"],["の"],["地","ち"],["に"],["住んで","すんで"],["いる"],["彼","かれ"],["ら"],["の"],["同僚","どうりょう"],["に"],["返事","へんじ"],["を"],["送った","おくった"],["。"],["／"],["「"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"],["さて"],["、"]]},{"verse":18,"text":"あなたがたが、私たちに送ったあの書状は、私の前で説明して読まれた。","tok":[["あなた"],["が"],["た"],["が"],["、"],["私たち","わたしたち"],["に"],["送った","おくった"],["あの"],["書状","しょじょう"],["は"],["、"],["私","わたくし"],["の"],["前","まえ"],["で"],["説明","せつめい"],["して"],["読まれた","よまれた"],["。"]]},{"verse":19,"text":"私は命令を下し、調べさせたところ、その町は昔から王たちに対して謀反を企て、その町で暴動と反逆が行われたことがわかった。","tok":[["私","わたくし"],["は"],["命令","めいれい"],["を"],["下し","くだし"],["、"],["調べ","しらべ"],["させた"],["ところ"],["、"],["その"],["町","まち"],["は"],["昔","むかし"],["から"],["王","おう"],["たち"],["に対して","にたいして"],["謀反","むほん"],["を"],["企て","くわだて"],["、"],["その"],["町","まち"],["で"],["暴動","ぼうどう"],["と"],["反逆","はんぎゃく"],["が"],["行われた","おこなわれた"],["こと"],["が"],["わかった"],["。"]]},{"verse":20,"text":"またエルサレムにはかつて勢力のある王たちがいて、川向こうの地を全部支配し、みつぎ、関税、税金が彼らに納められていたこともわかった。","tok":[["また"],["エルサレム"],["に"],["は"],["かつて"],["勢力","せいりょく"],["の"],["ある"],["王","おう"],["たち"],["が"],["いて"],["、"],["川向こう","かわむこう"],["の"],["地","ち"],["を"],["全部","ぜんぶ"],["支配","しはい"],["し"],["、"],["みつぎ"],["、"],["関税","かんぜい"],["、"],["税金","ぜいきん"],["が"],["彼","かれ"],["ら"],["に"],["納められて","おさめられて"],["いた"],["こと"],["も"],["わかった"],["。"]]},{"verse":21,"text":"今、あなたがたは命令を下して、その者たちの働くのをやめさせ、私が再び命令を下すまで、この町が再建されないようにせよ。","tok":[["今","いま"],["、"],["あなた"],["がた"],["は"],["命令","めいれい"],["を"],["下して","くだして"],["、"],["その"],["者","もの"],["たち"],["の"],["働く","はたらく"],["の"],["を"],["やめさせ"],["、"],["私","わたくし"],["が"],["再び","ふたたび"],["命令","めいれい"],["を"],["下す","くだす"],["まで"],["、"],["この"],["町","まち"],["が"],["再建","さいけん"],["されない"],["よう"],["に"],["せよ"],["。"]]},{"verse":22,"text":"あなたがたは、よく注意してこのことを怠ってはならない。損害を増して王を傷つけるといけないから。」","tok":[["あなた"],["がた"],["は"],["、"],["よく"],["注意","ちゅうい"],["して"],["この"],["こと"],["を"],["怠って","おこたって"],["は"],["ならない"],["。"],["損害","そんがい"],["を"],["増して","まして"],["王","おう"],["を"],["傷つける","きずつける"],["と"],["いけない"],["から"],["。"],["」"]]},{"verse":23,"text":"アルタシャスタ王の書状の写しがレフムと、書記官シムシャイと、その同僚の前で読まれると、彼らは急いでエルサレムのユダヤ人のところに行って、武力をもって彼らの働きをやめさせた。","tok":[["アルタシャスタ"],["王","おう"],["の"],["書状","しょじょう"],["の"],["写し","うつし"],["が"],["レフム"],["と"],["、"],["書記官","しょきかん"],["シムシャイ"],["と"],["、"],["その"],["同僚","どうりょう"],["の"],["
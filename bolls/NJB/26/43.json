],["、"],["血","ち"],["を"],["それ"],["に"],["注ぎ","そそぎ"],["かける"],["ため"],["に"],["祭壇","さいだん"],["を"],["立てる","たてる"],["日","ひ"],["に"],["は"],["、"],["次","つぎ"],["の"],["こと"],["が"],["祭壇","さいだん"],["に"],["関する","かんする"],["定め","さだめ"],["と"],["なる"],["。"]]},{"verse":19,"text":"わたしに仕えるために、わたしに近づくツァドクの子孫のレビ人の祭司たちに、あなたは、罪のためのいけにえとして若い雄牛一頭を与えよ。――神である主の御告げ――","tok":[["わたし"],["に"],["仕える","つかえる"],["ため"],["に"],["、"],["わたし"],["に"],["近づく","ちかづく"],["ツァドク"],["の"],["子孫","しそん"],["の"],["レビ人","れびにん"],["の"],["祭司","さいし"],["たち"],["に"],["、"],["あなた"],["は"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["として"],["若い","わかい"],["雄牛","おうし"],["一頭","いちとう"],["を"],["与え","あたえ"],["よ"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":20,"text":"あなたは、その血を取って、祭壇の四本の角と、台座の四隅と、回りのみぞにつけ、祭壇をきよめ、そのための贖いをしなければならない。","tok":[["あなた"],["は"],["、"],["その"],["血","ち"],["を"],["取って","とって"],["、"],["祭壇","さいだん"],["の"],["四本","よんぽん"],["の"],["角","かど"],["と"],["、"],["台座","だいざ"],["の"],["四隅","よすみ"],["と"],["、"],["回り","まわり"],["の"],["みぞ"],["に"],["つけ"],["、"],["祭壇","さいだん"],["を"],["きよめ"],["、"],["その"],["ため"],["の"],["贖い","あがない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":21,"text":"またあなたは、罪のためのいけにえの雄牛を取り、これを聖所の外の宮の一定の所で焼かなければならない。","tok":[["また"],["あなた"],["は"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["の"],["雄牛","おうし"],["を"],["取り","とり"],["、"],["これ"],["を"],["聖","せい"],["所","しょ"],["の"],["外","そと"],["の"],["宮","みや"],["の"],["一定","いってい"],["の"],["所","ところ"],["で"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":22,"text":"二日目に、あなたは、傷のない雄やぎを罪のためのいけにえとしてささげ、雄牛できよめたように、祭壇をきよめよ。","tok":[["二日目","ふたかめ"],["に"],["、"],["あなた"],["は"],["、"],["傷","きず"],["の"],["ない"],["雄","おす"],["やぎ"],["を"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["として"],["ささげ"],["、"],["雄牛","おうし"],["で"],["きよめた"],["よう"],["に"],["、"],["祭壇","さいだん"],["を"],["きよめよ"],["。"]]},{"verse":23,"text":"きよめ終えたら、あなたは、傷のない若い雄牛と群れのうちの傷のない雄羊とをささげよ。","tok":[["きよめ"],["終えたら","おえたら"],["、"],["あなた"],["は"],["、"],["傷","きず"],["の"],["ない"],["若い","わかい"],["雄牛","おうし"],["と"],["群れ","むれ"],["の"],["うち"],["の"],["傷","きず"],["の"],["ない"],["雄羊","おひつじ"],["と"],["を"],["ささげ"],["よ"],["。"]]},{"verse":24,"text":"あなたは、それらを主の前にささげ、祭司たちがそれらの上に塩をまき、全焼のいけにえとして主にささげなければならない。","tok":[["あなた"],["は"],["、"],["それ"],["ら"],["を"],["主","ぬし"],["の"],["前","まえ"],["に"],["ささげ"],["、"],["祭司","さいし"],["たち"],["が"],["それ"],["ら"],["の"],["上","うえ"],["に"],["塩","しお"],["を"],["まき"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["主に","おもに"],["ささげなければ"],["ならない"],["。"]]},{"verse":25,"text":"七日間、あなたは毎日、罪のためのいけにえとして雄やぎをささげ、傷のない若い雄牛と群れのうちの傷のない雄羊とをささげなければならない。","tok":[["七","なな"],["日間","かかん"],["、"],["あなた"],["は"],["毎日","まいにち"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["として"],["雄","おす"],["やぎ"],["を"],["ささげ"],["、"],["傷","きず"],["の"],["ない"],["若い","わかい"],["雄牛","おうし"],["と"],["群れ","むれ"],["の"],["うち"],["の"],["傷","きず"],["の"],["ない"],["雄羊","おひつじ"],["と"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":26,"text":"七日間にわたって祭壇の贖いをし、それをきよめて使い始めなければならない。","tok":[["七","なな"],["日間","かかん"],["に"],["わたって"],["祭壇","さいだん"],["の"],["贖い","あがない"],["を"],["し"],["、"],["それ"],["を"],["きよめて"],["使い","つかい"],["始めなければ","はじめなければ"],["ならない"],["。"]]},{"verse":27,"text":"この期間が終わり、八日目と、その後は、祭司たちが祭壇の上で、あなたがたの全焼のいけにえと和解のいけにえとをささげなければならない。そうすれば、わたしはあなたがたを受け入れる。――神である主の御告げ――」","tok":[["この"],["期間","きかん"],["が"],["終わり","おわり"],["、"],["八日目","ようかめ"],["と"],["、"],["その後","そのあと"],["は"],["、"],["祭司","さいし"],["たち"],["が"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["、"],["あなた"],["がた"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["和解","わかい"],["の"],["いけにえ"],["と"],["を"],["ささげなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["受け入れる","うけいれる"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]}]
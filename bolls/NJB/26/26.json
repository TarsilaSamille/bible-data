,["脱ぎ","ぬぎ"],["、"],["恐れ","おそれ"],["を"],["身","み"],["に"],["まとい"],["、"],["地面","じめん"],["に"],["すわり"],["、"],["身震い","みぶるい"],["し"],["ながら"],["、"],["おまえ"],["の"],["こと"],["で"],["おののき"],["、"]]},{"verse":17,"text":"おまえについて、哀歌を唱えて言う。／海に住む者よ。／おまえはどうして海から消えうせたのか。／海で強くなり、ほめはやされた町よ。／すべての住民を恐れさせたその町とその住民よ。","tok":[["おまえ"],["について"],["、"],["哀歌","あいか"],["を"],["唱えて","となえて"],["言う","ゆう"],["。"],["／"],["海","うみ"],["に"],["住む","すむ"],["者","もの"],["よ"],["。"],["／"],["おまえ"],["は"],["どう"],["して"],["海","うみ"],["から"],["消えうせた","きえうせた"],["の"],["か"],["。"],["／"],["海","うみ"],["で"],["強く","つよく"],["なり"],["、"],["ほめ"],["はやされた"],["町","まち"],["よ"],["。"],["／"],["すべて"],["の"],["住民","じゅうみん"],["を"],["恐れさせた","おそれさせた"],["その"],["町","まち"],["と"],["その"],["住民","じゅうみん"],["よ"],["。"]]},{"verse":18,"text":"今、島々はおまえがくずれ落ちる日に身震いし、海沿いの島々は／おまえの最期を見ておびえている。","tok":[["今","いま"],["、"],["島々","しまじま"],["は"],["おまえ"],["が"],["くずれ落ちる","くずれおちる"],["日","ひ"],["に"],["身震い","みぶるい"],["し"],["、"],["海沿い","うみぞい"],["の"],["島々","しまじま"],["は"],["／"],["おまえ"],["の"],["最期","さいご"],["を"],["見て","みて"],["おびえて"],["いる"],["。"]]},{"verse":19,"text":"まことに、神である主はこう仰せられる。わたしがおまえを廃墟の町とし、住む者のない町々のようにするとき、深淵をおまえの上にわき上がらせ、大水がおまえをおおうとき、","tok":[["まこと"],["に"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["が"],["おまえ"],["を"],["廃墟","はいきょ"],["の"],["町","まち"],["と"],["し"],["、"],["住む","すむ"],["者","もの"],["の"],["ない"],["町々","まちまち"],["の"],["よう"],["に"],["する"],["とき"],["、"],["深淵","しんえん"],["を"],["おまえ"],["の"],["上","うえ"],["に"],["わき上がらせ","わきあがらせ"],["、"],["大水","おおみず"],["が"],["おまえ"],["を"],["おおう"],["とき"],["、"]]},{"verse":20,"text":"わたしがおまえを穴に下る者たちとともに昔の民のもとに下らせるとき、わたしはおまえを穴に下る者たちとともに、昔から廃墟であったような地下の国に住ませる。わたしが誉れを与える生ける者の地におまえが住めないようにするためだ。","tok":[["わたし"],["が"],["おまえ"],["を"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["とも"],["に"],["昔","むかし"],["の"],["民","たみ"],["の"],["もと"],["に"],["下らせる","くだらせる"],["とき"],["、"],["わたし"],["は"],["おまえ"],["を"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["とも"],["に"],["、"],["昔","むかし"],["から"],["廃墟","はいきょ"],["で"],["あった"],["よう"],["な"],["地下","ちか"],["の"],["国","くに"],["に"],["住ませる","すませる"],["。"],["わたし"],["が"],["誉れ","ほまれ"],["を"],["与える","あたえる"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["に"],["おまえ"],["が"],["住めない","すめない"],["よう"],["に"],["する"],["ため"],["だ"],["。"]]},{"verse":21,"text":"わたしはおまえを恐怖とする。おまえはもう存在しなくなり、人がおまえを尋ねても、永久におまえを見つけることはない。――神である主の御告げ――」","tok":[["わたし"],["は"],["おまえ"],["を"],["恐怖","きょうふ"],["と"],["する"],["。"],["おまえ"],["は"],["もう"],["存在","そんざい"],["しなく"],["なり"],["、"],["人","ひと"],["が"],["おまえ"],["を"],["尋ねて","たずねて"],["も"],["、"],["永久","えいきゅう"],["に"],["おまえ"],["を"],["見つける","みつける"],["こと"],["は"],["ない"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]}]
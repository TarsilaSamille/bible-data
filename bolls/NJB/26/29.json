[{"verse":1,"text":"第十年の第十の月の十二日、私に次のような主のことばがあった。","tok":[["第","だい"],["十","じゅう"],["年","ねん"],["の"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["の"],["十二","じゅうに"],["日","にち"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。顔をエジプトの王パロに向け、彼およびエジプト全体に預言し、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["顔","かお"],["を"],["エジプト"],["の"],["王","おう"],["パロ"],["に"],["向け","むけ"],["、"],["彼","かれ"],["および"],["エジプト"],["全体","ぜんたい"],["に"],["預言","よげん"],["し"],["、"]]},{"verse":3,"text":"こう語って言え。／神である主はこう仰せられる。／エジプトの王パロよ。／わたしはあなたに立ち向かう。／あなたは、自分の川の中に横たわる大きなわにで、『川は私のもの。／私がこれを造った』と言っている。","tok":[["こう"],["語って","かたって"],["言え","いえ"],["。"],["／"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["エジプト"],["の"],["王","おう"],["パロ"],["よ"],["。"],["／"],["わたし"],["は"],["あなた"],["に"],["立ち向かう","たちむかう"],["。"],["／"],["あなた"],["は"],["、"],["自分","じぶん"],["の"],["川","かわ"],["の"],["中","なか"],["に"],["横たわる","よこたわる"],["大きな","おおきな"],["わに"],["で"],["、"],["『"],["川","かわ"],["は"],["私","わたくし"],["の"],["もの"],["。"],["／"],["私","わたくし"],["が"],["これ"],["を"],["造った","つくった"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":4,"text":"わたしはあなたのあごに鉤をかけ、あなたの川の魚をあなたのうろこにつけ、あなたと、あなたのうろこについている川のすべての魚とを／川の中から引き上げる。","tok":[["わたし"],["は"],["あなた"],["の"],["あご"],["に"],["鉤","はり"],["を"],["かけ"],["、"],["あなた"],["の"],["川","かわ"],["の"],["魚","さかな"],["を"],["あなた"],["の"],["うろこ"],["に"],["つけ"],["、"],["あなた"],["と"],["、"],["あなた"],["の"],["うろこ"],["について"],["いる"],["川","かわ"],["の"],["すべて"],["の"],["魚","さかな"],["と"],["を"],["／"],["川","かわ"],["の"],["中","なか"],["から"],["引き上げる","ひきあげる"],["。"]]},{"verse":5,"text":"あなたとあなたの川のすべての魚とを／荒野に投げ捨てる。／あなたは野原に倒れ、集められず、葬られることもない。／わたしがあなたを／地の獣と空の鳥のえじきとするとき、","tok":[["あなた"],["と"],["あなた"],["の"],["川","かわ"],["の"],["すべて"],["の"],["魚","さかな"],["と"],["を"],["／"],["荒野","こうや"],["に"],["投げ捨てる","なげすてる"],["。"],["／"],["あなた"],["は"],["野原","のはら"],["に"],["倒れ","たおれ"],["、"],["集められず","あつめられず"],["、"],["葬られる","ほうむられる"],["こと"],["も"],["ない"],["。"],["／"],["わたし"],["が"],["あなた"],["を"],["／"],["地","ち"],["の"],["獣","けもの"],["と"],["空","そら"],["の"],["鳥","とり"],["の"],["えじき"],["と"],["する"],["とき"],["、"]]},{"verse":6,"text":"エジプトの住民はみな、わたしが主であることを知ろう。／彼らが、イスラエルの家に対して、葦の杖にすぎなかったからだ。","tok":[["エジプト"],["の"],["住民","じゅうみん"],["は"],["みな"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"],["／"],["彼","かれ"],["ら"],["が"],["、"],["イスラエル"],["の"],["家","いえ"],["に対して","にたいして"],["、"],["葦","あし"],["の"],["杖","つえ"],["に"],["すぎなかった"],["から"],["だ"],["。"]]},{"verse":7,"text":"彼らがあなたの手をつかむと、あなたは折れ、彼らのすべての肩を砕いた。／彼らがあなたに寄りかかると、あなたは折れ、彼らのすべての腰をいためた。","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["の"],["手","て"],["を"],["つかむ"],["と"],["、"],["あなた"],["は"],["折れ","おれ"],["、"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["肩","かた"],["を"],["砕いた","くだいた"],["。"],["／"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["寄りかかる","よりかかる"],["と"],["、"],["あなた"],["は"],["折れ","おれ"],["、"],["彼","かれ"],["ら"],["の"],["すべて"],["の"],["腰","こし"],["を"],["いためた"],["。"]]},{"verse":8,"text":"それゆえ、神である主はこう仰せられる。わたしは剣を送ってあなたを攻め、人も獣も、あなたのうちから断ち滅ぼす。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["剣","けん"],["を"],["送って","おくって"],["あなた"],["を"],["攻め","せめ"],["、"],["人","ひと"],["も"],["獣","けもの"],["も"],["、"],["あなた"],["の"],["うち"],["から"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"]]},{"verse":9,"text":"エジプトの地は荒れ果てて廃墟となる。このとき、彼らは、わたしが主であることを知ろう。それは彼が、『川は私のもの。私がこれを造った』と言ったからだ。","tok":[["エジプト"],["の"],["地","ち"],["は"],["荒れ果てて","あれはてて"],["廃墟","はいきょ"],["と"],["なる"],["。"],["この"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"],["それ"],["は"],["彼","かれ"],["が"],["、"],["『"],["川","かわ"],["は"],["私","わたくし"],["の"],["もの"],["。"],["私","わたくし"],["が"],["これ"],["を"],["造った","つくった"],["』"],["と"],["言った","いった"],["から"],["だ"],["。"]]},{"verse":10,"text":"それゆえ、わたしは、あなたにもあなたの川にも立ち向かい、エジプトの地を、ミグドルからセベネ、さらにクシュの国境に至るまで、荒れ果てさせて廃墟にする。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["あなた"],["に"],["も"],["あなた"],["の"],["川","かわ"],["に"],["も"],["立ち向かい","たちむかい"],["、"],["エジプト"],["の"],["地","ち"],["を"],["、"],["ミグドル"],["から"],["セベネ"],["、"],["さらに"],["クシュ"],["の"],["国境","こっきょう"],["に"],["至る","いたる"],["まで"],["、"],["荒れ果てさせて","あれはてさせて"],["廃墟","はいきょ"],["に"],["する"],["。"]]},{"verse":11,"text":"人の足もそこを通らず、獣の足もそこを通らず、四十年の間だれも住まなくなる。","tok":[["人","ひと"],["の"],["足","あし"],["も"],["そこ"],["を"],["通らず","とおらず"],["、"],["獣","けもの"],["の"],["足","あし"],["も"],["そこ"],["を"],["通らず","とおらず"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["だれ"],["も"],["住まなく","すまなく"],["なる"],["。"]]},{"verse":12,"text":"わたしはエジプトの地を、荒れ果てた国々の間で荒れ果てさせ、その町々も四十年の間、廃墟となった町々の間で荒れ果てる。わたしはエジプト人を諸国の民の中に散らし、国々に追い散らす。","tok":[["わたし"],["は"],["エジプト"],["の"],["地","ち"],["を"],["、"],["荒れ果てた","あれはてた"],["国々","くにぐに"],["の"],["間","あいだ"],["で"],["荒れ果てさせ","あれはてさせ"],["、"],["その"],["町々","まちまち"],["も"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["廃墟","はいきょ"],["と"],["なった"],["町々","まちまち"],["の"],["間","あいだ"],["で"],["荒れ果てる","あれはてる"],["。"],["わたし"],["は"],["エジプト"],["人","にん"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["散らし","ちらし"],["、"],["国々","くにぐに"],["に"],["追い散らす","おいちらす"],["。"]]},{"verse":13,"text":"まことに、神である主はこう仰せられる。四十年の終わりになって、わたしはエジプト人を、散らされていた国々の民の中から集め、","tok":[["まこと"],["に"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["四十","よんじゅう"],["年","ねん"],["の"],["終わり","おわり"],["に"],["なって"],["、"],["わたし"],["は"],["エジプト"],["人","にん"],["を"],["、"],["散らされて","ちらされて"],["いた"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["集め","あつめ"],["、"]]},{"verse":14,"text":"エジプトの繁栄を元どおりにする。彼らをその出身地パテロスの地に帰らせる。彼らはそこで、取るに足りない王国となる。","tok":[["エジプト"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["する"],["。"],["彼","かれ"],["ら"],["を"],["その"],["出身地","しゅっしんち"],["パテロス"],["の"],["地","ち"],["に"],["帰らせる","かえらせる"],["。"],["彼","かれ"],["ら"],["は"],["そこ"],["で"],["、"],["取る","とる"],["に"],["足りない","たりない"],["王国","おうこく"],["と"],["なる"],["。"]]},{"verse":15,"text":"どの王国にも劣り、二度と諸国の民の上にぬきんでることはない。彼らが諸国の民を支配しないように、わたしは彼らを小さくする。","tok":[["どの"],["王国","おうこく"],["に"],["も"],["劣り","おとり"],["、"],["二","に"],["度","ど"],["と"],["諸国","しょこく"],
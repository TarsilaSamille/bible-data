[{"verse":1,"text":"あなたはイスラエルの君主たちのために哀歌を唱えて、","tok":[["あなた"],["は"],["イスラエル"],["の"],["君主","くんしゅ"],["たち"],["の"],["ため"],["に"],["哀歌","あいか"],["を"],["唱えて","となえて"],["、"]]},{"verse":2,"text":"言え。／あなたの母である雌獅子は何なのか。／雄獅子の間に伏し、若い獅子の間で子獅子を養った。","tok":[["言え","いえ"],["。"],["／"],["あなた"],["の"],["母","はは"],["で"],["ある"],["雌","めす"],["獅子","しし"],["は"],["何","なん"],["な"],["の"],["か"],["。"],["／"],["雄","ゆう"],["獅子","しし"],["の"],["間","あいだ"],["に"],["伏し","ふし"],["、"],["若い","わかい"],["獅子","しし"],["の"],["間","あいだ"],["で"],["子","こ"],["獅子","しし"],["を"],["養った","やしなった"],["。"]]},{"verse":3,"text":"雌獅子が子獅子のうちの一頭を育て上げると、それは若い獅子となり、獲物を引き裂くことを習い、人を食べた。","tok":[["雌","めす"],["獅子","しし"],["が"],["子","こ"],["獅子","しし"],["の"],["うち"],["の"],["一頭","いちとう"],["を"],["育て上げる","そだてあげる"],["と"],["、"],["それ"],["は"],["若い","わかい"],["獅子","しし"],["と"],["なり"],["、"],["獲物","えもの"],["を"],["引き裂く","ひきさく"],["こと"],["を"],["習い","ならい"],["、"],["人","ひと"],["を"],["食べた","たべた"],["。"]]},{"verse":4,"text":"諸国の民はその獅子のうわさを聞いた。／その獅子は彼らの落とし穴で捕らえられた。／彼らは鉤でこれを／エジプトの地へ引きずって行った。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["は"],["その"],["獅子","しし"],["の"],["うわさ"],["を"],["聞いた","きいた"],["。"],["／"],["その"],["獅子","しし"],["は"],["彼","かれ"],["ら"],["の"],["落とし穴","おとしあな"],["で"],["捕らえられた","とらえられた"],["。"],["／"],["彼","かれ"],["ら"],["は"],["鉤","はり"],["で"],["これ"],["を"],["／"],["エジプト"],["の"],["地","ち"],["へ"],["引きずって","ひきずって"],["行った","いった"],["。"]]},{"verse":5,"text":"雌獅子は、待ちくたびれ、自分の望みが消えうせたことを知ったとき、子獅子のうちのほかの一頭を取り、若い獅子とした。","tok":[["雌","めす"],["獅子","しし"],["は"],["、"],["待ちくたびれ","まちくたびれ"],["、"],["自分","じぶん"],["の"],["望み","のぞみ"],["が"],["消えうせた","きえうせた"],["こと"],["を"],["知った","しった"],["とき"],["、"],["子","こ"],["獅子","しし"],["の"],["うち"],["の"],["ほか"],["の"],["一頭","いちとう"],["を"],["取り","とり"],["、"],["若い","わかい"],["獅子","しし"],["と"],["した"],["。"]]},{"verse":6,"text":"これも、雄獅子の間を歩き回り、若い獅子となって、獲物を引き裂くことを習い、人を食べた。","tok":[["これ"],["も"],["、"],["雄","ゆう"],["獅子","しし"],["の"],["間","あいだ"],["を"],["歩き回り","あるきまわり"],["、"],["若い","わかい"],["獅子","しし"],["と"],["なって"],["、"],["獲物","えもの"],["を"],["引き裂く","ひきさく"],["こと"],["を"],["習い","ならい"],["、"],["人","ひと"],["を"],["食べた","たべた"],["。"]]},{"verse":7,"text":"この獅子は人のやもめたちを犯し、町々を廃墟とした。／そのほえる声のために、地と、それに満ちているものはおののいた。","tok":[["この"],["獅子","しし"],["は"],["人","ひと"],["の"],["やもめ"],["たち"],["を"],["犯し","おかし"],["、"],["町々","まちまち"],["を"],["廃墟","はいきょ"],["と"],["した"],["。"],["／"],["その"],["ほえる"],["声","こえ"],["の"],["ため"],["に"],["、"],["地","ち"],["と"],["、"],["それ"],["に"],["満ちて","みちて"],["いる"],["もの"],["は"],["おののいた"],["。"]]},{"verse":8,"text":"そこで、諸国の民は、回りの州から攻め上り、その獅子に彼らの網を打ちかけた。／その獅子は彼らの落とし穴で捕らえられた。","tok":[["そこ"],["で"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["、"],["回り","まわり"],["の"],["州","しゅう"],["から"],["攻め上り","せめのぼり"],["、"],["その"],["獅子","しし"],["に"],["彼","かれ"],["ら"],["の"],["網","あみ"],["を"],["打ち","うち"],["かけた"],["。"],["／"],["その"],["獅子","しし"],["は"],["彼","かれ"],["ら"],["の"],["落とし穴","おとしあな"],["で"],["捕らえられた","とらえられた"],["。"]]},{"verse":9,"text":"彼らはそれを鉤にかけておりに入れ、バビロンの王のもとに引いて行った。／彼らはそれをとりでに閉じ込め、二度とその声が／イスラエルの山々に聞こえないようにした。","tok":[["彼","かれ"],["ら"],["は"],["それ"],["を"],["鉤","はり"],["に"],["かけて"],["おり"],["に"],["入れ","いれ"],["、"],["バビロン"],["の"],["王","おう"],["の"],["もと"],["に"],["引いて","ひいて"],["行った","いった"],["。"],["／"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["とりで"],["に"],["閉じ込め","とじこめ"],["、"],["二","に"],["度","ど"],["と"],["その"],["声","こえ"],["が"],["／"],["イスラエル"],["の"],["山々","やまやま"],["に"],["聞こえない","きこえない"],["よう"],["に"],["した"],["。"]]},{"verse":10,"text":"あなたの母は、まさしく、水のほとりに植えられた／ぶどうの木のようだった。／水が豊かなために実りが良く、枝も茂った。","tok":[["あなた"],["の"],["母","はは"],["は"],["、"],["まさしく"],["、"],["水","みず"],["の"],["ほとり"],["に"],["植えられた","うえられた"],["／"],["ぶどう"],["の"],["木","き"],["の"],["よう"],["だった"],["。"],["／"],["水","みず"],["が"],["豊か","ゆたか"],["な"],["ため"],["に"],["実り","みのり"],["が"],["良く","よく"],["、"],["枝","えだ"],["も"],["茂った","しげった"],["。"]]},{"verse":11,"text":"その強い枝は王の杖となり、そのたけは茂みの中できわだって高く、多くの小枝をつけてきわだって見えた。","tok":[["その"],["強い","つよい"],["枝","えだ"],["は"],["王","おう"],["の"],["杖","つえ"],["と"],["なり"],["、"],["その"],["たけ"],["は"],["茂み","しげみ"],["の"],["中","なか"],["で"],["きわだって"],["高く","たかく"],["、"],["多く","おおく"],["の"],["小枝","こえだ"],["を"],["つけて"],["きわだって"],["見えた","みえた"],["。"]]},{"verse":12,"text":"しかし、それは憤りのうちに引き抜かれ、地に投げ捨てられ、東風はその実を枯らし、その強い枝も折られて枯れ、火に焼き尽くされた。","tok":[["しかし"],["、"],["それ"],["は"],["憤り","いきどおり"],["の"],["うち"],["に"],["引き抜かれ","ひきぬかれ"],["、"],["地","ち"],["に"],["投げ捨てられ","なげすてられ"],["、"],["東風","とうふう"],["は"],["その"],["実","じつ"],["を"],["枯らし","からし"],["、"],["その"],["強い","つよい"],["枝","えだ"],["も"],["折られて","おられて"],["枯れ","かれ"],["、"],["火","ひ"],["に"],["焼き","やき"],["尽くされた","つくされた"],["。"]]},{"verse":13,"text":"今や、それは、荒野と砂漠と、潤いのない地に移し植えられ、","tok":[["今","いま"],["や"],["、"],["それ"],["は"],["、"],["荒野","こうや"],["と"],["砂漠","さばく"],["と"],["、"],["潤い","うるおい"],["の"],["ない"],["地","ち"],["に"],["移し植えられ","うつしうえられ"],["、"]]},{"verse":14,"text":"火がその枝から出て、その若枝と実を焼き尽くした。／もう、それには／王の杖となる強い枝がなくなった。」／これは悲しみの歌、哀歌となった。","tok":[["火","ひ"],["が"],["その"],["枝","えだ"],["から"],["出て","でて"],["、"],["その"],["若枝","わかえだ"],["と"],["実","じつ"],["を"],["焼き","やき"],["尽くした","つくした"],["。"],["／"],["もう"],["、"],["それ"],["に"],["は"],["／"],["王","おう"],["の"],["杖","つえ"],["と"],["なる"],["強い","つよい"],["枝","えだ"],["が"],["なくなった"],["。"],["」"],["／"],["これ"],["は"],["悲しみ","かなしみ"],["の"],["歌","うた"],["、"],["哀歌","あいか"],["と"],["なった"],["。"]]}]
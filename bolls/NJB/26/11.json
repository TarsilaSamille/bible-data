[{"verse":1,"text":"そのとき、霊が私を引き上げて、主の宮の東に面した東の門に連れて行った。ちょうど、その門の入口には二十五人の者がいて、その中に、私は、民の長であるアズルの子ヤアザヌヤと、ベナヤの子ペラテヤがいるのを見た。","tok":[["その"],["とき"],["、"],["霊","れい"],["が"],["私","わたくし"],["を"],["引き上げて","ひきあげて"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["東","ひがし"],["に"],["面した","めんした"],["東","ひがし"],["の"],["門","もん"],["に"],["連れて","つれて"],["行った","いった"],["。"],["ちょうど"],["、"],["その"],["門","もん"],["の"],["入口","いりぐち"],["に"],["は"],["二十五人","にじゅうごにん"],["の"],["者","もの"],["が"],["いて"],["、"],["その"],["中","なか"],["に"],["、"],["私","わたくし"],["は"],["、"],["民","みん"],["の"],["長","ちょう"],["で"],["ある"],["アズル"],["の"],["子","こ"],["ヤアザヌヤ"],["と"],["、"],["ベナヤ"],["の"],["子","こ"],["ペラテヤ"],["が"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":2,"text":"主は私に仰せられた。「人の子よ。この者たちは、この町で、邪悪な計画を立て、悪いはかりごとをめぐらし、","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["この"],["者","もの"],["たち"],["は"],["、"],["この"],["町","まち"],["で"],["、"],["邪悪","じゃあく"],["な"],["計画","けいかく"],["を"],["立て","たて"],["、"],["悪い","わるい"],["はかりごと"],["を"],["めぐらし"],["、"]]},{"verse":3,"text":"『家を建てるにはまだ間がある。この町はなべであり、私たちはその肉だ』と言っている。","tok":[["『"],["家","いえ"],["を"],["建てる","たてる"],["に"],["は"],["まだ"],["間","あいだ"],["が"],["ある"],["。"],["この"],["町","まち"],["は"],["なべ"],["で"],["あり"],["、"],["私たち","わたしたち"],["は"],["その"],["肉","にく"],["だ"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":4,"text":"だから、彼らに向かって預言せよ。人の子よ。預言せよ。」","tok":[["だ"],["から"],["、"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["預言","よげん"],["せよ"],["。"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["預言","よげん"],["せよ"],["。"],["」"]]},{"verse":5,"text":"ついで主の霊が私に下り、私に仰せられた。「主はこう仰せられる、と言え。イスラエルの家よ。あなたがたはあのように言ったが、わたしは、あなたがたの心に浮かぶことどもをよく知っている。","tok":[["ついで"],["主","ぬし"],["の"],["霊","れい"],["が"],["私","わたくし"],["に"],["下り","くだり"],["、"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["、"],["と"],["言え","いえ"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["。"],["あなた"],["がた"],["は"],["あの"],["よう"],["に"],["言った","いった"],["が"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["に"],["浮かぶ","うかぶ"],["こと"],["ども"],["を"],["よく"],["知って","しって"],["いる"],["。"]]},{"verse":6,"text":"あなたがたはこの町に刺し殺された者をふやし、死体でその道ばたを満たした。","tok":[["あなた"],["がた"],["は"],["この"],["町","まち"],["に"],["刺し殺された","さしころされた"],["者","もの"],["を"],["ふやし"],["、"],["死体","したい"],["で"],["その"],["道ばた","みちばた"],["を"],["満たした","みたした"],["。"]]},{"verse":7,"text":"それゆえ、神である主はこう仰せられる。あなたがたが町の中に置いた死体は肉であり、この町はなべである。しかしわたしは、あなたがたをその中から取り出そう。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["が"],["町","まち"],["の"],["中","なか"],["に"],["置いた","おいた"],["死体","したい"],["は"],["肉","にく"],["で"],["あり"],["、"],["この"],["町","まち"],["は"],["なべ"],["で"],["ある"],["。"],["しかし"],["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["その"],["中","なか"],["から"],["取り出そう","とりだそう"],["。"]]},{"verse":8,"text":"あなたがたは剣を恐れるが、わたしはあなたがたの上に剣をもたらす。――神である主の御告げ――","tok":[["あなた"],["がた"],["は"],["剣","けん"],["を"],["恐れる","おそれる"],["が"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["剣","けん"],["を"],["もたらす"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":9,"text":"わたしはあなたがたを町から連れ出して、他国人の手に渡し、あなたがたにさばきを下す。","tok":[["わたし"],["は"],["あなた"],["がた"],["を"],["町","まち"],["から"],["連れ出して","つれだして"],["、"],["他国人","たこくにん"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["あなた"],["がた"],["に"],["さばき"],["を"],["下す","くだす"],["。"]]},{"verse":10,"text":"あなたがたが剣に倒れ、わたしがイスラエルの国境であなたがたをさばくとき、あなたがたは、わたしが主であることを知ろう。","tok":[["あなた"],["がた"],["が"],["剣","けん"],["に"],["倒れ","たおれ"],["、"],["わたし"],["が"],["イスラエル"],["の"],["国境","こっきょう"],["で"],["あなた"],["がた"],["を"],["さばく"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":11,"text":"この町はあなたがたにとってなべとはならず、あなたがたはその中の肉とはならない。わたしは、イスラエルの国境であなたがたをさばこう。","tok":[["この"],["町","まち"],["は"],["あなた"],["がた"],["にとって"],["なべ"],["と"],["は"],["ならず"],["、"],["あなた"],["がた"],["は"],["その"],["中","なか"],["の"],["肉","にく"],["と"],["は"],["ならない"],["。"],["わたし"],["は"],["、"],["イスラエル"],["の"],["国境","こっきょう"],["で"],["あなた"],["がた"],["を"],["さばこう"],["。"]]},{"verse":12,"text":"あなたがたは、わたしが主であることを知ろう。あなたがたが、わたしのおきてに従って歩まず、わたしの定めを守らず、あなたがたの回りにいる諸国の民のならわしに従ったからである。」","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"],["あなた"],["が"],["た"],["が"],["、"],["わたし"],["の"],["おきて"],["に"],["従って","したがって"],["歩まず","あゆまず"],["、"],["わたし"],["の"],["定め","さだめ"],["を"],["守らず","まもらず"],["、"],["あなた"],["がた"],["の"],["回り","まわり"],["に"],["いる"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["ならわし"],["に"],["従った","したがった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":13,"text":"こうして、私が預言しているとき、ベナヤの子ペラテヤが死んだ。そこで、私はひれ伏し、大声で叫んで言った。「ああ、神、主よ。あなたはイスラエルの残りの者たちを、ことごとく滅ぼされるのでしょうか。」","tok":[["こう"],["して"],["、"],["私","わたくし"],["が"],["預言","よげん"],["して"],["いる"],["とき"],["、"],["ベナヤ"],["の"],["子","こ"],["ペラテヤ"],["が"],["死んだ","しんだ"],["。"],["そこ"],["で"],["、"],["私","わたくし"],["は"],["ひれ伏し","ひれふし"],["、"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["たち"],["を"],["、"],["ことごとく"],["滅ぼされる","ほろぼされる"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":14,"text":"そのとき、私に次のような主のことばがあった。","tok":[["その"],["とき"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":15,"text":"「人の子よ。あなたの兄弟、あなたの同胞、あなたの身近な親類の者たち、またイスラエルの全家のすべての者に対して、エルサレムの住民は、『主から遠く離れよ。この地は私たちの所有として与えられているのだ』と言った。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["の"],["兄弟","きょうだい"],["、"],["あなた"],["の"],["同胞","どうほう"],["、"],["あなた"],["の"],["身近","みじか"],["な"],["親類","しんるい"],["の"],["者","もの"],["たち"],["、"],["また"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["の"],["すべて"],["の"],["者","もの"],["に対して","にたいして"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["は"],["、"],["『"],["主","ぬし"],["から"],["遠く","とおく"],["離れ","はなれ"],["よ"],["。"],["この"],["地","ち"],["は"],["私たち","わたしたち"],["の"],["所有","しょゆう"],["として"],["与えられて","あたえられて"],["いる"],["の"],["だ"],["』"],["と"],["言った","いった"],["。"]]},{"verse":16,"text":"それゆえ言え。『神である主はこう仰せられる。わたしは彼らを遠く異邦の民の中へ移し、国々の中に散らした。しかし、わたしは彼らが行ったその国々で、しばらくの間、彼らの聖所となっていた。』","tok":[["それ"],["ゆえ"],["言え","いえ"],["。"],["『"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["遠く","とおく"],["異邦","いほう"],["の"],["民","たみ"],["の"],["中","なか"],["へ"],["移し","うつし"],["、"],["国々","くにぐに"],["の"],["中","なか"],["に"],["散らした","ちらした"],["。"],["しかし"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["が"],["行った","おこなった"],["その"],["国々","くにぐに"],["で"],["、"],["しばらく"],["の"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["の"],["聖","せい"],["所","しょ"],["と"],["なって"],["いた"],["。"],["』"]]},{"verse":17,"text":"それゆえ言え。『神である主はこう仰せられる。わたしはあなたがたを、国々の民のうちから集め、あなたがたが散らされていた国々からあなたがたを連れ戻し、イスラエルの地をあなたがたに与える。』","tok":[["それ"],["ゆえ"],["言え","いえ"],["。"],["『"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["あなた"],["がた"],["を"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["うち"],["から"],["集め","あつめ"],["、"],["あなた"],["がた"],["が"],["散らされて","ちらされて"],["いた"],["国々","くにぐに"],["から"],["あなた"],["がた"],["を"],["連れ戻し","つれもどし"],["、"],["イスラエル"],["の"],["地","ち"],["を"],["あなた"],["がた"],["に"],["与える","あたえる"],["。"],["』"]]},{"verse":18,"text":"彼らがそこに来るとき、すべての忌むべきもの、すべての忌みきらうべきものをそこから取り除こう。","tok":[["彼","かれ"],["ら"],["が"],["そこ"],["に"],["来る","くる"],["とき"],["、"],["すべて"],["の"],["忌むべき","いむべき"],["もの"],["、"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["もの"],["を"],["そこ"],["から"],["取り除こう","とりのぞこう"],["。"]]},{"verse":19,"text":"わたしは彼らに一つの心を与える。すなわち、わたしはあなたがたのうちに新しい霊を与える。わたしは彼らのからだから石の心を取り除き、彼らに肉の心を与える。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["一","ひと"],["つ"],["の"],["心","こころ"],["を"],["与える","あたえる"],["。"],["すなわち"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["新しい","あたらしい"],["霊","れい"],["を"],["与える","あたえる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["からだ"],["から"],["石","いし"],["の"],["心","こころ"],["を"],["取り除き","とりのぞき"],["、"],["彼","かれ"],["ら"],["に"],["肉","にく"],["の"],["心","こころ"],["を"],["与える","あたえる"],["。"]]},{"verse":20,"text":"それは、彼らがわたしのおきてに従って歩み、わたしの定めを守り行うためである。こうして、彼らはわたしの民となり、わたしは彼らの神となる。","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["おきて"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"],["わたし"],["の"],["定め","さだめ"],["を"],["守り","まもり"],["行う","おこなう"],["ため"],["で"],["ある"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":21,"text":"しかし、彼らの忌むべきものや、忌みきらうべきものの心を、自分の心として歩む者には、彼らの頭上に彼らの行いを返そう。――神である主の御告げ――」","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["の"],["忌むべき","いむべき"],["もの"],["や"],["、"],["忌みきらうべき","いみきらうべき"],["もの"],["の"],["心","こころ"],["を"],["、"],["自分","じぶん"],["の"],["心","こころ"],["として"],["歩む","あゆむ"],["者","もの"],["に"],["は"],["、"],["彼","かれ"],["ら"],["の"],["頭上","ずじょう"],["に"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["を"],["返そう","かえそう"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":22,"text":"ケルビムが翼を広げると、輪もそれといっしょに動き出し、イスラエルの神の栄光がその上のほうにあった。","tok":[["ケルビム"],["が"],["翼","つばさ"],["を"],["広げる","ひろげる"],["と"],["、"],["輪","わ"],["も"],["それ"],["と"],["いっしょ"],["に"],["動き","うごき"],["出し","だし"],["、"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["その"],["上","うえ"],["の"],["ほう"],["に"],["あった"],["。"]]},{"verse":23,"text":"主の栄光はその町の真ん中から上って、町の東にある山の上にとどまった。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["は"],["その"],["町","まち"],["の"],["真ん中","まんなか"],["から"],["上って","のぼって"],["、"],["町","まち"],["の"],["東","ひがし"],["に"],["ある"],["山","やま"],["の"],["上","うえ"],["に"],["とどまった"],["。"]]},{"verse":24,"text":"また、霊が私を引き上げ、神の霊によって幻のうちに私をカルデヤの捕囚の民のところへ連れて行った。そして、私が見たその幻は、私から去って上って行った。","tok":[["また"],["、"],["霊","れい"],["が"],["私","わたくし"],["を"],["引き上げ","ひきあげ"],["、"],["神","かみ"],["の"],["霊","れい"],["によって"],["幻","まぼろし"],["の"],["うち"],["に"],["私","わたくし"],["を"],["カルデヤ"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["の"],["ところ"],["へ"],["連れて","つれて"],["行った","いった"],["。"],["そして"],["、"],["私","わたくし"],["が"],["見た","みた"],["その"],["幻","まぼろし"],["は"],["、"],["私","わたくし"],["から"],["去って","さって"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":25,"text":"そこで私は、主が私に示されたことをことごとく捕囚の民に告げた。","tok":[["そこ"],["で"],["私","わたくし"],["は"],["、"],["主","ぬし"],["が"],["私","わたくし"],["に"],["示された","しめされた"],["こと"],["を"],["ことごとく"],["捕囚","ほしゅう"],["の"],["民","たみ"],["に"],["告げた","つげた"],["。"]]}]
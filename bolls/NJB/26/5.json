[{"verse":1,"text":"人の子よ。あなたは鋭い剣を取り、それを床屋のかみそりのように使って、あなたの頭と、ひげをそり、その毛をはかりで量って等分せよ。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["は"],["鋭い","するどい"],["剣","けん"],["を"],["取り","とり"],["、"],["それ"],["を"],["床屋","とこや"],["の"],["かみそり"],["の"],["よう"],["に"],["使って","つかって"],["、"],["あなた"],["の"],["頭","あたま"],["と"],["、"],["ひげ"],["を"],["そり"],["、"],["その"],["毛","け"],["を"],["はかりで"],["量って","はかって"],["等分","とうぶん"],["せよ"],["。"]]},{"verse":2,"text":"その三分の一を、包囲の期間の終わるとき、町の中で焼き、またほかの三分の一を取り、町の回りでそれを剣で打ち、残りの三分の一を、風に吹き散らせ。わたしは剣を抜いて彼らのあとを追う。","tok":[["その"],["三分","さんぶん"],["の"],["一","いち"],["を"],["、"],["包囲","ほうい"],["の"],["期間","きかん"],["の"],["終わる","おわる"],["とき"],["、"],["町","まち"],["の"],["中","なか"],["で"],["焼き","やき"],["、"],["また"],["ほか"],["の"],["三分","さんぶん"],["の"],["一","いち"],["を"],["取り","とり"],["、"],["町","まち"],["の"],["回りで","まわりで"],["それ"],["を"],["剣","けん"],["で"],["打ち","うち"],["、"],["残り","のこり"],["の"],["三分","さんぶん"],["の"],["一","いち"],["を"],["、"],["風","ふう"],["に"],["吹き散らせ","ふきちらせ"],["。"],["わたし"],["は"],["剣","けん"],["を"],["抜いて","ぬいて"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追う","おう"],["。"]]},{"verse":3,"text":"あなたはそこから少しの毛を取り、それをあなたの衣のすそで包み、","tok":[["あなた"],["は"],["そこ"],["から"],["少し","すこし"],["の"],["毛","け"],["を"],["取り","とり"],["、"],["それ"],["を"],["あなた"],["の"],["衣","ころも"],["の"],["すそ"],["で"],["包み","つつみ"],["、"]]},{"verse":4,"text":"そのうちからいくらかを取って、火の中にくべ、それを火で焼け。火がその中から出て、イスラエルの全家に燃え移ろう。」","tok":[["その"],["うち"],["から"],["いくら"],["か"],["を"],["取って","とって"],["、"],["火","ひ"],["の"],["中","なか"],["に"],["くべ"],["、"],["それ"],["を"],["火","ひ"],["で"],["焼け","やけ"],["。"],["火","ひ"],["が"],["その"],["中","なか"],["から"],["出て","でて"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["に"],["燃え移ろう","もえうつろう"],["。"],["」"]]},{"verse":5,"text":"神である主はこう仰せられる。「これがエルサレムだ。わたしはこれを諸国の民の真ん中に置き、その回りを国々で取り囲ませた。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["これ"],["が"],["エルサレム"],["だ"],["。"],["わたし"],["は"],["これ"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["真ん中","まんなか"],["に"],["置き","おき"],["、"],["その"],["回り","まわり"],["を"],["国々","くにぐに"],["で"],["取り囲ませた","とりかこませた"],["。"]]},{"verse":6,"text":"エルサレムは諸国の民よりも悪事を働いて、わたしの定めに逆らい、その回りの国々よりもわたしのおきてに逆らった。実に、エルサレムは、わたしの定めをないがしろにし、わたしのおきてに従って歩まなかった。」","tok":[["エルサレム"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["より"],["も"],["悪事","あくじ"],["を"],["働いて","はたらいて"],["、"],["わたし"],["の"],["定め","さだめ"],["に"],["逆らい","さからい"],["、"],["その"],["回り","まわり"],["の"],["国々","くにぐに"],["より"],["も"],["わたし"],["の"],["おきて"],["に"],["逆らった","さからった"],["。"],["実","じつ"],["に"],["、"],["エルサレム"],["は"],["、"],["わたし"],["の"],["定め","さだめ"],["を"],["ないがしろ"],["に"],["し"],["、"],["わたし"],["の"],["おきて"],["に"],["従って","したがって"],["歩まなかった","あゆまなかった"],["。"],["」"]]},{"verse":7,"text":"それゆえ、神である主はこう仰せられる。「あなたがたは、あなたがたの回りの諸国の民よりも狂暴で、わたしのおきてに従って歩まず、わたしの定めを行わず、それどころか、あなたがたの回りの諸国の民の定めさえ行わなかった。」","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["回り","まわり"],["の"],["諸国","しょこく"],["の"],["民","たみ"],["より"],["も"],["狂暴","きょうぼう"],["で"],["、"],["わたし"],["の"],["おきて"],["に"],["従って","したがって"],["歩まず","あゆまず"],["、"],["わたし"],["の"],["定め","さだめ"],["を"],["行わず","おこなわず"],["、"],["それ"],["どころ"],["か"],["、"],["あなた"],["がた"],["の"],["回り","まわり"],["の"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["定め","さだめ"],["さえ"],["行わなかった","おこなわなかった"],["。"],["」"]]},{"verse":8,"text":"それゆえ、神である主はこう仰せられる。「今、わたしもあなたを攻め、諸国の民の目の前で、あなたにさばきを下す。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["今","いま"],["、"],["わたし"],["も"],["あなた"],["を"],["攻め","せめ"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["あなた"],["に"],["さばき"],["を"],["下す","くだす"],["。"]]},{"verse":9,"text":"あなたのしたすべての忌みきらうべきことのために、今までしたこともなく、これからもしないようなことを、あなたのうちで行う。","tok":[["あなた"],["の"],["した"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["の"],["ため"],["に"],["、"],["今まで","いままで"],["した"],["こと"],["も"],["なく"],["、"],["これ"],["から"],["も"],["しない"],["よう"],["な"],["こと"],["を"],["、"],["あなた"],["の"],["うち"],["で"],["行う","おこなう"],["。"]]},{"verse":10,"text":"それで、あなたのうちの父たちは自分の子どもを食べ、子どもたちは、自分の父を食べるようになる。わたしは、あなたにさばきを下し、あなたのうちの残りの者をすべて四方に散らす。","tok":[["それ"],["で"],["、"],["あなた"],["の"],["うち"],["の"],["父","ちち"],["たち"],["は"],["自分","じぶん"],["の"],["子ども","こども"],["を"],["食べ","たべ"],["、"],["子ども","こども"],["たち"],["は"],["、"],["自分","じぶん"],["の"],["父","ちち"],["を"],["食べる","たべる"],["よう"],["に"],["なる"],["。"],["わたし"],["は"],["、"],["あなた"],["に"],["さばき"],["を"],["下し","くだし"],["、"],["あなた"],["の"],["うち"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["すべて"],["四方","しほう"],["に"],["散らす","ちらす"],["。"]]},{"verse":11,"text":"それゆえ、――わたしは生きている。神である主の御告げ――あなたはあなたのすべての忌むべきものと、すべての忌みきらうべきことで、わたしの聖所を汚したので、わたしはあなたを取り去り、わたしはあなたを惜しまず、また、あわれまない。","tok":[["それ"],["ゆえ"],["、"],["―"],["―"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["あなた"],["は"],["あなた"],["の"],["すべて"],["の"],["忌むべき","いむべき"],["もの"],["と"],["、"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["で"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚した","よごした"],["ので"],["、"],["わたし"],["は"],["あなた"],["を"],["取り去り","とりさり"],["、"],["わたし"],["は"],["あなた"],["を"],["惜しまず","おしまず"],["、"],["また"],["、"],["あわれまない"],["。"]]},{"verse":12,"text":"あなたの三分の一はあなたのうちで疫病で死ぬか、あるいは、ききんで滅び、三分の一はあなたの回りで剣に倒れ、残りの三分の一を、わたしは四方に散らし、剣を抜いて彼らのあとを追う。","tok":[["あなた"],["の"],["三分","さんぶん"],["の"],["一","いち"],["は"],["あなた"],["の"],["うち"],["で"],["疫病","やくびょう"],["で"],["死ぬ","しぬ"],["か"],["、"],["あるいは"],["、"],["ききん"],["で"],["滅び","ほろび"],["、"],["三分","さんぶん"],["の"],["一","いち"],["は"],["あなた"],["の"],["回りで","まわりで"],["剣","けん"],["に"],["倒れ","たおれ"],["、"],["残り","のこり"],["の"],["三分","さんぶん"],["の"],["一","いち"],["を"],["、"],["わたし"],["は"],["四方","しほう"],["に"],["散らし","ちらし"],["、"],["剣","けん"],["を"],["抜いて","ぬいて"],["彼","かれ"],["ら"],["の"],["あと"],["を"],["追う","おう"],["。"]]},{"verse":13,"text":"わたしの怒りが全うされると、わたしは彼らに対するわたしの憤りを静めて満足する。わたしが彼らに対する憤りを全うするとき、彼らは、主であるわたしが熱心に語ったことを知ろう。","tok":[["わたし"],["の"],["怒り","いかり"],["が"],["全う","まっとう"],["される"],["と"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["わたし"],["の"],["憤り","いきどおり"],["を"],["静めて","しずめて"],["満足","まんぞく"],["する"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["憤り","いきどおり"],["を"],["全う","まっとう"],["する"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["熱心","ねっしん"],["に"],["語った","かたった"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":14,"text":"わたしは、あなたの回りの諸国の民の中で、通り過ぎるすべての者の目の前で、あなたを廃墟とし、そしりとする。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["回り","まわり"],["の"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["、"],["通り過ぎる","とおりすぎる"],["すべて"],["の"],["者","もの"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["あなた"],["を"],["廃墟","はいきょ"],["と"],["し"],["、"],["そしり"],["と"],["する"],["。"]]},{"verse":15,"text":"わたしが怒りと憤りと譴責とをもって、あなたにさばきを下すとき、あなたは回りの諸国の民のそしりとなり、ののしりとなり、戒め、恐れとなる。主であるわたしがこれを告げる。","tok":[["わたし"],["が"],["怒り","いかり"],["と"],["憤り","いきどおり"],["と"],["譴責","けんせき"],["と"],["を"],["もって"],["、"],["あなた"],["に"],["さばき"],["を"],["下す","くだす"],["とき"],["、"],["あなた"],["は"],["回り","まわり"],["の"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["そしり"],["と"],["なり"],["、"],["ののしり"],["と"],["なり"],["、"],["戒め","いましめ"],["、"],["恐れ","おそれ"],["と"],["なる"],["。"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["これ"],["を"],["告げる","つげる"],["。"]]},{"verse":16,"text":"わたしがひどいききんの矢をあなたがたに放つとき、あなたがたは滅びてしまおう。わたしがそれを放つのは、ききんをいっそうひどくして、あなたがたのパンのたくわえをなくし、あなたがたを滅ぼすためである。","tok":[["わたし"],["が"],["ひどい"],["ききん"],["の"],["矢","や"],["を"],["あなた"],["がた"],["に"],["放つ","はなつ"],["とき"],["、"],["あなた"],["がた"],["は"],["滅びて","ほろびて"],["しまおう"],["。"],["わたし"],["が"],["それ"],["を"],["放つ","はなつ"],["の"],["は"],["、"],["ききん"],["を"],["いっそう"],["ひどく"],["して"],["、"],["あなた"],["がた"],["の"],["パン"],["の"],["たくわえ"],["を"],["なくし"],["、"],["あなた"],["がた"],["を"],["滅ぼす","ほろぼす"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"わたしはあなたがたにききんと、悪い獣を送る。彼らはあなたに子を失わせる。疫病と虐殺とがあなたのうちに起こる。わたしはあなたに剣を臨ませる。主であるわたしがこれを告げる。」","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["ききん"],["と"],["、"],["悪い","わるい"],["獣","けもの"],["を"],["送る","おくる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["子","こ"],["を"],["失わせる","うしなわせる"],["。"],["疫病","やくびょう"],["と"],["虐殺","ぎゃくさつ"],["と"],["が"],["あなた"],["の"],["うち"],["に"],["起こる","おこる"],["。"],["わたし"],["は"],["あなた"],["に"],["剣","けん"],["を"],["臨ませる","のぞませる"],["。"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["これ"],["を"],["告げる","つげる"],["。"],["」"]]}]
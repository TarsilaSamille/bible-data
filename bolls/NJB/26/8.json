[{"verse":1,"text":"第六年の第六の月の五日、私が自分の家にすわっていて、ユダの長老たちも私の前にすわっていたとき、神である主の御手が私の上に下った。","tok":[["第","だい"],["六","ろく"],["年","ねん"],["の"],["第","だい"],["六","ろく"],["の"],["月","つき"],["の"],["五日","いつか"],["、"],["私","わたくし"],["が"],["自分","じぶん"],["の"],["家","いえ"],["に"],["すわって"],["いて"],["、"],["ユダ"],["の"],["長老","ちょうろう"],["たち"],["も"],["私","わたくし"],["の"],["前","まえ"],["に"],["すわって"],["いた"],["とき"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御手","おて"],["が"],["私","わたくし"],["の"],["上","うえ"],["に"],["下った","くだった"],["。"]]},{"verse":2,"text":"私が見ると、火のように見える姿があった。その腰と見える所から下のほうは火で、その腰から上のほうは青銅の輝きのように輝いて見えた。","tok":[["私","わたくし"],["が"],["見る","みる"],["と"],["、"],["火","ひ"],["の"],["よう"],["に"],["見える","みえる"],["姿","すがた"],["が"],["あった"],["。"],["その"],["腰","こし"],["と"],["見える","みえる"],["所","ところ"],["から"],["下","した"],["の"],["ほう"],["は"],["火","ひ"],["で"],["、"],["その"],["腰","こし"],["から"],["上","うえ"],["の"],["ほう"],["は"],["青銅","せいどう"],["の"],["輝き","かがやき"],["の"],["よう"],["に"],["輝いて","かがやいて"],["見えた","みえた"],["。"]]},{"verse":3,"text":"すると、その方は手の形をしたものを伸ばし、私の髪のふさをつかんだ。すると、霊が私を地と天との間に持ち上げ、神々しい幻のうちに私をエルサレムへ携え行き、ねたみを引き起こすねたみの偶像のある、北に面する内庭の門の入口に連れて行った。","tok":[["する"],["と"],["、"],["その"],["方","かた"],["は"],["手","て"],["の"],["形","かたち"],["を"],["した"],["もの"],["を"],["伸ばし","のばし"],["、"],["私","わたくし"],["の"],["髪","かみ"],["の"],["ふさ"],["を"],["つかんだ"],["。"],["する"],["と"],["、"],["霊","れい"],["が"],["私","わたくし"],["を"],["地","ち"],["と"],["天","てん"],["と"],["の"],["間","あいだ"],["に"],["持ち上げ","もちあげ"],["、"],["神々しい","こうごうしい"],["幻","まぼろし"],["の"],["うち"],["に"],["私","わたくし"],["を"],["エルサレム"],["へ"],["携え","たずさえ"],["行き","いき"],["、"],["ねたみ"],["を"],["引き起こす","ひきおこす"],["ねたみ"],["の"],["偶像","ぐうぞう"],["の"],["ある"],["、"],["北","きた"],["に"],["面する","めんする"],["内庭","うちにわ"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":4,"text":"なんと、そこには、私がかつて谷間で見た姿と同じようなイスラエルの神の栄光があった。","tok":[["なん"],["と"],["、"],["そこ"],["に"],["は"],["、"],["私","わたくし"],["が"],["かつて"],["谷間","たにま"],["で"],["見た","みた"],["姿","すがた"],["と"],["同じ","おなじ"],["よう"],["な"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["あった"],["。"]]},{"verse":5,"text":"その方は私に仰せられた。「人の子よ。さあ、目を上げて北のほうを見よ。」そこで、私が目を上げて北のほうを見ると、北のほうの祭壇の門の入口にねたみの偶像があった。","tok":[["その"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["さあ"],["、"],["目","め"],["を"],["上げて","あげて"],["北","きた"],["の"],["ほう"],["を"],["見よ","みよ"],["。"],["」"],["そこ"],["で"],["、"],["私","わたくし"],["が"],["目","め"],["を"],["上げて","あげて"],["北","きた"],["の"],["ほう"],["を"],["見る","みる"],["と"],["、"],["北","きた"],["の"],["ほう"],["の"],["祭壇","さいだん"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["ねたみ"],["の"],["偶像","ぐうぞう"],["が"],["あった"],["。"]]},{"verse":6,"text":"この方は私に仰せられた。「人の子よ。あなたは彼らのしていることが見えるか。イスラエルの家は、わたしの聖所から遠く離れようとして、ここで大きな忌みきらうべきことをしているではないか。あなたはなおまた、大きな忌みきらうべきことを見るだろう。」","tok":[["この"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["して"],["いる"],["こと"],["が"],["見える","みえる"],["か"],["。"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["から"],["遠く","とおく"],["離れよう","はなれよう"],["として"],["、"],["ここ"],["で"],["大きな","おおきな"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["して"],["いるで"],["は"],["ない"],["か"],["。"],["あなた"],["は"],["なお"],["また"],["、"],["大きな","おおきな"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["見るだろう","みるだろう"],["。"],["」"]]},{"verse":7,"text":"それから、この方は私を庭の入口に連れて行った。私が見ると、壁に一つの穴があった。","tok":[["それ"],["から"],["、"],["この"],["方","かた"],["は"],["私","わたくし"],["を"],["庭","にわ"],["の"],["入口","いりぐち"],["に"],["連れて","つれて"],["行った","いった"],["。"],["私","わたくし"],["が"],["見る","みる"],["と"],["、"],["壁","かべ"],["に"],["一","ひと"],["つ"],["の"],["穴","あな"],["が"],["あった"],["。"]]},{"verse":8,"text":"この方は私に仰せられた。「人の子よ。さあ、壁に穴をあけて通り抜けよ。」私が壁に穴をあけて通り抜けると、一つの入口があった。","tok":[["この"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["さあ"],["、"],["壁","かべ"],["に"],["穴","あな"],["を"],["あけて"],["通り抜け","とおりぬけ"],["よ"],["。"],["」"],["私","わたくし"],["が"],["壁","かべ"],["に"],["穴","あな"],["を"],["あけて"],["通り抜ける","とおりぬける"],["と"],["、"],["一","ひと"],["つ"],["の"],["入口","いりぐち"],["が"],["あった"],["。"]]},{"verse":9,"text":"この方は私に仰せられた。「入って行き、彼らがそこでしている悪い忌みきらうべきことを見よ。」","tok":[["この"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["入って","はいって"],["行き","いき"],["、"],["彼","かれ"],["ら"],["が"],["そこ"],["でして"],["いる"],["悪い","わるい"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["見よ","みよ"],["。"],["」"]]},{"verse":10,"text":"私が入って行って見ると、なんと、はうものや忌むべき獣のあらゆる像や、イスラエルの家のすべての偶像が、回りの壁一面に彫られていた。","tok":[["私","わたくし"],["が"],["入って","はいって"],["行って","いって"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["は"],["う"],["もの"],["や"],["忌むべき","いむべき"],["獣","けもの"],["の"],["あらゆる"],["像","ぞう"],["や"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["すべて"],["の"],["偶像","ぐうぞう"],["が"],["、"],["回り","まわり"],["の"],["壁","かべ"],["一面","いちめん"],["に"],["彫られて","ほられて"],["いた"],["。"]]},{"verse":11,"text":"また、イスラエルの家の七十人の長老が、その前に立っており、その中にはシャファンの子ヤアザヌヤも立っていて、彼らはみなその手に香炉を持ち、その香の濃い雲が立ち上っていた。","tok":[["また"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["七","なな"],["十人","じゅうにん"],["の"],["長老","ちょうろう"],["が"],["、"],["その"],["前","まえ"],["に"],["立って","たって"],["おり"],["、"],["その"],["中","なか"],["に"],["は"],["シャファン"],["の"],["子","こ"],["ヤアザヌヤ"],["も"],["立って","たって"],["いて"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["その"],["手","て"],["に"],["香炉","こうろ"],["を"],["持ち","もち"],["、"],["その"],["香","こう"],["の"],["濃い","こい"],["雲","くも"],["が"],["立ち上って","たちのぼって"],["いた"],["。"]]},{"verse":12,"text":"この方は私に仰せられた。「人の子よ。あなたは、イスラエルの家の長老たちがおのおの、暗い所、その石像の部屋で行っていることを見たか。彼らは、『主は私たちを見ておられない。主はこの国を見捨てられた』と言っている。」","tok":[["この"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["長老","ちょうろう"],["たち"],["が"],["おのおの"],["、"],["暗い","くらい"],["所","ところ"],["、"],["その"],["石像","せきぞう"],["の"],["部屋","へや"],["で"],["行って","いって"],["いる"],["こと"],["を"],["見た","みた"],["か"],["。"],["彼","かれ"],["ら"],["は"],["、"],["『"],["主","ぬし"],["は"],["私たち","わたしたち"],["を"],["見て","みて"],["おられない"],["。"],["主","ぬし"],["は"],["この"],["国","くに"],["を"],["見捨てられた","みすてられた"],["』"],["と"],["言って","いって"],["いる"],["。"],["」"]]},{"verse":13,"text":"さらに、私に仰せられた。「あなたはなおまた、彼らが行っている大きな忌みきらうべきことを見るだろう。」","tok":[["さらに"],["、"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["は"],["なお"],["また"],["、"],["彼","かれ"],["ら"],["が"],["行って","いって"],["いる"],["大きな","おおきな"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["見るだろう","みるだろう"],["。"],["」"]]},{"verse":14,"text":"ついでこの方は私を、主の宮の北の門の入口へ連れて行った。するとそこには、女たちがタンムズのために泣きながらすわっていた。","tok":[["ついで"],["この"],["方","かた"],["は"],["私","わたくし"],["を"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["北","きた"],["の"],["門","もん"],["の"],["入口","いりぐち"],["へ"],["連れて","つれて"],["行った","いった"],["。"],["する"],["と"],["そこ"],["に"],["は"],["、"],["女","おんな"],["たち"],["が"],["タンムズ"],["の"],["ため"],["に"],["泣き","なき"],["ながら"],["すわって"],["いた"],["。"]]},{"verse":15,"text":"この方は私に仰せられた。「人の子よ。これを見たであろうが、あなたはなおまた、これよりも大きな忌みきらうべきことを見るだろう。」","tok":[["この"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["これ"],["を"],["見たで","みたで"],["あろう"],["が"],["、"],["あなた"],["は"],["なお"],["また"],["、"],["これ"],["より"],["も"],["大きな","おおきな"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["見るだろう","みるだろう"],["。"],["」"]]},{"verse":16,"text":"そして、この方は私を主の宮の内庭に連れて行った。すると、主の宮の本堂の入口の玄関と祭壇との間に二十五人ばかりの人がおり、彼らは主の宮の本堂に背を向け、顔を東のほうに向けて、東のほうの太陽を拝んでいた。","tok":[["そして"],["、"],["この"],["方","かた"],["は"],["私","わたくし"],["を"],["主","ぬし"],["の"],["宮","みや"],["の"],["内庭","うちにわ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["する"],["と"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["本堂","ほんどう"],["の"],["入口","いりぐち"],["の"],["玄関","げんかん"],["と"],["祭壇","さいだん"],["と"],["の"],["間","あいだ"],["に"],["二十五人","にじゅうごにん"],["ばかり"],["の"],["人","ひと"],["が"],["おり"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["宮","みや"],["の"],["本堂","ほんどう"],["に"],["背","せ"],["を"],["向け","むけ"],["、"],["顔","かお"],["を"],["東","ひがし"],["の"],["ほう"],["に"],["向けて","むけて"],["、"],["東","ひがし"],["の"],["ほう"],["の"],["太陽","たいよう"],["を"],["拝んで","おがんで"],["いた"],["。"]]},{"verse":17,"text":"この方は私に仰せられた。「人の子よ。あなたはこれを見たか。ユダの家にとって、彼らがここでしているような忌みきらうべきことをするのは、ささいなことだろうか。彼らはこの地を暴虐で満たし、わたしの怒りをいっそう駆り立てている。見よ。彼らはぶどうのつるを自分たちの鼻にさしている。","tok":[["この"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["は"],["これ"],["を"],["見た","みた"],["か"],["。"],["ユダ"],["の"],["家","いえ"],["にとって"],["、"],["彼","かれ"],["ら"],["が"],["ここ"],["でして"],["いる"],["よう"],["な"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["する"],["の"],["は"],["、"],["ささい"],["な"],["こと"],["だろう"],["か"],["。"],["彼","かれ"],["ら"],["は"],["この"],["地","ち"],["を"],["暴虐","ぼうぎゃく"],["で"],["満たし","みたし"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["いっそう"],["駆り立てて","かりたてて"],["いる"],["。"],["見","み"],["よ"],["。"],["彼","かれ"],["ら"],["は"],["ぶどう"],["の"],["つる"],["を"],["自分","じぶん"],["たち"],["の"],["鼻","はな"],["に"],["さして"],["いる"],["。"]]},{"verse":18,"text":"だから、わたしも憤って事を行う。わたしは惜しまず、あわれまない。彼らがわたしの耳に大声で叫んでも、わたしは彼らの言うことを聞かない。」","tok":[["だ"],["から"],["、"],["わたし"],["も"],["憤って","いきどおって"],["事","こと"],["を"],["行う","おこなう"],["。"],["わたし"],["は"],["惜しまず","おしまず"],["、"],["あわれまない"],["。"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["耳","みみ"],["に"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞かない","きかない"],["。"],["」"]]}]
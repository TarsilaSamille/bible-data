[{"verse":1,"text":"彼は私を神殿の入口に連れ戻した。見ると、水が神殿の敷居の下から東のほうへと流れ出ていた。神殿が東に向いていたからである。その水は祭壇の南、宮の右側の下から流れていた。","tok":[["彼","かれ"],["は"],["私","わたくし"],["を"],["神殿","しんでん"],["の"],["入口","いりぐち"],["に"],["連れ戻した","つれもどした"],["。"],["見る","みる"],["と"],["、"],["水","みず"],["が"],["神殿","しんでん"],["の"],["敷居","しきい"],["の"],["下","した"],["から"],["東","ひがし"],["の"],["ほう"],["へ"],["と"],["流れ出て","ながれでて"],["いた"],["。"],["神殿","しんでん"],["が"],["東","ひがし"],["に"],["向いて","むいて"],["いた"],["から"],["で"],["ある"],["。"],["その"],["水","みず"],["は"],["祭壇","さいだん"],["の"],["南","みなみ"],["、"],["宮","みや"],["の"],["右側","みぎがわ"],["の"],["下","した"],["から"],["流れて","ながれて"],["いた"],["。"]]},{"verse":2,"text":"ついで、彼は私を北の門から連れ出し、外を回らせ、東向きの外の門に行かせた。見ると、水は右側から流れ出ていた。","tok":[["つい"],["で"],["、"],["彼","かれ"],["は"],["私","わたくし"],["を"],["北","きた"],["の"],["門","もん"],["から"],["連れ出し","つれだし"],["、"],["外","そと"],["を"],["回らせ","まわらせ"],["、"],["東向き","ひがしむき"],["の"],["外","そと"],["の"],["門","もん"],["に"],["行かせた","いかせた"],["。"],["見る","みる"],["と"],["、"],["水","みず"],["は"],["右側","みぎがわ"],["から"],["流れ出て","ながれでて"],["いた"],["。"]]},{"verse":3,"text":"その人は手に測りなわを持って東へ出て行き、一千キュビトを測り、私にその水を渡らせると、それは足首まであった。","tok":[["その"],["人","ひと"],["は"],["手","て"],["に"],["測り","はかり"],["なわ"],["を"],["持って","もって"],["東","ひがし"],["へ"],["出て","でて"],["行き","いき"],["、"],["一千","いちせん"],["キュビト"],["を"],["測り","はかり"],["、"],["私","わたくし"],["に"],["その"],["水","みず"],["を"],["渡らせる","わたらせる"],["と"],["、"],["それ"],["は"],["足首","あしくび"],["まで"],["あった"],["。"]]},{"verse":4,"text":"彼がさらに一千キュビトを測り、私にその水を渡らせると、水はひざに達した。彼がさらに一千キュビトを測り、私を渡らせると、水は腰に達した。","tok":[["彼","かれ"],["が"],["さらに"],["一千","いちせん"],["キュビト"],["を"],["測り","はかり"],["、"],["私","わたくし"],["に"],["その"],["水","みず"],["を"],["渡らせる","わたらせる"],["と"],["、"],["水","みず"],["は"],["ひざ"],["に"],["達した","たっした"],["。"],["彼","かれ"],["が"],["さらに"],["一千","いちせん"],["キュビト"],["を"],["測り","はかり"],["、"],["私","わたくし"],["を"],["渡らせる","わたらせる"],["と"],["、"],["水","みず"],["は"],["腰","こし"],["に"],["達した","たっした"],["。"]]},{"verse":5,"text":"彼がさらに一千キュビトを測ると、渡ることのできない川となった。水かさは増し、泳げるほどの水となり、渡ることのできない川となった。","tok":[["彼","かれ"],["が"],["さらに"],["一千","いちせん"],["キュビト"],["を"],["測る","はかる"],["と"],["、"],["渡る","わたる"],["こと"],["の"],["できない"],["川","かわ"],["と"],["なった"],["。"],["水かさ","みずかさ"],["は"],["増し","まし"],["、"],["泳げる","およげる"],["ほど"],["の"],["水","みず"],["と"],["なり"],["、"],["渡る","わたる"],["こと"],["の"],["できない"],["川","かわ"],["と"],["なった"],["。"]]},{"verse":6,"text":"彼は私に、「人の子よ。あなたはこれを見たか」と言って、私を川の岸に沿って連れ帰った。","tok":[["彼","かれ"],["は"],["私","わたくし"],["に"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["は"],["これ"],["を"],["見た","みた"],["か"],["」"],["と"],["言って","いって"],["、"],["私","わたくし"],["を"],["川","かわ"],["の"],["岸","きし"],["に"],["沿って","そって"],["連れ帰った","つれかえった"],["。"]]},{"verse":7,"text":"私が帰って来て見ると、川の両岸に非常に多くの木があった。","tok":[["私","わたくし"],["が"],["帰って","かえって"],["来て","きて"],["見る","みる"],["と"],["、"],["川","かわ"],["の"],["両岸","りょうがん"],["に"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["木","き"],["が"],["あった"],["。"]]},{"verse":8,"text":"彼は私に言った。「この水は東の地域に流れ、アラバに下り、海に入る。海に注ぎ込むとそこの水は良くなる。","tok":[["彼","かれ"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["この"],["水","みず"],["は"],["東","ひがし"],["の"],["地域","ちいき"],["に"],["流れ","ながれ"],["、"],["アラバ"],["に"],["下り","くだり"],["、"],["海","うみ"],["に"],["入る","はいる"],["。"],["海","うみ"],["に"],["注ぎ込む","そそぎこむ"],["と"],["そこ"],["の"],["水","みず"],["は"],["良く","よく"],["なる"],["。"]]},{"verse":9,"text":"この川が流れて行く所はどこででも、そこに群がるあらゆる生物は生き、非常に多くの魚がいるようになる。この水が入ると、そこの水が良くなるからである。この川が入る所では、すべてのものが生きる。","tok":[["この"],["川","かわ"],["が"],["流れて","ながれて"],["行く","いく"],["所","ところ"],["は"],["どこ"],["で"],["で"],["も"],["、"],["そこ"],["に"],["群がる","むらがる"],["あらゆる"],["生物","せいぶつ"],["は"],["生き","いき"],["、"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["魚","さかな"],["が"],["いる"],["よう"],["に"],["なる"],["。"],["この"],["水","みず"],["が"],["入る","はいる"],["と"],["、"],["そこ"],["の"],["水","みず"],["が"],["良く","よく"],["なる"],["から"],["で"],["ある"],["。"],["この"],["川","かわ"],["が"],["入る","はいる"],["所","ところ"],["で"],["は"],["、"],["すべて"],["の"],["もの"],["が"],["生きる","いきる"],["。"]]},{"verse":10,"text":"漁師たちはそのほとりに住みつき、エン・ゲディからエン・エグライムまで網を引く場所となる。そこの魚は大海の魚のように種類も数も非常に多くなる。","tok":[["漁師","りょうし"],["たち"],["は"],["その"],["ほとり"],["に"],["住みつき","すみつき"],["、"],["エン・ゲディ"],["から"],["エン"],["・"],["エグライム"],["まで"],["網","あみ"],["を"],["引く","ひく"],["場所","ばしょ"],["と"],["なる"],["。"],["そこ"],["の"],["魚","さかな"],["は"],["大海","たいかい"],["の"],["魚","さかな"],["の"],["よう"],["に"],["種類","しゅるい"],["も"],["数","すう"],["も"],["非常","ひじょう"],["に"],["多く","おおく"],["なる"],["。"]]},{"verse":11,"text":"しかし、その沢と沼とはその水が良くならないで、塩のままで残る。","tok":[["しかし"],["、"],["その"],["沢","さわ"],["と"],["沼","ぬま"],["と"],["は"],["その"],["水","みず"],["が"],["良く","よく"],["ならないで"],["、"],["塩","しお"],["の"],["まま"],["で"],["残る","のこる"],["。"]]},{"verse":12,"text":"川のほとり、その両岸には、あらゆる果樹が生長し、その葉も枯れず、実も絶えることがなく、毎月、新しい実をつける。その水が聖所から流れ出ているからである。その実は食物となり、その葉は薬となる。","tok":[["川","かわ"],["の"],["ほとり"],["、"],["その"],["両岸","りょうがん"],["に"],["は"],["、"],["あらゆる"],["果樹","かじゅ"],["が"],["生長","せいちょう"],["し"],["、"],["その"],["葉","は"],["も"],["枯れず","かれず"],["、"],["実","じつ"],["も"],["絶える","たえる"],["こと"],["が"],["なく"],["、"],["毎月","まいつき"],["、"],["新しい","あたらしい"],["実","じつ"],["を"],["つける"],["。"],["その"],["水","みず"],["が"],["聖","せい"],["所","しょ"],["から"],["流れ出て","ながれでて"],["いる"],["から"],["で"],["ある"],["。"],["その"],["実","じつ"],["は"],["食物","しょくもつ"],["と"],["なり"],["、"],["その"],["葉","は"],["は"],["薬","くすり"],["と"],["なる"],["。"]]},{"verse":13,"text":"神である主はこう仰せられる。あなたがたがイスラエルの十二の部族にこの国を相続地として与える地域は次のとおりである。ヨセフには二つの分を与える。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["が"],["イスラエル"],["の"],["十二","じゅうに"],["の"],["部族","ぶぞく"],["に"],["この"],["国","くに"],["を"],["相続","そうぞく"],["地","ち"],["として"],["与える","あたえる"],["地域","ちいき"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ヨセフ"],["に"],["は"],["二","ふた"],["つ"],["の"],["分","ぶん"],["を"],["与える","あたえる"],["。"]]},{"verse":14,"text":"あなたがたはそれを等分に割り当てなければならない。それはわたしがかつてあなたがたの先祖に与えると誓ったものである。この地は相続地としてあなたがたのものである。","tok":[["あなた"],["がた"],["は"],["それ"],["を"],["等分","とうぶん"],["に"],["割り当てなければ","わりあてなければ"],["ならない"],["。"],["それ"],["は"],["わたし"],["が"],["かつて"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["に"],["与える","あたえる"],["と"],["誓った","ちかった"],["もの"],["で"],["ある"],["。"],["この"],["地","ち"],["は"],["相続","そうぞく"],["地","ち"],["として"],["あなた"],["がた"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":15,"text":"その地の境界線は次のとおりである。北側は、大海からヘテロンの道を経て、ツェダデの入口に至り、","tok":[["その"],["地","ち"],["の"],["境界線","きょうかいせん"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["北側","きたがわ"],["は"],["、"],["大海","たいかい"],["から"],["ヘテロン"],["の"],["道","みち"],["を"],["経て","へて"],["、"],["ツェダデ"],["の"],["入口","いりぐち"],["に"],["至り","いたり"],["、"]]},{"verse":16,"text":"ハマテ、ベロタ、およびダマスコの領土とハマテの領土の間にあるシブライム、さらにハウランの領土に面したハツェル・ハティコンに至る。","tok":[["ハマテ"],["、"],["ベロタ"],["、"],["および"],["ダマスコ"],["の"],["領土","りょうど"],["と"],["ハマテ"],["の"],["領土","りょうど"],["の"],["間","あいだ"],["に"],["ある"],["シブライム"],["、"],["さらに"],["ハウラン"],["の"],["領土","りょうど"],["に"],["面した","めんした"],["ハツェル"],["・"],["ハティコン"],["に"],["至る","いたる"],["。"]]},{"verse":17,"text":"海から始まる境界線はダマスコの境界のハツァル・エナンに至り、北は北のほうへ、ハマテの境界にまで至る。これが北側である。","tok":[["海","うみ"],["から"],["始まる","はじまる"],["境界線","きょうかいせん"],["は"],["ダマスコ"],["の"],["境界","きょうかい"],["の"],["ハツァル"],["・"],["エナン"],["に"],["至り","いたり"],["、"],["北","きた"],["は"],["北","きた"],["の"],["ほう"],["へ"],["、"],["ハマテ"],["の"],["境界","きょうかい"],["に"],["まで"],["至る","いたる"],["。"],["これ"],["が"],["北側","きたがわ"],["で"],["ある"],["。"]]},{"verse":18,"text":"東側は、ハウランとダマスコの間と、ギルアデとイスラエルの地の間のヨルダン川が、東の海を経てタマルに至るまでの境界線である。これが東側である。","tok":[["東側","ひがしがわ"],["は"],["、"],["ハウラン"],["と"],["ダマスコ"],["の"],["間","あいだ"],["と"],["、"],["ギルアデ"],["と"],["イスラエル"],["の"],["地","ち"],["の"],["間","あいだ"],["の"],["ヨルダン"],["川","かわ"],["が"],["、"],["東","ひがし"],["の"],["海","うみ"],["を"],["経て","へて"],["タマル"],["に"],["至る","いたる"],["まで"],["の"],["境界線","きょうかいせん"],["で"],["ある"],["。"],["これ"],["が"],["東側","ひがしがわ"],["で"],["ある"],["。"]]},{"verse":19,"text":"南側は、タマルから南に向かってメリバテ・カデシュの水と川に至り、大海に至るまでである。これが南側である。","tok":[["南側","みなみがわ"],["は"],["、"],["タマル"],["から"],["南","みなみ"],["に"],["向かって","むかって"],["メリバテ"],["・"],["カデシュ"],["の"],["水","みず"],["と"],["川","かわ"],["に"],["至り","いたり"],["、"],["大海","たいかい"],["に"],["至る","いたる"],["まで"],["で"],["ある"],["。"],["これ"],["が"],["南側","みなみがわ"],["で"],["ある"],["。"]]},{"verse":20,"text":"西側は、大海が境界となり、レボ・ハマテにまで至る。これが西側である。","tok":[["西側","にしがわ"],["は"],["、"],["大海","たいかい"],["が"],["境界","きょうかい"],["と"],["なり"],["、"],["レボ"],["・"],["ハマテ"],["に"],["まで"],["至る","いたる"],["。"],["これ"],["が"],["西側","にしがわ"],["で"],["ある"],["。"]]},{"verse":21,"text":"あなたがたは、この地をイスラエルの部族ごとに割り当てなければならない。","tok":[["あなた"],["がた"],["は"],["、"],["この"],["地","ち"],["を"],["イスラエル"],["の"],["部族","ぶぞく"],["ごと"],["に"],["割り当てなければ","わりあてなければ"],["ならない"],["。"]]},{"verse":22,"text":"あなたがたと、あなたがたの間で子を生んだ、あなたがたの間の在留異国人とは、この地を自分たちの相続地として、くじで割り当てなければならない。あなたがたは彼らをイスラエル人のうちに生まれた者と同じように扱わなければならない。彼らはイスラエルの部族の中にあって、あなたがたといっしょに、くじで相続地の割り当てを受けなければならない。","tok":[["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["子","こ"],["を"],["生んだ","うんだ"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["の"],["在留","ざいりゅう"],["異国人","いこくにん"],["と"],["は"],["、"],["この"],["地","ち"],["を"],["自分","じぶん"],["たち"],["の"],["相続","そうぞく"],["地","ち"],["として"],["、"],["くじ"],["で"],["割り当てなければ","わりあてなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["を"],["イスラエル"],["人","にん"],["の"],["うち"],["に"],["生まれた","うまれた"],["者","もの"],["と"],["同じ","おなじ"],["よう"],["に"],["扱わなければ","あつかわなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["中","なか"],["に"],["あって"],["、"],["あなた"],["がた"],["と"],["いっしょ"],["に"],["、"],["くじ"],["で"],["相続","そうぞく"],["地","ち"],["の"],["割り当て","わりあて"],["を"],["受けなければ","うけなければ"],["ならない"],["。"]]},{"verse":23,"text":"在留異国人には、その在留している部族の中で、その相続地を与えなければならない。――神である主の御告げ――","tok":[["在留","ざいりゅう"],["異国人","いこくにん"],["に"],["は"],["、"],["その"],["在留","ざいりゅう"],["して"],["いる"],["部族","ぶぞく"],["の"],["中","なか"],["で"],["、"],["その"],["相続","そうぞく"],["地","ち"],["を"],["与えなければ","あたえなければ"],["ならない"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]}]
[{"verse":1,"text":"私たちが捕囚となって二十五年目の年の初め、その月の十日、町が占領されてから十四年目のちょうどその日、主の御手が私の上にあり、私をそこへ連れて行った。","tok":[["私たち","わたしたち"],["が"],["捕囚","ほしゅう"],["と"],["なって"],["二十五","にじゅうご"],["年目","ねんめ"],["の"],["年","とし"],["の"],["初め","はじめ"],["、"],["その"],["月","つき"],["の"],["十日","とうか"],["、"],["町","まち"],["が"],["占領","せんりょう"],["されて"],["から"],["十四","じゅうよん"],["年目","ねんめ"],["の"],["ちょうど"],["その"],["日","ひ"],["、"],["主","ぬし"],["の"],["御手","おて"],["が"],["私","わたくし"],["の"],["上","うえ"],["に"],["あり"],["、"],["私","わたくし"],["を"],["そこ"],["へ"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":2,"text":"すなわち、神々しい幻のうちに、私はイスラエルの地へ連れて行かれ、非常に高い山の上に降ろされた。その南のほうに町が建てられているようであった。","tok":[["すなわち"],["、"],["神々しい","こうごうしい"],["幻","まぼろし"],["の"],["うち"],["に"],["、"],["私","わたくし"],["は"],["イスラエル"],["の"],["地","ち"],["へ"],["連れて","つれて"],["行かれ","いかれ"],["、"],["非常","ひじょう"],["に"],["高い","たかい"],["山","やま"],["の"],["上","うえ"],["に"],["降ろされた","おろされた"],["。"],["その"],["南","みなみ"],["の"],["ほう"],["に"],["町","まち"],["が"],["建てられて","たてられて"],["いる"],["よう"],["で"],["あった"],["。"]]},{"verse":3,"text":"主が私をそこに連れて行かれると、そこに、ひとりの人がいた。その姿は青銅でできているようであり、その手に麻のひもと測りざおとを持って門のところに立っていた。","tok":[["主","ぬし"],["が"],["私","わたくし"],["を"],["そこ"],["に"],["連れて","つれて"],["行かれる","いかれる"],["と"],["、"],["そこ"],["に"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["いた"],["。"],["その"],["姿","すがた"],["は"],["青銅","せいどう"],["で"],["できて"],["いる"],["よう"],["で"],["あり"],["、"],["その"],["手","て"],["に"],["麻","あさ"],["の"],["ひも"],["と"],["測り","はかり"],["ざお"],["と"],["を"],["持って","もって"],["門","もん"],["の"],["ところ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":4,"text":"その人は私に話しかけた。「人の子よ。あなたの目で見、耳で聞き、わたしがあなたに見せるすべての事を心に留めよ。わたしがあなたを連れて来たのは、あなたにこれを見せるためだ。あなたが見ることをみな、イスラエルの家に告げよ。」","tok":[["その"],["人","ひと"],["は"],["私","わたくし"],["に"],["話しかけた","はなしかけた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["の"],["目","め"],["で"],["見","み"],["、"],["耳","みみ"],["で"],["聞き","きき"],["、"],["わたし"],["が"],["あなた"],["に"],["見せる","みせる"],["すべて"],["の"],["事","こと"],["を"],["心","こころ"],["に"],["留めよ","とめよ"],["。"],["わたし"],["が"],["あなた"],["を"],["連れて","つれて"],["来た","きた"],["の"],["は"],["、"],["あなた"],["に"],["これ"],["を"],["見せる","みせる"],["ため"],["だ"],["。"],["あなた"],["が"],["見る","みる"],["こと"],["を"],["みな"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["告げ","つげ"],["よ"],["。"],["」"]]},{"verse":5,"text":"そこに、神殿の外側を巡って取り囲んでいる壁があった。その人は手に六キュビトの測りざおを持っていた。その一キュビトは、普通の一キュビトに一手幅を足した長さであった。彼がその外壁の厚さを測ると、一さおであり、その高さも一さおであった。","tok":[["そこ"],["に"],["、"],["神殿","しんでん"],["の"],["外側","そとがわ"],["を"],["巡って","めぐって"],["取り囲んで","とりかこんで"],["いる"],["壁","かべ"],["が"],["あった"],["。"],["その"],["人","ひと"],["は"],["手","て"],["に"],["六","ろく"],["キュビト"],["の"],["測り","はかり"],["ざお"],["を"],["持って","もって"],["いた"],["。"],["その"],["一","いち"],["キュビト"],["は"],["、"],["普通","ふつう"],["の"],["一","いち"],["キュビト"],["に"],["一手","いって"],["幅","はば"],["を"],["足した","たした"],["長さ","ながさ"],["で"],["あった"],["。"],["彼","かれ"],["が"],["その"],["外壁","がいへき"],["の"],["厚","あつ"],["さ"],["を"],["測る","はかる"],["と"],["、"],["一","いち"],["さお"],["で"],["あり"],["、"],["その"],["高さ","たかさ"],["も"],["一","ひと"],["さお"],["で"],["あった"],["。"]]},{"verse":6,"text":"それから、彼が東向きの門に行き、その階段を上って、門の敷居を測ると、その幅は一さおで、もう一つの門の敷居も幅は一さおであった。","tok":[["それ"],["から"],["、"],["彼","かれ"],["が"],["東向き","ひがしむき"],["の"],["門","もん"],["に"],["行き","いき"],["、"],["その"],["階段","かいだん"],["を"],["上って","のぼって"],["、"],["門","もん"],["の"],["敷居","しきい"],["を"],["測る","はかる"],["と"],["、"],["その"],["幅","はば"],["は"],["一","いち"],["さお"],["で"],["、"],["もう"],["一","ひと"],["つ"],["の"],["門","もん"],["の"],["敷居","しきい"],["も"],["幅","はば"],["は"],["一","いち"],["さお"],["で"],["あった"],["。"]]},{"verse":7,"text":"控え室は長さ一さお、幅一さおであり、控え室と控え室の間は五キュビトであった。門の内側の玄関の間に続く門の敷居は一さおであった。","tok":[["控え室","ひかえしつ"],["は"],["長さ","ながさ"],["一","いち"],["さお"],["、"],["幅","はば"],["一","ひと"],["さお"],["で"],["あり"],["、"],["控え室","ひかえしつ"],["と"],["控え室","ひかえしつ"],["の"],["間","あいだ"],["は"],["五","ご"],["キュビト"],["で"],["あった"],["。"],["門","もん"],["の"],["内側","うちがわ"],["の"],["玄関","げんかん"],["の"],["間","あいだ"],["に"],["続く","つづく"],["門","もん"],["の"],["敷居","しきい"],["は"],["一","いち"],["さお"],["で"],["あった"],["。"]]},{"verse":8,"text":"彼が門の内側の玄関の間を測ると、一さお、","tok":[["彼","かれ"],["が"],["門","もん"],["の"],["内側","うちがわ"],["の"],["玄関","げんかん"],["の"],["間","あいだ"],["を"],["測る","はかる"],["と"],["、"],["一","いち"],["さお"],["、"]]},{"verse":9,"text":"すなわち、門の玄関の間を測ると、八キュビト、その壁柱は二キュビトで、門の玄関の間は内側にあった。","tok":[["すなわち"],["、"],["門","もん"],["の"],["玄関","げんかん"],["の"],["間","あいだ"],["を"],["測る","はかる"],["と"],["、"],["八","はち"],["キュビト"],["、"],["その"],["壁柱","かべばしら"],["は"],["二","に"],["キュビト"],["で"],["、"],["門","もん"],["の"],["玄関","げんかん"],["の"],["間","あいだ"],["は"],["内側","うちがわ"],["に"],["あった"],["。"]]},{"verse":10,"text":"東のほうにある門の控え室は両側に三つずつあり、三つとも同じ寸法であった。壁柱も、両側とも、同じ寸法であった。","tok":[["東","ひがし"],["の"],["ほう"],["に"],["ある"],["門","もん"],["の"],["控え室","ひかえしつ"],["は"],["両側","りょうがわ"],["に"],["三","みっ"],["つ"],["ずつ"],["あり"],["、"],["三","みっ"],["つ"],["とも"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["あった"],["。"],["壁柱","かべばしら"],["も"],["、"],["両側","りょうがわ"],["とも"],["、"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["あった"],["。"]]},{"verse":11,"text":"彼が門の入口の幅を測ると、十キュビト、門の内のり幅の長さは十三キュビトであった。","tok":[["彼","かれ"],["が"],["門","もん"],["の"],["入口","いりぐち"],["の"],["幅","はば"],["を"],["測る","はかる"],["と"],["、"],["十","じゅう"],["キュビト"],["、"],["門","もん"],["の"],["内のり","うちのり"],["幅","はば"],["の"],["長さ","ながさ"],["は"],["十三","じゅうさん"],["キュビト"],["で"],["あった"],["。"]]},{"verse":12,"text":"控え室の前に出た仕切りは両側ともそれぞれ一キュビトであった。控え室は両側とも六キュビトであった。","tok":[["控え室","ひかえしつ"],["の"],["前","まえ"],["に"],["出た","でた"],["仕切り","しきり"],["は"],["両側","りょうがわ"],["とも"],["それぞれ"],["一","いち"],["キュビト"],["で"],["あった"],["。"],["控え室","ひかえしつ"],["は"],["両側","りょうがわ"],["とも"],["六","ろく"],["キュビト"],["で"],["あった"],["。"]]},{"verse":13,"text":"彼がその門を、片側の控え室の屋根の端から他の側の屋根の端まで測ると、一つの入口から他の入口までの幅は二十五キュビトであった。","tok":[["彼","かれ"],["が"],["その"],["門","もん"],["を"],["、"],["片側","かたがわ"],["の"],["控え室","ひかえしつ"],["の"],["屋根","やね"],["の"],["端","はし"],["から"],["他","ほか"],["の"],["側","がわ"],["の"],["屋根","やね"],["の"],["端","はし"],["まで"],["測る","はかる"],["と"],["、"],["一","ひと"],["つ"],["の"],["入口","いりぐち"],["から"],["他","ほか"],["の"],["入口","いりぐち"],["まで"],["の"],["幅","はば"],["は"],["二十五","にじゅうご"],["キュビト"],["で"],["あった"],["。"]]},{"verse":14,"text":"彼は壁柱を六十キュビトとした。門の周囲を巡る壁柱は庭に面していた。","tok":[["彼","かれ"],["は"],["壁柱","かべばしら"],["を"],["六十","ろくじゅう"],["キュビト"],["と"],[
[{"verse":1,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。預言をしているイスラエルの預言者どもに対して預言せよ。自分の心のままに預言する者どもに向かって、主のことばを聞けと言え。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["預言","よげん"],["を"],["して"],["いる"],["イスラエル"],["の"],["預言者","よげんしゃ"],["ども"],["に対して","にたいして"],["預言","よげん"],["せよ"],["。"],["自分","じぶん"],["の"],["心","こころ"],["の"],["まま"],["に"],["預言","よげん"],["する"],["者","もの"],["ども"],["に"],["向かって","むかって"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["と"],["言え","いえ"],["。"]]},{"verse":3,"text":"神である主はこう仰せられる。自分で何も見ないのに、自分の霊に従う愚かな預言者どもにわざわいが来る。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["自分","じぶん"],["で"],["何","なん"],["も"],["見ない","みない"],["のに"],["、"],["自分","じぶん"],["の"],["霊","れい"],["に"],["従う","したがう"],["愚か","おろか"],["な"],["預言者","よげんしゃ"],["ども"],["に"],["わざわい"],["が"],["来る","くる"],["。"]]},{"verse":4,"text":"イスラエルよ。あなたの預言者どもは、廃墟にいる狐のようだ。","tok":[["イスラエル"],["よ"],["。"],["あなた"],["の"],["預言者","よげんしゃ"],["ども"],["は"],["、"],["廃墟","はいきょ"],["に"],["いる"],["狐","きつね"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"あなたがたは、主の日に、戦いに耐えるために、破れ口を修理もせず、イスラエルの家の石垣も築かなかった。","tok":[["あなた"],["がた"],["は"],["、"],["主","ぬし"],["の"],["日","ひ"],["に"],["、"],["戦い","たたかい"],["に"],["耐える","たえる"],["ため"],["に"],["、"],["破れ","やぶれ"],["口","くち"],["を"],["修理","しゅうり"],["も"],["せず"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["石垣","いしがき"],["も"],["築かなかった","きずかなかった"],["。"]]},{"verse":6,"text":"彼らはむなしい幻を見、まやかしの占いをして、『主の御告げ』と言っている。主が彼らを遣わされないのに。しかも、彼らはそのことが成就するのを待ち望んでいる。","tok":[["彼","かれ"],["ら"],["は"],["むなしい"],["幻","まぼろし"],["を"],["見","み"],["、"],["まやかし"],["の"],["占い","うらない"],["を"],["して"],["、"],["『"],["主","ぬし"],["の"],["御告げ","おつげ"],["』"],["と"],["言って","いって"],["いる"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["遣わされない","つかわされない"],["のに"],["。"],["しかも"],["、"],["彼","かれ"],["ら"],["は"],["その"],["こと"],["が"],["成就","じょうじゅ"],["する"],["の"],["を"],["待ち望んで","まちのぞんで"],["いる"],["。"]]},{"verse":7,"text":"あなたがたはむなしい幻を見、まやかしの占いをしていたではないか。わたしが語りもしないのに『主の御告げ』と言っている。","tok":[["あなた"],["がた"],["は"],["むなしい"],["幻","まぼろし"],["を"],["見","み"],["、"],["まやかし"],["の"],["占い","うらない"],["を"],["して"],["いたで"],["は"],["ない"],["か"],["。"],["わたし"],["が"],["語り","かたり"],["も"],["しない"],["のに"],["『"],["主","ぬし"],["の"],["御告げ","おつげ"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":8,"text":"それゆえ、神である主はこう仰せられる。あなたがたは、むなしいことを語り、まやかしの幻を見ている。それゆえ今、わたしはあなたがたに立ち向かう。――神である主の御告げ――","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["がた"],["は"],["、"],["むなしい"],["こと"],["を"],["語り","かたり"],["、"],["まやかし"],["の"],["幻","まぼろし"],["を"],["見て","みて"],["いる"],["。"],["それ"],["ゆえ"],["今","いま"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["立ち向かう","たちむかう"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":9,"text":"わたしは、むなしい幻を見、まやかしの占いをしている預言者どもに手を下す。彼らはわたしの民の交わりに加えられず、イスラエルの家の籍にも入れられない。イスラエルの地にも入ることができない。このとき、あなたがたは、わたしが神、主であることを知ろう。","tok":[["わたし"],["は"],["、"],["むなしい"],["幻","まぼろし"],["を"],["見","み"],["、"],["まやかし"],["の"],["占い","うらない"],["を"],["して"],["いる"],["預言者","よげんしゃ"],["ども"],["に"],["手","て"],["を"],["下す","くだす"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["の"],["交わり","まじわり"],["に"],["加えられず","くわえられず"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["籍","せき"],["に"],["も"],["入れられない","いれられない"],["。"],["イスラエル"],["の"],["地","ち"],["に"],["も"],["入る","はいる"],["こと"],["が"],["できない"],["。"],["この"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":10,"text":"実に、彼らは、平安がないのに『平安』と言って、わたしの民を惑わし、壁を建てると、すぐ、それをしっくいで上塗りしてしまう。","tok":[["実","じつ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["、"],["平安","へいあん"],["が"],["ない"],["のに"],["『"],["平安","へいあん"],["』"],["と"],["言って","いって"],["、"],["わたし"],["の"],["民","たみ"],["を"],["惑わし","まどわし"],["、"],["壁","かべ"],["を"],["建てる","たてる"],["と"],["、"],["すぐ"],["、"],["それ"],["を"],["しっくい"],["で"],["上塗り","うわぬり"],["して"],["しまう"],["。"]]},{"verse":11,"text":"しっくいで上塗りする者どもに言え。『それは、すぐはげ落ちる。』大雨が降り注ぎ、わたしが雹を降らせ、激しい風を吹きつける。","tok":[["しっくい"],["で"],["上塗り","うわぬり"],["する"],["者","もの"],["ども"],["に"],["言え","いえ"],["。"],["『"],["それ"],["は"],["、"],["すぐ"],["はげ落ちる","はげおちる"],["。"],["』"],["大雨","おおあめ"],["が"],["降り注ぎ","ふりそそぎ"],["、"],["わたし"],["が"],["雹","ひょう"],["を"],["降らせ","ふらせ"],["、"],["激しい","はげしい"],["風","かぜ"],["を"],["吹きつける","ふきつける"],["。"]]},{"verse":12,"text":"すると、壁が倒れ落ちる。人々はあなたがたに向かって、『上塗りしたしっくいはどこにあるのか』と言わないだろうか。","tok":[["する"],["と"],["、"],["壁","かべ"],["が"],["倒れ落ちる","たおれおちる"],["。"],["人々","ひとびと"],["は"],["あなた"],["がた"],["に"],["向かって","むかって"],["、"],["『"],["上塗り","うわぬり"],["した"],["しっくい"],["は"],["どこ"],["に"],["ある"],["の"],["か"],["』"],["と"],["言わないだろう","いわないだろう"],["か"],["。"]]},{"verse":13,"text":"それゆえ、神である主はこう仰せられる。わたしは、憤って激しい風を吹きつけ、怒って大雨を降り注がせ、憤って雹を降らせて、こわしてしまう。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["、"],["憤って","いきどおって"],["激しい","はげしい"],["風","かぜ"],["を"],["吹きつけ","ふきつけ"],["、"],["怒って","おこって"],["大雨","おおあめ"],["を"],["降り注がせ","ふりそそがせ"],["、"],["憤って","いきどおって"],["雹","ひょう"],["を"],["降らせて","ふらせて"],["、"],["こわして"],["しまう"],["。"]]},{"verse":14,"text":"あなたがたがしっくいで上塗りした壁を、わたしが打ちこわし、地に倒してしまうので、その土台までもあばかれてしまう。それが倒れ落ちて、あなたがたがその中で滅びるとき、あなたがたは、わたしが主であることを知ろう。","tok":[["あなた"],["がた"],["が"],["しっくい"],["で"],["上塗り","うわぬり"],["した"],["壁","かべ"],["を"],["、"],["わたし"],["が"],["打ちこわし","うちこわし"],["、"],["地","ち"],["に"],["倒して","たおして"],["しまう"],["ので"],["、"],["その"],["土台","どだい"],["まで"],["も"],["あばかれて"],["しまう"],["。"],["それ"],["が"],["倒れ","たおれ"],["落ちて","おちて"],["、"],["あなた"],["がた"],["が"],["その"],["中","なか"],["で"],["滅びる","ほろびる"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":15,"text":"わたしは、その壁と、それをしっくいで上塗りした者どもへのわたしの憤りを全うして、あなたがたに言う。壁もなくなり、それにしっくいを塗った者どもも、いなくなった。","tok":[["わたし"],["は"],["、"],["その"],["壁","かべ"],["と"],["、"],["それ"],["を"],["しっくい"],["で"],["上塗り","うわぬり"],["した"],["者","もの"],["ども"],["へ"],["の"],["わたし"],["の"],["憤り","いきどおり"],["を"],["全う","まっとう"],["して"],["、"],["あなた"],["がた"],["に"],["言う","ゆう"],["。"],["壁","かべ"],["も"],["なくなり"],["、"],["それ"],["に"],["しっくい"],["を"],["塗った","ぬった"],["者","もの"],["ども"],["も"],["、"],["いなく"],["なった"],["。"]]},{"verse":16,"text":"エルサレムについて預言し、平安がないのに平安の幻を見ていたイスラエルの預言者どもよ。――神である主の御告げ――","tok":[["エルサレム"],["について"],["預言","よげん"],["し"],["、"],["平安","へいあん"],["が"],["ない"],["のに"],["平安","へいあん"],["の"],["幻","まぼろし"],["を"],["見て","みて"],["いた"],["イスラエル"],["の"],["預言者","よげんしゃ"],["ども"],["よ"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":17,"text":"人の子よ。自分の心のままに預言するあなたの民の娘たちに、あなたの顔を向け、彼らに預言して、","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["自分","じぶん"],["の"],["心","こころ"],["の"],["まま"],["に"],["預言","よげん"],["する"],["あなた"],["の"],["民","たみ"],["の"],["娘","むすめ"],["たち"],["に"],["、"],["あなた"],["の"],["顔","かお"],["を"],["向け","むけ"],["、"],["彼","かれ"],["ら"],["に"],["預言","よげん"],["して"],["、"]]},{"verse":18,"text":"言え。神である主はこう仰せられる。みなの手首に呪法のひもを縫い合わせ、あらゆる高さの頭に合うようにベールを作って、人々をわなにかける女たちにわざわいが来る。あなたがたは、わたしの民である人々をわなにかけて、自分たちのために人々を生かしているのだ。","tok":[["言え","いえ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["みな"],["の"],["手首","てくび"],["に"],["呪法","じゅほう"],["の"],["ひも"],["を"],["縫い合わせ","ぬいあわせ"],["、"],["あらゆる"],["高さ","たかさ"],["の"],["頭","あたま"],["に"],["合う","あう"],["よう"],["に"],["ベール"],["を"],["作って","つくって"],["、"],["人々","ひとびと"],["を"],["わな"],["に"],["かける"],["女","おんな"],["たち"],["に"],["わざわい"],["が"],["来る","くる"],["。"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["民","たみ"],["で"],["ある"],["人々","ひとびと"],["を"],["わな"],["に"],["かけて"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["人々","ひとびと"],["を"],["生かして","いかして"],["いる"],["の"],["だ"],["。"]]},{"verse":19,"text":"あなたがたは、ひとつかみの大麦のため、少しばかりのパンのために、まやかしに聞き従うわたしの民にまやかしを行い、死んではならない者たちを死なせ、生きてはならない者たちを生かして、わたしの民のうちでわたしを汚した。","tok":[["あなた"],["がた"],["は"],["、"],["ひとつかみ"],["の"],["大麦","おおむぎ"],["の"],["ため"],["、"],["少し","すこし"],["ばかり"],["の"],["パン"],["の"],["ため"],["に"],["、"],["まやかし"],["に"],["聞き従う","ききしたがう"],["わたし"],["の"],["民","たみ"],["に"],["まやかし"],["を"],["行い","おこない"],["、"],["死んで","しんで"],["は"],["ならない"],["者","もの"],["たち"],["を"],["死なせ","しなせ"]
[{"verse":1,"text":"第十二年の第十二の月の一日、私に次のような主のことばがあった。","tok":[["第","だい"],["十二","じゅうに"],["年","ねん"],["の"],["第","だい"],["十二","じゅうに"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。エジプトの王パロについて哀歌を唱えて彼に言え。／諸国の民の若い獅子よ。／あなたは滅びうせた。／あなたは海の中のわにのようだ。／川の中であばれ回り、足で水をかき混ぜ、その川々を濁らせた。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["エジプト"],["の"],["王","おう"],["パロ"],["について"],["哀歌","あいか"],["を"],["唱えて","となえて"],["彼","かれ"],["に"],["言え","いえ"],["。"],["／"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["若い","わかい"],["獅子","しし"],["よ"],["。"],["／"],["あなた"],["は"],["滅び","ほろび"],["うせた"],["。"],["／"],["あなた"],["は"],["海","うみ"],["の"],["中","なか"],["の"],["わに"],["の"],["よう"],["だ"],["。"],["／"],["川","かわ"],["の"],["中","なか"],["で"],["あばれ"],["回り","まわり"],["、"],["足","あし"],["で"],["水","みず"],["を"],["かき混ぜ","かきまぜ"],["、"],["その"],["川","かわ"],["々"],["を"],["濁らせた","にごらせた"],["。"]]},{"verse":3,"text":"神である主はこう仰せられる。／わたしは、多くの国々の民の集団を集めて、あなたの上にわたしの網を打ちかけ、彼らはあなたを地引き網で引き上げる。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["わたし"],["は"],["、"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["集団","しゅうだん"],["を"],["集めて","あつめて"],["、"],["あなた"],["の"],["上","うえ"],["に"],["わたし"],["の"],["網","あみ"],["を"],["打ち","うち"],["かけ"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["を"],["地引き網","じびきあみ"],["で"],["引き上げる","ひきあげる"],["。"]]},{"verse":4,"text":"わたしは、あなたを地に投げ捨て、野に放り出し、空のあらゆる鳥をあなたの上に止まらせ、全地の獣をあなたで飽かせよう。","tok":[["わたし"],["は"],["、"],["あなた"],["を"],["地","ち"],["に"],["投げ捨て","なげすて"],["、"],["野","の"],["に"],["放り出し","ほうりだし"],["、"],["空","そら"],["の"],["あらゆる"],["鳥","とり"],["を"],["あなた"],["の"],["上","うえ"],["に"],["止まらせ","とまらせ"],["、"],["全地","ぜんち"],["の"],["獣","けもの"],["を"],["あなた"],["で"],["飽かせよう","あかせよう"],["。"]]},{"verse":5,"text":"あなたの肉を山々に捨て、あなたのしかばねで谷を満たし、","tok":[["あなた"],["の"],["肉","にく"],["を"],["山々","やまやま"],["に"],["捨て","すて"],["、"],["あなた"],["の"],["しかばね"],["で"],["谷","たに"],["を"],["満たし","みたし"],["、"]]},{"verse":6,"text":"あなたから流れ出る血で地を浸し、その血で山々を潤す。／谷川もあなたの血で満たされる。","tok":[["あなた"],["から"],["流れ出る","ながれでる"],["血","ち"],["で"],["地","ち"],["を"],["浸し","ひたし"],["、"],["その"],["血","ち"],["で"],["山々","やまやま"],["を"],["潤す","うるおす"],["。"],["／"],["谷川","たにがわ"],["も"],["あなた"],["の"],["血","ち"],["で"],["満たされる","みたされる"],["。"]]},{"verse":7,"text":"あなたが滅び去るとき、わたしは空をおおい、星を暗くし、太陽を雲で隠し、月に光を放たせない。","tok":[["あなた"],["が"],["滅び去る","ほろびさる"],["とき"],["、"],["わたし"],["は"],["空","そら"],["を"],["おおい"],["、"],["星","ほし"],["を"],["暗く","くらく"],["し"],["、"],["太陽","たいよう"],["を"],["雲","くも"],["で"],["隠し","かくし"],["、"],["月","つき"],["に"],["光","ひかり"],["を"],["放たせない","はなたせない"],["。"]]},{"verse":8,"text":"わたしは空に輝くすべての光を／あなたの上で暗くし、あなたの地をやみでおおう。／――神である主の御告げ――","tok":[["わたし"],["は"],["空","そら"],["に"],["輝く","かがやく"],["すべて"],["の"],["光","ひかり"],["を"],["／"],["あなた"],["の"],["上","うえ"],["で"],["暗く","くらく"],["し"],["、"],["あなた"],["の"],["地","ち"],["を"],["やみ"],["で"],["おおう"],["。"],["／"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":9,"text":"わたしが、諸国の民、あなたの知らない国々の中であなたの破滅をもたらすとき、わたしは多くの国々の民の心を痛ませる。","tok":[["わたし"],["が"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["、"],["あなた"],["の"],["知らない","しらない"],["国々","くにぐに"],["の"],["中","なか"],["で"],["あなた"],["の"],["破滅","はめつ"],["を"],["もたらす"],["とき"],["、"],["わたし"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["心","こころ"],["を"],["痛ませる","いたませる"],["。"]]},{"verse":10,"text":"わたしは多くの国々の民をあなたのことでおののかせる。彼らの王たちも、わたしが彼らの前でわたしの剣を振りかざすとき、あなたのことでおぞ気立つ。あなたのくずれ落ちる日に、彼らはみな、自分のいのちを思って身震いし続ける。","tok":[["わたし"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["あなた"],["の"],["こと"],["で"],["おののかせる"],["。"],["彼","かれ"],["ら"],["の"],["王","おう"],["たち"],["も"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["わたし"],["の"],["剣","けん"],["を"],["振りかざす","ふりかざす"],["とき"],["、"],["あなた"],["の"],["こと"],["で"],["お"],["ぞ"],["気","き"],["立つ","たつ"],["。"],["あなた"],["の"],["くずれ落ちる","くずれおちる"],["日","ひ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["自分","じぶん"],["の"],["いのち"],["を"],["思って","おもって"],["身震い","みぶるい"],["し"],["続ける","つづける"],["。"]]},{"verse":11,"text":"まことに、神である主はこう仰せられる。／バビロンの王の剣があなたに下る。","tok":[["まこと"],["に"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["バビロン"],["の"],["王","おう"],["の"],["剣","けん"],["が"],["あなた"],["に"],["下る","くだる"],["。"]]},{"verse":12,"text":"わたしは勇士の剣で、あなたの群集を倒す。／彼らはみな最も横暴な異邦の民だ。／彼らはエジプトの誇りを踏みにじり、その群集はみな滅ぼされる。","tok":[["わたし"],["は"],["勇士","ゆうし"],["の"],["剣","けん"],["で"],["、"],["あなた"],["の"],["群集","ぐんしゅう"],["を"],["倒す","たおす"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["最も","もっとも"],["横暴","おうぼう"],["な"],["異邦","いほう"],["の"],["民","たみ"],["だ"],["。"],["／"],["彼","かれ"],["ら"],["は"],["エジプト"],["の"],["誇り","ほこり"],["を"],["踏みにじり","ふみにじり"],["、"],["その"],["群集","ぐんしゅう"],["は"],["みな"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":13,"text":"わたしはあらゆる家畜を、豊かな水のほとりで滅ぼす。／人の足は二度とこれを濁さず、家畜のひづめも、これを濁さない。","tok":[["わたし"],["は"],["あらゆる"],["家畜","かちく"],["を"],["、"],["豊か","ゆたか"],["な"],["水","みず"],["の"],["ほとり"],["で"],["滅ぼす","ほろぼす"],["。"],["／"],["人","ひと"],["の"],["足","あし"],["は"],["二","に"],["度","ど"],["と"],["これ"],["を"],["濁さず","にごさず"],["、"],["家畜","かちく"],["の"],["ひづめ"],["も"],["、"],["これ"],["を"],["濁さない","にごさない"],["。"]]},{"verse":14,"text":"そのとき、わたしはこの水を静める。／その川を油のように静かに流れさせる。／――神である主の御告げ――","tok":[["その"],["とき"],["、"],["わたし"],["は"],["この"],["水","みず"],["を"],["静める","しずめる"],["。"],["／"],["その"],["川","かわ"],["を"],["油","あぶら"],["の"],["よう"],["に"],["静か","しずか"],["に"],["流れさせる","ながれさせる"],["。"],["／"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":15,"text":"わたしがエジプトの国を荒れ果てさせ、この国にある物がみなはぎ取られ、わたしがそこの住民をみな打ち破るとき、彼らは、わたしが主であることを知ろう。","tok":[["わたし"],["が"],["エジプト"],["の"],["国","くに"],["を"],["荒れ果てさせ","あれはてさせ"],["、"],["この"],["国","くに"],["に"],["ある"],["物","もの"],["が"],["みな"],["はぎ取られ","はぎとられ"],["、"],["わたし"],["が"],["そこ"],["の"],["住民","じゅうみん"],["を"],["みな"],["打ち破る","うちやぶる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":16,"text":"これは人々が悲しんで歌う哀歌である。諸国の民の娘たちはこれを悲しんで歌う。エジプトとそのすべての群集のために、彼女らはこの哀歌を悲しんで歌う。――神である主の御告げ――」","tok":[["これ"],["は"],["人々","ひとびと"],["が"],["悲しんで","かなしんで"],["歌う","うたう"],["哀歌","あいか"],["で"],["ある"],["。"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["娘","むすめ"],["たち"],["は"],["これ"],["を"],["悲しんで","かなしんで"],["歌う","うたう"],["。"],["エジプト"],["と"],["その"],["すべて"],["の"],["群集","ぐんしゅう"],["の"],["ため"],["に"],["、"],["彼女","かのじょ"],["ら"],["は"],["この"],["哀歌","あいか"],["を"],["悲しんで","かなしんで"],["歌う","うたう"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":17,"text":"第十二年の第一の月の十五日、私に次のような主のことばがあった。","tok":[["第","だい"],["十二","じゅうに"],["年","ねん"],["の"],["第","だい"],["一","いち"],["の"],["月","つき"],["の"],["十五","じゅうご"],["日","にち"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":18,"text":"「人の子よ。エジプトの群集のために嘆け。／その民と強国の民の娘たちとを、穴に下る者たちとともに地下の国に下らせよ。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["エジプト"],["の"],["群集","ぐんしゅう"],["の"],["ため"],["に"],["嘆け","なげけ"],["。"],["／"],["その"],["民","たみ"],["と"],["強国","きょうこく"],["の"],["民","たみ"],["の"],["娘","むすめ"],["たち"],["と"],["を"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["とも"],["に"],["地下","ちか"],["の"],["国","くに"],["に"],["下らせ","くだらせ"],["よ"],["。"]]},{"verse":19,"text":"『あなたはだれよりもすぐれているのか。／下って行って、割礼を受けていない者たちとともに横たわれ。』","tok":[["『"],["あなた"],["は"],["だれ"],["より"],["も"],["すぐれて"],["いる"],["の"],["か"],["。"],["／"],["下って","くだって"],["行って","いって"],["、"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["者","もの"],["たち"],["と"],["とも"],["に"],["横たわれ","よこたわれ"],["。"],["』"]]},{"verse":20,"text":"その国は剣に渡され、彼らは剣で刺し殺された者たちの間に倒れる。その国とそのすべての群集を引きずり降ろせ。","tok":[["その"],["国","くに"],["は"],["剣","けん"],["に"],["渡され","わたされ"],["、"],["彼","かれ"],["ら"],["は"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["たち"],["の"],["間","あいだ"],["に"],["倒れる","たおれる"],["。"],["その"],["国","くに"],["と"],["その"],["すべて"],["の"],["群集","ぐんしゅう"],["を"],["引きずり","ひきずり"],["降ろせ","おろせ"],["。"]]},{"verse":21,"text":"勇敢な勇士たちは、その国を助けた者たちとともに、よみの中から語りかける。『降りて来て、剣で刺し殺された者、割礼を受けていない者たちとともに横たわれ』と。","tok":[["勇敢","ゆうかん"],["な"],["勇士","ゆうし"],["たち"],["は"],["、"],["その"],["国","くに"],["を"],["助けた","たすけた"],["者","もの"],["たち"],["と"],["とも"],["に"],["、"],["よみ"],["の"],["中","なか"],["から"],["語りかける","かたりかける"],["。"],["『"],["降りて","おりて"],["来て","きて"],["、"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["、"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["者","もの"],["たち"],["と"],["とも"],["に"],["横たわれ","よこたわれ"],["』"],["と"],["。"]]},{"verse":22,"text":"その墓の回りには、アッシリヤとその全集団がいる。みな、刺し殺された者、剣に倒れた者たちである。","tok":[["その"],["墓","はか"],["の"],["回り","まわり"],["に"],["は"],["、"],["アッシリヤ"],["と"],["その"],["全","ぜん"],["集団","しゅうだん"],["が"],["いる"],["。"],["みな"],["、"],["刺し殺された","さしころされた"],["者","もの"],["、"],["剣","けん"],["に"],["倒れた","たおれた"],["者","もの"],["たち"],["で"],["ある"],["。"]]},{"verse":23,"text":"彼らの墓は穴の奥のほうにあり、その集団はその墓の回りにいる。彼らはみな、刺し殺された者、剣に倒れた者、かつて生ける者の地で恐怖を巻き起こした者たちである。","tok":[["彼","かれ"],["ら"],["の"],["墓","はか"],["は"],["穴","あな"],["の"],["奥","おく"],["の"],["ほう"],["に"],["あり"],["、"],["その"],["集団","しゅうだん"],["は"],["その"],["墓","はか"],["の"],["回り","まわり"],["に"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["刺し殺された","さしころされた"],["者","もの"],["、"],["剣","けん"],["に"],["倒れた","たおれた"],["者","もの"],["、"],["かつて"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["恐怖","きょうふ"],["を"],["巻き起こした","まきおこした"],["者","もの"],["たち"],["で"],["ある"],["。"]]},{"verse":24,"text":"そこには、エラムがおり、そのすべての群集もその墓の回りにいる。彼らはみな、刺し殺された者、剣に倒れた者、割礼を受けないで地下の国に下った者、生ける者の地で恐怖を巻き起こした者たちである。それで彼らは穴に下る者たちとともに自分たちの恥を負っている。","tok":[["そこ"],["に"],["は"],["、"],["エラム"],["が"],["おり"],["、"],["その"],["すべて"],["の"],["群集","ぐんしゅう"],["も"],["その"],["墓","はか"],["の"],["回り","まわり"],["に"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["刺し殺された","さしころされた"],["者","もの"],["、"],["剣","けん"],["に"],["倒れた","たおれた"],["者","もの"],["、"],["割礼","かつれい"],["を"],["受けないで","うけないで"],["地下","ちか"],["の"],["国","くに"],["に"],["下った","くだった"],["者","もの"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["恐怖","きょうふ"],["を"],["巻き起こした","まきおこした"],["者","もの"],["たち"],["で"],["ある"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["とも"],["に"],["自分","じぶん"],["たち"],["の"],["恥","はじ"],["を"],["負って","おって"],["いる"],["。"]]},{"verse":25,"text":"その寝床は刺し殺された者たちの間に置かれ、そのすべての群集も、その墓の回りにいる。みな、割礼を受けていない者、剣で刺し殺された者である。彼らの恐怖が生ける者の地にあったからである。それで彼らは穴に下る者たちとともに自分たちの恥を負っている。彼らは刺し殺された者たちの間に置かれた。","tok":[["その"],["寝床","ねどこ"],["は"],["刺し殺された","さしころされた"],["者","もの"],["たち"],["の"],["間","あいだ"],["に"],["置かれ","おかれ"],["、"],["その"],["すべて"],["の"],["群集","ぐんしゅう"],["も"],["、"],["その"],["墓","はか"],["の"],["回り","まわり"],["に"],["いる"],["。"],["みな"],["、"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["者","もの"],["、"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["の"],["恐怖","きょうふ"],["が"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["に"],["あった"],["から"],["で"],["ある"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["とも"],["に"],["自分","じぶん"],["たち"],["の"],["恥","はじ"],["を"],["負って","おって"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["刺し殺された","さしころされた"],["者","もの"],["たち"],["の"],["間","あいだ"],["に"],["置かれた","おかれた"],["。"]]},{"verse":26,"text":"そこには、メシェクとトバルがおり、そのすべての群集もその墓の回りにいる。彼らはみな、割礼を受けていない者、剣で刺し殺された者である。彼らは生ける者の地で恐怖を巻き起こしたからである。","tok":[["そこ"],["に"],["は"],["、"],["メシェク"],["と"],["トバル"],["が"],["おり"],["、"],["その"],["すべて"],["の"],["群集","ぐんしゅう"],["も"],["その"],["墓","はか"],["の"],["回り","まわり"],["に"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["者","もの"],["、"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["恐怖","きょうふ"],["を"],["巻き起こした","まきおこした"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"彼らは、ずっと昔に倒れた勇士たちとともに横たわることはできない。勇士たちは武具を持ってよみに下り、剣は頭の下に置かれ、盾は彼らの骨に置かれている。勇士たちは生ける者の地で恐れられていたからである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["ずっと"],["昔","むかし"],["に"],["倒れた","たおれた"],["勇士","ゆうし"],["たち"],["と"],["とも"],["に"],["横たわる","よこたわる"],["こと"],["は"],["できない"],["。"],["勇士","ゆうし"],["たち"],["は"],["武具","ぶぐ"],["を"],["持って","もって"],["よみ"],["に"],["下り","くだり"],["、"],["剣","けん"],["は"],["頭","あたま"],["の"],["下","した"],["に"],["置かれ","おかれ"],["
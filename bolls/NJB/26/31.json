[{"verse":1,"text":"第十一年の第三の月の一日、私に次のような主のことばがあった。","tok":[["第","だい"],["十一","じゅういち"],["年","ねん"],["の"],["第","だい"],["三","さん"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。エジプトの王パロと彼の大軍に言え。／あなたの偉大さは何に比べられよう。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["エジプト"],["の"],["王","おう"],["パロ"],["と"],["彼","かれ"],["の"],["大軍","たいぐん"],["に"],["言え","いえ"],["。"],["／"],["あなた"],["の"],["偉大","いだい"],["さ"],["は"],["何","なん"],["に"],["比べられよう","くらべられよう"],["。"]]},{"verse":3,"text":"見よ。アッシリヤはレバノンの杉。／美しい枝、茂った木陰、そのたけは高く、そのこずえは雲の中にある。","tok":[["見","み"],["よ"],["。"],["アッシリヤ"],["は"],["レバノン"],["の"],["杉","すぎ"],["。"],["／"],["美しい","うつくしい"],["枝","えだ"],["、"],["茂った","しげった"],["木陰","こかげ"],["、"],["その"],["たけ"],["は"],["高く","たかく"],["、"],["その"],["こずえ"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["ある"],["。"]]},{"verse":4,"text":"水がそれを育て、地下水がこれを高くした。／川々は、その植わっている地の回りを流れ、その流れを野のすべての木に送った。","tok":[["水","みず"],["が"],["それ"],["を"],["育て","そだて"],["、"],["地下水","ちかすい"],["が"],["これ"],["を"],["高く","たかく"],["した"],["。"],["／"],["川","かわ"],["々"],["は"],["、"],["その"],["植わって","うわって"],["いる"],["地","ち"],["の"],["回り","まわり"],["を"],["流れ","ながれ"],["、"],["その"],["流れ","ながれ"],["を"],["野","の"],["の"],["すべて"],["の"],["木","き"],["に"],["送った","おくった"],["。"]]},{"verse":5,"text":"それで、そのたけは、野のすべての木よりも高くそびえ、その送り出す豊かな水によって、その小枝は茂り、その大枝は伸びた。","tok":[["それ"],["で"],["、"],["その"],["たけ"],["は"],["、"],["野","の"],["の"],["すべて"],["の"],["木","き"],["より"],["も"],["高く","たかく"],["そびえ"],["、"],["その"],["送り出す","おくりだす"],["豊か","ゆたか"],["な"],["水","みず"],["によって"],["、"],["その"],["小枝","こえだ"],["は"],["茂り","しげり"],["、"],["その"],["大枝","おおえだ"],["は"],["伸びた","のびた"],["。"]]},{"verse":6,"text":"その小枝には空のあらゆる鳥が巣を作り、大枝の下では野のすべての獣が子を産み、その木陰には多くの国々がみな住んだ。","tok":[["その"],["小枝","こえだ"],["に"],["は"],["空","そら"],["の"],["あらゆる"],["鳥","とり"],["が"],["巣","す"],["を"],["作り","つくり"],["、"],["大枝","おおえだ"],["の"],["下","もと"],["で"],["は"],["野","の"],["の"],["すべて"],["の"],["獣","けもの"],["が"],["子","こ"],["を"],["産み","うみ"],["、"],["その"],["木陰","こかげ"],["に"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["が"],["みな"],["住んだ","すんだ"],["。"]]},{"verse":7,"text":"それは大きくなり、枝も伸びて美しかった。／その根を豊かな水におろしていたからだ。","tok":[["それ"],["は"],["大きく","おおきく"],["なり"],["、"],["枝","えだ"],["も"],["伸びて","のびて"],["美しかった","うつくしかった"],["。"],["／"],["その"],["根","ね"],["を"],["豊か","ゆたか"],["な"],["水","みず"],["に"],["おろして"],["いた"],["から"],["だ"],["。"]]},{"verse":8,"text":"神の園の杉の木も、これとは比べ物にならない。／もみの木も、この小枝とさえ比べられない。／すずかけの木も、この大枝のようではなく、神の園にあるどの木も、その美しさにはかなわない。","tok":[["神","かみ"],["の"],["園","その"],["の"],["杉","すぎ"],["の"],["木","き"],["も"],["、"],["これ"],["と"],["は"],["比べ物","くらべもの"],["に"],["ならない"],["。"],["／"],["もみ"],["の"],["木","き"],["も"],["、"],["この"],["小枝","こえだ"],["と"],["さえ"],["比べられない","くらべられない"],["。"],["／"],["すずかけ"],["の"],["木","き"],["も"],["、"],["この"],["大枝","おおえだ"],["の"],["よう"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["園","その"],["に"],["ある"],["どの"],["木","き"],["も"],["、"],["その"],["美し","うつくし"],["さ"],["に"],["は"],["かなわない"],["。"]]},{"verse":9,"text":"わたしが、その枝を茂らせ、美しく仕立てたので、神の園にあるエデンのすべての木々は、これをうらやんだ。","tok":[["わたし"],["が"],["、"],["その"],["枝","えだ"],["を"],["茂らせ","しげらせ"],["、"],["美しく","うつくしく"],["仕立てた","したてた"],["ので"],["、"],["神","かみ"],["の"],["園","その"],["に"],["ある"],["エデン"],["の"],["すべて"],["の"],["木々","きぎ"],["は"],["、"],["これ"],["を"],["うらやんだ"],["。"]]},{"verse":10,"text":"それゆえ、神である主はこう仰せられる。そのたけが高くなり、そのこずえが雲の中にそびえ、その心がおごり高ぶったから、","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["その"],["たけ"],["が"],["高く","たかく"],["なり"],["、"],["その"],["こずえ"],["が"],["雲","くも"],["の"],["中","なか"],["に"],["そびえ"],["、"],["その"],["心","こころ"],["が"],["おごり高ぶった","おごりたかぶった"],["から"],["、"]]},{"verse":11,"text":"わたしは、これを諸国の民のうちの力ある者の手に渡した。彼はこれをひどく罰し、わたしも、その悪行に応じてこれを追い出した。","tok":[["わたし"],["は"],["、"],["これ"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["うち"],["の"],["力","ちから"],["ある"],["者","もの"],["の"],["手","て"],["に"],["渡した","わたした"],["。"],["彼","かれ"],["は"],["これ"],["を"],["ひどく"],["罰し","ばっし"],["、"],["わたし"],["も"],["、"],["その"],["悪行","あくぎょう"],["に"],["応じて","おうじて"],["これ"],["を"],["追い出した","おいだした"],["。"]]},{"verse":12,"text":"こうして、他国人、最も横暴な異邦の民がこれを切り倒し、山々の上にこれを捨てた。その枝はすべての谷間に落ち、その大枝はこの国のすべての谷川で砕かれた。この国のすべての民は、その木陰から出て行き、これを振り捨てた。","tok":[["こう"],["して"],["、"],["他国人","たこくにん"],["、"],["最も","もっとも"],["横暴","おうぼう"],["な"],["異邦","いほう"],["の"],["民","たみ"],["が"],["これ"],["を"],["切り倒し","きりたおし"],["、"],["山々","やまやま"],["の"],["上","うえ"],["に"],["これ"],["を"],["捨てた","すてた"],["。"],["その"],["枝","えだ"],["は"],["すべて"],["の"],["谷間","たにま"],["に"],["落ち","おち"],["、"],["その"],["大枝","おおえだ"],["は"],["この"],["国","くに"],["の"],["すべて"],["の"],["谷川","たにがわ"],["で"],["砕かれた","くだかれた"],["。"],["この"],["国","くに"],["の"],["すべて"],["の"],["民","たみ"],["は"],["、"],["その"],["木陰","こかげ"],["から"],["出て","でて"],["行き","いき"],["、"],["これ"],["を"],["振り捨てた","ふりすてた"],["。"]]},{"verse":13,"text":"その倒れ落ちた所に、空のあらゆる鳥が住み、その大枝のそばに、野のあらゆる獣がいるようになる。","tok":[["その"],["倒れ","たおれ"],["落ちた","おちた"],["所","ところ"],["に"],["、"],["空","そら"],["の"],["あらゆる"],["鳥","とり"],["が"],["住み","すみ"],["、"],["その"],["大枝","おおえだ"],["の"],["そば"],["に"],["、"],["野","の"],["の"],["あらゆる"],["獣","けもの"],["が"],["いる"],["よう"],["に"],["なる"],["。"]]},{"verse":14,"text":"このことは、水のほとりのどんな木も、そのたけが高くならないためであり、そのこずえが雲の中にそびえないようにするためであり、すべて、水に潤う木が高ぶってそびえ立たないためである。これらはみな、死ぬべき人間と、穴に下る者たちとともに、地下の国、死に渡された。","tok":[["この"],["こと"],["は"],["、"],["水","みず"],["の"],["ほとり"],["の"],["どんな"],["木","き"],["も"],["、"],["その"],["たけ"],["が"],["高く","たかく"],["ならない"],["ため"],["で"],["あり"],["、"],["その"],["こずえ"],["が"],["雲","くも"],["の"],["中","なか"],["に"],["そびえない"],["よう"],["に"],["する"],["ため"],["で"],["あり"],["、"],["すべて"],["、"],["水","みず"],["に"],["潤う","うるおう"],["木","き"],["が"],["高ぶって","たかぶって"],["そびえ立たない","そびえたたない"],["ため"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["みな"],["、"],["死ぬべき","しぬべき"],["人間","にんげん"],["と"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["とも"],["に"],["、"],["地下","ちか"],["の"],["国","くに"],["、"],["死","し"],["に"],["渡された","わたされた"],["。"]]},{"verse":15,"text":"神である主はこう仰せられる。それがよみに下る日に、わたしはこれをおおって深淵を喪に服させ、川をせきとめて、豊かな水をかわかした。わたしがこれのためにレバノンを憂いに沈ませたので、野のすべての木も、これのためにしおれた。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["それ"],["が"],["よみ"],["に"],["下る","くだる"],["日","ひ"],["に"],["、"],["わたし"],["は"],["これ"],["を"],["おおって"],["深淵","しんえん"],["を"],["喪","も"],["に"],["服させ","ふくさせ"],["、"],["川","かわ"],["を"],["せきとめて"],["、"],["豊か","ゆたか"],["な"],["水","みず"],["を"],["かわかした"],["。"],["わたし"],["が"],["これ"],["の"],["ため"],["に"],["レバノン"],["を"],["憂い","うれい"],["に"],["沈ませた","しずませた"],["ので"],["、"],["野","の"],["の"],["すべて"],["の"],["木","き"],["も"],["、"],["これ"],["の"],["ため"],["に"],["しおれた"],["。"]]},{"verse":16,"text":"わたしがこれを穴に下る者たちとともによみに下らせたとき、わたしは諸国の民をその落ちる音で震えさせた。エデンのすべての木、レバノンのえり抜きの良い木、すべての水に潤う木は、地下の国で慰められた。","tok":[["わたし"],["が"],["これ"],["を"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["とも"],["に"],["よみ"],["に"],["下らせた","くだらせた"],["とき"],["、"],["わたし"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["その"],["落ちる","おちる"],["音","おと"],["で"],["震えさせた","ふるえさせた"],["。"],["エデン"],["の"],["すべて"],["の"],["木","き"],["、"],["レバノン"],["の"],["えり抜き","えりぬき"],["の"],["良い","よい"],["木","き"],["、"],["すべて"],["の"],["水","みず"],["に"],["潤う","うるおう"],["木","き"],["は"],["、"],["地下","ちか"],["の"],["国","くに"],["で"],["慰められた","なぐさめられた"],["。"]]},{"verse":17,"text":"それらもまた、剣で刺し殺された者や、これを助けた者、諸国の民の間にあって、その陰に住んだ者たちとともに、よみに下った。","tok":[["それ"],["ら"],["も"],["また"],["、"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["や"],["、"],["これ"],["を"],["助けた","たすけた"],["者","もの"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["あって"],["、"],["その"],["陰","かげ"],["に"],["住んだ","すんだ"],["者","もの"],["たち"],["と"],["とも"],["に"],["、"],["よみ"],["に"],["下った","くだった"],["。"]]},{"verse":18,"text":"エデンの木のうち、その栄えと偉大さで、あなたはどれに似ているだろうか。あなたもエデンの木とともに地下の国に落とされ、剣で刺し殺された者とともに、割礼を受けていない者たちの間に横たわるようになる。これは、パロと、そのすべての大軍のことである。――神である主の御告げ――」","tok":[["エデン"],["の"],["木","き"],["の"],["うち"],["、"],["その"],["栄え","はえ"],["と"],["偉大","いだい"],["さ"],["で"],["、"],["あなた"],["は"],["どれ"],["に"],["似て","にて"],["いるだろう"],["か"],["。"],["あなた"],["も"],["エデン"],["の"],["木","き"],["と"],["とも"],["に"],["地下","ちか"],["の"],["国","くに"],["に"],["落とされ","おとされ"],["、"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["と"],["とも"],["に"],["、"],["割礼","かつれい"],[
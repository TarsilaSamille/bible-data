","はいきょ"],["に"],["いる"],["者","もの"],["は"],["必ず","かならず"],["剣","けん"],["に"],["倒れる","たおれる"],["。"],["野","の"],["に"],["いる"],["者","もの"],["も"],["、"],["わたし"],["は"],["獣","けもの"],["に"],["与えて","あたえて"],["その"],["えじき"],["と"],["する"],["。"],["要害","ようがい"],["と"],["ほら穴","ほらあな"],["に"],["いる"],["者","もの"],["は"],["疫病","やくびょう"],["で"],["死ぬ","しぬ"],["。"]]},{"verse":28,"text":"わたしはその地を荒れ果てさせ、荒廃した地とする。その力強い誇りは消えうせ、イスラエルの山々は荒れ果て、だれもそこを通らなくなる。","tok":[["わたし"],["は"],["その"],["地","ち"],["を"],["荒れ果てさせ","あれはてさせ"],["、"],["荒廃","こうはい"],["した"],["地","ち"],["と"],["する"],["。"],["その"],["力強い","ちからづよい"],["誇り","ほこり"],["は"],["消えうせ","きえうせ"],["、"],["イスラエル"],["の"],["山々","やまやま"],["は"],["荒れ果て","あれはて"],["、"],["だれ"],["も"],["そこ"],["を"],["通らなく","とおらなく"],["なる"],["。"]]},{"verse":29,"text":"このとき、わたしが、彼らの行ったすべての忌みきらうべきわざのためにその国を荒れ果てさせ、荒廃した地とすると、彼らは、わたしが主であることを知ろう。","tok":[["この"],["とき"],["、"],["わたし"],["が"],["、"],["彼","かれ"],["ら"],["の"],["行った","おこなった"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["わざ"],["の"],["ため"],["に"],["その"],["国","くに"],["を"],["荒れ果てさせ","あれはてさせ"],["、"],["荒廃","こうはい"],["した"],["地","ち"],["と"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":30,"text":"人の子よ。あなたの民の者たちは城壁のそばや、家々の入口で、あなたについて互いに語り合ってこう言っている。『さあ、どんなことばが主から出るか聞きに行こう。』","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["の"],["民","たみ"],["の"],["者","もの"],["たち"],["は"],["城壁","じょうへき"],["の"],["そば"],["や"],["、"],["家々","いえいえ"],["の"],["入口","いりぐち"],["で"],["、"],["あなた"],["について"],["互い","たがい"],["に"],["語り合って","かたりあって"],["こう"],["言って","いって"],["いる"],["。"],["『"],["さあ"],["、"],["どんな"],["ことば"],["が"],["主","ぬし"],["から"],["出る","でる"],["か"],["聞き","きき"],["に"],["行こう","いこう"],["。"],["』"]]},{"verse":31,"text":"彼らは群れをなしてあなたのもとに来、わたしの民はあなたの前にすわり、あなたのことばを聞く。しかし、それを実行しようとはしない。彼らは、口では恋をする者であるが、彼らの心は利得を追っている。","tok":[["彼","かれ"],["ら"],["は"],["群れ","むれ"],["を"],["なして"],["あなた"],["の"],["もと"],["に"],["来","き"],["、"],["わたし"],["の"],["民","たみ"],["は"],["あなた"],["の"],["前","まえ"],["に"],["すわり"],["、"],["あなた"],["の"],["ことば"],["を"],["聞く","きく"],["。"],["しかし"],["、"],["それ"],["を"],["実行","じっこう"],["しよう"],["と"],["は"],["しない"],["。"],["彼","かれ"],["ら"],["は"],["、"],["口","くち"],["で"],["は"],["恋","こい"],["を"],["する"],["者","もの"],["で"],["ある"],["が"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["は"],["利得","りとく"],["を"],["追って","おって"],["いる"],["。"]]},{"verse":32,"text":"あなたは彼らにとっては、音楽に合わせて美しく歌われる恋の歌のようだ。彼らはあなたのことばを聞くが、それを実行しようとはしない。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["にとって"],["は"],["、"],["音楽","おんがく"],["に"],["合わせて","あわせて"],["美しく","うつくしく"],["歌われる","うたわれる"],["恋","こい"],["の"],["歌","うた"],["の"],["よう"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["ことば"],["を"],["聞く","きく"],["が"],["、"],["それ"],["を"],["実行","じっこう"],["しよう"],["と"],["は"],["しない"],["。"]]},{"verse":33,"text":"しかし、あのことは起こり、もう来ている。彼らは、自分たちの間にひとりの預言者がいたことを知ろう。」","tok":[["しかし"],["、"],["あの"],["こと"],["は"],["起こり","おこり"],["、"],["もう"],["来て","きて"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["間","あいだ"],["に"],["ひとり"],["の"],["預言者","よげんしゃ"],["が"],["いた"],["こと"],["を"],["知ろう","しろう"],["。"],["」"]]}]
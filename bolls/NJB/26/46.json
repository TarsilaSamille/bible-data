],["通って","とおって"],["出て","でて"],["行かなければ","いかなければ"],["ならない"],["。"],["自分","じぶん"],["の"],["入って","はいって"],["来た","きた"],["門","もん"],["を"],["通って","とおって"],["帰って","かえって"],["は"],["ならない"],["。"],["その"],["反対","はんたい"],["側","がわ"],["から"],["出て","でて"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":10,"text":"君主は、彼らが入るとき、いっしょに入り、彼らが出るとき、いっしょに出なければならない。","tok":[["君主","くんしゅ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["入る","はいる"],["とき"],["、"],["いっしょ"],["に"],["入り","はいり"],["、"],["彼","かれ"],["ら"],["が"],["出る","でる"],["とき"],["、"],["いっしょ"],["に"],["出なければ","でなければ"],["ならない"],["。"]]},{"verse":11,"text":"祭りと例祭には、穀物のささげ物は、雄牛一頭に一エパ、雄羊一頭に一エパ。子羊のためには与えることのできるだけのもの。油は一エパごとに一ヒンである。","tok":[["祭り","まつり"],["と"],["例祭","れいさい"],["に"],["は"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["は"],["、"],["雄牛","おうし"],["一頭","いちとう"],["に"],["一","いち"],["エパ"],["、"],["雄羊","おひつじ"],["一頭","いちとう"],["に"],["一","いち"],["エパ"],["。"],["子羊","こひつじ"],["の"],["ため"],["に"],["は"],["与える","あたえる"],["こと"],["の"],["できる"],["だけ"],["の"],["もの"],["。"],["油","あぶら"],["は"],["一","いち"],["エパ"],["ごと"],["に"],["一","いち"],["ヒン"],["で"],["ある"],["。"]]},{"verse":12,"text":"また、君主が、全焼のいけにえを、進んでささげるささげ物として、あるいは和解のいけにえを、進んでささげるささげ物として主にささげるときには、彼のために東向きの門をあけなければならない。彼は安息日にささげると同じように、全焼のいけにえと和解のいけにえとをささげなければならない。彼が出て行くなら、彼が出て行って後、その門は閉じられる。","tok":[["また"],["、"],["君主","くんしゅ"],["が"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["、"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["として"],["、"],["あるいは"],["和解","わかい"],["の"],["いけにえ"],["を"],["、"],["進んで","すすんで"],["ささげる"],["ささげ物","ささげもの"],["として"],["主に","おもに"],["ささげる"],["とき"],["に"],["は"],["、"],["彼","かれ"],["の"],["ため"],["に"],["東向き","ひがしむき"],["の"],["門","もん"],["を"],["あけなければ"],["ならない"],["。"],["彼","かれ"],["は"],["安息日","あんそくび"],["に"],["ささげる"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["和解","わかい"],["の"],["いけにえ"],["と"],["を"],["ささげなければ"],["ならない"],["。"],["彼","かれ"],["が"],["出て","でて"],["行くなら","いくなら"],["、"],["彼","かれ"],["が"],["出て","でて"],["行って","いって"],["後","あと"],["、"],["その"],["門","もん"],["は"],["閉じられる","とじられる"],["。"]]},{"verse":13,"text":"あなたは毎日、傷のない一歳の子羊一頭を全焼のいけにえとして、主にささげなければならない。これを毎朝ささげなければならない。","tok":[["あなた"],["は"],["毎日","まいにち"],["、"],["傷","きず"],["の"],["ない"],["一歳","いちさい"],["の"],["子羊","こひつじ"],["一頭","いちとう"],["を"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["、"],["主に","おもに"],["ささげなければ"],["ならない"],["。"],["これ"],["を"],["毎朝","まいあさ"],["ささげなければ"],["ならない"],["。"]]},{"verse":14,"text":"それに添えて、毎朝、六分の一エパの穀物のささげ物、上等の小麦粉に振りかけるための油三分の一ヒンをささげなければならない。これが主への穀物のささげ物であり、永遠に続く定めである。","tok":[["それ"],["に"],["添えて","そえて"],["、"],["毎朝","まいあさ"],["、"],["六分","ろくぶん"],["の"],["一","いち"],["エパ"],["の"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["、"],["上等","じょうとう"],["の"],["小麦粉","こむぎこ"],["に"],["振りかける","ふりかける"],["ため"],["の"],["油","あぶら"],["三分","さんぶん"],["の"],["一","いち"],["ヒン"],["を"],["ささげなければ"],["ならない"],["。"],["これ"],["が"],["主","ぬし"],["へ"],["の"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["で"],["あり"],["、"],["永遠","えいえん"],["に"],["続く","つづく"],["定め","さだめ"],["で"],["ある"],["。"]]},{"verse":15,"text":"こうして、子羊や穀物のささげ物や油を、常供の全焼のいけにえとして、毎朝ささげなければならない。","tok":[["こう"],["して"],["、"],["子羊","こひつじ"],["や"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["や"],["油","あぶら"],["を"],["、"],["常供","つねとも"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["として"],["、"],["毎朝","まいあさ"],["ささげなければ"],["ならない"],["。"]]},{"verse":16,"text":"神である主はこう仰せられる。もし、君主が、贈り物として自分の相続地を自分の息子たちに与えるなら、それは息子たちのものとなり、それは相続地として彼らの所有地となる。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["もし"],["、"],["君主","くんしゅ"],["が"],["、"],["贈り物","おくりもの"],["として"],["自分","じぶん"],["の"],["相続","そうぞく"],["地","ち"],["を"],["自分","じぶん"],["の"],["息子","むすこ"],["たち"],["に"],["与えるなら","あたえるなら"],["、"],["それ"],["は"],["息子","むすこ"],["たち"],["の"],["もの"],["と"],["なり"],["、"],["それ"],["は"],["相続","そうぞく"],["地","ち"],["として"],["彼","かれ"],["ら"],["の"],["所有地","しょゆうち"],["と"],["なる"],["。"]]},{"verse":17,"text":"しかし、もし、彼が自分の相続地の一部を贈り物として奴隷のひとりに与えるなら、それは解放の年まで彼のものであるが、その後、それは君主に返される。ただ息子たちだけが、相続地を自分のものとすることができる。","tok":[["しかし"],["、"],["もし"],["、"],["彼","かれ"],["が"],["自分","じぶん"],["の"],["相続","そうぞく"],["地","ち"],["の"],["一部","いちぶ"],["を"],["贈り物","おくりもの"],["として"],["奴隷","どれい"],["の"],["ひとり"],["に"],["与えるなら","あたえるなら"],["、"],["それ"],["は"],["解放","かいほう"],["の"],["年","とし"],["まで"],["彼","かれ"],["の"],["もの"],["で"],["ある"],["が"],["、"],["その"],["後","ご"],["、"],["それ"],["は"],["君主","くんしゅ"],["に"],["返される","かえされる"],["。"],["ただ"],["息子","むすこ"],["たち"],["だけ"],["が"],["、"],["相続","そうぞく"],["地","ち"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":18,"text":"君主は、民の相続地を奪って彼らをその所有地から押しのけてはならない。彼は自分の所有地から自分の息子たちに相続地を与えなければならない。それは、わたしの民がひとりでも、その所有地から散らされないためである。」","tok":[["君主","くんしゅ"],["は"],["、"],["民","みん"],["の"],["相続","そうぞく"],["地","ち"],["を"],["奪って","うばって"],["彼","かれ"],["ら"],["を"],["その"],["所有地","しょゆうち"],["から"],["押しのけて","おしのけて"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["所有地","しょゆうち"],["から"],["自分","じぶん"],["の"],["息子","むすこ"],["たち"],["に"],["相続","そうぞく"],["地","ち"],["を"],["与えなければ","あたえなければ"],["ならない"],["。"],["それ"],["は"],["、"],["わたし"],["の"],["民","たみ"],["が"],["ひとり"],["で"],["も"],["、"],["その"],["所有地","しょゆうち"],["から"],["散らされない","ちらされない"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":19,"text":"それから、彼は私を、門のわきにある出入口から、北向きになっている祭司たちの聖所の部屋に連れて行った。すると、西のほうの隅に一つの場所があった。","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["私","わたくし"],["を"],["、"],["門","もん"],["の"],["わき"],["に"],["ある"],["出入","でいり"],["口","くち"],["から"],["、"],["北向き","きたむき"],["に"],["なって"],["いる"],["祭司","さいし"],["たち"],["の"],["聖","せい"],["所","しょ"],["の"],["部屋","へや"],["に"],["連れて","つれて"],["行った","いった"],["。"],["する"],["と"],["、"],["西","にし"],["の"],["ほう"],["の"],["隅","すみ"],["に"],["一","ひと"],["つ"],["の"],["場所","ばしょ"],["が"],["あった"],["。"]]},{"verse":20,"text":"彼は私に言った。「ここは祭司たちが、罪過のためのいけにえや、罪のためのいけにえを煮たり、穀物のささげ物を焼いたりする場所である。これらの物を外庭に持ち出して民を聖なるものとしないためである。」","tok":[["彼","かれ"],["は"],["私","わたくし"],["に"],["言った","いった"],["。"],["「"],["ここ"],["は"],["祭司","さいし"],["たち"],["が"],["、"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["や"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["を"],["煮たり","にたり"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["を"],["焼い","やい"],["たり"],["する"],["場所","ばしょ"],["で"],["ある"],["。"],["これ"],["ら"],["の"],["物","もの"],["を"],["外庭","そとにわ"],
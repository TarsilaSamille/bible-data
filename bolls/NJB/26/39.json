[{"verse":1,"text":"「人の子よ。ゴグに向かって預言して言え。神である主はこう仰せられる。メシェクとトバルの大首長であるゴグよ。わたしはあなたに立ち向かう。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["ゴグ"],["に"],["向かって","むかって"],["預言","よげん"],["して"],["言え","いえ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["メシェク"],["と"],["トバル"],["の"],["大","だい"],["首長","しゅちょう"],["で"],["ある"],["ゴグ"],["よ"],["。"],["わたし"],["は"],["あなた"],["に"],["立ち向かう","たちむかう"],["。"]]},{"verse":2,"text":"わたしはあなたを引き回し、あなたを押しやり、北の果てから上らせ、イスラエルの山々に連れて来る。","tok":[["わたし"],["は"],["あなた"],["を"],["引き回し","ひきまわし"],["、"],["あなた"],["を"],["押しやり","おしやり"],["、"],["北","きた"],["の"],["果て","はて"],["から"],["上らせ","のぼらせ"],["、"],["イスラエル"],["の"],["山々","やまやま"],["に"],["連れて","つれて"],["来る","くる"],["。"]]},{"verse":3,"text":"あなたの左手から弓をたたき落とし、右手から矢を落とす。","tok":[["あなた"],["の"],["左手","ひだりて"],["から"],["弓","ゆみ"],["を"],["たたき落とし","たたきおとし"],["、"],["右手","みぎて"],["から"],["矢","や"],["を"],["落とす","おとす"],["。"]]},{"verse":4,"text":"あなたと、あなたのすべての部隊、あなたの率いる国々の民は、イスラエルの山々に倒れ、わたしはあなたをあらゆる種類の猛禽や野獣のえじきとする。","tok":[["あなた"],["と"],["、"],["あなた"],["の"],["すべて"],["の"],["部隊","ぶたい"],["、"],["あなた"],["の"],["率いる","ひきいる"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["、"],["イスラエル"],["の"],["山々","やまやま"],["に"],["倒れ","たおれ"],["、"],["わたし"],["は"],["あなた"],["を"],["あらゆる"],["種類","しゅるい"],["の"],["猛禽","もうきん"],["や"],["野獣","やじゅう"],["の"],["えじき"],["と"],["する"],["。"]]},{"verse":5,"text":"あなたは野に倒れる。わたしがこれを語るからだ。／――神である主の御告げ――","tok":[["あなた"],["は"],["野","の"],["に"],["倒れる","たおれる"],["。"],["わたし"],["が"],["これ"],["を"],["語る","かたる"],["から"],["だ"],["。"],["／"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":6,"text":"わたしはマゴグと、島々に安住している者たちとに火を放つ。彼らは、わたしが主であることを知ろう。","tok":[["わたし"],["は"],["マゴグ"],["と"],["、"],["島々","しまじま"],["に"],["安住","あんじゅう"],["して"],["いる"],["者","もの"],["たち"],["と"],["に"],["火","ひ"],["を"],["放つ","はなつ"],["。"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":7,"text":"わたしは、わたしの聖なる名をわたしの民イスラエルの中に知らせ、二度とわたしの聖なる名を汚させない。諸国の民は、わたしが主であり、イスラエルの聖なる者であることを知ろう。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["中","なか"],["に"],["知らせ","しらせ"],["、"],["二","に"],["度","ど"],["と"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚させない","よごさせない"],["。"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["あり"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":8,"text":"今、それは来、それは成就する。――神である主の御告げ――それは、わたしが語った日である。","tok":[["今","いま"],["、"],["それ"],["は"],["来","き"],["、"],["それ"],["は"],["成就","じょうじゅ"],["する"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["それ"],["は"],["、"],["わたし"],["が"],["語った","かたった"],["日","ひ"],["で"],["ある"],["。"]]},{"verse":9,"text":"イスラエルの町々の住民は出て来て、武器、すなわち、盾と大盾、弓と矢、手槍と槍を燃やして焼き、七年間、それらで火を燃やす。","tok":[["イスラエル"],["の"],["町々","まちまち"],["の"],["住民","じゅうみん"],["は"],["出て","でて"],["来て","きて"],["、"],["武器","ぶき"],["、"],["すなわち"],["、"],["盾","たて"],["と"],["大","だい"],["盾","たて"],["、"],["弓","ゆみ"],["と"],["矢","や"],["、"],["手槍","てやり"],["と"],["槍","やり"],["を"],["燃やして","もやして"],["焼き","やき"],["、"],["七","なな"],["年間","ねんかん"],["、"],["それ"],["ら"],["で"],["火","ひ"],["を"],["燃やす","もやす"],["。"]]},{"verse":10,"text":"彼らは野から木を取り、森からたきぎを集める必要はない。彼らは武器で火を燃やすからだ。彼らは略奪された物を略奪し返し、かすめ奪われた物をかすめ奪う。――神である主の御告げ――","tok":[["彼","かれ"],["ら"],["は"],["野","の"],["から"],["木","き"],["を"],["取り","とり"],["、"],["森","もり"],["から"],["たきぎ"],["を"],["集める","あつめる"],["必要","ひつよう"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["武器","ぶき"],["で"],["火","ひ"],["を"],["燃やす","もやす"],["から"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["略奪","りゃくだつ"],["された"],["物","もの"],["を"],["略奪","りゃくだつ"],["し"],["返し","かえし"],["、"],["かすめ"],["奪われた","うばわれた"],["物","もの"],["を"],["かすめ"],["奪う","うばう"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":11,"text":"その日、わたしは、イスラエルのうちに、ゴグのために墓場を設ける。それは海の東の旅人の谷である。そこは人が通れなくなる。そこにゴグと、そのすべての群集が埋められ、そこはハモン・ゴグの谷と呼ばれる。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["、"],["イスラエル"],["の"],["うち"],["に"],["、"],["ゴグ"],["の"],["ため"],["に"],["墓場","はかば"],["を"],["設ける","もうける"],["。"],["それ"],["は"],["海","うみ"],["の"],["東","ひがし"],["の"],["旅人","たびびと"],["の"],["谷","たに"],["で"],["ある"],["。"],["そこ"],["は"],["人","ひと"],["が"],["通れなく","とおれなく"],["なる"],["。"],["そこ"],["に"],["ゴグ"],["と"],["、"],["その"],["すべて"],["の"],["群集","ぐんしゅう"],["が"],["埋められ","うめられ"],["、"],["そこ"],["は"],["ハモン"],["・"],["ゴグ"],["の"],["谷","たに"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":12,"text":"イスラエルの家は、その国をきよめるために、七か月かかって彼らを埋める。","tok":[["イスラエル"],["の"],["家","いえ"],["は"],["、"],["その"],["国","くに"],["を"],["きよめる"],["ため"],["に"],["、"],["七","なな"],["か月","かげつ"],["かかって"],["彼","かれ"],["ら"],["を"],["埋める","うめる"],["。"]]},{"verse":13,"text":"その国のすべての民が埋め、わたしの栄光が現されるとき、彼らは有名になる。――神である主の御告げ――","tok":[["その"],["国","くに"],["の"],["すべて"],["の"],["民","たみ"],["が"],["埋め","うめ"],["、"],["わたし"],["の"],["栄光","えいこう"],["が"],["現される","あらわされる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["有名","ゆうめい"],["に"],["なる"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":14,"text":"彼らは、常時、国を巡り歩く者たちを選び出す。彼らは地の面に取り残されているもの、旅人たちを埋めて国をきよめる。彼らは七か月の終わりまで捜す。","tok":[["彼","かれ"],["ら"],["は"],["、"],["常時","じょうじ"],["、"],["国","くに"],["を"],["巡り歩く","めぐりあるく"],["者","もの"],["たち"],["を"],["選び出す","えらびだす"],["。"],["彼","かれ"],["ら"],["は"],["地","ち"],["の"],["面","めん"],["に"],["取り残されて","とりのこされて"],["いる"],["もの"],["、"],["旅人","たびびと"],["たち"],["を"],["埋めて","うめて"],["国","くに"],["を"],["きよめる"],["。"],["彼","かれ"],["ら"],["は"],["七","なな"],["か月","かげつ"],["の"],["終わり","おわり"],["まで"],["捜す","さがす"],["。"]]},{"verse":15,"text":"巡り歩く者たちは国中を巡り歩き、人間の骨を見ると、そのそばに標識を立て、埋める者たちがそれをハモン・ゴグの谷に埋めるようにする。","tok":[["巡り歩く","めぐりあるく"],["者","もの"],["たち"],["は"],["国中","くにちゅう"],["を"],["巡り歩き","めぐりあるき"],["、"],["人間","にんげん"],["の"],["骨","ほね"],["を"],["見る","みる"],["と"],["、"],["その"],["そば"],["に"],["標識","ひょうしき"],["を"],["立て","たて"],["、"],["埋める","うめる"],["者","もの"],["たち"],["が"],["それ"],["を"],["ハモン"],["・"],["ゴグ"],["の"],["谷","たに"],["に"],["埋める","うめる"],["よう"],["に"],["する"],["。"]]},{"verse":16,"text":"そこの町の名はハモナとも言われる。彼らは国をきよめる。","tok":[["そこ"],["の"],["町","まち"],["の"],["名","な"],["は"],["ハモナ"],["と"],["も"],["言われる","いわれる"],["。"],["彼","かれ"],["ら"],["は"],["国","くに"],["を"],["きよめる"],["。"]]},{"verse":17,"text":"神である主はこう仰せられる。人の子よ。あらゆる種類の鳥と、あらゆる野の獣に言え。集まって来い。わたしがおまえたちのために切り殺した者、イスラエルの山々の上にある多くの切り殺された者に、四方から集まって来い。おまえたちはその肉を食べ、その血を飲め。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あらゆる"],["種類","しゅるい"],["の"],["鳥","とり"],["と"],["、"],["あらゆる"],["野","の"],["の"],["獣","けもの"],["に"],["言え","いえ"],["。"],["集まって","あつまって"],["来い","こい"],["。"],["わたし"],["が"],["おまえ"],["たち"],["の"],["ため"],["に"],["切り殺した","きりころした"],["者","もの"],["、"],["イスラエル"],["の"],["山々","やまやま"],["の"],["上","うえ"],["に"],["ある"],["多く","おおく"],["の"],["切り殺された","きりころされた"],["者","もの"],["に"],["、"],["四方","しほう"],["から"],["集まって","あつまって"],["来い","こい"],["。"],["おまえ"],["たち"],["は"],["その"],["肉","にく"],["を"],["食べ","たべ"],["、"],["その"],["血","ち"],["を"],["飲め","のめ"],["。"]]},{"verse":18,"text":"勇士たちの肉を食べ、国の君主たちの血を飲め。雄羊、子羊、雄やぎ、雄牛、すべてバシャンの肥えたものをそうせよ。","tok":[["勇士","ゆうし"],["たち"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["国","くに"],["の"],["君主","くんしゅ"],["たち"],["の"],["血","ち"],["を"],["飲め","のめ"],["。"],["雄羊","おひつじ"],["、"],["子羊","こひつじ"],["、"],["雄","おす"],["やぎ"],["、"],["雄牛","おうし"],["、"],["すべて"],["バシャン"],["の"],["肥えた","こえた"],["もの"],["を"],["そう"],["せよ"],["。"]]},{"verse":19,"text":"わたしがおまえたちのために切り殺したものの脂肪を飽きるほど食べ、その血を酔うほど飲むがよい。","tok":[["わたし"],["が"],["おまえ"],["たち"],["の"],["ため"],["に"],["切り殺した","きりころした"],["もの"],["の"],["脂肪","しぼう"],["を"],["飽きる","あきる"],["ほど"],["食べ","たべ"],["、"],["その"],["血","ち"],["を"],["酔う","よう"],["ほど"],["飲む","のむ"],["が"],["よい"],["。"]]},{"verse":20,"text":"おまえたちはわたしの食卓で、馬や、騎手や、勇士や、すべての戦士に食べ飽きる。――神である主の御告げ――","tok":[["おまえ"],["たち"],["は"],["わたし"],["の"],["食卓","しょくたく"],["で"],["、"],["馬","うま"],["や"],["、"],["騎手","きしゅ"],["や"],["、"],["勇士","ゆうし"],["や"],["、"],["すべて"],["の"],["戦士","せんし"],["に"],["食べ飽きる","たべあきる"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":21,"text":"わたしが諸国の民の間にわたしの栄光を現すとき、諸国の民はみな、わたしが行うわたしのさばきと、わたしが彼らに置くわたしの手とを見る。","tok":[["わたし"],["が"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["わたし"],["の"],["栄光","えいこう"],["を"],["現す","あらわす"],["とき"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["みな"],["、"],["わたし"],["が"],["行う","おこなう"],["わたし"],["の"],["さばき"],["と"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["置く","おく"],["わたし"],["の"],["手","て"],["と"],["を"],["見る","みる"],["。"]]},{"verse":22,"text":"その日の後、イスラエルの家は、わたしが彼らの神、主であることを知ろう。","tok":[["その"],["日","ひ"],["の"],["後","あと"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":23,"text":"諸国の民は、イスラエルの家が、わたしに不信の罪を犯したために咎を得て捕らえ移されたこと、それから、わたしが彼らにわたしの顔を隠し、彼らを敵の手に渡したので、彼らがみな剣に倒れたことを知ろう。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["が"],["、"],["わたし"],["に"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["ため"],["に"],["咎","とが"],["を"],["得て","えて"],["捕らえ","とらえ"],["移された","うつされた"],["こと"],["、"],["それ"],["から"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["顔","かお"],["を"],["隠し","かくし"],["、"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡した","わたした"],["ので"],["、"],["彼","かれ"],["ら"],["が"],["みな"],["剣","けん"],["に"],["倒れた","たおれた"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":24,"text":"わたしは、彼らの汚れとそむきの罪に応じて彼らを罰し、わたしの顔を彼らに隠した。","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["汚れ","よごれ"],["と"],["そむき"],["の"],["罪","つみ"],["に"],["応じて","おうじて"],["彼","かれ"],["ら"],["を"],["罰し","ばっし"],["、"],["わたし"],["の"],["顔","かお"],["を"],["彼","かれ"],["ら"],["に"],["隠した","かくした"],["。"]]},{"verse":25,"text":"それゆえ、神である主はこう仰せられる。今わたしはヤコブの繁栄を元どおりにし、イスラエルの全家をあわれむ。これは、わたしの聖なる名のための熱心による。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["今","いま"],["わたし"],["は"],["ヤコブ"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["し"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["を"],["あわれむ"],["。"],["これ"],["は"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["の"],["ため"],["の"],["熱心","ねっしん"],["に"],["よる"],["。"]]},{"verse":26,"text":"彼らは、自分たちの地に安心して住み、彼らを脅かす者がいなくなるとき、わたしに逆らった自分たちの恥とすべての不信の罪との責めを負おう。","tok":[["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["地","ち"],["に"],["安心","あんしん"],["して"],["住み","すみ"],["、"],["彼","かれ"],["ら"],["を"],["脅かす","おびやかす"],["者","もの"],["が"],["いなく"],["なる"],["とき"],["、"],["わたし"],["に"],["逆らった","さからった"],["自分","じぶん"],["たち"],["の"],["恥","はじ"],["と"],["すべて"],["の"],["不信","ふしん"],["の"],["罪","つみ"],["と"],["の"],["責め","せめ"],["を"],["負おう","おおう"],["。"]]},{"verse":27,"text":"わたしが彼らを国々の民の間から帰らせ、彼らの敵の地から集め、多くの国々が見ている前で、彼らのうちにわたしの聖なることを示すとき、","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["を"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["間","あいだ"],["から"],["帰らせ","かえらせ"],["、"],["彼","かれ"],["ら"],["の"],["敵","てき"],["の"],["地","ち"],["から"],["集め","あつめ"],["、"],["多く","おおく"],["の"],["国々","くにぐに"],["が"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["示す","しめす"],["とき"],["、"]]},{"verse":28,"text":"彼らは、わたしが彼らの神、主であることを知ろう。わたしは彼らを国々に引いて行ったが、また彼らを彼らの地に集め、そこにひとりも残しておかないようにするからだ。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["国々","くにぐに"],["に"],["引いて","ひいて"],["行った","いった"],["が"],["、"],["また"],["彼","かれ"],["ら"],["を"],["彼","かれ"],["ら"],["の"],["地","ち"],["に"],["集め","あつめ"],["、"],["そこ"],["に"],["ひとり"],["も"],["残して","のこして"],["おかない"],["よう"],["に"],["する"],["から"],["だ"],["。"]]},{"verse":29,"text":"わたしは二度とわたしの顔を彼らから隠さず、わたしの霊をイスラエルの家の上に注ぐ。――神である主の御告げ――」","tok":[["わたし"],["は"],["二","に"],["度","ど"],["と"],["わたし"],["の"],["顔","かお"],["を"],["彼","かれ"],["ら"],["から"],["隠さず","かくさず"],["、"],["わたし"],["の"],["霊","れい"],["を"],["イスラエル"],["の"],["家","いえ"],["の"],["上","うえ"],["に"],["注ぐ","そそぐ"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]}]
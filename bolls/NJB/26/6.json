[{"verse":1,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。あなたの顔をイスラエルの山々に向け、それらに向かって預言して、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["の"],["顔","かお"],["を"],["イスラエル"],["の"],["山々","やまやま"],["に"],["向け","むけ"],["、"],["それ"],["ら"],["に"],["向かって","むかって"],["預言","よげん"],["して"],["、"]]},{"verse":3,"text":"言え。／イスラエルの山々よ。神である主のことばを聞け。神である主は、山や丘、谷川や谷に向かってこう仰せられる。見よ。わたしは剣をあなたがたにもたらし、あなたがたの高き所を打ちこわす。","tok":[["言え","いえ"],["。"],["／"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["山","やま"],["や"],["丘","おか"],["、"],["谷川","たにがわ"],["や"],["谷","たに"],["に"],["向かって","むかって"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["剣","けん"],["を"],["あなた"],["がた"],["に"],["もたらし"],["、"],["あなた"],["がた"],["の"],["高き","たかき"],["所","ところ"],["を"],["打ちこわす","うちこわす"],["。"]]},{"verse":4,"text":"あなたがたの祭壇は荒らされ、あなたがたの香の台は砕かれる。わたしはあなたがたのうちの刺し殺された者どもを、あなたがたの偶像の前に投げ倒す。","tok":[["あなた"],["がた"],["の"],["祭壇","さいだん"],["は"],["荒らされ","あらされ"],["、"],["あなた"],["がた"],["の"],["香","こう"],["の"],["台","だい"],["は"],["砕かれる","くだかれる"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["うち"],["の"],["刺し殺された","さしころされた"],["者","もの"],["ども"],["を"],["、"],["あなた"],["がた"],["の"],["偶像","ぐうぞう"],["の"],["前","まえ"],["に"],["投げ倒す","なげたおす"],["。"]]},{"verse":5,"text":"わたしは、イスラエルの民の死体を彼らの偶像の前に置き、あなたがたの骨をあなたがたの祭壇の回りにまき散らす。","tok":[["わたし"],["は"],["、"],["イスラエル"],["の"],["民","たみ"],["の"],["死体","したい"],["を"],["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["の"],["前","まえ"],["に"],["置き","おき"],["、"],["あなた"],["がた"],["の"],["骨","ほね"],["を"],["あなた"],["がた"],["の"],["祭壇","さいだん"],["の"],["回り","まわり"],["に"],["まき散らす","まきちらす"],["。"]]},{"verse":6,"text":"あなたがたがどこに住もうとも、町々は廃墟となり、高き所は荒らされる。あなたがたの祭壇は廃墟となり、罪に定められる。あなたがたの偶像が砕きに砕かれ、あなたがたの香の台は切り倒され、あなたがたのしたわざは消し去られ、","tok":[["あなた"],["がた"],["が"],["どこ"],["に"],["住もう","すもう"],["とも"],["、"],["町々","まちまち"],["は"],["廃墟","はいきょ"],["と"],["なり"],["、"],["高き","たかき"],["所","ところ"],["は"],["荒らされる","あらされる"],["。"],["あなた"],["がた"],["の"],["祭壇","さいだん"],["は"],["廃墟","はいきょ"],["と"],["なり"],["、"],["罪","つみ"],["に"],["定められる","さだめられる"],["。"],["あなた"],["がた"],["の"],["偶像","ぐうぞう"],["が"],["砕き","くだき"],["に"],["砕かれ","くだかれ"],["、"],["あなた"],["がた"],["の"],["香","こう"],["の"],["台","だい"],["は"],["切り倒され","きりたおされ"],["、"],["あなた"],["がた"],["の"],["した"],["わざ"],["は"],["消し去られ","けしさられ"],["、"]]},{"verse":7,"text":"刺し殺された者があなたがたのうちに横たわるとき、あなたがたは、わたしが主であることを知ろう。","tok":[["刺し殺された","さしころされた"],["者","もの"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["横たわる","よこたわる"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":8,"text":"しかし、わたしは、あなたがたのある者を残しておく。わたしがあなたがたを国々に追い散らすとき、剣をのがれた者たちを諸国の民の中におらせる。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["ある"],["者","もの"],["を"],["残して","のこして"],["おく"],["。"],["わたし"],["が"],["あなた"],["がた"],["を"],["国々","くにぐに"],["に"],["追い散らす","おいちらす"],["とき"],["、"],["剣","けん"],["を"],["のがれた"],["者","もの"],["たち"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["おらせる"],["。"]]},{"verse":9,"text":"あなたがたのうちののがれた者たちは、とりこになって行く国々で、わたしを思い出そう。それは、わたしから離れる彼らの姦淫の心と、偶像を慕う彼らの姦淫の目をわたしが打ち砕くからだ。彼らが自分たちのあらゆる忌みきらうべきことをしたその悪をみずからいとうようになるとき、","tok":[["あなた"],["がた"],["の"],["うち"],["の"],["のがれた"],["者","もの"],["たち"],["は"],["、"],["とりこ"],["に"],["なって"],["行く","いく"],["国々","くにぐに"],["で"],["、"],["わたし"],["を"],["思い出そう","おもいだそう"],["。"],["それ"],["は"],["、"],["わたし"],["から"],["離れる","はなれる"],["彼","かれ"],["ら"],["の"],["姦淫","かんいん"],["の"],["心","こころ"],["と"],["、"],["偶像","ぐうぞう"],["を"],["慕う","したう"],["彼","かれ"],["ら"],["の"],["姦淫","かんいん"],["の"],["目","め"],["を"],["わたし"],["が"],["打ち砕く","うちくだく"],["から"],["だ"],["。"],["彼","かれ"],["ら"],["が"],["自分","じぶん"],["たち"],["の"],["あらゆる"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["した"],["その"],["悪","あく"],["を"],["みずから"],["いとう"],["よう"],["に"],["なる"],["とき"],["、"]]},{"verse":10,"text":"彼らは、わたしが主であること、また、わたしがゆえもなくこのわざわいを彼らに下すと言ったのではないことを知ろう。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["、"],["また"],["、"],["わたし"],["が"],["ゆえ"],["も"],["なく"],["この"],["わざわい"],["を"],["彼","かれ"],["ら"],["に"],["下す","くだす"],["と"],["言った","いった"],["ので"],["は"],["ない"],["こと"],["を"],["知ろう","しろう"],["。"],["」"]]},{"verse":11,"text":"神である主はこう仰せられる。「あなたは、手をたたき、足を踏み鳴らして、剣とききんと疫病とによって倒れるイスラエルの家の忌みきらうべきすべての悪に対して、『ああ』と叫べ。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["「"],["あなた"],["は"],["、"],["手","て"],["を"],["たたき"],["、"],["足","あし"],["を"],["踏み鳴らして","ふみならして"],["、"],["剣","けん"],["と"],["ききん"],["と"],["疫病","やくびょう"],["と"],["によって"],["倒れる","たおれる"],["イスラエル"],["の"],["家","いえ"],["の"],["忌みきらうべき","いみきらうべき"],["すべて"],["の"],["悪","あく"],["に対して","にたいして"],["、"],["『"],["ああ"],["』"],["と"],["叫べ","さけべ"],["。"]]},{"verse":12,"text":"遠くにいる者は疫病で死に、近くにいる者は剣に倒れ、生き残ってとどめられている者はききんで死ぬ。彼らへのわたしの憤りは全うされる。","tok":[["遠く","とおく"],["に"],["いる"],["者","もの"],["は"],["疫病","やくびょう"],["で"],["死に","しに"],["、"],["近く","ちかく"],["に"],["いる"],["者","もの"],["は"],["剣","けん"],["に"],["倒れ","たおれ"],["、"],["生き残って","いきのこって"],["とどめられて"],["いる"],["者","もの"],["は"],["ききん"],["で"],["死ぬ","しぬ"],["。"],["彼","かれ"],["ら"],["へ"],["の"],["わたし"],["の"],["憤り","いきどおり"],["は"],["全う","まっとう"],["される"],["。"]]},{"verse":13,"text":"彼らのうちの刺し殺された者が、彼らの偶像の間、その祭壇の回りや、すべての高い丘の上、山々のすべての頂、すべての青木の下や、すべての茂った樫の木の下、彼らがすべての偶像になだめのかおりをたいた所に横たわるとき、あなたがたは、わたしが主であることを知ろう。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["刺し殺された","さしころされた"],["者","もの"],["が"],["、"],["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["の"],["間","あいだ"],["、"],["その"],["祭壇","さいだん"],["の"],["回り","まわり"],["や"],["、"],["すべて"],["の"],["高い","たかい"],["丘","おか"],["の"],["上","うえ"],["、"],["山々","やまやま"],["の"],["すべて"],["の"],["頂","いただき"],["、"],["すべて"],["の"],["青木","あおき"],["の"],["下","した"],["や"],["、"],["すべて"],["の"],["茂った","しげった"],["樫","かし"],["の"],["木","き"],["の"],["下","もと"],["、"],["彼","かれ"],["ら"],["が"],["すべて"],["の"],["偶像","ぐうぞう"],["に"],["なだめ"],["の"],["かおり"],["を"],["たいた"],["所","ところ"],["に"],["横たわる","よこたわる"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"ve
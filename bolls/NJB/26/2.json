[{"verse":1,"text":"その方は私に仰せられた。「人の子よ。立ち上がれ。わたしがあなたに語るから。」","tok":[["その"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["立ち上がれ","たちあがれ"],["。"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["から"],["。"],["」"]]},{"verse":2,"text":"その方が私に語りかけられると、すぐ霊が私のうちに入り、私を立ち上がらせた。そのとき、私は私に語りかけることばを聞いた。","tok":[["その"],["方","ほう"],["が"],["私","わたくし"],["に"],["語りかけられる","かたりかけられる"],["と"],["、"],["すぐ"],["霊","れい"],["が"],["私","わたくし"],["の"],["うち"],["に"],["入り","はいり"],["、"],["私","わたくし"],["を"],["立ち上がらせた","たちあがらせた"],["。"],["その"],["とき"],["、"],["私","わたくし"],["は"],["私","わたくし"],["に"],["語りかける","かたりかける"],["ことば"],["を"],["聞いた","きいた"],["。"]]},{"verse":3,"text":"その方は私に仰せられた。「人の子よ。わたしはあなたをイスラエルの民、すなわち、わたしにそむいた反逆の国民に遣わす。彼らも、その先祖たちも、わたしにそむいた。今日もそうである。","tok":[["その"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["イスラエル"],["の"],["民","たみ"],["、"],["すなわち"],["、"],["わたし"],["に"],["そむいた"],["反逆","はんぎゃく"],["の"],["国民","こくみん"],["に"],["遣わす","つかわす"],["。"],["彼","かれ"],["ら"],["も"],["、"],["その"],["先祖","せんぞ"],["たち"],["も"],["、"],["わたし"],["に"],["そむいた"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼らはあつかましくて、かたくなである。わたしはあなたを彼らに遣わす。あなたは彼らに『神である主はこう仰せられる』と言え。","tok":[["彼","かれ"],["ら"],["は"],["あつかましくて"],["、"],["かたくな"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["を"],["彼","かれ"],["ら"],["に"],["遣わす","つかわす"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["『"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["』"],["と"],["言え","いえ"],["。"]]},{"verse":5,"text":"彼らは反逆の家だから、彼らが聞いても、聞かなくても、彼らは、彼らのうちに預言者がいることを知らなければならない。","tok":[["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["聞いて","きいて"],["も"],["、"],["聞かなくて","きかなくて"],["も"],["、"],["彼","かれ"],["ら"],["は"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["預言者","よげんしゃ"],["が"],["いる"],["こと"],["を"],["知らなければ","しらなければ"],["ならない"],["。"]]},{"verse":6,"text":"人の子よ。彼らや、彼らのことばを恐れるな。たとい、あざみといばらがあなたといっしょにあっても、またあなたがさそりの中に住んでも、恐れるな。彼らは反逆の家だから、そのことばを恐れるな。彼らの顔にひるむな。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["彼","かれ"],["ら"],["や"],["、"],["彼","かれ"],["ら"],["の"],["ことば"],["を"],["恐れる","おそれる"],["な"],["。"],["たとい"],["、"],["あざみ"],["と"],["いばら"],["が"],["あなた"],["と"],["いっしょ"],["に"],["あって"],["も"],["、"],["また"],["あなた"],["が"],["さそり"],["の"],["中","なか"],["に"],["住んで","すんで"],["も"],["、"],["恐れる","おそれる"],["な"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["、"],["その"],["ことば"],["を"],["恐れる","おそれる"],["な"],["。"],["彼","かれ"],["ら"],["の"],["顔","かお"],["に"],["ひるむ"],["な"],["。"]]},{"verse":7,"text":"彼らは反逆の家だから、彼らが聞いても、聞かなくても、あなたはわたしのことばを彼らに語れ。","tok":[["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["が"],["聞いて","きいて"],["も"],["、"],["聞かなくて","きかなくて"],["も"],["、"],["あなた"],["は"],["わたし"],["の"],["ことば"],["を"],["彼","かれ"],["ら"],["に"],["語れ","かたれ"],["。"]]},{"verse":8,"text":"人の子よ。わたしがあなたに語ることを聞け。反逆の家のようにあなたは逆らってはならない。あなたの口を大きく開いて、わたしがあなたに与えるものを食べよ。」","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["こと"],["を"],["聞け","きけ"],["。"],["反逆","はんぎゃく"],["の"],["家","いえ"],["の"],["よう"],["に"],["あなた"],["は"],["逆らって","さからって"],["は"],["ならない"],["。"],["あなた"],["の"],["口","くち"],["を"],["大きく","おおきく"],["開いて","ひらいて"],["、"],["わたし"],["が"],["あなた"],["に"],["与える","あたえる"],["もの"],["を"],["食べ","たべ"],["よ"],["。"],["」"]]},{"verse":9,"text":"そこで私が見ると、なんと、私のほうに手が伸ばされていて、その中に一つの巻き物があった。","tok":[["そこ"],["で"],["私","わたくし"],["が"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["私","わたくし"],["の"],["ほう"],["に"],["手","て"],["が"],["伸ばされて","のばされて"],["いて"],["、"],["その"],["中","なか"],["に"],["一","ひと"],["つ"],["の"],["巻き物","まきもの"],["が"],["あった"],["。"]]},{"verse":10,"text":"それが私の前で広げられると、その表にも裏にも字が書いてあって、哀歌と、嘆きと、悲しみとがそれに書いてあった。","tok":[["それ"],["が"],["私","わたくし"],["の"],["前","まえ"],["で"],["広げられる","ひろげられる"],["と"],["、"],["その"],["表","ひょう"],["に"],["も"],["裏","うら"],["に"],["も"],["字","じ"],["が"],["書いて","かいて"],["あって"],["、"],["哀歌","あいか"],["と"],["、"],["嘆き","なげき"],["と"],["、"],["悲しみ","かなしみ"],["と"],["が"],["それ"],["に"],["書いて","かいて"],["あった"],["。"]]}]
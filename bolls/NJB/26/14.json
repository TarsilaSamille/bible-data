[{"verse":1,"text":"イスラエルの長老たちの幾人かが来て、私の前にすわった。","tok":[["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["の"],["幾人","いくにん"],["か"],["が"],["来て","きて"],["、"],["私","わたくし"],["の"],["前","まえ"],["に"],["すわった"],["。"]]},{"verse":2,"text":"そのとき、私に次のような主のことばがあった。","tok":[["その"],["とき"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":3,"text":"「人の子よ。これらの者たちは、自分たちの偶像を心の中に秘め、自分たちを不義に引き込むものを、顔の前に置いている。わたしは、どうして彼らの願いを聞いてやれようか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["これ"],["ら"],["の"],["者","もの"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["偶像","ぐうぞう"],["を"],["心","こころ"],["の"],["中","なか"],["に"],["秘め","ひめ"],["、"],["自分","じぶん"],["たち"],["を"],["不義","ふぎ"],["に"],["引き込む","ひきこむ"],["もの"],["を"],["、"],["顔","かお"],["の"],["前","まえ"],["に"],["置いて","おいて"],["いる"],["。"],["わたし"],["は"],["、"],["どう"],["して"],["彼","かれ"],["ら"],["の"],["願い","ねがい"],["を"],["聞いて","きいて"],["やれよう"],["か"],["。"]]},{"verse":4,"text":"それゆえ、彼らに告げよ。神である主はこう仰せられると言え。心の中に偶像を秘め、不義に引き込むものを自分の顔の前に置きながら、預言者のところに来るすべてのイスラエルの家の者には、主であるわたしが、その多くの偶像に応じて答えよう。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["に"],["告げ","つげ"],["よ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["と"],["言え","いえ"],["。"],["心","こころ"],["の"],["中","なか"],["に"],["偶像","ぐうぞう"],["を"],["秘め","ひめ"],["、"],["不義","ふぎ"],["に"],["引き込む","ひきこむ"],["もの"],["を"],["自分","じぶん"],["の"],["顔","かお"],["の"],["前","まえ"],["に"],["置き","おき"],["ながら"],["、"],["預言者","よげんしゃ"],["の"],["ところ"],["に"],["来る","くる"],["すべて"],["の"],["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["に"],["は"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["、"],["その"],["多く","おおく"],["の"],["偶像","ぐうぞう"],["に"],["応じて","おうじて"],["答えよう","こたえよう"],["。"]]},{"verse":5,"text":"偶像のために、みなわたしから離されてしまったイスラエルの家の心をわたしがとらえるためである。","tok":[["偶像","ぐうぞう"],["の"],["ため"],["に"],["、"],["みな"],["わたし"],["から"],["離されて","はなされて"],["しまった"],["イスラエル"],["の"],["家","いえ"],["の"],["心","こころ"],["を"],["わたし"],["が"],["とらえる"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"それゆえ、イスラエルの家に言え。神である主はこう仰せられる。悔い改めよ。偶像を捨て去り、すべての忌みきらうべきものをあなたがたの前から遠ざけよ。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["言え","いえ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["悔い改め","くいあらため"],["よ"],["。"],["偶像","ぐうぞう"],["を"],["捨て去り","すてさり"],["、"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["もの"],["を"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["遠ざけよ","とおざけよ"],["。"]]},{"verse":7,"text":"イスラエルの家の者でも、イスラエルにいる在留異国人でも、だれでもわたしから離れ、心の中に偶像を秘め、不義に引き込むものを顔の前に置きながら、わたしに尋ね求めようと、預言者のところに来る者には、主であるわたしが答えよう。","tok":[["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["で"],["も"],["、"],["イスラエル"],["に"],["いる"],["在留","ざいりゅう"],["異国人","いこくにん"],["で"],["も"],["、"],["だれ"],["で"],["も"],["わたし"],["から"],["離れ","はなれ"],["、"],["心","こころ"],["の"],["中","なか"],["に"],["偶像","ぐうぞう"],["を"],["秘め","ひめ"],["、"],["不義","ふぎ"],["に"],["引き込む","ひきこむ"],["もの"],["を"],["顔","かお"],["の"],["前","まえ"],["に"],["置き","おき"],["ながら"],["、"],["わたし"],["に"],["尋ね求めよう","たずねもとめよう"],["と"],["、"],["預言者","よげんしゃ"],["の"],["ところ"],["に"],["来る","くる"],["者","もの"],["に"],["は"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["答えよう","こたえよう"],["。"]]},{"verse":8,"text":"わたしがそのような者から顔をそむけ、彼をしるしとし、語りぐさとして、わたしの民のうちから彼を断ち滅ぼすとき、あなたがたは、わたしが主であることを知ろう。","tok":[["わたし"],["が"],["その"],["よう"],["な"],["者","もの"],["から"],["顔","かお"],["を"],["そむけ"],["、"],["彼","かれ"],["を"],["しるし"],["と"],["し"],["、"],["語りぐさ","かたりぐさ"],["として"],["、"],["わたし"],["の"],["民","たみ"],["の"],["うち"],["から"],["彼","かれ"],["を"],["断ち","たち"],["滅ぼす","ほろぼす"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":9,"text":"もし預言者が惑わされて、ことばを語るなら、――主であるわたしがその預言者を惑わしたのである――わたしは彼に手を伸ばして、わたしの民イスラエルのうちから彼を根絶やしにする。","tok":[["もし"],["預言者","よげんしゃ"],["が"],["惑わされて","まどわされて"],["、"],["ことば"],["を"],["語るなら","かたるなら"],["、"],["―"],["―"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["その"],["預言者","よげんしゃ"],["を"],["惑わした","まどわした"],["ので"],["ある"],["―"],["―"],["わたし"],["は"],["彼","かれ"],["に"],["手","て"],["を"],["伸ばして","のばして"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["うち"],["から"],["彼","かれ"],["を"],["根絶やし","ねだやし"],["に"],["する"],["。"]]},{"verse":10,"text":"こういう者たちは、自分たちの咎を負う。この預言者の咎は、尋ね求めた者の咎と同じである。","tok":[["こう"],["いう"],["者","もの"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["咎","とが"],["を"],["負う","おう"],["。"],["この"],["預言者","よげんしゃ"],["の"],["咎","とが"],["は"],["、"],["尋ね求めた","たずねもとめた"],["者","もの"],["の"],["咎","とが"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":11,"text":"それは、イスラエルの家が、二度とわたしから迷い出ず、重ねて自分たちのそむきの罪によって自分自身を汚さないためであり、彼らがわたしの民となり、わたしも彼らの神となるためである。――神である主の御告げ――」","tok":[["それ"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["が"],["、"],["二","に"],["度","ど"],["と"],["わたし"],["から"],["迷い出ず","まよいでず"],["、"],["重ねて","かさねて"],["自分","じぶん"],["たち"],["の"],["そむき"],["の"],["罪","つみ"],["によって"],["自分","じぶん"],["自身","じしん"],["を"],["汚さない","よごさない"],["ため"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["も"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["ため"],["で"],["ある"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]},{"verse":12,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":13,"text":"「人の子よ。国が、不信に不信を重ねてわたしに罪を犯し、そのためわたしがその国に手を伸ばし、そこのパンのたくわえをなくし、その国にききんを送り、人間や獣をそこから断ち滅ぼすなら、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["国","くに"],["が"],["、"],["不信","ふしん"],["に"],["不信","ふしん"],["を"],["重ねて","かさねて"],["わたし"],["に"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["その"],["ため"],["わたし"],["が"],["その"],["国","くに"],["に"],["手","て"],["を"],["伸ばし","のばし"],["、"],["そこ"],["の"],["パン"],["の"],["たくわえ"],["を"],["なくし"],["、"],["その"],["国","くに"],["に"],["ききん"],["を"],["送り","おくり"],["、"],["人間","にんげん"],["や"],["獣","けもの"],["を"],["そこ"],["から"],["断ち","たち"],["滅ぼすなら","ほろぼすなら"],["、"]]},{"verse":14,"text":"たとい、そこに、ノアとダニエルとヨブの、これら三人の者がいても、彼らは自分たちの義によって自分たちのいのちを救い出すだけだ。――神である主の御告げ――","tok":[["たとい"],["、"],["そこ"],["に"],["、"],["ノア"],["と"],["ダニエル"],["と"],["ヨブ"],["の"],["、"],["これ"],["ら"],["三人","さんにん"],["の"],["者","もの"],["が"],["いて"],["も"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の
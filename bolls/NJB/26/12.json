[{"verse":1,"text":"ついで、私に次のような主のことばがあった。","tok":[["つい"],["で"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。あなたは反逆の家の中に住んでいる。彼らは反逆の家だから、見る目があるのに見ず、聞く耳があるのに聞こうとしない。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["の"],["中","なか"],["に"],["住んで","すんで"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["、"],["見る","みる"],["目","め"],["が"],["ある"],["のに"],["見ず","みず"],["、"],["聞く","きく"],["耳","みみ"],["が"],["ある"],["のに"],["聞こう","きこう"],["と"],["しない"],["。"]]},{"verse":3,"text":"人の子よ。あなたは捕囚のための荷物を整え、彼らの見ている前で、昼のうちに移れ。彼らの見ている前で、今いる所から他の所へ移れ。もしかしたら、彼らに自分たちが反逆の家であることがわかるかもしれない。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["は"],["捕囚","ほしゅう"],["の"],["ため"],["の"],["荷物","にもつ"],["を"],["整え","ととのえ"],["、"],["彼","かれ"],["ら"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["昼","ひる"],["の"],["うち"],["に"],["移れ","うつれ"],["。"],["彼","かれ"],["ら"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["今","いま"],["いる"],["所","ところ"],["から"],["他","ほか"],["の"],["所","ところ"],["へ"],["移れ","うつれ"],["。"],["もし"],["か"],["したら"],["、"],["彼","かれ"],["ら"],["に"],["自分","じぶん"],["たち"],["が"],["反逆","はんぎゃく"],["の"],["家","いえ"],["で"],["ある"],["こと"],["が"],["わかる"],["か"],["も"],["しれない"],["。"]]},{"verse":4,"text":"あなたは、自分の荷物を昼のうちに彼らの見ている前で、捕囚のための荷物のようにして持ち出し、捕囚に行く人々のように、彼らの見ている前で、夕方、出て行け。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["荷物","にもつ"],["を"],["昼","ひる"],["の"],["うち"],["に"],["彼","かれ"],["ら"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["捕囚","ほしゅう"],["の"],["ため"],["の"],["荷物","にもつ"],["の"],["よう"],["に"],["して"],["持ち出し","もちだし"],["、"],["捕囚","ほしゅう"],["に"],["行く","いく"],["人々","ひとびと"],["の"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["夕方","ゆうがた"],["、"],["出て","でて"],["行け","いけ"],["。"]]},{"verse":5,"text":"彼らの見ている前で、あなたは壁に穴をあけ、そこから出て行け。","tok":[["彼","かれ"],["ら"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["あなた"],["は"],["壁","かべ"],["に"],["穴","あな"
[{"verse":1,"text":"人の子よ。一枚の粘土板を取り、それをあなたの前に置き、その上にエルサレムの町を彫りつけよ。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["一枚","いちまい"],["の"],["粘土","ねんど"],["板","いた"],["を"],["取り","とり"],["、"],["それ"],["を"],["あなた"],["の"],["前","まえ"],["に"],["置き","おき"],["、"],["その"],["上","うえ"],["に"],["エルサレム"],["の"],["町","まち"],["を"],["彫りつけよ","ほりつけよ"],["。"]]},{"verse":2,"text":"それから、それを包囲し、それに向かって塁を築き、塹壕を掘り、陣営を設け、その回りに城壁くずしを配置せよ。","tok":[["それ"],["から"],["、"],["それ"],["を"],["包囲","ほうい"],["し"],["、"],["それ"],["に"],["向かって","むかって"],["塁","るい"],["を"],["築き","きずき"],["、"],["塹壕","ざんごう"],["を"],["掘り","ほり"],["、"],["陣営","じんえい"],["を"],["設け","もうけ"],["、"],["その"],["回り","まわり"],["に"],["城壁","じょうへき"],["くずし"],["を"],["配置","はいち"],["せよ"],["。"]]},{"verse":3,"text":"また、一枚の鉄の平なべを取り、それをあなたと町との間に鉄の壁として立て、あなたの顔をしっかりとこの町に向けよ。この町を包囲し、これを攻め囲め。これがイスラエルの家のしるしだ。","tok":[["また"],["、"],["一枚","いちまい"],["の"],["鉄","てつ"],["の"],["平なべ","ひらなべ"],["を"],["取り","とり"],["、"],["それ"],["を"],["あなた"],["と"],["町","まち"],["と"],["の"],["間","あいだ"],["に"],["鉄","てつ"],["の"],["壁","かべ"],["として"],["立て","たて"],["、"],["あなた"],["の"],["顔","かお"],["を"],["しっかり"],["と"],["この"],["町","まち"],["に"],["向けよ","むけよ"],["。"],["この"],["町","まち"],["を"],["包囲","ほうい"],["し"],["、"],["これ"],["を"],["攻め囲め","せめかこめ"],["。"],["これ"],["が"],["イスラエル"],["の"],["家","いえ"],["の"],["しるし"],["だ"],["。"]]},{"verse":4,"text":"あなたは左わきを下にして横たわり、イスラエルの家の咎を自分の身の上に置け。あなたがそこに横たわっている日数だけ彼らの咎を負え。","tok":[["あなた"],["は"],["左わき","ひだりわき"],["を"],["下","した"],["に"],["して"],["横たわり","よこたわり"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["咎","とが"],["を"],["自分","じぶん"],["の"],["身の上","みのうえ"],["に"],["置け","おけ"],["。"],["あなた"],["が"],["そこ"],["に"],["横たわって","よこたわって"],["いる"],["日数","にっすう"],["だけ"],["彼","かれ"],["ら"],["の"],["咎","とが"],["を"],["負え","おえ"],["。"]]},{"verse":5,"text":"わたしは彼らの咎の年数を日数にして三百九十日とする。その間、あなたはイスラエルの家の咎を負わなければならない。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["咎","とが"],["の"],["年数","ねんすう"],["を"],["日数","にっすう"],["に"],["して"],["三百九十","さんひゃくきゅうとう"],["日","か"],["と"],["する"],["。"],["その"],["間","かん"],["、"],["あなた"],["は"],["イスラエル"],["の"],["家","いえ"],["の"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":6,"text":"あなたがその日数を終えたら、次にまた、あなたの右わきを下にして横たわり、ユダの家の咎を四十日間、負わなければならない。わたしは、あなたのために一年に対して一日とした。","tok":[["あなた"],["が"],["その"],["日数","にっすう"],["を"],["終えたら","おえたら"],["、"],["次","つぎ"],["に"],["また"],["、"],["あなた"],["の"],["右わき","みぎわき"],["を"],["下","した"],["に"],["して"],["横たわり","よこたわり"],["、"],["ユダ"],["の"],["家","いえ"],["の"],["咎","とが"],["を"],["四十日間","しとかかん"],["、"],["負わなければ","おわなければ"],["ならない"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["ため"],["に"],["一","いち"],["年","ねん"],["に対して","にたいして"],["一","いち"],["日","にち"],["と"],["した"],["。"]]},{"verse":7,"text":"それから、あなたは顔を、包囲されているエルサレムのほうにしっかりと向け、腕をまくり、これに向かって預言せよ。","tok":[["それ"],["から"],["、"],["あなた"],["は"],["顔","かお"],["を"],["、"],["包囲","ほうい"],["されて"],["いる"],["エルサレム"],["の"],["ほう"],["に"],["しっかり"],["と"],["向け","むけ"],["、"],["腕","うで"],["を"],["まくり"],["、"],["これ"],["に"],["向かって","むかって"],["預言","よげん"],["せよ"],["。"]]},{"verse":8,"text":"見よ。わたしはあなたになわをかけ、あなたの包囲の期間が終わるまで寝返りができないようにする。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["に"],["なわ"],["を"],["かけ"],["、"],["あなた"],["の"],["包囲","ほうい"],["の"],["期間","きかん"],["が"],["終わる","おわる"],["まで"],["寝返り","ねがえり"],["が"],["できない"],["よう"],["に"],["する"],["。"]]},{"verse":9,"text":"あなたは小麦、大麦、そら豆、レンズ豆、あわ、裸麦を取り、それらを一つの器に入れ、それでパンを作り、あなたがわきを下にして横たわっている日数、すなわち、三百九十日間それを食べよ。","tok":[["あなた"],["は"],["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["そら豆","そらまめ"],["、"],["レンズ"],["豆","まめ"],["、"],["あわ"],["、"],["裸麦","はだかむぎ"],["を"],["取り","とり"],["、"],["それ"],["ら"],["を"],["一","ひと"],["つ"],["の"],["器","うつわ"],["に"],["入れ","いれ"],["、"],["それ"],["で"],["パン"],["を"],["作り","つくり"],["、"],["あなた"],["が"],["わき"],["を"],["下","した"],["に"],["して"],["横たわって","よこたわって"],["いる"],["日数","にっすう"],["、"],["すなわち"],["、"],["三百九十","さんひゃくきゅうとう"],["日間","かかん"],["それ"],["を"],["食べ","たべ"],["よ"],["。"]]},{"verse":10,"text":"あなたが食べる食物は、一日分二十シェケルを量って、一日一回それを食べよ。","tok":[["あなた"],["が"],["食べる","たべる"],["食物","しょくもつ"],["は"],["、"],["一","いち"],["日","にち"],["分","ぶん"],["二十","にじゅう"],["シェケル"],["を"],["量って","はかって"],["、"],["一","いち"],["日","にち"],["一回","いちかい"],["それ"],["を"],["食べ","たべ"],["よ"],["。"]]},{"verse":11,"text":"あなたの飲む水も、一日分一ヒンの六分の一を量って、それを一日一回飲め。","tok":[["あなた"],["の"],["飲む","のむ"],["水","みず"],["も"],["、"],["一","いち"],["日","にち"],["分","ぶん"],["一","いち"],["ヒン"],["の"],["六分","ろくぶん"],["の"],["一","いち"],["を"],["量って","はかって"],["、"],["それ"],["を"],["一","いち"],["日","にち"],["一回","いちかい"],["飲め","のめ"],["。"]]},{"verse":12,"text":"あなたの食物は大麦のパン菓子のようにして食べよ。それを彼らの目の前で、人の糞で焼け。」","tok":[["あなた"],["の"],["食物","しょくもつ"],["は"],["大麦","おおむぎ"],["の"],["パン"],["菓子","かし"],["の"],["よう"],["に"],["して"],["食べ","たべ"],["よ"],["。"],["それ"],["を"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["人","ひと"],["の"],["糞","ふん"],["で"],["焼け","やけ"],["。"],["」"]]},{"verse":13,"text":"それから主は仰せられた。「このように、イスラエルの民は、わたしが追いやる国々の中で、彼らの汚れたパンを食べなければならない。」","tok":[["それ"],["から"],["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["この"],["よう"],["に"],["、"],["イスラエル"],["の"],["民","たみ"],["は"],["、"],["わたし"],["が"],["追いやる","おいやる"],["国々","くにぐに"],["の"],["中","なか"],["で"],["、"],["彼","かれ"],["ら"],["の"],["汚れた","よごれた"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["」"]]},{"verse":14,"text":"そこで、私は言った。「ああ、神、主よ。私はかつて、自分を汚したことはありません。幼い時から今まで、死んだ獣や、野獣に裂き殺されたものを食べたことはありません。また、いけにえとして汚れている肉を口にしたこともありません。」","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["は"],["かつて"],["、"],["自分","じぶん"],["を"],["汚した","よごした"],["こと"],["は"],["ありません"],["。"],["幼い","おさない"],["時","とき"],["から"],["今まで","いままで"],["、"],["死んだ","しんだ"],["獣","けもの"],["や"],["、"],["野獣","やじゅう"],["に"],["裂き","さき"],["殺された","ころされた"],["もの"],["を"],["食べた","たべた"],["こと"],["は"],["ありません"],["。"],["また"],["、"],["いけにえ"],["として"],["汚れて","よごれて"],["いる"],["肉","にく"],["を"],["口","くち"],["に"],["した"],["こと"],["も"],["ありません"],["。"],["」"]]},{"verse":15,"text":"すると、主は私に仰せられた。「では、人の糞の代わりに牛の糞でやらせよう。あなたはその上で自分のパンを焼け。」","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["で"],["は"],["、"],["人","ひと"],["の"],["糞","ふん"],["の"],["代わり","かわり"],["に"],["牛","うし"],["の"],["糞","ふん"],["で"],["やらせよう"],["。"],["あなた"],["は"],["その"],["上","うえ"],["で"],["自分","じぶん"],["の"],["パン"],["を"],["焼け","やけ"],["。"],["」"]]},{"verse":16,"text":"そして、私に仰せられた。「人の子よ。見よ。わたしはエルサレムで、パンのたくわえをなくしてしまおう。それで彼らはこわごわパンを量って食べ、おびえながら水を量って飲むであろう。","tok":[["そして"],["、"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["エルサレム"],["で"],["、"],["パン"],["の"],["たくわえ"],["を"],["なくして"],["しまおう"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["は"],["こわごわ"],["パン"],["を"],["量って","はかって"],["食べ","たべ"],["、"],["おびえ"],["ながら"],["水","みず"],["を"],["量って","はかって"],["飲むで","のむで"],["あろう"],["。"]]},{"verse":17,"text":"それはパンと水が乏しくなるからだ。彼らは自分たちの咎のために、みなやせ衰え、朽ち果てよう。","tok":[["それ"],["は"],["パン"],["と"],["水","みず"],["が"],["乏しく","とぼしく"],["なる"],["から"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["咎","とが"],["の"],["ため"],["に"],["、"],["みな"],["やせ衰え","やせおとろえ"],["、"],["朽ち","くち"],["果てよう","はてよう"],["。"]]}]
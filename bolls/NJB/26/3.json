[{"verse":1,"text":"その方は私に仰せられた。「人の子よ。あなたの前にあるものを食べよ。この巻き物を食べ、行って、イスラエルの家に告げよ。」","tok":[["その"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["あなた"],["の"],["前","まえ"],["に"],["ある"],["もの"],["を"],["食べ","たべ"],["よ"],["。"],["この"],["巻き物","まきもの"],["を"],["食べ","たべ"],["、"],["行って","いって"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["告げ","つげ"],["よ"],["。"],["」"]]},{"verse":2,"text":"そこで、私が口をあけると、その方は私にその巻き物を食べさせ、","tok":[["そこ"],["で"],["、"],["私","わたくし"],["が"],["口","くち"],["を"],["あける"],["と"],["、"],["その"],["方","かた"],["は"],["私","わたくし"],["に"],["その"],["巻き物","まきもの"],["を"],["食べさせ","たべさせ"],["、"]]},{"verse":3,"text":"そして仰せられた。「人の子よ。わたしがあなたに与えるこの巻き物で腹ごしらえをし、あなたの腹を満たせ。」そこで、私はそれを食べた。すると、それは私の口の中で蜜のように甘かった。","tok":[["そして"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["わたし"],["が"],["あなた"],["に"],["与える","あたえる"],["この"],["巻き物","まきもの"],["で"],["腹ごしらえ","はらごしらえ"],["を"],["し"],["、"],["あなた"],["の"],["腹","はら"],["を"],["満たせ","みたせ"],["。"],["」"],["そこ"],["で"],["、"],["私","わたくし"],["は"],["それ"],["を"],["食べた","たべた"],["。"],["する"],["と"],["、"],["それ"],["は"],["私","わたくし"],["の"],["口","くち"],["の"],["中","なか"],["で"],["蜜","みつ"],["の"],["よう"],["に"],["甘かった","あまかった"],["。"]]},{"verse":4,"text":"その方はまた、私に仰せられた。「人の子よ。さあ、イスラエルの家に行き、わたしのことばのとおりに彼らに語れ。","tok":[["その"],["方","かた"],["は"],["また"],["、"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["さあ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["わたし"],["の"],["ことば"],["の"],["とおり"],["に"],["彼","かれ"],["ら"],["に"],["語れ","かたれ"],["。"]]},{"verse":5,"text":"わたしはあなたを、むずかしい外国語を話す民に遣わすのではなく、イスラエルの家に遣わすのだ。","tok":[["わたし"],["は"],["あなた"],["を"],["、"],["むずかしい"],["外国語","がいこくご"],["を"],["話す","はなす"],["民","たみ"],["に"],["遣わす","つかわす"],["ので"],["は"],["なく"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["遣わす","つかわす"],["の"],["だ"],["。"]]},{"verse":6,"text":"あなたを、そのことばを聞いてもわからないようなむずかしい外国語を話す多くの国々の民に、遣わすのではない。もし、これらの民にあなたを遣わすなら、彼らはあなたの言うことを聞くであろう。","tok":[["あなた"],["を"],["、"],["その"],["ことば"],["を"],["聞いて","きいて"],["も"],["わからない"],["よう"],["な"],["むずかしい"],["外国語","がいこくご"],["を"],["話す","はなす"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["に"],["、"],["遣わす","つかわす"],["ので"],["は"],["ない"],["。"],["もし"],["、"],["これ"],["ら"],["の"],["民","たみ"],["に"],["あなた"],["を"],["遣わすなら","つかわすなら"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["言う","いう"],["こと"],["を"],["聞くで","きくで"],["あろう"],["。"]]},{"verse":7,"text":"しかし、イスラエルの家はあなたの言うことを聞こうとはしない。彼らはわたしの言うことを聞こうとはしないからだ。イスラエルの全家は鉄面皮で、心がかたくなだからだ。","tok":[["しかし"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["あなた"],["の"],["言う","いう"],["こと"],["を"],["聞こう","きこう"],["と"],["は"],["しない"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞こう","きこう"],["と"],["は"],["しない"],["から"],["だ"],["。"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["は"],["鉄面皮","てつめんぴ"],["で"],["、"],["心","こころ"],["が"],["かたくな"],["だ"],["から"],["だ"],["。"]]},{"verse":8,"text":"見よ。わたしはあなたの顔を、彼らの顔と同じように堅くし、あなたの額を、彼らの額と同じように堅くする。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["の"],["顔","かお"],["を"],["、"],["彼","かれ"],["ら"],["の"],["顔","かお"],["と"],["同じ","おなじ"],["よう"],["に"],["堅く","かたく"],["し"],["、"],["あなた"],["の"],["額","がく"],["を"],["、"],["彼","かれ"],["ら"],["の"],["額","がく"],["と"],["同じ","おなじ"],["よう"],["に"],["堅く","かたく"],["する"],["。"]]},{"verse":9,"text":"わたしはあなたの額を、火打石よりも堅い金剛石のようにする。彼らは反逆の家だから、彼らを恐れるな。彼らの顔にひるむな。」","tok":[["わたし"],["は"],["あなた"],["の"],["額","がく"],["を"],["、"],["火打石","ひうちいし"],["より"],["も"],["堅い","かたい"],["金剛石","こんごうせき"],["の"],["よう"],["に"],["する"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["を"],["恐れる","おそれる"],["な"],["。"],["彼","かれ"],["ら"],["の"],["顔","かお"],["に"],["ひるむ"],["な"],["。"],["」"]]},{"verse":10,"text":"その方は私に仰せられた。「人の子よ。わたしがあなたに告げるすべてのことばを、あなたの心に納め、あなたの耳で聞け。","tok":[["その"],["方","かた"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["わたし"],["が"],["あなた"],["に"],["告げる","つげる"],["すべて"],["の"],["ことば"],["を"],["、"],["あなた"],["の"],["心","こころ"],["に"],["納め","おさめ"],["、"],["あなた"],["の"],["耳","みみ"],["で"],["聞け","きけ"],["。"]]},{"verse":11,"text":"さあ、捕囚になっているあなたの民のところへ行って、彼らに告げよ。彼らが聞いても、聞かなくても、『神である主はこう仰せられる』と彼らに言え。」","tok":[["さあ"],["、"],["捕囚","ほしゅう"],["に"],["なって"],["いる"],["あなた"],["の"],["民","たみ"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["彼","かれ"],["ら"],["に"],["告げ","つげ"],["よ"],["。"],["彼","かれ"],["ら"],["が"],["聞いて","きいて"],["も"],["、"],["聞かなくて","きかなくて"],["も"],["、"],["『"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["』"],["と"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["」"]]},{"verse":12,"text":"それから、霊が私を引き上げた。そのとき、私は、うしろのほうで、「御住まいの主の栄光はほむべきかな」という大きなとどろきの音を聞いた。","tok":[["それ"],["から"],["、"],["霊","れい"],["が"],["私","わたくし"],["を"],["引き上げた","ひきあげた"],["。"],["その"],["とき"],["、"],["私","わたくし"],["は"],["、"],["うしろ"],["の"],["ほう"],["で"],["、"],["「"],["御住まい","おすまい"],["の"],["主","ぬし"],["の"],["栄光","えいこう"],["は"],["ほ"],["むべき"],["か"],["な"],["」"],["と"],["いう"],["大きな","おおきな"],["とどろき"],["の"],["音","おと"],["を"],["聞いた","きいた"],["。"]]},{"verse":13,"text":"それは、互いに触れ合う生きものたちの翼の音と、そのそばの輪の音で、大きなとどろきの音であった。","tok":[["それ"],["は"],["、"],["互い","たがい"],["に"],["触れ合う","ふれあう"],["生きもの","いきもの"],["たち"],["の"],["翼","つばさ"],["の"],["音","おと"],["と"],["、"],["その"],["そば"],["の"],["輪","わ"],["の"],["音","おと"],["で"],["、"],["大きな","おおきな"],["とどろき"],["の"],["音","おと"],["で"],["あった"],["。"]]},{"verse":14,"text":"霊が私を持ち上げ、私を捕らえたので、私は憤って、苦々しい思いで出て行った。しかし、主の御手が強く私の上にのしかかっていた。","tok":[["霊","れい"],["が"],["私","わたくし"],["を"],["持ち上げ","もちあげ"],["、"],["私","わたくし"],["を"],["捕らえた","とらえた"],["ので"],["、"],["私","わたくし"],["は"],["憤って","いきどおって"],["、"],["苦々しい","にがにがしい"],["思い","おもい"],["で"],["出て","でて"],["行った","いった"],["。"],["しかし"],["、"],["主","ぬし"],["の"],["御手","おて"],["が"],["強く","つよく"],["私","わたくし"],["の"],["上","うえ"],["に"],["のしかかって"],["いた"],["。"]]},{"verse":15,"text":"そこで、私はテル・アビブの捕囚の民のところへ行った。彼らはケバル川のほとりに住んでいたので、私は彼らが住んでいるその所で、七日間、ぼう然として、彼らの中にとどまっていた。","tok":[["そこ"],["で"],["、"],["私","わたくし"],["は"],["テル・アビブ"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["の"],["ところ"],["へ"],["行った","いった"],["。"],["彼","かれ"],["ら"],["は"],["ケバル"],["川","かわ"],["の"],["ほとり"],["に"],["住んで","すんで"],["いた"],["ので"],["、"],["私","わたくし"],["は"],["彼","かれ"],["ら"],["が"],["住んで","すんで"],["いる"],["その"],["所","ところ"],["で"],["、"],["七","なな"],["日間","かかん"],["、"],["ぼう然","ぼうぜん"],["として"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["とどまって"],["いた"],["。"]]},{"verse":16,"text":"七日目の終わりになって、私に次のような主のことばがあった。","tok":[["七日目","ななかめ"],["の"],["終わり","おわり"],["に"],["なって"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":17,"text":"「人の子よ。わたしはあなたをイスラエルの家の見張り人とした。あなたは、わたしの口からことばを聞くとき、わたしに代わって彼らに警告を与えよ。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["わたし"],["は"],["あなた"],["を"],["イスラエル"],["の"],["家","いえ"],["の"],["見張り","みはり"],["人","ひと"],["と"],["した"],["。"],["あなた"],["は"],["、"],["わたし"],["の"],["口","くち"],["から"],["ことば"],["を"],["聞く","きく"],["とき"],["、"],["わたし"],["に"],["代わって","かわって"],["彼","かれ"],["ら"],["に"],["警告","けいこく"],["を"],["与え","あたえ"],["よ"],["。"]]},{"verse":18,"text":"わたしが悪者に、『あなたは必ず死ぬ』と言うとき、もしあなたが彼に警告を与えず、悪者に悪の道から離れて生きのびるように語って、警告しないなら、その悪者は自分の不義のために死ぬ。そして、わたしは彼の血の責任をあなたに問う。","tok":[["わたし"],["が"],["悪者","わるもの"],["に"],["、"],["『"],["あなた"],["は"],["必ず","かならず"],["死ぬ","しぬ"],["』"],["と"],["言う","いう"],["とき"],["、"],["もし"],["あなた"],["が"],["彼","かれ"],["に"],["警告","けいこく"],["を"],["与えず","あたえず"],["、"],["悪者","わるもの"],["に"],["悪","あく"],["の"],["道","みち"],["から"],["離れて","はなれて"],["生きのびる","いきのびる"],["よう"],["に"],["語って","かたって"],["、"],["警告","けいこく"],["しないなら"],["、"],["その"],["悪者","わるもの"],["は"],["自分","じぶん"],["の"],["不義","ふぎ"],["の"],["ため"],["に"],["死ぬ","しぬ"],["。"],["そして"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["血","ち"],["の"],["責任","せきにん"],["を"],["あなた"],["に"],["問う","とう"],["。"]]},{"verse":19,"text":"もしあなたが悪者に警告を与えても、彼がその悪を悔い改めず、その悪の道から立ち返らないなら、彼は自分の不義のために死ななければならない。しかしあなたは自分のいのちを救うことになる。","tok":[["もし"],["あなた"],["が"],["悪者","わるもの"],["に"],["警告","けいこく"],["を"],["与えて","あたえて"],["も"],["、"],["彼","かれ"],["が"],["その"],["悪","あく"],["を"],["悔い改めず","くいあらためず"],["、"],["その"],["悪","あく"],["の"],["道","みち"],["から"],["立ち返らないなら","たちかえらないなら"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["不義","ふぎ"],["の"],["ため"],["に"],["死ななければ","しななければ"],["ならない"],["。"],["しかし"],["あなた"],["は"],["自分","じぶん"],["の"],["いのち"],["を"],["救う","すくう"],["こと"],["に"],["なる"],["。"]]},{"verse":20,"text":"もし、正しい人がその正しい行いをやめて、不正を行うなら、わたしは彼の前につまずきを置く。彼は死ななければならない。それはあなたが彼に警告を与えなかったので、彼は自分の罪のために死に、彼が行った正しい行いも覚えられないのである。わたしは、彼の血の責任をあなたに問う。","tok":[["もし"],["、"],["正しい","ただしい"],["人","ひと"],["が"],["その"],["正しい","ただしい"],["行い","おこない"],["を"],["やめて"],["、"],["不正","ふせい"],["を"],["行うなら","おこなうなら"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["前","まえ"],["に"],["つまずき"],["を"],["置く","おく"],["。"],["彼","かれ"],["は"],["死ななければ","しななければ"],["ならない"],["。"],["それ"],["は"],["あなた"],["が"],["彼","かれ"],["に"],["警告","けいこく"],["を"],["与えなかった","あたえなかった"],["ので"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ため"],["に"],["死に","しに"],["、"],["彼","かれ"],["が"],["行った","おこなった"],["正しい","ただしい"],["行い","おこない"],["も"],["覚えられない","おぼえられない"],["ので"],["ある"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["の"],["血","ち"],["の"],["責任","せきにん"],["を"],["あなた"],["に"],["問う","とう"],["。"]]},{"verse":21,"text":"しかし、もしあなたが正しい人に罪を犯さないように警告を与えて、彼が罪を犯さないようになれば、彼は警告を受けたのであるから、彼は生きながらえ、あなたも自分のいのちを救うことになる。」","tok":[["しかし"],["、"],["もし"],["あなた"],["が"],["正しい","ただしい"],["人","ひと"],["に"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["警告","けいこく"],["を"],["与えて","あたえて"],["、"],["彼","かれ"],["が"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["なれば"],["、"],["彼","かれ"],["は"],["警告","けいこく"],["を"],["受けた","うけた"],["ので"],["ある"],["から"],["、"],["彼","かれ"],["は"],["生きながらえ","いきながらえ"],["、"],["あなた"],["も"],["自分","じぶん"],["の"],["いのち"],["を"],["救う","すくう"],["こと"],["に"],["なる"],["。"],["」"]]},{"verse":22,"text":"その所で主の御手が私の上にあった。主は私に仰せられた。「さあ、谷間に出て行け。そこでわたしはあなたに語ろう。」","tok":[["その"],["所","ところ"],["で"],["主","ぬし"],["の"],["御手","おて"],["が"],["私","わたくし"],["の"],["上","うえ"],["に"],["あった"],["。"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["さあ"],["、"],["谷間","たにま"],["に"],["出て","でて"],["行け","いけ"],["。"],["そこ"],["で"],["わたし"],["は"],["あなた"],["に"],["語ろう","かたろう"],["。"],["」"]]},{"verse":23,"text":"私はすぐ、谷間に出て行った。すると、そこに、主の栄光が、かつて私がケバル川のほとりで見た栄光のように、現れた。それで私はひれ伏した。","tok":[["私","わたくし"],["は"],["すぐ"],["、"],["谷間","たにま"],["に"],["出て","でて"],["行った","いった"],["。"],["する"],["と"],["、"],["そこ"],["に"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["、"],["かつて"],["私","わたくし"],["が"],["ケバル"],["川","かわ"],["の"],["ほとり"],["で"],["見た","みた"],["栄光","えいこう"],["の"],["よう"],["に"],["、"],["現れた","あらわれた"],["。"],["それ"],["で"],["私","わたくし"],["は"],["ひれ伏した","ひれふした"],["。"]]},{"verse":24,"text":"しかし、霊が私のうちに入り、私を立ち上がらせた。主は私に語りかけて仰せられた。「行って、あなたの家に閉じこもっていよ。","tok":[["しかし"],["、"],["霊","れい"],["が"],["私","わたくし"],["の"],["うち"],["に"],["入り","はいり"],["、"],["私","わたくし"],["を"],["立ち上がらせた","たちあがらせた"],["。"],["主","ぬし"],["は"],["私","わたくし"],["に"],["語りかけて","かたりかけて"],["仰せられた","おおせられた"],["。"],["「"],["行って","いって"],["、"],["あなた"],["の"],["家","いえ"],["に"],["閉じこもって","とじこもって"],["い"],["よ"],["。"]]},{"verse":25,"text":"人の子よ。今、あなたに、なわがかけられ、あなたはそれで縛られて、彼らのところに出て行けなくなる。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["今","いま"],["、"],["あなた"],["に"],["、"],["なわ"],["が"],["かけられ"],["、"],["あなた"],["は"],["それ"],["で"],["縛られて","しばられて"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["出て","でて"],["行けなく","いけなく"],["なる"],["。"]]},{"verse":26,"text":"わたしがあなたの舌を上あごにつかせるので、あなたは話せなくなり、彼らを責めることができなくなる。彼らが反逆の家だからだ。","tok":[["わたし"],["が"],["あなた"],["の"],["舌","した"],["を"],["上あご","うわあご"],["に"],["つかせる"],["ので"],["、"],["あなた"],["は"],["話せなく","はなせなく"],["なり"],["、"],["彼","かれ"],["ら"],["を"],["責める","せめる"],["こと"],["が"],["できなく"],["なる"],["。"],["彼","かれ"],["ら"],["が"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["だ"],["。"]]},{"verse":27,"text":"しかし、わたしは、あなたと語るときあなたの口を開く。あなたは彼らに、『神である主はこう仰せられる』と言え。聞く者には聞かせ、聞かない者には聞かせるな。彼らが反逆の家だからだ。","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["あなた"],["と"],["語る","かたる"],["とき"],["あなた"],["の"],["口","くち"],["を"],["開く","ひらく"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["、"],["『"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["』"],["と"],["言え","いえ"],["。"],["聞く","きく"],["者","もの"],["に"],["は"],["聞かせ","きかせ"],["、"],["聞かない","きかない"],["者","もの"],["に"],["は"],["聞かせる","きかせる"],["な"],["。"],["彼","かれ"],["ら"],["が"],["反逆","はんぎゃく"],["の"],["家"
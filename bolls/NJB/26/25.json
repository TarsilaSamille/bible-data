[{"verse":1,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。顔をアモン人に向け、彼らに預言せよ。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["顔","かお"],["を"],["アモン人","あもんにん"],["に"],["向け","むけ"],["、"],["彼","かれ"],["ら"],["に"],["預言","よげん"],["せよ"],["。"]]},{"verse":3,"text":"あなたはアモン人に言え。神である主のことばを聞け。神である主はこう仰せられる。わたしの聖所が汚されたとき、イスラエルの地が荒れ果てたとき、ユダの家が捕囚となって行ったとき、あなたは、あはは、と言ってあざけった。","tok":[["あなた"],["は"],["アモン人","あもんにん"],["に"],["言え","いえ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["の"],["聖","せい"],["所","しょ"],["が"],["汚された","よごされた"],["とき"],["、"],["イスラエル"],["の"],["地","ち"],["が"],["荒れ果てた","あれはてた"],["とき"],["、"],["ユダ"],["の"],["家","いえ"],["が"],["捕囚","ほしゅう"],["と"],["なって"],["行った","いった"],["とき"],["、"],["あなた"],["は"],["、"],["あはは"],["、"],["と"],["言って","いって"],["あざけった"],["。"]]},{"verse":4,"text":"それゆえ、わたしは、あなたを東の人々に渡して、彼らの所有とする。彼らはあなたのうちに宿営を張り、あなたのうちに住まいを作り、あなたの産物を食べ、あなたの乳を飲むようになる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["あなた"],["を"],["東","ひがし"],["の"],["人々","ひとびと"],["に"],["渡して","わたして"],["、"],["彼","かれ"],["ら"],["の"],["所有","しょゆう"],["と"],["する"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["うち"],["に"],["宿営","しゅくえい"],["を"],["張り","はり"],["、"],["あなた"],["の"],["うち"],["に"],["住まい","すまい"],["を"],["作り","つくり"],["、"],["あなた"],["の"],["産物","さんぶつ"],["を"],["食べ","たべ"],["、"],["あなた"],["の"],["乳","ちち"],["を"],["飲む","のむ"],["よう"],["に"],["なる"],["。"]]},{"verse":5,"text":"わたしがラバを、らくだの牧場とし、アモン人の地を羊のおりとするとき、あなたがたは、わたしが主であることを知ろう。","tok":[["わたし"],["が"],["ラバ"],["を"],["、"],["らくだ"],["の"],["牧場","ぼくじょう"],["と"],["し"],["、"],["アモン人","あもんにん"],["の"],["地","ち"],["を"],["羊","ひつじ"],["の"],["おり"],["と"],["する"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":6,"text":"まことに、神である主はこう仰せられる。あなたは手を打ち、足を踏み鳴らし、イスラエルの地を心の底からあざけって喜んだ。","tok":[["まこと"],["に"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["あなた"],["は"],["手","て"],["を"],["打ち","うち"],["、"],["足","あし"],["を"],["踏み鳴らし","ふみならし"],["、"],["イスラエル"],["の"],["地","ち"],["を"],["心","こころ"],["の"],["底","そこ"],["から"],["あざけって"],["喜んだ","よろこんだ"],["。"]]},{"verse":7,"text":"それゆえ、わたしは、あなたに手を伸ばし、異邦の民にあなたをえじきとして与え、あなたを国々の民の中から断ち滅ぼし、国々の間から消えうせさせる。このとき、あなたは、わたしが主であることを知ろう。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["あなた"],["に"],["手","て"],["を"],["伸ばし","のばし"],["、"],["異邦","いほう"],["の"],["民","たみ"],["に"],["あなた"],["を"],["えじき"],["として"],["与え","あたえ"],["、"],["あなた"],["を"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["断ち","たち"],["滅ぼし","ほろぼし"],["、"],["国々","くにぐに"],["の"],["間","あいだ"],["から"],["消えうせさせる","きえうせさせる"],["。"],["この"],["とき"],["、"],["あなた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":8,"text":"神である主はこう仰せられる。モアブとセイルは、『見よ、ユダの家は異邦の民と変わらない』と言った。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["モアブ"],["と"],["セイル"],["は"],["、"],["『"],["見よ","みよ"],["、"],["ユダ"],["の"],["家","いえ"],["は"],["異邦","いほう"],["の"],["民","たみ"],["と"],["変わらない","かわらない"],["』"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"それゆえ、わたしは、モアブの山地の町々、その国の誉れであるベテ・ハエシモテ、バアル・メオン、キルヤタイムの町々をことごとくあけ放ち、","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["、"],["モアブ"],["の"],["山地","さんち"],["の"],["町々","まちまち"],["、"],["その"],["国","くに"],["の"],["誉れ","ほまれ"],["で"],["ある"],["ベテ"],["・"],["ハエシモテ"],["、"],["バアル"],["・"],["メオン"],["、"],["キルヤタイム"],["の"],["町々","まちまち"],["を"],["ことごとく"],["あけ放ち","あけはなち"],["、"]]},{"verse":10,"text":"アモン人といっしょに、東の人々に渡して、その所有とし、諸国の民の間でアモン人が記憶されないようにする。","tok":[["アモン人","あもんにん"],["と"],["いっしょ"],["に"],["、"],["東","ひがし"],["の"],["人々","ひとびと"],["に"],["渡して","わたして"],["、"],["その"],["所有","しょゆう"],["と"],["し"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["間","あいだ"],["で"],["アモン人","あもんにん"],["が"],["記憶","きおく"],["されない"],["よう"],["に"],["する"],["。"]]},{"verse":11,"text":"わたしがモアブにさばきを下すとき、彼らは、わたしが主であることを知ろう。","tok":[["わたし"],["が"],["モアブ"],["に"],["さばき"],["を"],["下す","くだす"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":12,"text":"神である主はこう仰せられる。エドムはユダの家に復讐を企て、罪を犯し続け、復讐をした。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["エドム"],["は"],["ユダ"],["の"],["家","いえ"],["に"],["復讐","ふくしゅう"],["を"],["企て","くわだて"],["、"],["罪","つみ"],["を"],["犯し","おかし"],["続け","つづけ"],["、"],["復讐","ふくしゅう"],["を"],["した"],["。"]]},{"verse":13,"text":"それゆえ、神である主はこう仰せられる。わたしはエドムに手を伸ばし、そこから人も獣も断ち滅ぼし、そこを廃墟にする。テマンからデダンに至るまで人々は剣で倒される。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["エドム"],["に"],["手","て"],["を"],["伸ばし","のばし"],["、"],["そこ"],["から"],["人","ひと"],["も"],["獣","けもの"],["も"],["断ち","たち"],["滅ぼし","ほろぼし"],["、"],["そこ"],["を"],["廃墟","はいきょ"],["に"],["する"],["。"],["テマン"],["から"],["デダン"],["に"],["至る","いたる"],["まで"],["人々","ひとびと"],["は"],["剣","けん"],["で"],["倒される","たおされる"],["。"]]},{"verse":14,"text":"わたしは、わたしの民イスラエルの手によってエドムに復讐する。わたしの怒りと憤りのままに彼らがエドムに事を行うとき、エドムは、わたしが復讐するということを知る。――神である主の御告げ――","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["手","て"],["によって"],["エドム"],["に"],["復讐","ふくしゅう"],["する"],["。"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["の"],["まま"],["に"],["彼","かれ"],["ら"],["が"],["エドム"],["に"],["事","こと"],["を"],["行う","おこなう"],["とき"],["、"],["エドム"],["は"],["、"],["わたし"],["が"],["復讐","ふくしゅう"],["する"],["と"],["いう"],["こと"],["を"],["知る","しる"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":15,"text":"神である主はこう仰せられる。ペリシテ人は、復讐を企て、心の底からあざけって、ひどい復讐をし、いつまでも敵意をもって滅ぼそうとした。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["ペリシテ"],["人","にん"],["は"],["、"],["復讐","ふくしゅう"],["を"],["企て","くわだて"],["、"],["心","こころ"],["の"],["底","そこ"],["から"],["あざけって"],["、"],["ひどい"],["復讐","ふくしゅう"],["を"],["し"],["、"],["いつ"],["まで"],["も"],["敵意","てきい"],["を"],["もって"],["滅ぼそう","ほろぼそう"],["と"],["した"],["。"]]},{"verse":16,"text":"それゆえ神である主はこう仰せられる。見よ。わたしは、ペリシテ人に手を伸ばし、ケレテ人を断ち滅ぼし、海辺の残った者を消えうせさせる。","tok":[["それ"],["ゆえ"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["ペリシテ"],["人","にん"],["に"],["手","て"],["を"],["伸ばし","のばし"],["、"],["ケレテ人","けれてにん"],["を"],["断ち","たち"],["滅ぼし","ほろぼし"],["、"],["海辺","うみべ"],["の"],["残った","のこった"],["者","もの"],["を"],["消えうせさせる","きえうせさせる"],["。"]]},{"verse":17,"text":"わたしは憤って彼らを責め、ひどい復讐をする。彼らは、わたしが彼らに復讐するとき、わたしが主であることを知ろう。」","tok":[["わたし"],["は"],["憤って","いきどおって"],["彼","かれ"],["ら"],["を"],["責め","せめ"],["、"],["ひどい"],["復讐","ふくしゅう"],["を"],["する"],["。"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["復讐","ふくしゅう"],["する"],["とき"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"],["」"]]}]
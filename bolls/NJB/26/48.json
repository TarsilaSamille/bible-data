[{"verse":1,"text":"部族の名は次のとおりである。北の端からヘテロンの道を経てレボ・ハマテに至り、ハマテを経て北のほうへダマスコの境界のハツァル・エナンまで――東側から西側まで――これがダンの分である。","tok":[["部族","ぶぞく"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["北","きた"],["の"],["端","はし"],["から"],["ヘテロン"],["の"],["道","みち"],["を"],["経て","へて"],["レボ"],["・"],["ハマテ"],["に"],["至り","いたり"],["、"],["ハマテ"],["を"],["経て","へて"],["北","きた"],["の"],["ほう"],["へ"],["ダマスコ"],["の"],["境界","きょうかい"],["の"],["ハツァル"],["・"],["エナン"],["まで"],["―"],["―"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["―"],["―"],["これ"],["が"],["ダン"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":2,"text":"ダンの地域に接して、東側から西側までがアシェルの分。","tok":[["ダン"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["アシェル"],["の"],["分","ぶん"],["。"]]},{"verse":3,"text":"アシェルの地域に接して、東側から西側までがナフタリの分。","tok":[["アシェル"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["ナフタリ"],["の"],["分","ぶん"],["。"]]},{"verse":4,"text":"ナフタリの地域に接して、東側から西側までがマナセの分。","tok":[["ナフタリ"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["マナセ"],["の"],["分","ぶん"],["。"]]},{"verse":5,"text":"マナセの地域に接して、東側から西側までがエフライムの分。","tok":[["マナセ"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["エフライム"],["の"],["分","ぶん"],["。"]]},{"verse":6,"text":"エフライムの地域に接して、東側から西側までがルベンの分。","tok":[["エフライム"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["ルベン"],["の"],["分","ぶん"],["。"]]},{"verse":7,"text":"ルベンの地域に接して、東側から西側までがユダの分である。","tok":[["ルベン"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["ユダ"],["の"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":8,"text":"ユダの地域に接して、東側から西側までが、あなたがたのささげる奉納地となる。その幅は二万五千キュビト、その長さは東側から西側にかけて部族の割り当て地の一つと同じである。聖所はその中央にある。","tok":[["ユダ"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["、"],["あなた"],["がた"],["の"],["ささげる"],["奉納","ほうのう"],["地","ち"],["と"],["なる"],["。"],["その"],["幅","はば"],["は"],["二万五千","にまんごせん"],["キュビト"],["、"],["その"],["長さ","ながさ"],["は"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["に"],["かけて"],["部族","ぶぞく"],["の"],["割り当て","わりあて"],["地","ち"],["の"],["一","ひと"],["つ"],["と"],["同じ","おなじ"],["で"],["ある"],["。"],["聖","せい"],["所","しょ"],["は"],["その"],["中央","ちゅうおう"],["に"],["ある"],["。"]]},{"verse":9,"text":"あなたがたが主にささげる奉納地は、長さ二万五千キュビト、幅二万キュビトである。","tok":[["あなた"],["がた"],["が"],["主に","おもに"],["ささげる"],["奉納","ほうのう"],["地","ち"],["は"],["、"],["長さ","ながさ"],["二万五千","にまんごせん"],["キュビト"],["、"],["幅","はば"],["二万","にまん"],["キュビト"],["で"],["ある"],["。"]]},{"verse":10,"text":"祭司たちへの聖なる奉納地は次のとおりである。北側は二万五千キュビト、西側は一万キュビトの幅、東側は一万キュビトの幅、南側は二万五千キュビトの長さである。主の聖所はその中央にある。","tok":[["祭司","さいし"],["たち"],["へ"],["の"],["聖","せい"],["なる"],["奉納","ほうのう"],["地","ち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["北側","きたがわ"],["は"],["二万五千","にまんごせん"],["キュビト"],["、"],["西側","にしがわ"],["は"],["一万","いちまん"],["キュビト"],["の"],["幅","はば"],["、"],["東側","ひがしがわ"],["は"],["一万","いちまん"],["キュビト"],["の"],["幅","はば"],["、"],["南側","みなみがわ"],["は"],["二万五千","にまんごせん"],["キュビト"],["の"],["長さ","ながさ"],["で"],["ある"],["。"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["は"],["その"],["中央","ちゅうおう"],["に"],["ある"],["。"]]},{"verse":11,"text":"この区域はツァドクの子孫の聖別された祭司たちのものである。彼らは、イスラエル人が迷い出たときいっしょに迷い出たレビ人とは異なり、わたしへの任務を果たしている。","tok":[["この"],["区域","くいき"],["は"],["ツァドク"],["の"],["子孫","しそん"],["の"],["聖別","せいべつ"],["された"],["祭司","さいし"],["たち"],["の"],["もの"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["イスラエル"],["人","にん"],["が"],["迷い出た","まよいでた"],["とき"],["いっしょ"],["に"],["迷い出た","まよいでた"],["レビ人","れびにん"],["と"],["は"],["異なり","ことなり"],["、"],["わたし"],["へ"],["の"],["任務","にんむ"],["を"],["果たして","はたして"],["いる"],["。"]]},{"verse":12,"text":"彼らの地域はレビの部族の地域に接し、奉納地のうちでも最も聖なる地である。","tok":[["彼","かれ"],["ら"],["の"],["地域","ちいき"],["は"],["レビ"],["の"],["部族","ぶぞく"],["の"],["地域","ちいき"],["に"],["接し","せっし"],["、"],["奉納","ほうのう"],["地","ち"],["の"],["うち"],["で"],["も"],["最も","もっとも"],["聖","せい"],["なる"],["地","ち"],["で"],["ある"],["。"]]},{"verse":13,"text":"レビの部族の分は、祭司たちの地域に接して、長さ二万五千キュビト、幅一万キュビトである。すなわち、全体の長さは二万五千キュビト、幅は一万キュビトである。","tok":[["レビ"],["の"],["部族","ぶぞく"],["の"],["分","ぶん"],["は"],["、"],["祭司","さいし"],["たち"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["長さ","ながさ"],["二万五千","にまんごせん"],["キュビト"],["、"],["幅","はば"],["一万","いちまん"],["キュビト"],["で"],["ある"],["。"],["すなわち"],["、"],["全体","ぜんたい"],["の"],["長さ","ながさ"],["は"],["二万五千","にまんごせん"],["キュビト"],["、"],["幅","はば"],["は"],["一万","いちまん"],["キュビト"],["で"],["ある"],["。"]]},{"verse":14,"text":"彼らはそのどの部分も、売ったり取り替えたりしてはならない。その初めの土地を手放してはならない。主への聖なるものだからである。","tok":[["彼","かれ"],["ら"],["は"],["その"],["どの"],["部分","ぶぶん"],["も"],["、"],["売っ","うっ"],["たり"],["取り替え","とりかえ"],["たり"],["して"],["は"],["ならない"],["。"],["その"],["初め","はじめ"],["の"],["土地","とち"],["を"],["手放して","てばなして"],["は"],["ならない"],["。"],["主","ぬし"],["へ"],["の"],["聖","せい"],["なる"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"幅五千キュビト、長さ二万五千キュビトの残りの地所は、町の一般用であり、住まいと放牧地のためである。町はその中央に建てられなければならない。","tok":[["幅","はば"],["五千","ごせん"],["キュビト"],["、"],["長さ","ながさ"],["二万五千","にまんごせん"],["キュビト"],["の"],["残り","のこり"],["の"],["地所","じしょ"],["は"],["、"],["町","まち"],["の"],["一般用","いっぱんよう"],["で"],["あり"],["、"],["住まい","すまい"],["と"],["放牧","ほうぼく"],["地","ち"],["の"],["ため"],["で"],["ある"],["。"],["町","まち"],["は"],["その"],["中央","ちゅうおう"],["に"],["建てられなければ","たてられなければ"],["ならない"],["。"]]},{"verse":16,"text":"その大きさは次のとおりである。北側は四千五百キュビト、南側は四千五百キュビト、東側は四千五百キュビト、西側は四千五百キュビトである。","tok":[["その"],["大きさ","おおきさ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["北側","きたがわ"],["は"],["四千五百","よんせんごひゃく"],["キュビト"],["、"],["南側","みなみがわ"],["は"],["四千五百","よんせんごひゃく"],["キュビト"],["、"],["東側","ひがしがわ"],["は"],["四千五百","よんせんごひゃく"],["キュビト"],["、"],["西側","にしがわ"],["は"],["四千五百","よんせんごひゃく"],["キュビト"],["で"],["ある"],["。"]]},{"verse":17,"text":"また、町の放牧地は、北へ二百五十キュビト、南へ二百五十キュビト、東へ二百五十キュビト、西へ二百五十キュビトである。","tok":[["また"],["、"],["町","まち"],["の"],["放牧","ほうぼく"],["地","ち"],["は"],["、"],["北","きた"],["へ"],["二百五十","にひゃくごじゅう"],["キュビト"],["、"],["南","みなみ"],["へ"],["二百五十","にひゃくごじゅう"],["キュビト"],["、"],["東","ひがし"],["へ"],["二百五十","にひゃくごじゅう"],["キュビト"],["、"],["西","にし"],["へ"],["二百五十","にひゃくごじゅう"],["キュビト"],["で"],["ある"],["。"]]},{"verse":18,"text":"聖なる奉納地に接する残りの地所の長さは、東へ一万キュビト、西へ一万キュビトである。それは聖なる奉納地に接している。そこから収穫した物は町の働き人の食物となる。","tok":[["聖","せい"],["なる"],["奉納","ほうのう"],["地","ち"],["に"],["接する","せっする"],["残り","のこり"],["の"],["地所","じしょ"],["の"],["長さ","ながさ"],["は"],["、"],["東","ひがし"],["へ"],["一万","いちまん"],["キュビト"],["、"],["西","にし"],["へ"],["一万","いちまん"],["キュビト"],["で"],["ある"],["。"],["それ"],["は"],["聖","せい"],["なる"],["奉納","ほうのう"],["地","ち"],["に"],["接して","せっして"],["いる"],["。"],["そこ"],["から"],["収穫","しゅうかく"],["した"],["物","もの"],["は"],["町","まち"],["の"],["働き人","はたらきにん"],["の"],["食物","しょくもつ"],["と"],["なる"],["。"]]},{"verse":19,"text":"その町の働き人は、イスラエルの全部族から出て、これを耕す。","tok":[["その"],["町","まち"],["の"],["働き人","はたらきにん"],["は"],["、"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["から"],["出て","でて"],["、"],["これ"],["を"],["耕す","たがやす"],["。"]]},{"verse":20,"text":"奉納地の全体は二万五千キュビト四方であり、あなたがたは、聖なる奉納地と町の所有地とをささげることになる。","tok":[["奉納","ほうのう"],["地","ち"],["の"],["全体","ぜんたい"],["は"],["二万五千","にまんごせん"],["キュビト"],["四方","しほう"],["で"],["あり"],["、"],["あなた"],["がた"],["は"],["、"],["聖","せい"],["なる"],["奉納","ほうのう"],["地","ち"],["と"],["町","まち"],["の"],["所有地","しょゆうち"],["と"],["を"],["ささげる"],["こと"],["に"],["なる"],["。"]]},{"verse":21,"text":"聖なる奉納地と町の所有地の両側にある残りの地所は、君主のものである。これは二万五千キュビトの奉納地に面し、そこから東の境界までである。西のほうも、その二万五千キュビトに面し、そこから西の境界までである。これは部族の割り当て地にも接していて、君主のものである。聖なる奉納地と宮の聖所とは、その中央にある。","tok":[["聖","せい"],["なる"],["奉納","ほうのう"],["地","ち"],["と"],["町","まち"],["の"],["所有地","しょゆうち"],["の"],["両側","りょうがわ"],["に"],["ある"],["残り","のこり"],["の"],["地所","じしょ"],["は"],["、"],["君主","くんしゅ"],["の"],["もの"],["で"],["ある"],["。"],["これ"],["は"],["二万五千","にまんごせん"],["キュビト"],["の"],["奉納","ほうのう"],["地","ち"],["に"],["面し","めんし"],["、"],["そこ"],["から"],["東","ひがし"],["の"],["境界","きょうかい"],["まで"],["で"],["ある"],["。"],["西","にし"],["の"],["ほう"],["も"],["、"],["その"],["二万五千","にまんごせん"],["キュビト"],["に"],["面し","めんし"],["、"],["そこ"],["から"],["西","にし"],["の"],["境界","きょうかい"],["まで"],["で"],["ある"],["。"],["これ"],["は"],["部族","ぶぞく"],["の"],["割り当て","わりあて"],["地","ち"],["に"],["も"],["接して","せっして"],["いて"],["、"],["君主","くんしゅ"],["の"],["もの"],["で"],["ある"],["。"],["聖","せい"],["なる"],["奉納","ほうのう"],["地","ち"],["と"],["宮","みや"],["の"],["聖","せい"],["所","しょ"],["と"],["は"],["、"],["その"],["中央","ちゅうおう"],["に"],["ある"],["。"]]},{"verse":22,"text":"君主の所有する地区の中にあるレビ人の所有地と、町の所有地を除いて、ユダの地域とベニヤミンの地域との間にある部分は、君主のものである。","tok":[["君主","くんしゅ"],["の"],["所有","しょゆう"],["する"],["地区","ちく"],["の"],["中","なか"],["に"],["ある"],["レビ人","れびにん"],["の"],["所有地","しょゆうち"],["と"],["、"],["町","まち"],["の"],["所有地","しょゆうち"],["を"],["除いて","のぞいて"],["、"],["ユダ"],["の"],["地域","ちいき"],["と"],["ベニヤミン"],["の"],["地域","ちいき"],["と"],["の"],["間","あいだ"],["に"],["ある"],["部分","ぶぶん"],["は"],["、"],["君主","くんしゅ"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":23,"text":"なお、残りの部族は、東側から西側までがベニヤミンの分。","tok":[["なお"],["、"],["残り","のこり"],["の"],["部族","ぶぞく"],["は"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["ベニヤミン"],["の"],["分","ぶん"],["。"]]},{"verse":24,"text":"ベニヤミンの地域に接して、東側から西側までがシメオンの分。","tok":[["ベニヤミン"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["シメオン"],["の"],["分","ぶん"],["。"]]},{"verse":25,"text":"シメオンの地域に接して、東側から西側までがイッサカルの分。","tok":[["シメオン"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["イッサカル"],["の"],["分","ぶん"],["。"]]},{"verse":26,"text":"イッサカルの地域に接して、東側から西側までがゼブルンの分。","tok":[["イッサカル"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["ゼブルン"],["の"],["分","ぶん"],["。"]]},{"verse":27,"text":"ゼブルンの地域に接して、東側から西側までがガドの分。","tok":[["ゼブルン"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["、"],["東側","ひがしがわ"],["から"],["西側","にしがわ"],["まで"],["が"],["ガド"],["の"],["分","ぶん"],["。"]]},{"verse":28,"text":"ガドの地域に接して南側、その南の境界線はタマルからメリバテ・カデシュの水、さらに川に沿って大海に至る。","tok":[["ガド"],["の"],["地域","ちいき"],["に"],["接して","せっして"],["南側","みなみがわ"],["、"],["その"],["南","みなみ"],["の"],["境界線","きょうかいせん"],["は"],["タマル"],["から"],["メリバテ"],["・"],["カデシュ"],["の"],["水","みず"],["、"],["さらに"],["川","かわ"],["に"],["沿って","そって"],["大海","たいかい"],["に"],["至る","いたる"],["。"]]},{"verse":29,"text":"以上が、あなたがたがイスラエルの部族ごとに、くじで相続地として分ける土地であり、以上
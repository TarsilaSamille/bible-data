[{"verse":1,"text":"彼が私を聖所の東向きの外の門に連れ戻ると、門は閉じていた。","tok":[["彼","かれ"],["が"],["私","わたくし"],["を"],["聖","せい"],["所","しょ"],["の"],["東向き","ひがしむき"],["の"],["外","そと"],["の"],["門","もん"],["に"],["連れ戻る","つれもどる"],["と"],["、"],["門","もん"],["は"],["閉じて","とじて"],["いた"],["。"]]},{"verse":2,"text":"主は私に仰せられた。「この門は閉じたままにしておけ。あけてはならない。だれもここから入ってはならない。イスラエルの神、主がここから入られたからだ。これは閉じたままにしておかなければならない。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["この"],["門","もん"],["は"],["閉じた","とじた"],["まま"],["に"],["して"],["おけ"],["。"],["あけて"],["は"],["ならない"],["。"],["だれ"],["も"],["ここ"],["から"],["入って","はいって"],["は"],["ならない"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["ここ"],["から"],["入られた","はいられた"],["から"],["だ"],["。"],["これ"],["は"],["閉じた","とじた"],["まま"],["に"],["して"],["おかなければ"],["ならない"],["。"]]},{"verse":3,"text":"ただ、君主だけが、君主として主の前でパンを食べるためにそこにすわることができる。彼は門の玄関の間を通って入り、またそこを通って出て行かなければならない。」","tok":[["ただ"],["、"],["君主","くんしゅ"],["だけ"],["が"],["、"],["君主","くんしゅ"],["として"],["主","ぬし"],["の"],["前","まえ"],["で"],["パン"],["を"],["食べる","たべる"],["ため"],["に"],["そこ"],["に"],["すわる"],["こと"],["が"],["できる"],["。"],["彼","かれ"],["は"],["門","もん"],["の"],["玄関","げんかん"],["の"],["間","あいだ"],["を"],["通って","とおって"],["入り","はいり"],["、"],["また"],["そこ"],["を"],["通って","とおって"],["出て","でて"],["行かなければ","いかなければ"],["ならない"],["。"],["」"]]},{"verse":4,"text":"彼は私を、北の門を通って神殿の前に連れて行った。私が見ると、なんと、主の栄光が主の神殿に満ちていた。そこで、私はひれ伏した。","tok":[["彼","かれ"],["は"],["私","わたくし"],["を"],["、"],["北","きた"],["の"],["門","もん"],["を"],["通って","とおって"],["神殿","しんでん"],["の"],["前","まえ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["私","わたくし"],["が"],["見る","みる"],["と"],["、"],["なん"],["と"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["満ちて","みちて"],["いた"],["。"],["そこ"],["で"],["、"],["私","わたくし"],["は"],["ひれ伏した","ひれふした"],["。"]]},{"verse":5,"text":"すると主は私に仰せられた。「人の子よ。主の宮のすべての定めとそのすべての律法について、わたしがあなたに告げていることをことごとく心に留め、それに目を注ぎ、耳を傾けよ。宮に入れる者と、聖所に入れないすべての者を心に留めよ。","tok":[["する"],["と"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["主","ぬし"],["の"],["宮","みや"],["の"],["すべて"],["の"],["定め","さだめ"],["と"],["その"],["すべて"],["の"],["律法","りっぽう"],["について"],["、"],["わたし"],["が"],["あなた"],["に"],["告げて","つげて"],["いる"],["こと"],["を"],["ことごとく"],["心","こころ"],["に"],["留め","とめ"],["、"],["それ"],["に"],["目","め"],["を"],["注ぎ","そそぎ"],["、"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["宮","みや"],["に"],["入れる","いれる"],["者","もの"],["と"],["、"],["聖","せい"],["所","しょ"],["に"],["入れない","いれない"],["すべて"],["の"],["者","もの"],["を"],["心","こころ"],["に"],["留めよ","とめよ"],["。"]]},{"verse":6,"text":"あなたは、反逆の家、イスラエルの家にこう言え。神である主はこう仰せられる。イスラエルの家よ。あなたがたのあらゆる忌みきらうべきわざは、もうたくさんだ。","tok":[["あなた"],["は"],["、"],["反逆","はんぎゃく"],["の"],["家","いえ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["こう"],["言え","いえ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["。"],["あなた"],["がた"],["の"],["あらゆる"],["忌みきらうべき","いみきらうべき"],["わざ"],["は"],["、"],["もう"],["たくさん"],["だ"],["。"]]},{"verse":7,"text":"あなたがたは、心にも肉体にも割礼を受けていない外国人を連れて来て、わたしの聖所におらせ、わたしの宮を汚した。あなたがたは、わたしのパンと脂肪と血とをささげたが、あなたがたのすべての忌みきらうべきわざによって、わたしとの契約を破った。","tok":[["あなた"],["がた"],["は"],["、"],["心","こころ"],["に"],["も"],["肉体","にくたい"],["に"],["も"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["外国人","がいこくじん"],["を"],["連れて","つれて"],["来て","きて"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["に"],["おらせ"],["、"],["わたし"],["の"],["宮","みや"],["を"],["汚した","よごした"],["。"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["パン"],["と"],["脂肪","しぼう"],["と"],["血","ち"],["と"],["を"],["ささげた"],["が"],["、"],["あなた"],["がた"],["の"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["わざ"],["によって"],["、"],["わたし"],["と"],["の"],["契約","けいやく"],["を"],["破った","やぶった"],["。"]]},{"verse":8,"text":"あなたがたは、わたしの聖所での任務も果たさず、かえって、自分たちの代わりにわたしの聖所で任務を果たす者たちを置いた。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["で"],["の"],["任務","にんむ"],["も"],["果たさず","はたさず"],["、"],["かえって"],["、"],["自分","じぶん"],["たち"],["の"],["代わり","かわり"],["に"],["わたし"],["の"],["聖","せい"],["所","しょ"],["で"],["任務","にんむ"],["を"],["果たす","はたす"],["者","もの"],["たち"],["を"],["置いた","おいた"],["。"]]},{"verse":9,"text":"神である主はこう仰せられる。心にも肉体にも割礼を受けていない外国人は、だれもわたしの聖所に入ってはならない。イスラエル人の中にいる外国人はみなそうだ。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["心","こころ"],["に"],["も"],["肉体","にくたい"],["に"],["も"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["外国人","がいこくじん"],["は"],["、"],["だれ"],["も"],["わたし"],["の"],["聖","せい"],["所","しょ"],["に"],["入って","はいって"],["は"],["ならない"],["。"],["イスラエル"],["人","にん"],["の"],["中","なか"],["に"],["いる"],["外国人","がいこくじん"],["は"],["みな"],["そう"],["だ"],["。"]]},{"verse":10,"text":"レビ人でも、イスラエルが迷って自分たちの偶像を慕って、わたしから迷い出たとき、わたしを捨て去ったので、彼らは自分たちの咎を負わなければならない。","tok":[["レビ人","れびにん"],["で"],["も"],["、"],["イスラエル"],["が"],["迷って","まよって"],["自分","じぶん"],["たち"],["の"],["偶像","ぐうぞう"],["を"],["慕って","したって"],["、"],["わたし"],["から"],["迷い出た","まよいでた"],["とき"],["、"],["わたし"],["を"],["捨て去った","すてさった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":11,"text":"彼らは宮の門で番をし、宮で奉仕をして、わたしの聖所で仕えるはずなのだ。彼らは民のために、全焼のいけにえや、ほかのいけにえをほふり、民に仕えて彼らに奉仕しなければならない。","tok":[["彼","かれ"],["ら"],["は"],["宮","みや"],["の"],["門","もん"],["で"],["番","ばん"],["を"],["し"],["、"],["宮","みや"],["で"],["奉仕","ほうし"],["を"],["して"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["で"],["仕える","つかえる"],["はず"],["な"],["の"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["民","みん"],["の"],["ため"],["に"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["や"],["、"],["ほか"],["の"],["いけにえ"],["を"],["ほふり"],["、"],["民","みん"],["に"],["仕えて","つかえて"],["彼","かれ"],["ら"],["に"],["奉仕","ほうし"],["しなければ"],["ならない"],["。"]]},{"verse":12,"text":"それなのにレビ人たちは、民の偶像の前で民に仕え、イスラエルの家を不義に引き込んだ。それゆえ、わたしは彼らに誓う。――神である主の御告げ――彼らは自分たちの咎を負わなければならない。","tok":[["それ"],["な"],["のに"],["レビ人","れびにん"],["たち"],["は"],["、"],["民","みん"],["の"],["偶像","ぐうぞう"],["の"],["前","まえ"],["で"],["民","たみ"],["に"],["仕え","つかえ"],["、"],["イスラエル"],["の"],["家","いえ"],["を"],["不義","ふぎ"],["に"],["引き込んだ","ひきこんだ"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["誓う","ちかう"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["咎","とが"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":13,"text":"彼らは、祭司としてわたしに仕えるために、わたしに近づいてはならない。わたしのあらゆる聖なる物、または最も聖なる物に触れてはならない。彼らは自分たちの恥と自分たちの行った忌みきらうべきわざの責めとを負わなければならない。","tok":[["彼","かれ"],["ら"],["は"],["、"],["祭司","さいし"],["として"],["わたし"],["に"],["仕える","つかえる"],["ため"],["に"],["、"],["わたし"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["わたし"],["の"],["あらゆる"],["聖","せい"],["なる"],["物","もの"],["、"],["また"],["は"],["最も","もっとも"],["聖","せい"],["なる"],["物","もの"],["に"],["触れて","ふれて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["恥","はじ"],["と"],["自分","じぶん"],["たち"],["の"],["行った","おこなった"],["忌みきらうべき","いみきらうべき"],["わざ"],["の"],["責め","せめ"],["と"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":14,"text":"わたしは彼らに、宮のあらゆる奉仕とそこで行われるすべての宮の任務を果たさせる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["、"],["宮","みや"],["の"],["あらゆる"],["奉仕","ほうし"],["と"],["そこ"],["で"],["行われる","おこなわれる"],["すべて"],["の"],["宮","みや"],["の"],["任務","にんむ"],["を"],["果たさせる","はたさせる"],["。"]]},{"verse":15,"text":"しかし、イスラエル人が迷ってわたしから離れたときもわたしの聖所の任務を果たした、ツァドクの子孫のレビ人の祭司たちは、わたしに近づいてわたしに仕え、わたしに脂肪と血とをささげてわたしに仕えることができる。――神である主の御告げ――","tok":[["しかし"],["、"],["イスラエル"],["人","にん"],["が"],["迷って","まよって"],["わたし"],["から"],["離れた","はなれた"],["とき"],["も"],["わたし"],["の"],["聖","せい"],["所","しょ"],["の"],["任務","にんむ"],["を"],["果たした","はたした"],["、"],["ツァドク"],["の"],["子孫","しそん"],["の"],["レビ人","れびにん"],["の"],["祭司","さいし"],["たち"],["は"],["、"],["わたし"],["に"],["近づいて","ちかづいて"],["わたし"],["に"],["仕え","つかえ"],["、"],["わたし"],["に"],["脂肪","しぼう"],["と"],["血","ち"],["と"],["を"],["ささげて"],["わたし"],["に"],["仕える","つかえる"],["こと"],["が"],["できる"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":16,"text":"彼らはわたしの聖所に入り、わたしの机に近づいてわたしに仕え、わたしへの任務を果たすことができる。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["の"],["聖","せい"],["所","しょ"],["に"],["入り","はいり"],["、"],["わたし"],["の"],["机","つくえ"],["に"],["近づいて","ちかづいて"],["わたし"],["に"],["仕え","つかえ"],["、"],["わたし"],["へ"],["の"],["任務","にんむ"],["を"],["果たす","はたす"],["こと"],["が"],["できる"],["。"]]},{"verse":17,"text":"彼らは内庭の門に入るときには、亜麻布の服を着なければならない。内庭の門、および神殿の中で務めをするときは、毛織り物を身に着けてはならない。","tok":[["彼","かれ"],["ら"],["は"],["内庭","うちにわ"],["の"],["門","もん"],["に"],["入る","はいる"],["とき"],["に"],["は"],["、"],["亜","あ"],["麻布","あざぶ"],["の"],["服","ふく"],["を"],["着なければ","きなければ"],["ならない"],["。"],["内庭","うちにわ"],["の"],["門","もん"],["、"],["および"],["神殿","しんでん"],["の"],["中","なか"],["で"],["務め","つとめ"],["を"],["する"],["とき"],["は"],["、"],["毛織り","けおり"],["物","もの"],["を"],["身","み"],["に"],["着けて","つけて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"頭には亜麻布のかぶり物をかぶり、腰には亜麻布のももひきをはかなければならない。汗の出るような物を身に着けてはならない。","tok":[["頭","あたま"],["に"],["は"],["亜","あ"],["麻布","あざぶ"],["の"],["かぶり物","かぶりもの"],["を"],["かぶり"],["、"],["腰","こし"],["に"],["は"],["亜","あ"],["麻布","あざぶ"],["の"],["ももひき"],["を"],["はかなければ"],["ならない"],["。"],["汗","あせ"],["の"],["出る","でる"],["よう"],["な"],["物","もの"],["を"],["身","み"],["に"],["着けて","つけて"],["は"],["ならない"],["。"]]},{"verse":19,"text":"彼らが外庭に出て、外庭の民のところに出て行くときは、務めのときに着ていた服を脱ぎ、それを聖所の部屋にしまい、ほかの服を着なければならない。その服によって民を聖なるものとしないためである。","tok":[["彼","かれ"],["ら"],["が"],["外庭","そとにわ"],["に"],["出て","でて"],["、"],["外庭","そとにわ"],["の"],["民","たみ"],["の"],["ところ"],["に"],["出て","でて"],["行く","いく"],["とき"],["は"],["、"],["務め","つとめ"],["の"],["とき"],["に"],["着て","きて"],["いた"],["服","ふく"],["を"],["脱ぎ","ぬぎ"],["、"],["それ"],["を"],["聖","せい"],["所","しょ"],["の"],["部屋","へや"],["に"],["しまい"],["、"],["ほか"],["の"],["服","ふく"],["を"],["着なければ","きなければ"],["ならない"],["。"],["その"],["服","ふく"],["によって"],["民","みん"],["を"],["聖","せい"],["なる"],["もの"],["と"],["しない"],["ため"],["で"],["ある"],["。"]]},{"verse":20,"text":"彼らは頭をそってはならない。髪を長く伸ばしすぎてもいけない。頭は適当に刈らなければならない。","tok":[["彼","かれ"],["ら"],["は"],["頭","あたま"],["を"],["そって"],["は"],["ならない"],["。"],["髪","かみ"],["を"],["長く","ながく"],["伸ばし","のばし"],["すぎて"],["も"],["いけない"],["。"],["頭","あたま"],["は"],["適当","てきとう"],["に"],["刈らなければ","からなければ"],["ならない"],["。"]]},{"verse":21,"text":"祭司はだれも、内庭に入るときには、ぶどう酒を飲んではならない。","tok":[["祭司","さいし"],["は"],["だれ"],["も"],["、"],["内庭","うちにわ"],["に"],["入る","はいる"],["とき"],["に"],["は"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["飲んで","のんで"],["は"],["ならない"],["。"]]},{"verse":22,"text":"やもめや、離婚された女を妻にしてはならない。ただ、イスラエルの民のうちの処女をめとらなければならない。しかし、やもめでも、それが祭司のやもめであれば、めとってもよい。","tok":[["やもめ"],["や"],["、"],["離婚","りこん"],["された"],["女","おんな"],["を"],["妻","つま"],["に"],["して"],["は"],["ならない"],["。"],["ただ"],["、"],["イスラエル"],["の"],["民","たみ"],["の"],["うち"],["の"],["処女","しょじょ"],["を"],["めとらなければ"],["ならない"],["。"],["しかし"],["、"],["やもめ"],["で"],["も"],["、"],["それ"],["が"],["祭司","さいし"],["の"],["やもめ"],["で"],["あれば"],["、"],["めとって"],["も"],["よい"],["。"]]},{"verse":23,"text":"彼らは、わたしの民に、聖なるものと俗なるものとの違いを教え、汚れたものときよいものとの区別を教えなければならない。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["民","たみ"],["に"],["、"],["聖","せい"],["なる"],["もの"],["と"],["俗","ぞく"],["なる"],["もの"],["と"],["の"],["違い","ちがい"],["を"],["教え","おしえ"],["、"],["汚れた","よごれた"],["もの"],["と"],["きよい"],["もの"],["と"],["の"],["区別","くべつ"],["を"],["教えなければ","おしえなければ"],["ならない"],["。"]]},{"verse":24,"text":"争いがあるときには、彼らは、わたしの定めに従ってさばきの座に着き、これをさばかなければならない。わたしのすべての例祭には、わたしの律法とおきてとを守り、わたしの安息日を聖別しなければならない。","tok":[["争い","あらそい"],["が"],["ある"],["とき"],["に"],["は"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["定め","さだめ"],["に"],["従って","したがって"],["さばき"],["の"],["座","ざ"],["に"],["着き","つき"],["、"],["これ"],["を"],["さばかなければ"],["ならない"],["。"],["わたし"],["の"],["すべて"],["の"],["例祭","れいさい"],["に"],["は"],["、"],["わたし"],["の"],["律法","りっぽう"],["と"],["おきて"],["と"],["を"],["守り","まもり"],["、"],["わたし"],["の"],["安息日","あんそくび"],["を"],["聖別","せいべつ"],["しなければ"],["ならない"],["。"]]},{"verse":25,"text":"彼らは、死人に近づいて身を汚してはならない。ただし、自分の父、母、息子、娘、兄弟、未婚の姉妹のためには汚れてもよい。","tok":[["彼","かれ"],["ら"],["は"],["、"],["死人","しにん"],["に"],["近づいて","ちかづいて"],["身","み"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["ただし"],["、"],["自分","じぶん"],["の"],["父","ちち"],["、"],["母","はは"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["兄弟","きょうだい"],["、"],["未婚","みこん"],["の"],["姉妹","しまい"],["の"],["ため"],["に"],["は"],["汚れて","よごれて"],["も"],["よい"],["。"]]},{"verse":26,"text":"その場合、その人は、きよめられて後、さらに七日間待たなければならない。","tok":[["その"],["場合","ばあい"],["、"],["その"],["人","ひと"],["は"],["、"],["きよめられて"],["後","あと"],["、"],["さらに"],["七","なな"],["日間","かかん"],["待たなければ","またなければ"],["ならない"],["。"]]},{"verse":27,"text":"聖所で仕えるために聖所の内庭に入る日には、彼は罪のためのいけにえをささげなければならない。――神である主の御告げ――","tok":[["聖","せい"],["所","しょ"],["で"],["仕える","つかえる"],["ため"],["に"],["聖","せい"],["所","しょ"],["の"],["内庭","うちにわ"],["に"],["入る","はいる"],["日","ひ"],["に"],["は"],["、"],["彼","かれ"],["は"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["を"],["ささげなければ"],["ならない"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":28,"text":"これが彼らの相続地となる。わたしが彼らの相続地である。あなたがたはイスラエルの中で彼らに所有地を与えてはならない。わたしが彼らの所有地である。","tok":[["これ"],["が"],["彼","かれ"],["ら"],["の"],["相続","そうぞく"],["地","ち"],["と"],["なる"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["相続","そうぞく"],["地","ち"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["イスラエル"],["の"],["中","なか"],["で"],["彼","かれ"],["ら"],["に"],["所有地","しょゆうち"],["を"],["与えて","あたえて"],["は"],["ならない"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["所有地","しょゆうち"],["で"],["ある"],["。"]]},{"verse":29,"text":"彼らの食物は、穀物のささげ物、罪のためのいけにえ、罪過のためのいけにえである。イスラエルのうちのすべての献納物は彼らのものである。","tok":[["彼","かれ"],["ら"],["の"],["食物","しょくもつ"],["は"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["、"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["、"],["罪過","ざいか"],["の"],["ため"],["の"],["いけにえ"],["で"],["ある"],["。"],["イスラエル"],["の"],["うち"],["の"],["すべて"],["の"],["献納物","けんのうぶつ"],["は"],["彼","かれ"],["ら"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":30,"text":"あらゆる種類の初物、あなたがたのあらゆる奉納物のうちの最上の奉納物は、すべて祭司たちのものであり、あなたがたの麦粉の初物も祭司に与えなければならない。あなたの家に祝福が宿るためである。","tok":[["あらゆる"],["種類","しゅるい"],["の"],["初物","はつもの"],["、"],["あなた"],["がた"],["の"],["あらゆる"],["奉納物","ほうのうぶつ"],["の"],["うち"],["の"],["最上","さいじょう"],["の"],["奉納物","ほうのうぶつ"],["は"],["、"],["すべて"],["祭司","さいし"],["たち"],["の"],["もの"],["で"],["あり"],["、"],["あなた"],["がた"],["の"],["麦粉","むぎこ"],["の"],["初物","はつもの"],["も"],["祭司","さいし"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"],["あなた"],["の"],["家","いえ"],["に"],["祝福","しゅくふく"],["が"],["宿る","やどる"],["ため"],["で"],["ある"],["。"]]},{"verse":31,"text":"祭司たちは、死んだものや裂き殺されたものはすべて、鳥であれ獣であれ、食べてはならない。","tok":[["祭司","さいし"],["たち"],["は"],["、"],["死んだ","しんだ"],["もの"],["や"],["裂き","さき"],["殺された","ころされた"],["もの"],["は"],["すべて"],["、"],["鳥","とり"],["で"],["あれ"],["獣","けもの"],["で"],["あれ"],["、"],["食べて","たべて"],["は"],["ならない"],["。"]]}]
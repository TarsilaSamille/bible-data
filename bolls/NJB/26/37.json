[{"verse":1,"text":"主の御手が私の上にあり、主の霊によって、私は連れ出され、谷間の真ん中に置かれた。そこには骨が満ちていた。","tok":[["主","ぬし"],["の"],["御手","おて"],["が"],["私","わたくし"],["の"],["上","うえ"],["に"],["あり"],["、"],["主","ぬし"],["の"],["霊","れい"],["によって"],["、"],["私","わたくし"],["は"],["連れ出され","つれだされ"],["、"],["谷間","たにま"],["の"],["真ん中","まんなか"],["に"],["置かれた","おかれた"],["。"],["そこ"],["に"],["は"],["骨","ほね"],["が"],["満ちて","みちて"],["いた"],["。"]]},{"verse":2,"text":"主は私にその上をあちらこちらと行き巡らせた。なんと、その谷間には非常に多くの骨があり、ひどく干からびていた。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["その"],["上","うえ"],["を"],["あちらこちら"],["と"],["行き","いき"],["巡らせた","めぐらせた"],["。"],["なん"],["と"],["、"],["その"],["谷間","たにま"],["に"],["は"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["骨","ほね"],["が"],["あり"],["、"],["ひどく"],["干からびて","ひからびて"],["いた"],["。"]]},{"verse":3,"text":"主は私に仰せられた。「人の子よ。これらの骨は生き返ることができようか。」私は答えた。「神、主よ。あなたがご存じです。」","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["これ"],["ら"],["の"],["骨","ほね"],["は"],["生き返る","いきかえる"],["こと"],["が"],["できよう"],["か"],["。"],["」"],["私","わたくし"],["は"],["答えた","こたえた"],["。"],["「"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["が"],["ご存じ","ごぞんじ"],["です"],["。"],["」"]]},{"verse":4,"text":"主は私に仰せられた。「これらの骨に預言して言え。干からびた骨よ。主のことばを聞け。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["これ"],["ら"],["の"],["骨","ほね"],["に"],["預言","よげん"],["して"],["言え","いえ"],["。"],["干からびた","ひからびた"],["骨","ほね"],["よ"],["。"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":5,"text":"神である主はこれらの骨にこう仰せられる。見よ。わたしがおまえたちの中に息を吹き入れるので、おまえたちは生き返る。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["これ"],["ら"],["の"],["骨","ほね"],["に"],["こう"],["仰せられる","おおせられる"],["。"],["見","み"],["よ"],["。"],["わたし"],["が"],["おまえ"],["たち"],["の"],["中","なか"],["に"],["息","いき"],["を"],["吹き入れる","ふきいれる"],["ので"],["、"],["おまえ"],["たち"],["は"],["生き返る","いきかえる"],["。"]]},{"verse":6,"text":"わたしがおまえたちに筋をつけ、肉を生じさせ、皮膚でおおい、おまえたちの中に息を与え、おまえたちが生き返るとき、おまえたちはわたしが主であることを知ろう。」","tok":[["わたし"],["が"],["おまえ"],["たち"],["に"],["筋","すじ"],["を"],["つけ"],["、"],["肉","にく"],[
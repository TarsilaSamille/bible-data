[{"verse":1,"text":"この方は私の耳に大声で叫んで仰せられた。「この町を罰する者たちよ。おのおの破壊する武器を手に持って近づいて来い。」","tok":[["この"],["方","かた"],["は"],["私","わたくし"],["の"],["耳","みみ"],["に"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["仰せられた","おおせられた"],["。"],["「"],["この"],["町","まち"],["を"],["罰する","ばっする"],["者","もの"],["たち"],["よ"],["。"],["おのおの"],["破壊","はかい"],["する"],["武器","ぶき"],["を"],["手","て"],["に"],["持って","もって"],["近づいて","ちかづいて"],["来い","こい"],["。"],["」"]]},{"verse":2,"text":"見ると、六人の男が、おのおの打ちこわす武器を手に持って、北に面する上の門を通ってやって来た。もうひとりの人が亜麻布の衣を着、腰には書記の筆入れをつけて、彼らの中にいた。彼らは入って来て、青銅の祭壇のそばに立った。","tok":[["見る","みる"],["と"],["、"],["六人","ろくにん"],["の"],["男","おとこ"],["が"],["、"],["おのおの"],["打ちこわす","うちこわす"],["武器","ぶき"],["を"],["手","て"],["に"],["持って","もって"],["、"],["北","きた"],["に"],["面する","めんする"],["上","うえ"],["の"],["門","もん"],["を"],["通って","とおって"],["やって"],["来た","きた"],["。"],["もう"],["ひとり"],["の"],["人","ひと"],["が"],["亜","あ"],["麻布","あざぶ"],["の"],["衣","ころも"],["を"],["着","き"],["、"],["腰","こし"],["に"],["は"],["書記","しょき"],["の"],["筆入れ","ふでいれ"],["を"],["つけて"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["入って","はいって"],["来て","きて"],["、"],["青銅","せいどう"],["の"],["祭壇","さいだん"],["の"],["そば"],["に"],["立った","たった"],["。"]]},{"verse":3,"text":"そのとき、ケルブの上にあったイスラエルの神の栄光が、ケルブから立ち上り、神殿の敷居へ向かった。それから、腰に書記の筆入れをつけ、亜麻布の衣を着ている者を呼び寄せて、","tok":[["その"],["とき"],["、"],["ケルブ"],["の"],["上","うえ"],["に"],["あった"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["、"],["ケルブ"],["から"],["立ち上り","たちのぼり"],["、"],["神殿","しんでん"],["の"],["敷居","しきい"],["へ"],["向かった","むかった"],["。"],["それ"],["から"],["、"],["腰","こし"],["に"],["書記","しょき"],["の"],["筆入れ","ふでいれ"],["を"],["つけ"],["、"],["亜","あ"],["麻布","あざぶ"],["の"],["衣","ころも"],["を"],["着て","きて"],["いる"],["者","もの"],["を"],["呼び寄せて","よびよせて"],["、"]]},{"verse":4,"text":"主は彼にこう仰せられた。「町の中、エルサレムの中を行き巡り、この町で行われているすべての忌みきらうべきことのために嘆き、悲しんでいる人々の額にしるしをつけよ。」","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["こう"],["仰せられた","おおせられた"],["。"],["「"],["町","まち"],["の"],["中","なか"],["、"],["エルサレム"],["の"],["中","なか"],["を"],["行き","いき"],["巡り","めぐり"],["、"],["この"],["町","まち"],["で"],["行われて","おこなわれて"],["いる"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["の"],["ため"],["に"],["嘆き","なげき"],["、"],["悲しんで","かなしんで"],["いる"],["人々","ひとびと"],["の"],["額","がく"],["に"],["しるし"],["を"],["つけよ"],["。"],["」"]]},{"verse":5,"text":"また、私が聞いていると、ほかの者たちに、こう仰せられた。「彼のあとについて町の中を行き巡って、打ち殺せ。惜しんではならない、あわれんではならない。","tok":[["また"],["、"],["私","わたくし"],["が"],["聞いて","きいて"],["いる"],["と"],["、"],["ほか"],["の"],["者","もの"],["たち"],["に"],["、"],["こう"],["仰せられた","おおせられた"],["。"],["「"],["彼","かれ"],["の"],["あと"],["について"],["町","まち"],["の"],["中","なか"],["を"],["行き","いき"],["巡って","めぐって"],["、"],["打ち殺せ","うちころせ"],["。"],["惜しんで","おしんで"],["は"],["ならない"],["、"],["あわれんで"],["は"],["ならない"],["。"]]},{"verse":6,"text":"年寄りも、若い男も、若い女も、子どもも、女たちも殺して滅ぼせ。しかし、あのしるしのついた者にはだれにも近づいてはならない。まずわたしの聖所から始めよ。」そこで、彼らは神殿の前にいた老人たちから始めた。","tok":[["年寄り","としより"],["も"],["、"],["若い","わかい"],["男","おとこ"],["も"],["、"],["若い","わかい"],["女","おんな"],["も"],["、"],["子ども","こども"],["も"],["、"],["女","おんな"],["たち"],["も"],["殺して","ころして"],["滅ぼせ","ほろぼせ"],["。"],["しかし"],["、"],["あの"],["しるし"],["の"],["ついた"],["者","もの"],["に"],["は"],["だれ"],["に"],["も"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["まず"],["わたし"],["の"],["聖","せい"],["所","しょ"],["から"],["始め","はじめ"],["よ"],["。"],["」"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["神殿","しんでん"],["の"],["前","まえ"],["に"],["いた"],["老人","ろうじん"],["たち"],["から"],["始めた","はじめた"],["。"]]},{"verse":7,"text":"ついで主は彼らに仰せられた。「宮を汚し、死体で庭を満たせ。さあ行け。」彼らは出て行って、町の中で打ち殺した。","tok":[["ついで"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["に"],["仰せられた","おおせられた"],["。"],["「"],["宮","みや"],["を"],["汚し","よごし"],["、"],["死体","したい"],["で"],["庭","にわ"],["を"],["満たせ","みたせ"],["。"],["さあ"],["行け","いけ"],["。"],["」"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行って","いって"],["、"],["町","まち"],["の"],["中","なか"],["で"],["打ち殺した","うちころした"],["。"]]},{"verse":8,"text":"彼らが打ち殺しているとき、私は残っていて、ひれ伏し、叫んで言った。「ああ、神、主よ。あなたはエルサレムの上にあなたの憤りを注ぎ出して、イスラエルの残りの者たちを、ことごとく滅ぼされるのでしょうか。」","tok":[["彼","かれ"],["ら"],["が"],["打ち殺して","うちころして"],["いる"],["とき"],["、"],["私","わたくし"],["は"],["残って","のこって"],["いて"],["、"],["ひれ伏し","ひれふし"],["、"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["ああ"],["、"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["エルサレム"],["の"],["上","うえ"],["に"],["あなた"],["の"],["憤り","いきどおり"],["を"],["注ぎ","そそぎ"],["出して","だして"],["、"],["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["たち"],["を"],["、"],["ことごとく"],["滅ぼされる","ほろぼされる"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":9,"text":"すると、主は私に仰せられた。「イスラエルとユダの家の咎は非常に大きく、この国は虐殺の血で満ち、町も罪悪で満ちている。それは、彼らが、『主はこの国を見捨てられた。主は見ておられない』と言ったからだ。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["イスラエル"],["と"],["ユダ"],["の"],["家","いえ"],["の"],["咎","とが"],["は"],["非常","ひじょう"],["に"],["大きく","おおきく"],["、"],["この"],["国","くに"],["は"],["虐殺","ぎゃくさつ"],["の"],["血","ち"],["で"],["満ち","みち"],["、"],["町","まち"],["も"],["罪悪","ざいあく"],["で"],["満ちて","みちて"],["いる"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["、"],["『"],["主","ぬし"],["は"],["この"],["国","くに"],["を"],["見捨てられた","みすてられた"],["。"],["主","ぬし"],["は"],["見て","みて"],["おられない"],["』"],["と"],["言った","いった"],["から"],["だ"],["。"]]},{"verse":10,"text":"だから、わたしも惜しまず、あわれまない。わたしは彼らの頭上に彼らの行いを返す。」","tok":[["だ"],["から"],["、"],["わたし"],["も"],["惜しまず","おしまず"],["、"],["あわれまない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["頭上","ずじょう"],["に"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["を"],["返す","かえす"],["。"],["」"]]},{"verse":11,"text":"ちょうどそのとき、腰に筆入れをつけ、亜麻布の衣を着ているその人が報告してこう言った。「あなたが私に命じたとおりに私は行いました。」","tok":[["ちょうど"],["その"],["とき"],["、"],["腰","こし"],["に"],["筆入れ","ふでいれ"],["を"],["つけ"],["、"],["亜","あ"],["麻布","あざぶ"],["の"],["衣","ころも"],["を"],["着て","きて"],["いる"],["その"],["人","ひと"],["が"],["報告","ほうこく"],["して"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["が"],["私","わたくし"],["に"],["命じた","めいじた"],["とおり"],["に"],["私","わたくし"],["は"],["行いました","おこないました"],["。"],["」"]]}]
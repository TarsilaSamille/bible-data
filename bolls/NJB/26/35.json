[{"verse":1,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。顔をセイルの山に向け、これについて預言して、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["顔","かお"],["を"],["セイル"],["の"],["山","やま"],["に"],["向け","むけ"],["、"],["これ"],["について"],["預言","よげん"],["して"],["、"]]},{"verse":3,"text":"言え。／神である主はこう仰せられる。／セイルの山よ。／わたしはおまえに立ち向かい、おまえにわたしは手を伸ばし、おまえを荒れ果てさせ、荒廃した地とする。","tok":[["言え","いえ"],["。"],["／"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["セイル"],["の"],["山","やま"],["よ"],["。"],["／"],["わたし"],["は"],["おまえ"],["に"],["立ち向かい","たちむかい"],["、"],["おまえ"],["に"],["わたし"],["は"],["手","て"],["を"],["伸ばし","のばし"],["、"],["おまえ"],["を"],["荒れ果てさせ","あれはてさせ"],["、"],["荒廃","こうはい"],["した"],["地","ち"],["と"],["する"],["。"]]},{"verse":4,"text":"わたしがおまえの町々を廃墟にし、おまえを荒れ果てさせるとき、おまえは、わたしが主であることを知ろう。","tok":[["わたし"],["が"],["おまえ"],["の"],["町々","まちまち"],["を"],["廃墟","はいきょ"],["に"],["し"],["、"],["おまえ"],["を"],["荒れ果てさせる","あれはてさせる"],["とき"],["、"],["おまえ"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":5,"text":"おまえはいつまでも敵意を抱き、イスラエル人が災難に会うとき、彼らの最後の刑罰の時、彼らを剣に渡した。","tok":[["おまえ"],["は"],["いつ"],["まで"],["も"],["敵意","てきい"],["を"],["抱き","いだき"],["、"],["イスラエル"],["人","にん"],["が"],["災難","さいなん"],["に"],["会う","あう"],["とき"],["、"],["彼","かれ"],["ら"],["の"],["最後","さいご"],["の"],["刑罰","けいばつ"],["の"],["時","とき"],["、"],["彼","かれ"],["ら"],["を"],["剣","けん"],["に"],["渡した","わたした"],["。"]]},{"verse":6,"text":"それゆえ、――わたしは生きている。神である主の御告げ――わたしは必ずおまえを血に渡す。血はおまえを追う。おまえは血を憎んだが、血はおまえを追いかける。","tok":[["それ"],["ゆえ"],["、"],["―"],["―"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["は"],["必ず","かならず"],["おまえ"],["を"],["血","ち"],["に"],["渡す","わたす"],["。"],["血","ち"],["は"],["おまえ"],["を"],["追う","おう"],["。"],["おまえ"],["は"],["血","ち"],["を"],["憎んだ","にくんだ"],["が"],["、"],["血","ち"],["は"],["おまえ"],["を"],["追いかける","おいかける"],["。"]]},{"verse":7,"text":"わたしはセイルの山を荒れ果てさせ、廃墟とし、そこを行き来する者を断ち滅ぼす。","tok":[["わたし"],["は"],["セイル"],["の"],["山","やま"],["を"],["荒れ果てさせ","あれはてさせ"],["、"],["廃墟","はいきょ"],["と"],["し"],["、"],["そこ"],["を"],["行き来","いきき"],["する"],["者","もの"],["を"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"]]},{"verse":8,"text":"わたしはその山々を死体で満たし、剣で刺し殺された者たちがおまえの丘や谷や、すべての谷川に倒れる。","tok":[["わたし"],["は"],["その"],["山々","やまやま"],["を"],["死体","したい"],["で"],["満たし","みたし"],["、"],["剣","けん"],["で"],["刺し殺された","さしころされた"],["者","もの"],["たち"],["が"],["おまえ"],["の"],["丘","おか"],["や"],["谷","たに"],["や"],["、"],["すべて"],["の"],["谷川","たにがわ"],["に"],["倒れる","たおれる"],["。"]]},{"verse":9,"text":"わたしはおまえを永遠に荒れ果てさせる。おまえの町々は回復しない。おまえたちは、わたしが主であることを知ろう。","tok":[["わたし"],["は"],["おまえ"],["を"],["永遠","えいえん"],["に"],["荒れ果てさせる","あれはてさせる"],["。"],["おまえ"],["の"],["町々","まちまち"],["は"],["回復","かいふく"],["しない"],["。"],["おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":10,"text":"おまえは、『これら二つの民、二つの国は、われわれのものだ。われわれはそれを占領しよう』と言ったが、そこに主がおられた。","tok":[["おまえ"],["は"],["、"],["『"],["これ"],["ら"],["二","ふた"],["つ"],["の"],["民","たみ"],["、"],["二","ふた"],["つ"],["の"],["国","くに"],["は"],["、"],["われわれ"],["の"],["もの"],["だ"],["。"],["われわれ"],["は"],["それ"],["を"],["占領","せんりょう"],["しよう"],["』"],["と"],["言った","いった"],["が"],["、"],["そこ"],["に"],["主","ぬし"],["が"],["おられた"],["。"]]},{"verse":11,"text":"それゆえ、――わたしは生きている。神である主の御告げ――おまえが彼らを憎んだのと同じほどの怒りとねたみで、わたしはおまえを必ず罰し、わたしがおまえをさばくとき、わたし自身を現そう。","tok":[["それ"],["ゆえ"],["、"],["―"],["―"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["おまえ"],["が"],["彼","かれ"],["ら"],["を"],["憎んだ","にくんだ"],["の"],["と"],["同じ","おなじ"],["ほど"],["の"],["怒り","いかり"],["と"],["ねたみ"],["で"],["、"],["わたし"],["は"],["おまえ"],["を"],["必ず","かならず"],["罰し","ばっし"],["、"],["わたし"],["が"],["おまえ"],["を"],["さばく"],["とき"],["、"],["わたし"],["自身","じしん"],["を"],["現そう","あらわそう"],["。"]]},{"verse":12,"text":"おまえはイスラエルの山々に向かって、『これは荒れ果てて、われわれのえじきとなる』と言って、侮辱したが、主であるわたしがこれをみな聞いたことを、おまえは知るようになる。","tok":[["おまえ"],["は"],["イスラエル"],["の"],["山々","やまやま"],["に"],["向かって","むかって"],["、"],["『"],["これ"],["は"],["荒れ果てて","あれはてて"],["、"],["われわれ"],["の"],["えじき"],["と"],["なる"],["』"],["と"],["言って","いって"],["、"],["侮辱","ぶじょく"],["した"],["が"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["これ"],["を"],["みな"],["聞いた","きいた"],["こと"],["を"],["、"],["おまえ"],["は"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":13,"text":"おまえたちは、わたしに向かって高慢なことばを吐いたが、わたしはそれを聞いている。","tok":[["おまえ"],["たち"],["は"],["、"],["わたし"],["に"],["向かって","むかって"],["高慢","こうまん"],["な"],["ことば"],["を"],["吐いた","はいた"],["が"],["、"],["わたし"],["は"],["それ"],["を"],["聞いて","きいて"],["いる"],["。"]]},{"verse":14,"text":"神である主はこう仰せられる。わたしはおまえを荒れ果てさせて、全土を喜ばせよう。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["おまえ"],["を"],["荒れ果てさせて","あれはてさせて"],["、"],["全土","ぜんど"],["を"],["喜ばせよう","よろこばせよう"],["。"]]},{"verse":15,"text":"おまえは、イスラエルの家の相続地が荒れ果てたのを喜んだが、わたしはおまえに同じようにしよう。セイルの山よ。おまえは荒れ果て、エドム全体もそうなる。人々は、わたしが主であることを知ろう。","tok":[["おまえ"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["相続","そうぞく"],["地","ち"],["が"],["荒れ果てた","あれはてた"],["の"],["を"],["喜んだ","よろこんだ"],["が"],["、"],["わたし"],["は"],["おまえ"],["に"],["同じ","おなじ"],["よう"],["に"],["しよう"],["。"],["セイル"],["の"],["山","やま"],["よ"],["。"],["おまえ"],["は"],["荒れ果て","あれはて"],["、"],["エドム"],["全体","ぜんたい"],["も"],["そう"],["なる"],["。"],["人々","ひとびと"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]}]
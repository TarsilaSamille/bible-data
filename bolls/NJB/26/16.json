"わたし"],["は"],["これ"],["を"],["見た","みた"],["とき"],["、"],["彼","かれ"],["ら"],["を"],["取り除いた","とりのぞいた"],["。"]]},{"verse":51,"text":"サマリヤもまた、あなたの罪の半分ほども罪を犯さなかった。あなたが彼女たち以上に多くの忌みきらうべきことをしたので、あなたのしたすべての忌みきらうべきことが、あなたの姉妹たちを正しいとした。","tok":[["サマリヤ"],["も"],["また"],["、"],["あなた"],["の"],["罪","つみ"],["の"],["半分","はんぶん"],["ほど"],["も"],["罪","つみ"],["を"],["犯さなかった","おかさなかった"],["。"],["あなた"],["が"],["彼女","かのじょ"],["たち"],["以上","いじょう"],["に"],["多く","おおく"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["した"],["ので"],["、"],["あなた"],["の"],["した"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["が"],["、"],["あなた"],["の"],["姉妹","しまい"],["たち"],["を"],["正しい","ただしい"],["と"],["した"],["。"]]},{"verse":52,"text":"あなたも、あなたの姉妹たちをかばった恥を負え。あなたが彼女たちよりももっと忌みきらうべきことをして罪を犯したため、彼女たちがあなたよりも正しいとされたからだ。あなたもはずかしめを受けよ。あなたの姉妹たちを正しいとしたあなたの恥を負え。","tok":[["あなた"],["も"],["、"],["あなた"],["の"],["姉妹","しまい"],["たち"],["を"],["かばった"],["恥","はじ"],["を"],["負え","おえ"],["。"],["あなた"],["が"],["彼女","かのじょ"],["たち"],["より"],["も"],["もっと"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["して"],["罪","つみ"],["を"],["犯した","おかした"],["ため"],["、"],["彼女","かのじょ"],["たち"],["が"],["あなた"],["より"],["も"],["正しい","ただしい"],["と"],["された"],["から"],["だ"],["。"],["あなた"],["も"],["はずかしめ"],["を"],["受けよ","うけよ"],["。"],["あなた"],["の"],["姉妹","しまい"],["たち"],["を"],["正しい","ただしい"],["と"],["した"],["あなた"],["の"],["恥","はじ"],["を"],["負え","おえ"],["。"]]},{"verse":53,"text":"わたしは彼女たちの繁栄を元どおりにする。ソドムとその娘たちの繁栄、サマリヤとその娘たちの繁栄、また彼女たちの中にいるあなたの繁栄を元どおりにする。","tok":[["わたし"],["は"],["彼女","かのじょ"],["たち"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["する"],["。"],["ソドム"],["と"],["その"],["娘","むすめ"],["たち"],["の"],["繁栄","はんえい"],["、"],["サマリヤ"],["と"],["その"],["娘","むすめ"],["たち"],["の"],["繁栄","はんえい"],["、"],["また"],["彼女","かのじょ"],["たち"],["の"],["中","なか"],["に"],["いる"],["あなた"],["の"],["繁栄","はんえい"],["を"],["元どおり","もとどおり"],["に"],["する"],["。"]]},{"verse":54,"text":"それは、あなたが、あなた自身の恥を負い、あなたが彼女たちを慰めたときにしたすべての事によって、あなたが恥じるためである。","tok":[["それ"],["は"],["、"],["あなた"],["が"],["、"],["あなた"],["自身","じしん"],["の"],["恥","はじ"],["を"],["負い","おい"],["、"],["あなた"],["が"],["彼女","かのじょ"],["たち"],["を"],["慰めた","なぐさめた"],["とき"],["に"],["した"],["すべて"],["の"],["事","こと"],["によって"],["、"],["あなた"],["が"],["恥じる","はじる"],["ため"],["で"],["ある"],["。"]]},{"verse":55,"text":"あなたの姉妹たち、ソドムとその娘たちは、もとの所に帰り、サマリヤとその娘たちも、もとの所に帰り、あなたとあなたの娘たちも、もとの所に帰って来る。","tok":[["あなた"],["の"],["姉妹","しまい"],["たち"],["、"],["ソドム"],["と"],["その"],["娘","むすめ"],["たち"],["は"],["、"],["もと"],["の"],["所","ところ"],["に"],["帰り","かえり"],["、"],["サマリヤ"],["と"],["その"],["娘","むすめ"],["たち"],["も"],["、"],["もと"],["の"],["所","ところ"],["に"],["帰り","かえり"],["、"],["あなた"],["と"],["あなた"],["の"],["娘","むすめ"],["たち"],["も"],["、"],["もと"],["の"],["所","ところ"],["に"],["帰って","かえって"],["来る","くる"],["。"]]},{"verse":56,"text":"あなたは、高ぶっていたときには、あなたの妹ソドムを悪いうわさの種にしていたではないか。","tok":[["あなた"],["は"],["、"],["高ぶって","たかぶって"],["いた"],["とき"],["に"],["は"],["、"],["あなた"],["の"],["妹","いもうと"],["ソドム"],["を"],["悪い","わるい"],["うわさ"],["の"],["種","しゅ"],["に"],["して"],["いたで"],["は"],["ない"],["か"],["。"]]},{"verse":57,"text":"しかしそれは、あなたの悪があばかれる前のことであって、今はアラムの娘たちや、その回りのすべての者、およびあなたを回りから侮るペリシテ人の娘たちのそしりとなっている。","tok":[["しかし"],["それ"],["は"],["、"],["あなた"],["の"],["悪","あく"],["が"],["あばかれる"],["前","まえ"],["の"],["こと"],["で"],["あって"],["、"],["今","いま"],["は"],["アラム"],["の"],["娘","むすめ"],["たち"],["や"],["、"],["その"],["回り","まわり"],["の"],["すべて"],["の"],["者","もの"],["、"],["および"],["あなた"],["を"],["回り","まわり"],["から"],["侮る","あなどる"],["ペリシテ"],["人","にん"],["の"],["娘","むすめ"],["たち"],["の"],["そしり"],["と"],["なって"],["いる"],["。"]]},{"verse":58,"text":"あなたは、自分のみだらな行いと忌みきらうべきわざの報いを受けている。――主の御告げ――","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["の"],["みだら"],["な"],["行い","おこない"],["と"],["忌みきらうべき","いみきらうべき"],["わざ"],["の"],["報い","むくい"],["を"],["受けて","うけて"],["いる"],["。"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]},{"verse":59,"text":"まことに、神である主はこう仰せられる。わたしはあなたがしたとおりの事をあなたに返す。あなたは誓いをさげすんで、契約を破った。","tok":[["まこと"],["に"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["あなた"],["が"],["した"],["とおり"],["の"],["事","こと"],["を"],["あなた"],["に"],["返す","かえす"],["。"],["あなた"],["は"],["誓い","ちかい"],["を"],["さげすんで"],["、"],["契約","けいやく"],["を"],["破った","やぶった"],["。"]]},{"verse":60,"text":"だが、わたしは、あなたの若かった時にあなたと結んだわたしの契約を覚え、あなたととこしえの契約を立てる。","tok":[["だ"],["が"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["若かった","わかかった"],["時","とき"],["に"],["あなた"],["と"],["結んだ","むすんだ"],["わたし"],["の"],["契約","けいやく"],["を"],["覚え","おぼえ"],["、"],["あなた"],["と"],["とこしえ"],["の"],["契約","けいやく"],["を"],["立てる","たてる"],["。"]]},{"verse":61,"text":"わたしが、あなたの姉と妹とを選び取り、あなたとの契約には含まれていないが、わたしが彼女たちをあなたの娘としてあなたに与えるとき、あなたは自分の行いを思い出し、恥じることになろう。","tok":[["わたし"],["が"],["、"],["あなた"],["の"],["姉","あね"],["と"],["妹","いもうと"],["と"],["を"],["選び取り","えらびとり"],["、"],["あなた"],["と"],["の"],["契約","けいやく"],["に"],["は"],["含まれて","ふくまれて"],["いない"],["が"],["、"],["わたし"],["が"],["彼女","かのじょ"],["たち"],["を"],["あなた"],["の"],["娘","むすめ"],["として"],["あなた"],["に"],["与える","あたえる"],["とき"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["行い","おこない"],["を"],["思い出し","おもいだし"],["、"],["恥じる","はじる"],["こと"],["に"],["なろう"],["。"]]},{"verse":62,"text":"わたしがあなたとの契約を新たにするとき、あなたは、わたしが主であることを知ろう。","tok":[["わたし"],["が"],["あなた"],["と"],["の"],["契約","けいやく"],["を"],["新た","あらた"],["に"],["する"],["とき"],["、"],["あなた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":63,"text":"それは、わたしが、あなたの行ったすべての事について、あなたを赦すとき、あなたがこれを思い出して、恥を見、自分の恥のためにもう口出ししないためである。――神である主の御告げ――」","tok":[["それ"],["は"],["、"],["わたし"],["が"],["、"],["あなた"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["について"],["、"],["あなた"],["を"],["赦す","ゆるす"],["とき"],["、"],["あなた"],["が"],["これ"],["を"],["思い出して","おもいだして"],["、"],["恥","はじ"],["を"],["見","み"],["、"],["自分","じぶん"],["の"],["恥","はじ"],["の"],["ため"],["に"],["もう"],["口出し","くちだし"],["しない"],["ため"],["で"],["ある"],["。"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["」"]]}]
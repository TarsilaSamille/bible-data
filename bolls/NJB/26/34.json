[{"verse":1,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。イスラエルの牧者たちに向かって預言せよ。預言して、彼ら、牧者たちに言え。神である主はこう仰せられる。ああ。自分を肥やしているイスラエルの牧者たち。牧者は羊を養わなければならないのではないか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["イスラエル"],["の"],["牧者","ぼくしゃ"],["たち"],["に"],["向かって","むかって"],["預言","よげん"],["せよ"],["。"],["預言","よげん"],["して"],["、"],["彼","かれ"],["ら"],["、"],["牧者","ぼくしゃ"],["たち"],["に"],["言え","いえ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["ああ"],["。"],["自分","じぶん"],["を"],["肥やして","こやして"],["いる"],["イスラエル"],["の"],["牧者","ぼくしゃ"],["たち"],["。"],["牧者","ぼくしゃ"],["は"],["羊","ひつじ"],["を"],["養わなければ","やしなわなければ"],["ならない"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":3,"text":"あなたがたは脂肪を食べ、羊の毛を身にまとい、肥えた羊をほふるが、羊を養わない。","tok":[["あなた"],["がた"],["は"],["脂肪","しぼう"],["を"],["食べ","たべ"],["、"],["羊","ひつじ"],["の"],["毛","け"],["を"],["身","み"],["に"],["まとい"],["、"],["肥えた","こえた"],["羊","ひつじ"],["を"],["ほふる"],["が"],["、"],["羊","ひつじ"],["を"],["養わない","やしなわない"],["。"]]},{"verse":4,"text":"弱った羊を強めず、病気のものをいやさず、傷ついたものを包まず、迷い出たものを連れ戻さず、失われたものを捜さず、かえって力ずくと暴力で彼らを支配した。","tok":[["弱った","よわった"],["羊","ひつじ"],["を"],["強めず","つよめず"],["、"],["病気","びょうき"],["の"],["もの"],["を"],["いやさず"],["、"],["傷ついた","きずついた"],["もの"],["を"],["包まず","つつまず"],["、"],["迷い出た","まよいでた"],["もの"],["を"],["連れ戻さず","つれもどさず"],["、"],["失われた","うしなわれた"],["もの"],["を"],["捜さず","さがさず"],["、"],["かえって"],["力","ちから"],["ずく"],["と"],["暴力","ぼうりょく"],["で"],["彼","かれ"],["ら"],["を"],["支配","しはい"],["した"],["。"]]},{"verse":5,"text":"彼らは牧者がいないので、散らされ、あらゆる野の獣のえじきとなり、散らされてしまった。","tok":[["彼","かれ"],["ら"],["は"],["牧者","ぼくしゃ"],["が"],["いない"],["ので"],["、"],["散らされ","ちらされ"],["、"],["あらゆる"],["野","の"],["の"],["獣","けもの"],["の"],["えじき"],["と"],["なり"],["、"],["散らされて","ちらされて"],["しまった"],["。"]]},{"verse":6,"text":"わたしの羊はすべての山々やすべての高い丘をさまよい、わたしの羊は地の全面に散らされた。尋ねる者もなく、捜す者もない。","tok":[["わたし"],["の"],["羊","ひつじ"],["は"],["すべて"],["の"],["山々","やまやま"],["や"],["すべて"],["の"],["高い","たかい"],["丘","おか"],["を"],["さまよい"],["、"],["わたし"],["の"],["羊","ひつじ"],["は"],["地","ち"],["の"],["全面","ぜんめん"],["に"],["散らされた","ちらされた"],["。"],["尋ねる","たずねる"],["者","もの"],["も"],["なく"],["、"],["捜す","さがす"],["者","もの"],["も"],["ない"],["。"]]},{"verse":7,"text":"それゆえ、牧者たちよ、主のことばを聞け。","tok":[["それ"],["ゆえ"],["、"],["牧者","ぼくしゃ"],["たち"],["よ"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":8,"text":"わたしは生きている、――神である主の御告げ――わたしの羊はかすめ奪われ、牧者がいないため、あらゆる野の獣のえじきとなっている。それなのに、わたしの牧者たちは、わたしの羊を捜し求めず、かえって牧者たちは自分自身を養い、わたしの羊を養わない。","tok":[["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["わたし"],["の"],["羊","ひつじ"],["は"],["かすめ"],["奪われ","うばわれ"],["、"],["牧者","ぼくしゃ"],["が"],["いない"],["ため"],["、"],["あらゆる"],["野","の"],["の"],["獣","けもの"],["の"],["えじき"],["と"],["なって"],["いる"],["。"],["それ"],["な"],["のに"],["、"],["わたし"],["の"],["牧者","ぼくしゃ"],["たち"],["は"],["、"],["わたし"],["の"],["羊","ひつじ"],["を"],["捜し求めず","さがしもとめず"],["、"],["かえって"],["牧者","ぼくしゃ"],["たち"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["養い","やしない"],["、"],["わたし"],["の"],["羊","ひつじ"],["を"],["養わない","やしなわない"],["。"]]},{"verse":9,"text":"それゆえ、牧者たちよ、主のことばを聞け。","tok":[["それ"],["ゆえ"],["、"],["牧者","ぼくしゃ"],["たち"],["よ"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":10,"text":"神である主はこう仰せられる。わたしは牧者たちに立ち向かい、彼らの手からわたしの羊を取り返し、彼らに羊を飼うのをやめさせる。牧者たちは二度と自分自身を養えなくなる。わたしは彼らの口からわたしの羊を救い出し、彼らのえじきにさせない。","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["は"],["牧者","ぼくしゃ"],["たち"],["に"],["立ち向かい","たちむかい"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["わたし"],["の"],["羊","ひつじ"],["を"],["取り返し","とりかえし"],["、"],["彼","かれ"],["ら"],["に"],["羊","ひつじ"],["を"],["飼う","かう"],["の"],["を"],["やめさせる"],["。"],["牧者","ぼくしゃ"],["たち"],["は"],["二","に"],["度","ど"],["と"],["自分","じぶん"],["自身","じしん"],["を"],["養えなく","やしなえなく"],["なる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["口","くち"],["から"],["わたし"],["の"],["羊","ひつじ"],["を"],["救い出し","すくいだし"],["、"],["彼","かれ"],["ら"],["の"],["えじき"],["に"],["させない"],["。"]]},{"verse":11,"text":"まことに、神である主はこう仰せられる。見よ。わたしは自分でわたしの羊を捜し出し
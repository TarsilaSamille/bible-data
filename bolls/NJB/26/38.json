[{"verse":1,"text":"さらに、私に次のような主のことばがあった。","tok":[["さらに"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「人の子よ。メシェクとトバルの大首長であるマゴグの地のゴグに顔を向け、彼に預言して、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["メシェク"],["と"],["トバル"],["の"],["大","だい"],["首長","しゅちょう"],["で"],["ある"],["マゴグ"],["の"],["地","ち"],["の"],["ゴグ"],["に"],["顔","かお"],["を"],["向け","むけ"],["、"],["彼","かれ"],["に"],["預言","よげん"],["して"],["、"]]},{"verse":3,"text":"言え。神である主はこう仰せられる。メシェクとトバルの大首長であるゴグよ。今、わたしは、あなたに立ち向かう。","tok":[["言え","いえ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["メシェク"],["と"],["トバル"],["の"],["大","だい"],["首長","しゅちょう"],["で"],["ある"],["ゴグ"],["よ"],["。"],["今","いま"],["、"],["わたし"],["は"],["、"],["あなた"],["に"],["立ち向かう","たちむかう"],["。"]]},{"verse":4,"text":"わたしはあなたを引き回し、あなたのあごに鉤をかけ、あなたと、あなたの全軍勢を出陣させる。それはみな武装した馬や騎兵、大盾と盾を持ち、みな剣を取る大集団だ。","tok":[["わたし"],["は"],["あなた"],["を"],["引き回し","ひきまわし"],["、"],["あなた"],["の"],["あご"],["に"],["鉤","はり"],["を"],["かけ"],["、"],["あなた"],["と"],["、"],["あなた"],["の"],["全","ぜん"],["軍勢","ぐんぜい"],["を"],["出陣","しゅつじん"],["させる"],["。"],["それ"],["は"],["みな"],["武装","ぶそう"],["した"],["馬","うま"],["や"],["騎兵","きへい"],["、"],["大","だい"],["盾","たて"],["と"],["盾","たて"],["を"],["持ち","もち"],["、"],["みな"],["剣","けん"],["を"],["取る","とる"],["大","だい"],["集団","しゅうだん"],["だ"],["。"]]},{"verse":5,"text":"ペルシヤとクシュとプテも彼らとともにおり、みな盾とかぶとを着けている。","tok":[["ペルシヤ"],["と"],["クシュ"],["と"],["プテ"],["も"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["おり"],["、"],["みな"],["盾","たて"],["と"],["かぶと"],["を"],["着けて","つけて"],["いる"],["。"]]},{"verse":6,"text":"ゴメルと、そのすべての軍隊、北の果てのベテ・トガルマと、そのすべての軍隊、それに多くの国々の民があなたとともにいる。","tok":[["ゴメル"],["と"],["、"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["、"],["北","きた"],["の"],["果て","はて"],["の"],["ベテ"],["・"],["トガルマ"],["と"],["、"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["、"],["それ"],["に"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["あなた"],["と"],["とも"],["に"],["いる"],["。"]]},{"verse":7,"text":"備えをせよ。あなたも、あなたのところに集められた全集団も備えをせよ。あなたは彼らを監督せよ。","tok":[["備え","そなえ"],["を"],["せよ"],["。"],["あなた"],["も"],["、"],["あなた"],["の"],["ところ"],["に"],["集められた","あつめられた"],["全","ぜん"],["集団","しゅうだん"],["も"],["備え","そなえ"],["を"],["せよ"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["監督","かんとく"],["せよ"],["。"]]},{"verse":8,"text":"多くの日が過ぎて、あなたは命令を受け、終わりの年に、一つの国に侵入する。その国は剣の災害から立ち直り、その民は多くの国々の民の中から集められ、久しく廃墟であったイスラエルの山々に住んでいる。その民は国々の民の中から連れ出され、彼らはみな安心して住んでいる。","tok":[["多く","おおく"],["の"],["日","ひ"],["が"],["過ぎて","すぎて"],["、"],["あなた"],["は"],["命令","めいれい"],["を"],["受け","うけ"],["、"],["終わり","おわり"],["の"],["年","とし"],["に"],["、"],["一","ひと"],["つ"],["の"],["国","くに"],["に"],["侵入","しんにゅう"],["する"],["。"],["その"],["国","くに"],["は"],["剣","けん"],["の"],["災害","さいがい"],["から"],["立ち直り","たちなおり"],["、"],["その"],["民","みん"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["集められ","あつめられ"],["、"],["久しく","ひさしく"],["廃墟","はいきょ"],["で"],["あった"],["イスラエル"],["の"],["山々","やまやま"],["に"],["住んで","すんで"],["いる"],["。"],["その"],["民","みん"],["は"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["連れ出され","つれだされ"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["安心","あんしん"],["して"],["住んで","すんで"],["いる"],["。"]]},{"verse":9,"text":"あなたは、あらしのように攻め上り、あなたと、あなたの全部隊、それに、あなたにつく多くの国々の民は、地をおおう雲のようになる。","tok":[["あなた"],["は"],["、"],["あらし"],["の"],["よう"],["に"],["攻め上り","せめのぼり"],["、"],["あなた"],["と"],["、"],["あなた"],["の"],["全","ぜん"],["部隊","ぶたい"],["、"],["それ"],["に"],["、"],["あなた"],["に"],["つく"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["、"],["地","ち"],["を"],["おおう"],["雲","くも"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":10,"text":"神である主はこう仰せられる。その日には、あなたの心にさまざまな思いが浮かぶ。あなたは悪巧みを設け、","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["その"],["日","ひ"],["に"],["は"],["、"],["あなた"],["の"],["心","こころ"],["に"],["さまざま"],["な"],["思い","おもい"],["が"],["浮かぶ","うかぶ"],["。"],["あなた"],["は"],["悪巧み","わるだくみ"],["を"],["設け","もうけ"],["、"]]},{"verse":11,"text":"こう言おう。『私は城壁のない町々の国に攻め上り、安心して住んでいる平和な国に侵入しよう。彼らはみな、城壁もかんぬきも門もない所に住んでいる。』","tok":[["こう"],["言おう","いおう"],["。"],["『"],["私","わたくし"],["は"],["城壁","じょうへき"],["の"],["ない"],["町々","まちまち"],["の"],["国","くに"],["に"],["攻め上り","せめのぼり"],["、"],["安心","あんしん"],["して"],["住んで","すんで"],["いる"],["平和","へいわ"],["な"],["国","くに"],["に"],["侵入","しんにゅう"],["しよう"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["城壁","じょうへき"],["も"],["かんぬき"],["も"],["門","もん"],["も"],["ない"],["所","ところ"],["に"],["住んで","すんで"],["いる"],["。"],["』"]]},{"verse":12,"text":"あなたは物を分捕り、獲物をかすめ奪い、今は人の住むようになった廃墟や、国々から集められ、その国の中心に住み、家畜と財産を持っている民に向かって、あなたの腕力をふるおうとする。","tok":[["あなた"],["は"],["物","もの"],["を"],["分捕り","ぶんどり"],["、"],["獲物","えもの"],["を"],["かすめ"],["奪い","うばい"],["、"],["今","いま"],["は"],["人","ひと"],["の"],["住む","すむ"],["よう"],["に"],["なった"],["廃墟","はいきょ"],["や"],["、"],["国々","くにぐに"],["から"],["集められ","あつめられ"],["、"],["その"],["国","くに"],["の"],["中心","ちゅうしん"],["に"],["住み","すみ"],["、"],["家畜","かちく"],["と"],["財産","ざいさん"],["を"],["持って","もって"],["いる"],["民","たみ"],["に"],["向かって","むかって"],["、"],["あなた"],["の"],["腕力","わんりょく"],["を"],["ふるおう"],["と"],["する"],["。"]]},{"verse":13,"text":"シェバやデダンやタルシシュの商人たち、およびそのすべての若い獅子たちは、あなたに聞こう。『あなたは物を分捕るために来たのか。獲物をかすめ奪うために集団を集め、銀や金を運び去り、家畜や財産を取り、大いに略奪をしようとするのか』と。","tok":[["シェバ"],["や"],["デダン"],["や"],["タルシシュ"],["の"],["商人","しょうにん"],["たち"],["、"],["および"],["その"],["すべて"],["の"],["若い","わかい"],["獅子","しし"],["たち"],["は"],["、"],["あなた"],["に"],["聞こう","きこう"],["。"],["『"],["あなた"],["は"],["物","もの"],["を"],["分捕る","ぶんどる"],["ため"],["に"],["来た","きた"],["の"],["か"],["。"],["獲物","えもの"],["を"],["かすめ"],["奪う","うばう"],["ため"],["に"],["集団","しゅうだん"],["を"],["集め","あつめ"],["、"],["銀","ぎん"],["や"],["金","きん"],["を"],["運び去り","はこびさり"],["、"],["家畜","かちく"],["や"],["財産","ざいさん"],["を"],["取り","とり"],["、"],["大いに","おおいに"],["略奪","りゃくだつ"],["を"],["しよう"],["と"],["する"],["の"],["か"],["』"],["と"],["。"]]},{"verse":14,"text":"それゆえ、人の子よ、預言してゴグに言え。神である主はこう仰せられる。わたしの民イスラエルが安心して住んでいるとき、実に、その日、あなたは奮い立つのだ。","tok":[["それ"],["ゆえ"],["、"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["預言","よげん"],["して"],["ゴグ"],["に"],["言え","いえ"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["の"],["民","みん"],["イスラエル"],["が"],["安心","あんしん"],["して"],["住んで","すんで"],["いる"],["とき"],["、"],["実","じつ"],["に"],["、"
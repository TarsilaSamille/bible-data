[{"verse":1,"text":"次のような主のことばが私にあった。","tok":[["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["私","わたくし"],["に"],["あった"],["。"]]},{"verse":2,"text":"人の子よ。ぶどうの木は、森の木立ちの間にあって、その枝が、ほかの木よりどれだけすぐれているのか。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["。"],["ぶどう"],["の"],["木","き"],["は"],["、"],["森","もり"],["の"],["木立ち","こだち"],["の"],["間","あいだ"],["に"],["あって"],["、"],["その"],["枝","えだ"],["が"],["、"],["ほか"],["の"],["木","き"],["より"],["どれ"],["だけ"],["すぐれて"],["いる"],["の"],["か"],["。"]]},{"verse":3,"text":"その木を使って何かを作るために／その木は切り出されるだろうか。／それとも、あらゆる器具を掛けるために／これを使って木かぎを作るだろうか。","tok":[["その"],["木","き"],["を"],["使って","つかって"],["何","なん"],["か"],["を"],["作る","つくる"],["ため"],["に"],["／"],["その"],["木","き"],["は"],["切り出されるだろう","きりだされるだろう"],["か"],["。"],["／"],["それ"],["と"],["も"],["、"],["あらゆる"],["器具","きぐ"],["を"],["掛ける","かける"],["ため"],["に"],["／"],["これ"],["を"],["使って","つかって"],["木","き"],["かぎ"],["を"],["作るだろう","つくるだろう"],["か"],["。"]]},{"verse":4,"text":"見よ。それは、たきぎとして火に投げ入れられ、火がその両端を焼き尽くす。／その中ほども焦げてしまえば、それは何の役に立つだろうか。","tok":[["見","み"],["よ"],["。"],["それ"],["は"],["、"],["たきぎ"],["として"],["火","ひ"],["に"],["投げ入れられ","なげいれられ"],["、"],["火","ひ"],["が"],["その"],["両端","りょうたん"],["を"],["焼き","やき"],["尽くす","つくす"],["。"],["／"],["その"],["中ほど","なかほど"],["も"],["焦げて","こげて"],["しまえば"],["、"],["それ"],["は"],["何","なん"],["の"],["役","やく"],["に"],["立つだろう","たつだろう"],["か"],["。"]]},{"verse":5,"text":"見よ。それが完全なときでも、何も作れないのに、まして、火がそれを燃やして、焦がせば、もう、それで何が作れよう。","tok":[["見","み"],["よ"],["。"],["それ"],["が"],["完全","かんぜん"],["な"],["とき"],["で"],["も"],["、"],["何","なん"],["も"],["作れない","つくれない"],["のに"],["、"],["まして"],["、"],["火","ひ"],["が"],["それ"],["を"],["燃やして","もやして"],["、"],["焦がせば","こがせば"],["、"],["もう"],["、"],["それ"],["で"],["何","なん"],["が"],["作れよう","つくれよう"],["。"]]},{"verse":6,"text":"それゆえ、神である主はこう仰せられる。／わたしはエルサレムの住民を、わたしがたきぎとして火に投げ入れた、森の木立ちの間のぶどうの木のように、火に投げ入れてしまう。","tok":[["それ"],["ゆえ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["わたし"],["は"],["エルサレム"],["の"],["住民","じゅうみん"],["を"],["、"],["わたし"],["が"],["たきぎ"],["として"],["火","ひ"],["に"],["投げ入れた","なげいれた"],["、"],["森","もり"],["の"],["木立ち","こだち"],["の"],["間","あいだ"],["の"],["ぶどう"],["の"],["木","き"],["の"],["よう"],["に"],["、"],["火","ひ"],["に"],["投げ入れて","なげいれて"],["しまう"],["。"]]},{"verse":7,"text":"わたしは彼らから顔をそむける。／彼らが火からのがれても、火は彼らを焼き尽くしてしまう。／わたしが彼らから顔をそむけるそのとき、あなたがたは、わたしが主であることを知ろう。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["から"],["顔","かお"],["を"],["そむける"],["。"],["／"],["彼","かれ"],["ら"],["が"],["火","ひ"],["から"],["のがれて"],["も"],["、"],["火","ひ"],["は"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くして","つくして"],["しまう"],["。"],["／"],["わたし"],["が"],["彼","かれ"],["ら"],["から"],["顔","かお"],["を"],["そむける"],["その"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["。"]]},{"verse":8,"text":"彼らがわたしに不信に不信を重ねたので、わたしはこの地を荒れ果てさせる。／――神である主の御告げ――","tok":[["彼","かれ"],["ら"],["が"],["わたし"],["に"],["不信","ふしん"],["に"],["不信","ふしん"],["を"],["重ねた","かさねた"],["ので"],["、"],["わたし"],["は"],["この"],["地","ち"],["を"],["荒れ果てさせる","あれはてさせる"],["。"],["／"],["―"],["―"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"]]}]
[{"verse":1,"text":"主よ。私たちに起こったことを思い出してください。／私たちのそしりに目を留めてください。／顧みてください。","tok":[["主","ぬし"],["よ"],["。"],["私たち","わたしたち"],["に"],["起こった","おこった"],["こと"],["を"],["思い出して","おもいだして"],["ください"],["。"],["／"],["私たち","わたしたち"],["の"],["そしり"],["に"],["目","め"],["を"],["留めて","とめて"],["ください"],["。"],["／"],["顧みて","かえりみて"],["ください"],["。"]]},{"verse":2,"text":"私たちの相続地は他国人の手に渡り、私たちの家もよそ者の手に渡りました。","tok":[["私たち","わたしたち"],["の"],["相続","そうぞく"],["地","ち"],["は"],["他国人","たこくにん"],["の"],["手","て"],["に"],["渡り","わたり"],["、"],["私たち","わたしたち"],["の"],["家","いえ"],["も"],["よそ者","よそもの"],["の"],["手","て"],["に"],["渡りました","わたりました"],["。"]]},{"verse":3,"text":"私たちは父親のないみなしごとなり、私たちの母はやもめになりました。","tok":[["私たち","わたしたち"],["は"],["父親","ちちおや"],["の"],["ない"],["みなしご"],["と"],["なり"],["、"],["私たち","わたしたち"],["の"],["母","はは"],["は"],["やもめ"],["に"],["なりました"],["。"]]},{"verse":4,"text":"私たちは自分たちの水を、金を払って飲み、自分たちのたきぎも、代価を払って／手に入れなければなりません。","tok":[["私たち","わたしたち"],["は"],["自分","じぶん"],["たち"],["の"],["水","みず"],["を"],["、"],["金","きん"],["を"],["払って","はらって"],["飲み","のみ"],["、"],["自分","じぶん"],["たち"],["の"],["たきぎ"],["も"],["、"],["代価","だいか"],["を"],["払って","はらって"],["／"],["手","て"],["に"],["入れなければ","いれなければ"],["なりません"],["。"]]},{"verse":5,"text":"私たちはくびきを負って、追い立てられ、疲れ果てても、休むことができません。","tok":[["私たち","わたしたち"],["は"],["くびき"],["を"],["負って","おって"],["、"],["追い立てられ","おいたてられ"],["、"],["疲れ","つかれ"],["果てて","はてて"],["も"],["、"],["休む","やすむ"],["こと"],["が"],["できません"],["。"]]},{"verse":6,"text":"私たちは足りるだけの食物を得ようと、エジプトやアッシリヤに手を伸ばしました。","tok":[["私たち","わたしたち"],["は"],["足りる","たりる"],["だけ"],["の"],["食物","しょくもつ"],["を"],["得よう","えよう"],["と"],["、"],["エジプト"],["や"],["アッシリヤ"],["に"],["手","て"],["を"],["伸ばしました","のばしました"],["。"]]},{"verse":7,"text":"私たちの先祖は罪を犯しました。／彼らはもういません。／彼らの咎を私たちが背負いました。","tok":[["私たち","わたしたち"],["の"],["先祖","せんぞ"],["は"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["／"],["彼","かれ"],["ら"],["は"],["もう"],["いません"],["。"],["／"],["彼","かれ"],["ら"],["の"],["咎","とが"],["を"],["私たち","わたしたち"],["が"],["背負いました","せおいました"],["。"]]},{"verse":8,"text":"奴隷たちが私たちを支配し、だれも彼らの手から／私たちを救い出してくれません。","tok":[["奴隷","どれい"],["たち"],["が"],[
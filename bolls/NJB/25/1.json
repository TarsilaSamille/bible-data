[{"verse":1,"text":"ああ、人の群がっていたこの町は、ひとり寂しくすわっている。／国々の中で大いなる者であったのに、やもめのようになった。／諸州のうちの女王は、苦役に服した。","tok":[["ああ"],["、"],["人","ひと"],["の"],["群がって","むらがって"],["いた"],["この"],["町","まち"],["は"],["、"],["ひとり"],["寂しく","さびしく"],["すわって"],["いる"],["。"],["／"],["国々","くにぐに"],["の"],["中","なか"],["で"],["大いなる","おおいなる"],["者","もの"],["で"],["あった"],["のに"],["、"],["やもめ"],["の"],["よう"],["に"],["なった"],["。"],["／"],["諸州","しょしゅう"],["の"],["うち"],["の"],["女王","じょおう"],["は"],["、"],["苦役","くえき"],["に"],["服した","ふくした"],["。"]]},{"verse":2,"text":"彼女は泣きながら夜を過ごし、涙は頬を伝っている。／彼女の愛する者は、だれも慰めてくれない。／その友もみな彼女を裏切り、彼女の敵となってしまった。","tok":[["彼女","かのじょ"],["は"],["泣き","なき"],["ながら"],["夜","よる"],["を"],["過ごし","すごし"],["、"],["涙","なみだ"],["は"],["頬","ほお"],["を"],["伝って","つたって"],["いる"],["。"],["／"],["彼女","かのじょ"],["の"],["愛する","あいする"],["者","もの"],["は"],["、"],["だれ"],["も"],["慰めて","なぐさめて"],["くれない"],["。"],["／"],["その"],["友","とも"],["も"],["みな"],["彼女","かのじょ"],["を"],["裏切り","うらぎり"],["、"],["彼女","かのじょ"],["の"],["敵","てき"],["と"],["なって"],["しまった"],["。"]]},{"verse":3,"text":"ユダは悩みと多くの労役のうちに／捕らえ移された。／彼女は異邦の民の中に住み、いこうこともできない。／苦しみのうちにあるときに、彼女に追い迫る者たちがみな、彼女に追いついた。","tok":[["ユダ"],["は"],["悩み","なやみ"],["と"],["多く","おおく"],["の"],["労役","ろうえき"],["の"],["うち"],["に"],["／"],["捕らえ","とらえ"],["移された","うつされた"],["。"],["／"],["彼女","かのじょ"],["は"],["異邦","いほう"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["住み","すみ"],["、"],["いこう"],["こと"],["も"],["できない"],["。"],["／"],["苦しみ","くるしみ"],["の"],["うち"],["に"],["ある"],["とき"],["に"],["、"],["彼女","かのじょ"],["に"],["追い迫る","おいせまる"],["者","もの"],["たち"],["が"],["みな"],["、"],["彼女","かのじょ"],["に"],["追いついた","おいついた"],["。"]]},{"verse":4,"text":"シオンへの道は喪に服し、だれも例祭に行かない。／その門はみな荒れ果て、その祭司たちはうめき、おとめたちは憂いに沈んでいる。／シオンは苦しんでいる。","tok":[["シオン"],["へ"],["の"],["道","みち"],["は"],["喪","も"],["に"],["服し","ふくし"],["、"],["だれ"],["も"],["例祭","れいさい"],["に"],["行かない","いかない"],["。"],["／"],["その"],["門","もん"],["は"],["みな"],["荒れ果て","あれはて"],["、"],["その"],["祭司","さいし"],["たち"],["は"],["うめき"],["、"],["おとめ"],["たち"],["は"],["憂い","うれい"],["に"],["沈んで","しずんで"],["いる"],["。"],["／"],["シオン"],["は"],["苦しんで","くるしんで"],["いる"],["。"]]},{"verse":5,"text":"彼女の仇がかしらとなり、彼女の敵が栄えている。／彼女の多くのそむきの罪のために、主が彼女を悩ましたのだ。／彼女の幼子たちも、仇によって／とりことなって行った。","tok":[["彼女","かのじょ"],["の"],["仇","あだ"],["が"],["かしら"],["と"],["なり"],["、"],["彼女","かのじょ"],["の"],["敵","てき"],["が"],["栄えて","さかえて"],["いる"],["。"],["／"],["彼女","かのじょ"],["の"],["多く","おおく"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["主","ぬし"],["が"],["彼女","かのじょ"],["を"],["悩ました","なやました"],["の"],["だ"],["。"],["／"],["彼女","かのじょ"],["の"],["幼子","おさなご"],["たち"],["も"],["、"],["仇","あだ"],["によって"],["／"],["とりこ"],["と"],["なって"],["行った","いった"],["。"]]},{"verse":6,"text":"シオンの娘からは、すべての輝きがなくなり、首長たちは、牧場のない鹿のようになって、追う者の前を力なく歩む。","tok":[["シオン"],["の"],["娘","むすめ"],["から"],["は"],["、"],["すべて"],["の"],["輝き","かがやき"],["が"],["なくなり"],["、"],["首長","しゅちょう"],["たち"],["は"],["、"],["牧場","ぼくじょう"],["の"],["ない"],["鹿","しか"],["の"],["よう"],["に"],["なって"],["、"],["追う","おう"],["者","もの"],["の"],["前","まえ"],["を"],["力なく","ちからなく"],["歩む","あゆむ"],["。"]]},{"verse":7,"text":"エルサレムは、悩みとさすらいの日にあたって、昔から持っていた自分のすべての宝を思い出す。／その民が仇の手によって倒れ、だれも彼女を助ける者がないとき、仇はその破滅を見てあざ笑う。","tok":[["エルサレム"],["は"],["、"],["悩み","なやみ"],["と"],["さすらい"],["の"],["日","ひ"],["に"],["あたって"],["、"],["昔","むかし"],["から"],["持って","もって"],["いた"],["自分","じぶん"],["の"],["すべて"],["の"],["宝","たから"],["を"],["思い出す","おもいだす"],["。"],["／"],["その"],["民","たみ"],["が"],["仇","あだ"],["の"],["手","て"],["によって"],["倒れ","たおれ"],["、"],["だれ"],["も"],["彼女","かのじょ"],["を"],["助ける","たすける"],["者","もの"],["が"],["ない"],["とき"],["、"],["仇","あだ"],["は"],["その"],["破滅","はめつ"],["を"],["見て","みて"],["あざ笑う","あざわらう"],["。"]]},{"verse":8,"text":"エルサレムは罪に罪を重ねて、汚らわしいものとなった。／彼女を尊んだ者たちもみな、その裸を見て、これを卑しめる。／彼女もうめいてたじろいだ。","tok":[["エルサレム"],["は"],["罪","つみ"],["に"],["罪","つみ"],["を"],["重ねて","かさねて"],["、"],["汚らわしい","けがらわしい"],["もの"],["と"],["なった"],["。"],["／"],["彼女","かのじょ"],["を"],["尊んだ","とうとんだ"],["者","もの"],["たち"],["も"],["みな"],["、"],["その"],["裸","はだか"],["を"],["見て","みて"],["、"],["これ"],["を"],["卑しめる","いやしめる"],["。"],["／"],["彼女","かのじょ"],["も"],["うめいて"],["たじろいだ"],["。"]]},{"verse":9,"text":"彼女の汚れはすそにまでついている。／彼女は自分の末路を思わなかった。／それで、驚くほど落ちぶれて、だれも慰める者がない。「主よ。私の悩みを顧みてください。敵は勝ち誇っています。」","tok":[["彼女","かのじょ"],["の"],["汚れ","よごれ"],["は"],["すそ"],["に"],["まで"],["ついて"],["いる"],["。"],["／"],["彼女","かのじょ"],["は"],["自分","じぶん"],["の"],["末路","まつろ"],["を"],["思わなかった","おもわなかった"],["。"],["／"],["それ"],["で"],["、"],["驚く","おどろく"],["ほど"],["落ちぶれて","おちぶれて"],["、"],["だれ"],["も"],["慰める","なぐさめる"],["者","もの"],["が"],["ない"],["。"],["「"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["悩み","なやみ"],["を"],["顧みて","かえりみて"],["ください"],["。"],["敵","てき"],["は"],["勝ち誇って","かちほこって"],["います"],["。"],["」"]]},{"verse":10,"text":"仇が彼女の宝としているものすべてに／手を伸ばしました。／異邦の民が、その聖所に入ったのを／彼女は見ました。／あなたの集団に加わってはならないと、あなたがかつて命じられたものが。","tok":[["仇","あだ"],["が"],["彼女","かのじょ"],["の"],["宝","たから"],["として"],["いる"],["もの"],["すべて"],["に"],["／"],["手","て"],["を"],["伸ばしました","のばしました"],["。"],["／"],["異邦","いほう"],["の"],["民","たみ"],["が"],["、"],["その"],["聖","せい"],["所","しょ"],["に"],["入った","はいった"],["の"],["を"],["／"],["彼女","かのじょ"],["は"],["見ました","みました"],["。"],["／"],["あなた"],["の"],["集団","しゅうだん"],["に"],["加わって","くわわって"],["は"],["ならない"],["と"],["、"],["あなた"],["が"],["かつて"],["命じられた","めいじられた"],["もの"],["が"],["。"]]},{"verse":11,"text":"彼女の民はみなうめき、食べ物を捜しています。／気力を取り戻そうとして、自分の宝としているものを食物に代えています。「主よ。私が、卑しい女になり果てたのをよく見てください。」","tok":[["彼女","かのじょ"],["の"],["民","たみ"],["は"],["みな"],["うめき"],["、"],["食べ物","たべもの"],["を"],["捜して","さがして"],["います"],["。"],["／"],["気力","きりょく"],["を"],["取り戻そう","とりもどそう"],["として"],["、"],["自分","じぶん"],["の"],["宝","たから"],["として"],["いる"],["もの"],["を"],["食物","しょくもつ"],["に"],["代えて","かえて"],["います"],["。"],["「"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["が"],["、"],["卑しい","いやしい"],["女","おんな"],["に"],["なり"],["果てた","はてた"],["の"],["を"],["よく"],["見て","みて"],["ください"],["。"],["」"]]},{"verse":12,"text":"道行くみなの人よ。よく見よ。／主が燃える怒りの日に私を悩まし、私をひどいめに会わされた／このような痛みがほかにあるかどうかを。","tok":[["道","みち"],["行く","いく"],["みな"],["の"],["人","ひと"],["よ"],["。"],["よく"],["見よ","みよ"],["。"],["／"],["主","ぬし"],["が"],["燃える","もえる"],["怒り","いかり"],["の"],["日","ひ"],["に"],["私","わたくし"],["を"],["悩まし","なやまし"],["、"],["私","わたくし"],["を"],["ひどい"],["め"],["に"],["会わされた","あわされた"],["／"],["この"],["よう"],["な"],["痛み","いたみ"],["が"],["ほか"],["に"],["ある"],["か"],["どう"],["か"],["を"],["。"]]},{"verse":13,"text":"主は高い所から火を送り、私の骨の中にまで送り込まれた。／私の足もとに網を張り、私をうしろにのけぞらせ、私を荒れすさんだ女、終日、病んでいる女とされた。","tok":[["主","ぬし"],["は"],["高い","たかい"],["所","ところ"],["から"],["火","ひ"],["を"],["送り","おくり"],["、"],["私","わたくし"],["の"],["骨","ほね"],["の"],["中","なか"],["に"],["まで"],["送り込まれた","おくりこまれた"],["。"],["／"],["私","わたくし"],["の"],["足もと","あしもと"],["に"],["網","あみ"],["を"],["張り","はり"],["、"],["私","わたくし"],["を"],["うしろ"],["に"],["のけぞらせ"],["、"],["私","わたくし"],["を"],["荒れすさんだ","あれすさんだ"],["女","おんな"],["、"],["終日","しゅうじつ"],["、"],["病んで","やんで"],["いる"],["女","おんな"],["と"],["された"],["。"]]},{"verse":14,"text":"私のそむきの罪のくびきは重く、主の御手で、私の首に結びつけられた。／主は、私の力をくじき、私を、彼らの手にゆだね、もう立ち上がれないようにされた。","tok":[["私","わたくし"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["くびき"],["は"],["重く","おもく"],["、"],["主","ぬし"],["の"],["御手","おて"],["で"],["、"],["私","わたくし"],["の"],["首","くび"],["に"],["結びつけられた","むすびつけられた"],["。"],["／"],["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["力","ちから"],["を"],["くじき"],["、"],["私","わたくし"],["を"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["ゆだね"],["、"],["もう"],["立ち上がれない","たちあがれない"],["よう"],["に"],["された"],["。"]]},{"verse":15,"text":"主は、私のうちにいたつわものをみな追い払い、一つの群れを呼び集めて、私を攻め、私の若い男たちを滅ぼされた。／主は、酒ぶねを踏むように、おとめユダの娘を踏みつぶされた。","tok":[["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["うち"],["に"],["いた"],["つわもの"],["を"],["みな"],["追い払い","おいはらい"],["、"],["一","ひと"],["つ"],["の"],["群れ","むれ"],["を"],["呼び集めて","よびあつめて"],["、"],["私","わたくし"],["を"],["攻め","せめ"],["、"],["私","わたくし"],["の"],["若い","わかい"],["男","おとこ"],["たち"],["を"],["滅ぼされた","ほろぼされた"],["。"],["／"],["主","ぬし"],["は"],["、"],["酒","さけ"],["ぶね"],["を"],["踏む","ふむ"],["よう"],["に"],["、"],["おとめ"],["ユダ"],["の"],["娘","むすめ"],["を"],["踏みつぶされた","ふみつぶされた"],["。"]]},{"verse":16,"text":"このことで、私は泣いている。／私の目、この目から涙があふれる。／私を元気づけて慰めてくれる者が、私から遠ざかったからだ。／敵に打ち負かされて、私の子らは荒れすさんでいる。","tok":[["この"],["こと"],["で"],["、"],["私","わたくし"],["は"],["泣いて","ないて"],["いる"],["。"],["／"],["私","わたくし"],["の"],["目","め"],["、"],["この"],["目","め"],["から"],["涙","なみだ"],["が"],["あふれる"],["。"],["／"],["私","わたくし"],["を"],["元気","げんき"],["づけて"],["慰めて","なぐさめて"],["くれる"],["者","もの"],["が"],["、"],["私","わたくし"],["から"],["遠ざかった","とおざかった"],["から"],["だ"],["。"],["／"],["敵","てき"],["に"],["打ち負かされて","うちまかされて"],["、"],["私","わたくし"],["の"],["子","こ"],["ら"],["は"],["荒れすさんで","あれすさんで"],["いる"],["。"]]},{"verse":17,"text":"シオンが手を差し出しても、これを慰める者はない。／主は仇に命じて、四方からヤコブを攻めさせた。／エルサレムは彼らの間で、汚らわしいものとなった。","tok":[["シオン"],["が"],["手","て"],["を"],["差し出して","さしだして"],["も"],["、"],["これ"],["を"],["慰める","なぐさめる"],["者","もの"],["は"],["ない"],["。"],["／"],["主","ぬし"],["は"],["仇","あだ"],["に"],["命じて","めいじて"],["、"],["四方","しほう"],["から"],["ヤコブ"],["を"],["攻めさせた","せめさせた"],["。"],["／"],["エルサレム"],["は"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["、"],["汚らわしい","けがらわしい"],["もの"],["と"],["なった"],["。"]]},{"verse":18,"text":"主は正義を行われる。／しかし、私は主の命令に逆らった。／だが、すべての国々の民よ、聞け。／私の痛みを見よ。／私の若い女たちも、若い男たちも、とりことなって行った。","tok":[["主","ぬし"],["は"],["正義","せいぎ"],["を"],["行われる","おこなわれる"],["。"],["／"],["しかし"],["、"],["私","わたくし"],["は"],["主","ぬし"],["の"],["命令","めいれい"],["に"],["逆らった","さからった"],["。"],["／"],["だ"],["が"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["よ"],["、"],["聞け","きけ"],["。"],["／"],["私","わたくし"],["の"],["痛み","いたみ"],["を"],["見よ","みよ"],["。"],["／"],["私","わたくし"],["の"],["若い","わかい"],["女","おんな"],["たち"],["も"],["、"],["若い","わかい"],["男","おとこ"],["たち"],["も"],["、"],["とりこ"],["と"],["なって"],["行った","いった"],["。"]]},{"verse":19,"text":"私は愛する者たちを呼んだのに、彼らは私を欺いた。／私の祭司も長老たちも、町の中で息絶えた。／気力を取り戻そうとして、自分の食物を捜していたときに。","tok":[["私","わたくし"],["は"],["愛する","あいする"],["者","もの"],["たち"],["を"],["呼んだ","よんだ"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["を"],["欺いた","あざむいた"],["。"],["／"],["私","わたくし"],["の"],["祭司","さいし"],["も"],["長老","ちょうろう"],["たち"],["も"],["、"],["町","まち"],["の"],["中","なか"],["で"],["息","いき"],["絶えた","たえた"],["。"],["／"],["気力","きりょく"],["を"],["取り戻そう","とりもどそう"],["として"],["、"],["自分","じぶん"],["の"],["食物","しょくもつ"],["を"],["捜して","さがして"],["いた"],["とき"],["に"],["。"]]},{"verse":20,"text":"「主よ。ご覧ください。／私は苦しみ、私のはらわたは煮え返り、私の心は私のうちで転倒しています。／私が逆らい続けたからです。／外では剣が子を奪い、家の中は死のようです。","tok":[["「"],["主","ぬし"],["よ"],["。"],["ご覧","ごらん"],["ください"],["。"],["／"],["私","わたくし"],["は"],["苦しみ","くるしみ"],["、"],["私","わたくし"],["の"],["はらわた"],["は"],["煮え返り","にえかえ
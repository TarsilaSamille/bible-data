[{"verse":1,"text":"一方、ボアズは門のところへ上って行って、そこにすわった。すると、ちょうど、ボアズが言ったあの買い戻しの権利のある親類の人が通りかかった。ボアズは、彼にことばをかけた。「ああ、もしもし、こちらに立ち寄って、おすわりになってください。」彼は立ち寄ってすわった。","tok":[["一方","いっぽう"],["、"],["ボアズ"],["は"],["門","もん"],["の"],["ところ"],["へ"],["上って","のぼって"],["行って","いって"],["、"],["そこ"],["に"],["すわった"],["。"],["する"],["と"],["、"],["ちょうど"],["、"],["ボアズ"],["が"],["言った","いった"],["あの"],["買い戻し","かいもどし"],["の"],["権利","けんり"],["の"],["ある"],["親類","しんるい"],["の"],["人","ひと"],["が"],["通りかかった","とおりかかった"],["。"],["ボアズ"],["は"],["、"],["彼","かれ"],["に"],["ことば"],["を"],["かけた"],["。"],["「"],["ああ"],["、"],["もしもし"],["、"],["こちら"],["に"],["立ち寄って","たちよって"],["、"],["おすわり"],["に"],["なって"],["ください"],["。"],["」"],["彼","かれ"],["は"],["立ち寄って","たちよって"],["すわった"],["。"]]},{"verse":2,"text":"それから、ボアズは、町の長老十人を招いて、「ここにおすわりください」と言ったので、彼らもすわった。","tok":[["それ"],["から"],["、"],["ボアズ"],["は"],["、"],["町","まち"],["の"],["長老","ちょうろう"],["十人","じゅうにん"],["を"],["招いて","まねいて"],["、"],["「"],["ここ"],["に"],["おすわり"],["ください"],["」"],["と"],["言った","いった"],["ので"],["、"],["彼","かれ"],["ら"],["も"],["すわった"],["。"]]},{"verse":3,"text":"そこで、ボアズは、その買い戻しの権利のある親類の人に言った。「モアブの野から帰って来たナオミは、私たちの身内のエリメレクの畑を売ることにしています。4私はそれをあなたの耳に入れ、ここにすわっている人々と私の民の長老たちとの前で、それを買いなさいと、言おうと思ったのです。もし、あなたがそれを買い戻すつもりなら、それを買い戻してください。しかし、もしそれを買い戻さないのなら、私にそう言って知らせてください。あなたをさしおいて、それを買い戻す人はいないのです。私はあなたの次なのですから。」すると彼は言った。「私が買い戻しましょう。」","tok":[["そこ"],["で"],["、"],["ボアズ"],["は"],["、"],["その"],["買い戻し","かいもどし"],["の"],["権利","けんり"],["の"],["ある"],["親類","しんるい"],["の"],["人","ひと"],["に"],["言った","いった"],["。"],["「"],["モアブ"],["の"],["野","の"],["から"],["帰って","かえって"],["来た","きた"],["ナオミ"],["は"],["、"],["私たち","わたしたち"],["の"],["身内","みうち"],["の"],["エリメレク"],["の"],["畑","はたけ"],["を"],["売る","うる"],["こと"],["に"],["して"],["います"],["。"],["4"],["私","わたくし"],["は"],["それ"],["を"],["あなた"],["の"],["耳","みみ"],["に"],["入れ","いれ"],["、"],["ここ"],["に"],["すわって"],["いる"],["人々","ひとびと"],["と"],["私","わたくし"],["の"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["と"],["の"],["前","まえ"],["で"],["、"],["それ"],["を"],["買い","かい"],["なさい"],["と"],["、"],["言おう","いおう"],["と"],["思った","おもった"],["の"],["です"],["。"],["もし"],["、"],["あなた"],["が"],["それ"],["を"],["買い戻す","かいもどす"],["つもり"],["なら"],["、"],["それ"],["を"],["買い戻して","かいもどして"],["ください"],["。"],["しかし"],["、"],["もし"],["それ"],["を"],["買い戻さない","かいもどさない"],["の"],["なら"],["、"],["私","わたくし"],["に"],["そう"],["言って","いって"],["知らせて","しらせて"],["ください"],["。"],["あなた"],["を"],["さしおいて"],["、"],["それ"],["を"],["買い戻す","かいもどす"],["人","ひと"],["は"],["いない"],["の"],["です"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["次","つぎ"],["な"],["の"],["です"],["から"],["。"],["」"],["する"],["と"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["買い戻しましょう","かいもどしましょう"],["。"],["」"]]},{"verse":5,"text":"そこで、ボアズは言った。「あなたがナオミの手からその畑を買うときには、死んだ者の名をその相続地に起こすために、死んだ者の妻であったモアブの女ルツをも買わなければなりません。」","tok":[["そこ"],["で"],["、"],["ボアズ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["が"],["ナオミ"],["の"],["手","て"],["から"],["その"],["畑","はたけ"],["を"],["買う","かう"],["とき"],["に"],["は"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["名","な"],["を"],["その"],["相続","そうぞく"],["地","ち"],["に"],["起こす","おこす"],["ため"],["に"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["妻","つま"],["で"],["あった"],["モアブ"],["の"],["女","おんな"],["ルツ"],["を"],["も"],["買わなければ","かわなければ"],["なりません"],["。"],["」"]]},{"verse":6,"text":"その買い戻しの権利のある親類の人は言った。「私には自分のために、その土地を買い戻すことはできません。私自身の相続地をそこなうことになるといけませんから。あなたが私に代わって買い戻してください。私は買い戻すことができませんから。」","tok":[["その"],["買い戻し","かいもどし"],["の"],["権利","けんり"],["の"],["ある"],["親類","しんるい"],["の"],["人","ひと"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["その"],["土地","とち"],["を"],["買い戻す","かいもどす"],["こと"],["は"],["できません"],["。"],["私自身","わたしじしん"],["の"],["相続","そうぞく"],["地","ち"],["を"],["そこなう"],["こと"],["に"],["なる"],["と"],["いけません"],["から"],["。"],["あなた"],["が"],["私","わたくし"],["に"],["代わって","かわって"],["買い戻して","かいもどして"],["ください"],["。"],["私","わたくし"],["は"],["買い戻す","かいもどす"],["こと"],["が"],["できません"],["から"],["。"],["」"]]},{"verse":7,"text":"昔、イスラエルでは、買い戻しや権利の譲渡をする場合、すべての取り引きを有効にするために、一方が自分のはきものを脱いで、それを相手に渡す習慣があった。これがイスラエルにおける証明の方法であった。","tok":[["昔","むかし"],["、"],["イスラエル"],["で"],["は"],["、"],["買い戻し","かいもどし"],["や"],["権利","けんり"],["の"],["譲渡","じょうと"],["を"],["する"],["場合","ばあい"],["、"],["すべて"],["の"],["取り引き","とりひき"],["を"],["有効","ゆうこう"],["に"],["する"],["ため"],["に"],["、"],["一方","いっぽう"],["が"],["自分","じぶん"],["の"],["はきもの"],["を"],["脱いで","ぬいで"],["、"],["それ"],["を"],["相手","あいて"],["に"],["渡す","わたす"],["習慣","しゅうかん"],["が"],["あった"],["。"],["これ"],["が"],["イスラエル"],["に"],["おける"],["証明","しょうめい"],["の"],["方法","ほうほう"],["で"],["あった"],["。"]]},{"verse":8,"text":"それで、この買い戻しの権利のある親類の人はボアズに、「あなたがお買いなさい」と言って、自分のはきものを脱いだ。","tok":[["それ"],["で"],["、"],["この"],["買い戻し","かいもどし"],["の"],["権利","けんり"],["の"],["ある"],["親類","しんるい"],["の"],["人","ひと"],["は"],["ボアズ"],["に"],["、"],["「"],["あなた"],["が"],["お買い","おかい"],["なさい"],["」"],["と"],["言って","いって"],["、"],["自分","じぶん"],["の"],["はきもの"],["を"],["脱いだ","ぬいだ"],["。"]]},{"verse":9,"text":"そこでボアズは、長老たちとすべての民に言った。「あなたがたは、きょう、私がナオミの手から、エリメレクのすべてのもの、それからキルヨンとマフロンのすべてのものを買い取ったことの証人です。","tok":[["そこ"],["で"],["ボアズ"],["は"],["、"],["長老","ちょうろう"],["たち"],["と"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["私","わたくし"],["が"],["ナオミ"],["の"],["手","て"],["から"],["、"],["エリメレク"],["の"],["すべて"],["の"],["もの"],["、"],["それ"],["から"],["キルヨン"],["と"],["マフロン"],["の"],["すべて"],["の"],["もの"],["を"],["買い取った","かいとった"],["こと"],["の"],["証人","しょうにん"],["です"],["。"]]},{"verse":10,"text":"さらに、死んだ者の名をその相続地に起こすために、私はマフロンの妻であったモアブの女ルツを買って、私の妻としました。死んだ者の名を、その身内の者たちの間から、また、その町の門から絶えさせないためです。きょう、あなたがたはその証人です。」","tok":[["さらに"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["名","な"],["を"],["その"],["相続","そうぞく"],["地","ち"],["に"],["起こす","おこす"],["ため"],["に"],["、"],["私","わたくし"],["は"],["マフロン"],["の"],["妻","つま"],["で"],["あった"],["モアブ"],["の"],["女","おんな"],["ルツ"],["を"],["買って","かって"],["、"],["私","わたくし"],["の"],["妻","つま"],["と"],["しました"],["。"],["死んだ","しんだ"],["者","もの"],["の"],["名","な"],["を"],["、"],["その"],["身内","みうち"],["の"],["者","もの"],["たち"],["の"],["間","あいだ"],["から"],["、"],["また"],["、"],["その"],["町","まち"],["の"],["門","もん"],["から"],["絶えさせない","たえさせない"],["ため"],["です"],["。"],["きょう"],["、"],["あなた"],["がた"],["は"],["その"],["証人","しょうにん"],["です"],["。"],["」"]]},{"verse":11,"text":"すると、門にいた人々と長老たちはみな、言った。「私たちは証人です。どうか、主が、あなたの家に入る女を、イスラエルの家を建てたラケルとレアのふたりのようにされますように。あなたはエフラテで力ある働きをし、ベツレヘムで名をあげなさい。","tok":[["する"],["と"],["、"],["門","もん"],["に"],["いた"],["人々","ひとびと"],["と"],["長老","ちょうろう"],["たち"],["は"],["みな"],["、"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["証人","しょうにん"],["です"],["。"],["どう"],["か"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["の"],["家","いえ"],["に"],["入る","はいる"],["女","おんな"],["を"],["、"],["イスラエル"],["の"],["家","いえ"],["を"],["建てた","たてた"],["ラケル"],["と"],["レア"],["の"],["ふたり"],["の"],["よう"],["に"],["されます"],["よう"],["に"],["。"],["あなた"],["は"],["エフラテ"],["で"],["力","ちから"],["ある"],["働き","はたらき"],["を"],["し"],["、"],["ベツレヘム"],["で"],["名","な"],["を"],["あげ"],["なさい"],["。"]]},{"verse":12,"text":"また、主がこの若い女を通してあなたに授ける子孫によって、あなたの家が、タマルがユダに産んだペレツの家のようになりますように。」","tok":[["また"],["、"],["主","ぬし"],["が"],["この"],["若い","わかい"],["女","おんな"],["を"],["通して","とおして"],["あなた"],["に"],["授ける","さずける"],["子孫","しそん"],["によって"],["、"],["あなた"],["の"],["家","いえ"],["が"],["、"],["タマル"],["が"],["ユダ"],["に"],["産んだ","うんだ"],["ペレツ"],["の"],["家","いえ"],["の"],["よう"],["に"],["なります"],["よう"],["に"],["。"],["」"]]},{"verse":13,"text":"こうしてボアズはルツをめとり、彼女は彼の妻となった。彼が彼女のところに入ったとき、主は彼女をみごもらせたので、彼女はひとりの男の子を産んだ。","tok":[["こう"],["して"],["ボアズ"],["は"],["ルツ"],["を"],["めとり"],["、"],["彼女","かのじょ"],["は"],["彼","かれ"],["の"],["妻","つま"],["と"],["なった"],["。"],["彼","かれ"],["が"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入った","はいった"],["とき"],["、"],["主","ぬし"],["は"],["彼女","かのじょ"],["を"],["みごもらせた"],["ので"],["、"],["彼女","かのじょ"],["は"],["ひとり"],["の"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":14,"text":"女たちはナオミに言った。「イスラエルで、その名が伝えられるよう、きょう、買い戻す者をあなたに与えて、あなたの跡を絶やさなかった主が、ほめたたえられますように。","tok":[["女","おんな"],["たち"],["は"],["ナオミ"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["で"],["、"],["その"],["名","な"],["が"],["伝えられる","つたえられる"],["よう"],["、"],["きょう"],["、"],["買い戻す","かいもどす"],["者","もの"],["を"],["あなた"],["に"],["与えて","あたえて"],["、"],["あなた"],["の"],["跡","あと"],["を"],["絶やさなかった","たやさなかった"],["主","ぬし"],["が"],["、"],["ほめたたえられます"],["よう"],["に"],["。"]]},{"verse":15,"text":"その子は、あなたを元気づけ、あなたの老後をみとるでしょう。あなたを愛し、七人の息子にもまさるあなたの嫁が、その子を産んだのですから。」","tok":[["その"],["子","こ"],["は"],["、"],["あなた"],["を"],["元気","げんき"],["づけ"],["、"],["あなた"],["の"],["老後","ろうご"],["を"],["みとるでしょう"],["。"],["あなた"],["を"],["愛し","あいし"],["、"],["七人","しちにん"],["の"],["息子","むすこ"],["に"],["も"],["まさる"],["あなた"],["の"],["嫁","よめ"],["が"],["、"],["その"],["子","こ"],["を"],["産んだ","うんだ"],["の"],["です"],["から"],["。"],["」"]]},{"verse":16,"text":"ナオミはその子をとり、胸に抱いて、養い育てた。","tok":[["ナオミ"],["は"],["その"],["子","こ"],["を"],["とり"],["、"],["胸","むね"],["に"],["抱いて","いだいて"],["、"],["養い育てた","やしないそだてた"],["。"]]},{"verse":17,"text":"近所の女たちは、「ナオミに男の子が生まれた」と言って、その子に名をつけた。彼女たちは、その名をオベデと呼んだ。オベデはダビデの父エッサイの父である。","tok":[["近所","きんじょ"],["の"],["女","おんな"],["たち"],["は"],["、"],["「"],["ナオミ"],["に"],["男の子","おとこのこ"],["が"],["生まれた","うまれた"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["に"],["名","な"],["を"],["つけた"],["。"],["彼女","かのじょ"],["たち"],["は"],["、"],["その"],["名","な"],["を"],["オベデ"],["と"],["呼んだ","よんだ"],["。"],["オベデ"],["は"],["ダビデ"],["の"],["父","ちち"],["エッサイ"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":18,"text":"ペレツの家系は次のとおりである。ペレツの子はヘツロン、","tok":[["ペレツ"],["の"],["家系","かけい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ペレツ"],["の"],["子","こ"],["は"],["ヘツロン"],["、"]]},{"verse":19,"text":"ヘツロンの子はラム、ラムの子はアミナダブ、","tok":[["ヘツロン"],["の"],["子","こ"],["は"],["ラム"],["、"],["ラム"],["の"],["子","こ"],["は"],["アミナダブ"],["、"]]},{"verse":20,"text":"アミナダブの子はナフション、ナフションの子はサルモン、","tok":[["アミナダブ"],["の"],["子","こ"],["は"],["ナフション"],["、"],["ナフション"],["の"],["子","こ"],["は"],["サルモン"],["、"]]},{"verse":21,"text":"サルモンの子はボアズ、ボアズの子はオベデ、","tok":[["サルモン"],["の"],["子","こ"],["は"],["ボアズ"],["、"],["ボアズ"],["の"],["子","こ"],["は"],["オベデ"],["、"]]},{"verse":22,"text":"オベデの子はエッサイ、エッサイの子はダビデである。","tok":[["オベデ"],["の"],["子","こ"],["は"],["エッサイ"],["、"],["エッサイ"],["の"],["子","こ"],["は"],["ダビデ"],["で"],["ある"],["。"]]}]
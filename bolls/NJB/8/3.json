[{"verse":1,"text":"しゅうとめナオミは彼女に言った。「娘よ。あなたがしあわせになるために、身の落ち着く所を私が捜してあげなければならないのではないでしょうか。","tok":[["しゅうとめ"],["ナオミ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["娘","むすめ"],["よ"],["。"],["あなた"],["が"],["しあわせ"],["に"],["なる"],["ため"],["に"],["、"],["身","み"],["の"],["落ち着く","おちつく"],["所","ところ"],["を"],["私","わたくし"],["が"],["捜して","さがして"],["あげなければ"],["ならない"],["ので"],["は"],["ないでしょう"],["か"],["。"]]},{"verse":2,"text":"ところで、あなたが若い女たちといっしょにいた所のあのボアズは、私たちの親戚ではありませんか。ちょうど今夜、あの方は打ち場で大麦をふるい分けようとしています。","tok":[["ところ"],["で"],["、"],["あなた"],["が"],["若い","わかい"],["女","おんな"],["たち"],["と"],["いっしょ"],["に"],["いた"],["所","ところ"],["の"],["あの"],["ボアズ"],["は"],["、"],["私たち","わたしたち"],["の"],["親戚","しんせき"],["で"],["は"],["ありません"],["か"],["。"],["ちょうど"],["今夜","こんや"],["、"],["あの"],["方","かた"],["は"],["打ち","うち"],["場","ば"],["で"],["大麦","おおむぎ"],["を"],["ふるい分けよう","ふるいわけよう"],["として"],["います"],["。"]]},{"verse":3,"text":"あなたはからだを洗って、油を塗り、晴れ着をまとい、打ち場に下って行きなさい。しかし、あの方の食事が終わるまで、気づかれないようにしなさい。","tok":[["あなた"],["は"],["からだ"],["を"],["洗って","あらって"],["、"],["油","あぶら"],["を"],["塗り","ぬり"],["、"],["晴れ着","はれぎ"],["を"],["まとい"],["、"],["打ち","うち"],["場","ば"],["に"],["下って","くだって"],["行き","いき"],["なさい"],["。"],["しかし"],["、"],["あの"],["方","かた"],["の"],["食事","しょくじ"],["が"],["終わる","おわる"],["まで"],["、"],["気づかれない","きづかれない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":4,"text":"あの方が寝るとき、その寝る所を見届けてから入って行き、その足のところをまくって、そこに寝なさい。あの方はあなたのすべきことを教えてくれましょう。」","tok":[["あの"],["方","ほう"],["が"],["寝る","ねる"],["とき"],["、"],["その"],["寝る","ねる"],["所","ところ"],["を"],["見届けて","みとどけて"],["から"],["入って","はいって"],["行き","いき"],["、"],["その"],["足","あし"],["の"],["ところ"],["を"],["まくって"],["、"],["そこ"],["に"],["寝","ね"],["なさい"],["。"],["あの"],["方","かた"],["は"],["あなた"],["の"],["すべき"],["こと"],["を"],["教えて","おしえて"],["くれましょう"],["。"],["」"]]},{"verse":5,"text":"ルツはしゅうとめに言った。「私におっしゃることはみないたします。」","tok":[["ルツ"],["は"],["しゅうとめ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["おっしゃる"],["こと"],["は"],["みな"],["いたします"],["。"],["」"]]},{"verse":6,"text":"こうして、彼女は打ち場に下って行って、しゅうとめが命じたすべてのことをした。","tok":[["こう"],["して"],["、"],["彼女","かのじょ"],["は"],["打ち","うち"],["場","ば"],["に"],["下って","くだって"],["行って","いって"],["、"],["しゅうとめ"],["が"],["命じた","めいじた"],["すべて"],["の"],["こと"],["を"],["した"],["。"]]},{"verse":7,"text":"ボアズは飲み食いして、気持ちがよくなると、積み重ねてある麦の端に行って寝た。それで、彼女はこっそり行って、ボアズの足のところをまくって、そこに寝た。","tok":[["ボアズ"],["は"],["飲み食い","のみくい"],["して"],["、"],["気持ち","きもち"],["が"],["よく"],["なる"],["と"],["、"],["積み重ねて","つみかさねて"],["ある"],["麦","むぎ"],["の"],["端","はし"],["に"],["行って","いって"],["寝た","ねた"],["。"],["それ"],["で"],["、"],["彼女","かのじょ"],["は"],["こっそり"],["行って","いって"],["、"],["ボアズ"],["の"],["足","あし"],["の"],["ところ"],["を"],["まくって"],["、"],["そこ"],["に"],["寝た","ねた"],["。"]]},{"verse":8,"text":"夜中になって、その人はびっくりして起き直った。なんと、ひとりの女が、自分の足のところに寝ているではないか。","tok":[["夜中","よなか"],["に"],["なって"],["、"],["その"],["人","ひと"],["は"],["びっくり"],["して"],["起き直った","おきなおった"],["。"],["なん"],["と"],["、"],["ひとり"],["の"],["女","おんな"],["が"],["、"],["自分","じぶん"],["の"],["足","あし"],["の"],["ところ"],["に"],["寝て","ねて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":9,"text":"彼は言った。「あなたはだれか。」彼女は答えた。「私はあなたのはしためルツです。あなたのおおいを広げて、このはしためをおおってください。あなたは買い戻しの権利のある親類ですから。」","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["だれ"],["か"],["。"],["」"],["彼女","かのじょ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["あなた"],["の"],["はし"],["ため"],["ルツ"],["です"],["。"],["あなた"],["の"],["おおい"],["を"],["広げて","ひろげて"],["、"],["この"],["はし"],["ため"],["を"],["おおって"],["ください"],["。"],["あなた"],["は"],["買い戻し","かいもどし"],["の"],["権利","けんり"],["の"],["ある"],["親類","しんるい"],["です"],["から"],["。"],["」"]]},{"verse":10,"text":"すると、ボアズは言った。「娘さん。主があなたを祝福されるように。あなたのあとからの真実は、先の真実にまさっています。あなたは貧しい者でも、富む者でも、若い男たちのあとを追わなかったからです。","tok":[["する"],["と"],["、"],["ボアズ"],["は"],["言った","いった"],["。"],["「"],["娘","むすめ"],["さん"],["。"],["主","ぬし"],["が"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["よう"],["に"],["。"],["あなた"],["の"],["あと"],["から"],["の"],["真実","しんじつ"],["は"],["、"],["先","さき"],["の"],["真実","しんじつ"],["に"],["まさって"],["います"],["。"],["あなた"],["は"],["貧しい","まずしい"],["者","もの"],["で"],["も"],["、"],["富む","とむ"],["者","もの"],["で"],["も"],["、"],["若い","わかい"],["男","おとこ"],["たち"],["の"],["あと"],["を"],["追わなかった","おわなかった"],["から"],["です"],["。"]]},{"verse":11,"text":"さあ、娘さん。恐れてはいけません。あなたの望むことはみな、してあげましょう。この町の人々はみな、あなたがしっかりした女であることを知っているからです。","tok":[["さあ"],["、"],["娘","むすめ"],["さん"],["。"],["恐れて","おそれて"],["は"],["いけません"],["。"],["あなた"],["の"],["望む","のぞむ"],["こと"],["は"],["みな"],["、"],["して"],["あげましょう"],["。"],["この"],["町","まち"],["の"],["人々","ひとびと"],["は"],["みな"],["、"],["あなた"],["が"],["しっかり"],["した"],["女","おんな"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":12,"text":"ところで、確かに私は買い戻しの権利のある親類です。しかし、私よりももっと近い買い戻しの権利のある親類がおります。","tok":[["ところ"],["で"],["、"],["確か","たしか"],["に"],["私","わたくし"],["は"],["買い戻し","かいもどし"],["の"],["権利","けんり"],["の"],["ある"],["親類","しんるい"],["です"],["。"],["しかし"],["、"],["私","わたくし"],["より"],["も"],["もっと"],["近い","ちかい"],["買い戻し","かいもどし"],["の"],["権利","けんり"],["の"],["ある"],["親類","しんるい"],["が"],["おります"],["。"]]},{"verse":13,"text":"今晩はここで過ごしなさい。朝になって、もしその人があなたに親類の役目を果たすなら、けっこうです。その人に親類の役目を果たさせなさい。しかし、もしその人があなたに親類の役目を果たすことを喜ばないなら、私があなたを買い戻します。主は生きておられる。とにかく、朝までおやすみなさい。」","tok":[["今晩は","こんばんは"],["ここ"],["で"],["過ごし","すごし"],["なさい"],["。"],["朝","あさ"],["に"],["なって"],["、"],["もし"],["その"],["人","ひと"],["が"],["あなた"],["に"],["親類","しんるい"],["の"],["役目","やくめ"],["を"],["果たすなら","はたすなら"],["、"],["けっこう"],["です"],["。"],["その"],["人","ひと"],["に"],["親類","しんるい"],["の"],["役目","やくめ"],["を"],["果たさせ","はたさせ"],["なさい"],["。"],["しかし"],["、"],["もし"],["その"],["人","ひと"],["が"],["あなた"],["に"],["親類","しんるい"],["の"],["役目","やくめ"],["を"],["果たす","はたす"],["こと"],["を"],["喜ばないなら","よろこばないなら"],["、"],["私","わたくし"],["が"],["あなた"],["を"],["買い戻します","かいもどします"],["。"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["とにかく"],["、"],["朝","あさ"],["まで"],["おやすみなさい"],["。"],["」"]]},{"verse":14,"text":"こうして、彼女は朝まで彼の足のところに寝たが、だれかれの見分けがつかないうちに起き上がった。彼は、「打ち場にこの女の来たことが知られてはならない」と思ったので、","tok":[["こう"],["して"],["、"],["彼女","かのじょ"],["は"],["朝","あさ"],["まで"],["彼","かれ"],["の"],["足","あし"],["の"],["ところ"],["に"],["寝た","ねた"],["が"],["、"],["だれかれ"],["の"],["見分け","みわけ"],["が"],["つかない"],["うち"],["に"],["起き上がった","おきあがった"],["。"],["彼","かれ"],["は"],["、"],["「"],["打ち","うち"],["場","ば"],["に"],["この"],["女","おんな"],["の"],["来た","きた"],["こと"],["が"],["知られて","しられて"],["は"],["ならない"],["」"],["と"],["思った","おもった"],["ので"],["、"]]},{"verse":15,"text":"「あなたの着ている外套を持って来て、それをしっかりつかんでいなさい」と言い、彼女がそれをしっかりつかむうちに、大麦六杯を量って、それを彼女に負わせた。こうして彼は町へ行った。","tok":[["「"],["あなた"],["の"],["着て","きて"],["いる"],["外套","がいとう"],["を"],["持って","もって"],["来て","きて"],["、"],["それ"],["を"],["しっかり"],["つかんで"],["い"],["なさい"],["」"],["と"],["言い","いい"],["、"],["彼女","かのじょ"],["が"],["それ"],["を"],["しっかり"],["つかむ"],["うち"],["に"],["、"],["大麦","おおむぎ"],["六","ろく"],["杯","ばい"],["を"],["量って","はかって"],["、"],["それ"],["を"],["彼女","かのじょ"],["に"],["負わせた","おわせた"],["。"],["こう"],["して"],["彼","かれ"],["は"],["町","まち"],["へ"],["行った","いった"],["。"]]},{"verse":16,"text":"彼女がしゅうとめのところに行くと、しゅうとめは尋ねた。「娘よ。どうでしたか。」ルツは、その人が自分にしたことをみな、しゅうとめに告げて、","tok":[["彼女","かのじょ"],["が"],["しゅうとめ"],["の"],["ところ"],["に"],["行く","いく"],["と"],["、"],["しゅうとめ"],["は"],["尋ねた","たずねた"],["。"],["「"],["娘","むすめ"],["よ"],["。"],["どう"],["でした"],["か"],["。"],["」"],["ルツ"],["は"],["、"],["その"],["人","ひと"],["が"],["自分","じぶん"],["に"],["した"],["こと"],["を"],["みな"],["、"],["しゅうとめ"],["に"],["告げて","つげて"],["、"]]},{"verse":17,"text":"言った。「あなたのしゅうとめのところに素手で帰ってはならないと言って、あの方は、この大麦六杯を私に下さいました。」","tok":[["言った","いった"],["。"],["「"],["あなた"],["の"],["しゅうとめ"],["の"],["ところ"],["に"],["素手","すで"],["で"],["帰って","かえって"],["は"],["ならない"],["と"],["言って","いって"],["、"],["あの"],["方","かた"],["は"],["、"],["この"],["大麦","おおむぎ"],["六","ろく"],["杯","ばい"],["を"],["私","わたくし"],["に"],["下さいました","くださいました"],["。"],["」"]]},{"verse":18,"text":"しゅうとめは言った。「娘よ。このことがどうおさまるかわかるまで待っていなさい。あの方は、きょう、そのことを決めてしまわなければ、落ち着かないでしょうから。」","tok":[["しゅうとめ"],["は"],["言った","いった"],["。"],["「"],["娘","むすめ"],["よ"],["。"],["この"],["こと"],["が"],["どう"],["おさまる"],["か"],["わかる"],["まで"],["待って","まって"],["い"],["なさい"],["。"],["あの"],["方","かた"],["は"],["、"],["きょう"],["、"],["その"],["こと"],["を"],["決めて","きめて"],["しまわなければ"],["、"],["落ち着かないでしょう","おちつかないでしょう"],["から"],["。"],["」"]]}]
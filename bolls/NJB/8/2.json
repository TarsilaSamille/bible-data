[{"verse":1,"text":"ナオミには、夫の親戚で、エリメレクの一族に属するひとりの有力者がいた。その人の名はボアズであった。","tok":[["ナオミ"],["に"],["は"],["、"],["夫","おっと"],["の"],["親戚","しんせき"],["で"],["、"],["エリメレク"],["の"],["一族","いちぞく"],["に"],["属する","ぞくする"],["ひとり"],["の"],["有力","ゆうりょく"],["者","しゃ"],["が"],["いた"],["。"],["その"],["人","ひと"],["の"],["名","な"],["は"],["ボアズ"],["で"],["あった"],["。"]]},{"verse":2,"text":"モアブの女ルツはナオミに言った。「どうぞ、畑に行かせてください。私に親切にしてくださる方のあとについて落ち穂を拾い集めたいのです。」すると、ナオミは彼女に、「娘よ。行っておいで」と言った。","tok":[["モアブ"],["の"],["女","おんな"],["ルツ"],["は"],["ナオミ"],["に"],["言った","いった"],["。"],["「"],["どうぞ"],["、"],["畑","はたけ"],["に"],["行かせて","いかせて"],["ください"],["。"],["私","わたくし"],["に"],["親切","しんせつ"],["に"],["して"],["くださる"],["方","かた"],["の"],["あと"],["について"],["落ち穂","おちぼ"],["を"],["拾い集めたい","ひろいあつめたい"],["の"],["です"],["。"],["」"],["する"],["と"],["、"],["ナオミ"],["は"],["彼女","かのじょ"],["に"],["、"],["「"],["娘","むすめ"],["よ"],["。"],["行って","いって"],["おいで"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"ルツは出かけて行って、刈る人たちのあとについて、畑で落ち穂を拾い集めたが、それは、はからずもエリメレクの一族に属するボアズの畑のうちであった。","tok":[["ルツ"],["は"],["出かけて","でかけて"],["行って","いって"],["、"],["刈る","かる"],["人","ひと"],["たち"],["の"],["あと"],["について"],["、"],["畑","はたけ"],["で"],["落ち穂","おちぼ"],["を"],["拾い集めた","ひろいあつめた"],["が"],["、"],["それ"],["は"],["、"],["はからず"],["も"],["エリメレク"],["の"],["一族","いちぞく"],["に"],["属する","ぞくする"],["ボアズ"],["の"],["畑","はたけ"],["の"],["うち"],["で"],["あった"],["。"]]},{"verse":4,"text":"ちょうどその時、ボアズはベツレヘムからやって来て、刈る者たちに言った。「主があなたがたとともにおられますように。」彼らは、「主があなたを祝福されますように」と答えた。","tok":[["ちょうど"],["その"],["時","とき"],["、"],["ボアズ"],["は"],["ベツレヘム"],["から"],["やって"],["来て","きて"],["、"],["刈る","かる"],["者","もの"],["たち"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["あなた"],["がた"],["と"],["とも"],["に"],["おられます"],["よう"],["に"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["「"],["主","ぬし"],["が"],["あなた"],["を"],["祝福","しゅくふく"],["されます"],["よう"],["に"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":5,"text":"ボアズは刈る者たちの世話をしている若者に言った。「これはだれの娘か。」","tok":[["ボアズ"],["は"],["刈る","かる"],["者","もの"],["たち"],["の"],["世話","せわ"],["を"],["して"],["いる"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["これ"],["は"],["だれ"],["の"],["娘","むすめ"],["か"],["。"],["」"]]},{"verse":6,"text":"刈る者たちの世話をしている若者は答えて言った。「あれは、ナオミといっしょにモアブの野から帰って来たモアブの娘です。","tok":[["刈る","かる"],["者","もの"],["たち"],["の"],["世話","せわ"],["を"],["して"],["いる"],["若者","わかもの"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あれ"],["は"],["、"],["ナオミ"],["と"],["いっしょ"],["に"],["モアブ"],["の"],["野","の"],["から"],["帰って","かえって"],["来た","きた"],["モアブ"],["の"],["娘","むすめ"],["です"],["。"]]},{"verse":7,"text":"彼女は、『どうぞ、刈る人たちのあとについて、束の間で、落ち穂を拾い集めさせてください』と言い、ここに来て、朝から今まで家で休みもせず、ずっと立ち働いています。」","tok":[["彼女","かのじょ"],["は"],["、"],["『"],["どうぞ"],["、"],["刈る","かる"],["人","ひと"],["たち"],["の"],["あと"],["について"],["、"],["束の間","つかのま"],["で"],["、"],["落ち穂","おちぼ"],["を"],["拾い集めさせて","ひろいあつめさせて"],["ください"],["』"],["と"],["言い","いい"],["、"],["ここ"],["に"],["来て","きて"],["、"],["朝","あさ"],["から"],["今まで","いままで"],["家","いえ"],["で"],["休み","やすみ"],["も"],["せず"],["、"],["ずっと"],["立ち働いて","たちはたらいて"],["います"],["。"],["」"]]},{"verse":8,"text":"ボアズはルツに言った。「娘さん。よく聞きなさい。ほかの畑に落ち穂を拾いに行ったり、ここから出て行ったりしてはいけません。私のところの若い女たちのそばを離れないで、ここにいなさい。","tok":[["ボアズ"],["は"],["ルツ"],["に"],["言った","いった"],["。"],["「"],["娘","むすめ"],["さん"],["。"],["よく"],["聞き","きき"],["なさい"],["。"],["ほか"],["の"],["畑","はたけ"],["に"],["落ち穂","おちぼ"],["を"],["拾い","ひろい"],["に"],["行っ","いっ"],["たり"],["、"],["ここ"],["から"],["出て","でて"],["行っ","いっ"],["たり"],["して"],["は"],["いけません"],["。"],["私","わたくし"],["の"],["ところ"],["の"],["若い","わかい"],["女","おんな"],["たち"],["の"],["そば"],["を"],["離れないで","はなれないで"],["、"],["ここ"],["に"],["い"],["なさい"],["。"]]},{"verse":9,"text":"刈り取っている畑を見つけて、あとについて行きなさい。私は若者たちに、あなたのじゃまをしてはならないと、きつく命じておきました。のどが渇いたら、水がめのところへ行って、若者たちの汲んだのを飲みなさい。」","tok":[["刈り取って","かりとって"],["いる"],["畑","はたけ"],["を"],["見つけて","みつけて"],["、"],["あと"],["について"],["行き","いき"],["なさい"],["。"],["私","わたくし"],["は"],["若者","わかもの"],["たち"],["に"],["、"],["あなた"],["の"],["じゃま"],["を"],["して"],["は"],["ならない"],["と"],["、"],["きつく"],["命じて","めいじて"],["おきました"],["。"],["のど"],["が"],["渇いたら","かわいたら"],["、"],["水がめ","みずがめ"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["若者","わかもの"],["たち"],["の"],["汲んだ","くんだ"],["の"],["を"],["飲み","のみ"],["なさい"],["。"],["」"]]},{"verse":10,"text":"彼女は顔を伏せ、地面にひれ伏して彼に言った。「私が外国人であるのを知りながら、どうして親切にしてくださるのですか。」","tok":[["彼女","かのじょ"],["は"],["顔","かお"],["を"],["伏せ","ふせ"],["、"],["地面","じめん"],["に"],["ひれ伏して","ひれふして"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["外国人","がいこくじん"],["で"],["ある"],["の"],["を"],["知り","しり"],["ながら"],["、"],["どう"],["して"],["親切","しんせつ"],["に"],["して"],["くださる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":11,"text":"ボアズは答えて言った。「あなたの夫がなくなってから、あなたがしゅうとめにしたこと、それにあなたの父母や生まれた国を離れて、これまで知らなかった民のところに来たことについて、私はすっかり話を聞いています。","tok":[["ボアズ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あなた"],["の"],["夫","おっと"],["が"],["なくなって"],["から"],["、"],["あなた"],["が"],["しゅうとめ"],["に"],["した"],["こと"],["、"],["それ"],["に"],["あなた"],["の"],["父母","ふぼ"],["や"],["生まれた","うまれた"],["国","くに"],["を"],["離れて","はなれて"],["、"],["これ"],["まで"],["知らなかった","しらなかった"],["民","たみ"],["の"],["ところ"],["に"],["来た","きた"],["こと"],["について"],["、"],["私","わたくし"],["は"],["すっかり"],["話","はなし"],["を"],["聞いて","きいて"],["います"],["。"]]},{"verse":12,"text":"主があなたのしたことに報いてくださるように。また、あなたがその翼の下に避け所を求めて来たイスラエルの神、主から、豊かな報いがあるように。」","tok":[["主","ぬし"],["が"],["あなた"],["の"],["した"],["こと"],["に"],["報いて","むくいて"],["くださる"],["よう"],["に"],["。"],["また"],["、"],["あなた"],["が"],["その"],["翼","つばさ"],["の"],["下","した"],["に"],["避け","さけ"],["所","しょ"],["を"],["求めて","もとめて"],["来た","きた"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["から"],["、"],["豊か","ゆたか"],["な"],["報い","むくい"],["が"],["ある"],["よう"],["に"],["。"],["」"]]},{"verse":13,"text":"彼女は言った。「ご主人さま。私はあなたのご好意にあずかりとう存じます。私はあなたのはしためのひとりでもありませんのに、あなたは私を慰め、このはしためにねんごろに話しかけてくださったからです。」","tok":[["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["ご主人","ごしゅじん"],["さま"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["ご好意","ごこうい"],["に"],["あずかり"],["とう"],["存じます","ぞんじます"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["はし"],["ため"],["の"],["ひとり"],["で"],["も"],["ありません"],["のに"],["、"],["あなた"],["は"],["私","わたくし"],["を"],["慰め","なぐさめ"],["、"],["この"],["はし"],["ため"],["に"],["ねんごろ"],["に"],["話しかけて","はなしかけて"],["くださった"],["から"],["です"],["。"],["」"]]},{"verse":14,"text":"食事のとき、ボアズは彼女に言った。「ここに来て、このパンを食べ、あなたのパン切れを酢に浸しなさい。」彼女が刈る者たちのそばにすわったので、彼は炒り麦を彼女に取ってやった。彼女はそれを食べ、十分食べて、余りを残しておいた。","tok":[["食事","しょくじ"],["の"],["とき"],["、"],["ボアズ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["ここ"],["に"],["来て","きて"],["、"],["この"],["パン"],["を"],["食べ","たべ"],["、"],["あなた"],["の"],["パン"],["切れ","きれ"],["を"],["酢","す"],["に"],["浸し","ひたし"],["なさい"],["。"],["」"],["彼女","かのじょ"],["が"],["刈る","かる"],["者","もの"],["たち"],["の"],["そば"],["に"],["すわった"],["ので"],["、"],["彼","かれ"],["は"],["炒り","いり"],["麦","むぎ"],["を"],["彼女","かのじょ"],["に"],["取って","とって"],["やった"],["。"],["彼女","かのじょ"],["は"],["それ"],["を"],["食べ","たべ"],["、"],["十分","じゅうぶん"],["食べて","たべて"],["、"],["余り","あまり"],["を"],["残して","のこして"],["おいた"],["。"]]},{"verse":15,"text":"彼女が落ち穂を拾い集めようとして立ち上がると、ボアズは若者たちに命じて言った。「あの女には束の間でも穂を拾い集めさせなさい。あの女に恥ずかしい思いをさせてはならない。","tok":[["彼女","かのじょ"],["が"],["落ち穂","おちぼ"],["を"],["拾い集めよう","ひろいあつめよう"],["として"],["立ち上がる","たちあがる"],["と"],["、"],["ボアズ"],["は"],["若者","わかもの"],["たち"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["あの"],["女","おんな"],["に"],["は"],["束の間","つかのま"],["で"],["も"],["穂","ほ"],["を"],["拾い集めさせ","ひろいあつめさせ"],["なさい"],["。"],["あの"],["女","おんな"],["に"],["恥ずかしい","はずかしい"],["思い","おもい"],["を"],["させて"],["は"],["ならない"],["。"]]},{"verse":16,"text":"それだけでなく、あの女のために、束からわざと穂を抜き落としておいて、拾い集めさせなさい。あの女をしかってはいけない。」","tok":[["それ"],["だけ"],["で"],["なく"],["、"],["あの"],["女","おんな"],["の"],["ため"],["に"],["、"],["束","たば"],["から"],["わざと"],["穂","ほ"],["を"],["抜き","ぬき"],["落として","おとして"],["おいて"],["、"],["拾い集めさせ","ひろいあつめさせ"],["なさい"],["。"],["あの"],["女","おんな"],["を"],["しかって"],["は"],["いけない"],["。"],["」"]]},{"verse":17,"text":"こうして彼女は、夕方まで畑で落ち穂を拾い集めた。拾ったのを打つと、大麦が一エパほどあった。","tok":[["こう"],["して"],["彼女","かのじょ"],["は"],["、"],["夕方","ゆうがた"],["まで"],["畑","はたけ"],["で"],["落ち穂","おちぼ"],["を"],["拾い集めた","ひろいあつめた"],["。"],["拾った","ひろった"],["の"],["を"],["打つ","うつ"],["と"],["、"],["大麦","おおむぎ"],["が"],["一","いち"],["エパ"],["ほど"],["あった"],["。"]]},{"verse":18,"text":"彼女はそれを持って町に行き、しゅうとめにその拾い集めたのを見せ、また、先に十分食べてから残しておいたのを取り出して、彼女に与えた。","tok":[["彼女","かのじょ"],["は"],["それ"],["を"],["持って","もって"],["町","まち"],["に"],["行き","いき"],["、"],["しゅうとめ"],["に"],["その"],["拾い集めた","ひろいあつめた"],["の"],["を"],["見せ","みせ"],["、"],["また"],["、"],["先","さき"],["に"],["十分","じゅうぶん"],["食べて","たべて"],["から"],["残して","のこして"],["おいた"],["の"],["を"],["取り出して","とりだして"],["、"],["彼女","かのじょ"],["に"],["与えた","あたえた"],["。"]]},{"verse":19,"text":"しゅうとめは彼女に言った。「きょう、どこで落ち穂を拾い集めたのですか。どこで働いたのですか。あなたに目を留めてくださった方に祝福がありますように。」彼女はしゅうとめに自分の働いてきた所のことを告げ、「きょう、私はボアズという名の人の所で働きました」と言った。","tok":[["しゅうとめ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["きょう"],["、"],["どこ"],["で"],["落ち穂","おちぼ"],["を"],["拾い集めた","ひろいあつめた"],["の"],["です"],["か"],["。"],["どこ"],["で"],["働いた","はたらいた"],["の"],["です"],["か"],["。"],["あなた"],["に"],["目","め"],["を"],["留めて","とめて"],["くださった"],["方","ほう"],["に"],["祝福","しゅくふく"],["が"],["あります"],["よう"],["に"],["。"],["」"],["彼女","かのじょ"],["は"],["しゅうとめ"],["に"],["自分","じぶん"],["の"],["働いて","はたらいて"],["きた"],["所","ところ"],["の"],["こと"],["を"],["告げ","つげ"],["、"],["「"],["きょう"],["、"],["私","わたくし"],["は"],["ボアズ"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["の"],["所","ところ"],["で"],["働きました","はたらきました"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"ナオミは嫁に言った。「生きている者にも、死んだ者にも、御恵みを惜しまれない主が、その方を祝福されますように。」それから、ナオミは彼女に言った。「その方は私たちの近親者で、しかも買い戻しの権利のある私たちの親類のひとりです。」","tok":[["ナオミ"],["は"],["嫁","よめ"],["に"],["言った","いった"],["。"],["「"],["生きて","いきて"],["いる"],["者","もの"],["に"],["も"],["、"],["死んだ","しんだ"],["者","もの"],["に"],["も"],["、"],["御恵み","おめぐみ"],["を"],["惜しまれない","おしまれない"],["主","ぬし"],["が"],["、"],["その"],["方","ほう"],["を"],["祝福","しゅくふく"],["されます"],["よう"],["に"],["。"],["」"],["それ"],["から"],["、"],["ナオミ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["その"],["方","かた"],["は"],["私たち","わたしたち"],["の"],["近親者","きんしんしゃ"],["で"],["、"],["しかも"],["買い戻し","かいもどし"],["の"],["権利","けんり"],["の"],["ある"],["私たち","わたしたち"],["の"],["親類","しんるい"],["の"],["ひとり"],["です"],["。"],["」"]]},{"verse":21,"text":"モアブの女ルツは言った。「その方はまた、『私のところの刈り入れが全部終わるまで、私の若者たちのそばを離れてはいけない』と私におっしゃいました。」","tok":[["モアブ"],["の"],["女","おんな"],["ルツ"],["は"],["言った","いった"],["。"],["「"],["その"],["方","かた"],["は"],["また"],["、"],["『"],["私","わたくし"],["の"],["ところ"],["の"],["刈り入れ","かりいれ"],["が"],["全部","ぜんぶ"],["終わる","おわる"],["まで"],["、"],["私","わたくし"],["の"],["若者","わかもの"],["たち"],["の"],["そば"],["を"],["離れて","はなれて"],["は"],["いけない"],["』"],["と"],["私","わたくし"],["に"],["おっしゃいました"],["。"],["」"]]},{"verse":22,"text":"ナオミは嫁のルツに言った。「娘よ。あの方のところの若い女たちといっしょに出かけるのは、けっこうなことです。ほかの畑でいじめられなくても済みます。」","tok":[["ナオミ"],["は"],["嫁","よめ"],["の"],["ルツ"],["に"],["言った","いった"],["。"],["「"],["娘","むすめ"],["よ"],["。"],["あの"],["方","かた"],["の"],["ところ"],["の"],["若い","わかい"],["女","おんな"],["たち"],["と"],["いっしょ"],["に"],["出かける","でかける"],["の"],["は"],["、"],["けっこう"],["な"],["こと"],["です"],["。"],["ほか"],["の"],["畑","はたけ"],["で"],["いじめられなくて"],["も"],["済みます","すみます"],["。"],["」"]]},{"verse":23,"text":"それで、彼女はボアズのところの若い女たちのそばを離れないで、大麦の刈り入れと小麦の刈り入れの終わるまで、落ち穂を拾い集めた。こうして、彼女はしゅうとめと暮らした。","tok":[["それ"],["で"],["、"],["彼女","かのじょ"],["は"],["ボアズ"],["の"],["ところ"],["の"],["若い","わかい"],["女","おんな"],["たち"],["の"],["そば"],["を"],["離れないで","はなれないで"],["、"],["大麦","おおむぎ"],["の"],["刈り入れ","かりいれ"],["と"],["小麦","こむぎ"],["の"],["刈り入れ","かりいれ"],["の"],["終わる","おわる"],["まで"],["、"],["落ち穂","おちぼ"],["を"],["拾い集めた","ひろいあつめた"],["。"],["こう"],["して"],["、"],["彼女","かのじょ"],["は"],["しゅうとめ"],["と"],["暮らした","くらした"],["。"]]}]
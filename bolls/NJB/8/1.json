[{"verse":1,"text":"さばきつかさが治めていたころ、この地にききんがあった。それで、ユダのベツレヘムの人が妻とふたりの息子を連れてモアブの野へ行き、そこに滞在することにした。","tok":[["さばき"],["つかさ"],["が"],["治めて","おさめて"],["いた"],["ころ"],["、"],["この"],["地","ち"],["に"],["ききん"],["が"],["あった"],["。"],["それ"],["で"],["、"],["ユダ"],["の"],["ベツレヘム"],["の"],["人","ひと"],["が"],["妻","つま"],["と"],["ふたり"],["の"],["息子","むすこ"],["を"],["連れて","つれて"],["モアブ"],["の"],["野","の"],["へ"],["行き","いき"],["、"],["そこ"],["に"],["滞在","たいざい"],["する"],["こと"],["に"],["した"],["。"]]},{"verse":2,"text":"その人の名はエリメレク。妻の名はナオミ。ふたりの息子の名はマフロンとキルヨン。彼らはユダのベツレヘムの出のエフラテ人であった。彼らがモアブの野へ行き、そこにとどまっているとき、","tok":[["その"],["人","ひと"],["の"],["名","な"],["は"],["エリメレク"],["。"],["妻","つま"],["の"],["名","な"],["は"],["ナオミ"],["。"],["ふたり"],["の"],["息子","むすこ"],["の"],["名","な"],["は"],["マフロン"],["と"],["キルヨン"],["。"],["彼","かれ"],["ら"],["は"],["ユダ"],["の"],["ベツレヘム"],["の"],["出","で"],["の"],["エフラテ"],["人","にん"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["が"],["モアブ"],["の"],["野","の"],["へ"],["行き","いき"],["、"],["そこ"],["に"],["とどまって"],["いる"],["とき"],["、"]]},{"verse":3,"text":"ナオミの夫エリメレクは死に、彼女とふたりの息子があとに残された。","tok":[["ナオミ"],["の"],["夫","おっと"],["エリメレク"],["は"],["死に","しに"],["、"],["彼女","かのじょ"],["と"],["ふたり"],["の"],["息子","むすこ"],["が"],["あと"],["に"],["残された","のこされた"],["。"]]},{"verse":4,"text":"ふたりの息子はモアブの女を妻に迎えた。ひとりの名はオルパで、もうひとりの名はルツであった。こうして、彼らは約十年の間、そこに住んでいた。","tok":[["ふたり"],["の"],["息子","むすこ"],["は"],["モアブ"],["の"],["女","おんな"],["を"],["妻","つま"],["に"],["迎えた","むかえた"],["。"],["ひとり"],["の"],["名","な"],["は"],["オルパ"],["で"],["、"],["もう"],["ひとり"],["の"],["名","な"],["は"],["ルツ"],["で"],["あった"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["約","やく"],["十","じゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["そこ"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":5,"text":"しかし、マフロンとキルヨンのふたりもまた死んだ。こうしてナオミはふたりの子どもと夫に先立たれてしまった。","tok":[["しかし"],["、"],["マフロン"],["と"],["キルヨン"],["の"],["ふたり"],["も"],["また"],["死んだ","しんだ"],["。"],["こう"],["して"],["ナオミ"],["は"],["ふたり"],["の"],["子ども","こども"],["と"],["夫","おっと"],["に"],["先立たれて","さきだたれて"],["しまった"],["。"]]},{"verse":6,"text":"そこで、彼女は嫁たちと連れ立って、モアブの野から帰ろうとした。モアブの野でナオミは、主がご自分の民を顧みて彼らにパンを下さったと聞いたからである。","tok":[["そこ"],["で"],["、"],["彼女","かのじょ"],["は"],["嫁","よめ"],["たち"],["と"],["連れ立って","つれだって"],["、"],["モアブ"],["の"],["野","の"],["から"],["帰ろう","かえろう"],["と"],["した"],["。"],["モアブ"],["の"],["野","の"],["で"],["ナオミ"],["は"],["、"],["主","ぬし"],["が"],["ご自分","ごじぶん"],["の"],["民","たみ"],["を"],["顧みて","かえりみて"],["彼","かれ"],["ら"],["に"],["パン"],["を"],["下さった","くださった"],["と"],["聞いた","きいた"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"そこで、彼女はふたりの嫁といっしょに、今まで住んでいた所を出て、ユダの地へ戻るため帰途についた。","tok":[["そこ"],["で"],["、"],["彼女","かのじょ"],["は"],["ふたり"],["の"],["嫁","よめ"],["と"],["いっしょ"],["に"],["、"],["今まで","いままで"],["住んで","すんで"],["いた"],["所","ところ"],["を"],["出て","でて"],["、"],["ユダ"],["の"],["地","ち"],["へ"],["戻る","もどる"],["ため"],["帰途","きと"],["に"],["ついた"],["。"]]},{"verse":8,"text":"そのうちに、ナオミはふたりの嫁に、「あなたがたは、それぞれ自分の母の家へ帰りなさい。あなたがたが、なくなった者たちと私にしてくれたように、主があなたがたに恵みを賜り、","tok":[["その"],["うち"],["に"],["、"],["ナオミ"],["は"],["ふたり"],["の"],["嫁","よめ"],["に"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["それぞれ"],["自分","じぶん"],["の"],["母","はは"],["の"],["家","いえ"],["へ"],["帰り","かえり"],["なさい"],["。"],["あなた"],["が"],["た"],["が"],["、"],["なくなった"],["者","もの"],["たち"],["と"],["私","わたくし"],["に"],["して"],["くれた"],["よう"],["に"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["に"],["恵み","めぐみ"],["を"],["賜り","たまわり"],["、"]]},{"verse":9,"text":"あなたがたが、それぞれ夫の家で平和な暮らしができるように主がしてくださいますように」と言った。そしてふたりに口づけしたので、彼女たちは声をあげて泣いた。","tok":[["あなた"],["が"],["た"],["が"],["、"],["それぞれ"],["夫","おっと"],["の"],["家","いえ"],["で"],["平和","へいわ"],["な"],["暮らし","くらし"],["が"],["できる"],["よう"],["に"],["主","ぬし"],["が"],["して"],["くださいます"],["よう"],["に"],["」"],["と"],["言った","いった"],["。"],["そして"],["ふたり"],["に"],["口づけ","くちづけ"],["した"],["ので"],["、"],["彼女","かのじょ"],["たち"],["は"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":10,"text":"ふたりはナオミに言った。「いいえ。私たちは、あなたの民のところへあなたといっしょに帰ります。」","tok":[["ふたり"],["は"],["ナオミ"],["に"],["言った","いった"],["。"],["「"],["いいえ"],["。"],["私たち","わたしたち"],["は"],["、"],["あなた"],["の"],["民","たみ"],["の"],["ところ"],["へ"],["あなた"],["と"],["いっしょ"],["に"],["帰ります","かえります"],["。"],["」"]]},{"verse":11,"text":"しかしナオミは言った。「帰りなさい。娘たち。なぜ私といっしょに行こうとするのですか。あなたがたの夫になるような息子たちが、まだ、私のお腹にいるとでもいうのですか。","tok":[["しかし"],["ナオミ"],["は"],["言った","いった"],["。"],["「"],["帰り","かえり"],["なさい"],["。"],["娘","むすめ"],["たち"],["。"],["なぜ"],["私","わたくし"],["と"],["いっしょ"],["に"],["行こう","いこう"],["と"],["する"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["の"],["夫","おっと"],["に"],["なる"],["よう"],["な"],["息子","むすこ"],["たち"],["が"],["、"],["まだ"],["、"],["私","わたくし"],["の"],["お腹","おなか"],["に"],["いる"],["と"],["で"],["も"],["いう"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"帰りなさい。娘たち。さあ、行きなさい。私は年をとって、もう夫は持てません。たとい私が、自分には望みがあると思って、今晩でも夫を持ち、息子たちを産んだとしても、","tok":[["帰り","かえり"],["なさい"],["。"],["娘","むすめ"],["たち"],["。"],["さあ"],["、"],["行き","いき"],["なさい"],["。"],["私","わたくし"],["は"],["年","とし"],["を"],["とって"],["、"],["もう"],["夫","おっと"],["は"],["持てません","もてません"],["。"],["たとい"],["私","わたくし"],["が"],["、"],["自分","じぶん"],["に"],["は"],["望み","のぞみ"],["が"],["ある"],["と"],["思って","おもって"],["、"],["今晩","こんばん"],["で"],["も"],["夫","おっと"],["を"],["持ち","もち"],["、"],["息子","むすこ"],["たち"],["を"],["産んだ","うんだ"],["として"],["も"],["、"]]},{"verse":13,"text":"それだから、あなたがたは息子たちの成人するまで待とうというのですか。だから、あなたがたは夫を持たないままでいるというのですか。娘たち。それはいけません。私をひどく苦しませるだけです。主の御手が私に下ったのですから。」","tok":[["それ"],["だ"],["から"],["、"],["あなた"],["がた"],["は"],["息子","むすこ"],["たち"],["の"],["成人","せいじん"],["する"],["まで"],["待とう","まとう"],["と"],["いう"],["の"],["です"],["か"],["。"],["だ"],["から"],["、"],["あなた"],["がた"],["は"],["夫","おっと"],["を"],["持たない","もたない"],["まま"],["で"],["いる"],["と"],["いう"],["の"],["です"],["か"],["。"],["娘","むすめ"],["たち"],["。"],["それ"],["は"],["いけません"],["。"],["私","わたくし"],["を"],["ひどく"],["苦しませる","くるしませる"],["だけ"],["です"],["。"],["主","ぬし"],["の"],["御手","おて"],["が"],["私","わたくし"],["に"],["下った","くだった"],["の"],["です"],["から"],["。"],["」"]]},{"verse":14,"text":"彼女たちはまた声をあげて泣き、オルパはしゅうとめに別れの口づけをしたが、ルツは彼女にすがりついていた。","tok":[["彼女","かのじょ"],["たち"],["は"],["また"],["声","こえ"],["を"],["あげて"],["泣き","なき"],["、"],["オルパ"],["は"],["しゅうとめ"],["に"],["別れ","わかれ"],["の"],["口づけ","くちづけ"],["を"],["した"],["が"],["、"],["ルツ"],["は"],["彼女","かのじょ"],["に"],["すがりついて"],["いた"],["。"]]},{"verse":15,"text":"ナオミは言った。「ご覧なさい。あなたの弟嫁は、自分の民とその神のところへ帰って行きました。あなたも弟嫁にならって帰りなさい。」","tok":[["ナオミ"],["は"],["言った","いった"],["。"],["「"],["ご覧","ごらん"],["なさい"],["。"],["あなた"],["の"],["弟嫁","おとうとよめ"],["は"],["、"],["自分","じぶん"],["の"],["民","たみ"],["と"],["その"],["神","かみ"],["の"],["ところ"],["へ"],["帰って","かえって"],["行きました","いきました"],["。"],["あなた"],["も"],["弟嫁","おとうとよめ"],["に"],["ならって"],["帰り","かえり"],["なさい"],["。"],["」"]]},{"verse":16,"text":"ルツは言った。「あなたを捨て、あなたから別れて帰るように、私にしむけないでください。あなたの行かれる所へ私も行き、あなたの住まれる所に私も住みます。あなたの民は私の民、あなたの神は私の神です。","tok":[["ルツ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["を"],["捨て","すて"],["、"],["あなた"],["から"],["別れて","わかれて"],["帰る","かえる"],["よう"],["に"],["、"],["私","わたくし"],["に"],["しむけないで"],["ください"],["。"],["あなた"],["の"],["行かれる","いかれる"],["所","ところ"],["へ"],["私","わたくし"],["も"],["行き","いき"],["、"],["あなた"],["の"],["住まれる","すまれる"],["所","ところ"],["に"],["私","わたくし"],["も"],["住みます","すみます"],["。"],["あなた"],["の"],["民","たみ"],["は"],["私","わたくし"],["の"],["民","たみ"],["、"],["あなた"],["の"],["神","かみ"],["は"],["私","わたくし"],["の"],["神","かみ"],["です"],["。"]]},{"verse":17,"text":"あなたの死なれる所で私は死に、そこに葬られたいのです。もし死によっても私があなたから離れるようなことがあったら、主が幾重にも私を罰してくださるように。」","tok":[["あなた"],["の"],["死なれる","しなれる"],["所","ところ"],["で"],["私","わたくし"],["は"],["死に","しに"],["、"],["そこ"],["に"],["葬られたい","ほうむられたい"],["の"],["です"],["。"],["もし"],["死","し"],["によって"],["も"],["私","わたくし"],["が"],["あなた"],["から"],["離れる","はなれる"],["よう"],["な"],["こと"],["が"],["あったら"],["、"],["主","ぬし"],["が"],["幾重","いくえ"],["に"],["も"],["私","わたくし"],["を"],["罰して","ばっして"],["くださる"],["よう"],["に"],["。"],["」"]]},{"verse":18,"text":"ナオミは、ルツが自分といっしょに行こうと堅く決心しているのを見ると、もうそれ以上は何も言わなかった。","tok":[["ナオミ"],["は"],["、"],["ルツ"],["が"],["自分","じぶん"],["と"],["いっしょ"],["に"],["行こう","いこう"],["と"],["堅く","かたく"],["決心","けっしん"],["して"],["いる"],["の"],["を"],["見る","みる"],["と"],["、"],["もう"],["それ"],["以上","いじょう"],["は"],["何","なん"],["も"],["言わなかった","いわなかった"],["。"]]},{"verse":19,"text":"それから、ふたりは旅をして、ベツレヘムに着いた。彼女たちがベツレヘムに着くと、町中がふたりのことで騒ぎ出し、女たちは、「まあ。ナオミではありませんか」と言った。","tok":[["それ"],["から"],["、"],["ふたり"],["は"],["旅","たび"],["を"],["して"],["、"],["ベツレヘム"],["に"],["着いた","ついた"],["。"],["彼女","かのじょ"],["たち"],["が"],["ベツレヘム"],["に"],["着く","つく"],["と"],["、"],["町中","まちなか"],["が"],["ふたり"],["の"],["こと"],["で"],["騒ぎ","さわぎ"],["出し","だし"],["、"],["女","おんな"],["たち"],["は"],["、"],["「"],["まあ"],["。"],["ナオミ"],["で"],["は"],["ありません"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"ナオミは彼女たちに言った。「私をナオミと呼ばないで、マラと呼んでください。全能者が私をひどい苦しみに会わせたのですから。","tok":[["ナオミ"],["は"],["彼女","かのじょ"],["たち"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["を"],["ナオミ"],["と"],["呼ばないで","よばないで"],["、"],["マラ"],["と"],["呼んで","よんで"],["ください"],["。"],["全能者","ぜんのうしゃ"],["が"],["私","わたくし"],["を"],["ひどい"],["苦しみ","くるしみ"],["に"],["会わせた","あわせた"],["の"],["です"],["から"],["。"]]},{"verse":21,"text":"私は満ち足りて出て行きましたが、主は私を素手で帰されました。なぜ私をナオミと呼ぶのですか。主は私を卑しくし、全能者が私をつらいめに会わせられましたのに。」","tok":[["私","わたくし"],["は"],["満ち足りて","みちたりて"],["出て","でて"],["行きました","いきました"],["が"],["、"],["主","ぬし"],["は"],["私","わたくし"],["を"],["素手","すで"],["で"],["帰されました","かえされました"],["。"],["なぜ"],["私","わたくし"],["を"],["ナオミ"],["と"],["呼ぶ","よぶ"],["の"],["です"],["か"],["。"],["主","ぬし"],["は"],["私","わたくし"],["を"],["卑しく","いやしく"],["し"],["、"],["全能者","ぜんのうしゃ"],["が"],["私","わたくし"],["を"],["つらい"],["め"],["に"],["会わせられました","あわせられました"],["のに"],["。"],["」"]]},{"verse":22,"text":"こうして、ナオミは、嫁のモアブの女ルツといっしょに、モアブの野から帰って来て、大麦の刈り入れの始まったころ、ベツレヘムに着いた。","tok":[["こう"],["して"],["、"],["ナオミ"],["は"],["、"],["嫁","よめ"],["の"],["モアブ"],["の"],["女","おんな"],["ルツ"],["と"],["いっしょ"],["に"],["、"],["モアブ"],["の"],["野","の"],["から"],["帰って","かえって"],["来て","きて"],["、"],["大麦","おおむぎ"],["の"],["刈り入れ","かりいれ"],["の"],["始まった","はじまった"],["ころ"],["、"],["ベツレヘム"],["に"],["着いた","ついた"],["。"]]}]
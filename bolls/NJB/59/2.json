[{"verse":1,"text":"私の兄弟たち。あなたがたは私たちの栄光の主イエス・キリストを信じる信仰を持っているのですから、人をえこひいきしてはいけません。","tok":[["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["は"],["私たち","わたしたち"],["の"],["栄光","えいこう"],["の"],["主","ぬし"],["イエス"],["・"],["キリスト"],["を"],["信じる","しんじる"],["信仰","しんこう"],["を"],["持って","もって"],["いる"],["の"],["です"],["から"],["、"],["人","ひと"],["を"],["えこ"],["ひいき"],["して"],["は"],["いけません"],["。"]]},{"verse":2,"text":"あなたがたの会堂に、金の指輪をはめ、りっぱな服装をした人が入って来、またみすぼらしい服装をした貧しい人も入って来たとします。","tok":[["あなた"],["がた"],["の"],["会堂","かいどう"],["に"],["、"],["金","きん"],["の"],["指輪","ゆびわ"],["を"],["はめ"],["、"],["りっぱ"],["な"],["服装","ふくそう"],["を"],["した"],["人","ひと"],["が"],["入って","はいって"],["来","き"],["、"],["また"],["みすぼらしい"],["服装","ふくそう"],["を"],["した"],["貧しい","まずしい"],["人","ひと"],["も"],["入って","はいって"],["来た","きた"],["と"],["します"],["。"]]},{"verse":3,"text":"あなたがたが、りっぱな服装をした人に目を留めて、「あなたは、こちらの良い席におすわりなさい」と言い、貧しい人には、「あなたは、そこで立っていなさい。でなければ、私の足もとにすわりなさい」と言うとすれば、","tok":[["あなた"],["が"],["た"],["が"],["、"],["りっぱ"],["な"],["服装","ふくそう"],["を"],["した"],["人","ひと"],["に"],["目","め"],["を"],["留めて","とめて"],["、"],["「"],["あなた"],["は"],["、"],["こちら"],["の"],["良い","よい"],["席","せき"],["に"],["おすわり"],["なさい"],["」"],["と"],["言い","いい"],["、"],["貧しい","まずしい"],["人","ひと"],["に"],["は"],["、"],["「"],["あなた"],["は"],["、"],["そこ"],["で"],["立って","たって"],["い"],["なさい"],["。"],["で"],["なければ"],["、"],["私","わたくし"],["の"],["足もと","あしもと"],["に"],["すわり"],["なさい"],["」"],["と"],["言う","ゆう"],["と"],["すれば"],["、"]]},{"verse":4,"text":"あなたがたは、自分たちの間で差別を設け、悪い考え方で人をさばく者になったのではありませんか。","tok":[["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["間","あいだ"],["で"],["差別","さべつ"],["を"],["設け","もうけ"],["、"],["悪い","わるい"],["考え方","かんがえかた"],["で"],["人","ひと"],["を"],["さばく"],["者","もの"],["に"],["なった"],["ので"],["は"],["ありません"],["か"],["。"]]},{"verse":5,"text":"よく聞きなさい。愛する兄弟たち。神は、この世の貧しい人たちを選んで信仰に富む者とし、神を愛する者に約束されている御国を相続する者とされたではありませんか。","tok":[["よく"],["聞き","きき"],["なさい"],["。"],["愛する","あいする"],["兄弟","きょうだい"],["たち"],["。"],["神","かみ"],["は"],["、"],["この世","このよ"],["の"],["貧しい","まずしい"],["人","ひと"],["たち"],["を"],["選んで","えらんで"],["信仰","しんこう"],["に"],["富む","とむ"],["者","もの"],["と"],["し"],["、"],["神","かみ"],["を"],["愛する","あいする"],["者","もの"],["に"],["約束","やくそく"],["されて"],["いる"],["御国","みくに"],["を"],["相続","そうぞく"],["する"],["者","もの"],["と"],["されたで"],["は"],["ありません"],["か"],["。"]]},{"verse":6,"text":"それなのに、あなたがたは貧しい人を軽蔑したのです。あなたがたをしいたげるのは富んだ人たちではありませんか。また、あなたがたを裁判所に引いて行くのも彼らではありませんか。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["貧しい","まずしい"],["人","ひと"],["を"],["軽蔑","けいべつ"],["した"],["の"],["です"],["。"],["あなた"],["がた"],["を"],["しいたげる"],["の"],["は"],["富んだ","とんだ"],["人","ひと"],["たち"],["で"],["は"],["ありません"],["か"],["。"],["また"],["、"],["あなた"],["がた"],["を"],["裁判所","さいばんしょ"],["に"],["引いて","ひいて"],["行く","いく"],["の"],["も"],["彼","かれ"],["ら"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":7,"text":"あなたがたがその名で呼ばれている尊い御名をけがすのも彼らではありませんか。","tok":[["あなた"],["がた"],["が"],["その"],["名","な"],["で"],["呼ばれて","よばれて"],["いる"],["尊い","とうとい"],["御名","ぎょめい"],["を"],["けがす"],["の"],["も"],["彼","かれ"],["ら"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":8,"text":"もし、ほんとうにあなたがたが、聖書に従って、「あなたの隣人をあなた自身のように愛せよ」という最高の律法を守るなら、あなたがたの行いはりっぱです。","tok":[["もし"],["、"],["ほんとう"],["に"],["あなた"],["が"],["た"],["が"],["、"],["聖書","せいしょ"],["に"],["従って","したがって"],["、"],["「"],["あなた"],["の"],["隣人","りんじん"],["を"],["あなた"],["自身","じしん"],["の"],["よう"],["に"],["愛せよ","あいせよ"],["」"],["と"],["いう"],["最高","さいこう"],["の"],["律法","りっぽう"],["を"],["守るなら","まもるなら"],["、"],["あなた"],["がた"],["の"],["行い","おこない"],["は"],["りっぱ"],["です"],["。"]]},{"verse":9,"text":"しかし、もし人をえこひいきするなら、あなたがたは罪を犯しており、律法によって違反者として責められます。","tok":[["しかし"],["、"],["もし"],["人","ひと"],["を"],["えこ"],["ひいき"],["するなら"],["、"],["あなた"],["がた"],["は"],["罪","つみ"],["を"],["犯して","おかして"],["おり"],["、"],["律法","りっぽう"],["によって"],["違反者","いはんしゃ"],["として"],["責められます","せめられます"],["。"]]},{"verse":10,"text":"律法全体を守っても、一つの点でつまずくなら、その人はすべてを犯した者となったのです。","tok":[["律法","りっぽう"],["全体","ぜんたい"],["を"],["守って","まもって"],["も"],["、"],["一","ひと"],["つ"],["の"],["点","てん"],["で"],["つまずくなら"],["、"],["その"],["人","ひと"],["は"],["すべて"],["を"],["犯した","おかした"],["者","もの"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":11,"text":"なぜなら、「姦淫してはならない」と言われた方は、「殺してはならない」とも言われたからです。そこで、姦淫しなくても人殺しをすれば、あなたは律法の違反者となったのです。","tok":[["なぜ"],["なら"],["、"],["「"],["姦淫","かんいん"],["して"],["は"],["ならない"],["」"],["と"],["言われた","いわれた"],["方","ほう"],["は"],["、"],["「"],["殺して","ころして"],["は"],["ならない"],["」"],["と"],["も"],["言われた","いわれた"],["から"],["です"],["。"],["そこ"],["で"],["、"],["姦淫","かんいん"],["しなくて"],["も"],["人殺し","ひとごろし"],["を"],["すれば"],["、"],["あなた"],["は"],["律法","りっぽう"],["の"],["違反者","いはんしゃ"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":12,"text":"自由の律法によってさばかれる者らしく語り、またそのように行いなさい。","tok":[["自由","じゆう"],["の"],["律法","りっぽう"],["によって"],["さばかれる"],["者","もの"],["らしく"],["語り","かたり"],["、"],["また"],["その"],["よう"],["に"],["行い","おこない"],["なさい"],["。"]]},{"verse":13,"text":"あわれみを示したことのない者に対するさばきは、あわれみのないさばきです。あわれみは、さばきに向かって勝ち誇るのです。","tok":[["あわれみ"],["を"],["示した","しめした"],["こと"],["の"],["ない"],["者","もの"],["に"],["対する","たいする"],["さばき"],["は"],["、"],["あわれみ"],["の"],["ない"],["さばき"],["です"],["。"],["あわれみ"],["は"],["、"],["さばき"],["に"],["向かって","むかって"],["勝ち誇る","かちほこる"],["の"],["です"],["。"]]},{"verse":14,"text":"私の兄弟たち。だれかが自分には信仰があると言っても、その人に行いがないなら、何の役に立ちましょう。そのような信仰がその人を救うことができるでしょうか。","tok":[["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["。"],["だれ"],["か"],["が"],["自分","じぶん"],["に"],["は"],["信仰","しんこう"],["が"],["ある"],["と"],["言って","いって"],["も"],["、"],["その"],["人","ひと"],["に"],["行い","おこない"],["が"],["ないなら"],["、"],["何","なん"],["の"],["役","やく"],["に"],["立ちましょう","たちましょう"],["。"],["その"],["よう"],["な"],["信仰","しんこう"],["が"],["その"],["人","ひと"],["を"],["救う","すくう"],["こと"],["が"],["できるでしょう"],["か"],["。"]]},{"verse":15,"text":"もし、兄弟また姉妹のだれかが、着る物がなく、また、毎日の食べ物にもこと欠いているようなときに、","tok":[["もし"],["、"],["兄弟","きょうだい"],["また"],["姉妹","しまい"],["の"],["だれ"],["か"],["が"],["、"],["着る","きる"],["物","もの"],["が"],["なく"],["、"],["また"],["、"],["毎日","まいにち"],["の"],["食べ物","たべもの"],["に"],["も"],["こと欠いて","ことかいて"],["いる"],["よう"],["な"],["とき"],["に"],["、"]]},{"verse":16,"text":"あなたがたのうちだれかが、その人たちに、「安心して行きなさい。暖かになり、十分に食べなさい」と言っても、もしからだに必要な物を与えないなら、何の役に立つでしょう。","tok":[["あなた"],["がた"],["の"],["うち"],["だれ"],["か"],["が"],["、"],["その"],["人","ひと"],["たち"],["に"],["、"],["「"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["。"],["暖か","あたたか"],["に"],["なり"],["、"],["十分","じゅうぶん"],["に"],["食べ","たべ"],["なさい"],["」"],["と"],["言って","いって"],["も"],["、"],["もし"],["からだ"],["に"],["必要","ひつよう"],["な"],["物","もの"],["を"],["与えないなら","あたえないなら"],["、"],["何","なん"],["の"],["役","やく"],["に"],["立つでしょう","たつでしょう"],["。"]]},{"verse":17,"text":"それと同じように、信仰も、もし行いがなかったなら、それだけでは、死んだものです。","tok":[["それ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["信仰","しんこう"],["も"],["、"],["もし"],["行い","おこない"],["が"],["なかったなら"],["、"],["それ"],["だけ"],["で"],["は"],["、"],["死んだ","しんだ"],["もの"],["です"],["。"]]},{"verse":18,"text":"さらに、こう言う人もあるでしょう。「あなたは信仰を持っているが、私は行いを持っています。行いのないあなたの信仰を、私に見せてください。私は、行いによって、私の信仰をあなたに見せてあげます。」","tok":[["さらに"],["、"],["こう"],["言う","いう"],["人","ひと"],["も"],["あるでしょう"],["。"],["「"],["あなた"],["は"],["信仰","しんこう"],["を"],["持って","もって"],["いる"],["が"],["、"],["私","わたくし"],["は"],["行い","おこない"],["を"],["持って","もって"],["います"],["。"],["行い","おこない"],["の"],["ない"],["あなた"],["の"],["信仰","しんこう"],["を"],["、"],["私","わたくし"],["に"],["見せて","みせて"],["ください"],["。"],["私","わたくし"],["は"],["、"],["行い","おこない"],["によって"],["、"],["私","わたくし"],["の"],["信仰","しんこう"],["を"],["あなた"],["に"],["見せて","みせて"],["あげます"],["。"],["」"]]},{"verse":19,"text":"あなたは、神はおひとりだと信じています。りっぱなことです。ですが、悪霊どももそう信じて、身震いしています。","tok":[["あなた"],["は"],["、"],["神","かみ"],["は"],["おひとり"],["だ"],["と"],["信じて","しんじて"],["います"],["。"],["りっぱ"],["な"],["こと"],["です"],["。"],["です"],["が"],["、"],["悪霊","あくりょう"],["ども"],["も"],["そう"],["信じて","しんじて"],["、"],["身震い","みぶるい"],["して"],["います"],["。"]]},{"verse":20,"text":"ああ愚かな人よ。あなたは行いのない信仰がむなしいことを知りたいと思いますか。","tok":[["ああ"],["愚か","おろか"],["な"],["人","ひと"],["よ"],["。"],["あなた"],["は"],["行い","おこない"],["の"],["ない"],["信仰","しんこう"],["が"],["むなしい"],["こと"],["を"],["知りたい","しりたい"],["と"],["思います","おもいます"],["か"],["。"]]},{"verse":21,"text":"私たちの父アブラハムは、その子イサクを祭壇にささげたとき、行いによって義と認められたではありませんか。","tok":[["私たち","わたしたち"],["の"],["父","ちち"],["アブラハム"],["は"],["、"],["その"],["子","こ"],["イサク"],["を"],["祭壇","さいだん"],["に"],["ささげた"],["とき"],["、"],["行い","おこない"],["によって"],["義","ぎ"],["と"],["認められたで","みとめられたで"],["は"],["ありません"],["か"],["。"]]},{"verse":22,"text":"あなたの見ているとおり、彼の信仰は彼の行いとともに働いたのであり、信仰は行いによって全うされ、","tok":[["あなた"],["の"],["見て","みて"],["いる"],["とおり"],["、"],["彼","かれ"],["の"],["信仰","しんこう"],["は"],["彼","かれ"],["の"],["行い","おこない"],["と"],["とも"],["に"],["働いた","はたらいた"],["ので"],["あり"],["、"],["信仰","しんこう"],["は"],["行い","おこない"],["によって"],["全う","まっとう"],["され"],["、"]]},{"verse":23,"text":"そして、「アブラハムは神を信じ、その信仰が彼の義とみなされた」という聖書のことばが実現し、彼は神の友と呼ばれたのです。","tok":[["そして"],["、"],["「"],["アブラハム"],["は"],["神","かみ"],["を"],["信じ","しんじ"],["、"],["その"],["信仰","しんこう"],["が"],["彼","かれ"],["の"],["義","ぎ"],["と"],["みなされた"],["」"],["と"],["いう"],["聖書","せいしょ"],["の"],["ことば"],["が"],["実現","じつげん"],["し"],["、"],["彼","かれ"],["は"],["神","かみ"],["の"],["友","とも"],["と"],["呼ばれた","よばれた"],["の"],["です"],["。"]]},{"verse":24,"text":"人は行いによって義と認められるのであって、信仰だけによるのではないことがわかるでしょう。","tok":[["人","ひと"],["は"],["行い","おこない"],["によって"],["義","ぎ"],["と"],["認められる","みとめられる"],["ので"],["あって"],["、"],["信仰","しんこう"],["だけ"],["に"],["よる"],["ので"],["は"],["ない"],["こと"],["が"],["わかるでしょう"],["。"]]},{"verse":25,"text":"同様に、遊女ラハブも、使者たちを招き入れ、別の道から送り出したため、その行いによって義と認められたではありませんか。","tok":[["同様","どうよう"],["に"],["、"],["遊女","ゆうじょ"],["ラハブ"],["も"],["、"],["使者","ししゃ"],["たち"],["を"],["招き入れ","まねきいれ"],["、"],["別","べつ"],["の"],["道","みち"],["から"],["送り出した","おくりだした"],["ため"],["、"],["その"],["行い","おこない"],["によって"],["義","ぎ"],["と"],["認められたで","みとめられたで"],["は"],["ありません"],["か"],["。"]]},{"verse":26,"text":"たましいを離れたからだが、死んだものであるのと同様に、行いのない信仰は、死んでいるのです。","tok":[["たましい"],["を"],["離れた","はなれた"],["から"],["だ"],["が"],["、"],["死んだ","しんだ"],["もの"],["で"],["ある"],["の"],["と"],["同様","どうよう"],["に"],["、"],["行い","おこない"],["の"],["ない"],["信仰","しんこう"],["は"],["、"],["死んで","しんで"],["いる"],["の"],["です"],["。"]]}]
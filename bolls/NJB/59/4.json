[{"verse":1,"text":"何が原因で、あなたがたの間に戦いや争いがあるのでしょう。あなたがたのからだの中で戦う欲望が原因ではありませんか。","tok":[["何","なん"],["が"],["原因","げんいん"],["で"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["戦い","たたかい"],["や"],["争い","あらそい"],["が"],["ある"],["の"],["でしょう"],["。"],["あなた"],["がた"],["の"],["からだ"],["の"],["中","なか"],["で"],["戦う","たたかう"],["欲望","よくぼう"],["が"],["原因","げんいん"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":2,"text":"あなたがたは、ほしがっても自分のものにならないと、人殺しをするのです。うらやんでも手に入れることができないと、争ったり、戦ったりするのです。あなたがたのものにならないのは、あなたがたが願わないからです。","tok":[["あなた"],["がた"],["は"],["、"],["ほし"],["がっ"],["て"],["も"],["自分","じぶん"],["の"],["もの"],["に"],["ならない"],["と"],["、"],["人殺し","ひとごろし"],["を"],["する"],["の"],["です"],["。"],["うらやんで"],["も"],["手","て"],["に"],["入れる","いれる"],["こと"],["が"],["できない"],["と"],["、"],["争っ","あらそっ"],["たり"],["、"],["戦っ","たたかっ"],["たり"],["する"],["の"],["です"],["。"],["あなた"],["がた"],["の"],["もの"],["に"],["ならない"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["願わない","ねがわない"],["から"],["です"],["。"]]},{"verse":3,"text":"願っても受けられないのは、自分の快楽のために使おうとして、悪い動機で願うからです。","tok":[["願って","ねがって"],["も"],["受けられない","うけられない"],["の"],["は"],["、"],["自分","じぶん"],["の"],["快楽","かいらく"],["の"],["ため"],["に"],["使おう","つかおう"],["として"],["、"],["悪い","わるい"],["動機","どうき"],["で"],["願う","ねがう"],["から"],["です"],["。"]]},{"verse":4,"text":"貞操のない人たち。世を愛することは神に敵することであることがわからないのですか。世の友となりたいと思ったら、その人は自分を神の敵としているのです。","tok":[["貞操","ていそう"],["の"],["ない"],["人","ひと"],["たち"],["。"],["世","よ"],["を"],["愛する","あいする"],["こと"],["は"],["神","かみ"],["に"],["敵する","てきする"],["こと"],["で"],["ある"],["こと"],["が"],["わからない"],["の"],["です"],["か"],["。"],["世","よ"],["の"],["友","とも"],["と"],["なりたい"],["と"],["思ったら","おもったら"],["、"],["その"],["人","ひと"],["は"],["自分","じぶん"],["を"],["神","かみ"],["の"],["敵","てき"],["として"],["いる"],["の"],["です"],["。"]]},{"verse":5,"text":"それとも、「神は、私たちのうちに住まわせた御霊を、ねたむほどに慕っておられる」という聖書のことばが、無意味だと思うのですか。","tok":[["それ"],["と"],["も"],["、"],["「"],["神","かみ"],["は"],["、"],["私たち","わたしたち"],["の"],["うち"],["に"],["住まわせた","すまわせた"],["御霊","ごれい"],["を"],["、"],["ねたむ"],["ほど"],["に"],["慕って","したって"],["おられる"],["」"],["と"],["いう"],["聖書","せいしょ"],["の"],["ことば"],["が"],["、"],["無意味","むいみ"],["だ"],["と"],["思う","おもう"],["の"],["です"],["か"],["。"]]},{"verse":6,"text":"しかし、神は、さらに豊かな恵みを与えてくださいます。ですから、こう言われています。「神は、高ぶる者を退け、へりくだる者に恵みをお授けになる。」","tok":[["しかし"],["、"],["神","かみ"],["は"],["、"],["さらに"],["豊か","ゆたか"],["な"],["恵み","めぐみ"],["を"],["与えて","あたえて"],["くださいます"],["。"],["です"],["から"],["、"],["こう"],["言われて","いわれて"],["います"],["。"],["「"],["神","かみ"],["は"],["、"],["高ぶる","たかぶる"],["者","もの"],["を"],["退け","しりぞけ"],["、"],["へりくだる"],["者","もの"],["に"],["恵み","めぐみ"],["を"],["お授け","おさずけ"],["に"],["なる"],["。"],["」"]]},{"verse":7,"text":"ですから、神に従いなさい。そして、悪魔に立ち向かいなさい。そうすれば、悪魔はあなたがたから逃げ去ります。","tok":[["です"],["から"],["、"],["神","かみ"],["に"],["従い","したがい"],["なさい"],["。"],["そして"],["、"],["悪魔","あくま"],["に"],["立ち向かい","たちむかい"],["なさい"],["。"],["そう"],["すれば"],["、"],["悪魔","あくま"],["は"],["あなた"],["がた"],["から"],["逃げ去ります","にげさります"],["。"]]},{"verse":8,"text":"神に近づきなさい。そうすれば、神はあなたがたに近づいてくださいます。罪ある人たち。手を洗いきよめなさい。二心の人たち。心を清くしなさい。","tok":[["神","かみ"],["に"],["近づき","ちかづき"],["なさい"],["。"],["そう"],["すれば"],["、"],["神","かみ"],["は"],["あなた"],["がた"],["に"],["近づいて","ちかづいて"],["くださいます"],["。"],["罪","つみ"],["ある"],["人","ひと"],["たち"],["。"],["手","て"],["を"],["洗い","あらい"],["きよめ"],["なさい"],["。"],["二心","にしん"],["の"],["人","ひと"],["たち"],["。"],["心","こころ"],["を"],["清く","きよく"],["し"],["なさい"],["。"]]},{"verse":9,"text":"あなたがたは、苦しみなさい。悲しみなさい。泣きなさい。あなたがたの笑いを悲しみに、喜びを憂いに変えなさい。","tok":[["あなた"],["がた"],["は"],["、"],["苦しみ","くるしみ"],["なさい"],["。"],["悲しみ","かなしみ"],["なさい"],["。"],["泣き","なき"],["なさい"],["。"],["あなた"],["がた"],["の"],["笑い","わらい"],["を"],["悲しみ","かなしみ"],["に"],["、"],["喜び","よろこび"],["を"],["憂い","うれい"],["に"],["変え","かえ"],["なさい"],["。"]]},{"verse":10,"text":"主の御前でへりくだりなさい。そうすれば、主があなたがたを高くしてくださいます。","tok":[["主","ぬし"],["の"],["御前","ごぜん"],["で"],["へりくだり"],["なさい"],["。"],["そう"],["すれば"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["を"],["高く","たかく"],["して"],["くださいます"],["。"]]},{"verse":11,"text":"兄弟たち。互いに悪口を言い合ってはいけません。自分の兄弟の悪口を言い、自分の兄弟をさばく者は、律法の悪口を言い、律法をさばいているのです。あなたが、もし律法をさばくなら、律法を守る者ではなくて、さばく者です。","tok":[["兄弟","きょうだい"],["たち"],["。"],["互い","たがい"],["に"],["悪口","わるぐち"],["を"],["言い合って","いいあって"],["は"],["いけません"],["。"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["の"],["悪口","わるぐち"],["を"],["言い","いい"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["さばく"],["者","もの"],["は"],["、"],["律法","りっぽう"],["の"],["悪口","わるぐち"],["を"],["言い","いい"],["、"],["律法","りっぽう"],["を"],["さばいて"],["いる"],["の"],["です"],["。"],["あなた"],["が"],["、"],["もし"],["律法","りっぽう"],["を"],["さばくなら"],["、"],["律法","りっぽう"],["を"],["守る","まもる"],["者","もの"],["で"],["は"],["なくて"],["、"],["さばく者","さばくしゃ"],["です"],["。"]]},{"verse":12,"text":"律法を定め、さばきを行う方は、ただひとりであり、その方は救うことも滅ぼすこともできます。隣人をさばくあなたは、いったい何者ですか。","tok":[["律法","りっぽう"],["を"],["定め","さだめ"],["、"],["さばき"],["を"],["行う","おこなう"],["方","かた"],["は"],["、"],["ただ"],["ひとり"],["で"],["あり"],["、"],["その"],["方","かた"],["は"],["救う","すくう"],["こと"],["も"],["滅ぼす","ほろぼす"],["こと"],["も"],["できます"],["。"],["隣人","りんじん"],["を"],["さばく"],["あなた"],["は"],["、"],["いったい"],["何者","なにもの"],["です"],["か"],["。"]]},{"verse":13,"text":"聞きなさい。「きょうか、あす、これこれの町に行き、そこに一年いて、商売をして、もうけよう」と言う人たち。","tok":[["聞き","きき"],["なさい"],["。"],["「"],["きょうか"],["、"],["あす"],["、"],["これ"],["これ"],["の"],["町","まち"],["に"],["行き","いき"],["、"],["そこ"],["に"],["一","いち"],["年","ねん"],["いて"],["、"],["商売","しょうばい"],["を"],["して"],["、"],["もうけよう"],["」"],["と"],["言う","いう"],["人","ひと"],["たち"],["。"]]},{"verse":14,"text":"あなたがたには、あすのことはわからないのです。あなたがたのいのちは、いったいどのようなものですか。あなたがたは、しばらくの間現れて、それから消えてしまう霧にすぎません。","tok":[["あなた"],["がた"],["に"],["は"],["、"],["あす"],["の"],["こと"],["は"],["わからない"],["の"],["です"],["。"],["あなた"],["がた"],["の"],["いのち"],["は"],["、"],["いったい"],["どのような"],["もの"],["です"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["しばらく"],["の"],["間","あいだ"],["現れて","あらわれて"],["、"],["それ"],["から"],["消えて","きえて"],["しまう"],["霧","きり"],["に"],["すぎません"],["。"]]},{"verse":15,"text":"むしろ、あなたがたはこう言うべきです。「主のみこころなら、私たちは生きていて、このことを、または、あのことをしよう。」","tok":[["むしろ"],["、"],["あなた"],["がた"],["は"],["こう"],["言うべきです","ゆうべきです"],["。"],["「"],["主","ぬし"],["のみ"],["こころ"],["なら"],["、"],["私たち","わたしたち"],["は"],["生きて","いきて"],["いて"],["、"],["この"],["こと"],["を"],["、"],["また"],["は"],["、"],["あの"],["こと"],["を"],["しよう"],["。"],["」"]]},{"verse":16,"text":"ところがこのとおり、あなたがたはむなしい誇りをもって高ぶっています。そのような高ぶりは、すべて悪いことです。","tok":[["ところ"],["が"],["この"],["とおり"],["、"],["あなた"],["がた"],["は"],["むなしい"],["誇り","ほこり"],["を"],["もって"],["高ぶって","たかぶって"],["います"],["。"],["その"],["よう"],["な"],["高ぶり","たかぶり"],["は"],["、"],["すべて"],["悪い","わるい"],["こと"],["です"],["。"]]},{"verse":17,"text":"こういうわけで、なすべき正しいことを知っていながら行わないなら、それはその人の罪です。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["なすべき"],["正しい","ただしい"],["こと"],["を"],["知って","しって"],["い"],["ながら"],["行わないなら","おこなわないなら"],["、"],["それ"],["は"],["その"],["人","ひと"],["の"],["罪","つみ"],["です"],["。"]]}]
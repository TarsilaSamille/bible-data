[{"verse":1,"text":"神と主イエス・キリストのしもべヤコブが、国外に散っている十二の部族へあいさつを送ります。","tok":[["神","かみ"],["と"],["主","ぬし"],["イエス"],["・"],["キリスト"],["の"],["しもべ"],["ヤコブ"],["が"],["、"],["国外","こくがい"],["に"],["散って","ちって"],["いる"],["十二","じゅうに"],["の"],["部族","ぶぞく"],["へ"],["あいさつ"],["を"],["送ります","おくります"],["。"]]},{"verse":2,"text":"私の兄弟たち。さまざまな試練に会うときは、それをこの上もない喜びと思いなさい。","tok":[["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["。"],["さまざま"],["な"],["試練","しれん"],["に"],["会う","あう"],["とき"],["は"],["、"],["それ"],["を"],["この"],["上","うえ"],["も"],["ない"],["喜び","よろこび"],["と"],["思い","おもい"],["なさい"],["。"]]},{"verse":3,"text":"信仰がためされると忍耐が生じるということを、あなたがたは知っているからです。","tok":[["信仰","しんこう"],["が"],["ためされる"],["と"],["忍耐","にんたい"],["が"],["生じる","しょうじる"],["と"],["いう"],["こと"],["を"],["、"],["あなた"],["がた"],["は"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":4,"text":"その忍耐を完全に働かせなさい。そうすれば、あなたがたは、何一つ欠けたところのない、成長を遂げた、完全な者となります。","tok":[["その"],["忍耐","にんたい"],["を"],["完全","かんぜん"],["に"],["働かせ","はたらかせ"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["、"],["何","なん"],["一","ひと"],["つ"],["欠けた","かけた"],["ところ"],["の"],["ない"],["、"],["成長","せいちょう"],["を"],["遂げた","とげた"],["、"],["完全","かんぜん"],["な"],["者","もの"],["と"],["なります"],["。"]]},{"verse":5,"text":"あなたがたの中に知恵の欠けた人がいるなら、その人は、だれにでも惜しげなく、とがめることなくお与えになる神に願いなさい。そうすればきっと与えられます。","tok":[["あなた"],["がた"],["の"],["中","なか"],["に"],["知恵","ちえ"],["の"],["欠けた","かけた"],["人","ひと"],["が"],["いるなら"],["、"],["その"],["人","ひと"],["は"],["、"],["だれ"],["に"],["で"],["も"],["惜し","おし"],["げ"],["なく"],["、"],["とがめる"],["こと"],["なく"],["お与え","おあたえ"],["に"],["なる"],["神","かみ"],["に"],["願い","ねがい"],["なさい"],["。"],["そう"],["すれば"],["きっと"],["与えられます","あたえられます"],["。"]]},{"verse":6,"text":"ただし、少しも疑わずに、信じて願いなさい。疑う人は、風に吹かれて揺れ動く、海の大波のようです。","tok":[["ただし"],["、"],["少し","すこし"],["も"],["疑わず","うたがわず"],["に"],["、"],["信じて","しんじて"],["願い","ねがい"],["なさい"],["。"],["疑う","うたがう"],["人","ひと"],["は"],["、"],["風","かぜ"],["に"],["吹かれて","ふかれて"],["揺れ動く","ゆれうごく"],["、"],["海","うみ"],["の"],["大波","おおなみ"],["の"],["よう"],["です"],["。"]]},{"verse":7,"text":"そういう人は、主から何かをいただけると思ってはなりません。","tok":[["そう"],["いう"],["人","ひと"],["は"],["、"],["主","ぬし"],["から"],["何","なん"],["か"],["を"],["いただける"],["と"],["思って","おもって"],["は"],["なりません"],["。"]]},{"verse":8,"text":"そういうのは、二心のある人で、その歩む道のすべてに安定を欠いた人です。","tok":[["そう"],["いう"],["の"],["は"],["、"],["二心","にしん"],["の"],["ある"],["人","ひと"],["で"],["、"],["その"],["歩む","あゆむ"],["道","みち"],["の"],["すべて"],["に"],["安定","あんてい"],["を"],["欠いた","かいた"],["人","ひと"],["です"],["。"]]},{"verse":9,"text":"貧しい境遇にある兄弟は、自分の高い身分を誇りとしなさい。","tok":[["貧しい","まずしい"],["境遇","きょうぐう"],["に"],["ある"],["兄弟","きょうだい"],["は"],["、"],["自分","じぶん"],["の"],["高い","たかい"],["身分","みぶん"],["を"],["誇り","ほこり"],["と"],["し"],["なさい"],["。"]]},{"verse":10,"text":"富んでいる人は、自分が低くされることに誇りを持ちなさい。なぜなら、富んでいる人は、草の花のように過ぎ去って行くからです。","tok":[["富んで","とんで"],["いる"],["人","ひと"],["は"],["、"],["自分","じぶん"],["が"],["低く","ひくく"],["される"],["こと"],["に"],["誇り","ほこり"],["を"],["持ち","もち"],["なさい"],["。"],["なぜ"],["なら"],["、"],["富んで","とんで"],["いる"],["人","ひと"],["は"],["、"],["草","くさ"],["の"],["花","はな"],["の"],["よう"],["に"],["過ぎ去って","すぎさって"],["行く","いく"],["から"],["です"],["。"]]},{"verse":11,"text":"太陽が熱風を伴って上って来ると、草を枯らしてしまいます。すると、その花は落ち、美しい姿は滅びます。同じように、富んでいる人も、働きの最中に消えて行くのです。","tok":[["太陽","たいよう"],["が"],["熱風","ねっぷう"],["を"],["伴って","ともなって"],["上って","のぼって"],["来る","くる"],["と"],["、"],["草","くさ"],["を"],["枯らして","からして"],["しまいます"],["。"],["する"],["と"],["、"],["その"],["花","はな"],["は"],["落ち","おち"],["、"],["美しい","うつくしい"],["姿","すがた"],["は"],["滅びます","ほろびます"],["。"],["同じ","おなじ"],["よう"],["に"],["、"],["富んで","とんで"],["いる"],["人","ひと"],["も"],["、"],["働き","はたらき"],["の"],["最中","さいちゅう"],["に"],["消えて","きえて"],["行く","いく"],["の"],["です"],["。"]]},{"verse":12,"text":"試練に耐える人は幸いです。耐え抜いて良しと認められた人は、神を愛する者に約束された、いのちの冠を受けるからです。","tok":[["試練","しれん"],["に"],["耐える","たえる"],["人","ひと"],["は"],["幸い","さいわい"],["です"],["。"],["耐え","たえ"],["抜いて","ぬいて"],["良し","よし"],["と"],["認められた","みとめられた"],["人","ひと"],["は"],["、"],["神","かみ"],["を"],["愛する","あいする"],["者","もの"],["に"],["約束","やくそく"],["された"],["、"],["いのち"],["の"],["冠","かんむり"],["を"],["受ける","うける"],["から"],["です"],["。"]]},{"verse":13,"text":"だれでも誘惑に会ったとき、神によって誘惑された、と言ってはいけません。神は悪に誘惑されることのない方であり、ご自分でだれを誘惑なさることもありません。","tok":[["だれ"],["で"],["も"],["誘惑","ゆうわく"],["に"],["会った","あった"],["とき"],["、"],["神","かみ"],["によって"],["誘惑","ゆうわく"],["された"],["、"],["と"],["言って","いって"],["は"],["いけません"],["。"],["神","かみ"],["は"],["悪","わる"],["に"],["誘惑","ゆうわく"],["される"],["こと"],["の"],["ない"],["方","かた"],["で"],["あり"],["、"],["ご自分","ごじぶん"],["で"],["だれ"],["を"],["誘惑","ゆうわく"],["なさる"],["こと"],["も"],["ありません"],["。"]]},{"verse":14,"text":"人はそれぞれ自分の欲に引かれ、おびき寄せられて、誘惑されるのです。","tok":[["人","ひと"],["は"],["それぞれ"],["自分","じぶん"],["の"],["欲","よく"],["に"],["引かれ","ひかれ"],["、"],["おびき寄せられて","おびきよせられて"],["、"],["誘惑","ゆうわく"],["される"],["の"],["です"],["。"]]},{"verse":15,"text":"欲がはらむと罪を生み、罪が熟すると死を生みます。","tok":[["欲","よく"],["が"],["はらむ"],["と"],["罪","つみ"],["を"],["生み","うみ"],["、"],["罪","つみ"],["が"],["熟する","じゅくする"],["と"],["死","し"],["を"],["生みます","うみます"],["。"]]},{"verse":16,"text":"愛する兄弟たち。だまされないようにしなさい。","tok":[["愛する","あいする"],["兄弟","きょうだい"],["たち"],["。"],["だまされない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":17,"text":"すべての良い贈り物、また、すべての完全な賜物は上から来るのであって、光を造られた父から下るのです。父には移り変わりや、移り行く影はありません。","tok":[["すべて"],["の"],["良い","よい"],["贈り物","おくりもの"],["、"],["また"],["、"],["すべて"],["の"],["完全","かんぜん"],["な"],["賜物","たまもの"],["は"],["上","うえ"],["から"],["来る","くる"],["ので"],["あって"],["、"],["光","ひかり"],["を"],["造られた","つくられた"],["父","ちち"],["から"],["下る","くだる"],["の"],["です"],["。"],["父","ちち"],["に"],["は"],["移り変わり","うつりかわり"],["や"],["、"],["移り行く","うつりゆく"],["影","かげ"],["は"],["ありません"],["。"]]},{"verse":18,"text":"父はみこころのままに、真理のことばをもって私たちをお生みになりました。私たちを、いわば被造物の初穂にするためなのです。","tok":[["父","ちち"],["は"],["みこころ"],["の"],["まま"],["に"],["、"],["真理","しんり"],["の"],["ことば"],["を"],["もって"],["私たち","わたしたち"],["を"],["お生み","おうみ"],["に"],["なりました"],["。"],["私たち","わたしたち"],["を"],["、"],["いわば"],["被","ひ"],["造物","ぞうぶつ"],["の"],["初穂","はつほ"],["に"],["する"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":19,"text":"愛する兄弟たち。あなたがたはそのことを知っているのです。しかし、だれでも、聞くには早く、語るにはおそく、怒るにはおそいようにしなさい。","tok":[["愛する","あいする"],["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["は"],["その"],["こと"],["を"],["知って","しって"],["いる"],["の"],["です"],["。"],["しかし"],["、"],["だれ"],["で"],["も"],["、"],["聞く","きく"],["に"],["は"],["早く","はやく"],["、"],["語る","かたる"],["に"],["は"],["おそく"],["、"],["怒る","おこる"],["に"],["は"],["おそい"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":20,"text":"人の怒りは、神の義を実現するものではありません。","tok":[["人","ひと"],["の"],["怒り","いかり"],["は"],["、"],["神","かみ"],["の"],["義","ぎ"],["を"],["実現","じつげん"],["する"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":21,"text":"ですから、すべての汚れやあふれる悪を捨て去り、心に植えつけられたみことばを、すなおに受け入れなさい。みことばは、あなたがたのたましいを救うことができます。","tok":[["です"],["から"],["、"],["すべて"],["の"],["汚れ","よごれ"],["や"],["あふれる"],["悪","あく"],["を"],["捨て去り","すてさり"],["、"],["心","こころ"],["に"],["植えつけられた","うえつけられた"],["みことば"],["を"],["、"],["すなお"],["に"],["受け入れ","うけいれ"],["なさい"],["。"],["みことば"],["は"],["、"],["あなた"],["がた"],["の"],["たましい"],["を"],["救う","すくう"],["こと"],["が"],["できます"],["。"]]},{"verse":22,"text":"また、みことばを実行する人になりなさい。自分を欺いて、ただ聞くだけの者であってはいけません。","tok":[["また"],["、"],["みことば"],["を"],["実行","じっこう"],["する"],["人","ひと"],["に"],["なり"],["なさい"],["。"],["自分","じぶん"],["を"],["欺いて","あざむいて"],["、"],["ただ"],["聞く","きく"],["だけ"],["の"],["者","もの"],["で"],["あって"],["は"],["いけません"],["。"]]},{"verse":23,"text":"みことばを聞いても行わない人がいるなら、その人は自分の生まれつきの顔を鏡で見る人のようです。","tok":[["みことば"],["を"],["聞いて","きいて"],["も"],["行わない","おこなわない"],["人","ひと"],["が"],["いるなら"],["、"],["その"],["人","ひと"],["は"],["自分","じぶん"],["の"],["生まれつき","うまれつき"],["の"],["顔","かお"],["を"],["鏡","かがみ"],["で"],["見る","みる"],["人","ひと"],["の"],["よう"],["です"],["。"]]},{"verse":24,"text":"自分をながめてから立ち去ると、すぐにそれがどのようであったかを忘れてしまいます。","tok":[["自分","じぶん"],["を"],["ながめて"],["から"],["立ち去る","たちさる"],["と"],["、"],["すぐ"],["に"],["それ"],["が"],["どの"],["よう"],["で"],["あった"],["か"],["を"],["忘れて","わすれて"],["しまいます"],["。"]]},{"verse":25,"text":"ところが、完全な律法、すなわち自由の律法を一心に見つめて離れない人は、すぐに忘れる聞き手にはならないで、事を実行する人になります。こういう人は、その行いによって祝福されます。","tok":[["ところ"],["が"],["、"],["完全","かんぜん"],["な"],["律法","りっぽう"],["、"],["すなわち"],["自由","じゆう"],["の"],["律法","りっぽう"],["を"],["一心","いっしん"],["に"],["見つめて","みつめて"],["離れない","はなれない"],["人","ひと"],["は"],["、"],["すぐ"],["に"],["忘れる","わすれる"],["聞き手","ききて"],["に"],["は"],["ならないで"],["、"],["事","こと"],["を"],["実行","じっこう"],["する"],["人","ひと"],["に"],[
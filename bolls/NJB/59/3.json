[{"verse":1,"text":"私の兄弟たち。多くの者が教師になってはいけません。ご承知のように、私たち教師は、格別きびしいさばきを受けるのです。","tok":[["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["。"],["多く","おおく"],["の"],["者","もの"],["が"],["教師","きょうし"],["に"],["なって"],["は"],["いけません"],["。"],["ご承知","ごしょうち"],["の"],["よう"],["に"],["、"],["私たち","わたしたち"],["教師","きょうし"],["は"],["、"],["格別","かくべつ"],["きびしい"],["さばき"],["を"],["受ける","うける"],["の"],["です"],["。"]]},{"verse":2,"text":"私たちはみな、多くの点で失敗をするものです。もし、ことばで失敗をしない人がいたら、その人は、からだ全体もりっぱに制御できる完全な人です。","tok":[["私たち","わたしたち"],["は"],["みな"],["、"],["多く","おおく"],["の"],["点","てん"],["で"],["失敗","しっぱい"],["を"],["する"],["もの"],["です"],["。"],["もし"],["、"],["ことば"],["で"],["失敗","しっぱい"],["を"],["しない"],["人","ひと"],["が"],["いたら"],["、"],["その"],["人","ひと"],["は"],["、"],["からだ"],["全体","ぜんたい"],["も"],["りっぱ"],["に"],["制御","せいぎょ"],["できる"],["完全","かんぜん"],["な"],["人","ひと"],["です"],["。"]]},{"verse":3,"text":"馬を御するために、くつわをその口にかけると、馬のからだ全体を引き回すことができます。","tok":[["馬","うま"],["を"],["御する","ぎょする"],["ため"],["に"],["、"],["くつわ"],["を"],["その"],["口","くち"],["に"],["かける"],["と"],["、"],["馬","うま"],["の"],["からだ"],["全体","ぜんたい"],["を"],["引き回す","ひきまわす"],["こと"],["が"],["できます"],["。"]]},{"verse":4,"text":"また、船を見なさい。あのように大きな物が、強い風に押されているときでも、ごく小さなかじによって、かじを取る人の思いどおりの所へ持って行かれるのです。","tok":[["また"],["、"],["船","ふね"],["を"],["見","み"],["なさい"],["。"],["あの"],["よう"],["に"],["大きな","おおきな"],["物","もの"],["が"],["、"],["強い","つよい"],["風","かぜ"],["に"],["押されて","おされて"],["いる"],["とき"],["で"],["も"],["、"],["ごく"],["小さな","ちいさな"],["かじ"],["によって"],["、"],["かじ"],["を"],["取る","とる"],["人","ひと"],["の"],["思い","おもい"],["どおり"],["の"],["所","ところ"],["へ"],["持って","もって"],["行かれる","いかれる"],["の"],["です"],["。"]]},{"verse":5,"text":"同様に、舌も小さな器官ですが、大きなことを言って誇るのです。ご覧なさい。あのように小さい火があのような大きい森を燃やします。","tok":[["同様","どうよう"],["に"],["、"],["舌","した"],["も"],["小さな","ちいさな"],["器官","きかん"],["です"],["が"],["、"],["大きな","おおきな"],["こと"],["を"],["言って","いって"],["誇る","ほこる"],["の"],["です"],["。"],["ご覧","ごらん"],["なさい"],["。"],["あの"],["よう"],["に"],["小さい","ちいさい"],["火","ひ"],["が"],["あの"],["よう"],["な"],["大きい","おおきい"],["森","もり"],["を"],["燃やします","もやします"],["。"]]},{"verse":6,"text":"舌は火であり、不義の世界です。舌は私たちの器官の一つですが、からだ全体を汚し、人生の車輪を焼き、そしてゲヘナの火によって焼かれます。","tok":[["舌","した"],["は"],["火","ひ"],["で"],["あり"],["、"],["不義","ふぎ"],["の"],["世界","せかい"],["です"],["。"],["舌","した"],["は"],["私たち","わたしたち"],["の"],["器官","きかん"],["の"],["一","ひと"],["つ"],["です"],["が"],["、"],["からだ"],["全体","ぜんたい"],["を"],["汚し","よごし"],["、"],["人生","じんせい"],["の"],["車輪","しゃりん"],["を"],["焼き","やき"],["、"],["そして"],["ゲヘナ"],["の"],["火","ひ"],["によって"],["焼かれます","やかれます"],["。"]]},{"verse":7,"text":"どのような種類の獣も鳥も、はうものも海の生き物も、人類によって制せられるし、すでに制せられています。","tok":[["どのような"],["種類","しゅるい"],["の"],["獣","けもの"],["も"],["鳥","とり"],["も"],["、"],["は"],["う"],["もの"],["も"],["海","うみ"],["の"],["生き物","いきもの"],["も"],["、"],["人類","じんるい"],["によって"],["制せられる","せいせられる"],["し"],["、"],["すでに"],["制せられて","せいせられて"],["います"],["。"]]},{"verse":8,"text":"しかし、舌を制御することは、だれにもできません。それは少しもじっとしていない悪であり、死の毒に満ちています。","tok":[["しかし"],["、"],["舌","した"],["を"],["制御","せいぎょ"],["する"],["こと"],["は"],["、"],["だれ"],["に"],["も"],["できません"],["。"],["それ"],["は"],["少し","すこし"],["も"],["じっと"],["して"],["いない"],["悪","わる"],["で"],["あり"],["、"],["死","し"],["の"],["毒","どく"],["に"],["満ちて","みちて"],["います"],["。"]]},{"verse":9,"text":"私たちは、舌をもって、主であり父である方をほめたたえ、同じ舌をもって、神にかたどって造られた人をのろいます。","tok":[["私たち","わたしたち"],["は"],["、"],["舌","した"],["を"],["もって"],["、"],["主","ぬし"],["で"],["あり"],["父","ちち"],["で"],["ある"],["方","かた"],["を"],["ほめたたえ"],["、"],["同じ","おなじ"],["舌","した"],["を"],["もって"],["、"],["神","かみ"],["に"],["かたどって"],["造られた","つくられた"],["人","ひと"],["を"],["のろいます"],["。"]]},{"verse":10,"text":"賛美とのろいが同じ口から出て来るのです。私の兄弟たち。このようなことは、あってはなりません。","tok":[["賛美","さんび"],["と"],["のろい"],["が"],["同じ","おなじ"],["口","くち"],["から"],["出て","でて"],["来る","くる"],["の"],["です"],["。"],["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["。"],["この"],["よう"],["な"],["こと"],["は"],["、"],["あって"],["は"],["なりません"],["。"]]},{"verse":11,"text":"泉が甘い水と苦い水を同じ穴からわき上がらせるというようなことがあるでしょうか。","tok":[["泉","いずみ"],["が"],["甘い","あまい"],["水","みず"],["と"],["苦い","にがい"],["水","みず"],["を"],["同じ","おなじ"],["穴","あな"],["から"],["わき上がらせる","わきあがらせる"],["と"],["いう"],["よう"],["な"],["こと"],["が"],["あるでしょう"],["か"],["。"]]},{"verse":12,"text":"私の兄弟たち。いちじくの木がオリーブの実をならせたり、ぶどうの木がいちじくの実をならせたりするようなことは、できることでしょうか。塩水が甘い水を出すこともできないことです。","tok":[["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["。"],["いちじく"],["の"],["木","き"],["が"],["オリーブ"],["の"],["実","じつ"],["を"],["ならせ"],["たり"],["、"],["ぶどう"],["の"],["木","き"],["が"],["いちじく"],["の"],["実","じつ"],["を"],["ならせ"],["たり"],["する"],["よう"],["な"],["こと"],["は"],["、"],["できる"],["こと"],["でしょう"],["か"],["。"],["塩水","しおみず"],["が"],["甘い","あまい"],["水","みず"],["を"],["出す","だす"],["こと"],["も"],["できない"],["こと"],["です"],["。"]]},{"verse":13,"text":"あなたがたのうちで、知恵のある、賢い人はだれでしょうか。その人は、その知恵にふさわしい柔和な行いを、良い生き方によって示しなさい。","tok":[["あなた"],["がた"],["の"],["うち"],["で"],["、"],["知恵","ちえ"],["の"],["ある"],["、"],["賢い","かしこい"],["人","ひと"],["は"],["だれ"],["でしょう"],["か"],["。"],["その"],["人","ひと"],["は"],["、"],["その"],["知恵","ちえ"],["に"],["ふさわしい"],["柔和","にゅうわ"],["な"],["行い","おこない"],["を"],["、"],["良い","よい"],["生き方","いきかた"],["によって"],["示し","しめし"],["なさい"],["。"]]},{"verse":14,"text":"しかし、もしあなたがたの心の中に、苦いねたみと敵対心があるならば、誇ってはいけません。真理に逆らって偽ることになります。","tok":[["しかし"],["、"],["もし"],["あなた"],["がた"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["、"],["苦い","にがい"],["ねたみ"],["と"],["敵対心","てきたいしん"],["が"],["あるならば"],["、"],["誇って","ほこって"],["は"],["いけません"],["。"],["真理","しんり"],["に"],["逆らって","さからって"],["偽る","いつわる"],["こと"],["に"],["なります"],["。"]]},{"verse":15,"text":"そのような知恵は、上から来たものではなく、地に属し、肉に属し、悪霊に属するものです。","tok":[["その"],["よう"],["な"],["知恵","ちえ"],["は"],["、"],["上","うえ"],["から"],["来た","きた"],["もの"],["で"],["は"],["なく"],["、"],["地","ち"],["に"],["属し","ぞくし"],["、"],["肉","にく"],["に"],["属し","ぞくし"],["、"],["悪霊","あくりょう"],["に"],["属する","ぞくする"],["もの"],["です"],["。"]]},{"verse":16,"text":"ねたみや敵対心のあるところには、秩序の乱れや、あらゆる邪悪な行いがあるからです。","tok":[["ねたみ"],["や"],["敵対心","てきたいしん"],["の"],["ある"],["ところ"],["に"],["は"],["、"],["秩序","ちつじょ"],["の"],["乱れ","みだれ"],["や"],["、"],["あらゆる"],["邪悪","じゃあく"],["な"],["行い","おこない"],["が"],["ある"],["から"],["です"],["。"]]},{"verse":17,"text":"しかし、上からの知恵は、第一に純真であり、次に平和、寛容、温順であり、また、あわれみと良い実とに満ち、えこひいきがなく、見せかけのないものです。","tok":[["しかし"],["、"],["上","うえ"],["から"],["の"],["知恵","ちえ"],["は"],["、"],["第","だい"],["一","いち"],["に"],["純真","じゅんしん"],["で"],["あり"],["、"],["次","つぎ"],["に"],["平和","へいわ"],["、"],["寛容","かんよう"],["、"],["温順","おんじゅん"],["で"],["あり"],["、"],["また"],["、"],["あわれみ"],["と"],["良い","よい"],["実","じつ"],["と"],["に"],["満ち","みち"],["、"],["えこ"],["ひいき"],["が"],["なく"],["、"],["見せかけ","みせかけ"],["の"],["ない"],["もの"],["です"],["。"]]},{"verse":18,"text":"義の実を結ばせる種は、平和をつくる人によって平和のうちに蒔かれます。","tok":[["義","ぎ"],["の"],["実","じつ"],["を"],["結ばせる","むすばせる"],["種","たね"],["は"],["、"],["平和","へいわ"],["を"],["つくる"],["人","ひと"],["によって"],["平和","へいわ"],["の"],["うち"],["に"],["蒔かれます","まかれます"],["。"]]}]
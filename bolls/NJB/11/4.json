[{"verse":1,"text":"こうして、ソロモン王は全イスラエルの王となった。","tok":[["こう"],["して"],["、"],["ソロモン"],["王","おう"],["は"],["全","ぜん"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["。"]]},{"verse":2,"text":"彼の高官たちは次のとおり。ツァドクの子アザルヤは祭司。","tok":[["彼","かれ"],["の"],["高官","こうかん"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["。"],["ツァドク"],["の"],["子","こ"],["アザルヤ"],["は"],["祭司","さいし"],["。"]]},{"verse":3,"text":"シシャの子らエリホレフとアヒヤは書記。アヒルデの子ヨシャパテは参議。","tok":[["シシャ"],["の"],["子","こ"],["ら"],["エリホレフ"],["と"],["アヒヤ"],["は"],["書記","しょき"],["。"],["アヒルデ"],["の"],["子","こ"],["ヨシャパテ"],["は"],["参議","さんぎ"],["。"]]},{"verse":4,"text":"エホヤダの子ベナヤは軍団長。ツァドクとエブヤタルは祭司。","tok":[["エホヤダ"],["の"],["子","こ"],["ベナヤ"],["は"],["軍団長","ぐんだんちょう"],["。"],["ツァドク"],["と"],["エブヤタル"],["は"],["祭司","さいし"],["。"]]},{"verse":5,"text":"ナタンの子アザルヤは政務長官。ナタンの子ザブデは祭司で、王の友。","tok":[["ナタン"],["の"],["子","こ"],["アザルヤ"],["は"],["政務","せいむ"],["長官","ちょうかん"],["。"],["ナタン"],["の"],["子","こ"],["ザブデ"],["は"],["祭司","さいし"],["で"],["、"],["王","おう"],["の"],["友","とも"],["。"]]},{"verse":6,"text":"アヒシャルは宮内長官。アブダの子アドニラムは役務長官。","tok":[["アヒシャル"],["は"],["宮内","くない"],["長官","ちょうかん"],["。"],["アブダ"],["の"],["子","こ"],["アドニラム"],["は"],["役務","えきむ"],["長官","ちょうかん"],["。"]]},{"verse":7,"text":"ソロモンは、イスラエルの全土に十二人の守護を置いた。彼らは王とその一族に食糧を納めていた。すなわち、一年に一か月間、おのおの食糧を納めていた。","tok":[["ソロモン"],["は"],["、"],["イスラエル"],["の"],["全土","ぜんど"],["に"],["十二人","じゅうににん"],["の"],["守護","しゅご"],["を"],["置いた","おいた"],["。"],["彼","かれ"],["ら"],["は"],["王","おう"],["と"],["その"],["一族","いちぞく"],["に"],["食糧","しょくりょう"],["を"],["納めて","おさめて"],["いた"],["。"],["すなわち"],["、"],["一","いち"],["年","ねん"],["に"],["一","いち"],["か月間","かげつかん"],["、"],["おのおの"],["食糧","しょくりょう"],["を"],["納めて","おさめて"],["いた"],["。"]]},{"verse":8,"text":"彼らの名は次のとおり。／エフライムの山地にはフルの子。","tok":[["彼","かれ"],["ら"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["。"],["／"],["エフライム"],["の"],["山地","さんち"],["に"],["は"],["フル"],["の"],["子","こ"],["。"]]},{"verse":9,"text":"マカツ、シャアルビム、ベテ・シェメシュ、エロン・ベテ・ハナンにはデケルの子。","tok":[["マカツ"],["、"],["シャアルビム"],["、"],["ベテ"],["・"],["シェメシュ"],["、"],["エロン"],["・"],["ベテ"],["・"],["ハナン"],["に"],["は"],["デケル"],["の"],["子","こ"],["。"]]},{"verse":10,"text":"アルボテにはヘセデの子。――彼にはソコとヘフェルの全地が任せられていた――","tok":[["アルボテ"],["に"],["は"],["ヘセデ"],["の"],["子","こ"],["。"],["―"],["―"],["彼","かれ"],["に"],["は"],["ソコ"],["と"],["ヘフェル"],["の"],["全地","ぜんち"],["が"],["任せられて","まかせられて"],["いた"],["―"],["―"]]},{"verse":11,"text":"ドルの全高地にはアビナダブの子。――ソロモンの娘タファテが彼の妻であった――","tok":[["ドル"],["の"],["全","ぜん"],["高地","こうち"],["に"],["は"],["アビナダブ"],["の"],["子","こ"],["。"],["―"],["―"],["ソロモン"],["の"],["娘","むすめ"],["タファテ"],["が"],["彼","かれ"],["の"],["妻","つま"],["で"],["あった"],["―"],["―"]]},{"verse":12,"text":"タナク、メギド、それに、イズレエルの下ツァレタンのそばのベテ・シェアンの全土、ベテ・シェアンからアベル・メホラ、ヨクモアムの向こうまでの地には、アヒルデの子バアナ。","tok":[["タナク"],["、"],["メギド"],["、"],["それ"],["に"],["、"],["イズレエル"],["の"],["下","した"],["ツァレタン"],["の"],["そば"],["の"],["ベテ"],["・"],["シェアン"],["の"],["全土","ぜんど"],["、"],["ベテ"],["・"],["シェアン"],["から"],["アベル"],["・"],["メホラ"],["、"],["ヨクモアム"],["の"],["向こう","むこう"],["まで"],["の"],["地","ち"],["に"],["は"],["、"],["アヒルデ"],["の"],["子","こ"],["バアナ"],["。"]]},{"verse":13,"text":"ラモテ・ギルアデにはゲベルの子。――彼にはギルアデのマナセの子ヤイルの村々と、バシャンにあるアルゴブの地域で、城壁と青銅のかんぬきを備えた六十の大きな町々が任せられた――","tok":[["ラモテ"],["・"],["ギルアデ"],["に"],["は"],["ゲベル"],["の"],["子","こ"],["。"],["―"],["―"],["彼","かれ"],["に"],["は"],["ギルアデ"],["の"],["マナセ"],["の"],["子","こ"],["ヤイル"],["の"],["村々","むらむら"],["と"],["、"],["バシャン"],["に"],["ある"],["アルゴブ"],["の"],["地域","ちいき"],["で"],["、"],["城壁","じょうへき"],["と"],["青銅","せいどう"],["の"],["かんぬき"],["を"],["備えた","そなえた"],["六十","ろくじゅう"],["の"],["大きな","おおきな"],["町々","まちまち"],["が"],["任せられた","まかせられた"],["―"],["―"]]},{"verse":14,"text":"マハナイムにはイドの子アヒナダブ。","tok":[["マハナイム"],["に"],["は"],["イド"],["の"],["子","こ"],["アヒナダブ"],["。"]]},{"verse":15,"text":"ナフタリにはアヒマアツ。――彼もまた、ソロモンの娘バセマテをめとっていた――","tok":[["ナフタリ"],["に"],["は"],["アヒマアツ"],["。"],["―"],["―"],["彼","かれ"],["も"],["また"],["、"],["ソロモン"],["の"],["娘","むすめ"],["バセマテ"],["を"],["めとって"],["いた"],["―"],["―"]]},{"verse":16,"text":"アシェルとベアロテにはフシャイの子バアナ。","tok":[["アシェル"],["と"],["ベアロテ"],["に"],["は"],["フシャイ"],["の"],["子","こ"],["バアナ"],["。"]]},{"verse":17,"text":"イッサカルにはパルアハの子ヨシャパテ。","tok":[["イッサカル"],["に"],["は"],["パルアハ"],["の"],["子","こ"],["ヨシャパテ"],["。"]]},{"verse":18,"text":"ベニヤミンにはエラの子シムイ。","tok":[["ベニヤミン"],["に"],["は"],["エラ"],["の"],["子","こ"],["シムイ"],["。"]]},{"verse":19,"text":"エモリ人の王シホンと、バシャンの王オグの領地であったギルアデの地にはウリの子ゲベル。その地にはもうひとりの守備隊長がいた。","tok":[["エモリ人","えもりにん"],["の"],["王","おう"],["シホン"],["と"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["の"],["領地","りょうち"],["で"],["あった"],["ギルアデ"],["の"],["地","ち"],["に"],["は"],["ウリ"],["の"],["子","こ"],["ゲベル"],["。"],["その"],["地","ち"],["に"],["は"],["もう"],["ひとり"],["の"],["守備","しゅび"],["隊長","たいちょう"],["が"],["いた"],["。"]]},{"verse":20,"text":"ユダとイスラエルの人口は、海辺の砂のように多くなり、彼らは飲み食いして楽しんでいた。","tok":[["ユダ"],["と"],["イスラエル"],["の"],["人口","じんこう"],["は"],["、"],["海辺","うみべ"],["の"],["砂","すな"],["の"],["よう"],["に"],["多く","おおく"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["飲み食い","のみくい"],["して"],["楽しんで","たのしんで"],["いた"],["。"]]},{"verse":21,"text":"ソロモンは、大河からペリシテ人の地、さらには、エジプトの国境に至るすべての王国を支配した。これらの王国は、ソロモンの一生の間みつぎものを持って来て、彼に仕えた。","tok":[["ソロモン"],["は"],["、"],["大河","たいが"],["から"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["、"],["さらに"],["は"],["、"],["エジプト"],["の"],["国境","こっきょう"],["に"],["至る","いたる"],["すべて"],["の"],["王国","おうこく"],["を"],["支配","しはい"],["した"],["。"],["これ"],["ら"],["の"],["王国","おうこく"],["は"],["、"],["ソロモン"],["の"],["一生","いっしょう"],["の"],["間","あいだ"],["みつぎもの"],["を"],["持って","もって"],["来て","きて"],["、"],["彼","かれ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":22,"text":"ソロモンの一日分の食糧は、小麦粉三十コル、大麦粉六十コル。","tok":[["ソロモン"],["の"],["一","いち"],["日","にち"],["分","ぶん"],["の"],["食糧","しょくりょう"],["は"],["、"],["小麦粉","こむぎこ"],["三十","さんじゅう"],["コル"],["、"],["大麦","おおむぎ"],["粉","こな"],["六十","ろくじゅう"],["コル"],["。"]]},{"verse":23,"text":"それに、肥えた牛十頭、放牧の牛二十頭、羊百頭。そのほか、雄鹿、かもしか、のろじかと、肥えた鳥であった。","tok":[["それ"],["に"],["、"],["肥えた","こえた"],["牛","うし"],["十頭","じゅうとう"],["、"],["放牧","ほうぼく"],["の"],["牛","うし"],["二十頭","にじゅうとう"],["、"],["羊","ひつじ"],["百頭","ひゃくとう"],["。"],["その"],["ほか"],["、"],["雄鹿","おじか"],["、"],["かもしか"],["、"],["の"],["ろじ"],["か"],["と"],["、"],["肥えた","こえた"],["鳥","とり"],["で"],["あった"],["。"]]},{"verse":24,"text":"これはソロモンが、大河の西側、ティフサフからガザまでの全土、すなわち、大河の西側のすべての王たちを支配し、周辺のすべての地方に平和があったからである。","tok":[["これ"],["は"],["ソロモン"],["が"],["、"],["大河","たいが"],["の"],["西側","にしがわ"],["、"],["ティフサフ"],["から"],["ガザ"],["まで"],["の"],["全土","ぜんど"],["、"],["すなわち"],["、"],["大河","たいが"],["の"],["西側","にしがわ"],["の"],["すべて"],["の"],["王","おう"],["たち"],["を"],["支配","しはい"],["し"],["、"],["周辺","しゅうへん"],["の"],["すべて"],["の"],["地方","ちほう"],["に"],["平和","へいわ"],["が"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"ユダとイスラエルは、ソロモンの治世中、ダンからベエル・シェバまで、みな、おのおの自分のぶどうの木の下や、いちじくの木の下で安心して住むことができた。","tok":[["ユダ"],["と"],["イスラエル"],["は"],["、"],["ソロモン"],["の"],["治世中","ちせいちゅう"],["、"],["ダン"],["から"],["ベエル"],["・"],["シェバ"],["まで"],["、"],["みな"],["、"],["おのおの"],["自分","じぶん"],["の"],["ぶどう"],["の"],["木","き"],["の"],["下","した"],["や"],["、"],["いちじく"],["の"],["木","き"],["の"],["下","もと"],["で"],["安心","あんしん"],["して"],["住む","すむ"],["こと"],["が"],["できた"],["。"]]},{"verse":26,"text":"ソロモンは戦車用の馬のための馬屋四万、騎兵一万二千を持っていた。","tok":[["ソロモン"],["は"],["戦車用","せんしゃよう"],["の"],["馬","うま"],["の"],["ため"],["の"],["馬屋","うまや"],["四万","よんまん"],["、"],["騎兵","きへい"],["一万二千","いちまんにせん"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":27,"text":"守護たちは、それぞれ自分の当番月にソロモン王、およびソロモン王の食事の席に連なるすべての者たちのために、食糧を納め、不足させなかった。","tok":[["守護","しゅご"],["たち"],["は"],["、"],["それぞれ"],["自分","じぶん"],["の"],["当番","とうばん"],["月","がつ"],["に"],["ソロモン"],["王","おう"],["、"],["および"],["ソロモン"],["王","おう"],["の"],["食事","しょくじ"],["の"],["席","せき"],["に"],["連なる","つらなる"],["すべて"],["の"],["者","もの"],["たち"],["の"],["ため"],["に"],["、"],["食糧","しょくりょう"],["を"],["納め","おさめ"],["、"],["不足","ふそく"],["させなかった"],["。"]]},{"verse":28,"text":"彼らはまた、引き馬や早馬のために、それぞれ割り当てに従って、馬のいる所に大麦とわらを持って来た。","tok":[["彼","かれ"],["ら"],["は"],["また"],["、"],["引き馬","ひきうま"],["や"],["早馬","はやうま"],["の"],["ため"],["に"],["、"],["それぞれ"],["割り当て","わりあて"],["に"],["従って","したがって"],["、"],["馬","うま"],["の"],["いる"],["所","ところ"],["に"],["大麦","おおむぎ"],["と"],["わら"],["を"],["持って","もって"],["来た","きた"],["。"]]},{"verse":29,"text":"神は、ソロモンに非常に豊かな知恵と英知と、海辺の砂浜のように広い心とを与えられた。","tok":[["神","かみ"],["は"],["、"],["ソロモン"],["に"],["非常","ひじょう"],["に"],["豊か","ゆたか"],["な"],["知恵","ちえ"],["と"],["英知","えいち"],["と"],["、"],["海辺","うみべ"],["の"],["砂浜","すなはま"],["の"],["よう"],["に"],["広い","ひろい"],["心","こころ"],["と"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":30,"text":"それでソロモンの知恵は、東のすべての人々の知恵と、エジプト人のすべての知恵とにまさっていた。","tok":[["それ"],["で"],["ソロモン"],["の"],["知恵","ちえ"],["は"],["、"],["東","ひがし"],["の"],["すべて"],["の"],["人々","ひとびと"],["の"],["知恵","ちえ"],["と"],["、"],["エジプト"],["人","にん"],["の"],["すべて"],["の"],["知恵","ちえ"],["と"],["に"],["まさって"],["いた"],["。"]]},{"verse":31,"text":"彼は、すべての人、すなわち、エズラフ人エタンや、ヘマンや、カルコルや、マホルの子ダルダよりも知恵があった。それで、彼の名声は周辺のすべての国々に広がった。","tok":[["彼","かれ"],["は"],["、"],["すべて"],["の"],["人","ひと"],["、"],["すなわち"],["、"],["エズラフ"],["人","にん"],["エタン"],["や"],["、"],["ヘマン"],["や"],["、"],["カルコル"],["や"],["、"],["マホル"],["の"],["子","こ"],["ダルダ"],["より"],["も"],["知恵","ちえ"],["が"],["あった"],["。"],["それ"],["で"],["、"],["彼","かれ"],["の"],["名声","めいせい"],["は"],["周辺","しゅうへん"],["の"],["すべて"],["の"],["国々","くにぐに"],["に"],["広がった","ひろがった"],["。"]]},{"verse":32,"text":"彼は三千の箴言を語り、彼の歌は一千五首もあった。","tok":[["彼","かれ"],["は"],["三千","さんせん"],["の"],["箴言","しんげん"],["を"],["語り","かたり"],["、"],["彼","かれ"],["の"],["歌","うた"],["は"],["一千五","いちせんご"],["首","しゅ"],["も"],["あった"],["。"]]},{"verse":33,"text":"彼はレバノンの杉の木から、石垣に生えるヒソプに至るまでの草木について語り、獣や鳥やはうものや魚についても語った。","tok":[["彼","かれ"],["は"],["レバノン"],["の"],["杉","すぎ"],["の"],["木","き"],["から"],["、"],["石垣","いしがき"],["に"],["生える","はえる"],["ヒソプ"],["に"],["至る","いたる"],["まで"],["の"],["草木","くさき"],["について"],["語り","かたり"],["、"],["獣","けもの"],["や"],["鳥","とり"],["や"],["はう"],["もの"],["や"],["魚","さかな"],["について"],["も"],["語った","かたった"],["。"]]},{"verse":34,"text":"ソロモンの知恵を聞くために、すべての国の人々や、彼の知恵のうわさを聞いた国のすべての王たちがやって来た。","tok":[["ソロモン"],["の"],["知恵","ちえ"],["を"],["聞く","きく"],["ため"],["に"],["、"],["すべて"],["の"],["国","くに"],["の"],["人々","ひとびと"],["や"],["、"],["彼","かれ"],["の"],["知恵","ちえ"],["の"],["うわさ"],["を"],["聞いた","きいた"],["国","くに"],["の"],["すべて"],["の"],["王","おう"],["たち"],["が"],["やって"],["来た","きた"],["。"]]}]
[{"verse":1,"text":"そのとき、ソロモンはイスラエルの長老たち、およびイスラエル人の部族のかしらたちと一族の長たちをすべて、エルサレムのソロモン王のもとに召集した。ダビデの町シオンから主の契約の箱を運び上るためであった。","tok":[["その"],["とき"],["、"],["ソロモン"],["は"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["、"],["および"],["イスラエル"],["人","にん"],["の"],["部族","ぶぞく"],["の"],["かしら"],["たち"],["と"],["一族","いちぞく"],["の"],["長","なが"],["たち"],["を"],["すべて"],["、"],["エルサレム"],["の"],["ソロモン"],["王","おう"],["の"],["もと"],["に"],["召集","しょうしゅう"],["した"],["。"],["ダビデ"],["の"],["町","まち"],["シオン"],["から"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["運び","はこび"],["上る","のぼる"],["ため"],["で"],["あった"],["。"]]},{"verse":2,"text":"イスラエルのすべての人々は、エタニムの月、すなわち第七の新月の祭りに、ソロモン王のもとに集まった。","tok":[["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["は"],["、"],["エタニム"],["の"],["月","つき"],["、"],["すなわち"],["第","だい"],["七","なな"],["の"],["新月","しんげつ"],["の"],["祭り","まつり"],["に"],["、"],["ソロモン"],["王","おう"],["の"],["もと"],["に"],["集まった","あつまった"],["。"]]},{"verse":3,"text":"こうして、イスラエルの長老全員が到着したところで、祭司たちは箱をにない、","tok":[["こう"],["して"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["全員","ぜんいん"],["が"],["到着","とうちゃく"],["した"],["ところ"],["で"],["、"],["祭司","さいし"],["たち"],["は"],["箱","ばこ"],["を"],["にない"],["、"]]},{"verse":4,"text":"主の箱と、会見の天幕と、天幕にあったすべての聖なる用具とを運び上った。これらの物を祭司たちとレビ人たちが運び上った。","tok":[["主","ぬし"],["の"],["箱","ばこ"],["と"],["、"],["会見","かいけん"],["の"],["天幕","てんまく"],["と"],["、"],["天幕","てんまく"],["に"],["あった"],["すべて"],["の"],["聖","せい"],["なる"],["用具","ようぐ"],["と"],["を"],["運び","はこび"],["上った","のぼった"],["。"],["これ"],["ら"],["の"],["物","もの"],["を"],["祭司","さいし"],["たち"],["と"],["レビ人","れびにん"],["たち"],["が"],["運び","はこび"],["上った","のぼった"],["。"]]},{"verse":5,"text":"ソロモン王、そして彼のところに集まったイスラエルの全会衆が彼とともに、箱の前に行き、羊や牛をいけにえとしてささげたが、その数があまりに多くて数えることも調べることもできなかった。","tok":[["ソロモン"],["王","おう"],["、"],["そして"],["彼","かれ"],["の"],["ところ"],["に"],["集まった","あつまった"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["が"],["彼","かれ"],["と"],["とも"],["に"],["、"],["箱","ばこ"],["の"],["前","まえ"],["に"],["行き","いき"],["、"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["いけにえ"],["として"],["ささげた"],["が"],["、"],["その"],["数","かず"],["が"],["あまり"],["に"],["多くて","おおくて"],["
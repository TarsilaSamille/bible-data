[{"verse":1,"text":"さて、ツロの王ヒラムは、ソロモンが油をそそがれ、彼の父に代わって王となったことを聞いて、自分の家来たちをソロモンのところへ遣わした。ヒラムはダビデといつも友情を保っていたからである。","tok":[["さて"],["、"],["ツロ"],["の"],["王","おう"],["ヒラム"],["は"],["、"],["ソロモン"],["が"],["油","あぶら"],["を"],["そそがれ"],["、"],["彼","かれ"],["の"],["父","ちち"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["こと"],["を"],["聞いて","きいて"],["、"],["自分","じぶん"],["の"],["家来","けらい"],["たち"],["を"],["ソロモン"],["の"],["ところ"],["へ"],["遣わした","つかわした"],["。"],["ヒラム"],["は"],["ダビデ"],["と"],["いつも"],["友情","ゆうじょう"],["を"],["保って","たもって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"そこで、ソロモンはヒラムのもとに人をやって言わせた。","tok":[["そこ"],["で"],["、"],["ソロモン"],["は"],["ヒラム"],["の"],["もと"],["に"],["人","ひと"],["を"],["やって"],["言わせた","いわせた"],["。"]]},{"verse":3,"text":"「あなたがご存じのように、私の父ダビデは、彼の回りからいつも戦いをいどまれていたため、主が彼らを私の足の裏の下に置かれるまで、彼の神、主の名のために宮を建てることができませんでした。","tok":[["「"],["あなた"],["が"],["ご存じ","ごぞんじ"],["の"],["よう"],["に"],["、"],["私","わたくし"],["の"],["父","ちち"],["ダビデ"],["は"],["、"],["彼","かれ"],["の"],["回り","まわり"],["から"],["いつも"],["戦い","たたかい"],["を"],["いどまれて"],["いた"],["ため"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["私","わたくし"],["の"],["足","あし"],["の"],["裏","うら"],["の"],["下","した"],["に"],["置かれる","おかれる"],["まで"],["、"],["彼","かれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["名","な"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てる","たてる"],["こと"],["が"],["できませんでした"],["。"]]},{"verse":4,"text":"ところが、今、私の神、主は、周囲の者から守って、私に安息を与えてくださり、敵対する者もなく、わざわいを起こす者もありません。","tok":[["ところ"],["が"],["、"],["今","いま"],["、"],["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["周囲","しゅうい"],["の"],["者","もの"],["から"],["守って","まもって"],["、"],["私","わたくし"],["に"],["安息","あんそく"],["を"],["与えて","あたえて"],["くださり"],["、"],["敵対","てきたい"],["する"],["者","もの"],["も"],["なく"],["、"],["わざわい"],["を"],["起こす","おこす"],["者","もの"],["も"],["ありません"],["。"]]},{"verse":5,"text":"今、私は、私の神、主の名のために宮を建てようと思っています。主が私の父ダビデに『わたしが、あなたの代わりに、あなたの王座に着かせるあなたの子、彼がわたしの名のために宮を建てる』と言われたとおりです。","tok":[["今","いま"],["、"],["私","わたくし"],["は"],["、"],["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["名","な"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てよう","たてよう"],["と"],["思って","おもって"],["います"],["。"],["主","ぬし"],["が"],["私","わたくし"],["の"],["父","ちち"],["ダビデ"],["に"],["『"],["わたし"],["が"],["、"],["あなた"],["の"],["代わり","かわり"],["に"],["、"],["あなた"],["の"],["王座","おうざ"],["に"],["着かせる","つかせる"],["あなた"],["の"],["子","こ"],["、"],["彼","かれ"],["が"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てる","たてる"],["』"],["と"],["言われた","いわれた"],["とおり"],["です"],["。"]]},{"verse":6,"text":"どうか、私のために、レバノンから杉の木を切り出すように命じてください。私のしもべたちも、あなたのしもべたちといっしょに働きます。私はあなたのしもべたちに、あなたが言われるとおりの賃金を払います。ご存じのように、私たちの中にはシドン人のように木を切ることに熟練した者がいないのです。」","tok":[["どう"],["か"],["、"],["私","わたくし"],["の"],["ため"],["に"],["、"],["レバノン"],["から"],["杉","すぎ"],["の"],["木","き"],["を"],["切り出す","きりだす"],["よう"],["に"],["命じて","めいじて"],["ください"],["。"],["私","わたくし"],["の"],["しもべ"],["たち"],["も"],["、"],["あなた"],["の"],["しもべ"],["たち"],["と"],["いっしょ"],["に"],["働きます","はたらきます"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["しもべ"],["たち"],["に"],["、"],["あなた"],["が"],["言われる","いわれる"],["とおり"],["の"],["賃金","ちんぎん"],["を"],["払います","はらいます"],["。"],["ご存じ","ごぞんじ"],["の"],["よう"],["に"],["、"],["私たち","わたしたち"],["の"],["中","なか"],["に"],["は"],["シドン人","しどんにん"],["の"],["よう"],["に"],["木","き"],["を"],["切る","きる"],["こと"],["に"],["熟練","じゅくれん"],["した"],["者","もの"],["が"],["いない"],["の"],["です"],["。"],["」"]]},{"verse":7,"text":"ヒラムはソロモンの申し出を聞いて、非常に喜んで言った。「きょう、主はほむべきかな。このおびただしい民を治める知恵ある子をダビデに授けられたとは。」","tok":[["ヒラム"],["は"],["ソロモン"],["の"],["申し出","もうしで"],["を"],["聞いて","きいて"],["、"],["非常","ひじょう"],["に"],["喜んで","よろこんで"],["言った","いった"],["。"],["「"],["きょう"],["、"],["主","ぬし"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["この"],["おびただしい"],["民","たみ"],["を"],["治める","おさめる"],["知恵","ちえ"],["ある"],["子","こ"],["を"],["ダビデ"],["に"],["授けられた","さずけられた"],["と"],["は"],["。"],["」"]]},{"verse":8,"text":"そして、ヒラムはソロモンのもとに人をやって言わせた。「あなたの申し送られたことを聞きました。私は、杉の木材ともみの木材なら、何なりとあなたのお望みどおりにいたしましょう。","tok":[["そして"],["、"],["ヒラム"],["は"],["ソロモン"],["の"],["もと"],["に"],["人","ひと"],["を"],["やって"],["言わせた","いわせた"],["。"],["「"],["あなた"],["の"],["申し送られた","もうしおくられた"],["こと"],["を"],["聞きました","ききました"],["。"],["私","わたくし"],["は"],["、"],["杉","すぎ"],["の"],["木材","もくざい"],["と"],["もみ"],["の"],["木材","もくざい"],["なら"],["、"],["何","なん"],["なり"],["と"],["あなた"],["の"],["お望み","おのぞみ"],["どおり"],["に"],["いたしましょう"],["。"]]},{"verse":9,"text":"私のしもべたちはそれをレバノンから海へ下らせます。私はそれをいかだに組んで、海路、あなたが指定される場所まで送り、そこで、それを解かせましょう。あなたはそれを受け取ってください。それから、あなたは、私の一族に食物を与え、私の願いをかなえてください。」","tok":[["私","わたくし"],["の"],["しもべ"],["たち"],["は"],["それ"],["を"],["レバノン"],["から"],["海","うみ"],["へ"],["下らせます","くだらせます"],["。"],["私","わたくし"],["は"],["それ"],["を"],["いかだ"],["に"],["組んで","くんで"],["、"],["海路","かいろ"],["、"],["あなた"],["が"],["指定","してい"],["される"],["場所","ばしょ"],["まで"],["送り","おくり"],["、"],["そこ"],["で"],["、"],["それ"],["を"],["解かせましょう","とかせましょう"],["。"],["あなた"],["は"],["それ"],["を"],["受け取って","うけとって"],["ください"],["。"],["それ"],["から"],["、"],["あなた"],["は"],["、"],["私","わたくし"],["の"],["一族","いちぞく"],["に"],["食物","しょくもつ"],["を"],["与え","あたえ"],["、"],["私","わたくし"],["の"],["願い","ねがい"],["を"],["かなえて"],["ください"],["。"],["」"]]},{"verse":10,"text":"こうしてヒラムは、ソロモンに杉の木材ともみの木材とを彼の望むだけ与えた。","tok":[["こう"],["して"],["ヒラム"],["は"],["、"],["ソロモン"],["に"],["杉","すぎ"],["の"],["木材","もくざい"],["と"],["もみ"],["の"],["木材","もくざい"],["と"],["を"],["彼","かれ"],["の"],["望む","のぞむ"],["だけ"],["与えた","あたえた"],["。"]]},{"verse":11,"text":"そこで、ソロモンはヒラムに、その一族の食糧として、小麦二万コルを与え、また、上質のオリーブ油二十コルを与えた。ソロモンはこれだけの物を毎年ヒラムに与えた。","tok":[["そこ"],["で"],["、"],["ソロモン"],["は"],["ヒラム"],["に"],["、"],["その"],["一族","いちぞく"],["の"],["食糧","しょくりょう"],["として"],["、"],["小麦","こむぎ"],["二万","にまん"],["コル"],["を"],["与え","あたえ"],["、"],["また"],["、"],["上質","じょうしつ"],["の"],["オリーブ油","おりーぶゆ"],["二十","にじゅう"],["コル"],["を"],["与えた","あたえた"],["。"],["ソロモン"],["は"],["これ"],["だけ"],["の"],["物","もの"],["を"],["毎年","まいとし"],["ヒラム"],["に"],["与えた","あたえた"],["。"]]},{"verse":12,"text":"主は約束どおり、ソロモンに知恵を賜ったので、ヒラムとソロモンとの間には平和が保たれ、ふたりは契約を結んだ。","tok":[["主","ぬし"],["は"],["約束","やくそく"],["どおり"],["、"],["ソロモン"],["に"],["知恵","ちえ"],["を"],["賜った","たまわった"],["ので"],["、"],["ヒラム"],["と"],["ソロモン"],["と"],["の"],["間","あいだ"],["に"],["は"],["平和","へいわ"],["が"],["保たれ","たもたれ"],["、"],["ふたり"],["は"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":13,"text":"ソロモン王は全イスラエルから役務者を徴用した。役務者は三万人であった。","tok":[["ソロモン"],["王","おう"],["は"],["全","ぜん"],["イスラエル"],["から"],["役務者","えきむしゃ"],["を"],["徴用","ちょうよう"],["した"],["。"],["役務者","えきむしゃ"],["は"],["三万人","さんまんにん"],["で"],["あった"],["。"]]},{"verse":14,"text":"ソロモンは彼らを一か月交替で、一万人ずつレバノンに送った。すなわち、一か月はレバノンに、二か月は家にいるようにした。役務長官はアドニラムであった。","tok":[["ソロモン"],["は"],["彼","かれ"],["ら"],["を"],["一","いち"],["か月","かげつ"],["交替","こうたい"],["で"],["、"],["一万人","いちまんにん"],["ずつ"],["レバノン"],["に"],["送った","おくった"],["。"],["すなわち"],["、"],["一","いち"],["か月","かげつ"],["は"],["レバノン"],["に"],["、"],["二","に"],["か月","かげつ"],["は"],["家","いえ"],["に"],["いる"],["よう"],["に"],["した"],["。"],["役務","えきむ"],["長官","ちょうかん"],["は"],["アドニラム"],["で"],["あった"],["。"]]},{"verse":15,"text":"ソロモンには荷役人夫が七万人、山で石を切り出す者が八万人あった。","tok":[["ソロモン"],["に"],["は"],["荷役","にやく"],["人夫","にんぷ"],["が"],["七万人","ななまんにん"],["、"],["山","やま"],["で"],["石","いし"],["を"],["切り出す","きりだす"],["者","もの"],["が"],["八万人","はちまんにん"],["あった"],["。"]]},{"verse":16,"text":"そのほか、ソロモンには工事の監督をする者の長が三千三百人あって、工事に携わる者を指揮していた。","tok":[["その"],["ほか"],["、"],["ソロモン"],["に"],["は"],["工事","こうじ"],["の"],["監督","かんとく"],["を"],["する"],["者","もの"],["の"],["長","ちょう"],["が"],["三千三百","さんせんさんひゃく"],["人","にん"],["あって"],["、"],["工事","こうじ"],["に"],["携わる","たずさわる"],["者","もの"],["を"],["指揮","しき"],["して"],["いた"],["。"]]},{"verse":17,"text":"王は、切り石を神殿の礎に据えるために、大きな石、高価な石を切り出すように命じた。","tok":[["王","おう"],["は"],["、"],["切り石","きりいし"],["を"],["神殿","しんでん"],["の"],["礎","いしずえ"],["に"],["据える","すえる"],["ため"],["に"],["、"],["大きな","おおきな"],["石","いし"],["、"],["高価","こうか"],["な"],["石","いし"],["を"],["切り出す","きりだす"],["よう"],["に"],["命じた","めいじた"],["。"]]},{"verse":18,"text":"ソロモンの建築師と、ヒラムの建築師と、ゲバル人たちは石を切り、宮を建てるために木材と石材とを準備した。","tok":[["ソロモン"],["の"],["建築師","けんちくし"],["と"],["、"],["ヒラム"],["の"],["建築師","けんちくし"],["と"],["、"],["ゲバル人","げばるにん"],["たち"],["は"],["石","いし"],["を"],["切り","きり"],["、"],["宮","みや"],["を"],["建てる","たてる"],["ため"],["に"],["木材","もくざい"],["と"],["石材","せきざい"],["と"],["を"],["準備","じゅんび"],["した"],["。"]]}]
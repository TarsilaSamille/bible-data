[{"verse":1,"text":"それから、かなりたって、三年目に、次のような主のことばがエリヤにあった。「アハブに会いに行け。わたしはこの地に雨を降らせよう。」","tok":[["それ"],["から"],["、"],["かなり"],["たって"],["、"],["三","さん"],["年目","ねんめ"],["に"],["、"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["エリヤ"],["に"],["あった"],["。"],["「"],["アハブ"],["に"],["会い","あい"],["に"],["行け","いけ"],["。"],["わたし"],["は"],["この"],["地","ち"],["に"],["雨","あめ"],["を"],["降らせよう","ふらせよう"],["。"],["」"]]},{"verse":2,"text":"そこで、エリヤはアハブに会いに出かけた。そのころ、サマリヤではききんがひどかった。","tok":[["そこ"],["で"],["、"],["エリヤ"],["は"],["アハブ"],["に"],["会い","あい"],["に"],["出かけた","でかけた"],["。"],["その"],["ころ"],["、"],["サマリヤ"],["で"],["は"],["ききん"],["が"],["ひどかった"],["。"]]},{"verse":3,"text":"アハブは王宮をつかさどるオバデヤを呼び寄せた。――オバデヤは非常に主を恐れていた。","tok":[["アハブ"],["は"],["王宮","おうきゅう"],["を"],["つかさどる"],["オバデヤ"],["を"],["呼び寄せた","よびよせた"],["。"],["―"],["―"],["オバデヤ"],["は"],["非常","ひじょう"],["に"],["主","ぬし"],["を"],["恐れて","おそれて"],["いた"],["。"]]},{"verse":4,"text":"イゼベルが主の預言者たちを殺したとき、オバデヤは百人の預言者を救い出し、五十人ずつほら穴の中にかくまい、パンと水で彼らを養った――","tok":[["イゼベル"],["が"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["殺した","ころした"],["とき"],["、"],["オバデヤ"],["は"],["百人","ひゃくにん"],["の"],["預言者","よげんしゃ"],["を"],["救い出し","すくいだし"],["、"],["五","ご"],["十人","じゅうにん"],["ずつ"],["ほら穴","ほらあな"],["の"],["中","なか"],["に"],["かくまい"],["、"],["パン"],["と"],["水","みず"],["で"],["彼","かれ"],["ら"],["を"],["養った","やしなった"],["―"],["―"]]},{"verse":5,"text":"アハブはオバデヤに言った。「国のうちのすべての水の泉や、すべての川に行ってみよ。たぶん、馬と騾馬とを生かしておく草を見つけて、家畜を殺さないで済むかもしれない。」","tok":[["アハブ"],["は"],["オバデヤ"],["に"],["言った","いった"],["。"],["「"],["国","くに"],["の"],["うち"],["の"],["すべて"],["の"],["水","みず"],["の"],["泉","いずみ"],["や"],["、"],["すべて"],["の"],["川","かわ"],["に"],["行って","いって"],["み"],["よ"],["。"],["たぶん"],["、"],["馬","うま"],["と"],["騾馬","らば"],["と"],["を"],["生かして","いかして"],["おく"],["草","くさ"],["を"],["見つけて","みつけて"],["、"],["家畜","かちく"],["を"],["殺さないで","ころさないで"],["済む","すむ"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":6,"text":"ふたりはこの国を二分して巡り歩くことにし、アハブはひとりで一つの道を行き、オバデヤはひとりでほかの道を行った。","tok":[["ふたり"],["は"],["この"],["国","くに"],["を"],["二分","にぶん"],["して"],["巡り歩く","めぐりあるく"],["こと"],["に"],["し"],["、"],["アハブ"],["は"],["ひとり"],["で"],["一","ひと"],["つ"],["の"],["道","みち"],["を"],["行き","いき"],["、"],["オバデヤ"],["は"],["ひとり"],["で"],["ほか"],["の"],["道","みち"],["を"],["行った","おこなった"],["。"]]},{"verse":7,"text":"オバデヤがその道にいたところ、そこへ、エリヤが彼に会いに来た。彼にはそれがエリヤだとわかったので、ひれ伏して言った。「あなたは私の主人エリヤではありませんか。」","tok":[["オバデヤ"],["が"],["その"],["道","みち"],["に"],["いた"],["ところ"],["、"],["そこ"],["へ"],["、"],["エリヤ"],["が"],["彼","かれ"],["に"],["会い","あい"],["に"],["来た","きた"],["。"],["彼","かれ"],["に"],["は"],["それ"],["が"],["エリヤ"],["だ"],["と"],["わかった"],["ので"],["、"],["ひれ伏して","ひれふして"],["言った","いった"],["。"],["「"],["あなた"],["は"],["私","わたくし"],["の"],["主人","しゅじん"],["エリヤ"],["で"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":8,"text":"エリヤは彼に答えた。「そうだ。行って、エリヤがここにいると、あなたの主人に言いなさい。」","tok":[["エリヤ"],["は"],["彼","かれ"],["に"],["答えた","こたえた"],["。"],["「"],["そう"],["だ"],["。"],["行って","いって"],["、"],["エリヤ"],["が"],["ここ"],["に"],["いる"],["と"],["、"],["あなた"],["の"],["主人","しゅじん"],["に"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":9,"text":"すると、オバデヤが言った。「私がどんな罪を犯したというので、あなたはこのしもべをアハブの手に渡し、私を殺そうとされるのですか。","tok":[["する"],["と"],["、"],["オバデヤ"],["が"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["どんな"],["罪","つみ"],["を"],["犯した","おかした"],["と"],["いう"],["ので"],["、"],["あなた"],["は"],["この"],["しもべ"],["を"],["アハブ"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["私","わたくし"],["を"],["殺そう","ころそう"],["と"],["される"],["の"],["です"],["か"],["。"]]},{"verse":10,"text":"あなたの神、主は生きておられます。私の主人があなたを捜すために、人をやらなかった民や王国は一つもありません。彼らがあなたはいないと言うと、主人はその王国や民に、あなたが見つからないという誓いをさせるのです。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["生きて","いきて"],["おられます"],["。"],["私","わたくし"],["の"],["主人","しゅじん"],["が"],["あなた"],["を"],["捜す","さがす"],["ため"],["に"],["、"],["人","ひと"],["を"],["やらなかった"],["民","たみ"],["や"],["王国","おうこく"],["は"],["一","ひと"],["つ"],["も"],["ありません"],["。"],["彼","かれ"],["ら"],["が"],["あなた"],["は"],["いない"],["と"],["言う","ゆう"],["と"],["、"],["主人","しゅじん"],["は"],["その"],["王国","おうこく"],["や"],["民","たみ"],["に"],["、"],["あなた"],["が"],["見つからない","みつからない"],["と"],["いう"],["誓い","ちかい"],["を"],["させる"],["の"],["です"],["。"]]},{"verse":11,"text":"今、あなたは『行って、エリヤがここにいると、あなたの主人に言え』と言われます。","tok":[["今","いま"],["、"],["あなた"],["は"],["『"],["行って","いって"],["、"],["エリヤ"],["が"],["ここ"],["に"],["いる"],["と"],["、"],["あなた"],["の"],["主人","しゅじん"],["に"],["言え","いえ"],["』"],["と"],["言われます","いわれます"],["。"]]},{"verse":12,"text":"私があなたから離れて行っている間に、主の霊はあなたを私の知らない所に連れて行くでしょう。私はアハブに知らせに行きますが、彼があなたを見つけることができないなら、彼は私を殺すでしょう。しもべは子どものころから主を恐れています。","tok":[["私","わたくし"],["が"],["あなた"],["から"],["離れて","はなれて"],["行って","いって"],["いる"],["間","あいだ"],["に"],["、"],["主","ぬし"],["の"],["霊","れい"],["は"],["あなた"],["を"],["私","わたくし"],["の"],["知らない","しらない"],["所","ところ"],["に"],["連れて","つれて"],["行くでしょう","いくでしょう"],["。"],["私","わたくし"],["は"],["アハブ"],["に"],["知らせ","しらせ"],["に"],["行きます","いきます"],["が"],["、"],["彼","かれ"],["が"],["あなた"],["を"],["見つける","みつける"],["こと"],["が"],["できないなら"],["、"],["彼","かれ"],["は"],["私","わたくし"],["を"],["殺すでしょう","ころすでしょう"],["。"],["しもべ"],["は"],["子ども","こども"],["の"],["ころ"],["から"],["主","ぬし"],["を"],["恐れて","おそれて"],["います"],["。"]]},{"verse":13,"text":"あなたさまには、イゼベルが主の預言者たちを殺したとき、私のしたことが知らされていないのですか。私は主の預言者百人を五十人ずつほら穴に隠し、パンと水で彼らを養いました。","tok":[["あなた"],["さま"],["に"],["は"],["、"],["イゼベル"],["が"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["殺した","ころした"],["とき"],["、"],["私","わたくし"],["の"],["した"],["こと"],["が"],["知らされて","しらされて"],["いない"],["の"],["です"],["か"],["。"],["私","わたくし"],["は"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["百人","ひゃくにん"],["を"],["五","ご"],["十人","じゅうにん"],["ずつ"],["ほら穴","ほらあな"],["に"],["隠し","かくし"],["、"],["パン"],["と"],["水","みず"],["で"],["彼","かれ"],["ら"],["を"],["養いました","やしないました"],["。"]]},{"verse":14,"text":"今、あなたは『行って、エリヤがここにいると、あなたの主人に言え』と言われます。彼は私を殺すでしょう。」","tok":[["今","いま"],["、"],["あなた"],["は"],["『"],["行って","いって"],["、"],["エリヤ"],["が"],["ここ"],["に"],["いる"],["と"],["、"],["あなた"],["の"],["主人","しゅじん"],["に"],["言え","いえ"],["』"],["と"],["言われます","いわれます"],["。"],["彼","かれ"],["は"],["私","わたくし"],["を"],["殺すでしょう","ころすでしょう"],["。"],["」"]]},{"verse":15,"text":"するとエリヤは言った。「私が仕えている万軍の主は生きておられます。必ず私は、きょう、彼の前に出ましょう。」","tok":[["する"],["と"],["エリヤ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["仕えて","つかえて"],["いる"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["生きて","いきて"],["おられます"],["。"],["必ず","かならず"],["私","わたくし"],["は"],["、"],["きょう"],["、"],["彼","かれ"],["の"],["前","まえ"],["に"],["出ましょう","でましょう"],["。"],["」"]]},{"verse":16,"text":"そこで、オバデヤは行ってアハブに会い、彼に告げたので、アハブはエリヤに会うためにやって来た。","tok":[["そこ"],["で"],["、"],["オバデヤ"],["は"],["行って","いって"],["アハブ"],["に"],["会い","あい"],["、"],["彼","かれ"],["に"],["告げた","つげた"],["ので"],["、"],["アハブ"],["は"],["エリヤ"],["に"],["会う","あう"],["ため"],["に"],["やって"],["来た","きた"],["。"]]},{"verse":17,"text":"アハブがエリヤを見るや、アハブは彼に言った。「これはおまえか。イスラエルを煩わすもの。」","tok":[["アハブ"],["が"],["エリヤ"],["を"],["見る","みる"],["や"],["、"],["アハブ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["これ"],["は"],["おまえ"],["か"],["。"],["イスラエル"],["を"],["煩わす","わずらわす"],["もの"],["。"],["」"]]},{"verse":18,"text":"エリヤは言った。「私はイスラエルを煩わしません。あなたとあなたの父の家こそそうです。現にあなたがたは主の命令を捨て、あなたはバアルのあとについています。","tok":[["エリヤ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["イスラエル"],["を"],["煩わしません","わずらわしません"],["。"],["あなた"],["と"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["こそ"],["そう"],["です"],["。"],["現に","げんに"],["あなた"],["がた"],["は"],["主","ぬし"],["の"],["命令","めいれい"],["を"],["捨て","すて"],["、"],["あなた"],["は"],["バアル"],["の"],["あと"],["について"],["います"],["。"]]},{"verse":19,"text":"さあ、今、人をやって、カルメル山の私のところに、全イスラエルと、イゼベルの食卓につく四百五十人のバアルの預言者と、四百人のアシェラの預言者とを集めなさい。」","tok":[["さあ"],["、"],["今","いま"],["、"],["人","ひと"],["を"],["やって"],["、"],["カルメル"],["山","さん"],["の"],["私","わたくし"],["の"],["ところ"],["に"],["、"],["全","ぜん"],["イスラエル"],["と"],["、"],["イゼベル"],["の"],["食卓","しょくたく"],["に"],["つく"],["四百五","よんひゃくご"],["十人","じゅうにん"],["の"],["バアル"],["の"],["預言者","よげんしゃ"],["と"],["、"],["四百人","よんひゃくにん"],["の"],["アシェラ"],["の"],["預言者","よげんしゃ"],["と"],["を"],["集め","あつめ"],["なさい"],["。"],["」"]]},{"verse":20,"text":"そこで、アハブはイスラエルのすべての人に使いをやり、預言者たちをカルメル山に集めた。","tok":[["そこ"],["で"],["、"],["アハブ"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["に"],["使い","つかい"],["を"],["やり"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["カルメル"],["山","さん"],["に"],["集めた","あつめた"],["。"]]},{"verse":21,"text":"エリヤはみなの前に進み出て言った。「あなたがたは、いつまでどっちつかずによろめいているのか。もし、主が神であれば、それに従い、もし、バアルが神であれば、それに従え。」しかし、民は一言も彼に答えなかった。","tok":[["エリヤ"],["は"],["みな"],["の"],["前","まえ"],["に"],["進み出て","すすみでて"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["いつ"],["まで"],["どっち"],["つかず"],["に"],["よろめいて"],["いる"],["の"],["か"],["。"],["もし"],["、"],["主","ぬし"],["が"],["神","かみ"],["で"],["あれば"],["、"],["それ"],["に"],["従い","したがい"],["、"],["もし"],["、"],["バアル"],["が"],["神","かみ"],["で"],["あれば"],["、"],["それ"],["に"],["従え","したがえ"],["。"],["」"],["しかし"],["、"],["民","みん"],["は"],["一言","ひとこと"],["も"],["彼","かれ"],["に"],["答えなかった","こたえなかった"],["。"]]},{"verse":22,"text":"そこで、エリヤは民に向かって言った。「私ひとりが主の預言者として残っている。しかし、バアルの預言者は四百五十人だ。","tok":[["そこ"],["で"],["、"],["エリヤ"],["は"],["民","みん"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["私","わたくし"],["ひとり"],["が"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["として"],["残って","のこって"],["いる"],["。"],["しかし"],["、"],["バアル"],["の"],["預言者","よげんしゃ"],["は"],["四百五","よんひゃくご"],["十人","じゅうにん"],["だ"],["。"]]},{"verse":23,"text":"彼らは、私たちのために、二頭の雄牛を用意せよ。彼らは自分たちで一頭の雄牛を選び、それを切り裂き、たきぎの上に載せよ。彼らは火をつけてはならない。私は、もう一頭の雄牛を同じようにして、たきぎの上に載せ、火をつけないでおく。","tok":[["彼","かれ"],["ら"],["は"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["、"],["二頭","にとう"],["の"],["雄牛","おうし"],["を"],["用意","ようい"],["せよ"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["で"],["一頭","いちとう"],["の"],["雄牛","おうし"],["を"],["選び","えらび"],["、"],["それ"],["を"],["切り裂き","きりさき"],["、"],["たきぎ"],["の"],["上","うえ"],["に"],["載せ","のせ"],["よ"],["。"],["彼","かれ"],["ら"],["は"],["火","ひ"],["を"],["つけて"],["は"],["ならない"],["。"],["私","わたくし"],["は"],["、"],["もう"],["一頭","いちとう"],["の"],["雄牛","おうし"],["を"],["同じ","おなじ"],["よう"],["に"],["して"],["、"],["たきぎ"],["の"],["上","うえ"],["に"],["載せ","のせ"],["、"],["火","ひ"],["を"],["つけないで"],["おく"],["。"]]},{"verse":24,"text":"あなたがたは自分たちの神の名を呼べ。私は主の名を呼ぼう。そのとき、火をもって答える神、その方が神である。」民はみな答えて、「それがよい」と言った。","tok":[["あなた"],["がた"],["は"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["の"],["名","な"],["を"],["呼べ","よべ"],["。"],["私","わたくし"],["は"],["主","ぬし"],["の"],["名","な"],["を"],["呼ぼう","よぼう"],["。"],["その"],["とき"],["、"],["火","ひ"],["を"],["もって"],["答える","こたえる"],["神","かみ"],["、"],["その"],["方","ほう"],["が"],["神","か
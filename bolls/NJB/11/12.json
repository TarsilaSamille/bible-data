,["全","ぜん"],["イスラエル"],["は"],["、"],["彼","かれ"],["を"],["石","いし"],["で"],["打ち殺した","うちころした"],["。"],["それ"],["で"],["、"],["レハブアム"],["王","おう"],["は"],["、"],["ようやく"],["の"],["思い","おもい"],["で"],["戦車","せんしゃ"],["に"],["乗り込み","のりこみ"],["、"],["エルサレム"],["に"],["逃げた","にげた"],["。"]]},{"verse":19,"text":"このようにして、イスラエルはダビデの家にそむいた。今日もそうである。","tok":[["この"],["よう"],["に"],["して"],["、"],["イスラエル"],["は"],["ダビデ"],["の"],["家","いえ"],["に"],["そむいた"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":20,"text":"全イスラエルは、ヤロブアムが戻って来たことを聞き、人をやって彼を会衆のところに招き、彼を全イスラエルの王とした。ユダの部族以外には、ダビデの家に従うものはなかった。","tok":[["全","ぜん"],["イスラエル"],["は"],["、"],["ヤロブアム"],["が"],["戻って","もどって"],["来た","きた"],["こと"],["を"],["聞き","きき"],["、"],["人","ひと"],["を"],["やって"],["彼","かれ"],["を"],["会衆","かいしゅう"],["の"],["ところ"],["に"],["招き","まねき"],["、"],["彼","かれ"],["を"],["全","ぜん"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["。"],["ユダ"],["の"],["部族","ぶぞく"],["以外","いがい"],["に"],["は"],["、"],["ダビデ"],["の"],["家","いえ"],["に"],["従う","したがう"],["もの"],["は"],["なかった"],["。"]]},{"verse":21,"text":"レハブアムはエルサレムに帰り、ユダの全家とベニヤミンの部族から選抜戦闘員十八万を召集し、王位をソロモンの子レハブアムのもとに取り戻すため、イスラエルの家と戦おうとした。","tok":[["レハブアム"],["は"],["エルサレム"],["に"],["帰り","かえり"],["、"],["ユダ"],["の"],["全家","ぜんか"],["と"],["ベニヤミン"],["の"],["部族","ぶぞく"],["から"],["選抜","せんばつ"],["戦闘員","せんとういん"],["十八万","じゅうはちまん"],["を"],["召集","しょうしゅう"],["し"],["、"],["王位","おうい"],["を"],["ソロモン"],["の"],["子","こ"],["レハブアム"],["の"],["もと"],["に"],["取り戻す","とりもどす"],["ため"],["、"],["イスラエル"],["の"],["家","いえ"],["と"],["戦おう","たたかおう"],["と"],["した"],["。"]]},{"verse":22,"text":"すると、神の人シェマヤに次のような神のことばがあった。","tok":[["する"],["と"],["、"],["神","かみ"],["の"],["人","ひと"],["シェマヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["神","かみ"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":23,"text":"「ユダの王、ソロモンの子レハブアム、ユダとベニヤミンの全家、および、そのほかの民に告げて言え。","tok":[["「"],["ユダ"],["の"],["王","おう"],["、"],["ソロモン"],["の"],["子","こ"],["レハブアム"],["、"],["ユダ"],["と"],["ベニヤミン"],["の"],["全家","ぜんか"],["、"],["および"],["、"],["その"],["ほか"],["の"],["民","たみ"],["に"],["告げて","つげて"],["言え","いえ"],["。"]]},{"verse":24,"text":"『主はこう仰せられる。上って行ってはならない。あなたがたの兄弟であるイスラエル人と戦ってはならない。おのおの自分の家に帰れ。わたしがこうなるようにしむけたのだから。』」そこで、彼らは主のことばに聞き従い、主のことばのとおりに帰って行った。","tok":[["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["上って","のぼって"],["行って","いって"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["イスラエル"],["人","にん"],["と"],["戦って","たたかって"],["は"],["ならない"],["。"],["おのおの"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰れ","かえれ"],["。"],["わたし"],["が"],["こう"],["なる"],["よう"],["に"],["しむけた"],["の"],["だ"],["から"],["。"],["』"],["」"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["ことば"],["に"],["聞き従い","ききしたがい"],["、"],["主","ぬし"],["の"],["ことば"],["の"],["とおり"],["に"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":25,"text":"ヤロブアムはエフライムの山地にシェケムを再建し、そこに住んだ。さらに、彼はそこから出て、ペヌエルを再建した。","tok":[["ヤロブアム"],["は"],["エフライム"],["の"],["山地","さんち"],["に"],["シェケム"],["を"],["再建","さいけん"],["し"],["、"],["そこ"],["に"],["住んだ","すんだ"],["。"],["さらに"],["、"],["彼","かれ"],["は"],["そこ"],["から"],["出て","でて"],["、"],["ペヌエル"],["を"],["再建","さいけん"],["した"],["。"]]},{"verse":26,"text":"ヤロブアムは心に思った。「今のままなら、この王国はダビデの家に戻るだろう。","tok":[["ヤロブアム"],["は"],["心","こころ"],["に"],["思った","おもった"],["。"],["「"],["今","いま"],["の"],["まま"],["なら"],["、"],["この"],["王国","おうこく"],["は"],["ダビデ"],["の"],["家","いえ"],["に"],["戻るだろう","もどるだろう"],["。"]]},{"verse":27,"text":"この民が、エルサレムにある主の宮でいけにえをささげるために上って行くことになっていれば、この民の心は、彼らの主君、ユダの王レハブアムに再び帰り、私を殺し、ユダの王レハブアムのもとに帰るだろう。」","tok":[["この"],["民","たみ"],["が"],["、"],["エルサレム"],["に"],["ある"],["主","ぬし"],["の"],["宮","みや"],["で"],["いけにえ"],["を"],["ささげる"],["ため"],["に"],["上って","のぼって"],["行く","いく"],["こと"],["に"],["なって"],["いれば"],["、"],["この"],["民","たみ"],["の"],["心","こころ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["主君","しゅくん"],["、"],["ユダ"],["の"],["王","おう"],["レハブアム"],["に"],["再び","ふたたび"],["帰り","かえり"],["、"],["私","わたくし"],["を"],["殺し","ころし"],["、"],["ユダ"],["の"],["王","おう"],["レハブアム"],["の"],["もと"],["に"],["帰るだろう","かえるだろう"],["。"],["」"]]},{"verse":28,"text":"そこで、王は相談して、金の子牛を二つ造り、彼らに言った。「もう、エルサレムに上る必要はない。イスラエルよ。ここに、あなたをエジプトから連れ上ったあなたの神々がおられる。」","tok":[["そこ"],["で"],["、"],["王","おう"],["は"],["相談","そうだん"],["して"],["、"],["金","きん"],["の"],["子牛","こうし"],["を"],["二","ふた"],["つ"],["造り","つくり"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["もう"],["、"],["エルサレム"],["に"],["上る","のぼる"],["必要","ひつよう"],["は"],["ない"],["。"],["イスラエル"],["よ"],["。"],["ここ"],["に"],["、"],["あなた"],["を"],["エジプト"],["から"],["連れ上った","つれのぼった"],["あなた"],["の"],["神々","かみがみ"],["が"],["おられる"],["。"],["」"]]},{"verse":29,"text":"それから、彼は一つをベテルに据え、一つをダンに安置した。","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["一","ひと"],["つ"],["を"],["ベテル"],["に"],["据え","すえ"],["、"],["一","ひと"],["つ"],["を"],["ダン"],["に"],["安置","あんち"],["した"],["。"]]},{"verse":30,"text":"このことは罪となった。民はこの一つを礼拝するためダンにまで行った。","tok":[["この"],["こと"],["は"],["罪","つみ"],["と"],["なった"],["。"],["民","たみ"],["は"],["この"],["一","ひと"],["つ"],["を"],["礼拝","れいはい"],["する"],["ため"],["ダン"],["に"],["まで"],["行った","いった"],["。"]]},{"verse":31,"text":"それから、彼は高き所の宮を建て、レビの子孫でない一般の民の中から祭司を任命した。","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["高き","たかき"],["所","ところ"],["の"],["宮","みや"],["を"],["建て","たて"],["、"],["レビ"],["の"],["子孫","しそん"],["で"],["ない"],["一般","いっぱん"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["祭司","さいし"],["を"],["任命","にんめい"],["した"],["。"]]},{"verse":32,"text":"そのうえ、ヤロブアムはユダでの祭りにならって、祭りの日を第八の月の十五日と定め、祭壇でいけにえをささげた。こうして彼は、ベテルで自分が造った子牛にいけにえをささげた。また、彼が任命した高き所の祭司たちをベテルに常住させた。","tok":[["その"],["うえ"],["、"],["ヤロブアム"],["は"],["ユダ"],["で"],["の"],["祭り","まつり"],["に"],["ならって"],["、"],["祭り","まつり"],["の"],["日","ひ"],["を"],["第","だい"],["八","はち"],["の"],["月","つき"],["の"],["十五","じゅうご"],["日","にち"],["と"],["定め","さだめ"],["、"],["祭壇","さいだん"],["で"],["いけにえ"],["を"],["ささげた"],["。"],["こう"],["して"],["彼","かれ"],["は"],["、"],["ベテル"],["で"],["自分","じぶん"],["が"],["造った","つくった"],["子牛","こうし"],["に"],["いけにえ"],["を"],["ささげた"],["。"],["また"],["、"],["彼","かれ"],["が"],["任命","にんめい"],["した"],["高き","たかき"],["所","ところ"],["の"],["祭司","さいし"],["たち"],["を"],["ベテル"],["に"],["常住","じょうじゅう"],["させた"],["。"]]},{"verse":33,"text":"彼は自分で勝手に考え出した月である第八の月の十五日に、ベテルに造った祭壇でいけにえをささげ、イスラエル人のために祭りの日を定め、祭壇でいけにえをささげ、香をたいた。","tok":[["彼","かれ"],["は"],["自分","じぶん"],["で"],["勝手に","かってに"],["考え出した","かんがえだした"],["月","つき"],["で"],["ある"],["第","だ
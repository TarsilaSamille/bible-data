[{"verse":1,"text":"アラムとイスラエルとの間には戦いがないまま三年が過ぎた。","tok":[["アラム"],["と"],["イスラエル"],["と"],["の"],["間","あいだ"],["に"],["は"],["戦い","たたかい"],["が"],["ない"],["まま"],["三","さん"],["年","ねん"],["が"],["過ぎた","すぎた"],["。"]]},{"verse":2,"text":"しかし、三年目になって、ユダの王ヨシャパテがイスラエルの王のところに下って来ると、","tok":[["しかし"],["、"],["三","さん"],["年目","ねんめ"],["に"],["なって"],["、"],["ユダ"],["の"],["王","おう"],["ヨシャパテ"],["が"],["イスラエル"],["の"],["王","おう"],["の"],["ところ"],["に"],["下って","くだって"],["来る","くる"],["と"],["、"]]},{"verse":3,"text":"イスラエルの王は自分の家来たちに言った。「あなたがたは、ラモテ・ギルアデが私たちのものであることを知っているではないか。それなのに、私たちはためらっていて、それをアラムの王の手から奪い返していない。」","tok":[["イスラエル"],["の"],["王","おう"],["は"],["自分","じぶん"],["の"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["ラモテ"],["・"],["ギルアデ"],["が"],["私たち","わたしたち"],["の"],["もの"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いるで"],["は"],["ない"],["か"],["。"],["それ"],["な"],["のに"],["、"],["私たち","わたしたち"],["は"],["ためらって"],["いて"],["、"],["それ"],["を"],["アラム"],["の"],["王","おう"],["の"],["手","て"],["から"],["奪い返して","うばいかえして"],["いない"],["。"],["」"]]},{"verse":4,"text":"それから、彼はヨシャパテに言った。「私といっしょにラモテ・ギルアデに戦いに行ってくれませんか。」ヨシャパテはイスラエルの王に言った。「私とあなたとは同じようなもの、私の民とあなたの民、私の馬とあなたの馬も同じようなものです。」","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["ヨシャパテ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["と"],["いっしょ"],["に"],["ラモテ"],["・"],["ギルアデ"],["に"],["戦い","たたかい"],["に"],["行って","いって"],["くれません"],["か"],["。"],["」"],["ヨシャパテ"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["と"],["あなた"],["と"],["は"],["同じ","おなじ"],["よう"],["な"],["もの"],["、"],["私","わたくし"],["の"],["民","たみ"],["と"],["あなた"],["の"],["民","たみ"],["、"],["私","わたくし"],["の"],["馬","うま"],["と"],["あなた"],["の"],["馬","うま"],["も"],["同じ","おなじ"],["よう"],["な"],["もの"],["です"],["。"],["」"]]},{"verse":5,"text":"ヨシャパテは、イスラエルの王に言った。「まず、主のことばを伺ってみてください。」","tok":[["ヨシャパテ"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["まず"],["、"],["主","ぬし"],["の"],["ことば"],["を"],["伺って","うかがって"],["みて"],["ください"],["。"],["」"]]},{"verse":6,"text":"そこで、イスラエルの王は約四百人の預言者を召し集めて、彼らに尋ねた。「私はラモテ・ギルアデに戦いに行くべきだろうか。それとも、やめるべきだろうか。」彼らは答えた。「上って行きなさい。そうすれば、主は王の手にこれを渡されます。」","tok":[["そこ"],["で"],["、"],["イスラエル"],["の"],["王","おう"],["は"],["約","やく"],["四百人","よんひゃくにん"],["の"],["預言者","よげんしゃ"],["を"],["召し集めて","めしあつめて"],["、"],["彼","かれ"],["ら"],["に"],["尋ねた","たずねた"],["。"],["「"],["私","わたくし"],["は"],["ラモテ"],["・"],["ギルアデ"],["に"],["戦い","たたかい"],["に"],["行くべきだろう","いくべきだろう"],["か"],["。"],["それ"],["と"],["も"],["、"],["やめるべきだろう"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["上って","のぼって"],["行き","いき"],["なさい"],["。"],["そう"],["すれば"],["、"],["主","ぬし"],["は"],["王","おう"],["の"],["手","て"],["に"],["これ"],["を"],["渡されます","わたされます"],["。"],["」"]]},{"verse":7,"text":"ところが、ヨシャパテは、「ここには、私たちがみこころを求めることのできる主の預言者がほかにいないのですか」と言った。","tok":[["ところ"],["が"],["、"],["ヨシャパテ"],["は"],["、"],["「"],["ここ"],["に"],["は"],["、"],["私たち","わたしたち"],["が"],["みこころ"],["を"],["求める","もとめる"],["こと"],["の"],["できる"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["が"],["ほか"],["に"],["いない"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"イスラエルの王はヨシャパテに答えた。「いや、ほかにもうひとり、私たちが主のみこころを求めることのできる者がいます。しかし、私は彼を憎んでいます。彼は私について良いことは預言せず、悪いことばかりを預言するからです。それは、イムラの子ミカヤです。」すると、ヨシャパテは言った。「王よ。そういうふうには言わないでください。」","tok":[["イスラエル"],["の"],["王","おう"],["は"],["ヨシャパテ"],["に"],["答えた","こたえた"],["。"],["「"],["いや"],["、"],["ほか"],["に"],["もう"],["ひとり"],["、"],["私たち","わたしたち"],["が"],["主","ぬし"],["のみ"],["こころ"],["を"],["求める","もとめる"],["こと"],["の"],["できる"],["者","もの"],["が"],["います"],["。"],["しかし"],["、"],["私","わたくし"],["は"],["彼","かれ"],["を"],["憎んで","にくんで"],["います"],["。"],["彼","かれ"],["は"],["私","わたくし"],["について"],["良い","よい"],["こと"],["は"],["預言","よげん"],["せず"],["、"],["悪い","わるい"],["こと"],["ばかり"],["を"],["預言","よげん"],["する"],["から"],["です"],["。"],["それ"],["は"],["、"],["イムラ"],["の"],["子","こ"],["ミカヤ"],["です"],["。"],["」"],["する"],["と"],["、"],["ヨシャパテ"],["は"],["言った","いった"],["。"],["「"],["王","おう"],["よ"],["。"],["そう"],["いう"],["ふう"],["に"],["は"],["言わないで","いわないで"],["ください"],["。"],["」"]]},{"verse":9,"text":"そこで、イスラエルの王はひとりの宦官を呼び寄せ、「急いで、イムラの子ミカヤを呼んで来なさい」と命じた。","tok":[["そこ"],["で"],["、"],["イスラエル"],["の"],["王
[{"verse":1,"text":"ギルアデのティシュベの出のティシュベ人エリヤはアハブに言った。「私の仕えているイスラエルの神、主は生きておられる。私のことばによらなければ、ここ二、三年の間は露も雨も降らないであろう。」","tok":[["ギルアデ"],["の"],["ティシュベ"],["の"],["出","で"],["の"],["ティシュベ"],["人","にん"],["エリヤ"],["は"],["アハブ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["仕えて","つかえて"],["いる"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["私","わたくし"],["の"],["ことば"],["に"],["よらなければ"],["、"],["ここ"],["二","に"],["、"],["三","さん"],["年","ねん"],["の"],["間","あいだ"],["は"],["露","ろ"],["も"],["雨","あめ"],["も"],["降らないで","ふらないで"],["あろう"],["。"],["」"]]},{"verse":2,"text":"それから、彼に次のような主のことばがあった。","tok":[["それ"],["から"],["、"],["彼","かれ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":3,"text":"「ここを去って東へ向かい、ヨルダン川の東にあるケリテ川のほとりに身を隠せ。","tok":[["「"],["ここ"],["を"],["去って","さって"],["東","ひがし"],["へ"],["向かい","むかい"],["、"],["ヨルダン"],["川","かわ"],["の"],["東","ひがし"],["に"],["ある"],["ケリテ"],["川","かわ"],["の"],["ほとり"],["に"],["身","み"],["を"],["隠せ","かくせ"],["。"]]},{"verse":4,"text":"そして、その川の水を飲まなければならない。わたしは烏に、そこであなたを養うように命じた。」","tok":[["そして"],["、"],["その"],["川","かわ"],["の"],["水","みず"],["を"],["飲まなければ","のまなければ"],["ならない"],["。"],["わたし"],["は"],["烏","からす"],["に"],["、"],["そこ"],["で"],["あなた"],["を"],["養う","やしなう"],["よう"],["に"],["命じた","めいじた"],["。"],["」"]]},{"verse":5,"text":"それで、彼は行って、主のことばのとおりにした。すなわち、彼はヨルダン川の東にあるケリテ川のほとりに行って住んだ。","tok":[["それ"],["で"],["、"],["彼","かれ"],["は"],["行って","いって"],["、"],["主","ぬし"],["の"],["ことば"],["の"],["とおり"],["に"],["した"],["。"],["すなわち"],["、"],["彼","かれ"],["は"],["ヨルダン"],["川","かわ"],["の"],["東","ひがし"],["に"],["ある"],["ケリテ"],["川","かわ"],["の"],["ほとり"],["に"],["行って","いって"],["住んだ","すんだ"],["。"]]},{"verse":6,"text":"幾羽かの烏が、朝になると彼のところにパンと肉とを運んで来、また、夕方になるとパンと肉とを運んで来た。彼はその川から水を飲んだ。","tok":[["幾羽","いくわ"],["か"],["の"],["烏","からす"],["が"],["、"],["朝","あさ"],["に"],["なる"],["と"],["彼","かれ"],["の"],["ところ"],["に"],["パン"],["と"],["肉","にく"],["と"],["を"],["運んで","はこんで"],["来","き"],["、"],["また"],["、"],["夕方","ゆうがた"],["に"],["なる"],["と"],["パン"],["と"],["肉","にく"],["と"],["を"],["運んで","はこんで"],["来た","きた"],["。"],["彼","かれ"],["は"],["その"],["川","かわ"],["から"],["水","みず"],["を"],["飲んだ","のんだ"],["。"]]},{"verse":7,"text":"しかし、しばらくすると、その川がかれた。その地方に雨が降らなかったからである。","tok":[["しかし"],["、"],["しばらく"],["する"],["と"],["、"],["その"],["川","かわ"],["が"],["かれた"],["。"],["その"],["地方","ちほう"],["に"],["雨","あめ"],["が"],["降らなかった","ふらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"すると、彼に次のような主のことばがあった。","tok":[["する"],["と"],["、"],["彼","かれ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":9,"text":"「さあ、シドンのツァレファテに行き、そこに住め。見よ。わたしは、そこのひとりのやもめに命じて、あなたを養うようにしている。」","tok":[["「"],["さあ"],["、"],["シドン"],["の"],["ツァレファテ"],["に"],["行き","いき"],["、"],["そこ"],["に"],["住め","すめ"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["、"],["そこ"],["の"],["ひとり"],["の"],["やもめ"],["に"],["命じて","めいじて"],["、"],["あなた"],["を"],["養う","やしなう"],["よう"],["に"],["して"],["いる"],["。"],["」"]]},{"verse":10,"text":"彼はツァレファテへ出て行った。その町の門に着くと、ちょうどそこに、たきぎを拾い集めているひとりのやもめがいた。そこで、彼は彼女に声をかけて言った。「水差しにほんの少しの水を持って来て、私に飲ませてください。」","tok":[["彼","かれ"],["は"],["ツァレファテ"],["へ"],["出て","でて"],["行った","いった"],["。"],["その"],["町","まち"],["の"],["門","もん"],["に"],["着く","つく"],["と"],["、"],["ちょうど"],["そこ"],["に"],["、"],["たきぎ"],["を"],["拾い集めて","ひろいあつめて"],["いる"],["ひとり"],["の"],["やもめ"],["が"],["いた"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["は"],["彼女","かのじょ"],["に"],["声","こえ"],["を"],["かけて"],["言った","いった"],["。"],["「"],["水差し","みずさし"],["に"],["ほんの"],["少し","すこし"],["の"],["水","みず"],["を"],["持って","もって"],["来て","きて"],["、"],["私","わたくし"],["に"],["飲ませて","のませて"],["ください"],["。"],["」"]]},{"verse":11,"text":"彼女が取りに行こうとすると、彼は彼女を呼んで言った。「一口のパンも持って来てください。」","tok":[["彼女","かのじょ"],["が"],["取り","とり"],["に"],["行こう","いこう"],["と"],["する"],["と"],["、"],["彼","かれ"],["は"],["彼女","かのじょ"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["一口","ひとくち"],["の"],["パン"],["も"],["持って","もって"],["来て","きて"],["ください"],["。"],["」"]]},{"verse":12,"text":"彼女は答えた。「あなたの神、主は生きておられます。私は焼いたパンを持っておりません。ただ、かめの中に一握りの粉と、つぼにほんの少しの油があるだけです。ご覧のとおり、二、三本のたきぎを集め、帰って行って、私と私の息子のためにそれを調理し、それを食べて、死のうとしているのです。」","tok":[["彼女","かのじょ"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["生きて","いきて"],["おられます"],["。"],["私","わたくし"],["は"],["焼いた","やいた"],["パン"],["を"],["持って","もって"],["おりません"],["。"],["ただ"],["、"],["かめ"],["の"],["中","なか"],["に"],["一握り","ひとにぎり"],["の"],["粉","こな"],["と"],["、"],["つぼ"],["に"],["ほんの"],["少し","すこし"],["の"],["油","あぶら"],["が"],["ある"],["だけ"],["です"],["。"],["ご覧","ごらん"],["の"],["とおり"],["、"],["二","に"],["、"],["三本","さんぽん"],["の"],["たきぎ"],["を"],["集め","あつめ"],["、"],["帰って","かえって"],["行って","いって"],["、"],["私","わたくし"],["と"],["私","わたくし"],["の"],["息子","むすこ"],["の"],["ため"],["に"],["それ"],["を"],["調理","ちょうり"],["し"],["、"],["それ"],["を"],["食べて","たべて"],["、"],["死のう","しのう"],["として"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"エリヤは彼女に言った。「恐れてはいけません。行って、あなたが言ったようにしなさい。しかし、まず、私のためにそれで小さなパン菓子を作り、私のところに持って来なさい。それから後に、あなたとあなたの子どものために作りなさい。","tok":[["エリヤ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["。"],["「"],["恐れて","おそれて"],["は"],["いけません"],["。"],["行って","いって"],["、"],["あなた"],["が"],["言った","いった"],["よう"],["に"],["し"],["なさい"],["。"],["しかし"],["、"],["まず"],["、"],["私","わたくし"],["の"],["ため"],["に"],["それ"],["で"],["小さな","ちいさな"],["パン"],["菓子","かし"],["を"],["作り","つくり"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["それ"],["から"],["後","あと"],["に"],["、"],["あなた"],["と"],["あなた"],["の"],["子ども","こども"],["の"],["ため"],["に"],["作り","つくり"],["なさい"],["。"]]},{"verse":14,"text":"イスラエルの神、主が、こう仰せられるからです。『主が地の上に雨を降らせる日までは、そのかめの粉は尽きず、そのつぼの油はなくならない。』」","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["こう"],["仰せられる","おおせられる"],["から"],["です"],["。"],["『"],["主","ぬし"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["雨","あめ"],["を"],["降らせる","ふらせる"],["日","ひ"],["まで"],["は"],["、"],["その"],["かめ"],["の"],["粉","こな"],["は"],["尽きず","つきず"],["、"],["その"],["つぼ"],["の"],["油","あぶら"],["は"],["なくならない"],["。"],["』"],["」"]]},{"verse":15,"text":"彼女は行って、エリヤのことばのとおりにした。彼女と彼、および彼女の家族も、長い間それを食べた。","tok":[["彼女","かのじょ"],["は"],["行って","いって"],["、"],["エリヤ"],["の"],["ことば"],["の"],["とおり"],["に"],["した"],["。"],["彼女","かのじょ"],["と"],["彼","かれ"],["、"],["および"],["彼女","かのじょ"],["の"],["家族","かぞく"],["も"],["、"],["長い","ながい"],["間","あいだ"],["それ"],["を"],["食べた","たべた"],["。"]]},{"verse":16,"text":"エリヤを通して言われた主のことばのとおり、かめの粉は尽きず、つぼの油はなくならなかった。","tok":[["エリヤ"],["を"],["通して","とおして"],["言われた","いわれた"],["主","ぬし"],["の"],["ことば"],["の"],["とおり"],["、"],["かめ"],["の"],["粉","こな"],["は"],["尽きず","つきず"],["、"],["つぼ"],["の"],["油","あぶら"],["は"],["なくならなかった"],["。"]]},{"verse":17,"text":"これらのことがあって後、この家の主婦の息子が病気になった。その子の病気は非常に重くなり、ついに息を引き取った。","tok":[["これ"],["ら"],["の"],["こと"],["が"],["あって"],["後","あと"],["、"],["この"],["家","いえ"],["の"],["主婦","しゅふ"],["の"],["息子","むすこ"],["が"],["病気","びょうき"],["に"],["なった"],["。"],["その"],["子","こ"],["の"],["病気","びょうき"],["は"],["非常","ひじょう"],["に"],["重く","おもく"],["なり"],["、"],["ついに"],["息","いき"],["を"],["引き取った","ひきとった"],["。"]]},{"verse":18,"text":"彼女はエリヤに言った。「神の人よ。あなたはいったい私にどうしようとなさるのですか。あなたは私の罪を思い知らせ、私の息子を死なせるために来られたのですか。」","tok":[["彼女","かのじょ"],["は"],["エリヤ"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["の"],["人","ひと"],["よ"],["。"],["あなた"],["は"],["いったい"],["私","わたくし"],["に"],["どう"],["しよう"],["と"],["なさる"],["の"],["です"],["か"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["罪","つみ"],["を"],["思い知らせ","おもいしらせ"],["、"],["私","わたくし"],["の"],["息子","むすこ"],["を"],["死なせる","しなせる"],["ため"],["に"],["来られた","こられた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":19,"text":"彼は彼女に、「あなたの息子を私によこしなさい」と言って、その子を彼女のふところから受け取り、彼が泊まっていた屋上の部屋にかかえて上がり、その子を自分の寝台の上に横たえた。","tok":[["彼","かれ"],["は"],["彼女","かのじょ"],["に"],["、"],["「"],["あなた"],["の"],["息子","むすこ"],["を"],["私","わたくし"],["に"],["よこし"],["なさい"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["彼女","かのじょ"],["の"],["ふところ"],["から"],["受け取り","うけとり"],["、"],["彼","かれ"],["が"],["泊まって","とまって"],["いた"],["屋上","おくじょう"],["の"],["部屋","へや"],["に"],["かかえて"],["上がり","あがり"],["、"],["その"],["子","こ"],["を"],["自分","じぶん"],["の"],["寝台","しんだい"],["の"],["上","うえ"],["に"],["横たえた","よこたえた"],["。"]]},{"verse":20,"text":"彼は主に祈って言った。「私の神、主よ。私を世話してくれたこのやもめにさえもわざわいを下して、彼女の息子を死なせるのですか。」","tok":[["彼","かれ"],["は"],["主に","おもに"],["祈って","いのって"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["私","わたく
[{"verse":1,"text":"ときに、シェバの女王が、主の名に関連してソロモンの名声を伝え聞き、難問をもって彼をためそうとして、やって来た。","tok":[["とき"],["に"],["、"],["シェバ"],["の"],["女王","じょおう"],["が"],["、"],["主","ぬし"],["の"],["名","な"],["に"],["関連","かんれん"],["して"],["ソロモン"],["の"],["名声","めいせい"],["を"],["伝え聞き","つたえきき"],["、"],["難問","なんもん"],["を"],["もって"],["彼","かれ"],["を"],["ためそう"],["として"],["、"],["やって"],["来た","きた"],["。"]]},{"verse":2,"text":"彼女は、非常に大ぜいの有力者たちを率い、らくだにバルサム油と、非常に多くの金および宝石を載せて、エルサレムにやって来た。彼女はソロモンのところに来ると、心にあったすべてのことを彼に質問した。","tok":[["彼女","かのじょ"],["は"],["、"],["非常","ひじょう"],["に"],["大ぜい","おおぜい"],["の"],["有力","ゆうりょく"],["者","しゃ"],["たち"],["を"],["率い","ひきい"],["、"],["らくだ"],["に"],["バルサム"],["油","あぶら"],["と"],["、"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["金","きん"],["および"],["宝石","ほうせき"],["を"],["載せて","のせて"],["、"],["エルサレム"],["に"],["やって"],["来た","きた"],["。"],["彼女","かのじょ"],["は"],["ソロモン"],["の"],["ところ"],["に"],["来る","くる"],["と"],["、"],["心","こころ"],["に"],["あった"],["すべて"],["の"],["こと"],["を"],["彼","かれ"],["に"],["質問","しつもん"],["した"],["。"]]},{"verse":3,"text":"ソロモンは、彼女のすべての質問を説き明かした。王がわからなくて、彼女に説き明かせなかったことは何一つなかった。","tok":[["ソロモン"],["は"],["、"],["彼女","かのじょ"],["の"],["すべて"],["の"],["質問","しつもん"],["を"],["説き明かした","ときあかした"],["。"],["王","おう"],["が"],["わからなくて"],["、"],["彼女","かのじょ"],["に"],["説き明かせなかった","ときあかせなかった"],["こと"],["は"],["何","なん"],["一","ひと"],["つ"],["なかった"],["。"]]},{"verse":4,"text":"シェバの女王は、ソロモンのすべての知恵と、彼が建てた宮殿と、","tok":[["シェバ"],["の"],["女王","じょおう"],["は"],["、"],["ソロモン"],["の"],["すべて"],["の"],["知恵","ちえ"],["と"],["、"],["彼","かれ"],["が"],["建てた","たてた"],["宮殿","きゅうでん"],["と"],["、"]]},{"verse":5,"text":"その食卓の料理、列席の家来たち従者たちが仕えている態度とその服装、彼の献酌官たち、および、彼が主の宮でささげた全焼のいけにえを見て、息も止まるばかりであった。","tok":[["その"],["食卓","しょくたく"],["の"],["料理","りょうり"],["、"],["列席","れっせき"],["の"],["家来","けらい"],["たち"],["従者","じゅうしゃ"],["たち"],["が"],["仕えて","つかえて"],["いる"],["態度","たいど"],["と"],["その"],["服装","ふくそう"],["、"],["彼","かれ"],["の"],["献","こん"],["酌官","しゃくかん"],["たち"],["、"],["および"],["、"],["彼","かれ"],["が"],["主","ぬし"],["の"],["宮","みや"],["で"],["ささげた"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["見て","みて"],["、"],["息","いき"],["も"],["止まる","とまる"],["ばかり"],["で"],["あった"],["。"]]},{"verse":6,"text":"彼女は王に言った。「私が国であなたの事績とあなたの知恵とについて聞き及んでおりましたことはほんとうでした。","tok":[["彼女","かのじょ"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["が"],["国","くに"],["で"],["あなた"],["の"],["事績","じせき"],["と"],["あなた"],["の"],["知恵","ちえ"],["と"],["について"],["聞き及んで","ききおよんで"],["おりました"],["こと"],["は"],["ほんとう"],["でした"],["。"]]},{"verse":7,"text":"実は、私は、自分で来て、自分の目で見るまでは、そのことを信じなかったのですが、驚いたことに、私にはその半分も知らされていなかったのです。あなたの知恵と繁栄は、私が聞いていたうわさよりはるかにまさっています。","tok":[["実","じつ"],["は"],["、"],["私","わたくし"],["は"],["、"],["自分","じぶん"],["で"],["来て","きて"],["、"],["自分","じぶん"],["の"],["目","め"],["で"],["見る","みる"],["まで"],["は"],["、"],["その"],["こと"],["を"],["信じなかった","しんじなかった"],["の"],["です"],["が"],["、"],["驚いた","おどろいた"],["こと"],["に"],["、"],["私","わたくし"],["に"],["は"],["その"],["半分","はんぶん"],["も"],["知らされて","しらされて"],["いなかった"],["の"],["です"],["。"],["あなた"],["の"],["知恵","ちえ"],["と"],["繁栄","はんえい"],["は"],["、"],["私","わたくし"],["が"],["聞いて","きいて"],["いた"],["うわさ"],["より"],["はるか"],["に"],["まさって"],["います"],["。"]]},{"verse":8,"text":"なんとしあわせなことでしょう。あなたにつく人たちは。なんとしあわせなことでしょう。いつもあなたの前に立って、あなたの知恵を聞くことのできる家来たちは。","tok":[["なん"],["と"],["しあわせ"],["な"],["こと"],["でしょう"],["。"],["あなた"],["に"],["つく"],["人","ひと"],["たち"],["は"],["。"],["なん"],["と"],["しあわせ"],["な"],["こと"],["でしょう"],["。"],["いつも"],["あなた"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["あなた"],["の"],["知恵","ちえ"],["を"],["聞く","きく"],["こと"],["の"],["できる"],["家来","けらい"],["たち"],["は"],["。"]]},{"verse":9,"text":"あなたを喜ばれ、イスラエルの王座にあなたを着かせられたあなたの神、主はほむべきかな。主はイスラエルをとこしえに愛しておられるので、あなたを王とし、公正と正義とを行わせられるのです。」","tok":[["あなた"],["を"],["喜ばれ","よろこばれ"],["、"],["イスラエル"],["の"],["王座","おうざ"],["に"],["あなた"],["を"],["着かせられた","つかせられた"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["ほ"],["むべき"],["か"],["な"],["。"],["主","ぬし"],["は"],["イスラエル"],["を"],["とこしえ"],["に"],["愛して","あいして"],["おられる"],["ので"],["、"],["あなた"],["を"],["王","おう"],["と"],["し"],["、"],["公正","こうせい"],["と"],["正義","まさよし"],["と"],["を"],["行わせられる","おこなわせられる"],["の"],["です"],["。"],["」"]]},{"verse":10,"text":"彼女は百二十タラントの金と、非常にたくさんのバルサム油と宝石とを王に贈った。シェバの女王がソロモン王に贈ったほどに多くのバルサム油は、二度と入って来なかった。","tok":[["彼女","かのじょ"],["は"],["百二十","ひゃくにじゅう"],["タラント"],["の"],["金","かね"],["と"],["、"],["非常","ひじょう"],["に"],["たくさん"],["の"],["バルサム"],["油","あぶら"],["と"],["宝石","ほうせき"],["と"],["を"],["王","おう"],["に"],["贈った","おくった"],["。"],["シェバ"],["の"],["女王","じょおう"],["が"],["ソロモン"],["王","おう"],["に"],["贈った","おくった"],["ほど"],["に"],["多く","おおく"],["の"],["バルサム"],["油","あぶら"],["は"],["、"],["二","に"],["度","ど"],["と"],["入って","はいって"],["来なかった","こなかった"],["。"]]},{"verse":11,"text":"オフィルから金を積んで来たヒラムの船団も、非常に多くのびゃくだんの木材と宝石とをオフィルから運んで来た。","tok":[["オフィル"],["から"],["金","かね"],["を"],["積んで","つんで"],["来た","きた"],["ヒラム"],["の"],["船団","せんだん"],["も"],["、"],["非常","ひじょう"],["に"],["多く","おおく"],["のび"],["ゃ"],["くだん"],["の"],["木材","もくざい"],["と"],["宝石","ほうせき"],["と"],["を"],["オフィル"],["から"],["運んで","はこんで"],["来た","きた"],["。"]]},{"verse":12,"text":"王はこのびゃくだんの木材で、主の宮と王宮の柱を造り、歌うたいたちのために、立琴と十弦の琴を作った。今日まで、このようなびゃくだんの木材が入って来たこともなく、だれもこのようなものを見たこともなかった。","tok":[["王","おう"],["は"],["この"],["び"],["ゃ"],["くだん"],["の"],["木材","もくざい"],["で"],["、"],["主","ぬし"],["の"],["宮","みや"],["と"],["王宮","おうきゅう"],["の"],["柱","はしら"],["を"],["造り","つくり"],["、"],["歌うたい","うたうたい"],["たち"],["の"],["ため"],["に"],["、"],["立琴","たてごと"],["と"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["を"],["作った","つくった"],["。"],["今日","きょう"],["まで"],["、"],["この"],["よう"],["な"],["び"],["ゃ"],["くだん"],["の"],["木材","もくざい"],["が"],["入って","はいって"],["来た","きた"],["こと"],["も"],["なく"],["、"],["だれ"],["も"],["この"],["よう"],["な"],["もの"],["を"],["見た","みた"],["こと"],["も"],["なかった"],["。"]]},{"verse":13,"text":"ソロモン王は、その豊かさに相応したものをシェバの女王に与えたが、それ以外にも、彼女が求めた物は何でもその望みのままに与えた。彼女は、家来たちを連れて、自分の国へ戻って行った。","tok":[["ソロモン"],["王","おう"],["は"],["、"],["その"],["豊か","ゆたか"],["さ"],["に"],["相応","そうおう"],["した"],["もの"],["を"],["シェバ"],["の"],["女王","じょおう"],["に"],["与えた","あたえた"],["が"],["、"],["それ"],["以外","いがい"],["に"],["も"],["、"],["彼女","かのじょ"],["が"],["求めた","もとめた"],["物","もの"],["は"],["何","なん"],["で"],["も"],["その"],["望み","のぞみ"],["の"],["まま"],["に"],["与えた","あたえた"],["。"],["彼女","かのじょ"],["は"],["、"],["家来","けらい"],["たち"],["を"],["連れて","つれて"],["、"],["自分","じぶん"],["の"],["国","くに"],["へ"],["戻って","もどって"],["行った","いった"],["。"]]},{"verse":14,"text":"一年間にソロモンのところに入って来た金の重さは、金の目方で六百六十六タラントであった。","tok":[["一","いち"],["年間","ねんかん"],["に"],["ソロモン"],["の"],["ところ"],["に"],["入って","はいって"],["来た","きた"],["金","かね"],["の"],["重さ","おもさ"],["は"],["、"],["金","きん"],["の"],["目方","めかた"],["で"],["六百六十六","ろくひゃくろくじゅうろく"],["タラント"],["で"],["あった"],["。"]]},{"verse":15,"text":"このほかに、交易商人から得たもの、貿易商人の商いで得たもの、アラビヤのすべての王たち、およびその地の総督たちからのものがあった。","tok":[["この"],["ほか"],["に"],["、"],["交易","こうえき"],["商人","しょうにん"],["から"],["得た","えた"],["もの"],["、"],["貿易","ぼうえき"],["商人","しょうにん"],["の"],["商い","あきない"],["で"],["得た","えた"],["もの"],["、"],["アラビヤ"],["の"],["すべて"],["の"],["王","おう"],["たち"],["、"],["および"],["その"],["地","ち"],["の"],["総督","そうとく"],["たち"],["から"],["の"],["もの"],["が"],["あった"],["。"]]},{"verse":16,"text":"ソロモン王は、延べ金で大盾二百を作り、その大盾一個に六百シェケルの金を使った。","tok":[["ソロモン"],["王","おう"],["は"],["、"],["延べ金","のべがね"],["で"],["大","だい"],["盾","たて"],["二百","にひゃく"],["を"],["作り","つくり"],["、"],["その"],["大","だい"],["盾","たて"],["一個","いちこ"],["に"],["六百","ろくひゃく"],["シェケル"],["の"],["金","かね"],["を"],["使った","つかった"],["。"]]},{"verse":17,"text":"また、延べ金で盾三百を作り、その盾一個に三ミナの金を使った。王はそれらを、レバノンの森の宮殿に置いた。","tok":[["また"],["、"],["延べ金","のべがね"],["で"],["盾","たて"],["三百","さんひゃく"],["を"],["作り","つくり"],["、"],["その"],["盾","たて"],["一個","いちこ"],["に"],["三","さん"],["ミナ"],["の"],["金","かね"],["を"],["使った","つかった"],["。"],["王","おう"],["は"],["それ"],["ら"],["を"],["、"],["レバノン"],["の"],["森","もり"],["の"],["宮殿","きゅうでん"],["に"],["置いた","おいた"],["。"]]},{"verse":18,"text":"王は大きな象牙の王座を作り、これに純粋な金をかぶせた。","tok":[["王","おう"],["は"],["大きな","おおきな"],["象牙","ぞうげ"],["の"],["王座","おうざ"],["を"],["作り","つくり"],["、"],["これ"],["に"],["純粋","じゅんすい"],["な"],["金","かね"],["を"],["かぶせた"],["。"]]},{"verse":19,"text":"その王座には六つの段があり、王座の背には子牛の頭があり、座席の両側にひじかけがあり、そのひじかけのわきには二頭の雄獅子が立っていた。","tok":[["その"],["王座","おうざ"],["に"],["は"],["六","むい"],["つ"],["の"],["段","だん"],["が"],["あり"],["、"],["王座","おうざ"],["の"],["背","せ"],["に"],["は"],["子牛","こうし"],["の"],["頭","あたま"],["が"],["あり"],["、"],["座席","ざせき"],["の"],["両側","りょうがわ"],["に"],["ひじかけ"],["が"],["あり"],["、"],["その"],["ひじかけ"],["の"],["わき"],["に"],["は"],["二頭","にとう"],["の"],["雄","おす"],["獅子","しし"],["が"],["立って","たって"],["いた"],["。"]]},{"verse":20,"text":"また、十二頭の雄獅子が、六つの段の両側に立っていた。このような物は、どこの王国でも作られたためしがなかった。","tok":[["また"],["、"],["十二頭","じゅうにとう"],["の"],["雄","おす"],["獅子","しし"],["が"],["、"],["六","むい"],["つ"],["の"],["段","だん"],["の"],["両側","りょうがわ"],["に"],["立って","たって"],["いた"],["。"],["この"],["よう"],["な"],["物","もの"],["は"],["、"],["どこ"],["の"],["王国","おうこく"],["で"],["も"],["作られた","つくられた"],["ためし"],["が"],["なかった"],["。"]]},{"verse":21,"text":"ソロモン王が飲み物に用いる器はみな金であった。レバノンの森の宮殿にあった器物もすべて純金であって、銀の物はなかった。銀はソロモンの時代には、価値あるものとはみなされていなかった。","tok":[["ソロモン"],["王","おう"],["が"],["飲み物","のみもの"],["に"],["用いる","もちいる"],["器","うつわ"],["は"],["みな"],["金","かね"],["で"],["あった"],["。"],["レバノン"],["の"],["森","もり"],["の"],["宮殿","きゅうでん"],["に"],["あった"],["器物","きぶつ"],["も"],["すべて"],["純金","じゅんきん"],["で"],["あって"],["、"],["銀","ぎん"],["の"],["物","もの"],["は"],["なかった"],["。"],["銀","ぎん"],["は"],["ソロモン"],["の"],["時代","じだい"],["に"],["は"],["、"],["価値","かち"],["ある"],["もの"],["と"],["は"],["みなされて"],["いなかった"],["。"]]},{"verse":22,"text":"王は海に、ヒラムの船団のほか、タルシシュの船団を持っており、三年に一度、タルシシュの船団が金、銀、象牙、さる、くじゃくを運んで来たからである。","tok":[["王","おう"],["は"],["海","うみ"],["に"],["、"],["ヒラム"],["の"],["船団","せんだん"],["の"],["ほか"],["、"],["タルシシュ"],["の"],["船団","せんだん"],["を"],["持って","もって"],["おり"],["、"],["三","さん"],["年","ねん"],["に"],["一度","いちど"],["、"],["タルシシュ"],["の"],["船団","せんだん"],["が"],["金","かね"],["、"],["銀","ぎん"],["、"],["象牙","ぞうげ"],["、"],["さる"],["、"],["くじゃく"],["を"],["運んで","はこんで"],["来た","きた"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"ソロモン王は、富と知恵とにおいて、地上のどの王よりもまさっていた。","tok":[["ソロモン"],["王","おう"],["は"],["、"],["富","とみ"],["と"],["知恵","ちえ"],["と"],["に"],["おいて"],["、"],["地上","ちじょう"],["の"],["どの"],["王","おう"],["より"],["も"],["まさって"],["いた"],["。"]]},{"verse":24,"text":"全世界の者は、神が彼の心に授けられた知恵を聞こうとして、ソロモンに謁見を求めた。","tok":[["全","ぜん"],["世界","せかい"],["の"],["者","もの"],["は"],["、"],["神","かみ"],["が"],["彼","かれ"],["の"],["心","こころ"],["に"],["授けられた","さずけられた"],["知恵","ちえ"],["を"],["聞こう","きこう"],["として"],["、"],["ソロモン"],["に"],["謁見","えっけん"],["を"],["求めた","もとめた"],["。"]]},{"verse":25,"tex
[{"verse":1,"text":"アハブは、エリヤがしたすべての事と、預言者たちを剣で皆殺しにしたこととを残らずイゼベルに告げた。","tok":[["アハブ"],["は"],["、"],["エリヤ"],["が"],["した"],["すべて"],["の"],["事","こと"],["と"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["剣","けん"],["で"],["皆殺し","みなごろし"],["に"],["した"],["こと"],["と"],["を"],["残らず","のこらず"],["イゼベル"],["に"],["告げた","つげた"],["。"]]},{"verse":2,"text":"すると、イゼベルは使者をエリヤのところに遣わして言った。「もしも私が、あすの今ごろまでに、あなたのいのちをあの人たちのひとりのいのちのようにしなかったなら、神々がこの私を幾重にも罰せられるように。」","tok":[["する"],["と"],["、"],["イゼベル"],["は"],["使者","ししゃ"],["を"],["エリヤ"],["の"],["ところ"],["に"],["遣わして","つかわして"],["言った","いった"],["。"],["「"],["もし"],["も"],["私","わたくし"],["が"],["、"],["あす"],["の"],["今ごろ","いまごろ"],["まで"],["に"],["、"],["あなた"],["の"],["いのち"],["を"],["あの"],["人","ひと"],["たち"],["の"],["ひとり"],["の"],["いのち"],["の"],["よう"],["に"],["しなかったなら"],["、"],["神々","かみがみ"],["が"],["この"],["私","わたくし"],["を"],["幾重","いくえ"],["に"],["も"],["罰せられる","ばっせられる"],["よう"],["に"],["。"],["」"]]},{"verse":3,"text":"彼は恐れて立ち、自分のいのちを救うため立ち去った。ユダのベエル・シェバに来たとき、若い者をそこに残し、","tok":[["彼","かれ"],["は"],["恐れて","おそれて"],["立ち","たち"],["、"],["自分","じぶん"],["の"],["いのち"],["を"],["救う","すくう"],["ため"],["立ち去った","たちさった"],["。"],["ユダ"],["の"],["ベエル"],["・"],["シェバ"],["に"],["来た","きた"],["とき"],["、"],["若い","わかい"],["者","もの"],["を"],["そこ"],["に"],["残し","のこし"],["、"]]},{"verse":4,"text":"自分は荒野へ一日の道のりを入って行った。彼は、えにしだの木の陰にすわり、自分の死を願って言った。「主よ。もう十分です。私のいのちを取ってください。私は先祖たちにまさっていませんから。」","tok":[["自分","じぶん"],["は"],["荒野","こうや"],["へ"],["一","いち"],["日","にち"],["の"],["道のり","みちのり"],["を"],["入って","はいって"],["行った","いった"],["。"],["彼","かれ"],["は"],["、"],["えにし"],["だ"],["の"],["木","き"],["の"],["陰","かげ"],["に"],["すわり"],["、"],["自分","じぶん"],["の"],["死","し"],["を"],["願って","ねがって"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["もう"],["十分","じゅうぶん"],["です"],["。"],["私","わたくし"],["の"],["いのち"],["を"],["取って","とって"],["ください"],["。"],["私","わたくし"],["は"],["先祖","せんぞ"],["たち"],["に"],["まさって"],["いません"],["から"],["。"],["」"]]},{"verse":5,"text":"彼がえにしだの木の下で横になって眠っていると、ひとりの御使いが彼にさわって、「起きて、食べなさい」と言った。","tok":[["彼","かれ"],["が"],["えにし"],["だ"],["の"],["木","き"],["の"],["下","もと"],["で"],["横","よこ"],["に"],["なって"],["眠って","ねむって"],["いる"],["と"],["、"],["ひとり"],["の"],["御使い","おつかい"],["が"],["彼","かれ"],["に"],["さわって"],["、"],["「"],["起きて","おきて"],["、"],["食べ","たべ"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"彼は見た。すると、彼の頭のところに、焼け石で焼いたパン菓子一つと、水の入ったつぼがあった。彼はそれを食べ、そして飲んで、また横になった。","tok":[["彼","かれ"],["は"],["見た","みた"],["。"],["する"],["と"],["、"],["彼","かれ"],["の"],["頭","あたま"],["の"],["ところ"],["に"],["、"],["焼け石","やけいし"],["で"],["焼いた","やいた"],["パン"],["菓子","かし"],["一","ひと"],["つ"],["と"],["、"],["水","みず"],["の"],["入った","はいった"],["つぼ"],["が"],["あった"],["。"],["彼","かれ"],["は"],["それ"],["を"],["食べ","たべ"],["、"],["そして"],["飲んで","のんで"],["、"],["また"],["横","よこ"],["に"],["なった"],["。"]]},{"verse":7,"text":"それから、主の使いがもう一度戻って来て、彼にさわり、「起きて、食べなさい。旅はまだ遠いのだから」と言った。","tok":[["それ"],["から"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["もう"],["一度","いちど"],["戻って","もどって"],["来て","きて"],["、"],["彼","かれ"],["に"],["さわり"],["、"],["「"],["起きて","おきて"],["、"],["食べ","たべ"],["なさい"],["。"],["旅","たび"],["は"],["まだ"],["遠い","とおい"],["の"],["だ"],["から"],["」"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"そこで、彼は起きて、食べ、そして飲み、この食べ物に力を得て、四十日四十夜、歩いて神の山ホレブに着いた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["起きて","おきて"],["、"],["食べ","たべ"],["、"],["そして"],["飲み","のみ"],["、"],["この"],["食べ物","たべもの"],["に"],["力","ちから"],["を"],["得て","えて"],["、"],["四十日","よんとうか"],["四十","よんじゅう"],["夜","よる"],["、"],["歩いて","あるいて"],["神","かみ"],["の"],["山","やま"],["ホレブ"],["に"],["着いた","ついた"],["。"]]},{"verse":9,"text":"彼はそこにあるほら穴に入り、そこで一夜を過ごした。すると、彼への主のことばがあった。主は「エリヤよ。ここで何をしているのか」と仰せられた。","tok":[["彼","かれ"],["は"],["そこ"],["に"],["ある"],["ほら穴","ほらあな"],["に"],["入り","はいり"],["、"],["そこ"],["で"],["一夜","いちや"],["を"],["過ごした","すごした"],["。"],["する"],["と"],["、"],["彼","かれ"],["へ"],["の"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"],["主","ぬし"],["は"],["「"],["エリヤ"],["よ"],["。"],["ここ"],["で"],["何","なん"],["を"],["して"],["いる"],["の"],["か"],["」"],["と"],["仰せられた","おおせられた"],["。"]]},{"verse":10,"text":"エリヤは答えた。「私は万軍の神、主に、熱心に仕えました。しかし、イスラエルの人々はあなたの契約を捨て、あなたの祭壇をこわし、あなたの預言者たちを剣で殺しました。ただ私だけが残りましたが、彼らは私のいのちを取ろうとねらっています。」","tok":[["エリヤ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["熱心","ねっしん"],["に"],["仕えました","つかえました"],["。"],["しかし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["あなた"],["の"],["契約","けいやく"],["を"],["捨て","すて"],["、"],["あなた"],["の"],["祭壇","さいだん"],["を"],["こわし"],["、"],["あなた"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["剣","けん"],["で"],["殺しました","ころしました"],["。"],["ただ"],["私","わたくし"],["だけ"],["が"],["残りました","のこりました"],["が"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["の"],["いのち"],["を"],["取ろう","とろう"],["と"],["ねらって"],["います"],["。"],["」"]]},{"verse":11,"text":"主は仰せられた。「外に出て、山の上で主の前に立て。」すると、そのとき、主が通り過ぎられ、主の前で、激しい大風が山々を裂き、岩々を砕いた。しかし、風の中に主はおられなかった。風のあとに地震が起こったが、地震の中にも主はおられなかった。","tok":[["主","ぬし"],["は"],["仰せられた","おおせられた"],["。"],["「"],["外","そと"],["に"],["出て","でて"],["、"],["山","やま"],["の"],["上","うえ"],["で"],["主","ぬし"],["の"],["前","まえ"],["に"],["立て","たて"],["。"],["」"],["する"],["と"],["、"],["その"],["とき"],["、"],["主","ぬし"],["が"],["通り過ぎられ","とおりすぎられ"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["、"],["激しい","はげしい"],["大風","おおかぜ"],["が"],["山々","やまやま"],["を"],["裂き","さき"],["、"],["岩","いわ"],["々"],["を"],["砕いた","くだいた"],["。"],["しかし"],["、"],["風","かぜ"],["の"],["中","なか"],["に"],["主","ぬし"],["は"],["おられなかった"],["。"],["風","かぜ"],["の"],["あと"],["に"],["地震","じしん"],["が"],["起こった","おこった"],["が"],["、"],["地震","じしん"],["の"],["中","なか"],["に"],["も"],["主","ぬし"],["は"],["おられなかった"],["。"]]},{"verse":12,"text":"地震のあとに火があったが、火の中にも主はおられなかった。火のあとに、かすかな細い声があった。","tok":[["地震","じしん"],["の"],["あと"],["に"],["火","ひ"],["が"],["あった"],["が"],["、"],["火","ひ"],["の"],["中","なか"],["に"],["も"],["主","ぬし"],["は"],["おられなかった"],["。"],["火","ひ"],["の"],["あと"],["に"],["、"],["かすか"],["な"],["細い","ほそい"],["声","こえ"],["が"],["あった"],["。"]]},{"verse":13,"text":"エリヤはこれを聞くと、すぐに外套で顔をおおい、外に出て、ほら穴の入口に立った。すると、声が聞こえてこう言った。「エリヤよ。ここで何をしているのか。」","tok":[["エリヤ"],["は"],["これ"],["を"],["聞く","きく"],["と"],["、"],["すぐ"],["に"],["外套","がいとう"],["で"],["顔","かお"],["を"],["おおい"],["、"],["外","そと"],["に"],["出て","でて"],["、"],["ほら穴","ほらあな"],["の"],["入口","いりぐち"],["に"],["立った","たった"],["。"],["する"],["と"],["、"],["声","こえ"],["が"],["聞こえて","きこえて"],["こう"],["言った","いった"],["。"],["「"],["エリヤ"],["よ"],["。"],["ここ"],["で"],["何","なん"],["を"],["して"],["いる"],["の"],["か"],["。"],["」"]]},{"verse":14,"text":"エリヤは答えた。「私は万軍の神、主に、熱心に仕えました。しかし、イスラエルの人々はあなたの契約を捨て、あなたの祭壇をこわし、あなたの預言者たちを剣で殺しました。ただ私だけが残りましたが、彼らは私のいのちを取ろうとねらっています。」","tok":[["エリヤ"],["は"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["は"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主に","おもに"],["、"],["熱心","ねっしん"],["に"],["仕えました","つかえました"],["。"],["しかし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["あなた"],["の"],["契約","けいやく"],["を"],["捨て","すて"],["、"],["あなた"],["の"],["祭壇","さいだん"],["を"],["こわし"],["、"],["あなた"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["剣","けん"],["で"],["殺しました","ころしました"],["。"],["ただ"],["私","わたくし"],["だけ"],["が"],["残りました","のこりました"],["が"],["、"],["彼","かれ"],["ら"],["は"],["私","わたくし"],["の"],["いのち"],["を"],["取ろう","とろう"],["と"],["ねらって"],["います"],["。"],["」"]]},{"verse":15,"text":"主は彼に仰せられた。「さあ、ダマスコの荒野へ帰って行け。そこに行き、ハザエルに油をそそいで、アラムの王とせよ。","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["さあ"],["、"],["ダマスコ"],["の"],["荒野","あらの"],["へ"],["帰って","かえって"],["行け","いけ"],["。"],["そこ"],["に"],["行き","いき"],["、"],["ハザエル"],["に"],["油","あぶら"],["を"],["そそいで"],["、"],["アラム"],["の"],["王","おう"],["と"],["せよ"],["。"]]},{"verse":16,"text":"また、ニムシの子エフーに油をそそいで、イスラエルの王とせよ。また、アベル・メホラの出のシャファテの子エリシャに油をそそいで、あなたに代わる預言者とせよ。","tok":[["また"],["、"],["ニムシ"],["の"],["子","こ"],["エフー"],["に"],["油","あぶら"],["を"],["そそいで"],["、"],["イスラエル"],["の"],["王","おう"],["と"],["せよ"],["。"],["また"],["、"],["アベル"],["・"],["メホラ"],["の"],["出","で"],["の"],["シャファテ"],["の"],["子","こ"],["エリシャ"],["に"],["油","あぶら"],["を"],["そそいで"],["、"],["あなた"],["に"],["代わる","かわる"],["預言者","よげんしゃ"],["と"],["せよ"],["。"]]},{"verse":17,"text":"ハザエルの剣をのがれる者をエフーが殺し、エフーの剣をのがれる者をエリシャが殺す。","tok":[["ハザエル"],["の"],["剣","けん"],["を"],["のがれる"],["者","もの"],["を"],["エフー"],["が"],["殺し","ころし"],["、"],["エフー"],["の"],["剣","けん"],["を"],["のがれる"],["者","もの"],["を"],["エリシャ"],["が"],["殺す","ころす"],["。"]]},{"verse":18,"text":"しかし、わたしはイスラエルの中に七千人を残しておく。これらの者はみな、バアルにひざをかがめず、バアルに口づけしなかった者である。」","tok":[["しかし"],["、"],["わたし"],["は"],["イスラエル"],["の"],["中","なか"],["に"],["七千人","ななせんにん"],["を"],["残して","のこして"],["おく"],["。"],["これ"],["ら"],["の"],["者","もの"],["は"],["みな"],["、"],["バアル"],["に"],["ひざ"],["を"],["かがめず"],["、"],["バアル"],["に"],["口づけ","くちづけ"],["しなかった"],["者","もの"],["で"],["ある"],["。"],["」"]]},{"verse":19,"text":"エリヤはそこを立って行って、シャファテの子エリシャを見つけた。エリシャは、十二くびきの牛を先に立て、その十二番目のくびきのそばで耕していた。エリヤが彼のところを通り過ぎて自分の外套を彼に掛けたので、","tok":[["エリヤ"],["は"],["そこ"],["を"],["立って","たって"],["行って","いって"],["、"],["シャファテ"],["の"],["子","こ"],["エリシャ"],["を"],["見つけた","みつけた"],["。"],["エリシャ"],["は"],["、"],["十二","じゅうに"],["くびき"],["の"],["牛","うし"],["を"],["先","さき"],["に"],["立て","たて"],["、"],["その"],["十二番目","じゅうにばんめ"],["の"],["くびき"],["の"],["そば"],["で"],["耕して","たがやして"],["いた"],["。"],["エリヤ"],["が"],["彼","かれ"],["の"],["ところ"],["を"],["通り過ぎて","とおりすぎて"],["自分","じぶん"],["の"],["外套","がいとう"],["を"],["彼","かれ"],["に"],["掛けた","かけた"],["ので"],["、"]]},{"verse":20,"text":"エリシャは牛をほうっておいて、エリヤのあとを追いかけて行って言った。「私の父と母とに口づけさせてください。それから、あなたに従って行きますから。」エリヤは彼に言った。「行って来なさい。私があなたに何をしたというのか。」","tok":[["エリシャ"],["は"],["牛","うし"],["を"],["ほうって"],["おいて"],["、"],["エリヤ"],["の"],["あと"],["を"],["追いかけて","おいかけて"],["行って","いって"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["父","ちち"],["と"],["母","はは"],["と"],["に"],["口づけ","くちづけ"],["させて"],["ください"],["。"],["それ"],["から"],["、"],["あなた"],["に"],["従って","したがって"],["行きます","いきます"],["から"],["。"],["」"],["エリヤ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["行って","いって"],["来","き"],["なさい"],["。"],["私","わたくし"],["が"],["あなた"],["に"],["何","なん"],["を"],["した"],["と"],["いう"],["の"],["か"],["。"],["」"]]},{"verse":21,"text":"エリシャは引き返して来て、一くびきの牛を取り、それを殺し、牛の用具でその肉を調理し、家族の者たちに与えてそれを食べさせた。それから、彼は立って、エリヤについて行って、彼に仕えた。","tok":[["エリシャ"],["は"],["引き返して","ひきかえして"],["来て","きて"],["、"],["一","いち"],["く"],["びき"],["の"],["牛","うし"],["を"],["取り","とり"],["、"],["それ"],["を"],["殺し","ころし"],["、"],["牛","うし"],["の"],["用具","ようぐ"],["で"],["その"],["肉","にく"],["を"],["調理","ちょうり"],["し"],["、"],["家族","かぞく"],["の"],["者","もの"],["たち"],["に"],["与えて","あたえて"],["それ"],["を"],["食べさせた","たべさせた"],["。"],["それ"],["から"],["、"],["彼","かれ"],["は
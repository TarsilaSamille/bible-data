"],["人","にん"],["は"],["彼","かれ"],["ら"],["と"],["向かい合って","むかいあって"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["彼","かれ"],["ら"],["は"],["二","ふた"],["つ"],["の"],["群れ","むれ"],["の"],["やぎ"],["の"],["よう"],["で"],["あった"],["が"],["、"],["アラム"],["は"],["その"],["地","ち"],["に"],["満ちて","みちて"],["いた"],["。"]]},{"verse":28,"text":"ときに、ひとりの神の人が近づいて来て、イスラエルの王に言った。「主はこう仰せられる。『アラムが、主は山の神であって、低地の神でない、と言っているので、わたしはこのおびただしい大軍を全部あなたの手に渡す。それによって、あなたがたは、わたしこそ主であることを知るであろう。』」","tok":[["とき"],["に"],["、"],["ひとり"],["の"],["神","かみ"],["の"],["人","ひと"],["が"],["近づいて","ちかづいて"],["来て","きて"],["、"],["イスラエル"],["の"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["アラム"],["が"],["、"],["主","ぬし"],["は"],["山の神","やまのかみ"],["で"],["あって"],["、"],["低地","ていち"],["の"],["神","かみ"],["で"],["ない"],["、"],["と"],["言って","いって"],["いる"],["ので"],["、"],["わたし"],["は"],["この"],["おびただしい"],["大軍","たいぐん"],["を"],["全部","ぜんぶ"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["それ"],["によって"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["こそ"],["主","おも"],["で"],["ある"],["こと"],["を"],["知るで","しるで"],["あろう"],["。"],["』"],["」"]]},{"verse":29,"text":"両軍は互いに向かい合って、七日間、陣を敷いていた。七日目になって、戦いを交えたが、イスラエル人は一日のうちにアラムの歩兵十万人を打ち殺した。","tok":[["両軍","りょうぐん"],["は"],["互い","たがい"],["に"],["向かい合って","むかいあって"],["、"],["七","なな"],["日間","かかん"],["、"],["陣","じん"],["を"],["敷いて","しいて"],["いた"],["。"],["七日目","ななかめ"],["に"],["なって"],["、"],["戦い","たたかい"],["を"],["交えた","まじえた"],["が"],["、"],["イスラエル"],["人","にん"],["は"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["アラム"],["の"],["歩兵","ふひょう"],["十万人","じゅうまんにん"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":30,"text":"生き残った者たちはアフェクの町に逃げたが、その二万七千人の残った者の上に城壁がくずれ落ちた。ベン・ハダデは逃げて町に入り、奥の間に入った。","tok":[["生き残った","いきのこった"],["者","もの"],["たち"],["は"],["アフェク"],["の"],["町","まち"],["に"],["逃げた","にげた"],["が"],["、"],["その"],["二万七千","にまんななせん"],["人","にん"],["の"],["残った","のこった"],["者","もの"],["の"],["上","うえ"],["に"],["城壁","じょうへき"],["が"],["くずれ落ちた","くずれおちた"],["。"],["ベン"],["・"],["ハダデ"],["は"],["逃げて","にげて"],["町","まち"],["に"],["入り","はいり"],["、"],["奥","おく"],["の"],["間","あいだ"],["に"],["入った","はいった"],["。"]]},{"verse":31,"text":"家来たちは彼に言った。「イスラエルの家の王たちはあわれみ深い王である、と聞いています。それで、私たちの腰に荒布をまとい、首になわをかけ、イスラエルの王のもとに出て行かせてください。そうすれば、あなたのいのちを助けてくれるかもしれません。」","tok":[["家来","けらい"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["家","いえ"],["の"],["王","おう"],["たち"],["は"],["あわれみ"],["深い","ふかい"],["王","おう"],["で"],["ある"],["、"],["と"],["聞いて","きいて"],["います"],["。"],["それ"],["で"],["、"],["私たち","わたしたち"],["の"],["腰","こし"],["に"],["荒布","あらめ"],["を"],["まとい"],["、"],["首","くび"],["に"],["なわ"],["を"],["かけ"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["もと"],["に"],["出て","でて"],["行かせて","いかせて"],["ください"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["いのち"],["を"],["助けて","たすけて"],["くれる"],["か"],["も"],["しれません"],["。"],["」"]]},{"verse":32,"text":"こうして彼らは腰に荒布を巻き、首になわをかけ、イスラエルの王のもとに行って願った。「あなたのしもべ、ベン・ハダデが、『どうか私のいのちを助けてください』と申しています。」するとアハブは言った。「彼はまだ生きているのか。彼は私の兄弟だ。」","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["腰","こし"],["に"],["荒布","あらめ"],["を"],["巻き","まき"],["、"],["首","くび"],["に"],["なわ"],["を"],["かけ"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["もと"],["に"],["行って","いって"],["願った","ねがった"],["。"],["「"],["あなた"],["の"],["しもべ"],["、"],["ベン"],["・"],["ハダデ"],["が"],["、"],["『"],["どう"],["か"],["私","わたくし"],["の"],["いのち"],["を"],["助けて","たすけて"],["ください"],["』"],["と"],["申して","もうして"],["います"],["。"],["」"],["する"],["と"],["アハブ"],["は"],["言った","いった"],["。"],["「"],["彼","かれ"],["は"],["まだ"],["生きて","いきて"],["いる"],["の"],["か"],["。"],["彼","かれ"],["は"],["私","わたくし"],["の"],["兄弟","きょうだい"],["だ"],["。"],["」"]]},{"verse":33,"text":"この人々は、これは吉兆だと見て、すぐにそのことばにより事が決まったと思い、「ベン・ハダデはあなたの兄弟です」と言った。王は言った。「行って、彼を連れて来なさい。」ベン・ハダデが彼のところに出て来ると、王は彼を戦車に乗せた。","tok":[["この"],["人々","ひとびと"],["は"],["、"],["これ"],["は"],["吉兆","きっちょう"],["だ"],["と"],["見て","みて"],["、"],["すぐ"],["に"],["その"],["ことば"],["に"],["より"],["事","こと"],["が"],["決まった","きまった"],["と"],["思い","おもい"],["、"],["「"],["ベン"],["・"],["ハダデ"],["は"],["あなた"],["の"],["兄弟","きょうだい"],["です"],["」"],["と"],["言った","いった"],["。"],["王","おう"],["は"],["言った","いった"],["。"],["「"],["行って","いって"],["、"],["彼","かれ"],["を"],["連れて","つれて"],["来","き"],["なさい"],["。"],["」"],["ベン"],["・"],["ハダデ"],["が"],["彼","かれ"],["の"],["ところ"],["に"],["出て","でて"],["来る","くる"],["と"],["、"],["王","おう"],["は"],["彼","かれ"],["を"],["戦車","せんしゃ"],["に"],["乗せた","のせた"],["。"]]},{"verse":34,"text":"ベン・ハダデは彼に言った。「私の父が、あなたの父上から奪い取った町々をお返しします。あなたは私の父がサマリヤにしたように、ダマスコに市場を設けることもできます。」「では、契約を結んであなたを帰そう。」こうして、アハブは彼と契約を結び、彼を去らせた。","tok":[["ベン"],["・"],["ハダデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["父","ちち"],["が"],["、"],["あなた"],["の"],["父上","ちちじょう"],["から"],["奪い取った","うばいとった"],["町々","まちまち"],["を"],["お返し","おかえし"],["します"],["。"],["あなた"],["は"],["私","わたくし"],["の"],["父","ちち"],["が"],["サマリヤ"],["に"],["した"],["よう"],["に"],["、"],["ダマスコ"],["に"],["市場","しじょう"],["を"],["設ける","もうける"],["こと"],["も"],["できます"],["。"],["」"],["「"],["で"],["は"],["、"],["契約","けいやく"],["を"],["結んで","むすんで"],["あなた"],["を"],["帰そう","かえそう"],["。"],["」"],["こう"],["して"],["、"],["アハブ"],["は"],["彼","かれ"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["彼","かれ"],["を"],["去らせた","さらせた"],["。"]]},{"verse":35,"text":"預言者のともがらのひとりが、主の命令によって、自分の仲間に、「私を打ってくれ」と言った。しかし、その人は彼を打つことを拒んだ。","tok":[["預言者","よげんしゃ"],["の"],["とも"],["がら"],["の"],["ひとり"],["が"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["によって"],["、"],["自分","じぶん"],["の"],["仲間","なかま"],["に"],["、"],["「"],["私","わたくし"],["を"],["打って","うって"],["くれ"],["」"],["と"],["言った","いった"],["。"],["しかし"],["、"],["その"],["人","ひと"],["は"],["彼","かれ"],["を"],["打つ","うつ"],["こと"],["を"],["拒んだ","こばんだ"],["。"]]},{"verse":36,"text":"それで彼はその人に言った。「あなたは主の御声に聞き従わなかったので、あなたが私のもとから出て行くなら、すぐ獅子があなたを殺す。」その人が彼のそばから出て行くと、獅子がその人を見つけて殺した。","tok":[["それ"],["で"],["彼","かれ"],["は"],["その"],["人","ひと"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["ので"],["、"],["あなた"],["が"],["私","わたくし"],["の"],["もと"],["から"],["出て","でて"],["行くなら","いくなら"],["、"],["すぐ"],["獅子","しし"],["が"],["あなた"],["を"],["殺す","ころす"],["。"],["」"],["その"],["人","ひと"],["が"],["彼","かれ"],["の"],["そば"],["から"],["出て","でて"],["行く","いく"],["と"],["、"],["獅子","しし"],["が"],["その"],["人","ひと"],["を"],["見つけて","みつけて"],["殺した","ころした"],["。"]]},{"verse":37,"text":"ついで、彼はもうひとりの人に会ったので、「私を打ってくれ」と頼んだ。すると、その人は彼を打って傷を負わせた。","tok":[["つい"],["で"],["、"],["彼","かれ"],["は"],["もう"],["ひとり"],["の"],["人","ひと"],["に"],["会った","あった"],["ので"],["、"],["「"],["私","わたくし"],["を"],["打って","うって"],["くれ"],["」"],["と"],["頼んだ","たのんだ"],["。"],["する"],["と"],["、"],["その"],["人","ひと"],["は"],["彼","かれ"],["を"],["打って","うって"],["傷","きず"],["を"],["負わせた","おわせた"],["。"]]},{"verse":38,"text":"それから、その預言者は行って道ばたで王を待っていた。彼は目の上にほうたいをして、だれかわからないようにしていた。","tok":[["それ"],["から"],["、"],["その"],["預言者","よげんしゃ"],["は"],["行って","いって"],["道ばた","みちばた"],["で"],["王","おう"],["を"],["待って","まって"],["いた"],["。"],["彼","かれ"],["は"],["目","め"],["の"],["上","うえ"],["に"],["ほうたい"],["を"],["して"],["、"],["だれ"],["か"],["わからない"],["よう"],["に"],["して"],["いた"],["。"]]},{"verse":39,"text":"王が通りかかったとき、彼は王に叫んで言った。「しもべが戦場に出て行くと、ちょうどそこに、ある人がひとりの者を連れてやって来て、こう言いました。『この者を見張れ。もし、この者を逃がしでもしたら、この者のいのちの代わりにあなたのいのちを取るか、または、銀一タラントを払わせるぞ。』","tok":[["王","おう"],["が"],["通りかかった","とおりかかった"],["とき"],["、"],["彼","かれ"],["は"],["王","おう"],["に"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["しもべ"],["が"],["戦場","せんじょう"],["に"],["出て","でて"],["行く","いく"],["と"],["、"],["ちょうど"],["そこ"],["に"],["、"],["ある"],["人","ひと"],["が"],["ひとり"],["の"],["者","もの"],["を"],["連れて","つれて"],["やって"],["来て","きて"],["、"],["こう"],["言いました","いいました"],["。"],["『"],["この"],["者","もの"],["を"],["見張れ","みはれ"],["。"],["もし"],["、"],["この"],["者","もの"],["を"],["逃がしで","にがしで"],["も"],["したら"],["、"],["この"],["者","もの"],["の"],["いのち"],["の"],["代わり","かわり"],["に"],["あなた"],["の"],["いのち"],["を"],["取る","とる"],["か"],["、"],["また"],["は"],["、"],["銀","ぎん"],["一","いち"],["タラント"],["を"],["払わせる","はらわせる"],["ぞ"],["。"],["』"]]},{"verse":40,"text":"ところが、しもべが何やかやしているうちに、その者はいなくなってしまいました。」すると、イスラエルの王が彼に言った。「あなたはそのとおりにさばかれる。あなた自身が決めたとおりに。」","tok":[["ところ"],["が"],["、"],["しもべ"],["が"],["何","なん"],["や"],["かや"],["して"],["いる"],["うち"],["に"],["、"],["その"],["者","もの"],["は"],["いなく"],["なって"],["しまいました"],["。"],["」"],["する"],["と"],["、"],["イスラエル"],["の"],["王","おう"],["が"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["その"],["とおり"],["に"],["さばかれる"],["。"],["あなた"],["自身","じしん"],["が"],["決めた","きめた"],["とおり"],["に"],["。"],["」"]]},{"verse":41,"text":"彼は急いで、ほうたいを目から取り除いた。そのとき、イスラエルの王は、彼が預言者のひとりであることを見た。","tok":[["彼","かれ"],["は"],["急いで","いそいで"],["、"],["ほうたい"],["を"],["目","め"],["から"],["取り除いた","とりのぞいた"],["。"],["その"],["とき"],["、"],["イスラエル"],["の"],["王","おう"],["は"],["、"],["彼","かれ"],["が"],["預言者","よげんしゃ"],["の"],["ひとり"],["で"],["ある"],["こと"],["を"],["見た","みた"],["。"]]},{"verse":42,"text":"彼は王に言った。「主はこう仰せられる。『わたしが聖絶しようとした者をあなたが逃がしたから、あなたのいのちは彼のいのちの代わりとなり、あなたの民は彼の民の代わりとなる。』」","tok":[["彼","かれ"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["わたし"],["が"],["聖","せい"],["絶しよう","ぜっしよう"],["と"],["した"],["者","もの"],["を"],["あなた"],["が"],["逃がした","にがした"],["から"],["、"],["あなた"],["の"],["いのち"],["は"],["彼","かれ"],["の"],["いのち"],["の"],["代わり","かわり"],["と"],["なり"],["、"],["あなた"],["の"],["民","たみ"],["は"],["彼","かれ"],["の"],["民","たみ"],["の"],["代わり","かわり"],["と"],["なる"],["。"],["』"],["」"]]},{"verse":43,"text":"イスラエルの王は不きげんになり、激しく怒って、自分の家に戻って行き、サマリヤに着いた。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["不","ふ"],["きげん"],["に"],["なり"],["、"],["激しく","はげしく"],["怒って","おこって"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["戻って","もどって"],["行き","いき"],["、"],["サマリヤ"],["に"],["着いた","ついた"],["。"]]}]
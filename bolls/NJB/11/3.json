[{"verse":1,"text":"ソロモンはエジプトの王パロと互いに縁を結び、パロの娘をめとって、彼女をダビデの町に連れて来、自分の家と主の宮、および、エルサレムの回りの城壁を建て終わるまで、そこにおらせた。","tok":[["ソロモン"],["は"],["エジプト"],["の"],["王","おう"],["パロ"],["と"],["互い","たがい"],["に"],["縁","えん"],["を"],["結び","むすび"],["、"],["パロ"],["の"],["娘","むすめ"],["を"],["めとって"],["、"],["彼女","かのじょ"],["を"],["ダビデ"],["の"],["町","まち"],["に"],["連れて","つれて"],["来","き"],["、"],["自分","じぶん"],["の"],["家","いえ"],["と"],["主","ぬし"],["の"],["宮","みや"],["、"],["および"],["、"],["エルサレム"],["の"],["回り","まわり"],["の"],["城壁","じょうへき"],["を"],["建て","たて"],["終わる","おわる"],["まで"],["、"],["そこ"],["に"],["おらせた"],["。"]]},{"verse":2,"text":"当時はまだ、主の名のための宮が建てられていなかったので、民はただ、高き所でいけにえをささげていた。","tok":[["当時","とうじ"],["は"],["まだ"],["、"],["主","ぬし"],["の"],["名","な"],["の"],["ため"],["の"],["宮","みや"],["が"],["建てられて","たてられて"],["いなかった"],["ので"],["、"],["民","みん"],["は"],["ただ"],["、"],["高き","たかき"],["所","ところ"],["で"],["いけにえ"],["を"],["ささげて"],["いた"],["。"]]},{"verse":3,"text":"ソロモンは主を愛し、父ダビデのおきてに歩んでいたが、ただし、彼は高き所でいけにえをささげ、香をたいていた。","tok":[["ソロモン"],["は"],["主","ぬし"],["を"],["愛し","あいし"],["、"],["父","ちち"],["ダビデ"],["の"],["おきて"],["に"],["歩んで","あゆんで"],["いた"],["が"],["、"],["ただし"],["、"],["彼","かれ"],["は"],["高き","たかき"],["所","ところ"],["で"],["いけにえ"],["を"],["ささげ"],["、"],["香","こう"],["を"],["たいて"],["いた"],["。"]]},{"verse":4,"text":"王はいけにえをささげるためにギブオンへ行った。そこは最も重要な高き所であったからである。ソロモンはそこの祭壇の上に一千頭の全焼のいけにえをささげた。","tok":[["王","おう"],["は"],["いけにえ"],["を"],["ささげる"],["ため"],["に"],["ギブオン"],["へ"],["行った","いった"],["。"],["そこ"],["は"],["最も","もっとも"],["重要","じゅうよう"],["な"],["高き","たかき"],["所","ところ"],["で"],["あった"],["から"],["で"],["ある"],["。"],["ソロモン"],["は"],["そこ"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["一千頭","いちせんとう"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":5,"text":"その夜、ギブオンで主は夢のうちにソロモンに現れた。神は仰せられた。「あなたに何を与えようか。願え。」","tok":[["その"],["夜","よる"],["、"],["ギブオン"],["で"],["主","ぬし"],["は"],["夢","ゆめ"],["の"],["うち"],["に"],["ソロモン"],["に"],["現れた","あらわれた"],["。"],["神","かみ"],["は"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["に"],["何","なん"],["を"],["与えよう","あたえよう"],["か"],["。"],["願え","ねがえ"],["。"],["」"]]},{"verse":6,"text":"ソロモンは言った。「あなたは、あなたのしもべ、私の父ダビデに大いなる恵みを施されました。それは、彼が誠実と正義と真心とをもって、あなたの御前を歩んだからです。あなたは、この大いなる恵みを彼のために取っておき、きょう、その王座に着く子を彼にお与えになりました。","tok":[["ソロモン"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["あなた"],["の"],["しもべ"],["、"],["私","わたくし"],["の"],["父","ちち"],["ダビデ"],["に"],["大いなる","おおいなる"],["恵み","めぐみ"],["を"],["施されました","ほどこされました"],["。"],["それ"],["は"],["、"],["彼","かれ"],["が"],["誠実","せいじつ"],["と"],["正義","まさよし"],["と"],["真心","まごころ"],["と"],["を"],["もって"],["、"],["あなた"],["の"],["御前","ごぜん"],["を"],["歩んだ","あゆんだ"],["から"],["です"],["。"],["あなた"],["は"],["、"],["この"],["大いなる","おおいなる"],["恵み","めぐみ"],["を"],["彼","かれ"],["の"],["ため"],["に"],["取って","とって"],["おき"],["、"],["きょう"],["、"],["その"],["王座","おうざ"],["に"],["着く","つく"],["子","こ"],["を"],["彼","かれ"],["に"],["お与え","おあたえ"],["に"],["なりました"],["。"]]},{"verse":7,"text":"わが神、主よ。今、あなたは私の父ダビデに代わって、このしもべを王とされました。しかし、私は小さい子どもで、出入りするすべを知りません。","tok":[["わが"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["今","いま"],["、"],["あなた"],["は"],["私","わたくし"],["の"],["父","ちち"],["ダビデ"],["に"],["代わって","かわって"],["、"],["この"],["しもべ"],["を"],["王","おう"],["と"],["されました"],["。"],["しかし"],["、"],["私","わたくし"],["は"],["小さい","ちいさい"],["子ども","こども"],["で"],["、"],["出入り","でいり"],["する"],["すべ"],["を"],["知りません","しりません"],["。"]]},{"verse":8,"text":"そのうえ、しもべは、あなたの選んだあなたの民の中におります。しかも、彼らはあまりにも多くて、数えることも調べることもできないほど、おびただしい民です。","tok":[["その"],["うえ"],["、"],["しもべ"],["は"],["、"],["あなた"],["の"],["選んだ","えらんだ"],["あなた"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["おります"],["。"],["しかも"],["、"],["彼","かれ"],["ら"],["は"],["あまり"],["に"],["も"],["多くて","おおくて"],["、"],["数える","かぞえる"],["こと"],["も"],["調べる","しらべる"],["こと"],["も"],["できない"],["ほど"],["、"],["おびただしい"],["民","たみ"],["です"],["。"]]},{"verse":9,"text":"善悪を判断してあなたの民をさばくために聞き分ける心をしもべに与えてください。さもなければ、だれに、このおびただしいあなたの民をさばくことができるでしょうか。」","tok":[["善悪","ぜんあく"],["を"],["判断","はんだん"],["して"],["あなた"],["の"],["民","たみ"],["を"],["さばく"],["ため"],["に"],["聞き分ける","ききわける"],["心","こころ"],["を"],["しもべ"],["に"],["与えて","あたえて"],["ください"],["。"],["さも"],["なければ"],["、"],["だれ"],["に"],["、"],["この"],["おびただしい"],["あなた"],["の"],["民","たみ"],["を"],["さばく"],["こと"],["が"],["できるでしょう"],["か"],["。"],["」"]]},{"verse":10,"text":"この願い事は主の御心にかなった。ソロモンがこのことを願ったからである。","tok":[["この"],["願い事","ねがいごと"],["は"],["主","ぬし"],["の"],["御心","おこころ"],["に"],["かなった"],["。"],["ソロモン"],["が"],["この"],["こと"],["を"],["願った","ねがった"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"神は彼に仰せられた。「あなたがこのことを求め、自分のために長寿を求めず、自分のために富を求めず、あなたの敵のいのちをも求めず、むしろ、自分のために正しい訴えを聞き分ける判断力を求めたので、","tok":[["神","かみ"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["が"],["この"],["こと"],["を"],["求め","もとめ"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["長寿","ちょうじゅ"],["を"],["求めず","もとめず"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["富","とみ"],["を"],["求めず","もとめず"],["、"],["あなた"],["の"],["敵","てき"],["の"],["いのち"],["を"],["も"],["求めず","もとめず"],["、"],["むしろ"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["正しい","ただしい"],["訴え","うったえ"],["を"],["聞き分ける","ききわける"],["判断力","はんだんりょく"],["を"],["求めた","もとめた"],["ので"],["、"]]},{"verse":12,"text":"今、わたしはあなたの言ったとおりにする。見よ。わたしはあなたに知恵の心と判断する心とを与える。あなたの先に、あなたのような者はなかった。また、あなたのあとに、あなたのような者も起こらない。","tok":[["今","いま"],["、"],["わたし"],["は"],["あなた"],["の"],["言った","いった"],["とおり"],["に"],["する"],["。"],["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["に"],["知恵","ちえ"],["の"],["心","こころ"],["と"],["判断","はんだん"],["する"],["心","こころ"],["と"],["を"],["与える","あたえる"],["。"],["あなた"],["の"],["先","さき"],["に"],["、"],["あなた"],["の"],["よう"],["な"],["者","もの"],["は"],["なかった"],["。"],["また"],["、"],["あなた"],["の"],["あと"],["に"],["、"],["あなた"],["の"],["よう"],["な"],["者","もの"],["も"],["起こらない","おこらない"],["。"]]},{"verse":13,"text":"そのうえ、あなたの願わなかったもの、富と誉れとをあなたに与える。あなたの生きているかぎり、王たちの中であなたに並ぶ者はひとりもないであろう。","tok":[["その"],["うえ"],["、"],["あなた"],["の"],["願わなかった","ねがわなかった"],["もの"],["、"],["富","とみ"],["と"],["誉れ","ほまれ"],["と"],["を"],["あなた"],["に"],["与える","あたえる"],["。"],["あなた"],["の"],["生きて","いきて"],["いる"],["かぎり"],["、"],["王","おう"],["たち"],["の"],["中","なか"],["で"],["あなた"],["に"],["並ぶ","ならぶ"],["者","もの"],["は"],["ひとり"],["も"],["ないで"],["あろう"],["。"]]},{"verse":14,"text":"また、あなたの父ダビデが歩んだように、あなたもわたしのおきてと命令を守って、わたしの道を歩むなら、あなたの日を長くしよう。」","tok":[["また"],["、"],["あなた"],["の"],["父","ちち"],["ダビデ"],["が"],["歩んだ","あゆんだ"],["よう"],["に"],["、"],["あなた"],["も"],["わたし"],["の"],["おきて"],["と"],["命令","めいれい"],["を"],["守って","まもって"],["、"],["わたし"],["の"],["道","みち"],["を"],["歩むなら","あゆむなら"],["、"],["あなた"],["の"],["日","ひ"],["を"],["長く","ながく"],["しよう"],["。"],["」"]]},{"verse":15,"text":"ソロモンが目をさますと、なんと、それは夢であった。そこで、彼はエルサレムに行き、主の契約の箱の前に立って、全焼のいけにえをささげ、和解のいけにえをささげ、すべての家来たちを招いて祝宴を開いた。","tok":[["ソロモン"],["が"],["目","め"],["を"],["さます"],["と"],["、"],["なん"],["と"],["、"],["それ"],["は"],["夢","ゆめ"],["で"],["あった"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["は"],["エルサレム"],["に"],["行き","いき"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["和解","わかい"],["の"],["いけにえ"],["を"],["ささげ"],["、"],["すべて"],["の"],["家来","けらい"],["たち"],["を"],["招いて","まねいて"],["祝宴","しゅくえん"],["を"],["開いた","ひらいた"],["。"]]},{"verse":16,"text":"そのころ、ふたりの遊女が王のところに来て、その前に立った。","tok":[["その"],["ころ"],["、"],["ふたり"],["の"],["遊女","ゆうじょ"],["が"],["王","おう"],["の"],["ところ"],["に"],["来て","きて"],["、"],["その"],["前","まえ"],["に"],["立った","たった"],["。"]]},{"verse":17,"text":"ひとりの女が言った。「わが君。私とこの女とは同じ家に住んでおります。私はこの女といっしょに家にいるとき子どもを産みました。","tok":[["ひとり"],["の"],["女","おんな"],["が"],["言った","いった"],["。"],["「"],["わが"],["君","きみ"],["。"],["私","わたくし"],["と"],["この"],["女","おんな"],["と"],["は"],["同じ","おなじ"],["家","いえ"],["に"],["住んで","すんで"],["おります"],["。"],["私","わたくし"],["は"],["この"],["女","おんな"],["と"],["いっしょ"],["に"],["家","いえ"],["に"],["いる"],["とき"],["子ども","こども"],["を"],["産みました","うみました"],["。"]]},{"verse":18,"text":"ところが、私が子どもを産んで三日たつと、この女も子どもを産みました。家には私たちのほか、だれもいっしょにいた者はなく、家にはただ私たちふたりだけでした。","tok":[["ところ"],["が"],["、"],["私","わたくし"],["が"],["子ども","こども"],["を"],["産んで","うんで"],["三日","みっか"],["たつ"],["と"],["、"],["この"],["女","おんな"],["も"],["子ども","こども"],["を"],["産みました","うみました"],["。"],["家","いえ"],["に"],["は"],["私たち","わたしたち"],["の"],["ほか"],["、"],["だれ"],["も"],["いっしょ"],["に"],["いた"],["者","もの"],["は"],["なく"],["、"],["家","いえ"],["に"],["は"],["ただ"],["私たち","わたしたち"],["ふたり"],["だけ"],["でした"],["。"]]},{"verse":19,"text":"ところが、夜の間に、この女の産んだ子が死にました。この女が自分の子の上に伏したからです。","tok":[["ところ"],["が"],["、"],["夜","よる"],["の"],["間","あいだ"],["に"],["、"],["この"],["女","おんな"],["の"],["産んだ","うんだ"],["子","こ"],["が"],["死にました","しにました"],["。"],["この"],["女","おんな"],["が"],["自分","じぶん"],["の"],["子","こ"],["の"],["上","うえ"],["に"],["伏した","ふした"],["から"],["です"],["。"]]},{"verse":20,"text":"この女は夜中に起きて、はしためが眠っている間に、私のそばから私の子を取って、自分のふところに抱いて寝かせ、自分の死んだ子を私のふところに寝かせたのです。","tok":[["この"],["女","おんな"],["は"],["夜中","よなか"],["に"],["起きて","おきて"],["、"],["はし"],["ため"],["が"],["眠って","ねむって"],["いる"],["間","あいだ"],["に"],["、"],["私","わたくし"],["の"],["そば"],["から"],["私","わたくし"],["の"],["子","こ"],["を"],["取って","とって"],["、"],["自分","じぶん"],["の"],["ふところ"],["に"],["抱いて","いだいて"],["寝かせ","ねかせ"],["、"],["自分","じぶん"],["の"],["死んだ","しんだ"],["子","こ"],["を"],["私","わたくし"],["の"],["ふところ"],["に"],["寝かせた","ねかせた"],["の"],["です"],["。"]]},{"verse":21,"text":"朝、私が子どもに乳を飲ませようとして起きてみると、どうでしょう、子どもは死んでいるではありませんか。朝、その子をよく見てみると、まあ、その子は私が産んだ子ではないのです。」","tok":[["朝","あさ"],["、"],["私","わたくし"],["が"],["子ども","こども"],["に"],["乳","ちち"],["を"],["飲ませよう","のませよう"],["として"],["起きて","おきて"],["みる"],["と"],["、"],["どう"],["でしょう"],["、"],["子ども","こども"],["は"],["死んで","しんで"],["いるで"],["は"],["ありません"],["か"],["。"],["朝","あさ"],["、"],["その"],["子","こ"],["を"],["よく"],["見て","みて"],["みる"],["と"],["、"],["まあ"],["、"],["その"],["子","こ"],["は"],["私","わたくし"],["が"],["産んだ","うんだ"],["子","こ"],["で"],["は"],["ない"],["の"],["です"],["。"],["」"]]},{"verse":22,"text":"すると、もうひとりの女が言った。「いいえ、生きているのが私の子で、死んでいるのはあなたの子です。」先の女は言った。「いいえ、死んだのがあなたの子で、生きているのが私の子です。」こうして、女たちは王の前で言い合った。","tok":[["する"],["と"],["、"],["もう"],["ひとり"],["の"],["女","おんな"],["が"],["言った","いった"],["。"],["「"],["いいえ"],["、"],["生きて","いきて"],["いる"],["の"],["が"],["私","わたくし"],["の"],["子","こ"],["で"],["、"],["死んで","しんで"],["いる"],["の"],["は"],["あなた"],["の"],["子","こ"],["です"],["。"],["」"],["先","さき"],["の"],["女","おんな"],["は"],["言った","いった"],["。"],["「"],["いいえ"],["、"],["死んだ","しんだ"],["の"],["が"],["あなた"],["の"],["子","こ"],["で"],["、"],["生きて","いきて"],["いる"],["の"],["が"],["私","わたくし"],["の"],["子","こ"],["です"],["。"],["」"],["こう"],["して"],["、"],["女","おんな"],["たち"],["は"],["王","おう"],["の"],["前","まえ"],["で"],["言い合った","いいあった"],["。"]]},{"verse":23,"text":"そこで王は言った。「ひとりは『生きているのが私の子で、死んでいるのはあなたの子だ』と言い、また、もうひとりは『いや、死んだのがあなたの子で、生きているのが私の子だ』と言う。」","tok":[["そこ"],["で"],["王","おう"],["は"],["言った","いった"],["。"],["「"],["ひとり"],["は"],["『"],["生きて","いきて"],["いる"],["の"],["が"],["私","わたくし"],["の"],["子","こ"],["で"],["、"],["死んで","しんで"],["いる"],["の"],["は"],["あなた"],["の"],["子","こ"],["だ"],["』"],["と"],["言い","いい"],["、"],["また"],["、"],["もう"],["ひとり"],["は"],["『"],["いや"],["、"],["死んだ","しんだ"],["の"],["が"],["あなた"],["の"],["子","こ"],["で"],["、"],["生きて","いきて"],["いる"],["の"],["が"],["私","わたくし"],["の"],["子","こ"],["だ"],["』"],["と"],["言う","ゆう"],["。"],["」"]]},{"verse":24,"text":"そして、王は、「剣をここに持って来なさい」と命じた。剣が王の前に持って来られると、","tok":[["そして"],["、"],["王","おう"],["は"],["、"],["「"],["剣","けん"],["を"],["ここ"],["に"],["持って","もって"],["来","き"],["なさい"],["」"],["と"],["命じた","めいじた"],["。"],["剣","けん"],["が"],["王","おう"],["の"],["前","まえ"],["に"],["持って","もって"],["来られる","こられる"],["と"],["、"]]},{"verse":25,"text":"王は言った。「生きている子どもを二つに断ち切り、半分をこちらに、半分をそちらに与えなさい。」","tok":[["王","おう"],["は"],["言った","いった"],["。"],["「"],["生きて","いきて"],["いる"],["子ども","こども"],["を"],["二","ふた"],["つ"],["に"],["断ち切り","たちきり"],["、"],["半分","はんぶん"],["を"],["こちら"],["に"],["、"],["半分","はんぶん"],["を"],["そちら"],["に"],["与え","あたえ"],["なさい"],["。"],["」"]]},{"verse":26,"text":"すると、生きている子の母親は、自分の子を哀れに思って胸が熱くなり、王に申し立てて言った。「わが君。どうか、その生きている子をあの女にあげてください。決してその子を殺さないでください。」しかし、もうひとりの女は、「それを私のものにも、あなたのものにもしないで、断ち切ってください」と言った。","tok":[["する"],["と"],["、"],["生きて","いきて"],["いる"],["子","こ"],["の"],["母親","ははおや"],["は"],["、"],["自分","じぶん"],["の"],["子","こ"],["を"],["哀れ","あわれ"],["に"],["思って","おもって"],["胸","むね"],["が"],["熱く","あつく"],["なり"],["、"],["王","おう"],["に"],["申し立てて","もうしたてて"],["言った","いった"],["。"],["「"],["わが"],["君","きみ"],["。"],["どう"],["か"],["、"],["その"],["生きて","いきて"],["いる"],["子","こ"],["を"],["あの"],["女","おんな"],["に"],["あげて"],["ください"],["。"],["決して","けっして"],["その"],["子","こ"],["を"],["殺さないで","ころさないで"],["ください"],["。"],["」"],["しかし"],["、"],["もう"],["ひとり"],["の"],["女","おんな"],["は"],["、"],["「"],["それ"],["を"],["私","わたくし"],["の"],["もの"],["に"],["も"],["、"],["あなた"],["の"],["もの"],["に"],["も"],["しないで"],["、"],["断ち切って","たちきって"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":27,"text":"そこで王は宣告を下して言った。「生きている子どもを初めの女に与えなさい。決してその子を殺してはならない。彼女がその子の母親なのだ。」","tok":[["そこ"],["で"],["王","おう"],["は"],["宣告","せんこく"],["を"],["下して","くだして"],["言った","いった"],["。"],["「"],["生きて","いきて"],["いる"],["子ども","こども"],["を"],["初め","はじめ"],["の"],["女","おんな"],["に"],["与え","あたえ"],["なさい"],["。"],["決して","けっして"],["その"],["子","こ"],["を"],["殺して","ころして"],["は"],["ならない"],["。"],["彼女","かのじょ"],["が"],["その"],["子","こ"],["の"],["母親","ははおや"],["な"],["の"],["だ"],["。"],["」"]]},{"verse":28,"text":"イスラエル人はみな、王が下したさばきを聞いて、王を恐れた。神の知恵が彼のうちにあって、さばきをするのを見たからである。","tok":[["イスラエル"],["人","にん"],["は"],["みな"],["、"],["王","おう"],["が"],["下した","くだした"],["さばき"],["を"],["聞いて","きいて"],["、"],["王","おう"],["を"],["恐れた","おそれた"],["。"],["神","かみ"],["の"],["知恵","ちえ"],["が"],["彼","かれ"],["の"],["うち"],["に"],["あって"],["、"],["さばき"],["を"],["する"],["の"],["を"],["見た","みた"],["から"],["で"],["ある"],["。"]]}]
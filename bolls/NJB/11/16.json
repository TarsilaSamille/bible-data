[{"verse":1,"text":"そのとき、ハナニの子エフーにバシャに対する次のような主のことばがあった。","tok":[["その"],["とき"],["、"],["ハナニ"],["の"],["子","こ"],["エフー"],["に"],["バシャ"],["に"],["対する","たいする"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"]]},{"verse":2,"text":"「わたしはあなたをちりから引き上げ、わたしの民イスラエルの君主としたが、あなたはヤロブアムの道に歩み、わたしの民イスラエルに罪を犯させ、その罪によってわたしの怒りを引き起こした。","tok":[["「"],["わたし"],["は"],["あなた"],["を"],["ちり"],["から"],["引き上げ","ひきあげ"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["君主","くんしゅ"],["と"],["した"],["が"],["、"],["あなた"],["は"],["ヤロブアム"],["の"],["道","みち"],["に"],["歩み","あゆみ"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させ","おかさせ"],["、"],["その"],["罪","つみ"],["によって"],["わたし"],["の"],["怒り","いかり"],["を"],["引き起こした","ひきおこした"],["。"]]},{"verse":3,"text":"それで今、わたしはバシャとその家族とを除き去り、あなたの家をネバテの子ヤロブアムの家のようにする。","tok":[["それ"],["で"],["今","いま"],["、"],["わたし"],["は"],["バシャ"],["と"],["その"],["家族","かぞく"],["と"],["を"],["除き去り","のぞきさり"],["、"],["あなた"],["の"],["家","いえ"],["を"],["ネバテ"],["の"],["子","こ"],["ヤロブアム"],["の"],["家","いえ"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":4,"text":"バシャに属する者で、町で死ぬ者は犬がこれを食らい、野で死ぬ者は空の鳥がこれを食らう。」","tok":[["バシャ"],["に"],["属する","ぞくする"],["者","もの"],["で"],["、"],["町","まち"],["で"],["死ぬ","しぬ"],["者","もの"],["は"],["犬","いぬ"],["が"],["これ"],["を"],["食らい","くらい"],["、"],["野","の"],["で"],["死ぬ","しぬ"],["者","もの"],["は"],["空","そら"],["の"],["鳥","とり"],["が"],["これ"],["を"],["食らう","くらう"],["。"],["」"]]},{"verse":5,"text":"バシャのその他の業績、彼の行った事、およびその功績、それはイスラエルの王たちの年代記の書にしるされているではないか。","tok":[["バシャ"],["の"],["その"],["他","た"],["の"],["業績","ぎょうせき"],["、"],["彼","かれ"],["の"],["行った","おこなった"],["事","こと"],["、"],["および"],["その"],["功績","こうせき"],["、"],["それ"],["は"],["イスラエル"],["の"],["王","おう"],["たち"],["の"],["年代記","ねんだいき"],["の"],["書","しょ"],["に"],["しるされて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"バシャは彼の先祖たちとともに眠り、ティルツァに葬られた。彼の子エラが代わって王となった。","tok":[["バシャ"],["は"],["彼","かれ"],["の"],["先祖","せんぞ"],["たち"],["と"],["とも"],["に"],["眠り","ねむり"],["、"],["ティルツァ"],["に"],["葬られた","ほうむられた"],["。"],["彼","かれ"],["の"],["子","こ"],["エラ"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":7,"text":"主のことばはまた、ハナニの子、預言者エフーを通して、バシャとその家とに向けられた。それは、彼が主の目の前にあらゆる悪を行い、その手のわざによって主の怒りを引き起こし、ヤロブアムの家のようになり、また、彼がヤロブアムを打ち殺したからである。","tok":[["主","ぬし"],["の"],["ことば"],["は"],["また"],["、"],["ハナニ"],["の"],["子","こ"],["、"],["預言者","よげんしゃ"],["エフー"],["を"],["通して","とおして"],["、"],["バシャ"],["と"],["その"],["家","いえ"],["と"],["に"],["向けられた","むけられた"],["。"],["それ"],["は"],["、"],["彼","かれ"],["が"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あらゆる"],["悪","あく"],["を"],["行い","おこない"],["、"],["その"],["手","て"],["の"],["わざ"],["によって"],["主","ぬし"],["の"],["怒り","いかり"],["を"],["引き起こし","ひきおこし"],["、"],["ヤロブアム"],["の"],["家","いえ"],["の"],["よう"],["に"],["なり"],["、"],["また"],["、"],["彼","かれ"],["が"],["ヤロブアム"],["を"],["打ち殺した","うちころした"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"ユダの王アサの第二十六年に、バシャの子エラがティルツァで、イスラエルの王となった。治世は二年である。","tok":[["ユダ"],["の"],["王","おう"],["アサ"],["の"],["第","だい"],["二十六","にじゅうろく"],["年","ねん"],["に"],["、"],["バシャ"],["の"],["子","こ"],["エラ"],["が"],["ティルツァ"],["で"],["、"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["。"],["治世","ちせい"],["は"],["二","に"],["年","ねん"],["で"],["ある"],["。"]]},{"verse":9,"text":"彼がティルツァにいて、ティルツァの王の家のつかさアルツァの家で酒を飲んで酔っていたとき、彼の家来で、戦車隊の半分の長であるジムリが彼に謀反を企てた。","tok":[["彼","かれ"],["が"],["ティルツァ"],["に"],["いて"],["、"],["ティルツァ"],["の"],["王","おう"],["の"],["家","いえ"],["の"],["つかさ"],["アルツァ"],["の"],["家","いえ"],["で"],["酒","さけ"],["を"],["飲んで","のんで"],["酔って","よって"],["いた"],["とき"],["、"],["彼","かれ"],["の"],["家来","けらい"],["で"],["、"],["戦車隊","せんしゃたい"],["の"],["半分","はんぶん"],["の"],["長","ちょう"],["で"],["ある"],["ジムリ"],["が"],["彼","かれ"],["に"],["謀反","むほん"],["を"],["企てた","くわだてた"],["。"]]},{"verse":10,"text":"ユダの王アサの第二十七年に、ジムリは入って来て、彼を打ち殺し、彼に代わって王となった。","tok":[["ユダ"],["の"],["王","おう"],["アサ"],["の"],["第","だい"],["二十七","にじゅうなな"],["年","ねん"],["に"],["、"],["ジムリ"],["は"],["入って","はいって"],["来て","きて"],["、"],["彼","かれ"],["を"],["打ち殺し","うちころし"],["、"],["彼","かれ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":11,"text":"彼が王となり、王座に着くとすぐ、彼はバシャの全家を打ち、小わっぱから、親類、友人に至るまで、ひとりも残さなかった。","tok":[["彼","かれ"],["が"],["王","おう"],
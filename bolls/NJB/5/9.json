[{"verse":1,"text":"聞きなさい。イスラエル。あなたはきょう、ヨルダンを渡って、あなたよりも大きくて強い国々を占領しようとしている。その町々は大きく、城壁は天に高くそびえている。","tok":[["聞き","きき"],["なさい"],["。"],["イスラエル"],["。"],["あなた"],["は"],["きょう"],["、"],["ヨルダン"],["を"],["渡って","わたって"],["、"],["あなた"],["より"],["も"],["大きくて","おおきくて"],["強い","つよい"],["国々","くにぐに"],["を"],["占領","せんりょう"],["しよう"],["として"],["いる"],["。"],["その"],["町々","まちまち"],["は"],["大きく","おおきく"],["、"],["城壁","じょうへき"],["は"],["天","てん"],["に"],["高く","たかく"],["そびえて"],["いる"],["。"]]},{"verse":2,"text":"その民は大きくて背が高く、あなたの知っているアナク人である。あなたは聞いた。「だれがアナク人に立ち向かうことができようか。」","tok":[["その"],["民","みん"],["は"],["大きくて","おおきくて"],["背","せ"],["が"],["高く","たかく"],["、"],["あなた"],["の"],["知って","しって"],["いる"],["アナク人","あなくにん"],["で"],["ある"],["。"],["あなた"],["は"],["聞いた","きいた"],["。"],["「"],["だれ"],["が"],["アナク人","あなくにん"],["に"],["立ち向かう","たちむかう"],["こと"],["が"],["できよう"],["か"],["。"],["」"]]},{"verse":3,"text":"きょう、知りなさい。あなたの神、主ご自身が、焼き尽くす火として、あなたの前に進まれ、主が彼らを根絶やしにされる。主があなたの前で彼らを征服される。あなたは、主が約束されたように、彼らをただちに追い払って、滅ぼすのだ。","tok":[["きょう"],["、"],["知り","しり"],["なさい"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["ご自身","ごじしん"],["が"],["、"],["焼き","やき"],["尽くす","つくす"],["火","ひ"],["として"],["、"],["あなた"],["の"],["前","まえ"],["に"],["進まれ","すすまれ"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["根絶やし","ねだやし"],["に"],["される"],["。"],["主","ぬし"],["が"],["あなた"],["の"],["前","まえ"],["で"],["彼","かれ"],["ら"],["を"],["征服","せいふく"],["される"],["。"],["あなた"],["は"],["、"],["主","ぬし"],["が"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["ただちに"],["追い払って","おいはらって"],["、"],["滅ぼす","ほろぼす"],["の"],["だ"],["。"]]},{"verse":4,"text":"あなたの神、主が、あなたの前から彼らを追い出されたとき、あなたは心の中で、「私が正しいから、主が私にこの地を得させてくださったのだ」と言ってはならない。これらの国々が悪いために、主はあなたの前から彼らを追い出そうとしておられるのだ。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い出された","おいだされた"],["とき"],["、"],["あなた"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["「"],["私","わたくし"],["が"],["正しい","ただしい"],["から"],["、"],["主","ぬし"],["が"],["私","わたくし"],["に"],["この"],["地","ち"],["を"],["得させて","えさせて"],["くださった"],["の"],["だ"],["」"],["と"],["言って","いって"],["は"],["ならない"],["。"],["これ"],["ら"],["の"],["国々","くにぐに"],["が"],["悪い","わるい"],["ため"],["に"],["、"],["主","ぬし"],["は"],["あなた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い出そう","おいだそう"],["として"],["おられる"],["の"],["だ"],["。"]]},{"verse":5,"text":"あなたが彼らの地を所有することのできるのは、あなたが正しいからではなく、またあなたの心がまっすぐだからでもない。それは、これらの国々が悪いために、あなたの神、主が、あなたの前から彼らを追い出そうとしておられるのだ。また、主があなたの先祖、アブラハム、イサク、ヤコブになさった誓いを果たすためである。","tok":[["あなた"],["が"],["彼","かれ"],["ら"],["の"],["地","ち"],["を"],["所有","しょゆう"],["する"],["こと"],["の"],["できる"],["の"],["は"],["、"],["あなた"],["が"],["正しい","ただしい"],["から"],["で"],["は"],["なく"],["、"],["また"],["あなた"],["の"],["心","こころ"],["が"],["まっすぐ"],["だ"],["から"],["で"],["も"],["ない"],["。"],["それ"],["は"],["、"],["これ"],["ら"],["の"],["国々","くにぐに"],["が"],["悪い","わるい"],["ため"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い出そう","おいだそう"],["として"],["おられる"],["の"],["だ"],["。"],["また"],["、"],["主","ぬし"],["が"],["あなた"],["の"],["先祖","せんぞ"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["なさった"],["誓い","ちかい"],["を"],["果たす","はたす"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"知りなさい。あなたの神、主は、あなたが正しいということで、この良い地をあなたに与えて所有させられるのではない。あなたはうなじのこわい民であるからだ。","tok":[["知り","しり"],["なさい"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["が"],["正しい","ただしい"],["と"],["いう"],["こと"],["で"],["、"],["この"],["良い","よい"],["地","ち"],["を"],["あなた"],["に"],["与えて","あたえて"],["所有","しょゆう"],["させられる"],["ので"],["は"],["ない"],["。"],["あなた"],["は"],["うなじ"],["の"],["こわい"],["民","たみ"],["で"],["ある"],["から"],["だ"],["。"]]},{"verse":7,"text":"あなたは荒野で、どんなにあなたの神、主を怒らせたかを覚えていなさい。忘れてはならない。エジプトの地を出た日から、この所に来るまで、あなたがたは主に逆らいどおしであった。","tok":[["あなた"],["は"],["荒野","あらの"],["で"],["、"],["どんな"],["に"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["怒らせた","おこらせた"],["か"],["を"],["覚えて","おぼえて"],["い"],["なさい"],["。"],["忘れて","わすれて"],["は"],["ならない"],["。"],["エジプト"],["の"],["地","ち"],["を"],["出た","でた"],["日","ひ"],["から"],["、"],["この"],["所","ところ"],["に"],["来る","くる"],["まで"],["、"],["あなた"],["がた"],["は"],["主に","おもに"],["逆らい","さからい"],["ど"],["おし"],["で"],["あった"],["。"]]},{"verse":8,"text":"あなたがたはホレブで、主を怒らせたので、主は怒ってあなたがたを根絶やしにしようとされた。","tok":[["あなた"],["がた"],["は"],["ホレブ"],["で"],["、"],["主","ぬし"],["を"],["怒らせた","おこらせた"],["ので"],["、"],["主","ぬし"],["は"],["怒って","おこって"],["あなた"],["がた"],["を"],["根絶やし","ねだやし"],["に"],["しよう"],["と"],["された"],["。"]]},{"verse":9,"text":"私が石の板、主があなたがたと結ばれた契約の板を受けるために、山に登ったとき、私は四十日四十夜、山にとどまり、パンも食べず、水も飲まなかった。","tok":[["私","わたくし"],["が"],["石","いし"],["の"],["板","いた"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["の"],["板","いた"],["を"],["受ける","うける"],["ため"],["に"],["、"],["山","やま"],["に"],["登った","のぼった"],["とき"],["、"],["私","わたくし"],["は"],["四十日","よんとうか"],["四十","よんじゅう"],["夜","よる"],["、"],["山","やま"],["に"],["とどまり"],["、"],["パン"],["も"],["食べず","たべず"],["、"],["水","みず"],["も"],["飲まなかった","のまなかった"],["。"]]},{"verse":10,"text":"その後、主は神の指で書きしるされた石の板二枚を私に授けられた。その上には、あの集まりの日に主が山で火の中から、あなたがたに告げられたことばが、ことごとく、そのまま書かれてあった。","tok":[["その"],["後","ご"],["、"],["主","ぬし"],["は"],["神","かみ"],["の"],["指","ゆび"],["で"],["書きしるされた","かきしるされた"],["石","いし"],["の"],["板","いた"],["二枚","にまい"],["を"],["私","わたくし"],["に"],["授けられた","さずけられた"],["。"],["その"],["上","うえ"],["に"],["は"],["、"],["あの"],["集まり","あつまり"],["の"],["日","ひ"],["に"],["主","ぬし"],["が"],["山","やま"],["で"],["火","ひ"],["の"],["中","なか"],["から"],["、"],["あなた"],["がた"],["に"],["告げられた","つげられた"],["ことば"],["が"],["、"],["ことごとく"],["、"],["そのまま"],["書かれて","かかれて"],["あった"],["。"]]},{"verse":11,"text":"こうして四十日四十夜の終わりに、主がその二枚の石の板、契約の板を私に授けられた。","tok":[["こう"],["して"],["四十日","よんとうか"],["四十夜","よんじゅうや"],["の"],["終わり","おわり"],["に"],["、"],["主","ぬし"],["が"],["その"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["、"],["契約","けいやく"],["の"],["板","いた"],["を"],["私","わたくし"],["に"],["授けられた","さずけられた"],["。"]]},{"verse":12,"text":"そして主は私に仰せられた。「さあ、急いでここから下れ。あなたがエジプトから連れ出したあなたの民が、堕落してしまった。彼らはわたしが命じておいた道から早くもそれて、自分たちのために鋳物の像を造った。」","tok":[["そして"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["さあ"],["、"],["急いで","いそいで"],["ここ"],["から"],["下れ","くだれ"],["。"],["あなた"],["が"],["エジプト"
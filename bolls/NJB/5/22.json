[{"verse":1,"text":"あなたの同族の者の牛または羊が迷っているのを見て、知らぬふりをしていてはならない。あなたの同族の者のところへそれを必ず連れ戻さなければならない。","tok":[["あなた"],["の"],["同族","どうぞく"],["の"],["者","もの"],["の"],["牛","うし"],["また"],["は"],["羊","ひつじ"],["が"],["迷って","まよって"],["いる"],["の"],["を"],["見て","みて"],["、"],["知らぬ","しらぬ"],["ふり"],["を"],["して"],["いて"],["は"],["ならない"],["。"],["あなた"],["の"],["同族","どうぞく"],["の"],["者","もの"],["の"],["ところ"],["へ"],["それ"],["を"],["必ず","かならず"],["連れ戻さなければ","つれもどさなければ"],["ならない"],["。"]]},{"verse":2,"text":"もし同族の者が近くの者でなく、あなたはその人を知らないなら、それを自分の家に連れて来て、同族の者が捜している間、あなたのところに置いて、それを彼に返しなさい。","tok":[["もし"],["同族","どうぞく"],["の"],["者","もの"],["が"],["近く","ちかく"],["の"],["者","もの"],["で"],["なく"],["、"],["あなた"],["は"],["その"],["人","ひと"],["を"],["知らないなら","しらないなら"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["家","いえ"],["に"],["連れて","つれて"],["来て","きて"],["、"],["同族","どうぞく"],["の"],["者","もの"],["が"],["捜して","さがして"],["いる"],["間","あいだ"],["、"],["あなた"],["の"],["ところ"],["に"],["置いて","おいて"],["、"],["それ"],["を"],["彼","かれ"],["に"],["返し","かえし"],["なさい"],["。"]]},{"verse":3,"text":"彼のろばについても同じようにしなければならない。彼の着物についても同じようにしなければならない。すべてあなたの同族の者がなくしたものを、あなたが見つけたなら、同じようにしなければならない。知らぬふりをしていることはできない。","tok":[["彼","かれ"],["の"],["ろば"],["について"],["も"],["同じ","おなじ"],["よう"],["に"],["しなければ"],["ならない"],["。"],["彼","かれ"],["の"],["着物","きもの"],["について"],["も"],["同じ","おなじ"],["よう"],["に"],["しなければ"],["ならない"],["。"],["すべて"],["あなた"],["の"],["同族","どうぞく"],["の"],["者","もの"],["が"],["なくした"],["もの"],["を"],["、"],["あなた"],["が"],["見つけたなら","みつけたなら"],["、"],["同じ","おなじ"],["よう"],["に"],["しなければ"],["ならない"],["。"],["知らぬ","しらぬ"],["ふり"],["を"],["して"],["いる"],["こと"],["は"],["できない"],["。"]]},{"verse":4,"text":"あなたの同族の者のろば、または牛が道で倒れているのを見て、知らぬふりをしていてはならない。必ず、その者を助けて、それを起こさなければならない。","tok":[["あなた"],["の"],["同族","どうぞく"],["の"],["者","もの"],["の"],["ろば"],["、"],["また"],["は"],["牛","うし"],["が"],["道","みち"],["で"],["倒れて","たおれて"],["いる"],["の"],["を"],["見て","みて"],["、"],["知らぬ","しらぬ"],["ふり"],["を"],["して"],["いて"],["は"],["ならない"],["。"],["必ず","かならず"],["、"],["その"],["者","もの"],["を"],["助けて","たすけて"],["、"],["それ"],["を"],["起こさなければ","おこさなければ"],["ならない"],["。"]]},{"verse":5,"t
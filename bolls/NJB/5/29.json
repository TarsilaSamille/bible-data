[{"verse":1,"text":"これは、モアブの地で、主がモーセに命じて、イスラエル人と結ばせた契約のことばである。ホレブで彼らと結ばれた契約とは別である。","tok":[["これ"],["は"],["、"],["モアブ"],["の"],["地","ち"],["で"],["、"],["主","ぬし"],["が"],["モーセ"],["に"],["命じて","めいじて"],["、"],["イスラエル"],["人","にん"],["と"],["結ばせた","むすばせた"],["契約","けいやく"],["の"],["ことば"],["で"],["ある"],["。"],["ホレブ"],["で"],["彼","かれ"],["ら"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["と"],["は"],["別","べつ"],["で"],["ある"],["。"]]},{"verse":2,"text":"モーセは、イスラエルのすべてを呼び寄せて言った。あなたがたは、エジプトの地で、パロと、そのすべての家臣たちと、その全土とに対して、主があなたがたの目の前でなさった事を、ことごとく見た。","tok":[["モーセ"],["は"],["、"],["イスラエル"],["の"],["すべて"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["あなた"],["がた"],["は"],["、"],["エジプト"],["の"],["地","ち"],["で"],["、"],["パロ"],["と"],["、"],["その"],["すべて"],["の"],["家臣","かしん"],["たち"],["と"],["、"],["その"],["全土","ぜんど"],["と"],["に対して","にたいして"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["なさった"],["事","こと"],["を"],["、"],["ことごとく"],["見た","みた"],["。"]]},{"verse":3,"text":"あなたが、自分の目で見たあの大きな試み、それは大きなしるしと不思議であった。","tok":[["あなた"],["が"],["、"],["自分","じぶん"],["の"],["目","め"],["で"],["見た","みた"],["あの"],["大きな","おおきな"],["試み","こころみ"],["、"],["それ"],["は"],["大きな","おおきな"],["しるし"],["と"],["不思議","ふしぎ"],["で"],["あった"],["。"]]},{"verse":4,"text":"しかし、主は今日に至るまで、あなたがたに、悟る心と、見る目と、聞く耳を、下さらなかった。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["あなた"],["がた"],["に"],["、"],["悟る","さとる"],["心","こころ"],["と"],["、"],["見る","みる"],["目","め"],["と"],["、"],["聞く","きく"],["耳","みみ"],["を"],["、"],["下さらなかった","くださらなかった"],["。"]]},{"verse":5,"text":"私は、四十年の間、あなたがたに荒野を行かせたが、あなたがたが身に着けている着物はすり切れず、その足のくつもすり切れなかった。","tok":[["私","わたくし"],["は"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["あなた"],["がた"],["に"],["荒野","あらの"],["を"],["行かせた","いかせた"],["が"],["、"],["あなた"],["がた"],["が"],["身","み"],["に"],["着けて","つけて"],["いる"],["着物","きもの"],["は"],["すり切れず","すりきれず"],["、"],["その"],["足","あし"],["の"],["くつ"],["も"],["すり切れなかった","すりきれなかった"],["。"]]},{"verse":6,"text":"あなたがたはパンも食べず、また、ぶどう酒も強い酒も飲まなかった。それは、「わたしが、あなたがたの神、主である」と、あなたがたが知るためであった。","tok":[["あなた"],["がた"],["は"],["パン"],["も"],["食べず","たべず"],["、"],["また"],["、"],["ぶどう酒","ぶどうしゅ"],["も"],["強い","つよい"],["酒","さけ"],["も"],["飲まなかった","のまなかった"],["。"],["それ"],["は"],["、"],["「"],["わたし"],["が"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["」"],["と"],["、"],["あなた"],["がた"],["が"],["知る","しる"],["ため"],["で"],["あった"],["。"]]},{"verse":7,"text":"あなたがたが、この所に来たとき、ヘシュボンの王シホンとバシャンの王オグが出て来て、私たちを迎えて戦ったが、私たちは彼らを打ち破った。","tok":[["あなた"],["が"],["た"],["が"],["、"],["この"],["所","ところ"],["に"],["来た","きた"],["とき"],["、"],["ヘシュボン"],["の"],["王","おう"],["シホン"],["と"],["バシャン"],["の"],["王","おう"],["オグ"],["が"],["出て","でて"],["来て","きて"],["、"],["私たち","わたしたち"],["を"],["迎えて","むかえて"],["戦った","たたかった"],["が"],["、"],["私たち","わたしたち"],["は"],["彼","かれ"],["ら"],["を"],["打ち破った","うちやぶった"],["。"]]},{"verse":8,"text":"私たちは、彼らの国を取り、これを相続地としてルベン人と、ガド人と、マナセ人の半部族とに、分け与えた。","tok":[["私たち","わたしたち"],["は"],["、"],["彼","かれ"],["ら"],["の"],["国","くに"],["を"],["取り","とり"],["、"],["これ"],["を"],["相続","そうぞく"],["地","ち"],["として"],["ルベン人","るべんにん"],["と"],["、"],["ガド人","がどにん"],["と"],["、"],["マナセ人","まなせにん"],["の"],["半","はん"],["部族","ぶぞく"],["と"],["に"],["、"],["分け与えた","わけあたえた"],["。"]]},{"verse":9,"text":"あなたがたは、この契約のことばを守り、行いなさい。あなたがたのすることがみな、栄えるためである。","tok":[["あなた"],["がた"],["は"],["、"],["この"],["契約","けいやく"],["の"],["ことば"],["を"],["守り","まもり"],["、"],["行い","おこない"],["なさい"],["。"],["あなた"],["がた"],["の"],["する"],["こと"],["が"],["みな"],["、"],["栄える","さかえる"],["ため"],["で"],["ある"],["。"]]},{"verse":10,"text":"きょう、あなたがたはみな、あなたがたの神、主の前に立っている。すなわち、あなたがたの部族のかしらたち、長老たち、つかさたち、イスラエルのすべての人々、","tok":[["きょう"],["、"],["あなた"],["がた"],["は"],["みな"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["立って","たって"],["いる"],["。"],["すなわち"],["、"],["あなた"],["がた"],["の"],["部族","ぶぞく"],["の"],["かしら"],["たち"],["、"],["長老","ちょうろう"],["たち"],["、"],["つかさ"],["たち"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["、"]]},{"verse":11,"text":"あなたがたの子どもたち、妻たち、宿営のうちにいる在留異国人、たきぎを割る者から水を汲む者に至るまで。","tok":[["あなた"],["がた"],["の"],["子ども","こども"],["たち"],["、"],["妻たち","つまたち"],["、"],["宿営","しゅくえい"],["の"],["うち"],
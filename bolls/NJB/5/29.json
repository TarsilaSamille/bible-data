],["異邦","いほう"],["の"],["民","たみ"],["の"],["中","なか"],["を"],["通って","とおって"],["来た","きた"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":17,"text":"また、あなたがたは、彼らのところにある忌むべきもの、木や石や銀や金の偶像を見た。","tok":[["また"],["、"],["あなた"],["がた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["ある"],["忌むべき","いむべき"],["もの"],["、"],["木","き"],["や"],["石","いし"],["や"],["銀","ぎん"],["や"],["金","きん"],["の"],["偶像","ぐうぞう"],["を"],["見た","みた"],["。"]]},{"verse":18,"text":"万が一にも、あなたがたのうちに、きょう、その心が私たちの神、主を離れて、これらの異邦の民の神々に行って、仕えるような、男や女、氏族や部族があってはならない。あなたがたのうちに、毒草や、苦よもぎを生ずる根があってはならない。","tok":[["万が一","まんがいち"],["に"],["も"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["きょう"],["、"],["その"],["心","こころ"],["が"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["離れて","はなれて"],["、"],["これ"],["ら"],["の"],["異邦","いほう"],["の"],["民","たみ"],["の"],["神々","かみがみ"],["に"],["行って","いって"],["、"],["仕える","つかえる"],["よう"],["な"],["、"],["男","おとこ"],["や"],["女","おんな"],["、"],["氏族","しぞく"],["や"],["部族","ぶぞく"],["が"],["あって"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["毒草","どくそう"],["や"],["、"],["苦","く"],["よもぎ"],["を"],["生ずる","しょうずる"],["根","ね"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":19,"text":"こののろいの誓いのことばを聞いたとき、「潤ったものも渇いたものもひとしく滅びるのであれば、私は自分のかたくなな心のままに歩いても、私には平和がある」と心の中で自分を祝福する者があるなら、","tok":[["この"],["のろい"],["の"],["誓い","ちかい"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["「"],["潤った","うるおった"],["もの"],["も"],["渇いた","かわいた"],["もの"],["も"],["ひとしく"],["滅びる","ほろびる"],["ので"],["あれば"],["、"],["私","わたくし"],["は"],["自分","じぶん"],["の"],["かたくな"],["な"],["心","こころ"],["の"],["まま"],["に"],["歩いて","あるいて"],["も"],["、"],["私","わたくし"],["に"],["は"],["平和","へいわ"],["が"],["ある"],["」"],["と"],["心","こころ"],["の"],["中","なか"],["で"],["自分","じぶん"],["を"],["祝福","しゅくふく"],["する"],["者","もの"],["が"],["あるなら"],["、"]]},{"verse":20,"text":"主はその者を決して赦そうとはされない。むしろ、主の怒りとねたみが、その者に対して燃え上がり、この書にしるされたすべてののろいの誓いがその者の上にのしかかり、主は、その者の名を天の下から消し去ってしまう。","tok":[["主","ぬし"],["は"],["その"],["者","もの"],["を"],["決して","けっして"],["赦そう","ゆるそう"],["と"],["は"],["されない"],["。"],["むしろ"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["と"]
[{"verse":1,"text":"悪性の欠陥のある牛や羊を、あなたの神、主にいけにえとしてささげてはならない。それは、あなたの神、主の忌みきらわれるものだからである。","tok":[["悪性","あくせい"],["の"],["欠陥","けっかん"],["の"],["ある"],["牛","うし"],["や"],["羊","ひつじ"],["を"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["いけにえ"],["として"],["ささげて"],["は"],["ならない"],["。"],["それ"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["忌みきらわれる","いみきらわれる"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたの神、主があなたに与えようとしておられる町囲みのどれでも、その中で、男であれ、女であれ、あなたの神、主の目の前に悪を行い、主の契約を破り、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えよう","あたえよう"],["として"],["おられる"],["町","まち"],["囲み","かこみ"],["の"],["どれ"],["で"],["も"],["、"],["その"],["中","なか"],["で"],["、"],["男","おとこ"],["で"],["あれ"],["、"],["女","おんな"],["で"],["あれ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行い","おこない"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"]]},{"verse":3,"text":"行ってほかの神々に仕え、また、日や月や天の万象など、私が命じもしなかったものを拝む者があり、","tok":[["行って","いって"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕え","つかえ"],["、"],["また"],["、"],["日","ひ"],["や"],["月","つき"],["や"],["天","てん"],["の"],["万象","ばんしょう"],["など"],["、"],["私","わたくし"],["が"],["命じ","めいじ"],["も"],["しなかった"],["もの"],["を"],["拝む","おがむ"],["者","もの"],["が"],["あり"],["、"]]},{"verse":4,"text":"それがあなたに告げられて、あなたが聞いたなら、あなたはよく調査しなさい。もし、そのことが事実で、確かであり、この忌みきらうべきことがイスラエルのうちに行われたのなら、","tok":[["それ"],["が"],["あなた"],["に"],["告げられて","つげられて"],["、"],["あなた"],["が"],["聞いたなら","きいたなら"],["、"],["あなた"],["は"],["よく"],["調査","ちょうさ"],["し"],["なさい"],["。"],["もし"],["、"],["その"],["こと"],["が"],["事実","じじつ"],["で"],["、"],["確か","たしか"],["で"],["あり"],["、"],["この"],["忌みきらうべき","いみきらうべき"],["こと"],["が"],["イスラエル"],["の"],["うち"],["に"],["行われた","おこなわれた"],["の"],["なら"],["、"]]},{"verse":5,"text":"あなたは、この悪事を行った男または女を町の広場に連れ出し、男でも女でも、彼らを石で打ちなさい。彼らは死ななければならない。","tok":[["あなた"],["は"],["、"],["この"],["悪事","あくじ"],["を"],["行った","おこなった"],["男","おとこ"],["また"],["は"],["女","おんな"],["を"],["町","まち"],["の"],["広場","ひろば"],["に"],["連れ出し","つれだし"],["、"],["男","おとこ"],["で"],["も"],["女","おんな"],["で"],["も"],["、"],["彼","かれ"],["ら"],["を"],["石","いし"],["で"],["打ち","うち"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["死ななければ","しななければ"],["ならない"],["。"]]},{"verse":6,"text":"ふたりの証人または三人の証人の証言によって、死刑に処さなければならない。ひとりの証言で死刑にしてはならない。","tok":[["ふたり"],["の"],["証人","しょうにん"],["また"],["は"],["三人","さんにん"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["によって"],["、"],["死刑","しけい"],["に"],["処さなければ","しょさなければ"],["ならない"],["。"],["ひとり"],["の"],["証言","しょうげん"],["で"],["死刑","しけい"],["に"],["して"],["は"],["ならない"],["。"]]},{"verse":7,"text":"死刑に処するには、まず証人たちが手を下し、ついで、民がみな、手を下さなければならない。こうしてあなたがたのうちから悪を除き去りなさい。","tok":[["死刑","しけい"],["に"],["処する","しょする"],["に"],["は"],["、"],["まず"],["証人","しょうにん"],["たち"],["が"],["手","て"],["を"],["下し","くだし"],["、"],["つい"],["で"],["、"],["民","みん"],["が"],["みな"],["、"],["手","て"],["を"],["下さなければ","くださなければ"],["ならない"],["。"],["こう"],["して"],["あなた"],["がた"],["の"],["うち"],["から"],["悪","あく"],["を"],["除き去り","のぞきさり"],["なさい"],["。"]]},{"verse":8,"text":"もし、町囲みのうちで争い事が起こり、それが流血事件、権利の訴訟、暴力事件で、あなたのさばきかねるものであれば、ただちに、あなたの神、主の選ぶ場所に上り、","tok":[["もし"],["、"],["町","まち"],["囲み","かこみ"],["の"],["うち"],["で"],["争い事","あらそいごと"],["が"],["起こり","おこり"],["、"],["それ"],["が"],["流血","りゅうけつ"],["事件","じけん"],["、"],["権利","けんり"],["の"],["訴訟","そしょう"],["、"],["暴力","ぼうりょく"],["事件","じけん"],["で"],["、"],["あなた"],["の"],["さばき"],["かねる"],["もの"],["で"],["あれば"],["、"],["ただちに"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["選ぶ","えらぶ"],["場所","ばしょ"],["に"],["上り","のぼり"],["、"]]},{"verse":9,"text":"レビ人の祭司たち、あるいは、その時に立てられているさばきつかさのもとに行き、尋ねなさい。彼らは、あなたに判決のことばを告げよう。","tok":[["レビ人","れびにん"],["の"],["祭司","さいし"],["たち"],["、"],["あるいは"],["、"],["その"],["時","とき"],["に"],["立てられて","たてられて"],["いる"],["さばき"],["つかさ"],["の"],["もと"],["に"],["行き","いき"],["、"],["尋ね","たずね"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["に"],["判決","はんけつ"],["の"],["ことば"],["を"],["告げよう","つげよう"],["。"]]},{"verse":10,"text":"あなたは、主が選ぶその場所で、彼らが告げる判決によって行い、すべて彼らがあなたに教えることを守り行いなさい。","tok":[["あなた"],["は"],["、"],["主","ぬし"],["が"],["選ぶ","えらぶ"],["その"],["場所","ばしょ"],["で"],["、"],["彼","かれ"],["ら"],["が"],["告げる","つげる"],["判決","はんけつ"],["によって"],["行い","おこない"],["、"],["すべて"],["彼","かれ"],["ら"],["が"],["あなた"],["に"],["教える","おしえる"],["こと"],["を"],["守り","まもり"],["行い","おこない"],["なさい"],["。"]]},{"verse":11,"text":"彼らが教えるおしえによって、彼らが述べるさばきによって行わなければならない。彼らが告げる判決から右にも左にもそれてはならない。","tok":[["彼","かれ"],["ら"],["が"],["教える","おしえる"],["おしえ"],["によって"],["、"],["彼","かれ"],["ら"],["が"],["述べる","のべる"],["さばき"],["によって"],["行わなければ","おこなわなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["告げる","つげる"],["判決","はんけつ"],["から"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それ"],["て"],["は"],["ならない"],["。"]]},{"verse":12,"text":"もし人が、あなたの神、主に仕えてそこに立つ祭司やさばきつかさに聞き従わず、不遜なふるまいをするなら、その者は死ななければならない。あなたがイスラエルのうちから悪を除き去るなら、","tok":[["もし"],["人","ひと"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["仕えて","つかえて"],["そこ"],["に"],["立つ","たつ"],["祭司","さいし"],["や"],["さばき"],["つかさ"],["に"],["聞き従わず","ききしたがわず"],["、"],["不遜","ふそん"],["な"],["ふるまい"],["を"],["するなら"],["、"],["その"],["者","もの"],["は"],["死ななければ","しななければ"],["ならない"],["。"],["あなた"],["が"],["イスラエル"],["の"],["うち"],["から"],["悪","あく"],["を"],["除き去るなら","のぞきさるなら"],["、"]]},{"verse":13,"text":"民はみな、聞いて恐れ、不遜なふるまいをすることはもうないであろう。","tok":[["民","みん"],["は"],["みな"],["、"],["聞いて","きいて"],["恐れ","おそれ"],["、"],["不遜","ふそん"],["な"],["ふるまい"],["を"],["する"],["こと"],["は"],["もう"],["ないで"],["あろう"],["。"]]},{"verse":14,"text":"あなたの神、主があなたに与えようとしておられる地に入って行って、それを占領し、そこに住むようになったとき、あなたが、「回りのすべての国々と同じく、私も自分の上に王を立てたい」と言うなら、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えよう","あたえよう"],["として"],["おられる"],["地","ち"],["に"],["入って","はいって"],["行って","いって"],["、"],["それ"],["を"],["占領","せんりょう"],["し"],["、"],["そこ"],["に"],["住む","すむ"],["よう"],["に"],["なった"],["とき"],["、"],["あなた"],["が"],["、"],["「"],["回り","まわり"],["の"],["すべて"],["の"],["国々","くにぐに"],["と"],["同じく","おなじく"],["、"],["私","わたくし"],["も"],["自分","じぶん"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立てたい","たてたい"],["」"],["と"],["言うなら","ゆうなら"],["、"]]},{"verse":15,"text":"あなたの神、主の選ぶ者を、必ず、あなたの上に王として立てなければならない。あなたの同胞の中から、あなたの上に王を立てなければならない。同胞でない外国の人を、あなたの上に立てることはできない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["選ぶ","えらぶ"],["者","もの"],["を"],["、"],["必ず","かならず"],["、"],["あなた"],["の"],["上","うえ"],["に"],["王","おう"],["として"],["立てなければ","たてなければ"],["ならない"],["。"],["あなた"],["の"],["同胞","どうほう"],["の"],["中","なか"],["から"],["、"],["あなた"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立てなければ","たてなければ"],["ならない"],["。"],["同胞","どうほう"],["で"],["ない"],["外国","がいこく"],["の"],["人","ひと"],["を"],["、"],["あなた"],["の"],["上","うえ"],["に"],["立てる","たてる"],["こと"],["は"],["できない"],["。"]]},{"verse":16,"text":"王は、自分のために決して馬を多くふやしてはならない。馬をふやすためだといって民をエジプトに帰らせてはならない。「二度とこの道を帰ってはならない」と主はあなたがたに言われた。","tok":[["王","おう"],["は"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["決して","けっして"],["馬","うま"],["を"],["多く","おおく"],["ふやして"],["は"],["ならない"],["。"],["馬","うま"],["を"],["ふやす"],["ため"],["だ"],["と"],["いって"],["民","みん"],["を"],["エジプト"],["に"],["帰らせて","かえらせて"],["は"],["ならない"],["。"],["「"],["二","に"],["度","ど"],["と"],["この"],["道","みち"],["を"],["帰って","かえって"],["は"],["ならない"],["」"],["と"],["主","ぬし"],["は"],["あなた"],["がた"],["に"],["言われた","いわれた"],["。"]]},{"verse":17,"text":"多くの妻を持ってはならない。心をそらせてはならない。自分のために金銀を非常に多くふやしてはならない。","tok":[["多く","おおく"],["の"],["妻","つま"],["を"],["持って","もって"],["は"],["ならない"],["。"],["心","こころ"],["を"],["そらせて"],["は"],["ならない"],["。"],["自分","じぶん"],["の"],["ため"],["に"],["金銀","きんぎん"],["を"],["非常","ひじょう"],["に"],["多く","おおく"],["ふやして"],["は"],["ならない"],["。"]]},{"verse":18,"text":"彼がその王国の王座に着くようになったなら、レビ人の祭司たちの前のものから、自分のために、このみおしえを書き写して、","tok":[["彼","かれ"],["が"],["その"],["王国","おうこく"],["の"],["王座","おうざ"],["に"],["着く","つく"],["よう"],["に"],["なったなら"],["、"],["レビ人","れびにん"],["の"],["祭司","さいし"],["たち"],["の"],["前","まえ"],["の"],["もの"],["から"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["、"],["この"],["みおしえ"],["を"],["書き写して","かきうつして"],["、"]]},{"verse":19,"text":"自分の手もとに置き、一生の間、これを読まなければならない。それは、彼の神、主を恐れ、このみおしえのすべてのことばとこれらのおきてとを守り行うことを学ぶためである。","tok":[["自分","じぶん"],["の"],["手もと","てもと"],["に"],["置き","おき"],["、"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["これ"],["を"],["読まなければ","よまなければ"],["ならない"],["。"],["それ"],["は"],["、"],["彼","かれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["恐れ","おそれ"],["、"],["この"],["みおしえ"],["の"],["すべて"],["の"],["ことば"],["と"],["これ"],["ら"],["の"],["おきて"],["と"],["を"],["守り","まもり"],["行う","おこなう"],["こと"],["を"],["学ぶ","まなぶ"],["ため"],["で"],["ある"],["。"]]},{"verse":20,"text":"それは、王の心が自分の同胞の上に高ぶることがないため、また命令から、右にも左にもそれることがなく、彼とその子孫とがイスラエルのうちで、長くその王国を治めることができるためである。","tok":[["それ"],["は"],["、"],["王","おう"],["の"],["心","こころ"],["が"],["自分","じぶん"],["の"],["同胞","どうほう"],["の"],["上","うえ"],["に"],["高ぶる","たかぶる"],["こと"],["が"],["ない"],["ため"],["、"],["また"],["命令","めいれい"],["から"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それる"],["こと"],["が"],["なく"],["、"],["彼","かれ"],["と"],["その"],["子孫","しそん"],["と"],["が"],["イスラエル"],["の"],["うち"],["で"],["、"],["長く","ながく"],["その"],["王国","おうこく"],["を"],["治める","おさめる"],["こと"],["が"],["できる"],["ため"],["で"],["ある"],["。"]]}]
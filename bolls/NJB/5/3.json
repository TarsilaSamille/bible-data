[{"verse":1,"text":"私たちはバシャンへの道を上って行った。するとバシャンの王オグとそのすべての民は、エデレイで私たちを迎えて戦うために出て来た。","tok":[["私たち","わたしたち"],["は"],["バシャン"],["へ"],["の"],["道","みち"],["を"],["上って","のぼって"],["行った","いった"],["。"],["する"],["と"],["バシャン"],["の"],["王","おう"],["オグ"],["と"],["その"],["すべて"],["の"],["民","たみ"],["は"],["、"],["エデレイ"],["で"],["私たち","わたしたち"],["を"],["迎えて","むかえて"],["戦う","たたかう"],["ため"],["に"],["出て","でて"],["来た","きた"],["。"]]},{"verse":2,"text":"そのとき、主は私に仰せられた。「彼を恐れてはならない。わたしは、彼と、そのすべての民と、その地とを、あなたの手に渡している。あなたはヘシュボンに住んでいたエモリ人の王シホンにしたように、彼にしなければならない。」","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["「"],["彼","かれ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["と"],["、"],["その"],["すべて"],["の"],["民","たみ"],["と"],["、"],["その"],["地","ち"],["と"],["を"],["、"],["あなた"],["の"],["手","て"],["に"],["渡して","わたして"],["いる"],["。"],["あなた"],["は"],["ヘシュボン"],["に"],["住んで","すんで"],["いた"],["エモリ人","えもりにん"],["の"],["王","おう"],["シホン"],["に"],["した"],["よう"],["に"],["、"],["彼","かれ"],["に"],["しなければ"],["ならない"],["。"],["」"]]},{"verse":3,"text":"こうして私たちの神、主は、バシャンの王オグとそのすべての民をも、私たちの手に渡されたので、私たちはこれを打ち殺して、ひとりの生存者をも残さなかった。","tok":[["こう"],["して"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["と"],["その"],["すべて"],["の"],["民","たみ"],["を"],["も"],["、"],["私たち","わたしたち"],["の"],["手","て"],["に"],["渡された","わたされた"],["ので"],["、"],["私たち","わたしたち"],["は"],["これ"],["を"],["打ち殺して","うちころして"],["、"],["ひとり"],["の"],["生存者","せいぞんしゃ"],["を"],["も"],["残さなかった","のこさなかった"],["。"]]},{"verse":4,"text":"そのとき、私たちは彼の町々をことごとく攻め取った。私たちが取らなかった町は一つもなかった。取った町は六十、アルゴブの全地域であって、バシャンのオグの王国であった。","tok":[["その"],["とき"],["、"],["私たち","わたしたち"],["は"],["彼","かれ"],["の"],["町々","まちまち"],["を"],["ことごとく"],["攻め取った","せめとった"],["。"],["私たち","わたしたち"],["が"],["取らなかった","とらなかった"],["町","まち"],["は"],["一","ひと"],["つ"],["も"],["なかった"],["。"],["取った","とった"],["町","まち"],["は"],["六十","ろくじゅう"],["、"],["アルゴブ"],["の"],["全","ぜん"],["地域","ちいき"],["で"],["あって"],["、"],["バシャン"],["の"],["オグ"],["の"],["王国","おうこく"],["で"],["あった"],["。"]]},{"verse":5,"text":"これらはみな、高い城壁と門とかんぬきのある要害の町々であった。このほかに、城壁のない町々が非常に多くあった。","tok":[["これ"],["ら"],["は"],["みな"],["、"],["高い","たかい"],["城壁","じょうへき"],["と"],["門","もん"],["と"],["かんぬき"],["の"],["ある"],["要害","ようがい"],["の"],["町々","まちまち"],["で"],["あった"],["。"],["この"],["ほか"],["に"],["、"],["城壁","じょうへき"],["の"],["ない"],["町々","まちまち"],["が"],["非常","ひじょう"],["に"],["多く","おおく"],["あった"],["。"]]},{"verse":6,"text":"私たちはヘシュボンの王シホンにしたように、これらを聖絶した。そのすべての町々――男、女および子ども――を聖絶した。","tok":[["私たち","わたしたち"],["は"],["ヘシュボン"],["の"],["王","おう"],["シホン"],["に"],["した"],["よう"],["に"],["、"],["これ"],["ら"],["を"],["聖","せい"],["絶した","ぜっした"],["。"],["その"],["すべて"],["の"],["町々","まちまち"],["―"],["―"],["男","おとこ"],["、"],["女","おんな"],["および"],["子ども","こども"],["―"],["―"],["を"],["聖","せい"],["絶した","ぜっした"],["。"]]},{"verse":7,"text":"ただし、すべての家畜と、私たちが取った町々で略奪した物とは私たちのものとした。","tok":[["ただし"],["、"],["すべて"],["の"],["家畜","かちく"],["と"],["、"],["私たち","わたしたち"],["が"],["取った","とった"],["町々","まちまち"],["で"],["略奪","りゃくだつ"],["した"],["物","もの"],["と"],["は"],["私たち","わたしたち"],["の"],["もの"],["と"],["した"],["。"]]},{"verse":8,"text":"このようにして、そのとき、私たちは、ふたりのエモリ人の王の手から、ヨルダンの向こうの地を、アルノン川からヘルモン山まで取った。","tok":[["この"],["よう"],["に"],["して"],["、"],["その"],["とき"],["、"],["私たち","わたしたち"],["は"],["、"],["ふたり"],["の"],["エモリ人","えもりにん"],["の"],["王","おう"],["の"],["手","て"],["から"],["、"],["ヨルダン"],["の"],["向こう","むこう"],["の"],["地","ち"],["を"],["、"],["アルノン"],["川","かわ"],["から"],["ヘルモン"],["山","やま"],["まで"],["取った","とった"],["。"]]},{"verse":9,"text":"――シドン人はヘルモンをシルヨンと呼び、エモリ人はこれをセニルと呼んでいる――","tok":[["―"],["―"],["シドン人","しどんにん"],["は"],["ヘルモン"],["を"],["シルヨン"],["と"],["呼び","よび"],["、"],["エモリ人","えもりにん"],["は"],["これ"],["を"],["セニル"],["と"],["呼んで","よんで"],["いる"],["―"],["―"]]},{"verse":10,"text":"すなわち、高原のすべての町、ギルアデの全土、バシャンの全土、サルカおよびエデレイまでのバシャンのオグの王国の町々である。","tok":[["すなわち"],["、"],["高原","こうげん"],["の"],["すべて"],["の"],["町","まち"],["、"],["ギルアデ"],["の"],["全土","ぜんど"],["、"],["バシャン"],["の"],["全土","ぜんど"],["、"],["サルカ"],["および"],["エデレイ"],["まで"],["の"],["バシャン"],["の"],["オグ"],["の"],["王国","おうこく"],["の"],["町々","まちまち"],["で"],["ある"],["。"]]},{"verse":11,"text":"――バシャンの王オグだけが、レファイムの生存者として残っていた。見よ。彼の寝台は鉄の寝台、それはアモン人のラバにあるではないか。その長さは、規準のキュビトで九キュビト、その幅は四キュビトである――","tok":[["―"],["―"],["バシャン"],["の"],["王","おう"],["オグ"],["だけ"],["が"],["、"],["レファイム"],["の"],["生存者","せいぞんしゃ"],["として"],["残って","のこって"],["いた"],["。"],["見","み"],["よ"],["。"],["彼","かれ"],["の"],["寝台","しんだい"],["は"],["鉄","てつ"],["の"],["寝台","しんだい"],["、"],["それ"],["は"],["アモン人","あもんにん"],["の"],["ラバ"],["に"],["ある"],["で"],["は"],["ない"],["か"],["。"],["その"],["長さ","ながさ"],["は"],["、"],["規準","きじゅん"],["の"],["キュビト"],["で"],["九","きゅう"],["キュビト"],["、"],["その"],["幅","はば"],["は"],["四","よん"],["キュビト"],["で"],["ある"],["―"],["―"]]},{"verse":12,"text":"この地を、私たちは、そのとき、占領した。アルノン川のほとりのアロエルの一部と、ギルアデの山地の半分と、その町々とを私はルベン人とガド人とに与えた。","tok":[["この"],["地","ち"],["を"],["、"],["私たち","わたしたち"],["は"],["、"],["その"],["とき"],["、"],["占領","せんりょう"],["した"],["。"],["アルノン"],["川","かわ"],["の"],["ほとり"],["の"],["アロエル"],["の"],["一部","いちぶ"],["と"],["、"],["ギルアデ"],["の"],["山地","さんち"],["の"],["半分","はんぶん"],["と"],["、"],["その"],["町々","まちまち"],["と"],["を"],["私","わたくし"],["は"],["ルベン人","るべんにん"],["と"],["ガド人","がどにん"],["と"],["に"],["与えた","あたえた"],["。"]]},{"verse":13,"text":"ギルアデの残りと、オグの王国であったバシャンの全土とは、マナセの半部族に与えた。それはアルゴブの全地域で、そのバシャンの全土はレファイムの国と呼ばれている。","tok":[["ギルアデ"],["の"],["残り","のこり"],["と"],["、"],["オグ"],["の"],["王国","おうこく"],["で"],["あった"],["バシャン"],["の"],["全土","ぜんど"],["と"],["は"],["、"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["与えた","あたえた"],["。"],["それ"],["は"],["アルゴブ"],["の"],["全","ぜん"],["地域","ちいき"],["で"],["、"],["その"],["バシャン"],["の"],["全土","ぜんど"],["は"],["レファイム"],["の"],["国","くに"],["と"],["呼ばれて","よばれて"],["いる"],["。"]]},{"verse":14,"text":"マナセの子ヤイルは、ゲシュル人とマアカ人との境界までのアルゴブの全地域を取り、自分の名にちなんで、バシャンをハボテ・ヤイルと名づけて、今日に至っている。","tok":[["マナセ"],["の"],["子","こ"],["ヤイル"],["は"],["、"],["ゲシュル"],["人","にん"],["と"],["マアカ人","まあかにん"],["と"],["の"],["境界","きょうかい"],["まで"],["の"],["アルゴブ"],["の"],["全","ぜん"],["地域","ちいき"],["を"],["取り","とり"],["、"],["自分","じぶん"],["の"],["名","な"],["に"],["ちなんで"],["、"],["バシャン"],["を"],["ハボテ"],["・"],["ヤイル"],["と"],["名づけて","なづけて"],["、"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":15,"text":"マキルには私はギルアデを与えた。","tok":[["マキル"],["に"],["は"],["私","わたくし"],["は"],["ギルアデ"],["を"],["与えた","あたえた"],["。"]]},{"verse":16,"text":"ルベン人とガド人には、ギルアデからアルノン川の、国境にあたる川の真ん中まで、またアモン人の国境ヤボク川までを与えた。","tok":[["ルベン人","るべんにん"],["と"],["ガド人","がどにん"],["に"],["は"],["、"],["ギルアデ"],["から"],["アルノン"],["川","かわ"],["の"],["、"],["国境","こっきょう"],["に"],["あたる"],["川","かわ"],["の"],["真ん中","まんなか"],["まで"],["、"],["また"],["アモン人","あもんにん"],["の"],["国境","こっきょう"],["ヤボク"],["川","かわ"],["まで"],["を"],["与えた","あたえた"],["。"]]},{"verse":17,"text":"またアラバをも与えた。それはヨルダンを境界として、キネレテからアラバの海、すなわち、東のほうのピスガの傾斜地のふもとにある塩の海までであった。","tok":[["また"],["アラバ"],["を"],["も"],["与えた","あたえた"],["。"],["それ"],["は"],["ヨルダン"],["を"],["境界","きょうかい"],["として"],["、"],["キネレテ"],["から"],["アラバ"],["の"],["海","うみ"],["、"],["すなわち"],["、"],["東","ひがし"],["の"],["ほう"],["の"],["ピスガ"],["の"],["傾斜地","けいしゃち"],["の"],["ふもと"],["に"],["ある"],["塩","しお"],["の"],["海","うみ"],["まで"],["で"],["あった"],["。"]]},{"verse":18,"text":"私はそのとき、あなたがたに命じて言った。「あなたがたの神、主は、あなたがたがこの地を所有するように、あなたがたに与えられた。しかし、勇士たちはみな武装して、同族、イスラエル人の先に立って渡って行かなければならない。","tok":[["私","わたくし"],["は"],["その"],["とき"],["、"],["あなた"],["がた"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["が"],["この"],["地","ち"],["を"],["所有","しょゆう"],["する"],["よう"],["に"],["、"],["あなた"],["がた"],["に"],["与えられた","あたえられた"],["。"],["しかし"],["、"],["勇士","ゆうし"],["たち"],["は"],["みな"],["武装","ぶそう"],["して"],["、"],["同族","どうぞく"],["、"],["イスラエル"],["人","にん"],["の"],["先","さき"],["に"],["立って","たって"],["渡って","わたって"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":19,"text":"ただし、あなたがたの妻と子どもと家畜は、私が与えた町々にとどまっていてもよい。私はあなたがたが家畜を多く持っているのを知っている。","tok":[["ただし"],["、"],["あなた"],["がた"],["の"],["妻","つま"],["と"],["子ども","こども"],["と"],["家畜","かちく"],["は"],["、"],["私","わたくし"],["が"],["与えた","あたえた"],["町々","まちまち"],["に"],["とどまって"],["いて"],["も"],["よい"],["。"],["私","わたくし"],["は"],["あなた"],["がた"],["が"],["家畜","かちく"],["を"],["多く","おおく"],["持って","もって"],["いる"],["の"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":20,"text":"主があなたがたと同じように、あなたがたの同族に安住の地を与え、彼らもまた、ヨルダンの向こうで、あなたがたの神、主が与えようとしておられる地を所有するようになったなら、そのとき、あなたがたは、おのおの私が与えた自分の所有地に帰ることができる。」","tok":[["主","ぬし"],["が"],["あなた"],["がた"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["同族","どうぞく"],["に"],["安住","あんじゅう"],["の"],["地","ち"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["ら"],["も"],["また"],["、"],["ヨルダン"],["の"],["向こう","むこう"],["で"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えよう","あたえよう"],["として"],["おられる"],["地","ち"],["を"],["所有","しょゆう"],["する"],["よう"],["に"],["なったなら"],["、"],["その"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["おのおの"],["私","わたくし"],["が"],["与えた","あたえた"],["自分","じぶん"],["の"],["所有地","しょゆうち"],["に"],["帰る","かえる"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":21,"text":"私は、そのとき、ヨシュアに命じて言った。「あなたは、あなたがたの神、主が、これらふたりの王になさったすべてのことをその目で見た。主はあなたがたがこれから渡って行くすべての国々にも、同じようにされる。","tok":[["私","わたくし"],["は"],["、"],["その"],["とき"],["、"],["ヨシュア"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["これ"],["ら"],["ふたり"],["の"],["王","おう"],["に"],["なさった"],["すべて"],["の"],["こと"],["を"],["その"],["目","め"],["で"],["見た","みた"],["。"],["主","ぬし"],["は"],["あなた"],["がた"],["が"],["これ"],["から"],["渡って","わたって"],["行く","いく"],["すべて"],["の"],["国々","くにぐに"],["に"],["も"],["、"],["同じ","おなじ"],["よう"],["に"],["される"],["。"]]},{"verse":22,"text":"彼らを恐れてはならない。あなたがたのために戦われるのはあなたがたの神、主であるからだ。」","tok":[["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["ため"],["に"],["戦われる","たたかわれる"],["の"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["から"],["だ"],["。"],["」"]]},{"verse":23,"text":"私は、そのとき、主に懇願して言った。","tok":[["私","わたくし"],["は"],["、"],["その"],["とき"],["、"],["主に","おもに"],["懇願","こんがん"],["して"],["言った","いった"],["。"]]},{"verse":24,"text":"「神、主よ。あなたの偉大さと、あなたの力強い御手とを、あなたはこのしもべに示し始められました。あなたのわざ、あなたの力あるわざのようなことのできる神が、天、あるいは地にあるでしょうか。","tok":[["「"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["偉大","いだい"],["さ"],["と"],["、"],["あなた"],["の"],["力強い","ちからづよい"],["御手","おて"],["と"],["を"],["、"],["あなた"],["は"],["この"],["しもべ"],["に"],["示し","しめし"],["始められました","はじめられました"],["。"],["あなた"],["の"],["わざ"],["、"],["あなた"],["の"],["力","ちから"],["ある"],["わざ"],["の"],["よう"],["な"],["こと"],["の"],["できる"],["神","かみ"],["が"],["、"],["天","てん"],["、"],["あるいは"],["地","ち"],["に"],["あるでしょう"],["か"],["。"]]},{"verse":25,"text":"どうか、私に、渡って行って、ヨルダンの向こうにある良い地、あの良い山地、およびレバノンを見させてください。」","tok":[["どう"],["か"],["、"],["私","わたくし"],["に"],["、"],["渡って","わたって"],["行って","いって"],["、"],["ヨルダン"],["の"],["向こう","むこう"],["に"],["ある"],["良い","よい"],["地","ち"],["、"],["あの"],["良い","よい"],["山地","さんち"],["、"],["および"],["レバノン"],["を"],["見させて","みさせて"],["ください"],["。"],["」"]]},{"verse":26,"text":"しかし主は、あなたがたのために私を怒り、私の願いを聞き入れてくださらなかった。そして主は私に言われた。「もう十分だ。このことについては、もう二度とわたしに言ってはならない。","tok":[["しかし"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["私","わたくし"],["を"],["怒り","おこり"],["、"],["私","わたくし"],["の"],["願い","ねがい"],["を"],["聞き入れて","ききいれて"],["くださらなかった"],["。"],["そして"],["主","ぬし"],["は"],["私","わたくし"],["に"],["言われた","いわれた"],["。"],["「"],["もう"],["十分","じゅうぶん"],["だ"],["。"],["この"],["こと"],["について"],["は"],["、"],["もう"],["二","に"],["度","ど"],["と"],["わたし"],["に"],["言って","いって"],["は"],["ならない"],["。"]]},{"verse":27,"text":"ピスガの頂に登って、目を上げて西、北、南、東を見よ。あなたのその目でよく見よ。あなたはこのヨルダンを渡ることができないからだ。","tok":[["ピスガ"],["の"],["頂","いただき"],["に"],["登って","のぼって"],["、"],["目","め"],["を"],["上げて","あげて"],["西","にし"],["、"],["北","きた"],["、"],["南","みなみ"],["、"],["東","ひがし"],["を"],["見よ","みよ"],["。"],["あなた"],["の"],["その"],["目","め"],["で"],["よく"],["見よ","みよ"],["。"],["あなた"],["は"],["この"],["ヨルダン"],["を"],["渡る","わたる"],["こと"],["が"],["できない"],["から"],["だ"],["。"]]},{"verse":28,"text":"ヨシュアに命じ、彼を力づけ、彼を励ませ。彼はこの民の先に立って渡って行き、あなたの見るあの地を彼らに受け継がせるであろう。」","tok":[["ヨシュア"],["に"],["命じ","めいじ"],["、"],["彼","かれ"],["を"],["力づけ","ちからづけ"],["、"],["彼","かれ"],["を"],["励ませ","はげませ"],["。"],["彼","かれ"],["は"],["この"],["民","たみ"],["の"],["先","さき"],["に"],["立って","たって"],["渡って","わたって"],["行き","いき"],["、"],["あなた"],["の"],["見る","みる"],["あの"],["地","ち"],["を"],["彼","かれ"],["ら"],["に"],["受け継がせるで","うけつがせるで"],["あろう"],["。"],["」"]]},{"verse":29,"text":"こうして私たちはベテ・ペオルの近くの谷にとどまっていた。","tok":[["こう"],["して"],["私たち","わたしたち"],["は"],["ベテ"],["・"],["ペオル"],["の"],["近く","ちかく"],["の"],["谷","たに"],["に"],["とどまって"],["いた"],["。"]]}]
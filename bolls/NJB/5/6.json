に"],["なり"],["、"],["主","ぬし"],["が"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["あの"],["良い","よい"],["地","ち"],["を"],["所有","しょゆう"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":19,"text":"そうして、主が告げられたように、あなたの敵は、ことごとくあなたの前から追い払われる。","tok":[["そう"],["して"],["、"],["主","ぬし"],["が"],["告げられた","つげられた"],["よう"],["に"],["、"],["あなた"],["の"],["敵","てき"],["は"],["、"],["ことごとく"],["あなた"],["の"],["前","まえ"],["から"],["追い払われる","おいはらわれる"],["。"]]},{"verse":20,"text":"後になって、あなたの息子があなたに尋ねて、「私たちの神、主が、あなたがたに命じられた、このさとしとおきてと定めとは、どういうことか」と言うなら、","tok":[["後","あと"],["に"],["なって"],["、"],["あなた"],["の"],["息子","むすこ"],["が"],["あなた"],["に"],["尋ねて","たずねて"],["、"],["「"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["に"],["命じられた","めいじられた"],["、"],["この"],["さとし"],["と"],["おきて"],["と"],["定め","さだめ"],["と"],["は"],["、"],["どういう"],["こと"],["か"],["」"],["と"],["言うなら","ゆうなら"],["、"]]},{"verse":21,"text":"あなたは自分の息子にこう言いなさい。「私たちはエジプトでパロの奴隷であったが、主が力強い御手をもって、私たちをエジプトから連れ出された。","tok":[["あなた"],["は"],["自分","じぶん"],["の"],["息子","むすこ"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["「"],["私たち","わたしたち"],["は"],["エジプト"],["で"],["パロ"],["の"],["奴隷","どれい"],["で"],["あった"],["が"],["、"],["主","ぬし"],["が"],["力強い","ちからづよい"],["御手","おて"],["を"],["もって"],["、"],["私たち","わたしたち"],["を"],["エジプト"],["から"],["連れ出された","つれだされた"],["。"]]},{"verse":22,"text":"主は私たちの目の前で、エジプトに対し、パロとその全家族に対して大きくてむごいしるしと不思議とを行い、","tok":[["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["エジプト"],["に"],["対し","たいし"],["、"],["パロ"],["と"],["その"],["全","ぜん"],["家族","かぞく"],["に対して","にたいして"],["大きくて","おおきくて"],["むごい"],["しるし"],["と"],["不思議","ふしぎ"],["と"],["を"],["行い","おこない"],["、"]]},{"verse":23,"text":"私たちをそこから連れ出された。それは私たちの先祖たちに誓われた地に、私たちを入らせて、その地を私たちに与えるためであった。","tok":[["私たち","わたしたち"],["を"],["そこ"],["から"],["連れ出された","つれだされた"],["。"],["それ"],["は"],["私たち","わたしたち"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["地","ち"],["に"],["、"],["私たち","わたしたち"],["を"],["入らせて","はいらせて"],["、"],["その"],["地","ち"],["を"],["私たち","わたしたち"],["に"],["与える","あたえる"],["ため"],["で"],["あった"],["。"]]},{"verse":24,"text":"それで、主は、私たちがこのすべてのおきてを行い、私たちの神、主を恐れるように命じられた。それは、今日のように、いつまでも私たちがしあわせであり、生き残るためである。","tok":[["それ"],["で"],["、"],["主","ぬし"],["は"],["、"],["私たち","わたしたち"],["が"],["この"],["すべて"],["の"],["おきて"],["を"],["行い","おこない"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["恐れる","おそれる"],["よう"],["に"],["命じられた","めいじられた"],["。"],["それ"],["は"],["、"],["今日","きょう"],["の"],["よう"],["に"],["、"],["いつ"],["まで"],["も"],["私たち","わたしたち"],["が"],["しあわせ"],["で"],["あり"],["、"],["生き残る","いきのこる"],["ため"],["で"],["ある"],["。"]]},{"verse":25,"text":"私たちの神、主が命じられたように、御前でこのすべての命令を守り行うことは、私たちの義となるのである。」","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["よう"],["に"],["、"],["御前","ごぜん"],["で"],["この"],["すべて"],["の"],["命令","めいれい"],["を"],["守り","まもり"],["行う","おこなう"],["こと"],["は"],["、"],["私たち","わたしたち"],["の"],["義","ぎ"],["と"],["なる"],["ので"],["ある"],["。"],["」"]]}]
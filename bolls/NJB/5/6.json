[{"verse":1,"text":"これは、あなたがたの神、主が、あなたがたに教えよと命じられた命令――おきてと定め――である。あなたがたが、渡って行って、所有しようとしている地で、行うためである。","tok":[["これ"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["に"],["教えよ","おしえよ"],["と"],["命じられた","めいじられた"],["命令","めいれい"],["―"],["―"],["おきて"],["と"],["定め","さだめ"],["―"],["―"],["で"],["ある"],["。"],["あなた"],["が"],["た"],["が"],["、"],["渡って","わたって"],["行って","いって"],["、"],["所有","しょゆう"],["しよう"],["として"],["いる"],["地","ち"],["で"],["、"],["行う","おこなう"],["ため"],["で"],["ある"],["。"]]},{"verse":2,"text":"それは、あなたの一生の間、あなたも、そしてあなたの子も孫も、あなたの神、主を恐れて、私の命じるすべての主のおきてと命令を守るため、またあなたが長く生きることのできるためである。","tok":[["それ"],["は"],["、"],["あなた"],["の"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["あなた"],["も"],["、"],["そして"],["あなた"],["の"],["子","こ"],["も"],["孫","まご"],["も"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["恐れて","おそれて"],["、"],["私","わたくし"],["の"],["命じる","めいじる"],["すべて"],["の"],["主","ぬし"],["の"],["おきて"],["と"],["命令","めいれい"],["を"],["守る","まもる"],["ため"],["、"],["また"],["あなた"],["が"],["長く","ながく"],["生きる","いきる"],["こと"],["の"],["できる"],["ため"],["で"],["ある"],["。"]]},{"verse":3,"text":"イスラエルよ。聞いて、守り行いなさい。そうすれば、あなたはしあわせになり、あなたの父祖の神、主があなたに告げられたように、あなたは乳と蜜の流れる国で大いにふえよう。","tok":[["イスラエル"],["よ"],["。"],["聞いて","きいて"],["、"],["守り","まもり"],["行い","おこない"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["しあわせ"],["に"],["なり"],["、"],["あなた"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["告げられた","つげられた"],["よう"],["に"],["、"],["あなた"],["は"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["国","くに"],["で"],["大いに","おおいに"],["ふえよう"],["。"]]},{"verse":4,"text":"聞きなさい。イスラエル。主は私たちの神。主はただひとりである。","tok":[["聞き","きき"],["なさい"],["。"],["イスラエル"],["。"],["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["神","かみ"],["。"],["主","ぬし"],["は"],["ただ"],["ひとり"],["で"],["ある"],["。"]]},{"verse":5,"text":"心を尽くし、精神を尽くし、力を尽くして、あなたの神、主を愛しなさい。","tok":[["心","こころ"],["を"],["尽くし","つくし"],["、"],["精神","せいしん"],["を"],["尽くし","つくし"],["、"],["力","ちから"],["を"],["尽くして","つくして"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["愛し","あいし"],["なさい"],["。"]]},{"verse":6,"text":"私がきょう、あなたに命じるこれらのことばを、あなたの心に刻みなさい。","tok":[["私","わたくし"],["が"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["これ"],["ら"],["の"],["ことば"],["を"],["、"],["あなた"],["の"],["心","こころ"],["に"],["刻み","きざみ"],["なさい"],["。"]]},{"verse":7,"text":"これをあなたの子どもたちによく教え込みなさい。あなたが家にすわっているときも、道を歩くときも、寝るときも、起きるときも、これを唱えなさい。","tok":[["これ"],["を"],["あなた"],["の"],["子ども","こども"],["たち"],["に"],["よく"],["教え込み","おしえこみ"],["なさい"],["。"],["あなた"],["が"],["家","いえ"],["に"],["すわって"],["いる"],["とき"],["も"],["、"],["道","みち"],["を"],["歩く","あるく"],["とき"],["も"],["、"],["寝る","ねる"],["とき"],["も"],["、"],["起きる","おきる"],["とき"],["も"],["、"],["これ"],["を"],["唱え","となえ"],["なさい"],["。"]]},{"verse":8,"text":"これをしるしとしてあなたの手に結びつけ、記章として額の上に置きなさい。","tok":[["これ"],["を"],["しるし"],["として"],["あなた"],["の"],["手","て"],["に"],["結びつけ","むすびつけ"],["、"],["記章","きしょう"],["として"],["額","がく"],["の"],["上","うえ"],["に"],["置き","おき"],["なさい"],["。"]]},{"verse":9,"text":"これをあなたの家の門柱と門に書きしるしなさい。","tok":[["これ"],["を"],["あなた"],["の"],["家","いえ"],["の"],["門柱","もんちゅう"],["と"],["門","もん"],["に"],["書きしるし","かきしるし"],["なさい"],["。"]]},{"verse":10,"text":"あなたの神、主が、あなたの先祖、アブラハム、イサク、ヤコブに誓われた地にあなたを導き入れ、あなたが建てなかった、大きくて、すばらしい町々、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["の"],["先祖","せんぞ"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓われた","ちかわれた"],["地","ち"],["に"],["あなた"],["を"],["導き入れ","みちびきいれ"],["、"],["あなた"],["が"],["建てなかった","たてなかった"],["、"],["大きくて","おおきくて"],["、"],["すばらしい"],["町々","まちまち"],["、"]]},{"verse":11,"text":"あなたが満たさなかった、すべての良い物が満ちた家々、あなたが掘らなかった掘り井戸、あなたが植えなかったぶどう畑とオリーブ畑、これらをあなたに与え、あなたが食べて、満ち足りるとき、","tok":[["あなた"],["が"],["満たさなかった","みたさなかった"],["、"],["すべて"],["の"],["良い","よい"],["物","もの"],["が"],["満ちた","みちた"],["家々","いえいえ"],["、"],["あなた"],["が"],["掘らなかった","ほらなかった"],["掘り","ほり"],["井戸","いど"],["、"],["あなた"],["が"],["植えなかった","うえなかった"],["ぶどう"],["畑","はたけ"],["と"],["オリーブ"],["畑","はたけ"],["、"],["これ"],["ら"],["を"],["あなた"],["に"],["与え","あたえ"],["、"],["あなた"],["が"],["食べて","たべて"],["、"],["満ち足りる","みちたりる"],["とき"],["、"]]},{"verse":12,"text":"あなたは気をつけて、あなたをエジプトの地、奴隷の家から連れ出された
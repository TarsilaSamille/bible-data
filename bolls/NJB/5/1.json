[{"verse":1,"text":"これは、モーセがヨルダンの向こうの地、パランと、トフェル、ラバン、ハツェロテ、ディ・ザハブとの間の、スフの前にあるアラバの荒野で、イスラエルのすべての民に告げたことばである。","tok":[["これ"],["は"],["、"],["モーセ"],["が"],["ヨルダン"],["の"],["向こう","むこう"],["の"],["地","ち"],["、"],["パラン"],["と"],["、"],["トフェル"],["、"],["ラバン"],["、"],["ハツェロテ"],["、"],["ディ"],["・"],["ザハブ"],["と"],["の"],["間","あいだ"],["の"],["、"],["スフ"],["の"],["前","まえ"],["に"],["ある"],["アラバ"],["の"],["荒野","あらの"],["で"],["、"],["イスラエル"],["の"],["すべて"],["の"],["民","たみ"],["に"],["告げた","つげた"],["ことば"],["で"],["ある"],["。"]]},{"verse":2,"text":"ホレブから、セイル山を経てカデシュ・バルネアに至るのには十一日かかる。","tok":[["ホレブ"],["から"],["、"],["セイル山","せいるさん"],["を"],["経て","へて"],["カデシュ"],["・"],["バルネア"],["に"],["至る","いたる"],["のに"],["は"],["十一","じゅういち"],["日","にち"],["かかる"],["。"]]},{"verse":3,"text":"第四十年の第十一月の一日にモーセは、主がイスラエル人のために彼に命じられたことを、ことごとく彼らに告げた。","tok":[["第","だい"],["四十","よんじゅう"],["年","ねん"],["の"],["第","だい"],["十一","じゅういち"],["月","がつ"],["の"],["一","いち"],["日","にち"],["に"],["モーセ"],["は"],["、"],["主","ぬし"],["が"],["イスラエル"],["人","にん"],["の"],["ため"],["に"],["彼","かれ"],["に"],["命じられた","めいじられた"],["こと"],["を"],["、"],["ことごとく"],["彼","かれ"],["ら"],["に"],["告げた","つげた"],["。"]]},{"verse":4,"text":"モーセが、ヘシュボンに住んでいたエモリ人の王シホン、およびアシュタロテに住んでいたバシャンの王オグをエデレイで打ち破って後のことである。","tok":[["モーセ"],["が"],["、"],["ヘシュボン"],["に"],["住んで","すんで"],["いた"],["エモリ人","えもりにん"],["の"],["王","おう"],["シホン"],["、"],["および"],["アシュタロテ"],["に"],["住んで","すんで"],["いた"],["バシャン"],["の"],["王","おう"],["オグ"],["を"],["エデレイ"],["で"],["打ち破って","うちやぶって"],["後","あと"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":5,"text":"ヨルダンの向こうの地、モアブの地で、モーセは、このみおしえを説明し始めて言った。","tok":[["ヨルダン"],["の"],["向こう","むこう"],["の"],["地","ち"],["、"],["モアブ"],["の"],["地","ち"],["で"],["、"],["モーセ"],["は"],["、"],["この"],["みおしえ"],["を"],["説明","せつめい"],["し"],["始めて","はじめて"],["言った","いった"],["。"]]},{"verse":6,"text":"私たちの神、主は、ホレブで私たちに告げて仰せられた。「あなたがたはこの山に長くとどまっていた。","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["ホレブ"],["で"],["私たち","わたしたち"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"],["「"],["あなた"],["がた"],["は"],["この"],["山","やま"],["に"],["長く","ながく"],["とどまって"],["いた"],["。"]]},{"verse":7,"text":"向きを変えて、出発せよ。そしてエモリ人の山地に行き、その近隣のすべての地、アラバ、山地、低地、ネゲブ、海辺、カナン人の地、レバノン、さらにあの大河ユーフラテス川にまで行け。","tok":[["向き","むき"],["を"],["変えて","かえて"],["、"],["出発","しゅっぱつ"],["せよ"],["。"],["そして"],["エモリ人","えもりにん"],["の"],["山地","さんち"],["に"],["行き","いき"],["、"],["その"],["近隣","きんりん"],["の"],["すべて"],["の"],["地","ち"],["、"],["アラバ"],["、"],["山地","さんち"],["、"],["低地","ていち"],["、"],["ネゲブ"],["、"],["海辺","うみべ"],["、"],["カナン人","かなんにん"],["の"],["地","ち"],["、"],["レバノン"],["、"],["さらに"],["あの"],["大河","たいが"],["ユーフラテス"],["川","かわ"],["に"],["まで"],["行け","いけ"],["。"]]},{"verse":8,"text":"見よ。わたしはその地をあなたがたの手に渡している。行け。その地を所有せよ。これは、主があなたがたの先祖アブラハム、イサク、ヤコブに誓って、彼らとその後の子孫に与えると言われた地である。」","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["その"],["地","ち"],["を"],["あなた"],["がた"],["の"],["手","て"],["に"],["渡して","わたして"],["いる"],["。"],["行け","いけ"],["。"],["その"],["地","ち"],["を"],["所有","しょゆう"],["せよ"],["。"],["これ"],["は"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓って","ちかって"],["、"],["彼","かれ"],["ら"],["と"],["その後","そのあと"],["の"],["子孫","しそん"],["に"],["与える","あたえる"],["と"],["言われた","いわれた"],["地","ち"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"私はあの時、あなたがたにこう言った。「私だけではあなたがたの重荷を負うことはできない。","tok":[["私","わたくし"],["は"],["あの"],["時","とき"],["、"],["あなた"],["がた"],["に"],["こう"],["言った","いった"],["。"],["「"],["私","わたくし"],["だけ"],["で"],["は"],["あなた"],["がた"],["の"],["重荷","おもに"],["を"],["負う","おう"],["こと"],["は"],["できない"],["。"]]},{"verse":10,"text":"あなたがたの神、主が、あなたがたをふやされたので、見よ、あなたがたは、きょう、空の星のように多い。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["を"],["ふやされた"],["ので"],["、"],["見よ","みよ"],["、"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["空","そら"],["の"],["星","ほし"],["の"],["よう"],["に"],["多い","おおい"],["。"]]},{"verse":11,"text":"――どうかあなたがたの父祖の神、主が、あなたがたを今の千倍にふやしてくださるように。そしてあなたがたに約束されたとおり、あなたがたを祝福してくださるように――","tok":[["―"],["―"],["どう"],["か"],["あなた"],["がた"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["を"],["今","いま"],["の"],["千","せん"],["倍","ばい"],["に"],["ふやして"],["
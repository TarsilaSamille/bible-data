身内","みうち"],["の"],["者","もの"],["たち"],["の"],["間","あいだ"],["の"],["事","こと"],["を"],["よく"],["聞き","きき"],["なさい"],["。"],["ある"],["人","ひと"],["と"],["身内","みうち"],["の"],["者","もの"],["たち"],["と"],["の"],["間","あいだ"],["、"],["また"],["在留","ざいりゅう"],["異国人","いこくにん"],["と"],["の"],["間","あいだ"],["を"],["正しく","ただしく"],["さばき"],["なさい"],["。"]]},{"verse":17,"text":"さばきをするとき、人をかたよって見てはならない。身分の低い人にも高い人にもみな、同じように聞かなければならない。人を恐れてはならない。さばきは神のものである。あなたがたにとってむずかしすぎる事は、私のところに持って来なさい。私がそれを聞こう。」","tok":[["さばき"],["を"],["する"],["とき"],["、"],["人","ひと"],["を"],["かたよって"],["見て","みて"],["は"],["ならない"],["。"],["身分","みぶん"],["の"],["低い","ひくい"],["人","ひと"],["に"],["も"],["高い","たかい"],["人","ひと"],["に"],["も"],["みな"],["、"],["同じ","おなじ"],["よう"],["に"],["聞かなければ","きかなければ"],["ならない"],["。"],["人","ひと"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["さばき"],["は"],["神","かみ"],["の"],["もの"],["で"],["ある"],["。"],["あなた"],["がた"],["にとって"],["むずかし"],["すぎる"],["事","こと"],["は"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["私","わたくし"],["が"],["それ"],["を"],["聞こう","きこう"],["。"],["」"]]},{"verse":18,"text":"私はまた、そのとき、あなたがたのなすべきすべてのことを命じた。","tok":[["私","わたくし"],["は"],["また"],["、"],["その"],["とき"],["、"],["あなた"],["がた"],["の"],["なすべき"],["すべて"],["の"],["こと"],["を"],["命じた","めいじた"],["。"]]},{"verse":19,"text":"私たちの神、主が、私たちに命じられたとおりに、私たちはホレブを旅立ち、あなたがたが見た、あの大きな恐ろしい荒野を、エモリ人の山地への道をとって進み、カデシュ・バルネアまで来た。","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["私たち","わたしたち"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["私たち","わたしたち"],["は"],["ホレブ"],["を"],["旅立ち","たびだち"],["、"],["あなた"],["がた"],["が"],["見た","みた"],["、"],["あの"],["大きな","おおきな"],["恐ろしい","おそろしい"],["荒野","あらの"],["を"],["、"],["エモリ人","えもりにん"],["の"],["山地","さんち"],["へ"],["の"],["道","みち"],["を"],["とって"],["進み","すすみ"],["、"],["カデシュ"],["・"],["バルネア"],["まで"],["来た","きた"],["。"]]},{"verse":20,"text":"そのとき、私はあなたがたに言った。「あなたがたは、私たちの神、主が私たちに与えようとされるエモリ人の山地に来た。","tok":[["その"],["とき"],["、"],["私","わたくし"],["は"],["あなた"],["がた"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","
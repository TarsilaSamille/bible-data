[{"verse":1,"text":"あなたが敵と戦うために出て行くとき、馬や戦車や、あなたよりも多い軍勢を見ても、彼らを恐れてはならない。あなたをエジプトの地から導き上られたあなたの神、主が、あなたとともにおられる。","tok":[["あなた"],["が"],["敵","てき"],["と"],["戦う","たたかう"],["ため"],["に"],["出て","でて"],["行く","いく"],["とき"],["、"],["馬","うま"],["や"],["戦車","せんしゃ"],["や"],["、"],["あなた"],["より"],["も"],["多い","おおい"],["軍勢","ぐんぜい"],["を"],["見て","みて"],["も"],["、"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き","みちびき"],["上られた","のぼられた"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["と"],["とも"],["に"],["おられる"],["。"]]},{"verse":2,"text":"あなたがたが戦いに臨む場合は、祭司は進み出て民に告げ、","tok":[["あなた"],["がた"],["が"],["戦い","たたかい"],["に"],["臨む","のぞむ"],["場合","ばあい"],["は"],["、"],["祭司","さいし"],["は"],["進み出て","すすみでて"],["民","みん"],["に"],["告げ","つげ"],["、"]]},{"verse":3,"text":"彼らに言いなさい。「聞け。イスラエルよ。あなたがたは、きょう、敵と戦おうとしている。弱気になってはならない。恐れてはならない。うろたえてはならない。彼らのことでおじけてはならない。","tok":[["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["「"],["聞け","きけ"],["。"],["イスラエル"],["よ"],["。"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["敵","てき"],["と"],["戦おう","たたかおう"],["として"],["いる"],["。"],["弱気","よわき"],["に"],["なって"],["は"],["ならない"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["うろたえて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["こと"],["で"],["おじけて"],["は"],["ならない"],["。"]]},{"verse":4,"text":"共に行って、あなたがたのために、あなたがたの敵と戦い、勝利を得させてくださるのは、あなたがたの神、主である。」","tok":[["共","とも"],["に"],["行って","いって"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["敵","てき"],["と"],["戦い","たたかい"],["、"],["勝利","しょうり"],["を"],["得させて","えさせて"],["くださる"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"つかさたちは、民に告げて言いなさい。「新しい家を建てて、まだそれを奉献しなかった者はいないか。その者は家へ帰らなければならない。彼が戦死して、ほかの者がそれを奉献するといけないから。","tok":[["つかさ"],["たち"],["は"],["、"],["民","みん"],["に"],["告げて","つげて"],["言い","いい"],["なさい"],["。"],["「"],["新しい","あたらしい"],["家","いえ"],["を"],["建てて","たてて"],["、"],["まだ"],["それ"],["を"],["奉献","ほうけん"],["しなかった"],["者","もの"],["は"],["いない"],["か"],["。"],["その"],["者","もの"],["は"],["家","いえ"],["へ"],["帰らなければ","かえらなければ"],["ならない"],["。"],["彼","かれ"],["が"],["戦死","せんし"],["して"],["、"],["ほか"],["の"],["者","もの"],["が"],["それ"],["を"],["奉献","ほうけん"],["する"],["と"],["いけない"],["から"],["。"]]},{"verse":6,"text":"ぶどう畑を作って、そこからまだ収穫していない者はいないか。その者は家へ帰らなければならない。彼が戦死して、ほかの者が収穫するといけないから。","tok":[["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["、"],["そこ"],["から"],["まだ"],["収穫","しゅうかく"],["して"],["いない"],["者","もの"],["は"],["いない"],["か"],["。"],["その"],["者","もの"],["は"],["家","いえ"],["へ"],["帰らなければ","かえらなければ"],["ならない"],["。"],["彼","かれ"],["が"],["戦死","せんし"],["して"],["、"],["ほか"],["の"],["者","もの"],["が"],["収穫","しゅうかく"],["する"],["と"],["いけない"],["から"],["。"]]},{"verse":7,"text":"女と婚約して、まだその女と結婚していない者はいないか。その者は家へ帰らなければならない。彼が戦死して、ほかの者が彼女と結婚するといけないから。」","tok":[["女","おんな"],["と"],["婚約","こんやく"],["して"],["、"],["まだ"],["その"],["女","おんな"],["と"],["結婚","けっこん"],["して"],["いない"],["者","もの"],["は"],["いない"],["か"],["。"],["その"],["者","もの"],["は"],["家","いえ"],["へ"],["帰らなければ","かえらなければ"],["ならない"],["。"],["彼","かれ"],["が"],["戦死","せんし"],["して"],["、"],["ほか"],["の"],["者","もの"],["が"],["彼女","かのじょ"],["と"],["結婚","けっこん"],["する"],["と"],["いけない"],["から"],["。"],["」"]]},{"verse":8,"text":"つかさたちは、さらに民に告げて言わなければならない。「恐れて弱気になっている者はいないか。その者は家に帰れ。戦友たちの心が、彼の心のようにくじけるといけないから。」","tok":[["つかさ"],["たち"],["は"],["、"],["さらに"],["民","たみ"],["に"],["告げて","つげて"],["言わなければ","いわなければ"],["ならない"],["。"],["「"],["恐れて","おそれて"],["弱気","よわき"],["に"],["なって"],["いる"],["者","もの"],["は"],["いない"],["か"],["。"],["その"],["者","もの"],["は"],["家","いえ"],["に"],["帰れ","かえれ"],["。"],["戦友","せんゆう"],["たち"],["の"],["心","こころ"],["が"],["、"],["彼","かれ"],["の"],["心","こころ"],["の"],["よう"],["に"],["くじける"],["と"],["いけない"],["から"],["。"],["」"]]},{"verse":9,"text":"つかさたちが民に告げ終わったら、将軍たちが民の指揮をとりなさい。","tok":[["つかさ"],["たち"],["が"],["民","たみ"],["に"],["告げ","つげ"],["終わったら","おわったら"],["、"],["将軍","しょうぐん"],["たち"],["が"],["民","たみ"],["の"],["指揮","しき"],["を"],["とり"],["なさい"],["。"]]},{"verse":10,"text":"町を攻略しようと、あなたがその町に近づいたときには、まず降伏を勧めなさい。","tok":[["町","まち"],["を"],["攻略","こうりゃく"],["しよう"],["と"],["、"],["あなた"],["が"],["その"],["町","まち"],["に"],["近づいた","ちかづいた"],["とき"],["に"],["は"],["、"],["まず"],["降伏","こうふく"],["を"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":11,"text":"降伏に同意して門を開くなら、その中にいる民は、みな、あなたのために、苦役に服して働かなければならない。","tok":[["降伏","こうふく"],["に"],["同意","どうい"],["して"],["門","もん"],["を"],["開くなら","ひらくなら"],["、"],["その"],["中","なか"],["に"],["いる"],["民","たみ"],["は"],["、"],["みな"],["、"],["あなた"],["の"],["ため"],["に"],["、"],["苦役","くえき"],["に"],["服して","ふくして"],["働かなければ","はたらかなければ"],["ならない"],["。"]]},{"verse":12,"text":"もし、あなたに降伏せず、戦おうとするなら、これを包囲しなさい。","tok":[["もし"],["、"],["あなた"],["に"],["降伏","こうふく"],["せず"],["、"],["戦おう","たたかおう"],["と"],["するなら"],["、"],["これ"],["を"],["包囲","ほうい"],["し"],["なさい"],["。"]]},{"verse":13,"text":"あなたの神、主が、それをあなたの手に渡されたなら、その町の男をみな、剣の刃で打ちなさい。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["それ"],["を"],["あなた"],["の"],["手","て"],["に"],["渡されたなら","わたされたなら"],["、"],["その"],["町","まち"],["の"],["男","おとこ"],["を"],["みな"],["、"],["剣","けん"],["の"],["刃","は"],["で"],["打ち","うち"],["なさい"],["。"]]},{"verse":14,"text":"しかし女、子ども、家畜、また町の中にあるすべてのもの、そのすべての略奪物を、戦利品として取ってよい。あなたの神、主があなたに与えられた敵からの略奪物を、あなたは利用することができる。","tok":[["しかし"],["女","おんな"],["、"],["子ども","こども"],["、"],["家畜","かちく"],["、"],["また"],["町","まち"],["の"],["中","なか"],["に"],["ある"],["すべて"],["の"],["もの"],["、"],["その"],["すべて"],["の"],["略奪物","りゃくだつぶつ"],["を"],["、"],["戦利品","せんりひん"],["として"],["取って","とって"],["よい"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えられた","あたえられた"],["敵","てき"],["から"],["の"],["略奪物","りゃくだつぶつ"],["を"],["、"],["あなた"],["は"],["利用","りよう"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":15,"text":"非常に遠く離れていて、次に示す国々の町でない町々に対しては、すべてこのようにしなければならない。","tok":[["非常","ひじょう"],["に"],["遠く","とおく"],["離れて","はなれて"],["いて"],["、"],["次","つぎ"],["に"],["示す","しめす"],["国々","くにぐに"],["の"],["町","まち"],["で"],["ない"],["町々","まちまち"],["に"],["対し","たいし"],["ては"],["、"],["すべて"],["この"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":16,"text":"しかし、あなたの神、主が相続地として与えようとしておられる次の国々の民の町では、息のある者をひとりも生かしておいてはならない。","tok":[["しかし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["相続","そうぞく"],["地","ち"],["として"],["与えよう","あたえよう"],["として"],["おられる"],["次","つぎ"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["町","まち"],["で"],["は"],["、"],["息","いき"],["の"],["ある"],["者","もの"],["を"],["ひとり"],["も"],["生かして","いかして"],["おいて"],["は"],["ならない"],["。"]]},{"verse":17,"text":"すなわち、ヘテ人、エモリ人、カナン人、ペリジ人、ヒビ人、エブス人は、あなたの神、主が命じられたとおり、必ず聖絶しなければならない。","tok":[["すなわち"],["、"],["ヘテ人","へてにん"],["、"],["エモリ人","えもりにん"],["、"],["カナン人","かなんにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["、"],["必ず","かならず"],["聖","せい"],["絶しなければ","ぜっしなければ"],["ならない"],["。"]]},{"verse":18,"text":"それは、彼らが、その神々に行っていたすべての忌みきらうべきことをするようにあなたがたに教え、あなたがたが、あなたがたの神、主に対して罪を犯すことのないためである。","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["、"],["その"],["神々","かみがみ"],["に"],["行って","いって"],["いた"],["すべて"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["を"],["する"],["よう"],["に"],["あなた"],["がた"],["に"],["教え","おしえ"],["、"],["あなた"],["が"],["た"],["が"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["対して","たいして"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":19,"text":"長い間、町を包囲して、これを攻め取ろうとするとき、斧をふるって、そこの木を切り倒してはならない。その木から取って食べるのはよいが、切り倒してはならない。まさか野の木が包囲から逃げ出す人間でもあるまい。","tok":[["長い","ながい"],["間","あいだ"],["、"],["町","まち"],["を"],["包囲","ほうい"],["して"],["、"],["これ"],["を"],["攻め取ろう","せめとろう"],["と"],["する"],["とき"],["、"],["斧","おの"],["を"],["ふるって"],["、"],["そこ"],["の"],["木","き"],["を"],["切り倒して","きりたおして"],["は"],["ならない"],["。"],["その"],["木","き"],["から"],["取って","とって"],["食べる","たべる"],["の"],["は"],["よい"],["が"],["、"],["切り倒して","きりたおして"],["は"],["ならない"],["。"],["まさか"],["野","の"],["の"],["木","き"],["が"],["包囲","ほうい"],["から"],["逃げ出す","にげだす"],["人間","にんげん"],["で"],["も"],["あるまい"],["。"]]},{"verse":20,"text":"ただ、実を結ばないとわかっている木だけは、切り倒してもよい。それを切り倒して、あなたと戦っている町が陥落するまでその町に対して、それでとりでを築いてもよい。","tok":[["ただ"],["、"],["実","じつ"],["を"],["結ばない","むすばない"],["と"],["わかって"],["いる"],["木","き"],["だけ"],["は"],["、"],["切り倒して","きりたおして"],["も"],["よい"],["。"],["それ"],["を"],["切り倒して","きりたおして"],["、"],["あなた"],["と"],["戦って","たたかって"],["いる"],["町",
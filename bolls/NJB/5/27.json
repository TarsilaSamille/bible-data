[{"verse":1,"text":"ついでモーセとイスラエルの長老たちとは、民に命じて言った。私が、きょう、あなたがたに命じるすべての命令を守りなさい。","tok":[["ついで"],["モーセ"],["と"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["と"],["は"],["、"],["民","みん"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["私","わたくし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["すべて"],["の"],["命令","めいれい"],["を"],["守り","まもり"],["なさい"],["。"]]},{"verse":2,"text":"あなたがたが、あなたの神、主が与えようとしておられる地に向かってヨルダンを渡る日には、大きな石を立て、それらに石灰を塗りなさい。","tok":[["あなた"],["が"],["た"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えよう","あたえよう"],["として"],["おられる"],["地","ち"],["に"],["向かって","むかって"],["ヨルダン"],["を"],["渡る","わたる"],["日","ひ"],["に"],["は"],["、"],["大きな","おおきな"],["石","いし"],["を"],["立て","たて"],["、"],["それ"],["ら"],["に"],["石灰","せっかい"],["を"],["塗り","ぬり"],["なさい"],["。"]]},{"verse":3,"text":"あなたが渡ってから、それらの上に、このみおしえのすべてのことばを書きしるしなさい。それはあなたの父祖の神、主が約束されたとおり、あなたの神、主があなたに与えようとしておられる地、乳と蜜の流れる地にあなたが入るためである。","tok":[["あなた"],["が"],["渡って","わたって"],["から"],["、"],["それ"],["ら"],["の"],["上","うえ"],["に"],["、"],["この"],["みおしえ"],["の"],["すべて"],["の"],["ことば"],["を"],["書きしるし","かきしるし"],["なさい"],["。"],["それ"],["は"],["あなた"],["の"],["父祖","ふそ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["約束","やくそく"],["された"],["とおり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えよう","あたえよう"],["として"],["おられる"],["地","ち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["に"],["あなた"],["が"],["入る","はいる"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"あなたがたがヨルダンを渡ったなら、私が、きょう、あなたがたに命じるこれらの石をエバル山に立て、それに石灰を塗らなければならない。","tok":[["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡ったなら","わたったなら"],["、"],["私","わたくし"],["が"],["、"],["きょう"],["、"],["あなた"],["がた"],["に"],["命じる","めいじる"],["これ"],["ら"],["の"],["石","いし"],["を"],["エバル"],["山","やま"],["に"],["立て","たて"],["、"],["それ"],["に"],["石灰","せっかい"],["を"],["塗らなければ","ぬらなければ"],["ならない"],["。"]]},{"verse":5,"text":"そこに、あなたの神、主のために祭壇、石の祭壇を築きなさい。それに鉄の道具を当ててはならない。","tok":[["そこ"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["、"],["石","いし"],["の"],["祭壇","さいだん"],["を"],["築き","きずき"],["なさい"],["。"],["それ"],["に"],["鉄","てつ"],["の"],["道具","どうぐ"],["を"],["当てて","あてて"],["は"],["ならない"],["。"]]},{"verse":6,"text":"自然のままの石で、あなたの神、主の祭壇を築かなければならない。その上で、あなたの神、主に全焼のいけにえをささげなさい。","tok":[["自然","しぜん"],["の"],["まま"],["の"],["石","いし"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["祭壇","さいだん"],["を"],["築かなければ","きずかなければ"],["ならない"],["。"],["その"],["上","うえ"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげ"],["なさい"],["。"]]},{"verse":7,"text":"またそこで和解のいけにえをささげて、それを食べ、あなたの神、主の前で喜びなさい。","tok":[["また"],["そこ"],["で"],["和解","わかい"],["の"],["いけにえ"],["を"],["ささげて"],["、"],["それ"],["を"],["食べ","たべ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["喜び","よろこび"],["なさい"],["。"]]},{"verse":8,"text":"それらの石の上に、このみおしえのことばすべてをはっきりと書きしるしなさい。","tok":[["それ"],["ら"],["の"],["石","いし"],["の"],["上","うえ"],["に"],["、"],["この"],["みおしえ"],["の"],["ことば"],["すべて"],["を"],["はっきり"],["と"],["書きしるし","かきしるし"],["なさい"],["。"]]},{"verse":9,"text":"ついで、モーセとレビ人の祭司たちとは、すべてのイスラエル人に告げて言った。静まりなさい。イスラエルよ。聞きなさい。きょう、あなたは、あなたの神、主の民となった。","tok":[["つい"],["で"],["、"],["モーセ"],["と"],["レビ人","れびにん"],["の"],["祭司","さいし"],["たち"],["と"],["は"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["に"],["告げて","つげて"],["言った","いった"],["。"],["静まり","しずまり"],["なさい"],["。"],["イスラエル"],["よ"],["。"],["聞き","きき"],["なさい"],["。"],["きょう"],["、"],["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["民","たみ"],["と"],["なった"],["。"]]},{"verse":10,"text":"あなたの神、主の御声に聞き従い、私が、きょう、あなたに命じる主の命令とおきてとを行いなさい。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従い","ききしたがい"],["、"],["私","わたくし"],["が"],["、"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["主","ぬし"],["の"],["命令","めいれい"],["と"],["おきて"],["と"],["を"],["行い","おこない"],["なさい"],["。"]]},{"verse":11,"text":"その日、モーセは民に命じて言った。","tok":[["その"],["日","ひ"],["、"],["モーセ"],["は"],["民","みん"],["に"],["命じて","めいじて"],["言った","いった"],["。"]]},{"verse":12,"text":"あなたがたがヨルダンを渡ったとき、次の者たちは民を祝福するために、ゲリジム山に立たなければならない。シメオン、レビ、ユダ、イッサカル、ヨセフ、ベニヤミン。","tok":[["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡った","わたった"],["とき"],["、"],["次","つぎ"],["の"],["者","もの"],["たち"],["は"],["民","みん"],["を"],["祝福","しゅくふく"],["する"],["ため"],["に"],["、"],["ゲリジム"],["山","さん"],["に"],["立たなければ","たたなければ"],["ならない"],["。"],["シメオン"],["、"],["レビ"],["、"],["ユダ"],["、"],["イッサカル"],["、"],["ヨセフ"],["、"],["ベニヤミン"],["。"]]},{"verse":13,"text":"また次の者たちはのろいのために、エバル山に立たなければならない。ルベン、ガド、アシェル、ゼブルン、ダン、ナフタリ。","tok":[["また"],["次","つぎ"],["の"],["者","もの"],["たち"],["は"],["のろい"],["の"],["ため"],["に"],["、"],["エバル山","えばるさん"],["に"],["立たなければ","たたなければ"],["ならない"],["。"],["ルベン"],["、"],["ガド"],["、"],["アシェル"],["、"],["ゼブルン"],["、"],["ダン"],["、"],["ナフタリ"],["。"]]},{"verse":14,"text":"レビ人はイスラエルのすべての人々に大声で宣言しなさい。","tok":[["レビ人","れびにん"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["大声","おおごえ"],["で"],["宣言","せんげん"],["し"],["なさい"],["。"]]},{"verse":15,"text":"「職人の手のわざである、主の忌みきらわれる彫像や鋳像を造り、これをひそかに安置する者はのろわれる。」民はみな、答えて、アーメンと言いなさい。","tok":[["「"],["職人","しょくにん"],["の"],["手","て"],["の"],["わざ"],["で"],["ある"],["、"],["主","ぬし"],["の"],["忌みきらわれる","いみきらわれる"],["彫像","ちょうぞう"],["や"],["鋳像","ちゅうぞう"],["を"],["造り","つくり"],["、"],["これ"],["を"],["ひそか"],["に"],["安置","あんち"],["する"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["答えて","こたえて"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":16,"text":"「自分の父や母を侮辱する者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["自分","じぶん"],["の"],["父","ちち"],["や"],["母","はは"],["を"],["侮辱","ぶじょく"],["する"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":17,"text":"「隣人の地境を移す者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["隣人","りんじん"],["の"],["地境","じざかい"],["を"],["移す","うつす"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":18,"text":"「盲人にまちがった道を教える者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["盲人","もうじん"],["に"],["まちがった"],["道","みち"],["を"],["教える","おしえる"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":19,"text":"「在留異国人、みなしご、やもめの権利を侵す者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["在留","ざいりゅう"],["異国人","いこくにん"],["、"],["みなしご"],["、"],["やもめ"],["の"],["権利","けんり"],["を"],["侵す","おかす"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":20,"text":"「父の妻と寝る者は、自分の父の恥をさらすのであるから、のろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["父","ちち"],["の"],["妻","つま"],["と"],["寝る","ねる"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["父","ちち"],["の"],["恥","はじ"],["を"],["さらす"],["ので"],["ある"],["から"],["、"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":21,"text":"「どんな獣とも寝る者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["どんな"],["獣","けもの"],["と"],["も"],["寝る","ねる"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":22,"text":"「父の娘であれ、母の娘であれ、自分の姉妹と寝る者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["父","ちち"],["の"],["娘","むすめ"],["で"],["あれ"],["、"],["母","はは"],["の"],["娘","むすめ"],["で"],["あれ"],["、"],["自分","じぶん"],["の"],["姉妹","しまい"],["と"],["寝る","ねる"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":23,"text":"「自分の妻の母と寝る者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["自分","じぶん"],["の"],["妻","つま"],["の"],["母","はは"],["と"],["寝る","ねる"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":24,"text":"「ひそかに隣人を打ち殺す者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["ひそか"],["に"],["隣人","りんじん"],["を"],["打ち殺す","うちころす"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":25,"text":"「わいろを受け取り、人を打ち殺して罪のない者の血を流す者はのろわれる。」民はみな、アーメンと言いなさい。","tok":[["「"],["わいろ"],["を"],["受け取り","うけとり"],["、"],["人","ひと"],["を"],["打ち殺して","うちころして"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["流す","ながす"],["者","もの"],["は"],["のろわれる"],["。"],["」"],["民","みん"],["は"],["みな"],["、"],["アーメン"],["と"],["言い",
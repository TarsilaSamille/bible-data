[{"verse":1,"text":"あなたの神、主が、あなたに与えようとしておられる地の国々を、あなたの神、主が断ち滅ぼし、あなたがそれらを占領し、それらの町々や家々に住むようになったときに、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["に"],["与えよう","あたえよう"],["として"],["おられる"],["地","ち"],["の"],["国々","くにぐに"],["を"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["断ち","たち"],["滅ぼし","ほろぼし"],["、"],["あなた"],["が"],["それ"],["ら"],["を"],["占領","せんりょう"],["し"],["、"],["それ"],["ら"],["の"],["町々","まちまち"],["や"],["家々","いえいえ"],["に"],["住む","すむ"],["よう"],["に"],["なった"],["とき"],["に"],["、"]]},{"verse":2,"text":"あなたの神、主があなたに与えて所有させようとしておられるその地に、三つの町を取り分けなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えて","あたえて"],["所有","しょゆう"],["させよう"],["として"],["おられる"],["その"],["地","ち"],["に"],["、"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["取り分けなければ","とりわけなければ"],["ならない"],["。"]]},{"verse":3,"text":"あなたは距離を測定し、あなたの神、主があなたに受け継がせる地域を三つに区分しなければならない。殺人者はだれでも、そこにのがれることができる。","tok":[["あなた"],["は"],["距離","きょり"],["を"],["測定","そくてい"],["し"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["受け継がせる","うけつがせる"],["地域","ちいき"],["を"],["三","みっ"],["つ"],["に"],["区分","くぶん"],["しなければ"],["ならない"],["。"],["殺人者","さつじんしゃ"],["は"],["だれ"],["で"],["も"],["、"],["そこ"],["に"],["のがれる"],["こと"],["が"],["できる"],["。"]]},{"verse":4,"text":"殺人者がそこにのがれて生きることができる場合は次のとおり。知らずに隣人を殺し、以前からその人を憎んでいなかった場合である。","tok":[["殺人者","さつじんしゃ"],["が"],["そこ"],["に"],["のがれて"],["生きる","いきる"],["こと"],["が"],["できる"],["場合","ばあい"],["は"],["次","つぎ"],["の"],["とおり"],["。"],["知らず","しらず"],["に"],["隣人","りんじん"],["を"],["殺し","ころし"],["、"],["以前","いぜん"],["から"],["その"],["人","ひと"],["を"],["憎んで","にくんで"],["いなかった"],["場合","ばあい"],["で"],["ある"],["。"]]},{"verse":5,"text":"たとえば、木を切るため隣人といっしょに森に入り、木を切るために斧を手にして振り上げたところ、その頭が柄から抜け、それが隣人に当たってその人が死んだ場合、その者はこれらの町の一つにのがれて生きることができる。","tok":[["たとえば"],["、"],["木","き"],["を"],["切る","きる"],["ため"],["隣人","りんじん"],["と"],["いっしょ"],["に"],["森","もり"],["に"],["入り","はいり"],["、"],["木","き"],["を"],["切る","きる"],["ため"],["に"],["斧","おの"],["を"],["手","て"],["に"],["して"],["振り上げた","ふりあげた"],["ところ"],["、"],["その"],["頭","あたま"],["が"],["柄","がら"],["から"],["抜け","ぬけ"],["、"],["それ"],["が"],["隣人","りんじん"],["に"],["当たって","あたって"],["その"],["人","ひと"],["が"],["死んだ","しんだ"],["場合","ばあい"],["、"],["その"],["者","もの"],["は"],["これ"],["ら"],["の"],["町","まち"],["の"],["一","ひと"],["つ"],["に"],["のがれて"],["生きる","いきる"],["こと"],["が"],["できる"],["。"]]},{"verse":6,"text":"血の復讐をする者が、憤りの心に燃え、その殺人者を追いかけ、道が遠いために、その人に追いついて、打ち殺すようなことがあってはならない。その人は、以前から相手を憎んでいたのではないから、死刑に当たらない。","tok":[["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["が"],["、"],["憤り","いきどおり"],["の"],["心","こころ"],["に"],["燃え","もえ"],["、"],["その"],["殺人者","さつじんしゃ"],["を"],["追いかけ","おいかけ"],["、"],["道","みち"],["が"],["遠い","とおい"],["ため"],["に"],["、"],["その"],["人","ひと"],["に"],["追いついて","おいついて"],["、"],["打ち殺す","うちころす"],["よう"],["な"],["こと"],["が"],["あって"],["は"],["ならない"],["。"],["その"],["人","ひと"],["は"],["、"],["以前","いぜん"],["から"],["相手","あいて"],["を"],["憎んで","にくんで"],["いた"],["ので"],["は"],["ない"],["から"],["、"],["死刑","しけい"],["に"],["当たらない","あたらない"],["。"]]},{"verse":7,"text":"だから私はあなたに命じて、「三つの町を取り分けよ」と言ったのである。","tok":[["だ"],["から"],["私","わたくし"],["は"],["あなた"],["に"],["命じて","めいじて"],["、"],["「"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["取り分けよ","とりわけよ"],["」"],["と"],["言った","いった"],["ので"],["ある"],["。"]]},{"verse":8,"text":"あなたの神、主が、あなたの先祖たちに誓われたとおり、あなたの領土を広げ、先祖たちに与えると約束された地を、ことごとくあなたに与えられたなら、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["とおり"],["、"],["あなた"],["の"],["領土","りょうど"],["を"],["広げ","ひろげ"],["、"],["先祖","せんぞ"],["たち"],["に"],["与える","あたえる"],["と"],["約束","やくそく"],["された"],["地","ち"],["を"],["、"],["ことごとく"],["あなた"],["に"],["与えられたなら","あたえられたなら"],["、"]]},{"verse":9,"text":"――私が、きょう、あなたに命じるこのすべての命令をあなたが守り行い、あなたの神、主を愛し、いつまでもその道を歩むなら――そのとき、この三つの町に、さらに三つの町を追加しなさい。","tok":[["―"],["―"],["私","わたくし"],["が"],["、"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["この"],["すべて"],["の"],["命令","めいれい"],["を"],["あなた"],["が"],["守り","まもり"],["行い","おこない"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["愛し","あいし"],["、"],["いつ"],["まで"],["も"],["その"],["道","みち"],["を"],["歩むなら","あゆむなら"],["―"],
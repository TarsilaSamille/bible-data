[{"verse":1,"text":"アビブの月を守り、あなたの神、主に過越のいけにえをささげなさい。アビブの月に、あなたの神、主が、夜のうちに、エジプトからあなたを連れ出されたからである。","tok":[["アビブ"],["の"],["月","つき"],["を"],["守り","まもり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ささげ"],["なさい"],["。"],["アビブ"],["の"],["月","つき"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["夜","よる"],["の"],["うち"],["に"],["、"],["エジプト"],["から"],["あなた"],["を"],["連れ出された","つれだされた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"主が御名を住まわせるために選ぶ場所で、羊と牛を過越のいけにえとしてあなたの神、主にささげなさい。","tok":[["主","ぬし"],["が"],["御名","ぎょめい"],["を"],["住まわせる","すまわせる"],["ため"],["に"],["選ぶ","えらぶ"],["場所","ばしょ"],["で"],["、"],["羊","ひつじ"],["と"],["牛","うし"],["を"],["過越","すぎこし"],["の"],["いけにえ"],["として"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["ささげ"],["なさい"],["。"]]},{"verse":3,"text":"それといっしょに、パン種を入れたものを食べてはならない。七日間は、それといっしょに種を入れないパン、悩みのパンを食べなければならない。あなたが急いでエジプトの国を出たからである。それは、あなたがエジプトの国から出た日を、あなたの一生の間、覚えているためである。","tok":[["それ"],["と"],["いっしょ"],["に"],["、"],["パン種","ぱんだね"],["を"],["入れた","いれた"],["もの"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["七","なな"],["日間","かかん"],["は"],["、"],["それ"],["と"],["いっしょ"],["に"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["、"],["悩み","なやみ"],["の"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["あなた"],["が"],["急いで","いそいで"],["エジプト"],["の"],["国","くに"],["を"],["出た","でた"],["から"],["で"],["ある"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["エジプト"],["の"],["国","くに"],["から"],["出た","でた"],["日","ひ"],["を"],["、"],["あなた"],["の"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["覚えて","おぼえて"],["いる"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"七日間は、パン種があなたの領土のどこにも見あたらないようにしなければならない。また、第一日目の夕方にいけにえとしてほふったその肉を、朝まで残してはならない。","tok":[["七","なな"],["日間","かかん"],["は"],["、"],["パン種","ぱんだね"],["が"],["あなた"],["の"],["領土","りょうど"],["の"],["どこ"],["に"],["も"],["見あたらない","みあたらない"],["よう"],["に"],["しなければ"],["ならない"],["。"],["また"],["、"],["第","だい"],["一","いち"],["日目","にちめ"],["の"],["夕方","ゆうがた"],["に"],["いけにえ"],["として"],["ほふった"],["その"],["肉","にく"],["を"],["、"],["朝","あさ"],["まで"],["残して","のこして"],["は"],["ならない"],["。"]]},{"verse":5,"text":"あなたの神、主があなたに与えようとしておられるあなたの町囲みのどれでも、その中で過越のいけにえをほふることはできない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えよう","あたえよう"],["として"],["おられる"],["あなた"],["の"],["町","まち"],["囲み","かこみ"],["の"],["どれ"],["で"],["も"],["、"],["その"],["中","なか"],["で"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ほふる"],["こと"],["は"],["できない"],["。"]]},{"verse":6,"text":"ただ、あなたの神、主が御名を住まわせるために選ぶその場所で、夕方、日の沈むころ、あなたがエジプトから出た時刻に、過越のいけにえをほふらなければならない。","tok":[["ただ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["御名","ぎょめい"],["を"],["住まわせる","すまわせる"],["ため"],["に"],["選ぶ","えらぶ"],["その"],["場所","ばしょ"],["で"],["、"],["夕方","ゆうがた"],["、"],["日","ひ"],["の"],["沈む","しずむ"],["ころ"],["、"],["あなた"],["が"],["エジプト"],["から"],["出た","でた"],["時刻","じこく"],["に"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["ほふらなければ"],["ならない"],["。"]]},{"verse":7,"text":"そして、あなたの神、主が選ぶその場所で、それを調理して食べなさい。そして朝、自分の天幕に戻って行きなさい。","tok":[["そして"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["選ぶ","えらぶ"],["その"],["場所","ばしょ"],["で"],["、"],["それ"],["を"],["調理","ちょうり"],["して"],["食べ","たべ"],["なさい"],["。"],["そして"],["朝","あさ"],["、"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["戻って","もどって"],["行き","いき"],["なさい"],["。"]]},{"verse":8,"text":"六日間、種を入れないパンを食べなければならない。七日目は、あなたの神、主へのきよめの集会である。どんな仕事もしてはならない。","tok":[["六","ろく"],["日間","にちかん"],["、"],["種","しゅ"],["を"],["入れない","いれない"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["七日目","ななかめ"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["へ"],["の"],["きよめ"],["の"],["集会","しゅうかい"],["で"],["ある"],["。"],["どんな"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":9,"text":"七週間を数えなければならない。かまを立穂に入れ始める時から、七週間を数え始めなければならない。","tok":[["七","なな"],["週間","しゅうかん"],["を"],["数えなければ","かぞえなければ"],["ならない"],["。"],["かま"],["を"],["立穂","りつほ"],["に"],["入れ","いれ"],["始める","はじめる"],["時","とき"],["から"],["、"],["七","なな"],["週間","しゅうかん"],["を"],["数え","かぞえ"],["始めなければ","はじめなければ"],["ならない"],["。"]]},{"verse":10,"text":"あなたの神、主のために七週の祭りを行い、あなたの神、主が賜る祝福に応じ、進んでささげるささげ物をあなたの手でささげなさい。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に
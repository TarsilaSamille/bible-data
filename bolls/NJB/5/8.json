[{"verse":1,"text":"私が、きょう、あなたに命じるすべての命令をあなたがたは守り行わなければならない。そうすれば、あなたがたは生き、その数はふえ、主があなたがたの先祖たちに誓われた地を所有することができる。","tok":[["私","わたくし"],["が"],["、"],["きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["すべて"],["の"],["命令","めいれい"],["を"],["あなた"],["がた"],["は"],["守り","まもり"],["行わなければ","おこなわなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["生き","いき"],["、"],["その"],["数","すう"],["は"],["ふえ"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["地","ち"],["を"],["所有","しょゆう"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":2,"text":"あなたの神、主が、この四十年の間、荒野であなたを歩ませられた全行程を覚えていなければならない。それは、あなたを苦しめて、あなたを試み、あなたがその命令を守るかどうか、あなたの心のうちにあるものを知るためであった。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["この"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["荒野","こうや"],["で"],["あなた"],["を"],["歩ませられた","あゆませられた"],["全","ぜん"],["行程","こうてい"],["を"],["覚えて","おぼえて"],["いなければ"],["ならない"],["。"],["それ"],["は"],["、"],["あなた"],["を"],["苦しめて","くるしめて"],["、"],["あなた"],["を"],["試み","こころみ"],["、"],["あなた"],["が"],["その"],["命令","めいれい"],["を"],["守る","まもる"],["か"],["どう"],["か"],["、"],["あなた"],["の"],["心","こころ"],["の"],["うち"],["に"],["ある"],["もの"],["を"],["知る","しる"],["ため"],["で"],["あった"],["。"]]},{"verse":3,"text":"それで主は、あなたを苦しめ、飢えさせて、あなたも知らず、あなたの先祖たちも知らなかったマナを食べさせられた。それは、人はパンだけで生きるのではない、人は主の口から出るすべてのもので生きる、ということを、あなたにわからせるためであった。","tok":[["それ"],["で"],["主","ぬし"],["は"],["、"],["あなた"],["を"],["苦しめ","くるしめ"],["、"],["飢えさせて","うえさせて"],["、"],["あなた"],["も"],["知らず","しらず"],["、"],["あなた"],["の"],["先祖","せんぞ"],["たち"],["も"],["知らなかった","しらなかった"],["マナ"],["を"],["食べさせられた","たべさせられた"],["。"],["それ"],["は"],["、"],["人","ひと"],["は"],["パン"],["だけ"],["で"],["生きる","いきる"],["ので"],["は"],["ない"],["、"],["人","ひと"],["は"],["主","ぬし"],["の"],["口","くち"],["から"],["出る","でる"],["すべて"],["の"],["もの"],["で"],["生きる","いきる"],["、"],["と"],["いう"],["こと"],["を"],["、"],["あなた"],["に"],["わからせる"],["ため"],["で"],["あった"],["。"]]},{"verse":4,"text":"この四十年の間、あなたの着物はすり切れず、あなたの足は、はれなかった。","tok":[["この"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["あなた"],["の"],["着物","きもの"],["は
[{"verse":1,"text":"あなたの神、主があなたに与えて所有させようとしておられる地で、刺し殺されて野に倒れている人が見つかり、だれが殺したのかわからないときは、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えて","あたえて"],["所有","しょゆう"],["させよう"],["として"],["おられる"],["地","ち"],["で"],["、"],["刺し殺されて","さしころされて"],["野","の"],["に"],["倒れて","たおれて"],["いる"],["人","ひと"],["が"],["見つかり","みつかり"],["、"],["だれ"],["が"],["殺した","ころした"],["の"],["か"],["わからない"],["とき"],["は"],["、"]]},{"verse":2,"text":"あなたの長老たちとさばきつかさたちは出て行って、刺し殺された者の回りの町々への距離を測りなさい。","tok":[["あなた"],["の"],["長老","ちょうろう"],["たち"],["と"],["さばき"],["つかさ"],["たち"],["は"],["出て","でて"],["行って","いって"],["、"],["刺し殺された","さしころされた"],["者","もの"],["の"],["回り","まわり"],["の"],["町々","まちまち"],["へ"],["の"],["距離","きょり"],["を"],["測り","はかり"],["なさい"],["。"]]},{"verse":3,"text":"そして、刺し殺された者に最も近い町がわかれば、その町の長老たちは、まだ使役されず、まだくびきを負って引いたことのない群れのうちの雌の子牛を取り、","tok":[["そして"],["、"],["刺し殺された","さしころされた"],["者","もの"],["に"],["最も","もっとも"],["近い","ちかい"],["町","まち"],["が"],["わかれば"],["、"],["その"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["は"],["、"],["まだ"],["使役","しえき"],["されず"],["、"],["まだ"],["くびき"],["を"],["負って","おって"],["引いた","ひいた"],["こと"],["の"],["ない"],["群れ","むれ"],["の"],["うち"],["の"],["雌","めす"],["の"],["子牛","こうし"],["を"],["取り","とり"],["、"]]},{"verse":4,"text":"その町の長老たちは、その雌の子牛を、まだ耕されたことも種を蒔かれたこともない、いつも水の流れている谷へ連れて下り、その谷で雌の子牛の首を折りなさい。","tok":[["その"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["は"],["、"],["その"],["雌","めす"],["の"],["子牛","こうし"],["を"],["、"],["まだ"],["耕された","たがやされた"],["こと"],["も"],["種","しゅ"],["を"],["蒔かれた","まかれた"],["こと"],["も"],["ない"],["、"],["いつも"],["水","みず"],["の"],["流れて","ながれて"],["いる"],["谷","たに"],["へ"],["連れて","つれて"],["下り","くだり"],["、"],["その"],["谷","たに"],["で"],["雌","めす"],["の"],["子牛","こうし"],["の"],["首","くび"],["を"],["折り","おり"],["なさい"],["。"]]},{"verse":5,"text":"そこでレビ族の祭司たちが進み出なさい。彼らは、あなたの神、主が、ご自身に仕えさせ、また主の御名によって祝福を宣言するために選ばれた者であり、どんな争いも、どんな暴行事件も、彼らの判決によるからである。","tok":[["そこ"],["で"],["レビ族","れびぞく"],["の"],["祭司","さいし"],["たち"],["が"],["進み出","すすみで"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["ご自身","ごじしん"],["に"],["仕えさせ","つかえさせ"],["、"],["また"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["祝福","しゅくふく"],["を"],["宣言","せんげん"],["する"],["ため"],["に"],["選ばれた","えらばれた"],["者","もの"],["で"],["あり"],["、"],["どんな"],["争い","あらそい"],["も"],["、"],["どんな"],["暴行","ぼうこう"],["事件","じけん"],["も"],["、"],["彼","かれ"],["ら"],["の"],["判決","はんけつ"],["に"],["よる"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"刺し殺された者に最も近い、その町の長老たちはみな、谷で首を折られた雌の子牛の上で手を洗い、","tok":[["刺し殺された","さしころされた"],["者","もの"],["に"],["最も","もっとも"],["近い","ちかい"],["、"],["その"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["は"],["みな"],["、"],["谷","たに"],["で"],["首","くび"],["を"],["折られた","おられた"],["雌","めす"],["の"],["子牛","こうし"],["の"],["上","うえ"],["で"],["手","て"],["を"],["洗い","あらい"],["、"]]},{"verse":7,"text":"証言して言いなさい。「私たちの手は、この血を流さず、私たちの目はそれを見なかった。","tok":[["証言","しょうげん"],["して"],["言い","いい"],["なさい"],["。"],["「"],["私たち","わたしたち"],["の"],["手","て"],["は"],["、"],["この"],["血","ち"],["を"],["流さず","ながさず"],["、"],["私たち","わたしたち"],["の"],["目","め"],["は"],["それ"],["を"],["見なかった","みなかった"],["。"]]},{"verse":8,"text":"主よ。あなたが贖い出された御民イスラエルをお赦しください。罪のない者の血を流す罪を、御民イスラエルのうちに負わせないでください。」彼らは血の罪を赦される。","tok":[["主","ぬし"],["よ"],["。"],["あなた"],["が"],["贖い","あがない"],["出された","だされた"],["御民","ごみん"],["イスラエル"],["を"],["お赦し","おゆるし"],["ください"],["。"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["流す","ながす"],["罪","つみ"],["を"],["、"],["御民","ごみん"],["イスラエル"],["の"],["うち"],["に"],["負わせないで","おわせないで"],["ください"],["。"],["」"],["彼","かれ"],["ら"],["は"],["血","ち"],["の"],["罪","つみ"],["を"],["赦される","ゆるされる"],["。"]]},{"verse":9,"text":"あなたは、罪のない者の血を流す罪をあなたがたのうちから除き去らなければならない。主が正しいと見られることをあなたは行わなければならないからである。","tok":[["あなた"],["は"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["流す","ながす"],["罪","つみ"],["を"],["あなた"],["がた"],["の"],["うち"],["から"],["除き去らなければ","のぞきさらなければ"],["ならない"],["。"],["主","ぬし"],["が"],["正しい","ただしい"],["と"],["見られる","みられる"],["こと"],["を"],["あなた"],["は"],["行わなければ","おこなわなければ"],["ならない"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたが敵との戦いに出て、あなたの神、主が、その敵をあなたの手に渡し、あなたがそれを捕虜として捕らえて行くとき、","tok":[["あなた"],["が"],["敵","てき"],["と"],["の"],["戦い","たたかい"],["に"],["出て","でて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["その"],["敵","てき"],["を"],["あなた"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["あなた"],["が"],["それ"],["を"],["捕虜","ほりょ"],["として"],["捕らえて","とらえて"],["行く","いく"],["とき"],["、"]]},{"verse":11,"text":"その捕虜の中に、姿の美しい女性を見、その女を恋い慕い、妻にめとろうとするなら、","tok":[["その"],["捕虜","ほりょ"],["の"],["中","なか"],["に"],["、"],["姿","すがた"],["の"],["美しい","うつくしい"],["女性","じょせい"],["を"],["見","み"],["、"],["その"],["女","おんな"],["を"],["恋い慕い","こいしたい"],["、"],["妻","つま"],["に"],["めとろう"],["と"],["するなら"],["、"]]},{"verse":12,"text":"その女をあなたの家に連れて行きなさい。女は髪をそり、爪を切り、","tok":[["その"],["女","おんな"],["を"],["あなた"],["の"],["家","いえ"],["に"],["連れて","つれて"],["行き","いき"],["なさい"],["。"],["女","おんな"],["は"],["髪","かみ"],["を"],["そり"],["、"],["爪","つめ"],["を"],["切り","きり"],["、"]]},{"verse":13,"text":"捕虜の着物を脱ぎ、あなたの家にいて、自分の父と母のため、一か月の間、泣き悲しまなければならない。その後、あなたは彼女のところに入り、彼女の夫となることができる。彼女はあなたの妻となる。","tok":[["捕虜","ほりょ"],["の"],["着物","きもの"],["を"],["脱ぎ","ぬぎ"],["、"],["あなた"],["の"],["家","いえ"],["に"],["いて"],["、"],["自分","じぶん"],["の"],["父","ちち"],["と"],["母","はは"],["の"],["ため"],["、"],["一","いち"],["か月","かげつ"],["の"],["間","あいだ"],["、"],["泣き悲しまなければ","なきかなしまなければ"],["ならない"],["。"],["その"],["後","ご"],["、"],["あなた"],["は"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入り","はいり"],["、"],["彼女","かのじょ"],["の"],["夫","おっと"],["と"],["なる"],["こと"],["が"],["できる"],["。"],["彼女","かのじょ"],["は"],["あなた"],["の"],["妻","つま"],["と"],["なる"],["。"]]},{"verse":14,"text":"もしあなたが彼女を好まなくなったなら、彼女を自由の身にしなさい。決して金で売ってはならない。あなたは、すでに彼女を意のままにしたのであるから、彼女を奴隷として扱ってはならない。","tok":[["もし"],["あなた"],["が"],["彼女","かのじょ"],["を"],["好まなく","このまなく"],["なったなら"],["、"],["彼女","かのじょ"],["を"],["自由","じゆう"],["の"],["身","み"],["に"],["し"],["なさい"],["。"],["決して","けっして"],["金","かね"],["で"],["売って","うって"],["は"],["ならない"],["。"],["あなた"],["は"],["、"],["すでに"],["彼女","かのじょ"],["を"],["意","い"],["の"],["まま"],["に"],["した"],["ので"],["ある"],["から"],["、"],["彼女","かのじょ"],["を"],["奴隷","どれい"],["として"],["扱って","あつかって"],["は"],["ならない"],["。"]]},{"verse":15,"text":"ある人がふたりの妻を持ち、ひとりは愛され、ひとりはきらわれており、愛されている者も、きらわれている者も、その人に男の子を産み、長子はきらわれている妻の子である場合、","tok":[["ある"],["人","ひと"],["が"],["ふたり"],["の"],["妻","つま"],["を"],["持ち","もち"],["、"],["ひとり"],["は"],["愛され","あいされ"],["、"],["ひとり"],["は"],["きらわれて"],["おり"],["、"],["愛されて","あいされて"],["いる"],["者","もの"],["も"],["、"],["きらわれて"],["いる"],["者","もの"],["も"],["、"],["その"],["人","ひと"],["に"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["長子","ちょうし"],["は"],["きらわれて"],["いる"],["妻","つま"],["の"],["子","こ"],["で"],["ある"],["場合","ばあい"],["、"]]},{"verse":16,"text":"その人が自分の息子たちに財産を譲る日に、長子である、そのきらわれている者の子をさしおいて、愛されている者の子を長子として扱うことはできない。","tok":[["その"],["人","ひと"],["が"],["自分","じぶん"],["の"],["息子","むすこ"],["たち"],["に"],["財産","ざいさん"],["を"],["譲る","ゆずる"],["日","ひ"],["に"],["、"],["長子","ちょうし"],["で"],["ある"],["、"],["その"],["きらわれて"],["いる"],["者","もの"],["の"],["子","こ"],["を"],["さしおいて"],["、"],["愛されて","あいされて"],["いる"],["者","もの"],["の"],["子","こ"],["を"],["長子","ちょうし"],["として"],["扱う","あつかう"],["こと"],["は"],["できない"],["。"]]},{"verse":17,"text":"きらわれている妻の子を長子として認め、自分の全財産の中から、二倍の分け前を彼に与えなければならない。彼は、その人の力の初めであるから、長子の権利は、彼のものである。","tok":[["きらわれて"],["いる"],["妻","つま"],["の"],["子","こ"],["を"],["長子","ちょうし"],["として"],["認め","みとめ"],["、"],["自分","じぶん"],["の"],["全","ぜん"],["財産","ざいさん"],["の"],["中","なか"],["から"],["、"],["二","に"],["倍","ばい"],["の"],["分け前","わけまえ"],["を"],["彼","かれ"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"],["彼","かれ"],["は"],["、"],["その"],["人","ひと"],["の"],["力","ちから"],["の"],["初め","はじめ"],["で"],["ある"],["から"],["、"],["長子","ちょうし"],["の"],["権利","けんり"],["は"],["、"],["彼","かれ"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":18,"text":"かたくなで、逆らう子がおり、父の言うことも、母の言うことも聞かず、父母に懲らしめられても、父母に従わないときは、","tok":[["かたくな"],["で"],["、"],["逆らう","さからう"],["子","こ"],["が"],["おり"],["、"],["父","ちち"],["の"],["言う","いう"],["こと"],["も"],["、"],["母","はは"],["の"],["言う","いう"],["こと"],["も"],["聞かず","きかず"],["、"],["父母","ふぼ"],["に"],["懲らしめられて","こらしめられて"],["も"],["、"],["父母","ふぼ"],["に"],["従わない","したがわない"],["とき"],["は"],["、"]]},{"verse":19,"text":"その父と母は、彼を捕らえ、町の門にいる町の長老たちのところへその子を連れて行き、","tok":[["その"],["父","ちち"],["と"],["母","はは"],["は"],["、"],["彼","かれ"],["を"],["捕らえ","とらえ"],["、"],["町","まち"],["の"],["門","もん"],["に"],["
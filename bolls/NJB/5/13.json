[{"verse":1,"text":"あなたがたのうちに預言者または夢見る者が現れ、あなたに何かのしるしや不思議を示し、","tok":[["あなた"],["がた"],["の"],["うち"],["に"],["預言者","よげんしゃ"],["また"],["は"],["夢見る","ゆめみる"],["者","もの"],["が"],["現れ","あらわれ"],["、"],["あなた"],["に"],["何","なん"],["か"],["の"],["しるし"],["や"],["不思議","ふしぎ"],["を"],["示し","しめし"],["、"]]},{"verse":2,"text":"あなたに告げたそのしるしと不思議が実現して、「さあ、あなたが知らなかったほかの神々に従い、これに仕えよう」と言っても、","tok":[["あなた"],["に"],["告げた","つげた"],["その"],["しるし"],["と"],["不思議","ふしぎ"],["が"],["実現","じつげん"],["して"],["、"],["「"],["さあ"],["、"],["あなた"],["が"],["知らなかった","しらなかった"],["ほか"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["これ"],["に"],["仕えよう","つかえよう"],["」"],["と"],["言って","いって"],["も"],["、"]]},{"verse":3,"text":"その預言者、夢見る者のことばに従ってはならない。あなたがたの神、主は、あなたがたが心を尽くし、精神を尽くして、ほんとうに、あなたがたの神、主を愛するかどうかを知るために、あなたがたを試みておられるからである。","tok":[["その"],["預言者","よげんしゃ"],["、"],["夢","ゆめ"],["見る","みる"],["者","もの"],["の"],["ことば"],["に"],["従って","したがって"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["が"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["精神","せいしん"],["を"],["尽くして","つくして"],["、"],["ほんとう"],["に"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["愛する","あいする"],["か"],["どう"],["か"],["を"],["知る","しる"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["試みて","こころみて"],["おられる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"あなたがたの神、主に従って歩み、主を恐れなければならない。主の命令を守り、御声に聞き従い、主に仕え、主にすがらなければならない。","tok":[["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["従って","したがって"],["歩み","あゆみ"],["、"],["主","ぬし"],["を"],["恐れなければ","おそれなければ"],["ならない"],["。"],["主","ぬし"],["の"],["命令","めいれい"],["を"],["守り","まもり"],["、"],["御声","おこえ"],["に"],["聞き従い","ききしたがい"],["、"],["主に","おもに"],["仕え","つかえ"],["、"],["主に","おもに"],["すがらなければ"],["ならない"],["。"]]},{"verse":5,"text":"その預言者、あるいは、夢見る者は殺されなければならない。その者は、あなたがたをエジプトの国から連れ出し、奴隷の家から贖い出された、あなたがたの神、主に、あなたがたを反逆させようとそそのかし、あなたの神、主があなたに歩めと命じた道から、あなたを迷い出させようとするからである。あなたがたのうちからこの悪を除き去りなさい。","tok":[["その"],["預言者","よげんしゃ"],["、"],["あるいは"],["、"],["夢","ゆめ"],["見る","みる"],["者","もの"],["は"],["殺されなければ","ころされなければ"],["ならない"],["。"],["その"],["者","もの"
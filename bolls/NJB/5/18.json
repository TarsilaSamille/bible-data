[{"verse":1,"text":"レビ人の祭司たち、レビ部族全部は、イスラエルといっしょに、相続地の割り当てを受けてはならない。彼らは主への火によるささげ物を、自分への割り当て分として、食べていかなければならない。","tok":[["レビ人","れびにん"],["の"],["祭司","さいし"],["たち"],["、"],["レビ"],["部族","ぶぞく"],["全部","ぜんぶ"],["は"],["、"],["イスラエル"],["と"],["いっしょ"],["に"],["、"],["相続","そうぞく"],["地","ち"],["の"],["割り当て","わりあて"],["を"],["受けて","うけて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["へ"],["の"],["火","ひ"],["に"],["よる"],["ささげ物","ささげもの"],["を"],["、"],["自分","じぶん"],["へ"],["の"],["割り当て","わりあて"],["分","ぶん"],["として"],["、"],["食べて","たべて"],["いかなければ"],["ならない"],["。"]]},{"verse":2,"text":"彼らは、その兄弟たちの部族の中で相続地を持ってはならない。主が約束されたとおり、主ご自身が、彼らの相続地である。","tok":[["彼","かれ"],["ら"],["は"],["、"],["その"],["兄弟","きょうだい"],["たち"],["の"],["部族","ぶぞく"],["の"],["中","なか"],["で"],["相続","そうぞく"],["地","ち"],["を"],["持って","もって"],["は"],["ならない"],["。"],["主","ぬし"],["が"],["約束","やくそく"],["された"],["とおり"],["、"],["主","しゅ"],["ご自身","ごじしん"],["が"],["、"],["彼","かれ"],["ら"],["の"],["相続","そうぞく"],["地","ち"],["で"],["ある"],["。"]]},{"verse":3,"text":"祭司たちが民から、牛でも羊でも、いけにえをささげる者から、受けるべきものは次のとおりである。その人は、肩と両方の頬と胃とを祭司に与える。","tok":[["祭司","さいし"],["たち"],["が"],["民","たみ"],["から"],["、"],["牛","うし"],["で"],["も"],["羊","ひつじ"],["で"],["も"],["、"],["いけにえ"],["を"],["ささげる"],["者","もの"],["から"],["、"],["受けるべき","うけるべき"],["もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["その"],["人","ひと"],["は"],["、"],["肩","かた"],["と"],["両方","りょうほう"],["の"],["頬","ほお"],["と"],["胃","い"],["と"],["を"],["祭司","さいし"],["に"],["与える","あたえる"],["。"]]},{"verse":4,"text":"あなたの穀物や、新しいぶどう酒や、油などの初物、羊の毛の初物も彼に与えなければならない。","tok":[["あなた"],["の"],["穀物","こくもつ"],["や"],["、"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["や"],["、"],["油","あぶら"],["など"],["の"],["初物","はつもの"],["、"],["羊","ひつじ"],["の"],["毛","け"],["の"],["初物","はつもの"],["も"],["彼","かれ"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":5,"text":"彼とその子孫が、いつまでも、主の御名によって奉仕に立つために、あなたの神、主が、あなたの全部族の中から、彼を選ばれたのである。","tok":[["彼","かれ"],["と"],["その"],["子孫","しそん"],["が"],["、"],["いつ"],["まで"],["も"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["奉仕","ほうし"],["に"],["立つ","たつ"],["ため"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["の"],["全部族","ぜんぶぞく"],["の"],["中","なか"],["から"],["、"],["彼","かれ"],["を"],["選ばれた","えらばれた"],["ので"],["ある"],["。"]]},{"verse":6,"text":"もし、ひとりのレビ人が、自分の住んでいたイスラエルのうちのどの町囲みのうちからでも出て、主の選ぶ場所に行きたいなら、望むままに行くことができる。","tok":[["もし"],["、"],["ひとり"],["の"],["レビ人","れびにん"],["が"],["、"],["自分","じぶん"],["の"],["住んで","すんで"],["いた"],["イスラエル"],["の"],["うち"],["の"],["どの"],["町","まち"],["囲み","かこみ"],["の"],["うち"],["から"],["で"],["も"],["出て","でて"],["、"],["主","ぬし"],["の"],["選ぶ","えらぶ"],["場所","ばしょ"],["に"],["行きたいなら","いきたいなら"],["、"],["望む","のぞむ"],["まま"],["に"],["行く","いく"],["こと"],["が"],["できる"],["。"]]},{"verse":7,"text":"彼は、その所で主の前に仕えている自分の同族レビ人と全く同じように、彼の神、主の御名によって奉仕することができる。","tok":[["彼","かれ"],["は"],["、"],["その"],["所","ところ"],["で"],["主","ぬし"],["の"],["前","まえ"],["に"],["仕えて","つかえて"],["いる"],["自分","じぶん"],["の"],["同族","どうぞく"],["レビ人","れびにん"],["と"],["全く","まったく"],["同じ","おなじ"],["よう"],["に"],["、"],["彼","かれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["奉仕","ほうし"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":8,"text":"彼の分け前は、相続財産を売った分は別として、彼らが食べる分け前と同じである。","tok":[["彼","かれ"],["の"],["分け前","わけまえ"],["は"],["、"],["相続","そうぞく"],["財産","ざいさん"],["を"],["売った","うった"],["分","ぶん"],["は"],["別","べつ"],["として"],["、"],["彼","かれ"],["ら"],["が"],["食べる","たべる"],["分け前","わけまえ"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたの神、主があなたに与えようとしておられる地に入ったとき、あなたはその異邦の民の忌みきらうべきならわしをまねてはならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えよう","あたえよう"],["として"],["おられる"],["地","ち"],["に"],["入った","はいった"],["とき"],["、"],["あなた"],["は"],["その"],["異邦","いほう"],["の"],["民","たみ"],["の"],["忌みきらうべき","いみきらうべき"],["ならわし"],["を"],["まねて"],["は"],["ならない"],["。"]]},{"verse":10,"text":"あなたのうちに自分の息子、娘に火の中を通らせる者があってはならない。占いをする者、卜者、まじない師、呪術者、","tok":[["あなた"],["の"],["うち"],["に"],["自分","じぶん"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["に"],["火","ひ"],["の"],["中","なか"],["を"],["通らせる","とおらせる"],["者","もの"],["が"],["あって"],["は"],["ならない"],["。"],["占い","うらない"],["を"],["する"],["者","もの"],["、"],["卜者","ぼくしゃ"],["、"],["まじない"],["師","し"],["、"],["呪術者","じゅじゅつしゃ"],["、"]]},{"verse":11,"text":"呪文を唱える者、霊媒をする者、口寄せ、死人に伺いを立てる者があってはならない。","tok":[["呪文","じゅもん"],["を"],["唱える","となえる"],["者","もの"],["、"],["霊媒","れいばい"],["を"],["する"],["者","もの"],["、"],["口寄せ","くちよせ"],["、"],["死人","しにん"],["に"],["伺い","うかがい"],["を"],["立てる","たてる"],["者","もの"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":12,"text":"これらのことを行う者はみな、主が忌みきらわれるからである。これらの忌みきらうべきことのために、あなたの神、主は、あなたの前から、彼らを追い払われる。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["行う","おこなう"],["者","もの"],["は"],["みな"],["、"],["主","ぬし"],["が"],["忌みきらわれる","いみきらわれる"],["から"],["で"],["ある"],["。"],["これ"],["ら"],["の"],["忌みきらうべき","いみきらうべき"],["こと"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["前","まえ"],["から"],["、"],["彼","かれ"],["ら"],["を"],["追い払われる","おいはらわれる"],["。"]]},{"verse":13,"text":"あなたは、あなたの神、主に対して全き者でなければならない。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["対して","たいして"],["全","ぜん"],["き者","きしゃ"],["で"],["なければ"],["ならない"],["。"]]},{"verse":14,"text":"あなたが占領しようとしているこれらの異邦の民は、卜者や占い師に聞き従ってきたのは確かである。しかし、あなたには、あなたの神、主は、そうすることを許されない。","tok":[["あなた"],["が"],["占領","せんりょう"],["しよう"],["として"],["いる"],["これ"],["ら"],["の"],["異邦","いほう"],["の"],["民","たみ"],["は"],["、"],["卜者","ぼくしゃ"],["や"],["占い師","うらないし"],["に"],["聞き従って","ききしたがって"],["きた"],["の"],["は"],["確か","たしか"],["で"],["ある"],["。"],["しかし"],["、"],["あなた"],["に"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["そう"],["する"],["こと"],["を"],["許されない","ゆるされない"],["。"]]},{"verse":15,"text":"あなたの神、主は、あなたのうちから、あなたの同胞の中から、私のようなひとりの預言者をあなたのために起こされる。彼に聞き従わなければならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["うち"],["から"],["、"],["あなた"],["の"],["同胞","どうほう"],["の"],["中","なか"],["から"],["、"],["私","わたくし"],["の"],["よう"],["な"],["ひとり"],["の"],["預言者","よげんしゃ"],["を"],["あなた"],["の"],["ため"],["に"],["起こされる","おこされる"],["。"],["彼","かれ"],["に"],["聞き従わなければ","ききしたがわなければ"],["ならない"],["。"]]},{"verse":16,"text":"これはあなたが、ホレブであの集まりの日に、あなたの神、主に求めたそのことによるものである。あなたは、「私の神、主の声を二度と聞きたくありません。またこの大きな火をもう見たくありません。私は死にたくありません」と言った。","tok":[["これ"],["は"],["あなた"],["が"],["、"],["ホレブ"],["で"],["あの"],["集まり","あつまり"],["の"],["日","ひ"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["求めた","もとめた"],["その"],["こと"],["に"],["よる"],["もの"],["で"],["ある"],["。"],["あなた"],["は"],["、"],["「"],["私","わたくし"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["声","こえ"],["を"],["二","に"],["度","ど"],["と"],["聞きたく","ききたく"],["ありません"],["。"],["また"],["この"],["大きな","おおきな"],["火","ひ"],["を"],["もう"],["見たく","みたく"],["ありません"],["。"],["私","わたくし"],["は"],["死にたく","しにたく"],["ありません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"それで主は私に言われた。「彼らの言ったことはもっともだ。","tok":[["それ"],["で"],["主","ぬし"],["は"],["私","わたくし"],["に"],["言われた","いわれた"],["。"],["「"],["彼","かれ"],["ら"],["の"],["言った","いった"],["こと"],["は"],["もっとも"],["だ"],["。"]]},{"verse":18,"text":"わたしは彼らの同胞のうちから、彼らのためにあなたのようなひとりの預言者を起こそう。わたしは彼の口にわたしのことばを授けよう。彼は、わたしが命じることをみな、彼らに告げる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["同胞","どうほう"],["の"],["うち"],["から"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["あなた"],["の"],["よう"],["な"],["ひとり"],["の"],["預言者","よげんしゃ"],["を"],["起こそう","おこそう"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["口","くち"],["に"],["わたし"],["の"],["ことば"],["を"],["授けよう","さずけよう"],["。"],["彼","かれ"],["は"],["、"],["わたし"],["が"],["命じる","めいじる"],["こと"],["を"],["みな"],["、"],["彼","かれ"],["ら"],["に"],["告げる","つげる"],["。"]]},{"verse":19,"text":"わたしの名によって彼が告げるわたしのことばに聞き従わない者があれば、わたしが彼に責任を問う。","tok":[["わたし"],["の"],["名","な"],["によって"],["彼","かれ"],["が"],["告げる","つげる"],["わたし"],["の"],["ことば"],["に"],["聞き従わない","ききしたがわない"],["者","もの"],["が"],["あれば"],["、"],["わたし"],["が"],["彼","かれ"],["に"],["責任","せきにん"],["を"],["問う","とう"],["。"]]},{"verse":20,"text":"ただし、わたしが告げよと命じていないことを、不遜にもわたしの名によって告げたり、あるいは、ほかの神々の名によって告げたりする預言者があるなら、その預言者は死ななければならない。」","tok":[["ただし"],["、"],["わたし"],["が"],["告げよ","つげよ"],["と"],["命じて","めいじて"],["いない"],["こと"],["を"],["、"],["不遜","ふそん"],["に"],["も"],["わたし"],["の"],["名","な"],["によって"],["告げ","つげ"],["たり"],["、"],["あるいは"],["、"],["ほか"],["の"],["神々","かみがみ"],["の"],["名","な"],["によって"],["告げ","つげ"],["たり"],["する"],["預言者","よげんしゃ"],["が"],["あるなら"],["、"],[
[{"verse":1,"text":"それから、私たちは向きを変え、主が私に告げられたように、葦の海への道を荒野に向かって旅立って、その後、長らくセイル山のまわりを回っていた。","tok":[["それ"],["から"],["、"],["私たち","わたしたち"],["は"],["向き","むき"],["を"],["変え","かえ"],["、"],["主","ぬし"],["が"],["私","わたくし"],["に"],["告げられた","つげられた"],["よう"],["に"],["、"],["葦","あし"],["の"],["海","うみ"],["へ"],["の"],["道","みち"],["を"],["荒野","あらの"],["に"],["向かって","むかって"],["旅立って","たびだって"],["、"],["その"],["後","ご"],["、"],["長らく","ながらく"],["セイル山","せいるさん"],["の"],["まわり"],["を"],["回って","まわって"],["いた"],["。"]]},{"verse":2,"text":"主は私にこう仰せられた。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["こう"],["仰せられた","おおせられた"],["。"]]},{"verse":3,"text":"「あなたがたは長らくこの山のまわりを回っていたが、北のほうに向かって行け。","tok":[["「"],["あなた"],["がた"],["は"],["長らく","ながらく"],["この"],["山","やま"],["の"],["まわり"],["を"],["回って","まわって"],["いた"],["が"],["、"],["北","きた"],["の"],["ほう"],["に"],["向かって","むかって"],["行け","いけ"],["。"]]},{"verse":4,"text":"民に命じてこう言え。あなたがたは、セイルに住んでいるエサウの子孫、あなたがたの同族の領土内を通ろうとしている。彼らはあなたがたを恐れるであろう。あなたがたは、十分に注意せよ。","tok":[["民","みん"],["に"],["命じて","めいじて"],["こう"],["言え","いえ"],["。"],["あなた"],["がた"],["は"],["、"],["セイル"],["に"],["住んで","すんで"],["いる"],["エサウ"],["の"],["子孫","しそん"],["、"],["あなた"],["がた"],["の"],["同族","どうぞく"],["の"],["領土内","りょうどない"],["を"],["通ろう","とおろう"],["として"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["恐れるで","おそれるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["、"],["十分","じゅうぶん"],["に"],["注意","ちゅうい"],["せよ"],["。"]]},{"verse":5,"text":"彼らに争いをしかけてはならない。わたしは彼らの地を、足の裏で踏むほども、あなたがたには与えない。わたしはエサウにセイル山を彼の所有地として与えたからである。","tok":[["彼","かれ"],["ら"],["に"],["争い","あらそい"],["を"],["しかけて"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["地","ち"],["を"],["、"],["足","あし"],["の"],["裏","うら"],["で"],["踏む","ふむ"],["ほど"],["も"],["、"],["あなた"],["がた"],["に"],["は"],["与えない","あたえない"],["。"],["わたし"],["は"],["エサウ"],["に"],["セイル山","せいるさん"],["を"],["彼","かれ"],["の"],["所有地","しょゆうち"],["として"],["与えた","あたえた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"食物は、彼らから金で買って食べ、水もまた、彼らから金で買って飲まなければならない。","tok":[["食物","しょくもつ"],["は"],["、"],["彼","かれ"],["ら"],["から"],["金","かね"],["で"],["買って","かって"],["食べ","たべ"],["、"],
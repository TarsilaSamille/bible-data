[{"verse":1,"text":"人と人との間で争いがあり、彼らが裁判に出頭し、正しいほうを正しいとし、悪いほうを悪いとする判決が下されるとき、","tok":[["人","ひと"],["と"],["人","ひと"],["と"],["の"],["間","あいだ"],["で"],["争い","あらそい"],["が"],["あり"],["、"],["彼","かれ"],["ら"],["が"],["裁判","さいばん"],["に"],["出頭","しゅっとう"],["し"],["、"],["正しい","ただしい"],["ほう"],["を"],["正しい","ただしい"],["と"],["し"],["、"],["悪い","わるい"],["ほう"],["を"],["悪い","わるい"],["と"],["する"],["判決","はんけつ"],["が"],["下される","くだされる"],["とき"],["、"]]},{"verse":2,"text":"もし、その悪い者が、むち打ちにすべき者なら、さばきつかさは彼を伏させ、自分の前で、その罪に応じて数を数え、むち打ちにしなければならない。","tok":[["もし"],["、"],["その"],["悪い","わるい"],["者","もの"],["が"],["、"],["むち打ち","むちうち"],["に"],["すべき"],["者","もの"],["なら"],["、"],["さばき"],["つかさ"],["は"],["彼","かれ"],["を"],["伏させ","ふさせ"],["、"],["自分","じぶん"],["の"],["前","まえ"],["で"],["、"],["その"],["罪","つみ"],["に"],["応じて","おうじて"],["数","すう"],["を"],["数え","かぞえ"],["、"],["むち打ち","むちうち"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":3,"text":"四十までは彼をむち打ってよいが、それ以上はいけない。それ以上多くむち打たれて、あなたの兄弟が、あなたの目の前で卑しめられないためである。","tok":[["四十","よんじゅう"],["まで"],["は"],["彼","かれ"],["を"],["むち打って","むちうって"],["よい"],["が"],["、"],["それ"],["以上","いじょう"],["は"],["いけない"],["。"],["それ"],["以上","いじょう"],["多く","おおく"],["むち打たれて","むちうたれて"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["が"],["、"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["卑しめられない","いやしめられない"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"脱穀をしている牛にくつこを掛けてはならない。","tok":[["脱穀","だっこく"],["を"],["して"],["いる"],["牛","うし"],["にく"],["つこ"],["を"],["掛けて","かけて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"兄弟がいっしょに住んでいて、そのうちのひとりが死に、彼に子がない場合、死んだ者の妻は、家族以外のよそ者にとついではならない。その夫の兄弟がその女のところに、入り、これをめとって妻とし、夫の兄弟としての義務を果たさなければならない。","tok":[["兄弟","きょうだい"],["が"],["いっしょ"],["に"],["住んで","すんで"],["いて"],["、"],["その"],["うち"],["の"],["ひとり"],["が"],["死に","しに"],["、"],["彼","かれ"],["に"],["子","こ"],["が"],["ない"],["場合","ばあい"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["妻","つま"],["は"],["、"],["家族","かぞく"],["以外","いがい"],["の"],["よそ者","よそもの"],["に"],["とついで"],["は"],["ならない"],["。"],["その"],["夫","おっと"],["の"],["兄弟","きょうだい"],["が"],["その"],["女","おんな"],["の"],["ところ"],["に"],["、"],["入り","はいり"],["、"],["これ"],["を"],["めとって"],["妻","つま"],["と"],["し"],["、"],["夫","おっと"],["の"],["兄弟","きょうだい"],["として"],["の"],["義務","ぎむ"],["を"],["果たさなければ","はたさなければ"],["ならない"],["。"]]},{"verse":6,"text":"そして彼女が産む初めの男の子に、死んだ兄弟の名を継がせ、その名がイスラエルから消し去られないようにしなければならない。","tok":[["そして"],["彼女","かのじょ"],["が"],["産む","うむ"],["初め","はじめ"],["の"],["男の子","おとこのこ"],["に"],["、"],["死んだ","しんだ"],["兄弟","きょうだい"],["の"],["名","な"],["を"],["継がせ","つがせ"],["、"],["その"],["名","な"],["が"],["イスラエル"],["から"],["消し去られない","けしさられない"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":7,"text":"しかし、もしその人が兄弟の、やもめになった妻をめとりたくない場合は、その兄弟のやもめになった妻は、町の門の長老たちのところに行って言わなければならない。「私の夫の兄弟は、自分の兄弟のためにその名をイスラエルのうちに残そうとはせず、夫の兄弟としての義務を私に果たそうとしません。」","tok":[["しかし"],["、"],["もし"],["その"],["人","ひと"],["が"],["兄弟","きょうだい"],["の"],["、"],["やもめ"],["に"],["なった"],["妻","つま"],["を"],["めとりたく"],["ない"],["場合","ばあい"],["は"],["、"],["その"],["兄弟","きょうだい"],["の"],["やもめ"],["に"],["なった"],["妻","つま"],["は"],["、"],["町","まち"],["の"],["門","もん"],["の"],["長老","ちょうろう"],["たち"],["の"],["ところ"],["に"],["行って","いって"],["言わなければ","いわなければ"],["ならない"],["。"],["「"],["私","わたくし"],["の"],["夫","おっと"],["の"],["兄弟","きょうだい"],["は"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["の"],["ため"],["に"],["その"],["名","な"],["を"],["イスラエル"],["の"],["うち"],["に"],["残そう","のこそう"],["と"],["は"],["せず"],["、"],["夫","おっと"],["の"],["兄弟","きょうだい"],["として"],["の"],["義務","ぎむ"],["を"],["私","わたくし"],["に"],["果たそう","はたそう"],["と"],["しません"],["。"],["」"]]},{"verse":8,"text":"町の長老たちは彼を呼び寄せ、彼に告げなさい。もし、彼が、「私は彼女をめとりたくない」と言い張るなら、","tok":[["町","まち"],["の"],["長老","ちょうろう"],["たち"],["は"],["彼","かれ"],["を"],["呼び寄せ","よびよせ"],["、"],["彼","かれ"],["に"],["告げ","つげ"],["なさい"],["。"],["もし"],["、"],["彼","かれ"],["が"],["、"],["「"],["私","わたくし"],["は"],["彼女","かのじょ"],["を"],["めとりたく"],["ない"],["」"],["と"],["言い張るなら","いいはるなら"],["、"]]},{"verse":9,"text":"その兄弟のやもめになった妻は、長老たちの目の前で、彼に近寄り、彼の足からくつを脱がせ、彼の顔につばきして、彼に答えて言わなければならない。「兄弟の家を立てない男は、このようにされる。」","tok":[["その"],["兄弟","きょうだい"],["の"],["やもめ"],["に"],["なった"],["妻","つま"],["は"],["、"],["長老","ちょうろう"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["彼","かれ"],["に"],["近寄り","ちかより"],["、"],["彼","かれ"],["の"],["足","あし"],["から"],["くつ"],["を"],["脱がせ","ぬがせ"],["、"],["彼","かれ"],["の"],["顔","かお"],["に"],["つばき"],["して"],["、"],["彼","かれ"],["に"],["答えて","こたえて"],["言わなければ","いわなければ"],["ならない"],["。"],["「"],["兄弟","きょうだい"],["の"],["家","いえ"],["を"],["立てない","たてない"],["男","おとこ"],["は"],["、"],["この"],["よう"],["に"],["される"],["。"],["」"]]},{"verse":10,"text":"彼の名は、イスラエルの中で、「くつを脱がされた者の家」と呼ばれる。","tok":[["彼","かれ"],["の"],["名","な"],["は"],["、"],["イスラエル"],["の"],["中","なか"],["で"],["、"],["「"],["くつ"],["を"],["脱がされた","ぬがされた"],["者","もの"],["の"],["家","いえ"],["」"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":11,"text":"ふたりの者が互いに相争っているとき、一方の者の妻が近づき、自分の夫を、打つ者の手から救おうとして、その手を伸ばし、相手の隠しどころをつかんだ場合は、","tok":[["ふたり"],["の"],["者","もの"],["が"],["互い","たがい"],["に"],["相","あい"],["争って","あらそって"],["いる"],["とき"],["、"],["一方","いっぽう"],["の"],["者","もの"],["の"],["妻","つま"],["が"],["近づき","ちかづき"],["、"],["自分","じぶん"],["の"],["夫","おっと"],["を"],["、"],["打つ","うつ"],["者","もの"],["の"],["手","て"],["から"],["救おう","すくおう"],["として"],["、"],["その"],["手","て"],["を"],["伸ばし","のばし"],["、"],["相手","あいて"],["の"],["隠し","かくし"],["どころ"],["を"],["つかんだ"],["場合","ばあい"],["は"],["、"]]},{"verse":12,"text":"その女の手を切り落としなさい。容赦してはならない。","tok":[["その"],["女","おんな"],["の"],["手","て"],["を"],["切り落とし","きりおとし"],["なさい"],["。"],["容赦","ようしゃ"],["して"],["は"],["ならない"],["。"]]},{"verse":13,"text":"あなたは袋に大小異なる重り石を持っていてはならない。","tok":[["あなた"],["は"],["袋","ふくろ"],["に"],["大小","だいしょう"],["異なる","ことなる"],["重り","おもり"],["石","いし"],["を"],["持って","もって"],["いて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"あなたは家に大小異なる枡を持っていてはならない。","tok":[["あなた"],["は"],["家","いえ"],["に"],["大小","だいしょう"],["異なる","ことなる"],["枡","ます"],["を"],["持って","もって"],["いて"],["は"],["ならない"],["。"]]},{"verse":15,"text":"あなたは完全に正しい重り石を持ち、完全に正しい枡を持っていなければならない。あなたの神、主があなたに与えようとしておられる地で、あなたが長く生きるためである。","tok":[["あなた"],["は"],["完全","かんぜん"],["に"],["正しい","ただしい"],["重り","おもり"],["石","いし"],["を"],["持ち","もち"],["、"],["完全","かんぜん"],["に"],["正しい","ただしい"],["枡","ます"],["を"],["持って","もって"],["いなければ"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えよう","あたえよう"],["として"],["おられる"],["地","ち"],["で"],["、"],["あなた"],["が"],["長く","ながく"],["生きる","いきる"],["ため"],["で"],["ある"],["。"]]},{"verse":16,"text":"すべてこのようなことをなし、不正をする者を、あなたの神、主は忌みきらわれる。","tok":[["すべて"],["この"],["よう"],["な"],["こと"],["を"],["なし"],["、"],["不正","ふせい"],["を"],["する"],["者","もの"],["を"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["忌みきらわれる","いみきらわれる"],["。"]]},{"verse":17,"text":"あなたがたがエジプトから出て、その道中で、アマレクがあなたにした事を忘れないこと。","tok":[["あなた"],["がた"],["が"],["エジプト"],["から"],["出て","でて"],["、"],["その"],["道中","どうちゅう"],["で"],["、"],["アマレク"],["が"],["あなた"],["に"],["した"],["事","こと"],["を"],["忘れない","わすれない"],["こと"],["。"]]},{"verse":18,"text":"彼は、神を恐れることなく、道であなたを襲い、あなたが疲れて弱っているときに、あなたのうしろの落後者をみな、切り倒したのである。","tok":[["彼","かれ"],["は"],["、"],["神","かみ"],["を"],["恐れる","おそれる"],["こと"],["なく"],["、"],["道","みち"],["で"],["あなた"],["を"],["襲い","おそい"],["、"],["あなた"],["が"],["疲れて","つかれて"],["弱って","よわって"],["いる"],["とき"],["に"],["、"],["あなた"],["の"],["うしろ"],["の"],["落後者","らくごしゃ"],["を"],["みな"],["、"],["切り倒した","きりたおした"],["ので"],["ある"],["。"]]},{"verse":19,"text":"あなたの神、主が相続地としてあなたに与えて所有させようとしておられる地で、あなたの神、主が、周囲のすべての敵からあなたを解放して、休息を与えられるようになったときには、あなたはアマレクの記憶を天の下から消し去らなければならない。これを忘れてはならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["相続","そうぞく"],["地","ち"],["として"],["あなた"],["に"],["与えて","あたえて"],["所有","しょゆう"],["させよう"],["として"],["おられる"],["地","ち"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["周囲","しゅうい"],["の"],["すべて"],["の"],["敵","てき"],["から"],["あなた"],["を"],["解放","かいほう"],["して"],["、"],["休息","きゅうそく"],["を"],["与えられる","あたえられる"],["よう"],["に"],["なった"],["とき"],["に"],["は"],["、"],["あなた"],["は"],["アマレク"],["の"],["記憶","きおく"],["を"],["天","てん"],["の"],["下","した"],["から"],["消し去らなければ","けしさらなければ"],["ならない"],["。"],["これ"],["を"],["忘れて","わすれて"],["は"],["ならない"],["。"]]}]
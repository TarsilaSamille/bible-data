[{"verse":1,"text":"いつでも祈るべきであり、失望してはならないことを教えるために、イエスは彼らにたとえを話された。","tok":[["いつ"],["で"],["も"],["祈るべきで","いのるべきで"],["あり"],["、"],["失望","しつぼう"],["して"],["は"],["ならない"],["こと"],["を"],["教える","おしえる"],["ため"],["に"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["たとえ"],["を"],["話された","はなされた"],["。"]]},{"verse":2,"text":"「ある町に、神を恐れず、人を人とも思わない裁判官がいた。","tok":[["「"],["ある"],["町","まち"],["に"],["、"],["神","かみ"],["を"],["恐れず","おそれず"],["、"],["人","ひと"],["を"],["人","ひと"],["と"],["も"],["思わない","おもわない"],["裁判官","さいばんかん"],["が"],["いた"],["。"]]},{"verse":3,"text":"その町に、ひとりのやもめがいたが、彼のところにやって来ては、『私の相手をさばいて、私を守ってください』と言っていた。","tok":[["その"],["町","まち"],["に"],["、"],["ひとり"],["の"],["やもめ"],["が"],["いた"],["が"],["、"],["彼","かれ"],["の"],["ところ"],["に"],["やって"],["来て","きて"],["は"],["、"],["『"],["私","わたくし"],["の"],["相手","あいて"],["を"],["さばいて"],["、"],["私","わたくし"],["を"],["守って","まもって"],["ください"],["』"],["と"],["言って","いって"],["いた"],["。"]]},{"verse":4,"text":"彼は、しばらくは取り合わないでいたが、後には心ひそかに『私は神を恐れず人を人とも思わないが、","tok":[["彼","かれ"],["は"],["、"],["しばらく"],["は"],["取り合わないで","とりあわないで"],["いた"],["が"],["、"],["後","あと"],["に"],["は"],["心","こころ"],["ひそか"],["に"],["『"],["私","わたくし"],["は"],["神","かみ"],["を"],["恐れず","おそれず"],["人","ひと"],["を"],["人","ひと"],["と"],["も"],["思わない","おもわない"],["が"],["、"]]},{"verse":5,"text":"どうも、このやもめは、うるさくてしかたがないから、この女のために裁判をしてやることにしよう。でないと、ひっきりなしにやって来てうるさくてしかたがない』と言った。」","tok":[["どう"],["も"],["、"],["この"],["やもめ"],["は"],["、"],["うるさくて"],["しかた"],["が"],["ない"],["から"],["、"],["この"],["女","おんな"],["の"],["ため"],["に"],["裁判","さいばん"],["を"],["して"],["やる"],["こと"],["に"],["しよう"],["。"],["で"],["ない"],["と"],["、"],["ひっきり"],["なし"],["に"],["やって"],["来て","きて"],["うるさくて"],["しかた"],["が"],["ない"],["』"],["と"],["言った","いった"],["。"],["」"]]},{"verse":6,"text":"主は言われた。「不正な裁判官の言っていることを聞きなさい。","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["不正","ふせい"],["な"],["裁判官","さいばんかん"],["の"],["言って","いって"],["いる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"]]},{"verse":7,"text":"まして神は、夜昼神を呼び求めている選民のためにさばきをつけないで、いつまでもそのことを放っておかれることがあるでしょうか。","tok":[["まして"],["神","かみ"],["は"],["、"],["夜昼","よるひる"],["神","かみ"],["を"],["呼び求めて","よびもとめて"],["いる"],["選民","せんみん"],["の"],["ため"],["に"],["さばき"],["を"],["つけないで"],["、"],["いつ"],["まで"],["も"],["その"],["こと"],["を"],["放って","はなって"],["おかれる"],["こと"],["が"],["あるでしょう"],["か"],["。"]]},{"verse":8,"text":"あなたがたに言いますが、神は、すみやかに彼らのために正しいさばきをしてくださいます。しかし、人の子が来たとき、はたして地上に信仰が見られるでしょうか。」","tok":[["あなた"],["がた"],["に"],["言います","いいます"],["が"],["、"],["神","かみ"],["は"],["、"],["すみやか"],["に"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["正しい","ただしい"],["さばき"],["を"],["して"],["くださいます"],["。"],["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["来た","きた"],["とき"],["、"],["はたして"],["地上","ちじょう"],["に"],["信仰","しんこう"],["が"],["見られるでしょう","みられるでしょう"],["か"],["。"],["」"]]},{"verse":9,"text":"自分を義人だと自任し、他の人々を見下している者たちに対しては、イエスはこのようなたとえを話された。","tok":[["自分","じぶん"],["を"],["義人","ぎじん"],["だ"],["と"],["自任","じにん"],["し"],["、"],["他","た"],["の"],["人々","ひとびと"],["を"],["見下して","みくだして"],["いる"],["者","もの"],["たち"],["に"],["対し","たいし"],["ては"],["、"],["イエス"],["は"],["この"],["よう"],["な"],["たとえ"],["を"],["話された","はなされた"],["。"]]},{"verse":10,"text":"「ふたりの人が、祈るために宮に上った。ひとりはパリサイ人で、もうひとりは取税人であった。","tok":[["「"],["ふたり"],["の"],["人","ひと"],["が"],["、"],["祈る","いのる"],["ため"],["に"],["宮","みや"],["に"],["上った","のぼった"],["。"],["ひとり"],["は"],["パリサイ"],["人","にん"],["で"],["、"],["もう"],["ひとり"],["は"],["取","とり"],["税人","ぜいにん"],["で"],["あった"],["。"]]},{"verse":11,"text":"パリサイ人は、立って、心の中でこんな祈りをした。『神よ。私はほかの人々のようにゆする者、不正な者、姦淫する者ではなく、ことにこの取税人のようではないことを、感謝します。","tok":[["パリサイ"],["人","にん"],["は"],["、"],["立って","たって"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["こんな"],["祈り","いのり"],["を"],["した"],["。"],["『"],["神","かみ"],["よ"],["。"],["私","わたくし"],["は"],["ほか"],["の"],["人々","ひとびと"],["の"],["よう"],["に"],["ゆする"],["者","もの"],["、"],["不正","ふせい"],["な"],["者","もの"],["、"],["姦淫","かんいん"],["する"],["者","もの"],["で"],["は"],["なく"],["、"],["こと"],["に"],["この"],["取","とり"],["税人","ぜいにん"],["の"],["よう"],["で"],["は"],["ない"],["こと"],["を"],["、"],["感謝","かんしゃ"],["します"],["。"]]},{"verse":12,"text":"私は週に二度断食し、自分の受けるものはみな、その十分の一をささげております。』","tok":[["私","わたくし"],["は"],["週","しゅう"],["に"],["二","に"],["度","ど"],["断食","だんじき"],["し"],["、"],["自分","じぶ
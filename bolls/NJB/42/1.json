[{"verse":1,"text":"私たちの間ですでに確信されている出来事については、初めからの目撃者で、みことばに仕える者となった人々が、私たちに伝えたそのとおりを、多くの人が記事にまとめて書き上げようと、すでに試みておりますので、","tok":[["私たち","わたしたち"],["の"],["間","あいだ"],["で"],["すでに"],["確信","かくしん"],["されて"],["いる"],["出来事","できごと"],["について"],["は"],["、"],["初め","はじめ"],["から"],["の"],["目撃者","もくげきしゃ"],["で"],["、"],["みことば"],["に"],["仕える","つかえる"],["者","もの"],["と"],["なった"],["人々","ひとびと"],["が"],["、"],["私たち","わたしたち"],["に"],["伝えた","つたえた"],["その"],["とおり"],["を"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["記事","きじ"],["に"],["まとめて"],["書き上げよう","かきあげよう"],["と"],["、"],["すでに"],["試みて","こころみて"],["おります"],["ので"],["、"]]},{"verse":2,"text":"-","tok":[["-"]]},{"verse":3,"text":"私も、すべてのことを初めから綿密に調べておりますから、あなたのために、順序を立てて書いて差し上げるのがよいと思います。尊敬するテオピロ殿。","tok":[["私","わたくし"],["も"],["、"],["すべて"],["の"],["こと"],["を"],["初め","はじめ"],["から"],["綿密","めんみつ"],["に"],["調べて","しらべて"],["おります"],["から"],["、"],["あなた"],["の"],["ため"],["に"],["、"],["順序","じゅんじょ"],["を"],["立てて","たてて"],["書いて","かいて"],["差し上げる","さしあげる"],["の"],["が"],["よい"],["と"],["思います","おもいます"],["。"],["尊敬","そんけい"],["する"],["テオピロ"],["殿","どの"],["。"]]},{"verse":4,"text":"それによって、すでに教えを受けられた事がらが正確な事実であることを、よくわかっていただきたいと存じます。","tok":[["それ"],["によって"],["、"],["すでに"],["教え","おしえ"],["を"],["受けられた","うけられた"],["事がら","ことがら"],["が"],["正確","せいかく"],["な"],["事実","じじつ"],["で"],["ある"],["こと"],["を"],["、"],["よく"],["わかって"],["いただきたい"],["と"],["存じます","ぞんじます"],["。"]]},{"verse":5,"text":"ユダヤの王ヘロデの時に、アビヤの組の者でザカリヤという祭司がいた。彼の妻はアロンの子孫で、名をエリサベツといった。","tok":[["ユダヤ"],["の"],["王","おう"],["ヘロデ"],["の"],["時","とき"],["に"],["、"],["アビヤ"],["の"],["組","くみ"],["の"],["者","もの"],["で"],["ザカリヤ"],["と"],["いう"],["祭司","さいし"],["が"],["いた"],["。"],["彼","かれ"],["の"],["妻","つま"],["は"],["アロン"],["の"],["子孫","しそん"],["で"],["、"],["名","な"],["を"],["エリサベツ"],["と"],["いった"],["。"]]},{"verse":6,"text":"ふたりとも、神の御前に正しく、主のすべての戒めと定めを落度なく踏み行っていた。","tok":[["ふたり"],["とも"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["正しく","ただしく"],["、"],["主","ぬし"],["の"],["すべて"],["の"],["戒め","いましめ"],["と"],["定め","さだめ"],["を"],["落度","おちど"],["なく"],["踏み行って","ふみおこなって"],["いた"],["。"]]},{"verse":7,"text":"エリサベツは
,["入れなく","いれなく"],["なる"],["人","ひと"],["が"],["多い","おおい"],["の"],["です"],["から"],["。"]]},{"verse":25,"text":"家の主人が、立ち上がって、戸をしめてしまってからでは、外に立って、『ご主人さま。あけてください』と言って、戸をいくらたたいても、もう主人は、『あなたがたがどこの者か、私は知らない』と答えるでしょう。","tok":[["家","いえ"],["の"],["主人","しゅじん"],["が"],["、"],["立ち上がって","たちあがって"],["、"],["戸","と"],["を"],["しめて"],["しまって"],["から"],["で"],["は"],["、"],["外","そと"],["に"],["立って","たって"],["、"],["『"],["ご主人","ごしゅじん"],["さま"],["。"],["あけて"],["ください"],["』"],["と"],["言って","いって"],["、"],["戸","と"],["を"],["いくら"],["たたいて"],["も"],["、"],["もう"],["主人","しゅじん"],["は"],["、"],["『"],["あなた"],["がた"],["が"],["どこ"],["の"],["者","もの"],["か"],["、"],["私","わたくし"],["は"],["知らない","しらない"],["』"],["と"],["答えるでしょう","こたえるでしょう"],["。"]]},{"verse":26,"text":"すると、あなたがたは、こう言い始めるでしょう。『私たちは、ごいっしょに、食べたり飲んだりいたしましたし、私たちの大通りで教えていただきました。』","tok":[["する"],["と"],["、"],["あなた"],["がた"],["は"],["、"],["こう"],["言い","いい"],["始めるでしょう","はじめるでしょう"],["。"],["『"],["私たち","わたしたち"],["は"],["、"],["ごいっしょ"],["に"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["いたしました"],["し"],["、"],["私たち","わたしたち"],["の"],["大通り","おおどおり"],["で"],["教えて","おしえて"],["いただきました"],["。"],["』"]]},{"verse":27,"text":"だが、主人はこう言うでしょう。『私はあなたがたがどこの者だか知りません。不正を行う者たち。みな出て行きなさい。』","tok":[["だ"],["が"],["、"],["主人","しゅじん"],["は"],["こう"],["言うでしょう","ゆうでしょう"],["。"],["『"],["私","わたくし"],["は"],["あなた"],["がた"],["が"],["どこ"],["の"],["者","もの"],["だ"],["か"],["知りません","しりません"],["。"],["不正","ふせい"],["を"],["行う","おこなう"],["者","もの"],["たち"],["。"],["みな"],["出て","でて"],["行き","いき"],["なさい"],["。"],["』"]]},{"verse":28,"text":"神の国にアブラハムやイサクやヤコブや、すべての預言者たちが入っているのに、あなたがたは外に投げ出されることになったとき、そこで泣き叫んだり、歯ぎしりしたりするのです。","tok":[["神","かみ"],["の"],["国","くに"],["に"],["アブラハム"],["や"],["イサク"],["や"],["ヤコブ"],["や"],["、"],["すべて"],["の"],["預言者","よげんしゃ"],["たち"],["が"],["入って","はいって"],["いる"],["のに"],["、"],["あなた"],["がた"],["は"],["外","そと"],["に"],["投げ出される","なげだされる"],["こと"],["に"],["なった"],["とき"],["、"],["そこ"],["で"],["泣き叫ん","なきさけん"],["だり"],["、"],["歯ぎしり","はぎしり"],["し"],["たり"],["する"],["の"],["です"],["。"]]},{"verse":29,"text":"人々は、東からも西からも、また南からも北からも来て、神の国で食卓に着きます。","tok":[["人々","ひとびと"],["は"],["、"],["東","ひがし"],["から"],["も"],["西","にし"],["から"],["も"],["、"],["また"],["南","みなみ"],["から"],["も"],["北","きた"],["から"],["も"],["来て","きて"],["、"],["神","かみ"],["の"],["国","くに"],["で"],["食卓","しょくたく"],["に"],["着きます","つきます"],["。"]]},{"verse":30,"text":"いいですか、今しんがりの者があとで先頭になり、いま先頭の者がしんがりになるのです。」","tok":[["いいです"],["か"],["、"],["今","いま"],["しんがり"],["の"],["者","もの"],["が"],["あと"],["で"],["先頭","せんとう"],["に"],["なり"],["、"],["いま"],["先頭","せんとう"],["の"],["者","もの"],["が"],["しんがり"],["に"],["なる"],["の"],["です"],["。"],["」"]]},{"verse":31,"text":"ちょうどそのとき、何人かのパリサイ人が近寄って来て、イエスに言った。「ここから出てほかの所へ行きなさい。ヘロデがあなたを殺そうと思っています。」","tok":[["ちょうど"],["その"],["とき"],["、"],["何人","なんにん"],["か"],["の"],["パリサイ"],["人","にん"],["が"],["近寄って","ちかよって"],["来て","きて"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["ここ"],["から"],["出て","でて"],["ほか"],["の"],["所","ところ"],["へ"],["行き","いき"],["なさい"],["。"],["ヘロデ"],["が"],["あなた"],["を"],["殺そう","ころそう"],["と"],["思って","おもって"],["います"],["。"],["」"]]},{"verse":32,"text":"イエスは言われた。「行って、あの狐にこう言いなさい。『よく見なさい。わたしは、きょうと、あすとは、悪霊どもを追い出し、病人をいやし、三日目に全うされます。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["行って","いって"],["、"],["あの"],["狐","きつね"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["『"],["よく"],["見","み"],["なさい"],["。"],["わたし"],["は"],["、"],["きょう"],["と"],["、"],["あす"],["と"],["は"],["、"],["悪霊","あくりょう"],["ども"],["を"],["追い出し","おいだし"],["、"],["病人","びょうにん"],["を"],["いやし"],["、"],["三日目","みっかめ"],["に"],["全う","まっとう"],["されます"],["。"]]},{"verse":33,"text":"だが、わたしは、きょうもあすも次の日も進んで行かなければなりません。なぜなら、預言者がエルサレム以外の所で死ぬことはありえないからです。』","tok":[["だ"],["が"],["、"],["わたし"],["は"],["、"],["きょう"],["も"],["あす"],["も"],["次","つぎ"],["の"],["日","ひ"],["も"],["進んで","すすんで"],["行かなければ","いかなければ"],["なりません"],["。"],["なぜ"],["なら"],["、"],["預言者","よげんしゃ"],["が"],["エルサレム"],["以外","いがい"],["の"],["所","ところ"],["で"],["死ぬ","しぬ"],["こと"],["は"],["あり"],["えない"],["から"],["です"],["。"],["』"]]},{"verse":34,"text":"ああ、エルサレム、エルサレム。預言者たちを殺し、自分に遣わされた人たちを石で打つ者、わたしは、めんどりがひなを翼の下にかばうように、あなたの子らを幾たび集めようとしたことか。それなのに、あなたがたはそれを好まなかった。","tok":[["ああ"],["、"],["エルサレム"],["、"],["エルサレム"],["。"],["預言者","よげんしゃ"],["たち"],["を"],["殺し","ころし"],["、"],["自分","じぶん"],["に"],["遣わされた","つかわされた"],["人","ひと"],["たち"],["を"],["石","いし"],["で"],["打つ","うつ"],["者","もの"],["、"],["わたし"],["は"],["、"],["めんどり"],["が"],["ひな"],["を"],["翼","つばさ"],["の"],["下","した"],["に"],["かばう"],["よう"],["に"],["、"],["あなた"],["の"],["子","こ"],["ら"],["を"],["幾","いく"],["たび"],["集めよう","あつめよう"],["と"],["した"],["こと"],["か"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["好まなかった","このまなかった"],["。"]]},{"verse":35,"text":"見なさい。あなたがたの家は荒れ果てたままに残される。わたしはあなたがたに言います。『祝福あれ。主の御名によって来られる方に』とあなたがたの言うときが来るまでは、あなたがたは決してわたしを見ることができません。」","tok":[["見","み"],["なさい"],["。"],["あなた"],["がた"],["の"],["家","いえ"],["は"],["荒れ果てた","あれはてた"],["まま"],["に"],["残される","のこされる"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["言います","いいます"],["。"],["『"],["祝福","しゅくふく"],["あれ"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["来られる","こられる"],["方","かた"],["に"],["』"],["と"],["あなた"],["がた"],["の"],["言う","いう"],["とき"],["が"],["来る","くる"],["まで"],["は"],["、"],["あなた"],["がた"],["は"],["決して","けっして"],["わたし"],["を"],["見る","みる"],["こと"],["が"],["できません"],["。"],["」"]]}]
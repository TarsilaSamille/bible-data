[{"verse":1,"text":"ちょうどそのとき、ある人たちがやって来て、イエスに報告した。ピラトがガリラヤ人たちの血をガリラヤ人たちのささげるいけにえに混ぜたというのである。","tok":[["ちょうど"],["その"],["とき"],["、"],["ある"],["人","ひと"],["たち"],["が"],["やって"],["来て","きて"],["、"],["イエス"],["に"],["報告","ほうこく"],["した"],["。"],["ピラト"],["が"],["ガリラヤ"],["人","にん"],["たち"],["の"],["血","ち"],["を"],["ガリラヤ"],["人","にん"],["たち"],["の"],["ささげる"],["いけにえ"],["に"],["混ぜた","まぜた"],["と"],["いう"],["ので"],["ある"],["。"]]},{"verse":2,"text":"イエスは彼らに答えて言われた。「そのガリラヤ人たちがそのような災難を受けたから、ほかのどのガリラヤ人よりも罪深い人たちだったとでも思うのですか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["その"],["ガリラヤ"],["人","にん"],["たち"],["が"],["その"],["よう"],["な"],["災難","さいなん"],["を"],["受けた","うけた"],["から"],["、"],["ほか"],["の"],["どの"],["ガリラヤ"],["人","にん"],["より"],["も"],["罪深い","つみぶかい"],["人","ひと"],["たち"],["だった"],["と"],["で"],["も"],["思う","おもう"],["の"],["です"],["か"],["。"]]},{"verse":3,"text":"そうではない。わたしはあなたがたに言います。あなたがたも悔い改めないなら、みな同じように滅びます。","tok":[["そう"],["で"],["は"],["ない"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["言います","いいます"],["。"],["あなた"],["がた"],["も"],["悔い改めないなら","くいあらためないなら"],["、"],["みな"],["同じ","おなじ"],["よう"],["に"],["滅びます","ほろびます"],["。"]]},{"verse":4,"text":"また、シロアムの塔が倒れ落ちて死んだあの十八人は、エルサレムに住んでいるだれよりも罪深い人たちだったとでも思うのですか。","tok":[["また"],["、"],["シロアム"],["の"],["塔","とう"],["が"],["倒れ","たおれ"],["落ちて","おちて"],["死んだ","しんだ"],["あの"],["十八人","じゅうはちにん"],["は"],["、"],["エルサレム"],["に"],["住んで","すんで"],["いる"],["だれ"],["より"],["も"],["罪深い","つみぶかい"],["人","ひと"],["たち"],["だった"],["と"],["で"],["も"],["思う","おもう"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"そうではない。わたしはあなたがたに言います。あなたがたも悔い改めないなら、みな同じように滅びます。」","tok":[["そう"],["で"],["は"],["ない"],["。"],["わたし"],["は"],["あなた"],["がた"],["に"],["言います","いいます"],["。"],["あなた"],["がた"],["も"],["悔い改めないなら","くいあらためないなら"],["、"],["みな"],["同じ","おなじ"],["よう"],["に"],["滅びます","ほろびます"],["。"],["」"]]},{"verse":6,"text":"イエスはこのようなたとえを話された。／「ある人が、ぶどう園にいちじくの木を植えておいた。実を取りに来たが、何も見つからなかった。","tok":[["イエス"],["は"],["この"],["よう"],["な"],["たとえ"],["を"],["話された","はなされた"],["。"],["／"],["「"],["ある"],["人","ひと"],["が"],["、"],["ぶどう園","ぶどうえん"],["に"],["いちじく"],["の"],["木","き"],["を"],["植えて","うえて"],["おいた"],["。"],["実","じつ"],["を"],["取り","とり"],["に"],["来た","きた"],["が"],["、"],["何","なん"],["も"],["見つからなかった","みつからなかった"],["。"]]},{"verse":7,"text":"そこで、ぶどう園の番人に言った。『見なさい。三年もの間、やって来ては、このいちじくの実のなるのを待っているのに、なっていたためしがない。これを切り倒してしまいなさい。何のために土地をふさいでいるのですか。』","tok":[["そこ"],["で"],["、"],["ぶどう園","ぶどうえん"],["の"],["番人","ばんにん"],["に"],["言った","いった"],["。"],["『"],["見","み"],["なさい"],["。"],["三","さん"],["年","ねん"],["も"],["の"],["間","あいだ"],["、"],["やって"],["来て","きて"],["は"],["、"],["この"],["いちじく"],["の"],["実","じつ"],["の"],["なる"],["の"],["を"],["待って","まって"],["いる"],["のに"],["、"],["なって"],["いた"],["ためし"],["が"],["ない"],["。"],["これ"],["を"],["切り倒して","きりたおして"],["しまい"],["なさい"],["。"],["何","なん"],["の"],["ため"],["に"],["土地","とち"],["を"],["ふさいで"],["いる"],["の"],["です"],["か"],["。"],["』"]]},{"verse":8,"text":"番人は答えて言った。『ご主人。どうか、ことし一年そのままにしてやってください。木の回りを掘って、肥やしをやってみますから。","tok":[["番人","ばんにん"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["『"],["ご主人","ごしゅじん"],["。"],["どう"],["か"],["、"],["ことし"],["一","いち"],["年","ねん"],["そのまま"],["に"],["して"],["やって"],["ください"],["。"],["木","き"],["の"],["回り","まわり"],["を"],["掘って","ほって"],["、"],["肥やし","こやし"],["を"],["やって"],["みます"],["から"],["。"]]},{"verse":9,"text":"もしそれで来年、実を結べばよし、それでもだめなら、切り倒してください。』」","tok":[["もし"],["それ"],["で"],["来年","らいねん"],["、"],["実","じつ"],["を"],["結べば","むすべば"],["よし"],["、"],["それ"],["で"],["も"],["だめ"],["なら"],["、"],["切り倒して","きりたおして"],["ください"],["。"],["』"],["」"]]},{"verse":10,"text":"イエスは安息日に、ある会堂で教えておられた。","tok":[["イエス"],["は"],["安息日","あんそくび"],["に"],["、"],["ある"],["会堂","かいどう"],["で"],["教えて","おしえて"],["おられた"],["。"]]},{"verse":11,"text":"すると、そこに十八年も病の霊につかれ、腰が曲がって、全然伸ばすことのできない女がいた。","tok":[["する"],["と"],["、"],["そこ"],["に"],["十八","じゅうはち"],["年","ねん"],["も"],["病","やまい"],["の"],["霊","れい"],["に"],["つかれ"],["、"],["腰","こし"],["が"],["曲がって","まがって"],["、"],["全然","ぜんぜん"],["伸ばす","のばす"],["こと"],["の"],["できない"],["女","おんな"],["が"],["いた"],["。"]]},{"verse":12,"text":"イエスは、その女を見て、呼び寄せ、「あなたの病気はいやされました」と言って、","tok":[["イエス"],["は"],["、"],["その"],["女","おんな"],["を"],["見て","みて"],["、"],["呼び寄せ","よびよせ"],["、"],["「"],[
[{"verse":1,"text":"皇帝テベリオの治世の第十五年、ポンテオ・ピラトがユダヤの総督、ヘロデがガリラヤの国主、その兄弟ピリポがイツリヤとテラコニテ地方の国主、ルサニヤがアビレネの国主であり、","tok":[["皇帝","こうてい"],["テベリオ"],["の"],["治世","ちせい"],["の"],["第","だい"],["十五","じゅうご"],["年","ねん"],["、"],["ポンテオ"],["・"],["ピラト"],["が"],["ユダヤ"],["の"],["総督","そうとく"],["、"],["ヘロデ"],["が"],["ガリラヤ"],["の"],["国主","こくしゅ"],["、"],["その"],["兄弟","きょうだい"],["ピリポ"],["が"],["イツリヤ"],["と"],["テラコニテ"],["地方","ちほう"],["の"],["国主","こくしゅ"],["、"],["ルサニヤ"],["が"],["アビレネ"],["の"],["国主","こくしゅ"],["で"],["あり"],["、"]]},{"verse":2,"text":"アンナスとカヤパが大祭司であったころ、神のことばが、荒野でザカリヤの子ヨハネに下った。","tok":[["アンナス"],["と"],["カヤパ"],["が"],["大","だい"],["祭司","さいし"],["で"],["あった"],["ころ"],["、"],["神","かみ"],["の"],["ことば"],["が"],["、"],["荒野","こうや"],["で"],["ザカリヤ"],["の"],["子","こ"],["ヨハネ"],["に"],["下った","くだった"],["。"]]},{"verse":3,"text":"そこでヨハネは、ヨルダン川のほとりのすべての地方に行って、罪が赦されるための悔い改めに基づくバプテスマを説いた。","tok":[["そこ"],["で"],["ヨハネ"],["は"],["、"],["ヨルダン"],["川","かわ"],["の"],["ほとり"],["の"],["すべて"],["の"],["地方","ちほう"],["に"],["行って","いって"],["、"],["罪","つみ"],["が"],["赦される","ゆるされる"],["ため"],["の"],["悔い改め","くいあらため"],["に"],["基づく","もとづく"],["バプテスマ"],["を"],["説いた","といた"],["。"]]},{"verse":4,"text":"そのことは預言者イザヤのことばの書に書いてあるとおりである。／「荒野で叫ぶ者の声がする。／『主の道を用意し、主の通られる道をまっすぐにせよ。","tok":[["その"],["こと"],["は"],["預言者","よげんしゃ"],["イザヤ"],["の"],["ことば"],["の"],["書","しょ"],["に"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"],["／"],["「"],["荒野","こうや"],["で"],["叫ぶ","さけぶ"],["者","もの"],["の"],["声","こえ"],["が"],["する"],["。"],["／"],["『"],["主","ぬし"],["の"],["道","みち"],["を"],["用意","ようい"],["し"],["、"],["主","ぬし"],["の"],["通られる","とおられる"],["道","みち"],["を"],["まっすぐ"],["に"],["せよ"],["。"]]},{"verse":5,"text":"すべての谷はうずめられ、すべての山と丘とは低くされ、曲がった所はまっすぐになり、でこぼこ道は平らになる。","tok":[["すべて"],["の"],["谷","たに"],["は"],["うずめられ"],["、"],["すべて"],["の"],["山","やま"],["と"],["丘","おか"],["と"],["は"],["低く","ひくく"],["され"],["、"],["曲がった","まがった"],["所","ところ"],["は"],["まっすぐ"],["に"],["なり"],["、"],["でこぼこ"],["道","みち"],["は"],["平ら","たいら"],["に"],["なる"],["。"]]},{"verse":6,"text":"こうして、あらゆる人が、神の救いを見るようになる。』」","tok":[["こう"],["して"],["、"],["あらゆる"],["人","ひと"],["が"],["、"],["神","かみ"],["の"],["救い","すくい"],["を"],["見る","みる"],["よう"],["に"],["なる"],["。"],["』"],["」"]]},{"verse":7,"text":"それで、ヨハネは、彼からバプテスマを受けようとして出て来た群衆に言った。「まむしのすえたち。だれが必ず来る御怒りをのがれるように教えたのか。","tok":[["それ"],["で"],["、"],["ヨハネ"],["は"],["、"],["彼","かれ"],["から"],["バプテスマ"],["を"],["受けよう","うけよう"],["として"],["出て","でて"],["来た","きた"],["群衆","ぐんしゅう"],["に"],["言った","いった"],["。"],["「"],["まむし"],["の"],["すえ"],["たち"],["。"],["だれ"],["が"],["必ず","かならず"],["来る","くる"],["御怒り","おいかり"],["を"],["のがれる"],["よう"],["に"],["教えた","おしえた"],["の"],["か"],["。"]]},{"verse":8,"text":"それならそれで、悔い改めにふさわしい実を結びなさい。『われわれの父はアブラハムだ』などと心の中で言い始めてはいけません。よく言っておくが、神は、こんな石ころからでも、アブラハムの子孫を起こすことがおできになるのです。","tok":[["それ"],["なら"],["それ"],["で"],["、"],["悔い改め","くいあらため"],["に"],["ふさわしい"],["実","じつ"],["を"],["結び","むすび"],["なさい"],["。"],["『"],["われわれ"],["の"],["父","ちち"],["は"],["アブラハム"],["だ"],["』"],["など"],["と"],["心","こころ"],["の"],["中","なか"],["で"],["言い","いい"],["始めて","はじめて"],["は"],["いけません"],["。"],["よく"],["言って","いって"],["おく"],["が"],["、"],["神","かみ"],["は"],["、"],["こんな"],["石ころ","いしころ"],["から"],["で"],["も"],["、"],["アブラハム"],["の"],["子孫","しそん"],["を"],["起こす","おこす"],["こと"],["が"],["おでき"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":9,"text":"斧もすでに木の根元に置かれています。だから、良い実を結ばない木は、みな切り倒されて、火に投げ込まれます。」","tok":[["斧","おの"],["も"],["すでに"],["木","き"],["の"],["根元","ねもと"],["に"],["置かれて","おかれて"],["います"],["。"],["だ"],["から"],["、"],["良い","よい"],["実","じつ"],["を"],["結ばない","むすばない"],["木","き"],["は"],["、"],["みな"],["切り倒されて","きりたおされて"],["、"],["火","ひ"],["に"],["投げ込まれます","なげこまれます"],["。"],["」"]]},{"verse":10,"text":"群衆はヨハネに尋ねた。「それでは、私たちはどうすればよいのでしょう。」","tok":[["群衆","ぐんしゅう"],["は"],["ヨハネ"],["に"],["尋ねた","たずねた"],["。"],["「"],["それ"],["で"],["は"],["、"],["私たち","わたしたち"],["は"],["どう"],["すれば"],["よい"],["の"],["でしょう"],["。"],["」"]]},{"verse":11,"text":"彼は答えて言った。「下着を二枚持っている者は、一つも持たない者に分けなさい。食べ物を持っている者も、そうしなさい。」","tok":[["彼","かれ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["下着","したぎ"],["を"],["二枚","にまい"],["持って","もって"],["いる"],["者","もの"],["は"],["、"],["一","ひと"],["つ"],["も"],["持たない","もたない"],["者","もの"],["に"],["分け","わけ"],["なさい"],["。"],["食べ物","たべもの"],["を"],["持って","もって"],["いる"],["者","もの"],["も"],["、"],["そう"],["し"],["なさい"],["。"],["」"]]},{"verse":12,"text":"取税人たちも、バプテスマを受けに出て来て、言った。「先生。私たちはどうすればよいのでしょう。」","tok":[["取","とり"],["税人","ぜいにん"],["たち"],["も"],["、"],["バプテスマ"],["を"],["受け","うけ"],["に"],["出て","でて"],["来て","きて"],["、"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["私たち","わたしたち"],["は"],["どう"],["すれば"],["よい"],["の"],["でしょう"],["。"],["」"]]},{"verse":13,"text":"ヨハネは彼らに言った。「決められたもの以上には、何も取り立ててはいけません。」","tok":[["ヨハネ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["決められた","きめられた"],["もの"],["以上","いじょう"],["に"],["は"],["、"],["何","なん"],["も"],["取り立てて","とりたてて"],["は"],["いけません"],["。"],["」"]]},{"verse":14,"text":"兵士たちも、彼に尋ねて言った。「私たちはどうすればよいのでしょうか。」ヨハネは言った。「だれからも、力ずくで金をゆすったり、無実の者を責めたりしてはいけません。自分の給料で満足しなさい。」","tok":[["兵士","へいし"],["たち"],["も"],["、"],["彼","かれ"],["に"],["尋ねて","たずねて"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["は"],["どう"],["すれば"],["よい"],["の"],["でしょう"],["か"],["。"],["」"],["ヨハネ"],["は"],["言った","いった"],["。"],["「"],["だれ"],["から"],["も"],["、"],["力","ちから"],["ずく"],["で"],["金","かね"],["を"],["ゆすっ"],["たり"],["、"],["無実","むじつ"],["の"],["者","もの"],["を"],["責め","せめ"],["たり"],["して"],["は"],["いけません"],["。"],["自分","じぶん"],["の"],["給料","きゅうりょう"],["で"],["満足","まんぞく"],["し"],["なさい"],["。"],["」"]]},{"verse":15,"text":"民衆は救い主を待ち望んでおり、みな心の中で、ヨハネについて、もしかするとこの方がキリストではあるまいか、と考えていたので、","tok":[["民衆","みんしゅう"],["は"],["救い主","すくいぬし"],["を"],["待ち望んで","まちのぞんで"],["おり"],["、"],["みな"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["ヨハネ"],["について"],["、"],["もし"],["か"],["する"],["と"],["この"],["方","ほう"],["が"],["キリスト"],["で"],["は"],["あるまい"],["か"],["、"],["と"],["考えて","かんがえて"],["いた"],["ので"],["、"]]},{"verse":16,"text":"ヨハネはみなに答えて言った。「私は水であなたがたにバプテスマを授けています。しかし、私よりもさらに力のある方がおいでになります。私などは、その方のくつのひもを解く値うちもありません。その方は、あなたがたに聖霊と火とのバプテスマをお授けになります。","tok":[["ヨハネ"],["は"],["みな"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["水","みず"],["で"],["あなた"],["がた"],["に"],["バプテスマ"],["を"],["授けて","さずけて"],["います"],["。"],["しかし"],["、"],["私","わたくし"],["より"],["も"],["さらに"],["力","ちから"],["の"],["ある"],["方","かた
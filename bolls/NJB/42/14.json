[{"verse":1,"text":"ある安息日に、食事をしようとして、パリサイ派のある指導者の家に入られたとき、みんながじっとイエスを見つめていた。","tok":[["ある"],["安息日","あんそくび"],["に"],["、"],["食事","しょくじ"],["を"],["しよう"],["として"],["、"],["パリサイ"],["派","は"],["の"],["ある"],["指導者","しどうしゃ"],["の"],["家","いえ"],["に"],["入られた","はいられた"],["とき"],["、"],["みんな"],["が"],["じっと"],["イエス"],["を"],["見つめて","みつめて"],["いた"],["。"]]},{"verse":2,"text":"そこには、イエスの真っ正面に、水腫をわずらっている人がいた。","tok":[["そこ"],["に"],["は"],["、"],["イエス"],["の"],["真っ","まっ"],["正面","しょうめん"],["に"],["、"],["水腫","すいしゅ"],["を"],["わずらって"],["いる"],["人","ひと"],["が"],["いた"],["。"]]},{"verse":3,"text":"イエスは、律法の専門家、パリサイ人たちに、「安息日に病気を直すことは正しいことですか、それともよくないことですか」と言われた。","tok":[["イエス"],["は"],["、"],["律法","りっぽう"],["の"],["専門家","せんもんか"],["、"],["パリサイ"],["人","にん"],["たち"],["に"],["、"],["「"],["安息日","あんそくび"],["に"],["病気","びょうき"],["を"],["直す","なおす"],["こと"],["は"],["正しい","ただしい"],["こと"],["です"],["か"],["、"],["それ"],["と"],["も"],["よく"],["ない"],["こと"],["です"],["か"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":4,"text":"しかし、彼らは黙っていた。それで、イエスはその人を抱いていやし、帰された。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["黙って","だまって"],["いた"],["。"],["それ"],["で"],["、"],["イエス"],["は"],["その"],["人","ひと"],["を"],["抱いて","いだいて"],["いやし"],["、"],["帰された","かえされた"],["。"]]},{"verse":5,"text":"それから、彼らに言われた。「自分の息子や牛が井戸に落ちたのに、安息日だからといって、すぐに引き上げてやらない者があなたがたのうちにいるでしょうか。」","tok":[["それ"],["から"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["自分","じぶん"],["の"],["息子","むすこ"],["や"],["牛","うし"],["が"],["井戸","いど"],["に"],["落ちた","おちた"],["のに"],["、"],["安息日","あんそくび"],["だ"],["から"],["と"],["いって"],["、"],["すぐ"],["に"],["引き上げて","ひきあげて"],["やらない"],["者","もの"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["いるでしょう"],["か"],["。"],["」"]]},{"verse":6,"text":"彼らは答えることができなかった。","tok":[["彼","かれ"],["ら"],["は"],["答える","こたえる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":7,"text":"招かれた人々が上座を選んでいる様子に気づいておられたイエスは、彼らにたとえを話された。","tok":[["招かれた","まねかれた"],["人々","ひとびと"],["が"],["上座","かみざ"],["を"],["選んで","えらんで"],["いる"],["様子","ようす"],["に"],["気づいて","きづいて"],["おられた"],["イエス"],["は"],["、"],["彼","かれ"],["ら"],["に"],["たとえ"],["を"],["話された","はなされた"],["。"]]},{"verse":8,"text":"「婚礼の披露宴に招かれたときには、上座にすわってはいけません。あなたより身分の高い人が、招かれているかもしれないし、","tok":[["「"],["婚礼","こんれい"],["の"],["披露宴","ひろうえん"],["に"],["招かれた","まねかれた"],["とき"],["に"],["は"],["、"],["上座","かみざ"],["に"],["すわって"],["は"],["いけません"],["。"],["あなた"],["より"],["身分","みぶん"],["の"],["高い","たかい"],["人","ひと"],["が"],["、"],["招かれて","まねかれて"],["いる"],["か"],["も"],["しれない"],["し"],["、"]]},{"verse":9,"text":"あなたやその人を招いた人が来て、『この人に席を譲ってください』とあなたに言うなら、そのときあなたは恥をかいて、末席に着かなければならないでしょう。","tok":[["あなた"],["や"],["その"],["人","ひと"],["を"],["招いた","まねいた"],["人","ひと"],["が"],["来て","きて"],["、"],["『"],["この"],["人","ひと"],["に"],["席","せき"],["を"],["譲って","ゆずって"],["ください"],["』"],["と"],["あなた"],["に"],["言うなら","ゆうなら"],["、"],["その"],["とき"],["あなた"],["は"],["恥","はじ"],["を"],["かいて"],["、"],["末席","まっせき"],["に"],["着かなければ","つかなければ"],["ならないでしょう"],["。"]]},{"verse":10,"text":"招かれるようなことがあって、行ったなら、末席に着きなさい。そうしたら、あなたを招いた人が来て、『どうぞもっと上席にお進みください』と言うでしょう。そのときは、満座の中で面目を施すことになります。","tok":[["招かれる","まねかれる"],["よう"],["な"],["こと"],["が"],["あって"],["、"],["行ったなら","いったなら"],["、"],["末席","まっせき"],["に"],["着き","つき"],["なさい"],["。"],["そう"],["したら"],["、"],["あなた"],["を"],["招いた","まねいた"],["人","ひと"],["が"],["来て","きて"],["、"],["『"],["どうぞ"],["もっと"],["上席","じょうせき"],["に"],["お進み","おすすみ"],["ください"],["』"],["と"],["言うでしょう","ゆうでしょう"],["。"],["その"],["とき"],["は"],["、"],["満座","まんざ"],["の"],["中","なか"],["で"],["面目","めんぼく"],["を"],["施す","ほどこす"],["こと"],["に"],["なります"],["。"]]},{"verse":11,"text":"なぜなら、だれでも自分を高くする者は低くされ、自分を低くする者は高くされるからです。」","tok":[["なぜ"],["なら"],["、"],["だれ"],["で"],["も"],["自分","じぶん"],["を"],["高く","たかく"],["する"],["者","もの"],["は"],["低く","ひくく"],["され"],["、"],["自分","じぶん"],["を"],["低く","ひくく"],["する"],["者","もの"],["は"],["高く","たかく"],["される"],["から"],["です"],["。"],["」"]]},{"verse":12,"text":"また、イエスは、自分を招いてくれた人にも、こう話された。「昼食や夕食のふるまいをするなら、友人、兄弟、親族、近所の金持ちなどを呼んではいけません。でないと、今度は彼らがあなたを招いて、お返しすることになるからです。","tok":[["また"],["、"],["イエス"],["は"],["、"],["自分","じぶん"],["を"],["招いて","まねいて"],["くれた"],["人","ひと"],["に"],["も"],["、"],["こう"],["話された","はなされた"],["。"],["「"],["昼食","ちゅうしょく"],["や"],["夕食","ゆうしょく"],["の"],["ふるまい"],["を"],["するなら"],["、"],["友人","ゆうじん"],["、"],["兄弟","きょうだい"],["、"],["親族","しんぞく"],["、"],["近所","きんじょ"],["の"],["金持ち","かねもち"],["など"],["を"],["呼んで","よんで"],["は"],["いけません"],["。"],["で"],["ない"],["と"],["、"],["今度","こんど"],["は"],["彼","かれ"],["ら"],["が"],["あなた"],["を"],["招いて","まねいて"],["、"],["お返し","おかえし"],["する"],["こと"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":13,"text":"祝宴を催す場合には、むしろ、貧しい者、からだの不自由な者、足のなえた者、盲人たちを招きなさい。","tok":[["祝宴","しゅくえん"],["を"],["催す","もよおす"],["場合","ばあい"],["に"],["は"],["、"],["むしろ"],["、"],["貧しい","まずしい"],["者","もの"],["、"],["からだ"],["の"],["不自由","ふじゆう"],["な"],["者","もの"],["、"],["足","あし"],["の"],["なえた"],["者","もの"],["、"],["盲人","もうじん"],["たち"],["を"],["招き","まねき"],["なさい"],["。"]]},{"verse":14,"text":"その人たちはお返しができないので、あなたは幸いです。義人の復活のときお返しを受けるからです。」","tok":[["その"],["人","ひと"],["たち"],["は"],["お返し","おかえし"],["が"],["できない"],["ので"],["、"],["あなた"],["は"],["幸い","さいわい"],["です"],["。"],["義人","ぎじん"],["の"],["復活","ふっかつ"],["の"],["とき"],["お返し","おかえし"],["を"],["受ける","うける"],["から"],["です"],["。"],["」"]]},{"verse":15,"text":"イエスといっしょに食卓に着いていた客のひとりはこれを聞いて、イエスに、「神の国で食事する人は、何と幸いなことでしょう」と言った。","tok":[["イエス"],["と"],["いっしょ"],["に"],["食卓","しょくたく"],["に"],["着いて","ついて"],["いた"],["客","きゃく"],["の"],["ひとり"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["イエス"],["に"],["、"],["「"],["神","かみ"],["の"],["国","くに"],["で"],["食事","しょくじ"],["する"],["人","ひと"],["は"],["、"],["何","なん"],["と"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":16,"text":"するとイエスはこう言われた。／「ある人が盛大な宴会を催し、大ぜいの人を招いた。","tok":[["する"],["と"],["イエス"],["は"],["こう"],["言われた","いわれた"],["。"],["／"],["「"],["ある"],["人","ひと"],["が"],["盛大","せいだい"],["な"],["宴会","えんかい"],["を"],["催し","もよおし"],["、"],["大ぜい","おおぜい"],["の"],["人","ひと"],["を"],["招いた","まねいた"],["。"]]},{"verse":17,"text":"宴会の時刻になったのでしもべをやり、招いておいた人々に、『さあ、おいでください。もうすっかり、用意ができましたから』と言わせた。","tok":[["宴会","えんかい"],["の"],["時刻","じこく"],["に"],["なった"],["ので"],["しもべ"],["を"],["やり"],["、"],["招いて","まねいて"],["おいた"],["人々","ひとびと"],["に"],["、"],["『"],["さあ"],["、"],["おいで"],["ください"],["。"],["もう"],["すっかり"],["、"],["用意","ようい"],["が"],["できました"],["から"],["』"],["と"],["言わせた","いわせた"],["。"]]},{"verse":18,"text":"ところが、みな同じように断り始めた。最初の人はこう言った。『畑を買ったので、どうしても見に出かけなければなりません。すみませんが、お断りさせていただきます。』","tok":[["ところ"],["が"],["、"],["みな"],["同じ","おなじ"],["よう"],["に"],["断り","ことわり"],["始めた","はじめた"],["。"],["最初","さいしょ"],["の"],["人","ひと"],["は"],["こう"],["言った","いった"],["。"],["『"],["畑","はたけ"],["を"],["買った","かった"],["ので"],["、"],["どう"],["して"],["も"],["見","み"],["に"],["出かけなければ","でかけなければ"],["なりません"],["。"],["すみません"],["が"],["、"],["お断りさせて","おことわりさせて"],["いただきます"],["。"],["』"]]},{"verse":19,"text":"もうひとりはこう言った。『五くびきの牛を買ったので、それをためしに行くところです。すみませんが、お断りさせていただきます。』","tok":[["もう"],["ひとり"],["は"],["こう"],["言った","いった"],["。"],["『"],["五","ご"],["くびき"],["の"],["牛","うし"],["を"],["買った","かった"],["ので"],["、"],["それ"],["を"],["ためし"],["に"],["行く","いく"],["ところ"],["です"],["。"],["すみません"],["が"],["、"],["お断りさせて","おことわりさせて"],["いただきます"],["。"],["』"]]},{"verse":20,"text":"また、別の人はこう言った。『結婚したので、行くことができません。』","tok":[["また"],["、"],["別","べつ"],["の"],["人","ひと"],["は"],["こう"],["言った","いった"],["。"],["『"],["結婚","けっこん"],["した"],["ので"],["、"],["行く","いく"],["こと"],["が"],["できません"],["。"],["』"]]},{"verse":21,"text":"しもべは帰って、このことを主人に報告した。すると、おこった主人は、そのしもべに言った。『急いで町の大通りや路地に出て行って、貧しい者や、からだの不自由な者や、盲人や、足のなえた者たちをここに連れて来なさい。』","tok":[["しもべ"],["は"],["帰って","かえって"],["、"],["この"],["こと"],["を"],["主人","しゅじん"],["に"],["報告","ほうこく"],["した"],["。"],["する"],["と"],["、"],["おこった"],["主人","しゅじん"],["は"],["、"],["その"],["しもべ"],["に"],["言った","いった"],["。"],["『"],["急いで","いそいで"],["町","まち"],["の"],["大通り","おおどおり"],["や"],["路地","ろじ"],["に"],["出て","でて"],["行って","いって"],["、"],["貧しい","まずしい"],["者","もの"],["や"],["、"],["からだ"],["の"],["不自由","ふじゆう"],["な"],["者","もの"],["や"],["、"],["盲人","もうじん"],["や"],["、"],["足","あし"],["の"],["なえた"],["者","もの"],["たち"],["を"],["ここ"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"],["』"]]},{"verse":22,"text":"しもべは言った。『ご主人さま。仰せのとおりにいたしました。でも、まだ席があります。』","tok":[["しもべ"],["は"],["言った","いった"],["。"],["『"],["ご主人","ごしゅじん"],["さま"],["。"],["仰せ","おおせ"],["の"],["とおり"],["に"],["いたしました"],["。"],["で"],["も"],["、"],["まだ"],["席","せき"],["が"],["あります"],["。"],["』"]]},{"verse":23,"text":"主人は言った。『街道や垣根のところに出かけて行って、この家がいっぱいになるように、無理にでも人々を連れて来なさい。","tok":[["主人","しゅじん"],["は"],["言った","いった"],["。"],["『"],["街道","かいどう"],["や"],["垣根","かきね"],["の"],["ところ"],["に"],["出かけて","でかけて"],["行って","いって"],["、"],["この"],["家","いえ"],["が"],["いっぱい"],["に"],["なる"],["よう"],["に"],["、"],["無理","むり"],["に"],["で"],["も"],["人々","ひとびと"],["を"],["連れて","つれて"],["来","き"],["なさい"],["。"]]},{"verse":24,"text":"言っておくが、あの招待されていた人たちの中で、私の食事を味わう者は、ひとりもいないのです。』」","tok":[["言って","いって"],["おく"],["が"],["、"],["あの"],["招待","しょうたい"],["されて"],["いた"],["人","ひと"],["たち"],["の"],["中","なか"],["で"],["、"],["私","わたくし"],["の"],["食事","しょくじ"],["を"],["味わう","あじわう"],["者","もの"],["は"],["、"],["ひとり"],["も"],["いない"],["の"],["です"],["。"],["』"],["」"]]},{"verse":25,"text":"さて、大ぜいの群衆が、イエスといっしょに歩いていたが、イエスは彼らのほうに向いて言われた。","tok":[["さて"],["、"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["、"],["イエス"],["と"],["いっしょ"],["に"],["歩いて","あるいて"],["いた"],["が"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["ほう"],["に"],["向いて","むいて"],["言われた","いわれた"],["。"]]},{"verse":26,"text":"「わたしのもとに来て、自分の父、母、妻、子、兄弟、姉妹、そのうえ自分のいのちまでも憎まない者は、わたしの弟子になることができません。","tok":[["「"],["わたし"],["の"],["もと"],["に"],["来て","きて"],["、"],["自分","じぶん"],["の"],["父","ちち"],["、"],["母","はは"],["、"],["妻","つま"],["、"],["子","こ"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["、"],["その"],["うえ"],["自分","じぶん"],["の"],["いのち"],["まで"],["も"],["憎まない","にくまない"],["者","もの"],["は"],["、"],["わたし"],["の"],["弟子","でし"],["に"],["なる"],["こと"],["が"],["できません"],["。"]]},{"verse":27,"text":"自分の十字架を負ってわたしについて来ない者は、わたしの弟子になることはできません。","tok":[["自分","じぶん"],["の"],["十字架","じゅうじか"],["を"],["負って","おって"],["わたし"],["について"],["来ない","こない"],["者","もの"],["は"],["、"],["わたし"],["の"],["弟子","でし"],["に"],["なる"],["こと"],["は"],["できません"],["。"]]},{"verse":28,"text":"塔を築こうとするとき、まずすわって、完成に十分な金があるかどうか、その費用を計算しない者が、あなたがたのうちにひとりでもあるでしょうか。","tok":[["塔","とう"],["を"],["築こう","きずこう"],["と"],["する"],["とき"],["、"],["まず"],["すわって"],["、"],["完成","かんせい"],["に"],["十分","じゅうぶん"],["な"],["金","かね"],["が"],["ある"],["か"],["どう"],["か"],["、"],["その"],["費用","ひよう"],["を"],["計算","けいさん"],["しない"],["者","もの"],["が"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["ひとり"],["で"],["も"],["あるでしょう"],["か"],["。"]]},{"verse":29,"text":"基礎を築いただけで完成できなかったら、見ていた人はみな彼をあざ笑って、","tok":[["基礎","きそ"],["を"],["築いた","きずいた"],["だけ"],["で"],["完成","かんせい"],["できなかったら"],["、"],["見て","みて"],["いた"],["人","ひと"],["は"],["みな"],["彼","かれ"],["を"],["あざ笑って","あざわらって"],["、"]]},{"verse":30,"text":"『この人は、建て始めはしたものの、完成できなかった』と言うでしょう。","tok":[["『"],["この"],["人","ひと"],["は"],["、"],["建て","たて"],["始め","はじめ"],["はしたもの"],["の"],["、"],["完成","かんせい"],["できなかった"],["』"],["と"],["言うでしょう","ゆうでしょう"],["。"]]},{"verse":31,"text":"また、どんな王でも、ほかの王と戦いを交えようとするときは、二万人を引き連れて向かって来る敵を、一万人で迎え撃つことができるかどうかを、まずすわって、考えずにいられましょうか。","tok":[["また"],["、"],["どんな"],["王","おう"],["で"],["も"],["、"],["ほか"],["の"],["王","おう"],["と"],["戦い","たたかい"],["を"],["交えよう","まじえよう"],["と"],["する"],["とき"],["は"],["、"],["二万人","にまんにん"],["を"],["引き連れて","ひきつれて"],["向かって","むかって"],["来る","くる"],["敵","てき"],["を"],["、"],["一万人","いちまんにん"],["で"],["迎え撃つ","むかえうつ"],["こと"],["が"],["できる"],["か"],["どう"],["か"],["を"],["、"],["まず"],["すわって"],["、"],["考えず","かんがえず"],["に"],["いられましょう"],["か"],["。"]]},{"verse":32,"text":"もし見込みがなければ、敵がまだ遠くに離れている間に、使者を送って講和を求めるでしょう。","tok":[["もし"],["見込み","みこみ"],["が"],["なければ"],["、"],["敵","てき"],["が"],["まだ"],["遠く","とおく"],["に"],["離れて","はなれて"],["いる"],["間","あいだ"],["に"],["、"],["使者","ししゃ"],["を"],["送って","おくって"],["講和","こうわ"],["を"],["求めるでしょう","もとめるでしょう"],["。"]]},{"verse":33,"text":"そういうわけで、あなたがたはだれでも、自分の財産全部を捨てないでは、わたしの弟子になることはできません。","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["あなた"],["がた"],["は"],["だれ"],["で"],["も"],["、"],["自分","じぶん"],["の"],["財産","ざいさん"],["全部","ぜんぶ"],["を"],["捨てないで","すてないで"],["は"],["、"],["わたし"],["の"],["弟子","でし"],["に"],["なる"],["こと"],["は"],["できません"],["。"]]},{"verse":34,"text":"ですから、塩は良いものですが、もしその塩が塩けをなくしたら、何によってそれに味をつけるのでしょうか。","tok":[["です"],["から"],["、"],["塩","しお"],["は"],["良い","よい"],["もの"],["です"],["が"],["、"],["もし"],["その"],["塩","しお"],["が"],["塩け","しおけ"],["を"],["なくしたら"],["、"],["何","なん"],["によって"],["それ"],["に"],["味","あじ"],["を"],["つける"],["の"],["でしょう"],["か"],["。"]]},{"verse":35,"text":"土地にも肥やしにも役立たず、外に投げ捨てられてしまいます。聞く耳のある人は聞きなさい。」","tok":[["土地","とち"],["に"],["も"],["肥やし","こやし"],["に"],["も"],["役立たず","やくだたず"],["、"],["外","そと"],["に"],["投げ捨てられて","なげすてられて"],["しまいます"],["。"],["聞く","きく"],["耳","みみ"],["の"],["ある"],["人","ひと"],["は"],["聞き","きき"],["なさい"],["。"],["」"]]}]
[{"verse":1,"text":"さて、イエスはある所で祈っておられた。その祈りが終わると、弟子のひとりが、イエスに言った。「主よ。ヨハネが弟子たちに教えたように、私たちにも祈りを教えてください。」","tok":[["さて"],["、"],["イエス"],["は"],["ある"],["所","ところ"],["で"],["祈って","いのって"],["おられた"],["。"],["その"],["祈り","いのり"],["が"],["終わる","おわる"],["と"],["、"],["弟子","でし"],["の"],["ひとり"],["が"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["ヨハネ"],["が"],["弟子","でし"],["たち"],["に"],["教えた","おしえた"],["よう"],["に"],["、"],["私たち","わたしたち"],["に"],["も"],["祈り","いのり"],["を"],["教えて","おしえて"],["ください"],["。"],["」"]]},{"verse":2,"text":"そこでイエスは、彼らに言われた。「祈るときには、こう言いなさい。／『父よ。御名があがめられますように。／御国が来ますように。","tok":[["そこ"],["で"],["イエス"],["は"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["祈る","いのる"],["とき"],["に"],["は"],["、"],["こう"],["言い","いい"],["なさい"],["。"],["／"],["『"],["父","ちち"],["よ"],["。"],["御名","ぎょめい"],["が"],["あがめられます"],["よう"],["に"],["。"],["／"],["御国","みくに"],["が"],["来ます","きます"],["よう"],["に"],["。"]]},{"verse":3,"text":"私たちの日ごとの糧を毎日お与えください。","tok":[["私たち","わたしたち"],["の"],["日ごと","ひごと"],["の"],["糧","かて"],["を"],["毎日","まいにち"],["お与え","おあたえ"],["ください"],["。"]]},{"verse":4,"text":"私たちの罪をお赦しください。私たちも私たちに負いめのある者をみな赦します。／私たちを試みに会わせないでください。』」","tok":[["私たち","わたしたち"],["の"],["罪","つみ"],["を"],["お赦し","おゆるし"],["ください"],["。"],["私たち","わたしたち"],["も"],["私たち","わたしたち"],["に"],["負い","おい"],["め"],["の"],["ある"],["者","もの"],["を"],["みな"],["赦します","ゆるします"],["。"],["／"],["私たち","わたしたち"],["を"],["試み","こころみ"],["に"],["会わせないで","あわせないで"],["ください"],["。"],["』"],["」"]]},{"verse":5,"text":"また、イエスはこう言われた。「あなたがたのうち、だれかに友だちがいるとして、真夜中にその人のところに行き、『君。パンを三つ貸してくれ。","tok":[["また"],["、"],["イエス"],["は"],["こう"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["の"],["うち"],["、"],["だれ"],["か"],["に"],["友だち","ともだち"],["が"],["いる"],["として"],["、"],["真夜中","まよなか"],["に"],["その"],["人","ひと"],["の"],["ところ"],["に"],["行き","いき"],["、"],["『"],["君","きみ"],["。"],["パン"],["を"],["三","みっ"],["つ"],["貸して","かして"],["くれ"],["。"]]},{"verse":6,"text":"友人が旅の途中、私のうちへ来たのだが、出してやるものがないのだ』と言ったとします。","tok":[["友人","ゆうじん"],["が"],["旅","たび"],["の"],["途中","とちゅう"],["、"],["私","わたくし"],["の"],["うち"],["へ"],["来た","きた"],["の"],["だ"],["が"],["、"],["出して","だして"],["やる"],["もの"],["が"],["ない"],["の"],["だ"],["』"],["と"],["言った","いった"],["と"],["します"],["。"]]},{"verse":7,"text":"すると、彼は家の中からこう答えます。『めんどうをかけないでくれ。もう戸締まりもしてしまったし、子どもたちも私も寝ている。起きて、何かをやることはできない。』","tok":[["する"],["と"],["、"],["彼","かれ"],["は"],["家","いえ"],["の"],["中","なか"],["から"],["こう"],["答えます","こたえます"],["。"],["『"],["めんどう"],["を"],["かけないで"],["くれ"],["。"],["もう"],["戸締まり","とじまり"],["も"],["して"],["しまった"],["し"],["、"],["子ども","こども"],["たち"],["も"],["私","わたくし"],["も"],["寝て","ねて"],["いる"],["。"],["起きて","おきて"],["、"],["何","なん"],["か"],["を"],["やる"],["こと"],["は"],["できない"],["。"],["』"]]},{"verse":8,"text":"あなたがたに言いますが、彼は友だちだからということで起きて何かを与えることはしないにしても、あくまで頼み続けるなら、そのためには起き上がって、必要な物を与えるでしょう。","tok":[["あなた"],["がた"],["に"],["言います","いいます"],["が"],["、"],["彼","かれ"],["は"],["友だち","ともだち"],["だ"],["から"],["と"],["いう"],["こと"],["で"],["起きて","おきて"],["何","なん"],["か"],["を"],["与える","あたえる"],["こと"],["は"],["しない"],["に"],["して"],["も"],["、"],["あくまで"],["頼み","たのみ"],["続けるなら","つづけるなら"],["、"],["その"],["ため"],["に"],["は"],["起き上がって","おきあがって"],["、"],["必要","ひつよう"],["な"],["物","もの"],["を"],["与えるでしょう","あたえるでしょう"],["。"]]},{"verse":9,"text":"わたしは、あなたがたに言います。求めなさい。そうすれば与えられます。捜しなさい。そうすれば見つかります。たたきなさい。そうすれば開かれます。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["に"],["言います","いいます"],["。"],["求め","もとめ"],["なさい"],["。"],["そう"],["すれば"],["与えられます","あたえられます"],["。"],["捜し","さがし"],["なさい"],["。"],["そう"],["すれば"],["見つかります","みつかります"],["。"],["たたき"],["なさい"],["。"],["そう"],["すれば"],["開かれます","ひらかれます"],["。"]]},{"verse":10,"text":"だれであっても、求める者は受け、捜す者は見つけ出し、たたく者には開かれます。","tok":[["だれ"],["で"],["あって"],["も"],["、"],["求める","もとめる"],["者","もの"],["は"],["受け","うけ"],["、"],["捜す","さがす"],["者","もの"],["は"],["見つけ","みつけ"],["出し","だし"],["、"],["たたく"],["者","もの"],["に"],["は"],["開かれます","ひらかれます"],["。"]]},{"verse":11,"text":"あなたがたの中で、子どもが魚を下さいと言うときに、魚の代わりに蛇を与えるような父親が、いったいいるでしょうか。","tok":[["あなた"],["がた"],["の"],["中","なか"],["で"],["、"],["子ども","こども"],["が"],["魚","さかな"],["を"],["下さい","ください"],["と"],["言う","いう"],["とき"],["に"],["、"],["魚","さかな"],["の"],["代わり","かわり"],["に"],["蛇","へび"],["を"],["与える","あたえる"],["よう"],["な"],["父親","ちちおや"],["が"],["、"],["いったい"],["いるでしょう"],["か"],["。"]]},{"verse":12,"text":"卵を下さいと言うのに、だれが、さそりを与えるでしょう。","tok":[["卵","たまご"],["を"],["下さい","ください"],["と"],["言う","いう"],["のに"],["、"],["だれ"],["が"],["、"],["さそり"],["を"],["与えるでしょう","あたえるでしょう"],["。"]]},{"verse":13,"text":"してみると、あなたがたも、悪い者ではあっても、自分の子どもには良い物を与えることを知っているのです。とすれば、なおのこと、天の父が、求める人たちに、どうして聖霊を下さらないことがありましょう。」","tok":[["して"],["みる"],["と"],["、"],["あなた"],["がた"],["も"],["、"],["悪い","わるい"],["者","もの"],["で"],["は"],["あって"],["も"],["、"],["自分","じぶん"],["の"],["子ども","こども"],["に"],["は"],["良い","よい"],["物","もの"],["を"],["与える","あたえる"],["こと"],["を"],["知って","しって"],["いる"],["の"],["です"],["。"],["と"],["すれば"],["、"],["なお"],["の"],["こと"],["、"],["天","てん"],["の"],["父","ちち"],["が"],["、"],["求める","もとめる"],["人","ひと"],["たち"],["に"],["、"],["どう"],["して"],["聖霊","せいれい"],["を"],["下さらない","くださらない"],["こと"],["が"],["ありましょう"],["。"],["」"]]},{"verse":14,"text":"イエスは悪霊、それも口をきけなくする悪霊を追い出しておられた。悪霊が出て行くと、口がきけなかった者がものを言い始めたので、群衆は驚いた。","tok":[["イエス"],["は"],["悪霊","あくりょう"],["、"],["それ"],["も"],["口","くち"],["を"],["きけなく"],["する"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["おられた"],["。"],["悪霊","あくりょう"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["口","くち"],["が"],["きけなかった"],["者","もの"],["が"],["もの"],["を"],["言い","いい"],["始めた","はじめた"],["ので"],["、"],["群衆","ぐんしゅう"],["は"],["驚いた","おどろいた"],["。"]]},{"verse":15,"text":"しかし、彼らのうちには、「悪霊どものかしらベルゼブルによって、悪霊どもを追い出しているのだ」と言う者もいた。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["は"],["、"],["「"],["悪霊","あくりょう"],["ども"],["の"],["かしら"],["ベルゼブル"],["によって"],["、"],["悪霊","あくりょう"],["ども"],["を"],["追い出して","おいだして"],["いる"],["の"],["だ"],["」"],["と"],["言う","いう"],["者","もの"],["も"],["いた"],["。"]]},{"verse":16,"text":"また、イエスをためそうとして、彼に天からのしるしを求める者もいた。","tok":[["また"],["、"],["イエス"],["を"],["ためそう"],["として"],["、"],["彼","かれ"],["に"],["天","てん"],["から"],["の"],["しるし"],["を"],["求める","もとめる"],["者","もの"],["も"],["いた"],["。"]]},{"verse":17,"text":"しかし、イエスは、彼らの心を見抜いて言われた。「どんな国でも、内輪もめしたら荒れすたれ、家にしても、内輪で争えばつぶれます。","tok":[["しかし"],["、"],["イエス"],["は"],["、"],["彼","かれ"],["ら"],["の"],["心","こ
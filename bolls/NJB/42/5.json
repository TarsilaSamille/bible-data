[{"verse":1,"text":"群衆がイエスに押し迫るようにして神のことばを聞いたとき、イエスはゲネサレ湖の岸べに立っておられたが、","tok":[["群衆","ぐんしゅう"],["が"],["イエス"],["に"],["押し迫る","おしせまる"],["よう"],["に"],["して"],["神","かみ"],["の"],["ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["イエス"],["は"],["ゲネサレ"],["湖","こ"],["の"],["岸べ","きしべ"],["に"],["立って","たって"],["おられた"],["が"],["、"]]},{"verse":2,"text":"岸べに小舟が二そうあるのをご覧になった。漁師たちは、その舟から降りて網を洗っていた。","tok":[["岸べ","きしべ"],["に"],["小舟","こぶね"],["が"],["二","に"],["そう"],["ある"],["の"],["を"],["ご覧","ごらん"],["に"],["なった"],["。"],["漁師","りょうし"],["たち"],["は"],["、"],["その"],["舟","ふね"],["から"],["降りて","おりて"],["網","あみ"],["を"],["洗って","あらって"],["いた"],["。"]]},{"verse":3,"text":"イエスは、そのうちの一つの、シモンの持ち舟に乗り、陸から少し漕ぎ出すように頼まれた。そしてイエスはすわって、舟から群衆を教えられた。","tok":[["イエス"],["は"],["、"],["その"],["うち"],["の"],["一","ひと"],["つ"],["の"],["、"],["シモン"],["の"],["持ち","もち"],["舟","ふね"],["に"],["乗り","のり"],["、"],["陸","りく"],["から"],["少し","すこし"],["漕ぎ出す","こぎだす"],["よう"],["に"],["頼まれた","たのまれた"],["。"],["そして"],["イエス"],["は"],["すわって"],["、"],["舟","ふね"],["から"],["群衆","ぐんしゅう"],["を"],["教えられた","おしえられた"],["。"]]},{"verse":4,"text":"話が終わると、シモンに、「深みに漕ぎ出して、網をおろして魚をとりなさい」と言われた。","tok":[["話","はなし"],["が"],["終わる","おわる"],["と"],["、"],["シモン"],["に"],["、"],["「"],["深み","ふかみ"],["に"],["漕ぎ","こぎ"],["出して","だして"],["、"],["網","あみ"],["を"],["おろして"],["魚","さかな"],["を"],["とり"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":5,"text":"するとシモンが答えて言った。「先生。私たちは、夜通し働きましたが、何一つとれませんでした。でもおことばどおり、網をおろしてみましょう。」","tok":[["する"],["と"],["シモン"],["が"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["私たち","わたしたち"],["は"],["、"],["夜通し","よどおし"],["働きました","はたらきました"],["が"],["、"],["何","なん"],["一","ひと"],["つ"],["とれませんでした"],["。"],["で"],["も"],["おことば"],["どおり"],["、"],["網","あみ"],["を"],["おろして"],["みましょう"],["。"],["」"]]},{"verse":6,"text":"そして、そのとおりにすると、たくさんの魚が入り、網は破れそうになった。","tok":[["そして"],["、"],["その"],["とおり"],["に"],["する"],["と"],["、"],["たくさん"],["の"],["魚","さかな"],["が"],["入り","はいり"],["、"],["網","あみ"],["は"],["破れ","やぶれ"],["そう"],["に"],["なった"],["。"]]},{"verse":7,"text":"そこで別の舟にいた仲間の者たちに合図をして、助けに来てくれるように頼んだ。彼らがやって来て、そして魚を両方の舟いっぱいに上げたところ、二そうとも沈みそうになった。","tok":[["そこ"],["で"],["別","べつ"],["の"],["舟","ふね"],["に"],["いた"],["仲間","なかま"],["の"],["者","もの"],["たち"],["に"],["合図","あいず"],["を"],["して"],["、"],["助け","たすけ"],["に"],["来て","きて"],["くれる"],["よう"],["に"],["頼んだ","たのんだ"],["。"],["彼","かれ"],["ら"],["が"],["やって"],["来て","きて"],["、"],["そして"],["魚","さかな"],["を"],["両方","りょうほう"],["の"],["舟","ふね"],["いっぱい"],["に"],["上げた","あげた"],["ところ"],["、"],["二","に"],["そう"],["と"],["も"],["沈み","しずみ"],["そう"],["に"],["なった"],["。"]]},{"verse":8,"text":"これを見たシモン・ペテロは、イエスの足もとにひれ伏して、「主よ。私のような者から離れてください。私は、罪深い人間ですから」と言った。","tok":[["これ"],["を"],["見た","みた"],["シモン"],["・"],["ペテロ"],["は"],["、"],["イエス"],["の"],["足もと","あしもと"],["に"],["ひれ伏して","ひれふして"],["、"],["「"],["主","ぬし"],["よ"],["。"],["私","わたくし"],["の"],["よう"],["な"],["者","もの"],["から"],["離れて","はなれて"],["ください"],["。"],["私","わたくし"],["は"],["、"],["罪深い","つみぶかい"],["人間","にんげん"],["です"],["から"],["」"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"それは、大漁のため、彼もいっしょにいたみなの者も、ひどく驚いたからである。","tok":[["それ"],["は"],["、"],["大漁","たいりょう"],["の"],["ため"],["、"],["彼","かれ"],["も"],["いっしょ"],["に"],["いた"],["みな"],["の"],["者","もの"],["も"],["、"],["ひどく"],["驚いた","おどろいた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"シモンの仲間であったゼベダイの子ヤコブやヨハネも同じであった。イエスはシモンにこう言われた。「こわがらなくてもよい。これから後、あなたは人間をとるようになるのです。」","tok":[["シモン"],["の"],["仲間","なかま"],["で"],["あった"],["ゼベダイ"],["の"],["子","こ"],["ヤコブ"],["や"],["ヨハネ"],["も"],["同じ","おなじ"],["で"],["あった"],["。"],["イエス"],["は"],["シモン"],["に"],["こう"],["言われた","いわれた"],["。"],["「"],["こわ"],["がら"],["なくて"],["も"],["よい"],["。"],["これ"],["から"],["後","あと"],["、"],["あなた"],["は"],["人間","にんげん"],["を"],["とる"],["よう"],["に"],["なる"],["の"],["です"],["。"],["」"]]},{"verse":11,"text":"彼らは、舟を陸に着けると、何もかも捨てて、イエスに従った。","tok":[["彼","かれ"],["ら"],["は"],["、"],["舟","ふね"],["を"],["陸","りく"],["に"],["着ける","つける"],["と"],["、"],["何","なん"],["も"],["か"],["も"],["捨てて","すてて"],["、"],["イエス"],["に"],["従った","したがった"],["。"]]},{"verse":12,"text":"さて、イエスがある町におられたとき、全身ツァラアトの人がいた。イエスを見ると、ひれ伏してお願いした。「主よ。お心一つで、私をきよくしていただけます。」","tok":[["さて"],["、"],["イエス"],["が"],["ある"],["町","まち"],["に"],["おられた"],["とき"],["、"],["全身","ぜんしん"],["ツァラアト"],["の"],["人","ひと"],["が"],["いた"],["。"],["イエス"],["を"],["見る","みる"],["と"],["、"],["ひれ伏して","ひれふして"],["お願い","おねがい"],["した"],["。"],["「"],["主","ぬし"],["よ"],["。"],["お心","おこころ"],["一","ひと"],["つ"],["で"],["、"],["私","わたくし"],["を"],["きよく"],["して"],["いただけます"],["。"],["」"]]},{"verse":13,"text":"イエスは手を伸ばして、彼にさわり、「わたしの心だ。きよくなれ」と言われた。すると、すぐに、そのツァラアトが消えた。","tok":[["イエス"],["は"],["手","て"],["を"],["伸ばして","のばして"],["、"],["彼","かれ"],["に"],["さわり"],["、"],["「"],["わたし"],["の"],["心","こころ"],["だ"],["。"],["きよく"],["なれ"],["」"],["と"],["言われた","いわれた"],["。"],["する"],["と"],["、"],["すぐ"],["に"],["、"],["その"],["ツァラアト"],["が"],["消えた","きえた"],["。"]]},{"verse":14,"text":"イエスは、彼にこう命じられた。「だれにも話してはいけない。ただ祭司のところに行って、自分を見せなさい。そして人々へのあかしのため、モーセが命じたように、あなたのきよめの供え物をしなさい。」","tok":[["イエス"],["は"],["、"],["彼","かれ"],["に"],["こう"],["命じられた","めいじられた"],["。"],["「"],["だれ"],["に"],["も"],["話して","はなして"],["は"],["いけない"],["。"],["ただ"],["祭司","さいし"],["の"],["ところ"],["に"],["行って","いって"],["、"],["自分","じぶん"],["を"],["見せ","みせ"],["なさい"],["。"],["そして"],["人々","ひとびと"],["へ"],["の"],["あかし"],["の"],["ため"],["、"],["モーセ"],["が"],["命じた","めいじた"],["よう"],["に"],["、"],["あなた"],["の"],["きよめ"],["の"],["供え物","そなえもの"],["を"],["し"],["なさい"],["。"],["」"]]},{"verse":15,"text":"しかし、イエスのうわさは、ますます広まり、多くの人の群れが、話を聞きに、また、病気を直してもらいに集まって来た。","tok":[["しかし"],["、"],["イエス"],["の"],["うわさ"],["は"],["、"],["ますます"],["広まり","ひろまり"],["、"],["多く","おおく"],["の"],["人","ひと"],["の"],["群れ","むれ"],["が"],["、"],["話","はなし"],["を"],["聞き","きき"],["に"],["、"],["また"],["、"],["病気","びょうき"],["を"],["直して","なおして"],["もらい"],["に"],["集まって","あつまって"],["来た","きた"],["。"]]},{"verse":16,"text":"しかし、イエスご自身は、よく荒野に退いて祈っておられた。","tok":[["しかし"],["、"],["イエス"],["ご自身","ごじしん"],["は"],["、"],["よく"],["荒野","あらの"],["に"],["退いて","しりぞいて"],["祈って","いのって"],["おられた"],["。"]]},{"verse":17,"text":"ある日のこと、イエスが教えておられると、パリサイ人と律法の教師たちも、そこにすわっていた。彼らは、ガリラヤとユダヤとのすべての村々や、エルサレムから来ていた。イエスは、主の御力をもって、病気を直しておられた。","tok":[["ある"],["日","ひ"],["の"],["こと"],["、"],["イエス"],["が"],["教えて","おしえて"],["おられる"],["と"],["、"],["パリサイ"],["人","にん"],["と"],["律法","りっぽう"],["の"],["教師","きょうし"],["たち"],["も"],["、"],["そこ"],["に"],["すわって"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["ガリラヤ"],["と"],["ユダヤ"],["と"],["の"],["すべて"],["の"],["村々","むらむら"],["や"],["、"],["エルサレム"],["から"],["来て","きて"],["いた"],["。"],["イエス"],["は"],["、"],["主","ぬし"],["の"],["御力","おちから"],["を"],["もって"],["、"],["病気","びょうき"],["を"],["直して","なおして"],["おられた"],["。"]]},{"verse":18,"text":"するとそこに、男たちが、中風をわずらっている人を、床のままで運んで来た。そして、何とかして家の中に運び込み、イエスの前に置こうとしていた。","tok":[["する"],["と"],["そこ"],["に"],["、"],["男","おとこ"],["たち"],["が"],["、"],["中風","ちゅうぶ"],["を"],["わずらって"],["いる"],["人","ひと"],["を"],["、"],["床","ゆか"],["の"],["まま"],["で"],["運んで","はこんで"],["来た","きた"],["。"],["そして"],["、"],["何","なん"],["と"],["か"],["して"],["家","いえ"],["の"],["中","なか"],["に"],["運び込み","はこびこみ"],["、"],["イエス"],["の"],["前","まえ"],["に"],["置こう","おこう"],["として"],["いた"],["。"]]},{"verse":19,"text":"しかし、大ぜい人がいて、どうにも病人を運び込む方法が見つからないので、屋上に上って屋根の瓦をはがし、そこから彼の寝床を、ちょうど人々の真ん中のイエスの前に、つり降ろした。","tok":[["しかし"],["、"],["大ぜい人","おおぜいにん"],["が"],["いて"],["、"],["どう"],["に"],["も"],["病人","びょうにん"],["を"],["運び込む","はこびこむ"],["方法","ほうほう"],["が"],["見つからない","みつからない"],["ので"],["、"],["屋上","おくじょう"],["に"],["上って","のぼって"],["屋根","やね"],["の"],["瓦","かわら"],["を"],["はがし"],["、"],["そこ"],["から"],["彼","かれ"],["の"],["寝床","ねどこ"],["を"],["、"],["ちょうど"],["人々","ひとびと"],["の"],["真ん中","まんなか"],["の"],["イエス"],["の"],["前","まえ"],["に"],["、"],["つり"],["降ろした","おろした"],["。"]]},{"verse":20,"text":"彼らの信仰を見て、イエスは「友よ。あなたの罪は赦されました」と言われた。","tok":[["彼","かれ"],["ら"],["の"],["信仰","しんこう"],["を"],["見て","みて"],["、"],["イエス"],["は"],["「"],["友","とも"],["よ"],["。"],["あなた"],["の"],["罪","つみ"],["は"],["赦されました","ゆるされました"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":21,"text":"ところが、律法学者、パリサイ人たちは、理屈を言い始めた。「神をけがすことを言うこの人は、いったい何者だ。神のほかに、だれが罪を赦すことができよう。」","tok":[["ところ"],["が"],["、"],["律法学者","りっぽうがくしゃ"],["、"],["パリサイ"],["人","にん"],["たち"],["は"],["、"],["理屈","りくつ"],["を"],["言い","いい"],["始めた","はじめた"],["。"],["「"],["神","かみ"],["を"],["けがす"],["こと"],["を"],["言う","いう"],["この"],["人","ひと"],["は"],["、"],["いったい"],["何者","なにもの"],["だ"],["。"],["神","かみ"],["の"],["ほか"],["に"],["、"],["だれ"],["が"],["罪","つみ"],["を"],["赦す","ゆるす"],["こと"],["が"],["できよう"],["。"],["」"]]},{"verse":22,"text":"その理屈を見抜いておられたイエスは、彼らに言われた。「なぜ、心の中でそんな理屈を言っているのか。","tok":[["その"],["理屈","りくつ"],["を"],["見抜いて","みぬいて"],["おられた"],["イエス"],["は"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["なぜ"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["そんな"],["理屈","りくつ"],["を"],["言って","いって"],["いる"],["の"],["か"],["。"]]},{"verse":23,"text":"『あなたの罪は赦された』と言うのと、『起きて歩け』と言うのと、どちらがやさしいか。","tok":[["『"],["あなた"],["の"],["罪","つみ"],["は"],["赦された","ゆるされた"],["』"],["と"],["言う","いう"],["の"],["と"],["、"],["『"],["起きて","おきて"],["歩け","あるけ"],["』"],["と"],["言う","いう"],["の"],["と"],["、"],["どちら"],["が"],["やさしい"],["か"],["。"]]},{"verse":24,"text":"人の子が地上で罪を赦す権威を持っていることを、あなたがたに悟らせるために」と言って、中風の人に、「あなたに命じる。起きなさい。寝床をたたんで、家に帰りなさい」と言われた。","tok":[["人","ひと"],["の"],["子","こ"],["が"],["地上","ちじょう"],["で"],["罪","つみ"],["を"],["赦す","ゆるす"],["権威","けんい"],["を"],["持って","もって"],["いる"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["悟らせる","さとらせる"],["ため"],["に"],["」"],["と"],["言って","いって"],["、"],["中風","ちゅうぶ"],["の"],["人","ひと"],["に"],["、"],["「"],["あなた"],["に"],["命じる","めいじる"],["。"],["起き","おき"],["なさい"],["。"],["寝床","ねどこ"],["を"],["たたんで"],["、"],["家","いえ"],["に"],["帰り","かえり"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":25,"text":"すると彼は、たちどころに人々の前で立ち上がり、寝ていた床をたたんで、神をあがめながら自分の家に帰った。","tok":[["する"],["と"],["彼","かれ"],["は"],["、"],["たちどころ"],["に"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["立ち上がり","たちあがり"],["、"],["寝て","ねて"],["いた"],["床","ゆか"],["を"],["たたんで"],["、"],["神","かみ"],["を"],["あがめ"],["ながら"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰った","かえった"],["。"]]},{"verse":26,"text":"人々はみな、ひどく驚き、神をあがめ、恐れに満たされて、「私たちは、きょう、驚くべきことを見た」と言った。","tok":[["人々","ひとびと"],["は"],["みな"],["、"],["ひどく"],["驚き","おどろき"],["、"],["神","かみ"],["を"],["あがめ"],["、"],["恐れ","おそれ"],["に"],["満たされて","みたされて"],["、"],["「"],["私たち","わたしたち"],["は"],["、"],["きょう"],["、"],["驚くべき","おどろくべき"],["こと"],["を"],["見た","みた"],["」"],["と"],["言った","いった"],["。"]]},{"verse":27,"text":"この後、イエスは出て行き、収税所にすわっているレビという取税人に目を留めて、「わたしについて来なさい」と言われた。","tok":[["この"],["後","ご"],["、"],["イエス"],["は"],["出て","でて"],["行き","いき"],["、"],["収税所","しゅうぜいしょ"],["に"],["すわって"],["いる"],["レビ"],["と"],["いう"],["取","とり"],["税人","ぜいにん"],["に"],["目","め"],["を"],["留めて","とめて"],["、"],["「"],["わたし"],["について"],["来","き"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":28,"text":"するとレビは、何もかも捨て、立ち上がってイエスに従った。","tok":[["する"],["と"],["レビ"],["は"],["、"],["何","なん"],["も"],["か"],["も"],["捨て","すて"],["、"],["立ち上がって","たちあがって"],["イエス"],["に"],["従った","したがった"],["。"]]},{"verse":29,"text":"そこでレビは、自分の家でイエスのために大ぶるまいをしたが、取税人たちや、ほかに大ぜいの人たちが食卓に着いていた。","tok":[["そこ"],["で"],["レビ"],["は"],["、"],["自分","じぶん"],["の"],["家","いえ"],["で"],["イエス"],["の"],["ため"],["に"],["大","だい"],["ぶるまい"],["を"],["した"],["が"],["、"],["取","とり"],["税人","ぜいにん"],["たち"],["や"],["、"],["ほか"],["に"],["大ぜい","おおぜい"],["の"],["人","ひと"],["たち"],["が"],["食卓","しょくたく"],["に"],["着いて","ついて"],["いた"],["。"]]},{"verse":30,"text":"すると、パリサイ人やその派の律法学者たちが、イエスの弟子たちに向かって、つぶやいて言った。「なぜ、あなたがたは、取税人や罪人どもといっしょに飲み食いするのですか。」","tok":[["する"],["と"],["、"],["パリサイ"],["人","にん"],["や"],["その"],["派","は"],["の"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["、"],["イエス"],["の"],["弟子","でし"],["たち"],["に"],["向かって","むかって"],["、"],["つぶやいて"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["あなた"],["がた"],["は"],["、"],["取","とり"],["税人","ぜいにん"],["や"],["罪人","ざいにん"],["ども"],["と"],["いっしょ"],["に"],["飲み食い","のみくい"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":31,"text":"そこで、イエスは答えて言われた。「医者を必要とするのは丈夫な者ではなく、病人です。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["医者","いしゃ"],["を"],["必要","ひつよう"],["と"],["する"],["の"],["は"],["丈夫","じょうぶ"],["な"],["者","もの"],["で"],["は"],["なく"],["、"],["病人","びょうにん"],["です"],["。"]]},{"verse":32,"text":"わたしは正しい人を招くためではなく、罪人を招いて、悔い改めさせるために来たのです。」","tok":[["わたし"],["は"],["正しい","ただしい"],["人","ひと"],["を"],["招く","まねく"],["ため"],["で"],["は"],["なく"],["、"],["罪人","ざいにん"],["を"],["招いて","まねいて"],["、"],["悔い改め","くいあらため"],["させる"],["ため"],["に"],["来た","きた"],["の"],["です"],["。"],["」"]]},{"verse":33,"text":"彼らはイエスに言った。「ヨハネの弟子たちは、よく断食をしており、祈りもしています。また、パリサイ人の弟子たちも同じなのに、あなたの弟子たちは食べたり飲んだりしています。」","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["ヨハネ"],["の"],["弟子","でし"],["たち"],["は"],["、"],["よく"],["断食","だんじき"],["を"],["して"],["おり"],["、"],["祈り","いのり"],["も"],["して"],["います"],["。"],["また"],["、"],["パリサイ"],["人","にん"],["の"],["弟子","でし"],["たち"],["も"],["同じ","おなじ"],["な"],["のに"],["、"],["あなた"],["の"],["弟子","でし"],["たち"],["は"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["して"],["います"],["。"],["」"]]},{"verse":34,"text":"イエスは彼らに言われた。「花婿がいっしょにいるのに、花婿につき添う友だちに断食させることが、あなたがたにできますか。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["花婿","はなむこ"],["が"],["いっしょ"],["に"],["いる"],["のに"],["、"],["花婿","はなむこ"],["に"],["つき添う","つきそう"],["友だち","ともだち"],["に"],["断食","だんじき"],["させる"],["こと"],["が"],["、"],["あなた"],["がた"],["に"],["できます"],["か"],["。"]]},{"verse":35,"text":"しかし、やがてその時が来て、花婿が取り去られたら、その日には彼らは断食します。」","tok":[["しかし"],["、"],["やがて"],["その"],["時","とき"],["が"],["来て","きて"],["、"],["花婿","はなむこ"],["が"],["取り去られたら","とりさられたら"],["、"],["その"],["日","ひ"],["に"],["は"],["彼","かれ"],["ら"],["は"],["断食","だんじき"],["します"],["。"],["」"]]},{"verse":36,"text":"イエスはまた一つのたとえを彼らに話された。「だれも、新しい着物から布切れを引き裂いて、古い着物に継ぎをするようなことはしません。そんなことをすれば、その新しい着物を裂くことになるし、また新しいのを引き裂いた継ぎ切れも、古い物には合わないのです。","tok":[["イエス"],["は"],["また"],["一","ひと"],["つ"],["の"],["たとえ"],["を"],["彼","かれ"],["ら"],["に"],["話された","はなされた"],["。"],["「"],["だれ"],["も"],["、"],["新しい","あたらしい"],["着物","きもの"],["から"],["布切れ","ぬのきれ"],["を"],["引き裂いて","ひきさいて"],["、"],["古い","ふるい"],["着物","きもの"],["に"],["継ぎ","つぎ"],["を"],["する"],["よう"],["な"],["こと"],["は"],["しません"],["。"],["そんな"],["こと"],["を"],["すれば"],["、"],["その"],["新しい","あたらしい"],["着物","きもの"],["を"],["裂く","さく"],["こと"],["に"],["なる"],["し"],["、"],["また"],["新しい","あたらしい"],["の"],["を"],["引き裂いた","ひきさいた"],["継ぎ","つぎ"],["切れ","きれ"],["も"],["、"],["古い","ふるい"],["物","もの"],["に"],["は"],["合わない","あわない"],["の"],["です"],["。"]]},{"verse":37,"text":"また、だれも新しいぶどう酒を古い皮袋に入れるようなことはしません。そんなことをすれば、新しいぶどう酒は皮袋を張り裂き、ぶどう酒は流れ出て、皮袋もだめになってしまいます。","tok":[["また"],["、"],["だれ"],["も"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["を"],["古い","ふるい"],["皮袋","かわぶくろ"],["に"],["入れる","いれる"],["よう"],["な"],["こと"],["は"],["しません"],["。"],["そんな"],["こと"],["を"],["すれば"],["
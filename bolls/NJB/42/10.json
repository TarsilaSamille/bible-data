[{"verse":1,"text":"その後、主は、別に七十人を定め、ご自分が行くつもりのすべての町や村へ、ふたりずつ先にお遣わしになった。","tok":[["その"],["後","ご"],["、"],["主","ぬし"],["は"],["、"],["別","べつ"],["に"],["七","なな"],["十人","じゅうにん"],["を"],["定め","さだめ"],["、"],["ご自分","ごじぶん"],["が"],["行く","いく"],["つもり"],["の"],["すべて"],["の"],["町","まち"],["や"],["村","むら"],["へ"],["、"],["ふたり"],["ずつ"],["先","さき"],["に"],["お遣わし","おつかわし"],["に"],["なった"],["。"]]},{"verse":2,"text":"そして、彼らに言われた。「実りは多いが、働き手が少ない。だから、収穫の主に、収穫のために働き手を送ってくださるように祈りなさい。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["実り","みのり"],["は"],["多い","おおい"],["が"],["、"],["働き手","はたらきて"],["が"],["少ない","すくない"],["。"],["だ"],["から"],["、"],["収穫","しゅうかく"],["の"],["主","ぬし"],["に"],["、"],["収穫","しゅうかく"],["の"],["ため"],["に"],["働き手","はたらきて"],["を"],["送って","おくって"],["くださる"],["よう"],["に"],["祈り","いのり"],["なさい"],["。"]]},{"verse":3,"text":"さあ、行きなさい。いいですか。わたしがあなたがたを遣わすのは、狼の中に小羊を送り出すようなものです。","tok":[["さあ"],["、"],["行き","いき"],["なさい"],["。"],["いいです"],["か"],["。"],["わたし"],["が"],["あなた"],["がた"],["を"],["遣わす","つかわす"],["の"],["は"],["、"],["狼","おおかみ"],["の"],["中","なか"],["に"],["小羊","こひつじ"],["を"],["送り出す","おくりだす"],["よう"],["な"],["もの"],["です"],["。"]]},{"verse":4,"text":"財布も旅行袋も持たず、くつもはかずに行きなさい。だれにも、道であいさつしてはいけません。","tok":[["財布","さいふ"],["も"],["旅行","りょこう"],["袋","ふくろ"],["も"],["持たず","もたず"],["、"],["くつ"],["も"],["はかず"],["に"],["行き","いき"],["なさい"],["。"],["だれ"],["に"],["も"],["、"],["道","みち"],["で"],["あいさつ"],["して"],["は"],["いけません"],["。"]]},{"verse":5,"text":"どんな家に入っても、まず、『この家に平安があるように』と言いなさい。","tok":[["どんな"],["家","いえ"],["に"],["入って","はいって"],["も"],["、"],["まず"],["、"],["『"],["この"],["家","いえ"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":6,"text":"もしそこに平安の子がいたら、あなたがたの祈った平安は、その人の上にとどまります。だが、もしいないなら、その平安はあなたがたに返って来ます。","tok":[["もし"],["そこ"],["に"],["平安","へいあん"],["の"],["子","こ"],["が"],["いたら"],["、"],["あなた"],["がた"],["の"],["祈った","いのった"],["平安","へいあん"],["は"],["、"],["その"],["人","ひと"],["の"],["上","うえ"],["に"],["とどまります"],["。"],["だ"],["が"],["、"],["もし"],["いないなら"],["、"],["その"],["平安","へいあん"],["は"],["あなた"],["がた"],["に"],["返って","かえって"],["来ます","きます"],["。"]]},{"verse":7,"text":"その家に泊まっていて、出してくれる物を飲み食いしなさい。働く者が報酬を受けるのは、当然だからです。家から家へと渡り歩いてはいけません。","tok":[["その"],["家","いえ"],["に"],["泊まって","とまって"],["いて"],["、"],["出して","だして"],["くれる"],["物","もの"],["を"],["飲み食い","のみくい"],["し"],["なさい"],["。"],["働く","はたらく"],["者","もの"],["が"],["報酬","ほうしゅう"],["を"],["受ける","うける"],["の"],["は"],["、"],["当然","とうぜん"],["だ"],["から"],["です"],["。"],["家","いえ"],["から"],["家","いえ"],["へ"],["と"],["渡り歩いて","わたりあるいて"],["は"],["いけません"],["。"]]},{"verse":8,"text":"どの町に入っても、あなたがたを受け入れてくれたら、出される物を食べなさい。","tok":[["どの"],["町","まち"],["に"],["入って","はいって"],["も"],["、"],["あなた"],["がた"],["を"],["受け入れて","うけいれて"],["くれたら"],["、"],["出される","だされる"],["物","もの"],["を"],["食べ","たべ"],["なさい"],["。"]]},{"verse":9,"text":"そして、その町の病人を直し、彼らに、『神の国が、あなたがたに近づいた』と言いなさい。","tok":[["そして"],["、"],["その"],["町","まち"],["の"],["病人","びょうにん"],["を"],["直し","なおし"],["、"],["彼","かれ"],["ら"],["に"],["、"],["『"],["神","かみ"],["の"],["国","くに"],["が"],["、"],["あなた"],["がた"],["に"],["近づいた","ちかづいた"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":10,"text":"しかし、町に入っても、人々があなたがたを受け入れないならば、大通りに出て、こう言いなさい。","tok":[["しかし"],["、"],["町","まち"],["に"],["入って","はいって"],["も"],["、"],["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["受け入れないならば","うけいれないならば"],["、"],["大通り","おおどおり"],["に"],["出て","でて"],["、"],["こう"],["言い","いい"],["なさい"],["。"]]},{"verse":11,"text":"『私たちは足についたこの町のちりも、あなたがたにぬぐい捨てて行きます。しかし、神の国が近づいたことは承知していなさい。』","tok":[["『"],["私たち","わたしたち"],["は"],["足","あし"],["に"],["ついた"],["この"],["町","まち"],["の"],["ちり"],["も"],["、"],["あなた"],["がた"],["に"],["ぬぐい"],["捨てて","すてて"],["行きます","いきます"],["。"],["しかし"],["、"],["神","かみ"],["の"],["国","くに"],["が"],["近づいた","ちかづいた"],["こと"],["は"],["承知","しょうち"],["して"],["い"],["なさい"],["。"],["』"]]},{"verse":12,"text":"あなたがたに言うが、その日には、その町よりもソドムのほうがまだ罰が軽いのです。","tok":[["あなた"],["がた"],["に"],["言う","ゆう"],["が"],["、"],["その"],["日","ひ"],["に"],["は"],["、"],["その"],["町","まち"],["より"],["も"],["ソドム"],["の"],["ほう"],["が"],["まだ"],["罰","ばつ"],["が"],["軽い","かるい"],["の"],["です"],["。"]]},{"verse":13,"text":"ああコラジン。ああベツサイダ。おまえたちの間に起こった力あるわざが、もしもツロとシドンでなされたのだったら、彼らはとうの昔に荒布をまとい、灰の中にすわって、悔い改めていただろう。","tok":[["ああ"],["コラジン"],["。"],["ああ"],["ベツサイダ"],["。"],["おまえ"],["たち"],["の"],["間","あいだ"],["に"],["起こった","おこった"],["力","ちから"],["ある"],["わざ"],["が"],["、"],["もし"],["も"],["ツロ"],["と"],["シドン"],["で"],["なされた"],["の"],["だったら"],["、"],["彼","かれ"],["ら"],["は"],["とう"],["の"],["昔","むかし"],["に"],["荒布","あらめ"],["を"],["まとい"],["、"],["灰","はい"],["の"],["中","なか"],["に"],["すわって"],["、"],["悔い改めて","くいあらためて"],["いただろう"],["。"]]},{"verse":14,"text":"しかし、さばきの日には、そのツロとシドンのほうが、まだおまえたちより罰が軽いのだ。","tok":[["しかし"],["、"],["さばき"],["の"],["日","ひ"],["に"],["は"],["、"],["その"],["ツロ"],["と"],["シドン"],["の"],["ほう"],["が"],["、"],["まだ"],["おまえ"],["たち"],["より"],["罰","ばつ"],["が"],["軽い","かるい"],["の"],["だ"],["。"]]},{"verse":15,"text":"カペナウム。どうしておまえが天に上げられることがありえよう。ハデスにまで落とされるのだ。","tok":[["カペナウム"],["。"],["どう"],["して"],["おまえ"],["が"],["天","てん"],["に"],["上げられる","あげられる"],["こと"],["が"],["あり"],["えよう"],["。"],["ハデス"],["に"],["まで"],["落とされる","おとされる"],["の"],["だ"],["。"]]},{"verse":16,"text":"あなたがたに耳を傾ける者は、わたしに耳を傾ける者であり、あなたがたを拒む者は、わたしを拒む者です。わたしを拒む者は、わたしを遣わされた方を拒む者です。」","tok":[["あなた"],["がた"],["に"],["耳","みみ"],["を"],["傾ける","かたむける"],["者","もの"],["は"],["、"],["わたし"],["に"],["耳","みみ"],["を"],["傾ける","かたむける"],["者","もの"],["で"],["あり"],["、"],["あなた"],["がた"],["を"],["拒む","こばむ"],["者","もの"],["は"],["、"],["わたし"],["を"],["拒む","こばむ"],["者","もの"],["です"],["。"],["わたし"],["を"],["拒む","こばむ"],["者","もの"],["は"],["、"],["わたし"],["を"],["遣わされた","つかわされた"],["方","ほう"],["を"],["拒む","こばむ"],["者","もの"],["です"],["。"],["」"]]},{"verse":17,"text":"さて、七十人が喜んで帰って来て、こう言った。「主よ。あなたの御名を使うと、悪霊どもでさえ、私たちに服従します。」","tok":[["さて"],["、"],["七","なな"],["十人","じゅうにん"],["が"],["喜んで","よろこんで"],["帰って","かえって"],["来て","きて"],["、"],["こう"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["あなた"],["の"],["御名","ぎょめい"],["を"],["使う","つかう"],["と"],["、"],["悪霊","あくりょう"],["ども"],["で"],["さえ"],["、"],["私たち","わたしたち"],["に"],["服従","ふくじゅう"],["します"],["。"],["」"]]},{"verse":18,"text":"イエスは言われた。「わたしが見ていると、サタンが、いなずまのように天から落ちました。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["サタン"],["が"],["、"],["いなずま"],["の"],["よう"],["に"],["天","てん"],["から"],["落ちました","おちました"],["。"]]},{"verse":19,"text":"確かに、わたしは、あなたがたに、蛇やさそりを踏みつけ、敵のあらゆる力に打ち勝つ権威を授けたのです。だから、あなたがたに害を加えるものは何一つありません。","tok":[["確か","たしか"],["に"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["に"],["、"],["蛇","へび"],["や"],["さそり"],["を"],["踏みつけ","ふみつけ"],["、"],["敵","てき"],["の"],["あらゆる"],["力","ちから"],["に"],["打ち勝つ","うちかつ"],["権威","けんい"],["を"],["授けた","さずけた"],["の"],["です"],["。"],["だ"],["から"],["、"],["あなた"],["がた"],["に"],["害","がい"],["を"],["加える","くわえる"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["ありません"],["。"]]},{"verse":20,"text":"だがしかし、悪霊どもがあなたがたに服従するからといって、喜んではなりません。ただあなたがたの名が天に書きしるされていることを喜びなさい。」","tok":[["だ"],["が"],["しかし"],["、"],["悪霊","あくりょう"],["ども"],["が"],["あなた"],["がた"],["に"],["服従","ふくじゅう"],["する"],["から"],["と"],["いって"],["、"],["喜んで","よろこんで"],["は"],["なりません"],["。"],["ただ"],["あなた"],["がた"],["の"],["名","な"],["が"],["天","てん"],["に"],["書きしるされて","かきしるされて"],["いる"],["こと"],["を"],["喜び","よろこび"],["なさい"],["。"],["」"]]},{"verse":21,"text":"ちょうどこのとき、イエスは、聖霊によって喜びにあふれて言われた。「天地の主であられる父よ。あなたをほめたたえます。これらのことを、賢い者や知恵のある者には隠して、幼子たちに現してくださいました。そうです、父よ。これがみこころにかなったことでした。","tok":[["ちょうど"],["この"],["とき"],["、"],["イエス"],["は"],["、"],["聖霊","せいれい"],["によって"],["喜び","よろこび"],["に"],["あふれて"],["言われた","いわれた"],["。"],["「"],["天地","てんち"],["の"],["主","ぬし"],["で"],["あられる"],["父","ちち"],["よ"],["。"],["あなた"],["を"],["ほめたたえます"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["、"],["賢い","かしこい"],["者","もの"],["や"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["に"],["は"],["隠して","かくして"],["、"],["幼子","おさなご"],["たち"],["に"],["現して","あらわして"],["くださいました"],["。"],["そう"],["です"],["、"],["父","ちち"],["よ"],["。"],["これ"],["が"],["みこころ"],["に"],["かなった"],["こと"],["でした"],["。"]]},{"verse":22,"text":"すべてのものが、わたしの父から、わたしに渡されています。それで、子がだれであるかは、父のほかには知る者がありません。また父がだれであるかは、子と、子が父を知らせようと心に定めた人たちのほかは、だれも知る者がありません。」","tok":[["すべて"],["の"],["もの"],["が"],["、"],["わたし"],["の"],["父","ちち"],["から"],["、"],["わたし"],["に"],["渡されて","わたされて"],["います"],["。"],["それ"],["で"],["、"],["子","こ"],["が"],["だれ"],["で"],["ある"],["か"],["は"],["、"],["父","ちち"],["の"],["ほか"],["に"],["は"]
神の国は、人の目で認められるようにして来るものではありません。","tok":[["さて"],["、"],["神","かみ"],["の"],["国","くに"],["は"],["いつ"],["来る","くる"],["の"],["か"],["、"],["と"],["パリサイ"],["人","にん"],["たち"],["に"],["尋ねられた","たずねられた"],["とき"],["、"],["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["神","かみ"],["の"],["国","くに"],["は"],["、"],["人","ひと"],["の"],["目","め"],["で"],["認められる","みとめられる"],["よう"],["に"],["して"],["来る","くる"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":21,"text":"『そら、ここにある』とか、『あそこにある』とか言えるようなものではありません。いいですか。神の国は、あなたがたのただ中にあるのです。」","tok":[["『"],["そら"],["、"],["ここ"],["に"],["ある"],["』"],["と"],["か"],["、"],["『"],["あそこ"],["に"],["ある"],["』"],["と"],["か"],["言える","いえる"],["よう"],["な"],["もの"],["で"],["は"],["ありません"],["。"],["いいです"],["か"],["。"],["神","かみ"],["の"],["国","くに"],["は"],["、"],["あなた"],["がた"],["の"],["ただ中","ただなか"],["に"],["ある"],["の"],["です"],["。"],["」"]]},{"verse":22,"text":"イエスは弟子たちに言われた。「人の子の日を一日でも見たいと願っても、見られない時が来ます。","tok":[["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["の"],["日","ひ"],["を"],["一","いち"],["日","にち"],["で"],["も"],["見たい","みたい"],["と"],["願って","ねがって"],["も"],["、"],["見られない","みられない"],["時","とき"],["が"],["来ます","きます"],["。"]]},{"verse":23,"text":"人々が『こちらだ』とか、『あちらだ』とか言っても行ってはなりません。あとを追いかけてはなりません。","tok":[["人々","ひとびと"],["が"],["『"],["こちら"],["だ"],["』"],["と"],["か"],["、"],["『"],["あちら"],["だ"],["』"],["と"],["か"],["言って","いって"],["も"],["行って","いって"],["は"],["なりません"],["。"],["あと"],["を"],["追いかけて","おいかけて"],["は"],["なりません"],["。"]]},{"verse":24,"text":"いなずまが、ひらめいて、天の端から天の端へと輝くように、人の子は、人の子の日には、ちょうどそのようであるからです。","tok":[["いなずま"],["が"],["、"],["ひらめいて"],["、"],["天","てん"],["の"],["端","はし"],["から"],["天","てん"],["の"],["端","はし"],["へ"],["と"],["輝く","かがやく"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["日","ひ"],["に"],["は"],["、"],["ちょうど"],["その"],["よう"],["で"],["ある"],["から"],["です"],["。"]]},{"verse":25,"text":"しかし、人の子はまず、多くの苦しみを受け、この時代に捨てられなければなりません。","tok":[["しかし"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["まず"],["、"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["この"],["時代","じだい"],["に"],["捨てられなければ","すてられなければ"],["なりません"],["。"]]},{"verse":26,"text":"人の子の日に起こることは、ちょうど、ノアの日に起こったことと同様です。","tok":[["人","ひと"],["の"],["子","こ"],["の"],["日","ひ"],["に"],["起こる","おこる"],["こと"],["は"],["、"],["ちょうど"],["、"],["ノア"],["の"],["日","ひ"],["に"],["起こった","おこった"],["こと"],["と"],["同様","どうよう"],["です"],["。"]]},{"verse":27,"text":"ノアが箱舟に入るその日まで、人々は、食べたり、飲んだり、めとったり、とついだりしていたが、洪水が来て、すべての人を滅ぼしてしまいました。","tok":[["ノア"],["が"],["箱舟","はこぶね"],["に"],["入る","はいる"],["その"],["日","ひ"],["まで"],["、"],["人々","ひとびと"],["は"],["、"],["食べ","たべ"],["たり"],["、"],["飲ん","のん"],["だり"],["、"],["めとっ"],["たり"],["、"],["と"],["つい"],["だり"],["して"],["いた"],["が"],["、"],["洪水","こうずい"],["が"],["来て","きて"],["、"],["すべて"],["の"],["人","ひと"],["を"],["滅ぼして","ほろぼして"],["しまいました"],["。"]]},{"verse":28,"text":"また、ロトの時代にあったことと同様です。人々は食べたり、飲んだり、売ったり、買ったり、植えたり、建てたりしていたが、","tok":[["また"],["、"],["ロト"],["の"],["時代","じだい"],["に"],["あった"],["こと"],["と"],["同様","どうよう"],["です"],["。"],["人々","ひとびと"],["は"],["食べ","たべ"],["たり"],["、"],["飲ん","のん"],["だり"],["、"],["売っ","うっ"],["たり"],["、"],["買っ","かっ"],["たり"],["、"],["植え","うえ"],["たり"],["、"],["建て","たて"],["たり"],["して"],["いた"],["が"],["、"]]},{"verse":29,"text":"ロトがソドムから出て行くと、その日に、火と硫黄が天から降って、すべての人を滅ぼしてしまいました。","tok":[["ロト"],["が"],["ソドム"],["から"],["出て","でて"],["行く","いく"],["と"],["、"],["その"],["日","ひ"],["に"],["、"],["火","ひ"],["と"],["硫黄","いおう"],["が"],["天","てん"],["から"],["降って","ふって"],["、"],["すべて"],["の"],["人","ひと"],["を"],["滅ぼして","ほろぼして"],["しまいました"],["。"]]},{"verse":30,"text":"人の子の現れる日にも、全くそのとおりです。","tok":[["人","ひと"],["の"],["子","こ"],["の"],["現れる","あらわれる"],["日","ひ"],["に"],["も"],["、"],["全く","まったく"],["その"],["とおり"],["です"],["。"]]},{"verse":31,"text":"その日には、屋上にいる者は家に家財があっても、取り出しに降りてはいけません。同じように、畑にいる者も家に帰ってはいけません。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["屋上","おくじょう"],["に"],["いる"],["者","もの"],["は"],["家","いえ"],["に"],["家財","かざい"],["が"],["あって"],["も"],["、"],["取り出し","とりだし"],["に"],["降りて","おりて"],["は"],["いけません"],["。"],["同じ","おなじ"],["よう"],["に"],["、"],["畑","はたけ"],["に"],["いる"],["者","もの"],["も"],["家","いえ"],["に"],["帰って","かえって"],["は"],["いけません"],["。"]]},{"verse":32,"text":"ロトの妻を思い出しなさい。","tok":[["ロト"],["の"],["妻","つま"],["を"],["思い出し","おもいだし"],["なさい"],["。"]]},{"verse":33,"text":"自分のいのちを救おうと努める者はそれを失い、それを失う者はいのちを保ちます。","tok":[["自分","じぶん"],["の"],["いのち"],["を"],["救おう","すくおう"],["と"],["努める","つとめる"],["者","もの"],["は"],["それ"],["を"],["失い","うしない"],["、"],["それ"],["を"],["失う","うしなう"],["者","もの"],["は"],["いのち"],["を"],["保ちます","たもちます"],["。"]]},{"verse":34,"text":"あなたがたに言うが、その夜、同じ寝台でふたりの人が寝ていると、ひとりは取られ、他のひとりは残されます。","tok":[["あなた"],["がた"],["に"],["言う","ゆう"],["が"],["、"],["その"],["夜","よる"],["、"],["同じ","おなじ"],["寝台","しんだい"],["で"],["ふたり"],["の"],["人","ひと"],["が"],["寝て","ねて"],["いる"],["と"],["、"],["ひとり"],["は"],["取られ","とられ"],["、"],["他","た"],["の"],["ひとり"],["は"],["残されます","のこされます"],["。"]]},{"verse":35,"text":"女がふたりいっしょに臼をひいていると、ひとりは取られ、他のひとりは残されます。」","tok":[["女","おんな"],["が"],["ふたり"],["いっしょ"],["に"],["臼","うす"],["を"],["ひいて"],["いる"],["と"],["、"],["ひとり"],["は"],["取られ","とられ"],["、"],["他","た"],["の"],["ひとり"],["は"],["残されます","のこされます"],["。"],["」"]]},{"verse":36,"text":"一七・三五異本に三六節として「ふたりの男が畑にいると、ひとりは取られ、他のひとりは残されます」を加えるものもある。","tok":[["一七","いちなな"],["・"],["三五","さんご"],["異本","いほん"],["に"],["三六","さんろく"],["節","せつ"],["として"],["「"],["ふたり"],["の"],["男","おとこ"],["が"],["畑","はたけ"],["に"],["いる"],["と"],["、"],["ひとり"],["は"],["取られ","とられ"],["、"],["他","た"],["の"],["ひとり"],["は"],["残されます","のこされます"],["」"],["を"],["加える","くわえる"],["もの"],["も"],["ある"],["。"]]},{"verse":37,"text":"弟子たちは答えて言った。「主よ。どこでですか。」主は言われた。「死体のある所、そこに、はげたかも集まります。」","tok":[["弟子","でし"],["たち"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["どこ"],["で"],["です"],["か"],["。"],["」"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["死体","したい"],["の"],["ある"],["所","ところ"],["、"],["そこ"],["に"],["、"],["はげたか"],["も"],["集まります","あつまります"],["。"],["」"]]}]
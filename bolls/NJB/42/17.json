[{"verse":1,"text":"イエスは弟子たちにこう言われた。「つまずきが起こるのは避けられない。だが、つまずきを起こさせる者はわざわいだ。","tok":[["イエス"],["は"],["弟子","でし"],["たち"],["に"],["こう"],["言われた","いわれた"],["。"],["「"],["つまずき"],["が"],["起こる","おこる"],["の"],["は"],["避けられない","さけられない"],["。"],["だ"],["が"],["、"],["つまずき"],["を"],["起こさせる","おこさせる"],["者","もの"],["は"],["わざわい"],["だ"],["。"]]},{"verse":2,"text":"この小さい者たちのひとりに、つまずきを与えるようであったら、そんな者は石臼を首にゆわえつけられて、海に投げ込まれたほうがましです。","tok":[["この"],["小さい","ちいさい"],["者","もの"],["たち"],["の"],["ひとり"],["に"],["、"],["つまずき"],["を"],["与える","あたえる"],["よう"],["で"],["あったら"],["、"],["そんな"],["者","もの"],["は"],["石臼","いしうす"],["を"],["首","くび"],["に"],["ゆわえつけられて"],["、"],["海","うみ"],["に"],["投げ込まれた","なげこまれた"],["ほう"],["が"],["まし"],["です"],["。"]]},{"verse":3,"text":"気をつけていなさい。もし兄弟が罪を犯したなら、彼を戒めなさい。そして悔い改めれば、赦しなさい。","tok":[["気","き"],["を"],["つけて"],["い"],["なさい"],["。"],["もし"],["兄弟","きょうだい"],["が"],["罪","つみ"],["を"],["犯したなら","おかしたなら"],["、"],["彼","かれ"],["を"],["戒め","いましめ"],["なさい"],["。"],["そして"],["悔い改めれば","くいあらためれば"],["、"],["赦し","ゆるし"],["なさい"],["。"]]},{"verse":4,"text":"かりに、あなたに対して一日に七度罪を犯しても、『悔い改めます』と言って七度あなたのところに来るなら、赦してやりなさい。」","tok":[["かり"],["に"],["、"],["あなた"],["に対して","にたいして"],["一","いち"],["日","にち"],["に"],["七","しち"],["度罪","どざい"],["を"],["犯して","おかして"],["も"],["、"],["『"],["悔い改めます","くいあらためます"],["』"],["と"],["言って","いって"],["七","なな"],["度","ど"],["あなた"],["の"],["ところ"],["に"],["来るなら","くるなら"],["、"],["赦して","ゆるして"],["やり"],["なさい"],["。"],["」"]]},{"verse":5,"text":"使徒たちは主に言った。「私たちの信仰を増してください。」","tok":[["使徒","しと"],["たち"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["の"],["信仰","しんこう"],["を"],["増して","まして"],["ください"],["。"],["」"]]},{"verse":6,"text":"しかし主は言われた。「もしあなたがたに、からし種ほどの信仰があったなら、この桑の木に、『根こそぎ海の中に植われ』と言えば、言いつけどおりになるのです。","tok":[["しかし"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["もし"],["あなた"],["がた"],["に"],["、"],["からし"],["種","しゅ"],["ほど"],["の"],["信仰","しんこう"],["が"],["あったなら"],["、"],["この"],["桑","くわ"],["の"],["木","き"],["に"],["、"],["『"],["根こそぎ","ねこそぎ"],["海","うみ"],["の"],["中","なか"],["に"],["植われ","うわれ"],["』"],["と"],["言えば","いえば"],["、"],["言いつけ","いいつけ"],["どおり"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":7,"text":"ところで、あなたがたのだれかに、耕作か羊飼いをするしもべがいるとして、そのしもべが野らから帰って来たとき、『さあ、さあ、ここに来て、食事をしなさい』としもべに言うでしょうか。","tok":[["ところ"],["で"],["、"],["あなた"],["がた"],["の"],["だれ"],["か"],["に"],["、"],["耕作","こうさく"],["か"],["羊飼い","ひつじかい"],["を"],["する"],["しもべ"],["が"],["いる"],["として"],["、"],["その"],["しもべ"],["が"],["野","の"],["ら"],["から"],["帰って","かえって"],["来た","きた"],["とき"],["、"],["『"],["さあ"],["、"],["さあ"],["、"],["ここ"],["に"],["来て","きて"],["、"],["食事","しょくじ"],["を"],["し"],["なさい"],["』"],["と"],["しもべ"],["に"],["言うでしょう","ゆうでしょう"],["か"],["。"]]},{"verse":8,"text":"かえって、『私の食事の用意をし、帯を締めて私の食事が済むまで給仕しなさい。あとで、自分の食事をしなさい』と言わないでしょうか。","tok":[["かえって"],["、"],["『"],["私","わたくし"],["の"],["食事","しょくじ"],["の"],["用意","ようい"],["を"],["し"],["、"],["帯","おび"],["を"],["締めて","しめて"],["私","わたくし"],["の"],["食事","しょくじ"],["が"],["済む","すむ"],["まで"],["給仕","きゅうじ"],["し"],["なさい"],["。"],["あと"],["で"],["、"],["自分","じぶん"],["の"],["食事","しょくじ"],["を"],["し"],["なさい"],["』"],["と"],["言わないでしょう","いわないでしょう"],["か"],["。"]]},{"verse":9,"text":"しもべが言いつけられたことをしたからといって、そのしもべに感謝するでしょうか。","tok":[["しもべ"],["が"],["言いつけられた","いいつけられた"],["こと"],["を"],["した"],["から"],["と"],["いって"],["、"],["その"],["しもべ"],["に"],["感謝","かんしゃ"],["するでしょう"],["か"],["。"]]},{"verse":10,"text":"あなたがたもそのとおりです。自分に言いつけられたことをみな、してしまったら、『私たちは役に立たないしもべです。なすべきことをしただけです』と言いなさい。」","tok":[["あなた"],["がた"],["も"],["その"],["とおり"],["です"],["。"],["自分","じぶん"],["に"],["言いつけられた","いいつけられた"],["こと"],["を"],["みな"],["、"],["して"],["しまったら"],["、"],["『"],["私たち","わたしたち"],["は"],["役","やく"],["に"],["立たない","たたない"],["しもべ"],["です"],["。"],["なすべき"],["こと"],["を"],["した"],["だけ"],["です"],["』"],["と"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":11,"text":"そのころイエスはエルサレムに上られる途中、サマリヤとガリラヤの境を通られた。","tok":[["その"],["ころ"],["イエス"],["は"],["エルサレム"],["に"],["上られる","のぼられる"],["途中","とちゅう"],["、"],["サマリヤ"],["と"],["ガリラヤ"],["の"],["境","さかい"],["を"],["通られた","とおられた"],["。"]]},{"verse":12,"text":"ある村に入ると、十人のツァラアトに冒された人がイエスに出会った。彼らは遠く離れた所に立って、","tok":[["ある"],["村","むら"],["に"],["入る","はいる"],["と"],["、"],["十人","じゅうにん"],["の"],["ツァラアト"],["に"],["冒された","おかされた"],["人","ひと
[{"verse":1,"text":"イエスは、十二人を呼び集めて、彼らに、すべての悪霊を追い出し、病気を直すための、力と権威とをお授けになった。","tok":[["イエス"],["は"],["、"],["十二人","じゅうににん"],["を"],["呼び集めて","よびあつめて"],["、"],["彼","かれ"],["ら"],["に"],["、"],["すべて"],["の"],["悪霊","あくりょう"],["を"],["追い出し","おいだし"],["、"],["病気","びょうき"],["を"],["直す","なおす"],["ため"],["の"],["、"],["力","ちから"],["と"],["権威","けんい"],["と"],["を"],["お授け","おさずけ"],["に"],["なった"],["。"]]},{"verse":2,"text":"それから、神の国を宣べ伝え、病気を直すために、彼らを遣わされた。","tok":[["それ"],["から"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["宣べ伝え","のべつたえ"],["、"],["病気","びょうき"],["を"],["直す","なおす"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["遣わされた","つかわされた"],["。"]]},{"verse":3,"text":"イエスは、こう言われた。「旅のために何も持って行かないようにしなさい。杖も、袋も、パンも、金も。また下着も、二枚は、いりません。","tok":[["イエス"],["は"],["、"],["こう"],["言われた","いわれた"],["。"],["「"],["旅","たび"],["の"],["ため"],["に"],["何","なん"],["も"],["持って","もって"],["行かない","いかない"],["よう"],["に"],["し"],["なさい"],["。"],["杖","つえ"],["も"],["、"],["袋","ふくろ"],["も"],["、"],["パン"],["も"],["、"],["金","きん"],["も"],["。"],["また"],["下着","したぎ"],["も"],["、"],["二枚","にまい"],["は"],["、"],["いりません"],["。"]]},{"verse":4,"text":"どんな家に入っても、そこにとどまり、そこから次の旅に出かけなさい。","tok":[["どんな"],["家","いえ"],["に"],["入って","はいって"],["も"],["、"],["そこ"],["に"],["とどまり"],["、"],["そこ"],["から"],["次","つぎ"],["の"],["旅","たび"],["に"],["出かけ","でかけ"],["なさい"],["。"]]},{"verse":5,"text":"人々があなたがたを受け入れない場合は、その町を出て行くときに、彼らに対する証言として、足のちりを払い落としなさい。」","tok":[["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["受け入れない","うけいれない"],["場合","ばあい"],["は"],["、"],["その"],["町","まち"],["を"],["出て","でて"],["行く","いく"],["とき"],["に"],["、"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["証言","しょうげん"],["として"],["、"],["足","あし"],["の"],["ちり"],["を"],["払い落とし","はらいおとし"],["なさい"],["。"],["」"]]},{"verse":6,"text":"十二人は出かけて行って、村から村へと回りながら、至る所で福音を宣べ伝え、病気を直した。","tok":[["十二人","じゅうににん"],["は"],["出かけて","でかけて"],["行って","いって"],["、"],["村","むら"],["から"],["村","むら"],["へ"],["と"],["回り","まわり"],["ながら"],["、"],["至る所","いたるところ"],["で"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["、"],["病気","びょうき"],["を"],["直した","なおした"],["。"]]},{"verse":7,"text":"さて、国主ヘロデは、このすべての出来事を聞いて、ひどく当惑していた。それは、ある人々が、「ヨハネが死人の中からよみがえったのだ」と言い、","tok":[["さて"],["、"],["国主","こくしゅ"],["ヘロデ"],["は"],["、"],["この"],["すべて"],["の"],["出来事","できごと"],["を"],["聞いて","きいて"],["、"],["ひどく"],["当惑","とうわく"],["して"],["いた"],["。"],["それ"],["は"],["、"],["ある"],["人々","ひとびと"],["が"],["、"],["「"],["ヨハネ"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえった"],["の"],["だ"],["」"],["と"],["言い","いい"],["、"]]},{"verse":8,"text":"ほかの人々は、「エリヤが現れたのだ」と言い、さらに別の人々は、「昔の預言者のひとりがよみがえったのだ」と言っていたからである。","tok":[["ほか"],["の"],["人々","ひとびと"],["は"],["、"],["「"],["エリヤ"],["が"],["現れた","あらわれた"],["の"],["だ"],["」"],["と"],["言い","いい"],["、"],["さらに"],["別","べつ"],["の"],["人々","ひとびと"],["は"],["、"],["「"],["昔","むかし"],["の"],["預言者","よげんしゃ"],["の"],["ひとり"],["が"],["よみがえった"],["の"],["だ"],["」"],["と"],["言って","いって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"ヘロデは言った。「ヨハネなら、私が首をはねたのだ。そうしたことがうわさされているこの人は、いったいだれなのだろう。」ヘロデはイエスに会ってみようとした。","tok":[["ヘロデ"],["は"],["言った","いった"],["。"],["「"],["ヨハネ"],["なら"],["、"],["私","わたくし"],["が"],["首","くび"],["を"],["はねた"],["の"],["だ"],["。"],["そう"],["した"],["こと"],["が"],["うわさ"],["されて"],["いる"],["この"],["人","ひと"],["は"],["、"],["いったい"],["だれ"],["な"],["の"],["だろう"],["。"],["」"],["ヘロデ"],["は"],["イエス"],["に"],["会って","あって"],["みよう"],["と"],["した"],["。"]]},{"verse":10,"text":"さて、使徒たちは帰って来て、自分たちのして来たことを報告した。それからイエスは彼らを連れてベツサイダという町へひそかに退かれた。","tok":[["さて"],["、"],["使徒","しと"],["たち"],["は"],["帰って","かえって"],["来て","きて"],["、"],["自分","じぶん"],["たち"],["の"],["して"],["来た","きた"],["こと"],["を"],["報告","ほうこく"],["した"],["。"],["それ"],["から"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["連れて","つれて"],["ベツサイダ"],["と"],["いう"],["町","まち"],["へ"],["ひそか"],["に"],["退かれた","しりぞかれた"],["。"]]},{"verse":11,"text":"ところが、多くの群衆がこれを知って、ついて来た。それで、イエスは喜んで彼らを迎え、神の国のことを話し、また、いやしの必要な人たちをおいやしになった。","tok":[["ところ"],["が"],["、"],["多く","おおく"],["の"],["群衆","ぐんしゅう"],["が"],["これ"],["を"],["知って","しって"],["、"],["ついて"],["来た","きた"],["。"],["それ"],["で"],["、"],["イエス"],["は"],["喜んで","よろこんで"],["彼","かれ"],["ら"],["を"],["迎え","むかえ"],["、"],["神","かみ"],["の"],["国","くに"],["の"],["こと"],["を"],["話し","はなし"],["、"],["また"],["、"],["いやし"],["の"],["必要","ひつよう"],["な"],["人","ひと"],["たち"],["を"],["おいやし"],["に"],["なった"],["。"]]},{"verse":12,"text":"そのうち、日も暮れ始めたので、十二人はみもとに来て、「この群衆を解散させてください。そして回りの村や部落にやって、宿をとらせ、何か食べることができるようにさせてください。私たちは、こんな人里離れた所にいるのですから」と言った。","tok":[["その"],["うち"],["、"],["日","ひ"],["も"],["暮れ","くれ"],["始めた","はじめた"],["ので"],["、"],["十二人","じゅうににん"],["は"],["みもと"],["に"],["来て","きて"],["、"],["「"],["この"],["群衆","ぐんしゅう"],["を"],["解散","かいさん"],["させて"],["ください"],["。"],["そして"],["回り","まわり"],["の"],["村","むら"],["や"],["部落","ぶらく"],["に"],["やって"],["、"],["宿","やど"],["を"],["とらせ"],["、"],["何","なん"],["か"],["食べる","たべる"],["こと"],["が"],["できる"],["よう"],["に"],["させて"],["ください"],["。"],["私たち","わたしたち"],["は"],["、"],["こんな"],["人里","ひとざと"],["離れた","はなれた"],["所","ところ"],["に"],["いる"],["の"],["です"],["から"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"しかしイエスは、彼らに言われた。「あなたがたで、何か食べる物を上げなさい。」彼らは言った。「私たちには五つのパンと二匹の魚のほか何もありません。私たちが出かけて行って、この民全体のために食物を買うのでしょうか。」","tok":[["しかし"],["イエス"],["は"],["、"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["で"],["、"],["何","なん"],["か"],["食べる","たべる"],["物","もの"],["を"],["上げ","あげ"],["なさい"],["。"],["」"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["私たち","わたしたち"],["に"],["は"],["五","いつ"],["つ"],["の"],["パン"],["と"],["二匹","にひき"],["の"],["魚","さかな"],["の"],["ほか"],["何","なん"],["も"],["ありません"],["。"],["私たち","わたしたち"],["が"],["出かけて","でかけて"],["行って","いって"],["、"],["この"],["民","みん"],["全体","ぜんたい"],["の"],["ため"],["に"],["食物","しょくもつ"],["を"],["買う","かう"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":14,"text":"それは、男だけでおよそ五千人もいたからである。しかしイエスは、弟子たちに言われた。「人々を、五十人ぐらいずつ組にしてすわらせなさい。」","tok":[["それ"],["は"],["、"],["男","おとこ"],["だけ"],["で"],["およそ"],["五千人","ごせんにん"],["も"],["いた"],["から"],["で"],["ある"],["。"],["しかし"],["イエス"],["は"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["人々","ひとびと"],["を"],["、"],["五","ご"],["十人","じゅうにん"],["ぐらい"],["ずつ"],["組","くみ"],["に"],["して"],["すわらせ"],["なさい"],["。"],["」"]]},{"verse":15,"text":"弟子たちは、そのようにして、全部をすわらせた。","tok":[["弟子","でし"],["たち"],["は"],["、"],["その"],["よう"],["に"],["して"],["、"],["全部","ぜんぶ"],["を"],["すわらせた"],["。"]]},{"verse":16,"text":"すると
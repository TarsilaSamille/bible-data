[{"verse":1,"text":"イエスは、耳を傾けている民衆にこれらのことばをみな話し終えられると、カペナウムに入られた。","tok":[["イエス"],["は"],["、"],["耳","みみ"],["を"],["傾けて","かたむけて"],["いる"],["民衆","みんしゅう"],["に"],["これ"],["ら"],["の"],["ことば"],["を"],["みな"],["話","はなし"],["し終えられる","しおえられる"],["と"],["、"],["カペナウム"],["に"],["入られた","はいられた"],["。"]]},{"verse":2,"text":"ところが、ある百人隊長に重んじられているひとりのしもべが、病気で死にかけていた。","tok":[["ところ"],["が"],["、"],["ある"],["百人","ひゃくにん"],["隊長","たいちょう"],["に"],["重んじられて","おもんじられて"],["いる"],["ひとり"],["の"],["しもべ"],["が"],["、"],["病気","びょうき"],["で"],["死に","しに"],["かけて"],["いた"],["。"]]},{"verse":3,"text":"百人隊長は、イエスのことを聞き、みもとにユダヤ人の長老たちを送って、しもべを助けに来てくださるようお願いした。","tok":[["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["、"],["イエス"],["の"],["こと"],["を"],["聞き","きき"],["、"],["みもと"],["に"],["ユダヤ人","ゆだやじん"],["の"],["長老","ちょうろう"],["たち"],["を"],["送って","おくって"],["、"],["しもべ"],["を"],["助け","たすけ"],["に"],["来て","きて"],["くださる"],["よう"],["お願い","おねがい"],["した"],["。"]]},{"verse":4,"text":"イエスのもとに来たその人たちは、熱心にお願いして言った。「この人は、あなたにそうしていただく資格のある人です。","tok":[["イエス"],["の"],["もと"],["に"],["来た","きた"],["その"],["人","ひと"],["たち"],["は"],["、"],["熱心","ねっしん"],["に"],["お願い","おねがい"],["して"],["言った","いった"],["。"],["「"],["この"],["人","ひと"],["は"],["、"],["あなた"],["に"],["そう"],["して"],["いただく"],["資格","しかく"],["の"],["ある"],["人","ひと"],["です"],["。"]]},{"verse":5,"text":"この人は、私たちの国民を愛し、私たちのために会堂を建ててくれた人です。」","tok":[["この"],["人","ひと"],["は"],["、"],["私たち","わたしたち"],["の"],["国民","こくみん"],["を"],["愛し","あいし"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["会堂","かいどう"],["を"],["建てて","たてて"],["くれた"],["人","ひと"],["です"],["。"],["」"]]},{"verse":6,"text":"イエスは、彼らといっしょに行かれた。そして、百人隊長の家からあまり遠くない所に来られたとき、百人隊長は友人たちを使いに出して、イエスに伝えた。「主よ。わざわざおいでくださいませんように。あなたを私の屋根の下にお入れする資格は、私にはありません。","tok":[["イエス"],["は"],["、"],["彼","かれ"],["ら"],["と"],["いっしょ"],["に"],["行かれた","いかれた"],["。"],["そして"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["の"],["家","いえ"],["から"],["あまり"],["遠く","とおく"],["ない"],["所","ところ"],["に"],["来られた","こられた"],["とき"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["友人","ゆうじん"],["たち"],["を"],["使い","つかい"],["に"],["出して","だして"],["、"],["イエス"],["に"],["伝えた","つたえた"],["。"],["「"],["主","ぬし"],["よ"],["。"],["わざわざ"],["おいで"],["くださいません"],["よう"],["に"],["。"],["あなた"],["を"],["私","わたくし"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["お入れ","おいれ"],["する"],["資格","しかく"],["は"],["、"],["私","わたくし"],["に"],["は"],["ありません"],["。"]]},{"verse":7,"text":"ですから、私のほうから伺うことさえ失礼と存じました。ただ、おことばをいただかせてください。そうすれば、私のしもべは必ずいやされます。","tok":[["です"],["から"],["、"],["私","わたくし"],["の"],["ほう"],["から"],["伺う","うかがう"],["こと"],["さえ"],["失礼","しつれい"],["と"],["存じました","ぞんじました"],["。"],["ただ"],["、"],["おことば"],["を"],["いただかせて"],["ください"],["。"],["そう"],["すれば"],["、"],["私","わたくし"],["の"],["しもべ"],["は"],["必ず","かならず"],["いやされます"],["。"]]},{"verse":8,"text":"と申しますのは、私も権威の下にある者ですが、私の下にも兵士たちがいまして、そのひとりに『行け』と言えば行きますし、別の者に『来い』と言えば来ます。また、しもべに『これをせよ』と言えば、そのとおりにいたします。」","tok":[["と"],["申します","もうします"],["の"],["は"],["、"],["私","わたくし"],["も"],["権威","けんい"],["の"],["下","した"],["に"],["ある"],["者","もの"],["です"],["が"],["、"],["私","わたくし"],["の"],["下","した"],["に"],["も"],["兵士","へいし"],["たち"],["が"],["いまして"],["、"],["その"],["ひとり"],["に"],["『"],["行け","いけ"],["』"],["と"],["言えば","いえば"],["行きます","いきます"],["し"],["、"],["別","べつ"],["の"],["者","もの"],["に"],["『"],["来い","こい"],["』"],["と"],["言えば","いえば"],["来ます","きます"],["。"],["また"],["、"],["しもべ"],["に"],["『"],["これ"],["を"],["せよ"],["』"],["と"],["言えば","いえば"],["、"],["その"],["とおり"],["に"],["いたします"],["。"],["」"]]},{"verse":9,"text":"これを聞いて、イエスは驚かれ、ついて来ていた群衆のほうに向いて言われた。「あなたがたに言いますが、このようなりっぱな信仰は、イスラエルの中にも見たことがありません。」","tok":[["これ"],["を"],["聞いて","きいて"],["、"],["イエス"],["は"],["驚かれ","おどろかれ"],["、"],["ついて"],["来て","きて"],["いた"],["群衆","ぐんしゅう"],["の"],["ほう"],["に"],["向いて","むいて"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["に"],["言います","いいます"],["が"],["、"],["この"],["よう"],["な"],["りっぱ"],["な"],["信仰","しんこう"],["は"],["、"],["イスラエル"],["の"],["中","なか"],["に"],["も"],["見た","みた"],["こと"],["が"],["ありません"],["。"],["」"]]},{"verse":10,"text":"使いに来た人たちが家に帰ってみると、しもべはよくなっていた。","tok":[["使い","つかい"],["に"],["来た","きた"],["人","ひと"],["たち"],["が"],["家","いえ"],["に"],["帰って","かえって"],["みる"],["と"],["、"],["しもべ"],["は"],["よく"],["なって"],["いた"],["。"]]},{"verse":11,"text":"それから間もなく、イエスはナインという町に行かれた。弟子たちと大ぜいの人の群れがいっしょに行った。","tok":[["それ"],["から"],["間","ま"],["も"],["なく"],["、"],["イエス"],["は"],["ナイン"],["と"],["いう"],["町","まち"],["に"],["行かれた","いかれた"],["。"],["弟子","でし"],["たち"],["と"],["大ぜい","おおぜい"],["の"],["人","ひと"],["の"],["群れ","むれ"],["が"],["いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":12,"text":"イエスが町の門に近づかれると、やもめとなった母親のひとり息子が、死んでかつぎ出されたところであった。町の人たちが大ぜいその母親につき添っていた。","tok":[["イエス"],["が"],["町","まち"],["の"],["門","もん"],["に"],["近づかれる","ちかづかれる"],["と"],["、"],["やもめ"],["と"],["なった"],["母親","ははおや"],["の"],["ひとり"],["息子","むすこ"],["が"],["、"],["死んで","しんで"],["かつぎ出された","かつぎだされた"],["ところ"],["で"],["あった"],["。"],["町","まち"],["の"],["人","ひと"],["たち"],["が"],["大ぜい","おおぜい"],["その"],["母親","ははおや"],["に"],["つき添って","つきそって"],["いた"],["。"]]},{"verse":13,"text":"主はその母親を見てかわいそうに思い、「泣かなくてもよい」と言われた。","tok":[["主","ぬし"],["は"],["その"],["母親","ははおや"],["を"],["見て","みて"],["かわいそう"],["に"],["思い","おもい"],["、"],["「"],["泣かなくて","なかなくて"],["も"],["よい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":14,"text":"そして近寄って棺に手をかけられると、かついでいた人たちが立ち止まったので、「青年よ。あなたに言う、起きなさい」と言われた。","tok":[["そして"],["近寄って","ちかよって"],["棺","ひつぎ"],["に"],["手","て"],["を"],["かけられる"],["と"],["、"],["かついで"],["いた"],["人","ひと"],["たち"],["が"],["立ち止まった","たちどまった"],["ので"],["、"],["「"],["青年","せいねん"],["よ"],["。"],["あなた"],["に"],["言う","いう"],["、"],["起き","おき"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":15,"text":"すると、その死人が起き上がって、ものを言い始めたので、イエスは彼を母親に返された。","tok":[["する"],["と"],["、"],["その"],["死人","しにん"],["が"],["起き上がって","おきあがって"],["、"],["もの"],["を"],["言い","いい"],["始めた","はじめた"],["ので"],["、"],["イエス"],["は"],["彼","かれ"],["を"],["母親","ははおや"],["に"],["返された","かえされた"],["。"]]},{"verse":16,"text":"人々は恐れを抱き、「大預言者が私たちのうちに現れた」とか、「神がその民を顧みてくださった」などと言って、神をあがめた。","tok":[["人々","ひとびと"],["は"],["恐れ","おそれ"],["を"],["抱き","いだき"],["、"],["「"],["大","だい"],["預言者","よげんしゃ"],["が"],["私たち","わたしたち"],["の"],["うち"],["に"],["現れた","あらわれた"],["」"],["と"],["か"],["、"],["「"],["神","かみ"],["が"],["その"],["民","たみ"],["を"],["顧みて","かえりみて"],["くださった"],["」"],["など"],["と"],["言って","いって"],["、"],["神","かみ"],["を"],["あがめた"],["。"]]},{"verse":17,"text":"イエスについてこの話がユダヤ全土と回りの地方一帯に広まった。","tok":[["イエス"],["について"],["この"],["話","はなし"],["が"],["ユダヤ"],["全土","ぜんど"],["と"],["回り","まわり"],["の"],["地方","ちほう"],["一帯","いったい"],["に"],["広まった","ひろまった"],["。"]]},{"verse":18,"text":"さて、ヨハネの弟子たちは、これらのことをすべてヨハネに報告した。","tok":[["さて"],["、"],["ヨハネ"],["の"],["弟子","でし"],["たち"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["すべて"],["ヨハネ"],["に"],["報告","ほうこく"],["した"],["。"]]},{"verse":19,"text":"すると、ヨハネは、弟子の中からふたりを呼び寄せて、主のもとに送り、「おいでになるはずの方は、あなたですか。それとも、私たちはほかの方を待つべきでしょうか」と言わせた。","tok":[["する"],["と"],["、"],["ヨハネ"],["は"],["、"],["弟子","でし"],["の"],["中","なか"],["から"],["ふたり"],["を"],["呼び寄せて","よびよせて"],["、"],["主","ぬし"],["の"],["もと"],["に"],["送り","おくり"],["、"],["「"],["おいで"],["に"],["なる"],["はず"],["の"],["方","ほう"],["は"],["、"],["あなた"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["私たち","わたしたち"],["は"],["ほか"],["の"],["方","ほう"],["を"],["待つべきでしょう","まつべきでしょう"],["か"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":20,"text":"ふたりはみもとに来て言った。「バプテスマのヨハネから遣わされてまいりました。『おいでになるはずの方は、あなたですか。それとも私たちはなおほかの方を待つべきでしょうか』とヨハネが申しております。」","tok":[["ふたり"],["は"],["みもと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["バプテスマ"],["の"],["ヨハネ"],["から"],["遣わされて","つかわされて"],["まいりました"],["。"],["『"],["おいで"],["に"],["なる"],["はず"],["の"],["方","ほう"],["は"],["、"],["あなた"],["です"],["か"],["。"],["それ"],["と"],["も"],["私たち","わたしたち"],["は"],["なお"],["ほか"],["の"],["方","ほう"],["を"],["待つべきでしょう","まつべきでしょう"],["か"],["』"],["と"],["ヨハネ"],["が"],["申して","もうして"],["おります"],["。"],["」"]]},{"verse":21,"text":"ちょうどそのころ、イエスは、多くの人々を病気と苦しみと悪霊からいやし、また多くの盲人を見えるようにされた。","tok":[["ちょうど"],["その"],["ころ"],["、"],["イエス"],["は"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["を"],["病気","びょうき"],["と"],["苦しみ","くるしみ"],["と"],["悪霊","あくりょう"],["から"],["いやし"],["、"],["また"],["多く","おおく"],["の"],["盲人","もうじん"],["を"],["見える","みえる"],["よう"],["に"],["された"],["。"]]},{"verse":22,"text":"そして、答えてこう言われた。「あなたがたは行って、自分たちの見たり聞いたりしたことをヨハネに報告しなさい。目の見えない者が見、足のなえた者が歩き、ツァラアトに冒された者がきよめられ、耳の聞こえない者が聞き、死人が生き返り、貧しい者たちに福音が宣べ伝えられている。","tok":[["そして"],["、"],["答えて","こたえて"],["こう"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["は"],["行って","いって"],["、"],
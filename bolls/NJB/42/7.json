":[["その"],["人","ひと"],["こそ"],["、"],["『"],["見よ","みよ"],["、"],["わたし"],["は"],["使い","つかい"],["を"],["あなた"],["の"],["前","まえ"],["に"],["遣わし","つかわし"],["、"],["あなた"],["の"],["道","みち"],["を"],["、"],["あなた"],["の"],["前","まえ"],["に"],["備えさせよう","そなえさせよう"],["』"],["／"],["と"],["書かれて","かかれて"],["いる"],["その"],["人","ひと"],["です"],["。"]]},{"verse":28,"text":"あなたがたに言いますが、女から生まれた者の中で、ヨハネよりもすぐれた人は、ひとりもいません。しかし、神の国で一番小さい者でも、彼よりすぐれています。","tok":[["あなた"],["がた"],["に"],["言います","いいます"],["が"],["、"],["女","おんな"],["から"],["生まれた","うまれた"],["者","もの"],["の"],["中","なか"],["で"],["、"],["ヨハネ"],["より"],["も"],["すぐれた"],["人","ひと"],["は"],["、"],["ひとり"],["も"],["いません"],["。"],["しかし"],["、"],["神","かみ"],["の"],["国","くに"],["で"],["一番","いちばん"],["小さい","ちいさい"],["者","もの"],["で"],["も"],["、"],["彼","かれ"],["より"],["すぐれて"],["います"],["。"]]},{"verse":29,"text":"ヨハネの教えを聞いたすべての民は、取税人たちさえ、ヨハネのバプテスマを受けて、神の正しいことを認めたのです。","tok":[["ヨハネ"],["の"],["教え","おしえ"],["を"],["聞いた","きいた"],["すべて"],["の"],["民","たみ"],["は"],["、"],["取","とり"],["税人","ぜいにん"],["たち"],["さえ"],["、"],["ヨハネ"],["の"],["バプテスマ"],["を"],["受けて","うけて"],["、"],["神","かみ"],["の"],["正しい","ただしい"],["こと"],["を"],["認めた","みとめた"],["の"],["です"],["。"]]},{"verse":30,"text":"これに反して、パリサイ人、律法の専門家たちは、彼からバプテスマを受けないで、神の自分たちに対するみこころを拒みました。","tok":[["これ"],["に"],["反して","はんして"],["、"],["パリサイ"],["人","にん"],["、"],["律法","りっぽう"],["の"],["専門家","せんもんか"],["たち"],["は"],["、"],["彼","かれ"],["から"],["バプテスマ"],["を"],["受けないで","うけないで"],["、"],["神","かみ"],["の"],["自分","じぶん"],["たち"],["に"],["対する","たいする"],["みこころ"],["を"],["拒みました","こばみました"],["。"]]},{"verse":31,"text":"では、この時代の人々は、何にたとえたらよいでしょう。何に似ているでしょう。","tok":[["で"],["は"],["、"],["この"],["時代","じだい"],["の"],["人々","ひとびと"],["は"],["、"],["何","なん"],["に"],["たとえたら"],["よいでしょう"],["。"],["何","なん"],["に"],["似て","にて"],["いるでしょう"],["。"]]},{"verse":32,"text":"市場にすわって、互いに呼びかけながら、こう言っている子どもたちに似ています。／『笛を吹いてやっても、君たちは踊らなかった。／弔いの歌を歌ってやっても、泣かなかった。』","tok":[["市場","しじょう"],["に"],["すわって"],["、"],["互い","たがい"],["に"],["呼びかけ","よびかけ"],["ながら"],["、"],["こう"],["言って","いって"],["いる"],["子ども","こども"],["たち"],["に"],["似て","にて"],["います"],["。"],["／"],["『"],["笛","ふえ"],["を"
[{"verse":1,"text":"イエスは宮で民衆を教え、福音を宣べ伝えておられたが、ある日、祭司長、律法学者たちが、長老たちといっしょにイエスに立ち向かって、","tok":[["イエス"],["は"],["宮","みや"],["で"],["民衆","みんしゅう"],["を"],["教え","おしえ"],["、"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["おられた"],["が"],["、"],["ある"],["日","ひ"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["、"],["長老","ちょうろう"],["たち"],["と"],["いっしょ"],["に"],["イエス"],["に"],["立ち向かって","たちむかって"],["、"]]},{"verse":2,"text":"イエスに言った。「何の権威によって、これらのことをしておられるのですか。あなたにその権威を授けたのはだれですか。それを言ってください。」","tok":[["イエス"],["に"],["言った","いった"],["。"],["「"],["何","なん"],["の"],["権威","けんい"],["によって"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["して"],["おられる"],["の"],["です"],["か"],["。"],["あなた"],["に"],["その"],["権威","けんい"],["を"],["授けた","さずけた"],["の"],["は"],["だれ"],["です"],["か"],["。"],["それ"],["を"],["言って","いって"],["ください"],["。"],["」"]]},{"verse":3,"text":"そこで答えて言われた。「わたしも一言尋ねますから、それに答えなさい。","tok":[["そこ"],["で"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["わたし"],["も"],["一言","ひとこと"],["尋ねます","たずねます"],["から"],["、"],["それ"],["に"],["答え","こたえ"],["なさい"],["。"]]},{"verse":4,"text":"ヨハネのバプテスマは、天から来たのですか、人から出たのですか。」","tok":[["ヨハネ"],["の"],["バプテスマ"],["は"],["、"],["天","てん"],["から"],["来た","きた"],["の"],["です"],["か"],["、"],["人","ひと"],["から"],["出た","でた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":5,"text":"すると彼らは、こう言って、互いに論じ合った。「もし、天から、と言えば、それならなぜ、彼を信じなかったか、と言うだろう。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["、"],["こう"],["言って","いって"],["、"],["互い","たがい"],["に"],["論じ合った","ろんじあった"],["。"],["「"],["もし"],["、"],["天","てん"],["から"],["、"],["と"],["言えば","いえば"],["、"],["それ"],["なら"],["なぜ"],["、"],["彼","かれ"],["を"],["信じなかった","しんじなかった"],["か"],["、"],["と"],["言うだろう","ゆうだろう"],["。"]]},{"verse":6,"text":"しかし、もし、人から、と言えば、民衆がみなで私たちを石で打ち殺すだろう。ヨハネを預言者と信じているのだから。」","tok":[["しかし"],["、"],["もし"],["、"],["人","ひと"],["から"],["、"],["と"],["言えば","いえば"],["、"],["民衆","みんしゅう"],["が"],["みな"],["で"],["私たち","わたしたち"],["を"],["石","いし"],["で"],["打ち殺すだろう","うちころすだろう"],["。"],["ヨハネ"],["を"],["預言者","よげんしゃ"],["と"],["信じて","しんじて"],["いる"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":7,"text":"そこで、「どこからか知りません」と答えた。","tok":[["そこ"],["で"],["、"],["「"],["どこ"],["から"],["か"],["知りません","しりません"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":8,"text":"するとイエスは、「わたしも、何の権威によってこれらのことをするのか、あなたがたに話すまい」と言われた。","tok":[["する"],["と"],["イエス"],["は"],["、"],["「"],["わたし"],["も"],["、"],["何","なん"],["の"],["権威","けんい"],["によって"],["これ"],["ら"],["の"],["こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["話すまい","はなすまい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":9,"text":"また、イエスは、民衆にこのようなたとえを話された。／「ある人がぶどう園を造り、それを農夫たちに貸して、長い旅に出た。","tok":[["また"],["、"],["イエス"],["は"],["、"],["民衆","みんしゅう"],["に"],["この"],["よう"],["な"],["たとえ"],["を"],["話された","はなされた"],["。"],["／"],["「"],["ある"],["人","ひと"],["が"],["ぶどう園","ぶどうえん"],["を"],["造り","つくり"],["、"],["それ"],["を"],["農夫","のうふ"],["たち"],["に"],["貸して","かして"],["、"],["長い","ながい"],["旅","たび"],["に"],["出た","でた"],["。"]]},{"verse":10,"text":"そして季節になったので、ぶどう園の収穫の分けまえをもらうために、農夫たちのところへひとりのしもべを遣わした。ところが、農夫たちは、そのしもべを袋だたきにし、何も持たせないで送り帰した。","tok":[["そして"],["季節","きせつ"],["に"],["なった"],["ので"],["、"],["ぶどう園","ぶどうえん"],["の"],["収穫","しゅうかく"],["の"],["分けまえ","わけまえ"],["を"],["もらう"],["ため"],["に"],["、"],["農夫","のうふ"],["たち"],["の"],["ところ"],["へ"],["ひとり"],["の"],["しもべ"],["を"],["遣わした","つかわした"],["。"],["ところ"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["、"],["その"],["しもべ"],["を"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["何","なん"],["も"],["持たせないで","もたせないで"],["送り帰した","おくりかえした"],["。"]]},{"verse":11,"text":"そこで、別のしもべを遣わしたが、彼らは、そのしもべも袋だたきにし、はずかしめたうえで、何も持たせないで送り帰した。","tok":[["そこ"],["で"],["、"],["別","べつ"],["の"],["しもべ"],["を"],["遣わした","つかわした"],["が"],["、"],["彼","かれ"],["ら"],["は"],["、"],["その"],["しもべ"],["も"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["はずかしめた"],["うえ"],["で"],["、"],["何","なん"],["も"],["持たせないで","もたせないで"],["送り帰した","おくりかえした"],["。"]]},{"verse":12,"text":"彼はさらに三人目のしもべをやったが、彼らは、このしもべにも傷を負わせて追い出した。","tok":[["彼","かれ"],["は"],["さらに"],["三人目","さんにんめ"],["の"],["しもべ"],["を"],["やった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["、"],["この"],["しもべ"],["に"],["も"],["傷","きず"],["を"],["負わせて","おわせて"],["追い出した","おいだした"],["。"]]},{"verse":13,"text":"ぶどう園の主人は言った。『どうしたものか。よし、愛する息子を送ろう。彼らも、この子はたぶん敬ってくれるだろう。』","tok":[["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["は"],["言った","いった"],["。"],["『"],["どう"],["した"],["もの"],["か"],["。"],["よし"],["、"],["愛する","あいする"],["息子","むすこ"],["を"],["送ろう","おくろう"],["。"],["彼","かれ"],["ら"],["も"],["、"],["この"],["子","こ"],["は"],["たぶん"],["敬って","うやまって"],["くれるだろう"],["。"],["』"]]},{"verse":14,"text":"ところが、農夫たちはその息子を見て、議論しながら言った。『あれはあと取りだ。あれを殺そうではないか。そうすれば、財産はこちらのものだ。』","tok":[["ところ"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["その"],["息子","むすこ"],["を"],["見て","みて"],["、"],["議論","ぎろん"],["し"],["ながら"],["言った","いった"],["。"],["『"],["あれ"],["は"],["あと"],["取り","とり"],["だ"],["。"],["あれ"],["を"],["殺そうで","ころそうで"],["は"],["ない"],["か"],["。"],["そう"],["すれば"],["、"],["財産","ざいさん"],["は"],["こちら"],["の"],["もの"],["だ"],["。"],["』"]]},{"verse":15,"text":"そして、彼をぶどう園の外に追い出して、殺してしまった。／こうなると、ぶどう園の主人は、どうするでしょう。","tok":[["そして"],["、"],["彼","かれ"],["を"],["ぶどう園","ぶどうえん"],["の"],["外","そと"],["に"],["追い出して","おいだして"],["、"],["殺して","ころして"],["しまった"],["。"],["／"],["こう"],["なる"],["と"],["、"],["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["は"],["、"],["どう"],["するでしょう"],["。"]]},{"verse":16,"text":"彼は戻って来て、この農夫どもを打ち滅ぼし、ぶどう園をほかの人たちに与えてしまいます。」これを聞いた民衆は、「そんなことがあってはなりません」と言った。","tok":[["彼","かれ"],["は"],["戻って","もどって"],["来て","きて"],["、"],["この"],["農夫","のうふ"],["ども"],["を"],["打ち滅ぼし","うちほろぼし"],["、"],["ぶどう園","ぶどうえん"],["を"],["ほか"],["の"],["人","ひと"],["たち"],["に"],["与えて","あたえて"],["しまいます"],["。"],["」"],["これ"],["を"],["聞いた","きいた"],["民衆","みんしゅう"],["は"],["、"],["「"],["そんな"],["こと"],["が"],["あって"],["は"],["なりません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"イエスは、彼らを見つめて言われた。「では、『家を建てる者たちの見捨てた石、それが礎の石となった。』／と書いてあるのは、何のことでしょう。","tok":[["イエス"],["は"],["、"],["彼","かれ"],["ら"],["を"],["見つめて","みつめて"],["言われた","いわれた"],["。"],["「"],["で"],["は"],["、"],["『"],["家","いえ"],["を"],["建てる","たてる"],["者","もの"],["たち"],["の"],["見捨てた","みすてた"],["石","いし"],["、"],["それ"],["が"],["礎","いしずえ"],["の"],["石","いし"],["と"],["なった"],["。"],["』"],["／"],["と"],["書いて","かいて"],["ある"],["の"],["は"],["、"],["何","なん"],["の"],["こと"],["でしょう"],["。"]]},{"verse":18,"text":"この石の上に落ちれば、だれでも粉々に砕け、またこの石が人の上に落ちれば、その人を粉みじんに飛び散らしてしまうのです。」","tok":[["この"],["石","いし"],["の"],["上","うえ"],["に"],["落ちれば","おちれば"],["、"],["だれ"],["で"],["も"],["粉々","こなごな"],["に"],["砕け","くだけ"],["、"],["また"],["この"],["石","いし"],["が"],["人","ひと"],["の"],["上","うえ"],["に"],["落ちれば","おちれば"],["、"],["その"],["人","ひと"],["を"],["粉","こな"],["みじん"],["に"],["飛び散らして","とびちらして"],["しまう"],["の"],["です"],["。"],["」"]]},{"verse":19,"text":"律法学者、祭司長たちは、イエスが自分たちをさしてこのたとえを話されたと気づいたので、この際イエスに手をかけて捕らえようとしたが、やはり民衆を恐れた。","tok":[["律法学者","りっぽうがくしゃ"],["、"],["祭司長","さいしちょう"],["たち"],["は"],["、"],["イエス"],["が"],["自分","じぶん"],["たち"],["を"],["さして"],["この"],["たとえ"],["を"],["話された","はなされた"],["と"],["気づいた","きづいた"],["ので"],["、"],["この"],["際","さい"],["イエス"],["に"],["手","て"],["を"],["かけて"],["捕らえよう","とらえよう"],["と"],["した"],["が"],["、"],["やはり"],["民衆","みんしゅう"],["を"],["恐れた","おそれた"],["。"]]},{"verse":20,"text":"さて、機会をねらっていた彼らは、義人を装った間者を送り、イエスのことばを取り上げて、総督の支配と権威にイエスを引き渡そう、と計った。","tok":[["さて"],["、"],["機会","きかい"],["を"],["ねらって"],["いた"],["彼","かれ"],["ら"],["は"],["、"],["義人","ぎじん"],["を"],["装った","よそおった"],["間者","かんじゃ"],["を"],["送り","おくり"],["、"],["イエス"],["の"],["ことば"],["を"],["取り上げて","とりあげて"],["、"],["総督","そうとく"],["の"],["支配","しはい"],["と"],["権威","けんい"],["に"],["イエス"],["を"],["引き渡そう","ひきわたそう"],["、"],["と"],["計った","はかった"],["。"]]},{"verse":21,"text":"その間者たちは、イエスに質問して言った。「先生。私たちは、あなたがお話しになり、お教えになることは正しく、またあなたは分け隔てなどせず、真理に基づいて神の道を教えておられることを知っています。","tok":[["その"],["間者","かんじゃ"],["たち"],["は"],["、"],["イエス"],["に"],["質問","しつもん"],["して"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["私たち","わたしたち"],["は"],["、"],["あなた"],["が"],["お話し","おはなし"],["に"],["なり"],["、"],["お教え","おおしえ"],["に"],["なる"],["こと"],["は"],["正しく","ただしく"],["、"],["また"],["あなた"],["は"],["分け隔て","わけへだて"],["など"],["せず"],["、"],["真理","しんり"],["に"],["基づいて","もとづいて"],["神","かみ"],["の"],["道","みち"],["を"],["教えて","おしえて"],["おられる"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":22,"text":"ところで、私たちが、カイザルに税金を納めることは、律法にかなっていることでしょうか。かなっていないことでしょうか。」","tok":[["ところ"],["で"],["、"],["私たち","わたしたち"],["が"],["、"],["カイザル"],["に"],["税金","ぜいきん"],["を"],["納める","おさめる"],["こと"],["は"],["、"],["律法","りっぽう"],["に"],["かなって"],["いる"],["こと"],["でしょう"],["か"],["。"],["かなって"],["いない"],["こと"],["でしょう"],["か"],["。"],["」"]]},{"verse":23,"text":"イエスはそのたくらみを見抜いて彼らに言われた。","tok":[["イエス"],["は"],["その"],["たくらみ"],["を"],["見抜いて","みぬいて"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"]]},{"verse":24,"text":"「デナリ銀貨をわたしに見せなさい。これはだれの肖像ですか。だれの銘ですか。」彼らは、「カイザルのです」と言った。","tok":[["「"],["デナリ"],["銀貨","ぎんか"],["を"],["わたし"],["に"],["見せ","みせ"],["なさい"],["。"],["これ"],["は"],["だれ"],["の"],["肖像","しょうぞう"],["です"],["か"],["。"],["だれ"],["の"],["銘","めい"],["です"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["「"],["カイザル"],["の"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":25,"text":"すると彼らに言われた。「では、カイザルのものはカイザルに返しなさい。そして神のものは神に返しなさい。」","tok":[["する"],["と"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["で"],["は"],["、"],["カイザル"],["の"],["もの"],["は"],["カイザル"],["に"],["返し","かえし"],["なさい"],["。"],["そして"],["神","かみ"],["の"],["もの"],["は"],["神","かみ"],["に"],["返し","かえし"],["なさい"],["。"],["」"]]},{"verse":26,"text":"彼らは、民衆の前でイエスのことばじりをつかむことができず、お答えに驚嘆して黙ってしまった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["民衆","みんしゅう"],["の"],["前","まえ"],["で"],["イエス"],["の"],["ことば"],["じり"],["を"],["つかむ"],["こと"],["が"],["できず"],["、"],["お答え","おこたえ"],["に"],["驚嘆","きょうたん"],["して"],["黙って","だまって"],["しまった"],["。"]]},{"verse":27,"text":"ところが、復活があることを否定するサドカイ人のある者たちが、イエスのところに来て、質問して、","tok":[["ところ"],["が"],["、"],["復活","ふっかつ"],["が"],["ある"],["こと"],["を"],["否定","ひてい"],["する"],["サドカイ"],["人","にん"],["の"],["ある"],["者","もの"],["たち"],["が"],["、"],["イエス"],["の"],["ところ"],["に"],["来て","きて"],["、"],["質問","しつもん"],["して"],["、"]]},{"verse":28,"text":"こう言った。「先生。モーセは私たちのためにこう書いています。『もし、ある人の兄が妻をめとって死に、しかも子がなかった場合は、その弟はその女を妻にして、兄のための子をもうけなければならない。』","tok":[["こう"],["言った","いった"],["。"],["「"],["先生","せんせい"],["。"],["モーセ"],["は"],["私たち","わたしたち"],["の"],["ため"],["に"],["こう"],["書いて","かいて"],["います"],["。"],["『"],["もし"],["、"],["ある"],["人","ひと"],["の"],["兄","あに"],["が"],["妻","つま"],["を"],["めとって"],["死に","しに"],["、"],["しかも"],["子","こ"],["が"],["なかった"],["場合","ばあい"],["は"],["、"],["その"],["弟","おとうと"],["は"],["その"],["女","おんな"],["を"],["妻","つま"],["に"],["して"],["、"]
[{"verse":1,"text":"それからイエスは、エリコに入って、町をお通りになった。","tok":[["それ"],["から"],["イエス"],["は"],["、"],["エリコ"],["に"],["入って","はいって"],["、"],["町","まち"],["を"],["お通り","おとおり"],["に"],["なった"],["。"]]},{"verse":2,"text":"ここには、ザアカイという人がいたが、彼は取税人のかしらで、金持ちであった。","tok":[["ここ"],["に"],["は"],["、"],["ザアカイ"],["と"],["いう"],["人","ひと"],["が"],["いた"],["が"],["、"],["彼","かれ"],["は"],["取","とり"],["税人","ぜいにん"],["の"],["かしら"],["で"],["、"],["金持ち","かねもち"],["で"],["あった"],["。"]]},{"verse":3,"text":"彼は、イエスがどんな方か見ようとしたが、背が低かったので、群衆のために見ることができなかった。","tok":[["彼","かれ"],["は"],["、"],["イエス"],["が"],["どんな"],["方","かた"],["か"],["見よう","みよう"],["と"],["した"],["が"],["、"],["背","せ"],["が"],["低かった","ひくかった"],["ので"],["、"],["群衆","ぐんしゅう"],["の"],["ため"],["に"],["見る","みる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":4,"text":"それで、イエスを見るために、前方に走り出て、いちじく桑の木に登った。ちょうどイエスがそこを通り過ぎようとしておられたからである。","tok":[["それ"],["で"],["、"],["イエス"],["を"],["見る","みる"],["ため"],["に"],["、"],["前方","ぜんぽう"],["に"],["走り出て","はしりでて"],["、"],["いちじく"],["桑","くわ"],["の"],["木","き"],["に"],["登った","のぼった"],["。"],["ちょうど"],["イエス"],["が"],["そこ"],["を"],["通り過ぎよう","とおりすぎよう"],["として"],["おられた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"イエスは、ちょうどそこに来られて、上を見上げて彼に言われた。「ザアカイ。急いで降りて来なさい。きょうは、あなたの家に泊まることにしてあるから。」","tok":[["イエス"],["は"],["、"],["ちょうど"],["そこ"],["に"],["来られて","こられて"],["、"],["上","うえ"],["を"],["見上げて","みあげて"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["ザアカイ"],["。"],["急いで","いそいで"],["降りて","おりて"],["来","き"],["なさい"],["。"],["きょう"],["は"],["、"],["あなた"],["の"],["家","いえ"],["に"],["泊まる","とまる"],["こと"],["に"],["して"],["ある"],["から"],["。"],["」"]]},{"verse":6,"text":"ザアカイは、急いで降りて来て、そして大喜びでイエスを迎えた。","tok":[["ザアカイ"],["は"],["、"],["急いで","いそいで"],["降りて","おりて"],["来て","きて"],["、"],["そして"],["大喜び","おおよろこび"],["で"],["イエス"],["を"],["迎えた","むかえた"],["。"]]},{"verse":7,"text":"これを見て、みなは、「あの方は罪人のところに行って客となられた」と言ってつぶやいた。","tok":[["これ"],["を"],["見て","みて"],["、"],["みな"],["は"],["、"],["「"],["あの"],["方","かた"],["は"],["罪人","ざいにん"],["の"],["ところ"],["に"],["行って","いって"],["客","きゃく"],["と"],["なられた"],["」"],["と"],["言って","いって"],["つぶやいた"],["。"]]},{"verse":8,"text":"ところがザアカイは立って、主に言った。「主よ。ご覧ください。私の財産の半分を貧しい人たちに施します。また、だれからでも、私がだまし取った物は、四倍にして返します。」","tok":[["ところ"],["が"],["ザアカイ"],["は"],["立って","たって"],["、"],["主に","おもに"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["。"],["ご覧","ごらん"],["ください"],["。"],["私","わたくし"],["の"],["財産","ざいさん"],["の"],["半分","はんぶん"],["を"],["貧しい","まずしい"],["人","ひと"],["たち"],["に"],["施します","ほどこします"],["。"],["また"],["、"],["だれ"],["から"],["で"],["も"],["、"],["私","わたくし"],["が"],["だまし取った","だましとった"],["物","もの"],["は"],["、"],["四","よん"],["倍","ばい"],["に"],["して"],["返します","かえします"],["。"],["」"]]},{"verse":9,"text":"イエスは、彼に言われた。「きょう、救いがこの家に来ました。この人もアブラハムの子なのですから。","tok":[["イエス"],["は"],["、"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["きょう"],["、"],["救い","すくい"],["が"],["この"],["家","いえ"],["に"],["来ました","きました"],["。"],["この"],["人","ひと"],["も"],["アブラハム"],["の"],["子","こ"],["な"],["の"],["です"],["から"],["。"]]},{"verse":10,"text":"人の子は、失われた人を捜して救うために来たのです。」","tok":[["人","ひと"],["の"],["子","こ"],["は"],["、"],["失われた","うしなわれた"],["人","ひと"],["を"],["捜して","さがして"],["救う","すくう"],["ため"],["に"],["来た","きた"],["の"],["です"],["。"],["」"]]},{"verse":11,"text":"人々がこれらのことに耳を傾けているとき、イエスは、続けて一つのたとえを話された。それは、イエスがエルサレムに近づいておられ、そのため人々は神の国がすぐにでも現れるように思っていたからである。","tok":[["人々","ひとびと"],["が"],["これ"],["ら"],["の"],["こと"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["いる"],["とき"],["、"],["イエス"],["は"],["、"],["続けて","つづけて"],["一","ひと"],["つ"],["の"],["たとえ"],["を"],["話された","はなされた"],["。"],["それ"],["は"],["、"],["イエス"],["が"],["エルサレム"],["に"],["近づいて","ちかづいて"],["おられ"],["、"],["その"],["ため"],["人々","ひとびと"],["は"],["神","かみ"],["の"],["国","くに"],["が"],["すぐ"],["に"],["で"],["も"],["現れる","あらわれる"],["よう"],["に"],["思って","おもって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"それで、イエスはこう言われた。／「ある身分の高い人が、遠い国に行った。王位を受けて帰るためであった。","tok":[["それ"],["で"],["、"],["イエス"],["は"],["こう"],["言われた","いわれた"],["。"],["／"],["「"],["ある"],["身分","みぶん"],["の"],["高い","たかい"],["人","ひと"],["が"],["、"],["遠い","とおい"],["国","くに"],["に"],["行った","いった"],["。"],["王位","おうい"],["を"],["受けて","うけて"],["帰る","かえる"],["ため"],["で"],["あった"],["。"]]},{"verse":13,"text":"彼は自分の十人のしもべを呼んで、十ミナを与え、彼らに言った。『私が帰るまで、これで商売しなさい。』","tok":[["彼","かれ"],["は"],["自分","じぶん"],["の"],["十人","じゅうにん"],["の"],["しもべ"],["を"],["呼んで","よんで"],["、"],["十","じゅう"],["ミナ"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["『"],["私","わたくし"],["が"],["帰る","かえる"],["まで"],["、"],["これ"],["で"],["商売","しょうばい"],["し"],["なさい"],["。"],["』"]]},{"verse":14,"text":"しかし、その国民たちは、彼を憎んでいたので、あとから使いをやり、『この人に、私たちの王にはなってもらいたくありません』と言った。","tok":[["しかし"],["、"],["その"],["国民","こくみん"],["たち"],["は"],["、"],["彼","かれ"],["を"],["憎んで","にくんで"],["いた"],["ので"],["、"],["あと"],["から"],["使い","つかい"],["を"],["やり"],["、"],["『"],["この"],["人","ひと"],["に"],["、"],["私たち","わたしたち"],["の"],["王","おう"],["に"],["は"],["なって"],["もらいたく"],["ありません"],["』"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"さて、彼が王位を受けて帰って来たとき、金を与えておいたしもべたちがどんな商売をしたかを知ろうと思い、彼らを呼び出すように言いつけた。","tok":[["さて"],["、"],["彼","かれ"],["が"],["王位","おうい"],["を"],["受けて","うけて"],["帰って","かえって"],["来た","きた"],["とき"],["、"],["金","きん"],["を"],["与えて","あたえて"],["おいた"],["しもべ"],["たち"],["が"],["どんな"],["商売","しょうばい"],["を"],["した"],["か"],["を"],["知ろう","しろう"],["と"],["思い","おもい"],["、"],["彼","かれ"],["ら"],["を"],["呼び出す","よびだす"],["よう"],["に"],["言いつけた","いいつけた"],["。"]]},{"verse":16,"text":"さて、最初の者が現れて言った。『ご主人さま。あなたの一ミナで、十ミナをもうけました。』","tok":[["さて"],["、"],["最初","さいしょ"],["の"],["者","もの"],["が"],["現れて","あらわれて"],["言った","いった"],["。"],["『"],["ご主人","ごしゅじん"],["さま"],["。"],["あなた"],["の"],["一","いち"],["ミナ"],["で"],["、"],["十","じゅう"],["ミナ"],["を"],["もうけました"],["。"],["』"]]},{"verse":17,"text":"主人は彼に言った。『よくやった。良いしもべだ。あなたはほんの小さな事にも忠実だったから、十の町を支配する者になりなさい。』","tok":[["主人","しゅじん"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["『"],["よく"],["やった"],["。"],["良い","よい"],["しもべ"],["だ"],["。"],["あなた"],["は"],["ほんの"],["小さな","ちいさな"],["事","こと"],["に"],["も"],["忠実","ちゅうじつ"],["だった"],["から"],["、"],["十","じゅう"],["の"],["町","まち"],["を"],["支配","しはい"],["する"],["者","もの"],["に"],["なり"],["なさい"],["。"],["』"]]},{"verse":18,"text":"二番目の者が来て言った。『ご主人さま。あなたの一ミナで、五ミナをもうけました。』","tok":[["二番目","にばんめ"],["の"],["者","もの"],["が"],["来て","きて"],["言った","いった"],["。"],["『"],["ご主人","ごしゅじん"],["さま"],["。"],["あなた"],["の"],["一","いち"],["ミナ"],["で"],["、"],["五","ご"],["ミナ"],["を"],["もうけました"],["。"],["』"]]},{"verse":19,"text":"主人はこの者にも言った。『あなたも五つの町を治めなさい。』","tok":[["主人","しゅじん"],["は"],["この"],["者","もの"],["に"],["も"],["言った","いった"],["。"],["『"],["あなた"],["も"],["五","いつ"],["つ"],["の"],["町","まち"],["を"],["治め","おさめ"],["なさい"],["。"],["』"]]},{"verse":20,"text":"もうひとりが来て言った。『ご主人さま。さあ、ここにあなたの一ミナがございます。私はふろしきに包んでしまっておきました。","tok":[["もう"],["ひとり"],["が"],["来て","きて"],["言った","いった"],["。"],["『"],["ご主人","ごしゅじん"],["さま"],["。"],["さあ"],["、"],["ここ"],["に"],["あなた"],["の"],["一","いち"],["ミナ"],["が"],["ございます"],["。"],["私","わたくし"],["は"],["ふろしき"],["に"],["包んで","つつんで"],["しまって"],["おきました"],["。"]]},{"verse":21,"text":"あなたは計算の細かい、きびしい方ですから、恐ろしゅうございました。あなたはお預けにならなかったものをも取り立て、お蒔きにならなかったものをも刈り取る方ですから。』","tok":[["あなた"],["は"],["計算","けいさん"],["の"],["細かい","こまかい"],["、"],["きびしい"],["方","ほう"],["です"],["から"],["、"],["恐ろしゅう","おそろしゅう"],["ございました"],["。"],["あなた"],["は"],["お預け","おあずけ"],["に"],["ならなかった"],["もの"],["を"],["も"],["取り立て","とりたて"],["、"],["お蒔き","おまき"],["に"],["ならなかった"],["もの"],["を"],["も"],["刈り取る","かりとる"],["方","ほう"],["です"],["から"],["。"],["』"]]},{"verse":22,"text":"主人はそのしもべに言った。『悪いしもべだ。私はあなたのことばによって、あなたをさばこう。あなたは、私が預けなかったものを取り立て、蒔かなかったものを刈り取るきびしい人間だと知っていた、というのか。","tok":[["主人","しゅじん"],["は"],["その"],["しもべ"],["に"],["言った","いった"],["。"],["『"],["悪い","わるい"],["しもべ"],["だ"],["。"],["私","わたくし"],["は"],["あなた"],["の"],["ことば"],["によって"],["、"],["あなた"],["を"],["さばこう"],["。"],["あなた"],["は"],["、"],["私","わたくし"],["が"],["預けなかった","あずけなかった"],["もの"],["を"],["取り立て","とりたて"],["、"],["蒔かなかった","まかなかった"],["もの"],["を"],["刈り取る","かりとる"],["きびしい"],["人間","にんげん"],["だ"],["と"],["知って","しって"],["いた"],["、"],["と"],["いう"],["の"],["か"],["。"]]},{"verse":23,"text":"だったら、なぜ私の金を銀行に預けておかなかったのか。そうすれば私は帰って来たときに、それを利息といっしょに受け取れたはずだ。』","tok":[["だったら"],["、"],["なぜ"],["私","わたくし"],["の"],["金","かね"],["を"],["銀行","ぎんこう"],["に"],["預けて","あずけて"],["おかなかった"],["の"],["か"],["。"],["そう"],["すれば"],["私","わたくし"],["は"],["帰って","かえって"],["来た","きた"],["とき"],["に"],["、"],["それ"],["を"],["利息","りそく"],["と"],["いっしょ"],["に"],["受け取れた","うけとれた"],["はず"],["だ"],["。"],["』"]]},{"verse":24,"text":"そして、そばに立っていた者たちに言った。『その一ミナを彼から取り上げて、十ミナ持っている人にやりなさい。』","tok":[["そして"],["、"],["そば"],["に"],["立って","たって"],["いた"],["者","もの"],["たち"],["に"],["言った","いった"],["。"],["『"],["その"],["一","いち"],["ミナ"],["を"],["彼","かれ"],["から"],["取り上げて","とりあげて"],["、"],["十","じゅう"],["ミナ"],["持って","もって"],["いる"],["人","ひと"],["に"],["やり"],["なさい"],["。"],["』"]]},{"verse":25,"text":"すると彼らは、『ご主人さま。その人は十ミナも持っています』と言った。","tok":[["する"],["と"],["彼","かれ"],["ら"],["は"],["、"],["『"],["ご主人","ごしゅじん"],["さま"],["。"],["その"],["人","ひと"],["は"],["十","じゅう"],["ミナ"],["も"],["持って","もって"],["います"],["』"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"彼は言った。『あなたがたに言うが、だれでも持っている者は、さらに与えられ、持たない者からは、持っている物までも取り上げられるのです。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["『"],["あなた"],["がた"],["に"],["言う","ゆう"],["が"],["、"],["だれ"],["で"],["も"],["持って","もって"],["いる"],["者","もの"],["は"],["、"],["さらに"],["与えられ","あたえられ"],["、"],["持たない","もたない"],["者","もの"],["から"],["は"],["、"],["持って","もって"],["いる"],["物","もの"],["まで"],["も"],["取り上げられる","とりあげられる"],["の"],["です"],["。"]]},{"verse":27,"text":"ただ、私が王になるのを望まなかったこの敵どもは、みなここに連れて来て、私の目の前で殺してしまえ。』」","tok":[["ただ"],["、"],["私","わたくし"],["が"],["王","おう"],["に"],["なる"],["の"],["を"],["望まなかった","のぞまなかった"],["この"],["敵","てき"],["ども"],["は"],["、"],["みな"],["ここ"],["に"],["連れて","つれて"],["来て","きて"],["、"],["私","わたくし"],["の"],["目","め"],["の"],["前","まえ"],["で"],["殺して","ころして"],["しまえ"],["。"],["』"],["」"]]},{"verse":28,"text":"これらのことを話して後、イエスは、さらに進んで、エルサレムへと上って行かれた。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["話して","はなして"],["後","あと"],["、"],["イエス"],["は"],["、"],["さらに"],["進んで","すすんで"],["、"],["エルサレム"],["へ"],["と"],["上って","のぼって"],["行かれた","いかれた"],["。"]]},{"verse":29,"text":"オリーブという山のふもとのベテパゲとベタニヤに近づかれたとき、イエスはふたりの弟子を使いに出して、","tok":[["オリーブ"],["と"],["いう"],["山","やま"],["の"],["ふもと"],["の"],["ベテパゲ"],["と"],["ベタニヤ"],["に"],["近づかれた","ちかづかれた"],["とき"],["、"],["イエス"],["は"],["ふたり"],["の"],["弟子","でし"],["を"],["使い","つかい"],["に"],["出して","だして"],["、"]]},{"verse":30,"text":"言われた。「向こうの村に行きなさい。そこに入ると、まだだれも乗ったことのない、ろばの子がつないであるのに気がつくでしょう。それをほどいて連れて来なさい。","tok":[["言われた","いわれた"],["。"],["「"],["向こう","むこう"],["の"],["村","むら"],["に"],["行き","いき"],["なさい"],["。"],["そこ"],["に"],["入る","はいる"],["と"],["、"],["まだ"],["だれ"],["も"],["乗った","のった"],["こと"],["の"],["ない"],["、"],["ろば"],["の"],["子","こ"],["が"],["つないで"],["ある"],["のに"],["気","き"],["が"],["つくでしょう"],["。"],["それ"],["を"],["ほどいて"],["連れて","つれて"],["来","き"],["なさい"],["。"]]},{"verse":31,"text":"もし、『なぜ、ほどくのか』と尋ねる人があったら、こう言いなさい。『主がお入用なのです。』」","tok":[["もし"],["、"],["『"],["なぜ"],["、"],["ほどく"],["の"],["か"],["』"],["と"],["尋ねる","たずねる"],["人","ひと"],["が"],["あったら"],["、"],["こう"],["言い","いい"],["なさい"],["。"],["『"],["主","ぬし"],["が"],["お入用","おにゅうよう"],["な"],["の"],["です"],["。"],["』"],["」"]]},{"verse":32,"text":"使いに出されたふたりが行って見ると、イエスが話されたとおりであった。","tok":[["使い","つかい"],["に"],["出された","だされた"],["ふたり"],["が"],["行って","いって"],["見る","みる"],["と"],["、"],["イエス"],["が"],["話された","はなされた"],["とおり"],["で"],["あった"],["。"]]},{"verse":33,"text":"彼らがろばの子をほどいていると、その持ち主が、「なぜ、このろばの子をほどくのか」と彼らに言った。","tok":[["彼","かれ"],["ら"],["が"],["ろば"],["の"],["子","こ"],["を"],["ほどいて"],["いる"],["と"],["、"],["その"],["持ち主","もちぬし"],["が"],["、"],["「"],["なぜ"],["、"],["この"],["ろば"],["の"],["子","こ"],["を"],["ほどく"],["の"],["か"],["」"],["と"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"]]},{"verse":34,"text":"弟子たちは、「主がお入用なのです」と言った。","tok":[["弟子","でし"],["たち"],["は"],["、"],["「"],["主","ぬし"],["が"],["お入用","おにゅうよう"],["な"],["の"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":35,"text":"そしてふたりは、それをイエスのもとに連れて来た。そして、そのろばの子の上に自分たちの上着を敷いて、イエスをお乗せした。","tok":[["そして"],["ふたり"],["は"],["、"],["それ"],["を"],["イエス"],["の"],["もと"],["に"],["連れて","つれて"],["来た","きた"],["。"],["そして"],["、"],["その"],["ろば"],["の"],["子","こ"],["の"],["上","うえ"],["に"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["敷いて","しいて"],["、"],["イエス"],["を"],["お乗せ","おのせ"],["した"],["。"]]},{"verse":36,"text":"イエスが進んで行かれると、人々は道に自分たちの上着を敷いた。","tok":[["イエス"],["が"],["進んで","すすんで"],["行かれる","いかれる"],["と"],["、"],["人々","ひとびと"],["は"],["道","みち"],["に"],["自分","じぶん"],["たち"],["の"],["上着","うわぎ"],["を"],["敷いた","しいた"],["。"]]},{"verse":37,"text":"イエスがすでにオリーブ山のふもとに近づかれたとき、弟子たちの群れはみな、自分たちの見たすべての力あるわざのことで、喜んで大声に神を賛美し始め、
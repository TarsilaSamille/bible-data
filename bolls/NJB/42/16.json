[{"verse":1,"text":"イエスは、弟子たちにも、こういう話をされた。／「ある金持ちにひとりの管理人がいた。この管理人が主人の財産を乱費している、という訴えが出された。","tok":[["イエス"],["は"],["、"],["弟子","でし"],["たち"],["に"],["も"],["、"],["こう"],["いう"],["話","はなし"],["を"],["された"],["。"],["／"],["「"],["ある"],["金持ち","かねもち"],["に"],["ひとり"],["の"],["管理人","かんりにん"],["が"],["いた"],["。"],["この"],["管理人","かんりにん"],["が"],["主人","しゅじん"],["の"],["財産","ざいさん"],["を"],["乱費","らんぴ"],["して"],["いる"],["、"],["と"],["いう"],["訴え","うったえ"],["が"],["出された","だされた"],["。"]]},{"verse":2,"text":"主人は、彼を呼んで言った。『おまえについてこんなことを聞いたが、何ということをしてくれたのだ。もう管理を任せておくことはできないから、会計の報告を出しなさい。』","tok":[["主人","しゅじん"],["は"],["、"],["彼","かれ"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["『"],["おまえ"],["について"],["こんな"],["こと"],["を"],["聞いた","きいた"],["が"],["、"],["何","なん"],["と"],["いう"],["こと"],["を"],["して"],["くれた"],["の"],["だ"],["。"],["もう"],["管理","かんり"],["を"],["任せて","まかせて"],["おく"],["こと"],["は"],["できない"],["から"],["、"],["会計","かいけい"],["の"],["報告","ほうこく"],["を"],["出し","だし"],["なさい"],["。"],["』"]]},{"verse":3,"text":"管理人は心の中で言った。『主人にこの管理の仕事を取り上げられるが、さてどうしよう。土を掘るには力がないし、物ごいをするのは恥ずかしいし。","tok":[["管理人","かんりにん"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["言った","いった"],["。"],["『"],["主人","しゅじん"],["に"],["この"],["管理","かんり"],["の"],["仕事","しごと"],["を"],["取り上げられる","とりあげられる"],["が"],["、"],["さて"],["どう"],["しよう"],["。"],["土","つち"],["を"],["掘る","ほる"],["に"],["は"],["力","ちから"],["が"],["ない"],["し"],["、"],["物ごい","ものごい"],["を"],["する"],["の"],["は"],["恥ずかしい","はずかしい"],["し"],["。"]]},{"verse":4,"text":"ああ、わかった。こうしよう。こうしておけば、いつ管理の仕事をやめさせられても、人がその家に私を迎えてくれるだろう。』","tok":[["ああ"],["、"],["わかった"],["。"],["こう"],["しよう"],["。"],["こう"],["して"],["おけば"],["、"],["いつ"],["管理","かんり"],["の"],["仕事","しごと"],["を"],["やめさせられて"],["も"],["、"],["人","ひと"],["が"],["その"],["家","いえ"],["に"],["私","わたくし"],["を"],["迎えて","むかえて"],["くれるだろう"],["。"],["』"]]},{"verse":5,"text":"そこで彼は、主人の債務者たちをひとりひとり呼んで、まず最初の者に、『私の主人に、いくら借りがありますか』と言うと、","tok":[["そこ"],["で"],["彼","かれ"],["は"],["、"],["主人","しゅじん"],["の"],["債務者","さいむしゃ"],["たち"],["を"],["ひとりひとり"],["呼んで","よんで"],["、"],["まず"],["最初","さいしょ"],["の"],["者","もの"],["に"],["、"],["『"],["私","わたくし"],["の"],["主人","しゅじん"],["に"],["、"],["いくら"],["借り","かり"],["が"],["あります"],["か"],["』"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":6,"text":"その人は、『油百バテ』と言った。すると彼は、『さあ、あなたの証文だ。すぐにすわって五十と書きなさい』と言った。","tok":[["その"],["人","ひと"],["は"],["、"],["『"],["油","あぶら"],["百","ひゃく"],["バテ"],["』"],["と"],["言った","いった"],["。"],["する"],["と"],["彼","かれ"],["は"],["、"],["『"],["さあ"],["、"],["あなた"],["の"],["証文","しょうもん"],["だ"],["。"],["すぐ"],["に"],["すわって"],["五十","ごじゅう"],["と"],["書き","かき"],["なさい"],["』"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"それから、別の人に、『さて、あなたは、いくら借りがありますか』と言うと、『小麦百コル』と言った。彼は、『さあ、あなたの証文だ。八十と書きなさい』と言った。","tok":[["それ"],["から"],["、"],["別","べつ"],["の"],["人","ひと"],["に"],["、"],["『"],["さて"],["、"],["あなた"],["は"],["、"],["いくら"],["借り","かり"],["が"],["あります"],["か"],["』"],["と"],["言う","ゆう"],["と"],["、"],["『"],["小麦","こむぎ"],["百","ひゃく"],["コル"],["』"],["と"],["言った","いった"],["。"],["彼","かれ"],["は"],["、"],["『"],["さあ"],["、"],["あなた"],["の"],["証文","しょうもん"],["だ"],["。"],["八十","やそ"],["と"],["書き","かき"],["なさい"],["』"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"この世の子らは、自分たちの世のことについては、光の子らよりも抜けめがないものなので、主人は、不正な管理人がこうも抜けめなくやったのをほめた。","tok":[["この世","このよ"],["の"],["子","こ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["世","よ"],["の"],["こと"],["について"],["は"],["、"],["光","ひかり"],["の"],["子","こ"],["ら"],["より"],["も"],["抜けめ","ぬけめ"],["が"],["ない"],["もの"],["な"],["ので"],["、"],["主人","しゅじん"],["は"],["、"],["不正","ふせい"],["な"],["管理人","かんりにん"],["が"],["こう"],["も"],["抜けめ","ぬけめ"],["なく"],["やった"],["の"],["を"],["ほめた"],["。"]]},{"verse":9,"text":"そこで、わたしはあなたがたに言いますが、不正の富で、自分のために友をつくりなさい。そうしておけば、富がなくなったとき、彼らはあなたがたを、永遠の住まいに迎えるのです。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["言います","いいます"],["が"],["、"],["不正","ふせい"],["の"],["富","とみ"],["で"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["友","とも"],["を"],["つくり"],["なさい"],["。"],["そう"],["して"],["おけば"],["、"],["富","とみ"],["が"],["なくなった"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["を"],["、"],["永遠","えいえん"],["の"],["住まい","すまい"],["に"],["迎える","むかえる"],["の"],["です"],["。"]]},{"verse":10,"text":"小さい事に忠実な人は、大きい事にも忠実であり、小さい事に不忠実な人は、大きい事にも不忠実です。","tok":[["小さい","ちいさい"],["事","こと"],["に"],["忠実","ちゅうじつ"],["な"],["人","ひと"],["は"],["、"],["大きい","おおきい"],["事","こと"],["に"],["も"],["忠実","ちゅうじつ"],["で"],["あり"],["、"],["小さい","ちいさい"],["事","こと"],["に"],["不","ふ"],["忠実","ちゅうじつ"],["な"],["人","ひと"],["は"],["、"],["大きい","おおきい"],["事","こと"],["に"],["も"],["不","ふ"],["忠実","ちゅうじつ"],["です"],["。"]]},{"verse":11,"text":"ですから、あなたがたが不正の富に忠実でなかったら、だれがあなたがたに、まことの富を任せるでしょう。","tok":[["です"],["から"],["、"],["あなた"],["がた"],["が"],["不正","ふせい"],["の"],["富","とみ"],["に"],["忠実","ちゅうじつ"],["で"],["なかったら"],["、"],["だれ"],["が"],["あなた"],["がた"],["に"],["、"],["まこと"],["の"],["富","とみ"],["を"],["任せるでしょう","まかせるでしょう"],["。"]]},{"verse":12,"text":"また、あなたがたが他人のものに忠実でなかったら、だれがあなたがたに、あなたがたのものを持たせるでしょう。","tok":[["また"],["、"],["あなた"],["がた"],["が"],["他人","たにん"],["の"],["もの"],["に"],["忠実","ちゅうじつ"],["で"],["なかったら"],["、"],["だれ"],["が"],["あなた"],["がた"],["に"],["、"],["あなた"],["がた"],["の"],["もの"],["を"],["持たせるでしょう","もたせるでしょう"],["。"]]},{"verse":13,"text":"しもべは、ふたりの主人に仕えることはできません。一方を憎んで他方を愛したり、または一方を重んじて他方を軽んじたりするからです。あなたがたは、神にも仕え、また富にも仕えるということはできません。」","tok":[["しもべ"],["は"],["、"],["ふたり"],["の"],["主人","しゅじん"],["に"],["仕える","つかえる"],["こと"],["は"],["できません"],["。"],["一方","いっぽう"],["を"],["憎んで","にくんで"],["他方","たほう"],["を"],["愛し","あいし"],["たり"],["、"],["また"],["は"],["一方","いっぽう"],["を"],["重んじて","おもんじて"],["他方","たほう"],["を"],["軽んじ","かろんじ"],["たり"],["する"],["から"],["です"],["。"],["あなた"],["がた"],["は"],["、"],["神","かみ"],["に"],["も"],["仕え","つかえ"],["、"],["また"],["富","とみ"],["に"],["も"],["仕える","つかえる"],["と"],["いう"],["こと"],["は"],["できません"],["。"],["」"]]},{"verse":14,"text":"さて、金の好きなパリサイ人たちが、一部始終を聞いて、イエスをあざ笑っていた。","tok":[["さて"],["、"],["金","きん"],["の"],["好き","すき"],["な"],["パリサイ"],["人","にん"],["たち"],["が"],["、"],["一部","いちぶ"],["始終","しじゅう"],["を"],["聞いて","きいて"],["、"],["イエス"],["を"],["あざ笑って","あざわらって"],["いた"],["。"]]},{"verse":15,"text":"イエスは彼らに言われた。「あなたがたは、人の前で自分を正しいとする者です。しかし神は、あなたがたの心をご存じです。人間の間であがめられるものは、神の前で憎まれ、きらわれます。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["人","ひと"],["の"],["前","まえ"],["で"],["自分","じぶん"],["を"],["正しい","ただしい"],["と"],["する"],["者","もの"],["です"],["。"],["しかし"],["神","かみ"],["は"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["ご存じ","ごぞんじ"],["です"],["。"],["人間","にんげん"],["の"],["間","あいだ"],["で"],["あがめられる"],["もの"],["は"],["、"],["神","かみ"],["の"],["前","まえ"],["で"],["憎まれ","にくまれ"],["、"],["きらわれます"],["。"]]},{"verse":16,"text":"律法と預言者はヨハネまでです。それ以来、神の国の福音は宣べ伝えられ、だれもかれも、無理にでも、これに入ろうとしています。","tok":[["律法","りっぽう"],["と"],["預言者","よげんしゃ"],["は"],["ヨハネ"],["まで"],["です"],["。"],["それ"],["以来","いらい"],["、"],["神","かみ"],["の"],["国","くに"],["の"],["福音","ふくいん"],["は"],["宣べ伝えられ","のべつたえられ"],["、"],["だれ"],["も"],["かれ"],["も"],["、"],["無理","むり"],["に"],["で"],["も"],["、"],["これ"],["に"],["入ろう","はいろう"],["として"],["います"],["。"]]},{"verse":17,"text":"しかし律法の一画が落ちるよりも、天地の滅びるほうがやさしいのです。","tok":[["しかし"],["律法","りっぽう"],["の"],["一画","いっかく"],["が"],["落ちる","おちる"],["より"],["も"],["、"],["天地","てんち"],["の"],["滅びる","ほろびる"],["ほう"],["が"],["やさしい"],["の"],["です"],["。"]]},{"verse":18,"text":"だれでも妻を離別してほかの女と結婚する者は、姦淫を犯す者であり、また、夫から離別された女と結婚する者も、姦淫を犯す者です。","tok":[["だれ"],["で"],["も"],["妻","つま"],["を"],["離別","りべつ"],["して"],["ほか"],["の"],["女","おんな"],["と"],["結婚","けっこん"],["する"],["者","もの"],["は"],["、"],["姦淫","かんいん"],["を"],["犯す","おかす"],["者","もの"],["で"],["あり"],["、"],["また"],["、"],["夫","おっと"],["から"],["離別","りべつ"],["された"],["女","おんな"],["と"],["結婚","けっこん"],["する"],["者","もの"],["も"],["、"],["姦淫","かんいん"],["を"],["犯す","おかす"],["者","もの"],["です"],["。"]]},{"verse":19,"text":"ある金持ちがいた。いつも紫の衣や細布を着て、毎日ぜいたくに遊び暮らしていた。","tok":[["ある"],["金持ち","かねもち"],["が"],["いた"],["。"],["いつも"],["紫","むらさき"],["の"],["衣","ころも"],["や"],["細布","ほそめ"],["を"],["着て","きて"],["、"],["毎日","まいにち"],["ぜいたく"],["に"],["遊び暮らして","あそびくらして"],["いた"],["。"]]},{"verse":20,"text":"ところが、その門前にラザロという全身おできの貧しい人が寝ていて、","tok":[["ところ"],["が"],["、"],["その"],["門前","もんぜん"],["に"],["ラザロ"],["と"],["いう"],["全身","ぜんしん"],["おでき"],["の"],["貧しい","まずしい"],["人","ひと"],["が"],["寝て","ねて"],["いて"],["、"]]},{"verse":21,"text":"金持ちの食卓から落ちる物で腹を満たしたいと思っていた。犬もやって来ては、彼のおできをなめていた。","tok":[["金持ち","かねもち"],["の"],["食卓","しょくたく"],["から"],["落ちる","おちる"],["物","もの"],["で"],["腹","はら"],["を"],["満たしたい","みたしたい"],["と"],["思って","おもって"],["いた"],["。"],["犬","いぬ"],["も"],["やって"],["来て","きて"],["は"],["、"],["彼","かれ"],["の"],["おでき"],["を"],["なめて"],["いた"],["。"]]},{"verse":22,"text":"さて、この貧しい人は死んで、御使いたちによってアブラハムのふところに連れて行かれた。金持ちも死んで葬られた。","tok":[["さて"],["、"],["この"],["貧しい","まずしい"],["人","ひと"],["は"],["死んで","しんで"],["、"],["御使い","おつかい"],["たち"],["によって"],["アブラハム"],["の"],["ふところ"],["に"],["連れて","つれて"],["行かれた","いかれた"],["。"],["金持ち","かねもち"],["も"],["死んで","しんで"],["葬られた","ほうむられた"],["。"]]},{"verse":23,"text":"その金持ちは、ハデスで苦しみながら目を上げると、アブラハムが、はるかかなたに見えた。しかも、そのふところにラザロが見えた。","tok":[["その"],["金持ち","かねもち"],["は"],["、"],["ハデス"],["で"],["苦しみ","くるしみ"],["ながら"],["目","め"],["を"],["上げる","あげる"],["と"],["、"],["アブラハム"],["が"],["、"],["はるか"],["かなた"],["に"],["見えた","みえた"],["。"],["しかも"],["、"],["その"],["ふところ"],["に"],["ラザロ"],["が"],["見えた","みえた"],["。"]]},{"verse":24,"text":"彼は叫んで言った。『父アブラハムさま。私をあわれんでください。ラザロが指先を水に浸して私の舌を冷やすように、ラザロをよこしてください。私はこの炎の中で、苦しくてたまりません。』","tok":[["彼","かれ"],["は"],["叫んで","さけんで"],["言った","いった"],["。"],["『"],["父","ちち"],["アブラハム"],["さま"],["。"],["私","わたくし"],["を"],["あわれんで"],["ください"],["。"],["ラザロ"],["が"],["指先","ゆびさき"],["を"],["水","みず"],["に"],["浸して","ひたして"],["私","わたくし"],["の"],["舌","した"],["を"],["冷やす","ひやす"],["よう"],["に"],["、"],["ラザロ"],["を"],["よこして"],["ください"],["。"],["私","わたくし"],["は"],["この"],["炎","ほのお"],["の"],["中","なか"],["で"],["、"],["苦しくて","くるしくて"],["たまりません"],["。"],["』"]]},{"verse":25,"text":"アブラハムは言った。『子よ。思い出してみなさい。おまえは生きている間、良い物を受け、ラザロは生きている間、悪い物を受けていました。しかし、今ここで彼は慰められ、おまえは苦しみもだえているのです。","tok":[["アブラハム"],["は"],["言った","いった"],["。"],["『"],["子","こ"],["よ"],["。"],["思い出して","おもいだして"],["み"],["なさい"],["。"],["おまえ"],["は"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["良い","よい"],["物","もの"],["を"],["受け","うけ"],["、"],["ラザロ"],["は"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["悪い","わるい"],["物","もの"],["を"],["受けて","うけて"],["いました"],["。"],["しかし"],["、"],["今","いま"],["ここ"],["で"],["彼","かれ"],["は"],["慰められ","なぐさめられ"],["、"],["おまえ"],["は"],["苦しみもだえて","くるしみもだえて"],["いる"],["の"],["です"],["。"]]},{"verse":26,"text":"そればかりでなく、私たちとおまえたちの間には、大きな淵があります。ここからそちらへ渡ろうとしても、渡れないし、そこからこちらへ越えて来ることもできないのです。』","tok":[["それ"],["ばかり"],["で"],["なく"],["、"],["私たち","わたしたち"],["と"],["おまえ"],["たち"],["の"],["間","あいだ"],["に"],["は"],["、"],["大きな","おおきな"],["淵","ふち"],["が"],["あります"],["。"],["ここ"],["から"],["そちら"],["へ"],["渡ろう","わたろう"],["として"],["も"],["、"],["渡れない","わたれない"],["し"],["、"],["そこ"],["から"],["こちら"],["へ"],["越えて","こえて"],["来る","くる"],["こと"],["も"],["できない"],["の"],["です"],["。"],["』"]]},{"verse":27,"text":"彼は言った。『父よ。ではお願いです。ラザロを私の父の家に送ってください。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["『"],["父","ちち"],["よ"],["。"],["で"],["は"],["お願い","おねがい"],["です"],["。"],["ラザロ"],["を"],["私","わたくし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["送って","おくって"],["ください"],["。"]]},{"verse":28,"text":"私には兄弟が五人ありますが、彼らまでこんな苦しみの場所に来ることのないように、よく言い聞かせてください。』","tok":[["私","わたくし"],["に"],["は"],["兄弟","きょうだい"],["が"],["五人","ごにん"],["あります"],["が"],["、"],["彼","かれ"],["ら"],["まで"],["こんな"],["苦しみ","くるしみ"],["の"],["場所","ばしょ"],["に"],["来る","くる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["よく"],["言い聞かせて","いいきかせて"],["ください"],["。"],["』"]]},{"verse":29,"text":"しかしアブラハムは言った。『彼らには、モーセと預言者があります。その言うことを聞くべきです。』","tok":[["しかし"],["アブラハム"],["は"],["言った","いった"],["。"],["『"],["彼","かれ"],["ら"],["に"],["は"],["、"],["モーセ"],["と"],["預言者","よげんしゃ"],["が"],["あります"],["。"],["その"],["言う","いう"],["こと"],["を"],["聞くべきです","きくべきです"],["。"],["』"]]},{"verse":30,"text":"彼は言った。『いいえ、父アブラハム。もし、だれかが死んだ者の中から彼らのところに行ってやったら、彼らは悔い改めるに違いありません。』","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["『"],["いいえ"],["、"],["父","ちち"],["アブラハム"],["。"],["もし"],["、"],["だれ"],["か"],["が"],["死んだ","しんだ"],["者","もの"],["の"],["中","なか"],["から"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["行って","いって"],["やったら"],["、"],["彼","かれ"],["ら"],["は"],["悔い改める","くいあらためる"],["に"],["違い","ちがい"],["ありません"],["。"],["』"]]},{"verse":31,"text":"アブラハムは彼に言った。『もしモーセと預言者との教えに耳を傾けないのなら、たといだれかが死人の中から生き返っても、彼らは聞き入れはしない。』」","tok":[["アブラハム"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["『"],["もし"],["モーセ"],["と"],["預言者","よげんしゃ"],["と"],["の"],["教え","おしえ"],["に"],["耳","みみ"],["を"],["傾けない","かたむけない"],["の"],["なら"],["、"],["たとい"],["だれ"],["か"],["が"],["死人","しにん"],["の"],["中","なか"],["から"],["生き返って","いきかえって"],["も"],["、"],["彼","かれ"],["ら"],["は"],["聞き入れ","ききいれ"],["は"],["しない"],["。"],["』"],["」"]]}]
[{"verse":1,"text":"その後、イエスは、神の国を説き、その福音を宣べ伝えながら、町や村を次から次に旅をしておられた。十二弟子もお供をした。","tok":[["その"],["後","ご"],["、"],["イエス"],["は"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["説き","とき"],["、"],["その"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["ながら"],["、"],["町","まち"],["や"],["村","むら"],["を"],["次","つぎ"],["から"],["次","つぎ"],["に"],["旅","たび"],["を"],["して"],["おられた"],["。"],["十二","じゅうに"],["弟子","でし"],["も"],["お供","おとも"],["を"],["した"],["。"]]},{"verse":2,"text":"また、悪霊や病気を直していただいた女たち、すなわち、七つの悪霊を追い出していただいたマグダラの女と呼ばれるマリヤ、","tok":[["また"],["、"],["悪霊","あくりょう"],["や"],["病気","びょうき"],["を"],["直して","なおして"],["いただいた"],["女","おんな"],["たち"],["、"],["すなわち"],["、"],["七","なな"],["つ"],["の"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["いただいた"],["マグダラ"],["の"],["女","おんな"],["と"],["呼ばれる","よばれる"],["マリヤ"],["、"]]},{"verse":3,"text":"自分の財産をもって彼らに仕えているヘロデの執事クーザの妻ヨハンナ、スザンナ、そのほか大ぜいの女たちもいっしょであった。","tok":[["自分","じぶん"],["の"],["財産","ざいさん"],["を"],["もって"],["彼","かれ"],["ら"],["に"],["仕えて","つかえて"],["いる"],["ヘロデ"],["の"],["執事","しつじ"],["クーザ"],["の"],["妻","つま"],["ヨハンナ"],["、"],["スザンナ"],["、"],["その"],["ほか"],["大ぜい","おおぜい"],["の"],["女","おんな"],["たち"],["も"],["いっしょ"],["で"],["あった"],["。"]]},{"verse":4,"text":"さて、大ぜいの人の群れが集まり、また方々の町からも人々がみもとにやって来たので、イエスはたとえを用いて話された。","tok":[["さて"],["、"],["大ぜい","おおぜい"],["の"],["人","ひと"],["の"],["群れ","むれ"],["が"],["集まり","あつまり"],["、"],["また"],["方々","かたがた"],["の"],["町","まち"],["から"],["も"],["人々","ひとびと"],["が"],["みもと"],["に"],["やって"],["来た","きた"],["ので"],["、"],["イエス"],["は"],["たとえ"],["を"],["用いて","もちいて"],["話された","はなされた"],["。"]]},{"verse":5,"text":"「種を蒔く人が種蒔きに出かけた。蒔いているとき、道ばたに落ちた種があった。すると、人に踏みつけられ、空の鳥がそれを食べてしまった。","tok":[["「"],["種","しゅ"],["を"],["蒔く","まく"],["人","ひと"],["が"],["種蒔き","たねまき"],["に"],["出かけた","でかけた"],["。"],["蒔いて","まいて"],["いる"],["とき"],["、"],["道ばた","みちばた"],["に"],["落ちた","おちた"],["種","たね"],["が"],["あった"],["。"],["する"],["と"],["、"],["人","ひと"],["に"],["踏みつけられ","ふみつけられ"],["、"],["空","そら"],["の"],["鳥","とり"],["が"],["それ"],["を"],["食べて","たべて"],["しまった"],["。"]]},{"verse":6,"text":"また、別の種は岩の上に落ち、生え出たが、水分がなかったので、枯れてしまった。","tok":[["また"],["、"],["別","べつ"],["の"],["種","たね"],["は"],["岩","いわ"],["の"],["上","うえ"],["に"],["落ち","おち"],["、"],["生え出た","はえでた"],["が"],["、"],["水分","すいぶん"],["が"],["なかった"],["ので"],["、"],["枯れて","かれて"],["しまった"],["。"]]},{"verse":7,"text":"また、別の種はいばらの真ん中に落ちた。ところが、いばらもいっしょに生え出て、それを押しふさいでしまった。","tok":[["また"],["、"],["別","べつ"],["の"],["種","たね"],["は"],["いばら"],["の"],["真ん中","まんなか"],["に"],["落ちた","おちた"],["。"],["ところ"],["が"],["、"],["いばら"],["も"],["いっしょ"],["に"],["生え出て","はえでて"],["、"],["それ"],["を"],["押しふさいで","おしふさいで"],["しまった"],["。"]]},{"verse":8,"text":"また、別の種は良い地に落ち、生え出て、百倍の実を結んだ。」／イエスは、これらのことを話しながら「聞く耳のある者は聞きなさい」と叫ばれた。","tok":[["また"],["、"],["別","べつ"],["の"],["種","たね"],["は"],["良い","よい"],["地","ち"],["に"],["落ち","おち"],["、"],["生え出て","はえでて"],["、"],["百","ひゃく"],["倍","ばい"],["の"],["実","じつ"],["を"],["結んだ","むすんだ"],["。"],["」"],["／"],["イエス"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["話し","はなし"],["ながら"],["「"],["聞く","きく"],["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞き","きき"],["なさい"],["」"],["と"],["叫ばれた","さけばれた"],["。"]]},{"verse":9,"text":"さて、弟子たちは、このたとえがどんな意味かをイエスに尋ねた。","tok":[["さて"],["、"],["弟子","でし"],["たち"],["は"],["、"],["この"],["たとえ"],["が"],["どんな"],["意味","いみ"],["か"],["を"],["イエス"],["に"],["尋ねた","たずねた"],["。"]]},{"verse":10,"text":"そこでイエスは言われた。「あなたがたに、神の国の奥義を知ることが許されているが、ほかの者には、たとえで話します。彼らが見ていても見えず、聞いていても悟らないためです。","tok":[["そこ"],["で"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["に"],["、"],["神","かみ"],["の"],["国","くに"],["の"],["奥義","おうぎ"],["を"],["知る","しる"],["こと"],["が"],["許されて","ゆるされて"],["いる"],["が"],["、"],["ほか"],["の"],["者","もの"],["に"],["は"],["、"],["たとえ"],["で"],["話します","はなします"],["。"],["彼","かれ"],["ら"],["が"],["見て","みて"],["いて"],["も"],["見えず","みえず"],["、"],["聞いて","きいて"],["いて"],["も"],["悟らない","さとらない"],["ため"],["です"],["。"]]},{"verse":11,"text":"このたとえの意味はこうです。種は神のことばです。","tok":[["この"],["たとえ"],["の"],["意味","いみ"],["は"],["こう"],["です"],["。"],["種","しゅ"],["は"],["神","かみ"],["の"],["ことば"],["です"],["。"]]},{"verse":12,"text":"道ばたに落ちるとは、こういう人たちのことです。みことばを聞いたが、あとから悪魔が来て、彼らが信じて救われることのないように、その人たちの心から、みことばを持ち去ってしまうのです。","tok":[["道ばた","みちばた"],["に"],["落ちる","おちる"],["と"],["は"],["、"],["こう"],["いう"],["人","ひと"],["たち"],["の"],["こと"],["です"],["。"],["みことば"],["を"],["聞いた","きいた"],["が"],["、"],["あと"],["から"],["悪魔","あくま"],["が"],["来て","きて"],["、"],["彼","かれ"],["ら"],["が"],["信じて","しんじて"],["救われる","すくわれる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["その"],["人","ひと"],["たち"],["の"],["心","こころ"],["から"],["、"],["みことば"],["を"],["持ち去って","もちさって"],["しまう"],["の"],["です"],["。"]]},{"verse":13,"text":"岩の上に落ちるとは、こういう人たちのことです。聞いたときには喜んでみことばを受け入れるが、根がないので、しばらくは信じていても、試練のときになると、身を引いてしまうのです。","tok":[["岩","いわ"],["の"],["上","うえ"],["に"],["落ちる","おちる"],["と"],["は"],["、"],["こう"],["いう"],["人","ひと"],["たち"],["の"],["こと"],["です"],["。"],["聞いた","きいた"],["とき"],["に"],["は"],["喜んで","よろこんで"],["みことば"],["を"],["受け入れる","うけいれる"],["が"],["、"],["根","ね"],["が"],["ない"],["ので"],["、"],["しばらく"],["は"],["信じて","しんじて"],["いて"],["も"],["、"],["試練","しれん"],["の"],["とき"],["に"],["なる"],["と"],["、"],["身","み"],["を"],["引いて","ひいて"],["しまう"],["の"],["です"],["。"]]},{"verse":14,"text":"いばらの中に落ちるとは、こういう人たちのことです。みことばを聞きはしたが、とかくしているうちに、この世の心づかいや、富や、快楽によってふさがれて、実が熟するまでにならないのです。","tok":[["いばら"],["の"],["中","なか"],["に"],["落ちる","おちる"],["と"],["は"],["、"],["こう"],["いう"],["人","ひと"],["たち"],["の"],["こと"],["です"],["。"],["みことば"],["を"],["聞き","きき"],["は"],["した"],["が"],["、"],["とかく"],["して"],["いる"],["うち"],["に"],["、"],["この世","このよ"],["の"],["心づかい","こころづかい"],["や"],["、"],["富","とみ"],["や"],["、"],["快楽","かいらく"],["によって"],["ふさがれて"],["、"],["実","じつ"],["が"],["熟する","じゅくする"],["まで"],["に"],["ならない"],["の"],["です"],["。"]]},{"verse":15,"text":"しかし、良い地に落ちるとは、こういう人たちのことです。正しい、良い心でみことばを聞くと、それをしっかりと守り、よく耐えて、実を結ばせるのです。","tok":[["しかし"],["、"],["良い","よい"],["地","ち"],["に"],["落ちる","おちる"],["と"],["は"],["、"],["こう"],["いう"],["人","ひと"],["たち"],["の"],["こと"],["です"],["。"],["正しい","ただしい"],["、"],["良い","よい"],["心","こころ"],["で"],["みことば"],["を"],["聞く","きく"],["と"],["、"],["それ"],["を"],["しっかり"],["と"],["守り","まもり"],["、"],["よく"],["耐えて","たえて"],["、"],["実","じつ"],["を"],["結ばせる","むすばせる"],["の"],["です"],["。"]]},{"verse":16,"text":"あかりをつけてから、それを器で隠したり、寝台の下に置いたりする者はありません。燭台の上に置きます。入って来る人々に、その光が見えるためです。","tok":[["あかり"],["を"],["つけて"],["から"],["、"],["それ"],["を"],["器","うつわ"],["で"],["隠し","かくし"],["たり"],["、"],["寝台","しんだい"],["の"],["下","した"],["に"],["置い","おい"],["たり"],["する"],["者","もの"],["は"],["ありません"],["。"],["燭台","しょくだい"],["の"],["上","うえ"],["に"],["置きます","おきます"],["。"],["入って","はいって"],["来る","くる"],["人々","ひとびと"],["に"],["、"],["その"],["光","ひかり"],["が"],["見える","みえる"],["ため"],["です"],["。"]]},{"verse":17,"text":"隠れているもので、あらわにならぬものはなく、秘密にされているもので、知られず、また現れないものはありません。","tok":[["隠れて","かくれて"],["いる"],["もの"],["で"],["、"],["あらわ"],["に"],["ならぬ"],["もの"],["は"],["なく"],["、"],["秘密","ひみつ"],["に"],["されて"],["いる"],["もの"],["で"],["、"],["知られず","しられず"],["、"],["また"],["現れない","あらわれない"],["もの"],["は"],["ありません"],["。"]]},{"verse":18,"text":"だから、聞き方に注意しなさい。というのは、持っている人は、さらに与えられ、持たない人は、持っていると思っているものまでも取り上げられるからです。」","tok":[["だ"],["から"],["、"],["聞き方","ききかた"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"],["と"],["いう"],["の"],["は"],["、"],["持って","もって"],["いる"],["人","ひと"],["は"],["、"],["さらに"],["与えられ","あたえられ"],["、"],["持たない","もたない"],["人","ひと"],["は"],["、"],["持って","もって"],["いる"],["と"],["思って","おもって"],["いる"],["もの"],["まで"],["も"],["取り上げられる","とりあげられる"],["から"],["です"],["。"],["」"]]},{"verse":19,"text":"イエスのところに母と兄弟たちが来たが、群衆のためにそばへ近寄れなかった。","tok":[["イエス"],["の"],["ところ"],["に"],["母","はは"],["と"],["兄弟","きょうだい"],["たち"],["が"],["来た","きた"],["が"],["、"],["群衆","ぐんしゅう"],["の"],["ため"],["に"],["そば"],["へ"],["近寄れなかった","ちかよれなかった"],["。"]]},{"verse":20,"text":"それでイエスに、「あなたのお母さんと兄弟たちが、あなたに会おうとして、外に立っています」という知らせがあった。","tok":[["それ"],["で"],["イエス"],["に"],["、"],["「"],["あなた"],["の"],["お母さん","おかあさん"],["と"],["兄弟","きょうだい"],["たち"],["が"],["、"],["あなた"],["に"],["会おう","あおう"],["として"],["、"],["外","そと"],["に"],["立って","たって"],["います"],["」"],["と"],["いう"],["知らせ","しらせ"],["が"],["あった"],["。"]]},{"verse":21,"text":"ところが、イエスは人々にこう答えられた。「わたしの母、わたしの兄弟たちとは、神のことばを聞いて行う人たちです。」","tok":[["ところ"],["が"],["、"],["イエス"],["は"],["人々","ひとびと"],["に"],["こう"],["答えられた","こたえられた"],["。"],["「"],["わたし"],["の"],["母","はは"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["と"],["は"],["、"],["神","かみ"],["の"],["ことば"],["を"],["聞いて","きいて"],["行う","おこなう"],["人","ひと"],["たち"],["です"],["。"],["」"]]},{"verse":22,"text":"そのころのある日のこと、イエスは弟子たちといっしょに舟に乗り、「さあ、湖の向こう岸へ渡ろう」と言われた。それで弟子たちは舟を出した。","tok":[["その"],["ころ"],["の"],["ある"],["日","ひ"],["の"],["こと"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["いっしょ"],["に"],["舟","ふね"],["に"],["乗り","のり"],["、"],["「"],["さあ"],["、"],["湖","みずうみ"],["の"],["向こう岸","むこうぎし"],["へ"],["渡ろう","わたろう"],["」"],["と"],["言われた","いわれた"],["。"],["それ"],["で"],["弟子","でし"],["たち"],["は"],["舟","ふね"],["を"],["出した","だした"],["。"]]},{"verse":23,"text":"舟で渡っている間にイエスはぐっすり眠ってしまわれた。ところが突風が湖に吹きおろして来たので、弟子たちは水をかぶって危険になった。","tok":[["舟","ふね"],["で"],["渡って","わたって"],["いる"],["間","あいだ"],["に"],["イエス"],["は"],["ぐっすり"],["眠って","ねむって"],["しまわれた"],["。"],["ところ"],["が"],["突風","とっぷう"],["が"],["湖","みずうみ"],["に"],["吹きおろして","ふきおろして"],["来た","きた"],["ので"],["、"],["弟子","でし"],["たち"],["は"],["水","みず"],["を"],["かぶって"],["危険","きけん"],["に"],["なった"],["。"]]},{"verse":24,"text":"そこで、彼らは近寄って行ってイエスを起こし、「先生、先生。私たちはおぼれて死にそうです」と言った。イエスは、起き上がって、風と荒波とをしかりつけられた。すると風も波も収まり、なぎになった。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["近寄って","ちかよって"],["行って","いって"],["イエス"],["を"],["起こし","おこし"],["、"],["「"],["先生","せんせい"],["、"],["先生","せんせい"],["。"],["私たち","わたしたち"],["は"],["おぼれて"],["死に","しに"],["そう"],["です"],["」"],["と"],["言った","いった"],["。"],["イエス"],["は"],["、"],["起き上がって","おきあがって"],["、"],["風","かぜ"],["と"],["荒波","あらなみ"],["と"],["を"],["しかりつけられた"],["。"],["する"],["と"],["風","かぜ"],["も"],["波","なみ"],["も"],["収まり","おさまり"],["、"],["なぎ"],["に"],["なった"],["。"]]},{"verse":25,"text":"イエスは彼らに、「あなたがたの信仰はどこにあるのです」と言われた。弟子たちは驚き恐れて互いに言った。「風も水も、お命じになれば従うとは、いったいこの方はどういう方なのだろう。」","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["、"],["「"],["あなた"],["がた"],["の"],["信仰","しんこう"],["は"],["どこ"],["に"],["ある"],["の"],["です"],["」"],["と"],["言われた","いわれた"],["。"],["弟子","でし"],["たち"],["は"],["驚き恐れて","おどろきおそれて"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["風","かぜ"],["も"],["水","みず"],["も"],["、"],["お命じ","おめいじ"],["に"],["なれば"],["従う","したがう"],["と"],["は"],["、"],["いったい"],["この"],["方","かた"],["は"],["どういう"],["方","ほう"],["な"],["の"],["だろう"],["。"],["」"]]},{"verse":26,"text":"こうして彼らは、ガリラヤの向こう側のゲラサ人の地方に着いた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["ガリラヤ"],["の"],["向こう側","むこうがわ"],["の"],["ゲラサ人","げらさにん"],["の"],["地方","ちほう"],["に"],["着いた","ついた"],["。"]]},{"verse":27,"text":"イエスが陸に上がられると、この町の者で悪霊につかれている男がイエスに出会った。彼は、長い間着物も着けず、家には住まないで、墓場に住んでいた。","tok":[["イエス"],["が"],["陸","りく"],["に"],["上がられる","あがられる"],["と"],["、"],["この"],["町","まち"],["の"],["者","もの"],["で"],["悪霊","あくりょう"],["に"],["つかれて"],["いる"],["男","おとこ"],["が"],["イエス"],["に"],["出会った","であった"],["。"],["彼","かれ"],["は"],["、"],["長い","ながい"],["間着","あいぎ"],["物","もの"],["も"],["着けず","つけず"],["、"],["家","いえ"],["に"],["は"],["住まないで","すまないで"],["、"],["墓場","はかば"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":28,"text":"彼はイエスを見ると、叫び声をあげ、御前にひれ伏して大声で言った。「いと高き神の子、イエスさま。いったい私に何をしようというのです。お願いです。どうか私を苦しめないでください。」","tok":[["彼","かれ"],["は"],["イエス"],["を"],["見る","みる"],["と"],["、"],["叫び声","さけびごえ"],["を"],["あげ"],["、"],["御前","ごぜん"],["に"],["ひれ伏して","ひれふして"],["大声","おおごえ"],["で"],["言った","いった"],["。"],["「"],["いと"],["高き","たかき"],["神","かみ"],["の"],["子","こ"],["、"],["イエス"],["さま"],["。"],["いったい"],["私","わたくし"],["に"],["何","なん"],["を"],["しよう"],["と"],["いう"],["の"],["です"],["。"],["お願い","おねがい"],["です"],["。"],["どう"],["か"],["私","わたくし"],["を"],["苦しめないで","くるしめないで"],["ください"],["。"],["」"]]},{"verse":29,"text":"それは、イエスが、汚れた霊に、この人から出て行け、と命じられたからである。汚れた霊が何回となくこの人を捕らえたので、彼は鎖や足かせでつながれて看視されていたが、それでもそれらを断ち切っては悪霊によって荒野に追いやられていたのである。","tok":[["それ"],["は"],["、"],["イエス"],["が"],["、"],["汚れた","よごれた"],["霊","れい"],["に"],["、"],["この"],["人","ひと"],["から"],["出て","でて"],["行け","いけ"],["、"],["と"],["命じられた","めいじられた"],["から"],["で"],["ある"],["。"],["汚れた","よごれた"],["霊","れい"],["が"],["何回","なんかい"],["と"],["なく"],["この"],["人","ひと"],["を"],["捕らえた","とらえた"],["ので"],["、"],["彼","かれ"],["は"],["鎖","くさり"],["や"],["足かせ","あしかせ"],["で"],["つながれて"],["看視","かんし"],["されて"],["いた"],["が"],["、"],["それ"],["で"],["も"],["それ"],["ら"],["を"],["断ち切って","たちきって"],["は"],["悪霊","あくりょう"],["によって"],["荒野","こうや"],["に"],["追いやられて","おいやられて"],["いた"],["ので"],["ある"],["。"]]},{"verse":30,"text":"イエスが、「何という名か」とお尋ねになると、「レギオンです」と答えた。悪霊が大ぜい彼に入っていたからである。","tok":[["イエス"],["が"],["、"],["「"],["何","なん"],["と"],["いう"],["名","な"
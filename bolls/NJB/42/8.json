k":[["女","おんな"],["は"],["、"],["隠し","かくし"],["きれない"],["と"],["知って","しって"],["、"],["震え","ふるえ"],["ながら"],["進み出て","すすみでて"],["、"],["御前","ごぜん"],["に"],["ひれ伏し","ひれふし"],["、"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["、"],["イエス"],["に"],["さわった"],["わけ"],["と"],["、"],["たちどころ"],["に"],["いやされた"],["次第","しだい"],["と"],["を"],["話した","はなした"],["。"]]},{"verse":48,"text":"そこで、イエスは彼女に言われた。「娘よ。あなたの信仰があなたを直したのです。安心して行きなさい。」","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼女","かのじょ"],["に"],["言われた","いわれた"],["。"],["「"],["娘","むすめ"],["よ"],["。"],["あなた"],["の"],["信仰","しんこう"],["が"],["あなた"],["を"],["直した","なおした"],["の"],["です"],["。"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["。"],["」"]]},{"verse":49,"text":"イエスがまだ話しておられるときに、会堂管理者の家から人が来て言った。「あなたのお嬢さんはなくなりました。もう、先生を煩わすことはありません。」","tok":[["イエス"],["が"],["まだ"],["話して","はなして"],["おられる"],["とき"],["に"],["、"],["会堂","かいどう"],["管理者","かんりしゃ"],["の"],["家","いえ"],["から"],["人","ひと"],["が"],["来て","きて"],["言った","いった"],["。"],["「"],["あなた"],["の"],["お嬢さん","おじょうさん"],["は"],["なくなりました"],["。"],["もう"],["、"],["先生","せんせい"],["を"],["煩わす","わずらわす"],["こと"],["は"],["ありません"],["。"],["」"]]},{"verse":50,"text":"これを聞いて、イエスは答えられた。「恐れないで、ただ信じなさい。そうすれば、娘は直ります。」","tok":[["これ"],["を"],["聞いて","きいて"],["、"],["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["恐れないで","おそれないで"],["、"],["ただ"],["信じ","しんじ"],["なさい"],["。"],["そう"],["すれば"],["、"],["娘","むすめ"],["は"],["直ります","なおります"],["。"],["」"]]},{"verse":51,"text":"イエスは家に入られたが、ペテロとヨハネとヤコブ、それに子どもの父と母のほかは、だれもいっしょに入ることをお許しにならなかった。","tok":[["イエス"],["は"],["家","いえ"],["に"],["入られた","はいられた"],["が"],["、"],["ペテロ"],["と"],["ヨハネ"],["と"],["ヤコブ"],["、"],["それ"],["に"],["子ども","こども"],["の"],["父","ちち"],["と"],["母","はは"],["の"],["ほか"],["は"],["、"],["だれ"],["も"],["いっしょ"],["に"],["入る","はいる"],["こと"],["を"],["お許し","おゆるし"],["に"],["ならなかった"],["。"]]},{"verse":52,"text":"人々はみな、娘のために泣き悲しんでいた。しかし、イエスは言われた。「泣かなくてもよい。死んだのではない。眠っているのです。」","tok":[["人々","ひとびと"],["は"],["みな"],["、"],["娘","むすめ"],["の"],["ため"],["に"],["泣き悲しんで","なきかなしんで"],["いた"],["。"],["しかし"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["泣かなくて","なかなくて"],["も"],["よい"],["。"],["死んだ","しんだ"],["ので"],["は"],["ない"],["。"],["眠って","ねむって"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":53,"text":"人々は、娘が死んだことを知っていたので、イエスをあざ笑っていた。","tok":[["人々","ひとびと"],["は"],["、"],["娘","むすめ"],["が"],["死んだ","しんだ"],["こと"],["を"],["知って","しって"],["いた"],["ので"],["、"],["イエス"],["を"],["あざ笑って","あざわらって"],["いた"],["。"]]},{"verse":54,"text":"しかしイエスは、娘の手を取って、叫んで言われた。「子どもよ。起きなさい。」","tok":[["しかし"],["イエス"],["は"],["、"],["娘","むすめ"],["の"],["手","て"],["を"],["取って","とって"],["、"],["叫んで","さけんで"],["言われた","いわれた"],["。"],["「"],["子ども","こども"],["よ"],["。"],["起き","おき"],["なさい"],["。"],["」"]]},{"verse":55,"text":"すると、娘の霊が戻って、娘はただちに起き上がった。それでイエスは、娘に食事をさせるように言いつけられた。","tok":[["する"],["と"],["、"],["娘","むすめ"],["の"],["霊","れい"],["が"],["戻って","もどって"],["、"],["娘","むすめ"],["は"],["ただちに"],["起き上がった","おきあがった"],["。"],["それ"],["で"],["イエス"],["は"],["、"],["娘","むすめ"],["に"],["食事","しょくじ"],["を"],["させる"],["よう"],["に"],["言いつけられた","いいつけられた"],["。"]]},{"verse":56,"text":"両親がひどく驚いていると、イエスは、この出来事をだれにも話さないように命じられた。","tok":[["両親","りょうしん"],["が"],["ひどく"],["驚いて","おどろいて"],["いる"],["と"],["、"],["イエス"],["は"],["、"],["この"],["出来事","できごと"],["を"],["だれ"],["に"],["も"],["話さない","はなさない"],["よう"],["に"],["命じられた","めいじられた"],["。"]]}]
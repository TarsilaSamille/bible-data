[{"verse":1,"text":"ああ、悲しいことだ。／私は夏のくだものを集める者のよう、ぶどうの取り残しの実を／取り入れる者のようになった。／もう食べられるふさは一つもなく、私の好きな初なりのいちじくの実もない。","tok":[["ああ"],["、"],["悲しい","かなしい"],["こと"],["だ"],["。"],["／"],["私","わたくし"],["は"],["夏","なつ"],["の"],["くだもの"],["を"],["集める","あつめる"],["者","もの"],["の"],["よう"],["、"],["ぶどう"],["の"],["取り残し","とりのこし"],["の"],["実","じつ"],["を"],["／"],["取り入れる","とりいれる"],["者","もの"],["の"],["よう"],["に"],["なった"],["。"],["／"],["もう"],["食べられる","たべられる"],["ふさ"],["は"],["一","ひと"],["つ"],["も"],["なく"],["、"],["私","わたくし"],["の"],["好き","すき"],["な"],["初なり","はつなり"],["の"],["いちじく"],["の"],["実","じつ"],["も"],["ない"],["。"]]},{"verse":2,"text":"敬虔な者はこの地から消えうせ、人の間に、正しい者はひとりもいない。／みな血を流そうと待ち伏せし、互いに網をかけ合って捕らえようとする。","tok":[["敬虔","けいけん"],["な"],["者","もの"],["は"],["この"],["地","ち"],["から"],["消えうせ","きえうせ"],["、"],["人","ひと"],["の"],["間","あいだ"],["に"],["、"],["正しい","ただしい"],["者","もの"],["は"],["ひとり"],["も"],["いない"],["。"],["／"],["みな"],["血","ち"],["を"],["流そう","ながそう"],["と"],["待ち伏せ","まちぶせ"],["し"],["、"],["互い","たがい"],["に"],["網","あみ"],["を"],["かけ合って","かけあって"],["捕らえよう","とらえよう"],["と"],["する"],["。"]]},{"verse":3,"text":"彼らの手は悪事を働くのに巧みで、役人は物を求め、さばきつかさは報酬に応じてさばき、有力者は自分の欲するままを語り、こうして事を曲げている。","tok":[["彼","かれ"],["ら"],["の"],["手","て"],["は"],["悪事","あくじ"],["を"],["働く","はたらく"],["のに"],["巧み","たくみ"],["で"],["、"],["役人","やくにん"],["は"],["物","もの"],["を"],["求め","もとめ"],["、"],["さばき"],["つかさ"],["は"],["報酬","ほうしゅう"],["に"],["応じて","おうじて"],["さばき"],["、"],["有力","ゆうりょく"],["者","しゃ"],["は"],["自分","じぶん"],["の"],["欲する","ほっする"],["まま"],["を"],["語り","かたり"],["、"],["こう"],["して"],["事","こと"],["を"],["曲げて","まげて"],["いる"],["。"]]},{"verse":4,"text":"彼らのうちの善人もいばらのようだ。／正しい者もいばらの生け垣のようだ。／あなたの刑罰の日が、あなたを見張る者の日が来る。／今、彼らに混乱が起きる。","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["善人","ぜんにん"],["も"],["いばら"],["の"],["よう"],["だ"],["。"],["／"],["正しい","ただしい"],["者","もの"],["も"],["いばら"],["の"],["生け垣","いけがき"],["の"],["よう"],["だ"],["。"],["／"],["あなた"],["の"],["刑罰","けいばつ"],["の"],["日","ひ"],["が"],["、"],["あなた"],["を"],["見張る","みはる"],["者","もの"],["の"],["日","ひ"],["が"],["来る","くる"],["。"],["／"],["今","いま"],["、"],["彼","かれ"],["ら"],["に"],["混乱","こんらん"],["が"],["起きる","おきる"],["。"]]},{"verse":5,"text":"友を信用するな。／親しい友をも信頼するな。／あなたのふところに寝る者にも、あなたの口の戸を守れ。","tok":[["友","とも"],["を"],["信用","しんよう"],["する"],["な"],["。"],["／"],["親しい","したしい"],["友","とも"],["を"],["も"],["信頼","しんらい"],["する"],["な"],["。"],["／"],["あなた"],["の"],["ふところ"],["に"],["寝る","ねる"],["者","もの"],["に"],["も"],["、"],["あなた"],["の"],["口","くち"],["の"],["戸","と"],["を"],["守れ","まもれ"],["。"]]},{"verse":6,"text":"息子は父親を侮り、娘は母親に、嫁はしゅうとめに逆らい、それぞれ自分の家の者を敵としている。","tok":[["息子","むすこ"],["は"],["父親","ちちおや"],["を"],["侮り","あなどり"],["、"],["娘","むすめ"],["は"],["母親","ははおや"],["に"],["、"],["嫁","よめ"],["は"],["しゅうとめ"],["に"],["逆らい","さからい"],["、"],["それぞれ"],["自分","じぶん"],["の"],["家","いえ"],["の"],["者","もの"],["を"],["敵","てき"],["として"],["いる"],["。"]]},{"verse":7,"text":"しかし、私は主を仰ぎ見、私の救いの神を待ち望む。／私の神は私の願いを聞いてくださる。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["主","ぬし"],["を"],["仰ぎ見","あおぎみ"],["、"],["私","わたくし"],["の"],["救い","すくい"],["の"],["神","かみ"],["を"],["待ち望む","まちのぞむ"],["。"],["／"],["私","わたくし"],["の"],["神","かみ"],["は"],["私","わたくし"],["の"],["願い","ねがい"],["を"],["聞いて","きいて"],["くださる"],["。"]]},{"verse":8,"text":"私の敵。私のことで喜ぶな。／私は倒れても起き上がり、やみの中にすわっていても、主が私の光であるからだ。","tok":[["私","わたくし"],["の"],["敵","てき"],["。"],["私","わたくし"],["の"],["こと"],["で"],["喜ぶ","よろこぶ"],["な"],["。"],["／"],["私","わたくし"],["は"],["倒れて","たおれて"],["も"],["起き上がり","おきあがり"],["、"],["やみ"],["の"],["中","なか"],["に"],["すわって"],["いて"],["も"],["、"],["主","ぬし"],["が"],["私","わたくし"],["の"],["光","ひかり"],["で"],["ある"],["から"],["だ"],["。"]]},{"verse":9,"text":"私は主の激しい怒りを身に受けている。／私が主に罪を犯したからだ。／しかし、それは、主が私の訴えを取り上げ、私を正しくさばいてくださるまでだ。／主は私を光に連れ出し、私はその義を見ることができる。","tok":[["私","わたくし"],["は"],["主","ぬし"],["の"],["激しい","はげしい"],["怒り","いかり"],["を"],["身","み"],["に"],["受けて","うけて"],["いる"],["。"],["／"],["私","わたくし"],["が"],["主に","おもに"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["だ"],["。"],["／"],["しかし"],["、"],["それ"],["は"],["、"],["主","ぬし"],["が"],["私","わたくし"],["の"],["訴え","うったえ"],["を"],["取り上げ","とりあげ"],["、"],["私","わたくし"],["を"],["正しく","ただしく"],["さばいて"],["くださる"],["まで"],["だ"],["。"],["／"],["主","ぬし"],["は"],["私","わたくし"],["を"],["光","ひかり"],["に"],["連れ出し","つれだし"],["、"],["私","わたくし"],["は"],["その"],["義","ぎ"],["を"],["見る","みる"],["こと"],["が"],["できる"],["。"]]},{"verse":10,"text":"それで、私に向かい、「あなたの神、主は、どこにいるのか。」／と言った私の敵は、これを見て恥に包まれる。／私もこの目で敵をながめる。／今、敵は道の泥のように踏みにじられる。","tok":[["それ"],["で"],["、"],["私","わたくし"],["に"],["向かい","むかい"],["、"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["」"],["／"],["と"],["言った","いった"],["私","わたくし"],["の"],["敵","てき"],["は"],["、"],["これ"],["を"],["見て","みて"],["恥","はじ"],["に"],["包まれる","つつまれる"],["。"],["／"],["私","わたくし"],["も"],["この"],["目","め"],["で"],["敵","てき"],["を"],["ながめる"],["。"],["／"],["今","いま"],["、"],["敵","てき"],["は"],["道","みち"],["の"],["泥","どろ"],["の"],["よう"],["に"],["踏みにじられる","ふみにじられる"],["。"]]},{"verse":11,"text":"あなたの石垣を建て直す日、その日、国境が広げられる。","tok":[["あなた"],["の"],["石垣","いしがき"],["を"],["建て直す","たてなおす"],["日","ひ"],["、"],["その"],["日","ひ"],["、"],["国境","こっきょう"],["が"],["広げられる","ひろげられる"],["。"]]},{"verse":12,"text":"その日、アッシリヤからエジプトまで、エジプトから大川まで、海から海まで、山から山まで、人々はあなたのところに来る。","tok":[["その"],["日","ひ"],["、"],["アッシリヤ"],["から"],["エジプト"],["まで"],["、"],["エジプト"],["から"],["大川","おおかわ"],["まで"],["、"],["海","うみ"],["から"],["海","うみ"],["まで"],["、"],["山","やま"],["から"],["山","やま"],["まで"],["、"],["人々","ひとびと"],["は"],["あなた"],["の"],["ところ"],["に"],["来る","くる"],["。"]]},{"verse":13,"text":"しかし、その地は荒れ果てる。／そこに住んでいた者たちのゆえに。／これが彼らの行いの結んだ実である。","tok":[["しかし"],["、"],["その"],["地","ち"],["は"],["荒れ果てる","あれはてる"],["。"],["／"],["そこ"],["に"],["住んで","すんで"],["いた"],["者","もの"],["たち"],["の"],["ゆえ"],["に"],["。"],["／"],["これ"],["が"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["の"],["結んだ","むすんだ"],["実","じつ"],["で"],["ある"],["。"]]},{"verse":14,"text":"どうか、あなたの杖で、あなたの民、あなたご自身のものである羊を飼ってください。／彼らは林の中、果樹園の中に、ひとり離れて住んでいます。／彼らが昔の日のように、バシャンとギルアデで／草をはむようにしてください。","tok":[["どう"],["か"],["、"],["あなた"],["の"],["杖","つえ"],["で"],["、"],["あなた"],["の"],["民","たみ"],["、"],["あなた"],["ご自身","ごじしん"],["の"],["もの"],["で"],["ある"],["羊","ひつじ"],["を"],["飼って","かって"],["ください"],["。"],["／"],["彼","かれ"],["ら"],["は"],["林","はやし"],["の"],["中","なか"],["、"],["果樹園","かじゅえん"],["の"],["中","なか"],["に"],["、"],["ひとり"],["離れて","はなれて"],["住んで","すんで"],["います"],["。"],["／"],["彼","かれ"],["ら"],["が"],["昔","むかし"],["の"],["日","ひ"],["の"],["よう"],["に"],["、"],["バシャン"],["と"],["ギルアデ"],["で"],["／"],["草","くさ"],["を"],["はむ"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":15,"text":"「あなたがエジプトの国から出た日のように、わたしは奇しいわざを彼に見せよう。」","tok":[["「"],["あなた"],["が"],["エジプト"],["の"],["国","くに"],["から"],["出た","でた"],["日","ひ"],["の"],["よう"],["に"],["、"],["わたし"],["は"],["奇しい","くすしい"],["わざ"],["を"],["彼","かれ"],["に"],["見せよう","みせよう"],["。"],["」"]]},{"verse":16,"text":"異邦の民も見て、自分たちのすべての力を恥じ、手を口に当て、彼らの耳は聞こえなくなりましょう。","tok":[["異邦","いほう"],["の"],["民","たみ"],["も"],["見て","みて"],["、"],["自分","じぶん"],["たち"],["の"],["すべて"],["の"],["力","ちから"],["を"],["恥じ","はじ"],["、"],["手","て"],["を"],["口","くち"],["に"],["当て","あて"],["、"],["彼","かれ"],["ら"],["の"],["耳","みみ"],["は"],["聞こえなく","きこえなく"],["なりましょう"],["。"]]},{"verse":17,"text":"彼らは、蛇のように、地をはうもののように、ちりをなめ、震えながら彼らのとりでから、私たちの神、主のみもとに出て来て、わなないて、あなたを恐れましょう。","tok":[["彼","かれ"],["ら"],["は"],["、"],["蛇","へび"],["の"],["よう"],["に"],["、"],["地","ち"],["を"],["はう"],["もの"],["の"],["よう"],["に"],["、"],["ちり"],["を"],["なめ"],["、"],["震え","ふるえ"],["ながら"],["彼","かれ"],["ら"],["の"],["とりで"],["から"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["のみ"],["もと"],["に"],["出て","でて"],["来て","きて"],["、"],["わなないて"],["、"],["あなた"],["を"],["恐れましょう","おそれましょう"],["。"]]},{"verse":18,"text":"あなたのような神が、ほかにあるでしょうか。／あなたは、咎を赦し、ご自分のものである残りの者のために、そむきの罪を見過ごされ、怒りをいつまでも持ち続けず、いつくしみを喜ばれるからです。","tok":[["あなた"],["の"],["よう"],["な"],["神","かみ"],["が"],["、"],["ほか"],["に"],["あるでしょう"],["か"],["。"],["／"],["あなた"],["は"],["、"],["咎","とが"],["を"],["赦し","ゆるし"],["、"],["ご自分","ごじぶん"],["の"],["もの"],["で"],["ある"],["残り","のこり"],["の"],["者","もの"],["の"],["ため"],["に"],["、"],["そむき"],["の"],["罪","つみ"],["を"],["見過ごされ","みすごされ"],["、"],["怒り","いかり"],["を"],["いつ"],["まで"],["も"],["持ち","もち"],["続けず","つづけず"],["、"],["いつくしみ"],["を"],["喜ばれる","よろこばれる"],["から"],["です"],["。"]]},{"verse":19,"text":"もう一度、私たちをあわれみ、私たちの咎を踏みつけて、すべての罪を海の深みに投げ入れてください。","tok":[["もう"],["一度","いちど"],["、"],["私たち","わたしたち"],["を"],["あわれみ"],["、"],["私たち","わたしたち"],["の"],["咎","とが"],
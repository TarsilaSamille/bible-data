[{"verse":1,"text":"終わりの日に、主の家の山は、山々の頂に堅く立ち、丘々よりもそびえ立ち、国々の民はそこに流れて来る。","tok":[["終わり","おわり"],["の"],["日","ひ"],["に"],["、"],["主","ぬし"],["の"],["家","いえ"],["の"],["山","やま"],["は"],["、"],["山々","やまやま"],["の"],["頂","いただき"],["に"],["堅く","かたく"],["立ち","たち"],["、"],["丘","おか"],["々"],["より"],["も"],["そびえ立ち","そびえたち"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["そこ"],["に"],["流れて","ながれて"],["来る","くる"],["。"]]},{"verse":2,"text":"多くの異邦の民が来て言う。「さあ、主の山、ヤコブの神の家に上ろう。主はご自分の道を、私たちに教えてくださる。私たちはその小道を歩もう。」それは、シオンからみおしえが出、エルサレムから主のことばが出るからだ。","tok":[["多く","おおく"],["の"],["異邦","いほう"],["の"],["民","たみ"],["が"],["来て","きて"],["言う","ゆう"],["。"],["「"],["さあ"],["、"],["主","ぬし"],["の"],["山","やま"],["、"],["ヤコブ"],["の"],["神","かみ"],["の"],["家","いえ"],["に"],["上ろう","のぼろう"],["。"],["主","ぬし"],["は"],["ご自分","ごじぶん"],["の"],["道","みち"],["を"],["、"],["私たち","わたしたち"],["に"],["教えて","おしえて"],["くださる"],["。"],["私たち","わたしたち"],["は"],["その"],["小道","こみち"],["を"],["歩もう","あゆもう"],["。"],["」"],["それ"],["は"],["、"],["シオン"],["から"],["みおしえ"],["が"],["出","で"],["、"],["エルサレム"],["から"],["主","ぬし"],["の"],["ことば"],["が"],["出る","でる"],["から"],["だ"],["。"]]},{"verse":3,"text":"主は多くの国々の民の間をさばき、遠く離れた強い国々に、判決を下す。／彼らはその剣を鋤に、その槍をかまに打ち直し、国は国に向かって剣を上げず、二度と戦いのことを習わない。","tok":[["主","ぬし"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["間","あいだ"],["を"],["さばき"],["、"],["遠く","とおく"],["離れた","はなれた"],["強い","つよい"],["国々","くにぐに"],["に"],["、"],["判決","はんけつ"],["を"],["下す","くだす"],["。"],["／"],["彼","かれ"],["ら"],["は"],["その"],["剣","けん"],["を"],["鋤","すき"],["に"],["、"],["その"],["槍","やり"],["を"],["かま"],["に"],["打ち直し","うちなおし"],["、"],["国","くに"],["は"],["国","くに"],["に"],["向かって","むかって"],["剣","けん"],["を"],["上げず","あげず"],["、"],["二","に"],["度","ど"],["と"],["戦い","たたかい"],["の"],["こと"],["を"],["習わない","ならわない"],["。"]]},{"verse":4,"text":"彼らはみな、おのおの自分のぶどうの木の下や、いちじくの木の下にすわり、彼らを脅かす者はいない。／まことに、万軍の主の御口が告げられる。","tok":[["彼","かれ"],["ら"],["は"],["みな"],["、"],["おのおの"],["自分","じぶん"],["の"],["ぶどう"],["の"],["木","き"],["の"],["下","した"],["や"],["、"],["いちじく"],["の"],["木","き"],["の"],["下","した"],["に"],["すわり"],["、"],["彼","かれ"],["ら"],["を"],["脅かす","おびやかす"],["者","もの"],["は"],["いない"],["。"],["／"],["まこと"],["に"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御口","おくち"],["が"],["告げられる","つげられる"],["。"]]},{"verse":5,"text":"まことに、すべての国々の民は、おのおの自分の神の名によって歩む。／しかし、私たちは、世々限りなく、私たちの神、主の御名によって歩もう。","tok":[["まこと"],["に"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["、"],["おのおの"],["自分","じぶん"],["の"],["神","かみ"],["の"],["名","な"],["によって"],["歩む","あゆむ"],["。"],["／"],["しかし"],["、"],["私たち","わたしたち"],["は"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["歩もう","あゆもう"],["。"]]},{"verse":6,"text":"その日、――主の御告げ――／わたしは足のなえた者を集め、追いやられた者、また、わたしが苦しめた者を寄せ集める。","tok":[["その"],["日","ひ"],["、"],["―"],["―"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["足","あし"],["の"],["なえた"],["者","もの"],["を"],["集め","あつめ"],["、"],["追いやられた","おいやられた"],["者","もの"],["、"],["また"],["、"],["わたし"],["が"],["苦しめた","くるしめた"],["者","もの"],["を"],["寄せ集める","よせあつめる"],["。"]]},{"verse":7,"text":"わたしは足のなえた者を、残りの者とし、遠くへ移された者を、強い国民とする。／主はシオンの山で、今よりとこしえまで、彼らの王となる。","tok":[["わたし"],["は"],["足","あし"],["の"],["なえた"],["者","もの"],["を"],["、"],["残り","のこり"],["の"],["者","もの"],["と"],["し"],["、"],["遠く","とおく"],["へ"],["移された","うつされた"],["者","もの"],["を"],["、"],["強い","つよい"],["国民","こくみん"],["と"],["する"],["。"],["／"],["主","ぬし"],["は"],["シオン"],["の"],["山","やま"],["で"],["、"],["今","いま"],["より"],["とこしえ"],["まで"],["、"],["彼","かれ"],["ら"],["の"],["王","おう"],["と"],["なる"],["。"]]},{"verse":8,"text":"羊の群れのやぐら、シオンの娘の丘よ。／あなたに、以前の主権、エルサレムの娘の王国が帰って来る。","tok":[["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["やぐら"],["、"],["シオン"],["の"],["娘","むすめ"],["の"],["丘","おか"],["よ"],["。"],["／"],["あなた"],["に"],["、"],["以前","いぜん"],["の"],["主権","しゅけん"],["、"],["エルサレム"],["の"],["娘","むすめ"],["の"],["王国","おうこく"],["が"],["帰って","かえって"],["来る","くる"],["。"]]},{"verse":9,"text":"なぜ、あなたは今、大声で泣き叫ぶのか。／あなたのうちに王がいないのか。／あなたの議官は滅びうせたのか。／子を産む女のような苦痛が／あなたを捕らえたのか。","tok":[["なぜ"],["、"],["あなた"],["は"],["今","いま"],["、"],["大声","おおごえ"],["で"],["泣き叫ぶ","なきさけぶ"],["の"],["か"],["。"],["／"],["あなた"],["の"],["うち"],["に"],["王","おう"],["が"],["いない"],["の"],["か"],["。"],["／"],["あなた"],["の"],["議官","ぎかん"],["は"],["滅び","ほろび"],["うせた"],["の"],["か"],["。"],["／"],["子","こ"],["を"],["産む","うむ"],["女","おんな"],["の"],["よう"],["な"],["苦痛","くつう"],["が"],["／"],["あなた"],["を"],["捕らえた","とらえた"],["の"],["か"],["。"]]},{"verse":10,"text":"シオンの娘よ。子を産む女のように、身もだえし、もがき回れ。／今、あなたは町を出て、野に宿り、バビロンまで行く。／そこであなたは救われる。／そこで主はあなたを敵の手から贖われる。","tok":[["シオン"],["の"],["娘","むすめ"],["よ"],["。"],["子","こ"],["を"],["産む","うむ"],["女","おんな"],["の"],["よう"],["に"],["、"],["身もだえ","みもだえ"],["し"],["、"],["もがき回れ","もがきまわれ"],["。"],["／"],["今","いま"],["、"],["あなた"],["は"],["町","まち"],["を"],["出て","でて"],["、"],["野","の"],["に"],["宿り","やどり"],["、"],["バビロン"],["まで"],["行く","いく"],["。"],["／"],["そこ"],["で"],["あなた"],["は"],["救われる","すくわれる"],["。"],["／"],["そこ"],["で"],["主","ぬし"],["は"],["あなた"],["を"],["敵","てき"],["の"],["手","て"],["から"],["贖われる","あがなわれる"],["。"]]},{"verse":11,"text":"今、多くの異邦の民があなたを攻めに集まり、そして言う。／「シオンが犯されるのをこの目で見よう」と。","tok":[["今","いま"],["、"],["多く","おおく"],["の"],["異邦","いほう"],["の"],["民","たみ"],["が"],["あなた"],["を"],["攻め","せめ"],["に"],["集まり","あつまり"],["、"],["そして"],["言う","ゆう"],["。"],["／"],["「"],["シオン"],["が"],["犯される","おかされる"],["の"],["を"],["この"],["目","め"],["で"],["見よう","みよう"],["」"],["と"],["。"]]},{"verse":12,"text":"しかし彼らは主の御計らいを知らず、そのはかりごとを悟らない。／主が彼らを打ち場の麦束のように／集められたことを。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["御計らい","おはからい"],["を"],["知らず","しらず"],["、"],["その"],["はかりごと"],["を"],["悟らない","さとらない"],["。"],["／"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["打ち","うち"],["場","ば"],["の"],["麦","むぎ"],["束","たば"],["の"],["よう"],["に"],["／"],["集められた","あつめられた"],["こと"],["を"],["。"]]},{"verse":13,"text":"シオンの娘よ。立って麦を打て。／わたしはあなたの角を鉄とし、あなたのひづめを青銅とする。／あなたは多くの国々の民を粉々に砕き、彼らの利得を主にささげ、彼らの財宝を全地の主にささげる。","tok":[["シオン"],["の"],["娘","むすめ"],["よ"],["。"],["立って","たって"],["麦","むぎ"],["を"],["打て","うて"],["。"],["／"],["わたし"],["は"],["あなた"],["の"],["角","かど"],["を"],["鉄","てつ"],["と"],["し"],["、"],["あなた"],["の"],["ひづめ"],["を"],["青銅","せいどう"],["と"],["する"],["。"],["／"],["あなた"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["粉々","こなごな"],["に"],["砕き","くだき"],["、"],["彼","かれ"],["ら"],["の"],["利得","りとく"],["を"],["主に","おもに"],["ささげ"],["、"],["彼","かれ"],["ら"],["の"],["財宝","ざいほう"],["を"],["全地","ぜんち"],["の"],["主に","おもに"],["ささげる"],["。"]]}]
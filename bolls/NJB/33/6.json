[{"verse":1,"text":"さあ、主の言われることを聞け。／立ち上がって、山々に訴え、丘々にあなたの声を聞かせよ。","tok":[["さあ"],["、"],["主","ぬし"],["の"],["言われる","いわれる"],["こと"],["を"],["聞け","きけ"],["。"],["／"],["立ち上がって","たちあがって"],["、"],["山々","やまやま"],["に"],["訴え","うったえ"],["、"],["丘","おか"],["々"],["に"],["あなた"],["の"],["声","こえ"],["を"],["聞かせ","きかせ"],["よ"],["。"]]},{"verse":2,"text":"山々よ。聞け。主の訴えを。／地の変わることのない基よ。／主はその民を訴え、イスラエルと討論される。","tok":[["山々","やまやま"],["よ"],["。"],["聞け","きけ"],["。"],["主","ぬし"],["の"],["訴え","うったえ"],["を"],["。"],["／"],["地","ち"],["の"],["変わる","かわる"],["こと"],["の"],["ない"],["基","もと"],["よ"],["。"],["／"],["主","ぬし"],["は"],["その"],["民","たみ"],["を"],["訴え","うったえ"],["、"],["イスラエル"],["と"],["討論","とうろん"],["される"],["。"]]},{"verse":3,"text":"わたしの民よ。／わたしはあなたに何をしたか。／どのようにしてあなたを煩わせたか。／わたしに答えよ。","tok":[["わたし"],["の"],["民","たみ"],["よ"],["。"],["／"],["わたし"],["は"],["あなた"],["に"],["何","なん"],["を"],["した"],["か"],["。"],["／"],["どの"],["よう"],["に"],["して"],["あなた"],["を"],["煩わせた","わずらわせた"],["か"],["。"],["／"],["わたし"],["に"],["答え","こたえ"],["よ"],["。"]]},{"verse":4,"text":"わたしはあなたをエジプトの地から上らせ、奴隷の家からあなたを買い戻し、あなたの前にモーセと、アロンと、ミリヤムを送った。","tok":[["わたし"],["は"],["あなた"],["を"],["エジプト"],["の"],["地","ち"],["から"],["上らせ","のぼらせ"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["あなた"],["を"],["買い戻し","かいもどし"],["、"],["あなた"],["の"],["前","まえ"],["に"],["モーセ"],["と"],["、"],["アロン"],["と"],["、"],["ミリヤム"],["を"],["送った","おくった"],["。"]]},{"verse":5,"text":"わたしの民よ。思い起こせ。／モアブの王バラクが何をたくらんだか。／ベオルの子バラムが彼に何と答えたか。／シティムからギルガルまでに何があったか。／それは主の正しいみわざを知るためであった。","tok":[["わたし"],["の"],["民","たみ"],["よ"],["。"],["思い起こせ","おもいおこせ"],["。"],["／"],["モアブ"],["の"],["王","おう"],["バラク"],["が"],["何","なん"],["を"],["たくらんだ"],["か"],["。"],["／"],["ベオル"],["の"],["子","こ"],["バラム"],["が"],["彼","かれ"],["に"],["何","なん"],["と"],["答えた","こたえた"],["か"],["。"],["／"],["シティム"],["から"],["ギルガル"],["まで"],["に"],["何","なん"],["が"],["あった"],["か"],["。"],["／"],["それ"],["は"],["主","ぬし"],["の"],["正しい","ただしい"],["みわざ"],["を"],["知る","しる"],["ため"],["で"],["あった"],["。"]]},{"verse":6,"text":"私は何をもって主の前に進み行き、いと高き神の前にひれ伏そうか。／全焼のいけにえ、一歳の子牛をもって／御前に進み行くべきだろうか。","tok":[["私","わたくし"],["は"],["何","なん"],["を"],["もって"],["主","ぬし"],["の"],["前","まえ"],["に"],["進み","すすみ"],["行き","いき"],["、"],["いと"],["高き","たかき"],["神","かみ"],["の"],["前","まえ"],["に"],["ひれ伏そう","ひれふそう"],["か"],["。"],["／"],["全焼","ぜんしょう"],["の"],["いけにえ"],["、"],["一歳","いちさい"],["の"],["子牛","こうし"],["を"],["もって"],["／"],["御前","ごぜん"],["に"],["進み","すすみ"],["行くべきだろう","いくべきだろう"],["か"],["。"]]},{"verse":7,"text":"主は幾千の雄羊、幾万の油を喜ばれるだろうか。／私の犯したそむきの罪のために、私の長子をささげるべきだろうか。／私のたましいの罪のために、私に生まれた子をささげるべきだろうか。","tok":[["主","ぬし"],["は"],["幾","いく"],["千","せん"],["の"],["雄羊","おひつじ"],["、"],["幾万","いくま"],["の"],["油","あぶら"],["を"],["喜ばれるだろう","よろこばれるだろう"],["か"],["。"],["／"],["私","わたくし"],["の"],["犯した","おかした"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["私","わたくし"],["の"],["長子","ちょうし"],["を"],["ささげるべきだろう"],["か"],["。"],["／"],["私","わたくし"],["の"],["たましい"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["私","わたくし"],["に"],["生まれた","うまれた"],["子","こ"],["を"],["ささげるべきだろう"],["か"],["。"]]},{"verse":8,"text":"主はあなたに告げられた。／人よ。何が良いことなのか。／主は何をあなたに求めておられるのか。／それは、ただ公義を行い、誠実を愛し、へりくだって／あなたの神とともに歩むことではないか。","tok":[["主","ぬし"],["は"],["あなた"],["に"],["告げられた","つげられた"],["。"],["／"],["人","ひと"],["よ"],["。"],["何","なん"],["が"],["良い","よい"],["こと"],["な"],["の"],["か"],["。"],["／"],["主","ぬし"],["は"],["何","なん"],["を"],["あなた"],["に"],["求めて","もとめて"],["おられる"],["の"],["か"],["。"],["／"],["それ"],["は"],["、"],["ただ"],["公義","きみよし"],["を"],["行い","おこない"],["、"],["誠実","せいじつ"],["を"],["愛し","あいし"],["、"],["へりくだって"],["／"],["あなた"],["の"],["神","かみ"],["と"],["とも"],["に"],["歩む","あゆむ"],["こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":9,"text":"聞け。主が町に向かって叫ばれる。／――御名を恐れることがすぐれた知性だ――／聞け。部族、町を治める者。","tok":[["聞け","きけ"],["。"],["主","ぬし"],["が"],["町","まち"],["に"],["向かって","むかって"],["叫ばれる","さけばれる"],["。"],["／"],["―"],["―"],["御名","ぎょめい"],["を"],["恐れる","おそれる"],["こと"],["が"],["すぐれた"],["知性","ちせい"],["だ"],["―"],["―"],["／"],["聞け","きけ"],["。"],["部族","ぶぞく"],["、"],["町","まち"],["を"],["治める","おさめる"],["者","もの"],["。"]]},{"verse":10,"text":"まだ、悪者の家には、不正の財宝と、のろわれた枡目不足の枡があるではないか。","tok":[["まだ"],["、"],["悪者","わるもの"],["の"],["家","いえ"],["に"],["は"],["、"],["不正","ふせい"],["の"],["財宝","ざいほう"],["と"],["、"],["のろわれた"],["枡目","ますめ"],["不足","ふそく"],["の"],["枡","ます"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":11,"text":"不正なはかりと、欺きの重り石の袋を使っている者を／罪なしとすることがわたしにできようか。","tok":[["不正","ふせい"],["な"],["はかり"],["と"],["、"],["欺き","あざむき"],["の"],["重り","おもり"],["石","いし"],["の"],["袋","ふくろ"],["を"],["使って","つかって"],["いる"],["者","もの"],["を"],["／"],["罪","つみ"],["なし"],["と"],["する"],["こと"],["が"],["わたし"],["に"],["できよう"],["か"],["。"]]},{"verse":12,"text":"富む者たちは暴虐に満ち、住民は偽りを言う。／彼らの口の中の舌は欺く。","tok":[["富む","とむ"],["者","もの"],["たち"],["は"],["暴虐","ぼうぎゃく"],["に"],["満ち","みち"],["、"],["住民","じゅうみん"],["は"],["偽り","いつわり"],["を"],["言う","ゆう"],["。"],["／"],["彼","かれ"],["ら"],["の"],["口","くち"],["の"],["中","なか"],["の"],["舌","した"],["は"],["欺く","あざむく"],["。"]]},{"verse":13,"text":"わたしもそこで、あなたを打って痛め、あなたの罪のために荒れ果てさせる。","tok":[["わたし"],["も"],["そこ"],["で"],["、"],["あなた"],["を"],["打って","うって"],["痛め","いため"],["、"],["あなた"],["の"],["罪","つみ"],["の"],["ため"],["に"],["荒れ果てさせる","あれはてさせる"],["。"]]},{"verse":14,"text":"あなたは食べても満ち足りず、あなたの腹は飢える。／あなたは、移しても、のがすことはできない。／あなたがのがした者は、わたしが剣に渡す。","tok":[["あなた"],["は"],["食べて","たべて"],["も"],["満ち足りず","みちたりず"],["、"],["あなた"],["の"],["腹","はら"],["は"],["飢える","うえる"],["。"],["／"],["あなた"],["は"],["、"],["移して","うつして"],["も"],["、"],["のがす"],["こと"],["は"],["できない"],["。"],["／"],["あなた"],["が"],["のがした"],["者","もの"],["は"],["、"],["わたし"],["が"],["剣","けん"],["に"],["渡す","わたす"],["。"]]},{"verse":15,"text":"あなたは種を蒔いても、刈ることがなく、オリーブをしぼっても、油を身に塗ることがない。／新しいぶどう酒を造っても、ぶどう酒を飲むことができない。","tok":[["あなた"],["は"],["種","しゅ"],["を"],["蒔いて","まいて"],["も"],["、"],["刈る","かる"],["こと"],["が"],["なく"],["、"],["オリーブ"],["を"],["しぼって"],["も"],["、"],["油","あぶら"],["を"],["身","み"],["に"],["塗る","ぬる"],["こと"],["が"],["ない"],["。"],["／"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["を"],["造って","つくって"],["も"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["飲む","のむ"],["こと"],["が"],["できない"],["。"]]},{"verse":16,"text":"あなたがたはオムリのおきてと、アハブの家のすべてのならわしを守り、彼らのはかりごとに従って歩んだ。／それは、わたしがあなたを荒れ果てさせ、住民をあざけりとするためだ。／あなたがたは、国々の民のそしりを負わなければならない。","tok":[["あなた"],["がた"],["は"],["オムリ"],["の"],["おきて"],["と"],["、"],["アハブ"],["の"],["家","いえ"],["の"],["すべて"],["の"],["ならわし"],["を"],["守り","まもり"],["、"],["彼","かれ"],["ら"],["の"],["はかりごと"],["に"],["従って","したがって"],["歩んだ","あゆんだ"],["。"],["／"],["それ"],["は"],["、"],["わたし"],["が"],["あなた"],["を"],["荒れ果てさせ","あれはてさせ"],["、"],["住民","じゅうみん"],["を"],["あざけり"],["と"],["する"],["ため"],["だ"],["。"],["／"],["あなた"],["がた"],["は"],["、"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["そ"],["しり"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]}]
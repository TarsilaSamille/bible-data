[{"verse":1,"text":"わたしは言った。／聞け。ヤコブのかしらたち、イスラエルの家の首領たち。／あなたがたは公義を知っているはずではないか。","tok":[["わたし"],["は"],["言った","いった"],["。"],["／"],["聞け","きけ"],["。"],["ヤコブ"],["の"],["かしら"],["たち"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["首領","しゅりょう"],["たち"],["。"],["／"],["あなた"],["がた"],["は"],["公義","きみよし"],["を"],["知って","しって"],["いる"],["はず"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":2,"text":"あなたがたは善を憎み、悪を愛し、人々の皮をはぎ、その骨から肉をそぎ取り、","tok":[["あなた"],["がた"],["は"],["善","ぜん"],["を"],["憎み","にくみ"],["、"],["悪","あく"],["を"],["愛し","あいし"],["、"],["人々","ひとびと"],["の"],["皮","かわ"],["を"],["はぎ"],["、"],["その"],["骨","ほね"],["から"],["肉","にく"],["を"],["そぎ取り","そぎとり"],["、"]]},{"verse":3,"text":"わたしの民の肉を食らい、皮をはぎ取り、その骨を粉々に砕き、鉢の中にあるように、また大がまの中の肉切れのように、切れ切れに裂く。","tok":[["わたし"],["の"],["民","たみ"],["の"],["肉","にく"],["を"],["食らい","くらい"],["、"],["皮","かわ"],["を"],["はぎ取り","はぎとり"],["、"],["その"],["骨","ほね"],["を"],["粉々","こなごな"],["に"],["砕き","くだき"],["、"],["鉢","ばち"],["の"],["中","なか"],["に"],["ある"],["よう"],["に"],["、"],["また"],["大","だい"],["がま"],["の"],["中","なか"],["の"],["肉切れ","にくぎれ"],["の"],["よう"],["に"],["、"],["切れ切れ","きれぎれ"],["に"],["裂く","さく"],["。"]]},{"verse":4,"text":"それで、彼らが主に叫んでも、主は彼らに答えない。／その時、主は彼らから顔を隠される。／彼らの行いが悪いからだ。","tok":[["それ"],["で"],["、"],["彼","かれ"],["ら"],["が"],["主に","おもに"],["叫んで","さけんで"],["も"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["に"],["答えない","こたえない"],["。"],["／"],["その"],["時","とき"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["から"],["顔","かお"],["を"],["隠される","かくされる"],["。"],["／"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["が"],["悪い","わるい"],["から"],["だ"],["。"]]},{"verse":5,"text":"預言者たちについて、主はこう仰せられる。／彼らはわたしの民を惑わせ、歯でかむ物があれば、「平和があるように」と叫ぶが、彼らの口に何も与えない者には、聖戦を宣言する。","tok":[["預言者","よげんしゃ"],["たち"],["について"],["、"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["を"],["惑わせ","まどわせ"],["、"],["歯","は"],["で"],["かむ"],["物","もの"],["が"],["あれば"],["、"],["「"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["」"],["と"],["叫ぶ","さけぶ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["口","くち"],["に"],["何","なん"],["も"],["与えない","あたえない"],["者","もの"],["に"],["は"],["、"],["聖戦","せいせん"],["を"],["宣言","せんげん"],["する"],["。"]]},{"verse":6,"text":"それゆえ、夜になっても、あなたがたには幻がなく、暗やみになっても、あなたがたには占いがない。／太陽も預言者たちの上に沈み、昼も彼らの上で暗くなる。","tok":[["それ"],["ゆえ"],["、"],["夜","よる"],["に"],["なって"],["も"],["、"],["あなた"],["がた"],["に"],["は"],["幻","まぼろし"],["が"],["なく"],["、"],["暗やみ","くらやみ"],["に"],["なって"],["も"],["、"],["あなた"],["がた"],["に"],["は"],["占い","うらない"],["が"],["ない"],["。"],["／"],["太陽","たいよう"],["も"],["預言者","よげんしゃ"],["たち"],["の"],["上","うえ"],["に"],["沈み","しずみ"],["、"],["昼","ひる"],["も"],["彼","かれ"],["ら"],["の"],["上","うえ"],["で"],["暗く","くらく"],["なる"],["。"]]},{"verse":7,"text":"先見者たちは恥を見、占い師たちははずかしめを受ける。／彼らはみな、口ひげをおおう。／神の答えがないからだ。","tok":[["先見者","せんけんしゃ"],["たち"],["は"],["恥","はじ"],["を"],["見","み"],["、"],["占い師","うらないし"],["たち"],["は"],["はずかしめ"],["を"],["受ける","うける"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["口ひげ","くちひげ"],["を"],["おおう"],["。"],["／"],["神","かみ"],["の"],["答え","こたえ"],["が"],["ない"],["から"],["だ"],["。"]]},{"verse":8,"text":"しかし、私は、力と、主の霊と、公義と、勇気とに満ち、ヤコブにはそのそむきの罪を、イスラエルにはその罪を告げよう。","tok":[["しかし"],["、"],["私","わたくし"],["は"],["、"],["力","ちから"],["と"],["、"],["主","ぬし"],["の"],["霊","れい"],["と"],["、"],["公義","きみよし"],["と"],["、"],["勇気","ゆうき"],["と"],["に"],["満ち","みち"],["、"],["ヤコブ"],["に"],["は"],["その"],["そむき"],["の"],["罪","つみ"],["を"],["、"],["イスラエル"],["に"],["は"],["その"],["罪","つみ"],["を"],["告げよう","つげよう"],["。"]]},{"verse":9,"text":"これを聞け。ヤコブの家のかしらたち、イスラエルの家の首領たち。／あなたがたは公義を忌みきらい、あらゆる正しいことを曲げている。","tok":[["これ"],["を"],["聞け","きけ"],["。"],["ヤコブ"],["の"],["家","いえ"],["の"],["かしら"],["たち"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["首領","しゅりょう"],["たち"],["。"],["／"],["あなた"],["がた"],["は"],["公義","きみよし"],["を"],["忌みきらい","いみきらい"],["、"],["あらゆる"],["正しい","ただしい"],["こと"],["を"],["曲げて","まげて"],["いる"],["。"]]},{"verse":10,"text":"血を流してシオンを建て、不正を行ってエルサレムを建てている。","tok":[["血","ち"],["を"],["流して","ながして"],["シオン"],["を"],["建て","たて"],["、"],["不正","ふせい"],["を"],["行って","おこなって"],["エルサレム"],["を"],["建てて","たてて"],["いる"],["。"]]},{"verse":11,"text":"そのかしらたちはわいろを取ってさばき、その祭司たちは代金を取って教え、その預言者たちは金を取って占いをする。／しかもなお、彼らは主に寄りかかって、「主は私たちの中におられるではないか。／わざわいは私たちの上にかかって来ない」／と言う。","tok":[["その"],["かしら"],["たち"],["は"],["わいろ"],["を"],["取って","とって"],["さばき"],["、"],["その"],["祭司","さいし"],["たち"],["は"],["代金","だいきん"],["を"],["取って","とって"],["教え","おしえ"],["、"],["その"],["預言者","よげんしゃ"],["たち"],["は"],["金","きん"],["を"],["取って","とって"],["占い","うらない"],["を"],["する"],["。"],["／"],["しかも"],["なお"],["、"],["彼","かれ"],["ら"],["は"],["主に","おもに"],["寄りかかって","よりかかって"],["、"],["「"],["主","ぬし"],["は"],["私たち","わたしたち"],["の"],["中","なか"],["に"],["おられるで"],["は"],["ない"],["か"],["。"],["／"],["わざわい"],["は"],["私たち","わたしたち"],["の"],["上","うえ"],["に"],["かかって"],["来ない","こない"],["」"],["／"],["と"],["言う","ゆう"],["。"]]},{"verse":12,"text":"それゆえ、シオンは、あなたがたのために、畑のように耕され、エルサレムは廃墟となり、この宮の山は森の丘となる。","tok":[["それ"],["ゆえ"],["、"],["シオン"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["畑","はたけ"],["の"],["よう"],["に"],["耕され","たがやされ"],["、"],["エルサレム"],["は"],["廃墟","はいきょ"],["と"],["なり"],["、"],["この"],["宮","みや"],["の"],["山","やま"],["は"],["森","もり"],["の"],["丘","おか"],["と"],["なる"],["。"]]}]
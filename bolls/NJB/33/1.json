[{"verse":1,"text":"ユダの王ヨタム、アハズ、ヒゼキヤの時代に、モレシェテ人ミカにあった主のことば。これは彼がサマリヤとエルサレムについて見た幻である。","tok":[["ユダ"],["の"],["王","おう"],["ヨタム"],["、"],["アハズ"],["、"],["ヒゼキヤ"],["の"],["時代","じだい"],["に"],["、"],["モレシェテ"],["人","にん"],["ミカ"],["に"],["あった"],["主","ぬし"],["の"],["ことば"],["。"],["これ"],["は"],["彼","かれ"],["が"],["サマリヤ"],["と"],["エルサレム"],["について"],["見た","みた"],["幻","まぼろし"],["で"],["ある"],["。"]]},{"verse":2,"text":"すべての国々の民よ。聞け。／地と、それに満ちるものよ。耳を傾けよ。／神である主は、あなたがたのうちで証人となり、主はその聖なる宮から来て証人となる。","tok":[["すべて"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["よ"],["。"],["聞け","きけ"],["。"],["／"],["地","ち"],["と"],["、"],["それ"],["に"],["満ちる","みちる"],["もの"],["よ"],["。"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["／"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["の"],["うち"],["で"],["証人","しょうにん"],["と"],["なり"],["、"],["主","ぬし"],["は"],["その"],["聖","せい"],["なる"],["宮","みや"],["から"],["来て","きて"],["証人","しょうにん"],["と"],["なる"],["。"]]},{"verse":3,"text":"見よ。主は御住まいを出、降りて来て、地の高い所を踏まれる。","tok":[["見","み"],["よ"],["。"],["主","ぬし"],["は"],["御住まい","おすまい"],["を"],["出","で"],["、"],["降りて","おりて"],["来て","きて"],["、"],["地","ち"],["の"],["高い","たかい"],["所","ところ"],["を"],["踏まれる","ふまれる"],["。"]]},{"verse":4,"text":"山々は主の足もとに溶け去り、谷々は裂ける。／ちょうど、火の前の、ろうのように。／坂に注がれた水のように。","tok":[["山々","やまやま"],["は"],["主","ぬし"],["の"],["足もと","あしもと"],["に"],["溶け去り","とけさり"],["、"],["谷々","やや"],["は"],["裂ける","さける"],["。"],["／"],["ちょうど"],["、"],["火","ひ"],["の"],["前","まえ"],["の"],["、"],["ろう"],["の"],["よう"],["に"],["。"],["／"],["坂","さか"],["に"],["注がれた","そそがれた"],["水","みず"],["の"],["よう"],["に"],["。"]]},{"verse":5,"text":"これはみな、ヤコブのそむきの罪のため、イスラエルの家の罪のためだ。／ヤコブのそむきの罪は何か。／サマリヤではないか。／ユダの高き所は何か。／エルサレムではないか。","tok":[["これ"],["は"],["みな"],["、"],["ヤコブ"],["の"],["そむき"],["の"],["罪","つみ"],["の"],["ため"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["罪","つみ"],["の"],["ため"],["だ"],["。"],["／"],["ヤコブ"],["の"],["そむき"],["の"],["罪","つみ"],["は"],["何","なん"],["か"],["。"],["／"],["サマリヤ"],["で"],["は"],["ない"],["か"],["。"],["／"],["ユダ"],["の"],["高き","たかき"],["所","ところ"],["は"],["何","なん"],["か"],["。"],["／"],["エルサレム"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"わたしはサマリヤを野原の廃墟とし、ぶどうを植える畑とする。／わたしはその石を谷に投げ入れ、その基をあばく。","tok":[["わたし"],["は"],["サマリヤ"],["を"],["野原","のはら"],["の"],["廃墟","はいきょ"],["と"],["し"],["、"],["ぶどう"],["を"],["植える","うえる"],["畑","はたけ"],["と"],["する"],["。"],["／"],["わたし"],["は"],["その"],["石","いし"],["を"],["谷","たに"],["に"],["投げ入れ","なげいれ"],["、"],["その"],["基","もと"],["を"],["あばく"],["。"]]},{"verse":7,"text":"そのすべての刻んだ像は打ち砕かれ、その儲けはみな、火で焼かれる。／わたしはそのすべての偶像を荒廃させる。／それらは遊女の儲けで集められたのだから、遊女の儲けに返る。","tok":[["その"],["すべて"],["の"],["刻んだ","きざんだ"],["像","ぞう"],["は"],["打ち砕かれ","うちくだかれ"],["、"],["その"],["儲け","もうけ"],["は"],["みな"],["、"],["火","ひ"],["で"],["焼かれる","やかれる"],["。"],["／"],["わたし"],["は"],["その"],["すべて"],["の"],["偶像","ぐうぞう"],["を"],["荒廃","こうはい"],["させる"],["。"],["／"],["それ"],["ら"],["は"],["遊女","ゆうじょ"],["の"],["儲け","もうけ"],["で"],["集められた","あつめられた"],["の"],["だ"],["から"],["、"],["遊女","ゆうじょ"],["の"],["儲け","もうけ"],["に"],["返る","かえる"],["。"]]},{"verse":8,"text":"このために、わたしは嘆き、泣きわめき、はだしで、裸で歩こう。／わたしはジャッカルのように嘆き、だちょうのように悲しみ泣こう。","tok":[["この"],["ため"],["に"],["、"],["わたし"],["は"],["嘆き","なげき"],["、"],["泣きわめき","なきわめき"],["、"],["はだし"],["で"],["、"],["裸","はだか"],["で"],["歩こう","あるこう"],["。"],["／"],["わたし"],["は"],["ジャッカル"],["の"],["よう"],["に"],["嘆き","なげき"],["、"],["だちょう"],["の"],["よう"],["に"],["悲しみ","かなしみ"],["泣こう","なこう"],["。"]]},{"verse":9,"text":"まことに、その打ち傷はいやしがたく、それはユダにまで及び、わたしの民の門、エルサレムにまで達する。","tok":[["まこと"],["に"],["、"],["その"],["打ち傷","うちきず"],["は"],["いやし"],["がたく"],["、"],["それ"],["は"],["ユダ"],["に"],["まで"],["及び","および"],["、"],["わたし"],["の"],["民","たみ"],["の"],["門","もん"],["、"],["エルサレム"],["に"],["まで"],["達する","たっする"],["。"]]},{"verse":10,"text":"ガテで告げるな。／激しく泣きわめくな。／ベテ・レアフラでちりの中にころび回れ。","tok":[["ガテ"],["で"],["告げる","つげる"],["な"],["。"],["／"],["激しく","はげしく"],["泣きわめく","なきわめく"],["な"],["。"],["／"],["ベテ"],["・"],["レアフラ"],["で"],["ちり"],["の"],["中","なか"],["に"],["ころび"],["回れ","まわれ"],["。"]]},{"verse":11,"text":"シャフィルに住む者よ。／裸で恥じながら過ぎて行け。／ツァアナンに住む者は出て来ない。／ベテ・エツェルの嘆きは、あなたがたから、立つ所を奪い取る。","tok":[["シャフィル"],["に"],["住む","すむ"],["者","もの"],["よ"],["。"],["／"],["裸","はだか"],["で"],["恥じ","はじ"],["ながら"],["過ぎて","すぎて"],["行け","いけ"],["。"],["／"],["ツァアナン"],["に"],["住む","すむ"],["者","もの"],["は"],["出て","でて"],["来ない","こない"],["。"],["／"],["ベテ"],["・"],["エツェル"],["の"],["嘆き","なげき"],["は"],["、"],["あなた"],["がた"],["から"],["、"],["立つ","たつ"],["所","ところ"],["を"],["奪い取る","うばいとる"],["。"]]},{"verse":12,"text":"マロテに住む者が、どうして、しあわせを待ち望めよう。／エルサレムの門に、主からわざわいが下ったのに。","tok":[["マロテ"],["に"],["住む","すむ"],["者","もの"],["が"],["、"],["どう"],["して"],["、"],["しあわせ"],["を"],["待ち望め","まちのぞめ"],["よう"],["。"],["／"],["エルサレム"],["の"],["門","もん"],["に"],["、"],["主","ぬし"],["から"],["わざわい"],["が"],["下った","くだった"],["のに"],["。"]]},{"verse":13,"text":"ラキシュに住む者よ。戦車に早馬をつなげ。／それはシオンの娘にとって罪の初めであった。／イスラエルの犯したそむきの罪が、あなたのうちに見つけられたからだ。","tok":[["ラキシュ"],["に"],["住む","すむ"],["者","もの"],["よ"],["。"],["戦車","せんしゃ"],["に"],["早馬","はやうま"],["を"],["つなげ"],["。"],["／"],["それ"],["は"],["シオン"],["の"],["娘","むすめ"],["にとって"],["罪","つみ"],["の"],["初め","はじめ"],["で"],["あった"],["。"],["／"],["イスラエル"],["の"],["犯した","おかした"],["そむき"],["の"],["罪","つみ"],["が"],["、"],["あなた"],["の"],["うち"],["に"],["見つけられた","みつけられた"],["から"],["だ"],["。"]]},{"verse":14,"text":"それゆえ、あなたは贈り物をモレシェテ・ガテに与える。／アクジブの家々は、イスラエルの王たちにとって、欺く者となる。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["贈り物","おくりもの"],["を"],["モレシェテ"],["・"],["ガテ"],["に"],["与える","あたえる"],["。"],["／"],["アクジブ"],["の"],["家々","いえいえ"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["たち"],["にとって"],["、"],["欺く","あざむく"],["者","もの"],["と"],["なる"],["。"]]},{"verse":15,"text":"マレシャに住む者よ。／わたしはまた、侵略者をあなたのところに送る。／イスラエルの栄光はアドラムまで行こう。","tok":[["マレシャ"],["に"],["住む","すむ"],["者","もの"],["よ"],["。"],["／"],["わたし"],["は"],["また"],["、"],["侵略者","しんりゃくしゃ"],["を"],["あなた"],["の"],["ところ"],["に"],["送る","おくる"],["。"],["／"],["イスラエル"],["の"],["栄光","えいこう"],["は"],["アドラム"],["まで"],["行こう","いこう"],["。"]]},{"verse":16,"text":"あなたの喜びとする子らのために、あなたの頭をそれ。／そのそった所を、はげ鷲のように大きくせよ。／彼らが捕らえられて、あなたから去って行ったから。","tok":[["あなた"],["の"],["喜び","よろこび"],["と"],["する"],["子","こ"],["ら"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["頭","あたま"],["を"],["それ"],["。"],["／"],["その"],["そった"],["所","ところ"],["を"],["、"],["はげ"],["鷲","わし"],["の"],["よう"],["に"],["大きく","おおきく"],["せよ"],["。"],["／"],["彼","かれ"],["ら"],["が"],["捕らえられて","とらえられて"],["、"],["あなた"],["から"],["去って","さって"],["行った","いった"],["から"],["。"]]}]
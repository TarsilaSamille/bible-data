[{"verse":1,"text":"律法には、後に来るすばらしいものの影はあっても、その実物はないのですから、律法は、年ごとに絶えずささげられる同じいけにえによって神に近づいて来る人々を、完全にすることができないのです。","tok":[["律法","りっぽう"],["に"],["は"],["、"],["後","あと"],["に"],["来る","くる"],["すばらしい"],["もの"],["の"],["影","かげ"],["は"],["あって"],["も"],["、"],["その"],["実物","じつぶつ"],["は"],["ない"],["の"],["です"],["から"],["、"],["律法","りっぽう"],["は"],["、"],["年","ねん"],["ごと"],["に"],["絶えず","たえず"],["ささげられる"],["同じ","おなじ"],["いけにえ"],["によって"],["神","かみ"],["に"],["近づいて","ちかづいて"],["来る","くる"],["人々","ひとびと"],["を"],["、"],["完全","かんぜん"],["に"],["する"],["こと"],["が"],["できない"],["の"],["です"],["。"]]},{"verse":2,"text":"もしそれができたのであったら、礼拝する人々は、一度きよめられた者として、もはや罪を意識しなかったはずであり、したがって、ささげ物をすることは、やんだはずです。","tok":[["もし"],["それ"],["が"],["できた"],["ので"],["あったら"],["、"],["礼拝","れいはい"],["する"],["人々","ひとびと"],["は"],["、"],["一度","いちど"],["きよめられた"],["者","もの"],["として"],["、"],["もはや"],["罪","つみ"],["を"],["意識","いしき"],["しなかった"],["はず"],["で"],["あり"],["、"],["したがって"],["、"],["ささげ物","ささげもの"],["を"],["する"],["こと"],["は"],["、"],["やんだ"],["はず"],["です"],["。"]]},{"verse":3,"text":"ところがかえって、これらのささげ物によって、罪が年ごとに思い出されるのです。","tok":[["ところ"],["が"],["かえって"],["、"],["これ"],["ら"],["の"],["ささげ物","ささげもの"],["によって"],["、"],["罪","つみ"],["が"],["年","ねん"],["ごと"],["に"],["思い出される","おもいだされる"],["の"],["です"],["。"]]},{"verse":4,"text":"雄牛とやぎの血は、罪を除くことができません。","tok":[["雄牛","おうし"],["と"],["やぎ"],["の"],["血","ち"],["は"],["、"],["罪","つみ"],["を"],["除く","のぞく"],["こと"],["が"],["できません"],["。"]]},{"verse":5,"text":"ですから、キリストは、この世界に来て、こう言われるのです。「あなたは、いけにえやささげ物を望まないで、わたしのために、からだを造ってくださいました。","tok":[["です"],["から"],["、"],["キリスト"],["は"],["、"],["この"],["世界","せかい"],["に"],["来て","きて"],["、"],["こう"],["言われる","いわれる"],["の"],["です"],["。"],["「"],["あなた"],["は"],["、"],["いけにえ"],["や"],["ささげ物","ささげもの"],["を"],["望まないで","のぞまないで"],["、"],["わたし"],["の"],["ため"],["に"],["、"],["からだ"],["を"],["造って","つくって"],["くださいました"],["。"]]},{"verse":6,"text":"あなたは全焼のいけにえと罪のためのいけにえとで満足されませんでした。","tok":[["あなた"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["と"],["で"],["満足","まんぞく"],["されませんでした"],["。"]]},{"verse":7,"text":"そこでわたしは言いました。『さあ、わたしは来ました。聖書のある巻に、わたしについてしるされているとおり、神よ、あなたのみこころを行うために。』」","tok":[["そこ"],["で"],["わたし"],["は"],["言いました","いいました"],["。"],["『"],["さあ"],["、"],["わたし"],["は"],["来ました","きました"],["。"],["聖書","せいしょ"],["の"],["ある"],["巻","まき"],["に"],["、"],["わたし"],["について"],["しるされて"],["いる"],["とおり"],["、"],["神","かみ"],["よ"],["、"],["あなた"],["のみ"],["こころ"],["を"],["行う","おこなう"],["ため"],["に"],["。"],["』"],["」"]]},{"verse":8,"text":"すなわち、初めには、「あなたは、いけにえとささげ物、全焼のいけにえと罪のためのいけにえ(すなわち、律法に従ってささげられる、いろいろの物)を望まず、またそれらで満足されませんでした」と言い、","tok":[["すなわち"],["、"],["初め","はじめ"],["に"],["は"],["、"],["「"],["あなた"],["は"],["、"],["いけにえ"],["と"],["ささげ物","ささげもの"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["罪","つみ"],["の"],["ため"],["の"],["いけにえ"],["("],["すなわち"],["、"],["律法","りっぽう"],["に"],["従って","したがって"],["ささげられる"],["、"],["いろいろ"],["の"],["物","もの"],[")"],["を"],["望まず","のぞまず"],["、"],["また"],["それ"],["ら"],["で"],["満足","まんぞく"],["されませんでした"],["」"],["と"],["言い","いい"],["、"]]},{"verse":9,"text":"また、「さあ、わたしはあなたのみこころを行うために来ました」と言われたのです。後者が立てられるために、前者が廃止されるのです。","tok":[["また"],["、"],["「"],["さあ"],["、"],["わたし"],["は"],["あなた"],["のみ"],["こころ"],["を"],["行う","おこなう"],["ため"],["に"],["来ました","きました"],["」"],["と"],["言われた","いわれた"],["の"],["です"],["。"],["後者","こうしゃ"],["が"],["立てられる","たてられる"],["ため"],["に"],["、"],["前者","ぜんしゃ"],["が"],["廃止","はいし"],["される"],["の"],["です"],["。"]]},{"verse":10,"text":"このみこころに従って、イエス・キリストのからだが、ただ一度だけささげられたことにより、私たちは聖なるものとされているのです。","tok":[["この"],["みこころ"],["に"],["従って","したがって"],["、"],["イエス"],["・"],["キリスト"],["の"],["からだ"],["が"],["、"],["ただ"],["一度","いちど"],["だけ"],["ささげられた"],["こと"],["に"],["より"],["、"],["私たち","わたしたち"],["は"],["聖","せい"],["なる"],["もの"],["と"],["されて"],["いる"],["の"],["です"],["。"]]},{"verse":11,"text":"また、すべて祭司は毎日立って礼拝の務めをなし、同じいけにえをくり返しささげますが、それらは決して罪を除き去ることができません。","tok":[["また"],["、"],["すべて"],["祭司","さいし"],["は"],["毎日","まいにち"],["立って","たって"],["礼拝","れいはい"],["の"],["務め","つとめ"],["を"],["なし"],["、"],["同じ","おなじ"],["いけにえ"],["を"],["くり返し","くりかえし"],["ささげます"],["が"],["、"],["それ"],["ら"],["は"],["決して","けっして"],["罪","つみ"],["を"],["除き去る","のぞきさる"],["こと"],["が"],["できません"],["。"]]},{"verse":12,"text
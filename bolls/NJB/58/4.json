[{"verse":1,"text":"こういうわけで、神の安息に入るための約束はまだ残っているのですから、あなたがたのうちのひとりでも、万が一にもこれに入れないようなことのないように、私たちは恐れる心を持とうではありませんか。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["神","かみ"],["の"],["安息","あんそく"],["に"],["入る","はいる"],["ため"],["の"],["約束","やくそく"],["は"],["まだ"],["残って","のこって"],["いる"],["の"],["です"],["から"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["ひとり"],["で"],["も"],["、"],["万が一","まんがいち"],["に"],["も"],["これ"],["に"],["入れない","いれない"],["よう"],["な"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["私たち","わたしたち"],["は"],["恐れる","おそれる"],["心","こころ"],["を"],["持とうで","もとうで"],["は"],["ありません"],["か"],["。"]]},{"verse":2,"text":"福音を説き聞かされていることは、私たちも彼らと同じなのです。ところが、その聞いたみことばも、彼らには益になりませんでした。みことばが、それを聞いた人たちに、信仰によって、結びつけられなかったからです。","tok":[["福音","ふくいん"],["を"],["説き聞かされて","とききかされて"],["いる"],["こと"],["は"],["、"],["私たち","わたしたち"],["も"],["彼","かれ"],["ら"],["と"],["同じ","おなじ"],["な"],["の"],["です"],["。"],["ところ"],["が"],["、"],["その"],["聞いた","きいた"],["みことば"],["も"],["、"],["彼","かれ"],["ら"],["に"],["は"],["益","えき"],["に"],["なりませんでした"],["。"],["みことば"],["が"],["、"],["それ"],["を"],["聞いた","きいた"],["人","ひと"],["たち"],["に"],["、"],["信仰","しんこう"],["によって"],["、"],["結びつけられなかった","むすびつけられなかった"],["から"],["です"],["。"]]},{"verse":3,"text":"信じた私たちは安息に入るのです。「わたしは、怒りをもって誓ったように、決して彼らをわたしの安息に入らせない。」と神が言われたとおりです。みわざは創世の初めから、もう終わっているのです。","tok":[["信じた","しんじた"],["私たち","わたしたち"],["は"],["安息","あんそく"],["に"],["入る","はいる"],["の"],["です"],["。"],["「"],["わたし"],["は"],["、"],["怒り","いかり"],["を"],["もって"],["誓った","ちかった"],["よう"],["に"],["、"],["決して","けっして"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["安息","あんそく"],["に"],["入らせない","はいらせない"],["。"],["」"],["と"],["神","かみ"],["が"],["言われた","いわれた"],["とおり"],["です"],["。"],["みわざ"],["は"],["創世","そうせい"],["の"],["初め","はじめ"],["から"],["、"],["もう"],["終わって","おわって"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"というのは、神は七日目について、ある個所で、「そして、神は、すべてのみわざを終えて七日目に休まれた」と言われました。","tok":[["と"],["いう"],["の"],["は"],["、"],["神","かみ"],["は"],["七日目","ななかめ"],["について"],["、"],["ある"],["個所","かしょ"],["で"],["、"],["「"],["そして"],["、"],["神","かみ"],["は"],["、"],["すべて"],["のみ"],["わざ"],["を"],["終えて","おえて"],["七日目","ななかめ"],["に"],["休まれた","やすまれた"],["」"],["と"],["言われました","いわれました"],["。"]]},{"verse":5,"text":"そして、ここでは、「決して彼らをわたしの安息に入らせない」と言われたのです。","tok":[["そして"],["、"],["ここ"],["で"],["は"],["、"],["「"],["決して","けっして"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["安息","あんそく"],["に"],["入らせない","はいらせない"],["」"],["と"],["言われた","いわれた"],["の"],["です"],["。"]]},{"verse":6,"text":"こういうわけで、その安息に入る人々がまだ残っており、前に福音を説き聞かされた人々は、不従順のゆえに入れなかったのですから、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["その"],["安息","あんそく"],["に"],["入る","はいる"],["人々","ひとびと"],["が"],["まだ"],["残って","のこって"],["おり"],["、"],["前","まえ"],["に"],["福音","ふくいん"],["を"],["説き聞かされた","とききかされた"],["人々","ひとびと"],["は"],["、"],["不","ふ"],["従順","じゅうじゅん"],["の"],["ゆえ"],["に"],["入れなかった","いれなかった"],["の"],["です"],["から"],["、"]]},{"verse":7,"text":"神は再びある日を「きょう」と定めて、長い年月の後に、前に言われたと同じように、ダビデを通して、「きょう、もし御声を聞くならば、あなたがたの心をかたくなにしてはならない。」／と語られたのです。","tok":[["神","かみ"],["は"],["再び","ふたたび"],["ある"],["日","ひ"],["を"],["「"],["きょう"],["」"],["と"],["定めて","さだめて"],["、"],["長い","ながい"],["年月","としつき"],["の"],["後","あと"],["に"],["、"],["前","まえ"],["に"],["言われた","いわれた"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["ダビデ"],["を"],["通して","とおして"],["、"],["「"],["きょう"],["、"],["もし"],["御声","おこえ"],["を"],["聞くならば","きくならば"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["。"],["」"],["／"],["と"],["語られた","かたられた"],["の"],["です"],["。"]]},{"verse":8,"text":"もしヨシュアが彼らに安息を与えたのであったら、神はそのあとで別の日のことを話されることはなかったでしょう。","tok":[["もし"],["ヨシュア"],["が"],["彼","かれ"],["ら"],["に"],["安息","あんそく"],["を"],["与えた","あたえた"],["ので"],["あったら"],["、"],["神","かみ"],["は"],["その"],["あと"],["で"],["別","べつ"],["の"],["日","ひ"],["の"],["こと"],["を"],["話される","はなされる"],["こと"],["は"],["なかったでしょう"],["。"]]},{"verse":9,"text":"したがって、安息日の休みは、神の民のためにまだ残っているのです。","tok":[["したがって"],["、"],["安息日","あんそくび"],["の"],["休み","やすみ"],["は"],["、"],["神","かみ"],["の"],["民","たみ"],["の"],["ため"],["に"],["まだ"],["残って","のこって"],["いる"],["の"],["です"],["。"]]},{"verse":10,"text":"神の安息に入った者ならば、神がご自分のわざを終えて休まれたように、自分のわざを終えて休んだはずです。","tok":[["神","かみ"],["の"],["安息","あんそく"],["に"],["入った","はいった"],["者","もの"],["ならば"],["、"],["神","かみ"],["が"],["ご自分","ごじぶん"],["の"],["わざ"],["を"],["終えて","おえて"],["休まれた","やすまれた"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["わざ"],["を"],["終えて","おえて"],["休んだ","やすんだ"],["はず"],["です"],["。"]]},{"verse":11,"text":"ですから、私たちは、この安息に入るよう力を尽くして努め、あの不従順の例にならって落後する者が、ひとりもいないようにしようではありませんか。","tok":[["です"],["から"],["、"],["私たち","わたしたち"],["は"],["、"],["この"],["安息","あんそく"],["に"],["入る","はいる"],["よう"],["力","ちから"],["を"],["尽くして","つくして"],["努め","つとめ"],["、"],["あの"],["不","ふ"],["従順","じゅうじゅん"],["の"],["例","れい"],["に"],["ならって"],["落後","らくご"],["する"],["者","もの"],["が"],["、"],["ひとり"],["も"],["いない"],["よう"],["に"],["しようで"],["は"],["ありません"],["か"],["。"]]},{"verse":12,"text":"神のことばは生きていて、力があり、両刃の剣よりも鋭く、たましいと霊、関節と骨髄の分かれ目さえも刺し通し、心のいろいろな考えやはかりごとを判別することができます。","tok":[["神","かみ"],["の"],["ことば"],["は"],["生きて","いきて"],["いて"],["、"],["力","ちから"],["が"],["あり"],["、"],["両刃","りょうば"],["の"],["剣","けん"],["より"],["も"],["鋭く","するどく"],["、"],["たましい"],["と"],["霊","れい"],["、"],["関節","かんせつ"],["と"],["骨髄","こつずい"],["の"],["分かれ目","わかれめ"],["さえ"],["も"],["刺し通し","さしとおし"],["、"],["心","こころ"],["の"],["いろいろ"],["な"],["考え","かんがえ"],["や"],["はかりごと"],["を"],["判別","はんべつ"],["する"],["こと"],["が"],["できます"],["。"]]},{"verse":13,"text":"造られたもので、神の前で隠れおおせるものは何一つなく、神の目には、すべてが裸であり、さらけ出されています。私たちはこの神に対して弁明をするのです。","tok":[["造られた","つくられた"],["もの"],["で"],["、"],["神","かみ"],["の"],["前","まえ"],["で"],["隠れ","かくれ"],["おおせる"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["なく"],["、"],["神","かみ"],["の"],["目","め"],["に"],["は"],["、"],["すべて"],["が"],["裸","はだか"],["で"],["あり"],["、"],["さらけ出されて","さらけだされて"],["います"],["。"],["私たち","わたしたち"],["は"],["この"],["神","かみ"],["に対して","にたいして"],["弁明","べんめい"],["を"],["する"],["の"],["です"],["。"]]},{"verse":14,"text":"さて、私たちのためには、もろもろの天を通られた偉大な大祭司である神の子イエスがおられるのですから、私たちの信仰の告白を堅く保とうではありませんか。","tok":[["さて"],["、"],["私たち","わたしたち"],["の"],["ため"],["に"],["は"],["、"],["もろもろ"],["の"],["天","てん"],["を"],["通られた","とおられた"],["偉大","いだい"],["な"],["大","だい"],["祭司","さいし"],["で"],["ある"],["神","かみ"],["の"],["子","こ"],["イエス"],["が"],["おられる"],["の"],["です"],["から"],["、"],["私たち","わたしたち"],["の"],["信仰","しんこう"],["の"],["告白","こくはく"],["を"],["堅く","かたく"],["保とうで","たもとうで"],["は"],["ありません"],["か"],["。"]]},{"verse":15,"text":"私たちの大祭司は、私たちの弱さに同情できない方ではありません。罪は犯されませんでしたが、すべての点で、私たちと同じように、試みに会われたのです。","tok":[["私たち","わたしたち"],["の"],["大","だい"],["祭司","さいし"],["は"],["、"],["私たち","わたしたち"],["の"],["弱","よわ"],["さ"],["に"],["同情","どうじょう"],["できない"],["方","ほう"],["で"],["は"],["ありません"],["。"],["罪","つみ"],["は"],["犯されませんでした","おかされませんでした"],["が"],["、"],["すべて"],["の"],["点","てん"],["で"],["、"],["私たち","わたしたち"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["試み","こころみ"],["に"],["会われた","あわれた"],["の"],["です"],["。"]]},{"verse":16,"text":"ですから、私たちは、あわれみを受け、また恵みをいただいて、おりにかなった助けを受けるために、大胆に恵みの御座に近づこうではありませんか。","tok":[["です"],["から"],["、"],["私たち","わたしたち"],["は"],["、"],["あわれみ"],["を"],["受け","うけ"],["、"],["また"],["恵み","めぐみ"],["を"],["いただいて"],["、"],["おり"],["に"],["かなった"],["助け","たすけ"],["を"],["受ける","うける"],["ため"],["に"],["、"],["大胆","だいたん"],["に"],["恵み","めぐみ"],["の"],["御座","ぎょざ"],["に"],["近づこうで","ちかづこうで"],["は"],["ありません"],["か"],["。"]]}]
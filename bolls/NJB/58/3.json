[{"verse":1,"text":"そういうわけですから、天の召しにあずかっている聖なる兄弟たち。私たちの告白する信仰の使徒であり、大祭司であるイエスのことを考えなさい。","tok":[["そう"],["いう"],["わけ"],["です"],["から"],["、"],["天","てん"],["の"],["召し","めし"],["に"],["あずかって"],["いる"],["聖","せい"],["なる"],["兄弟","きょうだい"],["たち"],["。"],["私たち","わたしたち"],["の"],["告白","こくはく"],["する"],["信仰","しんこう"],["の"],["使徒","しと"],["で"],["あり"],["、"],["大","だい"],["祭司","さいし"],["で"],["ある"],["イエス"],["の"],["こと"],["を"],["考え","かんがえ"],["なさい"],["。"]]},{"verse":2,"text":"モーセが神の家全体のために忠実であったのと同様に、イエスはご自分を立てた方に対して忠実なのです。","tok":[["モーセ"],["が"],["神","かみ"],["の"],["家","いえ"],["全体","ぜんたい"],["の"],["ため"],["に"],["忠実","ちゅうじつ"],["で"],["あった"],["の"],["と"],["同様","どうよう"],["に"],["、"],["イエス"],["は"],["ご自分","ごじぶん"],["を"],["立てた","たてた"],["方","ほう"],["に対して","にたいして"],["忠実","ちゅうじつ"],["な"],["の"],["です"],["。"]]},{"verse":3,"text":"家よりも、家を建てる者が大きな栄誉を持つのと同様に、イエスはモーセよりも大きな栄光を受けるのにふさわしいとされました。","tok":[["家","いえ"],["より"],["も"],["、"],["家","いえ"],["を"],["建てる","たてる"],["者","もの"],["が"],["大きな","おおきな"],["栄誉","えいよ"],["を"],["持つ","もつ"],["の"],["と"],["同様","どうよう"],["に"],["、"],["イエス"],["は"],["モーセ"],["より"],["も"],["大きな","おおきな"],["栄光","えいこう"],["を"],["受ける","うける"],["のに"],["ふさわしい"],["と"],["されました"],["。"]]},{"verse":4,"text":"家はそれぞれ、だれかが建てるのですが、すべてのものを造られた方は、神です。","tok":[["家","いえ"],["は"],["それぞれ"],["、"],["だれ"],["か"],["が"],["建てる","たてる"],["の"],["です"],["が"],["、"],["すべて"],["の"],["もの"],["を"],["造られた","つくられた"],["方","ほう"],["は"],["、"],["神","かみ"],["です"],["。"]]},{"verse":5,"text":"モーセは、しもべとして神の家全体のために忠実でした。それは、後に語られる事をあかしするためでした。","tok":[["モーセ"],["は"],["、"],["しもべ"],["として"],["神","かみ"],["の"],["家","いえ"],["全体","ぜんたい"],["の"],["ため"],["に"],["忠実","ちゅうじつ"],["でした"],["。"],["それ"],["は"],["、"],["後","あと"],["に"],["語られる","かたられる"],["事","こと"],["を"],["あかし"],["する"],["ため"],["でした"],["。"]]},{"verse":6,"text":"しかし、キリストは御子として神の家を忠実に治められるのです。もし私たちが、確信と、希望による誇りとを、終わりまでしっかりと持ち続けるならば、私たちが神の家なのです。","tok":[["しかし"],["、"],["キリスト"],["は"],["御子","みこ"],["として"],["神","かみ"],["の"],["家","いえ"],["を"],["忠実","ちゅうじつ"],["に"],["治められる","おさめられる"],["の"],["です"],["。"],["もし"],["私たち","わたしたち"],["が"],["、"],["確信","かくしん"],["と"],["、"],["希望","きぼう"],["に"],["よる"],["誇り","ほこり"],["と"],["を"],["、"],["終わり","おわり"],["まで"],["しっかり"],["と"],["持ち","もち"],["続けるならば","つづけるならば"],["、"],["私たち","わたしたち"],["が"],["神","かみ"],["の"],["家","いえ"],["な"],["の"],["です"],["。"]]},{"verse":7,"text":"ですから、聖霊が言われるとおりです。「きょう、もし御声を聞くならば、","tok":[["です"],["から"],["、"],["聖霊","せいれい"],["が"],["言われる","いわれる"],["とおり"],["です"],["。"],["「"],["きょう"],["、"],["もし"],["御声","おこえ"],["を"],["聞くならば","きくならば"],["、"]]},{"verse":8,"text":"荒野での試みの日に御怒りを引き起こしたときのように、心をかたくなにしてはならない。","tok":[["荒野","こうや"],["で"],["の"],["試み","こころみ"],["の"],["日","ひ"],["に"],["御怒り","おいかり"],["を"],["引き起こした","ひきおこした"],["とき"],["の"],["よう"],["に"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["。"]]},{"verse":9,"text":"あなたがたの父祖たちは、そこでわたしを試みて証拠を求め、四十年の間、わたしのわざを見た。","tok":[["あなた"],["がた"],["の"],["父祖","ふそ"],["たち"],["は"],["、"],["そこ"],["で"],["わたし"],["を"],["試みて","こころみて"],["証拠","しょうこ"],["を"],["求め","もとめ"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["わたし"],["の"],["わざ"],["を"],["見た","みた"],["。"]]},{"verse":10,"text":"だから、わたしはその時代を憤って言った。彼らは常に心が迷い、わたしの道を悟らなかった。","tok":[["だ"],["から"],["、"],["わたし"],["は"],["その"],["時代","じだい"],["を"],["憤って","いきどおって"],["言った","いった"],["。"],["彼","かれ"],["ら"],["は"],["常","つね"],["に"],["心","こころ"],["が"],["迷い","まよい"],["、"],["わたし"],["の"],["道","みち"],["を"],["悟らなかった","さとらなかった"],["。"]]},{"verse":11,"text":"わたしは、怒りをもって誓ったように、決して彼らをわたしの安息に入らせない。」","tok":[["わたし"],["は"],["、"],["怒り","いかり"],["を"],["もって"],["誓った","ちかった"],["よう"],["に"],["、"],["決して","けっして"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["安息","あんそく"],["に"],["入らせない","はいらせない"],["。"],["」"]]},{"verse":12,"text":"兄弟たち。あなたがたの中では、だれも悪い不信仰の心になって生ける神から離れる者がないように気をつけなさい。","tok":[["兄弟","きょうだい"],["たち"],["。"],["あなた"],["がた"],["の"],["中","なか"],["で"],["は"],["、"],["だれ"],["も"],["悪い","わるい"],["不","ふ"],["信仰","しんこう"],["の"],["心","こころ"],["に"],["なって"],["生ける","いける"],["神","かみ"],["から"],["離れる","はなれる"],["者","もの"],["が"],["ない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":13,"text":"「きょう」と言われている間に、日々互いに励まし合って、だれも罪に惑わされてかたくなにならないようにしなさい。","tok":[["「"],["きょう"],["」"],["と"],["言われて","いわれて"],["いる"],["間","あいだ"],["に"],["、"],["日々","ひび"],["互い","たがい"],["に"],["励まし合って","はげましあって"],["、"],["だれ"],["も"],["罪","つみ"],["に"],["惑わされて","まどわされて"],["かたくな"],["に"],["ならない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":14,"text":"もし最初の確信を終わりまでしっかり保ちさえすれば、私たちは、キリストにあずかる者となるのです。","tok":[["もし"],["最初","さいしょ"],["の"],["確信","かくしん"],["を"],["終わり","おわり"],["まで"],["しっかり"],["保ち","たもち"],["さえ"],["すれば"],["、"],["私たち","わたしたち"],["は"],["、"],["キリスト"],["に"],["あずかる"],["者","もの"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":15,"text":"「きょう、もし御声を聞くならば、御怒りを引き起こしたときのように、心をかたくなにしてはならない。」／と言われているからです。","tok":[["「"],["きょう"],["、"],["もし"],["御声","おこえ"],["を"],["聞くならば","きくならば"],["、"],["御怒り","おいかり"],["を"],["引き起こした","ひきおこした"],["とき"],["の"],["よう"],["に"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["。"],["」"],["／"],["と"],["言われて","いわれて"],["いる"],["から"],["です"],["。"]]},{"verse":16,"text":"聞いていながら、御怒りを引き起こしたのはだれでしたか。モーセに率いられてエジプトを出た人々の全部ではありませんか。","tok":[["聞いて","きいて"],["い"],["ながら"],["、"],["御怒り","おいかり"],["を"],["引き起こした","ひきおこした"],["の"],["は"],["だれ"],["でした"],["か"],["。"],["モーセ"],["に"],["率いられて","ひきいられて"],["エジプト"],["を"],["出た","でた"],["人々","ひとびと"],["の"],["全部","ぜんぶ"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":17,"text":"神は四十年の間だれを怒っておられたのですか。罪を犯した人々、しかばねを荒野にさらした、あの人たちをではありませんか。","tok":[["神","かみ"],["は"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["だれ"],["を"],["怒って","おこって"],["おられた"],["の"],["です"],["か"],["。"],["罪","つみ"],["を"],["犯した","おかした"],["人々","ひとびと"],["、"],["しかばね"],["を"],["荒野","あらの"],["に"],["さらした"],["、"],["あの"],["人","ひと"],["たち"],["を"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":18,"text":"また、わたしの安息に入らせないと神が誓われたのは、ほかでもない、従おうとしなかった人たちのことではありませんか。","tok":[["また"],["、"],["わたし"],["の"],["安息","あんそく"],["に"],["入らせない","はいらせない"],["と"],["神","かみ"],["が"],["誓われた","ちかわれた"],["の"],["は"],["、"],["ほか"],["で"],["も"],["ない"],["、"],["従おう","したがおう"],["と"],["しなかった"],["人","ひと"],["たち"],["の"],["こと"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":19,"text":"それゆえ、彼らが安息に入れなかったのは、不信仰のためであったことがわかります。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["が"],["安息","あんそく"],["に"],["入れなかった","いれなかった"],["の"],["は"],["、"],["不","ふ"],["信仰","しんこう"],["の"],["ため"],["で"],["あった"],["こと"],["が"],["わかります"],["。"]]}]
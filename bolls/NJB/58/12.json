[{"verse":1,"text":"こういうわけで、このように多くの証人たちが、雲のように私たちを取り巻いているのですから、私たちも、いっさいの重荷とまつわりつく罪とを捨てて、私たちの前に置かれている競走を忍耐をもって走り続けようではありませんか。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["この"],["よう"],["に"],["多く","おおく"],["の"],["証人","しょうにん"],["たち"],["が"],["、"],["雲","くも"],["の"],["よう"],["に"],["私たち","わたしたち"],["を"],["取り巻いて","とりまいて"],["いる"],["の"],["です"],["から"],["、"],["私たち","わたしたち"],["も"],["、"],["いっさい"],["の"],["重荷","おもに"],["と"],["まつわりつく"],["罪","つみ"],["と"],["を"],["捨てて","すてて"],["、"],["私たち","わたしたち"],["の"],["前","まえ"],["に"],["置かれて","おかれて"],["いる"],["競走","きょうそう"],["を"],["忍耐","にんたい"],["を"],["もって"],["走り","はしり"],["続けようで","つづけようで"],["は"],["ありません"],["か"],["。"]]},{"verse":2,"text":"信仰の創始者であり、完成者であるイエスから目を離さないでいなさい。イエスは、ご自分の前に置かれた喜びのゆえに、はずかしめをものともせずに十字架を忍び、神の御座の右に着座されました。","tok":[["信仰","しんこう"],["の"],["創始者","そうししゃ"],["で"],["あり"],["、"],["完成者","かんせいしゃ"],["で"],["ある"],["イエス"],["から"],["目","め"],["を"],["離さないで","はなさないで"],["い"],["なさい"],["。"],["イエス"],["は"],["、"],["ご自分","ごじぶん"],["の"],["前","まえ"],["に"],["置かれた","おかれた"],["喜び","よろこび"],["の"],["ゆえ"],["に"],["、"],["はずかしめ"],["を"],["もの"],["と"],["も"],["せず"],["に"],["十字架","じゅうじか"],["を"],["忍び","しのび"],["、"],["神","かみ"],["の"],["御座","ぎょざ"],["の"],["右","みぎ"],["に"],["着座","ちゃくざ"],["されました"],["。"]]},{"verse":3,"text":"あなたがたは、罪人たちのこのような反抗を忍ばれた方のことを考えなさい。それは、あなたがたの心が元気を失い、疲れ果ててしまわないためです。","tok":[["あなた"],["がた"],["は"],["、"],["罪人","ざいにん"],["たち"],["の"],["この"],["よう"],["な"],["反抗","はんこう"],["を"],["忍ばれた","しのばれた"],["方","ほう"],["の"],["こと"],["を"],["考え","かんがえ"],["なさい"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["が"],["元気","げんき"],["を"],["失い","うしない"],["、"],["疲れ","つかれ"],["果てて","はてて"],["しまわない"],["ため"],["です"],["。"]]},{"verse":4,"text":"あなたがたはまだ、罪と戦って、血を流すまで抵抗したことがありません。","tok":[["あなた"],["がた"],["は"],["まだ"],["、"],["罪","つみ"],["と"],["戦って","たたかって"],["、"],["血","ち"],["を"],["流す","ながす"],["まで"],["抵抗","ていこう"],["した"],["こと"],["が"],["ありません"],["。"]]},{"verse":5,"text":"そして、あなたがたに向かって子どもに対するように語られたこの勧めを忘れています。「わが子よ。主の懲らしめを軽んじてはならない。主に責められて弱り果ててはならない。","tok":[["そして"],["、"],["あなた"],["がた"],["に"],["向かって","むかって"],["子
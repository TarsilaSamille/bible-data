[{"verse":1,"text":"神は、むかし父祖たちに、預言者たちを通して、多くの部分に分け、また、いろいろな方法で語られましたが、","tok":[["神","かみ"],["は"],["、"],["むかし"],["父祖","ふそ"],["たち"],["に"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["、"],["多く","おおく"],["の"],["部分","ぶぶん"],["に"],["分け","わけ"],["、"],["また"],["、"],["いろいろ"],["な"],["方法","ほうほう"],["で"],["語られました","かたられました"],["が"],["、"]]},{"verse":2,"text":"この終わりの時には、御子によって、私たちに語られました。神は、御子を万物の相続者とし、また御子によって世界を造られました。","tok":[["この"],["終わり","おわり"],["の"],["時","とき"],["に"],["は"],["、"],["御子","みこ"],["によって"],["、"],["私たち","わたしたち"],["に"],["語られました","かたられました"],["。"],["神","かみ"],["は"],["、"],["御子","みこ"],["を"],["万物","ばんぶつ"],["の"],["相続者","そうぞくしゃ"],["と"],["し"],["、"],["また"],["御子","みこ"],["によって"],["世界","せかい"],["を"],["造られました","つくられました"],["。"]]},{"verse":3,"text":"御子は神の栄光の輝き、また神の本質の完全な現れであり、その力あるみことばによって万物を保っておられます。また、罪のきよめを成し遂げて、すぐれて高い所の大能者の右の座に着かれました。","tok":[["御子","みこ"],["は"],["神","かみ"],["の"],["栄光","えいこう"],["の"],["輝き","かがやき"],["、"],["また"],["神","かみ"],["の"],["本質","ほんしつ"],["の"],["完全","かんぜん"],["な"],["現れ","あらわれ"],["で"],["あり"],["、"],["その"],["力","ちから"],["ある"],["みことば"],["によって"],["万物","ばんぶつ"],["を"],["保って","たもって"],["おられます"],["。"],["また"],["、"],["罪","つみ"],["の"],["きよ"],["め"],["を"],["成し遂げて","なしとげて"],["、"],["すぐれて"],["高い","たかい"],["所","ところ"],["の"],["大能者","おおのしゃ"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着かれました","つかれました"],["。"]]},{"verse":4,"text":"御子は、御使いたちよりもさらにすぐれた御名を相続されたように、それだけ御使いよりもまさるものとなられました。","tok":[["御子","みこ"],["は"],["、"],["御使い","おつかい"],["たち"],["より"],["も"],["さらに"],["すぐれた"],["御名","ぎょめい"],["を"],["相続","そうぞく"],["された"],["よう"],["に"],["、"],["それ"],["だけ"],["御使い","おつかい"],["より"],["も"],["まさる"],["もの"],["と"],["なられました"],["。"]]},{"verse":5,"text":"神は、かつてどの御使いに向かって、こう言われたでしょう。「あなたは、わたしの子。きょう、わたしがあなたを生んだ。」またさらに、「わたしは彼の父となり、彼はわたしの子となる。」","tok":[["神","かみ"],["は"],["、"],["かつて"],["どの"],["御使い","おつかい"],["に"],["向かって","むかって"],["、"],["こう"],["言われたでしょう","いわれたでしょう"],["。"],["「"],["あなた"],["は"],["、"],["わたし"],["の"],["子","こ"],["。"],["きょう"],["、"],["わたし"],["が"],["あなた"],["を"],["生んだ","うんだ"],["。"],["」"],["また"],["さらに"],["、"],["「"],["わたし"],["は"],["彼","かれ"],["の"],["父","ちち"],["と"],["なり"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["子","こ"],["と"],["なる"],["。"],["」"]]},{"verse":6,"text":"さらに、長子をこの世界にお送りになるとき、こう言われました。「神の御使いはみな、彼を拝め。」","tok":[["さらに"],["、"],["長子","ちょうし"],["を"],["この"],["世界","せかい"],["に"],["お送り","おおくり"],["に"],["なる"],["とき"],["、"],["こう"],["言われました","いわれました"],["。"],["「"],["神","かみ"],["の"],["御使い","おつかい"],["は"],["みな"],["、"],["彼","かれ"],["を"],["拝め","おがめ"],["。"],["」"]]},{"verse":7,"text":"また御使いについては、「神は、御使いたちを風とし、仕える者たちを炎とされる。」／と言われましたが、","tok":[["また"],["御使い","おつかい"],["について"],["は"],["、"],["「"],["神","かみ"],["は"],["、"],["御使い","おつかい"],["たち"],["を"],["風","かぜ"],["と"],["し"],["、"],["仕える","つかえる"],["者","もの"],["たち"],["を"],["炎","ほのお"],["と"],["される"],["。"],["」"],["／"],["と"],["言われました","いわれました"],["が"],["、"]]},{"verse":8,"text":"御子については、こう言われます。「神よ。あなたの御座は世々限りなく、あなたの御国の杖こそ、まっすぐな杖です。","tok":[["御子","みこ"],["について"],["は"],["、"],["こう"],["言われます","いわれます"],["。"],["「"],["神","かみ"],["よ"],["。"],["あなた"],["の"],["御座","ぎょざ"],["は"],["世々","せいせい"],["限りなく","かぎりなく"],["、"],["あなた"],["の"],["御国","みくに"],["の"],["杖","つえ"],["こそ"],["、"],["まっすぐ"],["な"],["杖","つえ"],["です"],["。"]]},{"verse":9,"text":"あなたは義を愛し、不正を憎まれます。それゆえ、神よ。あなたの神は、あふれるばかりの喜びの油を、あなたとともに立つ者にまして、あなたに注ぎなさいました。」","tok":[["あなた"],["は"],["義","ぎ"],["を"],["愛し","あいし"],["、"],["不正","ふせい"],["を"],["憎まれます","にくまれます"],["。"],["それ"],["ゆえ"],["、"],["神","かみ"],["よ"],["。"],["あなた"],["の"],["神","かみ"],["は"],["、"],["あふれる"],["ばかり"],["の"],["喜び","よろこび"],["の"],["油","あぶら"],["を"],["、"],["あなた"],["と"],["とも"],["に"],["立つ","たつ"],["者","もの"],["に"],["ま"],["して"],["、"],["あなた"],["に"],["注ぎ","そそぎ"],["なさいました"],["。"],["」"]]},{"verse":10,"text":"またこう言われます。「主よ。あなたは、初めに地の基を据えられました。天も、あなたの御手のわざです。","tok":[["また"],["こう"],["言われます","いわれます"],["。"],["「"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["、"],["初め","はじめ"],["に"],["地","ち"],["の"],["基","もと"],["を"],["据えられました","すえられました"],["。"],["天","てん"],["も"],["、"],["あなた"],["の"],["御手","おて"],["の"],["わざ"],["です"],["。"]]},{"verse":11,"text":"これらのものは滅びます。しかし、あなたはいつまでもながらえられます。すべてのものは着物のように古びます。","tok":[["これ"],["ら"],["の"],["もの"],["は"],["滅びます","ほろびます"],["。"],["しかし"],["、"],["あなた"],["は"],["いつ"],["まで"],["も"],["ながらえられます"],["。"],["すべて"],["の"],["もの"],["は"],["着物","きもの"],["の"],["よう"],["に"],["古びます","ふるびます"],["。"]]},{"verse":12,"text":"あなたはこれらを、外套のように巻かれます。これらを、着物のように取り替えられます。しかし、あなたは変わることがなく、あなたの年は尽きることがありません。」","tok":[["あなた"],["は"],["これ"],["ら"],["を"],["、"],["外套","がいとう"],["の"],["よう"],["に"],["巻かれます","まかれます"],["。"],["これ"],["ら"],["を"],["、"],["着物","きもの"],["の"],["よう"],["に"],["取り替えられます","とりかえられます"],["。"],["しかし"],["、"],["あなた"],["は"],["変わる","かわる"],["こと"],["が"],["なく"],["、"],["あなた"],["の"],["年","とし"],["は"],["尽きる","つきる"],["こと"],["が"],["ありません"],["。"],["」"]]},{"verse":13,"text":"神は、かつてどの御使いに向かって、こう言われたでしょう。「わたしがあなたの敵をあなたの足台とするまでは、わたしの右の座に着いていなさい。」","tok":[["神","かみ"],["は"],["、"],["かつて"],["どの"],["御使い","おつかい"],["に"],["向かって","むかって"],["、"],["こう"],["言われたでしょう","いわれたでしょう"],["。"],["「"],["わたし"],["が"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["足台","あしだい"],["と"],["する"],["まで"],["は"],["、"],["わたし"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着いて","ついて"],["い"],["なさい"],["。"],["」"]]},{"verse":14,"text":"御使いはみな、仕える霊であって、救いの相続者となる人々に仕えるため遣わされたのではありませんか。","tok":[["御使い","おつかい"],["は"],["みな"],["、"],["仕える","つかえる"],["霊","れい"],["で"],["あって"],["、"],["救い","すくい"],["の"],["相続者","そうぞくしゃ"],["と"],["なる"],["人々","ひとびと"],["に"],["仕える","つかえる"],["ため"],["遣わされた","つかわされた"],["ので"],["は"],["ありません"],["か"],["。"]]}]
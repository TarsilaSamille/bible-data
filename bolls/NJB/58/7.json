[{"verse":1,"text":"このメルキゼデクは、サレムの王で、すぐれて高い神の祭司でしたが、アブラハムが王たちを打ち破って帰るのを出迎えて祝福しました。","tok":[["この"],["メルキゼデク"],["は"],["、"],["サレム"],["の"],["王","おう"],["で"],["、"],["すぐれて"],["高い","たかい"],["神","かみ"],["の"],["祭司","さいし"],["でした"],["が"],["、"],["アブラハム"],["が"],["王","おう"],["たち"],["を"],["打ち破って","うちやぶって"],["帰る","かえる"],["の"],["を"],["出迎えて","でむかえて"],["祝福","しゅくふく"],["しました"],["。"]]},{"verse":2,"text":"またアブラハムは彼に、すべての戦利品の十分の一を分けました。まず彼は、その名を訳すと義の王であり、次に、サレムの王、すなわち平和の王です。","tok":[["また"],["アブラハム"],["は"],["彼","かれ"],["に"],["、"],["すべて"],["の"],["戦利品","せんりひん"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["分けました","わけました"],["。"],["まず"],["彼","かれ"],["は"],["、"],["その"],["名","な"],["を"],["訳す","やくす"],["と"],["義","ぎ"],["の"],["王","おう"],["で"],["あり"],["、"],["次","つぎ"],["に"],["、"],["サレム"],["の"],["王","おう"],["、"],["すなわち"],["平和","へいわ"],["の"],["王","おう"],["です"],["。"]]},{"verse":3,"text":"父もなく、母もなく、系図もなく、その生涯の初めもなく、いのちの終わりもなく、神の子に似た者とされ、いつまでも祭司としてとどまっているのです。","tok":[["父","ちち"],["も"],["なく"],["、"],["母","はは"],["も"],["なく"],["、"],["系図","けいず"],["も"],["なく"],["、"],["その"],["生涯","しょうがい"],["の"],["初め","はじめ"],["も"],["なく"],["、"],["いのち"],["の"],["終わり","おわり"],["も"],["なく"],["、"],["神","かみ"],["の"],["子","こ"],["に"],["似た","にた"],["者","もの"],["と"],["され"],["、"],["いつ"],["まで"],["も"],["祭司","さいし"],["として"],["とどまって"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"その人がどんなに偉大であるかを、よく考えてごらんなさい。族長であるアブラハムでさえ、彼に一番良い戦利品の十分の一を与えたのです。","tok":[["その"],["人","ひと"],["が"],["どんな"],["に"],["偉大","いだい"],["で"],["ある"],["か"],["を"],["、"],["よく"],["考えて","かんがえて"],["ごらん"],["なさい"],["。"],["族長","ぞくちょう"],["で"],["ある"],["アブラハム"],["で"],["さえ"],["、"],["彼","かれ"],["に"],["一番","いちばん"],["良い","よい"],["戦利品","せんりひん"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["与えた","あたえた"],["の"],["です"],["。"]]},{"verse":5,"text":"レビの子らの中で祭司職を受ける者たちは、自分もアブラハムの子孫でありながら、民から、すなわち彼らの兄弟たちから、十分の一を徴集するようにと、律法の中で命じられています。","tok":[["レビ"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["で"],["祭司","さいし"],["職","しょく"],["を"],["受ける","うける"],["者","もの"],["たち"],["は"],["、"],["自分","じぶん"],["も"],["アブラハム"],["の"],["子孫","しそん"],["で"],["あり"],["ながら"],["、"],["民","みん"],["から"],["、"],["すなわち"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["たち"],["から"],["、"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["徴集","ちょうしゅう"],["する"],["よう"],["に"],["と"],["、"],["律法","りっぽう"],["の"],["中","なか"],["で"],["命じられて","めいじられて"],["います"],["。"]]},{"verse":6,"text":"ところが、レビ族の系図にない者が、アブラハムから十分の一を取って、約束を受けた人を祝福したのです。","tok":[["ところ"],["が"],["、"],["レビ族","れびぞく"],["の"],["系図","けいず"],["に"],["ない"],["者","もの"],["が"],["、"],["アブラハム"],["から"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["取って","とって"],["、"],["約束","やくそく"],["を"],["受けた","うけた"],["人","ひと"],["を"],["祝福","しゅくふく"],["した"],["の"],["です"],["。"]]},{"verse":7,"text":"いうまでもなく、下位の者が上位の者から祝福されるのです。","tok":[["いう"],["まで"],["も"],["なく"],["、"],["下位","かい"],["の"],["者","もの"],["が"],["上位","じょうい"],["の"],["者","もの"],["から"],["祝福","しゅくふく"],["される"],["の"],["です"],["。"]]},{"verse":8,"text":"一方では、死ぬべき人間が十分の一を受けていますが、他の場合は、彼は生きているとあかしされている者が受けるのです。","tok":[["一方","いっぽう"],["で"],["は"],["、"],["死ぬべき","しぬべき"],["人間","にんげん"],["が"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["受けて","うけて"],["います"],["が"],["、"],["他","た"],["の"],["場合","ばあい"],["は"],["、"],["彼","かれ"],["は"],["生きて","いきて"],["いる"],["と"],["あかし"],["されて"],["いる"],["者","もの"],["が"],["受ける","うける"],["の"],["です"],["。"]]},{"verse":9,"text":"また、いうならば、十分の一を受け取るレビでさえアブラハムを通して十分の一を納めているのです。","tok":[["また"],["、"],["いうならば"],["、"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["受け取る","うけとる"],["レビ"],["で"],["さえ"],["アブラハム"],["を"],["通して","とおして"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["納めて","おさめて"],["いる"],["の"],["です"],["。"]]},{"verse":10,"text":"というのは、メルキゼデクがアブラハムを出迎えたときには、レビはまだ父の腰の中にいたからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["メルキゼデク"],["が"],["アブラハム"],["を"],["出迎えた","でむかえた"],["とき"],["に"],["は"],["、"],["レビ"],["は"],["まだ"],["父","ちち"],["の"],["腰","こし"],["の"],["中","なか"],["に"],["いた"],["から"],["です"],["。"]]},{"verse":11,"text":"さて、もしレビ系の祭司職によって完全に到達できたのだったら、――民はそれを基礎として律法を与えられたのです――それ以上何の必要があって、アロンの位でなく、メルキゼデクの位に等しいと呼ばれる他の祭司が立てられたのでしょうか。","tok":[["さて"],["、"],["もし"],["レビ系","れびけい"],["の"],["祭司","さいし"],["職","しょく"],["によって"],["完全","かんぜん"],["に"],["到達","とうたつ"],["できた"],["の"],["だったら"],["、"],["―"],["―"],["民","みん"],["は"],["それ"],["を"],["基礎","きそ"],["として"],["律法","りっぽう"],["を"],["与えられた","あたえられた"],["の"],["です"],["―"],["―"],["それ"],["以上","いじょう"],["何","なん"],["の"],["必要","ひつよう"],["が"],["あって"],["、"],["アロン"],["の"],["位","くらい"],["で"],["なく"],["、"],["メルキゼデク"],["の"],["位","くらい"],["に"],["等しい","ひとしい"],["と"],["呼ばれる","よばれる"],["他","ほか"],["の"],["祭司","さいし"],["が"],["立てられた","たてられた"],["の"],["でしょう"],["か"],["。"]]},{"verse":12,"text":"祭司職が変われば、律法も必ず変わらなければなりませんが、","tok":[["祭司","さいし"],["職","しょく"],["が"],["変われば","かわれば"],["、"],["律法","りっぽう"],["も"],["必ず","かならず"],["変わらなければ","かわらなければ"],["なりません"],["が"],["、"]]},{"verse":13,"text":"私たちが今まで論じて来たその方は、祭壇に仕える者を出したことのない別の部族に属しておられるのです。","tok":[["私たち","わたしたち"],["が"],["今まで","いままで"],["論じて","ろんじて"],["来た","きた"],["その"],["方","かた"],["は"],["、"],["祭壇","さいだん"],["に"],["仕える","つかえる"],["者","もの"],["を"],["出した","だした"],["こと"],["の"],["ない"],["別","べつ"],["の"],["部族","ぶぞく"],["に"],["属して","ぞくして"],["おられる"],["の"],["です"],["。"]]},{"verse":14,"text":"私たちの主が、ユダ族から出られたことは明らかですが、モーセは、この部族については、祭司に関することを何も述べていません。","tok":[["私たち","わたしたち"],["の"],["主","ぬし"],["が"],["、"],["ユダ族","ゆだぞく"],["から"],["出られた","でられた"],["こと"],["は"],["明らか","あきらか"],["です"],["が"],["、"],["モーセ"],["は"],["、"],["この"],["部族","ぶぞく"],["について"],["は"],["、"],["祭司","さいし"],["に"],["関する","かんする"],["こと"],["を"],["何","なん"],["も"],["述べて","のべて"],["いません"],["。"]]},{"verse":15,"text":"もしメルキゼデクに等しい、別の祭司が立てられるのなら、以上のことは、いよいよ明らかになります。","tok":[["もし"],["メルキゼデク"],["に"],["等しい","ひとしい"],["、"],["別","べつ"],["の"],["祭司","さいし"],["が"],["立てられる","たてられる"],["の"],["なら"],["、"],["以上","いじょう"],["の"],["こと"],["は"],["、"],["いよいよ"],["明らか","あきらか"],["に"],["なります"],["。"]]},{"verse":16,"text":"その祭司は、肉についての戒めである律法にはよらないで、朽ちることのない、いのちの力によって祭司となったのです。","tok":[["その"],["祭司","さいし"],["は"],["、"],["肉","にく"],["について"],["の"],["戒め","いましめ"],["で"],["ある"],["律法","りっぽう"],["に"],["は"],["よらないで"],["、"],["朽ちる","くちる"],["こと"],["の"],["ない"],["、"],["いのち"],["の"],["力","ちから"],["によって"],["祭司","さいし"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":17,"text":"この方については、こうあかしされています。「あなたは、とこしえ
"],["死","し"],["と"],["いう"],["こと"],["が"],["ある"],["ため"],["、"],["務め","つとめ"],["に"],["いつ"],["まで"],["も"],["とどまる"],["こと"],["が"],["できず"],["、"],["大ぜい","おおぜい"],["の"],["者","もの"],["が"],["祭司","さいし"],["と"],["なりました"],["。"]]},{"verse":24,"text":"しかし、キリストは永遠に存在されるのであって、変わることのない祭司の務めを持っておられます。","tok":[["しかし"],["、"],["キリスト"],["は"],["永遠","えいえん"],["に"],["存在","そんざい"],["される"],["ので"],["あって"],["、"],["変わる","かわる"],["こと"],["の"],["ない"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["持って","もって"],["おられます"],["。"]]},{"verse":25,"text":"したがって、ご自分によって神に近づく人々を、完全に救うことがおできになります。キリストはいつも生きていて、彼らのために、とりなしをしておられるからです。","tok":[["したがって"],["、"],["ご自分","ごじぶん"],["によって"],["神","かみ"],["に"],["近づく","ちかづく"],["人々","ひとびと"],["を"],["、"],["完全","かんぜん"],["に"],["救う","すくう"],["こと"],["が"],["おでき"],["に"],["なります"],["。"],["キリスト"],["は"],["いつも"],["生きて","いきて"],["いて"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["、"],["とりなし"],["を"],["して"],["おられる"],["から"],["です"],["。"]]},{"verse":26,"text":"また、このようにきよく、悪も汚れもなく、罪人から離れ、また、天よりも高くされた大祭司こそ、私たちにとってまさに必要な方です。","tok":[["また"],["、"],["この"],["よう"],["に"],["きよく"],["、"],["悪","あく"],["も"],["汚れ","よごれ"],["も"],["なく"],["、"],["罪人","ざいにん"],["から"],["離れ","はなれ"],["、"],["また"],["、"],["天","てん"],["より"],["も"],["高く","たかく"],["された"],["大","だい"],["祭司","さいし"],["こそ"],["、"],["私たち","わたしたち"],["にとって"],["まさに"],["必要","ひつよう"],["な"],["方","ほう"],["です"],["。"]]},{"verse":27,"text":"ほかの大祭司たちとは違い、キリストには、まず自分の罪のために、その次に、民の罪のために毎日いけにえをささげる必要はありません。というのは、キリストは自分自身をささげ、ただ一度でこのことを成し遂げられたからです。","tok":[["ほか"],["の"],["大","だい"],["祭司","さいし"],["たち"],["と"],["は"],["違い","ちがい"],["、"],["キリスト"],["に"],["は"],["、"],["まず"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["その"],["次","つぎ"],["に"],["、"],["民","みん"],["の"],["罪","つみ"],["の"],["ため"],["に"],["毎日","まいにち"],["いけにえ"],["を"],["ささげる"],["必要","ひつよう"],["は"],["ありません"],["。"],["と"],["いう"],["の"],["は"],["、"],["キリスト"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["ささげ"],["、"],["ただ"],["一度","いちど"],["で"],["この"],["こと"],["を"],["成し遂げられた","なしとげられた"],["から"],["です"],["。"]]},{"verse":28,"text":"律法は弱さを持つ人間を大祭司に立てますが、律法のあとから来た誓いのみことばは、永遠に全うさ
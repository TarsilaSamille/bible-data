[{"verse":1,"text":"ニネベに対する宣告。エルコシュ人ナホムの幻の書。","tok":[["ニネベ"],["に"],["対する","たいする"],["宣告","せんこく"],["。"],["エルコシュ"],["人","にん"],["ナホム"],["の"],["幻","まぼろし"],["の"],["書","しょ"],["。"]]},{"verse":2,"text":"主はねたみ、復讐する神。／主は復讐し、憤る方。／主はその仇に復讐する方。／敵に怒りを保つ方。","tok":[["主","ぬし"],["は"],["ねたみ"],["、"],["復讐","ふくしゅう"],["する"],["神","かみ"],["。"],["／"],["主","ぬし"],["は"],["復讐","ふくしゅう"],["し"],["、"],["憤る","いきどおる"],["方","かた"],["。"],["／"],["主","ぬし"],["は"],["その"],["仇","あだ"],["に"],["復讐","ふくしゅう"],["する"],["方","ほう"],["。"],["／"],["敵","てき"],["に"],["怒り","いかり"],["を"],["保つ","たもつ"],["方","かた"],["。"]]},{"verse":3,"text":"主は怒るのにおそく、力強い。／主は決して罰せずにおくことはしない方。／主の道はつむじ風とあらしの中にある。／雲はその足でかき立てられる砂ほこり。","tok":[["主","ぬし"],["は"],["怒る","おこる"],["のに"],["おそく"],["、"],["力強い","ちからづよい"],["。"],["／"],["主","ぬし"],["は"],["決して","けっして"],["罰せず","ばっせず"],["に"],["おく"],["こと"],["は"],["しない"],["方","ほう"],["。"],["／"],["主","ぬし"],["の"],["道","みち"],["は"],["つむじ風","つむじかぜ"],["と"],["あらし"],["の"],["中","なか"],["に"],["ある"],["。"],["／"],["雲","くも"],["は"],["その"],["足","あし"],["で"],["かき立てられる","かきたてられる"],["砂ほこり","すなほこり"],["。"]]},{"verse":4,"text":"主は海をしかって、これをからし、すべての川を干上がらせる。／バシャンとカルメルはしおれ、レバノンの花はしおれる。","tok":[["主","ぬし"],["は"],["海","うみ"],["を"],["しかって"],["、"],["これ"],["を"],["からし"],["、"],["すべて"],["の"],["川","かわ"],["を"],["干上がらせる","ひあがらせる"],["。"],["／"],["バシャン"],["と"],["カルメル"],["は"],["しおれ"],["、"],["レバノン"],["の"],["花","はな"],["は"],["しおれる"],["。"]]},{"verse":5,"text":"山々は主の前に揺れ動き、丘々は溶け去る。／大地は御前でくつがえり、世界とこれに住むすべての者もくつがえる。","tok":[["山々","やまやま"],["は"],["主","ぬし"],["の"],["前","まえ"],["に"],["揺れ動き","ゆれうごき"],["、"],["丘","おか"],["々"],["は"],["溶け去る","とけさる"],["。"],["／"],["大地","だいち"],["は"],["御前","ごぜん"],["で"],["くつがえり"],["、"],["世界","せかい"],["と"],["これ"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["も"],["くつがえる"],["。"]]},{"verse":6,"text":"だれがその憤りの前に立ちえよう。／だれがその燃える怒りに耐えられよう。／その憤りは火のように注がれ、岩も主によって打ち砕かれる。","tok":[["だれ"],["が"],["その"],["憤り","いきどおり"],["の"],["前","まえ"],["に"],["立ち","たち"],["えよう"],["。"],["／"],["だれ"],["が"],["その"],["燃える","もえる"],["怒り","いかり"],["に"],["耐えられよう","たえられよう"],["。"],["／"],["その"],["憤り","いきどおり"],["は"],["火","ひ"],["の"],["よう"],["に"],["注がれ","そそがれ"],["、"],["岩","いわ"],["も"],["主に","おもに"],["よって"],["打ち砕かれる","うちくだかれる"],["。"]]},{"verse":7,"text":"主はいつくしみ深く、苦難の日のとりでである。／主に身を避ける者たちを／主は知っておられる。","tok":[["主","ぬし"],["は"],["いつくしみ"],["深く","ふかく"],["、"],["苦難","くなん"],["の"],["日","ひ"],["の"],["とりで"],["で"],["ある"],["。"],["／"],["主に","おもに"],["身","み"],["を"],["避ける","さける"],["者","もの"],["たち"],["を"],["／"],["主","ぬし"],["は"],["知って","しって"],["おられる"],["。"]]},{"verse":8,"text":"しかし、主は、あふれみなぎる洪水で、その場所を滅ぼし尽くし、その敵をやみに追いやられる。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["、"],["あふれ"],["みなぎる"],["洪水","こうずい"],["で"],["、"],["その"],["場所","ばしょ"],["を"],["滅ぼし","ほろぼし"],["尽くし","つくし"],["、"],["その"],["敵","てき"],["を"],["やみ"],["に"],["追いやられる","おいやられる"],["。"]]},{"verse":9,"text":"あなたがたは主に対して何をたくらむのか。／主はすべてを滅ぼし尽くす。／仇は二度と立ち上がれない。","tok":[["あなた"],["がた"],["は"],["主に","おもに"],["対して","たいして"],["何","なん"],["を"],["たくらむ"],["の"],["か"],["。"],["／"],["主","ぬし"],["は"],["すべて"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"],["／"],["仇","あだ"],["は"],["二","に"],["度","ど"],["と"],["立ち上がれない","たちあがれない"],["。"]]},{"verse":10,"text":"彼らは、からみついたいばら。／大酒を飲んだ酔っぱらいのようであっても、かわいた刈り株のように、全く焼き尽くされる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["からみついた"],["いばら"],["。"],["／"],["大酒","おおざけ"],["を"],["飲んだ","のんだ"],["酔っぱらい","よっぱらい"],["の"],["よう"],["で"],["あって"],["も"],["、"],["かわいた"],["刈り株","かりかぶ"],["の"],["よう"],["に"],["、"],["全く","まったく"],["焼き","やき"],["尽くされる","つくされる"],["。"]]},{"verse":11,"text":"あなたのうちから、主に対して悪巧みをし、よこしまなことを計る者が出たからだ。","tok":[["あなた"],["の"],["うち"],["から"],["、"],["主に","おもに"],["対して","たいして"],["悪巧み","わるだくみ"],["を"],["し"],["、"],["よこしま"],["な"],["こと"],["を"],["計る","はかる"],["者","もの"],["が"],["出た","でた"],["から"],["だ"],["。"]]},{"verse":12,"text":"主はこう仰せられる。／「彼らは安らかで、数が多くても、刈り取られて消えうせる。／わたしはあなたを苦しめたが、再び、あなたを苦しめない。","tok":[["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["／"],["「"],["彼","かれ"],["ら"],["は"],["安らか","やすらか"],["で"],["、"],["数","すう"],["が"],["多くて","おおくて"],["も"],["、"],["刈り取られて","かりとられて"],["消えうせる","きえうせる"],["。"],["／"],["わたし"],["は"],["あなた"],["を"],["苦しめた","くるしめた"],["が"],["、"],["再び","ふたたび"],["、"],["あなた"],["を"],["苦しめない","くるしめない"],["。"]]},{"verse":13,"text":"今、わたしは彼のくびきを／あなたからはずして打ち砕き、あなたをなわめから解き放す。」","tok":[["今","いま"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["くびき"],["を"],["／"],["あなた"],["から"],["はずして"],["打ち砕き","うちくだき"],["、"],["あなた"],["を"],["なわ"],["め"],["から"],["解き放す","ときはなす"],["。"],["」"]]},{"verse":14,"text":"主はあなたについて命じられた。「あなたの子孫はもう散らされない。あなたの神々の宮から、わたしは彫像や鋳像を断ち滅ぼす。あなたはつまらない者であったが、わたしはあなたの墓を設けよう。」","tok":[["主","ぬし"],["は"],["あなた"],["について"],["命じられた","めいじられた"],["。"],["「"],["あなた"],["の"],["子孫","しそん"],["は"],["もう"],["散らされない","ちらされない"],["。"],["あなた"],["の"],["神々","かみがみ"],["の"],["宮","みや"],["から"],["、"],["わたし"],["は"],["彫像","ちょうぞう"],["や"],["鋳像","ちゅうぞう"],["を"],["断ち","たち"],["滅ぼす","ほろぼす"],["。"],["あなた"],["は"],["つまらない"],["者","もの"],["で"],["あった"],["が"],["、"],["わたし"],["は"],["あなた"],["の"],["墓","はか"],["を"],["設けよう","もうけよう"],["。"],["」"]]},{"verse":15,"text":"見よ。良い知らせを伝える者、平和を告げ知らせる者の足が山々の上にある。／ユダよ。あなたの祭りを祝い、あなたの誓願を果たせ。／よこしまな者は、もう二度と、あなたの間を通り過ぎない。／彼らはみな、断ち滅ぼされた。","tok":[["見","み"],["よ"],["。"],["良い","よい"],["知らせ","しらせ"],["を"],["伝える","つたえる"],["者","もの"],["、"],["平和","へいわ"],["を"],["告げ知らせる","つげしらせる"],["者","もの"],["の"],["足","あし"],["が"],["山々","やまやま"],["の"],["上","うえ"],["に"],["ある"],["。"],["／"],["ユダ"],["よ"],["。"],["あなた"],["の"],["祭り","まつり"],["を"],["祝い","いわい"],["、"],["あなた"],["の"],["誓願","せいがん"],["を"],["果たせ","はたせ"],["。"],["／"],["よこしま"],["な"],["者","もの"],["は"],["、"],["もう"],["二","に"],["度","ど"],["と"],["、"],["あなた"],["の"],["間","あいだ"],["を"],["通り過ぎない","とおりすぎない"],["。"],["／"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["断ち","たち"],["滅ぼされた","ほろぼされた"],["。"]]}]
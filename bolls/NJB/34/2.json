[{"verse":1,"text":"散らす者が、あなたを攻めに上って来る。／塁を守り、道を見張り、腰をからげ、大いに力を奮い立たせよ。","tok":[["散らす","ちらす"],["者","もの"],["が"],["、"],["あなた"],["を"],["攻め","せめ"],["に"],["上って","のぼって"],["来る","くる"],["。"],["／"],["塁","るい"],["を"],["守り","まもり"],["、"],["道","みち"],["を"],["見張り","みはり"],["、"],["腰","こし"],["を"],["からげ"],["、"],["大いに","おおいに"],["力","ちから"],["を"],["奮い立たせ","ふるいたたせ"],["よ"],["。"]]},{"verse":2,"text":"主は、ヤコブの栄えを、イスラエルの栄えのように回復される。／――かすめる者が彼らをかすめ、彼らのぶどうのつるをそこなったからだ。","tok":[["主","ぬし"],["は"],["、"],["ヤコブ"],["の"],["栄え","はえ"],["を"],["、"],["イスラエル"],["の"],["栄え","はえ"],["の"],["よう"],["に"],["回復","かいふく"],["される"],["。"],["／"],["―"],["―"],["かすめる"],["者","もの"],["が"],["彼","かれ"],["ら"],["を"],["かすめ"],["、"],["彼","かれ"],["ら"],["の"],["ぶどう"],["の"],["つる"],["を"],["そこなった"],["から"],["だ"],["。"]]},{"verse":3,"text":"その勇士の盾は赤く、兵士は緋色の服をまとい、戦車は整えられて鉄の火のようだ。／槍は揺れ、","tok":[["その"],["勇士","ゆうし"],["の"],["盾","たて"],["は"],["赤く","あかく"],["、"],["兵士","へいし"],["は"],["緋色","ひいろ"],["の"],["服","ふく"],["を"],["まとい"],["、"],["戦車","せんしゃ"],["は"],["整えられて","ととのえられて"],["鉄","てつ"],["の"],["火","ひ"],["の"],["よう"],["だ"],["。"],["／"],["槍","やり"],["は"],["揺れ","ゆれ"],["、"]]},{"verse":4,"text":"戦車は通りを狂い走り、広場を駆け巡る。／その有様はたいまつのようで、いなずまのように走り回る。","tok":[["戦車","せんしゃ"],["は"],["通り","とおり"],["を"],["狂い","くるい"],["走り","はしり"],["、"],["広場","ひろば"],["を"],["駆け巡る","かけめぐる"],["。"],["／"],["その"],["有様","ありさま"],["は"],["たいまつ"],["の"],["よう"],["で"],["、"],["いなずま"],["の"],["よう"],["に"],["走り回る","はしりまわる"],["。"]]},{"verse":5,"text":"貴人たちは呼び出され、途上でつまずき倒れる。／彼らはその城壁へ急ぎ、防柵を設ける。","tok":[["貴人","きじん"],["たち"],["は"],["呼び出され","よびだされ"],["、"],["途上","とじょう"],["で"],["つまずき"],["倒れる","たおれる"],["。"],["／"],["彼","かれ"],["ら"],["は"],["その"],["城壁","じょうへき"],["へ"],["急ぎ","いそぎ"],["、"],["防","ぼう"],["柵","さく"],["を"],["設ける","もうける"],["。"]]},{"verse":6,"text":"町々の門は開かれ、宮殿は消え去る。","tok":[["町々","まちまち"],["の"],["門","もん"],["は"],["開かれ","ひらかれ"],["、"],["宮殿","きゅうでん"],["は"],["消え去る","きえさる"],["。"]]},{"verse":7,"text":"王妃は捕らえられて連れ去られ、そのはしためは鳩のような声で嘆き、胸を打って悲しむ。","tok":[["王妃","おうひ"],["は"],["捕らえられて","とらえられて"],["連れ去られ","つれさられ"],["、"],["その"],["はし"],["ため"],["は"],["鳩","はと"],["の"],["よう"],["な"],["声","こえ"],["で"],["嘆き","なげき"],["、"],["胸","むね"],["を"],["打って","うって"],["悲しむ","かなしむ"],["。"]]},{"verse":8,"text":"ニネベは水の流れ出る池のようだ。／みな逃げ出して、「止まれ、立ち止まれ」と言っても、だれも振り返りもしない。","tok":[["ニネベ"],["は"],["水","みず"],["の"],["流れ出る","ながれでる"],["池","いけ"],["の"],["よう"],["だ"],["。"],["／"],["みな"],["逃げ出して","にげだして"],["、"],["「"],["止まれ","とまれ"],["、"],["立ち止まれ","たちどまれ"],["」"],["と"],["言って","いって"],["も"],["、"],["だれ"],["も"],["振り返り","ふりかえり"],["も"],["しない"],["。"]]},{"verse":9,"text":"銀を奪え。金も奪え。／その財宝は限りない。／あらゆる尊い品々が豊富だ。","tok":[["銀","ぎん"],["を"],["奪え","うばえ"],["。"],["金","きん"],["も"],["奪え","うばえ"],["。"],["／"],["その"],["財宝","ざいほう"],["は"],["限りない","かぎりない"],["。"],["／"],["あらゆる"],["尊い","とうとい"],["品々","しなじな"],["が"],["豊富","ほうふ"],["だ"],["。"]]},{"verse":10,"text":"破壊、滅亡、荒廃。／心はしなえ、ひざは震え、すべての腰はわななき、だれの顔も青ざめる。","tok":[["破壊","はかい"],["、"],["滅亡","めつぼう"],["、"],["荒廃","こうはい"],["。"],["／"],["心","こころ"],["は"],["しなえ"],["、"],["ひざ"],["は"],["震え","ふるえ"],["、"],["すべて"],["の"],["腰","こし"],["は"],["わななき"],["、"],["だれ"],["の"],["顔","かお"],["も"],["青ざめる","あおざめる"],["。"]]},{"verse":11,"text":"雄獅子の住みかはどこにあるのか。／それは若い獅子のためのほら穴。／雄獅子が出歩くとき、雌獅子と子獅子はそこにいるが、だれも脅かす者はない。","tok":[["雄","ゆう"],["獅子","しし"],["の"],["住みか","すみか"],["は"],["どこ"],["に"],["ある"],["の"],["か"],["。"],["／"],["それ"],["は"],["若い","わかい"],["獅子","しし"],["の"],["ため"],["の"],["ほら穴","ほらあな"],["。"],["／"],["雄","ゆう"],["獅子","しし"],["が"],["出歩く","であるく"],["とき"],["、"],["雌","めす"],["獅子","しし"],["と"],["子","こ"],["獅子","しし"],["は"],["そこ"],["に"],["いる"],["が"],["、"],["だれ"],["も"],["脅かす","おびやかす"],["者","もの"],["は"],["ない"],["。"]]},{"verse":12,"text":"雄獅子は子獅子のために、十分な獲物を引き裂き、雌獅子のためにかみ殺し、そのほら穴を、獲物で、その巣を、引き裂いた物で満たした。","tok":[["雄","ゆう"],["獅子","しし"],["は"],["子","こ"],["獅子","しし"],["の"],["ため"],["に"],["、"],["十分","じゅうぶん"],["な"],["獲物","えもの"],["を"],["引き裂き","ひきさき"],["、"],["雌","めす"],["獅子","しし"],["の"],["ため"],["に"],["かみ殺し","かみころし"],["、"],["その"],["ほら穴","ほらあな"],["を"],["、"],["獲物","えもの"],["で"],["、"],["その"],["巣","す"],["を"],["、"],["引き裂いた","ひきさいた"],["物","もの"],["で"],["満たした","みたした"],["。"]]},{"verse":13,"text":"見よ。わたしはあなたに立ち向かう。／――万軍の主の御告げ――／わたしはあなたの戦車を燃やして煙とする。／剣はあなたの若い獅子を食い尽くす。／わたしはあなたの獲物を地から絶やす。／あなたの使者たちの声はもう聞かれない。","tok":[["見","み"],["よ"],["。"],["わたし"],["は"],["あなた"],["に"],["立ち向かう","たちむかう"],["。"],["／"],["―"],["―"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["御告げ","おつげ"],["―"],["―"],["／"],["わたし"],["は"],["あなた"],["の"],["戦車","せんしゃ"],["を"],["燃やして","もやして"],["煙","けむり"],["と"],["する"],["。"],["／"],["剣","けん"],["は"],["あなた"],["の"],["若い","わかい"],["獅子","しし"],["を"],["食い","くい"],["尽くす","つくす"],["。"],["／"],["わたし"],["は"],["あなた"],["の"],["獲物","えもの"],["を"],["地","ち"],["から"],["絶やす","たやす"],["。"],["／"],["あなた"],["の"],["使者","ししゃ"],["たち"],["の"],["声","こえ"],["は"],["もう"],["聞かれない","きかれない"],["。"]]}]
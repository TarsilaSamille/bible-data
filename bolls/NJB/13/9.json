メリブ"],["・"],["バアル"],["。"],["メリブ"],["・"],["バアル"],["は"],["ミカ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":41,"text":"ミカの子は、ピトン、メレク、タフレア。","tok":[["ミカ"],["の"],["子","こ"],["は"],["、"],["ピトン"],["、"],["メレク"],["、"],["タフレア"],["。"]]},{"verse":42,"text":"アハズはヤラを生み、ヤラは、アレメテ、アズマベテ、ジムリを生み、ジムリはモツァを生んだ。","tok":[["アハズ"],["は"],["ヤラ"],["を"],["生み","うみ"],["、"],["ヤラ"],["は"],["、"],["アレメテ"],["、"],["アズマベテ"],["、"],["ジムリ"],["を"],["生み","うみ"],["、"],["ジムリ"],["は"],["モツァ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":43,"text":"モツァはビヌアを生んだ。その子はレファヤ、その子はエルアサ、その子はアツェル。","tok":[["モツァ"],["は"],["ビヌア"],["を"],["生んだ","うんだ"],["。"],["その"],["子","こ"],["は"],["レファヤ"],["、"],["その"],["子","こ"],["は"],["エルアサ"],["、"],["その"],["子","こ"],["は"],["アツェル"],["。"]]},{"verse":44,"text":"アツェルには六人の子がいた。その名まえは次のとおりである。アズリカム、ボクル、イシュマエル、シェアルヤ、オバデヤ、ハナン。これらはアツェルの子であった。","tok":[["アツェル"],["に"],["は"],["六人","ろくにん"],["の"],["子","こ"],["が"],["いた"],["。"],["その"],["名まえ","なまえ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["アズリカム"],["、"],["ボクル"],["、"],["イシュマエル"],["、"],["シェアルヤ"],["、"],["オバデヤ"],["、"],["ハナン"],["。"],["これ"],["ら"],["は"],["アツェル"],["の"],["子","こ"],["で"],["あった"],["。"]]}]
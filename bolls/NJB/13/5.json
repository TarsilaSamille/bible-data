[{"verse":1,"text":"イスラエルの長子ルベンの子孫――彼は長子であったが、父の寝床を汚したことにより、その長子の権利はイスラエルの子ヨセフの子に与えられた。系図の記載は長子の権利に従って行うものではない。","tok":[["イスラエル"],["の"],["長子","ちょうし"],["ルベン"],["の"],["子孫","しそん"],["―"],["―"],["彼","かれ"],["は"],["長子","ちょうし"],["で"],["あった"],["が"],["、"],["父","ちち"],["の"],["寝床","ねどこ"],["を"],["汚した","よごした"],["こと"],["に"],["より"],["、"],["その"],["長子","ちょうし"],["の"],["権利","けんり"],["は"],["イスラエル"],["の"],["子","こ"],["ヨセフ"],["の"],["子","こ"],["に"],["与えられた","あたえられた"],["。"],["系図","けいず"],["の"],["記載","きさい"],["は"],["長子","ちょうし"],["の"],["権利","けんり"],["に"],["従って","したがって"],["行う","おこなう"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":2,"text":"ユダは彼の兄弟たちにまさる者となり、君たる者も彼から出るのであるが、長子の権利はヨセフに帰したからである――","tok":[["ユダ"],["は"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["に"],["まさる"],["者","もの"],["と"],["なり"],["、"],["君","きみ"],["たる"],["者","もの"],["も"],["彼","かれ"],["から"],["出る","でる"],["ので"],["ある"],["が"],["、"],["長子","ちょうし"],["の"],["権利","けんり"],["は"],["ヨセフ"],["に"],["帰した","かえした"],["から"],["で"],["ある"],["―"],["―"]]},{"verse":3,"text":"イスラエルの長子ルベンの子は、エノク、パル、ヘツロン、カルミ。","tok":[["イスラエル"],["の"],["長子","ちょうし"],["ルベン"],["の"],["子","こ"],["は"],["、"],["エノク"],["、"],["パル"],["、"],["ヘツロン"],["、"],["カルミ"],["。"]]},{"verse":4,"text":"ヨエルの子は、その子はシェマヤ、その子はゴグ、その子はシムイ、","tok":[["ヨエル"],["の"],["子","こ"],["は"],["、"],["その"],["子","こ"],["は"],["シェマヤ"],["、"],["その"],["子","こ"],["は"],["ゴグ"],["、"],["その"],["子","こ"],["は"],["シムイ"],["、"]]},{"verse":5,"text":"その子はミカ、その子はレアヤ、その子はバアル、","tok":[["その"],["子","こ"],["は"],["ミカ"],["、"],["その"],["子","こ"],["は"],["レアヤ"],["、"],["その"],["子","こ"],["は"],["バアル"],["、"]]},{"verse":6,"text":"その子はアッシリヤの王ティグラテ・ピレセルが引いて行ったベエラ。彼はルベン人の族長であった。","tok":[["その"],["子","こ"],["は"],["アッシリヤ"],["の"],["王","おう"],["ティグラテ"],["・"],["ピレセル"],["が"],["引いて","ひいて"],["行った","いった"],["ベエラ"],["。"],["彼","かれ"],["は"],["ルベン人","るべんにん"],["の"],["族長","ぞくちょう"],["で"],["あった"],["。"]]},{"verse":7,"text":"また、彼の兄弟たちは、氏族ごとに生まれた順に系図に載せられたかしらはエイエル、それにゼカリヤ、","tok":[["また"],["、"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["は"],["、"],["氏族","しぞく"],["ごと"],["に"],["生まれた","うまれた"],["順","じゅん"],["に"],["系図","けいず"],["に"],["載せられた","のせられた"],["かしら"],["は"],["エイエル"],["、"],["それ"],["に"],["ゼカリヤ"],["、"]]},{"verse":8,"text":"ベラ。彼はヨエルの子シェマの子アザズの子で、アロエルに住み、ネボやバアル・メオンにまで及び、","tok":[["ベラ"],["。"],["彼","かれ"],["は"],["ヨエル"],["の"],["子","こ"],["シェマ"],["の"],["子","こ"],["アザズ"],["の"],["子","こ"],["で"],["、"],["アロエル"],["に"],["住み","すみ"],["、"],["ネボ"],["や"],["バアル"],["・"],["メオン"],["に"],["まで"],["及び","および"],["、"]]},{"verse":9,"text":"東は、ユーフラテス川から荒野の入口に及ぶ地に住んだ。ギルアデの地で彼らの家畜がふえたからである。","tok":[["東","ひがし"],["は"],["、"],["ユーフラテス"],["川","かわ"],["から"],["荒野","あらの"],["の"],["入口","いりぐち"],["に"],["及ぶ","およぶ"],["地","ち"],["に"],["住んだ","すんだ"],["。"],["ギルアデ"],["の"],["地","ち"],["で"],["彼","かれ"],["ら"],["の"],["家畜","かちく"],["が"],["ふえた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"彼らはサウルの時代に、ハガル人と戦いを交え、ハガル人は彼らの手に倒れた。そこで、彼らは、ギルアデの東方一帯に、天幕を張って住んだ。","tok":[["彼","かれ"],["ら"],["は"],["サウル"],["の"],["時代","じだい"],["に"],["、"],["ハガル人","はがるにん"],["と"],["戦い","たたかい"],["を"],["交え","まじえ"],["、"],["ハガル人","はがるにん"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["倒れた","たおれた"],["。"],["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["、"],["ギルアデ"],["の"],["東方","とうほう"],["一帯","いったい"],["に"],["、"],["天幕","てんまく"],["を"],["張って","はって"],["住んだ","すんだ"],["。"]]},{"verse":11,"text":"ガド族は、彼らの真向かいに当たるバシャンの地に住み、サルカにまで及んだ。","tok":[["ガド族","がどぞく"],["は"],["、"],["彼","かれ"],["ら"],["の"],["真向かい","まむかい"],["に"],["当たる","あたる"],["バシャン"],["の"],["地","ち"],["に"],["住み","すみ"],["、"],["サルカ"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":12,"text":"かしらヨエル、二番目のシャファム、そして、ヤナイ、シャファテが、バシャンに住んだ。","tok":[["かしら"],["ヨエル"],["、"],["二番目","にばんめ"],["の"],["シャファム"],["、"],["そして"],["、"],["ヤナイ"],["、"],["シャファテ"],["が"],["、"],["バシャン"],["に"],["住んだ","すんだ"],["。"]]},{"verse":13,"text":"彼ら一族に属する彼らの兄弟たちは、ミカエル、メシュラム、シェバ、ヨライ、ヤカン、ジア、エベルの七人。","tok":[["彼","かれ"],["ら"],["一族","いちぞく"],["に"],["属する","ぞくする"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["たち"],["は"],["、"],["ミカエル"],["、"],["メシュラム"],["、"],["シェバ"],["、"],["ヨライ"],["、"],["ヤカン"],["、"],["ジア"],["、"],["エベル"],["の"],["七人","しちにん"],["。"]]},{"verse":14,"text":"これらは、アビハイルの子である。アビハイルはフリの子、順次さかのぼって、ヤロアハの子、ギルアデの子、ミカエルの子、エシシャイの子、ヤフドの子、ブズの子。","tok":[["これ"],["ら"],["は"],["、"],["アビハイル"],["の"],["子","こ"],["で"],["ある"],["。"],["アビハイル"],["は"],["フリ"],["の"],["子","こ"],["、"],["順次","じゅんじ"],["さかのぼって"],["、"],["ヤロアハ"],["の"],["子","こ"],["、"],["ギルアデ"],["の"],["子","こ"],["、"],["ミカエル"],["の"],["子","こ"],["、"],["エシシャイ"],["の"],["子","こ"],["、"],["ヤフド"],["の"],["子","こ"],["、"],["ブズ"],["の"],["子","こ"],["。"]]},{"verse":15,"text":"アヒ。彼はグニの子アブディエルの子で、彼ら一族のかしらであった。","tok":[["アヒ"],["。"],["彼","かれ"],["は"],["グニ"],["の"],["子","こ"],["アブディエル"],["の"],["子","こ"],["で"],["、"],["彼","かれ"],["ら"],["一族","いちぞく"],["の"],["かしら"],["で"],["あった"],["。"]]},{"verse":16,"text":"そして、彼らはギルアデとバシャンとそれに属する村落、およびシャロンの放牧地全域にわたって、その境に住んだ。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["は"],["ギルアデ"],["と"],["バシャン"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["および"],["シャロン"],["の"],["放牧","ほうぼく"],["地","ち"],["全域","ぜんいき"],["に"],["わたって"],["、"],["その"],["境","さかい"],["に"],["住んだ","すんだ"],["。"]]},{"verse":17,"text":"彼らはみな、ユダの王ヨタムの時代、イスラエルの王ヤロブアムの時代に系図に載せられた。","tok":[["彼","かれ"],["ら"],["は"],["みな"],["、"],["ユダ"],["の"],["王","おう"],["ヨタム"],["の"],["時代","じだい"],["、"],["イスラエル"],["の"],["王","おう"],["ヤロブアム"],["の"],["時代","じだい"],["に"],["系図","けいず"],["に"],["載せられた","のせられた"],["。"]]},{"verse":18,"text":"ルベン族、ガド人、マナセの半部族で、盾と剣を取り、弓を引き、戦いの訓練を受けた勇者たちのうち、従軍する者は、四万四千七百六十人であった。","tok":[["ルベン族","るべんぞく"],["、"],["ガド人","がどにん"],["、"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["で"],["、"],["盾","たて"],["と"],["剣","けん"],["を"],["取り","とり"],["、"],["弓","ゆみ"],["を"],["引き","ひき"],["、"],["戦い","たたかい"],["の"],["訓練","くんれん"],["を"],["受けた","うけた"],["勇者","ゆうしゃ"],["たち"],["の"],["うち"],["、"],["従軍","じゅうぐん"],["する"],["者","もの"],["は"],["、"],["四万四千七百六","よんまんよんせんななひゃくろく"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":19,"text":"ここに、彼らはハガル人およびエトル、ナフィシュ、ノダブと戦いを交えたが、","tok":[["ここ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["ハガル人","はがるにん"],["および"],["エトル"],["、"],["ナフィシュ"],["、"],["ノダブ"],["と"],["戦い","たたかい"],["を"],["交えた","まじえた"],["が"],["、"]]},{"verse":20,"text":"助けを得てこれらに当たった。それで、ハガル人およびこれとともにいた者はみな彼らの手に渡された。それは、彼らがその戦いのときに、神に呼ばわったからである。彼らが神に拠り頼んだので、神は彼らの願いを聞き入れられた。","tok":[["助け","たすけ"],["を"],["得て","えて"],["これ"],["ら"],["に"],["当たった","あたった"],["。"],["それ"],["で"],["、"],["ハガル人","はがるにん"],["および"],["これ"],["と"],["とも"],["に"],["いた"],["者","もの"],["は"],["みな"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["その"],["戦い","たたかい"],["の"],["とき"],["に"],["、"],["神","かみ"],["に"],["呼ばわった","よばわった"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["が"],["神","かみ"],["に"],["拠り","より"],["頼んだ","たのんだ"],["ので"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["願い","ねがい"],["を"],["聞き入れられた","ききいれられた"],["。"]]},{"verse":21,"text":"彼らはこの人々の家畜を奪い去った。らくだ五万、羊二十五万、ろば二千、人十万。","tok":[["彼","かれ"],["ら"],["は"],["この"],["人々","ひとびと"],["の"],["家畜","かちく"],["を"],["奪い去った","うばいさった"],["。"],["らくだ"],["五万","ごまん"],["、"],["羊","ひつじ"],["二十五万","にじゅうごまん"],["、"],["ろば"],["二千","にせん"],["、"],["人","ひと"],["十万","じゅうまん"],["。"]]},{"verse":22,"text":"この戦いは神から出ていたため、多くの者が刺し殺されて倒れたからである。彼らはこの人々に代わって、捕囚の時まで、そこに住んだ。","tok":[["この"],["戦い","たたかい"],["は"],["神","かみ"],["から"],["出て","でて"],["いた"],["ため"],["、"],["多く","おおく"],["の"],["者","もの"],["が"],["刺し殺されて","さしころされて"],["倒れた","たおれた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["この"],["人々","ひとびと"],["に"],["代わって","かわって"],["、"],["捕囚","ほしゅう"],["の"],["時","とき"],["まで"],["、"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":23,"text":"マナセの半部族の人々は、この地、すなわち、バシャンからバアル・ヘルモン、セニル、ヘルモン山に至る地に住み、その数はふえた。","tok":[["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["の"],["人々","ひとびと"],["は"],["、"],["この"],["地","ち"],["、"],["すなわち"],["、"],["バシャン"],["から"],["バアル"],["・"],["ヘルモン"],["、"],["セニル"],["、"],["ヘルモン"],["山","やま"],["に"],["至る","いたる"],["地","ち"],["に"],["住み","すみ"],["、"],["その"],["数","すう"],["は"],["ふえた"],["。"]]},{"verse":24,"text":"彼らの一族のかしらたちは次のとおり。エフェル、イシュイ、エリエル、アズリエル、エレミヤ、ホダブヤ、ヤフディエル。この人たちは、勇士であり、名のある人々であって、彼らの一族のかしらであった。","tok":[["彼","かれ"],["ら"],["の"],["一族","いちぞく"],["の"],["かしら"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["。"],["エフェル"],["、"],["イシュイ"],["、"],["エリエル"],["、"],["アズリエル"],["、"],["エレミヤ"],["、"],["ホダブヤ"],["、"],["ヤフディエル"],["。"],["この"],["人","ひと"],["たち"],["は"],["、"],["勇士","ゆうし"],["で"],["あり"],["、"],["名","な"],["の"],["ある"],["人々","ひとびと"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["の"],["一族","いちぞく"],["の"],["かしら"],["で"],["あった"],["。"]]},{"verse":25,"text":"ところが、彼らは、その父祖の神に対して不信の罪を犯し、神が彼らの前からぬぐい去って滅ぼされたその地の民の神々を慕って不貞を犯した。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["、"],["その"],["父祖","ふそ"],["の"],["神","かみ"],["に対して","にたいして"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["神","かみ"],["が"],["彼","かれ"],["ら"],["の"],["前","まえ"],["から"],["ぬぐい去って","ぬぐいさって"],["滅ぼされた","ほろぼされた"],["その"],["地","ち"],["の"],["民","たみ"],["の"],["神々","かみがみ"],["を"],["慕って","したって"],["不貞","ふてい"],["を"],["犯した","おかした"],["。"]]},{"verse":26,"text":"そこで、イスラエルの神は、アッシリヤの王プルの霊と、アッシリヤの王ティグラテ・ピレセルの霊を奮い立たせられた。それで、彼はルベン人とガド人、およびマナセの半部族を捕らえ移し、彼らをハラフと、ハボルとハラとゴザンの川に連れて行った。今日もそのままである。","tok":[["そこ"],["で"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["、"],["アッシリヤ"],["の"],["王","おう"],["プル"],["の"],["霊","れい"],["と"],["、"],["アッシリヤ"],["の"],["王","おう"],["ティグラテ"],["・"],["ピレセル"],["の"],["霊","れい"],["を"],["奮い立たせられた","ふるいたたせられた"],["。"],["それ"],["で"],["、"],["彼","かれ"],["は"],["ルベン人","るべんにん"],["と"],["ガド人","がどにん"],["、"],["および"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["を"],["捕らえ","とらえ"],["移し","うつし"],["、"],["彼","かれ"],["ら"],["を"],["ハラフ"],["と"],["、"],["ハボル"],["と"],["ハラ"],["と"],["ゴザン"],["の"],["川","かわ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["今日","きょう"],["も"],["そのまま"],["で"],["ある"],["。"]]}]
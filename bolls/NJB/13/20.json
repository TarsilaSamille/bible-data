[{"verse":1,"text":"年が改まり、王たちが出陣するころ、ヨアブは軍勢を率いてアモン人の地を荒らし、さらに進んで、ラバを包囲した。ダビデはエルサレムにとどまっていた。ヨアブはラバを打ち、これを破壊した。","tok":[["年","ねん"],["が"],["改まり","あらたまり"],["、"],["王","おう"],["たち"],["が"],["出陣","しゅつじん"],["する"],["ころ"],["、"],["ヨアブ"],["は"],["軍勢","ぐんぜい"],["を"],["率いて","ひきいて"],["アモン人","あもんにん"],["の"],["地","ち"],["を"],["荒らし","あらし"],["、"],["さらに"],["進んで","すすんで"],["、"],["ラバ"],["を"],["包囲","ほうい"],["した"],["。"],["ダビデ"],["は"],["エルサレム"],["に"],["とどまって"],["いた"],["。"],["ヨアブ"],["は"],["ラバ"],["を"],["打ち","うち"],["、"],["これ"],["を"],["破壊","はかい"],["した"],["。"]]},{"verse":2,"text":"ダビデが、彼らの王の冠をその頭から取ったとき、それは金一タラントの重さがあり、それには宝石がはめ込まれているのがわかった。その冠はダビデの頭に置かれた。彼はまた、その町から非常に多くの分捕り物を持って来た。","tok":[["ダビデ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["王","おう"],["の"],["冠","かんむり"],["を"],["その"],["頭","あたま"],["から"],["取った","とった"],["とき"],["、"],["それ"],["は"],["金","きん"],["一","いち"],["タラント"],["の"],["重さ","おもさ"],["が"],["あり"],["、"],["それ"],["に"],["は"],["宝石","ほうせき"],["が"],["はめ込まれて","はめこまれて"],["いる"],["の"],["が"],["わかった"],["。"],["その"],["冠","かんむり"],["は"],["ダビデ"],["の"],["頭","あたま"],["に"],["置かれた","おかれた"],["。"],["彼","かれ"],["は"],["また"],["、"],["その"],["町","まち"],["から"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["分","ぶん"],["捕り物","とりもの"],["を"],["持って","もって"],["来た","きた"],["。"]]},{"verse":3,"text":"彼はその町の人々を連れて来て、石のこぎりや、鉄のつるはしや斧を使う仕事につかせた。ダビデはアモン人のすべての町々に対して、このようにした。こうして、ダビデと民のすべてはエルサレムに帰った。","tok":[["彼","かれ"],["は"],["その"],["町","まち"],["の"],["人々","ひとびと"],["を"],["連れて","つれて"],["来て","きて"],["、"],["石","いし"],["のこぎり"],["や"],["、"],["鉄","てつ"],["の"],["つるはし"],["や"],["斧","おの"],["を"],["使う","つかう"],["仕事","しごと"],["に"],["つかせた"],["。"],["ダビデ"],["は"],["アモン人","あもんにん"],["の"],["すべて"],["の"],["町々","まちまち"],["に対して","にたいして"],["、"],["この"],["よう"],["に"],["した"],["。"],["こう"],["して"],["、"],["ダビデ"],["と"],["民","たみ"],["の"],["すべて"],["は"],["エルサレム"],["に"],["帰った","かえった"],["。"]]},{"verse":4,"text":"その後、ゲゼルでペリシテ人との戦いが起こり、そのとき、フシャ人シベカイは、ラファの子孫のひとりシパイを打ち殺した。こうして、彼らは征服された。","tok":[["その"],["後","ご"],["、"],["ゲゼル"],["で"],["ペリシテ"],["人","にん"],["と"],["の"],["戦い","たたかい"],["が"],["起こり","おこり"],["、"],["その"],["とき"],["、"],["フシャ"],["人","ひと"],["シベカイ"],["は"],["、"],["ラファ"],["の"],["子孫","しそん"],["の"],["ひとり"],["シパイ"],["を"],["打ち殺した","うちころした"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["征服","せいふく"],["された"],["。"]]},{"verse":5,"text":"またペリシテ人との戦いがあったとき、ヤイルの子エルハナンは、ガテ人ゴリヤテの兄弟ラフミを打ち殺した。ラフミの槍の柄は、機織りの巻き棒のようであった。","tok":[["また"],["ペリシテ"],["人","にん"],["と"],["の"],["戦い","たたかい"],["が"],["あった"],["とき"],["、"],["ヤイル"],["の"],["子","こ"],["エルハナン"],["は"],["、"],["ガテ人","がてにん"],["ゴリヤテ"],["の"],["兄弟","きょうだい"],["ラフミ"],["を"],["打ち殺した","うちころした"],["。"],["ラフミ"],["の"],["槍","やり"],["の"],["柄","がら"],["は"],["、"],["機織り","はたおり"],["の"],["巻き","まき"],["棒","ぼう"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":6,"text":"さらに、ガテで戦いがあったとき、そこに、指が六本ずつ、二十四本ある背の高い男がいた。彼もまたラファの子孫であった。","tok":[["さらに"],["、"],["ガテ"],["で"],["戦い","たたかい"],["が"],["あった"],["とき"],["、"],["そこ"],["に"],["、"],["指","ゆび"],["が"],["六本","ろくぽん"],["ずつ"],["、"],["二十四本","にじゅうよんぽん"],["ある"],["背","せ"],["の"],["高い","たかい"],["男","おとこ"],["が"],["いた"],["。"],["彼","かれ"],["も"],["また"],["ラファ"],["の"],["子孫","しそん"],["で"],["あった"],["。"]]},{"verse":7,"text":"彼はイスラエルをそしったが、ダビデの兄弟シムアの子ヨナタンが彼を打ち殺した。","tok":[["彼","かれ"],["は"],["イスラエル"],["を"],["そしった"],["が"],["、"],["ダビデ"],["の"],["兄弟","きょうだい"],["シムア"],["の"],["子","こ"],["ヨナタン"],["が"],["彼","かれ"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":8,"text":"これらはガテのラファの子孫で、ダビデとその家来たちの手にかかって倒れた。","tok":[["これ"],["ら"],["は"],["ガテ"],["の"],["ラファ"],["の"],["子孫","しそん"],["で"],["、"],["ダビデ"],["と"],["その"],["家来","けらい"],["たち"],["の"],["手","て"],["に"],["かかって"],["倒れた","たおれた"],["。"]]}]
[{"verse":1,"text":"ここに、ダビデは千人隊の長、百人隊の長たち、すべての隊長と合議し、","tok":[["ここ"],["に"],["、"],["ダビデ"],["は"],["千人隊","せんにんたい"],["の"],["長","ちょう"],["、"],["百人隊","ひゃくにんたい"],["の"],["長","なが"],["たち"],["、"],["すべて"],["の"],["隊長","たいちょう"],["と"],["合議","ごうぎ"],["し"],["、"]]},{"verse":2,"text":"イスラエルの全集団に向かって、言った。「もしも、このことが、あなたがたによく、私たちの神、主の御旨から出たことなら、イスラエル全土に残っている私たちの同胞にいっせいに使者を送ろう。彼らのうちには、放牧地のある町々の祭司やレビ人もいる。彼らを私たちのもとに集めよう。","tok":[["イスラエル"],["の"],["全","ぜん"],["集団","しゅうだん"],["に"],["向かって","むかって"],["、"],["言った","いった"],["。"],["「"],["もし"],["も"],["、"],["この"],["こと"],["が"],["、"],["あなた"],["が"],["たに"],["よく"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御旨","おむね"],["から"],["出た","でた"],["こと"],["なら"],["、"],["イスラエル"],["全土","ぜんど"],["に"],["残って","のこって"],["いる"],["私たち","わたしたち"],["の"],["同胞","どうほう"],["に"],["いっせい"],["に"],["使者","ししゃ"],["を"],["送ろう","おくろう"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["は"],["、"],["放牧","ほうぼく"],["地","ち"],["の"],["ある"],["町々","まちまち"],["の"],["祭司","さいし"],["や"],["レビ人","れびにん"],["も"],["いる"],["。"],["彼","かれ"],["ら"],["を"],["私たち","わたしたち"],["の"],["もと"],["に"],["集めよう","あつめよう"],["。"]]},{"verse":3,"text":"私たちの神の箱を私たちのもとに持ち帰ろう。私たちは、サウルの時代には、これを顧みなかったから。」","tok":[["私たち","わたしたち"],["の"],["神","かみ"],["の"],["箱","ばこ"],["を"],["私たち","わたしたち"],["の"],["もと"],["に"],["持ち帰ろう","もちかえろう"],["。"],["私たち","わたしたち"],["は"],["、"],["サウル"],["の"],["時代","じだい"],["に"],["は"],["、"],["これ"],["を"],["顧みなかった","かえりみなかった"],["から"],["。"],["」"]]},{"verse":4,"text":"すると全集団は、そうしようと言った。すべての民がそのことを正しいと見たからである。","tok":[["する"],["と"],["全","ぜん"],["集団","しゅうだん"],["は"],["、"],["そう"],["しよう"],["と"],["言った","いった"],["。"],["すべて"],["の"],["民","たみ"],["が"],["その"],["こと"],["を"],["正しい","ただしい"],["と"],["見た","みた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"そこで、ダビデは、神の箱をキルヤテ・エアリムから運ぶため、エジプトのシホルからレボ・ハマテに至るまでの全イスラエルを召集した。","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["、"],["神","かみ"],["の"],["箱","ばこ"],["を"],["キルヤテ"],["・"],["エアリム"],["から"],["運ぶ","はこぶ"],["ため"],["、"],["エジプト"],["の"],["シホル"],["から"],["レボ"],["・"],["ハマテ"],["に"],["至る","いたる"],["まで"],["の"],["全","ぜん"],["イスラエル"],["を"],["召集","しょうしゅう"],["した"],["。"]]},{"verse":6,"text":"ダビデと全イスラエルは、バアラ、すなわち、ユダに属するキルヤテ・エアリムに上って行き、そこから、「ケルビムに座しておられる主」と呼ばれていた神の箱を運び上ろうとした。","tok":[["ダビデ"],["と"],["全","ぜん"],["イスラエル"],["は"],["、"],["バアラ"],["、"],["すなわち"],["、"],["ユダ"],["に"],["属する","ぞくする"],["キルヤテ"],["・"],["エアリム"],["に"],["上って","のぼって"],["行き","いき"],["、"],["そこ"],["から"],["、"],["「"],["ケルビム"],["に"],["座して","ざして"],["おられる"],["主","ぬし"],["」"],["と"],["呼ばれて","よばれて"],["いた"],["神","かみ"],["の"],["箱","ばこ"],["を"],["運び","はこび"],["上ろう","のぼろう"],["と"],["した"],["。"]]},{"verse":7,"text":"そこで彼らはアビナダブの家から神の箱を新しい車に載せた。ウザとアフヨがその車を御していた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["アビナダブ"],["の"],["家","いえ"],["から"],["神","かみ"],["の"],["箱","ばこ"],["を"],["新しい","あたらしい"],["車","くるま"],["に"],["載せた","のせた"],["。"],["ウザ"],["と"],["アフヨ"],["が"],["その"],["車","くるま"],["を"],["御して","ぎょして"],["いた"],["。"]]},{"verse":8,"text":"ダビデと全イスラエルは、歌を歌い、立琴、十弦の琴、タンバリン、シンバル、ラッパを鳴らして、神の前で力の限り喜び踊った。","tok":[["ダビデ"],["と"],["全","ぜん"],["イスラエル"],["は"],["、"],["歌","うた"],["を"],["歌い","うたい"],["、"],["立琴","たてごと"],["、"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["、"],["タンバリン"],["、"],["シンバル"],["、"],["ラッパ"],["を"],["鳴らして","ならして"],["、"],["神","かみ"],["の"],["前","まえ"],["で"],["力","ちから"],["の"],["限り","かぎり"],["喜び","よろこび"],["踊った","おどった"],["。"]]},{"verse":9,"text":"こうして彼らがキドンの打ち場まで来たとき、ウザは手を伸ばして、箱を押さえた。牛がそれをひっくり返しそうになったからである。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["が"],["キドン"],["の"],["打ち","うち"],["場","ば"],["まで"],["来た","きた"],["とき"],["、"],["ウザ"],["は"],["手","て"],["を"],["伸ばして","のばして"],["、"],["箱","ばこ"],["を"],["押さえた","おさえた"],["。"],["牛","うし"],["が"],["それ"],["を"],["ひっくり返し","ひっくりかえし"],["そう"],["に"],["なった"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"すると、主の怒りがウザに向かって燃え上がり、彼を打った。彼が手を箱に伸べたからである。彼はその場で神の前に死んだ。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["が"],["ウザに"],["向かって","むかって"],["燃え上がり","もえあがり"],["、"],["彼","かれ"],["を"],["打った","うった"],["。"],["彼","かれ"],["が"],["手","て"],["を"],["箱","ばこ"],["に"],["伸べた","のべた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["その"],["場","ば"],["で"],["神","かみ"],["の"],["前","まえ"],["に"],["死んだ","しんだ"],["。"]]},{"verse":11,"text":"ダビデの心は激した。ウザによる割りこみに主が怒りを発せられたからである。それでその場所はペレツ・ウザと呼ばれた。今日もそうである。","tok":[["ダビデ"],["の"],["心","こころ"],["は"],["激した","げきした"],["。"],["ウザ"],["に"],["よる"],["割りこみ","わりこみ"],["に"],["主","ぬし"],["が"],["怒り","いかり"],["を"],["発せられた","はっせられた"],["から"],["で"],["ある"],["。"],["それ"],["で"],["その"],["場所","ばしょ"],["は"],["ペレツ"],["・"],["ウザ"],["と"],["呼ばれた","よばれた"],["。"],["今日","きょう"],["も"],["そう"],["で"],["ある"],["。"]]},{"verse":12,"text":"その日ダビデは神を恐れて言った。「私はどうして、私のところに神の箱をお運びできましょうか。」","tok":[["その"],["日","ひ"],["ダビデ"],["は"],["神","かみ"],["を"],["恐れて","おそれて"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["どう"],["して"],["、"],["私","わたくし"],["の"],["ところ"],["に"],["神","かみ"],["の"],["箱","ばこ"],["を"],["お運び","おはこび"],["できましょう"],["か"],["。"],["」"]]},{"verse":13,"text":"そこで、ダビデは箱を彼のところダビデの町には移さず、ガテ人オベデ・エドムの家にそれを回した。","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["箱","ばこ"],["を"],["彼","かれ"],["の"],["ところ"],["ダビデ"],["の"],["町","まち"],["に"],["は"],["移さず","うつさず"],["、"],["ガテ人","がてにん"],["オベデ"],["・"],["エドム"],["の"],["家","いえ"],["に"],["それ"],["を"],["回した","まわした"],["。"]]},{"verse":14,"text":"このようにして、神の箱はオベデ・エドムの家族とともに、彼の家に三か月間とどまった。主はオベデ・エドムの家と、彼に属するすべてのものを祝福された。","tok":[["この"],["よう"],["に"],["して"],["、"],["神","かみ"],["の"],["箱","ばこ"],["は"],["オベデ"],["・"],["エドム"],["の"],["家族","かぞく"],["と"],["とも"],["に"],["、"],["彼","かれ"],["の"],["家","いえ"],["に"],["三","さん"],["か月間","かげつかん"],["とどまった"],["。"],["主","ぬし"],["は"],["オベデ"],["・"],["エドム"],["の"],["家","いえ"],["と"],["、"],["彼","かれ"],["に"],["属する","ぞくする"],["すべて"],["の"],["もの"],["を"],["祝福","しゅくふく"],["された"],["。"]]}]
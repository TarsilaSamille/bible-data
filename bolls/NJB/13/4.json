[{"verse":1,"text":"ユダの子孫は、ペレツ、ヘツロン、カルミ、フル、ショバル。","tok":[["ユダ"],["の"],["子孫","しそん"],["は"],["、"],["ペレツ"],["、"],["ヘツロン"],["、"],["カルミ"],["、"],["フル"],["、"],["ショバル"],["。"]]},{"verse":2,"text":"ショバルの子レアヤはヤハテを生み、ヤハテはアフマイとラハデを生んだ。これらはツォルア人の諸氏族である。","tok":[["ショバル"],["の"],["子","こ"],["レアヤ"],["は"],["ヤハテ"],["を"],["生み","うみ"],["、"],["ヤハテ"],["は"],["アフマイ"],["と"],["ラハデ"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["は"],["ツォルア"],["人","にん"],["の"],["諸氏族","しょしぞく"],["で"],["ある"],["。"]]},{"verse":3,"text":"エタムの父の子は次のとおりである。イズレエル、イシュマ、イデバシュ。彼らの姉妹の名はハツェレルポニ。","tok":[["エタム"],["の"],["父","ちち"],["の"],["子","こ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["イズレエル"],["、"],["イシュマ"],["、"],["イデバシュ"],["。"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["の"],["名","な"],["は"],["ハツェレルポニ"],["。"]]},{"verse":4,"text":"ゲドルの父ペヌエルとフシャの父エゼル。これらがベツレヘムの父、エフラテの長子、フルの子である。","tok":[["ゲドル"],["の"],["父","ちち"],["ペヌエル"],["と"],["フシャ"],["の"],["父","ちち"],["エゼル"],["。"],["これ"],["ら"],["が"],["ベツレヘム"],["の"],["父","ちち"],["、"],["エフラテ"],["の"],["長子","ちょうし"],["、"],["フル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":5,"text":"テコアの父アシュフルにはふたりの妻、ヘルアとナアラがいた。","tok":[["テコア"],["の"],["父","ちち"],["アシュフル"],["に"],["は"],["ふたり"],["の"],["妻","つま"],["、"],["ヘルア"],["と"],["ナアラ"],["が"],["いた"],["。"]]},{"verse":6,"text":"ナアラは彼に、アフザム、ヘフェル、テメニ、アハシュタリを産んだ。これらがナアラの子である。","tok":[["ナアラ"],["は"],["彼","かれ"],["に"],["、"],["アフザム"],["、"],["ヘフェル"],["、"],["テメニ"],["、"],["アハシュタリ"],["を"],["産んだ","うんだ"],["。"],["これ"],["ら"],["が"],["ナアラ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":7,"text":"ヘルアの子は、ツェレテ、ツォハル、エテナン。","tok":[["ヘルア"],["の"],["子","こ"],["は"],["、"],["ツェレテ"],["、"],["ツォハル"],["、"],["エテナン"],["。"]]},{"verse":8,"text":"コツは、アヌブ、ツォベバ、それにハルムの子アハルヘルの諸氏族を生んだ。","tok":[["コツ"],["は"],["、"],["アヌブ"],["、"],["ツォベバ"],["、"],["それ"],["に"],["ハルム"],["の"],["子","こ"],["アハルヘル"],["の"],["諸","しょ"],["氏族","しぞく"],["を"],["生んだ","うんだ"],["。"]]},{"verse":9,"text":"ヤベツは彼の兄弟たちよりも重んじられた。彼の母は、「私が悲しみのうちにこの子を産んだから」と言って、彼にヤベツという名をつけた。","tok":[["ヤベツ"],["は"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["より"],["も"],["重んじられた","おもんじられた"],["。"],["彼","かれ"],["の"],["母","はは"],["は"],["、"],["「"],["私","わたくし"],["が"],["悲しみ","かなしみ"],["の"],["うち"],["に"],["この"],["子","こ"],["を"],["産んだ","うんだ"],["から"],["」"],["と"],["言って","いって"],["、"],["彼","かれ"],["に"],["ヤベツ"],["と"],["いう"],["名","な"],["を"],["つけた"],["。"]]},{"verse":10,"text":"ヤベツはイスラエルの神に呼ばわって言った。「私を大いに祝福し、私の地境を広げてくださいますように。御手が私とともにあり、わざわいから遠ざけて私が苦しむことのないようにしてくださいますように。」そこで神は彼の願ったことをかなえられた。","tok":[["ヤベツ"],["は"],["イスラエル"],["の"],["神","かみ"],["に"],["呼ばわって","よばわって"],["言った","いった"],["。"],["「"],["私","わたくし"],["を"],["大いに","おおいに"],["祝福","しゅくふく"],["し"],["、"],["私","わたくし"],["の"],["地境","じざかい"],["を"],["広げて","ひろげて"],["くださいます"],["よう"],["に"],["。"],["御手","おて"],["が"],["私","わたくし"],["と"],["とも"],["に"],["あり"],["、"],["わざわい"],["から"],["遠ざけて","とおざけて"],["私","わたくし"],["が"],["苦しむ","くるしむ"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["くださいます"],["よう"],["に"],["。"],["」"],["そこ"],["で"],["神","かみ"],["は"],["彼","かれ"],["の"],["願った","ねがった"],["こと"],["を"],["かなえられた"],["。"]]},{"verse":11,"text":"シュハの兄弟ケルブはメヒルを生んだ。彼はエシュトンの父であった。","tok":[["シュハ"],["の"],["兄弟","きょうだい"],["ケルブ"],["は"],["メヒル"],["を"],["生んだ","うんだ"],["。"],["彼","かれ"],["は"],["エシュトン"],["の"],["父","ちち"],["で"],["あった"],["。"]]},{"verse":12,"text":"エシュトンは、ベテ・ラファ、パセアハ、イル・ナハシュの父テヒナを生んだ。これらはレカの人々である。","tok":[["エシュトン"],["は"],["、"],["ベテ"],["・"],["ラファ"],["、"],["パセアハ"],["、"],["イル"],["・"],["ナハシュ"],["の"],["父","ちち"],["テヒナ"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["は"],["レカ"],["の"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":13,"text":"ケナズの子たちは、オテニエル、セラヤ。オテニエルの子たちは、ハタテとメオノタイ。","tok":[["ケナズ"],["の"],["子","こ"],["たち"],["は"],["、"],["オテニエル"],["、"],["セラヤ"],["。"],["オテニエル"],["の"],["子","こ"],["たち"],["は"],["、"],["ハタテ"],["と"],["メオノタイ"],["。"]]},{"verse":14,"text":"メオノタイはオフラを生み、セラヤはゲ・ハラシムの父ヨアブを生んだ。彼らは職人だったのである。","tok":[["メオノタイ"],["は"],["オフラ"],["を"],["生み","うみ"],["、"],["セラヤ"],["は"],["ゲ"],["・"],["ハラシム"],["の"],["父","ちち"],["ヨアブ"],["を"],["生んだ","うんだ"],["。"],["彼","かれ"],["ら"],["は"],["職人","しょくにん"],["だった"],["ので"],["ある"],["。"]]},{"verse":15,"text":"エフネの子カレブの子たちは、イル、エラ、ナアム。エラの子たちは、ケナズ。","tok":[["エフネ"],["の"],["子"
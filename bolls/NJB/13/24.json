[{"verse":1,"text":"アロンの子らの組分け。アロンの子らは、ナダブ、アビフ、エルアザル、イタマル。","tok":[["アロン"],["の"],["子","こ"],["ら"],["の"],["組分け","くみわけ"],["。"],["アロン"],["の"],["子","こ"],["ら"],["は"],["、"],["ナダブ"],["、"],["アビフ"],["、"],["エルアザル"],["、"],["イタマル"],["。"]]},{"verse":2,"text":"ナダブとアビフはその父に先立って死に、彼らには子どもがなかったので、エルアザルとイタマルが祭司の務めについた。","tok":[["ナダブ"],["と"],["アビフ"],["は"],["その"],["父","ちち"],["に"],["先立って","さきだって"],["死に","しに"],["、"],["彼","かれ"],["ら"],["に"],["は"],["子ども","こども"],["が"],["なかった"],["ので"],["、"],["エルアザル"],["と"],["イタマル"],["が"],["祭司","さいし"],["の"],["務め","つとめ"],["に"],["ついた"],["。"]]},{"verse":3,"text":"ダビデは、エルアザルの子孫のひとりツァドク、およびイタマルの子孫のひとりアヒメレクと協力して、彼らをそれぞれの奉仕に任命し、それぞれの組に分けた。","tok":[["ダビデ"],["は"],["、"],["エルアザル"],["の"],["子孫","しそん"],["の"],["ひとり"],["ツァドク"],["、"],["および"],["イタマル"],["の"],["子孫","しそん"],["の"],["ひとり"],["アヒメレク"],["と"],["協力","きょうりょく"],["して"],["、"],["彼","かれ"],["ら"],["を"],["それぞれ"],["の"],["奉仕","ほうし"],["に"],["任命","にんめい"],["し"],["、"],["それぞれ"],["の"],["組","くみ"],["に"],["分けた","わけた"],["。"]]},{"verse":4,"text":"エルアザルの子孫のほうが、イタマルの子孫よりも一族のかしらが多かったので、エルアザルの子孫は、父祖の家のかしらごとに十六組に、イタマルの子孫は、父祖の家ごとに八組に分けられた。","tok":[["エルアザル"],["の"],["子孫","しそん"],["の"],["ほう"],["が"],["、"],["イタマル"],["の"],["子孫","しそん"],["より"],["も"],["一族","いちぞく"],["の"],["かしら"],["が"],["多かった","おおかった"],["ので"],["、"],["エルアザル"],["の"],["子孫","しそん"],["は"],["、"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["かしら"],["ごと"],["に"],["十六","じゅうろく"],["組","くみ"],["に"],["、"],["イタマル"],["の"],["子孫","しそん"],["は"],["、"],["父祖","ふそ"],["の"],["家","いえ"],["ごと"],["に"],["八","はち"],["組","くみ"],["に"],["分けられた","わけられた"],["。"]]},{"verse":5,"text":"彼らはくじを引いて互いにそれぞれの組に分かれた。聖所の組のつかさたち、神の組のつかさたちは、エルアザルの子孫の中にも、イタマルの子孫の中にもいたからである。","tok":[["彼","かれ"],["ら"],["は"],["くじ"],["を"],["引いて","ひいて"],["互い","たがい"],["に"],["それぞれ"],["の"],["組","くみ"],["に"],["分かれた","わかれた"],["。"],["聖","せい"],["所","しょ"],["の"],["組","くみ"],["の"],["つかさ"],["たち"],["、"],["神","かみ"],["の"],["組","くみ"],["の"],["つかさ"],["たち"],["は"],["、"],["エルアザル"],["の"],["子孫","しそん"],["の"],["中","なか"],["に"],["も"],["、"],["イタマル"],["の"],["子孫","しそん"],["の"],["中","なか"],["に"],["も"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"レビ人の出の書記、ネタヌエルの子シェマヤが、王とつかさたち、および祭司ツァドクとエブヤタルの子アヒメレク、それに祭司とレビ人の一族のかしらたちの前で、それらを書きしるした。エルアザルの父祖の家を一つ一つ、イタマルのを一つ一つ。","tok":[["レビ人","れびにん"],["の"],["出","で"],["の"],["書記","しょき"],["、"],["ネタヌエル"],["の"],["子","こ"],["シェマヤ"],["が"],["、"],["王","おう"],["と"],["つかさ"],["たち"],["、"],["および"],["祭司","さいし"],["ツァドク"],["と"],["エブヤタル"],["の"],["子","こ"],["アヒメレク"],["、"],["それ"],["に"],["祭司","さいし"],["と"],["レビ人","れびにん"],["の"],["一族","いちぞく"],["の"],["かしら"],["たち"],["の"],["前","まえ"],["で"],["、"],["それ"],["ら"],["を"],["書きしるした","かきしるした"],["。"],["エルアザル"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["を"],["一","ひと"],["つ"],["一","ひと"],["つ"],["、"],["イタマル"],["の"],["を"],["一","ひと"],["つ"],["一","ひと"],["つ"],["。"]]},{"verse":7,"text":"第一のくじは、エホヤリブに当たった。第二はエダヤに、","tok":[["第","だい"],["一","いち"],["の"],["くじ"],["は"],["、"],["エホヤリブ"],["に"],["当たった","あたった"],["。"],["第","だい"],["二","に"],["は"],["エダヤ"],["に"],["、"]]},{"verse":8,"text":"第三はハリムに、第四はセオリムに、","tok":[["第","だい"],["三","さん"],["は"],["ハリム"],["に"],["、"],["第","だい"],["四","よん"],["は"],["セオリム"],["に"],["、"]]},{"verse":9,"text":"第五はマルキヤに、第六はミヤミンに、","tok":[["第","だい"],["五","ご"],["は"],["マルキヤ"],["に"],["、"],["第","だい"],["六","ろく"],["は"],["ミヤミン"],["に"],["、"]]},{"verse":10,"text":"第七はコツに、第八はアビヤに、","tok":[["第","だい"],["七","なな"],["は"],["コツ"],["に"],["、"],["第","だい"],["八","はち"],["は"],["アビヤ"],["に"],["、"]]},{"verse":11,"text":"第九はヨシュアに、第十はシェカヌヤに、","tok":[["第","だい"],["九","きゅう"],["は"],["ヨシュア"],["に"],["、"],["第","だい"],["十","じゅう"],["は"],["シェカヌヤ"],["に"],["、"]]},{"verse":12,"text":"第十一はエルヤシブに、第十二はヤキムに、","tok":[["第","だい"],["十一","じゅういち"],["は"],["エルヤシブ"],["に"],["、"],["第","だい"],["十二","じゅうに"],["は"],["ヤキム"],["に"],["、"]]},{"verse":13,"text":"第十三はフパに、第十四はエシェブアブに、","tok":[["第","だい"],["十三","じゅうさん"],["は"],["フパ"],["に"],["、"],["第","だい"],["十四","じゅうよん"],["は"],["エシェブアブ"],["に"],["、"]]},{"verse":14,"text":"第十五はビルガに、第十六はイメルに、","tok":[["第","だい"],["十五","じゅうご"],["は"],["ビルガ"],["に"],["、"],["第","だい"],["十六","じゅうろく"],["は"],["イメル"],["に"],["、"]]},{"verse":15,"text":"第十七はヘジルに、第十八はピツェツに、","tok":[["第","だい"],["十七","じゅ
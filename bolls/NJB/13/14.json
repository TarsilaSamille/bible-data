[{"verse":1,"text":"ツロの王ヒラムは、ダビデのもとに使者を送り、ダビデの王宮を建てるために杉材、石工、大工を送った。","tok":[["ツロ"],["の"],["王","おう"],["ヒラム"],["は"],["、"],["ダビデ"],["の"],["もと"],["に"],["使者","ししゃ"],["を"],["送り","おくり"],["、"],["ダビデ"],["の"],["王宮","おうきゅう"],["を"],["建てる","たてる"],["ため"],["に"],["杉材","すぎざい"],["、"],["石工","せっこう"],["、"],["大工","だいく"],["を"],["送った","おくった"],["。"]]},{"verse":2,"text":"ダビデは、主が彼をイスラエルの王として堅く立て、主の民イスラエルのために、彼の王権がいよいよ盛んにされているのを知った。","tok":[["ダビデ"],["は"],["、"],["主","ぬし"],["が"],["彼","かれ"],["を"],["イスラエル"],["の"],["王","おう"],["として"],["堅く","かたく"],["立て","たて"],["、"],["主","ぬし"],["の"],["民","みん"],["イスラエル"],["の"],["ため"],["に"],["、"],["彼","かれ"],["の"],["王権","おうけん"],["が"],["いよいよ"],["盛ん","さかん"],["に"],["されて"],["いる"],["の"],["を"],["知った","しった"],["。"]]},{"verse":3,"text":"ダビデはエルサレムで、さらに妻たちをめとった。ダビデはさらに、息子、娘たちを生んだ。","tok":[["ダビデ"],["は"],["エルサレム"],["で"],["、"],["さらに"],["妻たち","つまたち"],["を"],["めとった"],["。"],["ダビデ"],["は"],["さらに"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["を"],["生んだ","うんだ"],["。"]]},{"verse":4,"text":"エルサレムで彼に生まれた子の名は次のとおり。シャムア、ショバブ、ナタン、ソロモン、","tok":[["エルサレム"],["で"],["彼","かれ"],["に"],["生まれた","うまれた"],["子","こ"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["。"],["シャムア"],["、"],["ショバブ"],["、"],["ナタン"],["、"],["ソロモン"],["、"]]},{"verse":5,"text":"イブハル、エリシュア、エルペレテ、","tok":[["イブハル"],["、"],["エリシュア"],["、"],["エルペレテ"],["、"]]},{"verse":6,"text":"ノガハ、ネフェグ、ヤフィア、","tok":[["ノガハ"],["、"],["ネフェグ"],["、"],["ヤフィア"],["、"]]},{"verse":7,"text":"エリシャマ、ベエルヤダ、エリフェレテ。","tok":[["エリシャマ"],["、"],["ベエルヤダ"],["、"],["エリフェレテ"],["。"]]},{"verse":8,"text":"ペリシテ人は、ダビデが油をそそがれて全イスラエルの王となったことを聞いた。そこでペリシテ人はみな、ダビデをねらって上って来た。ダビデはそれと聞き、彼らを迎え撃ちに出た。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["ダビデ"],["が"],["油","あぶら"],["を"],["そそがれて"],["全","ぜん"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["こと"],["を"],["聞いた","きいた"],["。"],["そこ"],["で"],["ペリシテ"],["人","にん"],["は"],["みな"],["、"],["ダビデ"],["を"],["ねらって"],["上って","のぼって"],["来た","きた"],["。"],["ダビデ"],["は"],["それ"],["と"],["聞き","きき"],["、"],["彼","かれ"],["ら"],["を"],["迎え撃ち","むかえうち"],["に"],["出た","でた"],["。"]]},{"verse":9,"text":"ペリシテ人は来て、レファイムの谷間に突入した。","tok":[["ペリシテ"],["人","にん"],["は"],["来て","きて"],["、"],["レファイム"],["の"],["谷間","たにま"],["に"],["突入","とつにゅう"],["した"],["。"]]},{"verse":10,"text":"そこで、ダビデは神に伺って言った。「ペリシテ人を攻めに上るべきでしょうか。彼らを私の手に渡してくださるでしょうか。」すると主は彼に仰せられた。「上れ。わたしは彼らをあなたの手に渡す。」","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["神","かみ"],["に"],["伺って","うかがって"],["言った","いった"],["。"],["「"],["ペリシテ"],["人","にん"],["を"],["攻め","せめ"],["に"],["上るべきでしょう","のぼるべきでしょう"],["か"],["。"],["彼","かれ"],["ら"],["を"],["私","わたくし"],["の"],["手","て"],["に"],["渡して","わたして"],["くださるでしょう"],["か"],["。"],["」"],["する"],["と"],["主","ぬし"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["上れ","のぼれ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["」"]]},{"verse":11,"text":"それで、みなはバアル・ペラツィムに上り、ダビデはそこで彼らを打った。そして、ダビデは言った。「神は、水が破れ出るように、私の手を用いて私の敵を破られた。」それゆえ、その場所の名はバアル・ペラツィムと呼ばれた。","tok":[["それ"],["で"],["、"],["みな"],["は"],["バアル"],["・"],["ペラツィム"],["に"],["上り","のぼり"],["、"],["ダビデ"],["は"],["そこ"],["で"],["彼","かれ"],["ら"],["を"],["打った","うった"],["。"],["そして"],["、"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["神","かみ"],["は"],["、"],["水","みず"],["が"],["破れ","やぶれ"],["出る","でる"],["よう"],["に"],["、"],["私","わたくし"],["の"],["手","て"],["を"],["用いて","もちいて"],["私","わたくし"],["の"],["敵","てき"],["を"],["破られた","やぶられた"],["。"],["」"],["それ"],["ゆえ"],["、"],["その"],["場所","ばしょ"],["の"],["名","な"],["は"],["バアル"],["・"],["ペラツィム"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":12,"text":"彼らが自分たちの神々を置き去りにして行ったので、ダビデは命じて、これを火で焼いた。","tok":[["彼","かれ"],["ら"],["が"],["自分","じぶん"],["たち"],["の"],["神々","かみがみ"],["を"],["置き去り","おきざり"],["に"],["して"],["行った","いった"],["ので"],["、"],["ダビデ"],["は"],["命じて","めいじて"],["、"],["これ"],["を"],["火","ひ"],["で"],["焼いた","やいた"],["。"]]},{"verse":13,"text":"ところがペリシテ人は、なおもまたその谷間に突入して来た。","tok":[["ところ"],["が"],["ペリシテ"],["人","にん"],["は"],["、"],["なお"],["も"],["また"],["その"],["谷間","たにま"],["に"],["突入","とつにゅう"],["して"],["来た","きた"],["。"]]},{"verse":14,"text":"そこで、ダビデがさらに神に伺ったところ、神は彼に仰せられた。「彼らを追って上って行くな。彼らには面と向かわず、回って行き、バルサム樹の林の前から彼らに向かえ。","tok":[["そこ"],["で"],["、"],["ダビデ"],["が"],["さらに"],["神","かみ"],["に"],["伺った","うかがった"],["ところ"],["、"],["神","かみ"],["は"],["彼","かれ"],["に"],["仰せられた","おおせられた"],["。"],["「"],["彼","かれ"],["ら"],["を"],["追って","おって"],["上って","のぼって"],["行く","いく"],["な"],["。"],["彼","かれ"],["ら"],["に"],["は"],["面","めん"],["と"],["向かわず","むかわず"],["、"],["回って","まわって"],["行き","いき"],["、"],["バルサム"],["樹","じゅ"],["の"],["林","はやし"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["に"],["向かえ","むかえ"],["。"]]},{"verse":15,"text":"バルサム樹の林の上から行進の音が聞こえたら、そのとき、あなたは戦いに行け。神はすでに、ペリシテ人の陣営を打つために、あなたより先に出ているから。」","tok":[["バルサム"],["樹","じゅ"],["の"],["林","はやし"],["の"],["上","うえ"],["から"],["行進","こうしん"],["の"],["音","おと"],["が"],["聞こえたら","きこえたら"],["、"],["その"],["とき"],["、"],["あなた"],["は"],["戦い","たたかい"],["に"],["行け","いけ"],["。"],["神","かみ"],["は"],["すでに"],["、"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["を"],["打つ","うつ"],["ため"],["に"],["、"],["あなた"],["より"],["先","さき"],["に"],["出て","でて"],["いる"],["から"],["。"],["」"]]},{"verse":16,"text":"ダビデは、神が彼に命じたとおりにし、彼らはギブオンからゲゼルまでのペリシテ人の陣営を打った。","tok":[["ダビデ"],["は"],["、"],["神","かみ"],["が"],["彼","かれ"],["に"],["命じた","めいじた"],["とおり"],["に"],["し"],["、"],["彼","かれ"],["ら"],["は"],["ギブオン"],["から"],["ゲゼル"],["まで"],["の"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["を"],["打った","うった"],["。"]]},{"verse":17,"text":"こうして、ダビデの名声はあまねく全地に及んだ。主はすべての国々に、彼に対する恐怖を起こされた。","tok":[["こう"],["して"],["、"],["ダビデ"],["の"],["名声","めいせい"],["は"],["あまねく"],["全地","ぜんち"],["に"],["及んだ","およんだ"],["。"],["主","ぬし"],["は"],["すべて"],["の"],["国々","くにぐに"],["に"],["、"],["彼","かれ"],["に"],["対する","たいする"],["恐怖","きょうふ"],["を"],["起こされた","おこされた"],["。"]]}]
[{"verse":1,"text":"イッサカル族の者は、トラ、プア、ヤシュブ、シムロンの四人。","tok":[["イッサカル"],["族","ぞく"],["の"],["者","もの"],["は"],["、"],["トラ"],["、"],["プア"],["、"],["ヤシュブ"],["、"],["シムロン"],["の"],["四人","よんにん"],["。"]]},{"verse":2,"text":"トラの子は、ウジ、レファヤ、エリエル、ヤフマイ、イブサム、シェムエル。これは彼ら一族の、すなわち、トラのかしらであって、彼らの家系の勇士であった。その数はダビデの時代には二万二千六百人であった。","tok":[["トラ"],["の"],["子","こ"],["は"],["、"],["ウジ"],["、"],["レファヤ"],["、"],["エリエル"],["、"],["ヤフマイ"],["、"],["イブサム"],["、"],["シェムエル"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["一族","いちぞく"],["の"],["、"],["すなわち"],["、"],["トラ"],["の"],["かしら"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["の"],["家系","かけい"],["の"],["勇士","ゆうし"],["で"],["あった"],["。"],["その"],["数","すう"],["は"],["ダビデ"],["の"],["時代","じだい"],["に"],["は"],["二万二千六百","にまんにせんろくひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":3,"text":"ウジの子たちは、イゼラヘヤ。イゼラヘヤの子たちは、ミカエル、オバデヤ、ヨエル、イシヤ。合わせて五人。彼らはみなかしらであった。","tok":[["ウジ"],["の"],["子","こ"],["たち"],["は"],["、"],["イゼラヘヤ"],["。"],["イゼラヘヤ"],["の"],["子","こ"],["たち"],["は"],["、"],["ミカエル"],["、"],["オバデヤ"],["、"],["ヨエル"],["、"],["イシヤ"],["。"],["合わせて","あわせて"],["五人","ごにん"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["かしら"],["で"],["あった"],["。"]]},{"verse":4,"text":"この人々に加えて、彼ら一族の者、彼らの家系の者で、戦いに備えた軍隊は三万六千人であった。彼らは多くの妻子を得たからである。","tok":[["この"],["人々","ひとびと"],["に"],["加えて","くわえて"],["、"],["彼","かれ"],["ら"],["一族","いちぞく"],["の"],["者","もの"],["、"],["彼","かれ"],["ら"],["の"],["家系","かけい"],["の"],["者","もの"],["で"],["、"],["戦い","たたかい"],["に"],["備えた","そなえた"],["軍隊","ぐんたい"],["は"],["三万六千","さんまんろくせん"],["人","にん"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["多く","おおく"],["の"],["妻子","さいし"],["を"],["得た","えた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"イッサカル全氏族の同胞で、系図に載せられた勇士は全部で八万七千人であった。","tok":[["イッサカル"],["全","ぜん"],["氏族","しぞく"],["の"],["同胞","どうほう"],["で"],["、"],["系図","けいず"],["に"],["載せられた","のせられた"],["勇士","ゆうし"],["は"],["全部","ぜんぶ"],["で"],["八万七千","はちまんななせん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":6,"text":"ベニヤミンは、ベラ、ベケル、エディアエルの三人。","tok":[["ベニヤミン"],["は"],["、"],["ベラ"],["、"],["ベケル"],["、"],["エディアエル"],["の"],["三人","さんにん"],["。"]]},{"verse":7,"text":"ベラの子は、エツボン、ウジ、ウジエル、エリモテ、イリの五人。これらは彼ら一族のかしらであり、勇士であった。系図に載せられた者は二万二千三十四人であった。","tok":[["ベラ"],["の"],["子","こ"],["は"],["、"],["エツボン"],["、"],["ウジ"],["、"],["ウジエル"],["、"],["エリモテ"],["、"],["イリ"],["の"],["五人","ごにん"],["。"],["これ"],["ら"],["は"],["彼","かれ"],["ら"],["一族","いちぞく"],["の"],["かしら"],["で"],["あり"],["、"],["勇士","ゆうし"],["で"],["あった"],["。"],["系図","けいず"],["に"],["載せられた","のせられた"],["者","もの"],["は"],["二万二千三十四","にまんにせんみつじゅうよん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":8,"text":"ベケルの子は、ゼミラ、ヨアシュ、エリエゼル、エルヨエナイ、オムリ、エレモテ、アビヤ、アナトテ、アレメテ。これらはみなベケルの子であった。","tok":[["ベケル"],["の"],["子","こ"],["は"],["、"],["ゼミラ"],["、"],["ヨアシュ"],["、"],["エリエゼル"],["、"],["エルヨエナイ"],["、"],["オムリ"],["、"],["エレモテ"],["、"],["アビヤ"],["、"],["アナトテ"],["、"],["アレメテ"],["。"],["これ"],["ら"],["は"],["みな"],["ベケル"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":9,"text":"その子孫のうち、彼らの系図に載せられた一族のかしらで勇士である者の数は、二万二百人であった。","tok":[["その"],["子孫","しそん"],["の"],["うち"],["、"],["彼","かれ"],["ら"],["の"],["系図","けいず"],["に"],["載せられた","のせられた"],["一族","いちぞく"],["の"],["かしら"],["で"],["勇士","ゆうし"],["で"],["ある"],["者","もの"],["の"],["数","かず"],["は"],["、"],["二万二百","にまんにひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":10,"text":"エディアエルの子たちは、ビルハン。ビルハンの子たちは、エウシュ、ベニヤミン、エフデ、ケナアナ、ゼタン、タルシシュ、アヒシャハル。","tok":[["エディアエル"],["の"],["子","こ"],["たち"],["は"],["、"],["ビルハン"],["。"],["ビルハン"],["の"],["子","こ"],["たち"],["は"],["、"],["エウシュ"],["、"],["ベニヤミン"],["、"],["エフデ"],["、"],["ケナアナ"],["、"],["ゼタン"],["、"],["タルシシュ"],["、"],["アヒシャハル"],["。"]]},{"verse":11,"text":"これらはみなエディアエルの子であった。彼らは、一族のかしらであり勇士であって、一万七千二百人、従軍して戦いに出る者であった。","tok":[["これ"],["ら"],["は"],["みな"],["エディアエル"],["の"],["子","こ"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["一族","いちぞく"],["の"],["かしら"],["で"],["あり"],["勇士","ゆうし"],["で"],["あって"],["、"],["一万七千二百","いちまんななせんにひゃく"],["人","にん"],["、"],["従軍","じゅうぐん"],["して"],["戦い","たたかい"],["に"],["出る","でる"],["者","もの"],["で"],["あった"],["。"]]},{"verse":12,"text":"シュピムとフピムは、イルの子であり、フシムがアヘルの子であった。","tok":[["シュピム"],["と"],["フピム"],["は"],["、"],["イル"],["の"],["子","こ"],["で"],["あり"],["、"],["フシム"],["が"],["アヘル"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":13,"text":"ナフタリの子は、ヤハツィエル、グニ、エツェル、シャルム。これらはビルハの子であった。","tok":[["ナフタリ"],["の"],["子","こ"],["は"],["、"],["ヤハツィエル"],["、"],["グニ"],["、"],["エツェル"],["、"],["シャルム"],["。"],["これ"],["ら"],["は"],["ビルハ"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":14,"text":"マナセの子は、アスリエル、――彼のアラム人のそばめが産んだ。彼女はギルアデの父マキルを産んだ。","tok":[["マナセ"],["の"],["子","こ"],["は"],["、"],["アスリエル"],["、"],["―"],["―"],["彼","かれ"],["の"],["アラム人","あらむにん"],["の"],["そばめ"],["が"],["産んだ","うんだ"],["。"],["彼女","かのじょ"],["は"],["ギルアデ"],["の"],["父","ちち"],["マキル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":15,"text":"マキルはフピムとシュピムのために妻をめとった。彼の妹の名をマアカと言った――それから次男の名はツェロフハデ。ツェロフハデには女の子どもたちがあった。","tok":[["マキル"],["は"],["フピム"],["と"],["シュピム"],["の"],["ため"],["に"],["妻","つま"],["を"],["めとった"],["。"],["彼","かれ"],["の"],["妹","いもうと"],["の"],["名","な"],["を"],["マアカ"],["と"],["言った","いった"],["―"],["―"],["それ"],["から"],["次男","じなん"],["の"],["名","な"],["は"],["ツェロフハデ"],["。"],["ツェロフハデ"],["に"],["は"],["女","おんな"],["の"],["子ども","こども"],["たち"],["が"],["あった"],["。"]]},{"verse":16,"text":"マキルの妻マアカは男の子を産み、その名をペレシュと呼んだ。その弟の名はシェレシュであり、その子はウラムとレケムであった。","tok":[["マキル"],["の"],["妻","つま"],["マアカ"],["は"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["その"],["名","な"],["を"],["ペレシュ"],["と"],["呼んだ","よんだ"],["。"],["その"],["弟","おとうと"],["の"],["名","な"],["は"],["シェレシュ"],["で"],["あり"],["、"],["その"],["子","こ"],["は"],["ウラム"],["と"],["レケム"],["で"],["あった"],["。"]]},{"verse":17,"text":"ウラムの子は、ベダン。これらがマナセの子マキルの子ギルアデの子であった。","tok":[["ウラム"],["の"],["子","こ"],["は"],["、"],["ベダン"],["。"],["これ"],["ら"],["が"],["マナセ"],["の"],["子","こ"],["マキル"],["の"],["子","こ"],["ギルアデ"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":18,"text":"また、彼の妹モレケテは、イシュホデ、アビエゼル、マフラを産んだ。","tok":[["また"],["、"],["彼","かれ"],["の"],["妹","いもうと"],["モレケテ"],["は"],["、"],["イシュホデ"],["、"],["アビエゼル"],["、"],["マフラ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":19,"text":"それから、シェミダの子は、アフヤン、シェケム、リクヒ、アニアムであった。","tok":[["それ"],["から"],["、"],["シェミダ"],["の"],["子","こ"],["は"],["、"],["アフヤン"],["、"],["シェケム"],["、"],["リクヒ"],["、"],["アニアム"],["で"],["あった"],["。"]]},{"verse":20,"text":"エフライムの子たちは、シュテラフ、その子、ベレデ、その子のタハテ、その子のエルアダ、その子のタハテ、","tok":[["エフライム"],["の"],["子","こ"],["たち"],["は"],["、"],["シュテラフ"],["、"],["その"],["子","こ"],["、"],["ベレデ"],["、"],["その"],["子","こ"],["の"],["タハテ"],["、"],["その"],["子","こ"],["の"],["エルアダ"],["、"],["その"],["子","こ"],["の"],["タハテ"],["、"]]},{"verse":21,"text":"その子のザバデ、その子のシュテラフ。それに、エゼル、エルアデであるが、彼らはこの地の生まれであるガテの人々に殺された。彼らが家畜を奪おうとして下って行ったからである。","tok":[["その"],["子","こ"],["の"],["ザバデ"],["、"],["その"],["子","こ"],["の"],["シュテラフ"],["。"],["それ"],["に"],["、"],["エゼル"],["、"],["エルアデ"],["で"],["ある"],["が"],["、"],["彼","かれ"],["ら"],["は"],["この"],["地","ち"],["の"],["生まれ","うまれ"],["で"],["ある"],["ガテ"],["の"],["人々","ひとびと"],["に"],["殺された","ころされた"],["。"],["彼","かれ"],["ら"],["が"],["家畜","かちく"],["を"],["奪おう","うばおう"],["として"],["下って","くだって"],["行った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"彼らの父エフライムは、何日もの間、喪に服したので、彼の兄弟たちが来て、彼を慰めた。","tok":[["彼","かれ"],["ら"],["の"],["父","ちち"],["エフライム"],["は"],["、"],["何日","なんにち"],["も"],["の"],["間","あいだ"],["、"],["喪","も"],["に"],["服した","ふくした"],["ので"],["、"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["が"],["来て","きて"],["、"],["彼","かれ"],["を"],["慰めた","なぐさめた"],["。"]]},{"verse":23,"text":"その後、エフライムは、妻のところに入った。彼女はみごもって男の子を産んだ。彼はその子をベリアと名づけた。その家がわざわいのさなかにあったからである。","tok":[["その"],["後","ご"],["、"],["エフライム"],["は"],["、"],["妻","つま"],["の"],["ところ"],["に"],["入った","はいった"],["。"],["彼女","かのじょ"],["は"],["みごもって"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["彼","かれ"],["は"],["その"],["子","こ"],["を"],["ベリア"],["と"],["名づけた","なづけた"],["。"],["その"],["家","いえ"],["が"],["わざわい"],["の"],["さなか"],["に"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"彼の娘はシェエラであった。彼女は上および下ベテ・ホロン、およびウゼン・シェエラを建てた。","tok":[["彼","かれ"],["の"],["娘","むすめ"],["は"],["シェエラ"],["で"],["あった"],["。"],["彼女","かのじょ"],["は"],["上","うえ"],["および"],["下","した"],["ベテ"],["・"],["ホロン"],["、"],["および"],["ウゼン"],["・"],["シェエラ"],["を"],["建てた","たてた"],["。"]]},{"verse":25,"text":"彼の子はレファフ、レシェフ。その子はテラフ、その子はタハン、","tok":[["彼","かれ"],["の"],["子","こ"],["は"],["レファフ"],["、"],["レシェフ"],["。"],["その"],["子","こ"],["は"],["テラフ"],["、"],["その"],["子","こ"],["は"],["タハン"],["、"]]},{"verse":26,"text":"その子はラダン、その子はアミフデ、その子はエリシャマ、","tok":[["その"],["子","こ"],["は"],["ラダン"],["、"],["その"],["子","こ"],["は"],["アミフデ"],["、"],["その"],["子","こ"],["は"],["エリシャマ"],["、"]]},{"verse":27,"text":"その子はヌン、その子はヨシュア。","tok":[["その"],["子","こ"],["は"],["ヌン"],["、"],["その"],["子","こ"],["は"],["ヨシュア"],["。"]]},{"verse":28,"text":"また、彼らの所有地と居住地は、ベテルとそれに属する村落、東方ではナアラン、西方ではゲゼルとそれに属する村落、それからシェケムとそれに属する村落、そしてアヤとそれに属する村落に至る。","tok":[["また"],["、"],["彼","かれ"],["ら"],["の"],["所有地","しょゆうち"],["と"],["居住地","きょじゅうち"],["は"],["、"],["ベテル"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["東方","とうほう"],["で"],["は"],["ナアラン"],["、"],["西方","せいほう"],["で"],["は"],["ゲゼル"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["それ"],["から"],["シェケム"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["そして"],["アヤ"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["に"],["至る","いたる"],["。"]]},{"verse":29,"text":"マナセ族との境では、ベテ・シェアンとそれに属する村落、タナクとそれに属する村落、メギドとそれに属する村落、ドルとそれに属する村落であった。これらの地に、イスラエルの子ヨセフの子孫は住んだ。","tok":[["マナセ族","まなせぞく"],["と"],["の"],["境","さかい"],["で"],["は"],["、"],["ベテ"],["・"],["シェアン"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["タナク"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["メギド"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["、"],["ドル"],["と"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["で"],["あった"],["。"],["これ"],["ら"],["の"],["地","ち"],["に"],["、"],["イスラエル"],["の"],["子","こ"],["ヨセフ"],["の"],["子孫","しそん"],["は"],["住んだ","すんだ"],["。"]]},{"verse":30,"text":"アシェルの子は、イムナ、イシュワ、イシュビ、ベリアと彼らの姉妹セラフ。","tok":[["アシェル"],["の"],["子","こ"],["は"],["、"],["イムナ"],["、"],["イシュワ"],["、"],["イシュビ"],["、"],["ベリア"],["と"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["セラフ"],["。"]]},{"verse":31,"text":"ベリアの子は、ヘベル、マルキエル。マルキエルはビルザイテの父。","tok":[["ベリア"],["の"],["子","こ"],["は"],["、"],["ヘベル"],["、"],["マルキエル"],["。"],["マルキエル"],["は"],["ビルザイテ"],["の"],["父","ちち"],["。"]]},{"verse":32,"text":"ヘベルは、ヤフレテ、ショメル、ホタムと彼らの姉妹シュアを生んだ。","tok":[["ヘベル"],["は"],["、"],["ヤフレテ"],["、"],["ショメル"],["、"],["ホタム"],["と"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["シュア"],["を"],["生んだ","うんだ"],["。"]]},{"verse":33,"text":"ヤフレテの子は、パサク、ビムハル、アシュワテ。これがヤフレテの子らであった。","tok":[["ヤフレテ"],["の"],["子","こ"],["は"],["、"],["パサク"],["、"],["ビムハル"],["、"],["アシュワテ"],["。"],["これ"],["が"],["ヤフレテ"],["の"],["子","こ"],["ら"],["で"],["あった"],["。"]]},{"verse":34,"text":"ショメルの子は、アヒ、ロフガ、フバ、アラム。","tok":[["ショメル"],["の"],["子","こ"],["は"],["、"],["アヒ"],["、"],["ロフガ"],["、"],["フバ"],["、"],["アラム"],["。"]]},{"verse":35,"text":"彼の兄弟ヘレムの子は、ツォファフ、イムナ、シェレシュ、アマル。","tok":[["彼","かれ"],["の"],["兄弟","きょうだい"],["ヘレム"],["の"],["子","こ"],["は"],["、"],["ツォファフ"],["、"],["イムナ"],["、"],["シェレシュ"],["、"],["アマル"],["。"]]},{"verse":36,"text":"ツォファフの子は、スアハ、ハルネフェル、シュアル、ベリ、イムラ、","tok":[["ツォファフ"],["の"],["子","こ"],["は"],["、"],["スアハ"],["、"],["ハルネフェル"],["、"],["シュアル"],["、"],["ベリ"],["、"],["イムラ"],["、"]]},{"verse":37,"text":"ベツェル、ホデ、シャマ、シルシャ、イテラン、ベエラ。","tok":[["ベツェル"],["、"],["ホデ"],["、"],["シャマ"],["、"],["シルシャ"],["、"],["イテラン"],["、"],["ベエラ"],["。"]]},{"verse":38,"text":"エテルの子は、エフネ、ピスパ、アラ。","tok":[["エテル"],["の"],["子","こ"],["は"],["、"],["エフネ"],["、"],["ピスパ"],["、"],["アラ"],["。"]]},{"verse":39,"text":"ウラの子は、アラフ、ハニエル、リツヤ。","tok":[["ウラ"],["の"],["子","こ"],["は"],["、"],["アラフ"],["、"],["ハニエル"],["、"],["リツヤ"],["。"]]},{"verse":40,"text":"これらはみなアシェルの子で、一族のかしら、えり抜きの勇士、長たちのかしらであった。戦いのとき軍務につく者として彼らの系図に載せられた者の数は、二万六千人であった。","tok":[["これ"],["ら"],["は"],["みな"],["アシェル"],["の"],["子","こ"],["で"],["、"],["一族","いちぞく"],["の"],["かしら"],["、"],["えり抜き","えりぬき"],["の"],["勇士","ゆうし"],["、"],["長","なが"],["たち"],["の"],["かしら"],["で"],["あった"],["。"],["戦い","たたかい"],["の"],["とき"],["軍務","ぐんむ"],["に"],["つく"],["者","もの"],["として"],["彼","かれ"],["ら"],["の"],["系図","けいず"],["に"],["載せられた","のせられた"],["者","もの"],["の"],["数","かず"],["は"],["、"],["二万六千","にまんろくせん"],["人","にん"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"彼はダビデの町に自分のために家を造り、また、神の箱のために場所を定め、そのために天幕を張った。","tok":[["彼","かれ"],["は"],["ダビデ"],["の"],["町","まち"],["に"],["自分","じぶん"],["の"],["ため"],["に"],["家","いえ"],["を"],["造り","つくり"],["、"],["また"],["、"],["神","かみ"],["の"],["箱","ばこ"],["の"],["ため"],["に"],["場所","ばしょ"],["を"],["定め","さだめ"],["、"],["その"],["ため"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["。"]]},{"verse":2,"text":"そのとき、ダビデは言った。「レビ人でなければ、神の箱をかついではならない。主は、主の箱をかつがせ、とこしえまでも、ご自身に仕えさせるために、彼らを選ばれたからである。」","tok":[["その"],["とき"],["、"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["レビ人","れびにん"],["で"],["なければ"],["、"],["神","かみ"],["の"],["箱","ばこ"],["を"],["かついで"],["は"],["ならない"],["。"],["主","ぬし"],["は"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["かつがせ"],["、"],["とこしえ"],["まで"],["も"],["、"],["ご自身","ごじしん"],["に"],["仕えさせる","つかえさせる"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["選ばれた","えらばれた"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":3,"text":"ダビデは全イスラエルをエルサレムに呼び出して、主の箱を定めておいた場所へ運び上らせようとした。","tok":[["ダビデ"],["は"],["全","ぜん"],["イスラエル"],["を"],["エルサレム"],["に"],["呼び出して","よびだして"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["定めて","さだめて"],["おいた"],["場所","ばしょ"],["へ"],["運び","はこび"],["上らせよう","のぼらせよう"],["と"],["した"],["。"]]},{"verse":4,"text":"そこで、ダビデは、アロンの子らとレビ人とを集めた。","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["、"],["アロン"],["の"],["子","こ"],["ら"],["と"],["レビ人","れびにん"],["と"],["を"],["集めた","あつめた"],["。"]]},{"verse":5,"text":"ケハテ族から、そのつかさウリエルと、彼の同族の者百二十人。","tok":[["ケハテ族","けはてぞく"],["から"],["、"],["その"],["つかさ"],["ウリエル"],["と"],["、"],["彼","かれ"],["の"],["同族","どうぞく"],["の"],["者","もの"],["百二","ひゃくに"],["十人","じゅうにん"],["。"]]},{"verse":6,"text":"メラリ族から、そのつかさアサヤと、彼の同族の者二百二十人。","tok":[["メラリ族","めらりぞく"],["から"],["、"],["その"],["つかさ"],["アサヤ"],["と"],["、"],["彼","かれ"],["の"],["同族","どうぞく"],["の"],["者","もの"],["二百二","にひゃくに"],["十人","じゅうにん"],["。"]]},{"verse":7,"text":"ゲルショム族から、そのつかさヨエルと、彼の同族の者百三十人。","tok":[["ゲルショム"],["族","ぞく"],["から"],["、"],["その"],["つかさ"],["ヨエル"],["と"],["、"],["彼","かれ"],["の"],["同族","どうぞく"],["の"],["者","もの"],["百三","ひゃくさん"],["十人","じゅうにん"],["。"]]},{"verse":8,"text":"エリツァファン族から、そのつかさシェマヤと、彼の同族の者二百人。","tok":[["エリツァファン"],["族","ぞく"],["から"],["、"],["その"],["つかさ"],["シェマヤ"],["と"],["、"],["彼","かれ"],["の"],["同族","どうぞく"],["の"],["者","もの"],["二百人","にひゃくにん"],["。"]]},{"verse":9,"text":"ヘブロン族から、そのつかさエリエルと、彼の同族の者八十人。","tok":[["ヘブロン"],["族","ぞく"],["から"],["、"],["その"],["つかさ"],["エリエル"],["と"],["、"],["彼","かれ"],["の"],["同族","どうぞく"],["の"],["者","もの"],["八","はち"],["十人","じゅうにん"],["。"]]},{"verse":10,"text":"ウジエル族から、そのつかさアミナダブと、彼の同族の者百十二人。","tok":[["ウジエル"],["族","ぞく"],["から"],["、"],["その"],["つかさ"],["アミナダブ"],["と"],["、"],["彼","かれ"],["の"],["同族","どうぞく"],["の"],["者","もの"],["百十二人","ひゃくじゅうににん"],["。"]]},{"verse":11,"text":"ダビデは祭司ツァドクとエブヤタル、それにレビ人たち、ウリエルとアサヤ、ヨエルとシェマヤ、エリエル、アミナダブを呼び、","tok":[["ダビデ"],["は"],["祭司","さいし"],["ツァドク"],["と"],["エブヤタル"],["、"],["それ"],["に"],["レビ人","れびにん"],["たち"],["、"],["ウリエル"],["と"],["アサヤ"],["、"],["ヨエル"],["と"],["シェマヤ"],["、"],["エリエル"],["、"],["アミナダブ"],["を"],["呼び","よび"],["、"]]},{"verse":12,"text":"彼らに言った。「あなたがたはレビ人の家のかしらです。あなたがた自身も、あなたがたの同族の者たちも、身を聖別し、イスラエルの神、主の箱を、私がそのために定めておいた所に運び上りなさい。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["レビ人","れびにん"],["の"],["家","いえ"],["の"],["かしら"],["です"],["。"],["あなた"],["がた"],["自身","じしん"],["も"],["、"],["あなた"],["がた"],["の"],["同族","どうぞく"],["の"],["者","もの"],["たち"],["も"],["、"],["身","み"],["を"],["聖別","せいべつ"],["し"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["、"],["私","わたくし"],["が"],["その"],["ため"],["に"],["定めて","さだめて"],["おいた"],["所","ところ"],["に"],["運び","はこび"],["上り","のぼり"],["なさい"],["。"]]},{"verse":13,"text":"最初の時には、あなたがたがいなかったため、私たちの神、主が、私たちに怒りを発せられたのです。私たちがこの方を定めのとおりに求めなかったからです。」","tok":[["最初","さいしょ"],["の"],["時","とき"],["に"],["は"],["、"],["あなた"],["がた"],["が"],["いなかった"],["ため"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["私たち","わたしたち"],["に"],["怒り","いかり"],["を"],["発せられた","はっせられた"],["の"],["です"],["。"],["私たち","わたしたち"],["が"],["この"],["方","ほう"],["を"],["定め","さだめ"],["の"],["とおり"],["に"],["求めなかった","もとめなかった"],["から"],["です"],["。"],["」"]]},{"verse":14,"text":"そこで、祭司たちとレビ人たちは、イスラエルの神、主の箱を運び上るために身を聖別した。","tok":[["そこ"],["で"],["、"],["祭司","さいし"],["たち"],["と"],["レビ人","れびにん"],["たち"],["は"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["運び","はこび"],["上る","のぼる"],["ため"],["に"],["身","み"],["を"],["聖別","せいべつ"],["した"],["。"]]},{"verse":15,"text":"そして、レビ族は、モーセが主のことばに従って命じたとおり、神の箱をにない棒で肩にかついだ。","tok":[["そして"],["、"],["レビ族","れびぞく"],["は"],["、"],["モーセ"],["が"],["主","ぬし"],["の"],["ことば"],["に"],["従って","したがって"],["命じた","めいじた"],["とおり"],["、"],["神","かみ"],["の"],["箱","ばこ"],["を"],["に"],["ない"],["棒","ぼう"],["で"],["肩","かた"],["に"],["かついだ"],["。"]]},{"verse":16,"text":"ここに、ダビデはレビ人のつかさたちに、彼らの同族の者たちを十弦の琴、立琴、シンバルなどの楽器を使う歌うたいとして立て、喜びの声をあげて歌わせるよう命じた。","tok":[["ここ"],["に"],["、"],["ダビデ"],["は"],["レビ人","れびにん"],["の"],["つかさ"],["たち"],["に"],["、"],["彼","かれ"],["ら"],["の"],["同族","どうぞく"],["の"],["者","もの"],["たち"],["を"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["、"],["立琴","たてごと"],["、"],["シンバル"],["など"],["の"],["楽器","がっき"],["を"],["使う","つかう"],["歌うたい","うたうたい"],["として"],["立て","たて"],["、"],["喜び","よろこび"],["の"],["声","こえ"],["を"],["あげて"],["歌わせる","うたわせる"],["よう"],["命じた","めいじた"],["。"]]},{"verse":17,"text":"そこで、レビ人は、ヨエルの子ヘマン、彼の同族からベレクヤの子アサフ、メラリ族から彼らの同族クシャヤの子エタンを立てた。","tok":[["そこ"],["で"],["、"],["レビ人","れびにん"],["は"],["、"],["ヨエル"],["の"],["子","こ"],["ヘマン"],["、"],["彼","かれ"],["の"],["同族","どうぞく"],["から"],["ベレクヤ"],["の"],["子","こ"],["アサフ"],["、"],["メラリ族","めらりぞく"],["から"],["彼","かれ"],["ら"],["の"],["同族","どうぞく"],["クシャヤ"],["の"],["子","こ"],["エタン"],["を"],["立てた","たてた"],["。"]]},{"verse":18,"text":"第二の部類に属する彼らの同族の者たちも、彼らとともにいた。すなわち、ゼカリヤ、ベン、ヤアジエル、シェミラモテ、エヒエル、ウニ、エリアブ、ベナヤ、マアセヤ、マティテヤ、エリフェレフ、ミクネヤ、門衛オベデ・エドムとエイエル。","tok":[["第","だい"],["二","に"],["の"],["部類","ぶるい"],["に"],["属する","ぞくする"],["彼","かれ"],["ら"],["の"],["同族","どうぞく"],["の"],["者","もの"],["たち"],["も"],["、"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["いた"],["。"],["すなわち"],["、"],["ゼカリヤ"],["、"],["ベン"],["、"],["ヤアジエル"],["、"],["シェミラモテ"],["、"],["エヒエル"],["、"],["ウニ"],["、"],["エリアブ"],["、"],["ベナヤ"],["、"],["マアセヤ"],["、"],["マティテヤ"],["、"],["エリフェレフ"],["、"],["ミクネヤ"],["、"],["門衛","もんえい"],["オベデ"],["・"],["エドム"],["と"],["エイエル"],["。"]]},{"verse":19,"
[{"verse":1,"text":"ヘブロンで生まれたダビデの子は次のとおりである。長子はイズレエル人アヒノアムによるアムノン。次男はカルメル人アビガイルによるダニエル。","tok":[["ヘブロン"],["で"],["生まれた","うまれた"],["ダビデ"],["の"],["子","こ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["長子","ちょうし"],["は"],["イズレエル"],["人","にん"],["アヒノアム"],["に"],["よる"],["アムノン"],["。"],["次男","じなん"],["は"],["カルメル"],["人","にん"],["アビガイル"],["に"],["よる"],["ダニエル"],["。"]]},{"verse":2,"text":"三男はゲシュルの王タルマイの娘マアカの子アブシャロム。四男はハギテの子アドニヤ。","tok":[["三男","さんなん"],["は"],["ゲシュル"],["の"],["王","おう"],["タルマイ"],["の"],["娘","むすめ"],["マアカ"],["の"],["子","こ"],["アブシャロム"],["。"],["四男","よんなん"],["は"],["ハギテ"],["の"],["子","こ"],["アドニヤ"],["。"]]},{"verse":3,"text":"五男はアビタルによるシェファテヤ。六男は彼の妻エグラによるイテレアム。","tok":[["五男","いつお"],["は"],["アビタル"],["に"],["よる"],["シェファテヤ"],["。"],["六男","むつお"],["は"],["彼","かれ"],["の"],["妻","つま"],["エグラ"],["に"],["よる"],["イテレアム"],["。"]]},{"verse":4,"text":"六人の子がヘブロンで彼に生まれた。ダビデはそこで七年六か月治め、エルサレムで三十三年治めた。","tok":[["六人","ろくにん"],["の"],["子","こ"],["が"],["ヘブロン"],["で"],["彼","かれ"],["に"],["生まれた","うまれた"],["。"],["ダビデ"],["は"],["そこ"],["で"],["七","なな"],["年","ねん"],["六","ろく"],["か月","かげつ"],["治め","おさめ"],["、"],["エルサレム"],["で"],["三十三","さんじゅうさん"],["年","ねん"],["治めた","おさめた"],["。"]]},{"verse":5,"text":"エルサレムで彼に生まれた者は次のとおりである。シムア、ショバブ、ナタン、ソロモン。この四人はアミエルの娘バテ・シュアによる子である。","tok":[["エルサレム"],["で"],["彼","かれ"],["に"],["生まれた","うまれた"],["者","もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["シムア"],["、"],["ショバブ"],["、"],["ナタン"],["、"],["ソロモン"],["。"],["この"],["四人","よんにん"],["は"],["アミエル"],["の"],["娘","むすめ"],["バテ"],["・"],["シュア"],["に"],["よる"],["子","こ"],["で"],["ある"],["。"]]},{"verse":6,"text":"イブハル、エリシャマ、エリフェレテ、","tok":[["イブハル"],["、"],["エリシャマ"],["、"],["エリフェレテ"],["、"]]},{"verse":7,"text":"ノガハ、ネフェグ、ヤフィア、","tok":[["ノガハ"],["、"],["ネフェグ"],["、"],["ヤフィア"],["、"]]},{"verse":8,"text":"エリシャマ、エルヤダ、エリフェレテの九人。","tok":[["エリシャマ"],["、"],["エルヤダ"],["、"],["エリフェレテ"],["の"],["九人","きゅうにん"],["。"]]},{"verse":9,"text":"みなダビデの子であるが、別にそばめたちの子もあり、タマルは彼らの姉妹であった。","tok":[["みな"],["ダビデ"],["の"],["子","こ"],["で"],["ある"],["が"],["、"],["別","べつ"],["に"],["そばめ"],["たち"],["の"],["子","こ"],["も"],["あり"
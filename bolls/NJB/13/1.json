[{"verse":1,"text":"アダム、セツ、エノシュ、","tok":[["アダム"],["、"],["セツ"],["、"],["エノシュ"],["、"]]},{"verse":2,"text":"ケナン、マハラルエル、エレデ、","tok":[["ケナン"],["、"],["マハラ"],["ルエル"],["、"],["エレデ"],["、"]]},{"verse":3,"text":"エノク、メトシェラ、レメク、","tok":[["エノク"],["、"],["メトシェラ"],["、"],["レメク"],["、"]]},{"verse":4,"text":"ノア、セム、ハム、それにヤペテ。","tok":[["ノア"],["、"],["セム"],["、"],["ハム"],["、"],["それ"],["に"],["ヤペテ"],["。"]]},{"verse":5,"text":"ヤペテの子孫は、ゴメル、マゴグ、マダイ、ヤワン、トバル、メシェク、ティラス。","tok":[["ヤペテ"],["の"],["子孫","しそん"],["は"],["、"],["ゴメル"],["、"],["マゴグ"],["、"],["マダイ"],["、"],["ヤワン"],["、"],["トバル"],["、"],["メシェク"],["、"],["ティラス"],["。"]]},{"verse":6,"text":"ゴメルの子孫は、アシュケナズ、ディファテ、トガルマ。","tok":[["ゴメル"],["の"],["子孫","しそん"],["は"],["、"],["アシュケナズ"],["、"],["ディファテ"],["、"],["トガルマ"],["。"]]},{"verse":7,"text":"ヤワンの子孫は、エリシャ、タルシシュ、キティム人、ロダニム人。","tok":[["ヤワン"],["の"],["子孫","しそん"],["は"],["、"],["エリシャ"],["、"],["タルシシュ"],["、"],["キティム"],["人","にん"],["、"],["ロダニム"],["人","にん"],["。"]]},{"verse":8,"text":"ハムの子孫は、クシュ、ミツライム、プテ、カナン。","tok":[["ハム"],["の"],["子孫","しそん"],["は"],["、"],["クシュ"],["、"],["ミツライム"],["、"],["プテ"],["、"],["カナン"],["。"]]},{"verse":9,"text":"クシュの子孫は、セバ、ハビラ、サブタ、ラマ、サブテカ。ラマの子孫は、シェバ、デダン。","tok":[["クシュ"],["の"],["子孫","しそん"],["は"],["、"],["セバ"],["、"],["ハビラ"],["、"],["サブタ"],["、"],["ラマ"],["、"],["サブテカ"],["。"],["ラマ"],["の"],["子孫","しそん"],["は"],["、"],["シェバ"],["、"],["デダン"],["。"]]},{"verse":10,"text":"クシュはニムロデを生んだ。ニムロデは地上で最初の権力者となった。","tok":[["クシュ"],["は"],["ニムロデ"],["を"],["生んだ","うんだ"],["。"],["ニムロデ"],["は"],["地上","ちじょう"],["で"],["最初","さいしょ"],["の"],["権力者","けんりょくしゃ"],["と"],["なった"],["。"]]},{"verse":11,"text":"ミツライムは、ルデ人、アナミム人、レハビム人、ナフトヒム人を生み、","tok":[["ミツライム"],["は"],["、"],["ルデ人","るでにん"],["、"],["アナミム"],["人","にん"],["、"],["レハビム"],["人","にん"],["、"],["ナフトヒム"],["人","にん"],["を"],["生み","うみ"],["、"]]},{"verse":12,"text":"パテロス人、カスルヒム人――これからペリシテ人が出た――、カフトル人を生んだ。","tok":[["パテロス"],["人","にん"],["、"],["カスルヒム"],["人","にん"],["―"],["―"],["これ"],["から"],["ペリシテ"],["人","にん"],["が"],["出た","でた"],["―"],["―"],["、"],["カフトル"],["人","にん"],["を"],["生んだ","うんだ"],["。"]]},{"verse":13,"text":"カナンは、長子シドン、ヘテ、","tok":[["カナン"],["は"],["、"],["長子","ちょうし"],["シドン"],["、"],["ヘテ"],["、"]]},{"verse":14,"text":"エブス人、エモリ人、ギルガシ人、","tok":[["エブス人","えぶすにん"],["、"],["エモリ人","えもりにん"],["、"],["ギルガシ"],["人","にん"],["、"]]},{"verse":15,"text":"ヒビ人、アルキ人、シニ人、","tok":[["ヒビ人","ひびにん"],["、"],["アルキ人","あるきにん"],["、"],["シニ人","しににん"],["、"]]},{"verse":16,"text":"アルワデ人、ツェマリ人、ハマテ人を生んだ。","tok":[["アルワデ"],["人","にん"],["、"],["ツェマリ"],["人","にん"],["、"],["ハマテ人","はまてにん"],["を"],["生んだ","うんだ"],["。"]]},{"verse":17,"text":"セムの子孫は、エラム、アシュル、アルパクシャデ、ルデ、アラム、ウツ、フル、ゲテル、メシェク。","tok":[["セム"],["の"],["子孫","しそん"],["は"],["、"],["エラム"],["、"],["アシュル"],["、"],["アルパクシャデ"],["、"],["ルデ"],["、"],["アラム"],["、"],["ウツ"],["、"],["フル"],["、"],["ゲテル"],["、"],["メシェク"],["。"]]},{"verse":18,"text":"アルパクシャデはシェラフを生み、シェラフはエベルを生んだ。","tok":[["アルパクシャデ"],["は"],["シェラフ"],["を"],["生み","うみ"],["、"],["シェラフ"],["は"],["エベル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":19,"text":"エベルにはふたりの男の子が生まれ、ひとりの名はペレグであった。彼の時代に地が分けられたからである。もうひとりの兄弟の名はヨクタンであった。","tok":[["エベル"],["に"],["は"],["ふたり"],["の"],["男の子","おとこのこ"],["が"],["生まれ","うまれ"],["、"],["ひとり"],["の"],["名","な"],["は"],["ペレグ"],["で"],["あった"],["。"],["彼","かれ"],["の"],["時代","じだい"],["に"],["地","ち"],["が"],["分けられた","わけられた"],["から"],["で"],["ある"],["。"],["もう"],["ひとり"],["の"],["兄弟","きょうだい"],["の"],["名","な"],["は"],["ヨクタン"],["で"],["あった"],["。"]]},{"verse":20,"text":"ヨクタンは、アルモダデ、シェレフ、ハツァルマベテ、エラフ、","tok":[["ヨクタン"],["は"],["、"],["アルモダデ"],["、"],["シェレフ"],["、"],["ハツァルマベテ"],["、"],["エラフ"],["、"]]},{"verse":21,"text":"ハドラム、ウザル、ディクラ、","tok":[["ハドラム"],["、"],["ウザル"],["、"],["ディクラ"],["、"]]},{"verse":22,"text":"エバル、アビマエル、シェバ、","tok":[["エバル"],["、"],["アビマエル"],["、"],["シェバ"],["、"]]},{"verse":23,"text":"オフィル、ハビラ、ヨバブを生んだ。これらはみなヨクタンの子孫であった。","tok":[["オフィル"],["、"],["ハビラ"],["、"],["ヨバブ"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["は"],["みな"],["ヨクタン"],["の"],["子孫","しそん"],["で"],["あった"],["。"]]},{"verse":24,"text":"セム、アルパクシャデ、シェラフ、","tok":[["セム"],["、"],["アルパクシャデ"],["、"],["シェラフ"],["、"]]},{"verse":25,"text":"エベル、ペレグ、レウ、","tok":[["エベル"],["、"],["ペレグ"],["、"],["レウ"],["、"]]},{"verse":26,"text":"セルグ、ナホル、テラ、","tok":[["セルグ"],["、"],["ナホル"],["、"],["テラ"],["、"]]},{"verse":27,"text":"アブラム、すなわちアブラハム。","tok":[["アブラム"],["、"],["すなわち"],["アブラハム"],["。"]]},{"verse":28,"text":"アブラハムの子は、イサク、イシュマエル。","tok":[["アブラハム"],["の"],["子","こ"],["は"],["、"],["イサク"],["、"],["イシュマエル"],["。"]]},{"verse":29,"text":"これは彼らの歴史である。イシュマエルの長子はネバヨテ。ケダル、アデベエル、ミブサム、","tok":[["これ"],["は"],["彼","かれ"],["ら"],["の"],["歴史","れきし"],["で"],["ある"],["。"],["イシュマエル"],["の"],["長子","ちょうし"],["は"],["ネバヨテ"],["。"],["ケダル"],["、"],["アデベエル"],["、"],["ミブサム"],["、"]]},{"verse":30,"text":"ミシュマ、ドマ、マサ、ハダデ、テマ、","tok":[["ミシュマ"],["、"],["ドマ"],["、"],["マサ"],["、"],["ハダデ"],["、"],["テマ"],["、"]]},{"verse":31,"text":"エトル、ナフィシュ、ケデマ。これがイシュマエルの子孫である。","tok":[["エトル"],["、"],["ナフィシュ"],["、"],["ケデマ"],["。"],["これ"],["が"],["イシュマエル"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":32,"text":"アブラハムのそばめケトラの息子たち。彼女は、ジムラン、ヨクシャン、メダン、ミデヤン、イシュバク、シュアハを産んだ。ヨクシャンの子は、シェバ、デダン。","tok":[["アブラハム"],["の"],["そばめ"],["ケトラ"],["の"],["息子","むすこ"],["たち"],["。"],["彼女","かのじょ"],["は"],["、"],["ジムラン"],["、"],["ヨクシャン"],["、"],["メダン"],["、"],["ミデヤン"],["、"],["イシュバク"],["、"],["シュアハ"],["を"],["産んだ","うんだ"],["。"],["ヨクシャン"],["の"],["子","こ"],["は"],["、"],["シェバ"],["、"],["デダン"],["。"]]},{"verse":33,"text":"ミデヤンの子は、エファ、エフェル、エノク、アビダ、エルダア。これらはみな、ケトラの子孫である。","tok":[["ミデヤン"],["の"],["子","こ"],["は"],["、"],["エファ"],["、"],["エフェル"],["、"],["エノク"],["、"],["アビダ"],["、"],["エルダア"],["。"],["これ"],["ら"],["は"],["みな"],["、"],["ケトラ"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":34,"text":"アブラハムはイサクを生んだ。イサクの子は、エサウ、イスラエル。","tok":[["アブラハム"],["は"],["イサク"],["を"],["生んだ","うんだ"],["。"],["イサク"],["の"],["子","こ"],["は"],["、"],["エサウ"],["、"],["イスラエル"],["。"]]},{"verse":35,"text":"エサウの子は、エリファズ、レウエル、エウシュ、ヤラムとコラ、","tok":[["エサウ"],["の"],["子","こ"],["は"],["、"],["エリファズ"],["、"],["レウエル"],["、"],["エウシュ"],["、"],["ヤラム"],["と"],["コラ"],["、"]]},{"verse":36,"text":"エリファズの子は、テマン、オマル、ツェフィとガタム、ケナズ、ティムナ、アマレク。","tok":[["エリファズ"],["の"],["子","こ"],["は"],["、"],["テマン"],["、"],["オマル"],["、"],["ツェフィ"],["と"],["ガタム"],["、"],["ケナズ"],["、"],["ティムナ"],["、"],["アマレク"],["。"]]},{"verse":37,"text":"レウエルの子は、ナ
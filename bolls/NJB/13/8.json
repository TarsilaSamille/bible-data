[{"verse":1,"text":"ベニヤミンは、その長子ベラ、次男アシュベル、三男アフラフ、","tok":[["ベニヤミン"],["は"],["、"],["その"],["長子","ちょうし"],["ベラ"],["、"],["次男","じなん"],["アシュベル"],["、"],["三男","さんなん"],["アフラフ"],["、"]]},{"verse":2,"text":"四男ノハ、五男ラファを生んだ。","tok":[["四男","よんなん"],["ノハ"],["、"],["五男","いつお"],["ラファ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":3,"text":"ベラの子は、アダル、ゲラ、アビフデ、","tok":[["ベラ"],["の"],["子","こ"],["は"],["、"],["アダル"],["、"],["ゲラ"],["、"],["アビフデ"],["、"]]},{"verse":4,"text":"アビシュア、ナアマン、アホアハ、","tok":[["アビシュア"],["、"],["ナアマン"],["、"],["アホアハ"],["、"]]},{"verse":5,"text":"ゲラ、シェフファンとフラムであった。","tok":[["ゲラ"],["、"],["シェフ"],["ファン"],["と"],["フラム"],["で"],["あった"],["。"]]},{"verse":6,"text":"エフデの子は次のとおりである。――彼らはゲバの住民の一族のかしらで、マナハテに捕らえ移された者たちである。","tok":[["エフデ"],["の"],["子","こ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["―"],["―"],["彼","かれ"],["ら"],["は"],["ゲバ"],["の"],["住民","じゅうみん"],["の"],["一族","いちぞく"],["の"],["かしら"],["で"],["、"],["マナハテ"],["に"],["捕らえ","とらえ"],["移された","うつされた"],["者","もの"],["たち"],["で"],["ある"],["。"]]},{"verse":7,"text":"すなわち、この人々を捕らえ移したのはナアマンとアヒヤとゲラである――エフデは、ウザとアヒフデを生んだ。","tok":[["すなわち"],["、"],["この"],["人々","ひとびと"],["を"],["捕らえ","とらえ"],["移した","うつした"],["の"],["は"],["ナアマン"],["と"],["アヒヤ"],["と"],["ゲラ"],["で"],["ある"],["―"],["―"],["エフデ"],["は"],["、"],["ウザ"],["と"],["アヒフデ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":8,"text":"シャハライムは、その妻フシムとバアラを去らせて後、モアブの野で子をもうけた。","tok":[["シャハ"],["ライム"],["は"],["、"],["その"],["妻","つま"],["フシム"],["と"],["バアラ"],["を"],["去らせて","さらせて"],["後","あと"],["、"],["モアブ"],["の"],["野","の"],["で"],["子","こ"],["を"],["もうけた"],["。"]]},{"verse":9,"text":"彼は、その妻ホデシュによって、ヨバブ、ツィブヤ、メシャ、マルカム、","tok":[["彼","かれ"],["は"],["、"],["その"],["妻","つま"],["ホデシュ"],["によって"],["、"],["ヨバブ"],["、"],["ツィブヤ"],["、"],["メシャ"],["、"],["マルカム"],["、"]]},{"verse":10,"text":"エウツ、サケヤ、ミルマを生んだ。これらは彼の子であって、一族のかしらであった。","tok":[["エウツ"],["、"],["サケヤ"],["、"],["ミルマ"],["を"],["生んだ","うんだ"],["。"],["これ"],["ら"],["は"],["彼","かれ"],["の"],["子","こ"],["で"],["あって"],["、"],["一族","いちぞく"],["の"],["かしら"],["で"],["あった"],["。"]]},{"verse":11,"text":"彼はフシムによって、アビトブとエルパアルを生んだ。","tok":[["彼","かれ"],["は"],["フシム"],["によって"],["、"],["アビトブ"],["と"],["エルパアル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":12,"text":"エルパアルの子は、エベル、ミシュアム、シェメデ、――彼はオノとロデおよびそれに属する村落を建てた――","tok":[["エルパアル"],["の"],["子","こ"],["は"],["、"],["エベル"],["、"],["ミシュアム"],["、"],["シェメデ"],["、"],["―"],["―"],["彼","かれ"],["は"],["オノ"],["と"],["ロデ"],["および"],["それ"],["に"],["属する","ぞくする"],["村落","そんらく"],["を"],["建てた","たてた"],["―"],["―"]]},{"verse":13,"text":"ベリア、シェマ、――彼らはアヤロンの住民の一族のかしらで、ガテの住民を追い払った者。","tok":[["ベリア"],["、"],["シェマ"],["、"],["―"],["―"],["彼","かれ"],["ら"],["は"],["アヤロン"],["の"],["住民","じゅうみん"],["の"],["一族","いちぞく"],["の"],["かしら"],["で"],["、"],["ガテ"],["の"],["住民","じゅうみん"],["を"],["追い払った","おいはらった"],["者","もの"],["。"]]},{"verse":14,"text":"アフヨ、シャシャク、エレモテ、","tok":[["アフヨ"],["、"],["シャシャク"],["、"],["エレモテ"],["、"]]},{"verse":15,"text":"ゼバデヤ、アラデ、エデル、","tok":[["ゼバデヤ"],["、"],["アラデ"],["、"],["エデル"],["、"]]},{"verse":16,"text":"ミカエル、イシュパ、ヨハはベリアの子――","tok":[["ミカエル"],["、"],["イシュパ"],["、"],["ヨハ"],["は"],["ベリア"],["の"],["子","こ"],["―"],["―"]]},{"verse":17,"text":"ゼバデヤ、メシュラム、ヒズキ、ヘベル、","tok":[["ゼバデヤ"],["、"],["メシュラム"],["、"],["ヒズキ"],["、"],["ヘベル"],["、"]]},{"verse":18,"text":"イシュメライ、イズリア、ヨバブ。これらはエルパアルの子であった。","tok":[["イシュメライ"],["、"],["イズリア"],["、"],["ヨバブ"],["。"],["これ"],["ら"],["は"],["エルパアル"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":19,"text":"ヤキム、ジクリ、ザブディ、","tok":[["ヤキム"],["、"],["ジクリ"],["、"],["ザブディ"],["、"]]},{"verse":20,"text":"エリエナイ、ツィルタイ、エリエル、","tok":[["エリエナイ"],["、"],["ツィルタイ"],["、"],["エリエル"],["、"]]},{"verse":21,"text":"アダヤ、ベラヤ、シムラテ。これらはシムイの子であった。","tok":[["アダヤ"],["、"],["ベラヤ"],["、"],["シムラテ"],["。"],["これ"],["ら"],["は"],["シムイ"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":22,"text":"イシュパン、エベル、エリエル、","tok":[["イシュパン"],["、"],["エベル"],["、"],["エリエル"],["、"]]},{"verse":23,"text":"アブドン、ジクリ、ハナン、","tok":[["アブドン"],["、"],["ジクリ"],["、"],["ハナン"],["、"]]},{"verse":24,"text":"ハナヌヤ、エラム、アヌトティヤ、","tok":[["ハナヌヤ"],["、"],["エラム"],["、"],["アヌトティヤ"],["、"]]},{"verse":25,"text":"イフデヤ、ペヌエル。これらはシャシャクの子であった。","tok":[["イフデヤ"],["、"],["ペヌエル"],["。"],["これ"],["ら"],["は"],["シャシャク"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":26,"text":"シャムシェライ、シェハルヤ、アタルヤ、","tok":[["シャムシェライ"],["、"],["シェハルヤ"],["、"],["アタルヤ"],["、"]]},{"verse":27,"text":"ヤアレシュヤ、エリヤ、ジクリ。これらはエロハムの子であった。","tok":[["ヤアレシュヤ"],["、"],["エリヤ"],["、"],["ジクリ"],["。"],["これ"],["ら"],["は"],["エロハム"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":28,"text":"これらは、彼らの家系の一族のかしらで、おもだった者たちである。彼らはエルサレムに住んだ。","tok":[["これ"],["ら"],["は"],["、"],["彼","かれ"],["ら"],["の"],["家系","かけい"],["の"],["一族","いちぞく"],["の"],["かしら"],["で"],["、"],["おも"],["だった"],["者","もの"],["たち"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["エルサレム"],["に"],["住んだ","すんだ"],["。"]]},{"verse":29,"text":"ギブオンにはギブオンの父が住んだ。その妻の名はマアカ。","tok":[["ギブオン"],["に"],["は"],["ギブオン"],["の"],["父","ちち"],["が"],["住んだ","すんだ"],["。"],["その"],["妻","つま"],["の"],["名","な"],["は"],["マアカ"],["。"]]},{"verse":30,"text":"その子は、長子がアブドン、それにツル、キシュ、バアル、ナダブ、","tok":[["その"],["子","こ"],["は"],["、"],["長子","ちょうし"],["が"],["アブドン"],["、"],["それ"],["に"],["ツル"],["、"],["キシュ"],["、"],["バアル"],["、"],["ナダブ"],["、"]]},{"verse":31,"text":"ゲドル、アフヨ、ゼケル。","tok":[["ゲドル"],["、"],["アフヨ"],["、"],["ゼケル"],["。"]]},{"verse":32,"text":"ミクロテはシムアを生んだ。彼らも、その兄弟たちとともにエルサレムに住み、その兄弟たちのすぐ前にいた。","tok":[["ミクロテ"],["は"],["シムア"],["を"],["生んだ","うんだ"],["。"],["彼","かれ"],["ら"],["も"],["、"],["その"],["兄弟","きょうだい"],["たち"],["と"],["とも"],["に"],["エルサレム"],["に"],["住み","すみ"],["、"],["その"],["兄弟","きょうだい"],["たち"],["の"],["すぐ"],["前","まえ"],["に"],["いた"],["。"]]},{"verse":33,"text":"ネルはキシュを生み、キシュはサウルを生み、サウルはヨナタン、マルキ・シュア、アビナダブ、エシュバアルを生んだ。","tok":[["ネル"],["は"],["キシュ"],["を"],["生み","うみ"],["、"],["キシュ"],["は"],["サウル"],["を"],["生み","うみ"],["、"],["サウル"],["は"],["ヨナタン"],["、"],["マルキ"],["・"],["シュア"],["、"],["アビナダブ"],["、"],["エシュバアル"],["を"],["生んだ","うんだ"],["。"]]},{"verse":34,"text":"ヨナタンの子はメリブ・バアル。メリブ・バアルはミカを生んだ。","tok":[["ヨナタン"],["の"],["子","こ"],["は"],["メリブ"],["・"],["バアル"],["。"],["メリブ"],["・"],["バアル"],["は"],["ミカ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":35,"text":"ミカの子は、ピトン、メレク、タアレア、アハズ。","tok":[["ミカ"],["の"],["子","こ"],["は"],["、"],["ピトン"],["、"],["メレク"],["、"],["タアレア"],["、"],["アハズ"],["。"]]},{"verse":36,"text":"アハズはエホアダを生み、エホアダは、アレメテ、アズマベテ、ジムリを生み、ジムリはモツァを生んだ。","tok":[["アハズ"],["は"],["エホアダ"],["を"],["生み","うみ"],["、"],["エホアダ"],["は"],["、"],["アレメテ"],["、"],["アズマベテ"],["、"],["ジムリ"],["を"],["生み","うみ"],["、"],["ジムリ"],["は"],["モツァ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":37,"text":"モツァはビヌアを生んだ。その子はラファ、その子はエルアサ、その子はアツェル。","tok":[["モツァ"],["は"],["ビヌア"],["を"],["生んだ","うんだ"],["。"],["その"],["子","こ"],["は"],["ラファ"],["、"],["その"],["子","こ"],["は"],["エルアサ"],["、"],["その"],["子","こ"],["は"],["アツェル"],["。"]]},{"verse":38,"text":"アツェルには六人の子がいた。その名まえは次のとおりである。アズリカム、ボクル、イシュマエル、シェアルヤ、オバデヤ、ハナン。これらはみな、アツェルの子であった。","tok":[["アツェル"],["に"],["は"],["六人","ろくにん"],["の"],["子","こ"],["が"],["いた"],["。"],["その"],["名まえ","なまえ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["アズリカム"],["、"],["ボクル"],["、"],["イシュマエル"],["、"],["シェアルヤ"],["、"],["オバデヤ"],["、"],["ハナン"],["。"],["これ"],["ら"],["は"],["みな"],["、"],["アツェル"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":39,"text":"彼の兄弟エシェクの子は、長子がウラム、次男がエウシュ、三男がエリフェレテ。","tok":[["彼","かれ"],["の"],["兄弟","きょうだい"],["エシェク"],["の"],["子","こ"],["は"],["、"],["長子","ちょうし"],["が"],["ウラム"],["、"],["次男","じなん"],["が"],["エウシュ"],["、"],["三男","さんなん"],["が"],["エリフェレテ"],["。"]]},{"verse":40,"text":"ウラムの子たちは勇士であり、弓を引く人々であった。子や孫が多く、百五十人であった。以上はみな、ベニヤミン族の者であった。","tok":[["ウラム"],["の"],["子","こ"],["たち"],["は"],["勇士","ゆうし"],["で"],["あり"],["、"],["弓","ゆみ"],["を"],["引く","ひく"],["人々","ひとびと"],["で"],["あった"],["。"],["子","こ"],["や"],["孫","まご"],["が"],["多く","おおく"],["、"],["百五","ひゃくご"],["十人","じゅうにん"],["で"],["あった"],["。"],["以上","いじょう"],["は"],["みな"],["、"],["ベニヤミン"],["族","ぞく"],["の"],["者","もの"],["で"],["あった"],["。"]]}]
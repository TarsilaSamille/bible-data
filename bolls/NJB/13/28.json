[{"verse":1,"text":"さて、ダビデはイスラエルのすべてのつかさ、すなわち、各部族のつかさ、王に仕える各組のつかさ、千人隊の長、百人隊の長、王とその子らが所有している財産、家畜全体の係長たち、宦官たち、勇士たち、つまり、すべての勇士をエルサレムに召集した。","tok":[["さて"],["、"],["ダビデ"],["は"],["イスラエル"],["の"],["すべて"],["の"],["つかさ"],["、"],["すなわち"],["、"],["各","かく"],["部族","ぶぞく"],["の"],["つかさ"],["、"],["王","おう"],["に"],["仕える","つかえる"],["各","かく"],["組","くみ"],["の"],["つかさ"],["、"],["千人隊","せんにんたい"],["の"],["長","ちょう"],["、"],["百人隊","ひゃくにんたい"],["の"],["長","ちょう"],["、"],["王","おう"],["と"],["その"],["子","こ"],["ら"],["が"],["所有","しょゆう"],["して"],["いる"],["財産","ざいさん"],["、"],["家畜","かちく"],["全体","ぜんたい"],["の"],["係長","かかりちょう"],["たち"],["、"],["宦官","かんがん"],["たち"],["、"],["勇士","ゆうし"],["たち"],["、"],["つまり"],["、"],["すべて"],["の"],["勇士","ゆうし"],["を"],["エルサレム"],["に"],["召集","しょうしゅう"],["した"],["。"]]},{"verse":2,"text":"ダビデ王は立ち上がって、こう言った。「私の兄弟たち、私の民よ。私の言うことを聞きなさい。私は主の契約の箱のため、私たちの神の足台のために、安息の家を建てる志を持っていた。私は建築の用意をした。","tok":[["ダビデ"],["王","おう"],["は"],["立ち上がって","たちあがって"],["、"],["こう"],["言った","いった"],["。"],["「"],["私","わたくし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["私","わたくし"],["の"],["民","たみ"],["よ"],["。"],["私","わたくし"],["の"],["言う","いう"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["私","わたくし"],["は"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["の"],["ため"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["の"],["足台","あしだい"],["の"],["ため"],["に"],["、"],["安息","あんそく"],["の"],["家","いえ"],["を"],["建てる","たてる"],["志","こころざし"],["を"],["持って","もって"],["いた"],["。"],["私","わたくし"],["は"],["建築","けんちく"],["の"],["用意","ようい"],["を"],["した"],["。"]]},{"verse":3,"text":"しかし、神は私に仰せられた。『あなたはわたしの名のために家を建ててはならない。あなたは戦士であって、血を流してきたからである。』","tok":[["しかし"],["、"],["神","かみ"],["は"],["私","わたくし"],["に"],["仰せられた","おおせられた"],["。"],["『"],["あなた"],["は"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てて","たてて"],["は"],["ならない"],["。"],["あなた"],["は"],["戦士","せんし"],["で"],["あって"],["、"],["血","ち"],["を"],["流して","ながして"],["きた"],["から"],["で"],["ある"],["。"],["』"]]},{"verse":4,"text":"けれども、イスラエルの神、主は、私の父の全家から私を選び、とこしえにイスラエルを治める王としてくださった。ユダの中から君たる者を選ばれたからである。私の父の家はユダの家に属している。主は私の父の子どもたちのうちで、私を愛し、全イスラエルを治める王としてくださった。","tok":[["けれど"],["も"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["私","わたくし"],["の"],["父","ちち"],["の"],["全","ぜん"],["家","いえ"],["から"],["私","わたくし"],["を"],["選び","えらび"],["、"],["とこしえ"],["に"],["イスラエル"],["を"],["治める","おさめる"],["王","おう"],["として"],["くださった"],["。"],["ユダ"],["の"],["中","なか"],["から"],["君","きみ"],["たる"],["者","もの"],["を"],["選ばれた","えらばれた"],["から"],["で"],["ある"],["。"],["私","わたくし"],["の"],["父","ちち"],["の"],["家","いえ"],["は"],["ユダ"],["の"],["家","いえ"],["に"],["属して","ぞくして"],["いる"],["。"],["主","ぬし"],["は"],["私","わたくし"],["の"],["父","ちち"],["の"],["子ども","こども"],["たち"],["の"],["うち"],["で"],["、"],["私","わたくし"],["を"],["愛し","あいし"],["、"],["全","ぜん"],["イスラエル"],["を"],["治める","おさめる"],["王","おう"],["として"],["くださった"],["。"]]},{"verse":5,"text":"主は私に多くの子どもを授けてくださったが、私のすべての子どもの中から、私の子ソロモンを選び、イスラエルを治める主の王座に着けてくださった。","tok":[["主","ぬし"],["は"],["私","わたくし"],["に"],["多く","おおく"],["の"],["子ども","こども"],["を"],["授けて","さずけて"],["くださった"],["が"],["、"],["私","わたくし"],["の"],["すべて"],["の"],["子ども","こども"],["の"],["中","なか"],["から"],["、"],["私","わたくし"],["の"],["子","こ"],["ソロモン"],["を"],["選び","えらび"],["、"],["イスラエル"],["を"],["治める","おさめる"],["主","ぬし"],["の"],["王座","おうざ"],["に"],["着けて","つけて"],["くださった"],["。"]]},{"verse":6,"text":"そして、私にこう仰せられた。『あなたの子ソロモンが、わたしの家とわたしの庭を建てる。わたしが彼をわたしの子として選び、わたしが彼の父となるからだ。","tok":[["そして"],["、"],["私","わたくし"],["に"],["こう"],["仰せられた","おおせられた"],["。"],["『"],["あなた"],["の"],["子","こ"],["ソロモン"],["が"],["、"],["わたし"],["の"],["家","いえ"],["と"],["わたし"],["の"],["庭","にわ"],["を"],["建てる","たてる"],["。"],["わたし"],["が"],["彼","かれ"],["を"],["わたし"],["の"],["子","こ"],["として"],["選び","えらび"],["、"],["わたし"],["が"],["彼","かれ"],["の"],["父","ちち"],["と"],["なる"],["から"],["だ"],["。"]]},{"verse":7,"text":"もし彼が今日のようにわたしの命令と定めを行おうと堅く決心しているなら、わたしは彼の王位をとこしえまでも確立しよう。』","tok":[["もし"],["彼","かれ"],["が"],["今日","きょう"],["の"],["よう"],["に"],["わたし"],["の"],["命令","めいれい"],["と"],["定め","さだめ"],["を"],["行おう","おこなおう"],["と"],["堅く","かたく"],["決心","けっしん"],["して"],["いるなら"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["王位","おうい"],["を"],["とこしえ"],["まで"],["も"],["確立","かくりつ"],["しよう"],["。"],["』"]]},{"verse":8,"text":"今、主の集会、全イスラエルの前で、私たちの神が聞いてくださるこの所で、あなたがたは、あなたがたの神、主の命令をことごとく守り、求めなさい。それは、あなたがたがこの良い地を所有し、あなたがたの後、とこしえまでもあなたがたの子たちにゆずりとして与えるためである。","tok":[["今","いま"],["、"],["主","ぬし"],["の"],["集会","しゅうかい"],["、"],["全","ぜん"],["イスラエル"],["の"],["前","まえ"],["で"],["、"],["私たち","わたしたち"],["の"],["神","かみ"],["が"],["聞いて","きいて"],["くださる"],["この"],["所","ところ"],["で"],["、"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["を"],["ことごとく"],["守り","まもり"],["、"],["求め","もとめ"],["なさい"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["この"],["良い","よい"],["地","ち"],["を"],["所有","しょゆう"],["し"],["、"],["あなた"],["がた"],["の"],["後","あと"],["、"],["とこしえ"],["まで"],["も"],["あなた"],["がた"],["の"],["子","こ"],["たち"],["に"],["ゆずり"],["として"],["与える","あたえる"],["ため"],["で"],["ある"],["。"]]},{"verse":9,"text":"わが子ソロモンよ。今あなたはあなたの父の神を知りなさい。全き心と喜ばしい心持ちをもって神に仕えなさい。主はすべての心を探り、すべての思いの向かうところを読み取られるからである。もし、あなたが神を求めるなら、神はあなたにご自分を現される。もし、あなたが神を離れるなら、神はあなたをとこしえまでも退けられる。","tok":[["わが"],["子","こ"],["ソロモン"],["よ"],["。"],["今","いま"],["あなた"],["は"],["あなた"],["の"],["父","ちち"],["の"],["神","かみ"],["を"],["知り","しり"],["なさい"],["。"],["全","ぜん"],["き"],["心","こころ"],["と"],["喜ばしい","よろこばしい"],["心持ち","こころもち"],["を"],["もって"],["神","かみ"],["に"],["仕え","つかえ"],["なさい"],["。"],["主","ぬし"],["は"],["すべて"],["の"],["心","こころ"],["を"],["探り","さぐり"],["、"],["すべて"],["の"],["思い","おもい"],["の"],["向かう","むかう"],["ところ"],["を"],["読み取られる","よみとられる"],["から"],["で"],["ある"],["。"],["もし"],["、"],["あなた"],["が"],["神","かみ"],["を"],["求めるなら","もとめるなら"],["、"],["神","かみ"],["は"],["あなた"],["に"],["ご自分","ごじぶん"],["を"],["現される","あらわされる"],["。"],["もし"],["、"],["あなた"],["が"],["神","かみ"],["を"],["離れるなら","はなれるなら"],["、"],["神","かみ"],["は"],["あなた"],["を"],["とこしえ"],["まで"],["も"],["退けられる","しりぞけられる"],["。"]]},{"verse":10,"text":"今、心に留めなさい。主は聖所となる宮を建てさせるため、あなたを選ばれた。勇気を出して実行しなさい。」","tok":[["今","いま"],["、"],["心","こころ"],["に"],["留め","とめ"],["なさい"],["。"],["主","ぬし"],["は"],["聖","せい"],["所","しょ"],["と"],["なる"],["宮","みや"],["を"],["建てさせる","たてさせる"],["ため"],["、"],["あなた"],["を"],["選ばれた","えらばれた"],["。"],["勇気","ゆうき"],["を"],["出して","だして"],["実行","じっこう"],["し"],["なさい"],["。"],["」"]]},{"verse":11,"text":"ダビデはその子ソロモンに、玄関広間、その神殿、宝物室、屋上の間、内部屋、贖いの間などの仕様書を授けた。","tok":[["ダビデ"],["は"],["その"],["子","こ"],["ソロモン"],["に"],["、"],["玄関","げんかん"],["広間","ひろま"],["、"],["その"],["神殿","しんでん"],["、"],["宝物室","ほうもつしつ"],["、"],["屋上","おくじょう"],["の"],["間","あいだ"],["、"],["内","うち"],["部屋","へや"],["、"],["贖い","あがない"],["の"],["間","あいだ"],["など"],["の"],["仕様書","しようしょ"],["を"],["授けた","さずけた"],["。"]]},{"verse":12,"text":"御霊により彼が示されていたすべてのものの仕様書であった。すなわち、主の宮の庭のこと、回りにあるすべての脇部屋のこと、神の宮の宝物倉のこと、聖なるささげ物の宝物倉のこと、","tok":[["御霊","ごれい"],["に"],["より"],["彼","かれ"],["が"],["示されて","しめされて"],["いた"],["すべて"],["の"],["もの"],["の"],["仕様書","しようかき"],["で"],["あった"],["。"],["すなわち"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["庭","にわ"],["の"],["こと"],["、"],["回り","まわり"],["に"],["ある"],["すべて"],["の"],["脇部屋","わきべや"],["の"],["こと"],["、"],["神","かみ"],["の"],["宮","みや"],["の"],["宝物倉","ほうもつそう"],["の"],["こと"],["、"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["の"],["宝物倉","ほうもつそう"],["の"],["こと"],["、"]]},{"verse":13,"text":"祭司とレビ人の組分けのこと、主の宮の奉仕のすべての仕事のこと、主の宮の奉仕に用いるすべての器具のことである。","tok":[["祭司","さいし"],["と"],["レビ人","れびにん"],["の"],["組分け","くみわけ"],["の"],["こと"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["奉仕","ほうし"],["の"],["すべて"],["の"],["仕事","しごと"],["の"],["こと"],["、"],["主","ぬし"],["の"],["宮","みや"],["の"],["奉仕","ほうし"],["に"],["用いる","もちいる"],["すべて"],["の"],["器具","きぐ"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":14,"text":"金については、各種の奉仕に用いるすべての器具に使う金の目方が、すべての銀の器具については、各種の奉仕に用いるすべての器具の目方が示され、","tok":[["金","きん"],["について"],["は"],["、"],["各種","かくしゅ"],["の"],["奉仕","ほうし"],["に"],["用いる","もちいる"],["すべて"],["の"],["器具","きぐ"],["に"],["使う","つかう"],["金","かね"],["の"],["目方","めかた"],["が"],["、"],["すべて"],["の"],["銀","ぎん"],["の"],["器具","きぐ"],["について"],["は"],["、"],["各種","かくしゅ"],["の"],["奉仕","ほうし"],["に"],["用いる","もちいる"],["すべて"],["の"],["器具","きぐ"],["の"],["目方","めかた"],["が"],["示され","しめされ"],["、"]]},{"verse":15,"text":"金の燭台とその上にある金のともしび皿の目方は、一つ一つの燭台とその上にあるともしび皿の目方が、銀の燭台については、一つ一つの燭台の用途別に燭台とその上にあるともしび皿の目方が示されていた。","tok":[["金","きん"],["の"],["燭台","しょくだい"],["と"],["その"],["上","うえ"],["に"],["ある"],["金","かね"],["の"],["ともしび"],["
[{"verse":1,"text":"ここに、サタンがイスラエルに逆らって立ち、ダビデを誘い込んで、イスラエルの人口を数えさせた。","tok":[["ここ"],["に"],["、"],["サタン"],["が"],["イスラエル"],["に"],["逆らって","さからって"],["立ち","たち"],["、"],["ダビデ"],["を"],["誘い込んで","さそいこんで"],["、"],["イスラエル"],["の"],["人口","じんこう"],["を"],["数えさせた","かぞえさせた"],["。"]]},{"verse":2,"text":"ダビデはヨアブと民のつかさたちに言った。「さあ、ベエル・シェバからダンに至るまでのイスラエルを数えなさい。そして、その人数を私に報告して、知らせてほしい。」","tok":[["ダビデ"],["は"],["ヨアブ"],["と"],["民","たみ"],["の"],["つかさ"],["たち"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["ベエル"],["・"],["シェバ"],["から"],["ダン"],["に"],["至る","いたる"],["まで"],["の"],["イスラエル"],["を"],["数え","かぞえ"],["なさい"],["。"],["そして"],["、"],["その"],["人数","にんずう"],["を"],["私","わたくし"],["に"],["報告","ほうこく"],["して"],["、"],["知らせて","しらせて"],["ほしい"],["。"],["」"]]},{"verse":3,"text":"すると、ヨアブは言った。「主が、御民を今より百倍も増してくださいますように。王さま。彼らはみな、わが君のもの、そのしもべではないのでしょうか。なぜ、わが君はこんなことを要求なさるのですか。なぜ、イスラエルに対し罪過ある者となられるのですか。」","tok":[["する"],["と"],["、"],["ヨアブ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["、"],["御民","ごみん"],["を"],["今","いま"],["より"],["百","ひゃく"],["倍","ばい"],["も"],["増して","まして"],["くださいます"],["よう"],["に"],["。"],["王","おう"],["さま"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["わが"],["君","きみ"],["の"],["もの"],["、"],["その"],["しもべ"],["で"],["は"],["ない"],["の"],["でしょう"],["か"],["。"],["なぜ"],["、"],["わが"],["君","きみ"],["は"],["こんな"],["こと"],["を"],["要求","ようきゅう"],["なさる"],["の"],["です"],["か"],["。"],["なぜ"],["、"],["イスラエル"],["に"],["対し","たいし"],["罪過","ざいか"],["ある"],["者","もの"],["と"],["なられる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":4,"text":"王はヨアブを説き伏せた。そこでヨアブは出て行って、イスラエルをあまねく行き巡り、エルサレムに帰って来た。","tok":[["王","おう"],["は"],["ヨアブ"],["を"],["説き伏せた","ときふせた"],["。"],["そこ"],["で"],["ヨアブ"],["は"],["出て","でて"],["行って","いって"],["、"],["イスラエル"],["を"],["あまねく"],["行き","いき"],["巡り","めぐり"],["、"],["エルサレム"],["に"],["帰って","かえって"],["来た","きた"],["。"]]},{"verse":5,"text":"そして、ヨアブは民の登録人数をダビデに報告した。全イスラエルには剣を使う者が百十万人、ユダには剣を使う者が四十七万人であった。","tok":[["そして"],["、"],["ヨアブ"],["は"],["民","みん"],["の"],["登録","とうろく"],["人数","にんずう"],["を"],["ダビデ"],["に"],["報告","ほうこく"],["した"],["。"],["全","ぜん"],["イスラエル"],["に"],["は"],["剣","けん"],["を"],["使う","つかう"],["者","もの"],["が"],["百十万人","ひゃくじゅうまんにん"],["、"],["ユダ"],["に"],["は"],["剣","けん"],["を"],["使う","つかう"],["者","もの"],["が"],["四十七万","よんじゅうななまん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":6,"text":"彼はレビとベニヤミンとを、その中に登録しなかった。ヨアブは王の命令を忌みきらったからである。","tok":[["彼","かれ"],["は"],["レビ"],["と"],["ベニヤミン"],["と"],["を"],["、"],["その"],["中","なか"],["に"],["登録","とうろく"],["しなかった"],["。"],["ヨアブ"],["は"],["王","おう"],["の"],["命令","めいれい"],["を"],["忌みきらった","いみきらった"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"この命令で、王は神のみこころをそこなった。神はイスラエルを打たれた。","tok":[["この"],["命令","めいれい"],["で"],["、"],["王","おう"],["は"],["神","かみ"],["のみ"],["こころ"],["を"],["そこなった"],["。"],["神","かみ"],["は"],["イスラエル"],["を"],["打たれた","うたれた"],["。"]]},{"verse":8,"text":"そこで、ダビデは神に言った。「私は、このようなことをして、大きな罪を犯しました。今、あなたのしもべの咎を見のがしてください。私はほんとうに愚かなことをしました。」","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["神","かみ"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["この"],["よう"],["な"],["こと"],["を"],["して"],["、"],["大きな","おおきな"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["今","いま"],["、"],["あなた"],["の"],["しもべ"],["の"],["咎","とが"],["を"],["見のがして","みのがして"],["ください"],["。"],["私","わたくし"],["は"],["ほんとう"],["に"],["愚か","おろか"],["な"],["こと"],["を"],["しました"],["。"],["」"]]},{"verse":9,"text":"そこで、主はダビデの先見者ガドに告げて仰せられた。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["ダビデ"],["の"],["先見者","せんけんしゃ"],["ガド"],["に"],["告げて","つげて"],["仰せられた","おおせられた"],["。"]]},{"verse":10,"text":"「行って、ダビデに告げて言え。『主はこう仰せられる。わたしがあなたに出す三つのことがある。そのうち一つを選べ。わたしはあなたのためにそれをしよう。』」","tok":[["「"],["行って","いって"],["、"],["ダビデ"],["に"],["告げて","つげて"],["言え","いえ"],["。"],["『"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["わたし"],["が"],["あなた"],["に"],["出す","だす"],["三","みっ"],["つ"],["の"],["こと"],["が"],["ある"],["。"],["その"],["うち"],["一","ひと"],["つ"],["を"],["選べ","えらべ"],["。"],["わたし"],["は"],["あなた"],["の"],["ため"],["に"],["それ"],["を"],["しよう"],["。"],["』"],["」"]]},{"verse":11,"text":"ガドはダビデのもとに行き、彼に言った。「主はこう仰せられる。『受け入れよ。","tok":[["ガド"],["は"],["ダビデ"],["の"],["もと"],["に"],["行き","いき"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["仰せられる","おおせられる"],["。"],["『"],["受け入れ","うけいれ"],["よ"],["。"]]},{"verse":12,"text":"三年間のききんか。三か月間、あなたが仇の前で取り去られ、あなたに敵の剣が追い迫ることか。あるいは三日間、主の剣、疫病がこの地に及び、主の使いがイスラエルの国中を荒らすことか。』今、私を遣わされた方に何と答えたらよいかを決めてください。」","tok":[["三","さん"],["年間","ねんかん"],["の"],["ききん"],["か"],["。"],["三","さん"],["か月間","かげつかん"],["、"],["あなた"],["が"],["仇","あだ"],["の"],["前","まえ"],["で"],["取り去られ","とりさられ"],["、"],["あなた"],["に"],["敵","てき"],["の"],["剣","けん"],["が"],["追い迫る","おいせまる"],["こと"],["か"],["。"],["あるいは"],["三","みっ"],["日間","かかん"],["、"],["主","ぬし"],["の"],["剣","けん"],["、"],["疫病","やくびょう"],["が"],["この"],["地","ち"],["に"],["及び","および"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["イスラエル"],["の"],["国中","くにちゅう"],["を"],["荒らす","あらす"],["こと"],["か"],["。"],["』"],["今","いま"],["、"],["私","わたくし"],["を"],["遣わされた","つかわされた"],["方","ほう"],["に"],["何","なん"],["と"],["答えたら","こたえたら"],["よい"],["か"],["を"],["決めて","きめて"],["ください"],["。"],["」"]]},{"verse":13,"text":"ダビデはガドに言った。「それは私には非常につらいことです。私を主の手に陥らせてください。主のあわれみは深いからです。人の手には陥りたくありません。」","tok":[["ダビデ"],["は"],["ガド"],["に"],["言った","いった"],["。"],["「"],["それ"],["は"],["私","わたくし"],["に"],["は"],["非常","ひじょう"],["に"],["つらい"],["こと"],["です"],["。"],["私","わたくし"],["を"],["主","ぬし"],["の"],["手","て"],["に"],["陥らせて","おちいらせて"],["ください"],["。"],["主","ぬし"],["の"],["あわれみ"],["は"],["深い","ぶかい"],["から"],["です"],["。"],["人","ひと"],["の"],["手","て"],["に"],["は"],["陥りたく","おちいりたく"],["ありません"],["。"],["」"]]},{"verse":14,"text":"すると、主はイスラエルに疫病を下されたので、イスラエルのうち七万の人が倒れた。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["イスラエル"],["に"],["疫病","やくびょう"],["を"],["下された","くだされた"],["ので"],["、"],["イスラエル"],["の"],["うち"],["七万","ななまん"],["の"],["人","ひと"],["が"],["倒れた","たおれた"],["。"]]},{"verse":15,"text":"神はエルサレムに御使いを遣わして、これを滅ぼそうとされた。主は御使いが滅ぼしているのをご覧になって、わざわいを下すことを思い直し、滅ぼしている御使いに仰せられた。「もう十分だ。あなたの手を引け。」主の使いは、エブス人オルナンの打ち場のかたわらに立っていた。","tok":[["神","かみ"],["は"],["エルサレム"],["に"],["御使い","おつかい"],["を"],["遣わして","つかわして"],["、"],["これ"],["を"],["滅ぼそう","ほろぼそう"],["と"],["された"],["。"],["主","ぬし"],["は"],["御使い","おつかい"],["が"],["滅ぼして","ほろぼして"],["いる"],["の"],["を"],["ご覧","ごらん"],["に"],["なって"],["、"],["わざわい"],["を"],["下す","くだす"],["こと"],["を"],["思い直し","おもいなおし"],["、"],["滅ぼして","ほろぼして"],["いる"],["御使い","おつかい"],["に"],["仰せられた","おおせられた"],["。"],["「"],["もう"],["十分","じゅうぶん"],["だ"],["。"],["あなた"],["の"],["手","て"],["を"],["引け","ひけ"],["。"],["」"],["主","ぬし"],["の"],["使い","つかい"],["は"],["、"],["エブス人","えぶすにん"],["オルナン"],["の"],["打ち","うち"],["場","ば"],["の"],["かたわら"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":16,"text":"ダビデは、目を上げたとき、主の使いが、抜き身の剣を手に持ち、それをエルサレムの上に差し伸べて、地と天の間に立っているのを見た。ダビデと長老たちは、荒布で身をおおい、ひれ伏した。","tok":[["ダビデ"],["は"],["、"],["目","め"],["を"],["上げた","あげた"],["とき"],["、"],["主","ぬし"],["の"],["使い","つかい"],["が"],["、"],["抜き身","ぬきみ"],["の"],["剣","けん"],["を"],["手","て"],["に"],["持ち","もち"],["、"],["それ"],["を"],["エルサレム"],["の"],["上","うえ"],["に"],["差し伸べて","さしのべて"],["、"],["地","ち"],["と"],["天","てん"],["の"],["間","あいだ"],["に"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["ダビデ"],["と"],["長老","ちょうろう"],["たち"],["は"],["、"],["荒布","あらめ"],["で"],["身","み"],["を"],["おおい"],["、"],["ひれ伏した","ひれふした"],["。"]]},{"verse":17,"text":"ダビデは神に言った。「民を数えよと命じたのは私ではありませんか。罪を犯したのは、はなはだしい悪を行ったのは、この私です。この羊の群れがいったい何をしたというのでしょう。わが神、主よ。どうか、あなたの御手を、私と私の一家に下してください。あなたの民は、疫病に渡さないでください。」","tok":[["ダビデ"],["は"],["神","かみ"],["に"],["言った","いった"],["。"],["「"],["民","みん"],["を"],["数えよ","かぞえよ"],["と"],["命じた","めいじた"],["の"],["は"],["私","わたくし"],["で"],["は"],["ありません"],["か"],["。"],["罪","つみ"],["を"],["犯した","おかした"],["の"],["は"],["、"],["はなはだしい"],["悪","あく"],["を"],["行った","おこなった"],["の"],["は"],["、"],["この"],["私","わたくし"],["です"],["。"],["この"],["羊","ひつじ"],["の"],["群れ","むれ"],["が"],["いったい"],["何","なん"],["を"],["した"],["と"],["いう"],["の"],["でしょう"],["。"],["わが"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["御手","おて"],["を"],["、"],["私","わたくし"],["と"],["私","わたくし"],["の"],["一家","いっか"],["に"],["下して","くだして"],["ください"],["。"],["あなた"],["の"],["民","たみ"],["は"],["、"],["疫病","やくびょう"],["に"],["渡さないで","わたさないで"],["ください"],["。"],["」"]]},{"verse":18,"text":"すると、主の使いはガドに、ダビデに言うようにと言った。「ダビデは上って行って、エブス人オルナンの打ち場に、主のために祭壇を築かなければならない。」","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["使い","つかい"],["は"],["ガド"],["に"],["、"],["ダビデ"],["に"],["言う","いう"],["よう"],["に"],["と"],["言った","いった"],["。"],["「"],["ダビデ"],["は"],["上って","のぼって"],["行って","いって"],["、"],["エブス人","えぶすにん"],["オルナン"],["の"],["打ち","うち"],["場","ば"],["に"],["、"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築かなければ","きずかなければ"],["ならない"],["。"],["」"]]},{"verse":19,"text":"そこでダビデは、ガドが主の御名によって語ったことばに従って上って行った。","tok":[["そこ"],["で"],["ダビデ"],["は"],["、"],["ガド"],["が"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["語った","かたった"],["ことば"],["に"],["従って","したがって"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":20,"text":"オルナンが振り返ると御使いが見えた。彼とともにいた彼の四人の子は身を隠し、オルナンは小麦の打穀をしていた。","tok":[["オルナン"],["が"],["振り返る","ふりかえる"],["と"],["御使い","おつかい"],["が"],["見えた","みえた"],["。"],["彼","かれ"],["と"],["とも"],["に"],["いた"],["彼","かれ"],["の"],["四人","よんにん"],["の"],["子","こ"],["は"],["身","み"],["を"],["隠し","かくし"],["、"],["オルナン"],["は"],["小麦","こむぎ"],["の"],["打","だ"],["穀","こく"],["を"],["して"],["いた"],["。"]]},{"verse":21,"text":"ダビデがオルナンのもとに行くと、オルナンは目を留めてダビデを見、打ち場から出て来て、地にひれ伏して、ダビデに礼をした。","tok":[["ダビデ"],["が"],["オルナン"],["の"],["もと"],["に"],["行く","いく"],["と"],["、"],["オルナン"],["は"],["目","め"],["を"],["留めて","とめて"],["ダビデ"],["を"],["見","み"],["、"],["打ち","うち"],["場","ば"],["から"],["出て","でて"],["来て","きて"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["、"],["ダビデ"],["に"],["礼","れい"],["を"],["した"],["。"]]},{"verse":22,"text":"そこで、ダビデはオルナンに言った。「私に打ち場の地所を下さい。そこに主のために祭壇を建てたいのです。十分な金額で、それを私に下さい。神罰が民に及ばないようになるためです。」","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["オルナン"],["に"],["言った","いった"],["。"],["「"],["私","わたくし"],["に"],["打ち","うち"],["場","ば"],["の"],["地所","じしょ"],["を"],["下さい","ください"],["。"],["そこ"],["に"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["建てたい","たてたい"],["の"],["です"],["。"],["十分","じゅうぶん"],["な"],["金額","きんがく"],["で"],["、"],["それ"],["を"],["私","わたくし"],["に"],["下さい","ください"],["。"],["神罰","しんばつ"],["が"],["民","たみ"],["に"],["及ばない","およばない"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["」"]]},{"verse":23,"text":"オルナンはダビデに言った。「王さま。どうぞ、お取りになってお気に召すようになさってください。ご覧ください。私は、全焼のいけにえのための牛、たきぎにできる打穀機、穀物のささげ物のための小麦を差し上げます。すべてを差し上げます。」","tok":[["オルナン"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["さま"],["。"],["どうぞ"],["、"],["お取り","おとり"],["に"],["なって"],["お気","おき"],["に"],["召す","めす"],["よう"],["に"],["なさって"],["ください"],["。"],["ご覧","ごらん"],["ください"],["。"],["私","わたくし"],["は"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["ため"],["の"],["牛","うし"],["、"],["たきぎ"],["に"],["できる"],["打","だ"],["穀","こく"],["機","き"],["、"],["穀物","こくもつ"],["の"],["ささげ物","ささげもの"],["の"],["ため"],["の"],["小麦","こむぎ"],["を"],["差し上げます","さしあげます"],["。"],["すべて"],["を"],["差し上げます","さしあげます"],["。"],["」"]]},{"verse":24,"text":"しかし、ダビデ王はオルナンに言った。「いいえ、私はどうしても、十分な金額を払って買いたいのです。あなたのものを主にささげるわけにはいきません。費用もかけずに全焼のいけにえをささげたくないのです。」","tok":[["しかし"],["、"],["ダビデ"],["王","おう"],["は"],["オルナン"],["に"],["言った","いった"],["。"],["「"],["いいえ"],["、"],["私","わたくし"],["は"],["どう"],["して"],["も"],["、"],["十分","じゅうぶん"],["な"],["金額","きんがく"],["を"],["払って","はらって"],["買いたい","かいたい"],["の"],["です"],["。"],["あなた"],["の"],["もの"],["を"],["主に","おもに"],["ささげる"],["わけ"],["に"],["は"],["いきません"],["。"],["費用","ひよう"],["も"],["かけず"],["に"],["全焼","ぜんしょう"],["の"],["いけにえ"],["を"],["ささげたく"],["ない"],["の"],["です"],["。"],["」"]]},{"verse":25,"text":"そしてダビデは、その地所代として、金のシェケルで重さ六百シェケルに当たるものを、オルナンに与えた。","tok":[["そして"],["ダビデ"],["は"],["、"],["その"],["地所代","じしょだい"],["として"],["、"],["金","きん"],["の"],["シェケル"],["で"],["重さ","おもさ"],["六百","ろくひゃく"],["シェケル"],["に"],["当たる","あたる"],["もの"],["を"],["、"],["オルナン"],["に"],["与えた","あたえた"],["。"]]},{"verse":26,"text":"こうしてダビデは、そこに主のために祭壇を築き、全焼のいけにえと和解のいけにえとをささげて、主に呼ばわった。すると、主は全焼のいけにえの祭壇の上に天から火を下して、彼に答えられた。","tok":[["こう"],["して"],["ダビデ"],["は"],["、"],["そこ"],["に"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["全焼","ぜんしょう"],["の"],["いけにえ"],["と"],["和解","わかい"],["の"],["いけにえ"],["と"],["を"],["ささげて"],["、"],["主に","おもに"],["呼ばわった","よばわった"],["。"],["する"],["と"],["、"],["主","ぬし"],["は"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["天","てん"],["から"],["火","ひ"],["を"],["下して","くだして"],["、"],["彼","かれ"],["に"],["答えられた","こたえられた"],["。"]]},{"verse":27,"text":"主が御使いに命じられたので、御使いは剣をさやに納めた。","tok":[["主","ぬし"],["が"],["御使い","おつかい"],["に"],["命じられた","めいじられた"],["ので"],["、"],["御使い","おつかい"],["は"],["剣","けん"],["を"],["さや"],["に"],["納めた","おさめた"],["。"]]},{"verse":28,"text":"そのとき、ダビデは主がエブス人オルナンの打ち場で彼に答えられたのを見て、そこでいけにえをささげた。","tok":[["その"],["とき"],["、"],["ダビデ"],["は"],["主","ぬし"],["が"],["エブス人","えぶすにん"],["オルナン"],["の"],["打ち","うち"],["場","ば"],["で"],["彼","かれ"],["に"],["答えられた","こたえられた"],["の"],["を"],["見て","みて"],["、"],["そこ"],["で"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":29,"text":"モーセが荒野で造った主の幕屋と全焼のいけにえの祭壇は、その時、ギブオンの高き所にあった。","tok":[["モーセ"],["が"],["荒野","あらの"],["で"],["造った","つくった"],["主","ぬし"],["の"],["幕屋","まくや"],["と"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["祭壇","さいだん"],["は"],["、"],["その"],["時","とき"],["、"],["ギブオン"],["の"],["高き","たかき"],["所","ところ"],["に"],["あった"],["。"]]},{"verse":30,"text":"ダビデは神を求めて、その前に出て行くことができなかった。主の使いの剣を恐れたからである。","tok":[["ダビデ"],["は"],["神","かみ"],["を"],["求めて","もとめて"],["、"],["その"],["前","まえ"],["に"],["出て","でて"],["行く","いく"],["こと"],["が"],["できなかった"],["。"],["主","ぬし"],["の"],["使い","つかい"],["の"],["剣","けん"],["を"],["恐れた","おそれた"],["から"],["で"],["ある"],["。"]]}]
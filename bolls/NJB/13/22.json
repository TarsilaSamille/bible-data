[{"verse":1,"text":"そこで、ダビデは言った。「これこそ、神である主の宮だ。これこそ、イスラエルの全焼のいけにえの祭壇だ。」","tok":[["そこ"],["で"],["、"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["これ"],["こそ"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["宮","みや"],["だ"],["。"],["これ"],["こそ"],["、"],["イスラエル"],["の"],["全焼","ぜんしょう"],["の"],["いけにえ"],["の"],["祭壇","さいだん"],["だ"],["。"],["」"]]},{"verse":2,"text":"そして、ダビデは命じて、イスラエルの地にいる在留異国人を召集し、神の宮を建てるため石材を切り出す石切り工を任命した。","tok":[["そして"],["、"],["ダビデ"],["は"],["命じて","めいじて"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["いる"],["在留","ざいりゅう"],["異国人","いこくにん"],["を"],["召集","しょうしゅう"],["し"],["、"],["神","かみ"],["の"],["宮","みや"],["を"],["建てる","たてる"],["ため"],["石材","せきざい"],["を"],["切り出す","きりだす"],["石切り","いしきり"],["工","こう"],["を"],["任命","にんめい"],["した"],["。"]]},{"verse":3,"text":"ダビデは、門のとびらの釘および留め金用の鉄をたくさん用意し、青銅も、量りきれないほどおびただしく用意した。","tok":[["ダビデ"],["は"],["、"],["門","もん"],["の"],["とびら"],["の"],["釘","くぎ"],["および"],["留め金用","とめがねよう"],["の"],["鉄","てつ"],["を"],["たくさん"],["用意","ようい"],["し"],["、"],["青銅","せいどう"],["も"],["、"],["量り","はかり"],["きれない"],["ほど"],["おびただしく"],["用意","ようい"],["した"],["。"]]},{"verse":4,"text":"また、杉の木も数えきれないほど用意した。シドン人とツロ人がダビデのもとに杉の木をおびただしく運んで来たからである。","tok":[["また"],["、"],["杉","すぎ"],["の"],["木","き"],["も"],["数え","かぞえ"],["きれない"],["ほど"],["用意","ようい"],["した"],["。"],["シドン人","しどんにん"],["と"],["ツロ人","つろにん"],["が"],["ダビデ"],["の"],["もと"],["に"],["杉","すぎ"],["の"],["木","き"],["を"],["おびただしく"],["運んで","はこんで"],["来た","きた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"ダビデは言った。「わが子ソロモンは、まだ若く力もない。主のために建てる宮は、全地の名となり栄えとなるように大いなるものとしなければならない。それで私は、そのために用意をしておく。」こうして、ダビデは彼が死ぬ前に多くの用意をしておいた。","tok":[["ダビデ"],["は"],["言った","いった"],["。"],["「"],["わが"],["子","こ"],["ソロモン"],["は"],["、"],["まだ"],["若く","わかく"],["力","ちから"],["も"],["ない"],["。"],["主","ぬし"],["の"],["ため"],["に"],["建てる","たてる"],["宮","みや"],["は"],["、"],["全地","ぜんち"],["の"],["名","な"],["と"],["なり"],["栄え","はえ"],["と"],["なる"],["よう"],["に"],["大いなる","おおいなる"],["もの"],["と"],["しなければ"],["ならない"],["。"],["それ"],["で"],["私","わたくし"],["は"],["、"],["その"],["ため"],["に"],["用意","ようい"],["を"],["して"],["おく"],["。"],["」"],["こう"],["して"],["、"],["ダビデ"],["は"],["彼","かれ"],["が"],["死ぬ","しぬ"],["前","まえ"],["に"],["多く","おおく"],["の"],["用意","ようい"],["を"],["して"],["おいた"],["。"]]},{"verse":6,"text":"彼はその子ソロモンを呼び、イスラエルの神、主のために宮を建てるように彼に命じた。","tok":[["彼","かれ"],["は"],["その"],["子","こ"],["ソロモン"],["を"],["呼び","よび"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てる","たてる"],["よう"],["に"],["彼","かれ"],["に"],["命じた","めいじた"],["。"]]},{"verse":7,"text":"ダビデはソロモンに言った。「わが子よ。私は、わが神、主の御名のために宮を建てようとする志を持ち続けてきた。","tok":[["ダビデ"],["は"],["ソロモン"],["に"],["言った","いった"],["。"],["「"],["わが"],["子","こ"],["よ"],["。"],["私","わたくし"],["は"],["、"],["わが"],["神","かみ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["宮","みや"],["を"],["建てよう","たてよう"],["と"],["する"],["志","こころざし"],["を"],["持ち","もち"],["続けて","つづけて"],["きた"],["。"]]},{"verse":8,"text":"ある時、私に次のような主のことばがあった。『あなたは多くの血を流し、大きな戦いをしてきた。あなたはわたしの名のために家を建ててはならない。あなたは、わたしの前に多くの血を地に流してきたからである。","tok":[["ある"],["時","とき"],["、"],["私","わたくし"],["に"],["次","つぎ"],["の"],["よう"],["な"],["主","ぬし"],["の"],["ことば"],["が"],["あった"],["。"],["『"],["あなた"],["は"],["多く","おおく"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["大きな","おおきな"],["戦い","たたかい"],["を"],["して"],["きた"],["。"],["あなた"],["は"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てて","たてて"],["は"],["ならない"],["。"],["あなた"],["は"],["、"],["わたし"],["の"],["前","まえ"],["に"],["多く","おおく"],["の"],["血","ち"],["を"],["地","ち"],["に"],["流して","ながして"],["きた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"見よ。あなたにひとりの子が生まれる。彼は穏やかな人になり、わたしは、彼に安息を与えて、回りのすべての敵に煩わされないようにする。彼の名がソロモンと呼ばれるのはそのためである。彼の世に、わたしはイスラエルに平和と平穏を与えよう。","tok":[["見","み"],["よ"],["。"],["あなた"],["に"],["ひとり"],["の"],["子","こ"],["が"],["生まれる","うまれる"],["。"],["彼","かれ"],["は"],["穏やか","おだやか"],["な"],["人","ひと"],["に"],["なり"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["に"],["安息","あんそく"],["を"],["与えて","あたえて"],["、"],["回り","まわり"],["の"],["すべて"],["の"],["敵","てき"],["に"],["煩わされない","わずらわされない"],["よう"],["に"],["する"],["。"],["彼","かれ"],["の"],["名","な"],["が"],["ソロモン"],["と"],["呼ばれる","よばれる"],["の"],["は"],["その"],["ため"],["で"],["ある"],["。"],["彼の世","あのよ"],["に"],["、"],["わたし"],["は"],["イスラエル"],["に"],["平和","へいわ"],["と"],["平穏","へいおん"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":10,"text":"彼がわたしの名のために家を建てる。彼はわたしにとって子となり、わたしは彼にとって父となる。わたしはイスラエルの上に彼の王座をとこしえまでも堅く立てる。』","tok":[["彼","かれ"],["が"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["家","いえ"],["を"],["建てる","たてる"],["。"],["彼","かれ"],["は"],["わたし"],["にとって"],["子","こ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["にとって"],["父","ちち"],["と"],["なる"],["。"],["わたし"],["は"],["イスラエル"],["の"],["上","うえ"],["に"],["彼","かれ"],["の"],["王座","おうざ"],["を"],["とこしえ"],["まで"],["も"],["堅く","かたく"],["立てる","たてる"],["。"],["』"]]},{"verse":11,"text":"そこで今、わが子よ、主があなたとともにおられ、主があなたについて語られたとおり、あなたが、あなたの神、主の宮をりっぱに建て上げることができるように。","tok":[["そこ"],["で"],["今","いま"],["、"],["わが"],["子","こ"],["よ"],["、"],["主","ぬし"],["が"],["あなた"],["と"],["とも"],["に"],["おられ"],["、"],["主","ぬし"],["が"],["あなた"],["について"],["語られた","かたられた"],["とおり"],["、"],["あなた"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["宮","みや"],["を"],["りっぱ"],["に"],["建て","たて"],["上げる","あげる"],["こと"],["が"],["できる"],["よう"],["に"],["。"]]},{"verse":12,"text":"ただ、主があなたに思慮と分別を与えて、あなたをイスラエルの上に任命し、あなたの神、主の律法を守らせてくださるように。","tok":[["ただ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["思慮","しりょ"],["と"],["分別","ぶんべつ"],["を"],["与えて","あたえて"],["、"],["あなた"],["を"],["イスラエル"],["の"],["上","うえ"],["に"],["任命","にんめい"],["し"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["律法","りっぽう"],["を"],["守らせて","まもらせて"],["くださる"],["よう"],["に"],["。"]]},{"verse":13,"text":"主がイスラエルについてモーセに命じられたおきてと定めをあなたが守り行うなら、あなたは栄える。強くあれ。雄々しくあれ。恐れてはならない。おののいてはならない。","tok":[["主","ぬし"],["が"],["イスラエル"],["について"],["モーセ"],["に"],["命じられた","めいじられた"],["おきて"],["と"],["定め","さだめ"],["を"],["あなた"],["が"],["守り","まもり"],["行うなら","おこなうなら"],["、"],["あなた"],["は"],["栄える","さかえる"],["。"],["強く","つよく"],["あれ"],["。"],["雄々しく","おおしく"],["あれ"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おののいて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"見なさい。私は困難な中にも主の家のために、金十万タラント、銀百万タラントを用意した。また、青銅と鉄はあまりに多くて量りきれない。それに、木材と石材も用意した。あなたが、これらにもっと加えてほしい。","tok":[["見","み"],["なさい"],["。"],["私","わたくし"],["は"],["困難","こんなん"],["な"],["中","なか"],["に"],["も"],["主","ぬし"],["の"],["家","いえ"],["の"],["ため"],["に"],["、"],["金","きん"],["十万","じゅうまん"],["タラント"],["、"],["銀","ぎん"],["百万","ひゃくまん"],["タラント"],["を"],["用意","ようい"],["した"],["。"],["また"],["、"],["青銅","せいどう"],["と"],["鉄","てつ"],["は"],["あまり"],["に"],["多くて","おおくて"],["量り","はかり"],["きれない"],["。"],["それ"],["に"],["、"],["木材","もくざい"],["と"],["石材","せきざい"],["も"],["用意","ようい"],["した"],["。"],["あなた"],["が"],["、"],["これ"],["ら"],["に"],["もっと"],["加えて","くわえて"],["ほしい"],["。"]]},{"verse":15,"text":"あなたのもとには、石を切り出す者、石や木に細工する者、各種の仕事に熟練した者など、多くの仕事をする者がいて、","tok":[["あなた"],["の"],["もと"],["に"],["は"],["、"],["石","いし"],["を"],["切り出す","きりだす"],["者","もの"],["、"],["石","いし"],["や"],["木","き"],["に"],["細工","さいく"],["する"],["者","もの"],["、"],["各種","かくしゅ"],["の"],["仕事","しごと"],["に"],["熟練","じゅくれん"],["した"],["者","もの"],["など"],["、"],["多く","おおく"],["の"],["仕事","しごと"],["を"],["する"],["者","もの"],["が"],["いて"],["、"]]},{"verse":16,"text":"金、銀、青銅、鉄を扱うが、その人数は数えきれない。立ち上がって、行いなさい。主があなたとともにおられるように。」","tok":[["金","きん"],["、"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"],["鉄","てつ"],["を"],["扱う","あつかう"],["が"],["、"],["その"],["人数","にんずう"],["は"],["数え","かぞえ"],["きれない"],["。"],["立ち上がって","たちあがって"],["、"],["行い","おこない"],["なさい"],["。"],["主","ぬし"],["が"],["あなた"],["と"],["とも"],["に"],["おられる"],["よう"],["に"],["。"],["」"]]},{"verse":17,"text":"そして、ダビデはイスラエルのすべてのつかさたちに、その子ソロモンを助けるよう命じた。","tok":[["そして"],["、"],["ダビデ"],["は"],["イスラエル"],["の"],["すべて"],["の"],["つかさ"],["たち"],["に"],["、"],["その"],["子","こ"],["ソロモン"],["を"],["助ける","たすける"],["よう"],["命じた","めいじた"],["。"]]},{"verse":18,"text":"「あなたがたの神、主は、あなたがたとともにおられ、周囲の者から守ってあなたがたに安息を与えられたではありませんか。主はこの地の住民を私の手に渡され、この地は主の前とその民の前に服したからです。","tok":[["「"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["と"],["とも"],["に"],["おられ"],["、"],["周囲","しゅうい"],["の"],["者","もの"],["から"],["守って","まもって"],["あなた"],["がた"],["に"],["安息","あんそく"],["を"],["与えられたで","あたえられたで"],["は"],["ありません"],["か"],["。"],["主","ぬし"],["は"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["を"],["私","わたくし"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["この"],["地","ち"],["は"],["主","ぬし"],["の"],["前","まえ"],["と"],["その"],["民","たみ"],["の"],["前","まえ"],["に"],["服した","ふくした"],["から"],["です"],["。"]]},{"verse":19,"text":"そこで今、あなたがたは心を尽くし、精神を尽くして、あなたがたの神、主に求めなさい。立ち上がって、神である主の聖所を建て上げ、主の御名のために建てられた宮に、主の契約の箱と神の聖なる器具を運び入れなさい。」","tok":[["そこ"],["で"],["今","いま"],["、"],["あなた"],["がた"],["は"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["精神","せいしん"],["を"],["尽くして","つくして"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","おもに"],["求め","もとめ"],["なさい"],["。"],["立ち上がって","たちあがって"],["、"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["を"],["建て","たて"],["上げ","あげ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["建てられた","たてられた"],["宮","みや"],["に"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["と"],["神","かみ"],["の"],["聖","せい"],["なる"],["器具","きぐ"],["を"],["運び入れ","はこびいれ"],["なさい"],["。"],["」"]]}]
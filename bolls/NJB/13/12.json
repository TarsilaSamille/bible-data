[{"verse":1,"text":"ダビデがキシュの子サウルのゆえに、まだツィケラグに引きこもっていたとき、ツィケラグの彼のもとに来た人々は次のとおりである。彼らは勇士たちの中で、戦いの加勢をした人々であり、","tok":[["ダビデ"],["が"],["キシュ"],["の"],["子","こ"],["サウル"],["の"],["ゆえ"],["に"],["、"],["まだ"],["ツィケラグ"],["に"],["引きこもって","ひきこもって"],["いた"],["とき"],["、"],["ツィケラグ"],["の"],["彼","かれ"],["の"],["もと"],["に"],["来た","きた"],["人々","ひとびと"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["勇士","ゆうし"],["たち"],["の"],["中","なか"],["で"],["、"],["戦い","たたかい"],["の"],["加勢","かせい"],["を"],["した"],["人々","ひとびと"],["で"],["あり"],["、"]]},{"verse":2,"text":"弓を持った者、石投げ、弓矢に、右手も左手も使う者で、サウルの同族、ベニヤミンの出であった。","tok":[["弓","ゆみ"],["を"],["持った","もった"],["者","もの"],["、"],["石投げ","いしなげ"],["、"],["弓矢","ゆみや"],["に"],["、"],["右手","みぎて"],["も"],["左手","ひだりて"],["も"],["使う","つかう"],["者","もの"],["で"],["、"],["サウル"],["の"],["同族","どうぞく"],["、"],["ベニヤミン"],["の"],["出","で"],["で"],["あった"],["。"]]},{"verse":3,"text":"かしらはアヒエゼル、次はヨアシュ。彼らはギブア人シェマアの子。エジエル、ペレテ。彼らはアズマベテの子。次にベラカとアナトテ人エフー。","tok":[["かしら"],["は"],["アヒエゼル"],["、"],["次","つぎ"],["は"],["ヨアシュ"],["。"],["彼","かれ"],["ら"],["は"],["ギブア人","ぎぶあにん"],["シェマア"],["の"],["子","こ"],["。"],["エジエル"],["、"],["ペレテ"],["。"],["彼","かれ"],["ら"],["は"],["アズマベテ"],["の"],["子","こ"],["。"],["次","つぎ"],["に"],["ベラカ"],["と"],["アナトテ"],["人","にん"],["エフー"],["。"]]},{"verse":4,"text":"ギブオン人イシュマヤ、彼は三十人の中の勇士で、三十人の長であった。／次に、エレミヤ、ヤハジエル、ヨハナン、ゲデラ人エホザバデ、","tok":[["ギブオン"],["人","にん"],["イシュマヤ"],["、"],["彼","かれ"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["中","なか"],["の"],["勇士","ゆうし"],["で"],["、"],["三","さん"],["十人","じゅうにん"],["の"],["長","ちょう"],["で"],["あった"],["。"],["／"],["次","つぎ"],["に"],["、"],["エレミヤ"],["、"],["ヤハジエル"],["、"],["ヨハナン"],["、"],["ゲデラ人","げでらにん"],["エホザバデ"],["、"]]},{"verse":5,"text":"エルウザイ、エリモテ、ベアルヤ、シェマルヤ、ハリフ人シェファテヤ、","tok":[["エルウザイ"],["、"],["エリモテ"],["、"],["ベアルヤ"],["、"],["シェマルヤ"],["、"],["ハリフ人","はりふにん"],["シェファテヤ"],["、"]]},{"verse":6,"text":"エルカナ、イシヤ、アザルエル、ヨエゼル、ヤショブアム。これらはコラ人である。","tok":[["エルカナ"],["、"],["イシヤ"],["、"],["アザルエル"],["、"],["ヨエゼル"],["、"],["ヤショブアム"],["。"],["これ"],["ら"],["は"],["コラ人","こらにん"],["で"],["ある"],["。"]]},{"verse":7,"text":"ヨエラ、ゼバ
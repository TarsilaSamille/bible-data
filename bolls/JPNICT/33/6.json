[{"verse":1,"text":"聞け、主の言われることを。立って、告発せよ、山々の前で。峰々にお前の声を聞かせよ。","tok":[["聞け","きけ"],["、"],["主","ぬし"],["の"],["言われる","いわれる"],["こと"],["を"],["。"],["立って","たって"],["、"],["告発","こくはつ"],["せよ"],["、"],["山々","やまやま"],["の"],["前","まえ"],["で"],["。"],["峰々","みねみね"],["に"],["お前","おまえ"],["の"],["声","こえ"],["を"],["聞かせ","きかせ"],["よ"],["。"]]},{"verse":2,"text":"聞け、山々よ、主の告発を。とこしえの地の基よ。主は御自分の民を告発しイスラエルと争われる。","tok":[["聞け","きけ"],["、"],["山々","やまやま"],["よ"],["、"],["主","ぬし"],["の"],["告発","こくはつ"],["を"],["。"],["とこしえ"],["の"],["地","ち"],["の"],["基","もと"],["よ"],["。"],["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["を"],["告発","こくはつ"],["し"],["イスラエル"],["と"],["争われる","あらそわれる"],["。"]]},{"verse":3,"text":"「わが民よ。わたしはお前に何をしたというのか。何をもってお前を疲れさせたのか。わたしに答えよ。","tok":[["「"],["わが"],["民","たみ"],["よ"],["。"],["わたし"],["は"],["お前","おまえ"],["に"],["何","なん"],["を"],["した"],["と"],["いう"],["の"],["か"],["。"],["何","なん"],["を"],["もって"],["お前","おまえ"],["を"],["疲れさせた","つかれさせた"],["の"],["か"],["。"],["わたし"],["に"],["答え","こたえ"],["よ"],["。"]]},{"verse":4,"text":"わたしはお前をエジプトの国から導き上り奴隷の家から贖った。また、モーセとアロンとミリアムをお前の前に遣わした。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上り","のぼり"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["贖った","あがなった"],["。"],["また"],["、"],["モーセ"],["と"],["アロン"],["と"],["ミリアム"],["を"],["お前","おまえ"],["の"],["前","まえ"],["に"],["遣わした","つかわした"],["。"]]},{"verse":5,"text":"わが民よ、思い起こすがよい。モアブの王バラクが何をたくらみベオルの子バラムがそれに何と答えたかを。シティムからギルガルまでのことを思い起こし主の恵みの御業をわきまえるがよい。」","tok":[["わが"],["民","たみ"],["よ"],["、"],["思い起こす","おもいおこす"],["が"],["よい"],["。"],["モアブ"],["の"],["王","おう"],["バラク"],["が"],["何","なん"],["を"],["たくらみ"],["ベオル"],["の"],["子","こ"],["バラム"],["が"],["それ"],["に"],["何","なん"],["と"],["答えた","こたえた"],["か"],["を"],["。"],["シティム"],["から"],["ギルガル"],["まで"],["の"],["こと"],["を"],["思い起こし","おもいおこし"],["主","ぬし"],["の"],["恵み","めぐみ"],["の"],["御業","ごごう"],["を"],["わきまえる"],["が"],["よい"],["。"],["」"]]},{"verse":6,"text":"何をもって、わたしは主の御前に出でいと高き神にぬかずくべきか。焼き尽くす献げ物として当歳の子牛をもって御前に出るべきか。","tok":[["何","なん"],["を"],["もって"],["、"],["わたし"],["は"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["出","で"],["で"],["い"],["と"],["高き","たかき"],["神","かみ"],["に"],["ぬかずくべき"],["か"],["。"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["として"],["当歳","とうさい"],["の"],["子牛","こうし"],["を"],["もって"],["御前","ごぜん"],["に"],["出るべき","でるべき"],["か"],["。"]]},{"verse":7,"text":"主は喜ばれるだろうか幾千の雄羊、幾万の油の流れを。わが咎を償うために長子を自分の罪のために胎の実をささげるべきか。","tok":[["主","ぬし"],["は"],["喜ばれるだろう","よろこばれるだろう"],["か"],["幾","いく"],["千","せん"],["の"],["雄羊","おひつじ"],["、"],["幾万","いくま"],["の"],["油","あぶら"],["の"],["流れ","ながれ"],["を"],["。"],["わが"],["咎","とが"],["を"],["償う","つぐなう"],["ため"],["に"],["長子","ちょうし"],["を"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ため"],["に"],["胎","はら"],["の"],["実","じつ"],["を"],["ささげるべき"],["か"],["。"]]},{"verse":8,"text":"人よ、何が善であり主が何をお前に求めておられるかはお前に告げられている。正義を行い、慈しみを愛しへりくだって神と共に歩むこと、これである。","tok":[["人","ひと"],["よ"],["、"],["何","なん"],["が"],["善","ぜん"],["で"],["あり"],["主","ぬし"],["が"],["何","なん"],["を"],["お前","おまえ"],["に"],["求めて","もとめて"],["おられる"],["か"],["は"],["お前","おまえ"],["に"],["告げられて","つげられて"],["いる"],["。"],["正義","せいぎ"],["を"],["行い","おこない"],["、"],["慈しみ","いつくしみ"],["を"],["愛し","あいし"],["へりくだって"],["神","かみ"],["と"],["共","とも"],["に"],["歩む","あゆむ"],["こと"],["、"],["これ"],["で"],["ある"],["。"]]},{"verse":9,"text":"主の御声は都に向かって呼ばわる。御名を畏れ敬うことこそ賢明である。聞け、ユダの部族とその集会よ。","tok":[["主","ぬし"],["の"],["御声","おこえ"],["は"],["都","と"],["に"],["向かって","むかって"],["呼ばわる","よばわる"],["。"],["御名","ぎょめい"],["を"],["畏れ","おそれ"],["敬う","うやまう"],["こと"],["こそ"],["賢明","けんめい"],["で"],["ある"],["。"],["聞け","きけ"],["、"],["ユダ"],["の"],["部族","ぶぞく"],["と"],["その"],["集会","しゅうかい"],["よ"],["。"]]},{"verse":10,"text":"まだ、わたしは忍ばねばならないのか神に逆らう者の家、不正に蓄えた富呪われた、容量の足りない升を。","tok":[["まだ"],["、"],["わたし"],["は"],["忍ばねば","しのばねば"],["ならない"],["の"],["か"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["の"],["家","いえ"],["、"],["不正","ふせい"],["に"],["蓄えた","たくわえた"],["富","とみ"],["呪われた","のろわれた"],["、"],["容量","ようりょう"],["の"],["足りない","たりない"],["升","ます"],["を"],["。"]]},{"verse":11,"text":"わたしは認めえようか不正な天秤、偽りの重り石の袋を。","tok":[["わたし"],["は"],["認め","みとめ"],["えよう"],["か"],["不正","ふせい"],["な"],["天秤","てんびん"],["、"],["偽り","いつわり"],["の"],["重り","おもり"],["石","いし"],["の"],["袋","ふくろ"],["を"],["。"]]},{"verse":12,"text":"都の金持ちは不法で満ち、住民は偽りを語る。彼らの口には欺く舌がある。","tok":[["都","と"],["の"],["金持ち","かねもち"],["は"],["不法","ふほう"],["で"],["満ち","みち"],["、"],["住民","じゅうみん"],["は"],["偽り","いつわり"],["を"],["語る","かたる"],["。"],["彼","かれ"],["ら"],["の"],["口","くち"],["に"],["は"],["欺く","あざむく"],["舌","した"],["が"],["ある"],["。"]]},{"verse":13,"text":"わたしも、お前を撃って病気にかからせ罪のゆえに滅ぼす。","tok":[["わたし"],["も"],["、"],["お前","おまえ"],["を"],["撃って","うって"],["病気","びょうき"],["に"],["かからせ"],["罪","つみ"],["の"],["ゆえ"],["に"],["滅ぼす","ほろぼす"],["。"]]},{"verse":14,"text":"お前は食べても飽くことなく、空腹が取りつく。持ち物を運び出しても、それを救いえず救い出しても、わたしはそれを剣に渡す。","tok":[["お前","おまえ"],["は"],["食べて","たべて"],["も"],["飽く","あく"],["こと"],["なく"],["、"],["空腹","くうふく"],["が"],["取りつく","とりつく"],["。"],["持ち物","もちもの"],["を"],["運び出して","はこびだして"],["も"],["、"],["それ"],["を"],["救い","すくい"],["えず"],["救い出して","すくいだして"],["も"],["、"],["わたし"],["は"],["それ"],["を"],["剣","けん"],["に"],["渡す","わたす"],["。"]]},{"verse":15,"text":"お前は種を蒔いても、刈り入れることなくオリーブの実を踏んでもその油を身に塗ることはない。新しいぶどうを搾ってもその酒を飲むことはない。","tok":[["お前","おまえ"],["は"],["種","しゅ"],["を"],["蒔いて","まいて"],["も"],["、"],["刈り入れる","かりいれる"],["こと"],["なく"],["オリーブ"],["の"],["実","じつ"],["を"],["踏んで","ふんで"],["も"],["その"],["油","あぶら"],["を"],["身","み"],["に"],["塗る","ぬる"],["こと"],["は"],["ない"],["。"],["新しい","あたらしい"],["ぶどう"],["を"],["搾って","しぼって"],["も"],["その"],["酒","さけ"],["を"],["飲む","のむ"],["こと"],["は"],["ない"],["。"]]},{"verse":16,"text":"お前はオムリの定めたことアハブの家のすべてのならわしを保ちそのたくらみに従って歩んだ。そのため、わたしはお前を荒れるにまかせ都の住民を嘲りの的とした。お前たちはわが民の恥を負わねばならぬ。","tok":[["お前","おまえ"],["は"],["オムリ"],["の"],["定めた","さだめた"],["こと"],["アハブ"],["の"],["家","いえ"],["の"],["すべて"],["の"],["ならわし"],["を"],["保ち","たもち"],["その"],["たくらみ"],["に"],["従って","したがって"],["歩んだ","あゆんだ"],["。"],["その"],["ため"],["、"],["わたし"],["は"],["お前","おまえ"],["を"],["荒れる","あれる"],["に"],["まかせ"],["都","と"],["の"],["住民","じゅうみん"],["を"],["嘲り","あざけり"],["の"],["的","まと"],["と"],["した"],["。"],["お前","おまえ"],["たち"],["は"],["わが"],["民","たみ"],["の"],["恥","はじ"],["を"],["負わねば","おわねば"],["ならぬ"],["。"]]}]
[{"verse":1,"text":"わたしは言った。聞け、ヤコブの頭たちイスラエルの家の指導者たちよ。正義を知ることが、お前たちの務めではないのか。","tok":[["わたし"],["は"],["言った","いった"],["。"],["聞け","きけ"],["、"],["ヤコブ"],["の"],["頭","あたま"],["たち"],["イスラエル"],["の"],["家","いえ"],["の"],["指導者","しどうしゃ"],["たち"],["よ"],["。"],["正義","せいぎ"],["を"],["知る","しる"],["こと"],["が"],["、"],["お前","おまえ"],["たち"],["の"],["務め","つとめ"],["で"],["は"],["ない"],["の"],["か"],["。"]]},{"verse":2,"text":"善を憎み、悪を愛する者人々の皮をはぎ、骨から肉をそぎ取る者らよ。","tok":[["善","ぜん"],["を"],["憎み","にくみ"],["、"],["悪","あく"],["を"],["愛する","あいする"],["者","もの"],["人々","ひとびと"],["の"],["皮","かわ"],["を"],["はぎ"],["、"],["骨","ほね"],["から"],["肉","にく"],["を"],["そぎ取る","そぎとる"],["者","もの"],["ら"],["よ"],["。"]]},{"verse":3,"text":"彼らはわが民の肉を食らい皮をはぎ取り、骨を解体して鍋の中身のように、釜の中の肉のように砕く。","tok":[["彼","かれ"],["ら"],["は"],["わが"],["民","たみ"],["の"],["肉","にく"],["を"],["食らい","くらい"],["皮","かわ"],["を"],["はぎ取り","はぎとり"],["、"],["骨","ほね"],["を"],["解体","かいたい"],["して"],["鍋","なべ"],["の"],["中身","なかみ"],["の"],["よう"],["に"],["、"],["釜","かま"],["の"],["中","なか"],["の"],["肉","にく"],["の"],["よう"],["に"],["砕く","くだく"],["。"]]},{"verse":4,"text":"今や、彼らが主に助けを叫び求めても主は答えられない。そのとき、主は御顔を隠される彼らの行いが悪いからである。","tok":[["今","いま"],["や"],["、"],["彼","かれ"],["ら"],["が"],["主に","おもに"],["助け","たすけ"],["を"],["叫び","さけび"],["求めて","もとめて"],["も"],["主","ぬし"],["は"],["答えられない","こたえられない"],["。"],["その"],["とき"],["、"],["主","ぬし"],["は"],["御顔","おかお"],["を"],["隠される","かくされる"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["が"],["悪い","わるい"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"わが民を迷わす預言者たちに対して主はこう言われる。彼らは歯で何かをかんでいる間は平和を告げるがその口に何も与えない人には戦争を宣言する。","tok":[["わが"],["民","たみ"],["を"],["迷わす","まよわす"],["預言者","よげんしゃ"],["たち"],["に対して","にたいして"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["彼","かれ"],["ら"],["は"],["歯","は"],["で"],["何","なん"],["か"],["を"],["かんで"],["いる"],["間","あいだ"],["は"],["平和","へいわ"],["を"],["告げる","つげる"],["が"],["その"],["口","くち"],["に"],["何","なん"],["も"],["与えない","あたえない"],["人","ひと"],["に"],["は"],["戦争","せんそう"],["を"],["宣言","せんげん"],["する"],["。"]]},{"verse":6,"text":"それゆえ、お前たちには夜が臨んでも幻はなく暗闇が臨んでも、託宣は与えられない。預言者たちには、太陽が沈んで昼も暗くなる。","tok":[["それ"],["ゆえ"],["、"],["お前","おまえ"],["たち"],["に"],["は"],["夜","よる"],["が"],["臨んで","のぞんで"],["も"],["幻","まぼろし"],["は"],["なく"],["暗闇","くらやみ"],["が"],["臨んで","のぞんで"],["も"],["、"],["託宣","たくせん"],["は"],["与えられない","あたえられない"],["。"],["預言者","よげんしゃ"],["たち"],["に"],["は"],["、"],["太陽","たいよう"],["が"],["沈んで","しずんで"],["昼","ひる"],["も"],["暗く","くらく"],["なる"],["。"]]},{"verse":7,"text":"先見者はうろたえ託宣を告げる者は恥をかき皆、口ひげを覆う。神が答えられないからだ。","tok":[["先見者","せんけんしゃ"],["は"],["うろたえ"],["託宣","たくせん"],["を"],["告げる","つげる"],["者","もの"],["は"],["恥","はじ"],["を"],["かき"],["皆","みな"],["、"],["口ひげ","くちひげ"],["を"],["覆う","おおう"],["。"],["神","かみ"],["が"],["答えられない","こたえられない"],["から"],["だ"],["。"]]},{"verse":8,"text":"しかし、わたしは力と主の霊正義と勇気に満ちヤコブに咎をイスラエルに罪を告げる。","tok":[["しかし"],["、"],["わたし"],["は"],["力","ちから"],["と"],["主","ぬし"],["の"],["霊正","れいしょう"],["義","よし"],["と"],["勇気","ゆうき"],["に"],["満ち","みち"],["ヤコブ"],["に"],["咎","とが"],["を"],["イスラエル"],["に"],["罪","つみ"],["を"],["告げる","つげる"],["。"]]},{"verse":9,"text":"聞け、このことを。ヤコブの家の頭たちイスラエルの家の指導者たちよ。正義を忌み嫌い、まっすぐなものを曲げ","tok":[["聞け","きけ"],["、"],["この"],["こと"],["を"],["。"],["ヤコブ"],["の"],["家","いえ"],["の"],["頭","あたま"],["たち"],["イスラエル"],["の"],["家","いえ"],["の"],["指導者","しどうしゃ"],["たち"],["よ"],["。"],["正義","せいぎ"],["を"],["忌み嫌い","いみきらい"],["、"],["まっすぐ"],["な"],["もの"],["を"],["曲げ","まげ"]]},{"verse":10,"text":"流血をもってシオンを不正をもってエルサレムを建てる者たちよ。","tok":[["流血","りゅうけつ"],["を"],["もって"],["シオン"],["を"],["不正","ふせい"],["を"],["もって"],["エルサレム"],["を"],["建てる","たてる"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":11,"text":"頭たちは賄賂を取って裁判をし祭司たちは代価を取って教え預言者たちは金を取って託宣を告げる。しかも主を頼りにして言う。「主が我らの中におられるではないか災いが我々に及ぶことはない」と。","tok":[["頭","あたま"],["たち"],["は"],["賄賂","わいろ"],["を"],["取って","とって"],["裁判","さいばん"],["を"],["し"],["祭司","さいし"],["たち"],["は"],["代価","だいか"],["を"],["取って","とって"],["教え","おしえ"],["預言者","よげんしゃ"],["たち"],["は"],["金","きん"],["を"],["取って","とって"],["託宣","たくせん"],["を"],["告げる","つげる"],["。"],["しかも"],["主","ぬし"],["を"],["頼り","たより"],["に"],["して"],["言う","ゆう"],["。"],["「"],["主","ぬし"],["が"],["我","われ"],["ら"],["の"],["中","なか"],["に"],["おられるで"],["は"],["ない"],["か"],["災い","わざわい"],["が"],["我々","われわれ"],["に"],["及ぶ","およぶ"],["こと"],["は"],["ない"],["」"],["と"],["。"]]},{"verse":12,"text":"それゆえ、お前たちのゆえにシオンは耕されて畑となりエルサレムは石塚に変わり神殿の山は木の生い茂る聖なる高台となる。","tok":[["それ"],["ゆえ"],["、"],["お前","おまえ"],["たち"],["の"],["ゆえ"],["に"],["シオン"],["は"],["耕されて","たがやされて"],["畑","はたけ"],["と"],["なり"],["エルサレム"],["は"],["石塚","いしづか"],["に"],["変わり","かわり"],["神殿","しんでん"],["の"],["山","やま"],["は"],["木","き"],["の"],["生い茂る","おいしげる"],["聖","せい"],["なる"],["高台","たかだい"],["と"],["なる"],["。"]]}]
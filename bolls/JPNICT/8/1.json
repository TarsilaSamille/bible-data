[{"verse":1,"text":"士師が世を治めていたころ、飢饉が国を襲ったので、ある人が妻と二人の息子を連れて、ユダのベツレヘムからモアブの野に移り住んだ。","tok":[["士師","しし"],["が"],["世","よ"],["を"],["治めて","おさめて"],["いた"],["ころ"],["、"],["飢饉","ききん"],["が"],["国","くに"],["を"],["襲った","おそった"],["ので"],["、"],["ある"],["人","ひと"],["が"],["妻","つま"],["と"],["二人","ふたり"],["の"],["息子","むすこ"],["を"],["連れて","つれて"],["、"],["ユダ"],["の"],["ベツレヘム"],["から"],["モアブ"],["の"],["野","の"],["に"],["移り住んだ","うつりすんだ"],["。"]]},{"verse":2,"text":"その人は名をエリメレク、妻はナオミ、二人の息子はマフロンとキルヨンといい、ユダのベツレヘム出身のエフラタ族の者であった。彼らはモアブの野に着き、そこに住んだ。","tok":[["その"],["人","ひと"],["は"],["名","な"],["を"],["エリメレク"],["、"],["妻","つま"],["は"],["ナオミ"],["、"],["二人","ふたり"],["の"],["息子","むすこ"],["は"],["マフロン"],["と"],["キルヨン"],["と"],["いい"],["、"],["ユダ"],["の"],["ベツレヘム"],["出身","しゅっしん"],["の"],["エフラタ"],["族","ぞく"],["の"],["者","もの"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["モアブ"],["の"],["野","の"],["に"],["着き","つき"],["、"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":3,"text":"夫エリメレクは、ナオミと二人の息子を残して死んだ。","tok":[["夫","おっと"],["エリメレク"],["は"],["、"],["ナオミ"],["と"],["二人","ふたり"],["の"],["息子","むすこ"],["を"],["残して","のこして"],["死んだ","しんだ"],["。"]]},{"verse":4,"text":"息子たちはその後、モアブの女を妻とした。一人はオルパ、もう一人はルツといった。十年ほどそこに暮らしたが、","tok":[["息子","むすこ"],["たち"],["は"],["その"],["後","ご"],["、"],["モアブ"],["の"],["女","おんな"],["を"],["妻","つま"],["と"],["した"],["。"],["一人","ひとり"],["は"],["オルパ"],["、"],["もう"],["一人","ひとり"],["は"],["ルツ"],["と"],["いった"],["。"],["十","じゅう"],["年","ねん"],["ほど"],["そこ"],["に"],["暮らした","くらした"],["が"],["、"]]},{"verse":5,"text":"マフロンとキルヨンの二人も死に、ナオミは夫と二人の息子に先立たれ、一人残された。","tok":[["マフロン"],["と"],["キルヨン"],["の"],["二人","ふたり"],["も"],["死に","しに"],["、"],["ナオミ"],["は"],["夫","おっと"],["と"],["二人","ふたり"],["の"],["息子","むすこ"],["に"],["先立たれ","さきだたれ"],["、"],["一人","ひとり"],["残された","のこされた"],["。"]]},{"verse":6,"text":"ナオミは、モアブの野を去って国に帰ることにし、嫁たちも従った。主がその民を顧み、食べ物をお与えになったということを彼女はモアブの野で聞いたのである。","tok":[["ナオミ"],["は"],["、"],["モアブ"],["の"],["野","の"],["を"],["去って","さって"],["国","くに"],["に"],["帰る","かえる"],["こと"],["に"],["し"],["、"],["嫁","よめ"],["たち"],["も"],["従った","したがった"],["。"],["主","ぬし"],["が"],["その"],["民","たみ"],["を"],["顧み","かえりみ"],["、"],["食べ物","たべもの"],["を"],["お与え","おあたえ"],["に"],["なった"],["と"],["いう"],["こと"],["を"],["彼女","かのじょ"],["は"],["モアブ"],["の"],["野","の"],["で"],["聞いた","きいた"],["ので"],["ある"],["。"]]},{"verse":7,"text":"ナオミは住み慣れた場所を後にし、二人の嫁もついて行った。ルツの決意故国ユダに帰る道すがら、","tok":[["ナオミ"],["は"],["住み","すみ"],["慣れた","なれた"],["場所","ばしょ"],["を"],["後","あと"],["に"],["し"],["、"],["二人","ふたり"],["の"],["嫁","よめ"],["も"],["ついて"],["行った","いった"],["。"],["ルツ"],["の"],["決意","けつい"],["故国","ここく"],["ユダ"],["に"],["帰る","かえる"],["道すがら","みちすがら"],["、"]]},{"verse":8,"text":"ナオミは二人の嫁に言った。「自分の里に帰りなさい。あなたたちは死んだ息子にもわたしにもよく尽くしてくれた。どうか主がそれに報い、あなたたちに慈しみを垂れてくださいますように。","tok":[["ナオミ"],["は"],["二人","ふたり"],["の"],["嫁","よめ"],["に"],["言った","いった"],["。"],["「"],["自分","じぶん"],["の"],["里","さと"],["に"],["帰り","かえり"],["なさい"],["。"],["あなた"],["たち"],["は"],["死んだ","しんだ"],["息子","むすこ"],["に"],["も"],["わたし"],["に"],["も"],["よく"],["尽くして","つくして"],["くれた"],["。"],["どう"],["か"],["主","ぬし"],["が"],["それ"],["に"],["報い","むくい"],["、"],["あなた"],["たち"],["に"],["慈しみ","いつくしみ"],["を"],["垂れて","たれて"],["くださいます"],["よう"],["に"],["。"]]},{"verse":9,"text":"どうか主がそれぞれに新しい嫁ぎ先を与え、あなたたちが安らぎを得られますように。」ナオミが二人に別れの口づけをすると、二人は声をあげて泣いて、","tok":[["どう"],["か"],["主","ぬし"],["が"],["それぞれ"],["に"],["新しい","あたらしい"],["嫁ぎ先","とつぎさき"],["を"],["与え","あたえ"],["、"],["あなた"],["たち"],["が"],["安らぎ","やすらぎ"],["を"],["得られます","えられます"],["よう"],["に"],["。"],["」"],["ナオミ"],["が"],["二人","ふたり"],["に"],["別れ","わかれ"],["の"],["口づけ","くちづけ"],["を"],["する"],["と"],["、"],["二人","ふたり"],["は"],["声","こえ"],["を"],["あげて"],["泣いて","ないて"],["、"]]},{"verse":10,"text":"言った。「いいえ、御一緒にあなたの民のもとへ帰ります。」","tok":[["言った","いった"],["。"],["「"],["いいえ"],["、"],["御一緒","ごいっしょ"],["に"],["あなた"],["の"],["民","たみ"],["の"],["もと"],["へ"],["帰ります","かえります"],["。"],["」"]]},{"verse":11,"text":"ナオミは言った。「わたしの娘たちよ、帰りなさい。どうしてついて来るのですか。あなたたちの夫になるような子供がわたしの胎内にまだいるとでも思っているのですか。","tok":[["ナオミ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["の"],["娘","むすめ"],["たち"],["よ"],["、"],["帰り","かえり"],["なさい"],["。"],["どう"],["して"],["ついて"],["来る","くる"],["の"],["です"],["か"],["。"],["あなた"],["たち"],["の"],["夫","おっと"],["に"],["なる"],["よう"],["な"],["子供","こども"],["が"],["わたし"],["の"],["胎内","たいない"],["に"],["まだ"],["いる"],["と"],["で"],["も"],["思って","おもって"],["いる"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"わたしの娘たちよ、帰りなさい。わたしはもう年をとって、再婚などできはしません。たとえ、まだ望みがあると考えて、今夜にでもだれかのもとに嫁ぎ、子供を産んだとしても、","tok":[["わたし"],["の"],["娘","むすめ"],["たち"],["よ"],["、"],["帰り","かえり"],["なさい"],["。"],["わたし"],["は"],["もう"],["年","とし"],["を"],["とって"],["、"],["再婚","さいこん"],["など"],["でき"],["は"],["しません"],["。"],["たとえ"],["、"],["まだ"],["望み","のぞみ"],["が"],["ある"],["と"],["考えて","かんがえて"],["、"],["今夜","こんや"],["に"],["で"],["も"],["だれ"],["か"],["の"],["もと"],["に"],["嫁ぎ","とつぎ"],["、"],["子供","こども"],["を"],["産んだ","うんだ"],["として"],["も"],["、"]]},{"verse":13,"text":"その子たちが大きくなるまであなたたちは待つつもりですか。それまで嫁がずに過ごすつもりですか。わたしの娘たちよ、それはいけません。あなたたちよりもわたしの方がはるかにつらいのです。主の御手がわたしに下されたのですから。」","tok":[["その"],["子","こ"],["たち"],["が"],["大きく","おおきく"],["なる"],["まで"],["あなた"],["たち"],["は"],["待つ","まつ"],["つもり"],["です"],["か"],["。"],["それ"],["まで"],["嫁がず","とつがず"],["に"],["過ごす","すごす"],["つもり"],["です"],["か"],["。"],["わたし"],["の"],["娘","むすめ"],["たち"],["よ"],["、"],["それ"],["は"],["いけません"],["。"],["あなた"],["たち"],["より"],["も"],["わたし"],["の"],["方","ほう"],["が"],["はるか"],["に"],["つらい"],["の"],["です"],["。"],["主","ぬし"],["の"],["御手","おて"],["が"],["わたし"],["に"],["下された","くだされた"],["の"],["です"],["から"],["。"],["」"]]},{"verse":14,"text":"二人はまた声をあげて泣いた。オルパはやがて、しゅうとめに別れの口づけをしたが、ルツはすがりついて離れなかった。","tok":[["二人","ふたり"],["は"],["また"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"],["オルパ"],["は"],["やがて"],["、"],["しゅうとめ"],["に"],["別れ","わかれ"],["の"],["口づけ","くちづけ"],["を"],["した"],["が"],["、"],["ルツ"],["は"],["すがりついて"],["離れなかった","はなれなかった"],["。"]]},{"verse":15,"text":"ナオミは言った。「あのとおり、あなたの相嫁は自分の民、自分の神のもとへ帰って行こうとしている。あなたも後を追って行きなさい。」","tok":[["ナオミ"],["は"],["言った","いった"],["。"],["「"],["あの"],["とおり"],["、"],["あなた"],["の"],["相嫁","あいよめ"],["は"],["自分","じぶん"],["の"],["民","たみ"],["、"],["自分","じぶん"],["の"],["神","かみ"],["の"],["もと"],["へ"],["帰って","かえって"],["行こう","いこう"],["として"],["いる"],["。"],["あなた"],["も"],["後","あと"],["を"],["追って","おって"],["行き","いき"],["なさい"],["。"],["」"]]},{"verse":16,"text":"ルツは言った。「あなたを見捨て、あなたに背を向けて帰れなどと、そんなひどいことを強いないでください。わたしは、あなたの行かれる所に行きお泊まりになる所に泊まります。あなたの民はわたしの民あなたの神はわたしの神。","tok":[["ルツ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["を"],["見捨て","みすて"],["、"],["あなた"],["に"],["背","せ"],["を"],["向けて","むけて"],["帰れ","かえれ"],["など"],["と"],["、"],["そんな"],["ひどい"],["こと"],["を"],["強いないで","しいないで"],["ください"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["行かれる","いかれる"],["所","ところ"],["に"],["行き","いき"],["お泊まり","おとまり"],["に"],["なる"],["所","ところ"],["に"],["泊まります","とまります"],["。"],["あなた"],["の"],["民","たみ"],["は"],["わたし"],["の"],["民","たみ"],["あなた"],["の"],["神","かみ"],["は"],["わたし"],["の"],["神","かみ"],["。"]]},{"verse":17,"text":"あなたの亡くなる所でわたしも死にそこに葬られたいのです。死んでお別れするのならともかく、そのほかのことであなたを離れるようなことをしたなら、主よ、どうかわたしを幾重にも罰してください。」","tok":[["あなた"],["の"],["亡くなる","なくなる"],["所","ところ"],["で"],["わたし"],["も"],["死に","しに"],["そこ"],["に"],["葬られたい","ほうむられたい"],["の"],["です"],["。"],["死んで","しんで"],["お別れ","おわかれ"],["する"],["の"],["なら"],["ともかく"],["、"],["その"],["ほか"],["の"],["こと"],["で"],["あなた"],["を"],["離れる","はなれる"],["よう"],["な"],["こと"],["を"],["したなら"],["、"],["主","ぬし"],["よ"],["、"],["どう"],["か"],["わたし"],["を"],["幾重","いくえ"],["に"],["も"],["罰して","ばっして"],["ください"],["。"],["」"]]},{"verse":18,"text":"同行の決意が固いのを見て、ナオミはルツを説き伏せることをやめた。","tok":[["同行","どうこう"],["の"],["決意","けつい"],["が"],["固い","かたい"],["の"],["を"],["見て","みて"],["、"],["ナオミ"],["は"],["ルツ"],["を"],["説き伏せる","ときふせる"],["こと"],["を"],["やめた"],["。"]]},{"verse":19,"text":"二人は旅を続け、ついにベツレヘムに着いた。うつろな帰国ベツレヘムに着いてみると、町中が二人のことでどよめき、女たちが、ナオミさんではありませんかと声をかけてくると、","tok":[["二人","ふたり"],["は"],["旅","たび"],["を"],["続け","つづけ"],["、"],["ついに"],["ベツレヘム"],["に"],["着いた","ついた"],["。"],["うつろ"],["な"],["帰国","きこく"],["ベツレヘム"],["に"],["着いて","ついて"],["みる"],["と"],["、"],["町中","まちなか"],["が"],["二人","ふたり"],["の"],["こと"],["で"],["どよめき"],["、"],["女","おんな"],["たち"],["が"],["、"],["ナオミ"],["さん"],["で"],["は"],["ありません"],["か"],["と"],["声","こえ"],["を"],["かけて"],["くる"],["と"],["、"]]},{"verse":20,"text":"ナオミは言った。「どうか、ナオミ（快い）などと呼ばないで、マラ（苦い）と呼んでください。全能者がわたしをひどい目に遭わせたのです。","tok":[["ナオミ"],["は"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["ナオミ"],["（"],["快い","こころよい"],["）"],["など"],["と"],["呼ばないで","よばないで"],["、"],["マラ"],["（"],["苦い","にがい"],["）"],["と"],["呼んで","よんで"],["ください"],["。"],["全能者","ぜんのうしゃ"],["が"],["わたし"],["を"],["ひどい"],["目","め"],["に"],["遭わせた","あわせた"],["の"],["です"],["。"]]},{"verse":21,"text":"出て行くときは、満たされていたわたしを主はうつろにして帰らせたのです。なぜ、快い（ナオミ）などと呼ぶのですか。主がわたしを悩ませ全能者がわたしを不幸に落とされたのに。」","tok":[["出て","でて"],["行く","いく"],["とき"],["は"],["、"],["満たされて","みたされて"],["いた"],["わたし"],["を"],["主","ぬし"],["は"],["うつろ"],["に"],["して"],["帰らせた","かえらせた"],["の"],["です"],["。"],["なぜ"],["、"],["快い","こころよい"],["（"],["ナオミ"],["）"],["など"],["と"],["呼ぶ","よぶ"],["の"],["です"],["か"],["。"],["主","ぬし"],["が"],["わたし"],["を"],["悩ませ","なやませ"],["全能者","ぜんのうしゃ"],["が"],["わたし"],["を"],["不幸","ふこう"],["に"],["落とされた","おとされた"],["のに"],["。"],["」"]]},{"verse":22,"text":"ナオミはこうして、モアブ生まれの嫁ルツを連れてモアブの野を去り、帰って来た。二人がベツレヘムに着いたのは、大麦の刈り入れの始まるころであった。","tok":[["ナオミ"],["は"],["こう"],["して"],["、"],["モアブ"],["生まれ","うまれ"],["の"],["嫁","よめ"],["ルツ"],["を"],["連れて","つれて"],["モアブ"],["の"],["野","の"],["を"],["去り","さり"],["、"],["帰って","かえって"],["来た","きた"],["。"],["二人","ふたり"],["が"],["ベツレヘム"],["に"],["着いた","ついた"],["の"],["は"],["、"],["大麦","おおむぎ"],["の"],["刈り入れ","かりいれ"],["の"],["始まる","はじまる"],["ころ"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"ボアズが町の門のところへ上って行って座ると、折よく、ボアズが話していた当の親戚の人が通り過ぎようとした。「引き返してここにお座りください」と言うと、その人は引き返してきて座った。","tok":[["ボアズ"],["が"],["町","まち"],["の"],["門","もん"],["の"],["ところ"],["へ"],["上って","のぼって"],["行って","いって"],["座る","すわる"],["と"],["、"],["折","おり"],["よく"],["、"],["ボアズ"],["が"],["話して","はなして"],["いた"],["当","とう"],["の"],["親戚","しんせき"],["の"],["人","ひと"],["が"],["通り過ぎよう","とおりすぎよう"],["と"],["した"],["。"],["「"],["引き返して","ひきかえして"],["ここ"],["に"],["お座り","おすわり"],["ください"],["」"],["と"],["言う","ゆう"],["と"],["、"],["その"],["人","ひと"],["は"],["引き返して","ひきかえして"],["きて"],["座った","すわった"],["。"]]},{"verse":2,"text":"ボアズは町の長老のうちから十人を選び、ここに座ってくださいと頼んだので、彼らも座った。","tok":[["ボアズ"],["は"],["町","まち"],["の"],["長老","ちょうろう"],["の"],["うち"],["から"],["十人","じゅうにん"],["を"],["選び","えらび"],["、"],["ここ"],["に"],["座って","すわって"],["ください"],["と"],["頼んだ","たのんだ"],["ので"],["、"],["彼","かれ"],["ら"],["も"],["座った","すわった"],["。"]]},{"verse":3,"text":"ボアズはその親戚の人に言った。「モアブの野から帰って来たナオミが、わたしたちの一族エリメレクの所有する畑地を手放そうとしています。","tok":[["ボアズ"],["は"],["その"],["親戚","しんせき"],["の"],["人","ひと"],["に"],["言った","いった"],["。"],["「"],["モアブ"],["の"],["野","の"],["から"],["帰って","かえって"],["来た","きた"],["ナオミ"],["が"],["、"],["わたしたち"],["の"],["一族","いちぞく"],["エリメレク"],["の"],["所有","しょゆう"],["する"],["畑地","はたち"],["を"],["手放そう","てばなそう"],["として"],["います"],["。"]]},{"verse":4,"text":"それでわたしの考えをお耳に入れたいと思ったのです。もしあなたに責任を果たすおつもりがあるのでしたら、この裁きの座にいる人々と民の長老たちの前で買い取ってください。もし責任を果たせないのでしたら、わたしにそう言ってください。それならわたしが考えます。責任を負っている人はあなたのほかになく、わたしはその次の者ですから。」「それではわたしがその責任を果たしましょう」と彼が言うと、","tok":[["それ"],["で"],["わたし"],["の"],["考え","かんがえ"],["を"],["お耳","おみみ"],["に"],["入れたい","いれたい"],["と"],["思った","おもった"],["の"],["です"],["。"],["もし"],["あなた"],["に"],["責任","せきにん"],["を"],["果たす","はたす"],["おつもり"],["が"],["ある"],["の"],["でしたら"],["、"],["この"],["裁き","さばき"],["の"],["座","ざ"],["に"],["いる"],["人々","ひとびと"],["と"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["の"],["前","まえ"],["で"],["買い取って","かいとって"],["ください"],["。"],["もし"],["責任","せきにん"],["を"],["果たせない","はたせない"],["の"],["でしたら"],["、"],["わたし"],["に"],["そう"],["言って","いって"],["ください"],["。"],["それ"],["なら"],["わたし"],["が"],["考えます","かんがえます"],["。"],["責任","せきにん"],["を"],["負って","おって"],["いる"],["人","ひと"],["は"],["あなた"],["の"],["ほか"],["に"],["なく"],["、"],["わたし"],["は"],["その"],["次","つぎ"],["の"],["者","もの"],["です"],["から"],["。"],["」"],["「"],["それ"],["で"],["は"],["わたし"],["が"],["その"],["責任","せきにん"],["を"],["果たしましょう","はたしましょう"],["」"],["と"],["彼","かれ"],["が"],["言う","ゆう"],["と"],["、"]]},{"verse":5,"text":"ボアズは続けた。「あなたがナオミの手から畑地を買い取るときには、亡くなった息子の妻であるモアブの婦人ルツも引き取らなければなりません。故人の名をその嗣業の土地に再興するためです。」","tok":[["ボアズ"],["は"],["続けた","つづけた"],["。"],["「"],["あなた"],["が"],["ナオミ"],["の"],["手","て"],["から"],["畑地","はたち"],["を"],["買い取る","かいとる"],["とき"],["に"],["は"],["、"],["亡くなった","なくなった"],["息子","むすこ"],["の"],["妻","つま"],["で"],["ある"],["モアブ"],["の"],["婦人","ふじん"],["ルツ"],["も"],["引き取らなければ","ひきとらなければ"],["なりません"],["。"],["故人","こじん"],["の"],["名","な"],["を"],["その"],["嗣業","しぎょう"],["の"],["土地","とち"],["に"],["再興","さいこう"],["する"],["ため"],["です"],["。"],["」"]]},{"verse":6,"text":"すると親戚の人は言った。「そこまで責任を負うことは、わたしにはできかねます。それではわたしの嗣業を損なうことになります。親族としてわたしが果たすべき責任をあなたが果たしてくださいませんか。そこまで責任を負うことは、わたしにはできかねます。」","tok":[["する"],["と"],["親戚","しんせき"],["の"],["人","ひと"],["は"],["言った","いった"],["。"],["「"],["そこ"],["まで"],["責任","せきにん"],["を"],["負う","おう"],["こと"],["は"],["、"],["わたし"],["に"],["は"],["でき"],["かね"],["ます"],["。"],["それ"],["で"],["は"],["わたし"],["の"],["嗣業","しぎょう"],["を"],["損なう","そこなう"],["こと"],["に"],["なります"],["。"],["親族","しんぞく"],["として"],["わたし"],["が"],["果たすべき","はたすべき"],["責任","せきにん"],["を"],["あなた"],["が"],["果たして","はたして"],["くださいません"],["か"],["。"],["そこ"],["まで"],["責任","せきにん"],["を"],["負う","おう"],["こと"],["は"],["、"],["わたし"],["に"],["は"],["でき"],["かね"],["ます"],["。"],["」"]]},{"verse":7,"text":"かつてイスラエルでは、親族としての責任の履行や譲渡にあたって、一切の手続きを認証するためには、当事者が自分の履物を脱いで相手に渡すことになっていた。これが、イスラエルにおける認証の手続きであった。","tok":[["かつて"],["イスラエル"],["で"],["は"],["、"],["親族","しんぞく"],["として"],["の"],["責任","せきにん"],["の"],["履行","りこう"],["や"],["譲渡","じょうと"],["に"],["あたって"],["、"],["一切","いっさい"],["の"],["手続き","てつづき"],["を"],["認証","にんしょう"],["する"],["ため"],["に"],["は"],["、"],["当事者","とうじしゃ"],["が"],["自分","じぶん"],["の"],["履物","はきもの"],["を"],["脱いで","ぬいで"],["相手","あいて"],["に"],["渡す","わたす"],["こと"],["に"],["なって"],["いた"],["。"],["これ"],["が"],["、"],["イスラエル"],["に"],["おける"],["認証","にんしょう"],["の"],["手続き","てつづき"],["で"],["あった"],["。"]]},{"verse":8,"text":"その親戚の人は、「どうぞあなたがその人をお引き取りください」とボアズに言って、履物を脱いだ。","tok":[["その"],["親戚","しんせき"],["の"],["人","ひと"],["は"],["、"],["「"],["どうぞ"],["あなた"],["が"],["その"],["人","ひと"],["を"],["お引き取り","おひきとり"],["ください"],["」"],["と"],["ボアズ"],["に"],["言って","いって"],["、"],["履物","はきもの"],["を"],["脱いだ","ぬいだ"],["。"]]},{"verse":9,"text":"ボアズはそこで、長老とすべての民に言った。「あなたがたは、今日、わたしがエリメレクとキルヨンとマフロンの遺産をことごとくナオミの手から買い取ったことの証人になったのです。","tok":[["ボアズ"],["は"],["そこ"],["で"],["、"],["長老","ちょうろう"],["と"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["今日","きょう"],["、"],["わたし"],["が"],["エリメレク"],["と"],["キルヨン"],["と"],["マフロン"],["の"],["遺産","いさん"],["を"],["ことごとく"],["ナオミ"],["の"],["手","て"],["から"],["買い取った","かいとった"],["こと"],["の"],["証人","しょうにん"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":10,"text":"また、わたしはマフロンの妻であったモアブの婦人ルツも引き取って妻とします。故人の名をその嗣業の土地に再興するため、また故人の名が一族や郷里の門から絶えてしまわないためです。あなたがたは、今日、このことの証人になったのです。」","tok":[["また"],["、"],["わたし"],["は"],["マフロン"],["の"],["妻","つま"],["で"],["あった"],["モアブ"],["の"],["婦人","ふじん"],["ルツ"],["も"],["引き取って","ひきとって"],["妻","つま"],["と"],["します"],["。"],["故人","こじん"],["の"],["名","な"],["を"],["その"],["嗣業","しぎょう"],["の"],["土地","とち"],["に"],["再興","さいこう"],["する"],["ため"],["、"],["また"],["故人","こじん"],["の"],["名","な"],["が"],["一族","いちぞく"],["や"],["郷里","きょうり"],["の"],["門","もん"],["から"],["絶えて","たえて"],["しまわない"],["ため"],["です"],["。"],["あなた"],["がた"],["は"],["、"],["今日","きょう"],["、"],["この"],["こと"],["の"],["証人","しょうにん"],["に"],["なった"],["の"],["です"],["。"],["」"]]},{"verse":11,"text":"門のところにいたすべての民と長老たちは言った。「そうです、わたしたちは証人です。あなたが家に迎え入れる婦人を、どうか、主がイスラエルの家を建てたラケルとレアの二人のようにしてくださるように。また、あなたがエフラタで富を増し、ベツレヘムで名をあげられるように。","tok":[["門","もん"],["の"],["ところ"],["に"],["いた"],["すべて"],["の"],["民","たみ"],["と"],["長老","ちょうろう"],["たち"],["は"],["言った","いった"],["。"],["「"],["そう"],["です"],["、"],["わたしたち"],["は"],["証人","しょうにん"],["です"],["。"],["あなた"],["が"],["家","いえ"],["に"],["迎え入れる","むかえいれる"],["婦人","ふじん"],["を"],["、"],["どう"],["か"],["、"],["主","ぬし"],["が"],["イスラエル"],["の"],["家","いえ"],["を"],["建てた","たてた"],["ラケル"],["と"],["レア"],["の"],["二人","ふたり"],["の"],["よう"],["に"],["して"],["くださる"],["よう"],["に"],["。"],["また"],["、"],["あなた"],["が"],["エフラタ"],["で"],["富","とみ"],["を"],["増し","まし"],["、"],["ベツレヘム"],["で"],["名","な"],["を"],["あげられる"],["よう"],["に"],["。"]]},{"verse":12,"text":"どうか、主がこの若い婦人によってあなたに子宝をお与えになり、タマルがユダのために産んだペレツの家のように、御家庭が恵まれるように。」","tok":[["どう"],["か"],["、"],["主","ぬし"],["が"],["この"],["若い","わかい"],["婦人","ふじん"],["によって"],["あなた"],["に"],["子宝","こだから"],["を"],["お与え","おあたえ"],["に"],["なり"],["、"],["タマル"],["が"],["ユダ"],["の"],["ため"],["に"],["産んだ","うんだ"],["ペレツ"],["の"],["家","いえ"],["の"],["よう"],["に"],["、"],["御家庭","ごかてい"],["が"],["恵まれる","めぐまれる"],["よう"],["に"],["。"],["」"]]},{"verse":13,"text":"ボアズはこうしてルツをめとったので、ルツはボアズの妻となり、ボアズは彼女のところに入った。主が身ごもらせたので、ルツは男の子を産んだ。","tok":[["ボアズ"],["は"],["こう"],["して"],["ルツ"],["を"],["めとった"],["ので"],["、"],["ルツ"],["は"],["ボアズ"],["の"],["妻","つま"],["と"],["なり"],["、"],["ボアズ"],["は"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入った","はいった"],["。"],["主","ぬし"],["が"],["身ごもらせた","みごもらせた"],["ので"],["、"],["ルツ"],["は"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":14,"text":"女たちはナオミに言った。「主をたたえよ。主はあなたを見捨てることなく、家を絶やさぬ責任のある人を今日お与えくださいました。どうか、イスラエルでその子の名があげられますように。","tok":[["女","おんな"],["たち"],["は"],["ナオミ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["を"],["たたえ"],["よ"],["。"],["主","ぬし"],["は"],["あなた"],["を"],["見捨てる","みすてる"],["こと"],["なく"],["、"],["家","いえ"],["を"],["絶やさぬ","たやさぬ"],["責任","せきにん"],["の"],["ある"],["人","ひと"],["を"],["今日","きょう"],["お与え","おあたえ"],["くださいました"],["。"],["どう"],["か"],["、"],["イスラエル"],["で"],["その"],["子","こ"],["の"],["名","な"],["が"],["あげられます"],["よう"],["に"],["。"]]},{"verse":15,"text":"その子はあなたの魂を生き返らせる者となり、老後の支えとなるでしょう。あなたを愛する嫁、七人の息子にもまさるあの嫁がその子を産んだのですから。」","tok":[["その"],["子","こ"],["は"],["あなた"],["の"],["魂","たましい"],["を"],["生き返らせる","いきかえらせる"],["者","もの"],["と"],["なり"],["、"],["老後","ろうご"],["の"],["支え","ささえ"],["と"],["なるでしょう"],["。"],["あなた"],["を"],["愛する","あいする"],["嫁","よめ"],["、"],["七人","しちにん"],["の"],["息子","むすこ"],["に"],["も"],["まさる"],["あの"],["嫁","よめ"],["が"],["その"],["子","こ"],["を"],["産んだ","うんだ"],["の"],["です"],["から"],["。"],["」"]]},{"verse":16,"text":"ナオミはその乳飲み子をふところに抱き上げ、養い育てた。","tok":[["ナオミ"],["は"],["その"],["乳飲み子","ちのみご"],["を"],["ふところ"],["に"],["抱き上げ","だきあげ"],["、"],["養い育てた","やしないそだてた"],["。"]]},{"verse":17,"text":"近所の婦人たちは、ナオミに子供が生まれたと言って、その子に名前を付け、その子をオベドと名付けた。オベドはエッサイの父、エッサイはダビデの父である。","tok":[["近所","きんじょ"],["の"],["婦人","ふじん"],["たち"],["は"],["、"],["ナオミ"],["に"],["子供","こども"],["が"],["生まれた","うまれた"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["に"],["名前","なまえ"],["を"],["付け","つけ"],["、"],["その"],["子","こ"],["を"],["オベド"],["と"],["名付けた","なづけた"],["。"],["オベド"],["は"],["エッサイ"],["の"],["父","ちち"],["、"],["エッサイ"],["は"],["ダビデ"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":18,"text":"ペレツの系図は次のとおりである。ペレツにはヘツロンが生まれた。","tok":[["ペレツ"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ペレツ"],["に"],["は"],["ヘツロン"],["が"],["生まれた","うまれた"],["。"]]},{"verse":19,"text":"ヘツロンにはラムが生まれ、ラムにはアミナダブが生まれた。","tok":[["ヘツロン"],["に"],["は"],["ラム"],["が"],["生まれ","うまれ"],["、"],["ラム"],["に"],["は"],["アミナダブ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":20,"text":"アミナダブにはナフションが生まれ、ナフションにはサルマが生まれた。","tok":[["アミナダブ"],["に"],["は"],["ナフション"],["が"],["生まれ","うまれ"],["、"],["ナフション"],["に"],["は"],["サルマ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":21,"text":"サルマにはボアズが生まれ、ボアズにはオベドが生まれた。","tok":[["サルマ"],["に"],["は"],["ボアズ"],["が"],["生まれ","うまれ"],["、"],["ボアズ"],["に"],["は"],["オベド"],["が"],["生まれた","うまれた"],["。"]]},{"verse":22,"text":"オベドにはエッサイが生まれ、エッサイにはダビデが生まれた。","tok":[["オベド"],["に"],["は"],["エッサイ"],["が"],["生まれ","うまれ"],["、"],["エッサイ"],["に"],["は"],["ダビデ"],["が"],["生まれた","うまれた"],["。"]]}]
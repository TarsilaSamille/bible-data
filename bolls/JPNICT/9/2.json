[{"verse":1,"text":"ハンナは祈って言った。「主にあってわたしの心は喜び主にあってわたしは角を高く上げる。わたしは敵に対して口を大きく開き御救いを喜び祝う。","tok":[["ハンナ"],["は"],["祈って","いのって"],["言った","いった"],["。"],["「"],["主に","おもに"],["あって"],["わたし"],["の"],["心","こころ"],["は"],["喜び","よろこび"],["主に","おもに"],["あって"],["わたし"],["は"],["角","かど"],["を"],["高く","たかく"],["上げる","あげる"],["。"],["わたし"],["は"],["敵","てき"],["に対して","にたいして"],["口","くち"],["を"],["大きく","おおきく"],["開き","ひらき"],["御救い","おすくい"],["を"],["喜び祝う","よろこびいわう"],["。"]]},{"verse":2,"text":"聖なる方は主のみ。あなたと並ぶ者はだれもいない。岩と頼むのはわたしたちの神のみ。","tok":[["聖","せい"],["なる"],["方","かた"],["は"],["主","ぬし"],["のみ"],["。"],["あなた"],["と"],["並ぶ","ならぶ"],["者","もの"],["は"],["だれ"],["も"],["いない"],["。"],["岩","いわ"],["と"],["頼む","たのむ"],["の"],["は"],["わたしたち"],["の"],["神","かみ"],["のみ"],["。"]]},{"verse":3,"text":"驕り高ぶるな、高ぶって語るな。思い上がった言葉を口にしてはならない。主は何事も知っておられる神人の行いが正されずに済むであろうか。","tok":[["驕り高ぶる","おごりたかぶる"],["な"],["、"],["高ぶって","たかぶって"],["語る","かたる"],["な"],["。"],["思い上がった","おもいあがった"],["言葉","ことば"],["を"],["口","くち"],["に"],["して"],["は"],["ならない"],["。"],["主","ぬし"],["は"],["何事","なにごと"],["も"],["知って","しって"],["おられる"],["神人","しんじん"],["の"],["行い","おこない"],["が"],["正されず","ただされず"],["に"],["済むで","すむで"],["あろう"],["か"],["。"]]},{"verse":4,"text":"勇士の弓は折られるがよろめく者は力を帯びる。","tok":[["勇士","ゆうし"],["の"],["弓","ゆみ"],["は"],["折られる","おられる"],["が"],["よろめく"],["者","もの"],["は"],["力","ちから"],["を"],["帯びる","おびる"],["。"]]},{"verse":5,"text":"食べ飽きている者はパンのために雇われ飢えている者は再び飢えることがない。子のない女は七人の子を産み多くの子をもつ女は衰える。","tok":[["食べ飽きて","たべあきて"],["いる"],["者","もの"],["は"],["パン"],["の"],["ため"],["に"],["雇われ","やとわれ"],["飢えて","うえて"],["いる"],["者","もの"],["は"],["再び","ふたたび"],["飢える","うえる"],["こと"],["が"],["ない"],["。"],["子","こ"],["の"],["ない"],["女","おんな"],["は"],["七人","ななにん"],["の"],["子","こ"],["を"],["産み","うみ"],["多く","おおく"],["の"],["子","こ"],["を"],["もつ"],["女","おんな"],["は"],["衰える","おとろえる"],["。"]]},{"verse":6,"text":"主は命を絶ち、また命を与え陰府に下し、また引き上げてくださる。","tok":[["主","ぬし"],["は"],["命","いのち"],["を"],["絶ち","たち"],["、"],["また"],["命","いのち"],["を"],["与え","あたえ"],["陰府","よみ"],["に"],["下し","くだし"],["、"],["また"],["引き上げて","ひきあげて"],["くださる"],["。"]]},{"verse":7,"text":"主は貧しくし、また富ませ低くし、また高めてくださる。","tok":[["主","ぬし"],["は"],["貧しく","まずしく"],["し"],["、"],["また"],["富ませ","とませ"],["低く","ひくく"],["し"],["、"],["また"],["高めて","たかめて"],["くださる"],["。"]]},{"verse":8,"text":"弱い者を塵の中から立ち上がらせ貧しい者を芥の中から高く上げ高貴な者と共に座に着かせ栄光の座を嗣業としてお与えになる。大地のもろもろの柱は主のもの主は世界をそれらの上に据えられた。","tok":[["弱い","よわい"],["者","もの"],["を"],["塵","ごみ"],["の"],["中","なか"],["から"],["立ち上がらせ","たちあがらせ"],["貧しい","まずしい"],["者","もの"],["を"],["芥","あくた"],["の"],["中","なか"],["から"],["高く","たかく"],["上げ","あげ"],["高貴","こうき"],["な"],["者","もの"],["と"],["共","とも"],["に"],["座","ざ"],["に"],["着かせ","つかせ"],["栄光","えいこう"],["の"],["座","ざ"],["を"],["嗣業","しぎょう"],["として"],["お与え","おあたえ"],["に"],["なる"],["。"],["大地","だいち"],["の"],["もろもろ"],["の"],["柱","はしら"],["は"],["主","ぬし"],["の"],["もの"],["主","ぬし"],["は"],["世界","せかい"],["を"],["それ"],["ら"],["の"],["上","うえ"],["に"],["据えられた","すえられた"],["。"]]},{"verse":9,"text":"主の慈しみに生きる者の足を主は守り主に逆らう者を闇の沈黙に落とされる。人は力によって勝つのではない。","tok":[["主","ぬし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["者","もの"],["の"],["足","あし"],["を"],["主","ぬし"],["は"],["守り","まもり"],["主に","おもに"],["逆らう","さからう"],["者","もの"],["を"],["闇","やみ"],["の"],["沈黙","ちんもく"],["に"],["落とされる","おとされる"],["。"],["人","ひと"],["は"],["力","ちから"],["によって"],["勝つ","かつ"],["ので"],["は"],["ない"],["。"]]},{"verse":10,"text":"主は逆らう者を打ち砕き天から彼らに雷鳴をとどろかされる。主は地の果てまで裁きを及ぼし王に力を与え油注がれた者の角を高く上げられる。」","tok":[["主","ぬし"],["は"],["逆らう","さからう"],["者","もの"],["を"],["打ち砕き","うちくだき"],["天","てん"],["から"],["彼","かれ"],["ら"],["に"],["雷鳴","らいめい"],["を"],["とどろかされる"],["。"],["主","ぬし"],["は"],["地","ち"],["の"],["果て","はて"],["まで"],["裁き","さばき"],["を"],["及ぼし","およぼし"],["王","おう"],["に"],["力","ちから"],["を"],["与え","あたえ"],["油","あぶら"],["注がれた","そそがれた"],["者","もの"],["の"],["角","かど"],["を"],["高く","たかく"],["上げられる","あげられる"],["。"],["」"]]},{"verse":11,"text":"エルカナはラマの家に帰った。幼子は祭司エリのもとにとどまって、主に仕えた。","tok":[["エルカナ"],["は"],["ラマ"],["の"],["家","いえ"],["に"],["帰った","かえった"],["。"],["幼子","おさなご"],["は"],["祭司","さいし"],["エリ"],["の"],["もと"],["に"],["とどまって"],["、"],["主に","おもに"],["仕えた","つかえた"],["。"]]},{"verse":12,"text":"エリの息子はならず者で、主を知ろうとしなかった。","tok":[["エリ"],["の"],["息子","むすこ"],["は"],["ならず者","ならずもの"],["で"],["、"],["主","ぬし"],["を"],["知ろう","しろう"],["と"],["しなかった"],["。"]]},{"verse":13,"text":"この祭司たちは、人々に対して次のように行った。だれかがいけにえをささげていると、その肉を煮ている間に、祭司の下働きが三つまたの肉刺しを手にやって来て、","tok":[["この"],["祭司","さいし"],["たち"],["は"],["、"],["人々","ひとびと"],["に対して","にたいして"],["次","つぎ"],["の"],["よう"],["に"],["行った","おこなった"],["。"],["だれ"],["か"],["が"],["いけにえ"],["を"],["ささげて"],["いる"],["と"],["、"],["その"],["肉","にく"],["を"],["煮て","にて"],["いる"],["間","あいだ"],["に"],["、"],["祭司","さいし"],["の"],["下働き","したばたらき"],["が"],["三","みっ"],["つ"],["また"],["の"],["肉刺し","にくさし"],["を"],["手","て"],["に"],["やって"],["来て","きて"],["、"]]},{"verse":14,"text":"釜や鍋であれ、鉢や皿であれ、そこに突き入れた。肉刺しが突き上げたものはすべて、祭司のものとした。彼らは、シロに詣でるイスラエルの人々すべてに対して、このように行った。","tok":[["釜","かま"],["や"],["鍋","なべ"],["で"],["あれ"],["、"],["鉢","ばち"],["や"],["皿","さら"],["で"],["あれ"],["、"],["そこ"],["に"],["突き入れた","つきいれた"],["。"],["肉刺し","にくさし"],["が"],["突き上げた","つきあげた"],["もの"],["は"],["すべて"],["、"],["祭司","さいし"],["の"],["もの"],["と"],["した"],["。"],["彼","かれ"],["ら"],["は"],["、"],["シロ"],["に"],["詣でる","もうでる"],["イスラエル"],["の"],["人々","ひとびと"],["すべて"],["に対して","にたいして"],["、"],["この"],["よう"],["に"],["行った","おこなった"],["。"]]},{"verse":15,"text":"そればかりでなく、人々が供え物の脂肪を燃やして煙にする前に、祭司の下働きがやって来て、いけにえをささげる人に言った。「祭司様のために焼く肉をよこしなさい。祭司は煮た肉は受け取らない。生でなければならない。」","tok":[["それ"],["ばかり"],["で"],["なく"],["、"],["人々","ひとびと"],["が"],["供え物","そなえもの"],["の"],["脂肪","しぼう"],["を"],["燃やして","もやして"],["煙","けむり"],["に"],["する"],["前","まえ"],["に"],["、"],["祭司","さいし"],["の"],["下働き","したばたらき"],["が"],["やって"],["来て","きて"],["、"],["いけにえ"],["を"],["ささげる"],["人","ひと"],["に"],["言った","いった"],["。"],["「"],["祭司様","さいしさま"],["の"],["ため"],["に"],["焼く","やく"],["肉","にく"],["を"],["よこし"],["なさい"],["。"],["祭司","さいし"],["は"],["煮た","にた"],["肉","にく"],["は"],["受け取らない","うけとらない"],["。"],["生","なま"],["で"],["なければ"],["ならない"],["。"],["」"]]},{"verse":16,"text":"「いつものように脂肪をすっかり燃やして煙になってから、あなたの思いどおりに取ってください」と言っても、下働きは、「今、よこしなさい。さもなければ力ずくで取る」と答えるのであった。","tok":[["「"],["いつも"],["の"],["よう"],["に"],["脂肪","しぼう"],["を"],["すっかり"],["燃やして","もやして"],["煙","けむり"],["に"],["なって"],["から"],["、"],["あなた"],["の"],["思い","おもい"],["どおり"],["に"],["取って","とって"],["ください"],["」"],["と"],["言って","いって"],["も"],["、"],["下働き","したばたらき"],["は"],["、"],["「"],["今","いま"],["、"],["よこし"],["なさい"],["。"],["さも"],["なければ"],["力","ちから"],["ずく"],["で"],["取る","とる"],["」"],["と"],["答える","こたえる"],["ので"],["あった"],["。"]]},{"verse":17,"text":"この下働きたちの罪は主に対する甚だ大きな罪であった。この人々が主への供え物を軽んじたからである。","tok":[["この"],["下働き","したばたらき"],["たち"],["の"],["罪","つみ"],["は"],["主","ぬし"],["に"],["対する","たいする"],["甚だ","はなはだ"],["大きな","おおきな"],["罪","つみ"],["で"],["あった"],["。"],["この"],["人々","ひとびと"],["が"],["主","ぬし"],["へ"],["の"],["供え物","そなえもの"],["を"],["軽んじた","かろんじた"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"サムエルは、亜麻布のエフォドを着て、下働きとして主の御前に仕えていた。","tok":[["サムエル"],["は"],["、"],["亜","あ"],["麻布","あざぶ"],["の"],["エフォド"],["を"],["着て","きて"],["、"],["下働き","したばたらき"],["として"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["仕えて","つかえて"],["いた"],["。"]]},{"verse":19,"text":"母は彼のために小さな上着を縫い、毎年、夫と一緒に年ごとのいけにえをささげに上って来るとき、それを届けた。","tok":[["母","はは"],["は"],["彼","かれ"],["の"],["ため"],["に"],["小さな","ちいさな"],["上着","うわぎ"],["を"],["縫い","ぬい"],["、"],["毎年","まいとし"],["、"],["夫","おっと"],["と"],["一緒","いっしょ"],["に"],["年","ねん"],["ごと"],["の"],["いけにえ"],["を"],["ささげ"],["に"],["上って","のぼって"],["来る","くる"],["とき"],["、"],["それ"],["を"],["届けた","とどけた"],["。"]]},{"verse":20,"text":"エリはエルカナとその妻を祝福し、「主に願って得たこの子の代わりに、主があなたにこの妻による子供を授けてくださいますように」と言った。こうして彼らは家に帰った。","tok":[["エリ"],["は"],["エルカナ"],["と"],["その"],["妻","つま"],["を"],["祝福","しゅくふく"],["し"],["、"],["「"],["主に","おもに"],["願って","ねがって"],["得た","えた"],["この"],["子","こ"],["の"],["代わり","かわり"],["に"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["この"],["妻","つま"],["に"],["よる"],["子供","こども"],["を"],["授けて","さずけて"],["くださいます"],["よう"],["に"],["」"],["と"],["言った","いった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["家","いえ"],["に"],["帰った","かえった"],["。"]]},{"verse":21,"text":"主がハンナを顧みられたので、ハンナは身ごもり、息子を三人と娘を二人産んだ。少年サムエルは主のもとで成長した。","tok":[["主","ぬし"],["が"],["ハンナ"],["を"],["顧みられた","かえりみられた"],["ので"],["、"],["ハンナ"],["は"],["身ごもり","みごもり"],["、"],["息子","むすこ"],["を"],["三人","さんにん"],["と"],["娘","むすめ"],["を"],["二人","ふたり"],["産んだ","うんだ"],["。"],["少年","しょうねん"],["サムエル"],["は"],["主","ぬし"],["の"],["もと"],["で"],["成長","せいちょう"],["した"],["。"]]},{"verse":22,"text":"エリは非常に年老いていた。息子たちがイスラエルの人々すべてに対して行っていることの一部始終、それに、臨在の幕屋の入り口で仕えている女たちとたびたび床を共にしていることも耳にして、","tok":[["エリ"],["は"],["非常","ひじょう"],["に"],["年老いて","としおいて"],["いた"],["。"],["息子","むすこ"],["たち"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["すべて"],["に対して","にたいして"],["行って","いって"],["いる"],["こと"],["の"],["一部","いちぶ"],["始終","しじゅう"],["、"],["それ"],["に"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["で"],["仕えて","つかえて"],["いる"],["女","おんな"],["たち"],["と"],["たびたび"],["床","ゆか"],["を"],["共","とも"],["に"],["して"],["いる"],["こと"],["も"],["耳","みみ"],["に"],["して"],["、"]]},{"verse":23,"text":"彼らを諭した。「なぜそのようなことをするのだ。わたしはこの民のすべての者から、お前たちについて悪いうわさを聞かされている。","tok":[["彼","かれ"],["ら"],["を"],["諭した","さとした"],["。"],["「"],["なぜ"],["その"],["よう"],["な"],["こと"],["を"],["する"],["の"],["だ"],["。"],["わたし"],["は"],["この"],["民","たみ"],["の"],["すべて"],["の"],["者","もの"],["から"],["、"],["お前","おまえ"],["たち"],["について"],["悪い","わるい"],["うわさ"],["を"],["聞かされて","きかされて"],["いる"],["。"]]},{"verse":24,"text":"息子らよ、それはいけない。主の民が触れ回り、わたしの耳にも入ったうわさはよくない。","tok":[["息子","むすこ"],["ら"],["よ"],["、"],["それ"],["は"],["いけない"],["。"],["主","ぬし"],["の"],["民","たみ"],["が"],["触れ回り","ふれまわり"],["、"],["わたし"],["の"],["耳","みみ"],["に"],["も"],["入った","はいった"],["うわさ"],["は"],["よく"],["ない"],["。"]]},{"verse":25,"text":"人が人に罪を犯しても、神が間に立ってくださる。だが、人が主に罪を犯したら、誰が執り成してくれよう。」しかし、彼らは父の声に耳を貸そうとしなかった。主は彼らの命を絶とうとしておられた。","tok":[["人","ひと"],["が"],["人","ひと"],["に"],["罪","つみ"],["を"],["犯して","おかして"],["も"],["、"],["神","かみ"],["が"],["間","あいだ"],["に"],["立って","たって"],["くださる"],["。"],["だ"],["が"],["、"],["人","ひと"],["が"],["主に","おもに"],["罪","つみ"],["を"],["犯したら","おかしたら"],["、"],["誰","だれ"],["が"],["執り成して","とりなして"],["くれよう"],["。"],["」"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["父","ちち"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["貸そう","かそう"],["と"],["しなかった"],["。"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["命","いのち"],["を"],["絶とう","たとう"],["として"],["おられた"],["。"]]},{"verse":26,"text":"一方、少年サムエルはすくすくと育ち、主にも人々にも喜ばれる者となった。","tok":[["一方","いっぽう"],["、"],["少年","しょうねん"],["サムエル"],["は"],["すくすく"],["と"],["育ち","そだち"],["、"],["主に","おもに"],["も"],["人々","ひとびと"],["に"],["も"],["喜ばれる","よろこばれる"],["者","もの"],["と"],["なった"],["。"]]},{"verse":27,"text":"神の人がエリのもとに来て告げた。「主はこう言われる。あなたの先祖がエジプトでファラオの家に服従していたとき、わたしは自らをあなたの先祖に明らかに示し、","tok":[["神","かみ"],["の"],["人","ひと"],["が"],["エリ"],["の"],["もと"],["に"],["来て","きて"],["告げた","つげた"],["。"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["あなた"],["の"],["先祖","せんぞ"],["が"],["エジプト"],["で"],["ファラオ"],["の"],["家","いえ"],["に"],["服従","ふくじゅう"],["して"],["いた"],["とき"],["、"],["わたし"],["は"],["自ら","みずから"],["を"],["あなた"],["の"],["先祖","せんぞ"],["に"],["明らか","あきらか"],["に"],["示し","しめし"],["、"]]},{"verse":28,"text":"わたしのためにイスラエルの全部族の中からあなたの先祖を選んで祭司とし、わたしの祭壇に上って香をたかせ、エフォドを着せてわたしの前に立たせた。また、わたしはあなたの先祖の家に、イスラエルの子らが燃やして主にささげる物をすべて与えた。","tok":[["わたし"],["の"],["ため"],["に"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["の"],["中","なか"],["から"],["あなた"],["の"],["先祖","せんぞ"],["を"],["選んで","えらんで"],["祭司","さいし"],["と"],["し"],["、"],["わたし"],["の"],["祭壇","さいだん"],["に"],["上って","のぼって"],["香","こう"],["を"],["たかせ"],["、"],["エフォド"],["を"],["着せて","きせて"],["わたし"],["の"],["前","まえ"],["に"],["立たせた","たたせた"],["。"],["また"],["、"],["わたし"],["は"],["あなた"],["の"],["先祖","せんぞ"],["の"],["家","いえ"],["に"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["が"],["燃やして","もやして"],["主に","おもに"],["ささげる"],["物","もの"],["を"],["すべて"],["与えた","あたえた"],["。"]]},{"verse":29,"text":"あなたはなぜ、わたしが命じたいけにえと献げ物をわたしの住む所でないがしろにするのか。なぜ、自分の息子をわたしよりも大事にして、わたしの民イスラエルが供えるすべての献げ物の中から最上のものを取って、自分たちの私腹を肥やすのか。","tok":[["あなた"],["は"],["なぜ"],["、"],["わたし"],["が"],["命じた","めいじた"],["いけにえ"],["と"],["献げ物","ささげもの"],["を"],["わたし"],["の"],["住む","すむ"],["所","ところ"],["で"],["ないがしろ"],["に"],["する"],["の"],["か"],["。"],["なぜ"],["、"],["自分","じぶん"],["の"],["息子","むすこ"],["を"],["わたし"],["より"],["も"],["大事","だいじ"],["に"],["して"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["が"],["供える","そなえる"],["すべて"],["の"],["献げ物","ささげもの"],["の"],["中","なか"],["から"],["最上","さいじょう"],["の"],["もの"],["を"],["取って","とって"],["、"],["自分","じぶん"],["たち"],["の"],["私腹","しふく"],["を"],["肥やす","こやす"],["の"],["か"],["。"]]},{"verse":30,"text":"それゆえ、イスラエルの神、主は言われる。わたしは確かに、あなたの家とあなたの先祖の家はとこしえにわたしの前に歩む、と約束した。主は言われる。だが、今は決してそうはさせない。わたしを重んずる者をわたしは重んじ、わたしを侮る者をわたしは軽んずる。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["確か","たしか"],["に"],["、"],["あなた"],["の"],["家","いえ"],["と"],["あなた"],["の"],["先祖","せんぞ"],["の"],["家","いえ"],["は"],["とこしえ"],["に"],["わたし"],["の"],["前","まえ"],["に"],["歩む","あゆむ"],["、"],["と"],["約束","やくそく"],["した"],["。"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["だ"],["が"],["、"],["今","いま"],["は"],["決して","けっして"],["そう"],["は"],["させない"],["。"],["わたし"],["を"],["重んずる","おもんずる"],["者","もの"],["を"],["わたし"],["は"],["重んじ","おもんじ"],["、"],["わたし"],["を"],["侮る","あなどる"],["者","もの"],["を"],["わたし"],["は"],["軽んずる","かろんずる"],["。"]]},{"verse":31,"text":"あなたの家に長命の者がいなくなるように、わたしがあなたの腕とあなたの先祖の家の腕を切り落とす日が来る。","tok":[["あなた"],["の"],["家","いえ"],["に"],["長命","ちょうめい"],["の"],["者","もの"],["が"],["いなく"],["なる"],["よう"],["に"],["、"],["わたし"],["が"],["あなた"],["の"],["腕","うで"],["と"],["あなた"],["の"],["先祖","せんぞ"],["の"],["家","いえ"],["の"],["腕","うで"],["を"],["切り落とす","きりおとす"],["日","ひ"],["が"],["来る","くる"],["。"]]},{"verse":32,"text":"あなたは、わたしの住む所がイスラエルに与える幸いをすべて敵視するようになる。あなたの家には永久に長命の者はいなくなる。","tok":[["あなた"],["は"],["、"],["わたし"],["の"],["住む","すむ"],["所","ところ"],["が"],["イスラエル"],["に"],["与える","あたえる"],["幸い","さいわい"],["を"],["すべて"],["敵視","てきし"],["する"],["よう"],["に"],["なる"],["。"],["あなた"],["の"],["家","いえ"],["に"],["は"],["永久","えいきゅう"],["に"],["長命","ちょうめい"],["の"],["者","もの"],["は"],["いなく"],["なる"],["。"]]},{"verse":33,"text":"わたしは、あなたの家の一人だけは、わたしの祭壇から断ち切らないでおく。それはあなたの目をくらまし、命を尽きさせるためだ。あなたの家の男子がどれほど多くとも皆、壮年のうちに死ぬ。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["家","いえ"],["の"],["一人","ひとり"],["だけ"],["は"],["、"],["わたし"],["の"],["祭壇","さいだん"],["から"],["断ち切らないで","たちきらないで"],["おく"],["。"],["それ"],["は"],["あなた"],["の"],["目","め"],["を"],["くらまし"],["、"],["命","いのち"],["を"],["尽きさせる","つきさせる"],["ため"],["だ"],["。"],["あなた"],["の"],["家","いえ"],["の"],["男子","だんし"],["が"],["どれ"],["ほど"],["多く","おおく"],["とも"],["皆","みな"],["、"],["壮年","そうねん"],["の"],["うち"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":34,"text":"あなたの二人の息子ホフニとピネハスの身に起こることが、あなたにとってそのしるしとなる。二人は同じ日に死ぬ。","tok":[["あなた"],["の"],["二人","ふたり"],["の"],["息子","むすこ"],["ホフニ"],["と"],["ピネハス"],["の"],["身","み"],["に"],["起こる","おこる"],["こと"],["が"],["、"],["あなた"],["にとって"],["その"],["しるし"],["と"],["なる"],["。"],["二人","ふたり"],["は"],["同じ","おなじ"],["日","ひ"],["に"],["死ぬ","しぬ"],["。"]]},{"verse":35,"text":"わたしはわたしの心、わたしの望みのままに事を行う忠実な祭司を立て、彼の家を確かなものとしよう。彼は生涯、わたしが油を注いだ者の前を歩む。","tok":[["わたし"],["は"],["わたし"],["の"],["心","こころ"],["、"],["わたし"],["の"],["望み","のぞみ"],["の"],["まま"],["に"],["事","こと"],["を"],["行う","おこなう"],["忠実","ちゅうじつ"],["な"],["祭司","さいし"],["を"],["立て","たて"],["、"],["彼","かれ"],["の"],["家","いえ"],["を"],["確か","たしか"],["な"],["もの"],["と"],["しよう"],["。"],["彼","かれ"],["は"],["生涯","しょうがい"],["、"],["わたし"],["が"],["油","あぶら"],["を"],["注いだ","そそいだ"],["者","もの"],["の"],["前","まえ"],["を"],["歩む","あゆむ"],["。"]]},{"verse":36,"text":"あなたの家の生き残った者は皆、彼のもとに来て身をかがめ、銀一枚、パン一切れを乞い、『一切れのパンでも食べられるように、祭司の仕事の一つに就かせてください』と言うであろう。」","tok":[["あなた"],["の"],["家","いえ"],["の"],["生き残った","いきのこった"],["者","もの"],["は"],["皆","みな"],["、"],["彼","かれ"],["の"],["もと"],["に"],["来て","きて"],["身","み"],["を"],["かがめ"],["、"],["銀","ぎん"],["一枚","いちまい"],["、"],["パン"],["一切れ","ひときれ"],["を"],["乞い","こい"],["、"],["『"],["一切れ","ひときれ"],["の"],["パン"],["で"],["も"],["食べられる","たべられる"],["よう"],["に"],["、"],["祭司","さいし"],["の"],["仕事","しごと"],["の"],["一","ひと"],["つ"],["に"],["就かせて","つかせて"],["ください"],["』"],["と"],["言うで","ゆうで"],["あろう"],["。"],["」"]]}]
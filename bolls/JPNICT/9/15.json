[{"verse":1,"text":"サムエルはサウルに言った。「主はわたしを遣わして、あなたに油を注ぎ、主の民イスラエルの王とされた。今、主が語られる御言葉を聞きなさい。","tok":[["サムエル"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["わたし"],["を"],["遣わして","つかわして"],["、"],["あなた"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["主","ぬし"],["の"],["民","みん"],["イスラエル"],["の"],["王","おう"],["と"],["された"],["。"],["今","いま"],["、"],["主","ぬし"],["が"],["語られる","かたられる"],["御言葉","おことば"],["を"],["聞き","きき"],["なさい"],["。"]]},{"verse":2,"text":"万軍の主はこう言われる。イスラエルがエジプトから上って来る道でアマレクが仕掛けて妨害した行為を、わたしは罰することにした。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["イスラエル"],["が"],["エジプト"],["から"],["上って","のぼって"],["来る","くる"],["道","みち"],["で"],["アマレク"],["が"],["仕掛けて","しかけて"],["妨害","ぼうがい"],["した"],["行為","こうい"],["を"],["、"],["わたし"],["は"],["罰する","ばっする"],["こと"],["に"],["した"],["。"]]},{"verse":3,"text":"行け。アマレクを討ち、アマレクに属するものは一切、滅ぼし尽くせ。男も女も、子供も乳飲み子も、牛も羊も、らくだもろばも打ち殺せ。容赦してはならない。」","tok":[["行け","いけ"],["。"],["アマレク"],["を"],["討ち","うち"],["、"],["アマレク"],["に"],["属する","ぞくする"],["もの"],["は"],["一切","いっさい"],["、"],["滅ぼし","ほろぼし"],["尽くせ","つくせ"],["。"],["男","おとこ"],["も"],["女","おんな"],["も"],["、"],["子供","こども"],["も"],["乳飲み子","ちのみご"],["も"],["、"],["牛","うし"],["も"],["羊","ひつじ"],["も"],["、"],["らくだ"],["も"],["ろば"],["も"],["打ち殺せ","うちころせ"],["。"],["容赦","ようしゃ"],["して"],["は"],["ならない"],["。"],["」"]]},{"verse":4,"text":"サウルは兵士を召集した。テライムで兵士を数えると、歩兵が二十万、ユダの兵は一万であった。","tok":[["サウル"],["は"],["兵士","へいし"],["を"],["召集","しょうしゅう"],["した"],["。"],["テライム"],["で"],["兵士","へいし"],["を"],["数える","かぞえる"],["と"],["、"],["歩兵","ふひょう"],["が"],["二十万","にじゅうまん"],["、"],["ユダ"],["の"],["兵","へい"],["は"],["一万","いちまん"],["で"],["あった"],["。"]]},{"verse":5,"text":"サウルはアマレクの町まで来ると、兵を川岸にとどめた。","tok":[["サウル"],["は"],["アマレク"],["の"],["町","まち"],["まで"],["来る","くる"],["と"],["、"],["兵","へい"],["を"],["川岸","かわぎし"],["に"],["とどめた"],["。"]]},{"verse":6,"text":"サウルはカイン人に言った。「あなたたちはアマレク人のもとを立ち退き、避難してください。イスラエルの人々がエジプトから上って来たとき、親切にしてくださったあなたたちを、アマレク人の巻き添えにしたくありません。」カイン人はアマレク人のもとを立ち退いた。","tok":[["サウル"],["は"],["カイン人","かいんにん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["は"],["アマレク"],["人","にん"],["の"],["もと"],["を"],["立ち退き","たちのき"],["、"],["避難","ひなん"],["して"],["ください"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["エジプト"],["から"],["上って","のぼって"],["来た","きた"],["とき"],["、"],["親切","しんせつ"],["に"],["して"],["くださった"],["あなた"],["たち"],["を"],["、"],["アマレク"],["人","にん"],["の"],["巻き添え","まきぞえ"],["に"],["したく"],["ありません"],["。"],["」"],["カイン人","かいんにん"],["は"],["アマレク"],["人","にん"],["の"],["もと"],["を"],["立ち退いた","たちのいた"],["。"]]},{"verse":7,"text":"サウルはハビラからエジプト国境のシュルに至る地域でアマレク人を討った。","tok":[["サウル"],["は"],["ハビラ"],["から"],["エジプト"],["国境","こっきょう"],["の"],["シュル"],["に"],["至る","いたる"],["地域","ちいき"],["で"],["アマレク"],["人","にん"],["を"],["討った","うった"],["。"]]},{"verse":8,"text":"アマレクの王アガグを生け捕りにし、その民をことごとく剣にかけて滅ぼした。","tok":[["アマレク"],["の"],["王","おう"],["アガグ"],["を"],["生け捕り","いけどり"],["に"],["し"],["、"],["その"],["民","たみ"],["を"],["ことごとく"],["剣","けん"],["に"],["かけて"],["滅ぼした","ほろぼした"],["。"]]},{"verse":9,"text":"しかしサウルと兵士は、アガグ、および羊と牛の最上のもの、初子ではない肥えた動物、小羊、その他何でも上等なものは惜しんで滅ぼし尽くさず、つまらない、値打ちのないものだけを滅ぼし尽くした。","tok":[["しかし"],["サウル"],["と"],["兵士","へいし"],["は"],["、"],["アガグ"],["、"],["および"],["羊","ひつじ"],["と"],["牛","うし"],["の"],["最上","さいじょう"],["の"],["もの"],["、"],["初子","ういご"],["で"],["は"],["ない"],["肥えた","こえた"],["動物","どうぶつ"],["、"],["小羊","こひつじ"],["、"],["その"],["他","た"],["何","なん"],["で"],["も"],["上等","じょうとう"],["な"],["もの"],["は"],["惜しんで","おしんで"],["滅ぼし","ほろぼし"],["尽くさず","つくさず"],["、"],["つまらない"],["、"],["値打ち","ねうち"],["の"],["ない"],["もの"],["だけ"],["を"],["滅ぼし","ほろぼし"],["尽くした","つくした"],["。"]]},{"verse":10,"text":"主の言葉がサムエルに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["サムエル"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":11,"text":"「わたしはサウルを王に立てたことを悔やむ。彼はわたしに背を向け、わたしの命令を果たさない。」サムエルは深く心を痛め、夜通し主に向かって叫んだ。","tok":[["「"],["わたし"],["は"],["サウル"],["を"],["王","おう"],["に"],["立てた","たてた"],["こと"],["を"],["悔やむ","くやむ"],["。"],["彼","かれ"],["は"],["わたし"],["に"],["背","せ"],["を"],["向け","むけ"],["、"],["わたし"],["の"],["命令","めいれい"],["を"],["果たさない","はたさない"],["。"],["」"],["サムエル"],["は"],["深く","ふかく"],["心","こころ"],["を"],["痛め","いため"],["、"],["夜通し","よどおし"],["主に","おもに"],["向かって","むかって"],["叫んだ","さけんだ"],["。"]]},{"verse":12,"text":"朝早く、サムエルが起きて、サウルに会おうとすると、「サウルはカルメルに行って自分のために戦勝碑を建て、そこからギルガルに向かって下った」との知らせが届いた。","tok":[["朝","あさ"],["早く","はやく"],["、"],["サムエル"],["が"],["起きて","おきて"],["、"],["サウル"],["に"],["会おう","あおう"],["と"],["する"],["と"],["、"],["「"],["サウル"],["は"],["カルメル"],["に"],["行って","いって"],["自分","じぶん"],["の"],["ため"],["に"],["戦勝","せんしょう"],["碑","ひ"],["を"],["建て","たて"],["、"],["そこ"],["から"],["ギルガル"],["に"],["向かって","むかって"],["下った","くだった"],["」"],["と"],["の"],["知らせ","しらせ"],["が"],["届いた","とどいた"],["。"]]},{"verse":13,"text":"サムエルがサウルのもとに行くと、サウルは彼に言った。「主の御祝福があなたにありますように。わたしは主の御命令を果たしました。」","tok":[["サムエル"],["が"],["サウル"],["の"],["もと"],["に"],["行く","いく"],["と"],["、"],["サウル"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["御祝福","ごしゅくふく"],["が"],["あなた"],["に"],["あります"],["よう"],["に"],["。"],["わたし"],["は"],["主","ぬし"],["の"],["御命令","ごめいれい"],["を"],["果たしました","はたしました"],["。"],["」"]]},{"verse":14,"text":"サムエルは言った。「それなら、わたしの耳に入るこの羊の声、わたしの聞くこの牛の声は何なのか。」","tok":[["サムエル"],["は"],["言った","いった"],["。"],["「"],["それ"],["なら"],["、"],["わたし"],["の"],["耳","みみ"],["に"],["入る","はいる"],["この"],["羊","ひつじ"],["の"],["声","こえ"],["、"],["わたし"],["の"],["聞く","きく"],["この"],["牛","うし"],["の"],["声","こえ"],["は"],["何","なん"],["な"],["の"],["か"],["。"],["」"]]},{"verse":15,"text":"サウルは答えた。「兵士がアマレク人のもとから引いて来たのです。彼らはあなたの神、主への供え物にしようと、羊と牛の最上のものを取って置いたのです。ほかのものは滅ぼし尽くしました。」","tok":[["サウル"],["は"],["答えた","こたえた"],["。"],["「"],["兵士","へいし"],["が"],["アマレク"],["人","にん"],["の"],["もと"],["から"],["引いて","ひいて"],["来た","きた"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["へ"],["の"],["供え物","そなえもの"],["に"],["しよう"],["と"],["、"],["羊","ひつじ"],["と"],["牛","うし"],["の"],["最上","さいじょう"],["の"],["もの"],["を"],["取って","とって"],["置いた","おいた"],["の"],["です"],["。"],["ほか"],["の"],["もの"],["は"],["滅ぼし","ほろぼし"],["尽くしました","つくしました"],["。"],["」"]]},{"verse":16,"text":"サムエルはサウルに言った。「やめなさい。あなたに言わねばならないことがある。昨夜、主がわたしに語られたことだ。」サウルは言った。「お話しください。」","tok":[["サムエル"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["やめ"],["なさい"],["。"],["あなた"],["に"],["言わねば","いわねば"],["ならない"],["こと"],["が"],["ある"],["。"],["昨夜","さくや"],["、"],["主","ぬし"],["が"],["わたし"],["に"],["語られた","かたられた"],["こと"],["だ"],["。"],["」"],["サウル"],["は"],["言った","いった"],["。"],["「"],["お話し","おはなし"],["ください"],["。"],["」"]]},{"verse":17,"text":"サムエルは言った。「あなたは、自分自身の目には取るに足らぬ者と映っているかもしれない。しかしあなたはイスラエルの諸部族の頭ではないか。主は油を注いで、あなたをイスラエルの上に王とされたのだ。","tok":[["サムエル"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["の"],["目","め"],["に"],["は"],["取る","とる"],["に"],["足らぬ","たらぬ"],["者","もの"],["と"],["映って","うつって"],["いる"],["か"],["も"],["しれない"],["。"],["しかし"],["あなた"],["は"],["イスラエル"],["の"],["諸","しょ"],["部族","ぶぞく"],["の"],["頭","あたま"],["で"],["は"],["ない"],["か"],["。"],["主","ぬし"],["は"],["油","あぶら"],["を"],["注いで","そそいで"],["、"],["あなた"],["を"],["イスラエル"],["の"],["上","うえ"],["に"],["王","おう"],["と"],["された"],["の"],["だ"],["。"]]},{"verse":18,"text":"主はあなたに出陣を命じ、行って、罪を犯したアマレクを滅ぼし尽くせ、彼らを皆殺しにするまで戦い抜け、と言われた。","tok":[["主","ぬし"],["は"],["あなた"],["に"],["出陣","しゅつじん"],["を"],["命じ","めいじ"],["、"],["行って","いって"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["アマレク"],["を"],["滅ぼし","ほろぼし"],["尽くせ","つくせ"],["、"],["彼","かれ"],["ら"],["を"],["皆殺し","みなごろし"],["に"],["する"],["まで"],["戦い","たたかい"],["抜け","ぬけ"],["、"],["と"],["言われた","いわれた"],["。"]]},{"verse":19,"text":"何故あなたは、主の御声に聞き従わず、戦利品を得ようと飛びかかり、主の目に悪とされることを行ったのか。」","tok":[["何故","なぜ"],["あなた"],["は"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["戦利品","せんりひん"],["を"],["得よう","えよう"],["と"],["飛びかかり","とびかかり"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["の"],["か"],["。"],["」"]]},{"verse":20,"text":"サウルはサムエルに答えた。「わたしは主の御声に聞き従いました。主の御命令どおりに出陣して、アマレクの王アガグを引いて来ましたし、アマレクも滅ぼし尽くしました。","tok":[["サウル"],["は"],["サムエル"],["に"],["答えた","こたえた"],["。"],["「"],["わたし"],["は"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従いました","ききしたがいました"],["。"],["主","ぬし"],["の"],["御命令","ごめいれい"],["どおり"],["に"],["出陣","しゅつじん"],["して"],["、"],["アマレク"],["の"],["王","おう"],["アガグ"],["を"],["引いて","ひいて"],["来ました","きました"],["し"],["、"],["アマレク"],["も"],["滅ぼし","ほろぼし"],["尽くしました","つくしました"],["。"]]},{"verse":21,"text":"兵士が、ギルガルであなたの神、主への供え物にしようと、滅ぼし尽くすべき物のうち、最上の羊と牛を、戦利品の中から取り分けたのです。」","tok":[["兵士","へいし"],["が"],["、"],["ギルガル"],["で"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["へ"],["の"],["供え物","そなえもの"],["に"],["しよう"],["と"],["、"],["滅ぼし","ほろぼし"],["尽くすべき","つくすべき"],["物","もの"],["の"],["うち"],["、"],["最上","さいじょう"],["の"],["羊","ひつじ"],["と"],["牛","うし"],["を"],["、"],["戦利品","せんりひん"],["の"],["中","なか"],["から"],["取り分けた","とりわけた"],["の"],["です"],["。"],["」"]]},{"verse":22,"text":"サムエルは言った。「主が喜ばれるのは焼き尽くす献げ物やいけにえであろうか。むしろ、主の御声に聞き従うことではないか。見よ、聞き従うことはいけにえにまさり耳を傾けることは雄羊の脂肪にまさる。","tok":[["サムエル"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["喜ばれる","よろこばれる"],["の"],["は"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["や"],["いけにえ"],["で"],["あろう"],["か"],["。"],["むしろ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従う","ききしたがう"],["こと"],["で"],["は"],["ない"],["か"],["。"],["見よ","みよ"],["、"],["聞き従う","ききしたがう"],["こと"],["は"],["いけにえ"],["に"],["まさり"],["耳","みみ"],["を"],["傾ける","かたむける"],["こと"],["は"],["雄羊","おひつじ"],["の"],["脂肪","しぼう"],["に"],["まさる"],["。"]]},{"verse":23,"text":"反逆は占いの罪に高慢は偶像崇拝に等しい。主の御言葉を退けたあなたは王位から退けられる。」","tok":[["反逆","はんぎゃく"],["は"],["占い","うらない"],["の"],["罪","つみ"],["に"],["高慢","こうまん"],["は"],["偶像","ぐうぞう"],["崇拝","すうはい"],["に"],["等しい","ひとしい"],["。"],["主","ぬし"],["の"],["御言葉","おことば"],["を"],["退けた","しりぞけた"],["あなた"],["は"],["王位","おうい"],["から"],["退けられる","しりぞけられる"],["。"],["」"]]},{"verse":24,"text":"サウルはサムエルに言った。「わたしは、主の御命令とあなたの言葉に背いて罪を犯しました。兵士を恐れ、彼らの声に聞き従ってしまいました。","tok":[["サウル"],["は"],["サムエル"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["、"],["主","ぬし"],["の"],["御命令","ごめいれい"],["と"],["あなた"],["の"],["言葉","ことば"],["に"],["背いて","そむいて"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["兵士","へいし"],["を"],["恐れ","おそれ"],["、"],["彼","かれ"],["ら"],["の"],["声","こえ"],["に"],["聞き従って","ききしたがって"],["しまいました"],["。"]]},{"verse":25,"text":"どうぞ今、わたしの罪を赦し、わたしと一緒に帰ってください。わたしは、主を礼拝します。」","tok":[["どうぞ"],["今","いま"],["、"],["わたし"],["の"],["罪","つみ"],["を"],["赦し","ゆるし"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["帰って","かえって"],["ください"],["。"],["わたし"],["は"],["、"],["主","ぬし"],["を"],["礼拝","れいはい"],["します"],["。"],["」"]]},{"verse":26,"text":"サムエルはサウルに言った。「あなたと一緒に帰ることはできない。あなたが主の言葉を退けたから、主はあなたをイスラエルの王位から退けられたのだ。」","tok":[["サムエル"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["あなた"],["と"],["一緒","いっしょ"],["に"],["帰る","かえる"],["こと"],["は"],["できない"],["。"],["あなた"],["が"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["退けた","しりぞけた"],["から"],["、"],["主","ぬし"],["は"],["あなた"],["を"],["イスラエル"],["の"],["王位","おうい"],["から"],["退けられた","しりぞけられた"],["の"],["だ"],["。"],["」"]]},{"verse":27,"text":"サムエルが身を翻して立ち去ろうとすると、サウルは彼の上着の裾をつかんだ。上着は裂けた。","tok":[["サムエル"],["が"],["身","み"],["を"],["翻して","ひるがえして"],["立ち去ろう","たちさろう"],["と"],["する"],["と"],["、"],["サウル"],["は"],["彼","かれ"],["の"],["上着","うわぎ"],["の"],["裾","すそ"],["を"],["つかんだ"],["。"],["上着","うわぎ"],["は"],["裂けた","さけた"],["。"]]},{"verse":28,"text":"サムエルは彼に言い渡した。「今日、主はイスラエルの王国をあなたから取り上げ、あなたよりすぐれた隣人にお与えになる。","tok":[["サムエル"],["は"],["彼","かれ"],["に"],["言い渡した","いいわたした"],["。"],["「"],["今日","きょう"],["、"],["主","ぬし"],["は"],["イスラエル"],["の"],["王国","おうこく"],["を"],["あなた"],["から"],["取り上げ","とりあげ"],["、"],["あなた"],["より"],["すぐれた"],["隣人","りんじん"],["に"],["お与え","おあたえ"],["に"],["なる"],["。"]]},{"verse":29,"text":"イスラエルの栄光である神は、偽ったり気が変わったりすることのない方だ。この方は人間のように気が変わることはない。」","tok":[["イスラエル"],["の"],["栄光","えいこう"],["で"],["ある"],["神","かみ"],["は"],["、"],["偽っ","いつわっ"],["たり"],["気","き"],["が"],["変わっ","かわっ"],["たり"],["する"],["こと"],["の"],["ない"],["方","ほう"],["だ"],["。"],["この"],["方","かた"],["は"],["人間","にんげん"],["の"],["よう"],["に"],["気","き"],["が"],["変わる","かわる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":30,"text":"サウルは言った。「わたしは罪を犯しました。しかし、民の長老の手前、イスラエルの手前、どうかわたしを立てて、わたしと一緒に帰ってください。そうすれば、あなたの神、主を礼拝します。」","tok":[["サウル"],["は"],["言った","いった"],["。"],["「"],["わたし"],["は"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["しかし"],["、"],["民","みん"],["の"],["長老","ちょうろう"],["の"],["手前","てまえ"],["、"],["イスラエル"],["の"],["手前","てまえ"],["、"],["どう"],["か"],["わたし"],["を"],["立てて","たてて"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["帰って","かえって"],["ください"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["礼拝","れいはい"],["します"],["。"],["」"]]},{"verse":31,"text":"サムエルは彼について帰り、サウルは主を礼拝した。","tok":[["サムエル"],["は"],["彼","かれ"],["について"],["帰り","かえり"],["、"],["サウル"],["は"],["主","ぬし"],["を"],["礼拝","れいはい"],["した"],["。"]]},{"verse":32,"text":"サムエルは命じた。「アマレクの王アガグを、わたしのもとに連れて来なさい。」アガグは、喜んで彼のもとに出て来た。これで死の苦しみは免れる、と思ったからである。","tok":[["サムエル"],["は"],["命じた","めいじた"],["。"],["「"],["アマレク"],["の"],["王","おう"],["アガグ"],["を"],["、"],["わたし"],["の"],["もと"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"],["」"],["アガグ"],["は"],["、"],["喜んで","よろこんで"],["彼","かれ"],["の"],["もと"],["に"],["出て","でて"],["来た","きた"],["。"],["これ"],["で"],["死","し"],["の"],["苦しみ","くるしみ"],["は"],["免れる","まぬがれる"],["、"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"しかし、サムエルは言った。「お前の剣は女たちから子供を奪った。そのようにお前の母も子を奪われた女の一人となる。」こうしてサムエルは、ギルガルで主の御前にアガグを切り殺した。","tok":[["しかし"],["、"],["サムエル"],["は"],["言った","いった"],["。"],["「"],["お前","おまえ"],["の"],["剣","けん"],["は"],["女","おんな"],["たち"],["から"],["子供","こども"],["を"],["奪った","うばった"],["。"],["その"],["よう"],["に"],["お前","おまえ"],["の"],["母","はは"],["も"],["子","こ"],["を"],["奪われた","うばわれた"],["女","おんな"],["の"],["一人","ひとり"],["と"],["なる"],["。"],["」"],["こう"],["して"],["サムエル"],["は"],["、"],["ギルガル"],["で"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["アガグ"],["を"],["切り殺した","きりころした"],["。"]]},{"verse":34,"text":"サムエルはラマに行き、サウルはギブアの自分の家に向かった。","tok":[["サムエル"],["は"],["ラマ"],["に"],["行き","いき"],["、"],["サウル"],["は"],["ギブア"],["の"],["自分","じぶん"],["の"],["家","いえ"],["に"],["向かった","むかった"],["。"]]},{"verse":35,"text":"サムエルは死ぬ日まで、再びサウルに会おうとせず、サウルのことを嘆いた。主はサウルを、イスラエルの上に王として立てたことを悔いられた。","tok":[["サムエル"],["は"],["死ぬ","しぬ"],["日","ひ"],["まで"],["、"],["再び","ふたたび"],["サウル"],["に"],["会おう","あおう"],["と"],["せず"],["、"],["サウル"],["の"],["こと"],["を"],["嘆いた","なげいた"],["。"],["主","ぬし"],["は"],["サウル"],["を"],["、"],["イスラエル"],["の"],["上","うえ"],["に"],["王","おう"],["として"],["立てた","たてた"],["こと"],["を"],["悔いられた","くいられた"],["。"]]}]
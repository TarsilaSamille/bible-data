[{"verse":1,"text":"ジフ人がギブアに来てサウルに、「砂漠の手前、ハキラの丘にダビデが隠れている」と告げた。","tok":[["ジフ人","じふにん"],["が"],["ギブア"],["に"],["来て","きて"],["サウル"],["に"],["、"],["「"],["砂漠","さばく"],["の"],["手前","てまえ"],["、"],["ハキラ"],["の"],["丘","おか"],["に"],["ダビデ"],["が"],["隠れて","かくれて"],["いる"],["」"],["と"],["告げた","つげた"],["。"]]},{"verse":2,"text":"サウルは立ってイスラエルの精鋭三千を率い、ジフの荒れ野に下って行き、ダビデをジフの荒れ野で捜した。","tok":[["サウル"],["は"],["立って","たって"],["イスラエル"],["の"],["精鋭","せいえい"],["三千","さんせん"],["を"],["率い","ひきい"],["、"],["ジフ"],["の"],["荒れ野","あれの"],["に"],["下って","くだって"],["行き","いき"],["、"],["ダビデ"],["を"],["ジフ"],["の"],["荒れ野","あれの"],["で"],["捜した","さがした"],["。"]]},{"verse":3,"text":"サウルは、砂漠の手前、道に沿ったハキラの丘に陣を敷いた。ダビデは荒れ野にとどまっていたが、サウルが彼を追って荒れ野に来たことを知り、","tok":[["サウル"],["は"],["、"],["砂漠","さばく"],["の"],["手前","てまえ"],["、"],["道","みち"],["に"],["沿った","そった"],["ハキラ"],["の"],["丘","おか"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["ダビデ"],["は"],["荒れ野","あれの"],["に"],["とどまって"],["いた"],["が"],["、"],["サウル"],["が"],["彼","かれ"],["を"],["追って","おって"],["荒れ野","あれの"],["に"],["来た","きた"],["こと"],["を"],["知り","しり"],["、"]]},{"verse":4,"text":"斥候を出して、サウルが来たことを確認した。","tok":[["斥候","せっこう"],["を"],["出して","だして"],["、"],["サウル"],["が"],["来た","きた"],["こと"],["を"],["確認","かくにん"],["した"],["。"]]},{"verse":5,"text":"ダビデは立って、サウルが陣を敷いている所に近づき、サウルとサウルの軍の司令官、ネルの子アブネルが寝ている場所を見つけた。サウルは幕営の中で寝ており、兵士がその周りに宿営していた。","tok":[["ダビデ"],["は"],["立って","たって"],["、"],["サウル"],["が"],["陣","じん"],["を"],["敷いて","しいて"],["いる"],["所","ところ"],["に"],["近づき","ちかづき"],["、"],["サウル"],["と"],["サウル"],["の"],["軍","ぐん"],["の"],["司令官","しれいかん"],["、"],["ネル"],["の"],["子","こ"],["アブネル"],["が"],["寝て","ねて"],["いる"],["場所","ばしょ"],["を"],["見つけた","みつけた"],["。"],["サウル"],["は"],["幕営","ばくえい"],["の"],["中","なか"],["で"],["寝て","ねて"],["おり"],["、"],["兵士","へいし"],["が"],["その"],["周り","まわり"],["に"],["宿営","しゅくえい"],["して"],["いた"],["。"]]},{"verse":6,"text":"ダビデは、ヘト人アヒメレクとヨアブの兄弟、ツェルヤの子アビシャイに問いかけた。「サウルの陣地に、わたしと下って行くのは誰だ。」アビシャイが、「わたしがあなたと行きましょう」と答えた。","tok":[["ダビデ"],["は"],["、"],["ヘト人","へとにん"],["アヒメレク"],["と"],["ヨアブ"],["の"],["兄弟","きょうだい"],["、"],["ツェルヤ"],["の"],["子","こ"],["アビシャイ"],["に"],["問いかけた","といかけた"],["。"],["「"],["サウル"],["の"],["陣地","じんち"],["に"],["、"],["わたし"],["と"],["下って","くだって"],["行く","いく"],["の"],["は"],["誰","だれ"],["だ"],["。"],["」"],["アビシャイ"],["が"],["、"],["「"],["わたし"],["が"],["あなた"],["と"],["行きましょう","いきましょう"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":7,"text":"ダビデとアビシャイは夜になって兵士に近寄った。サウルは幕営の中に横になって眠り込んでおり、彼の槍はその枕もとの地面に突き刺してあった。アブネルも兵士もその周りで眠っていた。","tok":[["ダビデ"],["と"],["アビシャイ"],["は"],["夜","よる"],["に"],["なって"],["兵士","へいし"],["に"],["近寄った","ちかよった"],["。"],["サウル"],["は"],["幕営","ばくえい"],["の"],["中","なか"],["に"],["横","よこ"],["に"],["なって"],["眠り込んで","ねむりこんで"],["おり"],["、"],["彼","かれ"],["の"],["槍","やり"],["は"],["その"],["枕もと","まくらもと"],["の"],["地面","じめん"],["に"],["突き刺して","つきさして"],["あった"],["。"],["アブネル"],["も"],["兵士","へいし"],["も"],["その"],["周り","まわり"],["で"],["眠って","ねむって"],["いた"],["。"]]},{"verse":8,"text":"アビシャイはダビデに言った。「神は、今日、敵をあなたの手に渡されました。さあ、わたしに槍の一突きで彼を刺し殺させてください。一度でしとめます。」","tok":[["アビシャイ"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["は"],["、"],["今日","きょう"],["、"],["敵","てき"],["を"],["あなた"],["の"],["手","て"],["に"],["渡されました","わたされました"],["。"],["さあ"],["、"],["わたし"],["に"],["槍","やり"],["の"],["一","いち"],["突き","つき"],["で"],["彼","かれ"],["を"],["刺し殺させて","さしころさせて"],["ください"],["。"],["一度","いちど"],["で"],["しとめます"],["。"],["」"]]},{"verse":9,"text":"ダビデはアビシャイに言った。「殺してはならない。主が油を注がれた方に手をかければ、罰を受けずには済まない。」","tok":[["ダビデ"],["は"],["アビシャイ"],["に"],["言った","いった"],["。"],["「"],["殺して","ころして"],["は"],["ならない"],["。"],["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["方","ほう"],["に"],["手","て"],["を"],["かければ"],["、"],["罰","ばつ"],["を"],["受けず","うけず"],["に"],["は"],["済まない","すまない"],["。"],["」"]]},{"verse":10,"text":"更に言った。「主は生きておられる。主がサウルを打たれるだろう。時が来て死ぬか、戦に出て殺されるかだ。","tok":[["更に","さらに"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["主","ぬし"],["が"],["サウル"],["を"],["打たれるだろう","うたれるだろう"],["。"],["時","じ"],["が"],["来て","きて"],["死ぬ","しぬ"],["か"],["、"],["戦","いくさ"],["に"],["出て","でて"],["殺される","ころされる"],["か"],["だ"],["。"]]},{"verse":11,"text":"主が油を注がれた方に、わたしが手をかけることを主は決してお許しにならない。今は、枕もとの槍と水差しを取って立ち去ろう。」","tok":[["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["方","ほう"],["に"],["、"],["わたし"],["が"],["手","て"],["を"],["かける"],["こと"],["を"],["主","ぬし"],["は"],["決して","けっして"],["お許し","おゆるし"],["に"],["ならない"],["。"],["今","いま"],["は"],["、"],["枕もと","まくらもと"],["の"],["槍","やり"],["と"],["水差し","みずさし"],["を"],["取って","とって"],["立ち去ろう","たちさろう"],["。"],["」"]]},{"verse":12,"text":"ダビデはサウルの枕もとから槍と水差しを取り、彼らは立ち去った。見ていた者も、気づいた者も、目を覚ました者もなかった。主から送られた深い眠りが彼らを襲い、全員眠り込んでいた。","tok":[["ダビデ"],["は"],["サウル"],["の"],["枕もと","まくらもと"],["から"],["槍","やり"],["と"],["水差し","みずさし"],["を"],["取り","とり"],["、"],["彼","かれ"],["ら"],["は"],["立ち去った","たちさった"],["。"],["見て","みて"],["いた"],["者","もの"],["も"],["、"],["気づいた","きづいた"],["者","もの"],["も"],["、"],["目","め"],["を"],["覚ました","さました"],["者","もの"],["も"],["なかった"],["。"],["主","ぬし"],["から"],["送られた","おくられた"],["深い","ふかい"],["眠り","ねむり"],["が"],["彼","かれ"],["ら"],["を"],["襲い","おそい"],["、"],["全員","ぜんいん"],["眠り込んで","ねむりこんで"],["いた"],["。"]]},{"verse":13,"text":"ダビデは向こう側に渡り、遠く離れた山の頂に立った。サウルの陣営との隔たりは大きかった。","tok":[["ダビデ"],["は"],["向こう側","むこうがわ"],["に"],["渡り","わたり"],["、"],["遠く","とおく"],["離れた","はなれた"],["山","やま"],["の"],["頂","いただき"],["に"],["立った","たった"],["。"],["サウル"],["の"],["陣営","じんえい"],["と"],["の"],["隔たり","へだたり"],["は"],["大きかった","おおきかった"],["。"]]},{"verse":14,"text":"ダビデは兵士に向かって、またネルの子アブネルに向かって呼ばわった。「アブネル、答えないのか。」アブネルは答えた。「王に呼ばわるお前は誰だ。」","tok":[["ダビデ"],["は"],["兵士","へいし"],["に"],["向かって","むかって"],["、"],["また"],["ネル"],["の"],["子","こ"],["アブネル"],["に"],["向かって","むかって"],["呼ばわった","よばわった"],["。"],["「"],["アブネル"],["、"],["答えない","こたえない"],["の"],["か"],["。"],["」"],["アブネル"],["は"],["答えた","こたえた"],["。"],["「"],["王","おう"],["に"],["呼ばわる","よばわる"],["お前","おまえ"],["は"],["誰","だれ"],["だ"],["。"],["」"]]},{"verse":15,"text":"ダビデはアブネルに言った。「お前も男だろう。お前に比べられる者は、イスラエルにいない。そのお前が、なぜ自分の主人である王を守れなかったのだ。敵兵が一人、お前の主人である王を殺そうと忍び込んだのだ。","tok":[["ダビデ"],["は"],["アブネル"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["も"],["男","おとこ"],["だろう"],["。"],["お前","おまえ"],["に"],["比べられる","くらべられる"],["者","もの"],["は"],["、"],["イスラエル"],["に"],["いない"],["。"],["その"],["お前","おまえ"],["が"],["、"],["なぜ"],["自分","じぶん"],["の"],["主人","しゅじん"],["で"],["ある"],["王","おう"],["を"],["守れなかった","まもれなかった"],["の"],["だ"],["。"],["敵兵","てきへい"],["が"],["一人","ひとり"],["、"],["お前","おまえ"],["の"],["主人","しゅじん"],["で"],["ある"],["王","おう"],["を"],["殺そう","ころそう"],["と"],["忍び込んだ","しのびこんだ"],["の"],["だ"],["。"]]},{"verse":16,"text":"お前の行いは良くない。主は生きておられる。お前たちは死に値する。主が油を注がれた方、お前たちの主人を守れなかったからだ。さあ、枕もとの槍と水差しがどこにあるか見てみよ。」","tok":[["お前","おまえ"],["の"],["行い","おこない"],["は"],["良く","よく"],["ない"],["。"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["お前","おまえ"],["たち"],["は"],["死に","しに"],["値","あたい"],["する"],["。"],["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["方","かた"],["、"],["お前","おまえ"],["たち"],["の"],["主人","しゅじん"],["を"],["守れなかった","まもれなかった"],["から"],["だ"],["。"],["さあ"],["、"],["枕もと","まくらもと"],["の"],["槍","やり"],["と"],["水差し","みずさし"],["が"],["どこ"],["に"],["ある"],["か"],["見て","みて"],["み"],["よ"],["。"],["」"]]},{"verse":17,"text":"サウルはダビデの声と気づいて、言った。「この声はわが子、ダビデではないか。」ダビデは答えた。「わが主君、王よ。わたしの声です。」","tok":[["サウル"],["は"],["ダビデ"],["の"],["声","こえ"],["と"],["気づいて","きづいて"],["、"],["言った","いった"],["。"],["「"],["この"],["声","こえ"],["は"],["わが"],["子","こ"],["、"],["ダビデ"],["で"],["は"],["ない"],["か"],["。"],["」"],["ダビデ"],["は"],["答えた","こたえた"],["。"],["「"],["わが"],["主君","しゅくん"],["、"],["王","おう"],["よ"],["。"],["わたし"],["の"],["声","こえ"],["です"],["。"],["」"]]},{"verse":18,"text":"ダビデは続けた。「わが主君はなぜわたしを追跡なさるのですか。わたしが何をしたというのでしょう。わたしの手にどんな悪があるというのでしょうか。","tok":[["ダビデ"],["は"],["続けた","つづけた"],["。"],["「"],["わが"],["主君","しゅくん"],["は"],["なぜ"],["わたし"],["を"],["追跡","ついせき"],["なさる"],["の"],["です"],["か"],["。"],["わたし"],["が"],["何","なん"],["を"],["した"],["と"],["いう"],["の"],["でしょう"],["。"],["わたし"],["の"],["手","て"],["に"],["どんな"],["悪","あく"],["が"],["ある"],["と"],["いう"],["の"],["でしょう"],["か"],["。"]]},{"verse":19,"text":"わが主君、王よ。僕の言葉をお聞きください。もし、王がわたしに対して憤られるように仕向けられたのが主であるなら、どうか、主が献げ物によってなだめられますように。もし、人間であるなら、主の御前に彼らが呪われますように。彼らは、『行け、他の神々に仕えよ』と言って、この日、主がお与えくださった嗣業の地からわたしを追い払うのです。","tok":[["わが"],["主君","しゅくん"],["、"],["王","おう"],["よ"],["。"],["僕","ぼく"],["の"],["言葉","ことば"],["を"],["お聞き","おきき"],["ください"],["。"],["もし"],["、"],["王","おう"],["が"],["わたし"],["に対して","にたいして"],["憤ら
[{"verse":1,"text":"ペリシテ軍はイスラエルと戦い、イスラエル兵はペリシテ軍の前から逃げ去り、傷ついた兵士たちがギルボア山上で倒れた。","tok":[["ペリシテ"],["軍","ぐん"],["は"],["イスラエル"],["と"],["戦い","たたかい"],["、"],["イスラエル"],["兵","へい"],["は"],["ペリシテ"],["軍","ぐん"],["の"],["前","まえ"],["から"],["逃げ去り","にげさり"],["、"],["傷ついた","きずついた"],["兵士","へいし"],["たち"],["が"],["ギルボア"],["山","さん"],["上","じょう"],["で"],["倒れた","たおれた"],["。"]]},{"verse":2,"text":"ペリシテ軍はサウルとその息子たちに迫り、サウルの息子ヨナタン、アビナダブ、マルキ‧シュアを討った。","tok":[["ペリシテ"],["軍","ぐん"],["は"],["サウル"],["と"],["その"],["息子","むすこ"],["たち"],["に"],["迫り","せまり"],["、"],["サウル"],["の"],["息子","むすこ"],["ヨナタン"],["、"],["アビナダブ"],["、"],["マルキ"],["‧"],["シュア"],["を"],["討った","うった"],["。"]]},{"verse":3,"text":"サウルに対する攻撃も激しくなり、射手たちがサウルを見つけ、サウルは彼らによって深手を負った。","tok":[["サウル"],["に"],["対する","たいする"],["攻撃","こうげき"],["も"],["激しく","はげしく"],["なり"],["、"],["射手","いて"],["たち"],["が"],["サウル"],["を"],["見つけ","みつけ"],["、"],["サウル"],["は"],["彼","かれ"],["ら"],["によって"],["深手","ふかで"],["を"],["負った","おった"],["。"]]},{"verse":4,"text":"サウルは彼の武器を持つ従卒に命じた。「お前の剣を抜き、わたしを刺し殺してくれ。あの無割礼の者どもに襲われて刺し殺され、なぶりものにされたくない。」だが、従卒は非常に恐れ、そうすることができなかったので、サウルは剣を取り、その上に倒れ伏した。","tok":[["サウル"],["は"],["彼","かれ"],["の"],["武器","ぶき"],["を"],["持つ","もつ"],["従卒","じゅうそつ"],["に"],["命じた","めいじた"],["。"],["「"],["お前","おまえ"],["の"],["剣","けん"],["を"],["抜き","ぬき"],["、"],["わたし"],["を"],["刺し殺して","さしころして"],["くれ"],["。"],["あの"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["ども"],["に"],["襲われて","おそわれて"],["刺し殺され","さしころされ"],["、"],["なぶりもの"],["に"],["されたく"],["ない"],["。"],["」"],["だ"],["が"],["、"],["従卒","じゅうそつ"],["は"],["非常","ひじょう"],["に"],["恐れ","おそれ"],["、"],["そう"],["する"],["こと"],["が"],["できなかった"],["ので"],["、"],["サウル"],["は"],["剣","けん"],["を"],["取り","とり"],["、"],["その"],["上","うえ"],["に"],["倒れ伏した","たおれふした"],["。"]]},{"verse":5,"text":"従卒はサウルが死んだのを見ると、自分も剣の上に倒れ伏してサウルと共に死んだ。","tok":[["従卒","じゅうそつ"],["は"],["サウル"],["が"],["死んだ","しんだ"],["の"],["を"],["見る","みる"],["と"],["、"],["自分","じぶん"],["も"],["剣","けん"],["の"],["上","うえ"],["に"],["倒れ伏して","たおれふして"],["サウル"],["と"],["共","とも"],["に"],["死んだ","しんだ"],["。"]]},{"verse":6,"text":"この同じ日に、サウルとその三人の息子、従卒、更に彼の兵は皆死んだ。","tok":[["この"],["同じ","おなじ"],["日","ひ"],["に"],["、"],["サウル"],["と"],["その"],["三人","さんにん"],["の"],["息子","むすこ"],["、"],["従卒","じゅうそつ"],["、"],["更に","さらに"],["彼","かれ"],["の"],["兵","へい"],["は"],["皆","みな"],["死んだ","しんだ"],["。"]]},{"verse":7,"text":"谷の向こう側と、ヨルダンの向こう側のイスラエル人は、イスラエル兵が逃げ、サウルとその息子たちが死んだのを見ると、町をことごとく捨てて逃げ去ったので、ペリシテ軍が来てそこにとどまった。","tok":[["谷","たに"],["の"],["向こう側","むこうがわ"],["と"],["、"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["の"],["イスラエル"],["人","にん"],["は"],["、"],["イスラエル"],["兵","へい"],["が"],["逃げ","にげ"],["、"],["サウル"],["と"],["その"],["息子","むすこ"],["たち"],["が"],["死んだ","しんだ"],["の"],["を"],["見る","みる"],["と"],["、"],["町","まち"],["を"],["ことごとく"],["捨てて","すてて"],["逃げ去った","にげさった"],["ので"],["、"],["ペリシテ"],["軍","ぐん"],["が"],["来て","きて"],["そこ"],["に"],["とどまった"],["。"]]},{"verse":8,"text":"翌日、戦死者からはぎ取ろうとやって来たペリシテ軍は、サウルとその三人の息子がギルボア山上に倒れているのを見つけた。","tok":[["翌日","よくじつ"],["、"],["戦死者","せんししゃ"],["から"],["はぎ取ろう","はぎとろう"],["と"],["やって"],["来た","きた"],["ペリシテ"],["軍","ぐん"],["は"],["、"],["サウル"],["と"],["その"],["三人","さんにん"],["の"],["息子","むすこ"],["が"],["ギルボア"],["山上","さんじょう"],["に"],["倒れて","たおれて"],["いる"],["の"],["を"],["見つけた","みつけた"],["。"]]},{"verse":9,"text":"彼らはサウルの首を切り落とし、武具を奪った。ペリシテ全土に使者が送られ、彼らの偶像の神殿と民に戦勝が伝えられた。","tok":[["彼","かれ"],["ら"],["は"],["サウル"],["の"],["首","くび"],["を"],["切り落とし","きりおとし"],["、"],["武具","ぶぐ"],["を"],["奪った","うばった"],["。"],["ペリシテ"],["全土","ぜんど"],["に"],["使者","ししゃ"],["が"],["送られ","おくられ"],["、"],["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["の"],["神殿","しんでん"],["と"],["民","たみ"],["に"],["戦勝","せんしょう"],["が"],["伝えられた","つたえられた"],["。"]]},{"verse":10,"text":"彼らはサウルの武具をアシュトレト神殿に納め、その遺体をベト‧シャンの城壁にさらした。","tok":[["彼","かれ"],["ら"],["は"],["サウル"],["の"],["武具","ぶぐ"],["を"],["アシュトレト"],["神殿","しんでん"],["に"],["納め","おさめ"],["、"],["その"],["遺体","いたい"],["を"],["ベト"],["‧"],["シャン"],["の"],["城壁","じょうへき"],["に"],["さらした"],["。"]]},{"verse":11,"text":"ギレアドのヤベシュの住民は、ペリシテ軍のサウルに対する仕打ちを聞いた。","tok":[["ギレアド"],["の"],["ヤベシュ"],["の"],["住民","じゅうみん"],["は"],["、"],["ペリシテ"],["軍","ぐん"],["の"],["サウル"],["に"],["対する","たいする"],["仕打ち","しうち"],["を"],["聞いた","きいた"],["。"]]},{"verse":12,"text":"戦士たちは皆立って、夜通し歩き、サウルとその息子たちの遺体をベト‧シャンの城壁から取り下ろし、ヤベシュに持ち帰って火葬に付し、","tok":[["戦士","せんし"],["たち"],["は"],["皆","みな"],["立って","たって"],["、"],["夜通し","よどおし"],["歩き","あるき"],["、"],["サウル"],["と"],["その"],["息子","むすこ"],["たち"],["の"],["遺体","いたい"],["を"],["ベト"],["‧"],["シャン"],["の"],["城壁","じょうへき"],["から"],["取り下ろし","とりおろし"],["、"],["ヤベシュ"],["に"],["持ち帰って","もちかえって"],["火葬","かそう"],["に"],["付し","ふし"],["、"]]},{"verse":13,"text":"彼らの骨を拾ってヤベシュのぎょりゅうの木の下に葬り、七日間、断食した。","tok":[["彼","かれ"],["ら"],["の"],["骨","ほね"],["を"],["拾って","ひろって"],["ヤベシュ"],["のぎ"],["ょ"],["りゅう"],["の"],["木","き"],["の"],["下","した"],["に"],["葬り","ほうむり"],["、"],["七","なな"],["日間","かかん"],["、"],["断食","だんじき"],["した"],["。"]]}]
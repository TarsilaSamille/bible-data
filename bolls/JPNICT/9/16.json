[{"verse":1,"text":"主はサムエルに言われた。「いつまであなたは、サウルのことを嘆くのか。わたしは、イスラエルを治める王位から彼を退けた。角に油を満たして出かけなさい。あなたをベツレヘムのエッサイのもとに遣わそう。わたしはその息子たちの中に、王となるべき者を見いだした。」","tok":[["主","ぬし"],["は"],["サムエル"],["に"],["言われた","いわれた"],["。"],["「"],["いつ"],["まで"],["あなた"],["は"],["、"],["サウル"],["の"],["こと"],["を"],["嘆く","なげく"],["の"],["か"],["。"],["わたし"],["は"],["、"],["イスラエル"],["を"],["治める","おさめる"],["王位","おうい"],["から"],["彼","かれ"],["を"],["退けた","しりぞけた"],["。"],["角","かど"],["に"],["油","あぶら"],["を"],["満たして","みたして"],["出かけ","でかけ"],["なさい"],["。"],["あなた"],["を"],["ベツレヘム"],["の"],["エッサイ"],["の"],["もと"],["に"],["遣わそう","つかわそう"],["。"],["わたし"],["は"],["その"],["息子","むすこ"],["たち"],["の"],["中","なか"],["に"],["、"],["王","おう"],["と"],["なるべき"],["者","もの"],["を"],["見いだした","みいだした"],["。"],["」"]]},{"verse":2,"text":"サムエルは言った。「どうしてわたしが行けましょうか。サウルが聞けばわたしを殺すでしょう。」主は言われた。「若い雌牛を引いて行き、『主にいけにえをささげるために来ました』と言い、","tok":[["サムエル"],["は"],["言った","いった"],["。"],["「"],["どう"],["して"],["わたし"],["が"],["行けましょう","いけましょう"],["か"],["。"],["サウル"],["が"],["聞けば","きけば"],["わたし"],["を"],["殺すでしょう","ころすでしょう"],["。"],["」"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["若い","わかい"],["雌牛","めうし"],["を"],["引いて","ひいて"],["行き","いき"],["、"],["『"],["主に","おもに"],["いけにえ"],["を"],["ささげる"],["ため"],["に"],["来ました","きました"],["』"],["と"],["言い","いい"],["、"]]},{"verse":3,"text":"いけにえをささげるときになったら、エッサイを招きなさい。なすべきことは、そのときわたしが告げる。あなたは、わたしがそれと告げる者に油を注ぎなさい。」","tok":[["いけにえ"],["を"],["ささげる"],["とき"],["に"],["なったら"],["、"],["エッサイ"],["を"],["招き","まねき"],["なさい"],["。"],["なすべき"],["こと"],["は"],["、"],["その"],["とき"],["わたし"],["が"],["告げる","つげる"],["。"],["あなた"],["は"],["、"],["わたし"],["が"],["それ"],["と"],["告げる","つげる"],["者","もの"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["なさい"],["。"],["」"]]},{"verse":4,"text":"サムエルは主が命じられたとおりにした。彼がベツレヘムに着くと、町の長老は不安げに出迎えて、尋ねた。「おいでくださったのは、平和なことのためでしょうか。」","tok":[["サムエル"],["は"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"],["彼","かれ"],["が"],["ベツレヘム"],["に"],["着く","つく"],["と"],["、"],["町","まち"],["の"],["長老","ちょうろう"],["は"],["不安","ふあん"],["げ"],["に"],["出迎えて","でむかえて"],["、"],["尋ねた","たずねた"],["。"],["「"],["おいで"],["くださった"],["の"],["は"],["、"],["平和","へいわ"],["な"],["こと"],["の"],["ため"],["でしょう"],["か"],["。"],["」"]]},{"verse":5,"text":"「平和なことです。主にいけにえをささげに来ました。身を清めて、いけにえの会食に一緒に来てください。」サムエルはエッサイとその息子たちに身を清めさせ、いけにえの会食に彼らを招いた。","tok":[["「"],["平和","へいわ"],["な"],["こと"],["です"],["。"],["主に","おもに"],["いけにえ"],["を"],["ささげ"],["に"],["来ました","きました"],["。"],["身","み"],["を"],["清めて","きよめて"],["、"],["いけにえ"],["の"],["会食","かいしょく"],["に"],["一緒","いっしょ"],["に"],["来て","きて"],["ください"],["。"],["」"],["サムエル"],["は"],["エッサイ"],["と"],["その"],["息子","むすこ"],["たち"],["に"],["身","み"],["を"],["清めさせ","きよめさせ"],["、"],["いけにえ"],["の"],["会食","かいしょく"],["に"],["彼","かれ"],["ら"],["を"],["招いた","まねいた"],["。"]]},{"verse":6,"text":"彼らがやって来ると、サムエルはエリアブに目を留め、彼こそ主の前に油を注がれる者だ、と思った。","tok":[["彼","かれ"],["ら"],["が"],["やって"],["来る","くる"],["と"],["、"],["サムエル"],["は"],["エリアブ"],["に"],["目","め"],["を"],["留め","とめ"],["、"],["彼","かれ"],["こそ"],["主","ぬし"],["の"],["前","まえ"],["に"],["油","あぶら"],["を"],["注がれる","そそがれる"],["者","もの"],["だ"],["、"],["と"],["思った","おもった"],["。"]]},{"verse":7,"text":"しかし、主はサムエルに言われた。「容姿や背の高さに目を向けるな。わたしは彼を退ける。人間が見るようには見ない。人は目に映ることを見るが、主は心によって見る。」","tok":[["しかし"],["、"],["主","ぬし"],["は"],["サムエル"],["に"],["言われた","いわれた"],["。"],["「"],["容姿","ようし"],["や"],["背","せ"],["の"],["高さ","たかさ"],["に"],["目","め"],["を"],["向ける","むける"],["な"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["退ける","しりぞける"],["。"],["人間","にんげん"],["が"],["見る","みる"],["よう"],["に"],["は"],["見ない","みない"],["。"],["人","ひと"],["は"],["目","め"],["に"],["映る","うつる"],["こと"],["を"],["見る","みる"],["が"],["、"],["主","ぬし"],["は"],["心","こころ"],["によって"],["見る","みる"],["。"],["」"]]},{"verse":8,"text":"エッサイはアビナダブを呼び、サムエルの前を通らせた。サムエルは言った。「この者をも主はお選びにならない。」","tok":[["エッサイ"],["は"],["アビナダブ"],["を"],["呼び","よび"],["、"],["サムエル"],["の"],["前","まえ"],["を"],["通らせた","とおらせた"],["。"],["サムエル"],["は"],["言った","いった"],["。"],["「"],["この"],["者","もの"],["を"],["も"],["主","ぬし"],["は"],["お選び","おえらび"],["に"],["ならない"],["。"],["」"]]},{"verse":9,"text":"エッサイは次に、シャンマを通らせた。サムエルは言った。「この者をも主はお選びにならない。」","tok":[["エッサイ"],["は"],["次","つぎ"],["に"],["、"],["シャンマ"],["を"],["通らせた","とおらせた"],["。"],["サムエル"],["は"],["言った","いった"],["。"],["「"],["この"],["者","もの"],["を"],["も"],["主","ぬし"],["は"],["お選び","おえらび"],["に"],["ならない"],["。"],["」"]]},{"verse":10,"text":"エッサイは七人の息子にサムエルの前を通らせたが、サムエルは彼に言った。「主はこれらの者をお選びにならない。」","tok":[["エッサイ"],["は"],["七人","ななにん"],["の"],["息子","むすこ"],["に"],["サムエル"],["の"],["前","まえ"],["を"],["通らせた","とおらせた"],["が"],["、"],["サムエル"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["これ"],["ら"],["の"],["者","もの"],["を"],["お選び","おえらび"],["に"],["ならない"],["。"],["」"]]},{"verse":11,"text":"サムエルはエッサイに尋ねた。「あなたの息子はこれだけですか。」「末の子が残っていますが、今、羊の番をしています」とエッサイが答えると、サムエルは言った。「人をやって、彼を連れて来させてください。その子がここに来ないうちは、食卓には着きません。」","tok":[["サムエル"],["は"],["エッサイ"],["に"],["尋ねた","たずねた"],["。"],["「"],["あなた"],["の"],["息子","むすこ"],["は"],["これ"],["だけ"],["です"],["か"],["。"],["」"],["「"],["末","まつ"],["の"],["子","こ"],["が"],["残って","のこって"],["います"],["が"],["、"],["今","いま"],["、"],["羊","ひつじ"],["の"],["番","ばん"],["を"],["して"],["います"],["」"],["と"],["エッサイ"],["が"],["答える","こたえる"],["と"],["、"],["サムエル"],["は"],["言った","いった"],["。"],["「"],["人","ひと"],["を"],["やって"],["、"],["彼","かれ"],["を"],["連れて","つれて"],["来させて","きさせて"],["ください"],["。"],["その"],["子","こ"],["が"],["ここ"],["に"],["来ない","こない"],["うち"],["は"],["、"],["食卓","しょくたく"],["に"],["は"],["着きません","つきません"],["。"],["」"]]},{"verse":12,"text":"エッサイは人をやって、その子を連れて来させた。彼は血色が良く、目は美しく、姿も立派であった。主は言われた。「立って彼に油を注ぎなさい。これがその人だ。」","tok":[["エッサイ"],["は"],["人","ひと"],["を"],["やって"],["、"],["その"],["子","こ"],["を"],["連れて","つれて"],["来させた","きさせた"],["。"],["彼","かれ"],["は"],["血色","けっしょく"],["が"],["良く","よく"],["、"],["目","め"],["は"],["美しく","うつくしく"],["、"],["姿","すがた"],["も"],["立派","りっぱ"],["で"],["あった"],["。"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["立って","たって"],["彼","かれ"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["なさい"],["。"],["これ"],["が"],["その"],["人","ひと"],["だ"],["。"],["」"]]},{"verse":13,"text":"サムエルは油の入った角を取り出し、兄弟たちの中で彼に油を注いだ。その日以来、主の霊が激しくダビデに降るようになった。サムエルは立ってラマに帰った。","tok":[["サムエル"],["は"],["油","あぶら"],["の"],["入った","はいった"],["角","かど"],["を"],["取り出し","とりだし"],["、"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["で"],["彼","かれ"],["に"],["油","あぶら"],["を"],["注いだ","そそいだ"],["。"],["その"],["日","ひ"],["以来","いらい"],["、"],["主","ぬし"],["の"],["霊","れい"],["が"],["激しく","はげしく"],["ダビデ"],["に"],["降る","ふる"],["よう"],["に"],["なった"],["。"],["サムエル"],["は"],["立って","たって"],["ラマ"],["に"],["帰った","かえった"],["。"]]},{"verse":14,"text":"主の霊はサウルから離れ、主から来る悪霊が彼をさいなむようになった。","tok":[["主","ぬし"],["の"],["霊","れい"],["は"],["サウル"],["から"],["離れ","はなれ"],["、"],["主","ぬし"],["から"],["来る","くる"],["悪霊","あくりょう"],["が"],["彼","かれ"],["を"],["さいなむ"],["よう"],["に"],["なった"],["。"]]},{"verse":15,"text":"サウルの家臣はサウルに勧めた。「あなたをさいなむのは神からの悪霊でしょう。","tok":[["サウル"],["の"],["家臣","かしん"],["は"],["サウル"],["に"],["勧めた","すすめた"],["。"],["「"],["あなた"],["を"],["さいなむ"],["の"],["は"],["神","かみ"],["から"],["の"],["悪霊","あくりょう"],["でしょう"],["。"]]},{"verse":16,"text":"王様、御前に仕えるこの僕どもにお命じになり、竪琴を上手に奏でる者を探させてください。神からの悪霊が王様を襲うとき、おそばで彼の奏でる竪琴が王様の御気分を良くするでしょう。」","tok":[["王様","おうさま"],["、"],["御前","ごぜん"],["に"],["仕える","つかえる"],["この"],["僕","ぼく"],["ども"],["に"],["お命じ","おめいじ"],["に"],["なり"],["、"],["竪琴","たてごと"],["を"],["上手","じょうず"],["に"],["奏でる","かなでる"],["者","もの"],["を"],["探させて","さがさせて"],["ください"],["。"],["神","かみ"],["から"],["の"],["悪霊","あくりょう"],["が"],["王様","おうさま"],["を"],["襲う","おそう"],["とき"],["、"],["おそば"],["で"],["彼","かれ"],["の"],["奏でる","かなでる"],["竪琴","たてごと"],["が"],["王様","おうさま"],["の"],["御気分","ごきぶん"],["を"],["良く","よく"],["するでしょう"],["。"],["」"]]},{"verse":17,"text":"サウルは家臣に命じた。「わたしのために竪琴の名手を見つけ出して、連れて来なさい。」","tok":[["サウル"],["は"],["家臣","かしん"],["に"],["命じた","めいじた"],["。"],["「"],["わたし"],["の"],["ため"],["に"],["竪琴","たてごと"],["の"],["名手","めいしゅ"],["を"],["見つけ","みつけ"],["出して","だして"],["、"],["連れて","つれて"],["来","き"],["なさい"],["。"],["」"]]},{"verse":18,"text":"従者の一人が答えた。「わたしが会ったベツレヘムの人エッサイの息子は竪琴を巧みに奏でるうえに、勇敢な戦士で、戦術の心得もあり、しかも、言葉に分別があって外見も良く、まさに主が共におられる人です。」","tok":[["従者","じゅうしゃ"],["の"],["一人","ひとり"],["が"],["答えた","こたえた"],["。"],["「"],["わたし"],["が"],["会った","あった"],["ベツレヘム"],["の"],["人","ひと"],["エッサイ"],["の"],["息子","むすこ"],["は"],["竪琴","たてごと"],["を"],["巧み","たくみ"],["に"],["奏でる","かなでる"],["うえ"],["に"],["、"],["勇敢","ゆうかん"],["な"],["戦士","せんし"],["で"],["、"],["戦術","せんじゅつ"],["の"],["心得","こころえ"],["も"],["あり"],["、"],["しかも"],["、"],["言葉",
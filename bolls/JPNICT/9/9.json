[{"verse":1,"text":"ベニヤミン族に一人の男がいた。名をキシュといい、家系をさかのぼると、アビエル、ツェロル、ベコラト、ベニヤミン人のアフィアに至り、勇敢な男であった。","tok":[["ベニヤミン"],["族","ぞく"],["に"],["一人","ひとり"],["の"],["男","おとこ"],["が"],["いた"],["。"],["名","な"],["を"],["キシュ"],["と"],["いい"],["、"],["家系","かけい"],["を"],["さかのぼる"],["と"],["、"],["アビエル"],["、"],["ツェロル"],["、"],["ベコラト"],["、"],["ベニヤミン"],["人","にん"],["の"],["アフィア"],["に"],["至り","いたり"],["、"],["勇敢","ゆうかん"],["な"],["男","おとこ"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼には名をサウルという息子があった。美しい若者で、彼の美しさに及ぶ者はイスラエルにはだれもいなかった。民のだれよりも肩から上の分だけ背が高かった。","tok":[["彼","かれ"],["に"],["は"],["名","な"],["を"],["サウル"],["と"],["いう"],["息子","むすこ"],["が"],["あった"],["。"],["美しい","うつくしい"],["若者","わかもの"],["で"],["、"],["彼","かれ"],["の"],["美し","うつくし"],["さ"],["に"],["及ぶ","およぶ"],["者","もの"],["は"],["イスラエル"],["に"],["は"],["だれ"],["も"],["いなかった"],["。"],["民","たみ"],["の"],["だれ"],["より"],["も"],["肩","かた"],["から"],["上","うえ"],["の"],["分","ぶん"],["だけ"],["背","せ"],["が"],["高かった","たかかった"],["。"]]},{"verse":3,"text":"あるとき、サウルの父キシュのろばが数頭、姿を消した。キシュはその子サウルに言いつけた。「若い者を一人連れて、ろばを捜しに行ってくれ。」","tok":[["ある"],["とき"],["、"],["サウル"],["の"],["父","ちち"],["キシュ"],["の"],["ろば"],["が"],["数頭","すうとう"],["、"],["姿","すがた"],["を"],["消した","けした"],["。"],["キシュ"],["は"],["その"],["子","こ"],["サウル"],["に"],["言いつけた","いいつけた"],["。"],["「"],["若い","わかい"],["者","もの"],["を"],["一人","ひとり"],["連れて","つれて"],["、"],["ろば"],["を"],["捜し","さがし"],["に"],["行って","いって"],["くれ"],["。"],["」"]]},{"verse":4,"text":"彼はエフライムの山地を越え、シャリシャの地を過ぎて行ったが、ろばを見つけ出せず、シャアリムの地を越えてもそこにはおらず、ベニヤミンの地を越えても見つけ出せなかった。","tok":[["彼","かれ"],["は"],["エフライム"],["の"],["山地","さんち"],["を"],["越え","こえ"],["、"],["シャリシャ"],["の"],["地","ち"],["を"],["過ぎて","すぎて"],["行った","いった"],["が"],["、"],["ろば"],["を"],["見つけ","みつけ"],["出せず","だせず"],["、"],["シャアリム"],["の"],["地","ち"],["を"],["越えて","こえて"],["も"],["そこ"],["に"],["は"],["おらず"],["、"],["ベニヤミン"],["の"],["地","ち"],["を"],["越えて","こえて"],["も"],["見つけ","みつけ"],["出せなかった","だせなかった"],["。"]]},{"verse":5,"text":"ツフの地に来たとき、サウルは供の若者に言った。「さあ、もう帰ろう。父が、ろばはともかくとして、わたしたちを気遣うといけない。」","tok":[["ツフ"],["の"],["地","ち"],["に"],["来た","きた"],["とき"],["、"],["サウル"],["は"],["供","とも"],["の"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["もう"],["帰ろう","かえろう"],["。"],["父","ちち"],["が"],["、"],["ろば"],["は"],["ともかく"],["として"],["、"],["わたしたち"],["を"],["気遣う","きづかう"],["と"],["いけない"],["。"],["」"]]},{"verse":6,"text":"若者は答えた。「ちょうどこの町に神の人がおられます。尊敬されている人で、その方のおっしゃることは、何でもそのとおりになります。その方を訪ねてみましょう。恐らくわたしたちの進むべき道について、何か告げてくださるでしょう。」","tok":[["若者","わかもの"],["は"],["答えた","こたえた"],["。"],["「"],["ちょうど"],["この"],["町","まち"],["に"],["神","かみ"],["の"],["人","ひと"],["が"],["おられます"],["。"],["尊敬","そんけい"],["されて"],["いる"],["人","ひと"],["で"],["、"],["その"],["方","かた"],["の"],["おっしゃる"],["こと"],["は"],["、"],["何","なん"],["で"],["も"],["その"],["とおり"],["に"],["なります"],["。"],["その"],["方","ほう"],["を"],["訪ねて","たずねて"],["みましょう"],["。"],["恐らく","おそらく"],["わたしたち"],["の"],["進むべき","すすむべき"],["道","みち"],["について"],["、"],["何","なん"],["か"],["告げて","つげて"],["くださるでしょう"],["。"],["」"]]},{"verse":7,"text":"サウルは若者に言った。「訪ねるとしても、その人に何を持参できよう。袋にパンはもうないし、神の人に持参する手土産はない。何か残っているか。」","tok":[["サウル"],["は"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["訪ねる","たずねる"],["として"],["も"],["、"],["その"],["人","ひと"],["に"],["何","なん"],["を"],["持参","じさん"],["できよう"],["。"],["袋","ふくろ"],["に"],["パン"],["は"],["もう"],["ない"],["し"],["、"],["神","かみ"],["の"],["人","ひと"],["に"],["持参","じさん"],["する"],["手土産","てみやげ"],["は"],["ない"],["。"],["何","なん"],["か"],["残って","のこって"],["いる"],["か"],["。"],["」"]]},{"verse":8,"text":"若者はまたサウルに答えて言った。「御覧ください。ここに四分の一シェケルの銀があります。これを神の人に差し上げて、どうしたらよいのか教えていただきましょう。」","tok":[["若者","わかもの"],["は"],["また"],["サウル"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["御覧","ごらん"],["ください"],["。"],["ここ"],["に"],["四分","よんぶん"],["の"],["一","いち"],["シェケル"],["の"],["銀","ぎん"],["が"],["あります"],["。"],["これ"],["を"],["神","かみ"],["の"],["人","ひと"],["に"],["差し上げて","さしあげて"],["、"],["どう"],["したら"],["よい"],["の"],["か"],["教えて","おしえて"],["いただきましょう"],["。"],["」"]]},{"verse":9,"text":"昔、イスラエルでは神託を求めに行くとき、先見者のところへ行くと言った。今日の預言者を昔は先見者と呼んでいた。","tok":[["昔","むかし"],["、"],["イスラエル"],["で"],["は"],["神託","しんたく"],["を"],["求め","もとめ"],["に"],["行く","いく"],["とき"],["、"],["先見者","せんけんしゃ"],["の"],["ところ"],["へ"],["行く","いく"],["と"],["言った","いった"],["。"],["今日","きょう"],["の"],["預言者","よげんしゃ"],["を"],["昔","むかし"],["は"],["先見者","せんけんしゃ"],["と"],["呼んで","よんで"],["いた"],["。"]]},{"verse":10,"text":"サウルは若者に言った。「それはいい。さあ行こう。」彼らは神の人がいる町に向かった。","tok":[["サウル"],["は"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["それ"],["は"],["いい"],["。"],["さあ"],["行こう","いこう"],["。"],["」"],["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["人","ひと"],["が"],["いる"],["町","まち"],["に"],["向かった","むかった"],["。"]]},{"verse":11,"text":"町に通じる坂を上って行くと、水くみに出て来た娘たちに出会った。彼らは彼女たちに尋ねた。「ここに先見者がおられますか。」","tok":[["町","まち"],["に"],["通じる","つうじる"],["坂","さか"],["を"],["上って","のぼって"],["行く","いく"],["と"],["、"],["水くみ","みずくみ"],["に"],["出て","でて"],["来た","きた"],["娘","むすめ"],["たち"],["に"],["出会った","であった"],["。"],["彼","かれ"],["ら"],["は"],["彼女","かのじょ"],["たち"],["に"],["尋ねた","たずねた"],["。"],["「"],["ここ"],["に"],["先見者","せんけんしゃ"],["が"],["おられます"],["か"],["。"],["」"]]},{"verse":12,"text":"娘たちは答えて言った。「はい、おられます。この先です。お急ぎなさい。今日、この町に来られたのです。聖なる高台で民のためにいけにえがささげられるのは今日なのです。","tok":[["娘","むすめ"],["たち"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["はい"],["、"],["おられます"],["。"],["この先","このさき"],["です"],["。"],["お急ぎ","おいそぎ"],["なさい"],["。"],["今日","きょう"],["、"],["この"],["町","まち"],["に"],["来られた","こられた"],["の"],["です"],["。"],["聖","せい"],["なる"],["高台","たかだい"],["で"],["民","たみ"],["の"],["ため"],["に"],["いけにえ"],["が"],["ささげられる"],["の"],["は"],["今日","きょう"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"町に入るとすぐ、あの方に会えるでしょう。あの方は食事のために聖なる高台に上られるところです。人々は、あの方が来られるまでは食べません。あの方がいけにえを祝福してくださるからです。祝福が終わると、招かれた者が食べるのです。今上って行けば、すぐにあの方に会えるでしょう。」","tok":[["町","まち"],["に"],["入る","はいる"],["と"],["すぐ"],["、"],["あの"],["方","かた"],["に"],["会えるでしょう","あえるでしょう"],["。"],["あの"],["方","かた"],["は"],["食事","しょくじ"],["の"],["ため"],["に"],["聖","せい"],["なる"],["高台","たかだい"],["に"],["上られる","のぼられる"],["ところ"],["です"],["。"],["人々","ひとびと"],["は"],["、"],["あの"],["方","ほう"],["が"],["来られる","こられる"],["まで"],["は"],["食べません","たべません"],["。"],["あの"],["方","ほう"],["が"],["いけにえ"],["を"],["祝福","しゅくふく"],["して"],["くださる"],["から"],["です"],["。"],["祝福","しゅくふく"],["が"],["終わる","おわる"],["と"],["、"],["招かれた","まねかれた"],["者","もの"],["が"],["食べる","たべる"],["の"],["です"],["。"],["今上","きんじょう"],["って"],["行けば","いけば"],["、"],["すぐ"],["に"],["あの"],["方","かた"],["に"],["会えるでしょう","あえるでしょう"],["。"],["」"]]},{"verse":14,"text":"二人が町に上り、町の中に入って行こうとしたとき、サムエルも聖なる高台に上ろうと向こうからやって来た。","tok":[["二人","ふたり"],["が"],["町","まち"],["に"],["上り","のぼり"],["、"],["町","まち"],["の"],["中","なか"],["に"],["入って","はいって"],["行こう","いこう"],["と"],["した"],["とき"],["、"],["サムエル"],["も"],["聖","せい"],["なる"],["高台","たかだい"],["に"],["上ろう","のぼろう"],["と"],["向こう","むこう"],["から"],["やって"],["来た","きた"],["。"]]},{"verse":15,"text":"サウルが来る前日、主はサムエルの耳にこう告げておかれた。","tok":[["サウル"],["が"],["来る","くる"],["前日","ぜんじつ"],["、"],["主","ぬし"],["は"],["サムエル"],["の"],["耳","みみ"],["に"],["こう"],["告げて","つげて"],["おかれた"],["。"]]},{"verse":16,"text":"「明日の今ごろ、わたしは一人の男をベニヤミンの地からあなたのもとに遣わす。あなたは彼に油を注ぎ、わたしの民イスラエルの指導者とせよ。この男がわたしの民をペリシテ人の手から救う。民の叫び声はわたしに届いたので、わたしは民を顧みる。」","tok":[["「"],["明日","あす"],["の"],["今ごろ","いまごろ"],["、"],["わたし"],["は"],["一人","ひとり"],["の"],["男","おとこ"],["を"],["ベニヤミン"],["の"],["地","ち"],["から"],["あなた"],["の"],["もと"],["に"],["遣わす","つかわす"],["。"],["あなた"],["は"],["彼","かれ"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["指導者","しどうしゃ"],["と"],["せよ"],["。"],["この"],["男","おとこ"],["が"],["わたし"],["の"],["民","たみ"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["救う","すくう"],["。"],["民","たみ"],["の"],["叫び声","さけびごえ"],["は"],["わたし"],["に"],["届いた","とどいた"],["ので"],["、"],["わたし"],["は"],["民","みん"],["を"],["顧みる","かえりみる"],["。"],["」"]]},{"verse":17,"text":"サムエルがサウルに会うと、主は彼に告げられた。「わたしがあなたに言ったのはこの男のことだ。この男がわたしの民を支配する。」","tok":[["サムエル"],["が"],["サウル"],["に"],["会う","あう"],["と"],["、"],["主","ぬし"],["は"],["彼","かれ"],["に"],["告げられた","つげられた"],["。"],["「"],["わたし"],["が"],["あなた"],["に"],["言った","いった"],["の"],["は"],["この"],["男","おとこ"],["の"],["こと"],["だ"],["。"],["この"],["男","おとこ"],["が"],["わたし"],["の"],["民","たみ"],["を"],["支配","しはい"],["する"],["。"],["」"]]},{"verse":18,"text":"城門の中でサウルはサムエルに近づいて、彼に言った。「お尋ねしますが、先見者の家はどこでしょうか。」","tok":[["城門","じょうもん"],["の"],["中","なか"],["で"],["サウル"],["は"],["サムエル"],["に"],["近づいて","ちかづいて"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["お尋ね","おたずね"],["します"],["が"],["、"],["先見者","せんけんしゃ"],["の"],["家","いえ"],["は"],["どこ"],["でしょう"],["か"],["。"],["」"]]},{"verse":19,"text":"サムエルはサウルに答えた。「わたしが先見者です。先に聖なる高台へ上って行きなさい。今日はわたしと一緒に食事をしてください。明朝、あなたを送り出すとき、あなたの心にかかっていることをすべて説明します。","tok":[["サムエル"],["は"],["サウル"],["に"],["答えた","こたえた"],["。"],["「"],["わたし"],["が"],["先見者","せんけんしゃ"],["です"],["。"],["先","さき"],["に"],["聖","せい"],["なる"],["高台","たかだい"],["へ"],["上って","のぼって"],["行き","いき"],["なさい"],["。"],["今日","きょう"],["は"],["わたし"],["と"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["を"],["して"],["ください"],["。"],["明朝","みょうちょう"],["、"],["あなた"],["を"],["送り出す","おくりだす"],["とき"],["、"],["あなた"],["の"],["心","こころ"],["に"],["かかって"],["いる"],["こと"],["を"],["すべて"],["説明","せつめい"],["します"],["。"]]},{"verse":20,"text":"三日前に姿を消したろばのことは、一切、心にかける必要はありません。もう見つかっています。全イスラエルの期待は誰にかかっているとお思いですか。あなたにです。そして、あなたの父の全家にです。」","tok":[["三日","みっか"],["前","まえ"],["に"],["姿","すがた"],["を"],["消した","けした"],["ろば"],["の"],["こと"],["は"],["、"],["一切","いっさい"],["、"],["心","こころ"],["に"],["かける"],["必要","ひつよう"],["は"],["ありません"],["。"],["もう"],["見つかって","みつかって"],["います"],["。"],["全","ぜん"],["イスラエル"],["の"],["期待","きたい"],["は"],["誰","だれ"],["に"],["かかって"],["いる"],["と"],["お思い","おおもい"],["です"],["か"],["。"],["あなた"],["に"],["です"],["。"],["そして"],["、"],["あなた"],["の"],["父","ちち"],["の"],["全","ぜん"],["家","いえ"],["に"],["です"],["。"],["」"]]},{"verse":21,"text":"サウルは答えて言った。「わたしはイスラエルで最も小さな部族ベニヤミンの者ですし、そのベニヤミンでも最小の一族の者です。どんな理由でわたしにそのようなことを言われるのですか。」","tok":[["サウル"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["わたし"],["は"],["イスラエル"],["で"],["最も","もっとも"],["小さな","ちいさな"],["部族","ぶぞく"],["ベニヤミン"],["の"],["者","もの"],["です"],["し"],["、"],["その"],["ベニヤミン"],["で"],["も"],["最小","さいしょう"],["の"],["一族","いちぞく"],["の"],["者","もの"],["です"],["。"],["どんな"],["理由","りゆう"],["で"],["わたし"],["に"],["その"],["よう"],["な"],["こと"],["を"],["言われる","いわれる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":22,"text":"サムエルはサウルと従者を広間に導き、招かれた人々の上座に席を与えた。三十人ほどの人が招かれていた。","tok":[["サムエル"],["は"],["サウル"],["と"],["従者","じゅうしゃ"],["を"],["広間","ひろま"],["に"],["導き","みちびき"],["、"],["招かれた","まねかれた"],["人々","ひとびと"],["の"],["上座","かみざ"],["に"],["席","せき"],["を"],["与えた","あたえた"],["。"],["三","さん"],["十人","じゅうにん"],["ほど"],["の"],["人","ひと"],["が"],["招かれて","まねかれて"],["いた"],["。"]]},{"verse":23,"text":"サムエルは料理人に命じた。「取り分けておくようにと、渡しておいた分を出しなさい。」","tok":[["サムエル"],["は"],["料理人","りょうりにん"],["に"],["命じた","めいじた"],["。"],["「"],["取り分けて","とりわけて"],["おく"],["よう"],["に"],["と"],["、"],["渡して","わたして"],["おいた"],["分","ぶん"],["を"],["出し","だし"],["なさい"],["。"],["」"]]},{"verse":24,"text":"料理人は腿肉と脂尾を取り出し、サウルの前に差し出した。サムエルは言った。「お出ししたのは取り分けておいたものです。取っておあがりなさい。客人をお呼びしてあると人々に言って、この時まであなたに取っておきました。」この日、サウルはサムエルと共に食事をした。","tok":[["料理人","りょうりにん"],["は"],["腿肉","ももにく"],["と"],["脂","あぶら"],["尾","お"],["を"],["取り出し","とりだし"],["、"],["サウル"],["の"],["前","まえ"],["に"],["差し出した","さしだした"],["。"],["サムエル"],["は"],["言った","いった"],["。"],["「"],["お出し","おだし"],["した"],["の"],["は"],["取り分けて","とりわけて"],["おいた"],["もの"],["です"],["。"],["取って","とって"],["おあがり"],["なさい"],["。"],["客人","きゃくじん"],["を"],["お"],["呼び","よび"],["して"],["ある"],["と"],["人々","ひとびと"],["に"],["言って","いって"],["、"],["この"],["時","とき"],["まで"],["あなた"],["に"],["取って","とって"],["おきました"],["。"],["」"],["この"],["日","ひ"],["、"],["サウル"],["は"],["サムエル"],["と"],["共","とも"],["に"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":25,"text":"聖なる高台から町に下ると、サムエルはサウルと屋上で話し合った。","tok":[["聖","せい"],["なる"],["高台","たかだい"],["から"],["町","まち"],["に"],["下る","くだる"],["と"],["、"],["サムエル"],["は"],["サウル"],["と"],["屋上","おくじょう"],["で"],["話し合った","はなしあった"],["。"]]},{"verse":26,"text":"彼らは朝早く起きた。夜が明けると、サムエルは屋上のサウルを呼んで言った。「起きなさい。お見送りします。」サウルは起きて、サムエルと一緒に外に出た。","tok":[["彼","かれ"],["ら"],["は"],["朝","あさ"],["早く","はやく"],["起きた","おきた"],["。"],["夜","よる"],["が"],["明ける","あける"],["と"],["、"],["サムエル"],["は"],["屋上","おくじょう"],["の"],["サウル"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["起き","おき"],["なさい"],["。"],["お見送り","おみおくり"],["します"],["。"],["」"],["サウル"],["は"],["起きて","おきて"],["、"],["サムエル"],["と"],["一緒","いっしょ"],["に"],["外","そと"],["に"],["出た","でた"],["。"]]},{"verse":27,"text":"町外れまで下って来ると、サムエルはサウルに言った。「従者に、我々より先に行くよう命じ、あなたはしばらくここにいてください。神の言葉をあなたにお聞かせします。」従者は先に行った。","tok":[["町外れ","まちはずれ"],["まで"],["下って","くだって"],["来る","くる"],["と"],["、"],["サムエル"],["は"],["
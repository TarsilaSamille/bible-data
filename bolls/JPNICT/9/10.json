[{"verse":1,"text":"サムエルは油の壺を取り、サウルの頭に油を注ぎ、彼に口づけして、言った。「主があなたに油を注ぎ、御自分の嗣業の民の指導者とされたのです。","tok":[["サムエル"],["は"],["油","あぶら"],["の"],["壺","つぼ"],["を"],["取り","とり"],["、"],["サウル"],["の"],["頭","あたま"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["彼","かれ"],["に"],["口づけ","くちづけ"],["して"],["、"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["あなた"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["御自分","ごじぶん"],["の"],["嗣業","しぎょう"],["の"],["民","たみ"],["の"],["指導者","しどうしゃ"],["と"],["された"],["の"],["です"],["。"]]},{"verse":2,"text":"今日、あなたがわたしのもとを去って行くと、ベニヤミン領のツェルツァにあるラケルの墓の脇で二人の男に出会います。二人はあなたに言うでしょう。『あなたが見つけようと出かけて行ったろばは見つかりました。父上はろばのことは忘れ、専らあなたたちのことを気遣って、息子のためにどうしたらよいか、とおっしゃっています。』","tok":[["今日","きょう"],["、"],["あなた"],["が"],["わたし"],["の"],["もと"],["を"],["去って","さって"],["行く","いく"],["と"],["、"],["ベニヤミン"],["領","りょう"],["の"],["ツェルツァ"],["に"],["ある"],["ラケル"],["の"],["墓","はか"],["の"],["脇","わき"],["で"],["二人","ふたり"],["の"],["男","おとこ"],["に"],["出会います","であいます"],["。"],["二人","ふたり"],["は"],["あなた"],["に"],["言うでしょう","ゆうでしょう"],["。"],["『"],["あなた"],["が"],["見つけよう","みつけよう"],["と"],["出かけて","でかけて"],["行ったろば","いったろば"],["は"],["見つかりました","みつかりました"],["。"],["父上","ちちじょう"],["は"],["ろば"],["の"],["こと"],["は"],["忘れ","わすれ"],["、"],["専ら","もっぱら"],["あなた"],["たち"],["の"],["こと"],["を"],["気遣って","きづかって"],["、"],["息子","むすこ"],["の"],["ため"],["に"],["どう"],["したら"],["よい"],["か"],["、"],["と"],["おっしゃって"],["います"],["。"],["』"]]},{"verse":3,"text":"また、そこから更に進み、タボルの樫の木まで行くと、そこで、ベテルに神を拝みに上る三人の男に出会います。一人は子山羊三匹を連れ、一人はパン三個を持ち、一人はぶどう酒一袋を持っています。","tok":[["また"],["、"],["そこ"],["から"],["更に","さらに"],["進み","すすみ"],["、"],["タボル"],["の"],["樫","かし"],["の"],["木","き"],["まで"],["行く","いく"],["と"],["、"],["そこ"],["で"],["、"],["ベテル"],["に"],["神","かみ"],["を"],["拝み","おがみ"],["に"],["上る","のぼる"],["三人","さんにん"],["の"],["男","おとこ"],["に"],["出会います","であいます"],["。"],["一人","ひとり"],["は"],["子山羊","こやぎ"],["三匹","さんひき"],["を"],["連れ","つれ"],["、"],["一人","ひとり"],["は"],["パン"],["三個","さんこ"],["を"],["持ち","もち"],["、"],["一人","ひとり"],["は"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["袋","ふくろ"],["を"],["持って","もって"],["います"],["。"]]},{"verse":4,"text":"あなたに挨拶し、二個のパンをくれますから、彼らの手から受け取りなさい。","tok":[["あなた"],["に"],["挨拶","あいさつ"],["し"],["、"],["二個","にこ"],["の"],["パン"],["を"],["くれます"],["から"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["受け取り","うけとり"],["なさい"],["。"]]},{"verse":5,"text":"それから、ペリシテ人の守備隊がいるギブア‧エロヒムに向かいなさい。町に入るとき、琴、太鼓、笛、竪琴を持った人々を先頭にして、聖なる高台から下って来る預言者の一団に出会います。彼らは預言する状態になっています。","tok":[["それ"],["から"],["、"],["ペリシテ"],["人","にん"],["の"],["守備隊","しゅびたい"],["が"],["いる"],["ギブア"],["‧"],["エロヒム"],["に"],["向かい","むかい"],["なさい"],["。"],["町","まち"],["に"],["入る","はいる"],["とき"],["、"],["琴","こと"],["、"],["太鼓","たいこ"],["、"],["笛","ふえ"],["、"],["竪琴","たてごと"],["を"],["持った","もった"],["人々","ひとびと"],["を"],["先頭","せんとう"],["に"],["して"],["、"],["聖","せい"],["なる"],["高台","たかだい"],["から"],["下って","くだって"],["来る","くる"],["預言者","よげんしゃ"],["の"],["一団","いちだん"],["に"],["出会います","であいます"],["。"],["彼","かれ"],["ら"],["は"],["預言","よげん"],["する"],["状態","じょうたい"],["に"],["なって"],["います"],["。"]]},{"verse":6,"text":"主の霊があなたに激しく降り、あなたも彼らと共に預言する状態になり、あなたは別人のようになるでしょう。","tok":[["主","ぬし"],["の"],["霊","れい"],["が"],["あなた"],["に"],["激しく","はげしく"],["降り","ふり"],["、"],["あなた"],["も"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["預言","よげん"],["する"],["状態","じょうたい"],["に"],["なり"],["、"],["あなた"],["は"],["別人","べつじん"],["の"],["よう"],["に"],["なるでしょう"],["。"]]},{"verse":7,"text":"これらのしるしがあなたに降ったら、しようと思うことは何でもしなさい。神があなたと共におられるのです。","tok":[["これ"],["ら"],["の"],["しるし"],["が"],["あなた"],["に"],["降ったら","ふったら"],["、"],["しよう"],["と"],["思う","おもう"],["こと"],["は"],["何","なん"],["で"],["も"],["し"],["なさい"],["。"],["神","かみ"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられる"],["の"],["です"],["。"]]},{"verse":8,"text":"わたしより先にギルガルに行きなさい。わたしもあなたのもとに行き、焼き尽くす献げ物と、和解の献げ物をささげましょう。わたしが着くまで七日間、待ってください。なすべきことを教えましょう。」","tok":[["わたし"],["より"],["先","さき"],["に"],["ギルガル"],["に"],["行き","いき"],["なさい"],["。"],["わたし"],["も"],["あなた"],["の"],["もと"],["に"],["行き","いき"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["、"],["和解","わかい"],["の"],["献げ物","ささげもの"],["を"],["ささげましょう"],["。"],["わたし"],["が"],["着く","つく"],["まで"],["七","なな"],["日間","かかん"],["、"],["待って","まって"],["ください"],["。"],["なすべき"],["こと"],["を"],["教えましょう","おしえましょう"],["。"],["」"]]},{"verse":9,"text":"サウルがサムエルと別れて帰途についたとき、神はサウルの心を新たにされた。以上のしるしはすべてその日に起こった。","tok":[["サウル"],["が"],["サムエル"],["と"],["別れて","わかれて"],["帰途","きと"],["に"],["ついた"],["とき"],["、"],["神","かみ"],["は"],["サウル"],["の"],["心","こころ"],["を"],["新た","あらた"],["に"],["された"],["。"],["以上","いじょう"],["の"],["しるし"],["は"],["すべて"],["その"],["日","ひ"],["に"],["起こった","おこった"],["。"]]},{"verse":10,"text":"ギブアに入ると、預言者の一団が彼を迎え、神の霊が彼に激しく降り、サウルは彼らのただ中で預言する状態になった。","tok":[["ギブア"],["に"],["入る","はいる"],["と"],["、"],["預言者","よげんしゃ"],["の"],["一団","いちだん"],["が"],["彼","かれ"],["を"],["迎え","むかえ"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["彼","かれ"],["に"],["激しく","はげしく"],["降り","ふり"],["、"],["サウル"],["は"],["彼","かれ"],["ら"],["の"],["ただ中","ただなか"],["で"],["預言","よげん"],["する"],["状態","じょうたい"],["に"],["なった"],["。"]]},{"verse":11,"text":"以前からサウルを知っていた者はだれでも、彼が預言者と一緒になって預言するのを見て、互いに言った。「キシュの息子に何が起こったのだ。サウルもまた預言者の仲間か。」","tok":[["以前","いぜん"],["から"],["サウル"],["を"],["知って","しって"],["いた"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["彼","かれ"],["が"],["預言者","よげんしゃ"],["と"],["一緒","いっしょ"],["に"],["なって"],["預言","よげん"],["する"],["の"],["を"],["見て","みて"],["、"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["キシュ"],["の"],["息子","むすこ"],["に"],["何","なん"],["が"],["起こった","おこった"],["の"],["だ"],["。"],["サウル"],["も"],["また"],["預言者","よげんしゃ"],["の"],["仲間","なかま"],["か"],["。"],["」"]]},{"verse":12,"text":"そこにいた一人がそれを受けて言った。「この人たちの父は一体誰だろう。」こうしてそれは、「サウルもまた預言者の仲間か」ということわざになった。","tok":[["そこ"],["に"],["いた"],["一人","ひとり"],["が"],["それ"],["を"],["受けて","うけて"],["言った","いった"],["。"],["「"],["この"],["人","ひと"],["たち"],["の"],["父","ちち"],["は"],["一体","いったい"],["誰","だれ"],["だろう"],["。"],["」"],["こう"],["して"],["それ"],["は"],["、"],["「"],["サウル"],["も"],["また"],["預言者","よげんしゃ"],["の"],["仲間","なかま"],["か"],["」"],["と"],["いう"],["ことわざ"],["に"],["なった"],["。"]]},{"verse":13,"text":"サウルは預言する状態からさめると、聖なる高台へ行った。","tok":[["サウル"],["は"],["預言","よげん"],["する"],["状態","じょうたい"],["から"],["さめる"],["と"],["、"],["聖","せい"],["なる"],["高台","たかだい"],["へ"],["行った","いった"],["。"]]},{"verse":14,"text":"サウルのおじがサウルと従者に言った。「お前たちはどこへ行っていたのだ。」サウルは答えた。「ろばを捜しに行きましたが、見つからなかったので、サムエルのもとに行きました。」","tok":[["サウル"],["の"],["おじ"],["が"],["サウル"],["と"],["従者","じゅうしゃ"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["たち"],["は"],["どこ"],["へ"],["行って","いって"],["いた"],["の"],["だ"],["。"],["」"],["サウル"],["は"],["答えた","こたえた"],["。"],["「"],["ろば"],["を"],["捜し","さがし"],["に"],["行きました","いきました"],["が"],["、"],["見つからなかった","みつからなかった"],["ので"],["、"],["サムエル"],["の"],["もと"],["に"],["行きました","いきました"],["。"],["」"]]},{"verse":15,"text":"サウルのおじは言った。「サムエルがお前たちに何と言ったか、話しなさい。」","tok":[["サウル"],["の"],["おじ"],["は"],["言った","いった"],["。"],["「"],["サムエル"],["が"],["お前","おまえ"],["たち"],["に"],["何","なん"],["と"],["言った","いった"],["か"],["、"],["話し","はなし"],["なさい"],["。"],["」"]]},{"verse":16,"text":"サウルはおじに答えた。「ろばは見つかったと教えてくれました。」だがサウルは、サムエルの語った王位のことについては、おじに話さなかった。","tok":[["サウル"],["は"],["おじ"],["に"],["答えた","こたえた"],["。"],["「"],["ろば"],["は"],["見つかった","みつかった"],["と"],["教えて","おしえて"],["くれました"],["。"],["」"],["だ"],["が"],["サウル"],["は"],["、"],["サムエル"],["の"],["語った","かたった"],["王位","おうい"],["の"],["こと"],["について"],["は"],["、"],["おじ"],["に"],["話さなかった","はなさなかった"],["。"]]},{"verse":17,"text":"サムエルはミツパで主のもとに民を呼び集めた。","tok":[["サムエル"],["は"],["ミツパ"],["で"],["主","ぬし"],["の"],["もと"],["に"],["民","たみ"],["を"],["呼び集めた","よびあつめた"],["。"]]},{"verse":18,"text":"彼はイスラエルの人々に告げた。「イスラエルの神、主は仰せになる。『イスラエルをエジプトから導き上ったのはわたしだ。わたしがあなたたちをエジプトの手から救い出し、あなたたちを圧迫するすべての王国からも救い出した』と。","tok":[["彼","かれ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告げた","つげた"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["仰せ","おおせ"],["に"],["なる"],["。"],["『"],["イスラエル"],["を"],["エジプト"],["から"],["導き","みちびき"],["上った","のぼった"],["の"],["は"],["わたし"],["だ"],["。"],["わたし"],["が"],["あなた"],["たち"],["を"],["エジプト"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"],["あなた"],["たち"],["を"],["圧迫","あっぱく"],["する"],["すべて"],["の"],["王国","おうこく"],["から"],["も"],["救い出した","すくいだした"],["』"],["と"],["。"]]},{"verse":19,"text":"しかし、あなたたちは今日、あらゆる災難や苦難からあなたたちを救われたあなたたちの神を退け、『我らの上に王を立ててください』と主に願っている。よろしい、部族ごと、氏族ごとに主の御前に出なさい。」","tok":[["しかし"],["、"],["あなた"],["たち"],["は"],["今日","きょう"],["、"],["あらゆる"],["災難","さいなん"],["や"],["苦難","くなん"],["から"],["あなた"],["たち"],["を"],["救われた","すくわれた"],["あなた"],["たち"],["の"],["神","かみ"],["を"],["退け","しりぞけ"],["、"],["『"],["我","われ"],["ら"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立てて","たてて"],["ください"],["』"],["と"],["主に","おもに"],["願って","ねがって"],["いる"],["。"],["よろしい"],["、"],["部族","ぶぞく"],["ごと"],["、"],["氏族","しぞく"],["ごと"],["に"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["出","で"],["なさい"],["。"],["」"]]},{"verse":20,"text":"サムエルはイスラエルの全部族を呼び寄せた。ベニヤミン族がくじで選び出された。","tok":[["サムエル"],["は"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["を"],["呼び寄せた","よびよせた"],["。"],["ベニヤミン"],["族","ぞく"],["が"],["くじ"],["で"],["選び出された","えらびだされた"],["。"]]},{"verse":21,"text":"そこでベニヤミン族を氏族ごとに呼び寄せた。マトリの氏族がくじで選び出され、次にキシュの息子サウルがくじで選び出された。人々は彼を捜したが、見つからなかった。","tok":[["そこ"],["で"],["ベニヤミン"],["族","ぞく"],["を"],["氏族","しぞく"],["ごと"],["に"],["呼び寄せた","よびよせた"],["。"],["マトリ"],["の"],["氏族","しぞく"],["が"],["くじ"],["で"],["選び出され","えらびだされ"],["、"],["次","つぎ"],["に"],["キシュ"],["の"],["息子","むすこ"],["サウル"],["が"],["くじ"],["で"],["選び出された","えらびだされた"],["。"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["捜した","さがした"],["が"],["、"],["見つからなかった","みつからなかった"],["。"]]},{"verse":22,"text":"そこで、主に伺いを立てた。「その人はここに来ているのですか。」主は答えられた。「見よ、彼は荷物の間に隠れている。」","tok":[["そこ"],["で"],["、"],["主に","おもに"],["伺い","うかがい"],["を"],["立てた","たてた"],["。"],["「"],["その"],["人","ひと"],["は"],["ここ"],["に"],["来て","きて"],["いる"],["の"],["です"],["か"],["。"],["」"],["主","ぬし"],["は"],["答えられた","こたえられた"],["。"],["「"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["荷物","にもつ"],["の"],["間","あいだ"],["に"],["隠れて","かくれて"],["いる"],["。"],["」"]]},{"verse":23,"text":"人々は走って行き、そこから彼を連れて来た。サウルが民の真ん中に立つと、民のだれよりも肩から上の分だけ背が高かった。","tok":[["人々","ひとびと"],["は"],["走って","はしって"],["行き","いき"],["、"],["そこ"],["から"],["彼","かれ"],["を"],["連れて","つれて"],["来た","きた"],["。"],["サウル"],["が"],["民","たみ"],["の"],["真ん中","まんなか"],["に"],["立つ","たつ"],["と"],["、"],["民","みん"],["の"],["だれ"],["より"],["も"],["肩","かた"],["から"],["上","うえ"],["の"],["分","ぶん"],["だけ"],["背","せ"],["が"],["高かった","たかかった"],["。"]]},{"verse":24,"text":"サムエルは民全体に言った。「見るがいい、主が選ばれたこの人を。民のうちで彼に及ぶ者はいない。」民は全員、喜び叫んで言った。「王様万歳。」","tok":[["サムエル"],["は"],["民","みん"],["全体","ぜんたい"],["に"],["言った","いった"],["。"],["「"],["見る","みる"],["が"],["いい"],["、"],["主","ぬし"],["が"],["選ばれた","えらばれた"],["この"],["人","ひと"],["を"],["。"],["民","たみ"],["の"],["うち"],["で"],["彼","かれ"],["に"],["及ぶ","およぶ"],["者","もの"],["は"],["いない"],["。"],["」"],["民","みん"],["は"],["全員","ぜんいん"],["、"],["喜び叫んで","よろこびさけんで"],["言った","いった"],["。"],["「"],["王様","おうさま"],["万歳","ばんざい"],["。"],["」"]]},{"verse":25,"text":"サムエルは民に王の権能について話し、それを書に記して主の御前に納めた。それから、サムエルはすべての民をそれぞれの家に帰した。","tok":[["サムエル"],["は"],["民","みん"],["に"],["王","おう"],["の"],["権能","けんのう"],["について"],["話し","はなし"],["、"],["それ"],["を"],["書","しょ"],["に"],["記して","しるして"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["納めた","おさめた"],["。"],["それ"],["から"],["、"],["サムエル"],["は"],["すべて"],["の"],["民","たみ"],["を"],["それぞれ"],["の"],["家","いえ"],["に"],["帰した","かえした"],["。"]]},{"verse":26,"text":"サウルもギブアの自分の家に向かった。神に心を動かされた勇士たちは、サウルに従った。","tok":[["サウル"],["も"],["ギブア"],["の"],["自分","じぶん"],["の"],["家","いえ"],["に"],["向かった","むかった"],["。"],["神","かみ"],["に"],["心","こころ"],["を"],["動かされた","うごかされた"],["勇士","ゆうし"],["たち"],["は"],["、"],["サウル"],["に"],["従った","したがった"],["。"]]},{"verse":27,"text":"しかしならず者は、「こんな男に我々が救えるか」と言い合って彼を侮り、贈り物を持って行かなかった。だがサウルは何も言わなかった。","tok":[["しかし"],["ならず者","ならずもの"],["は"],["、"],["「"],["こんな"],["男","おとこ"],["に"],["我々","われわれ"],["が"],["救える","すくえる"],["か"],["」"],["と"],["言い合って","いいあって"],["彼","かれ"],["を"],["侮り","あなどり"],["、"],["贈り物","おくりもの"],["を"],["持って","もって"],["行かなかった","いかなかった"],["。"],["だ"],["が"],["サウル"],["は"],["何","なん"],["も"],["言わなかった","いわなかった"],["。"]]}]
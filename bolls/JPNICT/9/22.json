[{"verse":1,"text":"ダビデはそこを出て、アドラムの洞窟に難を避けた。それを聞いた彼の兄弟や父の家の者は皆、彼のもとに下って来た。","tok":[["ダビデ"],["は"],["そこ"],["を"],["出て","でて"],["、"],["アドラム"],["の"],["洞窟","どうくつ"],["に"],["難","なん"],["を"],["避けた","さけた"],["。"],["それ"],["を"],["聞いた","きいた"],["彼","かれ"],["の"],["兄弟","きょうだい"],["や"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["は"],["皆","みな"],["、"],["彼","かれ"],["の"],["もと"],["に"],["下って","くだって"],["来た","きた"],["。"]]},{"verse":2,"text":"また、困窮している者、負債のある者、不満を持つ者も皆彼のもとに集まり、ダビデは彼らの頭領になった。四百人ほどの者が彼の周りにいた。","tok":[["また"],["、"],["困窮","こんきゅう"],["して"],["いる"],["者","もの"],["、"],["負債","ふさい"],["の"],["ある"],["者","もの"],["、"],["不満","ふまん"],["を"],["持つ","もつ"],["者","もの"],["も"],["皆","みな"],["彼","かれ"],["の"],["もと"],["に"],["集まり","あつまり"],["、"],["ダビデ"],["は"],["彼","かれ"],["ら"],["の"],["頭領","とうりょう"],["に"],["なった"],["。"],["四百人","よんひゃくにん"],["ほど"],["の"],["者","もの"],["が"],["彼","かれ"],["の"],["周り","まわり"],["に"],["いた"],["。"]]},{"verse":3,"text":"ダビデはモアブのミツパに行き、モアブの王に頼んだ。「神がわたしをどのようになさるか分かるまで、わたしの父母をあなたたちのもとに行かせてください。」","tok":[["ダビデ"],["は"],["モアブ"],["の"],["ミツパ"],["に"],["行き","いき"],["、"],["モアブ"],["の"],["王","おう"],["に"],["頼んだ","たのんだ"],["。"],["「"],["神","かみ"],["が"],["わたし"],["を"],["どの"],["よう"],["に"],["なさる"],["か"],["分かる","わかる"],["まで"],["、"],["わたし"],["の"],["父母","ふぼ"],["を"],["あなた"],["たち"],["の"],["もと"],["に"],["行かせて","いかせて"],["ください"],["。"],["」"]]},{"verse":4,"text":"モアブ王に託されたダビデの両親は、ダビデが要害に立てこもっている間、モアブ王のもとにとどまった。","tok":[["モアブ"],["王","おう"],["に"],["託された","たくされた"],["ダビデ"],["の"],["両親","りょうしん"],["は"],["、"],["ダビデ"],["が"],["要害","ようがい"],["に"],["立てこもって","たてこもって"],["いる"],["間","あいだ"],["、"],["モアブ"],["王","おう"],["の"],["もと"],["に"],["とどまった"],["。"]]},{"verse":5,"text":"預言者ガドが、「要害にとどまらず、ユダの地に出て行きなさい」と言ったので、ダビデはハレトの森に移って行った。","tok":[["預言者","よげんしゃ"],["ガド"],["が"],["、"],["「"],["要害","ようがい"],["に"],["とどまらず"],["、"],["ユダ"],["の"],["地","ち"],["に"],["出て","でて"],["行き","いき"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["ダビデ"],["は"],["ハレト"],["の"],["森","もり"],["に"],["移って","うつって"],["行った","いった"],["。"]]},{"verse":6,"text":"サウルは、ダビデとその仲間の者たちが姿を見せたと聞かされた。サウルは、手に槍を持って、ギブアにある丘のぎょりゅうの木陰に座っていた。彼の家臣は皆、傍らに立っていた。","tok":[["サウル"],["は"],["、"],["ダビデ"],["と"],["その"],["仲間","なかま"],["の"],["者","もの"],["たち"],["が"],["姿","すがた"],["を"],["見せた","みせた"],["と"],["聞かされた","きかされた"],["。"],["サウル"],["は"],["、"],["手","て"],["に"],["槍","やり"],["を"],["持って","もって"],["、"],["ギブア"],["に"],["ある"],["丘","おか"],["のぎ"],["ょ"],["りゅう"],["の"],["木陰","こかげ"],["に"],["座って","すわって"],["いた"],["。"],["彼","かれ"],["の"],["家臣","かしん"],["は"],["皆","みな"],["、"],["傍ら","かたわら"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":7,"text":"サウルは傍らに立っている家臣に言った。「ベニヤミンの子らよ、聞くがよい。エッサイの子が、お前たち皆に畑やぶどう畑を与え、皆を千人隊の長や、百人隊の長にするであろうか。","tok":[["サウル"],["は"],["傍ら","かたわら"],["に"],["立って","たって"],["いる"],["家臣","かしん"],["に"],["言った","いった"],["。"],["「"],["ベニヤミン"],["の"],["子","こ"],["ら"],["よ"],["、"],["聞く","きく"],["が"],["よい"],["。"],["エッサイ"],["の"],["子","こ"],["が"],["、"],["お前","おまえ"],["たち"],["皆","みな"],["に"],["畑","はたけ"],["や"],["ぶどう"],["畑","はたけ"],["を"],["与え","あたえ"],["、"],["皆","みな"],["を"],["千人隊","せんにんたい"],["の"],["長","なが"],["や"],["、"],["百人隊","ひゃくにんたい"],["の"],["長","ちょう"],["に"],["するで"],["あろう"],["か"],["。"]]},{"verse":8,"text":"お前たちは皆、一団となってわたしに背き、わたしの息子とエッサイの子が契約を結んでもわたしの耳に入れない。息子がわたしの僕をわたしに刃向かわせ、今日のようにわたしをねらわせても、憂慮もしないし、わたしの耳に入れもしない。」","tok":[["お前","おまえ"],["たち"],["は"],["皆","みな"],["、"],["一団","いちだん"],["と"],["なって"],["わたし"],["に"],["背き","そむき"],["、"],["わたし"],["の"],["息子","むすこ"],["と"],["エッサイ"],["の"],["子","こ"],["が"],["契約","けいやく"],["を"],["結んで","むすんで"],["も"],["わたし"],["の"],["耳","みみ"],["に"],["入れない","いれない"],["。"],["息子","むすこ"],["が"],["わたし"],["の"],["僕","ぼく"],["を"],["わたし"],["に"],["刃向かわせ","はむかわせ"],["、"],["今日","きょう"],["の"],["よう"],["に"],["わたし"],["を"],["ねらわせて"],["も"],["、"],["憂慮","ゆうりょ"],["も"],["しない"],["し"],["、"],["わたし"],["の"],["耳","みみ"],["に"],["入れ","いれ"],["も"],["しない"],["。"],["」"]]},{"verse":9,"text":"サウルの家臣のそばに立っていたエドム人ドエグが答えた。「エッサイの子が、ノブにいるアヒトブの子アヒメレクのところに来たのを見ました。","tok":[["サウル"],["の"],["家臣","かしん"],["の"],["そば"],["に"],["立って","たって"],["いた"],["エドム人","えどむにん"],["ドエグ"],["が"],["答えた","こたえた"],["。"],["「"],["エッサイ"],["の"],["子","こ"],["が"],["、"],["ノブ"],["に"],["いる"],["アヒトブ"],["の"],["子","こ"],["アヒメレク"],["の"],["ところ"],["に"],["来た","きた"],["の"],["を"],["見ました","みました"],["。"]]},{"verse":10,"text":"アヒメレクは彼のために主に託宣を求め、食糧を渡し、ペリシテ人ゴリアトの剣を与えました。」","tok":[["アヒメレク"],["は"],["彼","かれ"],["の"],["ため"],["に"],["主に","おもに"],["託宣","たくせん"],["を"],["求め","もとめ"],["、"],["食糧","しょくりょう"],["を"],["渡し","わたし"],["、"],["ペリシテ"],["人","にん"],["ゴリアト"],["の"],["剣","けん"],["を"],["与えました","あたえました"],["。"],["」"]]},{"verse":11,"text":"サウルは人をやって、祭司であるアヒトブの子アヒメレクと、ノブで祭司職にある彼の父の家の者をすべて呼び出した。彼らは皆、王のもとに来た。","tok":[["サウル"],["は"],["人","ひと"],["を"],["やって"],["、"],["祭司","さいし"],["で"],["ある"],["アヒトブ"],["の"],["子","こ"],["アヒメレク"],["と"],["、"],["ノブ"],["で"],["祭司","さいし"],["職","しょく"],["に"],["ある"],["彼","かれ"],["の"],["父","ちち"],["の"],["家","いえ"],["の"],["者","もの"],["を"],["すべて"],["呼び出した","よびだした"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["王","おう"],["の"],["もと"],["に"],["来た","きた"],["。"]]},{"verse":12,"text":"サウルは言った。「アヒトブの子よ、聞くがよい。」彼は「はい、御主人様」と答えた。","tok":[["サウル"],["は"],["言った","いった"],["。"],["「"],["アヒトブ"],["の"],["子","こ"],["よ"],["、"],["聞く","きく"],["が"],["よい"],["。"],["」"],["彼","かれ"],["は"],["「"],["はい"],["、"],["御主人様","みうしさま"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":13,"text":"サウルは言った。「何故、お前はエッサイの子と組んでわたしに背き、彼にパンや剣を与え、神に託宣を求めてやり、今日のようにわたしに刃向かわせ、わたしをねらわせるようなことをしたのか。」","tok":[["サウル"],["は"],["言った","いった"],["。"],["「"],["何故","なぜ"],["、"],["お前","おまえ"],["は"],["エッサイ"],["の"],["子","こ"],["と"],["組んで","くんで"],["わたし"],["に"],["背き","そむき"],["、"],["彼","かれ"],["に"],["パン"],["や"],["剣","けん"],["を"],["与え","あたえ"],["、"],["神","かみ"],["に"],["託宣","たくせん"],["を"],["求めて","もとめて"],["やり"],["、"],["今日","きょう"],["の"],["よう"],["に"],["わたし"],["に"],["刃向かわせ","はむかわせ"],["、"],["わたし"],["を"],["ねらわせる"],["よう"],["な"],["こと"],["を"],["した"],["の"],["か"],["。"],["」"]]},{"verse":14,"text":"アヒメレクは王に答えた。「あなたの家臣の中に、ダビデほど忠実な者がいるでしょうか。ダビデは王様の婿、近衛の長、あなたの家で重んじられている者ではありませんか。","tok":[["アヒメレク"],["は"],["王","おう"],["に"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["家臣","かしん"],["の"],["中","なか"],["に"],["、"],["ダビデ"],["ほど"],["忠実","ちゅうじつ"],["な"],["者","もの"],["が"],["いるでしょう"],["か"],["。"],["ダビデ"],["は"],["王様","おうさま"],["の"],["婿","むこ"],["、"],["
[{"verse":1,"text":"ある日、サウルの息子ヨナタンは自分の武器を持つ従卒に言った。「さあ、渡って行き、向こう岸のペリシテ人の先陣を襲おう。」ヨナタンはこのことを父に話していなかった。","tok":[["ある"],["日","ひ"],["、"],["サウル"],["の"],["息子","むすこ"],["ヨナタン"],["は"],["自分","じぶん"],["の"],["武器","ぶき"],["を"],["持つ","もつ"],["従卒","じゅうそつ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["渡って","わたって"],["行き","いき"],["、"],["向こう岸","むこうぎし"],["の"],["ペリシテ"],["人","にん"],["の"],["先陣","せんじん"],["を"],["襲おう","おそおう"],["。"],["」"],["ヨナタン"],["は"],["この"],["こと"],["を"],["父","ちち"],["に"],["話して","はなして"],["いなかった"],["。"]]},{"verse":2,"text":"サウルはギブアの外れ、ミグロンのざくろの木陰にいた。彼のもとにいる兵士はおよそ六百人であった。","tok":[["サウル"],["は"],["ギブア"],["の"],["外れ","はずれ"],["、"],["ミグロン"],["の"],["ざくろ"],["の"],["木陰","こかげ"],["に"],["いた"],["。"],["彼","かれ"],["の"],["もと"],["に"],["いる"],["兵士","へいし"],["は"],["およそ"],["六百人","ろくひゃくにん"],["で"],["あった"],["。"]]},{"verse":3,"text":"そこには、エフォドを持つアヒヤもいた。アヒヤは、イカボドの兄弟アヒトブの子であり、イカボドはシロで主の祭司を務めたエリの息子のピネハスの子である。兵士たちはヨナタンが出て行くのに気がつかなかった。","tok":[["そこ"],["に"],["は"],["、"],["エフォド"],["を"],["持つ","もつ"],["アヒヤ"],["も"],["いた"],["。"],["アヒヤ"],["は"],["、"],["イカボド"],["の"],["兄弟","きょうだい"],["アヒトブ"],["の"],["子","こ"],["で"],["あり"],["、"],["イカボド"],["は"],["シロ"],["で"],["主","ぬし"],["の"],["祭司","さいし"],["を"],["務めた","つとめた"],["エリ"],["の"],["息子","むすこ"],["の"],["ピネハス"],["の"],["子","こ"],["で"],["ある"],["。"],["兵士","へいし"],["たち"],["は"],["ヨナタン"],["が"],["出て","でて"],["行く","いく"],["のに"],["気","き"],["が"],["つかなかった"],["。"]]},{"verse":4,"text":"ヨナタンがペリシテ軍の先陣の方に渡って行こうとした渡しには、こちら側にも向こう側にも切り立った岩があった。一方はボツェツと呼ばれ、他方はセンネと呼ばれる。","tok":[["ヨナタン"],["が"],["ペリシテ"],["軍","ぐん"],["の"],["先陣","せんじん"],["の"],["方","ほう"],["に"],["渡って","わたって"],["行こう","いこう"],["と"],["した"],["渡し","わたし"],["に"],["は"],["、"],["こちら側","こちらがわ"],["に"],["も"],["向こう側","むこうがわ"],["に"],["も"],["切り立った","きりたった"],["岩","いわ"],["が"],["あった"],["。"],["一方","いっぽう"],["は"],["ボツェツ"],["と"],["呼ばれ","よばれ"],["、"],["他方","たほう"],["は"],["センネ"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":5,"text":"一方の岩はミクマスに面して北側に、他方の岩はゲバに面して南側にそそり立っていた。","tok":[["一方","いっぽう"],["の"],["岩","いわ"],["は"],["ミクマス"],["に"],["面して","めんして"],["北側","きたがわ"],["に"],["、"],["他方","たほう"],["の"],["岩","いわ"],["は"],["ゲバ"],["に"],["面して","めんして"],["南側","みなみがわ"],["に"],["そそり立って","そそりたって"],["いた"],["。"]]},{"verse":6,"text":"ヨナタンは自分の武器を持つ従卒に言った。「さあ、あの無割礼の者どもの先陣の方へ渡って行こう。主が我々二人のために計らってくださるにちがいない。主が勝利を得られるために、兵の数の多少は問題ではない。」","tok":[["ヨナタン"],["は"],["自分","じぶん"],["の"],["武器","ぶき"],["を"],["持つ","もつ"],["従卒","じゅうそつ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["あの"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["ども"],["の"],["先陣","せんじん"],["の"],["方","ほう"],["へ"],["渡って","わたって"],["行こう","いこう"],["。"],["主","ぬし"],["が"],["我々","われわれ"],["二人","ふたり"],["の"],["ため"],["に"],["計らって","はからって"],["くださる"],["に"],["ちがい"],["ない"],["。"],["主","ぬし"],["が"],["勝利","しょうり"],["を"],["得られる","えられる"],["ため"],["に"],["、"],["兵","へい"],["の"],["数","かず"],["の"],["多少","たしょう"],["は"],["問題","もんだい"],["で"],["は"],["ない"],["。"],["」"]]},{"verse":7,"text":"従卒は答えた。「あなたの思いどおりになさってください。行きましょう。わたしはあなたと一心同体です。」","tok":[["従卒","じゅうそつ"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["思い","おもい"],["どおり"],["に"],["なさって"],["ください"],["。"],["行きましょう","いきましょう"],["。"],["わたし"],["は"],["あなた"],["と"],["一心","いっしん"],["同体","どうたい"],["です"],["。"],["」"]]},{"verse":8,"text":"ヨナタンは言った。「よし、ではあの者どものところへ渡って行って、我々の姿を見せよう。","tok":[["ヨナタン"],["は"],["言った","いった"],["。"],["「"],["よし"],["、"],["で"],["は"],["あの"],["者","もの"],["ども"],["の"],["ところ"],["へ"],["渡って","わたって"],["行って","いって"],["、"],["我々","われわれ"],["の"],["姿","すがた"],["を"],["見せよう","みせよう"],["。"]]},{"verse":9,"text":"そのとき、彼らが、『お前たちのところへ着くまでじっとしていろ』と言うなら、そこに立ち止まり、登って行くのはよそう。","tok":[["その"],["とき"],["、"],["彼","かれ"],["ら"],["が"],["、"],["『"],["お前","おまえ"],["たち"],["の"],["ところ"],["へ"],["着く","つく"],["まで"],["じっと"],["して"],["いろ"],["』"],["と"],["言うなら","ゆうなら"],["、"],["そこ"],["に"],["立ち止まり","たちどまり"],["、"],["登って","のぼって"],["行く","いく"],["の"],["は"],["よそう"],["。"]]},{"verse":10,"text":"もし、『登って来い』と言えば、登って行くことにしよう。それは、主が彼らを我々の手に渡してくださるしるしだ。」","tok":[["もし"],["、"],["『"],["登って","のぼって"],["来い","こい"],["』"],["と"],["言えば","いえば"],["、"],["登って","のぼって"],["行く","いく"],["こと"],["に"],["しよう"],["。"],["それ"],["は"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["我々","われわれ"],["の"],["手","て"],["に"],["渡して","わたして"],["くださる"],["しるし"],["だ"],["。"],["」"]]},{"verse":11,"text":"こうして、二人はペリシテ軍の先陣に姿を見せた。ペリシテ人は言った。「あそこにヘブライ人がいるぞ。身を隠していた穴から出て来たのだ。」","tok":[["こう"],["して"],["、"],["二人","ふたり"],["は"],["ペリシテ"],["軍","ぐん"],["の"],["先陣","せんじん"],["に"],["姿","すがた"],["を"],["見せた","みせた"],["。"],["ペリシテ"],["人","にん"],["は"],["言った","いった"],["。"],["「"],["あそこ"],["に"],["ヘブライ"],["人","にん"],["が"],["いる"],["ぞ"],["。"],["身","み"],["を"],["隠して","かくして"],["いた"],["穴","あな"],["から"],["出て","でて"],["来た","きた"],["の"],["だ"],["。"],["」"]]},{"verse":12,"text":"先陣の兵士たちは、ヨナタンと従卒に向かって呼ばわった。「登って来い。思い知らせてやろう。」ヨナタンは従卒に言った。「わたしに続いて登って来い。主が彼らをイスラエルの手に渡してくださるのだ。」","tok":[["先陣","せんじん"],["の"],["兵士","へいし"],["たち"],["は"],["、"],["ヨナタン"],["と"],["従卒","じゅうそつ"],["に"],["向かって","むかって"],["呼ばわった","よばわった"],["。"],["「"],["登って","のぼって"],["来い","こい"],["。"],["思い知らせて","おもいしらせて"],["やろう"],["。"],["」"],["ヨナタン"],["は"],["従卒","じゅうそつ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["に"],["続いて","つづいて"],["登って","のぼって"],["来い","こい"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["イスラエル"],["の"],["手","て"],["に"],["渡して","わたして"],["くださる"],["の"],["だ"],["。"],["」"]]},{"verse":13,"text":"ヨナタンは両手両足でよじ登り、従卒も後に続いた。ペリシテ人たちはヨナタンの前に倒れた。彼に続く従卒がとどめを刺した。","tok":[["ヨナタン"],["は"],["両手","りょうて"],["両足","りょうあし"],["で"],["よじ登り","よじのぼり"],["、"],["従卒","じゅうそつ"],["も"],["後","あと"],["に"],["続いた","つづいた"],["。"],["ペリシテ"],["人","にん"],["たち"],["は"],["ヨナタン"],["の"],["前","まえ"],["に"],["倒れた","たおれた"],["。"],["彼","かれ"],["に"],["続く","つづく"],["従卒","じゅうそつ"],["が"],["とどめ"],["を"],["刺した","さした"],["。"]]},{"verse":14,"text":"こうしてヨナタンと従卒がまず討ち取った者の数はおよそ二十人で、しかも、それは一軛の牛が一日で耕す畑の半分ほどの場所で行われた。","tok":[["こう"],["して"],["ヨナタン"],["と"],["従卒","じゅうそつ"],["が"],["まず"],["討ち取った","うちとった"],["者","もの"],["の"],["数","かず"],["は"],["およそ"],["二","に"],["十人","じゅうにん"],["で"],["、"],["しかも"],["、"],["それ"],["は"],["一","いち"],["軛","くびき"],["の"],["牛","うし"],["が"],["一","いち"],["日","にち"],["で"],["耕す","たがやす"],["畑","はたけ"],["の"],["半分","はんぶん"],["ほど"],["の"],["場所","ばしょ"],["で"],["行われた","おこなわれた"],["。"]]},{"verse":15,"text":"このため、恐怖が陣営でも野でも兵士全体に広がり、先陣も遊撃隊も恐怖に襲われた。地は揺れ動き、恐怖はその極に達した。","tok":[["この"],["ため"],["、"],["恐怖","きょうふ"],["が"],["陣営","じんえい"],["で"],["も"],["野","の"],["で"],["も"],["兵士","へいし"],["全体","ぜんたい"],["に"],["広がり","ひろがり"],["、"],["先陣","せんじん"],["も"],["遊撃隊","ゆうげきたい"],["も"],["恐怖","きょうふ"],["に"],["襲われた","おそわれた"],["。"],["地","ち"],["は"],["揺れ動き","ゆれうごき"],["、"],["恐怖","きょうふ"],["は"],["その"],["極","きょく"],["に"],["達した","たっした"],["。"]]},{"verse":16,"text":"ベニヤミンのギブアにいるサウルの見張りは、人の群れが動揺し、右往左往しているのに気づいた。","tok":[["ベニヤミン"],["の"],["ギブア"],["に"],["いる"],["サウル"],["の"],["見張り","みはり"],["は"],["、"],["人","ひと"],["の"],["群れ","むれ"],["が"],["動揺","どうよう"],["し"],["、"],["右往","うおう"],["左往","さおう"],["して"],["いる"],["のに"],["気づいた","きづいた"],["。"]]},{"verse":17,"text":"サウルは彼のもとにいる兵に命じた。「我々の中から出て行ったのは誰か、点呼して調べよ。」調べると、ヨナタンと従卒とが欠けていた。","tok":[["サウル"],["は"],["彼","かれ"],["の"],["もと"],["に"],["いる"],["兵","へい"],["に"],["命じた","めいじた"],["。"],["「"],["我々","われわれ"],["の"],["中","なか"],["から"],["出て","でて"],["行った","いった"],["の"],["は"],["誰","だれ"],["か"],["、"],["点呼","てんこ"],["して"],["調べ","しらべ"],["よ"],["。"],["」"],["調べる","しらべる"],["と"],["、"],["ヨナタン"],["と"],["従卒","じゅうそつ"],["と"],["が"],["欠けて","かけて"],["いた"],["。"]]},{"verse":18,"text":"サウルはアヒヤに命じた。「神の箱を運んで来なさい。」神の箱は当時、イスラエルの人々のもとにあった。","tok":[["サウル"],["は"],["アヒヤ"],["に"],["命じた","めいじた"],["。"],["「"],["神","かみ"],["の"],["箱","ばこ"],["を"],["運んで","はこんで"],["来","き"],["なさい"],["。"],["」"],["神","かみ"],["の"],["箱","ばこ"],["は"],["当時","とうじ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["もと"],["に"],["あった"],["。"]]},{"verse":19,"text":"サウルが祭司に話しているうちにも、ペリシテ軍の陣営の動揺はますます大きくなっていった。サウルは祭司に、「もうよい」と言い、","tok":[["サウル"],["が"],["祭司","さいし"],["に"],["話して","はなして"],["いる"],["うち"],["に"],["も"],["、"],["ペリシテ"],["軍","ぐん"],["の"],["陣営","じんえい"],["の"],["動揺","どうよう"],["は"],["ますます"],["大きく","おおきく"],["なって"],["いった"],["。"],["サウル"],["は"],["祭司","さいし"],["に"],["、"],["「"],["もう"],["よい"],["」"],["と"],["言い","いい"],["、"]]},{"verse":20,"text":"彼と彼の指揮下の兵士全員は一団となって戦場に出て行った。そこでは、剣を持った敵が同士討ちをし、大混乱に陥っていた。","tok":[["彼","かれ"],["と"],["彼","かれ"],["の"],["指揮下","しきか"],["の"],["兵士","へいし"],["全員","ぜんいん"],["は"],["一団","いちだん"],["と"],["なって"],["戦場","せんじょう"],["に"],["出て","でて"],["行った","いった"]
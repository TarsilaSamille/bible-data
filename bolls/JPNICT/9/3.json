[{"verse":1,"text":"少年サムエルはエリのもとで主に仕えていた。そのころ、主の言葉が臨むことは少なく、幻が示されることもまれであった。","tok":[["少年","しょうねん"],["サムエル"],["は"],["エリ"],["の"],["もと"],["で"],["主に","おもに"],["仕えて","つかえて"],["いた"],["。"],["その"],["ころ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["臨む","のぞむ"],["こと"],["は"],["少なく","すくなく"],["、"],["幻","まぼろし"],["が"],["示される","しめされる"],["こと"],["も"],["まれ"],["で"],["あった"],["。"]]},{"verse":2,"text":"ある日、エリは自分の部屋で床に就いていた。彼は目がかすんできて、見えなくなっていた。","tok":[["ある"],["日","ひ"],["、"],["エリ"],["は"],["自分","じぶん"],["の"],["部屋","へや"],["で"],["床","ゆか"],["に"],["就いて","ついて"],["いた"],["。"],["彼","かれ"],["は"],["目","め"],["が"],["かすんで"],["きて"],["、"],["見えなく","みえなく"],["なって"],["いた"],["。"]]},{"verse":3,"text":"まだ神のともし火は消えておらず、サムエルは神の箱が安置された主の神殿に寝ていた。","tok":[["まだ"],["神","かみ"],["の"],["ともし火","ともしび"],["は"],["消えて","きえて"],["おらず"],["、"],["サムエル"],["は"],["神","かみ"],["の"],["箱","ばこ"],["が"],["安置","あんち"],["された"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["寝て","ねて"],["いた"],["。"]]},{"verse":4,"text":"主はサムエルを呼ばれた。サムエルは、「ここにいます」と答えて、","tok":[["主","ぬし"],["は"],["サムエル"],["を"],["呼ばれた","よばれた"],["。"],["サムエル"],["は"],["、"],["「"],["ここ"],["に"],["います"],["」"],["と"],["答えて","こたえて"],["、"]]},{"verse":5,"text":"エリのもとに走って行き、「お呼びになったので参りました」と言った。しかし、エリが、「わたしは呼んでいない。戻っておやすみ」と言ったので、サムエルは戻って寝た。","tok":[["エリ"],["の"],["もと"],["に"],["走って","はしって"],["行き","いき"],["、"],["「"],["お呼び","および"],["に"],["なった"],["ので"],["参りました","まいりました"],["」"],["と"],["言った","いった"],["。"],["しかし"],["、"],["エリ"],["が"],["、"],["「"],["わたし"],["は"],["呼んで","よんで"],["いない"],["。"],["戻って","もどって"],["おやすみ"],["」"],["と"],["言った","いった"],["ので"],["、"],["サムエル"],["は"],["戻って","もどって"],["寝た","ねた"],["。"]]},{"verse":6,"text":"主は再びサムエルを呼ばれた。サムエルは起きてエリのもとに行き、「お呼びになったので参りました」と言った。エリは、「わたしは呼んでいない。わが子よ、戻っておやすみ」と言った。","tok":[["主","ぬし"],["は"],["再び","ふたたび"],["サムエル"],["を"],["呼ばれた","よばれた"],["。"],["サムエル"],["は"],["起きて","おきて"],["エリ"],["の"],["もと"],["に"],["行き","いき"],["、"],["「"],["お呼び","および"],["に"],["なった"],["ので"],["参りました","まいりました"],["」"],["と"],["言った","いった"],["。"],["エリ"],["は"],["、"],["「"],["わたし"],["は"],["呼んで","よんで"],["いない"],["。"],["わが"],["子","こ"],["よ"],["、"],["戻って","もどって"],["おやすみ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"サムエルはまだ主を知らなかったし、主の言葉はまだ彼に示されていなかった。","tok":[["サムエル"],["は"],["まだ"],["主","ぬし"],["を"],["知らなかった","しらなかった"],["し"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["は"],["まだ"],["彼","かれ"],["に"],["示されて","しめされて"],["いなかった"],["。"]]},{"verse":8,"text":"主は三度サムエルを呼ばれた。サムエルは起きてエリのもとに行き、「お呼びになったので参りました」と言った。エリは、少年を呼ばれたのは主であると悟り、","tok":[["主","ぬし"],["は"],["三","さん"],["度","ど"],["サムエル"],["を"],["呼ばれた","よばれた"],["。"],["サムエル"],["は"],["起きて","おきて"],["エリ"],["の"],["もと"],["に"],["行き","いき"],["、"],["「"],["お呼び","および"],["に"],["なった"],["ので"],["参りました","まいりました"],["」"],["と"],["言った","いった"],["。"],["エリ"],["は"],["、"],["少年","しょうねん"],["を"],["呼ばれた","よばれた"],["の"],["は"],["主","ぬし"],["で"],["ある"],["と"],["悟り","さとり"],["、"]]},{"verse":9,"text":"サムエルに言った。「戻って寝なさい。もしまた呼びかけられたら、『主よ、お話しください。僕は聞いております』と言いなさい。」サムエルは戻って元の場所に寝た。","tok":[["サムエル"],["に"],["言った","いった"],["。"],["「"],["戻って","もどって"],["寝","ね"],["なさい"],["。"],["もし"],["また"],["呼びかけられたら","よびかけられたら"],["、"],["『"],["主","ぬし"],["よ"],["、"],["お話し","おはなし"],["ください"],["。"],["僕","ぼく"],["は"],["聞いて","きいて"],["おります"],["』"],["と"],["言い","いい"],["なさい"],["。"],["」"],["サムエル"],["は"],["戻って","もどって"],["元","もと"],["の"],["場所","ばしょ"],["に"],["寝た","ねた"],["。"]]},{"verse":10,"text":"主は来てそこに立たれ、これまでと同じように、サムエルを呼ばれた。「サムエルよ。」サムエルは答えた。「どうぞお話しください。僕は聞いております。」","tok":[["主","ぬし"],["は"],["来て","きて"],["そこ"],["に"],["立たれ","たたれ"],["、"],["これ"],["まで"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["サムエル"],["を"],["呼ばれた","よばれた"],["。"],["「"],["サムエル"],["よ"],["。"],["」"],["サムエル"],["は"],["答えた","こたえた"],["。"],["「"],["どうぞ"],["お話し","おはなし"],["ください"],["。"],["僕","ぼく"],["は"],["聞いて","きいて"],["おります"],["。"],["」"]]},{"verse":11,"text":"主はサムエルに言われた。「見よ、わたしは、イスラエルに一つのことを行う。それを聞く者は皆、両耳が鳴るだろう。","tok":[["主","ぬし"],["は"],["サムエル"],["に"],["言われた","いわれた"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["イスラエル"],["に"],["一","ひと"],["つ"],["の"],["こと"],["を"],["行う","おこなう"],["。"],["それ"],["を"],["聞く","きく"],["者","もの"],["は"],["皆","みな"],["、"],["両耳","りょうみみ"],["が"],["鳴るだろう","なるだろう"],["。"]]},{"verse":12,"text":"その日わたしは、エリの家に告げたことをすべて、初めから終わりまでエリに対して行う。","tok":[["その"],["日","ひ"],["わたし"],["は"],["、"],["エリ"],["の"],["家","いえ"],["に"],["告げた","つげた"],["こと"],["を"],["すべて"],["、"],["初め","はじめ"],["から"],["終わり","おわり"],["まで"],["エリ"],["に対して","にたいして"],["行う","おこなう"],["。"]]},{"verse":13,"text":"わたしはエリに告げ知らせた。息子たちが神を汚す行為をしていると知っていながら、とがめなかった罪のために、エリの家をとこしえに裁く、と。","tok":[["わたし"],["は"],["エリ"],["に"],["告げ知らせた","つげしらせた"],["。"],["息子","むすこ"],["たち"],["が"],["神","かみ"],["を"],["汚す","けがす"],["行為","こうい"],["を"],["して"],["いる"],["と"],["知って","しって"],["い"],["ながら"],["、"],["とがめなかった"],["罪","つみ"],["の"],["ため"],["に"],["、"],["エリ"],["の"],["家","いえ"],["を"],["とこしえ"],["に"],["裁く","さばく"],["、"],["と"],["。"]]},{"verse":14,"text":"わたしはエリの家について誓った。エリの家の罪は、いけにえによっても献げ物によってもとこしえに贖われることはない。」","tok":[["わたし"],["は"],["エリ"],["の"],["家","いえ"],["について"],["誓った","ちかった"],["。"],["エリ"],["の"],["家","いえ"],["の"],["罪","つみ"],["は"],["、"],["いけにえ"],["によって"],["も"],["献げ物","ささげもの"],["によって"],["も"],["とこしえ"],["に"],["贖われる","あがなわれる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":15,"text":"サムエルは朝まで眠って、それから主の家の扉を開いた。サムエルはエリにこのお告げを伝えるのを恐れた。","tok":[["サムエル"],["は"],["朝","あさ"],["まで"],["眠って","ねむって"],["、"],["それ"],["から"],["主","ぬし"],["の"],["家","いえ"],["の"],["扉","とびら"],["を"],["開いた","ひらいた"],["。"],["サムエル"],["は"],["エリ"],["に"],["この"],["お告げ","おつげ"],["を"],["伝える","つたえる"],["の"],["を"],["恐れた","おそれた"],["。"]]},{"verse":16,"text":"エリはサムエルを呼んで言った。「わが子、サムエルよ。」サムエルは答えた。「ここにいます。」","tok":[["エリ"],["は"],["サムエル"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["わが"],["子","こ"],["、"],["サムエル"],["よ"],["。"],["」"],["サムエル"],["は"],["答えた","こたえた"],["。"],["「"],["ここ"],["に"],["います"],["。"],["」"]]},{"verse":17,"text":"エリは言った。「お前に何が語られたのか。わたしに隠してはいけない。お前に語られた言葉を一つでも隠すなら、神が幾重にもお前を罰してくださるように。」","tok":[["エリ"],["は"],["言った","いった"],["。"],["「"],["お前","おまえ"],["に"],["何","なん"],["が"],["語られた","かたられた"],["の"],["か"],["。"],["わたし"],["に"],["隠して","かくして"],["は"],["いけない"],["。"],["お前","おまえ"],["に"],["語られた","かたられた"],["言葉","ことば"],["を"],["一","ひと"],["つ"],["で"],["も"],["隠すなら","かくすなら"],["、"],["神","かみ"],["が"],["幾重","いくえ"],["に"],["も"],["お
[{"verse":1,"text":"キルヤト‧エアリムの人々はやって来て、主の箱を担ぎ上り、丘の上のアビナダブの家に運び入れた。そして、アビナダブの息子エルアザルを聖別して、主の箱を守らせた。","tok":[["キルヤト"],["‧"],["エアリム"],["の"],["人々","ひとびと"],["は"],["やって"],["来て","きて"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["担ぎ","かつぎ"],["上り","のぼり"],["、"],["丘","おか"],["の"],["上","うえ"],["の"],["アビナダブ"],["の"],["家","いえ"],["に"],["運び入れた","はこびいれた"],["。"],["そして"],["、"],["アビナダブ"],["の"],["息子","むすこ"],["エルアザル"],["を"],["聖別","せいべつ"],["して"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["守らせた","まもらせた"],["。"]]},{"verse":2,"text":"主の箱がキルヤト‧エアリムに安置された日から時が過ぎ、二十年を経た。イスラエルの家はこぞって主を慕い求めていた。","tok":[["主","ぬし"],["の"],["箱","ばこ"],["が"],["キルヤト"],["‧"],["エアリム"],["に"],["安置","あんち"],["された"],["日","ひ"],["から"],["時","とき"],["が"],["過ぎ","すぎ"],["、"],["二十","にじゅう"],["年","ねん"],["を"],["経た","へた"],["。"],["イスラエル"],["の"],["家","いえ"],["は"],["こぞって"],["主","ぬし"],["を"],["慕い求めて","したいもとめて"],["いた"],["。"]]},{"verse":3,"text":"サムエルはイスラエルの家の全体に対して言った。「あなたたちが心を尽くして主に立ち帰るというなら、あなたたちの中から異教の神々やアシュトレトを取り除き、心を正しく主に向け、ただ主にのみ仕えなさい。そうすれば、主はあなたたちをペリシテ人の手から救い出してくださる。」","tok":[["サムエル"],["は"],["イスラエル"],["の"],["家","いえ"],["の"],["全体","ぜんたい"],["に対して","にたいして"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["が"],["心","こころ"],["を"],["尽くして","つくして"],["主に","おもに"],["立ち帰る","たちかえる"],["と"],["いうなら"],["、"],["あなた"],["たち"],["の"],["中","なか"],["から"],["異教","いきょう"],["の"],["神々","かみがみ"],["や"],["アシュトレト"],["を"],["取り除き","とりのぞき"],["、"],["心","こころ"],["を"],["正しく","ただしく"],["主に","おもに"],["向け","むけ"],["、"],["ただ"],["主に","おもに"],["のみ"],["仕え","つかえ"],["なさい"],["。"],["そう"],["すれば"],["、"],["主","ぬし"],["は"],["あなた"],["たち"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["くださる"],["。"],["」"]]},{"verse":4,"text":"イスラエルの人々はバアルとアシュトレトを取り除き、ただ主にのみ仕えた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["バアル"],["と"],["アシュトレト"],["を"],["取り除き","とりのぞき"],["、"],["ただ"],["主に","おもに"],["のみ"],["仕えた","つかえた"],["。"]]},{"verse":5,"text":"サムエルは命じた。「イスラエルを全員、ミツパに集めなさい。あなたたちのために主に祈ろう。」","tok":[["サムエル"],["は"],["命じた","めいじた"],["。"],["「"],["イスラエル"],["を"],["全員","ぜんいん"],["、"],["ミツパ"],["に"],["集め","あつめ"],["なさい"],["。"],["あなた"],["たち"],["の"],["ため"],["に"],["主に","おもに"],["祈ろう","いのろう"],["。"],["」"]]},{"verse":6,"text":"人々はミツパに集まると、水をくみ上げて主の御前に注ぎ、その日は断食し、その所で、「わたしたちは主に罪を犯しました」と言った。サムエルはミツパでイスラエルの人々に裁きを行った。","tok":[["人々","ひとびと"],["は"],["ミツパ"],["に"],["集まる","あつまる"],["と"],["、"],["水","みず"],["を"],["くみ上げて","くみあげて"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["注ぎ","そそぎ"],["、"],["その"],["日","ひ"],["は"],["断食","だんじき"],["し"],["、"],["その"],["所","ところ"],["で"],["、"],["「"],["わたしたち"],["は"],["主に","おもに"],["罪","つみ"],["を"],["犯しました","おかしました"],["」"],["と"],["言った","いった"],["。"],["サムエル"],["は"],["ミツパ"],["で"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["裁き","さばき"],["を"],["行った","おこなった"],["。"]]},{"verse":7,"text":"イスラエルの人々がミツパに集まっていると聞いて、ペリシテの領主たちはイスラエルに攻め上って来た。イスラエルの人々はそのことを聞き、ペリシテ軍を恐れて、","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["ミツパ"],["に"],["集まって","あつまって"],["いる"],["と"],["聞いて","きいて"],["、"],["ペリシテ"],["の"],["領主","りょうしゅ"],["たち"],["は"],["イスラエル"],["に"],["攻め上って","せめのぼって"],["来た","きた"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["その"],["こと"],["を"],["聞き","きき"],["、"],["ペリシテ"],["軍","ぐん"],["を"],["恐れて","おそれて"],["、"]]},{"verse":8,"text":"サムエルに乞うた。「どうか黙っていないでください。主が我々をペリシテ人の手から救ってくださるように、我々の神、主に助けを求めて叫んでください。」","tok":[["サムエル"],["に"],["乞うた","こうた"],["。"],["「"],["どう"],["か"],["黙って","だまって"],["いないで"],["ください"],["。"],["主","ぬし"],["が"],["我々","われわれ"],["を"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["救って","すくって"],["くださる"],["よう"],["に"],["、"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んで","さけんで"],["ください"],["。"],["」"]]},{"verse":9,"text":"サムエルはまだ乳離れしない小羊一匹を取り、焼き尽くす献げ物として主にささげ、イスラエルのため主に助けを求めて叫んだ。主は彼に答えられた。","tok":[["サムエル"],["は"],["まだ"],["乳離れ","ちばなれ"],["しない"],["小羊","こひつじ"],["一匹","いちひき"],["を"],["取り","とり"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["として"],["主に","おもに"],["ささげ"],["、"],["イスラエル"],["の"],["ため"],["主に","おもに"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んだ","さけんだ"],["。"],["主","ぬし"],["は"],["彼","かれ"],["に"],["答えられた","こたえられた"],["。"]]},{"verse":10,"text":"サムエルが焼き尽くす献げ物をささげている間に、ペリシテ軍はイスラエルに戦いを挑んで来たが、主がこの日、ペリシテ軍の上に激しい雷鳴をとどろかせ、彼らを混乱に陥れられたので、彼らはイスラエルに打ち負かされた。","tok":[["サムエル"],["が"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげて"],["いる"],["間","あいだ"],["に"],["、"],["ペリシテ"],["軍","ぐん"],["は"],["イスラエル"],["に"],["戦い","たたかい"],["を"],["挑んで","いどんで"],["来た","きた"],["が"],["、"],["主","ぬし"],["が"],["この"],["日","ひ"],["、"],["ペリシテ"],["軍","ぐん"],["の"],["上","うえ"],["に"],["激しい","はげしい"],["雷鳴","らいめい"],["を"],["とどろかせ"],["、"],["彼","かれ"],["ら"],["を"],["混乱","こんらん"],["に"],["陥れられた","おとしいれられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["に"],["打ち負かされた","うちまかされた"],["。"]]},{"verse":11,"text":"イスラエルの兵はミツパを出てペリシテ人を追い、彼らを討ってベト‧カルの下まで行った。","tok":[["イスラエル"],["の"],["兵","へい"],["は"],["ミツパ"],["を"],["出て","でて"],["ペリシテ"],["人","にん"],["を"],["追い","おい"],["、"],["彼","かれ"],["ら"],["を"],["討って","うって"],["ベト"],["‧"],["カル"],["の"],["下","した"],["まで"],["行った","いった"],["。"]]},{"verse":12,"text":"サムエルは石を一つ取ってミツパとシェンの間に置き、「今まで、主は我々を助けてくださった」と言って、それをエベン‧エゼル（助けの石）と名付けた。","tok":[["サムエル"],["は"],["石","いし"],["を"],["一","ひと"],["つ"],["取って","とって"],["ミツパ"],["と"],["シェン"],["の"],["間","あいだ"],["に"],["置き","おき"],["、"],["「"],["今まで","いままで"],["、"],["主","ぬし"],["は"],["我々","われわれ"],["を"],["助けて","たすけて"],["くださった"],["」"],["と"],["言って","いって"],["、"],["それ"],["を"],["エベン"],["‧"],["エゼル"],["（"],["助け","たすけ"],["の"],["石","いし"],["）"],["と"],["名付けた","なづけた"],["。"]]},{"verse":13,"text":"ペリシテ人は鎮められ、二度とイスラエルの国境を侵すことはなかった。サムエルの時代を通して、主の手はペリシテ人を抑えていた。","tok":[["ペリシテ"],["人","にん"],["は"],["鎮められ","しずめられ"],["、"],["二","に"],["度","ど"],["と"],["イスラエル"],["の"],["国境","こっきょう"],["を"],["侵す","おかす"],["こと"],["は"],["なかった"],["。"],["サムエル"],["の"],["時代","じだい"],["を"],["通して","とおして"],["、"],["主","ぬし"],["の"],["手","て"],["は"],["ペリシテ"],["人","にん"],["を"],["抑えて","おさえて"],["いた"],["。"]]},{"verse":14,"text":"ペリシテ人がイスラエルから奪い取っていた町々は、エクロンからガトまで再びイスラエルのものとなった。イスラエルはその周辺の村々をもペリシテ人の手から救った。イスラエルとアモリ人との間は平和であった。","tok":[["ペリシテ"],["人","にん"],["が"],["イスラエル"],["から"],["奪い取って","うばいとって"],["いた"],["町々","まちまち"],["は"],["、"],["エクロン"],["から"],["ガト"],["まで"],["再び","ふたたび"],["イスラエル"],["の"],["もの"],["と"],["なった"],["。"],["イスラエル"],["は"],["その"],["周辺","しゅうへん"],["の"],["村々","むらむら"],["を"],["も"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["救った","すくった"],["。"],["イスラエル"],["と"],["アモリ人","あもりにん"],["と"],["の"],["間","あいだ"],["は"],["平和","へいわ"],["で"],["あった"],["。"]]},{"verse":15,"text":"サムエルは生涯、イスラエルのために裁きを行った。","tok":[["サムエル"],["は"],["生涯","しょうがい"],["、"],["イスラエル"],["の"],["ため"],["に"],["裁き","さばき"],["を"],["行った","おこなった"],["。"]]},{"verse":16,"text":"毎年、ベテル、ギルガル、ミツパを巡り歩き、それらの地でイスラエルのために裁きを行い、","tok":[["毎年","まいとし"],["、"],["ベテル"],["、"],["ギルガル"],["、"],["ミツパ"],["を"],["巡り歩き","めぐりあるき"],["、"],["それ"],["ら"],["の"],["地","ち"],["で"],["イスラエル"],["の"],["ため"],["に"],["裁き","さばき"],["を"],["行い","おこない"],["、"]]},{"verse":17,"text":"ラマに戻った。そこには彼の家があった。彼はそこでもイスラエルのために裁きを行い、主のために祭壇を築いた。","tok":[["ラマ"],["に"],["戻った","もどった"],["。"],["そこ"],["に"],["は"],["彼","かれ"],["の"],["家","いえ"],["が"],["あった"],["。"],["彼","かれ"],["は"],["そこ"],["で"],["も"],["イスラエル"],["の"],["ため"],["に"],["裁き","さばき"],["を"],["行い","おこない"],["、"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]}]
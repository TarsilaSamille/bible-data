[{"verse":1,"text":"さて、アンモン人のナハシュが攻め上って来て、ギレアドのヤベシュを包囲した。ヤベシュの全住民はナハシュに言った。「我々と契約を結んでください。我々はあなたに仕えます。」","tok":[["さて"],["、"],["アンモン"],["人","にん"],["の"],["ナハシュ"],["が"],["攻め上って","せめのぼって"],["来て","きて"],["、"],["ギレアド"],["の"],["ヤベシュ"],["を"],["包囲","ほうい"],["した"],["。"],["ヤベシュ"],["の"],["全住民","ぜんじゅうみん"],["は"],["ナハシュ"],["に"],["言った","いった"],["。"],["「"],["我々","われわれ"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["ください"],["。"],["我々","われわれ"],["は"],["あなた"],["に"],["仕えます","つかえます"],["。"],["」"]]},{"verse":2,"text":"アンモン人のナハシュは答えた。「お前たちと契約を結ぼう。ただし、お前たち全員の右の目をえぐり出すのが条件だ。それをもって全イスラエルを侮辱しよう。」","tok":[["アンモン"],["人","にん"],["の"],["ナハシュ"],["は"],["答えた","こたえた"],["。"],["「"],["お前","おまえ"],["たち"],["と"],["契約","けいやく"],["を"],["結ぼう","むすぼう"],["。"],["ただし"],["、"],["お前","おまえ"],["たち"],["全員","ぜんいん"],["の"],["右","みぎ"],["の"],["目","め"],["を"],["えぐり出す","えぐりだす"],["の"],["が"],["条件","じょうけん"],["だ"],["。"],["それ"],["を"],["もって"],["全","ぜん"],["イスラエル"],["を"],["侮辱","ぶじょく"],["しよう"],["。"],["」"]]},{"verse":3,"text":"ヤベシュの長老たちは彼に言った。「七日間の猶予をください。イスラエルの全土に使者を立てます。救ってくれる者がいなければ、我々はあなたのもとへ出て行きます。」","tok":[["ヤベシュ"],["の"],["長老","ちょうろう"],["たち"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["七","なな"],["日間","かかん"],["の"],["猶予","ゆうよ"],["を"],["ください"],["。"],["イスラエル"],["の"],["全土","ぜんど"],["に"],["使者","ししゃ"],["を"],["立てます","たてます"],["。"],["救って","すくって"],["くれる"],["者","もの"],["が"],["いなければ"],["、"],["我々","われわれ"],["は"],["あなた"],["の"],["もと"],["へ"],["出て","でて"],["行きます","いきます"],["。"],["」"]]},{"verse":4,"text":"使者はサウルのいるギブアに来て、事の次第を民に報告した。民のだれもが声をあげて泣いた。","tok":[["使者","ししゃ"],["は"],["サウル"],["の"],["いる"],["ギブア"],["に"],["来て","きて"],["、"],["事","こと"],["の"],["次第","しだい"],["を"],["民","たみ"],["に"],["報告","ほうこく"],["した"],["。"],["民","たみ"],["の"],["だれ"],["も"],["が"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":5,"text":"そこへ、サウルが牛を追って畑から戻って来た。彼は尋ねた。「民が泣いているが、何事か起こったのか。」彼らはヤベシュの人々の言葉を伝えた。","tok":[["そこ"],["へ"],["、"],["サウル"],["が"],["牛","うし"],["を"],["追って","おって"],["畑","はたけ"],["から"],["戻って","もどって"],["来た","きた"],["。"],["彼","かれ"],["は"],["尋ねた","たずねた"],["。"],["「"],["民","みん"],["が"],["泣いて","ないて"],["いる"],["が"],["、"],["何事","なにごと"],["か"],["起こった","おこった"],["の"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["ヤベシュ"],["の"],["人々","ひとびと"],["の"],["言葉","ことば"],["を"],["伝えた","つたえた"],["。"]]},{"verse":6,"text":"それを聞くうちに神の霊がサウルに激しく降った。彼は怒りに燃えて、","tok":[["それ"],["を"],["聞く","きく"],["うち"],["に"],["神","かみ"],["の"],["霊","れい"],["が"],["サウル"],["に"],["激しく","はげしく"],["降った","ふった"],["。"],["彼","かれ"],["は"],["怒り","いかり"],["に"],["燃えて","もえて"],["、"]]},{"verse":7,"text":"一軛の牛を捕らえ、それを切り裂き、使者に持たせて、イスラエル全土に送り、次のように言わせた。「サウルとサムエルの後について出陣しない者があれば、その者の牛はこのようにされる。」民は主への恐れにかられ、一丸となって出陣した。","tok":[["一","いち"],["軛","くびき"],["の"],["牛","うし"],["を"],["捕らえ","とらえ"],["、"],["それ"],["を"],["切り裂き","きりさき"],["、"],["使者","ししゃ"],["に"],["持たせて","もたせて"],["、"],["イスラエル"],["全土","ぜんど"],["に"],["送り","おくり"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言わせた","いわせた"],["。"],["「"],["サウル"],["と"],["サムエル"],["の"],["後","あと"],["について"],["出陣","しゅつじん"],["しない"],["者","もの"],["が"],["あれば"],["、"],["その"],["者","もの"],["の"],["牛","うし"],["は"],["この"],["よう"],["に"],["される"],["。"],["」"],["民","みん"],["は"],["主","ぬし"],["へ"],["の"],["恐れ","おそれ"],["に"],["かられ"],["、"],["一丸","いちがん"],["と"],["なって"],["出陣","しゅつじん"],["した"],["。"]]},{"verse":8,"text":"サウルがベゼクで彼らを点呼すると、イスラエルが三十万、ユダが三万であった。","tok":[["サウル"],["が"],["ベゼク"],["で"],["彼","かれ"],["ら"],["を"],["点呼","てんこ"],["する"],["と"],["、"],["イスラエル"],["が"],["三十万","さんじゅうまん"],["、"],["ユダ"],["が"],["三万","さんまん"],["で"],["あった"],["。"]]},{"verse":9,"text":"彼らはヤベシュから送られて来た使者に言った。「ギレアドのヤベシュの人々にこう言うのだ。『明日、日盛りのころ、あなたがたに救いが来る。』」使者が帰って来てそう知らせると、ヤベシュの人々は喜び祝った。","tok":[["彼","かれ"],["ら"],["は"],["ヤベシュ"],["から"],["送られて","おくられて"],["来た","きた"],["使者","ししゃ"],["に"],["言った","いった"],["。"],["「"],["ギレアド"],["の"],["ヤベシュ"],["の"],["人々","ひとびと"],["に"],["こう"],["言う","いう"],["の"],["だ"],["。"],["『"],["明日","あす"],["、"],["日盛り","ひざかり"],["の"],["ころ"],["、"],["あなた"],["がた"],["に"],["救い","すくい"],["が"],["来る","くる"],["。"],["』"],["」"],["使者","ししゃ"],["が"],["帰って","かえって"],["来て","きて"],["そう"],["知らせる","しらせる"],["と"],["、"],["ヤベシュ"],["の"],["人々","ひとびと"],["は"],["喜び祝った","よろこびいわった"],["。"]]},{"verse":10,"text":"ヤベシュの人々は言った。「明日、我々はあなたたちのもとに出て行きます。よいようにしてください。」","tok":[["ヤベシュ"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["。"],["「"],["明日","あす"],["、"],["我々","われわれ"],["は"],["あなた"],["たち"],["の"],["もと"],["に"],["出て","でて"],["行きます","いきます"],["。"],["よい"],["よう"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":11,"text":"翌日、サウルは民を三つの組に分け、朝の見張りの時刻にアンモン人の陣営に突入し、日盛りのころまで彼らを討った。生き残った者はちりぢりになり、二人一緒に生き残った者はいなかった。","tok":[["翌日","よくじつ"],["、"],["サウル"],["は"],["民","みん"],["を"],["三","みっ"],["つ"],["の"],["組","くみ"],["に"],["分け","わけ"],["、"],["朝","あさ"],["の"],["見張り","みはり"],["の"],["時刻","じこく"],["に"],["アンモン"],["人","にん"],["の"],["陣営","じんえい"],["に"],["突入","とつにゅう"],["し"],["、"],["日盛り","ひざかり"],["の"],["ころ"],["まで"],["彼","かれ"],["ら"],["を"],["討った","うった"],["。"],["生き残った","いきのこった"],["者","もの"],["は"],["ちりぢり"],["に"],["なり"],["、"],["二人","ふたり"],["一緒","いっしょ"],["に"],["生き残った","いきのこった"],["者","もの"],["は"],["いなかった"],["。"]]},{"verse":12,"text":"民はサムエルに言った。「『サウルが我々の王になれようか』と言っていた者はだれであろうと引き渡してください。殺します。」","tok":[["民","みん"],["は"],["サムエル"],["に"],["言った","いった"],["。"],["「"],["『"],["サウル"],["が"],["我々","われわれ"],["の"],["王","おう"],["に"],["なれよう"],["か"],["』"],["と"],["言って","いって"],["いた"],["者","もの"],["は"],["だれ"],["で"],["あろう"],["と"],["引き渡して","ひきわたして"],["ください"],["。"],["殺します","ころします"],["。"],["」"]]},{"verse":13,"text":"しかし、サウルは言った。「今日は、だれも殺してはならない。今日、主がイスラエルにおいて救いの業を行われたのだから。」","tok":[["しかし"],["、"],["サウル"],["は"],["言った","いった"],["。"],["「"],["今日","きょう"],["は"],["、"],["だれ"],["も"],["殺して","ころして"],["は"],["ならない"],["。"],["今日","きょう"],["、"],["主","ぬし"],["が"],["イスラエル"],["に"],["おいて"],["救い","すくい"],["の"],["業","ごう"],["を"],["行われた","おこなわれた"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":14,"text":"サムエルは民に言った。「さあ、ギルガルに行こう。そこで王国を興そう。」","tok":[["サムエル"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["ギルガル"],["に"],["行こう","いこう"],["。"],["そこ"],["で"],["王国","おうこく"],["を"],["興そう","おこそう"],["。"],["」"]]},{"verse":15,"text":"民は全員でギルガルに向かい、そこでサウルを王として主の御前に立てた。それから、和解の献げ物を主の御前にささげ、サウルもイスラエルの人々もすべて、大いに喜び祝った。","tok":[["民","みん"],["は"],["全員","ぜんいん"],["で"],["ギルガル"],["に"],["向かい","むかい"],["、"],["そこ"],["で"],["サウル"],["を"],["王","おう"],["として"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["立てた","たてた"],["。"],["それ"],["から"],["、"],["和解","わかい"],["の"],["献げ物","ささげもの"],["を"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["ささげ"],["、"],["サウル"],["も"],["イスラエル"],["の"],["人々","ひとびと"],["も"],["すべて"],["、"],["大いに","おおいに"],["喜び祝った","よろこびいわった"],["。"]]}]
[{"verse":1,"text":"ダビデは立ち去り、ヨナタンは町に戻った。","tok":[["ダビデ"],["は"],["立ち去り","たちさり"],["、"],["ヨナタン"],["は"],["町","まち"],["に"],["戻った","もどった"],["。"]]},{"verse":2,"text":"ダビデは、ノブの祭司アヒメレクのところに行った。ダビデを不安げに迎えたアヒメレクは、彼に尋ねた。「なぜ、一人なのですか、供はいないのですか。」","tok":[["ダビデ"],["は"],["、"],["ノブ"],["の"],["祭司","さいし"],["アヒメレク"],["の"],["ところ"],["に"],["行った","いった"],["。"],["ダビデ"],["を"],["不安","ふあん"],["げ"],["に"],["迎えた","むかえた"],["アヒメレク"],["は"],["、"],["彼","かれ"],["に"],["尋ねた","たずねた"],["。"],["「"],["なぜ"],["、"],["一人","ひとり"],["な"],["の"],["です"],["か"],["、"],["供","とも"],["は"],["いない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":3,"text":"ダビデは祭司アヒメレクに言った。「王はわたしに一つの事を命じて、『お前を遣わす目的、お前に命じる事を、だれにも気づかれるな』と言われたのです。従者たちには、ある場所で落ち合うよう言いつけてあります。","tok":[["ダビデ"],["は"],["祭司","さいし"],["アヒメレク"],["に"],["言った","いった"],["。"],["「"],["王","おう"],["は"],["わたし"],["に"],["一","ひと"],["つ"],["の"],["事","こと"],["を"],["命じて","めいじて"],["、"],["『"],["お前","おまえ"],["を"],["遣わす","つかわす"],["目的","もくてき"],["、"],["お前","おまえ"],["に"],["命じる","めいじる"],["事","こと"],["を"],["、"],["だれ"],["に"],["も"],["気づかれる","きづかれる"],["な"],["』"],["と"],["言われた","いわれた"],["の"],["です"],["。"],["従者","じゅうしゃ"],["たち"],["に"],["は"],["、"],["ある"],["場所","ばしょ"],["で"],["落ち合う","おちあう"],["よう"],["言いつけて","いいつけて"],["あります"],["。"]]},{"verse":4,"text":"それよりも、何か、パン五個でも手もとにありませんか。ほかに何かあるなら、いただけますか。」","tok":[["それ"],["より"],["も"],["、"],["何","なん"],["か"],["、"],["パン"],["五個","ごこ"],["で"],["も"],["手もと","てもと"],["に"],["ありません"],["か"],["。"],["ほか"],["に"],["何","なん"],["か"],["あるなら"],["、"],["いただけます"],["か"],["。"],["」"]]},{"verse":5,"text":"祭司はダビデに答えた。「手もとに普通のパンはありません。聖別されたパンならあります。従者が女を遠ざけているなら差し上げます。」","tok":[["祭司","さいし"],["は"],["ダビデ"],["に"],["答えた","こたえた"],["。"],["「"],["手もと","てもと"],["に"],["普通","ふつう"],["の"],["パン"],["は"],["ありません"],["。"],["聖別","せいべつ"],["された"],["パン"],["なら"],["あります"],["。"],["従者","じゅうしゃ"],["が"],["女","おんな"],["を"],["遠ざけて","とおざけて"],["いるなら"],["差し上げます","さしあげます"],["。"],["」"]]},{"verse":6,"text":"ダビデは祭司に答えて言った。「いつものことですが、わたしが出陣するときには女を遠ざけています。従者たちは身を清めています。常の遠征でもそうですから、まして今日は、身を清めています。」","tok":[["ダビデ"],["は"],["祭司","さいし"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["いつも"],["の"],["こと"],["です"],["が"],["、"],["わたし"],["が"],["出陣","しゅつじん"],["する"],["とき"],["に"],["は"],["女","おんな"],["を"],["遠ざけて","とおざけて"],["います"],["。"],["従者","じゅうしゃ"],["たち"],["は"],["身","み"],["を"],["清めて","きよめて"],["います"],["。"],["常","つね"],["の"],["遠征","えんせい"],["で"],["も"],["そう"],["です"],["から"],["、"],["まして"],["今日","きょう"],["は"],["、"],["身","み"],["を"],["清めて","きよめて"],["います"],["。"],["」"]]},{"verse":7,"text":"普通のパンがなかったので、祭司は聖別されたパンをダビデに与えた。パンを供え替える日で、焼きたてのパンに替えて主の御前から取り下げた、供えのパンしかなかった。","tok":[["普通","ふつう"],["の"],["パン"],["が"],["なかった"],["ので"],["、"],["祭司","さいし"],["は"],["聖別","せいべつ"],["された"],["パン"],["を"],["ダビデ"],["に"],["与えた","あたえた"],["。"],["パン"],["を"],["供え","そなえ"],["替える","かえる"],["日","ひ"],["で"],["、"],["焼きたて","やきたて"],["の"],["パン"],["に"],["替えて","かえて"],["主","ぬし"],["の"],["御前","ごぜん"],["から"],["取り下げた","とりさげた"],["、"],["供え","そなえ"],["の"],["パン"],["しか"],["なかった"],["。"]]},{"verse":8,"text":"そこにはその日、サウルの家臣の一人が主の御前にとどめられていた。名をドエグというエドム人で、サウルに属する牧者のつわものであった。","tok":[["そこ"],["に"],["は"],["その"],["日","ひ"],["、"],["サウル"],["の"],["家臣","かしん"],["の"],["一人","ひとり"],["が"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["とどめられて"],["いた"],["。"],["名","な"],["を"],["ドエグ"],["と"],["いう"],["エドム人","えどむにん"],["で"],["、"],["サウル"],["に"],["属する","ぞくする"],["牧者","ぼくしゃ"],["の"],["つわもの"],["で"],["あった"],["。"]]},{"verse":9,"text":"ダビデは更にアヒメレクに求めた。「ここに、あなたの手もとに、槍か剣がありますか。王の用件が急なことだったので、自分の剣も武器も取って来ることができなかったのです。」","tok":[["ダビデ"],["は"],["更に","さらに"],["アヒメレク"],["に"],["求めた","もとめた"],["。"],["「"],["ここ"],["に"],["、"],["あなた"],["の"],["手もと","てもと"],["に"],["、"],["槍","やり"],["か"],["剣","けん"],["が"],["あります"],["か"],["。"],["王","おう"],["の"],["用件","ようけん"],["が"],["急","きゅう"],["な"],["こと"],["だった"],["ので"],["、"],["自分","じぶん"],["の"],["剣","けん"],["も"],["武器","ぶき"],["も"],["取って","とって"],["来る","くる"],["こと"],["が"],["できなかった"],["の"],["です"],["。"],["」"]]},{"verse":10,"text":"祭司は言った。「エラの谷で、あなたが討ち取ったペリシテ人ゴリアトの剣なら、そこ、エフォドの後ろに布に包んであります。もしそれを持って行きたければ持って行ってください。そのほかには何もありません。」ダビデは言った。「それにまさるものはない。それをください。」","tok":[["祭司","さいし"],["は"],["言った","いった"],["。"],["「"],["エラ"],["の"],["谷","たに"],["で"],["、"],["あなた"],["が"],["討ち取った","うちとった"],["ペリシテ"],["人","にん"],["ゴリアト"],["の"],["剣","けん"],["なら"],["、"],["そこ"],["、"],["エフォド"],["の"],["後ろ","うしろ"],["に"],["布","ぬの"],["に"],["包んで","つつんで"],["あります"],["。"],["もし"],["それ"],["を"],["持って","もって"],["行きたければ","いきたければ"],["持って","もって"],["行って","いって"],["ください"],["。"],["その"],["ほか"],["に"],["は"],["何","なん"],["も"],["ありません"],["。"],["」"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["それ"],["に"],["まさる"],["もの"],["は"],["ない"],["。"],["それ"],["を"],["ください"],["。"],["」"]]},{"verse":11,"text":"ダビデは立ってその日のうちにサウルから逃れ、ガトの王アキシュのもとに来た。","tok":[["ダビデ"],["は"],["立って","たって"],["その"],["日","ひ"],["の"],["うち"],["に"],["サウル"],["から"],["逃れ","のがれ"],["、"],["ガト"],["の"],["王","おう"],["アキシュ"],["の"],["もと"],["に"],["来た","きた"],["。"]]},{"verse":12,"text":"アキシュの家臣は言った。「この男はかの地の王、ダビデではありませんか。この男についてみんなが踊りながら、『サウルは千を討ち、ダビデは万を討った』と歌ったのです。」","tok":[["アキシュ"],["の"],["家臣","かしん"],["は"],["言った","いった"],["。"],["「"],["この"],["男","おとこ"],["は"],["かの"],["地","ち"],["の"],["王","おう"],["、"],["ダビデ"],["で"],["は"],["ありません"],["か"],["。"],["この"],["男","おとこ"],["について"],["みんな"],["が"],["踊り","おどり"],["ながら"],["、"],["『"],["サウル"],["は"],["千","せん"],["を"],["討ち","うち"],["、"],["ダビデ"],["は"],["万","よろず"],["を"],["討った","うった"],["』"],["と"],["歌った","うたった"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"ダビデはこの言葉が心にかかり、ガトの王アキシュを大変恐れた。","tok":[["ダビデ"],["は"],["この"],["言葉","ことば"],["が"],["心","こころ"],["に"],["かかり"],["、"],["ガト"],["の"],["王","おう"],["アキシュ"],["を"],["大変","たいへん"],["恐れた","おそれた"],["。"]]},{"verse":14,"text":"そこで彼は、人々の前で変わったふるまいをした。彼らに捕らえられると、気が狂ったのだと見せかけ、ひげによだれを垂らしたり、城門の扉をかきむしったりした。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["、"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["変わった","かわった"],["ふるまい"],["を"],["した"],["。"],["彼","かれ"],["ら"],["に"],["捕らえられる","とらえられる"],["と"],["、"],["気","き"],["が"],["狂った","くるった"],["の"],["だ"],["と"],["見せかけ","みせかけ"],["、"],["ひげ"],["に"],["よだれ"],["を"],["垂らし","たらし"],["たり"],["、"],["城門","じょうもん"],["の"],["扉","とびら"],["を"],["かきむしっ"],["たり"],["した"],["。"]]},{"verse":15,"text":"アキシュは家臣に言った。「見てみろ、この男は気が狂っている。なぜ連れて来たのだ。","tok":[["アキシュ"],["は"],["家臣","かしん"],["に"],["言った","いった"],["。"],["「"],["見て","みて"],["みろ"],["、"],["この"],["男","おとこ"],["は"],["気","き"],["が"],["狂って","くるって"],["いる"],["。"],["なぜ"],["連れて","つれて"],["来た","きた"],["の"],["だ"],["。"]]},{"verse":16,"text":"わたしのもとに気の狂った者が不足しているとでもいうのか。わたしの前で狂態を見せようとして連れて来たのか。この男をわたしの家に入れようというのか。」","tok":[["わたし"],["の"],["もと"],["に"],["気","き"],["の"],["狂った","くるった"],["者","もの"],["が"],["不足","ふそく"],["して"],["いる"],["と"],["で"],["も"],["いう"],["の"],["か"],["。"],["わたし"],["の"],["前","まえ"],["で"],["狂態","きょうたい"],["を"],["見せよう","みせよう"],["として"],["連れて","つれて"],["来た","きた"],["の"],["か"],["。"],["この"],["男","おとこ"],["を"],["わたし"],["の"],["家","いえ"],["に"],["入れよう","いれよう"],["と"],["いう"],["の"],["か"],["。"],["」"]]}]
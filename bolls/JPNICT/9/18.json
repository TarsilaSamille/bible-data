[{"verse":1,"text":"ダビデがサウルと話し終えたとき、ヨナタンの魂はダビデの魂に結びつき、ヨナタンは自分自身のようにダビデを愛した。","tok":[["ダビデ"],["が"],["サウル"],["と"],["話し","はなし"],["終えた","おえた"],["とき"],["、"],["ヨナタン"],["の"],["魂","たましい"],["は"],["ダビデ"],["の"],["魂","たましい"],["に"],["結びつき","むすびつき"],["、"],["ヨナタン"],["は"],["自分","じぶん"],["自身","じしん"],["の"],["よう"],["に"],["ダビデ"],["を"],["愛した","あいした"],["。"]]},{"verse":2,"text":"サウルはその日、ダビデを召し抱え、父の家に帰ることを許さなかった。","tok":[["サウル"],["は"],["その"],["日","ひ"],["、"],["ダビデ"],["を"],["召し抱え","めしかかえ"],["、"],["父","ちち"],["の"],["家","いえ"],["に"],["帰る","かえる"],["こと"],["を"],["許さなかった","ゆるさなかった"],["。"]]},{"verse":3,"text":"ヨナタンはダビデを自分自身のように愛し、彼と契約を結び、","tok":[["ヨナタン"],["は"],["ダビデ"],["を"],["自分","じぶん"],["自身","じしん"],["の"],["よう"],["に"],["愛し","あいし"],["、"],["彼","かれ"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"]]},{"verse":4,"text":"着ていた上着を脱いで与え、また自分の装束を剣、弓、帯に至るまで与えた。","tok":[["着て","きて"],["いた"],["上着","うわぎ"],["を"],["脱いで","ぬいで"],["与え","あたえ"],["、"],["また"],["自分","じぶん"],["の"],["装束","しょうぞく"],["を"],["剣","けん"],["、"],["弓","ゆみ"],["、"],["帯","おび"],["に"],["至る","いたる"],["まで"],["与えた","あたえた"],["。"]]},{"verse":5,"text":"ダビデは、サウルが派遣するたびに出陣して勝利を収めた。サウルは彼を戦士の長に任命した。このことは、すべての兵士にも、サウルの家臣にも喜ばれた。","tok":[["ダビデ"],["は"],["、"],["サウル"],["が"],["派遣","はけん"],["する"],["たび"],["に"],["出陣","しゅつじん"],["して"],["勝利","しょうり"],["を"],["収めた","おさめた"],["。"],["サウル"],["は"],["彼","かれ"],["を"],["戦士","せんし"],["の"],["長","ちょう"],["に"],["任命","にんめい"],["した"],["。"],["この"],["こと"],["は"],["、"],["すべて"],["の"],["兵士","へいし"],["に"],["も"],["、"],["サウル"],["の"],["家臣","かしん"],["に"],["も"],["喜ばれた","よろこばれた"],["。"]]},{"verse":6,"text":"皆が戻り、あのペリシテ人を討ったダビデも帰って来ると、イスラエルのあらゆる町から女たちが出て来て、太鼓を打ち、喜びの声をあげ、三絃琴を奏で、歌い踊りながらサウル王を迎えた。","tok":[["皆","みな"],["が"],["戻り","もどり"],["、"],["あの"],["ペリシテ"],["人","にん"],["を"],["討った","うった"],["ダビデ"],["も"],["帰って","かえって"],["来る","くる"],["と"],["、"],["イスラエル"],["の"],["あらゆる"],["町","まち"],["から"],["女","おんな"],["たち"],["が"],["出て","でて"],["来て","きて"],["、"],["太鼓","たいこ"],["を"],["打ち","うち"],["、"],["喜び","よろこび"],["の"],["声","こえ"],["を"],["あげ"],["、"],["三絃","さんげん"],["琴","こと"],["を"],["奏で","かなで"],["、"],["歌い踊り","うたいおどり"],["ながら"],["サウル"],["王","おう"],["を"],["迎えた","むかえた"],["。"]]},{"verse":7,"text":"女たちは楽を奏し、歌い交わした。「サウルは千を討ちダビデは万を討った。」","tok":[["女","おんな"],["たち"],["は"],["楽","らく"],["を"],["奏し","そうし"],["、"],["歌い","うたい"],["交わした","かわした"],["。"],["「"],["サウル"],["は"],["千","せん"],["を"],["討ち","うち"],["ダビデ"],["は"],["万","よろず"],["を"],["討った","うった"],["。"],["」"]]},{"verse":8,"text":"サウルはこれを聞いて激怒し、悔しがって言った。「ダビデには万、わたしには千。あとは、王位を与えるだけか。」","tok":[["サウル"],["は"],["これ"],["を"],["聞いて","きいて"],["激怒","げきど"],["し"],["、"],["悔し","くやし"],["がっ"],["て"],["言った","いった"],["。"],["「"],["ダビデ"],["に"],["は"],["万","よろず"],["、"],["わたし"],["に"],["は"],["千","せん"],["。"],["あと"],["は"],["、"],["王位","おうい"],["を"],["与える","あたえる"],["だけ"],["か"],["。"],["」"]]},{"verse":9,"text":"この日以来、サウルはダビデをねたみの目で見るようになった。","tok":[["この"],["日","ひ"],["以来","いらい"],["、"],["サウル"],["は"],["ダビデ"],["を"],["ねたみ"],["の"],["目","め"],["で"],["見る","みる"],["よう"],["に"],["なった"],["。"]]},{"verse":10,"text":"次の日、神からの悪霊が激しくサウルに降り、家の中で彼をものに取りつかれた状態に陥れた。ダビデは傍らでいつものように竪琴を奏でていた。サウルは、槍を手にしていたが、","tok":[["次","つぎ"],["の"],["日","ひ"],["、"],["神","かみ"],["から"],["の"],["悪霊","あくりょう"],["が"],["激しく","はげしく"],["サウル"],["に"],["降り","ふり"],["、"],["家","いえ"],["の"],["中","なか"],["で"],["彼","かれ"],["を"],["もの"],["に"],["取りつかれた","とりつかれた"],["状態","じょうたい"],["に"],["陥れた","おとしいれた"],["。"],["ダビデ"],["は"],["傍ら","かたわら"],["で"],["いつも"],["の"],["よう"],["に"],["竪琴","たてごと"],["を"],["奏でて","かなでて"],["いた"],["。"],["サウル"],["は"],["、"],["槍","やり"],["を"],["手","て"],["に"],["して"],["いた"],["が"],["、"]]},{"verse":11,"text":"ダビデを壁に突き刺そうとして、その槍を振りかざした。ダビデは二度とも、身をかわした。","tok":[["ダビデ"],["を"],["壁","かべ"],["に"],["突き刺そう","つきさそう"],["として"],["、"],["その"],["槍","やり"],["を"],["振りかざした","ふりかざした"],["。"],["ダビデ"],["は"],["二","に"],["度","ど"],["とも"],["、"],["身","み"],["を"],["かわした"],["。"]]},{"verse":12,"text":"主はダビデと共におられ、サウルを離れ去られたので、サウルはダビデを恐れ、","tok":[["主","ぬし"],["は"],["ダビデ"],["と"],["共","とも"],["に"],["おられ"],["、"],["サウル"],["を"],["離れ去られた","はなれさられた"],["ので"],["、"],["サウル"],["は"],["ダビデ"],["を"],["恐れ","おそれ"],["、"]]},{"verse":13,"text":"ダビデを遠ざけ、千人隊の長に任命した。ダビデは兵士の先頭に立って出陣し、また帰還した。","tok":[["ダビデ"],["を"],["遠ざけ","とおざけ"],["、"],["千人隊","せんにんたい"],["の"],["長","ちょう"],["に"],["任命","にんめい"],["した"],["。"],["ダビデ"],["は"],["兵士","へいし"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["出陣","しゅつじん"],["し"],["、"],["また"],["帰還","きかん"],["した"],["。"]]},{"verse":14,"text":"主は彼と共におられ、彼はどの戦いにおいても勝利を収めた。","tok":[["主","ぬし"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["おられ"],["、"],["彼","かれ"],["は"],["どの"],["戦い","たたかい"],["に"],["おいて"],["も"],["勝利","しょうり"],["を"],["収めた","おさめた"],["。"]]},{"verse":15,"text":"サウルは、ダビデが勝利を収めるのを見て、彼を恐れた。","tok":[["サウル"],["は"],["、"],["ダビデ"],["が"],["勝利","しょうり"],["を"],["収める","おさめる"],["の"],["を"],["見て","みて"],["、"],["彼","かれ"],["を"],["恐れた","おそれた"],["。"]]},{"verse":16,"text":"イスラエルもユダも、すべての人がダビデを愛した。彼が出陣するにも帰還するにも彼らの先頭に立ったからである。","tok":[["イスラエル"],["も"],["ユダ"],["も"],["、"],["すべて"],["の"],["人","ひと"],["が"],["ダビデ"],["を"],["愛した","あいした"],["。"],["彼","かれ"],["が"],["出陣","しゅつじん"],["する"],["に"],["も"],["帰還","きかん"],["する"],["に"],["も"],["彼","かれ"],["ら"],["の"],["先頭","せんとう"],["に"],["立った","たった"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"サウルはダビデに言った。「わたしの長女メラブを、お前の妻として与えよう。わたしの戦士となり、主の戦いをたたかってくれ。」サウルは自分でダビデに手を下すことなく、ペリシテ人の手で殺そうと考えていた。","tok":[["サウル"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["の"],["長女","ちょうじょ"],["メラブ"],["を"],["、"],["お前","おまえ"],["の"],["妻","つま"],["として"],["与えよう","あたえよう"],["。"],["わたし"],["の"],["戦士","せんし"],["と"],["なり"],["、"],["主","ぬし"],["の"],["戦い","たたかい"],["を"],["たたかって"],["くれ"],["。"],["」"],["サウル"],["は"],["自分","じぶん"],["で"],["ダビデ"],["に"],["手","て"],["を"],["下す","くだす"],["こと"],["なく"],["、"],["ペリシテ"],["人","にん"],["の"],["手","て"],["で"],["殺そう","ころそう"],["と"],["考えて","かんがえて"],["いた"],["。"]]},{"verse":18,"text":"ダビデはサウルに言った。「わたしなど何者でしょう。わたしの一族、わたしの父の一族などイスラエルで何者でしょう。わたしが王の婿になるとは。」","tok":[["ダビデ"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["わたし"],["など"],["何者","なにもの"],["でしょう"],["。"],["わたし"],["の"],["一族","いちぞく"],["、"],["わたし"],["の"],["父","ちち"],["の"],["一族","いちぞく"],["など"],["イスラエル"],["で"],["何者","なにもの"],["でしょう"],["。"],["わたし"],["が"],["王","おう"],["の"],["婿","むこ"],["に"],["なる"],["と"],["は"],["。"],["」"]]},{"verse":19,"text":"ところが、サウルの娘メラブはダビデに嫁ぐべきときに、メホラ人アドリエルに嫁がせられた。","tok":[["ところ"],["が"],["、"],["サウル"],["の"],["娘","むすめ"],["メラブ"],["は"],["ダビデ"],["に"],["嫁ぐべき","とつぐべき"],["とき"],["に"],["、"],["メホラ人","めほらにん"],["アドリエル"],["に"],["嫁がせられた","とつがせられた"],["。"]]},{"verse":20,"text":"サウルの娘ミカルはダビデを愛していた。それをサウルに告げる者があり、サウルは好都合だと思った。","tok":[["サウル"],["の"],["娘","むすめ"],["ミカル"],["は"],["ダビデ"],["を"],["愛して","あいして"],["いた"],["。"],["それ"],["を"],["サウル"],["に"],["告げる","つげる"],["者","もの"],["が"],["あり"],["、"],["サウル"],["は"],["好都合","こうつごう"],["だ"],["と"],["思った","おもった"],["。"]]},{"verse":21,"text":"サウルは、「彼女を与えてダビデを罠にかけ、ペリシテ人の手にかけよう」と考え、ダビデに言った。「二番目の娘を嫁にし、その日わたしの婿になりなさい。」","tok":[["サウル"],["は"],["、"],["「"],["彼女","かのじょ"],["を"],["与えて","あたえて"],["ダビデ"],["を"],["罠","わな"],["に"],["かけ"],["、"],["ペリシテ"],["人","にん"],["の"],["手","て"],["に"],["かけよう"],["」"],["と"],["考え","かんがえ"],["、"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["二番目","にばんめ"],["の"],["娘","むすめ"],["を"],["嫁","よめ"],["に"],["し"],["、"],["その"],["日","ひ"],["わたし"],["の"],["婿","むこ"],["に"],["なり"],["なさい"],["。"],["」"]]},{"verse":22,"text":"サウルは家臣に命じた。「ダビデにひそかにこう言え。『王はあなたが気に入っておられるし、家臣たちも皆、あなたを愛しているのだから、王の婿になってください。』」","tok":[["サウル"],["は"],["家臣","かしん"],["に"],["命じた","めいじた"],["。"],["「"],["ダビデ"],["に"],["ひそか"],["に"],["こう"],["言え","いえ"],["。"],["『"],["王","おう"],["は"],["あなた"],["が"],["気","き"],["に"],["入って","いって"],["おられる"],["し"],["、"],["家臣","かしん"],["たち"],["も"],["皆","みな"],["、"],["あなた"],["を"],["愛して","あいして"],["いる"],["の"],["だ"],["から"],["、"],["王","おう"],["の"],["婿","むこ"],["に"],["なって"],["ください"],["。"],["』"],["」"]]},{"verse":23,"text":"サウルの家臣はこれらの言葉をダビデの耳に入れた。ダビデは言った。「王の婿になることが、あなたたちの目には容易なことと見えるのですか。わたしは貧しく、身分も低い者です。」","tok":[["サウル"],["の"],["家臣","かしん"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["ダビデ"],["の"],["耳","みみ"],["に"],["入れた","いれた"],["。"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["王","おう"],["の"],["婿","むこ"],["に"],["なる"],["こと"],["が"],["、"],["あなた"],["たち"],["の"],["目","め"],["に"],["は"],["容易","ようい"],["な"],["こと"],["と"],["見える","みえる"],["の"],["です"],["か"],["。"],["わたし"],["は"],["貧しく","まずしく"],["、"],["身分","みぶん"],["も"],["低い","ひ
[{"verse":1,"text":"サムエルは全イスラエルに向かって言った。「わたしは、あなたたちがわたしに求めたことについては、すべてあなたたちの声に従い、あなたたちの上に王を立てた。","tok":[["サムエル"],["は"],["全","ぜん"],["イスラエル"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["たち"],["が"],["わたし"],["に"],["求めた","もとめた"],["こと"],["について"],["は"],["、"],["すべて"],["あなた"],["たち"],["の"],["声","こえ"],["に"],["従い","したがい"],["、"],["あなた"],["たち"],["の"],["上","うえ"],["に"],["王","おう"],["を"],["立てた","たてた"],["。"]]},{"verse":2,"text":"今からは王が、あなたたちを率いて歩む。わたしは年老いて、髪も白くなった。そして、息子たちはあなたたちと共にいる。わたしは若いころから今日まであなたたちを率いて歩んできたが、","tok":[["今","いま"],["から"],["は"],["王","おう"],["が"],["、"],["あなた"],["たち"],["を"],["率いて","ひきいて"],["歩む","あゆむ"],["。"],["わたし"],["は"],["年老いて","としおいて"],["、"],["髪","かみ"],["も"],["白く","しろく"],["なった"],["。"],["そして"],["、"],["息子","むすこ"],["たち"],["は"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いる"],["。"],["わたし"],["は"],["若い","わかい"],["ころ"],["から"],["今日","きょう"],["まで"],["あなた"],["たち"],["を"],["率いて","ひきいて"],["歩んで","あゆんで"],["きた"],["が"],["、"]]},{"verse":3,"text":"今、主と主が油を注がれた方の前で、わたしを訴えなさい。わたしが、だれかの牛を取り上げたことがあるか。だれかのろばを取り上げたことがあるか。だれかを抑えつけ、だれかを踏みにじったことがあるか。だれかの手から賄賂を取って何かを見逃してやったことがあるか。あるなら、償おう。」","tok":[["今","いま"],["、"],["主","ぬし"],["と"],["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["方","ほう"],["の"],["前","まえ"],["で"],["、"],["わたし"],["を"],["訴え","うったえ"],["なさい"],["。"],["わたし"],["が"],["、"],["だれ"],["か"],["の"],["牛","うし"],["を"],["取り上げた","とりあげた"],["こと"],["が"],["ある"],["か"],["。"],["だれ"],["か"],["の"],["ろば"],["を"],["取り上げた","とりあげた"],["こと"],["が"],["ある"],["か"],["。"],["だれ"],["か"],["を"],["抑えつけ","おさえつけ"],["、"],["だれ"],["か"],["を"],["踏みにじった","ふみにじった"],["こと"],["が"],["ある"],["か"],["。"],["だれ"],["か"],["の"],["手","て"],["から"],["賄賂","わいろ"],["を"],["取って","とって"],["何","なん"],["か"],["を"],["見逃して","みのがして"],["やった"],["こと"],["が"],["ある"],["か"],["。"],["あるなら"],["、"],["償おう","つぐなおう"],["。"],["」"]]},{"verse":4,"text":"彼らは答えた。「あなたは我々を抑えつけたことも、踏みにじったこともありませんでした。だれの手からも何一つ取り上げたりしませんでした。」","tok":[["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["は"],["我々","われわれ"],["を"],["抑えつけた","おさえつけた"],["こと"],["も"],["、"],["踏みにじった","ふみにじった"],["こと"],["も"],["ありませんでした"],["。"],["だれ"],["の"],["手","て"],["から"],["も"],["何","なん"],["一","ひと"],["つ"],["取り上げ","とりあげ"],["たり"],["しませんでした"],["。"],["」"]]},{"verse":5,"text":"サムエルは言った。「今日、あなたたちがわたしの手に何一つ訴えるべきことを見いださなかったことについては、主が証人であり、主が油を注がれた方が証人だ。」彼らは答えた。「確かに証人です。」","tok":[["サムエル"],["は"],["言った","いった"],["。"],["「"],["今日","きょう"],["、"],["あなた"],["たち"],["が"],["わたし"],["の"],["手","て"],["に"],["何","なん"],["一","ひと"],["つ"],["訴えるべき","うったえるべき"],["こと"],["を"],["見いださなかった","みいださなかった"],["こと"],["について"],["は"],["、"],["主","ぬし"],["が"],["証人","しょうにん"],["で"],["あり"],["、"],["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["方","ほう"],["が"],["証人","しょうにん"],["だ"],["。"],["」"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["確か","たしか"],["に"],["証人","しょうにん"],["です"],["。"],["」"]]},{"verse":6,"text":"サムエルは民に話した。「主は、モーセとアロンを用いて、あなたたちの先祖をエジプトから導き上った方だ。","tok":[["サムエル"],["は"],["民","みん"],["に"],["話した","はなした"],["。"],["「"],["主","ぬし"],["は"],["、"],["モーセ"],["と"],["アロン"],["を"],["用いて","もちいて"],["、"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["から"],["導き","みちびき"],["上った","のぼった"],["方","ほう"],["だ"],["。"]]},{"verse":7,"text":"さあ、しっかり立ちなさい。主があなたたちとその先祖とに行われた救いの御業のすべてを、主の御前で説き聞かせよう。","tok":[["さあ"],["、"],["しっかり"],["立ち","たち"],["なさい"],["。"],["主","ぬし"],["が"],["あなた"],["たち"],["と"],["その"],["先祖","せんぞ"],["と"],["に"],["行われた","おこなわれた"],["救い","すくい"],["の"],["御業","ごごう"],["の"],["すべて"],["を"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["説き聞かせよう","とききかせよう"],["。"]]},{"verse":8,"text":"ヤコブがエジプトに移り住み、その後、先祖が主に助けを求めて叫んだとき、主はモーセとアロンとをお遣わしになり、二人はあなたがたの先祖をエジプトから導き出してこの地に住まわせた。","tok":[["ヤコブ"],["が"],["エジプト"],["に"],["移り住み","うつりすみ"],["、"],["その"],["後","ご"],["、"],["先祖","せんぞ"],["が"],["主に","おもに"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んだ","さけんだ"],["とき"],["、"],["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["と"],["を"],["お遣わし","おつかわし"],["に"],["なり"],["、"],["二人","ふたり"],["は"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["から"],["導き出して","みちびきだして"],["この"],["地","ち"],["に"],["住まわせた","すまわせた"],["。"]]},{"verse":9,"text":"しかし、あなたたちの先祖が自分たちの神、主を忘れたので、主がハツォルの軍の司令官シセラ、ペリシテ人、モアブの王の手に彼らを売り渡し、彼らと戦わせられた。","tok":[["しかし"],["、"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["が"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["忘れた","わすれた"],["ので"],["、"],["主","ぬし"],["が"],["ハツォル"],["の"],["軍","ぐん"],["の"],["司令官","しれいかん"],["シセラ"],["、"],["ペリシテ"],["人","にん"],["、"],["モアブ"],["の"],["王","おう"],["の"],["手","て"],["に"],["彼","かれ"],["ら"],["を"],["売り渡し","うりわたし"],["、"],["彼","かれ"],["ら"],["と"],["戦わせられた","たたかわせられた"],["。"]]},{"verse":10,"text":"彼らが主に向かって叫び、『我々は罪を犯しました。主を捨て、バアルとアシュトレトに仕えました。どうか今、敵の手から救い出してください。我々はあなたに仕えます』と言うと、","tok":[["彼","かれ"],["ら"],["が"],["主に","おもに"],["向かって","むかって"],["叫び","さけび"],["、"],["『"],["我々","われわれ"],["は"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["主","ぬし"],["を"],["捨て","すて"],["、"],["バアル"],["と"],["アシュトレト"],["に"],["仕えました","つかえました"],["。"],["どう"],["か"],["今","いま"],["、"],["敵","てき"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["ください"],["。"],["我々","われわれ"],["は"],["あなた"],["に"],["仕えます","つかえます"],["』"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":11,"text":"主はエルバアル、ベダン、エフタ、サムエルを遣わし、あなたたちを周囲の敵の手から救い出してくださった。それであなたたちは安全に住めるようになった。","tok":[["主","ぬし"],["は"],["エルバアル"],["、"],["ベダン"],["、"],["エフタ"],["、"],["サムエル"],["を"],["遣わし","つかわし"],["、"],["あなた"],["たち"],["を"],["周囲","しゅうい"],["の"],["敵","てき"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["くださった"],["。"],["それ"],["で"],["あなた"],["たち"],["は"],["安全","あんぜん"],["に"],["住める","すめる"],["よう"],["に"],["なった"],["。"]]},{"verse":12,"text":"ところが、アンモン人の王ナハシュが攻めて来たのを見ると、あなたたちの神、主があなたたちの王であるにもかかわらず、『いや、王が我々の上に君臨すべきだ』とわたしに要求した。","tok":[["ところ"],["が"],["、"],["アンモン"],["人","にん"],["の"],["王","おう"],["ナハシュ"],["が"],["攻めて","せめて"],["来た","きた"],["の"],["を"],["見る","みる"],["と"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["の"],["王","おう"],["で"],["ある"],["に"],["も"],["かかわらず"],["、"],["『"],["いや"],["、"],["王","おう"],["が"],["我々","われわれ"],["の"],["上","うえ"],["に"],["君臨","くんりん"],["すべきだ"],["』"],["と"],["わたし"],["に"],["要求","ようきゅう"],["した"],["。"]]},{"verse":13,"text":"今、見よ、あなたたちが求め、選んだ王がここにいる。主はあなたたちに王をお与えになる。","tok":[["今","いま"],["、"],["見よ","みよ"],["、"],["あなた"],["たち"],["が"],["求め","もとめ"],["、"],["選んだ","えらんだ"],["王","おう"],["が"],["ここ"],["に"],["いる"],["。"],["主","ぬし"],["は"],["あなた"],["たち"],["に"],["王","おう"],["を"],["お与え","おあたえ"],["に"],["なる"],["。"]]},{"verse":14,"text":"だから、あなたたちが主を畏れ、主に仕え、御声に聞き従い、主の御命令に背かず、あなたたちもあなたたちの上に君臨する王も、あなたたちの神、主に従うならそれでよい。","tok":[["だ"],["から"],["、"],["あなた"],["たち"],["が"],["主","ぬし"],["を"],["畏れ","おそれ"],["、"],["主に","おもに"],["仕え","つかえ"],["、"],["御声","おこえ"],["に"],["聞き従い","ききしたがい"],["、"],["主","ぬし"],["の"],["御命令","ごめいれい"],["に"],["背かず","そむかず"],["、"],["あなた"],["たち"],["も"],["あなた"],["たち"],["の"],["上","うえ"],["に"],["君臨","くんりん"],["する"],["王","おう"],["も"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["従うなら","したがうなら"],["それ"],["で"],["よい"],["。"]]},{"verse":15,"text":"しかし、もし主の御声に聞き従わず、主の御命令に背くなら、主の御手は、あなたたちの先祖に下ったように、あなたたちにも下る。","tok":[["しかし"],["、"],["もし"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["主","ぬし"],["の"],["御命令","ごめいれい"],["に"],["背くなら","そむくなら"],["、"],["主","ぬし"],["の"],["御手","おて"],["は"],["、"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["に"],["下った","くだった"],["よう"],["に"],["、"],["あなた"],["たち"],["に"],["も"],["下る","くだる"],["。"]]},{"verse":16,"text":"さあ、しっかり立って、主があなたたちの目の前で行われる偉大な御業を見なさい。","tok":[["さあ"],["、"],["しっかり"],["立って","たって"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["行われる","おこなわれる"],["偉大","いだい"],["な"],["御業","ごごう"],["を"],["見","み"],["なさい"],["。"]]},{"verse":17,"text":"今は小麦の刈り入れの時期ではないか。しかし、わたしが主に呼び求めると、主は雷と雨とを下される。それを見てあなたたちは、自分たちのために王を求めて主の御前に犯した悪の大きかったことを知り、悟りなさい。」","tok":[["今","いま"],["は"],["小麦","こむぎ"],["の"],["刈り入れ","かりいれ"],["の"],["時期","じき"],["で"],["は"],["ない"],["か"],["。"],["しかし"],["、"],["わたし"],["が"],["主に","おもに"],["呼び求める","よびもとめる"],["と"],["、"],["主","ぬし"],["は"],["雷","かみなり"],["と"],["雨","あめ"],["と"],["を"],["下される","くだされる"],["。"],["それ"],["を"],["見て","みて"],["あなた"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["王","おう"],["を"],["求めて","もとめて"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["犯した","おかした"],["悪","あく"],["の"],["大きかった","おおきかった"],["こと"],["を"],["知り","しり"],["、"],["悟り","さとり"],["なさい"],["。"],["」"]]},{"verse":18,"text":"サムエルが主に呼び求めると、その日、主は雷と雨を下された。民は皆、主とサムエルを非常に恐れた。","tok":[["サムエル"],["が"],["主に","おもに"],["呼び求める","よびもとめる"],["と"],["、"],["その"],["日","ひ"],["、"],["主","ぬし"],["は"],["雷","かみなり"],["と"],["雨","あめ"],["を"],["下された","くだされた"],["。"],["民","たみ"],["は"],["皆","みな"],["、"],["主","ぬし"],["と"],["サムエル"],["を"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":19,"text":"民は皆、サムエルに願った。「僕たちのために、あなたの神、主に祈り、我々が死なないようにしてください。確かに、我々はあらゆる重い罪の上に、更に王を求めるという悪を加えました。」","tok":[["民","みん"],["は"],["皆","みな"],["、"],["サムエル"],["に"],["願った","ねがった"],["。"],["「"],["僕たち","ぼくたち"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈り","いのり"],["、"],["我々","われわれ"],["が"],["死なない","しなない"],["よう"],["に"],["して"],["ください"],["。"],["確か","たしか"],["に"],["、"],["我々","われわれ"],["は"],["あらゆる"],["重い","おもい"],["罪","つみ"],["の"],["上","うえ"],["に"],["、"],["更に","さらに"],["王","おう"],["を"],["求める","もとめる"],["と"],["いう"],["悪","わる"],["を"],["加えました","くわえました"],["。"],["」"]]},{"verse":20,"text":"サムエルは民に言った。「恐れるな。あなたたちはこのような悪を行ったが、今後は、それることなく主に付き従い、心を尽くして主に仕えなさい。","tok":[["サムエル"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["恐れる","おそれる"],["な"],["。"],["あなた"],["たち"],["は"],["この"],["よう"],["な"],["悪","わる"],["を"],["行った","おこなった"],["が"],["、"],["今後","こんご"],["は"],["、"],["それる"],["こと"],["なく"],["主に","おもに"],["付き従い","つきしたがい"],["、"],["心","こころ"],["を"],["尽くして","つくして"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":21,"text":"むなしいものを慕ってそれて行ってはならない。それはむなしいのだから何の力もなく、救う力もない。","tok":[["むなしい"],["もの"],["を"],["慕って","したって"],["それ"],["て"],["行って","いって"],["は"],["ならない"],["。"],["それ"],["は"],["むなしい"],["の"],["だ"],["から"],["何","なん"],["の"],["力","ちから"],["も"],["なく"],["、"],["救う","すくう"],["力","ちから"],["も"],["ない"],["。"]]},{"verse":22,"text":"主はその偉大な御名のゆえに、御自分の民を決しておろそかにはなさらない。主はあなたたちを御自分の民と決めておられるからである。","tok":[["主","ぬし"],["は"],["その"],["偉大","いだい"],["な"],["御名","ぎょめい"],["の"],["ゆえ"],["に"],["、"],["御自分","ごじぶん"],["の"],["民","たみ"],["を"],["決して","けっして"],["おろそか"],["に"],["は"],["なさらない"],["。"],["主","ぬし"],["は"],["あなた"],["たち"],["を"],["御自分","ごじぶん"],["の"],["民","たみ"],["と"],["決めて","きめて"],["おられる"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"わたしもまた、あなたたちのために祈ることをやめ、主に対して罪を犯すようなことは決してしない。あなたたちに正しく善い道を教えよう。","tok":[["わたし"],["も"],["また"],["、"],["あなた"],["たち"],["の"],["ため"],["に"],["祈る","いのる"],["こと"],["を"],["やめ"],["、"],["主に","おもに"],["対して","たいして"],["罪","つみ"],["を"],["犯す","おかす"],["よう"],["な"],["こと"],["は"],["決して","けっして"],["しない"],["。"],["あなた"],["たち"],["に"],["正しく","ただしく"],["善い","よい"],["道","みち"],["を"],["教えよう","おしえよう"],["。"]]},{"verse":24,"text":"主を畏れ、心を尽くし、まことをもって主に仕えなさい。主がいかに偉大なことをあなたたちに示されたかを悟りなさい。","tok":[["主","ぬし"],["を"],["畏れ","おそれ"],["、"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["まこと"],["を"],["もって"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"],["主","ぬし"],["が"],["いかに"],["偉大","いだい"],["な"],["こと"],["を"],["あなた"],["たち"],["に"],["示された","しめされた"],["か"],["を"],["悟り","さとり"],["なさい"],["。"]]},{"verse":25,"text":"悪を重ねるなら、主はあなたたちもあなたたちの王も滅ぼし去られるであろう。」","tok":[["悪","あく"],["を"],["重ねるなら","かさねるなら"],["、"],["主","ぬし"],["は"],["あなた"],["たち"],["も"],["あなた"],["たち"],["の"],["王","おう"],["も"],["滅ぼし去られるで","ほろぼしさられるで"],["あろう"],["。"],["」"]]}]
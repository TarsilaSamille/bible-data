[{"verse":1,"text":"サウルは、息子のヨナタンと家臣の全員に、ダビデを殺すようにと命じた。しかし、サウルの息子ヨナタンはダビデに深い愛情を抱いていたので、","tok":[["サウル"],["は"],["、"],["息子","むすこ"],["の"],["ヨナタン"],["と"],["家臣","かしん"],["の"],["全員","ぜんいん"],["に"],["、"],["ダビデ"],["を"],["殺す","ころす"],["よう"],["に"],["と"],["命じた","めいじた"],["。"],["しかし"],["、"],["サウル"],["の"],["息子","むすこ"],["ヨナタン"],["は"],["ダビデ"],["に"],["深い","ふかい"],["愛情","あいじょう"],["を"],["抱いて","いだいて"],["いた"],["ので"],["、"]]},{"verse":2,"text":"ダビデにこのことを告げた。「わたしの父サウルはあなたを殺そうとねらっている。朝になったら注意して隠れ場にとどまり、見つからないようにしていなさい。","tok":[["ダビデ"],["に"],["この"],["こと"],["を"],["告げた","つげた"],["。"],["「"],["わたし"],["の"],["父","ちち"],["サウル"],["は"],["あなた"],["を"],["殺そう","ころそう"],["と"],["ねらって"],["いる"],["。"],["朝","あさ"],["に"],["なったら"],["注意","ちゅうい"],["して"],["隠れ場","かくれば"],["に"],["とどまり"],["、"],["見つからない","みつからない"],["よう"],["に"],["して"],["い"],["なさい"],["。"]]},{"verse":3,"text":"あなたのいる野原にわたしは出て行って父の傍らに立ち、あなたについて父に話してみる。様子を見て、あなたに知らせよう。」","tok":[["あなた"],["の"],["いる"],["野原","のはら"],["に"],["わたし"],["は"],["出て","でて"],["行って","いって"],["父","ちち"],["の"],["傍ら","かたわら"],["に"],["立ち","たち"],["、"],["あなた"],["について"],["父","ちち"],["に"],["話して","はなして"],["みる"],["。"],["様子","ようす"],["を"],["見て","みて"],["、"],["あなた"],["に"],["知らせよう","しらせよう"],["。"],["」"]]},{"verse":4,"text":"ヨナタンは父サウルにダビデをかばって話した。「王がその僕であるダビデのゆえに、罪を犯したりなさいませんように。彼は父上に対して罪を犯していないばかりか、大変お役に立っているのです。","tok":[["ヨナタン"],["は"],["父","ちち"],["サウル"],["に"],["ダビデ"],["を"],["かばって"],["話した","はなした"],["。"],["「"],["王","おう"],["が"],["その"],["僕","ぼく"],["で"],["ある"],["ダビデ"],["の"],["ゆえ"],["に"],["、"],["罪","つみ"],["を"],["犯し","おかし"],["たり"],["なさいません"],["よう"],["に"],["。"],["彼","かれ"],["は"],["父上","ちちじょう"],["に対して","にたいして"],["罪","つみ"],["を"],["犯して","おかして"],["いない"],["ばかり"],["か"],["、"],["大変","たいへん"],["お役","おやく"],["に"],["立って","たって"],["いる"],["の"],["です"],["。"]]},{"verse":5,"text":"彼が自分の命をかけてあのペリシテ人を討ったから、主はイスラエルの全軍に大勝利をお与えになったのです。あなたはそれを見て、喜び祝われたではありませんか。なぜ、罪なき者の血を流し、理由もなくダビデを殺して、罪を犯そうとなさるのですか。」","tok":[["彼","かれ"],["が"],["自分","じぶん"],["の"],["命","いのち"],["を"],["かけて"],["あの"],["ペリシテ"],["人","にん"],["を"],["討った","うった"],["から"],["、"],["主","ぬし"],["は"],["イスラエル"],["の"],["全軍","ぜんぐん"],["に"],["大勝利","だいしょうり"],["を"],["お与え","おあたえ"],["に"],["なった"],["の"],["です"],["。"],["あなた"],["は"],["それ"],["を"],["見て","みて"],["、"],["喜び祝われたで","よろこびいわわれたで"],["は"],["ありません"],["か"],["。"],["なぜ"],["、"],["罪","つみ"],["なき"],["者","もの"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["理由","りゆう"],["も"],["なく"],["ダビデ"],["を"],["殺して","ころして"],["、"],["罪","つみ"],["を"],["犯そう","おかそう"],["と"],["なさる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":6,"text":"サウルはヨナタンの言葉を聞き入れて誓った。「主は生きておられる。彼を殺しはしない。」","tok":[["サウル"],["は"],["ヨナタン"],["の"],["言葉","ことば"],["を"],["聞き入れて","ききいれて"],["誓った","ちかった"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["彼","かれ"],["を"],["殺し","ころし"],["は"],["しない"],["。"],["」"]]},{"verse":7,"text":"ヨナタンはダビデを呼んで、これをすべて彼に告げた。ヨナタンはサウルのもとにダビデを連れて行き、ダビデはこれまでどおりサウルに仕えることになった。","tok":[["ヨナタン"],["は"],["ダビデ"],["を"],["呼んで","よんで"],["、"],["これ"],["を"],["すべて"],["彼","かれ"],["に"],["告げた","つげた"],["。"],["ヨナタン"],["は"],["サウル"],["の"],["もと"],["に"],["ダビデ"],["を"],["連れて","つれて"],["行き","いき"],["、"],["ダビデ"],["は"],["これ"],["まで"],["どおり"],["サウル"],["に"],["仕える","つかえる"],["こと"],["に"],["なった"],["。"]]},{"verse":8,"text":"戦いは続いて起こったが、ダビデはペリシテ人を討つために出陣し、大打撃を与えたので、彼らはダビデを恐れて逃げた。","tok":[["戦い","たたかい"],["は"],["続いて","つづいて"],["起こった","おこった"],["が"],["、"],["ダビデ"],["は"],["ペリシテ"],["人","にん"],["を"],["討つ","うつ"],["ため"],["に"],["出陣","しゅつじん"],["し"],["、"],["大","だい"],["打撃","だげき"],["を"],["与えた","あたえた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ダビデ"],["を"],["恐れて","おそれて"],["逃げた","にげた"],["。"]]},{"verse":9,"text":"ときに、主からの悪霊がサウルに降った。サウルは館で槍を手にして座り、ダビデはその傍らで竪琴を奏でていた。","tok":[["とき"],["に"],["、"],["主","ぬし"],["から"],["の"],["悪霊","あくりょう"],["が"],["サウル"],["に"],["降った","ふった"],["。"],["サウル"],["は"],["館","やかた"],["で"],["槍","やり"],["を"],["手","て"],["に"],["して"],["座り","すわり"],["、"],["ダビデ"],["は"],["その"],["傍ら","かたわら"],["で"],["竪琴","たてごと"],["を"],["奏でて","かなでて"],["いた"],["。"]]},{"verse":10,"text":"そのとき、サウルがダビデを壁に突き刺そうとねらったが、ダビデはサウルを避け、槍は壁に突き刺さった。ダビデは逃げ、その夜は難を免れた。","tok":[["その"],["とき"],["、"],["サウル"],["が"],["ダビデ"],["を"],["壁","かべ"],["に"],["突き刺そう","つきさそう"],["と"],["ねらった"],["が"],["、"],["ダビデ"],["は"],["サウル"],["を"],["避け","さけ"],["、"],["槍","やり"],["は"],["壁","かべ"],["に"],["突き刺さった","つきささった"],["。"],["ダビデ"],["は"],["逃げ","にげ"],["、"],["その"],["夜","よる"],["は"],["難","なん"],["を"],["免れた","まぬがれた"],["。"]]},{"verse":11,"text":"サウルはダビデの家に使者を遣わし、彼を見張らせ、翌朝には殺させようとした。ダビデの妻ミカルはダビデに言った。「今夜中に避難して自分の命を守らなければ、明日は殺されます。」","tok":[["サウル"],["は"],["ダビデ"],["の"],["家","いえ"],["に"],["使者","ししゃ"],["を"],["遣わし","つかわし"],["、"],["彼","かれ"],["を"],["見張らせ","みはらせ"],["、"],["翌朝","よくあさ"],["に"],["は"],["殺させよう","ころさせよう"],["と"],["した"],["。"],["ダビデ"],["の"],["妻","つま"],["ミカル"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["今夜中","こんやちゅう"],["に"],["避難","ひなん"],["して"],["自分","じぶん"],["の"],["命","いのち"],["を"],["守らなければ","まもらなければ"],["、"],["明日","あす"],["は"],["殺されます","ころされます"],["。"],["」"]]},{"verse":12,"text":"ミカルはダビデを窓からつり降ろし、彼は逃げて難を免れた。","tok":[["ミカル"],["は"],["ダビデ"],["を"],["窓","まど"],["から"],["つり"],["降ろし","おろし"],["、"],["彼","かれ"],["は"],["逃げて","にげて"],["難","なん"],["を"],["免れた","まぬがれた"],["。"]]},{"verse":13,"text":"ミカルはテラフィムを寝床に置き、その頭に山羊の毛をかぶせ、それを着物で覆った。","tok":[["ミカル"],["は"],["テラフィム"],["を"],["寝床","ねどこ"],["に"],["置き","おき"],["、"],["その"],["頭","あたま"],["に"],["山羊","やぎ"],["の"],["毛","け"],["を"],["かぶせ"],["、"],["それ"],["を"],["着物","きもの"],["で"],["覆った","おおった"],["。"]]},{"verse":14,"text":"サウルは使者を遣わしてダビデを捕らえようとしたが、ミカルは、「彼は病気です」と言った。","tok":[["サウル"],["は"],["使者","ししゃ"],["を"],["遣わして","つかわして"],["ダビデ"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["が"],["、"],["ミカル"],["は"],["、"],["「"],["彼","かれ"],["は"],["病気","びょうき"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"サウルはダビデを見舞うのだといって使者を遣わしたが、「ダビデを寝床のままわたしのもとに担ぎ込め。殺すのだ」と命じていた。","tok":[["サウル"],["は"],["ダビデ"],["を"],["見舞う","みまう"],["の"],["だ"],["と"],["いって"],["使者","ししゃ"],["を"],["遣わした","つかわした"],["が"],["、"],["「"],["ダビデ"],["を"],["寝床","ねどこ"],["の"],["まま"],["わたし"],["の"],["もと"],["に"],["担ぎ込め","かつぎこめ"],["。"],["殺す","ころす"],["の"],["だ"],["」"],["と"],["命じて","めいじて"],["いた"],["。"]]},{"verse":16,"text":"使者が来てみると、寝床には山羊の毛を頭にかぶせたテラフィムが置かれていた。","tok":[["使者","ししゃ"],["が"],["来て","きて"],["みる"],["と"],["、"],["寝床","ねどこ"],["に"],["は"],["山羊","やぎ"],["の"],["毛","け"],["を"],["頭","あたま"],["に"],["かぶせた"],["テラフィム"],["が"],["置かれて","おかれて"],["いた"],["。"]]},{"verse":17,"text":"サウルはミカルに言った。「このようなことをしてわたしを欺いたのはなぜだ。なぜお前はわたしの敵を逃がし、避難させたのか。」ミカルはサウルに言った。「あの人は、『わたしを逃がせ。さもないとお前を殺す』と脅しました。」","tok":[["サウル"],["は"],["ミカル"],["に"],["言った","いった"],["。"],["「"],["この"],["よう"],["な"],["こと"],["を"],["して"],["わたし"],["を"],["欺いた","あざむいた"],["の"],["は"],["なぜ"],["だ"],["。"],["なぜ"],["お前","おまえ"],["は"],["わたし"],["の"],["敵","てき"],["を"],["逃がし","にがし"],["、"],["避難","ひなん"],["させた"],["の"],["か"],["。"],["」"],["ミカル"],["は"],["サウル"],["に"],["言った","いった"],["。"],["「"],["あの"],["人","ひと"],["は"],["、"],["『"],["わたし"],["を"],["逃がせ","にがせ"],["。"],["さも"],["ない"],["と"],["お前","おまえ"],["を"],["殺す","ころす"],["』"],["と"],["脅しました","おどしました"],["。"],["」"]]},{"verse":18,"text":"逃げて難を避けたダビデは、ラマのサムエルのもとに行って、サウルの仕打ちをすべて報告した。サムエルとダビデはナヨトに行き、そこにとどまった。","tok":[["逃げて","にげて"],["難","なん"],["を"],["避けた","さけた"],["ダビデ"],["は"],["、"],["ラマ"],["の"],["サムエル"],["の"],["もと"],["に"],["行って","いって"],["、"],["サウル"],["の"],["仕打ち","しうち"],["を"],["すべて"],["報告","ほうこく"],["した"],["。"],["サムエル"],["と"],["ダビデ"],["は"],["ナヨト"],["に"],["行き","いき"],["、"],["そこ"],["に"],["とどまった"],["。"]]},{"verse":19,"text":"ラマのナヨトにダビデがいる、とサウルに告げる者があり、","tok":[["ラマ"],["の"],["ナヨト"],["に"],["ダビデ"],["が"],["いる"],["、"],["と"],["サウル"],["に"],["告げる","つげる"],["者","もの"],["が"],["あり"],["、"]]},{"verse":20,"text":"サウルはダビデを捕らえようと使者を遣わした。彼らは預言者の一団が預言しているのに出会った。サムエルが彼らの先頭に立っていた。神の霊はサウルの使者の上にも降り、彼らも預言する状態になった。","tok":[["サウル"],["は"],["ダビデ"],["を"],["捕らえよう","とらえよう"],["と"],["使者","ししゃ"],["を"],["遣わした","つかわした"],["。"],["彼","かれ"],["ら"],["は"],["預言者","よげんしゃ"],["の"],["一団","いちだん"],["が"],["預言","よげん"],["して"],["いる"],["のに"],["出会った","であった"],["。"],["サムエル"],["が"],["彼","かれ"],["ら"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["いた"],["。"],["神","かみ"],["の"],["霊","れい"],["は"],["サウル"],["の"],["使者","ししゃ"],["の"],["上","うえ"],["に"],["も"],["降り","ふり"],["、"],["彼","かれ"],["ら"],["も"],["預言","よげん"],["する"],["状態","じょうたい"],["に"],["なった"],["。"]]},{"verse":21,"text":"サウルはこの報告を受けて、他の使者を遣わしたが、彼らもまた預言する状態になった。三度、サウルは追っ手を送ったが、彼らもまた預言する状態になった。","tok":[["サウル"],["は"],["この"],["報告","ほうこく"],["を"],["受けて","うけて"],["、"],["他","た"],["の"],["使者","ししゃ"],["を"],["遣わした","つかわした"],["が"],["、"],["彼","かれ"],["ら"],["も"],["また"],["預言","よげん"],["する"],["状態","じょうたい"],["に"],["なった"],["。"],["三","さん"],["度","ど"],["、"],["サウル"],["は"],["追っ手","おって"],["を"],["送った","おくった"],["が"],["、"],["彼","かれ"],["ら"],["も"],["また"],["預言","よげん"],["する"],["状態","じょうたい"],["に"],["なった"],["。"]]},{"verse":22,"text":"ついに、サウル自身がラマに向かい、セクの大井戸まで来て、「サムエルとダビデはどこにいるのか」と尋ねた。「ラマのナヨトです」という答えを聞き、","tok":[["ついに"],["、"],["サウル"],["自身","じしん"],["が"],["ラマ"],["に"],["向かい","むかい"],["、"],["セク"],["の"],["大井戸","おおいど"],["まで"],["来て","きて"],["、"],["「"],["サムエル"],["と"],["ダビデ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["「"],["ラマ"],["の"],["ナヨト"],["です"],["」"],["と"],["いう"],["答え","こたえ"],["を"],["聞き","きき"],["、"]]},{"verse":23,"text":"サウルはラマのナヨトに向かってそこを去ったが、彼の上にも神の霊が降り、彼は預言する状態になったまま、ラマのナヨトまで歩き続けた。","tok":[["サウル"],["は"],["ラマ"],["の"],["ナヨト"],["に"],["向かって","むかって"],["そこ"],["を"],["去った","さった"],["が"],["、"],["彼","かれ"],["の"],["上","うえ"],["に"],["も"],["神","かみ"],["の"],["霊","れい"],["が"],["降り","ふり"],["、"],["彼","かれ"],["は"],["預言","よげん"],["する"],["状態","じょうたい"],["に"],["なった"],["まま"],["、"],["ラマ"],["の"],["ナヨト"],["まで"],["歩き","あるき"],["続けた","つづけた"],["。"]]},{"verse":24,"text":"彼は着物を脱ぎ捨て、預言する状態になったまま、その日は一昼夜、サムエルの前に裸のままで倒れていた。このため、「サウルもまた預言者の仲間か」と人々は言った。","tok":[["彼","かれ"],["は"],["着物","きもの"],["を"],["脱ぎ捨て","ぬぎすて"],["、"],["預言","よげん"],["する"],["状態","じょうたい"],["に"],["なった"],["まま"],["、"],["その"],["日","ひ"],["は"],["一昼夜","いっちゅうや"],["、"],["サムエル"],["の"],["前","まえ"],["に"],["裸","はだか"],["の"],["まま"],["で"],["倒れて","たおれて"],["いた"],["。"],["この"],["ため"],["、"],["「"],["サウル"],["も"],["また"],["預言者","よげんしゃ"],["の"],["仲間","なかま"],["か"],["」"],["と"],["人々","ひとびと"],["は"],["言った","いった"],["。"]]}]
[{"verse":1,"text":"サムエルは年老い、イスラエルのために裁きを行う者として息子たちを任命した。","tok":[["サムエル"],["は"],["年老い","としおい"],["、"],["イスラエル"],["の"],["ため"],["に"],["裁き","さばき"],["を"],["行う","おこなう"],["者","もの"],["として"],["息子","むすこ"],["たち"],["を"],["任命","にんめい"],["した"],["。"]]},{"verse":2,"text":"長男の名はヨエル、次男の名はアビヤといい、この二人はベエル‧シェバで裁きを行った。","tok":[["長男","ちょうなん"],["の"],["名","な"],["は"],["ヨエル"],["、"],["次男","じなん"],["の"],["名","な"],["は"],["アビヤ"],["と"],["いい"],["、"],["この"],["二人","ふたり"],["は"],["ベエル"],["‧"],["シェバ"],["で"],["裁き","さばき"],["を"],["行った","おこなった"],["。"]]},{"verse":3,"text":"しかし、この息子たちは父の道を歩まず、不正な利益を求め、賄賂を取って裁きを曲げた。","tok":[["しかし"],["、"],["この"],["息子","むすこ"],["たち"],["は"],["父","ちち"],["の"],["道","みち"],["を"],["歩まず","あゆまず"],["、"],["不正","ふせい"],["な"],["利益","りえき"],["を"],["求め","もとめ"],["、"],["賄賂","わいろ"],["を"],["取って","とって"],["裁き","さばき"],["を"],["曲げた","まげた"],["。"]]},{"verse":4,"text":"イスラエルの長老は全員集まり、ラマのサムエルのもとに来て、","tok":[["イスラエル"],["の"],["長老","ちょうろう"],["は"],["全員","ぜんいん"],["集まり","あつまり"],["、"],["ラマ"],["の"],["サムエル"],["の"],["もと"],["に"],["来て","きて"],["、"]]},{"verse":5,"text":"彼に申し入れた。「あなたは既に年を取られ、息子たちはあなたの道を歩んでいません。今こそ、ほかのすべての国々のように、我々のために裁きを行う王を立ててください。」","tok":[["彼","かれ"],["に"],["申し入れた","もうしいれた"],["。"],["「"],["あなた"],["は"],["既に","すでに"],["年","とし"],["を"],["取られ","とられ"],["、"],["息子","むすこ"],["たち"],["は"],["あなた"],["の"],["道","みち"],["を"],["歩んで","あゆんで"],["いません"],["。"],["今","いま"],["こそ"],["、"],["ほか"],["の"],["すべて"],["の"],["国々","くにぐに"],["の"],["よう"],["に"],["、"],["我々","われわれ"],["の"],["ため"],["に"],["裁き","さばき"],["を"],["行う","おこなう"],["王","おう"],["を"],["立てて","たてて"],["ください"],["。"],["」"]]},{"verse":6,"text":"裁きを行う王を与えよとの彼らの言い分は、サムエルの目には悪と映った。そこでサムエルは主に祈った。","tok":[["裁き","さばき"],["を"],["行う","おこなう"],["王","おう"],["を"],["与えよ","あたえよ"],["と"],["の"],["彼","かれ"],["ら"],["の"],["言い分","いいぶん"],["は"],["、"],["サムエル"],["の"],["目","め"],["に"],["は"],["悪","あく"],["と"],["映った","うつった"],["。"],["そこ"],["で"],["サムエル"],["は"],["主に","おもに"],["祈った","いのった"],["。"]]},{"verse":7,"text":"主はサムエルに言われた。「民があなたに言うままに、彼らの声に従うがよい。彼らが退けたのはあなたではない。彼らの上にわたしが王として君臨することを退けているのだ。","tok":[["主","ぬし"],["は"],["サムエル"],["に"],["言われた","いわれた"],["。"],["「"],["民","みん"],["が"],["あなた"],["に"],["言う","いう"],["まま"],["に"],["、"],["彼","かれ"],["ら"],["の"],["声","こえ"],["に"],["従う","したがう"],["が"],["よい"],["。"],["彼","かれ"],["ら"],["が"],["退けた","しりぞけた"],["の"],["は"],["あなた"],["で"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["わたし"],["が"],["王","おう"],["として"],["君臨","くんりん"],["する"],["こと"],["を"],["退けて","しりぞけて"],["いる"],["の"],["だ"],["。"]]},{"verse":8,"text":"彼らをエジプトから導き上った日から今日に至るまで、彼らのすることといえば、わたしを捨てて他の神々に仕えることだった。あなたに対しても同じことをしているのだ。","tok":[["彼","かれ"],["ら"],["を"],["エジプト"],["から"],["導き","みちびき"],["上った","のぼった"],["日","ひ"],["から"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["彼","かれ"],["ら"],["の"],["する"],["こと"],["と"],["いえば"],["、"],["わたし"],["を"],["捨てて","すてて"],["他","ほか"],["の"],["神々","かみがみ"],["に"],["仕える","つかえる"],["こと"],["だった"],["。"],["あなた"],["に対して","にたいして"],["も"],["同じ","おなじ"],["こと"],["を"],["して"],["いる"],["の"],["だ"],["。"]]},{"verse":9,"text":"今は彼らの声に従いなさい。ただし、彼らにはっきり警告し、彼らの上に君臨する王の権能を教えておきなさい。」","tok":[["今","いま"],["は"],["彼","かれ"],["ら"],["の"],["声","こえ"],["に"],["従い","したがい"],["なさい"],["。"],["ただし"],["、"],["彼","かれ"],["ら"],["に"],["はっきり"],["警告","けいこく"],["し"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["君臨","くんりん"],["する"],["王","おう"],["の"],["権能","けんのう"],["を"],["教えて","おしえて"],["おき"],["なさい"],["。"],["」"]]},{"verse":10,"text":"サムエルは王を要求する民に、主の言葉をことごとく伝えた。","tok":[["サムエル"],["は"],["王","おう"],["を"],["要求","ようきゅう"],["する"],["民","たみ"],["に"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["ことごとく"],["伝えた","つたえた"],["。"]]},{"verse":11,"text":"彼はこう告げた。「あなたたちの上に君臨する王の権能は次のとおりである。まず、あなたたちの息子を徴用する。それは、戦車兵や騎兵にして王の戦車の前を走らせ、","tok":[["彼","かれ"],["は"],["こう"],["告げた","つげた"],["。"],["「"],["あなた"],["たち"],["の"],["上","うえ"],["に"],["君臨","くんりん"],["する"],["王","おう"],["の"],["権能","けんのう"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["まず"],["、"],["あなた"],["たち"],["の"],["息子","むすこ"],["を"],["徴用","ちょうよう"],["する"],["。"],["それ"],["は"],["、"],["戦車兵","せんしゃへい"],["や"],["騎兵","きへい"],["に"],["して"],["王","おう"],["の"],["戦車","せんしゃ"],["の"],["前","まえ"],["を"],["走らせ","はしらせ"],["、"]]},{"verse":12,"text":"千人隊の長、五十人隊の長として任命し、王のための耕作や刈り入れに従事させ、あるいは武器や戦車の用具を造らせるためである。","tok":[["千人隊","せんにんたい"],["の"],["長","ちょう"],["、"],["五","ご"],["十人隊","じゅうにんたい"],["の"],["長","ちょう"],["として"],["任命","にんめい"],["し"],["、"],["王","おう"],["の"],["ため"],["の"],["耕作","こうさく"],["や"],["刈り入れ","かりいれ"],["に"],["従事","じゅうじ"],["させ"],["、"],["あるいは"],["武器","ぶき"],["や"],["戦車","せんしゃ"],["の"],["用具","ようぐ"],["を"],["造らせる","つくらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"また、あなたたちの娘を徴用し、香料作り、料理女、パン焼き女にする。","tok":[["また"],["、"],["あなた"],["たち"],["の"],["娘","むすめ"],["を"],["徴用","ちょうよう"],["し"],["、"],["香料","こうりょう"],["作り","つくり"],["、"],["料理女","りょうりじょ"],["、"],["パン焼き","ぱんやき"],["女","おんな"],["に"],["する"],["。"]]},{"verse":14,"text":"また、あなたたちの最上の畑、ぶどう畑、オリーブ畑を没収し、家臣に分け与える。","tok":[["また"],["、"],["あなた"],["たち"],["の"],["最上","さいじょう"],["の"],["畑","はたけ"],["、"],["ぶどう"],["畑","はたけ"],["、"],["オリーブ"],["畑","はたけ"],["を"],["没収","ぼっしゅう"],["し"],["、"],["家臣","かしん"],["に"],["分け与える","わけあたえる"],["。"]]},{"verse":15,"text":"また、あなたたちの穀物とぶどうの十分の一を徴収し、重臣や家臣に分け与える。","tok":[["また"],["、"],["あなた"],["たち"],["の"],["穀物","こくもつ"],["と"],["ぶどう"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["徴収","ちょうしゅう"],["し"],["、"],["重臣","じゅうしん"],["や"],["家臣","かしん"],["に"],["分け与える","わけあたえる"],["。"]]},{"verse":16,"text":"あなたたちの奴隷、女奴隷、若者のうちのすぐれた者や、ろばを徴用し、王のために働かせる。","tok":[["あなた"],["たち"],["の"],["奴隷","どれい"],["、"],["女","じょ"],["奴隷","どれい"],["、"],["若者","わかもの"],["の"],["うち"],["の"],["すぐれた"],["者","もの"],["や"],["、"],["ろば"],["を"],["徴用","ちょうよう"],["し"],["、"],["王","おう"],["の"],["ため"],["に"],["働かせる","はたらかせる"],["。"]]},{"verse":17,"text":"また、あなたたちの羊の十分の一を徴収する。こうして、あなたたちは王の奴隷となる。","tok":[["また"],["、"],["あなた"],["たち"],["の"],["羊","ひつじ"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["徴収","ちょうしゅう"],["する"],["。"],["こう"],["して"],["、"],["あなた"],["たち"],["は"],["王","おう"],["の"],["奴隷","どれい"],["と"],["なる"],["。"]]},{"verse":18,"text":"その日あなたたちは、自分が選んだ王のゆえに、泣き叫ぶ。しかし、主はその日、あなたたちに答えてはくださらない。」","tok":[["その"],["日","ひ"],["あなた"],["たち"],["は"],["、"],["自分","じぶん"],["が"],["選んだ","えらんだ"],["王","おう"],["の"],["ゆえ"],["に"],["、"],["泣き叫ぶ","なきさけぶ"],["。"],["し
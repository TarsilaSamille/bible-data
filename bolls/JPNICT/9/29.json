[{"verse":1,"text":"ペリシテ人は、その軍勢をすべてアフェクに集結させた。イスラエル軍は、イズレエルにある一つの泉の傍らに陣を敷いた。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["その"],["軍勢","ぐんぜい"],["を"],["すべて"],["アフェク"],["に"],["集結","しゅうけつ"],["させた"],["。"],["イスラエル"],["軍","ぐん"],["は"],["、"],["イズレエル"],["に"],["ある"],["一","ひと"],["つ"],["の"],["泉","いずみ"],["の"],["傍ら","かたわら"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"]]},{"verse":2,"text":"ペリシテの武将たちはおのおの百人隊、千人隊を率いて進み、ダビデとその兵はアキシュと共にしんがりを進んだ。","tok":[["ペリシテ"],["の"],["武将","ぶしょう"],["たち"],["は"],["おのおの"],["百人隊","ひゃくにんたい"],["、"],["千人隊","せんにんたい"],["を"],["率いて","ひきいて"],["進み","すすみ"],["、"],["ダビデ"],["と"],["その"],["兵","へい"],["は"],["アキシュ"],["と"],["共","とも"],["に"],["しんがり"],["を"],["進んだ","すすんだ"],["。"]]},{"verse":3,"text":"ペリシテの武将たちは尋ねた。「このヘブライ人らは何者だ。」アキシュがペリシテの武将たちに答えた。「イスラエルの王サウルの僕であったダビデだ。彼はこの一、二年、わたしのもとにいるが、身を寄せて来たときから今日まで、わたしは彼に何の欠点も見いだせない。」","tok":[["ペリシテ"],["の"],["武将","ぶしょう"],["たち"],["は"],["尋ねた","たずねた"],["。"],["「"],["この"],["ヘブライ"],["人","にん"],["ら"],["は"],["何者","なにもの"],["だ"],["。"],["」"],["アキシュ"],["が"],["ペリシテ"],["の"],["武将","ぶしょう"],["たち"],["に"],["答えた","こたえた"],["。"],["「"],["イスラエル"],["の"],["王","おう"],["サウル"],["の"],["僕","ぼく"],["で"],["あった"],["ダビデ"],["だ"],["。"],["彼","かれ"],["は"],["この"],["一","いち"],["、"],["二","に"],["年","ねん"],["、"],["わたし"],["の"],["もと"],["に"],["いる"],["が"],["、"],["身","み"],["を"],["寄せて","よせて"],["来た","きた"],["とき"],["から"],["今日","きょう"],["まで"],["、"],["わたし"],["は"],["彼","かれ"],["に"],["何","なん"],["の"],["欠点","けってん"],["も"],["見いだせない","みいだせない"],["。"],["」"]]},{"verse":4,"text":"だが、ペリシテの武将たちはいらだってアキシュに言った。「この男は帰らせるべきだ。彼をもともと配置した所に戻せ。我々と共に戦いに向かわせるな。戦いの最中に裏切られてはならない。この男が元の主人に再び迎え入れられるには、ここにいる兵士たちの首を差し出すだけで十分ではないか。","tok":[["だ"],["が"],["、"],["ペリシテ"],["の"],["武将","ぶしょう"],["たち"],["は"],["いらだって"],["アキシュ"],["に"],["言った","いった"],["。"],["「"],["この"],["男","おとこ"],["は"],["帰らせるべきだ","かえらせるべきだ"],["。"],["彼","かれ"],["を"],["もともと"],["配置","はいち"],["した"],["所","ところ"],["に"],["戻せ","もどせ"],["。"],["我々","われわれ"],["と"],["共","とも"],["に"],["戦い","たたかい"],["に"],["向かわせる","むかわせる"],["な"],["。"],["戦い","たたかい"],["の"],["最中","さいちゅう"],["に"],["裏切られて","うらぎられて"],["は"],["ならない"],["。"],["この"],["男","おとこ"],["が"],["元","もと"],["の"],["主人","しゅじん"],["に"],["再び","ふたたび"],["迎え入れられる","むかえいれられる"],["に"],["は"],["、"],["ここ"],["に"],["いる"],["兵士","へいし"],["たち"],["の"],["首","くび"],["を"],["差し出す","さしだす"],["だけ"],["で"],["十分","じゅうぶん"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":5,"text":"『サウルは千を討ち、ダビデは万を討った』と人々が歌い踊ったあのダビデではないか。」","tok":[["『"],["サウル"],["は"],["千","せん"],["を"],["討ち","うち"],["、"],["ダビデ"],["は"],["万","よろず"],["を"],["討った","うった"],["』"],["と"],["人々","ひとびと"],["が"],["歌い踊った","うたいおどった"],["あの"],["ダビデ"],["で"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":6,"text":"アキシュはダビデを呼んで言った。「主は生きておられる。お前はまっすぐな人間だし、わたしと共に戦いに参加するのをわたしは喜んでいる。わたしのもとに来たときから今日まで、何ら悪意は見られなかった。だが、武将たちはお前を好まない。","tok":[["アキシュ"],["は"],["ダビデ"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["お前","おまえ"],["は"],["まっすぐ"],["な"],["人間","にんげん"],["だ"],["し"],["、"],["わたし"],["と"],["共","とも"],["に"],["戦い","たたかい"],["に"],["参加","さんか"],["する"],["の"],["を"],["わたし"],["は"],["喜んで","よろこんで"],["いる"],["。"],["わたし"],["の"],["もと"],["に"],["来た","きた"],["とき"],["から"],["今日","きょう"],["まで"],["、"],["何","なん"],["ら"],["悪意","あくい"],["は"],["見られなかった","みられなかった"],["。"],["だ"],["が"],["、"],["武将","ぶしょう"],["たち"],["は"],["お前","おまえ"],["を"],["好まない","このまない"],["。"]]},{"verse":7,"text":"今は、平和に帰ってほしい。ペリシテの武将たちの好まないことをしてはならない。」","tok":[["今","いま"],["は"],["、"],["平和","へいわ"],["に"],["帰って","かえって"],["ほしい"],["。"],["ペリシテ"],["の"],["武将","ぶしょう"],["たち"],["の"],["好まない","このまない"],["こと"],["を"],["して"],["は"],["ならない"],["。"],["」"]]},{"verse":8,"text":"ダビデはアキシュに言った。「わたしが何をしたとおっしゃるのですか。あなたに仕えた日から今日までに、どのような間違いが僕にあって、わが主君、王の敵と戦うために出てはならないというのでしょう。」","tok":[["ダビデ"],["は"],["アキシュ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["が"],["何","なん"],["を"],["した"],["と"],["おっしゃる"],["の"],["です"],["か"],["。"],["あなた"],["に"],["仕えた","つかえた"],["日","ひ"],["から"],["今日","きょう"],["まで"],["に"],["、"],["どのような"],["間違い","まちがい"],["が"],["僕","ぼく"],["に"],["あって"],["、"],["わが"],["主君","しゅくん"],["、"],["王","おう"],["の"],["敵","てき"],["と"],["戦う","たたかう"],["ため"],["に"],["出て","でて"],["は"],["ならない"],["と"],["いう"],["の"],["でしょう"],["。"],["」"]]},{"verse":9,"text":"アキシュはダビデに答えた。「わたしには分かっている。お前は神の御使いのように良い人間だ。しかし、ペリシテの武将たちは、『彼は、我々と共に戦いに上ってはならない』と言うのだ。","tok":[["アキシュ"],["は"],["ダビデ"],["に"],["答えた","こたえた"],["。"],["「"],["わたし"],["に"],["は"],["分かって","わかって"],["いる"],["。"],["お前","おまえ"],["は"],["神","かみ"],["の"],["御使い","おつかい"],["の"],["よう"],["に"],["良い","よい"],["人間","にんげん"],["だ"],["。"],["しかし"],["、"],["ペリシテ"],["の"],["武将","ぶしょう"],["たち"],["は"],["、"],["『"],["彼","かれ"],["は"],["、"],["我々","われわれ"],["と"],["共","とも"],["に"],["戦い","たたかい"],["に"],["上って","のぼって"],["は"],["ならない"],["』"],["と"],["言う","いう"],["の"],["だ"],["。"]]},{"verse":10,"text":"だからお前も、お前と一緒に来たお前の主君の部下も、明日の朝早く起きて、日が昇ったら出発しなさい。」","tok":[["だ"],["から"],["お前","おまえ"],["も"],["、"],["お前","おまえ"],["と"],["一緒","いっしょ"],["に"],["来た","きた"],["お前","おまえ"],["の"],["主君","しゅくん"],["の"],["部下","ぶか"],["も"],["、"],["明日","あす"],["の"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["、"],["日","ひ"],["が"],["昇ったら","のぼったら"],["出発","しゅっぱつ"],["し"],["なさい"],["。"],["」"]]},{"verse":11,"text":"ダビデとその兵は朝早く起きて出発し、ペリシテの地へ引き返して行った。ペリシテ軍はイズレエルに向かった。","tok":[["ダビデ"],["と"],["その"],["兵","へい"],["は"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["出発","しゅっぱつ"],["し"],["、"],["ペリシテ"],["の"],["地","ち"],["へ"],["引き返して","ひきかえして"],["行った","いった"],["。"],["ペリシテ"],["軍","ぐん"],["は"],["イズレエル"],["に"],["向かった","むかった"],["。"]]}]
[{"verse":1,"text":"ソロモン王はファラオの娘のほかにもモアブ人、アンモン人、エドム人、シドン人、ヘト人など多くの外国の女を愛した。","tok":[["ソロモン"],["王","おう"],["は"],["ファラオ"],["の"],["娘","むすめ"],["の"],["ほか"],["に"],["も"],["モアブ人","もあぶにん"],["、"],["アンモン"],["人","にん"],["、"],["エドム人","えどむにん"],["、"],["シドン人","しどんにん"],["、"],["ヘト人","へとにん"],["など"],["多く","おおく"],["の"],["外国","がいこく"],["の"],["女","おんな"],["を"],["愛した","あいした"],["。"]]},{"verse":2,"text":"これらの諸国の民については、主がかつてイスラエルの人々に、「あなたたちは彼らの中に入って行ってはならない。彼らをあなたたちの中に入れてはならない。彼らは必ずあなたたちの心を迷わせ、彼らの神々に向かわせる」と仰せになったが、ソロモンは彼女たちを愛してそのとりことなった。","tok":[["これ"],["ら"],["の"],["諸国","しょこく"],["の"],["民","たみ"],["について"],["は"],["、"],["主","ぬし"],["が"],["かつて"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["、"],["「"],["あなた"],["たち"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["入って","はいって"],["行って","いって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["を"],["あなた"],["たち"],["の"],["中","なか"],["に"],["入れて","いれて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["必ず","かならず"],["あなた"],["たち"],["の"],["心","こころ"],["を"],["迷わせ","まよわせ"],["、"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["に"],["向かわせる","むかわせる"],["」"],["と"],["仰せ","おおせ"],["に"],["なった"],["が"],["、"],["ソロモン"],["は"],["彼女","かのじょ"],["たち"],["を"],["愛して","あいして"],["その"],["とりこ"],["と"],["なった"],["。"]]},{"verse":3,"text":"彼には妻たち、すなわち七百人の王妃と三百人の側室がいた。この妻たちが彼の心を迷わせた。","tok":[["彼","かれ"],["に"],["は"],["妻たち","つまたち"],["、"],["すなわち"],["七百人","ななひゃくにん"],["の"],["王妃","おうひ"],["と"],["三百人","さんひゃくにん"],["の"],["側室","そくしつ"],["が"],["いた"],["。"],["この"],["妻たち","つまたち"],["が"],["彼","かれ"],["の"],["心","こころ"],["を"],["迷わせた","まよわせた"],["。"]]},{"verse":4,"text":"ソロモンが老境に入ったとき、彼女たちは王の心を迷わせ、他の神々に向かわせた。こうして彼の心は、父ダビデの心とは異なり、自分の神、主と一つではなかった。","tok":[["ソロモン"],["が"],["老境","ろうきょう"],["に"],["入った","はいった"],["とき"],["、"],["彼女","かのじょ"],["たち"],["は"],["王","おう"],["の"],["心","こころ"],["を"],["迷わせ","まよわせ"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["向かわせた","むかわせた"],["。"],["こう"],["して"],["彼","かれ"],["の"],["心","こころ"],["は"],["、"],["父","ちち"],["ダビデ"],["の"],["心","こころ"],["と"],["は"],["異なり","ことなり"],["、"],["自分","じぶん"],["の"],["神","かみ"],["、"],["主","ぬし"],["と"],["一","ひと"],["つ"],["で"],["は"],["なかった"],["。"]]},{"verse":5,"text":"ソロモンは、シドン人の女神アシュトレト、アンモン人の憎むべき神ミルコムに従った。","tok":[["ソロモン"],["は"],["、"],["シドン人","しどんにん"],["の"],["女神","めがみ"],["アシュトレト"],["、"],["アンモン"],["人","にん"],["の"],["憎むべき","にくむべき"],["神","かみ"],["ミルコム"],["に"],["従った","したがった"],["。"]]},{"verse":6,"text":"ソロモンは主の目に悪とされることを行い、父ダビデのようには主に従い通さなかった。","tok":[["ソロモン"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行い","おこない"],["、"],["父","ちち"],["ダビデ"],["の"],["よう"],["に"],["は"],["主に","おもに"],["従い","したがい"],["通さなかった","とおさなかった"],["。"]]},{"verse":7,"text":"そのころ、ソロモンは、モアブ人の憎むべき神ケモシュのために、エルサレムの東の山に聖なる高台を築いた。アンモン人の憎むべき神モレクのためにもそうした。","tok":[["その"],["ころ"],["、"],["ソロモン"],["は"],["、"],["モアブ人","もあぶにん"],["の"],["憎むべき","にくむべき"],["神","かみ"],["ケモシュ"],["の"],["ため"],["に"],["、"],["エルサレム"],["の"],["東","ひがし"],["の"],["山","やま"],["に"],["聖","せい"],["なる"],["高台","たかだい"],["を"],["築いた","きずいた"],["。"],["アンモン"],["人","にん"],["の"],["憎むべき","にくむべき"],["神","かみ"],["モレク"],["の"],["ため"],["に"],["も"],["そう"],["した"],["。"]]},{"verse":8,"text":"また、外国生まれの妻たちすべてのためにも同様に行ったので、彼女らは、自分たちの神々に香をたき、いけにえをささげた。","tok":[["また"],["、"],["外国","がいこく"],["生まれ","うまれ"],["の"],["妻たち","つまたち"],["すべて"],["の"],["ため"],["に"],["も"],["同様","どうよう"],["に"],["行った","おこなった"],["ので"],["、"],["彼女","かのじょ"],["ら"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["、"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":9,"text":"ソロモンの心は迷い、イスラエルの神、主から離れたので、主は彼に対してお怒りになった。主は二度も彼に現れ、","tok":[["ソロモン"],["の"],["心","こころ"],["は"],["迷い","まよい"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["から"],["離れた","はなれた"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["に対して","にたいして"],["お怒り","おいかり"],["に"],["なった"],["。"],["主","ぬし"],["は"],["二","に"],["度","ど"],["も"],["彼","かれ"],["に"],["現れ","あらわれ"],["、"]]},{"verse":10,"text":"他の神々に従ってはならないと戒められたが、ソロモンは主の戒めを守らなかった。","tok":[["他","ほか"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["は"],["ならない"],["と"],["戒められた","いましめられた"],["が"],["、"],["ソロモン"],["は"],["主","ぬし"],["の"],["戒め","いましめ"],["を"],["守らなかった","まもらなかった"],["。"]]},{"verse":11,"text":"そこで、主は仰せになった。「あなたがこのようにふるまい、わたしがあなたに授けた契約と掟を守らなかったゆえに、わたしはあなたから王国を裂いて取り上げ、あなたの家臣に渡す。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["あなた"],["が"],["この"],["よう"],["に"],["ふるまい"],["、"],["わたし"],["が"],["あなた"],["に"],["授けた","さずけた"],["契約","けいやく"],["と"],["掟","おきて"],["を"],["守らなかった","まもらなかった"],["ゆえ"],["に"],["、"],["わたし"],["は"],["あなた"],["から"],["王国","おうこく"],["を"],["裂いて","さいて"],["取り上げ","とりあげ"],["、"],["あなた"],["の"],["家臣","かしん"],["に"],["渡す","わたす"],["。"]]},{"verse":12,"text":"あなたが生きている間は父ダビデのゆえにそうしないでおくが、あなたの息子の時代にはその手から王国を裂いて取り上げる。","tok":[["あなた"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["父","ちち"],["ダビデ"],["の"],["ゆえ"],["に"],["そう"],["しないで"],["おく"],["が"],["、"],["あなた"],["の"],["息子","むすこ"],["の"],["時代","じだい"],["に"],["は"],["その"],["手","て"],["から"],["王国","おうこく"],["を"],["裂いて","さいて"],["取り上げる","とりあげる"],["。"]]},{"verse":13,"text":"ただし、王国全部を裂いて取り上げることはしない。わが僕ダビデのゆえに、わたしが選んだ都エルサレムのゆえに、あなたの息子に一つの部族を与える。」","tok":[["ただし"],["、"],["王国","おうこく"],["全部","ぜんぶ"],["を"],["裂いて","さいて"],["取り上げる","とりあげる"],["こと"],["は"],["しない"],["。"],["わが"],["僕","ぼく"],["ダビデ"],["の"],["ゆえ"],["に"],["、"],["わたし"],["が"],["選んだ","えらんだ"],["都","と"],["エルサレム"],["の"],["ゆえ"],["に"],["、"],["あなた"],["の"],["息子","むすこ"],["に"],["一","ひと"],["つ"],["の"],["部族","ぶぞく"],["を"],["与える","あたえる"],["。"],["」"]]},{"verse":14,"text":"こうして主は、ソロモンに敵対する者としてエドム人ハダドを起こされた。彼はエドムの王家の血筋を引く者であった。","tok":[["こう"],["して"],["主","ぬし"],["は"],["、"],["ソロモン"],["に"],["敵対","てきたい"],["する"],["者","もの"],["として"],["エドム人","えどむにん"],["ハダド"],["を"],["起こされた","おこされた"],["。"],["彼","かれ"],["は"],["エドム"],["の"],["王家","おうけ"],["の"],["血筋","ちすじ"],["を"],["引く","ひく"],["者","もの"],["で"],["あった"],["。"]]},{"verse":15,"text":"かつてダビデがエドムを征服したとき、軍の司令官ヨアブが戦死者を葬るために上って行き、エドムの男子をことごとく打ち殺した。","tok":[["かつて"],["ダビデ"],["が"],["エドム"],["を"],["征服","せいふく"],["した"],["とき"],["、"],["軍","ぐん"],["の"],["司令官","しれいかん"],["ヨアブ"],["が"],["戦死者","せんししゃ"],["を"],["葬る","ほうむる"],["ため"],["に"],["上って","のぼって"],["行き","いき"],["、"],["エドム"],["の"],["男子","だんし"],["を"],["ことごとく"],["打ち殺した","うちころした"],["。"]]},{"verse":16,"text":"ヨアブは、すべてのイスラエル人と共に六か月にわたり駐留し、エドムのすべての男子を滅ぼした。","tok":[["ヨアブ"],["は"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["と"],["共","とも"],["に"],["六","ろく"],["か月","かげつ"],["に"],["わたり"],["駐留","ちゅうりゅう"],["し"],["、"],["エドム"],["の"],["すべて"],["の"],["男子","だんし"],["を"],["滅ぼした","ほろぼした"],["。"]]},{"verse":17,"text":"このとき少年であったハダドは、父の家臣のエドム人数人と共に逃亡し、エジプトに向かった。","tok":[["この"],["とき"],["少年","しょうねん"],["で"],["あった"],["ハダド"],["は"],["、"],["父","ちち"],["の"],["家臣","かしん"],["の"],["エドム人","えどむにん"],["数人","かずひと"],["と"],["共","とも"],["に"],["逃亡","とうぼう"],["し"],["、"],["エジプト"],["に"],["向かった","むかった"],["。"]]},{"verse":18,"text":"ミディアンを出発してパランに行き、パランから同行する従者たちを加えてエジプトに入り、エジプト王ファラオのもとに来た。ファラオは、彼に住まいを与え、食糧を手配し、土地を与えた。","tok":[["ミディアン"],["を"],["出発","しゅっぱつ"],["して"],["パラン"],["に"],["行き","いき"],["、"],["パラン"],["から"],["同行","どうこう"],["する"],["従者","じゅうしゃ"],["たち"],["を"],["加えて","くわえて"],["エジプト"],["に"],["入り","はいり"],["、"],["エジプト"],["王","おう"],["ファラオ"],["の"],["もと"],["に"],["来た","きた"],["。"],["ファラオ"],["は"],["、"],["彼","かれ"],["に"],["住まい","すまい"],["を"],["与え","あたえ"],["、"],["食糧","しょくりょう"],["を"],["手配","てはい"],["し"],["、"],["土地","とち"],["を"],["与えた","あたえた"],["。"]]},{"verse":19,"text":"ハダドは、ファラオに大変気に入られ、ファラオの妻、王妃タフペネスの妹を妻として与えられた。","tok":[["ハダド"],["は"],["、"],["ファラオ"],["に"],["大変","たいへん"],["気","き"],["に"],["入られ","いられ"],["、"],["ファラオ"],["の"],["妻","つま"],["、"],["王妃","おうひ"],["タフペネス"],["の"],["妹","いもうと"],["を"],["妻","つま"],["として"],["与えられた","あたえられた"],["。"]]},{"verse":20,"text":"タフペネスの妹は、彼との間に男児ゲヌバトを産み、タフペネスはその子をファラオの宮殿の中で育てた。ゲヌバトは、ファラオの宮殿でその王子たちの中に加わっていた。","tok":[["タフペネス"],["の"],["妹","いもうと"],["は"],["、"],["彼","かれ"],["と"],["の"],["間","あいだ"],["に"],["男児","だんじ"],["ゲヌバト"],["を"],["産み","うみ"],["、"],["タフペネス"],["は"],["その"],["子","こ"],["を"],["ファラオ"],["の"],["宮殿","きゅうでん"],["の"],["中","なか"],["で"],["育てた","そだてた"],["。"],["ゲヌバト"],["は"],["、"],["ファラオ"],["の"],["宮殿","きゅうでん"],["で"],["その"],["王子","おうじ"],["たち"],["の"],["中","なか"],["に"],["加わって","くわわって"],["いた"],["。"]]},{"verse":21,"text":"エジプトでハダドは、ダビデが先祖たちと共に眠りにつき、また軍の司令官ヨアブも死んだと伝え聞くと、ファラオに、「故国に帰らせてください」と申し出た。","tok":[["エジプト"],["で"],["ハダド"],["は"],["、"],["ダビデ"],["が"],["先祖",
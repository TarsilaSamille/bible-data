[{"verse":1,"text":"ソロモン王は全イスラエルの王となった。","tok":[["ソロモン"],["王","おう"],["は"],["全","ぜん"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["。"]]},{"verse":2,"text":"その高官たちは次のとおりである。ツァドクの子アザルヤ、祭司。","tok":[["その"],["高官","こうかん"],["たち"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ツァドク"],["の"],["子","こ"],["アザルヤ"],["、"],["祭司","さいし"],["。"]]},{"verse":3,"text":"シシャの二人の子エリホレフとアヒヤ、書記官。アヒルドの子ヨシャファト、補佐官。","tok":[["シシャ"],["の"],["二人","ふたり"],["の"],["子","こ"],["エリホレフ"],["と"],["アヒヤ"],["、"],["書記官","しょきかん"],["。"],["アヒルド"],["の"],["子","こ"],["ヨシャファト"],["、"],["補佐官","ほさかん"],["。"]]},{"verse":4,"text":"ヨヤダの子ベナヤ、軍の司令官。ツァドクとアビアタル、祭司。","tok":[["ヨヤダ"],["の"],["子","こ"],["ベナヤ"],["、"],["軍","ぐん"],["の"],["司令官","しれいかん"],["。"],["ツァドク"],["と"],["アビアタル"],["、"],["祭司","さいし"],["。"]]},{"verse":5,"text":"ナタンの子アザルヤ、知事の監督。ナタンの子ザブド、王の友で、祭司。","tok":[["ナタン"],["の"],["子","こ"],["アザルヤ"],["、"],["知事","ちじ"],["の"],["監督","かんとく"],["。"],["ナタン"],["の"],["子","こ"],["ザブド"],["、"],["王","おう"],["の"],["友","とも"],["で"],["、"],["祭司","さいし"],["。"]]},{"verse":6,"text":"アヒシャル、宮廷長。アブダの子アドニラム、労役の監督。","tok":[["アヒシャル"],["、"],["宮廷長","きゅうていちょう"],["。"],["アブダ"],["の"],["子","こ"],["アドニラム"],["、"],["労役","ろうえき"],["の"],["監督","かんとく"],["。"]]},{"verse":7,"text":"ソロモンはイスラエル全国に十二人の知事を置いた。彼らは、王と王室の食糧を調達した。すなわち、知事は各自毎年一か月分の食糧を調達することになっていた。","tok":[["ソロモン"],["は"],["イスラエル"],["全国","ぜんこく"],["に"],["十二人","じゅうににん"],["の"],["知事","ちじ"],["を"],["置いた","おいた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["王","おう"],["と"],["王室","おうしつ"],["の"],["食糧","しょくりょう"],["を"],["調達","ちょうたつ"],["した"],["。"],["すなわち"],["、"],["知事","ちじ"],["は"],["各自","かくじ"],["毎年","まいとし"],["一","いち"],["か月","かげつ"],["分","ぶん"],["の"],["食糧","しょくりょう"],["を"],["調達","ちょうたつ"],["する"],["こと"],["に"],["なって"],["いた"],["。"]]},{"verse":8,"text":"その知事の名は次のとおりである。ベン‧フル――エフライム山地。","tok":[["その"],["知事","ちじ"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ベン"],["‧"],["フル"],["―"],["―"],["エフライム"],["山地","さんち"],["。"]]},{"verse":9,"text":"ベン‧デケル――マカツ、シャアルビム、ベト‧シェメシュ、エロン‧ベト‧ハナン。","tok":[["ベン"],["‧"],["デケル"],["―"],["―"],["マカツ"],["、"],["シャアルビム"],["、"],["ベト"],["‧"],["シェメシュ"],["、"],["エロン"],["‧"],["ベト"],["‧"],["ハナン"],["。"]]},{"verse":10,"text":"ベン‧ヘセド――アルボト、ソコとヘフェル地方全域も彼の担当。","tok":[["ベン"],["‧"],["ヘセド"],["―"],["―"],["アルボト"],["、"],["ソコ"],["と"],["ヘフェル"],["地方","ちほう"],["全域","ぜんいき"],["も"],["彼","かれ"],["の"],["担当","たんとう"],["。"]]},{"verse":11,"text":"ベン‧アビナダブ――ドルの高地全域。ソロモンの娘タファトがその妻となった。","tok":[["ベン"],["‧"],["アビナダブ"],["―"],["―"],["ドル"],["の"],["高地","こうち"],["全域","ぜんいき"],["。"],["ソロモン"],["の"],["娘","むすめ"],["タファト"],["が"],["その"],["妻","つま"],["と"],["なった"],["。"]]},{"verse":12,"text":"アヒルドの子バアナ――タナク、メギド、イズレエルの下方すなわちベト‧シェアンからアベル‧メホラまで、ヨクメアムの向こう側に至るまでの、ツァレタンのそばのベト‧シェアンの全域。","tok":[["アヒルド"],["の"],["子","こ"],["バアナ"],["―"],["―"],["タナク"],["、"],["メギド"],["、"],["イズレエル"],["の"],["下方","かほう"],["すなわち"],["ベト"],["‧"],["シェアン"],["から"],["アベル"],["‧"],["メホラ"],["まで"],["、"],["ヨクメアム"],["の"],["向こう側","むこうがわ"],["に"],["至る","いたる"],["まで"],["の"],["、"],["ツァレタン"],["の"],["そば"],["の"],["ベト"],["‧"],["シェアン"],["の"],["全域","ぜんいき"],["。"]]},{"verse":13,"text":"ベン‧ゲベル――ラモト‧ギレアド、ギレアド地方のマナセの子ヤイルの村落が彼の担当。バシャン地方のアルゴブの地域も彼の担当。そこには城壁と青銅のかんぬきを備えた大きな町が六十あった。","tok":[["ベン"],["‧"],["ゲベル"],["―"],["―"],["ラモト"],["‧"],["ギレアド"],["、"],["ギレアド"],["地方","ちほう"],["の"],["マナセ"],["の"],["子","こ"],["ヤイル"],["の"],["村落","そんらく"],["が"],["彼","かれ"],["の"],["担当","たんとう"],["。"],["バシャン"],["地方","ちほう"],["の"],["アルゴブ"],["の"],["地域","ちいき"],["も"],["彼","かれ"],["の"],["担当","たんとう"],["。"],["そこ"],["に"],["は"],["城壁","じょうへき"],["と"],["青銅","せいどう"],["の"],["かんぬき"],["を"],["備えた","そなえた"],["大きな","おおきな"],["町","まち"],["が"],["六十","ろくじゅう"],["あった"],["。"]]},{"verse":14,"text":"イドの子アヒナダブ――マハナイム地方。","tok":[["イド"],["の"],["子","こ"],["アヒナダブ"],["―"],["―"],["マハナイム"],["地方","ちほう"],["。"]]},{"verse":15,"text":"アヒマアツ――ナフタリ地方。彼もソロモンの娘バセマトを妻としていた。","tok":[["アヒマアツ"],["―"],["―"],["ナフタリ"],["地方","ちほう"],["。"],["彼","かれ"],["も"],["ソロモン"],["の"],["娘","むすめ"],["バセマト"],["を"],["妻","つま"],["として"],["いた"],["。"]]},{"verse":16,"text":"フシャイの子バアナ――アシェル地方とベアロト。","tok":[["フシャイ"],["の"],["子","こ"],["バアナ"],["―"],["―"],["アシェル"],["地方","ちほう"],["と"],["ベアロト"],["。"]]},{"verse":17,"text":"パルアの子ヨシ
[{"verse":1,"text":"ギレアドの住民である、ティシュベ人エリヤはアハブに言った。「わたしの仕えているイスラエルの神、主は生きておられる。わたしが告げるまで、数年の間、露も降りず、雨も降らないであろう。」","tok":[["ギレアド"],["の"],["住民","じゅうみん"],["で"],["ある"],["、"],["ティシュベ"],["人","にん"],["エリヤ"],["は"],["アハブ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["の"],["仕えて","つかえて"],["いる"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["わたし"],["が"],["告げる","つげる"],["まで"],["、"],["数","すう"],["年","ねん"],["の"],["間","あいだ"],["、"],["露","ろ"],["も"],["降りず","おりず"],["、"],["雨","あめ"],["も"],["降らないで","ふらないで"],["あろう"],["。"],["」"]]},{"verse":2,"text":"主の言葉がエリヤに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["エリヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":3,"text":"「ここを去り、東に向かい、ヨルダンの東にあるケリトの川のほとりに身を隠せ。","tok":[["「"],["ここ"],["を"],["去り","さり"],["、"],["東","ひがし"],["に"],["向かい","むかい"],["、"],["ヨルダン"],["の"],["東","ひがし"],["に"],["ある"],["ケリト"],["の"],["川","かわ"],["の"],["ほとり"],["に"],["身","み"],["を"],["隠せ","かくせ"],["。"]]},{"verse":4,"text":"その川の水を飲むがよい。わたしは烏に命じて、そこであなたを養わせる。」","tok":[["その"],["川","かわ"],["の"],["水","みず"],["を"],["飲む","のむ"],["が"],["よい"],["。"],["わたし"],["は"],["烏","からす"],["に"],["命じて","めいじて"],["、"],["そこ"],["で"],["あなた"],["を"],["養わせる","やしなわせる"],["。"],["」"]]},{"verse":5,"text":"エリヤは主が言われたように直ちに行動し、ヨルダンの東にあるケリトの川のほとりに行き、そこにとどまった。","tok":[["エリヤ"],["は"],["主","ぬし"],["が"],["言われた","いわれた"],["よう"],["に"],["直ちに","ただちに"],["行動","こうどう"],["し"],["、"],["ヨルダン"],["の"],["東","ひがし"],["に"],["ある"],["ケリト"],["の"],["川","かわ"],["の"],["ほとり"],["に"],["行き","いき"],["、"],["そこ"],["に"],["とどまった"],["。"]]},{"verse":6,"text":"数羽の烏が彼に、朝、パンと肉を、また夕べにも、パンと肉を運んで来た。水はその川から飲んだ。","tok":[["数羽","かずは"],["の"],["烏","からす"],["が"],["彼","かれ"],["に"],["、"],["朝","あさ"],["、"],["パン"],["と"],["肉","にく"],["を"],["、"],["また"],["夕べ","ゆうべ"],["に"],["も"],["、"],["パン"],["と"],["肉","にく"],["を"],["運んで","はこんで"],["来た","きた"],["。"],["水","みず"],["は"],["その"],["川","かわ"],["から"],["飲んだ","のんだ"],["。"]]},{"verse":7,"text":"しばらくたって、その川も涸れてしまった。雨がこの地方に降らなかったからである。","tok":[["しばらく"],["たって"],["、"],["その"],["川","かわ"],["も"],["涸れて","かれて"],["しまった"],["。"],["雨","あめ"],["が"],["この"],["地方","ちほう"],["に"],["降らなかった","ふらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"また主の言葉がエリヤに臨んだ。","tok":[["また"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["エリヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":9,"text":"「立ってシドンのサレプタに行き、そこに住め。わたしは一人のやもめに命じて、そこであなたを養わせる。」","tok":[["「"],["立って","たって"],["シドン"],["の"],["サレプタ"],["に"],["行き","いき"],["、"],["そこ"],["に"],["住め","すめ"],["。"],["わたし"],["は"],["一人","ひとり"],["の"],["やもめ"],["に"],["命じて","めいじて"],["、"],["そこ"],["で"],["あなた"],["を"],["養わせる","やしなわせる"],["。"],["」"]]},{"verse":10,"text":"彼は立ってサレプタに行った。町の入り口まで来ると、一人のやもめが薪を拾っていた。エリヤはやもめに声をかけ、「器に少々水を持って来て、わたしに飲ませてください」と言った。","tok":[["彼","かれ"],["は"],["立って","たって"],["サレプタ"],["に"],["行った","いった"],["。"],["町","まち"],["の"],["入り口","いりぐち"],["まで"],["来る","くる"],["と"],["、"],["一人","ひとり"],["の"],["やもめ"],["が"],["薪","たきぎ"],["を"],["拾って","ひろって"],["いた"],["。"],["エリヤ"],["は"],["やもめ"],["に"],["声","こえ"],["を"],["かけ"],["、"],["「"],["器","うつわ"],["に"],["少々","しょうしょう"],["水","みず"],["を"],["持って","もって"],["来て","きて"],["、"],["わたし"],["に"],["飲ませて","のませて"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":11,"text":"彼女が取りに行こうとすると、エリヤは声をかけ、「パンも一切れ、手に持って来てください」と言った。","tok":[["彼女","かのじょ"],["が"],["取り","とり"],["に"],["行こう","いこう"],["と"],["する"],["と"],["、"],["エリヤ"],["は"],["声","こえ"],["を"],["かけ"],["、"],["「"],["パン"],["も"],["一切れ","ひときれ"],["、"],["手","て"],["に"],["持って","もって"],["来て","きて"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"彼女は答えた。「あなたの神、主は生きておられます。わたしには焼いたパンなどありません。ただ壺の中に一握りの小麦粉と、瓶の中にわずかな油があるだけです。わたしは二本の薪を拾って帰り、わたしとわたしの息子の食べ物を作るところです。わたしたちは、それを食べてしまえば、あとは死ぬのを待つばかりです。」","tok":[["彼女","かのじょ"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["生きて","いきて"],["おられます"],["。"],["わたし"],["に"],["は"],["焼いた","やいた"],["パン"],["など"],["ありません"],["。"],["ただ"],["壺","つぼ"],["の"],["中","なか"],["に"],["一握り","ひとにぎり"],["の"],["小麦粉","こむぎこ"],["と"],["、"],["瓶","びん"],["の"],["中","なか"],["に"],["わずか"],["な"],["油","あぶら"],["が"],["ある"],["だけ"],["です"],["。"],["わたし"],["は"],["二本","にぽん"],["の"],["薪","たきぎ"],["を"],["拾って","ひろって"],["帰り","かえり"],["、"],["わたし"],["と"],["わたし"],["の"],["息子","むすこ"],["の"],["食べ物","たべもの"],["を"],["作る","つくる"],["ところ"],["です"],["。"],["わたしたち"],["は"],["、"],["それ"],["を"],["食べて","たべて"],["しまえば"],["、"],["あと"],["は"],["死ぬ","しぬ"],["の"],["を"],["待つ","まつ"],["ばかり"],["です"],["。"],["」"]]},{"verse":13,"text":"エリヤは言った。「恐れてはならない。帰って、あなたの言ったとおりにしなさい。だが、まずそれでわたしのために小さいパン菓子を作って、わたしに持って来なさい。その後あなたとあなたの息子のために作りなさい。","tok":[["エリヤ"],["は"],["言った","いった"],["。"],["「"],["恐れて","おそれて"],["は"],["ならない"],["。"],["帰って","かえって"],["、"],["あなた"],["の"],["言った","いった"],["とおり"],["に"],["し"],["なさい"],["。"],["だ"],["が"],["、"],["まず"],["それ"],["で"],["わたし"],["の"],["ため"],["に"],["小さい","ちいさい"],["パン"],["菓子","かし"],["を"],["作って","つくって"],["、"],["わたし"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["その後","そのあと"],["あなた"],["と"],["あなた"],["の"],["息子","むすこ"],["の"],["ため"],["に"],["作り","つくり"],["なさい"],["。"]]},{"verse":14,"text":"なぜならイスラエルの神、主はこう言われる。主が地の面に雨を降らせる日まで壺の粉は尽きることなく瓶の油はなくならない。」","tok":[["なぜ"],["なら"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["主","ぬし"],["が"],["地","ち"],["の"],["面","めん"],["に"],["雨","あめ"],["を"],["降らせる","ふらせる"],["日","ひ"],["まで"],["壺","つぼ"],["の"],["粉","こな"],["は"],["尽きる","つきる"],["こと"],["なく"],["瓶","びん"],["の"],["油","あぶら"],["は"],["なくならない"],["。"],["」"]]},{"verse":15,"text":"やもめは行って、エリヤの言葉どおりにした。こうして彼女もエリヤも、彼女の家の者も、幾日も食べ物に事欠かなかった。","tok":[["やもめ"],["は"],["行って","いって"],["、"],["エリヤ"],["の"],["言葉","ことば"],["どおり"],["に"],["した"],["。"],["こう"],["して"],["彼女","かのじょ"],["も"],["エリヤ"],["も"],["、"],["彼女","かのじょ"],["の"],["家","いえ"],["の"],["者","もの"],["も"],["、"],["幾日","いくか"],["も"],["食べ物","たべもの"],["に"],["事欠かなかった","ことかかなかった"],["。"]]},{"verse":16,"text":"主がエリヤによって告げられた御言葉のとおり、壺の粉は尽きることなく、瓶の油もなくならなかった。","tok":[["主","ぬし"],["が"],["エリヤ"],["によって"],["告げられた","つげられた"],["御言葉","おことば"],["の"],["とおり"],["、"],["壺","つぼ"],["の"],["粉","こな"],["は"],["尽きる","つきる"],["こと"],["なく"],["、"],["瓶","びん"],["の"],["油","あぶら"],["も"],["なくならなかった"],["。"]]},{"verse":17,"text":"その後、この家の女主人である彼女の息子が病気にかかった。病状は非常に重く、ついに息を引き取った。","tok":[["その"],["後","ご"],["、"],["この"],["家","いえ"],["の"],["女","おんな"],["主人","しゅじん"],["で"],["ある"],["彼女","かのじょ"],["の"],["息子","むすこ"],["が"],["病気","びょうき"],["に"],["かかった"],["。"],["病状","びょうじょう"],["は"],["非常","ひじょう"],["に"],["重く","おもく"],["、"],["ついに"],["息","いき"],["を"],["引き取った","ひきとった"],["。"]]},{"verse":18,"text":"彼女はエリヤに言った。「神の人よ、あなたはわたしにどんなかかわりがあるのでしょうか。あなたはわたしに罪を思い起こさせ、息子を死なせるために来られたのですか。」","tok":[["彼女","かのじょ"],["は"],["エリヤ"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["あなた"],["は"],["わたし"],["に"],["どんな"],["かかわり"],["が"],["ある"],["の"],["でしょう"],["か"],["。"],["あなた"],["は"],["わたし"],["に"],["罪","つみ"],["を"],["思い起こさせ","おもいおこさせ"],["、"],["息子","むすこ"],["を"],["死なせる","しなせる"],["ため"],["に"],["来られた","こられた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":19,"text":"エリヤは、「あなたの息子をよこしなさい」と言って、彼女のふところから息子を受け取り、自分のいる階上の部屋に抱いて行って寝台に寝かせた。","tok":[["エリヤ"],["は"],["、"],["「"],["あなた"],["の"],["息子","むすこ"],["を"],["よこし"],["なさい"],["」"],["と"],["言って","いって"],["、"],["彼女","かのじょ"],["の"],["ふところ"],["から"],["息子","むすこ"],["を"],["受け取り","うけとり"],["、"],["自分","じぶん"],["の"],["いる"],["階上","かいじょう"],["の"],["部屋","へや"],["に"],["抱いて","いだいて"],["行って","いって"],["寝台","しんだい"],["に"],["寝かせた","ねかせた"],["。"]]},{"verse":20,"text":"彼は主に向かって祈った。「主よ、わが神よ、あなたは、わたしが身を寄せているこのやもめにさえ災いをもたらし、その息子の命をお取りになるのですか。」","tok":[["彼","かれ"],["は"],["主に","おもに"],["向かって","むかって"],["祈った","いのった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["わが"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["、"],["わたし"],["が"],["身","み"],["を"],["寄せて","よせて"],["いる"],["この"],["やもめ"],["に"],["さえ"],["災い","わざわい"],["を"],["もたらし"],["、"],["その"],["息子","むすこ"],["の"],["命","いのち"],["を"],["お取り","おとり"],["に"],["なる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":21,"text":"彼は子供の上に三度身を重ねてから、また主に向かって祈った。「主よ、わが神よ、この子の命を元に返してください。」","tok":[["彼","かれ"],["は"],["子供","こども"],["の"],["上","うえ"],["に"],["三","さん"],["度","ど"],["身","み"],["を"],["重ねて","かさねて"],["から"],["、"],["また"],["主に","おもに"],["向かって","むかって"],["祈った","いのった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["わが"],["神","かみ"],["よ"],["、"],["この"],["子","こ"],["の"],["命","いのち"],["を"],["元","もと"],["に"],["返して","かえして"],["ください"],["。"],["」"]]},{"verse":22,"text":"主は、エリヤの声に耳を傾け、その子の命を元にお返しになった。子供は生き返った。","tok":[["主","ぬし"],["は"],["、"],["エリヤ"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["その"],["子","こ"],["の"],["命","いのち"],["を"],["元","もと"],["に"],["お返し","おかえし"],["に"],["なった"],["。"],["子供","こども"],["は"],["生き返った","いきかえった"],["。"]]},{"verse":23,"text":"エリヤは、その子を連れて家の階上の部屋から降りて来て、母親に渡し、「見なさい。あなたの息子は生きている」と言った。","tok":[["エリヤ"],["は"],["、"],["その"],["子","こ"],["を"],["連れて","つれて"],["家","いえ"],["の"],["階上","かいじょう"],["の"],["部屋","へや"],["から"],["降りて","おりて"],["来て","きて"],["、"],["母親","ははおや"],["に"],["渡し","わたし"],["、"],["「"],["見","み"],["なさい"],["。"],["あなた"],["の"],["息子","むすこ"],["は"],["生きて","いきて"],["いる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":24,"text":"女はエリヤに言った。「今わたしは分かりました。あなたはまことに神の人です。あなたの口にある主の言葉は真実です。」","tok":[["女","おんな"],["は"],["エリヤ"],["に"],["言った","いった"],["。"],["「"],["今","いま"],["わたし"],["は"],["分かりました","わかりました"],["。"],["あなた"],["は"],["まこと"],["に"],["神","かみ"],["の"],["人","ひと"],["です"],["。"],["あなた"],["の"],["口","くち"],["に"],["ある"],["主","ぬし"],["の"],["言葉","ことば"],["は"],["真実","しんじつ"],["です"],["。"],["」"]]}]
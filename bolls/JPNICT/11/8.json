[{"verse":1,"text":"ソロモンは、そこでイスラエルの長老、すべての部族長、イスラエル人諸家系の首長をエルサレムの自分のもとに召集した。「ダビデの町」シオンから主の契約の箱を担ぎ上るためであった。","tok":[["ソロモン"],["は"],["、"],["そこ"],["で"],["イスラエル"],["の"],["長老","ちょうろう"],["、"],["すべて"],["の"],["部族長","ぶぞくちょう"],["、"],["イスラエル"],["人","にん"],["諸家系","しょかけい"],["の"],["首長","しゅちょう"],["を"],["エルサレム"],["の"],["自分","じぶん"],["の"],["もと"],["に"],["召集","しょうしゅう"],["した"],["。"],["「"],["ダビデ"],["の"],["町","まち"],["」"],["シオン"],["から"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担ぎ","かつぎ"],["上る","のぼる"],["ため"],["で"],["あった"],["。"]]},{"verse":2,"text":"エタニムの月、すなわち第七の月の祭りに、すべてのイスラエル人がソロモン王のもとに集まった。","tok":[["エタニム"],["の"],["月","つき"],["、"],["すなわち"],["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["祭り","まつり"],["に"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["が"],["ソロモン"],["王","おう"],["の"],["もと"],["に"],["集まった","あつまった"],["。"]]},{"verse":3,"text":"イスラエルの全長老が到着すると、祭司たちはその箱を担ぎ、","tok":[["イスラエル"],["の"],["全","ぜん"],["長老","ちょうろう"],["が"],["到着","とうちゃく"],["する"],["と"],["、"],["祭司","さいし"],["たち"],["は"],["その"],["箱","ばこ"],["を"],["担ぎ","かつぎ"],["、"]]},{"verse":4,"text":"主の箱のみならず臨在の幕屋も、幕屋にあった聖なる祭具もすべて担ぎ上った。祭司たちはレビ人たちと共にこれらのものを担ぎ上った。","tok":[["主","ぬし"],["の"],["箱","ばこ"],["のみ"],["ならず"],["臨在","りんざい"],["の"],["幕屋","まくや"],["も"],["、"],["幕屋","まくや"],["に"],["あった"],["聖","せい"],["なる"],["祭具","さいぐ"],["も"],["すべて"],["担ぎ","かつぎ"],["上った","のぼった"],["。"],["祭司","さいし"],["たち"],["は"],["レビ人","れびにん"],["たち"],["と"],["共","とも"],["に"],["これ"],["ら"],["の"],["もの"],["を"],["担ぎ","かつぎ"],["上った","のぼった"],["。"]]},{"verse":5,"text":"ソロモン王は、彼のもとに集まったイスラエルの全共同体と共に、その箱の前でいけにえとして羊や牛をささげた。その数はあまりにも多く、調べることも数えることもできなかった。","tok":[["ソロモン"],["王","おう"],["は"],["、"],["彼","かれ"],["の"],["もと"],["に"],["集まった","あつまった"],["イスラエル"],["の"],["全","ぜん"],["共同体","きょうどうたい"],["と"],["共","とも"],["に"],["、"],["その"],["箱","ばこ"],["の"],["前","まえ"],["で"],["いけにえ"],["として"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["ささげた"],["。"],["その"],["数","すう"],["は"],["あまり"],["に"],["も"],["多く","おおく"],["、"],["調べる","しらべる"],["こと"],["も"],["数える","かぞえる"],["こと"],["も"],["できなかった"],["。"]]},{"verse":6,"text":"祭司たちは主の契約の箱を定められた場所、至聖所と言
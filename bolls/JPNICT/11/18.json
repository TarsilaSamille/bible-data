[{"verse":1,"text":"多くの日を重ねて三年目のこと、主の言葉がエリヤに臨んだ。「行って、アハブの前に姿を現せ。わたしはこの地の面に雨を降らせる。」","tok":[["多く","おおく"],["の"],["日","ひ"],["を"],["重ねて","かさねて"],["三","さん"],["年目","ねんめ"],["の"],["こと"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["エリヤ"],["に"],["臨んだ","のぞんだ"],["。"],["「"],["行って","いって"],["、"],["アハブ"],["の"],["前","まえ"],["に"],["姿","すがた"],["を"],["現せ","あらわせ"],["。"],["わたし"],["は"],["この"],["地","ち"],["の"],["面","めん"],["に"],["雨","あめ"],["を"],["降らせる","ふらせる"],["。"],["」"]]},{"verse":2,"text":"エリヤはアハブの前に姿を現すために出かけた。サマリアはひどい飢饉に襲われていた。","tok":[["エリヤ"],["は"],["アハブ"],["の"],["前","まえ"],["に"],["姿","すがた"],["を"],["現す","あらわす"],["ため"],["に"],["出かけた","でかけた"],["。"],["サマリア"],["は"],["ひどい"],["飢饉","ききん"],["に"],["襲われて","おそわれて"],["いた"],["。"]]},{"verse":3,"text":"アハブは宮廷長オバドヤを呼び寄せた――オバドヤは心から主を畏れ敬う人で、","tok":[["アハブ"],["は"],["宮廷長","きゅうていちょう"],["オバドヤ"],["を"],["呼び寄せた","よびよせた"],["―"],["―"],["オバドヤ"],["は"],["心","こころ"],["から"],["主","ぬし"],["を"],["畏れ","おそれ"],["敬う","うやまう"],["人","ひと"],["で"],["、"]]},{"verse":4,"text":"イゼベルが主の預言者を切り殺したとき、百人の預言者を救い出し、五十人ずつ洞穴にかくまい、パンと水をもって養った――。","tok":[["イゼベル"],["が"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["を"],["切り殺した","きりころした"],["とき"],["、"],["百人","ひゃくにん"],["の"],["預言者","よげんしゃ"],["を"],["救い出し","すくいだし"],["、"],["五","ご"],["十人","じゅうにん"],["ずつ"],["洞穴","ほらあな"],["に"],["かくまい"],["、"],["パン"],["と"],["水","みず"],["を"],["もって"],["養った","やしなった"],["―"],["―"],["。"]]},{"verse":5,"text":"アハブはオバドヤに言った。「この地のすべての泉、すべての川を見回ってくれ。馬やらばを生かしておく草が見つかり、家畜を殺さずに済むかもしれない。」","tok":[["アハブ"],["は"],["オバドヤ"],["に"],["言った","いった"],["。"],["「"],["この"],["地","ち"],["の"],["すべて"],["の"],["泉","いずみ"],["、"],["すべて"],["の"],["川","かわ"],["を"],["見回って","みまわって"],["くれ"],["。"],["馬","うま"],["や"],["らば"],["を"],["生かして","いかして"],["おく"],["草","くさ"],["が"],["見つかり","みつかり"],["、"],["家畜","かちく"],["を"],["殺さず","ころさず"],["に"],["済む","すむ"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":6,"text":"彼らは国を分けて巡ることにし、アハブは一人で一つの道を行き、オバドヤも一人でほかの道を行った。","tok":[["彼","かれ"],["ら"],["は"],["国","くに"],["を"],["分けて","わけて"],["巡る","めぐる"],["こと"],["に"],["し"],["、"],["アハブ"],["は"],["一人","ひとり"],["で"],["一","ひと"],["つ"],["の"],["道","みち"],["を"],["行き","いき"],["、"],["オバドヤ"],["も"],["一人","ひとり"],["で"],["ほか"],["の"],["道","みち"],["を"],["行った","おこなった"],["。"]]},{"verse":7,"text":"オバドヤが道を歩いていると、エリヤが彼に会いに来た。オバドヤはそれがエリヤだと分かって、ひれ伏し、「あなたは、エリヤさまではありませんか」と言った。","tok":[["オバドヤ"],["が"],["道","みち"],["を"],["歩いて","あるいて"],["いる"],["と"],["、"],["エリヤ"],["が"],["彼","かれ"],["に"],["会い","あい"],["に"],["来た","きた"],["。"],["オバドヤ"],["は"],["それ"],["が"],["エリヤ"],["だ"],["と"],["分かって","わかって"],["、"],["ひれ伏し","ひれふし"],["、"],["「"],["あなた"],["は"],["、"],["エリヤ"],["さま"],["で"],["は"],["ありません"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"エリヤは彼に言った。「そうです。あなたの主君のもとに行って、エリヤがここにいる、と言ってください。」","tok":[["エリヤ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["そう"],["です"],["。"],["あなた"],["の"],["主君","しゅくん"],["の"],["もと"],["に"],["行って","いって"],["、"],["エリヤ"],["が"],["ここ"],["に"],["いる"],["、"],["と"],["言って","いって"],["ください"],["。"],["」"]]},{"verse":9,"text":"オバドヤは言った。「わたしにどんな罪があって、あなたは僕をアハブの手に渡し、殺そうとなさるのですか。","tok":[["オバドヤ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["に"],["どんな"],["罪","つみ"],["が"],["あって"],["、"],["あなた"],["は"],["僕","ぼく"],["を"],["アハブ"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["殺そう","ころそう"],["と"],["なさる"],["の"],["です"],["か"],["。"]]},{"verse":10,"text":"あなたの神、主は生きておられます。わたしの主君があなたを捜し出そうとして人を送らなかった民や国はないのです。彼らが、『エリヤはここにいない』と言えば、王はその国や民に、エリヤは見つからなかったと誓わせるほどです。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["生きて","いきて"],["おられます"],["。"],["わたし"],["の"],["主君","しゅくん"],["が"],["あなた"],["を"],["捜し出そう","さがしだそう"],["として"],["人","ひと"],["を"],["送らなかった","おくらなかった"],["民","たみ"],["や"],["国","くに"],["は"],["ない"],["の"],["です"],["。"],["彼","かれ"],["ら"],["が"],["、"],["『"],["エリヤ"],["は"],["ここ"],["に"],["いない"],["』"],["と"],["言えば","いえば"],["、"],["王","おう"],["は"],["その"],["国","くに"],["や"],["民","たみ"],["に"],["、"],["エリヤ"],["は"],["見つからなかった","みつからなかった"],["と"],["誓わせる","ちかわせる"],["ほど"],["です"],["。"]]},{"verse":11,"text":"今あなたは、『エリヤがここにいる、とあなたの主君アハブに言いに行きなさい』と言われる。","tok":[["今","いま"],["あなた"],["は"],["、"],["『"],["エリヤ"],["が"],["ここ"],["に"],["いる"],["、"],["と"],["あなた"],["の"],["主君","しゅくん"],["アハブ"],["に"],["言い","いい"],["に"],["行き","いき"],["なさい"],["』"],["と"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"しかし、わたしがあなたを離れれば、主の霊はあなたをわたしの知らないところに連れて行くでしょう。わたしがアハブに知らせに行っても、あなたが見つからなければ、わたしは殺されます。僕は幼いころから、主を畏れ敬っております。","tok":[["しかし"],["、"],["わたし"],["が"],["あなた"],["を"],["離れれば","はなれれば"],["、"],["主","ぬし"],["の"],["霊","れい"],["は"],["あなた"],["を"],["わたし"],["の"],["知らない","しらない"],["ところ"],["に"],["連れて","つれて"],["行くでしょう","いくでしょう"],["。"],["わたし"],["が"],["アハブ"],["に"],["知らせ","しらせ"],["に"],["行って","いって"],["も"],["、"],["あなた"],["が"],["見つからなければ","みつからなければ"],["、"],["わたし"],["は"],["殺されます","ころされます"],["。"],["僕","ぼく"],["は"],["幼い","おさない"],["ころ"],["から"],["、"],["主","ぬし"],["を"],["畏れ","おそれ"],["敬って","うやまって"],["おります"],["。"]]},{"verse":13,"text":"イゼベルが主の預言者を殺したときにわたしがしたことを、あなたは知らされてはいないのですか。わたしは主の預言者百人を五十人ずつ洞穴にかくまい、パンと水をもって養いました。","tok":[["イゼベル"],["が"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["を"],["殺した","ころした"],["とき"],["に"],["わたし"],["が"],["した"],["こと"],["を"],["、"],["あなた"],["は"],["知らされて","しらされて"],["は"],["いない"],["の"],["です"],["か"],["。"],["わたし"],["は"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["百人","ひゃくにん"],["を"],["五","ご"],["十人","じゅうにん"],["ずつ"],["洞穴","ほらあな"],["に"],["かくまい"],["、"],["パン"],["と"],["水","みず"],["を"],["もって"],["養いました","やしないました"],["。"]]},{"verse":14,"text":"今あなたは、『エリヤがここにいる、とあなたの主君に言いに行きなさい』と言われる。わたしは殺されてしまいます。」","tok":[["今","いま"],["あなた"],["は"],["、"],["『"],["エリヤ"],["が"],["ここ"],["に"],["いる"],["、"],["と"],["あなた"],["の"],["主君","しゅくん"],["に"],["言い","いい"],["に"],["行き","いき"],["なさい"],["』"],["と"],["言われる","いわれる"],["。"],["わたし"],["は"],["殺されて","ころされて"],["しまいます"],["。"],["」"]]},{"verse":15,"text":"エリヤはこう答えた。「わたしの仕えている万軍の主は生きておられます。今日わたしはアハブの前に姿を現します。」","tok":[["エリヤ"],["は"],["こう"],["答えた","こたえた"],["。"],["「"],["わたし"],["の"],["仕えて","つかえて"],["いる"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["生きて","いきて"],["おられます"],["。"],["今日","きょう"],["わたし"],["は"],["アハブ"],["の"],["前","まえ"],["に"],["姿","すがた"],["を"],["現します","あらわします"],["。"],["」"]]},{"verse":16,"text":"オバドヤはアハブに会って知らせたので、アハブはエリヤに会いに来た。","tok":[["オバドヤ"],["は"],["アハブ"],["に"],["会って","あって"],["知らせた","しらせた"],["ので"],["、"],["アハブ"],["は"],["エリヤ"],["に"],["会い","あい"],["に"],["来た","きた"],["。"]]},{"verse":17,"text":"アハブはエリヤを見ると、「お前か、イスラエルを煩わす者よ」と言った。","tok":[["アハブ"],["は"],["エリヤ"],["を"],["見る","みる"],["と"],["、"],["「"],["お前","おまえ"],["か"],["、"],["イスラエル"],["を"],["煩わす","わずらわす"],["者","もの"],["よ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"エリヤは言った。「わたしではなく、主の戒めを捨て、バアルに従っているあなたとあなたの父の家こそ、イスラエルを煩わしている。","tok":[["エリヤ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["で"],["は"],["なく"],["、"],["主","ぬし"],["の"],["戒め","いましめ"],["を"],["捨て","すて"],["、"],["バアル"],["に"],["従って","したがって"],["いる"],["あなた"],["と"],["あなた"],["の"],["父","ちち"],["の"],["家","いえ"],["こそ"],["、"],["イスラエル"],["を"],["煩わして","わずらわして"],["いる"],["。"]]},{"verse":19,"text":"今イスラエルのすべての人々を、イゼベルの食卓に着く四百五十人のバアルの預言者、四百人のアシェラの預言者と共に、カルメル山に集め、わたしの前に出そろうように使いを送っていただきたい。」","tok":[["今","いま"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["を"],["、"],["イゼベル"],["の"],["食卓","しょくたく"],["に"],["着く","つく"],["四百五","よんひゃくご"],["十人","じゅうにん"],["の"],["バアル"],["の"],["預言者","よげんしゃ"],["、"],["四百人","よんひゃくにん"],["の"],["アシェラ"],["の"],["預言者","よげんしゃ"],["と"],["共","とも"],["に"],["、"],["カルメル"],["山","さん"],["に"],["集め","あつめ"],["、"],["わたし"],["の"],["前","まえ"],["に"],["出そろう","でそろう"],["よう"],["に"],["使い","つかい"],["を"],["送って","おくって"],["いただきたい"],["。"],["」"]]},{"verse":20,"text":"アハブはイスラエルのすべての人々に使いを送り、預言者たちをカルメル山に集めた。","tok":[["アハブ"],["は"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["使い","つかい"],["を"],["送り","おくり"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["カルメル"],["山","さん"],["に"],["集めた","あつめた"],["。"]]},{"verse":21,"text":"エリヤはすべての民に近づいて言った。「あなたたちは、いつまでどっちつかずに迷っているのか。もし主が神であるなら、主に従え。もしバアルが神であるなら、バアルに従え。」民はひと言も答えなかった。","tok":[["エリヤ"],["は"],["すべて"],["の"],["民","たみ"],["に"],["近づいて","ちかづいて"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["は"],["、"],["いつ"],["まで"],["どっち"],["つかず"],["に"],["迷って","まよって"],["いる"],["の"],["か"],["。"],["もし"],["主","ぬし"],["が"],["神","かみ"],["で"],["あるなら"],["、"],["主に","おもに"],["従え","したがえ"],["。"],["もし"],["バアル"],["が"],["神","かみ"],["で"],["あるなら"],["、"],["バアル"],["に"],["従え","したがえ"],["。"],["」"],["民","みん"],["は"],["ひと言","ひとこと"],["も"],["答えなかった","こたえなかった"],["。"]]},{"verse":22,"text":"エリヤは更に民に向かって言った。「わたしはただ一人、主の預言者として残った。バアルの預言者は四百五十人もいる。","tok":[["エリヤ"],["は"],["更に","さらに"],["民","たみ"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["わたし"],["は"],["ただ"],["一人","ひとり"],["、"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["として"],["残った","のこった"],["。"],["バアル"],["の"],["預言者","よげんしゃ"],["は"],["四百五","よんひゃくご"],["十人","じゅうにん"],["も"],["いる"],["。"]]},{"verse":23,"text":"我々に二頭の雄牛を用意してもらいたい。彼らに一頭の雄牛を選ばせて、裂いて薪の上に載せ、火をつけずにおかせなさい。わたしも一頭の雄牛を同じようにして、薪の上に載せ、火をつけずにおく。","tok":[["我々","われわれ"],["に"],["二頭","にとう"],["の"],["雄牛","おうし"],["を"],["用意","ようい"],["して"],["もらいたい"],["。"],["彼","かれ"],["ら"],["に"],["一頭","いちとう"],["の"],["雄牛","おうし"],["を"],["選ばせて","えらばせて"],["、"],["裂いて","さいて"],["薪","たきぎ"],["の"],["上","うえ"],["に"],["載せ","のせ"],["、"],["火","ひ"],["を"],["つけず"],["に"],["おかせ"],["なさい"],["。"],["わたし"],["も"],["一頭","いちとう"],["の"],["雄牛","おうし"],["を"],["同じ","おなじ"],["よう"],["に"],["して"],["、"],["薪","たきぎ"],["の"],["上","うえ"],["に"],["載せ","のせ"],["、"],["火","ひ"],["を"],["つけず"],["に"],["おく"],["。"]]},{"verse":24,"text":"そこであなたたちはあなたたちの神の名を呼び、わたしは主の御名を呼ぶことにしよう。火をもって答える神こそ神であるはずだ。」民は皆、「それがいい」と答えた。","tok":[["そこ"],["で"],["あなた"],["たち"],["は"],["あなた"],["たち"],["の"],["神","かみ"],["の"],["名","な"],["を"],["呼び","よび"],["、"],["わたし"],["は"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["呼ぶ","よぶ"],["こと"],["に"],["しよう"],["。"],["火","ひ"],["を"],["もって"],["答える","こたえる"],["神","かみ"],["こそ"],["神","かみ"],["で"],["ある"],["はず"],["だ"],["。"],["」"],["民","みん"],["は"],["皆","みな"],["、"],["「"],["それ"],["が"],["いい"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":25,"text":"エリヤはバアルの預言者たちに言った。「あなたたちは大勢だから、まずあなたたちが一頭の雄牛を選んで準備し、あなたたちの神の名を呼びなさい。火をつけてはならない。」","tok":[["エリヤ"],["は"],["バアル"],["の"],["預言者","よげんしゃ"],["たち"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["は"],["大勢","おおぜい"],["だ"],["から"],["、"],["まず"],["あなた"],["たち"],["が"],["一頭","いちとう"],["の"],["雄牛","おうし"],["を"],["選んで","えらんで"],["準備","じゅんび"],["し"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["の"],["名","な"],["を"],["呼び","よび"],["なさい"],["。"],["火","ひ"],["を"],["つけて"],["は"],["ならない"],["。"],["」"]]},{"verse":26,"text":"彼らは与えられた雄牛を取って準備し、朝から真昼までバアルの名を呼び、「バアルよ、我々に答えてください」と祈った。しかし、声もなく答える者もなかった。彼らは築いた祭壇の周りを跳び回った。","tok":[["彼","かれ"],["ら"],["は"],["与えられた","あたえられた"],["雄牛","おうし"],["を"],["取って","とって"],["準備","じゅんび"],["し"],["、"],["朝","あさ"],["から"],["真昼","まひる"],["まで"],["バアル"],["の"],["名","な"],["を"],["呼び","よび"],["、"],["「"],["バアル"],["よ"],["、"],["我々","われわれ"],["に"],["答えて","こたえて"],["ください"],["」"],["と"],["祈った","いのった"],["。"],["しかし"],["、"],["声","こえ"],["も"],["なく"],["答える","こたえる"],["者","もの"],["も"],["なかった"],["。"],["彼","かれ"],["ら"],["は"],["築いた","きずいた"],["祭壇","さいだん"],["の"],["周り","まわり"],["を"],["跳び","とび"],["回った","まわった"],["。"]]},{"verse":27,"text":"真昼ごろ、エリヤは彼らを嘲って言った。「大声で呼ぶがいい。バアルは神なのだから。神は不満なのか、それとも人目を避けているのか、旅にでも出ているのか。恐らく眠っていて、起こしてもらわなければならないのだろう。」","tok":[["真","ま"],["昼ごろ","ひるごろ"],["、"],["エリヤ"],["は"],["彼","かれ"],["ら"],["を"],["嘲って","あざけって"],["言った","いった"],["。"],["「"],["大声","おおごえ"],["で"],["呼ぶ","よぶ"],["が"],["いい"],["。"],["バアル"],["は"],["神","かみ"],["な"],["の"],["だ"],["から"],["。"],["神","かみ"],["は"],["不満","ふまん"],["な"],["の"],["か"],["、"],["それ"],["と"],["も"],["人目","ひとめ"],["を"],["避けて","さけて"],["いる"],["の"],["か"],["、"],["旅","たび"],["に"],["で"],["も"],["出て","でて"],["いる"],["の"],["か"],["。"],["恐らく","おそらく"],["眠って","ねむって"],["いて"],["、"],["起こして","おこして"],["もらわなければ"],["ならない"],["の"],["だろう"],["。"],["」"]]},{"verse":28,"text":"彼らは大声を張り上げ、彼らのならわしに従って剣や槍で体を傷つけ、血を流すまでに至った。","tok":[["彼","かれ"],["ら"],["は"],["大声","おおごえ"],["を"],["張り上げ","はりあげ"],["、"],["彼","かれ"],["ら"],["の"],["ならわし"],["に"],["従って","したがって"],["剣","けん"],["や"],["槍","やり"],["で"],["体","からだ"],["を"],["傷つけ","きずつけ"],["、"],["血","ち"],["を"],["流す","ながす"],["まで"],["に"],["至った","いたった"],["。"]]},{"verse":29,"text":"真昼を過ぎても、彼らは狂ったように叫び続け、献げ物をささげる時刻になった。しかし、声もなく答える者もなく、何の兆候もなかった。","tok":[["真昼","まひる"],["を"],["過ぎて","すぎて"],["も"],["、"],["彼","かれ"],["ら"],["は"],["狂った","くるった"],["よう"],["に"],["叫び","さけび"],["続け","つづけ"],["、"],["献げ物","ささげもの"],["を"],["ささげる"],["時刻","じこく"],["に"],["なった"],["。"],["しかし"],["、"],["声","こえ"],["も"],["なく"],["答える","こたえる"],["者","もの"],["も"],["なく"],["、"],["何","なん"],["の"],["兆候","ちょうこう"],["も"],["なかった"],["。"]]},{"verse":30,"text":"エリヤはすべての民に向かって、「わたしの近くに来なさい」と言った。すべての民が彼の近くに来ると、彼は壊された主の祭壇を修復した。","tok":[["エリヤ"],["は"],["すべて"],["の"],["民","たみ"],["に"],["向かって","むかって"],["、"],["「"],["わたし"],["の"],["近く","ちかく"],["に"],["来","き"],["なさい"],["」"],["と"],["言った","いった"],["。"],["すべて"],["の"],["民","たみ"],["が"],["彼","かれ"],["の"],["近く","ちかく"],["に"],["来る","くる"],["と"],["、"],["彼","かれ"],["は"],["壊された","こわされた"],["主","ぬし"],["の"],["祭壇","さいだん"],["を"],["修復","しゅうふく"],["した"],["。"]]},{"verse":31,"text":"エリヤは、主がかつて、「あなたの名はイスラエルである」と告げられたヤコブの子孫の部族の数に従って、十二の石を取り、","tok":[["エリヤ"],["は"],["、"],["主","ぬし"],["が"],["かつて"],["、"],["「"],["あなた"],["の"],["名","な"],["は"],["イスラエル"],["で"],["ある"],["」"],["と"],["告げられた","つげられた"],["ヤコブ"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["の"],["数","かず"],["に"],["従って","したがって"],["、"],["十二","じゅうに"],["の"],["石","いし"],["を"],["取り","とり"],["、"]]},{"verse":32,"text":"その石を用いて主の御名のために祭壇を築き、祭壇の周りに種二セアを入れることのできるほどの溝を掘った。","tok":[["その"],["石","いし"],["を"],["用いて","もちいて"],["主","ぬし"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["祭壇","さいだん"],["の"],["周り","まわり"],["に"],["種二","たねじ"],["セア"],["を"],["入れる","いれる"],["こと"],["の"],["できる"],["ほど"],["の"],["溝","みぞ"],["を"],["掘った","ほった"],["。"]]},{"verse":33,"text":"次に薪を並べ、雄牛を切り裂き、それを薪の上に載せ、","tok":[["次","つぎ"],["に"],["薪","たきぎ"],["を"],["並べ","ならべ"],["、"],["雄牛","おうし"],["を"],["切り裂き","きりさき"],["、"],["それ"],["を"],["薪","たきぎ"],["の"],["上","うえ"],["に"],["載せ","のせ"],["、"]]},{"verse":34,"text":"「四つの瓶に水を満たして、いけにえと薪の上にその水を注げ」と命じた。彼が「もう一度」と言うと、彼らはもう一度そうした。彼が更に「三度目を」と言うと、彼らは三度同じようにした。","tok":[["「"],["四","よん"],["つ"],["の"],["瓶","びん"],["に"],["水","みず"],["を"],["満たして","みたして"],["、"],["いけにえ"],["と"],["薪","たきぎ"],["の"],["上","うえ"],["に"],["その"],["水","みず"],["を"],["注げ","そそげ"],["」"],["と"],["命じた","めいじた"],["。"],["彼","かれ"],["が"],["「"],["もう"],["一度","いちど"],["」"],["と"],["言う","ゆう"],["と"],["、"],["彼","かれ"],["ら"],["は"],["もう"],["一度","いちど"],["そう"],["した"],["。"],["彼","かれ"],["が"],["更に","さらに"],["「"],["三度目","さんどめ"],["を"],["」"],["と"],["言う","ゆう"],["と"],["、"],["彼","かれ"],["ら"],["は"],["三","さん"],["度","ど"],["同じ","おなじ"],["よう"],["に"],["した"],["。"]]},{"verse":35,"text":"水は祭壇の周りに流れ出し、溝にも満ちた。","tok":[["水","みず"],["は"],["祭壇","さいだん"],["の"],["周り","まわり"],["に"],["流れ出し","ながれだし"],["、"],["溝","みぞ"],["に"],["も"],["満ちた","みちた"],["。"]]},{"verse":36,"text":"献げ物をささげる時刻に、預言者エリヤは近くに来て言った。「アブラハム、イサク、イスラエルの神、主よ、あなたがイスラエルにおいて神であられること、またわたしがあなたの僕であって、これらすべてのことをあなたの御言葉によって行ったことが、今日明らかになりますように。","tok":[["献げ物","ささげもの"],["を"],["ささげる"],["時刻","じこく"],["に"],["、"],["預言者","よげんしゃ"],["エリヤ"],["は"],["近く","ちかく"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["アブラハム"],["、"],["イサク"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["が"],["イスラエル"],["に"],["おいて"],["神","かみ"],["で"],["あられる"],["こと"],["、"],["また"],["わたし"],["が"],["あなた"],["の"],["僕","ぼく"],["で"],["あって"],["、"],["これ"],["ら"],["すべて"],["の"],["こと"],["を"],["あなた"],["の"],["御言葉","おことば"],["によって"],["行った","いった"],["こと"],["が"],["、"],["今日","きょう"],["明らか","あきらか"],["に"],["なります"],["よう"],["に"],["。"]]},{"verse":37,"text":"わたしに答えてください。主よ、わたしに答えてください。そうすればこの民は、主よ、あなたが神であり、彼らの心を元に返したのは、あなたであることを知るでしょう。」","tok":[["わたし"],["に"],["答えて","こたえて"],["ください"],["。"],["主","ぬし"],["よ"],["、"],["わたし"],["に"],["答えて","こたえて"],["ください"],["。"],["そう"],["すれば"],["この"],["民","みん"],["は"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["が"],["神","かみ"],["で"],["あり"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["元","もと"],["に"],["返した","かえした"],["の"],["は"],["、"],["あなた"],["で"],["ある"],["こと"],["を"],["知るでしょう","しるでしょう"],["。"],["」"]]},{"verse":38,"text":"すると、主の火が降って、焼き尽くす献げ物と薪、石、塵を焼き、溝にあった水をもなめ尽くした。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["火","ひ"],["が"],["降って","ふって"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["薪","たきぎ"],["、"],["石","いし"],["、"],["塵","ごみ"],["を"],["焼き","やき"],["、"],["溝","みぞ"],["に"],["あった"],["水","みず"],["を"],["も"],["なめ"],["尽くした","つくした"],["。"]]},{"verse":39,"text":"これを見たすべての民はひれ伏し、「主こそ神です。主こそ神です」と言った。","tok":[["これ"],["を"],["見た","みた"],["すべて"],["の"],["民","たみ"],["は"],["ひれ伏し","ひれふし"],["、"],["「"],["主","ぬし"],["こそ"],["神","かみ"],["です"],["。"],["主","ぬし"],["こそ"],["神","かみ"],["です"],["」"],["と"],["言った","いった
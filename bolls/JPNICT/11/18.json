,["が"],["海","うみ"],["の"],["かなた"],["から"],["上って","のぼって"],["来ます","きます"],["。"],["」"],["エリヤ"],["は"],["言った","いった"],["。"],["「"],["アハブ"],["の"],["ところ"],["に"],["上って","のぼって"],["行き","いき"],["、"],["激しい","はげしい"],["雨","あめ"],["に"],["閉じ込められない","とじこめられない"],["うち"],["に"],["、"],["馬","うま"],["を"],["車","くるま"],["に"],["つないで"],["下って","くだって"],["行く","いく"],["よう"],["に"],["伝え","つたえ"],["なさい"],["。"],["」"]]},{"verse":45,"text":"そうするうちに、空は厚い雲に覆われて暗くなり、風も出て来て、激しい雨になった。アハブは車に乗ってイズレエルに向かった。","tok":[["そう"],["する"],["うち"],["に"],["、"],["空","そら"],["は"],["厚い","あつい"],["雲","くも"],["に"],["覆われて","おおわれて"],["暗く","くらく"],["なり"],["、"],["風","かぜ"],["も"],["出て","でて"],["来て","きて"],["、"],["激しい","はげしい"],["雨","あめ"],["に"],["なった"],["。"],["アハブ"],["は"],["車","くるま"],["に"],["乗って","のって"],["イズレエル"],["に"],["向かった","むかった"],["。"]]},{"verse":46,"text":"主の御手がエリヤに臨んだので、エリヤは裾をからげてイズレエルの境までアハブの先を走って行った。","tok":[["主","ぬし"],["の"],["御手","おて"],["が"],["エリヤ"],["に"],["臨んだ","のぞんだ"],["ので"],["、"],["エリヤ"],["は"],["裾","すそ"],["を"],["からげて"],["イズレエル"],["の"],["境","さかい"],["まで"],["アハブ"],["の"],["先","さき"],["を"],["走って","はしって"],["行った","いった"],["。"]]}]
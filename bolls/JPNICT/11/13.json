["の"],["言葉","ことば"],["に"],["従って","したがって"],["、"],["『"],["パン"],["を"],["食べる","たべる"],["な"],["、"],["水","みず"],["を"],["飲む","のむ"],["な"],["、"],["行く","いく"],["とき"],["通った","かよった"],["道","みち"],["に"],["戻って","もどって"],["は"],["ならない"],["』"],["と"],["戒められて","いましめられて"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":10,"text":"その人はベテルに来たとき通った道に戻ることなく、ほかの道を通って帰って行った。","tok":[["その"],["人","ひと"],["は"],["ベテル"],["に"],["来た","きた"],["とき"],["通った","かよった"],["道","みち"],["に"],["戻る","もどる"],["こと"],["なく"],["、"],["ほか"],["の"],["道","みち"],["を"],["通って","とおって"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":11,"text":"ベテルに一人の老預言者が住んでいた。息子の一人が来て、神の人がその日ベテルで行ったすべてのこと、王に向かって告げた言葉を語り聞かせた。息子たちがそれを父に語り聞かせると、","tok":[["ベテル"],["に"],["一人","ひとり"],["の"],["老","ろう"],["預言者","よげんしゃ"],["が"],["住んで","すんで"],["いた"],["。"],["息子","むすこ"],["の"],["一人","ひとり"],["が"],["来て","きて"],["、"],["神","かみ"],["の"],["人","ひと"],["が"],["その"],["日","ひ"],["ベテル"],["で"],["行った","おこなった"],["すべて"],["の"],["こと"],["、"],["王","おう"],["に"],["向かって","むかって"],["告げた","つげた"],["言葉","ことば"],["を"],["語り聞かせた","かたりきかせた"],["。"],["息子","むすこ"],["たち"],["が"],["それ"],["を"],["父","ちち"],["に"],["語り聞かせる","かたりきかせる"],["と"],["、"]]},{"verse":12,"text":"父は、「その人はどの道を行ったか」と尋ねた。息子たちは、ユダから来た神の人がどの道を行ったか見ていた。","tok":[["父","ちち"],["は"],["、"],["「"],["その"],["人","ひと"],["は"],["どの"],["道","みち"],["を"],["行った","おこなった"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["息子","むすこ"],["たち"],["は"],["、"],["ユダ"],["から"],["来た","きた"],["神","かみ"],["の"],["人","ひと"],["が"],["どの"],["道","みち"],["を"],["行った","おこなった"],["か"],["見て","みて"],["いた"],["。"]]},{"verse":13,"text":"老預言者は息子たちに、「ろばに鞍を置くように」と言い、彼らがろばに鞍を置くと、そのろばに乗り、","tok":[["老","ろう"],["預言者","よげんしゃ"],["は"],["息子","むすこ"],["たち"],["に"],["、"],["「"],["ろば"],["に"],["鞍","くら"],["を"],["置く","おく"],["よう"],["に"],["」"],["と"],["言い","いい"],["、"],["彼","かれ"],["ら"],["が"],["ろば"],["に"],["鞍","くら"],["を"],["置く","おく"],["と"],["、"],["その"],["ろば"],["に"],["乗り","のり"],["、"]]},{"verse":14,"text":"神の人の後を追った。彼は樫の木の下で休んでいる神の人を見つけ、「ユダからおいでになった神の人はあなたですか」と問うた。その人は「わたしです」と答えた。","tok":[["神","かみ"],["の"],["人","ひと"],["の"],["後","あと"],["を"],["追った","おった"],["。"],["彼","かれ"],["は"],["樫","かし"],["の"],["木","き"],["の"],["下","もと"],["で"],["休んで","やすんで"],["いる"],["神","かみ"],["の"],["人","ひと"],["を"],["見つけ","みつけ"],["、"],["「"],["ユダ"],["から"],["おいで"],["に"],["なった"],["神","かみ"],["の"],["人","ひと"],["は"],["あなた"],["です"],["か"],["」"],["と"],["問うた","とうた"],["。"],["その"],["人","ひと"],["は"],["「"],["わたし"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":15,"text":"老預言者は、「一緒にわたしの家に来て、食事をなさいませんか」と勧めたが、","tok":[["老","ろう"],["預言者","よげんしゃ"],["は"],["、"],["「"],["一緒","いっしょ"],["に"],["わたし"],["の"],["家","いえ"],["に"],["来て","きて"],["、"],["食事","しょくじ"],["を"],["なさいません"],["か"],["」"],["と"],["勧めた","すすめた"],["が"],["、"]]},{"verse":16,"text":"彼は答えた。「一緒に引き返し、一緒に行くことはできません。ここで一緒にパンを食べ、水を飲むことはできません。","tok":[["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["一緒","いっしょ"],["に"],["引き返し","ひきかえし"],["、"],["一緒","いっしょ"],["に"],["行く","いく"],["こと"],["は"],["できません"],["。"],["ここ"],["で"],["一緒","いっしょ"],["に"],["パン"],["を"],["食べ","たべ"],["、"],["水","みず"],["を"],["飲む","のむ"],["こと"],["は"],["できません"],["。"]]},{"verse":17,"text":"主の言葉によって、『そこのパンを食べるな、水を飲むな、行くとき通った道に戻るな』と告げられているのです。」","tok":[["主","ぬし"],["の"],["言葉","ことば"],["によって"],["、"],["『"],["そこ"],["の"],["パン"],["を"],["食べる","たべる"],["な"],["、"],["水","みず"],["を"],["飲む","のむ"],["な"],["、"],["行く","いく"],["とき"],["通った","かよった"],["道","みち"],["に"],["戻る","もどる"],["な"],["』"],["と"],["告げられて","つげられて"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":18,"text":"しかし、老預言者は言った。「わたしもあなたと同様、預言者です。御使いが主の言葉に従って、『あなたの家にその人を連れ戻し、パンを食べさせ、水を飲ませよ』とわたしに告げました。」彼はその人を欺いたのである。","tok":[["しかし"],["、"],["老","ろう"],["預言者","よげんしゃ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["も"],["あなた"],["と"],["同様","どうよう"],["、"],["預言者","よげんしゃ"],["です"],["。"],["御使い","おつかい"],["が"],["主","ぬし"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["、"],["『"],["あなた"],["の"],["家","いえ"],["に"],["その"],["人","ひと"],["を"],["連れ戻し","つれもどし"],["、"],["パン"],["を"],["食べさせ","たべさせ"],["、"],["水","みず"],["を"],["飲ませ","のませ"],["よ"],["』"],["と"],["わたし"],["に"],["告げました","つげました"],["。"],["」"],["彼","かれ"],["は"],["その"],["人","ひと"],["を"],["欺いた","あざむいた"],["ので"],["ある"],["。"]]},{"verse":19,"text":"その人は彼と共に引き返し、彼の家でパンを食べ、水を飲んだ。","tok":[["その"],["人","ひと"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["引き返し","ひきかえし"],["、"],["彼","かれ"],["の"],["家","いえ"],["で"],["パン"],["を"],["食べ","たべ"],["、"],["水","みず"],["を"],["飲んだ","のんだ"],["。"]]},{"verse":20,"text":"彼らが食卓に着いているとき、神の人を連れ戻した預言者に主の言葉が臨んだ。","tok":[["彼","かれ"],["ら"],["が"],["食卓","しょくたく"],["に"],["着いて","ついて"],["いる"],["とき"],["、"],["神","かみ"],["の"],["人","ひと"],["を"],["連れ戻した","つれもどした"],["預言者","よげんしゃ"],["に"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["臨んだ","のぞんだ"],["。"]]},{"verse":21,"text":"彼はユダから来た神の人に向かって大声で言った。「主はこう言われる。『あなたは主の命令に逆らい、あなたの神、主が授けた戒めを守らず、","tok":[["彼","かれ"],["は"],["ユダ"],["から"],["来た","きた"],["神","かみ"],["の"],["人","ひと"],["に"],["向かって","むかって"],["大声","おおごえ"],["で"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["あなた"],["は"],["主","ぬし"],["の"],["命令","めいれい"],["に"],["逆らい","さからい"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["授けた","さずけた"],["戒め","いましめ"],["を"],["守らず","まもらず"],["、"]]},{"verse":22,"text":"引き返して来て、パンを食べるな、水を飲むなと命じられていた所でパンを食べ、水を飲んだので、あなたのなきがらは先祖の墓には入れられない。』」","tok":[["引き返して","ひきかえして"],["来て","きて"],["、"],["パン"],["を"],["食べる","たべる"],["な"],["、"],["水","みず"],["を"],["飲む","のむ"],["な"],["と"],["命じられて","めいじられて"],["いた"],["所","ところ"],["で"],["パン"],["を"],["食べ","たべ"],["、"],["水","みず"],["を"],["飲んだ","のんだ"],["ので"],["、"],["あなた"],["の"],["なきがら"],["は"],["先祖","せんぞ"],["の"],["墓","はか"],["に"],["は"],["入れられない","いれられない"],["。"],["』"],["」"]]},{"verse":23,"text":"神の人がパンを食べ、水を飲んだ後、老預言者は連れ戻したその預言者のろばに鞍を置いてやった。","tok":[["神","かみ"],["の"],["人","ひと"],["が"],["パン"],["を"],["食べ","たべ"],["、"],["水","みず"],["を"],["飲んだ","のんだ"],["後","あと"],["、"],["老","ろう"],["預言者","よげんしゃ"],["は"],["連れ戻した","つれもどした"],["その"],["預言者","よげんしゃ"],["の"],["ろば"],["に"],["鞍","くら"],["を"],["置いて","おいて"],["やった"],["。"]]},{"verse":24,"text":"その人は立ち去ったが、途中一頭の獅子に出会い、殺されてしまった。なきがらは道に打ち捨てられたまま、ろばがその傍らに立ち、獅子もそのなきがらの傍らに立っていた。","tok":[["その"],["人","ひと"],["は"],["立ち去った","たちさった"],["が"],["、"],["途中","とちゅう"],["一頭","いちとう"],["の"],["獅子","しし"],["に"],["出会い","であい"],["、"],["殺されて","ころされて"],["しまった"],["。"],["なきがら"],["は"],["道","みち"],["に"],["打ち捨てられた","うちすてられた"],["まま"],["、"],["ろば"],["が"],["その"],["傍ら","かたわら"],["に"],["立ち","たち"],["、"],["獅子","しし"],["も"],["その"],["なきがら"],["の"],["傍ら","かたわら"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":25,"text":"そこを通りかかる者があって、道に打ち捨てられたなきがらと、傍らに立つ獅子を見、老預言者の住んでいる町に来てそのことを話した。","tok":[["そこ"],["を"],["通りかかる","とおりかかる"],["者","もの"],["が"],["あって"],["、"],["道","みち"],["に"],["打ち捨てられた","うちすてられた"],["なきがら"],["と"],["、"],["傍ら","かたわら"],["に"],["立つ","たつ"],["獅子","しし"],["を"],["見","み"],["、"],["老","ろう"],["預言者","よげんしゃ"],["の"],["住んで","すんで"],["いる"],["町","まち"],["に"],["来て","きて"],["その"],["こと"],["を"],["話した","はなした"],["。"]]},{"verse":26,"text":"神の人をその道から連れ戻した老預言者はこれを聞くと、「それはあの神の人のことだ。彼は主の御命令に逆らったので、主はお告げになった御言葉のとおりに彼を獅子に渡し、獅子は彼を引き裂き、殺してしまったのだ」と言い、","tok":[["神","かみ"],["の"],["人","ひと"],["を"],["その"],["道","みち"],["から"],["連れ戻した","つれもどした"],["老","ろう"],["預言者","よげんしゃ"],["は"],["これ"],["を"],["聞く","きく"],["と"],["、"],["「"],["それ"],["は"],["あの"],["神","かみ"],["の"],["人","ひと"],["の"],["こと"],["だ"],["。"],["彼","かれ"],["は"],["主","ぬし"],["の"],["御命令","ごめいれい"],["に"],["逆らった","さからった"],["ので"],["、"],["主","ぬし"],["は"],["お告げ","おつげ"],["に"],["なった"],["御言葉","おことば"],["の"],["とおり"],["に"],["彼","かれ"],["を"],["獅子","しし"],["に"],["渡し","わたし"],["、"],["獅子","しし"],["は"],["彼","かれ"],["を"],["引き裂き","ひきさき"],["、"],["殺して","ころして"],["しまった"],["の"],["だ"],["」"],["と"],["言い","いい"],["、"]]},{"verse":27,"text":"息子たちに「ろばに鞍を置くように」と命じた。息子たちが鞍を置くと、","tok":[["息子","むすこ"],["たち"],["に"],["「"],["ろば"],["に"],["鞍","くら"],["を"],["置く","おく"],["よう"],["に"],["」"],["と"],["命じた","めいじた"],["。"],["息子","むすこ"],["たち"],["が"],["鞍","くら"],["を"],["置く","おく"],["と"],["、"]]},{"verse":28,"text":"老預言者は出かけて行き、道に打ち捨てられているなきがらと、その傍らに立つろばと獅子を見つけた。獅子はなきがらを食べず、ろばも引き裂かずにいた。","tok":[["老","ろう"],["預言者","よげんしゃ"],["は"],["出かけて","でかけて"],["行き","いき"],["、"],["道","みち"],["に"],["打ち捨てられて","うちすてられて"],["いる"],["なきがら"],["と"],["、"],["その"],["傍ら","かたわら"],["に"],["立つ","たつ"],["ろば"],["と"],["獅子","しし"],["を"],["見つけた","みつけた"],["。"],["獅子","しし"],["は"],["なきがら"],["を"],["食べず","たべず"],["、"],["ろば"],["も"],["引き裂かず","ひきさかず"],["に"],["いた
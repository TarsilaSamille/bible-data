[{"verse":1,"text":"キリスト‧イエスの僕であるパウロとテモテから、フィリピにいて、キリスト‧イエスに結ばれているすべての聖なる者たち、ならびに監督たちと奉仕者たちへ。","tok":[["キリスト"],["‧"],["イエス"],["の"],["僕","ぼく"],["で"],["ある"],["パウロ"],["と"],["テモテ"],["から"],["、"],["フィリピ"],["に"],["いて"],["、"],["キリスト"],["‧"],["イエス"],["に"],["結ばれて","むすばれて"],["いる"],["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["たち"],["、"],["ならび"],["に"],["監督","かんとく"],["たち"],["と"],["奉仕者","ほうししゃ"],["たち"],["へ"],["。"]]},{"verse":2,"text":"わたしたちの父である神と主イエス‧キリストからの恵みと平和が、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["から"],["の"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしは、あなたがたのことを思い起こす度に、わたしの神に感謝し、","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["思い起こす","おもいおこす"],["度","たび"],["に"],["、"],["わたし"],["の"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["、"]]},{"verse":4,"text":"あなたがた一同のために祈る度に、いつも喜びをもって祈っています。","tok":[["あなた"],["がた"],["一同","いちどう"],["の"],["ため"],["に"],["祈る","いのる"],["度","たび"],["に"],["、"],["いつも"],["喜び","よろこび"],["を"],["もって"],["祈って","いのって"],["います"],["。"]]},{"verse":5,"text":"それは、あなたがたが最初の日から今日まで、福音にあずかっているからです。","tok":[["それ"],["は"],["、"],["あなた"],["がた"],["が"],["最初","さいしょ"],["の"],["日","ひ"],["から"],["今日","きょう"],["まで"],["、"],["福音","ふくいん"],["に"],["あずかって"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"あなたがたの中で善い業を始められた方が、キリスト‧イエスの日までに、その業を成し遂げてくださると、わたしは確信しています。","tok":[["あなた"],["がた"],["の"],["中","なか"],["で"],["善い","よい"],["業","ごう"],["を"],["始められた","はじめられた"],["方","ほう"],["が"],["、"],["キリスト"],["‧"],["イエス"],["の"],["日","ひ"],["まで"],["に"],["、"],["その"],["業","ごう"],["を"],["成し遂げて","なしとげて"],["くださる"],["と"],["、"],["わたし"],["は"],["確信","かくしん"],["して"],["います"],["。"]]},{"verse":7,"text":"わたしがあなたがた一同についてこのように考えるのは、当然です。というのは、監禁されているときも、福音を弁明し立証するときも、あなたがた一同のことを、共に恵みにあずかる者と思って、心に留めているからです。","tok":[["わたし"],["が"],["あなた"],["がた"],["一同","いちどう"],["について"],["この"],["よう"],["に"],["考える","かんがえる"],["の"],["は"],["、"],["当然","とうぜん"],["です"],["。"],["と"],["いう"],["の"],["は"],["、"],["監禁","かんきん"],["されて"],["いる"],["とき"],["も"],["、"],["福音","ふくいん"],["を"],["弁明","べんめい"],["し"],["立証","りっしょう"],["する"],["とき"],["も"],["、"],["あなた"],["がた"],["一同","いちどう"],["の"],["こと"],["を"],["、"],["共","とも"],["に"],["恵み","めぐみ"],["に"],["あずかる"],["者","もの"],["と"],["思って","おもって"],["、"],["心","こころ"],["に"],["留めて","とめて"],["いる"],["から"],["です"],["。"]]},{"verse":8,"text":"わたしが、キリスト‧イエスの愛の心で、あなたがた一同のことをどれほど思っているかは、神が証ししてくださいます。","tok":[["わたし"],["が"],["、"],["キリスト"],["‧"],["イエス"],["の"],["愛","あい"],["の"],["心","こころ"],["で"],["、"],["あなた"],["がた"],["一同","いちどう"],["の"],["こと"],["を"],["どれ"],["ほど"],["思って","おもって"],["いる"],["か"],["は"],["、"],["神","かみ"],["が"],["証し","あかし"],["して"],["くださいます"],["。"]]},{"verse":9,"text":"わたしは、こう祈ります。知る力と見抜く力とを身に着けて、あなたがたの愛がますます豊かになり、","tok":[["わたし"],["は"],["、"],["こう"],["祈ります","いのります"],["。"],["知る","しる"],["力","ちから"],["と"],["見抜く","みぬく"],["力","ちから"],["と"],["を"],["身","み"],["に"],["着けて","つけて"],["、"],["あなた"],["がた"],["の"],["愛","あい"],["が"],["ますます"],["豊か","ゆたか"],["に"],["なり"],["、"]]},{"verse":10,"text":"本当に重要なことを見分けられるように。そして、キリストの日に備えて、清い者、とがめられるところのない者となり、","tok":[["本当","ほんとう"],["に"],["重要","じゅうよう"],["な"],["こと"],["を"],["見分けられる","みわけられる"],["よう"],["に"],["。"],["そして"],["、"],["キリスト"],["の"],["日","ひ"],["に"],["備えて","そなえて"],["、"],["清い","きよい"],["者","もの"],["、"],["とがめられる"],["ところ"],["の"],["ない"],["者","もの"],["と"],["なり"],["、"]]},{"verse":11,"text":"イエス‧キリストによって与えられる義の実をあふれるほどに受けて、神の栄光と誉れとをたたえることができるように。","tok":[["イエス"],["‧"],["キリスト"],["によって"],["与えられる","あたえられる"],["義","ぎ"],["の"],["実","じつ"],["を"],["あふれる"],["ほど"],["に"],["受けて","うけて"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["と"],["誉れ","ほまれ"],["と"],["を"],["たたえる"],["こと"],["が"],["できる"],["よう"],["に"],["。"]]},{"verse":12,"text":"兄弟たち、わたしの身に起こったことが、かえって福音の前進に役立ったと知ってほしい。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたし"],["の"],["身","み"],["に"],["起こった","おこった"],["こと"],["が"],["、"],["かえって"],["福音","ふくいん"],["の"],["前進","ぜんしん"],["に"],["役立った","やくだった"],["と"],["知って","しって"],["ほしい"],["。"]]},{"verse":13,"text":"つまり、わたしが監禁されているのはキリストのためであると、兵営全体、その他のすべての人々に知れ渡り、","tok":[["つまり"],["、"],["わたし"],["が"],["監禁","かんきん"],["されて"],["いる"],["の"],["は"],["キリスト"],["の"],["ため"],["で"],["ある"],["と"],["、"],["兵営","へいえい"],["全体","ぜんたい"],["、"],["その"],["他","た"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["知れ渡り","しれわたり"],["、"]]},{"verse":14,"text":"主に結ばれた兄弟たちの中で多くの者が、わたしの捕らわれているのを見て確信を得、恐れることなくますます勇敢に、御言葉を語るようになったのです。","tok":[["主に","おもに"],["結ばれた","むすばれた"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["で"],["多く","おおく"],["の"],["者","もの"],["が"],["、"],["わたし"],["の"],["捕らわれて","とらわれて"],["いる"],["の"],["を"],["見て","みて"],["確信","かくしん"],["を"],["得","え"],["、"],["恐れる","おそれる"],["こと"],["なく"],["ますます"],["勇敢","ゆうかん"],["に"],["、"],["御言葉","おことば"],["を"],["語る","かたる"],["よう"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":15,"text":"キリストを宣べ伝えるのに、ねたみと争いの念にかられてする者もいれば、善意でする者もいます。","tok":[["キリスト"],["を"],["宣べ伝える","のべつたえる"],["のに"],["、"],["ねたみ"],["と"],["争い","あらそい"],["の"],["念","ねん"],["に"],["かられて"],["する"],["者","もの"],["も"],["いれば"],["、"],["善意","ぜんい"],["で"],["する"],["者","もの"],["も"],["います"],["。"]]},{"verse":16,"text":"一方は、わたしが福音を弁明するために捕らわれているのを知って、愛の動機からそうするのですが、","tok":[["一方","いっぽう"],["は"],["、"],["わたし"],["が"],["福音","ふくいん"],["を"],["弁明","べんめい"],["する"],["ため"],["に"],["捕らわれて","とらわれて"],["いる"],["の"],["を"],["知って","しって"],["、"],["愛","あい"],["の"],["動機","どうき"],["から"],["そう"],["する"],["の"],["です"],["が"],["、"]]},{"verse":17,"text":"他方は、自分の利益を求めて、獄中のわたしをいっそう苦しめようという不純な動機からキリストを告げ知らせているのです。","tok":[["他方","たほう"],["は"],["、"],["自分","じぶん"],["の"],["利益","りえき"],["を"],["求めて","もとめて"],["、"],["獄中","ごくちゅう"],["の"],["わたし"],["を"],["いっそう"],["苦しめよう","くるしめよう"],["と"],["いう"],["不純","ふじゅん"],["な"],["動機","どうき"],["から"],["キリスト"],["を"],["告げ知らせて","つげしらせて"],["いる"],["の"],["です"],["。"]]},{"verse":18,"text":"だが、それがなんであろう。口実であれ、真実であれ、とにかく、キリストが告げ知らされているのですから、わたしはそれを喜んでいます。これからも喜びます。","tok":[["だ"],["が"],["、"],["それ"],["が"],["なん"],["で"],["あろう"],["。"],["口実","こうじつ"],["で"],["あれ"],["、"],["真実","しんじつ"],["で"],["あれ"],["、"],["とにかく"],["、"],["キリスト"],["が"],["告げ知らされて","つげしらされて"],["いる"],["の"],["です"],["から"],["、"],["わたし"],["は"],["それ"],["を"],["喜んで","よろこんで"],["います"],["。"],["これ"],["から"],["も"],["喜びます","よろこびます"],["。"]]},{"verse":19,"text":"というのは、あなたがたの祈りと、イエス‧キリストの霊の助けとによって、このことがわたしの救いになると知っているからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["祈り","いのり"],["と"],["、"],["イエス"],["‧"],["キリスト"],["の"],["霊","れい"],["の"],["助け","たすけ"],["と"],["によって"],["、"],["この"],["こと"],["が"],["わたし"],["の"],["救い","すくい"],["に"],["なる"],["と"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":20,"text":"そして、どんなことにも恥をかかず、これまでのように今も、生きるにも死ぬにも、わたしの身によってキリストが公然とあがめられるようにと切に願い、希望しています。","tok":[["そして"],["、"],["どんな"],["こと"],["に"],["も"],["恥","はじ"],["を"],["かかず"],["、"],["これ"],["まで"],["の"],["よう"],["に"],["今","いま"],["も"],["、"],["生きる","いきる"],["に"],["も"],["死ぬ","しぬ"],["に"],["も"],["、"],["わたし"],["の"],["身","み"],["によって"],["キリスト"],["が"],["公然","こうぜん"],["と"],["あがめられる"],["よう"],["に"],["と"],["切に","せつに"],["願い","ねがい"],["、"],["希望","きぼう"],["して"],["います"],["。"]]},{"verse":21,"text":"わたしにとって、生きるとはキリストであり、死ぬことは利益なのです。","tok":[["わたし"],["にとって"],["、"],["生きる","いきる"],["と"],["は"],["キリスト"],["で"],["あり"],["、"],["死ぬ","しぬ"],["こと"],["は"],["利益","りえき"],["な"],["の"],["です"],["。"]]},{"verse":22,"text":"けれども、肉において生き続ければ、実り多い働きができ、どちらを選ぶべきか、わたしには分かりません。","tok":[["けれど"],["も"],["、"],["肉","にく"],["に"],["おいて"],["生き","いき"],["続ければ","つづければ"],["、"],["実り","みのり"],["多い","おおい"],["働き","はたらき"],["が"],["でき"],["、"],["どちら"],["を"],["選ぶべき","えらぶべき"],["か"],["、"],["わたし"],["に"],["は"],["分かりません","わかりません"],["。"]]},{"verse":23,"text":"この二つのことの間で、板挟みの状態です。一方では、この世を去って、キリストと共にいたいと熱望しており、この方がはるかに望ましい。","tok":[["この"],["二","ふた"],["つ"],["の"],["こと"],["の"],["間","あいだ"],["で"],["、"],["板挟み","いたばさみ"],["の"],["状態","じょうたい"],["です"],["。"],["一方","いっぽう"],["で"],["は"],["、"],["この世","このよ"],["を"],["去って","さって"],["、"],["キリスト"],["と"],["共","とも"],["に"],["いたい"],["と"],["熱望","ねつぼう"],["して"],["おり"],["、"],["この"],["方","ほう"],["が"],["はるか"],["に"],["望ましい","のぞましい"],["。"]]},{"verse":24,"text":"だが他方では、肉にとどまる方が、あなたがたのためにもっと必要です。","tok":[["だ"],["が"],["他方","たほう"],["で"],["は"],["、"],["肉","にく"],["に"],["とどまる"],["方","ほう"],["が"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["もっと"],["必要","ひつよう"],["です"],["。"]]},{"verse":25,"text":"こう確信していますから、あなたがたの信仰を深めて喜びをもたらすように、いつもあなたがた一同と共にいることになるでしょう。","tok":[["こう"],["確信","かくしん"],["して"],["います"],["から"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["を"],["深めて","ふかめて"],["喜び","よろこび"],["を"],["もたらす"],["よう"],["に"],["、"],["いつも"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["いる"],["こと"],["に"],["なるでしょう"],["。"]]},{"verse":26,"text":"そうなれば、わたしが再びあなたがたのもとに姿を見せるとき、キリスト‧イエスに結ばれているというあなたがたの誇りは、わたしゆえに増し加わることになります。","tok":[["そう"],["なれば"],["、"],["わたし"],["が"],["再び","ふたたび"],["あなた"],["がた"],["の"],["もと"],["に"],["姿","すがた"],["を"],["見せる","みせる"],["とき"],["、"],["キリスト"],["‧"],["イエス"],["に"],["結ばれて","むすばれて"],["いる"],["と"],["いう"],["あなた"],["がた"],["の"],["誇り","ほこり"],["は"],["、"],["わたし"],["ゆえ"],["に"],["増し","まし"],["加わる","くわわる"],["こと"],["に"],["なります"],["。"]]},{"verse":27,"text":"ひたすらキリストの福音にふさわしい生活を送りなさい。そうすれば、そちらに行ってあなたがたに会うにしても、離れているにしても、わたしは次のことを聞けるでしょう。あなたがたは一つの霊によってしっかり立ち、心を合わせて福音の信仰のために共に戦っており、","tok":[["ひたすら"],["キリスト"],["の"],["福音","ふくいん"],["に"],["ふさわしい"],["生活","せいかつ"],["を"],["送り","おくり"],["なさい"],["。"],["そう"],["すれば"],["、"],["そちら"],["に"],["行って","いって"],["あなた"],["がた"],["に"],["会う","あう"],["に"],["して"],["も"],["、"],["離れて","はなれて"],["いる"],["に"],["して"],["も"],["、"],["わたし"],["は"],["次","つぎ"],["の"],["こと"],["を"],["聞けるでしょう","きけるでしょう"],["。"],["あなた"],["がた"],["は"],["一","ひと"],["つ"],["の"],["霊","れい"],["によって"],["しっかり"],["立ち","たち"],["、"],["心","こころ"],["を"],["合わせて","あわせて"],["福音","ふくいん"],["の"],["信仰","しんこう"],["の"],["ため"],["に"],["共","とも"],["に"],["戦って","たたかって"],["おり"],["、"]]},{"verse":28,"text":"どんなことがあっても、反対者たちに脅されてたじろぐことはないのだと。このことは、反対者たちに、彼ら自身の滅びとあなたがたの救いを示すものです。これは神によることです。","tok":[["どんな"],["こと"],["が"],["あって"],["も"],["、"],["反対者","はんたいしゃ"],["たち"],["に"],["脅されて","おどされて"],["たじろぐ"],["こと"],["は"],["ない"],["の"],["だ"],["と"],["。"],["この"],["こと"],["は"],["、"],["反対者","はんたいしゃ"],["たち"],["に"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["の"],["滅び","ほろび"],["と"],["あなた"],["がた"],["の"],["救い","すくい"],["を"],["示す","しめす"],["もの"],["です"],["。"],["これ"],["は"],["神","かみ"],["に"],["よる"],["こと"],["です"],["。"]]},{"verse":29,"text":"つまり、あなたがたには、キリストを信じることだけでなく、キリストのために苦しむことも、
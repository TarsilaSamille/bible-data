[{"verse":1,"text":"では、わたしの兄弟たち、主において喜びなさい。同じことをもう一度書きますが、これはわたしには煩わしいことではなく、あなたがたにとって安全なことなのです。","tok":[["で"],["は"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["主に","おもに"],["おいて"],["喜び","よろこび"],["なさい"],["。"],["同じ","おなじ"],["こと"],["を"],["もう"],["一度","いちど"],["書きます","かきます"],["が"],["、"],["これ"],["は"],["わたし"],["に"],["は"],["煩わしい","わずらわしい"],["こと"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["にとって"],["安全","あんぜん"],["な"],["こと"],["な"],["の"],["です"],["。"]]},{"verse":2,"text":"あの犬どもに注意しなさい。よこしまな働き手たちに気をつけなさい。切り傷にすぎない割礼を持つ者たちを警戒しなさい。","tok":[["あの"],["犬","いぬ"],["ども"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"],["よこしま"],["な"],["働き手","はたらきて"],["たち"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["切り傷","きりきず"],["に"],["すぎない"],["割礼","かつれい"],["を"],["持つ","もつ"],["者","もの"],["たち"],["を"],["警戒","けいかい"],["し"],["なさい"],["。"]]},{"verse":3,"text":"彼らではなく、わたしたちこそ真の割礼を受けた者です。わたしたちは神の霊によって礼拝し、キリスト‧イエスを誇りとし、肉に頼らないからです。","tok":[["彼","かれ"],["ら"],["で"],["は"],["なく"],["、"],["わたしたち"],["こそ"],["真","しん"],["の"],["割礼","かつれい"],["を"],["受けた","うけた"],["者","もの"],["です"],["。"],["わたしたち"],["は"],["神","かみ"],["の"],["霊","れい"],["によって"],["礼拝","れいはい"],["し"],["、"],["キリスト"],["‧"],["イエス"],["を"],["誇り","ほこり"],["と"],["し"],["、"],["肉","にく"],["に"],["頼らない","たよらない"],["から"],["です"],["。"]]},{"verse":4,"text":"とはいえ、肉にも頼ろうと思えば、わたしは頼れなくはない。だれかほかに、肉に頼れると思う人がいるなら、わたしはなおさらのことです。","tok":[["と"],["は"],["いえ"],["、"],["肉","にく"],["に"],["も"],["頼ろう","たよろう"],["と"],["思えば","おもえば"],["、"],["わたし"],["は"],["頼れなく","たよれなく"],["は"],["ない"],["。"],["だれ"],["か"],["ほか"],["に"],["、"],["肉","にく"],["に"],["頼れる","たよれる"],["と"],["思う","おもう"],["人","ひと"],["が"],["いるなら"],["、"],["わたし"],["は"],["なおさら"],["の"],["こと"],["です"],["。"]]},{"verse":5,"text":"わたしは生まれて八日目に割礼を受け、イスラエルの民に属し、ベニヤミン族の出身で、ヘブライ人の中のヘブライ人です。律法に関してはファリサイ派の一員、","tok":[["わたし"],["は"],["生まれて","うまれて"],["八日目","ようかめ"],["に"],["割礼","かつれい"],["を"],["受け","うけ"],["、"],["イスラエル"],["の"],["民","たみ"],["に"],["属し","ぞくし"],["、"],["ベニヤミン"],["族","ぞく"],["の"],["出身","しゅっしん"],["で"],["、"],["ヘブライ"],["人","にん"],["の"],["中","なか"],["の"],["ヘブライ"],["人","にん"],["です"],["。"],["律法","りっぽう"],["に"],["関し","かんし"],["ては"],["ファリサイ"],["派","は"],["の"],["一員","いちいん"],["、"]]},{"verse":6,"text":"熱心さの点では教会の迫害者、律法の義については非のうちどころのない者でした。","tok":[["熱心","ねっしん"],["さ"],["の"],["点","てん"],["で"],["は"],["教会","きょうかい"],["の"],["迫害者","はくがいしゃ"],["、"],["律法","りっぽう"],["の"],["義","ぎ"],["について"],["は"],["非","ひ"],["の"],["うち"],["どころ"],["の"],["ない"],["者","もの"],["でした"],["。"]]},{"verse":7,"text":"しかし、わたしにとって有利であったこれらのことを、キリストのゆえに損失と見なすようになったのです。","tok":[["しかし"],["、"],["わたし"],["にとって"],["有利","ゆうり"],["で"],["あった"],["これ"],["ら"],["の"],["こと"],["を"],["、"],["キリスト"],["の"],["ゆえ"],["に"],["損失","そんしつ"],["と"],["見なす","みなす"],["よう"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":8,"text":"そればかりか、わたしの主キリスト‧イエスを知ることのあまりのすばらしさに、今では他の一切を損失とみています。キリストのゆえに、わたしはすべてを失いましたが、それらを塵あくたと見なしています。キリストを得、","tok":[["それ"],["ばかり"],["か"],["、"],["わたし"],["の"],["主","ぬし"],["キリスト"],["‧"],["イエス"],["を"],["知る","しる"],["こと"],["の"],["あまり"],["の"],["すばらし"],["さ"],["に"],["、"],["今","いま"],["で"],["は"],["他","た"],["の"],["一切","いっさい"],["を"],["損失","そんしつ"],["と"],["みて"],["います"],["。"],["キリスト"],["の"],["ゆえ"],["に"],["、"],["わたし"],["は"],["すべて"],["を"],["失いました","うしないました"],["が"],["、"],["それ"],["ら"],["を"],["塵","ごみ"],["あくた"],["と"],["見なして","みなして"],["います"],["。"],["キリスト"],["を"],["得","え"],["、"]]},{"verse":9,"text":"キリストの内にいる者と認められるためです。わたしには、律法から生じる自分の義ではなく、キリストへの信仰による義、信仰に基づいて神から与えられる義があります。","tok":[["キリスト"],["の"],["内","うち"],["に"],["いる"],["者","もの"],["と"],["認められる","みとめられる"],["ため"],["です"],["。"],["わたし"],["に"],["は"],["、"],["律法","りっぽう"],["から"],["生じる","しょうじる"],["自分","じぶん"],["の"],["義","ぎ"],["で"],["は"],["なく"],["、"],["キリスト"],["へ"],["の"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["、"],["信仰","しんこう"],["に"],["基づいて","もとづいて"],["神","かみ"],["から"],["与えられる","あたえられる"],["義","ぎ"],["が"],["あります"],["。"]]},{"verse":10,"text":"わたしは、キリストとその復活の力とを知り、その苦しみにあずかって、その死の姿にあやかりながら、","tok":[["わたし"],["は"],["、"],["キリスト"],["と"],["その"],["復活","ふっかつ"],["の"],["力","ちから"],["と"],["を"],["知り","しり"],["、"],["その"],["苦しみ","くるしみ"],["に"],["あずかって"],["、"],["その"],["死","し"],["の"],["姿","すがた"],["に"],["あやかり"],["ながら"],["、"]]},{"verse":11,"text":"何とかして死者の中からの復活に達したいのです。","tok":[["何","なん"],["と"],["か"],["して"],["死者","ししゃ"],["の"],["中","なか"],["から"],["の"],["復活","ふっかつ"],["に"],["達したい","たっしたい"],["の"],["です"],["。"]]},{"verse":12,"text":"わたしは、既にそれを得たというわけではなく、既に完全な者となっているわけでもありません。何とかして捕らえようと努めているのです。自分がキリスト‧イエスに捕らえられているからです。","tok":[["わたし"],["は"],["、"],["既に","すでに"],["それ"],["を"],["得た","えた"],["と"],["いう"],["わけ"],["で"],["は"],["なく"],["、"],["既に","すでに"],["完全","かんぜん"],["な"],["者","もの"],["と"],["なって"],["いる"],["わけ"],["で"],["も"],["ありません"],["。"],["何","なん"],["と"],["か"],["して"],["捕らえよう","とらえよう"],["と"],["努めて","つとめて"],["いる"],["の"],["です"],["。"],["自分","じぶん"],["が"],["キリスト"],["‧"],["イエス"],["に"],["捕らえられて","とらえられて"],["いる"],["から"],["です"],["。"]]},{"verse":13,"text":"兄弟たち、わたし自身は既に捕らえたとは思っていません。なすべきことはただ一つ、後ろのものを忘れ、前のものに全身を向けつつ、","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたし"],["自身","じしん"],["は"],["既に","すでに"],["捕らえた","とらえた"],["と"],["は"],["思って","おもって"],["いません"],["。"],["なすべき"],["こと"],["は"],["ただ"],["一","ひと"],["つ"],["、"],["後ろ","うしろ"],["の"],["もの"],["を"],["忘れ","わすれ"],["、"],["前","まえ"],["の"],["もの"],["に"],["全身","ぜんしん"],["を"],["向け","むけ"],["つつ"],["、"]]},{"verse":14,"text":"神がキリスト‧イエスによって上へ召して、お与えになる賞を得るために、目標を目指してひたすら走ることです。","tok":[["神","かみ"],["が"],["キリスト"],["‧"],["イエス"],["によって"],["上","うえ"],["へ"],["召して","めして"],["、"],["お与え","おあたえ"],["に"],["なる"],["賞","しょう"],["を"],["得る","える"],["ため"],["に"],["、"],["目標","もくひょう"],["を"],["目指して","めざして"],["ひたすら"],["走る","はしる"],["こと"],["です"],["。"]]},{"verse":15,"text":"だから、わたしたちの中で完全な者はだれでも、このように考えるべきです。しかし、あなたがたに何か別の考えがあるなら、神はそのことをも明らかにしてくださいます。","tok":[["だ"],["から"],["、"],["わたしたち"],["の"],["中","なか"],["で"],["完全","かんぜん"],["な"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["この"],["よう"],["に"],["考えるべきです","かんがえるべきです"],["。"],["しかし"],["、"],["あなた"],["がた"],["に"],["何","なん"],["か"],["別","べつ"],["の"],["考え","かんがえ"],["が"],["あるなら"],["、"],["神","かみ"],["は"],["その"],["こと"],["を"],["も"],["明らか","あきらか"],["に"],["して"],["くださいます"],["。"]]},{"verse":16,"text":"いずれにせよ、わたしたちは到達したところに基づいて進むべきです。","tok":[["いずれ"],["に"],["せよ"],["、"],["わたしたち"],["は"],["到達","とうたつ"],["した"],["ところ"],["に"],["基づいて","もとづいて"],["進むべきです","すすむべきです"],["。"]]},{"verse":17,"text":"兄弟たち、皆一緒にわたしに倣う者となりなさい。また、あなたがたと同じように、わたしたちを模範として歩んでいる人々に目を向けなさい。","tok":[["兄弟","きょうだい"],["たち"],["、"],["皆","みな"],["一緒","いっしょ"],["に"],["わたし"],["に"],["倣う","ならう"],["者","もの"],["と"],["なり"],["なさい"],["。"],["また"],["、"],["あなた"],["がた"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["わたしたち"],["を"],["模範","もはん"],["として"],["歩んで","あゆんで"],["いる"],["人々","ひとびと"],["に"],["目","め"],["を"],["向け","むけ"],["なさい"],["。"]]},{"verse":18,"text":"何度も言ってきたし、今また涙ながらに言いますが、キリストの十字架に敵対して歩んでいる者が多いのです。","tok":[["何度","なんど"],["も"],["言って","いって"],["きた"],["し"],["、"],["今","いま"],["また"],["涙","なみだ"],["ながら"],["に"],["言います","いいます"],["が"],["、"],["キリスト"],["の"],["十字架","じゅうじか"],["に"],["敵対","てきたい"],["して"],["歩んで","あゆんで"],["いる"],["者","もの"],["が"],["多い","おおい"],["の"],["です"],["。"]]},{"verse":19,"text":"彼らの行き着くところは滅びです。彼らは腹を神とし、恥ずべきものを誇りとし、この世のことしか考えていません。","tok":[["彼","かれ"],["ら"],["の"],["行き着く","いきつく"],["ところ"],["は"],["滅びです","ほろびです"],["。"],["彼","かれ"],["ら"],["は"],["腹","はら"],["を"],["神","かみ"],["と"],["し"],["、"],["恥ずべき","はずべき"],["もの"],["を"],["誇り","ほこり"],["と"],["し"],["、"],["この世","このよ"],["の"],["こと"],["しか"],["考えて","かんがえて"],["いません"],["。"]]},{"verse":20,"text":"しかし、わたしたちの本国は天にあります。そこから主イエス‧キリストが救い主として来られるのを、わたしたちは待っています。","tok":[["しかし"],["、"],["わたしたち"],["の"],["本国","ほんごく"],["は"],["天","てん"],["に"],["あります"],["。"],["そこ"],["から"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["が"],["救い主","すくいぬし"],["として"],["来られる","こられる"],["の"],["を"],["、"],["わたしたち"],["は"],["待って","まって"],["います"],["。"]]},{"verse":21,"text":"キリストは、万物を支配下に置くことさえできる力によって、わたしたちの卑しい体を、御自分の栄光ある体と同じ形に変えてくださるのです。","tok":[["キリスト"],["は"],["、"],["万物","ばんぶつ"],["を"],["支配下","しはいか"],["に"],["置く","おく"],["こと"],["さえ"],["できる"],["力","ちから"],["によって"],["、"],["わたしたち"],["の"],["卑しい","いやしい"],["体","からだ"],["を"],["、"],["御自分","ごじぶん"],["の"],["栄光","えいこう"],["ある"],["体","からだ"],["と"],["同じ","おなじ"],["形","かたち"],["に"],["変えて","かえて"],["くださる"],["の"],["です"],["。"]]}]
[{"verse":1,"text":"だから、わたしが愛し、慕っている兄弟たち、わたしの喜びであり、冠である愛する人たち、このように主によってしっかりと立ちなさい。","tok":[["だ"],["から"],["、"],["わたし"],["が"],["愛し","あいし"],["、"],["慕って","したって"],["いる"],["兄弟","きょうだい"],["たち"],["、"],["わたし"],["の"],["喜び","よろこび"],["で"],["あり"],["、"],["冠","かんむり"],["で"],["ある"],["愛する","あいする"],["人","ひと"],["たち"],["、"],["この"],["よう"],["に"],["主に","おもに"],["よって"],["しっかり"],["と"],["立ち","たち"],["なさい"],["。"]]},{"verse":2,"text":"わたしはエボディアに勧め、またシンティケに勧めます。主において同じ思いを抱きなさい。","tok":[["わたし"],["は"],["エボディア"],["に"],["勧め","すすめ"],["、"],["また"],["シンティケ"],["に"],["勧めます","すすめます"],["。"],["主に","おもに"],["おいて"],["同じ","おなじ"],["思い","おもい"],["を"],["抱き","いだき"],["なさい"],["。"]]},{"verse":3,"text":"なお、真実の協力者よ、あなたにもお願いします。この二人の婦人を支えてあげてください。二人は、命の書に名を記されているクレメンスや他の協力者たちと力を合わせて、福音のためにわたしと共に戦ってくれたのです。","tok":[["なお"],["、"],["真実","しんじつ"],["の"],["協力者","きょうりょくしゃ"],["よ"],["、"],["あなた"],["に"],["も"],["お願い","おねがい"],["します"],["。"],["この"],["二人","ふたり"],["の"],["婦人","ふじん"],["を"],["支えて","ささえて"],["あげて"],["ください"],["。"],["二人","ふたり"],["は"],["、"],["命","いのち"],["の"],["書","しょ"],["に"],["名","な"],["を"],["記されて","しるされて"],["いる"],["クレメンス"],["や"],["他","ほか"],["の"],["協力者","きょうりょくしゃ"],["たち"],["と"],["力","ちから"],["を"],["合わせて","あわせて"],["、"],["福音","ふくいん"],["の"],["ため"],["に"],["わたし"],["と"],["共","とも"],["に"],["戦って","たたかって"],["くれた"],["の"],["です"],["。"]]},{"verse":4,"text":"主において常に喜びなさい。重ねて言います。喜びなさい。","tok":[["主に","おもに"],["おいて"],["常","つね"],["に"],["喜び","よろこび"],["なさい"],["。"],["重ねて","かさねて"],["言います","いいます"],["。"],["喜び","よろこび"],["なさい"],["。"]]},{"verse":5,"text":"あなたがたの広い心がすべての人に知られるようになさい。主はすぐ近くにおられます。","tok":[["あなた"],["がた"],["の"],["広い","ひろい"],["心","こころ"],["が"],["すべて"],["の"],["人","ひと"],["に"],["知られる","しられる"],["よう"],["に"],["なさい"],["。"],["主","ぬし"],["は"],["すぐ"],["近く","ちかく"],["に"],["おられます"],["。"]]},{"verse":6,"text":"どんなことでも、思い煩うのはやめなさい。何事につけ、感謝を込めて祈りと願いをささげ、求めているものを神に打ち明けなさい。","tok":[["どんな"],["こと"],["で"],["も"],["、"],["思い煩う","おもいわずらう"],["の"],["は"],["やめ"],["なさい"],["。"],["何事","なにごと"],["に"],["つけ"],["、"],["感謝","かんしゃ"],["を"],["込めて","こめて"],["祈り","いのり"],["と"],["願い","ねがい"],["を"],["ささげ"],["、"],["求めて","もとめて"],["いる"],["もの"],["を"],["神","かみ"],["に"],["打ち明け","うちあけ"],["なさい"],["。"]]},{"verse":7,"text":"そうすれば、あらゆる人知を超える神の平和が、あなたがたの心と考えとをキリスト‧イエスによって守るでしょう。","tok":[["そう"],["すれば"],["、"],["あらゆる"],["人知","じんち"],["を"],["超える","こえる"],["神","かみ"],["の"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["と"],["考え","かんがえ"],["と"],["を"],["キリスト"],["‧"],["イエス"],["によって"],["守るでしょう","まもるでしょう"],["。"]]},{"verse":8,"text":"終わりに、兄弟たち、すべて真実なこと、すべて気高いこと、すべて正しいこと、すべて清いこと、すべて愛すべきこと、すべて名誉なことを、また、徳や称賛に値することがあれば、それを心に留めなさい。","tok":[["終わり","おわり"],["に"],["、"],["兄弟","きょうだい"],["たち"],["、"],["すべて"],["真実","しんじつ"],["な"],["こと"],["、"],["すべて"],["気高い","けだかい"],["こと"],["、"],["すべて"],["正しい","ただしい"],["こと"],["、"],["すべて"],["清い","きよい"],["こと"],["、"],["すべて"],["愛すべき","あいすべき"],["こと"],["、"],["すべて"],["名誉","めいよ"],["な"],["こと"],["を"],["、"],["また"],["、"],["徳","とく"],["や"],["称賛","しょうさん"],["に"],["値","あたい"],["する"],["こと"],["が"],["あれば"],["、"],["それ"],["を"],["心","こころ"],["に"],["留め","とめ"],["なさい"],["。"]]},{"verse":9,"text":"わたしから学んだこと、受けたこと、わたしについて聞いたこと、見たことを実行しなさい。そうすれば、平和の神はあなたがたと共におられます。","tok":[["わたし"],["から"],["学んだ","まなんだ"],["こと"],["、"],["受けた","うけた"],["こと"],["、"],["わたし"],["について"],["聞いた","きいた"],["こと"],["、"],["見た","みた"],["こと"],["を"],["実行","じっこう"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["平和","へいわ"],["の"],["神","かみ"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["おられます"],["。"]]},{"verse":10,"text":"さて、あなたがたがわたしへの心遣いを、ついにまた表してくれたことを、わたしは主において非常に喜びました。今までは思いはあっても、それを表す機会がなかったのでしょう。","tok":[["さて"],["、"],["あなた"],["がた"],["が"],["わたし"],["へ"],["の"],["心遣い","こころづかい"],["を"],["、"],["ついに"],["また"],["表して","あらわして"],["くれた"],["こと"],["を"],["、"],["わたし"],["は"],["主に","おもに"],["おいて"],["非常","ひじょう"],["に"],["喜びました","よろこびました"],["。"],["今まで","いままで"],["は"],["思い","おもい"],["は"],["あって"],["も"],["、"],["それ"],["を"],["表す","あらわす"],["機会","きかい"],["が"],["なかった"],["の"],["でしょう"],["。"]]},{"verse":11,"text":"物欲しさにこう言っているのではありません。わたしは、自分の置かれた境遇に満足することを習い覚えたのです。","tok":[["物欲し","ものほし"],["さ"],["に"],["こう"],["言って","いって"],["いる"],["ので"],["は"],["ありません"],["。"],["わたし"],["は"],["、"],["自分","じぶん"],["の"],["置かれた","おかれた"],["境遇","きょうぐう"],["に"],["満足","まんぞく"],["する"],["こと"],["を"],["習い覚えた","ならいおぼえた"],["の"],["です"],["。"]]},{"verse":12,"text":"貧しく暮らすすべも、豊かに暮らすすべも知っています。満腹していても、空腹であっても、物が有り余っていても不足していても、いついかなる場合にも対処する秘訣を授かっています。","tok":[["貧しく","まずしく"],["暮らす","くらす"],["すべ"],["も"],["、"],["豊か","ゆたか"],["に"],["暮らす","くらす"],["すべ"],["も"],["知って","しって"],["います"],["。"],["満腹","まんぷく"],["して"],["いて"],["も"],["、"],["空腹","くうふく"],["で"],["あって"],["も"],["、"],["物","もの"],["が"],["有り余って","ありあまって"],["いて"],["も"],["不足","ふそく"],["して"],["いて"],["も"],["、"],["いつ"],["いかなる"],["場合","ばあい"],["に"],["も"],["対処","たいしょ"],["する"],["秘訣","ひけつ"],["を"],["授かって","さずかって"],["います"],["。"]]},{"verse":13,"text":"わたしを強めてくださる方のお陰で、わたしにはすべてが可能です。","tok":[["わたし"],["を"],["強めて","つよめて"],["くださる"],["方","かた"],["の"],["お陰","おかげ"],["で"],["、"],["わたし"],["に"],["は"],["すべて"],["が"],["可能","かのう"],["です"],["。"]]},{"verse":14,"text":"それにしても、あなたがたは、よくわたしと苦しみを共にしてくれました。","tok":[["それ"],["に"],["して"],["も"],["、"],["あなた"],["がた"],["は"],["、"],["よく"],["わたし"],["と"],["苦しみ","くるしみ"],["を"],["共","とも"],["に"],["して"],["くれました"],["。"]]},{"verse":15,"text":"フィリピの人たち、あなたがたも知っているとおり、わたしが福音の宣教の初めにマケドニア州を出たとき、もののやり取りでわたしの働きに参加した教会はあなたがたのほかに一つもありませんでした。","tok":[["フィリピ"],["の"],["人","ひと"],["たち"],["、"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["わたし"],["が"],["福音","ふくいん"],["の"],["宣教","せんきょう"],["の"],["初め","はじめ"],["に"],["マケドニア"],["州","しゅう"],["を"],["出た","でた"],["とき"],["、"],["もの"],["の"],["やり取り","やりとり"],["で"],["わたし"],["の"],["働き","はたらき"],["に"],["参加","さんか"],["した"],["教会","きょうかい"],["は"],["あなた"],["がた"],["の"],["ほか"],["に"],["一","ひと"],["つ"],["も"],["ありませんでした"],["。"]]},{"verse":16,"text":"また、テサロニケにいたときにも、あなたがたはわたしの窮乏を救おうとして、何度も物を送ってくれました。","tok":[["また"],["、"],["テサロニケ"],["に"],["いた"],["とき"],["に"],["も"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["窮乏","きゅうぼう"],["を"],["救おう","すくおう"],["として"],["、"],["何度","なんど"],["も"],["物","もの"],["を"],["送って","おくって"],["くれました"],["。"]]},{"verse":17,"text":"贈り物を当てにして言うわけではありません。むしろ、あなたがたの益となる豊かな実を望んでいるのです。","tok":[["贈り物","おくりもの"],["を"],["当て","あて"],["に"],["して"],["言う","いう"],["わけ"],["で"],["は"],["ありません"],["。"],["むしろ"],["、"],["あなた"],["がた"],["の"],["益","えき"],["と"],["なる"],["豊か","ゆたか"],["な"],["実","じつ"],["を"],["望んで","のぞんで"],["いる"],["の"],["です"],["。"]]},{"verse":18,"text":"わたしはあらゆるものを受けており、豊かになっています。そちらからの贈り物をエパフロディトから受け取って満ち足りています。それは香ばしい香りであり、神が喜んで受けてくださるいけにえです。","tok":[["わたし"],["は"],["あらゆる"],["もの"],["を"],["受けて","うけて"],["おり"],["、"],["豊か","ゆたか"],["に"],["なって"],["います"],["。"],["そちら"],["から"],["の"],["贈り物","おくりもの"],["を"],["エパフロディト"],["から"],["受け取って","うけとって"],["満ち足りて","みちたりて"],["います"],["。"],["それ"],["は"],["香ばしい","こうばしい"],["香り","かおり"],["で"],["あり"],["、"],["神","かみ"],["が"],["喜んで","よろこんで"],["受けて","うけて"],["くださる"],["いけにえ"],["です"],["。"]]},{"verse":19,"text":"わたしの神は、御自分の栄光の富に応じて、キリスト‧イエスによって、あなたがたに必要なものをすべて満たしてくださいます。","tok":[["わたし"],["の"],["神","かみ"],["は"],["、"],["御自分","ごじぶん"],["の"],["栄光","えいこう"],["の"],["富","とみ"],["に"],["応じて","おうじて"],["、"],["キリスト"],["‧"],["イエス"],["によって"],["、"],["あなた"],["がた"],["に"],["必要","ひつよう"],["な"],["もの"],["を"],["すべて"],["満たして","みたして"],["くださいます"],["。"]]},{"verse":20,"text":"わたしたちの父である神に、栄光が世々限りなくありますように、アーメン。","tok":[["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["に"],["、"],["栄光","えいこう"],["が"],["世々","せいせい"],["限りなく","かぎりなく"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]},{"verse":21,"text":"キリスト‧イエスに結ばれているすべての聖なる者たちに、よろしく伝えてください。わたしと一緒にいる兄弟たちも、あなたがたによろしくと言っています。","tok":[["キリスト"],["‧"],["イエス"],["に"],["結ばれて","むすばれて"],["いる"],["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["たち"],["に"],["、"],["よろしく"],["伝えて","つたえて"],["ください"],["。"],["わたし"],["と"],["一緒","いっしょ"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["も"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":22,"text":"すべての聖なる者たちから、特に皇帝の家の人たちからよろしくとのことです。","tok":[["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["たち"],["から"],["、"],["特に","とくに"],["皇帝","こうてい"],["の"],["家","いえ"],["の"],["人","ひと"],["たち"],["から"],["よろしく"],["と"],["の"],["こと"],["です"],["。"]]},{"verse":23,"text":"主イエス‧キリストの恵みが、あなたがたの霊と共にあるように。","tok":[["主","しゅ"],["イエス"],["‧"],["キリスト"],["の"],["恵み","めぐみ"],["が"],
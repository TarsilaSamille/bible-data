,["現れ","あらわれ"],["、"]]},{"verse":8,"text":"へりくだって、死に至るまで、それも十字架の死に至るまで従順でした。","tok":[["へりくだって"],["、"],["死","し"],["に"],["至る","いたる"],["まで"],["、"],["それ"],["も"],["十字架","じゅうじか"],["の"],["死","し"],["に"],["至る","いたる"],["まで"],["従順","じゅうじゅん"],["でした"],["。"]]},{"verse":9,"text":"このため、神はキリストを高く上げ、あらゆる名にまさる名をお与えになりました。","tok":[["この"],["ため"],["、"],["神","かみ"],["は"],["キリスト"],["を"],["高く","たかく"],["上げ","あげ"],["、"],["あらゆる"],["名","な"],["に"],["まさる"],["名","な"],["を"],["お与え","おあたえ"],["に"],["なりました"],["。"]]},{"verse":10,"text":"こうして、天上のもの、地上のもの、地下のものがすべて、イエスの御名にひざまずき、","tok":[["こう"],["して"],["、"],["天上","てんじょう"],["の"],["もの"],["、"],["地上","ちじょう"],["の"],["もの"],["、"],["地下","ちか"],["の"],["もの"],["が"],["すべて"],["、"],["イエス"],["の"],["御名","ぎょめい"],["に"],["ひざまずき"],["、"]]},{"verse":11,"text":"すべての舌が、「イエス‧キリストは主である」と公に宣べて、父である神をたたえるのです。","tok":[["すべて"],["の"],["舌","した"],["が"],["、"],["「"],["イエス"],["‧"],["キリスト"],["は"],["主","ぬし"],["で"],["ある"],["」"],["と"],["公","おおやけ"],["に"],["宣べて","のべて"],["、"],["父","ちち"],["で"],["ある"],["神","かみ"],["を"],["たたえる"],["の"],["です"],["。"]]},{"verse":12,"text":"だから、わたしの愛する人たち、いつも従順であったように、わたしが共にいるときだけでなく、いない今はなおさら従順でいて、恐れおののきつつ自分の救いを達成するように努めなさい。","tok":[["だ"],["から"],["、"],["わたし"],["の"],["愛する","あいする"],["人","ひと"],["たち"],["、"],["いつも"],["従順","じゅうじゅん"],["で"],["あった"],["よう"],["に"],["、"],["わたし"],["が"],["共","とも"],["に"],["いる"],["とき"],["だけ"],["で"],["なく"],["、"],["いない"],["今","いま"],["は"],["なおさら"],["従順","じゅうじゅん"],["で"],["いて"],["、"],["恐れおののき","おそれおののき"],["つつ"],["自分","じぶん"],["の"],["救い","すくい"],["を"],["達成","たっせい"],["する"],["よう"],["に"],["努め","つとめ"],["なさい"],["。"]]},{"verse":13,"text":"あなたがたの内に働いて、御心のままに望ませ、行わせておられるのは神であるからです。","tok":[["あなた"],["がた"],["の"],["内","うち"],["に"],["働いて","はたらいて"],["、"],["御心","おこころ"],["の"],["まま"],["に"],["望ませ","のぞませ"],["、"],["行わせて","おこなわせて"],["おられる"],["の"],["は"],["神","かみ"],["で"],["ある"],["から"],["です"],["。"]]},{"verse":14,"text":"何事も、不平や理屈を言わずに行いなさい。","tok":[["何事","なにごと"],["も"],["、"],["不平","ふへい"],["や"],["理屈","りくつ"],["を"],["言わず","いわず"],["に"],["行い","おこない"],["なさい"],["。"]]},{"verse":15,"text":"そうすれば、とがめられるところのない清い者となり、よこしまな曲がった時代の中で、非のうちどころのない神の子として、世にあって星のように輝き、","tok":[["そう"],["すれば"],["、"],["とがめられる"],["ところ"],["の"],["ない"],["清い","きよい"],["者","もの"],["と"],["なり"],["、"],["よこしま"],["な"],["曲がった","まがった"],["時代","じだい"],["の"],["中","なか"],["で"],["、"],["非","ひ"],["の"],["うち"],["どころ"],["の"],["ない"],["神","かみ"],["の"],["子","こ"],["として"],["、"],["世","よ"],["に"],["あって"],["星","ほし"],["の"],["よう"],["に"],["輝き","かがやき"],["、"]]},{"verse":16,"text":"命の言葉をしっかり保つでしょう。こうしてわたしは、自分が走ったことが無駄でなく、労苦したことも無駄ではなかったと、キリストの日に誇ることができるでしょう。","tok":[["命","いのち"],["の"],["言葉","ことば"],["を"],["しっかり"],["保つでしょう","たもつでしょう"],["。"],["こう"],["して"],["わたし"],["は"],["、"],["自分","じぶん"],["が"],["走った","はしった"],["こと"],["が"],["無駄","むだ"],["で"],["なく"],["、"],["労苦","ろうく"],["した"],["こと"],["も"],["無駄","むだ"],["で"],["は"],["なかった"],["と"],["、"],["キリスト"],["の"],["日","ひ"],["に"],["誇る","ほこる"],["こと"],["が"],["できるでしょう"],["。"]]},{"verse":17,"text":"更に、信仰に基づいてあなたがたがいけにえを献げ、礼拝を行う際に、たとえわたしの血が注がれるとしても、わたしは喜びます。あなたがた一同と共に喜びます。","tok":[["更に","さらに"],["、"],["信仰","しんこう"],["に"],["基づいて","もとづいて"],["あなた"],["がた"],["が"],["いけにえ"],["を"],["献げ","ささげ"],["、"],["礼拝","れいはい"],["を"],["行う","おこなう"],["際","さい"],["に"],["、"],["たとえ"],["わたし"],["の"],["血","ち"],["が"],["注がれる","そそがれる"],["として"],["も"],["、"],["わたし"],["は"],["喜びます","よろこびます"],["。"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["喜びます","よろこびます"],["。"]]},{"verse":18,"text":"同様に、あなたがたも喜びなさい。わたしと一緒に喜びなさい。","tok":[["同様","どうよう"],["に"],["、"],["あなた"],["がた"],["も"],["喜び","よろこび"],["なさい"],["。"],["わたし"],["と"],["一緒","いっしょ"],["に"],["喜び","よろこび"],["なさい"],["。"]]},{"verse":19,"text":"さて、わたしはあなたがたの様子を知って力づけられたいので、間もなくテモテをそちらに遣わすことを、主イエスによって希望しています。","tok":[["さて"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["様子","ようす"],["を"],["知って","しって"],["力づけられたい","ちからづけられたい"],["ので"],["、"],["間","ま"],["も"],["なく"],["テモテ"],["を"],["そちら"],["に"],["遣わす","つかわす"],["こと"],["を"],["、"],["主","しゅ"],["イエス"],["によって"],["希望","きぼう"],["して"],["います"],["。"]]},{"verse":20,"text":"テモテのようにわたしと同じ思いを抱いて、親身になってあなたがたのことを心にかけている者はほかにいないのです。","tok":[["テモテ"],["の"],["よう"],["に"],["わたし"],["と"],["同じ","おなじ"],["思い","おもい"],["を"],["抱いて","いだいて"],["、"],["親身","しんみ"],["に"],["なって"],["あなた"],["がた"],["の"],["こと"],["を"],["心","こころ"],["に"],["かけて"],["いる"],["者","もの"],["は"],["ほか"],["に"],["いない"],["の"],["です"],["。"]]},{"verse":21,"text":"他の人は皆、イエス‧キリストのことではなく、自分のことを追い求めています。","tok":[["他","ほか"],["の"],["人","ひと"],["は"],["皆","みな"],["、"],["イエス"],["‧"],["キリスト"],["の"],["こと"],["で"],["は"],["なく"],["、"],["自分","じぶん"],["の"],["こと"],["を"],["追い求めて","おいもとめて"],["います"],["。"]]},{"verse":22,"text":"テモテが確かな人物であることはあなたがたが認めるところであり、息子が父に仕えるように、彼はわたしと共に福音に仕えました。","tok":[["テモテ"],["が"],["確か","たしか"],["な"],["人物","じんぶつ"],["で"],["ある"],["こと"],["は"],["あなた"],["がた"],["が"],["認める","みとめる"],["ところ"],["で"],["あり"],["、"],["息子","むすこ"],["が"],["父","ちち"],["に"],["仕える","つかえる"],["よう"],["に"],["、"],["彼","かれ"],["は"],["わたし"],["と"],["共","とも"],["に"],["福音","ふくいん"],["に"],["仕えました","つかえました"],["。"]]},{"verse":23,"text":"そこで、わたしは自分のことの見通しがつきしだいすぐ、テモテを送りたいと願っています。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["こと"],["の"],["見通し","みとおし"],["が"],["つき"],["しだい"],["すぐ"],["、"],["テモテ"],["を"],["送りたい","おくりたい"],["と"],["願って","ねがって"],["います"],["。"]]},{"verse":24,"text":"わたし自身も間もなくそちらに行けるものと、主によって確信しています。","tok":[["わたし"],["自身","じしん"],["も"],["間","ま"],["も"],["なく"],["そちら"],["に"],["行ける","いける"],["もの"],["と"],["、"],["主に","おもに"],["よって"],["確信","かくしん"],["して"],["います"],["。"]]},{"verse":25,"text":"ところでわたしは、エパフロディトをそちらに帰さねばならないと考えています。彼はわたしの兄弟、協力者、戦友であり、また、あなたがたの使者として、わたしの窮乏のとき奉仕者となってくれましたが、","tok":[["ところ"],["で"],["わたし"],["は"],["、"],["エパフロディト"],["を"],["そちら"],["に"],["帰さねば","かえさねば"],["ならない"],["と"],["考えて","かんがえて"],["います"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["兄弟","きょうだい"],["、"],["協力者","きょうりょくしゃ"],["、"],["戦友","せんゆう"],["で"],["あり"],["、"],["また"],["、"],["あなた"],["がた"],["の"],["使者","ししゃ"],["として"],["、"],["わたし"],["の"],["窮乏","きゅうぼう"],["の"],["とき"],["奉仕者","ほうししゃ"],["と"],["なって"],["くれました"],["が"],["、"]]},{"verse":26,"text":"しきりにあなたがた一同と会いたがっており、自分の病気があなたがたに知られたことを心苦しく思っているからです。","tok":[["しきり"],["に"],["あなた"],["がた"],["一同","いちどう"],["と"],["会いたがって","あいたがって"],["おり"],["、"],["自分","じぶん"],["の
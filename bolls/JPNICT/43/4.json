[{"verse":1,"text":"さて、イエスがヨハネよりも多くの弟子をつくり、洗礼を授けておられるということが、ファリサイ派の人々の耳に入った。イエスはそれを知ると、","tok":[["さて"],["、"],["イエス"],["が"],["ヨハネ"],["より"],["も"],["多く","おおく"],["の"],["弟子","でし"],["を"],["つくり"],["、"],["洗礼","せんれい"],["を"],["授けて","さずけて"],["おられる"],["と"],["いう"],["こと"],["が"],["、"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["の"],["耳","みみ"],["に"],["入った","はいった"],["。"],["イエス"],["は"],["それ"],["を"],["知る","しる"],["と"],["、"]]},{"verse":2,"text":"――洗礼を授けていたのは、イエス御自身ではなく、弟子たちである――","tok":[["―"],["―"],["洗礼","せんれい"],["を"],["授けて","さずけて"],["いた"],["の"],["は"],["、"],["イエス"],["御自身","ごじしん"],["で"],["は"],["なく"],["、"],["弟子","でし"],["たち"],["で"],["ある"],["―"],["―"]]},{"verse":3,"text":"ユダヤを去り、再びガリラヤへ行かれた。","tok":[["ユダヤ"],["を"],["去り","さり"],["、"],["再び","ふたたび"],["ガリラヤ"],["へ"],["行かれた","いかれた"],["。"]]},{"verse":4,"text":"しかし、サマリアを通らねばならなかった。","tok":[["しかし"],["、"],["サマリア"],["を"],["通らねば","とおらねば"],["ならなかった"],["。"]]},{"verse":5,"text":"それで、ヤコブがその子ヨセフに与えた土地の近くにある、シカルというサマリアの町に来られた。","tok":[["それ"],["で"],["、"],["ヤコブ"],["が"],["その"],["子","こ"],["ヨセフ"],["に"],["与えた","あたえた"],["土地","とち"],["の"],["近く","ちかく"],["に"],["ある"],["、"],["シカル"],["と"],["いう"],["サマリア"],["の"],["町","まち"],["に"],["来られた","こられた"],["。"]]},{"verse":6,"text":"そこにはヤコブの井戸があった。イエスは旅に疲れて、そのまま井戸のそばに座っておられた。正午ごろのことである。","tok":[["そこ"],["に"],["は"],["ヤコブ"],["の"],["井戸","いど"],["が"],["あった"],["。"],["イエス"],["は"],["旅","たび"],["に"],["疲れて","つかれて"],["、"],["そのまま"],["井戸","いど"],["の"],["そば"],["に"],["座って","すわって"],["おられた"],["。"],["正午","しょうご"],["ごろ"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":7,"text":"サマリアの女が水をくみに来た。イエスは、「水を飲ませてください」と言われた。","tok":[["サマリア"],["の"],["女","おんな"],["が"],["水","みず"],["を"],["くみ"],["に"],["来た","きた"],["。"],["イエス"],["は"],["、"],["「"],["水","みず"],["を"],["飲ませて","のませて"],["ください"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"弟子たちは食べ物を買うために町に行っていた。","tok":[["弟子","でし"],["たち"],["は"],["食べ物","たべもの"],["を"],["買う","かう"],["ため"],["に"],["町","まち"],["に"],["行って","いって"],["いた"],["。"]]},{"verse":9,"text":"すると、サマリアの女は、「ユダヤ人のあなたがサマリアの女のわたしに、どうして水を飲ませてほしいと頼むのですか」と言った。ユダヤ人はサマリア人とは交際しないからである。","tok":[["する"],["と"],["、"],["サマリア"],["の"],["女","おんな"],["は"],["、"],["「"],["ユダヤ人","ゆだやじん"],["の"],["あなた"],["が"],["サマリア"],["の"],["女","おんな"],["の"],["わたし"],["に"],["、"],["どう"],["して"],["水","みず"],["を"],["飲ませて","のませて"],["ほしい"],["と"],["頼む","たのむ"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"],["ユダヤ人","ゆだやじん"],["は"],["サマリア"],["人","にん"],["と"],["は"],["交際","こうさい"],["しない"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"イエスは答えて言われた。「もしあなたが、神の賜物を知っており、また、『水を飲ませてください』と言ったのがだれであるか知っていたならば、あなたの方からその人に頼み、その人はあなたに生きた水を与えたことであろう。」","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["もし"],["あなた"],["が"],["、"],["神","かみ"],["の"],["賜物","たまもの"],["を"],["知って","しって"],["おり"],["、"],["また"],["、"],["『"],["水","みず"],["を"],["飲ませて","のませて"],["ください"],["』"],["と"],["言った","いった"],["の"],["が"],["だれ"],["で"],["ある"],["か"],["知って","しって"],["いたならば"],["、"],["あなた"],["の"],["方","ほう"],["から"],["その"],["人","ひと"],["に"],["頼み","たのみ"],["、"],["その"],["人","ひと"],["は"],["あなた"],["に"],["生きた","いきた"],["水","みず"],["を"],["与えた","あたえた"],["こと"],["で"],["あろう"],["。"],["」"]]},{"verse":11,"text":"女は言った。「主よ、あなたはくむ物をお持ちでないし、井戸は深いのです。どこからその生きた水を手にお入れになるのですか。","tok":[["女","おんな"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["くむ"],["物","もの"],["を"],["お持ちでない","おもちでない"],["し"],["、"],["井戸","いど"],["は"],["深い","ふかい"],["の"],["です"],["。"],["どこ"],["から"],["その"],["生きた","いきた"],["水","みず"],["を"],["手","て"],["に"],["お入れ","おいれ"],["に"],["なる"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"あなたは、わたしたちの父ヤコブよりも偉いのですか。ヤコブがこの井戸をわたしたちに与え、彼自身も、その子供や家畜も、この井戸から水を飲んだのです。」","tok":[["あなた"],["は"],["、"],["わたしたち"],["の"],["父","ちち"],["ヤコブ"],["より"],["も"],["偉い","えらい"],["の"],["です"],["か"],["。"],["ヤコブ"],["が"],["この"],["井戸","いど"],["を"],["わたしたち"],["に"],["与え","あたえ"],["、"],["彼","かれ"],["自身","じしん"],["も"],["、"],["その"],["子供","こども"],["や"],["家畜","かちく"],["も"],["、"],["この"],["井戸","いど"],["から"],["水","みず"],["を"],["飲んだ","のんだ"],["の"],["です"],["。"],["」"]]},{"verse":13,"text":"イエスは答えて言われた。「この水を飲む者はだれでもまた渇く。","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["この"],["水","みず"],["を"],["飲む","のむ"],["者","もの"],["は"],["だれ"],["で"],["も"],["また"],["渇く","かわく"],["。"]]},{"verse":14,"text":"しかし、わたしが与える水を飲む者は決して渇かない。わたしが与える水はその人の内で泉となり、永遠の命に至る水がわき出る。」","tok":[["しかし"],["、"],["わたし"],["が"],["与える","あたえる"],["水","みず"],["を"],["飲む","のむ"],["者","もの"],["は"],["決して","けっして"],["渇かない","かわかない"],["。"],["わたし"],["が"],["与える","あたえる"],["水","みず"],["は"],["その"],["人","ひと"],["の"],["内","うち"],["で"],["泉","いずみ"],["と"],["なり"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["に"],["至る","いたる"],["水","みず"],["が"],["わき出る","わきでる"],["。"],["」"]]},{"verse":15,"text":"女は言った。「主よ、渇くことがないように、また、ここにくみに来なくてもいいように、その水をください。」","tok":[["女","おんな"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["渇く","かわく"],["こと"],["が"],["ない"],["よう"],["に"],["、"],["また"],["、"],["ここ"],["に"],["くみ"],["に"],["来なくて","こなくて"],["も"],["いい"],["よう"],["に"],["、"],["その"],["水","みず"],["を"],["ください"],["。"],["」"]]},{"verse":16,"text":"イエスが、「行って、あなたの夫をここに呼んで来なさい」と言われると、","tok":[["イエス"],["が"],["、"],["「"],["行って","いって"],["、"],["あなた"],["の"],["夫","おっと"],["を"],["ここ"],["に"],["呼んで","よんで"],["来","き"],["なさい"],["」"],["と"],["言われる","いわれる"],["と"],["、"]]},{"verse":17,"text":"女は答えて、「わたしには夫はいません」と言った。イエスは言われた。「『夫はいません』とは、まさにそのとおりだ。","tok":[["女","おんな"],["は"],["答えて","こたえて"],["、"],["「"],["わたし"],["に"],["は"],["夫","おっと"],["は"],["いません"],["」"],["と"],["言った","いった"],["。"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["『"],["夫","おっと"],["は"],["いません"],["』"],["と"],["は"],["、"],["まさに"],["その"],["とおり"],["だ"],["。"]]},{"verse":18,"text":"あなたには五人の夫がいたが、今連れ添っているのは夫ではない。あなたは、ありのままを言ったわけだ。」","tok":[["あなた"],["に"],["は"],["五人","ごにん"],["の"],["夫","おっと"],["が"],["いた"],["が"],["、"],["今","いま"],["連れ添って","つれそって"],["いる"],["の"],["は"],["夫","おっと"],["で"],["は"],["ない"],["。"],["あなた"],["は"],["、"],["ありのまま"],["を"],["言った","いった"],["わけ"],["だ"],["。"],["」"]]},{"verse":19,"text":"女は言った。「主よ、あなたは預言者だとお見受けします。","tok":[["女","おんな"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["預言者","よげんしゃ"],["だ"],["と"],["お見受け","おみうけ"],["します"],["。"]]},{"verse":20,"text":"わたしどもの先祖はこの山で礼拝しましたが、あなたがたは、礼拝すべき場所はエルサレムにあると言っています。」","tok":[["わたし"],["ども"],["の"],["先祖","せんぞ"],["は"],["この"],["山","やま"],["で"],["礼拝","れいはい"],["しました"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["礼拝","れいはい"],["すべき"],["場所","ばしょ"],["は"],["エルサレム"],["に"],["ある"],["と"],["言って","いって"],["います"],["。"],["」"]]},{"verse":21,"text":"イエスは言われた。「婦人よ、わたしを信じなさい。あなたがたが、この山でもエルサレムでもない所で、父を礼拝する時が来る。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["婦人","ふじん"],["よ"],["、"],["わたし"],["を"],["信じ","しんじ"],["なさい"],["。"],["あなた"],["が"],["た"],["が"],["、"],["この"],["山","やま"],["で"],["も"],["エルサレム"],["で"],["も"],["ない"],["所","ところ"],["で"],["、"],["父","ちち"],["を"],["礼拝","れいはい"],["する"],["時","とき"],["が"],["来る","くる"],["。"]]},{"verse":22,"text":"あなたがたは知らないものを礼拝しているが、わたしたちは知っているものを礼拝している。救いはユダヤ人から来るからだ。","tok":[["あなた"],["がた"],["は"],["知らない","しらない"],["もの"],["を"],["礼拝","れいはい"],["して"],["いる"],["が"],["、"],["わたしたち"],["は"],["知って","しって"],["いる"],["もの"],["を"],["礼拝","れいはい"],["して"],["いる"],["。"],["救い","すくい"],["は"],["ユダヤ人","ゆだやじん"],["から"],["来る","くる"],["から"],["だ"],["。"]]},{"verse":23,"text":"しかし、まことの礼拝をする者たちが、霊と真理をもって父を礼拝する時が来る。今がその時である。なぜなら、父はこのように礼拝する者を求めておられるからだ。","tok":[["しかし"],["、"],["まこと"],["の"],["礼拝","れいはい"],["を"],["する"],["者","もの"],["たち"],["が"],["、"],["霊","れい"],["と"],["真理","しんり"],["を"],["もって"],["父","ちち"],["を"],["礼拝","れいはい"],["する"],["時","とき"],["が"],["来る","くる"],["。"],["今","いま"],["が"],["その"],["時","とき"],["で"],["ある"],["。"],["なぜ"],["なら"],["、"],["父","ちち"],["は"],["この"],["よう"],["に"],["礼拝","れいはい"],["する"],["者","もの"],["を"],["求めて","もとめて"],["おられる"],["から"],["だ"],["。"]]},{"verse":24,"text":"神は霊である。だから、神を礼拝する者は、霊と真理をもって礼拝しなければならない。」","tok":[["神","かみ"],["は"],["霊","れい"],["で"],["ある"],["。"],["だ"],["から"],["、"],["神","かみ"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["は"],["、"],["霊","れい"],["と"],["真理","しんり"],["を"],["もって"],["礼拝","れいはい"],["しなければ"],["ならない"],["。"],["」"]]},{"verse":25,"text":"女が言った。「わたしは、キリストと呼ばれるメシアが来られることは知っています。その方が来られるとき、わたしたちに一切のことを知らせてくださいます。」","tok":[["女","おんな"],["が"],["言った","いった"],["。"],["「"],["わたし"],["は"],["、"],["キリスト"],["と"],["呼ばれる","よばれる"],["メシア"],["が"],["来られる","こられる"],["こと"
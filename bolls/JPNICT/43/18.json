[{"verse":1,"text":"こう話し終えると、イエスは弟子たちと一緒に、キドロンの谷の向こうへ出て行かれた。そこには園があり、イエスは弟子たちとその中に入られた。","tok":[["こう"],["話し","はなし"],["終える","おえる"],["と"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["、"],["キドロン"],["の"],["谷","たに"],["の"],["向こう","むこう"],["へ"],["出て","でて"],["行かれた","いかれた"],["。"],["そこ"],["に"],["は"],["園","その"],["が"],["あり"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["その"],["中","なか"],["に"],["入られた","はいられた"],["。"]]},{"verse":2,"text":"イエスを裏切ろうとしていたユダも、その場所を知っていた。イエスは、弟子たちと共に度々ここに集まっておられたからである。","tok":[["イエス"],["を"],["裏切ろう","うらぎろう"],["として"],["いた"],["ユダ"],["も"],["、"],["その"],["場所","ばしょ"],["を"],["知って","しって"],["いた"],["。"],["イエス"],["は"],["、"],["弟子","でし"],["たち"],["と"],["共","とも"],["に"],["度々","たびたび"],["ここ"],["に"],["集まって","あつまって"],["おられた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"それでユダは、一隊の兵士と、祭司長たちやファリサイ派の人々の遣わした下役たちを引き連れて、そこにやって来た。松明やともし火や武器を手にしていた。","tok":[["それ"],["で"],["ユダ"],["は"],["、"],["一隊","いったい"],["の"],["兵士","へいし"],["と"],["、"],["祭司長","さいしちょう"],["たち"],["や"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["の"],["遣わした","つかわした"],["下役","したやく"],["たち"],["を"],["引き連れて","ひきつれて"],["、"],["そこ"],["に"],["やって"],["来た","きた"],["。"],["松明","たいまつ"],["や"],["ともし火","ともしび"],["や"],["武器","ぶき"],["を"],["手","て"],["に"],["して"],["いた"],["。"]]},{"verse":4,"text":"イエスは御自分の身に起こることを何もかも知っておられ、進み出て、「だれを捜しているのか」と言われた。","tok":[["イエス"],["は"],["御自分","ごじぶん"],["の"],["身","み"],["に"],["起こる","おこる"],["こと"],["を"],["何","なん"],["も"],["か"],["も"],["知って","しって"],["おられ"],["、"],["進み出て","すすみでて"],["、"],["「"],["だれ"],["を"],["捜して","さがして"],["いる"],["の"],["か"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":5,"text":"彼らが「ナザレのイエスだ」と答えると、イエスは「わたしである」と言われた。イエスを裏切ろうとしていたユダも彼らと一緒にいた。","tok":[["彼","かれ"],["ら"],["が"],["「"],["ナザレ"],["の"],["イエス"],["だ"],["」"],["と"],["答える","こたえる"],["と"],["、"],["イエス"],["は"],["「"],["わたし"],["で"],["ある"],["」"],["と"],["言われた","いわれた"],["。"],["イエス"],["を"],["裏切ろう","うらぎろう"],["として"],["いた"],["ユダ"],["も"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["いた"],["。"]]},{"verse":6,"text":"イエスが「わたしである」と言われたとき、彼らは後ずさりして、地に倒れた。","tok":[["イエス"],["が"],["「"],["わたし"],["で"],["ある"],["」"],["と"],["言われた","いわれた"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["後ずさり","あとずさり"],["して"],["、"],["地","ち"],["に"],["倒れた","たおれた"],["。"]]},{"verse":7,"text":"そこで、イエスが「だれを捜しているのか」と重ねてお尋ねになると、彼らは「ナザレのイエスだ」と言った。","tok":[["そこ"],["で"],["、"],["イエス"],["が"],["「"],["だれ"],["を"],["捜して","さがして"],["いる"],["の"],["か"],["」"],["と"],["重ねて","かさねて"],["お尋ね","おたずね"],["に"],["なる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["「"],["ナザレ"],["の"],["イエス"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"すると、イエスは言われた。「『わたしである』と言ったではないか。わたしを捜しているのなら、この人々は去らせなさい。」","tok":[["する"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["『"],["わたし"],["で"],["ある"],["』"],["と"],["言ったで","いったで"],["は"],["ない"],["か"],["。"],["わたし"],["を"],["捜して","さがして"],["いる"],["の"],["なら"],["、"],["この"],["人々","ひとびと"],["は"],["去らせ","さらせ"],["なさい"],["。"],["」"]]},{"verse":9,"text":"それは、「あなたが与えてくださった人を、わたしは一人も失いませんでした」と言われたイエスの言葉が実現するためであった。","tok":[["それ"],["は"],["、"],["「"],["あなた"],["が"],["与えて","あたえて"],["くださった"],["人","ひと"],["を"],["、"],["わたし"],["は"],["一人","ひとり"],["も"],["失いませんでした","うしないませんでした"],["」"],["と"],["言われた","いわれた"],["イエス"],["の"],["言葉","ことば"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":10,"text":"シモン‧ペトロは剣を持っていたので、それを抜いて大祭司の手下に打ってかかり、その右の耳を切り落とした。手下の名はマルコスであった。","tok":[["シモン"],["‧"],["ペトロ"],["は"],["剣","けん"],["を"],["持って","もって"],["いた"],["ので"],["、"],["それ"],["を"],["抜いて","ぬいて"],["大","だい"],["祭司","さいし"],["の"],["手下","てした"],["に"],["打って","うって"],["かかり"],["、"],["その"],["右","みぎ"],["の"],["耳","みみ"],["を"],["切り落とした","きりおとした"],["。"],["手下","てした"],["の"],["名","な"],["は"],["マルコス"],["で"],["あった"],["。"]]},{"verse":11,"text":"イエスはペトロに言われた。「剣をさやに納めなさい。父がお与えになった杯は、飲むべきではないか。」","tok":[["イエス"],["は"],["ペトロ"],["に"],["言われた","いわれた"],["。"],["「"],["剣","けん"],["を"],["さや"],["に"],["納め","おさめ"],["なさい"],["。"],["父","ちち"],["が"],["お与え","おあたえ"],["に"],["なった"],["杯","さかずき"],["は"],["、"],["飲むべきで","のむべきで"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":12,"text":"そこで一隊の兵士と千人隊長、およびユダヤ人の下役たちは、イエスを捕らえて縛り、","tok":[["そこ"],["で"],["一隊","いったい"],["の"],["兵士","へいし"],["と"],["千人","せんにん"],["隊長","たいちょう"],["、"],["および"],["ユダヤ人","ゆだやじん"],["の"],["下役","したやく"],["たち"],["は"],["、"],["イエス"],["を"],["捕らえて","とらえて"],["縛り","しばり"],["、"]]},{"verse":13,"text":"まず、アンナスのところへ連れて行った。彼が、その年の大祭司カイアファのしゅうとだったからである。","tok":[["まず"],["、"],["アンナス"],["の"],["ところ"],["へ"],["連れて","つれて"],["行った","いった"],["。"],["彼","かれ"],["が"],["、"],["その"],["年","とし"],["の"],["大","だい"],["祭司","さいし"],["カイアファ"],["の"],["しゅうと"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"一人の人間が民の代わりに死ぬ方が好都合だと、ユダヤ人たちに助言したのは、このカイアファであった。","tok":[["一人","ひとり"],["の"],["人間","にんげん"],["が"],["民","たみ"],["の"],["代わり","かわり"],["に"],["死ぬ","しぬ"],["方","かた"],["が"],["好都合","こうつごう"],["だ"],["と"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["助言","じょげん"],["した"],["の"],["は"],["、"],["この"],["カイアファ"],["で"],["あった"],["。"]]},{"verse":15,"text":"シモン‧ペトロともう一人の弟子は、イエスに従った。この弟子は大祭司の知り合いだったので、イエスと一緒に大祭司の屋敷の中庭に入ったが、","tok":[["シモン"],["‧"],["ペトロ"],["と"],["もう"],["一人","ひとり"],["の"],["弟子","でし"],["は"],["、"],["イエス"],["に"],["従った","したがった"],["。"],["この"],["弟子","でし"],["は"],["大","だい"],["祭司","さいし"],["の"],["知り合い","しりあい"],["だった"],["ので"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["大","だい"],["祭司","さいし"],["の"],["屋敷","やしき"],["の"],["中庭","なかにわ"],["に"],["入った","はいった"],["が"],["、"]]},{"verse":16,"text":"ペトロは門の外に立っていた。大祭司の知り合いである、そのもう一人の弟子は、出て来て門番の女に話し、ペトロを中に入れた。","tok":[["ペトロ"],["は"],["門","もん"],["の"],["外","そと"],["に"],["立って","たって"],["いた"],["。"],["大","だい"],["祭司","さいし"],["の"],["知り合い","しりあい"],["で"],["ある"],["、"],["その"],["もう"],["一人","ひとり"],["の"],["弟子","でし"],["は"],["、"],["出て","でて"],["来て","きて"],["門番","もんばん"],["の"],["女","おんな"],["に"],["話し","はなし"],["、"],["ペトロ"],["を"],["中","なか"],["に"],["入れた","いれた"],["。"]]},{"verse":17,"text":"門番の女中はペトロに言った。「あなたも、あの人の弟子の一人ではありませんか。」ペトロは、「違う」と言った。","tok":[["門番","もんばん"],["の"],["女中","じょちゅう"],["は"],["ペトロ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["も"],["、"],["あの"],["人","ひと"],["の"],["弟子","でし"],["の"],["一人","ひとり"],["で"],["は"],["ありません"],["か"],["。"],["」"],["ペトロ"],["は"],["、"],["「"],["違う","ちがう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"僕や下役たちは、寒かったので炭火をおこし、そこに立って火にあたっていた。ペトロも彼らと一緒に立って、火にあたっていた。","tok":[["僕","ぼく"],["や"],["下役","したやく"],["たち"],["は"],["、"],["寒かった","さむかった"],["ので"],["炭火","すみび"],["を"],["おこし"],["、"],["そこ"],["に"],["立って","たって"],["火","ひ"],["に"],["あたって"],["いた"],["。"],["ペトロ"],["も"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["立って","たって"],["、"],["火","ひ"],["に"],["あたって"],["いた"],["。"]]},{"verse":19,"text":"大祭司はイエスに弟子のことや教えについて尋ねた。","tok":[["大","だい"],["祭司","さいし"],["は"],["イエス"],["に"],["弟子","でし"],["の"],["こと"],["や"],["教え","おしえ"],["について"],["尋ねた","たずねた"],["。"]]},{"verse":20,"text":"イエスは答えられた。「わたしは、世に向かって公然と話した。わたしはいつも、ユダヤ人が皆集まる会堂や神殿の境内で教えた。ひそかに話したことは何もない。","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["わたし"],["は"],["、"],["世","よ"],["に"],["向かって","むかって"],["公然","こうぜん"],["と"],["話した","はなした"],["。"],["わたし"],["は"],["いつも"],["、"],["ユダヤ人","ゆだやじん"],["が"],["皆","みな"],["集まる","あつまる"],["会堂","かいどう"],["や"],["神殿","しんでん"],["の"],["境内","けいだい"],["で"],["教えた","おしえた"],["。"],["ひそか"],["に"],["話した","はなした"],["こと"],["は"],["何","なん"],["も"],["ない"],["。"]]},{"verse":21,"text":"なぜ、わたしを尋問するのか。わたしが何を話したかは、それを聞いた人々に尋ねるがよい。その人々がわたしの話したことを知っている。」","tok":[["なぜ"],["、"],["わたし"],["を"],["尋問","じんもん"],["する"],["の"],["か"],["。"],["わたし"],["が"],["何","なん"],["を"],["話した","はなした"],["か"],["は"],["、"],["それ"],["を"],["聞いた","きいた"],["人々","ひとびと"],["に"],["尋ねる","たずねる"],["が"],["よい"],["。"],["その"],["人々","ひとびと"],["が"],["わたし"],["の"],["話した","はなした"],["こと"],["を"],["知って","しって"],["いる"],["。"],["」"]]},{"verse":22,"text":"イエスがこう言われると、そばにいた下役の一人が、「大祭司に向かって、そんな返事のしかたがあるか」と言って、イエスを平手で打った。","tok":[["イエス"],["が"],["こう"],["言われる","いわれる"],["と"],["、"],["そば"],["に"],["いた"],["下役","したやく"],["の"],["一人","ひとり"],["が"],["、"],["「"],["大","だい"],["祭司","さいし"],["に"],["向かって","むかって"],["、"],["そんな"],["返事","へんじ"],["の"],["しかた"],["が"],["ある"],["か"],["」"],["と"],["言って","いって"],["、"],["イエス"],["を"],["平手","ひらて"],["で"],["打った","うった"],["。"]]},{"verse":23,"text":"イエスは答えられた。「何か悪いことをわたしが言ったのなら、その悪いところを証明しなさい。正しいことを言ったのなら、なぜわたしを打つのか。」","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["何","なん"],["か"],["悪い","わるい"],["こと"],["を"],["わたし"],["が"],["言った","いった"],["の"],["なら"],["、"],["その"],["悪い","わるい"],["ところ"],["を"],["証明","しょうめい"],["し"],["なさい"],["。"],["正しい","ただしい"],["こと"],["を"],["言った","いった"],["の"],["なら"],["、"],["なぜ"],["わたし"],["を"],["打つ","うつ"],["の"],["か"],["。"],["」"]]},{"verse":24,"text":"アンナスは、イエスを縛ったまま、大祭司カイアファのもとに送った。","tok":[["アンナス"],["は"],["、"],["イエス"],["を"],["縛った","しばった"],["まま"],["、"],["大","だい"],["祭司","さいし"],["カイアファ"],["の"],["もと"],["に"],["送った","おくった"],["。"]]},{"verse":25,"text":"シモン‧ペトロは立って火にあたっていた。人々が、「お前もあの男の弟子の一人ではないのか」と言うと、ペトロは打ち消して、「違う」と言った。","tok":[["シモン"],["‧"],["ペトロ"],["は"],["立って","たって"],["火","ひ"],["に"],["あたって"],["いた"],["。"],["人々","ひとびと"],["が"],["、"],["「"],["お前","おまえ"],["も"],["あの"],["男","おとこ"],["の"],["弟子","でし"],["の"],["一人","ひとり"],["で"],["は"],["ない"],["の"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"],["ペトロ"],["は"],["打ち消して","うちけして"],["、"],["「"],["違う","ちがう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"大祭司の僕の一人で、ペトロに片方の耳を切り落とされた人の身内の者が言った。「園であの男と一緒にいるのを、わたしに見られたではないか。」","tok":[["大","だい"],["祭司","さいし"],["の"],["僕","ぼく"],["の"],["一人","ひとり"],["で"],["、"],["ペトロ"],["に"],["片方","かたほう"],["の"],["耳","みみ"],["を"],["切り落とされた","きりおとされた"],["人","ひと"],["の"],["身内","みうち"],["の"],["者","もの"],["が"],["言った","いった"],["。"],["「"],["園","その"],["で"],["あの"],["男","おとこ"],["と"],["一緒","いっしょ"],["に"],["いる"],["の"],["を"],["、"],["わたし"],["に"],["見られたで","みられたで"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":27,"text":"ペトロは、再び打ち消した。するとすぐ、鶏が鳴いた。","tok":[["ペトロ"],["は"],["、"],["再び","ふたたび"],["打ち消した","うちけした"],["。"],["する"],["と"],["すぐ"],["、"],["鶏","にわとり"],["が"],["鳴いた","ないた"],["。"]]},{"verse":28,"text":"人々は、イエスをカイアファのところから総督官邸に連れて行った。明け方であった。しかし、彼らは自分では官邸に入らなかった。汚れないで過越の食事をするためである。","tok":[["人々","ひとびと"],["は"],["、"],["イエス"],["を"],["カイアファ"],["の"],["ところ"],["から"],["総督","そうとく"],["官邸","かんてい"],["に"],["連れて","つれて"],["行った","いった"],["。"],["明け方","あけがた"],["で"],["あった"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["で"],["は"],["官邸","かんてい"],["に"],["入らなかった","はいらなかった"],["。"],["汚れないで","よごれないで"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":29,"text":"そこで、ピラトが彼らのところへ出て来て、「どういう罪でこの男を訴えるのか」と言った。","tok":[["そこ"],["で"],["、"],["ピラト"],["が"],["彼","かれ"],["ら"],["の"],["ところ"],["へ"],["出て","でて"],["来て","きて"],["、"],["「"],["どういう"],["罪","つみ"],["で"],["この"],["男","おとこ"],["を"],["訴える","うったえる"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":30,"text":"彼らは答えて、「この男が悪いことをしていなかったら、あなたに引き渡しはしなかったでしょう」と言った。","tok":[["彼","かれ"],["ら"],["は"],["答えて","こたえて"],["、"],["「"],["この"],["男","おとこ"],["が"],["悪い","わるい"],["こと"],["を"],["して"],["いなかったら"],["、"],["あなた"],["に"],["引き渡し","ひきわたし"],["は"],["しなかったでしょう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":31,"text":"ピラトが、「あなたたちが引き取って、自分たちの律法に従って裁け」と言うと、ユダヤ人たちは、「わたしたちには、人を死刑にする権限がありません」と言った。","tok":[["ピラト"],["が"],["、"],["「"],["あなた"],["たち"],["が"],["引き取って","ひきとって"],["、"],["自分","じぶん"],["たち"],["の"],["律法","りっぽう"],["に"],["従って","したがって"],["裁け","さばけ"],["」"],["と"],["言う","ゆう"],["と"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["「"],["わたしたち"],["に"],["は"],["、"],["人","ひと"],["を"],["死刑","しけい"],["に"],["する"],["権限","けんげん"],["が"],["ありません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":32,"text":"それは、御自分がどのような死を遂げるかを示そうとして、イエスの言われた言葉が実現するためであった。","tok":[["それ"],["は"],["、"],["御自分","ごじぶん"],["が"],["どのような"],["死","し"],["を"],["遂げる","とげる"],["か"],["を"],["示そう","しめそう"],["として"],["、"],["イエス"],["の"],["言われた","いわれた"],["言葉","ことば"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":33,"text":"そこで、ピラトはもう一度官邸に入り、イエスを呼び出して、「お前がユダヤ人の王なのか」と言った。","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["もう"],["一","いち"],["度","ど"],["官邸","かんてい"],["に"],["入り","はいり"],["、"],["イエス"],["を"],["呼び出して","よびだして"],["、"],["「"],["お前","おまえ"],["が"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["な"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":34,"text":"イエスはお答えになった。「あなたは自分の考えで、そう言うのですか。それとも、ほかの者がわたしについて、あなたにそう言ったのですか。」","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["あなた"],["は"],["自分","じぶん"],["の"],["考え","かんがえ"],["で"],["、"],["そう"],["言う","いう"],["の"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["ほか"],["の"],["者","もの"],["が"],["わたし"],["について"],["、"],["あなた"],["に"],["そう"],["言った","いった"],["の"],["です"],["か"],["。"],["」"]]},{"verse":35,"text":"ピラトは言い返した。「わたしはユダヤ人なのか。お前の同胞や祭司長たちが、お前をわたしに引き渡したのだ。いったい何をしたのか。」","tok":[["ピラト"],["は"],["言い返した","いいかえした"],["。"],["「"],["わたし"],["は"],["ユダヤ人","ゆだやじん"],["な"],["の"],["か"],["。"],["お前","おまえ"],["の"],["同胞","どうほう"],["や"],["祭司長","さいしちょう"],["たち"],["が"],["、"],["お前","おまえ"],["を"],["わたし"],["に"],["引き渡した","ひきわたした"],["の"],["だ"],["。"],["いったい"],["何","なん"],["を"],["した"],["の"],["か"],["。"],["」"]]},{"verse":36,"text":"イエスはお答えになった。「わたしの国は、この世には属していない。もし、わたしの国がこの世に属していれば、わたしがユダヤ人に引き渡されないように、部下が戦ったことだろう。しかし、実際、わたしの国はこの世には属していない。」","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["わたし"],["の"],["国","くに"],["は"],["、"],["この世","このよ"],["に"],["は"],["属して","ぞくして"],["いない"],["。"],["もし"],["、"],["わたし"],["の"],["国","くに"],["が"],["この世","このよ"],["に"],["属して","ぞくして"],["いれば"],["、"],["わたし"],["が"],["ユダヤ人","ゆだやじん"],["に"],["引き渡されない","ひきわたされない"],["よう"],["に"],["、"],["部下","ぶか"],["が"],["戦った","たたかった"],["こと"],["だろう"],["。"],["しかし"],["、"],["実際","じっさい"],["、"],["わたし"],["の"],["国","くに"],["は"],["この世","このよ"],["に"],["は"],["属して","ぞくして"],["いない"],["。"],["」"]]},{"verse":37,"text":"そこでピラトが、「それでは、やはり王なのか」と言うと、イエスはお答えになった。「わたしが王だとは、あなたが言っていることです。わたしは真理について証しをするために生まれ、そのためにこの世に来た。真理に属する人は皆、わたしの声を聞く。」","tok":[["そこ"],["で"],["ピラト"],["が"],["、"],["「"],["それ"],["で"],["は"],["、"],["やはり"],["王","おう"],["な"],["の"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"],["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["わたし"],["が"],["王","おう"],["だ"],["と"],["は"],["、"],["あなた"],["が"],["言って","いって"],["いる"],["こと"],["です"],["。"],["わたし"],["は"],["真理","しんり"],["について"],["証し","あかし"],["を"],["する"],["ため"],["に"],["生まれ","うまれ"],["、"],["その"],["ため"],["に"],["この世","このよ"],["に"],["来た","きた"],["。"],["真理","しんり"],["に"],["属する","ぞくする"],["人","ひと"],["は"],["皆","みな"],["、"],["わたし"],["の"],["声","こえ"],["を"],["聞く","きく"],["。"],["」"]]},{"verse":38,"text":"ピラトは言った。「真理とは何か。」死刑の判決を受けるピラトは、こう言ってからもう一度、ユダヤ人たちの前に出て来て言った。「わたしはあの男に何の罪も見いだせない。","tok":[["ピラト"],["は"],["言った","いった"],["。"],["「"],[
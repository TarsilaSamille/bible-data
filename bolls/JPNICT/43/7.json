"],["。"]]},{"verse":49,"text":"だが、律法を知らないこの群衆は、呪われている。」","tok":[["だ"],["が"],["、"],["律法","りっぽう"],["を"],["知らない","しらない"],["この"],["群衆","ぐんしゅう"],["は"],["、"],["呪われて","のろわれて"],["いる"],["。"],["」"]]},{"verse":50,"text":"彼らの中の一人で、以前イエスを訪ねたことのあるニコデモが言った。","tok":[["彼","かれ"],["ら"],["の"],["中","なか"],["の"],["一人","ひとり"],["で"],["、"],["以前","いぜん"],["イエス"],["を"],["訪ねた","たずねた"],["こと"],["の"],["ある"],["ニコデモ"],["が"],["言った","いった"],["。"]]},{"verse":51,"text":"「我々の律法によれば、まず本人から事情を聞き、何をしたかを確かめたうえでなければ、判決を下してはならないことになっているではないか。」","tok":[["「"],["我々","われわれ"],["の"],["律法","りっぽう"],["に"],["よれば"],["、"],["まず"],["本人","ほんにん"],["から"],["事情","じじょう"],["を"],["聞き","きき"],["、"],["何","なん"],["を"],["した"],["か"],["を"],["確かめた","たしかめた"],["うえ"],["で"],["なければ"],["、"],["判決","はんけつ"],["を"],["下して","くだして"],["は"],["ならない"],["こと"],["に"],["なって"],["いるで"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":52,"text":"彼らは答えて言った。「あなたもガリラヤ出身なのか。よく調べてみなさい。ガリラヤからは預言者の出ないことが分かる。」","tok":[["彼","かれ"],["ら"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あなた"],["も"],["ガリラヤ"],["出身","しゅっしん"],["な"],["の"],["か"],["。"],["よく"],["調べて","しらべて"],["み"],["なさい"],["。"],["ガリラヤ"],["から"],["は"],["預言者","よげんしゃ"],["の"],["出ない","でない"],["こと"],["が"],["分かる","わかる"],["。"],["」"]]},{"verse":53,"text":"〔人々はおのおの家へ帰って行った。","tok":[["〔"],["人々","ひとびと"],["は"],["おのおの"],["家","いえ"],["へ"],["帰って","かえって"],["行った","いった"],["。"]]}]
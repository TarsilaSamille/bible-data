"],["議員","ぎいん"],["たち"],["は"],["、"],["この"],["人","ひと"],["が"],["メシア"],["だ"],["と"],["いう"],["こと"],["を"],["、"],["本当","ほんとう"],["に"],["認めた","みとめた"],["ので"],["は"],["なかろう"],["か"],["。"]]},{"verse":27,"text":"しかし、わたしたちは、この人がどこの出身かを知っている。メシアが来られるときは、どこから来られるのか、だれも知らないはずだ。」","tok":[["しかし"],["、"],["わたしたち"],["は"],["、"],["この"],["人","ひと"],["が"],["どこ"],["の"],["出身","しゅっしん"],["か"],["を"],["知って","しって"],["いる"],["。"],["メシア"],["が"],["来られる","こられる"],["とき"],["は"],["、"],["どこ"],["から"],["来られる","こられる"],["の"],["か"],["、"],["だれ"],["も"],["知らない","しらない"],["はず"],["だ"],["。"],["」"]]},{"verse":28,"text":"すると、神殿の境内で教えていたイエスは、大声で言われた。「あなたたちはわたしのことを知っており、また、どこの出身かも知っている。わたしは自分勝手に来たのではない。わたしをお遣わしになった方は真実であるが、あなたたちはその方を知らない。","tok":[["する"],["と"],["、"],["神殿","しんでん"],["の"],["境内","けいだい"],["で"],["教えて","おしえて"],["いた"],["イエス"],["は"],["、"],["大声","おおごえ"],["で"],["言われた","いわれた"],["。"],["「"],["あなた"],["たち"],["は"],["わたし"],["の"],["こと"],["を"],["知って","しって"],["おり"],["、"],["また"],["、"],["どこ"],["の"],["出身","しゅっしん"],["か"],["も"],["知って","しって"],["いる"],["。"],["わたし"],["は"],["自分","じぶん"],["勝手に","かってに"],["来た","きた"],["ので"],["は"],["ない"],["。"],["わたし"],["を"],["お遣わし","おつかわし"],["に"],["なった"],["方","ほう"],["は"],["真実","しんじつ"],["で"],["ある"],["が"],["、"],["あなた"],["たち"],["は"],["その"],["方","ほう"],["を"],["知らない","しらない"],["。"]]},{"verse":29,"text":"わたしはその方を知っている。わたしはその方のもとから来た者であり、その方がわたしをお遣わしになったのである。」","tok":[["わたし"],["は"],["その"],["方","ほう"],["を"],["知って","しって"],["いる"],["。"],["わたし"],["は"],["その"],["方","かた"],["の"],["もと"],["から"],["来た","きた"],["者","もの"],["で"],["あり"],["、"],["その"],["方","ほう"],["が"],["わたし"],["を"],["お遣わし","おつかわし"],["に"],["なった"],["ので"],["ある"],["。"],["」"]]},{"verse":30,"text":"人々はイエスを捕らえようとしたが、手をかける者はいなかった。イエスの時はまだ来ていなかったからである。","tok":[["人々","ひとびと"],["は"],["イエス"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["が"],["、"],["手","て"],["を"],["かける"],["者","もの"],["は"],["いなかった"],["。"],["イエス"],["の"],["時","とき"],["は"],["まだ"],["来て","きて"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":31,"text":"しかし、群衆の中にはイエスを信じる者が大勢いて、「メシアが来られても、この人よりも多くのしるしをなさるだろうか」と言った。","tok":[["しかし"],["、"],["群衆","ぐんしゅう"],["の"],["中","なか"],["に"],["は"],["イエス"],["を"],["信じる","しんじる"],["者","もの"],["が"],["大勢","おおぜい"],["いて"],["、"],["「"],["メシア"],["が"],["来られて","こられて"],["も"],["、"],["この"],["人","ひと"],["より"],["も"],["多く","おおく"],["の"],["しるし"],["を"],["なさるだろう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":32,"text":"ファリサイ派の人々は、群衆がイエスについてこのようにささやいているのを耳にした。祭司長たちとファリサイ派の人々は、イエスを捕らえるために下役たちを遣わした。","tok":[["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["は"],["、"],["群衆","ぐんしゅう"],["が"],["イエス"],["について"],["この"],["よう"],["に"],["ささやいて"],["いる"],["の"],["を"],["耳","みみ"],["に"],["した"],["。"],["祭司長","さいしちょう"],["たち"],["と"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["は"],["、"],["イエス"],["を"],["捕らえる","とらえる"],["ため"],["に"],["下役","したやく"],["たち"],["を"],["遣わした","つかわした"],["。"]]},{"verse":33,"text":"そこで、イエスは言われた。「今しばらく、わたしはあなたたちと共にいる。それから、自分をお遣わしになった方のもとへ帰る。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["今","いま"],["しばらく"],["、"],["わたし"],["は"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いる"],["。"],["それ"],["から"],["、"],["自分","じぶん"],["を"],["お遣わし","おつかわし"],["に"],["なった"],["方","ほう"],["の"],["もと"],["へ"],["帰る","かえる"],["。"]]},{"verse":34,"text":"あなたたちは、わたしを捜しても、見つけることがない。わたしのいる所に、あなたたちは来ることができない。」","tok":[["あなた"],["たち"],["は"],["、"],["わたし"],["を"],["捜して","さがして"],["も"],["、"],["見つける","みつける"],["こと"],["が"],["ない"],["。"],["わたし"],["の"],["いる"],["所","ところ"],["に"],["、"],["あなた"],["たち"],["は"],["来る","くる"],["こと"],["が"],["できない"],["。"],["」"]]},{"verse":35,"text":"すると、ユダヤ人たちが互いに言った。「わたしたちが見つけることはないとは、いったい、どこへ行くつもりだろう。ギリシア人の間に離散しているユダヤ人のところへ行って、ギリシア人に教えるとでもいうのか。","tok":[["する"],["と"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["わたしたち"],["が"],["見つける","みつける"],["こと"],["は"],["ない"],["と"],["は"],["、"],["いったい"],["、"],["どこ"],["へ"],["行く","いく"],["つもり"],["だろう"],["。"],["ギリシア"],["人","にん"],["の"],["間","あいだ"],["に"],["離散","りさん"],["して"],["いる"],["ユダヤ人","ゆだやじん"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["ギリシア"],["人","にん"],["に"],["教える","おしえる"],["と"],["で"],["も"],["いう"],["の"],["か"],["。"]]},{"verse":36,"text":"『あなたたちは、わたしを捜しても、見つけることがない。わたしのいる所に、あなたたちは来ることができない』と彼は言ったが、その言葉はどういう意味なのか。」","tok":[["『"],["あなた"],["たち"],["は"],["、"],["わたし"],["を"],["捜して","さがして"],["も"],["、"],["見つける","みつける"],["こと"],["が"],["ない"],["。"],["わたし"],["の"],["いる"],["所","ところ"],["に"],["、"],["あなた"],["たち"],["は"],["来る","くる"],["こと"],["が"],["できない"],["』"],["と"],["彼","かれ"],["は"],["言った","いった"],["が"],["、"],["その"],["言葉","ことば"],["は"],["どういう"],["意味","いみ"],["な"],["の"],["か"],["。"],["」"]]},{"verse":37,"text":"祭りが最も盛大に祝われる終わりの日に、イエスは立ち上がって大声で言われた。「渇いている人はだれでも、わたしのところに来て飲みなさい。","tok":[["祭り","まつり"],["が"],["最も","もっとも"],["盛大","せいだい"],["に"],["祝われる","いわわれる"],["終わり","おわり"],["の"],["日","ひ"],["に"],["、"],["イエス"],["は"],["立ち上がって","たちあがって"],["大声","おおごえ"],["で"],["言われた","いわれた"],["。"],["「"],["渇いて","かわいて"],["いる"],["人","ひと"],["は"],["だれ"],["で"],["も"],["、"],["わたし"],["の"],["ところ"],["に"],["来て","きて"],["飲み","のみ"],["なさい"],["。"]]},{"verse":38,"text":"わたしを信じる者は、聖書に書いてあるとおり、その人の内から生きた水が川となって流れ出るようになる。」","tok":[["わたし"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["と"],["おり"],["、"],["その"],["人","ひと"],["の"],["内","うち"],["から"],["生きた","いきた"],["水","みず"],["が"],["川","かわ"],["と"],["なって"],["流れ出る","ながれでる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":39,"text":"イエスは、御自分を信じる人々が受けようとしている“霊”について言われたのである。イエスはまだ栄光を受けておられなかったので、“霊”がまだ降っていなかったからである。","tok":[["イエス"],["は"],["、"],["御自分","ごじぶん"],["を"],["信じる","しんじる"],["人々","ひとびと"],["が"],["受けよう","うけよう"],["として"],["いる"],["“"],["霊","れい"],["”"],["について"],["言われた","いわれた"],["ので"],["ある"],["。"],["イエス"],["は"],["まだ"],["栄光","えいこう"],["を"],["受けて","うけて"],["おられなかった"],["ので"],["、"],["“"],["霊","れい"],["”"],["が"],["まだ"],["降って","ふって"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":40,"text":"この言葉を聞いて、群衆の中には、「この人は、本当にあの預言者だ」と言う者や、","tok":[["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["群衆","ぐんしゅう"],["の"],["中","なか"],["に"],["は"],["、"],["「"],["この"],["人","ひと"],["は"],["、"],["本当","ほんとう"],["に"],["あの"],["預言者","よげんしゃ"],["だ"],["」"],["と"],["言う","いう"],["者","もの"],["や"],["、"]]},{"verse":41,"text":"「この人はメシアだ」と言う者がいたが、このように言う者もいた。「メシアはガリラヤから出るだろうか。","t
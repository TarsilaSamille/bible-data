[{"verse":1,"text":"イエスはこれらのことを話してから、天を仰いで言われた。「父よ、時が来ました。あなたの子があなたの栄光を現すようになるために、子に栄光を与えてください。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["話して","はなして"],["から"],["、"],["天","てん"],["を"],["仰いで","あおいで"],["言われた","いわれた"],["。"],["「"],["父","ちち"],["よ"],["、"],["時","とき"],["が"],["来ました","きました"],["。"],["あなた"],["の"],["子","こ"],["が"],["あなた"],["の"],["栄光","えいこう"],["を"],["現す","あらわす"],["よう"],["に"],["なる"],["ため"],["に"],["、"],["子","こ"],["に"],["栄光","えいこう"],["を"],["与えて","あたえて"],["ください"],["。"]]},{"verse":2,"text":"あなたは子にすべての人を支配する権能をお与えになりました。そのために、子はあなたからゆだねられた人すべてに、永遠の命を与えることができるのです。","tok":[["あなた"],["は"],["子","こ"],["に"],["すべて"],["の"],["人","ひと"],["を"],["支配","しはい"],["する"],["権能","けんのう"],["を"],["お与え","おあたえ"],["に"],["なりました"],["。"],["その"],["ため"],["に"],["、"],["子","こ"],["は"],["あなた"],["から"],["ゆだねられた"],["人","ひと"],["すべて"],["に"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["与える","あたえる"],["こと"],["が"],["できる"],["の"],["です"],["。"]]},{"verse":3,"text":"永遠の命とは、唯一のまことの神であられるあなたと、あなたのお遣わしになったイエス‧キリストを知ることです。","tok":[["永遠","えいえん"],["の"],["命","いのち"],["と"],["は"],["、"],["唯一","ゆいいつ"],["の"],["まこと"],["の"],["神","かみ"],["で"],["あられる"],["あなた"],["と"],["、"],["あなた"],["の"],["お遣わし","おつかわし"],["に"],["なった"],["イエス"],["‧"],["キリスト"],["を"],["知る","しる"],["こと"],["です"],["。"]]},{"verse":4,"text":"わたしは、行うようにとあなたが与えてくださった業を成し遂げて、地上であなたの栄光を現しました。","tok":[["わたし"],["は"],["、"],["行う","おこなう"],["よう"],["に"],["と"],["あなた"],["が"],["与えて","あたえて"],["くださった"],["業","ごう"],["を"],["成し遂げて","なしとげて"],["、"],["地上","ちじょう"],["で"],["あなた"],["の"],["栄光","えいこう"],["を"],["現しました","あらわしました"],["。"]]},{"verse":5,"text":"父よ、今、御前でわたしに栄光を与えてください。世界が造られる前に、わたしがみもとで持っていたあの栄光を。","tok":[["父","ちち"],["よ"],["、"],["今","いま"],["、"],["御前","ごぜん"],["で"],["わたし"],["に"],["栄光","えいこう"],["を"],["与えて","あたえて"],["ください"],["。"],["世界","せかい"],["が"],["造られる","つくられる"],["前","まえ"],["に"],["、"],["わたし"],["が"],["みもと"],["で"],["持って","もって"],["いた"],["あの"],["栄光","えいこう"],["を"],["。"]]},{"verse":6,"text":"世から選び出してわたしに与えてくださった人々に、わたしは御名を現しました。彼らはあなたのものでしたが、あなたはわたしに与えてくださいました。彼らは、御言葉を守りました。","tok":[["世","よ"],["から"],["選び出して","えらびだして"],["わたし"],["に"],["与えて","あたえて"],["くださった"],["人々","ひとびと"],["に"],["、"],["わたし"],["は"],["御名","ぎょめい"],["を"],["現しました","あらわしました"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["もの"],["でした"],["が"],["、"],["あなた"],["は"],["わたし"],["に"],["与えて","あたえて"],["くださいました"],["。"],["彼","かれ"],["ら"],["は"],["、"],["御言葉","おことば"],["を"],["守りました","まもりました"],["。"]]},{"verse":7,"text":"わたしに与えてくださったものはみな、あなたからのものであることを、今、彼らは知っています。","tok":[["わたし"],["に"],["与えて","あたえて"],["くださった"],["もの"],["は"],["みな"],["、"],["あなた"],["から"],["の"],["もの"],["で"],["ある"],["こと"],["を"],["、"],["今","いま"],["、"],["彼","かれ"],["ら"],["は"],["知って","しって"],["います"],["。"]]},{"verse":8,"text":"なぜなら、わたしはあなたから受けた言葉を彼らに伝え、彼らはそれを受け入れて、わたしがみもとから出て来たことを本当に知り、あなたがわたしをお遣わしになったことを信じたからです。","tok":[["なぜ"],["なら"],["、"],["わたし"],["は"],["あなた"],["から"],["受けた","うけた"],["言葉","ことば"],["を"],["彼","かれ"],["ら"],["に"],["伝え","つたえ"],["、"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["受け入れて","うけいれて"],["、"],["わたし"],["が"],["みもと"],["から"],["出て","でて"],["来た","きた"],["こと"],["を"],["本当","ほんとう"],["に"],["知り","しり"],["、"],["あなた"],["が"],["わたし"],["を"],["お遣わし","おつかわし"],["に"],["なった"],["こと"],["を"],["信じた","しんじた"],["から"],["です"],["。"]]},{"verse":9,"text":"彼らのためにお願いします。世のためではなく、わたしに与えてくださった人々のためにお願いします。彼らはあなたのものだからです。","tok":[["彼","かれ"],["ら"],["の"],["ため"],["に"],["お願い","おねがい"],["します"],["。"],["世","よ"],["の"],["ため"],["で"],["は"],["なく"],["、"],["わたし"],["に"],["与えて","あたえて"],["くださった"],["人々","ひとびと"],["の"],["ため"],["に"],["お願い","おねがい"],["します"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["もの"],["だ"],["から"],["です"],["。"]]},{"verse":10,"text":"わたしのものはすべてあなたのもの、あなたのものはわたしのものです。わたしは彼らによって栄光を受けました。","tok":[["わたし"],["の"],["もの"],["は"],["すべて"],["あなた"],["の"],["もの"],["、"],["あなた"],["の"],["もの"],["は"],["わたし"],["の"],["もの"],["です"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["によって"],["栄光","えいこう"],["を"],["受けました","うけました"],["。"]]},{"verse":11,"text":"わたしは、もはや世にはいません。彼らは世に残りますが、わたしはみもとに参ります。聖なる父よ、わたしに与えてくださった御名によって彼らを守ってください。わたしたちのように、彼らも一つとなるためです。","tok":[["わたし"],["は"],["、"],["もはや"],["世","よ"],["に"],["は"],["いません"],["。"],["彼","かれ"],["ら"],["は"],["世","よ"],["に"],["残ります","のこります"],["が"],["、"],["わたし"],["は"],["みもと"],["に"],["参ります","まいります"],["。"],["聖","せい"],["なる"],["父","ちち"],["よ"],["、"],["わたし"],["に"],["与えて","あたえて"],["くださった"],["御名","ぎょめい"],["によって"],["彼","かれ"],["ら"],["を"],["守って","まもって"],["ください"],["。"],["わたしたち"],["の"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["一","ひと"],["つ"],["と"],["なる"],["ため"],["です"],["。"]]},{"verse":12,"text":"わたしは彼らと一緒にいる間、あなたが与えてくださった御名によって彼らを守りました。わたしが保護したので、滅びの子のほかは、だれも滅びませんでした。聖書が実現するためです。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["いる"],["間","あいだ"],["、"],["あなた"],["が"],["与えて","あたえて"],["くださった"],["御名","ぎょめい"],["によって"],["彼","かれ"],["ら"],["を"],["守りました","まもりました"],["。"],["わたし"],["が"],["保護","ほご"],["した"],["ので"],["、"],["滅び","ほろび"],["の"],["子","こ"],["の"],["ほか"],["は"],["、"],["だれ"],["も"],["滅びませんでした","ほろびませんでした"],["。"],["聖書","せいしょ"],["が"],["実現","じつげん"],["する"],["ため"],["です"],["。"]]},{"verse":13,"text":"しかし、今、わたしはみもとに参ります。世にいる間に、これらのことを語るのは、わたしの喜びが彼らの内に満ちあふれるようになるためです。","tok":[["しかし"],["、"],["今","いま"],["、"],["わたし"],["は"],["みもと"],["に"],["参ります","まいります"],["。"],["世","よ"],["に"],["いる"],["間","あいだ"],["に"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["語る","かたる"],["の"],["は"],["、"],["わたし"],["の"],["喜び","よろこび"],["が"],["彼","かれ"],["ら"],["の"],["内","うち"],["に"],["満ちあふれる","みちあふれる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":14,"text":"わたしは彼らに御言葉を伝えましたが、世は彼らを憎みました。わたしが世に属していないように、彼らも世に属していないからです。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["御言葉","おことば"],["を"],["伝えました","つたえました"],["が"],["、"],["世","よ"],["は"],["彼","かれ"],["ら"],["を"],["憎みました","にくみました"],["。"],["わたし"],["が"],["世","よ"],["に"],["属して","ぞくして"],["いない"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["世","よ"],["に"],["属して","ぞくして"],["いない"],["から"],["です"],["。"]]},{"verse":15,"text":"わたしがお願いするのは、彼らを世から取り去ることではなく、悪い者から守ってくださることです。","tok":[["わたし"],["が"],["お願い","おねがい"],["する"],["の"],["は"],["、"],["彼","かれ"],["ら"],["を"],["世","よ"],["から"],["取り去る","とりさる"],["こと"],["で"],["は"],["なく"],["、"],["悪い","わるい"],["者","もの"],["から"],["守って","まもって"],["くださる"],["こと"],["です"],["。"]]},{"verse":16,"text":"わたしが世に属していないように、彼らも世に属していないのです。","tok":[["わたし"],["が"],["世","よ"],["に"],["属して","ぞくして"],["いない"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["世","よ"],["に"],["属して","ぞくして"],["いない"],["の"],["です"],["。"]]},{"verse":17,"text":"真理によって、彼らを聖なる者としてください。あなたの御言葉は真理です。","tok":[["真理","しんり"],["によって"],["、"],["彼","かれ"],["ら"],["を"],["聖","せい"],["なる"],["者","もの"],["として"],["ください"],["。"],["あなた"],["の"],["御言葉","おことば"],["は"],["真理","しんり"],["です"],["。"]]},{"verse":18,"text":"わたしを世にお遣わしになったように、わたしも彼らを世に遣わしました。","tok":[["わたし"],["を"],["世","よ"],["に"],["お遣わし","おつかわし"],["に"],["なった"],["よう"],["に"],["、"],["わたし"],["も"],["彼","かれ"],["ら"],["を"],["世","よ"],["に"],["遣わしました","つかわしました"],["。"]]},{"verse":19,"text":"彼らのために、わたしは自分自身をささげます。彼らも、真理によってささげられた者となるためです。","tok":[["彼","かれ"],["ら"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["ささげます"],["。"],["彼","かれ"],["ら"],["も"],["、"],["真理","しんり"],["によって"],["ささげられた"],["者","もの"],["と"],["なる"],["ため"],["です"],["。"]]},{"verse":20,"text":"また、彼らのためだけでなく、彼らの言葉によってわたしを信じる人々のためにも、お願いします。","tok":[["また"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["だけ"],["で"],["なく"],["、"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["によって"],["わたし"],["を"],["信じる","しんじる"],["人々","ひとびと"],["の"],["ため"],["に"],["も"],["、"],["お願い","おねがい"],["します"],["。"]]},{"verse":21,"text":"父よ、あなたがわたしの内におられ、わたしがあなたの内にいるように、すべての人を一つにしてください。彼らもわたしたちの内にいるようにしてください。そうすれば、世は、あなたがわたしをお遣わしになったことを、信じるようになります。","tok":[["父","ちち"],["よ"],["、"],["あなた"],["が"],["わたし"],["の"],["内","うち"],["に"],["おられ"],["、"],["わたし"],["が"],["あなた"],["の"],["内","うち"],["に"],["いる"],["よう"],["に"],["、"],["すべて"],["の"],["人","ひと"],["を"],["一","ひと"],["つ"],["に"],["して"],["ください"],["。"],["彼","かれ"],["ら"],["も"],["わたしたち"],["の"],["内","うち"],["に"],["いる"],["よう"],["に"],["して"],["ください"],["。"],["そう"],["すれば"],["、"],["世","よ"],["は"],["、"],["あなた"],["が"],["わたし"],["を"],["お遣わし","おつかわし"],["に"],["なった"],["こと"],["を"],["、"],["信じる","しんじる"],["よう"],["に"],["なります"],["。"]]},{"verse":22,"text":"あなたがくださった栄光を、わたしは彼らに与えました。わたしたちが一つであるように、彼らも一つになるためです。","tok":[["あなた"],["が"],["くださった"],["栄光","えい
[{"verse":1,"text":"その後、イエスはティベリアス湖畔で、また弟子たちに御自身を現された。その次第はこうである。","tok":[["その"],["後","ご"],["、"],["イエス"],["は"],["ティベリアス"],["湖","こ"],["畔","はん"],["で"],["、"],["また"],["弟子","でし"],["たち"],["に"],["御自身","ごじしん"],["を"],["現された","あらわされた"],["。"],["その"],["次第","しだい"],["は"],["こう"],["で"],["ある"],["。"]]},{"verse":2,"text":"シモン‧ペトロ、ディディモと呼ばれるトマス、ガリラヤのカナ出身のナタナエル、ゼベダイの子たち、それに、ほかの二人の弟子が一緒にいた。","tok":[["シモン"],["‧"],["ペトロ"],["、"],["ディディモ"],["と"],["呼ばれる","よばれる"],["トマス"],["、"],["ガリラヤ"],["の"],["カナ"],["出身","しゅっしん"],["の"],["ナタナエル"],["、"],["ゼベダイ"],["の"],["子","こ"],["たち"],["、"],["それ"],["に"],["、"],["ほか"],["の"],["二人","ふたり"],["の"],["弟子","でし"],["が"],["一緒","いっしょ"],["に"],["いた"],["。"]]},{"verse":3,"text":"シモン‧ペトロが、「わたしは漁に行く」と言うと、彼らは、「わたしたちも一緒に行こう」と言った。彼らは出て行って、舟に乗り込んだ。しかし、その夜は何もとれなかった。","tok":[["シモン"],["‧"],["ペトロ"],["が"],["、"],["「"],["わたし"],["は"],["漁","りょう"],["に"],["行く","いく"],["」"],["と"],["言う","ゆう"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["わたしたち"],["も"],["一緒","いっしょ"],["に"],["行こう","いこう"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行って","いって"],["、"],["舟","ふね"],["に"],["乗り込んだ","のりこんだ"],["。"],["しかし"],["、"],["その"],["夜","よる"],["は"],["何","なん"],["も"],["とれなかった"],["。"]]},{"verse":4,"text":"既に夜が明けたころ、イエスが岸に立っておられた。だが、弟子たちは、それがイエスだとは分からなかった。","tok":[["既に","すでに"],["夜","よる"],["が"],["明けた","あけた"],["ころ"],["、"],["イエス"],["が"],["岸","きし"],["に"],["立って","たって"],["おられた"],["。"],["だ"],["が"],["、"],["弟子","でし"],["たち"],["は"],["、"],["それ"],["が"],["イエス"],["だ"],["と"],["は"],["分からなかった","わからなかった"],["。"]]},{"verse":5,"text":"イエスが、「子たちよ、何か食べる物があるか」と言われると、彼らは、「ありません」と答えた。","tok":[["イエス"],["が"],["、"],["「"],["子","こ"],["たち"],["よ"],["、"],["何","なん"],["か"],["食べる","たべる"],["物","もの"],["が"],["ある"],["か"],["」"],["と"],["言われる","いわれる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["ありません"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":6,"text":"イエスは言われた。「舟の右側に網を打ちなさい。そうすればとれるはずだ。」そこで、網を打ってみると、魚があまり多くて、もはや網を引き上げることができなかった。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["舟","ふね"],["の"],["右側","みぎがわ"],["に"],["網","あみ"],["を"],["打ち","うち"],["なさい"],["。"],["そう"],["すれば"],["とれる"],["はず"],["だ"],["。"],["」"],["そこ"],["で"],["、"],["網","あみ"],["を"],["打って","うって"],["みる"],["と"],["、"],["魚","さかな"],["が"],["あまり"],["多くて","おおくて"],["、"],["もはや"],["網","あみ"],["を"],["引き上げる","ひきあげる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":7,"text":"イエスの愛しておられたあの弟子がペトロに、「主だ」と言った。シモン‧ペトロは「主だ」と聞くと、裸同然だったので、上着をまとって湖に飛び込んだ。","tok":[["イエス"],["の"],["愛して","あいして"],["おられた"],["あの"],["弟子","でし"],["が"],["ペトロ"],["に"],["、"],["「"],["主","ぬし"],["だ"],["」"],["と"],["言った","いった"],["。"],["シモン"],["‧"],["ペトロ"],["は"],["「"],["主","ぬし"],["だ"],["」"],["と"],["聞く","きく"],["と"],["、"],["裸","はだか"],["同然","どうぜん"],["だった"],["ので"],["、"],["上着","うわぎ"],["を"],["まとって"],["湖","みずうみ"],["に"],["飛び込んだ","とびこんだ"],["。"]]},{"verse":8,"text":"ほかの弟子たちは魚のかかった網を引いて、舟で戻って来た。陸から二百ペキスばかりしか離れていなかったのである。","tok":[["ほか"],["の"],["弟子","でし"],["たち"],["は"],["魚","さかな"],["の"],["かかった"],["網","あみ"],["を"],["引いて","ひいて"],["、"],["舟","ふね"],["で"],["戻って","もどって"],["来た","きた"],["。"],["陸","りく"],["から"],["二百","にひゃく"],["ペキス"],["ばかり"],["しか"],["離れて","はなれて"],["いなかった"],["ので"],["ある"],["。"]]},{"verse":9,"text":"さて、陸に上がってみると、炭火がおこしてあった。その上に魚がのせてあり、パンもあった。","tok":[["さて"],["、"],["陸","りく"],["に"],["上がって","あがって"],["みる"],["と"],["、"],["炭火","すみび"],["が"],["おこして"],["あった"],["。"],["その"],["上","うえ"],["に"],["魚","さかな"],["が"],["のせて"],["あり"],["、"],["パン"],["も"],["あった"],["。"]]},{"verse":10,"text":"イエスが、「今とった魚を何匹か持って来なさい」と言われた。","tok":[["イエス"],["が"],["、"],["「"],["今","いま"],["とった"],["魚","さかな"],["を"],["何匹","なんひき"],["か"],["持って","もって"],["来","き"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":11,"text":"シモン‧ペトロが舟に乗り込んで網を陸に引き上げると、百五十三匹もの大きな魚でいっぱいであった。それほど多くとれたのに、網は破れていなかった。","tok":[["シモン"],["‧"],["ペトロ"],["が"],["舟","ふね"],["に"],["乗り込んで","のりこんで"],["網","あみ"],["を"],["陸","りく"],["に"],["引き上げる","ひきあげる"],["と"],["、"],["百五十三","ひゃくごじゅうさん"],["匹","ひき"],["も"],["の"],["大きな","おおきな"],["魚","さかな"],["で"],["いっぱい"],["で"],["あった"],["。"],["それ"],["ほど"],["多く","おおく"],["とれた"],["のに"],["、"],["網","あみ"],["は"],["破れて","やぶれて"],["いなかった"],["。"]]},{"verse":12,"text":"イエスは、「さあ、来て、朝の食事をしなさい」と言われた。弟子たちはだれも、「あなたはどなたですか」と問いただそうとはしなかった。主であることを知っていたからである。","tok":[["イエス"],["は"],["、"],["「"],["さあ"],["、"],["来て","きて"],["、"],["朝","あさ"],["の"],["食事","しょくじ"],["を"],["し"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"],["弟子","でし"],["たち"],["は"],["だれ"],["も"],["、"],["「"],["あなた"],["は"],["どなた"],["です"],["か"],["」"],["と"],["問いただそう","といただそう"],["と"],["は"],["しなかった"],["。"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"イエスは来て、パンを取って弟子たちに与えられた。魚も同じようにされた。","tok":[["イエス"],["は"],["来て","きて"],["、"],["パン"],["を"],["取って","とって"],["弟子","でし"],["たち"],["に"],["与えられた","あたえられた"],["。"],["魚","さかな"],["も"],["同じ","おなじ"],["よう"],["に"],["された"],["。"]]},{"verse":14,"text":"イエスが死者の中から復活した後、弟子たちに現れたのは、これでもう三度目である。","tok":[["イエス"],["が"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["した"],["後","あと"],["、"],["弟子","でし"],["たち"],["に"],["現れた","あらわれた"],["の"],["は"],["、"],["これ"],["で"],["もう"],["三度目","さんどめ"],["で"],["ある"],["。"]]},{"verse":15,"text":"食事が終わると、イエスはシモン‧ペトロに、「ヨハネの子シモン、この人たち以上にわたしを愛しているか」と言われた。ペトロが、「はい、主よ、わたしがあなたを愛していることは、あなたがご存じです」と言うと、イエスは、「わたしの小羊を飼いなさい」と言われた。","tok":[["食事","しょくじ"],["が"],["終わる","おわる"],["と"],["、"],["イエス"],["は"],["シモン"],["‧"],["ペトロ"],["に"],["、"],["「"],["ヨハネ"],["の"],["子","こ"],["シモン"],["、"],["この"],["人","ひと"],["たち"],["以上","いじょう"],["に"],["わたし"],["を"],["愛して","あいして"],["いる"],["か"],["」"],["と"],["言われた","いわれた"],["。"],["ペトロ"],["が"],["、"],["「"],["はい"],["、"],["主","ぬし"],["よ"],["、"],["わたし"],["が"],["あなた"],["を"],["愛して","あいして"],["いる"],["こと"],["は"],["、"],["あなた"],["が"],["ご存じ","ごぞんじ"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"],["イエス"],["は"],["、"],["「"],["わたし"],["の"],["小羊","こひつじ"],["を"],["飼い","かい"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":16,"text":"二度目にイエスは言われた。「ヨハネの子シモン、わたしを愛しているか。」ペトロが、「はい、主よ、わたしがあなたを愛していることは、あなたがご存じです」と言うと、イエスは、「わたしの羊の世話をしなさい」と言われた。","tok":[["二度目","にどめ"],["に"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["ヨハネ"],["の"],["子","こ"],["シモン"],["、"],["わたし"],["を"],["愛して","あいして"],["いる"],["か"],["。"],["」"],["ペトロ"],["が"],["、"],["「"],["はい"],["、"],["主","ぬし"],["よ"],["、"],["わたし"],["が"],["あなた"],["を"],["愛して","あいして"],["いる"],["こと"],["は"],["、"],["あなた"],["が"],["ご存じ","ごぞんじ"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"],["イエス"],["は"],["、"],["「"],["わたし"],["の"],["羊","ひつじ"],["の"],["世話","せわ"],["を"],["し"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":17,"text":"三度目にイエスは言われた。「ヨハネの子シモン、わたしを愛しているか。」ペトロは、イエスが三度目も、「わたしを愛しているか」と言われたので、悲しくなった。そして言った。「主よ、あなたは何もかもご存じです。わたしがあなたを愛していることを、あなたはよく知っておられます。」イエスは言われた。「わたしの羊を飼いなさい。","tok":[["三度目","さんどめ"],["に"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["ヨハネ"],["の"],["子","こ"],["シモン"],["、"],["わたし"],["を"],["愛して","あいして"],["いる"],["か"],["。"],["」"],["ペトロ"],["は"],["、"],["イエス"],["が"],["三度目","さんどめ"],["も"],["、"],["「"],["わたし"],["を"],["愛して","あいして"],["いる"],["か"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["悲しく","かなしく"],["なった"],["。"],["そして"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["何","なん"],["も"],["か"],["も"],["ご存じ","ごぞんじ"],["です"],["。"],["わたし"],["が"],["あなた"],["を"],["愛して","あいして"],["いる"],["こと"],["を"],["、"],["あなた"],["は"],["よく"],["知って","しって"],["おられます"],["。"],["」"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["の"],["羊","ひつじ"],["を"],["飼い","かい"],["なさい"],["。"]]},{"verse":18,"text":"はっきり言っておく。あなたは、若いときは、自分で帯を締めて、行きたいところへ行っていた。しかし、年をとると、両手を伸ばして、他の人に帯を締められ、行きたくないところへ連れて行かれる。」","tok":[["はっきり"],["言って","いって"],["おく"],["。"],["あなた"],["は"],["、"],["若い","わかい"],["とき"],["は"],["、"],["自分","じぶん"],["で"],["帯","おび"],["を"],["締めて","しめて"],["、"],["行きたい","いきたい"],["ところ"],["へ"],["行って","いって"],["いた"],["。"],["しかし"],["、"],["年","とし"],["を"],["とる"],["と"],["、"],["両手","りょうて"],["を"],["伸ばして","のばして"],["、"],["他","た"],["の"],["人","ひと"],["に"],["帯","おび"],["を"],["締められ","しめられ"],["、"],["行きたく","いきたく"],["ない"],["ところ"],["へ"],["連れて","つれて"],["行かれる","いかれる"],["。"],["」"]]},{"verse":19,"text":"ペトロがどのような死に方で、神の栄光を現すようになるかを示そうとして、イエスはこう言われたのである。このように話してから、ペトロに、「わたしに従いなさい」と言われた。","tok":[["ペトロ"],["が"],["どのような"],["死に","しに"],["方","かた"],["で"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["現す","あらわす"],["よう"],["に"],["なる"],["か"],["を"],["示そう","しめそう"],["として"],["、"],["イエス"],["は"],["こう"],["言われた","いわれた"],["ので"],["ある"],["。"],["この"],["よう"],["に"],["話して","はなして"],["から"],["、"],["ペトロ"],["に"],["、"],["「"],["わたし"],["に"],["従い","したがい"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":20,"text":"ペトロが振り向くと、イエスの愛しておられた弟子がついて来るのが見えた。この弟子は、あの夕食のとき、イエスの胸もとに寄りかかったまま、「主よ、裏切るのはだれですか」と言った人である。","tok":[["ペトロ"],["が"],["振り向く","ふりむく"],["と"],["、"],["イエス"],["の"],["愛して","あいして"],["おられた"],["弟子","でし"],["が"],["ついて"],["来る","くる"],["の"],["が"],["見えた","みえた"],["。"],["この"],["弟子","でし"],["は"],["、"],["あの"],["夕食","ゆうしょく"],["の"],["とき"],["、"],["イエス"],["の"],["胸もと","むなもと"],["に"],["寄りかかった","よりかかった"],["まま"],["、"],["「"],["主","ぬし"],["よ"],["、"],["裏切る","うらぎる"],["の"],["は"],["だれ"],["です"],["か"],["」"],["と"],["言った","いった"],["人","ひと"],["で"],["ある"],["。"]]},{"verse":21,"text":"ペトロは彼を見て、「主よ、この人はどうなるのでしょうか」と言った。","tok":[["ペトロ"],["は"],["彼","かれ"],["を"],["見て","みて"],["、"],["「"],["主","ぬし"],["よ"],["、"],["この"],["人","ひと"],["は"],["どう"],["なる"],["の"],["でしょう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":22,"text":"イエスは言われた。「わたしの来るときまで彼が生きていることを、わたしが望んだとしても、あなたに何の関係があるか。あなたは、わたしに従いなさい。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["の"],["来る","くる"],["とき"],["まで"],["彼","かれ"],["が"],["生きて","いきて"],["いる"],["こと"],["を"],["、"],["わたし"],["が"],["望んだ","のぞんだ"],["として"],["も"],["、"],["あなた"],["に"],["何","なん"],["の"],["関係","かんけい"],["が"],["ある"],["か"],["。"],["あなた"],["は"],["、"],["わたし"],["に"],["従い","したがい"],["なさい"],["。"],["」"]]},{"verse":23,"text":"それで、この弟子は死なないといううわさが兄弟たちの間に広まった。しかし、イエスは、彼は死なないと言われたのではない。ただ、「わたしの来るときまで彼が生きていることを、わたしが望んだとしても、あなたに何の関係があるか」と言われたのである。","tok":[["それ"],["で"],["、"],["この"],["弟子","でし"],["は"],["死なない","しなない"],["と"],["いう"],["うわさ"],["が"],["兄弟","きょうだい"],["たち"],["の"],["間","あいだ"],["に"],["広まった","ひろまった"],["。"],["しかし"],["、"],["イエス"],["は"],["、"],["彼","かれ"],["は"],["死なない","しなない"],["と"],["言われた","いわれた"],["ので"],["は"],["ない"],["。"],["ただ"],["、"],["「"],["わたし"],["の"],["来る","くる"],["とき"],["まで"],["彼","かれ"],["が"],["生きて","いきて"],["いる"],["こと"],["を"],["、"],["わたし"],["が"],["望んだ","のぞんだ"],["として"],["も"],["、"],["あなた"],["に"],["何","なん"],["の"],["関係","かんけい"],["が"],["ある"],["か"],["」"],["と"],["言われた","いわれた"],["ので"],["ある"],["。"]]},{"verse":24,"text":"これらのことについて証しをし、それを書いたのは、この弟子である。わたしたちは、彼の証しが真実であることを知っている。","tok":[["これ"],["ら"],["の"],["こと"],["について"],["証し","あかし"],["を"],["し"],["、"],["それ"],["を"],["書いた","かいた"],["の"],["は"],["、"],["この"],["弟子","でし"],["で"],["ある"],["。"],["わたしたち"],["は"],["、"],["彼","かれ"],["の"],["証し","あかし"],["が"],["真実","しんじつ"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":25,"text":"イエスのなさったことは、このほかにも、まだたくさんある。わたしは思う。その一つ一つを書くならば、世界もその書かれた書物を収めきれないであろう。","tok":[["イエス"],["の"],["なさった"],["こと"],["は"],["、"],["この"],["ほか"],["に"],["も"],["、"],["まだ"],["たくさん"],["ある"],["。"],["わたし"],["は"],["思う","おもう"],["。"],["その"],["一","ひと"],["つ"],["一","ひと"],["つ"],["を"],["書くならば","かくならば"],["、"],["世界","せかい"],["も"],["その"],["書かれた","かかれた"],["書物","しょもつ"],["を"],["収め","おさめ"],["きれないで"],["あろう"],["。"]]}]
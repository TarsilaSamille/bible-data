[{"verse":1,"text":"さて、ファリサイ派に属する、ニコデモという人がいた。ユダヤ人たちの議員であった。","tok":[["さて"],["、"],["ファリサイ"],["派","は"],["に"],["属する","ぞくする"],["、"],["ニコデモ"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["ユダヤ人","ゆだやじん"],["たち"],["の"],["議員","ぎいん"],["で"],["あった"],["。"]]},{"verse":2,"text":"ある夜、イエスのもとに来て言った。「ラビ、わたしどもは、あなたが神のもとから来られた教師であることを知っています。神が共におられるのでなければ、あなたのなさるようなしるしを、だれも行うことはできないからです。」","tok":[["ある"],["夜","よる"],["、"],["イエス"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["ラビ"],["、"],["わたし"],["ども"],["は"],["、"],["あなた"],["が"],["神","かみ"],["の"],["もと"],["から"],["来られた","こられた"],["教師","きょうし"],["で"],["ある"],["こと"],["を"],["知って","しって"],["います"],["。"],["神","かみ"],["が"],["共","とも"],["に"],["おられる"],["ので"],["なければ"],["、"],["あなた"],["の"],["なさる"],["よう"],["な"],["しるし"],["を"],["、"],["だれ"],["も"],["行う","おこなう"],["こと"],["は"],["できない"],["から"],["です"],["。"],["」"]]},{"verse":3,"text":"イエスは答えて言われた。「はっきり言っておく。人は、新たに生まれなければ、神の国を見ることはできない。」","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["はっきり"],["言って","いって"],["おく"],["。"],["人","ひと"],["は"],["、"],["新た","あらた"],["に"],["生まれなければ","うまれなければ"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["見る","みる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":4,"text":"ニコデモは言った。「年をとった者が、どうして生まれることができましょう。もう一度母親の胎内に入って生まれることができるでしょうか。」","tok":[["ニコデモ"],["は"],["言った","いった"],["。"],["「"],["年","ねん"],["を"],["とった"],["者","もの"],["が"],["、"],["どう"],["して"],["生まれる","うまれる"],["こと"],["が"],["できましょう"],["。"],["もう"],["一度","いちど"],["母親","ははおや"],["の"],["胎内","たいない"],["に"],["入って","はいって"],["生まれる","うまれる"],["こと"],["が"],["できるでしょう"],["か"],["。"],["」"]]},{"verse":5,"text":"イエスはお答えになった。「はっきり言っておく。だれでも水と霊とによって生まれなければ、神の国に入ることはできない。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["はっきり"],["言って","いって"],["おく"],["。"],["だれ"],["で"],["も"],["水","みず"],["と"],["霊","れい"],["と"],["によって"],["生まれなければ","うまれなければ"],["、"],["神","かみ"],["の"],["国","くに"],["に"],["入る","はいる"],["こと"],["は"],["できない"],["。"]]},{"verse":6,"text":"肉から生まれたものは肉である。霊から生まれたものは霊である。","tok":[["肉","にく"],["から"],["生まれた","うまれた"],["もの"],["は"],["肉","にく"],["で"],["ある"],["。"],["霊","れい"],["から"],["生まれた","うまれた"],["もの"],["は"],["霊","れい"],["で"],["ある"],["。"]]},{"verse":7,"text":"『あなたがたは新たに生まれねばならない』とあなたに言ったことに、驚いてはならない。","tok":[["『"],["あなた"],["がた"],["は"],["新た","あらた"],["に"],["生まれねば","うまれねば"],["ならない"],["』"],["と"],["あなた"],["に"],["言った","いった"],["こと"],["に"],["、"],["驚いて","おどろいて"],["は"],["ならない"],["。"]]},{"verse":8,"text":"風は思いのままに吹く。あなたはその音を聞いても、それがどこから来て、どこへ行くかを知らない。霊から生まれた者も皆そのとおりである。」","tok":[["風","かぜ"],["は"],["思い","おもい"],["の"],["まま"],["に"],["吹く","ふく"],["。"],["あなた"],["は"],["その"],["音","おと"],["を"],["聞いて","きいて"],["も"],["、"],["それ"],["が"],["どこ"],["から"],["来て","きて"],["、"],["どこ"],["へ"],["行く","いく"],["か"],["を"],["知らない","しらない"],["。"],["霊","れい"],["から"],["生まれた","うまれた"],["者","もの"],["も"],["皆","みな"],["その"],["とおり"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"するとニコデモは、「どうして、そんなことがありえましょうか」と言った。","tok":[["する"],["と"],["ニコデモ"],["は"],["、"],["「"],["どう"],["して"],["、"],["そんな"],["こと"],["が"],["あり"],["えましょう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"イエスは答えて言われた。「あなたはイスラエルの教師でありながら、こんなことが分からないのか。","tok":[["イエス"],["は"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["イスラエル"],["の"],["教師","きょうし"],["で"],["あり"],["ながら"],["、"],["こんな"],["こと"],["が"],["分からない","わからない"],["の"],["か"],["。"]]},{"verse":11,"text":"はっきり言っておく。わたしたちは知っていることを語り、見たことを証ししているのに、あなたがたはわたしたちの証しを受け入れない。","tok":[["はっきり"],["言って","いって"],["おく"],["。"],["わたしたち"],["は"],["知って","しって"],["いる"],["こと"],["を"],["語り","かたり"],["、"],["見た","みた"],["こと"],["を"],["証し","あかし"],["して"],["いる"],["のに"],["、"],["あなた"],["がた"],["は"],["わたしたち"],["の"],["証し","あかし"],["を"],["受け入れない","うけいれない"],["。"]]},{"verse":12,"text":"わたしが地上のことを話しても信じないとすれば、天上のことを話したところで、どうして信じるだろう。","tok":[["わたし"],["が"],["地上","ちじょう"],["の"],["こと"],["を"],["話して","はなして"],["も"],["信じない","しんじない"],["と"],["すれば"],["、"],["天上","てんじょう"],["の"],["こと"],["を"],["話した","はなした"],["ところ"],["で"],["、"],["どう"],["して"],["信じるだろう","しんじるだろう"],["。"]]},{"verse":13,"text":"天から降って来た者、すなわち人の子のほかには、天に上った者はだれもいない。","tok":[["天","てん"],["から"],["降って","ふって"],["来た","きた"],["者","もの"],["、"],["すなわち"],["人","ひと"],["の"],["子","こ"],["の"],["ほか"],["に"],["は"],["、"],["天","てん"],["に"],["上った","のぼった"],["者","もの"],["は"],["だれ"],["も"],["いない"],["。"]]},{"verse":14,"text":"そして、モーセが荒れ野で蛇を上げたように、人の子も上げられねばならない。","tok":[["そして"],["、"],["モーセ"],["が"],["荒れ野","あれの"],["で"],["蛇","へび"],["を"],["上げた","あげた"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["上げられねば","あげられねば"],["ならない"],["。"]]},{"verse":15,"text":"それは、信じる者が皆、人の子によって永遠の命を得るためである。","tok":[["それ"],["は"],["、"],["信じる","しんじる"],["者","もの"],["が"],["皆","みな"],["、"],["人","ひと"],["の"],["子","こ"],["によって"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"]]},{"verse":16,"text":"神は、その独り子をお与えになったほどに、世を愛された。独り子を信じる者が一人も滅びないで、永遠の命を得るためである。","tok":[["神","かみ"],["は"],["、"],["その"],["独り子","ひとりご"],["を"],["お与え","おあたえ"],["に"],["なった"],["ほど"],["に"],["、"],["世","よ"],["を"],["愛された","あいされた"],["。"],["独り子","ひとりご"],["を"],["信じる","しんじる"],["者","もの"],["が"],["一人","ひとり"],["も"],["滅びないで","ほろびないで"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得る","える"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"神が御子を世に遣わされたのは、世を裁くためではなく、御子によって世が救われるためである。","tok":[["神","かみ"],["が"],["御子","みこ"],["を"],["世","よ"],["に"],["遣わされた","つかわされた"],["の"],["は"],["、"],["世","よ"],["を"],["裁く","さばく"],["ため"],["で"],["は"],["なく"],["、"],["御子","みこ"],["によって"],["世","よ"],["が"],["救われる","すくわれる"],["ため"],["で"],["ある"],["。"]]},{"verse":18,"text":"御子を信じる者は裁かれない。信じない者は既に裁かれている。神の独り子の名を信じていないからである。","tok":[["御子","みこ"],["を"],["信じる","しんじる"],["者","もの"],["は"],["裁かれない","さばかれない"],["。"],["信じない","しんじない"],["者","もの"],["は"],["既に","すでに"],["裁かれて","さばかれて"],["いる"],["。"],["神","かみ"],["の"],["独り子","ひとりご"],["の"],["名","な"],["を"],["信じて","しんじて"],["いない"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"光が世に来たのに、人々はその行いが悪いので、光よりも闇の方を好んだ。それが、もう裁きになっている。","tok":[["光","ひかり"],["が"],["世","よ"],["に"],["来た","きた"],["のに"],["、"],["人々","ひとびと"],["は"],["その"],["行い","おこない"],["が"],["悪い","わるい"],["ので"],["、"],["光","ひかり"],["より"],["も"],["闇","やみ"],["の"],["方","ほう"],["を"],["好んだ","このんだ"],["。"],["それ"],["が"],["、"],["もう"],["裁き","さばき"],["に"],["なって"],["いる"],["。"]]},{"verse":20,"text":"悪を行う者は皆、光を憎み、その行いが明るみに出されるのを恐れて、光の方に来ないからである。","tok":[["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["は"],["皆","みな"],["、"],["光","ひかり"],["を"],["憎み","にくみ"],["、"],["その"],["行い","おこない"],["が"],["明るみ","あかるみ"],["に"],["出される","だされる"],["の"],["を"],["恐れて","おそれて"],["、"],["光","ひかり"],["の"],["方","ほう"],["に"],["来ない","こない"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかし、真理を行う者は光の方に来る。その行いが神に導かれてなされたということが、明らかになるために。」","tok":[["しかし"],["、"],["真理","しんり"],["を"],["行う","おこなう"],["者","もの"],["は"],["光","ひかり"],["の"],["方","ほう"],["に"],["来る","くる"],["。"],["その"],["行い","おこない"],["が"],["神","かみ"],["に"],["導かれて","みちびかれて"],["なされた"],["と"],["いう"],["こと"],["が"],["、"],["明らか","あきらか"],["に"],["なる"],["ため"],["に"],["。"],["」"]]},{"verse":22,"text":"その後、イエスは弟子たちとユダヤ地方に行って、そこに一緒に滞在し、洗礼を授けておられた。","tok":[["その"],["後","ご"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["ユダヤ"],["地方","ちほう"],["に"],["行って","いって"],["、"],["そこ"],["に"],["一緒","いっしょ"],["に"],["滞在","たいざい"],["し"],["、"],["洗礼","せんれい"],["を"],["授けて","さずけて"],["おられた"],["。"]]},{"verse":23,"text":"他方、ヨハネは、サリムの近くのアイノンで洗礼を授けていた。そこは水が豊かであったからである。人々は来て、洗礼を受けていた。","tok":[["他方","たほう"],["、"],["ヨハネ"],["は"],["、"],["サリム"],["の"],["近く","ちかく"],["の"],["アイノン"],["で"],["洗礼","せんれい"],["を"],["授けて","さずけて"],["いた"],["。"],["そこ"],["は"],["水","みず"],["が"],["豊か","ゆたか"],["で"],["あった"],["から"],["で"],["ある"],["。"],["人々","ひとびと"],["は"],["来て","きて"],["、"],["洗礼","せんれい"],["を"],["受けて","うけて"],["いた"],["。"]]},{"verse":24,"text":"ヨハネはまだ投獄されていなかったのである。","tok":[["ヨハネ"],["は"],["まだ"],["投獄","とうごく"],["されて"],["いなかった"],["ので"],["ある"],["。"]]},{"verse":25,"text":"ところがヨハネの弟子たちと、あるユダヤ人との間で、清めのことで論争が起こった。","tok":[["ところ"],["が"],["ヨハネ"],["の"],["弟子","でし"],["たち"],["と"],["、"],["ある"],["ユダヤ人","ゆだやじん"],["と"],["の"],["間","あいだ"],["で"],["、"],["清め","きよめ"],["の"],["こと"],["で"],["論争","ろんそう"],["が"],["起こった","おこった"],["。"]]},{"verse":26,"text":"彼らはヨハネのもとに来て言った。「ラビ、ヨルダン川の向こう側であなたと一緒にいた人、あなたが証しされたあの人が、洗礼を授けています。みんながあの人の方へ行っています。」","tok":[["彼","かれ"],["ら"],["は"],["ヨハネ"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["ラビ"],["、"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["で"],["あなた"],["と"],["一緒","いっしょ"],["に"],["いた"],["人","ひと"],["、"],["あなた"],["が"],["証し","あかし"],["された"],["あの"],["人","ひと"],["が"],["、"],["洗礼","せんれい"],["を"],["授けて","さずけて"],["います"],["。"],["みんな"],["が"],["あの"],["人","ひと"],["の"],["方","ほう"],["へ"],["行って","いって"],["います"],["。"],["」"]]},{"verse":27,"text":"ヨハネは答えて言った。「天から与えられなければ、人は何も受けることができない。","tok":[["ヨハネ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["天","てん"],["から"],["与えられなければ","あたえられなければ"],["、"],["人","ひと"],["は"],["何","なん"],["も"],["受ける","うける"],["こと"],["が"],["できない"],["。"]]},{"verse":28,"text":"わたしは、『自分はメシアではない』と言い、『自分はあの方の前に遣わされた者だ』と言ったが、そのことについては、あなたたち自身が証ししてくれる。","tok":[["わたし"],["は"],["、"],["『"],["自分","じぶん"],["は"],["メシア"],["で"],["は"],["ない"],["』"],["と"],["言い","いい"],["、"],["『"],["自分","じぶん"],["は"],["あの"],["方","かた"],["の"],["前","まえ"],["に"],["遣わされた","つかわされた"],["者","もの"],["だ"],["』"],["と"],["言った","いった"],["が"],["、"],["その"],["こと"],["について"],["は"],["、"],["あなた"],["たち"],["自身","じしん"],["が"],["証し","あかし"],["して"],["くれる"],["。"]]},{"verse":29,"text":"花嫁を迎えるのは花婿だ。花婿の介添え人はそばに立って耳を傾け、花婿の声が聞こえると大いに喜ぶ。だから、わたしは喜びで満たされている。","tok":[["花嫁","はなよめ"],["を"],["迎える","むかえる"],["の"],["は"],["花婿","はなむこ"],["だ"],["。"],["花婿","はなむこ"],["の"],["介添え人","かいぞえにん"],["は"],["そば"],["に"],["立って","たって"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["花婿","はなむこ"],["の"],["声","こえ"],["が"],["聞こえる","きこえる"],["と"],["大いに","おおいに"],["喜ぶ","よろこぶ"],["。"],["だ"],["から"],["、"],["わたし"],["は"],["喜び","よろこび"],["で"],["満たされて","みたされて"],["いる"],["。"]]},{"verse":30,"text":"あの方は栄え、わたしは衰えねばならない。」","tok":[["あの"],["方","かた"],["は"],["栄え","さかえ"],["、"],["わたし"],["は"],["衰えねば","おとろえねば"],["ならない"],["。"],["」"]]},{"verse":31,"text":"「上から来られる方は、すべてのものの上におられる。地から出る者は地に属し、地に属する者として語る。天から来られる方は、すべてのものの上におられる。","tok":[["「"],["上","うえ"],["から"],["来られる","こられる"],["方","かた"],["は"],["、"],["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["おられる"],["。"],["地","ち"],["から"],["出る","でる"],["者","もの"],["は"],["地","ち"],["に"],["属し","ぞくし"],["、"],["地","ち"],["に"],["属する","ぞくする"],["者","もの"],["として"],["語る","かたる"],["。"],["天","てん"],["から"],["来られる","こられる"],["方","かた"],["は"],["、"],["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["おられる"],["。"]]},{"verse":32,"text":"この方は、見たこと、聞いたことを証しされるが、だれもその証しを受け入れない。","tok":[["この"],["方","かた"],["は"],["、"],["見た","みた"],["こと"],["、"],["聞いた","きいた"],["こと"],["を"],["証し","あかし"],["される"],["が"],["、"],["だれ"],["も"],["その"],["証し","あかし"],["を"],["受け入れない","うけいれない"],["。"]]},{"verse":33,"text":"その証しを受け入れる者は、神が真実であることを確認したことになる。","tok":[["その"],["証し","あかし"],["を"],["受け入れる","うけいれる"],["者","もの"],["は"],["、"],["神","かみ"],["が"],["真実","しんじつ"],["で"],["ある"],["こと"],["を"],["確認","かくにん"],["した"],["こと"],["に"],["なる"],["。"]]},{"verse":34,"text":"神がお遣わしになった方は、神の言葉を話される。神が“霊”を限りなくお与えになるからである。","tok":[["神","かみ"],["が"],["お遣わし","おつかわし"],["に"],["なった"],["方","ほう"],["は"],["、"],["神","かみ"],["の"],["言葉","ことば"],["を"],["話される","はなされる"],["。"],["神","かみ"],["が"],["“"],["霊","れい"],["”"],["を"],["限りなく","かぎりなく"],["お与え","おあたえ"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":35,"text":"御父は御子を愛して、その手にすべてをゆだねられた。","tok":[["御父","おちち"],["は"],["御子","みこ"],["を"],["愛して","あいして"],["、"],["その"],["手","て"],["に"],["すべて"],["を"],["ゆだねられた"],["。"]]},{"verse":36,"text":"御子を信じる人は永遠の命を得ているが、御子に従わない者は、命にあずかることがないばかりか、神の怒りがその上にとどまる。」","tok":[["御子","みこ"],["を"],["信じる","しんじる"],["人","ひと"],["は"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得て","えて"],["いる"],["が"],["、"],["御子","みこ"],["に"],["従わない","したがわない"],["者","もの"],["は"],["、"],["命","いのち"],["に"],["あずかる"],["こと"],["が"],["ない"],["ばかり"],["か"],["、"],["神","かみ"],["の"],["怒り","いかり"],["が"],["その"],["上","うえ"],["に"],["とどまる"],["。"],["」"]]}]
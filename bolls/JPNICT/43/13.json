[{"verse":1,"text":"さて、過越祭の前のことである。イエスは、この世から父のもとへ移る御自分の時が来たことを悟り、世にいる弟子たちを愛して、この上なく愛し抜かれた。","tok":[["さて"],["、"],["過越","すぎこし"],["祭","まつり"],["の"],["前","まえ"],["の"],["こと"],["で"],["ある"],["。"],["イエス"],["は"],["、"],["この世","このよ"],["から"],["父","ちち"],["の"],["もと"],["へ"],["移る","うつる"],["御自分","ごじぶん"],["の"],["時","とき"],["が"],["来た","きた"],["こと"],["を"],["悟り","さとり"],["、"],["世","よ"],["に"],["いる"],["弟子","でし"],["たち"],["を"],["愛して","あいして"],["、"],["この"],["上","うえ"],["なく"],["愛し","あいし"],["抜かれた","ぬかれた"],["。"]]},{"verse":2,"text":"夕食のときであった。既に悪魔は、イスカリオテのシモンの子ユダに、イエスを裏切る考えを抱かせていた。","tok":[["夕食","ゆうしょく"],["の"],["とき"],["で"],["あった"],["。"],["既に","すでに"],["悪魔","あくま"],["は"],["、"],["イスカリオテ"],["の"],["シモン"],["の"],["子","こ"],["ユダ"],["に"],["、"],["イエス"],["を"],["裏切る","うらぎる"],["考え","かんがえ"],["を"],["抱かせて","いだかせて"],["いた"],["。"]]},{"verse":3,"text":"イエスは、父がすべてを御自分の手にゆだねられたこと、また、御自分が神のもとから来て、神のもとに帰ろうとしていることを悟り、","tok":[["イエス"],["は"],["、"],["父","ちち"],["が"],["すべて"],["を"],["御自分","ごじぶん"],["の"],["手","て"],["に"],["ゆだねられた"],["こと"],["、"],["また"],["、"],["御自分","ごじぶん"],["が"],["神","かみ"],["の"],["もと"],["から"],["来て","きて"],["、"],["神","かみ"],["の"],["もと"],["に"],["帰ろう","かえろう"],["として"],["いる"],["こと"],["を"],["悟り","さとり"],["、"]]},{"verse":4,"text":"食事の席から立ち上がって上着を脱ぎ、手ぬぐいを取って腰にまとわれた。","tok":[["食事","しょくじ"],["の"],["席","せき"],["から"],["立ち上がって","たちあがって"],["上着","うわぎ"],["を"],["脱ぎ","ぬぎ"],["、"],["手ぬぐい","てぬぐい"],["を"],["取って","とって"],["腰","こし"],["に"],["まとわれた"],["。"]]},{"verse":5,"text":"それから、たらいに水をくんで弟子たちの足を洗い、腰にまとった手ぬぐいでふき始められた。","tok":[["それ"],["から"],["、"],["たらい"],["に"],["水","みず"],["を"],["くんで"],["弟子","でし"],["たち"],["の"],["足","あし"],["を"],["洗い","あらい"],["、"],["腰","こし"],["に"],["まとった"],["手ぬぐい","てぬぐい"],["で"],["ふき"],["始められた","はじめられた"],["。"]]},{"verse":6,"text":"シモン‧ペトロのところに来ると、ペトロは、「主よ、あなたがわたしの足を洗ってくださるのですか」と言った。","tok":[["シモン"],["‧"],["ペトロ"],["の"],["ところ"],["に"],["来る","くる"],["と"],["、"],["ペトロ"],["は"],["、"],["「"],["主","ぬし"],["よ"],["、"],["あなた"],["が"],["わたし"],["の"],["足","あし"],["を"],["洗って","あらって"],["くださる"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"イエスは答えて、「わたしのしていることは、今あなたには分かるまいが、後で、分かるようになる」と言われた。","tok":[["イエス"],["は"],["答えて","こたえて"],["、"],["「"],["わたし"],["の"],["して"],["いる"],["こと"],["は"],["、"],["今","いま"],["あなた"],["に"],["は"],["分かるまい","わかるまい"],["が"],["、"],["後","あと"],["で"],["、"],["分かる","わかる"],["よう"],["に"],["なる"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"ペトロが、「わたしの足など、決して洗わないでください」と言うと、イエスは、「もしわたしがあなたを洗わないなら、あなたはわたしと何のかかわりもないことになる」と答えられた。","tok":[["ペトロ"],["が"],["、"],["「"],["わたし"],["の"],["足","あし"],["など"],["、"],["決して","けっして"],["洗わないで","あらわないで"],["ください"],["」"],["と"],["言う","ゆう"],["と"],["、"],["イエス"],["は"],["、"],["「"],["もし"],["わたし"],["が"],["あなた"],["を"],["洗わないなら","あらわないなら"],["、"],["あなた"],["は"],["わたし"],["と"],["何","なん"],["の"],["かかわり"],["も"],["ない"],["こと"],["に"],["なる"],["」"],["と"],["答えられた","こたえられた"],["。"]]},{"verse":9,"text":"そこでシモン‧ペトロが言った。「主よ、足だけでなく、手も頭も。」","tok":[["そこ"],["で"],["シモン"],["‧"],["ペトロ"],["が"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["足","あし"],["だけ"],["で"],["なく"],["、"],["手","て"],["も"],["頭","あたま"],["も"],["。"],["」"]]},{"verse":10,"text":"イエスは言われた。「既に体を洗った者は、全身清いのだから、足だけ洗えばよい。あなたがたは清いのだが、皆が清いわけではない。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["既に","すでに"],["体","からだ"],["を"],["洗った","あらった"],["者","もの"],["は"],["、"],["全身","ぜんしん"],["清い","きよい"],["の"],["だ"],["から"],["、"],["足","あし"],["だけ"],["洗えば","あらえば"],["よい"],["。"],["あなた"],["がた"],["は"],["清い","きよい"],["の"],["だ"],["が"],["、"],["皆","みな"],["が"],["清い","きよい"],["わけ"],["で"],["は"],["ない"],["。"],["」"]]},{"verse":11,"text":"イエスは、御自分を裏切ろうとしている者がだれであるかを知っておられた。それで、「皆が清いわけではない」と言われたのである。","tok":[["イエス"],["は"],["、"],["御自分","ごじぶん"],["を"],["裏切ろう","うらぎろう"],["として"],["いる"],["者","もの"],["が"],["だれ"],["で"],["ある"],["か"],["を"],["知って","しって"],["おられた"],["。"],["それ"],["で"],["、"],["「"],["皆","みな"],["が"],["清い","きよい"],["わけ"],["で"],["は"],["ない"],["」"],["と"],["言われた","いわれた"],["ので"],["ある"],["。"]]},{"verse":12,"text":"さて、イエスは、弟子たちの足を洗ってしまうと、上着を着て、再び席に着いて言われた。「わたしがあなたがたにしたことが分かるか。","tok":[["さて"],["、"],["イエス"],["は"],["、"],["弟子","でし"],["たち"],["の"],["足","あし"],["を"],["洗って","あらって"],["しまう"],["と"],["、"],["上着","うわぎ"],["を"],["着て","きて"],["、"],["再び","ふたたび"],["席","せき"],["に"],["着いて","ついて"],["言われた","いわれた"],["。"],["「"],["わたし"],["が"],["あなた"],["がた"],["に"],["した"],["こと"],["が"],["分かる","わかる"],["か"],["。"]]},{"verse":13,"text":"あなたがたは、わたしを『先生』とか『主』とか呼ぶ。そのように言うのは正しい。わたしはそうである。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["を"],["『"],["先生","せんせい"],["』"],["と"],["か"],["『"],["主","しゅ"],["』"],["と"],["か"],["呼ぶ","よぶ"],["。"],["その"],["よう"],["に"],["言う","いう"],["の"],["は"],["正しい","ただしい"],["。"],["わたし"],["は"],["そう"],["で"],["ある"],["。"]]},{"verse":14,"text":"ところで、主であり、師であるわたしがあなたがたの足を洗ったのだから、あなたがたも互いに足を洗い合わなければならない。","tok":[["ところ"],["で"],["、"],["主","ぬし"],["で"],["あり"],["、"],["師","し"],["で"],["ある"],["わたし"],["が"],["あなた"],["がた"],["の"],["足","あし"],["を"],["洗った","あらった"],["の"],["だ"],["から"],["、"],["あなた"],["がた"],["も"],["互い","たがい"],["に"],["足","あし"],["を"],["洗い合わなければ","あらいあわなければ"],["ならない"],["。"]]},{"verse":15,"text":"わたしがあなたがたにしたとおりに、あなたがたもするようにと、模範を示したのである。","tok":[["わたし"],["が"],["あなた"],["がた"],["に"],["した"],["とおり"],["に"],["、"],["あなた"],["がた"],["も"],["する"],["よう"],["に"],["と"],["、"],["模範","もはん"],["を"],["示した","しめした"],["ので"],["ある"],["。"]]},{"verse":16,"text":"はっきり言っておく。僕は主人にまさらず、遣わされた者は遣わした者にまさりはしない。","tok":[["はっきり"],["言って","いって"],["おく"],["。"],["僕","ぼく"],["は"],["主人","しゅじん"],["に"],["まさらず"],["、"],["遣わされた","つかわされた"],["者","もの"],["は"],["遣わした","つかわした"],["者","もの"],["に"],["まさり"],["は"],["しない"],["。"]]},{"verse":17,"text":"このことが分かり、そのとおりに実行するなら、幸いである。","tok":[["この"],["こと"],["が"],["分かり","わかり"],["、"],["その"],["とおり"],["に"],["実行","じっこう"],["するなら"],["、"],["幸い","さいわい"],["で"],["ある"],["。"]]},{"verse":18,"text":"わたしは、あなたがた皆について、こう言っているのではない。わたしは、どのような人々を選び出したか分かっている。しかし、『わたしのパンを食べている者が、わたしに逆らった』という聖書の言葉は実現しなければならない。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["皆","みな"],["について"],["、"],["こう"],["言って","いって"],["いる"],["ので"],["は"],["ない"],["。"],["わたし"],["は"],["、"],["どのような"],["人々","ひとびと"],["を"],["選び出した","えらびだした"],["か"],["分かって","わかって"],["いる"],["。"],["しかし"],["、"],["『"],["わたし"],["の"],["パン"],["を"],["食べて","たべて"],["いる"],["者","もの"],["が"],["、"],["
"],["と"],["尋ねる","たずねる"],["よう"],["に"],["合図","あいず"],["した"],["。"]]},{"verse":25,"text":"その弟子が、イエスの胸もとに寄りかかったまま、「主よ、それはだれのことですか」と言うと、","tok":[["その"],["弟子","でし"],["が"],["、"],["イエス"],["の"],["胸もと","むなもと"],["に"],["寄りかかった","よりかかった"],["まま"],["、"],["「"],["主","ぬし"],["よ"],["、"],["それ"],["は"],["だれ"],["の"],["こと"],["です"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":26,"text":"イエスは、「わたしがパン切れを浸して与えるのがその人だ」と答えられた。それから、パン切れを浸して取り、イスカリオテのシモンの子ユダにお与えになった。","tok":[["イエス"],["は"],["、"],["「"],["わたし"],["が"],["パン"],["切れ","きれ"],["を"],["浸して","ひたして"],["与える","あたえる"],["の"],["が"],["その"],["人","ひと"],["だ"],["」"],["と"],["答えられた","こたえられた"],["。"],["それ"],["から"],["、"],["パン"],["切れ","きれ"],["を"],["浸して","ひたして"],["取り","とり"],["、"],["イスカリオテ"],["の"],["シモン"],["の"],["子","こ"],["ユダ"],["に"],["お与え","おあたえ"],["に"],["なった"],["。"]]},{"verse":27,"text":"ユダがパン切れを受け取ると、サタンが彼の中に入った。そこでイエスは、「しようとしていることを、今すぐ、しなさい」と彼に言われた。","tok":[["ユダ"],["が"],["パン"],["切れ","きれ"],["を"],["受け取る","うけとる"],["と"],["、"],["サタン"],["が"],["彼","かれ"],["の"],["中","なか"],["に"],["入った","はいった"],["。"],["そこ"],["で"],["イエス"],["は"],["、"],["「"],["しよう"],["として"],["いる"],["こと"],["を"],["、"],["今","いま"],["すぐ"],["、"],["し"],["なさい"],["」"],["と"],["彼","かれ"],["に"],["言われた","いわれた"],["。"]]},{"verse":28,"text":"座に着いていた者はだれも、なぜユダにこう言われたのか分からなかった。","tok":[["座","ざ"],["に"],["着いて","ついて"],["いた"],["者","もの"],["は"],["だれ"],["も"],["、"],["なぜ"],["ユダ"],["に"],["こう"],["言われた","いわれた"],["の"],["か"],["分からなかった","わからなかった"],["。"]]},{"verse":29,"text":"ある者は、ユダが金入れを預かっていたので、「祭りに必要な物を買いなさい」とか、貧しい人に何か施すようにと、イエスが言われたのだと思っていた。","tok":[["ある"],["者","もの"],["は"],["、"],["ユダ"],["が"],["金入れ","かねいれ"],["を"],["預かって","あずかって"],["いた"],["ので"],["、"],["「"],["祭り","まつり"],["に"],["必要","ひつよう"],["な"],["物","もの"],["を"],["買い","かい"],["なさい"],["」"],["と"],["か"],["、"],["貧しい","まずしい"],["人","ひと"],["に"],["何","なん"],["か"],["施す","ほどこす"],["よう"],["に"],["と"],["、"],["イエス"],["が"],["言われた","いわれた"],["の"],["だ"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":30,"text":"ユダはパン切れを受け取ると、すぐ出て行った。夜であった。","tok":[["ユダ"],["は"],["パン"],["切れ","きれ"],["を"],["受け取る","うけとる"],["と"],["、"],["すぐ"],["出て","でて"],["行った","いった"],["。"],["夜","よる"],["で"],["あった"],["。"]]},{"verse":31,"text":"さて、ユダが出て行くと、イエスは言われた。「今や、人の子は栄光を受けた。神も人の子によって栄光をお受けになった。","tok":[["さて"],["、"],["ユダ"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["今","いま"],["や"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["栄光","えいこう"],["を"],["受けた","うけた"],["。"],["神","かみ"],["も"],["人","ひと"],["の"],["子","こ"],["によって"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なった"],["。"]]},{"verse":32,"text":"神が人の子によって栄光をお受けになったのであれば、神も御自身によって人の子に栄光をお与えになる。しかも、すぐにお与えになる。","tok":[["神","かみ"],["が"],["人","ひと"],["の"],["子","こ"],["によって"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なった"],["ので"],["あれば"],["、"],["神","かみ"],["も"],["御自身","ごじしん"],["によって"],["人","ひと"],["の"],["子","こ"],["に"],["栄光","えいこう"],["を"],["お与え","おあたえ"],["に"],["なる"],["。"],["しかも"],["、"],["すぐ"],["に"],["お与え","おあたえ"],["に"],["なる"],["。"]]},{"verse":33,"text":"子たちよ、いましばらく、わたしはあなたがたと共にいる。あなたがたはわたしを捜すだろう。『わたしが行く所にあなたたちは来ることができない』とユダヤ人たちに言ったように、今、あなたがたにも同じことを言っておく。","tok":[["子","こ"],["たち"],["よ"],["、"],["いま"],["しばらく"],["、"],["わたし"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いる"],["。"],["あなた"],["がた"],["は"],["わたし"],["を"],["捜すだろう","さがすだろう"],["。"],["『"],["わたし"],["が"],["行く","いく"],["所","ところ"],["に"],["あなた"],["たち"],["は"],["来る","くる"],["こと"],["が"],["できない"],["』"],["と"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["言った","いった"],["よう"],["に"],["、"],["今","いま"],["、"],["あなた"],["がた"],["に"],["も"],["同じ","おなじ"],["こと"],["を"],["言って","いって"],["おく"],["。"]]},{"verse":34,"text":"あなたがたに新しい掟を与える。互いに愛し合いなさい。わたしがあなたがたを愛したように、あなたがたも互いに愛し合いなさい。","tok":[["あなた"],["がた"],["に"],["新しい","あたらしい"],["掟","おきて"],["を"],["与える","あたえる"],["。"],["互い","たがい"],["に"],["愛し合い","あいしあい"],["なさい"],["。"],["わたし"],["が"],["あなた"],["がた"],["を"],["愛した","あいした"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["互い","たがい"],["に"],["愛し合い","あいしあい"],["なさい"],["。"]]},{"verse":35,"text":"互いに愛し合うならば、それによってあなたがたがわたしの弟子であることを、皆が知るようになる。」","tok":[["互い","たがい"],["に"],["愛し合うならば","あいしあうならば"],["、"],["それ"],["によって"],["あなた"],["がた"],["が"],["わたし"],["の"],["弟子","でし"],["で"],["ある"],["こと"],["を"],["、"],["皆","みな"],["が"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":36,"text":"シモン‧ペトロがイエスに言った。「主よ、どこへ行かれるのですか。」イエスが答えられた。「わたしの行く所に、あなたは今ついて来ることはできないが、後でついて来ることになる。」","tok":[["シモン"],["‧"],["ペトロ"],["が"],["イエス"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["どこ"],["へ"],["行かれる","いかれる"],["の"],["です"],["か"],["。"],["」"],["イエス"],["が"],["答えられた","こたえられた"],["。"],["「"],["わたし"],["の"],["行く","いく"],["所","ところ"],["に"],["、"],["あなた"],["は"],["今","いま"],["ついて"],["来る","くる"],["こと"],["は"],["できない"],["が"],["、"],["後","あと"],["で"],["ついて"],["来る","くる"],["こと"],["に"],["なる"],["。"],["」"]]},{"verse":37,"text":"ペトロは言った。「主よ、なぜ今ついて行けないのですか。あなたのためなら命を捨てます。」","tok":[["ペトロ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["なぜ"],["今","いま"],["ついて"],["行けない","いけない"],["の"],["です"],["か"],["。"],["あなた"],["の"],["ため"],["なら"],["命","いのち"],["を"],["捨てます","すてます"],["。"],["」"]]},{"verse":38,"text":"イエスは答えられた。「わたしのために命を捨てると言うのか。はっきり言っておく。鶏が鳴くまでに、あなたは三度わたしのことを知らないと言うだろう。」","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["わたし"],["の"],["ため"],["に"],["命","いのち"],["を"],["捨てる","すてる"],["と"],["言う","いう"],["の"],["か"],["。"],["はっきり"],["言って","いって"],["おく"],["。"],["鶏","にわとり"],["が"],["鳴く","なく"],["まで"],["に"],["、"],["あなた"],["は"],["三","さん"],["度","ど"],["わたし"],["の"],["こと"],["を"],["知らない","しらない"],["と"],["言うだろう","ゆうだろう"],["。"],["」"]]}]
[{"verse":1,"text":"ある病人がいた。マリアとその姉妹マルタの村、ベタニアの出身で、ラザロといった。","tok":[["ある"],["病人","びょうにん"],["が"],["いた"],["。"],["マリア"],["と"],["その"],["姉妹","しまい"],["マルタ"],["の"],["村","むら"],["、"],["ベタニア"],["の"],["出身","しゅっしん"],["で"],["、"],["ラザロ"],["と"],["いった"],["。"]]},{"verse":2,"text":"このマリアは主に香油を塗り、髪の毛で主の足をぬぐった女である。その兄弟ラザロが病気であった。","tok":[["この"],["マリア"],["は"],["主に","おもに"],["香油","こうゆ"],["を"],["塗り","ぬり"],["、"],["髪の毛","かみのけ"],["で"],["主","ぬし"],["の"],["足","あし"],["を"],["ぬぐった"],["女","おんな"],["で"],["ある"],["。"],["その"],["兄弟","きょうだい"],["ラザロ"],["が"],["病気","びょうき"],["で"],["あった"],["。"]]},{"verse":3,"text":"姉妹たちはイエスのもとに人をやって、「主よ、あなたの愛しておられる者が病気なのです」と言わせた。","tok":[["姉妹","しまい"],["たち"],["は"],["イエス"],["の"],["もと"],["に"],["人","ひと"],["を"],["やって"],["、"],["「"],["主","ぬし"],["よ"],["、"],["あなた"],["の"],["愛して","あいして"],["おられる"],["者","もの"],["が"],["病気","びょうき"],["な"],["の"],["です"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":4,"text":"イエスは、それを聞いて言われた。「この病気は死で終わるものではない。神の栄光のためである。神の子がそれによって栄光を受けるのである。」","tok":[["イエス"],["は"],["、"],["それ"],["を"],["聞いて","きいて"],["言われた","いわれた"],["。"],["「"],["この"],["病気","びょうき"],["は"],["死","し"],["で"],["終わる","おわる"],["もの"],["で"],["は"],["ない"],["。"],["神","かみ"],["の"],["栄光","えいこう"],["の"],["ため"],["で"],["ある"],["。"],["神","かみ"],["の"],["子","こ"],["が"],["それ"],["によって"],["栄光","えいこう"],["を"],["受ける","うける"],["ので"],["ある"],["。"],["」"]]},{"verse":5,"text":"イエスは、マルタとその姉妹とラザロを愛しておられた。","tok":[["イエス"],["は"],["、"],["マルタ"],["と"],["その"],["姉妹","しまい"],["と"],["ラザロ"],["を"],["愛して","あいして"],["おられた"],["。"]]},{"verse":6,"text":"ラザロが病気だと聞いてからも、なお二日間同じ所に滞在された。","tok":[["ラザロ"],["が"],["病気","びょうき"],["だ"],["と"],["聞いて","きいて"],["から"],["も"],["、"],["なお"],["二","ふた"],["日間","かかん"],["同じ","おなじ"],["所","ところ"],["に"],["滞在","たいざい"],["された"],["。"]]},{"verse":7,"text":"それから、弟子たちに言われた。「もう一度、ユダヤに行こう。」","tok":[["それ"],["から"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["もう"],["一度","いちど"],["、"],["ユダヤ"],["に"],["行こう","いこう"],["。"],["」"]]},{"verse":8,"text":"弟子たちは言った。「ラビ、ユダヤ人たちがついこの間もあなたを石で打ち殺そうとしたのに、またそこへ行かれるのですか。」","tok":[["弟子","でし"],["たち"],["は"],["言った","いった"],["。"],["「"],["ラビ"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["つい"],["この"],["間","ま"],["も"],["あなた"],["を"],["石","いし"],["で"],["打ち殺そう","うちころそう"],["と"],["した"],["のに"],["、"],["また"],["そこ"],["へ"],["行かれる","いかれる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":9,"text":"イエスはお答えになった。「昼間は十二時間あるではないか。昼のうちに歩けば、つまずくことはない。この世の光を見ているからだ。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["昼間","ひるま"],["は"],["十二","じゅうに"],["時間","じかん"],["ある"],["で"],["は"],["ない"],["か"],["。"],["昼","ひる"],["の"],["うち"],["に"],["歩けば","あるけば"],["、"],["つまずく"],["こと"],["は"],["ない"],["。"],["この世","このよ"],["の"],["光","ひかり"],["を"],["見て","みて"],["いる"],["から"],["だ"],["。"]]},{"verse":10,"text":"しかし、夜歩けば、つまずく。その人の内に光がないからである。」","tok":[["しかし"],["、"],["夜","よる"],["歩けば","あるけば"],["、"],["つまずく"],["。"],["その"],["人","ひと"],["の"],["内","うち"],["に"],["光","ひかり"],["が"],["ない"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":11,"text":"こうお話しになり、また、その後で言われた。「わたしたちの友ラザロが眠っている。しかし、わたしは彼を起こしに行く。」","tok":[["こう"],["お話し","おはなし"],["に"],["なり"],["、"],["また"],["、"],["その後","そのあと"],["で"],["言われた","いわれた"],["。"],["「"],["わたしたち"],["の"],["友","とも"],["ラザロ"],["が"],["眠って","ねむって"],["いる"],["。"],["しかし"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["起こし","おこし"],["に"],["行く","いく"],["。"],["」"]]},{"verse":12,"text":"弟子たちは、「主よ、眠っているのであれば、助かるでしょう」と言った。","tok":[["弟子","でし"],["たち"],["は"],["、"],["「"],["主","ぬし"],["よ"],["、"],["眠って","ねむって"],["いる"],["ので"],["あれば"],["、"],["助かるでしょう","たすかるでしょう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"イエスはラザロの死について話されたのだが、弟子たちは、ただ眠りについて話されたものと思ったのである。","tok":[["イエス"],["は"],["ラザロ"],["の"],["死","し"],["について"],["話された","はなされた"],["の"],["だ"],["が"],["、"],["弟子","でし"],["たち"],["は"],["、"],["ただ"],["眠り","ねむり"],["について"],["話された","はなされた"],["もの"],["と"],["思った","おもった"],["ので"],["ある"],["。"]]},{"verse":14,"text":"そこでイエスは、はっきりと言われた。「ラザロは死んだのだ。","tok":[["そこ"],["で"],["イエス"],["は"],["、"],["はっきり"],["と"],["言われた","いわれた"],["。"],["「"],["ラザロ"],["は"],["死んだ","しんだ"],["の"],["だ"],["。"]]},{"verse":15,"text":"わたしがその場に居合わせなかったのは、あなたがたにとってよかった。あなたがたが信じるようになるためである。さあ、彼のところへ行こう。」","tok":[["わたし"],["が"],["その"],["場","ば"],["に"],["居合わせなかった","いあわせなかった"],["の"],["は"],["、"],["あなた"],["がた"],["にとって"],["よかった"],["。"],["あなた"],["がた"],["が"],["信じる","しんじる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"],["さあ"],["、"],["彼","かれ"],["の"],["ところ"],["へ"],["行こう","いこう"],["。"],["」"]]},{"verse":16,"text":"すると、ディディモと呼ばれるトマスが、仲間の弟子たちに、「わたしたちも行って、一緒に死のうではないか」と言った。","tok":[["する"],["と"],["、"],["ディディモ"],["と"],["呼ばれる","よばれる"],["トマス"],["が"],["、"],["仲間","なかま"],["の"],["弟子","でし"],["たち"],["に"],["、"],["「"],["わたしたち"],["も"],["行って","いって"],["、"],["一緒","いっしょ"],["に"],["死のうで","しのうで"],["は"],["ない"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"さて、イエスが行って御覧になると、ラザロは墓に葬られて既に四日もたっていた。","tok":[["さて"],["、"],["イエス"],["が"],["行って","いって"],["御覧","ごらん"],["に"],["なる"],["と"],["、"],["ラザロ"],["は"],["墓","はか"],["に"],["葬られて","ほうむられて"],["既に","すでに"],["四日","よんか"],["も"],["たって"],["いた"],["。"]]},{"verse":18,"text":"ベタニアはエルサレムに近く、十五スタディオンほどのところにあった。","tok":[["ベタニア"],["は"],["エルサレム"],["に"],["近く","ちかく"],["、"],["十五","じゅうご"],["スタディオン"],["ほど"],["の"],["ところ"],["に"],["あった"],["。"]]},{"verse":19,"text":"マルタとマリアのところには、多くのユダヤ人が、兄弟ラザロのことで慰めに来ていた。","tok":[["マルタ"],["と"],["マリア"],["の"],["ところ"],["に"],["は"],["、"],["多く","おおく"],["の"],["ユダヤ人","ゆだやじん"],["が"],["、"],["兄弟","きょうだい"],["ラザロ"],["の"],["こと"],["で"],["慰め","なぐさめ"],["に"],["来て","きて"],["いた"],["。"]]},{"verse":20,"text":"マルタは、イエスが来られたと聞いて、迎えに行ったが、マリアは家の中に座っていた。","tok":[["マルタ"],["は"],["、"],["イエス"],["が"],["来られた","こられた"],["と"],["聞いて","きいて"],["、"],["迎え","むかえ"],["に"],["行った","いった"],["が"],["、"],["マリア"],["は"],["家","いえ"],["の"],["中","なか"],["に"],["座って","すわって"],["いた"],["。"]]},{"verse":21,"text":"マルタはイエスに言った。「主よ、もしここにいてくださいましたら、わたしの兄弟は死ななかったでしょうに。","tok":[["マルタ"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["もし"],["ここ"],["に"],["いて"],["くださいましたら"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["は"],["死ななかったでしょう","しななかったでしょう"],["に"],["。"]]},{"verse":22,"text":"しかし、あなたが神にお願いになることは何でも神はかなえてくださると、わたしは今でも承知しています。」","tok":[["しかし"],["、"],["あなた"],["が"],["神","かみ"],["に"],["お願い","おねがい"],["に"],["なる"],["こ
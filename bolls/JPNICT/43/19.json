[{"verse":1,"text":"そこで、ピラトはイエスを捕らえ、鞭で打たせた。","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["イエス"],["を"],["捕らえ","とらえ"],["、"],["鞭","むち"],["で"],["打たせた","うたせた"],["。"]]},{"verse":2,"text":"兵士たちは茨で冠を編んでイエスの頭に載せ、紫の服をまとわせ、","tok":[["兵士","へいし"],["たち"],["は"],["茨","うばら"],["で"],["冠","かんむり"],["を"],["編んで","あんで"],["イエス"],["の"],["頭","あたま"],["に"],["載せ","のせ"],["、"],["紫","むらさき"],["の"],["服","ふく"],["を"],["まとわせ"],["、"]]},{"verse":3,"text":"そばにやって来ては、「ユダヤ人の王、万歳」と言って、平手で打った。","tok":[["そば"],["に"],["やって"],["来て","きて"],["は"],["、"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["、"],["万歳","ばんざい"],["」"],["と"],["言って","いって"],["、"],["平手","ひらて"],["で"],["打った","うった"],["。"]]},{"verse":4,"text":"ピラトはまた出て来て、言った。「見よ、あの男をあなたたちのところへ引き出そう。そうすれば、わたしが彼に何の罪も見いだせないわけが分かるだろう。」","tok":[["ピラト"],["は"],["また"],["出て","でて"],["来て","きて"],["、"],["言った","いった"],["。"],["「"],["見よ","みよ"],["、"],["あの"],["男","おとこ"],["を"],["あなた"],["たち"],["の"],["ところ"],["へ"],["引き出そう","ひきだそう"],["。"],["そう"],["すれば"],["、"],["わたし"],["が"],["彼","かれ"],["に"],["何","なん"],["の"],["罪","つみ"],["も"],["見いだせない","みいだせない"],["わけ"],["が"],["分かるだろう","わかるだろう"],["。"],["」"]]},{"verse":5,"text":"イエスは茨の冠をかぶり、紫の服を着けて出て来られた。ピラトは、「見よ、この男だ」と言った。","tok":[["イエス"],["は"],["茨","うばら"],["の"],["冠","かんむり"],["を"],["かぶり"],["、"],["紫","むらさき"],["の"],["服","ふく"],["を"],["着けて","つけて"],["出て","でて"],["来られた","こられた"],["。"],["ピラト"],["は"],["、"],["「"],["見よ","みよ"],["、"],["この"],["男","おとこ"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"祭司長たちや下役たちは、イエスを見ると、「十字架につけろ。十字架につけろ」と叫んだ。ピラトは言った。「あなたたちが引き取って、十字架につけるがよい。わたしはこの男に罪を見いだせない。」","tok":[["祭司長","さいしちょう"],["たち"],["や"],["下役","したやく"],["たち"],["は"],["、"],["イエス"],["を"],["見る","みる"],["と"],["、"],["「"],["十字架","じゅうじか"],["に"],["つけろ"],["。"],["十字架","じゅうじか"],["に"],["つけろ"],["」"],["と"],["叫んだ","さけんだ"],["。"],["ピラト"],["は"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["が"],["引き取って","ひきとって"],["、"],["十字架","じゅうじか"],["に"],["つける"],["が"],["よい"],["。"],["わたし"],["は"],["この"],["男","おとこ"],["に"],["罪","つみ"],["を"],["見いだせない","みいだせない"],["。"],["」"]]},{"verse":7,"text":"ユダヤ人たちは答えた。「わたしたちには律法があります。律法によれば、この男は死罪に当たります。神の子と自称したからです。」","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["答えた","こたえた"],["。"],["「"],["わたしたち"],["に"],["は"],["律法","りっぽう"],["が"],["あります"],["。"],["律法","りっぽう"],["に"],["よれば"],["、"],["この"],["男","おとこ"],["は"],["死罪","しざい"],["に"],["当たります","あたります"],["。"],["神","かみ"],["の"],["子","こ"],["と"],["自称","じしょう"],["した"],["から"],["です"],["。"],["」"]]},{"verse":8,"text":"ピラトは、この言葉を聞いてますます恐れ、","tok":[["ピラト"],["は"],["、"],["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["ますます"],["恐れ","おそれ"],["、"]]},{"verse":9,"text":"再び総督官邸の中に入って、「お前はどこから来たのか」とイエスに言った。しかし、イエスは答えようとされなかった。","tok":[["再び","ふたたび"],["総督","そうとく"],["官邸","かんてい"],["の"],["中","なか"],["に"],["入って","はいって"],["、"],["「"],["お前","おまえ"],["は"],["どこ"],["から"],["来た","きた"],["の"],["か"],["」"],["と"],["イエス"],["に"],["言った","いった"],["。"],["しかし"],["、"],["イエス"],["は"],["答えよう","こたえよう"],["と"],["されなかった"],["。"]]},{"verse":10,"text":"そこで、ピラトは言った。「わたしに答えないのか。お前を釈放する権限も、十字架につける権限も、このわたしにあることを知らないのか。」","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["言った","いった"],["。"],["「"],["わたし"],["に"],["答えない","こたえない"],["の"],["か"],["。"],["お前","おまえ"],["を"],["釈放","しゃくほう"],["する"],["権限","けんげん"],["も"],["、"],["十字架","じゅうじか"],["に"],["つける"],["権限","けんげん"],["も"],["、"],["この"],["わたし"],["に"],["ある"],["こと"],["を"],["知らない","しらない"],["の"],["か"],["。"],["」"]]},{"verse":11,"text":"イエスは答えられた。「神から与えられていなければ、わたしに対して何の権限もないはずだ。だから、わたしをあなたに引き渡した者の罪はもっと重い。」","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["神","かみ"],["から"],["与えられて","あたえられて"],["いなければ"],["、"],["わたし"],["に対して","にたいして"],["何","なん"],["の"],["権限","けんげん"],["も"],["ない"],["はず"],["だ"],["。"],["だ"],["から"],["、"],["わたし"],["を"],["あなた"],["に"],["引き渡した","ひきわたした"],["者","もの"],["の"],["罪","つみ"],["は"],["もっと"],["重い","おもい"],["。"],["」"]]},{"verse":12,"text":"そこで、ピラトはイエスを釈放しようと努めた。しかし、ユダヤ人たちは叫んだ。「もし、この男を釈放するなら、あなたは皇帝の友ではない。王と自称する者は皆、皇帝に背いています。」","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["イエス"],["を"],["釈放","しゃくほう"],["しよう"],["と"],["努めた","つとめた"],["。"],["しかし"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["叫んだ","さけんだ"],["。"],["「"],["もし"],["、"],["この"],["男","おとこ"],["を"],["釈放","しゃくほう"],["するなら"],["、"],["あなた"],["は"],["皇帝","こうてい"],["の"],["友","とも"],["で"],["は"],["ない"],["。"],["王","おう"],["と"],["自称","じしょう"],["する"],["者","もの"],["は"],["皆","みな"],["、"],["皇帝","こうてい"],["に"],["背いて","そむいて"],["います"],["。"],["」"]]},{"verse":13,"text":"ピラトは、これらの言葉を聞くと、イエスを外に連れ出し、ヘブライ語でガバタ、すなわち「敷石」という場所で、裁判の席に着かせた。","tok":[["ピラト"],["は"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["と"],["、"],["イエス"],["を"],["外","そと"],["に"],["連れ出し","つれだし"],["、"],["ヘブライ"],["語","ご"],["で"],["ガバタ"],["、"],["すなわち"],["「"],["敷石","しきいし"],["」"],["と"],["いう"],["場所","ばしょ"],["で"],["、"],["裁判","さいばん"],["の"],["席","せき"],["に"],["着かせた","つかせた"],["。"]]},{"verse":14,"text":"それは過越祭の準備の日の、正午ごろであった。ピラトがユダヤ人たちに、「見よ、あなたたちの王だ」と言うと、","tok":[["それ"],["は"],["過越","すぎこし"],["祭","まつり"],["の"],["準備","じゅんび"],["の"],["日","ひ"],["の"],["、"],["正午","しょうご"],["ごろ"],["で"],["あった"],["。"],["ピラト"],["が"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["、"],["「"],["見よ","みよ"],["、"],["あなた"],["たち"],["の"],["王","おう"],["だ"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":15,"text":"彼らは叫んだ。「殺せ。殺せ。十字架につけろ。」ピラトが、「あなたたちの王をわたしが十字架につけるのか」と言うと、祭司長たちは、「わたしたちには、皇帝のほかに王はありません」と答えた。","tok":[["彼","かれ"],["ら"],["は"],["叫んだ","さけんだ"],["。"],["「"],["殺せ","ころせ"],["。"],["殺せ","ころせ"],["。"],["十字架","じゅうじか"],["に"],["つけろ"],["。"],["」"],["ピラト"],["が"],["、"],["「"],["あなた"],["たち"],["の"],["王","おう"],["を"],["わたし"],["が"],["十字架","じゅうじか"],["に"],["つける"],["の"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"],["祭司長","さいしちょう"],["たち"],["は"],["、"],["「"],["わたしたち"],["に"],["は"],["、"],["皇帝","こうてい"],["の"],["ほか"],["に"],["王","おう"],["は"],["ありません"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":16,"text":"そこで、ピラトは、十字架につけるために、イエスを彼らに引き渡した。十字架につけられるこうして、彼らはイエスを引き取った。","tok":[["そこ"],["で"],["、"],["ピラト"],["は"],["、"],["十字架","じゅうじか"],["に"],["つける"],["ため"],["に"],["、"],["イエス"],["を"],["彼","かれ"],["ら"],["に"],["引き渡した","ひきわたした"],["。"],["十字架","じゅうじか"],["に"],["つけられる"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["を"],["引き取った","ひきとった"],["。"]]},{"verse":17,"text":"イエスは、自ら十字架を背負い、いわゆる「されこうべの場所」、すなわちヘブライ語でゴルゴタという所へ向かわれた。","tok":[["イエス"],["は"],["、"],["自ら","みずから"],["十字架","じゅうじか"],["を"],["背負い","せおい"],["、"],["いわゆる"],["「"],["されこうべ"],["の"],["場所","ばしょ"],["」"],["、"],["すなわち"],["ヘブライ"],["語","ご"],["で"],["ゴルゴタ"],["と"],["いう"],["所","ところ"],["へ"],["向かわれた","むかわれた"],["。"]]},{"verse":18,"text":"そこで、彼らはイエスを十字架につけた。また、イエスと一緒にほかの二人をも、イエスを真ん中にして両側に、十字架につけた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つけた"],["。"],["また"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["ほか"],["の"],["二人","ふたり"],["を"],["も"],["、"],["イエス"],["を"],["真ん中","まんなか"],["に"],["して"],["両側","りょうがわ"],["に"],["、"],["十字架","じゅうじか"],["に"],["つけた"],["。"]]},{"verse":19,"text":"ピラトは罪状書きを書いて、十字架の上に掛けた。それには、「ナザレのイエス、ユダヤ人の王」と書いてあった。","tok":[["ピラト"],["は"],["罪状書き","ざいじょうかき"],["を"],["書いて","かいて"],["、"],["十字架","じゅうじか"],["の"],["上","うえ"],["に"],["掛けた","かけた"],["。"],["それ"],["に"],["は"],["、"],["「"],["ナザレ"],["の"],["イエス"],["、"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["」"],["と"],["書いて","かいて"],["あった"],["。"]]},{"verse":20,"text":"イエスが十字架につけられた場所は都に近かったので、多くのユダヤ人がその罪状書きを読んだ。それは、ヘブライ語、ラテン語、ギリシア語で書かれていた。","tok":[["イエス"],["が"],["十字架","じゅうじか"],["に"],["つけられた"],["場所","ばしょ"],["は"],["都","と"],["に"],["近かった","ちかかった"],["ので"],["、"],["多く","おおく"],["の"],["ユダヤ人","ゆだやじん"],["が"],["その"],["罪状書き","ざいじょうかき"],["を"],["読んだ","よんだ"],["。"],["それ"],["は"],["、"],["ヘブライ"],["語","ご"],["、"],["ラテン語","らてんご"],["、"],["ギリシア"],["語","ご"],["で"],["書かれて","かかれて"],["いた"],["。"]]},{"verse":21,"text":"ユダヤ人の祭司長たちがピラトに、「『ユダヤ人の王』と書かず、『この男は「ユダヤ人の王」と自称した』と書いてください」と言った。","tok":[["ユダヤ人","ゆだやじん"],["の"],["祭司長","さいしちょう"],["たち"],["が"],["ピラト"],["に"],["、"],["「"],["『"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["』"],["と"],["書かず","かかず"],["、"],["『"],["この"],["男","おとこ"],["は"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["」"],["と"],["自称","じしょう"],["した"],["』"],["と"],["書いて","かいて"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":22,"text":"しかし、ピラトは、「わたしが書いたものは、書いたままにしておけ」と答えた。","tok":[["しかし"],["、"],["ピラト"],["は"],["、"],["「"],["わたし"],["が"],["書いた","かいた"],["もの"],["は"],["、"],["書いた","かいた"],["まま"],["に"],["して"],["おけ"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":23,"text":"兵士たちは、イエスを十字架につけてから、その服を取り、四つに分け、各自に一つずつ渡るようにした。下着も取ってみたが、それには縫い目がなく、上から下まで一枚織りであった。","tok":[["兵士","へいし"],["たち"],["は"],["、"],["イエス"],["を"],["十字架","じゅうじか"],["に"],["つけて"],["から"],["、"],["その"],["服","ふく"],["を"],["取り","とり"],["、"],["四","よん"],["つ"],["に"],["分け","わけ"],["、"],["各自","かくじ"],["に"],["一","ひと"],["つ"],["ずつ"],["渡る","わたる"],["よう"],["に"],["した"],["。"],["下着","したぎ"],["も"],["取って","とって"],["みた"],["が"],["、"],["それ"],["に"],["は"],["縫い目","ぬいめ"],["が"],["なく"],["、"],["上","うえ"],["から"],["下","した"],["まで"],["一枚織り","いちまいおり"],["で"],["あった"],["。"]]},{"verse":24,"text":"そこで、「これは裂かないで、だれのものになるか、くじ引きで決めよう」と話し合った。それは、「彼らはわたしの服を分け合い、わたしの衣服のことでくじを引いた」という聖書の言葉が実現するためであった。兵士たちはこのとおりにしたのである。","tok":[["そこ"],["で"],["、"],["「"],["これ"],["は"],["裂かないで","さかないで"],["、"],["だれ"],["の"],["もの"],["に"],["なる"],["か"],["、"],["くじ引き","くじびき"],["で"],["決めよう","きめよう"],["」"],["と"],["話し合った","はなしあった"],["。"],["それ"],["は"],["、"],["「"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["服","ふく"],["を"],["分け合い","わけあい"],["、"],["わたし"],["の"],["衣服","いふく"],["の"],["こと"],["で"],["くじ"],["を"],["引いた","ひいた"],["」"],["と"],["いう"],["聖書","せいしょ"],["の"],["言葉","ことば"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"],["兵士","へいし"],["たち"],["は"],["この"],["とおり"],["に"],["した"],["ので"],["ある"],["。"]]},{"verse":25,"text":"イエスの十字架のそばには、その母と母の姉妹、クロパの妻マリアとマグダラのマリアとが立っていた。","tok":[["イエス"],["の"],["十字架","じゅうじか"],["の"],["そば"],["に"],["は"],["、"],["その"],["母","はは"],["と"],["母","はは"],["の"],["姉妹","しまい"],["、"],["クロパ"],["の"],["妻","つま"],["マリア"],["と"],["マグダラ"],["の"],["マリア"],["と"],["が"],["立って","たって"],["いた"],["。"]]},{"verse":26,"text":"イエスは、母とそのそばにいる愛する弟子とを見て、母に、「婦人よ、御覧なさい。あなたの子です」と言われた。","tok":[["イエス"],["は"],["、"],["母","はは"],["と"],["その"],["そば"],["に"],["いる"],["愛する","あいする"],["弟子","でし"],["と"],["を"],["見て","みて"],["、"],["母","はは"],["に"],["、"],["「"],["婦人","ふじん"],["よ"],["、"],["御覧","ごらん"],["なさい"],["。"],["あなた"],["の"],["子","こ"],["です"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":27,"text":"それから弟子に言われた。「見なさい。あなたの母です。」そのときから、この弟子はイエスの母を自分の家に引き取った。","tok":[["それ"],["から"],["弟子","でし"],["に"],["言われた","いわれた"],["。"],["「"],["見","み"],["なさい"],["。"],["あなた"],["の"],["母","はは"],["です"],["。"],["」"],["その"],["とき"],["から"],["、"],["この"],["弟子","でし"],["は"],["イエス"],["の"],["母","はは"],["を"],["自分","じぶん"],["の"],["家","いえ"],["に"],["引き取った","ひきとった"],["。"]]},{"verse":28,"text":"この後、イエスは、すべてのことが今や成し遂げられたのを知り、「渇く」と言われた。こうして、聖書の言葉が実現した。","tok":[["この"],["後","ご"],["、"],["イエス"],["は"],["、"],["すべて"],["の"],["こと"],["が"],["今","いま"],["や"],["成し遂げられた","なしとげられた"],["の"],["を"],["知り","しり"],["、"],["「"],["渇く","かわく"],["」"],["と"],["言われた","いわれた"],["。"],["こう"],["して"],["、"],["聖書","せいしょ"],["の"],["言葉","ことば"],["が"],["実現","じつげん"],["した"],["。"]]},{"verse":29,"text":"そこには、酸いぶどう酒を満たした器が置いてあった。人々は、このぶどう酒をいっぱい含ませた海綿をヒソプに付け、イエスの口もとに差し出した。","tok":[["そこ"],["に"],["は"],["、"],["酸い","すい"],["ぶどう酒","ぶどうしゅ"],["を"],["満たした","みたした"],["器","うつわ"],["が"],["置いて","おいて"],["あった"],["。"],["人々","ひとびと"],["は"],["、"],["この"],["ぶどう酒","ぶどうしゅ"],["を"],["いっぱい"],["含ませた","ふくませた"],["海綿","かいめん"],["を"],["ヒソプ"],["に"],["付け","つけ"],["、"],["イエス"],["の"],["口もと","くちもと"],["に"],["差し出した","さしだした"],["。"]]},{"verse":30,"text":"イエスは、このぶどう酒を受けると、「成し遂げられた」と言い、頭を垂れて息を引き取られた。","tok":[["イエス"],["は"],["、"],["この"],["ぶどう酒","ぶどうしゅ"],["を"],["受ける","うける"],["と"],["、"],["「"],["成し遂げられた","なしとげられた"],["」"],["と"],["言い","いい"],["、"],["頭","あたま"],["を"],["垂れて","たれて"],["息","いき"],["を"],["引き取られた","ひきとられた"],["。"]]},{"verse":31,"text":"その日は準備の日で、翌日は特別の安息日であったので、ユダヤ人たちは、安息日に遺体を十字架の上に残しておかないために、足を折って取り降ろすように、ピラトに願い出た。","tok":[["その"],["日","ひ"],["は"],["準備","じゅんび"],["の"],["日","ひ"],["で"],["、"],["翌日","よくじつ"],["は"],["特別","とくべつ"],["の"],["安息日","あんそくび"],["で"],["あった"],["ので"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["安息日","あんそくび"],["に"],["遺体","いたい"],["を"],["十字架","じゅうじか"],["の"],["上","うえ"],["に"],["残して","のこして"],["おかない"],["ため"],["に"],["、"],["足","あし"],["を"],["折って","おって"],["取り降ろす","とりおろす"],["よう"],["に"],["、"],["ピラト"],["に"],["願い出た","ねがいでた"],["。"]]},{"verse":32,"text":"そこで、兵士たちが来て、イエスと一緒に十字架につけられた最初の男と、もう一人の男との足を折った。","tok":[["そこ"],["で"],["、"],["兵士","へいし"],["たち"],["が"],["来て","きて"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["十字架","じゅうじか"],["に"],
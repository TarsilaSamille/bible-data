[{"verse":1,"text":"過越祭の六日前に、イエスはベタニアに行かれた。そこには、イエスが死者の中からよみがえらせたラザロがいた。","tok":[["過越","すぎこし"],["祭","まつり"],["の"],["六日","むいか"],["前","まえ"],["に"],["、"],["イエス"],["は"],["ベタニア"],["に"],["行かれた","いかれた"],["。"],["そこ"],["に"],["は"],["、"],["イエス"],["が"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせた"],["ラザロ"],["が"],["いた"],["。"]]},{"verse":2,"text":"イエスのためにそこで夕食が用意され、マルタは給仕をしていた。ラザロは、イエスと共に食事の席に着いた人々の中にいた。","tok":[["イエス"],["の"],["ため"],["に"],["そこ"],["で"],["夕食","ゆうしょく"],["が"],["用意","ようい"],["され"],["、"],["マルタ"],["は"],["給仕","きゅうじ"],["を"],["して"],["いた"],["。"],["ラザロ"],["は"],["、"],["イエス"],["と"],["共","とも"],["に"],["食事","しょくじ"],["の"],["席","せき"],["に"],["着いた","ついた"],["人々","ひとびと"],["の"],["中","なか"],["に"],["いた"],["。"]]},{"verse":3,"text":"そのとき、マリアが純粋で非常に高価なナルドの香油を一リトラ持って来て、イエスの足に塗り、自分の髪でその足をぬぐった。家は香油の香りでいっぱいになった。","tok":[["その"],["とき"],["、"],["マリア"],["が"],["純粋","じゅんすい"],["で"],["非常","ひじょう"],["に"],["高価","こうか"],["な"],["ナルド"],["の"],["香油","こうゆ"],["を"],["一","いち"],["リトラ"],["持って","もって"],["来て","きて"],["、"],["イエス"],["の"],["足","あし"],["に"],["塗り","ぬり"],["、"],["自分","じぶん"],["の"],["髪","かみ"],["で"],["その"],["足","あし"],["を"],["ぬぐった"],["。"],["家","いえ"],["は"],["香油","こうゆ"],["の"],["香り","かおり"],["で"],["いっぱい"],["に"],["なった"],["。"]]},{"verse":4,"text":"弟子の一人で、後にイエスを裏切るイスカリオテのユダが言った。","tok":[["弟子","でし"],["の"],["一人","ひとり"],["で"],["、"],["後","あと"],["に"],["イエス"],["を"],["裏切る","うらぎる"],["イスカリオテ"],["の"],["ユダ"],["が"],["言った","いった"],["。"]]},{"verse":5,"text":"「なぜ、この香油を三百デナリオンで売って、貧しい人々に施さなかったのか。」","tok":[["「"],["なぜ"],["、"],["この"],["香油","こうゆ"],["を"],["三百","さんひゃく"],["デナリオン"],["で"],["売って","うって"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["施さなかった","ほどこさなかった"],["の"],["か"],["。"],["」"]]},{"verse":6,"text":"彼がこう言ったのは、貧しい人々のことを心にかけていたからではない。彼は盗人であって、金入れを預かっていながら、その中身をごまかしていたからである。","tok":[["彼","かれ"],["が"],["こう"],["言った","いった"],["の"],["は"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["の"],["こと"],["を"],["心","こころ"],["に"],["かけて"],["いた"],["から"],["で"],["は"],["ない"],["。"],["彼","かれ"],["は"],["盗人","ぬすびと"],["で"],["あって"],["、"],["金入れ","かねいれ"],["を"],["預かって","あずかって"],["い"],["ながら"],["、"],["その"],["中身","なかみ"],["を"],["ごまかして"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"イエスは言われた。「この人のするままにさせておきなさい。わたしの葬りの日のために、それを取って置いたのだから。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["この"],["人","ひと"],["の"],["する"],["まま"],["に"],["させて"],["おき"],["なさい"],["。"],["わたし"],["の"],["葬り","ほうむり"],["の"],["日","ひ"],["の"],["ため"],["に"],["、"],["それ"],["を"],["取って","とって"],["置いた","おいた"],["の"],["だ"],["から"],["。"]]},{"verse":8,"text":"貧しい人々はいつもあなたがたと一緒にいるが、わたしはいつも一緒にいるわけではない。」","tok":[["貧しい","まずしい"],["人々","ひとびと"],["は"],["いつも"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["いる"],["が"],["、"],["わたし"],["は"],["いつも"],["一緒","いっしょ"],["に"],["いる"],["わけ"],["で"],["は"],["ない"],["。"],["」"]]},{"verse":9,"text":"イエスがそこにおられるのを知って、ユダヤ人の大群衆がやって来た。それはイエスだけが目当てではなく、イエスが死者の中からよみがえらせたラザロを見るためでもあった。","tok":[["イエス"],["が"],["そこ"],["に"],["おられる"],["の"],["を"],["知って","しって"],["、"],["ユダヤ人","ゆだやじん"],["の"],["大","だい"],["群衆","ぐんしゅう"],["が"],["やって"],["来た","きた"],["。"],["それ"],["は"],["イエス"],["だけ"],["が"],["目当て","めあて"],["で"],["は"],["なく"],["、"],["イエス"],["が"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせた"],["ラザロ"],["を"],["見る","みる"],["ため"],["で"],["も"],["あった"],["。"]]},{"verse":10,"text":"祭司長たちはラザロをも殺そうと謀った。","tok":[["祭司長","さいしちょう"],["たち"],["は"],["ラザロ"],["を"],["も"],["殺そう","ころそう"],["と"],["謀った","はかった"],["。"]]},{"verse":11,"text":"多くのユダヤ人がラザロのことで離れて行って、イエスを信じるようになったからである。","tok":[["多く","おおく"],["の"],["ユダヤ人","ゆだやじん"],["が"],["ラザロ"],["の"],["こと"],["で"],["離れて","はなれて"],["行って","いって"],["、"],["イエス"],["を"],["信じる","しんじる"],["よう"],["に"],["なった"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"その翌日、祭りに来ていた大勢の群衆は、イエスがエルサレムに来られると聞き、","tok":[["その"],["翌日","よくじつ"],["、"],["祭り","まつり"],["に"],["来て","きて"],["いた"],["大勢","おおぜい"],["の"],["群衆","ぐんしゅう"],["は"],["、"],["イエス"],["が"],["エルサレム"],["に"],["来られる","こられる"],["と"],["聞き","きき"],["、"]]},{"verse":13,"text":"なつめやしの枝を持って迎えに出た。そして、叫び続けた。「ホサナ。主の名によって来られる方に、祝福があるように、イスラエルの王に。」","tok":[["なつめやし"],["の"],["枝","えだ"],["を"],["持って","もって"],["迎え","むかえ"],["に"],["出た","でた"],["。"],["そして"],["、"],["叫び","さけび"],["続けた","つづけた"],["。"],["「"],["ホサナ"],["。"],["主","ぬし"],["の"],["名","な"],["によって"],["来られる","こられる"],["方","かた"],["に"],["、"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["、"],["イスラエル"],["の"],["王","おう"],["に"],["。"],["」"]]},{"verse":14,"text":"イエスはろばの子を見つけて、お乗りになった。次のように書いてあるとおりである。","tok":[["イエス"],["は"],["ろば"],["の"],["子","こ"],["を"],["見つけて","みつけて"],["、"],["お乗り","おのり"],["に"],["なった"],["。"],["次","つぎ"],["の"],["よう"],["に"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":15,"text":"「シオンの娘よ、恐れるな。見よ、お前の王がおいでになる、ろばの子に乗って。」","tok":[["「"],["シオン"],["の"],["娘","むすめ"],["よ"],["、"],["恐れる","おそれる"],["な"],["。"],["見よ","みよ"],["、"],["お前","おまえ"],["の"],["王","おう"],["が"],["おいで"],["に"],["なる"],["、"],["ろば"],["の"],["子","こ"],["に"],["乗って","のって"],["。"],["」"]]},{"verse":16,"text":"弟子たちは最初これらのことが分からなかったが、イエスが栄光を受けられたとき、それがイエスについて書かれたものであり、人々がそのとおりにイエスにしたということを思い出した。","tok":[["弟子","でし"],["たち"],["は"],["最初","さいしょ"],["これ"],["ら"],["の"],["こと"],["が"],["分からなかった","わからなかった"],["が"],["、"],["イエス"],["が"],["栄光","えいこう"],["を"],["受けられた","うけられた"],["とき"],["、"],["それ"],["が"],["イエス"],["について"],["書かれた","かかれた"],["もの"],["で"],["あり"],["、"],["人々","ひとびと"],["が"],["その"],["とおり"],["に"],["イエス"],["に"],["した"],["と"],["いう"],["こと"],["を"],["思い出した","おもいだした"],["。"]]},{"verse":17,"text":"イエスがラザロを墓から呼び出して、死者の中からよみがえらせたとき一緒にいた群衆は、その証しをしていた。","tok":[["イエス"],["が"],["ラザロ"],["を"],["墓","はか"],["から"],["呼び出して","よびだして"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["よみがえらせた"],["とき"],["一緒","いっしょ"],["に"],["いた"],["群衆","ぐんしゅう"],["は"],["、"],["その"],["証し","あかし"],["を"],["して"],["いた"],["。"]]},{"verse":18,"text":"群衆がイエスを出迎えたのも、イエスがこのようなしるしをなさったと聞いていたからである。","tok":[["群衆","ぐんしゅう"],["が"],["イエス"],["を"],["出迎えた","でむかえた"],["の"],["も"],["、"],["イエス"],["が"],["この"],["よう"],["な"],["しるし"],["を"],["なさった"],["と"],["聞いて","きいて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"そこで、ファリサイ派の人々は互いに言った。「見よ、何をしても無駄だ。世をあげてあの男について行ったではないか。」","tok":[["そこ"],["で"],["、"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["見よ","みよ"],["、"],["何","なん"],["を"],["して"],["も"],["無駄","むだ"],["だ"],["。"],["世","よ"],["を"],["あげて"],["あの"],["男","おとこ"],["について"],["行ったで","いったで"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":20,"text":"さて、祭りのとき礼拝するためにエルサレムに上って来た人々の中に、何人かのギリシア人がいた。","tok":[["さて"],["、"],["祭り","まつり"],["の"],["とき"],["礼拝","れいはい"],["する"],["ため"],["に"],["エルサレム"],["に"],["上って","のぼって"],["来た","きた"],["人々","ひとびと"],["の"],["中","なか"],["に"],["、"],["何人","なんにん"],["か"],["の"],["ギリシア"],["人","にん"],["が"],["いた"],["。"]]},{"verse":21,"text":"彼らは、ガリラヤのベトサイダ出身のフィリポのもとへ来て、「お願いです。イエスにお目にかかりたいのです」と頼んだ。","tok":[["彼","かれ"],["ら"],["は"],["、"],["ガリラヤ"],["の"],["ベトサイダ"],["出身","しゅっしん"],["の"],["フィリポ"],["の"],["もと"],["へ"],["来て","きて"],["、"],["「"],["お願い","おねがい"],["です"],["。"],["イエス"],["に"],["お目","おめ"],["に"],["かかりたい"],["の"],["です"],["」"],["と"],["頼んだ","たのんだ"],["。"]]},{"verse":22,"text":"フィリポは行ってアンデレに話し、アンデレとフィリポは行って、イエスに話した。","tok":[["フィリポ"],["は"],["行って","いって"],["アンデレ"],["に"],["話し","はなし"],["、"],["アンデレ"],["と"],["フィリポ"],["は"],["行って","いって"],["、"],["イエス"],["に"],["話した","はなした"],["。"]]},{"verse":23,"text":"イエスはこうお答えになった。「人の子が栄光を受ける時が来た。","tok":[["イエス"],["は"],["こう"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["が"],["栄光","えいこう"],["を"],["受ける","うける"],["時","とき"],["が"],["来た","きた"],["。"]]},{"verse":24,"text":"はっきり言っておく。一粒の麦は、地に落ちて死ななければ、一粒のままである。だが、死ねば、多くの実を結ぶ。","tok":[["はっきり"],["言って","いって"],["おく"],["。"],["一","いち"],["粒","つぶ"],["の"],["麦","むぎ"],["は"],["、"],["地","ち"],["に"],["落ちて","おちて"],["死ななければ","しななければ"],["、"],["一","いち"],["粒","つぶ"],["の"],["まま"],["で"],["ある"],["。"],["だ"],["が"],["、"],["死ねば","しねば"],["、"],["多く","おおく"],["の"],["実","じつ"],["を"],["結ぶ","むすぶ"],["。"]]},{"verse":25,"text":"自分の命を愛する者は、それを失うが、この世で自分の命を憎む人は、それを保って永遠の命に至る。","tok":[["自分","じぶん"],["の"],["命","いのち"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["それ"],["を"],["失う","うしなう"],["が"],["、"],["この世","このよ"],["で"],["自分","じぶん"],["の"],["命","いのち"],["を"],["憎む","にくむ"],["人","ひと"],["は"],["、"],["それ"],["を"],["保って","たもって"],["永遠","えいえん"],["の"],["命","いのち"],["に"],["至る","いたる"],["。"]]},{"verse":26,"text":"わたしに仕えようとする者は、わたしに従え。そうすれば、わたしのいるところに、わたしに仕える者もいること
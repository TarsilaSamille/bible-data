[{"verse":1,"text":"三日目に、ガリラヤのカナで婚礼があって、イエスの母がそこにいた。","tok":[["三日目","みっかめ"],["に"],["、"],["ガリラヤ"],["の"],["カナ"],["で"],["婚礼","こんれい"],["が"],["あって"],["、"],["イエス"],["の"],["母","はは"],["が"],["そこ"],["に"],["いた"],["。"]]},{"verse":2,"text":"イエスも、その弟子たちも婚礼に招かれた。","tok":[["イエス"],["も"],["、"],["その"],["弟子","でし"],["たち"],["も"],["婚礼","こんれい"],["に"],["招かれた","まねかれた"],["。"]]},{"verse":3,"text":"ぶどう酒が足りなくなったので、母がイエスに、「ぶどう酒がなくなりました」と言った。","tok":[["ぶどう酒","ぶどうしゅ"],["が"],["足りなく","たりなく"],["なった"],["ので"],["、"],["母","はは"],["が"],["イエス"],["に"],["、"],["「"],["ぶどう酒","ぶどうしゅ"],["が"],["なくなりました"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"イエスは母に言われた。「婦人よ、わたしとどんなかかわりがあるのです。わたしの時はまだ来ていません。」","tok":[["イエス"],["は"],["母","はは"],["に"],["言われた","いわれた"],["。"],["「"],["婦人","ふじん"],["よ"],["、"],["わたし"],["と"],["どんな"],["かかわり"],["が"],["ある"],["の"],["です"],["。"],["わたし"],["の"],["時","とき"],["は"],["まだ"],["来て","きて"],["いません"],["。"],["」"]]},{"verse":5,"text":"しかし、母は召し使いたちに、「この人が何か言いつけたら、そのとおりにしてください」と言った。","tok":[["しかし"],["、"],["母","はは"],["は"],["召し使い","めしつかい"],["たち"],["に"],["、"],["「"],["この"],["人","ひと"],["が"],["何","なん"],["か"],["言いつけたら","いいつけたら"],["、"],["その"],["とおり"],["に"],["して"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"そこには、ユダヤ人が清めに用いる石の水がめが六つ置いてあった。いずれも二ないし三メトレテス入りのものである。","tok":[["そこ"],["に"],["は"],["、"],["ユダヤ人","ゆだやじん"],["が"],["清め","きよめ"],["に"],["用いる","もちいる"],["石","いし"],["の"],["水がめ","みずがめ"],["が"],["六","むい"],["つ"],["置いて","おいて"],["あった"],["。"],["いずれ"],["も"],["二","に"],["ないし"],["三","さん"],["メトレテス"],["入り","いり"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":7,"text":"イエスが、「水がめに水をいっぱい入れなさい」と言われると、召し使いたちは、かめの縁まで水を満たした。","tok":[["イエス"],["が"],["、"],["「"],["水がめ","みずがめ"],["に"],["水","みず"],["を"],["いっぱい"],["入れ","いれ"],["なさい"],["」"],["と"],["言われる","いわれる"],["と"],["、"],["召し使い","めしつかい"],["たち"],["は"],["、"],["かめ"],["の"],["縁","えん"],["まで"],["水","みず"],["を"],["満たした","みたした"],["。"]]},{"verse":8,"text":"イエスは、「さあ、それをくんで宴会の世話役のところへ持って行きなさい」と言われた。召し使いたちは運んで行った。","tok":[["イエス"],["は"],["、"],["「"],["さあ"],["、"],["それ"],["を"],["くんで"],["宴会","えんかい"],
["、"],["これ"],["から"],["も"],["、"],["あなた"],["がた"],["の"],["内","うち"],["に"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"わたしは、あなたがたをみなしごにはしておかない。あなたがたのところに戻って来る。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["みなしご"],["に"],["は"],["して"],["おかない"],["。"],["あなた"],["がた"],["の"],["ところ"],["に"],["戻って","もどって"],["来る","くる"],["。"]]},{"verse":19,"text":"しばらくすると、世はもうわたしを見なくなるが、あなたがたはわたしを見る。わたしが生きているので、あなたがたも生きることになる。","tok":[["しばらく"],["する"],["と"],["、"],["世","よ"],["は"],["もう"],["わたし"],["を"],["見なく","みなく"],["なる"],["が"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["見る","みる"],["。"],["わたし"],["が"],["生きて","いきて"],["いる"],["ので"],["、"],["あなた"],["がた"],["も"],["生きる","いきる"],["こと"],["に"],["なる"],["。"]]},{"verse":20,"text":"かの日には、わたしが父の内におり、あなたがたがわたしの内におり、わたしもあなたがたの内にいることが、あなたがたに分かる。","tok":[["かの"],["日","ひ"],["に"],["は"],["、"],["わたし"],["が"],["父","ちち"],["の"],["内","うち"],["に"],["おり"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["内","うち"],["に"],["おり"],["、"],["わたし"],["も"],["あなた"],["がた"],["の"],["内","うち"],["に"],["いる"],["こと"],["が"],["、"],["あなた"],["がた"],["に"],["分かる","わかる"],["。"]]},{"verse":21,"text":"わたしの掟を受け入れ、それを守る人は、わたしを愛する者である。わたしを愛する人は、わたしの父に愛される。わたしもその人を愛して、その人にわたし自身を現す。」","tok":[["わたし"],["の"],["掟","おきて"],["を"],["受け入れ","うけいれ"],["、"],["それ"],["を"],["守る","まもる"],["人","ひと"],["は"],["、"],["わたし"],["を"],["愛する","あいする"],["者","もの"],["で"],["ある"],["。"],["わたし"],["を"],["愛する","あいする"],["人","ひと"],["は"],["、"],["わたし"],["の"],["父","ちち"],["に"],["愛される","あいされる"],["。"],["わたし"],["も"],["その"],["人","ひと"],["を"],["愛して","あいして"],["、"],["その"],["人","ひと"],["に"],["わたし"],["自身","じしん"],["を"],["現す","あらわす"],["。"],["」"]]},{"verse":22,"text":"イスカリオテでない方のユダが、「主よ、わたしたちには御自分を現そうとなさるのに、世にはそうなさらないのは、なぜでしょうか」と言った。","tok":[["イスカリオテ"],["で"],["ない"],["方","ほう"],["の"],["ユダ"],["が"],["、"],["「"],["主","ぬし"],["よ"],["、"],["わたしたち"],["に"],["は"],["御自分","ごじぶん"],["を"],["現そう","あらわそう"],["と"],["なさる"],["のに"],["、"],["世","よ"],["に"],["は"],["そう"],["なさらない"],["の"],["は"],["、"],["なぜ"],["でしょう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":23,"text":"イエスはこう答えて言われた。「わたしを愛する人は、わたしの言葉
,["去って","さって"],["行く","いく"],["が"],["、"],["また"],["、"],["あなた"],["がた"],["の"],["ところ"],["へ"],["戻って","もどって"],["来る","くる"],["』"],["と"],["言った","いった"],["の"],["を"],["あなた"],["がた"],["は"],["聞いた","きいた"],["。"],["わたし"],["を"],["愛して","あいして"],["いるなら"],["、"],["わたし"],["が"],["父","ちち"],["の"],["もと"],["に"],["行く","いく"],["の"],["を"],["喜んで","よろこんで"],["くれる"],["はず"],["だ"],["。"],["父","ちち"],["は"],["わたし"],["より"],["も"],["偉大","いだい"],["な"],["方","ほう"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":29,"text":"事が起こったときに、あなたがたが信じるようにと、今、その事の起こる前に話しておく。","tok":[["事","こと"],["が"],["起こった","おこった"],["とき"],["に"],["、"],["あなた"],["がた"],["が"],["信じる","しんじる"],["よう"],["に"],["と"],["、"],["今","いま"],["、"],["その"],["事","こと"],["の"],["起こる","おこる"],["前","まえ"],["に"],["話して","はなして"],["おく"],["。"]]},{"verse":30,"text":"もはや、あなたがたと多くを語るまい。世の支配者が来るからである。だが、彼はわたしをどうすることもできない。","tok":[["もはや"],["、"],["あなた"],["がた"],["と"],["多く","おおく"],["を"],["語るまい","かたるまい"],["。"],["世","よ"],["の"],["支配者","しはいしゃ"],["が"],["来る","くる"],["から"],["で"],["ある"],["。"],["だ"],["が"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["どう"],["する"],["こと"],["も"],["できない"],["。"]]},{"verse":31,"text":"わたしが父を愛し、父がお命じになったとおりに行っていることを、世は知るべきである。さあ、立て。ここから出かけよう。」","tok":[["わたし"],["が"],["父","ちち"],["を"],["愛し","あいし"],["、"],["父","ちち"],["が"],["お命じ","おめいじ"],["に"],["なった"],["とおり"],["に"],["行って","いって"],["いる"],["こと"],["を"],["、"],["世","よ"],["は"],["知るべきで","しるべきで"],["ある"],["。"],["さあ"],["、"],["立て","たて"],["。"],["ここ"],["から"],["出かけよう","でかけよう"],["。"],["」"]]}]
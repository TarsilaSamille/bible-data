[{"verse":1,"text":"「心を騒がせるな。神を信じなさい。そして、わたしをも信じなさい。","tok":[["「"],["心","こころ"],["を"],["騒がせる","さわがせる"],["な"],["。"],["神","かみ"],["を"],["信じ","しんじ"],["なさい"],["。"],["そして"],["、"],["わたし"],["を"],["も"],["信じ","しんじ"],["なさい"],["。"]]},{"verse":2,"text":"わたしの父の家には住む所がたくさんある。もしなければ、あなたがたのために場所を用意しに行くと言ったであろうか。","tok":[["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["は"],["住む","すむ"],["所","ところ"],["が"],["たくさん"],["ある"],["。"],["も"],["しなければ"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["場所","ばしょ"],["を"],["用意","ようい"],["し"],["に"],["行く","いく"],["と"],["言ったで","いったで"],["あろう"],["か"],["。"]]},{"verse":3,"text":"行ってあなたがたのために場所を用意したら、戻って来て、あなたがたをわたしのもとに迎える。こうして、わたしのいる所に、あなたがたもいることになる。","tok":[["行って","いって"],["あなた"],["がた"],["の"],["ため"],["に"],["場所","ばしょ"],["を"],["用意","ようい"],["したら"],["、"],["戻って","もどって"],["来て","きて"],["、"],["あなた"],["がた"],["を"],["わたし"],["の"],["もと"],["に"],["迎える","むかえる"],["。"],["こう"],["して"],["、"],["わたし"],["の"],["いる"],["所","ところ"],["に"],["、"],["あなた"],["がた"],["も"],["いる"],["こと"],["に"],["なる"],["。"]]},{"verse":4,"text":"わたしがどこへ行くのか、その道をあなたがたは知っている。」","tok":[["わたし"],["が"],["どこ"],["へ"],["行く","いく"],["の"],["か"],["、"],["その"],["道","みち"],["を"],["あなた"],["がた"],["は"],["知って","しって"],["いる"],["。"],["」"]]},{"verse":5,"text":"トマスが言った。「主よ、どこへ行かれるのか、わたしたちには分かりません。どうして、その道を知ることができるでしょうか。」","tok":[["トマス"],["が"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["どこ"],["へ"],["行かれる","いかれる"],["の"],["か"],["、"],["わたしたち"],["に"],["は"],["分かりません","わかりません"],["。"],["どう"],["して"],["、"],["その"],["道","みち"],["を"],["知る","しる"],["こと"],["が"],["できるでしょう"],["か"],["。"],["」"]]},{"verse":6,"text":"イエスは言われた。「わたしは道であり、真理であり、命である。わたしを通らなければ、だれも父のもとに行くことができない。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["道","みち"],["で"],["あり"],["、"],["真理","しんり"],["で"],["あり"],["、"],["命","いのち"],["で"],["ある"],["。"],["わたし"],["を"],["通らなければ","とおらなければ"],["、"],["だれ"],["も"],["父","ちち"],["の"],["もと"],["に"],["行く","いく"],["こと"],["が"],["できない"],["。"]]},{"verse":7,"text":"あなたがたがわたしを知っているなら、わたしの父をも知ることになる。今から、あなたがたは父を知る。いや、既に父を見ている。」","tok":[["あなた"],["がた"],["が"],["わたし"],["を"],["知って","しって"],["いるなら"],["、"],["わたし"],["の"],["父","ちち"],["を"],["も"],["知る","しる"],["こと"],["に"],["なる"],["。"],["今","いま"],["から"],["、"],["あなた"],["がた"],["は"],["父","ちち"],["を"],["知る","しる"],["。"],["いや"],["、"],["既に","すでに"],["父","ちち"],["を"],["見て","みて"],["いる"],["。"],["」"]]},{"verse":8,"text":"フィリポが「主よ、わたしたちに御父をお示しください。そうすれば満足できます」と言うと、","tok":[["フィリポ"],["が"],["「"],["主","ぬし"],["よ"],["、"],["わたしたち"],["に"],["御父","おちち"],["を"],["お示し","おしめし"],["ください"],["。"],["そう"],["すれば"],["満足","まんぞく"],["できます"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":9,"text":"イエスは言われた。「フィリポ、こんなに長い間一緒にいるのに、わたしが分かっていないのか。わたしを見た者は、父を見たのだ。なぜ、『わたしたちに御父をお示しください』と言うのか。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["フィリポ"],["、"],["こんな"],["に"],["長い","ながい"],["間","あいだ"],["一緒","いっしょ"],["に"],["いる"],["のに"],["、"],["わたし"],["が"],["分かって","わかって"],["いない"],["の"],["か"],["。"],["わたし"],["を"],["見た","みた"],["者","もの"],["は"],["、"],["父","ちち"],["を"],["見た","みた"],["の"],["だ"],["。"],["なぜ"],["、"],["『"],["わたしたち"],["に"],["御父","おちち"],["を"],["お示し","おしめし"],["ください"],["』"],["と"],["言う","いう"],["の"],["か"],["。"]]},{"verse":10,"text":"わたしが父の内におり、父がわたしの内におられることを、信じないのか。わたしがあなたがたに言う言葉は、自分から話しているのではない。わたしの内におられる父が、その業を行っておられるのである。","tok":[["わたし"],["が"],["父","ちち"],["の"],["内","うち"],["に"],["おり"],["、"],["父","ちち"],["が"],["わたし"],["の"],["内","うち"],["に"],["おられる"],["こと"],["を"],["、"],["信じない","しんじない"],["の"],["か"],["。"],["わたし"],["が"],["あなた"],["がた"],["に"],["言う","いう"],["言葉","ことば"],["は"],["、"],["自分","じぶん"],["から"],["話して","はなして"],["いる"],["ので"],["は"],["ない"],["。"],["わたし"],["の"],["内","うち"],["に"],["おられる"],["父","ちち"],["が"],["、"],["その"],["業","ごう"],["を"],["行って","おこなって"],["おられる"],["ので"],["ある"],["。"]]},{"verse":11,"text":"わたしが父の内におり、父がわたしの内におられると、わたしが言うのを信じなさい。もしそれを信じないなら、業そのものによって信じなさい。","tok":[["わたし"],["が"],["父","ちち"],["の"],["内","うち"],["に"],["おり"],["、"],["父","ちち"],["が"],["わたし"],["の"],["内","うち"],["に"],["おられる"],["と"],["、"],["わたし"],["が"],["言う","いう"],["の"],["を"],["信じ","しんじ"],["なさい"],["。"],["もし"],["それ"],["を"],["信じないなら","しんじないなら"],["、"],["業","ごう"],["その"],["もの"],["によって"],["信じ","しん
,["で"],["ある"],["。"],["わたし"],["は"],["自分","じぶん"],["の"],["羊","ひつじ"],["を"],["知って","しって"],["おり"],["、"],["羊","ひつじ"],["も"],["わたし"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":15,"text":"それは、父がわたしを知っておられ、わたしが父を知っているのと同じである。わたしは羊のために命を捨てる。","tok":[["それ"],["は"],["、"],["父","ちち"],["が"],["わたし"],["を"],["知って","しって"],["おられ"],["、"],["わたし"],["が"],["父","ちち"],["を"],["知って","しって"],["いる"],["の"],["と"],["同じ","おなじ"],["で"],["ある"],["。"],["わたし"],["は"],["羊","ひつじ"],["の"],["ため"],["に"],["命","いのち"],["を"],["捨てる","すてる"],["。"]]},{"verse":16,"text":"わたしには、この囲いに入っていないほかの羊もいる。その羊をも導かなければならない。その羊もわたしの声を聞き分ける。こうして、羊は一人の羊飼いに導かれ、一つの群れになる。","tok":[["わたし"],["に"],["は"],["、"],["この"],["囲い","かこい"],["に"],["入って","はいって"],["いない"],["ほか"],["の"],["羊","ひつじ"],["も"],["いる"],["。"],["その"],["羊","ひつじ"],["を"],["も"],["導かなければ","みちびかなければ"],["ならない"],["。"],["その"],["羊","ひつじ"],["も"],["わたし"],["の"],["声","こえ"],["を"],["聞き分ける","ききわける"],["。"],["こう"],["して"],["、"],["羊","ひつじ"],["は"],["一人","ひとり"],["の"],["羊飼い","ひつじかい"],["に"],["導かれ","みちびかれ"],["、"],["一","ひと"],["つ"],["の"],["群れ","むれ"],["に"],["なる"],["。"]]},{"verse":17,"text":"わたしは命を、再び受けるために、捨てる。それゆえ、父はわたしを愛してくださる。","tok":[["わたし"],["は"],["命","いのち"],["を"],["、"],["再び","ふたたび"],["受ける","うける"],["ため"],["に"],["、"],["捨てる","すてる"],["。"],["それ"],["ゆえ"],["、"],["父","ちち"],["は"],["わたし"],["を"],["愛して","あいして"],["くださる"],["。"]]},{"verse":18,"text":"だれもわたしから命を奪い取ることはできない。わたしは自分でそれを捨てる。わたしは命を捨てることもでき、それを再び受けることもできる。これは、わたしが父から受けた掟である。」","tok":[["だれ"],["も"],["わたし"],["から"],["命","いのち"],["を"],["奪い取る","うばいとる"],["こと"],["は"],["できない"],["。"],["わたし"],["は"],["自分","じぶん"],["で"],["それ"],["を"],["捨てる","すてる"],["。"],["わたし"],["は"],["命","いのち"],["を"],["捨てる","すてる"],["こと"],["も"],["でき"],["、"],["それ"],["を"],["再び","ふたたび"],["受ける","うける"],["こと"],["も"],["できる"],["。"],["これ"],["は"],["、"],["わたし"],["が"],["父","ちち"],["から"],["受けた","うけた"],["掟","おきて"],["で"],["ある"],["。"],["」"]]},{"verse":19,"text":"この話をめぐって、ユダヤ人たちの間にまた対立が生じた。","tok":[["この"],["話","はなし"],["を"],["めぐって"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["の"],["間","あいだ"],["に"],["また"],["対立","たいりつ"],["が"],["生じた","しょうじた"],["。"]]},{"verse":20,"text":"多くのユダヤ人は言った。「彼は悪霊に取りつかれて、気が変になっている。なぜ、あなたたちは彼の言うことに耳を貸すのか。」","tok":[["多く","おおく"],["の"],["ユダヤ人","ゆだやじん"],["は"],["言った","いった"],["。"],["「"],["彼","かれ"],["は"],["悪霊","あくりょう"],["に"],["取りつかれて","とりつかれて"],["、"],["気","き"],["が"],["変","へん"],["に"],["なって"],["いる"],["。"],["なぜ"],["、"],["あなた"],["たち"],["は"],["彼","かれ"],["の"],["言う","いう"],["こと"],["に"],["耳","みみ"],["を"],["貸す","かす"],["の"],["か"],["。"],["」"]]},{"verse":21,"text":"ほかの者たちは言った。「悪霊に取りつかれた者は、こういうことは言えない。悪霊に盲人の目が開けられようか。」","tok":[["ほか"],["の"],["者","もの"],["たち"],["は"],["言った","いった"],["。"],["「"],["悪霊","あくりょう"],["に"],["取りつかれた","とりつかれた"],["者","もの"],["は"],["、"],["こう"],["いう"],["こと"],["は"],["言えない","いえない"],["。"],["悪霊","あくりょう"],["に"],["盲人","もうじん"],["の"],["目","め"],["が"],["開けられよう","あけられよう"],["か"],["。"],["」"]]},{"verse":22,"text":"そのころ、エルサレムで神殿奉献記念祭が行われた。冬であった。","tok":[["その"],["ころ"],["、"],["エルサレム"],["で"],["神殿","しんでん"],["奉献","ほうけん"],["記念祭","きねんさい"],["が"],["行われた","おこなわれた"],["。"],["冬","ふゆ"],["で"],["あった"],["。"]]},{"verse":23,"text":"イエスは、神殿の境内でソロモンの回廊を歩いておられた。","tok":[["イエス"],["は"],["、"],["神殿","しんでん"],["の"],["境内","けいだい"],["で"],["ソロモン"],["の"],["回廊","かいろう"],["を"],["歩いて","あるいて"],["おられた"],["。"]]},{"verse":24,"text":"すると、ユダヤ人たちがイエスを取り囲んで言った。「いつまで、わたしたちに気をもませるのか。もしメシアなら、はっきりそう言いなさい。」","tok":[["する"],["と"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["イエス"],["を"],["取り囲んで","とりかこんで"],["言った","いった"],["。"],["「"],["いつ"],["まで"],["、"],["わたしたち"],["に"],["気","き"],["を"],["もませる"],["の"],["か"],["。"],["もし"],["メシア"],["なら"],["、"],["はっきり"],["そう"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":25,"text":"イエスは答えられた。「わたしは言ったが、あなたたちは信じない。わたしが父の名によって行う業が、わたしについて証しをしている。","tok":[["イエス"],["は"],["答えられた","こたえられた"],["。"],["「"],["わたし"],["は"],["言った","いった"],["が"],["、"],["あなた"],["たち"],["は"],["信じない","しんじない"],["。"],["わたし"],["が"],["父","ちち"],["の"],["名","な"],["によって"],["行う","おこなう"],["業","ごう"],["が"],["、"],["わたし"],["について"],["証し","あかし"],["を"],["して"],["いる"],["。"]]},{"verse":26,"text":"しかし、あなたたちは信じない。わたしの羊ではないからである。","tok":[["しかし"],["、"],["あなた"],["たち"],["は"],["信じない","しんじない"],["。"],["わたし"],["の
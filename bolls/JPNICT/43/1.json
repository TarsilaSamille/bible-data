[{"verse":1,"text":"初めに言があった。言は神と共にあった。言は神であった。","tok":[["初め","はじめ"],["に"],["言","げん"],["が"],["あった"],["。"],["言","げん"],["は"],["神","かみ"],["と"],["共","とも"],["に"],["あった"],["。"],["言","げん"],["は"],["神","かみ"],["で"],["あった"],["。"]]},{"verse":2,"text":"この言は、初めに神と共にあった。","tok":[["この"],["言","げん"],["は"],["、"],["初め","はじめ"],["に"],["神","かみ"],["と"],["共","とも"],["に"],["あった"],["。"]]},{"verse":3,"text":"万物は言によって成った。成ったもので、言によらずに成ったものは何一つなかった。","tok":[["万物","ばんぶつ"],["は"],["言","げん"],["によって"],["成った","なった"],["。"],["成った","なった"],["もの"],["で"],["、"],["言","げん"],["に"],["よらず"],["に"],["成った","なった"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["なかった"],["。"]]},{"verse":4,"text":"言の内に命があった。命は人間を照らす光であった。","tok":[["言","げん"],["の"],["内","うち"],["に"],["命","いのち"],["が"],["あった"],["。"],["命","いのち"],["は"],["人間","にんげん"],["を"],["照らす","てらす"],["光","ひかり"],["で"],["あった"],["。"]]},{"verse":5,"text":"光は暗闇の中で輝いている。暗闇は光を理解しなかった。","tok":[["光","ひかり"],["は"],["暗闇","くらやみ"],["の"],["中","なか"],["で"],["輝いて","かがやいて"],["いる"],["。"],["暗闇","くらやみ"],["は"],["光","ひかり"],["を"],["理解","りかい"],["しなかった"],["。"]]},{"verse":6,"text":"神から遣わされた一人の人がいた。その名はヨハネである。","tok":[["神","かみ"],["から"],["遣わされた","つかわされた"],["一人","ひとり"],["の"],["人","ひと"],["が"],["いた"],["。"],["その"],["名","な"],["は"],["ヨハネ"],["で"],["ある"],["。"]]},{"verse":7,"text":"彼は証しをするために来た。光について証しをするため、また、すべての人が彼によって信じるようになるためである。","tok":[["彼","かれ"],["は"],["証し","あかし"],["を"],["する"],["ため"],["に"],["来た","きた"],["。"],["光","ひかり"],["について"],["証し","あかし"],["を"],["する"],["ため"],["、"],["また"],["、"],["すべて"],["の"],["人","ひと"],["が"],["彼","かれ"],["によって"],["信じる","しんじる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":8,"text":"彼は光ではなく、光について証しをするために来た。","tok":[["彼","かれ"],["は"],["光","ひかり"],["で"],["は"],["なく"],["、"],["光","ひかり"],["について"],["証し","あかし"],["を"],["する"],["ため"],["に"],["来た","きた"],["。"]]},{"verse":9,"text":"その光は、まことの光で、世に来てすべての人を照らすのである。","tok":[["その"],["光","ひかり"],["は"],["、"],["まこと"],["の"],["光","ひかり"],["で"],["、"],["世","よ"],["に"],["来て","きて"],["すべて"],["の"],["人","ひと"],["を"],["照らす","てらす"],["ので"],["ある"],["。"]]},{"verse":10,"text"
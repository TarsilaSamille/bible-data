[{"verse":1,"text":"週の初めの日、朝早く、まだ暗いうちに、マグダラのマリアは墓に行った。そして、墓から石が取りのけてあるのを見た。","tok":[["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["、"],["朝","あさ"],["早く","はやく"],["、"],["まだ"],["暗い","くらい"],["うち"],["に"],["、"],["マグダラ"],["の"],["マリア"],["は"],["墓","はか"],["に"],["行った","いった"],["。"],["そして"],["、"],["墓","はか"],["から"],["石","いし"],["が"],["取りのけて","とりのけて"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse":2,"text":"そこで、シモン‧ペトロのところへ、また、イエスが愛しておられたもう一人の弟子のところへ走って行って彼らに告げた。「主が墓から取り去られました。どこに置かれているのか、わたしたちには分かりません。」","tok":[["そこ"],["で"],["、"],["シモン"],["‧"],["ペトロ"],["の"],["ところ"],["へ"],["、"],["また"],["、"],["イエス"],["が"],["愛して","あいして"],["おられた"],["もう"],["一人","ひとり"],["の"],["弟子","でし"],["の"],["ところ"],["へ"],["走って","はしって"],["行って","いって"],["彼","かれ"],["ら"],["に"],["告げた","つげた"],["。"],["「"],["主","ぬし"],["が"],["墓","はか"],["から"],["取り去られました","とりさられました"],["。"],["どこ"],["に"],["置かれて","おかれて"],["いる"],["の"],["か"],["、"],["わたしたち"],["に"],["は"],["分かりません","わかりません"],["。"],["」"]]},{"verse":3,"text":"そこで、ペトロとそのもう一人の弟子は、外に出て墓へ行った。","tok":[["そこ"],["で"],["、"],["ペトロ"],["と"],["その"],["もう"],["一人","ひとり"],["の"],["弟子","でし"],["は"],["、"],["外","そと"],["に"],["出て","でて"],["墓","はか"],["へ"],["行った","いった"],["。"]]},{"verse":4,"text":"二人は一緒に走ったが、もう一人の弟子の方が、ペトロより速く走って、先に墓に着いた。","tok":[["二人","ふたり"],["は"],["一緒","いっしょ"],["に"],["走った","はしった"],["が"],["、"],["もう"],["一人","ひとり"],["の"],["弟子","でし"],["の"],["方","ほう"],["が"],["、"],["ペトロ"],["より"],["速く","はやく"],["走って","はしって"],["、"],["先","さき"],["に"],["墓","はか"],["に"],["着いた","ついた"],["。"]]},{"verse":5,"text":"身をかがめて中をのぞくと、亜麻布が置いてあった。しかし、彼は中には入らなかった。","tok":[["身","み"],["を"],["かがめて"],["中","なか"],["を"],["のぞく"],["と"],["、"],["亜","あ"],["麻布","まふ"],["が"],["置いて","おいて"],["あった"],["。"],["しかし"],["、"],["彼","かれ"],["は"],["中","なか"],["に"],["は"],["入らなかった","はいらなかった"],["。"]]},{"verse":6,"text":"続いて、シモン‧ペトロも着いた。彼は墓に入り、亜麻布が置いてあるのを見た。","tok":[["続いて","つづいて"],["、"],["シモン"],["‧"],["ペトロ"],["も"],["着いた","ついた"],["。"],["彼","かれ"],["は"],["墓","はか"],["に"],["入り","はいり"],["、"],["亜","あ"],["麻布","まふ"],["が"],["置いて","おいて"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse"
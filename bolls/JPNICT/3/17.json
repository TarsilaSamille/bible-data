,"ち"],["の"],["中","なか"],["に"],["ある"],["から"],["で"],["ある"],["。"],["わたし"],["が"],["血","ち"],["を"],["あなた"],["たち"],["に"],["与えた","あたえた"],["の"],["は"],["、"],["祭壇","さいだん"],["の"],["上","うえ"],["で"],["あなた"],["たち"],["の"],["命","いのち"],["の"],["贖い","あがない"],["の"],["儀式","ぎしき"],["を"],["する"],["ため"],["で"],["ある"],["。"],["血","ち"],["は"],["その"],["中","なか"],["の"],["命","いのち"],["によって"],["贖い","あがない"],["を"],["する"],["ので"],["ある"],["。"]]},{"verse":12,"text":"それゆえ、わたしはイスラエルの人々に言う。あなたたちも、あなたたちのもとに寄留する者も、だれも血を食べてはならない。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言う","ゆう"],["。"],["あなた"],["たち"],["も"],["、"],["あなた"],["たち"],["の"],["もと"],["に"],["寄留","きりゅう"],["する"],["者","もの"],["も"],["、"],["だれ"],["も"],["血","ち"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":13,"text":"イスラエルの人々であれ、彼らのもとに寄留する者であれ、食用となる動物や鳥を捕獲したなら、血は注ぎ出して土で覆う。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["で"],["あれ"],["、"],["彼","かれ"],["ら"],["の"],["もと"],["に"],["寄留","きりゅう"],["する"],["者","もの"],["で"],["あれ"],["、"],["食用","しょくよう"],["と"],["なる"],["動物","どうぶつ"],["や"],["鳥","とり"],["を"],["捕獲","ほかく"],["したなら"],["、"],["血","ち"],["は"],["注ぎ","そそぎ"],["出して","だして"],["土","つち"],["で"],["覆う","おおう"],["。"]]},{"verse":14,"text":"すべての生き物の命はその血であり、それは生きた体の内にあるからである。わたしはイスラエルの人々に言う。いかなる生き物の血も、決して食べてはならない。すべての生き物の命は、その血だからである。それを食べる者は断たれる。","tok":[["すべて"],["の"],["生き物","いきもの"],["の"],["命","いのち"],["は"],["その"],["血","ち"],["で"],["あり"],["、"],["それ"],["は"],["生きた","いきた"],["体","からだ"],["の"],["内","うち"],["に"],["ある"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言う","ゆう"],["。"],["いかなる"],["生き物","いきもの"],["の"],["血","ち"],["も"],["、"],["決して","けっして"],["食べて","たべて"],["は"],["ならない"],["。"],["すべて"],["の"],["生き物","いきもの"],["の"],["命","いのち"],["は"],["、"],["その"],["血","ち"],["だ"],["から"],["で"],["ある"],["。"],["それ"],["を"],["食べる","たべる"],["者","もの"],["は"],["断たれる","たたれる"],["。"]]},{"verse":15,"text":"死んだ動物や、野獣にかみ殺された動物を食べる者は、土地に生まれた者であれ、寄留者であれ、その衣服を水洗いし、身を洗う。彼は、夕方まで汚れるが、その後は清くなる。","tok":[["死んだ","しんだ"],["動物","どうぶつ"],["や"],["、"],["野獣","やじゅう"],["に"],["かみ殺された","かみころされた"
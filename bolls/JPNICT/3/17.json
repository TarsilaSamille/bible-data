[{"verse":1,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":2,"text":"アロンとその子らおよびイスラエルのすべての人々に告げてこう言いなさい。主が命じられたことは次のとおりである。","tok":[["アロン"],["と"],["その"],["子","こ"],["ら"],["および"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["告げて","つげて"],["こう"],["言い","いい"],["なさい"],["。"],["主","ぬし"],["が"],["命じられた","めいじられた"],["こと"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":3,"text":"イスラエルの人々のうちのだれかが、宿営の内であれ、外であれ、牛、羊、あるいは山羊を屠っても、","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["の"],["だれ"],["か"],["が"],["、"],["宿営","しゅくえい"],["の"],["内","うち"],["で"],["あれ"],["、"],["外","そと"],["で"],["あれ"],["、"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["あるいは"],["山羊","やぎ"],["を"],["屠って","ほふって"],["も"],["、"]]},{"verse":4,"text":"それを臨在の幕屋の入り口に携えて来て、主の幕屋の前で献げ物として主にささげなければ、殺害者と見なされる。彼は流血の罪を犯したのであるから、民の中から断たれる。","tok":[["それ"],["を"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["携えて","たずさえて"],["来て","きて"],["、"],["主","ぬし"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["で"],["献げ物","ささげもの"],["として"],["主に","おもに"],["ささげなければ"],["、"],["殺害者","さつがいしゃ"],["と"],["見なされる","みなされる"],["。"],["彼","かれ"],["は"],["流血","りゅうけつ"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["ので"],["ある"],["から"],["、"],["民","みん"],["の"],["中","なか"],["から"],["断たれる","たたれる"],["。"]]},{"verse":5,"text":"それゆえ、従来イスラエルの人々が野外で屠っていたいけにえは、主への献げ物として臨在の幕屋の入り口の祭司のもとに携えて行き、それを主への和解の献げ物とすべきである。","tok":[["それ"],["ゆえ"],["、"],["従来","じゅうらい"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["野外","やがい"],["で"],["屠って","ほふって"],["いた"],["いけにえ"],["は"],["、"],["主","ぬし"],["へ"],["の"],["献げ物","ささげもの"],["として"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["の"],["祭司","さいし"],["の"],["もと"],["に"],["携えて","たずさえて"],["行き","いき"],["、"],["それ"],["を"],["主","ぬし"],["へ"],["の"],["和解","わかい"],["の"],["献げ物","ささげもの"],["と"],["すべきで"],["ある"],["。"]]},{"verse":6,"text":"祭司はその血を臨在の幕屋の入り口にある主の祭壇に注ぎかけ、脂肪は主を宥める香りとして燃やして煙にする。","tok":[["祭司","さいし"],["は"],["その"],["血","ち"],["を"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["ある"],["主","ぬし"],["の"],["祭壇","
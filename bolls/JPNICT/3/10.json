[{"verse":1,"text":"アロンの子のナダブとアビフはそれぞれ香炉を取って炭火を入れ、その上に香をたいて主の御前にささげたが、それは、主の命じられたものではない、規定に反した炭火であった。","tok":[["アロン"],["の"],["子","こ"],["の"],["ナダブ"],["と"],["アビフ"],["は"],["それぞれ"],["香炉","こうろ"],["を"],["取って","とって"],["炭火","すみび"],["を"],["入れ","いれ"],["、"],["その"],["上","うえ"],["に"],["香","こう"],["を"],["たいて"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["ささげた"],["が"],["、"],["それ"],["は"],["、"],["主","ぬし"],["の"],["命じられた","めいじられた"],["もの"],["で"],["は"],["ない"],["、"],["規定","きてい"],["に"],["反した","はんした"],["炭火","すみび"],["で"],["あった"],["。"]]},{"verse":2,"text":"すると、主の御前から火が出て二人を焼き、彼らは主の御前で死んだ。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["から"],["火","ひ"],["が"],["出て","でて"],["二人","ふたり"],["を"],["焼き","やき"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["死んだ","しんだ"],["。"]]},{"verse":3,"text":"モーセがアロンに、「『わたしに近づく者たちに、わたしが聖なることを示し、すべての民の前に栄光を現そう』と主が言われたとおりだ」と言うと、アロンは黙した。","tok":[["モーセ"],["が"],["アロン"],["に"],["、"],["「"],["『"],["わたし"],["に"],["近づく","ちかづく"],["者","もの"],["たち"],["に"],["、"],["わたし"],["が"],["聖","せい"],["なる"],["こと"],["を"],["示し","しめし"],["、"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["に"],["栄光","えいこう"],["を"],["現そう","あらわそう"],["』"],["と"],["主","ぬし"],["が"],["言われた","いわれた"],["とおり"],["だ"],["」"],["と"],["言う","ゆう"],["と"],["、"],["アロン"],["は"],["黙した","もくした"],["。"]]},{"verse":4,"text":"モーセはアロンのおじウジエルの子、ミシャエルとエルツァファンを呼び寄せて、「進み出てきて、あなたのいとこたちを聖所から宿営の外に運び出せ」と命じた。","tok":[["モーセ"],["は"],["アロン"],["の"],["おじ"],["ウジエル"],["の"],["子","こ"],["、"],["ミシャエル"],["と"],["エルツァファン"],["を"],["呼び寄せて","よびよせて"],["、"],["「"],["進み出て","すすみでて"],["きて"],["、"],["あなた"],["の"],["いとこ"],["たち"],["を"],["聖","せい"],["所","しょ"],["から"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["運び出せ","はこびだせ"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":5,"text":"彼らは進み出て、モーセの命令に従い、祭服を着たままの二人を宿営の外に運び出した。","tok":[["彼","かれ"],["ら"],["は"],["進み出て","すすみでて"],["、"],["モーセ"],["の"],["命令","めいれい"],["に"],["従い","したがい"],["、"],["祭服","さいふく"],["を"],["着た","きた"],["まま"],["の"],["二人","ふたり"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["運び出した","はこびだした"],["。"]]},{"verse":6,"text":"モーセは、アロンとその子エルアザルとイタマルに言った。髪をほどいたり、衣服を裂いたりするな。さもないと、あなたたちまでが死を招き、更に共同体全体に神の怒りが及ぶであろう。あなたたちの兄弟であるイスラエルの家はすべて、主の火によって焼き滅ぼされたことを悲しむがよい。","tok":[["モーセ"],["は"],["、"],["アロン"],["と"],["その"],["子","こ"],["エルアザル"],["と"],["イタマル"],["に"],["言った","いった"],["。"],["髪","かみ"],["を"],["ほどい"],["たり"],["、"],["衣服","いふく"],["を"],["裂い","さい"],["たり"],["する"],["な"],["。"],["さも"],["ない"],["と"],["、"],["あなた"],["たち"],["まで"],["が"],["死","し"],["を"],["招き","まねき"],["、"],["更に","さらに"],["共同体","きょうどうたい"],["全体","ぜんたい"],["に"],["神","かみ"],["の"],["怒り","いかり"],["が"],["及ぶで","およぶで"],["あろう"],["。"],["あなた"],["たち"],["の"],["兄弟","きょうだい"],["で"],["ある"],["イスラエル"],["の"],["家","いえ"],["は"],["すべて"],["、"],["主","ぬし"],["の"],["火","ひ"],["によって"],["焼き滅ぼされた","やきほろぼされた"],["こと"],["を"],["悲しむ","かなしむ"],["が"],["よい"],["。"]]},{"verse":7,"text":"しかし、あなたたちは決して臨在の幕屋の入り口から出てはならない。さもないと死を招くことになる。あなたたちは主の聖別の油を注がれた身だからである。彼らはモーセの命じたとおりにした。","tok":[["しかし"],["、"],["あなた"],["たち"],["は"],["決して","けっして"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["から"],["出て","でて"],["は"],["ならない"],["。"],["さも"],["ない"],["と"],["死","し"],["を"],["招く","まねく"],["こと"],["に"],["なる"],["。"],["あなた"],["たち"],["は"],["主","ぬし"],["の"],["聖別","せいべつ"],["の"],["油","あぶら"],["を"],["注がれた","そそがれた"],["身","み"],["だ"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["モーセ"],["の"],["命じた","めいじた"],["とおり"],["に"],["した"],["。"]]},{"verse":8,"text":"主はアロンに仰せになった。","tok":[["主","ぬし"],["は"],["アロン"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":9,"text":"あなたであれ、あなたの子らであれ、臨在の幕屋に入るときは、ぶどう酒や強い酒を飲むな。死を招かないためである。これは代々守るべき不変の定めである。","tok":[["あなた"],["で"],["あれ"],["、"],["あなた"],["の"],["子","こ"],["ら"],["で"],["あれ"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["に"],["入る","はいる"],["とき"],["は"],["、"],["ぶどう酒","ぶどうしゅ"],["や"],["強い","つよい"],["酒","さけ"],["を"],["飲む","のむ"],["な"],["。"],["死","し"],["を"],["招かない","まねかない"],["ため"],["で"],["ある"],["。"],["これ"],["は"],["代々","だいだい"],["守るべき","まもるべき"],["不変","ふへん"],["の"],["定め","さだめ"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたたちのなすべきことは、聖と俗、清いものと汚れたものを区別すること、","tok":[["あなた"],["たち"],["の"],["なすべき"],["こと"],["は"],["、"],["聖","せい"],["と"],["俗","ぞく"],["、"],["清い","きよい"],["もの"],["と"],["汚れた","よごれた"],["もの"],["を"],["区別","くべつ"],["する"],["こと"],["、"]]},{"verse":11,"text":"またモーセを通じて主が命じられたすべての掟をイスラエルの人々に教えることである。","tok":[["また"],["モーセ"],["を"],["通じて","つうじて"],["主","ぬし"],["が"],["命じられた","めいじられた"],["すべて"],["の"],["掟","おきて"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["教える","おしえる"],["こと"],["で"],["ある"],["。"]]},{"verse":12,"text":"モーセはアロンと生き残ったエルアザルとイタマルに命じた。主に燃やしてささげた穀物の献げ物の残りで酵母を入れないパンを作り、祭壇の傍らで食べよ。それは神聖なものだからである。","tok":[["モーセ"],["は"],["アロン"],["と"],["生き残った","いきのこった"],["エルアザル"],["と"],["イタマル"],["に"],["命じた","めいじた"],["。"],["主に","おもに"],["燃やして","もやして"],["ささげた"],["穀物","こくもつ"],["の"],["献げ物","ささげもの"],["の"],["残り","のこり"],["で"],["酵母","こうぼ"],["を"],["入れない","いれない"],["パン"],["を"],["作り","つくり"],["、"],["祭壇","さいだん"],["の"],["傍ら","かたわら"],["で"],["食べ","たべ"],["よ"],["。"],["それ"],["は"],["神聖","しんせい"],["な"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"それを聖域で食べよ。これは主に燃やしてささげたものの残りで、あなたとあなたの子らに与えられた分である。わたしはそう命じられている。","tok":[["それ"],["を"],["聖域","せいいき"],["で"],["食べ","たべ"],["よ"],["。"],["これ"],["は"],["主に","おもに"],["燃やして","もやして"],["ささげた"],["もの"],["の"],["残り","のこり"],["で"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["ら"],["に"],["与えられた","あたえられた"],["分","ぶん"],["で"],["ある"],["。"],["わたし"],["は"],["そう"],["命じられて","めいじられて"],["いる"],["。"]]},{"verse":14,"text":"奉納物の胸の肉と献納物の右後ろ肢は、あなたとあなたと共にいるあなたの息子、娘が清い場所で食べることができる。これはイスラエルの人々がささげる和解の献げ物のうち、あなたとあなたの子らに与えられた分である。","tok":[["奉納物","ほうのうぶつ"],["の"],["胸","むね"],["の"],["肉","にく"],["と"],["献納物","けんのうぶつ"],["の"],["右後ろ肢","みぎうしろし"],["は"],["、"],["あなた"],["と"],["あなた"],["と"],["共","とも"],["に"],["いる"],["あなた"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["が"],["清い","きよい"],["場所","ばしょ"],["で"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["これ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["ささげる"],["和解","わかい"],["の"],["献げ物","ささげもの"],["の"],["うち"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["ら"],["に"],["与えられた","あたえられた"],["分","ぶん"],["で"],["ある"],["。"]]},{"verse":15,"text":"献納物の右後ろ肢と奉納物の胸の肉は、燃やしてささげる脂肪と共に主の御前に奉納物とせよ。そうすれば、主が命じられたとおり、あなたとあなたと共にいる子らに永久に与えられた分となる。","tok":[["献納物","けんのうぶつ"],["の"],["右後ろ肢","みぎうしろし"],["と"],["奉納物","ほうのうぶつ"],["の"],["胸","むね"],["の"],["肉","にく"],["は"],["、"],["燃やして","もやして"],["ささげる"],["脂肪","しぼう"],["と"],["共","とも"],["に"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["奉納物","ほうのうぶつ"],["と"],["せよ"],["。"],["そう"],["すれば"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["、"],["あなた"],["と"],["あなた"],["と"],["共","とも"],["に"],["いる"],["子","こ"],["ら"],["に"],["永久","えいきゅう"],["に"],["与えられた","あたえられた"],["分","ぶん"],["と"],["なる"],["。"]]},{"verse":16,"text":"モーセは贖罪の献げ物の雄山羊を捜し回ったが、既に燃やし尽くされていた。モーセは怒って、生き残ったアロンの子エルアザルとイタマルに問いただした。","tok":[["モーセ"],["は"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["の"],["雄山羊","おすやぎ"],["を"],["捜し回った","さがしまわった"],["が"],["、"],["既に","すでに"],["燃やし","もやし"],["尽くされて","つくされて"],["いた"],["。"],["モーセ"],["は"],["怒って","おこって"],["、"],["生き残った","いきのこった"],["アロン"],["の"],["子","こ"],["エルアザル"],["と"],["イタマル"],["に"],["問いただした","といただした"],["。"]]},{"verse":17,"text":"「なぜ贖罪の献げ物を聖域で食べなかったのか。あれは神聖なものであり、共同体の罪を取り除き、主の御前で彼らの罪を贖う儀式を行うためにあなたたちに与えられたものである。","tok":[["「"],["なぜ"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["を"],["聖域","せいいき"],["で"],["食べなかった","たべなかった"],["の"],["か"],["。"],["あれ"],["は"],["神聖","しんせい"],["な"],["もの"],["で"],["あり"],["、"],["共同体","きょうどうたい"],["の"],["罪","つみ"],["を"],["取り除き","とりのぞき"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["贖う","あがなう"],["儀式","ぎしき"],["を"],["行う","おこなう"],["ため"],["に"],["あなた"],["たち"],["に"],["与えられた","あたえられた"],["もの"],["で"],["ある"],["。"]]},{"verse":18,"text":"あなたたちは、血を聖所に持って行かなかったのだから、命じられたとおりに、聖所の中で食べるべきであった。」","tok":[["あなた"],["たち"],["は"],["、"],["血","ち"],["を"],["聖","せい"],["所","しょ"],["に"],["持って","もって"],["行かなかった","いかなかった"],["の"],["だ"],["から"],["、"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["聖","せい"],["所","しょ"],["の"],["中","なか"],["で"],["食べるべきで","たべるべきで"],["あった"],["。"],["」"]]},{"verse":19,"text":"アロンはモーセに答えた。「確かにあの者たちは今日、贖罪の献げ物と焼き尽くす献げ物を主の御前にささげました。しかし、わたしにこのようなことが起きてしまいました。わたしが今日、贖罪の献げ物を食べたとしたら、果たして主に喜ばれたでしょうか。」","tok":[["アロン"],["は"],["モーセ"],["に"],["答えた","こたえた"],["。"],["「"],["確か","たしか"],["に"],["あの"],["者","もの"],["たち"],["は"],["今日","きょう"],["、"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["と"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["ささげました"],["。"],["しかし"],["、"],["わたし"],["に"],["この"],["よう"],["な"],["こと"],["が"],["起きて","おきて"],["しまいました"],["。"],["わたし"],["が"],["今日","きょう"],["、"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["を"],["食べた","たべた"],["と"],["したら"],["、"],["果たして","はたして"],["主に","おもに"],["喜ばれたでしょう","よろこばれたでしょう"],["か"],["。"],["」"]]},{"verse":20,"text":"モーセはこれを聞いて納得した。","tok":[["モーセ"],["は"],["これ"],["を"],["聞いて","きいて"],["納得","なっとく"],["した"],["。"]]}]
[{"verse":1,"text":"主はモーセに言われた。アロンの子である祭司たちに告げてこう言いなさい。親族の遺体に触れて身を汚してはならない。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["アロン"],["の"],["子","こ"],["で"],["ある"],["祭司","さいし"],["たち"],["に"],["告げて","つげて"],["こう"],["言い","いい"],["なさい"],["。"],["親族","しんぞく"],["の"],["遺体","いたい"],["に"],["触れて","ふれて"],["身","み"],["を"],["汚して","よごして"],["は"],["ならない"],["。"]]},{"verse":2,"text":"ただし、近親、すなわち、父母、息子、娘、兄弟、","tok":[["ただし"],["、"],["近親","きんしん"],["、"],["すなわち"],["、"],["父母","ふぼ"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["兄弟","きょうだい"],["、"]]},{"verse":3,"text":"および同居している未婚の姉妹の場合は許される。","tok":[["および"],["同居","どうきょ"],["して"],["いる"],["未婚","みこん"],["の"],["姉妹","しまい"],["の"],["場合","ばあい"],["は"],["許される","ゆるされる"],["。"]]},{"verse":4,"text":"間違っても、親族の遺体に触れて、身を汚すことがあってはならない。","tok":[["間違って","まちがって"],["も"],["、"],["親族","しんぞく"],["の"],["遺体","いたい"],["に"],["触れて","ふれて"],["、"],["身","み"],["を"],["汚す","けがす"],["こと"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":5,"text":"また、頭髪の一部をそり上げたり、ひげの両端をそり落としたり、身を傷つけたりしてはならない。","tok":[["また"],["、"],["頭髪","とうはつ"],["の"],["一部","いちぶ"],["を"],["そり"],["上げ","あげ"],["たり"],["、"],["ひげ"],["の"],["両端","りょうたん"],["を"],["そり落とし","そりおとし"],["たり"],["、"],["身","み"],["を"],["傷つけ","きずつけ"],["たり"],["して"],["は"],["ならない"],["。"]]},{"verse":6,"text":"神に属する聖なる者であるように、神の名を汚さないようにしなければならない。祭司は、燃やして主にささげる神の食物を携えるのであるから、聖なる者でなければならない。","tok":[["神","かみ"],["に"],["属する","ぞくする"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["よう"],["に"],["、"],["神","かみ"],["の"],["名","な"],["を"],["汚さない","よごさない"],["よう"],["に"],["しなければ"],["ならない"],["。"],["祭司","さいし"],["は"],["、"],["燃やして","もやして"],["主に","おもに"],["ささげる"],["神","かみ"],["の"],["食物","しょくもつ"],["を"],["携える","たずさえる"],["ので"],["ある"],["から"],["、"],["聖","せい"],["なる"],["者","もの"],["で"],["なければ"],["ならない"],["。"]]},{"verse":7,"text":"遊女となって身を汚した女、あるいは離縁された女をめとってはならない。祭司は神に属する聖なる者だからである。","tok":[["遊女","ゆうじょ"],["と"],["なって"],["身","み"],["を"],["汚した","よごした"],["女","おんな"],["、"],["あるいは"],["離縁","りえん"],["された"],["女","おんな"],["を"],["めとって"],["は"],["ならない"],["。"],["祭司","さいし"],["は"],["神","かみ"],["に"],["属する","ぞくする"],["聖","せい"],["なる"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたは彼を聖なる者とせよ。神の食物をささげる身だからである。彼はあなたに属する聖なる者でなければならない。わたしはあなたたちを聖別する主、聖なる者だからである。","tok":[["あなた"],["は"],["彼","かれ"],["を"],["聖","せい"],["なる"],["者","もの"],["と"],["せよ"],["。"],["神","かみ"],["の"],["食物","しょくもつ"],["を"],["ささげる"],["身","み"],["だ"],["から"],["で"],["ある"],["。"],["彼","かれ"],["は"],["あなた"],["に"],["属する","ぞくする"],["聖","せい"],["なる"],["者","もの"],["で"],["なければ"],["ならない"],["。"],["わたし"],["は"],["あなた"],["たち"],["を"],["聖別","せいべつ"],["する"],["主","ぬし"],["、"],["聖","せい"],["なる"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"祭司の娘が遊女となって、身を汚すならば、彼女は父を汚す者であるから、彼女を焼き殺さねばならない。","tok":[["祭司","さいし"],["の"],["娘","むすめ"],["が"],["遊女","ゆうじょ"],["と"],["なって"],["、"],["身","み"],["を"],["汚すならば","よごすならば"],["、"],["彼女","かのじょ"],["は"],["父","ちち"],["を"],["汚す","けがす"],["者","もの"],["で"],["ある"],["から"],["、"],["彼女","かのじょ"],["を"],["焼き殺さねば","やきころさねば"],["ならない"],["。"]]},{"verse":10,"text":"同僚の祭司たちの上位に立ち、聖別の油を頭に注がれ、祭司の職に任ぜられ、そのための祭服を着る身となった者は、髪をほどいたり、衣服を裂いたりしてはならない。","tok":[["同僚","どうりょう"],["の"],["祭司","さいし"],["たち"],["の"],["上位","じょうい"],["に"],["立ち","たち"],["、"],["聖別","せいべつ"],["の"],["油","あぶら"],["を"],["頭","あたま"],["に"],["注がれ","そそがれ"],["、"],["祭司","さいし"],["の"],["職","しょく"],["に"],["任ぜられ","にんぜられ"],["、"],["その"],["ため"],["の"],["祭服","さいふく"],["を"],["着る","きる"],["身","み"],["と"],["なった"],["者","もの"],["は"],["、"],["髪","かみ"],["を"],["ほどい"],["たり"],["、"],["衣服","いふく"],["を"],["裂い","さい"],["たり"],["して"],["は"],["ならない"],["。"]]},{"verse":11,"text":"自分の父母の遺体であっても、近づいて身を汚してはならない。","tok":[["自分","じぶん"],["の"],["父母","ふぼ"],["の"],["遺体","いたい"],["で"],["あって"],["も"],["、"],["近づいて","ちかづいて"],["身","み"],["を"],["汚して","よごして"],["は"],["ならない"],["。"]]},{"verse":12,"text":"聖所を離れて、神の聖所を汚してはならない。彼は神の聖別の油を頭に注がれている者だからである。わたしは主である。","tok":[["聖","せい"],["所","しょ"],["を"],["離れて","はなれて"],["、"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["神","かみ"],["の"],["聖別","せいべつ"],["の"],["油","あぶら"],["を"],["頭","あたま"],["に"],["注がれて","そそがれて"],["いる"],["者","もの"],["だ"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":13,"text":"祭司は処女をめとらねばならない。","tok":[["祭司","さいし"],["は"],["処女","しょじょ"],["を"],["めとらねば"],["ならない"],["。"]]},{"verse":14,"text":"やもめ、離縁された女、遊女となって身を汚した女などをめとってはならない。一族から処女をめとらねばならない。","tok":[["やもめ"],["、"],["離縁","りえん"],["された"],["女","おんな"],["、"],["遊女","ゆうじょ"],["と"],["なって"],["身","み"],["を"],["汚した","よごした"],["女","おんな"],["など"],["を"],["めとって"],["は"],["ならない"],["。"],["一族","いちぞく"],["から"],["処女","しょじょ"],["を"],["めとらねば"],["ならない"],["。"]]},{"verse":15,"text":"一族に汚れた子孫を残してはならない。わたしは彼を聖別した主だからである。","tok":[["一族","いちぞく"],["に"],["汚れた","よごれた"],["子孫","しそん"],["を"],["残して","のこして"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["聖別","せいべつ"],["した"],["主","ぬし"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":17,"text":"アロンに告げなさい。あなたの子孫のうちで、障害のある者は、代々にわたって、神に食物をささげる務めをしてはならない。","tok":[["アロン"],["に"],["告げ","つげ"],["なさい"],["。"],["あなた"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["、"],["障害","しょうがい"],["の"],["ある"],["者","もの"],["は"],["、"],["代々","だいだい"],["に"],["わたって"],["、"],["神","かみ"],["に"],["食物","しょくもつ"],["を"],["ささげる"],["務め","つとめ"],["を"],["して"],["は"],["ならない"],["。"]]},{"verse":18,"text":"だれでも、障害のある者、すなわち、目や足の不自由な者、鼻に欠陥のある者、手足の不釣り合いの者、","tok":[["だれ"],["で"],["も"],["、"],["障害","しょうがい"],["の"],["ある"],["者","もの"],["、"],["すなわち"],["、"],["目","め"],["や"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["者","もの"],["、"],["鼻","はな"],["に"],["欠陥","けっかん"],["の"],["ある"],["者","もの"],["、"],["手足","てあし"],["の"],["不釣り合い","ふつりあい"],["の"],["者","もの"],["、"]]},{"verse":19,"text":"手足の折れた者、","tok":[["手足","てあし"],["の"],["折れた","おれた"],["者","もの"],["、"]]},{"verse":20,"text":"背中にこぶのある者、目が弱く欠陥のある者、できものや疥癬のある者、睾丸のつぶれた者など、","tok":[["背中","せなか"],["に"],["こぶ"],["の"],["ある"],["者","もの"],["、"],["目","め"],["が"],["弱く","よわく"],["欠陥","けっかん"],["の"],["ある"],["者","もの"],["、"],["できもの"],["や"],["疥癬","かいせん"],["の"],["ある"],["者","もの"],["、"],["睾丸","こうがん"],["の"],["つぶれた"],["者","もの"],["など"],["、"]]},{"verse":21,"text":"祭司アロンの子孫のうちで、以上の障害のある者はだれでも、主に燃やしてささげる献げ物の務めをしてはならない。彼には障害があるから、神に食物をささげる務めをしてはならない。","tok":[["祭司","さいし"],["アロン"],["の"],["子孫","しそん"],["の"],["うち"],["で"],["、"],["以上","いじょう"],["の"],["障害","しょうがい"],["の"],["ある"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["主に","おもに"],["燃やして","もやして"],["ささげる"],["献げ物","ささげもの"],["の"],["務め","つとめ"],["を"],["して"],["は"],["ならない"],["。"],["彼","かれ"],["に"],["は"],["障害","しょうがい"],["が"],["ある"],["から"],["、"],["神","かみ"],["に"],["食物","しょくもつ"],["を"],["ささげる"],["務め","つとめ"],["を"],["して"],["は"],["ならない"],["。"]]},{"verse":22,"text":"しかし、神の食物としてささげられたものは、神聖なる物も聖なる献げ物も食べることができる。","tok":[["しかし"],["、"],["神","かみ"],["の"],["食物","しょくもつ"],["として"],["ささげられた"],["もの"],["は"],["、"],["神聖","しんせい"],["なる"],["物","もの"],["も"],["聖","せい"],["なる"],["献げ物","ささげもの"],["も"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":23,"text":"ただし、彼には障害があるから、垂れ幕の前に進み出たり、祭壇に近づいたりして、わたしの聖所を汚してはならない。わたしが、それらを聖別した主だからである。","tok":[["ただし"],["、"],["彼","かれ"],["に"],["は"],["障害","しょうがい"],["が"],["ある"],["から"],["、"],["垂れ幕","たれまく"],["の"],["前","まえ"],["に"],["進み出","すすみで"],["たり"],["、"],["祭壇","さいだん"],["に"],["近づい","ちかづい"],["たり"],["して"],["、"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["わたし"],["が"],["、"],["それ"],["ら"],["を"],["聖別","せいべつ"],["した"],["主","ぬし"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"モーセは以上のことをアロン、その子らおよびイスラエルのすべての人々に告げた。","tok":[["モーセ"],["は"],["以上","いじょう"],["の"],["こと"],["を"],["アロン"],["、"],["その"],["子","こ"],["ら"],["および"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["告げた","つげた"],["。"]]}]
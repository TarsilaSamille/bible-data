[{"verse":1,"text":"主はモーセにこう仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["こう"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":2,"text":"イスラエルの人々に告げてこう言いなさい。わたしはあなたたちの神、主である。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["に"],["告げて","つげて"],["こう"],["言い","いい"],["なさい"],["。"],["わたし"],["は"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたたちがかつて住んでいたエジプトの国の風習や、わたしがこれからあなたたちを連れて行くカナンの風習に従ってはならない。その掟に従って歩んではならない。","tok":[["あなた"],["たち"],["が"],["かつて"],["住んで","すんで"],["いた"],["エジプト"],["の"],["国","くに"],["の"],["風習","ふうしゅう"],["や"],["、"],["わたし"],["が"],["これ"],["から"],["あなた"],["たち"],["を"],["連れて","つれて"],["行く","いく"],["カナン"],["の"],["風習","ふうしゅう"],["に"],["従って","したがって"],["は"],["ならない"],["。"],["その"],["掟","おきて"],["に"],["従って","したがって"],["歩んで","あゆんで"],["は"],["ならない"],["。"]]},{"verse":4,"text":"わたしの法を行い、わたしの掟を守り、それに従って歩みなさい。わたしはあなたたちの神、主である。","tok":[["わたし"],["の"],["法","ほう"],["を"],["行い","おこない"],["、"],["わたし"],["の"],["掟","おきて"],["を"],["守り","まもり"],["、"],["それ"],["に"],["従って","したがって"],["歩み","あゆみ"],["なさい"],["。"],["わたし"],["は"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":5,"text":"わたしの掟と法とを守りなさい。これらを行う人はそれによって命を得ることができる。わたしは主である。","tok":[["わたし"],["の"],["掟","おきて"],["と"],["法","ほう"],["と"],["を"],["守り","まもり"],["なさい"],["。"],["これ"],["ら"],["を"],["行う","おこなう"],["人","ひと"],["は"],["それ"],["によって"],["命","いのち"],["を"],["得る","える"],["こと"],["が"],["できる"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":6,"text":"肉親の女性に近づいてこれを犯してはならない。わたしは主である。","tok":[["肉親","にくしん"],["の"],["女性","じょせい"],["に"],["近づいて","ちかづいて"],["これ"],["を"],["犯して","おかして"],["は"],["ならない"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":7,"text":"母を犯し、父を辱めてはならない。彼女はあなたの実母である。彼女を犯してはならない。","tok":[["母","はは"],["を"],["犯し","おかし"],["、"],["父","ちち"],["を"],["辱めて","はずかしめて"],["は"],["ならない"],["。"],["彼女","かのじょ"],["は"],["あなた"],["の"],["実母","じつぼ"],["で"],["ある"],["。"],["彼女","かのじょ"],["を"],["犯して","おかして"],["は"],["ならない"],["。"]]},{"verse":8,"text":"父の妻を犯してはならない。父を辱めることだからである。","tok":[["父","ちち"],["の"],
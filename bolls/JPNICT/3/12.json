[{"verse":1,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":2,"text":"イスラエルの人々に告げてこう言いなさい。妊娠して男児を出産したとき、産婦は月経による汚れの日数と同じ七日間汚れている。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["に"],["告げて","つげて"],["こう"],["言い","いい"],["なさい"],["。"],["妊娠","にんしん"],["して"],["男児","だんじ"],["を"],["出産","しゅっさん"],["した"],["とき"],["、"],["産婦","さんぷ"],["は"],["月経","げっけい"],["に"],["よる"],["汚れ","よごれ"],["の"],["日数","にっすう"],["と"],["同じ","おなじ"],["七","なな"],["日間","かかん"],["汚れて","よごれて"],["いる"],["。"]]},{"verse":3,"text":"八日目にはその子の包皮に割礼を施す。","tok":[["八日目","ようかめ"],["に"],["は"],["その"],["子","こ"],["の"],["包皮","ほうひ"],["に"],["割礼","かつれい"],["を"],["施す","ほどこす"],["。"]]},{"verse":4,"text":"産婦は出血の汚れが清まるのに必要な三十三日の間、家にとどまる。その清めの期間が完了するまでは、聖なる物に触れたり、聖所にもうでたりしてはならない。","tok":[["産婦","さんぷ"],["は"],["出血","しゅっけつ"],["の"],["汚れ","よごれ"],["が"],["清まる","きよまる"],["のに"],["必要","ひつよう"],["な"],["三十三","さんじゅうさん"],["日","にち"],["の"],["間","あいだ"],["、"],["家","いえ"],["に"],["とどまる"],["。"],["その"],["清め","きよめ"],["の"],["期間","きかん"],["が"],["完了","かんりょう"],["する"],["まで"],["は"],["、"],["聖","せい"],["なる"],["物","もの"],["に"],["触れ","ふれ"],["たり"],["、"],["聖","せい"],["所","しょ"],["に"],["もう"],["で"],["たり"],["して"],["は"],["ならない"],["。"]]},{"verse":5,"text":"女児を出産したとき、産婦は月経による汚れの場合に準じて、十四日間汚れている。産婦は出血の汚れが清まるのに必要な六十六日の間、家にとどまる。","tok":[["女児","じょじ"],["を"],["出産","しゅっさん"],["した"],["とき"],["、"],["産婦","さんぷ"],["は"],["月経","げっけい"],["に"],["よる"],["汚れ","よごれ"],["の"],["場合","ばあい"],["に"],["準じて","じゅんじて"],["、"],["十四","じゅうよん"],["日間","かかん"],["汚れて","よごれて"],["いる"],["。"],["産婦","さんぷ"],["は"],["出血","しゅっけつ"],["の"],["汚れ","よごれ"],["が"],["清まる","きよまる"],["のに"],["必要","ひつよう"],["な"],["六十六","ろくじゅうろく"],["日","にち"],["の"],["間","あいだ"],["、"],["家","いえ"],["に"],["とどまる"],["。"]]},{"verse":6,"text":"男児もしくは女児を出産した産婦の清めの期間が完了したならば、産婦は一歳の雄羊一匹を焼き尽くす献げ物とし、家鳩または山鳩一羽を贖罪の献げ物として臨在の幕屋の入り口に携えて行き、祭司に渡す。","tok":[["男児","だんじ"],["もしくは"],["女児","じょじ"],["を"],["出産","しゅっさん"],["した"],["産婦","さんぷ"],["の"],["清め","きよめ"],["の"],["期間","きかん"],["が"],["完了","かんりょう"],["したならば"],["、"],["産婦","さんぷ"],["は"],["一歳","いちさい"],["の"],["雄羊","おひつじ"],["一匹","いちひき"],["を"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["し"],["、"],["家鳩","いえばと"],["また"],["は"],["山鳩","やまばと"],["一羽","ひとわ"],["を"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["として"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["携えて","たずさえて"],["行き","いき"],["、"],["祭司","さいし"],["に"],["渡す","わたす"],["。"]]},{"verse":7,"text":"祭司がそれを主の御前にささげて、産婦のために贖いの儀式を行うと、彼女は出血の汚れから清められる。これが男児もしくは女児を出産した産婦についての指示である。","tok":[["祭司","さいし"],["が"],["それ"],["を"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["ささげて"],["、"],["産婦","さんぷ"],["の"],["ため"],["に"],["贖い","あがない"],["の"],["儀式","ぎしき"],["を"],["行う","おこなう"],["と"],["、"],["彼女","かのじょ"],["は"],["出血","しゅっけつ"],["の"],["汚れ","よごれ"],["から"],["清められる","きよめられる"],["。"],["これ"],["が"],["男児","だんじ"],["もしくは"],["女児","じょじ"],["を"],["出産","しゅっさん"],["した"],["産婦","さんぷ"],["について"],["の"],["指示","しじ"],["で"],["ある"],["。"]]},{"verse":8,"text":"なお産婦が貧しくて小羊に手が届かない場合は、二羽の山鳩または二羽の家鳩を携えて行き、一羽を焼き尽くす献げ物とし、もう一羽を贖罪の献げ物とする。祭司が産婦のために贖いの儀式を行うと、彼女は清められる。","tok":[["なお"],["産婦","さんぷ"],["が"],["貧しくて","まずしくて"],["小羊","こひつじ"],["に"],["手","て"],["が"],["届かない","とどかない"],["場合","ばあい"],["は"],["、"],["二羽","ふたわ"],["の"],["山鳩","やまばと"],["また"],["は"],["二羽","ふたわ"],["の"],["家鳩","いえばと"],["を"],["携えて","たずさえて"],["行き","いき"],["、"],["一羽","ひとわ"],["を"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["し"],["、"],["もう"],["一羽","ひとわ"],["を"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["と"],["する"],["。"],["祭司","さいし"],["が"],["産婦","さんぷ"],["の"],["ため"],["に"],["贖い","あがない"],["の"],["儀式","ぎしき"],["を"],["行う","おこなう"],["と"],["、"],["彼女","かのじょ"],["は"],["清められる","きよめられる"],["。"]]}]
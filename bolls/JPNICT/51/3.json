[{"verse":1,"text":"さて、あなたがたは、キリストと共に復活させられたのですから、上にあるものを求めなさい。そこでは、キリストが神の右の座に着いておられます。","tok":[["さて"],["、"],["あなた"],["がた"],["は"],["、"],["キリスト"],["と"],["共","とも"],["に"],["復活","ふっかつ"],["させられた"],["の"],["です"],["から"],["、"],["上","うえ"],["に"],["ある"],["もの"],["を"],["求め","もとめ"],["なさい"],["。"],["そこ"],["で"],["は"],["、"],["キリスト"],["が"],["神","かみ"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着いて","ついて"],["おられます"],["。"]]},{"verse":2,"text":"上にあるものに心を留め、地上のものに心を引かれないようにしなさい。","tok":[["上","うえ"],["に"],["ある"],["もの"],["に"],["心","こころ"],["を"],["留め","とめ"],["、"],["地上","ちじょう"],["の"],["もの"],["に"],["心","こころ"],["を"],["引かれない","ひかれない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":3,"text":"あなたがたは死んだのであって、あなたがたの命は、キリストと共に神の内に隠されているのです。","tok":[["あなた"],["がた"],["は"],["死んだ","しんだ"],["ので"],["あって"],["、"],["あなた"],["がた"],["の"],["命","いのち"],["は"],["、"],["キリスト"],["と"],["共","とも"],["に"],["神","かみ"],["の"],["内","うち"],["に"],["隠されて","かくされて"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"あなたがたの命であるキリストが現れるとき、あなたがたも、キリストと共に栄光に包まれて現れるでしょう。","tok":[["あなた"],["がた"],["の"],["命","いのち"],["で"],["ある"],["キリスト"],["が"],["現れる","あらわれる"],["とき"],["、"],["あなた"],["がた"],["も"],["、"],["キリスト"],["と"],["共","とも"],["に"],["栄光","えいこう"],["に"],["包まれて","つつまれて"],["現れるでしょう","あらわれるでしょう"],["。"]]},{"verse":5,"text":"だから、地上的なもの、すなわち、みだらな行い、不潔な行い、情欲、悪い欲望、および貪欲を捨て去りなさい。貪欲は偶像礼拝にほかならない。","tok":[["だ"],["から"],["、"],["地上","ちじょう"],["的","てき"],["な"],["もの"],["、"],["すなわち"],["、"],["みだら"],["な"],["行い","おこない"],["、"],["不潔","ふけつ"],["な"],["行い","おこない"],["、"],["情欲","じょうよく"],["、"],["悪い","わるい"],["欲望","よくぼう"],["、"],["および"],["貪欲","とんよく"],["を"],["捨て去り","すてさり"],["なさい"],["。"],["貪欲","とんよく"],["は"],["偶像","ぐうぞう"],["礼拝","れいはい"],["に"],["ほか"],["ならない"],["。"]]},{"verse":6,"text":"これらのことのゆえに、神の怒りは不従順な者たちに下ります。","tok":[["これ"],["ら"],["の"],["こと"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["の"],["怒り","いかり"],["は"],["不","ふ"],["従順","じゅうじゅん"],["な"],["者","もの"],["たち"],["に"],["下ります","おります"],["。"]]},{"verse":7,"text":"あなたがたも、以前このようなことの中にいたときには、それに従って歩んでいました。","tok":[["あなた"],["がた"],["も"],["、"],["以前","いぜん"],["この"],["よう"],["な"],["こと"],["の"],["中","なか"],["に"],["いた"],["とき"],["に"],["は"],["、"],["それ"],["に"],["従って","したがって"],["歩んで","あゆんで"],["いました"],["。"]]},{"verse":8,"text":"今は、そのすべてを、すなわち、怒り、憤り、悪意、そしり、口から出る恥ずべき言葉を捨てなさい。","tok":[["今","いま"],["は"],["、"],["その"],["すべて"],["を"],["、"],["すなわち"],["、"],["怒り","いかり"],["、"],["憤り","いきどおり"],["、"],["悪意","あくい"],["、"],["そしり"],["、"],["口","くち"],["から"],["出る","でる"],["恥ずべき","はずべき"],["言葉","ことば"],["を"],["捨て","すて"],["なさい"],["。"]]},{"verse":9,"text":"互いにうそをついてはなりません。古い人をその行いと共に脱ぎ捨て、","tok":[["互い","たがい"],["に"],["うそ"],["を"],["ついて"],["は"],["なりません"],["。"],["古い","ふるい"],["人","ひと"],["を"],["その"],["行い","おこない"],["と"],["共","とも"],["に"],["脱ぎ捨て","ぬぎすて"],["、"]]},{"verse":10,"text":"造り主の姿に倣う新しい人を身に着け、日々新たにされて、真の知識に達するのです。","tok":[["造り主","つくりぬし"],["の"],["姿","すがた"],["に"],["倣う","ならう"],["新しい","あたらしい"],["人","ひと"],["を"],["身","み"],["に"],["着け","つけ"],["、"],["日々","ひび"],["新た","あらた"],["に"],["されて"],["、"],["真","しん"],["の"],["知識","ちしき"],["に"],["達する","たっする"],["の"],["です"],["。"]]},{"verse":11,"text":"そこには、もはや、ギリシア人とユダヤ人、割礼を受けた者と受けていない者、未開人、スキタイ人、奴隷、自由な身分の者の区別はありません。キリストがすべてであり、すべてのもののうちにおられるのです。","tok":[["そこ"],["に"],["は"],["、"],["もはや"],["、"],["ギリシア"],["人","にん"],["と"],["ユダヤ人","ゆだやじん"],["、"],["割礼","かつれい"],["を"],["受けた","うけた"],["者","もの"],["と"],["受けて","うけて"],["いない"],["者","もの"],["、"],["未開人","みかいにん"],["、"],["スキタイ"],["人","にん"],["、"],["奴隷","どれい"],["、"],["自由","じゆう"],["な"],["身分","みぶん"],["の"],["者","もの"],["の"],["区別","くべつ"],["は"],["ありません"],["。"],["キリスト"],["が"],["すべて"],["で"],["あり"],["、"],["すべて"],["の"],["もの"],["の"],["うち"],["に"],["おられる"],["の"],["です"],["。"]]},{"verse":12,"text":"あなたがたは神に選ばれ、聖なる者とされ、愛されているのですから、憐れみの心、慈愛、謙遜、柔和、寛容を身に着けなさい。","tok":[["あなた"],["がた"],["は"],["神","かみ"],["に"],["選ばれ","えらばれ"],["、"],["聖","せい"],["なる"],["者","もの"],["と"],["され"],["、"],["愛されて","あいされて"],["いる"],["の"],["です"],["から"],["、"],["憐れみ","あわれみ"],["の"],["心","こころ"],["、"],["慈愛","じあい"],["、"],["謙遜","けんそん"],["、"],["柔和","にゅうわ"],["、"],["寛容","かんよう"],["を"],["身","み"],["に"],["着け","つけ"],["なさい"],["。"]]},{"verse":13,"text":"互いに忍び合い、責めるべきことがあっても、赦し合いなさい。主があなたがたを赦してくださったように、あなたがたも同じようにしなさい。","tok":[["互い","たがい"],["に"],["忍び","しのび"],["合い","あい"],["、"],["責めるべき","せめるべき"],["こと"],["が"],["あって"],["も"],["、"],["赦し","ゆるし"],["合い","あい"],["なさい"],["。"],["主","ぬし"],["が"],["あなた"],["がた"],["を"],["赦して","ゆるして"],["くださった"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["同じ","おなじ"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":14,"text":"これらすべてに加えて、愛を身に着けなさい。愛は、すべてを完成させるきずなです。","tok":[["これ"],["ら"],["すべて"],["に"],["加えて","くわえて"],["、"],["愛","あい"],["を"],["身","み"],["に"],["着け","つけ"],["なさい"],["。"],["愛","あい"],["は"],["、"],["すべて"],["を"],["完成","かんせい"],["させる"],["きずな"],["です"],["。"]]},{"verse":15,"text":"また、キリストの平和があなたがたの心を支配するようにしなさい。この平和にあずからせるために、あなたがたは招かれて一つの体とされたのです。いつも感謝していなさい。","tok":[["また"],["、"],["キリスト"],["の"],["平和","へいわ"],["が"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["支配","しはい"],["する"],["よう"],["に"],["し"],["なさい"],["。"],["この"],["平和","へいわ"],["に"],["あずからせる"],["ため"],["に"],["、"],["あなた"],["がた"],["は"],["招かれて","まねかれて"],["一","ひと"],["つ"],["の"],["体","からだ"],["と"],["された"],["の"],["です"],["。"],["いつも"],["感謝","かんしゃ"],["して"],["い"],["なさい"],["。"]]},{"verse":16,"text":"キリストの言葉があなたがたの内に豊かに宿るようにしなさい。知恵を尽くして互いに教え、諭し合い、詩編と賛歌と霊的な歌により、感謝して心から神をほめたたえなさい。","tok":[["キリスト"],["の"],["言葉","ことば"],["が"],["あなた"],["がた"],["の"],["内","うち"],["に"],["豊か","ゆたか"],["に"],["宿る","やどる"],["よう"],["に"],["し"],["なさい"],["。"],["知恵","ちえ"],["を"],["尽くして","つくして"],["互い","たがい"],["に"],["教え","おしえ"],["、"],["諭し","さとし"],["合い","あい"],["、"],["詩編","しへん"],["と"],["賛歌","さんか"],["と"],["霊的","れいてき"],["な"],["歌","うた"],["に"],["より"],["、"],["感謝","かんしゃ"],["して"],["心","こころ"],["から"],["神","かみ"],["を"],["ほめたたえ"],["なさい"],["。"]]},{"verse":17,"text":"そして、何を話すにせよ、行うにせよ、すべてを主イエスの名によって行い、イエスによって、父である神に感謝しなさい。","tok":[["そして"],["、"],["何","なん"],["を"],["話す","はなす"],["に"],["せよ"],["、"],["行う","おこなう"],["に"],["せよ"],["、"],["すべて"],["を"],["主","ぬし"],["イエス"],["の"],["名","な"],["によって"],["行い","おこない"],["、"],["イエス"],["によって"],["、"],["父","ちち"],["で"],["ある"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["なさい"],["。"]]},{"verse":18,"text":"妻たちよ、主を信じる者にふさわしく、夫に仕えなさい。","tok":[["妻たち","つまたち"],["よ"],["、"],["主","ぬし"],["を"],["信じる","しんじる"],["者","もの"],["に"],["ふさわしく"],["、"],["夫","おっと"],["に"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":19,"text":"夫たちよ、妻を愛しなさい。つらく当たってはならない。","tok":[["夫","おっと"],["たち"],["よ"],["、"],["妻","つま"],["を"],["愛し","あいし"],["なさい"],["。"],["つらく"],["当たって","あたって"],["は"],["ならない"],["。"]]},{"verse":20,"text":"子供たち、どんなことについても両親に従いなさい。それは主に喜ばれることです。","tok":[["子供","こども"],["たち"],["、"],["どんな"],["こと"],["について"],["も"],["両親","りょうしん"],["に"],["従い","したがい"],["なさい"],["。"],["それ"],["は"],["主に","おもに"],["喜ばれる","よろこばれる"],["こと"],["です"],["。"]]},{"verse":21,"text":"父親たち、子供をいらだたせてはならない。いじけるといけないからです。","tok":[["父親","ちちおや"],["たち"],["、"],["子供","こども"],["を"],["いらだたせて"],["は"],["ならない"],["。"],["いじける"],["と"],["いけない"],["から"],["です"],["。"]]},{"verse":22,"text":"奴隷たち、どんなことについても肉による主人に従いなさい。人にへつらおうとしてうわべだけで仕えず、主を畏れつつ、真心を込めて従いなさい。","tok":[["奴隷","どれい"],["たち"],["、"],["どんな"],["こと"],["について"],["も"],["肉","にく"],["に"],["よる"],["主人","しゅじん"],["に"],["従い","したがい"],["なさい"],["。"],["人","ひと"],["に"],["へつらおう"],["として"],["うわべ"],["だけ"],["で"],["仕えず","つかえず"],["、"],["主","ぬし"],["を"],["畏れ","おそれ"],["つつ"],["、"],["真心","まごころ"],["を"],["込めて","こめて"],["従い","したがい"],["なさい"],["。"]]},{"verse":23,"text":"何をするにも、人に対してではなく、主に対してするように、心から行いなさい。","tok":[["何","なん"],["を"],["する"],["に"],["も"],["、"],["人","ひと"],["に対して","にたいして"],["で"],["は"],["なく"],["、"],["主に","おもに"],["対して","たいして"],["する"],["よう"],["に"],["、"],["心","こころ"],["から"],["行い","おこない"],["なさい"],["。"]]},{"verse":24,"text":"あなたがたは、御国を受け継ぐという報いを主から受けることを知っています。あなたがたは主キリストに仕えているのです。","tok":[["あなた"],["がた"],["は"],["、"],["御国","みくに"],["を"],["受け継ぐ","うけつぐ"],["と"],["いう"],["報い","むくい"],["を"],["主","ぬし"],["から"],["受ける","うける"],["こと"],["を"],["知って","しって"],["います"],["。"],["あなた"],["がた"],["は"],["主","しゅ"],["キリスト"],["に"],["仕えて","つかえて"],["いる"],["の"],["です"],["。"]]},{"verse":25,"text":"不義を行う者は、その不義の報いを受けるでしょう。そこには分け隔てはありません。","tok":[["不義","ふぎ"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["その"],["不義","ふぎ"],["の"],["報い","むくい"],["を"],["受けるでしょう","うけるでしょう"],["。"],["そこ"],["に"],["は"],["分け隔て","わけへだて"],["は"],["ありません"],["。"]]}]
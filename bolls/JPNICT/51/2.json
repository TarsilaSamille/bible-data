[{"verse":1,"text":"わたしが、あなたがたとラオディキアにいる人々のために、また、わたしとまだ直接顔を合わせたことのないすべての人のために、どれほど労苦して闘っているか、分かってほしい。","tok":[["わたし"],["が"],["、"],["あなた"],["がた"],["と"],["ラオディキア"],["に"],["いる"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["また"],["、"],["わたし"],["と"],["まだ"],["直接","ちょくせつ"],["顔","かお"],["を"],["合わせた","あわせた"],["こと"],["の"],["ない"],["すべて"],["の"],["人","ひと"],["の"],["ため"],["に"],["、"],["どれ"],["ほど"],["労苦","ろうく"],["して"],["闘って","たたかって"],["いる"],["か"],["、"],["分かって","わかって"],["ほしい"],["。"]]},{"verse":2,"text":"それは、この人々が心を励まされ、愛によって結び合わされ、理解力を豊かに与えられ、神の秘められた計画であるキリストを悟るようになるためです。","tok":[["それ"],["は"],["、"],["この"],["人々","ひとびと"],["が"],["心","こころ"],["を"],["励まされ","はげまされ"],["、"],["愛","あい"],["によって"],["結び合わされ","むすびあわされ"],["、"],["理解力","りかいりょく"],["を"],["豊か","ゆたか"],["に"],["与えられ","あたえられ"],["、"],["神","かみ"],["の"],["秘められた","ひめられた"],["計画","けいかく"],["で"],["ある"],["キリスト"],["を"],["悟る","さとる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":3,"text":"知恵と知識の宝はすべて、キリストの内に隠れています。","tok":[["知恵","ちえ"],["と"],["知識","ちしき"],["の"],["宝","たから"],["は"],["すべて"],["、"],["キリスト"],["の"],["内","うち"],["に"],["隠れて","かくれて"],["います"],["。"]]},{"verse":4,"text":"わたしがこう言うのは、あなたがたが巧みな議論にだまされないようにするためです。","tok":[["わたし"],["が"],["こう"],["言う","いう"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["巧み","たくみ"],["な"],["議論","ぎろん"],["に"],["だまされない"],["よう"],["に"],["する"],["ため"],["です"],["。"]]},{"verse":5,"text":"わたしは体では離れていても、霊ではあなたがたと共にいて、あなたがたの正しい秩序と、キリストに対する固い信仰とを見て喜んでいます。","tok":[["わたし"],["は"],["体","からだ"],["で"],["は"],["離れて","はなれて"],["いて"],["も"],["、"],["霊","れい"],["で"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いて"],["、"],["あなた"],["がた"],["の"],["正しい","ただしい"],["秩序","ちつじょ"],["と"],["、"],["キリスト"],["に"],["対する","たいする"],["固い","かたい"],["信仰","しんこう"],["と"],["を"],["見て","みて"],["喜んで","よろこんで"],["います"],["。"]]},{"verse":6,"text":"あなたがたは、主キリスト‧イエスを受け入れたのですから、キリストに結ばれて歩みなさい。","tok":[["あなた"],["がた"],["は"],["、"],["主","しゅ"],["キリスト"],["‧"],["イエス"],["を"],["受け入れた","うけいれた"],["の"],["です"],["から"],["、"],["キリスト"],["に"],["結ばれて","むすばれて"],["歩み","あゆみ"],["なさい"],["。"]]},{"verse":7,"text":"キリストに根を下ろして造り上げられ、教えられたとおりの信仰をしっかり守って、あふれるばかりに感謝しなさい。","tok":[["キリスト"],["に"],["根","ね"],["を"],["下ろして","おろして"],["造り上げられ","つくりあげられ"],["、"],["教えられた","おしえられた"],["とおり"],["の"],["信仰","しんこう"],["を"],["しっかり"],["守って","まもって"],["、"],["あふれる"],["ばかり"],["に"],["感謝","かんしゃ"],["し"],["なさい"],["。"]]},{"verse":8,"text":"人間の言い伝えにすぎない哲学、つまり、むなしいだまし事によって人のとりこにされないように気をつけなさい。それは、世を支配する霊に従っており、キリストに従うものではありません。","tok":[["人間","にんげん"],["の"],["言い伝え","いいつたえ"],["に"],["すぎない"],["哲学","てつがく"],["、"],["つまり"],["、"],["むなしい"],["だまし"],["事","こと"],["によって"],["人","ひと"],["の"],["とりこ"],["に"],["されない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["それ"],["は"],["、"],["世","よ"],["を"],["支配","しはい"],["する"],["霊","れい"],["に"],["従って","したがって"],["おり"],["、"],["キリスト"],["に"],["従う","したがう"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":9,"text":"キリストの内には、満ちあふれる神性が、余すところなく、見える形をとって宿っており、","tok":[["キリスト"],["の"],["内","うち"],["に"],["は"],["、"],["満ちあふれる","みちあふれる"],["神性","しんせい"],["が"],["、"],["余す","あます"],["ところ"],["なく"],["、"],["見える","みえる"],["形","かたち"],["を"],["とって"],["宿って","やどって"],["おり"],["、"]]},{"verse":10,"text":"あなたがたは、キリストにおいて満たされているのです。キリストはすべての支配や権威の頭です。","tok":[["あなた"],["がた"],["は"],["、"],["キリスト"],["に"],["おいて"],["満たされて","みたされて"],["いる"],["の"],["です"],["。"],["キリスト"],["は"],["すべて"],["の"],["支配","しはい"],["や"],["権威","けんい"],["の"],["頭","あたま"],["です"],["。"]]},{"verse":11,"text":"あなたがたはキリストにおいて、手によらない割礼、つまり肉の体を脱ぎ捨てるキリストの割礼を受け、","tok":[["あなた"],["がた"],["は"],["キリスト"],["に"],["おいて"],["、"],["手","て"],["に"],["よらない"],["割礼","かつれい"],["、"],["つまり"],["肉","にく"],["の"],["体","からだ"],["を"],["脱ぎ捨てる","ぬぎすてる"],["キリスト"],["の"],["割礼","かつれい"],["を"],["受け","うけ"],["、"]]},{"verse":12,"text":"洗礼によって、キリストと共に葬られ、また、キリストを死者の中から復活させた神の力を信じて、キリストと共に復活させられたのです。","tok":[["洗礼","せんれい"],["によって"],["、"],["キリスト"],["と"],["共","とも"],["に"],["葬られ","ほうむられ"],["、"],["また"],["、"],["キリスト"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させた"],["神","かみ"],["の"],["力","ちから"],["を"],["信じて","しんじて"],["、"],["キリスト"],["と"],["共","とも"],["に"],["復活","ふっかつ"],["させられた"],["の"],["です"],["。"]]},{"verse":13,"text":"肉に割礼を受けず、罪の中にいて死んでいたあなたがたを、神はキリストと共に生かしてくださったのです。神は、わたしたちの一切の罪を赦し、","tok":[["肉","にく"],["に"],["割礼","かつれい"],["を"],["受けず","うけず"],["、"],["罪","つみ"],["の"],["中","なか"],["に"],["いて"],["死んで","しんで"],["いた"],["あなた"],["がた"],["を"],["、"],["神","かみ"],["は"],["キリスト"],["と"],["共","とも"],["に"],["生かして","いかして"],["くださった"],["の"],["です"],["。"],["神","かみ"],["は"],["、"],["わたしたち"],["の"],["一切","いっさい"],["の"],["罪","つみ"],["を"],["赦し","ゆるし"],["、"]]},{"verse":14,"text":"規則によってわたしたちを訴えて不利に陥れていた証書を破棄し、これを十字架に釘付けにして取り除いてくださいました。","tok":[["規則","きそく"],["によって"],["わたしたち"],["を"],["訴えて","うったえて"],["不利","ふり"],["に"],["陥れて","おとしいれて"],["いた"],["証書","しょうしょ"],["を"],["破棄","はき"],["し"],["、"],["これ"],["を"],["十字架","じゅうじか"],["に"],["釘付け","くぎづけ"],["に"],["して"],["取り除いて","とりのぞいて"],["くださいました"],["。"]]},{"verse":15,"text":"そして、もろもろの支配と権威の武装を解除し、キリストの勝利の列に従えて、公然とさらしものになさいました。","tok":[["そして"],["、"],["もろもろ"],["の"],["支配","しはい"],["と"],["権威","けんい"],["の"],["武装","ぶそう"],["を"],["解除","かいじょ"],["し"],["、"],["キリスト"],["の"],["勝利","しょうり"],["の"],["列","れつ"],["に"],["従えて","したがえて"],["、"],["公然","こうぜん"],["と"],["さらしもの"],["に"],["なさいました"],["。"]]},{"verse":16,"text":"だから、あなたがたは食べ物や飲み物のこと、また、祭りや新月や安息日のことでだれにも批評されてはなりません。","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["は"],["食べ物","たべもの"],["や"],["飲み物","のみもの"],["の"],["こと"],["、"],["また"],["、"],["祭り","まつり"],["や"],["新月","しんげつ"],["や"],["安息日","あんそくび"],["の"],["こと"],["で"],["だれ"],["に"],["も"],["批評","ひひょう"],["されて"],["は"],["なりません"],["。"]]},{"verse":17,"text":"これらは、やがて来るものの影にすぎず、実体はキリストにあります。","tok":[["これ"],["ら"],["は"],["、"],["やがて"],["来る","くる"],["もの"],["の"],["影","かげ"],["に"],["すぎず"],["、"],["実体","じったい"],["は"],["キリスト"],["に"],["あります"],["。"]]},{"verse":18,"text":"偽りの謙遜と天使礼拝にふける者から、不利な判断を下されてはなりません。こういう人々は、幻で見たことを頼りとし、肉の思いによって根拠もなく思い上がっているだけで、","tok":[["偽り","いつわり"],["の"],["謙遜","けんそん"],["と"],["天使","てんし"],["礼拝","れいはい"],["に"],["ふける"],["者","もの"],["から"],["、"],["不利","ふり"],["な"],["判断","はんだん"],["を"],["下されて","くだされて"],["は"],["なりません"],["。"],["こう"],["いう"],["人々","ひとびと"],["は"],["、"],["幻","まぼろし"],["で"],["見た","みた"],["こと"],["を"],["頼り","たより"],["と"],["し"],["、"],["肉","にく"],["の"],["思い","おもい"],["によって"],["根拠","こんきょ"],["も"],["なく"],["思い上がって","おもいあがって"],["いる"],["だけ"],["で"],["、"]]},{"verse":19,"text":"頭であるキリストにしっかりと付いていないのです。この頭の働きにより、体全体は、節と節、筋と筋とによって支えられ、結び合わされ、神に育てられて成長してゆくのです。","tok":[["頭","あたま"],["で"],["ある"],["キリスト"],["に"],["しっかり"],["と"],["付いて","ついて"],["いない"],["の"],["です"],["。"],["この"],["頭","あたま"],["の"],["働き","はたらき"],["に"],["より"],["、"],["体","たい"],["全体","ぜんたい"],["は"],["、"],["節","ふし"],["と"],["節","ふし"],["、"],["筋","すじ"],["と"],["筋","すじ"],["と"],["によって"],["支えられ","ささえられ"],["、"],["結び合わされ","むすびあわされ"],["、"],["神","かみ"],["に"],["育てられて","そだてられて"],["成長","せいちょう"],["して"],["ゆく"],["の"],["です"],["。"]]},{"verse":20,"text":"あなたがたは、キリストと共に死んで、世を支配する諸霊とは何の関係もないのなら、なぜ、まだ世に属しているかのように生き、","tok":[["あなた"],["がた"],["は"],["、"],["キリスト"],["と"],["共","とも"],["に"],["死んで","しんで"],["、"],["世","よ"],["を"],["支配","しはい"],["する"],["諸","しょ"],["霊","れい"],["と"],["は"],["何","なん"],["の"],["関係","かんけい"],["も"],["ない"],["の"],["なら"],["、"],["なぜ"],["、"],["まだ"],["世","よ"],["に"],["属して","ぞくして"],["いる"],["か"],["の"],["よう"],["に"],["生き","いき"],["、"]]},{"verse":21,"text":"「手をつけるな。味わうな。触れるな」などという戒律に縛られているのですか。","tok":[["「"],["手","て"],["を"],["つける"],["な"],["。"],["味わう","あじわう"],["な"],["。"],["触れる","ふれる"],["な"],["」"],["など"],["と"],["いう"],["戒律","かいりつ"],["に"],["縛られて","しばられて"],["いる"],["の"],["です"],["か"],["。"]]},{"verse":22,"text":"これらはみな、使えば無くなってしまうもの、人の規則や教えによるものです。","tok":[["これ"],["ら"],["は"],["みな"],["、"],["使えば","つかえば"],["無くなって","なくなって"],["しまう"],["もの"],["、"],["人","ひと"],["の"],["規則","きそく"],["や"],["教え","おしえ"],["に"],["よる"],["もの"],["です"],["。"]]},{"verse":23,"text":"これらは、独り善がりの礼拝、偽りの謙遜、体の苦行を伴っていて、知恵のあることのように見えますが、実は何の価値もなく、肉の欲望を満足させるだけなのです。","tok":[["これ"],["ら"],["は"],["、"],["独り善がり","ひとりよがり"],["の"],["礼拝","れいはい"],["、"],["偽り","いつわり"],["の"],["謙遜","けんそん"],["、"],["体","からだ"],["の"],["苦行","くぎょう"],["を"],["伴って","ともなって"],["いて"],["、"],["知恵","ちえ"],["の"],["ある"],["こと"],["の"],["よう"],["に"],["見えます","みえます"],["が"],["、"],["実","じつ"],["は"],["何","なん"],["の"],["価値","かち"],["も"],["なく"],["、"],["肉","にく"],["の"],["欲望","よくぼう"],["を"],["満足","まんぞく"],["させる"],["だけ"],["な"]
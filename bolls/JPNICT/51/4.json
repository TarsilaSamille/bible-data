[{"verse":1,"text":"主人たち、奴隷を正しく、公平に扱いなさい。知ってのとおり、あなたがたにも主人が天におられるのです。","tok":[["主人","しゅじん"],["たち"],["、"],["奴隷","どれい"],["を"],["正しく","ただしく"],["、"],["公平","こうへい"],["に"],["扱い","あつかい"],["なさい"],["。"],["知って","しって"],["の"],["とおり"],["、"],["あなた"],["がた"],["に"],["も"],["主人","しゅじん"],["が"],["天","てん"],["に"],["おられる"],["の"],["です"],["。"]]},{"verse":2,"text":"目を覚まして感謝を込め、ひたすら祈りなさい。","tok":[["目","め"],["を"],["覚まして","さまして"],["感謝","かんしゃ"],["を"],["込め","こめ"],["、"],["ひたすら"],["祈り","いのり"],["なさい"],["。"]]},{"verse":3,"text":"同時にわたしたちのためにも祈ってください。神が御言葉のために門を開いてくださり、わたしたちがキリストの秘められた計画を語ることができるように。このために、わたしは牢につながれています。","tok":[["同時","どうじ"],["に"],["わたしたち"],["の"],["ため"],["に"],["も"],["祈って","いのって"],["ください"],["。"],["神","かみ"],["が"],["御言葉","おことば"],["の"],["ため"],["に"],["門","もん"],["を"],["開いて","ひらいて"],["くださり"],["、"],["わたしたち"],["が"],["キリスト"],["の"],["秘められた","ひめられた"],["計画","けいかく"],["を"],["語る","かたる"],["こと"],["が"],["できる"],["よう"],["に"],["。"],["この"],["ため"],["に"],["、"],["わたし"],["は"],["牢","ろう"],["に"],["つながれて"],["います"],["。"]]},{"verse":4,"text":"わたしがしかるべく語って、この計画を明らかにできるように祈ってください。","tok":[["わたし"],["が"],["しかるべく"],["語って","かたって"],["、"],["この"],["計画","けいかく"],["を"],["明らか","あきらか"],["に"],["できる"],["よう"],["に"],["祈って","いのって"],["ください"],["。"]]},{"verse":5,"text":"時をよく用い、外部の人に対して賢くふるまいなさい。","tok":[["時","とき"],["を"],["よく"],["用い","もちい"],["、"],["外部","がいぶ"],["の"],["人","ひと"],["に対して","にたいして"],["賢く","かしこく"],["ふるまい"],["なさい"],["。"]]},{"verse":6,"text":"いつも、塩で味付けされた快い言葉で語りなさい。そうすれば、一人一人にどう答えるべきかが分かるでしょう。","tok":[["いつも"],["、"],["塩","しお"],["で"],["味付け","あじつけ"],["された"],["快い","こころよい"],["言葉","ことば"],["で"],["語り","かたり"],["なさい"],["。"],["そう"],["すれば"],["、"],["一人一人","ひとりひとり"],["に"],["どう"],["答えるべき","こたえるべき"],["か"],["が"],["分かるでしょう","わかるでしょう"],["。"]]},{"verse":7,"text":"わたしの様子については、ティキコがすべてを話すことでしょう。彼は主に結ばれた、愛する兄弟、忠実に仕える者、仲間の僕です。","tok":[["わたし"],["の"],["様子","ようす"],["について"],["は"],["、"],["ティキコ"],["が"],["すべて"],["を"],["話す","はなす"],["こと"],["でしょう"],["。"],["彼","かれ"],["は"],["主に","おもに"],["結ばれた","むすばれた"],["、"],["愛する","あいする"],["兄弟","きょうだい"],["、"],["忠実","ちゅうじつ"],["に"],["仕える","つかえる"],["者","もの"],["、"],["仲間","なかま"],["の"],["僕","ぼく"],["です"],["。"]]},{"verse":8,"text":"彼をそちらに送るのは、あなたがたがわたしたちの様子を知り、彼によって心が励まされるためなのです。","tok":[["彼","かれ"],["を"],["そちら"],["に"],["送る","おくる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["わたしたち"],["の"],["様子","ようす"],["を"],["知り","しり"],["、"],["彼","かれ"],["によって"],["心","こころ"],["が"],["励まされる","はげまされる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":9,"text":"また、あなたがたの一人、忠実な愛する兄弟オネシモを一緒に行かせます。彼らは、こちらの事情をすべて知らせるでしょう。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["一人","ひとり"],["、"],["忠実","ちゅうじつ"],["な"],["愛する","あいする"],["兄弟","きょうだい"],["オネシモ"],["を"],["一緒","いっしょ"],["に"],["行かせます","いかせます"],["。"],["彼","かれ"],["ら"],["は"],["、"],["こちら"],["の"],["事情","じじょう"],["を"],["すべて"],["知らせるでしょう","しらせるでしょう"],["。"]]},{"verse":10,"text":"わたしと一緒に捕らわれの身となっているアリスタルコが、そしてバルナバのいとこマルコが、あなたがたによろしくと言っています。このマルコについては、もしそちらに行ったら迎えるようにとの指示を、あなたがたは受けているはずです。","tok":[["わたし"],["と"],["一緒","いっしょ"],["に"],["捕らわれ","とらわれ"],["の"],["身","み"],["と"],["なって"],["いる"],["アリスタルコ"],["が"],["、"],["そして"],["バルナバ"],["の"],["いとこ"],["マルコ"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["この"],["マルコ"],["について"],["は"],["、"],["もし"],["そちら"],["に"],["行ったら","いったら"],["迎える","むかえる"],["よう"],["に"],["と"],["の"],["指示","しじ"],["を"],["、"],["あなた"],["がた"],["は"],["受けて","うけて"],["いる"],["はず"],["です"],["。"]]},{"verse":11,"text":"ユストと呼ばれるイエスも、よろしくと言っています。割礼を受けた者では、この三人だけが神の国のために共に働く者であり、わたしにとって慰めとなった人々です。","tok":[["ユスト"],["と"],["呼ばれる","よばれる"],["イエス"],["も"],["、"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["割礼","かつれい"],["を"],["受けた","うけた"],["者","もの"],["で"],["は"],["、"],["この"],["三人","さんにん"],["だけ"],["が"],["神","かみ"],["の"],["国","くに"],["の"],["ため"],["に"],["共","とも"],["に"],["働く","はたらく"],["者","もの"],["で"],["あり"],["、"],["わたし"],["にとって"],["慰め","なぐさめ"],["と"],["なった"],["人々","ひとびと"],["です"],["。"]]},{"verse":12,"text":"あなたがたの一人、キリスト‧イエスの僕エパフラスが、あなたがたによろしくと言っています。彼は、あなたがたが完全な者となり、神の御心をすべて確信しているようにと、いつもあなたがたのために熱心に祈っています。","tok":[["あなた"],["がた"],["の"],["一人","ひとり"],["、"],["キリスト"],["‧"],["イエス"],["の"],["僕","ぼく"],["エパフラス"],["が"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["彼","かれ"],["は"],["、"],["あなた"],["がた"],["が"],["完全","かんぜん"],["な"],["者","もの"],["と"],["なり"],["、"],["神","かみ"],["の"],["御心","おこころ"],["を"],["すべて"],["確信","かくしん"],["して"],["いる"],["よう"],["に"],["と"],["、"],["いつも"],["あなた"],["がた"],["の"],["ため"],["に"],["熱心","ねっしん"],["に"],["祈って","いのって"],["います"],["。"]]},{"verse":13,"text":"わたしは証言しますが、彼はあなたがたのため、またラオディキアとヒエラポリスの人々のために、非常に労苦しています。","tok":[["わたし"],["は"],["証言","しょうげん"],["します"],["が"],["、"],["彼","かれ"],["は"],["あなた"],["がた"],["の"],["ため"],["、"],["また"],["ラオディキア"],["と"],["ヒエラポリス"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["非常","ひじょう"],["に"],["労苦","ろうく"],["して"],["います"],["。"]]},{"verse":14,"text":"愛する医者ルカとデマスも、あなたがたによろしくと言っています。","tok":[["愛する","あいする"],["医者","いしゃ"],["ルカ"],["と"],["デマス"],["も"],["、"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":15,"text":"ラオディキアの兄弟たち、および、ニンファと彼女の家にある教会の人々によろしく伝えてください。","tok":[["ラオディキア"],["の"],["兄弟","きょうだい"],["たち"],["、"],["および"],["、"],["ニンファ"],["と"],["彼女","かのじょ"],["の"],["家","いえ"],["に"],["ある"],["教会","きょうかい"],["の"],["人々","ひとびと"],["に"],["よろしく"],["伝えて","つたえて"],["ください"],["。"]]},{"verse":16,"text":"この手紙があなたがたのところで読まれたら、ラオディキアの教会でも読まれるように、取り計らってください。また、ラオディキアから回って来る手紙を、あなたがたも読んでください。","tok":[["この"],["手紙","てがみ"],["が"],["あなた"],["がた"],["の"],["ところ"],["で"],["読まれたら","よまれたら"],["、"],["ラオディキア"],["の"],["教会","きょうかい"],["で"],["も"],["読まれる","よまれる"],["よう"],["に"],["、"],["取り計らって","とりはからって"],["ください"],["。"],["また"],["、"],["ラオディキア"],["から"],["回って","まわって"],["来る","くる"],["手紙","てがみ"],["を"],["、"],["あなた"],["がた"],["も"],["読んで","よんで"],["ください"],["。"]]},{"verse":17,"text":"アルキポに、「主に結ばれた者としてゆだねられた務めに意を用い、それをよく果たすように」と伝えてください。","tok":[["アルキポ"],["に"],["、"],["「"],["主に","おもに"],["結ばれた","むすばれた"],["者","もの"],["として"],["ゆだねられた"],["務め","つとめ"],["に"],["意","い"],["を"],["用い","もちい"],["、"],["それ"],["を"],["よく"],["果たす","はたす"],["よう"],["に"],["」"],["と"],["伝えて","つたえて"],["ください"],["。"]]},{"verse":18,"text":"わたしパウロが、自分の手で挨拶を記します。わたしが捕らわれの身であることを、心に留めてください。恵みがあなたがたと共にあるように。","tok":[["わたし"],["パウロ"],["が"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["挨拶","あいさつ"],["を"],["記します","しるします"],["。"],["わたし"],["が"],["捕らわれ","とらわれ"],["の"],["身","み"],["で"],["ある"],["こと"],["を"],["、"],["心","こころ"],["に"],["留めて","とめて"],["ください"],["。"],["恵み","めぐみ"],["が"],["あなた"],["がた"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
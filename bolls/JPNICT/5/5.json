[{"verse":1,"text":"モーセは、全イスラエルを呼び集めて言った。イスラエルよ、聞け。今日、わたしは掟と法を語り聞かせる。あなたたちはこれを学び、忠実に守りなさい。","tok":[["モーセ"],["は"],["、"],["全","ぜん"],["イスラエル"],["を"],["呼び集めて","よびあつめて"],["言った","いった"],["。"],["イスラエル"],["よ"],["、"],["聞け","きけ"],["。"],["今日","きょう"],["、"],["わたし"],["は"],["掟","おきて"],["と"],["法","ほう"],["を"],["語り聞かせる","かたりきかせる"],["。"],["あなた"],["たち"],["は"],["これ"],["を"],["学び","まなび"],["、"],["忠実","ちゅうじつ"],["に"],["守り","まもり"],["なさい"],["。"]]},{"verse":2,"text":"我々の神、主は、ホレブで我々と契約を結ばれた。","tok":[["我々","われわれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["ホレブ"],["で"],["我々","われわれ"],["と"],["契約","けいやく"],["を"],["結ばれた","むすばれた"],["。"]]},{"verse":3,"text":"主はこの契約を我々の先祖と結ばれたのではなく、今ここに生きている我々すべてと結ばれた。","tok":[["主","ぬし"],["は"],["この"],["契約","けいやく"],["を"],["我々","われわれ"],["の"],["先祖","せんぞ"],["と"],["結ばれた","むすばれた"],["ので"],["は"],["なく"],["、"],["今","いま"],["ここ"],["に"],["生きて","いきて"],["いる"],["我々","われわれ"],["すべて"],["と"],["結ばれた","むすばれた"],["。"]]},{"verse":4,"text":"主は山で、火の中からあなたたちと顔と顔を合わせて語られた。","tok":[["主","ぬし"],["は"],["山","やま"],["で"],["、"],["火","ひ"],["の"],["中","なか"],["から"],["あなた"],["たち"],["と"],["顔","かお"],["と"],["顔","かお"],["を"],["合わせて","あわせて"],["語られた","かたられた"],["。"]]},{"verse":5,"text":"わたしはそのとき、主とあなたたちの間に立って主の言葉を告げた。あなたたちが火を恐れて山に登らなかったからである。主は言われた。","tok":[["わたし"],["は"],["その"],["とき"],["、"],["主","ぬし"],["と"],["あなた"],["たち"],["の"],["間","あいだ"],["に"],["立って","たって"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["告げた","つげた"],["。"],["あなた"],["たち"],["が"],["火","ひ"],["を"],["恐れて","おそれて"],["山","やま"],["に"],["登らなかった","のぼらなかった"],["から"],["で"],["ある"],["。"],["主","ぬし"],["は"],["言われた","いわれた"],["。"]]},{"verse":6,"text":"「わたしは主、あなたの神、あなたをエジプトの国、奴隷の家から導き出した神である。","tok":[["「"],["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["導き出した","みちびきだした"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":7,"text":"あなたには、わたしをおいてほかに神があってはならない。","tok":[["あなた"],["に"],["は"],["、"],["わたし"],["を"],["おいて"],["ほか"],["に"],["神","かみ"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":8,"text":"あなた
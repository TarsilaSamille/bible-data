[{"verse":1,"text":"我々は転じてバシャンに至る道を上って行くと、バシャンの王オグは全軍を率いて出撃し、エドレイで我々を迎え撃とうとした。","tok":[["我々","われわれ"],["は"],["転じて","てんじて"],["バシャン"],["に"],["至る","いたる"],["道","みち"],["を"],["上って","のぼって"],["行く","いく"],["と"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["は"],["全軍","ぜんぐん"],["を"],["率いて","ひきいて"],["出撃","しゅつげき"],["し"],["、"],["エドレイ"],["で"],["我々","われわれ"],["を"],["迎え撃とう","むかえうとう"],["と"],["した"],["。"]]},{"verse":2,"text":"主はわたしに言われた。「彼を恐れてはならない。わたしは彼とその全軍、その国をあなたの手に渡した。ヘシュボンに住むアモリ人の王シホンにしたように、彼にも行いなさい。」","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["彼","かれ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["と"],["その"],["全軍","ぜんぐん"],["、"],["その"],["国","くに"],["を"],["あなた"],["の"],["手","て"],["に"],["渡した","わたした"],["。"],["ヘシュボン"],["に"],["住む","すむ"],["アモリ人","あもりにん"],["の"],["王","おう"],["シホン"],["に"],["した"],["よう"],["に"],["、"],["彼","かれ"],["に"],["も"],["行い","おこない"],["なさい"],["。"],["」"]]},{"verse":3,"text":"我々の神、主はバシャンの王オグをはじめ、その全軍を我々の手に渡されたので、我々はオグを撃ち殺し、ついに一人も残さなかった。","tok":[["我々","われわれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["バシャン"],["の"],["王","おう"],["オグ"],["を"],["はじめ"],["、"],["その"],["全軍","ぜんぐん"],["を"],["我々","われわれ"],["の"],["手","て"],["に"],["渡された","わたされた"],["ので"],["、"],["我々","われわれ"],["は"],["オグ"],["を"],["撃ち殺し","うちころし"],["、"],["ついに"],["一人","ひとり"],["も"],["残さなかった","のこさなかった"],["。"]]},{"verse":4,"text":"そのとき、彼のすべての町を占領し、我々が奪わなかった町は一つもなかった。奪ったのはバシャンにあるオグの王国、アルゴブ全域の六十の町であった。","tok":[["その"],["とき"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["町","まち"],["を"],["占領","せんりょう"],["し"],["、"],["我々","われわれ"],["が"],["奪わなかった","うばわなかった"],["町","まち"],["は"],["一","ひと"],["つ"],["も"],["なかった"],["。"],["奪った","うばった"],["の"],["は"],["バシャン"],["に"],["ある"],["オグ"],["の"],["王国","おうこく"],["、"],["アルゴブ"],["全域","ぜんいき"],["の"],["六十","ろくじゅう"],["の"],["町","まち"],["で"],["あった"],["。"]]},{"verse":5,"text":"これらはすべて高い城壁で囲まれ、かんぬきで門を固めた要害の町であるが、このほかに城壁のない村落がたくさんあった。","tok":[["これ"],["ら"],["は"],["すべて"],["高い","たかい"],["城壁","じょうへき"],["で"],["囲まれ","かこまれ"],["、"],["かんぬき"],["で"],["門","もん"],["を"],["固めた","かためた"],["要害","ようがい"],["の"],["町","まち"],["で"],["ある"],["が"],["、"],["この"],["ほか"],["に"],["城壁","じょうへき"],["の"],["ない"],["村落","そんらく"],["が"],["たくさん"],["あった"],["。"]]},{"verse":6,"text":"我々はヘシュボンの王シホンにしたように、彼らを滅ぼし尽くし、町全体、男も女も子供も滅ぼし尽くしたが、","tok":[["我々","われわれ"],["は"],["ヘシュボン"],["の"],["王","おう"],["シホン"],["に"],["した"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["尽くし","つくし"],["、"],["町","まち"],["全体","ぜんたい"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["子供","こども"],["も"],["滅ぼし","ほろぼし"],["尽くした","つくした"],["が"],["、"]]},{"verse":7,"text":"家畜と町から分捕った物はすべて自分たちの略奪品とした。","tok":[["家畜","かちく"],["と"],["町","まち"],["から"],["分捕った","ぶんどった"],["物","もの"],["は"],["すべて"],["自分","じぶん"],["たち"],["の"],["略奪品","りゃくだつひん"],["と"],["した"],["。"]]},{"verse":8,"text":"我々はそのとき、アルノン川からヘルモン山に至るヨルダン川東岸の二人のアモリ人の王の領土を手中に収めた。――","tok":[["我々","われわれ"],["は"],["その"],["とき"],["、"],["アルノン"],["川","かわ"],["から"],["ヘルモン"],["山","やま"],["に"],["至る","いたる"],["ヨルダン"],["川","かわ"],["東岸","とうがん"],["の"],["二人","ふたり"],["の"],["アモリ人","あもりにん"],["の"],["王","おう"],["の"],["領土","りょうど"],["を"],["手中","しゅちゅう"],["に"],["収めた","おさめた"],["。"],["―"],["―"]]},{"verse":9,"text":"ヘルモン山のことをシドンの住民はシルヨンと呼び、アモリ人はセニルと呼んでいる。――","tok":[["ヘルモン"],["山","やま"],["の"],["こと"],["を"],["シドン"],["の"],["住民","じゅうみん"],["は"],["シルヨン"],["と"],["呼び","よび"],["、"],["アモリ人","あもりにん"],["は"],["セニル"],["と"],["呼んで","よんで"],["いる"],["。"],["―"],["―"]]},{"verse":10,"text":"それは台地にあるすべての町、ギレアド全域、バシャンの王オグが治める町々、サルカからエドレイに至るバシャン全域を含んでいる。――","tok":[["それ"],["は"],["台地","だいち"],["に"],["ある"],["すべて"],["の"],["町","まち"],["、"],["ギレアド"],["全域","ぜんいき"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["が"],["治める","おさめる"],["町々","まちまち"],["、"],["サルカ"],["から"],["エドレイ"],["に"],["至る","いたる"],["バシャン"],["全域","ぜんいき"],["を"],["含んで","ふくんで"],["いる"],["。"],["―"],["―"]]},{"verse":11,"text":"バシャンの王オグは、レファイム人の唯一の生き残りであった。彼の棺は鉄で作られており、アンモンの人々のラバに保存されているが、基準のアンマで長さ九アンマ、幅四アンマもあった。――","tok":[["バシャン"],["の"],["王","おう"],["オグ"],["は"],["、"],["レファイム"],["人","にん"],["の"],["唯一","ゆいいつ"],["の"],["生き残り","いきのこり"],["で"],["あった"],["。"],["彼","かれ"],["の"],["棺","ひつぎ"],["は"],["鉄","てつ"],["で"],["作られて","つくられて"],["おり"],["、"],["アンモン"],["の"],["人々","ひとびと"],["の"],["ラバ"],["に"],["保存","ほぞん"],["されて"],["いる"],["が"],["、"],["基準","きじゅん"],["の"],["アンマ"],["で"],["長さ","ながさ"],["九","きゅう"],["アンマ"],["、"],["幅","はば"],["四","よん"],["アンマ"],["も"],["あった"],["。"],["―"],["―"]]},{"verse":12,"text":"我々はそのとき、この地域を占領したが、わたしはアルノン川沿いにあるアロエルからギレアドの山地の半分、およびそこにある町々をルベン人とガド人に与えた。","tok":[["我々","われわれ"],["は"],["その"],["とき"],["、"],["この"],["地域","ちいき"],["を"],["占領","せんりょう"],["した"],["が"],["、"],["わたし"],["は"],["アルノン"],["川沿い","かわそい"],["に"],["ある"],["アロエル"],["から"],["ギレアド"],["の"],["山地","さんち"],["の"],["半分","はんぶん"],["、"],["および"],["そこ"],["に"],["ある"],["町々","まちまち"],["を"],["ルベン人","るべんにん"],["と"],["ガド人","がどにん"],["に"],["与えた","あたえた"],["。"]]},{"verse":13,"text":"マナセの半部族には、ギレアドの残りの地域と、オグ王国のあったバシャン全土、すなわちアルゴブ全域を与えた。――バシャン全土はレファイム人の国と呼ばれていた。","tok":[["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["は"],["、"],["ギレアド"],["の"],["残り","のこり"],["の"],["地域","ちいき"],["と"],["、"],["オグ"],["王国","おうこく"],["の"],["あった"],["バシャン"],["全土","ぜんど"],["、"],["すなわち"],["アルゴブ"],["全域","ぜんいき"],["を"],["与えた","あたえた"],["。"],["―"],["―"],["バシャン"],["全土","ぜんど"],["は"],["レファイム"],["人","にん"],["の"],["国","くに"],["と"],["呼ばれて","よばれて"],["いた"],["。"]]},{"verse":14,"text":"マナセの子ヤイルは、アルゴブ全域を取って、ゲシュル人、マアカ人と境界を接し、バシャンを自分の名にちなんでハボト‧ヤイルと名付け、今日に至っている。――","tok":[["マナセ"],["の"],["子","こ"],["ヤイル"],["は"],["、"],["アルゴブ"],["全域","ぜんいき"],["を"],["取って","とって"],["、"],["ゲシュル"],["人","にん"],["、"],["マアカ人","まあかにん"],["と"],["境界","きょうかい"],["を"],["接し","せっし"],["、"],["バシャン"],["を"],["自分","じぶん"],["の"],["名","な"],["に"],["ちなんで"],["ハボト"],["‧"],["ヤイル"],["と"],["名付け","なづけ"],["、"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"],["―"],["―"]]},{"verse":15,"text":"わたしはマキルにはギレアドを与えた。","tok":[["わたし"],["は"],["マキル"],["に"],["は"],["ギレアド"],["を"],["与えた","あたえた"],["。"]]},{"verse":16,"text":"ルベン人とガド人には、ギレアドからアルノン川までを与え、川の真ん中を南境とした。東はヤボク川がアンモンの人々との境界となり、","tok":[["ルベン人","るべんにん"],["と"],["ガド人","がどにん"],["に"],["は"],["、"],["ギレアド"],["から"],["アルノン"],["川","かわ"],["まで"],["を"],["与え","あたえ"],["、"],["川","かわ"],["の"],["真ん中","まんなか"],["を"],["南境","なんきょう"],["と"],["した"],["。"],["東","ひがし"],["は"],["ヤボク"],["川","かわ"],["が"],["アンモン"],["の"],["人々","ひとびと"],["と"],["の"],["境界","きょうかい"],["と"],["なり"],["、"]]},{"verse":17,"text":"ヨルダン川とアラバが西境となった。それはキネレト湖から、その東にピスガ山のすそ野が延びてきてアラバの海、すなわち塩の海に及ぶ。","tok":[["ヨルダン"],["川","かわ"],["と"],["アラバ"],["が"],["西境","にしざかい"],["と"],["なった"],["。"],["それ"],["は"],["キネレト"],["湖","こ"],["から"],["、"],["その"],["東","ひがし"],["に"],["ピスガ"],["山","やま"],["の"],["すそ野","すその"],["が"],["延びて","のびて"],["きて"],["アラバ"],["の"],["海","うみ"],["、"],["すなわち"],["塩","しお"],["の"],["海","うみ"],["に"],["及ぶ","およぶ"],["。"]]},{"verse":18,"text":"わたしはそのとき、あなたたちに命じた。「あなたたちの神、主はこの土地をあなたたちに与えて、それを得させてくださった。戦士たちは皆武装して、同胞イスラエルの人々の先頭に立って渡って行きなさい。","tok":[["わたし"],["は"],["その"],["とき"],["、"],["あなた"],["たち"],["に"],["命じた","めいじた"],["。"],["「"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["この"],["土地","とち"],["を"],["あなた"],["たち"],["に"],["与えて","あたえて"],["、"],["それ"],["を"],["得させて","えさせて"],["くださった"],["。"],["戦士","せんし"],["たち"],["は"],["皆","みな"],["武装","ぶそう"],["して"],["、"],["同胞","どうほう"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["渡って","わたって"],["行き","いき"],["なさい"],["。"]]},{"verse":19,"text":"ただし妻子と家畜は、わたしが既に与えた町々にとどめておきなさい。わたしはあなたたちが多くの家畜を持っているのを知っている。","tok":[["ただし"],["妻子","さいし"],["と"],["家畜","かちく"],["は"],["、"],["わたし"],["が"],["既に","すでに"],["与えた","あたえた"],["町々","まちまち"],["に"],["とどめて"],["おき"],["なさい"],["。"],["わたし"],["は"],["あなた"],["たち"],["が"],["多く","おおく"],["の"],["家畜","かちく"],["を"],["持って","もって"],["いる"],["の"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":20,"text":"主があなたたちと同じく、これらの同胞に安住の地を与え、ヨルダン川の西側で彼らもあなたたちの神、主が与えられる土地を得るならば、あなたたちはわたしが既に与えた領地に帰ってよろしい。」","tok":[["主","ぬし"],["が"],["あなた"],["たち"],["と"],["同じく","おなじく"],["、"],["これ"],["ら"],["の"],["同胞","どうほう"],["に"],["安住","あんじゅう"],["の"],["地","ち"],["を"],["与え","あたえ"],["、"],["ヨルダン"],["川","かわ"],["の"],["西側","にしがわ"],["で"],["彼","かれ"],["ら"],["も"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられる","あたえられる"],["土地","とち"],["を"],["得るならば","うるならば"],["、"],["あなた"],["たち"],["は"],["わたし"],["が"],["既に","すでに"],["与えた","あたえた"],["領地","りょうち"],["に"],["帰って","かえって"],["よろしい"],["。"],["」"]]},{"verse":21,"text":"わたしはそのとき、ヨシュアに命じた。「あなたたちの神、主が二人の王に対してなさったことをすべて、あなたは自分の目で見た。主は、あなたがこれから渡って行くすべての王国にも同じようにされるであろう。","tok":[["わたし"],["は"],["その"],["とき"],["、"],["ヨシュア"],["に"],["命じた","めいじた"],["。"],["「"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["二人","ふたり"],["の"],["王","おう"],["に対して","にたいして"],["なさった"],["こと"],["を"],["すべて"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["目","め"],["で"],["見た","みた"],["。"],["主","ぬし"],["は"],["、"],["あなた"],["が"],["これ"],["から"],["渡って","わたって"],["行く","いく"],["すべて"],["の"],["王国","おうこく"],["に"],["も"],["同じ","おなじ"],["よう"],["に"],["されるで"],["あろう"],["。"]]},{"verse":22,"text":"彼らを恐れてはならない。あなたたちの神、主が自らあなたたちのために戦ってくださる。」","tok":[["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["自ら","みずから"],["あなた"],["たち"],["の"],["ため"],["に"],["戦って","たたかって"],["くださる"],["。"],["」"]]},{"verse":23,"text":"わたしは、そのとき主に祈り求めた。","tok":[["わたし"],["は"],["、"],["その"],["とき"],["主に","おもに"],["祈り求めた","いのりもとめた"],["。"]]},{"verse":24,"text":"「わが主なる神よ、あなたは僕であるわたしにあなたの大いなること、力強い働きを示し始められました。あなたのように力ある業をなしうる神が、この天と地のどこにありましょうか。","tok":[["「"],["わが"],["主","ぬし"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["僕","ぼく"],["で"],["ある"],["わたし"],["に"],["あなた"],["の"],["大いなる","おおいなる"],["こと"],["、"],["力強い","ちからづよい"],["働き","はたらき"],["を"],["示し","しめし"],["始められました","はじめられました"],["。"],["あなた"],["の"],["よう"],["に"],["力","ちから"],["ある"],["業","ごう"],["を"],["なし"],["うる"],["神","かみ"],["が"],["、"],["この"],["天","てん"],["と"],["地","ち"],["の"],["どこ"],["に"],["ありましょう"],["か"],["。"]]},{"verse":25,"text":"どうか、わたしにも渡って行かせ、ヨルダン川の向こうの良い土地、美しい山、またレバノン山を見せてください。」","tok":[["どう"],["か"],["、"],["わたし"],["に"],["も"],["渡って","わたって"],["行かせ","いかせ"],["、"],["ヨルダン"],["川","かわ"],["の"],["向こう","むこう"],["の"],["良い","よい"],["土地","とち"],["、"],["美しい","うつくしい"],["山","やま"],["、"],["また"],["レバノン"],["山","さん"],["を"],["見せて","みせて"],["ください"],["。"],["」"]]},{"verse":26,"text":"しかし主は、あなたたちのゆえにわたしに向かって憤り、祈りを聞こうとされなかった。主はわたしに言われた。「もうよい。この事を二度と口にしてはならない。","tok":[["しかし"],["主","ぬし"],["は"],["、"],["あなた"],["たち"],["の"],["ゆえ"],["に"],["わたし"],["に"],["向かって","むかって"],["憤り","いきどおり"],["、"],["祈り","いのり"],["を"],["聞こう","きこう"],["と"],["されなかった"],["。"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["もう"],["よい"],["。"],["この"],["事","こと"],["を"],["二","に"],["度","ど"],["と"],["口","くち"],["に"],["して"],["は"],["ならない"],["。"]]},{"verse":27,"text":"ピスガの頂上に登り、東西南北を見渡すのだ。お前はこのヨルダン川を渡って行けないのだから、自分の目でよく見ておくがよい。","tok":[["ピスガ"],["の"],["頂上","ちょうじょう"],["に"],["登り","のぼり"],["、"],["東西","とうざい"],["南北","なんぼく"],["を"],["見渡す","みわたす"],["の"],["だ"],["。"],["お前","おまえ"],["は"],["この"],["ヨルダン"],["川","かわ"],["を"],["渡って","わたって"],["行けない","いけない"],["の"],["だ"],["から"],["、"],["自分","じぶん"],["の"],["目","め"],["で"],["よく"],["見て","みて"],["おく"],["が"],["よい"],["。"]]},{"verse":28,"text":"ヨシュアを任務に就け、彼を力づけ、励ましなさい。彼はこの民の先頭に立って、お前が今見ている土地を、彼らに受け継がせるであろう。」","tok":[["ヨシュア"],["を"],["任務","にんむ"],["に"],["就け","つけ"],["、"],["彼","かれ"],["を"],["力づけ","ちからづけ"],["、"],["励まし","はげまし"],["なさい"],["。"],["彼","かれ"],["は"],["この"],["民","たみ"],["の"],["先頭","せんとう"],["に"],["立って","たって"],["、"],["お前","おまえ"],["が"],["今","いま"],["見て","みて"],["いる"],["土地","とち"],["を"],["、"],["彼","かれ"],["ら"],["に"],["受け継がせるで","うけつがせるで"],["あろう"],["。"],["」"]]},{"verse":29,"text":"我々はこうして、ベト‧ペオルの前にある谷に滞在していた。","tok":[["我々","われわれ"],["は"],["こう"],["して"],["、"],["ベト"],["‧"],["ペオル"],["の"],["前","まえ"],["に"],["ある"],["谷","たに"],["に"],["滞在","たいざい"],["して"],["いた"],["。"]]}]
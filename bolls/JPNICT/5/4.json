[{"verse":1,"text":"イスラエルよ。今、わたしが教える掟と法を忠実に行いなさい。そうすればあなたたちは命を得、あなたたちの先祖の神、主が与えられる土地に入って、それを得ることができるであろう。","tok":[["イスラエル"],["よ"],["。"],["今","いま"],["、"],["わたし"],["が"],["教える","おしえる"],["掟","おきて"],["と"],["法","ほう"],["を"],["忠実","ちゅうじつ"],["に"],["行い","おこない"],["なさい"],["。"],["そう"],["すれば"],["あなた"],["たち"],["は"],["命","いのち"],["を"],["得","え"],["、"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられる","あたえられる"],["土地","とち"],["に"],["入って","はいって"],["、"],["それ"],["を"],["得る","える"],["こと"],["が"],["できるで"],["あろう"],["。"]]},{"verse":2,"text":"あなたたちはわたしが命じる言葉に何一つ加えることも、減らすこともしてはならない。わたしが命じるとおりにあなたたちの神、主の戒めを守りなさい。","tok":[["あなた"],["たち"],["は"],["わたし"],["が"],["命じる","めいじる"],["言葉","ことば"],["に"],["何","なん"],["一","ひと"],["つ"],["加える","くわえる"],["こと"],["も"],["、"],["減らす","へらす"],["こと"],["も"],["して"],["は"],["ならない"],["。"],["わたし"],["が"],["命じる","めいじる"],["とおり"],["に"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["戒め","いましめ"],["を"],["守り","まもり"],["なさい"],["。"]]},{"verse":3,"text":"あなたたちは、主がバアル‧ペオルでなさったことをその目で見たではないか。あなたの神、主はペオルのバアルに従った者をすべてあなたの間から滅ぼされたが、","tok":[["あなた"],["たち"],["は"],["、"],["主","ぬし"],["が"],["バアル"],["‧"],["ペオル"],["で"],["なさった"],["こと"],["を"],["その"],["目","め"],["で"],["見たで","みたで"],["は"],["ない"],["か"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["ペオル"],["の"],["バアル"],["に"],["従った","したがった"],["者","もの"],["を"],["すべて"],["あなた"],["の"],["間","あいだ"],["から"],["滅ぼされた","ほろぼされた"],["が"],["、"]]},{"verse":4,"text":"あなたたちの神、主につき従ったあなたたちは皆、今日も生きている。","tok":[["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["つき従った","つきしたがった"],["あなた"],["たち"],["は"],["皆","みな"],["、"],["今日","きょう"],["も"],["生きて","いきて"],["いる"],["。"]]},{"verse":5,"text":"見よ、わたしがわたしの神、主から命じられたとおり、あなたたちに掟と法を教えたのは、あなたたちがこれから入って行って得る土地でそれを行うためである。","tok":[["見よ","みよ"],["、"],["わたし"],["が"],["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["から"],["命じられた","めいじられた"],["とおり"],["、"],["あなた"],["たち"],["に"],["掟","おきて"],["と"],["法","ほう"],["を"],["教えた","おしえた"],["の"],["は"],["、"],["あなた"],["たち"],["が"],["これ"],["から"],["入って","はいって"],["行って","いって"],["得る","える"],["土地","とち"],["で"],["それ"],["を"],["行う","おこなう"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたたちはそれを忠実に守りなさい。そうすれば、諸国の民にあなたたちの知恵と良識が示され、彼らがこれらすべての掟を聞くとき、「この大いなる国民は確かに知恵があり、賢明な民である」と言うであろう。","tok":[["あなた"],["たち"],["は"],["それ"],["を"],["忠実","ちゅうじつ"],["に"],["守り","まもり"],["なさい"],["。"],["そう"],["すれば"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["あなた"],["たち"],["の"],["知恵","ちえ"],["と"],["良識","りょうしき"],["が"],["示され","しめされ"],["、"],["彼","かれ"],["ら"],["が"],["これ"],["ら"],["すべて"],["の"],["掟","おきて"],["を"],["聞く","きく"],["とき"],["、"],["「"],["この"],["大いなる","おおいなる"],["国民","こくみん"],["は"],["確か","たしか"],["に"],["知恵","ちえ"],["が"],["あり"],["、"],["賢明","けんめい"],["な"],["民","たみ"],["で"],["ある"],["」"],["と"],["言うで","ゆうで"],["あろう"],["。"]]},{"verse":7,"text":"いつ呼び求めても、近くにおられる我々の神、主のような神を持つ大いなる国民がどこにあるだろうか。","tok":[["いつ"],["呼び求めて","よびもとめて"],["も"],["、"],["近く","ちかく"],["に"],["おられる"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["よう"],["な"],["神","かみ"],["を"],["持つ","もつ"],["大いなる","おおいなる"],["国民","こくみん"],["が"],["どこ"],["に"],["あるだろう"],["か"],["。"]]},{"verse":8,"text":"またわたしが今日あなたたちに授けるこのすべての律法のように、正しい掟と法を持つ大いなる国民がどこにいるだろうか。","tok":[["また"],["わたし"],["が"],["今日","きょう"],["あなた"],["たち"],["に"],["授ける","さずける"],["この"],["すべて"],["の"],["律法","りっぽう"],["の"],["よう"],["に"],["、"],["正しい","ただしい"],["掟","おきて"],["と"],["法","ほう"],["を"],["持つ","もつ"],["大いなる","おおいなる"],["国民","こくみん"],["が"],["どこ"],["に"],["いるだろう"],["か"],["。"]]},{"verse":9,"text":"ただひたすら注意してあなた自身に十分気をつけ、目で見たことを忘れず、生涯心から離すことなく、子や孫たちにも語り伝えなさい。","tok":[["ただ"],["ひたすら"],["注意","ちゅうい"],["して"],["あなた"],["自身","じしん"],["に"],["十分","じゅうぶん"],["気","き"],["を"],["つけ"],["、"],["目","め"],["で"],["見た","みた"],["こと"],["を"],["忘れず","わすれず"],["、"],["生涯","しょうがい"],["心","こころ"],["から"],["離す","はなす"],["こと"],["なく"],["、"],["子","こ"],["や"],["孫","まご"],["たち"],["に"],["も"],["語り伝え","かたりつたえ"],["なさい"],["。"]]},{"verse":10,"text":"あなたがホレブであなたの神、主の御前に立った日、主はわたしに言われた。「民をわたしのもとに集めなさい。わたしの言葉を彼らに聞かせ、彼らが地上に生きる限り、わたしを畏れることを学び、またそれを子らに教えることができるようにしよう。」","tok":[["あなた"],["が"],["ホレブ"],["で"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["立った","たった"],["日","ひ"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["民","みん"],["を"],["わたし"],["の"],["もと"],["に"],["集め","あつめ"],["なさい"],["。"],["わたし"],["の"],["言葉","ことば"],["を"],["彼","かれ"],["ら"],["に"],["聞かせ","きかせ"],["、"],["彼","かれ"],["ら"],["が"],["地上","ちじょう"],["に"],["生きる","いきる"],["限り","かぎり"],["、"],["わたし"],["を"],["畏れる","おそれる"],["こと"],["を"],["学び","まなび"],["、"],["また"],["それ"],["を"],["子","こ"],["ら"],["に"],["教える","おしえる"],["こと"],["が"],["できる"],["よう"],["に"],["しよう"],["。"],["」"]]},{"verse":11,"text":"あなたたちが近づいて山のふもとに立つと、山は燃え上がり、火は中天に達し、黒雲と密雲が垂れこめていた。","tok":[["あなた"],["たち"],["が"],["近づいて","ちかづいて"],["山","やま"],["の"],["ふもと"],["に"],["立つ","たつ"],["と"],["、"],["山","やま"],["は"],["燃え上がり","もえあがり"],["、"],["火","ひ"],["は"],["中天","ちゅうてん"],["に"],["達し","たっし"],["、"],["黒雲","くろくも"],["と"],["密雲","みつうん"],["が"],["垂れこめて","たれこめて"],["いた"],["。"]]},{"verse":12,"text":"主は火の中からあなたたちに語りかけられた。あなたたちは語りかけられる声を聞いたが、声のほかには何の形も見なかった。","tok":[["主","ぬし"],["は"],["火","ひ"],["の"],["中","なか"],["から"],["あなた"],["たち"],["に"],["語りかけられた","かたりかけられた"],["。"],["あなた"],["たち"],["は"],["語りかけられる","かたりかけられる"],["声","こえ"],["を"],["聞いた","きいた"],["が"],["、"],["声","こえ"],["の"],["ほか"],["に"],["は"],["何","なん"],["の"],["形","かたち"],["も"],["見なかった","みなかった"],["。"]]},{"verse":13,"text":"主は契約を告げ示し、あなたたちが行うべきことを命じられた。それが十戒である。主はそれを二枚の石の板に書き記された。","tok":[["主","ぬし"],["は"],["契約","けいやく"],["を"],["告げ","つげ"],["示し","しめし"],["、"],["あなた"],["たち"],["が"],["行うべき","おこなうべき"],["こと"],["を"],["命じられた","めいじられた"],["。"],["それ"],["が"],["十","じゅう"],["戒","かい"],["で"],["ある"],["。"],["主","ぬし"],["は"],["それ"],["を"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["に"],["書き記された","かきしるされた"],["。"]]},{"verse":14,"text":"主はそのとき、あなたたちが渡って行って得ようとしている土地で行うべき掟と法をあなたたちに教えるようにわたしに命じられた。","tok":[["主","ぬし"],["は"],["その"],["とき"],["、"],["あなた"],["たち"],["が"],["渡って","わたって"],["行って","いって"],["得よう","えよう"],["として"],["いる"],["土地","とち"],["で"],["行うべき","おこなうべき"],["掟","おきて"],["と"],["法","ほう"],["を"],["あなた"],["たち"],["に"],["教える","おしえる"],["よう"],["に"],["わたし"],["に"],["命じられた","めいじられた"],["。"]]},{"verse":15,"text":"あなたたちは自らよく注意し
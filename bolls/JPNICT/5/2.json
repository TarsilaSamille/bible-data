[{"verse":1,"text":"我々は向きを変え、主がわたしに告げられたように、葦の海の道を通って荒れ野に向かって行き、長い間セイルの山地を巡った。","tok":[["我々","われわれ"],["は"],["向き","むき"],["を"],["変え","かえ"],["、"],["主","ぬし"],["が"],["わたし"],["に"],["告げられた","つげられた"],["よう"],["に"],["、"],["葦","あし"],["の"],["海","うみ"],["の"],["道","みち"],["を"],["通って","とおって"],["荒れ野","あれの"],["に"],["向かって","むかって"],["行き","いき"],["、"],["長い","ながい"],["間","あいだ"],["セイル"],["の"],["山地","さんち"],["を"],["巡った","めぐった"],["。"]]},{"verse":2,"text":"主はわたしに言われた。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"「あなたたちは既に久しくこの山地を巡った。北に向かって行きなさい。","tok":[["「"],["あなた"],["たち"],["は"],["既に","すでに"],["久しく","ひさしく"],["この"],["山地","さんち"],["を"],["巡った","めぐった"],["。"],["北","きた"],["に"],["向かって","むかって"],["行き","いき"],["なさい"],["。"]]},{"verse":4,"text":"あなたは民にこう命じなさい。あなたたちはこれから、セイルに住む親族エサウの子孫の領内を通る。彼らはあなたたちに恐れを抱いているから、よく気をつけなさい。","tok":[["あなた"],["は"],["民","みん"],["に"],["こう"],["命じ","めいじ"],["なさい"],["。"],["あなた"],["たち"],["は"],["これ"],["から"],["、"],["セイル"],["に"],["住む","すむ"],["親族","しんぞく"],["エサウ"],["の"],["子孫","しそん"],["の"],["領内","りょうない"],["を"],["通る","とおる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["たち"],["に"],["恐れ","おそれ"],["を"],["抱いて","いだいて"],["いる"],["から"],["、"],["よく"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":5,"text":"彼らに戦いを挑んではならない。彼らの土地は、足の裏で踏めるほどのものでもあなたたちには与えない。セイルの山地は既にエサウの領地として与えた。","tok":[["彼","かれ"],["ら"],["に"],["戦い","たたかい"],["を"],["挑んで","いどんで"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["土地","とち"],["は"],["、"],["足","あし"],["の"],["裏","うら"],["で"],["踏める","ふめる"],["ほど"],["の"],["もの"],["で"],["も"],["あなた"],["たち"],["に"],["は"],["与えない","あたえない"],["。"],["セイル"],["の"],["山地","さんち"],["は"],["既に","すでに"],["エサウ"],["の"],["領地","りょうち"],["として"],["与えた","あたえた"],["。"]]},{"verse":6,"text":"食物は彼らから金を払って買って食べ、水も彼らから金を払って買い、飲むようにしなさい。」","tok":[["食物","しょくもつ"],["は"],["彼","かれ"],["ら"],["から"],["金","かね"],["を"],["払って","はらって"],["買って","かって"],["食べ","たべ"],["、"],["水","みず"],["も"],["彼","かれ"],["ら"],["から"],["金","かね"],["を"],["払って","はらって"],["買い","かい"],["、"],["飲む","のむ"],["よう"],["に"],["し"],["なさい"],["。"],["」"]]},{"verse":7,"text":"あなたの神、主は、あなたの手の業をすべて祝福し、この広大な荒れ野の旅路を守り、この四十年の間、あなたの神、主はあなたと共におられたので、あなたは何一つ不足しなかった。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["の"],["手","て"],["の"],["業","ごう"],["を"],["すべて"],["祝福","しゅくふく"],["し"],["、"],["この"],["広大","こうだい"],["な"],["荒れ野","あれの"],["の"],["旅路","たびじ"],["を"],["守り","まもり"],["、"],["この"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["あなた"],["と"],["共","とも"],["に"],["おられた"],["ので"],["、"],["あなた"],["は"],["何","なん"],["一","ひと"],["つ"],["不足","ふそく"],["しなかった"],["。"]]},{"verse":8,"text":"我々はセイルに住む親族エサウの子孫を離れ、エイラトとエツヨン‧ゲベルからアラバを走る道を避けて向きを変え、モアブの荒れ野に通ずる道を通った。","tok":[["我々","われわれ"],["は"],["セイル"],["に"],["住む","すむ"],["親族","しんぞく"],["エサウ"],["の"],["子孫","しそん"],["を"],["離れ","はなれ"],["、"],["エイラト"],["と"],["エツヨン"],["‧"],["ゲベル"],["から"],["アラバ"],["を"],["走る","はしる"],["道","みち"],["を"],["避けて","さけて"],["向き","むき"],["を"],["変え","かえ"],["、"],["モアブ"],["の"],["荒れ野","あれの"],["に"],["通ずる","つうずる"],["道","みち"],["を"],["通った","とおった"],["。"]]},{"verse":9,"text":"主はわたしに言われた。「モアブを敵とし、彼らに戦いを挑んではならない。わたしはその土地を領地としてあなたには与えない。アルの町は既にロトの子孫に領地として与えた。――","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["モアブ"],["を"],["敵","てき"],["と"],["し"],["、"],["彼","かれ"],["ら"],["に"],["戦い","たたかい"],["を"],["挑んで","いどんで"],["は"],["ならない"],["。"],["わたし"],["は"],["その"],["土地","とち"],["を"],["領地","りょうち"],["として"],["あなた"],["に"],["は"],["与えない","あたえない"],["。"],["アル"],["の"],["町","まち"],["は"],["既に","すでに"],["ロト"],["の"],["子孫","しそん"],["に"],["領地","りょうち"],["として"],["与えた","あたえた"],["。"],["―"],["―"]]},{"verse":10,"text":"かつて、そこにはエミム人が住んでいた。強力で数も多く、アナク人のように背の高い民であった。","tok":[["かつて"],["、"],["そこ"],["に"],["は"],["エミム"],["人","ひと"],["が"],["住んで","すんで"],["いた"],["。"],["強力","きょうりょく"],["で"],["数","かず"],["も"],["多く","おおく"],["、"],["アナク人","あなくにん"],["の"],["よう"],["に"],["背","せ"],["の"],["高い","たかい"],["民","たみ"],["で"],["あった"],["。"]]},{"verse":11,"text":"彼らもアナク人と同様に、レファイム人であると見なされているが、モアブの人々は彼らをエミム人と呼んでいた。","tok":[["彼","かれ"],["ら"],["も"],["アナク人","あなくにん"],["と"],["同様","どうよう"],["に"],["、"],["レファイム"],["人","にん"],["で"],["ある"],["と"],["見なされて","みなされて"],["いる"],["が"],["、"],["モアブ"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["を"],["エミム人","えみむにん"],["と"],["呼んで","よんで"],["いた"],["。"]]},{"verse":12,"text":"セイルには、かつてフリ人が住んでいたが、エサウの子孫は彼らを追い払って滅ぼし、代わってそこに住んだ。これは、イスラエルが主から与えられた領地を手に入れたのと同様であった。――","tok":[["セイル"],["に"],["は"],["、"],["かつて"],["フリ人","ふりにん"],["が"],["住んで","すんで"],["いた"],["が"],["、"],["エサウ"],["の"],["子孫","しそん"],["は"],["彼","かれ"],["ら"],["を"],["追い払って","おいはらって"],["滅ぼし","ほろぼし"],["、"],["代わって","かわって"],["そこ"],["に"],["住んだ","すんだ"],["。"],["これ"],["は"],["、"],["イスラエル"],["が"],["主","ぬし"],["から"],["与えられた","あたえられた"],["領地","りょうち"],["を"],["手","て"],["に"],["入れた","いれた"],["の"],["と"],["同様","どうよう"],["で"],["あった"],["。"],["―"],["―"]]},{"verse":13,"text":"さあ、立ち上がって、ゼレド川を渡りなさい。」我々はゼレド川を渡ったが、","tok":[["さあ"],["、"],["立ち上がって","たちあがって"],["、"],["ゼレド"],["川","かわ"],["を"],["渡り","わたり"],["なさい"],["。"],["」"],["我々","われわれ"],["は"],["ゼレド"],["川","かわ"],["を"],["渡った","わたった"],["が"],["、"]]},{"verse":14,"text":"カデシュ‧バルネアを出発してからゼレド川を渡るまで、三十八年かかった。その間に、主が彼らに誓われたとおり、前の世代の戦闘員は陣営に一人もいなくなった。","tok":[["カデシュ"],["‧"],["バルネア"],["を"],["出発","しゅっぱつ"],["して"],["から"],["ゼレド"],["川","かわ"],["を"],["渡る","わたる"],["まで"],["、"],["三十八","さんじゅうはち"],["年","ねん"],["かかった"],["。"],["その"],["間","あいだ"],["に"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["に"],["誓われた","ちかわれた"],["とおり"],["、"],["前","まえ"],["の"],["世代","せだい"],["の"],["戦闘員","せんとういん"],["は"],["陣営","じんえい"],["に"],["一人","ひとり"],["も"],["いなく"],["なった"],["。"]]},{"verse":15,"text":"主の御手が彼らに向けられ、陣営に混乱が引き起こされ、彼らは死に絶えたのである。","tok":[["主","ぬし"],["の"],["御手","おて"],["が"],["彼","かれ"],["ら"],["に"],["向けられ","むけられ"],["、"],["陣営","じんえい"],["に"],["混乱","こんらん"],["が"],["引き起こされ","ひきおこされ"],["、"],["彼","かれ"],["ら"],["は"],["死に絶えた","しにたえた"],["ので"],["ある"],["。"]]},{"verse":16,"text":"戦闘員がこうして皆、民の中から死に絶えた後、","tok":[["戦闘員","せんとういん"],["が"],["こう"],["して"],["皆","みな"],["、"],["民","みん"],["の"],["中","なか"],["から"],["死に絶えた","しにたえた"],["後","あと"],["、"]]},{"verse":17,"text":"主はわたしに仰せになった。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":18,"text":"「あなたは、今
],["主","ぬし"],["が"],["あなた"],["と"],["あなた"],["の"],["家族","かぞく"],["に"],["与えられた","あたえられた"],["すべて"],["の"],["賜物","たまもの"],["を"],["、"],["レビ人","れびにん"],["および"],["あなた"],["の"],["中","なか"],["に"],["住んで","すんで"],["いる"],["寄留者","きりゅうしゃ"],["と"],["共","とも"],["に"],["喜び祝い","よろこびいわい"],["なさい"],["。"]]},{"verse":12,"text":"十分の一の納期である三年目ごとに、収穫物の十分の一を全部納め終わり、レビ人、寄留者、孤児、寡婦に施し、彼らが町の中でそれを食べて満ち足りたとき、","tok":[["十分","じゅうぶん"],["の"],["一","いち"],["の"],["納期","のうき"],["で"],["ある"],["三","さん"],["年目","ねんめ"],["ごと"],["に"],["、"],["収穫物","しゅうかくぶつ"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["全部","ぜんぶ"],["納め","おさめ"],["終わり","おわり"],["、"],["レビ人","れびにん"],["、"],["寄留者","きりゅうしゃ"],["、"],["孤児","こじ"],["、"],["寡婦","かふ"],["に"],["施し","ほどこし"],["、"],["彼","かれ"],["ら"],["が"],["町","まち"],["の"],["中","なか"],["で"],["それ"],["を"],["食べて","たべて"],["満ち足りた","みちたりた"],["とき"],["、"]]},{"verse":13,"text":"あなたの神、主の前で次のように言いなさい。「わたしは、聖なる献げ物を残らず家から取り出し、すべてあなたが命じられた戒めに従って、レビ人、寄留者、孤児、寡婦に施し、あなたの戒めからはずれたり、それを忘れたりしませんでした。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["次","つぎ"],["の"],["よう"],["に"],["言い","いい"],["なさい"],["。"],["「"],["わたし"],["は"],["、"],["聖","せい"],["なる"],["献げ物","ささげもの"],["を"],["残らず","のこらず"],["家","いえ"],["から"],["取り出し","とりだし"],["、"],["すべて"],["あなた"],["が"],["命じられた","めいじられた"],["戒め","いましめ"],["に"],["従って","したがって"],["、"],["レビ人","れびにん"],["、"],["寄留者","きりゅうしゃ"],["、"],["孤児","こじ"],["、"],["寡婦","かふ"],["に"],["施し","ほどこし"],["、"],["あなた"],["の"],["戒め","いましめ"],["から"],["はずれ"],["たり"],["、"],["それ"],["を"],["忘れ","わすれ"],["たり"],["しませんでした"],["。"]]},{"verse":14,"text":"それを喪中に食べたり、汚れているときに取り出したり、死者に供えたりしたことはありません。わたしの神、主の御声に聞き従い、すべてあなたが命じられたとおりに行いました。","tok":[["それ"],["を"],["喪中","もちゅう"],["に"],["食べ","たべ"],["たり"],["、"],["汚れて","よごれて"],["いる"],["とき"],["に"],["取り出し","とりだし"],["たり"],["、"],["死者","ししゃ"],["に"],["供え","そなえ"],["たり"],["した"],["こと"],["は"],["ありません"],["。"],["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従い","ききしたがい"],["、"],["すべて"],["あなた"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["行いました","おこないました"],["。"]]},{"verse":15,"text":"天にあるあなたの聖なる住まいから見
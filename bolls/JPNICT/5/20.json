[{"verse":1,"text":"あなたが敵に向かって出陣するとき、馬と戦車、また味方より多数の軍勢を見ても恐れてはならない。あなたをエジプトの国から導き上られたあなたの神、主が共におられるからである。","tok":[["あなた"],["が"],["敵","てき"],["に"],["向かって","むかって"],["出陣","しゅつじん"],["する"],["とき"],["、"],["馬","うま"],["と"],["戦車","せんしゃ"],["、"],["また"],["味方","みかた"],["より"],["多数","たすう"],["の"],["軍勢","ぐんぜい"],["を"],["見て","みて"],["も"],["恐れて","おそれて"],["は"],["ならない"],["。"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上られた","のぼられた"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["共","とも"],["に"],["おられる"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"いよいよ戦いの場に臨んだならば、祭司は進み出て、民に告げ、","tok":[["いよいよ"],["戦い","たたかい"],["の"],["場","ば"],["に"],["臨んだならば","のぞんだならば"],["、"],["祭司","さいし"],["は"],["進み出て","すすみでて"],["、"],["民","みん"],["に"],["告げ","つげ"],["、"]]},{"verse":3,"text":"次のように言わねばならない。「イスラエルよ、聞け。あなたたちは、今日、敵との戦いに臨む。心ひるむな。恐れるな。慌てるな。彼らの前にうろたえるな。","tok":[["次","つぎ"],["の"],["よう"],["に"],["言わねば","いわねば"],["ならない"],["。"],["「"],["イスラエル"],["よ"],["、"],["聞け","きけ"],["。"],["あなた"],["たち"],["は"],["、"],["今日","きょう"],["、"],["敵","てき"],["と"],["の"],["戦い","たたかい"],["に"],["臨む","のぞむ"],["。"],["心","こころ"],["ひるむ"],["な"],["。"],["恐れる","おそれる"],["な"],["。"],["慌てる","あわてる"],["な"],["。"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["うろたえる"],["な"],["。"]]},{"verse":4,"text":"あなたたちの神、主が共に進み、敵と戦って勝利を賜るからである。」","tok":[["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["共","とも"],["に"],["進み","すすみ"],["、"],["敵","てき"],["と"],["戦って","たたかって"],["勝利","しょうり"],["を"],["賜る","たまわる"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"役人たちは民に勧めなさい。「新しい家を建てて、まだ奉献式を済ませていない者はいないか。その人は家に帰りなさい。万一、戦死して、ほかの者が奉献式をするようなことにならないように。","tok":[["役人","やくにん"],["たち"],["は"],["民","みん"],["に"],["勧め","すすめ"],["なさい"],["。"],["「"],["新しい","あたらしい"],["家","いえ"],["を"],["建てて","たてて"],["、"],["まだ"],["奉献","ほうけん"],["式","しき"],["を"],["済ませて","すませて"],["いない"],["者","もの"],["は"],["いない"],["か"],["。"],["その"],["人","ひと"],["は"],["家","いえ"],["に"],["帰り","かえり"],["なさい"],["。"],["万一","まんいち"],["、"],["戦死","せんし"],["して"],["、"],["ほか"],["の"],["者","もの"],["が"],["奉献","ほうけん"],["式","しき"],["を"],["する"],["よう"],["な"],["こと"],["に"],["ならない"],["よう"],["に"],["。"]]},{"verse":6,"text":"ぶどう畑を作り、まだ最初の収穫をしていない者はいないか。その人は家に帰りなさい。万一、戦死して、ほかの者が最初の収穫をするようなことにならないように。","tok":[["ぶどう"],["畑","はたけ"],["を"],["作り","つくり"],["、"],["まだ"],["最初","さいしょ"],["の"],["収穫","しゅうかく"],["を"],["して"],["いない"],["者","もの"],["は"],["いない"],["か"],["。"],["その"],["人","ひと"],["は"],["家","いえ"],["に"],["帰り","かえり"],["なさい"],["。"],["万一","まんいち"],["、"],["戦死","せんし"],["して"],["、"],["ほか"],["の"],["者","もの"],["が"],["最初","さいしょ"],["の"],["収穫","しゅうかく"],["を"],["する"],["よう"],["な"],["こと"],["に"],["ならない"],["よう"],["に"],["。"]]},{"verse":7,"text":"婚約しただけで、まだ結婚していない者はいないか。その人は家に帰りなさい。万一、戦死して、ほかの者が彼女と結婚するようなことにならないように。」","tok":[["婚約","こんやく"],["した"],["だけ"],["で"],["、"],["まだ"],["結婚","けっこん"],["して"],["いない"],["者","もの"],["は"],["いない"],["か"],["。"],["その"],["人","ひと"],["は"],["家","いえ"],["に"],["帰り","かえり"],["なさい"],["。"],["万一","まんいち"],["、"],["戦死","せんし"],["して"],["、"],["ほか"],["の"],["者","もの"],["が"],["彼女","かのじょ"],["と"],["結婚","けっこん"],["する"],["よう"],["な"],["こと"],["に"],["ならない"],["よう"],["に"],["。"],["」"]]},{"verse":8,"text":"役人たちは更に民に勧めて言いなさい。「恐れて心ひるんでいる者はいないか。その人は家に帰りなさい。彼の心と同じように同胞の心が挫けるといけないから。」","tok":[["役人","やくにん"],["たち"],["は"],["更に","さらに"],["民","たみ"],["に"],["勧めて","すすめて"],["言い","いい"],["なさい"],["。"],["「"],["恐れて","おそれて"],["心","こころ"],["ひるんで"],["いる"],["者","もの"],["は"],["いない"],["か"],["。"],["その"],["人","ひと"],["は"],["家","いえ"],["に"],["帰り","かえり"],["なさい"],["。"],["彼","かれ"],["の"],["心","こころ"],["と"],["同じ","おなじ"],["よう"],["に"],["同胞","どうほう"],["の"],["心","こころ"],["が"],["挫ける","くじける"],["と"],["いけない"],["から"],["。"],["」"]]},{"verse":9,"text":"役人たちが民への勧めを終えたならば、各部隊の長は民の指揮を取りなさい。","tok":[["役人","やくにん"],["たち"],["が"],["民","たみ"],["へ"],["の"],["勧め","すすめ"],["を"],["終えたならば","おえたならば"],["、"],["各","かく"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["民","みん"],["の"],["指揮","しき"],["を"],["取り","とり"],["なさい"],["。"]]},{"verse":10,"text":"ある町を攻撃しようとして、そこに近づくならば、まず、降伏を勧告しなさい。","tok":[["ある"],["町","まち"],["を"],["攻撃","こうげき"],["しよう"],["として"],["、"],["そこ"],["に"],["近づくならば","ちかづくならば"],["、"],["まず"],["、"],["降伏","こうふく"],["を"],["勧告","かんこく"],["し"],["なさい"],["。"]]},{"verse":11,"text":"もしその町がそれを受諾し、城門を開くならば、その全住民を強制労働に服させ、あなたに仕えさせねばならない。","tok":[["もし"],["その"],["町","まち"],["が"],["それ"],["を"],["受諾","じゅだく"],["し"],["、"],["城門","じょうもん"],["を"],["開くならば","ひらくならば"],["、"],["その"],["全住民","ぜんじゅうみん"],["を"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服させ","ふくさせ"],["、"],["あなた"],["に"],["仕えさせねば","つかえさせねば"],["ならない"],["。"]]},{"verse":12,"text":"しかし、もしも降伏せず、抗戦するならば、町を包囲しなさい。","tok":[["しかし"],["、"],["もし"],["も"],["降伏","こうふく"],["せず"],["、"],["抗戦","こうせん"],["するならば"],["、"],["町","まち"],["を"],["包囲","ほうい"],["し"],["なさい"],["。"]]},{"verse":13,"text":"あなたの神、主はその町をあなたの手に渡されるから、あなたは男子をことごとく剣にかけて撃たねばならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["その"],["町","まち"],["を"],["あなた"],["の"],["手","て"],["に"],["渡される","わたされる"],["から"],["、"],["あなた"],["は"],["男子","だんし"],["を"],["ことごとく"],["剣","けん"],["に"],["かけて"],["撃たねば","うたねば"],["ならない"],["。"]]},{"verse":14,"text":"ただし、女、子供、家畜、および町にあるものはすべてあなたの分捕り品として奪い取ることができる。あなたは、あなたの神、主が与えられた敵の分捕り品を自由に用いることができる。","tok":[["ただし"],["、"],["女","おんな"],["、"],["子供","こども"],["、"],["家畜","かちく"],["、"],["および"],["町","まち"],["に"],["ある"],["もの"],["は"],["すべて"],["あなた"],["の"],["分捕り品","ぶんどりひん"],["として"],["奪い取る","うばいとる"],["こと"],["が"],["できる"],["。"],["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられた","あたえられた"],["敵","てき"],["の"],["分捕り品","ぶんどりひん"],["を"],["自由","じゆう"],["に"],["用いる","もちいる"],["こと"],["が"],["できる"],["。"]]},{"verse":15,"text":"このようになしうるのは、遠く離れた町々に対してであって、次に挙げる国々に属する町々に対してではない。","tok":[["この"],["よう"],["に"],["なし"],["うる"],["の"],["は"],["、"],["遠く","とおく"],["離れた","はなれた"],["町々","まちまち"],["に対して","にたいして"],["で"],["あって"],["、"],["次","つぎ"],["に"],["挙げる","あげる"],["国々","くにぐに"],["に"],["属する","ぞくする"],["町々","まちまち"],["に対して","にたいして"],["で"],["は"],["ない"],["。"]]},{"verse":16,"text":"あなたの神、主が嗣業として与えられる諸国の民に属する町々で息のある者は、一人も生かしておいてはならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["嗣業","しぎょう"],["として"],["与えられる","あたえられる"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["属する","ぞくする"],["町々","まちまち"],["で"],["息","いき"],["の"],["ある"],["者","もの"],["は"],["、"],["一人","ひとり"],["も"],["生かして","いかして"],["おいて"],["は"],["ならない"],["。"]]},{"verse":17,"text":"ヘト人、アモリ人、カナン人、ペリジ人、ヒビ人、エブス人は、あなたの神、主が命じられたように必ず滅ぼし尽くさねばならない。","tok":[["ヘト人","へとにん"],["、"],["アモリ人","あもりにん"],["、"],["カナン人","かなんにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["よう"],["に"],["必ず","かならず"],["滅ぼし","ほろぼし"],["尽くさねば","つくさねば"],["ならない"],["。"]]},{"verse":18,"text":"それは、彼らがその神々に行ってきた、あらゆるいとうべき行為をあなたたちに教えてそれを行わせ、あなたたちがあなたたちの神、主に罪を犯すことのないためである。","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["その"],["神々","かみがみ"],["に"],["行って","いって"],["きた"],["、"],["あらゆる"],["いとうべき"],["行為","こうい"],["を"],["あなた"],["たち"],["に"],["教えて","おしえて"],["それ"],["を"],["行わせ","おこなわせ"],["、"],["あなた"],["たち"],["が"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":19,"text":"あなたが町を攻略しようとして、長期にわたって包囲するとき、斧を振るってその町の木を切り尽くしてはならない。木の実は食糧になるから、それを切り倒してはならない。一体、野の木はあなたの前から城壁に囲まれた町に逃げ込む人間なのか。","tok":[["あなた"],["が"],["町","まち"],["を"],["攻略","こうりゃく"],["しよう"],["として"],["、"],["長期","ちょうき"],["に"],["わたって"],["包囲","ほうい"],["する"],["とき"],["、"],["斧","おの"],["を"],["振るって","ふるって"],["その"],["町","まち"],["の"],["木","き"],["を"],["切り","きり"],["尽くして","つくして"],["は"],["ならない"],["。"],["木の実","このみ"],["は"],["食糧","しょくりょう"],["に"],["なる"],["から"],["、"],["それ"],["を"],["切り倒して","きりたおして"],["は"],["ならない"],["。"],["一体","いったい"],["、"],["野","の"],["の"],["木","き"],["は"],["あなた"],["の"],["前","まえ"],["から"],["城壁","じょうへき"],["に"],["囲まれた","かこまれた"],["町","まち"],["に"],["逃げ込む","にげこむ"],["人間","にんげん"],["な"],["の"],["か"],["。"]]},{"verse":20,"text":"ただ食用にならないことが分かっている木を切り尽くし、切った木を用いて塁を築き、あなたに抗戦する町を攻め落としなさい。","tok":[["ただ"],["食用","しょくよう"],["に"],["ならない"],["こと"],["が"],["分かって","わかって"],["いる"],["木","き"],["を"],["切り","きり"],["尽くし","づくし"],["、"],["切った","きった"],["木","き"],["を"],["用いて","もちいて"],["塁","るい"],["を"],["築き","きずき"],["、"],["あなた"],["に"],["抗戦","こうせん"],["する"],["町","まち"],["を"],["攻め落とし","せめおとし"],["なさい"],["。"]]}]
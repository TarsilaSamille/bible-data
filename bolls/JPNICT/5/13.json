"],["よう"],["な"],["いとうべき"],["こと"],["が"],["あなた"],["たち"],["の"],["中","なか"],["で"],["行われた","おこなわれた"],["ので"],["あれば"],["、"]]},{"verse":16,"text":"その町の住民を剣にかけて殺し、町もそこにあるすべてのものも滅ぼし尽くし、家畜も剣にかけねばならない。","tok":[["その"],["町","まち"],["の"],["住民","じゅうみん"],["を"],["剣","けん"],["に"],["かけて"],["殺し","ころし"],["、"],["町","まち"],["も"],["そこ"],["に"],["ある"],["すべて"],["の"],["もの"],["も"],["滅ぼし","ほろぼし"],["尽くし","つくし"],["、"],["家畜","かちく"],["も"],["剣","けん"],["に"],["かけねば"],["ならない"],["。"]]},{"verse":17,"text":"分捕り品をすべて広場の中央に集め、分捕り品もろとも町全体を焼き払い、あなたの神、主に対する完全に燃やし尽くす献げ物としなければならない。その町はとこしえに廃虚の丘となって、再び建てられることはない。","tok":[["分捕り品","ぶんどりひん"],["を"],["すべて"],["広場","ひろば"],["の"],["中央","ちゅうおう"],["に"],["集め","あつめ"],["、"],["分捕り品","ぶんどりひん"],["もろとも"],["町","ちょう"],["全体","ぜんたい"],["を"],["焼き払い","やきはらい"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["に"],["対する","たいする"],["完全","かんぜん"],["に"],["燃やし","もやし"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["しなければ"],["ならない"],["。"],["その"],["町","まち"],["は"],["とこしえ"],["に"],["廃虚","はいきょ"],["の"],["丘","おか"],["と"],["なって"],["、"],["再び","ふたたび"],["建てられる","たてられる"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"主が激しい怒りをやめ、あなたに憐れみを垂れ、先祖たちに誓われたとおり、憐れみをもってあなたの数を増やされるように、その滅ぼし尽くすべきものは何一つ手もとにとどめてはならない。","tok":[["主","ぬし"],["が"],["激しい","はげしい"],["怒り","いかり"],["を"],["やめ"],["、"],["あなた"],["に"],["憐れみ","あわれみ"],["を"],["垂れ","たれ"],["、"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["とおり"],["、"],["憐れみ","あわれみ"],["を"],["もって"],["あなた"],["の"],["数","かず"],["を"],["増やされる","ふやされる"],["よう"],["に"],["、"],["その"],["滅ぼし","ほろぼし"],["尽くすべき","つくすべき"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["手もと","てもと"],["に"],["とどめて"],["は"],["ならない"],["。"]]},{"verse":19,"text":"あなたの神、主の御声に聞き従い、わたしが今日命じるすべての戒めを守り、あなたの神、主が正しいと見なされることを行いなさい。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従い","ききしたがい"],["、"],["わたし"],["が"],["今日","きょう"],["命じる","めいじる"],["すべて"],["の"],["戒め","いましめ"],["を"],["守り","まもり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["正しい","ただしい"],["と"],["見なされる","みなされる"],["こと"],["を"],["行い","おこない"],["なさい"],["。"]]}]
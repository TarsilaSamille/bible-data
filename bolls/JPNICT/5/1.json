,["、"],["どう"],["して"],["ひとり"],["で"],["あなた"],["たち"],["の"],["重荷","おもに"],["、"],["もめ事","もめごと"],["、"],["争い","あらそい"],["を"],["負えるだろう","おえるだろう"],["か"],["。"]]},{"verse":13,"text":"部族ごとに、賢明で思慮深く、経験に富む人々を選び出しなさい。わたしはその人たちをあなたたちの長としよう。」","tok":[["部族","ぶぞく"],["ごと"],["に"],["、"],["賢明","けんめい"],["で"],["思慮","しりょ"],["深く","ふかく"],["、"],["経験","けいけん"],["に"],["富む","とむ"],["人々","ひとびと"],["を"],["選び出し","えらびだし"],["なさい"],["。"],["わたし"],["は"],["その"],["人","ひと"],["たち"],["を"],["あなた"],["たち"],["の"],["長","ちょう"],["と"],["しよう"],["。"],["」"]]},{"verse":14,"text":"あなたたちがわたしに答えて、「提案されたことは結構なことです」と言ったので、","tok":[["あなた"],["たち"],["が"],["わたし"],["に"],["答えて","こたえて"],["、"],["「"],["提案","ていあん"],["された"],["こと"],["は"],["結構","けっこう"],["な"],["こと"],["です"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":15,"text":"わたしは、あなたたちの部族の長で、賢明な経験に富む人たちを選んで、彼らをあなたたちの長、すなわち千人隊長、百人隊長、五十人隊長、十人隊長とし、また、あなたたちの部族の役人とした。","tok":[["わたし"],["は"],["、"],["あなた"],["たち"],["の"],["部族","ぶぞく"],["の"],["長","ちょう"],["で"],["、"],["賢明","けんめい"],["な"],["経験","けいけん"],["に"],["富む","とむ"],["人","ひと"],["たち"],["を"],["選んで","えらんで"],["、"],["彼","かれ"],["ら"],["を"],["あなた"],["たち"],["の"],["長","ちょう"],["、"],["すなわち"],["千人","せんにん"],["隊長","たいちょう"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["、"],["五","ご"],["十人隊長","じゅうにんたいちょう"],["、"],["十人隊長","じゅうにんたいちょう"],["と"],["し"],["、"],["また"],["、"],["あなた"],["たち"],["の"],["部族","ぶぞく"],["の"],["役人","やくにん"],["と"],["した"],["。"]]},{"verse":16,"text":"わたしはそのとき、あなたたちの裁判人に命じた。「同胞の間に立って言い分をよく聞き、同胞間の問題であれ、寄留者との間の問題であれ、正しく裁きなさい。","tok":[["わたし"],["は"],["その"],["とき"],["、"],["あなた"],["たち"],["の"],["裁判人","さいばんにん"],["に"],["命じた","めいじた"],["。"],["「"],["同胞","どうほう"],["の"],["間","あいだ"],["に"],["立って","たって"],["言い分","いいぶん"],["を"],["よく"],["聞き","きき"],["、"],["同胞間","どうほうかん"],["の"],["問題","もんだい"],["で"],["あれ"],["、"],["寄留者","きりゅうしゃ"],["と"],["の"],["間","あいだ"],["の"],["問題","もんだい"],["で"],["あれ"],["、"],["正しく","ただしく"],["裁き","さばき"],["なさい"],["。"]]},{"verse":17,"text":"裁判に当たって、偏り見ることがあってはならない。身分の上下を問わず、等しく事情を聞くべきである。人の顔色をうかがってはならない。裁判は神に属することだからである。事件があなたたちの手に負えない場合は、わたしのところに持って来なさい。わたしが聞くであろう。」","tok":[["裁判","
[{"verse":1,"text":"あなたの神、主が国々の民を絶やされ、あなたの神、主があなたにその土地を与えられ、あなたがそれを得て、彼らの町々、家々に住むようになったならば、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["国々","くにぐに"],["の"],["民","たみ"],["を"],["絶やされ","たやされ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["その"],["土地","とち"],["を"],["与えられ","あたえられ"],["、"],["あなた"],["が"],["それ"],["を"],["得て","えて"],["、"],["彼","かれ"],["ら"],["の"],["町々","まちまち"],["、"],["家々","いえいえ"],["に"],["住む","すむ"],["よう"],["に"],["なったならば"],["、"]]},{"verse":2,"text":"あなたの神、主があなたに与えて得させられる土地のうちに三つの町を選び分けなさい。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えて","あたえて"],["得させられる","えさせられる"],["土地","とち"],["の"],["うち"],["に"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["選び分け","えらびわけ"],["なさい"],["。"]]},{"verse":3,"text":"そして道のりを測り、あなたの神、主があなたに受け継がせられる領土を三つに分け、人を殺した者がだれでもそこに逃げられるようにしなさい。","tok":[["そして"],["道のり","みちのり"],["を"],["測り","はかり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["受け継がせられる","うけつがせられる"],["領土","りょうど"],["を"],["三","みっ"],["つ"],["に"],["分け","わけ"],["、"],["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["が"],["だれ"],["で"],["も"],["そこ"],["に"],["逃げられる","にげられる"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":4,"text":"意図してでなく、積年の恨みによるのでもないのに、隣人を殺してしまった者が逃れて生き延びうるのは、次のような場合である。","tok":[["意図","いと"],["して"],["で"],["なく"],["、"],["積年","せきねん"],["の"],["恨み","うらみ"],["に"],["よる"],["ので"],["も"],["ない"],["のに"],["、"],["隣人","りんじん"],["を"],["殺して","ころして"],["しまった"],["者","もの"],["が"],["逃れて","のがれて"],["生き延び","いきのび"],["うる"],["の"],["は"],["、"],["次","つぎ"],["の"],["よう"],["な"],["場合","ばあい"],["で"],["ある"],["。"]]},{"verse":5,"text":"すなわち、隣人と柴刈りに森の中に入り、木を切ろうと斧を手にして振り上げたとき、柄から斧の頭が抜けてその隣人に当たり、死なせたような場合である。彼はこれらの町の一つに逃れて生き延びることができる。","tok":[["すなわち"],["、"],["隣人","りんじん"],["と"],["柴刈り","しばかり"],["に"],["森","もり"],["の"],["中","なか"],["に"],["入り","はいり"],["、"],["木","き"],["を"],["切ろう","きろう"],["と"],["斧","おの"],["を"],["手","て"],["に"],["して"],["振り上げた","ふりあげた"],["とき"],["、"],["柄","がら"],["から"],["斧","おの"],["の"],["頭","あたま"],["が"],["抜けて","ぬけて"],["その"],["隣人","りんじん"],["に"],["当たり","あたり"],["、"],["死なせた","しなせた"],["よう"],["な"],["場合","ばあい"],["で"],["ある"],["。"],["彼","かれ"],["は"],["これ"],["ら"],["の"],["町","まち"],["の"],["一","ひと"],["つ"],["に"],["逃れて","のがれて"],["生き延びる","いきのびる"],["こと"],["が"],["できる"],["。"]]},{"verse":6,"text":"復讐する者が激昂して人を殺した者を追跡し、道のりが遠すぎるために、追いついて彼を打ち殺すことはあってはならない。その人は、積年の恨みによって殺したのではないから、殺される理由はない。","tok":[["復讐","ふくしゅう"],["する"],["者","もの"],["が"],["激昂","げっこう"],["して"],["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["を"],["追跡","ついせき"],["し"],["、"],["道のり","みちのり"],["が"],["遠","とお"],["すぎる"],["ため"],["に"],["、"],["追いついて","おいついて"],["彼","かれ"],["を"],["打ち殺す","うちころす"],["こと"],["は"],["あって"],["は"],["ならない"],["。"],["その"],["人","ひと"],["は"],["、"],["積年","せきねん"],["の"],["恨み","うらみ"],["によって"],["殺した","ころした"],["ので"],["は"],["ない"],["から"],["、"],["殺される","ころされる"],["理由","りゆう"],["は"],["ない"],["。"]]},{"verse":7,"text":"わたしはそれゆえ、三つの町を選び分けるようにあなたに命じる。","tok":[["わたし"],["は"],["それ"],["ゆえ"],["、"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["選び分ける","えらびわける"],["よう"],["に"],["あなた"],["に"],["命じる","めいじる"],["。"]]},{"verse":8,"text":"わたしが、今日、あなたに命じるこの戒めをすべて忠実に守って、あなたの神、主を愛し、生涯その道に従って歩むならば、あなたの神、主は、先祖に誓われたようにあなたの領土を広げ、先祖に与えると約束された土地をことごとくあなたに与えられる。そのときには、この三つの町のほかに、更に三つの町を加えなさい。","tok":[["わたし"],["が"],["、"],["今日","きょう"],["、"],["あなた"],["に"],["命じる","めいじる"],["この"],["戒め","いましめ"],["を"],["すべて"],["忠実","ちゅうじつ"],["に"],["守って","まもって"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["愛し","あいし"],["、"],["生涯","しょうがい"],["その"],["道","みち"],["に"],["従って","したがって"],["歩むならば","あゆむならば"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["よう"],["に"],["あなた"],["の"],["領土","りょうど"],["を"],["広げ","ひろげ"],["、"],["先祖","せんぞ"],["に"],["与える","あたえる"],["と"],["約束","やくそく"],["された"],["土地","とち"],["を"],["ことごとく"],["あなた"],["に"],["与えられる","あたえられる"],["。"],["その"],["とき"],["に"],["は"],["、"],["この"],["三","みっ"],["つ"],["の"],["町","まち"],["の"],["ほか"],["に"],["、"],["更に","さらに"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["加え","くわえ"],["なさい"],["。"]]},{"verse":10,"text":"あなたの神、主があなたの嗣業として与えられる土地に罪なき者の血が流され、その責任があなたに及ぶことがないようにするためである。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["の"],["嗣業","しぎょう"],["として"],["与えられる","あたえられる"],["土地","とち"],["に"],["罪","つみ"],["なき"],["者","もの"],["の"],["血","ち"],["が"],["流され","ながされ"],["、"],["その"],["責任","せきにん"],["が"],["あなた"],["に"],["及ぶ","およぶ"],["こと"],["が"],["ない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":11,"text":"しかし、もしある者が隣人を憎み、待ち伏せして襲いかかって打ち殺し、これらの町の一つに逃れたならば、","tok":[["しかし"],["、"],["もし"],["ある"],["者","もの"],["が"],["隣人","りんじん"],["を"],["憎み","にくみ"],["、"],["待ち伏せ","まちぶせ"],["して"],["襲いかかって","おそいかかって"],["打ち殺し","うちころし"],["、"],["これ"],["ら"],["の"],["町","まち"],["の"],["一","ひと"],["つ"],["に"],["逃れたならば","のがれたならば"],["、"]]},{"verse":12,"text":"その犯人を出した町の長老たちは、人を遣わして彼を捕らえ、復讐する者の手に引き渡して殺させねばならない。","tok":[["その"],["犯人","はんにん"],["を"],["出した","だした"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["は"],["、"],["人","ひと"],["を"],["遣わして","つかわして"],["彼","かれ"],["を"],["捕らえ","とらえ"],["、"],["復讐","ふくしゅう"],["する"],["者","もの"],["の"],["手","て"],["に"],["引き渡して","ひきわたして"],["殺させねば","ころさせねば"],["ならない"],["。"]]},{"verse":13,"text":"彼に憐れみをかけてはならない。罪なき者の血を流した罪をイスラエルから除き去れば、あなたは幸いを得る。","tok":[["彼","かれ"],["に"],["憐れみ","あわれみ"],["を"],["かけて"],["は"],["ならない"],["。"],["罪","つみ"],["なき"],["者","もの"],["の"],["血","ち"],["を"],["流した","ながした"],["罪","つみ"],["を"],["イスラエル"],["から"],["除き去れば","のぞきされば"],["、"],["あなた"],["は"],["幸い","さいわい"],["を"],["得る","うる"],["。"]]},{"verse":14,"text":"あなたの神、主があなたに与えて得させられる土地で、すなわちあなたが受け継ぐ嗣業の土地で、最初の人々が定めたあなたの隣人との地境を動かしてはならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["与えて","あたえて"],["得させられる","えさせられる"],["土地","とち"],["で"],["、"],["すなわち"],["あなた"],["が"],["受け継ぐ","うけつぐ"],["嗣業","しぎょう"],["の"],["土地","とち"],["で"],["、"],["最初","さいしょ"],["の"],["人々","ひとびと"],["が"],["定めた","さだめた"],["あなた"],["の"],["隣人","りんじん"],["と"],["の"],["地境","じざかい"],["を"],["動かして","うごかして"],["は"],["ならない"],["。"]]},{"verse":15,"text":"いかなる犯罪であれ、およそ人の犯す罪について、一人の証人によって立証されることはない。二人ないし三人の証人の証言によって、その事は立証されねばならない。","tok":[["いかなる"],["犯罪","はんざい"],["で"],["あれ"],["、"],["およそ"],["人","ひと"],["の"],["犯す","おかす"],["罪","つみ"],["について"],["、"],["一人","ひとり"],["の"],["証人","しょうにん"],["によって"],["立証","りっしょう"],["される"],["こと"],["は"],["ない"],["。"],["二人","ふたり"],["ないし"],["三人","さんにん"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["によって"],["、"],["その"],["事","こと"],["は"],["立証","りっしょう"],["されねば"],["ならない"],["。"]]},{"verse":16,"text":"不法な証人が立って、相手の不正を証言するときは、","tok":[["不法","ふほう"],["な"],["証人","しょうにん"],["が"],["立って","たって"],["、"],["相手","あいて"],["の"],["不正","ふせい"],["を"],["証言","しょうげん"],["する"],["とき"],["は"],["、"]]},{"verse":17,"text":"係争中の両者は主の前に出、そのとき任に就いている祭司と裁判人の前に出ねばならない。","tok":[["係争中","けいそうちゅう"],["の"],["両者","りょうしゃ"],["は"],["主","ぬし"],["の"],["前","まえ"],["に"],["出","で"],["、"],["その"],["とき"],["任","にん"],["に"],["就いて","ついて"],["いる"],["祭司","さいし"],["と"],["裁判人","さいばんにん"],["の"],["前","まえ"],["に"],["出ねば","でねば"],["ならない"],["。"]]},{"verse":18,"text":"裁判人は詳しく調査し、もしその証人が偽証人であり、同胞に対して偽証したということになれば、","tok":[["裁判人","さいばんにん"],["は"],["詳しく","くわしく"],["調査","ちょうさ"],["し"],["、"],["もし"],["その"],["証人","しょうにん"],["が"],["偽証人","ぎしょうにん"],["で"],["あり"],["、"],["同胞","どうほう"],["に対して","にたいして"],["偽証","ぎしょう"],["した"],["と"],["いう"],["こと"],["に"],["なれば"],["、"]]},{"verse":19,"text":"彼が同胞に対してたくらんだ事を彼自身に報い、あなたの中から悪を取り除かねばならない。","tok":[["彼","かれ"],["が"],["同胞","どうほう"],["に対して","にたいして"],["たくらんだ"],["事","こと"],["を"],["彼","かれ"],["自身","じしん"],["に"],["報い","むくい"],["、"],["あなた"],["の"],["中","なか"],["から"],["悪","あく"],["を"],["取り除かねば","とりのぞかねば"],["ならない"],["。"]]},{"verse":20,"text":"ほかの者たちは聞いて恐れを抱き、このような悪事をあなたの中で二度と繰り返すことはないであろう。","tok":[["ほか"],["の"],["者","もの"],["たち"],["は"],["聞いて","きいて"],["恐れ","おそれ"],["を"],["抱き","いだき"],["、"],["この"],["よう"],["な"],["悪事","あくじ"],["を"],["あなた"],["の"],["中","なか"],["で"],["二","に"],["度","ど"],["と"],["繰り返す","くりかえす"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":21,"text":"あなたは憐れみをかけてはならない。命には命、目には目、歯には歯、手には手、足には足を報いなければならない。","tok":[["あなた"],["は"],["憐れみ","あわれみ"],["を"],["かけて"],["は"],["ならない"],["。"],["命","いのち"],["に"],["は"],["命","いのち"],["、"],["目","め"],["に"],["は"],["目","め"],["、"],["歯","は"],["に"],["は"],["歯","は"],["、"],["手","て"],["に"],["は"],["手","て"],["、"],["足","あし"],["に"],["は"],["足","あし"],["を"],["報いなければ","むくいなければ"],["
き"],["行い","おこない"],["の"],["ゆえ"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["前","まえ"],["から"],["追い払われるで","おいはらわれるで"],["あろう"],["。"]]},{"verse":13,"text":"あなたは、あなたの神、主と共にあって全き者でなければならない。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["と"],["共","とも"],["に"],["あって"],["全","ぜん"],["き者","きしゃ"],["で"],["なければ"],["ならない"],["。"]]},{"verse":14,"text":"あなたが追い払おうとしているこれらの国々の民は、卜者や占い師に尋ねるが、あなたの神、主はあなたがそうすることをお許しにならない。","tok":[["あなた"],["が"],["追い払おう","おいはらおう"],["として"],["いる"],["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["は"],["、"],["卜者","ぼくしゃ"],["や"],["占い師","うらないし"],["に"],["尋ねる","たずねる"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["あなた"],["が"],["そう"],["する"],["こと"],["を"],["お許し","おゆるし"],["に"],["ならない"],["。"]]},{"verse":15,"text":"あなたの神、主はあなたの中から、あなたの同胞の中から、わたしのような預言者を立てられる。あなたたちは彼に聞き従わねばならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["あなた"],["の"],["中","なか"],["から"],["、"],["あなた"],["の"],["同胞","どうほう"],["の"],["中","なか"],["から"],["、"],["わたし"],["の"],["よう"],["な"],["預言者","よげんしゃ"],["を"],["立てられる","たてられる"],["。"],["あなた"],["たち"],["は"],["彼","かれ"],["に"],["聞き従わねば","ききしたがわねば"],["ならない"],["。"]]},{"verse":16,"text":"このことはすべて、あなたがホレブで、集会の日に、「二度とわたしの神、主の声を聞き、この大いなる火を見て、死ぬことのないようにしてください」とあなたの神、主に求めたことによっている。","tok":[["この"],["こと"],["は"],["すべて"],["、"],["あなた"],["が"],["ホレブ"],["で"],["、"],["集会","しゅうかい"],["の"],["日","ひ"],["に"],["、"],["「"],["二","に"],["度","ど"],["と"],["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["声","こえ"],["を"],["聞き","きき"],["、"],["この"],["大いなる","おおいなる"],["火","ひ"],["を"],["見て","みて"],["、"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["」"],["と"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["求めた","もとめた"],["こと"],["によって"],["いる"],["。"]]},{"verse":17,"text":"主はそのときわたしに言われた。「彼らの言うことはもっともである。","tok":[["主","ぬし"],["は"],["その"],["とき"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["は"],["もっとも"],["で"],["ある"],["。"]]},{"verse":18,"text":"わたしは彼らのために、同胞の中からあなたのような預言者を立ててその口にわたしの言葉を授ける。彼はわたしが命じることをすべて彼らに告げるであろう。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["、"],["同胞","どうほう"],["の"],["中","なか"],["から"],["あなた"],["の"],["よう"],["な"],["預言者","よげんしゃ"],["を"],["立てて","たてて"],["その"],["口","くち"],["に"],["わたし"],["の"],["言葉","ことば"],["を"],["授ける","さずける"],["。"],["彼","かれ"],["は"],["わたし"],["が"],["命じる","めいじる"],["こと"],["を"],["すべて"],["彼","かれ"],["ら"],["に"],["告げるで","つげるで"],["あろう"],["。"]]},{"verse":19,"text":"彼がわたしの名によってわたしの言葉を語るのに、聞き従わない者があるならば、わたしはその責任を追及する。","tok":[["彼","かれ"],["が"],["わたし"],["の"],["名","な"],["によって"],["わたし"],["の"],["言葉","ことば"],["を"],["語る","かたる"],["のに"],["、"],["聞き従わない","ききしたがわない"],["者","もの"],["が"],["あるならば"],["、"],["わたし"],["は"],["その"],["責任","せきにん"],["を"],["追及","ついきゅう"],["する"],["。"]]},{"verse":20,"text":"ただし、その預言者がわたしの命じていないことを、勝手にわたしの名によって語り、あるいは、他の神々の名によって語るならば、その預言者は死なねばならない。」","tok":[["ただし"],["、"],["その"],["預言者","よげんしゃ"],["が"],["わたし"],["の"],["命じて","めいじて"],["いない"],["こと"],["を"],["、"],["勝手に","かってに"],["わたし"],["の"],["名","な"],["によって"],["語り","かたり"],["、"],["あるいは"],["、"],["他","た"],["の"],["神々","かみがみ"],["の"],["名","な"],["によって"],["語るならば","かたるならば"],["、"],["その"],["預言者","よげんしゃ"],["は"],["死なねば","しなねば"],["ならない"],["。"],["」"]]},{"verse":21,"text":"あなたは心の中で、「どうして我々は、その言葉が主の語られた言葉ではないということを知りうるだろうか」と言うであろう。","tok":[["あなた"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["、"],["「"],["どう"],["して"],["我々","われわれ"],["は"],["、"],["その"],["言葉","ことば"],["が"],["主","ぬし"],["の"],["語られた","かたられた"],["言葉","ことば"],["で"],["は"],["ない"],["と"],["いう"],["こと"],["を"],["知り","しり"],["うるだろう"],["か"],["」"],["と"],["言うで","ゆうで"],["あろう"],["。"]]},{"verse":22,"text":"その預言者が主の御名によって語っても、そのことが起こらず、実現しなければ、それは主が語られたものではない。預言者が勝手に語ったのであるから、恐れることはない。","tok":[["その"],["預言者","よげんしゃ"],["が"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["語って","かたって"],["も"],["、"],["その"],["こと"],["が"],["起こらず","おこらず"],["、"],["実現","じつげん"],["しなければ"],["、"],["それ"],["は"],["主","ぬし"],["が"],["語られた","かたられた"],["もの"],["で"],["は"],["ない"],["。"],["預言者","よげんしゃ"],["が"],["勝手に","かってに"],["語った","かたった"],["ので"],["ある"],["から"],["、"],["恐れる","おそれる"],["こと"],["は"
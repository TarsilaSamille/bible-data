[{"verse":1,"text":"わたしがあなたの前に置いた祝福と呪い、これらのことがすべてあなたに臨み、あなたが、あなたの神、主によって追いやられたすべての国々で、それを思い起こし、","tok":[["わたし"],["が"],["あなた"],["の"],["前","まえ"],["に"],["置いた","おいた"],["祝福","しゅくふく"],["と"],["呪い","のろい"],["、"],["これ"],["ら"],["の"],["こと"],["が"],["すべて"],["あなた"],["に"],["臨み","のぞみ"],["、"],["あなた"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["よって"],["追いやられた","おいやられた"],["すべて"],["の"],["国々","くにぐに"],["で"],["、"],["それ"],["を"],["思い起こし","おもいおこし"],["、"]]},{"verse":2,"text":"あなたの神、主のもとに立ち帰り、わたしが今日命じるとおり、あなたの子らと共に、心を尽くし、魂を尽くして御声に聞き従うならば、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["もと"],["に"],["立ち帰り","たちかえり"],["、"],["わたし"],["が"],["今日","きょう"],["命じる","めいじる"],["とおり"],["、"],["あなた"],["の"],["子","こ"],["ら"],["と"],["共","とも"],["に"],["、"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["魂","たましい"],["を"],["尽くして","つくして"],["御声","おこえ"],["に"],["聞き従うならば","ききしたがうならば"],["、"]]},{"verse":3,"text":"あなたの神、主はあなたの運命を回復し、あなたを憐れみ、あなたの神、主が追い散らされたすべての民の中から再び集めてくださる。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["あなた"],["の"],["運命","うんめい"],["を"],["回復","かいふく"],["し"],["、"],["あなた"],["を"],["憐れみ","あわれみ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["追い散らされた","おいちらされた"],["すべて"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["再び","ふたたび"],["集めて","あつめて"],["くださる"],["。"]]},{"verse":4,"text":"たとえ天の果てに追いやられたとしても、あなたの神、主はあなたを集め、そこから連れ戻される。","tok":[["たとえ"],["天","てん"],["の"],["果て","はて"],["に"],["追いやられた","おいやられた"],["として"],["も"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["あなた"],["を"],["集め","あつめ"],["、"],["そこ"],["から"],["連れ戻される","つれもどされる"],["。"]]},{"verse":5,"text":"あなたの神、主は、かつてあなたの先祖のものであった土地にあなたを導き入れ、これを得させ、幸いにし、あなたの数を先祖よりも増やされる。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["かつて"],["あなた"],["の"],["先祖","せんぞ"],["の"],["もの"],["で"],["あった"],["土地","とち"],["に"],["あなた"],["を"],["導き入れ","みちびきいれ"],["、"],["これ"],["を"],["得させ","えさせ"],["、"],["幸い","さいわい"],["に"],["し"],["、"],["あなた"],["の"],["数","かず"],["を"],["先祖","せんぞ"],["より"],["も"],["増やされる","ふやされる"],["。"]]},{"verse":6,"text":"あなたの神、主はあなたとあなたの子孫の心に割礼を施し、心を
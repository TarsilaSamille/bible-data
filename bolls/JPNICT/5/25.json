[{"verse":1,"text":"二人の間に争いが生じ、彼らが法廷に出頭するならば、正しい者を無罪とし、悪い者を有罪とする判決が下されねばならない。","tok":[["二人","ふたり"],["の"],["間","あいだ"],["に"],["争い","あらそい"],["が"],["生じ","しょうじ"],["、"],["彼","かれ"],["ら"],["が"],["法廷","ほうてい"],["に"],["出頭","しゅっとう"],["するならば"],["、"],["正しい","ただしい"],["者","もの"],["を"],["無罪","むざい"],["と"],["し"],["、"],["悪い","わるい"],["者","もの"],["を"],["有罪","ゆうざい"],["と"],["する"],["判決","はんけつ"],["が"],["下されねば","くだされねば"],["ならない"],["。"]]},{"verse":2,"text":"もし有罪の者が鞭打ちの刑に定められる場合、裁判人は彼をうつ伏せにし、自分の前で罪状に応じた数だけ打たせねばならない。","tok":[["もし"],["有罪","ゆうざい"],["の"],["者","もの"],["が"],["鞭打ち","むちうち"],["の"],["刑","けい"],["に"],["定められる","さだめられる"],["場合","ばあい"],["、"],["裁判人","さいばんにん"],["は"],["彼","かれ"],["を"],["うつ伏せ","うつぶせ"],["に"],["し"],["、"],["自分","じぶん"],["の"],["前","まえ"],["で"],["罪状","ざいじょう"],["に"],["応じた","おうじた"],["数","かず"],["だけ"],["打たせねば","うたせねば"],["ならない"],["。"]]},{"verse":3,"text":"四十回までは打ってもよいが、それ以上はいけない。それ以上鞭打たれて、同胞があなたの前で卑しめられないためである。","tok":[["四十","よんじゅう"],["回","かい"],["まで"],["は"],["打って","うって"],["も"],["よい"],["が"],["、"],["それ"],["以上","いじょう"],["は"],["いけない"],["。"],["それ"],["以上","いじょう"],["鞭打たれて","むちうたれて"],["、"],["同胞","どうほう"],["が"],["あなた"],["の"],["前","まえ"],["で"],["卑しめられない","いやしめられない"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"脱穀している牛に口籠を掛けてはならない。","tok":[["脱穀","だっこく"],["して"],["いる"],["牛","うし"],["に"],["口","くち"],["籠","かご"],["を"],["掛けて","かけて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"兄弟が共に暮らしていて、そのうちの一人が子供を残さずに死んだならば、死んだ者の妻は家族以外の他の者に嫁いではならない。亡夫の兄弟が彼女のところに入り、めとって妻として、兄弟の義務を果たし、","tok":[["兄弟","きょうだい"],["が"],["共","とも"],["に"],["暮らして","くらして"],["いて"],["、"],["その"],["うち"],["の"],["一人","ひとり"],["が"],["子供","こども"],["を"],["残さず","のこさず"],["に"],["死んだならば","しんだならば"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["妻","つま"],["は"],["家族","かぞく"],["以外","いがい"],["の"],["他","ほか"],["の"],["者","もの"],["に"],["嫁いで","とついで"],["は"],["ならない"],["。"],["亡夫","ぼうふ"],["の"],["兄弟","きょうだい"],["が"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入り","はいり"],["、"],["めとって"],["妻","つま"],["として"],["、"],["兄弟","きょうだい"],["の"],["義務","ぎむ"],["を"],["果たし","はたし"],["、"]]},{"verse":6,"text":"彼女の産んだ長子に死んだ兄弟の名を継がせ、その名がイスラエルの中から絶えないようにしなければならない。","tok":[["彼女","かのじょ"],["の"],["産んだ","うんだ"],["長子","ちょうし"],["に"],["死んだ","しんだ"],["兄弟","きょうだい"],["の"],["名","な"],["を"],["継がせ","つがせ"],["、"],["その"],["名","な"],["が"],["イスラエル"],["の"],["中","なか"],["から"],["絶えない","たえない"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":7,"text":"もし、その人が義理の姉妹をめとろうとしない場合、彼女は町の門に行って長老たちに訴えて、こう言うべきである。「わたしの義理の兄弟は、その兄弟の名をイスラエルの中に残すのを拒んで、わたしのために兄弟の義務を果たそうとしません。」","tok":[["もし"],["、"],["その"],["人","ひと"],["が"],["義理","ぎり"],["の"],["姉妹","しまい"],["を"],["めとろう"],["と"],["しない"],["場合","ばあい"],["、"],["彼女","かのじょ"],["は"],["町","まち"],["の"],["門","もん"],["に"],["行って","いって"],["長老","ちょうろう"],["たち"],["に"],["訴えて","うったえて"],["、"],["こう"],["言うべきで","ゆうべきで"],["ある"],["。"],["「"],["わたし"],["の"],["義理","ぎり"],["の"],["兄弟","きょうだい"],["は"],["、"],["その"],["兄弟","きょうだい"],["の"],["名","な"],["を"],["イスラエル"],["の"],["中","なか"],["に"],["残す","のこす"],["の"],["を"],["拒んで","こばんで"],["、"],["わたし"],["の"],["ため"],["に"],["兄弟","きょうだい"],["の"],["義務","ぎむ"],["を"],["果たそう","はたそう"],["と"],["しません"],["。"],["」"]]},{"verse":8,"text":"町の長老たちは彼を呼び出して、説得しなければならない。もし彼が、「わたしは彼女をめとりたくない」と言い張るならば、","tok":[["町","まち"],["の"],["長老","ちょうろう"],["たち"],["は"],["彼","かれ"],["を"],["呼び出して","よびだして"],["、"],["説得","せっとく"],["しなければ"],["ならない"],["。"],["もし"],["彼","かれ"],["が"],["、"],["「"],["わたし"],["は"],["彼女","かのじょ"],["を"],["めとりたく"],["ない"],["」"],["と"],["言い張るならば","いいはるならば"],["、"]]},{"verse":9,"text":"義理の姉妹は、長老たちの前で彼に近づいて、彼の靴をその足から脱がせ、その顔に唾を吐き、彼に答えて、「自分の兄弟の家を興さない者はこのようにされる」と言うべきである。","tok":[["義理","ぎり"],["の"],["姉妹","しまい"],["は"],["、"],["長老","ちょうろう"],["たち"],["の"],["前","まえ"],["で"],["彼","かれ"],["に"],["近づいて","ちかづいて"],["、"],["彼","かれ"],["の"],["靴","くつ"],["を"],["その"],["足","あし"],["から"],["脱がせ","ぬがせ"],["、"],["その"],["顔","かお"],["に"],["唾","つば"],["を"],["吐き","はき"],["、"],["彼","かれ"],["に"],["答えて","こたえて"],["、"],["「"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["の"],["家","いえ"],["を"],["興さない","おこさない"],["者","もの"],["は"],["この"],["よう"],["に"],["される"],["」"],["と"],["言うべきで","ゆうべきで"],["ある"],["。"]]},{"verse":10,"text":"彼はイスラエルの間で、「靴を脱がされた者の家」と呼ばれるであろう。","tok":[["彼","かれ"],["は"],["イスラエル"],["の"],["間","あいだ"],["で"],["、"],["「"],["靴","くつ"],["を"],["脱がされた","ぬがされた"],["者","もの"],["の"],["家","いえ"],["」"],["と"],["呼ばれるで","よばれるで"],["あろう"],["。"]]},{"verse":11,"text":"二人の男が互いに相争っているとき、一方の妻が近づき、夫が打たれるのを救おうとして、手を伸ばし、相手の急所をつかんだならば、","tok":[["二人","ふたり"],["の"],["男","おとこ"],["が"],["互い","たがい"],["に"],["相","あい"],["争って","あらそって"],["いる"],["とき"],["、"],["一方","いっぽう"],["の"],["妻","つま"],["が"],["近づき","ちかづき"],["、"],["夫","おっと"],["が"],["打たれる","うたれる"],["の"],["を"],["救おう","すくおう"],["として"],["、"],["手","て"],["を"],["伸ばし","のばし"],["、"],["相手","あいて"],["の"],["急所","きゅうしょ"],["を"],["つかんだならば"],["、"]]},{"verse":12,"text":"その手は切り落とされねばならない。憐れみをかけてはならない。","tok":[["その"],["手","て"],["は"],["切り落とされねば","きりおとされねば"],["ならない"],["。"],["憐れみ","あわれみ"],["を"],["かけて"],["は"],["ならない"],["。"]]},{"verse":13,"text":"あなたは袋に大小二つの重りを入れておいてはならない。","tok":[["あなた"],["は"],["袋","ふくろ"],["に"],["大小","だいしょう"],["二","ふた"],["つ"],["の"],["重り","おもり"],["を"],["入れて","いれて"],["おいて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"あなたの家に大小二つの升を置いてはならない。","tok":[["あなた"],["の"],["家","いえ"],["に"],["大小","だいしょう"],["二","ふた"],["つ"],["の"],["升","ます"],["を"],["置いて","おいて"],["は"],["ならない"],["。"]]},{"verse":15,"text":"あなたが全く正確な重りと全く正確な升を使うならば、あなたの神、主が与えられる土地で長く生きることができるが、","tok":[["あなた"],["が"],["全く","まったく"],["正確","せいかく"],["な"],["重り","おもり"],["と"],["全く","まったく"],["正確","せいかく"],["な"],["升","ます"],["を"],["使うならば","つかうならば"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられる","あたえられる"],["土地","とち"],["で"],["長く","ながく"],["生きる","いきる"],["こと"],["が"],["できる"],["が"],["、"]]},{"verse":16,"text":"このようなことをし、不正を行う者をすべて、あなたの神、主はいとわれる。","tok":[["この"],["よう"],["な"],["こと"],["を"],["し"],["、"],["不正","ふせい"],["を"],["行う","おこなう"],["者","もの"],["を"],["すべて"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["いとわれる"],["。"]]},{"verse":17,"text":"あなたたちがエジプトを出たとき、旅路でアマレクがしたことを思い起こしなさい。","tok":[["あなた"],["たち"],["が"],["エジプト"],["を"],["出た","でた"],["とき"],["、"],["旅路","たびじ"],["で"],["アマレク"],["が"],["した"],["こと"],["を"],["思い起こし","おもいおこし"],["なさい"],["。"]]},{"verse":18,"text":"彼は道であなたと出会い、あなたが疲れきっているとき、あなたのしんがりにいた落伍者をすべて攻め滅ぼし、神を畏れることがなかった。","tok":[["彼","かれ"],["は"],["道","みち"],["で"],["あなた"],["と"],["出会い","であい"],["、"],["あなた"],["が"],["疲れ","つかれ"],["きって"],["いる"],["とき"],["、"],["あなた"],["の"],["しんがり"],["に"],["いた"],["落伍者","らくごしゃ"],["を"],["すべて"],["攻め滅ぼし","せめほろぼし"],["、"],["神","かみ"],["を"],["畏れる","おそれる"],["こと"],["が"],["なかった"],["。"]]},{"verse":19,"text":"あなたの神、主があなたに嗣業の土地として得させるために与えられる土地で、あなたの神、主が周囲のすべての敵からあなたを守って安らぎを与えられるとき、忘れずに、アマレクの記憶を天の下からぬぐい去らねばならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["に"],["嗣業","しぎょう"],["の"],["土地","とち"],["として"],["得させる","えさせる"],["ため"],["に"],["与えられる","あたえられる"],["土地","とち"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["周囲","しゅうい"],["の"],["すべて"],["の"],["敵","てき"],["から"],["あなた"],["を"],["守って","まもって"],["安らぎ","やすらぎ"],["を"],["与えられる","あたえられる"],["とき"],["、"],["忘れず","わすれず"],["に"],["、"],["アマレク"],["の"],["記憶","きおく"],["を"],["天","てん"],["の"],["下","した"],["から"],["ぬぐい去らねば","ぬぐいさらねば"],["ならない"],["。"]]}]
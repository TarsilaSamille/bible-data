[{"verse":1,"text":"アビブの月を守り、あなたの神、主の過越祭を祝いなさい。アビブの月のある夜、あなたの神、主があなたをエジプトから導き出されたからである。","tok":[["アビブ"],["の"],["月","つき"],["を"],["守り","まもり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["過越","すぎこし"],["祭","まつり"],["を"],["祝い","いわい"],["なさい"],["。"],["アビブ"],["の"],["月","つき"],["の"],["ある"],["夜","よる"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["を"],["エジプト"],["から"],["導き出された","みちびきだされた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたは、主がその名を置くために選ばれる場所で、羊あるいは牛を過越のいけにえとしてあなたの神、主に屠りなさい。","tok":[["あなた"],["は"],["、"],["主","ぬし"],["が"],["その"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["選ばれる","えらばれる"],["場所","ばしょ"],["で"],["、"],["羊","ひつじ"],["あるいは"],["牛","うし"],["を"],["過越","すぎこし"],["の"],["いけにえ"],["として"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["屠り","ほふり"],["なさい"],["。"]]},{"verse":3,"text":"その際、酵母入りのパンを食べてはならない。七日間、酵母を入れない苦しみのパンを食べなさい。あなたはエジプトの国から急いで出たからである。こうして、あなたはエジプトの国から出た日を生涯思い起こさねばならない。","tok":[["その"],["際","さい"],["、"],["酵母","こうぼ"],["入り","いり"],["の"],["パン"],["を"],["食べて","たべて"],["は"],["ならない"],["。"],["七","なな"],["日間","かかん"],["、"],["酵母","こうぼ"],["を"],["入れない","いれない"],["苦しみ","くるしみ"],["の"],["パン"],["を"],["食べ","たべ"],["なさい"],["。"],["あなた"],["は"],["エジプト"],["の"],["国","くに"],["から"],["急いで","いそいで"],["出た","でた"],["から"],["で"],["ある"],["。"],["こう"],["して"],["、"],["あなた"],["は"],["エジプト"],["の"],["国","くに"],["から"],["出た","でた"],["日","ひ"],["を"],["生涯","しょうがい"],["思い起こさねば","おもいおこさねば"],["ならない"],["。"]]},{"verse":4,"text":"七日間、国中どこにも酵母があってはならない。祭りの初日の夕方屠った肉を、翌朝まで残してはならない。","tok":[["七","なな"],["日間","かかん"],["、"],["国中","くにちゅう"],["どこ"],["に"],["も"],["酵母","こうぼ"],["が"],["あって"],["は"],["ならない"],["。"],["祭り","まつり"],["の"],["初日","しょにち"],["の"],["夕方","ゆうがた"],["屠った","ほふった"],["肉","にく"],["を"],["、"],["翌朝","よくあさ"],["まで"],["残して","のこして"],["は"],["ならない"],["。"]]},{"verse":5,"text":"過越のいけにえを屠ることができるのは、あなたの神、主が与えられる町のうちのどこででもよいのではなく、","tok":[["過越","すぎこし"],["の"],["いけにえ"],["を"],["屠る","ほふる"],["こと"],["が"],["できる"],["の"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられる","あたえられる"],["町","まち"],["の"],["うち"],["の"],["どこ"],["で"],["で"],["も"],["よい"],["ので"],["は"],["なく"],["、"]]},{"verse":6,"text":"ただ、あなたの神、主がその名を置くために選ばれる場所でなければならない。夕方、太陽の沈むころ、あなたがエジプトを出た時刻に過越のいけにえを屠りなさい。","tok":[["ただ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["その"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["選ばれる","えらばれる"],["場所","ばしょ"],["で"],["なければ"],["ならない"],["。"],["夕方","ゆうがた"],["、"],["太陽","たいよう"],["の"],["沈む","しずむ"],["ころ"],["、"],["あなた"],["が"],["エジプト"],["を"],["出た","でた"],["時刻","じこく"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["屠り","ほふり"],["なさい"],["。"]]},{"verse":7,"text":"それをあなたの神、主が選ばれる場所で煮て食べ、翌朝自分の天幕に帰りなさい。","tok":[["それ"],["を"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["選ばれる","えらばれる"],["場所","ばしょ"],["で"],["煮て","にて"],["食べ","たべ"],["、"],["翌朝","よくあさ"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["帰り","かえり"],["なさい"],["。"]]},{"verse":8,"text":"六日間酵母を入れないパンを食べ、七日目にはあなたの神、主のために聖なる集まりを行い、いかなる仕事もしてはならない。","tok":[["六","ろく"],["日間","にちかん"],["酵母","こうぼ"],["を"],["入れない","いれない"],["パン"],["を"],["食べ","たべ"],["、"],["七日目","ななかめ"],["に"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["聖","せい"],["なる"],["集まり","あつまり"],["を"],["行い","おこない"],["、"],["いかなる"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":9,"text":"あなたは七週を数えねばならない。穀物に鎌を入れる時から始めて七週を数える。","tok":[["あなた"],["は"],["七","なな"],["週","しゅう"],["を"],["数えねば","かぞえねば"],["ならない"],["。"],["穀物","こくもつ"],["に"],["鎌","かま"],["を"],["入れる","いれる"],["時","とき"],["から"],["始めて","はじめて"],["七","なな"],["週","しゅう"],["を"],["数える","かぞえる"],["。"]]},{"verse":10,"text":"そして、あなたの神、主のために七週祭を行い、あなたの神、主より受けた祝福に応じて、十分に、あなたがささげうるだけの収穫の献げ物をしなさい。","tok":[["そして"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["七","しち"],["週祭","しゅうさい"],["を"],["行い","おこない"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["より"],["受けた","うけた"],["祝福","しゅくふく"],["に"],["応じて","おうじて"],["、"],["十分","じゅうぶん"],["に"],["、"],["あなた"],["が"],["ささげ"],["うる"],["だけ"],["の"],["収穫","しゅうかく"],["の"],["献げ物","ささげもの"],["を"],["し"],["なさい"],["。"]]},{"verse":11,"text":"こうしてあなたは、あなたの神、主の御前で、すなわちあなたの神、主がその名を置くために選ばれる場所で、息子、娘、男女の奴隷、町にいるレビ人、また、あなたのもとにいる寄留者、孤児、寡婦などと共に喜び祝いなさい。","tok":[["こう"],["して"],["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["、"],["すなわち"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["その"],["名","な"],["を"],["置く","おく"],["ため"],["に"],["選ばれる","えらばれる"],["場所","ばしょ"],["で"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["、"],["町","まち"],["に"],["いる"],["レビ人","れびにん"],["、"],["また"],["、"],["あなた"],["の"],["もと"],["に"],["いる"],["寄留者","きりゅうしゃ"],["、"],["孤児","こじ"],["、"],["寡婦","かふ"],["など"],["と"],["共","とも"],["に"],["喜び祝い","よろこびいわい"],["なさい"],["。"]]},{"verse":12,"text":"あなたがエジプトで奴隷であったことを思い起こし、これらの掟を忠実に守りなさい。","tok":[["あなた"],["が"],["エジプト"],["で"],["奴隷","どれい"],["で"],["あった"],["こと"],["を"],["思い起こし","おもいおこし"],["、"],["これ"],["ら"],["の"],["掟","おきて"],["を"],["忠実","ちゅうじつ"],["に"],["守り","まもり"],["なさい"],["。"]]},{"verse":13,"text":"麦打ち場と酒ぶねからの収穫が済んだとき、あなたは七日間、仮庵祭を行いなさい。","tok":[["麦打ち","むぎうち"],["場","ば"],["と"],["酒","さけ"],["ぶね"],["から"],["の"],["収穫","しゅうかく"],["が"],["済んだ","すんだ"],["とき"],["、"],["あなた"],["は"],["七","なな"],["日間","かかん"],["、"],["仮庵祭","かりあんさい"],["を"],["行い","おこない"],["なさい"],["。"]]},{"verse":14,"text":"息子、娘、男女の奴隷、あなたの町にいるレビ人、寄留者、孤児、寡婦などと共にこの祭りを喜び祝いなさい。","tok":[["息子","むすこ"],["、"],["娘","むすめ"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["、"],["あなた"],["の"],["町","まち"],["に"],["いる"],["レビ人","れびにん"],["、"],["寄留者","きりゅうしゃ"],["、"],["孤児","こじ"],["、"],["寡婦","かふ"],["など"],["と"],["共","とも"],["に"],["この"],["祭り","まつり"],["を"],["喜び祝い","よろこびいわい"],["なさい"],["。"]]},{"verse":15,"text":"七日間、主の選ばれる場所であなたの神、主のために祭りを行いなさい。あなたの神、主があなたの収穫と手の業をすべて祝福される。あなたはただそれを喜び祝うのである。","tok":[["七","なな"],["日間","かかん"],["、"],["主","ぬし"],["の"],["選ばれる","えらばれる"],["場所","ばしょ"],["で"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["祭り","まつり"],["を"],["行い","おこない"],["なさい"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["の"],["収穫","しゅうかく"],["と"],["手","て"],["の"],["業","ごう"],["を"],["すべて"],["祝福","しゅくふく"],["される"],["。"],["あなた"],["は"],["ただ"],["それ"],["を"],["喜び祝う","よろこびいわう"],["ので"],["ある"],["。"]]},{"verse":16,"text":"男子はすべて、年に三度、すなわち除酵祭、七週祭、仮庵祭に、あなたの神、主の御前、主の選ばれる場所に出ねばならない。ただし、何も持たずに主の御前に出てはならない。","tok":[["男子","だんし"],["は"],["すべて"],["、"],["年","ねん"],["に"],["三","さん"],["度","ど"],["、"],["すなわち"],["除","じょ"],["酵祭"],["、"],["七","なな"],["週祭","しゅうさい"],["、"],["仮庵祭","かりあんさい"],["に"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["、"],["主","ぬし"],["の"],["選ばれる","えらばれる"],["場所","ばしょ"],["に"],["出ねば","でねば"],["ならない"],["。"],["ただし"],["、"],["何","なん"],["も"],["持たず","もたず"],["に"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["出て","でて"],["は"],["ならない"],["。"]]},{"verse":17,"text":"あなたの神、主より受けた祝福に応じて、それぞれ、献げ物を携えなさい。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["より"],["受けた","うけた"],["祝福","しゅくふく"],["に"],["応じて","おうじて"],["、"],["それぞれ"],["、"],["献げ物","ささげもの"],["を"],["携え","たずさえ"],["なさい"],["。"]]},{"verse":18,"text":"あなたの神、主が部族ごとに与えられるすべての町に、裁判人と役人を置き、正しい裁きをもって民を裁かせなさい。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["部族","ぶぞく"],["ごと"],["に"],["与えられる","あたえられる"],["すべて"],["の"],["町","まち"],["に"],["、"],["裁判人","さいばんにん"],["と"],["役人","やくにん"],["を"],["置き","おき"],["、"],["正しい","ただしい"],["裁き","さばき"],["を"],["もって"],["民","みん"],["を"],["裁かせ","さばかせ"],["なさい"],["。"]]},{"verse":19,"text":"裁きを曲げず、偏り見ず、賄賂を受け取ってはならない。賄賂は賢い者の目をくらませ、正しい者の言い分をゆがめるからである。","tok":[["裁き","さばき"],["を"],["曲げず","まげず"],["、"],["偏り","かたより"],["見ず","みず"],["、"],["賄賂","わいろ"],["を"],["受け取って","うけとって"],["は"],["ならない"],["。"],["賄賂","わいろ"],["は"],["賢い","かしこい"],["者","もの"],["の"],["目","め"],["を"],["くらませ"],["、"],["正しい","ただしい"],["者","もの"],["の"],["言い分","いいぶん"],["を"],["ゆがめる"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"ただ正しいことのみを追求しなさい。そうすれば命を得、あなたの神、主が与えられる土地を得ることができる。","tok":[["ただ"],["正しい","ただしい"],["こと"],["のみ"],["を"],["追求","ついきゅう"],["し"],["なさい"],["。"],["そう"],["すれば"],["命","いのち"],["を"],["得","え"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられる","あたえられる"],["土地","とち"],["を"],["得る","える"],["こと"],["が"],["できる"],["。"]]},{"verse":21,"text":"あなたは、あなたの神、主の祭壇を築いて、そのそばに、アシェラ像をはじめいかなる木の柱も据えてはならない。","tok":[["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["その"],["そば"],["に"],["、"],["アシェラ"],["像","ぞう"],["を"],["はじめ"],["いかなる"],["木","き"],["の"],["柱","はしら"],["も"],["据えて","すえて"],["は"],["ならない"],["。"]]},{"verse":22,"text":"また、あなたの神、主が憎まれる石柱を立ててはならない。","tok":[["また"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["憎まれる","にくまれる"],["石柱","せきちゅう"],["を"],["立てて","たてて"],["は"],["ならない"],["。"]]}]
[{"verse":1,"text":"人が妻をめとり、その夫となってから、妻に何か恥ずべきことを見いだし、気に入らなくなったときは、離縁状を書いて彼女の手に渡し、家を去らせる。","tok":[["人","ひと"],["が"],["妻","つま"],["を"],["めとり"],["、"],["その"],["夫","おっと"],["と"],["なって"],["から"],["、"],["妻","つま"],["に"],["何","なん"],["か"],["恥ずべき","はずべき"],["こと"],["を"],["見いだし","みいだし"],["、"],["気","き"],["に"],["入らなく","いらなく"],["なった"],["とき"],["は"],["、"],["離縁状","りえんじょう"],["を"],["書いて","かいて"],["彼女","かのじょ"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["家","いえ"],["を"],["去らせる","さらせる"],["。"]]},{"verse":2,"text":"その女が家を出て行き、別の人の妻となり、","tok":[["その"],["女","おんな"],["が"],["家","いえ"],["を"],["出て","でて"],["行き","いき"],["、"],["別","べつ"],["の"],["人","ひと"],["の"],["妻","つま"],["と"],["なり"],["、"]]},{"verse":3,"text":"次の夫も彼女を嫌って離縁状を書き、それを手に渡して家を去らせるか、あるいは彼女をめとって妻とした次の夫が死んだならば、","tok":[["次","つぎ"],["の"],["夫","おっと"],["も"],["彼女","かのじょ"],["を"],["嫌って","きらって"],["離縁状","りえんじょう"],["を"],["書き","かき"],["、"],["それ"],["を"],["手","て"],["に"],["渡して","わたして"],["家","いえ"],["を"],["去らせる","さらせる"],["か"],["、"],["あるいは"],["彼女","かのじょ"],["を"],["めとって"],["妻","つま"],["と"],["した"],["次","つぎ"],["の"],["夫","おっと"],["が"],["死んだならば","しんだならば"],["、"]]},{"verse":4,"text":"彼女は汚されているのだから、彼女を去らせた最初の夫は、彼女を再び妻にすることはできない。これは主の御前にいとうべきことである。あなたの神、主が嗣業として与えられる土地を罪で汚してはならない。","tok":[["彼女","かのじょ"],["は"],["汚されて","よごされて"],["いる"],["の"],["だ"],["から"],["、"],["彼女","かのじょ"],["を"],["去らせた","さらせた"],["最初","さいしょ"],["の"],["夫","おっと"],["は"],["、"],["彼女","かのじょ"],["を"],["再び","ふたたび"],["妻","つま"],["に"],["する"],["こと"],["は"],["できない"],["。"],["これ"],["は"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["いとうべき"],["こと"],["で"],["ある"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["嗣業","しぎょう"],["として"],["与えられる","あたえられる"],["土地","とち"],["を"],["罪","つみ"],["で"],["汚して","よごして"],["は"],["ならない"],["。"]]},{"verse":5,"text":"人が新妻をめとったならば、兵役に服さず、いかなる公務も課せられず、一年間は自分の家のためにすべてを免除される。彼は、めとった妻を喜ばせねばならない。","tok":[["人","ひと"],["が"],["新妻","にいづま"],["を"],["めとったならば"],["、"],["兵役","へいえき"],["に"],["服さず","ふくさず"],["、"],["いかなる"],["公務","こうむ"],["も"],["課せられず","かせられず"],["、"],["一","いち"],["年間","ねんかん"],["は"],["自分","じぶん"],["の"],["家","いえ"],["の"],["ため"],["に"],["すべて"],["を"],["免除","めんじょ"],["される"],["。"],["彼","かれ"],["は"],["、"],["めとった"],["妻","つま"],["を"],["喜ばせねば","よろこばせねば"],["ならない"],["。"]]},{"verse":6,"text":"挽き臼あるいはその上石を質に取ってはならない。命そのものを質に取ることになるからである。","tok":[["挽き臼","ひきうす"],["あるいは"],["その"],["上","うえ"],["石","いし"],["を"],["質","しつ"],["に"],["取って","とって"],["は"],["ならない"],["。"],["命","いのち"],["その"],["もの"],["を"],["質","しつ"],["に"],["取る","とる"],["こと"],["に"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"同胞であるイスラエルの人々の一人を誘拐して、これを奴隷のように扱うか、人に売るのを見つけたならば、誘拐したその者を殺し、あなたの中から悪を取り除かねばならない。","tok":[["同胞","どうほう"],["で"],["ある"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["一人","ひとり"],["を"],["誘拐","ゆうかい"],["して"],["、"],["これ"],["を"],["奴隷","どれい"],["の"],["よう"],["に"],["扱う","あつかう"],["か"],["、"],["人","ひと"],["に"],["売る","うる"],["の"],["を"],["見つけたならば","みつけたならば"],["、"],["誘拐","ゆうかい"],["した"],["その"],["者","もの"],["を"],["殺し","ころし"],["、"],["あなた"],["の"],["中","なか"],["から"],["悪","あく"],["を"],["取り除かねば","とりのぞかねば"],["ならない"],["。"]]},{"verse":8,"text":"重い皮膚病については、細心の注意を払い、すべてレビ人である祭司が指示するとおりに行いなさい。わたしが彼らに命じたとおり忠実に守りなさい。","tok":[["重い","おもい"],["皮膚病","ひふびょう"],["について"],["は"],["、"],["細心","さいしん"],["の"],["注意","ちゅうい"],["を"],["払い","はらい"],["、"],["すべて"],["レビ人","れびにん"],["で"],["ある"],["祭司","さいし"],["が"],["指示","しじ"],["する"],["とおり"],["に"],["行い","おこない"],["なさい"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["とおり"],["忠実","ちゅうじつ"],["に"],["守り","まもり"],["なさい"],["。"]]},{"verse":9,"text":"エジプトから出た後の旅路で、あなたの神、主がミリアムになさったことを思い起こしなさい。","tok":[["エジプト"],["から"],["出た","でた"],["後","あと"],["の"],["旅路","たびじ"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["ミリアム"],["に"],["なさった"],["こと"],["を"],["思い起こし","おもいおこし"],["なさい"],["。"]]},{"verse":10,"text":"あなたが隣人に何らかの貸し付けをするときは、担保を取るために、その家に入ってはならない。","tok":[["あなた"],["が"],["隣人","りんじん"],["に"],["何","なん"],["ら"],["か"],["の"],["貸し付け","かしつけ"],["を"],["する"],["とき"],["は"],["、"],["担保","たんぽ"],["を"],["取る","とる"],["ため"],["に"],["、"],["その"],["家","いえ"],["に"],["入って","はいって"],["は"],["ならない"],["。"]]},{"verse":11,"text":"外にいて、あなたが貸す相手の人があなたのところに担保を持って出て来るのを待ちなさい。","tok":[["外","そと"],["に"],["いて"],["、"],["あなた"],["が"],["貸す","かす"],["相手","あいて"],["の"],["人","ひと"],["が"],["あなた"],["の"],["ところ"],["に"],["担保","たんぽ"],["を"],["持って","もって"],["出て","でて"],["来る","くる"],["の"],["を"],["待ち","まち"],["なさい"],["。"]]},{"verse":12,"text":"もし、その人が貧しい場合には、その担保を取ったまま床に就いてはならない。","tok":[["もし"],["、"],["その"],["人","ひと"],["が"],["貧しい","まずしい"],["場合","ばあい"],["に"],["は"],["、"],["その"],["担保","たんぽ"],["を"],["取った","とった"],["まま"],["床","ゆか"],["に"],["就いて","ついて"],["は"],["ならない"],["。"]]},{"verse":13,"text":"日没には必ず担保を返しなさい。そうすれば、その人は自分の上着を掛けて寝ることができ、あなたを祝福するであろう。あなたはあなたの神、主の御前に報いを受けるであろう。","tok":[["日没","にちぼつ"],["に"],["は"],["必ず","かならず"],["担保","たんぽ"],["を"],["返し","かえし"],["なさい"],["。"],["そう"],["すれば"],["、"],["その"],["人","ひと"],["は"],["自分","じぶん"],["の"],["上着","うわぎ"],["を"],["掛けて","かけて"],["寝る","ねる"],["こと"],["が"],["でき"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["するで"],["あろう"],["。"],["あなた"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["報い","むくい"],["を"],["受けるで","うけるで"],["あろう"],["。"]]},{"verse":14,"text":"同胞であれ、あなたの国であなたの町に寄留している者であれ、貧しく乏しい雇い人を搾取してはならない。","tok":[["同胞","どうほう"],["で"],["あれ"],["、"],["あなた"],["の"],["国","くに"],["で"],["あなた"],["の"],["町","まち"],["に"],["寄留","きりゅう"],["して"],["いる"],["者","もの"],["で"],["あれ"],["、"],["貧しく","まずしく"],["乏しい","とぼしい"],["雇い人","やといにん"],["を"],["搾取","さくしゅ"],["して"],["は"],["ならない"],["。"]]},{"verse":15,"text":"賃金はその日のうちに、日没前に支払わねばならない。彼は貧しく、その賃金を当てにしているからである。彼があなたを主に訴えて、罪を負うことがないようにしなさい。","tok":[["賃金","ちんぎん"],["は"],["その"],["日","ひ"],["の"],["うち"],["に"],["、"],["日没","にちぼつ"],["前","まえ"],["に"],["支払わねば","しはらわねば"],["ならない"],["。"],["彼","かれ"],["は"],["貧しく","まずしく"],["、"],["その"],["賃金","ちんぎん"],["を"],["当て","あて"],["に"],["して"],["いる"],["から"],["で"],["ある"],["。"],["彼","かれ"],["が"],["あなた"],["を"],["主に","おもに"],["訴えて","うったえて"],["、"],["罪","つみ"],["を"],["負う","おう"],["こと"],["が"],["ない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":16,"text":"父は子のゆえに死に定められず、子は父のゆえに死に定められない。人は、それぞれ自分の罪のゆえに死に定められる。","tok":[["父","ちち"],["は"],["子","こ"],["の"],["ゆえ"],["に"],["死に","しに"],["定められず","さだめられず"],["、"],["子","こ"],["は"],["父","ちち"],["の"],["ゆえ"],["に"],["死に","しに"],["定められない","さだめられない"],["。"],["人","ひと"],["は"],["、"],["それぞれ"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死に","しに"],["定められる","さだめられる"],["。"]]},{"verse":17,"text":"寄留者や孤児の権利をゆがめてはならない。寡婦の着物を質に取ってはならない。","tok":[["寄留者","きりゅうしゃ"],["や"],["孤児","こじ"],["の"],["権利","けんり"],["を"],["ゆがめて"],["は"],["ならない"],["。"],["寡婦","かふ"],["の"],["着物","きもの"],["を"],["質","しつ"],["に"],["取って","とって"],["は"],["ならない"],["。"]]},{"verse":18,"text":"あなたはエジプトで奴隷であったが、あなたの神、主が救い出してくださったことを思い起こしなさい。わたしはそれゆえ、あなたにこのことを行うように命じるのである。","tok":[["あなた"],["は"],["エジプト"],["で"],["奴隷","どれい"],["で"],["あった"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["救い出して","すくいだして"],["くださった"],["こと"],["を"],["思い起こし","おもいおこし"],["なさい"],["。"],["わたし"],["は"],["それ"],["ゆえ"],["、"],["あなた"],["に"],["この"],["こと"],["を"],["行う","おこなう"],["よう"],["に"],["命じる","めいじる"],["ので"],["ある"],["。"]]},{"verse":19,"text":"畑で穀物を刈り入れるとき、一束畑に忘れても、取りに戻ってはならない。それは寄留者、孤児、寡婦のものとしなさい。こうしてあなたの手の業すべてについて、あなたの神、主はあなたを祝福される。","tok":[["畑","はたけ"],["で"],["穀物","こくもつ"],["を"],["刈り入れる","かりいれる"],["とき"],["、"],["一","いち"],["束","たば"],["畑","はたけ"],["に"],["忘れて","わすれて"],["も"],["、"],["取り","とり"],["に"],["戻って","もどって"],["は"],["ならない"],["。"],["それ"],["は"],["寄留者","きりゅうしゃ"],["、"],["孤児","こじ"],["、"],["寡婦","かふ"],["の"],["もの"],["と"],["し"],["なさい"],["。"],["こう"],["して"],["あなた"],["の"],["手","て"],["の"],["業","ごう"],["すべて"],["について"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["。"]]},{"verse":20,"text":"オリーブの実を打ち落とすときは、後で枝をくまなく捜してはならない。それは寄留者、孤児、寡婦のものとしなさい。","tok":[["オリーブ"],["の"],["実","じつ"],["を"],["打ち落とす","うちおとす"],["とき"],["は"],["、"],["後","あと"],["で"],["枝","えだ"],["を"],["くまなく"],["捜して","さがして"],["は"],["ならない"],["。"],["それ"],["は"],["寄留者","きりゅうしゃ"],["、"],["孤児","こじ"],["、"],["寡婦","かふ"],["の"],["もの"],["と"],["し"],["なさい"],["。"]]},{"verse":21,"text":"ぶどうの取り入れをするときは、後で摘み尽くしてはならない。それは寄留者、孤児、寡婦のものとしなさい。","tok":[["ぶどう"],["の"],["取り入れ","とりいれ"],["を"],["する"],["とき"],["は"],["、"],["後","あと"],["で"],["摘み","つみ"],["尽くして","つくして"],["は"],["ならない"],["。"],["それ"],["は"],["寄留
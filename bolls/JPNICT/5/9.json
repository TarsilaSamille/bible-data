[{"verse":1,"text":"聞け、イスラエルよ。あなたは今日、ヨルダン川を渡り、行ってあなたよりも大きく強い国々を追い払おうとしている。町々は大きく、城壁は天に達し、","tok":[["聞け","きけ"],["、"],["イスラエル"],["よ"],["。"],["あなた"],["は"],["今日","きょう"],["、"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["、"],["行って","いって"],["あなた"],["より"],["も"],["大きく","おおきく"],["強い","つよい"],["国々","くにぐに"],["を"],["追い払おう","おいはらおう"],["として"],["いる"],["。"],["町々","まちまち"],["は"],["大きく","おおきく"],["、"],["城壁","じょうへき"],["は"],["天","てん"],["に"],["達し","たっし"],["、"]]},{"verse":2,"text":"民は、あなたの知っているアナクの子孫で、大きくて背が高い。あなたは、「誰がアナクの子孫に立ち向かいえようか」というのを聞いたことがあろう。","tok":[["民","みん"],["は"],["、"],["あなた"],["の"],["知って","しって"],["いる"],["アナク"],["の"],["子孫","しそん"],["で"],["、"],["大きくて","おおきくて"],["背","せ"],["が"],["高い","たかい"],["。"],["あなた"],["は"],["、"],["「"],["誰","だれ"],["が"],["アナク"],["の"],["子孫","しそん"],["に"],["立ち向かい","たちむかい"],["えよう"],["か"],["」"],["と"],["いう"],["の"],["を"],["聞いた","きいた"],["こと"],["が"],["あろう"],["。"]]},{"verse":3,"text":"しかし、今日、あなたの神、主は焼き尽くす火となり、あなたに先立って渡り、彼らを滅ぼしてあなたの前に屈服させられることを知り、主が言われたとおり、彼らを追い払い、速やかに滅ぼしなさい。","tok":[["しかし"],["、"],["今日","きょう"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["焼き","やき"],["尽くす","つくす"],["火","ひ"],["と"],["なり"],["、"],["あなた"],["に"],["先立って","さきだって"],["渡り","わたり"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼして","ほろぼして"],["あなた"],["の"],["前","まえ"],["に"],["屈服","くっぷく"],["させられる"],["こと"],["を"],["知り","しり"],["、"],["主","ぬし"],["が"],["言われた","いわれた"],["とおり"],["、"],["彼","かれ"],["ら"],["を"],["追い払い","おいはらい"],["、"],["速やか","すみやか"],["に"],["滅ぼし","ほろぼし"],["なさい"],["。"]]},{"verse":4,"text":"あなたの神、主があなたの前から彼らを追い出されるとき、あなたは、「わたしが正しいので、主はわたしを導いてこの土地を得させてくださった」と思ってはならない。この国々の民が神に逆らうから、主があなたの前から彼らを追い払われるのである。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い出される","おいだされる"],["とき"],["、"],["あなた"],["は"],["、"],["「"],["わたし"],["が"],["正しい","ただしい"],["ので"],["、"],["主","ぬし"],["は"],["わたし"],["を"],["導いて","みちびいて"],["この"],["土地","とち"],["を"],["得させて","えさせて"],["くださった"],["」"],["と"],["思って","おもって"],["は"],["ならない"],["。"],["この"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["神","かみ"],["に"],["逆らう","さからう"],["から"],["、"],["主","ぬし"],["が"],["あなた"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い払われる","おいはらわれる"],["ので"],["ある"],["。"]]},{"verse":5,"text":"あなたが正しく、心がまっすぐであるから、行って、彼らの土地を得るのではなく、この国々の民が神に逆らうから、あなたの神、主が彼らを追い払われる。またこうして、主はあなたの先祖、アブラハム、イサク、ヤコブに誓われたことを果たされるのである。","tok":[["あなた"],["が"],["正しく","ただしく"],["、"],["心","こころ"],["が"],["まっすぐ"],["で"],["ある"],["から"],["、"],["行って","いって"],["、"],["彼","かれ"],["ら"],["の"],["土地","とち"],["を"],["得る","える"],["ので"],["は"],["なく"],["、"],["この"],["国々","くにぐに"],["の"],["民","たみ"],["が"],["神","かみ"],["に"],["逆らう","さからう"],["から"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["追い払われる","おいはらわれる"],["。"],["また"],["こう"],["して"],["、"],["主","ぬし"],["は"],["あなた"],["の"],["先祖","せんぞ"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓われた","ちかわれた"],["こと"],["を"],["果たされる","はたされる"],["ので"],["ある"],["。"]]},{"verse":6,"text":"あなたが正しいので、あなたの神、主がこの良い土地を与え、それを得させてくださるのではないことをわきまえなさい。あなたはかたくなな民である。","tok":[["あなた"],["が"],["正しい","ただしい"],["ので"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["この"],["良い","よい"],["土地","とち"],["を"],["与え","あたえ"],["、"],["それ"],["を"],["得させて","えさせて"],["くださる"],["ので"],["は"],["ない"],["こと"],["を"],["わきまえ"],["なさい"],["。"],["あなた"],["は"],["かたくな"],["な"],["民","たみ"],["で"],["ある"],["。"]]},{"verse":7,"text":"あなたは荒れ野で、あなたの神、主を怒らせたことを思い起こし、忘れてはならない。あなたたちは、エジプトの国を出た日からここに来るまで主に背き続けてきた。","tok":[["あなた"],["は"],["荒れ野","あれの"],["で"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["怒らせた","おこらせた"],["こと"],["を"],["思い起こし","おもいおこし"],["、"],["忘れて","わすれて"],["は"],["ならない"],["。"],["あなた"],["たち"],["は"],["、"],["エジプト"],["の"],["国","くに"],["を"],["出た","でた"],["日","ひ"],["から"],["ここ"],["に"],["来る","くる"],["まで"],["主","ぬし"],["に"],["背き","そむき"],["続けて","つづけて"],["きた"],["。"]]},{"verse":8,"text":"ホレブにいたとき、あなたたちが主を怒らせたので、主はあなたたちに向かって激しく憤り、滅ぼそうとされた。","tok":[["ホレブ"],["に"],["いた"],["とき"],["、"],["あなた"],["たち"],["が"],["主","ぬし"],["を"],["怒らせた","おこらせた"],["ので"],["、"],["主","ぬし"],["は"],["あなた"],["たち"],["に"],["向かって","むかって"],["激しく","はげしく"],["憤り","いきどおり"],["、"],["滅ぼそう","ほろぼそう"],["と"],["された"],["。"]]},{"verse":9,"text":"わたしが石の板、すなわち主があなたたちと結ばれた契約の板を受け取るため山に登ったとき、わたしは四十日四十夜、山にとどまり、パンも食べず水も飲まなかった。","tok":[["わたし"],["が"],["石","いし"],["の"],["板","いた"],["、"],["すなわち"],["主","ぬし"],["が"],["あなた"],["たち"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["の"],["板","いた"],["を"],["受け取る","うけとる"],["ため"],["山","やま"],["に"],["登った","のぼった"],["とき"],["、"],["わたし"],["は"],["四十日","よんとうか"],["四十","よんじゅう"],["夜","よる"],["、"],["山","やま"],["に"],["とどまり"],["、"],["パン"],["も"],["食べず","たべず"],["水","みず"],["も"],["飲まなかった","のまなかった"],["。"]]},{"verse":10,"text":"主は、神の指で記された二枚の石の板をわたしにお授けになった。その上には、集会の日に、主が山で火の中からあなたたちに告げられた言葉がすべてそのとおりに記されていた。","tok":[["主","ぬし"],["は"],["、"],["神","かみ"],["の"],["指","ゆび"],["で"],["記された","しるされた"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["を"],["わたし"],["に"],["お授け","おさずけ"],["に"],["なった"],["。"],["その"],["上","うえ"],["に"],["は"],["、"],["集会","しゅうかい"],["の"],["日","ひ"],["に"],["、"],["主","ぬし"],["が"],["山","やま"],["で"],["火","ひ"],["の"],["中","なか"],["から"],["あなた"],["たち"],["に"],["告げられた","つげられた"],["言葉","ことば"],["が"],["すべて"],["その"],["とおり"],["に"],["記されて","しるされて"],["いた"],["。"]]},{"verse":11,"text":"四十日四十夜が過ぎて、主はわたしにその二枚の石の板、契約の板を授けられた。","tok":[["四十日","よんとうか"],["四十夜","よんじゅうや"],["が"],["過ぎて","すぎて"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["その"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["、"],["契約","けいやく"],["の"],["板","いた"],["を"],["授けられた","さずけられた"],["。"]]},{"verse":12,"text":"そのとき、主はわたしに言われた。「すぐに立って、ここから下りなさい。あなたがエジプトから導き出した民は堕落し、早くもわたしが命じた道からそれて、鋳像を造った。」","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["すぐ"],["に"],["立って","たって"],["、"],["ここ"],["から"],["下り","おり"],["なさい"],["。"],["あなた"],["が"],["エジプト"],["から"],["導き出した","みちびきだした"],["民","たみ"],["は"],["堕落","だらく"],["し"],["、"],["早く","はやく"],["も"],["わたし"],["が"],["命じた","めいじた"],["道","みち"],["から"],["それ"],["て"],["、"],["鋳像","ちゅうぞう"],["を"],["造った","つくった"],["。"],["」"]]},{"verse":13,"text":"主は更に、わたしに言われた。「わたしはこの民を見てきたが、実にかたくなな民である。","tok":[["主","ぬし"],["は"],["更に","さらに"],["、"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["この"],["民
[{"verse":1,"text":"モーセは全イスラエルの前に歩み出て、これらの言葉を告げた後、","tok":[["モーセ"],["は"],["全","ぜん"],["イスラエル"],["の"],["前","まえ"],["に"],["歩み出て","あゆみでて"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["告げた","つげた"],["後","あと"],["、"]]},{"verse":2,"text":"こう言った。「わたしは今日、既に百二十歳であり、もはや自分の務めを果たすことはできない。主はわたしに対して、『あなたはこのヨルダン川を渡ることができない』と言われた。","tok":[["こう"],["言った","いった"],["。"],["「"],["わたし"],["は"],["今日","きょう"],["、"],["既に","すでに"],["百二十歳","ひゃくにじゅうさい"],["で"],["あり"],["、"],["もはや"],["自分","じぶん"],["の"],["務め","つとめ"],["を"],["果たす","はたす"],["こと"],["は"],["できない"],["。"],["主","ぬし"],["は"],["わたし"],["に対して","にたいして"],["、"],["『"],["あなた"],["は"],["この"],["ヨルダン"],["川","かわ"],["を"],["渡る","わたる"],["こと"],["が"],["できない"],["』"],["と"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"あなたの神、主御自身があなたに先立って渡り、あなたの前からこれらの国々を滅ぼして、それを得させてくださる。主が約束されたとおり、ヨシュアがあなたに先立って渡る。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","しゅ"],["御自身","ごじしん"],["が"],["あなた"],["に"],["先立って","さきだって"],["渡り","わたり"],["、"],["あなた"],["の"],["前","まえ"],["から"],["これ"],["ら"],["の"],["国々","くにぐに"],["を"],["滅ぼして","ほろぼして"],["、"],["それ"],["を"],["得させて","えさせて"],["くださる"],["。"],["主","ぬし"],["が"],["約束","やくそく"],["された"],["とおり"],["、"],["ヨシュア"],["が"],["あなた"],["に"],["先立って","さきだって"],["渡る","わたる"],["。"]]},{"verse":4,"text":"主は、アモリ人の王であるシホンとオグおよび彼らの国にされたように、彼らを滅ぼされる。","tok":[["主","ぬし"],["は"],["、"],["アモリ人","あもりにん"],["の"],["王","おう"],["で"],["ある"],["シホン"],["と"],["オグ"],["および"],["彼","かれ"],["ら"],["の"],["国","くに"],["に"],["された"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":5,"text":"主が彼らをあなたたちに引き渡されるから、わたしが命じたすべての戒めに従って彼らに行いなさい。","tok":[["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["あなた"],["たち"],["に"],["引き渡される","ひきわたされる"],["から"],["、"],["わたし"],["が"],["命じた","めいじた"],["すべて"],["の"],["戒め","いましめ"],["に"],["従って","したがって"],["彼","かれ"],["ら"],["に"],["行い","おこない"],["なさい"],["。"]]},{"verse":6,"text":"強く、また雄々しくあれ。恐れてはならない。彼らのゆえにうろたえてはならない。あなたの神、主は、あなたと共に歩まれる。あなたを見放すことも、見捨てられることもない。」","tok":[["強く","つよく"],["、"],["また"],["雄々しく","おおしく"],["あれ"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["ゆえ"],["に"],["うろたえて"],["は"],["ならない"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["と"],["共","とも"],["に"],["歩まれる","あゆまれる"],["。"],["あなた"],["を"],["見放す","みはなす"],["こと"],["も"],["、"],["見捨てられる","みすてられる"],["こと"],["も"],["ない"],["。"],["」"]]},{"verse":7,"text":"モーセはそれからヨシュアを呼び寄せ、全イスラエルの前で彼に言った。「強く、また雄々しくあれ。あなたこそ、主が先祖たちに与えると誓われた土地にこの民を導き入れる者である。あなたが彼らにそれを受け継がせる。","tok":[["モーセ"],["は"],["それ"],["から"],["ヨシュア"],["を"],["呼び寄せ","よびよせ"],["、"],["全","ぜん"],["イスラエル"],["の"],["前","まえ"],["で"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["強く","つよく"],["、"],["また"],["雄々しく","おおしく"],["あれ"],["。"],["あなた"],["こそ"],["、"],["主","ぬし"],["が"],["先祖","せんぞ"],["たち"],["に"],["与える","あたえる"],["と"],["誓われた","ちかわれた"],["土地","とち"],["に"],["この"],["民","たみ"],["を"],["導き入れる","みちびきいれる"],["者","もの"],["で"],["ある"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["それ"],["を"],["受け継がせる","うけつがせる"],["。"]]},{"verse":8,"text":"主御自身があなたに先立って行き、主御自身があなたと共におられる。主はあなたを見放すことも、見捨てられることもない。恐れてはならない。おののいてはならない。」","tok":[["主","しゅ"],["御自身","ごじしん"],["が"],["あなた"],["に"],["先立って","さきだって"],["行き","いき"],["、"],["主","しゅ"],["御自身","ごじしん"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられる"],["。"],["主","ぬし"],["は"],["あなた"],["を"],["見放す","みはなす"],["こと"],["も"],["、"],["見捨てられる","みすてられる"],["こと"],["も"],["ない"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おののいて"],["は"],["ならない"],["。"],["」"]]},{"verse":9,"text":"モーセはこの律法を書き記すと、それを主の契約の箱を担ぐレビ人である祭司およびイスラエルの全長老に与えた。","tok":[["モーセ"],["は"],["この"],["律法","りっぽう"],["を"],["書き記す","かきしるす"],["と"],["、"],["それ"],["を"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担ぐ","かつぐ"],["レビ人","れびにん"],["で"],["ある"],["祭司","さいし"],["および"],["イスラエル"],["の"],["全","ぜん"],["長老","ちょうろう"],["に"],["与えた","あたえた"],["。"]]},{"verse":10,"text":"モーセは彼らに命じて言った。「七年目の終わり、つまり負債免除の年の定めの時、仮庵祭に、","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["命じて","めいじて"],["言った","いった"],["。"],["「"],["七","なな"],["年目","ねんめ"],["の"],["終わり","おわり"],["、"],["つまり"],["負債","ふさい"],["免除","めんじょ"],["の"],["年","とし"],["の"],["定め","さだめ"],["の"],["時","とき"],["、"],["仮庵祭","かりあんさい"],["に"],["、"]]},{"verse":11,"text":"主の選ばれる場所にあなたの神、主の御顔を拝するために全イスラエルが集まるとき、あなたはこの律法を全イスラエルの前で読み聞かせねばならない。","tok":[["主","ぬし"],["の"],["選ばれる","えらばれる"],["場所","ばしょ"],["に"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御顔","おかお"],["を"],["拝する","はいする"],["ため"],["に"],["全","ぜん"],["イスラエル"],["が"],["集まる","あつまる"],["とき"],["、"],["あなた"],["は"],["この"],["律法","りっぽう"],["を"],["全","ぜん"],["イスラエル"],["の"],["前","まえ"],["で"],["読み聞かせねば","よみきかせねば"],["ならない"],["。"]]},{"verse":12,"text":"民を、男も女も子供も、町のうちに寄留する者も集めなさい。彼らが聞いて学び、あなたたちの神、主を畏れ、この律法の言葉をすべて忠実に守るためであり、","tok":[["民","みん"],["を"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["子供","こども"],["も"],["、"],["町","まち"],["の"],["うち"],["に"],["寄留","きりゅう"],["する"],["者","もの"],["も"],["集め","あつめ"],["なさい"],["。"],["彼","かれ"],["ら"],["が"],["聞いて","きいて"],["学び","まなび"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["畏れ","おそれ"],["、"],["この"],["律法","りっぽう"],["の"],["言葉","ことば"],["を"],["すべて"],["忠実","ちゅうじつ"],["に"],["守る","まもる"],["ため"],["で"],["あり"],["、"]]},{"verse":13,"text":"これをまだ知らない彼らの子供たちも聞いて学び、あなたたちがヨルダン川を渡り、入って行って得る土地で、彼らも生きている限り、あなたたちの神、主を畏れるようになるためである。」","tok":[["これ"],["を"],["まだ"],["知らない","しらない"],["彼","かれ"],["ら"],["の"],["子供","こども"],["たち"],["も"],["聞いて","きいて"],["学び","まなび"],["、"],["あなた"],["たち"],["が"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["、"],["入って","はいって"],["行って","いって"],["得る","える"],["土地","とち"],["で"],["、"],["彼","かれ"],["ら"],["も"],["生きて","いきて"],["いる"],["限り","かぎり"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["畏れる","おそれる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":14,"text":"主はモーセに言われた。「あなたの死ぬ日は近づいた。ヨシュアを呼び寄せ、共に臨在の幕屋の中に立ちなさい。わたしは彼に任務を授ける。」モーセがヨシュアと共に臨在の幕屋の中に立つと、","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["死ぬ","しぬ"],["日","ひ"],["は"],["近づいた","ちかづいた"],["。"],["ヨシュア"],["を"],["呼び寄せ","よびよせ"],["、"],["共","とも"],["に"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["中","なか"],["に"],["立ち","たち"],["なさい"],["。"],["わたし"],["は"],["彼","かれ"],["に"],["任務","にんむ"],["を"],["授ける","さずける"],["。"],["」"],["モーセ"],["が"],["ヨシュア"],["と"],["共","とも"],["に"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["中","なか"],["に"],["立つ","たつ"],["と"],["、"]]},{"verse":15,"text":"主は雲の柱のうちに幕屋に現れられた。雲の柱は幕屋の入り口にとどまった。","tok":[["主","ぬし"],["は"],["雲","くも"],["の"],["柱","はしら"],["の"],["うち"],["に"],["幕屋","まくや"],["に"],["現れられた","あらわれられた"],["。"],["雲","くも"],["の"],["柱","はしら"],["は"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["とどまった"],["。"]]},{"verse":16,"text":"主はモーセに言われた。「あなたは間もなく先祖と共に眠る。するとこの民は直ちに、入って行く土地で、その中の外国の神々を求めて姦淫を行い、わたしを捨てて、わたしが民と結んだ契約を破るであろう。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["間","ま"],["も"],["なく"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠る","ねむる"],["。"],["する"],["と"],["この"],["民","みん"],["は"],["直ちに","ただちに"],["、"],["入って","はいって"],["行く","いく"],["土地","とち"],["で"],["、"],["その"],["中","なか"],["の"],["外国","がいこく"],["の"],["神々","かみがみ"],["を"],["求めて","もとめて"],["姦淫","かんいん"],["を"],["行い","おこない"],["、"],["わたし"],["を"],["捨てて","すてて"],["、"],["わたし"],["が"],["民","たみ"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["破るで","やぶるで"],["あろう"],["。"]]},{"verse":17,"text":"その日、この民に対してわたしの怒りは燃え、わたしは彼らを捨て、わたしの顔を隠す。民は焼き尽くされることになり、多くの災いと苦難に襲われる。その日民は、『これらの災いに襲われるのは、わたしのうちに神がおられないからではないか』と言う。","tok":[["その"],["日","ひ"],["、"],["この"],["民","たみ"],["に対して","にたいして"],["わたし"],["の"],["怒り","いかり"],["は"],["燃え","もえ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["捨て","すて"],["、"],["わたし"],["の"],["顔","かお"],["を"],["隠す","かくす"],["。"],["民","たみ"],["は"],["焼き","やき"],["尽くされる","つくされる"],["こと"],["に"],["なり"],["、"],["多く","おおく"],["の"],["災い","わざわい"],["と"],["苦難","くなん"],["に"],["襲われる","おそわれる"],["。"],["その"],["日民","ひみん"],["は"],["、"],["『"],["これ"],["ら"],["の"],["災い","わざわい"],["に"],["襲われる","おそわれる"],["の"],["は"],["、"],["わたし"],["の"],["うち"],["に"],["神","かみ"],["が"],["おられない"],["から"],["で"],["は"],["ない"],["か"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":18,"text":"わたしはそれでも、その日、必ずわたしの顔を隠す。彼らが他の神々に向かうことにより行ったすべての悪のゆえである。","tok":[["わたし"],["は"],["それ"],["で"],["も"],["、"],["その"],["日","ひ"],["、"],["必ず","かならず"],["わたし"],["の"],["顔","かお"],["を"],["隠す","かくす"],["。"],["彼","かれ"],["ら"],["が"],["他","ほか"],["の"],["神々","かみがみ"],["に"],["向かう","むかう"],["こと"],["に"],["より"],["行った","いった"],["すべて"],["の"],["悪","あく"],["の"],["ゆえ"],["で"],["ある"],["。"]]},{"verse":19,"text":"あなたたちは今、次の歌を書き留め、イスラエルの人々に教え、それを彼らの口に置き、この歌をイスラエルの人々に対するわたしの証言としなさい。","tok":[["あなた"],["たち"],["は"],["今","いま"],["、"],["次","つぎ"],["の"],["歌","うた"],["を"],["書き留め","かきとめ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["教え","おしえ"],["、"],["それ"],["を"],["彼","かれ"],["ら"],["の"],["口","くち"],["に"],["置き","おき"],["、"],["この"],["歌","うた"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["対する","たいする"],["わたし"],["の"],["証言","しょうげん"],["と"],["し"],["なさい"],["。"]]},{"verse":20,"text":"わたしがその先祖に誓った乳と蜜の流れる土地に彼を導き入れるとき、彼は食べて満ち足り、肥え太り、他の神々に向かい、これに仕え、わたしを侮ってわたしの契約を破るであろう。","tok":[["わたし"],["が"],["その"],["先祖","せんぞ"],["に"],["誓った","ちかった"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["土地","とち"],["に"],["彼","かれ"],["を"],["導き入れる","みちびきいれる"],["とき"],["、"],["彼","かれ"],["は"],["食べて","たべて"],["満ち足り","みちたり"],["、"],["肥え太り","こえふとり"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["向かい","むかい"],["、"],["これ"],["に"],["仕え","つかえ"],["、"],["わたし"],["を"],["侮って","あなどって"],["わたし"],["の"],["契約","けいやく"],["を"],["破るで","やぶるで"],["あろう"],["。"]]},{"verse":21,"text":"そして多くの災いと苦難に襲われるとき、この歌は、その子孫が忘れずに唱え続けることにより、民に対する証言となるであろう。わたしは、わたしが誓った土地へ彼らを導き入れる前から、既に彼らが今日、思い図っていることを知っていたのである。」","tok":[["そして"],["多く","おおく"],["の"],["災い","わざわい"],["と"],["苦難","くなん"],["に"],["襲われる","おそわれる"],["とき"],["、"],["この"],["歌","うた"],["は"],["、"],["その"],["子孫","しそん"],["が"],["忘れず","わすれず"],["に"],["唱え","となえ"],["続ける","つづける"],["こと"],["に"],["より"],["、"],["民","みん"],["に"],["対する","たいする"],["証言","しょうげん"],["と"],["なるで"],["あろう"],["。"],["わたし"],["は"],["、"],["わたし"],["が"],["誓った","ちかった"],["土地","とち"],["へ"],["彼","かれ"],["ら"],["を"],["導き入れる","みちびきいれる"],["前","まえ"],["から"],["、"],["既に","すでに"],["彼","かれ"],["ら"],["が"],["今日","きょう"],["、"],["思い","おもい"],["図って","はかって"],["いる"],["こと"],["を"],["知って","しって"],["いた"],["ので"],["ある"],["。"],["」"]]},{"verse":22,"text":"モーセは、その日、この歌を書き記してイスラエルの人々に教えた。","tok":[["モーセ"],["は"],["、"],["その"],["日","ひ"],["、"],["この"],["歌","うた"],["を"],["書き記して","かきしるして"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["教えた","おしえた"],["。"]]},{"verse":23,"text":"主はヌンの子ヨシュアに命じて言われた。「強く、また雄々しくあれ。あなたこそ、わたしが彼らに誓った土地にイスラエルの人々を導き入れる者である。わたしはいつもあなたと共にいる。」","tok":[["主","ぬし"],["は"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["に"],["命じて","めいじて"],["言われた","いわれた"],["。"],["「"],["強く","つよく"],["、"],["また"],["雄々しく","おおしく"],["あれ"],["。"],["あなた"],["こそ"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["誓った","ちかった"],["土地","とち"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["導き入れる","みちびきいれる"],["者","もの"],["で"],["ある"],["。"],["わたし"],["は"],["いつも"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"],["」"]]},{"verse":24,"text":"モーセは、この律法の言葉を余すところなく書物に書き終えると、","tok":[["モーセ"],["は"],["、"],["この"],["律法","りっぽう"],["の"],["言葉","ことば"],["を"],["余す","あます"],["ところ"],["なく"],["書物","しょもつ"],["に"],["書き","かき"],["終える","おえる"],["と"],["、"]]},{"verse":25,"text":"主の契約の箱を担ぐレビ人に命じた。","tok":[["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担ぐ","かつぐ"],["レビ人","れびにん"],["に"],["命じた","めいじた"],["。"]]},{"verse":26,"text":"「この律法の書を取り、あなたたちの神、主の契約の箱の傍らに置き、あなたに対する証言としてそこにあるようにしなさい。","tok":[["「"],["この"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["取り","とり"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["の"],["傍ら","かたわら"],["に"],["置き","おき"],["、"],["あなた"],["に"],["対する","たいする"],["証言","しょうげん"],["として"],["そこ"],["に"],["ある"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":27,"text":"わたしはあなたがかたくなで背く者であることを知っている。わたしが今日、まだ共に生きているときでさえ、あなたたちは主に背いている。わたしが死んだ後は、なおさらであろう。","tok":[["わたし"],["は"],["あなた"],["が"],["かたくな"],["で"],["背く","そむく"],["者","もの"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["。"],["わたし"],["が"],["今日","きょう"],["、"],["まだ"],["共","とも"],["に"],["生きて","いきて"],["いる"],["とき"],["で"],["さえ"],["、"],["あなた"],["たち"],["は"],["主に","おもに"],["背いて","そむいて"],["いる"],["。"],["わたし"],["が"],["死んだ","しんだ"],["後","あと"],["は"],["、"],["なおさら"],["で"],["あろう"],["。"]]},{"verse":28,"text":"あなたたちの部族の長老と役人をすべてわたしのもとに集めなさい。わたしはこれらの言葉を彼らに語り聞かせ、天と地を彼らに対する証人とする。","tok":[["あなた"],["たち"],["の"],["部族","ぶぞく"],["の"],["長老","ちょうろう"],["と"],["役人","やくにん"],["を"],["すべて"],["わたし"],["の"],["もと"],["に"],["集め","あつめ"],["なさい"],["。"],["わたし"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["彼","かれ"],["ら"],["に"],["語り聞かせ","かたりきかせ"],["、"],["天","てん"],["と"],["地","ち"],["を"],["彼","かれ"],["ら"],["に"],["対する","たいする"],["証人","しょうにん"],["と"],["する"],["。"]]},{"verse":29,"text":"わたしには分かっている。わたしの死んだ後、あなたたちは必ず堕落して、わたしの命じた道からそれる。そして後の日に、災いがあなたたちにふりかかる。あなたたちが主が悪と見なされることを行い、その手の業によって主を怒らせるからである。」","tok":[["わたし"],["に"],["は"],["分かって","わかって"],["いる"],["。"],["わたし"],["の"],["死んだ","しんだ"],["後","あと"],["、"],["あなた"],["たち"],["は"],["必ず","かならず"],["堕落","だらく"],["して"],["、"],["わたし"],["の"],["命じた","めいじた"],["道","みち"],["から"],["それる"],["。"],["そして"],["後","あと"],["の"],["日","ひ"],["に"],["、"],["災い","わざわい"],["が"],["あなた"],["たち"],["に"],["ふりかかる"],["。"],["あなた"],["たち"],["が"],["主","ぬし"],["が"],["悪","あく"],["と"],["見なされる","みなされる"],["こと"],["を"],["行い","おこない"],["、"],["その"],["手","て"],["の"],["業","ごう"],["によって"],["主","ぬし"],["を"],["怒らせる","おこらせる"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":30,"text":"モーセは、イスラエルの全会衆にこの歌の言葉を余すところなく語り聞かせた。","tok":[["モーセ"],["は"],["、"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["に"],["この"],["歌","うた"],["の"],["言葉","ことば"],["を"],["余す","あます"],["ところ"],["なく"],["語り聞かせた","かたりきかせた"],["。"]]}]
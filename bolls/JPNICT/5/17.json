[{"verse":1,"text":"いかなる欠陥であれ傷のある牛や羊を、あなたの神、主にいけにえとしてささげてはならない。それは、あなたの神、主のいとわれることである。","tok":[["いかなる"],["欠陥","けっかん"],["で"],["あれ"],["傷","きず"],["の"],["ある"],["牛","うし"],["や"],["羊","ひつじ"],["を"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["いけにえ"],["として"],["ささげて"],["は"],["ならない"],["。"],["それ"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["いとわれる"],["こと"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたの神、主が与えられるどこかの町で、あなたの中に、男にせよ女にせよ、あなたの神、主が悪と見なされることを行って、契約を破り、","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられる","あたえられる"],["どこ"],["か"],["の"],["町","まち"],["で"],["、"],["あなた"],["の"],["中","なか"],["に"],["、"],["男","おとこ"],["に"],["せよ"],["女","おんな"],["に"],["せよ"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["悪","あく"],["と"],["見なされる","みなされる"],["こと"],["を"],["行って","おこなって"],["、"],["契約","けいやく"],["を"],["破り","やぶり"],["、"]]},{"verse":3,"text":"他の神々に仕え、その神々や太陽、月、天の万象などわたしが命じたことのないものにひれ伏す者がいるならば、","tok":[["他","ほか"],["の"],["神々","かみがみ"],["に"],["仕え","つかえ"],["、"],["その"],["神々","かみがみ"],["や"],["太陽","たいよう"],["、"],["月","つき"],["、"],["天","てん"],["の"],["万象","ばんしょう"],["など"],["わたし"],["が"],["命じた","めいじた"],["こと"],["の"],["ない"],["もの"],["に"],["ひれ伏す","ひれふす"],["者","もの"],["が"],["いるならば"],["、"]]},{"verse":4,"text":"その知らせを受け、それを聞いたときには、よく調べなさい。もし、それが確かな事実であり、イスラエルの中でこうした、いとうべきことが行われたのであれば、","tok":[["その"],["知らせ","しらせ"],["を"],["受け","うけ"],["、"],["それ"],["を"],["聞いた","きいた"],["とき"],["に"],["は"],["、"],["よく"],["調べ","しらべ"],["なさい"],["。"],["もし"],["、"],["それ"],["が"],["確か","たしか"],["な"],["事実","じじつ"],["で"],["あり"],["、"],["イスラエル"],["の"],["中","なか"],["で"],["こう"],["した"],["、"],["いとうべき"],["こと"],["が"],["行われた","おこなわれた"],["ので"],["あれば"],["、"]]},{"verse":5,"text":"この悪事を行った当の男ないし女を町の門に引き出し、その男ないし女を石で打ちなさい。彼らは死なねばならない。","tok":[["この"],["悪事","あくじ"],["を"],["行った","おこなった"],["当","とう"],["の"],["男","おとこ"],["ない"],["し"],["女","おんな"],["を"],["町","まち"],["の"],["門","もん"],["に"],["引き出し","ひきだし"],["、"],["その"],["男","おとこ"],["ない"],["し"],["女","おんな"],["を"],["石","いし"],["で"],["打ち","うち"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["死なねば","しなねば"],["ならない"],["。"]]},{"verse":6,"text":"死刑に処せられるには、二人ないし三人の証言を必要とする。一人の証人の証言で死刑に処せられてはならない。","tok":[["死刑","しけい"],["に"],["処せられる","しょせられる"],["に"],["は"],["、"],["二人","ふたり"],["ないし"],["三人","さんにん"],["の"],["証言","しょうげん"],["を"],["必要","ひつよう"],["と"],["する"],["。"],["一人","ひとり"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["で"],["死刑","しけい"],["に"],["処せられて","しょせられて"],["は"],["ならない"],["。"]]},{"verse":7,"text":"死刑の執行に当たっては、まず証人が手を下し、次に民が全員手を下す。あなたはこうして、あなたの中から悪を取り除かねばならない。","tok":[["死刑","しけい"],["の"],["執行","しっこう"],["に"],["当たって","あたって"],["は"],["、"],["まず"],["証人","しょうにん"],["が"],["手","て"],["を"],["下し","くだし"],["、"],["次","つぎ"],["に"],["民","たみ"],["が"],["全員","ぜんいん"],["手","て"],["を"],["下す","くだす"],["。"],["あなた"],["は"],["こう"],["して"],["、"],["あなた"],["の"],["中","なか"],["から"],["悪","あく"],["を"],["取り除かねば","とりのぞかねば"],["ならない"],["。"]]},{"verse":8,"text":"あなたの町で、流血、もめ事、傷害などの訴えを裁くのが極めて難しいならば、直ちにあなたの神、主が選ばれる場所に上り、","tok":[["あなた"],["の"],["町","まち"],["で"],["、"],["流血","りゅうけつ"],["、"],["もめ事","もめごと"],["、"],["傷害","しょうがい"],["など"],["の"],["訴え","うったえ"],["を"],["裁く","さばく"],["の"],["が"],["極めて","きわめて"],["難しいならば","むずかしいならば"],["、"],["直ちに","ただちに"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["選ばれる","えらばれる"],["場所","ばしょ"],["に"],["上り","のぼり"],["、"]]},{"verse":9,"text":"レビ人である祭司およびその時、任に就いている裁判人のもとに行って尋ねなさい。彼らが判決を告げるであろう。","tok":[["レビ人","れびにん"],["で"],["ある"],["祭司","さいし"],["および"],["その"],["時","とき"],["、"],["任","にん"],["に"],["就いて","ついて"],["いる"],["裁判人","さいばんにん"],["の"],["もと"],["に"],["行って","いって"],["尋ね","たずね"],["なさい"],["。"],["彼","かれ"],["ら"],["が"],["判決","はんけつ"],["を"],["告げるで","つげるで"],["あろう"],["。"]]},{"verse":10,"text":"あなたは、彼らが主の選ばれる場所から告げる判決に従い、彼らの指示するとおりに忠実に実行しなければならない。","tok":[["あなた"],["は"],["、"],["彼","かれ"],["ら"],["が"],["主","ぬし"],["の"],["選ばれる","えらばれる"],["場所","ばしょ"],["から"],["告げる","つげる"],["判決","はんけつ"],["に"],["従い","したがい"],["、"],["彼","かれ"],["ら"],["の"],["指示","しじ"],["する"],["とおり"],["に"],["忠実","ちゅうじつ"],["に"],["実行","じっこう"],["しなければ"],["ならない"],["。"]]},{"verse":11,"text":"あなたは彼らの示す指示と下す判決に従い、彼らが告げる言葉に背いて、右にも左にもそれてはならない。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["の"],["示す","しめす"],["指示","しじ"],["と"],["下す","くだす"],["判決","はんけつ"],["に"],["従い","したがい"],["、"],["彼","かれ"],["ら"],["が"],["告げる","つげる"],["言葉","ことば"],["に"],["背いて","そむいて"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それ"],["て"],["は"],["ならない"],["。"]]},{"verse":12,"text":"あなたの神、主に仕えてそこに立つ祭司あるいは裁判人を無視して、勝手にふるまう者があれば、その者を死刑に処し、イスラエルの中から悪を取り除かねばならない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主に","おもに"],["仕えて","つかえて"],["そこ"],["に"],["立つ","たつ"],["祭司","さいし"],["あるいは"],["裁判人","さいばんにん"],["を"],["無視","むし"],["して"],["、"],["勝手に","かってに"],["ふるまう"],["者","もの"],["が"],["あれば"],["、"],["その"],["者","もの"],["を"],["死刑","しけい"],["に"],["処し","しょし"],["、"],["イスラエル"],["の"],["中","なか"],["から"],["悪","あく"],["を"],["取り除かねば","とりのぞかねば"],["ならない"],["。"]]},{"verse":13,"text":"民は皆、これを聞くと、恐れを抱き、もはや勝手にふるまうことはないであろう。","tok":[["民","みん"],["は"],["皆","みな"],["、"],["これ"],["を"],["聞く","きく"],["と"],["、"],["恐れ","おそれ"],["を"],["抱き","いだき"],["、"],["もはや"],["勝手に","かってに"],["ふるまう"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":14,"text":"あなたが、あなたの神、主の与えられる土地に入って、それを得て、そこに住むようになり、「周囲のすべての国々と同様、わたしを治める王を立てよう」と言うならば、","tok":[["あなた"],["が"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["与えられる","あたえられる"],["土地","とち"],["に"],["入って","はいって"],["、"],["それ"],["を"],["得て","えて"],["、"],["そこ"],["に"],["住む","すむ"],["よう"],["に"],["なり"],["、"],["「"],["周囲","しゅうい"],["の"],["すべて"],["の"],["国々","くにぐに"],["と"],["同様","どうよう"],["、"],["わたし"],["を"],["治める","おさめる"],["王","おう"],["を"],["立てよう","たてよう"],["」"],["と"],["言うならば","ゆうならば"],["、"]]},{"verse":15,"text":"必ず、あなたの神、主が選ばれる者を王としなさい。同胞の中からあなたを治める王を立て、同胞でない外国人をあなたの上に立てることはできない。","tok":[["必ず","かならず"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["選ばれる","えらばれる"],["者","もの"],["を"],["王","おう"],["と"],["し"],["なさい"],["。"],["同胞","どうほう"],["の"],["中","なか"],["から"],["あなた"],["を"],["治める","おさめる"],["王","おう"],["を"],["立て","たて"],["、"],["同胞","どうほう"],["で"],["ない"],["外国人","がいこくじん"],["を"],["あなた"],["の"],["上","うえ"],["に"],["立てる","たてる"],["こと"],["は"],["できない"],["。"]]},{"verse":16,"text":"王は馬を増やしてはならない。馬を増やすために、民をエジプトへ送り返すことがあってはならない。「あなたたちは二度とこの道を戻ってはならない」と主は言われた。","tok":[["王","おう"],["は"],["馬","うま"],["を"],["増やして","ふやして"],["は"],["ならない"],["。"],["馬","うま"],["を"],["増やす","ふやす"],["ため"],["に"],["、"],["民","みん"],["を"],["エジプト"],["へ"],["送り返す","おくりかえす"],["こと"],["が"],["あって"],["は"],["ならない"],["。"],["「"],["あなた"],["たち"],["は"],["二","に"],["度","ど"],["と"],["この"],["道","みち"],["を"],["戻って","もどって"],["は"],["ならない"],["」"],["と"],["主","ぬし"],["は"],["言われた","いわれた"],["。"]]},{"verse":17,"text":"王は大勢の妻をめとって、心を迷わしてはならない。銀や金を大量に蓄えてはならない。","tok":[["王","おう"],["は"],["大勢","おおぜい"],["の"],["妻","つま"],["を"],["めとって"],["、"],["心","こころ"],["を"],["迷わして","まよわして"],["は"],["ならない"],["。"],["銀","ぎん"],["や"],["金","きん"],["を"],["大量","たいりょう"],["に"],["蓄えて","たくわえて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"彼が王位についたならば、レビ人である祭司のもとにある原本からこの律法の写しを作り、","tok":[["彼","かれ"],["が"],["王位","おうい"],["に"],["ついたならば"],["、"],["レビ人","れびにん"],["で"],["ある"],["祭司","さいし"],["の"],["もと"],["に"],["ある"],["原本","げんぽん"],["から"],["この"],["律法","りっぽう"],["の"],["写し","うつし"],["を"],["作り","つくり"],["、"]]},{"verse":19,"text":"それを自分の傍らに置き、生きている限り読み返し、神なる主を畏れることを学び、この律法のすべての言葉とこれらの掟を忠実に守らねばならない。","tok":[["それ"],["を"],["自分","じぶん"],["の"],["傍ら","かたわら"],["に"],["置き","おき"],["、"],["生きて","いきて"],["いる"],["限り","かぎり"],["読み返し","よみかえし"],["、"],["神","かみ"],["なる"],["主","ぬし"],["を"],["畏れる","おそれる"],["こと"],["を"],["学び","まなび"],["、"],["この"],["律法","りっぽう"],["の"],["すべて"],["の"],["言葉","ことば"],["と"],["これ"],["ら"],["の"],["掟","おきて"],["を"],["忠実","ちゅうじつ"],["に"],["守らねば","まもらねば"],["ならない"],["。"]]},{"verse":20,"text":"そうすれば王は同胞を見下して高ぶることなく、この戒めから右にも左にもそれることなく、王もその子らもイスラエルの中で王位を長く保つことができる。","tok":[["そう"],["すれば"],["王","おう"],["は"],["同胞","どうほう"],["を"],["見下して","みくだして"],["高ぶる","たかぶる"],["こと"],["なく"],["、"],["この"],["戒め","いましめ"],["から"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それる"],["こと"],["なく"],["、"],["王","おう"],["も"],["その"],["子","こ"],["ら"],["も"],["イスラエル"],["の"],["中","なか"],["で"],["王位","おうい"],["を"],["長く","ながく"],["保つ","たもつ"],["こと"],["が"],["できる"],["。"]]}]
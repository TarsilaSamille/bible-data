[{"verse":1,"text":"五日の後、大祭司アナニアは、長老数名と弁護士テルティロという者を連れて下って来て、総督にパウロを訴え出た。","tok":[["五日","いつか"],["の"],["後","あと"],["、"],["大","だい"],["祭司","さいし"],["アナニア"],["は"],["、"],["長老","ちょうろう"],["数","すう"],["名","めい"],["と"],["弁護士","べんごし"],["テルティロ"],["と"],["いう"],["者","もの"],["を"],["連れて","つれて"],["下って","くだって"],["来て","きて"],["、"],["総督","そうとく"],["に"],["パウロ"],["を"],["訴え出た","うったえでた"],["。"]]},{"verse":2,"text":"パウロが呼び出されると、テルティロは告発を始めた。「フェリクス閣下、閣下のお陰で、私どもは十分に平和を享受しております。また、閣下の御配慮によって、いろいろな改革がこの国で進められています。私どもは、あらゆる面で、至るところで、このことを認めて称賛申し上げ、また心から感謝しているしだいです。","tok":[["パウロ"],["が"],["呼び出される","よびだされる"],["と"],["、"],["テルティロ"],["は"],["告発","こくはつ"],["を"],["始めた","はじめた"],["。"],["「"],["フェリクス"],["閣下","かっか"],["、"],["閣下","かっか"],["の"],["お陰","おかげ"],["で"],["、"],["私","わたくし"],["ども"],["は"],["十分","じゅうぶん"],["に"],["平和","へいわ"],["を"],["享受","きょうじゅ"],["して"],["おります"],["。"],["また"],["、"],["閣下","かっか"],["の"],["御配慮","ごはいりょ"],["によって"],["、"],["いろいろ"],["な"],["改革","かいかく"],["が"],["この"],["国","くに"],["で"],["進められて","すすめられて"],["います"],["。"],["私","わたくし"],["ども"],["は"],["、"],["あらゆる"],["面","めん"],["で"],["、"],["至る","いたる"],["ところ"],["で"],["、"],["この"],["こと"],["を"],["認めて","みとめて"],["称賛","しょうさん"],["申し上げ","もうしあげ"],["、"],["また"],["心","こころ"],["から"],["感謝","かんしゃ"],["して"],["いる"],["しだい"],["です"],["。"]]},{"verse":4,"text":"さて、これ以上御迷惑にならないよう手短に申し上げます。御寛容をもってお聞きください。","tok":[["さて"],["、"],["これ"],["以上","いじょう"],["御迷惑","ごめいわく"],["に"],["ならない"],["よう"],["手短","てみじか"],["に"],["申し上げます","もうしあげます"],["。"],["御寛容","ごかんよう"],["を"],["もって"],["お聞き","おきき"],["ください"],["。"]]},{"verse":5,"text":"実は、この男は疫病のような人間で、世界中のユダヤ人の間に騒動を引き起こしている者、『ナザレ人の分派』の主謀者であります。","tok":[["実","じつ"],["は"],["、"],["この"],["男","おとこ"],["は"],["疫病","やくびょう"],["の"],["よう"],["な"],["人間","にんげん"],["で"],["、"],["世界中","せかいじゅう"],["の"],["ユダヤ人","ゆだやじん"],["の"],["間","あいだ"],["に"],["騒動","そうどう"],["を"],["引き起こして","ひきおこして"],["いる"],["者","もの"],["、"],["『"],["ナザレ人","なざれにん"],["の"],["分派","ぶんぱ"],["』"],["の"],["主謀者","しゅぼうしゃ"],["で"],["あります"],["。"]]},{"verse":6,"text":"この男は神殿さえも汚そうとしましたので逮捕いたしました。","tok":[["この"],["男","おとこ"],["は"],["神殿","しんでん"],["さえ"],["も"],["汚そう","よごそう"],["と"],["しました"],["ので"],["逮捕","たいほ"],["いたしました"],["。"]]},{"verse":7,"text":"†〔そして、私どもの律法によって裁こうとしたところ、千人隊長リシアがやって来て、この男を無理やり私どもの手から引き離し、告発人たちには、閣下のところに来るようにと命じました。〕","tok":[["†"],["〔"],["そして"],["、"],["私","わたくし"],["ども"],["の"],["律法","りっぽう"],["によって"],["裁こう","さばこう"],["と"],["した"],["ところ"],["、"],["千人","せんにん"],["隊長","たいちょう"],["リシア"],["が"],["やって"],["来て","きて"],["、"],["この"],["男","おとこ"],["を"],["無理やり","むりやり"],["私","わたくし"],["ども"],["の"],["手","て"],["から"],["引き離し","ひきはなし"],["、"],["告発人","こくはつにん"],["たち"],["に"],["は"],["、"],["閣下","かっか"],["の"],["ところ"],["に"],["来る","くる"],["よう"],["に"],["と"],["命じました","めいじました"],["。"],["〕"]]},{"verse":8,"text":"閣下御自身でこの者をお調べくだされば、私どもの告発したことがすべてお分かりになるかと存じます。」","tok":[["閣下","かっか"],["御自身","ごじしん"],["で"],["この"],["者","もの"],["を"],["お調べ","おしらべ"],["くだされば"],["、"],["私","わたくし"],["ども"],["の"],["告発","こくはつ"],["した"],["こと"],["が"],["すべて"],["お分かり","おわかり"],["に"],["なる"],["か"],["と"],["存じます","ぞんじます"],["。"],["」"]]},{"verse":9,"text":"他のユダヤ人たちもこの告発を支持し、そのとおりであると申し立てた。","tok":[["他","ほか"],["の"],["ユダヤ人","ゆだやじん"],["たち"],["も"],["この"],["告発","こくはつ"],["を"],["支持","しじ"],["し"],["、"],["その"],["とおり"],["で"],["ある"],["と"],["申し立てた","もうしたてた"],["。"]]},{"verse":10,"text":"総督が、発言するように合図したので、パウロは答弁した。「私は、閣下が多年この国民の裁判をつかさどる方であることを、存じ上げておりますので、私自身のことを喜んで弁明いたします。","tok":[["総督","そうとく"],["が"],["、"],["発言","はつげん"],["する"],["よう"],["に"],["合図","あいず"],["した"],["ので"],["、"],["パウロ"],["は"],["答弁","とうべん"],["した"],["。"],["「"],["私","わたくし"],["は"],["、"],["閣下","かっか"],["が"],["多年","たねん"],["この"],["国民","こくみん"],["の"],["裁判","さいばん"],["を"],["つかさどる"],["方","かた"],["で"],["ある"],["こと"],["を"],["、"],["存じ上げて","ぞんじあげて"],["おります"],["ので"],["、"],["私自身","わたしじしん"],["の"],["こと"],["を"],["喜んで","よろこんで"],["弁明","べんめい"],["いたします"],["。"]]},{"verse":11,"text":"確かめていただけば分かることですが、私が礼拝のためエルサレムに上ってから、まだ十二日しかたっていません。","tok":[["確かめて","たしかめて"],["いただけば"],["分かる","わかる"],["こと"],["です"],["が"],["、"],["私","わたくし"],["が"],["礼拝","れいはい"],["の"],["ため"],["エルサレム"],["に"],["上って","のぼって"],["から"],["、"],["まだ"],["十二","じゅうに"],["日","にち"],["しか"],["たって"],["いません"],["。"]]},{"verse":12,"text":"神殿でも会堂でも町の中でも、この私がだれかと論争したり、群衆を扇動したりするのを、だれも見た者はおりません。","tok":[["神殿","しんでん"],["で"],["も"],["会堂","かいどう"],["で"],["も"],["町","まち"],["の"],["中","なか"],["で"],["も"],["、"],["この"],["私","わたくし"],["が"],["だれ"],["か"],["と"],["論争","ろんそう"],["し"],["たり"],["、"],["群衆","ぐんしゅう"],["を"],["扇動","せんどう"],["し"],["たり"],["する"],["の"],["を"],["、"],["だれ"],["も"],["見た","みた"],["者","もの"],["は"],["おりません"],["。"]]},{"verse":13,"text":"そして彼らは、私を告発している件に関し、閣下に対して何の証拠も挙げることができません。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["、"],["私","わたくし"],["を"],["告発","こくはつ"],["して"],["いる"],["件","けん"],["に"],["関し","かんし"],["、"],["閣下","かっか"],["に対して","にたいして"],["何","なん"],["の"],["証拠","しょうこ"],["も"],["挙げる","あげる"],["こと"],["が"],["できません"],["。"]]},{"verse":14,"text":"しかしここで、はっきり申し上げます。私は、彼らが『分派』と呼んでいるこの道に従って、先祖の神を礼拝し、また、律法に則したことと預言者の書に書いてあることを、ことごとく信じています。","tok":[["しかし"],["ここ"],["で"],["、"],["はっきり"],["申し上げます","もうしあげます"],["。"],["私","わたくし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["『"],["分派","ぶんぱ"],["』"],["と"],["呼んで","よんで"],["いる"],["この"],["道","みち"],["に"],["従って","したがって"],["、"],["先祖","せんぞ"],["の"],["神","かみ"],["を"],["礼拝","れいはい"],["し"],["、"],["また"],["、"],["律法","りっぽう"],["に"],["則した","そくした"],["こと"],["と"],["預言者","よげんしゃ"],["の"],["書","しょ"],["に"],["書いて","かいて"],["ある"],["こと"],["を"],["、"],["ことごとく"],["信じて","しんじて"],["います"],["。"]]},{"verse":15,"text":"更に、正しい者も正しくない者もやがて復活するという希望を、神に対して抱いています。この希望は、この人たち自身も同じように抱いております。","tok":[["更に","さらに"],["、"],["正しい","ただしい"],["者","もの"],["も"],["正しく","ただしく"],["ない"],["者","もの"],["も"],["やがて"],["復活","ふっかつ"],["する"],["と"],["いう"],["希望","きぼう"],["を"],["、"],["神","かみ"],["に対して","にたいして"],["抱いて","いだいて"],["います"],["。"],["この"],["希望","きぼう"],["は"],["、"],["この"],["人","ひと"],["たち"],["自身","じしん"],["も"],["同じ","おなじ"],["よう"],["に"],["抱いて","いだいて"],["おります"],["。"]]},{"verse":16,"text":"こういうわけで私は、神に対しても人に対しても、責められることのない良心を絶えず保つように努めています。","tok":[["こう"],["いう"],["わけ"],["で"],["私","わたくし"],["は"],["、"],["神","かみ"],["に対して","にたいして"],["も"],["人","ひと"],["に対して","にたいして"],["も"],["、"],["責められる","せめられる"],["こと"],["の"],["ない"],["良心","りょうしん"],["を"],["絶えず","たえず"],["保つ","たもつ"],["よう"],["に"],["努めて","つとめて"],["います"],["。"]]},{"verse":17,"text":"さて、私は、同胞に救援金を渡すため、また、供え物を献げるために、何年ぶりかで戻って来ました。","tok":[["さて"],["、"],["私","わたくし"],["は"],["、"],["同胞","どうほう"],["に"],["救援金","きゅうえんきん"],["を"],["渡す","わたす"],["ため"],["、"],["また"],["、"],["供え物","そなえもの"],["を"],["献げる","ささげる"],["ため"],["に"],["、"],["何","なん"],["年","ねん"],["ぶり"],["か"],["で"],["戻って","もどって"],["来ました","きました"],["。"]]},{"verse":18,"text":"私が清めの式にあずかってから、神殿で供え物を献げているところを、人に見られたのですが、別に群衆もいませんし、騒動もありませんでした。","tok":[["私","わたくし"],["が"],["清め","きよめ"],["の"],["式","しき"],["に"],["あずかって"],["から"],["、"],["神殿","しんでん"],["で"],["供え物","そなえもの"],["を"],["献げて","ささげて"],["いる"],["ところ"],["を"],["、"],["人","ひと"],["に"],["見られた","みられた"],["の"],["です"],["が"],["、"],["別","べつ"],["に"],["群衆","ぐんしゅう"],["も"],["いません"],["し"],["、"],["騒動","そうどう"],["も"],["ありませんでした"],["。"]]},{"verse":19,"text":"ただ、アジア州から来た数人のユダヤ人はいました。もし、私を訴えるべき理由があるというのであれば、この人たちこそ閣下のところに出頭して告発すべきだったのです。","tok":[["ただ"],["、"],["アジア州","あじあしゅう"],["から"],["来た","きた"],["数人","すうにん"],["の"],["ユダヤ人","ゆだやじん"],["は"],["いました"],["。"],["もし"],["、"],["私","わたくし"],["を"],["訴えるべき","うったえるべき"],["理由","りゆう"],["が"],["ある"],["と"],["いう"],["ので"],["あれば"],["、"],["この"],["人","ひと"],["たち"],["こそ"],["閣下","かっか"],["の"],["ところ"],["に"],["出頭","しゅっとう"],["して"],["告発","こくはつ"],["すべきだった"],["の"],["です"],["。"]]},{"verse":20,"text":"さもなければ、ここにいる人たち自身が、最高法院に出頭していた私にどんな不正を見つけたか、今言うべきです。","tok":[["さも"],["なければ"],["、"],["ここ"],["に"],["いる"],["人","ひと"],["たち"],["自身","じしん"],["が"],["、"],["最高","さいこう"],["法院","ほういん"],["に"],["出頭","しゅっとう"],["して"],["いた"],["私","わたくし"],["に"],["どんな"],["不正","ふせい"],["を"],["見つけた","みつけた"],["か"],["、"],["今","いま"],["言うべきです","ゆうべきです"],["。"]]},{"verse":21,"text":"彼らの中に立って、『死者の復活のことで、私は今日あなたがたの前で裁判にかけられているのだ』と叫んだだけなのです。」","tok":[["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["立って","たって"],["、"],["『"],["死者","ししゃ"],["の"],["復活","ふっかつ"],["の"],["こと"],["で"],["、"],["私","わたくし"],["は"],["今日","きょう"],["あなた"],["がた"],["の"],["前","まえ"],["で"],["裁判","さいばん"],["に"],["かけられて"],["いる"],["の"],["だ"],["』"],["と"],["叫んだ","さけんだ"],["だけ"],["な"],["の"],["です"],["。"],["」"]]},{"verse":22,"text":"フェリクスは、この道についてかなり詳しく知っていたので、「千人隊長リシアが下って来るのを待って、あなたたちの申し立てに対して判決を下すことにする」と言って裁判を延期した。","tok":[["フェリクス"],["は"],["、"],["この"],["道","みち"],["について"],["かなり"],["詳しく","くわしく"],["知って","しって"],["いた"],["ので"],["、"],["「"],["千人","せんにん"],["隊長","たいちょう"],["リシア"],["が"],["下って","くだって"],["来る","くる"],["の"],["を"],["待って","まって"],["、"],["あなた"],["たち"],["の"],["申し立て","もうしたて"],["に対して","にたいして"],["判決","はんけつ"],["を"],["下す","くだす"],["こと"],["に"],["する"],["」"],["と"],["言って","いって"],["裁判","さいばん"],["を"],["延期","えんき"],["した"],["。"]]},{"verse":23,"text":"そして、パウロを監禁するように、百人隊長に命じた。ただし、自由をある程度与え、友人たちが彼の世話をするのを妨げないようにさせた。","tok":[["そして"],["、"],["パウロ"],["を"],["監禁","かんきん"],["する"],["よう"],["に"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["に"],["命じた","めいじた"],["。"],["ただし"],["、"],["自由","じゆう"],["を"],["ある"],["程度","ていど"],["与え","あたえ"],["、"],["友人","ゆうじん"],["たち"],["が"],["彼","かれ"],["の"],["世話","せわ"],["を"],["する"],["の"],["を"],["妨げない","さまたげない"],["よう"],["に"],["させた"],["。"]]},{"verse":24,"text":"数日の後、フェリクスはユダヤ人である妻のドルシラと一緒に来て、パウロを呼び出し、キリスト‧イエスへの信仰について話を聞いた。","tok":[["数日","すうじつ"],["の"],["後","あと"],["、"],["フェリクス"],["は"],["ユダヤ人","ゆだやじん"],["で"],["ある"],["妻","つま"],["の"],["ドルシラ"],["と"],["一緒","いっしょ"],["に"],["来て","きて"],["、"],["パウロ"],["を"],["呼び出し","よびだし"],["、"],["キリスト"],["‧"],["イエス"],["へ"],["の"],["信仰","しんこう"],["について"],["話","はなし"],["を"],["聞いた","きいた"],["。"]]},{"verse":25,"text":"しかし、パウロが正義や節制や来るべき裁きについて話すと、フェリクスは恐ろしくなり、「今回はこれで帰ってよろしい。また適当な機会に呼び出すことにする」と言った。","tok":[["しかし"],["、"],["パウロ"],["が"],["正義","せいぎ"],["や"],["節制","せっせい"],["や"],["来るべき","きたるべき"],["裁き","さばき"],["について"],["話す","はなす"],["と"],["、"],["フェリクス"],["は"],["恐ろしく","おそろしく"],["なり"],["、"],["「"],["今回","こんかい"],["は"],["これ"],["で"],["帰って","かえって"],["よろしい"],["。"],["また"],["適当","てきとう"],["な"],["機会","きかい"],["に"],["呼び出す","よびだす"],["こと"],["に"],["する"],["」"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"だが、パウロから金をもらおうとする下心もあったので、度々呼び出しては話し合っていた。","tok":[["だ"],["が"],["、"],["パウロ"],["から"],["金","かね"],["を"],["もらおう"],["と"],["する"],["下心","したごころ"],["も"],["あった"],["ので"],["、"],["度々","たびたび"],["呼び出して","よびだして"],["は"],["話し合って","はなしあって"],["いた"],["。"]]},{"verse":27,"text":"さて、二年たって、フェリクスの後任者としてポルキウス‧フェストゥスが赴任したが、フェリクスは、ユダヤ人に気に入られようとして、パウロを監禁したままにしておいた。","tok":[["さて"],["、"],["二","に"],["年","ねん"],["たって"],["、"],["フェリクス"],["の"],["後任者","こうにんしゃ"],["として"],["ポルキウス"],["‧"],["フェストゥス"],["が"],["赴任","ふにん"],["した"],["が"],["、"],["フェリクス"],["は"],["、"],["ユダヤ人","ゆだやじん"],["に"],["気","き"],["に"],["入られよう","いられよう"],["として"],["、"],["パウロ"],["を"],["監禁","かんきん"],["した"],["まま"],["に"],["して"],["おいた"],["。"]]}]
[{"verse":1,"text":"テオフィロさま、わたしは先に第一巻を著して、イエスが行い、また教え始めてから、お選びになった使徒たちに聖霊を通して指図を与え、天に上げられた日までのすべてのことについて書き記しました。","tok":[["テオフィロ"],["さま"],["、"],["わたし"],["は"],["先","さき"],["に"],["第","だい"],["一","いち"],["巻","かん"],["を"],["著して","あらわして"],["、"],["イエス"],["が"],["行い","おこない"],["、"],["また"],["教え","おしえ"],["始めて","はじめて"],["から"],["、"],["お選び","おえらび"],["に"],["なった"],["使徒","しと"],["たち"],["に"],["聖霊","せいれい"],["を"],["通して","とおして"],["指図","さしず"],["を"],["与え","あたえ"],["、"],["天","てん"],["に"],["上げられた","あげられた"],["日","ひ"],["まで"],["の"],["すべて"],["の"],["こと"],["について"],["書き記しました","かきしるしました"],["。"]]},{"verse":3,"text":"イエスは苦難を受けた後、御自分が生きていることを、数多くの証拠をもって使徒たちに示し、四十日にわたって彼らに現れ、神の国について話された。","tok":[["イエス"],["は"],["苦難","くなん"],["を"],["受けた","うけた"],["後","あと"],["、"],["御自分","ごじぶん"],["が"],["生きて","いきて"],["いる"],["こと"],["を"],["、"],["数多く","かずおおく"],["の"],["証拠","しょうこ"],["を"],["もって"],["使徒","しと"],["たち"],["に"],["示し","しめし"],["、"],["四十日","よんとうか"],["に"],["わたって"],["彼","かれ"],["ら"],["に"],["現れ","あらわれ"],["、"],["神","かみ"],["の"],["国","くに"],["について"],["話された","はなされた"],["。"]]},{"verse":4,"text":"そして、彼らと食事を共にしていたとき、こう命じられた。「エルサレムを離れず、前にわたしから聞いた、父の約束されたものを待ちなさい。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["と"],["食事","しょくじ"],["を"],["共","とも"],["に"],["して"],["いた"],["とき"],["、"],["こう"],["命じられた","めいじられた"],["。"],["「"],["エルサレム"],["を"],["離れず","はなれず"],["、"],["前","まえ"],["に"],["わたし"],["から"],["聞いた","きいた"],["、"],["父","ちち"],["の"],["約束","やくそく"],["された"],["もの"],["を"],["待ち","まち"],["なさい"],["。"]]},{"verse":5,"text":"ヨハネは水で洗礼を授けたが、あなたがたは間もなく聖霊による洗礼を授けられるからである。」","tok":[["ヨハネ"],["は"],["水","みず"],["で"],["洗礼","せんれい"],["を"],["授けた","さずけた"],["が"],["、"],["あなた"],["がた"],["は"],["間","ま"],["も"],["なく"],["聖霊","せいれい"],["に"],["よる"],["洗礼","せんれい"],["を"],["授けられる","さずけられる"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":6,"text":"さて、使徒たちは集まって、「主よ、イスラエルのために国を建て直してくださるのは、この時ですか」と尋ねた。","tok":[["さて"],["、"],["使徒","しと"],["たち"],["は"],["集まって","あつまって"],["、"],["「"],["主","ぬし"],["よ"],["、"],["イスラエル"],["の"],["ため"],["に"],["国","くに"],["を"],["建て直して","たてなおして"],["くださる"],["の"],["は"],["、"],["この"],["時","とき"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":7,"text":"イエスは言われた。「父が御自分の権威をもってお定めになった時や時期は、あなたがたの知るところではない。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["父","ちち"],["が"],["御自分","ごじぶん"],["の"],["権威","けんい"],["を"],["もって"],["お定め","おさだめ"],["に"],["なった"],["時","とき"],["や"],["時期","じき"],["は"],["、"],["あなた"],["がた"],["の"],["知る","しる"],["ところ"],["で"],["は"],["ない"],["。"]]},{"verse":8,"text":"あなたがたの上に聖霊が降ると、あなたがたは力を受ける。そして、エルサレムばかりでなく、ユダヤとサマリアの全土で、また、地の果てに至るまで、わたしの証人となる。」","tok":[["あなた"],["がた"],["の"],["上","うえ"],["に"],["聖霊","せいれい"],["が"],["降る","ふる"],["と"],["、"],["あなた"],["がた"],["は"],["力","ちから"],["を"],["受ける","うける"],["。"],["そして"],["、"],["エルサレム"],["ばかり"],["で"],["なく"],["、"],["ユダヤ"],["と"],["サマリア"],["の"],["全土","ぜんど"],["で"],["、"],["また"],["、"],["地","ち"],["の"],["果て","はて"],["に"],["至る","いたる"],["まで"],["、"],["わたし"],["の"],["証人","しょうにん"],["と"],["なる"],["。"],["」"]]},{"verse":9,"text":"こう話し終わると、イエスは彼らが見ているうちに天に上げられたが、雲に覆われて彼らの目から見えなくなった。","tok":[["こう"],["話し","はなし"],["終わる","おわる"],["と"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["が"],["見て","みて"],["いる"],["うち"],["に"],["天","てん"],["に"],["上げられた","あげられた"],["が"],["、"],["雲","くも"],["に"],["覆われて","おおわれて"],["彼","かれ"],["ら"],["の"],["目","め"],["から"],["見えなく","みえなく"],["なった"],["。"]]},{"verse":10,"text":"イエスが離れ去って行かれるとき、彼らは天を見つめていた。すると、白い服を着た二人の人がそばに立って、","tok":[["イエス"],["が"],["離れ去って","はなれさって"],["行かれる","いかれる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["天","てん"],["を"],["見つめて","みつめて"],["いた"],["。"],["する"],["と"],["、"],["白い","しろい"],["服","ふく"],["を"],["着た","きた"],["二人","ふたり"],["の"],["人","ひと"],["が"],["そば"],["に"],["立って","たって"],["、"]]},{"verse":11,"text":"言った。「ガリラヤの人たち、なぜ天を見上げて立っているのか。あなたがたから離れて天に上げられたイエスは、天に行かれるのをあなたがたが見たのと同じ有様で、またおいでになる。」","tok":[["言った","いった"],["。"],["「"],["ガリラヤ"],["の"],["人","ひと"],["たち"],["、"],["なぜ"],["天","てん"],["を"],["見上げて","みあげて"],["立って","たって"],["いる"],["の"],["か"],["。"],["あなた"],["がた"],["から"],["離れて","はなれて"],["天","てん"],["に"],["上げられた","あげられた"],["イエス"],["は"],["、"],["天","てん"],["に"],["行かれる","いかれる"],["の"],["を"],["あなた"],["がた"],["が"],["見た","みた"],["の"],["と"],["同じ","おなじ"],["有様","ありさま"],["で"],["、"],["また"],["おいで"],["に"],["なる"],["。"],["」"]]},{"verse":12,"text":"使徒たちは、「オリーブ畑」と呼ばれる山からエルサレムに戻って来た。この山はエルサレムに近く、安息日にも歩くことが許される距離の所にある。","tok":[["使徒","しと"],["たち"],["は"],["、"],["「"],["オリーブ"],["畑","はたけ"],["」"],["と"],["呼ばれる","よばれる"],["山","やま"],["から"],["エルサレム"],["に"],["戻って","もどって"],["来た","きた"],["。"],["この"],["山","やま"],["は"],["エルサレム"],["に"],["近く","ちかく"],["、"],["安息日","あんそくび"],["に"],["も"],["歩く","あるく"],["こと"],["が"],["許される","ゆるされる"],["距離","きょり"],["の"],["所","ところ"],["に"],["ある"],["。"]]},{"verse":13,"text":"彼らは都に入ると、泊まっていた家の上の部屋に上がった。それは、ペトロ、ヨハネ、ヤコブ、アンデレ、フィリポ、トマス、バルトロマイ、マタイ、アルファイの子ヤコブ、熱心党のシモン、ヤコブの子ユダであった。","tok":[["彼","かれ"],["ら"],["は"],["都","と"],["に"],["入る","はいる"],["と"],["、"],["泊まって","とまって"],["いた"],["家","いえ"],["の"],["上","うえ"],["の"],["部屋","へや"],["に"],["上がった","あがった"],["。"],["それ"],["は"],["、"],["ペトロ"],["、"],["ヨハネ"],["、"],["ヤコブ"],["、"],["アンデレ"],["、"],["フィリポ"],["、"],["トマス"],["、"],["バルトロマイ"],["、"],["マタイ"],["、"],["アルファイ"],["の"],["子","こ"],["ヤコブ"],["、"],["熱心","ねっしん"],["党","とう"],["の"],["シモン"],["、"],["ヤコブ"],["の"],["子","こ"],["ユダ"],["で"],["あった"],["。"]]},{"verse":14,"text":"彼らは皆、婦人たちやイエスの母マリア、またイエスの兄弟たちと心を合わせて熱心に祈っていた。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["婦人","ふじん"],["たち"],["や"],["イエス"],["の"],["母","はは"],["マリア"],["、"],["また"],["イエス"],["の"],["兄弟","きょうだい"],["たち"],["と"],["心","こころ"],["を"],["合わせて","あわせて"],["熱心","ねっしん"],["に"],["祈って","いのって"],["いた"],["。"]]},{"verse":15,"text":"そのころ、ペトロは兄弟たちの中に立って言った。百二十人ほどの人々が一つになっていた。","tok":[["その"],["ころ"],["、"],["ペトロ"],["は"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["に"],["立って","たって"],["言った","いった"],["。"],["百二","ひゃくに"],["十人","じゅうにん"],["ほど"],["の"],["人々","ひとびと"],["が"],["一","ひと"],["つ"],["に"],["なって"],["いた"],["。"]]},{"verse":16,"text":"「兄弟たち、イエスを捕らえた者たちの手引きをしたあのユダについては、聖霊がダビデの口を通して預言しています。この聖書の言葉は、実現しなければならなかったのです。","tok":[["「"],["兄弟","きょうだい"],["たち"],["、"],["イエス"],["を"],["捕らえた","とらえた"],["者","もの"],["たち"],["の"],["手引き","てびき"],["を"],["した"],["あの"],["ユダ"],["について"],["は"],["、"],["聖霊","せいれい"],["が"],["ダビデ"],["の"],["口","くち"],["を"],["通して","とおして"],["預言","よげん"],["して"],["います"],["。"],["この"],["聖書","せいしょ"],["の"],["言葉","ことば"],["は"],["、"],["実現","じつげん"],["しなければ"],["ならなかった"],["の"],["です"],["。"]]},{"verse":17,"text":"ユダはわたしたちの仲間の一人であり、同じ任務を割り当てられていました。","tok":[["ユダ"],["は"],["わたしたち"],["の"],["仲間","なかま"],["の"],["一人","ひとり"],["で"],["あり"],["、"],["同じ","おなじ"],["任務","にんむ"],["を"],["割り当てられて","わりあてられて"],["いました"],["。"]]},{"verse":18,"text":"ところで、このユダは不正を働いて得た報酬で土地を買ったのですが、その地面にまっさかさまに落ちて、体が真ん中から裂け、はらわたがみな出てしまいました。","tok":[["ところ"],["で"],["、"],["この"],["ユダ"],["は"],["不正","ふせい"],["を"],["働いて","はたらいて"],["得た","えた"],["報酬","ほうしゅう"],["で"],["土地","とち"],["を"],["買った","かった"],["の"],["です"],["が"],["、"],["その"],["地面","じめん"],["に"],["まっ"],["さかさま"],["に"],["落ちて","おちて"],["、"],["体","からだ"],["が"],["真ん中","まんなか"],["から"],["裂け","さけ"],["、"],["はらわた"],["が"],["みな"],["出て","でて"],["しまいました"],["。"]]},{"verse":19,"text":"このことはエルサレムに住むすべての人に知れ渡り、その土地は彼らの言葉で『アケルダマ』、つまり、『血の土地』と呼ばれるようになりました。","tok":[["この"],["こと"],["は"],["エルサレム"],["に"],["住む","すむ"],["すべて"],["の"],["人","ひと"],["に"],["知れ渡り","しれわたり"],["、"],["その"],["土地","とち"],["は"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["で"],["『"],["アケルダマ"],["』"],["、"],["つまり"],["、"],["『"],["血","ち"],["の"],["土地","とち"],["』"],["と"],["呼ばれる","よばれる"],["よう"],["に"],["なりました"],["。"]]},{"verse":20,"text":"詩編にはこう書いてあります。『その住まいは荒れ果てよ、そこに住む者はいなくなれ。』また、『その務めは、ほかの人が引き受けるがよい。』","tok":[["詩編","しへん"],["に"],["は"],["こう"],["書いて","かいて"],["あります"],["。"],["『"],["その"],["住まい","すまい"],["は"],["荒れ果てよ","あれはてよ"],["、"],["そこ"],["に"],["住む","すむ"],["者","もの"],["は"],["いなく"],["なれ"],["。"],["』"],["また"],["、"],["『"],["その"],["務め","つとめ"],["は"],["、"],["ほか"],["の"],["人","ひと"],["が"],["引き受ける","ひきうける"],["が"],["よい"],["。"],["』"]]},{"verse":21,"text":"そこで、主イエスがわたしたちと共に生活されていた間、つまり、ヨハネの洗礼のときから始まって、わたしたちを離れて天に上げられた日まで、いつも一緒にいた者の中からだれか一人が、わたしたちに加わって、主の復活の証人になるべきです。」","tok":[["そこ"],["で"],["、"],["主","しゅ"],["イエス"],["が"],["わたしたち"],["と"],["共","とも"],["に"],["生活","せいかつ"],["されて"],["いた"],["間","あいだ"],["、"],["つまり"],["、"],["ヨハネ"],["の"],["洗礼","せんれい"],["の"],["とき"],["から"],["始まって","はじまって"],["、"],["わたしたち"],["を"],["離れて","はなれて"],["天","てん"],["に"],["上げられた","あげられた"],["日","ひ"],["まで"],["、"],["いつも"],["一緒","いっしょ"],["に"],["いた"],["者","もの"],["の"],["中","なか"],["から"],["だれ"],["か"],["一人","ひとり"],["が"],["、"],["わたしたち"],["に"],["加わって","くわわって"],["、"],["主","ぬし"],["の"],["復活","ふっかつ"],["の"],["証人","しょうにん"],["に"],["なるべきです"],["。"],["」"]]},{"verse":23,"text":"そこで人々は、バルサバと呼ばれ、ユストともいうヨセフと、マティアの二人を立てて、","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["、"],["バルサバ"],["と"],["呼ばれ","よばれ"],["、"],["ユスト"],["と"],["も"],["いう"],["ヨセフ"],["と"],["、"],["マティア"],["の"],["二人","ふたり"],["を"],["立てて","たてて"],["、"]]},{"verse":24,"text":"次のように祈った。「すべての人の心をご存じである主よ、この二人のうちのどちらをお選びになったかを、お示しください。","tok":[["次","つぎ"],["の"],["よう"],["に"],["祈った","いのった"],["。"],["「"],["すべて"],["の"],["人","ひと"],["の"],["心","こころ"],["を"],["ご存じ","ごぞんじ"],["で"],["ある"],["主","ぬし"],["よ"],["、"],["この"],["二人","ふたり"],["の"],["うち"],["の"],["どちら"],["を"],["お選び","おえらび"],["に"],["なった"],["か"],["を"],["、"],["お示し","おしめし"],["ください"],["。"]]},{"verse":25,"text":"ユダが自分の行くべき所に行くために離れてしまった、使徒としてのこの任務を継がせるためです。」","tok":[["ユダ"],["が"],["自分","じぶん"],["の"],["行くべき","いくべき"],["所","ところ"],["に"],["行く","いく"],["ため"],["に"],["離れて","はなれて"],["しまった"],["、"],["使徒","しと"],["として"],["の"],["この"],["任務","にんむ"],["を"],["継がせる","つがせる"],["ため"],["です"],["。"],["」"]]},{"verse":26,"text":"二人のことでくじを引くと、マティアに当たったので、この人が十一人の使徒の仲間に加えられることになった。","tok":[["二人","ふたり"],["の"],["こと"],["で"],["くじ"],["を"],["引く","ひく"],["と"],["、"],["マティア"],["に"],["当たった","あたった"],["ので"],["、"],["この"],["人","ひと"],["が"],["十一人","じゅういちにん"],["の"],["使徒","しと"],["の"],["仲間","なかま"],["に"],["加えられる","くわえられる"],["こと"],["に"],["なった"],["。"]]}]
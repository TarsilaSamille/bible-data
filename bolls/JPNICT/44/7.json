[{"verse":1,"text":"大祭司が、「訴えのとおりか」と尋ねた。","tok":[["大","だい"],["祭司","さいし"],["が"],["、"],["「"],["訴え","うったえ"],["の"],["とおり"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":2,"text":"そこで、ステファノは言った。「兄弟であり父である皆さん、聞いてください。わたしたちの父アブラハムがメソポタミアにいて、まだハランに住んでいなかったとき、栄光の神が現れ、","tok":[["そこ"],["で"],["、"],["ステファノ"],["は"],["言った","いった"],["。"],["「"],["兄弟","きょうだい"],["で"],["あり"],["父","ちち"],["で"],["ある"],["皆","みな"],["さん"],["、"],["聞いて","きいて"],["ください"],["。"],["わたしたち"],["の"],["父","ちち"],["アブラハム"],["が"],["メソポタミア"],["に"],["いて"],["、"],["まだ"],["ハラン"],["に"],["住んで","すんで"],["いなかった"],["とき"],["、"],["栄光","えいこう"],["の"],["神","かみ"],["が"],["現れ","あらわれ"],["、"]]},{"verse":3,"text":"『あなたの土地と親族を離れ、わたしが示す土地に行け』と言われました。","tok":[["『"],["あなた"],["の"],["土地","とち"],["と"],["親族","しんぞく"],["を"],["離れ","はなれ"],["、"],["わたし"],["が"],["示す","しめす"],["土地","とち"],["に"],["行け","いけ"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":4,"text":"それで、アブラハムはカルデア人の土地を出て、ハランに住みました。神はアブラハムを、彼の父が死んだ後、ハランから今あなたがたの住んでいる土地にお移しになりましたが、","tok":[["それ"],["で"],["、"],["アブラハム"],["は"],["カルデア"],["人","にん"],["の"],["土地","とち"],["を"],["出て","でて"],["、"],["ハラン"],["に"],["住みました","すみました"],["。"],["神","かみ"],["は"],["アブラハム"],["を"],["、"],["彼","かれ"],["の"],["父","ちち"],["が"],["死んだ","しんだ"],["後","あと"],["、"],["ハラン"],["から"],["今","いま"],["あなた"],["がた"],["の"],["住んで","すんで"],["いる"],["土地","とち"],["に"],["お移し","おうつし"],["に"],["なりました"],["が"],["、"]]},{"verse":5,"text":"そこでは財産を何もお与えになりませんでした、一歩の幅の土地さえも。しかし、そのとき、まだ子供のいなかったアブラハムに対して、『いつかその土地を所有地として与え、死後には子孫たちに相続させる』と約束なさったのです。","tok":[["そこ"],["で"],["は"],["財産","ざいさん"],["を"],["何","なん"],["も"],["お与え","おあたえ"],["に"],["なりませんでした"],["、"],["一","いち"],["歩","ほ"],["の"],["幅","はば"],["の"],["土地","とち"],["さえ"],["も"],["。"],["しかし"],["、"],["その"],["とき"],["、"],["まだ"],["子供","こども"],["の"],["いなかった"],["アブラハム"],["に対して","にたいして"],["、"],["『"],["いつ"],["か"],["その"],["土地","とち"],["を"],["所有地","しょゆうち"],["として"],["与え","あたえ"],["、"],["死後","しご"],["に"],["は"],["子孫","しそん"],["たち"],["に"],["相続","そうぞく"],["させる"],["』"],["と"],["約束","やくそく"],["なさった"],["の"],["です"],["。"]]},{"verse":6,"text":"神はこう言われました。『彼の子孫は、外国に移住し、四百年の間、奴隷にされて虐げられる。』","tok":[["神","かみ"],["は"],["こう"],["言われました","いわれました"],["。"],["『"],["彼","かれ"],["の"],["子孫","しそん"],["は"],["、"],["外国","がいこく"],["に"],["移住","いじゅう"],["し"],["、"],["四百","よんひゃく"],["年","ねん"],["の"],["間","あいだ"],["、"],["奴隷","どれい"],["に"],["されて"],["虐げられる","しいたげられる"],["。"],["』"]]},{"verse":7,"text":"更に、神は言われました。『彼らを奴隷にする国民は、わたしが裁く。その後、彼らはその国から脱出し、この場所でわたしを礼拝する。』","tok":[["更に","さらに"],["、"],["神","かみ"],["は"],["言われました","いわれました"],["。"],["『"],["彼","かれ"],["ら"],["を"],["奴隷","どれい"],["に"],["する"],["国民","こくみん"],["は"],["、"],["わたし"],["が"],["裁く","さばく"],["。"],["その"],["後","ご"],["、"],["彼","かれ"],["ら"],["は"],["その"],["国","くに"],["から"],["脱出","だっしゅつ"],["し"],["、"],["この"],["場所","ばしょ"],["で"],["わたし"],["を"],["礼拝","れいはい"],["する"],["。"],["』"]]},{"verse":8,"text":"そして、神はアブラハムと割礼による契約を結ばれました。こうして、アブラハムはイサクをもうけて八日目に割礼を施し、イサクはヤコブを、ヤコブは十二人の族長をもうけて、それぞれ割礼を施したのです。","tok":[["そして"],["、"],["神","かみ"],["は"],["アブラハム"],["と"],["割礼","かつれい"],["に"],["よる"],["契約","けいやく"],["を"],["結ばれました","むすばれました"],["。"],["こう"],["して"],["、"],["アブラハム"],["は"],["イサク"],["を"],["もうけて"],["八日目","ようかめ"],["に"],["割礼","かつれい"],["を"],["施し","ほどこし"],["、"],["イサク"],["は"],["ヤコブ"],["を"],["、"],["ヤコブ"],["は"],["十二人","じゅうににん"],["の"],["族長","ぞくちょう"],["を"],["もうけて"],["、"],["それぞれ"],["割礼","かつれい"],["を"],["施した","ほどこした"],["の"],["です"],["。"]]},{"verse":9,"text":"この族長たちはヨセフをねたんで、エジプトへ売ってしまいました。しかし、神はヨセフを離れず、","tok":[["この"],["族長","ぞくちょう"],["たち"],["は"],["ヨセフ"],["を"],["ねたんで"],["、"],["エジプト"],["へ"],["売って","うって"],["しまいました"],["。"],["しかし"],["、"],["神","かみ"],["は"],["ヨセフ"],["を"],["離れず","はなれず"],["、"]]},{"verse":10,"text":"あらゆる苦難から助け出して、エジプト王ファラオのもとで恵みと知恵をお授けになりました。そしてファラオは、彼をエジプトと王の家全体とをつかさどる大臣に任命したのです。","tok":[["あらゆる"],["苦難","くなん"],["から"],["助け出して","たすけだして"],["、"],["エジプト"],["王","おう"],["ファラオ"],["の"],["もと"],["で"],["恵み","めぐみ"],["と"],["知恵","ちえ"],["を"],["お授け","おさずけ"],["に"],["なりました"],["。"],["そして"],["ファラオ"],["は"],["、"],["彼","かれ"],["を"],["エジプト"],["と"],["王","おう"],["の"],["家","いえ"],["全体","ぜんたい"],["と"],["を"],["つかさどる"],["大臣","だいじん"],["に"],["任命","にんめい"],["した"],["の"],["です"],["。"]]},{"verse":11,"text":"ところが、エジプトとカナンの全土に飢饉が起こり、大きな苦難が襲い、わたしたちの先祖は食糧を手に入れることができなくなりました。","tok":[["ところ"],["が"],["、"],["エジプト"],["と"],["カナン"],["の"],["全土","ぜんど"],["に"],["飢饉","ききん"],["が"],["起こり","おこり"],["、"],["大きな","おおきな"],["苦難","くなん"],["が"],["襲い","おそい"],["、"],["わたしたち"],["の"],["先祖","せんぞ"],["は"],["食糧","しょくりょう"],["を"],["手","て"],["に"],["入れる","いれる"],["こと"],["が"],["できなく"],["なりました"],["。"]]},{"verse":12,"text":"ヤコブはエジプトに穀物があると聞いて、まずわたしたちの先祖をそこへ行かせました。","tok":[["ヤコブ"],["は"],["エジプト"],["に"],["穀物","こくもつ"],["が"],["ある"],["と"],["聞いて","きいて"],["、"],["まず"],["わたしたち"],["の"],["先祖","せんぞ"],["を"],["そこ"],["へ"],["行かせました","いかせました"],["。"]]},{"verse":13,"text":"二度目のとき、ヨセフは兄弟たちに自分の身の上を明かし、ファラオもヨセフの一族のことを知りました。","tok":[["二度目","にどめ"],["の"],["とき"],["、"],["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["自分","じぶん"],["の"],["身の上","みのうえ"],["を"],["明かし","あかし"],["、"],["ファラオ"],["も"],["ヨセフ"],["の"],["一族","いちぞく"],["の"],["こと"],["を"],["知りました","しりました"],["。"]]},{"verse":14,"text":"そこで、ヨセフは人を遣わして、父ヤコブと七十五人の親族一同を呼び寄せました。","tok":[["そこ"],["で"],["、"],["ヨセフ"],["は"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["父","ちち"],["ヤコブ"],["と"],["七十五人","ななじゅうごにん"],["の"],["親族","しんぞく"],["一同","いちどう"],["を"],["呼び寄せました","よびよせました"],["。"]]},{"verse":15,"text":"ヤコブはエジプトに下って行き、やがて彼もわたしたちの先祖も死んで、","tok":[["ヤコブ"],["は"],["エジプト"],["に"],["下って","くだって"],["行き","いき"],["、"],["やがて"],["彼","かれ"],["も"],["わたしたち"],["の"],["先祖","せんぞ"],["も"],["死んで","しんで"],["、"]]},{"verse":16,"text":"シケムに移され、かつてアブラハムがシケムでハモルの子らから、幾らかの金で買っておいた墓に葬られました。","tok":[["シケム"],["に"],["移され","うつされ"],["、"],["かつて"],["アブラハム"],["が"],["シケム"],["で"],["ハモル"],["の"],["子","こ"],["ら"],["から"],["、"],["幾ら","いくら"],["か"],["の"],["金","かね"],["で"],["買って","かって"],["おいた"],["墓","はか"],["に"],["葬られました","ほうむられました"],["。"]]},{"verse":17,"text":"神がアブラハムになさった約束の実現する時が近づくにつれ、民は増え、エジプト中に広がりました。","tok":[["神","かみ"],["が"],["アブラハム"],["に"],["なさった"],["約束","やくそく"],["の"],["実現","じつげん"],["する"],["時","とき"],["が"],["近づく","ちかづく"],["に"],["つれ"],["、"],["民","みん"],["は"],["増え","ふえ"],["、"],["エジプト"],["中","ちゅう"],["に"],["広がりました","ひろがりました"],["。"]]},{"verse":18,"text":"それは、ヨセフのことを知らない別の王が、エジプトの支配者となるまでのことでした。","tok":[["それ"],["は"],["、"],["ヨセフ"],["の"],["こと"],["を"],["知らない","しらない"],["別","べつ"],["の"],["王","おう"],["が"],["、"],["エジプト"],["の"],["支配者","しはいしゃ"],["と"],["なる"],["まで"],["の"],["こと"],["でした"],["。"]]},{"verse":19,"text":"この王は、わたしたちの同胞を欺き、先祖を虐待して乳飲み子を捨てさせ、生かしておかないようにしました。","tok":[["この"],["王","おう"],["は"],["、"],["わたしたち"],["の"],["同胞","どうほう"],["を"],["欺き","あざむき"],["、"],["先祖","せんぞ"],["を"],["虐待","ぎゃくたい"],["して"],["乳飲み子","ちのみご"],["を"],["捨てさせ","すてさせ"],["、"],["生かして","いかして"],["おかない"],["よう"],["に"],["しました"],["。"]]},{"verse":20,"text":"このときに、モーセが生まれたのです。神の目に適った美しい子で、三か月の間、父の家で育てられ、","tok":[["この"],["とき"],["に"],["、"],["モーセ"],["が"],["生まれた","うまれた"],["の"],["です"],["。"],["神","かみ"],["の"],["目","め"],["に"],["適った","かなった"],["美しい","うつくしい"],["子","こ"],["で"],["、"],["三","さん"],["か月","かげつ"],["の"],["間","あいだ"],["、"],["父","ちち"],["の"],["家","いえ"],["で"],["育てられ","そだてられ"],["、"]]},{"verse":21,"text":"その後、捨てられたのをファラオの王女が拾い上げ、自分の子として育てたのです。","tok":[["その"],["後","ご"],["、"],["捨てられた","すてられた"],["の"],["を"],["ファラオ"],["の"],["王女","おうじょ"],["が"],["拾い上げ","ひろいあげ"],["、"],["自分","じぶん"],["の"],["子","こ"],["として"],["育てた","そだてた"],["の"],["です"],["。"]]},{"verse":22,"text":"そして、モーセはエジプト人のあらゆる教育を受け、すばらしい話や行いをする者になりました。","tok":[["そして"],["、"],["モーセ"],["は"],["エジプト"],["人","にん"],["の"],["あらゆる"],["教育","きょういく"],["を"],["受け","うけ"],["、"],["すばらしい"],["話","はなし"],["や"],["行い","おこない"],["を"],["する"],["者","もの"],["に"],["なりました"],["。"]]},{"verse":23,"text":"四十歳になったとき、モーセは兄弟であるイスラエルの子らを助けようと思い立ちました。","tok":[["四十歳","よんじゅうさい"],["に"],["なった"],["とき"],["、"],["モーセ"],["は"],["兄弟","きょうだい"],["で"],["ある"],["イスラエル"],["の"],["子","こ"],["ら"],["を"],["助けよう","たすけよう"],["と"],["思い立ちました","おもいたちました"],["。"]]},{"verse":24,"text":"それで、彼らの一人が虐待されているのを見て助け、相手のエジプト人を打ち殺し、ひどい目に遭っていた人のあだを討ったのです。","tok":[["それ"],["で"],["、"],["彼","かれ"],["ら"],["の"],["一人","ひとり"],["が"],["虐待","ぎゃくたい"],["されて"],["いる"],["の"],["を"],["見て","みて"],["助け","たすけ"],["、"],["相手","あいて"],["の"],["エジプト"],["人","にん"],["を"],["打ち殺し","うちころし"],["、"],["ひどい"],["目","め"],["に"],["遭って","あって"],["いた"],["人","ひと"],["の"],["あだ"],["を"],["討った","うった"],["の"],["です"],["。"]]},{"verse":25,"text":"モーセは、自分の手を通して神が兄弟たちを救おうとしておられることを、彼らが理解してくれると思いました。しかし、理解してくれませんでした。","tok":[["モーセ"],["は"],["、"],["自分","じぶん"],["の"],["手","て"],["を"],["通して","とおして"],["神","かみ"],["が"],["兄弟","きょうだい"],["たち"],["を"],["救おう","すくおう"],["として"],["おられる"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["が"],["理解","りかい"],["して"],["くれる"],["と"],["思いました","おもいました"],["。"],["しかし"],["、"],["理解","りかい"],["して"],["くれませんでした"],["。"]]},{"verse":26,"text":"次の日、モーセはイスラエル人が互いに争っているところに来合わせたので、仲直りをさせようとして言いました。『君たち、兄弟どうしではないか。なぜ、傷つけ合うのだ。』","tok":[["次","つぎ"],["の"],["日","ひ"],["、"],["モーセ"],["は"],["イスラエル"],["人","にん"],["が"],["互い","たがい"],["に"],["争って","あらそって"],["いる"],["ところ"],["に"],["来合わせた","きあわせた"],["ので"],["、"],["仲直り","なかなおり"],["を"],["させよう"],["として"],["言いました","いいました"],["。"],["『"],["君","きみ"],["たち"],["、"],["兄弟","きょうだい"],["どうし"],["で"],["は"],["ない"],["か"],["。"],["なぜ"],["、"],["傷つけ","きずつけ"],["合う","あう"],["の"],["だ"],["。"],["』"]]},{"verse":27,"text":"すると、仲間を痛めつけていた男は、モーセを突き飛ばして言いました。『だれが、お前を我々の指導者や裁判官にしたのか。","tok":[["する"],["と"],["、"],["仲間","なかま"],["を"],["痛めつけて","いためつけて"],["いた"],["男","おとこ"],["は"],["、"],["モーセ"],["を"],["突き飛ばして","つきとばして"],["言いました","いいました"],["。"],["『"],["だれ"],["が"],["、"],["お前","おまえ"],["を"],["我々","われわれ"],["の"],["指導者","しどうしゃ"],["や"],["裁判官","さいばんかん"],["に"],["した"],["の"],["か"],["。"]]},{"verse":28,"text":"きのうエジプト人を殺したように、わたしを殺そうとするのか。』","tok":[["きのう"],["エジプト"],["人","にん"],["を"],["殺した","ころした"],["よう"],["に"],["、"],["わたし"],["を"],["殺そう","ころそう"],["と"],["する"],["の"],["か"],["。"],["』"]]},{"verse":29,"text":"モーセはこの言葉を聞いて、逃げ出し、そして、ミディアン地方に身を寄せている間に、二人の男の子をもうけました。","tok":[["モーセ"],["は"],["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["、"],["逃げ出し","にげだし"],["、"],["そして"],["、"],["ミディアン"],["地方","ちほう"],["に"],["身","み"],["を"],["寄せて","よせて"],["いる"],["間","あいだ"],["に"],["、"],["二人","ふたり"],["の"],["男の子","おとこのこ"],["を"],["もうけました"],["。"]]},{"verse":30,"text":"四十年たったとき、シナイ山に近い荒れ野において、柴の燃える炎の中で、天使がモーセの前に現れました。","tok":[["四十","よんじゅう"],["年","ねん"],["たった"],["とき"],["、"],["シナイ"],["山","やま"],["に"],["近い","ちかい"],["荒れ野","あれの"],["に"],["
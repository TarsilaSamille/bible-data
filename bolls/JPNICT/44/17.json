[{"verse":1,"text":"パウロとシラスは、アンフィポリスとアポロニアを経てテサロニケに着いた。ここにはユダヤ人の会堂があった。","tok":[["パウロ"],["と"],["シラス"],["は"],["、"],["アンフィポリス"],["と"],["アポロニア"],["を"],["経て","へて"],["テサロニケ"],["に"],["着いた","ついた"],["。"],["ここ"],["に"],["は"],["ユダヤ人","ゆだやじん"],["の"],["会堂","かいどう"],["が"],["あった"],["。"]]},{"verse":2,"text":"パウロはいつものように、ユダヤ人の集まっているところへ入って行き、三回の安息日にわたって聖書を引用して論じ合い、","tok":[["パウロ"],["は"],["いつも"],["の"],["よう"],["に"],["、"],["ユダヤ人","ゆだやじん"],["の"],["集まって","あつまって"],["いる"],["ところ"],["へ"],["入って","はいって"],["行き","いき"],["、"],["三","さん"],["回","かい"],["の"],["安息日","あんそくび"],["に"],["わたって"],["聖書","せいしょ"],["を"],["引用","いんよう"],["して"],["論じ合い","ろんじあい"],["、"]]},{"verse":3,"text":"「メシアは必ず苦しみを受け、死者の中から復活することになっていた」と、また、「このメシアはわたしが伝えているイエスである」と説明し、論証した。","tok":[["「"],["メシア"],["は"],["必ず","かならず"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["する"],["こと"],["に"],["なって"],["いた"],["」"],["と"],["、"],["また"],["、"],["「"],["この"],["メシア"],["は"],["わたし"],["が"],["伝えて","つたえて"],["いる"],["イエス"],["で"],["ある"],["」"],["と"],["説明","せつめい"],["し"],["、"],["論証","ろんしょう"],["した"],["。"]]},{"verse":4,"text":"それで、彼らのうちのある者は信じて、パウロとシラスに従った。神をあがめる多くのギリシア人や、かなりの数のおもだった婦人たちも同じように二人に従った。","tok":[["それ"],["で"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["ある"],["者","もの"],["は"],["信じて","しんじて"],["、"],["パウロ"],["と"],["シラス"],["に"],["従った","したがった"],["。"],["神","かみ"],["を"],["あがめる"],["多く","おおく"],["の"],["ギリシア"],["人","にん"],["や"],["、"],["かなり"],["の"],["数","かず"],["の"],["おも"],["だった"],["婦人","ふじん"],["たち"],["も"],["同じ","おなじ"],["よう"],["に"],["二人","ふたり"],["に"],["従った","したがった"],["。"]]},{"verse":5,"text":"しかし、ユダヤ人たちはそれをねたみ、広場にたむろしているならず者を何人か抱き込んで暴動を起こし、町を混乱させ、ヤソンの家を襲い、二人を民衆の前に引き出そうとして捜した。","tok":[["しかし"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["それ"],["を"],["ねたみ"],["、"],["広場","ひろば"],["に"],["たむろ"],["して"],["いる"],["ならず者","ならずもの"],["を"],["何人","なんにん"],["か"],["抱き込んで","だきこんで"],["暴動","ぼうどう"],["を"],["起こし","おこし"],["、"],["町","まち"],["を"],["混乱","こんらん"],["させ"],["、"],["ヤソン"],["の"],["家","いえ"],["を"],["襲い","おそい"],["、"],["二人","ふたり"],["を"],["民衆","みんしゅう"],["の"],["前","まえ"],["に"],["引き出そう","ひきだそう"],["として"],["捜した","さがした"],["。"]]},{"verse":6,"text":"しかし、二人が見つからなかったので、ヤソンと数人の兄弟を町の当局者たちのところへ引き立てて行って、大声で言った。「世界中を騒がせてきた連中が、ここにも来ています。","tok":[["しかし"],["、"],["二人","ふたり"],["が"],["見つからなかった","みつからなかった"],["ので"],["、"],["ヤソン"],["と"],["数人","かずひと"],["の"],["兄弟","きょうだい"],["を"],["町","まち"],["の"],["当局者","とうきょくしゃ"],["たち"],["の"],["ところ"],["へ"],["引き立てて","ひきたてて"],["行って","いって"],["、"],["大声","おおごえ"],["で"],["言った","いった"],["。"],["「"],["世界中","せかいじゅう"],["を"],["騒がせて","さわがせて"],["きた"],["連中","れんちゅう"],["が"],["、"],["ここ"],["に"],["も"],["来て","きて"],["います"],["。"]]},{"verse":7,"text":"ヤソンは彼らをかくまっているのです。彼らは皇帝の勅令に背いて、『イエスという別の王がいる』と言っています。」","tok":[["ヤソン"],["は"],["彼","かれ"],["ら"],["を"],["かくまって"],["いる"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["皇帝","こうてい"],["の"],["勅令","ちょくれい"],["に"],["背いて","そむいて"],["、"],["『"],["イエス"],["と"],["いう"],["別","べつ"],["の"],["王","おう"],["が"],["いる"],["』"],["と"],["言って","いって"],["います"],["。"],["」"]]},{"verse":8,"text":"これを聞いた群衆と町の当局者たちは動揺した。","tok":[["これ"],["を"],["聞いた","きいた"],["群衆","ぐんしゅう"],["と"],["町","まち"],["の"],["当局者","とうきょくしゃ"],["たち"],["は"],["動揺","どうよう"],["した"],["。"]]},{"verse":9,"text":"当局者たちは、ヤソンやほかの者たちから保証金を取ったうえで彼らを釈放した。","tok":[["当局者","とうきょくしゃ"],["たち"],["は"],["、"],["ヤソン"],["や"],["ほか"],["の"],["者","もの"],["たち"],["から"],["保証金","ほしょうきん"],["を"],["取った","とった"],["うえ"],["で"],["彼","かれ"],["ら"],["を"],["釈放","しゃくほう"],["した"],["。"]]},{"verse":10,"text":"兄弟たちは、直ちに夜のうちにパウロとシラスをベレアへ送り出した。二人はそこへ到着すると、ユダヤ人の会堂に入った。","tok":[["兄弟","きょうだい"],["たち"],["は"],["、"],["直ちに","ただちに"],["夜","よる"],["の"],["うち"],["に"],["パウロ"],["と"],["シラス"],["を"],["ベレア"],["へ"],["送り出した","おくりだした"],["。"],["二人","ふたり"],["は"],["そこ"],["へ"],["到着","とうちゃく"],["する"],["と"],["、"],["ユダヤ人","ゆだやじん"],["の"],["会堂","かいどう"],["に"],["入った","はいった"],["。"]]},{"verse":11,"text":"ここのユダヤ人たちは、テサロニケのユダヤ人よりも素直で、非常に熱心に御言葉を受け入れ、そのとおりかどうか、毎日、聖書を調べていた。","tok":[["ここ"],["の"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["テサロニケ"],["の"],["ユダヤ人","ゆだやじん"],["より"],["も"],["素直","すなお"],["で"],["、"],["非常","ひじょう"],["に"],["熱心","ねっしん"],["に"],["御言葉","おことば"],["を"],["受け入れ","うけいれ"],["、"],["その"],["とおり"],["か"],["どう"],["か"],["、"],["毎日","まいにち"],["、"],["聖書","せいしょ"],["を"],["調べて","しらべて"],["いた"],["。"]]},{"verse":12,"text":"そこで、そのうちの多くの人が信じ、ギリシア人の上流婦人や男たちも少なからず信仰に入った。","tok":[["そこ"],["で"],["、"],["その"],["うち"],["の"],["多く","おおく"],["の"],["人","ひと"],["が"],["信じ","しんじ"],["、"],["ギリシア"],["人","にん"],["の"],["上流","じょうりゅう"],["婦人","ふじん"],["や"],["男","おとこ"],["たち"],["も"],["少なからず","すくなからず"],["信仰","しんこう"],["に"],["入った","はいった"],["。"]]},{"verse":13,"text":"ところが、テサロニケのユダヤ人たちは、ベレアでもパウロによって神の言葉が宣べ伝えられていることを知ると、そこへも押しかけて来て、群衆を扇動し騒がせた。","tok":[["ところ"],["が"],["、"],["テサロニケ"],["の"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["ベレア"],["で"],["も"],["パウロ"],["によって"],["神","かみ"],["の"],["言葉","ことば"],["が"],["宣べ伝えられて","のべつたえられて"],["いる"],["こと"],["を"],["知る","しる"],["と"],["、"],["そこ"],["へ"],["も"],["押しかけて","おしかけて"],["来て","きて"],["、"],["群衆","ぐんしゅう"],["を"],["扇動","せんどう"],["し"],["騒がせた","さわがせた"],["。"]]},{"verse":14,"text":"それで、兄弟たちは直ちにパウロを送り出して、海岸の地方へ行かせたが、シラスとテモテはベレアに残った。","tok":[["それ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["は"],["直ちに","ただちに"],["パウロ"],["を"],["送り出して","おくりだして"],["、"],["海岸","かいがん"],["の"],["地方","ちほう"],["へ"],["行かせた","いかせた"],["が"],["、"],["シラス"],["と"],["テモテ"],["は"],["ベレア"],["に"],["残った","のこった"],["。"]]},{"verse":15,"text":"パウロに付き添った人々は、彼をアテネまで連れて行った。そしてできるだけ早く来るようにという、シラスとテモテに対するパウロの指示を受けて帰って行った。","tok":[["パウロ"],["に"],["付き添った","つきそった"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["を"],["アテネ"],["まで"],["連れて","つれて"],["行った","いった"],["。"],["そして"],["できる"],["だけ"],["早く","はやく"],["来る","くる"],["よう"],["に"],["と"],["いう"],["、"],["シラス"],["と"],["テモテ"],["に"],["対する","たいする"],["パウロ"],["の"],["指示","しじ"],["を"],["受けて","うけて"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":16,"text":"パウロはアテネで二人を待っている間に、この町の至るところに偶像があるのを見て憤慨した。","tok":[["パウロ"],["は"],["アテネ"],["で"],["二人","ふたり"],["を"],["待って","まって"],["いる"],["間","あいだ"],["に"],["、"],["この"],["町","まち"],["の"],["至る","いたる"],["ところ"],["に"],["偶像","ぐうぞう"],["が"],["ある"],["の"],["を"],["見て","みて"],["憤慨","ふんがい"],["した"],["。"]]},{"verse":17,"text":"それで、会堂ではユダヤ人や神をあがめる人々と論じ、また、広場では居合わせた人々と毎日論じ合っていた。","tok":[["それ"],["で"],["、"],["会堂","かいどう"],["で"],["は"],["ユダヤ人","ゆだやじん"],["や"],["神","かみ"],["を"],["あがめる"],["人々","ひとびと"],["と"],["論じ","ろんじ"],["、"],["また"],["、"],["広場","ひろば"],["で"],["は"],["居合わせた","いあわせた"],["人々","ひとびと"],["と"],["毎日","まいにち"],["論じ合って","ろんじあって"],["いた"],["。"]]},{"verse":18,"text":"また、エピクロス派やストア派の幾人かの哲学者もパウロと討論したが、その中には、「このおしゃべりは、何を言いたいのだろうか」と言う者もいれば、「彼は外国の神々の宣伝をする者らしい」と言う者もいた。パウロが、イエスと復活について福音を告げ知らせていたからである。","tok":[["また"],["、"],["エピクロス"],["派","は"],["や"],["ストア派","すとあは"],["の"],["幾人","いくにん"],["か"],["の"],["哲学者","てつがくしゃ"],["も"],["パウロ"],["と"],["討論","とうろん"],["した"],["が"],["、"],["その"],["中","なか"],["に"],["は"],["、"],["「"],["この"],["おしゃべり"],["は"],["、"],["何","なん"],["を"],["言いたい","いいたい"],["の"],["だろう"],["か"],["」"],["と"],["言う","いう"],["者","もの"],["も"],["いれば"],["、"],["「"],["彼","かれ"],["は"],["外国","がいこく"],["の"],["神々","かみがみ"],["の"],["宣伝","せんでん"],["を"],["する"],["者","もの"],["らしい"],["」"],["と"],["言う","いう"],["者","もの"],["も"],["いた"],["。"],["パウロ"],["が"],["、"],["イエス"],["と"],["復活","ふっかつ"],["について"],["福音","ふくいん"],["を"],["告げ知らせて","つげしらせて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"そこで、彼らはパウロをアレオパゴスに連れて行き、こう言った。「あなたが説いているこの新しい教えがどんなものか、知らせてもらえないか。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["パウロ"],["を"],["アレオパゴス"],["に"],["連れて","つれて"],["行き","いき"],["、"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["が"],["説いて","といて"],["いる"],["この"],["新しい","あたらしい"],["教え","おしえ"],["が"],["どんな"],["もの"],["か"],["、"],["知らせて","しらせて"],["もらえない"],["か"],["。"]]},{"verse":20,"text":"奇妙なことをわたしたちに聞かせているが、それがどんな意味なのか知りたいのだ。」","tok":[["奇妙","きみょう"],["な"],["こと"],["を"],["わたしたち"],["に"],["聞かせて","きかせて"],["いる"],["が"],["、"],["それ"],["が"],["どんな"],["意味","いみ"],["な"],["の"],["か"],["知りたい","しりたい"],["の"],["だ"],["。"],["」"]]},{"verse":21,"text":"すべてのアテネ人やそこに在留する外国人は、何か新しいことを話したり聞いたりすることだけで、時を過ごしていたのである。","tok":[["すべて"],["の"],["アテネ人","あてねにん"],["や"],["そこ"],["に"],["在留","ざいりゅう"],["する"],["外国人","がいこくじん"],["は"],["、"],["何","なん"],["か"],["新しい","あたらしい"],["こと"],["を"],["話し","はなし"],["たり"],["聞い","きい"],["たり"],["する"],["こと"],["だけ"],["で"],["、"],["時","とき"],["を"],["過ごして","すごして"],["いた"],["ので"],["ある"],["。"]]},{"verse":22,"text":"パウロは、アレオパゴスの真ん中に立って言った。「アテネの皆さん、あらゆる点においてあなたがたが信仰のあつい方であることを、わたしは認めます。","tok":[["パウロ"],["は"],["、"],["アレオパゴス"],["の"],["真ん中","まんなか"],["に"],["立って","たって"],["言った","いった"],["。"],["「"],["アテネ"],["の"],["皆","みな"],["さん"],["、"],["あらゆる"],["点","てん"],["に"],["おいて"],["あなた"],["がた"],["が"],["信仰","しんこう"],["の"],["あつい"],["方","ほう"],["で"],["ある"],["こと"],["を"],["、"],["わたし"],["は"],["認めます","みとめます"],["。"]]},{"verse":23,"text":"道を歩きながら、あなたがたが拝むいろいろなものを見ていると、『知られざる神に』と刻まれている祭壇さえ見つけたからです。それで、あなたがたが知らずに拝んでいるもの、それをわたしはお知らせしましょう。","tok":[["道","みち"],["を"],["歩き","あるき"],["ながら"],["、"],["あなた"],["がた"],["が"],["拝む","おがむ"],["いろいろ"],["な"],["もの"],["を"],["見て","みて"],["いる"],["と"],["、"],["『"],["知られざる","しられざる"],["神","かみ"],["に"],["』"],["と"],["刻まれて","きざまれて"],["いる"],["祭壇","さいだん"],["さえ"],["見つけた","みつけた"],["から"],["です"],["。"],["それ"],["で"],["、"],["あなた"],["がた"],["が"],["知らず","しらず"],["に"],["拝んで","おがんで"],["いる"],["もの"],["、"],["それ"],["を"],["わたし"],["は"],["お知らせ","おしらせ"],["しましょう"],["。"]]},{"verse":24,"text":"世界とその中の万物とを造られた神が、その方です。この神は天地の主ですから、手で造った神殿などにはお住みになりません。","tok":[["世界","せかい"],["と"],["その"],["中","なか"],["の"],["万物","ばんぶつ"],["と"],["を"],["造られた","つくられた"],["神","かみ"],["が"],["、"],["その"],["方","ほう"],["です"],["。"],["この"],["神","かみ"],["は"],["天地","てんち"],["の"],["主","ぬし"],["です"],["から"],["、"],["手","て"],["で"],["造った","つくった"],["神殿","しんでん"],["など"],["に"],["は"],["お住み","おすみ"],["に"],["なりません"],["。"]]},{"verse":25,"text":"また、何か足りないことでもあるかのように、人の手によって仕えてもらう必要もありません。すべての人に命と息と、その他すべてのものを与えてくださるのは、この神だからです。","tok":[["また"],["、"],["何","なん"],["か"],["足りない","たりない"],["こと"],["で"],["も"],["ある"],["か"],["の"],["よう"],["に"],["、"],["人","ひと"],["の"],["手","て"],["によって"],["仕えて","つかえて"],["もらう"],["必要","ひつよう"],["も"],["ありません"],["。"],["すべて"],["の"],["人","ひと"],["に"],["命","いのち"],["と"],["息","いき"],["と"],["、"],["その"],["他","た"],["すべて"],["の"],["もの"],["を"],["与えて","あたえて"],["くださる"],["の"],["は"],["、"],["この"],["神","かみ"],["だ"],["から"],["です"],["。"]]},{"verse":26,"text":"神は、一人の人からすべての民族を造り出して、地上の至るところに住まわせ、季節を決め、彼らの居住地の境界をお決めになりました。","tok":[["神","かみ"],["は"],["、"],["一人","ひとり"],["の"],["人","ひと"],["から"],["すべて"],["の"],["民族","みんぞく"],["を"],["造り出して","つくりだして"],["、"],["地上","ちじょう"],["の"],["至る","いたる"],["ところ"],["に"],["住まわせ","すまわせ"],["、"],["季節","きせつ"],["を"],["決め","きめ"],["、"],["彼","かれ"],["ら"],["の"],["居住地","きょじゅうち"],["の"],["境界","きょうかい"],["を"],["お決め","おきめ"],["に"],["なりました"],["。"]]},{"verse":27,"text":"これは、人に神を求めさせるためであり、また、彼らが探し求めさえすれば、神を見いだすことができるようにということなのです。実際、神はわたしたち一人一人から遠く離れてはおられません。","tok":[["これ"],["は"],["、"],["人","ひと"],["に"],["神","かみ"],["を"],["求め","もとめ"],["させる"],["ため"],["で"],["あり"],["、"],["また"],["、"],["彼","かれ"],["ら"],["が"],["探し求め","さがしもとめ"],["さえ"],["すれば"],["、"],["神","かみ"],["を"],["見いだす","みいだす"],["こと"],["が"],["できる"],["よう"],["に"],["と"],["いう"],["こと"],["な"],["の"],["です"],["。"],["実際","じっさい"],["、"],["神","かみ"],["は"],["わたしたち"],["一人一人","ひとりひとり"],["から"],["遠く","とおく"],["離れて","はなれて"],["は"],["おられません"],["。"]]},{"verse":28,"text":"皆さんのうちのある詩人たちも、『我らは神の中に生き、動き、存在する』『我らもその子孫である』と、言っているとおりです。","tok":[["皆","みな"],["さん"],["の"],["うち"],["の"],["ある"],["詩人","しじん"],["たち"],["も"],["、"],["『"],["我","われ"],["ら"],["は"],["神","かみ"],["の"],["中","なか"],["に"],["生き","いき"],["、"],["動き","うごき"],["、"],["存在","そんざい"],["する"],["』"],["『"],["我","われ"],["ら"],["も"],["その"],["子孫","しそん"],["で"],["ある"],["』"],["と"],["、"],["言って","いって"],["いる"],["とおり"],["です"],["。"]]},{"verse":29,"text":"わたしたちは神の子孫なのですから、神である方を、人間の技や考えで造った金、銀、石などの像と同じものと考えてはなりません。","tok":[["わたしたち"],["は"],["神","かみ"],["の"],["子孫","しそん"],["な"],["の"],["です"],["から"],["、"],["神","かみ"],["で"],["ある"],["方","かた"],["を"],["、"],["人間","にんげん"],["の"],["技","わざ"],["や"],["考え","かんがえ"],["で"],["造った","つくった"],["金","きん"],["、"],["銀","ぎん"],["、"],["石","いし"],["など"],["の"],["像","ぞう"],["と"],["同じ","おなじ"],["もの"],["と"],["考えて","かんがえて"],["は"],["なりません"],["。"]]},{"verse":30,"text":"さて、神はこのような無知な時代を、大目に見てくださいましたが、今はどこにいる人でも皆悔い改めるようにと、命じておられます。","tok":[["さて"],["、"],["神","かみ"],["は"],["この"],["よう"],["な"],["無知","むち"],["な"],["時代","じだい"],["を"],["、"],["大目","おおめ"],["に"],["見て","みて"],["くださいました"],["が"],["、"],["今","いま"],["は"],["どこ"],["に"],["いる"],["人","ひと"],["で"],["も"],["皆","みな"],["悔い改める","くいあらためる"],["よう"],["に"],["と"],["、"],["命じて","めいじて"],["おられます"],["。"]]},{"verse":31,"text":"それは、先にお選びになった一人の方によって、この世を正しく裁く日をお決めになったからです。神はこの方を死者の中から復活させて、すべての人にそのことの確証をお与えになったのです。」","tok":[["それ"],["は"],["、"],["先","さき"],["に"],["お選び","おえらび"],["に"],["なった"],["一人","ひとり"],["の"],["方","ほう"],["によって"],["、"],["この世","このよ"],["を"],["正しく","ただしく"],["裁く","さばく"],["日","ひ"],["を"],["お決め","おきめ"],["に"],["なった"],["から"],["です"],["。"],["神","かみ"],["は"],["この"],["方","ほう"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させて"],["、"],["すべて"],["の"],["人","ひと"],["に"],["その"],["こと"],["の"],["確証","かくしょう"],["を"],["お与え","おあたえ"],["に"],["なった"],["の"],["です"],["。"],["」"]]},{"verse":32,"text":"死者の復活ということを聞くと、ある者はあざ笑い、ある者は、「それについては、いずれまた聞かせてもらうことにしよう」と言った。","tok":[["死者","ししゃ"],["の"],["復活","ふっかつ"],["と"],["いう"],["こと"],["を"],["聞く","きく"],["と"],["、"],["ある"],["者","もの"],["は"],["あざ笑い","あざわらい"],["、"],["ある"],["者","もの"],["は"],["、"],["「"],["それ"],["について"],["は"],["、"],["いずれ"],["また"],["聞かせて","きかせて"],["もらう"],["こと"],["に"],["しよう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":33,"text":"それで、パウロはその場を立ち去った。","tok":[["それ"],["で"],["、"],["パウロ"],["は"],["その"],["場","ば"],["を"],["立ち去った","たちさった"],["。"]]},{"verse":34,"text":"しかし、彼について行って信仰に入った者も、何人かいた。その中にはアレオパゴスの議員ディオニシオ、またダマリスという婦人やその他の人々もいた。","tok":[["しかし"],["、"],["彼","かれ"],["について"],["行って","いって"],["信仰","しんこう"],["に"],["入った","はいった"],["者","もの"],["も"],["、"],["何人","なんにん"],["か"],["いた"],["。"],["その"],["中","なか"],["に"],["は"],["アレオパゴス"],["の"],["議員","ぎいん"],["ディオニシオ"],["、"],["また"],["ダマリス"],["と"],["いう"],["婦人","ふじん"],["や"],["その"],["他","た"],["の"],["人々","ひとびと"],["も"],["いた"],["。"]]}]
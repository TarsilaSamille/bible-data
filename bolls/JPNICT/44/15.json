[{"verse":1,"text":"ある人々がユダヤから下って来て、「モーセの慣習に従って割礼を受けなければ、あなたがたは救われない」と兄弟たちに教えていた。","tok":[["ある"],["人々","ひとびと"],["が"],["ユダヤ"],["から"],["下って","くだって"],["来て","きて"],["、"],["「"],["モーセ"],["の"],["慣習","かんしゅう"],["に"],["従って","したがって"],["割礼","かつれい"],["を"],["受けなければ","うけなければ"],["、"],["あなた"],["がた"],["は"],["救われない","すくわれない"],["」"],["と"],["兄弟","きょうだい"],["たち"],["に"],["教えて","おしえて"],["いた"],["。"]]},{"verse":2,"text":"それで、パウロやバルナバとその人たちとの間に、激しい意見の対立と論争が生じた。この件について使徒や長老たちと協議するために、パウロとバルナバ、そのほか数名の者がエルサレムへ上ることに決まった。","tok":[["それ"],["で"],["、"],["パウロ"],["や"],["バルナバ"],["と"],["その"],["人","ひと"],["たち"],["と"],["の"],["間","あいだ"],["に"],["、"],["激しい","はげしい"],["意見","いけん"],["の"],["対立","たいりつ"],["と"],["論争","ろんそう"],["が"],["生じた","しょうじた"],["。"],["この"],["件","けん"],["について"],["使徒","しと"],["や"],["長老","ちょうろう"],["たち"],["と"],["協議","きょうぎ"],["する"],["ため"],["に"],["、"],["パウロ"],["と"],["バルナバ"],["、"],["その"],["ほか"],["数","すう"],["名","めい"],["の"],["者","もの"],["が"],["エルサレム"],["へ"],["上る","のぼる"],["こと"],["に"],["決まった","きまった"],["。"]]},{"verse":3,"text":"さて、一行は教会の人々から送り出されて、フェニキアとサマリア地方を通り、道すがら、兄弟たちに異邦人が改宗した次第を詳しく伝え、皆を大いに喜ばせた。","tok":[["さて"],["、"],["一行","いっこう"],["は"],["教会","きょうかい"],["の"],["人々","ひとびと"],["から"],["送り出されて","おくりだされて"],["、"],["フェニキア"],["と"],["サマリア"],["地方","ちほう"],["を"],["通り","とおり"],["、"],["道すがら","みちすがら"],["、"],["兄弟","きょうだい"],["たち"],["に"],["異邦人","いほうじん"],["が"],["改宗","かいしゅう"],["した"],["次第","しだい"],["を"],["詳しく","くわしく"],["伝え","つたえ"],["、"],["皆","みな"],["を"],["大いに","おおいに"],["喜ばせた","よろこばせた"],["。"]]},{"verse":4,"text":"エルサレムに到着すると、彼らは教会の人々、使徒たち、長老たちに歓迎され、神が自分たちと共にいて行われたことを、ことごとく報告した。","tok":[["エルサレム"],["に"],["到着","とうちゃく"],["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["教会","きょうかい"],["の"],["人々","ひとびと"],["、"],["使徒","しと"],["たち"],["、"],["長老","ちょうろう"],["たち"],["に"],["歓迎","かんげい"],["され"],["、"],["神","かみ"],["が"],["自分","じぶん"],["たち"],["と"],["共","とも"],["に"],["いて"],["行われた","おこなわれた"],["こと"],["を"],["、"],["ことごとく"],["報告","ほうこく"],["した"],["。"]]},{"verse":5,"text":"ところが、ファリサイ派から信者になった人が数名立って、「異邦人にも割礼を受けさせて、モーセの律法を守るように命じるべきだ」と言った。","tok":[["ところ"],["が"],["、"],["ファリサイ"],["派","は"],["から"],["信者","しんじゃ"],["に"],["なった"],["人","ひと"],["が"],["数","すう"],["名","めい"],["立って","たって"],["、"],["「"],["異邦人","いほうじん"],["に"],["も"],["割礼","かつれい"],["を"],["受けさせて","うけさせて"],["、"],["モーセ"],["の"],["律法","りっぽう"],["を"],["守る","まもる"],["よう"],["に"],["命じるべきだ","めいじるべきだ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"そこで、使徒たちと長老たちは、この問題について協議するために集まった。","tok":[["そこ"],["で"],["、"],["使徒","しと"],["たち"],["と"],["長老","ちょうろう"],["たち"],["は"],["、"],["この"],["問題","もんだい"],["について"],["協議","きょうぎ"],["する"],["ため"],["に"],["集まった","あつまった"],["。"]]},{"verse":7,"text":"議論を重ねた後、ペトロが立って彼らに言った。「兄弟たち、ご存じのとおり、ずっと以前に、神はあなたがたの間でわたしをお選びになりました。それは、異邦人が、わたしの口から福音の言葉を聞いて信じるようになるためです。","tok":[["議論","ぎろん"],["を"],["重ねた","かさねた"],["後","あと"],["、"],["ペトロ"],["が"],["立って","たって"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["兄弟","きょうだい"],["たち"],["、"],["ご存じ","ごぞんじ"],["の"],["とおり"],["、"],["ずっと"],["以前","いぜん"],["に"],["、"],["神","かみ"],["は"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["わたし"],["を"],["お選び","おえらび"],["に"],["なりました"],["。"],["それ"],["は"],["、"],["異邦人","いほうじん"],["が"],["、"],["わたし"],["の"],["口","くち"],["から"],["福音","ふくいん"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["信じる","しんじる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":8,"text":"人の心をお見通しになる神は、わたしたちに与えてくださったように異邦人にも聖霊を与えて、彼らをも受け入れられたことを証明なさったのです。","tok":[["人","ひと"],["の"],["心","こころ"],["を"],["お見通し","おみとおし"],["に"],["なる"],["神","かみ"],["は"],["、"],["わたしたち"],["に"],["与えて","あたえて"],["くださった"],["よう"],["に"],["異邦人","いほうじん"],["に"],["も"],["聖霊","せいれい"],["を"],["与えて","あたえて"],["、"],["彼","かれ"],["ら"],["を"],["も"],["受け入れられた","うけいれられた"],["こと"],["を"],["証明","しょうめい"],["なさった"],["の"],["です"],["。"]]},{"verse":9,"text":"また、彼らの心を信仰によって清め、わたしたちと彼らとの間に何の差別をもなさいませんでした。","tok":[["また"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["信仰","しんこう"],["によって"],["清め","きよめ"],["、"],["わたしたち"],["と"],["彼","かれ"],["ら"],["と"],["の"],["間","あいだ"],["に"],["何","なん"],["の"],["差別","さべつ"],["を"],["も"],["なさいませんでした"],["。"]]},{"verse":10,"text":"それなのに、なぜ今あなたがたは、先祖もわたしたちも負いきれなかった軛を、あの弟子たちの首に懸けて、神を試みようとするのですか。","tok":[["それ"],["な"],["のに"],["、"],["なぜ"],["今","いま"],["あなた"],["がた"],["は"],["、"],["先祖","せんぞ"],["も"],["わたしたち"],["も"],["負い","おい"],["きれなかった"],["軛","くびき"],["を"],["、"],["あの"],["弟子","でし"],["たち"],["の"],["首","くび"],["に"],["懸けて","かけて"],["、"],["神","かみ"],["を"],["試みよう","こころみよう"],["と"],["する"],["の"],["です"],["か"],["。"]]},{"verse":11,"text":"わたしたちは、主イエスの恵みによって救われると信じているのですが、これは、彼ら異邦人も同じことです。」","tok":[["わたしたち"],["は"],["、"],["主","しゅ"],["イエス"],["の"],["恵み","めぐみ"],["によって"],["救われる","すくわれる"],["と"],["信じて","しんじて"],["いる"],["の"],["です"],["が"],["、"],["これ"],["は"],["、"],["彼","かれ"],["ら"],["異邦人","いほうじん"],["も"],["同じ","おなじ"],["こと"],["です"],["。"],["」"]]},{"verse":12,"text":"すると全会衆は静かになり、バルナバとパウロが、自分たちを通して神が異邦人の間で行われた、あらゆるしるしと不思議な業について話すのを聞いていた。","tok":[["する"],["と"],["全","ぜん"],["会衆","かいしゅう"],["は"],["静か","しずか"],["に"],["なり"],["、"],["バルナバ"],["と"],["パウロ"],["が"],["、"],["自分","じぶん"],["たち"],["を"],["通して","とおして"],["神","かみ"],["が"],["異邦人","いほうじん"],["の"],["間","あいだ"],["で"],["行われた","おこなわれた"],["、"],["あらゆる"],["しるし"],["と"],["不思議","ふしぎ"],["な"],["業","ごう"],["について"],["話す","はなす"],["の"],["を"],["聞いて","きいて"],["いた"],["。"]]},{"verse":13,"text":"二人が話を終えると、ヤコブが答えた。「兄弟たち、聞いてください。","tok":[["二人","ふたり"],["が"],["話","はなし"],["を"],["終える","おえる"],["と"],["、"],["ヤコブ"],["が"],["答えた","こたえた"],["。"],["「"],["兄弟","きょうだい"],["たち"],["、"],["聞いて","きいて"],["ください"],["。"]]},{"verse":14,"text":"神が初めに心を配られ、異邦人の中から御自分の名を信じる民を選び出そうとなさった次第については、シメオンが話してくれました。","tok":[["神","かみ"],["が"],["初め","はじめ"],["に"],["心","こころ"],["を"],["配られ","くばられ"],["、"],["異邦人","いほうじん"],["の"],["中","なか"],["から"],["御自分","ごじぶん"],["の"],["名","な"],["を"],["信じる","しんじる"],["民","みん"],["を"],["選び出そう","えらびだそう"],["と"],["なさった"],["次第","しだい"],["について"],["は"],["、"],["シメオン"],["が"],["話して","はなして"],["くれました"],["。"]]},{"verse":15,"text":"預言者たちの言ったことも、これと一致しています。次のように書いてあるとおりです。","tok":[["預言者","よげんしゃ"],["たち"],["の"],["言った","いった"],["こと"],["も"],["、"],["これ"],["と"],["一致","いっち"],["して"],["います"],["。"],["次","つぎ"],["の"],["よう"],["に"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":16,"text":"『「その後、わたしは戻って来て、倒れたダビデの幕屋を建て直す。その破壊された所を建て直して、元どおりにする。","tok":[["『"],["「"],["その"],["後","ご"],["、"],["わたし"],["は"],["戻って","もどって"],["来て","きて"],["、"],["倒れた","たおれた"],["ダビデ"],["の"],["幕屋","まくや"],["を"],["建て直す","たてなおす"],["。"],["その"],["破壊","はかい"],["された"],["所","ところ"],["を"],["建て直して","たてなおして"],["、"],["元どおり","もとどおり"],["に"],["する"],["。"]]},{"verse":17,"text":"それは、人々のうちの残った者や、","tok":[["それ"],["は"],["、"],["人々","ひとびと"],["の"],["うち"],["の"],["残った","のこった"],["者","もの"],["や"],["、"]]},{"verse":18,"text":"わたしの名で呼ばれる異邦人が皆、主を求めるようになるためだ。」昔から知らされていたことを行う主は、こう言われる。』","tok":[["わたし"],["の"],["名","な"],["で"],["呼ばれる","よばれる"],["異邦人","いほうじん"],["が"],["皆","みな"],["、"],["主","ぬし"],["を"],["求める","もとめる"],["よう"],["に"],["なる"],["ため"],["だ"],["。"],["」"],["昔","むかし"],["から"],["知らされて","しらされて"],["いた"],["こと"],["を"],["行う","おこなう"],["主","ぬし"],["は"],["、"],["こう"],["言われる","いわれる"],["。"],["』"]]},{"verse":19,"text":"それで、わたしはこう判断します。神に立ち帰る異邦人を悩ませてはなりません。","tok":[["それ"],["で"],["、"],["わたし"],["は"],["こう"],["判断","はんだん"],["します"],["。"],["神","かみ"],["に"],["立ち帰る","たちかえる"],["異邦人","いほうじん"],["を"],["悩ませて","なやませて"],["は"],["なりません"],["。"]]},{"verse":20,"text":"ただ、偶像に供えて汚れた肉と、みだらな行いと、絞め殺した動物の肉と、血とを避けるようにと、手紙を書くべきです。","tok":[["ただ"],["、"],["偶像","ぐうぞう"],["に"],["供えて","そなえて"],["汚れた","よごれた"],["肉","にく"],["と"],["、"],["みだら"],["な"],["行い","おこない"],["と"],["、"],["絞め殺した","しめころした"],["動物","どうぶつ"],["の"],["肉","にく"],["と"],["、"],["血","ち"],["と"],["を"],["避ける","さける"],["よう"],["に"],["と"],["、"],["手紙","てがみ"],["を"],["書くべきです","かくべきです"],["。"]]},{"verse":21,"text":"モーセの律法は、昔からどの町にも告げ知らせる人がいて、安息日ごとに会堂で読まれているからです。」","tok":[["モーセ"],["の"],["律法","りっぽう"],["は"],["、"],["昔","むかし"],["から"],["どの"],["町","まち"],["に"],["も"],["告げ知らせる","つげしらせる"],["人","ひと"],["が"],["いて"],["、"],["安息日","あんそくび"],["ごと"],["に"],["会堂","かいどう"],["で"],["読まれて","よまれて"],["いる"],["から"],["です"],["。"],["」"]]},{"verse":22,"text":"そこで、使徒たちと長老たちは、教会全体と共に、自分たちの中から人を選んで、パウロやバルナバと一緒にアンティオキアに派遣することを決定した。選ばれたのは、バルサバと呼ばれるユダおよびシラスで、兄弟たちの中で指導的な立場にいた人たちである。","tok":[["そこ"],["で"],["、"],["使徒","しと"],["たち"],["と"],["長老","ちょうろう"],["たち"],["は"],["、"],["教会","きょうかい"],["全体","ぜんたい"],["と"],["共","とも"],["に"],["、"],["自分","じぶん"],["たち"],["の"],["中","なか"],["から"],["人","ひと"],["を"],["選んで","えらんで"],["、"],["パウロ"],["や"],["バルナバ"],["と"],["一緒","いっしょ"],["に"],["アンティオキア"],["に"],["派遣","はけん"],["する"],["こと"],["を"],["決定","けってい"],["した"],["。"],["選ばれた","えらばれた"],["の"],["は"],["、"],["バルサバ"],["と"],["呼ばれる","よばれる"],["ユダ"],["および"],["シラス"],["で"],["、"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["で"],["指導","しどう"],["的","てき"],["な"],["立場","たちば"],["に"],["いた"],["人","ひと"],["たち"],["で"],["ある"],["。"]]},{"verse":23,"text":"使徒たちは、次の手紙を彼らに託した。「使徒と長老たちが兄弟として、アンティオキアとシリア州とキリキア州に住む、異邦人の兄弟たちに挨拶いたします。","tok":[["使徒","しと"],["たち"],["は"],["、"],["次","つぎ"],["の"],["手紙","てがみ"],["を"],["彼","かれ"],["ら"],["に"],["託した","たくした"],["。"],["「"],["使徒","しと"],["と"],["長老","ちょうろう"],["たち"],["が"],["兄弟","きょうだい"],["として"],["、"],["アンティオキア"],["と"],["シリア"],["州","しゅう"],["と"],["キリキア"],["州","しゅう"],["に"],["住む","すむ"],["、"],["異邦人","いほうじん"],["の"],["兄弟","きょうだい"],["たち"],["に"],["挨拶","あいさつ"],["いたします"],["。"]]},{"verse":24,"text":"聞くところによると、わたしたちのうちのある者がそちらへ行き、わたしたちから何の指示もないのに、いろいろなことを言って、あなたがたを騒がせ動揺させたとのことです。","tok":[["聞く","きく"],["ところ"],["に"],["よる"],["と"],["、"],["わたしたち"],["の"],["うち"],["の"],["ある"],["者","もの"],["が"],["そちら"],["へ"],["行き","いき"],["、"],["わたしたち"],["から"],["何","なん"],["の"],["指示","しじ"],["も"],["ない"],["のに"],["、"],["いろいろ"],["な"],["こと"],["を"],["言って","いって"],["、"],["あなた"],["がた"],["を"],["騒がせ","さわがせ"],["動揺","どうよう"],["させた"],["と"],["の"],["こと"],["です"],["。"]]},{"verse":25,"text":"それで、人を選び、わたしたちの愛するバルナバとパウロとに同行させて、そちらに派遣することを、わたしたちは満場一致で決定しました。","tok":[["それ"],["で"],["、"],["人","ひと"],["を"],["選び","えらび"],["、"],["わたしたち"],["の"],["愛する","あいする"],["バルナバ"],["と"],["パウロ"],["と"],["に"],["同行","どうこう"],["させて"],["、"],["そちら"],["に"],["派遣","はけん"],["する"],["こと"],["を"],["、"],["わたしたち"],["は"],["満場","まんじょう"],["一致","いっち"],["で"],["決定","けってい"],["しました"],["。"]]},{"verse":26,"text":"このバルナバとパウロは、わたしたちの主イエス‧キリストの名のために身を献げている人たちです。","tok":[["この"],["バルナバ"],["と"],["パウロ"],["は"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["名","な"],["の"],["ため"],["に"],["身","み"],["を"],["献げて","ささげて"],["いる"],["人","ひと"],["たち"],["です"],["。"]]},{"verse":27,"text":"それで、ユダとシラスを選んで派遣しますが、彼らは同じことを口頭でも説明するでしょう。","tok":[["それ"],["で"],["、"],["ユダ"],["と"],["シラス"],["を"],["選んで","えらんで"],["派遣","はけん"],["します"],["が"],["、"],["彼","かれ"],["ら"],["は"],["同じ","おなじ"],["こと"],["を"],["口頭","こうとう"],["で"],["も"],["説明","せつめい"],["するでしょう"],["。"]]},{"verse":28,"text":"聖霊とわたしたちは、次の必要な事柄以外、一切あなたがたに重荷を負わせないことに決めました。","tok":[["聖霊","せいれい"],["と"],["わたしたち"],["は"],["、"],["次","つぎ"],["の"],["必要","ひつよう"],["な"],["事柄","ことがら"],["以外","いがい"],["、"],["一切","いっさい"],["あなた"],["がた"],["に"],["重荷","おもに"],["を"],["負わせない","おわせない"],["こと"],["に"],["決めました","きめました"],["。"]]},{"verse":29,"text":"すなわち、偶像に献げられたものと、血と、絞め殺した動物の肉と、みだらな行いとを避けることです。以上を慎めばよいのです。健康を祈ります。」","tok":[["すなわち"],["、"],["偶像","ぐうぞう"],["に"],["献げられた","ささげられた"],["もの"],["と"],["、"],["血","ち"],["と"],["、"],["絞め殺した","しめころした"],["動物","どうぶつ"],["の"],["肉","にく"],["と"],["、"],["みだら"],["な"],["行い","おこない"],["と"],["を"],["避ける","さける"],["こと"],["です"],["。"],["以上","いじょう"],["を"],["慎めば","つつしめば"],["よい"],["の"],["です"],["。"],["健康","けんこう"],["を"],["祈ります","いのります"],["。"],["」"]]},{"verse":30,"text":"さて、彼ら一同は見送りを受けて出発し、アンティオキアに到着すると、信者全体を集めて手紙を手渡した。","tok":[["さて"],["、"],["彼","かれ"],["ら"],["一同","いちどう"],["は"],["見送り","みおくり"],["を"],["受けて","うけて"],["出発","しゅっぱつ"],["し"],["、"],["アンティオキア"],["に"],["到着","とうちゃく"],["する"],["と"],["、"],["信者","しんじゃ"],["全体","ぜんたい"],["を"],["集めて","あつめて"],["手紙","てがみ"],["を"],["手渡した","てわたした"],["。"]]},{"verse":31,"text":"彼らはそれを読み、励ましに満ちた決定を知って喜んだ。","tok":[["彼","かれ"],["ら"],["は"],["それ"],["を"],["読み","よみ"],["、"],["励まし","はげまし"],["に"],["満ちた","みちた"],["決定","けってい"],["を"],["知って","しって"],["喜んだ","よろこんだ"],["。"]]},{"verse":32,"text":"ユダとシラスは預言する者でもあったので、いろいろと話をして兄弟たちを励まし力づけ、","tok":[["ユダ"],["と"],["シラス"],["は"],["預言","よげん"],["する"],["者","もの"],["で"],["も"],["あった"],["ので"],["、"],["いろいろ"],["と"],["話","はなし"],["を"],["して"],["兄弟","きょうだい"],["たち"],["を"],["励まし","はげまし"],["力づけ","ちからづけ"],["、"]]},{"verse":33,"text":"しばらくここに滞在した後、兄弟たちから送別の挨拶を受けて見送られ、自分たちを派遣した人々のところへ帰って行った。","tok":[["しばらく"],["ここ"],["に"],["滞在","たいざい"],["した"],["後","あと"],["、"],["兄弟","きょうだい"],["たち"],["から"],["送別","そうべつ"],["の"],["挨拶","あいさつ"],["を"],["受けて","うけて"],["見送られ","みおくられ"],["、"],["自分","じぶん"],["たち"],["を"],["派遣","はけん"],["した"],["人々","ひとびと"],["の"],["ところ"],["へ"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":34,"text":"†〔しかし、シラスはそこにとどまることにした。〕","tok":[["†"],["〔"],["しかし"],["、"],["シラス"],["は"],["そこ"],["に"],["とどまる"],["こと"],["に"],["した"],["。"],["〕"]]},{"verse":35,"text":"しかし、パウロとバルナバはアンティオキアにとどまって教え、他の多くの人と一緒に主の言葉の福音を告げ知らせた。","tok":[["しかし"],["、"],["パウロ"],["と"],["バルナバ"],["は"],["アンティオキア"],["に"],["とどまって"],["教え","おしえ"],["、"],["他","た"],["の"],["多く","おおく"],["の"],["人","ひと"],["と"],["一緒","いっしょ"],["に"],["主","ぬし"],["の"],["言葉","ことば"],["の"],["福音","ふくいん"],["を"],["告げ知らせた","つげしらせた"],["。"]]},{"verse":36,"text":"数日の後、パウロはバルナバに言った。「さあ、前に主の言葉を宣べ伝えたすべての町へもう一度行って兄弟たちを訪問し、どのようにしているかを見て来ようではないか。」","tok":[["数日","すうじつ"],["の"],["後","あと"],["、"],["パウロ"],["は"],["バルナバ"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["前","まえ"],["に"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["宣べ伝えた","のべつたえた"],["すべて"],["の"],["町","まち"],["へ"],["もう"],["一度","いちど"],["行って","いって"],["兄弟","きょうだい"],["たち"],["を"],["訪問","ほうもん"],["し"],["、"],["どの"],["よう"],["に"],["して"],["いる"],["か"],["を"],["見て","みて"],["来","き"],["よう"],["で"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":37,"text":"バルナバは、マルコと呼ばれるヨハネも連れて行きたいと思った。","tok":[["バルナバ"],["は"],["、"],["マルコ"],["と"],["呼ばれる","よばれる"],["ヨハネ"],["も"],["連れて","つれて"],["行きたい","いきたい"],["と"],["思った","おもった"],["。"]]},{"verse":38,"text":"しかしパウロは、前にパンフィリア州で自分たちから離れ、宣教に一緒に行かなかったような者は、連れて行くべきでないと考えた。","tok":[["しかし"],["パウロ"],["は"],["、"],["前","まえ"],["に"],["パンフィリア"],["州","しゅう"],["で"],["自分","じぶん"],["たち"],["から"],["離れ","はなれ"],["、"],["宣教","せんきょう"],["に"],["一緒","いっしょ"],["に"],["行かなかった","いかなかった"],["よう"],["な"],["者","もの"],["は"],["、"],["連れて","つれて"],["行くべきで","いくべきで"],["ない"],["と"],["考えた","かんがえた"],["。"]]},{"verse":39,"text":"そこで、意見が激しく衝突し、彼らはついに別行動をとるようになって、バルナバはマルコを連れてキプロス島へ向かって船出したが、","tok":[["そこ"],["で"],["、"],["意見","いけん"],["が"],["激しく","はげしく"],["衝突","しょうとつ"],["し"],["、"],["彼","かれ"],["ら"],["は"],["ついに"],["別行動","べつこうどう"],["を"],["とる"],["よう"],["に"],["なって"],["、"],["バルナバ"],["は"],["マルコ"],["を"],["連れて","つれて"],["キプロス"],["島","とう"],["へ"],["向かって","むかって"],["船出","ふなで"],["した"],["が"],["、"]]},{"verse":40,"text":"一方、パウロはシラスを選び、兄弟たちから主の恵みにゆだねられて、出発した。","tok":[["一方","いっぽう"],["、"],["パウロ"],["は"],["シラス"],["を"],["選び","えらび"],["、"],["兄弟","きょうだい"],["たち"],["から"],["主","ぬし"],["の"],["恵み","めぐみ"],["に"],["ゆだねられて"],["、"],["出発","しゅっぱつ"],["した"],["。"]]},{"verse":41,"text":"そして、シリア州やキリキア州を回って教会を力づけた。","tok":[["そして"],["、"],["シリア"],["州","しゅう"],["や"],["キリキア"],["州","しゅう"],["を"],["回って","まわって"],["教会","きょうかい"],["を"],["力づけた","ちからづけた"],["。"]]}]
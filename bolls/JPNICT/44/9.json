[{"verse":1,"text":"さて、サウロはなおも主の弟子たちを脅迫し、殺そうと意気込んで、大祭司のところへ行き、","tok":[["さて"],["、"],["サウロ"],["は"],["なお"],["も"],["主","ぬし"],["の"],["弟子","でし"],["たち"],["を"],["脅迫","きょうはく"],["し"],["、"],["殺そう","ころそう"],["と"],["意気","いき"],["込んで","こんで"],["、"],["大","だい"],["祭司","さいし"],["の"],["ところ"],["へ"],["行き","いき"],["、"]]},{"verse":2,"text":"ダマスコの諸会堂あての手紙を求めた。それは、この道に従う者を見つけ出したら、男女を問わず縛り上げ、エルサレムに連行するためであった。","tok":[["ダマスコ"],["の"],["諸","しょ"],["会堂","かいどう"],["あて"],["の"],["手紙","てがみ"],["を"],["求めた","もとめた"],["。"],["それ"],["は"],["、"],["この"],["道","みち"],["に"],["従う","したがう"],["者","もの"],["を"],["見つけ","みつけ"],["出したら","だしたら"],["、"],["男女","だんじょ"],["を"],["問わず","とわず"],["縛り上げ","しばりあげ"],["、"],["エルサレム"],["に"],["連行","れんこう"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":3,"text":"ところが、サウロが旅をしてダマスコに近づいたとき、突然、天からの光が彼の周りを照らした。","tok":[["ところ"],["が"],["、"],["サウロ"],["が"],["旅","たび"],["を"],["して"],["ダマスコ"],["に"],["近づいた","ちかづいた"],["とき"],["、"],["突然","とつぜん"],["、"],["天","てん"],["から"],["の"],["光","ひかり"],["が"],["彼","かれ"],["の"],["周り","まわり"],["を"],["照らした","てらした"],["。"]]},{"verse":4,"text":"サウロは地に倒れ、「サウル、サウル、なぜ、わたしを迫害するのか」と呼びかける声を聞いた。","tok":[["サウロ"],["は"],["地","ち"],["に"],["倒れ","たおれ"],["、"],["「"],["サウル"],["、"],["サウル"],["、"],["なぜ"],["、"],["わたし"],["を"],["迫害","はくがい"],["する"],["の"],["か"],["」"],["と"],["呼びかける","よびかける"],["声","こえ"],["を"],["聞いた","きいた"],["。"]]},{"verse":5,"text":"「主よ、あなたはどなたですか」と言うと、答えがあった。「わたしは、あなたが迫害しているイエスである。","tok":[["「"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["どなた"],["です"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"],["答え","こたえ"],["が"],["あった"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["が"],["迫害","はくがい"],["して"],["いる"],["イエス"],["で"],["ある"],["。"]]},{"verse":6,"text":"起きて町に入れ。そうすれば、あなたのなすべきことが知らされる。」","tok":[["起きて","おきて"],["町","まち"],["に"],["入れ","いれ"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["なすべき"],["こと"],["が"],["知らされる","しらされる"],["。"],["」"]]},{"verse":7,"text":"同行していた人たちは、声は聞こえても、だれの姿も見えないので、ものも言えず立っていた。","tok":[["同行","どうこう"],["して"],["いた"],["人","ひと"],["たち"],["は"],["、"],["声","こえ"],["は"],["聞こえて","きこえて"],["も"],["、"],["だれ"],["の"],["姿","すがた"],["も"],["見えない","みえない"],["ので"],["、"],["もの"],["も"],["言えず","いえず"],["立って","たって"],["いた"],["。"]]},{"verse":8,"text":"サウロは地面から起き上がって、目を開けたが、何も見えなかった。人々は彼の手を引いてダマスコに連れて行った。","tok":[["サウロ"],["は"],["地面","じめん"],["から"],["起き上がって","おきあがって"],["、"],["目","め"],["を"],["開けた","あけた"],["が"],["、"],["何","なん"],["も"],["見えなかった","みえなかった"],["。"],["人々","ひとびと"],["は"],["彼","かれ"],["の"],["手","て"],["を"],["引いて","ひいて"],["ダマスコ"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":9,"text":"サウロは三日間、目が見えず、食べも飲みもしなかった。","tok":[["サウロ"],["は"],["三","みっ"],["日間","かかん"],["、"],["目","め"],["が"],["見えず","みえず"],["、"],["食べ","たべ"],["も"],["飲み","のみ"],["も"],["しなかった"],["。"]]},{"verse":10,"text":"ところで、ダマスコにアナニアという弟子がいた。幻の中で主が、「アナニア」と呼びかけると、アナニアは、「主よ、ここにおります」と言った。","tok":[["ところ"],["で"],["、"],["ダマスコ"],["に"],["アナニア"],["と"],["いう"],["弟子","でし"],["が"],["いた"],["。"],["幻","まぼろし"],["の"],["中","なか"],["で"],["主","ぬし"],["が"],["、"],["「"],["アナニア"],["」"],["と"],["呼びかける","よびかける"],["と"],["、"],["アナニア"],["は"],["、"],["「"],["主","ぬし"],["よ"],["、"],["ここ"],["に"],["おります"],["」"],["と"],["言った","いった"],["。"]]},{"verse":11,"text":"すると、主は言われた。「立って、『直線通り』と呼ばれる通りへ行き、ユダの家にいるサウロという名の、タルソス出身の者を訪ねよ。今、彼は祈っている。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["立って","たって"],["、"],["『"],["直線","ちょくせん"],["通り","とおり"],["』"],["と"],["呼ばれる","よばれる"],["通り","とおり"],["へ"],["行き","いき"],["、"],["ユダ"],["の"],["家","いえ"],["に"],["いる"],["サウロ"],["と"],["いう"],["名","な"],["の"],["、"],["タルソス"],["出身","しゅっしん"],["の"],["者","もの"],["を"],["訪ね","たずね"],["よ"],["。"],["今","いま"],["、"],["彼","かれ"],["は"],["祈って","いのって"],["いる"],["。"]]},{"verse":12,"text":"アナニアという人が入って来て自分の上に手を置き、元どおり目が見えるようにしてくれるのを、幻で見たのだ。」","tok":[["アナニア"],["と"],["いう"],["人","ひと"],["が"],["入って","はいって"],["来て","きて"],["自分","じぶん"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置き","おき"],["、"],["元どおり","もとどおり"],["目","め"],["が"],["見える","みえる"],["よう"],["に"],["して"],["くれる"],["の"],["を"],["、"],["幻","まぼろし"],["で"],["見た","みた"],["の"],["だ"],["。"],["」"]]},{"verse":13,"text":"しかし、アナニアは答えた。「主よ、わたしは、その人がエルサレムで、あなたの聖なる者たちに対してどんな悪事を働いたか、大勢の人から聞きました。","tok":[["しかし"],["、"],["アナニア"],["は"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["よ"],["、"],["わたし"],["は"],["、"],["その"],["人","ひと"],["が"],["エルサレム"],["で"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["者","もの"],["たち"],["に対して","にたいして"],["どんな"],["悪事","あくじ"],["を"],["働いた","はたらいた"],["か"],["、"],["大勢","おおぜい"],["の"],["人","ひと"],["から"],["聞きました","ききました"],["。"]]},{"verse":14,"text":"ここでも、御名を呼び求める人をすべて捕らえるため、祭司長たちから権限を受けています。」","tok":[["ここ"],["で"],["も"],["、"],["御名","ぎょめい"],["を"],["呼び求める","よびもとめる"],["人","ひと"],["を"],["すべて"],["捕らえる","とらえる"],["ため"],["、"],["祭司長","さいしちょう"],["たち"],["から"],["権限","けんげん"],["を"],["受けて","うけて"],["います"],["。"],["」"]]},{"verse":15,"text":"すると、主は言われた。「行け。あの者は、異邦人や王たち、またイスラエルの子らにわたしの名を伝えるために、わたしが選んだ器である。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["行け","いけ"],["。"],["あの"],["者","もの"],["は"],["、"],["異邦人","いほうじん"],["や"],["王","おう"],["たち"],["、"],["また"],["イスラエル"],["の"],["子","こ"],["ら"],["に"],["わたし"],["の"],["名","な"],["を"],["伝える","つたえる"],["ため"],["に"],["、"],["わたし"],["が"],["選んだ","えらんだ"],["器","うつわ"],["で"],["ある"],["。"]]},{"verse":16,"text":"わたしの名のためにどんなに苦しまなくてはならないかを、わたしは彼に示そう。」","tok":[["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["どんな"],["に"],["苦しまなくて","くるしまなくて"],["は"],["ならない"],["か"],["を"],["、"],["わたし"],["は"],["彼","かれ"],["に"],["示そう","しめそう"],["。"],["」"]]},{"verse":17,"text":"そこで、アナニアは出かけて行ってユダの家に入り、サウロの上に手を置いて言った。「兄弟サウル、あなたがここへ来る途中に現れてくださった主イエスは、あなたが元どおり目が見えるようになり、また、聖霊で満たされるようにと、わたしをお遣わしになったのです。」","tok":[["そこ"],["で"],["、"],["アナニア"],["は"],["出かけて","でかけて"],["行って","いって"],["ユダ"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],["サウロ"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置いて","おいて"],["言った","いった"],["。"],["「"],["兄弟","きょうだい"],["サウル"],["、"],["あなた"],["が"],["ここ"],["へ"],["来る","くる"],["途中","とちゅう"],["に"],["現れて","あらわれて"],["くださった"],["主","ぬし"],["イエス"],["は"],["、"],["あなた"],["が"],["元どおり","もとどおり"],["目","め"],["が"],["見える","みえる"],["よう"],["に"],["なり"],["、"],["また"],["、"],["聖霊","せいれい"],["で"],["満たされる","みたされる"],["よう"],["に"],["と"],["、"],["わたし"],["を"],["お遣わし","おつかわし"],["に"],["なった"],["の"],["です"],["。"],["」"]]},{"verse":18,"text":"すると、たちまち目からうろこのようなものが落ち、サウロは元どおり見えるようになった。そこで、身を起こして洗礼を受け、","tok":[["する"],["と"],["、"],["たちまち"],["目","め"],["から"],["うろこ"],["の"],["よう"],["な"],["もの"],["が"],["落ち","おち"],["、"],["サウロ"],["は"],["元どおり","もとどおり"],["見える","みえる"],["よう"],["に"],["なった"],["。"],["そこ"],["で"],["、"],["身","み"],["を"],["起こして","おこして"],["洗礼","せんれい"],["を"],["受け","うけ"],["、"]]},{"verse":19,"text":"食事をして元気を取り戻した。サウロ、ダマスコで福音を告げ知らせるサウロは数日の間、ダマスコの弟子たちと一緒にいて、","tok":[["食事","しょくじ"],["を"],["して"],["元気","げんき"],["を"],["取り戻した","とりもどした"],["。"],["サウロ"],["、"],["ダマスコ"],["で"],["福音","ふくいん"],["を"],["告げ知らせる","つげしらせる"],["サウロ"],["は"],["数日","すうじつ"],["の"],["間","あいだ"],["、"],["ダマスコ"],["の"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["いて"],["、"]]},{"verse":20,"text":"すぐあちこちの会堂で、「この人こそ神の子である」と、イエスのことを宣べ伝えた。","tok":[["すぐ"],["あちこち"],["の"],["会堂","かいどう"],["で"],["、"],["「"],["この"],["人","ひと"],["こそ"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["」"],["と"],["、"],["イエス"],["の"],["こと"],["を"],["宣べ伝えた","のべつたえた"],["。"]]},{"verse":21,"text":"これを聞いた人々は皆、非常に驚いて言った。「あれは、エルサレムでこの名を呼び求める者たちを滅ぼしていた男ではないか。また、ここへやって来たのも、彼らを縛り上げ、祭司長たちのところへ連行するためではなかったか。」","tok":[["これ"],["を"],["聞いた","きいた"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["非常","ひじょう"],["に"],["驚いて","おどろいて"],["言った","いった"],["。"],["「"],["あれ"],["は"],["、"],["エルサレム"],["で"],["この"],["名","な"],["を"],["呼び求める","よびもとめる"],["者","もの"],["たち"],["を"],["滅ぼして","ほろぼして"],["いた"],["男","おとこ"],["で"],["は"],["ない"],["か"],["。"],["また"],["、"],["ここ"],["へ"],["やって"],["来た","きた"],["の"],["も"],["、"],["彼","かれ"],["ら"],["を"],["縛り上げ","しばりあげ"],["、"],["祭司長","さいしちょう"],["たち"],["の"],["ところ"],["へ"],["連行","れんこう"],["する"],["ため"],["で"],["は"],["なかった"],["か"],["。"],["」"]]},{"verse":22,"text":"しかし、サウロはますます力を得て、イエスがメシアであることを論証し、ダマスコに住んでいるユダヤ人をうろたえさせた。","tok":[["しかし"],["、"],["サウロ"],["は"],["ますます"],["力","ちから"],["を"],["得て","えて"],["、"],["イエス"],["が"],["メシア"],["で"],["ある"],["こと"],["を"],["論証","ろんしょう"],["し"],["、"],["ダマスコ"],["に"],["住んで","すんで"],["いる"],["ユダヤ人","ゆだやじん"],["を"],["うろたえさせた"],["。"]]},{"verse":23,"text":"かなりの日数がたって、ユダヤ人はサウロを殺そうとたくらんだが、","tok":[["かなり"],["の"
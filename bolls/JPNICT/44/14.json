[{"verse":1,"text":"イコニオンでも同じように、パウロとバルナバはユダヤ人の会堂に入って話をしたが、その結果、大勢のユダヤ人やギリシア人が信仰に入った。","tok":[["イコニオン"],["で"],["も"],["同じ","おなじ"],["よう"],["に"],["、"],["パウロ"],["と"],["バルナバ"],["は"],["ユダヤ人","ゆだやじん"],["の"],["会堂","かいどう"],["に"],["入って","はいって"],["話","はなし"],["を"],["した"],["が"],["、"],["その"],["結果","けっか"],["、"],["大勢","おおぜい"],["の"],["ユダヤ人","ゆだやじん"],["や"],["ギリシア"],["人","にん"],["が"],["信仰","しんこう"],["に"],["入った","はいった"],["。"]]},{"verse":2,"text":"ところが、信じようとしないユダヤ人たちは、異邦人を扇動し、兄弟たちに対して悪意を抱かせた。","tok":[["ところ"],["が"],["、"],["信じよう","しんじよう"],["と"],["しない"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["異邦人","いほうじん"],["を"],["扇動","せんどう"],["し"],["、"],["兄弟","きょうだい"],["たち"],["に対して","にたいして"],["悪意","あくい"],["を"],["抱かせた","いだかせた"],["。"]]},{"verse":3,"text":"それでも、二人はそこに長くとどまり、主を頼みとして勇敢に語った。主は彼らの手を通してしるしと不思議な業を行い、その恵みの言葉を証しされたのである。","tok":[["それ"],["で"],["も"],["、"],["二人","ふたり"],["は"],["そこ"],["に"],["長く","ながく"],["とどまり"],["、"],["主","ぬし"],["を"],["頼み","たのみ"],["として"],["勇敢","ゆうかん"],["に"],["語った","かたった"],["。"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["を"],["通して","とおして"],["しるし"],["と"],["不思議","ふしぎ"],["な"],["業","ごう"],["を"],["行い","おこない"],["、"],["その"],["恵み","めぐみ"],["の"],["言葉","ことば"],["を"],["証し","あかし"],["された"],["ので"],["ある"],["。"]]},{"verse":4,"text":"町の人々は分裂し、ある者はユダヤ人の側に、ある者は使徒の側についた。","tok":[["町","まち"],["の"],["人々","ひとびと"],["は"],["分裂","ぶんれつ"],["し"],["、"],["ある"],["者","もの"],["は"],["ユダヤ人","ゆだやじん"],["の"],["側","がわ"],["に"],["、"],["ある"],["者","もの"],["は"],["使徒","しと"],["の"],["側","がわ"],["に"],["ついた"],["。"]]},{"verse":5,"text":"異邦人とユダヤ人が、指導者と一緒になって二人に乱暴を働き、石を投げつけようとしたとき、","tok":[["異邦人","いほうじん"],["と"],["ユダヤ人","ゆだやじん"],["が"],["、"],["指導者","しどうしゃ"],["と"],["一緒","いっしょ"],["に"],["なって"],["二人","ふたり"],["に"],["乱暴","らんぼう"],["を"],["働き","はたらき"],["、"],["石","いし"],["を"],["投げつけよう","なげつけよう"],["と"],["した"],["とき"],["、"]]},{"verse":6,"text":"二人はこれに気づいて、リカオニア州の町であるリストラとデルベ、またその近くの地方に難を避けた。","tok":[["二人","ふたり"],["は"],["これ"],["に"],["気づいて","きづいて"],["、"],["リカオニア"],["州","しゅう"],["の"],["町","まち"],["で"],["ある"],["リストラ"],["と"],["デルベ"],["、"],["また"],["その"],["近く","ちかく"],["の"],["地方","ちほう"],["に"],["難","なん"],["を"],["避けた","さけた"],["。"]]},{"verse":7,"text":"そして、そこでも福音を告げ知らせていた。","tok":[["そして"],["、"],["そこ"],["で"],["も"],["福音","ふくいん"],["を"],["告げ知らせて","つげしらせて"],["いた"],["。"]]},{"verse":8,"text":"リストラに、足の不自由な男が座っていた。生まれつき足が悪く、まだ一度も歩いたことがなかった。","tok":[["リストラ"],["に"],["、"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["男","おとこ"],["が"],["座って","すわって"],["いた"],["。"],["生まれつき","うまれつき"],["足","あし"],["が"],["悪く","わるく"],["、"],["まだ"],["一度","いちど"],["も"],["歩いた","あるいた"],["こと"],["が"],["なかった"],["。"]]},{"verse":9,"text":"この人が、パウロの話すのを聞いていた。パウロは彼を見つめ、いやされるのにふさわしい信仰があるのを認め、","tok":[["この"],["人","ひと"],["が"],["、"],["パウロ"],["の"],["話す","はなす"],["の"],["を"],["聞いて","きいて"],["いた"],["。"],["パウロ"],["は"],["彼","かれ"],["を"],["見つめ","みつめ"],["、"],["いや"],["される"],["のに"],["ふさわしい"],["信仰","しんこう"],["が"],["ある"],["の"],["を"],["認め","みとめ"],["、"]]},{"verse":10,"text":"「自分の足でまっすぐに立ちなさい」と大声で言った。すると、その人は躍り上がって歩きだした。","tok":[["「"],["自分","じぶん"],["の"],["足","あし"],["で"],["まっすぐ"],["に"],["立ち","たち"],["なさい"],["」"],["と"],["大声","おおごえ"],["で"],["言った","いった"],["。"],["する"],["と"],["、"],["その"],["人","ひと"],["は"],["躍り上がって","おどりあがって"],["歩き","あるき"],["だした"],["。"]]},{"verse":11,"text":"群衆はパウロの行ったことを見て声を張り上げ、リカオニアの方言で、「神々が人間の姿をとって、わたしたちのところにお降りになった」と言った。","tok":[["群衆","ぐんしゅう"],["は"],["パウロ"],["の"],["行った","おこなった"],["こと"],["を"],["見て","みて"],["声","こえ"],["を"],["張り上げ","はりあげ"],["、"],["リカオニア"],["の"],["方言","ほうげん"],["で"],["、"],["「"],["神々","かみがみ"],["が"],["人間","にんげん"],["の"],["姿","すがた"],["を"],["とって"],["、"],["わたしたち"],["の"],["ところ"],["に"],["お降り","おふり"],["に"],["なった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"そして、バルナバを「ゼウス」と呼び、またおもに話す者であることから、パウロを「ヘルメス」と呼んだ。","tok":[["そして"],["、"],["バルナバ"],["を"],["「"],["ゼウス"],["」"],["と"],["呼び","よび"],["、"],["また"],["おもに"],["話す","はなす"],["者","もの"],["で"],["ある"],["こと"],["から"],["、"],["パウロ"],["を"],["「"],["ヘルメス"],["」"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":13,"text":"町の外にあったゼウスの神殿の祭司が、家の門の所まで雄牛数頭と花輪を運んで来て、群衆と一緒になって二人にいけにえを献げようとした。","tok":[["町","まち"],["の"],["外","そと"],["に"],["あった"],["ゼウス"],["の"],["神殿","しんでん"],["の"],["祭司","さいし"],["が"],["、"],["家","いえ"],["の"],["門","もん"],["の"],["所","ところ"],["まで"],["雄牛","おうし"],["数頭","すうとう"],["と"],["花輪","はなわ"],["を"],["運んで","はこんで"],["来て","きて"],["、"],["群衆","ぐんしゅう"],["と"],["一緒","いっしょ"],["に"],["なって"],["二人","ふたり"],["に"],["いけにえ"],["を"],["献げよう","ささげよう"],["と"],["した"],["。"]]},{"verse":14,"text":"使徒たち、すなわちバルナバとパウロはこのことを聞くと、服を裂いて群衆の中へ飛び込んで行き、叫んで","tok":[["使徒","しと"],["たち"],["、"],["すなわち"],["バルナバ"],["と"],["パウロ"],["は"],["この"],["こと"],["を"],["聞く","きく"],["と"],["、"],["服","ふく"],["を"],["裂いて","さいて"],["群衆","ぐんしゅう"],["の"],["中","なか"],["へ"],["飛び込んで","とびこんで"],["行き","いき"],["、"],["叫んで","さけんで"]]},{"verse":15,"text":"言った。「皆さん、なぜ、こんなことをするのですか。わたしたちも、あなたがたと同じ人間にすぎません。あなたがたが、このような偶像を離れて、生ける神に立ち帰るように、わたしたちは福音を告げ知らせているのです。この神こそ、天と地と海と、そしてその中にあるすべてのものを造られた方です。","tok":[["言った","いった"],["。"],["「"],["皆","みな"],["さん"],["、"],["なぜ"],["、"],["こんな"],["こと"],["を"],["する"],["の"],["です"],["か"],["。"],["わたしたち"],["も"],["、"],["あなた"],["がた"],["と"],["同じ","おなじ"],["人間","にんげん"],["に"],["すぎません"],["。"],["あなた"],["が"],["た"],["が"],["、"],["この"],["よう"],["な"],["偶像","ぐうぞう"],["を"],["離れて","はなれて"],["、"],["生ける","いける"],["神","かみ"],["に"],["立ち帰る","たちかえる"],["よう"],["に"],["、"],["わたしたち"],["は"],["福音","ふくいん"],["を"],["告げ知らせて","つげしらせて"],["いる"],["の"],["です"],["。"],["この"],["神","かみ"],["こそ"],["、"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["と"],["、"],["そして"],["その"],["中","なか"],["に"],["ある"],["すべて"],["の"],["もの"],["を"],["造られた","つくられた"],["方","ほう"],["です"],["。"]]},{"verse":16,"text":"神は過ぎ去った時代には、すべての国の人が思い思いの道を行くままにしておかれました。","tok":[["神","かみ"],["は"],["過ぎ去った","すぎさった"],["時代","じだい"],["に"],["は"],["、"],["すべて"],["の"],["国","くに"],["の"],["人","ひと"],["が"],["思い思い","おもいおもい"],["の"],["道","みち"],["を"],["行く","いく"],["まま"],["に"],["して"],["おかれました"],["。"]]},{"verse":17,"text":"しかし、神は御自分のことを証ししないでおられたわけではありません。恵みをくださり、天からの雨を降らせて実りの季節を与え、食物を施して、あなたがたの心を喜びで満たしてくださっているのです。」","tok":[["しかし"],["、"],["神","かみ"],["は"],["御自分","ごじぶん"],["の"],["こと"],["を"],["証し","しょうし"],["しないで"],["おられた"],["わけ"],["で"],["は"],["ありません"],["。"],["恵み","めぐみ"],["を"],["くださり"],["、"],["天","てん"],["から"],["の"],["雨","あめ"],
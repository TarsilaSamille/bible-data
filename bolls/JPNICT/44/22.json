[{"verse":1,"text":"「兄弟であり父である皆さん、これから申し上げる弁明を聞いてください。」","tok":[["「"],["兄弟","きょうだい"],["で"],["あり"],["父","ちち"],["で"],["ある"],["皆","みな"],["さん"],["、"],["これ"],["から"],["申し上げる","もうしあげる"],["弁明","べんめい"],["を"],["聞いて","きいて"],["ください"],["。"],["」"]]},{"verse":2,"text":"パウロがヘブライ語で話すのを聞いて、人々はますます静かになった。パウロは言った。","tok":[["パウロ"],["が"],["ヘブライ"],["語","ご"],["で"],["話す","はなす"],["の"],["を"],["聞いて","きいて"],["、"],["人々","ひとびと"],["は"],["ますます"],["静か","しずか"],["に"],["なった"],["。"],["パウロ"],["は"],["言った","いった"],["。"]]},{"verse":3,"text":"「わたしは、キリキア州のタルソスで生まれたユダヤ人です。そして、この都で育ち、ガマリエルのもとで先祖の律法について厳しい教育を受け、今日の皆さんと同じように、熱心に神に仕えていました。","tok":[["「"],["わたし"],["は"],["、"],["キリキア"],["州","しゅう"],["の"],["タルソス"],["で"],["生まれた","うまれた"],["ユダヤ人","ゆだやじん"],["です"],["。"],["そして"],["、"],["この"],["都","と"],["で"],["育ち","そだち"],["、"],["ガマリエル"],["の"],["もと"],["で"],["先祖","せんぞ"],["の"],["律法","りっぽう"],["について"],["厳しい","きびしい"],["教育","きょういく"],["を"],["受け","うけ"],["、"],["今日","きょう"],["の"],["皆","みな"],["さん"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["熱心","ねっしん"],["に"],["神","かみ"],["に"],["仕えて","つかえて"],["いました"],["。"]]},{"verse":4,"text":"わたしはこの道を迫害し、男女を問わず縛り上げて獄に投じ、殺すことさえしたのです。","tok":[["わたし"],["は"],["この"],["道","みち"],["を"],["迫害","はくがい"],["し"],["、"],["男女","だんじょ"],["を"],["問わず","とわず"],["縛り上げて","しばりあげて"],["獄","ごく"],["に"],["投じ","とうじ"],["、"],["殺す","ころす"],["こと"],["さえ"],["した"],["の"],["です"],["。"]]},{"verse":5,"text":"このことについては、大祭司も長老会全体も、わたしのために証言してくれます。実は、この人たちからダマスコにいる同志にあてた手紙までもらい、その地にいる者たちを縛り上げ、エルサレムへ連行して処罰するために出かけて行ったのです。」","tok":[["この"],["こと"],["について"],["は"],["、"],["大","だい"],["祭司","さいし"],["も"],["長老","ちょうろう"],["会","かい"],["全体","ぜんたい"],["も"],["、"],["わたし"],["の"],["ため"],["に"],["証言","しょうげん"],["して"],["くれます"],["。"],["実","じつ"],["は"],["、"],["この"],["人","ひと"],["たち"],["から"],["ダマスコ"],["に"],["いる"],["同志","どうし"],["に"],["あてた"],["手紙","てがみ"],["まで"],["もらい"],["、"],["その"],["地","ち"],["に"],["いる"],["者","もの"],["たち"],["を"],["縛り上げ","しばりあげ"],["、"],["エルサレム"],["へ"],["連行","れんこう"],["して"],["処罰","しょばつ"],["する"],["ため"],["に"],["出かけて","でかけて"],["行った","いった"],["の"],["です"],["。"],["」"]]},{"verse":6,"text":"「旅を続けてダマスコに近づいたときのこと、真昼ごろ、突然、天から強い光がわたしの周りを照らしました。","tok":[["「"],["旅","たび"],["を"],["続けて","つづけて"],["ダマスコ"],["に"],["近づいた","ちかづいた"],["とき"],["の"],["こと"],["、"],["真","ま"],["昼ごろ","ひるごろ"],["、"],["突然","とつぜん"],["、"],["天","てん"],["から"],["強い","つよい"],["光","ひかり"],["が"],["わたし"],["の"],["周り","まわり"],["を"],["照らしました","てらしました"],["。"]]},{"verse":7,"text":"わたしは地面に倒れ、『サウル、サウル、なぜ、わたしを迫害するのか』と言う声を聞いたのです。","tok":[["わたし"],["は"],["地面","じめん"],["に"],["倒れ","たおれ"],["、"],["『"],["サウル"],["、"],["サウル"],["、"],["なぜ"],["、"],["わたし"],["を"],["迫害","はくがい"],["する"],["の"],["か"],["』"],["と"],["言う","いう"],["声","こえ"],["を"],["聞いた","きいた"],["の"],["です"],["。"]]},{"verse":8,"text":"『主よ、あなたはどなたですか』と尋ねると、『わたしは、あなたが迫害しているナザレのイエスである』と答えがありました。","tok":[["『"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["どなた"],["です"],["か"],["』"],["と"],["尋ねる","たずねる"],["と"],["、"],["『"],["わたし"],["は"],["、"],["あなた"],["が"],["迫害","はくがい"],["して"],["いる"],["ナザレ"],["の"],["イエス"],["で"],["ある"],["』"],["と"],["答え","こたえ"],["が"],["ありました"],["。"]]},{"verse":9,"text":"一緒にいた人々は、その光は見たのですが、わたしに話しかけた方の声は聞きませんでした。","tok":[["一緒","いっしょ"],["に"],["いた"],["人々","ひとびと"],["は"],["、"],["その"],["光","ひかり"],["は"],["見た","みた"],["の"],["です"],["が"],["、"],["わたし"],["に"],["話しかけた","はなしかけた"],["方","ほう"],["の"],["声","こえ"],["は"],["聞きませんでした","ききませんでした"],["。"]]},{"verse":10,"text":"『主よ、どうしたらよいでしょうか』と申しますと、主は、『立ち上がってダマスコへ行け。しなければならないことは、すべてそこで知らされる』と言われました。","tok":[["『"],["主","ぬし"],["よ"],["、"],["どう"],["したら"],["よいでしょう"],["か"],["』"],["と"],["申します","もうします"],["と"],["、"],["主","ぬし"],["は"],["、"],["『"],["立ち上がって","たちあがって"],["ダマスコ"],["へ"],["行け","いけ"],["。"],["しなければ"],["ならない"],["こと"],["は"],["、"],["すべて"],["そこ"],["で"],["知らされる","しらされる"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":11,"text":"わたしは、その光の輝きのために目が見えなくなっていましたので、一緒にいた人たちに手を引かれて、ダマスコに入りました。","tok":[["わたし"],["は"],["、"],["その"],["光","ひかり"],["の"],["輝き","かがやき"],["の"],["ため"],["に"],["目","め"],["が"],["見えなく","みえなく"],["なって"],["いました"],["ので"],["、"],["一緒","いっしょ"],["に"],["いた"],["人","ひと"],["たち"],["に"],["手","て"],["を"],["引かれて","ひかれて"],["、"],["ダマスコ"],["に"],["入りました","はいりました"],["。"]]},{"verse":12,"text":"ダマスコにはアナニアという人がいました。律法に従って生活する信仰深い人で、そこに住んでいるすべてのユダヤ人の中で評判の良い人でした。","tok":[["ダマスコ"],["に"],["は"],["アナニア"],["と"],["いう"],["人","ひと"],["が"],["いました"],["。"],["律法","りっぽう"],["に"],["従って","したがって"],["生活","せいかつ"],["する"],["信仰","しんこう"],["深い","ふかい"],["人","ひと"],["で"],["、"],["そこ"],["に"],["住んで","すんで"],["いる"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["の"],["中","なか"],["で"],["評判","ひょうばん"],["の"],["良い","よい"],["人","ひと"],["でした"],["。"]]},{"verse":13,"text":"この人がわたしのところに来て、そばに立ってこう言いました。『兄弟サウル、元どおり見えるようになりなさい。』するとそのとき、わたしはその人が見えるようになったのです。","tok":[["この"],["人","ひと"],["が"],["わたし"],["の"],["ところ"],["に"],["来て","きて"],["、"],["そば"],["に"],["立って","たって"],["こう"],["言いました","いいました"],["。"],["『"],["兄弟","きょうだい"],["サウル"],["、"],["元どおり","もとどおり"],["見える","みえる"],["よう"],["に"],["なり"],["なさい"],["。"],["』"],["する"],["と"],["その"],["とき"],["、"],["わたし"],["は"],["その"],["人","ひと"],["が"],["見える","みえる"],["よう"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":14,"text":"アナニアは言いました。『わたしたちの先祖の神が、あなたをお選びになった。それは、御心を悟らせ、あの正しい方に会わせて、その口からの声を聞かせるためです。","tok":[["アナニア"],["は"],["言いました","いいました"],["。"],["『"],["わたしたち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["が"],["、"],["あなた"],["を"],["お選び","おえらび"],["に"],["なった"],["。"],["それ"],["は"],["、"],["御心","おこころ"],["を"],["悟らせ","さとらせ"],["、"],["あの"],["正しい","ただしい"],["方","ほう"],["に"],["会わせて","あわせて"],["、"],["その"],["口","くち"],["から"],["の"],["声","こえ"],["を"],["聞かせる","きかせる"],["ため"],["です"],["。"]]},{"verse":15,"text":"あなたは、見聞きしたことについて、すべての人に対してその方の証人となる者だからです。","tok":[["あなた"],["は"],["、"],["見聞き","みきき"],["した"],["こと"],["について"],["、"],["すべて"],["の"],["人","ひと"],["に対して","にたいして"],["その"],["方","かた"],["の"],["証人","しょうにん"],["と"],["なる"],["者","もの"],["だ"],["から"],["です"],["。"]]},{"verse":16,"text":"今、何をためらっているのです。立ち上がりなさい。その方の名を唱え、洗礼を受けて罪を洗い清めなさい。』」","tok":[["今","いま"],["、"],["何","なん"],["を"],["ためらって"],["いる"],["の"],["です"],["。"],["立ち上がり","たちあがり"],["なさい"],["。"],["その"],["方","かた"],["の"],["名","な"],["を"],["唱え","となえ"],["、"],["洗礼","せんれい"],["を"],["受けて","うけて"],["罪","つみ"],["を"],["洗い清め","あらいきよめ"],["なさい"],["。"],["』"],["」"]]},{"verse":17,"text":"「さて、わたしはエルサレムに帰って来て、神殿で祈っていたとき、我を忘れた状態になり、","tok":[["「"],["さて"],["、"],["わたし"],["は"],["エルサレム"],["に"],["帰って","かえって"],["来て","きて"],["、"],["神殿","しんでん"],["で"],["祈って","いのって"],["いた"],["とき"],["、"],["我","われ"],["を"],["忘れた","わすれた"],["状態","じょうたい"],["に"],["なり"],["、"]]},{"verse":18,"text":"主にお会いしたのです。主は言われました。『急げ。すぐエルサレムから出て行け。わたしについてあなたが証しすることを、人々が受け入れないからである。』","tok":[["主に","おもに"],["お会い","おあい"],["した"],["の"],["です"],["。"],["主","ぬし"],["は"],["言われました","いわれました"],["。"],["『"],["急げ","いそげ"],["。"],["すぐ"],["エルサレム"],["から"],["出て","でて"],["行け","いけ"],["。"],["わたし"],["について"],["あなた"],["が"],["証し","あかし"],["する"],["こと"],["を"],["、"],["人々","ひとびと"],["が"],["受け入れない","うけいれない"],["から"],["で"],["ある"],["。"],["』"]]},{"verse":19,"text":"わたしは申しました。『主よ、わたしが会堂から会堂へと回って、あなたを信じる者を投獄したり、鞭で打ちたたいたりしていたことを、この人々は知っています。","tok":[["わたし"],["は"],["申しました","もうしました"],["。"],["『"],["主","ぬし"],["よ"],["、"],["わたし"],["が"],["会堂","かいどう"],["から"],["会堂","かいどう"],["へ"],["と"],["回って","まわって"],["、"],["あなた"],["を"],["信じる","しんじる"],["者","もの"],["を"],["投獄","とうごく"],["し"],["たり"],["、"],["鞭","むち"],["で"],["打ちたたい","うちたたい"],["たり"],["して"],["いた"],["こと"],["を"],["、"],["この"],["人々","ひとびと"],["は"],["知って","しって"],["います"],["。"]]},{"verse":20,"text":"また、あなたの証人ステファノの血が流されたとき、わたしもその場にいてそれに賛成し、彼を殺す者たちの上着の番もしたのです。』","tok":[["また"],["、"],["あなた"],["の"],["証人","しょうにん"],["ステファノ"],["の"],["血","ち"],["が"],["流された","ながされた"],["とき"],["、"],["わたし"],["も"],["その"],["場","ば"],["に"],["いて"],["それ"],["に"],["賛成","さんせい"],["し"],["、"],["彼","かれ"],["を"],["殺す","ころす"],["者","もの"],["たち"],["の"],["上着","うわぎ"],["の"],["番","ばん"],["も"],["した"],["の"],["です"],["。"],["』"]]},{"verse":21,"text":"すると、主は言われました。『行け。わたしがあなたを遠く異邦人のために遣わすのだ。』」","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["言われました","いわれました"],["。"],["『"],["行け","いけ"],["。"],["わたし"],["が"],["あなた"],["を"],["遠く","とおく"],["異邦人","いほうじん"],["の"],["ため"],["に"],["遣わす","つかわす"],["の"],["だ"],["。"],["』"],["」"]]},{"verse":22,"text":"パウロの話をここまで聞いた人々は、声を張り上げて言った。「こんな男は、地上から除いてしまえ。生かしてはおけない。」","tok":[["パウロ"],["の"],["話","はなし"],["を"],["ここ"],["まで"],["聞いた","きいた"],["人々","ひとびと"],["は"],["、"],["声","こえ"],["を"],["張り上げて","はりあげて"],["言った","いった"],["。"],["「"],["こんな"],["男","おとこ"],["は"],["、"],["地上","ちじょう"],["から"],["除いて","のぞいて"],["しまえ"],["。"],["生かして","いかして"],["は"],["おけない"],["。"],["」"]]},{"verse":23,"text":"彼らがわめき立てて上着を投げつけ、砂埃を空中にまき散らすほどだったので、","tok":[["彼","かれ"],["ら"],["が"],["わめき立てて","わめきたてて"],["上着","うわぎ"],["を"],["投げつけ","なげつけ"],["、"],["砂埃","すなぼこり"],["を"],["空中","くうちゅう"],["に"],["まき散らす","まきちらす"],["ほど"],["だった"],["ので"],["、"]]},{"verse":24,"text":"千人隊長はパウロを兵営に入れるように命じ、人々がどうしてこれほどパウロに対してわめき立てるのかを知るため、鞭で打ちたたいて調べるようにと言った。","tok":[["千人","せんにん"],["隊長","たいちょう"],["は"],["パウロ"],["を"],["兵営","へいえい"],["に"],["入れる","いれる"],["よう"],["に"],["命じ","めいじ"],["、"],["人々","ひとびと"],["が"],["どう"],["して"],["これ"],["ほど"],["パウロ"],["に対して","にたいして"],["わめき立てる","わめきたてる"],["の"],["か"],["を"],["知る","しる"],["ため"],["、"],["鞭","むち"],["で"],["打ちたたいて","うちたたいて"],["調べる","しらべる"],["よう"],["に"],["と"],["言った","いった"],["。"]]},{"verse":25,"text":"パウロを鞭で打つため、その両手を広げて縛ると、パウロはそばに立っていた百人隊長に言った。「ローマ帝国の市民権を持つ者を、裁判にかけずに鞭で打ってもよいのですか。」","tok":[["パウロ"],["を"],["鞭","むち"],["で"],["打つ","うつ"],["ため"],["、"],["その"],["両手","りょうて"],["を"],["広げて","ひろげて"],["縛る","しばる"],["と"],["、"],["パウロ"],["は"],["そば"],["に"],["立って","たって"],["いた"],["百人","ひゃくにん"],["隊長","たいちょう"],["に"],["言った","いった"],["。"],["「"],["ローマ"],["帝国","ていこく"],["の"],["市民権","しみんけん"],["を"],["持つ","もつ"],["者","もの"],["を"],["、"],["裁判","さいばん"],["に"],["かけず"],["に"],["鞭","むち"],["で"],["打って","うって"],["も"],["よい"],["の"],["です"],["か"],["。"],["」"]]},{"verse":26,"text":"これを聞いた百人隊長は、千人隊長のところへ行って報告した。「どうなさいますか。あの男はローマ帝国の市民です。」","tok":[["これ"],["を"],["聞いた","きいた"],["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["、"],["千人","せんにん"],["隊長","たいちょう"],["の"],["ところ"],["へ"],["行って","いって"],["報告","ほうこく"],["した"],["。"],["「"],["どう"],["なさいます"],["か"],["。"],["あの"],["男","おとこ"],["は"],["ローマ"],["帝国","ていこく"],["の"],["市民","しみん"],["です"],["。"],["」"]]},{"verse":27,"text":"千人隊長はパウロのところへ来て言った。「あなたはローマ帝国の市民なのか。わたしに言いなさい。」パウロは、「そうです」と言った。","tok":[["千人","せんにん"],["隊長","たいちょう"],["は"],["パウロ"],["の"],["ところ"],["へ"],["来て","きて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["ローマ"],["帝国","ていこく"],["の"],["市民","しみん"],["な"],["の"],["か"],["。"],["わたし"],["に"],["言い","いい"],["なさい"],["。"],["」"],["パウロ"],["は"],["、"],["「"],["そう"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":28,"text":"千人隊長が、「わたしは、多額の金を出してこの市民権を得たのだ」と言うと、パウロは、「わたしは生まれながらローマ帝国の市民です」と言った。","tok":[["千人","せんにん"],["隊長","たいちょう"],["が"],["、"],["「"],["わたし"],["は"],["、"],["多額","たがく"],["の"],["金","かね"],["を"],["出して","だして"],["この"],["市民権","しみんけん"],["を"],["得た","えた"],["の"],["だ"],["」"],["と"],["言う","ゆう"],["と"],["、"],["パウロ"],["は"],["、"],["「"],["わたし"],["は"],["生まれ","うまれ"],["ながら"],["ローマ"],["帝国","ていこく"],["の"],["市民","しみん"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":29,"text":"そこで、パウロを取り調べようとしていた者たちは、直ちに手を引き、千人隊長もパウロがローマ帝国の市民であること、そして、彼を縛ってしまったことを知って恐ろしくなった。","tok":[["そこ"],["で"],["、"],["パウロ"],["を"],["取り調べよう","とりしらべよう"],["として"],["いた"],["者","もの"],["たち"],["は"],["、"],["直ちに","ただちに"],["手","て"],["を"],["引き","ひき"],["、"],["千人","せんにん"],["隊長","たいちょう"],["も"],["パウロ"],["が"],["ローマ"],["帝国","ていこく"],["の"],["市民","しみん"],["で"],["ある"],["こと"],["、"],["そして"],["、"],["彼","かれ"],["を"],["縛って","しばって"],["しまった"],["こと"],["を"],["知って","しって"],["恐ろしく","おそろしく"],["なった"],["。"]]},{"verse":30,"text":"翌日、千人隊長は、なぜパウロがユダヤ人から訴えられているのか、確かなことを知りたいと思い、彼の鎖を外した。そして、祭司長たちと最高法院全体の召集を命じ、パウロを連れ出して彼らの前に立たせた。","tok":[["翌日","よくじつ"],["、"],["千人","せんにん"],["隊長","たいちょう"],["は"],["、"],["なぜ"],["パウロ"],["が"],["ユダヤ人","ゆだやじん"],["から"],["訴えられて","うったえられて"],["いる"],["の"],["か"],["、"],["確か","たしか"],["な"],["こと"],["を"],["知りたい","しりたい"],["と"],["思い","おもい"],["、"],["彼","かれ"],["の"],["鎖","くさり"],["を"],["外した","はずした"],["。"],["そして"],["、"],["祭司長","さいしちょう"],["たち"],["と"],["最高","さいこう"],["法院","ほういん"],["全体","ぜんたい"],["の"],["召集","しょうしゅう"],["を"],["命じ","めいじ"],["、"],["パウロ"],["を"],["連れ出して","つれだして"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["立たせた","たたせた"],["。"]]}]
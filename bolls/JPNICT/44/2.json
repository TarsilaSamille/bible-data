","tok":[["彼","かれ"],["ら"],["は"],["、"],["使徒","しと"],["の"],["教え","おしえ"],["、"],["相互","そうご"],["の"],["交わり","まじわり"],["、"],["パン"],["を"],["裂く","さく"],["こと"],["、"],["祈る","いのる"],["こと"],["に"],["熱心","ねっしん"],["で"],["あった"],["。"]]},{"verse":43,"text":"すべての人に恐れが生じた。使徒たちによって多くの不思議な業としるしが行われていたのである。","tok":[["すべて"],["の"],["人","ひと"],["に"],["恐れ","おそれ"],["が"],["生じた","しょうじた"],["。"],["使徒","しと"],["たち"],["によって"],["多く","おおく"],["の"],["不思議","ふしぎ"],["な"],["業","ごう"],["と"],["しるし"],["が"],["行われて","おこなわれて"],["いた"],["ので"],["ある"],["。"]]},{"verse":44,"text":"信者たちは皆一つになって、すべての物を共有にし、","tok":[["信者","しんじゃ"],["たち"],["は"],["皆","みな"],["一","ひと"],["つ"],["に"],["なって"],["、"],["すべて"],["の"],["物","もの"],["を"],["共有","きょうゆう"],["に"],["し"],["、"]]},{"verse":45,"text":"財産や持ち物を売り、おのおのの必要に応じて、皆がそれを分け合った。","tok":[["財産","ざいさん"],["や"],["持ち物","もちもの"],["を"],["売り","うり"],["、"],["おのおの"],["の"],["必要","ひつよう"],["に"],["応じて","おうじて"],["、"],["皆","みな"],["が"],["それ"],["を"],["分け合った","わけあった"],["。"]]},{"verse":46,"text":"そして、毎日ひたすら心を一つにして神殿に参り、家ごとに集まってパンを裂き、喜びと真心をもって一緒に食事をし、","tok":[["そして"],["、"],["毎日","まいにち"],["ひたすら"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["して"],["神殿","しんでん"],["に"],["参り","まいり"],["、"],["家","いえ"],["ごと"],["に"],["集まって","あつまって"],["パン"],["を"],["裂き","さき"],["、"],["喜び","よろこび"],["と"],["真心","まごころ"],["を"],["もって"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["を"],["し"],["、"]]},{"verse":47,"text":"神を賛美していたので、民衆全体から好意を寄せられた。こうして、主は救われる人々を日々仲間に加え一つにされたのである。","tok":[["神","かみ"],["を"],["賛美","さんび"],["して"],["いた"],["ので"],["、"],["民衆","みんしゅう"],["全体","ぜんたい"],["から"],["好意","こうい"],["を"],["寄せられた","よせられた"],["。"],["こう"],["して"],["、"],["主","ぬし"],["は"],["救われる","すくわれる"],["人々","ひとびと"],["を"],["日々","ひび"],["仲間","なかま"],["に"],["加え","くわえ"],["一","ひと"],["つ"],["に"],["された"],["ので"],["ある"],["。"]]}]
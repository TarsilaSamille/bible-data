[{"verse":1,"text":"五旬祭の日が来て、一同が一つになって集まっていると、","tok":[["五","ご"],["旬祭","しゅんさい"],["の"],["日","ひ"],["が"],["来て","きて"],["、"],["一同","いちどう"],["が"],["一","ひと"],["つ"],["に"],["なって"],["集まって","あつまって"],["いる"],["と"],["、"]]},{"verse":2,"text":"突然、激しい風が吹いて来るような音が天から聞こえ、彼らが座っていた家中に響いた。","tok":[["突然","とつぜん"],["、"],["激しい","はげしい"],["風","かぜ"],["が"],["吹いて","ふいて"],["来る","くる"],["よう"],["な"],["音","おと"],["が"],["天","てん"],["から"],["聞こえ","きこえ"],["、"],["彼","かれ"],["ら"],["が"],["座って","すわって"],["いた"],["家中","いえちゅう"],["に"],["響いた","ひびいた"],["。"]]},{"verse":3,"text":"そして、炎のような舌が分かれ分かれに現れ、一人一人の上にとどまった。","tok":[["そして"],["、"],["炎","ほのお"],["の"],["よう"],["な"],["舌","した"],["が"],["分かれ分かれ","わかれわかれ"],["に"],["現れ","あらわれ"],["、"],["一人一人","ひとりひとり"],["の"],["上","うえ"],["に"],["とどまった"],["。"]]},{"verse":4,"text":"すると、一同は聖霊に満たされ、“霊”が語らせるままに、ほかの国々の言葉で話しだした。","tok":[["する"],["と"],["、"],["一同","いちどう"],["は"],["聖霊","せいれい"],["に"],["満たされ","みたされ"],["、"],["“"],["霊","れい"],["”"],["が"],["語らせる","かたらせる"],["まま"],["に"],["、"],["ほか"],["の"],["国々","くにぐに"],["の"],["言葉","ことば"],["で"],["話し","はなし"],["だした"],["。"]]},{"verse":5,"text":"さて、エルサレムには天下のあらゆる国から帰って来た、信心深いユダヤ人が住んでいたが、","tok":[["さて"],["、"],["エルサレム"],["に"],["は"],["天下","てんか"],["の"],["あらゆる"],["国","くに"],["から"],["帰って","かえって"],["来た","きた"],["、"],["信心","しんじん"],["深い","ふかい"],["ユダヤ人","ゆだやじん"],["が"],["住んで","すんで"],["いた"],["が"],["、"]]},{"verse":6,"text":"この物音に大勢の人が集まって来た。そして、だれもかれも、自分の故郷の言葉が話されているのを聞いて、あっけにとられてしまった。","tok":[["この"],["物音","ものおと"],["に"],["大勢","おおぜい"],["の"],["人","ひと"],["が"],["集まって","あつまって"],["来た","きた"],["。"],["そして"],["、"],["だれ"],["も"],["かれ"],["も"],["、"],["自分","じぶん"],["の"],["故郷","こきょう"],["の"],["言葉","ことば"],["が"],["話されて","はなされて"],["いる"],["の"],["を"],["聞いて","きいて"],["、"],["あっけ"],["に"],["とられて"],["しまった"],["。"]]},{"verse":7,"text":"人々は驚き怪しんで言った。「話をしているこの人たちは、皆ガリラヤの人ではないか。","tok":[["人々","ひとびと"],["は"],["驚き怪しんで","おどろきあやしんで"],["言った","いった"],["。"],["「"],["話","はなし"],["を"],["して"],["いる"],["この"],["人","ひと"],["たち"],["は"],["、"],["皆","みな"],["ガリラヤ"],["の"],["人","ひと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":8,"text":"どうしてわたしたち
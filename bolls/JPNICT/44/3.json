[{"verse":1,"text":"ペトロとヨハネが、午後三時の祈りの時に神殿に上って行った。","tok":[["ペトロ"],["と"],["ヨハネ"],["が"],["、"],["午後","ごご"],["三","さん"],["時","じ"],["の"],["祈り","いのり"],["の"],["時","とき"],["に"],["神殿","しんでん"],["に"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":2,"text":"すると、生まれながら足の不自由な男が運ばれて来た。神殿の境内に入る人に施しを乞うため、毎日「美しい門」という神殿の門のそばに置いてもらっていたのである。","tok":[["する"],["と"],["、"],["生まれ","うまれ"],["ながら"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["男","おとこ"],["が"],["運ばれて","はこばれて"],["来た","きた"],["。"],["神殿","しんでん"],["の"],["境内","けいだい"],["に"],["入る","はいる"],["人","ひと"],["に"],["施し","ほどこし"],["を"],["乞う","こう"],["ため"],["、"],["毎日","まいにち"],["「"],["美しい","うつくしい"],["門","もん"],["」"],["と"],["いう"],["神殿","しんでん"],["の"],["門","もん"],["の"],["そば"],["に"],["置いて","おいて"],["もらって"],["いた"],["ので"],["ある"],["。"]]},{"verse":3,"text":"彼はペトロとヨハネが境内に入ろうとするのを見て、施しを乞うた。","tok":[["彼","かれ"],["は"],["ペトロ"],["と"],["ヨハネ"],["が"],["境内","けいだい"],["に"],["入ろう","はいろう"],["と"],["する"],["の"],["を"],["見て","みて"],["、"],["施し","ほどこし"],["を"],["乞うた","こうた"],["。"]]},{"verse":4,"text":"ペトロはヨハネと一緒に彼をじっと見て、「わたしたちを見なさい」と言った。","tok":[["ペトロ"],["は"],["ヨハネ"],["と"],["一緒","いっしょ"],["に"],["彼","かれ"],["を"],["じっと"],["見て","みて"],["、"],["「"],["わたしたち"],["を"],["見","み"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"その男が、何かもらえると思って二人を見つめていると、","tok":[["その"],["男","おとこ"],["が"],["、"],["何","なん"],["か"],["もらえる"],["と"],["思って","おもって"],["二人","ふたり"],["を"],["見つめて","みつめて"],["いる"],["と"],["、"]]},{"verse":6,"text":"ペトロは言った。「わたしには金や銀はないが、持っているものをあげよう。ナザレの人イエス‧キリストの名によって立ち上がり、歩きなさい。」","tok":[["ペトロ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["に"],["は"],["金","きん"],["や"],["銀","ぎん"],["は"],["ない"],["が"],["、"],["持って","もって"],["いる"],["もの"],["を"],["あげよう"],["。"],["ナザレ"],["の"],["人","ひと"],["イエス"],["‧"],["キリスト"],["の"],["名","な"],["によって"],["立ち上がり","たちあがり"],["、"],["歩き","あるき"],["なさい"],["。"],["」"]]},{"verse":7,"text":"そして、右手を取って彼を立ち上がらせた。すると、たちまち、その男は足やくるぶしがしっかりして、","tok":[["そして"],["、"],["右手","みぎて"],["を"],["取って","とって"],["彼","かれ"],["を"],["立ち上がらせた","たちあがらせた"],["。"],["する"],["と"],["、"],["たちまち"],["、"],["その"],["男","おとこ"],["は"],["足","あし"],["や"],["くるぶし"],["が"],["しっかり"],["して"],["、"]]},{"verse":8,"text":"躍り上がって立ち、歩きだした。そして、歩き回ったり躍ったりして神を賛美し、二人と一緒に境内に入って行った。","tok":[["躍り上がって","おどりあがって"],["立ち","たち"],["、"],["歩き","あるき"],["だした"],["。"],["そして"],["、"],["歩き回っ","あるきまわっ"],["たり"],["躍っ","おどっ"],["たり"],["して"],["神","かみ"],["を"],["賛美","さんび"],["し"],["、"],["二人","ふたり"],["と"],["一緒","いっしょ"],["に"],["境内","けいだい"],["に"],["入って","はいって"],["行った","いった"],["。"]]},{"verse":9,"text":"民衆は皆、彼が歩き回り、神を賛美しているのを見た。","tok":[["民衆","みんしゅう"],["は"],["皆","みな"],["、"],["彼","かれ"],["が"],["歩き回り","あるきまわり"],["、"],["神","かみ"],["を"],["賛美","さんび"],["して"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":10,"text":"彼らは、それが神殿の「美しい門」のそばに座って施しを乞うていた者だと気づき、その身に起こったことに我を忘れるほど驚いた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["それ"],["が"],["神殿","しんでん"],["の"],["「"],["美しい","うつくしい"],["門","もん"],["」"],["の"],["そば"],["に"],["座って","すわって"],["施し","ほどこし"],["を"],["乞うて","こうて"],["いた"],["者","もの"],["だ"],["と"],["気づき","きづき"],["、"],["その"],["身","み"],["に"],["起こった","おこった"],["こと"],["に"],["我","われ"],["を"],["忘れる","わすれる"],["ほど"],["驚いた","おどろいた"],["。"]]},{"verse":11,"text":"さて、その男がペトロとヨハネに付きまとっていると、民衆は皆非常に驚いて、「ソロモンの回廊」と呼ばれる所にいる彼らの方へ、一斉に集まって来た。","tok":[["さて"],["、"],["その"],["男","おとこ"],["が"],["ペトロ"],["と"],["ヨハネ"],["に"],["付きまとって","つきまとって"],["いる"],["と"],["、"],["民衆","みんしゅう"],["は"],["皆","みな"],["非常","ひじょう"],["に"],["驚いて","おどろいて"],["、"],["「"],["ソロモン"],["の"],["回廊","かいろう"],["」"],["と"],["呼ばれる","よばれる"],["所","ところ"],["に"],["いる"],["彼","かれ"],["ら"],["の"],["方","ほう"],["へ"],["、"],["一斉","いっせい"],["に"],["集まって","あつまって"],["来た","きた"],["。"]]},{"verse":12,"text":"これを見たペトロは、民衆に言った。「イスラエルの人たち、なぜこのことに驚くのですか。また、わたしたちがまるで自分の力や信心によって、この人を歩かせたかのように、なぜ、わたしたちを見つめるのですか。","tok":[["これ"],["を"],["見た","みた"],["ペトロ"],["は"],["、"],["民衆","みんしゅう"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["人","ひと"],["たち"],["、"],["なぜ"],["この"],["こと"],["に"],["驚く","おどろく"],["の"],["です"],["か"],["。"],["また"],["、"],["わたしたち"],["が"],["まるで"],["自分","じぶん"],["の"],["力","ちから"],["や"],["信心","しんじん"],["によって"],["、"],["この"],["人","ひと"],["を"],["歩かせた","あるかせた"],["か"],["の"],["よう"],["に"],["、"],["なぜ"],["、"],["わたしたち"],["を"],["見つめる","みつめる"],["の"],["です"],["か"],["。"]]},{"verse":13,"text":"アブラハムの神、イサクの神、ヤコブの神、わたしたちの先祖の神は、その僕イエスに栄光をお与えになりました。ところが、あなたがたはこのイエスを引き渡し、ピラトが釈放しようと決めていたのに、その面前でこの方を拒みました。","tok":[["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["、"],["わたしたち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["は"],["、"],["その"],["僕","ぼく"],["イエス"],["に"],["栄光","えいこう"],["を"],["お与え","おあたえ"],["に"],["なりました"],["。"],["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["この"],["イエス"],["を"],["引き渡し","ひきわたし"],["、"],["ピラト"],["が"],["釈放","しゃくほう"],["しよう"],["と"],["決めて","きめて"],["いた"],["のに"],["、"],["その"],["面前","めんぜん"],["で"],["この"],["方","ほう"],["を"],["拒みました","こばみました"],["。"]]},{"verse":14,"text":"聖なる正しい方を拒んで、人殺しの男を赦すように要求したのです。","tok":[["聖","せい"],["なる"],["正しい","ただしい"],["方","ほう"],["を"],["拒んで","こばんで"],["、"],["人殺し","ひとごろし"],["の"],["男","おとこ"],["を"],["赦す","ゆるす"],["よう"],["に"],["要求","ようきゅう"],["した"],["の"],["です"],["。"]]},{"verse":15,"text":"あなたがたは、命への導き手である方を殺してしまいましたが、神はこの方を死者の中から復活させてくださいました。わたしたちは、このことの証人です。","tok":[["あなた"],["がた"],["は"],["、"],["命","いのち"],["へ"],["の"],["導き手","みちびきて"],["で"],["ある"],["方","かた"],["を"],["殺して","ころして"],["しまいました"],["が"],["、"],["神","かみ"],["は"],["この"],["方","ほう"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させて"],["くださいました"],["。"],["わたしたち"],["は"],["、"],["この"],["こと"],["の"],["証人","しょうにん"],["です"],["。"]]},{"verse":16,"text":"あなたがたの見て知っているこの人を、イエスの名が強くしました。それは、その名を信じる信仰によるものです。イエスによる信仰が、あなたがた一同の前でこの人を完全にいやしたのです。","tok":[["あなた"],["がた"],["の"],["見て","みて"],["知って","しって"],["いる"],["この"],["人","ひと"],["を"],["、"],["イエス"],["の"],["名","な"],["が"],["強く","つよく"],["しました"],["。"],["それ"],["は"],["、"],["その"],["名","な"],["を"],["信じる","しんじる"],["信仰","しんこう"],["に"],["よる"],["もの"],["です"],["。"],["イエス"],["に"],["よる"],["信仰","しんこう"],["が"],["、"],["あなた"],["がた"],["一同","いちどう"],["の"],["前","まえ"],["で"],["この"],["人","ひと"],["を"],["完全","かんぜん"],["に"],["いやした"],["の"],["です"],["。"]]},{"verse":17,"text":"ところで、兄弟たち、あなたがたがあんなことをしてしまったのは、指導者たちと同様に無知のためであったと、わたしには分かっています。","tok":[["ところ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["が"],["あんな"],["こと"],["を"],["して"],["しまった"],["の"],["は"],["、"],["指導者","しどうしゃ"],["たち"],["と"],["同様","どうよう"],["に"],["無知","むち"],["の"],["ため"],["で"],["あった"],["と"],["、"],["わたし"],["に"],["は"],["分かって","わかって"],["います"],["。"]]},{"verse":18,"text":"しかし、神はすべての預言者の口を通して予告しておられたメシアの苦しみを、このようにして実現なさったのです。","tok":[["しかし"],["、"],["神","かみ"],["は"],["すべて"],["の"],["預言者","よげんしゃ"],["の"],["口","くち"],["を"],["通して","とおして"],["予告","よこく"],["して"],["おられた"],["メシア"],["の"],["苦しみ","くるしみ"],["を"],["、"],["この"],["よう"],["に"],["して"],["実現","じつげん"],["なさった"],["の"],["です"],["。"]]},{"verse":19,"text":"だから、自分の罪が消し去られるように、悔い改めて立ち帰りなさい。","tok":[["だ"],["から"],["、"],["自分","じぶん"],["の"],["罪","つみ"],["が"],["消し去られる","けしさられる"],["よう"],["に"],["、"],["悔い改めて","くいあらためて"],["立ち帰り","たちかえり"],["なさい"],["。"]]},{"verse":20,"text":"こうして、主のもとから慰めの時が訪れ、主はあなたがたのために前もって決めておられた、メシアであるイエスを遣わしてくださるのです。","tok":[["こう"],["して"],["、"],["主","ぬし"],["の"],["もと"],["から"],["慰め","なぐさめ"],["の"],["時","とき"],["が"],["訪れ","おとずれ"],["、"],["主","ぬし"],["は"],["あなた"],["がた"],["の"],["ため"],["に"],["前もって","まえもって"],["決めて","きめて"],["おられた"],["、"],["メシア"],["で"],["ある"],["イエス"],["を"],["遣わして","つかわして"],["くださる"],["の"],["です"],["。"]]},{"verse":21,"text":"このイエスは、神が聖なる預言者たちの口を通して昔から語られた、万物が新しくなるその時まで、必ず天にとどまることになっています。","tok":[["この"],["イエス"],["は"],["、"],["神","かみ"],["が"],["聖","せい"],["なる"],["預言者","よげんしゃ"],["たち"],["の"],["口","くち"],["を"],["通して","とおして"],["昔","むかし"],["から"],["語られた","かたられた"],["、"],["万物","ばんぶつ"],["が"],["新しく","あたらしく"],["なる"],["その"],["時","とき"],["まで"],["、"],["必ず","かならず"],["天","てん"],["に"],["とどまる"],["こと"],["に"],["なって"],["います"],["。"]]},{"verse":22,"text":"モーセは言いました。『あなたがたの神である主は、あなたがたの同胞の中から、わたしのような預言者をあなたがたのために立てられる。彼が語りかけることには、何でも聞き従え。","tok":[["モーセ"],["は"],["言いました","いいました"],["。"],["『"],["あなた"],["がた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["あなた"],["がた"],["の"],["同胞","どうほう"],["の"],["中","なか"],["から"],["、"],["わたし"],["の"],["よう"],["な"],["預言者","よげんしゃ"],["を"],["あなた"],["がた"],["の"],["ため"],["に"],["立てられる","たてられる"],["。"],["彼","かれ"],["が"],["語りかける","かたりかける"],["こと"],["に"],["は"],["、"],["何","なん"],["で"],["も"],["聞き従え","ききしたがえ"],["。"]]},{"verse":23,"text":"この預言者に耳を傾けない者は皆、民の中から滅ぼし絶やされる。』","tok":[["この"],["預言者","よげんしゃ"],["に"],["耳","みみ"],["を"],["傾けない","かたむけない"],["者","もの"],["は"],["皆","みな"],["、"],["民","みん"],["の"],["中","なか"],["から"],["滅ぼし","ほろぼし"],["絶やされる","たやされる"],["。"],["』"]]},{"verse":24,"text":"預言者は皆、サムエルをはじめその後に預言した者も、今の時について告げています。","tok":[["預言者","よげんしゃ"],["は"],["皆","みな"],["、"],["サムエル"],["を"],["はじめ"],["その後","そのあと"],["に"],["預言","よげん"],["した"],["者","もの"],["も"],["、"],["今","いま"],["の"],["時","とき"],["について"],["告げて","つげて"],["います"],["。"]]},{"verse":25,"text":"あなたがたは預言者の子孫であり、神があなたがたの先祖と結ばれた契約の子です。『地上のすべての民族は、あなたから生まれる者によって祝福を受ける』と、神はアブラハムに言われました。","tok":[["あなた"],["がた"],["は"],["預言者","よげんしゃ"],["の"],["子孫","しそん"],["で"],["あり"],["、"],["神","かみ"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["の"],["子","こ"],["です"],["。"],["『"],["地上","ちじょう"],["の"],["すべて"],["の"],["民族","みんぞく"],["は"],["、"],["あなた"],["から"],["生まれる","うまれる"],["者","もの"],["によって"],["祝福","しゅくふく"],["を"],["受ける","うける"],["』"],["と"],["、"],["神","かみ"],["は"],["アブラハム"],["に"],["言われました","いわれました"],["。"]]},{"verse":26,"text":"それで、神は御自分の僕を立て、まず、あなたがたのもとに遣わしてくださったのです。それは、あなたがた一人一人を悪から離れさせ、その祝福にあずからせるためでした。」","tok":[["それ"],["で"],["、"],["神","かみ"],["は"],["御自分","ごじぶん"],["の"],["僕","ぼく"],["を"],["立て","たて"],["、"],["まず"],["、"],["あなた"],["がた"],["の"],["もと"],["に"],["遣わして","つかわして"],["くださった"],["の"],["です"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["一人一人","ひとりひとり"],["を"],["悪","わる"],["から"],["離れさせ","はなれさせ"],["、"],["その"],["祝福","しゅくふく"],["に"],["あずからせる"],["ため"],["でした"],["。"],["」"]]}]
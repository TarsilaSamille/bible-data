[{"verse":1,"text":"パウロは、デルベにもリストラにも行った。そこに、信者のユダヤ婦人の子で、ギリシア人を父親に持つ、テモテという弟子がいた。","tok":[["パウロ"],["は"],["、"],["デルベ"],["に"],["も"],["リストラ"],["に"],["も"],["行った","おこなった"],["。"],["そこ"],["に"],["、"],["信者","しんじゃ"],["の"],["ユダヤ"],["婦人","ふじん"],["の"],["子","こ"],["で"],["、"],["ギリシア"],["人","にん"],["を"],["父親","ちちおや"],["に"],["持つ","もつ"],["、"],["テモテ"],["と"],["いう"],["弟子","でし"],["が"],["いた"],["。"]]},{"verse":2,"text":"彼は、リストラとイコニオンの兄弟の間で評判の良い人であった。","tok":[["彼","かれ"],["は"],["、"],["リストラ"],["と"],["イコニオン"],["の"],["兄弟","きょうだい"],["の"],["間","あいだ"],["で"],["評判","ひょうばん"],["の"],["良い","よい"],["人","ひと"],["で"],["あった"],["。"]]},{"verse":3,"text":"パウロは、このテモテを一緒に連れて行きたかったので、その地方に住むユダヤ人の手前、彼に割礼を授けた。父親がギリシア人であることを、皆が知っていたからである。","tok":[["パウロ"],["は"],["、"],["この"],["テモテ"],["を"],["一緒","いっしょ"],["に"],["連れて","つれて"],["行きたかった","いきたかった"],["ので"],["、"],["その"],["地方","ちほう"],["に"],["住む","すむ"],["ユダヤ人","ゆだやじん"],["の"],["手前","てまえ"],["、"],["彼","かれ"],["に"],["割礼","かつれい"],["を"],["授けた","さずけた"],["。"],["父親","ちちおや"],["が"],["ギリシア"],["人","にん"],["で"],["ある"],["こと"],["を"],["、"],["皆","みな"],["が"],["知って","しって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼らは方々の町を巡回して、エルサレムの使徒と長老たちが決めた規定を守るようにと、人々に伝えた。","tok":[["彼","かれ"],["ら"],["は"],["方々","かたがた"],["の"],["町","まち"],["を"],["巡回","じゅんかい"],["して"],["、"],["エルサレム"],["の"],["使徒","しと"],["と"],["長老","ちょうろう"],["たち"],["が"],["決めた","きめた"],["規定","きてい"],["を"],["守る","まもる"],["よう"],["に"],["と"],["、"],["人々","ひとびと"],["に"],["伝えた","つたえた"],["。"]]},{"verse":5,"text":"こうして、教会は信仰を強められ、日ごとに人数が増えていった。","tok":[["こう"],["して"],["、"],["教会","きょうかい"],["は"],["信仰","しんこう"],["を"],["強められ","つよめられ"],["、"],["日ごと","ひごと"],["に"],["人数","にんずう"],["が"],["増えて","ふえて"],["いった"],["。"]]},{"verse":6,"text":"さて、彼らはアジア州で御言葉を語ることを聖霊から禁じられたので、フリギア‧ガラテヤ地方を通って行った。","tok":[["さて"],["、"],["彼","かれ"],["ら"],["は"],["アジア州","あじあしゅう"],["で"],["御言葉","おことば"],["を"],["語る","かたる"],["こと"],["を"],["聖霊","せいれい"],["から"],["禁じられた","きんじられた"],["ので"],["、"],["フリギア"],["‧"],["ガラテヤ"],["地方","ちほう"],["を"],["通って","とおって"],["行った","いった"],["。"]]},{"verse":7,"text":"ミシア地方の近くまで行き、ビティニア州に入ろうとしたが、イエスの霊がそれを許さなかった。","tok":[["ミシア"],["地方","ちほう"],["の"],["近く","ちかく"],["まで"],["行き","いき"],["、"],["ビティニア"],["州","しゅう"],["に"],["入ろう","はいろう"],["と"],["した"],["が"],["、"],["イエス"],["の"],["霊","れい"],["が"],["それ"],["を"],["許さなかった","ゆるさなかった"],["。"]]},{"verse":8,"text":"それで、ミシア地方を通ってトロアスに下った。","tok":[["それ"],["で"],["、"],["ミシア"],["地方","ちほう"],["を"],["通って","とおって"],["トロアス"],["に"],["下った","くだった"],["。"]]},{"verse":9,"text":"その夜、パウロは幻を見た。その中で一人のマケドニア人が立って、「マケドニア州に渡って来て、わたしたちを助けてください」と言ってパウロに願った。","tok":[["その"],["夜","よる"],["、"],["パウロ"],["は"],["幻","まぼろし"],["を"],["見た","みた"],["。"],["その"],["中","なか"],["で"],["一人","ひとり"],["の"],["マケドニア"],["人","にん"],["が"],["立って","たって"],["、"],["「"],["マケドニア"],["州","しゅう"],["に"],["渡って","わたって"],["来て","きて"],["、"],["わたしたち"],["を"],["助けて","たすけて"],["ください"],["」"],["と"],["言って","いって"],["パウロ"],["に"],["願った","ねがった"],["。"]]},{"verse":10,"text":"パウロがこの幻を見たとき、わたしたちはすぐにマケドニアへ向けて出発することにした。マケドニア人に福音を告げ知らせるために、神がわたしたちを召されているのだと、確信するに至ったからである。","tok":[["パウロ"],["が"],["この"],["幻","まぼろし"],["を"],["見た","みた"],["とき"],["、"],["わたしたち"],["は"],["すぐ"],["に"],["マケドニア"],["へ"],["向けて","むけて"],["出発","しゅっぱつ"],["する"],["こと"],["に"],["した"],["。"],["マケドニア"],["人","にん"],["に"],["福音","ふくいん"],["を"],["告げ知らせる","つげしらせる"],["ため"],["に"],["、"],["神","かみ"],["が"],["わたしたち"],["を"],["召されて","めされて"],["いる"],["の"],["だ"],["と"],["、"],["確信","かくしん"],["する"],["に"],["至った","いたった"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしたちはトロアスから船出してサモトラケ島に直航し、翌日ネアポリスの港に着き、","tok":[["わたしたち"],["は"],["トロアス"],["から"],["船出","ふなで"],["して"],["サモトラケ"],["島","とう"],["に"],["直航","ちょっこう"],["し"],["、"],["翌日","よくじつ"],["ネアポリス"],["の"],["港","みなと"],["に"],["着き","つき"],["、"]]},{"verse":12,"text":"そこから、マケドニア州第一区の都市で、ローマの植民都市であるフィリピに行った。そして、この町に数日間滞在した。","tok":[["そこ"],["から"],["、"],["マケドニア"],["州","しゅう"],["第","だい"],["一区","いちく"],["の"],["都市","とし"],["で"],["、"],["ローマ"],["の"],["植民","しょくみん"],["都市","とし"],["で"],["ある"],["フィリピ"],["に"],["行った","いった"],["。"],["そして"],["、"],["この"],["町","まち"],["に"],["数日間","すうじつかん"],["滞在","たいざい"],["した"],["。"]]},{"verse":13,"text":"安息日に町の門を出て、祈りの場所があると思われる川岸に行った。そして、わたしたちもそこに座って、集まっていた婦人たちに話をした。","tok":[["安息日","あんそくび"],["に"],["町","まち"],["の"],["門","もん"],["を"],["出て","でて"],["、"],["祈り","いのり"],["の"],["場所","ばしょ"],["が"],["ある"],["と"],["思われる","おもわれる"],["川岸","かわぎし"],["に"],["行った","いった"],["。"],["そして"],["、"],["わたしたち"],["も"],["そこ"],["に"],["座って","すわって"],["、"],["集まって","あつまって"],["いた"],["婦人","ふじん"],["たち"],["に"],["話","はなし"],["を"],["した"],["。"]]},{"verse":14,"text":"ティアティラ市出身の紫布を商う人で、神をあがめるリディアという婦人も話を聞いていたが、主が彼女の心を開かれたので、彼女はパウロの話を注意深く聞いた。","tok":[["ティア"],["ティラ"],["市","し"],["出身","しゅっしん"],["の"],["紫布","むらさきぬの"],["を"],["商う","あきなう"],["人","ひと"],["で"],["、"],["神","かみ"],["を"],["あがめる"],["リディア"],["と"],["いう"],["婦人","ふじん"],["も"],["話","はなし"],["を"],["聞いて","きいて"],["いた"],["が"],["、"],["主","ぬし"],["が"],["彼女","かのじょ"],["の"],["心","こころ"],["を"],["開かれた","ひらかれた"],["ので"],["、"],["彼女","かのじょ"],["は"],["パウロ"],["の"],["話","はなし"],["を"],["注意","ちゅうい"],["深く","ふかく"],["聞いた","きいた"],["。"]]},{"verse":15,"text":"そして、彼女も家族の者も洗礼を受けたが、そのとき、「私が主を信じる者だとお思いでしたら、どうぞ、私の家に来てお泊まりください」と言ってわたしたちを招待し、無理に承知させた。","tok":[["そして"],["、"],["彼女","かのじょ"],["も"],["家族","かぞく"],["の"],["者","もの"],["も"],["洗礼","せんれい"],["を"],["受けた","うけた"],["が"],["、"],["その"],["とき"],["、"],["「"],["私","わたくし"],["が"],["主","ぬし"],["を"],["信じる","しんじる"],["者","もの"],["だ"],["と"],["お思い","おおもい"],["でしたら"],["、"],["どうぞ"],["、"],["私","わたくし"],["の"],["家","いえ"],["に"],["来て","きて"],["お泊まり","おとまり"],["ください"],["」"],["と"],["言って","いって"],["わたしたち"],["を"],["招待","しょうたい"],["し"],["、"],["無理","むり"],["に"],["承知","しょうち"],["させた"],["。"]]},{"verse":16,"text":"わたしたちは、祈りの場所に行く途中、占いの霊に取りつかれている女奴隷に出会った。この女は、占いをして主人たちに多くの利益を得させていた。","tok":[["わたしたち"],["は"],["、"],["祈り","いのり"],["の"],["場所","ばしょ"],["に"],["行く","いく"],["途中","とちゅう"],["、"],["占い","うらない"],["の"],["霊","れい"],["に"],["取りつかれて","とりつかれて"],["いる"],["女","じょ"],["奴隷","どれい"],["に"],["出会った","であった"],["。"],["この"],["女","おんな"],["は"],["、"],["占い","うらない"],["を"],["して"],["主人","しゅじん"],["たち"],["に"],["多く","おおく"],["の"],["利益","りえき"],["を"],["得させて","えさせて"],["いた"],["。"]]},{"verse":17,"text":"彼女は、パウロやわたしたちの後ろについて来てこう叫ぶのであった。「この人たちは、いと高き神の僕で、皆さんに救いの道を宣べ伝えているのです。」","tok":[["彼女","かのじょ"],["は"],["、"],["パウロ"],["や"],["わたしたち"],["の"],["後ろ","うしろ"],["について"],["来て","きて"],["こう"],["叫ぶ","さけぶ"],["ので"],["あった"],["。"],["「"],["この"],["人","ひと"],["たち"],["は"],["、"],["いと"],["高き","たかき"],["神","かみ"],["の"],["僕","ぼく"],["で"],["、"],["皆","みな"],["さん"],["に"],["救い","すくい"],["の"],["道","みち"],["を"],["宣べ伝えて","のべつたえて"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":18,"text":"彼女がこんなことを幾日も繰り返すので、パウロはたまりかねて振り向き、その霊に言った。「イエス‧キリストの名によって命じる。この女から出て行け。」すると即座に、霊が彼女から出て行った。","tok":[["彼女","かのじょ"],["が"],["こんな"],["こと"],["を"],["幾日","いくか"],["も"],["繰り返す","くりかえす"],["ので"],["、"],["パウロ"],["は"],["たまり"],["かね"],["て"],["振り向き","ふりむき"],["、"],["その"],["霊","れい"],["に"],["言った","いった"],["。"],["「"],["イエス"],["‧"],["キリスト"],["の"],["名","な"],["によって"],["命じる","めいじる"],["。"],["この"],["女","おんな"],["から"],["出て","でて"],["行け","いけ"],["。"],["」"],["する"],["と"],["即座","そくざ"],["に"],["、"],["霊","れい"],["が"],["彼女","かのじょ"],["から"],["出て","でて"],["行った","いった"],["。"]]},{"verse":19,"text":"ところが、この女の主人たちは、金もうけの望みがなくなってしまったことを知り、パウロとシラスを捕らえ、役人に引き渡すために広場へ引き立てて行った。","tok":[["ところ"],["が"],["、"],["この"],["女","おんな"],["の"],["主人","しゅじん"],["たち"],["は"],["、"],["金もうけ","かねもうけ"],["の"],["望み","のぞみ"],["が"],["なくなって"],["しまった"],["こと"],["を"],["知り","しり"],["、"],["パウロ"],["と"],["シラス"],["を"],["捕らえ","とらえ"],["、"],["役人","やくにん"],["に"],["引き渡す","ひきわたす"],["ため"],["に"],["広場","ひろば"],["へ"],["引き立てて","ひきたてて"],["行った","いった"],["。"]]},{"verse":20,"text":"そして、二人を高官たちに引き渡してこう言った。「この者たちはユダヤ人で、わたしたちの町を混乱させております。","tok":[["そして"],["、"],["二人","ふたり"],["を"],["高官","こうかん"],["たち"],["に"],["引き渡して","ひきわたして"],["こう"],["言った","いった"],["。"],["「"],["この"],["者","もの"],["たち"],["は"],["ユダヤ人","ゆだやじん"],["で"],["、"],["わたしたち"],["の"],["町","まち"],["を"],["混乱","こんらん"],["させて"],["おります"],["。"]]},{"verse":21,"text":"ローマ帝国の市民であるわたしたちが受け入れることも、実行することも許されない風習を宣伝しております。」","tok":[["ローマ"],["帝国","ていこく"],["の"],["市民","しみん"],["で"],["ある"],["わたしたち"],["が"],["受け入れる","うけいれる"],["こと"],["も"],["、"],["実行","じっこう"],["する"],["こと"],["も"],["許されない","ゆるされない"],["風習","ふうしゅう"],["を"],["宣伝","せんでん"],["して"],["おります"],["。"],["」"]]},{"verse":22,"text":"群衆も一緒になって二人を責め立
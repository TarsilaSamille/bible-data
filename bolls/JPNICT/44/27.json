[{"verse":1,"text":"わたしたちがイタリアへ向かって船出することに決まったとき、パウロと他の数名の囚人は、皇帝直属部隊の百人隊長ユリウスという者に引き渡された。","tok":[["わたしたち"],["が"],["イタリア"],["へ"],["向かって","むかって"],["船出","ふなで"],["する"],["こと"],["に"],["決まった","きまった"],["とき"],["、"],["パウロ"],["と"],["他","ほか"],["の"],["数","すう"],["名","めい"],["の"],["囚人","しゅうじん"],["は"],["、"],["皇帝","こうてい"],["直属","ちょくぞく"],["部隊","ぶたい"],["の"],["百人","ひゃくにん"],["隊長","たいちょう"],["ユリウス"],["と"],["いう"],["者","もの"],["に"],["引き渡された","ひきわたされた"],["。"]]},{"verse":2,"text":"わたしたちは、アジア州沿岸の各地に寄港することになっている、アドラミティオン港の船に乗って出港した。テサロニケ出身のマケドニア人アリスタルコも一緒であった。","tok":[["わたしたち"],["は"],["、"],["アジア州","あじあしゅう"],["沿岸","えんがん"],["の"],["各地","かくち"],["に"],["寄港","きこう"],["する"],["こと"],["に"],["なって"],["いる"],["、"],["アドラミティオン"],["港","こう"],["の"],["船","ふね"],["に"],["乗って","のって"],["出港","しゅっこう"],["した"],["。"],["テサロニケ"],["出身","しゅっしん"],["の"],["マケドニア"],["人","にん"],["アリスタルコ"],["も"],["一緒","いっしょ"],["で"],["あった"],["。"]]},{"verse":3,"text":"翌日シドンに着いたが、ユリウスはパウロを親切に扱い、友人たちのところへ行ってもてなしを受けることを許してくれた。","tok":[["翌日","よくじつ"],["シドン"],["に"],["着いた","ついた"],["が"],["、"],["ユリウス"],["は"],["パウロ"],["を"],["親切","しんせつ"],["に"],["扱い","あつかい"],["、"],["友人","ゆうじん"],["たち"],["の"],["ところ"],["へ"],["行って","いって"],["もてなし"],["を"],["受ける","うける"],["こと"],["を"],["許して","ゆるして"],["くれた"],["。"]]},{"verse":4,"text":"そこから船出したが、向かい風のためキプロス島の陰を航行し、","tok":[["そこ"],["から"],["船出","ふなで"],["した"],["が"],["、"],["向かい風","むかいかぜ"],["の"],["ため"],["キプロス"],["島","とう"],["の"],["陰","かげ"],["を"],["航行","こうこう"],["し"],["、"]]},{"verse":5,"text":"キリキア州とパンフィリア州の沖を過ぎて、リキア州のミラに着いた。","tok":[["キリキア"],["州","しゅう"],["と"],["パンフィリア"],["州","しゅう"],["の"],["沖","おき"],["を"],["過ぎて","すぎて"],["、"],["リキア"],["州","しゅう"],["の"],["ミラ"],["に"],["着いた","ついた"],["。"]]},{"verse":6,"text":"ここで百人隊長は、イタリアに行くアレクサンドリアの船を見つけて、わたしたちをそれに乗り込ませた。","tok":[["ここ"],["で"],["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["、"],["イタリア"],["に"],["行く","いく"],["アレクサンドリア"],["の"],["船","ふね"],["を"],["見つけて","みつけて"],["、"],["わたしたち"],["を"],["それ"],["に"],["乗り込ませた","のりこませた"],["。"]]},{"verse":7,"text":"幾日もの間、船足ははかどらず、ようやくクニドス港に近づいた。ところが、風に行く手を阻まれたので、サルモネ岬を回ってクレタ島の陰を航行し、","tok":[["幾日","いくか"],["も"],["の"],["間","あいだ"],["、"],["船足","ふなあし"],["は"],["はかどらず"],["、"],["ようやく"],["クニドス"],["港","こう"],["に"],["近づいた","ちかづいた"],["。"],["ところ"],["が"],["、"],["風","かぜ"],["に"],["行く手","ゆくて"],["を"],["阻まれた","はばまれた"],["ので"],["、"],["サルモネ"],["岬","みさき"],["を"],["回って","まわって"],["クレタ島","くれたとう"],["の"],["陰","かげ"],["を"],["航行","こうこう"],["し"],["、"]]},{"verse":8,"text":"ようやく島の岸に沿って進み、ラサヤの町に近い「良い港」と呼ばれる所に着いた。","tok":[["ようやく"],["島","しま"],["の"],["岸","きし"],["に"],["沿って","そって"],["進み","すすみ"],["、"],["ラサヤ"],["の"],["町","まち"],["に"],["近い","ちかい"],["「"],["良い","よい"],["港","みなと"],["」"],["と"],["呼ばれる","よばれる"],["所","ところ"],["に"],["着いた","ついた"],["。"]]},{"verse":9,"text":"かなりの時がたって、既に断食日も過ぎていたので、航海はもう危険であった。それで、パウロは人々に忠告した。","tok":[["かなり"],["の"],["時","とき"],["が"],["たって"],["、"],["既に","すでに"],["断食","だんじき"],["日","ひ"],["も"],["過ぎて","すぎて"],["いた"],["ので"],["、"],["航海","こうかい"],["は"],["もう"],["危険","きけん"],["で"],["あった"],["。"],["それ"],["で"],["、"],["パウロ"],["は"],["人々","ひとびと"],["に"],["忠告","ちゅうこく"],["した"],["。"]]},{"verse":10,"text":"「皆さん、わたしの見るところでは、この航海は積み荷や船体ばかりでなく、わたしたち自身にも危険と多大の損失をもたらすことになります。」","tok":[["「"],["皆","みな"],["さん"],["、"],["わたし"],["の"],["見る","みる"],["ところ"],["で"],["は"],["、"],["この"],["航海","こうかい"],["は"],["積み荷","つみに"],["や"],["船体","せんたい"],["ばかり"],["で"],["なく"],["、"],["わたしたち"],["自身","じしん"],["に"],["も"],["危険","きけん"],["と"],["多大","ただい"],["の"],["損失","そんしつ"],["を"],["もたらす"],["こと"],["に"],["なります"],["。"],["」"]]},{"verse":11,"text":"しかし、百人隊長は、パウロの言ったことよりも、船長や船主の方を信用した。","tok":[["しかし"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["、"],["パウロ"],["の"],["言った","いった"],["こと"],["より"],["も"],["、"],["船長","せんちょう"],["や"],["船主","せんしゅ"],["の"],["方","ほう"],["を"],["信用","しんよう"],["した"],["。"]]},{"verse":12,"text":"この港は冬を越すのに適していなかった。それで、大多数の者の意見により、ここから船出し、できるならばクレタ島で南西と北西に面しているフェニクス港に行き、そこで冬を過ごすことになった。","tok":[["この"],["港","みなと"],["は"],["冬","ふゆ"],["を"],["越す","こす"],["のに"],["適して","てきして"],["いなかった"],["。"],["それ"],["で"],["、"],["大多数","だいたすう"],["の"],["者","もの"],["の"],["意見","いけん"],["に"],["より"],["、"],["ここ"],["から"],["船出","ふなで"],["し"],["、"],["できるならば"],["クレタ島","くれたとう"],["で"],["南西
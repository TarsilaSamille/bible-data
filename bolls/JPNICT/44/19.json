[{"verse":1,"text":"アポロがコリントにいたときのことである。パウロは、内陸の地方を通ってエフェソに下って来て、何人かの弟子に出会い、","tok":[["アポロ"],["が"],["コリント"],["に"],["いた"],["とき"],["の"],["こと"],["で"],["ある"],["。"],["パウロ"],["は"],["、"],["内陸","ないりく"],["の"],["地方","ちほう"],["を"],["通って","とおって"],["エフェソ"],["に"],["下って","くだって"],["来て","きて"],["、"],["何人","なんにん"],["か"],["の"],["弟子","でし"],["に"],["出会い","であい"],["、"]]},{"verse":2,"text":"彼らに、「信仰に入ったとき、聖霊を受けましたか」と言うと、彼らは、「いいえ、聖霊があるかどうか、聞いたこともありません」と言った。","tok":[["彼","かれ"],["ら"],["に"],["、"],["「"],["信仰","しんこう"],["に"],["入った","はいった"],["とき"],["、"],["聖霊","せいれい"],["を"],["受けました","うけました"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["いいえ"],["、"],["聖霊","せいれい"],["が"],["ある"],["か"],["どう"],["か"],["、"],["聞いた","きいた"],["こと"],["も"],["ありません"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"パウロが、「それなら、どんな洗礼を受けたのですか」と言うと、「ヨハネの洗礼です」と言った。","tok":[["パウロ"],["が"],["、"],["「"],["それ"],["なら"],["、"],["どんな"],["洗礼","せんれい"],["を"],["受けた","うけた"],["の"],["です"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"],["「"],["ヨハネ"],["の"],["洗礼","せんれい"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"そこで、パウロは言った。「ヨハネは、自分の後から来る方、つまりイエスを信じるようにと、民に告げて、悔い改めの洗礼を授けたのです。」","tok":[["そこ"],["で"],["、"],["パウロ"],["は"],["言った","いった"],["。"],["「"],["ヨハネ"],["は"],["、"],["自分","じぶん"],["の"],["後","あと"],["から"],["来る","くる"],["方","かた"],["、"],["つまり"],["イエス"],["を"],["信じる","しんじる"],["よう"],["に"],["と"],["、"],["民","みん"],["に"],["告げて","つげて"],["、"],["悔い改め","くいあらため"],["の"],["洗礼","せんれい"],["を"],["授けた","さずけた"],["の"],["です"],["。"],["」"]]},{"verse":5,"text":"人々はこれを聞いて主イエスの名によって洗礼を受けた。","tok":[["人々","ひとびと"],["は"],["これ"],["を"],["聞いて","きいて"],["主","しゅ"],["イエス"],["の"],["名","な"],["によって"],["洗礼","せんれい"],["を"],["受けた","うけた"],["。"]]},{"verse":6,"text":"パウロが彼らの上に手を置くと、聖霊が降り、その人たちは異言を話したり、預言をしたりした。","tok":[["パウロ"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置く","おく"],["と"],["、"],["聖霊","せいれい"],["が"],["降り","ふり"],["、"],["その"],["人","ひと"],["たち"],["は"],["異言","いげん"],["を"],["話し","はなし"],["たり"],["、"],["預言","よげん"],["を"],["し"],["たり"],["した"],["。"
[{"verse":1,"text":"さて、使徒たちとユダヤにいる兄弟たちは、異邦人も神の言葉を受け入れたことを耳にした。","tok":[["さて"],["、"],["使徒","しと"],["たち"],["と"],["ユダヤ"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["は"],["、"],["異邦人","いほうじん"],["も"],["神","かみ"],["の"],["言葉","ことば"],["を"],["受け入れた","うけいれた"],["こと"],["を"],["耳","みみ"],["に"],["した"],["。"]]},{"verse":2,"text":"ペトロがエルサレムに上って来たとき、割礼を受けている者たちは彼を非難して、","tok":[["ペトロ"],["が"],["エルサレム"],["に"],["上って","のぼって"],["来た","きた"],["とき"],["、"],["割礼","かつれい"],["を"],["受けて","うけて"],["いる"],["者","もの"],["たち"],["は"],["彼","かれ"],["を"],["非難","ひなん"],["して"],["、"]]},{"verse":3,"text":"「あなたは割礼を受けていない者たちのところへ行き、一緒に食事をした」と言った。","tok":[["「"],["あなた"],["は"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["者","もの"],["たち"],["の"],["ところ"],["へ"],["行き","いき"],["、"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["を"],["した"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"そこで、ペトロは事の次第を順序正しく説明し始めた。","tok":[["そこ"],["で"],["、"],["ペトロ"],["は"],["事","こと"],["の"],["次第","しだい"],["を"],["順序","じゅんじょ"],["正しく","ただしく"],["説明","せつめい"],["し"],["始めた","はじめた"],["。"]]},{"verse":5,"text":"「わたしがヤッファの町にいて祈っていると、我を忘れたようになって幻を見ました。大きな布のような入れ物が、四隅でつるされて、天からわたしのところまで下りて来たのです。","tok":[["「"],["わたし"],["が"],["ヤッファ"],["の"],["町","まち"],["に"],["いて"],["祈って","いのって"],["いる"],["と"],["、"],["我","われ"],["を"],["忘れた","わすれた"],["よう"],["に"],["なって"],["幻","まぼろし"],["を"],["見ました","みました"],["。"],["大きな","おおきな"],["布","ぬの"],["の"],["よう"],["な"],["入れ物","いれもの"],["が"],["、"],["四隅","よすみ"],["で"],["つるされて"],["、"],["天","てん"],["から"],["わたし"],["の"],["ところ"],["まで"],["下りて","おりて"],["来た","きた"],["の"],["です"],["。"]]},{"verse":6,"text":"その中をよく見ると、地上の獣、野獣、這うもの、空の鳥などが入っていました。","tok":[["その"],["中","なか"],["を"],["よく"],["見る","みる"],["と"],["、"],["地上","ちじょう"],["の"],["獣","けもの"],["、"],["野獣","やじゅう"],["、"],["這う","はう"],["もの"],["、"],["空","そら"],["の"],["鳥","とり"],["など"],["が"],["入って","はいって"],["いました"],["。"]]},{"verse":7,"text":"そして、『ペトロよ、身を起こし、屠って食べなさい』と言う声を聞きましたが、","tok":[["そして"],["、"],["『"],["ペトロ"],["よ"],["、"],["身","み"],["を"],["起こし","おこし"],["、"],["屠って","ほふって"],["食べ","たべ"],["なさい"],["』"],["と"],["言う","いう"],["声","こえ"],["を"],["聞きました","ききました"],["が"],["、"]]},{"verse":8,"text":"わたしは言いました。『主よ、とんでもないことです。清くない物、汚れた物は口にしたことがありません。』","tok":[["わたし"],["は"],["言いました","いいました"],["。"],["『"],["主","ぬし"],["よ"],["、"],["とんでも"],["ない"],["こと"],["です"],["。"],["清く","きよく"],["ない"],["物","もの"],["、"],["汚れた","よごれた"],["物","もの"],["は"],["口","くち"],["に"],["した"],["こと"],["が"],["ありません"],["。"],["』"]]},{"verse":9,"text":"すると、『神が清めた物を、清くないなどと、あなたは言ってはならない』と、再び天から声が返って来ました。","tok":[["する"],["と"],["、"],["『"],["神","かみ"],["が"],["清めた","きよめた"],["物","もの"],["を"],["、"],["清く","きよく"],["ない"],["など"],["と"],["、"],["あなた"],["は"],["言って","いって"],["は"],["ならない"],["』"],["と"],["、"],["再び","ふたたび"],["天","てん"],["から"],["声","こえ"],["が"],["返って","かえって"],["来ました","きました"],["。"]]},{"verse":10,"text":"こういうことが三度あって、また全部の物が天に引き上げられてしまいました。","tok":[["こう"],["いう"],["こと"],["が"],["三","さん"],["度","ど"],["あって"],["、"],["また"],["全部","ぜんぶ"],["の"],["物","もの"],["が"],["天","てん"],["に"],["引き上げられて","ひきあげられて"],["しまいました"],["。"]]},{"verse":11,"text":"そのとき、カイサリアからわたしのところに差し向けられた三人の人が、わたしたちのいた家に到着しました。","tok":[["その"],["とき"],["、"],["カイサリア"],["から"],["わたし"],["の"],["ところ"],["に"],["差し向けられた","さしむけられた"],["三人","さんにん"],["の"],["人","ひと"],["が"],["、"],["わたしたち"],["の"],["いた"],["家","いえ"],["に"],["到着","とうちゃく"],["しました"],["。"]]},{"verse":12,"text":"すると、“霊”がわたしに、『ためらわないで一緒に行きなさい』と言われました。ここにいる六人の兄弟も一緒に来て、わたしたちはその人の家に入ったのです。","tok":[["する"],["と"],["、"],["“"],["霊","れい"],["”"],["が"],["わたし"],["に"],["、"],["『"],["ためらわないで"],["一緒","いっしょ"],["に"],["行き","いき"],["なさい"],["』"],["と"],["言われました","いわれました"],["。"],["ここ"],["に"],["いる"],["六人","ろくにん"],["の"],["兄弟","きょうだい"],["も"],["一緒","いっしょ"],["に"],["来て","きて"],["、"],["わたしたち"],["は"],["その"],["人","ひと"],["の"],["家","いえ"],["に"],["入った","はいった"],["の"],["です"],["。"]]},{"verse":13,"text":"彼は、自分の家に天使が立っているのを見たこと、また、その天使が、こう告げたことを話してくれました。『ヤッファに人を送って、ペトロと呼ばれるシモンを招きなさい。","tok":[["彼","かれ"],["は"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["天使","てんし"],["が"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["こと"],["、"],["また"],["、"],["その"],["天使","てんし"],["が"],["、"],["こう"],["告げた","つげた"],["こと"],["を"],["話して","はなして"],["くれました"],["。"],["『"],
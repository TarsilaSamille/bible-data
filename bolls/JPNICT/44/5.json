[{"verse":1,"text":"ところが、アナニアという男は、妻のサフィラと相談して土地を売り、","tok":[["ところ"],["が"],["、"],["アナニア"],["と"],["いう"],["男","おとこ"],["は"],["、"],["妻","つま"],["の"],["サフィラ"],["と"],["相談","そうだん"],["して"],["土地","とち"],["を"],["売り","うり"],["、"]]},{"verse":2,"text":"妻も承知のうえで、代金をごまかし、その一部を持って来て使徒たちの足もとに置いた。","tok":[["妻","つま"],["も"],["承知","しょうち"],["の"],["うえ"],["で"],["、"],["代金","だいきん"],["を"],["ごまかし"],["、"],["その"],["一部","いちぶ"],["を"],["持って","もって"],["来て","きて"],["使徒","しと"],["たち"],["の"],["足もと","あしもと"],["に"],["置いた","おいた"],["。"]]},{"verse":3,"text":"すると、ペトロは言った。「アナニア、なぜ、あなたはサタンに心を奪われ、聖霊を欺いて、土地の代金をごまかしたのか。","tok":[["する"],["と"],["、"],["ペトロ"],["は"],["言った","いった"],["。"],["「"],["アナニア"],["、"],["なぜ"],["、"],["あなた"],["は"],["サタン"],["に"],["心","こころ"],["を"],["奪われ","うばわれ"],["、"],["聖霊","せいれい"],["を"],["欺いて","あざむいて"],["、"],["土地","とち"],["の"],["代金","だいきん"],["を"],["ごまかした"],["の"],["か"],["。"]]},{"verse":4,"text":"売らないでおけば、あなたのものだったし、また、売っても、その代金は自分の思いどおりになったのではないか。どうして、こんなことをする気になったのか。あなたは人間を欺いたのではなく、神を欺いたのだ。」","tok":[["売らないで","うらないで"],["おけば"],["、"],["あなた"],["の"],["もの"],["だった"],["し"],["、"],["また"],["、"],["売って","うって"],["も"],["、"],["その"],["代金","だいきん"],["は"],["自分","じぶん"],["の"],["思い","おもい"],["どおり"],["に"],["なった"],["ので"],["は"],["ない"],["か"],["。"],["どう"],["して"],["、"],["こんな"],["こと"],["を"],["する"],["気","き"],["に"],["なった"],["の"],["か"],["。"],["あなた"],["は"],["人間","にんげん"],["を"],["欺いた","あざむいた"],["ので"],["は"],["なく"],["、"],["神","かみ"],["を"],["欺いた","あざむいた"],["の"],["だ"],["。"],["」"]]},{"verse":5,"text":"この言葉を聞くと、アナニアは倒れて息が絶えた。そのことを耳にした人々は皆、非常に恐れた。","tok":[["この"],["言葉","ことば"],["を"],["聞く","きく"],["と"],["、"],["アナニア"],["は"],["倒れて","たおれて"],["息","いき"],["が"],["絶えた","たえた"],["。"],["その"],["こと"],["を"],["耳","みみ"],["に"],["した"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":6,"text":"若者たちが立ち上がって死体を包み、運び出して葬った。","tok":[["若者","わかもの"],["たち"],["が"],["立ち上がって","たちあがって"],["死体","したい"],["を"],["包み","つつみ"],["、"],["運び出して","はこびだして"],["葬った","ほうむった"],["。"]]},{"verse":7,"text":"それから三時間ほどたって、アナニアの妻がこの出来事を知らずに入って来た。","tok":[["それ"],["から"],["三","さん"],["時間","じかん"],["ほど"],["たって"],["、"],["アナニア"],["の"],["妻","つま"],["が"],["この"],["出来事","できごと"],["を"],["知らず","しらず"],["に"],["入って","はいって"],["来た","きた"],["。"]]},{"verse":8,"text":"ペトロは彼女に話しかけた。「あなたたちは、あの土地をこれこれの値段で売ったのか。言いなさい。」彼女は、「はい、その値段です」と言った。","tok":[["ペトロ"],["は"],["彼女","かのじょ"],["に"],["話しかけた","はなしかけた"],["。"],["「"],["あなた"],["たち"],["は"],["、"],["あの"],["土地","とち"],["を"],["これ"],["これ"],["の"],["値段","ねだん"],["で"],["売った","うった"],["の"],["か"],["。"],["言い","いい"],["なさい"],["。"],["」"],["彼女","かのじょ"],["は"],["、"],["「"],["はい"],["、"],["その"],["値段","ねだん"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"ペトロは言った。「二人で示し合わせて、主の霊を試すとは、何としたことか。見なさい。あなたの夫を葬りに行った人たちが、もう入り口まで来ている。今度はあなたを担ぎ出すだろう。」","tok":[["ペトロ"],["は"],["言った","いった"],["。"],["「"],["二人","ふたり"],["で"],["示し合わせて","しめしあわせて"],["、"],["主","ぬし"],["の"],["霊","れい"],["を"],["試す","ためす"],["と"],["は"],["、"],["何","なん"],["と"],["した"],["こと"],["か"],["。"],["見","み"],["なさい"],["。"],["あなた"],["の"],["夫","おっと"],["を"],["葬り","ほうむり"],["に"],["行った","いった"],["人","ひと"],["たち"],["が"],["、"],["もう"],["入り口","いりぐち"],["まで"],["来て","きて"],["いる"],["。"],["今度","こんど"],["は"],["あなた"],["を"],["担ぎ出すだろう","かつぎだすだろう"],["。"],["」"]]},{"verse":10,"text":"すると、彼女はたちまちペトロの足もとに倒れ、息が絶えた。青年たちは入って来て、彼女の死んでいるのを見ると、運び出し、夫のそばに葬った。","tok":[["する"],["と"],["、"],["彼女","かのじょ"],["は"],["たちまち"],["ペトロ"],["の"],["足もと","あしもと"],["に"],["倒れ","たおれ"],["、"],["息","いき"],["が"],["絶えた","たえた"],["。"],["青年","せいねん"],["たち"],["は"],["入って","はいって"],["来て","きて"],["、"],["彼女","かのじょ"],["の"],["死んで","しんで"],["いる"],["の"],["を"],["見る","みる"],["と"],["、"],["運び出し","はこびだし"],["、"],["夫","おっと"],["の"],["そば"],["に"],["葬った","ほうむった"],["。"]]},{"verse":11,"text":"教会全体とこれを聞いた人は皆、非常に恐れた。","tok":[["教会","きょうかい"],["全体","ぜんたい"],["と"],["これ"],["を"],["聞いた","きいた"],["人","ひと"],["は"],["皆","みな"],["、"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":12,"text":"使徒たちの手によって、多くのしるしと不思議な業とが民衆の間で行われた。一同は心を一つにしてソロモンの回廊に集まっていたが、","tok":[["使徒","しと"],["たち"],["の"],["手","て"],["によって"],["、"],["多く","おおく"],["の"],["しるし"],["と"],["不思議","ふしぎ"],["な"],["業","ごう"],["と"],["が"],["民衆","みんしゅう"],["の"],["間","あいだ"],["で"],["行われた","おこなわれた"],["。"],["一同","いちどう"],["は"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["して"],["ソロモン"],["の"],["回廊","かいろう"],["に"],["集まって","あつまって"],["いた"],["が"],["、"]]},{"verse":13,"text":"ほかの者はだれ一人、あえて仲間に加わろうとはしなかった。しかし、民衆は彼らを称賛していた。","tok":[["ほか"],["の"],["者","もの"],["は"],["だれ"],["一人","ひとり"],["、"],["あえて"],["仲間","なかま"],["に"],["加わろう","くわわろう"],["と"],["は"],["しなかった"],["。"],["しかし"],["、"],["民衆","みんしゅう"],["は"],["彼","かれ"],["ら"],["を"],["称賛","しょうさん"],["して"],["いた"],["。"]]},{"verse":14,"text":"そして、多くの男女が主を信じ、その数はますます増えていった。","tok":[["そして"],["、"],["多く","おおく"],["の"],["男女","だんじょ"],["が"],["主","ぬし"],["を"],["信じ","しんじ"],["、"],["その"],["数","すう"],["は"],["ますます"],["増えて","ふえて"],["いった"],["。"]]},{"verse":15,"text":"人々は病人を大通りに運び出し、担架や床に寝かせた。ペトロが通りかかるとき、せめてその影だけでも病人のだれかにかかるようにした。","tok":[["人々","ひとびと"],["は"],["病人","びょうにん"],["を"],["大通り","おおどおり"],["に"],["運び出し","はこびだし"],["、"],["担架","たんか"],["や"],["床","ゆか"],["に"],["寝かせた","ねかせた"],["。"],["ペトロ"],["が"],["通りかかる","とおりかかる"],["とき"],["、"],["せめて"],["その"],["影","かげ"],["だけ"],["で"],["も"],["病人","びょうにん"],["の"],["だれ"],["か"],["に"],["かかる"],["よう"],["に"],["した"],["。"]]},{"verse":16,"text":"また、エルサレム付近の町からも、群衆が病人や汚れた霊に悩まされている人々を連れて集まって来たが、一人残らずいやしてもらった。","tok":[["また"],["、"],["エルサレム"],["付近","ふきん"],["の"],["町","まち"],["から"],["も"],["、"],["群衆","ぐんしゅう"],["が"],["病人","びょうにん"],["や"],["汚れた","よごれた"],["霊","れい"],["に"],["悩まされて","なやまされて"],["いる"],["人々","ひとびと"],["を"],["連れて","つれて"],["集まって","あつまって"],["来た","きた"],["が"],["、"],["一人","ひとり"],["残らず","のこらず"],["いやして"],["もらった"],["。"]]},{"verse":17,"text":"そこで、大祭司とその仲間のサドカイ派の人々は皆立ち上がり、ねたみに燃えて、","tok":[["そこ"],["で"],["、"],["大","だい"],["祭司","さいし"],["と"],["その"],["仲間","なかま"],["の"],["サドカイ"],["派","は"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["立ち上がり","たちあがり"],["、"],["ねたみ"],["に"],["燃えて","もえて"],["、"]]},{"verse":18,"text":"使徒たちを捕らえて公の牢に入れた。","tok":[["使徒","しと"],["たち"],["を"],["捕らえて","とらえて"],["公","こう"],["の"],["牢","ろう"],["に"],["入れた","いれた"],["。"]]},{"verse":19,"text":"ところが、夜中に主の天使が牢の戸を開け、彼らを外に連れ出し、","tok":[["ところ"],["が"],["、"],["夜中","よなか"],["に"],["主","ぬし"],["の"],["天使","てんし"],["が"],["牢","ろう"],["の"],["戸","と"],["を"],["開け","あけ"],["、"],["彼","かれ"],["ら"],["を"],["外","そと"],["に"],["連れ出し","つれだし"],["、"]]},{"verse":20,"text":"「行って神殿の境内に立ち、この命の言葉を残らず民衆に告げなさい」と言った。","tok":[["「"],["行って","いって"],["神殿","しんでん"],["の"],["境内","けいだい"],["に"],["立ち","たち"],["、"],["この"],["命","いのち"],["の"],["言葉","ことば"],["を"],["残らず","のこらず"],["民衆","みんしゅう"],["に"],["告げ","つげ"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":21,"text":"これを聞いた使徒たちは、夜明けごろ境内に入って教え始めた。一方、大祭司とその仲間が集まり、最高法院、すなわちイスラエルの子らの長老会全体を召集し、使徒たちを引き出すために、人を牢に差し向けた。","tok":[["これ"],["を"],["聞いた","きいた"],["使徒","しと"],["たち"],["は"],["、"],["夜明け","よあけ"],["ごろ"],["境内","けいだい"],["に"],["入って","はいって"],["教え","おしえ"],["始めた","はじめた"],["。"],["一方","いっぽう"],["、"],["大","だい"],["祭司","さいし"],["と"],["その"],["仲間","なかま"],["が"],["集まり","あつまり"],["、"],["最高","さいこう"],["法院","ほういん"],["、"],["すなわち"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["長老","ちょうろう"],["会","かい"],["全体","ぜんたい"],["を"],["召集","しょうしゅう"],["し"],["、"],["使徒","しと"],["たち"],["を"],["引き出す","ひきだす"],["ため"],["に"],["、"],["人","ひと"],["を"],["牢","ろう"],["に"],["差し向けた","さしむけた"],["。"]]},{"verse":22,"text":"下役たちが行ってみると、使徒たちは牢にいなかった。彼らは戻って来て報告した。","tok":[["下役","したやく"],["たち"],["が"],["行って","いって"],["みる"],["と"],["、"],["使徒","しと"],["たち"],["は"],["牢","ろう"],["に"],["いなかった"],["。"],["彼","かれ"],["ら"],["は"],["戻って","もどって"],["来て","きて"],["報告","ほうこく"],["した"],["。"]]},{"verse":23,"text":"「牢にはしっかり鍵がかかっていたうえに、戸の前には番兵が立っていました。ところが、開けてみると、中にはだれもいませんでした。」","tok":[["「"],["牢","ろう"],["に"],["は"],["しっかり"],["鍵","かぎ"],["が"],["かかって"],["いた"],["うえ"],["に"],["、"],["戸","と"],["の"],["前","まえ"],["に"],["は"],["番兵","ばんぺい"],["が"],["立って","たって"],["いました"],["。"],["ところ"],["が"],["、"],["開けて","あけて"],["みる"],["と"],["、"],["中","なか"],["に"],["は"],["だれ"],["も"],["いませんでした"],["。"],["」"]]},{"verse":24,"text":"この報告を聞いた神殿守衛長と祭司長たちは、どうなることかと、使徒たちのことで思い惑った。","tok":[["この"],["報告","ほうこく"],["を"],["聞いた","きいた"],["神殿","しんでん"],["守衛長","しゅえいちょう"],["と"],["祭司長","さいしちょう"],["たち"],["は"],["、"],["どう"],["なる"],["こと"],["か"],["と"],["、"],["使徒","しと"],["たち"],["の"],["こと"],["で"],["思い惑った","おもいまどった"],["。"]]},{"verse":25,"text":"そのとき、人が来て、「御覧ください。あなたがたが牢に入れた者たちが、境内にいて民衆に教えています」と告げた。","tok":[["その"],["とき"],["、"],["人","ひと"],["が"],["来て","きて"],["、"],["「"],["御覧","ごらん"],["ください"],["。"],["あなた"],["がた"],["が"],["牢","ろう"],["に"],["入れた","いれた"],["者","もの"],["たち"],["が"],["、"],["境内","けいだい"],["に"],["いて"],["民衆","みんしゅう"],["に"],["教えて","おしえて"],["います"],["」"],["と"],["告げた","つげた"],["。"]]},{"verse":26,"text":"そこで、守衛長は下役を率いて出て行き、使徒たちを引き立てて来た。しかし、民衆に石を投げつけられるのを恐れて、手荒なことはしなかった。","tok":[["そこ"],["で"],["、"],["守衛長","しゅえいちょう"],["は"],["下役","したやく"],["を"],["率いて","ひきいて"],["出て","でて"],["行き","いき"],["、"],["使徒","しと"],["たち"],["を"],["引き立てて","ひきたてて"],["来た","きた"],["。"],["しかし"],["、"],["民衆","みんしゅう"],["に"],["石","いし"],["を"],["投げつけられる","なげつけられる"],["の"],["を"],["恐れて","おそれて"],["、"],["手荒","てあら"],["な"],["こと"],["は"],["しなかった"],["。"]]},{"verse":27,"text":"彼らが使徒たちを引いて来て最高法院の中に立たせると、大祭司が尋問した。","tok":[["彼","かれ"],["ら"],["が"],["使徒","しと"],["たち"],["を"],["引いて","ひいて"],["来て","きて"],["最高","さいこう"],["法院","ほういん"],["の"],["中","なか"],["に"],["立たせる","たたせる"],["と"],["、"],["大","だい"],["祭司","さいし"],["が"],["尋問","じんもん"],["した"],["。"]]},{"verse":28,"text":"「あの名によって教えてはならないと、厳しく命じておいたではないか。それなのに、お前たちはエルサレム中に自分の教えを広め、あの男の血を流した責任を我々に負わせようとしている。」","tok":[["「"],["あの"],["名","な"],["によって"],["教えて","おしえて"],["は"],["ならない"],["と"],["、"],["厳しく","きびしく"],["命じて","めいじて"],["おいたで"],["は"],["ない"],["か"],["。"],["それ"],["な"],["のに"],["、"],["お前","おまえ"],["たち"],["は"],["エルサレム"],["中","ちゅう"],["に"],["自分","じぶん"],["の"],["教え","おしえ"],["を"],["広め","ひろめ"],["、"],["あの"],["男","おとこ"],["の"],["血","ち"],["を"],["流した","ながした"],["責任","せきにん"],["を"],["我々","われわれ"],["に"],["負わせよう","おわせよう"],["として"],["いる"],["。"],["」"]]},{"verse":29,"text":"ペトロとほかの使徒たちは答えた。「人間に従うよりも、神に従わなくてはなりません。","tok":[["ペトロ"],["と"],["ほか"],["の"],["使徒","しと"],["たち"],["は"],["答えた","こたえた"],["。"],["「"],["人間","にんげん"],["に"],["従う","したがう"],["より"],["も"],["、"],["神","かみ"],["に"],["従わなくて","したがわなくて"],["は"],["なりません"],["。"]]},{"verse":30,"text":"わたしたちの先祖の神は、あなたがたが木につけて殺したイエスを復活させられました。","tok":[["わたしたち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["は"],["、"],["あなた"],["がた"],["が"],["木","き"],["に"],["つけて"],["殺した","ころした"],["イエス"],["を"],["復活","ふっかつ"],["させられました"],["。"]]},{"verse":31,"text":"神はイスラエルを悔い改めさせ、その罪を赦すために、この方を導き手とし、救い主として、御自分の右に上げられました。","tok":[["神","かみ"],["は"],["イスラエル"],["を"],["悔い改めさせ","くいあらためさせ"],["、"],["その"],["罪","つみ"],["を"],["赦す","ゆるす"],["ため"],["に"],["、"],["この"],["方","ほう"],["を"],["導き手","みちびきて"],["と"],["し"],["、"],["救い主","すくいぬし"],["として"],["、"],["御自分","ごじぶん"],["の"],["右","みぎ"],["に"],["上げられました","あげられました"],["。"]]},{"verse":32,"text":"わたしたちはこの事実の証人であり、また、神が御自分に従う人々にお与えになった聖霊も、このことを証ししておられます。」","tok":[["わたしたち"],["は"],["この"],["事実","じじつ"],["の"],["証人","しょうにん"],["で"],["あり"],["、"],["また"],["、"],["神","かみ"],["が"],["御自分","ごじぶん"],["に"],["従う","したがう"],["人々","ひとびと"],["に"],["お与え","おあたえ"],["に"],["なった"],["聖霊","せいれい"],["も"],["、"],["この"],["こと"],["を"],["証し","あかし"],["して"],["おられます"],["。"],["」"]]},{"verse":33,"text":"これを聞いた者たちは激しく怒り、使徒たちを殺そうと考えた。","tok":[["これ"],["を"],["聞いた","きいた"],["者","もの"],["たち"],["は"],["激しく","はげしく"],["怒り","おこり"],["、"],["使徒","しと"],["たち"],["を"],["殺そう","ころそう"],["と"],["考えた","かんがえた"],["。"]]},{"verse":34,"text":"ところが、民衆全体から尊敬されている律法の教師で、ファリサイ派に属するガマリエルという人が、議場に立って、使徒たちをしばらく外に出すように命じ、","tok":[["ところ"],["が"],["、"],["民衆","みんしゅう"],["全体","ぜんたい"],["から"],["尊敬","そんけい"],["されて"],["いる"],["律法","りっぽう"],["の"],["教師","きょうし"],["で"],["、"],["ファリサイ"],["派","は"],["に"],["属する","ぞくする"],["ガマリエル"],["と"],["いう"],["人","ひと"],["が"],["、"],["議場","ぎじょう"],["に"],["立って","たって"],["、"],["使徒","しと"],["たち"],["を"],["しばらく"],["外","そと"],["に"],["出す","だす"],["よう"],["に"],["命じ","めいじ"],["、"]]},{"verse":35,"text":"それから、議員たちにこう言った。「イスラエルの人たち、あの者たちの取り扱いは慎重にしなさい。","tok":[["それ"],["から"],["、"],["議員","ぎいん"],["たち"],["に"],["こう"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["人","ひと"],["たち"],["、"],["あの"],["者","もの"],["たち"],["の"],["取り扱い","とりあつかい"],["は"],["慎重","しんちょう"],["に"],["し"],["なさい"],["。"]]},{"verse":36,"text":"以前にもテウダが、自分を何か偉い者のように言って立ち上がり、その数四百人くらいの男が彼に従ったことがあった。彼は殺され、従っていた者は皆散らされて、跡形もなくなった。","tok":[["以前","いぜん"],["に"],["も"],["テウダ"],["が"],["、"],["自分","じぶん"],["を"],["何","なん"],["か"],["偉い","えらい"],["者","もの"],["の"],
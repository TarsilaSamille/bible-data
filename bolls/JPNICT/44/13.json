[{"verse":1,"text":"アンティオキアでは、そこの教会にバルナバ、ニゲルと呼ばれるシメオン、キレネ人のルキオ、領主ヘロデと一緒に育ったマナエン、サウロなど、預言する者や教師たちがいた。","tok":[["アンティオキア"],["で"],["は"],["、"],["そこ"],["の"],["教会","きょうかい"],["に"],["バルナバ"],["、"],["ニゲル"],["と"],["呼ばれる","よばれる"],["シメオン"],["、"],["キレネ人","きれねにん"],["の"],["ルキオ"],["、"],["領主","りょうしゅ"],["ヘロデ"],["と"],["一緒","いっしょ"],["に"],["育った","そだった"],["マナエン"],["、"],["サウロ"],["など"],["、"],["預言","よげん"],["する"],["者","もの"],["や"],["教師","きょうし"],["たち"],["が"],["いた"],["。"]]},{"verse":2,"text":"彼らが主を礼拝し、断食していると、聖霊が告げた。「さあ、バルナバとサウロをわたしのために選び出しなさい。わたしが前もって二人に決めておいた仕事に当たらせるために。」","tok":[["彼","かれ"],["ら"],["が"],["主","ぬし"],["を"],["礼拝","れいはい"],["し"],["、"],["断食","だんじき"],["して"],["いる"],["と"],["、"],["聖霊","せいれい"],["が"],["告げた","つげた"],["。"],["「"],["さあ"],["、"],["バルナバ"],["と"],["サウロ"],["を"],["わたし"],["の"],["ため"],["に"],["選び出し","えらびだし"],["なさい"],["。"],["わたし"],["が"],["前もって","まえもって"],["二人","ふたり"],["に"],["決めて","きめて"],["おいた"],["仕事","しごと"],["に"],["当たらせる","あたらせる"],["ため"],["に"],["。"],["」"]]},{"verse":3,"text":"そこで、彼らは断食して祈り、二人の上に手を置いて出発させた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["断食","だんじき"],["して"],["祈り","いのり"],["、"],["二人","ふたり"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置いて","おいて"],["出発","しゅっぱつ"],["させた"],["。"]]},{"verse":4,"text":"聖霊によって送り出されたバルナバとサウロは、セレウキアに下り、そこからキプロス島に向け船出し、","tok":[["聖霊","せいれい"],["によって"],["送り出された","おくりだされた"],["バルナバ"],["と"],["サウロ"],["は"],["、"],["セレウキア"],["に"],["下り","くだり"],["、"],["そこ"],["から"],["キプロス"],["島","とう"],["に"],["向け","むけ"],["船出","ふなで"],["し"],["、"]]},{"verse":5,"text":"サラミスに着くと、ユダヤ人の諸会堂で神の言葉を告げ知らせた。二人は、ヨハネを助手として連れていた。","tok":[["サラミス"],["に"],["着く","つく"],["と"],["、"],["ユダヤ人","ゆだやじん"],["の"],["諸","しょ"],["会堂","かいどう"],["で"],["神","かみ"],["の"],["言葉","ことば"],["を"],["告げ知らせた","つげしらせた"],["。"],["二人","ふたり"],["は"],["、"],["ヨハネ"],["を"],["助手","じょしゅ"],["として"],["連れて","つれて"],["いた"],["。"]]},{"verse":6,"text":"島全体を巡ってパフォスまで行くと、ユダヤ人の魔術師で、バルイエスという一人の偽預言者に出会った。","tok":[["島","とう"],["全体","ぜんたい"],["を"],["巡って","めぐって"],["パフォス"],["まで"],["行く","いく"],["と"],["、"],["ユダヤ人","ゆだやじん"],["の"],["魔術師","まじゅつし"],["で"],["、"],["バルイエス"],["と"],["いう"],["一人","ひとり"],["の"],["偽","にせ"],["預言者","よげんしゃ"],["に"],["出会った","であった"],["。"]]},{"verse":7,"text":"この男は、地方総督セルギウス‧パウルスという賢明な人物と交際していた。総督はバルナバとサウロを招いて、神の言葉を聞こうとした。","tok":[["この"],["男","おとこ"],["は"],["、"],["地方","ちほう"],["総督","そうとく"],["セルギウス"],["‧"],["パウルス"],["と"],["いう"],["賢明","けんめい"],["な"],["人物","じんぶつ"],["と"],["交際","こうさい"],["して"],["いた"],["。"],["総督","そうとく"],["は"],["バルナバ"],["と"],["サウロ"],["を"],["招いて","まねいて"],["、"],["神","かみ"],["の"],["言葉","ことば"],["を"],["聞こう","きこう"],["と"],["した"],["。"]]},{"verse":8,"text":"魔術師エリマ――彼の名前は魔術師という意味である――は二人に対抗して、地方総督をこの信仰から遠ざけようとした。","tok":[["魔術師","まじゅつし"],["エリマ"],["―"],["―"],["彼","かれ"],["の"],["名前","なまえ"],["は"],["魔術師","まじゅつし"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["―"],["―"],["は"],["二人","ふたり"],["に"],["対抗","たいこう"],["して"],["、"],["地方","ちほう"],["総督","そうとく"],["を"],["この"],["信仰","しんこう"],["から"],["遠ざけよう","とおざけよう"],["と"],["した"],["。"]]},{"verse":9,"text":"パウロとも呼ばれていたサウロは、聖霊に満たされ、魔術師をにらみつけて、","tok":[["パウロ"],["と"],["も"],["呼ばれて","よばれて"],["いた"],["サウロ"],["は"],["、"],["聖霊","せいれい"],["に"],["満たされ","みたされ"],["、"],["魔術師","まじゅつし"],["を"],["にらみつけて"],["、"]]},{"verse":10,"text":"言った。「ああ、あらゆる偽りと欺きに満ちた者、悪魔の子、すべての正義の敵、お前は主のまっすぐな道をどうしてもゆがめようとするのか。","tok":[["言った","いった"],["。"],["「"],["ああ"],["、"],["あらゆる"],["偽り","いつわり"],["と"],["欺き","あざむき"],["に"],["満ちた","みちた"],["者","もの"],["、"],["悪魔","あくま"],["の"],["子","こ"],["、"],["すべて"],["の"],["正義","せいぎ"],["の"],["敵","てき"],["、"],["お前","おまえ"],["は"],["主","ぬし"],["の"],["まっすぐ"],["な"],["道","みち"],["を"],["どう"],["して"],["も"],["ゆがめよう"],["と"],["する"],["の"],["か"],["。"]]},{"verse":11,"text":"今こそ、主の御手はお前の上に下る。お前は目が見えなくなって、時が来るまで日の光を見ないだろう。」するとたちまち、魔術師は目がかすんできて、すっかり見えなくなり、歩き回りながら、だれか手を引いてくれる人を探した。","tok":[["今","いま"],["こそ"],["、"],["主","ぬし"],["の"],["御手","おて"],["は"],["お前","おまえ"],["の"],["上","うえ"],["に"],["下る","くだる"],["。"],["お前","おまえ"],["は"],["目","め"],["が"],["見えなく","みえなく"],["なって"],["、"],["時","とき"],["が"],["来る","くる"],["まで"],["日","ひ"],["の"],["光","ひかり"],["を"],["見ないだろう","みないだろう"],["。"],["」"],["する"],["と"],["たちまち"],["、"],["魔術師","まじゅつし"],["は"],["目","め"],["が"],["かすんで"],["きて"],["、"],["すっかり"],["見えなく","みえなく"],["なり"],["、"],["歩き回り","あるきまわり"],["ながら"],["、"],["だれ"],["か"],["手","て"],["を"],["引いて","ひいて"],["くれる"],["人","ひと"],["を"],["探した","さがした"],["。"]]},{"verse":12,"text":"総督はこの出来事を見て、主の教えに非常に驚き、信仰に入った。","tok":[["総督","そうとく"],["は"],["この"],["出来事","できごと"],["を"],["見て","みて"],["、"],["主","ぬし"],["の"],["教え","おしえ"],["に"],["非常","ひじょう"],["に"],["驚き","おどろき"],["、"],["信仰","しんこう"],["に"],["入った","はいった"],["。"]]},{"verse":13,"text":"パウロとその一行は、パフォスから船出してパンフィリア州のペルゲに来たが、ヨハネは一行と別れてエルサレムに帰ってしまった。","tok":[["パウロ"],["と"],["その"],["一行","いっこう"],["は"],["、"],["パフォス"],["から"],["船出","ふなで"],["して"],["パンフィリア"],["州","しゅう"],["の"],["ペルゲ"],["に"],["来た","きた"],["が"],["、"],["ヨハネ"],["は"],["一行","いっこう"],["と"],["別れて","わかれて"],["エルサレム"],["に"],["帰って","かえって"],["しまった"],["。"]]},{"verse":14,"text":"パウロとバルナバはペルゲから進んで、ピシディア州のアンティオキアに到着した。そして、安息日に会堂に入って席に着いた。","tok":[["パウロ"],["と"],["バルナバ"],["は"],["ペルゲ"],["から"],["進んで","すすんで"],["、"],["ピシディア"],["州","しゅう"],["の"],["アンティオキア"],["に"],["到着","とうちゃく"],["した"],["。"],["そして"],["、"],["安息日","あんそくび"],["に"],["会堂","かいどう"],["に"],["入って","はいって"],["席","せき"],["に"],["着いた","ついた"],["。"]]},{"verse":15,"text":"律法と預言者の書が朗読された後、会堂長たちが人をよこして、「兄弟たち、何か会衆のために励ましのお言葉があれば、話してください」と言わせた。","tok":[["律法","りっぽう"],["と"],["預言者","よげんしゃ"],["の"],["書","しょ"],["が"],["朗読","ろうどく"],["された"],["後","あと"],["、"],["会堂長","かいどうちょう"],["たち"],["が"],["人","ひと"],["を"],["よこして"],["、"],["「"],["兄弟","きょうだい"],["たち"],["、"],["何","なん"],["か"],["会衆","かいしゅう"],["の"],["ため"],["に"],["励まし","はげまし"],["の"],["お言葉","おことば"],["が"],["あれば"],["、"],["話して","はなして"],["ください"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":16,"text":"そこで、パウロは立ち上がり、手で人々を制して言った。「イスラエルの人たち、ならびに神を畏れる方々、聞いてください。","tok":[["そこ"],["で"],["、"],["パウロ"],["は"],["立ち上がり","たちあがり"],["、"],["手","て"],["で"],["人々","ひとびと"],["を"],["制して","せいして"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["人","ひと"],["たち"],["、"],["ならびに"],["神","かみ"],["を"],["畏れる","おそれる"],["方々","かたがた"],["、"],["聞いて","きいて"],["ください"],["。"]]},{"verse":17,"text":"この民イスラエルの神は、わたしたちの先祖を選び出し、民がエジプトの地に住んでいる間に、これを強大なものとし、高く上げた御腕をもってそこから導き出してくださいました。","tok":[["この"],["民","みん"],["イスラエル"],["の"],["神","かみ"],["は"],["、"],["わたしたち"],["の"],["先祖","せんぞ"],["を"],["選び出し","えらびだし"],["、"],["民","みん"],["が"],["エジプト"],["の"],["地","ち"],["に"],["住んで","すんで"],["いる"],["間","あいだ"],["に"],["、"],["これ"],["を"],["強大","きょうだい"],["な"],["もの"],["と"],["し"],["、"],["高く","たかく"],["上げた","あげた"],["御腕","おうで"],["を"],["もって"],["そこ"],["から"],["導き出して","みちびきだして"],["くださいました"],["。"]]},{"verse":18,"text":"神はおよそ四十年の間、荒れ野で彼らの行いを耐え忍び、","tok":[["神","かみ"],["は"],["およそ"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["荒れ野","あれの"],["で"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["を"],["耐え忍び","たえしのび"],["、"]]},{"verse":19,"text":"カナンの地では七つの民族を滅ぼし、その土地を彼らに相続させてくださったのです。","tok":[["カナン"],["の"],["地","ち"],["で"],["は"],["七","なな"],["つ"],["の"],["民族","みんぞく"],["を"],["滅ぼし","ほろぼし"],["、"],["その"],["土地","とち"],["を"],["彼","かれ"],["ら"],["に"],["相続","そうぞく"],["させて"],["くださった"],["の"],["です"],["。"]]},{"verse":20,"text":"これは、約四百五十年にわたることでした。その後、神は預言者サムエルの時代まで、裁く者たちを任命なさいました。","tok":[["これ"],["は"],["、"],["約","やく"],["四百五十","よんひゃくごじゅう"],["年","ねん"],["に"],["わたる"],["こと"],["でした"],["。"],["その"],["後","ご"],["、"],["神","かみ"],["は"],["預言者","よげんしゃ"],["サムエル"],["の"],["時代","じだい"],["まで"],["、"],["裁く","さばく"],["者","もの"],["たち"],["を"],["任命","にんめい"],["なさいました"],["。"]]},{"verse":21,"text":"後に人々が王を求めたので、神は四十年の間、ベニヤミン族の者で、キシュの子サウルをお与えになり、","tok":[["後","あと"],["に"],["人々","ひとびと"],["が"],["王","おう"],["を"],["求めた","もとめた"],["ので"],["、"],["神","かみ"],["は"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["ベニヤミン"],["族","ぞく"],["の"],["者","もの"],["で"],["、"],["キシュ"],["の"],["子","こ"],["サウル"],["を"],["お与え","おあたえ"],["に"],["なり"],["、"]]},{"verse":22,"text":"それからまた、サウルを退けてダビデを王の位につけ、彼について次のように宣言なさいました。『わたしは、エッサイの子でわたしの心に適う者、ダビデを見いだした。彼はわたしの思うところをすべて行う。』","tok":[["それ"],["から"],["また"],["、"],["サウル"],["を"],["退けて","しりぞけて"],["ダビデ"],["を"],["王","おう"],["の"],["位","くらい"],["に"],["つけ"],["、"],["彼","かれ"],["について"],["次","つぎ"],["の"],["よう"],["に"],["宣言","せんげん"],["なさいました"],["。"],["『"],["わたし"],["は"],["、"],["エッサイ"],["の"],["子","こ"],["で"],["わたし"],["の"],["心","こころ"],["に"],["適う","かなう"],["者","もの"],["、"],["ダビデ"],["を"],["見いだした","みいだした"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["思う","おもう"],["ところ"],["を"],["すべて"],["行う","おこなう"],["。"],["』"]]},{"verse":23,"text":"神は約束に従って、このダビデの子孫からイスラエルに救い主イエスを送ってくださったのです。","tok":[["神","かみ"],["は"],["約束","やくそく"],["に"],["従って","したがって"],["、"],["この"],["ダビデ"],["の"],["子孫","しそん"],["から"],["イスラエル"],["に"],["救い主","すくいぬし"],["イエス"],["を"],["送って","おくって"],["くださった"],["の"],["です"],["。"]]},{"verse":24,"text":"ヨハネは、イエスがおいでになる前に、イスラエルの民全体に悔い改めの洗礼を宣べ伝えました。","tok":[["ヨハネ"],["は"],["、"],["イエス"],["が"],["おいで"],["に"],["なる"],["前","まえ"],["に"],["、"],["イスラエル"],["の"],["民","みん"],["全体","ぜんたい"],["に"],["悔い改め","くいあらため"],["の"],["洗礼","せんれい"],["を"],["宣べ伝えました","のべつたえました"],["。"]]},{"verse":25,"text":"その生涯を終えようとするとき、ヨハネはこう言いました。『わたしを何者だと思っているのか。わたしは、あなたたちが期待しているような者ではない。その方はわたしの後から来られるが、わたしはその足の履物をお脱がせする値打ちもない。』","tok":[["その"],["生涯","しょうがい"],["を"],["終えよう","おえよう"],["と"],["する"],["とき"],["、"],["ヨハネ"],["は"],["こう"],["言いました","いいました"],["。"],["『"],["わたし"],["を"],["何者","なにもの"],["だ"],["と"],["思って","おもって"],["いる"],["の"],["か"],["。"],["わたし"],["は"],["、"],["あなた"],["たち"],["が"],["期待","きたい"],["して"],["いる"],["よう"],["な"],["者","もの"],["で"],["は"],["ない"],["。"],["その"],["方","かた"],["は"],["わたし"],["の"],["後","あと"],["から"],["来られる","こられる"],["が"],["、"],["わたし"],["は"],["その"],["足","あし"],["の"],["履物","はきもの"],["を"],["お脱がせ","おぬがせ"],["する"],["値打ち","ねうち"],["も"],["ない"],["。"],["』"]]},{"verse":26,"text":"兄弟たち、アブラハムの子孫の方々、ならびにあなたがたの中にいて神を畏れる人たち、この救いの言葉はわたしたちに送られました。","tok":[["兄弟","きょうだい"],["たち"],["、"],["アブラハム"],["の"],["子孫","しそん"],["の"],["方々","ほうぼう"],["、"],["ならびに"],["あなた"],["がた"],["の"],["中","なか"],["に"],["いて"],["神","かみ"],["を"],["畏れる","おそれる"],["人","ひと"],["たち"],["、"],["この"],["救い","すくい"],["の"],["言葉","ことば"],["は"],["わたしたち"],["に"],["送られました","おくられました"],["。"]]},{"verse":27,"text":"エルサレムに住む人々やその指導者たちは、イエスを認めず、また、安息日ごとに読まれる預言者の言葉を理解せず、イエスを罪に定めることによって、その言葉を実現させたのです。","tok":[["エルサレム"],["に"],["住む","すむ"],["人々","ひとびと"],["や"],["その"],["指導者","しどうしゃ"],["たち"],["は"],["、"],["イエス"],["を"],["認めず","みとめず"],["、"],["また"],["、"],["安息日","あんそくび"],["ごと"],["に"],["読まれる","よまれる"],["預言者","よげんしゃ"],["の"],["言葉","ことば"],["を"],["理解","りかい"],["せず"],["、"],["イエス"],["を"],["罪","つみ"],["に"],["定める","さだめる"],["こと"],["によって"],["、"],["その"],["言葉","ことば"],["を"],["実現","じつげん"],["させた"],["の"],["です"],["。"]]},{"verse":28,"text":"そして、死に当たる理由は何も見いだせなかったのに、イエスを死刑にするようにとピラトに求めました。","tok":[["そして"],["、"],["死","し"],["に"],["当たる","あたる"],["理由","りゆう"],["は"],["何","なん"],["も"],["見いだせなかった","みいだせなかった"],["のに"],["、"],["イエス"],["を"],["死刑","しけい"],["に"],["する"],["よう"],["に"],["と"],["ピラト"],["に"],["求めました","もとめました"],["。"]]},{"verse":29,"text":"こうして、イエスについて書かれていることがすべて実現した後、人々はイエスを木から降ろし、墓に葬りました。","tok":[["こう"],["して"],["、"],["イエス"],["について"],["書かれて","かかれて"],["いる"],["こと"],["が"],["すべて"],["実現","じつげん"],["した"],["後","あと"],["、"],["人々","ひとびと"],["は"],["イエス"],["を"],["木","き"],["から"],["降ろし","おろし"],["、"],["墓","はか"],["に"],["葬りました","ほうむりました"],["。"]]},{"verse":30,"text":"しかし、神はイエスを死者の中から復活させてくださったのです。","tok":[["しかし"],["、"],["神","かみ"],["は"],["イエス"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させて"],["くださった"],["の"],["です"],["。"]]},{"verse":31,"text":"このイエスは、御自分と一緒にガリラヤからエルサレムに上った人々に、幾日にもわたって姿を現されました。その人たちは、今、民に対してイエスの証人となっています。","tok":[["この"],["イエス"],["は"],["、"],["御自分","ごじぶん"],["と"],["一緒","いっしょ"],["に"],["ガリラヤ"],["から"],["エルサレム"],["に"],["上った","のぼった"],["人々","ひとびと"],["に"],["、"],["幾日","いくか"],["に"],["も"],["わたって"],["姿","すがた"],["を"],["現されました","あらわされました"],["。"],["その"],["人","ひと"],["たち"],["は"],["、"],["今","いま"],["、"],["民","みん"],["に対して","にたいして"],["イエス"],["の"],["証人","しょうにん"],["と"],["なって"],["います"],["。"]]},{"verse":32,"text":"わたしたちも、先祖に与えられた約束について、あなたがたに福音を告げ知らせています。","tok":[["わたしたち"],["も"],["、"],["先祖","せんぞ"],["に"],["与えられた","あたえられた"],["約束","やくそく"],["について"],["、"],["あなた"],["がた"],["に"],["福音","ふくいん"],["を"],["告げ知らせて","つげしらせて"],["います"],["。"]]},{"verse":33,"text":"つまり、神はイエスを復活させて、わたしたち子孫のためにその約束を果たしてくださったのです。それは詩編の第二編にも、『あなたはわたしの子、わたしは今日あなたを産んだ』と書いてあるとおりです。","tok":[["つまり"],["、"],["神","かみ"],["は"],["イエス"],["を"],["復活","ふっかつ"],["させて"],["、"],["わたしたち"],["子孫","しそん"],["の"],["ため"],["に"],["その"],["約束","やくそく"],["を"],["果たして","はたして"
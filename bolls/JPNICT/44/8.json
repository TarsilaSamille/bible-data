[{"verse":1,"text":"サウロは、ステファノの殺害に賛成していた。エルサレムの教会に対する迫害その日、エルサレムの教会に対して大迫害が起こり、使徒たちのほかは皆、ユダヤとサマリアの地方に散って行った。","tok":[["サウロ"],["は"],["、"],["ステファノ"],["の"],["殺害","さつがい"],["に"],["賛成","さんせい"],["して"],["いた"],["。"],["エルサレム"],["の"],["教会","きょうかい"],["に"],["対する","たいする"],["迫害","はくがい"],["その"],["日","ひ"],["、"],["エルサレム"],["の"],["教会","きょうかい"],["に対して","にたいして"],["大","だい"],["迫害","はくがい"],["が"],["起こり","おこり"],["、"],["使徒","しと"],["たち"],["の"],["ほか"],["は"],["皆","みな"],["、"],["ユダヤ"],["と"],["サマリア"],["の"],["地方","ちほう"],["に"],["散って","ちって"],["行った","いった"],["。"]]},{"verse":2,"text":"しかし、信仰深い人々がステファノを葬り、彼のことを思って大変悲しんだ。","tok":[["しかし"],["、"],["信仰","しんこう"],["深い","ふかい"],["人々","ひとびと"],["が"],["ステファノ"],["を"],["葬り","ほうむり"],["、"],["彼","かれ"],["の"],["こと"],["を"],["思って","おもって"],["大変","たいへん"],["悲しんだ","かなしんだ"],["。"]]},{"verse":3,"text":"一方、サウロは家から家へと押し入って教会を荒らし、男女を問わず引き出して牢に送っていた。","tok":[["一方","いっぽう"],["、"],["サウロ"],["は"],["家","いえ"],["から"],["家","いえ"],["へ"],["と"],["押し入って","おしいって"],["教会","きょうかい"],["を"],["荒らし","あらし"],["、"],["男女","だんじょ"],["を"],["問わず","とわず"],["引き出して","ひきだして"],["牢","ろう"],["に"],["送って","おくって"],["いた"],["。"]]},{"verse":4,"text":"さて、散って行った人々は、福音を告げ知らせながら巡り歩いた。","tok":[["さて"],["、"],["散って","ちって"],["行った","いった"],["人々","ひとびと"],["は"],["、"],["福音","ふくいん"],["を"],["告げ知らせ","つげしらせ"],["ながら"],["巡り歩いた","めぐりあるいた"],["。"]]},{"verse":5,"text":"フィリポはサマリアの町に下って、人々にキリストを宣べ伝えた。","tok":[["フィリポ"],["は"],["サマリア"],["の"],["町","まち"],["に"],["下って","くだって"],["、"],["人々","ひとびと"],["に"],["キリスト"],["を"],["宣べ伝えた","のべつたえた"],["。"]]},{"verse":6,"text":"群衆は、フィリポの行うしるしを見聞きしていたので、こぞってその話に聞き入った。","tok":[["群衆","ぐんしゅう"],["は"],["、"],["フィリポ"],["の"],["行う","おこなう"],["しるし"],["を"],["見聞き","みきき"],["して"],["いた"],["ので"],["、"],["こぞって"],["その"],["話","はなし"],["に"],["聞き入った","ききいった"],["。"]]},{"verse":7,"text":"実際、汚れた霊に取りつかれた多くの人たちからは、その霊が大声で叫びながら出て行き、多くの中風患者や足の不自由な人もいやしてもらった。","tok":[["実際","じっさい"],["、"],["汚れた","よごれた"],["霊","れい"],["に"],["取りつかれた","とりつかれた"],["多く","おおく"],["の"],["人","ひと"],["たち"],["から"],["は"],["、"],["その"],["霊","れい"],["が"],["大声","おおごえ"],["で"],["叫び","さけび"],["ながら"],["出て","でて"],["行き","いき"],["、"],["多く","おおく"],["の"],["中風","ちゅうぶ"],["患者","かんじゃ"],["や"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["も"],["いやして"],["もらった"],["。"]]},{"verse":8,"text":"町の人々は大変喜んだ。","tok":[["町","まち"],["の"],["人々","ひとびと"],["は"],["大変","たいへん"],["喜んだ","よろこんだ"],["。"]]},{"verse":9,"text":"ところで、この町に以前からシモンという人がいて、魔術を使ってサマリアの人々を驚かせ、偉大な人物と自称していた。","tok":[["ところ"],["で"],["、"],["この"],["町","まち"],["に"],["以前","いぜん"],["から"],["シモン"],["と"],["いう"],["人","ひと"],["が"],["いて"],["、"],["魔術","まじゅつ"],["を"],["使って","つかって"],["サマリア"],["の"],["人々","ひとびと"],["を"],["驚かせ","おどろかせ"],["、"],["偉大","いだい"],["な"],["人物","じんぶつ"],["と"],["自称","じしょう"],["して"],["いた"],["。"]]},{"verse":10,"text":"それで、小さな者から大きな者に至るまで皆、「この人こそ偉大なものといわれる神の力だ」と言って注目していた。","tok":[["それ"],["で"],["、"],["小さな","ちいさな"],["者","もの"],["から"],["大きな","おおきな"],["者","もの"],["に"],["至る","いたる"],["まで"],["皆","みな"],["、"],["「"],["この"],["人","ひと"],["こそ"],["偉大","いだい"],["な"],["もの"],["と"],["いわれる"],["神","かみ"],["の"],["力","ちから"],["だ"],["」"],["と"],["言って","いって"],["注目","ちゅうもく"],["して"],["いた"],["。"]]},{"verse":11,"text":"人々が彼に注目したのは、長い間その魔術に心を奪われていたからである。","tok":[["人々","ひとびと"],["が"],["彼","かれ"],["に"],["注目","ちゅうもく"],["した"],["の"],["は"],["、"],["長い","ながい"],["間","あいだ"],["その"],["魔術","まじゅつ"],["に"],["心","こころ"],["を"],["奪われて","うばわれて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"しかし、フィリポが神の国とイエス‧キリストの名について福音を告げ知らせるのを人々は信じ、男も女も洗礼を受けた。","tok":[["しかし"],["、"],["フィリポ"],["が"],["神","かみ"],["の"],["国","くに"],["と"],["イエス"],["‧"],["キリスト"],["の"],["名","な"],["について"],["福音","ふくいん"],["を"],["告げ知らせる","つげしらせる"],["の"],["を"],["人々","ひとびと"],["は"],["信じ","しんじ"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["洗礼","せんれい"],["を"],["受けた","うけた"],["。"]]},{"verse":13,"text":"シモン自身も信じて洗礼を受け、いつもフィリポにつき従い、すばらしいしるしと奇跡が行われるのを見て驚いていた。","tok":[["シモン"],["自身","じしん"],["も"],["信じて","しんじて"],["洗礼","せんれい"],["を"],["受け","うけ"],["、"],["いつも"],["フィリポ"],["に"],["つき従い","つきしたがい"],["、"],["すばらしい"],["しるし"],["と"],["奇跡","きせき"],["が"],["行われる","おこなわれる"],["の"],["を"],["見て","みて"],["驚いて","おどろいて"],["いた"],["。"]]},{"verse":14,"text":"エルサレムにいた使徒たちは、サマリアの人々が神の言葉を受け入れたと聞き、ペトロとヨハネをそこへ行かせた。","tok":[["エルサレム"],["に"],["いた"],["使徒","しと"],["たち"],["は"],["、"],["サマリア"],["の"],["人々","ひとびと"],["が"],["神","かみ"],["の"],["言葉","ことば"],["を"],["受け入れた","うけいれた"],["と"],["聞き","きき"],["、"],["ペトロ"],["と"],["ヨハネ"],["を"],["そこ"],["へ"],["行かせた","いかせた"],["。"]]},{"verse":15,"text":"二人はサマリアに下って行き、聖霊を受けるようにとその人々のために祈った。","tok":[["二人","ふたり"],["は"],["サマリア"],["に"],["下って","くだって"],["行き","いき"],["、"],["聖霊","せいれい"],["を"],["受ける","うける"],["よう"],["に"],["と"],["その"],["人々","ひとびと"],["の"],["ため"],["に"],["祈った","いのった"],["。"]]},{"verse":16,"text":"人々は主イエスの名によって洗礼を受けていただけで、聖霊はまだだれの上にも降っていなかったからである。","tok":[["人々","ひとびと"],["は"],["主","しゅ"],["イエス"],["の"],["名","な"],["によって"],["洗礼","せんれい"],["を"],["受けて","うけて"],["いた"],["だけ"],["で"],["、"],["聖霊","せいれい"],["は"],["まだ"],["だれ"],["の"],["上","うえ"],["に"],["も"],["降って","ふって"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"ペトロとヨハネが人々の上に手を置くと、彼らは聖霊を受けた。","tok":[["ペトロ"],["と"],["ヨハネ"],["が"],["人々","ひとびと"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置く","おく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["聖霊","せいれい"],["を"],["受けた","うけた"],["。"]]},{"verse":18,"text":"シモンは、使徒たちが手を置くことで、“霊”が与えられるのを見、金を持って来て、","tok":[["シモン"],["は"],["、"],["使徒","しと"],["たち"],["が"],["手","て"],["を"],["置く","おく"],["こと"],["で"],["、"],["“"],["霊","れい"],["”"],["が"],["与えられる","あたえられる"],["の"],["を"],["見","み"],["、"],["金","きん"],["を"],["持って","もって"],["来て","きて"],["、"]]},{"verse":19,"text":"言った。「わたしが手を置けば、だれでも聖霊が受けられるように、わたしにもその力を授けてください。」","tok":[["言った","いった"],["。"],["「"],["わたし"],["が"],["手","て"],["を"],["置けば","おけば"],["、"],["だれ"],["で"],["も"],["聖霊","せいれい"],["が"],["受けられる","うけられる"],["よう"],["に"],["、"],["わたし"],["に"],["も"],["その"],["力","ちから"],["を"],["授けて","さずけて"],["ください"],["。"],["」"]]},{"verse":20,"text":"すると、ペトロは言った。「この金は、お前と一緒に滅びてしまうがよい。神の賜物を金で手に入れられると思っているからだ。","tok":[["する"],["と"],["、"],["ペトロ"],["は"],["言った","いった"],["。"],["「"],["この"],["金","きん"],["は"],["、"],["お前","おまえ"],["と"],["一緒","いっしょ"],["に"],["滅びて","ほろびて"],["しまう"],["が"],["よい"],["。"],["神","かみ"],["の"],["賜物","たまもの"],["を"],["金","かね"],["で"],["手","て"],["に"],["入れられる","いれられる"],["と"],["思って","おもって"],["いる"],["から"],["だ"],["。"]]},{"verse":21,"text":"お前はこのことに何のかかわりもなければ、権利もない。お前の心が神の前に正しくないからだ。","tok":[["お前","おまえ"],["は"],["この"],["こと"],["に"],["何","なん"],["の"],["かかわり"],["も"],["なければ"],["、"],["権利","けんり"],["も"],["ない"],["。"],["お前","おまえ"],["の"],["心","こころ"],["が"],["神","かみ"],["の"],["前","まえ"],["に"],["正しく","ただしく"],["ない"],["から"],["だ"],["。"]]},{"verse":22,"text":"この悪事を悔い改め、主に祈れ。そのような心の思いでも、赦していただけるかもしれないからだ。","tok":[["この"],["悪事","あくじ"],["を"],["悔い改め","くいあらため"],["、"],["主に","おもに"],["祈れ","いのれ"],["。"],["その"],["よう"],["な"],["心","こころ"],["の"],["思い","おもい"],["で"],["も"],["、"],["赦して","ゆるして"],["いただける"],["か"],["も"],["しれない"],["から"],["だ"],["。"]]},{"verse":23,"text":"お前は腹黒い者であり、悪の縄目に縛られていることが、わたしには分かっている。」","tok":[["お前","おまえ"],["は"],["腹黒い","はらぐろい"],["者","もの"],["で"],["あり"],["、"],["悪","あく"],["の"],["縄目","なわめ"],["に"],["縛られて","しばられて"],["いる"],["こと"],["が"],["、"],["わたし"],["に"],["は"],["分かって","わかって"],["いる"],["。"],["」"]]},{"verse":24,"text":"シモンは答えた。「おっしゃったことが何一つわたしの身に起こらないように、主に祈ってください。」","tok":[["シモン"],["は"],["答えた","こたえた"],["。"],["「"],["おっしゃった"],["こと"],["が"],["何","なん"],["一","ひと"],["つ"],["わたし"],["の"],["身","み"],["に"],["起こらない","おこらない"],["よう"],["に"],["、"],["主に","おもに"],["祈って","いのって"],["ください"],["。"],["」"]]},{"verse":25,"text":"このように、ペトロとヨハネは、主の言葉を力強く証しして語った後、サマリアの多くの村で福音を告げ知らせて、エルサレムに帰って行った。","tok":[["この"],["よう"],["に"],["、"],["ペトロ"],["と"],["ヨハネ"],["は"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["力強く","ちからづよく"],["証し","あかし"],["して"],["語った","かたった"],["後","あと"],["、"],["サマリア"],["の"],["多く","おおく"],["の"],["村","むら"],["で"],["福音","ふくいん"],["を"],["告げ知らせて","つげしらせて"],["、"],["エルサレム"],["に"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":26,"text":"さて、主の天使はフィリポに、「ここをたって南に向かい、エルサレムからガザへ下る道に行け」と言った。そこは寂しい道である。","tok":[["さて"],["、"],["主","ぬし"],["の"],["天使","てんし"],["は"],["フィリポ"],["に"],["、"],["「"],["ここ"],["を"],["たって"],["南","みなみ"],["に"],["向かい","むかい"],["、"],["エルサレム"],["から"],["ガザ"],["へ"],["下る","くだる"],["道","みち"],["に"],["行け","いけ"],["」"],["と"],["言った","いった"],["。"],["そこ"],["は"],["寂しい","さびしい"],["道","みち"],["で"],["ある"],["。"]]},{"verse":27,"text":"フィリポはすぐ出かけて行った。折から、エチオピアの女王カンダケの高官で、女王の全財産の管理をしていたエチオピア人の宦官が、エルサレムに礼拝に来て、","tok":[["フィリポ"],["は"],["すぐ"],["出かけて","でかけて"],["行った","いった"],["。"],["折","おり"],["から"],["、"],["エチオピア"],["の"],["女王","じょおう"],["カンダケ"],["の"],["高官","こうかん"],["で"],["、"],["女王","じょおう"],["の"],["全","ぜん"],["財産","ざいさん"],["の"],["管理","かんり"],["を"],["して"],["いた"],["エチオピア"],["人","にん"],["の"],["宦官","かんがん"],["が"],["、"],["エルサレム"],["に"],["礼拝","れいはい"],["に"],["来て","きて"],["、"]]},{"verse":28,"text":"帰る途中であった。彼は、馬車に乗って預言者イザヤの書を朗読していた。","tok":[["帰る","かえる"],["途中","とちゅう"],["で"],["あった"],["。"],["彼","かれ"],["は"],["、"],["馬車","ばしゃ"],["に"],["乗って","のって"],["預言者","よげんしゃ"],["イザヤ"],["の"],["書","しょ"],["を"],["朗読","ろうどく"],["して"],["いた"],["。"]]},{"verse":29,"text":"すると、“霊”がフィリポに、「追いかけて、あの馬車と一緒に行け」と言った。","tok":[["する"],["と"],["、"],["“"],["霊","れい"],["”"],["が"],["フィリポ"],["に"],["、"],["「"],["追いかけて","おいかけて"],["、"],["あの"],["馬車","ばしゃ"],["と"],["一緒","いっしょ"],["に"],["行け","いけ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":30,"text":"フィリポが走り寄ると、預言者イザヤの書を朗読しているのが聞こえたので、「読んでいることがお分かりになりますか」と言った。","tok":[["フィリポ"],["が"],["走り寄る","はしりよる"],["と"],["、"],["預言者","よげんしゃ"],["イザヤ"],["の"],["書","しょ"],["を"],["朗読","ろうどく"],["して"],["いる"],["の"],["が"],["聞こえた","きこえた"],["ので"],["、"],["「"],["読んで","よんで"],["いる"],["こと"],["が"],["お分かり","おわかり"],["に"],["なります"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":31,"text":"宦官は、「手引きしてくれる人がなければ、どうして分かりましょう」と言い、馬車に乗ってそばに座るようにフィリポに頼んだ。","tok":[["宦官","かんがん"],["は"],["、"],["「"],["手引き","てびき"],["して"],["くれる"],["人","ひと"],["が"],["なければ"],["、"],["どう"],["して"],["分かりましょう","わかりましょう"],["」"],["と"],["言い","いい"],["、"],["馬車","ばしゃ"],["に"],["乗って","のって"],["そば"],["に"],["座る","すわる"],["よう"],["に"],["フィリポ"],["に"],["頼んだ","たのんだ"],["。"]]},{"verse":32,"text":"彼が朗読していた聖書の個所はこれである。「彼は、羊のように屠り場に引かれて行った。毛を刈る者の前で黙している小羊のように、口を開かない。","tok":[["彼","かれ"],["が"],["朗読","ろうどく"],["して"],["いた"],["聖書","せいしょ"],["の"],["個所","かしょ"],["は"],["これ"],["で"],["ある"],["。"],["「"],["彼","かれ"],["は"],["、"],["羊","ひつじ"],["の"],["よう"],["に"],["屠り","ほふり"],["場","ば"],["に"],["引かれて","ひかれて"],["行った","いった"],["。"],["毛","け"],["を"],["刈る","かる"],["者","もの"],["の"],["前","まえ"],["で"],["黙して","もくして"],["いる"],["小羊","こひつじ"],["の"],["よう"],["に"],["、"],["口","くち"],["を"],["開かない","ひらかない"],["。"]]},{"verse":33,"text":"卑しめられて、その裁きも行われなかった。だれが、その子孫について語れるだろう。彼の命は地上から取り去られるからだ。」","tok":[["卑しめられて","いやしめられて"],["、"],["その"],["裁き","さばき"],["も"],["行われなかった","おこなわれなかった"],["。"],["だれ"],["が"],["、"],["その"],["子孫","しそん"],["について"],["語れるだろう","かたれるだろう"],["。"],["彼","かれ"],["の"],["命","いのち"],["は"],["地上","ちじょう"],["から"],["取り去られる","とりさられる"],["から"],["だ"],["。"],["」"]]},{"verse":34,"text":"宦官はフィリポに言った。「どうぞ教えてください。預言者は、だれについてこう言っているのでしょうか。自分についてですか。だれかほかの人についてですか。」","tok":[["宦官","かんがん"],["は"],["フィリポ"],["に"],["言った","いった"],["。"],["「"],["どうぞ"],["教えて","おしえて"],["ください"],["。"],["預言者","よげんしゃ"],["は"],["、"],["だれ"],["について"],["こう"],["言って","いって"],["いる"],["の"],["でしょう"],["か"],["。"],["自分","じぶん"],["について"],["です"],["か"],["。"],["だれ"],["か"],["ほか"],["の"],["人","ひと"],["について"],["です"],["か"],["。"],["」"]]},{"verse":35,"text":"そこで、フィリポは口を開き、聖書のこの個所から説きおこして、イエスについて福音を告げ知らせた。","tok":[["そこ"],["で"],["、"],["フィリポ"],["は"],["口","くち"],["を"],["開き","ひらき"],["、"],["聖書","せいしょ"],["の"],["この"],["個所","かしょ"],["から"],["説きおこして","ときおこして"],["、"],["イエス"],["について"],["福音","ふくいん"],["を"],["告げ知らせた","つげしらせた"],["。"]]},{"verse":36,"text":"道を進んで行くうちに、彼らは水のある所に来た。宦官は言った。「ここに水があります。洗礼を受けるのに、何か妨げがあるでしょうか。」","tok":[["道","みち"],["を"],["進んで","すすんで"],["行く","いく"],["うち"],["に"],["、"],["彼","かれ"],["ら"],["は"],["水","みず"],["の"],["ある"],["所","ところ"],["に"],["来た","きた"],["。"],["宦官","かんがん"],["は"],["言った","いった"],["。"],["「"],["ここ"],["に"],["水","みず"],["が"],["あります"],["。"],["洗礼","せんれい"],["を"],["受ける","うける"],["のに"],["、"],["何","なん"],["か"],["妨げ","さまたげ"],["が"],["あるでしょう"],["か"],["。"],["」"]]},{"verse":37,"text":"†〔フィリポが、「真心から信じておられるなら、差し支えありません」と言うと、宦官は、「イエス‧キリストは神の子であると信じます」と答えた。〕","tok":[["†"],["〔"],["フィリポ"],["が"],["、"],["「"],["真心","まごころ"],["から"],["信じて","しんじて"],["おられるなら"],["、"],["差し支え","さしつかえ"],["ありません"],["」"],["と"],["言う","ゆう"],["と"],["、"],["宦官","かんがん"],["は"],["、"],["「"],["イエス"],["‧"],["キリスト"],["は"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["と"],["信じます","しんじます"],["」"],["と"],["答えた","こたえた"],["。"],["〕"]]},{"verse":38,"text":"そして、車を止めさせた。フィリポと宦官は二人とも水の中に入って行き、フィリポは宦官に洗礼を授けた。","tok":[["そして"],["、"],["車","くるま"],["を"],["止めさせた","とめさせた"],["。"],["フィリポ"],["と"],["宦官","かんがん"],["は"],["二人","ふたり"],["とも"],["水","みず"],["の"],["中","なか"],["に"],["入って","はいって"],["行き","いき"],["、"],["フィリポ"],["は"],["宦官","かんがん"],["に"],["洗礼","せんれい"],["を"],["授けた","さずけた"],["。"]]},{"verse":39,"text":"彼らが水の中から上がると、主の霊がフィリポを連れ去った。宦官はもはやフィリポの姿を見なかったが、喜びにあふれて旅を続けた。","tok":[["彼","かれ"],["ら"],["が"],["水","みず"],["の"],["中","なか"],["から"],["上がる","あがる"],["と"],["、"],["主","ぬし"],["の"],["霊","れい"],["が"],["フィリポ"],["を"],["連れ去った","つれさった"],["。"],["宦官","かんがん"],["は"],["もはや"],["フィリポ"],["の"],["姿","すがた"],["を"],["見なかった","みなかった"],["が"],["、"],["喜び","よろこび"],["に"],["あふれて"],["旅","たび"],["を"],["続けた","つづけた"],["。"]]},{"verse":40,"text":"フィリポはアゾトに姿を現した。そして、すべての町を巡りながら福音を告げ知らせ、カイサリアまで行った。","tok":[["フィリポ"],["は"],["アゾト"],["に"],["姿","すがた"],["を"],["現した","あらわした"],["。"],["そして"],["、"],["すべて"],["の"],["町","まち"],["を"],["巡り","めぐり"],["ながら"],["福音","ふくいん"],["を"],["告げ知らせ","つげしらせ"],["、"],["カイサリア"],["まで"],["行った","いった"],["。"]]}]
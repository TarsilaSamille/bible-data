[{"verse":1,"text":"そのころ、弟子の数が増えてきて、ギリシア語を話すユダヤ人から、ヘブライ語を話すユダヤ人に対して苦情が出た。それは、日々の分配のことで、仲間のやもめたちが軽んじられていたからである。","tok":[["その"],["ころ"],["、"],["弟子","でし"],["の"],["数","かず"],["が"],["増えて","ふえて"],["きて"],["、"],["ギリシア"],["語","ご"],["を"],["話す","はなす"],["ユダヤ人","ゆだやじん"],["から"],["、"],["ヘブライ"],["語","ご"],["を"],["話す","はなす"],["ユダヤ人","ゆだやじん"],["に対して","にたいして"],["苦情","くじょう"],["が"],["出た","でた"],["。"],["それ"],["は"],["、"],["日々","ひび"],["の"],["分配","ぶんぱい"],["の"],["こと"],["で"],["、"],["仲間","なかま"],["の"],["やもめ"],["たち"],["が"],["軽んじられて","かろんじられて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"そこで、十二人は弟子をすべて呼び集めて言った。「わたしたちが、神の言葉をないがしろにして、食事の世話をするのは好ましくない。","tok":[["そこ"],["で"],["、"],["十二人","じゅうににん"],["は"],["弟子","でし"],["を"],["すべて"],["呼び集めて","よびあつめて"],["言った","いった"],["。"],["「"],["わたしたち"],["が"],["、"],["神","かみ"],["の"],["言葉","ことば"],["を"],["ないがしろ"],["に"],["して"],["、"],["食事","しょくじ"],["の"],["世話","せわ"],["を"],["する"],["の"],["は"],["好ましく","このましく"],["ない"],["。"]]},{"verse":3,"text":"それで、兄弟たち、あなたがたの中から、“霊”と知恵に満ちた評判の良い人を七人選びなさい。彼らにその仕事を任せよう。","tok":[["それ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["の"],["中","なか"],["から"],["、"],["“"],["霊","れい"],["”"],["と"],["知恵","ちえ"],["に"],["満ちた","みちた"],["評判","ひょうばん"],["の"],["良い","よい"],["人","ひと"],["を"],["七人","しちにん"],["選び","えらび"],["なさい"],["。"],["彼","かれ"],["ら"],["に"],["その"],["仕事","しごと"],["を"],["任せよう","まかせよう"],["。"]]},{"verse":4,"text":"わたしたちは、祈りと御言葉の奉仕に専念することにします。」","tok":[["わたしたち"],["は"],["、"],["祈り","いのり"],["と"],["御言葉","おことば"],["の"],["奉仕","ほうし"],["に"],["専念","せんねん"],["する"],["こと"],["に"],["します"],["。"],["」"]]},{"verse":5,"text":"一同はこの提案に賛成し、信仰と聖霊に満ちている人ステファノと、ほかにフィリポ、プロコロ、ニカノル、ティモン、パルメナ、アンティオキア出身の改宗者ニコラオを選んで、","tok":[["一同","いちどう"],["は"],["この"],["提案","ていあん"],["に"],["賛成","さんせい"],["し"],["、"],["信仰","しんこう"],["と"],["聖霊","せいれい"],["に"],["満ちて","みちて"],["いる"],["人","ひと"],["ステファノ"],["と"],["、"],["ほか"],["に"],["フィリポ"],["、"],["プロコロ"],["、"],["ニカノル"],["、"],["ティモン"],["、"],["パルメナ"],["、"],["アンティオキア"],["出身","しゅっしん"],["の"],["改宗者","かいしゅうしゃ"],["ニコラオ"],["を"],["選んで","えらんで"],["、"]]},{"verse":6,"text":"使徒たちの前に立たせた。使徒たちは、祈って彼らの上に手を置いた。","tok":[["使徒","しと"],["たち"],["の"],["前","まえ"],["に"],["立たせた","たたせた"],["。"],["使徒","しと"],["たち"],["は"],["、"],["祈って","いのって"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["手","て"],["を"],["置いた","おいた"],["。"]]},{"verse":7,"text":"こうして、神の言葉はますます広まり、弟子の数はエルサレムで非常に増えていき、祭司も大勢この信仰に入った。","tok":[["こう"],["して"],["、"],["神","かみ"],["の"],["言葉","ことば"],["は"],["ますます"],["広まり","ひろまり"],["、"],["弟子","でし"],["の"],["数","かず"],["は"],["エルサレム"],["で"],["非常","ひじょう"],["に"],["増えて","ふえて"],["いき"],["、"],["祭司","さいし"],["も"],["大勢","おおぜい"],["この"],["信仰","しんこう"],["に"],["入った","はいった"],["。"]]},{"verse":8,"text":"さて、ステファノは恵みと力に満ち、すばらしい不思議な業としるしを民衆の間で行っていた。","tok":[["さて"],["、"],["ステファノ"],["は"],["恵み","めぐみ"],["と"],["力","ちから"],["に"],["満ち","みち"],["、"],["すばらしい"],["不思議","ふしぎ"],["な"],["業","ごう"],["と"],["しるし"],["を"],["民衆","みんしゅう"],["の"],["間","あいだ"],["で"],["行って","いって"],["いた"],["。"]]},{"verse":9,"text":"ところが、キレネとアレクサンドリアの出身者で、いわゆる「解放された奴隷の会堂」に属する人々、またキリキア州とアジア州出身の人々などのある者たちが立ち上がり、ステファノと議論した。","tok":[["ところ"],["が"],["、"],["キレネ"],["と"],["アレクサンドリア"],["の"],["出身者","しゅっしんしゃ"],["で"],["、"],["いわゆる"],["「"],["解放","かいほう"],["された"],["奴隷","どれい"],["の"],["会堂","かいどう"],["」"],["に"],["属する","ぞくする"],["人々","ひとびと"],["、"],["また"],["キリキア"],["州","しゅう"],["と"],["アジア州","あじあしゅう"],["出身","しゅっしん"],["の"],["人々","ひとびと"],["など"],["の"],["ある"],["者","もの"],["たち"],["が"],["立ち上がり","たちあがり"],["、"],["ステファノ"],["と"],["議論","ぎろん"],["した"],["。"]]},{"verse":10,"text":"しかし、彼が知恵と“霊”とによって語るので、歯が立たなかった。","tok":[["しかし"],["、"],["彼","かれ"],["が"],["知恵","ちえ"],["と"],["“"],["霊","れい"],["”"],["と"],["によって"],["語る","かたる"],["ので"],["、"],["歯","は"],["が"],["立たなかった","たたなかった"],["。"]]},{"verse":11,"text":"そこで、彼らは人々を唆して、「わたしたちは、あの男がモーセと神を冒瀆する言葉を吐くのを聞いた」と言わせた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["人々","ひとびと"],["を"],["唆して","そそのかして"],["、"],["「"],["わたしたち"],["は"],["、"],["あの"],["男","おとこ"],["が"],["モーセ"],["と"],["神","かみ"],["を"],["冒瀆","ぼうとく"],["する"],["言葉","ことば"],["を"],["吐く","はく"],["の"],["を"],["聞いた","きいた"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":12,"text":"また、民衆、長老たち、律法学者たちを扇動して、ステファノを襲って捕らえ、最高法院に引いて行った。","tok":[["また"],["、"],["民衆","みんしゅう"],["、"],["長老","ちょうろう"],["たち"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["を"],["扇動","せんどう"],["して"],["、"],["ステファノ"],["を"],["襲って","おそって"],["捕らえ","とらえ"],["、"],["最高","さいこう"],["法院","ほういん"],["に"],["引いて","ひいて"],["行った","いった"],["。"]]},{"verse":13,"text":"そして、偽証人を立てて、次のように訴えさせた。「この男は、この聖なる場所と律法をけなして、一向にやめようとしません。","tok":[["そして"],["、"],["偽証人","ぎしょうにん"],["を"],["立てて","たてて"],["、"],["次","つぎ"],["の"],["よう"],["に"],["訴えさせた","うったえさせた"],["。"],["「"],["この"],["男","おとこ"],["は"],["、"],["この"],["聖","せい"],["なる"],["場所","ばしょ"],["と"],["律法","りっぽう"],["を"],["けなして"],["、"],["一向","いっこう"],["に"],["やめよう"],["と"],["しません"],["。"]]},{"verse":14,"text":"わたしたちは、彼がこう言っているのを聞いています。『あのナザレの人イエスは、この場所を破壊し、モーセが我々に伝えた慣習を変えるだろう。』」","tok":[["わたしたち"],["は"],["、"],["彼","かれ"],["が"],["こう"],["言って","いって"],["いる"],["の"],["を"],["聞いて","きいて"],["います"],["。"],["『"],["あの"],["ナザレ"],["の"],["人","ひと"],["イエス"],["は"],["、"],["この"],["場所","ばしょ"],["を"],["破壊","はかい"],["し"],["、"],["モーセ"],["が"],["我々","われわれ"],["に"],["伝えた","つたえた"],["慣習","かんしゅう"],["を"],["変えるだろう","かえるだろう"],["。"],["』"],["」"]]},{"verse":15,"text":"最高法院の席に着いていた者は皆、ステファノに注目したが、その顔はさながら天使の顔のように見えた。","tok":[["最高","さいこう"],["法院","ほういん"],["の"],["席","せき"],["に"],["着いて","ついて"],["いた"],["者","もの"],["は"],["皆","みな"],["、"],["ステファノ"],["に"],["注目","ちゅうもく"],["した"],["が"],["、"],["その"],["顔","かお"],["は"],["さながら"],["天使","てんし"],["の"],["顔","かお"],["の"],["よう"],["に"],["見えた","みえた"],["。"]]}]
[{"verse":1,"text":"フェストゥスは、総督として着任して三日たってから、カイサリアからエルサレムへ上った。","tok":[["フェストゥス"],["は"],["、"],["総督","そうとく"],["として"],["着任","ちゃくにん"],["して"],["三日","みっか"],["たって"],["から"],["、"],["カイサリア"],["から"],["エルサレム"],["へ"],["上った","のぼった"],["。"]]},{"verse":2,"text":"祭司長たちやユダヤ人のおもだった人々は、パウロを訴え出て、彼をエルサレムへ送り返すよう計らっていただきたいと、フェストゥスに頼んだ。途中で殺そうと陰謀をたくらんでいたのである。","tok":[["祭司長","さいしちょう"],["たち"],["や"],["ユダヤ人","ゆだやじん"],["の"],["おも"],["だった"],["人々","ひとびと"],["は"],["、"],["パウロ"],["を"],["訴え出て","うったえでて"],["、"],["彼","かれ"],["を"],["エルサレム"],["へ"],["送り返す","おくりかえす"],["よう"],["計らって","はからって"],["いただきたい"],["と"],["、"],["フェストゥス"],["に"],["頼んだ","たのんだ"],["。"],["途中","とちゅう"],["で"],["殺そう","ころそう"],["と"],["陰謀","いんぼう"],["を"],["たくらんで"],["いた"],["ので"],["ある"],["。"]]},{"verse":4,"text":"ところがフェストゥスは、パウロはカイサリアで監禁されており、自分も間もなくそこへ帰るつもりであると答え、","tok":[["ところ"],["が"],["フェストゥス"],["は"],["、"],["パウロ"],["は"],["カイサリア"],["で"],["監禁","かんきん"],["されて"],["おり"],["、"],["自分","じぶん"],["も"],["間","ま"],["も"],["なく"],["そこ"],["へ"],["帰る","かえる"],["つもり"],["で"],["ある"],["と"],["答え","こたえ"],["、"]]},{"verse":5,"text":"「だから、その男に不都合なところがあるというのなら、あなたたちのうちの有力者が、わたしと一緒に下って行って、告発すればよいではないか」と言った。","tok":[["「"],["だ"],["から"],["、"],["その"],["男","おとこ"],["に"],["不都合","ふつごう"],["な"],["ところ"],["が"],["ある"],["と"],["いう"],["の"],["なら"],["、"],["あなた"],["たち"],["の"],["うち"],["の"],["有力","ゆうりょく"],["者","しゃ"],["が"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["下って","くだって"],["行って","いって"],["、"],["告発","こくはつ"],["すれば"],["よいで"],["は"],["ない"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"フェストゥスは、八日か十日ほど彼らの間で過ごしてから、カイサリアへ下り、翌日、裁判の席に着いて、パウロを引き出すように命令した。","tok":[["フェストゥス"],["は"],["、"],["八日","ようか"],["か"],["十日","とうか"],["ほど"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["過ごして","すごして"],["から"],["、"],["カイサリア"],["へ"],["下り","くだり"],["、"],["翌日","よくじつ"],["、"],["裁判","さいばん"],["の"],["席","せき"],["に"],["着いて","ついて"],["、"],["パウロ"],["を"],["引き出す","ひきだす"],["よう"],["に"],["命令","めいれい"],["した"],["。"]]},{"verse":7,"text":"パウロが出廷すると、エルサレムから下って来たユダヤ人たちが彼を取り囲んで、重い罪状をあれこれ言い立てたが、それを立証することはできなかった。","tok":[["パウロ"],["が"],["出廷","しゅってい"],["する"],["と"],["、"],["エルサレム"],["から"],["下って","くだって"],["来た","きた"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["彼","かれ"],["を"],["取り囲んで","とりかこんで"],["、"],["重い","おもい"],["罪状","ざいじょう"],["を"],["あれこれ"],["言い立てた","いいたてた"],["が"],["、"],["それ"],["を"],["立証","りっしょう"],["する"],["こと"],["は"],["できなかった"],["。"]]},{"verse":8,"text":"パウロは、「私は、ユダヤ人の律法に対しても、神殿に対しても、皇帝に対しても何も罪を犯したことはありません」と弁明した。","tok":[["パウロ"],["は"],["、"],["「"],["私","わたくし"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["律法","りっぽう"],["に対して","にたいして"],["も"],["、"],["神殿","しんでん"],["に対して","にたいして"],["も"],["、"],["皇帝","こうてい"],["に対して","にたいして"],["も"],["何","なん"],["も"],["罪","つみ"],["を"],["犯した","おかした"],["こと"],["は"],["ありません"],["」"],["と"],["弁明","べんめい"],["した"],["。"]]},{"verse":9,"text":"しかし、フェストゥスはユダヤ人に気に入られようとして、パウロに言った。「お前は、エルサレムに上って、そこでこれらのことについて、わたしの前で裁判を受けたいと思うか。」","tok":[["しかし"],["、"],["フェストゥス"],["は"],["ユダヤ人","ゆだやじん"],["に"],["気","き"],["に"],["入られよう","いられよう"],["として"],["、"],["パウロ"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["は"],["、"],["エルサレム"],["に"],["上って","のぼって"],["、"],["そこ"],["で"],["これ"],["ら"],["の"],["こと"],["について"],["、"],["わたし"],["の"],["前","まえ"],["で"],["裁判","さいばん"],["を"],["受けたい","うけたい"],["と"],["思う","おもう"],["か"],["。"],["」"]]},{"verse":10,"text":"パウロは言った。「私は、皇帝の法廷に出頭しているのですから、ここで裁判を受けるのが当然です。よくご存じのとおり、私はユダヤ人に対して何も悪いことをしていません。","tok":[["パウロ"],["は"],["言った","いった"],["。"],["「"],["私","わたくし"],["は"],["、"],["皇帝","こうてい"],["の"],["法廷","ほうてい"],["に"],["出頭","しゅっとう"],["して"],["いる"],["の"],["です"],["から"],["、"],["ここ"],["で"],["裁判","さいばん"],["を"],["受ける","うける"],["の"],["が"],["当然","とうぜん"],["です"],["。"],["よく"],["ご存じ","ごぞんじ"],["の"],["とおり"],["、"],["私","わたくし"],["は"],["ユダヤ人","ゆだやじん"],["に対して","にたいして"],["何","なん"],["も"],["悪い","わるい"],["こと"],["を"],["して"],["いません"],["。"]]},{"verse":11,"text":"もし、悪いことをし、何か死罪に当たることをしたのであれば、決して死を免れようとは思いません。しかし、この人たちの訴えが事実無根なら、だれも私を彼らに引き渡すような取り計らいはできません。私は皇帝に上訴します。」","tok":[["もし"],["、"],["悪い","わるい"],["こと"],["を"],["し"],["、"],["何","なん"],["か"],["死罪","しざい"],["に"],["当たる","あたる"],["こと"],["を"],["した"],["ので"],["あれば"],["、"],["決して","けっして"],["死","し"],["を"],["免れよう","まぬがれよう"],["と"],["は"],["思いません","おもいません"],["。"],["しかし"],["、"],["この"],["人","ひと"],["たち"],["の"],["訴え","うったえ"],["が"],["事実","じじつ"],["無根","むこん"],["なら"],["、"],["だれ"],["も"],["私","わたくし"],["を"],["彼","かれ"],["ら"],["に"],["引き渡す","ひきわたす"],["よう"],["な"],["取り計らい","とりはからい"],["は"],["できません"],["。"],["私","わたくし"],["は"],["皇帝","こうてい"],["に"],["上訴","じょうそ"],["します"],["。"],["」"]]},{"verse":12,"text":"そこで、フェストゥスは陪審の人々と協議してから、「皇帝に上訴したのだから、皇帝のもとに出頭するように」と答えた。","tok":[["そこ"],["で"],["、"],["フェストゥス"],["は"],["陪審","ばいしん"],["の"],["人々","ひとびと"],["と"],["協議","きょうぎ"],["して"],["から"],["、"],["「"],["皇帝","こうてい"],["に"],["上訴","じょうそ"],["した"],["の"],["だ"],["から"],["、"],["皇帝","こうてい"],["の"],["もと"],["に"],["出頭","しゅっとう"],["する"],["よう"],["に"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":13,"text":"数日たって、アグリッパ王とベルニケが、フェストゥスに敬意を表するためにカイサリアに来た。","tok":[["数日","すうじつ"],["たって"],["、"],["アグリッパ"],["王","おう"],["と"],["ベルニケ"],["が"],["、"],["フェストゥス"],["に"],["敬意","けいい"],["を"],["表する","ひょうする"],["ため"],["に"],["カイサリア"],["に"],["来た","きた"],["。"]]},{"verse":14,"text":"彼らが幾日もそこに滞在していたので、フェストゥスはパウロの件を王に持ち出して言った。「ここに、フェリクスが囚人として残していった男がいます。","tok":[["彼","かれ"],["ら"],["が"],["幾日","いくか"],["も"],["そこ"],["に"],["滞在","たいざい"],["して"],["いた"],["ので"],["、"],["フェストゥス"],["は"],["パウロ"],["の"],["件","けん"],["を"],["王","おう"],["に"],["持ち出して","もちだして"],["言った","いった"],["。"],["「"],["ここ"],["に"],["、"],["フェリクス"],["が"],["囚人","しゅうじん"],["として"],["残して","のこして"],["いった"],["男","おとこ"],["が"],["います"],["。"]]},{"verse":15,"text":"わたしがエルサレムに行ったときに、祭司長たちやユダヤ人の長老たちがこの男を訴え出て、有罪の判決を下すように要求したのです。","tok":[["わたし"],["が"],["エルサレム"],["に"],["行った","いった"],["とき"],["に"],["、"],["祭司長","さいしちょう"],["たち"],["や"],["ユダヤ人","ゆだやじん"],["の"],["長老","ちょうろう"],["たち"],["が"],["この"],["男","おとこ"],["を"],["訴え出て","うったえでて"],["、"],["有罪","ゆうざい"],["の"],["判決","はんけつ"],["を"],["下す","くだす"],["よう"],["に"],["要求","ようきゅう"],["した"],["の"],["です"],["。"]]},{"verse":16,"text":"わたしは彼らに答えました。『被告が告発されたことについて、原告の面前で弁明する機会も与えられず、引き渡されるのはローマ人の慣習ではない』と。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["答えました","こたえました"],["。"],["『"],["被告","ひこく"],["が"],["告発","こくはつ"],["された"],["こと"],["について"],["、"],["原告","げんこく"],["の"],["面前","めんぜん"],["で"],["弁明","べんめい"],["する"],["機会","きかい"],["も"],["与えられず","あたえられず"],["、"],["引き渡される","ひきわたされる"],["の"],["は"],["ローマ人","ろーまじん"],["の"],["慣習","かんしゅう"],["で"],["は"],["ない"],["』"],["と"],["。"]]},{"verse":17,"text":"それで、彼らが連れ立って当地へ来ましたから、わたしはすぐにその翌日、裁判の席に着き、その男を出廷させるように命令しました。","tok":[["それ"],["で"],["、"],["彼","かれ"],["ら"],["が"],["連れ立って","つれだって"],["当地","とうち"],["へ"],["来ました","きました"],["から"],["、"],["わたし"],["は"],["すぐ"],["に"],["その"],["翌日","よくじつ"],["、"],["裁判","さいばん"],["の"],["席","せき"],["に"],["着き","つき"],["、"],["その"],["男","おとこ"],["を"],["出廷","しゅってい"],["させる"],["よう"],["に"],["命令","めいれい"],["しました"],["。"]]},{"verse":18,"text":"告発者たちは立ち上がりましたが、彼について、わたしが予想していたような罪状は何一つ指摘できませんでした。","tok":[["告発者","こくはつしゃ"],["たち"],["は"],["立ち上がりました","たちあがりました"],["が"],["、"],["彼","かれ"],["について"],["、"],["わたし"],["が"],["予想","よそう"],["して"],["いた"],["よう"],["な"],["罪状","ざいじょう"],["は"],["何","なん"],["一","ひと"],["つ"],["指摘","してき"],["できませんでした"],["。"]]},{"verse":19,"text":"パウロと言い争っている問題は、彼ら自身の宗教に関することと、死んでしまったイエスとかいう者のことです。このイエスが生きていると、パウロは主張しているのです。","tok":[["パウロ"],["と"],["言い争って","いいあらそって"],["いる"],["問題","もんだい"],["は"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["の"],["宗教","しゅうきょう"],["に"],["関する","かんする"],["こと"],["と"],["、"],["死んで","しんで"],["しまった"],["イエス"],["と"],["か"],["いう"],["者","もの"],["の"],["こと"],["です"],["。"],["この"],["イエス"],["が"],["生きて","いきて"],["いる"],["と"],["、"],["パウロ"],["は"],["主張","しゅちょう"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":20,"text":"わたしは、これらのことの調査の方法が分からなかったので、『エルサレムへ行き、そこでこれらの件に関して裁判を受けたくはないか』と言いました。","tok":[["わたし"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["の"],["調査","ちょうさ"],["の"],["方法","ほうほう"],["が"],["分からなかった","わからなかった"],["ので"],["、"],["『"],["エルサレム"],["へ"],["行き","いき"],["、"],["そこ"],["で"],["これ"],["ら"],["の"],["件","けん"],["に関して","にかんして"],["裁判","さいばん"],["を"],["受けたく","うけたく"],["は"],["ない"],["か"],["』"],["と"],["言いました","いいました"],["。"]]},{"verse":21,"text":"しかしパウロは、皇帝陛下の判決を受けるときまで、ここにとどめておいてほしいと願い出ましたので、皇帝のもとに護送するまで、彼をとどめておくように命令しました。」","tok":[["しかし"],["パウロ"],["は"],["、"],["皇帝","こうてい"],["陛下","へいか"],["の"],["判決","はんけつ"],["を"],["受ける","うける"],["とき"],["まで"],["、"],["ここ"],["に"],["とどめて"],["おいて"],["ほしい"],["と"],["願い出ました","ねがいでました"],["ので"],["、"],["皇帝","こうてい"],["の"],["もと"],["に"],["護送","ごそう"],["する"],["まで"],["、"],["彼","かれ"],["を"],["とどめて"],["おく"],["よう"],["に"],["命令","めいれい"],["しました"],["。"],["」"]]},{"verse":22,"text":"そこで、アグリッパがフェストゥスに、「わたしも、その男の言うことを聞いてみたいと思います」と言うと、フェストゥスは、「明日、お聞きになれます」と言った。","tok":[["そこ"],["で"],["、"],["アグリッパ"],["が"],["フェストゥス"],["に"],["、"],["「"],["わたし"],["も"],["、"],["その"],["男","おとこ"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["みたい"],["と"],["思います","おもいます"],["」"],["と"],["言う","ゆう"],["と"],["、"],["フェストゥス"],["は"],["、"],["「"],["明日","あす"],["、"],["お聞き","おきき"],["に"],["なれます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":23,"text":"翌日、アグリッパとベルニケが盛装して到着し、千人隊長たちや町のおもだった人々と共に謁見室に入ると、フェストゥスの命令でパウロが引き出された。","tok":[["翌日","よくじつ"],["、"],["アグリッパ"],["と"],["ベルニケ"],["が"],["盛装","せいそう"],["して"],["到着","とうちゃく"],["し"],["、"],["千人","せんにん"],["隊長","たいちょう"],["たち"],["や"],["町","まち"],["の"],["おも"],["だった"],["人々","ひとびと"],["と"],["共","とも"],["に"],["謁見室","えっけんしつ"],["に"],["入る","はいる"],["と"],["、"],["フェストゥス"],["の"],["命令","めいれい"],["で"],["パウロ"],["が"],["引き出された","ひきだされた"],["。"]]},{"verse":24,"text":"そこで、フェストゥスは言った。「アグリッパ王、ならびに列席の諸君、この男を御覧なさい。ユダヤ人がこぞってもう生かしておくべきではないと叫び、エルサレムでもこの地でもわたしに訴え出ているのは、この男のことです。","tok":[["そこ"],["で"],["、"],["フェストゥス"],["は"],["言った","いった"],["。"],["「"],["アグリッパ"],["王","おう"],["、"],["ならび"],["に"],["列席","れっせき"],["の"],["諸君","しょくん"],["、"],["この"],["男","おとこ"],["を"],["御覧","ごらん"],["なさい"],["。"],["ユダヤ人","ゆだやじん"],["が"],["こぞって"],["もう"],["生かして","いかして"],["おくべきで"],["は"],["ない"],["と"],["叫び","さけび"],["、"],["エルサレム"],["で"],["も"],["この"],["地","ち"],["で"],["も"],["わたし"],["に"],["訴え出て","うったえでて"],["いる"],["の"],["は"],["、"],["この"],["男","おとこ"],["の"],["こと"],["です"],["。"]]},{"verse":25,"text":"しかし、彼が死罪に相当するようなことは何もしていないということが、わたしには分かりました。ところが、この者自身が皇帝陛下に上訴したので、護送することに決定しました。","tok":[["しかし"],["、"],["彼","かれ"],["が"],["死罪","しざい"],["に"],["相当","そうとう"],["する"],["よう"],["な"],["こと"],["は"],["何","なん"],["も"],["して"],["いない"],["と"],["いう"],["こと"],["が"],["、"],["わたし"],["に"],["は"],["分かりました","わかりました"],["。"],["ところ"],["が"],["、"],["この"],["者","もの"],["自身","じしん"],["が"],["皇帝","こうてい"],["陛下","へいか"],["に"],["上訴","じょうそ"],["した"],["ので"],["、"],["護送","ごそう"],["する"],["こと"],["に"],["決定","けってい"],["しました"],["。"]]},{"verse":26,"text":"しかし、この者について確実なことは、何も陛下に書き送ることができません。そこで、諸君の前に、特にアグリッパ王、貴下の前に彼を引き出しました。よく取り調べてから、何か書き送るようにしたいのです。","tok":[["しかし"],["、"],["この"],["者","もの"],["について"],["確実","かくじつ"],["な"],["こと"],["は"],["、"],["何","なん"],["も"],["陛下","へいか"],["に"],["書き送る","かきおくる"],["こと"],["が"],["できません"],["。"],["そこ"],["で"],["、"],["諸君","しょくん"],["の"],["前","まえ"],["に"],["、"],["特に","とくに"],["アグリッパ"],["王","おう"],["、"],["貴下","きか"],["の"],["前","まえ"],["に"],["彼","かれ"],["を"],["引き出しました","ひきだしました"],["。"],["よく"],["取り調べて","とりしらべて"],["から"],["、"],["何","なん"],["か"],["書き送る","かきおくる"],["よう"],["に"],["したい"],["の"],["です"],["。"]]},{"verse":27,"text":"囚人を護送するのに、その罪状を示さないのは理に合わないと、わたしには思われるからです。」","tok":[["囚人","しゅうじん"],["を"],["護送","ごそう"],["する"],["のに"],["、"],["その"],["罪状","ざいじょう"],["を"],["示さない","しめさない"],["の"],["は"],["理","り"],["に"],["合わない","あわない"],["と"],["、"],["わたし"],["に"],["は"],["思われる","おもわれる"],["から"],["です"],["。"],["」"]]}]
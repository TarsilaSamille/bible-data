[{"verse":1,"text":"クセルクセスの時代のことである。このクセルクセスは、インドからクシュに至るまで百二十七州の支配者であった。","tok":[["クセルクセス"],["の"],["時代","じだい"],["の"],["こと"],["で"],["ある"],["。"],["この"],["クセルクセス"],["は"],["、"],["インド"],["から"],["クシュ"],["に"],["至る","いたる"],["まで"],["百二十七","ひゃくにじゅうなな"],["州","しゅう"],["の"],["支配者","しはいしゃ"],["で"],["あった"],["。"]]},{"verse":2,"text":"そのころ、クセルクセス王は要塞の町スサで王位につき、","tok":[["その"],["ころ"],["、"],["クセルクセス"],["王","おう"],["は"],["要塞","ようさい"],["の"],["町","まち"],["スサ"],["で"],["王位","おうい"],["に"],["つき"],["、"]]},{"verse":3,"text":"その治世の第三年に、酒宴を催し、大臣、家臣のことごとく、ペルシアとメディアの軍人、貴族および諸州の高官たちを招いた。","tok":[["その"],["治世","ちせい"],["の"],["第","だい"],["三","さん"],["年","ねん"],["に"],["、"],["酒宴","しゅえん"],["を"],["催し","もよおし"],["、"],["大臣","だいじん"],["、"],["家臣","かしん"],["の"],["ことごとく"],["、"],["ペルシア"],["と"],["メディア"],["の"],["軍人","ぐんじん"],["、"],["貴族","きぞく"],["および"],["諸州","しょしゅう"],["の"],["高官","こうかん"],["たち"],["を"],["招いた","まねいた"],["。"]]},{"verse":4,"text":"こうして王は、百八十日の長期にわたって自分の国がどれほど富み栄え、その威力がどれほど貴く輝かしいものであるかを示した。","tok":[["こう"],["して"],["王","おう"],["は"],["、"],["百八十日","ひゃくはちとうか"],["の"],["長期","ちょうき"],["に"],["わたって"],["自分","じぶん"],["の"],["国","くに"],["が"],["どれ"],["ほど"],["富み栄え","とみさかえ"],["、"],["その"],["威力","いりょく"],["が"],["どれ"],["ほど"],["貴く","とうとく"],["輝かしい","かがやかしい"],["もの"],["で"],["ある"],["か"],["を"],["示した","しめした"],["。"]]},{"verse":5,"text":"それが終わると、王は七日間、酒宴を王宮の庭園で催し、要塞の町スサに住む者を皆、身分の上下を問わず招いた。","tok":[["それ"],["が"],["終わる","おわる"],["と"],["、"],["王","おう"],["は"],["七","なな"],["日間","かかん"],["、"],["酒宴","しゅえん"],["を"],["王宮","おうきゅう"],["の"],["庭園","ていえん"],["で"],["催し","もよおし"],["、"],["要塞","ようさい"],["の"],["町","まち"],["スサ"],["に"],["住む","すむ"],["者","もの"],["を"],["皆","みな"],["、"],["身分","みぶん"],["の"],["上下","じょうげ"],["を"],["問わず","とわず"],["招いた","まねいた"],["。"]]},{"verse":6,"text":"大理石の柱から柱へと紅白の組みひもが張り渡され、そこに純白の亜麻布、みごとな綿織物、紫の幔幕が一連の銀の輪によって掛けられていた。また、緑や白の大理石、真珠貝や黒曜石を使ったモザイクの床には、金や銀の長いすが並べられていた。","tok":[["大理石","だいりせき"],["の"],["柱","はしら"],["から"],["柱","はしら"],["へ"],["と"],["紅白","こうはく"],["の"],["組みひも","くみひも"],["が"],["張り渡され","はりわたされ"],["、"],["そこ"],["に"],["純白","じゅんぱく"],["の"],["亜","あ"],["麻布","あざぶ"],["、"],["みごと"],["な"],["綿","わた"],["織物","おりもの"],["、"],["紫","むらさき"],["の"],["幔幕","まんまく"],["が"],["一連","いちれん"],["の"],["銀","ぎん"],["の"],["輪","わ"],["によって"],["掛けられて","かけられて"],["いた"],["。"],["また"],["、"],["緑","みどり"],["や"],["白","しろ"],["の"],["大理石","だいりせき"],["、"],["真珠貝","しんじゅがい"],["や"],["黒曜石","こくようせき"],["を"],["使った","つかった"],["モザイク"],["の"],["床","ゆか"],["に"],["は"],["、"],["金","きん"],["や"],["銀","ぎん"],["の"],["長いす","ながいす"],["が"],["並べられて","ならべられて"],["いた"],["。"]]},{"verse":7,"text":"酒を供するための金の杯は一つ一つ趣を異にし、王室用のぶどう酒が、王の寛大さを示すにふさわしく、惜しげもなく振る舞われた。","tok":[["酒","さけ"],["を"],["供する","きょうする"],["ため"],["の"],["金","かね"],["の"],["杯","さかずき"],["は"],["一","ひと"],["つ"],["一","ひと"],["つ"],["趣","おもむき"],["を"],["異","こと"],["に"],["し"],["、"],["王室用","おうしつよう"],["の"],["ぶどう酒","ぶどうしゅ"],["が"],["、"],["王","おう"],["の"],["寛大","かんだい"],["さ"],["を"],["示す","しめす"],["に"],["ふさわしく"],["、"],["惜し","おし"],["げ"],["も"],["なく"],["振る舞われた","ふるまわれた"],["。"]]},{"verse":8,"text":"しかし、定めによって酒を飲むことは強いられてはいなかった。王の命令によって給仕長たちは、人々に思いどおりにさせていたからである。","tok":[["しかし"],["、"],["定め","さだめ"],["によって"],["酒","さけ"],["を"],["飲む","のむ"],["こと"],["は"],["強いられて","しいられて"],["は"],["いなかった"],["。"],["王","おう"],["の"],["命令","めいれい"],["によって"],["給仕長","きゅうじちょう"],["たち"],["は"],["、"],["人々","ひとびと"],["に"],["思い","おもい"],["どおり"],["に"],["させて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"王妃ワシュティもクセルクセス王の宮殿で女のための酒宴を催していた。","tok":[["王妃","おうひ"],["ワシュティ"],["も"],["クセルクセス"],["王","おう"],["の"],["宮殿","きゅうでん"],["で"],["女","おんな"],["の"],["ため"],["の"],["酒宴","しゅえん"],["を"],["催して","もよおして"],["いた"],["。"]]},{"verse":10,"text":"七日目のことである。ぶどう酒で上機嫌になったクセルクセス王は、そば近く仕える宦官メフマン、ビゼタ、ハルボナ、ビグタ、アバグタ、ゼタル、カルカスの七人に命じて、","tok":[["七日目","ななかめ"],["の"],["こと"],["で"],["ある"],["。"],["ぶどう酒","ぶどうしゅ"],["で"],["上機嫌","じょうきげん"],["に"],["なった"],["クセルクセス"],["王","おう"],["は"],["、"],["そば"],["近く","ちかく"],["仕える","つかえる"],["宦官","かんがん"],["メフマン"],["、"],["ビゼタ"],["、"],["ハルボナ"],["、"],["ビグタ"],["、"],["アバグタ"],["、"],["ゼタル"],["、"],["カルカス"],["の"],["七人","しちにん"],["に"],["命じて","めいじて"],["、"]]},{"verse":11,"text":"冠を着けた王妃ワシュティを召し出そうとした。その美しさを高官および列席する民に見せようというのである。王妃は美しい人であった。","tok":[["冠","かんむり"],["を"],["着けた","つけた"],["王妃","おうひ"],["ワシュティ"],["を"],["召し出そう","めしだそう"],["と"],["した"],["。"],["その"],["美し","うつくし"],["さ"],["を"],["高官","こうかん"],["および"],["列席","れっせき"],["する"],["民","たみ"],["に"],["見せよう","みせよう"],["と"],["いう"],["ので"],["ある"],["。"],["王妃","おうひ"],["は"],["美しい","うつくしい"],["人","ひと"],["で"],["あった"],["。"]]},{"verse":12,"text":"ところが、王妃ワシュティは宦官の伝えた王の命令を拒み、来ようとしなかった。王は大いに機嫌を損ね、怒りに燃え、","tok":[["ところ"],["が"],["、"],["王妃","おうひ"],["ワシュティ"],["は"],["宦官","かんがん"],["の"],["伝えた","つたえた"],["王","おう"],["の"],["命令","めいれい"],["を"],["拒み","こばみ"],["、"],["来よう","こよう"],["と"],["しなかった"],["。"],["王","おう"],["は"],["大いに","おおいに"],["機嫌","きげん"],["を"],["損ね","そこね"],["、"],["怒り","いかり"],["に"],["燃え","もえ"],["、"]]},{"verse":13,"text":"経験を積んだ賢人たちに事を諮った。王の身辺の事柄はすべて、国の定めや裁きに通じている人々によって審議されることになっていた。","tok":[["経験","けいけん"],["を"],["積んだ","つんだ"],["賢人","けんじん"],["たち"],["に"],["事","こと"],["を"],["諮った","はかった"],["。"],["王","おう"],["の"],["身辺","しんぺん"],["の"],["事柄","ことがら"],["は"],["すべて"],["、"],["国","くに"],["の"],["定め","さだめ"],["や"],["裁き","さばき"],["に"],["通じて","つうじて"],["いる"],["人々","ひとびと"],["によって"],["審議","しんぎ"],["される"],["こと"],["に"],["なって"],["いた"],["。"]]},{"verse":14,"text":"王は、王の側近で、王国の最高の地位にある、ペルシアとメディアの七人の大臣カルシェナ、シェタル、アドマタ、タルシシュ、メレス、マルセナ、メムカンを呼び寄せた。","tok":[["王","おう"],["は"],["、"],["王","おう"],["の"],["側近","そっきん"],["で"],["、"],["王国","おうこく"],["の"],["最高","さいこう"],["の"],["地位","ちい"],["に"],["ある"],["、"],["ペルシア"],["と"],["メディア"],["の"],["七人","しちにん"],["の"],["大臣","だいじん"],["カルシェナ"],["、"],["シェタル"],["、"],["アドマタ"],["、"],["タルシシュ"],["、"],["メレス"],["、"],["マルセナ"],["、"],["メムカン"],["を"],["呼び寄せた","よびよせた"],["。"]]},{"verse":15,"text":"「王妃ワシュティは、わたしが宦官によって伝えた命令に従わなかった。この場合、国の定めによれば王妃をどのように扱うべきか。」","tok":[["「"],["王妃","おうひ"],["ワシュティ"],["は"],["、"],["わたし"],["が"],["宦官","かんがん"],["によって"],["伝えた","つたえた"],["命令","めいれい"],["に"],["従わなかった","したがわなかった"],["。"],["この"],["場合","ばあい"],["、"],["国","くに"],["の"],["定め","さだめ"],["に"],["よれば"],["王妃","おうひ"],["を"],["どの"],["よう"],["に"],["扱うべき","あつかうべき"],["か"],["。"],["」"]]},{"verse":16,"text":"メムカンが王と大臣一同に向かって言った。「王妃ワシュティのなさったことは、ただ王のみならず、国中のすべての高官、すべての民にとって都合の悪いことです。","tok":[["メムカン"],["が"],["王","おう"],["と"],["大臣","だいじん"],["一同","いちどう"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["王妃","おうひ"],["ワシュティ"],["の"],["なさった"],["こと"],["は"],["、"],["ただ"],["王","おう"],["のみ"],["ならず"],["、"],["国中","くにちゅう"],["の"],["すべて"],["の"],["高官","こうかん"],["、"],["すべて"],["の"],["民","たみ"],["にとって"],["都合","つごう"],["の"],["悪い","わるい"],["こと"],["です"],["。"]]},{"verse":17,"text":"この王妃の事件が知れ渡りますと、女たちは皆、『王妃ワシュティは王に召されても、お出ましにならなかった』と申して、夫を軽蔑の目で見るようになります。","tok":[["この"],["王妃","おうひ"],["の"],["事件","じけん"],["が"],["知れ渡ります","しれわたります"],["と"],["、"],["女","おんな"],["たち"],["は"],["皆","みな"],["、"],["『"],["王妃","おうひ"],["ワシュティ"],["は"],["王","おう"],["に"],["召されて","めされて"],["も"],["、"],["お出まし","おでまし"],["に"],["ならなかった"],["』"],["と"],["申して","もうして"],["、"],["夫","おっと"],["を"],["軽蔑","けいべつ"],["の"],["目","め"],["で"],["見る","みる"],["よう"],["に"],["なります"],["。"]]},{"verse":18,"text":"今日この日にも、ペルシアとメディアの高官夫人たちは、この王妃の事件を聞いて、王にお仕えするすべての高官に向かってそう申すにちがいありません。何とも侮辱的で腹立たしいことです。","tok":[["今日","きょう"],["この"],["日","ひ"],["に"],["も"],["、"],["ペルシア"],["と"],["メディア"],["の"],["高官","こうかん"],["夫人","ふじん"],["たち"],["は"],["、"],["この"],["王妃","おうひ"],["の"],["事件","じけん"],["を"],["聞いて","きいて"],["、"],["王","おう"],["に"],["お仕え","おつかえ"],["する"],["すべて"],["の"],["高官","こうかん"],["に"],["向かって","むかって"],["そう"],["申す","もうす"],["に"],["ちがい"],["ありません"],["。"],["何","なん"],["と"],["も"],["侮辱","ぶじょく"],["的","てき"],["で"],["腹立たしい","はらだたしい"],["こと"],["です"],["。"]]},{"verse":19,"text":"もしもお心に適いますなら、『ワシュティがクセルクセス王の前に出ることを禁ずる。王妃の位は、より優れた他の女に与える』との命令を王御自身お下しになり、これをペルシアとメディアの国法の中に書き込ませ、確定事項となさってはいかがでしょうか。","tok":[["もし"],["も"],["お心","おこころ"],["に"],["適いますなら","かないますなら"],["、"],["『"],["ワシュティ"],["が"],["クセルクセス"],["王","おう"],["の"],["前","まえ"],["に"],["出る","でる"],["こと"],["を"],["禁ずる","きんずる"],["。"],["王妃","おうひ"],["の"],["位","くらい"],["は"],["、"],["より"],["優れた","すぐれた"],["他","ほか"],["の"],["女","おんな"],["に"],["与える","あたえる"],["』"],["と"],["の"],["命令","めいれい"],["を"],["王","おう"],["御自身","ごじしん"],["お下し","おおろし"],["に"],["なり"],["、"],["これ"],["を"],["ペルシア"],["と"],["メディア"],["の"],["国法","こくほう"],["の"],["中","なか"],["に"],["書き込ませ","かきこませ"],["、"],["確定","かくてい"],["事項","じこう"],["と"],["なさって"],["は"],["いかが"],["でしょう"],["か"],["。"]]},{"verse":20,"text":"お出しになった勅令がこの大国の津々浦々に聞こえますと、女たちは皆、身分のいかんにかかわらず夫を敬うようになりましょう。」","tok":[["お出し","おだし"],["に"],["なった"],["勅令","ちょくれい"],["が"],["この"],["大国","たいこく"],["の"],["津々","つつ"],["浦々","うらうら"],["に"],["聞こえます","きこえます"],["と"],["、"],["女","おんな"],["たち"],["は"],["皆","みな"],["、"],["身分","みぶん"],["の"],["いかん"],["に"],["かかわらず"],["夫","おっと"],["を"],["敬う","うやまう"],["よう"],["に"],["なりましょう"],["。"],["」"]]},{"verse":21,"text":"王にも大臣たちにもこの発言は適切であると思われ、王はメムカンの言うとおりにした。","tok":[["王","おう"],["に"],["も"],["大臣","だいじん"],["たち"],["に"],["も"],["この"],["発言","はつげん"],["は"],["適切","てきせつ"],["で"],["ある"],["と"],["思われ","おもわれ"],["、"],["王","おう"],["は"],["メムカン"],["の"],["言う","いう"],["とおり"],["に"],["した"],["。"]]},{"verse":22,"text":"王は支配下のすべての州に勅書を送ったが、それは州ごとにその州の文字で、また、民族ごとにその民族の言語で書かれていた。すべての男子が自分の家の主人となり、自分の母国語で話せるようにとの計らいからであった。","tok":[["王","おう"],["は"],["支配下","しはいか"],["の"],["すべて"],["の"],["州","しゅう"],["に"],["勅書","ちょくしょ"],["を"],["送った","おくった"],["が"],["、"],["それ"],["は"],["州","しゅう"],["ごと"],["に"],["その"],["州","しゅう"],["の"],["文字","もじ"],["で"],["、"],["また"],["、"],["民族","みんぞく"],["ごと"],["に"],["その"],["民族","みんぞく"],["の"],["言語","げんご"],["で"],["書かれて","かかれて"],["いた"],["。"],["すべて"],["の"],["男子","だんし"],["が"],["自分","じぶん"],["の"],["家","いえ"],["の"],["主人","しゅじん"],["と"],["なり"],["、"],["自分","じぶん"],["の"],["母国語","ぼこくご"],["で"],["話せる","はなせる"],["よう"],["に"],["と"],["の"],["計らい","はからい"],["から"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"その日クセルクセス王は、ユダヤ人の敵ハマンの家を王妃エステルに与えた。エステルはモルデカイとの間柄を知らせたので、モルデカイは王の前に出た。","tok":[["その"],["日","ひ"],["クセルクセス"],["王","おう"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["敵","てき"],["ハマン"],["の"],["家","いえ"],["を"],["王妃","おうひ"],["エステル"],["に"],["与えた","あたえた"],["。"],["エステル"],["は"],["モルデカイ"],["と"],["の"],["間柄","あいだがら"],["を"],["知らせた","しらせた"],["ので"],["、"],["モルデカイ"],["は"],["王","おう"],["の"],["前","まえ"],["に"],["出た","でた"],["。"]]},{"verse":2,"text":"王はハマンから取り返した指輪をモルデカイに与え、エステルは彼をハマンの家の管理人とした。","tok":[["王","おう"],["は"],["ハマン"],["から"],["取り返した","とりかえした"],["指輪","ゆびわ"],["を"],["モルデカイ"],["に"],["与え","あたえ"],["、"],["エステル"],["は"],["彼","かれ"],["を"],["ハマン"],["の"],["家","いえ"],["の"],["管理人","かんりにん"],["と"],["した"],["。"]]},{"verse":3,"text":"エステルは、再び王の前に申し出て、その足もとにひれ伏し、涙を流し、憐れみを乞い、アガグ人ハマンの悪事、すなわち、ユダヤ人に対して彼がたくらんだことを無効にしていただくことを願った。","tok":[["エステル"],["は"],["、"],["再び","ふたたび"],["王","おう"],["の"],["前","まえ"],["に"],["申し出て","もうしでて"],["、"],["その"],["足もと","あしもと"],["に"],["ひれ伏し","ひれふし"],["、"],["涙","なみだ"],["を"],["流し","ながし"],["、"],["憐れみ","あわれみ"],["を"],["乞い","こい"],["、"],["アガグ人","あがぐにん"],["ハマン"],["の"],["悪事","あくじ"],["、"],["すなわち"],["、"],["ユダヤ人","ゆだやじん"],["に対して","にたいして"],["彼","かれ"],["が"],["たくらんだ"],["こと"],["を"],["無効","むこう"],["に"],["して"],["いただく"],["こと"],["を"],["願った","ねがった"],["。"]]},{"verse":4,"text":"王が金の笏を差し伸べたので、エステルは身を起こし、王の前に立って、","tok":[["王","おう"],["が"],["金","かね"],["の"],["笏","しゃく"],["を"],["差し伸べた","さしのべた"],["ので"],["、"],["エステル"],["は"],["身","み"],["を"],["起こし","おこし"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["立って","たって"],["、"]]},{"verse":5,"text":"言った。「もしお心に適い、特別の御配慮をいただき、また王にも適切なことと思われ、私にも御目をかけていただけますなら、アガグ人ハメダタの子ハマンの考え出した文書の取り消しを書かせていただきとうございます。ハマンは国中のユダヤ人を皆殺しにしようとしてあの文書を作りました。","tok":[["言った","いった"],["。"],["「"],["もし"],["お心","おこころ"],["に"],["適い","かない"],["、"],["特別","とくべつ"],["の"],["御配慮","ごはいりょ"],["を"],["いただき"],["、"],["また"],["王","おう"],["に"],["も"],["適切","てきせつ"],["な"],["こと"],["と"],["思われ","おもわれ"],["、"],["私","わたくし"],["に"],["も"],["御目","おめ"],["を"],["かけて"],["いただけますなら"],["、"],["アガグ人","あがぐにん"],["ハメダタ"],["の"],["子","こ"],["ハマン"],["の"],["考え出した","かんがえだした"],["文書","ぶんしょ"],["の"],["取り消し","とりけし"],["を"],["書かせて","かかせて"],["いただきとう"],["ございます"],["。"],["ハマン"],["は"],["国中","くにちゅう"],["の"],["ユダヤ人","ゆだやじん"],["を"],["皆殺し","みなごろし"],["に"],["しよう"],["として"],["あの"],["文書","ぶんしょ"],["を"],["作りました","つくりました"],["。"]]},{"verse":6,"text":"私は自分の民族にふりかかる不幸を見るに忍びず、また同族の滅亡を見るに忍びないのでございます。」","tok":[["私","わたくし"],["は"],["自分","じぶん"],["の"],["民族","みんぞく"],["に"],["ふりかかる"],["不幸","ふこう"],["を"],["見る","みる"],["に"],["忍びず","しのびず"],["、"],["また"],["同族","どうぞく"],["の"],["滅亡","めつぼう"],["を"],["見る","みる"],["に"],["忍びない","しのびない"],["ので"],["ございます"],["。"],["」"]]},{"verse":7,"text":"そこでクセルクセス王は王妃エステルとユダヤ人モルデカイに言った。「わたしはハマンの家をエステルに与え、ハマンを木につるした。ハマンがユダヤ人を滅ぼそうとしたからにほかならない。","tok":[["そこ"],["で"],["クセルクセス"],["王","おう"],["は"],["王妃","おうひ"],["エステル"],["と"],["ユダヤ人","ゆだやじん"],["モルデカイ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["ハマン"],["の"],["家","いえ"],["を"],["エステル"],["に"],["与え","あたえ"],["、"],["ハマン"],["を"],["木","き"],["に"],["つるした"],["。"],["ハマン"],["が"],["ユダヤ人","ゆだやじん"],["を"],["滅ぼそう","ほろぼそう"],["と"],["した"],["から"],["に"],["ほか"],["ならない"],["。"]]},{"verse":8,"text":"お前たちはよいと思うことをユダヤ人のために王の名によって書き記し、王の指輪で印を押すがよい。王の名によって書き記され、王の指輪で印を押された文書は、取り消すことができない。」","tok":[["お前","おまえ"],["たち"],["は"],["よい"],["と"],["思う","おもう"],["こと"],["を"],["ユダヤ人","ゆだやじん"],["の"],["ため"],["に"],["王","おう"],["の"],["名","な"],["によって"],["書き記し","かきしるし"],["、"],["王","おう"],["の"],["指輪","ゆびわ"],["で"],["印","しるし"],["を"],["押す","おす"],["が"],["よい"],["。"],["王","おう"],["の"],["名","な"],["によって"],["書き記され","かきしるされ"],["、"],["王","おう"],["の"],["指輪","ゆびわ"],["で"],["印","しるし"],["を"],["押された","おされた"],["文書","ぶんしょ"],["は"],["、"],["取り消す","とりけす"],["こと"],["が"],["できない"],["。"],["」"]]},{"verse":9,"text":"そのころ、第三の月のこと、すなわちシワンの月の二十三日に、王の書記官が召集され、インドからクシュに至るまで、百二十七州にいるユダヤ人と総督、地方長官、諸州の高官たちに対してモルデカイが命ずるがままに文書が作成された。それは各州ごとにその州の文字で、各民族ごとにその民族の言語で、ユダヤ人にはユダヤ文字とその言語で、","tok":[["その"],["ころ"],["、"],["第","だい"],["三","さん"],["の"],["月","つき"],["の"],["こと"],["、"],["すなわち"],["シワン"],["の"],["月","つき"],["の"],["二十三","にじゅうさん"],["日","にち"],["に"],["、"],["王","おう"],["の"],["書記官","しょきかん"],["が"],["召集","しょうしゅう"],["され"],["、"],["インド"],["から"],["クシュ"],["に"],["至る","いたる"],["まで"],["、"],["百二十七","ひゃくにじゅうなな"],["州","しゅう"],["に"],["いる"],["ユダヤ人","ゆだやじん"],["と"],["総督","そうとく"],["、"],["地方","ちほう"],["長官","ちょうかん"],["、"],["諸州","しょしゅう"],["の"],["高官","こうかん"],["たち"],["に対して","にたいして"],["モルデカイ"],["が"],["命ずる","めいずる"],["が"],["まま"],["に"],["文書","ぶんしょ"],["が"],["作成","さくせい"],["された"],["。"],["それ"],["は"],["各州","かくしゅう"],["ごと"],["に"],["その"],["州","しゅう"],["の"],["文字","もじ"],["で"],["、"],["各","かく"],["民族","みんぞく"],["ごと"],["に"],["その"],["民族","みんぞく"],["の"],["言語","げんご"],["で"],["、"],["ユダヤ人","ゆだやじん"],["に"],["は"],["ユダヤ"],["文字","もじ"],["と"],["その"],["言語","げんご"],["で"],["、"]]},{"verse":10,"text":"クセルクセス王の名によって書き記され、王の指輪で印を押してあった。その文書は王家の飼育所で育てられた御用馬の早馬に乗った急使によって各地に届けられた。","tok":[["クセルクセス"],["王","おう"],["の"],["名","な"],["によって"],["書き記され","かきしるされ"],["、"],["王","おう"],["の"],["指輪","ゆびわ"],["で"],["印","しるし"],["を"],["押して","おして"],["あった"],["。"],["その"],["文書","ぶんしょ"],["は"],["王家","おうけ"],["の"],["飼育所","しいくしょ"],["で"],["育てられた","そだてられた"],["御用馬","ごようば"],["の"],["早馬","はやうま"],["に"],["乗った","のった"],["急使","きゅうし"],["によって"],["各地","かくち"],["に"],["届けられた","とどけられた"],["。"]]},{"verse":11,"text":"こうして王の命令によって、どの町のユダヤ人にも自分たちの命を守るために集合し、自分たちを迫害する民族や州の軍隊を女や子供に至るまで一人残らず滅ぼし、殺し、絶滅させ、その持ち物を奪い取ることが許された。","tok":[["こう"],["して"],["王","おう"],["の"],["命令","めいれい"],["によって"],["、"],["どの"],["町","まち"],["の"],["ユダヤ人","ゆだやじん"],["に"],["も"],["自分","じぶん"],["たち"],["の"],["命","いのち"],["を"],["守る","まもる"],["ため"],["に"],["集合","しゅうごう"],["し"],["、"],["自分","じぶん"],["たち"],["を"],["迫害","はくがい"],["する"],["民族","みんぞく"],["や"],["州","しゅう"],["の"],["軍隊","ぐんたい"],["を"],["女","おんな"],["や"],["子供","こども"],["に"],["至る","いたる"],["まで"],["一人","ひとり"],["残らず","のこらず"],["滅ぼし","ほろぼし"],["、"],["殺し","ころし"],["、"],["絶滅","ぜつめつ"],["させ"],["、"],["その"],["持ち物","もちもの"],["を"],["奪い取る","うばいとる"],["こと"],["が"],["許された","ゆるされた"],["。"]]},{"verse":12,"text":"これはクセルクセス王の国中どこにおいても一日だけ、第十二の月、すなわちアダルの月の十三日と定められた。","tok":[["これ"],["は"],["クセルクセス"],["王","おう"],["の"],["国中","くにちゅう"],["どこ"],["に"],["おいて"],["も"],["一","いち"],["日","にち"],["だけ"],["、"],["第","だい"],["十二","じゅうに"],["の"],["月","つき"],["、"],["すなわち"],["アダル"],["の"],["月","つき"],["の"],["十三","じゅうさん"],["日","にち"],["と"],["定められた","さだめられた"],["。"]]},{"verse":13,"text":"この文書の写しはどの州でもすべての民族に国の定めとして公示され、ユダヤ人は敵に復讐するためその日に備えるようになった。","tok":[["この"],["文書","ぶんしょ"],["の"],["写し","うつし"],["は"],["どの"],["州","しゅう"],["で"],["も"],["すべて"],["の"],["民族","みんぞく"],["に"],["国","くに"],["の"],["定め","さだめ"],["として"],["公示","こうじ"],["され"],["、"],["ユダヤ人","ゆだやじん"],["は"],["敵","てき"],["に"],["復讐","ふくしゅう"],["する"],["ため"],["その"],["日","ひ"],["に"],["備える","そなえる"],["よう"],["に"],["なった"],["。"]]},{"verse":14,"text":"御用馬の早馬に乗った急使は王の命令によって直ちに急いで出立し、要塞の町スサでもこの定めが言い渡された。","tok":[["御用馬","ごようば"],["の"],["早馬","はやうま"],["に"],["乗った","のった"],["急使","きゅうし"],["は"],["王","おう"],["の"],["命令","めいれい"],["によって"],["直ちに","ただちに"],["急いで","いそいで"],["出立","しゅったつ"],["し"],["、"],["要塞","ようさい"],["の"],["町","まち"],["スサ"],["で"],["も"],["この"],["定め","さだめ"],["が"],["言い渡された","いいわたされた"],["。"]]},{"verse":15,"text":"モルデカイが紫と白の王服に、大きな黄金の冠と白と赤の上着を着け、王の前から退出してくると、スサの都は歓声に包まれた。","tok":[["モルデカイ"],["が"],["紫","むらさき"],["と"],["白","しろ"],["の"],["王","おう"],["服","ふく"],["に"],["、"],["大きな","おおきな"],["黄金","おうごん"],["の"],["冠","かんむり"],["と"],["白","しろ"],["と"],["赤","あか"],["の"],["上着","うわぎ"],["を"],["着け","つけ"],["、"],["王","おう"],["の"],["前","まえ"],["から"],["退出","たいしゅつ"],["して"],["くる"],["と"],["、"],["スサ"],["の"],["都","と"],["は"],["歓声","かんせい"],["に"],["包まれた","つつまれた"],["。"]]},{"verse":16,"text":"それはユダヤ人にとって輝かしく、祝うべきこと、喜ばしく、誉れあることであった。","tok":[["それ"],["は"],["ユダヤ人","ゆだやじん"],["にとって"],["輝かしく","かがやかしく"],["、"],["祝うべき","いわうべき"],["こと"],["、"],["喜ばしく","よろこばしく"],["、"],["誉れ","ほまれ"],["ある"],["こと"],["で"],["あった"],["。"]]},{"verse":17,"text":"王の命令とその定めが届くと、州という州、町という町で、ユダヤ人は喜び祝い、宴会を開いて楽しくその日を過ごした。その地の民族にもユダヤ人になろうとする者が多く出た。ユダヤ人に対する恐れに襲われたからである。","tok":[["王","おう"],["の"],["命令","めいれい"],["と"],["その"],["定め","さだめ"],["が"],["届く","とどく"],["と"],["、"],["州","しゅう"],["と"],["いう"],["州","しゅう"],["、"],["町","まち"],["と"],["いう"],["町","まち"],["で"],["、"],["ユダヤ人","ゆだやじん"],["は"],["喜び祝い","よろこびいわい"],["、"],["宴会","えんかい"],["を"],["開いて","ひらいて"],["楽しく","たのしく"],["その"],["日","ひ"],["を"],["過ごした","すごした"],["。"],["その"],["地","ち"],["の"],["民族","みんぞく"],["に"],["も"],["ユダヤ人","ゆだやじん"],["に"],["なろう"],["と"],["する"],["者","もの"],["が"],["多く","おおく"],["出た","でた"],["。"],["ユダヤ人","ゆだやじん"],["に"],["対する","たいする"],["恐れ","おそれ"],["に"],["襲われた","おそわれた"],["から"],["で"],["ある"],["。"]]}]
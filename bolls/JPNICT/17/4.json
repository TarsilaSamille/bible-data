[{"verse":1,"text":"モルデカイは事の一部始終を知ると、衣服を裂き、粗布をまとって灰をかぶり、都の中に出て行き、苦悩に満ちた叫び声をあげた。","tok":[["モルデカイ"],["は"],["事","こと"],["の"],["一部","いちぶ"],["始終","しじゅう"],["を"],["知る","しる"],["と"],["、"],["衣服","いふく"],["を"],["裂き","さき"],["、"],["粗布","そふ"],["を"],["まとって"],["灰","はい"],["を"],["かぶり"],["、"],["都","と"],["の"],["中","なか"],["に"],["出て","でて"],["行き","いき"],["、"],["苦悩","くのう"],["に"],["満ちた","みちた"],["叫び声","さけびごえ"],["を"],["あげた"],["。"]]},{"verse":2,"text":"更に彼は王宮の門の前まで来たが、粗布をまとって門に入ることは禁じられていた。","tok":[["更に","さらに"],["彼","かれ"],["は"],["王宮","おうきゅう"],["の"],["門","もん"],["の"],["前","まえ"],["まで"],["来た","きた"],["が"],["、"],["粗布","そふ"],["を"],["まとって"],["門","もん"],["に"],["入る","はいる"],["こと"],["は"],["禁じられて","きんじられて"],["いた"],["。"]]},{"verse":3,"text":"勅書が届いた所では、どの州でもユダヤ人の間に大きな嘆きが起こった。多くの者が粗布をまとい、灰の中に座って断食し、涙を流し、悲嘆にくれた。","tok":[["勅書","ちょくしょ"],["が"],["届いた","とどいた"],["所","ところ"],["で"],["は"],["、"],["どの"],["州","しゅう"],["で"],["も"],["ユダヤ人","ゆだやじん"],["の"],["間","あいだ"],["に"],["大きな","おおきな"],["嘆き","なげき"],["が"],["起こった","おこった"],["。"],["多く","おおく"],["の"],["者","もの"],["が"],["粗布","あらぬの"],["を"],["まとい"],["、"],["灰","はい"],["の"],["中","なか"],["に"],["座って","すわって"],["断食","だんじき"],["し"],["、"],["涙","なみだ"],["を"],["流し","ながし"],["、"],["悲嘆","ひたん"],["に"],["くれた"],["。"]]},{"verse":4,"text":"女官と宦官が来て、このことを王妃エステルに告げたので、彼女は非常に驚き、粗布を脱がせようとしてモルデカイに衣服を届けた。しかし、モルデカイはそれを受け取ろうとしなかった。","tok":[["女官","じょかん"],["と"],["宦官","かんがん"],["が"],["来て","きて"],["、"],["この"],["こと"],["を"],["王妃","おうひ"],["エステル"],["に"],["告げた","つげた"],["ので"],["、"],["彼女","かのじょ"],["は"],["非常","ひじょう"],["に"],["驚き","おどろき"],["、"],["粗布","そふ"],["を"],["脱がせよう","ぬがせよう"],["として"],["モルデカイ"],["に"],["衣服","いふく"],["を"],["届けた","とどけた"],["。"],["しかし"],["、"],["モルデカイ"],["は"],["それ"],["を"],["受け取ろう","うけとろう"],["と"],["しなかった"],["。"]]},{"verse":5,"text":"そこでエステルはハタクを呼んでモルデカイのもとに遣わし、何事があったのか、なぜこのようなことをするのかを知ろうとした。ハタクは王に仕える宦官で、王妃のもとに遣わされて彼女に仕えていた。","tok":[["そこ"],["で"],["エステル"],["は"],["ハタク"],["を"],["呼んで","よんで"],["モルデカイ"],["の"],["もと"],["に"],["遣わし","つかわし"],["、"],["何事","なにごと"],["が"],["あった"],["の"],["か"],["、"],["なぜ"],["この"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["を"],["知ろう","しろう"],["と"],["した"],["。"],["ハタク"],["は"],["王","おう"],["に"],["仕える","つかえる"],["宦官","かんがん"],["で"],["、"],["王妃","おうひ"],["の"],["もと"],["に"],["遣わされて","つかわされて"],["彼女","かのじょ"],["に"],["仕えて","つかえて"],["いた"],["。"]]},{"verse":6,"text":"ハタクは王宮の門の前の広場にいるモルデカイのもとに行った。","tok":[["ハタク"],["は"],["王宮","おうきゅう"],["の"],["門","もん"],["の"],["前","まえ"],["の"],["広場","ひろば"],["に"],["いる"],["モルデカイ"],["の"],["もと"],["に"],["行った","いった"],["。"]]},{"verse":7,"text":"モルデカイは事の一部始終、すなわちユダヤ人を絶滅して銀貨を国庫に払い込む、とハマンが言ったことについて詳しく語った。","tok":[["モルデカイ"],["は"],["事","こと"],["の"],["一部","いちぶ"],["始終","しじゅう"],["、"],["すなわち"],["ユダヤ人","ゆだやじん"],["を"],["絶滅","ぜつめつ"],["して"],["銀貨","ぎんか"],["を"],["国庫","こっこ"],["に"],["払い込む","はらいこむ"],["、"],["と"],["ハマン"],["が"],["言った","いった"],["こと"],["について"],["詳しく","くわしく"],["語った","かたった"],["。"]]},{"verse":8,"text":"彼はスサで公示されたユダヤ人絶滅の触れ書きの写しを託し、これをエステルに見せて説明するように頼んだ。同時に、彼女自身が王のもとに行って、自分の民族のために寛大な処置を求め、嘆願するように伝言させた。","tok":[["彼","かれ"],["は"],["スサ"],["で"],["公示","こうじ"],["された"],["ユダヤ人","ゆだやじん"],["絶滅","ぜつめつ"],["の"],["触れ書き","ふれがき"],["の"],["写し","うつし"],["を"],["託し","たくし"],["、"],["これ"],["を"],["エステル"],["に"],["見せて","みせて"],["説明","せつめい"],["する"],["よう"],["に"],["頼んだ","たのんだ"],["。"],["同時","どうじ"],["に"],["、"],["彼女","かのじょ"],["自身","じしん"],["が"],["王","おう"],["の"],["もと"],["に"],["行って","いって"],["、"],["自分","じぶん"],["の"],["民族","みんぞく"],["の"],["ため"],["に"],["寛大","かんだい"],["な"],["処置","しょち"],["を"],["求め","もとめ"],["、"],["嘆願","たんがん"],["する"],["よう"],["に"],["伝言","でんごん"],["させた"],["。"]]},{"verse":9,"text":"ハタクは戻ってモルデカイの言葉をエステルに伝えた。","tok":[["ハタク"],["は"],["戻って","もどって"],["モルデカイ"],["の"],["言葉","ことば"],["を"],["エステル"],["に"],["伝えた","つたえた"],["。"]]},{"verse":10,"text":"エステルはまたモルデカイへの返事をハタクにゆだねた。","tok":[["エステル"],["は"],["また"],["モルデカイ"],["へ"],["の"],["返事","へんじ"],["を"],["ハタク"],["に"],["ゆだねた"],["。"]]},{"verse":11,"text":"「この国の役人と国民のだれもがよく知っているとおり、王宮の内庭におられる王に、召し出されずに近づく者は、男であれ女であれ死刑に処せられる、と法律の一条に定められております。ただ、王が金の笏を差し伸べられる場合にのみ、その者は死を免れます。三十日このかた私にはお召しがなく、王のもとには参っておりません。」","tok":[["「"],["この"],["国","くに"],["の"],["役人","やくにん"],["と"],["国民","こくみん"],["の"],["だれ"],["も"],["が"],["よく"],["知って","しって"],["いる"],["とおり"],["、"],["王宮","おうきゅう"],["の"],["内庭","うちにわ"],["に"],["おられる"],["王","おう"],["に"],["、"],["召し出されず","めしだされず"],["に"],["近づく","ちかづく"],["者","もの"],["は"],["、"],["男","おとこ"],["で"],["あれ"],["女","おんな"],["で"],["あれ"],["死刑","しけい"],["に"],["処せられる","しょせられる"],["、"],["と"],["法律","ほうりつ"],["の"],["一","いち"],["条","じょう"],["に"],["定められて","さだめられて"],["おります"],["。"],["ただ"],["、"],["王","おう"],["が"],["金","かね"],["の"],["笏","しゃく"],["を"],["差し伸べられる","さしのべられる"],["場合","ばあい"],["に"],["のみ"],["、"],["その"],["者","もの"],["は"],["死","し"],["を"],["免れます","まぬがれます"],["。"],["三十日","さんとうか"],["このかた"],["私","わたくし"],["に"],["は"],["お召し","おめし"],["が"],["なく"],["、"],["王","おう"],["の"],["もと"],["に"],["は"],["参って","まいって"],["おりません"],["。"],["」"]]},{"verse":12,"text":"エステルの返事がモルデカイに伝えられると、","tok":[["エステル"],["の"],["返事","へんじ"],["が"],["モルデカイ"],["に"],["伝えられる","つたえられる"],["と"],["、"]]},{"verse":13,"text":"モルデカイは再びエステルに言い送った。「他のユダヤ人はどうであれ、自分は王宮にいて無事だと考えてはいけない。","tok":[["モルデカイ"],["は"],["再び","ふたたび"],["エステル"],["に"],["言い送った","いいおくった"],["。"],["「"],["他","た"],["の"],["ユダヤ人","ゆだやじん"],["は"],["どう"],["で"],["あれ"],["、"],["自分","じぶん"],["は"],["王宮","おうきゅう"],["に"],["いて"],["無事","ぶじ"],["だ"],["と"],["考えて","かんがえて"],["は"],["いけない"],["。"]]},{"verse":14,"text":"この時にあたってあなたが口を閉ざしているなら、ユダヤ人の解放と救済は他のところから起こり、あなた自身と父の家は滅ぼされるにちがいない。この時のためにこそ、あなたは王妃の位にまで達したのではないか。」","tok":[["この"],["時","とき"],["に"],["あたって"],["あなた"],["が"],["口","くち"],["を"],["閉ざして","とざして"],["いるなら"],["、"],["ユダヤ人","ゆだやじん"],["の"],["解放","かいほう"],["と"],["救済","きゅうさい"],["は"],["他","た"],["の"],["ところ"],["から"],["起こり","おこり"],["、"],["あなた"],["自身","じしん"],["と"],["父","ちち"],["の"],["家","いえ"],["は"],["滅ぼされる","ほろぼされる"],["に"],["ちがい"],["ない"],["。"],["この"],["時","とき"],["の"],["ため"],["に"],["こそ"],["、"],["あなた"],["は"],["王妃","おうひ"],["の"],["位","くらい"],["に"],["まで"],["達した","たっした"],["ので"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":15,"text":"エステルはモルデカイに返事を送った。","tok":[["エステル"],["は"],["モルデカイ"],["に"],["返事","へんじ"],["を"],["送った","おくった"],["。"]]},{"verse":16,"text":"「早速、スサにいるすべてのユダヤ人を集め、私のために三日三晩断食し、飲食を一切断ってください。私も女官たちと共に、同じように断食いたします。このようにしてから、定めに反することではありますが、私は王のもとに参ります。このために死ななければならないのでしたら、死ぬ覚悟でおります。」","tok":[["「"],["早速","さっそく"],["、"],["スサ"],["に"],["いる"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["を"],["集め","あつめ"],["、"],["私","わたくし"],["の"],["ため"],["に"],["三日","みっか"],["三","さん"],["晩","ばん"],["断食","だんじき"],["し"],["、"],["飲食","いんしょく"],["を"],["一","いち"],["切断","せつだん"],["って"],["ください"],["。"],["私","わたくし"],["も"],["女官","じょかん"],["たち"],["と"],["共","とも"],["に"],["、"],["同じ","おなじ"],["よう"],["に"],["断食","だんじき"],["いたします"],["。"],["この"],["よう"],["に"],["して"],["から"],["、"],["定め","さだめ"],["に"],["反する","はんする"],["こと"],["で"],["は"],["あります"],["が"],["、"],["私","わたくし"],["は"],["王","おう"],["の"],["もと"],["に"],["参ります","まいります"],["。"],["この"],["ため"],["に"],["死ななければ","しななければ"],["ならない"],["の"],["でしたら"],["、"],["死ぬ","しぬ"],["覚悟","かくご"],["で"],["おります"],["。"],["」"]]},{"verse":17,"text":"そこでモルデカイは立ち去り、すべてエステルに頼まれたとおりにした。","tok":[["そこ"],["で"],["モルデカイ"],["は"],["立ち去り","たちさり"],["、"],["すべて"],["エステル"],["に"],["頼まれた","たのまれた"],["とおり"],["に"],["した"],["。"]]}]
[{"verse":1,"text":"ダレイオス王の第二年六月一日に、主の言葉が預言者ハガイを通して、ユダの総督シェアルティエルの子ゼルバベルと大祭司ヨツァダクの子ヨシュアに臨んだ。","tok":[["ダレイオス"],["王","おう"],["の"],["第","だい"],["二","に"],["年","ねん"],["六","ろく"],["月","がつ"],["一","いち"],["日","にち"],["に"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["預言者","よげんしゃ"],["ハガイ"],["を"],["通して","とおして"],["、"],["ユダ"],["の"],["総督","そうとく"],["シェアルティエル"],["の"],["子","こ"],["ゼルバベル"],["と"],["大","だい"],["祭司","さいし"],["ヨツァダク"],["の"],["子","こ"],["ヨシュア"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「万軍の主はこう言われる。この民は、『まだ、主の神殿を再建する時は来ていない』と言っている。」","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["この"],["民","みん"],["は"],["、"],["『"],["まだ"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["を"],["再建","さいけん"],["する"],["時","とき"],["は"],["来て","きて"],["いない"],["』"],["と"],["言って","いって"],["いる"],["。"],["」"]]},{"verse":3,"text":"主の言葉が、預言者ハガイを通して臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["、"],["預言者","よげんしゃ"],["ハガイ"],["を"],["通して","とおして"],["臨んだ","のぞんだ"],["。"]]},{"verse":4,"text":"「今、お前たちは、この神殿を廃虚のままにしておきながら自分たちは板ではった家に住んでいてよいのか。","tok":[["「"],["今","いま"],["、"],["お前","おまえ"],["たち"],["は"],["、"],["この"],["神殿","しんでん"],["を"],["廃虚","はいきょ"],["の"],["まま"],["に"],["して"],["おき"],["ながら"],["自分","じぶん"],["たち"],["は"],["板","いた"],["で"],["はった"],["家","いえ"],["に"],["住んで","すんで"],["いて"],["よい"],["の"],["か"],["。"]]},{"verse":5,"text":"今、万軍の主はこう言われる。お前たちは自分の歩む道に心を留めよ。","tok":[["今","いま"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["自分","じぶん"],["の"],["歩む","あゆむ"],["道","みち"],["に"],["心","こころ"],["を"],["留めよ","とめよ"],["。"]]},{"verse":6,"text":"種を多く蒔いても、取り入れは少ない。食べても、満足することなく飲んでも、酔うことがない。衣服を重ねても、温まることなく金をかせぐ者がかせいでも穴のあいた袋に入れるようなものだ。","tok":[["種","しゅ"],["を"],["多く","おおく"],["蒔いて","まいて"],["も"],["、"],["取り入れ","とりいれ"],["は"],["少ない","すくない"],["。"],["食べて","たべて"],["も"],["、"],["満足","まんぞく"],["する"],["こと"],["なく"],["飲んで","のんで"],["も"],["、"],["酔う","よう"],["こと"],["が"],["ない"],["。"],["衣服","いふく"],["を"],["重ねて","かさねて"],["も"],["、"],["温まる","あたたまる"],["こと"],["なく"],["金","かね"],["を"],["かせぐ"],["者","もの"],["が"],["かせいで"],["も"],["穴","あな"],["の"],["あいた"],["袋","ふくろ"],["に"],["入れる","いれる"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":7,"text":"万軍の主はこう言われる。お前たちは自分の歩む道に心を留めよ。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["自分","じぶん"],["の"],["歩む","あゆむ"],["道","みち"],["に"],["心","こころ"],["を"],["留めよ","とめよ"],["。"]]},{"verse":8,"text":"山に登り、木を切り出して、神殿を建てよ。わたしはそれを喜び、栄光を受けると主は言われる。","tok":[["山","やま"],["に"],["登り","のぼり"],["、"],["木","き"],["を"],["切り出して","きりだして"],["、"],["神殿","しんでん"],["を"],["建て","たて"],["よ"],["。"],["わたし"],["は"],["それ"],["を"],["喜び","よろこび"],["、"],["栄光","えいこう"],["を"],["受ける","うける"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"お前たちは多くの収穫を期待したがそれはわずかであった。しかも、お前たちが家へ持ち帰るときわたしは、それを吹き飛ばした。それはなぜか、と万軍の主は言われる。それは、わたしの神殿が廃虚のままであるのにお前たちが、それぞれ自分の家のために走り回っているからだ。","tok":[["お前","おまえ"],["たち"],["は"],["多く","おおく"],["の"],["収穫","しゅうかく"],["を"],["期待","きたい"],["した"],["が"],["それ"],["は"],["わずか"],["で"],["あった"],["。"],["しかも"],["、"],["お前","おまえ"],["たち"],["が"],["家","いえ"],["へ"],["持ち帰る","もちかえる"],["とき"],["わたし"],["は"],["、"],["それ"],["を"],["吹き飛ばした","ふきとばした"],["。"],["それ"],["は"],["なぜ"],["か"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["それ"],["は"],["、"],["わたし"],["の"],["神殿","しんでん"],["が"],["廃虚","はいきょ"],["の"],["まま"],["で"],["ある"],["のに"],["お前","おまえ"],["たち"],["が"],["、"],["それぞれ"],["自分","じぶん"],["の"],["家","いえ"],["の"],["ため"],["に"],["走り回って","はしりまわって"],["いる"],["から"],["だ"],["。"]]},{"verse":10,"text":"それゆえ、お前たちの上に天は露を降らさず地は産物を出さなかった。","tok":[["それ"],["ゆえ"],["、"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["天","てん"],["は"],["露","ろ"],["を"],["降らさず","ふらさず"],["地","ち"],["は"],["産物","さんぶつ"],["を"],["出さなかった","ださなかった"],["。"]]},{"verse":11,"text":"わたしが干ばつを呼び寄せたのでそれは、大地と山々と穀物の上に新しいぶどう酒とオリーブ油と土地が産み出す物の上にまた人間と家畜とすべて人の労苦の上に及んだのだ。」","tok":[["わたし"],["が"],["干ばつ","かんばつ"],["を"],["呼び寄せた","よびよせた"],["ので"],["それ"],["は"],["、"],["大地","だいち"],["と"],["山々","やまやま"],["と"],["穀物","こくもつ"],["の"],["上","うえ"],["に"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["オリーブ油","おりーぶゆ"],["と"],["土地","とち"],["が"],["産み出す","うみだす"],["物","もの"],["の"],["上","うえ"],["に"],["また"],["人間","にんげん"],["と"],["家畜","かちく"],["と"],["すべて"],["人","ひと"],["の"],["労苦","ろうく"],["の"],["上","うえ"],["に"],["及んだ","およんだ"],["の"],["だ"],["。"],["」"]]},{"verse":12,"text":"シャルティエルの子ゼルバベルと、大祭司ヨツァダクの子ヨシュア、および民の残りの者は皆、彼らの神、主が預言者ハガイを遣わされたとき、彼の言葉を通して、彼らの神、主の御声に耳を傾けた。民は主を畏れ敬った。","tok":[["シャルティエル"],["の"],["子","こ"],["ゼルバベル"],["と"],["、"],["大","だい"],["祭司","さいし"],["ヨツァダク"],["の"],["子","こ"],["ヨシュア"],["、"],["および"],["民","みん"],["の"],["残り","のこり"],["の"],["者","もの"],["は"],["皆","みな"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["預言者","よげんしゃ"],["ハガイ"],["を"],["遣わされた","つかわされた"],["とき"],["、"],["彼","かれ"],["の"],["言葉","ことば"],["を"],["通して","とおして"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["耳","みみ"],["を"],["傾けた","かたむけた"],["。"],["民","たみ"],["は"],["主","ぬし"],["を"],["畏れ","おそれ"],["敬った","うやまった"],["。"]]},{"verse":13,"text":"主の使者ハガイは、主の派遣に従い、民に告げて言った。「わたしはあなたたちと共にいる、と主は言われる。」","tok":[["主","ぬし"],["の"],["使者","ししゃ"],["ハガイ"],["は"],["、"],["主","ぬし"],["の"],["派遣","はけん"],["に"],["従い","したがい"],["、"],["民","みん"],["に"],["告げて","つげて"],["言った","いった"],["。"],["「"],["わたし"],["は"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["」"]]},{"verse":14,"text":"主が、ユダの総督シャルティエルの子ゼルバベルと大祭司ヨツァダクの子ヨシュア、および民の残りの者すべての霊を奮い立たせられたので、彼らは出て行き、彼らの神、万軍の主の神殿を建てる作業に取りかかった。","tok":[["主","ぬし"],["が"],["、"],["ユダ"],["の"],["総督","そうとく"],["シャルティエル"],["の"],["子","こ"],["ゼルバベル"],["と"],["大","だい"],["祭司","さいし"],["ヨツァダク"],["の"],["子","こ"],["ヨシュア"],["、"],["および"],["民","みん"],["の"],["残り","のこり"],["の"],["者","もの"],["すべて"],["の"],["霊","れい"],["を"],["奮い立たせられた","ふるいたたせられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["神殿","しんでん"],["を"],["建てる","たてる"],["作業","さぎょう"],["に"],["取りかかった","とりかかった"],["。"]]},{"verse":15,"text":"それは六月二十四日のことであった。新しい神殿の栄光と祝福ダレイオス王の第二年、","tok":[["それ"],["は"]
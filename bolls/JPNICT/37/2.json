[{"verse":1,"text":"七月二十一日に、主の言葉が、預言者ハガイを通して臨んだ。","tok":[["七","なな"],["月","がつ"],["二十一","にじゅういち"],["日","にち"],["に"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["、"],["預言者","よげんしゃ"],["ハガイ"],["を"],["通して","とおして"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「ユダの総督シャルティエルの子ゼルバベルと大祭司ヨツァダクの子ヨシュア、および民の残りの者に告げなさい。","tok":[["「"],["ユダ"],["の"],["総督","そうとく"],["シャルティエル"],["の"],["子","こ"],["ゼルバベル"],["と"],["大","だい"],["祭司","さいし"],["ヨツァダク"],["の"],["子","こ"],["ヨシュア"],["、"],["および"],["民","みん"],["の"],["残り","のこり"],["の"],["者","もの"],["に"],["告げ","つげ"],["なさい"],["。"]]},{"verse":3,"text":"お前たち、残った者のうち誰が、昔の栄光のときのこの神殿を見たか。今、お前たちが見ている様は何か。目に映るのは無に等しいものではないか。","tok":[["お前","おまえ"],["たち"],["、"],["残った","のこった"],["者","もの"],["の"],["うち"],["誰","だれ"],["が"],["、"],["昔","むかし"],["の"],["栄光","えいこう"],["の"],["とき"],["の"],["この"],["神殿","しんでん"],["を"],["見た","みた"],["か"],["。"],["今","いま"],["、"],["お前","おまえ"],["たち"],["が"],["見て","みて"],["いる"],["様","さま"],["は"],["何","なん"],["か"],["。"],["目","め"],["に"],["映る","うつる"],["の"],["は"],["無","む"],["に"],["等しい","ひとしい"],["もの"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":4,"text":"今こそ、ゼルバベルよ、勇気を出せと主は言われる。大祭司ヨツァダクの子ヨシュアよ、勇気を出せ。国の民は皆、勇気を出せ、と主は言われる。働け、わたしはお前たちと共にいると万軍の主は言われる。","tok":[["今","いま"],["こそ"],["、"],["ゼルバベル"],["よ"],["、"],["勇気","ゆうき"],["を"],["出せ","だせ"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["大","だい"],["祭司","さいし"],["ヨツァダク"],["の"],["子","こ"],["ヨシュア"],["よ"],["、"],["勇気","ゆうき"],["を"],["出せ","だせ"],["。"],["国","くに"],["の"],["民","たみ"],["は"],["皆","みな"],["、"],["勇気","ゆうき"],["を"],["出せ","だせ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["働け","はたらけ"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["と"],["共","とも"],["に"],["いる"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"ここに、お前たちがエジプトを出たときわたしがお前たちと結んだ契約がある。わたしの霊はお前たちの中にとどまっている。恐れてはならない。","tok":[["ここ"],["に"],["、"],["お前","おまえ"],["たち"],["が"],["エジプト"],["を"],["出た","でた"],["とき"],["わたし"],["が"],["お前","おまえ"],["たち"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["が"],["ある"],["。"],["わたし"],["の"],["霊","れい"],["は"],["お前","おまえ"],["たち"],["の"],["中","なか"],["に"],["とどまって"],["いる"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"]]},{"verse":6,"text":"まことに、万軍の主はこう言われる。わたしは、間もなくもう一度天と地を、海と陸地を揺り動かす。","tok":[["まこと"],["に"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["間","ま"],["も"],["なく"],["もう"],["一","いち"],["度","ど"],["天","てん"],["と"],["地","ち"],["を"],["、"],["海","うみ"],["と"],["陸地","りくち"],["を"],["揺り動かす","ゆりうごかす"],["。"]]},{"verse":7,"text":"諸国の民をことごとく揺り動かし諸国のすべての民の財宝をもたらしこの神殿を栄光で満たす、と万軍の主は言われる。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["を"],["ことごとく"],["揺り動かし","ゆりうごかし"],["諸国","しょこく"],["の"],["すべて"],["の"],["民","たみ"],["の"],["財宝","ざいほう"],["を"],["もたらし"],["この"],["神殿","しんでん"],["を"],["栄光","えいこう"],["で"],["満たす","みたす"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":8,"text":"銀はわたしのもの、金もわたしのものと万軍の主は言われる。","tok":[["銀","ぎん"],["は"],["わたし"],["の"],["もの"],["、"],["金","きん"],["も"],["わたし"],["の"],["もの"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"この新しい神殿の栄光は昔の神殿にまさると万軍の主は言われる。この場所にわたしは平和を与える」と万軍の主は言われる。","tok":[["この"],["新しい","あたらしい"],["神殿","しんでん"],["の"],["栄光","えいこう"],["は"],["昔","むかし"],["の"],["神殿","しんでん"],["に"],["まさる"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["この"],["場所","ばしょ"],["に"],["わたし"],["は"],["平和","へいわ"],["を"],["与える","あたえる"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"ダレイオスの第二年九月二十四日、預言者ハガイに主の言葉が臨んだ。","tok":[["ダレイオス"],["の"],["第","だい"],["二","に"],["年","ねん"],["九","きゅう"],["月","がつ"],["二十四日","にじゅうよんか"],["、"],["預言者","よげんしゃ"],["ハガイ"],["に"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["臨んだ","のぞんだ"],["。"]]},{"verse":11,"text":"「万軍の主はこう言われる。祭司たちに、律法について尋ねなさい。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["祭司","さいし"],["たち"],["に"],["、"],["律法","りっぽう"],["について"],["尋ね","たずね"],["なさい"],["。"]]},{"verse":12,"text":"『もし、だれかが、聖別された肉を衣の裾に入れて運んでいて、その裾がパン、煮物、ぶどう酒、油、そのほか何かの食物に触れたとする。これらのものは聖別されるだろうか』と。」祭司たちは答えて、「されない」と言った。","tok":[["『"],["もし"],["、"],["だれ"],["か"],["が"],["、"],["聖別","せいべつ"],["された"],["肉","にく"],["を"],["衣","ころも"],["の"],["裾","すそ"],["に"],["入れて","いれて"],["運んで","はこんで"],["いて"],["、"],["その"],["裾","すそ"],["が"],["パン"],["、"],["煮物","にもの"],["、"],["ぶどう酒","ぶどうしゅ"],["、"],["油","あぶら"],["、"],["その"],["ほか"],["何","なん"],["か"],["の"],["食物","しょくもつ"],["に"],["触れた","ふれた"],["と"],["する"],["。"],["これ"],["ら"],["の"],["もの"],["は"],["聖別","せいべつ"],["されるだろう"],["か"],["』"],["と"],["。"],["」"],["祭司","さいし"],["たち"],["は"],["答えて","こたえて"],["、"],["「"],["されない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"ハガイは言った。「もし、死体に触れて汚れた人が、これらのものの何かに触れたとする。これらのものは汚れるだろうか。」祭司たちは答えて、「汚れる」と言った。","tok":[["ハガイ"],["は"],["言った","いった"],["。"],["「"],["もし"],["、"],["死体","したい"],["に"],["触れて","ふれて"],["汚れた","よごれた"],["人","ひと"],["が"],["、"],["これ"],["ら"],["の"],["もの"],["の"],["何","なん"],["か"],["に"],["触れた","ふれた"],["と"],["する"],["。"],["これ"],["ら"],["の"],["もの"],["は"],["汚れるだろう","よごれるだろう"],["か"],["。"],["」"],["祭司","さいし"],["たち"],["は"],["答えて","こたえて"],["、"],["「"],["汚れる","よごれる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"ハガイは答えて言った。「わたしにとって、この民はまさにそのようだ。この国はまさにそのようだ、と主は言われる。彼らの手の業もすべてそのようだ。彼らがそこにおいてささげるものは汚れている。","tok":[["ハガイ"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["わたし"],["にとって"],["、"],["この"],["民","みん"],["は"],["まさに"],["その"],["よう"],["だ"],["。"],["この"],["国","くに"],["は"],["まさに"],["その"],["よう"],["だ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["彼","かれ"],["ら"],["の"],["手","て"],["の"],["業","ごう"],["も"],["すべて"],["その"],["よう"],["だ"],["。"],["彼","かれ"],["ら"],["が"],["そこ"],["に"],["おいて"],["ささげる"],["もの"],["は"],["汚れて","よごれて"],["いる"],["。"]]},{"verse":15,"text":"今日この日から以後、よく心に留めよ。主の神殿の石を積み重ねる前に","tok":[["今日","きょう"],["この"],["日","ひ"],["から"],["以後","いご"],["、"],["よく"],["心","こころ"],["に"],["留めよ","とめよ"],["。"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["石","いし"],["を"],["積み重ねる","つみかさねる"],["前","まえ"],["に"]]},{"verse":16,"text":"お前たちはどんな状態であったか。人が二十エファの小麦の山に来ても十エファしか得ず五十バトのぶどう酒をくもうと酒ぶねに来ても二十バトしか得なかった。","tok":[["お前","おまえ"],["たち"],["は"],["どんな"],["状態","じょうたい"],["で"],["あった"],["か"],["。"],["人","ひと"],["が"],["二十","にじゅう"],["エファ"],["の"],["小麦","こむぎ"],["の"],["山","やま"],["に"],["来て","きて"],["も"],["十","じゅう"],["エファ"],["しか"],["得ず","えず"],["五十","ごじゅう"],["バト"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["くもう"],["と"],["酒","さけ"],["ぶね"],["に"],["来て","きて"],["も"],["二十","にじゅう"],["バト"],["しか"],["得なかった","えなかった"],["。"]]},{"verse":17,"text":"わたしは、お前たちをその手の働きの実もろとも黒穂病と赤さび病と雹で撃ったがお前たちのうちだれひとりわたしに帰らなかった、と主は言われる。","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["を"],["その"],["手","て"],["の"],["働き","はたらき"],["の"],["実","じつ"],["もろとも"],["黒穂病","くろほびょう"],["と"],["赤さび病","あかさびびょう"],["と"],["雹","ひょう"],["で"],["撃った","うった"],["が"],["お前","おまえ"],["たち"],["の"],["うち"],["だれ"],["ひとり"],["わたし"],["に"],["帰らなかった","かえらなかった"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":18,"text":"この日以後、よく心に留めよ。この九月二十四日主の神殿の基が置かれたこの日から、心に留めよ。","tok":[["この"],["日","ひ"],["以後","いご"],["、"],["よく"],["心","こころ"],["に"],["留めよ","とめよ"],["。"],["この"],["九","きゅう"],["月","がつ"],["二十四","にじゅうよん"],["日","にち"],["主","しゅ"],["の"],["神殿","しんでん"],["の"],["基","もと"],["が"],["置かれた","おかれた"],["この"],["日","ひ"],["から"],["、"],["心","こころ"],["に"],["留めよ","とめよ"],["。"]]},{"verse":19,"text":"倉には、まだ種があるか。ぶどう、いちじく、ざくろ、オリーブはまだ実を結んでいない。しかし、今日この日から、わたしは祝福を与える。」","tok":[["倉","くら"],["に"],["は"],["、"],["まだ"],["種","しゅ"],["が"],["ある"],["か"],["。"],["ぶどう"],["、"],["いちじく"],["、"],["ざくろ"],["、"],["オリーブ"],["は"],["まだ"],["実","じつ"],["を"],["結んで","むすんで"],["いない"],["。"],["しかし"],["、"],["今日","きょう"],["この"],["日","ひ"],["から"],["、"],["わたし"],["は"],["祝福","しゅくふく"],["を"],["与える","あたえる"],["。"],["」"]]},{"verse":20,"text":"同じ月の二十四日主の言葉が再びハガイに臨んだ。","tok":[["同じ","おなじ"],["月","つき"],["の"],["二十四","にじゅうよん"],["日","にち"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["再び","ふたたび"],["ハガイ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":21,"text":"「ユダの総督ゼルバベルに告げよ。わたしは天と地を揺り動かす。","tok":[["「"],["ユダ"],["の"],["総督","そうとく"],["ゼルバベル"],["に"],["告げ","つげ"],["よ"],["。"],["わたし"],["は"],["天","てん"],["と"],["地","ち"],["を"],["揺り動かす","ゆりうごかす"],["。"]]},{"verse":22,"text":"わたしは国々の王座を倒し異邦の国々の力を砕く。馬を駆る者もろとも戦車を覆す。馬も、馬を駆る者も互いに味方の剣にかかって倒れる。","tok":[["わたし"],["は"],["国々","くにぐに"],["の"],["王座","おうざ"],["を"],["倒し","たおし"],["異邦","いほう"],["の"],["国々","くにぐに"],["の"],["力","ちから"],["を"],["砕く","くだく"],["。"],["馬","うま"],["を"],["駆る","かる"],["者","もの"],["もろとも"],["戦車","せんしゃ"],["を"],["覆す","くつがえす"],["。"],["馬","うま"],["も"],["、"],["馬","うま"],["を"],["駆る","かる"],["者","もの"],["も"],["互い","たがい"],["に"],["味方","みかた"],["の"],["剣","けん"],["に"],["かかって"],["倒れる","たおれる"],["。"]]},{"verse":23,"text":"その日には、と万軍の主は言われる。わが僕、シェアルティエルの子ゼルバベルよわたしはあなたを迎え入れる、と主は言われる。わたしはあなたをわたしの印章とする。わたしがあなたを選んだからだ」と万軍の主は言われる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わが"],["僕","ぼく"],["、"],["シェアルティエル"],["の"],["子","こ"],["ゼルバベル"],["よ"],["わたし"],["は"],["あなた"],["を"],["迎え入れる","むかえいれる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["あなた"],["を"],["わたし"],["の"],["印章","いんしょう"],["と"],["する"],["。"],["わたし"],["が"],["あなた"],["を"],["選んだ","えらんだ"],["から"],["だ"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
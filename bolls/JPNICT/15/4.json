[{"verse":1,"text":"ユダとベニヤミンの敵は、捕囚の子らがイスラエルの神、主のために聖所を建てていることを聞いて、","tok":[["ユダ"],["と"],["ベニヤミン"],["の"],["敵","てき"],["は"],["、"],["捕囚","ほしゅう"],["の"],["子","こ"],["ら"],["が"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["聖","せい"],["所","しょ"],["を"],["建てて","たてて"],["いる"],["こと"],["を"],["聞いて","きいて"],["、"]]},{"verse":2,"text":"ゼルバベルと家長たちのもとに来て言った。「建築を手伝わせてください。わたしたちも同じようにあなたがたの神を尋ね求める者です。アッシリアの王エサル‧ハドンによってここに連れて来られたときから、わたしたちはこの神にいけにえをささげています。」","tok":[["ゼルバベル"],["と"],["家長","かちょう"],["たち"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["建築","けんちく"],["を"],["手伝わせて","てつだわせて"],["ください"],["。"],["わたしたち"],["も"],["同じ","おなじ"],["よう"],["に"],["あなた"],["がた"],["の"],["神","かみ"],["を"],["尋ね求める","たずねもとめる"],["者","もの"],["です"],["。"],["アッシリア"],["の"],["王","おう"],["エサル"],["‧"],["ハドン"],["によって"],["ここ"],["に"],["連れて","つれて"],["来られた","こられた"],["とき"],["から"],["、"],["わたしたち"],["は"],["この"],["神","かみ"],["に"],["いけにえ"],["を"],["ささげて"],["います"],["。"],["」"]]},{"verse":3,"text":"しかし、ゼルバベルとイエシュア、他のイスラエルの家長たちは言った。「わたしたちの神のために神殿を建てるのは、あなたたちにではなく、わたしたちに託された仕事です。ペルシアの王キュロスがそう命じたのですから、わたしたちだけでイスラエルの神、主のために神殿を建てます。」","tok":[["しかし"],["、"],["ゼルバベル"],["と"],["イエシュア"],["、"],["他","た"],["の"],["イスラエル"],["の"],["家長","かちょう"],["たち"],["は"],["言った","いった"],["。"],["「"],["わたしたち"],["の"],["神","かみ"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["建てる","たてる"],["の"],["は"],["、"],["あなた"],["たち"],["に"],["で"],["は"],["なく"],["、"],["わたしたち"],["に"],["託された","たくされた"],["仕事","しごと"],["です"],["。"],["ペルシア"],["の"],["王","おう"],["キュロス"],["が"],["そう"],["命じた","めいじた"],["の"],["です"],["から"],["、"],["わたしたち"],["だけ"],["で"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["建てます","たてます"],["。"],["」"]]},{"verse":4,"text":"そこで、その地の住民は、建築に取りかかろうとするユダの民の士気を鈍らせ脅かす一方、","tok":[["そこ"],["で"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["は"],["、"],["建築","けんちく"],["に"],["取りかかろう","とりかかろう"],["と"],["する"],["ユダ"],["の"],["民","たみ"],["の"],["士気","しき"],["を"],["鈍らせ","にぶらせ"],["脅かす","おびやかす"],["一方","いっぽう"],["、"]]},{"verse":5,"text":"ペルシアの王キュロスの存命中からダレイオスの治世まで、参議官を買収して建築計画を挫折させようとした。","tok":[["ペルシア"],["の"],["王","おう"],["キュロス"],["の"],["存命中","ぞんめいちゅう"],["から"],["ダレイオス"],["の"],["治世","ちせい"],["まで"],["、"],["参議官","さんぎかん"],["を"],["買収","ばいしゅう"],["して"],["建築","けんちく"],["計画","けいかく"],["を"],["挫折","ざせつ"],["させよう"],["と"],["した"],["。"]]},{"verse":6,"text":"クセルクセスの治世にはその治世の初めに、ユダとエルサレムの住民に対する告訴状が書き送られた。","tok":[["クセルクセス"],["の"],["治世","ちせい"],["に"],["は"],["その"],["治世","ちせい"],["の"],["初め","はじめ"],["に"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["対する","たいする"],["告訴状","こくそじょう"],["が"],["書き送られた","かきおくられた"],["。"]]},{"verse":7,"text":"また、アルタクセルクセスの時代には、ビシュラム、ミトレダト、タベエル、およびその仲間がペルシア王アルタクセルクセスに書簡を送った。その文書はアラム文字で記され、アラム語に訳されていた。","tok":[["また"],["、"],["アルタ"],["クセルクセス"],["の"],["時代","じだい"],["に"],["は"],["、"],["ビシュラム"],["、"],["ミトレダト"],["、"],["タベエル"],["、"],["および"],["その"],["仲間","なかま"],["が"],["ペルシア"],["王","おう"],["アルタ"],["クセルクセス"],["に"],["書簡","しょかん"],["を"],["送った","おくった"],["。"],["その"],["文書","ぶんしょ"],["は"],["アラム"],["文字","もじ"],["で"],["記され","しるされ"],["、"],["アラム"],["語","ご"],["に"],["訳されて","やくされて"],["いた"],["。"]]},{"verse":8,"text":"行政官レフムと書記官シムシャイはアルタクセルクセス王にあて、エルサレムについてこのような書簡を書き送った。","tok":[["行政官","ぎょうせいかん"],["レフム"],["と"],["書記官","しょきかん"],["シムシャイ"],["は"],["アルタ"],["クセルクセス"],["王","おう"],["に"],["あて"],["、"],["エルサレム"],["について"],["この"],["よう"],["な"],["書簡","しょかん"],["を"],["書き送った","かきおくった"],["。"]]},{"verse":9,"text":"「行政官レフムと書記官シムシャイは、他の仲間たち、裁判官と巡察官、それにタルペル人、ペルシア人、ウルク人、バビロニア人、スサ人すなわちエラム人、","tok":[["「"],["行政官","ぎょうせいかん"],["レフム"],["と"],["書記官","しょきかん"],["シムシャイ"],["は"],["、"],["他","た"],["の"],["仲間","なかま"],["たち"],["、"],["裁判官","さいばんかん"],["と"],["巡察官","じゅんさつかん"],["、"],["それ"],["に"],["タルペル"],["人","にん"],["、"],["ペルシア"],["人","にん"],["、"],["ウルク人","うるくにん"],["、"],["バビロニア"],["人","にん"],["、"],["スサ人","すさにん"],["すなわち"],["エラム人","えらむにん"],["、"]]},{"verse":10,"text":"更に、貴く偉大なオスナパルがサマリアの町々とユーフラテス西方の他の地域に移住させたほかの諸国民と共に、……。」","tok":[["更に","さらに"],["、"],["貴く","とうとく"],["偉大","いだい"],["な"],["オスナパル"],["が"],["サマリア"],["の"],["町々","まちまち"],["と"],["ユーフラテス"],["西方","せいほう"],["の"],["他","ほか"],["の"],["地域","ちいき"],["に"],["移住","いじゅう"],["させた"],["ほか"],["の"],["諸国民","しょこくみん"],["と"],["共","とも"],["に"],["、"],["…"],["…"],["。"],["」"]]},{"verse":11,"text":"これが、彼らの書き送った書簡の写しである。「アルタクセルクセス王に、ユーフラテス西方の臣下一同より御報告します。","tok":[["これ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["書き送った","かきおくった"],["書簡","しょかん"],["の"],["写し","うつし"],["で"],["ある"],["。"],["「"],["アルタ"],["クセルクセス"],["王","おう"],["に"],["、"],["ユーフラテス"],["西方","せいほう"],["の"],["臣下","しんか"],["一同","いちどう"],["より"],["御報告","ごほうこく"],["します"],["。"]]},{"verse":12,"text":"王のもとからこちらに上って来たユダの者らがエルサレムに着き、反逆と悪意の都を再建していることをご存じでしょうか。彼らは既に城壁の工事を始め、基礎を修復しました。","tok":[["王","おう"],["の"],["もと"],["から"],["こちら"],["に"],["上って","のぼって"],["来た","きた"],["ユダ"],["の"],["者","もの"],["ら"],["が"],["エルサレム"],["に"],["着き","つき"],["、"],["反逆","はんぎゃく"],["と"],["悪意","あくい"],["の"],["都","と"],["を"],["再建","さいけん"],["して"],["いる"],["こと"],["を"],["ご存じ","ごぞんじ"],["でしょう"],["か"],["。"],["彼","かれ"],["ら"],["は"],["既に","すでに"],["城壁","じょうへき"],["の"],["工事","こうじ"],["を"],["始め","はじめ"],["、"],["基礎","きそ"],["を"],["修復","しゅうふく"],["しました"],["。"]]},{"verse":13,"text":"ご存じでしょうが、もしその都が再建され、城壁が完成しますと、彼らは年貢、関税、交通税を納めず、王に次々と損害を与えることになるに相違ありません。","tok":[["ご存じ","ごぞんじ"],["でしょう"],["が"],["、"],["もし"],["その"],["都","と"],["が"],["再建","さいけん"],["され"],["、"],["城壁","じょうへき"],["が"],["完成","かんせい"],["します"],["と"],["、"],["彼","かれ"],["ら"],["は"],["年貢","ねんぐ"],["、"],["関税","かんぜい"],["、"],["交通","こうつう"],["税","ぜい"],["を"],["納めず","おさめず"],["、"],["王","おう"],["に"],["次々","つぎつぎ"],["と"],["損害","そんがい"],["を"],["与える","あたえる"],["こと"],["に"],["なる"],["に"],["相違","そうい"],["ありません"],["。"]]},{"verse":14,"text":"王室から俸給をいただく臣下として、王に対する非礼は見過ごすわけにはいかないので、事情をお知らせいたします。","tok":[["王室","おうしつ"],["から"],["俸給","ほうきゅう"],["を"],["いただく"],["臣下","しんか"],["として"],["、"],["王","おう"],["に"],["対する","たいする"],["非礼","ひれい"],["は"],["見過ごす","みすごす"],["わけ"],["に"],["は"],["いかない"],["ので"],["、"],["事情","じじょう"],["を"],["お知らせ","おしらせ"],["いたします"],["。"]]},{"verse":15,"text":"あなたの先祖の残された記録をお調べになれば、そこに出ているはずで、お分かりになることですが、この都は反逆の都で、歴代の王と諸州に損害を与えてきました。昔から反乱を繰り返し、そのためにこの都は破壊されたのです。","tok":[["あなた"],["の"],["先祖","せんぞ"],["の"],["残された","のこされた"],["記録","きろく"],["を"],["お調べ","おしらべ"],["に"],["なれば"],["、"],["そこ"],["に"],["出て","でて"],["いる"],["はず"],["で"],["、"],["お分かり","おわかり"],["に"],["なる"],["こと"],["です"],["が"],["、"],["この"],["都","と"],["は"],["反逆","はんぎゃく"],["の"],["都","と"],["で"],["、"],["歴代","れきだい"],["の"],["王","おう"],["と"],["諸州","しょしゅう"],["に"],["損害","そんがい"],["を"],["与えて","あたえて"],["きました"],["。"],["昔","むかし"],["から"],["反乱","はんらん"],["を"],["繰り返し","くりかえし"],["、"],["その"],["ため"],["に"],["この"],["都","と"],["は"],["破壊","はかい"],["された"],["の"],["です"],["。"]]},{"verse":16,"text":"この都が再建され、城壁が完成すれば、ユーフラテスの西方には、王の領土がなくなるということを、あらかじめお知らせします。」","tok":[["この"],["都","と"],["が"],["再建","さいけん"],["され"],["、"],["城壁","じょうへき"],["が"],["完成","かんせい"],["すれば"],["、"],["ユーフラテス"],["の"],["西方","せいほう"],["に"],["は"],["、"],["王","おう"],["の"],["領土","りょうど"],["が"],["なくなる"],["と"],["いう"],["こと"],["を"],["、"],["あらかじめ"],["お知らせ","おしらせ"],["します"],["。"],["」"]]},{"verse":17,"text":"王は、次のような返事を送った。「行政官レフム、書記官シムシャイをはじめ、サマリアおよび他のユーフラテス西方の地方にいるその友人たちに、平和を祈る。","tok":[["王","おう"],["は"],["、"],["次","つぎ"],["の"],["よう"],["な"],["返事","へんじ"],["を"],["送った","おくった"],["。"],["「"],["行政官","ぎょうせいかん"],["レフム"],["、"],["書記官","しょきかん"],["シムシャイ"],["を"],["はじめ"],["、"],["サマリア"],["および"],["他","ほか"],["の"],["ユーフラテス"],["西方","せいほう"],["の"],["地方","ちほう"],["に"],["いる"],["その"],["友人","ゆうじん"],["たち"],["に"],["、"],["平和","へいわ"],["を"],["祈る","いのる"],["。"]]},{"verse":18,"text":"さて、あなたたちの送ってくれた公文書は、わたしの前で翻訳され、読み上げられた。","tok":[["さて"],["、"],["あなた"],["たち"],["の"],["送って","おくって"],["くれた"],["公文書","こうぶんしょ"],["は"],["、"],["わたし"],["の"],["前","まえ"],["で"],["翻訳","ほんやく"],["され"],["、"],["読み上げられた","よみあげられた"],["。"]]},{"verse":19,"text":"命じて調べさせたところ、その都は昔から歴代の王に対して反抗し、反逆と反乱を起こしたということが確認された。","tok":[["命じて","めいじて"],["調べさせた","しらべさせた"],["ところ"],["、"],["その"],["都","と"],["は"],["昔","むかし"],["から"],["歴代","れきだい"],["の"],["王","おう"],["に対して","にたいして"],["反抗","はんこう"],["し"],["、"],["反逆","はんぎゃく"],["と"],["反乱","はんらん"],["を"],["起こした","おこした"],["と"],["いう"],["こと"],["が"],["確認","かくにん"],["された"],["。"]]},{"verse":20,"text":"また強い王がエルサレムにいて、ユーフラテス西方全土を統治し、年貢、関税、交通税を徴収したことがあった。","tok":[["また"],["強い","つよい"],["王","おう"],["が"],["エルサレム"],["に"],["いて"],["、"],["ユーフラテス"],["西方","せいほう"],["全土","ぜんど"],["を"],["統治","とうち"],["し"],["、"],["年貢","ねんぐ"],["、"],["関税","かんぜい"],["、"],["交通","こうつう"],["税","ぜい"],["を"],["徴収","ちょうしゅう"],["した"],["こと"],["が"],["あった"],["。"]]},{"verse":21,"text":"従って今、その人々に工事を中止するように命令せよ。改めてわたしが命令を出すまで、その都は再建されてはならない。","tok":[["従って","したがって"],["今","いま"],["、"],["その"],["人々","ひとびと"],["に"],["工事","こうじ"],["を"],["中止","ちゅうし"],["する"],["よう"],["に"],["命令","めいれい"],["せよ"],["。"],["改めて","あらためて"],["わたし"],["が"],["命令","めいれい"],["を"],["出す","だす"],["まで"],["、"],["その"],["都","と"],["は"],["再建","さいけん"],["されて"],["は"],["ならない"],["。"]]},{"verse":22,"text":"この事をなおざりにしないように留意し、損失が大きくなって、王になおいっそうの迷惑が及ばぬようにせよ。」","tok":[["この"],["事","こと"],["を"],["なおざり"],["に"],["しない"],["よう"],["に"],["留意","りゅうい"],["し"],["、"],["損失","そんしつ"],["が"],["大きく","おおきく"],["なって"],["、"],["王","おう"],["に"],["なお"],["いっそう"],["の"],["迷惑","めいわく"],["が"],["及ばぬ","およばぬ"],["よう"],["に"],["せよ"],["。"],["」"]]},{"verse":23,"text":"このアルタクセルクセス王の公文書の写しは、レフム、書記官シムシャイおよびその仲間の前で朗読された。彼らはエルサレムにいるユダの人々のもとに急いで行き、強引に武力で工事を中止させた。","tok":[["この"],["アルタ"],["クセルクセス"],["王","おう"],["の"],["公文書","こうぶんしょ"],["の"],["写し","うつし"],["は"],["、"],["レフム"],["、"],["書記官","しょきかん"],["シムシャイ"],["および"],["その"],["仲間","なかま"],["の"],["前","まえ"],["で"],["朗読","ろうどく"],["された"],["。"],["彼","かれ"],["ら"],["は"],["エルサレム"],["に"],["いる"],["ユダ"],["の"],["人々","ひとびと"],["の"],["もと"],["に"],["急いで","いそいで"],["行き","いき"],["、"],["強引","ごういん"],["に"],["武力","ぶりょく"],["で"],["工事","こうじ"],["を"],["中止","ちゅうし"],["させた"],["。"]]},{"verse":24,"text":"そのときから、エルサレムの神殿の工事は中断されたまま、ペルシアの王ダレイオスの治世第二年にまで及んだ。","tok":[["その"],["とき"],["から"],["、"],["エルサレム"],["の"],["神殿","しんでん"],["の"],["工事","こうじ"],["は"],["中断","ちゅうだん"],["された"],["まま"],["、"],["ペルシア"],["の"],["王","おう"],["ダレイオス"],["の"],["治世","ちせい"],["第","だい"],["二","に"],["年","ねん"],["に"],["まで"],["及んだ","およんだ"],["。"]]}]
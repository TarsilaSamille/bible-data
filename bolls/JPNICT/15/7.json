[{"verse":1,"text":"これらの事があって後、ペルシアの王アルタクセルクセスの治世に、〔6aエズラがバビロンから上って来た。〕エズラの祖先は、父がセラヤ、祖父がアザルヤ、更にヒルキヤ、","tok":[["これ"],["ら"],["の"],["事","こと"],["が"],["あって"],["後","あと"],["、"],["ペルシア"],["の"],["王","おう"],["アルタ"],["クセルクセス"],["の"],["治世","ちせい"],["に"],["、"],["〔"],["6"],["a"],["エズラ"],["が"],["バビロン"],["から"],["上って","のぼって"],["来た","きた"],["。"],["〕"],["エズラ"],["の"],["祖先","そせん"],["は"],["、"],["父","ちち"],["が"],["セラヤ"],["、"],["祖父","そふ"],["が"],["アザルヤ"],["、"],["更に","さらに"],["ヒルキヤ"],["、"]]},{"verse":2,"text":"シャルム、ツァドク、アヒトブ、","tok":[["シャルム"],["、"],["ツァドク"],["、"],["アヒトブ"],["、"]]},{"verse":3,"text":"アマルヤ、アザルヤ、メラヨト、","tok":[["アマルヤ"],["、"],["アザルヤ"],["、"],["メラヨト"],["、"]]},{"verse":4,"text":"ゼラフヤ、ウジ、ブキ、","tok":[["ゼラフヤ"],["、"],["ウジ"],["、"],["ブキ"],["、"]]},{"verse":5,"text":"アビシュア、ピネハス、エルアザル、そして祭司長アロンとさかのぼる。","tok":[["アビシュア"],["、"],["ピネハス"],["、"],["エルアザル"],["、"],["そして"],["祭司長","さいしちょう"],["アロン"],["と"],["さかのぼる"],["。"]]},{"verse":6,"text":"エズラは、イスラエルの神なる主が授けられたモーセの律法に詳しい書記官であり、その神なる主の御手の加護を受けて、求めるものをすべて王から与えられていた。","tok":[["エズラ"],["は"],["、"],["イスラエル"],["の"],["神","かみ"],["なる"],["主","ぬし"],["が"],["授けられた","さずけられた"],["モーセ"],["の"],["律法","りっぽう"],["に"],["詳しい","くわしい"],["書記官","しょきかん"],["で"],["あり"],["、"],["その"],["神","かみ"],["なる"],["主","ぬし"],["の"],["御手","おて"],["の"],["加護","かご"],["を"],["受けて","うけて"],["、"],["求める","もとめる"],["もの"],["を"],["すべて"],["王","おう"],["から"],["与えられて","あたえられて"],["いた"],["。"]]},{"verse":7,"text":"アルタクセルクセス王の第七年に、イスラエルの人々、祭司、レビ人、詠唱者、門衛、神殿の使用人から成る一団がエルサレムに上り、","tok":[["アルタ"],["クセルクセス"],["王","おう"],["の"],["第","だい"],["七","なな"],["年","ねん"],["に"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["、"],["詠唱者","えいしょうしゃ"],["、"],["門衛","もんえい"],["、"],["神殿","しんでん"],["の"],["使用人","しようにん"],["から"],["成る","なる"],["一団","いちだん"],["が"],["エルサレム"],["に"],["上り","のぼり"],["、"]]},{"verse":8,"text":"同王の第七年の第五の月にエルサレムに到着した。","tok":[["同王","どうおう"],["の"],["第","だい"],["七","なな"],["年","ねん"],["の"],["第","だい"],["五","ご"],["の"],["月","つき"],["に"],["エルサレム"],["に"],["到着","とうちゃく"],["した"],["。"]]},{"verse":9,"text":"彼らは第一の月の一日をバビロン出発の日とし、神の慈しみ深い御手の加護を受けて、第五の月の一日にエルサレムに到着した。","tok":[["彼","かれ"],["ら"],["は"],["第","だい"],["一","いち"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["を"],["バビロン"],["出発","しゅっぱつ"],["の"],["日","ひ"],["と"],["し"],["、"],["神","かみ"],["の"],["慈しみ深い","いつくしみぶかい"],["御手","おて"],["の"],["加護","かご"],["を"],["受けて","うけて"],["、"],["第","だい"],["五","ご"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["エルサレム"],["に"],["到着","とうちゃく"],["した"],["。"]]},{"verse":10,"text":"エズラは主の律法を研究して実行し、イスラエルに掟と法を教えることに専念した。","tok":[["エズラ"],["は"],["主","ぬし"],["の"],["律法","りっぽう"],["を"],["研究","けんきゅう"],["して"],["実行","じっこう"],["し"],["、"],["イスラエル"],["に"],["掟","おきて"],["と"],["法","ほう"],["を"],["教える","おしえる"],["こと"],["に"],["専念","せんねん"],["した"],["。"]]},{"verse":11,"text":"イスラエルに対する主の戒めと掟の言葉に精通した、祭司であり書記官であるエズラに、アルタクセルクセス王は親書を送った。以下はその写しである。","tok":[["イスラエル"],["に"],["対する","たいする"],["主","ぬし"],["の"],["戒め","いましめ"],["と"],["掟","おきて"],["の"],["言葉","ことば"],["に"],["精通","せいつう"],["した"],["、"],["祭司","さいし"],["で"],["あり"],["書記官","しょきかん"],["で"],["ある"],["エズラ"],["に"],["、"],["アルタ"],["クセルクセス"],["王","おう"],["は"],["親書","しんしょ"],["を"],["送った","おくった"],["。"],["以下","いか"],["は"],["その"],["写し","うつし"],["で"],["ある"],["。"]]},{"verse":12,"text":"「諸王の王であるアルタクセルクセスは、天にいます神の律法の書記官、祭司エズラに心からの挨拶を送る。","tok":[["「"],["諸王","しょおう"],["の"],["王","おう"],["で"],["ある"],["アルタ"],["クセルクセス"],["は"],["、"],["天","てん"],["に"],["います"],["神","かみ"],["の"],["律法","りっぽう"],["の"],["書記官","しょきかん"],["、"],["祭司","さいし"],["エズラ"],["に"],["心","こころ"],["から"],["の"],["挨拶","あいさつ"],["を"],["送る","おくる"],["。"]]},{"verse":13,"text":"さて、ここにわたしの命令を明記する。わが国にいるイスラエルの人々、祭司、レビ人でエルサレムに行くことを望む者はだれでも、あなたと共に行ってよい。","tok":[["さて"],["、"],["ここ"],["に"],["わたし"],["の"],["命令","めいれい"],["を"],["明記","めいき"],["する"],["。"],["わが"],["国","くに"],["に"],["いる"],["イスラエル"],["の"],["人々","ひとびと"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["で"],["エルサレム"],["に"],["行く","いく"],["こと"],["を"],["望む","のぞむ"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["あなた"],["と"],["共","とも"],["に"],["行って","いって"],["よい"],["。"]]},{"verse":14,"text":"わたしは七人の顧問官と共にあなたに次の使命を託す。すなわちあなたにゆだねられた神の律法に従って、ユダとエルサレムの事情を調べること、","tok":[["わたし"],["は"],["七人","ななにん"],["の"],["顧問官","こもんかん"],["と"],["共","とも"],["に"],["あなた"],["に"],["次","つぎ"],["の"],["使命","しめい"],["を"],["託す","たくす"],["。"],["すなわち"],["あなた"],["に"],["ゆだねられた"],["神","かみ"],["の"],["律法","りっぽう"],["に"],["従って","したがって"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["事情","じじょう"],["を"],["調べる","しらべる"],["こと"],["、"]]},{"verse":15,"text":"エルサレムに住まいを定められたイスラエルの神に、わたしと顧問官が寄進する金銀を持って行くこと、","tok":[["エルサレム"],["に"],["住まい","すまい"],["を"],["定められた","さだめられた"],["イスラエル"],["の"],["神","かみ"],["に"],["、"],["わたし"],["と"],["顧問官","こもんかん"],["が"],["寄進","きしん"],["する"],["金銀","きんぎん"],["を"],["持って","もって"],["行く","いく"],["こと"],["、"]]},{"verse":16,"text":"またバビロニアの州の至るところであなたが得るすべての金銀を、民と祭司がエルサレムにある彼らの神殿に寄進する献げ物と共に持って行くことである。","tok":[["また"],["バビロニア"],["の"],["州","しゅう"],["の"],["至る","いたる"],["ところ"],["で"],["あなた"],["が"],["得る","える"],["すべて"],["の"],["金銀","きんぎん"],["を"],["、"],["民","みん"],["と"],["祭司","さいし"],["が"],["エルサレム"],["に"],["ある"],["彼","かれ"],["ら"],["の"],["神殿","しんでん"],["に"],["寄進","きしん"],["する"],["献げ物","ささげもの"],["と"],["共","とも"],["に"],["持って","もって"],["行く","いく"],["こと"],["で"],["ある"],["。"]]},{"verse":17,"text":"それゆえ、あなたはその銀を持って雄牛、雄羊、小羊、および穀物とぶどう酒の献げ物を丹念に買い集め、エルサレムにあるあなたたちの神の神殿の祭壇にささげよ。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["その"],["銀","ぎん"],["を"],["持って","もって"],["雄牛","おうし"],["、"],["雄羊","おひつじ"],["、"],["小羊","こひつじ"],["、"],["および"],["穀物","こくもつ"],["と"],["ぶどう酒","ぶどうしゅ"],["の"],["献げ物","ささげもの"],["を"],["丹念","たんねん"],["に"],["買い集め","かいあつめ"],["、"],["エルサレム"],["に"],["ある"],["あなた"],["たち"],["の"],["神","かみ"],["の"],["神殿","しんでん"],["の"],["祭壇","さいだん"],["に"],["ささげ"],["よ"],["。"]]},{"verse":18,"text":"そのほかあなたとあなたの仲間が適切と思うことがあれば、残りの金銀を神の御旨に従って用いてよい。","tok":[["その"],["ほか"],["あなた"],["と"],["あなた"],["の"],["仲間","なかま"],["が"],["適切","てきせつ"],["と"],["思う","おもう"],["こと"],["が"],["あれば"],["、"],["残り","のこり"],["の"],["金銀","きんぎん"],["を"],["神","かみ"],["の"],["御旨","おむね"],["に"],["従って","したがって"],["用いて","もちいて"],["よい"],["。"]]},{"verse":19,"text":"あなたの神の神殿の儀式のためにあなたに託す祭具類も、エルサレムの神の御前に納めよ。","tok":[["あなた"],["の"],["神","かみ"],["の"],["神殿","しんでん"],["の"],["儀式","ぎしき"],["の"],["ため"],["に"],
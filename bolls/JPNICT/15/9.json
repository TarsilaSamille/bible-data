[{"verse":1,"text":"このような事があって後、長たちがわたしのもとに来て、言った。「イスラエルの民も、祭司も、レビ人も、この地の住民から離れようとはしません。カナン人、ヘト人、ペリジ人、エブス人、アンモン人、モアブ人、エジプト人、アモリ人と同様に行うその住民の忌まわしい行いに従って、","tok":[["この"],["よう"],["な"],["事","こと"],["が"],["あって"],["後","あと"],["、"],["長","なが"],["たち"],["が"],["わたし"],["の"],["もと"],["に"],["来て","きて"],["、"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["民","たみ"],["も"],["、"],["祭司","さいし"],["も"],["、"],["レビ人","れびにん"],["も"],["、"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["から"],["離れよう","はなれよう"],["と"],["は"],["しません"],["。"],["カナン人","かなんにん"],["、"],["ヘト人","へとにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["エブス人","えぶすにん"],["、"],["アンモン"],["人","にん"],["、"],["モアブ人","もあぶにん"],["、"],["エジプト"],["人","にん"],["、"],["アモリ人","あもりにん"],["と"],["同様","どうよう"],["に"],["行う","おこなう"],["その"],["住民","じゅうみん"],["の"],["忌まわしい","いまわしい"],["行い","おこない"],["に"],["従って","したがって"],["、"]]},{"verse":2,"text":"彼らは、自分のためにも息子たちのためにもこの地の住民の娘を嫁にし、聖なる種族はこの地の住民と混じり合うようになりました。しかも、長たる者、官職にある者がこの悪事にまず手を染めたのです。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["の"],["ため"],["に"],["も"],["息子","むすこ"],["たち"],["の"],["ため"],["に"],["も"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["の"],["娘","むすめ"],["を"],["嫁","よめ"],["に"],["し"],["、"],["聖","せい"],["なる"],["種族","しゅぞく"],["は"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["と"],["混じり合う","まじりあう"],["よう"],["に"],["なりました"],["。"],["しかも"],["、"],["長たる","ながたる"],["者","もの"],["、"],["官職","かんしょく"],["に"],["ある"],["者","もの"],["が"],["この"],["悪事","あくじ"],["に"],["まず"],["手","て"],["を"],["染めた","そめた"],["の"],["です"],["。"],["」"]]},{"verse":3,"text":"わたしはこのことを聞いて、衣とマントを裂き、髪の毛とひげをむしり、ぼう然として座り込んだ。","tok":[["わたし"],["は"],["この"],["こと"],["を"],["聞いて","きいて"],["、"],["衣","ころも"],["と"],["マント"],["を"],["裂き","さき"],["、"],["髪の毛","かみのけ"],["と"],["ひげ"],["を"],["むしり"],["、"],["ぼう然","ぼうぜん"],["として"],["座り込んだ","すわりこんだ"],["。"]]},{"verse":4,"text":"また、この捕囚の民の悪事に対するイスラエルの神の裁きの言葉を恐れる者は皆、わたしのもとに集まって来たが、夕べの献げ物のときまで、わたしはぼう然として座り続けた。","tok":[["また"],["、"],["この"],["捕囚","ほしゅう"],["の"],["民","たみ"],["の"],["悪事","あくじ"],["に"],["対する","たいする"],["イスラエル"],["の"],["神","かみ"],["の"],["裁き","さばき"],["の"],["言葉","ことば"],["を"],["恐れる","おそれる"],["者","もの"],["は"],["皆","みな"],["、"],["わたし"],["の"],["もと"],["に"],["集まって","あつまって"],["来た","きた"],["が"],["、"],["夕べ","ゆうべ"],["の"],["献げ物","ささげもの"],["の"],["とき"],["まで"],["、"],["わたし"],["は"],["ぼう然","ぼうぜん"],["として"],["座り","すわり"],["続けた","つづけた"],["。"]]},{"verse":5,"text":"夕べの献げ物のときになって、かがめていた身を起こし、裂けた衣とマントをつけたままひざまずき、わが神、主に向かって手を広げ、","tok":[["夕べ","ゆうべ"],["の"],["献げ物","ささげもの"],["の"],["とき"],["に"],["なって"],["、"],["かがめて"],["いた"],["身","み"],["を"],["起こし","おこし"],["、"],["裂けた","さけた"],["衣","ころも"],["と"],["マント"],["を"],["つけた"],["まま"],["ひざまずき"],["、"],["わが"],["神","かみ"],["、"],["主に","おもに"],["向かって","むかって"],["手","て"],["を"],["広げ","ひろげ"],["、"]]},{"verse":6,"text":"祈り始めた。エズラの祈り「わが神よ、御前に恥じ入るあまり、わたしは顔を上げることができません。わたしたちの罪悪は積み重なって身の丈を越え、罪科は大きく天にまで達しています。","tok":[["祈り","いのり"],["始めた","はじめた"],["。"],["エズラ"],["の"],["祈り","いのり"],["「"],["わが"],["神","かみ"],["よ"],["、"],["御前","ごぜん"],["に"],["恥じ入る","はじいる"],["あまり"],["、"],["わたし"],["は"],["顔","かお"],["を"],["上げる","あげる"],["こと"],["が"],["できません"],["。"],["わたしたち"],["の"],["罪悪","ざいあく"],["は"],["積み重なって","つみかさなって"],["身の丈","みのたけ"],["を"],["越え","こえ"],["、"],["罪科","ざいか"],["は"],["大きく","おおきく"],["天","てん"],["に"],["まで"],["達して","たっして"],["います"],["。"]]},{"verse":7,"text":"先祖の時代から今日まで、わたしたちは大きな罪科の中にあります。その罪悪のために、わたしたちは王も祭司もこの地の王の支配下に置かれ、剣にかけられ、捕らわれ人となり、略奪され、辱められてきました。今日、御覧のとおりです。","tok":[["先祖","せんぞ"],["の"],["時代","じだい"],["から"],["今日","きょう"],["まで"],["、"],["わたしたち"],["は"],["大きな","おおきな"],["罪科","ざいか"],["の"],["中","なか"],["に"],["あります"],["。"],["その"],["罪悪","ざいあく"],["の"],["ため"],["に"],["、"],["わたしたち"],["は"],["王","おう"],["も"],["祭司","さいし"],["も"],["この"],["地","ち"],["の"],["王","おう"],["の"],["支配下","しはいか"],["に"],["置かれ","おかれ"],["、"],["剣","けん"],["に"],["かけられ"],["、"],["捕らわれ","とらわれ"],["人となり","ひととなり"],["、"],["略奪","りゃくだつ"],["され"],["、"],["辱められて","はずかしめられて"],["きました"],["。"],["今日","きょう"],["、"],["御覧","ごらん"],["の"],["とおり"],["です"],["。"]]},{"verse":8,"text":"ところが今、ほんの少し前から、わたしたちの神、主の憐れみにより、わたしたちの幾人かが捕囚を免れて生き残り、あなたの聖なる所によりどころを得るようにされました。こうして、わたしたちの神はわたしたちの目に光を与え、奴隷の身にありながらも、わずかに生きる力を授けてくださいました。","tok":[["ところ"],["が"],["今","いま"],["、"],["ほんの"],["少し","すこし"],["前","まえ"],["から"],["、"],["わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["憐れみ","あわれみ"],["に"],["より"],["、"],["わたしたち"],["の"],["幾人","いくにん"],["か"],["が"],["捕囚","ほしゅう"],["を"],["免れて","まぬがれて"],["生き残り","いきのこり"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["所","ところ"],["に"],["よりどころ"],["を"],["得る","える"],["よう"],["に"],["されました"],["。"],["こう"],["して"],["、"],["わたしたち"],["の"],["神","かみ"],["は"],["わたしたち"],["の"],["目","め"],["に"],["光","ひかり"],["を"],["与え","あたえ"],["、"],["奴隷","どれい"],["の"],["身","み"],["に"],["あり"],["ながら"],["も"],["、"],["わずか"],["に"],["生きる","いきる"],["力","ちから"],["を"],["授けて","さずけて"],["くださいました"],["。"]]},{"verse":9,"text":"まことに、わたしたちは奴隷にされています。しかし、わたしたちの神はわたしたちを奴隷のまま捨て去ることなく、ペルシアの諸王がわたしたちに対して好意を抱くようにし、生きる力を与えてくださいました。こうして、ユダとエルサレムでわたしたちの神の神殿を再建し、廃虚を復興し、城壁を得るようにしてくださいました。","tok":[["まこと"],["に"],["、"],["わたしたち"],["は"],["奴隷","どれい"],["に"],["されて"],["います"],["。"],["しかし"],["、"],["わたしたち"],["の"],["神","かみ"],["は"],["わたしたち"],["を"],["奴隷","どれい"],["の"],["まま"],["捨て去る","すてさる"],["こと"],["なく"],["、"],["ペルシア"],["の"],["諸王","しょおう"],["が"],["わたしたち"],["に対して","にたいして"],["好意","こうい"],["を"],["抱く","いだく"],["よう"],["に"],["し"],["、"],["生きる","いきる"],["力","ちから"],["を"],["与えて","あたえて"],["くださいました"],["。"],["こう"],["して"],["、"],["ユダ"],["と"],["エルサレム"],["で"],["わたしたち"],["の"],["神","かみ"],["の"],["神殿","しんでん"],["を"],["再建","さいけん"],["し"],["、"],["廃虚","はいきょ"],["を"],["復興","ふっこう"],["し"],["、"],["城壁","じょうへき"],["を"],["得る","える"],["よう"],["に"],["して"],["くださいました"],["。"]]},{"verse":10,"text":"わたしたちの神よ、こうした御恩をいただきながら、今何を申し上げればよいのでしょうか。わたしたちは御命令に背いてしまったのです。","tok":[["わたしたち"],["の"],["神","かみ"],["よ"],["、"],["こう"],["した"],["御恩","ごおん"],["を"],["いただき"],["ながら"],["、"],["今","いま"],["何","なん"],["を"],["申し上げれば","もうしあげれば"],["よい"],["の"],["でしょう"],["か"],["。"],["わたしたち"],["は"],["御命令","ごめいれい"],["に"],["背いて","そむいて"],["しまった"],["の"],["です"],["。"]]},{"verse":11,"text":"御命令は、あなたの僕、預言者たちによってこう伝えられました。『これから入って所有する地は、その地の住民の汚れによって汚された地である。そこは、その端から端まで彼らの忌まわしい行いによって汚れに満たされている。","tok":[["御命令","ごめいれい"],["は"],["、"],["あなた"],["の"],["僕","ぼく"],["、"],["預言者","よげんしゃ"],["たち"],["によって"],["こう"],["伝えられました","つたえられました"],["。"],["『"],["これ"],["から"],["入って","はいって"],["所有","しょゆう"],["する"],["地","ち"],["は"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["の"],["汚れ","よごれ"],["によって"],["汚された","よごされた"],["地","ち"],["で"],["ある"],["。"],["そこ"],["は"],["、"],["その"],["端","はし"],["から"],["端","はし"],["まで"],["彼","かれ"],["ら"],["の"],["忌まわしい","いまわしい"],["行い","おこない"],["によって"],["汚れ","よごれ"],["に"],["満たされて","みたされて"],["いる"],["。"]]},{"verse":12,"text":"それゆえ、あなたたちの娘を彼らの息子に嫁がせたり、彼らの娘をあなたたちの息子の嫁にしたりしてはならない。あなたたちが強くなり、この地の良い実を食べ、それを永久に子孫の所有とすることを望むならば、彼らと同盟を結ぼうとしてはならない。また、それによる繁栄を決して求めてはならない』と。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["たち"],["の"],["娘","むすめ"],["を"],["彼","かれ"],["ら"],["の"],["息子","むすこ"],["に"],["嫁がせ","とつがせ"],["たり"],["、"],["彼","かれ"],["ら"],["の"],["娘","むすめ"],["を"],["あなた"],["たち"],["の"],["息子","むすこ"],["の"],["嫁","よめ"],["に"],["し"],["たり"],["して"],["は"],["ならない"],["。"],["あなた"],["たち"],["が"],["強く","つよく"],["なり"],["、"],["この"],["地","ち"],["の"],["良い","よい"],["実","じつ"],["を"],["食べ","たべ"],["、"],["それ"],["を"],["永久","えいきゅう"],["に"],["子孫","しそん"],["の"],["所有","しょゆう"],["と"],["する"],["こと"],["を"],["望むならば","のぞむならば"],["、"],["彼","かれ"],["ら"],["と"],["同盟","どうめい"],["を"],["結ぼう","むすぼう"],["として"],["は"],["ならない"],["。"],["また"],["、"],["それ"],["に"],["よる"],["繁栄","はんえい"],["を"],["決して","けっして"],["求めて","もとめて"],["は"],["ならない"],["』"],["と"],["。"]]},{"verse":13,"text":"わたしたちは、数々の大きな悪事と罪科のゆえに受くべき艱難をすべて受けましたが、わたしたちの神、あなたはわたしたちの重い罪悪をもそう重く見ず、わたしたちをこのように生き残らせてくださいました。この後で、","tok":[["わたしたち"],["は"],["、"],["数々","かずかず"],["の"],["大きな","おおきな"],["悪事","あくじ"],["と"],["罪科","つみとが"],["の"],["ゆえ"],["に"],["受","うけ"],["くべき"],["艱難","かんなん"],["を"],["すべて"],["受けました","うけました"],["が"],["、"],["わたしたち"],["の"],["神","かみ"],["、"],["あなた"],["は"],["わたしたち"],["の"],["重い","おもい"],["罪悪","ざいあく"],["を"],["も"],["そう"],["重く","おもく"],["見ず","みず"],["、"],["わたしたち"],["を"],["この"],["よう"],["に"],["生き残らせて","いきのこらせて"],["くださいました"],["。"],["この"],["後","あと"],["で"],["、"]]},{"verse":14,"text":"またしても御命令を破り、その忌まわしい民と縁組みをすることができましょうか。お怒りになって、わたしたちを一人残らず滅ぼし尽くされても当然です。","tok":[["また"],["して"],["も"],["御命令","ごめいれい"],["を"],["破り","やぶり"],["、"],["その"],["忌まわしい","いまわしい"],["民","たみ"],["と"],["縁組み","えんぐみ"],["を"],["する"],["こと"],["が"],["できましょう"],["か"],["。"],["お怒り","おいかり"],["に"],["なって"],["、"],["わたしたち"],["を"],["一人","ひとり"],["残らず","のこらず"],["滅ぼし","ほろぼし"],["尽くされて","つくされて"],["も"],["当然","とうぜん"],["です"],["。"]]},{"verse":15,"text":"イスラエルの神、主よ、あなたは恵み深いお方です。だからこそ、わたしたちは今日も生き残りとしてここにいるのです。御覧ください。このような有様で御前に立ちえないのですが、罪深い者として、御前にぬかずいております。」","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["恵み","めぐみ"],["深い","ふかい"],["お方","おかた"],["です"],["。"],["だ"],["から"],["こそ"],["、"],["わたしたち"],["は"],["今日","きょう"],["も"],["生き残り","いきのこり"],["として"],["ここ"],["に"],["いる"],["の"],["です"],["。"],["御覧","ごらん"],["ください"],["。"],["この"],["よう"],["な"],["有様","ありさま"],["で"],["御前","ごぜん"],["に"],["立ち","たち"],["えない"],["の"],["です"],["が"],["、"],["罪深い","つみぶかい"],["者","もの"],["として"],["、"],["御前","ごぜん"],["に"],["ぬかずいて"],["おります"],["。"],["」"]]}]
[{"verse":1,"text":"預言者ハガイとイドの子ゼカリヤが、ユダとエルサレムにいるユダの人々に向かってその保護者であるイスラエルの神の名によって預言したので、","tok":[["預言者","よげんしゃ"],["ハガイ"],["と"],["イド"],["の"],["子","こ"],["ゼカリヤ"],["が"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["いる"],["ユダ"],["の"],["人々","ひとびと"],["に"],["向かって","むかって"],["その"],["保護者","ほごしゃ"],["で"],["ある"],["イスラエル"],["の"],["神","かみ"],["の"],["名","な"],["によって"],["預言","よげん"],["した"],["ので"],["、"]]},{"verse":2,"text":"シェアルティエルの子ゼルバベルとヨツァダクの子イエシュアは立ち上がって、エルサレムの神殿建築を再開した。神の預言者たちも彼らと共にいて、助けてくれた。","tok":[["シェアルティエル"],["の"],["子","こ"],["ゼルバベル"],["と"],["ヨツァダク"],["の"],["子","こ"],["イエシュア"],["は"],["立ち上がって","たちあがって"],["、"],["エルサレム"],["の"],["神殿","しんでん"],["建築","けんちく"],["を"],["再開","さいかい"],["した"],["。"],["神","かみ"],["の"],["預言者","よげんしゃ"],["たち"],["も"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いて"],["、"],["助けて","たすけて"],["くれた"],["。"]]},{"verse":3,"text":"そのときには、ユーフラテス西方の総督タテナイとシェタル‧ボゼナイ、およびその仲間たちが彼らのもとに来て言った。「この神殿を建て、その飾りつけを完成せよ、と誰がお前たちに命令したのか。」","tok":[["その"],["とき"],["に"],["は"],["、"],["ユーフラテス"],["西方","せいほう"],["の"],["総督","そうとく"],["タテナイ"],["と"],["シェタル"],["‧"],["ボゼナイ"],["、"],["および"],["その"],["仲間","なかま"],["たち"],["が"],["彼","かれ"],["ら"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["この"],["神殿","しんでん"],["を"],["建て","たて"],["、"],["その"],["飾りつけ","かざりつけ"],["を"],["完成","かんせい"],["せよ"],["、"],["と"],["誰","だれ"],["が"],["お前","おまえ"],["たち"],["に"],["命令","めいれい"],["した"],["の"],["か"],["。"],["」"]]},{"verse":4,"text":"そこでまた彼らに、「この建物を建てている人々の名前は何というのか」と尋ねた。","tok":[["そこ"],["で"],["また"],["彼","かれ"],["ら"],["に"],["、"],["「"],["この"],["建物","たてもの"],["を"],["建てて","たてて"],["いる"],["人々","ひとびと"],["の"],["名前","なまえ"],["は"],["何","なん"],["と"],["いう"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":5,"text":"しかし、神の目がユダの長老たちの上に注がれていたので、彼らは建築を妨げることができず、その報告がダレイオスになされ、それに対する王の返書が送られてくるのを待った。","tok":[["しかし"],["、"],["神","かみ"],["の"],["目","め"],["が"],["ユダ"],["の"],["長老","ちょうろう"],["たち"],["の"],["上","うえ"],["に"],["注がれて","そそがれて"],["いた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["建築","けんちく"],["を"],["妨げる","さまたげる"],["こと"],["が"],["できず"],["、"],["その"],["報告","ほうこく"],["が"],["ダレイオス"],["に"],["なされ"],["、"],["それ"],["に"],["対する","たいする"],["王","おう"],["の"],["返書","へんしょ"],["が"],["送られて","おくられて"],["くる"],["の"],["を"],["待った","まった"],["。"]]},{"verse":6,"text":"ユーフラテス西方の長官タテナイとシェタル‧ボゼナイおよびその仲間であるユーフラテス西方の巡察官たちがダレイオス王に送った手紙の写し、","tok":[["ユーフラテス"],["西方","せいほう"],["の"],["長官","ちょうかん"],["タテナイ"],["と"],["シェタル"],["‧"],["ボゼナイ"],["および"],["その"],["仲間","なかま"],["で"],["ある"],["ユーフラテス"],["西方","せいほう"],["の"],["巡察官","じゅんさつかん"],["たち"],["が"],["ダレイオス"],["王","おう"],["に"],["送った","おくった"],["手紙","てがみ"],["の"],["写し","うつし"],["、"]]},{"verse":7,"text":"すなわち彼らが王に送った報告書にはこのように書かれていた。「ダレイオス王へ、大いなる平和をお祈り申し上げます。","tok":[["すなわち"],["彼","かれ"],["ら"],["が"],["王","おう"],["に"],["送った","おくった"],["報告書","ほうこくしょ"],["に"],["は"],["この"],["よう"],["に"],["書かれて","かかれて"],["いた"],["。"],["「"],["ダレイオス"],["王","おう"],["へ"],["、"],["大いなる","おおいなる"],["平和","へいわ"],["を"],["お祈り","おいのり"],["申し上げます","もうしあげます"],["。"]]},{"verse":8,"text":"早速王に知っていただきたいことがございます。わたしどもがユダの州に赴き、大いなる神の神殿に来てみますと、それは切り石で建てられ、壁には板が張られ、工事は熱心に進められ、彼らの手によって完成は間近に迫っておりました。","tok":[["早速","さっそく"],["王","おう"],["に"],["知って","しって"],["いただきたい"],["こと"],["が"],["ございます"],["。"],["わたし"],["ども"],["が"],["ユダ"],["の"],["州","しゅう"],["に"],["赴き","おもむき"],["、"],["大いなる","おおいなる"],["神","かみ"],["の"],["神殿","しんでん"],["に"],["来て","きて"],["みます"],["と"],["、"],["それ"],["は"],["切り石","きりいし"],["で"],["建てられ","たてられ"],["、"],["壁","かべ"],["に"],["は"],["板","いた"],["が"],["張られ","はられ"],["、"],["工事","こうじ"],["は"],["熱心","ねっしん"],["に"],["進められ","すすめられ"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["によって"],["完成","かんせい"],["は"],["間近","まじか"],["に"],["迫って","せまって"],["おりました"],["。"]]},{"verse":9,"text":"わたしどもはそこでその長老たちに、『この神殿を建て、その飾りつけを仕上げよ、と誰がお前たちに命令したのか』と尋ねました。","tok":[["わたし"],["ども"],["は"],["そこ"],["で"],["その"],["長老","ちょうろう"],["たち"],["に"],["、"],["『"],["この"],["神殿","しんでん"],["を"],["建て","たて"],["、"],["その"],["飾りつけ","かざりつけ"],["を"],["仕上げよ","しあげよ"],["、"],["と"],["誰","だれ"],["が"],["お前","おまえ"],["たち"],["に"],["命令","めいれい"],["した"],["の"],["か"],["』"],["と"],["尋ねました","たずねました"],["。"]]},{"verse":10,"text":"また御報告申し上げるために彼らの名前を尋ね、その責任者たちの名前を書き留めておきました。","tok":[["また"],["御報告","ごほうこく"],["申し上げる","もうしあげる"],["ため"],["に"],["彼","かれ"],["ら"],["の"],["名前","なまえ"],["を"],["尋ね","たずね"],["、"],["その"],["責任者","せきにんしゃ"],["たち"],["の"],["名前","なまえ"],["を"],["書き留めて","かきとめて"],["おきました"],["。"]]},{"verse":11,"text":"彼らはこのような返事をいたしました。『我々は、天地の神に仕える僕であって、今から何年も前に建てられた神殿を再建しているところである。かつてイスラエルの偉大な王が神殿を建て、完成したが、","tok":[["彼","かれ"],["ら"],["は"],["この"],["よう"],["な"],["返事","へんじ"],["を"],["いたしました"],["。"],["『"],["我々","われわれ"],["は"],["、"],["天地","てんち"],["の"],["神","かみ"],["に"],["仕える","つかえる"],["僕","ぼく"],["で"],["あって"],["、"],["今","いま"],["から"],["何","なん"],["年","ねん"],["も"],["前","まえ"],["に"],["建てられた","たてられた"],["神殿","しんでん"],["を"],["再建","さいけん"],["して"],["いる"],["ところ"],["で"],["ある"],["。"],["かつて"],["イスラエル"],["の"],["偉大","いだい"],["な"],["王","おう"],["が"],["神殿","しんでん"],["を"],["建て","たて"],["、"],["完成","かんせい"],["した"],["が"],["、"]]},{"verse":12,"text":"我々の先祖たちが天にいます神を怒らせたので、神は彼らをバビロンの王、カルデア人ネブカドネツァルの手に渡され、王はこの神殿を破壊し、民を捕囚としてバビロンに連れ去ったのであった。","tok":[["我々","われわれ"],["の"],["先祖","せんぞ"],["たち"],["が"],["天","てん"],["に"],["います"],["神","かみ"],["を"],["怒らせた","おこらせた"],["ので"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["バビロン"],["の"],["王","おう"],["、"],["カルデア"],["人","にん"],["ネブカドネツァル"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["王","おう"],["は"],["この"],["神殿","しんでん"],["を"],["破壊","はかい"],["し"],["、"],["民","みん"],["を"],["捕囚","ほしゅう"],["として"],["バビロン"],["に"],["連れ去った","つれさった"],["ので"],["あった"],["。"]]},{"verse":13,"text":"しかし、バビロンの王キュロスはその治世の第一年に、この神殿の再建をお命じになった。","tok":[["しかし"],["、"],["バビロン"],["の"],["王","おう"],["キュロス"],["は"],["その"],["治世","ちせい"],["の"],["第","だい"],["一","いち"],["年","ねん"],["に"],["、"],["この"],["神殿","しんでん"],["の"],["再建","さいけん"],["を"],["お命じ","おめいじ"],["に"],["なった"],["。"]]},{"verse":14,"text":"また、ネブカドネツァルがエルサレムの神殿から取り出して、バビロンの神殿に持ち帰った金銀の祭具を、キュロス王はこのバビロンの神殿から取り出し、長官に任命したシェシュバツァルという名の人に託し、","tok":[["また"],["、"],["ネブカドネツァル"],["が"],["エルサレム"],["の"],["神殿","しんでん"],["から"],["取り出して","とりだして"],["、"],["バビロン"],["の"],["神殿","しんでん"],["に"],["持ち帰った","もちかえった"],["金銀","きんぎん"],["の"],["祭具","さいぐ"],["を"],["、"],["キュロス"],["王","おう"],["は"],["この"],["バビロン"],["の"],["神殿","しんでん"],["から"],["取り出し","とりだし"],["、"],["長官","ちょうかん"],["に"],["任命","にんめい"],["した"],["シェシュバツァル"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["に"],["託し","たくし"],["、"]]},{"verse":15,"text":"これらの祭具を携えてエルサレムの神殿に行き、そこに納め、神殿をかつてあった所に再建せよ、と言われた。","tok":[["これ"],["ら"],["の"],["祭具","さいぐ"],["を"],["携えて","たずさえて"],["エルサレム"],["の"],["神殿","しんでん"],["に"],["行き","いき"],["、"],["そこ"],["に"],["納め","おさめ"],["、"],["神殿","しんでん"],["を"],["かつて"],["あった"],["所","ところ"],["に"],["再建","さいけん"],["せよ"],["、"],["と"],["言われた","いわれた"],["。"]]},{"verse":16,"text":"そこで、そのシェシュバツァルはエルサレムに来て、その神殿の基礎を据えた。そのときから今に至るまで建築は続いており、まだ完成していないのである。』","tok":[["そこ"],["で"],["、"],["その"],["シェシュバツァル"],["は"],["エルサレム"],["に"],["来て","きて"],["、"],["その"],["神殿","しんでん"],["の"],["基礎","きそ"],["を"],["据えた","すえた"],["。"],["その"],["とき"],["から"],["今","いま"],["に"],["至る","いたる"],["まで"],["建築","けんちく"],["は"],["続いて","つづいて"],["おり"],["、"],["まだ"],["完成","かんせい"],["して"],["いない"],["ので"],["ある"],["。"],["』"]]},{"verse":17,"text":"従って、もし王のお心に適いますなら、エルサレムにあるこの神殿を建てよとの命令が、キュロス王によって出されたことがあるのかどうか、バビロンにある王宮の記録保管所をお調べいただきたいのです。また、この件に関する王様の御裁定もいただければ有り難く存じます。」","tok":[["従って","したがって"],["、"],["もし"],["王","おう"],["の"],["お心","おこころ"],["に"],["適いますなら","かないますなら"],["、"],["エルサレム"],["に"],["ある"],["この"],["神殿","しんでん"],["を"],["建てよ","たてよ"],["と"],["の"],["命令","めいれい"],["が"],["、"],["キュロス"],["王","おう"],["によって"],["出された","だされた"],["こと"],["が"],["ある"],["の"],["か"],["どう"],["か"],["、"],["バビロン"],["に"],["ある"],["王宮","おうきゅう"],["の"],["記録","きろく"],["保管所","ほかんしょ"],["を"],["お調べ","おしらべ"],["いただきたい"],["の"],["です"],["。"],["また"],["、"],["この"],["件","けん"],["に"],["関する","かんする"],["王様","おうさま"],["の"],["御裁定","ごさいてい"],["も"],["いただければ"],["有り難く","ありがたく"],["存じます","ぞんじます"],["。"],["」"]]}]
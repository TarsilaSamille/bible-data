[{"verse":1,"text":"これらのことの後で、神はアブラハムを試された。神が、「アブラハムよ」と呼びかけ、彼が、「はい」と答えると、","tok":[["これ"],["ら"],["の"],["こと"],["の"],["後","あと"],["で"],["、"],["神","かみ"],["は"],["アブラハム"],["を"],["試された","ためされた"],["。"],["神","かみ"],["が"],["、"],["「"],["アブラハム"],["よ"],["」"],["と"],["呼びかけ","よびかけ"],["、"],["彼","かれ"],["が"],["、"],["「"],["はい"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":2,"text":"神は命じられた。「あなたの息子、あなたの愛する独り子イサクを連れて、モリヤの地に行きなさい。わたしが命じる山の一つに登り、彼を焼き尽くす献げ物としてささげなさい。」","tok":[["神","かみ"],["は"],["命じられた","めいじられた"],["。"],["「"],["あなた"],["の"],["息子","むすこ"],["、"],["あなた"],["の"],["愛する","あいする"],["独り子","ひとりご"],["イサク"],["を"],["連れて","つれて"],["、"],["モリヤ"],["の"],["地","ち"],["に"],["行き","いき"],["なさい"],["。"],["わたし"],["が"],["命じる","めいじる"],["山","やま"],["の"],["一","ひと"],["つ"],["に"],["登り","のぼり"],["、"],["彼","かれ"],["を"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["として"],["ささげ"],["なさい"],["。"],["」"]]},{"verse":3,"text":"次の朝早く、アブラハムはろばに鞍を置き、献げ物に用いる薪を割り、二人の若者と息子イサクを連れ、神の命じられた所に向かって行った。","tok":[["次","つぎ"],["の"],["朝","あさ"],["早く","はやく"],["、"],["アブラハム"],["は"],["ろば"],["に"],["鞍","くら"],["を"],["置き","おき"],["、"],["献げ物","ささげもの"],["に"],["用いる","もちいる"],["薪","たきぎ"],["を"],["割り","わり"],["、"],["二人","ふたり"],["の"],["若者","わかもの"],["と"],["息子","むすこ"],["イサク"],["を"],["連れ","つれ"],["、"],["神","かみ"],["の"],["命じられた","めいじられた"],["所","ところ"],["に"],["向かって","むかって"],["行った","いった"],["。"]]},{"verse":4,"text":"三日目になって、アブラハムが目を凝らすと、遠くにその場所が見えたので、","tok":[["三日目","みっかめ"],["に"],["なって"],["、"],["アブラハム"],["が"],["目","め"],["を"],["凝らす","こらす"],["と"],["、"],["遠く","とおく"],["に"],["その"],["場所","ばしょ"],["が"],["見えた","みえた"],["ので"],["、"]]},{"verse":5,"text":"アブラハムは若者に言った。「お前たちは、ろばと一緒にここで待っていなさい。わたしと息子はあそこへ行って、礼拝をして、また戻ってくる。」","tok":[["アブラハム"],["は"],["若者","わかもの"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["たち"],["は"],["、"],["ろば"],["と"],["一緒","いっしょ"],["に"],["ここ"],["で"],["待って","まって"],["い"],["なさい"],["。"],["わたし"],["と"],["息子","むすこ"],["は"],["あそこ"],["へ"],["行って","いって"],["、"],["礼拝","れいはい"],["を"],["して"],["、"],["また"],["戻って","もどって"],["くる"],["。"],["」"]]},{"verse":6,"text":"アブラハムは、焼き尽くす献げ物に用いる薪を取って、息子イサクに背負わせ、自分は火と刃物を手に持った。二人は一緒に歩いて行った。","tok":[["アブラハム"],["は"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["に"],["用いる","もちいる"],["薪","たきぎ"],["を"],["取って","とって"],["、"],["息子","むすこ"],["イサク"],["に"],["背負わせ","せおわせ"],["、"],["自分","じぶん"],["は"],["火","ひ"],["と"],["刃物","はもの"],["を"],["手","て"],["に"],["持った","もった"],["。"],["二人","ふたり"],["は"],["一緒","いっしょ"],["に"],["歩いて","あるいて"],["行った","いった"],["。"]]},{"verse":7,"text":"イサクは父アブラハムに、「わたしのお父さん」と呼びかけた。彼が、「ここにいる。わたしの子よ」と答えると、イサクは言った。「火と薪はここにありますが、焼き尽くす献げ物にする小羊はどこにいるのですか。」","tok":[["イサク"],["は"],["父","ちち"],["アブラハム"],["に"],["、"],["「"],["わたし"],["の"],["お父さん","おとうさん"],["」"],["と"],["呼びかけた","よびかけた"],["。"],["彼","かれ"],["が"],["、"],["「"],["ここ"],["に"],["いる"],["。"],["わたし"],["の"],["子","こ"],["よ"],["」"],["と"],["答える","こたえる"],["と"],["、"],["イサク"],["は"],["言った","いった"],["。"],["「"],["火","ひ"],["と"],["薪","たきぎ"],["は"],["ここ"],["に"],["あります"],["が"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["に"],["する"],["小羊","こひつじ"],["は"],["どこ"],["に"],["いる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":8,"text":"アブラハムは答えた。「わたしの子よ、焼き尽くす献げ物の小羊はきっと神が備えてくださる。」二人は一緒に歩いて行った。","tok":[["アブラハム"],["は"],["答えた","こたえた"],["。"],["「"],["わたし"],["の"],["子","こ"],["よ"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["の"],["小羊","こひつじ"],["は"],["きっと"],["神","かみ"],["が"],["備えて","そなえて"],["くださる"],["。"],["」"],["二人","ふたり"],["は"],["一緒","いっしょ"],["に"],["歩いて","あるいて"],["行った","いった"],["。"]]},{"verse":9,"text":"神が命じられた場所に着くと、アブラハムはそこに祭壇を築き、薪を並べ、息子イサクを縛って祭壇の薪の上に載せた。","tok":[["神","かみ"],["が"],["命じられた","めいじられた"],["場所","ばしょ"],["に"],["着く","つく"],["と"],["、"],["アブラハム"],["は"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["薪","たきぎ"],["を"],["並べ","ならべ"],["、"],["息子","むすこ"],["イサク"],["を"],["縛って","しばって"],["祭壇","さいだん"],["の"],["薪","たきぎ"],["の"],["上","うえ"],["に"],["載せた","のせた"],["。"]]},{"verse":10,"text":"そしてアブラハムは、手を伸ばして刃物を取り、息子を屠ろうとした。","tok":[["そして"],["アブラハム"],["は"],["、"],["手","て"],["を"],["伸ばして","のばして"],["刃物","はもの"],["を"],["取り","とり"],["、"],["息子","むすこ"],["を"],["屠ろう","ほふろう"],["と"],["した"],["。"]]},{"verse":11,"text":"そのとき、天から主の御使いが、「アブラハム、アブラハム」と呼びかけた。彼が、「はい」と答えると、","tok":[["その"],["とき"],["、"],["天","てん"],["から"],["主","ぬし"],["の"],["御使い","おつかい"],["が"],["、"],["「"],["アブラハム"],["、"],["アブラハム"],["」"],["と"],["呼びかけた","よびかけた"],["。"],["彼","かれ"],["が"],["、"],["「"],["はい"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":12,"text":"御使いは言った。「その子に手を下すな。何もしてはならない。あなたが神を畏れる者であることが、今、分かったからだ。あなたは、自分の独り子である息子すら、わたしにささげることを惜しまなかった。」","tok":[["御使い","おつかい"],["は"],["言った","いった"],["。"],["「"],["その"],["子","こ"],["に"],["手","て"],["を"],["下す","くだす"],["な"],["。"],["何","なん"],["も"],["して"],["は"],["ならない"],["。"],["あなた"],["が"],["神","かみ"],["を"],["畏れる","おそれる"],["者","もの"],["で"],["ある"],["こと"],["が"],["、"],["今","いま"],["、"],["分かった","わかった"],["から"],["だ"],["。"],["あなた"],["は"],["、"],["自分","じぶん"],["の"],["独り子","ひとりご"],["で"],["ある"],["息子","むすこ"],["すら"],["、"],["わたし"],["に"],["ささげる"],["こと"],["を"],["惜しまなかった","おしまなかった"],["。"],["」"]]},{"verse":13,"text":"アブラハムは目を凝らして見回した。すると、後ろの木の茂みに一匹の雄羊が角をとられていた。アブラハムは行ってその雄羊を捕まえ、息子の代わりに焼き尽くす献げ物としてささげた。","tok":[["アブラハム"],["は"],["目","め"],["を"],["凝らして","こらして"],["見回した","みまわした"],["。"],["する"],["と"],["、"],["後ろ","うしろ"],["の"],["木","き"],["の"],["茂み","しげみ"],["に"],["一匹","いちひき"],["の"],["雄羊","おひつじ"],["が"],["角","かど"],["を"],["とられて"],["いた"],["。"],["アブラハム"],["は"],["行って","いって"],["その"],["雄羊","おひつじ"],["を"],["捕まえ","つかまえ"],["、"],["息子","むすこ"],["の"],["代わり","かわり"],["に"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["として"],["ささげた"],["。"]]},{"verse":14,"text":"アブラハムはその場所をヤーウェ‧イルエ（主は備えてくださる）と名付けた。そこで、人々は今日でも「主の山に、備えあり（イエラエ）」と言っている。","tok":[["アブラハム"],["は"],["その"],["場所","ばしょ"],["を"],["ヤーウェ"],["‧"],["イルエ"],["（"],["主","ぬし"],["は"],["備えて","そなえて"],["くださる"],["）"],["と"],["名付けた","なづけた"],["。"],["そこ"],["で"],["、"],["人々","ひとびと"],["は"],["今日","きょう"],["で"],["も"],["「"],["主","ぬし"],["の"],["山","やま"],["に"],["、"],["備え","そなえ"],["あり"],["（"],["イエラエ"],["）"],["」"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":15,"text":"主の御使いは、再び天からアブラハムに呼びかけた。","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["は"],["、"],["再び","ふたたび"],["天","てん"],["から"],["アブラハム"],["に"],["呼びかけた","よびかけた"],["。"]]},{"verse":16,"text":"御使いは言った。「わたしは自らにかけて誓う、と主は言われる。あなたがこの事を行い、自分の独り子である息子すら惜しまなかったので、","tok":[["御使い","おつかい"],["は"],["言った","いった"],["。"],["「"],["わたし"],["は"],["自ら","みずから"],["に"],["かけて"],["誓う","ちかう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["あなた"],["が"],["この"],["事","こと"],["を"],["行い","おこない"],["、"],["自分","じぶん"],["の"],["独り子","ひとりご"],["で"],["ある"],["息子","むすこ"],["すら"],["惜しまなかった","おしまなかった"],["ので"],["、"]]},{"verse":17,"text":"あなたを豊かに祝福し、あなたの子孫を天の星のように、海辺の砂のように増やそう。あなたの子孫は敵の城門を勝ち取る。","tok":[["あなた"],["を"],["豊か","ゆたか"],["に"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["、"],["海辺","うみべ"],["の"],["砂","すな"],["の"],["よう"],["に"],["増やそう","ふやそう"],["。"],["あなた"],["の"],["子孫","しそん"],["は"],["敵","てき"],["の"],["城門","じょうもん"],["を"],["勝ち取る","かちとる"],["。"]]},{"verse":18,"text":"地上の諸国民はすべて、あなたの子孫によって祝福を得る。あなたがわたしの声に聞き従ったからである。」","tok":[["地上","ちじょう"],["の"],["諸国民","しょこくみん"],["は"],["すべて"],["、"],["あなた"],["の"],["子孫","しそん"],["によって"],["祝福","しゅくふく"],["を"],["得る","うる"],["。"],["あなた"],["が"],["わたし"],["の"],["声","こえ"],["に"],["聞き従った","ききしたがった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":19,"text":"アブラハムは若者のいるところへ戻り、共にベエル‧シェバへ向かった。アブラハムはベエル‧シェバに住んだ。","tok":[["アブラハム"],["は"],["若者","わかもの"],["の"],["いる"],["ところ"],["へ"],["戻り","もどり"],["、"],["共","とも"],["に"],["ベエル"],["‧"],["シェバ"],["へ"],["向かった","むかった"],["。"],["アブラハム"],["は"],["ベエル"],["‧"],["シェバ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":20,"text":"これらのことの後で、アブラハムに知らせが届いた。「ミルカもまた、あなたの兄弟ナホルとの間に子供を産みました。","tok":[["これ"],["ら"],["の"],["こと"],["の"],["後","あと"],["で"],["、"],["アブラハム"],["に"],["知らせ","しらせ"],["が"],["届いた","とどいた"],["。"],["「"],["ミルカ"],["も"],["また"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["ナホル"],["と"],["の"],["間","あいだ"],["に"],["子供","こども"],["を"],["産みました","うみました"],["。"]]},{"verse":21,"text":"長男はウツ、その弟はブズ、次はアラムの父ケムエル、","tok":[["長男","ちょうなん"],["は"],["ウツ"],["、"],["その"],["弟","おとうと"],["は"],["ブズ"],["、"],["次","つぎ"],["は"],["アラム"],["の"],["父","ちち"],["ケムエル"],["、"]]},{"verse":22,"text":"それからケセド、ハゾ、ピルダシュ、イドラフ、ベトエルです。」","tok":[["それ"],["から"],["ケセド"],["、"],["ハゾ"]
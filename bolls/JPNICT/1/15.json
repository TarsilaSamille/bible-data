[{"verse":1,"text":"これらのことの後で、主の言葉が幻の中でアブラムに臨んだ。「恐れるな、アブラムよ。わたしはあなたの盾である。あなたの受ける報いは非常に大きいであろう。」","tok":[["これ"],["ら"],["の"],["こと"],["の"],["後","あと"],["で"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["幻","まぼろし"],["の"],["中","なか"],["で"],["アブラム"],["に"],["臨んだ","のぞんだ"],["。"],["「"],["恐れる","おそれる"],["な"],["、"],["アブラム"],["よ"],["。"],["わたし"],["は"],["あなた"],["の"],["盾","たて"],["で"],["ある"],["。"],["あなた"],["の"],["受ける","うける"],["報い","むくい"],["は"],["非常","ひじょう"],["に"],["大きいで","おおきいで"],["あろう"],["。"],["」"]]},{"verse":2,"text":"アブラムは尋ねた。「わが神、主よ。わたしに何をくださるというのですか。わたしには子供がありません。家を継ぐのはダマスコのエリエゼルです。」","tok":[["アブラム"],["は"],["尋ねた","たずねた"],["。"],["「"],["わが"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["わたし"],["に"],["何","なん"],["を"],["くださる"],["と"],["いう"],["の"],["です"],["か"],["。"],["わたし"],["に"],["は"],["子供","こども"],["が"],["ありません"],["。"],["家","いえ"],["を"],["継ぐ","つぐ"],["の"],["は"],["ダマスコ"],["の"],["エリエゼル"],["です"],["。"],["」"]]},{"verse":3,"text":"アブラムは言葉をついだ。「御覧のとおり、あなたはわたしに子孫を与えてくださいませんでしたから、家の僕が跡を継ぐことになっています。」","tok":[["アブラム"],["は"],["言葉","ことば"],["を"],["ついだ"],["。"],["「"],["御覧","ごらん"],["の"],["とおり"],["、"],["あなた"],["は"],["わたし"],["に"],["子孫","しそん"],["を"],["与えて","あたえて"],["くださいませんでした"],["から"],["、"],["家","いえ"],["の"],["僕","ぼく"],["が"],["跡","あと"],["を"],["継ぐ","つぐ"],["こと"],["に"],["なって"],["います"],["。"],["」"]]},{"verse":4,"text":"見よ、主の言葉があった。「その者があなたの跡を継ぐのではなく、あなたから生まれる者が跡を継ぐ。」","tok":[["見よ","みよ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["あった"],["。"],["「"],["その"],["者","もの"],["が"],["あなた"],["の"],["跡","あと"],["を"],["継ぐ","つぐ"],["ので"],["は"],["なく"],["、"],["あなた"],["から"],["生まれる","うまれる"],["者","もの"],["が"],["跡","あと"],["を"],["継ぐ","つぐ"],["。"],["」"]]},{"verse":5,"text":"主は彼を外に連れ出して言われた。「天を仰いで、星を数えることができるなら、数えてみるがよい。」そして言われた。「あなたの子孫はこのようになる。」","tok":[["主","ぬし"],["は"],["彼","かれ"],["を"],["外","そと"],["に"],["連れ出して","つれだして"],["言われた","いわれた"],["。"],["「"],["天","てん"],["を"],["仰いで","あおいで"],["、"],["星","ほし"],["を"],["数える","かぞえる"],["こと"],["が"],["できるなら"],["、"],["数えて","かぞえて"],["みる"],["が"],["よい"],["。"],["」"],["そして"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["子孫","しそん"],["は"],["この"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":6,"text":"アブラムは主を信じた。主はそれを彼の義と認められた。","tok":[["アブラム"],["は"],["主","ぬし"],["を"],["信じた","しんじた"],["。"],["主","ぬし"],["は"],["それ"],["を"],["彼","かれ"],["の"],["義","ぎ"],["と"],["認められた","みとめられた"],["。"]]},{"verse":7,"text":"主は言われた。「わたしはあなたをカルデアのウルから導き出した主である。わたしはあなたにこの土地を与え、それを継がせる。」","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["あなた"],["を"],["カルデア"],["の"],["ウル"],["から"],["導き出した","みちびきだした"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["に"],["この"],["土地","とち"],["を"],["与え","あたえ"],["、"],["それ"],["を"],["継がせる","つがせる"],["。"],["」"]]},{"verse":8,"text":"アブラムは尋ねた。「わが神、主よ。この土地をわたしが継ぐことを、何によって知ることができましょうか。」","tok":[["アブラム"],["は"],["尋ねた","たずねた"],["。"],["「"],["わが"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["この"],["土地","とち"],["を"],["わたし"],["が"],["継ぐ","つぐ"],["こと"],["を"],["、"],["何","なん"],["によって"],["知る","しる"],["こと"],["が"],["できましょう"],["か"],["。"],["」"]]},{"verse":9,"text":"主は言われた。「三歳の雌牛と、三歳の雌山羊と、三歳の雄羊と、山鳩と、鳩の雛とをわたしのもとに持って来なさい。」","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["三歳","さんさい"],["の"],["雌牛","めうし"],["と"],["、"],["三歳","さんさい"],["の"],["雌山羊","めすやぎ"],["と"],["、"],["三歳","さんさい"],["の"],["雄羊","おひつじ"],["と"],["、"],["山鳩","やまばと"],["と"],["、"],["鳩","はと"],["の"],["雛","ひな"],["と"],["を"],["わたし"],["の"],["もと"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["」"]]},{"verse":10,"text":"アブラムはそれらのものをみな持って来て、真っ二つに切り裂き、それぞれを互いに向かい合わせて置いた。ただ、鳥は切り裂かなかった。","tok":[["アブラム"],["は"],["それ"],["ら"],["の"],["もの"],["を"],["みな"],["持って","もって"],["来て","きて"],["、"],["真っ","まっ"],["二","ふた"],["つ"],["に"],["切り裂き","きりさき"],["、"],["それぞれ"],["を"],["互い","たがい"],["に"],["向かい合わせて","むかいあわせて"],["置いた","おいた"],["。"],["ただ"],["、"],["鳥","とり"],["は"],["切り裂かなかった","きりさかなかった"],["。"]]},{"verse":11,"text":"はげ鷹がこれらの死体をねらって降りて来ると、アブラムは追い払った。","tok":[["はげ鷹","はげたか"],["が"],["これ"],["ら"],["の"],["死体","したい"],["を"],["ねらって"],["降りて","おりて"],["来る","くる"],["と"],["、"],["アブラム"],["は"],["追い払った","おいはらった"],["。"]]},{"verse":12,"text":"日が沈みかけたころ、アブラムは深い眠りに襲われた。すると、恐ろしい大いなる暗黒が彼に臨んだ。","tok":[["日","ひ"],["が"],["沈みかけた","しずみかけた"],["ころ"],["、"],["アブラム"],["は"],["深い","ふかい"],["眠り","ねむり"],["に"],["襲われた","おそわれた"],["。"],["する"],["と"],["、"],["恐ろしい","おそろしい"],["大いなる","おおいなる"],["暗黒","あんこく"],["が"],["彼","かれ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":13,"text":"主はアブラムに言われた。「よく覚えておくがよい。あなたの子孫は異邦の国で寄留者となり、四百年の間奴隷として仕え、苦しめられるであろう。","tok":[["主","ぬし"],["は"],["アブラム"],["に"],["言われた","いわれた"],["。"],["「"],["よく"],["覚えて","おぼえて"],["おく"],["が"],["よい"],["。"],["あなた"],["の"],["子孫","しそん"],["は"],["異邦","いほう"],["の"],["国","くに"],["で"],["寄留者","きりゅうしゃ"],["と"],["なり"],["、"],["四百","よんひゃく"],["年","ねん"],["の"],["間","あいだ"],["奴隷","どれい"],["として"],["仕え","つかえ"],["、"],["苦しめられるで","くるしめられるで"],["あろう"],["。"]]},{"verse":14,"text":"しかしわたしは、彼らが奴隷として仕えるその国民を裁く。その後、彼らは多くの財産を携えて脱出するであろう。","tok":[["しかし"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["奴隷","どれい"],["として"],["仕える","つかえる"],["その"],["国民","こくみん"],["を"],["裁く","さばく"],["。"],["その"],["後","ご"],["、"],["彼","かれ"],["ら"],["は"],["多く","おおく"],["の"],["財産","ざいさん"],["を"],["携えて","たずさえて"],["脱出","だっしゅつ"],["するで"],["あろう"],["。"]]},{"verse":15,"text":"あなた自身は、長寿を全うして葬られ、安らかに先祖のもとに行く。","tok":[["あなた"],["自身","じしん"],["は"],["、"],["長寿","ちょうじゅ"],["を"],["全う","まっとう"],["して"],["葬られ","ほうむられ"],["、"],["安らか","やすらか"],["に"],["先祖","せんぞ"],["の"],["もと"],["に"],["行く","いく"],["。"]]},{"verse":16,"text":"ここに戻って来るのは、四代目の者たちである。それまでは、アモリ人の罪が極みに達しないからである。」","tok":[["ここ"],["に"],["戻って","もどって"],["来る","くる"],["の"],["は"],["、"],["四代目","よんだいめ"],["の"],["者","もの"],["たち"],["で"],["ある"],["。"],["それ"],["まで"],["は"],["、"],["アモリ人","あもりにん"],["の"],["罪","つみ"],["が"],["極み","きわみ"],["に"],["達しない","たっしない"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":17,"text":"日が沈み、暗闇に覆われたころ、突然、煙を吐く炉と燃える松明が二つに裂かれた動物の間を通り過ぎた。","tok":[["日","ひ"],["が"],["沈み","しずみ"],["、"],["暗闇","くらやみ"],["に"],["覆われた","おおわれた"],["ころ"],["、"],["突然","とつぜん"],["、"],["煙","けむり"],["を"],["吐く","はく"],["炉","ろ"],["と"],["燃える","もえる"],["松明","たいまつ"],["が"],["二","ふた"],["つ"],["に"],["裂かれた","さかれた"],["動物","どうぶつ"],["の"],["間","あいだ"],["を"],["通り過ぎた","とおりすぎた"],["。"]]},{"verse":18,"text":"その日、主はアブラムと契約を結んで言われた。「あなたの子孫にこの土地を与える。エジプトの川から大河ユーフラテスに至るまで、","tok":[["その"],["日","ひ"],["、"],["主","ぬし"],["は"],["アブラム"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["子孫","しそん"],["に"],["この"],["土地","とち"],["を"],["与える","あたえる"],["。"],["エジプト"],["の"],["川","かわ"],["から"],["大河","たいが"],["ユーフラテス"],["に"],["至る","いたる"],["まで"],["、"]]},{"verse":19,"text":"カイン人、ケナズ人、カドモニ人、","tok":[["カイン人","かいんにん"],["、"],["ケナズ人","けなずにん"],["、"],["カドモニ"],["人","にん"],["、"]]},{"verse":20,"text":"ヘト人、ペリジ人、レファイム人、","tok":[["ヘト人","へとにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["レファイム"],["人","にん"],["、"]]},{"verse":21,"text":"アモリ人、カナン人、ギルガシ人、エブス人の土地を与える。」","tok":[["アモリ人","あもりにん"],["、"],["カナン人","かなんにん"],["、"],["ギルガシ"],["人","にん"],["、"],["エブス人","えぶすにん"],["の"],["土地","とち"],["を"],["与える","あたえる"],["。"],["」"]]}]
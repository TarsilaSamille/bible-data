[{"verse":1,"text":"アブラハムの時代にあった飢饉とは別に、この地方にまた飢饉があったので、イサクはゲラルにいるペリシテ人の王アビメレクのところへ行った。","tok":[["アブラハム"],["の"],["時代","じだい"],["に"],["あった"],["飢饉","ききん"],["と"],["は"],["別","べつ"],["に"],["、"],["この"],["地方","ちほう"],["に"],["また"],["飢饉","ききん"],["が"],["あった"],["ので"],["、"],["イサク"],["は"],["ゲラル"],["に"],["いる"],["ペリシテ"],["人","にん"],["の"],["王","おう"],["アビメレク"],["の"],["ところ"],["へ"],["行った","いった"],["。"]]},{"verse":2,"text":"そのとき、主がイサクに現れて言われた。「エジプトへ下って行ってはならない。わたしが命じる土地に滞在しなさい。","tok":[["その"],["とき"],["、"],["主","ぬし"],["が"],["イサク"],["に"],["現れて","あらわれて"],["言われた","いわれた"],["。"],["「"],["エジプト"],["へ"],["下って","くだって"],["行って","いって"],["は"],["ならない"],["。"],["わたし"],["が"],["命じる","めいじる"],["土地","とち"],["に"],["滞在","たいざい"],["し"],["なさい"],["。"]]},{"verse":3,"text":"あなたがこの土地に寄留するならば、わたしはあなたと共にいてあなたを祝福し、これらの土地をすべてあなたとその子孫に与え、あなたの父アブラハムに誓ったわたしの誓いを成就する。","tok":[["あなた"],["が"],["この"],["土地","とち"],["に"],["寄留","きりゅう"],["するならば"],["、"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いて"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["これ"],["ら"],["の"],["土地","とち"],["を"],["すべて"],["あなた"],["と"],["その"],["子孫","しそん"],["に"],["与え","あたえ"],["、"],["あなた"],["の"],["父","ちち"],["アブラハム"],["に"],["誓った","ちかった"],["わたし"],["の"],["誓い","ちかい"],["を"],["成就","じょうじゅ"],["する"],["。"]]},{"verse":4,"text":"わたしはあなたの子孫を天の星のように増やし、これらの土地をすべてあなたの子孫に与える。地上の諸国民はすべて、あなたの子孫によって祝福を得る。","tok":[["わたし"],["は"],["あなた"],["の"],["子孫","しそん"],["を"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["増やし","ふやし"],["、"],["これ"],["ら"],["の"],["土地","とち"],["を"],["すべて"],["あなた"],["の"],["子孫","しそん"],["に"],["与える","あたえる"],["。"],["地上","ちじょう"],["の"],["諸国民","しょこくみん"],["は"],["すべて"],["、"],["あなた"],["の"],["子孫","しそん"],["によって"],["祝福","しゅくふく"],["を"],["得る","うる"],["。"]]},{"verse":5,"text":"アブラハムがわたしの声に聞き従い、わたしの戒めや命令、掟や教えを守ったからである。」","tok":[["アブラハム"],["が"],["わたし"],["の"],["声","こえ"],["に"],["聞き従い","ききしたがい"],["、"],["わたし"],["の"],["戒め","いましめ"],["や"],["命令","めいれい"],["、"],["掟","おきて"],["や"],["教え","おしえ"],["を"],["守った","まもった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":6,"text":"そこで、イサクはゲラルに住んだ。","tok":[["そこ"],["で"],["、"],["イサク"],["は"],["ゲラル"],["に"],["住んだ","すんだ"],["。"]]},{"verse":7,"text":"その土地の人たちがイサクの妻のことを尋ねたとき、彼は、自分の妻だと言うのを恐れて、「わたしの妹です」と答えた。リベカが美しかったので、土地の者たちがリベカのゆえに自分を殺すのではないかと思ったからである。","tok":[["その"],["土地","とち"],["の"],["人","ひと"],["たち"],["が"],["イサク"],["の"],["妻","つま"],["の"],["こと"],["を"],["尋ねた","たずねた"],["とき"],["、"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["の"],["妻","つま"],["だ"],["と"],["言う","いう"],["の"],["を"],["恐れて","おそれて"],["、"],["「"],["わたし"],["の"],["妹","いもうと"],["です"],["」"],["と"],["答えた","こたえた"],["。"],["リベカ"],["が"],["美しかった","うつくしかった"],["ので"],["、"],["土地","とち"],["の"],["者","もの"],["たち"],["が"],["リベカ"],["の"],["ゆえ"],["に"],["自分","じぶん"],["を"],["殺す","ころす"],["ので"],["は"],["ない"],["か"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"イサクは長く滞在していたが、あるとき、ペリシテ人の王アビメレクが窓から下を眺めると、イサクが妻のリベカと戯れていた。","tok":[["イサク"],["は"],["長く","ながく"],["滞在","たいざい"],["して"],["いた"],["が"],["、"],["ある"],["とき"],["、"],["ペリシテ"],["人","にん"],["の"],["王","おう"],["アビメレク"],["が"],["窓","まど"],["から"],["下","した"],["を"],["眺める","ながめる"],["と"],["、"],["イサク"],["が"],["妻","つま"],["の"],["リベカ"],["と"],["戯れて","たわむれて"],["いた"],["。"]]},{"verse":9,"text":"アビメレクは早速イサクを呼びつけて言った。「あの女は、本当はあなたの妻ではないか。それなのになぜ、『わたしの妹です』などと言ったのか。」「彼女のゆえにわたしは死ぬことになるかもしれないと思ったからです」とイサクは答えると、","tok":[["アビメレク"],["は"],["早速","さっそく"],["イサク"],["を"],["呼びつけて","よびつけて"],["言った","いった"],["。"],["「"],["あの"],["女","おんな"],["は"],["、"],["本当","ほんとう"],["は"],["あなた"],["の"],["妻","つま"],["で"],["は"],["ない"],["か"],["。"],["それ"],["な"],["のに"],["なぜ"],["、"],["『"],["わたし"],["の"],["妹","いもうと"],["です"],["』"],["など"],["と"],["言った","いった"],["の"],["か"],["。"],["」"],["「"],["彼女","かのじょ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["死ぬ","しぬ"],["こと"],["に"],["なる"],["か"],["も"],["しれない"],["と"],["思った","おもった"],["から"],["です"],["」"],["と"],["イサク"],["は"],["答える","こたえる"],["と"],["、"]]},{"verse":10,"text":"アビメレクは言った。「あなたは何ということをしたのだ。民のだれかがあなたの妻と寝たら、あなたは我々を罪に陥れるところであった。」","tok":[["アビメレク"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["何","なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["だ"],["。"],["民","たみ"],["の"],["だれ"],["か"],["が"],["あなた"],["の"],["妻","つま"],["と"],["寝たら","ねたら"],["、"],["あなた"],["は"],["我々","われわれ"],["を"],["罪","つみ"],["に"],["陥れる","おとしいれる"],["ところ"],["で"],["あった"],["。"],["」"]]},{"verse":11,"text":"アビメレクはすべての民に命令を下した。「この人、またはその妻に危害を加える者は、必ず死刑に処せられる。」","tok":[["アビメレク"],["は"],["すべて"],["の"],["民","たみ"],["に"],["命令","めいれい"],["を"],["下した","くだした"],["。"],["「"],["この"],["人","ひと"],["、"],["また"],["は"],["その"],["妻","つま"],["に"],["危害","きがい"],["を"],["加える","くわえる"],["者","もの"],["は"],["、"],["必ず","かならず"],["死刑","しけい"],["に"],["処せられる","しょせられる"],["。"],["」"]]},{"verse":12,"text":"イサクがその土地に穀物の種を蒔くと、その年のうちに百倍もの収穫があった。イサクが主の祝福を受けて、","tok":[["イサク"],["が"],["その"],["土地","とち"],["に"],["穀物","こくもつ"],["の"],["種","たね"],["を"],["蒔く","まく"],["と"],["、"],["その"],["年","とし"],["の"],["うち"],["に"],["百","ひゃく"],["倍","ばい"],["も"],["の"],["収穫","しゅうかく"],["が"],["あった"],["。"],["イサク"],["が"],["主","ぬし"],["の"],["祝福","しゅくふく"],["を"],["受けて","うけて"],["、"]]},{"verse":13,"text":"豊かになり、ますます富み栄えて、","tok":[["豊か","ゆたか"],["に"],["なり"],["、"],["ますます"],["富み栄えて","とみさかえて"],["、"]]},{"verse":14,"text":"多くの羊や牛の群れ、それに多くの召し使いを持つようになると、ペリシテ人はイサクをねたむようになった。","tok":[["多く","おおく"],["の"],["羊","ひつじ"],["や"],["牛","うし"],["の"],["群れ","むれ"],["、"],["それ"],["に"],["多く","おおく"],["の"],["召し使い","めしつかい"],["を"],["持つ","もつ"],["よう"],["に"],["なる"],["と"],["、"],["ペリシテ"],["人","にん"],["は"],["イサク"],["を"],["ねたむ"],["よう"],["に"],["なった"],["。"]]},{"verse":15,"text":"ペリシテ人は、昔、イサクの父アブラハムが僕たちに掘らせた井戸をことごとくふさぎ、土で埋めた。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["昔","むかし"],["、"],["イサク"],["の"],["父","ちち"],["アブラハム"],["が"],["僕たち","ぼくたち"],["に"],["掘らせた","ほらせた"],["井戸","いど"],["を"],["ことごとく"],["ふさぎ"],["、"],["土","つち"],["で"],["埋めた","うめた"],["。"]]},{"verse":16,"text":"アビメレクはイサクに言った。「あなたは我々と比べてあまりに強くなった。どうか、ここから出て行っていただきたい。」","tok":[["アビメレク"],["は"],["イサク"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["我々","われわれ"],["と"],["比べて","くらべて"],["あまり"],["に"],["強く","つよく"],["なった"],["。"],["どう"],["か"],["、"],["ここ"],["から"],["出て","でて"],["行って","いって"],["いただきたい"],["。"],["」"]]},{"verse":17,"text":"イサクはそこを去って、ゲラルの谷に天幕を張って住んだ。","tok":[["イサク"],["は"],["そこ"],["を"],["去って","さって"],["、"],["ゲラル"],["の"],["谷","たに"],["に"],["天幕","てんまく"],["を"],["張って","はって"],["住んだ","すんだ"],["。"]]},{"verse":18,"text":"そこにも、父アブラハムの時代に掘った井戸が幾つかあったが、アブラハムの死後、ペリシテ人がそれらをふさいでしまっていた。イサクはそれらの井戸を掘り直し、父が付けたとおりの名前を付けた。","tok":[["そこ"],["に"],["も"],["、"],["父","ちち"],["アブラハム"],["の"],["時代","じだい"],["に"],["掘った","ほった"],["井戸","いど"],["が"],["幾つ","いくつ"],["か"],["あった"],["が"],["、"],["アブラハム"],["の"],["死後","しご"],["、"],["ペリシテ"],["人","にん"],["が"],["それ"],["ら"],["を"],["ふさいで"],["しまって"],["いた"],["。"],["イサク"],["は"],["それ"],["ら"],["の"],["井戸","いど"],["を"],["掘り","ほり"],["直し","なおし"],["、"],["父","ちち"],["が"],["付けた","つけた"],["とおり"],["の"],["名前","なまえ"],["を"],["付けた","つけた"],["。"]]},{"verse":19,"text":"イサクの僕たちが谷で井戸を掘り、水が豊かに湧き出る井戸を見つけると、","tok":[["イサク"],["の"],["僕たち","ぼくたち"],["が"],["谷","たに"],["で"],["井戸","いど"],["を"],["掘り","ほり"],["、"],["水","みず"],["が"],["豊か","ゆたか"],["に"],["湧き出る","わきでる"],["井戸","いど"],["を"],["見つける","みつける"],["と"],["、"]]},{"verse":20,"text":"ゲラルの羊飼いは、「この水は我々のものだ」とイサクの羊飼いと争った。そこで、イサクはその井戸をエセク（争い）と名付けた。彼らがイサクと争ったからである。","tok":[["ゲラル"],["の"],["羊飼い","ひつじかい"],["は"],["、"],["「"],["この"],["水","みず"],["は"],["我々","われわれ"],["の"],["もの"],["だ"],["」"],["と"],["イサク"],["の"],["羊飼い","ひつじかい"],["と"],["争った","あらそった"],["。"],["そこ"],["で"],["、"],["イサク"],["は"],["その"],["井戸","いど"],["を"],["エセク"],["（"],["争い","あらそい"],["）"],["と"],["名付けた","なづけた"],["。"],["彼","かれ"],["ら"],["が"],["イサク"],["と"],["争った","あらそった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"イサクの僕たちがもう一つの井戸を掘り当てると、それについても争いが生じた。そこで、イサクはその井戸をシトナ（敵意）と名付けた。","tok":[["イサク"],["の"],["僕たち","ぼくたち"],["が"],["もう"],["一","ひと"],["つ"],["の"],["井戸","いど"],["を"],["掘り当てる","ほりあてる"],["と"],["、"],["それ"],["について"],["も"],["争い","あらそい"],["が"],["生じた","しょうじた"],["。"],["そこ"],["で"],["、"],["イサク"],["は"],["その"],["井戸","いど"],["を"],["シトナ"],["（"],["敵意","てきい"],["）"],["と"],["名付けた","なづけた"],["。"]]},{"verse":22,"text":"イサクはそこから移って、更にもう一つの井戸を掘り当てた。それについては、もはや争いは起こらなかった。イサクは、その井戸をレホボト（広い場所）と名付け、「今や、主は我々の繁栄のために広い場所をお与えになった」と言った。","tok":[["イサク"],["は"],["そこ"],["から"],["移って","うつって"],["、"],["更に","さらに"],["もう"],["一","ひと"],["つ"],["の"],["井戸","いど"],["を"],["掘り当てた","ほりあてた"],["。"],["それ"],["について"],["は"],["、"],["もはや"],["争い","あらそい"],["は"],["起こらなかった","おこらなかった"],["。"],["イサク"],["は"],["、"],["その"],["井戸","いど"],["を"],["レホボト"],["（"],["広い","ひろい"],["場所","ばしょ"],["）"],["と"],["名付け","なづけ"],["、"],["「"],["今","いま"],["や"],["、"],["主","ぬし"],["は"],["我々","われわれ"],["の"],["繁栄","はんえい"],["の"],["ため"],["に"],["広い","ひろい"],["場所","ばしょ"],["を"],["お与え","おあたえ"],["に"],["なった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":23,"text":"イサクは更に、そこからベエル‧シェバに上った。","tok":[["イサク"],["は"],["更に","さらに"],["、"],["そこ"],["から"],["ベエル"],["‧"],["シェバ"],["に"],["上った","のぼった"],["。"]]},{"verse":24,"text":"その夜、主が現れて言われた。「わたしは、あなたの父アブラハムの神である。恐れてはならない。わたしはあなたと共にいる。わたしはあなたを祝福し、子孫を増やすわが僕アブラハムのゆえに。」","tok":[["その"],["夜","よる"],["、"],["主","ぬし"],["が"],["現れて","あらわれて"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["の"],["父","ちち"],["アブラハム"],["の"],["神","かみ"],["で"],["ある"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"],["わたし"],["は"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["子孫","しそん"],["を"],["増やす","ふやす"],["わが"],["僕","ぼく"],["アブラハム"],["の"],["ゆえ"],["に"],["。"],["」"]]},{"verse":25,"text":"イサクは、そこに祭壇を築き、主の御名を呼んで礼拝した。彼はそこに天幕を張り、イサクの僕たちは井戸を掘った。","tok":[["イサク"],["は"],["、"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["呼んで","よんで"],["礼拝","れいはい"],["した"],["。"],["彼","かれ"],["は"],["そこ"],["に"],["天幕","てんまく"],["を"],["張り","はり"],["、"],["イサク"],["の"],["僕たち","ぼくたち"],["は"],["井戸","いど"],["を"],["掘った","ほった"],["。"]]},{"verse":26,"text":"アビメレクが参謀のアフザトと軍隊の長のピコルと共に、ゲラルからイサクのところに来た。","tok":[["アビメレク"],["が"],["参謀","さんぼう"],["の"],["アフザト"],["と"],["軍隊","ぐんたい"],["の"],["長","ちょう"],["の"],["ピコル"],["と"],["共","とも"],["に"],["、"],["ゲラル"],["から"],["イサク"],["の"],["ところ"],["に"],["来た","きた"],["。"]]},{"verse":27,"text":"イサクは彼らに尋ねた。「あなたたちは、わたしを憎んで追い出したのに、なぜここに来たのですか。」","tok":[["イサク"],["は"],["彼","かれ"],["ら"],["に"],["尋ねた","たずねた"],["。"],["「"],["あなた"],["たち"],["は"],["、"],["わたし"],["を"],["憎んで","にくんで"],["追い出した","おいだした"],["のに"],["、"],["なぜ"],["ここ"],["に"],["来た","きた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":28,"text":"彼らは答えた。「主があなたと共におられることがよく分かったからです。そこで考えたのですが、我々はお互いに、つまり、我々とあなたとの間で誓約を交わし、あなたと契約を結びたいのです。","tok":[["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられる"],["こと"],["が"],["よく"],["分かった","わかった"],["から"],["です"],["。"],["そこ"],["で"],["考えた","かんがえた"],["の"],["です"],["が"],["、"],["我々","われわれ"],["は"],["お互い","おたがい"],["に"],["、"],["つまり"],["、"],["我々","われわれ"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["で"],["誓約","せいやく"],["を"],["交わし","かわし"],["、"],["あなた"],["と"],["契約","けいやく"],["を"],["結びたい","むすびたい"],["の"],["です"],["。"]]},{"verse":29,"text":"以前、我々はあなたに何ら危害を加えず、むしろあなたのためになるよう計り、あなたを無事に送り出しました。そのようにあなたも、我々にいかなる害も与えないでください。あなたは確かに、主に祝福された方です。」","tok":[["以前","いぜん"],["、"],["我々","われわれ"],["は"],["あなた"],["に"],["何","なん"],["ら"],["危害","きがい"],["を"],["加えず","くわえず"],["、"],["むしろ"],["あなた"],["の"],["ため"],["に"],["なる"],["よう"],["計り","はかり"],["、"],["あなた"],["を"],["無事","ぶじ"],["に"],["送り出しました","おくりだしました"],["。"],["その"],["よう"],["に"],["あなた"],["も"],["、"],["我々","われわれ"],["に"],["いかなる"],["害","がい"],["も"],["与えないで","あたえないで"],["ください"],["。"],["あなた"],["は"],["確か","たしか"],["に"],["、"],["主に","おもに"],["祝福","しゅくふく"],["された"],["方","ほう"],["です"],["。"],["」"]]},{"verse":30,"text":"そこで、イサクは彼らのために祝宴を催し、共に飲み食いした。","tok":[["そこ"],["で"],["、"],["イサク"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["祝宴","しゅくえん"],["を"],["催し","もよおし"],["、"],["共","とも"],["に"],["飲み食い","のみくい"],["した"],["。"]]},{"verse":31,"text":"次の朝早く、互いに誓いを交わした後、イサクは彼らを送り出し、彼らは安らかに去って行った。","tok":[["次","つぎ"],["の"],["朝","あさ"],["早く","はやく"],["、"],["互い","たがい"],["に"],["誓い","ちかい"],["を"],["交わした","かわした"],["後","あと"],["、"],["イサク"],["は"],["彼","かれ"],["ら"],["を"],["送り出し","おくりだし"],["、"],["彼","かれ"],["ら"],["は"],["安らか","やすらか"],["に"],["去って","さって"],["行った","いった"],["。"]]},{"verse":32,"text":"その日に、井戸を掘っていたイサクの僕たちが帰って来て、「水が出ました」と報告した。","tok":[["その"],["日","ひ"],["に"],["、"],["井戸","いど"],["を"],["掘って","ほって"],["いた"],["イサク"],["の"],["僕たち","ぼくたち"],["が"],["帰って","かえって"],["来て","きて"],["、"],["「"],["水","みず"],["が"],["出ました","でました"],["」"],["と"],["報告","ほうこく"],["した"],["。"]]},{"verse":33,"text":"そこで、イサクはその井戸をシブア（誓い）と名付けた。そこで、その町の名は、今日に至るまで、ベエル‧シェバ（誓いの井戸）といわれている。","tok":[["そこ"],["で"],["、"],["イサク"],["は"],["その"],["井戸","いど"],["を"],["シブア"],["（"],["誓い","ちかい"],["）"],["と"],["名付けた","なづけた"],["。"],["そこ"],["で"],["、"],["その"],["町","まち"],["の"],["名","な"],["は"],["、"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["ベエル"],["‧"],["シェバ"],["（"],["誓い","ちかい"],["の"],["井戸","いど"],["）"],["と"],["いわれて"],["いる"],["。"]]},{"verse":34,"text":"エサウは、四十歳のときヘト人ベエリの娘ユディトとヘト人エロンの娘バセマトを妻として迎えた。","tok":[["エサウ"],["は"],["、"],["四十歳","よんじゅうさい"],["の"],["とき"],["ヘト人","へとにん"],["ベエリ"],["の"],["娘","むすめ"],["ユディト"],["と"],["ヘト人","へとにん"],["エロン"],["の"],["娘","むすめ"],["バセマト"],["を"],["妻","つま"],["として"],["迎えた","むかえた"],["。"]]},{"verse":35,"text":"彼女たちは、イサクとリベカにとって悩みの種となった。","tok":[["彼女","かのじょ"],["たち"],["は"],["、"],["イサク"],["と"],["リベカ"],["にとって"],["悩み","なやみ"],["の"],["種","しゅ"],["と"],["なった"],["。"]]}]
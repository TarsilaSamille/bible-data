[{"verse":1,"text":"ラケルは、ヤコブとの間に子供ができないことが分かると、姉をねたむようになり、ヤコブに向かって、「わたしにもぜひ子供を与えてください。与えてくださらなければ、わたしは死にます」と言った。","tok":[["ラケル"],["は"],["、"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["子供","こども"],["が"],["できない"],["こと"],["が"],["分かる","わかる"],["と"],["、"],["姉","あね"],["を"],["ねたむ"],["よう"],["に"],["なり"],["、"],["ヤコブ"],["に"],["向かって","むかって"],["、"],["「"],["わたし"],["に"],["も"],["ぜひ"],["子供","こども"],["を"],["与えて","あたえて"],["ください"],["。"],["与えて","あたえて"],["くださらなければ"],["、"],["わたし"],["は"],["死にます","しにます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"ヤコブは激しく怒って、言った。「わたしが神に代われると言うのか。お前の胎に子供を宿らせないのは神御自身なのだ。」","tok":[["ヤコブ"],["は"],["激しく","はげしく"],["怒って","おこって"],["、"],["言った","いった"],["。"],["「"],["わたし"],["が"],["神","かみ"],["に"],["代われる","かわれる"],["と"],["言う","いう"],["の"],["か"],["。"],["お前","おまえ"],["の"],["胎","はら"],["に"],["子供","こども"],["を"],["宿らせない","やどらせない"],["の"],["は"],["神","かみ"],["御自身","ごじしん"],["な"],["の"],["だ"],["。"],["」"]]},{"verse":3,"text":"ラケルは、「わたしの召し使いのビルハがいます。彼女のところに入ってください。彼女が子供を産み、わたしがその子を膝の上に迎えれば、彼女によってわたしも子供を持つことができます」と言った。","tok":[["ラケル"],["は"],["、"],["「"],["わたし"],["の"],["召し使い","めしつかい"],["の"],["ビルハ"],["が"],["います"],["。"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入って","はいって"],["ください"],["。"],["彼女","かのじょ"],["が"],["子供","こども"],["を"],["産み","うみ"],["、"],["わたし"],["が"],["その"],["子","こ"],["を"],["膝","ひざ"],["の"],["上","うえ"],["に"],["迎えれば","むかえれば"],["、"],["彼女","かのじょ"],["によって"],["わたし"],["も"],["子供","こども"],["を"],["持つ","もつ"],["こと"],["が"],["できます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"ラケルはヤコブに召し使いビルハを側女として与えたので、ヤコブは彼女のところに入った。","tok":[["ラケル"],["は"],["ヤコブ"],["に"],["召し使い","めしつかい"],["ビルハ"],["を"],["側女","そばめ"],["として"],["与えた","あたえた"],["ので"],["、"],["ヤコブ"],["は"],["彼女","かのじょ"],["の"],["ところ"],["に"],["入った","はいった"],["。"]]},{"verse":5,"text":"やがて、ビルハは身ごもってヤコブとの間に男の子を産んだ。","tok":[["やがて"],["、"],["ビルハ"],["は"],["身ごもって","みごもって"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":6,"text":"そのときラケルは、「わたしの訴えを神は正しくお裁き（ディン）になり、わたしの願いを聞き入れ男の子を与えてくださった」と言った。そこで、彼女はその子をダンと名付けた。","tok":[["その"],["とき"],["ラケル"],["は"],["、"],["「"],["わたし"],["の"],["訴え","うったえ"],["を"],["神","かみ"],["は"],["正しく","ただしく"],["お裁き","おさばき"],["（"],["ディン"],["）"],["に"],["なり"],["、"],["わたし"],["の"],["願い","ねがい"],["を"],["聞き入れ","ききいれ"],["男の子","おとこのこ"],["を"],["与えて","あたえて"],["くださった"],["」"],["と"],["言った","いった"],["。"],["そこ"],["で"],["、"],["彼女","かのじょ"],["は"],["その"],["子","こ"],["を"],["ダン"],["と"],["名付けた","なづけた"],["。"]]},{"verse":7,"text":"ラケルの召し使いビルハはまた身ごもって、ヤコブとの間に二人目の男の子を産んだ。","tok":[["ラケル"],["の"],["召し使い","めしつかい"],["ビルハ"],["は"],["また"],["身ごもって","みごもって"],["、"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["二人目","ふたりめ"],["の"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":8,"text":"そのときラケルは、「姉と死に物狂いの争いをして（ニフタル）、ついに勝った」と言って、その名をナフタリと名付けた。","tok":[["その"],["とき"],["ラケル"],["は"],["、"],["「"],["姉","あね"],["と"],["死に","しに"],["物狂い","ものぐるい"],["の"],["争い","あらそい"],["を"],["して"],["（"],["ニフタル"],["）"],["、"],["ついに"],["勝った","かった"],["」"],["と"],["言って","いって"],["、"],["その"],["名","な"],["を"],["ナフタリ"],["と"],["名付けた","なづけた"],["。"]]},{"verse":9,"text":"レアも自分に子供ができなくなったのを知ると、自分の召し使いジルパをヤコブに側女として与えたので、","tok":[["レア"],["も"],["自分","じぶん"],["に"],["子供","こども"],["が"],["できなく"],["なった"],["の"],["を"],["知る","しる"],["と"],["、"],["自分","じぶん"],["の"],["召し使い","めしつかい"],["ジルパ"],["を"],["ヤコブ"],["に"],["側女","そばめ"],["として"],["与えた","あたえた"],["ので"],["、"]]},{"verse":10,"text":"レアの召し使いジルパはヤコブとの間に男の子を産んだ。","tok":[["レア"],["の"],["召し使い","めしつかい"],["ジルパ"],["は"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":11,"text":"そのときレアは、「なんと幸運な（ガド）」と言って、その子をガドと名付けた。","tok":[["その"],["とき"],["レア"],["は"],["、"],["「"],["なん"],["と"],["幸運","こううん"],["な"],["（"],["ガド"],["）"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["ガド"],["と"],["名付けた","なづけた"],["。"]]},{"verse":12,"text":"レアの召し使いジルパはヤコブとの間に二人目の男の子を産んだ。","tok":[["レア"],["の"],["召し使い","めしつかい"],["ジルパ"],["は"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["二人目","ふたりめ"],["の"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":13,"text":"そのときレアは、「なんと幸せなこと（アシェル）か。娘たちはわたしを幸せ者と言うにちがいない」と言って、その子をアシェルと名付けた。","tok":[["その"],["とき"],["レア"],["は"],["、"],["「"],["なん"],["と"],["幸せ","しあわせ"],["な"],["こと"],["（"],["アシェル"],["）"],["か"],["。"],["娘","むすめ"],["たち"],["は"],["わたし"],["を"],["幸せ者","しあわせもの"],["と"],["言う","ゆう"],["に"],["ちがい"],["ない"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["アシェル"],["と"],["名付けた","なづけた"],["。"]]},{"verse":14,"text":"小麦の刈り入れのころ、ルベンは野原で恋なすびを見つけ、母レアのところへ持って来た。ラケルがレアに、「あなたの子供が取って来た恋なすびをわたしに分けてください」と言うと、","tok":[["小麦","こむぎ"],["の"],["刈り入れ","かりいれ"],["の"],["ころ"],["、"],["ルベン"],["は"],["野原","のはら"],["で"],["恋","こい"],["なすび"],["を"],["見つけ","みつけ"],["、"],["母","はは"],["レア"],["の"],["ところ"],["へ"],["持って","もって"],["来た","きた"],["。"],["ラケル"],["が"],["レア"],["に"],["、"],["「"],["あなた"],["の"],["子供","こども"],["が"],["取って","とって"],["来た","きた"],["恋","こい"],["なすび"],["を"],["わたし"],["に"],["分けて","わけて"],["ください"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":15,"text":"レアは言った。「あなたは、わたしの夫を取っただけでは気が済まず、わたしの息子の恋なすびまで取ろうとするのですか。」「それでは、あなたの子供の恋なすびの代わりに、今夜あの人があなたと床を共にするようにしましょう」とラケルは答えた。","tok":[["レア"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["わたし"],["の"],["夫","おっと"],["を"],["取った","とった"],["だけ"],["で"],["は"],["気","き"],["が"],["済まず","すまず"],["、"],["わたし"],["の"],["息子","むすこ"],["の"],["恋","こい"],["なすび"],["まで"],["取ろう","とろう"],["と"],["する"],["の"],["です"],["か"],["。"],["」"],["「"],["それ"],["で"],["は"],["、"],["あなた"],["の"],["子供","こども"],["の"],["恋","こい"],["なすび"],["の"],["代わり","かわり"],["に"],["、"],["今夜","こんや"],["あの"],["人","ひと"],["が"],["あなた"],["と"],["床","ゆか"],["を"],["共","とも"],["に"],["する"],["よう"],["に"],["しましょう"],["」"],["と"],["ラケル"],["は"],["答えた","こたえた"],["。"]]},{"verse":16,"text":"夕方になり、ヤコブが野原から帰って来ると、レアは出迎えて言った。「あなたはわたしのところに来なければなりません。わたしは、息子の恋なすびであなたを雇ったのですから。」その夜、ヤコブはレアと寝た。","tok":[["夕方","ゆうがた"],["に"],["なり"],["、"],["ヤコブ"],["が"],["野原","のはら"],["から"],["帰って","かえって"],["来る","くる"],["と"],["、"],["レア"],["は"],["出迎えて","でむかえて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["わたし"],["の"],["ところ"],["に"],["来なければ","こなければ"],["なりません"],["。"],["わたし"],["は"],["、"],["息子","むすこ"],["の"],["恋","こい"],["なすび"],["で"],["あなた"],["を"],["雇った","やとった"],["の"],["です"],["から"],["。"],["」"],["その"],["夜","よる"],["、"],["ヤコブ"],["は"],["レア"],["と"],["寝た","ねた"],["。"]]},{"verse":17,"text":"神がレアの願いを聞き入れられたので、レアは身ごもってヤコブとの間に五人目の男の子を産んだ。","tok":[["神","かみ"],["が"],["レア"],["の"],["願い","ねがい"],["を"],["聞き入れられた","ききいれられた"],["ので"],["、"],["レア"],["は"],["身ごもって","みごもって"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["五人目","ごにんめ"],["の"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":18,"text":"そのときレアは、「わたしが召し使いを夫に与えたので、神はその報酬（サカル）をくださった」と言って、その子をイサカルと名付けた。","tok":[["その"],["とき"],["レア"],["は"],["、"],["「"],["わたし"],["が"],["召し使い","めしつかい"],["を"],["夫","おっと"],["に"],["与えた","あたえた"],["ので"],["、"],["神","かみ"],["は"],["その"],["報酬（サカル）","ほうしゅう"],["を"],["くださった"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["イサカル"],["と"],["名付けた","なづけた"],["。"]]},{"verse":19,"text":"レアはまた身ごもって、ヤコブとの間に六人目の男の子を産んだ。","tok":[["レア"],["は"],["また"],["身ごもって","みごもって"],["、"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["六人目","ろくにんめ"],["の"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":20,"text":"そのときレアは、「神がすばらしい贈り物をわたしにくださった。今度こそ、夫はわたしを尊敬してくれる（ザバル）でしょう。夫のために六人も男の子を産んだのだから」と言って、その子をゼブルンと名付けた。","tok":[["その"],["とき"],["レア"],["は"],["、"],["「"],["神","かみ"],["が"],["すばらしい"],["贈り物","おくりもの"],["を"],["わたし"],["に"],["くださった"],["。"],["今度","こんど"],["こそ"],["、"],["夫","おっと"],["は"],["わたし"],["を"],["尊敬","そんけい"],["して"],["くれる"],["（"],["ザバル"],["）"],["でしょう"],["。"],["夫","おっと"],["の"],["ため"],["に"],["六人","ろくにん"],["も"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["の"],["だ"],["から"],["」"],["と"],["言って","いって"],["、"],["その"],["子","こ"],["を"],["ゼブルン"],["と"],["名付けた","なづけた"],["。"]]},{"verse":21,"text":"その後、レアは女の子を産み、その子をディナと名付けた。","tok":[["その"],["後","ご"],["、"],["レア"],["は"],["女の子","おんなのこ"],["を"],["産み","うみ"],["、"],["その"],["子","こ"],["を"],["ディナ"],["と"],["名付けた","なづけた"],["。"]]},{"verse":22,"text":"しかし、神はラケルも御心に留め、彼女の願いを聞き入れその胎を開かれたので、","tok":[["しかし"],["、"],["神","かみ"],["は"],["ラケル"],["も"],["御心","おこころ"],["に"],["留め","とめ"],["、"],["彼女","かのじょ"],["の"],["願い","ねがい"],["を"],["聞き入れ","ききいれ"],["その"],["胎","はら"],["を"],["開かれた","ひらかれた"],["ので"],["、"]]},{"verse":23,"text":"ラケルは身ごもって男の子を産んだ。そのときラケルは
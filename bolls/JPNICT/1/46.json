[{"verse":1,"text":"イスラエルは、一家を挙げて旅立った。そして、ベエル‧シェバに着くと、父イサクの神にいけにえをささげた。","tok":[["イスラエル"],["は"],["、"],["一家","いっか"],["を"],["挙げて","あげて"],["旅立った","たびだった"],["。"],["そして"],["、"],["ベエル"],["‧"],["シェバ"],["に"],["着く","つく"],["と"],["、"],["父","ちち"],["イサク"],["の"],["神","かみ"],["に"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":2,"text":"その夜、幻の中で神がイスラエルに、「ヤコブ、ヤコブ」と呼びかけた。彼が、「はい」と答えると、","tok":[["その"],["夜","よる"],["、"],["幻","まぼろし"],["の"],["中","なか"],["で"],["神","かみ"],["が"],["イスラエル"],["に"],["、"],["「"],["ヤコブ"],["、"],["ヤコブ"],["」"],["と"],["呼びかけた","よびかけた"],["。"],["彼","かれ"],["が"],["、"],["「"],["はい"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":3,"text":"神は言われた。「わたしは神、あなたの父の神である。エジプトへ下ることを恐れてはならない。わたしはあなたをそこで大いなる国民にする。","tok":[["神","かみ"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["神","かみ"],["、"],["あなた"],["の"],["父","ちち"],["の"],["神","かみ"],["で"],["ある"],["。"],["エジプト"],["へ"],["下る","くだる"],["こと"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["あなた"],["を"],["そこ"],["で"],["大いなる","おおいなる"],["国民","こくみん"],["に"],["する"],["。"]]},{"verse":4,"text":"わたしがあなたと共にエジプトへ下り、わたしがあなたを必ず連れ戻す。ヨセフがあなたのまぶたを閉じてくれるであろう。」","tok":[["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["エジプト"],["へ"],["下り","くだり"],["、"],["わたし"],["が"],["あなた"],["を"],["必ず","かならず"],["連れ戻す","つれもどす"],["。"],["ヨセフ"],["が"],["あなた"],["の"],["まぶた"],["を"],["閉じて","とじて"],["くれるで"],["あろう"],["。"],["」"]]},{"verse":5,"text":"ヤコブはベエル‧シェバを出発した。イスラエルの息子たちは、ファラオが遣わした馬車に父ヤコブと子供や妻たちを乗せた。","tok":[["ヤコブ"],["は"],["ベエル"],["‧"],["シェバ"],["を"],["出発","しゅっぱつ"],["した"],["。"],["イスラエル"],["の"],["息子","むすこ"],["たち"],["は"],["、"],["ファラオ"],["が"],["遣わした","つかわした"],["馬車","ばしゃ"],["に"],["父","ちち"],["ヤコブ"],["と"],["子供","こども"],["や"],["妻たち","つまたち"],["を"],["乗せた","のせた"],["。"]]},{"verse":6,"text":"ヤコブとその子孫は皆、カナン地方で得た家畜や財産を携えてエジプトへ向かった。","tok":[["ヤコブ"],["と"],["その"],["子孫","しそん"],["は"],["皆","みな"],["、"],["カナン"],["地方","ちほう"],["で"],["得た","えた"],["家畜","かちく"],["や"],["財産","ざいさん"],["を"],["携えて","たずさえて"],["エジプト"],["へ"],["向かった","むかった"],["。"]]},{"verse":7,"text":"こうしてヤコブは、息子や孫、娘や孫娘など、子孫を皆連れてエジプトへ行った。","tok":[["こう"],["して"],["ヤコブ"],["は"],["、"],["息子","むすこ"],["や"],["孫","まご"],["、"],["娘","むすめ"],["や"],["孫娘","まごむすめ"],["など"],["、"],["子孫","しそん"],["を"],["皆","みな"],["連れて","つれて"],["エジプト"],["へ"],["行った","いった"],["。"]]},{"verse":8,"text":"エジプトへ行ったイスラエルの人々、すなわちヤコブとその子らの名前は次のとおりである。ヤコブの長男ルベン。","tok":[["エジプト"],["へ"],["行った","いった"],["イスラエル"],["の"],["人々","ひとびと"],["、"],["すなわち"],["ヤコブ"],["と"],["その"],["子","こ"],["ら"],["の"],["名前","なまえ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ヤコブ"],["の"],["長男","ちょうなん"],["ルベン"],["。"]]},{"verse":9,"text":"ルベンの息子のハノク、パル、ヘツロン、カルミ。","tok":[["ルベン"],["の"],["息子","むすこ"],["の"],["ハノク"],["、"],["パル"],["、"],["ヘツロン"],["、"],["カルミ"],["。"]]},{"verse":10,"text":"シメオンの息子のエムエル、ヤミン、オハド、ヤキン、ツォハル、およびカナンの女による息子シャウル。","tok":[["シメオン"],["の"],["息子","むすこ"],["の"],["エムエル"],["、"],["ヤミン"],["、"],["オハド"],["、"],["ヤキン"],["、"],["ツォハル"],["、"],["および"],["カナン"],["の"],["女","おんな"],["に"],["よる"],["息子","むすこ"],["シャウル"],["。"]]},{"verse":11,"text":"レビの息子のゲルション、ケハト、メラリ。","tok":[["レビ"],["の"],["息子","むすこ"],["の"],["ゲルション"],["、"],["ケハト"],["、"],["メラリ"],["。"]]},{"verse":12,"text":"ユダの息子のエル、オナン、シェラ、ペレツ、ゼラ。ただし、エルとオナンはカナンの土地で死んだ。ペレツの息子のヘツロン、ハムル。","tok":[["ユダ"],["の"],["息子","むすこ"],["の"],["エル"],["、"],["オナン"],["、"],["シェラ"],["、"],["ペレツ"],["、"],["ゼラ"],["。"],["ただし"],["、"],["エル"],["と"],["オナン"],["は"],["カナン"],["の"],["土地","とち"],["で"],["死んだ","しんだ"],["。"],["ペレツ"],["の"],["息子","むすこ"],["の"],["ヘツロン"],["、"],["ハムル"],["。"]]},{"verse":13,"text":"イサカルの息子のトラ、プワ、ヨブ、シムロン。","tok":[["イサカル"],["の"],["息子","むすこ"],["の"],["トラ"],["、"],["プワ"],["、"],["ヨブ"],["、"],["シムロン"],["。"]]},{"verse":14,"text":"ゼブルンの息子のセレド、エロン、ヤフレエル。","tok":[["ゼブルン"],["の"],["息子","むすこ"],["の"],["セレド"],["、"],["エロン"],["、"],["ヤフレエル"],["。"]]},{"verse":15,"text":"これらは、レアがパダン‧アラムでヤコブとの間に産んだ子らである。ヤコブの娘ディナも含め、男女の総数は三十三名である。","tok":[["これ"],["ら"],["は"],["、"],["レア"],["が"],["パダン"],["‧"],["アラム"],["で"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["産んだ","うんだ"],["子","こ"],["ら"],["で"],["ある"],["。"],["ヤコブ"],["の"],["娘","むすめ"],["ディナ"],["も"],["含め","ふくめ"],["、"],["男女","だんじょ"],["の"],["総数","そうすう"],["は"],["三十三","さんじゅうさん"],["名","めい"],["で"],["ある"],["。"]]},{"verse":16,"text":"ガドの息子のツィフヨン、ハギ、シュニ、エツボン、エリ、アロディ、アルエリ。","tok":[["ガド"],["の"],["息子","むすこ"],["の"],["ツィフヨン"],["、"],["ハギ"],["、"],["シュニ"],["、"],["エツボン"],["、"],["エリ"],["、"],["アロディ"],["、"],["アルエリ"],["。"]]},{"verse":17,"text":"アシェルの息子のイムナ、イシュワ、イシュビ、ベリア、および妹セラ。ベリアの息子はヘベル、マルキエル。","tok":[["アシェル"],["の"],["息子","むすこ"],["の"],["イムナ"],["、"],["イシュワ"],["、"],["イシュビ"],["、"],["ベリア"],["、"],["および"],["妹","いもうと"],["セラ"],["。"],["ベリア"],["の"],["息子","むすこ"],["は"],["ヘベル"],["、"],["マルキエル"],["。"]]},{"verse":18,"text":"これらは、ラバンが娘レアに与えたジルパの子らである。ジルパがヤコブとの間に産んだのは十六名である。","tok":[["これ"],["ら"],["は"],["、"],["ラバン"],["が"],["娘","むすめ"],["レア"],["に"],["与えた","あたえた"],["ジルパ"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"],["ジルパ"],["が"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["産んだ","うんだ"],["の"],["は"],["十六","じゅうろく"],["名","めい"],["で"],["ある"],["。"]]},{"verse":19,"text":"ヤコブの妻ラケルの息子のヨセフ、ベニヤミン。","tok":[["ヤコブ"],["の"],["妻","つま"],["ラケル"],["の"],["息子","むすこ"],["の"],["ヨセフ"],["、"],["ベニヤミン"],["。"]]},{"verse":20,"text":"ヨセフには、エジプトの国で息子が生まれた。それは、オンの祭司のポティ‧フェラの娘アセナトが彼との間に産んだマナセとエフライムである。","tok":[["ヨセフ"],["に"],["は"],["、"],["エジプト"],["の"],["国","くに"],["で"],["息子","むすこ"],["が"],["生まれた","うまれた"],["。"],["それ"],["は"],["、"],["オン"],["の"],["祭司","さいし"],["の"],["ポティ"],["‧"],["フェラ"],["の"],["娘","むすめ"],["アセナト"],["が"],["彼","かれ"],["と"],["の"],["間","あいだ"],["に"],["産んだ","うんだ"],["マナセ"],["と"],["エフライム"],["で"],["ある"],["。"]]},{"verse":21,"text":"ベニヤミンの息子のベラ、ベケル、アシュベル、ゲラ、ナアマン、エヒ、ロシュ、ムピム、フピム、アルド。","tok":[["ベニヤミン"],["の"],["息子","むすこ"],["の"],["ベラ"],["、"],["ベケル"],["、"],["アシュベル"],["、"],["ゲラ"],["、"],["ナアマン"],["、"],["エヒ"],["、"],["ロシュ"],["、"],["ムピム"],["、"],["フピム"],["、"],["アルド"],["。"]]},{"verse":22,"text":"これらは、ヤコブとの間に生まれたラケルの子らで、その総数は十四名である。","tok":[["これ"],["ら"],["は"],["、"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["生まれた","うまれた"],["ラケル"],["の"],["子","こ"],["ら"],["で"],["、"],["その"],["総数","そうすう"],["は"],["十四","じゅうよん"],["名","めい"],["で"],["ある"],["。"]]},{"verse":23,"text":"ダンの息子のフシム。","tok":[["ダン"],["の"],["息子","むすこ"],["の"],["フシム"],["。"]]},{"verse":24,"text":"ナフタリの息子のヤフツェエル、グニ、イエツェル、シレム。","tok":[["ナフタリ"],["の"],["息子","むすこ"],["の"],["ヤフツェエル"],["、"],["グニ"],["、"],["イエツェル"],["、"],["シレム"],["。"]]},{"verse":25,"text":"これらは、ラバンが娘ラケルに与えたビルハの子らである。ビルハがヤコブとの間に産んだ者の総数は七名である。","tok":[["これ"],["ら"],["は"],["、"],["ラバン"],["が"],["娘","むすめ"],["ラケル"],["に"],["与えた","あたえた"],["ビルハ"],["の"],["子","こ"],["ら"],["で"],["ある"],["。"],["ビルハ"],["が"],["ヤコブ"],["と"],["の"],["間","あいだ"],["に"],["産んだ","うんだ"],["者","もの"],["の"],["総数","そうすう"],["は"],["七","なな"],["名","めい"],["で"],["ある"],["。"]]},{"verse":26,"text":"ヤコブの腰から出た者で、ヤコブと共にエジプトへ行った者は、ヤコブの息子の妻たちを除けば、総数六十六名である。","tok":[["ヤコブ"],["の"],["腰","こし"],["から"],["出た","でた"],["者","もの"],["で"],["、"],["ヤコブ"],["と"],["共","とも"],["に"],["エジプト"],["へ"],["行った","いった"],["者","もの"],["は"],["、"],["ヤコブ"],["の"],["息子","むすこ"],["の"],["妻たち","つまたち"],["を"],["除けば","のぞけば"],["、"],["総数","そうすう"],["六十六","ろくじゅうろく"],["名","めい"],["で"],["ある"],["。"]]},{"verse":27,"text":"エジプトで生まれたヨセフの息子は二人である。従って、エジプトへ行ったヤコブの家族は総数七十名であった。","tok":[["エジプト"],["で"],["生まれた","うまれた"],["ヨセフ"],["の"],["息子","むすこ"],["は"],["二人","ふたり"],["で"],["ある"],["。"],["従って","したがって"],["、"],["エジプト"],["へ"],["行った","いった"],["ヤコブ"],["の"],["家族","かぞく"],["は"],["総数","そうすう"],["七十","ななじゅう"],["名","めい"],["で"],["あった"],["。"]]},{"verse":28,"text":"ヤコブは、ヨセフをゴシェンに連れて来るために、ユダを一足先にヨセフのところへ遣わした。そして一行はゴシェンの地に到着した。","tok":[["ヤコブ"],["は"],["、"],["ヨセフ"],["を"],["ゴシェン"],["に"],["連れて","つれて"],["来る","くる"],["ため"],["に"],["、"],["ユダ"],["を"],["一足先","ひとあしさき"],["に"],["ヨセフ"],["の"],["ところ"],["へ"],["遣わした","つかわした"],["。"],["そして"],["一行","いっこう"],["は"],["ゴシェン"],["の"],["地","ち"],["に"],["到着","とうちゃく"],["した"],["。"]]},{"verse":29,"text":"ヨセフは車を用意させると、父イスラエルに会いにゴシェンへやって来た。ヨセフは父を見るやいなや、父の首に抱きつき、その首にすがったまま、しばらく泣き続けた。","tok":[["ヨセフ"],["は"],["車","くるま"],["を"],["用意","ようい"],["させる"],["と"],["、"],["父","ちち"],["イスラエル"],["に"],["会い","あい"],["に"],["ゴシェン"],["へ"],["やって"],["来た","きた"],["。"],["ヨセフ"],["は"],["父","ちち"],["を"],["見る","みる"],["や"],["いな"],["や"],["、"],["父","ちち"],["の"],["首","くび"],["に"],["抱きつき","だきつき"],["、"],["その"],["首","くび"],["に"],["すがった"],["まま"],["、"],["しばらく"],["泣き","なき"],["続けた","つづけた"],["。"]]},{"verse":30,"text":"イスラエルはヨセフに言った。「わたしはもう死んでもよい。お前がまだ生きていて、お前の顔を見ることができたのだから。」","tok":[["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["もう"],["死んで","しんで"],["も"],["よい"],["。"],["お前","おまえ"],["が"],["まだ"],["生きて","いきて"],["いて"],["、"],["お前","おまえ"],["の"],["顔","かお"],["を"],["見る","みる"],["こと"],["が"],["できた"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":31,"text":"ヨセフは、兄弟や父の家族の者たちに言った。「わたしはファラオのところへ報告のため参上し、『カナン地方にいたわたしの兄弟と父の家族の者たちがわたしのところに参りました。","tok":[["ヨセフ"],["は"],["、"],["兄弟","きょうだい"],["や"],["父","ちち"],["の"],["家族","かぞく"],["の"],["者","もの"],["たち"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["ファラオ"],["の"],["ところ"],["へ"],["報告","ほうこく"],["の"],["ため"],["参上","さんじょう"],["し"],["、"],["『"],["カナン"],["地方","ちほう"],["に"],["いた"],["わたし"],["の"],["兄弟","きょうだい"],["と"],["父","ちち"],["の"],["家族","かぞく"],["の"],["者","もの"],["たち"],["が"],["わたし"],["の"],["ところ"],["に"],["参りました","まいりました"],["。"]]},{"verse":32,"text":"この人たちは羊飼いで、家畜の群れを飼っていたのですが、羊や牛をはじめ、すべての財産を携えてやって来ました』と申します。","tok":[["この"],["人","ひと"],["たち"],["は"],["羊飼い","ひつじかい"],["で"],["、"],["家畜","かちく"],["の"],["群れ","むれ"],["を"],["飼って","かって"],["いた"],["の"],["です"],["が"],["、"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["はじめ"],["、"],["すべて"],["の"],["財産","ざいさん"],["を"],["携えて","たずさえて"],["やって"],["来ました","きました"],["』"],["と"],["申します","もうします"],["。"]]},{"verse":33,"text":"ですから、ファラオがあなたたちをお召しになって、『仕事は何か』と言われたら、","tok":[["です"],["から"],["、"],["ファラオ"],["が"],["あなた"],["たち"],["を"],["お召し","おめし"],["に"],["なって"],["、"],["『"],["仕事","しごと"],["は"],["何","なん"],["か"],["』"],["と"],["言われたら","いわれたら"],["、"]]},{"verse":34,"text":"『あなたの僕であるわたしどもは、先祖代々、幼い時から今日まで家畜の群れを飼う者でございます』と答えてください。そうすれば、あなたたちはゴシェンの地域に住むことができるでしょう。」羊飼いはすべて、エジプト人のいとうものであったのである。","tok":[["『"],["あなた"],["の"],["僕","ぼく"],["で"],["ある"],["わたし"],["ども"],["は"],["、"],["先祖","せんぞ"],["代々","だいだい"],["、"],["幼い","おさない"],["時","とき"],["から"],["今日","きょう"],["まで"],["家畜","かちく"],["の"],["群れ","むれ"],["を"],["飼う","かう"],["者","もの"],["で"],["ございます"],["』"],["と"],["答えて","こたえて"],["ください"],["。"],["そう"],["すれば"],["、"],["あなた"],["たち"],["は"],["ゴシェン"],["の"],["地域","ちいき"],["に"],["住む","すむ"],["こと"],["が"],["できるでしょう"],["。"],["」"],["羊飼い","ひつじかい"],["は"],["すべて"],["、"],["エジプト"],["人","にん"],["の"],["いとう"],["もの"],["で"],["あった"],["ので"],["ある"],["。"]]}]
[{"verse":1,"text":"神は、ノアと彼と共に箱舟にいたすべての獣とすべての家畜を御心に留め、地の上に風を吹かせられたので、水が減り始めた。","tok":[["神","かみ"],["は"],["、"],["ノア"],["と"],["彼","かれ"],["と"],["共","とも"],["に"],["箱舟","はこぶね"],["に"],["いた"],["すべて"],["の"],["獣","けもの"],["と"],["すべて"],["の"],["家畜","かちく"],["を"],["御心","おこころ"],["に"],["留め","とめ"],["、"],["地","ち"],["の"],["上","うえ"],["に"],["風","かぜ"],["を"],["吹かせられた","ふかせられた"],["ので"],["、"],["水","みず"],["が"],["減り","へり"],["始めた","はじめた"],["。"]]},{"verse":2,"text":"また、深淵の源と天の窓が閉じられたので、天からの雨は降りやみ、","tok":[["また"],["、"],["深淵","しんえん"],["の"],["源","みなもと"],["と"],["天","てん"],["の"],["窓","まど"],["が"],["閉じられた","とじられた"],["ので"],["、"],["天","てん"],["から"],["の"],["雨","あめ"],["は"],["降りやみ","ふりやみ"],["、"]]},{"verse":3,"text":"水は地上からひいて行った。百五十日の後には水が減って、","tok":[["水","みず"],["は"],["地上","ちじょう"],["から"],["ひいて"],["行った","いった"],["。"],["百五十日","ひゃくごとうか"],["の"],["後","あと"],["に"],["は"],["水","みず"],["が"],["減って","へって"],["、"]]},{"verse":4,"text":"第七の月の十七日に箱舟はアララト山の上に止まった。","tok":[["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["十七","じゅうなな"],["日","にち"],["に"],["箱舟","はこぶね"],["は"],["アララト"],["山","やま"],["の"],["上","うえ"],["に"],["止まった","とまった"],["。"]]},{"verse":5,"text":"水はますます減って第十の月になり、第十の月の一日には山々の頂が現れた。","tok":[["水","みず"],["は"],["ますます"],["減って","へって"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["に"],["なり"],["、"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["は"],["山々","やまやま"],["の"],["頂","いただき"],["が"],["現れた","あらわれた"],["。"]]},{"verse":6,"text":"四十日たって、ノアは自分が造った箱舟の窓を開き、","tok":[["四十日","よんとうか"],["たって"],["、"],["ノア"],["は"],["自分","じぶん"],["が"],["造った","つくった"],["箱舟","はこぶね"],["の"],["窓","まど"],["を"],["開き","ひらき"],["、"]]},{"verse":7,"text":"烏を放した。烏は飛び立ったが、地上の水が乾くのを待って、出たり入ったりした。","tok":[["烏","からす"],["を"],["放した","はなした"],["。"],["烏","からす"],["は"],["飛び立った","とびたった"],["が"],["、"],["地上","ちじょう"],["の"],["水","みず"],["が"],["乾く","かわく"],["の"],["を"],["待って","まって"],["、"],["出","で"],["たり"],["入っ","はいっ"],["たり"],["した"],["。"]]},{"verse":8,"text":"ノアは鳩を彼のもとから放して、地の面から水がひいたかどうかを確かめようとした。","tok":[["ノア"],["は"],["鳩","はと"],["を"],["彼","かれ"],["の"],["もと"],["から"],["放して","はなして"],["、"],["地","ち"],["の"],["面","めん"],["から"],["水","みず"],["が"],["ひいた"],["か"],["どう"],["か"],["を"],["確かめよう","たしかめよう"],["と"],["した"],["。"]]},{"verse":9,"text":"しかし、鳩は止まる所が見つからなかったので、箱舟のノアのもとに帰って来た。水がまだ全地の面を覆っていたからである。ノアは手を差し伸べて鳩を捕らえ、箱舟の自分のもとに戻した。","tok":[["しかし"],["、"],["鳩","はと"],["は"],["止まる","とまる"],["所","ところ"],["が"],["見つからなかった","みつからなかった"],["ので"],["、"],["箱舟","はこぶね"],["の"],["ノア"],["の"],["もと"],["に"],["帰って","かえって"],["来た","きた"],["。"],["水","みず"],["が"],["まだ"],["全地","ぜんち"],["の"],["面","めん"],["を"],["覆って","おおって"],["いた"],["から"],["で"],["ある"],["。"],["ノア"],["は"],["手","て"],["を"],["差し伸べて","さしのべて"],["鳩","はと"],["を"],["捕らえ","とらえ"],["、"],["箱舟","はこぶね"],["の"],["自分","じぶん"],["の"],["もと"],["に"],["戻した","もどした"],["。"]]},{"verse":10,"text":"更に七日待って、彼は再び鳩を箱舟から放した。","tok":[["更に","さらに"],["七","なな"],["日","にち"],["待って","まって"],["、"],["彼","かれ"],["は"],["再び","ふたたび"],["鳩","はと"],["を"],["箱舟","はこぶね"],["から"],["放した","はなした"],["。"]]},{"verse":11,"text":"鳩は夕方になってノアのもとに帰って来た。見よ、鳩はくちばしにオリーブの葉をくわえていた。ノアは水が地上からひいたことを知った。","tok":[["鳩","はと"],["は"],["夕方","ゆうがた"],["に"],["なって"],["ノア"],["の"],["もと"],["に"],["帰って","かえって"],["来た","きた"],["。"],["見よ","みよ"],["、"],["鳩","はと"],["は"],["くちばし"],["に"],["オリーブ"],["の"],["葉","は"],["を"],["くわえて"],["いた"],["。"],["ノア"],["は"],["水","みず"],["が"],["地上","ちじょう"],["から"],["ひいた"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":12,"text":"彼は更に七日待って、鳩を放した。鳩はもはやノアのもとに帰って来なかった。","tok":[["彼","かれ"],["は"],["更に","さらに"],["七","なな"],["日","にち"],["待って","まって"],["、"],["鳩","はと"],["を"],["放した","はなした"],["。"],["鳩","はと"],["は"],["もはや"],["ノア"],["の"],["もと"],["に"],["帰って","かえって"],["来なかった","こなかった"],["。"]]},{"verse":13,"text":"ノアが六百一歳のとき、最初の月の一日に、地上の水は乾いた。ノアは箱舟の覆いを取り外して眺めた。見よ、地の面は乾いていた。","tok":[["ノア"],["が"],["六百一歳","ろくひゃくいちさい"],["の"],["とき"],["、"],["最初","さいしょ"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["に"],["、"],["地上","ちじょう"],["の"],["水","みず"],["は"],["乾いた","かわいた"],["。"],["ノア"],["は"],["箱舟","はこぶね"],["の"],["覆い","おおい"],["を"],["取り外して","とりはずして"],["眺めた","ながめた"],["。"],["見よ","みよ"],["、"],["地","ち"],["の"],["面","めん"],["は"],["乾いて","かわいて"],["いた"],["。"]]},{"verse":14,"text":"第二の月の二十七日になると、地はすっかり乾いた。","tok":[["第","だい"],["二","に"],["の"],["月","つき"],["の"],["二十七","にじゅうなな"],["日","にち"],["に"],["なる"],["と"],["、"],["地","ち"],["は"],["すっかり"],["乾いた","かわいた"],["。"]]},{"verse":15,"text":"神はノアに仰せになった。","tok":[["神","かみ"],["は"],["ノア"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":16,"text":"「さあ、あなたもあなたの妻も、息子も嫁も、皆一緒に箱舟から出なさい。","tok":[["「"],["さあ"],["、"],["あなた"],["も"],["あなた"],["の"],["妻","つま"],["も"],["、"],["息子","むすこ"],["も"],["嫁","よめ"],["も"],["、"],["皆","みな"],["一緒","いっしょ"],["に"],["箱舟","はこぶね"],["から"],["出","で"],["なさい"],["。"]]},{"verse":17,"text":"すべて肉なるもののうちからあなたのもとに来たすべての動物、鳥も家畜も地を這うものも一緒に連れ出し、地に群がり、地上で子を産み、増えるようにしなさい。」","tok":[["すべて"],["肉","にく"],["なる"],["もの"],["の"],["うち"],["から"],["あなた"],["の"],["もと"],["に"],["来た","きた"],["すべて"],["の"],["動物","どうぶつ"],["、"],["鳥","とり"],["も"],["家畜","かちく"],["も"],["地","ち"],["を"],["這う","はう"],["もの"],["も"],["一緒","いっしょ"],["に"],["連れ出し","つれだし"],["、"],["地","ち"],["に"],["群がり","むらがり"],["、"],["地上","ちじょう"],["で"],["子","こ"],["を"],["産み","うみ"],["、"],["増える","ふえる"],["よう"],["に"],["し"],["なさい"],["。"],["」"]]},{"verse":18,"text":"そこで、ノアは息子や妻や嫁と共に外へ出た。","tok":[["そこ"],["で"],["、"],["ノア"],["は"],["息子","むすこ"],["や"],["妻","つま"],["や"],["嫁","よめ"],["と"],["共","とも"],["に"],["外","そと"],["へ"],["出た","でた"],["。"]]},{"verse":19,"text":"獣、這うもの、鳥、地に群がるもの、それぞれすべて箱舟から出た。","tok":[["獣","けもの"],["、"],["這う","はう"],["もの"],["、"],["鳥","とり"],["、"],["地","ち"],["に"],["群がる","むらがる"],["もの"],["、"],["それぞれ"],["すべて"],["箱舟","はこぶね"],["から"],["出た","でた"],["。"]]},{"verse":20,"text":"ノアは主のために祭壇を築いた。そしてすべての清い家畜と清い鳥のうちから取り、焼き尽くす献げ物として祭壇の上にささげた。","tok":[["ノア"],["は"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"],["そして"],["すべて"],["の"],["清い","きよい"],["家畜","かちく"],["と"],["清い","きよい"],["鳥","とり"],["の"],["うち"],["から"],["取り","とり"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["として"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["ささげた"],["。"]]},{"verse":21,"text":"主は宥めの香りをかいで、御心に言われた。「人に対して大地を呪うことは二度とすまい。人が心に思うことは、幼いときから悪いのだ。わたしは、この度したように生き物をことごとく打つことは、二度とすまい。","tok":[["主","ぬし"],["は"],["宥め","なだめ"],["の"],["香り","かおり"],["を"],["かいで"],["、"],["御心","おこころ"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["に対して","にたいして"],["大地","だいち"],["を"],["呪う","のろう"],["こと"],["は"],["二","に"],["度","ど"],["と"],["すまい"],["。"],["人","ひと"],["が"],["心","こころ"],["に"],["思う","おもう"],["こと"],["は"],["、"],["幼い","おさない"],["とき"],["から"],["悪い","わるい"],["の"],["だ"],["。"],["わたし"],["は"],["、"],["この"],["度した","どした"],["よう"],["に"],["生き物","いきもの"],["を"],["ことごとく"],["打つ","うつ"],["こと"],["は"],["、"],["二","に"],["度","ど"],["と"],["すまい"],["。"]]},{"verse":22,"text":"地の続くかぎり、種蒔きも刈り入れも寒さも暑さも、夏も冬も昼も夜も、やむことはない。」","tok":[["地","ち"],["の"],["続く","つづく"],["かぎり"],["、"],["種蒔き","たねまき"],["も"],["刈り入れ","かりいれ"],["も"],["寒さ","さむさ"],["も"],["暑さ","あつさ"],["も"],["、"],["夏","なつ"],["も"],["冬","ふゆ"],["も"],["昼","ひる"],["も"],["夜","よる"],["も"],["、"],["やむ"],["こと"],["は"],["ない"],["。"],["」"]]}]
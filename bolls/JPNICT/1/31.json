[{"verse":1,"text":"ヤコブは、ラバンの息子たちが、「ヤコブは我々の父のものを全部奪ってしまった。父のものをごまかして、あの富を築き上げたのだ」と言っているのを耳にした。","tok":[["ヤコブ"],["は"],["、"],["ラバン"],["の"],["息子","むすこ"],["たち"],["が"],["、"],["「"],["ヤコブ"],["は"],["我々","われわれ"],["の"],["父","ちち"],["の"],["もの"],["を"],["全部","ぜんぶ"],["奪って","うばって"],["しまった"],["。"],["父","ちち"],["の"],["もの"],["を"],["ごまかして"],["、"],["あの"],["富","とみ"],["を"],["築き上げた","きずきあげた"],["の"],["だ"],["」"],["と"],["言って","いって"],["いる"],["の"],["を"],["耳","みみ"],["に"],["した"],["。"]]},{"verse":2,"text":"また、ラバンの態度を見ると、確かに以前とは変わっていた。","tok":[["また"],["、"],["ラバン"],["の"],["態度","たいど"],["を"],["見る","みる"],["と"],["、"],["確か","たしか"],["に"],["以前","いぜん"],["と"],["は"],["変わって","かわって"],["いた"],["。"]]},{"verse":3,"text":"主はヤコブに言われた。「あなたは、あなたの故郷である先祖の土地に帰りなさい。わたしはあなたと共にいる。」","tok":[["主","ぬし"],["は"],["ヤコブ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["、"],["あなた"],["の"],["故郷","こきょう"],["で"],["ある"],["先祖","せんぞ"],["の"],["土地","とち"],["に"],["帰り","かえり"],["なさい"],["。"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"],["」"]]},{"verse":4,"text":"ヤコブは人をやって、ラケルとレアを家畜の群れがいる野原に呼び寄せて、","tok":[["ヤコブ"],["は"],["人","ひと"],["を"],["やって"],["、"],["ラケル"],["と"],["レア"],["を"],["家畜","かちく"],["の"],["群れ","むれ"],["が"],["いる"],["野原","のはら"],["に"],["呼び寄せて","よびよせて"],["、"]]},{"verse":5,"text":"言った。「最近、気づいたのだが、あなたたちのお父さんは、わたしに対して以前とは態度が変わった。しかし、わたしの父の神は、ずっとわたしと共にいてくださった。","tok":[["言った","いった"],["。"],["「"],["最近","さいきん"],["、"],["気づいた","きづいた"],["の"],["だ"],["が"],["、"],["あなた"],["たち"],["の"],["お父さん","おとうさん"],["は"],["、"],["わたし"],["に対して","にたいして"],["以前","いぜん"],["と"],["は"],["態度","たいど"],["が"],["変わった","かわった"],["。"],["しかし"],["、"],["わたし"],["の"],["父","ちち"],["の"],["神","かみ"],["は"],["、"],["ずっと"],["わたし"],["と"],["共","とも"],["に"],["いて"],["くださった"],["。"]]},{"verse":6,"text":"あなたたちも知っているように、わたしは全力を尽くしてあなたたちのお父さんのもとで働いてきたのに、","tok":[["あなた"],["たち"],["も"],["知って","しって"],["いる"],["よう"],["に"],["、"],["わたし"],["は"],["全力","ぜんりょく"],["を"],["尽くして","つくして"],["あなた"],["たち"],["の"],["お父さん","おとうさん"],["の"],["もと"],["で"],["働いて","はたらいて"],["きた"],["のに"],["、"]]},{"verse":7,"text":"わたしをだまして、わたしの報酬を十回も変
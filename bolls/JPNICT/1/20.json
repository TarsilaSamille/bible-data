[{"verse":1,"text":"アブラハムは、そこからネゲブ地方へ移り、カデシュとシュルの間に住んだ。ゲラルに滞在していたとき、","tok":[["アブラハム"],["は"],["、"],["そこ"],["から"],["ネゲブ"],["地方","ちほう"],["へ"],["移り","うつり"],["、"],["カデシュ"],["と"],["シュル"],["の"],["間","あいだ"],["に"],["住んだ","すんだ"],["。"],["ゲラル"],["に"],["滞在","たいざい"],["して"],["いた"],["とき"],["、"]]},{"verse":2,"text":"アブラハムは妻サラのことを、「これはわたしの妹です」と言ったので、ゲラルの王アビメレクは使いをやってサラを召し入れた。","tok":[["アブラハム"],["は"],["妻","つま"],["サラ"],["の"],["こと"],["を"],["、"],["「"],["これ"],["は"],["わたし"],["の"],["妹","いもうと"],["です"],["」"],["と"],["言った","いった"],["ので"],["、"],["ゲラル"],["の"],["王","おう"],["アビメレク"],["は"],["使い","つかい"],["を"],["やって"],["サラ"],["を"],["召し入れた","めしいれた"],["。"]]},{"verse":3,"text":"その夜、夢の中でアビメレクに神が現れて言われた。「あなたは、召し入れた女のゆえに死ぬ。その女は夫のある身だ。」","tok":[["その"],["夜","よる"],["、"],["夢","ゆめ"],["の"],["中","なか"],["で"],["アビメレク"],["に"],["神","かみ"],["が"],["現れて","あらわれて"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["、"],["召し入れた","めしいれた"],["女","おんな"],["の"],["ゆえ"],["に"],["死ぬ","しぬ"],["。"],["その"],["女","おんな"],["は"],["夫","おっと"],["の"],["ある"],["身","み"],["だ"],["。"],["」"]]},{"verse":4,"text":"アビメレクは、まだ彼女に近づいていなかったので、「主よ、あなたは正しい者でも殺されるのですか。","tok":[["アビメレク"],["は"],["、"],["まだ"],["彼女","かのじょ"],["に"],["近づいて","ちかづいて"],["いなかった"],["ので"],["、"],["「"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["正しい","ただしい"],["者","もの"],["で"],["も"],["殺される","ころされる"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"彼女が妹だと言ったのは彼ではありませんか。また彼女自身も、『あの人はわたしの兄です』と言いました。わたしは、全くやましい考えも不正な手段でもなくこの事をしたのです」と言った。","tok":[["彼女","かのじょ"],["が"],["妹","いもうと"],["だ"],["と"],["言った","いった"],["の"],["は"],["彼","かれ"],["で"],["は"],["ありません"],["か"],["。"],["また"],["彼女","かのじょ"],["自身","じしん"],["も"],["、"],["『"],["あの"],["人","ひと"],["は"],["わたし"],["の"],["兄","あに"],["です"],["』"],["と"],["言いました","いいました"],["。"],["わたし"],["は"],["、"],["全く","まったく"],["やましい"],["考え","かんがえ"],["も"],["不正","ふせい"],["な"],["手段","しゅだん"],["で"],["も"],["なく"],["この"],["事","こと"],["を"],["した"],["の"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"神は夢の中でアビメレクに言われた。「わたしも、あなたが全くやましい考えでなしにこの事をしたことは知っている。だからわたしも、あなたがわたしに対して罪を犯すことのないように、彼女に触れさせなかったのだ。","tok":[["神","かみ"],["は"],["夢","ゆめ"],["の"],["中","なか"],["で"],["アビメレク"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["も"],["、"],["あなた"],["が"],["全く","まったく"],["やましい"],["考え","かんがえ"],["で"],["なし"],["に"],["この"],["事","こと"],["を"],["した"],["こと"],["は"],["知って","しって"],["いる"],["。"],["だ"],["から"],["わたし"],["も"],["、"],["あなた"],["が"],["わたし"],["に対して","にたいして"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["彼女","かのじょ"],["に"],["触れさせなかった","ふれさせなかった"],["の"],["だ"],["。"]]},{"verse":7,"text":"直ちに、あの人の妻を返しなさい。彼は預言者だから、あなたのために祈り、命を救ってくれるだろう。しかし、もし返さなければ、あなたもあなたの家来も皆、必ず死ぬことを覚悟せねばならない。」","tok":[["直ちに","ただちに"],["、"],["あの"],["人","ひと"],["の"],["妻","つま"],["を"],["返し","かえし"],["なさい"],["。"],["彼","かれ"],["は"],["預言者","よげんしゃ"],["だ"],["から"],["、"],["あなた"],["の"],["ため"],["に"],["祈り","いのり"],["、"],["命","いのち"],["を"],["救って","すくって"],["くれるだろう"],["。"],["しかし"],["、"],["もし"],["返さなければ","かえさなければ"],["、"],["あなた"],["も"],["あなた"],["の"],["家来","けらい"],["も"],["皆","みな"],["、"],["必ず","かならず"],["死ぬ","しぬ"],["こと"],["を"],["覚悟","かくご"],["せねば"],["ならない"],["。"],["」"]]},{"verse":8,"text":"次の朝早く、アビメレクは家来たちを残らず呼び集め、一切の出来事を語り聞かせたので、一同は非常に恐れた。","tok":[["次","つぎ"],["の"],["朝","あさ"],["早く","はやく"],["、"],["アビメレク"],["は"],["家来","けらい"],["たち"],["を"],["残らず","のこらず"],["呼び集め","よびあつめ"],["、"],["一切","いっさい"],["の"],["出来事","できごと"],["を"],["語り聞かせた","かたりきかせた"],["ので"],["、"],["一同","いちどう"],["は"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":9,"text":"アビメレクはそれから、アブラハムを呼んで言った。「あなたは我々に何ということをしたのか。わたしがあなたにどんな罪を犯したというので、あなたはわたしとわたしの王国に大それた罪を犯させようとしたのか。あなたは、してはならぬことをわたしにしたのだ。」","tok":[["アビメレク"],["は"],["それ"],["から"],["、"],["アブラハム"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["あなた"],["は"],["我々","われわれ"],["に"],["何","なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["か"],["。"],["わたし"],["が"],["あなた"],["に"],["どんな"],["罪","つみ"],["を"],["犯した","おかした"],["と"],["いう"],["ので"],["、"],["あなた"],["は"],["わたし"],["と"],["わたし"],["の"],["王国","おうこく"],["に"],["大それた","だいそれた"],["罪","つみ"],["を"],["犯させよう","おかさせよう"],["と"],["した"],["の"],["か"],["。"],["あなた"],["は"],["、"],["して"],["は"],["ならぬ"],["こと"],["を"],["わたし"],["に"],["した"],["の"],["だ"],["。"],["」"]]},{"verse":10,"text":"アビメレクは更に、アブラハムに言った。「どういうつもりで、こんなことをしたのか。」","tok":[["アビメレク"],["は"],["更に","さらに"],["、"],["アブラハム"],["に"],["言った","いった"],["。"],["「"],["どういう"],["つもり"],["で"],["、"],["こんな"],["こと"],["を"],["した"],["の"],["か"],["。"],["」"]]},{"verse":11,"text":"アブラハムは答えた。「この土地には、神を畏れることが全くないので、わたしは妻のゆえに殺されると思ったのです。","tok":[["アブラハム"],["は"],["答えた","こたえた"],["。"],["「"],["この"],["土地","とち"],["に"],["は"],["、"],["神","かみ"],["を"],["畏れる","おそれる"],["こと"],["が"],["全く","まったく"],["ない"],["ので"],["、"],["わたし"],["は"],["妻","つま"],["の"],["ゆえ"],["に"],["殺される","ころされる"],["と"],["思った","おもった"],["の"],["です"],["。"]]},{"verse":12,"text":"事実、彼女は、わたしの妹でもあるのです。わたしの父の娘ですが、母の娘ではないのです。それで、わたしの妻となったのです。","tok":[["事実","じじつ"],["、"],["彼女","かのじょ"],["は"],["、"],["わたし"],["の"],["妹","いもうと"],["で"],["も"],["ある"],["の"],["です"],["。"],["わたし"],["の"],["父","ちち"],["の"],["娘","むすめ"],["です"],["が"],["、"],["母","はは"],["の"],["娘","むすめ"],["で"],["は"],["ない"],["の"],["です"],["。"],["それ"],["で"],["、"],["わたし"],["の"],["妻","つま"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":13,"text":"かつて、神がわたしを父の家から離して、さすらいの旅に出されたとき、わたしは妻に、『わたしに尽くすと思って、どこへ行っても、わたしのことを、この人は兄ですと言ってくれないか』と頼んだのです。」","tok":[["かつて"],["、"],["神","かみ"],["が"],["わたし"],["を"],["父","ちち"],["の"],["家","いえ"],["から"],["離して","はなして"],["、"],["さすらい"],["の"],["旅","たび"],["に"],["出された","だされた"],["とき"],["、"],["わたし"],["は"],["妻","つま"],["に"],["、"],["『"],["わたし"],["に"],["尽くす","つくす"],["と"],["思って","おもって"],["、"],["どこ"],["へ"],["行って","いって"],["も"],["、"],["わたし"],["の"],["こと"],["を"],["、"],["この"],["人","ひと"],["は"],["兄","あに"],["です"],["と"],["言って","いって"],["くれない"],["か"],["』"],["と"],["頼んだ","たのんだ"],["の"],["です"],["。"],["」"]]},{"verse":14,"text":"アビメレクは羊、牛、男女の奴隷などを取ってアブラハムに与え、また、妻サラを返して、","tok":[["アビメレク"],["は"],["羊","ひつじ"],["、"],["牛","うし"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["など"],["を"],["取って","とって"],["アブラハム"],["に"],["与え","あたえ"],["、"],["また"],["、"],["妻","つま"],["サラ"],["を"],["返して","かえして"],["、"]]},{"verse":15,"text":"言った。「この辺りはすべてわたしの領土です。好きな所にお住まいください。」","tok":[["言った","いった"],["。"],["「"],["この"],["辺り","あたり"],["は"],["すべて"],["わたし"],["の"],["領土","りょうど"],["です"],["。"],["好き","すき"],["な"],["所","ところ"],["に"],["お住まい","おすまい"],["ください"],["。"],["」"]]},{"verse":16,"text":"また、サラに言った。「わたしは、銀一千シェケルをあなたの兄上に贈りました。それは、あなたとの間のすべての出来事の疑惑を晴らす証拠です。これであなたの名誉は取り戻されるでしょう。」","tok":[["また"],["、"],["サラ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["、"],["銀一","ぎんいち"],["千","せん"],["シェケル"],["を"],["あなた"],["の"],["兄上","あにじょう"],["に"],["贈りました","おくりました"],["。"],["それ"],["は"],["、"],["あなた"],["と"],["の"],["間","あいだ"],["の"],["すべて"],["の"],["出来事","できごと"],["の"],["疑惑","ぎわく"],["を"],["晴らす","はらす"],["証拠","しょうこ"],["です"],["。"],["これ"],["で"],["あなた"],["の"],["名誉","めいよ"],["は"],["取り戻されるでしょう","とりもどされるでしょう"],["。"],["」"]]},{"verse":17,"text":"アブラハムが神に祈ると、神はアビメレクとその妻、および侍女たちをいやされたので、再び子供を産むことができるようになった。","tok":[["アブラハム"],["が"],["神","かみ"],["に"],["祈る","いのる"],["と"],["、"],["神","かみ"],["は"],["アビメレク"],["と"],["その"],["妻","つま"],["、"],["および"],["侍女","じじょ"],["たち"],["を"],["いやされた"],["ので"],["、"],["再び","ふたたび"],["子供","こども"],["を"],["産む","うむ"],["こと"],["が"],["できる"],["よう"],["に"],["なった"],["。"]]},{"verse":18,"text":"主がアブラハムの妻サラのゆえに、アビメレクの宮廷のすべての女たちの胎を堅く閉ざしておられたからである。","tok":[["主","ぬし"],["が"],["アブラハム"],["の"],["妻","つま"],["サラ"],["の"],["ゆえ"],["に"],["、"],["アビメレク"],["の"],["宮廷","きゅうてい"],["の"],["すべて"],["の"],["女","おんな"],["たち"],["の"],["胎","はら"],["を"],["堅く","かたく"],["閉ざして","とざして"],["おられた"],["から"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"アブラムが九十九歳になったとき、主はアブラムに現れて言われた。「わたしは全能の神である。あなたはわたしに従って歩み、全き者となりなさい。","tok":[["アブラム"],["が"],["九十九歳","きゅうじゅうきゅうさい"],["に"],["なった"],["とき"],["、"],["主","ぬし"],["は"],["アブラム"],["に"],["現れて","あらわれて"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["全能","ぜんのう"],["の"],["神","かみ"],["で"],["ある"],["。"],["あなた"],["は"],["わたし"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"],["全","ぜん"],["き"],["者","もの"],["と"],["なり"],["なさい"],["。"]]},{"verse":2,"text":"わたしは、あなたとの間にわたしの契約を立て、あなたをますます増やすであろう。」","tok":[["わたし"],["は"],["、"],["あなた"],["と"],["の"],["間","あいだ"],["に"],["わたし"],["の"],["契約","けいやく"],["を"],["立て","たて"],["、"],["あなた"],["を"],["ますます"],["増やすで","ふやすで"],["あろう"],["。"],["」"]]},{"verse":3,"text":"アブラムはひれ伏した。神は更に、語りかけて言われた。","tok":[["アブラム"],["は"],["ひれ伏した","ひれふした"],["。"],["神","かみ"],["は"],["更に","さらに"],["、"],["語りかけて","かたりかけて"],["言われた","いわれた"],["。"]]},{"verse":4,"text":"「これがあなたと結ぶわたしの契約である。あなたは多くの国民の父となる。","tok":[["「"],["これ"],["が"],["あなた"],["と"],["結ぶ","むすぶ"],["わたし"],["の"],["契約","けいやく"],["で"],["ある"],["。"],["あなた"],["は"],["多く","おおく"],["の"],["国民","こくみん"],["の"],["父","ちち"],["と"],["なる"],["。"]]},{"verse":5,"text":"あなたは、もはやアブラムではなく、アブラハムと名乗りなさい。あなたを多くの国民の父とするからである。","tok":[["あなた"],["は"],["、"],["もはや"],["アブラム"],["で"],["は"],["なく"],["、"],["アブラハム"],["と"],["名乗り","なのり"],["なさい"],["。"],["あなた"],["を"],["多く","おおく"],["の"],["国民","こくみん"],["の"],["父","ちち"],["と"],["する"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"わたしは、あなたをますます繁栄させ、諸国民の父とする。王となる者たちがあなたから出るであろう。","tok":[["わたし"],["は"],["、"],["あなた"],["を"],["ますます"],["繁栄","はんえい"],["させ"],["、"],["諸","しょ"],["国民","こくみん"],["の"],["父","ちち"],["と"],["する"],["。"],["王","おう"],["と"],["なる"],["者","もの"],["たち"],["が"],["あなた"],["から"],["出るで","でるで"],["あろう"],["。"]]},{"verse":7,"text":"わたしは、あなたとの間に、また後に続く子孫との間に契約を立て、それを永遠の契約とする。そして、あなたとあなたの子孫の神となる。","tok":[["わたし"],["は"],["、"],["あなた"],["と"],["の"],["間","あいだ"],["に"],["、"],["また"],["後","あと"],["に"],["続く","つづく"],["子孫","しそん"],["と"],["の"],["間","あいだ"],["に"],["契約","けいやく"],["を"],["立て","たて"],["、"],["それ"],["を"],["永遠","えいえん"],["の"],["契約","けいやく"],["と"],["する"],["。"],["そして"],["、"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":8,"text":"わたしは、あなたが滞在しているこのカナンのすべての土地を、あなたとその子孫に、永久の所有地として与える。わたしは彼らの神となる。」","tok":[["わたし"],["は"],["、"],["あなた"],["が"],["滞在","たいざい"],["して"],["いる"],["この"],["カナン"],["の"],["すべて"],["の"],["土地","とち"],["を"],["、"],["あなた"],["と"],["その"],["子孫","しそん"],["に"],["、"],["永久","えいきゅう"],["の"],["所有地","しょゆうち"],["として"],["与える","あたえる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"],["」"]]},{"verse":9,"text":"神はまた、アブラハムに言われた。「だからあなたも、わたしの契約を守りなさい、あなたも後に続く子孫も。","tok":[["神","かみ"],["は"],["また"],["、"],["アブラハム"],["に"],["言われた","いわれた"],["。"],["「"],["だ"],["から"],["あなた"],["も"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["守り","まもり"],["なさい"],["、"],["あなた"],["も"],["後","あと"],["に"],["続く","つづく"],["子孫","しそん"],["も"],["。"]]},{"verse":10,"text":"あなたたち、およびあなたの後に続く子孫と、わたしとの間で守るべき契約はこれである。すなわち、あなたたちの男子はすべて、割礼を受ける。","tok":[["あなた"],["たち"],["、"],["および"],["あなた"],["の"],["後","あと"],["に"],["続く","つづく"],["子孫","しそん"],["と"],["、"],["わたし"],["と"],["の"],["間","あいだ"],["で"],["守るべき","まもるべき"],["契約","けいやく"],["は"],["これ"],["で"],["ある"],["。"],["すなわち"],["、"],["あなた"],["たち"],["の"],["男子","だんし"],["は"],["すべて"],["、"],["割礼","かつれい"],["を"],["受ける","うける"],["。"]]},{"verse":11,"text":"包皮の部分を切り取りなさい。これが、わたしとあなたたちとの間の契約のしるしとなる。","tok":[["包皮","ほうひ"],["の"],["部分","ぶぶん"],["を"],["切り取り","きりとり"],["なさい"],["。"],["これ"],["が"],["、"],["わたし"],["と"],["あなた"],["たち"],["と"],["の"],["間","あいだ"],["の"],["契約","けいやく"],["の"],["しるし"],["と"],["なる"],["。"]]},{"verse":12,"text":"いつの時代でも、あなたたちの男子はすべて、直系の子孫はもちろんのこと、家で生まれた奴隷も、外国人から買い取った奴隷であなたの子孫でない者も皆、生まれてから八日目に割礼を受けなければならない。","tok":[["いつ"],["の"],["時代","じだい"],["で"],["も"],["、"],["あなた"],["たち"],["の"],["男子","だんし"],["は"],["すべて"],["、"],["直系","ちょっけい"],["の"],["子孫","しそん"],["は"],["もちろん"],["の"],["こと"],["、"],["家","いえ"],["で"],["生まれた","うまれた"],["奴隷","どれい"],["も"],["、"],["外国人","がいこくじん"],["から"],["買い取った","かいとった"],["奴隷","どれい"],["で"],["あなた"],["の"],["子孫","しそん"],["で"],["ない"],["者","もの"],["も"],["皆","みな"],["、"],["生まれて","うまれて"],["から"],["八日目","ようかめ"],["に"],["割礼","かつれい"],["を"],["受けなければ","うけなければ"],["ならない"],["。"]]},{"verse":13,"text":"あなたの家で生まれた奴隷も、買い取った奴隷も、必ず割礼を受けなければならない。それによって、わたしの契約はあなたの体に記されて永遠の契約となる。","tok":[["あなた"],["の"],["家","いえ"],["で"],["生まれた","うまれた"],["奴隷","どれい"],["も"],["、"],["買い取った","かいとった"],["奴隷","どれい"],["も"],["、"],["必ず","かならず"],["割礼","かつれい"],["を"],["受けなければ","うけなければ"],["ならない"],["。"],["それ"],["によって"],["、"],["わたし"],["の"],["契約","けいやく"],["は"],["あなた"],["の"],["体","からだ"],["に"],["記されて","しるされて"],["永遠","えいえん"],["の"],["契約","けいやく"],["と"],["なる"],["。"]]},{"verse":14,"text":"包皮の部分を切り取らない無割礼の男がいたなら、その人は民の間から断たれる。わたしの契約を破ったからである。」","tok":[["包皮","ほうひ"],["の"],["部分","ぶぶん"],["を"],["切り取らない","きりとらない"],["無","む"],["割礼","かつれい"],["の"],["男","おとこ"],["が"],["いたなら"],["、"],["その"],["人","ひと"],["は"],["民","みん"],["の"],["間","あいだ"],["から"],["断たれる","たたれる"],["。"],["わたし"],["の"],["契約","けいやく"],["を"],["破った","やぶった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":15,"text":"神はアブラハムに言われた。「あなたの妻サライは、名前をサライではなく、サラと呼びなさい。","tok":[["神","かみ"],["は"],["アブラハム"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["妻","つま"],["サライ"],["は"],["、"],["名前","なまえ"],["を"],["サライ"],["で"],["は"],["なく"],["、"],["サラ"],["と"],["呼び","よび"],["なさい"],["。"]]},{"verse":16,"text":"わたしは彼女を祝福し、彼女によってあなたに男の子を与えよう。わたしは彼女を祝福し、諸国民の母とする。諸民族の王となる者たちが彼女から出る。」","tok":[["わたし"],["は"],["彼女","かのじょ"],["を"],["祝福","しゅくふく"],["し"],["、"],["彼女","かのじょ"],["によって"],["あなた"],["に"],["男の子","おとこのこ"],["を"],["与えよう","あたえよう"],["。"],["わたし"],["は"],["彼女","かのじょ"],["を"],["祝福","しゅくふく"],["し"],["、"],["諸","しょ"],["国民","こくみん"],["の"],["母","はは"],["と"],["する"],["。"],["諸","しょ"],["民族","みんぞく"],["の"],["王","おう"],["と"],["なる"],["者","もの"],["たち"],["が"],["彼女","かのじょ"],["から"],["出る","でる"],["。"],["」"]]},{"verse":17,"text":"アブラハムはひれ伏した。しかし笑って、ひそかに言った。「百歳の男に子供が生まれるだろうか。九十歳のサラに子供が産めるだろうか。」","tok":[["アブラハム"],["は"],["ひれ伏した","ひれふした"],["。"],["しかし"],["笑って","わらって"],["、"],["ひそか"],["に"],["言った","いった"],["。"],["「"],["百歳","ひゃくさい"],["の"],["男","おとこ"],["に"],["子供","こども"],["が"],["生まれるだろう","うまれるだろう"],["か"],["。"],["九十歳","きゅうじゅうさい"],["の"],["サラ"],["に"],["子供","こども"],["が"],["産めるだろう","うめるだろう"],["か"],["。"],["」"]]},{"verse":18,"text":"アブラハムは神に言った。「どうか、イシュマエルが御前に生き永らえますように。」","tok":[["アブラハム"],["は"],["神","かみ"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["イシュマエル"],["が"],["御前","ごぜん"],["に"],["生き永らえます","いきながらえます"],["よう"],["に"],["。"],["」"]]},{"verse":19,"text":"神は言われた。「いや、あなたの妻サラがあなたとの間に男の子を産む。その子をイサク（彼は笑う）と名付けなさい。わたしは彼と契約を立て、彼の子孫のために永遠の契約とする。","tok":[["神","かみ"],["は"],["言われた","いわれた"],["。"],["「"],["いや"],["、"],["あなた"],["の"],["妻","つま"],["サラ"],["が"],["あなた"],["と"],["の"],["間","あいだ"],["に"],["男の子","おとこのこ"],["を"],["産む","うむ"],["。"],["その"],["子","こ"],["を"],["イサク"],["（"],["彼","かれ"],["は"],["笑う","わらう"],["）"],["と"],["名付け","なづけ"],["なさい"],["。"],["わたし"],["は"],["彼","かれ"],["と"],["契約","けいやく"],["を"],["立て","たて"],["、"],["彼","かれ"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["永遠","えいえん"],["の"],["契約","けいやく"],["と"],["する"],["。"]]},{"verse":20,"text":"イシュマエルについての願いも聞き入れよう。必ず、わたしは彼を祝福し、大いに子供を増やし繁栄させる。彼は十二人の首長の父となろう。わたしは彼を大いなる国民とする。","tok":[["イシュマエル"],["について"],["の"],["願い","ねがい"],["も"],["聞き入れよう","ききいれよう"],["。"],["必ず","かならず"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["祝福","しゅくふく"],["し"],["、"],["大いに","おおいに"],["子供","こども"],["を"],["増やし","ふやし"],["繁栄","はんえい"],["させる"],["。"],["彼","かれ"],["は"],["十二人","じゅうににん"],["の"],["首長","しゅちょう"],["の"],["父","ちち"],["と"],["なろう"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["と"],["する"],["。"]]},{"verse":21,"text":"しかし、わたしの契約は、来年の今ごろ、サラがあなたとの間に産むイサクと立てる。」","tok":[["しかし"],["、"],["わたし"],["の"],["契約","けいやく"],["は"],["、"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["、"],["サラ"],["が"],["あなた"],["と"],["の"],["間","あいだ"],["に"],["産む","うむ"],["イサク"],["と"],["立てる","たてる"],["。"],["」"]]},{"verse":22,"text":"神はこう語り終えると、アブラハムを離れて昇って行かれた。","tok":[["神","かみ"],["は"],["こう"],["語り","かたり"],["終える","おえる"],["と"],["、"],["アブラハム"],["を"],["離れて","はなれて"],["昇って","のぼって"],["行かれた","いかれた"],["。"]]},{"verse":23,"text":"アブラハムは、息子のイシュマエルをはじめ、家で生まれた奴隷や買い取った奴隷など、自分の家にいる人々のうち、男子を皆集めて、すぐその日に、神が命じられたとおり包皮に割礼を施した。","tok":[["アブラハム"],["は"],["、"],["息子","むすこ"],["の"],["イシュマエル"],["を"],["はじめ"],["、"],["家","いえ"],["で"],["生まれた","うまれた"],["奴隷","どれい"],["や"],["買い取った","かいとった"],["奴隷","どれい"],["など"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["いる"],["人々","ひとびと"],["の"],["うち"],["、"],["男子","だんし"],["を"],["皆","みな"],["集めて","あつめて"],["、"],["すぐ"],["その"],["日","ひ"],["に"],["、"],["神","かみ"],["が"],["命じられた","めいじられた"],["とおり"],["包皮","ほうひ"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["。"]]},{"verse":24,"text":"アブラハムが包皮に割礼を受けたのは、九十九歳、","tok":[["アブラハム"],["が"],["包皮","ほうひ"],["に"],["割礼","かつれい"],["を"],["受けた","うけた"],["の"],["は"],["、"],["九十九歳","きゅうじゅうきゅうさい"],["、"]]},{"verse":25,"text":"息子イシュマエルが包皮に割礼を受けたのは、十三歳であった。","tok":[["息子","むすこ"],["イシュマエル"],["が"],["包皮","ほうひ"],["に"],["割礼","かつれい"],["を"],["受けた","うけた"],["の"],["は"],["、"],["十三歳","じゅうさんさい"],["で"],["あった"],["。"]]},{"verse":26,"text":"アブラハムと息子のイシュマエルは、すぐその日に割礼を受けた。","tok":[["アブラハム"],["と"],["息子","むすこ"],["の"],["イシュマエル"],["は"],["、"],["すぐ"],["その"],["日","ひ"],["に"],["割礼","かつれい"],["を"],["受けた","うけた"],["。"]]},{"verse":27,"text":"アブラハムの家の男子は、家で生まれた奴隷も外国人から買い取った奴隷も皆、共に割礼を受けた。","tok":[["アブラハム"],["の"],["家","いえ"],["の"],["男子","だんし"],["は"],["、"],["家","いえ"],["で"],["生まれた","うまれた"],["奴隷","どれい"],["も"],["外国人","がいこくじん"],["から"],["買い取った","かいとった"],["奴隷","どれい"],["も"],["皆","みな"],["、"],["共","とも"],["に"],["割礼","かつれい"],["を"],["受けた","うけた"],["。"]]}]
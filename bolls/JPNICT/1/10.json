[{"verse":1,"text":"ノアの息子、セム、ハム、ヤフェトの系図は次のとおりである。洪水の後、彼らに息子が生まれた。","tok":[["ノア"],["の"],["息子","むすこ"],["、"],["セム"],["、"],["ハム"],["、"],["ヤフェト"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["洪水","こうずい"],["の"],["後","あと"],["、"],["彼","かれ"],["ら"],["に"],["息子","むすこ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":2,"text":"ヤフェトの子孫はゴメル、マゴグ、メディア、ヤワン、トバル、メシェク、ティラスであった。","tok":[["ヤフェト"],["の"],["子孫","しそん"],["は"],["ゴメル"],["、"],["マゴグ"],["、"],["メディア"],["、"],["ヤワン"],["、"],["トバル"],["、"],["メシェク"],["、"],["ティラス"],["で"],["あった"],["。"]]},{"verse":3,"text":"ゴメルの子孫は、アシュケナズ、リファト、トガルマであった。","tok":[["ゴメル"],["の"],["子孫","しそん"],["は"],["、"],["アシュケナズ"],["、"],["リファト"],["、"],["トガルマ"],["で"],["あった"],["。"]]},{"verse":4,"text":"ヤワンの子孫は、エリシャ、タルシシュ、キティム、ロダニムであった。","tok":[["ヤワン"],["の"],["子孫","しそん"],["は"],["、"],["エリシャ"],["、"],["タルシシュ"],["、"],["キティム"],["、"],["ロダニム"],["で"],["あった"],["。"]]},{"verse":5,"text":"海沿いの国々は、彼らから出て、それぞれの地に、その言語、氏族、民族に従って住むようになった。","tok":[["海沿い","うみぞい"],["の"],["国々","くにぐに"],["は"],["、"],["彼","かれ"],["ら"],["から"],["出て","でて"],["、"],["それぞれ"],["の"],["地","ち"],["に"],["、"],["その"],["言語","げんご"],["、"],["氏族","しぞく"],["、"],["民族","みんぞく"],["に"],["従って","したがって"],["住む","すむ"],["よう"],["に"],["なった"],["。"]]},{"verse":6,"text":"ハムの子孫は、クシュ、エジプト、プト、カナンであった。","tok":[["ハム"],["の"],["子孫","しそん"],["は"],["、"],["クシュ"],["、"],["エジプト"],["、"],["プト"],["、"],["カナン"],["で"],["あった"],["。"]]},{"verse":7,"text":"クシュの子孫はセバ、ハビラ、サブタ、ラマ、サブテカであり、ラマの子孫はシェバとデダンであった。","tok":[["クシュ"],["の"],["子孫","しそん"],["は"],["セバ"],["、"],["ハビラ"],["、"],["サブタ"],["、"],["ラマ"],["、"],["サブテカ"],["で"],["あり"],["、"],["ラマ"],["の"],["子孫","しそん"],["は"],["シェバ"],["と"],["デダン"],["で"],["あった"],["。"]]},{"verse":8,"text":"クシュにはまた、ニムロドが生まれた。ニムロドは地上で最初の勇士となった。","tok":[["クシュ"],["に"],["は"],["また"],["、"],["ニムロド"],["が"],["生まれた","うまれた"],["。"],["ニムロド"],["は"],["地上","ちじょう"],["で"],["最初","さいしょ"],["の"],["勇士","ゆうし"],["と"],["なった"],["。"]]},{"verse":9,"text":"彼は、主の御前に勇敢な狩人であり、「主の御前に勇敢な狩人ニムロドのようだ」という言い方がある。","tok":[["彼","かれ"],["は"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["勇敢","ゆうかん"],["な"],["狩人","かりゅうど"],["で"],["あり"],["、"],["「"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["勇敢","ゆうかん"],["な"],["狩人","かりゅうど"],["ニムロド"],["の"],["よう"],["だ"],["」"],["と"],["いう"],["言い方","いいかた"],["が"],["ある"],["。"]]},{"verse":10,"text":"彼の王国の主な町は、バベル、ウルク、アッカドであり、それらはすべてシンアルの地にあった。","tok":[["彼","かれ"],["の"],["王国","おうこく"],["の"],["主な","おもな"],["町","まち"],["は"],["、"],["バベル"],["、"],["ウルク"],["、"],["アッカド"],["で"],["あり"],["、"],["それ"],["ら"],["は"],["すべて"],["シンアル"],["の"],["地","ち"],["に"],["あった"],["。"]]},{"verse":11,"text":"彼はその地方からアッシリアに進み、ニネベ、レホボト‧イル、カラ、","tok":[["彼","かれ"],["は"],["その"],["地方","ちほう"],["から"],["アッシリア"],["に"],["進み","すすみ"],["、"],["ニネベ"],["、"],["レホボト"],["‧"],["イル"],["、"],["カラ"],["、"]]},{"verse":12,"text":"レセンを建てた。レセンはニネベとカラとの間にある、非常に大きな町であった。","tok":[["レセン"],["を"],["建てた","たてた"],["。"],["レセン"],["は"],["ニネベ"],["と"],["カラ"],["と"],["の"],["間","あいだ"],["に"],["ある"],["、"],["非常","ひじょう"],["に"],["大きな","おおきな"],["町","まち"],["で"],["あった"],["。"]]},{"verse":13,"text":"エジプトにはリディア人、アナミム人、レハビム人、ナフトヒム人、","tok":[["エジプト"],["に"],["は"],["リディア"],["人","にん"],["、"],["アナミム"],["人","にん"],["、"],["レハビム"],["人","にん"],["、"],["ナフトヒム"],["人","にん"],["、"]]},{"verse":14,"text":"上エジプト人、カスルヒム人、カフトル人が生まれた。このカフトル人からペリシテ人が出た。","tok":[["上","うえ"],["エジプト"],["人","にん"],["、"],["カスルヒム"],["人","にん"],["、"],["カフトル"],["人","にん"],["が"],["生まれた","うまれた"],["。"],["この"],["カフトル"],["人","にん"],["から"],["ペリシテ"],["人","にん"],["が"],["出た","でた"],["。"]]},{"verse":15,"text":"カナンには長男シドンとヘト、","tok":[["カナン"],["に"],["は"],["長男","ちょうなん"],["シドン"],["と"],["ヘト"],["、"]]},{"verse":16,"text":"また、エブス人、アモリ人、ギルガシ人、","tok":[["また"],["、"],["エブス人","えぶすにん"],["、"],["アモリ人","あもりにん"],["、"],["ギルガシ"],["人","にん"],["、"]]},{"verse":17,"text":"ヒビ人、アルキ人、シニ人、","tok":[["ヒビ人","ひびにん"],["、"],["アルキ人","あるきにん"],["、"],["シニ人","しににん"],["、"]]},{"verse":18,"text":"アルワド人、ツェマリ人、ハマト人が生まれた。その後、カナン人の諸氏族が広がった。","tok":[["アルワド"],["人","にん"],["、"],["ツェマリ"],["人","にん"],["、"],["ハマト"],["人","ひと"],["が"],["生まれた","うまれた"],["。"],["その"],["後","ご"],["、"],["カナン人","かなんにん"],["の"],["諸","しょ"],["氏族","しぞく"],["が"],["広がった","ひろがった"],["。"]]},{"verse":19,"text":"カナン人の領土は、シドンから南下してゲラルを経てガザまでを含み、更に、ソドム、ゴモラ、アドマ、ツェボイムを経てラシャまでを含んだ。","tok":[["カナン人","かなんにん"],["の"],["領土","りょうど"],["は"],["、"],["シドン"],["から"],["南下","なんか"],["して"],["ゲラル"],["を"],["経て","へて"],["ガザ"],["まで"],["を"],["含み","ふくみ"],["、"],["更に","さらに"],["、"],["ソドム"],["、"],["ゴモラ"],["、"],["アドマ"],["、"],["ツェボイム"],["を"],["経て","へて"],["ラシャ"],["まで"],["を"],["含んだ","ふくんだ"],["。"]]},{"verse":20,"text":"これらが、氏族、言語、地域、民族ごとにまとめたハムの子孫である。","tok":[["これ"],["ら"],["が"],["、"],["氏族","しぞく"],["、"],["言語","げんご"],["、"],["地域","ちいき"],["、"],["民族","みんぞく"],["ごと"],["に"],["まとめた"],["ハム"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":21,"text":"セムにもまた子供が生まれた。彼はエベルのすべての子孫の先祖であり、ヤフェトの兄であった。","tok":[["セム"],["に"],["も"],["また"],["子供","こども"],["が"],["生まれた","うまれた"],["。"],["彼","かれ"],["は"],["エベル"],["の"],["すべて"],["の"],["子孫","しそん"],["の"],["先祖","せんぞ"],["で"],["あり"],["、"],["ヤフェト"],["の"],["兄","あに"],["で"],["あった"],["。"]]},{"verse":22,"text":"セムの子孫はエラム、アシュル、アルパクシャド、ルド、アラムであった。","tok":[["セム"],["の"],["子孫","しそん"],["は"],["エラム"],["、"],["アシュル"],["、"],["アルパクシャド"],["、"],["ルド"],["、"],["アラム"],["で"],["あった"],["。"]]},{"verse":23,"text":"アラムの子孫は、ウツ、フル、ゲテル、マシュであった。","tok":[["アラム"],["の"],["子孫","しそん"],["は"],["、"],["ウツ"],["、"],["フル"],["、"],["ゲテル"],["、"],["マシュ"],["で"],["あった"],["。"]]},{"verse":24,"text":"アルパクシャドにはシェラが生まれ、シェラにはエベルが生まれた。","tok":[["アルパクシャド"],["に"],["は"],["シェラ"],["が"],["生まれ","うまれ"],["、"],["シェラ"],["に"],["は"],["エベル"],["が"],["生まれた","うまれた"],["。"]]},{"verse":25,"text":"エベルには二人の息子が生まれた。ひとりの名は、その時代に土地が分けられた（パラグ）ので、ペレグといい、その兄弟はヨクタンといった。","tok":[["エベル"],["に"],["は"],["二人","ふたり"],["の"],["息子","むすこ"],["が"],["生まれた","うまれた"],["。"],["ひとり"],["の"],["名","な"],["は"],["、"],["その"],["時代","じだい"],["に"],["土地","とち"],["が"],["分けられた","わけられた"],["（"],["パラグ"],["）"],["ので"],["、"],["ペレグ"],["と"],["いい"],["、"],["その"],["兄弟","きょうだい"],["は"],["ヨクタン"],["と"],["いった"],["。"]]},{"verse":26,"text":"ヨクタンには、アルモダド、シェレフ、ハツァルマベト、イエラ、","tok":[["ヨクタン"],["に"],["は"],["、"],["アルモダド"],["、"],["シェレフ"],["、"],["ハツァルマベト"],["、"],["イエラ"],["、"]]},{"verse":27,"text":"ハドラム、ウザル、ディクラ、","tok":[["ハドラム"],["、"],["ウザル"],["、"],["ディクラ"],["、"]]},{"verse":28,"text":"オバル、アビマエル、シェバ、","tok":[["オバル"],["、"],["アビマエル"],["、"],["シェバ"],["、"]]},{"verse":29,"text":"オフィル、ハビラ、ヨバブが生まれた。これらは皆、ヨクタンの息子であった。","tok":[["オフィル"],["、"],["ハビラ"],["、"],["ヨバブ"],["が"],["生まれた","うまれた"],["。"],["これ"],["ら"],["は"],["皆","みな"],["、"],["ヨクタン"],["の"],["息子","むすこ"],["で"],["あった"],["。"]]},{"verse":30,"text":"彼らはメシャからセファルに至る東の高原地帯に住んでいた。","tok":[["彼","かれ"],["ら"],["は"],["メシャ"],["から"],["セファル"],["に"],["至る","いたる"],["東","ひがし"],["の"],["高原","こうげん"],["地帯","ちたい"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":31,"text":"これらが、氏族、言語、地域、民族ごとにまとめたセムの子孫である。","tok":[["これ"],["ら"],["が"],["、"],["氏族","しぞく"],["、"],["言語","げんご"],["、"],["地域","ちいき"],["、"],["民族","みんぞく"],["ごと"],["に"],["まとめた"],["セム"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":32,"text":"ノアの子孫である諸氏族を、民族ごとの系図にまとめると以上のようになる。地上の諸民族は洪水の後、彼らから分かれ出た。","tok":[["ノア"],["の"],["子孫","しそん"],["で"],["ある"],["諸","しょ"],["氏族","しぞく"],["を"],["、"],["民族","みんぞく"],["ごと"],["の"],["系図","けいず"],["に"],["まとめる"],["と"],["以上","いじょう"],["の"],["よう"],["に"],["なる"],["。"],["地上","ちじょう"],["の"],["諸","しょ"],["民族","みんぞく"],["は"],["洪水","こうずい"],["の"],["後","あと"],["、"],["彼","かれ"],["ら"],["から"],["分かれ出た","わかれでた"],["。"]]}]
[{"verse":1,"text":"二人の御使いが夕方ソドムに着いたとき、ロトはソドムの門の所に座っていた。ロトは彼らを見ると、立ち上がって迎え、地にひれ伏して、","tok":[["二人","ふたり"],["の"],["御使い","おつかい"],["が"],["夕方","ゆうがた"],["ソドム"],["に"],["着いた","ついた"],["とき"],["、"],["ロト"],["は"],["ソドム"],["の"],["門","もん"],["の"],["所","ところ"],["に"],["座って","すわって"],["いた"],["。"],["ロト"],["は"],["彼","かれ"],["ら"],["を"],["見る","みる"],["と"],["、"],["立ち上がって","たちあがって"],["迎え","むかえ"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["、"]]},{"verse":2,"text":"言った。「皆様方、どうぞ僕の家に立ち寄り、足を洗ってお泊まりください。そして、明日の朝早く起きて出立なさってください。」彼らは言った。「いや、結構です。わたしたちはこの広場で夜を過ごします。」","tok":[["言った","いった"],["。"],["「"],["皆様","みなさま"],["方","かた"],["、"],["どうぞ"],["僕","ぼく"],["の"],["家","いえ"],["に"],["立ち寄り","たちより"],["、"],["足","あし"],["を"],["洗って","あらって"],["お泊まり","おとまり"],["ください"],["。"],["そして"],["、"],["明日","あす"],["の"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["出立","しゅったつ"],["なさって"],["ください"],["。"],["」"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["いや"],["、"],["結構","けっこう"],["です"],["。"],["わたしたち"],["は"],["この"],["広場","ひろば"],["で"],["夜","よる"],["を"],["過ごします","すごします"],["。"],["」"]]},{"verse":3,"text":"しかし、ロトがぜひにと勧めたので、彼らはロトの所に立ち寄ることにし、彼の家を訪ねた。ロトは、酵母を入れないパンを焼いて食事を供し、彼らをもてなした。","tok":[["しかし"],["、"],["ロト"],["が"],["ぜひ"],["に"],["と"],["勧めた","すすめた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["ロト"],["の"],["所","ところ"],["に"],["立ち寄る","たちよる"],["こと"],["に"],["し"],["、"],["彼","かれ"],["の"],["家","いえ"],["を"],["訪ねた","たずねた"],["。"],["ロト"],["は"],["、"],["酵母","こうぼ"],["を"],["入れない","いれない"],["パン"],["を"],["焼いて","やいて"],["食事","しょくじ"],["を"],["供し","きょうし"],["、"],["彼","かれ"],["ら"],["を"],["もてなした"],["。"]]},{"verse":4,"text":"彼らがまだ床に就かないうちに、ソドムの町の男たちが、若者も年寄りもこぞって押しかけ、家を取り囲んで、","tok":[["彼","かれ"],["ら"],["が"],["まだ"],["床","ゆか"],["に"],["就かない","つかない"],["うち"],["に"],["、"],["ソドム"],["の"],["町","まち"],["の"],["男","おとこ"],["たち"],["が"],["、"],["若者","わかもの"],["も"],["年寄り","としより"],["も"],["こぞって"],["押しかけ","おしかけ"],["、"],["家","いえ"],["を"],["取り囲んで","とりかこんで"],["、"]]},{"verse":5,"text":"わめきたてた。「今夜、お前のところへ来た連中はどこにいる。ここへ連れて来い。なぶりものにしてやるから。」","tok":[["わめきたてた"],["。"],["「"],["今夜","こんや"],["、"],["お前","おまえ"],["の"],["ところ"],["へ"],["来た","きた"],["連中","れんちゅう"],["は"],["どこ"],["に"],["いる"],["。"],["ここ"],["へ"],["連れて","つれて"],["来い","こい"],["。"],["なぶりもの"],["に"],["して"],["やる"],["から"],["。"],["」"]]},{"verse":6,"text":"ロトは、戸口の前にたむろしている男たちのところへ出て行き、後ろの戸を閉めて、","tok":[["ロト"],["は"],["、"],["戸口","とぐち"],["の"],["前","まえ"],["に"],["たむろ"],["して"],["いる"],["男","おとこ"],["たち"],["の"],["ところ"],["へ"],["出て","でて"],["行き","いき"],["、"],["後ろ","うしろ"],["の"],["戸","と"],["を"],["閉めて","しめて"],["、"]]},{"verse":7,"text":"言った。「どうか、皆さん、乱暴なことはしないでください。","tok":[["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["皆","みな"],["さん"],["、"],["乱暴","らんぼう"],["な"],["こと"],["は"],["しないで"],["ください"],["。"]]},{"verse":8,"text":"実は、わたしにはまだ嫁がせていない娘が二人おります。皆さんにその娘たちを差し出しますから、好きなようにしてください。ただ、あの方々には何もしないでください。この家の屋根の下に身を寄せていただいたのですから。」","tok":[["実","じつ"],["は"],["、"],["わたし"],["に"],["は"],["まだ"],["嫁がせて","とつがせて"],["いない"],["娘","むすめ"],["が"],["二人","ふたり"],["おります"],["。"],["皆","みな"],["さん"],["に"],["その"],["娘","むすめ"],["たち"],["を"],["差し出します","さしだします"],["から"],["、"],["好き","すき"],["な"],["よう"],["に"],["して"],["ください"],["。"],["ただ"],["、"],["あの"],["方々","ほうぼう"],["に"],["は"],["何","なん"],["も"],["しないで"],["ください"],["。"],["この"],["家","いえ"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["身","み"],["を"],["寄せて","よせて"],["いただいた"],["の"],["です"],["から"],["。"],["」"]]},{"verse":9,"text":"男たちは口々に言った。「そこをどけ。」「こいつは、よそ者のくせに、指図などして。」「さあ、彼らより先に、お前を痛い目に遭わせてやる。」そして、ロトに詰め寄って体を押しつけ、戸を破ろうとした。","tok":[["男","おとこ"],["たち"],["は"],["口々","くちぐち"],["に"],["言った","いった"],["。"],["「"],["そこ"],["を"],["どけ"],["。"],["」"],["「"],["こいつ"],["は"],["、"],["よそ者","よそもの"],["の"],["くせ"],["に"],["、"],["指図","さしず"],["など"],["して"],["。"],["」"],["「"],["さあ"],["、"],["彼","かれ"],["ら"],["より"],["先","さき"],["に"],["、"],["お前","おまえ"],["を"],["痛い","いたい"],["目","め"],["に"],["遭わせて","あわせて"],["やる"],["。"],["」"],["そして"],["、"],["ロト"],["に"],["詰め寄って","つめよって"],["体","からだ"],["を"],["押しつけ","おしつけ"],["、"],["戸","と"],["を"],["破ろう","やぶろう"],["と"],["した"],["。"]]},{"verse":10,"text":"二人の客はそのとき、手を伸ばして、ロトを家の中に引き入れて戸を閉め、","tok":[["二人","ふたり"],["の"],["客","きゃく"],["は"],["その"],["とき"],["、"],["手","て"],["を"],["伸ばして","のばして"],["、"],["ロト"],["を"],["家","いえ"],["の"],["中","なか"],["に"],["引き入れて","ひきいれて"],["戸","と"],["を"],["閉め","しめ"],["、"]]},{"verse":11,"text":"戸口の前にいる男たちに、老若を問わず、目つぶしを食わせ、戸口を分からなくした。","tok":[["戸口","とぐち"],["の"],["前","まえ"],["に"],["いる"],["男","おとこ"],["たち"],["に"],["、"],["老若","ろうにゃく"],["を"],["問わず","とわず"],["、"],["目つぶし","めつぶし"],["を"],["食わせ","くわせ"],["、"],["戸口","とぐち"],["を"],["分からなく","わからなく"],["した"],["。"]]},{"verse":12,"text":"二人の客はロトに言った。「ほかに、あなたの身内の人がこの町にいますか。あなたの婿や息子や娘などを皆連れてここから逃げなさい。","tok":[["二人","ふたり"],["の"],["客","きゃく"],["は"],["ロト"],["に"],["言った","いった"],["。"],["「"],["ほか"],["に"],["、"],["あなた"],["の"],["身内","みうち"],["の"],["人","ひと"],["が"],["この"],["町","まち"],["に"],["います"],["か"],["。"],["あなた"],["の"],["婿","むこ"],["や"],["息子","むすこ"],["や"],["娘","むすめ"],["など"],["を"],["皆","みな"],["連れて","つれて"],["ここ"],["から"],["逃げ","にげ"],["なさい"],["。"]]},{"verse":13,"text":"実は、わたしたちはこの町を滅ぼしに来たのです。大きな叫びが主のもとに届いたので、主は、この町を滅ぼすためにわたしたちを遣わされたのです。」","tok":[["実","じつ"],["は"],["、"],["わたしたち"],["は"],["この"],["町","まち"],["を"],["滅ぼし","ほろぼし"],["に"],["来た","きた"],["の"],["です"],["。"],["大きな","おおきな"],["叫び","さけび"],["が"],["主","ぬし"],["の"],["もと"],["に"],["届いた","とどいた"],["ので"],["、"],["主","ぬし"],["は"],["、"],["この"],["町","まち"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["わたしたち"],["を"],["遣わされた","つかわされた"],["の"],["です"],["。"],["」"]]},{"verse":14,"text":"ロトは嫁いだ娘たちの婿のところへ行き、「さあ早く、ここから逃げるのだ。主がこの町を滅ぼされるからだ」と促したが、婿たちは冗談だと思った。","tok":[["ロト"],["は"],["嫁いだ","とついだ"],["娘","むすめ"],["たち"],["の"],["婿","むこ"],["の"],["ところ"],["へ"],["行き","いき"],["、"],["「"],["さあ"],["早く","はやく"],["、"],["ここ"],["から"],["逃げる","にげる"],["の"],["だ"],["。"],["主","ぬし"],["が"],["この"],["町","まち"],["を"],["滅ぼされる","ほろぼされる"],["から"],["だ"],["」"],["と"],["促した","うながした"],["が"],["、"],["婿","むこ"],["たち"],["は"],["冗談","じょうだん"],["だ"],["と"],["思った","おもった"],["。"]]},{"verse":15,"text":"夜が明けるころ、御使いたちはロトをせきたてて言った。「さあ早く、あなたの妻とここにいる二人の娘を連れて行きなさい。さもないと、この町に下る罰の巻き添えになって滅ぼされてしまう。」","tok":[["夜","よる"],["が"],["明ける","あける"],["ころ"],["、"],["御使い","おつかい"],["たち"],["は"],["ロト"],["を"],["せきたてて"],["言った","いった"],["。"],["「"],["さあ"],["早く","はやく"],["、"],["あなた"],["の"],["妻","つま"],["と"],["ここ"],["に"],["いる"],["二人","ふたり"],["の"],["娘","むすめ"],["を"],["連れて","つれて"],["行き","いき"],["なさい"],["。"],["さも"],["ない"],["と"],["、"],["この"],["町","まち"],["に"],["下る","くだる"],["罰","ばつ"],["の"],["巻き添え","まきぞえ"],["に"],["なって"],["滅ぼされて","ほろぼされて"],["しまう"],["。"],["」"]]},{"verse":16,"text":"ロトはためらっていた。主は憐れんで、二人の客にロト、妻、二人の娘の手をとらせて町の外へ避難するようにされた。","tok":[["ロト"],["は"],["ためらって"],["いた"],["。"],["主","ぬし"],["は"],["憐れんで","あわれんで"],["、"],["二人","ふたり"],["の"],["客","きゃく"],["に"],["ロト"],["、"],["妻","つま"],["、"],["二人","ふたり"],["の"],["娘","むすめ"],["の"],["手","て"],["を"],["とらせて"],["町","まち"],["の"],["外","そと"],["へ"],["避難","ひなん"],["する"],["よう"],["に"],["された"],["。"]]},{"verse":17,"text":"彼らがロトたちを町外れへ連れ出したとき、主は言われた。「命がけで逃れよ。後ろを振り返ってはいけない。低地のどこにもとどまるな。山へ逃げなさい。さもないと、滅びることになる。」","tok":[["彼","かれ"],["ら"],["が"],["ロト"],["たち"],["を"],["町外れ","まちはずれ"],["へ"],["連れ出した","つれだした"],["とき"],["、"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["命がけ","いのちがけ"],["で"],["逃れ","のがれ"],["よ"],["。"],["後ろ","うしろ"],["を"],["振り返って","ふりかえって"],["は"],["いけない"],["。"],["低地","ていち"],["の"],["どこ"],["に"],["も"],["とどまる"],["な"],["。"],["山","やま"],["へ"],["逃げ","にげ"],["なさい"],["。"],["さも"],["ない"],["と"],["、"],["滅びる","ほろびる"],["こと"],["に"],["なる"],["。"],["」"]]},{"verse":18,"text":"ロトは言った。「主よ、できません。","tok":[["ロト"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["できません"],["。"]]},{"verse":19,"text":"あなたは僕に目を留め、慈しみを豊かに示し、命を救おうとしてくださいます。しかし、わたしは山まで逃げ延びることはできません。恐らく、災害に巻き込まれて、死んでしまうでしょう。","tok":[["あなた"],["は"],["僕","ぼく"],["に"],["目","め"],["を"],["留め","とめ"],["、"],["慈しみ","いつくしみ"],["を"],["豊か","ゆたか"],["に"],["示し","しめし"],["、"],["命","いのち"],["を"],["救おう","すくおう"],["として"],["くださいます"],["。"],["しかし"],["、"],["わたし"],["は"],["山","やま"],["まで"],["逃げ延びる","にげのびる"],["こと"],["は"],["できません"],["。"],["恐らく","おそらく"],["、"],["災害","さいがい"],["に"],["巻き込まれて","まきこまれて"],["、"],["死んで","しんで"],["しまうでしょう"],["。"]]},{"verse":20,"text":"御覧ください、あの町を。あそこなら近いので、逃げて行けると思います。あれは小さな町です。あそこへ逃げさせてください。あれはほんの小さな町です。どうか、そこでわたしの命を救ってください。」","tok":[["御覧","ごらん"],["ください"],["、"],["あの"],["町","まち"],["を"],["。"],["あそこ"],["なら"],["近い","ちかい"],["ので"],["、"],
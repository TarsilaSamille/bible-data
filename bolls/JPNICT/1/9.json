[{"verse":1,"text":"神はノアと彼の息子たちを祝福して言われた。「産めよ、増えよ、地に満ちよ。","tok":[["神","かみ"],["は"],["ノア"],["と"],["彼","かれ"],["の"],["息子","むすこ"],["たち"],["を"],["祝福","しゅくふく"],["して"],["言われた","いわれた"],["。"],["「"],["産めよ","うめよ"],["、"],["増えよ","ふえよ"],["、"],["地","ち"],["に"],["満ち","みち"],["よ"],["。"]]},{"verse":2,"text":"地のすべての獣と空のすべての鳥は、地を這うすべてのものと海のすべての魚と共に、あなたたちの前に恐れおののき、あなたたちの手にゆだねられる。","tok":[["地","ち"],["の"],["すべて"],["の"],["獣","けもの"],["と"],["空","そら"],["の"],["すべて"],["の"],["鳥","とり"],["は"],["、"],["地","ち"],["を"],["這う","はう"],["すべて"],["の"],["もの"],["と"],["海","うみ"],["の"],["すべて"],["の"],["魚","さかな"],["と"],["共","とも"],["に"],["、"],["あなた"],["たち"],["の"],["前","まえ"],["に"],["恐れおののき","おそれおののき"],["、"],["あなた"],["たち"],["の"],["手","て"],["に"],["ゆだねられる"],["。"]]},{"verse":3,"text":"動いている命あるものは、すべてあなたたちの食糧とするがよい。わたしはこれらすべてのものを、青草と同じようにあなたたちに与える。","tok":[["動いて","うごいて"],["いる"],["命","いのち"],["ある"],["もの"],["は"],["、"],["すべて"],["あなた"],["たち"],["の"],["食糧","しょくりょう"],["と"],["する"],["が"],["よい"],["。"],["わたし"],["は"],["これ"],["ら"],["すべて"],["の"],["もの"],["を"],["、"],["青草","あおくさ"],["と"],["同じ","おなじ"],["よう"],["に"],["あなた"],["たち"],["に"],["与える","あたえる"],["。"]]},{"verse":4,"text":"ただし、肉は命である血を含んだまま食べてはならない。","tok":[["ただし"],["、"],["肉","にく"],["は"],["命","いのち"],["で"],["ある"],["血","ち"],["を"],["含んだ","ふくんだ"],["まま"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"また、あなたたちの命である血が流された場合、わたしは賠償を要求する。いかなる獣からも要求する。人間どうしの血については、人間から人間の命を賠償として要求する。","tok":[["また"],["、"],["あなた"],["たち"],["の"],["命","いのち"],["で"],["ある"],["血","ち"],["が"],["流された","ながされた"],["場合","ばあい"],["、"],["わたし"],["は"],["賠償","ばいしょう"],["を"],["要求","ようきゅう"],["する"],["。"],["いかなる"],["獣","けもの"],["から"],["も"],["要求","ようきゅう"],["する"],["。"],["人間","にんげん"],["どうし"],["の"],["血","ち"],["について"],["は"],["、"],["人間","にんげん"],["から"],["人間","にんげん"],["の"],["命","いのち"],["を"],["賠償","ばいしょう"],["として"],["要求","ようきゅう"],["する"],["。"]]},{"verse":6,"text":"人の血を流す者は人によって自分の血を流される。人は神にかたどって造られたからだ。","tok":[["人","ひと"],["の"],["血","ち"],["を"],["流す","ながす"],["者","もの"],["は"],["人","ひと"],["によって"],["自分","じぶん"],["の"],["血","ち"],["を"],["流される","ながされる"],["。"],["人","ひと"],["は"],["神","かみ"],["に"],["かたどって"],["造られた","つくられた"],["から"],["だ"],["。"]]},{"verse":7,"text":"あなたたちは産めよ、増えよ地に群がり、地に増えよ。」","tok":[["あなた"],["たち"],["は"],["産めよ","うめよ"],["、"],["増えよ","ふえよ"],["地","ち"],["に"],["群がり","むらがり"],["、"],["地","ち"],["に"],["増え","ふえ"],["よ"],["。"],["」"]]},{"verse":8,"text":"神はノアと彼の息子たちに言われた。","tok":[["神","かみ"],["は"],["ノア"],["と"],["彼","かれ"],["の"],["息子","むすこ"],["たち"],["に"],["言われた","いわれた"],["。"]]},{"verse":9,"text":"「わたしは、あなたたちと、そして後に続く子孫と、契約を立てる。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["たち"],["と"],["、"],["そして"],["後","あと"],["に"],["続く","つづく"],["子孫","しそん"],["と"],["、"],["契約","けいやく"],["を"],["立てる","たてる"],["。"]]},{"verse":10,"text":"あなたたちと共にいるすべての生き物、またあなたたちと共にいる鳥や家畜や地のすべての獣など、箱舟から出たすべてのもののみならず、地のすべての獣と契約を立てる。","tok":[["あなた"],["たち"],["と"],["共","とも"],["に"],["いる"],["すべて"],["の"],["生き物","いきもの"],["、"],["また"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いる"],["鳥","とり"],["や"],["家畜","かちく"],["や"],["地","ち"],["の"],["すべて"],["の"],["獣","けもの"],["など"],["、"],["箱舟","はこぶね"],["から"],["出た","でた"],["すべて"],["の"],["もの"],["のみ"],["ならず"],["、"],["地","ち"],["の"],["すべて"],["の"],["獣","けもの"],["と"],["契約","けいやく"],["を"],["立てる","たてる"],["。"]]},{"verse":11,"text":"わたしがあなたたちと契約を立てたならば、二度と洪水によって肉なるものがことごとく滅ぼされることはなく、洪水が起こって地を滅ぼすことも決してない。」","tok":[["わたし"],["が"],["あなた"],["たち"],["と"],["契約","けいやく"],["を"],["立てたならば","たてたならば"],["、"],["二","に"],["度","ど"],["と"],["洪水","こうずい"],["によって"],["肉","にく"],["なる"],["もの"],["が"],["ことごとく"],["滅ぼされる","ほろぼされる"],["こと"],["は"],["なく"],["、"],["洪水","こうずい"],["が"],["起こって","おこって"],["地","ち"],["を"],["滅ぼす","ほろぼす"],["こと"],["も"],["決して","けっして"],["ない"],["。"],["」"]]},{"verse":12,"text":"更に神は言われた。「あなたたちならびにあなたたちと共にいるすべての生き物と、代々とこしえにわたしが立てる契約のしるしはこれである。","tok":[["更に","さらに"],["神","かみ"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["たちならび"],["に"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いる"],["すべて"],["の"],["生き物","いきもの"],["と"],["、"],["代々","だいだい"],["とこしえ"],["に"],["わたし"],["が"],["立てる","たてる"],["契約","けいやく"],["の"],["しるし"],["は"],["これ"],["で"],["ある"],["。"]]},{"verse":13,"text":"すなわち、わたしは雲の中にわたしの虹を置く。これはわたしと大地の間に立てた契約のしるしとなる。","tok":[["すなわち"],["、"],["わたし"],["は"],["雲","くも"],["の"],["中","なか"],["に"],["わたし"],["の"],["虹","にじ"],["を"],["置く","おく"],["。"],["これ"],["は"],["わたし"],["と"],["大地","だいち"],["の"],["間","あいだ"],["に"],["立てた","たてた"],["契約","けいやく"],["の"],["しるし"],["と"],["なる"],["。"]]},{"verse":14,"text":"わたしが地の上に雲を湧き起こらせ、雲の中に虹が現れると、","tok":[["わたし"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["雲","くも"],["を"],["湧き起こらせ","わきおこらせ"],["、"],["雲","くも"],["の"],["中","なか"],["に"],["虹","にじ"],["が"],["現れる","あらわれる"],["と"],["、"]]},{"verse":15,"text":"わたしは、わたしとあなたたちならびにすべての生き物、すべて肉なるものとの間に立てた契約に心を留める。水が洪水となって、肉なるものをすべて滅ぼすことは決してない。","tok":[["わたし"],["は"],["、"],["わたし"],["と"],["あなた"],["たちならび"],["に"],["すべて"],["の"],["生き物","いきもの"],["、"],["すべて"],["肉","にく"],["なる"],["もの"],["と"],["の"],["間","あいだ"],["に"],["立てた","たてた"],["契約","けいやく"],["に"],["心","こころ"],["を"],["留める","とめる"],["。"],["水","みず"],["が"],["洪水","こうずい"],["と"],["なって"],["、"],["肉","にく"],["なる"],["もの"],["を"],["すべて"],["滅ぼす","ほろぼす"],["こと"],["は"],["決して","けっして"],["ない"],["。"]]},{"verse":16,"text":"雲の中に虹が現れると、わたしはそれを見て、神と地上のすべての生き物、すべて肉なるものとの間に立てた永遠の契約に心を留める。」","tok":[["雲","くも"],["の"],["中","なか"],["に"],["虹","にじ"],["が"],["現れる","あらわれる"],["と"],["、"],["わたし"],["は"],["それ"],["を"],["見て","みて"],["、"],["神","かみ"],["と"],["地上","ちじょう"],["の"],["すべて"],["の"],["生き物","いきもの"],["、"],["すべて"],["肉","にく"],["なる"],["もの"],["と"],["の"],["間","あいだ"],["に"],["立てた","たてた"],["永遠","えいえん"],["の"],["契約","けいやく"],["に"],["心","こころ"],["を"],["留める","とめる"],["。"],["」"]]},{"verse":17,"text":"神はノアに言われた。「これが、わたしと地上のすべて肉なるものとの間に立てた契約のしるしである。」","tok":[["神","かみ"],["は"],["ノア"],["に"],["言われた","いわれた"],["。"],["「"],["これ"],["が"],["、"],["わたし"],["と"],["地上","ちじょう"],["の"],["すべて"],["肉","にく"],["なる"],["もの"],["と"],["の"],["間","あいだ"],["に"],["立てた","たてた"],["契約","けいやく"],["の"],["しるし"],["で"],["ある"],["。"],["」"]]},{"verse":18,"text":"箱舟から出たノアの息子は、セム、ハム、ヤフェトであった。ハムはカナンの父である。","tok":[["箱舟","はこぶね"],["から"],["出た","でた"],["ノア"],["の"],["息子","むすこ"],["は"],["、"],["セム"],["、"],["ハム"],["、"],["ヤフェト"],["で"],["あった"],["。"],["ハム"],["は"],["カナン"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":19,"text":"この三人がノアの息子で、全世界の人々は彼らから出て広がったのである。","tok":[["この"],["三人","さんにん"],["が"],["ノア"],["の"],["息子","むすこ"],["で"],["、"],["全","ぜん"],["世界","せかい"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["から"],["出て","でて"],["広がった","ひろがった"],["ので"],["ある"],["。"]]},{"verse":20,"text":"さて、ノアは農夫となり、ぶどう畑を作った。","tok":[["さて"],["、"],["ノア"],["は"],["農夫","のうふ"],["と"],["なり"],["、"],["ぶどう"],["畑","はたけ"],["を"],["作った","つくった"],["。"]]},{"verse":21,"text":"あるとき、ノアはぶどう酒を飲んで酔い、天幕の中で裸になっていた。","tok":[["ある"],["とき"],["、"],["ノア"],["は"],["ぶどう酒","ぶどうしゅ"],["を"],["飲んで","のんで"],["酔い","よい"],["、"],["天幕","てんまく"],["の"],["中","なか"],["で"],["裸","はだか"],["に"],["なって"],["いた"],["。"]]},{"verse":22,"text":"カナンの父ハムは、自分の父の裸を見て、外にいた二人の兄弟に告げた。","tok":[["カナン"],["の"],["父","ちち"],["ハム"],["は"],["、"],["自分","じぶん"],["の"],["父","ちち"],["の"],["裸","はだか"],["を"],["見て","みて"],["、"],["外","そと"],["に"],["いた"],["二人","ふたり"],["の"],["兄弟","きょうだい"],["に"],["告げた","つげた"],["。"]]},{"verse":23,"text":"セムとヤフェトは着物を取って自分たちの肩に掛け、後ろ向きに歩いて行き、父の裸を覆った。二人は顔を背けたままで、父の裸を見なかった。","tok":[["セム"],["と"],["ヤフェト"],["は"],["着物","きもの"],["を"],["取って","とって"],["自分","じぶん"],["たち"],["の"],["肩","かた"],["に"],["掛け","かけ"],["、"],["後ろ向き","うしろむき"],["に"],["歩いて","あるいて"],["行き","いき"],["、"],["父","ちち"],["の"],["裸","はだか"],["を"],["覆った","おおった"],["。"],["二人","ふたり"],["は"],["顔","かお"],["を"],["背けた","そむけた"],["まま"],["で"],["、"],["父","ちち"],["の"],["裸","はだか"],["を"],["見なかった","みなかった"],["。"]]},{"verse":24,"text":"ノアは酔いからさめると、末の息子がしたことを知り、","tok":[["ノア"],["は"],["酔い","よい"],["から"],["さめる"],["と"],["、"],["末","すえ"],["の"],["息子","むすこ"],["が"],["した"],["こと"],["を"],["知り","しり"],["、"]]},{"verse":25,"text":"こう言った。「カナンは呪われよ奴隷の奴隷となり、兄たちに仕えよ。」","tok":[["こう"],["言った","いった"],["。"],["「"],["カナン"],["は"],["呪われよ","のろわれよ"],["奴隷","どれい"],["の"],["奴隷","どれい"],["と"],["なり"],["、"],["兄たち","あにたち"],["に"],["仕え","つかえ"],["よ"],["。"],["」"]]},{"verse":26,"text":"また言った。「セムの神、主をたたえよ。カナンはセムの奴隷となれ。","tok":[["また"],["言った","いった"],["。"],["「"],["セム"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["たたえ"],["よ"],["。"],["カナン"],["は"],["セム"],["の"],["奴隷","どれい"],["と"],["なれ"],["。"]]},{"verse":27,"text":"神がヤフェトの土地を広げ（ヤフェト）セムの天幕に住まわせカナンはその奴隷となれ。」","tok":[["神","かみ"],["が"],["ヤフェト"],["の"],["土地","とち"],["を"],["広げ","ひろげ"],["（"],["ヤフェト"],["）"],["セム"],["の"],["天幕","てんまく"],["に"],["住まわせ","すまわせ"],["カナン"],["は"],["その"],["奴隷","どれい"],["と"],["なれ"],["。"],["」"]]},{"verse":28,"text":"ノアは、洪水の後三百五十年生きた。","tok":[["ノア"],["は"],["、"],["洪水","こうずい"],["の"],["後","あと"],["三百五十","さんひゃくごじゅう"],["年","ねん"],["生きた","いきた"],["。"]]},{"verse":29,"text":"ノアは九百五十歳になって、死んだ。","tok":[["ノア"],["は"],["九百五十","きゅうひゃくごじゅう"],["歳","さい"],["に"],["なって"],["、"],["死んだ","しんだ"],["。"]]}]
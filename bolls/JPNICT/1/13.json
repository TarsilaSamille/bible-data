[{"verse":1,"text":"アブラムは、妻と共に、すべての持ち物を携え、エジプトを出て再びネゲブ地方へ上った。ロトも一緒であった。","tok":[["アブラム"],["は"],["、"],["妻","つま"],["と"],["共","とも"],["に"],["、"],["すべて"],["の"],["持ち物","もちもの"],["を"],["携え","たずさえ"],["、"],["エジプト"],["を"],["出て","でて"],["再び","ふたたび"],["ネゲブ"],["地方","ちほう"],["へ"],["上った","のぼった"],["。"],["ロト"],["も"],["一緒","いっしょ"],["で"],["あった"],["。"]]},{"verse":2,"text":"アブラムは非常に多くの家畜や金銀を持っていた。","tok":[["アブラム"],["は"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["家畜","かちく"],["や"],["金銀","きんぎん"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":3,"text":"ネゲブ地方から更に、ベテルに向かって旅を続け、ベテルとアイとの間の、以前に天幕を張った所まで来た。","tok":[["ネゲブ"],["地方","ちほう"],["から"],["更に","さらに"],["、"],["ベテル"],["に"],["向かって","むかって"],["旅","たび"],["を"],["続け","つづけ"],["、"],["ベテル"],["と"],["アイ"],["と"],["の"],["間","あいだ"],["の"],["、"],["以前","いぜん"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["所","ところ"],["まで"],["来た","きた"],["。"]]},{"verse":4,"text":"そこは、彼が最初に祭壇を築いて、主の御名を呼んだ場所であった。","tok":[["そこ"],["は"],["、"],["彼","かれ"],["が"],["最初","さいしょ"],["に"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["呼んだ","よんだ"],["場所","ばしょ"],["で"],["あった"],["。"]]},{"verse":5,"text":"アブラムと共に旅をしていたロトもまた、羊や牛の群れを飼い、たくさんの天幕を持っていた。","tok":[["アブラム"],["と"],["共","とも"],["に"],["旅","たび"],["を"],["して"],["いた"],["ロト"],["も"],["また"],["、"],["羊","ひつじ"],["や"],["牛","うし"],["の"],["群れ","むれ"],["を"],["飼い","かい"],["、"],["たくさん"],["の"],["天幕","てんまく"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":6,"text":"その土地は、彼らが一緒に住むには十分ではなかった。彼らの財産が多すぎたから、一緒に住むことができなかったのである。","tok":[["その"],["土地","とち"],["は"],["、"],["彼","かれ"],["ら"],["が"],["一緒","いっしょ"],["に"],["住む","すむ"],["に"],["は"],["十分","じゅうぶん"],["で"],["は"],["なかった"],["。"],["彼","かれ"],["ら"],["の"],["財産","ざいさん"],["が"],["多","おお"],["すぎた"],["から"],["、"],["一緒","いっしょ"],["に"],["住む","すむ"],["こと"],["が"],["できなかった"],["ので"],["ある"],["。"]]},{"verse":7,"text":"アブラムの家畜を飼う者たちと、ロトの家畜を飼う者たちとの間に争いが起きた。そのころ、その地方にはカナン人もペリジ人も住んでいた。","tok":[["アブラム"],["の"],["家畜","かちく"],["を"],["飼う","かう"],["者","もの"],["たち"],["と"],["、"],["ロト"],["の"],["家畜","かちく"],["を"],["飼う","かう"],["者","もの"],["たち"],["と"],["の"],["間","あいだ"],["に"],["争い","あらそい"],["が"],["起きた","おきた"],["。"],["その"],["ころ"],["、"],["その"],["地方","ちほう"],["に"],["は"],["カナン人","かなんにん"],["も"],["ペリジ人","ぺりじにん"],["も"],["住んで","すんで"],["いた"],["。"]]},{"verse":8,"text":"アブラムはロトに言った。「わたしたちは親類どうしだ。わたしとあなたの間ではもちろん、お互いの羊飼いの間でも争うのはやめよう。","tok":[["アブラム"],["は"],["ロト"],["に"],["言った","いった"],["。"],["「"],["わたしたち"],["は"],["親類","しんるい"],["どうし"],["だ"],["。"],["わたし"],["と"],["あなた"],["の"],["間","あいだ"],["で"],["は"],["もちろん"],["、"],["お互い","おたがい"],["の"],["羊飼い","ひつじかい"],["の"],["間","あいだ"],["で"],["も"],["争う","あらそう"],["の"],["は"],["やめよう"],["。"]]},{"verse":9,"text":"あなたの前には幾らでも土地があるのだから、ここで別れようではないか。あなたが左に行くなら、わたしは右に行こう。あなたが右に行くなら、わたしは左に行こう。」","tok":[["あなた"],["の"],["前","まえ"],["に"],["は"],["幾ら","いくら"],["で"],["も"],["土地","とち"],["が"],["ある"],["の"],["だ"],["から"],["、"],["ここ"],["で"],["別れ","わかれ"],["よう"],["で"],["は"],["ない"],["か"],["。"],["あなた"],["が"],["左","ひだり"],["に"],["行くなら","いくなら"],["、"],["わたし"],["は"],["右","みぎ"],["に"],["行こう","いこう"],["。"],["あなた"],["が"],["右","みぎ"],["に"],["行くなら","いくなら"],["、"],["わたし"],["は"],["左","ひだり"],["に"],["行こう","いこう"],["。"],["」"]]},{"verse":10,"text":"ロトが目を上げて眺めると、ヨルダン川流域の低地一帯は、主がソドムとゴモラを滅ぼす前であったので、ツォアルに至るまで、主の園のように、エジプトの国のように、見渡すかぎりよく潤っていた。","tok":[["ロト"],["が"],["目","め"],["を"],["上げて","あげて"],["眺める","ながめる"],["と"],["、"],["ヨルダン"],["川","かわ"],["流域","りゅういき"],["の"],["低地","ていち"],["一帯","いったい"],["は"],["、"],["主","ぬし"],["が"],["ソドム"],["と"],["ゴモラ"],["を"],["滅ぼす","ほろぼす"],["前","まえ"],["で"],["あった"],["ので"],["、"],["ツォアル"],["に"],["至る","いたる"],["まで"],["、"],["主","ぬし"],["の"],["園","その"],["の"],["よう"],["に"],["、"],["エジプト"],["の"],["国","くに"],["の"],["よう"],["に"],["、"],["見渡す","みわたす"],["かぎり"],["よく"],["潤って","うるおって"],["いた"],["。"]]},{"verse":11,"text":"ロトはヨルダン川流域の低地一帯を選んで、東へ移って行った。こうして彼らは、左右に別れた。","tok":[["ロト"],["は"],["ヨルダン"],["川","かわ"],["流域","りゅういき"],["の"],["低地","ていち"],["一帯","いったい"],["を"],["選んで","えらんで"],["、"],["東","ひがし"],["へ"],["移って","うつって"],["行った","いった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["左右","さゆう"],["に"],["別れた","わかれた"],["。"]]},{"verse":12,"text":"アブラムはカナン地方に住み、ロトは低地の町々に住んだが、彼はソドムまで天幕を移した。","tok":[["アブラム"],["は"],["カナン"],["地方","ちほう"],["に"],["住み","すみ"],["、"],["ロト"],["は"],["低地","ていち"],["の"],["町々","まちまち"],["に"],["住んだ","すんだ"],["が"],["、"],["彼","かれ"],["は"],["ソドム"],["まで"],["天幕","てんまく"],["を"],["移した","うつした"],["。"]]},{"verse":13,"text":"ソドムの住民は邪悪で、主に対して多くの罪を犯していた。","tok":[["ソドム"],["の"],["住民","じゅうみん"],["は"],["邪悪","じゃあく"],["で"],["、"],["主に","おもに"],["対して","たいして"],["多く","おおく"],["の"],["罪","つみ"],["を"],["犯して","おかして"],["いた"],["。"]]},{"verse":14,"text":"主は、ロトが別れて行った後、アブラムに言われた。「さあ、目を上げて、あなたがいる場所から東西南北を見渡しなさい。","tok":[["主","ぬし"],["は"],["、"],["ロト"],["が"],["別れて","わかれて"],["行った","いった"],["後","あと"],["、"],["アブラム"],["に"],["言われた","いわれた"],["。"],["「"],["さあ"],["、"],["目","め"],["を"],["上げて","あげて"],["、"],["あなた"],["が"],["いる"],["場所","ばしょ"],["から"],["東西","とうざい"],["南北","なんぼく"],["を"],["見渡し","みわたし"],["なさい"],["。"]]},{"verse":15,"text":"見えるかぎりの土地をすべて、わたしは永久にあなたとあなたの子孫に与える。","tok":[["見える","みえる"],["かぎり"],["の"],["土地","とち"],["を"],["すべて"],["、"],["わたし"],["は"],["永久","えいきゅう"],["に"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["に"],["与える","あたえる"],["。"]]},{"verse":16,"text":"あなたの子孫を大地の砂粒のようにする。大地の砂粒が数えきれないように、あなたの子孫も数えきれないであろう。","tok":[["あなた"],["の"],["子孫","しそん"],["を"],["大地","だいち"],["の"],["砂粒","さりゅう"],["の"],["よう"],["に"],["する"],["。"],["大地","だいち"],["の"],["砂粒","さりゅう"],["が"],["数え","かぞえ"],["きれない"],["よう"],["に"],["、"],["あなた"],["の"],["子孫","しそん"],["も"],["数え","かぞえ"],["きれないで"],["あろう"],["。"]]},{"verse":17,"text":"さあ、この土地を縦横に歩き回るがよい。わたしはそれをあなたに与えるから。」","tok":[["さあ"],["、"],["この"],["土地","とち"],["を"],["縦横","たてよこ"],["に"],["歩き回る","あるきまわる"],["が"],["よい"],["。"],["わたし"],["は"],["それ"],["を"],["あなた"],["に"],["与える","あたえる"],["から"],["。"],["」"]]},{"verse":18,"text":"アブラムは天幕を移し、ヘブロンにあるマムレの樫の木のところに来て住み、そこに主のために祭壇を築いた。","tok":[["アブラム"],["は"],["天幕","てんまく"],["を"],["移し","うつし"],["、"],["ヘブロン"],["に"],["ある"],["マムレ"],["の"],["樫","かし"],["の"],["木","き"],["の"],["ところ"],["に"],["来て","きて"],["住み","すみ"],["、"],["そこ"],["に"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]}]
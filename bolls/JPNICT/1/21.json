[{"verse":1,"text":"主は、約束されたとおりサラを顧み、さきに語られたとおりサラのために行われたので、","tok":[["主","ぬし"],["は"],["、"],["約束","やくそく"],["された"],["とおり"],["サラ"],["を"],["顧み","かえりみ"],["、"],["さき"],["に"],["語られた","かたられた"],["とおり"],["サラ"],["の"],["ため"],["に"],["行われた","おこなわれた"],["ので"],["、"]]},{"verse":2,"text":"彼女は身ごもり、年老いたアブラハムとの間に男の子を産んだ。それは、神が約束されていた時期であった。","tok":[["彼女","かのじょ"],["は"],["身ごもり","みごもり"],["、"],["年老いた","としおいた"],["アブラハム"],["と"],["の"],["間","あいだ"],["に"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"],["それ"],["は"],["、"],["神","かみ"],["が"],["約束","やくそく"],["されて"],["いた"],["時期","じき"],["で"],["あった"],["。"]]},{"verse":3,"text":"アブラハムは、サラが産んだ自分の子をイサクと名付け、","tok":[["アブラハム"],["は"],["、"],["サラ"],["が"],["産んだ","うんだ"],["自分","じぶん"],["の"],["子","こ"],["を"],["イサク"],["と"],["名付け","なづけ"],["、"]]},{"verse":4,"text":"神が命じられたとおり、八日目に、息子イサクに割礼を施した。","tok":[["神","かみ"],["が"],["命じられた","めいじられた"],["とおり"],["、"],["八日目","ようかめ"],["に"],["、"],["息子","むすこ"],["イサク"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["。"]]},{"verse":5,"text":"息子イサクが生まれたとき、アブラハムは百歳であった。","tok":[["息子","むすこ"],["イサク"],["が"],["生まれた","うまれた"],["とき"],["、"],["アブラハム"],["は"],["百歳","ひゃくさい"],["で"],["あった"],["。"]]},{"verse":6,"text":"サラは言った。「神はわたしに笑いをお与えになった。聞く者は皆、わたしと笑い（イサク）を共にしてくれるでしょう。」","tok":[["サラ"],["は"],["言った","いった"],["。"],["「"],["神","かみ"],["は"],["わたし"],["に"],["笑い","わらい"],["を"],["お与え","おあたえ"],["に"],["なった"],["。"],["聞く","きく"],["者","もの"],["は"],["皆","みな"],["、"],["わたし"],["と"],["笑い","わらい"],["（"],["イサク"],["）"],["を"],["共","とも"],["に"],["して"],["くれるでしょう"],["。"],["」"]]},{"verse":7,"text":"サラはまた言った。「誰がアブラハムに言いえたでしょうサラは子に乳を含ませるだろうと。しかしわたしは子を産みました年老いた夫のために。」","tok":[["サラ"],["は"],["また"],["言った","いった"],["。"],["「"],["誰","だれ"],["が"],["アブラハム"],["に"],["言い","いい"],["えたでしょう"],["サラ"],["は"],["子","こ"],["に"],["乳","ちち"],["を"],["含ませるだろう","ふくませるだろう"],["と"],["。"],["しかし"],["わたし"],["は"],["子","こ"],["を"],["産みました","うみました"],["年老いた","としおいた"],["夫","おっと"],["の"],["ため"],["に"],["。"],["」"]]},{"verse":8,"text":"やがて、子供は育って乳離れした。アブラハムはイサクの乳離れの日に盛大な祝宴を開いた。","tok":[["やがて"],["、"],["子供","こども"],["は"],["育って","そだって"],["乳離れ","ちばなれ"],["した"],["。"],["アブラハム"],["は"],["イサク"],["の"],["乳離れ","ちばなれ"],["の"],["日","ひ"],["に"],["盛大","せいだい"],["な"],["祝宴","しゅくえん"],["を"],["開いた","ひらいた"],["。"]]},{"verse":9,"text":"サラは、エジプトの女ハガルがアブラハムとの間に産んだ子が、イサクをからかっているのを見て、","tok":[["サラ"],["は"],["、"],["エジプト"],["の"],["女","おんな"],["ハガル"],["が"],["アブラハム"],["と"],["の"],["間","あいだ"],["に"],["産んだ","うんだ"],["子","こ"],["が"],["、"],["イサク"],["を"],["からかって"],["いる"],["の"],["を"],["見て","みて"],["、"]]},{"verse":10,"text":"アブラハムに訴えた。「あの女とあの子を追い出してください。あの女の息子は、わたしの子イサクと同じ跡継ぎとなるべきではありません。」","tok":[["アブラハム"],["に"],["訴えた","うったえた"],["。"],["「"],["あの"],["女","おんな"],["と"],["あの"],["子","こ"],["を"],["追い出して","おいだして"],["ください"],["。"],["あの"],["女","おんな"],["の"],["息子","むすこ"],["は"],["、"],["わたし"],["の"],["子","こ"],["イサク"],["と"],["同じ","おなじ"],["跡継ぎ","あとつぎ"],["と"],["なるべきで"],["は"],["ありません"],["。"],["」"]]},{"verse":11,"text":"このことはアブラハムを非常に苦しめた。その子も自分の子であったからである。","tok":[["この"],["こと"],["は"],["アブラハム"],["を"],["非常","ひじょう"],["に"],["苦しめた","くるしめた"],["。"],["その"],["子","こ"],["も"],["自分","じぶん"],["の"],["子","こ"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"神はアブラハムに言われた。「あの子供とあの女のことで苦しまなくてもよい。すべてサラが言うことに聞き従いなさい。あなたの子孫はイサクによって伝えられる。","tok":[["神","かみ"],["は"],["アブラハム"],["に"],["言われた","いわれた"],["。"],["「"],["あの"],["子供","こども"],["と"],["あの"],["女","おんな"],["の"],["こと"],["で"],["苦しまなくて","くるしまなくて"],["も"],["よい"],["。"],["すべて"],["サラ"],["が"],["言う","いう"],["こと"],["に"],["聞き従い","ききしたがい"],["なさい"],["。"],["あなた"],["の"],["子孫","しそん"],["は"],["イサク"],["によって"],["伝えられる","つたえられる"],["。"]]},{"verse":13,"text":"しかし、あの女の息子も一つの国民の父とする。彼もあなたの子であるからだ。」","tok":[["しかし"],["、"],["あの"],["女","おんな"],["の"],["息子","むすこ"],["も"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["の"],["父","ちち"],["と"],["する"],["。"],["彼","かれ"],["も"],["あなた"],["の"],["子","こ"],["で"],["ある"],["から"],["だ"],["。"],["」"]]},{"verse":14,"text":"アブラハムは、次の朝早く起き、パンと水の革袋を取ってハガルに与え、背中に負わせて子供を連れ去らせた。ハガルは立ち去り、ベエル‧シェバの荒れ野をさまよった。","tok":[["アブラハム"],["は"],["、"],["次","つぎ"],["の"],["朝","あさ"],["早く","はやく"],["起き","おき"],["、"],["パン"],["と"],["水","みず"],["の"],["革袋","かわぶくろ"],["を"],["取って","とって"],["ハガル"],["に"],["与え","あたえ"],["、"],["背中","せなか"],["に"],["負わせて","おわせて"],["子供","こども"],["を"],["連れ去らせた","つれさらせた"],["。"],["ハガル"],["は"],["立ち去り","たちさり"],["、"],["ベエル"],["‧"],["シェバ"],["の"],["荒れ野","あれの"],["を"],["さまよった"],["。"]]},{"verse":15,"text":"革袋の水が無くなると、彼女は子供を一本の灌木の下に寝かせ、","tok":[["革袋","かわぶくろ"],["の"],["水","みず"],["が"],["無くなる","なくなる"],["と"],["、"],["彼女","かのじょ"],["は"],["子供","こども"],["を"],["一本","いちぽん"],["の"],["灌木","かんぼく"],["の"],["下","した"],["に"],["寝かせ","ねかせ"],["、"]]},{"verse":16,"text":"「わたしは子供が死ぬのを見るのは忍びない」と言って、矢の届くほど離れ、子供の方を向いて座り込んだ。彼女は子供の方を向いて座ると、声をあげて泣いた。","tok":[["「"],["わたし"],["は"],["子供","こども"],["が"],["死ぬ","しぬ"],["の"],["を"],["見る","みる"],["の"],["は"],["忍びない","しのびない"],["」"],["と"],["言って","いって"],["、"],["矢","や"],["の"],["届く","とどく"],["ほど"],["離れ","はなれ"],["、"],["子供","こども"],["の"],["方","ほう"],["を"],["向いて","むいて"],["座り込んだ","すわりこんだ"],["。"],["彼女","かのじょ"],["は"],["子供","こども"],["の"],["方","ほう"],["を"],["向いて","むいて"],["座る","すわる"],["と"],["、"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":17,"text":"神は子供の泣き声を聞かれ、天から神の御使いがハガルに呼びかけて言った。「ハガルよ、どうしたのか。恐れることはない。神はあそこにいる子供の泣き声を聞かれた。","tok":[["神","かみ"],["は"],["子供","こども"],["の"],["泣き声","なきごえ"],["を"],["聞かれ","きかれ"],["、"],["天","てん"],["から"],["神","かみ"],["の"],["御使い","おつかい"],["が"],["ハガル"],["に"],["呼びかけて","よびかけて"],["言った","いった"],["。"],["「"],["ハガル"],["よ"],["、"],["どう"],["した"],["の"],["か"],["。"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["神","かみ"],["は"],["あそこ"],["に"],["いる"],["子供","こども"],["の"],["泣き声","なきごえ"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":18,"text":"立って行って、あの子を抱き上げ、お前の腕でしっかり抱き締めてやりなさい。わたしは、必ずあの子を大きな国民とする。」","tok":[["立って","たって"],["行って","いって"],["、"],["あの"],["子","こ"],["を"],["抱き上げ","だきあげ"],["、"],["お前","おまえ"],["の"],["腕","うで"],["で"],["しっかり"],["抱き締めて","だきしめて"],["やり"],["なさい"],["。"],["わたし"],["は"],["、"],["必ず","かならず"],["あの"],["子","こ"],["を"],["大きな","おおきな"],["国民","こくみん"],["と"],["する"],["。"],["」"]]},{"verse":19,"text":"神がハガルの目を開かれたので、彼女は水のある井戸を見つけた。彼女は行って革袋に水を満たし、子供に飲ませた。","tok":[["神","かみ"],["が"],["ハガル"],["の"],["目","め"],["を"],["開かれた","ひらかれた"],["ので"],["、"],["彼女","かのじょ"],["は"],["水","みず"],["の"],["ある"],["井戸","いど"],["を"],["見つけた","みつけた"],["。"],["彼女","かのじょ"],["は"],["行って","いって"],["革袋","かわぶくろ"],["に"],["水","みず"],["を"],["満たし","みたし"],["、"],["子供","こども"],["に"],["飲ませた","のませた"],["。"]]},{"verse":20,"text":"神がその子と共におられたので、その子は成長し、荒れ野に住んで弓を射る者となった。","tok":[["神","かみ"],["が"],["その"],["子","こ"],["と"],["共","とも"],["に"],["おられた"],["ので"],["、"],["その"],["子","こ"],["は"],["成長","せいちょう"],["し"],["、"],["荒れ野","あれの"],["に"],["住んで","すんで"],["弓","ゆみ"],["を"],["射る","いる"],["者","もの"],["と"],["なった"],["。"]]},{"verse":21,"text":"彼がパランの荒れ野に住んでいたとき、母は彼のために妻をエジプトの国から迎えた。","tok":[["彼","かれ"],["が"],["パラン"],["の"],["荒れ野","あれの"],["に"],["住んで","すんで"],["いた"],["とき"],["、"],["母","はは"],["は"],["彼","かれ"],["の"],["ため"],["に"],["妻","つま"],["を"],["エジプト"],["の"],["国","くに"],["から"],["迎えた","むかえた"],["。"]]},{"verse":22,"text":"そのころ、アビメレクとその軍隊の長ピコルはアブラハムに言った。「神は、あなたが何をなさっても、あなたと共におられます。","tok":[["その"],["ころ"],["、"],["アビメレク"],["と"],["その"],["軍隊","ぐんたい"],["の"],["長","ちょう"],["ピコル"],["は"],["アブラハム"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["は"],["、"],["あなた"],["が"],["何","なん"],["を"],["なさって"],["も"],["、"],["あなた"],["と"],["共","とも"],["に"],["おられます"],["。"]]},{"verse":23,"text":"どうか、今ここでわたしとわたしの子、わたしの孫を欺かないと、神にかけて誓って（シャバ）ください。わたしがあなたに友好的な態度をとってきたように、あなたも、寄留しているこの国とわたしに友好的な態度をとってください。」","tok":[["どう"],["か"],["、"],["今","いま"],["ここ"],["で"],["わたし"],["と"],["わたし"],["の"],["子","こ"],["、"],["わたし"],["の"],["孫","まご"],["を"],["欺かない","あざむかない"],["と"],["、"],["神","かみ"],["に"],["かけて"],["誓って","ちかって"],["（"],["シャバ"],["）"],["ください"],["。"],["わたし"],["が"],["あなた"],["に"],["友好","ゆうこう"],["的","てき"],["な"],["態度","たいど"],["を"],["とって"],["きた"],["よう"],["に"],["、"],["あなた"],["も"],["、"],["寄留","きりゅう"],["して"],["いる"],["この"],["国","くに"],["と"],["わたし"],["に"],["友好","ゆうこう"],["的","てき"],["な"],["態度","たいど"],["を"],["とって"],["ください"],["。"],["」"]]},{"verse":24,"text":"アブラハムは答えた。「よろしい、誓いましょう。」","tok":[["アブラハム"],["は"],["答えた","こたえた"],["。"],["「"],["よろしい"],["、"],["誓いましょう","ちかいましょう"],["。"],["」"]]},{"verse":25,"text":"アブラハムはアビメレクの部下たちが井戸を奪ったことについて、アビメレクを責めた。","tok":[["アブラハム"],["は"],["アビメレク"],["の"],["部下","ぶか"],["たち"],["が"],["井戸","いど"],["を"],["奪った","うばった"],["こと"],["について"],["、"],["アビメレク"],["を"],["責めた","せめた"],["。"]]},{"verse":26,"text":"アビメレクは言った。「そんなことをした者がいたとは知りませんでした。あなたも告げなかったし、わたしも今日まで聞いていなかったのです。」","tok":[["アビメレク"],["は"],["言った","いった"],["。"],["「"],["そんな"],["こと"],["を"],["した"],["者","もの"],["が"],["いた"],["と"],["は"],["知りませんでした","しりませんでした"],["。"],["あなた"],["も"],["告げなかった","つげなかった"],["し"],["、"],["わたし"],["も"],["今日","きょう"],["まで"],["聞いて","きいて"],["いなかった"],["の"],["です"],["。"],["」"]]},{"verse":27,"text":"アブラハムは、羊と牛の群れを連れて来て、アビメレクに贈り、二人は契約を結んだ。","tok":[["アブラハム"],["は"],["、"],["羊","ひつじ"],["と"],["牛","うし"],["の"],["群れ","むれ"],["を"],["連れて","つれて"],["来て","きて"],["、"],["アビメレク"],["に"],["贈り","おくり"],["、"],["二人","ふたり"],["は"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"]]},{"verse":28,"text":"アブラハムは更に、羊の群れの中から七匹（シェバ）の雌の小羊を別にしたので、","tok":[["アブラハム"],["は"],["更に","さらに"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["中","なか"],["から"],["七","なな"],["匹（シェバ）","ひき"],["の"],["雌","めす"],["の"],["小羊","こひつじ"],["を"],["別","べつ"],["に"],["した"],["ので"],["、"]]},{"verse":29,"text":"アビメレクがアブラハムに尋ねた。「この七匹の雌の小羊を別にしたのは、何のためですか。」","tok":[["アビメレク"],["が"],["アブラハム"],["に"],["尋ねた","たずねた"],["。"],["「"],["この"],["七匹","ななひき"],["の"],["雌","めす"],["の"],["小羊","こひつじ"],["を"],["別","べつ"],["に"],["した"],["の"],["は"],["、"],["何","なん"],["の"],["ため"],["です"],["か"],["。"],["」"]]},{"verse":30,"text":"アブラハムは答えた。「わたしの手からこの七匹の雌の小羊を受け取って、わたしがこの井戸（ベエル）を掘ったことの証拠としてください。」","tok":[["アブラハム"],["は"],["答えた","こたえた"],["。"],["「"],["わたし"],["の"],["手","て"],["から"],["この"],["七匹","ななひき"],["の"],["雌","めす"],["の"],["小羊","こひつじ"],["を"],["受け取って","うけとって"],["、"],["わたし"],["が"],["この"],["井戸（ベエル）","いど"],["を"],["掘った","ほった"],["こと"],["の"],["証拠","しょうこ"],["として"],["ください"],["。"],["」"]]},{"verse":31,"text":"それで、この場所をベエル‧シェバと呼ぶようになった。二人がそこで誓いを交わしたからである。","tok":[["それ"],["で"],["、"],["この"],["場所","ばしょ"],["を"],["ベエル"],["‧"],["シェバ"],["と"],["呼ぶ","よぶ"],["よう"],["に"],["なった"],["。"],["二人","ふたり"],["が"],["そこ"],["で"],["誓い","ちかい"],["を"],["交わした","かわした"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"二人はベエル‧シェバで契約を結び、アビメレクと、その軍隊の長ピコルはペリシテの国に
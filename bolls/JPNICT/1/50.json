[{"verse":1,"text":"ヨセフは父の顔に伏して泣き、口づけした。","tok":[["ヨセフ"],["は"],["父","ちち"],["の"],["顔","かお"],["に"],["伏して","ふして"],["泣き","なき"],["、"],["口づけ","くちづけ"],["した"],["。"]]},{"verse":2,"text":"ヨセフは自分の侍医たちに、父のなきがらに薬を塗り、防腐処置をするように命じたので、医者はイスラエルにその処置をした。","tok":[["ヨセフ"],["は"],["自分","じぶん"],["の"],["侍医","じい"],["たち"],["に"],["、"],["父","ちち"],["の"],["なきがら"],["に"],["薬","くすり"],["を"],["塗り","ぬり"],["、"],["防腐","ぼうふ"],["処置","しょち"],["を"],["する"],["よう"],["に"],["命じた","めいじた"],["ので"],["、"],["医者","いしゃ"],["は"],["イスラエル"],["に"],["その"],["処置","しょち"],["を"],["した"],["。"]]},{"verse":3,"text":"そのために四十日を費やした。この処置をするにはそれだけの日数が必要であった。エジプト人は七十日の間喪に服した。","tok":[["その"],["ため"],["に"],["四十日","よんとうか"],["を"],["費やした","ついやした"],["。"],["この"],["処置","しょち"],["を"],["する"],["に"],["は"],["それ"],["だけ"],["の"],["日数","にっすう"],["が"],["必要","ひつよう"],["で"],["あった"],["。"],["エジプト"],["人","にん"],["は"],["七十日","ななとうか"],["の"],["間","あいだ"],["喪","も"],["に"],["服した","ふくした"],["。"]]},{"verse":4,"text":"喪が明けると、ヨセフはファラオの宮廷に願い出た。「ぜひともよろしくファラオにお取り次ぎください。","tok":[["喪","も"],["が"],["明ける","あける"],["と"],["、"],["ヨセフ"],["は"],["ファラオ"],["の"],["宮廷","きゅうてい"],["に"],["願い出た","ねがいでた"],["。"],["「"],["ぜひ"],["と"],["も"],["よろしく"],["ファラオ"],["に"],["お取り次ぎ","おとりつぎ"],["ください"],["。"]]},{"verse":5,"text":"実は、父がわたしに誓わせて、『わたしは間もなく死ぬ。そのときは、カナンの土地に用意してある墓にわたしを葬ってくれ』と申しました。ですから、どうか父を葬りに行かせてください。わたしはまた帰って参ります。」","tok":[["実","じつ"],["は"],["、"],["父","ちち"],["が"],["わたし"],["に"],["誓わせて","ちかわせて"],["、"],["『"],["わたし"],["は"],["間","ま"],["も"],["なく"],["死ぬ","しぬ"],["。"],["その"],["とき"],["は"],["、"],["カナン"],["の"],["土地","とち"],["に"],["用意","ようい"],["して"],["ある"],["墓","はか"],["に"],["わたし"],["を"],["葬って","ほうむって"],["くれ"],["』"],["と"],["申しました","もうしました"],["。"],["です"],["から"],["、"],["どう"],["か"],["父","ちち"],["を"],["葬り","ほうむり"],["に"],["行かせて","いかせて"],["ください"],["。"],["わたし"],["は"],["また"],["帰って","かえって"],["参ります","まいります"],["。"],["」"]]},{"verse":6,"text":"ファラオは答えた。「父上が誓わせたとおりに、葬りに行って来るがよい。」","tok":[["ファラオ"],["は"],["答えた","こたえた"],["。"],["「"],["父","ちち"],["上","うえ"],["が"],["誓わせた","ちかわせた"],["とおり"],["に"],["、"],["葬り","ほうむり"],["に"],["行って","いって"],["来る","くる"],["が"],["よい"],["。"],["」"]]},{"verse":7,"text":"ヨセフは父を葬りに上って行った。ヨセフと共に上って行ったのは、ファラオの宮廷の元老である重臣たちすべてとエジプトの国の長老たちすべて、","tok":[["ヨセフ"],["は"],["父","ちち"],["を"],["葬り","ほうむり"],["に"],["上って","のぼって"],["行った","いった"],["。"],["ヨセフ"],["と"],["共","とも"],["に"],["上って","のぼって"],["行った","いった"],["の"],["は"],["、"],["ファラオ"],["の"],["宮廷","きゅうてい"],["の"],["元老","げんろう"],["で"],["ある"],["重臣","じゅうしん"],["たち"],["すべて"],["と"],["エジプト"],["の"],["国","くに"],["の"],["長老","ちょうろう"],["たち"],["すべて"],["、"]]},{"verse":8,"text":"それにヨセフの家族全員と彼の兄弟たち、および父の一族であった。ただ幼児と、羊と牛の群れはゴシェンの地域に残した。","tok":[["それ"],["に"],["ヨセフ"],["の"],["家族","かぞく"],["全員","ぜんいん"],["と"],["彼","かれ"],["の"],["兄弟","きょうだい"],["たち"],["、"],["および"],["父","ちち"],["の"],["一族","いちぞく"],["で"],["あった"],["。"],["ただ"],["幼児","ようじ"],["と"],["、"],["羊","ひつじ"],["と"],["牛","うし"],["の"],["群れ","むれ"],["は"],["ゴシェン"],["の"],["地域","ちいき"],["に"],["残した","のこした"],["。"]]},{"verse":9,"text":"また戦車も騎兵も共に上って行ったので、それはまことに盛大な行列となった。","tok":[["また"],["戦車","せんしゃ"],["も"],["騎兵","きへい"],["も"],["共","とも"],["に"],["上って","のぼって"],["行った","いった"],["ので"],["、"],["それ"],["は"],["まこと"],["に"],["盛大","せいだい"],["な"],["行列","ぎょうれつ"],["と"],["なった"],["。"]]},{"verse":10,"text":"一行はヨルダン川の東側にあるゴレン‧アタドに着き、そこで非常に荘厳な葬儀を行った。父の追悼の儀式は七日間にわたって行われた。","tok":[["一行","いっこう"],["は"],["ヨルダン"],["川","かわ"],["の"],["東側","ひがしがわ"],["に"],["ある"],["ゴレン"],["‧"],["アタド"],["に"],["着き","つき"],["、"],["そこ"],["で"],["非常","ひじょう"],["に"],["荘厳","そうごん"],["な"],["葬儀","そうぎ"],["を"],["行った","おこなった"],["。"],["父","ちち"],["の"],["追悼","ついとう"],["の"],["儀式","ぎしき"],["は"],["七","なな"],["日間","かかん"],["に"],["わたって"],["行われた","おこなわれた"],["。"]]},{"verse":11,"text":"その土地に住んでいるカナン人たちは、ゴレン‧アタドで行われた追悼の儀式を見て、「あれは、エジプト流の盛大な追悼の儀式だ」と言った。それゆえ、その場所の名は、アベル‧ミツライム（エジプト流の追悼の儀式）と呼ばれるようになった。それは、ヨルダン川の東側にある。","tok":[["その"],["土地","とち"],["に"],["住んで","すんで"],["いる"],["カナン人","かなんにん"],["たち"],["は"],["、"],["ゴレン"],["‧"],["アタド"],["で"],["行われた","おこなわれた"],["追悼","ついとう"],["の"],["儀式","ぎしき"],["を"],["見て","みて"],["、"],["「"],["あれ"],["は"],["、"],["エジプト"],["流","りゅう"],["の"],["盛大","せいだい"],["な"],["追悼","ついとう"],["の"],["儀式","ぎしき"],["だ"],["」"],["と"],["言った","いった"],["。"],["それ"],["ゆえ"],["、"],["その"],["場所","ばしょ"],["の"],["名","な"],["は"],["、"],["アベル"],["‧"],["ミツライム"],["（"],["エジプト"],["流","りゅう"],["の"],["追悼","ついとう"],["の"],["儀式","ぎしき"],["）"],["と"],["呼ばれる","よばれる"],["よう"],["に"],["なった"],["。"],["それ"],["は"],["、"],["ヨルダン"],["川","かわ"],["の"],["東側","ひがしがわ"],["に"],["ある"],["。"]]},{"verse":12,"text":"それから、ヤコブの息子たちは父に命じられたとおりに行った。","tok":[["それ"],["から"],["、"],["ヤコブ"],["の"],["息子","むすこ"],["たち"],["は"],["父","ちち"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"]]},{"verse":13,"text":"すなわち、ヤコブの息子たちは、父のなきがらをカナンの土地に運び、マクペラの畑の洞穴に葬った。それは、アブラハムがマムレの前にある畑とともにヘト人エフロンから買い取り、墓地として所有するようになったものである。","tok":[["すなわち"],["、"],["ヤコブ"],["の"],["息子","むすこ"],["たち"],["は"],["、"],["父","ちち"],["の"],["なきがら"],["を"],["カナン"],["の"],["土地","とち"],["に"],["運び","はこび"],["、"],["マクペラ"],["の"],["畑","はたけ"],["の"],["洞穴","ほらあな"],["に"],["葬った","ほうむった"],["。"],["それ"],["は"],["、"],["アブラハム"],["が"],["マムレ"],["の"],["前","まえ"],["に"],["ある"],["畑","はたけ"],["と"],["とも"],["に"],["ヘト人","へとにん"],["エフロン"],["から"],["買い取り","かいとり"],["、"],["墓地","ぼち"],["として"],["所有","しょゆう"],["する"],["よう"],["に"],["なった"],["もの"],["で"],["ある"],["。"]]},{"verse":14,"text":"ヨセフは父を葬った後、兄弟たちをはじめ、父を葬るために一緒に上って来たすべての人々と共にエジプトに帰った。","tok":[["ヨセフ"],["は"],["父","ちち"],["を"],["葬った","ほうむった"],["後","あと"],["、"],["兄弟","きょうだい"],["たち"],["を"],["はじめ"],["、"],["父","ちち"],["を"],["葬る","ほうむる"],["ため"],["に"],["一緒","いっしょ"],["に"],["上って","のぼって"],["来た","きた"],["すべて"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["エジプト"],["に"],["帰った","かえった"],["。"]]},{"verse":15,"text":"ヨセフの兄弟たちは、父が死んでしまったので、ヨセフがことによると自分たちをまだ恨み、昔ヨセフにしたすべての悪に仕返しをするのではないかと思った。","tok":[["ヨセフ"],["の"],["兄弟","きょうだい"],["たち"],["は"],["、"],["父","ちち"],["が"],["死んで","しんで"],["しまった"],["ので"],["、"],["ヨセフ"],["が"],["こと"],["に"],["よる"],["と"],["自分","じぶん"],["たち"],["を"],["まだ"],["恨み","うらみ"],["、"],["昔","むかし"],["ヨセフ"],["に"],["した"],["すべて"],["の"],["悪","わる"],["に"],["仕返し","しかえし"],["を"],["する"],["ので"],["は"],["ない"],["か"],["と"],["思った","おもった"],["。"]]},{"verse":16,"text":"そこで、人を介してヨセフに言った。「お父さんは亡くなる前に、こう言っていました。","tok":[["そこ"],["で"],["、"],["人","ひと"],["を"],["介して","かいして"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["お父さん","おとうさん"],["は"],["亡くなる","なくなる"],["前","まえ"],["に"],["、"],["こう"],["言って","いって"],["いました"],["。"]]},{"verse":17,"text":"『お前たちはヨセフにこう言いなさい。確かに、兄たちはお前に悪いことをしたが、どうか兄たちの咎と罪を赦してやってほしい。』お願いです。どうか、あなたの父の神に仕える僕たちの咎を赦してください。」これを聞いて、ヨセフは涙を流した。","tok":[["『"],["お前","おまえ"],["たち"],["は"],["ヨセフ"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["確か","たしか"],["に"],["、"],["兄たち","あにたち"],["は"],["お前","おまえ"],["に"],["悪い","わるい"],["こと"],["を"],["した"],["が"],["、"],["どう"],["か"],["兄たち","あにたち"],["の"],["咎","とが"],["と"],["罪","つみ"],["を"],["赦して","ゆるして"],["やって"],["ほしい"],["。"],["』"],["お願い","おねがい"],["です"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["父","ちち"],["の"],["神","かみ"],["に"],["仕える","つかえる"],["僕たち","ぼくたち"],["の"],["咎","とが"],["を"],["赦して","ゆるして"],["ください"],["。"],["」"],["これ"],["を"],["聞いて","きいて"],["、"],["ヨセフ"],["は"],["涙","なみだ"],["を"],["流した","ながした"],["。"]]},{"verse":18,"text":"やがて、兄たち自身もやって来て、ヨセフの前にひれ伏して、「このとおり、私どもはあなたの僕です」と言うと、","tok":[["やがて"],["、"],["兄たち","あにたち"],["自身","じしん"],["も"],["やって"],["来て","きて"],["、"],["ヨセフ"],["の"],["前","まえ"],["に"],["ひれ伏して","ひれふして"],["、"],["「"],["この"],["とおり"],["、"],["私","わたくし"],["ども"],["は"],["あなた"],["の"],["僕","ぼく"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":19,"text":"ヨセフは兄たちに言った。「恐れることはありません。わたしが神に代わることができましょうか。","tok":[["ヨセフ"],["は"],["兄たち","あにたち"],["に"],["言った","いった"],["。"],["「"],["恐れる","おそれる"],["こと"],["は"],["ありません"],["。"],["わたし"],["が"],["神","かみ"],["に"],["代わる","かわる"],["こと"],["が"],["できましょう"],["か"],["。"]]},{"verse":20,"text":"あなたがたはわたしに悪をたくらみましたが、神はそれを善に変え、多くの民の命を救うために、今日のようにしてくださったのです。","tok":[["あなた"],["がた"],["は"],["わたし"],["に"],["悪","あく"],["を"],["たくらみました"],["が"],["、"],["神","かみ"],["は"],["それ"],["を"],["善","ぜん"],["に"],["変え","かえ"],["、"],["多く","おおく"],["の"],["民","たみ"],["の"],["命","いのち"],["を"],["救う","すくう"],["ため"],["に"],["、"],["今日","きょう"],["の"],["よう"],["に"],["して"],["くださった"],["の"],["です"],["。"]]},{"verse":21,"text":"どうか恐れないでください。このわたしが、あなたたちとあなたたちの子供を養いましょう。」ヨセフはこのように、兄たちを慰め、優しく語りかけた。","tok":[["どう"],["か"],["恐れないで","おそれないで"],["ください"],["。"],["この"],["わたし"],["が"],["、"],["あなた"],["たち"],["と"],["あなた"],["たち"],["の"],["子供","こども"],["を"],["養いましょう","やしないましょう"],["。"],["」"],["ヨセフ"],["は"],["この"],["よう"],["に"],["、"],["兄たち","あにたち"],["を"],["慰め","なぐさめ"],["、"],["優しく","やさしく"],["語りかけた","かたりかけた"],["。"]]},{"verse":22,"text":"ヨセフは父の家族と共にエジプトに住み、百十歳まで生き、","tok":[["ヨセフ"],["は"],["父","ちち"],["の"],["家族","かぞく"],["と"],["共","とも"],["に"],["エジプト"],["に"],["住み","すみ"],["、"],["百十歳","ひゃくとうさい"],["まで"],["生き","いき"],["、"]]},{"verse":23,"text":"エフライムの三代の子孫を見ることができた。マナセの息子マキルの子供たちも生まれると、ヨセフの膝に抱かれた。","tok":[["エフライム"],["の"],["三","さん"],["代","だい"],["の"],["子孫","しそん"],["を"],["見る","みる"],["こと"],["が"],["できた"],["。"],["マナセ"],["の"],["息子","むすこ"],["マキル"],["の"],["子供","こども"],["たち"],["も"],["生まれる","うまれる"],["と"],["、"],["ヨセフ"],["の"],["膝","ひざ"],["に"],["抱かれた","いだかれた"],["。"]]},{"verse":24,"text":"ヨセフは兄弟たちに言った。「わたしは間もなく死にます。しかし、神は必ずあなたたちを顧みてくださり、この国からアブラハム、イサク、ヤコブに誓われた土地に導き上ってくださいます。」","tok":[["ヨセフ"],["は"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["間","ま"],["も"],["なく"],["死にます","しにます"],["。"],["しかし"],["、"],["神","かみ"],["は"],["必ず","かならず"],["あなた"],["たち"],["を"],["顧みて","かえりみて"],["くださり"],["、"],["この"],["国","くに"],["から"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓われた","ちかわれた"],["土地","とち"],["に"],["導き","みちびき"],["上って","のぼって"],["くださいます"],["。"],["」"]]},{"verse":25,"text":"それから、ヨセフはイスラエルの息子たちにこう言って誓わせた。「神は、必ずあなたたちを顧みてくださいます。そのときには、わたしの骨をここから携えて上ってください。」","tok":[["それ"],["から"],["、"],["ヨセフ"],["は"],["イスラエル"],["の"],["息子","むすこ"],["たち"],["に"],["こう"],["言って","いって"],["誓わせた","ちかわせた"],["。"],["「"],["神","かみ"],["は"],["、"],["必ず","かならず"],["あなた"],["たち"],["を"],["顧みて","かえりみて"],["くださいます"],["。"],["その"],["とき"],["に"],["は"],["、"],["わたし"],["の"],["骨","ほね"],["を"],["ここ"],["から"],["携えて","たずさえて"],["上って","のぼって"],["ください"],["。"],["」"]]},{"verse":26,"text":"ヨセフはこうして、百十歳で死んだ。人々はエジプトで彼のなきがらに薬を塗り、防腐処置をして、ひつぎに納めた。","tok":[["ヨセフ"],["は"],["こう"],["して"],["、"],["百十歳","ひゃくとうさい"],["で"],["死んだ","しんだ"],["。"],["人々","ひとびと"],["は"],["エジプト"],["で"],["彼","かれ"],["の"],["なきがら"],["に"],["薬","くすり"],["を"],["塗り","ぬり"],["
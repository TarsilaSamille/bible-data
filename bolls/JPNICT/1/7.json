[{"verse":1,"text":"主はノアに言われた。「さあ、あなたとあなたの家族は皆、箱舟に入りなさい。この世代の中であなただけはわたしに従う人だと、わたしは認めている。","tok":[["主","ぬし"],["は"],["ノア"],["に"],["言われた","いわれた"],["。"],["「"],["さあ"],["、"],["あなた"],["と"],["あなた"],["の"],["家族","かぞく"],["は"],["皆","みな"],["、"],["箱舟","はこぶね"],["に"],["入り","はいり"],["なさい"],["。"],["この"],["世代","せだい"],["の"],["中","なか"],["で"],["あなた"],["だけ"],["は"],["わたし"],["に"],["従う","したがう"],["人","ひと"],["だ"],["と"],["、"],["わたし"],["は"],["認めて","みとめて"],["いる"],["。"]]},{"verse":2,"text":"あなたは清い動物をすべて七つがいずつ取り、また、清くない動物をすべて一つがいずつ取りなさい。","tok":[["あなた"],["は"],["清い","きよい"],["動物","どうぶつ"],["を"],["すべて"],["七","なな"],["つがい"],["ずつ"],["取り","とり"],["、"],["また"],["、"],["清く","きよく"],["ない"],["動物","どうぶつ"],["を"],["すべて"],["一","ひと"],["つ"],["がい"],["ずつ"],["取り","とり"],["なさい"],["。"]]},{"verse":3,"text":"空の鳥も七つがい取りなさい。全地の面に子孫が生き続けるように。","tok":[["空","そら"],["の"],["鳥","とり"],["も"],["七","なな"],["つがい"],["取り","とり"],["なさい"],["。"],["全地","ぜんち"],["の"],["面","めん"],["に"],["子孫","しそん"],["が"],["生き","いき"],["続ける","つづける"],["よう"],["に"],["。"]]},{"verse":4,"text":"七日の後、わたしは四十日四十夜地上に雨を降らせ、わたしが造ったすべての生き物を地の面からぬぐい去ることにした。」","tok":[["七日","ななか"],["の"],["後","あと"],["、"],["わたし"],["は"],["四十日","よんとうか"],["四十夜","よんじゅうや"],["地上","ちじょう"],["に"],["雨","あめ"],["を"],["降らせ","ふらせ"],["、"],["わたし"],["が"],["造った","つくった"],["すべて"],["の"],["生き物","いきもの"],["を"],["地","ち"],["の"],["面","めん"],["から"],["ぬぐい去る","ぬぐいさる"],["こと"],["に"],["した"],["。"],["」"]]},{"verse":5,"text":"ノアは、すべて主が命じられたとおりにした。","tok":[["ノア"],["は"],["、"],["すべて"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"]]},{"verse":6,"text":"ノアが六百歳のとき、洪水が地上に起こり、水が地の上にみなぎった。","tok":[["ノア"],["が"],["六百歳","ろくひゃくさい"],["の"],["とき"],["、"],["洪水","こうずい"],["が"],["地上","ちじょう"],["に"],["起こり","おこり"],["、"],["水","みず"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["みなぎった"],["。"]]},{"verse":7,"text":"ノアは妻子や嫁たちと共に洪水を免れようと箱舟に入った。","tok":[["ノア"],["は"],["妻子","さいし"],["や"],["嫁","よめ"],["たち"],["と"],["共","とも"],["に"],["洪水","こうずい"],["を"],["免れよう","まぬがれよう"],["と"],["箱舟","はこぶね"],["に"],["入った","はいった"],["。"]]},{"verse":8,"text":"清い動物も清くない動物も、鳥も地を這うものもすべて、","tok":[["清い","きよい"],["動物","どうぶつ"],["も"],["清く","きよく"],["ない"],["動物","どうぶつ"],["も"],["、"],["鳥","とり"],["も"],["地","ち"],["を"],["這う","はう"],["もの"],["も"],["すべて"],["、"]]},{"verse":9,"text":"二つずつ箱舟のノアのもとに来た。それは神がノアに命じられたとおりに、雄と雌であった。","tok":[["二","ふた"],["つ"],["ずつ"],["箱舟","はこぶね"],["の"],["ノア"],["の"],["もと"],["に"],["来た","きた"],["。"],["それ"],["は"],["神","かみ"],["が"],["ノア"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["雄","おす"],["と"],["雌","めす"],["で"],["あった"],["。"]]},{"verse":10,"text":"七日が過ぎて、洪水が地上に起こった。","tok":[["七日","ななか"],["が"],["過ぎて","すぎて"],["、"],["洪水","こうずい"],["が"],["地上","ちじょう"],["に"],["起こった","おこった"],["。"]]},{"verse":11,"text":"ノアの生涯の第六百年、第二の月の十七日、この日、大いなる深淵の源がことごとく裂け、天の窓が開かれた。","tok":[["ノア"],["の"],["生涯","しょうがい"],["の"],["第","だい"],["六百","ろくひゃく"],["年","ねん"],["、"],["第","だい"],["二","に"],["の"],["月","つき"],["の"],["十七日","じゅうななか"],["、"],["この"],["日","ひ"],["、"],["大いなる","おおいなる"],["深淵","しんえん"],["の"],["源","みなもと"],["が"],["ことごとく"],["裂け","さけ"],["、"],["天","てん"],["の"],["窓","まど"],["が"],["開かれた","ひらかれた"],["。"]]},{"verse":12,"text":"雨が四十日四十夜地上に降り続いたが、","tok":[["雨","あめ"],["が"],["四十日","よんとうか"],["四十夜","よんじゅうや"],["地上","ちじょう"],["に"],["降り","ふり"],["続いた","つづいた"],["が"],["、"]]},{"verse":13,"text":"まさにこの日、ノアも、息子のセム、ハム、ヤフェト、ノアの妻、この三人の息子の嫁たちも、箱舟に入った。","tok":[["まさに"],["この"],["日","ひ"],["、"],["ノア"],["も"],["、"],["息子","むすこ"],["の"],["セム"],["、"],["ハム"],["、"],["ヤフェト"],["、"],["ノア"],["の"],["妻","つま"],["、"],["この"],["三人","さんにん"],["の"],["息子","むすこ"],["の"],["嫁","よめ"],["たち"],["も"],["、"],["箱舟","はこぶね"],["に"],["入った","はいった"],["。"]]},{"verse":14,"text":"彼らと共にそれぞれの獣、それぞれの家畜、それぞれの地を這うもの、それぞれの鳥、小鳥や翼のあるものすべて、","tok":[["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["それぞれ"],["の"],["獣","けもの"],["、"],["それぞれ"],["の"],["家畜","かちく"],["、"],["それぞれ"],["の"],["地","ち"],["を"],["這う","はう"],["もの"],["、"],["それぞれ"],["の"],["鳥","とり"],["、"],["小鳥","ことり"],["や"],["翼","つばさ"],["の"],["ある"],["もの"],["すべて"],["、"]]},{"verse":15,"text":"命の霊をもつ肉なるものは、二つずつノアのもとに来て箱舟に入った。","tok":[["命","いのち"],["の"],["霊","れい"],["を"],["もつ"],["肉","にく"],["なる"],["もの"],["は"],["、"],["二","ふた"],["つ"],["ずつ"],["ノア"],["の"],[
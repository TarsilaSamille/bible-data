[{"verse":1,"text":"主なる神が造られた野の生き物のうちで、最も賢いのは蛇であった。蛇は女に言った。「園のどの木からも食べてはいけない、などと神は言われたのか。」","tok":[["主","おも"],["なる"],["神","かみ"],["が"],["造られた","つくられた"],["野","の"],["の"],["生き物","いきもの"],["の"],["うち"],["で"],["、"],["最も","もっとも"],["賢い","かしこい"],["の"],["は"],["蛇","へび"],["で"],["あった"],["。"],["蛇","へび"],["は"],["女","おんな"],["に"],["言った","いった"],["。"],["「"],["園","その"],["の"],["どの"],["木","き"],["から"],["も"],["食べ","たべ"],["ては"],["いけない"],["、"],["など"],["と"],["神","かみ"],["は"],["言われた","いわれた"],["の"],["か"],["。"],["」"]]},{"verse":2,"text":"女は蛇に答えた。「わたしたちは園の木の果実を食べてもよいのです。","tok":[["女","おんな"],["は"],["蛇","へび"],["に"],["答えた","こたえた"],["。"],["「"],["わたしたち"],["は"],["園","その"],["の"],["木","き"],["の"],["果実","かじつ"],["を"],["食べて","たべて"],["も"],["よい"],["の"],["です"],["。"]]},{"verse":3,"text":"でも、園の中央に生えている木の果実だけは、食べてはいけない、触れてもいけない、死んではいけないから、と神様はおっしゃいました。」","tok":[["で"],["も"],["、"],["園","その"],["の"],["中央","ちゅうおう"],["に"],["生えて","はえて"],["いる"],["木","き"],["の"],["果実","かじつ"],["だけ"],["は"],["、"],["食べ","たべ"],["ては"],["いけない"],["、"],["触れて","ふれて"],["も"],["いけない"],["、"],["死んで","しんで"],["は"],["いけない"],["から"],["、"],["と"],["神様","かみさま"],["は"],["おっしゃいました"],["。"],["」"]]},{"verse":4,"text":"蛇は女に言った。「決して死ぬことはない。","tok":[["蛇","へび"],["は"],["女","おんな"],["に"],["言った","いった"],["。"],["「"],["決して","けっして"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":5,"text":"それを食べると、目が開け、神のように善悪を知るものとなることを神はご存じなのだ。」","tok":[["それ"],["を"],["食べる","たべる"],["と"],["、"],["目","め"],["が"],["開け","あけ"],["、"],["神","かみ"],["の"],["よう"],["に"],["善悪","ぜんあく"],["を"],["知る","しる"],["もの"],["と"],["なる"],["こと"],["を"],["神","かみ"],["は"],["ご存じ","ごぞんじ"],["な"],["の"],["だ"],["。"],["」"]]},{"verse":6,"text":"女が見ると、その木はいかにもおいしそうで、目を引き付け、賢くなるように唆していた。女は実を取って食べ、一緒にいた男にも渡したので、彼も食べた。","tok":[["女","おんな"],["が"],["見る","みる"],["と"],["、"],["その"],["木","き"],["は"],["いかに"],["も"],["おいし"],["そう"],["で"],["、"],["目","め"],["を"],["引き付け","ひきつけ"],["、"],["賢く","かしこく"],["なる"],["よう"],["に"],["唆して","そそのかして"],["いた"],["。"],["女","おんな"],["は"],["実","じつ"],["を"],["取って","とって"],["食べ","たべ"],["、"],["一緒","いっしょ"],["に"],["いた"],["男","おとこ"],["に"],["も"],["渡した","わたした"],["ので"],["、"],["彼","かれ"],["も"],["食べた","たべた"],["。"]]},{"verse":7,"text":"二人の目は開け、自分たちが裸であることを知り、二人はいちじくの葉をつづり合わせ、腰を覆うものとした。","tok":[["二人","ふたり"],["の"],["目","め"],["は"],["開け","あけ"],["、"],["自分","じぶん"],["たち"],["が"],["裸","はだか"],["で"],["ある"],["こと"],["を"],["知り","しり"],["、"],["二人","ふたり"],["は"],["いちじく"],["の"],["葉","は"],["を"],["つづり合わせ","つづりあわせ"],["、"],["腰","こし"],["を"],["覆う","おおう"],["もの"],["と"],["した"],["。"]]},{"verse":8,"text":"その日、風の吹くころ、主なる神が園の中を歩く音が聞こえてきた。アダムと女が、主なる神の顔を避けて、園の木の間に隠れると、","tok":[["その"],["日","ひ"],["、"],["風","かぜ"],["の"],["吹く","ふく"],["ころ"],["、"],["主","おも"],["なる"],["神","かみ"],["が"],["園","その"],["の"],["中","なか"],["を"],["歩く","あるく"],["音","おと"],["が"],["聞こえて","きこえて"],["きた"],["。"],["アダム"],["と"],["女","おんな"],["が"],["、"],["主","おも"],["なる"],["神","かみ"],["の"],["顔","かお"],["を"],["避けて","さけて"],["、"],["園","その"],["の"],["木の間","このま"],["に"],["隠れる","かくれる"],["と"],["、"]]},{"verse":9,"text":"主なる神はアダムを呼ばれた。「どこにいるのか。」","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["アダム"],["を"],["呼ばれた","よばれた"],["。"],["「"],["どこ"],["に"],["いる"],["の"],["か"],["。"],["」"]]},{"verse":10,"text":"彼は答えた。「あなたの足音が園の中に聞こえたので、恐ろしくなり、隠れております。わたしは裸ですから。」","tok":[["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["足音","あしおと"],["が"],["園","その"],["の"],["中","なか"],["に"],["聞こえた","きこえた"],["ので"],["、"],["恐ろしく","おそろしく"],["なり"],["、"],["隠れて","かくれて"],["おります"],["。"],["わたし"],["は"],["裸","はだか"],["です"],["から"],["。"],["」"]]},{"verse":11,"text":"神は言われた。「お前が裸であることを誰が告げたのか。取って食べるなと命じた木から食べたのか。」","tok":[["神","かみ"],["は"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["が"],["裸","はだか"],["で"],["ある"],["こと"],["を"],["誰","だれ"],["が"],["告げた","つげた"],["の"],["か"],["。"],["取って","とって"],["食べる","たべる"],["な"],["と"],["命じた","めいじた"],["木","き"],["から"],["食べた","たべた"],["の"],["か"],["。"],["」"]]},{"verse":12,"text":"アダムは答えた。「あなたがわたしと共にいるようにしてくださった女が、木から取って与えたので、食べました。」","tok":[["アダム"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["が"],["わたし"],["と"],["共","とも"],["に"],["いる"],["よう"],["に"],["して"],["くださった"],["女","おんな"],["が"],["、"],["木","き"],["から"],["取って","とって"],["与えた","あたえた"],["ので"],["、"],["食べました","たべました"],["。"],["」"]]},{"verse":13,"text":"主なる神は女に向かって言われた。「何ということをしたのか。」女は答えた。「蛇がだましたので、食べてしまいました。」","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["女","おんな"],["に"],["向かって","むかって"],["言われた","いわれた"],["。"],["「"],["何","なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["か"],["。"],["」"],["女","おんな"],["は"],["答えた","こたえた"],["。"],["「"],["蛇","へび"],["が"],["だました"],["ので"],["、"],["食べて","たべて"],["しまいました"],["。"],["」"]]},{"verse":14,"text":"主なる神は、蛇に向かって言われた。「このようなことをしたお前はあらゆる家畜、あらゆる野の獣の中で呪われるものとなった。お前は、生涯這いまわり、塵を食らう。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["、"],["蛇","へび"],["に"],["向かって","むかって"],["言われた","いわれた"],["。"],["「"],["この"],["よう"],["な"],["こと"],["を"],["した"],["お前","おまえ"],["は"],["あらゆる"],["家畜","かちく"],["、"],["あらゆる"],["野","の"],["の"],["獣","けもの"],["の"],["中","なか"],["で"],["呪われる","のろわれる"],["もの"],["と"],["なった"],["。"],["お前","おまえ"],["は"],["、"],["生涯","しょうがい"],["這いまわり","はいまわり"],["、"],["塵","ごみ"],["を"],["食らう","くらう"],["。"]]},{"verse":15,"text":"お前と女、お前の子孫と女の子孫の間にわたしは敵意を置く。彼はお前の頭を砕きお前は彼のかかとを砕く。」","tok":[["お前","おまえ"],["と"],["女","おんな"],["、"],["お前","おまえ"],["の"],["子孫","しそん"],["と"],["女","おんな"],["の"],["子孫","しそん"],["の"],["間","あいだ"],["に"],["わたし"],["は"],["敵意","てきい"],["を"],["置く","おく"],["。"],["彼","かれ"],["は"],["お前","おまえ"],["の"],["頭","あたま"],["を"],["砕き","くだき"],["お前","おまえ"],["は"],["彼","かれ"],["の"],["かかと"],["を"],["砕く","くだく"],["。"],["」"]]},{"verse":16,"text":"神は女に向かって言われた。「お前のはらみの苦しみを大きなものにする。お前は、苦しんで子を産む。お前は男を求め彼はお前を支配する。」","tok":[["神","かみ"],["は"],["女","おんな"],["に"],["向かって","むかって"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["の"],["はらみ"],["の"],["苦しみ","くるしみ"],["を"],["大きな","おおきな"],["もの"],["に"],["する"],["。"],["お前","おまえ"],["は"],["、"],["苦しんで","くるしんで"],["子","こ"],["を"],["産む","うむ"],["。"],["お前","おまえ"],["は"],["男","おとこ"],["を"],["求め","もとめ"],["彼","かれ"],["は"],["お前","おまえ"],["を"],["支配","しはい"],["する"],["。"],["」"]]},{"verse":17,"text":"神はアダムに向かって言われた。「お前は女の声に従い取って食べるなと命じた木から食べた。お前のゆえに、土は呪われるものとなった。お前は、生涯食べ物を得ようと苦しむ。","tok":[["神","かみ"],["は"],["アダム"],["に"],["向かって","むかって"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["女","おんな"],["の"],["声","こえ"],["に"],["従い","したがい"],["取って","とって"],["食べる","たべる"],["な"],["と"],["命じた","めいじた"],["木","き"],["から"],["食べた","たべた"],["。"],["お前","おまえ"],["の"],["ゆえ"],["に"],["、"],["土","つち"],["は"],["呪われる","のろわれる"],["もの"],["と"],["なった"],["。"],["お前","おまえ"],["は"],["、"],["生涯","しょうがい"],["食べ物","たべもの"],["を"],["得よう","えよう"],["と"],["苦しむ","くるしむ"],["。"]]},{"verse":18,"text":"お前に対して土は茨とあざみを生えいでさせる野の草を食べようとするお前に。","tok":[["お前","おまえ"],["に対して","にたいして"],["土","ど"],["は"],["茨","うばら"],["と"],["あざみ"],["を"],["生え","はえ"],["いでさせる"],["野","の"],["の"],["草","くさ"],["を"],["食べよう","たべよう"],["と"],["する"],["お前","おまえ"],["に"],["。"]]},{"verse":19,"text":"お前は顔に汗を流してパンを得る土に返るときまで。お前がそこから取られた土に。塵にすぎないお前は塵に返る。」","tok":[["お前","おまえ"],["は"],["顔","かお"],["に"],["汗","あせ"],["を"],["流して","ながして"],["パン"],["を"],["得る","える"],["土","つち"],["に"],["返る","かえる"],["とき"],["まで"],["。"],["お前","おまえ"],["が"],["そこ"],["から"],["取られた","とられた"],["土","つち"],["に"],["。"],["塵","ごみ"],["に"],["すぎない"],["お前","おまえ"],["は"],["塵","ごみ"],["に"],["返る","かえる"],["。"],["」"]]},{"verse":20,"text":"アダムは女をエバ（命）と名付けた。彼女がすべて命あるものの母となったからである。","tok":[["アダム"],["は"],["女","おんな"],["を"],["エバ"],["（"],["命","いのち"],["）"],["と"],["名付けた","なづけた"],["。"],["彼女","かのじょ"],["が"],["すべて"],["命","いのち"],["ある"],["もの"],["の"],["母","はは"],["と"],["なった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"主なる神は、アダムと女に皮の衣を作って着せられた。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["、"],["アダム"],["と"],["女","おんな"],["に"],["皮","かわ"],["の"],["衣","ころも"],["を"],["作って","つくって"],["着せられた","きせられた"],["。"]]},{"verse":22,"text":"主なる神は言われた。「人は我々の一人のように、善悪を知る者となった。今は、手を伸ばして命の木からも取って食べ、永遠に生きる者となるおそれがある。」","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["は"],["我々","われわれ"],["の"],["一人","ひとり"],["の"],["よう"],["に"],["、"],["善悪","ぜんあく"],["を"],["知る","しる"],["者","もの"],["と"],["なった"],["。"],["今","いま"],["は"],["、"],["手","て"],["を"],["伸ばして","のばして"],["命","いのち"],["の"],["木","き"],["から"],["も"],["取って","とって"],["食べ","たべ"],["、"],["永遠","えいえん"],["に"],["生きる","いきる"],["者","もの"],["と"],["なる"],["おそれ"],["が"],["ある"],["。"],["」"]]},{"verse":23,"text":"主なる神は、彼をエデンの園から追い出し、彼に、自分がそこから取られた土を耕させることにされた。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["、"],["彼","かれ"],["を"],["エデン"],["の"],["園","その"],["から"],["追い出し","おいだし"],["、"],["彼","かれ"],["に"],["、"],["自分","じぶん"],["が"],["そこ"],["から"],["取られた","とられた"],["土","つち"],["を"],["耕させる","たがやさせる"],["こと"],["に"],["された"],["。"]]},{"verse":24,"text":"こうしてアダムを追放し、命の木に至る道を守るために、エデンの園の東にケルビムと、きらめく剣の炎を置かれた。","tok":[["こう"],["して"],["アダム"],["を"],["追放","ついほう"],["し"],["、"],["命","いのち"],["の"],["木","き"],["に"],["至る","いたる"],["道","みち"],["を"],["守る","まもる"],["ため"],["に"],["、"],["エデン"],["の"],["園","その"],["の"],["東","ひがし"],["に"],["ケルビム"],["と"],["、"],["きらめく"],["剣","けん"],["の"],["炎","ほのお"],["を"],["置かれた","おかれた"],["。"]]}]
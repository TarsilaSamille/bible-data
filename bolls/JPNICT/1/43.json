["の"],["兄","あに"],["から"],["末","すえ"],["の"],["弟","おとうと"],["まで"],["、"],["ヨセフ"],["に"],["向かって","むかって"],["年齢","ねんれい"],["順","じゅん"],["に"],["座らされた","すわらされた"],["ので"],["、"],["驚いて","おどろいて"],["互い","たがい"],["に"],["顔","かお"],["を"],["見合わせた","みあわせた"],["。"]]},{"verse":34,"text":"そして、料理がヨセフの前からみんなのところへ配られたが、ベニヤミンの分はほかのだれの分より五倍も多かった。一同はぶどう酒を飲み、ヨセフと共に酒宴を楽しんだ。","tok":[["そして"],["、"],["料理","りょうり"],["が"],["ヨセフ"],["の"],["前","まえ"],["から"],["みんな"],["の"],["ところ"],["へ"],["配られた","くばられた"],["が"],["、"],["ベニヤミン"],["の"],["分","ぶん"],["は"],["ほか"],["の"],["だれ"],["の"],["分","ぶん"],["より"],["五","ご"],["倍","ばい"],["も"],["多かった","おおかった"],["。"],["一同","いちどう"],["は"],["ぶどう酒","ぶどうしゅ"],["を"],["飲み","のみ"],["、"],["ヨセフ"],["と"],["共","とも"],["に"],["酒宴","しゅえん"],["を"],["楽しんだ","たのしんだ"],["。"]]}]
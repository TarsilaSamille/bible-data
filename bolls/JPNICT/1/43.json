[{"verse":1,"text":"この地方の飢饉はひどくなる一方であった。","tok":[["この"],["地方","ちほう"],["の"],["飢饉","ききん"],["は"],["ひどく"],["なる"],["一方","いっぽう"],["で"],["あった"],["。"]]},{"verse":2,"text":"エジプトから持ち帰った穀物を食べ尽くすと、父は息子たちに言った。「もう一度行って、我々の食糧を少し買って来なさい。」","tok":[["エジプト"],["から"],["持ち帰った","もちかえった"],["穀物","こくもつ"],["を"],["食べ","たべ"],["尽くす","つくす"],["と"],["、"],["父","ちち"],["は"],["息子","むすこ"],["たち"],["に"],["言った","いった"],["。"],["「"],["もう"],["一度","いちど"],["行って","いって"],["、"],["我々","われわれ"],["の"],["食糧","しょくりょう"],["を"],["少し","すこし"],["買って","かって"],["来","き"],["なさい"],["。"],["」"]]},{"verse":3,"text":"しかし、ユダは答えた。「あの人は、『弟が一緒でないかぎり、わたしの顔を見ることは許さぬ』と、厳しく我々に言い渡したのです。","tok":[["しかし"],["、"],["ユダ"],["は"],["答えた","こたえた"],["。"],["「"],["あの"],["人","ひと"],["は"],["、"],["『"],["弟","おとうと"],["が"],["一緒","いっしょ"],["で"],["ない"],["かぎり"],["、"],["わたし"],["の"],["顔","かお"],["を"],["見る","みる"],["こと"],["は"],["許さぬ","ゆるさぬ"],["』"],["と"],["、"],["厳しく","きびしく"],["我々","われわれ"],["に"],["言い渡した","いいわたした"],["の"],["です"],["。"]]},{"verse":4,"text":"もし弟を一緒に行かせてくださるなら、我々は下って行って、あなたのために食糧を買って参ります。","tok":[["もし"],["弟","おとうと"],["を"],["一緒","いっしょ"],["に"],["行かせて","いかせて"],["くださるなら"],["、"],["我々","われわれ"],["は"],["下って","くだって"],["行って","いって"],["、"],["あなた"],["の"],["ため"],["に"],["食糧","しょくりょう"],["を"],["買って","かって"],["参ります","まいります"],["。"]]},{"verse":5,"text":"しかし、一緒に行かせてくださらないのなら、行くわけにはいきません。『弟が一緒でないかぎり、わたしの顔を見ることは許さぬ』と、あの人が我々に言ったのですから。」","tok":[["しかし"],["、"],["一緒","いっしょ"],["に"],["行かせて","いかせて"],["くださらない"],["の"],["なら"],["、"],["行く","いく"],["わけ"],["に"],["は"],["いきません"],["。"],["『"],["弟","おとうと"],["が"],["一緒","いっしょ"],["で"],["ない"],["かぎり"],["、"],["わたし"],["の"],["顔","かお"],["を"],["見る","みる"],["こと"],["は"],["許さぬ","ゆるさぬ"],["』"],["と"],["、"],["あの"],["人","ひと"],["が"],["我々","われわれ"],["に"],["言った","いった"],["の"],["です"],["から"],["。"],["」"]]},{"verse":6,"text":"「なぜお前たちは、その人にもう一人弟がいるなどと言って、わたしを苦しめるようなことをしたのか」とイスラエルが言うと、","tok":[["「"],["なぜ"],["お前","おまえ"],["たち"],["は"],["、"],["その"],["人","ひと"],["に"],["もう"],["一人","ひとり"],["弟","おとうと"],["が"],["いる"],["など"],["と"],["言って","いって"],["、"],["わたし"],["を"],["苦しめる","くるしめる"],["よう"],["な"],["こと"],["を"],["した"],["の"],["か"],["」"],["と"],["イスラエル"],["が"],["言う","ゆう"],["と"],["、"]]},{"verse":7,"text":"彼らは答えた。「あの人が、我々のことや家族のことについて、『お前たちの父親は、まだ生きているのか』とか、『お前たちには、まだほかに弟がいるのか』などと、しきりに尋ねるものですから、尋ねられるままに答えただけです。まさか、『弟を連れて来い』などと言われようとは思いも寄りませんでしたから。」","tok":[["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["あの"],["人","ひと"],["が"],["、"],["我々","われわれ"],["の"],["こと"],["や"],["家族","かぞく"],["の"],["こと"],["について"],["、"],["『"],["お前","おまえ"],["たち"],["の"],["父親","ちちおや"],["は"],["、"],["まだ"],["生きて","いきて"],["いる"],["の"],["か"],["』"],["と"],["か"],["、"],["『"],["お前","おまえ"],["たち"],["に"],["は"],["、"],["まだ"],["ほか"],["に"],["弟","おとうと"],["が"],["いる"],["の"],["か"],["』"],["など"],["と"],["、"],["しきり"],["に"],["尋ねる","たずねる"],["もの"],["です"],["から"],["、"],["尋ねられる","たずねられる"],["まま"],["に"],["答えた","こたえた"],["だけ"],["です"],["。"],["まさか"],["、"],["『"],["弟","おとうと"],["を"],["連れて","つれて"],["来い","こい"],["』"],["など"],["と"],["言われよう","いわれよう"],["と"],["は"],["思い","おもい"],["も"],["寄りませんでした","よりませんでした"],["から"],["。"],["」"]]},{"verse":8,"text":"ユダは、父イスラエルに言った。「あの子をぜひわたしと一緒に行かせてください。それなら、すぐにでも行って参ります。そうすれば、我々も、あなたも、子供たちも死なずに生き延びることができます。","tok":[["ユダ"],["は"],["、"],["父","ちち"],["イスラエル"],["に"],["言った","いった"],["。"],["「"],["あの"],["子","こ"],["を"],["ぜひ"],["わたし"],["と"],["一緒","いっしょ"],["に"],["行かせて","いかせて"],["ください"],["。"],["それ"],["なら"],["、"],["すぐ"],["に"],["で"],["も"],["行って","いって"],["参ります","まいります"],["。"],["そう"],["すれば"],["、"],["我々","われわれ"],["も"],["、"],["あなた"],["も"],["、"],["子供","こども"],["たち"],["も"],["死なず","しなず"],["に"],["生き延びる","いきのびる"],["こと"],["が"],["できます"],["。"]]},{"verse":9,"text":"あの子のことはわたしが保障します。その責任をわたしに負わせてください。もしも、あの子をお父さんのもとに連れ帰らず、無事な姿をお目にかけられないようなことにでもなれば、わたしがあなたに対して生涯その罪を負い続けます。","tok":[["あの"],["子","こ"],["の"],["こと"],["は"],["わたし"],["が"],["保障","ほしょう"],["します"],["。"],["その"],["責任","せきにん"],["を"],["わたし"],["に"],["負わせて","おわせて"],["ください"],["。"],["もし"],["も"],["、"],["あの"],["子","こ"],["を"],["お父さん","おとうさん"],["の"],["もと"],["に"],["連れ帰らず","つれかえらず"],["、"],["無事","ぶじ"],["な"],["姿","すがた"],["を"],["お目","おめ"],["に"],["かけられない"],["よう"],["な"],["こと"],["に"],["で"],["も"],["なれば"],["、"],["わたし"],["が"],["あなた"],["に対して","にたいして"],["生涯","しょうがい"],["その"],["罪","つみ"],["を"],["負い","おい"],["続けます","つづけます"],["。"]]},{"verse":10,"text":"こんなにためらっていなければ、今ごろはもう二度も行って来たはずです。」","tok":[["こんな"],["に"],["ためらって"],["いなければ"],["、"],["今ごろ","いまごろ"],["は"],["もう"],["二","に"],["度","ど"],["も"],["行って","いって"],["来た","きた"],["はず"],["です"],["。"],["」"]]},{"verse":11,"text":"すると、父イスラエルは息子たちに言った。「どうしてもそうしなければならないのなら、こうしなさい。この土地の名産の品を袋に入れて、その人への贈り物として持って行くのだ。乳香と蜜を少し、樹脂と没薬、ピスタチオやアーモンドの実。","tok":[["する"],["と"],["、"],["父","ちち"],["イスラエル"],["は"],["息子","むすこ"],["たち"],["に"],["言った","いった"],["。"],["「"],["どう"],["して"],["も"],["そう"],["しなければ"],["ならない"],["の"],["なら"],["、"],["こう"],["し"],["なさい"],["。"],["この"],["土地","とち"],["の"],["名産","めいさん"],["の"],["品","しな"],["を"],["袋","ふくろ"],["に"],["入れて","いれて"],["、"],["その"],["人","ひと"],["へ"],["の"],["贈り物","おくりもの"],["として"],["持って","もって"],["行く","いく"],["の"],["だ"],["。"],["乳香","にゅうこう"],["と"],["蜜","みつ"],["を"],["少し","すこし"],["、"],["樹脂","じゅし"],["と"],["没薬","もつやく"],["、"],["ピスタチオ"],["や"],["アーモンド"],["の"],["実","じつ"],["。"]]},{"verse":12,"text":"それから、銀を二倍用意して行きなさい。袋の口に戻されていた銀も持って行ってお返しするのだ。たぶん何かの間違いだったのだろうから。","tok":[["それ"],["から"],["、"],["銀","ぎん"],["を"],["二","に"],["倍","ばい"],["用意","ようい"],["して"],["行き","いき"],["なさい"],["。"],["袋","ふくろ"],["の"],["口","くち"],["に"],["戻されて","もどされて"],["いた"],["銀","ぎん"],["も"],["持って","もって"],["行って","いって"],["お返し","おかえし"],["する"],["の"],["だ"],["。"],["たぶん"],["何","なん"],["か"],["の"],["間違い","まちがい"],["だった"],["の"],["だろう"],["から"],["。"]]},{"verse":13,"text":"では、弟を連れて、早速その人のところへ戻りなさい。","tok":[["で"],["は"],["、"],["弟","おとうと"],["を"],["連れて","つれて"],["、"],["早速","さっそく"],["その"],["人","ひと"],["の"],["ところ"],["へ"],["戻り","もどり"],["なさい"],["。"]]},{"verse":14,"text":"どうか、全能の神がその人の前でお前たちに憐れみを施し、もう一人の兄弟と、このベニヤミンを返してくださいますように。このわたしがどうしても子供を失わねばならないのなら、失ってもよい。」","tok":[["どう"],["か"],["、"],["全能","ぜんのう"],["の"],["神","かみ"],["が"],["その"],["人","ひと"],["の"],["前","まえ"],["で"],["お前","おまえ"],["たち"],["に"],["憐れみ","あわれみ"],["を"],["施し","ほどこし"],["、"],["もう"],["一人","ひとり"],["の"],["兄弟","きょうだい"],["と"],["、"],["この"],["ベニヤミン"],["を"],["返して","かえして"],["くださいます"],["よう"]
[{"verse":1,"text":"神はヤコブに言われた。「さあ、ベテルに上り、そこに住みなさい。そしてその地に、あなたが兄エサウを避けて逃げて行ったとき、あなたに現れた神のための祭壇を造りなさい。」","tok":[["神","かみ"],["は"],["ヤコブ"],["に"],["言われた","いわれた"],["。"],["「"],["さあ"],["、"],["ベテル"],["に"],["上り","のぼり"],["、"],["そこ"],["に"],["住み","すみ"],["なさい"],["。"],["そして"],["その"],["地","ち"],["に"],["、"],["あなた"],["が"],["兄","あに"],["エサウ"],["を"],["避けて","さけて"],["逃げて","にげて"],["行った","いった"],["とき"],["、"],["あなた"],["に"],["現れた","あらわれた"],["神","かみ"],["の"],["ため"],["の"],["祭壇","さいだん"],["を"],["造り","つくり"],["なさい"],["。"],["」"]]},{"verse":2,"text":"ヤコブは、家族の者や一緒にいるすべての人々に言った。「お前たちが身に着けている外国の神々を取り去り、身を清めて衣服を着替えなさい。","tok":[["ヤコブ"],["は"],["、"],["家族","かぞく"],["の"],["者","もの"],["や"],["一緒","いっしょ"],["に"],["いる"],["すべて"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["たち"],["が"],["身","み"],["に"],["着けて","つけて"],["いる"],["外国","がいこく"],["の"],["神々","かみがみ"],["を"],["取り去り","とりさり"],["、"],["身","み"],["を"],["清めて","きよめて"],["衣服","いふく"],["を"],["着替え","きがえ"],["なさい"],["。"]]},{"verse":3,"text":"さあ、これからベテルに上ろう。わたしはその地に、苦難の時わたしに答え、旅の間わたしと共にいてくださった神のために祭壇を造る。」","tok":[["さあ"],["、"],["これ"],["から"],["ベテル"],["に"],["上ろう","のぼろう"],["。"],["わたし"],["は"],["その"],["地","ち"],["に"],["、"],["苦難","くなん"],["の"],["時","とき"],["わたし"],["に"],["答え","こたえ"],["、"],["旅","たび"],["の"],["間","あいだ"],["わたし"],["と"],["共","とも"],["に"],["いて"],["くださった"],["神","かみ"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["造る","つくる"],["。"],["」"]]},{"verse":4,"text":"人々は、持っていた外国のすべての神々と、着けていた耳飾りをヤコブに渡したので、ヤコブはそれらをシケムの近くにある樫の木の下に埋めた。","tok":[["人々","ひとびと"],["は"],["、"],["持って","もって"],["いた"],["外国","がいこく"],["の"],["すべて"],["の"],["神々","かみがみ"],["と"],["、"],["着けて","つけて"],["いた"],["耳飾り","みみかざり"],["を"],["ヤコブ"],["に"],["渡した","わたした"],["ので"],["、"],["ヤコブ"],["は"],["それ"],["ら"],["を"],["シケム"],["の"],["近く","ちかく"],["に"],["ある"],["樫","かし"],["の"],["木","き"],["の"],["下","した"],["に"],["埋めた","うめた"],["。"]]},{"verse":5,"text":"こうして一同は出発したが、神が周囲の町々を恐れさせたので、ヤコブの息子たちを追跡する者はなかった。","tok":[["こう"],["して"],["一同","いちどう"],["は"],["出発","しゅっぱつ"],["した"],["が"],["、"],["神","かみ"],["が"],["周囲","しゅうい"],["の"],["町々","まちまち"],["を"],["恐れさせた","おそれさせた"],["ので"],["、"],["ヤコブ"],["の"],["息子","むすこ"],["たち"],["を"],["追跡","ついせき"],["する"],["者","もの"],["は"],["なかった"],["。"]]},{"verse":6,"text":"ヤコブはやがて、一族の者すべてと共に、カナン地方のルズ、すなわちベテルに着き、","tok":[["ヤコブ"],["は"],["やがて"],["、"],["一族","いちぞく"],["の"],["者","もの"],["すべて"],["と"],["共","とも"],["に"],["、"],["カナン"],["地方","ちほう"],["の"],["ルズ"],["、"],["すなわち"],["ベテル"],["に"],["着き","つき"],["、"]]},{"verse":7,"text":"そこに祭壇を築いて、その場所をエル‧ベテルと名付けた。兄を避けて逃げて行ったとき、神がそこでヤコブに現れたからである。","tok":[["そこ"],["に"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["その"],["場所","ばしょ"],["を"],["エル"],["‧"],["ベテル"],["と"],["名付けた","なづけた"],["。"],["兄","あに"],["を"],["避けて","さけて"],["逃げて","にげて"],["行った","いった"],["とき"],["、"],["神","かみ"],["が"],["そこ"],["で"],["ヤコブ"],["に"],["現れた","あらわれた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"リベカの乳母デボラが死に、ベテルの下手にある樫の木の下に葬られた。そこで、その名はアロン‧バクト（嘆きの樫の木）と呼ばれるようになった。","tok":[["リベカ"],["の"],["乳母","うば"],["デボラ"],["が"],["死に","しに"],["、"],["ベテル"],["の"],["下手","へた"],["に"],["ある"],["樫","かし"],["の"],["木","き"],["の"],["下","した"],["に"],["葬られた","ほうむられた"],["。"],["そこ"],["で"],["、"],["その"],["名","な"],["は"],["アロン"],["‧"],["バクト"],["（"],["嘆き","なげき"],["の"],["樫","かし"],["の"],["木","き"],["）"],["と"],["呼ばれる","よばれる"],["よう"],["に"],["なった"],["。"]]},{"verse":9,"text":"ヤコブがパダン‧アラムから帰って来たとき、神は再びヤコブに現れて彼を祝福された。","tok":[["ヤコブ"],["が"],["パダン"],["‧"],["アラム"],["から"],["帰って","かえって"],["来た","きた"],["とき"],["、"],["神","かみ"],["は"],["再び","ふたたび"],["ヤコブ"],["に"],["現れて","あらわれて"],["彼","かれ"],["を"],["祝福","しゅくふく"],["された"],["。"]]},{"verse":10,"text":"神は彼に言われた。「あなたの名はヤコブである。しかし、あなたの名はもはやヤコブと呼ばれない。イスラエルがあなたの名となる。」神はこうして、彼をイスラエルと名付けられた。","tok":[["神","かみ"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["名","な"],["は"],["ヤコブ"],["で"],["ある"],["。"],["しかし"],["、"],["あなた"],["の"],["名","な"],["は"],["もはや"],["ヤコブ"],["と"],["呼ばれない","よばれない"],["。"],["イスラエル"],["が"],["あなた"],["の"],["名","な"],["と"],["なる"],["。"],["」"],["神","かみ"],["は"],["こう"],["して"],["、"],["彼","かれ"],["を"],["イスラエル"],["と"],["名付けられた","なづけられた"],["。"]]},{"verse":11,"text":"神は、また彼に言われた。「わたしは全能の神である。産めよ、増えよ。あなたから一つの国民、いや多くの国民の群れが起こりあなたの腰から王たちが出る。","tok":[["神","かみ"],["は"],["、"],["また"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["全能","ぜんのう"],["の"],["神","かみ"],["で"],["ある"],["。"],["産めよ","うめよ"],["、"],["増え","ふえ"],["よ"],["。"],["あなた"],["から"],["一","ひと"],["つ"],["の"],["国民","こくみん"],["、"],["いや"],["多く","おおく"],["の"],["国民","こくみん"],["の"],["群れ","むれ"],["が"],["起こり","おこり"],["あなた"],["の"],["腰","こし"],["から"],["王","おう"],["たち"],["が"],["出る","でる"],["。"]]},{"verse":12,"text":"わたしは、アブラハムとイサクに与えた土地をあなたに与える。また、あなたに続く子孫にこの土地を与える。」","tok":[["わたし"],["は"],["、"],["アブラハム"],["と"],["イサク"],["に"],["与えた","あたえた"],["土地","とち"],["を"],["あなた"],["に"],["与える","あたえる"],["。"],["また"],["、"],["あなた"],["に"],["続く","つづく"],["子孫","しそん"],["に"],["この"],["土地","とち"],["を"],["与える","あたえる"],["。"],["」"]]},{"verse":13,"text":"神はヤコブと語られた場所を離れて昇って行かれた。","tok":[["神","かみ"],["は"],["ヤコブ"],["と"],["語られた","かたられた"],["場所","ばしょ"],["を"],["離れて","はなれて"],["昇って","のぼって"],["行かれた","いかれた"],["。"]]},{"verse":14,"text":"ヤコブは、神が自分と語られた場所に記念碑を立てた。それは石の柱で、彼はその上にぶどう酒を注ぎかけ、また油を注いだ。","tok":[["ヤコブ"],["は"],["、"],["神","かみ"],["が"],["自分","じぶん"],["と"],["語られた","かたられた"],["場所","ばしょ"],["に"],["記念碑","きねんひ"],["を"],["立てた","たてた"],["。"],["それ"],["は"],["石","いし"],["の"],["柱","はしら"],["で"],["、"],["彼","かれ"],["は"],["その"],["上","うえ"],["に"],["ぶどう酒","ぶどうしゅ"],["を"],["注ぎ","そそぎ"],["かけ"],["、"],["また"],["油","あぶら"],["を"],["注いだ","そそいだ"],["。"]]},{"verse":15,"text":"そしてヤコブは、神が自分と語られた場所をベテルと名付けた。","tok":[["そして"],["ヤコブ"],["は"],["、"],["神","かみ"],["が"],["自分","じぶん"],["と"],["語られた","かたられた"],["場所","ばしょ"],["を"],["ベテル"],["と"],["名付けた","なづけた"],["。"]]},{"verse":16,"text":"一同がベテルを出発し、エフラタまで行くにはまだかなりの道のりがあるときに、ラケルが産気づいたが、難産であった。","tok":[["一同","いちどう"],["が"],["ベテル"],["を"],["出発","しゅっぱつ"],["し"],["、"],["エフラタ"],["まで"],["行く","いく"],["に"],["は"],["まだか"],["なり"],["の"],["道のり","みちのり"],["が"],["ある"],["とき"],["に"],["、"],["ラケル"],["が"],["産気","さんけ"],["づいた"],["が"],["、"],["難産","なんざん"],["で"],["あった"],["。"]]},{"verse":17,"text":"ラケルが産みの苦しみをしているとき、助産婦は彼女に、「心配ありません。今度も男の子ですよ」と言った。","tok":[["ラケル"],["が"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["して"],["いる"],["とき"],["、"],["助産婦","じょさんぷ"],["は"],["彼女","かのじょ"],["に"],["、"],["「"],["心配","しんぱい"],["ありません"],["。"],["今度","こんど"],["も"],["男の子","おとこのこ"],["です"],["よ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"ラケルが最後の息を引き取ろうとするとき、その子をベン‧オニ（わたしの苦しみの子）と名付けたが、父はこれをベニヤミン（幸いの子）と呼んだ。","tok":[["ラケル"],["が"],["最後","さいご"],["の"],["息","いき"],["を"],["引き取ろう","ひきとろう"],["と"],["する"],["とき"],["、"],["その"],["子","こ"],["を"],["ベン"],["‧"],["オニ"],["（"],["わたし"],["の"],["苦しみ","くるしみ"],["の"],["子","こ"],["）"],["と"],["名付けた","なづけた"],["が"],["、"],["父","ちち"],["は"],["これ"],["を"],["ベニヤミン"],["（"],["幸い","さいわい"],["の"],["子","こ"],["）"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":19,"text":"ラケルは死んで、エフラタ、すなわち今日のベツレヘムへ向かう道の傍らに葬られた。","tok":[["ラケル"],["は"],["死んで","しんで"],["、"],["エフラタ"],["、"],["すなわち"],["今日","きょう"],["の"],["ベツレヘム"],["へ"],["向かう","むかう"],["道","みち"],["の"],["傍ら","かたわら"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":20,"text":"ヤコブは、彼女の葬られた所に記念碑を立てた。それは、ラケルの葬りの碑として今でも残っている。","tok":[["ヤコブ"],["は"],["、"],["彼女","かのじょ"],["の"],["葬られた","ほうむられた"],["所","ところ"],["に"],["記念碑","きねんひ"],["を"],["立てた","たてた"],["。"],["それ"],["は"],["、"],["ラケル"],["の"],["葬り","ほうむり"],["の"],["碑","いしぶみ"],["として"],["今","いま"],["で"],["も"],["残って","のこって"],["いる"],["。"]]},{"verse":21,"text":"イスラエルは更に旅を続け、ミグダル‧エデルを過ぎた所に天幕を張った。","tok":[["イスラエル"],["は"],["更に","さらに"],["旅","たび"],["を"],["続け","つづけ"],["、"],["ミグダル"],["‧"],["エデル"],["を"],["過ぎた","すぎた"],["所","ところ"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["。"]]},{"verse":22,"text":"イスラエルがそこに滞在していたとき、ルベンは父の側女ビルハのところへ入って寝た。このことはイスラエルの耳にも入った。ヤコブの息子たちヤコブの息子は十二人であった。","tok":[["イスラエル"],["が"],["そこ"],["に"],["滞在","たいざい"],["して"],["いた"],["とき"],["、"],["ルベン"],["は"],["父","ちち"],["の"],["側女","そばめ"],["ビルハ"],["の"],["ところ"],["へ"],["入って","はいって"],["寝た","ねた"],["。"],["この"],["こと"],["は"],["イスラエル"],["の"],["耳","みみ"],["に"],["も"],["入った","はいった"],["。"],["ヤコブ"],["の"],["息子","むすこ"],["たち"],["ヤコブ"],["の"],["息子","むすこ"],["は"],["十二人","じゅうににん"],["で"],["あった"],["。"]]},{"verse":23,"text":"レアの息子がヤコブの長男ルベン、それからシメオン、レビ、ユダ、イサカル、ゼブルン、","tok":[["レア"],["の"],["息子","むすこ"],["が"],["ヤコブ"],["の"],["長男","ちょうなん"],["ルベン"],["、"],["それ"],["から"],["シメオン"],["、"],["レビ"],["、"],["ユダ"],["、"],["イサカル"],["、"],["ゼブルン"],["、"]]},{"verse":24,"text":"ラケルの息子がヨセフとベニヤミン、","tok":[["ラケル"],["の"],["息子","むすこ"],["が"],["ヨセフ"],["と"],["ベニヤミン"],["、"]]},{"verse":25,"text":"ラケルの召し使いビルハの息子がダンとナフタリ、","tok":[["ラケル"],["の"],["召し使い","めしつかい"],["ビルハ"],["の"],["息子","むすこ"],["が"],["ダン"],["と"],["ナフタリ"],["、"]]},{"verse":26,"text":"レアの召し使いジルパの息子がガドとアシェルである。これらは、パダン‧アラムで生まれたヤコブの息子たちである。","tok":[["レア"],["の"],["召し使い","めしつかい"],["ジルパ"],["の"],["息子","むすこ"],["が"],["ガド"],["と"],["アシェル"],["で"],["ある"],["。"],["これ"],["ら"],["は"],["、"],["パダン"],["‧"],["アラム"],["で"],["生まれた","うまれた"],["ヤコブ"],["の"],["息子","むすこ"],["たち"],["で"],["ある"],["。"]]},{"verse":27,"text":"ヤコブは、キルヤト‧アルバ、すなわちヘブロンのマムレにいる父イサクのところへ行った。そこは、イサクだけでなく、アブラハムも滞在していた所である。","tok":[["ヤコブ"],["は"],["、"],["キルヤト"],["‧"],["アルバ"],["、"],["すなわち"],["ヘブロン"],["の"],["マムレ"],["に"],["いる"],["父","ちち"],["イサク"],["の"],["ところ"],["へ"],["行った","いった"],["。"],["そこ"],["は"],["、"],["イサク"],["だけ"],["で"],["なく"],["、"],["アブラハム"],["も"],["滞在","たいざい"],["して"],["いた"],["所","ところ"],["で"],["ある"],["。"]]},{"verse":28,"text":"イサクの生涯は百八十年であった。","tok":[["イサク"],["の"],["生涯","しょうがい"],["は"],["百八十","ひゃくはちじゅう"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":29,"text":"イサクは息を引き取り、高齢のうちに満ち足りて死に、先祖の列に加えられた。息子のエサウとヤコブが彼を葬った。","tok":[["イサク"],["は"],["息","いき"],["を"],["引き取り","ひきとり"],["、"],["高齢","こうれい"],["の"],["うち"],["に"],["満ち足りて","みちたりて"],["死に","しに"],["、"],["先祖","せんぞ"],["の"],["列","れつ"],["に"],["加えられた","くわえられた"],["。"],["息子","むすこ"],["の"],["エサウ"],["と"],["ヤコブ"],["が"],["彼","かれ"],["を"],["葬った","ほうむった"],["。"]]}]
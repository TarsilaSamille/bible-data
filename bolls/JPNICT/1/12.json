[{"verse":1,"text":"主はアブラムに言われた。「あなたは生まれ故郷父の家を離れてわたしが示す地に行きなさい。","tok":[["主","ぬし"],["は"],["アブラム"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["生まれ","うまれ"],["故郷","こきょう"],["父","ちち"],["の"],["家","いえ"],["を"],["離れて","はなれて"],["わたし"],["が"],["示す","しめす"],["地","ち"],["に"],["行き","いき"],["なさい"],["。"]]},{"verse":2,"text":"わたしはあなたを大いなる国民にしあなたを祝福し、あなたの名を高める祝福の源となるように。","tok":[["わたし"],["は"],["あなた"],["を"],["大いなる","おおいなる"],["国民","こくみん"],["に"],["し"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["名","な"],["を"],["高める","たかめる"],["祝福","しゅくふく"],["の"],["源","みなもと"],["と"],["なる"],["よう"],["に"],["。"]]},{"verse":3,"text":"あなたを祝福する人をわたしは祝福しあなたを呪う者をわたしは呪う。地上の氏族はすべてあなたによって祝福に入る。」","tok":[["あなた"],["を"],["祝福","しゅくふく"],["する"],["人","ひと"],["を"],["わたし"],["は"],["祝福","しゅくふく"],["し"],["あなた"],["を"],["呪う","のろう"],["者","もの"],["を"],["わたし"],["は"],["呪う","のろう"],["。"],["地上","ちじょう"],["の"],["氏族","しぞく"],["は"],["すべて"],["あなた"],["によって"],["祝福","しゅくふく"],["に"],["入る","はいる"],["。"],["」"]]},{"verse":4,"text":"アブラムは、主の言葉に従って旅立った。ロトも共に行った。アブラムは、ハランを出発したとき七十五歳であった。","tok":[["アブラム"],["は"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["旅立った","たびだった"],["。"],["ロト"],["も"],["共","とも"],["に"],["行った","いった"],["。"],["アブラム"],["は"],["、"],["ハラン"],["を"],["出発","しゅっぱつ"],["した"],["とき"],["七十五歳","ななじゅうごさい"],["で"],["あった"],["。"]]},{"verse":5,"text":"アブラムは妻のサライ、甥のロトを連れ、蓄えた財産をすべて携え、ハランで加わった人々と共にカナン地方へ向かって出発し、カナン地方に入った。","tok":[["アブラム"],["は"],["妻","つま"],["の"],["サライ"],["、"],["甥","おい"],["の"],["ロト"],["を"],["連れ","つれ"],["、"],["蓄えた","たくわえた"],["財産","ざいさん"],["を"],["すべて"],["携え","たずさえ"],["、"],["ハラン"],["で"],["加わった","くわわった"],["人々","ひとびと"],["と"],["共","とも"],["に"],["カナン"],["地方","ちほう"],["へ"],["向かって","むかって"],["出発","しゅっぱつ"],["し"],["、"],["カナン"],["地方","ちほう"],["に"],["入った","はいった"],["。"]]},{"verse":6,"text":"アブラムはその地を通り、シケムの聖所、モレの樫の木まで来た。当時、その地方にはカナン人が住んでいた。","tok":[["アブラム"],["は"],["その"],["地","ち"],["を"],["通り","とおり"],["、"],["シケム"],["の"],["聖","せい"],["所","しょ"],["、"],["モレ"],["の"],["樫","かし"],["の"],["木","き"],["まで"],["来た","きた"],["。"],["当時","とうじ"],["、"],["その"],["地方","ちほう"],["に"],["は"],["カナン人","かなんにん"],["が"],["住んで","すんで"],["いた"],["。"]]},{"verse":7,"text":"主はアブラムに現れて、言われた。「あなたの子孫にこの土地を与える。」アブラムは、彼に現れた主のために、そこに祭壇を築いた。","tok":[["主","ぬし"],["は"],["アブラム"],["に"],["現れて","あらわれて"],["、"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["子孫","しそん"],["に"],["この"],["土地","とち"],["を"],["与える","あたえる"],["。"],["」"],["アブラム"],["は"],["、"],["彼","かれ"],["に"],["現れた","あらわれた"],["主","ぬし"],["の"],["ため"],["に"],["、"],["そこ"],["に"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]},{"verse":8,"text":"アブラムは、そこからベテルの東の山へ移り、西にベテル、東にアイを望む所に天幕を張って、そこにも主のために祭壇を築き、主の御名を呼んだ。","tok":[["アブラム"],["は"],["、"],["そこ"],["から"],["ベテル"],["の"],["東","ひがし"],["の"],["山","やま"],["へ"],["移り","うつり"],["、"],["西","にし"],["に"],["ベテル"],["、"],["東","ひがし"],["に"],["アイ"],["を"],["望む","のぞむ"],["所","ところ"],["に"],["天幕","てんまく"],["を"],["張って","はって"],["、"],["そこ"],["に"],["も"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["呼んだ","よんだ"],["。"]]},{"verse":9,"text":"アブラムは更に旅を続け、ネゲブ地方へ移った。","tok":[["アブラム"],["は"],["更に","さらに"],["旅","たび"],["を"],["続け","つづけ"],["、"],["ネゲブ"],["地方","ちほう"],["へ"],["移った","うつった"],["。"]]},{"verse":10,"text":"その地方に飢饉があった。アブラムは、その地方の飢饉がひどかったので、エジプトに下り、そこに滞在することにした。","tok":[["その"],["地方","ちほう"],["に"],["飢饉","ききん"],["が"],["あった"],["。"],["アブラム"],["は"],["、"],["その"],["地方","ちほう"],["の"],["飢饉","ききん"],["が"],["ひどかった"],["ので"],["、"],["エジプト"],["に"],["下り","くだり"],["、"],["そこ"],["に"],["滞在","たいざい"],["する"],["こと"],["に"],["した"],["。"]]},{"verse":11,"text":"エジプトに入ろうとしたとき、妻サライに言った。「あなたが美しいのを、わたしはよく知っている。","tok":[["エジプト"],["に"],["入ろう","はいろう"],["と"],["した"],["とき"],["、"],["妻","つま"],["サライ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["美しい","うつくしい"],["の"],["を"],["、"],["わたし"],["は"],["よく"],["知って","しって"],["いる"],["。"]]},{"verse":12,"text":"エジプト人があなたを見たら、『この女はあの男の妻だ』と言って、わたしを殺し、あなたを生かしておくにちがいない。","tok":[["エジプト"],["人","にん"],["が"],["あなた"],["を"],["見たら","みたら"],["、"],["『"],["この"],["女","おんな"],["は"],["あの"],["男","おとこ"],["の"],["妻","つま"],["だ"],["』"],["と"],["言って","いって"],["、"],["わたし"],["を"],["殺し","ころし"],["、"],["あなた"],["を"],["生かして","いかして"],["おく"],["に"],["ちがい"],["ない"],["。"]]},{"verse":13,"text":"どうか、わたしの妹だ、と言ってください。そうすれば、わたしはあなたのゆえに幸いになり、あなたのお陰で命も助かるだろう。」","tok":[["どう"],["か"],["、"],["わたし"],["の"],["妹","いもうと"],["だ"],["、"],["と"],["言って","いって"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["の"],["ゆえ"],["に"],["幸い","さいわい"],["に"],["なり"],["、"],["あなた"],["の"],["お陰","おかげ"],["で"],["命","いのち"],["も"],["助かるだろう","たすかるだろう"],["。"],["」"]]},{"verse":14,"text":"アブラムがエジプトに入ると、エジプト人はサライを見て、大変美しいと思った。","tok":[["アブラム"],["が"],["エジプト"],["に"],["入る","はいる"],["と"],["、"],["エジプト"],["人","にん"],["は"],["サライ"],["を"],["見て","みて"],["、"],["大変","たいへん"],["美しい","うつくしい"],["と"],["思った","おもった"],["。"]]},{"verse":15,"text":"ファラオの家臣たちも彼女を見て、ファラオに彼女のことを褒めたので、サライはファラオの宮廷に召し入れられた。","tok":[["ファラオ"],["の"],["家臣","かしん"],["たち"],["も"],["彼女","かのじょ"],["を"],["見て","みて"],["、"],["ファラオ"],["に"],["彼女","かのじょ"],["の"],["こと"],["を"],["褒めた","ほめた"],["ので"],["、"],["サライ"],["は"],["ファラオ"],["の"],["宮廷","きゅうてい"],["に"],["召し入れられた","めしいれられた"],["。"]]},{"verse":16,"text":"アブラムも彼女のゆえに幸いを受け、羊の群れ、牛の群れ、ろば、男女の奴隷、雌ろば、らくだなどを与えられた。","tok":[["アブラム"],["も"],["彼女","かのじょ"],["の"],["ゆえ"],["に"],["幸い","さいわい"],["を"],["受け","うけ"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["牛","うし"],["の"],["群れ","むれ"],["、"],["ろば"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["、"],["雌","めす"],["ろば"],["、"],["らくだ"],["など"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":17,"text":"ところが主は、アブラムの妻サライのことで、ファラオと宮廷の人々を恐ろしい病気にかからせた。","tok":[["ところ"],["が"],["主","ぬし"],["は"],["、"],["アブラム"],["の"],["妻","つま"],["サライ"],["の"],["こと"],["で"],["、"],["ファラオ"],["と"],["宮廷","きゅうてい"],["の"],["人々","ひとびと"],["を"],["恐ろしい","おそろしい"],["病気","びょうき"],["に"],["かからせた"],["。"]]},{"verse":18,"text":"ファラオはアブラムを呼び寄せて言った。「あなたはわたしに何ということをしたのか。なぜ、あの婦人は自分の妻だと、言わなかったのか。","tok":[["ファラオ"],["は"],["アブラム"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["わたし"],["に"],["何","なん"],["と"],["いう"],["こと"],["を"],["した"],["の"],["か"],["。"],["なぜ"],["、"],["あの"],["婦人","ふじん"],["は"],["自分","じぶん"],["の"],["妻","つま"],["だ"],["と"],["、"],["言わなかった","いわなかった"],["の"],["か"],["。"]]},{"verse":19,"text":"なぜ、『わたしの妹です』などと言ったのか。だからこそ、わたしの妻として召し入れたのだ。さあ、あなたの妻を連れて、立ち去ってもらいたい。」","tok":[["なぜ"],["、"],["『"],["わたし"],["の"],["妹","いもうと"],["です"],["』"],["など"],["と"],["言った","いった"],["の"],["か"],["。"],["だ"],["から"],["こそ"],["、"],["わたし"],["の"],["妻","つま"],["として"],["召し入れた","めしいれた"],["の"],["だ"],["。"],["さあ"],["、"],["あなた"],["の"],["妻","つま"],["を"],["連れて","つれて"],["、"],["立ち去って","たちさって"],["もらいたい"],["。"],["」"]]},{"verse":20,"text":"ファラオは家来たちに命じて、アブラムを、その妻とすべての持ち物と共に送り出させた。","tok":[["ファラオ"],["は"],["家来","けらい"],["たち"],["に"],["命じて","めいじて"],["、"],["アブラム"],["を"],["、"],["その"],["妻","つま"],["と"],["すべて"],["の"],["持ち物","もちもの"],["と"],["共","とも"],["に"],["送り出させた","おくりださせた"],["。"]]}]
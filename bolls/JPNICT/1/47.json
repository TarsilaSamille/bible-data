[{"verse":1,"text":"ヨセフはファラオのところへ行き、「わたしの父と兄弟たちが、羊や牛をはじめ、すべての財産を携えて、カナン地方からやって来て、今、ゴシェンの地におります」と報告した。","tok":[["ヨセフ"],["は"],["ファラオ"],["の"],["ところ"],["へ"],["行き","いき"],["、"],["「"],["わたし"],["の"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["が"],["、"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["はじめ"],["、"],["すべて"],["の"],["財産","ざいさん"],["を"],["携えて","たずさえて"],["、"],["カナン"],["地方","ちほう"],["から"],["やって"],["来て","きて"],["、"],["今","いま"],["、"],["ゴシェン"],["の"],["地","ち"],["に"],["おります"],["」"],["と"],["報告","ほうこく"],["した"],["。"]]},{"verse":2,"text":"そのときヨセフは、兄弟の中から五人を選んで、ファラオの前に連れて行った。","tok":[["その"],["とき"],["ヨセフ"],["は"],["、"],["兄弟","きょうだい"],["の"],["中","なか"],["から"],["五人","ごにん"],["を"],["選んで","えらんで"],["、"],["ファラオ"],["の"],["前","まえ"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":3,"text":"ファラオはヨセフの兄弟たちに言った。「お前たちの仕事は何か。」兄弟たちが、「あなたの僕であるわたしどもは、先祖代々、羊飼いでございます」と答え、","tok":[["ファラオ"],["は"],["ヨセフ"],["の"],["兄弟","きょうだい"],["たち"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["たち"],["の"],["仕事","しごと"],["は"],["何","なん"],["か"],["。"],["」"],["兄弟","きょうだい"],["たち"],["が"],["、"],["「"],["あなた"],["の"],["僕","ぼく"],["で"],["ある"],["わたし"],["ども"],["は"],["、"],["先祖","せんぞ"],["代々","だいだい"],["、"],["羊飼い","ひつじかい"],["で"],["ございます"],["」"],["と"],["答え","こたえ"],["、"]]},{"verse":4,"text":"更に続けてファラオに言った。「わたしどもはこの国に寄留させていただきたいと思って、参りました。カナン地方は飢饉がひどく、僕たちの羊を飼うための牧草がありません。僕たちをゴシェンの地に住まわせてください。」","tok":[["更に","さらに"],["続けて","つづけて"],["ファラオ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["ども"],["は"],["この"],["国","くに"],["に"],["寄留","きりゅう"],["させて"],["いただきたい"],["と"],["思って","おもって"],["、"],["参りました","まいりました"],["。"],["カナン"],["地方","ちほう"],["は"],["飢饉","ききん"],["が"],["ひどく"],["、"],["僕たち","ぼくたち"],["の"],["羊","ひつじ"],["を"],["飼う","かう"],["ため"],["の"],["牧草","ぼくそう"],["が"],["ありません"],["。"],["僕たち","ぼくたち"],["を"],["ゴシェン"],["の"],["地","ち"],["に"],["住まわせて","すまわせて"],["ください"],["。"],["」"]]},{"verse":5,"text":"ファラオはヨセフに向かって言った。「父上と兄弟たちが、お前のところにやって来たのだ。","tok":[["ファラオ"],["は"],["ヨセフ"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["父","ちち"],["上","うえ"],["と"],["兄弟","きょうだい"],["たち"],["が"],["、"],["お前","おまえ"],["の"],["ところ"],["に"],["やって"],["来た","きた"],["の"],["だ"],["。"]]},{"verse":6,"text":"エジプトの国のことはお前に任せてあるのだから、最も良い土地に父上と兄弟たちを住まわせるがよい。ゴシェンの地に住まわせるのもよかろう。もし、一族の中に有能な者がいるなら、わたしの家畜の監督をさせるがよい。」","tok":[["エジプト"],["の"],["国","くに"],["の"],["こと"],["は"],["お前","おまえ"],["に"],["任せて","まかせて"],["ある"],["の"],["だ"],["から"],["、"],["最も","もっとも"],["良い","よい"],["土地","とち"],["に"],["父","ちち"],["上","うえ"],["と"],["兄弟","きょうだい"],["たち"],["を"],["住まわせる","すまわせる"],["が"],["よい"],["。"],["ゴシェン"],["の"],["地","ち"],["に"],["住まわせる","すまわせる"],["の"],["も"],["よかろう"],["。"],["もし"],["、"],["一族","いちぞく"],["の"],["中","なか"],["に"],["有能","ゆうのう"],["な"],["者","もの"],["が"],["いるなら"],["、"],["わたし"],["の"],["家畜","かちく"],["の"],["監督","かんとく"],["を"],["させる"],["が"],["よい"],["。"],["」"]]},{"verse":7,"text":"それから、ヨセフは父ヤコブを連れて来て、ファラオの前に立たせた。ヤコブはファラオに祝福の言葉を述べた。","tok":[["それ"],["から"],["、"],["ヨセフ"],["は"],["父","ちち"],["ヤコブ"],["を"],["連れて","つれて"],["来て","きて"],["、"],["ファラオ"],["の"],["前","まえ"],["に"],["立たせた","たたせた"],["。"],["ヤコブ"],["は"],["ファラオ"],["に"],["祝福","しゅくふく"],["の"],["言葉","ことば"],["を"],["述べた","のべた"],["。"]]},{"verse":8,"text":"ファラオが、「あなたは何歳におなりですか」とヤコブに語りかけると、","tok":[["ファラオ"],["が"],["、"],["「"],["あなた"],["は"],["何歳","なんさい"],["に"],["おなりです"],["か"],["」"],["と"],["ヤコブ"],["に"],["語りかける","かたりかける"],["と"],["、"]]},{"verse":9,"text":"ヤコブはファラオに答えた。「わたしの旅路の年月は百三十年です。わたしの生涯の年月は短く、苦しみ多く、わたしの先祖たちの生涯や旅路の年月には及びません。」","tok":[["ヤコブ"],["は"],["ファラオ"],["に"],["答えた","こたえた"],["。"],["「"],["わたし"],["の"],["旅路","たびじ"],["の"],["年月","としつき"],["は"],["百三十","ひゃくさんじゅう"],["年","ねん"],["です"],["。"],["わたし"],["の"],["生涯","しょうがい"],["の"],["年月","としつき"],["は"],["短く","みじかく"],["、"],["苦しみ","くるしみ"],["多く","おおく"],["、"],["わたし"],["の"],["先祖","せんぞ"],["たち"],["の"],["生涯","しょうがい"],["や"],["旅路","たびじ"],["の"],["年月","としつき"],["に"],["は"],["及びません","およびません"],["。"],["」"]]},{"verse":10,"text":"ヤコブは、別れの挨拶をして、ファラオの前から退出した。","tok":[["ヤコブ"],["は"],["、"],["別れ","わかれ"],["の"],["挨拶","あいさつ"],["を"],["して"],["、"],["ファラオ"],["の"],["前","まえ"],["から"],["退出","たいしゅつ"],["した"],["。"]]},{"verse":11,"text":"ヨセフはファラオが命じたように、父と兄弟たちの住まいを定め、エジプトの国に所有地を与えた。そこは、ラメセス地方の最も良い土地であった。","tok":[["ヨセフ"],["は"],["ファラオ"],["が"],["命じた","めいじた"],["よう"],["に"],["、"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["の"],["住まい","すまい"],["を"],["定め","さだめ"],["、"],["エジプト"],["の"],["国","くに"],["に"],["所有地","しょゆうち"],["を"],["与えた","あたえた"],["。"],["そこ"],["は"],["、"],["ラメセス"],["地方","ちほう"],["の"],["最も","もっとも"],["良い","よい"],["土地","とち"],["で"],["あった"],["。"]]},{"verse":12,"text":"ヨセフはまた、父と兄弟たちと父の家族の者すべてを養い、扶養すべき者の数に従って食糧を与えた。","tok":[["ヨセフ"],["は"],["また"],["、"],["父","ちち"],["と"],["兄弟","きょうだい"],["たち"],["と"],["父","ちち"],["の"],["家族","かぞく"],["の"],["者","もの"],["すべて"],["を"],["養い","やしない"],["、"],["扶養","ふよう"],["すべき"],["者","もの"],["の"],["数","かず"],["に"],["従って","したがって"],["食糧","しょくりょう"],["を"],["与えた","あたえた"],["。"]]},{"verse":13,"text":"飢饉が極めて激しく、世界中に食糧がなくなった。エジプトの国でも、カナン地方でも、人々は飢饉のために苦しみあえいだ。","tok":[["飢饉","ききん"],["が"],["極めて","きわめて"],["激しく","はげしく"],["、"],["世界中","せかいじゅう"],["に"],["食糧","しょくりょう"],["が"],["なくなった"],["。"],["エジプト"],["の"],["国","くに"],["で"],["も"],["、"],["カナン"],["地方","ちほう"],["で"],["も"],["、"],["人々","ひとびと"],["は"],["飢饉","ききん"],["の"],["ため"],["に"],["苦しみ","くるしみ"],["あえいだ"],["。"]]},{"verse":14,"text":"ヨセフは、エジプトの国とカナン地方の人々が穀物の代金として支払った銀をすべて集め、それをファラオの宮廷に納めた。","tok":[["ヨセフ"],["は"],["、"],["エジプト"],["の"],["国","くに"],["と"],["カナン"],["地方","ちほう"],["の"],["人々","ひとびと"],["が"],["穀物","こくもつ"],["の"],["代金","だいきん"],["として"],["支払った","しはらった"],["銀","ぎん"],["を"],["すべて"],["集め","あつめ"],["、"],["それ"],["を"],["ファラオ"],["の"],["宮廷","きゅうてい"],["に"],["納めた","おさめた"],["。"]]},{"verse":15,"text":"エジプトの国にもカナン地方にも、銀が尽き果てると、エジプト人は皆、ヨセフのところにやって来て、「食べる物をください。あなたさまは、わたしどもを見殺しになさるおつもりですか。銀はなくなってしまいました」と言った。","tok":[["エジプト"],["の"],["国","くに"],["に"],["も"],["カナン"],["地方","ちほう"],["に"],["も"],["、"],["銀","ぎん"],["が"],["尽き","つき"],["果てる","はてる"],["と"],["、"],["エジプト"],["人","にん"],["は"],["皆","みな"],["、"],["ヨセフ"],["の"],["ところ"],["に"],["やって"],["来て","きて"],["、"],["「"],["食べる","たべる"],["物","もの"],["を"],["ください"],["。"],["あなた"],["さま"],["は"],["、"],["わたし"],["ども"],["を"],["見殺し","みごろし"],["に"],["なさる"],["おつもり"],["です"],["か"],["。"],["銀","ぎん"],["は"],["なくなって"],["しまいました"],["」"],["と"],["言った","いった"],["。"]]},{"verse":16,"text":"ヨセフは答えた。「家畜を連れて来なさい。もし銀がなくなったのなら、家畜と引き換えに与えよう。」","tok":[["ヨセフ"],["は"],["答えた","こたえた"],["。"],["「"],["家畜","かちく"],["を"],["連れて","つれて"],["来","き"],["なさい"],["。"],["もし"],["銀","ぎん"],["が"],["なくなった"],["の"],["なら"],["、"],["家畜","かちく"],["と"],["引き換え","ひきかえ"],["に"],["与えよう","あたえよう"],["。"],["」"]]},{"verse":17,"text":"人々が家畜をヨセフのところに連れて来ると、ヨセフは、馬や、羊や牛の群れや、ろばと引き換えに食糧を与えた。ヨセフはこうして、その年、すべての家畜と引き換えに人々に食糧を分け与えた。","tok":[["人々","ひとびと"],["が"],["家畜","かちく"],["を"],["ヨセフ"],["の"],["ところ"],["に"],["連れて","つれて"],["来る","くる"],["と"],["、"],["ヨセフ"],["は"],["、"],["馬","うま"],["や"],["、"],["羊","ひつじ"],["や"],["牛","うし"],["の"],["群れ","むれ"],["や"],["、"],["ろば"],["と"],["引き換え","ひきかえ"],["に"],["食糧","しょくりょう"],["を"],["与えた","あたえた"],["。"],["ヨセフ"],["は"],["こう"],["して"],["、"],["その"],["年","とし"],["、"],["すべて"],["の"],["家畜","かちく"],["と"],["引き換え","ひきかえ"],["に"],["人々","ひとびと"],["に"],["食糧","しょくりょう"],["を"],["分け与えた","わけあたえた"],["。"]]},{"verse":18,"text":"その年も終わり、次の年になると、人々はまたヨセフのところに来て、言った。「御主君には、何もかも隠さずに申し上げます。銀はすっかりなくなり、家畜の群れも御主君のものとなって、御覧のように残っているのは、わたしどもの体と農地だけです。","tok":[["その"],["年","とし"],["も"],["終わり","おわり"],["、"],["次","つぎ"],["の"],["年","とし"],["に"],["なる"],["と"],["、"],["人々","ひとびと"],["は"],["また"],["ヨセフ"],["の"],["ところ"],["に"],["来て","きて"],["、"],["言った","いった"],["。"],["「"],["御主君","ごしゅくん"],["に"],["は"],["、"],["何","なん"],["も"],["か"],["も"],["隠さず","かくさず"],["に"],["申し上げます","もうしあげます"],["。"],["銀","ぎん"],["は"],["すっかり"],["なくなり"],["、"],["家畜","かちく"],["の"],["群れ","むれ"],["も"],["御主君","ごしゅくん"],["の"],["もの"],["と"],["なって"],["、"],["御覧","ごらん"],["の"],["よう"],["に"],["残って","のこって"],["いる"],["の"],["は"],["、"],["わたし"],["ども"],["の"],["体","からだ"],["と"],["農地","のうち"],["だけ"],["です"],["。"]]},{"verse":19,"text":"どうしてあなたさまの前で、わたしどもと農地が滅んでしまってよいでしょうか。食糧と引き換えに、わたしどもと土地を買い上げてください。わたしどもは農地とともに、ファラオの奴隷になります。種をお与えください。そうすれば、わたしどもは死なずに生きることができ、農地も荒れ果てないでしょう。」","tok":[["どう"],["して"],["あなた"],["さま"],["の"],["前","まえ"],["で"],["、"],["わたし"],["ども"],["と"],["農地","のうち"],["が"],["滅んで","ほろんで"],["しまって"],["よいでしょう"],["か"],["。"],["食糧","しょくりょう"],["と"],["引き換え","ひきかえ"],["に"],["、"],["わたし"],["ども"],["と"],["土地","とち"],["を"],["買い上げて","かいあげて"],["ください"],["。"],["わたし"],["ども"],["は"],["農地","のうち"],["と"],["とも"],["に"],["、"],["ファラオ"],["の"],["奴隷","どれい"],["に"],["なります"],["。"],["種","しゅ"],["を"],["お与え","おあたえ"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["ども"],["は"],["死なず","しなず"],["に"],["生きる","いきる"],["こと"],["が"],["でき"],["、"],["農地","のうち"],["も"],["荒れ果てないでしょう","あれはてないでしょう"],["。"],["」"]]},{"verse":20,"text":"ヨセフは、エジプト中のすべての農地をファラオのために買い上げた。飢饉が激しくなったので、エジプト人は皆自分の畑を売ったからである。土地はこうして、ファラオのものとなった。","tok":[["ヨセフ"],["は"],["、"],["エジプト"],["中","ちゅう"],["の"],["すべて"],["の"],["農地","のうち"],["を"],["ファラオ"],["の"],["ため"],["に"],["買い上げた","かいあげた"],["。"],["飢饉","ききん"],["が"],["激しく","はげしく"],["なった"],["ので"],["、"],["エジプト"],["人","にん"],["は"],["皆","みな"],["自分","じぶん"],["の"],["畑","はたけ"],["を"],["売った","うった"],["から"],["で"],["ある"],["。"],["土地","とち"],["は"],["こう"],["して"],["、"],["ファラオ"],["の"],["もの"],["と"],["なった"],["。"]]},{"verse":21,"text":"また民については、エジプト領の端から端まで、ヨセフが彼らを奴隷にした。","tok":[["また"],["民","みん"],["について"],["は"],["、"],["エジプト"],["領","りょう"],["の"],["端","はし"],["から"],["端","はし"],["まで"],["、"],["ヨセフ"],["が"],["彼","かれ"],["ら"],["を"],["奴隷","どれい"],["に"],["した"],["。"]]},{"verse":22,"text":"ただし、祭司の農地だけは買い上げなかった。祭司にはファラオからの給与があって、ファラオが与える給与で生活していたので、農地を売らなかったからである。","tok":[["ただし"],["、"],["祭司","さいし"],["の"],["農地","のうち"],["だけ"],["は"],["買い上げなかった","かいあげなかった"],["。"],["祭司","さいし"],["に"],["は"],["ファラオ"],["から"],["の"],["給与","きゅうよ"],["が"],["あって"],["、"],["ファラオ"],["が"],["与える","あたえる"],["給与","きゅうよ"],["で"],["生活","せいかつ"],["して"],["いた"],["ので"],["、"],["農地","のうち"],["を"],["売らなかった","うらなかった"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"ヨセフは民に言った。「よいか、お前たちは今日、農地とともにファラオに買い取られたのだ。さあ、ここに種があるから、畑に蒔きなさい。","tok":[["ヨセフ"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["よい"],["か"],["、"],["お前","おまえ"],["たち"],["は"],["今日","きょう"],["、"],["農地","のうち"],["と"],["とも"],["に"],["ファラオ"],["に"],["買い取られた","かいとられた"],["の"],["だ"],["。"],["さあ"],["、"],["ここ"],["に"],["種","しゅ"],["が"],["ある"],["から"],["、"],["畑","はたけ"],["に"],["蒔き","まき"],["なさい"],["。"]]},{"verse":24,"text":"収穫の時には、五分の一をファラオに納め、五分の四はお前たちのものとするがよい。それを畑に蒔く種にしたり、お前たちや家族の者の食糧とし、子供たちの食糧としなさい。」","tok":[["収穫","しゅうかく"],["の"],["時","とき"],["に"],["は"],["、"],["五分","ごぶん"],["の"],["一","いち"],["を"],["ファラオ"],["に"],["納め","おさめ"],["、"],["五分","ごぶん"],["の"],["四","よん"],["は"],["お前","おまえ"],["たち"],["の"],["もの"],["と"],["する"],["が"],["よい"],["。"],["それ"],["を"],["畑","はたけ"],["に"],["蒔く","まく"],["種","たね"],["に"],["し"],["たり"],["、"],["お前","おまえ"],["たち"],["や"],["家族","かぞく"],["の"],["者","もの"],["の"],["食糧","しょくりょう"],["と"],["し"],["、"],["子供","こども"],["たち"],["の"],["食糧","しょくりょう"],["と"],["し"],["なさい"],["。"],["」"]]},{"verse":25,"text":"彼らは言った。「あなたさまはわたしどもの命の恩人です。御主君の御好意によって、わたしどもはファラオの奴隷にさせていただきます。」","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["あなた"],["さま"],["は"],["わたし"],["ども"],["の"],["命","いのち"],["の"],["恩人","おんじん"],["です"],["。"],["御主君","ごしゅくん"],["の"],["御好意","ごこうい"],["によって"],["、"],["わたし"],["ども"],["は"],["ファラオ"],["の"],["奴隷","どれい"],["に"],["させて"],["いただきます"],["。"],["」"]]},{"verse":26,"text":"ヨセフはこのように、収穫の五分の一をファラオに納めることを、エジプトの農業の定めとした。それは今日まで続いている。ただし、祭司の農地だけはファラオのものにならなかった。","tok":[["ヨセフ"],["は"],["この"],["よう"],["に"],["、"],["収穫","しゅうかく"],["の"],["五分","ごぶん"],["の"],["一","いち"],["を"],["ファラオ"],["に"],["納める","おさめる"],["こと"],["を"],["、"],["エジプト"],["の"],["農業","のうぎょう"],["の"],["定め","さだめ"],["と"],["した"],["。"],["それ"],["は"],["今日","きょう"],["まで"],["続いて","つづいて"],["いる"],["。"],["ただし"],["、"],["祭司","さいし"],["の"],["農地","のうち"],["だけ"],["は"],["ファラオ"],["の"],["もの"],["に"],["ならなかった"],["。"]]},{"verse":27,"text":"イスラエルは、エジプトの国、ゴシェンの地域に住み、そこに土地を得て、子を産み、大いに数を増した。","tok":[["イスラエル"],["は"],["、"],["エジプト"],["の"],["国","くに"],["、"],["ゴシェン"],["の"],["地域","ちいき"],["に"],["住み","すみ"],["、"],["そこ"],["に"],["土地","とち"],["を"],["得て","えて"],["、"],["子","こ"],["を"],["産み","うみ"],["、"],["大いに","おおいに"],["数","かず"],["を"],["増した","ました"],["。"]]},{"verse":28,"text":"ヤコブは、エジプトの国で十七年生きた。ヤコブの生涯は百四十七年であった。","tok":[["ヤコブ"],["は"],["、"],["エジプト"],["の"],["国","くに"],["で"],["十七","じゅうなな"],["年","ねん"],["生きた","いきた"],["。"],["ヤコブ"],["の"],["生涯","しょうがい"],["は"],["百四十七","ひゃくよんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":29,"text":"イスラエルは死ぬ日が近づいたとき、息子ヨセフを呼び寄せて言った。「もし、お前がわたしの願いを聞いてくれるなら、お前の手をわたしの腿の間に入れ、わたしのために慈しみとまことをもって実行すると、誓ってほしい。どうか、わたしをこのエジプトには葬らないでくれ。","tok":[["イスラエル"],["は"],["死ぬ","しぬ"],["日","ひ"],["が"],["近づいた","ちかづいた"],["とき"],["、"],["息子","むすこ"],["ヨセフ"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["もし"],["、"],["お前","おまえ"],["が"],["わたし"],["の"],["願い","ねがい"],["を"],["聞いて","きいて"],["くれるなら"],["、"],["お前","おまえ"],["の"],["手","て"],["を"],["わたし"],["の"],["腿","もも"],["の"],["間","あいだ"],["に"],["入れ","いれ"],["、"],["わたし"],["の"],["ため"],["に"],["慈しみ","いつくしみ"],["と"],["まこと"],["を"],["もって"],["実行","じっこう"],["する"],["と"],["、"],["誓って","ちかって"],["ほしい"],["。"],["どう"],["か"],["、"],["わたし"],["を"],["この"],["エジプト"],["に"],["は"],["葬らないで","ほうむらないで"],["くれ"],["。"]]},{"verse":30,"text":"わたしが先祖たちと共に眠りについたなら、わたしをエジプトから運び出して、先祖たちの墓に葬ってほしい。」ヨセフが、「必ず、おっしゃるとおりにいたします」と答えると、","tok":[["わたし"],["が"],["先祖","せんぞ"],["たち"],["と"],["共","とも"],["に"],["眠り","ねむり"],["に"],["ついたなら"],["、"],["わたし"],["を"],["エジプト"],["から"],["運び出して","はこびだして"],["、"],["先祖","せんぞ"],["たち"],["の"],["墓","はか"],["に"],["葬って","ほうむって"],["ほしい"],["。"],["」"],["ヨセフ"],["が"],["、"],["「"],["必ず","かならず"],["、"],["おっしゃる"],["とおり"],["に"],["いたします"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":31,"text":"「では、誓ってくれ」と言ったので、ヨセフは誓った。イスラエルは、寝台の枕もとで感謝を表した。","tok":[["「"],["で"],["は"],["、"],["誓って","ちかって"],["くれ"],["」"],["と"],["言った","いった"],["ので"],["、"],["ヨセフ"],["は"],["誓った","ちかった"],["。"],["イスラエル"],["は"],["、"],["寝台","しんだい"],["の"],["枕もと","まくらもと"],["で"],["感謝","かんしゃ"],["を"],["表した","あらわした"],["。"]]}]
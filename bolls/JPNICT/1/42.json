[{"verse":1,"text":"ヤコブは、エジプトに穀物があると知って、息子たちに、「どうしてお前たちは顔を見合わせてばかりいるのだ」と言い、更に、","tok":[["ヤコブ"],["は"],["、"],["エジプト"],["に"],["穀物","こくもつ"],["が"],["ある"],["と"],["知って","しって"],["、"],["息子","むすこ"],["たち"],["に"],["、"],["「"],["どう"],["して"],["お前","おまえ"],["たち"],["は"],["顔","かお"],["を"],["見合わせて","みあわせて"],["ばかり"],["いる"],["の"],["だ"],["」"],["と"],["言い","いい"],["、"],["更に","さらに"],["、"]]},{"verse":2,"text":"「聞くところでは、エジプトには穀物があるというではないか。エジプトへ下って行って穀物を買ってきなさい。そうすれば、我々は死なずに生き延びることができるではないか」と言った。","tok":[["「"],["聞く","きく"],["ところ"],["で"],["は"],["、"],["エジプト"],["に"],["は"],["穀物","こくもつ"],["が"],["ある"],["と"],["いうで"],["は"],["ない"],["か"],["。"],["エジプト"],["へ"],["下って","くだって"],["行って","いって"],["穀物","こくもつ"],["を"],["買って","かって"],["き"],["なさい"],["。"],["そう"],["すれば"],["、"],["我々","われわれ"],["は"],["死なず","しなず"],["に"],["生き延びる","いきのびる"],["こと"],["が"],["できるで"],["は"],["ない"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"そこでヨセフの十人の兄たちは、エジプトから穀物を買うために下って行った。","tok":[["そこ"],["で"],["ヨセフ"],["の"],["十人","じゅうにん"],["の"],["兄たち","あにたち"],["は"],["、"],["エジプト"],["から"],["穀物","こくもつ"],["を"],["買う","かう"],["ため"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":4,"text":"ヤコブはヨセフの弟ベニヤミンを兄たちに同行させなかった。何か不幸なことが彼の身に起こるといけないと思ったからであった。","tok":[["ヤコブ"],["は"],["ヨセフ"],["の"],["弟","おとうと"],["ベニヤミン"],["を"],["兄たち","あにたち"],["に"],["同行","どうこう"],["させなかった"],["。"],["何","なん"],["か"],["不幸","ふこう"],["な"],["こと"],["が"],["彼","かれ"],["の"],["身","み"],["に"],["起こる","おこる"],["と"],["いけない"],["と"],["思った","おもった"],["から"],["で"],["あった"],["。"]]},{"verse":5,"text":"イスラエルの息子たちは、他の人々に混じって穀物を買いに出かけた。カナン地方にも飢饉が襲っていたからである。","tok":[["イスラエル"],["の"],["息子","むすこ"],["たち"],["は"],["、"],["他","た"],["の"],["人々","ひとびと"],["に"],["混じって","まじって"],["穀物","こくもつ"],["を"],["買い","かい"],["に"],["出かけた","でかけた"],["。"],["カナン"],["地方","ちほう"],["に"],["も"],["飢饉","ききん"],["が"],["襲って","おそって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"ところで、ヨセフはエジプトの司政者として、国民に穀物を販売する監督をしていた。ヨセフの兄たちは来て、地面にひれ伏し、ヨセフを拝した。","tok":[["ところ"],["で"],["、"],["ヨセフ"],["は"],["エジプト"],["の"],["司","し"],["政者","せいしゃ"],["として"],["、"],["国民","こくみん"],["に"]
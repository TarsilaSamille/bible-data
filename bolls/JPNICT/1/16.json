[{"verse":1,"text":"アブラムの妻サライには、子供が生まれなかった。彼女には、ハガルというエジプト人の女奴隷がいた。","tok":[["アブラム"],["の"],["妻","つま"],["サライ"],["に"],["は"],["、"],["子供","こども"],["が"],["生まれなかった","うまれなかった"],["。"],["彼女","かのじょ"],["に"],["は"],["、"],["ハガル"],["と"],["いう"],["エジプト"],["人","にん"],["の"],["女","おんな"],["奴隷","どれい"],["が"],["いた"],["。"]]},{"verse":2,"text":"サライはアブラムに言った。「主はわたしに子供を授けてくださいません。どうぞ、わたしの女奴隷のところに入ってください。わたしは彼女によって、子供を与えられるかもしれません。」アブラムは、サライの願いを聞き入れた。","tok":[["サライ"],["は"],["アブラム"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["わたし"],["に"],["子供","こども"],["を"],["授けて","さずけて"],["くださいません"],["。"],["どうぞ"],["、"],["わたし"],["の"],["女","おんな"],["奴隷","どれい"],["の"],["ところ"],["に"],["入って","はいって"],["ください"],["。"],["わたし"],["は"],["彼女","かのじょ"],["によって"],["、"],["子供","こども"],["を"],["与えられる","あたえられる"],["か"],["も"],["しれません"],["。"],["」"],["アブラム"],["は"],["、"],["サライ"],["の"],["願い","ねがい"],["を"],["聞き入れた","ききいれた"],["。"]]},{"verse":3,"text":"アブラムの妻サライは、エジプト人の女奴隷ハガルを連れて来て、夫アブラムの側女とした。アブラムがカナン地方に住んでから、十年後のことであった。","tok":[["アブラム"],["の"],["妻","つま"],["サライ"],["は"],["、"],["エジプト"],["人","にん"],["の"],["女","おんな"],["奴隷","どれい"],["ハガル"],["を"],["連れて","つれて"],["来て","きて"],["、"],["夫","おっと"],["アブラム"],["の"],["側女","そばめ"],["と"],["した"],["。"],["アブラム"],["が"],["カナン"],["地方","ちほう"],["に"],["住んで","すんで"],["から"],["、"],["十","じゅう"],["年後","ねんご"],["の"],["こと"],["で"],["あった"],["。"]]},{"verse":4,"text":"アブラムはハガルのところに入り、彼女は身ごもった。ところが、自分が身ごもったのを知ると、彼女は女主人を軽んじた。","tok":[["アブラム"],["は"],["ハガル"],["の"],["ところ"],["に"],["入り","はいり"],["、"],["彼女","かのじょ"],["は"],["身ごもった","みごもった"],["。"],["ところ"],["が"],["、"],["自分","じぶん"],["が"],["身ごもった","みごもった"],["の"],["を"],["知る","しる"],["と"],["、"],["彼女","かのじょ"],["は"],["女","じょ"],["主人","しゅじん"],["を"],["軽んじた","かろんじた"],["。"]]},{"verse":5,"text":"サライはアブラムに言った。「わたしが不当な目に遭ったのは、あなたのせいです。女奴隷をあなたのふところに与えたのはわたしなのに、彼女は自分が身ごもったのを知ると、わたしを軽んじるようになりました。主がわたしとあなたとの間を裁かれますように。」","tok":[["サライ"],["は"],["アブラム"],["に"],["言った","いった"],["。"],["「"],["わたし"],["が"],["不当","ふとう"],["な"],["目","め"],["に"],["遭った","あった"],["の"],["は"],["、"],["あなた"],["の"],["せい"],["です"],["。"],["女","じょ"],["奴隷","どれい"],["を"],["あなた"],["の"],["ふところ"],["に"],["与えた","あたえた"],["の"],["は"],["わたし"],["な"],["のに"],["、"],["彼女","かのじょ"],["は"],["自分","じぶん"],["が"],["身ごもった","みごもった"],["の"],["を"],["知る","しる"],["と"],["、"],["わたし"],["を"],["軽んじる","かろんじる"],["よう"],["に"],["なりました"],["。"],["主","ぬし"],["が"],["わたし"],["と"],["あなた"],["と"],["の"],["間","あいだ"],["を"],["裁かれます","さばかれます"],["よう"],["に"],["。"],["」"]]},{"verse":6,"text":"アブラムはサライに答えた。「あなたの女奴隷はあなたのものだ。好きなようにするがいい。」サライは彼女につらく当たったので、彼女はサライのもとから逃げた。","tok":[["アブラム"],["は"],["サライ"],["に"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["女","おんな"],["奴隷","どれい"],["は"],["あなた"],["の"],["もの"],["だ"],["。"],["好き","すき"],["な"],["よう"],["に"],["する"],["が"],["いい"],["。"],["」"],["サライ"],["は"],["彼女","かのじょ"],["に"],["つらく"],["当たった","あたった"],["ので"],["、"],["彼女","かのじょ"],["は"],["サライ"],["の"],["もと"],["から"],["逃げた","にげた"],["。"]]},{"verse":7,"text":"主の御使いが荒れ野の泉のほとり、シュル街道に沿う泉のほとりで彼女と出会って、","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["が"],["荒れ野","あれの"],["の"],["泉","いずみ"],["の"],["ほとり"],["、"],["シュル"],["街道","かいどう"],["に"],["沿う","そう"],["泉","いずみ"],["の"],["ほとり"],["で"],["彼女","かのじょ"],["と"],["出会って","であって"],["、"]]},{"verse":8,"text":"言った。「サライの女奴隷ハガルよ。あなたはどこから来て、どこへ行こうとしているのか。」「女主人サライのもとから逃げているところです」と答えると、","tok":[["言った","いった"],["。"],["「"],["サライ"],["の"],["女","おんな"],["奴隷","どれい"],["ハガル"],["よ"],["。"],["あなた"],["は"],["どこ"],["から"],["来て","きて"],["、"],["どこ"],["へ"],["行こう","いこう"],["として"],["いる"],["の"],["か"],["。"],["」"],["「"],["女","じょ"],["主人","しゅじん"],["サライ"],["の"],["もと"],["から"],["逃げて","にげて"],["いる"],["ところ"],["です"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":9,"text":"主の御使いは言った。「女主人のもとに帰り、従順に仕えなさい。」","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["は"],["言った","いった"],["。"],["「"],["女","じょ"],["主人","しゅじん"],["の"],["もと"],["に"],["帰り","かえり"],["、"],["従順","じゅうじゅん"],["に"],["仕え","つかえ"],["なさい"],["。"],["」"]]},{"verse":10,"text":"主の御使いは更に言った。「わたしは、あなたの子孫を数えきれないほど多く増やす。」","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["は"],["更に","さらに"],["言った","いった"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["数え","かぞえ"],["きれない"],["ほど"],["多く","おおく"],["増やす","ふやす"],["。"],["」"]]},{"verse":11,"text":"主の御使いはまた言った。「今、あなたは身ごもっている。やがてあなたは男の子を産む。その子をイシュマエルと名付けなさい主があなたの悩みをお聞きになられたから。","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["は"],["また"],["言った","いった"],["。"],["「"],["今","いま"],["、"],["あなた"],["は"],["身ごもって","みごもって"],["いる"],["。"],["やがて"],["あなた"],["は"],["男の子","おとこのこ"],["を"],["産む","うむ"],["。"],["その"],["子","こ"],["を"],["イシュマエル"],["と"],["名付け","なづけ"],["なさい"],["主","ぬし"],["が"],["あなた"],["の"],["悩み","なやみ"],["を"],["お聞き","おきき"],["に"],["なられた"],["から"],["。"]]},{"verse":12,"text":"彼は野生のろばのような人になる。彼があらゆる人にこぶしを振りかざすので人々は皆、彼にこぶしを振るう。彼は兄弟すべてに敵対して暮らす。」","tok":[["彼","かれ"],["は"],["野生","やせい"],["の"],["ろば"],["の"],["よう"],["な"],["人","ひと"],["に"],["なる"],["。"],["彼","かれ"],["が"],["あらゆる"],["人","ひと"],["に"],["こぶし"],["を"],["振りかざす","ふりかざす"],["ので"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["彼","かれ"],["に"],["こぶし"],["を"],["振るう","ふるう"],["。"],["彼","かれ"],["は"],["兄弟","きょうだい"],["すべて"],["に"],["敵対","てきたい"],["して"],["暮らす","くらす"],["。"],["」"]]},{"verse":13,"text":"ハガルは自分に語りかけた主の御名を呼んで、「あなたこそエル‧ロイ（わたしを顧みられる神）です」と言った。それは、彼女が、「神がわたしを顧みられた後もなお、わたしはここで見続けていたではないか」と言ったからである。","tok":[["ハガル"],["は"],["自分","じぶん"],["に"],["語りかけた","かたりかけた"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["呼んで","よんで"],["、"],["「"],["あなた"],["こそ"],["エル"],["‧"],["ロイ"],["（"],["わたし"],["を"],["顧みられる","かえりみられる"],["神","かみ"],["）"],["です"],["」"],["と"],["言った","いった"],["。"],["それ"],["は"],["、"],["彼女","かのじょ"],["が"],["、"],["「"],["神","かみ"],["が"],["わたし"],["を"],["顧みられた","かえりみられた"],["後","あと"],["も"],["なお"],["、"],["わたし"],["は"],["ここ"],["で"],["見","み"],["続けて","つづけて"],["いたで"],["は"],["ない"],["か"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"そこで、その井戸は、ベエル‧ラハイ‧ロイと呼ばれるようになった。それはカデシュとベレドの間にある。","tok":[["そこ"],["で"],["、"],["その"],["井戸","いど"],["は"],["、"],["ベエル"],["‧"],["ラハイ"],["‧"],["ロイ"],["と"],["呼ばれる","よばれる"],["よう"],["に"],["なった"],["。"],["それ"],["は"],["カデシュ"],["と"],["ベレド"],["の"],["間","あいだ"],["に"],["ある"],["。"]]},{"verse":15,"text":"ハガルはアブラムとの間に男の子を産んだ。アブラムは、ハガルが産んだ男の子をイシュマエルと名付けた。","tok":[["ハガル"],["は"],["アブラム"],["と"],["の"],["間","あいだ"],["に"],["男の子","おとこ
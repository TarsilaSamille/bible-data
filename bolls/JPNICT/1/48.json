[{"verse":1,"text":"これらのことの後で、ヨセフに、「お父上が御病気です」との知らせが入ったので、ヨセフは二人の息子マナセとエフライムを連れて行った。","tok":[["これ"],["ら"],["の"],["こと"],["の"],["後","あと"],["で"],["、"],["ヨセフ"],["に"],["、"],["「"],["お父","おちち"],["上","うえ"],["が"],["御病気","ごびょうき"],["です"],["」"],["と"],["の"],["知らせ","しらせ"],["が"],["入った","はいった"],["ので"],["、"],["ヨセフ"],["は"],["二人","ふたり"],["の"],["息子","むすこ"],["マナセ"],["と"],["エフライム"],["を"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":2,"text":"ある人がヤコブに、「御子息のヨセフさまが、ただいまお見えになりました」と知らせると、イスラエルは力を奮い起こして、寝台の上に座った。","tok":[["ある"],["人","ひと"],["が"],["ヤコブ"],["に"],["、"],["「"],["御子息","ごしそく"],["の"],["ヨセフ"],["さま"],["が"],["、"],["ただいま"],["お見え","おみえ"],["に"],["なりました"],["」"],["と"],["知らせる","しらせる"],["と"],["、"],["イスラエル"],["は"],["力","ちから"],["を"],["奮い起こして","ふるいおこして"],["、"],["寝台","しんだい"],["の"],["上","うえ"],["に"],["座った","すわった"],["。"]]},{"verse":3,"text":"ヤコブはヨセフに言った。「全能の神がカナン地方のルズでわたしに現れて、わたしを祝福してくださったとき、","tok":[["ヤコブ"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["全能","ぜんのう"],["の"],["神","かみ"],["が"],["カナン"],["地方","ちほう"],["の"],["ルズ"],["で"],["わたし"],["に"],["現れて","あらわれて"],["、"],["わたし"],["を"],["祝福","しゅくふく"],["して"],["くださった"],["とき"],["、"]]},{"verse":4,"text":"こう言われた。『あなたの子孫を繁栄させ、数を増やしあなたを諸国民の群れとしよう。この土地をあなたに続く子孫に永遠の所有地として与えよう。』","tok":[["こう"],["言われた","いわれた"],["。"],["『"],["あなた"],["の"],["子孫","しそん"],["を"],["繁栄","はんえい"],["させ"],["、"],["数","すう"],["を"],["増やし","ふやし"],["あなた"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["群れ","むれ"],["と"],["しよう"],["。"],["この"],["土地","とち"],["を"],["あなた"],["に"],["続く","つづく"],["子孫","しそん"],["に"],["永遠","えいえん"],["の"],["所有地","しょゆうち"],["として"],["与えよう","あたえよう"],["。"],["』"]]},{"verse":5,"text":"今、わたしがエジプトのお前のところに来る前に、エジプトの国で生まれたお前の二人の息子をわたしの子供にしたい。エフライムとマナセは、ルベンやシメオンと同じように、わたしの子となるが、","tok":[["今","いま"],["、"],["わたし"],["が"],["エジプト"],["の"],["お前","おまえ"],["の"],["ところ"],["に"],["来る","くる"],["前","まえ"],["に"],["、"],["エジプト"],["の"],["国","くに"],["で"],["生まれた","うまれた"],["お前","おまえ"],["の"],["二人","ふたり"],["の"],["息子","むすこ"],["を"],["わたし"],["の"],["子供","こども"],["に"],["したい"],["。"],["エフライム"],["と"],["マナセ"],["は"],["、"],["ルベン"],["や"],["シメオン"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["わたし"],["の"],["子","こ"],["と"],["なる"],["が"],["、"]]},{"verse":6,"text":"その後に生まれる者はお前のものとしてよい。しかし、彼らの嗣業の土地は兄たちの名で呼ばれるであろう。","tok":[["その後","そのあと"],["に"],["生まれる","うまれる"],["者","もの"],["は"],["お前","おまえ"],["の"],["もの"],["として"],["よい"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["は"],["兄たち","あにたち"],["の"],["名","な"],["で"],["呼ばれるで","よばれるで"],["あろう"],["。"]]},{"verse":7,"text":"わたしはパダンから帰る途中、ラケルに死なれてしまった。あれはカナン地方で、エフラトまで行くには、まだかなりの道のりがある途中でのことだった。わたしはラケルを、エフラト、つまり今のベツレヘムへ向かう道のほとりに葬った。」","tok":[["わたし"],["は"],["パダン"],["から"],["帰る","かえる"],["途中","とちゅう"],["、"],["ラケル"],["に"],["死なれて","しなれて"],["しまった"],["。"],["あれ"],["は"],["カナン"],["地方","ちほう"],["で"],["、"],["エフラト"],["まで"],["行く","いく"],["に"],["は"],["、"],["まだ"],["かなり"],["の"],["道のり","みちのり"],["が"],["ある"],["途中","とちゅう"],["で"],["の"],["こと"],["だった"],["。"],["わたし"],["は"],["ラケル"],["を"],["、"],["エフラト"],["、"],["つまり"],["今","いま"],["の"],["ベツレヘム"],["へ"],["向かう","むかう"],["道","みち"],["の"],["ほとり"],["に"],["葬った","ほうむった"],["。"],["」"]]},{"verse":8,"text":"イスラエルは、ヨセフの息子たちを見ながら、「これは誰か」と尋ねた。","tok":[["イスラエル"],["は"],["、"],["ヨセフ"],["の"],["息子","むすこ"],["たち"],["を"],["見","み"],["ながら"],["、"],["「"],["これ"],["は"],["誰","だれ"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":9,"text":"ヨセフが父に、「神が、ここで授けてくださったわたしの息子です」と答えると、父は、「ここへ連れて来なさい。彼らを祝福しよう」と言った。","tok":[["ヨセフ"],["が"],["父","ちち"],["に"],["、"],["「"],["神","かみ"],["が"],["、"],["ここ"],["で"],["授けて","さずけて"],["くださった"],["わたし"],["の"],["息子","むすこ"],["です"],["」"],["と"],["答える","こたえる"],["と"],["、"],["父","ちち"],["は"],["、"],["「"],["ここ"],["へ"],["連れて","つれて"],["来","き"],["なさい"],["。"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["しよう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"イスラエルの目は老齢のためかすんでよく見えなかったので、ヨセフが二人の息子を父のもとに近寄らせると、父は彼らに口づけをして抱き締めた。","tok":[["イスラエル"],["の"],["目","め"],["は"],["老齢","ろうれい"],["の"],["ため"],["かすんで"],["よく"],["見えなかった","みえなかった"],["ので"],["、"],["ヨセフ"],["が"],["二人","ふたり"],["の"],["息子","むすこ"],["を"],["父","ちち"],["の"],["もと"],["に"],["近寄らせる","ちかよらせる"],["と"],["、"],["父","ちち"],["は"],["彼","かれ"],["ら"],["に"],["口づけ","くちづけ"],["を"],["して"],["抱き締めた","だきしめた"],["。"]]},{"verse":11,"text":"イスラエルはヨセフに言った。「お前の顔さえ見ることができようとは思わなかったのに、なんと、神はお前の子供たちをも見させてくださった。」","tok":[["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["の"],["顔","かお"],["さえ"],["見る","みる"],["こと"],["が"],["できよう"],["と"],["は"],["思わなかった","おもわなかった"],["のに"],["、"],["なん"],["と"],["、"],["神","かみ"],["は"],["お前","おまえ"],["の"],["子供","こども"],["たち"],["を"],["も"],["見させて","みさせて"],["くださった"],["。"],["」"]]},{"verse":12,"text":"ヨセフは彼らを父の膝から離し、地にひれ伏して拝した。","tok":[["ヨセフ"],["は"],["彼","かれ"],["ら"],["を"],["父","ちち"],["の"],["膝","ひざ"],["から"],["離し","はなし"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["拝した","はいした"],["。"]]},{"verse":13,"text":"ヨセフは二人の息子のうち、エフライムを自分の右手でイスラエルの左手に向かわせ、マナセを自分の左手でイスラエルの右手に向かわせ、二人を近寄らせた。","tok":[["ヨセフ"],["は"],["二人","ふたり"],["の"],["息子","むすこ"],["の"],["うち"],["、"],["エフライム"],["を"],["自分","じぶん"],["の"],["右手","みぎて"],["で"],["イスラエル"],["の"],["左手","ひだりて"],["に"],["向かわせ","むかわせ"],["、"],["マナセ"],["を"],["自分","じぶん"],["の"],["左手","ひだりて"],["で"],["イスラエル"],["の"],["右手","みぎて"],["に"],["向かわせ","むかわせ"],["、"],["二人","ふたり"],["を"],["近寄らせた","ちかよらせた"],["。"]]},{"verse":14,"text":"イスラエルは右手を伸ばして、弟であるエフライムの頭の上に置き、左手をマナセの頭の上に置いた。つまり、マナセが長男であるのに、彼は両手を交差して置いたのである。","tok":[["イスラエル"],["は"],["右手","みぎて"],["を"],["伸ばして","のばして"],["、"],["弟","おとうと"],["で"],["ある"],["エフライム"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["置き","おき"],["、"],["左手","ひだりて"],["を"],["マナセ"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["置いた","おいた"],["。"],["つまり"],["、"],["マナセ"],["が"],["長男","ちょうなん"],["で"],["ある"],["のに"],["、"],["彼","かれ"],["は"],["両手","りょうて"],["を"],["交差","こうさ"],["して"],["置いた","おいた"],["ので"],["ある"],["。"]]},{"verse":15,"text":"そして、ヨセフを祝福して言った。「わたしの先祖アブラハムとイサクがその御前に歩んだ神よ。わたしの生涯を今日まで導かれた牧者なる神よ。","tok":[["そして"],["、"],["ヨセフ"],["を"],["祝福","しゅくふく"],["して"],["言った","いった"],["。"],["「"],["わたし"],["の"],["先祖","せんぞ"],["アブラハム"],["と"],["イサク"],["が"],["その"],["御前","ごぜん"],["に"],["歩んだ","あゆんだ"],["神","かみ"],["よ"],["。"],["わたし"],["の"],["生涯","しょうがい"],["を"],["今日","きょう"],["まで"],["導かれた","みちびかれた"],["牧者","ぼくしゃ"],["なる"],["神","かみ"],["よ"],["。"]]},{"verse":16,"text":"わたしをあらゆる苦しみから贖われた御使いよ。どうか、この子供たちの上に祝福をお与えください。どうか、わたしの名とわたしの先祖アブラハム、イサクの名が彼らによって覚えられますように。どうか、彼らがこの地上に数多く増え続けますように。」","tok":[["わたし"],["を"],["あらゆる"],["苦しみ","くるしみ"],["から"],["贖われた","あがなわれた"],["御使い","おつかい"],["よ"],["。"],["どう"],["か"],["、"],["この"],["子供","こども"],["たち"],["の"],["上","うえ"],["に"],["祝福","しゅくふく"],["を"],["お与え","おあたえ"],["ください"],["。"],["どう"],["か"],["、"],["わたし"],["の"],["名","な"],["と"],["わたし"],["の"],["先祖","せんぞ"],["アブラハム"],["、"],["イサク"],["の"],["名","な"],["が"],["彼","かれ"],["ら"],["によって"],["覚えられます","おぼえられます"],["よう"],["に"],["。"],["どう"],["か"],["、"],["彼","かれ"],["ら"],["が"],["この"],["地上","ちじょう"],["に"],["数多く","かずおおく"],["増え","ふえ"],["続けます","つづけます"],["よう"],["に"],["。"],["」"]]},{"verse":17,"text":"ヨセフは、父が右手をエフライムの頭の上に置いているのを見て、不満に思い、父の手を取ってエフライムの頭からマナセの頭へ移そうとした。","tok":[["ヨセフ"],["は"],["、"],["父","ちち"],["が"],["右手","みぎて"],["を"],["エフライム"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["置いて","おいて"],["いる"],["の"],["を"],["見て","みて"],["、"],["不満","ふまん"],["に"],["思い","おもい"],["、"],["父","ちち"],["の"],["手","て"],["を"],["取って","とって"],["エフライム"],["の"],["頭","あたま"],["から"],["マナセ"],["の"],["頭","あたま"],["へ"],["移そう","うつそう"],["と"],["した"],["。"]]},{"verse":18,"text":"ヨセフは父に言った。「父上、そうではありません。これが長男ですから、右手をこれの頭の上に置いてください。」","tok":[["ヨセフ"],["は"],["父","ちち"],["に"],["言った","いった"],["。"],["「"],["父上","ちちじょう"],["、"],["そう"],["で"],["は"],["ありません"],["。"],["これ"],["が"],["長男","ちょうなん"],["です"],["から"],["、"],["右手","みぎて"],["を"],["これ"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["置いて","おいて"],["ください"],["。"],["」"]]},{"verse":19,"text":"ところが、父はそれを拒んで言った。「いや、分かっている。わたしの子よ、わたしには分かっている。この子も一つの民となり、大きくなるであろう。しかし、弟の方が彼よりも大きくなり、その子孫は国々に満ちるものとなる。」","tok":[["ところ"],["が"],["、"],["父","ちち"],["は"],["それ"],["を"],["拒んで","こばんで"],["言った","いった"],["。"],["「"],["いや"],["、"],["分かって","わかって"],["いる"],["。"],["わたし"],["の"],["子","こ"],["よ"],["、"],["わたし"],["に"],["は"],["分かって","わかって"],["いる"],["。"],["この"],["子","こ"],["も"],["一","ひと"],["つ"],["の"],["民","たみ"],["と"],["なり"],["、"],["大きく","おおきく"],["なるで"],["あろう"],["。"],["しかし"],["、"],["弟","おとうと"],["の"],["方","ほう"],["が"],["彼","かれ"],["より"],["も"],["大きく","おおきく"],["なり"],["、"],["その"],["子孫","しそん"],["は"],["国々","くにぐに"],["に"],["満ちる","みちる"],["もの"],["と"],["なる"],["。"],["」"]]},{"verse":20,"text":"その日、父は彼らを祝福して言った。「あなたによってイスラエルは人を祝福して言うであろう。『どうか、神があなたをエフライムとマナセのようにしてくださるように。』」彼はこのように、エフライムをマナセの上に立てたのである。","tok":[["その"],["日","ひ"],["、"],["父","ちち"],["は"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["言った","いった"],["。"],["「"],["あなた"],["によって"],["イスラエル"],["は"],["人","ひと"],["を"],["祝福","しゅくふく"],["して"],["言うで","ゆうで"],["あろう"],["。"],["『"],["どう"],["か"],["、"],["神","かみ"],["が"],["あなた"],["を"],["エフライム"],["と"],["マナセ"],["の"],["よう"],["に"],["して"],["くださる"],["よう"],["に"],["。"],["』"],["」"],["彼","かれ"],["は"],["この"],["よう"],["に"],["、"],["エフライム"],["を"],["マナセ"],["の"],["上","うえ"],["に"],["立てた","たてた"],["ので"],["ある"],["。"]]},{"verse":21,"text":"イスラエルはヨセフに言った。「間もなく、わたしは死ぬ。だが、神がお前たちと共にいてくださり、きっとお前たちを先祖の国に導き帰らせてくださる。","tok":[["イスラエル"],["は"],["ヨセフ"],["に"],["言った","いった"],["。"],["「"],["間","ま"],["も"],["なく"],["、"],["わたし"],["は"],["死ぬ","しぬ"],["。"],["だ"],["が"],["、"],["神","かみ"],["が"],["お前","おまえ"],["たち"],["と"],["共","とも"],["に"],["いて"],["くださり"],["、"],["きっと"],["お前","おまえ"],["たち"],["を"],["先祖","せんぞ"],["の"],["国","くに"],["に"],["導き","みちびき"],["帰らせて","かえらせて"],["くださる"],["。"]]},{"verse":22,"text":"わたしは、お前に兄弟たちよりも多く、わたしが剣と弓をもってアモリ人の手から取った一つの分け前（シェケム）を与えることにする。」","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["に"],["兄弟","きょうだい"],["たち"],["より"],["も"],["多く","おおく"],["、"],["わたし"],["が"],["剣","けん"],["と"],["弓","ゆみ"],["を"],["もって"],["アモリ人","あもりにん"],["の"],["手","て"],["から"],["取った","とった"],["一","ひと"],["つ"],["の"],["分け前（シェケム）","わけまえ"],["を"],["与える","あたえる"],["こと"],["に"],["する"],["。"],["」"]]}]
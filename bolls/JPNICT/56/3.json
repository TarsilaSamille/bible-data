[{"verse":1,"text":"人々に、次のことを思い起こさせなさい。支配者や権威者に服し、これに従い、すべての善い業を行う用意がなければならないこと、","tok":[["人々","ひとびと"],["に"],["、"],["次","つぎ"],["の"],["こと"],["を"],["思い起こさせ","おもいおこさせ"],["なさい"],["。"],["支配者","しはいしゃ"],["や"],["権威者","けんいしゃ"],["に"],["服し","ふくし"],["、"],["これ"],["に"],["従い","したがい"],["、"],["すべて"],["の"],["善い","よい"],["業","ごう"],["を"],["行う","おこなう"],["用意","ようい"],["が"],["なければ"],["ならない"],["こと"],["、"]]},{"verse":2,"text":"また、だれをもそしらず、争いを好まず、寛容で、すべての人に心から優しく接しなければならないことを。","tok":[["また"],["、"],["だれ"],["を"],["も"],["そしらず"],["、"],["争い","あらそい"],["を"],["好まず","このまず"],["、"],["寛容","かんよう"],["で"],["、"],["すべて"],["の"],["人","ひと"],["に"],["心","こころ"],["から"],["優しく","やさしく"],["接しなければ","せっしなければ"],["ならない"],["こと"],["を"],["。"]]},{"verse":3,"text":"わたしたち自身もかつては、無分別で、不従順で、道に迷い、種々の情欲と快楽のとりことなり、悪意とねたみを抱いて暮らし、忌み嫌われ、憎み合っていたのです。","tok":[["わたしたち"],["自身","じしん"],["も"],["かつて"],["は"],["、"],["無分別","むふんべつ"],["で"],["、"],["不","ふ"],["従順","じゅうじゅん"],["で"],["、"],["道","みち"],["に"],["迷い","まよい"],["、"],["種々","しゅじゅ"],["の"],["情欲","じょうよく"],["と"],["快楽","かいらく"],["の"],["とりこ"],["と"],["なり"],["、"],["悪意","あくい"],["と"],["ねたみ"],["を"],["抱いて","いだいて"],["暮らし","くらし"],["、"],["忌み嫌われ","いみきらわれ"],["、"],["憎み合って","にくみあって"],["いた"],["の"],["です"],["。"]]},{"verse":4,"text":"しかし、わたしたちの救い主である神の慈しみと、人間に対する愛とが現れたときに、","tok":[["しかし"],["、"],["わたしたち"],["の"],["救い主","すくいぬし"],["で"],["ある"],["神","かみ"],["の"],["慈しみ","いつくしみ"],["と"],["、"],["人間","にんげん"],["に"],["対する","たいする"],["愛","あい"],["と"],["が"],["現れた","あらわれた"],["とき"],["に"],["、"]]},{"verse":5,"text":"神は、わたしたちが行った義の業によってではなく、御自分の憐れみによって、わたしたちを救ってくださいました。この救いは、聖霊によって新しく生まれさせ、新たに造りかえる洗いを通して実現したのです。","tok":[["神","かみ"],["は"],["、"],["わたしたち"],["が"],["行った","おこなった"],["義","ぎ"],["の"],["業","ごう"],["によって"],["で"],["は"],["なく"],["、"],["御自分","ごじぶん"],["の"],["憐れみ","あわれみ"],["によって"],["、"],["わたしたち"],["を"],["救って","すくって"],["くださいました"],["。"],["この"],["救い","すくい"],["は"],["、"],["聖霊","せいれい"],["によって"],["新しく","あたらしく"],["生まれさせ","うまれさせ"],["、"],["新た","あらた"],["に"],["造りかえる","つくりかえる"],["洗い","あらい"],["を"],["通して","とおして"],["実現","じつげん"],["した"],["の"],["です"],["。"]]},{"verse":6,"text":"神は、わたしたちの救い主イエス‧キリストを通して、この聖霊をわたしたちに豊かに注いでくださいました。","tok":[["神","かみ"],["は"],["、"],["わたしたち"],["の"],["救い主","すくいぬし"],["イエス"],["‧"],["キリスト"],["を"],["通して","とおして"],["、"],["この"],["聖霊","せいれい"],["を"],["わたしたち"],["に"],["豊か","ゆたか"],["に"],["注いで","そそいで"],["くださいました"],["。"]]},{"verse":7,"text":"こうしてわたしたちは、キリストの恵みによって義とされ、希望どおり永遠の命を受け継ぐ者とされたのです。","tok":[["こう"],["して"],["わたしたち"],["は"],["、"],["キリスト"],["の"],["恵み","めぐみ"],["によって"],["義","ぎ"],["と"],["され"],["、"],["希望","きぼう"],["どおり"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["受け継ぐ","うけつぐ"],["者","もの"],["と"],["された"],["の"],["です"],["。"]]},{"verse":8,"text":"この言葉は真実です。あなたがこれらのことを力強く主張するように、わたしは望みます。そうすれば、神を信じるようになった人々が、良い行いに励もうと心がけるようになります。これらは良いことであり、人々に有益です。","tok":[["この"],["言葉","ことば"],["は"],["真実","しんじつ"],["です"],["。"],["あなた"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["力強く","ちからづよく"],["主張","しゅちょう"],["する"],["よう"],["に"],["、"],["わたし"],["は"],["望みます","のぞみます"],["。"],["そう"],["すれば"],["、"],["神","かみ"],["を"],["信じる","しんじる"],["よう"],["に"],["なった"],["人々","ひとびと"],["が"],["、"],["良い","よい"],["行い","おこない"],["に"],["励もう","はげもう"],["と"],["心がける","こころがける"],["よう"],["に"],["なります"],["。"],["これ"],["ら"],["は"],["良い","よい"],["こと"],["で"],["あり"],["、"],["人々","ひとびと"],["に"],["有益","ゆうえき"],["です"],["。"]]},{"verse":9,"text":"愚かな議論、系図の詮索、争い、律法についての論議を避けなさい。それは無益で、むなしいものだからです。","tok":[["愚か","おろか"],["な"],["議論","ぎろん"],["、"],["系図","けいず"],["の"],["詮索","せんさく"],["、"],["争い","あらそい"],["、"],["律法","りっぽう"],["について"],["の"],["論議","ろんぎ"],["を"],["避け","さけ"],["なさい"],["。"],["それ"],["は"],["無益","むえき"],["で"],["、"],["むなしい"],["もの"],["だ"],["から"],["です"],["。"]]},{"verse":10,"text":"分裂を引き起こす人には一、二度訓戒し、従わなければ、かかわりを持たないようにしなさい。","tok":[["分裂","ぶんれつ"],["を"],["引き起こす","ひきおこす"],["人","ひと"],["に"],["は"],["一","いち"],["、"],["二","に"],["度","ど"],["訓戒","くんかい"],["し"],["、"],["従わなければ","したがわなければ"],["、"],["かかわり"],["を"],["持たない","もたない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":11,"text":"あなたも知っているとおり、このような人は心がすっかりゆがんでいて、自ら悪いと知りつつ罪を犯しているのです。","tok":[["あなた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["この"],["よう"],["な"],["人","ひと"],["は"],["心","こころ"],["が"],["すっかり"],["ゆがんで"],["いて"],["、"],["自ら","みずから"],["悪い","わるい"],["と"],["知り","しり"],["つつ"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["の"],["です"],["。"]]},{"verse":12,"text":"アルテマスかティキコをあなたのもとへ遣わしたら、急いで、ニコポリスにいるわたしのところへ来てください。わたしはそこで冬を越すことにしたからです。","tok":[["アルテマス"],["か"],["ティキコ"],["を"],["あなた"],["の"],["もと"],["へ"],["遣わしたら","つかわしたら"],["、"],["急いで","いそいで"],["、"],["ニコポリス"],["に"],["いる"],["わたし"],["の"],["ところ"],["へ"],["来て","きて"],["ください"],["。"],["わたし"],["は"],["そこ"],["で"],["冬","ふゆ"],["を"],["越す","こす"],["こと"],["に"],["した"],["から"],["です"],["。"]]},{"verse":13,"text":"法律家ゼナスとアポロとを、何も不自由しないように、よく世話をして、送り出してください。","tok":[["法律家","ほうりつか"],["ゼナス"],["と"],["アポロ"],["と"],["を"],["、"],["何","なん"],["も"],["不自由","ふじゆう"],["しない"],["よう"],["に"],["、"],["よく"],["世話","せわ"],["を"],["して"],["、"],["送り出して","おくりだして"],["ください"],["。"]]},{"verse":14,"text":"わたしたちの仲間も、実際に必要な物を賄うために、良い行いに励むことを学ばねばなりません。実を結ばない者とならないためです。","tok":[["わたしたち"],["の"],["仲間","なかま"],["も"],["、"],["実際","じっさい"],["に"],["必要","ひつよう"],["な"],["物","もの"],["を"],["賄う","まかなう"],["ため"],["に"],["、"],["良い","よい"],["行い","おこない"],["に"],["励む","はげむ"],["こと"],["を"],["学ばねば","まなばねば"],["なりません"],["。"],["実","じつ"],["を"],["結ばない","むすばない"],["者","もの"],["と"],["ならない"],["ため"],["です"],["。"]]},{"verse":15,"text":"わたしと一緒にいる者たちが皆、あなたによろしくと言っています。わたしたちを愛している信仰の友人たちによろしく伝えてください。恵みがあなたがた一同と共にあるように。","tok":[["わたし"],["と"],["一緒","いっしょ"],["に"],["いる"],["者","もの"],["たち"],["が"],["皆","みな"],["、"],["あなた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["わたしたち"],["を"],["愛して","あいして"],["いる"],["信仰","しんこう"],["の"],["友人","ゆうじん"],["たち"],["に"],["よろしく"],["伝えて","つたえて"],["ください"],["。"],["恵み","めぐみ"],["が"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
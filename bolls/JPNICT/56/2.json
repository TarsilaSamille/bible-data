[{"verse":1,"text":"しかし、あなたは、健全な教えに適うことを語りなさい。","tok":[["しかし"],["、"],["あなた"],["は"],["、"],["健全","けんぜん"],["な"],["教え","おしえ"],["に"],["適う","かなう"],["こと"],["を"],["語り","かたり"],["なさい"],["。"]]},{"verse":2,"text":"年老いた男には、節制し、品位を保ち、分別があり、信仰と愛と忍耐の点で健全であるように勧めなさい。","tok":[["年老いた","としおいた"],["男","おとこ"],["に"],["は"],["、"],["節制","せっせい"],["し"],["、"],["品位","ひんい"],["を"],["保ち","たもち"],["、"],["分別","ぶんべつ"],["が"],["あり"],["、"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["忍耐","にんたい"],["の"],["点","てん"],["で"],["健全","けんぜん"],["で"],["ある"],["よう"],["に"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":3,"text":"同じように、年老いた女には、聖なる務めを果たす者にふさわしくふるまい、中傷せず、大酒のとりこにならず、善いことを教える者となるように勧めなさい。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["年老いた","としおいた"],["女","おんな"],["に"],["は"],["、"],["聖","せい"],["なる"],["務め","つとめ"],["を"],["果たす","はたす"],["者","もの"],["に"],["ふさわしく"],["ふるまい"],["、"],["中傷","ちゅうしょう"],["せず"],["、"],["大酒","おおざけ"],["の"],["とりこ"],["に"],["ならず"],["、"],["善い","よい"],["こと"],["を"],["教える","おしえる"],["者","もの"],["と"],["なる"],["よう"],["に"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":4,"text":"そうすれば、彼女たちは若い女を諭して、夫を愛し、子供を愛し、","tok":[["そう"],["すれば"],["、"],["彼女","かのじょ"],["たち"],["は"],["若い","わかい"],["女","おんな"],["を"],["諭して","さとして"],["、"],["夫","おっと"],["を"],["愛し","あいし"],["、"],["子供","こども"],["を"],["愛し","あいし"],["、"]]},{"verse":5,"text":"分別があり、貞潔で、家事にいそしみ、善良で、夫に従うようにさせることができます。これは、神の言葉が汚されないためです。","tok":[["分別","ぶんべつ"],["が"],["あり"],["、"],["貞潔","ていけつ"],["で"],["、"],["家事","かじ"],["に"],["いそしみ"],["、"],["善良","ぜんりょう"],["で"],["、"],["夫","おっと"],["に"],["従う","したがう"],["よう"],["に"],["させる"],["こと"],["が"],["できます"],["。"],["これ"],["は"],["、"],["神","かみ"],["の"],["言葉","ことば"],["が"],["汚されない","よごされない"],["ため"],["です"],["。"]]},{"verse":6,"text":"同じように、万事につけ若い男には、思慮深くふるまうように勧めなさい。あなた自身、良い行いの模範となりなさい。教えるときには、清廉で品位を保ち、","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["万事","ばんじ"],["に"],["つけ"],["若い","わかい"],["男","おとこ"],["に"],["は"],["、"],["思慮","しりょ"],["深く","ふかく"],["ふるまう"],["よう"],["に"],["勧め","すすめ"],["なさい"],["。"],["あなた"],["自身","じしん"],["、"],["良い","よい"],["行い","おこない"],["の"],["模範","もはん"],["と"],["なり"],["なさい"],["。"],["教える","おしえる"],["とき"],["に"],["は"],["、"],["清廉","せいれん"],["で"],["品位","ひんい"],["を"],["保ち","たもち"],["、"]]},{"verse":8,"text":"非難の余地のない健全な言葉を語りなさい。そうすれば、敵対者は、わたしたちについて何の悪口も言うことができず、恥じ入るでしょう。","tok":[["非難","ひなん"],["の"],["余地","よち"],["の"],["ない"],["健全","けんぜん"],["な"],["言葉","ことば"],["を"],["語り","かたり"],["なさい"],["。"],["そう"],["すれば"],["、"],["敵対者","てきたいしゃ"],["は"],["、"],["わたしたち"],["について"],["何","なん"],["の"],["悪口","わるぐち"],["も"],["言う","いう"],["こと"],["が"],["できず"],["、"],["恥じ入るでしょう","はじいるでしょう"],["。"]]},{"verse":9,"text":"奴隷には、あらゆる点で自分の主人に服従して、喜ばれるようにし、反抗したり、","tok":[["奴隷","どれい"],["に"],["は"],["、"],["あらゆる"],["点","てん"],["で"],["自分","じぶん"],["の"],["主人","しゅじん"],["に"],["服従","ふくじゅう"],["して"],["、"],["喜ばれる","よろこばれる"],["よう"],["に"],["し"],["、"],["反抗","はんこう"],["し"],["たり"],["、"]]},{"verse":10,"text":"盗んだりせず、常に忠実で善良であることを示すように勧めなさい。そうすれば、わたしたちの救い主である神の教えを、あらゆる点で輝かすことになります。","tok":[["盗ん","ぬすん"],["だり"],["せず"],["、"],["常","つね"],["に"],["忠実","ちゅうじつ"],["で"],["善良","ぜんりょう"],["で"],["ある"],["こと"],["を"],["示す","しめす"],["よう"],["に"],["勧め","すすめ"],["なさい"],["。"],["そう"],["すれば"],["、"],["わたしたち"],["の"],["救い主","すくいぬし"],["で"],["ある"],["神","かみ"],["の"],["教え","おしえ"],["を"],["、"],["あらゆる"],["点","てん"],["で"],["輝かす","かがやかす"],["こと"],["に"],["なります"],["。"]]},{"verse":11,"text":"実に、すべての人々に救いをもたらす神の恵みが現れました。","tok":[["実","じつ"],["に"],["、"],["すべて"],["の"],["人々","ひとびと"],["に"],["救い","すくい"],["を"],["もたらす"],["神","かみ"],["の"],["恵み","めぐみ"],["が"],["現れました","あらわれました"],["。"]]},{"verse":12,"text":"その恵みは、わたしたちが不信心と現世的な欲望を捨てて、この世で、思慮深く、正しく、信心深く生活するように教え、","tok":[["その"],["恵み","めぐみ"],["は"],["、"],["わたしたち"],["が"],["不信心","ふしんじん"],["と"],["現世","げんせ"],["的","てき"],["な"],["欲望","よくぼう"],["を"],["捨てて","すてて"],["、"],["この世","このよ"],["で"],["、"],["思慮","しりょ"],["深く","ふかく"],["、"],["正しく","ただしく"],["、"],["信心","しんじん"],["深く","ふかく"],["生活","せいかつ"],["する"],["よう"],["に"],["教え","おしえ"],["、"]]},{"verse":13,"text":"また、祝福に満ちた希望、すなわち偉大なる神であり、わたしたちの救い主であるイエス‧キリストの栄光の現れを待ち望むように教えています。","tok":[["また"],["、"],["祝福","しゅくふく"],["に"],["満ちた","みちた"],["希望","きぼう"],["、"],["すなわち"],["偉大","いだい"],["なる"],["神","かみ"],["で"],["あり"],["、"],["わたしたち"],["の"],["救い主","すくいぬし"],["で"],["ある"],["イエス"],["‧"],["キリスト"],["の"],["栄光","えいこう"],["の"],["現れ","あらわれ"],["を"],["待ち望む","まちのぞむ"],["よう"],["に"],["教えて","おしえて"],["います"],["。"]]},{"verse":14,"text":"キリストがわたしたちのために御自身を献げられたのは、わたしたちをあらゆる不法から贖い出し、良い行いに熱心な民を御自分のものとして清めるためだったのです。","tok":[["キリスト"],["が"],["わたしたち"],["の"],["ため"],["に"],["御自身","ごじしん"],["を"],["献げられた","ささげられた"],["の"],["は"],["、"],["わたしたち"],["を"],["あらゆる"],["不法","ふほう"],["から"],["贖い","あがない"],["出し","だし"],["、"],["良い","よい"],["行い","おこない"],["に"],["熱心","ねっしん"],["な"],["民","たみ"],["を"],["御自分","ごじぶん"],["の"],["もの"],["として"],["清める","きよめる"],["ため"],["だった"],["の"],["です"],["。"]]},{"verse":15,"text":"十分な権威をもってこれらのことを語り、勧め、戒めなさい。だれにも侮られてはなりません。","tok":[["十分","じゅうぶん"],["な"],["権威","けんい"],["を"],["もって"],["これ"],["ら"],["の"],["こと"],["を"],["語り","かたり"],["、"],["勧め","すすめ"],["、"],["戒め","いましめ"],["なさい"],["。"],["だれ"],["に"],["も"],["侮られて","あなどられて"],["は"],["なりません"],["。"]]}]
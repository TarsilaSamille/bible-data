[{"verse":1,"text":"神の僕、イエス‧キリストの使徒パウロから――わたしが使徒とされたのは、神に選ばれた人々の信仰を助け、彼らを信心に一致する真理の認識に導くためです。","tok":[["神","かみ"],["の"],["僕","ぼく"],["、"],["イエス"],["‧"],["キリスト"],["の"],["使徒","しと"],["パウロ"],["から"],["―"],["―"],["わたし"],["が"],["使徒","しと"],["と"],["された"],["の"],["は"],["、"],["神","かみ"],["に"],["選ばれた","えらばれた"],["人々","ひとびと"],["の"],["信仰","しんこう"],["を"],["助け","たすけ"],["、"],["彼","かれ"],["ら"],["を"],["信心","しんじん"],["に"],["一致","いっち"],["する"],["真理","しんり"],["の"],["認識","にんしき"],["に"],["導く","みちびく"],["ため"],["です"],["。"]]},{"verse":2,"text":"これは永遠の命の希望に基づくもので、偽ることのない神は、永遠の昔にこの命を約束してくださいました。","tok":[["これ"],["は"],["永遠","えいえん"],["の"],["命","いのち"],["の"],["希望","きぼう"],["に"],["基づく","もとづく"],["もの"],["で"],["、"],["偽る","いつわる"],["こと"],["の"],["ない"],["神","かみ"],["は"],["、"],["永遠","えいえん"],["の"],["昔","むかし"],["に"],["この"],["命","いのち"],["を"],["約束","やくそく"],["して"],["くださいました"],["。"]]},{"verse":3,"text":"神は、定められた時に、宣教を通して御言葉を明らかにされました。わたしたちの救い主である神の命令によって、わたしはその宣教をゆだねられたのです。――","tok":[["神","かみ"],["は"],["、"],["定められた","さだめられた"],["時","とき"],["に"],["、"],["宣教","せんきょう"],["を"],["通して","とおして"],["御言葉","おことば"],["を"],["明らか","あきらか"],["に"],["されました"],["。"],["わたしたち"],["の"],["救い主","すくいぬし"],["で"],["ある"],["神","かみ"],["の"],["命令","めいれい"],["によって"],["、"],["わたし"],["は"],["その"],["宣教","せんきょう"],["を"],["ゆだねられた"],["の"],["です"],["。"],["―"],["―"]]},{"verse":4,"text":"信仰を共にするまことの子テトスへ。父である神とわたしたちの救い主キリスト‧イエスからの恵みと平和とがあるように。","tok":[["信仰","しんこう"],["を"],["共","とも"],["に"],["する"],["まこと"],["の"],["子","こ"],["テトス"],["へ"],["。"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["わたしたち"],["の"],["救い主","すくいぬし"],["キリスト"],["‧"],["イエス"],["から"],["の"],["恵み","めぐみ"],["と"],["平和","へいわ"],["と"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":5,"text":"あなたをクレタに残してきたのは、わたしが指示しておいたように、残っている仕事を整理し、町ごとに長老たちを立ててもらうためです。","tok":[["あなた"],["を"],["クレタ"],["に"],["残して","のこして"],["きた"],["の"],["は"],["、"],["わたし"],["が"],["指示","しじ"],["して"],["おいた"],["よう"],["に"],["、"],["残って","のこって"],["いる"],["仕事","しごと"],["を"],["整理","せいり"],["し"],["、"],["町","まち"],["ごと"],["に"],["長老","ちょうろう"],["たち"],["を"],["立てて","たてて"],["もらう"],["ため"],["です"],["。"]]},{"verse":6,"text":"長老は、非難される点がなく、一人の妻の夫であり、その子供たちも信者であって、放蕩を責められたり、不従順であったりしてはなりません。","tok":[["長老","ちょうろう"],["は"],["、"],["非難","ひなん"],["される"],["点","てん"],["が"],["なく"],["、"],["一人","ひとり"],["の"],["妻","つま"],["の"],["夫","おっと"],["で"],["あり"],["、"],["その"],["子供","こども"],["たち"],["も"],["信者","しんじゃ"],["で"],["あって"],["、"],["放蕩","ほうとう"],["を"],["責められ","せめられ"],["たり"],["、"],["不","ふ"],["従順","じゅうじゅん"],["で"],["あっ"],["たり"],["して"],["は"],["なりません"],["。"]]},{"verse":7,"text":"監督は神から任命された管理者であるので、非難される点があってはならないのです。わがままでなく、すぐに怒らず、酒におぼれず、乱暴でなく、恥ずべき利益をむさぼらず、","tok":[["監督","かんとく"],["は"],["神","かみ"],["から"],["任命","にんめい"],["された"],["管理者","かんりしゃ"],["で"],["ある"],["ので"],["、"],["非難","ひなん"],["される"],["点","てん"],["が"],["あって"],["は"],["ならない"],["の"],["です"],["。"],["わがまま"],["で"],["なく"],["、"],["すぐ"],["に"],["怒らず","おこらず"],["、"],["酒","さけ"],["に"],["おぼれず"],["、"],["乱暴","らんぼう"],["で"],["なく"],["、"],["恥ずべき","はずべき"],["利益","りえき"],["を"],["むさぼらず"],["、"]]},{"verse":8,"text":"かえって、客を親切にもてなし、善を愛し、分別があり、正しく、清く、自分を制し、","tok":[["かえって"],["、"],["客","きゃく"],["を"],["親切","しんせつ"],["に"],["もてなし"],["、"],["善","ぜん"],["を"],["愛し","あいし"],["、"],["分別","ぶんべつ"],["が"],["あり"],["、"],["正しく","ただしく"],["、"],["清く","きよく"],["、"],["自分","じぶん"],["を"],["制し","せいし"],["、"]]},{"verse":9,"text":"教えに適う信頼すべき言葉をしっかり守る人でなければなりません。そうでないと、健全な教えに従って勧めたり、反対者の主張を論破したりすることもできないでしょう。","tok":[["教え","おしえ"],["に"],["適う","かなう"],["信頼","しんらい"],["すべき"],["言葉","ことば"],["を"],["しっかり"],["守る","まもる"],["人","ひと"],["で"],["なければ"],["なりません"],["。"],["そう"],["で"],["ない"],["と"],["、"],["健全","けんぜん"],["な"],["教え","おしえ"],["に"],["従って","したがって"],["勧め","すすめ"],["たり"],["、"],["反対者","はんたいしゃ"],["の"],["主張","しゅちょう"],["を"],["論破","ろんぱ"],["し"],["たり"],["する"],["こと"],["も"],["できないでしょう"],["。"]]},{"verse":10,"text":"実は、不従順な者、無益な話をする者、人を惑わす者が多いのです。特に割礼を受けている人たちの中に、そういう者がいます。","tok":[["実","じつ"],["は"],["、"],["不","ふ"],["従順","じゅうじゅん"],["な"],["者","もの"],["、"],["無益","むえき"],["な"],["話","はなし"],["を"],["する"],["者","もの"],["、"],["人","ひと"],["を"],["惑わす","まどわす"],["者","もの"],["が"],["多い","おおい"],["の"],["です"],["。"],["特に","とくに"],["割礼","かつれい"],["を"],["受けて","うけて"],["いる"],["人","ひと"],["たち"],["の"],["中","なか"],["に"],["、"],["そう"],["いう"],["者","もの"],["が"],["います"],["。"]]},{"verse":11,"text":"その者たちを沈黙させねばなりません。彼らは恥ずべき利益を得るために、教えてはならないことを教え、数々の家庭を覆しています。","tok":[["その"],["者","もの"],["たち"],["を"],["沈黙","ちんもく"],["させねば"],["なりません"],["。"],["彼","かれ"],["ら"],["は"],["恥ずべき","はずべき"],["利益","りえき"],["を"],["得る","える"],["ため"],["に"],["、"],["教えて","おしえて"],["は"],["ならない"],["こと"],["を"],["教え","おしえ"],["、"],["数々","かずかず"],["の"],["家庭","かてい"],["を"],["覆して","くつがえして"],["います"],["。"]]},{"verse":12,"text":"彼らのうちの一人、預言者自身が次のように言いました。「クレタ人はいつもうそつき、悪い獣、怠惰な大食漢だ。」","tok":[["彼","かれ"],["ら"],["の"],["うち"],["の"],["一人","ひとり"],["、"],["預言者","よげんしゃ"],["自身","じしん"],["が"],["次","つぎ"],["の"],["よう"],["に"],["言いました","いいました"],["。"],["「"],["クレタ人","くれたにん"],["は"],["いつも"],["うそつき"],["、"],["悪い","わるい"],["獣","けもの"],["、"],["怠惰","たいだ"],["な"],["大食漢","たいしょくかん"],["だ"],["。"],["」"]]},{"verse":13,"text":"この言葉は当たっています。だから、彼らを厳しく戒めて、信仰を健全に保たせ、","tok":[["この"],["言葉","ことば"],["は"],["当たって","あたって"],["います"],["。"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["を"],["厳しく","きびしく"],["戒めて","いましめて"],["、"],["信仰","しんこう"],["を"],["健全","けんぜん"],["に"],["保たせ","たもたせ"],["、"]]},{"verse":14,"text":"ユダヤ人の作り話や、真理に背を向けている者の掟に心を奪われないようにさせなさい。","tok":[["ユダヤ人","ゆだやじん"],["の"],["作り話","つくりばなし"],["や"],["、"],["真理","しんり"],["に"],["背","せ"],["を"],["向けて","むけて"],["いる"],["者","もの"],["の"],["掟","おきて"],["に"],["心","こころ"],["を"],["奪われない","うばわれない"],["よう"],["に"],["させ"],["なさい"],["。"]]},{"verse":15,"text":"清い人には、すべてが清いのです。だが、汚れている者、信じない者には、何一つ清いものはなく、その知性も良心も汚れています。","tok":[["清い","きよい"],["人","ひと"],["に"],["は"],["、"],["すべて"],["が"],["清い","きよい"],["の"],["です"],["。"],["だ"],["が"],["、"],["汚れて","よごれて"],["いる"],["者","もの"],["、"],["信じない","しんじない"],["者","もの"],["に"],["は"],["、"],["何","なん"],["一","ひと"],["つ"],["清い","きよい"],["もの"],["は"],["なく"],["、"],["その"],["知性","ちせい"],["も"],["良心","りょうしん"],["も"],["汚れて","よごれて"],["います"],["。"]]},{"verse":16,"text":"こういう者たちは、神を知っていると公言しながら、行いではそれを否定しているのです。嫌悪すべき人間で、反抗的で、一切の善い業については失格者です。","tok":[["こう"],["いう"],["者","もの"],["たち"],["は"],["、"],["神","かみ"],["を"],["知って","しって"],["いる"],["と"],["公言","こうげん"],["し"],["ながら"],["、"],["行い","おこない"],["で"],["は"],["それ"],["を"],["否定","ひてい"],["して"],["いる"],["の"],["です"],["。"],["嫌悪","けんお"],["すべき"],["人間","にんげん"],["で"],["、"],["反抗的","はんこうてき"],["で"],["、"],["一切","いっさい"],["の"],["善い","よい"],["業","ごう"],["について"],["は"],["失格者","しっかくしゃ"],["です"],["。"]]}]
[{"verse":1,"text":"キリストは肉に苦しみをお受けになったのですから、あなたがたも同じ心構えで武装しなさい。肉に苦しみを受けた者は、罪とのかかわりを絶った者なのです。","tok":[["キリスト"],["は"],["肉","にく"],["に"],["苦しみ","くるしみ"],["を"],["お受け","おうけ"],["に"],["なった"],["の"],["です"],["から"],["、"],["あなた"],["がた"],["も"],["同じ","おなじ"],["心構え","こころがまえ"],["で"],["武装","ぶそう"],["し"],["なさい"],["。"],["肉","にく"],["に"],["苦しみ","くるしみ"],["を"],["受けた","うけた"],["者","もの"],["は"],["、"],["罪","つみ"],["と"],["の"],["かかわり"],["を"],["絶った","たった"],["者","もの"],["な"],["の"],["です"],["。"]]},{"verse":2,"text":"それは、もはや人間の欲望にではなく神の御心に従って、肉における残りの生涯を生きるようになるためです。","tok":[["それ"],["は"],["、"],["もはや"],["人間","にんげん"],["の"],["欲望","よくぼう"],["に"],["で"],["は"],["なく"],["神","かみ"],["の"],["御心","おこころ"],["に"],["従って","したがって"],["、"],["肉","にく"],["に"],["おける"],["残り","のこり"],["の"],["生涯","しょうがい"],["を"],["生きる","いきる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":3,"text":"かつてあなたがたは、異邦人が好むようなことを行い、好色、情欲、泥酔、酒宴、暴飲、律法で禁じられている偶像礼拝などにふけっていたのですが、もうそれで十分です。","tok":[["かつて"],["あなた"],["がた"],["は"],["、"],["異邦人","いほうじん"],["が"],["好む","このむ"],["よう"],["な"],["こと"],["を"],["行い","おこない"],["、"],["好色","こうしょく"],["、"],["情欲","じょうよく"],["、"],["泥酔","でいすい"],["、"],["酒宴","しゅえん"],["、"],["暴飲","ぼういん"],["、"],["律法","りっぽう"],["で"],["禁じられて","きんじられて"],["いる"],["偶像","ぐうぞう"],["礼拝","れいはい"],["など"],["に"],["ふけって"],["いた"],["の"],["です"],["が"],["、"],["もう"],["それ"],["で"],["十分","じゅうぶん"],["です"],["。"]]},{"verse":4,"text":"あの者たちは、もはやあなたがたがそのようなひどい乱行に加わらなくなったので、不審に思い、そしるのです。","tok":[["あの"],["者","もの"],["たち"],["は"],["、"],["もはや"],["あなた"],["がた"],["が"],["その"],["よう"],["な"],["ひどい"],["乱行","らんぎょう"],["に"],["加わらなく","くわわらなく"],["なった"],["ので"],["、"],["不審","ふしん"],["に"],["思い","おもい"],["、"],["そしる"],["の"],["です"],["。"]]},{"verse":5,"text":"彼らは、生きている者と死んだ者とを裁こうとしておられる方に、申し開きをしなければなりません。","tok":[["彼","かれ"],["ら"],["は"],["、"],["生きて","いきて"],["いる"],["者","もの"],["と"],["死んだ","しんだ"],["者","もの"],["と"],["を"],["裁こう","さばこう"],["として"],["おられる"],["方","かた"],["に"],["、"],["申し開き","もうしひらき"],["を"],["しなければ"],["なりません"],["。"]]},{"verse":6,"text":"死んだ者にも福音が告げ知らされたのは、彼らが、人間の見方からすれば、肉において裁かれて死んだようでも、神との関係で、霊において生きるようになるためなのです。","tok":[["死んだ","しんだ"],["者","もの"],["に"],["も"],["福音","ふくいん"],["が"],["告げ知らされた","つげしらされた"],["の"],["は"],["、"],["彼","かれ"],["ら"],["が"],["、"],["人間","にんげん"],["の"],["見方","みかた"],["から"],["すれば"],["、"],["肉","にく"],["に"],["おいて"],["裁かれて","さばかれて"],["死んだ","しんだ"],["よう"],["で"],["も"],["、"],["神","かみ"],["と"],["の"],["関係","かんけい"],["で"],["、"],["霊","れい"],["に"],["おいて"],["生きる","いきる"],["よう"],["に"],["なる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":7,"text":"万物の終わりが迫っています。だから、思慮深くふるまい、身を慎んで、よく祈りなさい。","tok":[["万物","ばんぶつ"],["の"],["終わり","おわり"],["が"],["迫って","せまって"],["います"],["。"],["だ"],["から"],["、"],["思慮","しりょ"],["深く","ふかく"],["ふるまい"],["、"],["身","み"],["を"],["慎んで","つつしんで"],["、"],["よく"],["祈り","いのり"],["なさい"],["。"]]},{"verse":8,"text":"何よりもまず、心を込めて愛し合いなさい。愛は多くの罪を覆うからです。","tok":[["何","なん"],["より"],["も"],["まず"],["、"],["心","こころ"],["を"],["込めて","こめて"],["愛し合い","あいしあい"],["なさい"],["。"],["愛","あい"],["は"],["多く","おおく"],["の"],["罪","つみ"],["を"],["覆う","おおう"],["から"],["です"],["。"]]},{"verse":9,"text":"不平を言わずにもてなし合いなさい。","tok":[["不平","ふへい"],["を"],["言わず","いわず"],["に"],["もてなし"],["合い","あい"],["なさい"],["。"]]},{"verse":10,"text":"あなたがたはそれぞれ、賜物を授かっているのですから、神のさまざまな恵みの善い管理者として、その賜物を生かして互いに仕えなさい。","tok":[["あなた"],["がた"],["は"],["それぞれ"],["、"],["賜物","たまもの"],["を"],["授かって","さずかって"],["いる"],["の"],["です"],["から"],["、"],["神","かみ"],["の"],["さまざま"],["な"],["恵み","めぐみ"],["の"],["善い","よい"],["管理者","かんりしゃ"],["として"],["、"],["その"],["賜物","たまもの"],["を"],["生かして","いかして"],["互い","たがい"],["に"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":11,"text":"語る者は、神の言葉を語るにふさわしく語りなさい。奉仕をする人は、神がお与えになった力に応じて奉仕しなさい。それは、すべてのことにおいて、イエス‧キリストを通して、神が栄光をお受けになるためです。栄光と力とが、世々限りなく神にありますように、アーメン。","tok":[["語る","かたる"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["言葉","ことば"],["を"],["語る","かたる"],["に"],["ふさわしく"],["語り","かたり"],["なさい"],["。"],["奉仕","ほうし"],["を"],["する"],["人","ひと"],["は"],["、"],["神","かみ"],["が"],["お与え","おあたえ"],["に"],["なった"],["力","ちから"],["に"],["応じて","おうじて"],["奉仕","ほうし"],["し"],["なさい"],["。"],["それ"],["は"],["、"],["すべて"],["の"],["こと"],["に"],["おいて"],["、"],["イエス"],["‧"],["キリスト"],["を"],["通して","とおして"],["、"],["神","かみ"],["が"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なる"],["ため"],["です"],["。"],["栄光","えいこう"],["と"],["力","ちから"],["と"],["が"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["神","かみ"],["に"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]},{"verse":12,"text":"愛する人たち、あなたがたを試みるために身にふりかかる火のような試練を、何か思いがけないことが生じたかのように、驚き怪しんではなりません。","tok":[["愛する","あいする"],["人","ひと"],["たち"],["、"],["あなた"],["がた"],["を"],["試みる","こころみる"],["ため"],["に"],["身","み"],["に"],["ふりかかる"],["火","ひ"],["の"],["よう"],["な"],["試練","しれん"],["を"],["、"],["何","なん"],["か"],["思いがけない","おもいがけない"],["こと"],["が"],["生じた","しょうじた"],["か"],["の"],["よう"],["に"],["、"],["驚き怪しんで","おどろきあやしんで"],["は"],["なりません"],["。"]]},{"verse":13,"text":"むしろ、キリストの苦しみにあずかればあずかるほど喜びなさい。それは、キリストの栄光が現れるときにも、喜びに満ちあふれるためです。","tok":[["むしろ"],["、"],["キリスト"],["の"],["苦しみ","くるしみ"],["に"],["あずかれば"],["あずかる"],["ほど"],["喜び","よろこび"],["なさい"],["。"],["それ"],["は"],["、"],["キリスト"],["の"],["栄光","えいこう"],["が"],["現れる","あらわれる"],["とき"],["に"],["も"],["、"],["喜び","よろこび"],["に"],["満ちあふれる","みちあふれる"],["ため"],["です"],["。"]]},{"verse":14,"text":"あなたがたはキリストの名のために非難されるなら、幸いです。栄光の霊、すなわち神の霊が、あなたがたの上にとどまってくださるからです。","tok":[["あなた"],["がた"],["は"],["キリスト"],["の"],["名","な"],["の"],["ため"],["に"],["非難","ひなん"],["されるなら"],["、"],["幸い","さいわい"],["です"],["。"],["栄光","えいこう"],["の"],["霊","れい"],["、"],["すなわち"],["神","かみ"],["の"],["霊","れい"],["が"],["、"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["とどまって"],["くださる"],["から"],["です"],["。"]]},{"verse":15,"text":"あなたがたのうちだれも、人殺し、泥棒、悪者、あるいは、他人に干渉する者として、苦しみを受けることがないようにしなさい。","tok":[["あなた"],["がた"],["の"],["うち"],["だれ"],["も"],["、"],["人殺し","ひとごろし"],["、"],["泥棒","どろぼう"],["、"],["悪者","わるもの"],["、"],["あるいは"],["、"],["他人","たにん"],["に"],["干渉","かんしょう"],["する"],["者","もの"],["として"],["、"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["こと"],["が"],["ない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":16,"text":"しかし、キリスト者として苦しみを受けるのなら、決して恥じてはなりません。むしろ、キリスト者の名で呼ばれることで、神をあがめなさい。","tok":[["しかし"],["、"],["キリスト"],["者","しゃ"],["として"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["の"],["なら"],["、"],["決して","けっして"],["恥じ","はじ"],["ては"],["なりません"],["。"],["むしろ"],["、"],["キリスト"],["者","しゃ"],["の"],["名","な"],["で"],["呼ばれる","よばれる"],["こと"],["で"],["、"],["神","かみ"],["を"],["あがめ"],["なさい"],["。"]]},{"verse":17,"text":"今こそ、神の家から裁きが始まる時です。わたしたちがまず裁きを受けるのだとすれば、神の福音に従わない者たちの行く末は、いったい、どんなものになるだろうか。","tok":[["今","いま"],["こそ"],["、"],["神","かみ"],["の"],["家","いえ"],["から"],["裁き","さばき"],["が"],["始まる","はじまる"],["時","とき"],["です"],["。"],["わたしたち"],["が"],["まず"],["裁き","さばき"],["を"],["受ける","うける"],["の"],["だ"],["と"],["すれば"],["、"],["神","かみ"],["の"],["福音","ふくいん"],["に"],["従わない","したがわない"],["者","もの"],["たち"],["の"],["行く末","ゆくすえ"],["は"],["、"],["いったい"],["、"],["どんな"],["もの"],["に"],["なるだろう"],["か"],["。"]]},{"verse":18,"text":"「正しい人がやっと救われるのなら、不信心な人や罪深い人はどうなるのか」と言われているとおりです。","tok":[["「"],["正しい","ただしい"],["人","ひと"],["が"],["やっと"],["救われる","すくわれる"],["の"],["なら"],["、"],["不信心","ふしんじん"],["な"],["人","ひと"],["や"],["罪深い","つみぶかい"],["人","ひと"],["は"],["どう"],["なる"],["の"],["か"],["」"],["と"],["言われて","いわれて"],["いる"],["とおり"],["です"],["。"]]},{"verse":19,"text":"だから、神の御心によって苦しみを受ける人は、善い行いをし続けて、真実であられる創造主に自分の魂をゆだねなさい。","tok":[["だ"],["から"],["、"],["神","かみ"],["の"],["御心","おこころ"],["によって"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["人","ひと"],["は"],["、"],["善い","よい"],["行い","おこない"],["を"],["し"],["続けて","つづけて"],["、"],["真実","しんじつ"],["で"],["あられる"],["創造","そうぞう"],["主に","おもに"],["自分","じぶん"],["の"],["魂","たましい"],["を"],["ゆだね"],["なさい"],["。"]]}]
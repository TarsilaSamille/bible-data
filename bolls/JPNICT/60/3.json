[{"verse":1,"text":"同じように、妻たちよ、自分の夫に従いなさい。夫が御言葉を信じない人であっても、妻の無言の行いによって信仰に導かれるようになるためです。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["妻たち","つまたち"],["よ"],["、"],["自分","じぶん"],["の"],["夫","おっと"],["に"],["従い","したがい"],["なさい"],["。"],["夫","おっと"],["が"],["御言葉","おことば"],["を"],["信じない","しんじない"],["人","ひと"],["で"],["あって"],["も"],["、"],["妻","つま"],["の"],["無言","むごん"],["の"],["行い","おこない"],["によって"],["信仰","しんこう"],["に"],["導かれる","みちびかれる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":2,"text":"神を畏れるあなたがたの純真な生活を見るからです。","tok":[["神","かみ"],["を"],["畏れる","おそれる"],["あなた"],["がた"],["の"],["純真","じゅんしん"],["な"],["生活","せいかつ"],["を"],["見る","みる"],["から"],["です"],["。"]]},{"verse":3,"text":"あなたがたの装いは、編んだ髪や金の飾り、あるいは派手な衣服といった外面的なものであってはなりません。","tok":[["あなた"],["がた"],["の"],["装い","よそおい"],["は"],["、"],["編んだ","あんだ"],["髪","かみ"],["や"],["金","きん"],["の"],["飾り","かざり"],["、"],["あるいは"],["派手","はで"],["な"],["衣服","いふく"],["と"],["いった"],["外面的","がいめんてき"],["な"],["もの"],["で"],["あって"],["は"],["なりません"],["。"]]},{"verse":4,"text":"むしろそれは、柔和でしとやかな気立てという朽ちないもので飾られた、内面的な人柄であるべきです。このような装いこそ、神の御前でまことに価値があるのです。","tok":[["むしろ"],["それ"],["は"],["、"],["柔和","にゅうわ"],["で"],["しとやか"],["な"],["気立て","きだて"],["と"],["いう"],["朽ちない","くちない"],["もの"],["で"],["飾られた","かざられた"],["、"],["内面的","ないめんてき"],["な"],["人柄","ひとがら"],["で"],["あるべきです"],["。"],["この"],["よう"],["な"],["装い","よそおい"],["こそ"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["まこと"],["に"],["価値","かち"],["が"],["ある"],["の"],["です"],["。"]]},{"verse":5,"text":"その昔、神に望みを託した聖なる婦人たちも、このように装って自分の夫に従いました。","tok":[["その"],["昔","むかし"],["、"],["神","かみ"],["に"],["望み","のぞみ"],["を"],["託した","たくした"],["聖","せい"],["なる"],["婦人","ふじん"],["たち"],["も"],["、"],["この"],["よう"],["に"],["装って","よそおって"],["自分","じぶん"],["の"],["夫","おっと"],["に"],["従いました","したがいました"],["。"]]},{"verse":6,"text":"たとえばサラは、アブラハムを主人と呼んで、彼に服従しました。あなたがたも、善を行い、また何事も恐れないなら、サラの娘となるのです。","tok":[["たとえば"],["サラ"],["は"],["、"],["アブラハム"],["を"],["主人","しゅじん"],["と"],["呼んで","よんで"],["、"],["彼","かれ"],["に"],["服従","ふくじゅう"],["しました"],["。"],["あなた"],["がた"],["も"],["、"],["善","ぜん"],["を"],["行い","おこない"],["、"],["また"],["何事","なにごと"],["も"],["恐れないなら","おそれないなら"],["、"],["サラ"],["の"],["娘","むすめ"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":7,"text":"同じように、夫たちよ、妻を自分よりも弱いものだとわきまえて生活を共にし、命の恵みを共に受け継ぐ者として尊敬しなさい。そうすれば、あなたがたの祈りが妨げられることはありません。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["夫","おっと"],["たち"],["よ"],["、"],["妻","つま"],["を"],["自分","じぶん"],["より"],["も"],["弱い","よわい"],["もの"],["だ"],["と"],["わきまえて"],["生活","せいかつ"],["を"],["共","とも"],["に"],["し"],["、"],["命","いのち"],["の"],["恵み","めぐみ"],["を"],["共","とも"],["に"],["受け継ぐ","うけつぐ"],["者","もの"],["として"],["尊敬","そんけい"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["の"],["祈り","いのり"],["が"],["妨げられる","さまたげられる"],["こと"],["は"],["ありません"],["。"]]},{"verse":8,"text":"終わりに、皆心を一つに、同情し合い、兄弟を愛し、憐れみ深く、謙虚になりなさい。","tok":[["終わり","おわり"],["に"],["、"],["皆","みな"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["、"],["同情","どうじょう"],["し"],["合い","あい"],["、"],["兄弟","きょうだい"],["を"],["愛し","あいし"],["、"],["憐れみ","あわれみ"],["深く","ふかく"],["、"],["謙虚","けんきょ"],["に"],["なり"],["なさい"],["。"]]},{"verse":9,"text":"悪をもって悪に、侮辱をもって侮辱に報いてはなりません。かえって祝福を祈りなさい。祝福を受け継ぐためにあなたがたは召されたのです。","tok":[["悪","あく"],["を"],["もって"],["悪","わる"],["に"],["、"],["侮辱","ぶじょく"],["を"],["もって"],["侮辱","ぶじょく"],["に"],["報いて","むくいて"],["は"],["なりません"],["。"],["かえって"],["祝福","しゅくふく"],["を"],["祈り","いのり"],["なさい"],["。"],["祝福","しゅくふく"],["を"],["受け継ぐ","うけつぐ"],["ため"],["に"],["あなた"],["がた"],["は"],["召された","めされた"],["の"],["です"],["。"]]},{"verse":10,"text":"「命を愛し、幸せな日々を過ごしたい人は、舌を制して、悪を言わず、唇を閉じて、偽りを語らず、","tok":[["「"],["命","いのち"],["を"],["愛し","あいし"],["、"],["幸せ","しあわせ"],["な"],["日々","ひび"],["を"],["過ごしたい","すごしたい"],["人","ひと"],["は"],["、"],["舌","した"],["を"],["制して","せいして"],["、"],["悪","あく"],["を"],["言わず","いわず"],["、"],["唇","くちびる"],["を"],["閉じて","とじて"],["、"],["偽り","いつわり"],["を"],["語らず","かたらず"],["、"]]},{"verse":11,"text":"悪から遠ざかり、善を行い、平和を願って、これを追い求めよ。","tok":[["悪","あく"],["から"],["遠ざかり","とおざかり"],["、"],["善","ぜん"],["を"],["行い","おこない"],["、"],["平和","へいわ"],["を"],["願って","ねがって"],["、"],["これ"],["を"],["追い求めよ","おいもとめよ"],["。"]]},{"verse":12,"text":"主の目は正しい者に注がれ、主の耳は彼らの祈りに傾けられる。主の顔は悪事を働く者に対して向けられる。」","tok":[["主","ぬし"],["の"],["目","め"],["は"],["正しい","ただしい"],["者","もの"],["に"],["注がれ","そそがれ"],["、"],["主","ぬし"],["の"],["耳","みみ"],["は"],["彼","かれ"],["ら"],["の"],["祈り","いのり"],["に"],["傾けられる","かたむけられる"],["。"],["主","ぬし"],["の"],["顔","かお"],["は"],["悪事","あくじ"],["を"],["働く","はたらく"],["者","もの"],["に対して","にたいして"],["向けられる","むけられる"],["。"],["」"]]},{"verse":13,"text":"もし、善いことに熱心であるなら、だれがあなたがたに害を加えるでしょう。","tok":[["もし"],["、"],["善い","よい"],["こと"],["に"],["熱心","ねっしん"],["で"],["あるなら"],["、"],["だれ"],["が"],["あなた"],["がた"],["に"],["害","がい"],["を"],["加えるでしょう","くわえるでしょう"],["。"]]},{"verse":14,"text":"しかし、義のために苦しみを受けるのであれば、幸いです。人々を恐れたり、心を乱したりしてはいけません。","tok":[["しかし"],["、"],["義","ぎ"],["の"],["ため"],["に"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["ので"],["あれば"],["、"],["幸い","さいわい"],["です"],["。"],["人々","ひとびと"],["を"],["恐れ","おそれ"],["たり"],["、"],["心","こころ"],["を"],["乱し","みだし"],["たり"],["して"],["は"],["いけません"],["。"]]},{"verse":15,"text":"心の中でキリストを主とあがめなさい。あなたがたの抱いている希望について説明を要求する人には、いつでも弁明できるように備えていなさい。","tok":[["心","こころ"],["の"],["中","なか"],["で"],["キリスト"],["を"],["主","ぬし"],["と"],["あがめ"],["なさい"],["。"],["あなた"],["がた"],["の"],["抱いて","いだいて"],["いる"],["希望","きぼう"],["について"],["説明","せつめい"],["を"],["要求","ようきゅう"],["する"],["人","ひと"],["に"],["は"],["、"],["いつ"],["で"],["も"],["弁明","べんめい"],["できる"],["よう"],["に"],["備えて","そなえて"],["い"],["なさい"],["。"]]},{"verse":16,"text":"それも、穏やかに、敬意をもって、正しい良心で、弁明するようにしなさい。そうすれば、キリストに結ばれたあなたがたの善い生活をののしる者たちは、悪口を言ったことで恥じ入るようになるのです。","tok":[["それ"],["も"],["、"],["穏やか","おだやか"],["に"],["、"],["敬意","けいい"],["を"],["もって"],["、"],["正しい","ただしい"],["良心","りょうしん"],["で"],["、"],["弁明","べんめい"],["する"],["よう"],["に"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["キリスト"],["に"],["結ばれた","むすばれた"],["あなた"],["がた"],["の"],["善い","よい"],["生活","せいかつ"],["を"],["ののしる"],["者","もの"],["たち"],["は"],["、"],["悪口","わるぐち"],["を"],["言った","いった"],["こと"],["で"],["恥じ入る","はじいる"],["よう"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":17,"text":"神の御心によるのであれば、善を行って苦しむ方が、悪を行って苦しむよりはよい。","tok":[["神","かみ"],["の"],["御心","おこころ"],["に"],["よる"],["ので"],["あれば"],["、"],["善","ぜん"],["を"],["行って","おこなって"],["苦しむ","くるしむ"],["方","ほう"],["が"],["、"],["悪","あく"],["を"],["行って","おこなって"],["苦しむ","くるしむ"],["より"],["は"],["よい"],["。"]]},{"verse":18,"text":"キリストも、罪のためにただ一度苦しまれました。正しい方が、正しくない者たちのために苦しまれたのです。あなたがたを神のもとへ導くためです。キリストは、肉では死に渡されましたが、霊では生きる者とされたのです。","tok":[["キリスト"],["も"],["、"],["罪","つみ"],["の"],["ため"],["に"],["ただ"],["一度","いちど"],["苦しまれました","くるしまれました"],["。"],["正しい","ただしい"],["方","ほう"],["が"],["、"],["正しく","ただしく"],["ない"],["者","もの"],["たち"],["の"],["ため"],["に"],["苦しまれた","くるしまれた"],["の"],["です"],["。"],["あなた"],["がた"],["を"],["神","かみ"],["の"],["もと"],["へ"],["導く","みちびく"],["ため"],["です"],["。"],["キリスト"],["は"],["、"],["肉","にく"],["で"],["は"],["死","し"],["に"],["渡されました","わたされました"],["が"],["、"],["霊","れい"],["で"],["は"],["生きる","いきる"],["者","もの"],["と"],["された"],["の"],["です"],["。"]]},{"verse":19,"text":"そして、霊においてキリストは、捕らわれていた霊たちのところへ行って宣教されました。","tok":[["そして"],["、"],["霊","れい"],["に"],["おいて"],["キリスト"],["は"],["、"],["捕らわれて","とらわれて"],["いた"],["霊","れい"],["たち"],["の"],["ところ"],["へ"],["行って","いって"],["宣教","せんきょう"],["されました"],["。"]]},{"verse":20,"text":"この霊たちは、ノアの時代に箱舟が作られていた間、神が忍耐して待っておられたのに従わなかった者です。この箱舟に乗り込んだ数人、すなわち八人だけが水の中を通って救われました。","tok":[["この"],["霊","れい"],["たち"],["は"],["、"],["ノア"],["の"],["時代","じだい"],["に"],["箱舟","はこぶね"],["が"],["作られて","つくられて"],["いた"],["間","あいだ"],["、"],["神","かみ"],["が"],["忍耐","にんたい"],["して"],["待って","まって"],["おられた"],["のに"],["従わなかった","したがわなかった"],["者","もの"],["です"],["。"],["この"],["箱舟","はこぶね"],["に"],["乗り込んだ","のりこんだ"],["数人","かずひと"],["、"],["すなわち"],["八人","はちにん"],["だけ"],["が"],["水","みず"],["の"],["中","なか"],["を"],["通って","とおって"],["救われました","すくわれました"],["。"]]},{"verse":21,"text":"この水で前もって表された洗礼は、今やイエス‧キリストの復活によってあなたがたをも救うのです。洗礼は、肉の汚れを取り除くことではなくて、神に正しい良心を願い求めることです。","tok":[["この"],["水","みず"],["で"],["前もって","まえもって"],["表された","あらわされた"],["洗礼","せんれい"],["は"],["、"],["今","いま"],["や"],["イエス"],["‧"],["キリスト"],["の"],["復活","ふっかつ"],["によって"],["あなた"],["がた"],["を"],["も"],["救う","すくう"],["の"],["です"],["。"],["洗礼","せんれい"],["は"],["、"],["肉","にく"],["の"],["汚れ","よごれ"],["を"],["取り除く","とりのぞく"],["こと"],["で"],["は"],["なくて"],["、"],["神","かみ"],["に"],["正しい","ただしい"],["良心","りょうしん"],["を"],["願い求める","ねがいもとめる"],["こと"],["です"],["。"]]},{"verse":22,"text":"キリストは、天に上って神の右におられます。天使、また権威や勢力は、キリストの支配に服しているのです。","tok":[["キリスト"],["は"],["、"],["天","てん"],["に"],["上って","のぼって"],["神","かみ"],["の"],["右","みぎ"],["に"],["おられます"],["。"],["天使","てんし"],["、"],["また"],["権威","けんい"],["や"],["勢力","せいりょく"],["は"],["、"],["キリスト"],["の"],["支配","しはい"],["に"],["服して","ふくして"],["いる"],["の"],["です"],["。"]]}]
[{"verse":1,"text":"イエス‧キリストの使徒ペトロから、ポントス、ガラテヤ、カパドキア、アジア、ビティニアの各地に離散して仮住まいをしている選ばれた人たちへ。","tok":[["イエス"],["‧"],["キリスト"],["の"],["使徒","しと"],["ペトロ"],["から"],["、"],["ポントス"],["、"],["ガラテヤ"],["、"],["カパドキア"],["、"],["アジア"],["、"],["ビティニア"],["の"],["各地","かくち"],["に"],["離散","りさん"],["して"],["仮住まい","かりずまい"],["を"],["して"],["いる"],["選ばれた","えらばれた"],["人","ひと"],["たち"],["へ"],["。"]]},{"verse":2,"text":"あなたがたは、父である神があらかじめ立てられた御計画に基づいて、“霊”によって聖なる者とされ、イエス‧キリストに従い、また、その血を注ぎかけていただくために選ばれたのです。恵みと平和が、あなたがたにますます豊かに与えられるように。","tok":[["あなた"],["がた"],["は"],["、"],["父","ちち"],["で"],["ある"],["神","かみ"],["が"],["あらかじめ"],["立てられた","たてられた"],["御計画","ごけいかく"],["に"],["基づいて","もとづいて"],["、"],["“"],["霊","れい"],["”"],["によって"],["聖","せい"],["なる"],["者","もの"],["と"],["され"],["、"],["イエス"],["‧"],["キリスト"],["に"],["従い","したがい"],["、"],["また"],["、"],["その"],["血","ち"],["を"],["注ぎ","そそぎ"],["かけて"],["いただく"],["ため"],["に"],["選ばれた","えらばれた"],["の"],["です"],["。"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ますます"],["豊か","ゆたか"],["に"],["与えられる","あたえられる"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしたちの主イエス‧キリストの父である神が、ほめたたえられますように。神は豊かな憐れみにより、わたしたちを新たに生まれさせ、死者の中からのイエス‧キリストの復活によって、生き生きとした希望を与え、","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["が"],["、"],["ほめたたえられます"],["よう"],["に"],["。"],["神","かみ"],["は"],["豊か","ゆたか"],["な"],["憐れみ","あわれみ"],["に"],["より"],["、"],["わたしたち"],["を"],["新た","あらた"],["に"],["生まれさせ","うまれさせ"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["の"],["イエス"],["‧"],["キリスト"],["の"],["復活","ふっかつ"],["によって"],["、"],["生き生き","いきいき"],["と"],["した"],["希望","きぼう"],["を"],["与え","あたえ"],["、"]]},{"verse":4,"text":"また、あなたがたのために天に蓄えられている、朽ちず、汚れず、しぼまない財産を受け継ぐ者としてくださいました。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["天","てん"],["に"],["蓄えられて","たくわえられて"],["いる"],["、"],["朽ちず","くちず"],["、"],["汚れず","よごれず"],["、"],["しぼまない"],["財産","ざいさん"],["を"],["受け継ぐ","うけつぐ"],["者","もの"],["として"],["くださいました"],["。"]]},{"verse":5,"text":"あなたがたは、終わりの時に現されるように準備されている救いを受けるために、神の力により、信仰によって守られています。","tok":[["あなた"],["がた"],["は"],["、"],["終わり","おわり"],["の"],["時","とき"],["に"],["現される","あらわされる"],["よう"],["に"],["準備","じゅんび"],["されて"],["いる"],["救い","すくい"],["を"],["受ける","うける"],["ため"],["に"],["、"],["神","かみ"],["の"],["力","ちから"],["に"],["より"],["、"],["信仰","しんこう"],["によって"],["守られて","まもられて"],["います"],["。"]]},{"verse":6,"text":"それゆえ、あなたがたは、心から喜んでいるのです。今しばらくの間、いろいろな試練に悩まねばならないかもしれませんが、","tok":[["それ"],["ゆえ"],["、"],["あなた"],["がた"],["は"],["、"],["心","こころ"],["から"],["喜んで","よろこんで"],["いる"],["の"],["です"],["。"],["今","いま"],["しばらく"],["の"],["間","あいだ"],["、"],["いろいろ"],["な"],["試練","しれん"],["に"],["悩まねば","なやまねば"],["ならない"],["か"],["も"],["しれません"],["が"],["、"]]},{"verse":7,"text":"あなたがたの信仰は、その試練によって本物と証明され、火で精錬されながらも朽ちるほかない金よりはるかに尊くて、イエス‧キリストが現れるときには、称賛と光栄と誉れとをもたらすのです。","tok":[["あなた"],["がた"],["の"],["信仰","しんこう"],["は"],["、"],["その"],["試練","しれん"],["によって"],["本物","ほんもの"],["と"],["証明","しょうめい"],["され"],["、"],["火","ひ"],["で"],["精錬","せいれん"],["され"],["ながら"],["も"],["朽ちる","くちる"],["ほか"],["ない"],["金","かね"],["より"],["はるか"],["に"],["尊くて","とうとくて"],["、"],["イエス"],["‧"],["キリスト"],["が"],["現れる","あらわれる"],["とき"],["に"],["は"],["、"],["称賛","しょうさん"],["と"],["光栄","こうえい"],["と"],["誉れ","ほまれ"],["と"],["を"],["もたらす"],["の"],["です"],["。"]]},{"verse":8,"text":"あなたがたは、キリストを見たことがないのに愛し、今見なくても信じており、言葉では言い尽くせないすばらしい喜びに満ちあふれています。","tok":[["あなた"],["がた"],["は"],["、"],["キリスト"],["を"],["見た","みた"],["こと"],["が"],["ない"],["のに"],["愛し","あいし"],["、"],["今","いま"],["見なくて","みなくて"],["も"],["信じて","しんじて"],["おり"],["、"],["言葉","ことば"],["で"],["は"],["言い","いい"],["尽くせない","つくせない"],["すばらしい"],["喜び","よろこび"],["に"],["満ちあふれて","みちあふれて"],["います"],["。"]]},{"verse":9,"text":"それは、あなたがたが信仰の実りとして魂の救いを受けているからです。","tok":[["それ"],["は"],["、"],["あなた"],["がた"],["が"],["信仰","しんこう"],["の"],["実り","みのり"],["として"],["魂","たましい"],["の"],["救い","すくい"],["を"],["受けて","うけて"],["いる"],["から"],["です"],["。"]]},{"verse":10,"text":"この救いについては、あなたがたに与えられる恵みのことをあらかじめ語った預言者たちも、探求し、注意深く調べました。","tok":[["この"],["救い","すくい"],["について"],["は"],["、"],["あなた"],["がた"],["に"],["与えられる","あたえられる"],["恵み","めぐみ"],["の"],["こと"],["を"],["あらかじめ"],["語った","かたった"],["預言者","よげんしゃ"],["たち"],["も"],["、"],["探求","たんきゅう"],["
,["に"],["と"],["、"],["模範","もはん"],["を"],["残された","のこされた"],["から"],["です"],["。"]]},{"verse":22,"text":"「この方は、罪を犯したことがなく、その口には偽りがなかった。」","tok":[["「"],["この"],["方","かた"],["は"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["こと"],["が"],["なく"],["、"],["その"],["口","くち"],["に"],["は"],["偽り","いつわり"],["が"],["なかった"],["。"],["」"]]},{"verse":23,"text":"ののしられてもののしり返さず、苦しめられても人を脅さず、正しくお裁きになる方にお任せになりました。","tok":[["ののしられて"],["も"],["ののしり"],["返さず","かえさず"],["、"],["苦しめられて","くるしめられて"],["も"],["人","ひと"],["を"],["脅さず","おどさず"],["、"],["正しく","まさしく"],["お裁き","おさばき"],["に"],["なる"],["方","かた"],["に"],["お任せ","おまかせ"],["に"],["なりました"],["。"]]},{"verse":24,"text":"そして、十字架にかかって、自らその身にわたしたちの罪を担ってくださいました。わたしたちが、罪に対して死んで、義によって生きるようになるためです。そのお受けになった傷によって、あなたがたはいやされました。","tok":[["そして"],["、"],["十字架","じゅうじか"],["に"],["かかって"],["、"],["自ら","みずから"],["その"],["身","み"],["に"],["わたしたち"],["の"],["罪","つみ"],["を"],["担って","になって"],["くださいました"],["。"],["わたしたち"],["が"],["、"],["罪","つみ"],["に対して","にたいして"],["死んで","しんで"],["、"],["義","ぎ"],["によって"],["生きる","いきる"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["その"],["お受け","おうけ"],["に"],["なった"],["傷","きず"],["によって"],["、"],["あなた"],["がた"],["は"],["いやされました"],["。"]]},{"verse":25,"text":"あなたがたは羊のようにさまよっていましたが、今は、魂の牧者であり、監督者である方のところへ戻って来たのです。","tok":[["あなた"],["がた"],["は"],["羊","ひつじ"],["の"],["よう"],["に"],["さまよって"],["いました"],["が"],["、"],["今","いま"],["は"],["、"],["魂","たましい"],["の"],["牧者","ぼくしゃ"],["で"],["あり"],["、"],["監督者","かんとくしゃ"],["で"],["ある"],["方","かた"],["の"],["ところ"],["へ"],["戻って","もどって"],["来た","きた"],["の"],["です"],["。"]]}]
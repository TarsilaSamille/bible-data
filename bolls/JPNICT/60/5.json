[{"verse":1,"text":"さて、わたしは長老の一人として、また、キリストの受難の証人、やがて現れる栄光にあずかる者として、あなたがたのうちの長老たちに勧めます。","tok":[["さて"],["、"],["わたし"],["は"],["長老","ちょうろう"],["の"],["一人","ひとり"],["として"],["、"],["また"],["、"],["キリスト"],["の"],["受難","じゅなん"],["の"],["証人","しょうにん"],["、"],["やがて"],["現れる","あらわれる"],["栄光","えいこう"],["に"],["あずかる"],["者","もの"],["として"],["、"],["あなた"],["がた"],["の"],["うち"],["の"],["長老","ちょうろう"],["たち"],["に"],["勧めます","すすめます"],["。"]]},{"verse":2,"text":"あなたがたにゆだねられている、神の羊の群れを牧しなさい。強制されてではなく、神に従って、自ら進んで世話をしなさい。卑しい利得のためにではなく献身的にしなさい。","tok":[["あなた"],["がた"],["に"],["ゆだねられて"],["いる"],["、"],["神","かみ"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["牧","まき"],["し"],["なさい"],["。"],["強制","きょうせい"],["されて"],["で"],["は"],["なく"],["、"],["神","かみ"],["に"],["従って","したがって"],["、"],["自ら","みずから"],["進んで","すすんで"],["世話","せわ"],["を"],["し"],["なさい"],["。"],["卑しい","いやしい"],["利得","りとく"],["の"],["ため"],["に"],["で"],["は"],["なく"],["献身的","けんしんてき"],["に"],["し"],["なさい"],["。"]]},{"verse":3,"text":"ゆだねられている人々に対して、権威を振り回してもいけません。むしろ、群れの模範になりなさい。","tok":[["ゆだねられて"],["いる"],["人々","ひとびと"],["に対して","にたいして"],["、"],["権威","けんい"],["を"],["振り回して","ふりまわして"],["も"],["いけません"],["。"],["むしろ"],["、"],["群れ","むれ"],["の"],["模範","もはん"],["に"],["なり"],["なさい"],["。"]]},{"verse":4,"text":"そうすれば、大牧者がお見えになるとき、あなたがたはしぼむことのない栄冠を受けることになります。","tok":[["そう"],["すれば"],["、"],["大","だい"],["牧者","ぼくしゃ"],["が"],["お見え","おみえ"],["に"],["なる"],["とき"],["、"],["あなた"],["がた"],["は"],["しぼむ"],["こと"],["の"],["ない"],["栄冠","えいかん"],["を"],["受ける","うける"],["こと"],["に"],["なります"],["。"]]},{"verse":5,"text":"同じように、若い人たち、長老に従いなさい。皆互いに謙遜を身に着けなさい。なぜなら、「神は、高慢な者を敵とし、謙遜な者には恵みをお与えになる」からです。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["若い","わかい"],["人","ひと"],["たち"],["、"],["長老","ちょうろう"],["に"],["従い","したがい"],["なさい"],["。"],["皆","みな"],["互い","たがい"],["に"],["謙遜","けんそん"],["を"],["身","み"],["に"],["着け","つけ"],["なさい"],["。"],["なぜ"],["なら"],["、"],["「"],["神","かみ"],["は"],["、"],["高慢","こうまん"],["な"],["者","もの"],["を"],["敵","てき"],["と"],["し"],["、"],["謙遜","けんそん"],["な"],["者","もの"],["に"],["は"],["恵み","めぐみ"],["を"],["お与え","おあたえ"],["に"],["なる"],["」"],["から"],["です"],["。"]]},{"verse":6,"text":"だから、神の力強い御手の下で自分を低くしなさい。そうすれば、かの時には高めていただけます。","tok":[["だ"],["から"],["、"],["神","かみ"],["の"],["力強い","ちからづよい"],["御手","おて"],["の"],["下","もと"],["で"],["自分","じぶん"],["を"],["低く","ひくく"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["かの"],["時","とき"],["に"],["は"],["高めて","たかめて"],["いただけます"],["。"]]},{"verse":7,"text":"思い煩いは、何もかも神にお任せしなさい。神が、あなたがたのことを心にかけていてくださるからです。","tok":[["思い煩い","おもいわずらい"],["は"],["、"],["何","なん"],["も"],["か"],["も"],["神","かみ"],["に"],["お任せ","おまかせ"],["し"],["なさい"],["。"],["神","かみ"],["が"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["心","こころ"],["に"],["かけて"],["いて"],["くださる"],["から"],["です"],["。"]]},{"verse":8,"text":"身を慎んで目を覚ましていなさい。あなたがたの敵である悪魔が、ほえたける獅子のように、だれかを食い尽くそうと探し回っています。","tok":[["身","み"],["を"],["慎んで","つつしんで"],["目","め"],["を"],["覚まして","さまして"],["い"],["なさい"],["。"],["あなた"],["がた"],["の"],["敵","てき"],["で"],["ある"],["悪魔","あくま"],["が"],["、"],["ほえ"],["たける"],["獅子","しし"],["の"],["よう"],["に"],["、"],["だれ"],["か"],["を"],["食い","くい"],["尽くそう","つくそう"],["と"],["探し回って","さがしまわって"],["います"],["。"]]},{"verse":9,"text":"信仰にしっかり踏みとどまって、悪魔に抵抗しなさい。あなたがたと信仰を同じくする兄弟たちも、この世で同じ苦しみに遭っているのです。それはあなたがたも知っているとおりです。","tok":[["信仰","しんこう"],["に"],["しっかり"],["踏みとどまって","ふみとどまって"],["、"],["悪魔","あくま"],["に"],["抵抗","ていこう"],["し"],["なさい"],["。"],["あなた"],["がた"],["と"],["信仰","しんこう"],["を"],["同じく","おなじく"],["する"],["兄弟","きょうだい"],["たち"],["も"],["、"],["この世","このよ"],["で"],["同じ","おなじ"],["苦しみ","くるしみ"],["に"],["遭って","あって"],["いる"],["の"],["です"],["。"],["それ"],["は"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["です"],["。"]]},{"verse":10,"text":"しかし、あらゆる恵みの源である神、すなわち、キリスト‧イエスを通してあなたがたを永遠の栄光へ招いてくださった神御自身が、しばらくの間苦しんだあなたがたを完全な者とし、強め、力づけ、揺らぐことがないようにしてくださいます。","tok":[["しかし"],["、"],["あらゆる"],["恵み","めぐみ"],["の"],["源","みなもと"],["で"],["ある"],["神","かみ"],["、"],["すなわち"],["、"],["キリスト"],["‧"],["イエス"],["を"],["通して","とおして"],["あなた"],["がた"],["を"],["永遠","えいえん"],["の"],["栄光","えいこう"],["へ"],["招いて","まねいて"],["くださった"],["神","かみ"],["御自身","ごじしん"],["が"],["、"],["しばらく"],["の"],["間","あいだ"],["苦しんだ","くるしんだ"],["あなた"],["がた"],["を"],["完全","かんぜん"],["な"],["者","もの"],["と"],["し"],["、"],["強め","つよめ"],["、"],["力づけ","ちからづけ"],["、"],["揺らぐ","ゆらぐ"],["こと"],["が"],["ない"],["よう"],["に"],["して"],["くださいます"],["。"]]},{"verse":11,"text":"力が世々限りなく神にありますように、アーメン。","tok":[["力","ちから"],["が"],["世々","せいせい"],["限りなく","かぎりなく"],["神","かみ"],["に"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]},{"verse":12,"text":"わたしは、忠実な兄弟と認めているシルワノによって、あなたがたにこのように短く手紙を書き、勧告をし、これこそ神のまことの恵みであることを証ししました。この恵みにしっかり踏みとどまりなさい。","tok":[["わたし"],["は"],["、"],["忠実","ちゅうじつ"],["な"],["兄弟","きょうだい"],["と"],["認めて","みとめて"],["いる"],["シルワノ"],["によって"],["、"],["あなた"],["がた"],["に"],["この"],["よう"],["に"],["短く","みじかく"],["手紙","てがみ"],["を"],["書き","かき"],["、"],["勧告","かんこく"],["を"],["し"],["、"],["これ"],["こそ"],["神","かみ"],["の"],["まこと"],["の"],["恵み","めぐみ"],["で"],["ある"],["こと"],["を"],["証し","あかし"],["しました"],["。"],["この"],["恵み","めぐみ"],["に"],["しっかり"],["踏みとどまり","ふみとどまり"],["なさい"],["。"]]},{"verse":13,"text":"共に選ばれてバビロンにいる人々と、わたしの子マルコが、よろしくと言っています。","tok":[["共","とも"],["に"],["選ばれて","えらばれて"],["バビロン"],["に"],["いる"],["人々","ひとびと"],["と"],["、"],["わたし"],["の"],["子","こ"],["マルコ"],["が"],["、"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":14,"text":"愛の口づけによって互いに挨拶を交わしなさい。キリストと結ばれているあなたがた一同に、平和があるように。","tok":[["愛","あい"],["の"],["口づけ","くちづけ"],["によって"],["互い","たがい"],["に"],["挨拶","あいさつ"],["を"],["交わし","かわし"],["なさい"],["。"],["キリスト"],["と"],["結ばれて","むすばれて"],["いる"],["あなた"],["がた"],["一同","いちどう"],["に"],["、"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"]]}]
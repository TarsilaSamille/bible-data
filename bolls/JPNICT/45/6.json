[{"verse":1,"text":"では、どういうことになるのか。恵みが増すようにと、罪の中にとどまるべきだろうか。","tok":[["で"],["は"],["、"],["どういう"],["こと"],["に"],["なる"],["の"],["か"],["。"],["恵み","めぐみ"],["が"],["増す","ます"],["よう"],["に"],["と"],["、"],["罪","つみ"],["の"],["中","なか"],["に"],["とどまるべきだろう"],["か"],["。"]]},{"verse":2,"text":"決してそうではない。罪に対して死んだわたしたちが、どうして、なおも罪の中に生きることができるでしょう。","tok":[["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"],["罪","つみ"],["に対して","にたいして"],["死んだ","しんだ"],["わたしたち"],["が"],["、"],["どう"],["して"],["、"],["なお"],["も"],["罪","つみ"],["の"],["中","なか"],["に"],["生きる","いきる"],["こと"],["が"],["できるでしょう"],["。"]]},{"verse":3,"text":"それともあなたがたは知らないのですか。キリスト‧イエスに結ばれるために洗礼を受けたわたしたちが皆、またその死にあずかるために洗礼を受けたことを。","tok":[["それ"],["と"],["も"],["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["です"],["か"],["。"],["キリスト"],["‧"],["イエス"],["に"],["結ばれる","むすばれる"],["ため"],["に"],["洗礼","せんれい"],["を"],["受けた","うけた"],["わたしたち"],["が"],["皆","みな"],["、"],["また"],["その"],["死","し"],["に"],["あずかる"],["ため"],["に"],["洗礼","せんれい"],["を"],["受けた","うけた"],["こと"],["を"],["。"]]},{"verse":4,"text":"わたしたちは洗礼によってキリストと共に葬られ、その死にあずかるものとなりました。それは、キリストが御父の栄光によって死者の中から復活させられたように、わたしたちも新しい命に生きるためなのです。","tok":[["わたしたち"],["は"],["洗礼","せんれい"],["によって"],["キリスト"],["と"],["共","とも"],["に"],["葬られ","ほうむられ"],["、"],["その"],["死","し"],["に"],["あずかる"],["もの"],["と"],["なりました"],["。"],["それ"],["は"],["、"],["キリスト"],["が"],["御父","おちち"],["の"],["栄光","えいこう"],["によって"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させられた"],["よう"],["に"],["、"],["わたしたち"],["も"],["新しい","あたらしい"],["命","いのち"],["に"],["生きる","いきる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":5,"text":"もし、わたしたちがキリストと一体になってその死の姿にあやかるならば、その復活の姿にもあやかれるでしょう。","tok":[["もし"],["、"],["わたしたち"],["が"],["キリスト"],["と"],["一体","いったい"],["に"],["なって"],["その"],["死","し"],["の"],["姿","すがた"],["に"],["あやかるならば"],["、"],["その"],["復活","ふっかつ"],["の"],["姿","すがた"],["に"],["も"],["あやかれるでしょう"],["。"]]},{"verse":6,"text":"わたしたちの古い自分がキリストと共に十字架につけられたのは、罪に支配された体が滅ぼされ、もはや罪の奴隷にならないためであると知っています。","tok":[["わたしたち"],["の"],["古い","ふるい"],["自分","じぶん"],["が"],["キリスト"],["と"],["共","とも"],["に"],["十字架","じゅうじか"],["に"],["つけられた"],["の"],["は"],["、"],["罪","つみ"],["に"],["支配","しはい"],["された"],["体","からだ"],["が"],["滅ぼされ","ほろぼされ"],["、"],["もはや"],["罪","つみ"],["の"],["奴隷","どれい"],["に"],["ならない"],["ため"],["で"],["ある"],["と"],["知って","しって"],["います"],["。"]]},{"verse":7,"text":"死んだ者は、罪から解放されています。","tok":[["死んだ","しんだ"],["者","もの"],["は"],["、"],["罪","つみ"],["から"],["解放","かいほう"],["されて"],["います"],["。"]]},{"verse":8,"text":"わたしたちは、キリストと共に死んだのなら、キリストと共に生きることにもなると信じます。","tok":[["わたしたち"],["は"],["、"],["キリスト"],["と"],["共","とも"],["に"],["死んだ","しんだ"],["の"],["なら"],["、"],["キリスト"],["と"],["共","とも"],["に"],["生きる","いきる"],["こと"],["に"],["も"],["なる"],["と"],["信じます","しんじます"],["。"]]},{"verse":9,"text":"そして、死者の中から復活させられたキリストはもはや死ぬことがない、と知っています。死は、もはやキリストを支配しません。","tok":[["そして"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させられた"],["キリスト"],["は"],["もはや"],["死ぬ","しぬ"],["こと"],["が"],["ない"],["、"],["と"],["知って","しって"],["います"],["。"],["死","し"],["は"],["、"],["もはや"],["キリスト"],["を"],["支配","しはい"],["しません"],["。"]]},{"verse":10,"text":"キリストが死なれたのは、ただ一度罪に対して死なれたのであり、生きておられるのは、神に対して生きておられるのです。","tok":[["キリスト"],["が"],["死なれた","しなれた"],["の"],["は"],["、"],["ただ"],["一度","いちど"],["罪","つみ"],["に対して","にたいして"],["死なれた","しなれた"],["ので"],["あり"],["、"],["生きて","いきて"],["おられる"],["の"],["は"],["、"],["神","かみ"],["に対して","にたいして"],["生きて","いきて"],["おられる"],["の"],["です"],["。"]]},{"verse":11,"text":"このように、あなたがたも自分は罪に対して死んでいるが、キリスト‧イエスに結ばれて、神に対して生きているのだと考えなさい。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["自分","じぶん"],["は"],["罪","つみ"],["に対して","にたいして"],["死んで","しんで"],["いる"],["が"],["、"],["キリスト"],["‧"],["イエス"],["に"],["結ばれて","むすばれて"],["、"],["神","かみ"],["に対して","にたいして"],["生きて","いきて"],["いる"],["の"],["だ"],["と"],["考え","かんがえ"],["なさい"],["。"]]},{"verse":12,"text":"従って、あなたがたの死ぬべき体を罪に支配させて、体の欲望に従うようなことがあってはなりません。","tok":[["従って","したがって"],["、"],["あなた"],["がた"],["の"],["死ぬべき","しぬべき"],["体","からだ"],["を"],["罪","つみ"],["に"],["支配","しはい"],["させて"],["、"],["体","からだ"],["の"],["欲望","よくぼう"],["に"],["従う","したがう"],["よう"],["な"],["こと"],["が"],["あって"],["は"],["なりません"],["。"]]},{"verse":13,"text":"また、あなたがたの五体を不義のための道具として罪に任せてはなりません。かえって、自分自身を死者の中から生き返った者として神に献げ、また、五体を義のための道具として神に献げなさい。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["五体","ごたい"],["を"],["不義","ふぎ"],["の"],["ため"],["の"],["道具","どうぐ"],["として"],["罪","つみ"],["に"],["任せて","まかせて"],["は"],["なりません"],["。"],["かえって"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["生き返った","いきかえった"],["者","もの"],["として"],["神","かみ"],["に"],["献げ","ささげ"],["、"],["また"],["、"],["五体","ごたい"],["を"],["義","ぎ"],["の"],["ため"],["の"],["道具","どうぐ"],["として"],["神","かみ"],["に"],["献げ","ささげ"],["なさい"],["。"]]},{"verse":14,"text":"なぜなら、罪は、もはや、あなたがたを支配することはないからです。あなたがたは律法の下ではなく、恵みの下にいるのです。","tok":[["なぜ"],["なら"],["、"],["罪","つみ"],["は"],["、"],["もはや"],["、"],["あなた"],["がた"],["を"],["支配","しはい"],["する"],["こと"],["は"],["ない"],["から"],["です"],["。"],["あなた"],["がた"],["は"],["律法","りっぽう"],["の"],["下","もと"],["で"],["は"],["なく"],["、"],["恵み","めぐみ"],["の"],["下","した"],["に"],["いる"],["の"],["です"],["。"]]},{"verse":15,"text":"では、どうなのか。わたしたちは、律法の下ではなく恵みの下にいるのだから、罪を犯してよいということでしょうか。決してそうではない。","tok":[["で"],["は"],["、"],["どう"],["な"],["の"],["か"],["。"],["わたしたち"],["は"],["、"],["律法","りっぽう"],["の"],["下","もと"],["で"],["は"],["なく"],["恵み","めぐみ"],["の"],["下","した"],["に"],["いる"],["の"],["だ"],["から"],["、"],["罪","つみ"],["を"],["犯して","おかして"],["よい"],["と"],["いう"],["こと"],["でしょう"],["か"],["。"],["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"]]},{"verse":16,"text":"知らないのですか。あなたがたは、だれかに奴隷として従えば、その従っている人の奴隷となる。つまり、あなたがたは罪に仕える奴隷となって死に至るか、神に従順に仕える奴隷となって義に至るか、どちらかなのです。","tok":[["知らない","しらない"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["だれ"],["か"],["に"],["奴隷","どれい"],["として"],["従えば","したがえば"],["、"],["その"],["従って","したがって"],["いる"],["人","ひと"],["の"],["奴隷","どれい"],["と"],["なる"],["。"],["つまり"],["、"],["あなた"],["がた"],["は"],["罪","つみ"],["に"],["仕える","つかえる"],["奴隷","どれい"],["と"],["なって"],["死","し"],["に"],["至る","いたる"],["か"],["、"],["神","かみ"],["に"],["従順","じゅうじゅん"],["に"],["仕える","つかえる"],["奴隷","どれい"],["と"],["なって"],["義","ぎ"],["に"],["至る","いたる"],["か"],["、"],["どちら"],["か"],["な"],["の"],["です"],["。"]]},{"verse":17,"text":"しかし、神に感謝します。あなたがたは、かつては罪の奴隷でしたが、今は伝えられた教えの規範を受け入れ、それに心から従うようになり、","tok":[["しかし"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["します"],["。"],["あなた"],["がた"],["は"],["、"],["かつて"],["は"],["罪","つみ"],["の"],["奴隷","どれい"],["でした"],["が"],["、"],["今","いま"],["は"],["伝えられた","つたえられた"],["教え","おしえ"],["の"],["規範","きはん"],["を"],["受け入れ","うけいれ"],["、"],["それ"],["に"],["心","こころ"],["から"],["従う","したがう"],["よう"],["に"],["なり"],["、"]]},{"verse":18,"text":"罪から解放され、義に仕えるようになりました。","tok":[["罪","つみ"],["から"],["解放","かいほう"],["され"],["、"],["義","ぎ"],["に"],["仕える","つかえる"],["よう"],["に"],["なりました"],["。"]]},{"verse":19,"text":"あなたがたの肉の弱さを考慮して、分かりやすく説明しているのです。かつて自分の五体を汚れと不法の奴隷として、不法の中に生きていたように、今これを義の奴隷として献げて、聖なる生活を送りなさい。","tok":[["あなた"],["がた"],["の"],["肉","にく"],["の"],["弱","よわ"],["さ"],["を"],["考慮","こうりょ"],["して"],["、"],["分かり","わかり"],["やすく"],["説明","せつめい"],["して"],["いる"],["の"],["です"],["。"],["かつて"],["自分","じぶん"],["の"],["五体","ごたい"],["を"],["汚れ","よごれ"],["と"],["不法","ふほう"],["の"],["奴隷","どれい"],["として"],["、"],["不法","ふほう"],["の"],["中","なか"],["に"],["生きて","いきて"],["いた"],["よう"],["に"],["、"],["今","いま"],["これ"],["を"],["義","ぎ"],["の"],["奴隷","どれい"],["として"],["献げて","ささげて"],["、"],["聖","せい"],["なる"],["生活","せいかつ"],["を"],["送り","おくり"],["なさい"],["。"]]},{"verse":20,"text":"あなたがたは、罪の奴隷であったときは、義に対しては自由の身でした。","tok":[["あなた"],["がた"],["は"],["、"],["罪","つみ"],["の"],["奴隷","どれい"],["で"],["あった"],["とき"],["は"],["、"],["義","ぎ"],["に対して","にたいして"],["は"],["自由","じゆう"],["の"],["身","み"],["でした"],["。"]]},{"verse":21,"text":"では、そのころ、どんな実りがありましたか。あなたがたが今では恥ずかしいと思うものです。それらの行き着くところは、死にほかならない。","tok":[["で"],["は"],["、"],["その"],["ころ"],["、"],["どんな"],["実り","みのり"],["が"],["ありました"],["か"],["。"],["あなた"],["がた"],["が"],["今","いま"],["で"],["は"],["恥ずかしい","はずかしい"],["と"],["思う","おもう"],["もの"],["です"],["。"],["それ"],["ら"],["の"],["行き着く","いきつく"],["ところ"],["は"],["、"],["死に","しに"],["ほか"],["ならない"],["。"]]},{"verse":22,"text":"あなたがたは、今は罪から解放されて神の奴隷となり、聖なる生活の実を結んでいます。行き着くところは、永遠の命です。","tok":[["あなた"],["がた"],["は"],["、"],["今","いま"],["は"],["罪","つみ"],["から"],["解放","かいほう"],["されて"],["神","かみ"],["の"],["奴隷","どれい"],["と"],["なり"],["、"],["聖","せい"],["なる"],["生活","せいかつ"],["の"],["実","じつ"],["を"],["結んで","むすんで"],["います"],["
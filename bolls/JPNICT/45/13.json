[{"verse":1,"text":"人は皆、上に立つ権威に従うべきです。神に由来しない権威はなく、今ある権威はすべて神によって立てられたものだからです。","tok":[["人","ひと"],["は"],["皆","みな"],["、"],["上","うえ"],["に"],["立つ","たつ"],["権威","けんい"],["に"],["従うべきです","したがうべきです"],["。"],["神","かみ"],["に"],["由来","ゆらい"],["しない"],["権威","けんい"],["は"],["なく"],["、"],["今","いま"],["ある"],["権威","けんい"],["は"],["すべて"],["神","かみ"],["によって"],["立てられた","たてられた"],["もの"],["だ"],["から"],["です"],["。"]]},{"verse":2,"text":"従って、権威に逆らう者は、神の定めに背くことになり、背く者は自分の身に裁きを招くでしょう。","tok":[["従って","したがって"],["、"],["権威","けんい"],["に"],["逆らう","さからう"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["定め","さだめ"],["に"],["背く","そむく"],["こと"],["に"],["なり"],["、"],["背く","そむく"],["者","もの"],["は"],["自分","じぶん"],["の"],["身","み"],["に"],["裁き","さばき"],["を"],["招くでしょう","まねくでしょう"],["。"]]},{"verse":3,"text":"実際、支配者は、善を行う者にはそうではないが、悪を行う者には恐ろしい存在です。あなたは権威者を恐れないことを願っている。それなら、善を行いなさい。そうすれば、権威者からほめられるでしょう。","tok":[["実際","じっさい"],["、"],["支配者","しはいしゃ"],["は"],["、"],["善","ぜん"],["を"],["行う","おこなう"],["者","もの"],["に"],["は"],["そう"],["で"],["は"],["ない"],["が"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["に"],["は"],["恐ろしい","おそろしい"],["存在","そんざい"],["です"],["。"],["あなた"],["は"],["権威者","けんいしゃ"],["を"],["恐れない","おそれない"],["こと"],["を"],["願って","ねがって"],["いる"],["。"],["それ"],["なら"],["、"],["善","ぜん"],["を"],["行い","おこない"],["なさい"],["。"],["そう"],["すれば"],["、"],["権威者","けんいしゃ"],["から"],["ほめられるでしょう"],["。"]]},{"verse":4,"text":"権威者は、あなたに善を行わせるために、神に仕える者なのです。しかし、もし悪を行えば、恐れなければなりません。権威者はいたずらに剣を帯びているのではなく、神に仕える者として、悪を行う者に怒りをもって報いるのです。","tok":[["権威者","けんいしゃ"],["は"],["、"],["あなた"],["に"],["善","ぜん"],["を"],["行わせる","おこなわせる"],["ため"],["に"],["、"],["神","かみ"],["に"],["仕える","つかえる"],["者","もの"],["な"],["の"],["です"],["。"],["しかし"],["、"],["もし"],["悪","わる"],["を"],["行えば","おこなえば"],["、"],["恐れなければ","おそれなければ"],["なりません"],["。"],["権威者","けんいしゃ"],["は"],["いたずら"],["に"],["剣","けん"],["を"],["帯びて","おびて"],["いる"],["ので"],["は"],["なく"],["、"],["神","かみ"],["に"],["仕える","つかえる"],["者","もの"],["として"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["に"],["怒り","いかり"],["を"],["もって"],["報いる","むくいる"],["の"],["です"],["。"]]},{"verse":5,"text":"だから、怒りを逃れるためだけでなく、良心のためにも、これに従うべきです。","tok":[["だ"],["から"],["、"],["怒り","いかり"],["を"],["逃れる","のがれる"],["ため"],["だけ"],["で"],["なく"],["、"],["良心","りょうしん"],["の"],["ため"],["に"],["も"],["、"],["これ"],["に"],["従うべきです","したがうべきです"],["。"]]},{"verse":6,"text":"あなたがたが貢を納めているのもそのためです。権威者は神に仕える者であり、そのことに励んでいるのです。","tok":[["あなた"],["がた"],["が"],["貢","みつぎ"],["を"],["納めて","おさめて"],["いる"],["の"],["も"],["その"],["ため"],["です"],["。"],["権威者","けんいしゃ"],["は"],["神","かみ"],["に"],["仕える","つかえる"],["者","もの"],["で"],["あり"],["、"],["その"],["こと"],["に"],["励んで","はげんで"],["いる"],["の"],["です"],["。"]]},{"verse":7,"text":"すべての人々に対して自分の義務を果たしなさい。貢を納めるべき人には貢を納め、税を納めるべき人には税を納め、恐るべき人は恐れ、敬うべき人は敬いなさい。","tok":[["すべて"],["の"],["人々","ひとびと"],["に対して","にたいして"],["自分","じぶん"],["の"],["義務","ぎむ"],["を"],["果たし","はたし"],["なさい"],["。"],["貢","みつぎ"],["を"],["納めるべき","おさめるべき"],["人","ひと"],["に"],["は"],["貢","みつぎ"],["を"],["納め","おさめ"],["、"],["税","ぜい"],["を"],["納めるべき","おさめるべき"],["人","ひと"],["に"],["は"],["税","ぜい"],["を"],["納め","おさめ"],["、"],["恐るべき","おそるべき"],["人","ひと"],["は"],["恐れ","おそれ"],["、"],["敬うべき","うやまうべき"],["人","ひと"],["は"],["敬い","うやまい"],["なさい"],["。"]]},{"verse":8,"text":"互いに愛し合うことのほかは、だれに対しても借りがあってはなりません。人を愛する者は、律法を全うしているのです。","tok":[["互い","たがい"],["に"],["愛し合う","あいしあう"],["こと"],["の"],["ほか"],["は"],["、"],["だれ"],["に対して","にたいして"],["も"],["借り","かり"],["が"],["あって"],["は"],["なりません"],["。"],["人","ひと"],["を"],["愛する","あいする"],["者","もの"],["は"],["、"],["律法","りっぽう"],["を"],["全う","まっとう"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":9,"text":"「姦淫するな、殺すな、盗むな、むさぼるな」、そのほかどんな掟があっても、「隣人を自分のように愛しなさい」という言葉に要約されます。","tok":[["「"],["姦淫","かんいん"],["する"],["な"],["、"],["殺す","ころす"],["な"],["、"],["盗む","ぬすむ"],["な"],["、"],["むさぼる"],["な"],["」"],["、"],["その"],["ほか"],["どんな"],["掟","おきて"],["が"],["あって"],["も"],["、"],["「"],["隣人","りんじん"],["を"],["自分","じぶん"],["の"],["よう"],["に"],["愛し","あいし"],["なさい"],["」"],["と"],["いう"],["言葉","ことば"],["に"],["要約","ようやく"],["されます"],["。"]]},{"verse":10,"text":"愛は隣人に悪を行いません。だから、愛は律法を全うするものです。","tok":[["愛","あい"],["は"],["隣人","りんじん"],["に"],["悪","あく"],["を"],["行いません","おこないません"],["。"],["だ"],["から"],["、"],["愛","あい"],["は"],["律法","りっぽう"],["を"],["全う","まっとう"],["する"],["もの"],["です"],["。"]]},{"verse":11,"text":"更に、あなたがたは今がどんな時であるかを知っています。あなたがたが眠りから覚めるべき時が既に来ています。今や、わたしたちが信仰に入ったころよりも、救いは近づいているからです。","tok":[["更に","さらに"],["、"],["あなた"],["がた"],["は"],["今","いま"],["が"],["どんな"],["時","とき"],["で"],["ある"],["か"],["を"],["知って","しって"],["います"],["。"],["あなた"],["がた"],["が"],["眠り","ねむり"],["から"],["覚めるべき","さめるべき"],["時","とき"],["が"],["既に","すでに"],["来て","きて"],["います"],["。"],["今","いま"],["や"],["、"],["わたしたち"],["が"],["信仰","しんこう"],["に"],["入った","はいった"],["ころ"],["より"],["も"],["、"],["救い","すくい"],["は"],["近づいて","ちかづいて"],["いる"],["から"],["です"],["。"]]},{"verse":12,"text":"夜は更け、日は近づいた。だから、闇の行いを脱ぎ捨てて光の武具を身に着けましょう。","tok":[["夜","よる"],["は"],["更け","ふけ"],["、"],["日","ひ"],["は"],["近づいた","ちかづいた"],["。"],["だ"],["から"],["、"],["闇","やみ"],["の"],["行い","おこない"],["を"],["脱ぎ捨てて","ぬぎすてて"],["光","ひかり"],["の"],["武具","ぶぐ"],["を"],["身","み"],["に"],["着けましょう","つけましょう"],["。"]]},{"verse":13,"text":"日中を歩むように、品位をもって歩もうではありませんか。酒宴と酩酊、淫乱と好色、争いとねたみを捨て、","tok":[["日中","にっちゅう"],["を"],["歩む","あゆむ"],["よう"],["に"],["、"],["品位","ひんい"],["を"],["もって"],["歩もうで","あゆもうで"],["は"],["ありません"],["か"],["。"],["酒宴","しゅえん"],["と"],["酩酊","めいてい"],["、"],["淫乱","いんらん"],["と"],["好色","こうしょく"],["、"],["争い","あらそい"],["と"],["ねたみ"],["を"],["捨て","すて"],["、"]]},{"verse":14,"text":"主イエス‧キリストを身にまといなさい。欲望を満足させようとして、肉に心を用いてはなりません。","tok":[["主","しゅ"],["イエス"],["‧"],["キリスト"],["を"],["身","み"],["に"],["まとい"],["なさい"],["。"],["欲望","よくぼう"],["を"],["満足","まんぞく"],["させよう"],["として"],["、"],["肉","にく"],["に"],["心","こころ"],["を"],["用いて","もちいて"],["は"],["なりません"],["。"]]}]
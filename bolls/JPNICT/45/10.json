[{"verse":1,"text":"兄弟たち、わたしは彼らが救われることを心から願い、彼らのために神に祈っています。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["が"],["救われる","すくわれる"],["こと"],["を"],["心","こころ"],["から"],["願い","ねがい"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["神","かみ"],["に"],["祈って","いのって"],["います"],["。"]]},{"verse":2,"text":"わたしは彼らが熱心に神に仕えていることを証ししますが、この熱心さは、正しい認識に基づくものではありません。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["が"],["熱心","ねっしん"],["に"],["神","かみ"],["に"],["仕えて","つかえて"],["いる"],["こと"],["を"],["証し","あかし"],["します"],["が"],["、"],["この"],["熱心","ねっしん"],["さ"],["は"],["、"],["正しい","ただしい"],["認識","にんしき"],["に"],["基づく","もとづく"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":3,"text":"なぜなら、神の義を知らず、自分の義を求めようとして、神の義に従わなかったからです。","tok":[["なぜ"],["なら"],["、"],["神","かみ"],["の"],["義","ぎ"],["を"],["知らず","しらず"],["、"],["自分","じぶん"],["の"],["義","ぎ"],["を"],["求めよう","もとめよう"],["として"],["、"],["神","かみ"],["の"],["義","ぎ"],["に"],["従わなかった","したがわなかった"],["から"],["です"],["。"]]},{"verse":4,"text":"キリストは律法の目標であります、信じる者すべてに義をもたらすために。","tok":[["キリスト"],["は"],["律法","りっぽう"],["の"],["目標","もくひょう"],["で"],["あります"],["、"],["信じる","しんじる"],["者","もの"],["すべて"],["に"],["義","ぎ"],["を"],["もたらす"],["ため"],["に"],["。"]]},{"verse":5,"text":"モーセは、律法による義について、「掟を守る人は掟によって生きる」と記しています。","tok":[["モーセ"],["は"],["、"],["律法","りっぽう"],["に"],["よる"],["義","ぎ"],["について"],["、"],["「"],["掟","おきて"],["を"],["守る","まもる"],["人","ひと"],["は"],["掟","おきて"],["によって"],["生きる","いきる"],["」"],["と"],["記して","しるして"],["います"],["。"]]},{"verse":6,"text":"しかし、信仰による義については、こう述べられています。「心の中で『だれが天に上るか』と言ってはならない。」これは、キリストを引き降ろすことにほかなりません。","tok":[["しかし"],["、"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["について"],["は"],["、"],["こう"],["述べられて","のべられて"],["います"],["。"],["「"],["心","こころ"],["の"],["中","なか"],["で"],["『"],["だれ"],["が"],["天","てん"],["に"],["上る","のぼる"],["か"],["』"],["と"],["言って","いって"],["は"],["ならない"],["。"],["」"],["これ"],["は"],["、"],["キリスト"],["を"],["引き降ろす","ひきおろす"],["こと"],["に"],["ほか"],["なりません"],["。"]]},{"verse":7,"text":"また、「『だれが底なしの淵に下るか』と言ってもならない。」これは、キリストを死者の中から引き上げることになります。","tok":[["また"],["、"],["「"],["『"],["だれ"],["が"],["底なし","そこなし"],["の"],["淵","ふち"],["に"],["下る","くだる"],["か"],["』"],["と"],["言って","いって"],["も"],["ならない"],["。"],["」"],["これ"],["は"],["、"],["キリスト"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["引き上げる","ひきあげる"],["こと"],["に"],["なります"],["。"]]},{"verse":8,"text":"では、何と言われているのだろうか。「御言葉はあなたの近くにあり、あなたの口、あなたの心にある。」これは、わたしたちが宣べ伝えている信仰の言葉なのです。","tok":[["で"],["は"],["、"],["何","なん"],["と"],["言われて","いわれて"],["いる"],["の"],["だろう"],["か"],["。"],["「"],["御言葉","おことば"],["は"],["あなた"],["の"],["近く","ちかく"],["に"],["あり"],["、"],["あなた"],["の"],["口","くち"],["、"],["あなた"],["の"],["心","こころ"],["に"],["ある"],["。"],["」"],["これ"],["は"],["、"],["わたしたち"],["が"],["宣べ伝えて","のべつたえて"],["いる"],["信仰","しんこう"],["の"],["言葉","ことば"],["な"],["の"],["です"],["。"]]},{"verse":9,"text":"口でイエスは主であると公に言い表し、心で神がイエスを死者の中から復活させられたと信じるなら、あなたは救われるからです。","tok":[["口","くち"],["で"],["イエス"],["は"],["主","ぬし"],["で"],["ある"],["と"],["公","おおやけ"],["に"],["言い表し","いいあらわし"],["、"],["心","こころ"],["で"],["神","かみ"],["が"],["イエス"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させられた"],["と"],["信じるなら","しんじるなら"],["、"],["あなた"],["は"],["救われる","すくわれる"],["から"],["です"],["。"]]},{"verse":10,"text":"実に、人は心で信じて義とされ、口で公に言い表して救われるのです。","tok":[["実","じつ"],["に"],["、"],["人","ひと"],["は"],["心","こころ"],["で"],["信じて","しんじて"],["義","ぎ"],["と"],["され"],["、"],["口","くち"],["で"],["公","おおやけ"],["に"],["言い表して","いいあらわして"],["救われる","すくわれる"],["の"],["です"],["。"]]},{"verse":11,"text":"聖書にも、「主を信じる者は、だれも失望することがない」と書いてあります。","tok":[["聖書","せいしょ"],["に"],["も"],["、"],["「"],["主","ぬし"],["を"],["信じる","しんじる"],["者","もの"],["は"],["、"],["だれ"],["も"],["失望","しつぼう"],["する"],["こと"],["が"],["ない"],["」"],["と"],["書いて","かいて"],["あります"],["。"]]},{"verse":12,"text":"ユダヤ人とギリシア人の区別はなく、すべての人に同じ主がおられ、御自分を呼び求めるすべての人を豊かにお恵みになるからです。","tok":[["ユダヤ人","ゆだやじん"],["と"],["ギリシア"],["人","にん"],["の"],["区別","くべつ"],["は"],["なく"],["、"],["すべて"],["の"],["人","ひと"],["に"],["同じ","おなじ"],["主","ぬし"],["が"],["おられ"],["、"],["御自分","ごじぶん"],["を"],["呼び求める","よびもとめる"],["すべて"],["の"],["人","ひと"],["を"],["豊か","ゆたか"],["に"],["お恵み","おめぐみ"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":13,"text":"「主の名を呼び求める者はだれでも救われる」のです。","tok":[["「"],["主","ぬし"],["の"],["名","な"],["を"],["呼び求める","よびもとめる"],["者","もの"],["は"],["だれ"],["で"],["も"],["救われる","すくわれる"],["」"],["の"],["です"],["。"]]},{"verse":14,"text":"ところで、信じたことのない方を、どうして呼び求められよう。聞いたことのない方を、どうして信じられよう。また、宣べ伝える人がなければ、どうして聞くことができよう。","tok":[["ところ"],["で"],["、"],["信じた","しんじた"],["こと"],["の"],["ない"],["方","ほう"],["を"],["、"],["どう"],["して"],["呼び求められよう","よびもとめられよう"],["。"],["聞いた","きいた"],["こと"],["の"],["ない"],["方","ほう"],["を"],["、"],["どう"],["して"],["信じられよう","しんじられよう"],["。"],["また"],["、"],["宣べ伝える","のべつたえる"],["人","ひと"],["が"],["なければ"],["、"],["どう"],["して"],["聞く","きく"],["こと"],["が"],["できよう"],["。"]]},{"verse":15,"text":"遣わされないで、どうして宣べ伝えることができよう。「良い知らせを伝える者の足は、なんと美しいことか」と書いてあるとおりです。","tok":[["遣わされないで","つかわされないで"],["、"],["どう"],["して"],["宣べ伝える","のべつたえる"],["こと"],["が"],["できよう"],["。"],["「"],["良い","よい"],["知らせ","しらせ"],["を"],["伝える","つたえる"],["者","もの"],["の"],["足","あし"],["は"],["、"],["なん"],["と"],["美しい","うつくしい"],["こと"],["か"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":16,"text":"しかし、すべての人が福音に従ったのではありません。イザヤは、「主よ、だれがわたしたちから聞いたことを信じましたか」と言っています。","tok":[["しかし"],["、"],["すべて"],["の"],["人","ひと"],["が"],["福音","ふくいん"],["に"],["従った","したがった"],["ので"],["は"],["ありません"],["。"],["イザヤ"],["は"],["、"],["「"],["主","ぬし"],["よ"],["、"],["だれ"],["が"],["わたしたち"],["から"],["聞いた","きいた"],["こと"],["を"],["信じました","しんじました"],["か"],["」"],["と"],["言って","いって"],["います"],["。"]]},{"verse":17,"text":"実に、信仰は聞くことにより、しかも、キリストの言葉を聞くことによって始まるのです。","tok":[["実","じつ"],["に"],["、"],["信仰","しんこう"],["は"],["聞く","きく"],["こと"],["に"],["より"],["、"],["しかも"],["、"],["キリスト"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["こと"],["によって"],["始まる","はじまる"],["の"],["です"],["。"]]},{"verse":18,"text":"それでは、尋ねよう。彼らは聞いたことがなかったのだろうか。もちろん聞いたのです。「その声は全地に響き渡り、その言葉は世界の果てにまで及ぶ」のです。","tok":[["それ"],["で"],["は"],["、"],["尋ねよう","たずねよう"],["。"],["彼","かれ"],["ら"],["は"],["聞いた","きいた"],["こと"],["が"],["なかった"],["の"],["だろう"],["か"],["。"],["もちろん"],["聞いた","きいた"],["の"],["です"],["。"],["「"],["その"],["声","こえ"],["は"],["全地","ぜんち"],["に"],["響き","ひびき"],["渡り","わたり"],["、"],["その"],["言葉","ことば"],["は"],["世界","せかい"],["の"],["果て","はて"],["に"],["まで"],["及ぶ","およぶ"],["」"],["の"],["です"],["。"]]},{"verse":19,"text":"それでは、尋ねよう。イスラエルは分からなかったのだろうか。このことについては、まずモーセが、「わたしは、わたしの民でない者のことであなたがたにねたみを起こさせ、愚かな民のことであなたがたを怒らせよう」と言っています。","tok":[["それ"],["で"],["は"],["、"],["尋ねよう","たずねよう"],["。"],["イスラエル"],["は"],["分からなかった","わからなかった"],["の"],["だろう"],["か"],["。"],["この"],["こと"],["について"],["は"],["、"],["まず"],["モーセ"],["が"],["、"],["「"],["わたし"],["は"],["、"],["わたし"],["の"],["民","たみ"],["で"],["ない"],["者","もの"],["の"],["こと"],["で"],["あなた"],["がた"],["に"],["ねたみ"],["を"],["起こさせ","おこさせ"],["、"],["愚か","おろか"],["な"],["民","たみ"],["の"],["こと"],["で"],["あなた"],["がた"],["を"],["怒らせよう","おこらせよう"],["」"],["と"],["言って","いって"],["います"],["。"]]},{"verse":20,"text":"イザヤも大胆に、「わたしは、わたしを探さなかった者たちに見いだされ、わたしを尋ねなかった者たちに自分を現した」と言っています。","tok":[["イザヤ"],["も"],["大胆","だいたん"],["に"],["、"],["「"],["わたし"],["は"],["、"],["わたし"],["を"],["探さなかった","さがさなかった"],["者","もの"],["たち"],["に"],["見いだされ","みいだされ"],["、"],["わたし"],["を"],["尋ねなかった","たずねなかった"],["者","もの"],["たち"],["に"],["自分","じぶん"],["を"],["現した","あらわした"],["」"],["と"],["言って","いって"],["います"],["。"]]},{"verse":21,"text":"しかし、イスラエルについては、「わたしは、不従順で反抗する民に、一日中手を差し伸べた」と言っています。","tok":[["しかし"],["、"],["イスラエル"],["について"],["は"],["、"],["「"],["わたし"],["は"],["、"],["不","ふ"],["従順","じゅうじゅん"],["で"],["反抗","はんこう"],["する"],["民","たみ"],["に"],["、"],["一","いち"],["日","にち"],["中手","ちゅうしゅ"],["を"],["差し伸べた","さしのべた"],["」"],["と"],["言って","いって"],["います"],["。"]]}]
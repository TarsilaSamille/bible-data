[{"verse":1,"text":"では、肉によるわたしたちの先祖アブラハムは何を得たと言うべきでしょうか。","tok":[["で"],["は"],["、"],["肉","にく"],["に"],["よる"],["わたしたち"],["の"],["先祖","せんぞ"],["アブラハム"],["は"],["何","なん"],["を"],["得た","えた"],["と"],["言うべきでしょう","ゆうべきでしょう"],["か"],["。"]]},{"verse":2,"text":"もし、彼が行いによって義とされたのであれば、誇ってもよいが、神の前ではそれはできません。","tok":[["もし"],["、"],["彼","かれ"],["が"],["行い","おこない"],["によって"],["義","ぎ"],["と"],["された"],["ので"],["あれば"],["、"],["誇って","ほこって"],["も"],["よい"],["が"],["、"],["神","かみ"],["の"],["前","まえ"],["で"],["は"],["それ"],["は"],["できません"],["。"]]},{"verse":3,"text":"聖書には何と書いてありますか。「アブラハムは神を信じた。それが、彼の義と認められた」とあります。","tok":[["聖書","せいしょ"],["に"],["は"],["何","なん"],["と"],["書いて","かいて"],["あります"],["か"],["。"],["「"],["アブラハム"],["は"],["神","かみ"],["を"],["信じた","しんじた"],["。"],["それ"],["が"],["、"],["彼","かれ"],["の"],["義","ぎ"],["と"],["認められた","みとめられた"],["」"],["と"],["あります"],["。"]]},{"verse":4,"text":"ところで、働く者に対する報酬は恵みではなく、当然支払われるべきものと見なされています。","tok":[["ところ"],["で"],["、"],["働く","はたらく"],["者","もの"],["に"],["対する","たいする"],["報酬","ほうしゅう"],["は"],["恵み","めぐみ"],["で"],["は"],["なく"],["、"],["当然","とうぜん"],["支払われるべき","しはらわれるべき"],["もの"],["と"],["見なされて","みなされて"],["います"],["。"]]},{"verse":5,"text":"しかし、不信心な者を義とされる方を信じる人は、働きがなくても、その信仰が義と認められます。","tok":[["しかし"],["、"],["不信心","ふしんじん"],["な"],["者","もの"],["を"],["義","ぎ"],["と"],["される"],["方","かた"],["を"],["信じる","しんじる"],["人","ひと"],["は"],["、"],["働き","はたらき"],["が"],["なくて"],["も"],["、"],["その"],["信仰","しんこう"],["が"],["義","ぎ"],["と"],["認められます","みとめられます"],["。"]]},{"verse":6,"text":"同じようにダビデも、行いによらずに神から義と認められた人の幸いを、次のようにたたえています。","tok":[["同じ","おなじ"],["よう"],["に"],["ダビデ"],["も"],["、"],["行い","おこない"],["に"],["よらず"],["に"],["神","かみ"],["から"],["義","ぎ"],["と"],["認められた","みとめられた"],["人","ひと"],["の"],["幸い","さいわい"],["を"],["、"],["次","つぎ"],["の"],["よう"],["に"],["たたえて"],["います"],["。"]]},{"verse":7,"text":"「不法が赦され、罪を覆い隠された人々は、幸いである。","tok":[["「"],["不法","ふほう"],["が"],["赦され","ゆるされ"],["、"],["罪","つみ"],["を"],["覆い隠された","おおいかくされた"],["人々","ひとびと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["。"]]},{"verse":8,"text":"主から罪があると見なされない人は、幸いである。」","tok":[["主","ぬし"],["から"],["罪","つみ"],["が"],["ある"],["と"],["見なされない","みなされない"],["人","ひと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"では、この幸いは、割礼を受けた者だけに与えられるのですか。それとも、割礼のない者にも及びますか。わたしたちは言います。「アブラハムの信仰が義と認められた」のです。","tok":[["で"],["は"],["、"],["この"],["幸い","さいわい"],["は"],["、"],["割礼","かつれい"],["を"],["受けた","うけた"],["者","もの"],["だけ"],["に"],["与えられる","あたえられる"],["の"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["に"],["も"],["及びます","およびます"],["か"],["。"],["わたしたち"],["は"],["言います","いいます"],["。"],["「"],["アブラハム"],["の"],["信仰","しんこう"],["が"],["義","ぎ"],["と"],["認められた","みとめられた"],["」"],["の"],["です"],["。"]]},{"verse":10,"text":"どのようにしてそう認められたのでしょうか。割礼を受けてからですか。それとも、割礼を受ける前ですか。割礼を受けてからではなく、割礼を受ける前のことです。","tok":[["どの"],["よう"],["に"],["して"],["そう"],["認められた","みとめられた"],["の"],["でしょう"],["か"],["。"],["割礼","かつれい"],["を"],["受けて","うけて"],["から"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["割礼","かつれい"],["を"],["受ける","うける"],["前","まえ"],["です"],["か"],["。"],["割礼","かつれい"],["を"],["受けて","うけて"],["から"],["で"],["は"],["なく"],["、"],["割礼","かつれい"],["を"],["受ける","うける"],["前","まえ"],["の"],["こと"],["です"],["。"]]},{"verse":11,"text":"アブラハムは、割礼を受ける前に信仰によって義とされた証しとして、割礼の印を受けたのです。こうして彼は、割礼のないままに信じるすべての人の父となり、彼らも義と認められました。","tok":[["アブラハム"],["は"],["、"],["割礼","かつれい"],["を"],["受ける","うける"],["前","まえ"],["に"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["された"],["証し","あかし"],["として"],["、"],["割礼","かつれい"],["の"],["印","しるし"],["を"],["受けた","うけた"],["の"],["です"],["。"],["こう"],["して"],["彼","かれ"],["は"],["、"],["割礼","かつれい"],["の"],["ない"],["まま"],["に"],["信じる","しんじる"],["すべて"],["の"],["人","ひと"],["の"],["父","ちち"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["も"],["義","ぎ"],["と"],["認められました","みとめられました"],["。"]]},{"verse":12,"text":"更にまた、彼は割礼を受けた者の父、すなわち、単に割礼を受けているだけでなく、わたしたちの父アブラハムが割礼以前に持っていた信仰の模範に従う人々の父ともなったのです。","tok":[["更に","さらに"],["また"],["、"],["彼","かれ"],["は"],["割礼","かつれい"],["を"],["受けた","うけた"],["者","もの"],["の"],["父","ちち"],["、"],["すなわち"],["、"],["単に","たんに"],["割礼","かつれい"],["を"],["受けて","うけて"],["いる"],["だけ"],["で"],["なく"],["、"],["わたしたち"],["の"],["父","ちち"],["アブラハム"],["が"],["割礼","かつれい"],["以前","いぜん"],["に"],["持って","もって"],["いた"],["信仰","しんこう"],["の"],["模範","もはん"],["に"],["従う","したがう"],["人々","ひとびと"],["の"],["父","ちち"],["と"],["も"],["なった"],["の"],["です"],["。"]]},{"verse":13,"text":"神はアブラハムやその子孫に世界を受け継がせることを約束されたが、その約束は、律法に基づいてではなく、信仰による義に基づいてなされたのです。","tok":[["神","かみ"],["は"],["アブラハム"],["や"],["その"],["子孫","しそん"],["に"],["世界","せかい"],["を"],["受け継がせる","うけつがせる"],["こと"],["を"],["約束","やくそく"],["された"],["が"],["、"],["その"],["約束","やくそく"],["は"],["、"],["律法","りっぽう"],["に"],["基づいて","もとづいて"],["で"],["は"],["なく"],["、"],["信仰","しんこう"],["に"],["よる"],["義","ぎ"],["に"],["基づいて","もとづいて"],["なされた"],["の"],["です"],["。"]]},{"verse":14,"text":"律法に頼る者が世界を受け継ぐのであれば、信仰はもはや無意味であり、約束は廃止されたことになります。","tok":[["律法","りっぽう"],["に"],["頼る","たよる"],["者","もの"],["が"],["世界","せかい"],["を"],["受け継ぐ","うけつぐ"],["ので"],["あれば"],["、"],["信仰","しんこう"],["は"],["もはや"],["無意味","むいみ"],["で"],["あり"],["、"],["約束","やくそく"],["は"],["廃止","はいし"],["された"],["こと"],["に"],["なります"],["。"]]},{"verse":15,"text":"実に、律法は怒りを招くものであり、律法のないところには違犯もありません。","tok":[["実","じつ"],["に"],["、"],["律法","りっぽう"],["は"],["怒り","いかり"],["を"],["招く","まねく"],["もの"],["で"],["あり"],["、"],["律法","りっぽう"],["の"],["ない"],["ところ"],["に"],["は"],["違犯","いはん"],["も"],["ありません"],["。"]]},{"verse":16,"text":"従って、信仰によってこそ世界を受け継ぐ者となるのです。恵みによって、アブラハムのすべての子孫、つまり、単に律法に頼る者だけでなく、彼の信仰に従う者も、確実に約束にあずかれるのです。彼はわたしたちすべての父です。","tok":[["従って","したがって"],["、"],["信仰","しんこう"],["によって"],["こそ"],["世界","せかい"],["を"],["受け継ぐ","うけつぐ"],["者","もの"],["と"],["なる"],["の"],["です"],["。"],["恵み","めぐみ"],["によって"],["、"],["アブラハム"],["の"],["すべて"],["の"],["子孫","しそん"],["、"],["つまり"],["、"],["単に","たんに"],["律法","りっぽう"],["に"],["頼る","たよる"],["者","もの"],["だけ"],["で"],["なく"],["、"],["彼","かれ"],["の"],["信仰","しんこう"],["に"],["従う","したがう"],["者","もの"],["も"],["、"],["確実","かくじつ"],["に"],["約束","やくそく"],["に"],["あずかれる"],["の"],["です"],["。"],["彼","かれ"],["は"],["わたしたち"],["すべて"],["の"],["父","ちち"],["です"],["。"]]},{"verse":17,"text":"「わたしはあなたを多くの民の父と定めた」と書いてあるとおりです。死者に命を与え、存在していないものを呼び出して存在させる神を、アブラハムは信じ、その御前でわたしたちの父となったのです。","tok":[["「"],["わたし"],["は"],["あなた"],["を"],["多く","おおく"],["の"],["民
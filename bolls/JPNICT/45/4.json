められた","みとめられた"],["わけ"],["です"],["。"]]},{"verse":23,"text":"しかし、「それが彼の義と認められた」という言葉は、アブラハムのためだけに記されているのでなく、","tok":[["しかし"],["、"],["「"],["それ"],["が"],["彼","かれ"],["の"],["義","ぎ"],["と"],["認められた","みとめられた"],["」"],["と"],["いう"],["言葉","ことば"],["は"],["、"],["アブラハム"],["の"],["ため"],["だけ"],["に"],["記されて","しるされて"],["いる"],["ので"],["なく"],["、"]]},{"verse":24,"text":"わたしたちのためにも記されているのです。わたしたちの主イエスを死者の中から復活させた方を信じれば、わたしたちも義と認められます。","tok":[["わたしたち"],["の"],["ため"],["に"],["も"],["記されて","しるされて"],["いる"],["の"],["です"],["。"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させた"],["方","ほう"],["を"],["信じれば","しんじれば"],["、"],["わたしたち"],["も"],["義","ぎ"],["と"],["認められます","みとめられます"],["。"]]},{"verse":25,"text":"イエスは、わたしたちの罪のために死に渡され、わたしたちが義とされるために復活させられたのです。","tok":[["イエス"],["は"],["、"],["わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["死","し"],["に"],["渡され","わたされ"],["、"],["わたしたち"],["が"],["義","ぎ"],["と"],["される"],["ため"],["に"],["復活","ふっかつ"],["させられた"],["の"],["です"],["。"]]}]
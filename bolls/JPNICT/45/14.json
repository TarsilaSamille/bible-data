[{"verse":1,"text":"信仰の弱い人を受け入れなさい。その考えを批判してはなりません。","tok":[["信仰","しんこう"],["の"],["弱い","よわい"],["人","ひと"],["を"],["受け入れ","うけいれ"],["なさい"],["。"],["その"],["考え","かんがえ"],["を"],["批判","ひはん"],["して"],["は"],["なりません"],["。"]]},{"verse":2,"text":"何を食べてもよいと信じている人もいますが、弱い人は野菜だけを食べているのです。","tok":[["何","なん"],["を"],["食べて","たべて"],["も"],["よい"],["と"],["信じて","しんじて"],["いる"],["人","ひと"],["も"],["います"],["が"],["、"],["弱い","よわい"],["人","ひと"],["は"],["野菜","やさい"],["だけ"],["を"],["食べて","たべて"],["いる"],["の"],["です"],["。"]]},{"verse":3,"text":"食べる人は、食べない人を軽蔑してはならないし、また、食べない人は、食べる人を裁いてはなりません。神はこのような人をも受け入れられたからです。","tok":[["食べる","たべる"],["人","ひと"],["は"],["、"],["食べない","たべない"],["人","ひと"],["を"],["軽蔑","けいべつ"],["して"],["は"],["ならない"],["し"],["、"],["また"],["、"],["食べない","たべない"],["人","ひと"],["は"],["、"],["食べる","たべる"],["人","ひと"],["を"],["裁いて","さばいて"],["は"],["なりません"],["。"],["神","かみ"],["は"],["この"],["よう"],["な"],["人","ひと"],["を"],["も"],["受け入れられた","うけいれられた"],["から"],["です"],["。"]]},{"verse":4,"text":"他人の召し使いを裁くとは、いったいあなたは何者ですか。召し使いが立つのも倒れるのも、その主人によるのです。しかし、召し使いは立ちます。主は、その人を立たせることがおできになるからです。","tok":[["他人","たにん"],["の"],["召し使い","めしつかい"],["を"],["裁く","さばく"],["と"],["は"],["、"],["いったい"],["あなた"],["は"],["何者","なにもの"],["です"],["か"],["。"],["召し使い","めしつかい"],["が"],["立つ","たつ"],["の"],["も"],["倒れる","たおれる"],["の"],["も"],["、"],["その"],["主人","しゅじん"],["に"],["よる"],["の"],["です"],["。"],["しかし"],["、"],["召し使い","めしつかい"],["は"],["立ちます","たちます"],["。"],["主","ぬし"],["は"],["、"],["その"],["人","ひと"],["を"],["立たせる","たたせる"],["こと"],["が"],["おでき"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":5,"text":"ある日を他の日よりも尊ぶ人もいれば、すべての日を同じように考える人もいます。それは、各自が自分の心の確信に基づいて決めるべきことです。","tok":[["ある"],["日","ひ"],["を"],["他","ほか"],["の"],["日","ひ"],["より"],["も"],["尊ぶ","とうとぶ"],["人","ひと"],["も"],["いれば"],["、"],["すべて"],["の"],["日","ひ"],["を"],["同じ","おなじ"],["よう"],["に"],["考える","かんがえる"],["人","ひと"],["も"],["います"],["。"],["それ"],["は"],["、"],["各自","かくじ"],["が"],["自分","じぶん"],["の"],["心","こころ"],["の"],["確信","かくしん"],["に"],["基づいて","もとづいて"],["決めるべき","きめるべき"],["こと"],["です"],["。"]]},{"verse":6,"text":"特定の日を重んじる人は主のために重んじる。食べる人は主のために食べる。神に感謝しているからです。また、食べない人も、主のために食べない。そして、神に感謝しているのです。","tok":[["特定","とくてい"],["の"],["日","ひ"],["を"],["重んじる","おもんじる"],["人","ひと"],["は"],["主","ぬし"],["の"],["ため"],["に"],["重んじる","おもんじる"],["。"],["食べる","たべる"],["人","ひと"],["は"],["主","ぬし"],["の"],["ため"],["に"],["食べる","たべる"],["。"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["いる"],["から"],["です"],["。"],["また"],["、"],["食べない","たべない"],["人","ひと"],["も"],["、"],["主","ぬし"],["の"],["ため"],["に"],["食べない","たべない"],["。"],["そして"],["、"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":7,"text":"わたしたちの中には、だれ一人自分のために生きる人はなく、だれ一人自分のために死ぬ人もいません。","tok":[["わたしたち"],["の"],["中","なか"],["に"],["は"],["、"],["だれ"],["一人","ひとり"],["自分","じぶん"],["の"],["ため"],["に"],["生きる","いきる"],["人","ひと"],["は"],["なく"],["、"],["だれ"],["一人","ひとり"],["自分","じぶん"],["の"],["ため"],["に"],["死ぬ","しぬ"],["人","ひと"],["も"],["いません"],["。"]]},{"verse":8,"text":"わたしたちは、生きるとすれば主のために生き、死ぬとすれば主のために死ぬのです。従って、生きるにしても、死ぬにしても、わたしたちは主のものです。","tok":[["わたしたち"],["は"],["、"],["生きる","いきる"],["と"],["すれば"],["主","ぬし"],["の"],["ため"],["に"],["生き","いき"],["、"],["死ぬ","しぬ"],["と"],["すれば"],["主","ぬし"],["の"],["ため"],["に"],["死ぬ","しぬ"],["の"],["です"],["。"],["従って","したがって"],["、"],["生きる","いきる"],["に"],["して"],["も"],["、"],["死ぬ","しぬ"],["に"],["して"],["も"],["、"],["わたしたち"],["は"],["主","ぬし"],["の"],["もの"],["です"],["。"]]},{"verse":9,"text":"キリストが死に、そして生きたのは、死んだ人にも生きている人にも主となられるためです。","tok":[["キリスト"],["が"],["死に","しに"],["、"],["そして"],["生きた","いきた"],["の"],["は"],["、"],["死んだ","しんだ"],["人","ひと"],["に"],["も"],["生きて","いきて"],["いる"],["人","ひと"],["に"],["も"],["主","ぬし"],["と"],["なられる"],["ため"],["です"],["。"]]},{"verse":10,"text":"それなのに、なぜあなたは、自分の兄弟を裁くのですか。また、なぜ兄弟を侮るのですか。わたしたちは皆、神の裁きの座の前に立つのです。","tok":[["それ"],["な"],["のに"],["、"],["なぜ"],["あなた"],["は"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["裁く","さばく"],["の"],["です"],["か"],["。"],["また"],["、"],["なぜ"],["兄弟","きょうだい"],["を"],["侮る","あなどる"],["の"],["です"],["か"],["。"],["わたしたち"],["は"],["皆","みな"],["、"],["神","かみ"],["の"],["裁き","さばき"],["の"],["座","ざ"],["の"],["前","まえ"],["に"],["立つ","たつ"],["の"],["です"],["。"]]},{"verse":11,"text":"こう書いてあります。「主は言われる。『わたしは生きている。すべてのひざはわたしの前にかがみ、すべての舌が神をほめたたえる』と。」","tok":[["こう"],["書いて","かいて"],["あります"],["。"],["「"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["『"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["すべて"],["の"],["ひざ"],["は"],["わたし"],["の"],["前","まえ"],["に"],["かがみ"],["、"],["すべて"],["の"],["舌","した"],["が"],["神","かみ"],["を"],["ほめたたえる"],["』"],["と"],["。"],["」"]]},{"verse":12,"text":"それで、わたしたちは一人一人、自分のことについて神に申し述べることになるのです。","tok":[["それ"],["で"],["、"],["わたしたち"],["は"],["一人一人","ひとりひとり"],["、"],["自分","じぶん"],["の"],["こと"],["について"],["神","かみ"],["に"],["申し述べる","もうしのべる"],["こと"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":13,"text":"従って、もう互いに裁き合わないようにしよう。むしろ、つまずきとなるものや、妨げとなるものを、兄弟の前に置かないように決心しなさい。","tok":[["従って","したがって"],["、"],["もう"],["互い","たがい"],["に"],["裁き","さばき"],["合わない","あわない"],["よう"],["に"],["しよう"],["。"],["むしろ"],["、"],["つまずき"],["と"],["なる"],["もの"],["や"],["、"],["妨げ","さまたげ"],["と"],["なる"],["もの"],["を"],["、"],["兄弟","きょうだい"],["の"],["前","まえ"],["に"],["置かない","おかない"],["よう"],["に"],["決心","けっしん"],["し"],["なさい"],["。"]]},{"verse":14,"text":"それ自体で汚れたものは何もないと、わたしは主イエスによって知り、そして確信しています。汚れたものだと思うならば、それは、その人にだけ汚れたものです。","tok":[["それ"],["自体","じたい"],["で"],["汚れた","よごれた"],["もの"],["は"],["何","なん"],["も"],["ない"],["と"],["、"],["わたし"],["は"],["主","しゅ"],["イエス"],["によって"],["知り","しり"],["、"],["そして"],["確信","かくしん"],["して"],["います"],["。"],["汚れた","よごれた"],["もの"],["だ"],["と"],["思うならば","おもうならば"],["、"],["それ"],["は"],["、"],["その"],["人","ひと"],["に"],["だけ"],["汚れた","よごれた"],["もの"],["です"],["。"]]},{"verse":15,"text":"あなたの食べ物について兄弟が心を痛めるならば、あなたはもはや愛に従って歩んでいません。食べ物のことで兄弟を滅ぼしてはなりません。キリストはその兄弟のために死んでくださったのです。","tok":[["あなた"],["の"],["食べ物","たべもの"],["について"],["兄弟","きょうだい"],["が"],["心","こころ"],["を"],["痛めるならば","いためるならば"],["、"],["あなた"],["は"],["もはや"],["愛","あい"],["に"],["従って","したがって"],["歩んで","あゆんで"],["いません"],["。"],["食べ物","たべもの"],["の"],["こと"],["で"],["兄弟","きょうだい"],["を"],["滅ぼして","ほろぼして"],["は"],["なりません"],["。"],["キリスト"],["は"],["その"],["兄弟","きょうだい"],["の"],["ため"],["に"],["死んで","しんで"],["くださった"],["の"],["です"],["。"]]},{"verse":16,"text":"ですから、あなたがたにとって善いことがそしりの種にならないようにしなさい。","tok":[["です"],["から"],["、"],["あなた"],["がた"],["にとって"],["善い","よい"],["こと"],["が"],["そしり"],["の"],["種","しゅ"],["に"],["ならない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":17,"text":"神の国は、飲み食いではなく、聖霊によって与えられる義と平和と喜びなのです。","tok":[["神","かみ"],["の"],["国","くに"],["は"],["、"],["飲み食い","のみくい"],["で"],["は"],["なく"],["、"],["聖霊","せいれい"],["によって"],["与えられる","あたえられる"],["義","ぎ"],["と"],["平和","へいわ"],["と"],["喜び","よろこび"],["な"],["の"],["です"],["。"]]},{"verse":18,"text":"このようにしてキリストに仕える人は、神に喜ばれ、人々に信頼されます。","tok":[["この"],["よう"],["に"],["して"],["キリスト"],["に"],["仕える","つかえる"],["人","ひと"],["は"],["、"],["神","かみ"],["に"],["喜ばれ","よろこばれ"],["、"],["人々","ひとびと"],["に"],["信頼","しんらい"],["されます"],["。"]]},{"verse":19,"text":"だから、平和や互いの向上に役立つことを追い求めようではありませんか。","tok":[["だ"],["から"],["、"],["平和","へいわ"],["や"],["互い","たがい"],["の"],["向上","こうじょう"],["に"],["役立つ","やくだつ"],["こと"],["を"],["追い求めようで","おいもとめようで"],["は"],["ありません"],["か"],["。"]]},{"verse":20,"text":"食べ物のために神の働きを無にしてはなりません。すべては清いのですが、食べて人を罪に誘う者には悪い物となります。","tok":[["食べ物","たべもの"],["の"],["ため"],["に"],["神","かみ"],["の"],["働き","はたらき"],["を"],["無","む"],["に"],["して"],["は"],["なりません"],["。"],["すべて"],["は"],["清い","きよい"],["の"],["です"],["が"],["、"],["食べて","たべて"],["人","ひと"],["を"],["罪","つみ"],["に"],["誘う","さそう"],["者","もの"],["に"],["は"],["悪い","わるい"],["物","もの"],["と"],["なります"],["。"]]},{"verse":21,"text":"肉も食べなければぶどう酒も飲まず、そのほか兄弟を罪に誘うようなことをしないのが望ましい。","tok":[["肉","にく"],["も"],["食べなければ","たべなければ"],["ぶどう酒","ぶどうしゅ"],["も"],["飲まず","のまず"],["、"],["その"],["ほか"],["兄弟","きょうだい"],["を"],["罪","つみ"],["に"],["誘う","さそう"],["よう"],["な"],["こと"],["を"],["しない"],["の"],["が"],["望ましい","のぞましい"],["。"]]},{"verse":22,"text":"あなたは自分が抱いている確信を、神の御前で心の内に持っていなさい。自分の決心にやましさを感じない人は幸いです。","tok":[["あなた"],["は"],["自分","じぶん"],["が"],["抱いて","いだいて"],["いる"],["確信","かくしん"],["を"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["心","こころ"],["の"],["内","うち"],["に"],["持って","もって"],["い"],["なさい"],["。"],["自分","じぶん"],["の"],["決心","けっしん"],["に"],["やまし"],["さ"],["を"],["感じない","かんじない"],["人","ひと"],["は"],["幸い","さいわい"],["です"],["。"]]},{"verse":23,"text":"疑いながら食べる人は、確信に基づいて行動していないので、罪に定められます。確信に基づいていないことは、す
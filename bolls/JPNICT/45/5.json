[{"verse":1,"text":"このように、わたしたちは信仰によって義とされたのだから、わたしたちの主イエス‧キリストによって神との間に平和を得ており、","tok":[["この"],["よう"],["に"],["、"],["わたしたち"],["は"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["された"],["の"],["だ"],["から"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["によって"],["神","かみ"],["と"],["の"],["間","あいだ"],["に"],["平和","へいわ"],["を"],["得て","えて"],["おり"],["、"]]},{"verse":2,"text":"このキリストのお陰で、今の恵みに信仰によって導き入れられ、神の栄光にあずかる希望を誇りにしています。","tok":[["この"],["キリスト"],["の"],["お陰","おかげ"],["で"],["、"],["今","いま"],["の"],["恵み","めぐみ"],["に"],["信仰","しんこう"],["によって"],["導き入れられ","みちびきいれられ"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["に"],["あずかる"],["希望","きぼう"],["を"],["誇り","ほこり"],["に"],["して"],["います"],["。"]]},{"verse":3,"text":"そればかりでなく、苦難をも誇りとします。わたしたちは知っているのです、苦難は忍耐を、","tok":[["それ"],["ばかり"],["で"],["なく"],["、"],["苦難","くなん"],["を"],["も"],["誇り","ほこり"],["と"],["します"],["。"],["わたしたち"],["は"],["知って","しって"],["いる"],["の"],["です"],["、"],["苦難","くなん"],["は"],["忍耐","にんたい"],["を"],["、"]]},{"verse":4,"text":"忍耐は練達を、練達は希望を生むということを。","tok":[["忍耐","にんたい"],["は"],["練達","れんたつ"],["を"],["、"],["練達","れんたつ"],["は"],["希望","きぼう"],["を"],["生む","うむ"],["と"],["いう"],["こと"],["を"],["。"]]},{"verse":5,"text":"希望はわたしたちを欺くことがありません。わたしたちに与えられた聖霊によって、神の愛がわたしたちの心に注がれているからです。","tok":[["希望","きぼう"],["は"],["わたしたち"],["を"],["欺く","あざむく"],["こと"],["が"],["ありません"],["。"],["わたしたち"],["に"],["与えられた","あたえられた"],["聖霊","せいれい"],["によって"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["わたしたち"],["の"],["心","こころ"],["に"],["注がれて","そそがれて"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"実にキリストは、わたしたちがまだ弱かったころ、定められた時に、不信心な者のために死んでくださった。","tok":[["実","じつ"],["に"],["キリスト"],["は"],["、"],["わたしたち"],["が"],["まだ"],["弱かった","よわかった"],["ころ"],["、"],["定められた","さだめられた"],["時","とき"],["に"],["、"],["不信心","ふしんじん"],["な"],["者","もの"],["の"],["ため"],["に"],["死んで","しんで"],["くださった"],["。"]]},{"verse":7,"text":"正しい人のために死ぬ者はほとんどいません。善い人のために命を惜しまない者ならいるかもしれません。","tok":[["正しい","ただしい"],["人","ひと"],["の"],["ため"],["に"],["死ぬ","しぬ"],["者","もの"],["は"],["ほとんど"],["いません"],["。"],["善い","よい"],["人","ひと"],["の"],["ため"],["に"],["命","いのち"],["を"],["惜しまない","おしまない"],["者","もの"],["なら"],["いる"],["か"],["も"],["しれません"],["。"]]},{"verse":8,"text":"しかし、わたしたちがまだ罪人であったとき、キリストがわたしたちのために死んでくださったことにより、神はわたしたちに対する愛を示されました。","tok":[["しかし"],["、"],["わたしたち"],["が"],["まだ"],["罪人","ざいにん"],["で"],["あった"],["とき"],["、"],["キリスト"],["が"],["わたしたち"],["の"],["ため"],["に"],["死んで","しんで"],["くださった"],["こと"],["に"],["より"],["、"],["神","かみ"],["は"],["わたしたち"],["に"],["対する","たいする"],["愛","あい"],["を"],["示されました","しめされました"],["。"]]},{"verse":9,"text":"それで今や、わたしたちはキリストの血によって義とされたのですから、キリストによって神の怒りから救われるのは、なおさらのことです。","tok":[["それ"],["で"],["今","いま"],["や"],["、"],["わたしたち"],["は"],["キリスト"],["の"],["血","ち"],["によって"],["義","ぎ"],["と"],["された"],["の"],["です"],["から"],["、"],["キリスト"],["によって"],["神","かみ"],["の"],["怒り","いかり"],["から"],["救われる","すくわれる"],["の"],["は"],["、"],["なおさら"],["の"],["こと"],["です"],["。"]]},{"verse":10,"text":"敵であったときでさえ、御子の死によって神と和解させていただいたのであれば、和解させていただいた今は、御子の命によって救われるのはなおさらです。","tok":[["敵","てき"],["で"],["あった"],["とき"],["で"],["さえ"],["、"],["御子","みこ"],["の"],["死","し"],["によって"],["神","かみ"],["と"],["和解","わかい"],["させて"],["いただいた"],["ので"],["あれば"],["、"],["和解","わかい"],["させて"],["いただいた"],["今","いま"],["は"],["、"],["御子","みこ"],["の"],["命","いのち"],["によって"],["救われる","すくわれる"],["の"],["は"],["なおさら"],["です"],["。"]]},{"verse":11,"text":"それだけでなく、わたしたちの主イエス‧キリストによって、わたしたちは神を誇りとしています。今やこのキリストを通して和解させていただいたからです。","tok":[["それ"],["だけ"],["で"],["なく"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["によって"],["、"],["わたしたち"],["は"],["神","かみ"],["を"],["誇り","ほこり"],["として"],["います"],["。"],["今","いま"],["や"],["この"],["キリスト"],["を"],["通して","とおして"],["和解","わかい"],["させて"],["いただいた"],["から"],["です"],["。"]]},{"verse":12,"text":"このようなわけで、一人の人によって罪が世に入り、罪によって死が入り込んだように、死はすべての人に及んだのです。すべての人が罪を犯したからです。","tok":[["この"],["よう"],["な"],["わけ"],["で"],["、"],["一人","ひとり"],["の"],["人","ひと"],["によって"],["罪","つみ"],["が"],["世","よ"],["に"],["入り","はいり"],["、"],["罪","つみ"],["によって"],["死","し"],["が"],["入り込んだ","はいりこんだ"],["よう"],["に"],["、"],["死","し"],["は"],["すべて"],["の"],["人","ひと"],["に"],["及んだ","およんだ"],["の"],["です"],["。"],["すべて"],["の"],["人","ひと"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["です"],["。"]]},{"verse":13,"text":"律法が与えられる前にも罪は世にあったが、律法がなければ、罪は罪と認められないわけです。","tok":[["律法","りっぽう"],["が"],["与えられる","あたえられる"],["前","まえ"],["に"],["も"],["罪","つみ"],["は"],["世","よ"],["に"],["あった"],["が"],["、"],["律法","りっぽう"],["が"],["なければ"],["、"],["罪","つみ"],["は"],["罪","つみ"],["と"],["認められない","みとめられない"],["わけ"],["です"],["。"]]},{"verse":14,"text":"しかし、アダムからモーセまでの間にも、アダムの違犯と同じような罪を犯さなかった人の上にさえ、死は支配しました。実にアダムは、来るべき方を前もって表す者だったのです。","tok":[["しかし"],["、"],["アダム"],["から"],["モーセ"],["まで"],["の"],["間","あいだ"],["に"],["も"],["、"],["アダム"],["の"],["違犯","いはん"],["と"],["同じ","おなじ"],["よう"],["な"],["罪","つみ"],["を"],["犯さなかった","おかさなかった"],["人","ひと"],["の"],["上","うえ"],["に"],["さえ"],["、"],["死","し"],["は"],["支配","しはい"],["しました"],["。"],["実","じつ"],["に"],["アダム"],["は"],["、"],["来るべき","きたるべき"],["方","ほう"],["を"],["前もって","まえもって"],["表す","あらわす"],["者","もの"],["だった"],["の"],["です"],["。"]]},{"verse":15,"text":"しかし、恵みの賜物は罪とは比較になりません。一人の罪によって多くの人が死ぬことになったとすれば、なおさら、神の恵みと一人の人イエス‧キリストの恵みの賜物とは、多くの人に豊かに注がれるのです。","tok":[["しかし"],["、"],["恵み","めぐみ"],["の"],["賜物","たまもの"],["は"],["罪","つみ"],["と"],["は"],["比較","ひかく"],["に"],["なりません"],["。"],["一人","ひとり"],["の"],["罪","つみ"],["によって"],["多く","おおく"],["の"],["人","ひと"],["が"],["死ぬ","しぬ"],["こと"],["に"],["なった"],["と"],["すれば"],["、"],["なおさら"],["、"],["神","かみ"],["の"],["恵み","めぐみ"],["と"],["一人","ひとり"],["の"],["人","ひと"],["イエス"],["‧"],["キリスト"],["の"],["恵み","めぐみ"],["の"],["賜物","たまもの"],["と"],["は"],["、"],["多く","おおく"],["の"],["人","ひと"],["に"],["豊か","ゆたか"],["に"],["注がれる","そそがれる"],["の"],["です"],["。"]]},{"verse":16,"text":"この賜物は、罪を犯した一人によってもたらされたようなものではありません。裁きの場合は、一つの罪でも有罪の判決が下されますが、恵みが働くときには、いかに多くの罪があっても、無罪の判決が下されるからです。","tok":[["この"],["賜物","たまもの"],["は"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["一人","ひとり"],["によって"],["もたらされた"],["よう"],["な"],["もの"],["で"],["は"],["ありません"],["。"],["裁き","さばき"],["の"],["場合","ばあい"],["は"],["、"],["一","ひと"],["つ"],["の"],["罪","つみ"],["で"],["も"],["有罪","ゆうざい"],["の"],["判決","はんけつ"],["が"],["下されます","くだされます"],["が"],["、"],["恵み","めぐみ"],["が"],["働く","はたらく"],["とき"],["に"],["は"],["、"],["いかに"],["多く","おおく"],["の"],["罪","つみ"],["が"],["あって"],["も"],["、"],["無罪","むざい"],["の"],["判決","はんけつ"],["が"],["下される","くだされる"],["から"],["です"],["。"]]},{"verse":17,"text":"一人の罪によって、その一人を通して死が支配するようになったとすれば、なおさら、神の恵みと義の賜物とを豊かに受けている人は、一人のイエス‧キリストを通して生き、支配するようになるのです。","tok":[["一人","ひとり"],["の"],["罪","つみ"],["によって"],["、"],["その"],["一人","ひとり"],["を"],["通して","とおして"],["死","し"],["が"],["支配","しはい"],["する"],["よう"],["に"],["なった"],["と"],["すれば"],["、"],["なおさら"],["、"],["神","かみ"],["の"],["恵み","めぐみ"],["と"],["義","ぎ"],["の"],["賜物","たまもの"],["と"],["を"],["豊か","ゆたか"],["に"],["受けて","うけて"],["いる"],["人","ひと"],["は"],["、"],["一人","ひとり"],["の"],["イエス"],["‧"],["キリスト"],["を"],["通して","とおして"],["生き","いき"],["、"],["支配","しはい"],["する"],["よう"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":18,"text":"そこで、一人の罪によってすべての人に有罪の判決が下されたように、一人の正しい行為によって、すべての人が義とされて命を得ることになったのです。","tok":[["そこ"],["で"],["、"],["一人","ひとり"],["の"],["罪","つみ"],["によって"],["すべて"],["の"],["人","ひと"],["に"],["有罪","ゆうざい"],["の"],["判決","はんけつ"],["が"],["下された","くだされた"],["よう"],["に"],["、"],["一人","ひとり"],["の"],["正しい","ただしい"],["行為","こうい"],["によって"],["、"],["すべて"],["の"],["人","ひと"],["が"],["義","ぎ"],["と"],["されて"],["命","いのち"],["を"],["得る","える"],["こと"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":19,"text":"一人の人の不従順によって多くの人が罪人とされたように、一人の従順によって多くの人が正しい者とされるのです。","tok":[["一人","ひとり"],["の"],["人","ひと"],["の"],["不","ふ"],["従順","じゅうじゅん"],["によって"],["多く","おおく"],["の"],["人","ひと"],["が"],["罪人","ざいにん"],["と"],["された"],["よう"],["に"],["、"],["一人","ひとり"],["の"],["従順","じゅうじゅん"],["によって"],["多く","おおく"],["の"],["人","ひと"],["が"],["正しい","ただしい"],["者","もの"],["と"],["される"],["の"],["です"],["。"]]},{"verse":20,"text":"律法が入り込んで来たのは、罪が増し加わるためでありました。しかし、罪が増したところには、恵みはなおいっそう満ちあふれました。","tok":[["律法","りっぽう"],["が"],["入り込んで","はいりこんで"],["来た","きた"],["の"],["は"],["、"],["罪","つみ"],["が"],["増し","まし"],["加わる","くわわる"],["ため"],["で"],["ありました"],["。"],["しかし"],["、"],["罪","つみ"],["が"],["増した","ました"],["ところ"],["に"],["は"],["、"],["恵み","めぐみ"],["は"],["なお"],["いっそう"],["満ちあふれました","みちあふれました"],["。"]]},{"verse":21,"text":"こうして、罪が死によって支配していたように、恵みも義によって支配しつつ、わたしたちの主イエス‧キリストを通して永遠の命に導くのです。","tok":[["こう"],["して"],["、"],["罪"
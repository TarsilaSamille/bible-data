[{"verse":1,"text":"それとも、兄弟たち、わたしは律法を知っている人々に話しているのですが、律法とは、人を生きている間だけ支配するものであることを知らないのですか。","tok":[["それ"],["と"],["も"],["、"],["兄弟","きょうだい"],["たち"],["、"],["わたし"],["は"],["律法","りっぽう"],["を"],["知って","しって"],["いる"],["人々","ひとびと"],["に"],["話して","はなして"],["いる"],["の"],["です"],["が"],["、"],["律法","りっぽう"],["と"],["は"],["、"],["人","ひと"],["を"],["生きて","いきて"],["いる"],["間","あいだ"],["だけ"],["支配","しはい"],["する"],["もの"],["で"],["ある"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"結婚した女は、夫の生存中は律法によって夫に結ばれているが、夫が死ねば、自分を夫に結び付けていた律法から解放されるのです。","tok":[["結婚","けっこん"],["した"],["女","おんな"],["は"],["、"],["夫","おっと"],["の"],["生存中","せいぞんちゅう"],["は"],["律法","りっぽう"],["によって"],["夫","おっと"],["に"],["結ばれて","むすばれて"],["いる"],["が"],["、"],["夫","おっと"],["が"],["死ねば","しねば"],["、"],["自分","じぶん"],["を"],["夫","おっと"],["に"],["結び付けて","むすびつけて"],["いた"],["律法","りっぽう"],["から"],["解放","かいほう"],["される"],["の"],["です"],["。"]]},{"verse":3,"text":"従って、夫の生存中、他の男と一緒になれば、姦通の女と言われますが、夫が死ねば、この律法から自由なので、他の男と一緒になっても姦通の女とはなりません。","tok":[["従って","したがって"],["、"],["夫","おっと"],["の"],["生存中","せいぞんちゅう"],["、"],["他","た"],["の"],["男","おとこ"],["と"],["一緒","いっしょ"],["に"],["なれば"],["、"],["姦通","かんつう"],["の"],["女","おんな"],["と"],["言われます","いわれます"],["が"],["、"],["夫","おっと"],["が"],["死ねば","しねば"],["、"],["この"],["律法","りっぽう"],["から"],["自由","じゆう"],["な"],["ので"],["、"],["他","た"],["の"],["男","おとこ"],["と"],["一緒","いっしょ"],["に"],["なって"],["も"],["姦通","かんつう"],["の"],["女","おんな"],["と"],["は"],["なりません"],["。"]]},{"verse":4,"text":"ところで、兄弟たち、あなたがたも、キリストの体に結ばれて、律法に対しては死んだ者となっています。それは、あなたがたが、他の方、つまり、死者の中から復活させられた方のものとなり、こうして、わたしたちが神に対して実を結ぶようになるためなのです。","tok":[["ところ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["も"],["、"],["キリスト"],["の"],["体","からだ"],["に"],["結ばれて","むすばれて"],["、"],["律法","りっぽう"],["に対して","にたいして"],["は"],["死んだ","しんだ"],["者","もの"],["と"],["なって"],["います"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["他","た"],["の"],["方","ほう"],["、"],["つまり"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させられた"],["方","ほう"],["の"],["もの"],["と"],["なり"],["、"],["こう"],["して"],["、"],["わたしたち"],["が"],["神","かみ"],["に対して","にたいして"],["実","じつ"],["を"],["結ぶ","むすぶ"],["よう"],["に"],["なる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":5,"text":"わたしたちが肉に従って生きている間は、罪へ誘う欲情が律法によって五体の中に働き、死に至る実を結んでいました。","tok":[["わたしたち"],["が"],["肉","にく"],["に"],["従って","したがって"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["罪","つみ"],["へ"],["誘う","さそう"],["欲情","よくじょう"],["が"],["律法","りっぽう"],["によって"],["五体","ごたい"],["の"],["中","なか"],["に"],["働き","はたらき"],["、"],["死","し"],["に"],["至る","いたる"],["実","じつ"],["を"],["結んで","むすんで"],["いました"],["。"]]},{"verse":6,"text":"しかし今は、わたしたちは、自分を縛っていた律法に対して死んだ者となり、律法から解放されています。その結果、文字に従う古い生き方ではなく、“霊”に従う新しい生き方で仕えるようになっているのです。","tok":[["しかし"],["今","いま"],["は"],["、"],["わたしたち"],["は"],["、"],["自分","じぶん"],["を"],["縛って","しばって"],["いた"],["律法","りっぽう"],["に対して","にたいして"],["死んだ","しんだ"],["者","もの"],["と"],["なり"],["、"],["律法","りっぽう"],["から"],["解放","かいほう"],["されて"],["います"],["。"],["その"],["結果","けっか"],["、"],["文字","もじ"],["に"],["従う","したがう"],["古い","ふるい"],["生き方","いきかた"],["で"],["は"],["なく"],["、"],["“"],["霊","れい"],["”"],["に"],["従う","したがう"],["新しい","あたらしい"],["生き方","いきかた"],["で"],["仕える","つかえる"],["よう"],["に"],["なって"],["いる"],["の"],["です"],["。"]]},{"verse":7,"text":"では、どういうことになるのか。律法は罪であろうか。決してそうではない。しかし、律法によらなければ、わたしは罪を知らなかったでしょう。たとえば、律法が「むさぼるな」と言わなかったら、わたしはむさぼりを知らなかったでしょう。","tok":[["で"],["は"],["、"],["どういう"],["こと"],["に"],["なる"],["の"],["か"],["。"],["律法","りっぽう"],["は"],["罪","つみ"],["で"],["あろう"],["か"],["。"],["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"],["しかし"],["、"],["律法","りっぽう"],["に"],["よらなければ"],["、"],["わたし"],["は"],["罪","つみ"],["を"],["知らなかったでしょう","しらなかったでしょう"],["。"],["たとえば"],["、"],["律法","りっぽう"],["が"],["「"],["むさぼる"],["な"],["」"],["と"],["言わなかったら","いわなかったら"],["、"],["わたし"],["は"],["むさぼり"],["を"],["知らなかったでしょう","しらなかったでしょう"],["。"]]},{"verse":8,"text":"ところが、罪は掟によって機会を得、あらゆる種類のむさぼりをわたしの内に起こしました。律法がなければ罪は死んでいるのです。","tok":[["ところ"],["が"],["、"],["罪","つみ"],["は"],["掟","おきて"],["によって"],["機会","きかい"],["を"],["得","え"],["、"],["あらゆる"],["種類","しゅるい"],["の"],["むさぼり"],["を"],["わたし"],["の"],["内","うち"],["に"],["起こしました","おこしました"],["。"],["律法","りっぽう"],["が"],["なければ"],["罪","つみ"],["は"],["死んで","しんで"],["いる"],["の"],["です"],["。"]]},{"verse":9,"text":"わたしは、かつては律法とかかわりなく生きていました。しかし、掟が登場したとき、罪が生き返って、","tok":[["わたし"],["は"],["、"],["かつて"],["は"],["律法","りっぽう"],["と"],["か"],["かわり"],["なく"],["生きて","いきて"],["いました"],["。"],["しかし"],["、"],["掟","おきて"],["が"],["登場","とうじょう"],["した"],["とき"],["、"],["罪","つみ"],["が"],["生き返って","いきかえって"],["、"]]},{"verse":10,"text":"わたしは死にました。そして、命をもたらすはずの掟が、死に導くものであることが分かりました。","tok":[["わたし"],["は"],["死にました","しにました"],["。"],["そして"],["、"],["命","いのち"],["を"],["もたらす"],["はず"],["の"],["掟","おきて"],["が"],["、"],["死","し"],["に"],["導く","みちびく"],["もの"],["で"],["ある"],["こと"],["が"],["分かりました","わかりました"],["。"]]},{"verse":11,"text":"罪は掟によって機会を得、わたしを欺き、そして、掟によってわたしを殺してしまったのです。","tok":[["罪","つみ"],["は"],["掟","おきて"],["によって"],["機会","きかい"],["を"],["得","え"],["、"],["わたし"],["を"],["欺き","あざむき"],["、"],["そして"],["、"],["掟","おきて"],["によって"],["わたし"],["を"],["殺して","ころして"],["しまった"],["の"],["です"],["。"]]},{"verse":12,"text":"こういうわけで、律法は聖なるものであり、掟も聖であり、正しく、そして善いものなのです。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["律法","りっぽう"],["は"],["聖","せい"],["なる"],["もの"],["で"],["あり"],["、"],["掟","おきて"],["も"],["聖","せい"],["で"],["あり"],["、"],["正しく","ただしく"],["、"],["そして"],["善い","よい"],["もの"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"それでは、善いものがわたしにとって死をもたらすものとなったのだろうか。決してそうではない。実は、罪がその正体を現すために、善いものを通してわたしに死をもたらしたのです。このようにして、罪は限りなく邪悪なものであることが、掟を通して示されたのでした。","tok":[["それ"],["で"],["は"],["、"],["善い","よい"],["もの"],["が"],["わたし"],["にとって"],["死","し"],["を"],["もたらす"],["もの"],["と"],["なった"],["の"],["だろう"],["か"],["。"],["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"],["実","じつ"],["は"],["、"],["罪","つみ"],["が"],["その"],["正体","しょうたい"],["を"],["現す","あらわす"],["ため"],["に"],["、"],["善い","よい"],["もの"],["を"],["通して","とおして"],["わたし"],["に"],["死","し"],["を"],["もたらした"],["の"],["です"],["。"],["この"],["よう"],["に"],["して"],["、"],["罪","つみ"],["は"],["限りなく","かぎりなく"],["邪悪","じゃあく"],["な"],["もの"],["で"],["ある"],["こと"],["が"],["、"],["掟","おきて"],["を"],["通して","とおして"],["示された","しめされた"],["の"],["でした"],["。"]]},{"verse":14,"text":"わたしたちは、律法が霊的なものであると知っています。しかし、わたしは肉の人であり、罪に売り渡されています。","tok":[["わたしたち"],["は"],["、"],["律法","りっぽう"],["が"],["霊的","れいてき"],["な"],["もの"],["で"],["ある"],["と"],["知って","しって"],["います"],["。"],["しかし"],["、"],["わたし"],["は"],["肉","にく"],["の"],["人","ひと"],["で"],["あり"],["、"],["罪","つみ"],["に"],["売り渡されて","うりわたされて"],["います"],["。"]]},{"verse":15,"text":"わたしは、自分のしていることが分かりません。自分が望むことは実行せず、かえって憎んでいることをするからです。","tok":[["わたし"],["は"],["、"],["自分","じぶん"],["の"],["して"],["いる"],["こと"],["が"],["分かりません","わかりません"],["。"],["自分","じぶん"],["が"],["望む","のぞむ"],["こと"],["は"],["実行","じっこう"],["せず"],["、"],["かえって"],["憎んで","にくんで"],["いる"],["こと"],["を"],["する"],["から"],["です"],["。"]]},{"verse":16,"text":"もし、望まないことを行っているとすれば、律法を善いものとして認めているわけになります。","tok":[["もし"],["、"],["望まない","のぞまない"],["こと"],["を"],["行って","おこなって"],["いる"],["と"],["すれば"],["、"],["律法","りっぽう"],["を"],["善い","よい"],["もの"],["として"],["認めて","みとめて"],["いる"],["わけ"],["に"],["なります"],["。"]]},{"verse":17,"text":"そして、そういうことを行っているのは、もはやわたしではなく、わたしの中に住んでいる罪なのです。","tok":[["そして"],["、"],["そう"],["いう"],["こと"],["を"],["行って","おこなって"],["いる"],["の"],["は"],["、"],["もはや"],["わたし"],["で"],["は"],["なく"],["、"],["わたし"],["の"],["中","なか"],["に"],["住んで","すんで"],["いる"],["罪","つみ"],["な"],["の"],["です"],["。"]]},{"verse":18,"text":"わたしは、自分の内には、つまりわたしの肉には、善が住んでいないことを知っています。善をなそうという意志はありますが、それを実行できないからです。","tok":[["わたし"],["は"],["、"],["自分","じぶん"],["の"],["内","うち"],["に"],["は"],["、"],["つまり"],["わたし"],["の"],["肉","にく"],["に"],["は"],["、"],["善","ぜん"],["が"],["住んで","すんで"],["いない"],["こと"],["を"],["知って","しって"],["います"],["。"],["善","ぜん"],["を"],["なそう"],["と"],["いう"],["意志","いし"],["は"],["あります"],["が"],["、"],["それ"],["を"],["実行","じっこう"],["できない"],["から"],["です"],["。"]]},{"verse":19,"text":"わたしは自分の望む善は行わず、望まない悪を行っている。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["望む","のぞむ"],["善","ぜん"],["は"],["行わず","おこなわず"],["、"],["望まない","のぞまない"],["悪","あく"],["を"],["行って","おこなって"],["いる"],["。"]]},{"verse":20,"text":"もし、わたしが望まないことをしているとすれば、それをしているのは、もはやわたしではなく、わたしの中に住んでいる罪なのです。","tok":[["もし"],["、"],["わたし"],["が"],["望まない","のぞまない"],["こと"],["を"],["して"],["いる"],["と"],["すれば"],["、"],["それ"],["を"],["して"],["いる"],["の"],["は"],["、"],["もはや"],["わたし"],["で"],["は"],["なく"],["、"],["わたし"],["の"],["中","なか"],["に"],["住んで","すんで"],["いる"],["罪","つみ"],["な"],["の"],["です"],["。"]]},{"verse":21,"text":"それで、善をなそうと思う自分には、いつも悪が付きまとっているという法則に気づきます。","tok":[["それ"],["で"],["、"],["善","ぜん"],["を"],["なそう"],["と"],["思う","おもう"],["自分","じぶん"],["に"],["は"],["、"],["いつも"],["悪","わる"],["が"],["付きまとって","つきまとって"],["いる"],["と"],["いう"],["法則","ほうそく"],["に"],["気づきます","きづきます"],["。"]]},{"verse":22,"text":"「内なる人」としては神の律法を喜んでいますが、","tok":[["「"],["内","うち"],["なる"],["人","ひと"],["」"],["として"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["を"],["喜んで","よろこんで"],["います"],["が"],["、"]]},{"verse":23,"text":"わたしの五体にはもう一つの法則があって心の法則と戦い、わたしを、五体の内にある罪の法則のとりこにしているのが分かります。","tok":[["わたし"],["の"],["五体","ごたい"],["に"],["は"],["もう"],["一","ひと"],["つ"],["の"],["法則","ほうそく"],["が"],["あって"],["心","こころ"],["の"],["法則","ほうそく"],["と"],["戦い","たたかい"],["、"],["わたし"],["を"],["、"],["五体","ごたい"],["の"],["内","うち"],["に"],["ある"],["罪","つみ"],["の"],["法則","ほうそく"],["の"],["とりこ"],["に"],["して"],["いる"],["の"],["が"],["分かります","わかります"],["。"]]},{"verse":24,"text":"わたしはなんと惨めな人間なのでしょう。死に定められたこの体から、だれがわたしを救ってくれるでしょうか。","tok":[["わたし"],["は"],["なん"],["と"],["惨め","みじめ"],["な"],["人間","にんげん"],["な"],["の"],["でしょう"],["。"],["死","し"],["に"],["定められた","さだめられた"],["この"],["体","からだ"],["から"],["、"],["だれ"],["が"],["わたし"],["を"],["救って","すくって"],["くれるでしょう"],["か"],["。"]]},{"verse":25,"text":"わたしたちの主イエス‧キリストを通して神に感謝いたします。このように、わたし自身は心では神の律法に仕えていますが、肉では罪の法則に仕えているのです。","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["を"],["通して","とおして"],["神","かみ"],["に"],["感謝","かんしゃ"],["いたします"],["。"],["この"],["よう"],["に"],["、"],["わたし"],["自身","じしん"],["は"],["心","こころ"],["で"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["に"],["仕えて","つかえて"],["います"],["が"],["、"],["肉","にく"],["で"],["は"],["罪","つみ"],["の"],["法則","ほうそく"],["に"],["仕えて","つかえて"],["いる"],["の"],["です"],["。"]]}]
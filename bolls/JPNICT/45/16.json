[{"verse":1,"text":"ケンクレアイの教会の奉仕者でもある、わたしたちの姉妹フェベを紹介します。","tok":[["ケンクレアイ"],["の"],["教会","きょうかい"],["の"],["奉仕者","ほうししゃ"],["で"],["も"],["ある"],["、"],["わたしたち"],["の"],["姉妹","しまい"],["フェベ"],["を"],["紹介","しょうかい"],["します"],["。"]]},{"verse":2,"text":"どうか、聖なる者たちにふさわしく、また、主に結ばれている者らしく彼女を迎え入れ、あなたがたの助けを必要とするなら、どんなことでも助けてあげてください。彼女は多くの人々の援助者、特にわたしの援助者です。","tok":[["どう"],["か"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["に"],["ふさわしく"],["、"],["また"],["、"],["主に","おもに"],["結ばれて","むすばれて"],["いる"],["者","もの"],["らしく"],["彼女","かのじょ"],["を"],["迎え入れ","むかえいれ"],["、"],["あなた"],["がた"],["の"],["助け","たすけ"],["を"],["必要","ひつよう"],["と"],["するなら"],["、"],["どんな"],["こと"],["で"],["も"],["助けて","たすけて"],["あげて"],["ください"],["。"],["彼女","かのじょ"],["は"],["多く","おおく"],["の"],["人々","ひとびと"],["の"],["援助者","えんじょしゃ"],["、"],["特に","とくに"],["わたし"],["の"],["援助者","えんじょしゃ"],["です"],["。"]]},{"verse":3,"text":"キリスト‧イエスに結ばれてわたしの協力者となっている、プリスカとアキラによろしく。","tok":[["キリスト"],["‧"],["イエス"],["に"],["結ばれて","むすばれて"],["わたし"],["の"],["協力者","きょうりょくしゃ"],["と"],["なって"],["いる"],["、"],["プリスカ"],["と"],["アキラ"],["に"],["よろしく"],["。"]]},{"verse":4,"text":"命がけでわたしの命を守ってくれたこの人たちに、わたしだけでなく、異邦人のすべての教会が感謝しています。","tok":[["命がけ","いのちがけ"],["で"],["わたし"],["の"],["命","いのち"],["を"],["守って","まもって"],["くれた"],["この"],["人","ひと"],["たち"],["に"],["、"],["わたし"],["だけ"],["で"],["なく"],["、"],["異邦人","いほうじん"],["の"],["すべて"],["の"],["教会","きょうかい"],["が"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":5,"text":"また、彼らの家に集まる教会の人々にもよろしく伝えてください。わたしの愛するエパイネトによろしく。彼はアジア州でキリストに献げられた初穂です。","tok":[["また"],["、"],["彼","かれ"],["ら"],["の"],["家","いえ"],["に"],["集まる","あつまる"],["教会","きょうかい"],["の"],["人々","ひとびと"],["に"],["も"],["よろしく"],["伝えて","つたえて"],["ください"],["。"],["わたし"],["の"],["愛する","あいする"],["エパイネト"],["に"],["よろしく"],["。"],["彼","かれ"],["は"],["アジア州","あじあしゅう"],["で"],["キリスト"],["に"],["献げられた","ささげられた"],["初穂","はつほ"],["です"],["。"]]},{"verse":6,"text":"あなたがたのために非常に苦労したマリアによろしく。","tok":[["あなた"],["がた"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["苦労","くろう"],["した"],["マリア"],["に"],["よろしく"],["。"]]},{"verse":7,"text":"わたしの同胞で、一緒に捕らわれの身となったことのある、アンドロニコとユニアスによろしく。この二人は使徒たちの中で目立っており、わたしより前にキリストを信じる者になりました。","tok":[["わたし"],["の"],["同胞","どうほう"],["で"],["、"],["一緒","いっしょ"],["に"],["捕らわれ","とらわれ"],["の"],["身","み"],["と"],["なった"],["こと"],["の"],["ある"],["、"],["アンドロニコ"],["と"],["ユニアス"],["に"],["よろしく"],["。"],["この"],["二人","ふたり"],["は"],["使徒","しと"],["たち"],["の"],["中","なか"],["で"],["目立って","めだって"],["おり"],["、"],["わたし"],["より"],["前","まえ"],["に"],["キリスト"],["を"],["信じる","しんじる"],["者","もの"],["に"],["なりました"],["。"]]},{"verse":8,"text":"主に結ばれている愛するアンプリアトによろしく。","tok":[["主に","おもに"],["結ばれて","むすばれて"],["いる"],["愛する","あいする"],["アンプリアト"],["に"],["よろしく"],["。"]]},{"verse":9,"text":"わたしたちの協力者としてキリストに仕えているウルバノ、および、わたしの愛するスタキスによろしく。","tok":[["わたしたち"],["の"],["協力者","きょうりょくしゃ"],["として"],["キリスト"],["に"],["仕えて","つかえて"],["いる"],["ウルバノ"],["、"],["および"],["、"],["わたし"],["の"],["愛する","あいする"],["スタキス"],["に"],["よろしく"],["。"]]},{"verse":10,"text":"真のキリスト信者アペレによろしく。アリストブロ家の人々によろしく。","tok":[["真","しん"],["の"],["キリスト"],["信者","しんじゃ"],["アペレ"],["に"],["よろしく"],["。"],["アリストブロ"],["家","か"],["の"],["人々","ひとびと"],["に"],["よろしく"],["。"]]},{"verse":11,"text":"わたしの同胞ヘロディオンによろしく。ナルキソ家の中で主を信じている人々によろしく。","tok":[["わたし"],["の"],["同胞","どうほう"],["ヘロディオン"],["に"],["よろしく"],["。"],["ナルキソ"],["家","か"],["の"],["中","なか"],["で"],["主","ぬし"],["を"],["信じて","しんじて"],["いる"],["人々","ひとびと"],["に"],["よろしく"],["。"]]},{"verse":12,"text":"主のために苦労して働いているトリファイナとトリフォサによろしく。主のために非常に苦労した愛するペルシスによろしく。","tok":[["主","ぬし"],["の"],["ため"],["に"],["苦労","くろう"],["して"],["働いて","はたらいて"],["いる"],["トリファイナ"],["と"],["トリフォサ"],["に"],["よろしく"],["。"],["主","ぬし"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["苦労","くろう"],["した"],["愛する","あいする"],["ペルシス"],["に"],["よろしく"],["。"]]},{"verse":13,"text":"主に結ばれている選ばれた者ルフォス、およびその母によろしく。彼女はわたしにとっても母なのです。","tok":[["主に","おもに"],["結ばれて","むすばれて"],["いる"],["選ばれた","えらばれた"],["者","もの"],["ルフォス"],["、"],["および"],["その"],["母","はは"],["に"],["よろしく"],["。"],["彼女","かのじょ"],["は"],["わたし"],["にとって"],["も"],["母","はは"],["な"],["の"],["です"],["。"]]},{"verse":14,"text":"アシンクリト、フレゴン、ヘルメス、パトロバ、ヘルマス、および彼らと一緒にいる兄弟たちによろしく。","tok":[["アシンクリト"],["、"],["フレゴン"],["、"],["ヘルメス"],["、"],["パトロバ"],["、"],["ヘルマス"],["、"],["および"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["に"],["よろしく"],["。"]]},{"verse":15,"text":"フィロロゴとユリアに、ネレウスとその姉妹、またオリンパ、そして彼らと一緒にいる聖なる者たち一同によろしく。","tok":[["フィロロゴ"],["と"],["ユリア"],["に"],["、"],["ネレウス"],["と"],["その"],["姉妹","しまい"],["、"],["また"],["オリンパ"],["、"],["そして"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["いる"],["聖","せい"],["なる"],["者","もの"],["たち"],["一同","いちどう"],["に"],["よろしく"],["。"]]},{"verse":16,"text":"あなたがたも、聖なる口づけによって互いに挨拶を交わしなさい。キリストのすべての教会があなたがたによろしくと言っています。","tok":[["あなた"],["がた"],["も"],["、"],["聖","せい"],["なる"],["口づけ","くちづけ"],["によって"],["互い","たがい"],["に"],["挨拶","あいさつ"],["を"],["交わし","かわし"],["なさい"],["。"],["キリスト"],["の"],["すべて"],["の"],["教会","きょうかい"],["が"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":17,"text":"兄弟たち、あなたがたに勧めます。あなたがたの学んだ教えに反して、不和やつまずきをもたらす人々を警戒しなさい。彼らから遠ざかりなさい。","tok":[["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["に"],["勧めます","すすめます"],["。"],["あなた"],["がた"],["の"],["学んだ","まなんだ"],["教え","おしえ"],["に"],["反して","はんして"],["、"],["不和","ふわ"],["や"],["つまずき"],["を"],["もたらす"],["人々","ひとびと"],["を"],["警戒","けいかい"],["し"],["なさい"],["。"],["彼","かれ"],["ら"],["から"],["遠ざかり","とおざかり"],["なさい"],["。"]]},{"verse":18,"text":"こういう人々は、わたしたちの主であるキリストに仕えないで、自分の腹に仕えている。そして、うまい言葉やへつらいの言葉によって純朴な人々の心を欺いているのです。","tok":[["こう"],["いう"],["人々","ひとびと"],["は"],["、"],["わたしたち"],["の"],["主","ぬし"],["で"],["ある"],["キリスト"],["に"],["仕えないで","つかえないで"],["、"],["自分","じぶん"],["の"],["腹","はら"],["に"],["仕えて","つかえて"],["いる"],["。"],["そして"],["、"],["うまい"],["言葉","ことば"],["や"],["へつらい"],["の"],["言葉","ことば"],["によって"],["純朴","じゅんぼく"],["な"],["人々","ひとびと"],["の"],["心","こころ"],["を"],["欺いて","あざむいて"],["いる"],["の"],["です"],["。"]]},{"verse":19,"text":"あなたがたの従順は皆に知られています。だから、わたしはあなたがたのことを喜んでいます。なおその上、善にさとく、悪には疎くあることを望みます。","tok":[["あなた"],["がた"],["の"],["従順","じゅうじゅん"],["は"],["皆","みな"],["に"],["知られて","しられて"],["います"],["。"],["だ"],["から"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["こと"],["を"],["喜んで","よろこんで"],["います"],["。"],["なお"],["その"],["上","うえ"],["、"],["善","ぜん"],["に"],["さとく"],["、"],["悪","わる"],["に"],["は"],["疎く","うとく"],["ある"],["こと"],["を"],["望みます","のぞみます"],["。"]]},{"verse":20,"text":"平和の源である神は間もなく、サタンをあなたがたの足の下で打ち砕かれるでしょう。わたしたちの主イエスの恵みが、あなたがたと共にあるように。","tok":[["平和","へいわ"],["の"],["源","みなもと"],["で"],["ある"],["神","かみ"],["は"],["間","ま"],["も"],["なく"],["、"],["サタン"],["を"],["あなた"],["がた"],["の"],["足","あし"],["の"],["下","もと"],["で"],["打ち砕かれるでしょう","うちくだかれるでしょう"],["。"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["の"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":21,"text":"わたしの協力者テモテ、また同胞のルキオ、ヤソン、ソシパトロがあなたがたによろしくと言っています。","tok":[["わたし"],["の"],["協力者","きょうりょくしゃ"],["テモテ"],["、"],["また"],["同胞","どうほう"],["の"],["ルキオ"],["、"],["ヤソン"],["、"],["ソシパトロ"],["が"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":22,"text":"この手紙を筆記したわたしテルティオが、キリストに結ばれている者として、あなたがたに挨拶いたします。","tok":[["この"],["手紙","てがみ"],["を"],["筆記","ひっき"],["した"],["わたし"],["テルティオ"],["が"],["、"],["キリスト"],["に"],["結ばれて","むすばれて"],["いる"],["者","もの"],["として"],["、"],["あなた"],["がた"],["に"],["挨拶","あいさつ"],["いたします"],["。"]]},{"verse":23,"text":"わたしとこちらの教会全体が世話になっている家の主人ガイオが、よろしくとのことです。市の経理係エラストと兄弟のクアルトが、よろしくと言っています。","tok":[["わたし"],["と"],["こちら"],["の"],["教会","きょうかい"],["全体","ぜんたい"],["が"],["世話","せわ"],["に"],["なって"],["いる"],["家","いえ"],["の"],["主人","しゅじん"],["ガイオ"],["が"],["、"],["よろしく"],["と"],["の"],["こと"],["です"],["。"],["市","し"],["の"],["経理","けいり"],["係","かかり"],["エラスト"],["と"],["兄弟","きょうだい"],["の"],["クアルト"],["が"],["、"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":24,"text":"†〔わたしたちの主イエス‧キリストの恵みが、あなたがた一同と共にあるように。〕","tok":[["†"],["〔"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"],["〕"]]},{"verse":25,"text":"神は、わたしの福音すなわちイエス‧キリストについての宣教によって、あなたがたを強めることがおできになります。この福音は、世々にわたって隠されていた、秘められた計画を啓示するものです。","tok":[["神","かみ"],["は"],["、"],["わたし"],["の"],["福音","ふくいん"],["すなわち"],["イエス"],["‧"],["キリスト"],["について"],["の"],["宣教","せんきょう"],["によって"],["、"],["あなた"],["がた"],["を"],["強める","つよめる"],["こと"],["が"],["おでき"],[
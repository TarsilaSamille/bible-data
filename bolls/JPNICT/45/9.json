[{"verse":1,"text":"わたしはキリストに結ばれた者として真実を語り、偽りは言わない。わたしの良心も聖霊によって証ししていることですが、","tok":[["わたし"],["は"],["キリスト"],["に"],["結ばれた","むすばれた"],["者","もの"],["として"],["真実","しんじつ"],["を"],["語り","かたり"],["、"],["偽り","いつわり"],["は"],["言わない","いわない"],["。"],["わたし"],["の"],["良心","りょうしん"],["も"],["聖霊","せいれい"],["によって"],["証し","あかし"],["して"],["いる"],["こと"],["です"],["が"],["、"]]},{"verse":2,"text":"わたしには深い悲しみがあり、わたしの心には絶え間ない痛みがあります。","tok":[["わたし"],["に"],["は"],["深い","ふかい"],["悲しみ","かなしみ"],["が"],["あり"],["、"],["わたし"],["の"],["心","こころ"],["に"],["は"],["絶え間","たえま"],["ない"],["痛み","いたみ"],["が"],["あります"],["。"]]},{"verse":3,"text":"わたし自身、兄弟たち、つまり肉による同胞のためならば、キリストから離され、神から見捨てられた者となってもよいとさえ思っています。","tok":[["わたし"],["自身","じしん"],["、"],["兄弟","きょうだい"],["たち"],["、"],["つまり"],["肉","にく"],["に"],["よる"],["同胞","どうほう"],["の"],["ため"],["ならば"],["、"],["キリスト"],["から"],["離され","はなされ"],["、"],["神","かみ"],["から"],["見捨てられた","みすてられた"],["者","もの"],["と"],["なって"],["も"],["よい"],["と"],["さえ"],["思って","おもって"],["います"],["。"]]},{"verse":4,"text":"彼らはイスラエルの民です。神の子としての身分、栄光、契約、律法、礼拝、約束は彼らのものです。","tok":[["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["民","たみ"],["です"],["。"],["神","かみ"],["の"],["子","こ"],["として"],["の"],["身分","みぶん"],["、"],["栄光","えいこう"],["、"],["契約","けいやく"],["、"],["律法","りっぽう"],["、"],["礼拝","れいはい"],["、"],["約束","やくそく"],["は"],["彼","かれ"],["ら"],["の"],["もの"],["です"],["。"]]},{"verse":5,"text":"先祖たちも彼らのものであり、肉によればキリストも彼らから出られたのです。キリストは、万物の上におられる、永遠にほめたたえられる神、アーメン。","tok":[["先祖","せんぞ"],["たち"],["も"],["彼","かれ"],["ら"],["の"],["もの"],["で"],["あり"],["、"],["肉","にく"],["に"],["よれば"],["キリスト"],["も"],["彼","かれ"],["ら"],["から"],["出られた","でられた"],["の"],["です"],["。"],["キリスト"],["は"],["、"],["万物","ばんぶつ"],["の"],["上","うえ"],["に"],["おられる"],["、"],["永遠","えいえん"],["に"],["ほめたたえられる"],["神","かみ"],["、"],["アーメン"],["。"]]},{"verse":6,"text":"ところで、神の言葉は決して効力を失ったわけではありません。イスラエルから出た者が皆、イスラエル人ということにはならず、","tok":[["ところ"],["で"],["、"],["神","かみ"],["の"],["言葉","ことば"],["は"],["決して","けっして"],["効力","こうりょく"],["を"],["失った","うしなった"],["わけ"],["で"],["は"],["ありません"],["。"],["イスラエル"],["から"],["出た","でた"],["者","もの"],["が"],["皆","みな"],["、"],["イスラエル"],["人","にん"],["と"],["いう"],["こと"],["に"],["は"],["ならず"],["、"]]},{"verse":7,"text":"また、アブラハムの子孫だからといって、皆がその子供ということにはならない。かえって、「イサクから生まれる者が、あなたの子孫と呼ばれる。」","tok":[["また"],["、"],["アブラハム"],["の"],["子孫","しそん"],["だ"],["から"],["と"],["いって"],["、"],["皆","みな"],["が"],["その"],["子供","こども"],["と"],["いう"],["こと"],["に"],["は"],["ならない"],["。"],["かえって"],["、"],["「"],["イサク"],["から"],["生まれる","うまれる"],["者","もの"],["が"],["、"],["あなた"],["の"],["子孫","しそん"],["と"],["呼ばれる","よばれる"],["。"],["」"]]},{"verse":8,"text":"すなわち、肉による子供が神の子供なのではなく、約束に従って生まれる子供が、子孫と見なされるのです。","tok":[["すなわち"],["、"],["肉","にく"],["に"],["よる"],["子供","こども"],["が"],["神","かみ"],["の"],["子供","こども"],["な"],["ので"],["は"],["なく"],["、"],["約束","やくそく"],["に"],["従って","したがって"],["生まれる","うまれる"],["子供","こども"],["が"],["、"],["子孫","しそん"],["と"],["見なされる","みなされる"],["の"],["です"],["。"]]},{"verse":9,"text":"約束の言葉は、「来年の今ごろに、わたしは来る。そして、サラには男の子が生まれる」というものでした。","tok":[["約束","やくそく"],["の"],["言葉","ことば"],["は"],["、"],["「"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["に"],["、"],["わたし"],["は"],["来る","くる"],["。"],["そして"],["、"],["サラ"],["に"],["は"],["男の子","おとこのこ"],["が"],["生まれる","うまれる"],["」"],["と"],["いう"],["もの"],["でした"],["。"]]},{"verse":10,"text":"それだけではなく、リベカが、一人の人、つまりわたしたちの父イサクによって身ごもった場合にも、同じことが言えます。","tok":[["それ"],["だけ"],["で"],["は"],["なく"],["、"],["リベカ"],["が"],["、"],["一人","ひとり"],["の"],["人","ひと"],["、"],["つまり"],["わたしたち"],["の"],["父","ちち"],["イサク"],["によって"],["身ごもった","みごもった"],["場合","ばあい"],["に"],["も"],["、"],["同じ","おなじ"],["こと"],["が"],["言えます","いえます"],["。"]]},{"verse":11,"text":"その子供たちがまだ生まれもせず、善いことも悪いこともしていないのに、「兄は弟に仕えるであろう」とリベカに告げられました。それは、自由な選びによる神の計画が人の行いにはよらず、お召しになる方によって進められるためでした。","tok":[["その"],["子供","こども"],["たち"],["が"],["まだ"],["生まれ","うまれ"],["も"],["せず"],["、"],["善い","よい"],["こと"],["も"],["悪い","わるい"],["こと"],["も"],["して"],["いない"],["のに"],["、"],["「"],["兄","あに"],["は"],["弟","おとうと"],["に"],["仕えるで","つかえるで"],["あろう"],["」"],["と"],["リベカ"],["に"],["告げられました","つげられました"],["。"],["それ"],["は"],["、"],["自由","じゆう"],["な"],["選び","えらび"],["に"],["よる"],["神","かみ"],["の"],["計画","けいかく"],["が"],["人","ひと"],["の"],["行い","おこない"],["に"],["は"],["よらず"],["、"],["お召し","おめし"],["に"],["なる"],["方","かた"],["によって"],["進められる","すすめられる"],["ため"],["でした"],["。"]]},{"verse":13,"text":"「わたしはヤコブを愛し、エサウを憎んだ」と書いてあるとおりです。","tok":[["「"],["わたし"],["は"],["ヤコブ"],["を"],["愛し","あいし"],["、"],["エサウ"],["を"],["憎んだ","にくんだ"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":14,"text":"では、どういうことになるのか。神に不義があるのか。決してそうではない。","tok":[["で"],["は"],["、"],["どういう"],["こと"],["に"],["なる"],["の"],["か"],["。"],["神","かみ"],["に"],["不義","ふぎ"],["が"],["ある"],["の"],["か"],["。"],["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"]]},{"verse":15,"text":"神はモーセに、「わたしは自分が憐れもうと思う者を憐れみ、慈しもうと思う者を慈しむ」と言っておられます。","tok":[["神","かみ"],["は"],["モーセ"],["に"],["、"],["「"],["わたし"],["は"],["自分","じぶん"],["が"],["憐れもう","あわれもう"],["と"],["思う","おもう"],["者","もの"],["を"],["憐れみ","あわれみ"],["、"],["慈しもう","いつくしもう"],["と"],["思う","おもう"],["者","もの"],["を"],["慈しむ","いつくしむ"],["」"],["と"],["言って","いって"],["おられます"],["。"]]},{"verse":16,"text":"従って、これは、人の意志や努力ではなく、神の憐れみによるものです。","tok":[["従って","したがって"],["、"],["これ"],["は"],["、"],["人","ひと"],["の"],["意志","いし"],["や"],["努力","どりょく"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["憐れみ","あわれみ"],["に"],["よる"],["もの"],["です"],["。"]]},{"verse":17,"text":"聖書にはファラオについて、「わたしがあなたを立てたのは、あなたによってわたしの力を現し、わたしの名を全世界に告げ知らせるためである」と書いてあります。","tok":[["聖書","せいしょ"],["に"],["は"],["ファラオ"],["について"],["、"],["「"],["わたし"],["が"],["あなた"],["を"],["立てた","たてた"],["の"],["は"],["、"],["あなた"],["によって"],["わたし"],["の"],["力","ちから"],["を"],["現し","あらわし"],["、"],["わたし"],["の"],["名","な"],["を"],["全","ぜん"],["世界","せかい"],["に"],["告げ知らせる","つげしらせる"],["ため"],["で"],["ある"],["」"],["と"],["書いて","かいて"],["あります"],["。"]]},{"verse":18,"text":"このように、神は御自分が憐れみたいと思う者を憐れみ、かたくなにしたいと思う者をかたくなにされるのです。","tok":[["この"],["よう"],["に"],["、"],["神","かみ"],["は"],["御自分","ごじぶん"],["が"],["憐れみたい","あわれみたい"],["と"],["思う","おもう"],["者","もの"],["を"],["憐れみ","あわれみ"],["、"],["かたくな"],["に"],["したい"],["と"],["思う","おもう"],["者","もの"],["を"],["かたくな"],["に"],["される"],["の"],["です"],["。"]]},{"verse":19,"text":"ところで、あなたは言うでしょう。「ではなぜ、神はなおも人を責められるのだろうか。だれが神の御心に逆らうことができようか」と。","tok":[["ところ"],["で"],["、"],["あなた"],["は"],["言うでしょう","ゆうでしょう"],["。"],["「"],["で"],["は"],["なぜ"],["、"],["神","かみ"],["は"],["なお"],["も"],["人","ひと"],["を"],["責められる","せめられる"],["の"],["だろう"],["か"],["。"],["だれ"],["が"],["神","かみ"],["の"],["御心","おこころ"],["に"],["逆らう","さからう"],["こと"],["が"],["できよう"],["か"],["」"],["と"],["。"]]},{"verse":20,"text":"人よ、神に口答えするとは、あなたは何者か。造られた物が造った者に、「どうしてわたしをこのように造ったのか」と言えるでしょうか。","tok":[["人","ひと"],["よ"],["、"],["神","かみ"],["に"],["口答え","くちごたえ"],["する"],["と"],["は"],["、"],["あなた"],["は"],["何者","なにもの"],["か"],["。"],["造られた","つくられた"],["物","もの"],["が"],["造った","つくった"],["者","もの"],["に"],["、"],["「"],["どう"],["して"],["わたし"],["を"],["この"],["よう"],["に"],["造った","つくった"],["の"],["か"],["」"],["と"],["言えるでしょう","いえるでしょう"],["か"],["。"]]},{"verse":21,"text":"焼き物師は同じ粘土から、一つを貴いことに用いる器に、一つを貴くないことに用いる器に造る権限があるのではないか。","tok":[["焼き物師","やきものし"],["は"],["同じ","おなじ"],["粘土","ねんど"],["から"],["、"],["一","ひと"],["つ"],["を"],["貴い","とうとい"],["こと"],["に"],["用いる","もちいる"],["器","うつわ"],["に"],["、"],["一","ひと"],["つ"],["を"],["貴く","とうとく"],["ない"],["こと"],["に"],["用いる","もちいる"],["器","うつわ"],["に"],["造る","つくる"],["権限","けんげん"],["が"],["ある"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":22,"text":"神はその怒りを示し、その力を知らせようとしておられたが、怒りの器として滅びることになっていた者たちを寛大な心で耐え忍ばれたとすれば、","tok":[["神","かみ"],["は"],["その"],["怒り","いかり"],["を"],["示し","しめし"],["、"],["その"],["力","ちから"],["を"],["知らせよう","しらせよう"],["として"],["おられた"],["が"],["、"],["怒り","いかり"],["の"],["器","うつわ"],["として"],["滅びる","ほろびる"],["こと"],["に"],["なって"],["いた"],["者","もの"],["たち"],["を"],["寛大","かんだい"],["な"],["心","こころ"],["で"],["耐え忍ばれた","たえしのばれた"],["と"],["すれば"],["、"]]},{"verse":23,"text":"それも、憐れみの器として栄光を与えようと準備しておられた者たちに、御自分の豊かな栄光をお示しになるためであったとすれば、どうでしょう。","tok":[["それ"],["も"],["、"],["憐れみ","あわれみ"],["の"],["器","うつわ"],["として"],["栄光","えいこう"],["を"],["与えよう","あたえよう"],["と"],["準備","じゅんび"],["して"],["おられた"],["者","もの"],["たち"],["に"],["、"],["御自分","ごじぶん"],["の"],["豊か","ゆたか"],["な"],["栄光","えいこう"],["を"],["お示し","おしめし"],["に"],["なる"],["ため"],["で"],["あった"],["と"],["すれば"],["、"],["どう"],["でしょう"],["。"]]},{"verse":24,"text":"神はわたしたちを憐れみの器として、ユダヤ人からだけでなく、異邦人の中からも召し出してくださいました。","tok":[["神","かみ"],["は"],["わたしたち"],["を"],["憐れみ","あわれみ"],["の"],["器","うつわ"],["として"],["、"],["ユダヤ人","ゆだやじん"],["から"],["だけ"],["で"],["なく"],["、"],["異邦人","いほうじん"],["の"],["中","なか"],["から"],["も"],["召し出して","めしだして"],["くださいました"],["。"]]},{"verse":25,"text":"ホセアの書にも、次のように述べられています。「わたしは、自分の民でない者をわたしの民と呼び、愛されなかった者を愛された者と呼ぶ。","tok":[["ホセア"],["の"],["書","しょ"],["に"],["も"],["、"],["次","つぎ"],["の"],["よう"],["に"],["述べられて","のべられて"],["います"],["。"],["「"],["わたし"],["は"],["、"],["自分","じぶん"],["の"],["民","たみ"],["で"],["ない"],["者","もの"],["を"],["わたし"],["の"],["民","たみ"],["と"],["呼び","よび"],["、"],["愛されなかった","あいされなかった"],["者","もの"],["を"],["愛された","あいされた"],["者","もの"],["と"],["呼ぶ","よぶ"],["。"]]},{"verse":26,"text":"『あなたたちは、わたしの民ではない』と言われたその場所で、彼らは生ける神の子らと呼ばれる。」","tok":[["『"],["あなた"],["たち"],["は"],["、"],["わたし"],["の"],["民","たみ"],["で"],["は"],["ない"],["』"],["と"],["言われた","いわれた"],["その"],["場所","ばしょ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["生ける","いける"],["神","かみ"],["の"],["子","こ"],["ら"],["と"],["呼ばれる","よばれる"],["。"],["」"]]},{"verse":27,"text":"また、イザヤはイスラエルについて、叫んでいます。「たとえイスラエルの子らの数が海辺の砂のようであっても、残りの者が救われる。","tok":[["また"],["、"],["イザヤ"],["は"],["イスラエル"],["について"],["、"],["叫んで","さけんで"],["います"],["。"],["「"],["たとえ"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["数","かず"],["が"],["海辺","うみべ"],["の"],["砂","すな"],["の"],["よう"],["で"],["あって"],["も"],["、"],["残り","のこり"],["の"],["者","もの"],["が"],["救われる","すくわれる"],["。"]]},{"verse":28,"text":"主は地上において完全に、しかも速やかに、言われたことを行われる。」","tok":[["主","ぬし"],["は"],["地上","ちじょう"],["に"],["おいて"],["完全","かんぜん"],["に"],["、"],["しかも"],["速やか","すみやか"],["に"],["、"],["言われた","いわれた"],["こと"],["を"],["行われる","おこなわれる"],["。"],["」"]]},{"verse":29,"text":"それはまた、イザヤがあらかじめこう告げていたとおりです。「万軍の主がわたしたちに子孫を残されなかったら、わたしたちはソドムのようになり、ゴモラのようにされたであろう。」","tok":[["それ"],["は"],["また"],["、"],["イザヤ"],["が"],["あらかじめ"],["こう"],["告げて","つげて"],["いた"],["とおり"],["です"],["。"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["わたしたち"],["に"],["子孫","しそん"],["を"],["残されなかったら","のこされなかったら"],["、"],["わたしたち"],["は"],["ソドム"],["の"],["よう"],["に"],["なり"],["、"],["ゴモラ"],["の"],["よう"],["に"],["されたで"],["あろう"],["。"],["」"]]},{"verse":30,"text
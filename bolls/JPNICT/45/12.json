[{"verse":1,"text":"こういうわけで、兄弟たち、神の憐れみによってあなたがたに勧めます。自分の体を神に喜ばれる聖なる生けるいけにえとして献げなさい。これこそ、あなたがたのなすべき礼拝です。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["、"],["神","かみ"],["の"],["憐れみ","あわれみ"],["によって"],["あなた"],["がた"],["に"],["勧めます","すすめます"],["。"],["自分","じぶん"],["の"],["体","からだ"],["を"],["神","かみ"],["に"],["喜ばれる","よろこばれる"],["聖","せい"],["なる"],["生ける","いける"],["いけにえ"],["として"],["献げ","ささげ"],["なさい"],["。"],["これ"],["こそ"],["、"],["あなた"],["がた"],["の"],["なすべき"],["礼拝","れいはい"],["です"],["。"]]},{"verse":2,"text":"あなたがたはこの世に倣ってはなりません。むしろ、心を新たにして自分を変えていただき、何が神の御心であるか、何が善いことで、神に喜ばれ、また完全なことであるかをわきまえるようになりなさい。","tok":[["あなた"],["がた"],["は"],["この世","このよ"],["に"],["倣って","ならって"],["は"],["なりません"],["。"],["むしろ"],["、"],["心","こころ"],["を"],["新た","あらた"],["に"],["して"],["自分","じぶん"],["を"],["変えて","かえて"],["いただき"],["、"],["何","なん"],["が"],["神","かみ"],["の"],["御心","おこころ"],["で"],["ある"],["か"],["、"],["何","なん"],["が"],["善い","よい"],["こと"],["で"],["、"],["神","かみ"],["に"],["喜ばれ","よろこばれ"],["、"],["また"],["完全","かんぜん"],["な"],["こと"],["で"],["ある"],["か"],["を"],["わきまえる"],["よう"],["に"],["なり"],["なさい"],["。"]]},{"verse":3,"text":"わたしに与えられた恵みによって、あなたがた一人一人に言います。自分を過大に評価してはなりません。むしろ、神が各自に分け与えてくださった信仰の度合いに応じて慎み深く評価すべきです。","tok":[["わたし"],["に"],["与えられた","あたえられた"],["恵み","めぐみ"],["によって"],["、"],["あなた"],["がた"],["一人一人","ひとりひとり"],["に"],["言います","いいます"],["。"],["自分","じぶん"],["を"],["過大","かだい"],["に"],["評価","ひょうか"],["して"],["は"],["なりません"],["。"],["むしろ"],["、"],["神","かみ"],["が"],["各自","かくじ"],["に"],["分け与えて","わけあたえて"],["くださった"],["信仰","しんこう"],["の"],["度合い","どあい"],["に"],["応じて","おうじて"],["慎み深く","つつしみぶかく"],["評価","ひょうか"],["すべきです"],["。"]]},{"verse":4,"text":"というのは、わたしたちの一つの体は多くの部分から成り立っていても、すべての部分が同じ働きをしていないように、","tok":[["と"],["いう"],["の"],["は"],["、"],["わたしたち"],["の"],["一","ひと"],["つ"],["の"],["体","からだ"],["は"],["多く","おおく"],["の"],["部分","ぶぶん"],["から"],["成り立って","なりたって"],["いて"],["も"],["、"],["すべて"],["の"],["部分","ぶぶん"],["が"],["同じ","おなじ"],["働き","はたらき"],["を"],["して"],["いない"],["よう"],["に"],["、"]]},{"verse":5,"text":"わたしたちも数は多いが、キリストに結ばれて一つの体を形づくっており、各自は互いに部分なのです。","tok":[["わたしたち"],["も"],["数","すう"],["は"],["多い","おおい"],["が"],["、"],["キリスト"],["に"],["結ばれて","むすばれて"],["一","ひと"],["つ"],["の"],["体","からだ"],["を"],["形づくって","かたちづくって"],["おり"],["、"],["各自","かくじ"],["は"],["互い","たがい"],["に"],["部分","ぶぶん"],["な"],["の"],["です"],["。"]]},{"verse":6,"text":"わたしたちは、与えられた恵みによって、それぞれ異なった賜物を持っていますから、預言の賜物を受けていれば、信仰に応じて預言し、","tok":[["わたしたち"],["は"],["、"],["与えられた","あたえられた"],["恵み","めぐみ"],["によって"],["、"],["それぞれ"],["異なった","ことなった"],["賜物","たまもの"],["を"],["持って","もって"],["います"],["から"],["、"],["預言","よげん"],["の"],["賜物","たまもの"],["を"],["受けて","うけて"],["いれば"],["、"],["信仰","しんこう"],["に"],["応じて","おうじて"],["預言","よげん"],["し"],["、"]]},{"verse":7,"text":"奉仕の賜物を受けていれば、奉仕に専念しなさい。また、教える人は教えに、","tok":[["奉仕","ほうし"],["の"],["賜物","たまもの"],["を"],["受けて","うけて"],["いれば"],["、"],["奉仕","ほうし"],["に"],["専念","せんねん"],["し"],["なさい"],["。"],["また"],["、"],["教える","おしえる"],["人","ひと"],["は"],["教え","おしえ"],["に"],["、"]]},{"verse":8,"text":"勧める人は勧めに精を出しなさい。施しをする人は惜しまず施し、指導する人は熱心に指導し、慈善を行う人は快く行いなさい。","tok":[["勧める","すすめる"],["人","ひと"],["は"],["勧め","すすめ"],["に"],["精","せい"],["を"],["出し","だし"],["なさい"],["。"],["施し","ほどこし"],["を"],["する"],["人","ひと"],["は"],["惜しまず","おしまず"],["施し","ほどこし"],["、"],["指導","しどう"],["する"],["人","ひと"],["は"],["熱心","ねっしん"],["に"],["指導","しどう"],["し"],["、"],["慈善","じぜん"],["を"],["行う","おこなう"],["人","ひと"],["は"],["快く","こころよく"],["行い","おこない"],["なさい"],["。"]]},{"verse":9,"text":"愛には偽りがあってはなりません。悪を憎み、善から離れず、","tok":[["愛","あい"],["に"],["は"],["偽り","いつわり"],["が"],["あって"],["は"],["なりません"],["。"],["悪","あく"],["を"],["憎み","にくみ"],["、"],["善","ぜん"],["から"],["離れず","はなれず"],["、"]]},{"verse":10,"text":"兄弟愛をもって互いに愛し、尊敬をもって互いに相手を優れた者と思いなさい。","tok":[["兄弟","きょうだい"],["愛","あい"],["を"],["もって"],["互い","たがい"],["に"],["愛し","あいし"],["、"],["尊敬","そんけい"],["を"],["もって"],["互い","たがい"],["に"],["相手","あいて"],["を"],["優れた","すぐれた"],["者","もの"],["と"],["思い","おもい"],["なさい"],["。"]]},{"verse":11,"text":"怠らず励み、霊に燃えて、主に仕えなさい。","tok":[["怠らず","おこたらず"],["励み","はげみ"],["、"],["霊","れい"],["に"],["燃えて","もえて"],["、"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":12,"text":"希望をもって喜び、苦難を耐え忍び、たゆまず祈りなさい。","tok":[["希望","きぼう"],["を"],
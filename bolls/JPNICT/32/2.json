[{"verse":1,"text":"さて、主は巨大な魚に命じて、ヨナを呑み込ませられた。ヨナは三日三晩魚の腹の中にいた。","tok":[["さて"],["、"],["主","ぬし"],["は"],["巨大","きょだい"],["な"],["魚","さかな"],["に"],["命じて","めいじて"],["、"],["ヨナ"],["を"],["呑み込ませられた","のみこませられた"],["。"],["ヨナ"],["は"],["三日","みっか"],["三","さん"],["晩","ばん"],["魚","さかな"],["の"],["腹","はら"],["の"],["中","なか"],["に"],["いた"],["。"]]},{"verse":2,"text":"ヨナは魚の腹の中から自分の神、主に祈りをささげて、","tok":[["ヨナ"],["は"],["魚","さかな"],["の"],["腹","はら"],["の"],["中","なか"],["から"],["自分","じぶん"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈り","いのり"],["を"],["ささげて"],["、"]]},{"verse":3,"text":"言った。苦難の中で、わたしが叫ぶと主は答えてくださった。陰府の底から、助けを求めるとわたしの声を聞いてくださった。","tok":[["言った","いった"],["。"],["苦難","くなん"],["の"],["中","なか"],["で"],["、"],["わたし"],["が"],["叫ぶ","さけぶ"],["と"],["主","ぬし"],["は"],["答えて","こたえて"],["くださった"],["。"],["陰府","よみ"],["の"],["底","そこ"],["から"],["、"],["助け","たすけ"],["を"],["求める","もとめる"],["と"],["わたし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["くださった"],["。"]]},{"verse":4,"text":"あなたは、わたしを深い海に投げ込まれた。潮の流れがわたしを巻き込み波また波がわたしの上を越えて行く。","tok":[["あなた"],["は"],["、"],["わたし"],["を"],["深い","ふかい"],["海","うみ"],["に"],["投げ込まれた","なげこまれた"],["。"],["潮","しお"],["の"],["流れ","ながれ"],["が"],["わたし"],["を"],["巻き込み","まきこみ"],["波","は"],["また"],["波","なみ"],["が"],["わたし"],["の"],["上","うえ"],["を"],["越えて","こえて"],["行く","いく"],["。"]]},{"verse":5,"text":"わたしは思ったあなたの御前から追放されたのだと。生きて再び聖なる神殿を見ることがあろうかと。","tok":[["わたし"],["は"],["思った","おもった"],["あなた"],["の"],["御前","ごぜん"],["から"],["追放","ついほう"],["された"],["の"],["だ"],["と"],["。"],["生きて","いきて"],["再び","ふたたび"],["聖","せい"],["なる"],["神殿","しんでん"],["を"],["見る","みる"],["こと"],["が"],["あろう"],["か"],["と"],["。"]]},{"verse":6,"text":"大水がわたしを襲って喉に達する。深淵に呑み込まれ、水草が頭に絡みつく。","tok":[["大水","おおみず"],["が"],["わたし"],["を"],["襲って","おそって"],["喉","のど"],["に"],["達する","たっする"],["。"],["深淵","しんえん"],["に"],["呑み込まれ","のみこまれ"],["、"],["水草","みずくさ"],["が"],["頭","あたま"],["に"],["絡みつく","からみつく"],["。"]]},{"verse":7,"text":"わたしは山々の基まで、地の底まで沈み地はわたしの上に永久に扉を閉ざす。しかし、わが神、主よあなたは命を滅びの穴から引き上げてくださった。","tok":[["わたし"],["は"],["山々","やまやま"],["の"],["基","もと"],["まで"],["、"],["地","ち"],["の"],["底","そこ"],["まで"],["沈み","しずみ"],["地","ち"],["は"],["わたし"],["の"],["上","うえ"],["に"],["永久","えいきゅう"],["に"],["扉","とびら"],["を"],["閉ざす","とざす"],["。"],["しかし"],["、"],["わが"],["神","かみ"],["、"],["主","ぬし"],["よ"],["あなた"],["は"],["命","いのち"],["を"],["滅び","ほろび"],["の"],["穴","あな"],["から"],["引き上げて","ひきあげて"],["くださった"],["。"]]},{"verse":8,"text":"息絶えようとするときわたしは主の御名を唱えた。わたしの祈りがあなたに届き聖なる神殿に達した。","tok":[["息","いき"],["絶えよう","たえよう"],["と"],["する"],["とき"],["わたし"],["は"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["唱えた","となえた"],["。"],["わたし"],["の"],["祈り","いのり"],["が"],["あなた"],["に"],["届き","とどき"],["聖","せい"],["なる"],["神殿","しんでん"],["に"],["達した","たっした"],["。"]]},{"verse":9,"text":"偽りの神々に従う者たちが忠節を捨て去ろうとも","tok":[["偽り","いつわり"],["の"],["神々","かみがみ"],["に"],["従う","したがう"],["者","もの"],["たち"],["が"],["忠節","ちゅうせつ"],["を"],["捨て去ろう","すてさろう"],["とも"]]},{"verse":10,"text":"わたしは感謝の声をあげいけにえをささげて、誓ったことを果たそう。救いは、主にこそある。","tok":[["わたし"],["は"],["感謝","かんしゃ"],["の"],["声","こえ"],["を"],["あげ"],["いけにえ"],["を"],["ささげて"],["、"],["誓った","ちかった"],["こと"],["を"],["果たそう","はたそう"],["。"],["救い","すくい"],["は"],["、"],["主に","おもに"],["こそ"],["ある"],["。"]]},{"verse":11,"text":"主が命じられると、魚はヨナを陸地に吐き出した。","tok":[["主","ぬし"],["が"],["命じられる","めいじられる"],["と"],["、"],["魚","さかな"],["は"],["ヨナ"],["を"],["陸地","りくち"],["に"],["吐き出した","はきだした"],["。"]]}]
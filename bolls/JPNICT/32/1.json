[{"verse":1,"text":"主の言葉がアミタイの子ヨナに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["アミタイ"],["の"],["子","こ"],["ヨナ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「さあ、大いなる都ニネベに行ってこれに呼びかけよ。彼らの悪はわたしの前に届いている。」","tok":[["「"],["さあ"],["、"],["大いなる","おおいなる"],["都","と"],["ニネベ"],["に"],["行って","いって"],["これ"],["に"],["呼びかけ","よびかけ"],["よ"],["。"],["彼","かれ"],["ら"],["の"],["悪","あく"],["は"],["わたし"],["の"],["前","まえ"],["に"],["届いて","とどいて"],["いる"],["。"],["」"]]},{"verse":3,"text":"しかしヨナは主から逃れようとして出発し、タルシシュに向かった。ヤッファに下ると、折よくタルシシュ行きの船が見つかったので、船賃を払って乗り込み、人々に紛れ込んで主から逃れようと、タルシシュに向かった。","tok":[["しかし"],["ヨナ"],["は"],["主","ぬし"],["から"],["逃れよう","のがれよう"],["として"],["出発","しゅっぱつ"],["し"],["、"],["タルシシュ"],["に"],["向かった","むかった"],["。"],["ヤッファ"],["に"],["下る","くだる"],["と"],["、"],["折","おり"],["よく"],["タルシシュ"],["行き","いき"],["の"],["船","ふね"],["が"],["見つかった","みつかった"],["ので"],["、"],["船賃","ふなちん"],["を"],["払って","はらって"],["乗り込み","のりこみ"],["、"],["人々","ひとびと"],["に"],["紛れ込んで","まぎれこんで"],["主","ぬし"],["から"],["逃れよう","のがれよう"],["と"],["、"],["タルシシュ"],["に"],["向かった","むかった"],["。"]]},{"verse":4,"text":"主は大風を海に向かって放たれたので、海は大荒れとなり、船は今にも砕けんばかりとなった。","tok":[["主","ぬし"],["は"],["大風","たいふう"],["を"],["海","うみ"],["に"],["向かって","むかって"],["放たれた","はなたれた"],["ので"],["、"],["海","うみ"],["は"],["大荒れ","おおあれ"],["と"],["なり"],["、"],["船","ふね"],["は"],["今","いま"],["に"],["も"],["砕けん","くだけん"],["ばかり"],["と"],["なった"],["。"]]},{"verse":5,"text":"船乗りたちは恐怖に陥り、それぞれ自分の神に助けを求めて叫びをあげ、積み荷を海に投げ捨て、船を少しでも軽くしようとした。しかし、ヨナは船底に降りて横になり、ぐっすりと寝込んでいた。","tok":[["船乗り","ふなのり"],["たち"],["は"],["恐怖","きょうふ"],["に"],["陥り","おちいり"],["、"],["それぞれ"],["自分","じぶん"],["の"],["神","かみ"],["に"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫び","さけび"],["を"],["あげ"],["、"],["積み荷","つみに"],["を"],["海","うみ"],["に"],["投げ捨て","なげすて"],["、"],["船","ふね"],["を"],["少し","すこし"],["で"],["も"],["軽く","かるく"],["しよう"],["と"],["した"],["。"],["しかし"],["、"],["ヨナ"],["は"],["船底","ふなぞこ"],["に"],["降りて","おりて"],["横","よこ"],["に"],["なり"],["、"],["ぐっすり"],["と"],["寝込んで","ねこんで"],["いた"],["。"]]},{"verse":6,"text":"船長はヨナのところに来て言った。「寝ているとは何事か。さあ、起きてあなたの神を呼べ。神が気づいて助けてくれるかもしれない。」","tok":[["船長","せんちょう"],["は"],["ヨナ"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["寝て","ねて"],["いる"],["と"],["は"],["何事","なにごと"],["か"],["。"],["さあ"],["、"],["起きて","おきて"],["あなた"],["の"],["神","かみ"],["を"],["呼べ","よべ"],["。"],["神","かみ"],["が"],["気づいて","きづいて"],["助けて","たすけて"],["くれる"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":7,"text":"さて、人々は互いに言った。「さあ、くじを引こう。誰のせいで、我々にこの災難がふりかかったのか、はっきりさせよう。」そこで、くじを引くとヨナに当たった。","tok":[["さて"],["、"],["人々","ひとびと"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["くじ"],["を"],["引こう","ひこう"],["。"],["誰","だれ"],["の"],["せい"],["で"],["、"],["我々","われわれ"],["に"],["この"],["災難","さいなん"],["が"],["ふりかかった"],["の"],["か"],["、"],["はっきり"],["させよう"],["。"],["」"],["そこ"],["で"],["、"],["くじ"],["を"],["引く","ひく"],["と"],["ヨナ"],["に"],["当たった","あたった"],["。"]]},{"verse":8,"text":"人々は彼に詰め寄って、「さあ、話してくれ。この災難が我々にふりかかったのは、誰のせいか。あなたは何の仕事で行くのか。どこから来たのか。国はどこで、どの民族の出身なのか」と言った。","tok":[["人々","ひとびと"],["は"],["彼","かれ"],["に"],["詰め寄って","つめよって"],["、"],["「"],["さあ"],["、"],["話して","はなして"],["くれ"],["。"],["この"],["災難","さいなん"],["が"],["我々","われわれ"],["に"],["ふりかかった"],["の"],["は"],["、"],["誰","だれ"],["の"],["せい"],["か"],["。"],["あなた"],["は"],["何","なん"],["の"],["仕事","しごと"],["で"],["行く","いく"],["の"],["か"],["。"],["どこ"],["から"],["来た","きた"],["の"],["か"],["。"],["国","くに"],["は"],["どこ"],["で"],["、"],["どの"],["民族","みんぞく"],["の"],["出身","しゅっしん"],["な"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"ヨナは彼らに言った。「わたしはヘブライ人だ。海と陸とを創造された天の神、主を畏れる者だ。」","tok":[["ヨナ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["ヘブライ"],["人","にん"],["だ"],["。"],["海","うみ"],["と"],["陸","りく"],["と"],["を"],["創造","そうぞう"],["された"],["天","てん"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["畏れる","おそれる"],["者","もの"],["だ"],["。"],["」"]]},{"verse":10,"text":"人々は非常に恐れ、ヨナに言った。「なんという事をしたのだ。」人々はヨナが、主の前から逃げて来たことを知った。彼が白状したからである。","tok":[["人々","ひとびと"],["は"],["非常","ひじょう"],["に"],["恐れ","おそれ"],["、"],["ヨナ"],["に"],["言った","いった"],["。"],["「"],["なん"],["と"],["いう"],["事","こと"],["を"],["した"],["の"],["だ"],["。"],["」"],["人々","ひとびと"],["は"],["ヨナ"],["が"],["、"],["主","ぬし"],["の"],["前","まえ"],["から"],["逃げて","にげて"],["来た","きた"],["こと"],["を"],["知った","しった"],["。"],["彼","かれ"],["が"],["白状","はくじょう"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"彼らはヨナに言った。「あなたをどうしたら、海が静まるのだろうか。」海は荒れる一方だった。","tok":[["彼","かれ"],["ら"],["は"],["ヨナ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["を"],["どう"],["したら"],["、"],["海","うみ"],["が"],["静まる","しずまる"],["の"],["だろう"],["か"],["。"],["」"],["海","うみ"],["は"],["荒れる","あれる"],["一方","いっぽう"],["だった"],["。"]]},{"verse":12,"text":"ヨナは彼らに言った。「わたしの手足を捕らえて海にほうり込むがよい。そうすれば、海は穏やかになる。わたしのせいで、この大嵐があなたたちを見舞ったことは、わたしが知っている。」","tok":[["ヨナ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["わたし"],["の"],["手足","てあし"],["を"],["捕らえて","とらえて"],["海","うみ"],["に"],["ほうり込む","ほうりこむ"],["が"],["よい"],["。"],["そう"],["すれば"],["、"],["海","うみ"],["は"],["穏やか","おだやか"],["に"],["なる"],["。"],["わたし"],["の"],["せい"],["で"],["、"],["この"],["大嵐","おおあらし"],["が"],["あなた"],["たち"],["を"],["見舞った","みまった"],["こと"],["は"],["、"],["わたし"],["が"],["知って","しって"],["いる"],["。"],["」"]]},{"verse":13,"text":"乗組員は船を漕いで陸に戻そうとしたが、できなかった。海がますます荒れて、襲いかかってきたからである。","tok":[["乗組員","のりくみいん"],["は"],["船","ふね"],["を"],["漕いで","こいで"],["陸","りく"],["に"],["戻そう","もどそう"],["と"],["した"],["が"],["、"],["できなかった"],["。"],["海","うみ"],["が"],["ますます"],["荒れて","あれて"],["、"],["襲いかかって","おそいかかって"],["きた"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"ついに、彼らは主に向かって叫んだ。「ああ、主よ、この男の命のゆえに、滅ぼさないでください。無実の者を殺したといって責めないでください。主よ、すべてはあなたの御心のままなのですから。」","tok":[["ついに"],["、"],["彼","かれ"],["ら"],["は"],["主に","おもに"],["向かって","むかって"],["叫んだ","さけんだ"],["。"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["、"],["この"],["男","おとこ"],["の"],["命","いのち"],["の"],["ゆえ"],["に"],["、"],["滅ぼさないで","ほろぼさないで"],["ください"],["。"],["無実","むじつ"],["の"],["者","もの"],["を"],["殺した","ころした"],["と"],["いって"],["責めないで","せめないで"],["ください"],["。"],["主","ぬし"],["よ"],["、"],["すべて"],["は"],["あなた"],["の"],["御心","おこころ"],["の"],["まま"],["な"],["の"],["です"],["から"],["。"],["」"]]},{"verse":15,"text":"彼らがヨナの手足を捕らえて海へほうり込むと、荒れ狂っていた海は静まった。","tok":[["彼","かれ"],["ら"],["が"],["ヨナ"],["の"],["手足","てあし"],["を"],["捕らえて","とらえて"],["海","うみ"],["へ"],["ほうり込む","ほうりこむ"],["と"],["、"],["荒れ狂って","あれくるって"],["いた"],["海","うみ"],["は"],["静まった","しずまった"],["。"]]},{"verse":16,"text":"人々は大いに主を畏れ、いけにえをささげ、誓いを立てた。","tok":[["人々","ひとびと"],["は"],["大いに","おおいに"],["主","ぬし"],["を"],["畏れ","おそれ"],["、"],["いけにえ"],["を"],["ささげ"],["、"],["誓い","ちかい"],["を"],["立てた","たてた"],["。"]]}]
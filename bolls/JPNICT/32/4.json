[{"verse":1,"text":"ヨナにとって、このことは大いに不満であり、彼は怒った。","tok":[["ヨナ"],["にとって"],["、"],["この"],["こと"],["は"],["大いに","おおいに"],["不満","ふまん"],["で"],["あり"],["、"],["彼","かれ"],["は"],["怒った","おこった"],["。"]]},{"verse":2,"text":"彼は、主に訴えた。「ああ、主よ、わたしがまだ国にいましたとき、言ったとおりではありませんか。だから、わたしは先にタルシシュに向かって逃げたのです。わたしには、こうなることが分かっていました。あなたは、恵みと憐れみの神であり、忍耐深く、慈しみに富み、災いをくだそうとしても思い直される方です。","tok":[["彼","かれ"],["は"],["、"],["主に","おもに"],["訴えた","うったえた"],["。"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["、"],["わたし"],["が"],["まだ"],["国","くに"],["に"],["いました"],["とき"],["、"],["言った","いった"],["とおり"],["で"],["は"],["ありません"],["か"],["。"],["だ"],["から"],["、"],["わたし"],["は"],["先","さき"],["に"],["タルシシュ"],["に"],["向かって","むかって"],["逃げた","にげた"],["の"],["です"],["。"],["わたし"],["に"],["は"],["、"],["こう"],["なる"],["こと"],["が"],["分かって","わかって"],["いました"],["。"],["あなた"],["は"],["、"],["恵み","めぐみ"],["と"],["憐れみ","あわれみ"],["の"],["神","かみ"],["で"],["あり"],["、"],["忍耐","にんたい"],["深く","ふかく"],["、"],["慈しみ","いつくしみ"],["に"],["富み","とみ"],["、"],["災い","わざわい"],["を"],["くだそう"],["として"],["も"],["思い直される","おもいなおされる"],["方","かた"],["です"],["。"]]},{"verse":3,"text":"主よどうか今、わたしの命を取ってください。生きているよりも死ぬ方がましです。」","tok":[["主","ぬし"],["よ"],["どう"],["か"],["今","いま"],["、"],["わたし"],["の"],["命","いのち"],["を"],["取って","とって"],["ください"],["。"],["生きて","いきて"],["いる"],["より"],["も"],["死ぬ","しぬ"],["方","かた"],["が"],["まし"],["です"],["。"],["」"]]},{"verse":4,"text":"主は言われた。「お前は怒るが、それは正しいことか。」","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["怒る","おこる"],["が"],["、"],["それ"],["は"],["正しい","ただしい"],["こと"],["か"],["。"],["」"]]},{"verse":5,"text":"そこで、ヨナは都を出て東の方に座り込んだ。そして、そこに小屋を建て、日射しを避けてその中に座り、都に何が起こるかを見届けようとした。","tok":[["そこ"],["で"],["、"],["ヨナ"],["は"],["都","と"],["を"],["出て","でて"],["東","ひがし"],["の"],["方","ほう"],["に"],["座り込んだ","すわりこんだ"],["。"],["そして"],["、"],["そこ"],["に"],["小屋","こや"],["を"],["建て","たて"],["、"],["日射し","ひざし"],["を"],["避けて","さけて"],["その"],["中","なか"],["に"],["座り","すわり"],["、"],["都","と"],["に"],["何","なん"],["が"],["起こる","おこる"],["か"],["を"],["見届けよう","みとどけよう"],["と"],["した"],["。"]]},{"verse":6,"text":"すると、主なる神は彼の苦痛を救うため、とうごまの木に命じて芽を出させられた。とうごまの木は伸びてヨナよりも丈が高くなり、頭の上に陰をつくったので、ヨナの不満は消え、このとうごまの木を大いに喜んだ。","tok":[["する"],["と"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["彼","かれ"],["の"],["苦痛","くつう"],["を"],["救う","すくう"],["ため"],["、"],["と"],["う"],["ごま"],["の"],["木","き"],["に"],["命じて","めいじて"],["芽","め"],["を"],["出させられた","ださせられた"],["。"],["と"],["う"],["ごま"],["の"],["木","き"],["は"],["伸びて","のびて"],["ヨナ"],["より"],["も"],["丈","たけ"],["が"],["高く","たかく"],["なり"],["、"],["頭","あたま"],["の"],["上","うえ"],["に"],["陰","かげ"],["を"],["つくった"],["ので"],["、"],["ヨナ"],["の"],["不満","ふまん"],["は"],["消え","きえ"],["、"],["この"],["とう"],["ごま"],["の"],["木","き"],["を"],["大いに","おおいに"],["喜んだ","よろこんだ"],["。"]]},{"verse":7,"text":"ところが翌日の明け方、神は虫に命じて木に登らせ、とうごまの木を食い荒らさせられたので木は枯れてしまった。","tok":[["ところ"],["が"],["翌日","よくじつ"],["の"],["明け方","あけがた"],["、"],["神","かみ"],["は"],["虫","むし"],["に"],["命じて","めいじて"],["木","き"],["に"],["登らせ","のぼらせ"],["、"],["と"],["う"],["ごま"],["の"],["木","き"],["を"],["食い荒らさせられた","くいあらさせられた"],["ので"],["木","き"],["は"],["枯れて","かれて"],["しまった"],["。"]]},{"verse":8,"text":"日が昇ると、神は今度は焼けつくような東風に吹きつけるよう命じられた。太陽もヨナの頭上に照りつけたので、ヨナはぐったりとなり、死ぬことを願って言った。「生きているよりも、死ぬ方がましです。」","tok":[["日","ひ"],["が"],["昇る","のぼる"],["と"],["、"],["神","かみ"],["は"],["今度","こんど"],["は"],["焼けつく","やけつく"],["よう"],["な"],["東風","とうふう"],["に"],["吹きつける","ふきつける"],["よう"],["命じられた","めいじられた"],["。"],["太陽","たいよう"],["も"],["ヨナ"],["の"],["頭上","ずじょう"],["に"],["照りつけた","てりつけた"],["ので"],["、"],["ヨナ"],["は"],["ぐったり"],["と"],["なり"],["、"],["死ぬ","しぬ"],["こと"],["を"],["願って","ねがって"],["言った","いった"],["。"],["「"],["生きて","いきて"],["いる"],["より"],["も"],["、"],["死ぬ","しぬ"],["方","かた"],["が"],["まし"],["です"],["。"],["」"]]},{"verse":9,"text":"神はヨナに言われた。「お前はとうごまの木のことで怒るが、それは正しいことか。」彼は言った。「もちろんです。怒りのあまり死にたいくらいです。」","tok":[["神","かみ"],["は"],["ヨナ"],["に"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["とう"],["ごま"],["の"],["木","き"],["の"],["こと"],["で"],["怒る","おこる"],["が"],["、"],["それ"],["は"],["正しい","ただしい"],["こと"],["か"],["。"],["」"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["もちろん"],["です"],["。"],["怒り","いかり"],["の"],["あまり"],["死にたい","しにたい"],["くらい"],["です"],["。"],["」"]]},{"verse":10,"text":"すると、主はこう言われた。「お前は、自分で労することも育てることもなく、一夜にして生じ、一夜にして滅びたこのとうごまの木さえ惜しんでいる。","tok":[["する"],["と"],["、"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["、"],["自分","じぶん"],["で"],["労する","ろうする"],["こと"],["も"],["育てる","そだてる"],["こと"],["も"],["なく"],["、"],["一夜","いちや"],["に"],["して"],["生じ","しょうじ"],["、"],["一夜","いちや"],["に"],["して"],["滅びた","ほろびた"],["この"],["とう"],["ごま"],["の"],["木","き"],["さえ"],["惜しんで","おしんで"],["いる"],["。"]]},{"verse":11,"text":"それならば、どうしてわたしが、この大いなる都ニネベを惜しまずにいられるだろうか。そこには、十二万人以上の右も左もわきまえぬ人間と、無数の家畜がいるのだから。」","tok":[["それ"],["ならば"],["、"],["どう"],["して"],["わたし"],["が"],["、"],["この"],["大いなる","おおいなる"],["都","と"],["ニネベ"],["を"],["惜しまず","おしまず"],["に"],["いられるだろう"],["か"],["。"],["そこ"],["に"],["は"],["、"],["十二万人","じゅうにまんにん"],["以上","いじょう"],["の"],["右","みぎ"],["も"],["左","ひだり"],["も"],["わきまえぬ"],["人間","にんげん"],["と"],["、"],["無数","むすう"],["の"],["家畜","かちく"],["が"],["いる"],["の"],["だ"],["から"],["。"],["」"]]}]
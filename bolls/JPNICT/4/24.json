[{"verse":1,"text":"バラムは、イスラエルを祝福することが主の良いとされることであると悟り、いつものようにまじないを行いに行くことをせず、顔を荒れ野に向けた。","tok":[["バラム"],["は"],["、"],["イスラエル"],["を"],["祝福","しゅくふく"],["する"],["こと"],["が"],["主","ぬし"],["の"],["良い","よい"],["と"],["される"],["こと"],["で"],["ある"],["と"],["悟り","さとり"],["、"],["いつも"],["の"],["よう"],["に"],["まじない"],["を"],["行い","おこない"],["に"],["行く","いく"],["こと"],["を"],["せず"],["、"],["顔","かお"],["を"],["荒れ野","あれの"],["に"],["向けた","むけた"],["。"]]},{"verse":2,"text":"バラムは目を凝らして、イスラエルが部族ごとに宿営しているのを見渡した。神の霊がそのとき、彼に臨んだ。","tok":[["バラム"],["は"],["目","め"],["を"],["凝らして","こらして"],["、"],["イスラエル"],["が"],["部族","ぶぞく"],["ごと"],["に"],["宿営","しゅくえい"],["して"],["いる"],["の"],["を"],["見渡した","みわたした"],["。"],["神","かみ"],["の"],["霊","れい"],["が"],["その"],["とき"],["、"],["彼","かれ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":3,"text":"彼はこの託宣を述べた。ベオルの子バラムの言葉。目の澄んだ者の言葉。","tok":[["彼","かれ"],["は"],["この"],["託宣","たくせん"],["を"],["述べた","のべた"],["。"],["ベオル"],["の"],["子","こ"],["バラム"],["の"],["言葉","ことば"],["。"],["目","め"],["の"],["澄んだ","すんだ"],["者","もの"],["の"],["言葉","ことば"],["。"]]},{"verse":4,"text":"神の仰せを聞き全能者のお与えになる幻を見る者倒れ伏し、目を開かれている者の言葉。","tok":[["神","かみ"],["の"],["仰せ","おおせ"],["を"],["聞き","きき"],["全能者","ぜんのうしゃ"],["の"],["お与え","おあたえ"],["に"],["なる"],["幻","まぼろし"],["を"],["見る","みる"],["者","もの"],["倒れ伏し","たおれふし"],["、"],["目","め"],["を"],["開かれて","ひらかれて"],["いる"],["者","もの"],["の"],["言葉","ことば"],["。"]]},{"verse":5,"text":"いかに良いことかヤコブよ、あなたの天幕はイスラエルよ、あなたの住む所は。","tok":[["いかに"],["良い","よい"],["こと"],["か"],["ヤコブ"],["よ"],["、"],["あなた"],["の"],["天幕","てんまく"],["は"],["イスラエル"],["よ"],["、"],["あなた"],["の"],["住む","すむ"],["所","ところ"],["は"],["。"]]},{"verse":6,"text":"それは広がる谷大河の岸の園のようだ。それは主が植えられたアロエの木のよう水のほとりの杉のようだ。","tok":[["それ"],["は"],["広がる","ひろがる"],["谷","たに"],["大河","たいが"],["の"],["岸","きし"],["の"],["園","その"],["の"],["よう"],["だ"],["。"],["それ"],["は"],["主","ぬし"],["が"],["植えられた","うえられた"],["アロエ"],["の"],["木","き"],["の"],["よう"],["水","みず"],["の"],["ほとり"],["の"],["杉","すぎ"],["の"],["よう"],["だ"],["。"]]},{"verse":7,"text":"水は彼らの革袋から溢れ種は豊かな水を得て育つ。彼らの王はアガグよりも栄えその王国は高く上げられる。","tok":[["水","みず"],["は"],["彼","かれ"],["ら"],["の"],["革袋","かわぶくろ"],["から"],["溢れ","あふれ"],["種","たね"],["は"],["豊か","ゆたか"],["な"],["水","みず"],["を"],["得て","えて"],["育つ","そだつ"],["。"],["彼","かれ"],["ら"],["の"],["王","おう"],["は"],["アガグ"],["より"],["も"],["栄え","さかえ"],["その"],["王国","おうこく"],["は"],["高く","たかく"],["上げられる","あげられる"],["。"]]},{"verse":8,"text":"エジプトから彼らを導き出された神は彼らにとって野牛の角のようだ。彼らは、敵対する国を食らい尽くし骨を砕き、矢で刺し通す。","tok":[["エジプト"],["から"],["彼","かれ"],["ら"],["を"],["導き出された","みちびきだされた"],["神","かみ"],["は"],["彼","かれ"],["ら"],["にとって"],["野牛","やぎゅう"],["の"],["角","かど"],["の"],["よう"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["、"],["敵対","てきたい"],["する"],["国","くに"],["を"],["食らい","くらい"],["尽くし","つくし"],["骨","ほね"],["を"],["砕き","くだき"],["、"],["矢","や"],["で"],["刺し通す","さしとおす"],["。"]]},{"verse":9,"text":"雄獅子のように伏し雌獅子のように横たわる彼らを起き上がらせることができる者があろうか。あなたを祝福する者は祝福されあなたを呪う者は呪われる。","tok":[["雄","ゆう"],["獅子","しし"],["の"],["よう"],["に"],["伏し","ふし"],["雌","めす"],["獅子","しし"],["の"],["よう"],["に"],["横たわる","よこたわる"],["彼","かれ"],["ら"],["を"],["起き上がらせる","おきあがらせる"],["こと"],["が"],["できる"],["者","もの"],["が"],["あろう"],["か"],["。"],["あなた"],["を"],["祝福","しゅくふく"],["する"],["者","もの"],["は"],["祝福","しゅくふく"],["され"],["あなた"],["を"],["呪う","のろう"],["者","もの"],["は"],["呪われる","のろわれる"],["。"]]},{"verse":10,"text":"バラクはバラムに対して激しく怒り、手を打ち鳴らしながら、バラムに言った。「敵に呪いをかけるために招いたのに、見よ、お前は三度も祝福した。","tok":[["バラク"],["は"],["バラム"],["に対して","にたいして"],["激しく","はげしく"],["怒り","おこり"],["、"],["手","て"],["を"],["打ち鳴らし","うちならし"],["ながら"],["、"],["バラム"],["に"],["言った","いった"],["。"],["「"],["敵","てき"],["に"],["呪い","のろい"],["を"],["かける"],["ため"],["に"],["招いた","まねいた"],["のに"],["、"],["見よ","みよ"],["、"],["お前","おまえ"],["は"],["三","さん"],["度","ど"],["も"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":11,"text":"自分の所に逃げ帰るがよい。お前を大いに優遇するつもりでいたが、主がそれを差し止められたのだ。」","tok":[["自分","じぶん"],["の"],["所","ところ"],["に"],["逃げ帰る","にげかえる"],["が"],["よい"],["。"],["お前","おまえ"],["を"],["大いに","おおいに"],["優遇","ゆうぐう"],["する"],["つもり"],["で"],["いた"],["が"],["、"],["主","ぬし"],["が"],["それ"],["を"],["差し止められた","さしとめられた"],["の"],["だ"],["。"],["」"]]},{"verse":12,"text":"バラムはバラクに言った。「あなたがわたしのもとに遣わした使者に対しても、わたしはこう言ったではありませんか。","tok":[["バラム"],["は"],["バラク"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["わたし"],["の"],["もと"],["に"],["遣わした","つかわした"],["使者","ししゃ"],["に対して","にたいして"],["も"],["、"],["わたし"],["は"],["こう"],["言ったで","いったで"],["は"],["ありません"],["か"],["。"]]},{"verse":13,"text":"『たとえバラクが、家に満ちる金銀を贈ってくれても、主の言葉に逆らっては、善にしろ悪にしろ、わたしの心のままにすることはできません。わたしは、主が告げられることを告げるだけです』と。","tok":[["『"],["たとえ"],["バラク"],["が"],["、"],["家","いえ"],["に"],["満ちる","みちる"],["金銀","きんぎん"],["を"],["贈って","おくって"],["くれて"],["も"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["に"],["逆らって","さからって"],["は"],["、"],["善","ぜん"],["に"],["しろ"],["悪","わる"],["に"],["しろ"],["、"],["わたし"],["の"],["心","こころ"],["の"],["まま"],["に"],["する"],["こと"],["は"],["できません"],["。"],["わたし"],["は"],["、"],["主","ぬし"],["が"],["告げられる","つげられる"],["こと"],["を"],["告げる","つげる"],["だけ"],["です"],["』"],["と"],["。"]]},{"verse":14,"text":"わたしは今、わたしの民のもとに帰ります。後の日にこの民があなたの民に対して何をするか、あなたに警告しておきます。」","tok":[["わたし"],["は"],["今","いま"],["、"],["わたし"],["の"],["民","たみ"],["の"],["もと"],["に"],["帰ります","かえります"],["。"],["後","あと"],["の"],["日","ひ"],["に"],["この"],["民","たみ"],["が"],["あなた"],["の"],["民","たみ"],["に対して","にたいして"],["何","なん"],["を"],["する"],["か"],["、"],["あなた"],["に"],["警告","けいこく"],["して"],["おきます"],["。"],["」"]]},{"verse":15,"text":"そして彼はこの託宣を述べた。ベオルの子バラムの言葉。目の澄んだ者の言葉。","tok":[["そして"],["彼","かれ"],["は"],["この"],["託宣","たくせん"],["を"],["述べた","のべた"],["。"],["ベオル"],["の"],["子","こ"],["バラム"],["の"],["言葉","ことば"],["。"],["目","め"],["の"],["澄んだ","すんだ"],["者","もの"],["の"],["言葉","ことば"],["。"]]},{"verse":16,"text":"神の仰せを聞き、いと高き神の知識を持ち全能者のお与えになる幻を見る者倒れ伏し、目を開かれている者の言葉。","tok":[["神","かみ"],["の"],["仰せ","おおせ"],["を"],["聞き","きき"],["、"],["いと"],["高き","たかき"],["神","かみ"],["の"],["知識","ちしき"],["を"],["持ち","もち"],["全能者","ぜんのうしゃ"],["の"],["お与え","おあたえ"],["に"],["なる"],["幻","まぼろし"],["を"],["見る","みる"],["者","もの"],["倒れ伏し","たおれふし"],["、"],["目","め"],["を"],["開かれて","ひらかれて"],["いる"],["者","もの"],["の"],["言葉","ことば"],["。"]]},{"verse":17,"text":"わたしには彼が見える。しかし、今はいない。彼を仰いでいる。しかし、間近にではない。ひとつの星がヤコブから進み出る。ひとつの笏がイスラエルから立ち上がりモアブのこめかみを打ち砕きシェトのすべての子らの頭の頂を砕く。","tok":[["わたし"],["に"],["は"],["彼","かれ"],["が"],["見える","みえる"],["。"],["しかし"],["、"],["今","いま"],["は"],["いない"],["。"],["彼","かれ"],["を"],["仰いで","あおいで"],["いる"],["。"],["しかし"],["、"],["間近","まじか"],["にで"],["は"],["ない"],["。"],["ひと"],["つ"],["の"],["星","ほし"],["が"],["ヤコブ"],["から"],["進み出る","すすみでる"],["。"],["ひと"],["つ"],["の"],["笏","しゃく"],["が"],["イスラエル"],["から"],["立ち上がり","たちあがり"],["モアブ"],["の"],["こめかみ"],["を"],["打ち砕き","うちくだき"],["シェト"],["の"],["すべて"],["の"],["子","こ"],["ら"],["の"],["頭","あたま"],["の"],["頂","いただき"],["を"],["砕く","くだく"],["。"]]},{"verse":18,"text":"エドムはその継ぐべき地となり敵対するセイルは継ぐべき地となりイスラエルは力を示す。","tok":[["エドム"],["は"],["その"],["継ぐべき","つぐべき"],["地","ち"],["と"],["なり"],["敵対","てきたい"],["する"],["セイル"],["は"],["継ぐべき","つぐべき"],["地","ち"],["と"],["なり"],["イスラエル"],["は"],["力","ちから"],["を"],["示す","しめす"],["。"]]},{"verse":19,"text":"ヤコブから支配する者が出て残ったものを町から絶やす。","tok":[["ヤコブ"],["から"],["支配","しはい"],["する"],["者","もの"],["が"],["出て","でて"],["残った","のこった"],["もの"],["を"],["町","まち"],["から"],["絶やす","たやす"],["。"]]},{"verse":20,"text":"彼はアマレクを見渡して、この託宣を述べた。アマレクは諸国の民の頭しかし、その末はとこしえの滅びに至る。","tok":[["彼","かれ"],["は"],["アマレク"],["を"],["見渡して","みわたして"],["、"],["この"],["託宣","たくせん"],["を"],["述べた","のべた"],["。"],["アマレク"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["頭","あたま"],["しかし"],["、"],["その"],["末","すえ"],["は"],["とこしえ"],["の"],["滅び","ほろび"],["に"],["至る","いたる"],["。"]]},{"verse":21,"text":"彼はカイン人を見渡して、この託宣を述べた。お前の住む所は確かでありお前は巣（ケン）を岩の上に置く。","tok":[["彼","かれ"],["は"],["カイン人","かいんにん"],["を"],["見渡して","みわたして"],["、"],["この"],["託宣","たくせん"],["を"],["述べた","のべた"],["。"],["お前","おまえ"],["の"],["住む","すむ"],["所","ところ"],["は"],["確か","たしか"],["で"],["あり"],["お前","おまえ"],["は"],["巣（ケン）","す"],["を"],["岩","いわ"],["の"],["上","うえ"],["に"],["置く","おく"],["。"]]},{"verse":22,"text":"しかし、アシュルがお前をとりこにするときカインは必ず、焼き滅ぼされる。","tok":[["しかし"],["、"],["アシュル"],["が"],["お前","おまえ"],["を"],["とりこ"],["に"],["する"],["とき"],["カイン"],["は"],["必ず","かならず"],["、"],["焼き滅ぼされる","やきほろぼされる"],["。"]]},{"verse":23,"text":"彼はまたこの託宣を述べた。災いだ北から軍団を組んで来る者よ","tok":[["彼","かれ"],["は"],["また"],["この"],["託宣","たくせん"],["を"],["述べた","のべた"],["。"],["災い","わざわい"],["だ"],["北","きた"],["から"],["軍団","ぐんだん"],["を"],["組んで","くんで"],["来る","くる"],["者","もの"],["よ"]]},{"verse":24,"text":"キティムから寄せ来る者よ。彼らはアシュルを苦しめ、エベルを苦しめるが彼もまた、とこしえの滅びに至る。","tok":[["キティム"],["から"],["寄せ来る","よせくる"],["者","もの"],["よ"],["。"],["彼","かれ"],["ら"],["は"],["アシュル"],["を"],["苦しめ","くるしめ"],["、"],["エベル"],["を"],["苦しめる","くるしめる"],["が"],["彼","かれ"],["も"],["また"],["、"],["とこしえ"],["の"],["滅び","ほろび"],["に"],["至る","いたる"],["。"]]},{"verse":25,"text":"バラムは立ち上がり、自分の所に帰って行った。バラクも自分の道を去って行った。","tok":[["バラム"],["は"],["立ち上がり","たちあがり"],["、"],["自分","じぶん"],["の"],["所","ところ"],["に"],["帰って","かえって"],["行った","いった"],["。"],["バラク"],["も"],["自分","じぶん"],["の"],["道","みち"],["を"],["去って","さって"],["行った","いった"],["。"]]}]
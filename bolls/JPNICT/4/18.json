[{"verse":1,"text":"主はアロンに言われた。「あなたとあなたの子ら、ならびにあなたの父祖の家の者らは、共に聖所に関する罪責を負わねばならない。また、あなたとあなたの子らは、共に祭司職に関する罪責を負わねばならない。","tok":[["主","ぬし"],["は"],["アロン"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["ら"],["、"],["ならびに"],["あなた"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["者","もの"],["ら"],["は"],["、"],["共","とも"],["に"],["聖","せい"],["所","しょ"],["に"],["関する","かんする"],["罪責","ざいせき"],["を"],["負わねば","おわねば"],["ならない"],["。"],["また"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["ら"],["は"],["、"],["共","とも"],["に"],["祭司","さいし"],["職","しょく"],["に"],["関する","かんする"],["罪責","ざいせき"],["を"],["負わねば","おわねば"],["ならない"],["。"]]},{"verse":2,"text":"あなたの同族、すなわちあなたの父祖の部族であるレビ族の者たちをも用いて、身近な助け手とし、あなたとあなたの子らと共に掟の幕屋の前で仕えさせなさい。","tok":[["あなた"],["の"],["同族","どうぞく"],["、"],["すなわち"],["あなた"],["の"],["父祖","ふそ"],["の"],["部族","ぶぞく"],["で"],["ある"],["レビ族","れびぞく"],["の"],["者","もの"],["たち"],["を"],["も"],["用いて","もちいて"],["、"],["身近","みじか"],["な"],["助け手","たすけて"],["と"],["し"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["ら"],["と"],["共","とも"],["に"],["掟","おきて"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["で"],["仕えさせ","つかえさせ"],["なさい"],["。"]]},{"verse":3,"text":"彼らはあなたの務めを助け、幕屋全般の務めを果たす。しかし彼らは、聖所の祭具および祭壇に近づいてはならない。彼らもあなたたちも、死ぬことのないためである。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["務め","つとめ"],["を"],["助け","たすけ"],["、"],["幕屋","まくや"],["全般","ぜんぱん"],["の"],["務め","つとめ"],["を"],["果たす","はたす"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["、"],["聖","せい"],["所","しょ"],["の"],["祭具","さいぐ"],["および"],["祭壇","さいだん"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["も"],["あなた"],["たち"],["も"],["、"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼らはあなたの助け手として、臨在の幕屋の務めを果たし、幕屋のすべての作業に従事する。一般の人はあなたたちに近づいてはならない。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["助け手","たすけて"],["として"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["務め","つとめ"],["を"],["果たし","はたし"],["、"],["幕屋","まくや"],["の"],["すべて"],["の"],["作業","さぎょう"],["に"],["従事","じゅうじ"],["する"],["。"],["一般","いっぱん"],["の"],["人","ひと"],["は"],["あなた"],["たち"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"あなたたちが聖所の務めと祭壇の務めを果たす。そうすれば、怒りが再びイスラエルの人々に臨むことはないであろう。","tok":[["あなた"],["たち"],["が"],["聖","せい"],["所","しょ"],["の"],["務め","つとめ"],["と"],["祭壇","さいだん"],["の"],["務め","つとめ"],["を"],["果たす","はたす"],["。"],["そう"],["すれば"],["、"],["怒り","いかり"],["が"],["再び","ふたたび"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["臨む","のぞむ"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":6,"text":"見よ、わたしはあなたの同族であるレビ人をイスラエルの人々の中から選びとった。彼らは、臨在の幕屋の作業に従事するために、主に属する者としてあなたたちに与えられた者である。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["同族","どうぞく"],["で"],["ある"],["レビ人","れびにん"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["中","なか"],["から"],["選びとった","えらびとった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["作業","さぎょう"],["に"],["従事","じゅうじ"],["する"],["ため"],["に"],["、"],["主","ぬし"],["に"],["属する","ぞくする"],["者","もの"],["として"],["あなた"],["たち"],["に"],["与えられた","あたえられた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":7,"text":"ただし、祭壇および垂れ幕の奥にかかわる事柄についてはすべて、あなたとあなたと共にいるあなたの子らが祭司の務めを果たし、作業をせねばならない。わたしは祭司職を賜物としてあなたたちに与える。一般の人が近づけば、死刑に処せられる。」","tok":[["ただし"],["、"],["祭壇","さいだん"],["および"],["垂れ幕","たれまく"],["の"],["奥","おく"],["に"],["かかわる"],["事柄","ことがら"],["について"],["は"],["すべて"],["、"],["あなた"],["と"],["あなた"],["と"],["共","とも"],["に"],["いる"],["あなた"],["の"],["子","こ"],["ら"],["が"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["果たし","はたし"],["、"],["作業","さぎょう"],["を"],["せねば"],["ならない"],["。"],["わたし"],["は"],["祭司","さいし"],["職","しょく"],["を"],["賜物","たまもの"],["として"],["あなた"],["たち"],["に"],["与える","あたえる"],["。"],["一般","いっぱん"],["の"],["人","ひと"],["が"],["近づけば","ちかづけば"],["、"],["死刑","しけい"],["に"],["処せられる","しょせられる"],["。"],["」"]]},{"verse":8,"text":"主は更に、アロンに仰せになった。「見よ、あなたには、イスラエルの人々が聖なる献げ物としてささげる献納物の管理を任せ、その一部を定められた分として、あなたとあなたの子らに与える。これは不変の定めである。","tok":[["主","ぬし"],["は"],["更に","さらに"],["、"],["アロン"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["見よ","みよ"],["、"],["あなた"],["に"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["聖","せい"],["なる"],["献げ物","ささげもの"],["として"],["ささげる"],["献納物","けんのうぶつ"],["の"],["管理","かんり"],["を"],["任せ","まかせ"],["、"],["その"],["一部","いちぶ"],["を"],["定められた","さだめられた"],["分","ぶん"],["として"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["ら"],["に"],["与える","あたえる"],["。"],["これ"],["は"],["不変","ふへん"],["の"],["定め","さだめ"],["で"],["ある"],["。"]]},{"verse":9,"text":"神聖な献げ物のうちで、燃やしてしまわずにあなたのものとなるのは次のとおりである。神聖なものとしてわたしにささげられたすべての献げ物、すなわち穀物の献げ物、贖罪の献げ物、賠償の献げ物は、あなたとあなたの子らのものである。","tok":[["神聖","しんせい"],["な"],["献げ物","ささげもの"],["の"],["うち"],["で"],["、"],["燃やして","もやして"],["しまわず"],["に"],["あなた"],["の"],["もの"],["と"],["なる"],["の"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["神聖","しんせい"],["な"],["もの"],["として"],["わたし"],["に"],["ささげられた"],["すべて"],["の"],["献げ物","ささげもの"],["、"],["すなわち"],["穀物","こくもつ"],["の"],["献げ物","ささげもの"],["、"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["、"],["賠償","ばいしょう"],["の"],["献げ物","ささげもの"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["ら"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたはそれを神聖なものとして食べねばならない。男子だけがそれを食べることができる。それは、あなたにとって聖なるものである。","tok":[["あなた"],["は"],["それ"],["を"],["神聖","しんせい"],["な"],["もの"],["として"],["食べねば","たべねば"],["ならない"],["。"],["男子","だんし"],["だけ"],["が"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["それ"],["は"],["、"],["あなた"],["にとって"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"次のもの、すなわち彼らの贈り物である献納物、イスラエルの人々がささげた奉納物はすべてあなたのものである。わたしは、あなたとあなたと共にいるあなたの息子たち、娘たちにそれを与える。それは不変の定めである。あなたの家族のうちの清い者はだれでもそれを食べることができる。","tok":[["次","つぎ"],["の"],["もの"],["、"],["すなわち"],["彼","かれ"],["ら"],["の"],["贈り物","おくりもの"],["で"],["ある"],["献納物","けんのうぶつ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["ささげた"],["奉納物","ほうのうぶつ"],["は"],["すべて"],["あなた"],["の"],["もの"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["あなた"],["と"],["あなた"],["と"],["共","とも"],["に"],["いる"],["あなた"],["の"],["息子","むすこ"],["たち"],["、"],["娘","むすめ"],["たち"],["に"],["それ"],["を"],["与える","あたえる"],["。"],["それ"],["は"],["不変","ふへん"],["の"],["定め","さだめ"],["で"],["ある"],["。"],["あなた"],["の"],["家族","かぞく"],["の"],["うち"],["の"],["清い","きよい"],["者","もの"],["は"],["だれ"],["で"],["も"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"最上のオリーブ油、極上の新しいぶどう酒、穀物など、主にささげられた初物はすべて、あなたに与える。","tok":[["最上","さいじょう"],["の"],["オリーブ油","おりーぶゆ"],["、"],["極上","ごくじょう"],["の"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["、"],["穀物","こくもつ"],["など"],["、"],["主に","おもに"],["ささげられた"],["初物","はつもの"],["は"],["すべて"],["、"],["あなた"],["に"],["与える","あたえる"],["。"]]},{"verse":13,"text":"彼らの土地にできた初物で、彼らが主に携えるものはすべて、あなたのものとなる。あなたの家族のうちの清い者はだれでもそれを食べることができる。","tok":[["彼","かれ"],["ら"],["の"],["土地","とち"],["に"],["できた"],["初物","はつもの"],["で"],["、"],["彼","かれ"],["ら"],["が"],["主に","おもに"],["携える","たずさえる"],["もの"],["は"],["すべて"],["、"],["あなた"],["の"],["もの"],["と"],["なる"],["。"],["あなた"],["の"],["家族","かぞく"],["の"],["うち"],["の"],["清い","きよい"],["者","もの"],["は"],["だれ"],["で"],["も"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":14,"text":"イスラエルにおいて奉納されたものはすべて、あなたのものとなる。","tok":[["イスラエル"],["に"],["おいて"],["奉納","ほうのう"],["された"],["もの"],["は"],["すべて"],["、"],["あなた"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":15,"text":"人であれ、家畜であれ、主にささげられる生き物の初子はすべて、あなたのものとなる。ただし、人の初子は必ず贖わねばならない。また、汚れた家畜の初子も贖わねばならない。","tok":[["人","ひと"],["で"],["あれ"],["、"],["家畜","かちく"],["で"],["あれ"],["、"],["主に","おもに"],["ささげられる"],["生き物","いきもの"],["の"],["初子","ういご"],["は"],["すべて"],["、"],["あなた"],["の"],["もの"],["と"],["なる"],["。"],["ただし"],["、"],["人","ひと"],["の"],["初子","ういご"],["は"],["必ず","かならず"],["贖わねば","あがなわねば"],["ならない"],["。"],["また"],["、"],["汚れた","よごれた"],["家畜","かちく"],["の"],["初子","ういご"],["も"],["贖わねば","あがなわねば"],["ならない"],["。"]]},{"verse":16,"text":"初子は、生後一か月を経た後、銀五シェケル、つまり一シェケル当たり二十ゲラの聖所シェケルの贖い金を支払う。","tok":[["初子","ういご"],["は"],["、"],["生後","せいご"],["一","いち"],["か月","かげつ"],["を"],["経た","へた"],["後","あと"],["、"],["銀","ぎん"],["五","ご"],["シェケル"],["、"],["つまり"],["一","いち"],["シェケル"],["当たり","あたり"],["二十","にじゅう"],["ゲラ"],["の"],["聖","せい"],["所","しょ"],["シェケル"],["の"],["贖い","あがない"],["金","きん"],["を"],["支払う","しはらう"],["。"]]},{"verse":17,"text":"しかし、牛、羊、山羊の初子は、贖ってはならない。これらは聖なるものである。その血を祭壇に振りかけ、その脂肪を焼いて煙にする。これは、燃やして主にささげる宥めの香りである。","tok":[["しかし"],["、"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["山羊","やぎ"],["の"],["初子","ういご"],["は"],["、"],["贖って","あがなって"],["は"],["ならない"],["。"],["これ"],["ら"],["は"],["
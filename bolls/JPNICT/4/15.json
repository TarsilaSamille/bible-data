,{"verse":25,"text":"祭司がイスラエルの人々の共同体全体のために贖いの儀式をすると、彼らの罪は赦される。それは過失だからである。彼らは献げ物を燃やして主にささげる。それは贖罪の献げ物であって、彼らの過失のために主の御前にささげるものである。","tok":[["祭司","さいし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["ため"],["に"],["贖い","あがない"],["の"],["儀式","ぎしき"],["を"],["する"],["と"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["は"],["赦される","ゆるされる"],["。"],["それ"],["は"],["過失","かしつ"],["だ"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["献げ物","ささげもの"],["を"],["燃やして","もやして"],["主に","おもに"],["ささげる"],["。"],["それ"],["は"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["の"],["過失","かしつ"],["の"],["ため"],["に"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["ささげる"],["もの"],["で"],["ある"],["。"]]},{"verse":26,"text":"イスラエルの人々の共同体全体の罪およびあなたたちのもとに寄留する者の罪は、こうして赦される。これは、過失が民全体に及ぶ場合である。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["罪","つみ"],["および"],["あなた"],["たち"],["の"],["もと"],["に"],["寄留","きりゅう"],["する"],["者","もの"],["の"],["罪","つみ"],["は"],["、"],["こう"],["して"],["赦される","ゆるされる"],["。"],["これ"],["は"],["、"],["過失","かしつ"],["が"],["民","みん"],["全体","ぜんたい"],["に"],["及ぶ","およぶ"],["場合","ばあい"],["で"],["ある"],["。"]]},{"verse":27,"text":"もし、個人が過って罪を犯したときは、一歳の雌山羊一匹を贖罪の献げ物としてささげなさい。","tok":[["もし"],["、"],["個人","こじん"],["が"],["過って","よぎって"],["罪","つみ"],["を"],["犯した","おかした"],["とき"],["は"],["、"],["一歳","いちさい"],["の"],["雌山羊","めすやぎ"],["一匹","いちひき"],["を"],["贖罪","しょくざい"],["の"],["献げ物","ささげもの"],["として"],["ささげ"],["なさい"],["。"]]},{"verse":28,"text":"祭司が、過って過失の罪を犯した人のために、主の御前に贖いの儀式をすると、彼の罪は赦される。","tok":[["祭司","さいし"],["が"],["、"],["過って","よぎって"],["過失","かしつ"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["人","ひと"],["の"],["ため"],["に"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["贖い","あがない"],["の"],["儀式","ぎしき"],["を"],["する"],["と"],["、"],["彼","かれ"],["の"],["罪","つみ"],["は"],["赦される","ゆるされる"],["。"]]},{"verse":29,"text":"イスラエルの人々のうち、その土地に生まれた者も、あなたたちのもとに寄留する者も、過って罪を犯した場合には、同一の指示に従う。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["、"],["その"],["土地","とち"],["に"],["生まれた","うまれた"],["者","もの"],["も"],["、"],["あなた"],["たち"],["の"],["もと"],["に"],["寄留","きりゅう"],["する"],["者","もの"],["も"],["、"],["過って","よぎって"],["罪","つみ"],["を"],["犯した","おかした"],["場合","ばあい"],["に"],["は"],["、"],["同一","どういつ"],["の"],["指示","しじ"],["に"],["従う","したがう"],["。"]]},{"verse":30,"text":"ただし、土地に生まれた者であれ寄留者であれ、故意に罪を犯した者は、主を冒瀆する者であり、その人は民の中から断たれる。","tok":[["ただし"],["、"],["土地","とち"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["あれ"],["寄留者","きりゅうしゃ"],["で"],["あれ"],["、"],["故意","こい"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["は"],["、"],["主","ぬし"],["を"],["冒瀆","ぼうとく"],["する"],["者","もの"],["で"],["あり"],["、"],["その"],["人","ひと"],["は"],["民","みん"],["の"],["中","なか"],["から"],["断たれる","たたれる"],["。"]]},{"verse":31,"text":"彼は主の言葉を侮り、その命令を破ったのであるから、必ず断たれ、その罪責を負う。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["侮り","あなどり"],["、"],["その"],["命令","めいれい"],["を"],["破った","やぶった"],["ので"],["ある"],["から"],["、"],["必ず","かならず"],["断たれ","たたれ"],["、"],["その"],["罪責","ざいせき"],["を"],["負う","おう"],["。"]]},{"verse":32,"text":"イスラエルの人々が荒れ野にいたときのこと、ある男が安息日に薪を拾い集めているところを見つけられた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["荒れ野","あれの"],["に"],["いた"],["とき"],["の"],["こと"],["、"],["ある"],["男","おとこ"],["が"],["安息日","あんそくび"],["に"],["薪","たきぎ"],["を"],["拾い集めて","ひろいあつめて"],["いる"],["ところ"],["を"],["見つけられた","みつけられた"],["。"]]},{"verse":33,"text":"見つけた人々は、彼をモーセとアロンおよび共同体全体のもとに連れて来たが、","tok":[["見つけた","みつけた"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["を"],["モーセ"],["と"],["アロン"],["および"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["もと"],["に"],["連れて","つれて"],["来た","きた"],["が"],["、"]]},{"verse":34,"text":"どうすべきか、示しが与えられていなかったので、留置しておいた。","tok":[["どう"],["すべき"],["か"],["、"],["示し","しめし"],["が"],["与えられて","あたえられて"],["いなかった"],["ので"],["、"],["留置","りゅうち"],["して"],["おいた"],["。"]]},{"verse":35,"text":"主はモーセに言われた。「その男は必ず死刑に処せられる。共同体全体が宿営の外で彼を石で打ち殺さねばならない。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["その"],["男","おとこ"],["は"],["必ず","かならず"],["死刑","しけい"],["に"],["処せられる","しょせられる"],["。"],["共同体","きょうどうたい"],["全体","ぜんたい"],["が"],["宿営","しゅくえい"],["の"],["外","そと"],["で"],["彼","かれ"],["を"],["石","いし"],["で"],["打ち殺さねば","うちころさねば"],["ならない"],["。"],["」"]]},{"verse":36,"text":"共同体全体は、主がモーセに命じられたとおり、彼を宿営の外に連れ出して石で打ち殺したので、彼は死んだ。","tok":[["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["、"],["主","ぬし"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["、"],["彼","かれ"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["連れ出して","つれだして"],["石","いし"],["で"],["打ち殺した","うちころした"],["ので"],["、"],["彼","かれ"],["は"],["死んだ","しんだ"],["。"]]},{"verse":37,"text":"主はモーセに言われた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"]]},{"verse":38,"text":"イスラエルの人々に告げてこう言いなさい。代々にわたって、衣服の四隅に房を縫い付け、その房に青いひもを付けさせなさい。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["に"],["告げて","つげて"],["こう"],["言い","いい"],["なさい"],["。"],["代々","だいだい"],["に"],["わたって"],["、"],["衣服","いふく"],["の"],["四隅","よすみ"],["に"],["房","ふさ"],["を"],["縫い付け","ぬいつけ"],["、"],["その"],["房","ぼう"],["に"],["青い","あおい"],["ひも"],["を"],["付けさせ","つけさせ"],["なさい"],["。"]]},{"verse":39,"text":"それはあなたたちの房となり、あなたたちがそれを見るとき、主のすべての命令を思い起こして守り、あなたたちが自分の心と目の欲に従って、みだらな行いをしないためである。","tok":[["それ"],["は"],["あなた"],["たち"],["の"],["房","ふさ"],["と"],["なり"],["、"],["あなた"],["たち"],["が"],["それ"],["を"],["見る","みる"],["とき"],["、"],["主","ぬし"],["の"],["すべて"],["の"],["命令","めいれい"],["を"],["思い起こして","おもいおこして"],["守り","まもり"],["、"],["あなた"],["たち"],["が"],["自分","じぶん"],["の"],["心","こころ"],["と"],["目","め"],["の"],["欲","よく"],["に"],["従って","したがって"],["、"],["みだら"],["な"],["行い","おこない"],["を"],["しない"],["ため"],["で"],["ある"],["。"]]},{"verse":40,"text":"あなたたちは、わたしのすべての命令を思い起こして守り、あなたたちの神に属する聖なる者となりなさい。","tok":[["あなた"],["たち"],["は"],["、"],["わたし"],["の"],["すべて"],["の"],["命令","めいれい"],["を"],["思い起こして","おもいおこして"],["守り","まもり"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["に"],["属する","ぞくする"],["聖","せい"],["なる"],["者","もの"],["と"],["なり"],["なさい"],["。"]]},{"verse":41,"text":"わたしは、あなたたちの神となるために、あなたたちをエジプトの国から導き出したあなたたちの神、主である。わたしはあなたたちの神、主である。","tok":[["わたし"],["は"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["と"],["なる"],["ため"],["に"],["、"],["あなた"],["たち"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出した","みちびきだした"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"イスラエルの人々は更に進んで、エリコに近いヨルダン川の対岸にあるモアブの平野に宿営した。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["更に","さらに"],["進んで","すすんで"],["、"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["川","かわ"],["の"],["対岸","たいがん"],["に"],["ある"],["モアブ"],["の"],["平野","へいや"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":2,"text":"ツィポルの子バラクは、イスラエルがアモリ人に対してした事をことごとく見た。","tok":[["ツィポル"],["の"],["子","こ"],["バラク"],["は"],["、"],["イスラエル"],["が"],["アモリ人","あもりにん"],["に対して","にたいして"],["した"],["事","こと"],["を"],["ことごとく"],["見た","みた"],["。"]]},{"verse":3,"text":"モアブは、このおびただしい数の民に恐れを抱いていた。モアブはイスラエルの人々の前に気力もうせ、","tok":[["モアブ"],["は"],["、"],["この"],["おびただしい"],["数","かず"],["の"],["民","たみ"],["に"],["恐れ","おそれ"],["を"],["抱いて","いだいて"],["いた"],["。"],["モアブ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["気力","きりょく"],["も"],["うせ"],["、"]]},{"verse":4,"text":"ミディアン人の長老たちに、「今やこの群衆は、牛が野の草をなめ尽くすように、我々の周りをすべてなめ尽くそうとしている」と言った。当時、ツィポルの子バラクがモアブ王であった。","tok":[["ミディアン"],["人","にん"],["の"],["長老","ちょうろう"],["たち"],["に"],["、"],["「"],["今","いま"],["や"],["この"],["群衆","ぐんしゅう"],["は"],["、"],["牛","うし"],["が"],["野","の"],["の"],["草","くさ"],["を"],["なめ"],["尽くす","つくす"],["よう"],["に"],["、"],["我々","われわれ"],["の"],["周り","まわり"],["を"],["すべて"],["なめ"],["尽くそう","つくそう"],["として"],["いる"],["」"],["と"],["言った","いった"],["。"],["当時","とうじ"],["、"],["ツィポル"],["の"],["子","こ"],["バラク"],["が"],["モアブ"],["王","おう"],["で"],["あった"],["。"]]},{"verse":5,"text":"彼は、ユーフラテス川流域にあるアマウ人の町ペトルに住むベオルの子バラムを招こうとして、使者を送り、こう伝えた。「今ここに、エジプトから上って来た一つの民がいる。今や彼らは、地の面を覆い、わたしの前に住んでいる。","tok":[["彼","かれ"],["は"],["、"],["ユーフラテス"],["川","かわ"],["流域","りゅういき"],["に"],["ある"],["アマウ人","あまうにん"],["の"],["町","まち"],["ペトル"],["に"],["住む","すむ"],["ベオル"],["の"],["子","こ"],["バラム"],["を"],["招こう","まねこう"],["として"],["、"],["使者","ししゃ"],["を"],["送り","おくり"],["、"],["こう"],["伝えた","つたえた"],["。"],["「"],["今","いま"],["ここ"],["に"],["、"],["エジプト"],["から"],["上って","のぼって"],["来た","きた"],["一","ひと"],["つ"],["の"],["民","たみ"],["が"],["いる"],["。"],["今","いま"],["や"],["彼","かれ"],["ら"],["は"],["、"],["地","ち"],["の"],["面","めん"],["を"],["覆い","おおい"],["、"],["わたし"],["の"],["前","まえ"],["に"],["住んで","すんで"],["いる"],["。"]]},{"verse":6,"text":"この民はわたしよりも強大だ。今すぐに来て、わたしのためにこの民を呪ってもらいたい。そうすれば、わたしはこれを撃ち破って、この国から追い出すことができるだろう。あなたが祝福する者は祝福され、あなたが呪う者は呪われることを、わたしは知っている。」","tok":[["この"],["民","みん"],["は"],["わたし"],["より"],["も"],["強大","きょうだい"],["だ"],["。"],["今","いま"],["すぐ"],["に"],["来て","きて"],["、"],["わたし"],["の"],["ため"],["に"],["この"],["民","たみ"],["を"],["呪って","のろって"],["もらいたい"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["これ"],["を"],["撃ち破って","うちやぶって"],["、"],["この"],["国","くに"],["から"],["追い出す","おいだす"],["こと"],["が"],["できるだろう"],["。"],["あなた"],["が"],["祝福","しゅくふく"],["する"],["者","もの"],["は"],["祝福","しゅくふく"],["され"],["、"],["あなた"],["が"],["呪う","のろう"],["者","もの"],["は"],["呪われる","のろわれる"],["こと"],["を"],["、"],["わたし"],["は"],["知って","しって"],["いる"],["。"],["」"]]},{"verse":7,"text":"モアブとミディアンの長老たちは占いの礼物を携えてバラムの所に行き、バラクの言葉を伝えた。","tok":[["モアブ"],["と"],["ミディアン"],["の"],["長老","ちょうろう"],["たち"],["は"],["占い","うらない"],["の"],["礼物","れいもつ"],["を"],["携えて","たずさえて"],["バラム"],["の"],["所","ところ"],["に"],["行き","いき"],["、"],["バラク"],["の"],["言葉","ことば"],["を"],["伝えた","つたえた"],["。"]]},{"verse":8,"text":"バラムは彼らに言った。「今夜はここに泊まりなさい。主がわたしに告げられるとおりに、あなたたちに伝えよう。」モアブの長たちは、バラムのもとにとどまった。","tok":[["バラム"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["今夜","こんや"],["は"],["ここ"],["に"],["泊まり","とまり"],["なさい"],["。"],["主","ぬし"],["が"],["わたし"],["に"],["告げられる","つげられる"],["とおり"],["に"],["、"],["あなた"],["たち"],["に"],["伝えよう","つたえよう"],["。"],["」"],["モアブ"],["の"],["長","なが"],["たち"],["は"],["、"],["バラム"],["の"],["もと"],["に"],["とどまった"],["。"]]},{"verse":9,"text":"神はバラムのもとに来て言われた。「あなたのもとにいるこれらの者は何者か。」","tok":[["神","かみ"],["は"],["バラム"],["の"],["もと"],["に"],["来て","きて"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["もと"],["に"],["いる"],["これ"],["ら"],["の"],["者","もの"],["は"],["何者","なにもの"],["か"],["。"],["」"]]},{"verse":10,"text":"バラムは神に答えた。「モアブの王、ツィポルの子バラクがわたしに人を遣わして、","tok":[["バラム"],["は"],["神","かみ"],["に"],["答えた","こたえた"],["。"],["「"],["モアブ"],["の"],["王","おう"],["、"],["ツィポル"],["の"],["子","こ"],["バラク"],["が"],["わたし"],["に"],["人","ひと"],["を"],["遣わして","つかわして"],["、"]]},{"verse":11,"text":"『今ここに、エジプトから出て来た民がいて、地の面を覆っている。今すぐに来て、わたしのために彼らに呪いをかけてもらいたい。そうすれば、わたしはこれと戦って、追い出すことができるだろう』と申しました。」","tok":[["『"],["今","いま"],["ここ"],["に"],["、"],["エジプト"],["から"],["出て","でて"],["来た","きた"],["民","たみ"],["が"],["いて"],["、"],["地","ち"],["の"],["面","めん"],["を"],["覆って","おおって"],["いる"],["。"],["今","いま"],["すぐ"],["に"],["来て","きて"],["、"],["わたし"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["に"],["呪い","のろい"],["を"],["かけて"],["もらいたい"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["これ"],["と"],["戦って","たたかって"],["、"],["追い出す","おいだす"],["こと"],["が"],["できるだろう"],["』"],["と"],["申しました","もうしました"],["。"],["」"]]},{"verse":12,"text":"神はバラムに言われた。「あなたは彼らと一緒に行ってはならない。この民を呪ってはならない。彼らは祝福されているからだ。」","tok":[["神","かみ"],["は"],["バラム"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["行って","いって"],["は"],["ならない"],["。"],["この"],["民","たみ"],["を"],["呪って","のろって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["祝福","しゅくふく"],["されて"],["いる"],["から"],["だ"],["。"],["」"]]},{"verse":13,"text":"バラムは朝起きると、バラクの長たちに言った。「自分の国に帰りなさい。主は、わたしがあなたたちと一緒に行くことをお許しになりません。」","tok":[["バラム"],["は"],["朝","あさ"],["起きる","おきる"],["と"],["、"],["バラク"],["の"],["長","なが"],["たち"],["に"],["言った","いった"],["。"],["「"],["自分","じぶん"],["の"],["国","くに"],["に"],["帰り","かえり"],["なさい"],["。"],["主","ぬし"],["は"],["、"],["わたし"],["が"],["あなた"],["たち"],["と"],["一緒","いっしょ"],["に"],["行く","いく"],["こと"],["を"],["お許し","おゆるし"],["に"],["なりません"],["。"],["」"]]},{"verse":14,"text":"モアブの長たちは立ち去り、バラクのもとに来て、「バラムはわたしどもと一緒に来ることを承知しませんでした」と伝えた。","tok":[["モアブ"],["の"],["長","なが"],["たち"],["は"],["立ち去り","たちさり"],["、"],["バラク"],["の"],["もと"],["に"],["来て","きて"],["、"],["「"],["バラム"],["は"],["わたし"],["ども"],["と"],["一緒","いっしょ"],["に"],["来る","くる"],["こと"],["を"],["承知","しょうち"],["しませんでした"],["」"],["と"],["伝えた","つたえた"],["。"]]},{"verse":15,"text":"バラクはもう一度、前よりも多くの、位の高い使者を遣わした。","tok":[["バラク"],["は"],["もう"],["一度","いちど"],["、"],["前","まえ"],["より"],["も"],["多く","おおく"],["の"],["、"],["位","くらい"],["の"],["高い","たかい"],["使者","ししゃ"],["を"],["遣わした","つかわした"],["。"]]},{"verse":16,"text":"彼らはバラムの所に来て言った。「ツィポルの子バラクはこう申します。『どうかわたしのところに来るのを拒まないでください。","tok":[["彼","かれ"],["ら"],["は"],["バラム"],["の"],["所","ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["ツィポル"],["の"],["子","こ"],["バラク"],["は"],["こう"],["申します","もうします"],["。"],["『"],["どう"],["か"],["わたし"],["の"],["ところ"],["に"],["来る","くる"],["の"],["を"],["拒まないで","こばまないで"],["ください"],["。"]]},{"verse":17,"text":"あなたを大いに優遇します。あなたが言われることは何でもします。どうか来て、わたしのためにイスラエルの民に呪いをかけてください。』」","tok":[["あなた"],["を"],["大いに","おおいに"],["優遇","ゆうぐう"],["します"],["。"],["あなた"],["が"],["言われる","いわれる"],["こと"],["は"],["何","なん"],["で"],["も"],["します"],["。"],["どう"],["か"],["来て","きて"],["、"],["わたし"],["の"],["ため"],["に"],["イスラエル"],["の"],["民","たみ"],["に"],["呪い","のろい"],["を"],["かけて"],["ください"],["。"],["』"],["」"]]},{"verse":18,"text":"バラムはバラクの家臣に答えた。「たとえバラクが、家に満ちる金銀を贈ってくれても、わたしの神、主の言葉に逆らうことは、事の大小を問わず何もできません。","tok":[["バラム"],["は"],["バラク"],["の"],["家臣","かしん"],["に"],["答えた","こたえた"],["。"],["「"],["たとえ"],["バラク"],["が"],["、"],["家","いえ"],["に"],["満ちる","みちる"],["金銀","きんぎん"],["を"],["贈って","おくって"],["くれて"],["も"],["、"],["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["に"],["逆らう","さからう"],["こと"],["は"],["、"],["事","こと"],["の"],["大小","だいしょう"],["を"],["問わず","とわず"],["何","なん"],["も"],["できません"],["。"]]},{"verse":19,"text":"あなたがたも、今夜はここにとどまって、主がわたしに、この上何とお告げになるか、確かめさせてください。」","tok":[["あなた"],["がた"],["も"],["、"],["今夜","こんや"],["は"],["ここ"],["に"],["とどまって"],["、"],["主","ぬし"],["が"],["わたし"],["に"],["、"],["この"],["上","うえ"],["何","なん"],["と"],["お告げ","おつげ"],["に"],["なる"],["か"],["、"],["確かめさせて","たしかめさせて"],["ください"],["。"],["」"]]},{"verse":20,"text":"その夜、神はバラムのもとに来て、こう言われた。「これらの者があなたを呼びに来たのなら、立って彼らと共に行くがよい。しかし、わたしがあなたに告げることだけを行わねばならない。」","tok":[["その"],["夜","よる"],["、"],["神","かみ"],["は"],["バラム"],["の"],["もと"],["に"],["来て","きて"],["、"],["こう"],["言われた","いわれた"],["。"],["「"],["これ"],["ら"],["の"],["者","もの"],["が"],["あなた"],["を"],["呼び","よび"],["に"],["来た","きた"],["の"],["なら"],["、"],["立って","たって"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["行く","いく"],["が"],["よい"],["。"],["しかし"],["、"],["わたし"],["が"],["あなた"],["に"],["告げる","つげる"],["こと"],["だけ"],["を"],["行わねば","おこなわねば"],["ならない"],["。"],["」"]]},{"verse":21,"text":"バラムは朝起きるとろばに鞍をつけ、モアブの長
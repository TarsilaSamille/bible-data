erse":23,"text":"または、人を殺せるほどの石を、よく見もせずに人の上に落とすかして、人を死なせた場合、その人がその敵でもなく、危害を加えようとしたのでもないときには、","tok":[["また"],["は"],["、"],["人","ひと"],["を"],["殺せる","ころせる"],["ほど"],["の"],["石","いし"],["を"],["、"],["よく"],["見","み"],["も"],["せず"],["に"],["人","ひと"],["の"],["上","うえ"],["に"],["落とす","おとす"],["か"],["して"],["、"],["人","ひと"],["を"],["死なせた","しなせた"],["場合","ばあい"],["、"],["その"],["人","ひと"],["が"],["その"],["敵","てき"],["で"],["も"],["なく"],["、"],["危害","きがい"],["を"],["加えよう","くわえよう"],["と"],["した"],["ので"],["も"],["ない"],["とき"],["に"],["は"],["、"]]},{"verse":24,"text":"共同体はこれらの判例に基づいて、殺した当人と血の復讐をする者との間を裁かなければならない。","tok":[["共同体","きょうどうたい"],["は"],["これ"],["ら"],["の"],["判例","はんれい"],["に"],["基づいて","もとづいて"],["、"],["殺した","ころした"],["当人","とうにん"],["と"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["と"],["の"],["間","あいだ"],["を"],["裁かなければ","さばかなければ"],["ならない"],["。"]]},{"verse":25,"text":"すなわち、共同体は、人を殺してしまった者を血の復讐をする者の手から救い出し、共同体が、彼の逃げ込んだ逃れの町に彼を帰さなければならない。彼は聖なる油を注がれた大祭司が死ぬまで、そこにとどまらねばならない。","tok":[["すなわち"],["、"],["共同体","きょうどうたい"],["は"],["、"],["人","ひと"],["を"],["殺して","ころして"],["しまった"],["者","もの"],["を"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"],["共同体","きょうどうたい"],["が"],["、"],["彼","かれ"],["の"],["逃げ込んだ","にげこんだ"],["逃れ","のがれ"],["の"],["町","まち"],["に"],["彼","かれ"],["を"],["帰さなければ","かえさなければ"],["ならない"],["。"],["彼","かれ"],["は"],["聖","せい"],["なる"],["油","あぶら"],["を"],["注がれた","そそがれた"],["大","だい"],["祭司","さいし"],["が"],["死ぬ","しぬ"],["まで"],["、"],["そこ"],["に"],["とどまらねば"],["ならない"],["。"]]},{"verse":26,"text":"しかしもし、人を殺した者が、逃げ込んだ逃れの町の境の外に出た場合、","tok":[["しかし"],["もし"],["、"],["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["が"],["、"],["逃げ込んだ","にげこんだ"],["逃れ","のがれ"],["の"],["町","まち"],["の"],["境","さかい"],["の"],["外","そと"],["に"],["出た","でた"],["場合","ばあい"],["、"]]},{"verse":27,"text":"血の復讐をする者が逃れの町の境の外でこれと出会い、血の復讐をする者が、人を殺した者を殺したとしても、彼には血を流した罪はない。","tok":[["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["が"],["逃れ","のがれ"],["の"],["町","まち"],["の"],["境","さかい"],["の"],["外","そと"],["で"],["これ"],["と"],["出会い","であい"],["、"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["が"],["、"],["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["を"],["殺した","ころした"],["として"],["も"],["、"],["彼","かれ"],["に"],["は"],["血","ち"],["を"],["流した","ながした"],["罪","つみ"],["は"],["ない"],["。"]]},{"verse":28,"text":"なぜなら、人を殺した者は、大祭司が死ぬまで、逃れの町のうちにとどまらねばならないからである。大祭司が死んだ後はじめて、人を殺した者は自分の所有地に帰ることができる。","tok":[["なぜ"],["なら"],["、"],["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["は"],["、"],["大","だい"],["祭司","さいし"],["が"],["死ぬ","しぬ"],["まで"],["、"],["逃れ","のがれ"],["の"],["町","まち"],["の"],["うち"],["に"],["とどまらねば"],["ならない"],["から"],["で"],["ある"],["。"],["大","だい"],["祭司","さいし"],["が"],["死んだ","しんだ"],["後","あと"],["はじめて"],["、"],["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["は"],["自分","じぶん"],["の"],["所有地","しょゆうち"],["に"],["帰る","かえる"],["こと"],["が"],["できる"],["。"]]},{"verse":29,"text":"これらは、あなたたちがどこに住もうとも、代々にわたって守るべき法の定めとせねばならない。","tok":[["これ"],["ら"],["は"],["、"],["あなた"],["たち"],["が"],["どこ"],["に"],["住もう","すもう"],["とも"],["、"],["代々","だいだい"],["に"],["わたって"],["守るべき","まもるべき"],["法","ほう"],["の"],["定め","さだめ"],["と"],["せねば"],["ならない"],["。"]]},{"verse":30,"text":"人を殺した者については、必ず複数の証人の証言を得たうえで、その殺害者を処刑しなければならない。しかし、一人の証人の証言のみで人を死に至らせてはならない。","tok":[["人","ひと"],["を"],["殺した","ころした"],["者","もの"],["について"],["は"],["、"],["必ず","かならず"],["複数","ふくすう"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["を"],["得た","えた"],["うえ"],["で"],["、"],["その"],["殺害者","さつがいしゃ"],["を"],["処刑","しょけい"],["しなければ"],["ならない"],["。"],["しかし"],["、"],["一人","ひとり"],["の"],["証人","しょうにん"],["の"],["証言","しょうげん"],["のみ"],["で"],["人","ひと"],["を"],["死","し"],["に"],["至らせて","いたらせて"],["は"],["ならない"],["。"]]},{"verse":31,"text":"あなたたちは、死罪の判決を受けた殺害者の生命と引き換えに贖い金を受け取ってはならない。彼は必ず死刑に処せられなければならない。","tok":[["あなた"],["たち"],["は"],["、"],["死罪","しざい"],["の"],["判決","はんけつ"],["を"],["受けた","うけた"],["殺害者","さつがいしゃ"],["の"],["生命","せいめい"],["と"],["引き換え","ひきかえ"],["に"],["贖い","あがない"],["金","きん"],["を"],["受け取って","うけとって"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["必ず","かならず"],["死刑","しけい"],["に"],["処せられなければ","しょせられなければ"],["ならない"],["。"]]},{"verse":32,"text":"あなたたちは、祭司が死ぬまでは、逃れの町に逃げ込んだ者から贖い金を受け取って国に帰らせて、生活させてはならない。","tok":[["あなた"],["たち"],["は"],["、"],["祭司","さいし"],["が"],["死ぬ","しぬ"],["まで"],["は"],["、"],["逃れ","のがれ"],["の"],["町","まち"],["に"],["逃げ込んだ","にげこんだ"],["者","もの"],["から"],["贖い","あがない"],["金","きん"],["を"],["受け取って","うけとって"],["国","くに"],["に"],["帰らせて","かえらせて"],["、"],["生活","せいかつ"],["させて"],["は"],["ならない"],["。"]]},{"verse":33,"text":"あなたたちは、自分のいる土地を汚してはならない。血は土地を汚すからである。土地に流された血は、それを流した者の血によらなければ、贖うことができない。","tok":[["あなた"],["たち"],["は"],["、"],["自分","じぶん"],["の"],["いる"],["土地","とち"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["血","ち"],["は"],["土地","とち"],["を"],["汚す","よごす"],["から"],["で"],["ある"],["。"],["土地","とち"],["に"],["流された","ながされた"],["血","ち"],["は"],["、"],["それ"],["を"],["流した","ながした"],["者","もの"],["の"],["血","ち"],["に"],["よらなければ"],["、"],["贖う","あがなう"],["こと"],["が"],["できない"],["。"]]},{"verse":34,"text":"あなたたちの住む土地、わたしがそこに宿る土地を汚してはならない。主であるわたしがイスラエルの人々のただ中に宿っているからである。","tok":[["あなた"],["たち"],["の"],["住む","すむ"],["土地","とち"],["、"],["わたし"],["が"],["そこ"],["に"],["宿る","やどる"],["土地","とち"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ただ中","ただなか"],["に"],["宿って","やどって"],["いる"],["から"],["で"],["ある"],["。"]]}]
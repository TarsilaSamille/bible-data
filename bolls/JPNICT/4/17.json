[{"verse":1,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":2,"text":"「祭司アロンの子エルアザルに告げ、焼け跡から香炉を取り出し、炭火は遠くにまき散らすように言いなさい。香炉は既に聖なるものとなっている。","tok":[["「"],["祭司","さいし"],["アロン"],["の"],["子","こ"],["エルアザル"],["に"],["告げ","つげ"],["、"],["焼け跡","やけあと"],["から"],["香炉","こうろ"],["を"],["取り出し","とりだし"],["、"],["炭火","すみび"],["は"],["遠く","とおく"],["に"],["まき散らす","まきちらす"],["よう"],["に"],["言い","いい"],["なさい"],["。"],["香炉","こうろ"],["は"],["既に","すでに"],["聖","せい"],["なる"],["もの"],["と"],["なって"],["いる"],["。"]]},{"verse":3,"text":"命を落とした罪人たちの香炉を打ち延ばして板金にし、祭壇の覆いを作りなさい。それらは、主の御前にささげられ、聖なるものとされているからである。これは、イスラエルの人々に対する警告のしるしとなるであろう。」","tok":[["命","いのち"],["を"],["落とした","おとした"],["罪人","ざいにん"],["たち"],["の"],["香炉","こうろ"],["を"],["打ち","うち"],["延ばして","のばして"],["板金","ばんきん"],["に"],["し"],["、"],["祭壇","さいだん"],["の"],["覆い","おおい"],["を"],["作り","つくり"],["なさい"],["。"],["それ"],["ら"],["は"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["ささげられ"],["、"],["聖","せい"],["なる"],["もの"],["と"],["されて"],["いる"],["から"],["で"],["ある"],["。"],["これ"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["対する","たいする"],["警告","けいこく"],["の"],["しるし"],["と"],["なるで"],["あろう"],["。"],["」"]]},{"verse":4,"text":"祭司エルアザルは、焼き殺された人々がささげた青銅の香炉を集め、打ち延ばして板金にし祭壇の覆いを作った。","tok":[["祭司","さいし"],["エルアザル"],["は"],["、"],["焼き殺された","やきころされた"],["人々","ひとびと"],["が"],["ささげた"],["青銅","せいどう"],["の"],["香炉","こうろ"],["を"],["集め","あつめ"],["、"],["打ち","うち"],["延ばして","のばして"],["板金","ばんきん"],["に"],["し"],["祭壇","さいだん"],["の"],["覆い","おおい"],["を"],["作った","つくった"],["。"]]},{"verse":5,"text":"これは、アロンの子孫以外の者が主の御前に近づき、香をささげてはならないことをイスラエルの人々に思い起こさせるためであり、コラとその仲間のようにならないためであった。それは、モーセを通してエルアザルに語られた主の言葉どおり作られた。","tok":[["これ"],["は"],["、"],["アロン"],["の"],["子孫","しそん"],["以外","いがい"],["の"],["者","もの"],["が"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["近づき","ちかづき"],["、"],["香","こう"],["を"],["ささげて"],["は"],["ならない"],["こと"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["思い起こさせる","おもいおこさせる"],["ため"],["で"],["あり"],["、"],["コラ"],["と"],["その"],["仲間","なかま"],["の"],["よう"],["に"],["ならない"],["ため"],["で"],["あった"],["。"],["それ"],["は"],["、"],["モーセ"],["を"],["通して","とおして"],["エルアザル"],["に"],["語られた","かたられた"],["主","ぬし"],["の"],["言葉","ことば"],["どおり"],["作られた","つくられた"],["。"]]},{"verse":6,"text":"その翌日、イスラエルの人々の共同体全体は、モーセとアロンに逆らって、「あなたたちは主の民を殺してしまったではないか」と不平を言った。","tok":[["その"],["翌日","よくじつ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["、"],["モーセ"],["と"],["アロン"],["に"],["逆らって","さからって"],["、"],["「"],["あなた"],["たち"],["は"],["主","ぬし"],["の"],["民","たみ"],["を"],["殺して","ころして"],["しまったで"],["は"],["ない"],["か"],["」"],["と"],["不平","ふへい"],["を"],["言った","いった"],["。"]]},{"verse":7,"text":"彼らがモーセとアロンに逆らって集結し、臨在の幕屋の方を向くと、見よ、雲がそれを覆い、主の栄光が現れていた。","tok":[["彼","かれ"],["ら"],["が"],["モーセ"],["と"],["アロン"],["に"],["逆らって","さからって"],["集結","しゅうけつ"],["し"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["方","ほう"],["を"],["向く","むく"],["と"],["、"],["見よ","みよ"],["、"],["雲","くも"],["が"],["それ"],["を"],["覆い","おおい"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["現れて","あらわれて"],["いた"],["。"]]},{"verse":8,"text":"モーセとアロンが臨在の幕屋の前に進み出ると、","tok":[["モーセ"],["と"],["アロン"],["が"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["に"],["進み出る","すすみでる"],["と"],["、"]]},{"verse":9,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":10,"text":"「この共同体から離れなさい。わたしは直ちに彼らを滅ぼす。」二人はひれ伏した。","tok":[["「"],["この"],["共同体","きょうどうたい"],["から"],["離れ","はなれ"],["なさい"],["。"],["わたし"],["は"],["直ちに","ただちに"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["。"],["」"],["二人","ふたり"],["は"],["ひれ伏した","ひれふした"],["。"]]},{"verse":11,"text":"モーセはアロンに言った。「香炉を取り、それに祭壇の火を入れ、香を載せ、急いで共同体のもとに行って、彼らのために罪を贖う儀式を行いなさい。主の御前から怒りが出て、もう疫病が始まっている。」","tok":[["モーセ"],["は"],["アロン"],["に"],["言った","いった"],["。"],["「"],["香炉","こうろ"],["を"],["取り","とり"],["、"],["それ"],["に"],["祭壇","さいだん"],["の"],["火","ひ"],["を"],["入れ","いれ"],["、"],["香","こう"],["を"],["載せ","のせ"],["、"],["急いで","いそいで"],["共同体","きょうどうたい"],["の"],["もと"],["に"],["行って","いって"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["罪","つみ"],["を"],["贖う","あがなう"],["儀式","ぎしき"],["を"],["行い","おこない"],["なさい"],["。"],["主","ぬし"],["の"],["御前","ごぜん"],["から"],["怒り","いかり"],["が"],["出て","でて"],["、"],["もう"],["疫病","やくびょう"],["が"],["始まって","はじまって"],["いる"],["。"],["」"]]},{"verse":12,"text":"アロンは、モーセの命令どおりに行い、集結している人々の中へ走って行った。疫病は既に民の間に広がり始めていた。アロンが香をたき、民のために罪を贖う儀式を行い、","tok":[["アロン"],["は"],["、"],["モーセ"],["の"],["命令","めいれい"],["どおり"],["に"],["行い","おこない"],["、"],["集結","しゅうけつ"],["して"],["いる"],["人々","ひとびと"],["の"],["中","なか"],["へ"],["走って","はしって"],["行った","いった"],["。"],["疫病","やくびょう"],["は"],["既に","すでに"],["民","たみ"],["の"],["間","あいだ"],["に"],["広がり","ひろがり"],["始めて","はじめて"],["いた"],["。"],["アロン"],["が"],["香","こう"],["を"],["たき"],["、"],["民","みん"],["の"],["ため"],["に"],["罪","つみ"],["を"],["贖う","あがなう"],["儀式","ぎしき"],["を"],["行い","おこない"],["、"]]},{"verse":13,"text":"死んだ者と生きている者との間に立つと、災害は治まった。","tok":[["死んだ","しんだ"],["者","もの"],["と"],["生きて","いきて"],["いる"],["者","もの"],["と"],["の"],["間","あいだ"],["に"],["立つ","たつ"],["と"],["、"],["災害","さいがい"],["は"],["治まった","おさまった"],["。"]]},{"verse":14,"text":"この災害による死者の数は一万四千七百人であった。コラの事件による死者はこの数に含まれていない。","tok":[["この"],["災害","さいがい"],["に"],["よる"],["死者","ししゃ"],["の"],["数","かず"],["は"],["一万四千七百","いちまんよんせんななひゃく"],["人","にん"],["で"],["あった"],["。"],["コラ"],["の"],["事件","じけん"],["に"],["よる"],["死者","ししゃ"],["は"],["この"],["数","かず"],["に"],["含まれて","ふくまれて"],["いない"],["。"]]},{"verse":15,"text":"アロンは臨在の幕屋の入り口にいるモーセのもとに帰った。災害はこうして治まった。","tok":[["アロン"],["は"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["いる"],["モーセ"],["の"],["もと"],["に"],["帰った","かえった"],["。"],["災害","さいがい"],["は"],["こう"],["して"],["治まった","おさまった"],["。"]]},{"verse":16,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":17,"text":"イスラエルの人々にこう告げなさい。彼らのうちから、父祖の家ごとに杖を一本ずつ取りなさい。すなわち、彼らの父祖の家の指導者すべてから十二本の杖を取り、その杖におのおのの名前を書き記し、","tok":[["イスラエル"],["の"],["人々","ひとびと"],["に"],["こう"],["告げ","つげ"],["なさい"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["から"],["、"],["父祖","ふそ"],["の"],["家","いえ"],["ごと"],["に"],["杖","つえ"],["を"],["一本","いちぽん"],["ずつ"],["取り","とり"],["なさい"],["。"],["すなわち"],["、"],["彼","かれ"],["ら"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["指導者","しどうしゃ"],["すべて"],["から"],["十二本"
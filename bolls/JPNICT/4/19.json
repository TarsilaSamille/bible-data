[{"verse":1,"text":"主はモーセとアロンに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":2,"text":"主の命じる教えの規定は次のとおりである。イスラエルの人々に告げて、まだ背に軛を負ったことがなく、無傷で、欠陥のない赤毛の雌牛を連れて来させなさい。","tok":[["主","ぬし"],["の"],["命じる","めいじる"],["教え","おしえ"],["の"],["規定","きてい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告げて","つげて"],["、"],["まだ"],["背","せ"],["に"],["軛","くびき"],["を"],["負った","おった"],["こと"],["が"],["なく"],["、"],["無傷","むきず"],["で"],["、"],["欠陥","けっかん"],["の"],["ない"],["赤毛","あかげ"],["の"],["雌牛","めうし"],["を"],["連れて","つれて"],["来させ","きさせ"],["なさい"],["。"]]},{"verse":3,"text":"それを祭司エルアザルに引き渡し、宿営の外に引き出して彼の前で屠る。","tok":[["それ"],["を"],["祭司","さいし"],["エルアザル"],["に"],["引き渡し","ひきわたし"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["引き出して","ひきだして"],["彼","かれ"],["の"],["前","まえ"],["で"],["屠る","ほふる"],["。"]]},{"verse":4,"text":"祭司エルアザルは、指でその血を取って、それを七度、臨在の幕屋の正面に向かって振りまく。","tok":[["祭司","さいし"],["エルアザル"],["は"],["、"],["指","ゆび"],["で"],["その"],["血","ち"],["を"],["取って","とって"],["、"],["それ"],["を"],["七","しち"],["度","ど"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["正面","しょうめん"],["に"],["向かって","むかって"],["振りまく","ふりまく"],["。"]]},{"verse":5,"text":"そして、彼の目の前でその雌牛を焼く。皮も肉も血も胃の中身も共に焼かねばならない。","tok":[["そして"],["、"],["彼","かれ"],["の"],["目","め"],["の"],["前","まえ"],["で"],["その"],["雌牛","めうし"],["を"],["焼く","やく"],["。"],["皮","かわ"],["も"],["肉","にく"],["も"],["血","ち"],["も"],["胃","い"],["の"],["中身","なかみ"],["も"],["共","とも"],["に"],["焼かねば","やかねば"],["ならない"],["。"]]},{"verse":6,"text":"祭司は、杉の枝、ヒソプ、緋糸を取って、雌牛を焼いている火の中に投げ込む。","tok":[["祭司","さいし"],["は"],["、"],["杉","すぎ"],["の"],["枝","えだ"],["、"],["ヒソプ"],["、"],["緋","ひ"],["糸","いと"],["を"],["取って","とって"],["、"],["雌牛","めうし"],["を"],["焼いて","やいて"],["いる"],["火","ひ"],["の"],["中","なか"],["に"],["投げ込む","なげこむ"],["。"]]},{"verse":7,"text":"祭司は自分の衣服を洗い、体に水を浴びた後、宿営に入ることができる。しかし、祭司は夕方まで汚れている。","tok":[["祭司","さいし"],["は"],["自分","じぶん"],["の"],["衣服","いふく"],["を"],["洗い","あらい"],["、"],["体","からだ"],["に"],["水","みず"],["を"],["浴びた","あびた"],["後","あと"],["、"],["宿営","しゅくえい"],["に"],["入る","はいる"],["こと"],["が"],["できる"],["。"],["しかし"],["、"],["祭司","さいし"],["は"],["夕方","ゆうがた"],["まで"],["汚れて","よごれて"],["いる"],["。"]]},{"verse":8,"text":"雌牛を焼いた者も、自分の衣服を水洗いし、体に水を浴びる。彼は夕方まで汚れている。","tok":[["雌牛","めうし"],["を"],["焼いた","やいた"],["者","もの"],["も"],["、"],["自分","じぶん"],["の"],["衣服","いふく"],["を"],["水洗い","みずあらい"],["し"],["、"],["体","からだ"],["に"],["水","みず"],["を"],["浴びる","あびる"],["。"],["彼","かれ"],["は"],["夕方","ゆうがた"],["まで"],["汚れて","よごれて"],["いる"],["。"]]},{"verse":9,"text":"それから、身の清い人が雌牛の灰を集め、宿営の外の清い所に置く。それは、イスラエルの人々の共同体のために罪を清める水を作るために保存される。","tok":[["それ"],["から"],["、"],["身","み"],["の"],["清い","きよい"],["人","ひと"],["が"],["雌牛","めうし"],["の"],["灰","はい"],["を"],["集め","あつめ"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["の"],["清い","きよい"],["所","ところ"],["に"],["置く","おく"],["。"],["それ"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["の"],["ため"],["に"],["罪","つみ"],["を"],["清める","きよめる"],["水","みず"],["を"],["作る","つくる"],["ため"],["に"],["保存","ほぞん"],["される"],["。"]]},{"verse":10,"text":"雌牛の灰を集めた者は自分の衣服を洗う。彼は夕方まで汚れている。これは、イスラエルの人々にとっても、彼らのもとに寄留する者にとっても不変の定めである。","tok":[["雌牛","めうし"],["の"],["灰","はい"],["を"],["集めた","あつめた"],["者","もの"],["は"],["自分","じぶん"],["の"],["衣服","いふく"],["を"],["洗う","あらう"],["。"],["彼","かれ"],["は"],["夕方","ゆうがた"],["まで"],["汚れて","よごれて"],["いる"],["。"],["これ"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["にとって"],["も"],["、"],["彼","かれ"],["ら"],["の"],["もと"],["に"],["寄留","きりゅう"],["する"],["者","もの"],["にとって"],["も"],["不変","ふへん"],["の"],["定め","さだめ"],["で"],["ある"],["。"]]},{"verse":11,"text":"どのような人の死体であれ、それに触れた者は七日の間汚れる。","tok":[["どのような"],["人","ひと"],["の"],["死体","したい"],["で"],["あれ"],["、"],["それ"],["に"],["触れた","ふれた"],["者","もの"],["は"],["七日","ななか"],["の"],["間","あいだ"],["汚れる","よごれる"],["。"]]},{"verse":12,"text":"彼が三日目と七日目に罪を清める水で身を清めるならば、清くなる。しかし、もし、三日目と七日目に身を清めないならば、清くならない。","tok":[["彼","かれ"],["が"],["三日目","みっかめ"],["と"],["七日目","ななかめ"],["に"],["罪","つみ"],["を"],["清める","きよめる"],["水","みず"],["で"],["身","み"],["を"],["清めるならば","きよめるならば"],["、"],["清く","きよく"],["なる"],["。"],["しかし"],["、"],["もし"],["、"],["三日目","みっかめ"],["と"],["七日目","ななかめ"],["に"],["身","み"],["を"],["清めないならば","きよめないならば"],["、"],["清く","きよく"],["ならない"],["。"]]},{"verse":13,"text":"すべて、死者の体に触れて身を清めない者は、主の幕屋を汚す。その者はイスラエルから断たれる。清めの水が彼の上に振りかけられないので、彼は汚れており、汚れがなお、その身のうちにとどまっているからである。","tok":[["すべて"],["、"],["死者","ししゃ"],["の"],["体","からだ"],["に"],["触れて","ふれて"],["身","み"],["を"],["清めない","きよめない"],["者","もの"],["は"],["、"],["主","ぬし"],["の"],["幕屋","まくや"],["を"],["汚す","よごす"],["。"],["その"],["者","もの"],["は"],["イスラエル"],["から"],["断たれる","たたれる"],["。"],["清め","きよめ"],["の"],["水","みず"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["振りかけられない","ふりかけられない"],["ので"],["、"],["彼","かれ"],["は"],["汚れて","よごれて"],["おり"],["、"],["汚れ","よごれ"],["が"],["なお"],["、"],["その"],["身","み"],["の"],["うち"],["に"],["とどまって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"人が天幕の中で死んだときの教えは次のとおりである。そのとき天幕に入った者、あるいはその中にいた者はすべて、七日の間汚れる。","tok":[["人","ひと"],["が"],["天幕","てんまく"],["の"],["中","なか"],["で"],["死んだ","しんだ"],["とき"],["の"],["教え","おしえ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["その"],["とき"],["天幕","てんまく"],["に"],["入った","はいった"],["者","もの"],["、"],["あるいは"],["その"],["中","なか"],["に"],["いた"],["者","もの"],["は"],["すべて"],["、"],["七日","ななか"],["の"],["間","あいだ"],["汚れる","よごれる"],["。"]]},{"verse":15,"text":"また、蓋をしていなかった、開いた容器もすべて汚れる。","tok":[["また"],["、"],["蓋","ふた"],["を"],["して"],["いなかった"],["、"],["開いた","ひらいた"],["容器","ようき"],["も"],["すべて"],["汚れる","よごれる"],["。"]]},{"verse":16,"text":"野外で剣で殺された者や死体、人骨や墓に触れた者はすべて、七日の間汚れる。","tok":[["野外","やがい"],["で"],["剣","けん"],["で"],["殺された","ころされた"],["者","もの"],["や"],["死体","したい"],["、"],["人骨","じんこつ"],["や"],["墓","はか"],["に"],["触れた","ふれた"],["者","もの"],["は"],["すべて"],["、"],["七日","ななか"],["の"],["間","あいだ"],["汚れる","よごれる"],["。"]]},{"verse":17,"text":"それらの汚れたもののためには、罪の清めのために焼いた雌牛の灰の一部を取って容器に入れ、それに新鮮な水を加える。","tok":[["それ"],["ら"],["の"],["汚れた","よごれた"],["もの"],["の"],["ため"],["に"],["は"],["、"],["罪","つみ"],["の"],["清め","きよめ"],["の"],["ため"],["に"],["焼いた","やいた"],["雌牛","めうし"],["の"],["灰","はい"],["の"],["一部","いちぶ"],["を"],["取って","とって"],["容器","ようき"],["に"],["入れ","いれ"],["、"],["それ"],["に"],["新鮮","しんせん"],["な"],["水","みず"],["を"],["加える","くわえる"],["。"]]},{"verse":18,"text":"身の清い人がヒソプを取ってその水に浸し、天幕とすべての容器およびそこにいた人々に振りかける。更に、人骨、殺された者、死体あるいは墓に触れた者に振りかける。","tok":[["身","み"],["の"],["清い","きよい"],["人","ひと"],["が"],["ヒソプ"],["を"],["取って","とって"],["その"],["水","みず"],["に"],["浸し","ひたし"],["、"],["天幕","てんまく"],["と"],["すべて"],["の"],["容器","ようき"],["および"],["そこ"],["に"],["いた"],["人々","ひとびと"],["に"],["振りかける","ふりかける"],["。"],["更に","さらに"],["、"],["人骨","じんこつ"],["、"],["殺された","ころされた"],["者","もの"],["、"],["死体","したい"],["あるいは"],["墓","はか"],["に"],["触れた","ふれた"],["者","もの"],["に"],["振りかける","ふりかける"],["。"]]},{"verse":19,"text":"三日目と七日目に、身の清い人が汚れた者に振りかける。汚れた者は、七日目に身を清め、衣服を洗い、体に水を浴びると、夕方には清くなる。","tok":[["三日目","みっかめ"],["と"],["七日目","ななかめ"],["に"],["、"],["身","み"],["の"],["清い","きよい"],["人","ひと"],["が"],["汚れた","よごれた"],["者","もの"],["に"],["振りかける","ふりかける"],["。"],["汚れた","よごれた"],["者","もの"],["は"],["、"],["七日目","ななかめ"],["に"],["身","み"],["を"],["清め","きよめ"],["、"],["衣服","いふく"],["を"],["洗い","あらい"],["、"],["体","からだ"],["に"],["水","みず"],["を"],["浴びる","あびる"],["と"],["、"],["夕方","ゆうがた"],["に"],["は"],["清く","きよく"],["なる"],["。"]]},{"verse":20,"text":"しかし、汚れた者で、身を清めない者は、会衆の中から断たれる。主の聖所を汚したからである。清めの水が彼の上に振りかけられなかったので、彼は汚れている。","tok":[["しかし"],["、"],["汚れた","よごれた"],["者","もの"],["で"],["、"],["身","み"],["を"],["清めない","きよめない"],["者","もの"],["は"],["、"],["会衆","かいしゅう"],["の"],["中","なか"],["から"],["断たれる","たたれる"],["。"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚した","よごした"],["から"],["で"],["ある"],["。"],["清め","きよめ"],["の"],["水","みず"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["振りかけられなかった","ふりかけられなかった"],["ので"],["、"],["彼","かれ"],["は"],["汚れて","よごれて"],["いる"],["。"]]},{"verse":21,"text":"これは、彼らの守るべき不変の定めである。清めの水を振りかける人は自分の衣服を洗う。清めの水に触れた者は夕方まで汚れる。","tok":[["これ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["守るべき","まもるべき"],["不変","ふへん"],["の"],["定め","さだめ"],["で"],["ある"],["。"],["清め","きよめ"],["の"],["水","みず"],["を"],["振りかける","ふりかける"],["人","ひと"],["は"],["自分","じぶん"],["の"],["衣服","いふく"],["を"],["洗う","あらう"],["。"],["清め","きよめ"],["の"],["水","みず"],["に"],["触れた","ふれた"],["者","もの"],["は"],["夕方","ゆうがた"],["まで"],["汚れる","よごれる"],["。"]]},{"verse":22,"text":"汚れた者が触れるものはすべて汚れる。またそれに触れる者も夕方まで汚れる。","tok":[["汚れた","よごれた"],["者","もの"],["が"],["触れる","ふれる"],["もの"],["は"],["すべて"],["汚れる","よごれる"],["。"],["また"],["それ"],["に"],["触れる","ふれる"],["者","もの"],["も"],["夕方","ゆうがた"],["まで"],["汚れる","よごれる"],["。"]]}]
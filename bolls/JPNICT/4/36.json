[{"verse":1,"text":"ヨセフの子孫の氏族のうち、マナセの孫で、マキルの子であるギレアドの子孫の家長たちが進み出て、モーセとイスラエルの人々の家長である指導者たちに訴えた。","tok":[["ヨセフ"],["の"],["子孫","しそん"],["の"],["氏族","しぞく"],["の"],["うち"],["、"],["マナセ"],["の"],["孫","まご"],["で"],["、"],["マキル"],["の"],["子","こ"],["で"],["ある"],["ギレアド"],["の"],["子孫","しそん"],["の"],["家長","かちょう"],["たち"],["が"],["進み出て","すすみでて"],["、"],["モーセ"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["家長","かちょう"],["で"],["ある"],["指導者","しどうしゃ"],["たち"],["に"],["訴えた","うったえた"],["。"]]},{"verse":2,"text":"「主はくじにより、土地を嗣業の土地としてイスラエルの人々に与えるように、わが主よ、あなたにお命じになり、わが主は、わたしたちの親族ツェロフハドの嗣業の土地をその娘たちに与えるように、主から命じられました。","tok":[["「"],["主","ぬし"],["は"],["くじ"],["に"],["より"],["、"],["土地","とち"],["を"],["嗣業","しぎょう"],["の"],["土地","とち"],["として"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与える","あたえる"],["よう"],["に"],["、"],["わが"],["主","ぬし"],["よ"],["、"],["あなた"],["に"],["お命じ","おめいじ"],["に"],["なり"],["、"],["わが"],["主","ぬし"],["は"],["、"],["わたしたち"],["の"],["親族","しんぞく"],["ツェロフハド"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["その"],["娘","むすめ"],["たち"],["に"],["与える","あたえる"],["よう"],["に"],["、"],["主","ぬし"],["から"],["命じられました","めいじられました"],["。"]]},{"verse":3,"text":"もしその娘たちが他の部族のイスラエル人のだれかと結婚するとしますと、娘たちの嗣業の土地はわたしたちの先祖の嗣業の土地から削られ、嫁いだ先の部族の嗣業の土地に加えられることになり、それは、くじによって割り当てられたわたしたちの嗣業の土地から削られてしまいます。","tok":[["もし"],["その"],["娘","むすめ"],["たち"],["が"],["他","ほか"],["の"],["部族","ぶぞく"],["の"],["イスラエル"],["人","にん"],["の"],["だれ"],["か"],["と"],["結婚","けっこん"],["する"],["と"],["します"],["と"],["、"],["娘","むすめ"],["たち"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["は"],["わたしたち"],["の"],["先祖","せんぞ"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["から"],["削られ","けずられ"],["、"],["嫁いだ","とついだ"],["先","さき"],["の"],["部族","ぶぞく"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["に"],["加えられる","くわえられる"],["こと"],["に"],["なり"],["、"],["それ"],["は"],["、"],["くじ"],["によって"],["割り当てられた","わりあてられた"],["わたしたち"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["から"],["削られて","けずられて"],["しまいます"],["。"]]},{"verse":4,"text":"イスラエルの人々にヨベルの年が訪れると、娘たちの嗣業の土地は嫁いだ先の部族の嗣業の土地に加えられ、その娘たちの嗣業の土地はわたしたちの父祖以来の部族の嗣業の土地から削られてしまいます。」","tok":[["イスラエル"],["の"],["人々","ひとびと"],["に"],["ヨベル"],["の"],["年","とし"],["が"],["訪れる","おとずれる"],["と"],["、"],["娘","むすめ"],["たち"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["は"],["嫁いだ","とついだ"],["先","さき"],["の"],["部族","ぶぞく"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["に"],["加えられ","くわえられ"],["、"],["その"],["娘","むすめ"],["たち"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["は"],["わたしたち"],["の"],["父祖","ふそ"],["以来","いらい"],["の"],["部族","ぶぞく"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["から"],["削られて","けずられて"],["しまいます"],["。"],["」"]]},{"verse":5,"text":"モーセは、主の命令に従ってイスラエルの人々に命じた。「ヨセフの子孫の部族の言うところはもっともである。","tok":[["モーセ"],["は"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["に"],["従って","したがって"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じた","めいじた"],["。"],["「"],["ヨセフ"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["の"],["言う","いう"],["ところ"],["は"],["もっとも"],["で"],["ある"],["。"]]},{"verse":6,"text":"ツェロフハドの娘たちについて、主がお命じになったことはこうである。娘たちは自分を気に入ってくれた男と結婚してよい。ただ、父方の部族の一族の者とだけ結婚できる。","tok":[["ツェロフハド"],["の"],["娘","むすめ"],["たち"],["について"],["、"],["主","ぬし"],["が"],["お命じ","おめいじ"],["に"],["なった"],["こと"],["は"],["こう"],["で"],["ある"],["。"],["娘","むすめ"],["たち"],["は"],["自分","じぶん"],["を"],["気","き"],["に"],["入って","いって"],["くれた"],["男","おとこ"],["と"],["結婚","けっこん"],["して"],["よい"],["。"],["ただ"],["、"],["父方","ちちかた"],["の"],["部族","ぶぞく"],["の"],["一族","いちぞく"],["の"],["者","もの"],["と"],["だけ"],["結婚","けっこん"],["できる"],["。"]]},{"verse":7,"text":"イスラエルの人々の嗣業の土地が一つの部族から他の部族に移ることはなく、イスラエルの人々はそれぞれ、父祖以来の部族の嗣業の土地を固く守っていかなければならない。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["が"],["一","ひと"],["つ"],["の"],["部族","ぶぞく"],["から"],["他","ほか"],["の"],["部族","ぶぞく"],["に"],["移る","うつる"],["こと"],["は"],["なく"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["それぞれ"],["、"],["父祖","ふそ"],["以来","いらい"],["の"],["部族","ぶぞく"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["固く","かたく"],["守って","まもって"],["いかなければ"],["ならない"],["。"]]},{"verse":8,"text":"イスラエルの人々の諸部族の中で、嗣業の土地を相続している娘はだれでも、父方の部族の一族の男と結婚しなければならない。それにより、イスラエルの人々はそれぞれ、父祖伝来の嗣業の土地を相続することができる。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["諸","しょ"],["部族","ぶぞく"],["の"],["中","なか"],["で"],["、"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["相続","そうぞく"],["して"],["いる"],["娘","むすめ"],["は"],["だれ"],["で"],["も"],["、"],["父方","ちちかた"],["の"],["部族","ぶぞく"],["の"],["一族","いちぞく"],["の"],["男","おとこ"],["と"],["結婚","けっこん"],["しなければ"],["ならない"],["。"],["それ"],["に"],["より"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["それぞれ"],["、"],["父祖","ふそ"],["伝来","でんらい"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["相続","そうぞく"],["する"],["こと"],["が"],["できる"],["。"]]},{"verse":9,"text":"嗣業の土地が一つの部族から他の部族に移ることはないであろう。イスラエルの人々の諸部族はそれぞれ、自分の嗣業の土地を固く守ることができよう。」","tok":[["嗣業","しぎょう"],["の"],["土地","とち"],["が"],["一","ひと"],["つ"],["の"],["部族","ぶぞく"],["から"],["他","ほか"],["の"],["部族","ぶぞく"],["に"],["移る","うつる"],["こと"],["は"],["ないで"],["あろう"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["諸","しょ"],["部族","ぶぞく"],["は"],["それぞれ"],["、"],["自分","じぶん"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["固く","かたく"],["守る","まもる"],["こと"],["が"],["できよう"],["。"],["」"]]},{"verse":10,"text":"ツェロフハド家の娘たちは、主がモーセに命じられたとおりにした。","tok":[["ツェロフハド"],["家","か"],["の"],["娘","むすめ"],["たち"],["は"],["、"],["主","ぬし"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"]]},{"verse":11,"text":"ツェロフハドの娘たち、マフラ、ティルツァ、ホグラ、ミルカ、およびノアは、おじの息子たちと結婚した。","tok":[["ツェロフハド"],["の"],["娘","むすめ"],["たち"],["、"],["マフラ"],["、"],["ティルツァ"],["、"],["ホグラ"],["、"],["ミルカ"],["、"],["および"],["ノア"],["は"],["、"],["おじ"],["の"],["息子","むすこ"],["たち"],["と"],["結婚","けっこん"],["した"],["。"]]},{"verse":12,"text":"彼女たちがヨセフの子マナセを祖とする氏族の者と結婚したので、その嗣業の土地は、父の一族の属する部族に残った。","tok":[["彼女","かのじょ"],["たち"],["が"],["ヨセフ"],["の"],["子","こ"],["マナセ"],["を"],["祖","そ"],["と"],["する"],["氏族","しぞく"],["の"],["者","もの"],["と"],["結婚","けっこん"],["した"],["ので"],["、"],["その"],["嗣業","しぎょう"],["の"],["土地","とち"],["は"],["、"],["父","ちち"],["の"],["一族","いちぞく"],["の"],["属する","ぞくする"],["部族","ぶぞく"],["に"],["残った","のこった"],["。"]]},{"verse":13,"text":"以上は、エリコに近いヨルダン川の対岸にあるモアブの平野で、主がモーセを通してイスラエルの人々に命じられた命令と法である。","tok":[["以上","いじょう"],["は"],["、"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["川","かわ"],["の"],["対岸","たいがん"],["に"],["ある"],["モアブ"],["の"],["平野","へいや"],["で"],["、"],["主","ぬし"],["が"],["モーセ"],["を"],["通して","とおして"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じられた","めいじられた"],["命令","めいれい"],["と"],["法","ほう"],["で"],["ある"],["。"]]}]
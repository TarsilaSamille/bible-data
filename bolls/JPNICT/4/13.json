[{"verse":1,"text":"主はモーセに言われた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"]]},{"verse":2,"text":"「人を遣わして、わたしがイスラエルの人々に与えようとしているカナンの土地を偵察させなさい。父祖以来の部族ごとに一人ずつ、それぞれ、指導者を遣わさねばならない。」","tok":[["「"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与えよう","あたえよう"],["として"],["いる"],["カナン"],["の"],["土地","とち"],["を"],["偵察","ていさつ"],["させ"],["なさい"],["。"],["父祖","ふそ"],["以来","いらい"],["の"],["部族","ぶぞく"],["ごと"],["に"],["一人","ひとり"],["ずつ"],["、"],["それぞれ"],["、"],["指導者","しどうしゃ"],["を"],["遣わさねば","つかわさねば"],["ならない"],["。"],["」"]]},{"verse":3,"text":"モーセは主の命令に従い、パランの荒れ野から彼らを遣わした。彼らは皆、イスラエルの人々の長である人々であった。","tok":[["モーセ"],["は"],["主","ぬし"],["の"],["命令","めいれい"],["に"],["従い","したがい"],["、"],["パラン"],["の"],["荒れ野","あれの"],["から"],["彼","かれ"],["ら"],["を"],["遣わした","つかわした"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["長","ちょう"],["で"],["ある"],["人々","ひとびと"],["で"],["あった"],["。"]]},{"verse":4,"text":"その名は次のとおりである。ルベン族では、ザクルの子シャムア、","tok":[["その"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ルベン族","るべんぞく"],["で"],["は"],["、"],["ザクル"],["の"],["子","こ"],["シャムア"],["、"]]},{"verse":5,"text":"シメオン族では、ホリの子シャファト、","tok":[["シメオン"],["族","ぞく"],["で"],["は"],["、"],["ホリ"],["の"],["子","こ"],["シャファト"],["、"]]},{"verse":6,"text":"ユダ族では、エフネの子カレブ、","tok":[["ユダ族","ゆだぞく"],["で"],["は"],["、"],["エフネ"],["の"],["子","こ"],["カレブ"],["、"]]},{"verse":7,"text":"イサカル族では、ヨセフの子イグアル、","tok":[["イサカル"],["族","ぞく"],["で"],["は"],["、"],["ヨセフ"],["の"],["子","こ"],["イグアル"],["、"]]},{"verse":8,"text":"エフライム族では、ヌンの子ホシェア、","tok":[["エフライム"],["族","ぞく"],["で"],["は"],["、"],["ヌン"],["の"],["子","こ"],["ホシェア"],["、"]]},{"verse":9,"text":"ベニヤミン族では、ラフの子パルティ、","tok":[["ベニヤミン"],["族","ぞく"],["で"],["は"],["、"],["ラフ"],["の"],["子","こ"],["パルティ"],["、"]]},{"verse":10,"text":"ゼブルン族では、ソディの子ガディエル、","tok":[["ゼブルン"],["族","ぞく"],["で"],["は"],["、"],["ソディ"],["の"],["子","こ"],["ガディエル"],["、"]]},{"verse":11,"text":"ヨセフ族すなわちマナセ族では、スシの子ガディ、","tok":[["ヨセフ族","よせふぞく"],["すなわち"],["マナセ族","まなせぞく"],["で"],["は"],["、"],["スシ"],["の"],["子","こ"],["ガディ"],["、"]]},{"verse":12,"text":"ダン族では、ゲマリの子アミエル、","tok":[["ダン族","だんぞく"],["で"],["は"],["、"],["ゲマリ"],["の"],["子","こ"],["アミエル"],["、"]]},{"verse":13,"text":"アシェル族では、ミカエルの子セトル、","tok":[["アシェル"],["族","ぞく"],["で"],["は"],["、"],["ミカエル"],["の"],["子","こ"],["セトル"],["、"]]},{"verse":14,"text":"ナフタリ族では、ボフシの子ナフビ、","tok":[["ナフタリ"],["族","ぞく"],["で"],["は"],["、"],["ボフシ"],["の"],["子","こ"],["ナフビ"],["、"]]},{"verse":15,"text":"ガド族では、マキの子ゲウエル。","tok":[["ガド族","がどぞく"],["で"],["は"],["、"],["マキ"],["の"],["子","こ"],["ゲウエル"],["。"]]},{"verse":16,"text":"以上は、モーセがその土地の偵察に遣わした人々の名である。モーセは、ヌンの子ホシェアをヨシュアと呼んだ。","tok":[["以上","いじょう"],["は"],["、"],["モーセ"],["が"],["その"],["土地","とち"],["の"],["偵察","ていさつ"],["に"],["遣わした","つかわした"],["人々","ひとびと"],["の"],["名","な"],["で"],["ある"],["。"],["モーセ"],["は"],["、"],["ヌン"],["の"],["子","こ"],["ホシェア"],["を"],["ヨシュア"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":17,"text":"モーセは、彼らをカナンの土地の偵察に遣わすにあたってこう命じた。「ネゲブに上り、更に山を登って行き、","tok":[["モーセ"],["は"],["、"],["彼","かれ"],["ら"],["を"],["カナン"],["の"],["土地","とち"],["の"],["偵察","ていさつ"],["に"],["遣わす","つかわす"],["に"],["あたって"],["こう"],["命じた","めいじた"],["。"],["「"],["ネゲブ"],["に"],["上り","のぼり"],["、"],["更に","さらに"],["山","やま"],["を"],["登って","のぼって"],["行き","いき"],["、"]]},{"verse":18,"text":"その土地がどんな所か調べて来なさい。そこの住民が強いか弱いか、人数が多いか少ないか、","tok":[["その"],["土地","とち"],["が"],["どんな"],["所","ところ"],["か"],["調べて","しらべて"],["来","き"],["なさい"],["。"],["そこ"],["の"],["住民","じゅうみん"],["が"],["強い","つよい"],["か弱い","かよわい"],["か"],["、"],["人数","にんずう"],["が"],["多い","おおい"],["か"],["少ない","すくない"],["か"],["、"]]},{"verse":19,"text":"彼らの住む土地が良いか悪いか、彼らの住む町がどんな様子か、天幕を張っているのか城壁があるのか、","tok":[["彼","かれ"],["ら"],["の"],["住む","すむ"],["土地","とち"],["が"],["良い","よい"],["か"],["悪い","わるい"],["か"],["、"],["彼","かれ"],["ら"],["の"],["住む","すむ"],["町","まち"],["が"],["どんな"],["様子","ようす"],["か"],["、"],["天幕","てんまく"],["を"],["張って","はって"],["いる"],["の"],["か"],["城壁","じょうへき"],["が"],["ある"],["の"],["か"],["、"]]},{"verse":20,"text":"土地はどうか、肥えているかやせているか、木が茂っているか否かを。あなたたちは雄々しく行き、その土地の果物を取って来なさい。」それはちょうど、ぶどうの熟す時期であった。","tok":[["土地","とち"],["は"],["どう"],["か"],["、"],["肥えて","こえて"],["いる"],["か"],["やせて"],["いる"],["か"],["、"],["木","き"],["が"],["茂って","しげって"],["いる"],["か"],["否","いな"],["か"],["を"],["。"],["あなた"],["たち"],["は"],["雄々しく","おおしく"],["行き","いき"],["、"],["その"],["土地","とち"],["の"],["果物","くだもの"],["を"],["取って","とって"],["来","き"],["なさい"],["。"],["」"],["それ"],["は"],["ちょうど"],["、"],["ぶどう"],["の"],["熟す","じゅくす"],["時期","じき"],["で"],["あった"],["。"]]},{"verse":21,"text":"彼らは上って行って、ツィンの荒れ野からレボ‧ハマトに近いレホブまでの土地を偵察した。","tok":[["彼","かれ"],["ら"],["は"],["上って","のぼって"],["行って","いって"],["、"],["ツィン"],["の"],["荒れ野","あれの"],["から"],["レボ"],["‧"],["ハマト"],["に"],["近い","ちかい"],["レホブ"],["まで"],["の"],["土地","とち"],["を"],["偵察","ていさつ"],["した"],["。"]]},{"verse":22,"text":"彼らはネゲブを上って行き、ヘブロンに着いた。そこには、アナク人の子孫であるアヒマンとシェシャイとタルマイが住んでいた。ヘブロンはエジプトのツォアンよりも七年前に建てられた町である。","tok":[["彼","かれ"],["ら"],["は"],["ネゲブ"],["を"],["上って","のぼって"],["行き","いき"],["、"],["ヘブロン"],["に"],["着いた","ついた"],["。"],["そこ"],["に"],["は"],["、"],["アナク人","あなくにん"],["の"],["子孫","しそん"],["で"],["ある"],["アヒマン"],["と"],["シェシャイ"],["と"],["タルマイ"],["が"],["住んで","すんで"],["いた"],["。"],["ヘブロン"],["は"],["エジプト"],["の"],["ツォアン"],["より"],["も"],["七","なな"],["年","ねん"],["前","まえ"],["に"],["建てられた","たてられた"],["町","まち"],["で"],["ある"],["。"]]},{"verse":23,"text":"エシュコルの谷に着くと、彼らは一房のぶどうの付いた枝を切り取り、棒に下げ、二人で担いだ。また、ざくろやいちじくも取った。","tok":[["エシュコル"],["の"],["谷","たに"],["に"],["着く","つく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["一房","かずふさ"],["の"],["ぶどう"],["の"],["付いた","ついた"],["枝","えだ"],["を"],["切り取り","きりとり"],["、"],["棒","ぼう"],["に"],["下げ","さげ"],["、"],["二人","ふたり"],["で"],["担いだ","かついだ"],["。"],["また"],["、"],["ざくろ"],["や"],["いちじく"],["も"],["取った","とった"],["。"]]},{"verse":24,"text":"この場所がエシュコルの谷と呼ばれるのは、イスラエルの人々がここで一房（エシュコル）のぶどうを切り取ったからである。","tok":[["この"],["場所","ばしょ"],["が"],["エシュコル"],["の"],["谷","たに"],["と"],["呼ばれる","よばれる"],["の"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["ここ"],["で"],["一房","かずふさ"],["（"],["エシュコル"],["）"],["の"],["ぶどう"],["を"],["切り取った","きりとった"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"四十日の後、彼らは土地の偵察から帰って来た。","tok":[["四十日","よんとうか"],["の"],["後","あと"],["、"],["彼","かれ"],["ら"],["は"],["土地","とち"],["の"],["偵察","ていさつ"],["から"],["帰って","かえって"],["来た","きた"],["。"]]},{"verse":26,"text":"パランの荒れ野のカデシュにいるモーセ、アロンおよびイスラエルの人々の共同体全体のもとに来ると、彼らと共同体全体に報告をし、その土地の果物を見せた。","tok":[["パラン"],["の"],["荒れ野","あれの"],["の"],["カデシュ"],["に"],["いる"],["モーセ"],["、"],["アロン"],["および"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["もと"],["に"],["来る","くる"],["と"],["、"],["彼","かれ"],["ら"],["と"],["共同体","きょうどうたい"],["全体","ぜんたい"],["に"],["報告","ほうこく"],["を"],["し"],["、"],["その"],["土地","とち"],["の"],["果物","くだもの"],["を"],["見せた","みせた"],["。"]]},{"verse":27,"text":"彼らはモーセに説明して言った。「わたしたちは、あなたが遣わされた地方に行って来ました。そこは乳と蜜の流れる所でした。これがそこの果物です。","tok":[["彼","かれ"],["ら"],["は"],["モーセ"],["に"],["説明","せつめい"],["して"],["言った","いった"],["。"],["「"],["わたしたち"],["は"],["、"],["あなた"],["が"],["遣わされた","つかわされた"],["地方","ちほう"],["に"],["行って","いって"],["来ました","きました"],["。"],["そこ"],["は"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["所","ところ"],["でした"],["。"],["これ"],["が"],["そこ"],["の"],["果物","くだもの"],["です"],["。"]]},{"verse":28,"text":"しかし、その土地の住民は強く、町という町は城壁に囲まれ、大層大きく、しかもアナク人の子孫さえ見かけました。","tok":[["しかし"],["、"],["その"],["土地","とち"],["の"],["住民","じゅうみん"],["は"],["強く","つよく"],["、"],["町","まち"],["と"],["いう"],["町","まち"],["は"],["城壁","じょうへき"],["に"],["囲まれ","かこまれ"],["、"],["大層","たいそう"],["大きく","おおきく"],["、"],["しかも"],["アナク人","あなくにん"],["の"],["子孫","しそん"],["さえ"],["見かけました","みかけました"],["。"]]},{"verse":29,"text":"ネゲブ地方にはアマレク人、山地にはヘト人、エブス人、アモリ人、海岸地方およびヨルダン沿岸地方にはカナン人が住んでいます。」","tok":[["ネゲブ"],["地方","ちほう"],["に"],["は"],["アマレク"],["人","にん"],["、"],["山地","さんち"],["に"],["は"],["ヘト人","へとにん"],["、"],["エブス人","えぶすにん"],["、"],["アモリ人","あもりにん"],["、"],["海岸","かいがん"],["地方","ちほう"],["および"],["ヨルダン"],["沿岸","えんがん"],["地方","ちほう"],["に"],["は"],["カナン人","かなんにん"],["が"],["住んで","すんで"],["います"],["。"],["」"]]},{"verse":30,"text":"カレブは民を静め、モーセに向かって進言した。「断然上って行くべきです。そこを占領しましょう。必ず勝てます。」","tok":[["カレブ"],["は"],["民","みん"],["を"],["静め","しずめ"],["、"],["モーセ"],["に"],["向かって","むかって"],["進言","しんげん"],["した"],["。"],["「"],["断然","だんぜん"],["上って","のぼって"],["行くべきです","いくべきです"],["。"],["そこ"],["を"],["占領","せんりょう"],["しましょう"],["。"],["必ず","かならず"],["勝てます","かてます"],["。"],["」"]]},{"verse":31,"text":"しかし、彼と一緒に行った者たちは反対し、「いや、あの民に向かって上って行くのは不可能だ。彼らは我々よりも強い」と言い、","tok":[["しかし"],["、"],["彼","かれ"],["と"],["一緒","いっしょ"],["に"],["行った","いった"],["者","もの"],["たち"],["は"],["反対","はんたい"],["し"],["、"],["「"],["いや"],["、"],["あの"],["民","たみ"],["に"],["向かって","むかって"],["上って","のぼって"],["行く","いく"],["の"],["は"],["不可能","ふかのう"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["我々","われわれ"],["より"],["も"],["強い","つよい"],["」"],["と"],["言い","いい"],["、"]]},{"verse":32,"text":"イスラエルの人々の間に、偵察して来た土地について悪い情報を流した。「我々が偵察して来た土地は、そこに住み着こうとする者を食い尽くすような土地だ。我々が見た民は皆、巨人だった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["間","あいだ"],["に"],["、"],["偵察","ていさつ"],["して"],["来た","きた"],["土地","とち"],["について"],["悪い","わるい"],["情報","じょうほう"],["を"],["流した","ながした"],["。"],["「"],["我々","われわれ"],["が"],["偵察","ていさつ"],["して"],["来た","きた"],["土地","とち"],["は"],["、"],["そこ"],["に"],["住み着こう","すみつこう"],["と"],["する"],["者","もの"],["を"],["食い","くい"],["尽くす","つくす"],["よう"],["な"],["土地","とち"],["だ"],["。"],["我々","われわれ"],["が"],["見た","みた"],["民","たみ"],["は"],["皆","みな"],["、"],["巨人","きょじん"],["だった"],["。"]]},{"verse":33,"text":"そこで我々が見たのは、ネフィリムなのだ。アナク人はネフィリムの出なのだ。我々は、自分がいなごのように小さく見えたし、彼らの目にもそう見えたにちがいない。」","tok":[["そこ"],["で"],["我々","われわれ"],["が"],["見た","みた"],["の"],["は"],["、"],["ネフィリム"],["な"],["の"],["だ"],["。"],["アナク人","あなくにん"],["は"],["ネフィリム"],["の"],["出","で"],["な"],["の"],["だ"],["。"],["我々","われわれ"],["は"],["、"],["自分","じぶん"],["が"],["いなご"],["の"],["よう"],["に"],["小さく","ちいさく"],["見えた","みえた"],["し"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["に"],["も"],["そう"],["見えた","みえた"],["に"],["ちがい"],["ない"],["。"],["」"]]}]
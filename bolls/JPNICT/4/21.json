[{"verse":1,"text":"ネゲブに住むカナン人、アラドの王は、イスラエルがアタリムの道を進んで来ると聞き、イスラエルと戦い、捕虜を引いて行った。","tok":[["ネゲブ"],["に"],["住む","すむ"],["カナン人","かなんにん"],["、"],["アラド"],["の"],["王","おう"],["は"],["、"],["イスラエル"],["が"],["アタリム"],["の"],["道","みち"],["を"],["進んで","すすんで"],["来る","くる"],["と"],["聞き","きき"],["、"],["イスラエル"],["と"],["戦い","たたかい"],["、"],["捕虜","ほりょ"],["を"],["引いて","ひいて"],["行った","いった"],["。"]]},{"verse":2,"text":"イスラエルは主に誓いを立てて、「この民をわたしの手に渡してくださるならば、必ず彼らの町を絶滅させます」と言った。","tok":[["イスラエル"],["は"],["主に","おもに"],["誓い","ちかい"],["を"],["立てて","たてて"],["、"],["「"],["この"],["民","たみ"],["を"],["わたし"],["の"],["手","て"],["に"],["渡して","わたして"],["くださるならば"],["、"],["必ず","かならず"],["彼","かれ"],["ら"],["の"],["町","まち"],["を"],["絶滅","ぜつめつ"],["させます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"主はイスラエルの言葉を聞き入れ、カナン人を渡された。イスラエルは彼らとその町々を絶滅させ、そこの名をホルマ（絶滅）と呼んだ。","tok":[["主","ぬし"],["は"],["イスラエル"],["の"],["言葉","ことば"],["を"],["聞き入れ","ききいれ"],["、"],["カナン人","かなんにん"],["を"],["渡された","わたされた"],["。"],["イスラエル"],["は"],["彼","かれ"],["ら"],["と"],["その"],["町々","まちまち"],["を"],["絶滅","ぜつめつ"],["させ"],["、"],["そこ"],["の"],["名","な"],["を"],["ホルマ"],["（"],["絶滅","ぜつめつ"],["）"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":4,"text":"彼らはホル山を旅立ち、エドムの領土を迂回し、葦の海の道を通って行った。しかし、民は途中で耐えきれなくなって、","tok":[["彼","かれ"],["ら"],["は"],["ホル"],["山","やま"],["を"],["旅立ち","たびだち"],["、"],["エドム"],["の"],["領土","りょうど"],["を"],["迂回","うかい"],["し"],["、"],["葦","あし"],["の"],["海","うみ"],["の"],["道","みち"],["を"],["通って","とおって"],["行った","いった"],["。"],["しかし"],["、"],["民","みん"],["は"],["途中","とちゅう"],["で"],["耐え","たえ"],["きれなく"],["なって"],["、"]]},{"verse":5,"text":"神とモーセに逆らって言った。「なぜ、我々をエジプトから導き上ったのですか。荒れ野で死なせるためですか。パンも水もなく、こんな粗末な食物では、気力もうせてしまいます。」","tok":[["神","かみ"],["と"],["モーセ"],["に"],["逆らって","さからって"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["我々","われわれ"],["を"],["エジプト"],["から"],["導き","みちびき"],["上った","のぼった"],["の"],["です"],["か"],["。"],["荒れ野","あれの"],["で"],["死なせる","しなせる"],["ため"],["です"],["か"],["。"],["パン"],["も"],["水","みず"],["も"],["なく"],["、"],["こんな"],["粗末","そまつ"],["な"],["食物","しょくもつ"],["で"],["は"],["、"],["気力","きりょく"],["も"],["うせて"],["しまいます"],["。"],["」"]]},{"verse":6,"text":"主は炎の蛇を民に向かって送られた。蛇は民をかみ、イスラエルの民の中から多くの死者が出た。","tok":[["主","ぬし"],["は"],["炎","ほのお"],["の"],["蛇","へび"],["を"],["民","たみ"],["に"],["向かって","むかって"],["送られた","おくられた"],["。"],["蛇","へび"],["は"],["民","みん"],["を"],["かみ"],["、"],["イスラエル"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["多く","おおく"],["の"],["死者","ししゃ"],["が"],["出た","でた"],["。"]]},{"verse":7,"text":"民はモーセのもとに来て言った。「わたしたちは主とあなたを非難して、罪を犯しました。主に祈って、わたしたちから蛇を取り除いてください。」モーセは民のために主に祈った。","tok":[["民","みん"],["は"],["モーセ"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["わたしたち"],["は"],["主","ぬし"],["と"],["あなた"],["を"],["非難","ひなん"],["して"],["、"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["主に","おもに"],["祈って","いのって"],["、"],["わたしたち"],["から"],["蛇","へび"],["を"],["取り除いて","とりのぞいて"],["ください"],["。"],["」"],["モーセ"],["は"],["民","みん"],["の"],["ため"],["に"],["主","ぬし"],["に"],["祈った","いのった"],["。"]]},{"verse":8,"text":"主はモーセに言われた。「あなたは炎の蛇を造り、旗竿の先に掲げよ。蛇にかまれた者がそれを見上げれば、命を得る。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["炎","ほのお"],["の"],["蛇","へび"],["を"],["造り","つくり"],["、"],["旗竿","はたざお"],["の"],["先","さき"],["に"],["掲げ","かかげ"],["よ"],["。"],["蛇","へび"],["に"],["かまれた"],["者","もの"],["が"],["それ"],["を"],["見上げれば","みあげれば"],["、"],["命","いのち"],["を"],["得る","うる"],["。"],["」"]]},{"verse":9,"text":"モーセは青銅で一つの蛇を造り、旗竿の先に掲げた。蛇が人をかんでも、その人が青銅の蛇を仰ぐと、命を得た。","tok":[["モーセ"],["は"],["青銅","せいどう"],["で"],["一","ひと"],["つ"],["の"],["蛇","へび"],["を"],["造り","つくり"],["、"],["旗竿","はたざお"],["の"],["先","さき"],["に"],["掲げた","かかげた"],["。"],["蛇","へび"],["が"],["人","ひと"],["を"],["かん"],["で"],["も"],["、"],["その"],["人","ひと"],["が"],["青銅","せいどう"],["の"],["蛇","へび"],["を"],["仰ぐ","あおぐ"],["と"],["、"],["命","いのち"],["を"],["得た","えた"],["。"]]},{"verse":10,"text":"イスラエルの人々は旅を続け、オボトに宿営し、","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["旅","たび"],["を"],["続け","つづけ"],["、"],["オボト"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":11,"text":"オボトを旅立つと、モアブの東側の荒れ野にあるイイエ‧アバリムに宿営した。","tok":[["オボト"],["を"],["旅立つ","たびだつ"],["と"],["、"],["モアブ"],["の"],["東側","ひがしがわ"],["の"],["荒れ野","あれの"],["に"],["ある"],["イイエ"],["‧"],["アバリム"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":12,"text":"そこを旅立ってゼレドの谷に宿営し、","tok":[["そこ"],["を"],["旅立って","たびだって"],["ゼレド"],["の"],["谷","たに"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":13,"text":"更に旅を続けて、アルノン川の向こう岸に宿営した。この川はアモリ人の国境から広がる荒れ野を流れていた。アルノン川はモアブとアモリ人との国の間にあって、モアブの国境をなしている。","tok":[["更に","さらに"],["旅","たび"],["を"],["続けて","つづけて"],["、"],["アルノン"],["川","かわ"],["の"],["向こう岸","むこうぎし"],["に"],["宿営","しゅくえい"],["した"],["。"],["この"],["川","かわ"],["は"],["アモリ人","あもりにん"],["の"],["国境","こっきょう"],["から"],["広がる","ひろがる"],["荒れ野","あれの"],["を"],["流れて","ながれて"],["いた"],["。"],["アルノン"],["川","かわ"],["は"],["モアブ"],["と"],["アモリ人","あもりにん"],["と"],["の"],["国","くに"],["の"],["間","あいだ"],["に"],["あって"],["、"],["モアブ"],["の"],["国境","こっきょう"],["を"],["なして"],["いる"],["。"]]},{"verse":14,"text":"それで、『主の戦いの書』には次のように書かれている。「スファのワヘブとアルノン川の支流。","tok":[["それ"],["で"],["、"],["『"],["主","ぬし"],["の"],["戦い","たたかい"],["の"],["書","しょ"],["』"],["に"],["は"],["次","つぎ"],["の"],["よう"],["に"],["書かれて","かかれて"],["いる"],["。"],["「"],["スファ"],["の"],["ワヘブ"],["と"],["アルノン"],["川","かわ"],["の"],["支流","しりゅう"],["。"]]},{"verse":15,"text":"それらの支流はアルの定住地に流れ下り、モアブの国境に及ぶ。」","tok":[["それ"],["ら"],["の"],["支流","しりゅう"],["は"],["アル"],["の"],["定住","ていじゅう"],["地","ち"],["に"],["流れ下り","ながれくだり"],["、"],["モアブ"],["の"],["国境","こっきょう"],["に"],["及ぶ","およぶ"],["。"],["」"]]},{"verse":16,"text":"彼らはそこからベエル（井戸）に行った。これは、主がモーセに「民を集めよ、彼らに水を与えよう」と言われた井戸である。","tok":[["彼","かれ"],["ら"],["は"],["そこ"],["から"],["ベエル"],["（"],["井戸","いど"],["）"],["に"],["行った","いった"],["。"],["これ"],["は"],["、"],["主","ぬし"],["が"],["モーセ"],["に"],["「"],["民","みん"],["を"],["集めよ","あつめよ"],["、"],["彼","かれ"],["ら"],["に"],["水","みず"],["を"],["与えよう","あたえよう"],["」"],["と"],["言われた","いわれた"],["井戸","いど"],["で"],["ある"],["。"]]},{"verse":17,"text":"そのことがあったとき、イスラエルはこの歌をうたった。井戸よ、湧き上がれ井戸に向かって歌え。","tok":[["その"],["こと"],["が"],["あった"],["とき"],["、"],["イスラエル"],["は"],["この"],["歌","うた"],["を"],["うたった"],["。"],["井戸","いど"],["よ"],["、"],["湧き上がれ","わきあがれ"],["井戸","いど"],["に"],["向かって","むかって"],["歌え","うたえ"],["。"]]},{"verse":18,"text":"笏と杖とをもって司たちが井戸を掘り民の高貴な人がそれを深く掘った。彼らは荒れ野からマタナ、","tok":[["笏","しゃく"],["と"],["杖","つえ"],["と"],["を"],["もって"],["司","し"],["たち"],["が"],["井戸","いど"],["を"],["掘り","ほり"],["民","みん"],["の"],["高貴","こうき"],["な"],["人","ひと"],["が"],["それ"],["を"],["深く","ふかく"],["掘った","ほった"],["。"],["彼","かれ"],["ら"],["は"],["荒れ野","あれの"],["から"],["マタナ"],["、"]]},{"verse":19,"text":"マタナからナハリエル、ナハリエルからバモト、","tok":[["マタナ"],["から"],["ナハリエル"],["、"],["ナハリエル"],["から"],["バモト"],["、"]]},{"verse":20,"text":"バモトからモアブの野にある谷へ、そして荒れ果てた地を見下ろすピスガの頂へと進んだ。","tok":[["バモト"],["から"],["モアブ"],["の"],["野","の"],["に"],["ある"],["谷","たに"],["へ"],["、"],["そして"],["荒れ果てた","あれはてた"],["地","ち"],["を"],["見下ろす","みおろす"],["ピスガ"],["の"],["頂","いただき"],["へ"],["と"],["進んだ","すすんだ"],["。"]]},{"verse":21,"text":"イスラエルは、アモリ人の王シホンに使者を遣わして、次のように言った。","tok":[["イスラエル"],["は"],["、"],["アモリ人","あもりにん"],["の"],["王","おう"],["シホン"],["に"],["使者","ししゃ"],["を"],["遣わして","つかわして"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"]]},{"verse":22,"text":"「あなたの領内を通過させてください。道をそれて畑やぶどう畑に入ったり、井戸の水を飲んだりしません。あなたの国境を越えるまで『王の道』を通ります。」","tok":[["「"],["あなた"],["の"],["領内","りょうない"],["を"],["通過","つうか"],["させて"],["ください"],["。"],["道","みち"],["を"],["それて"],["畑","はたけ"],["や"],["ぶどう"],["畑","はたけ"],["に"],["入っ","はいっ"],["たり"],["、"],["井戸","いど"],["の"],["水","みず"],["を"],["飲ん","のん"],["だり"],["しません"],["。"],["あなた"],["の"],["国境","こっきょう"],["を"],["越える","こえる"],["まで"],["『"],["王","おう"],["の"],["道","みち"],["』"],["を"],["通ります","とおります"],["。"],["」"]]},{"verse":23,"text":"しかしシホンは、イスラエルが自分の領内を通過することを許さず、全軍を召集し、イスラエルを迎え撃つために、荒れ野にあるヤハツに軍を進め、イスラエルと戦った。","tok":[["しかし"],["シホン"],["は"],["、"],["イスラエル"],["が"],["自分","じぶん"],["の"],["領内","りょうない"],["を"],["通過","つうか"],["する"],["こと"],["を"],["許さず","ゆるさず"],["、"],["全軍","ぜんぐん"],["を"],["召集","しょうしゅう"],["し"],["、"],["イスラエル"],["を"],["迎え撃つ","むかえうつ"],["ため"],["に"],["、"],["荒れ野","あれの"],["に"],["ある"],["ヤハツ"],["に"],["軍","ぐん"],["を"],["進め","すすめ"],["、"],["イスラエル"],["と"],["戦った","たたかった"],["。"]]},{"verse":24,"text":"しかし、イスラエルは彼を剣にかけて、南はアルノン川から北はヤボク川、東はアンモン人の国境まで、その領土を占領した。アンモン人の国境は堅固であった。","tok":[["しかし"],["、"],["イスラエル"],["は"],["彼","かれ"],["を"],["剣","けん"],["に"],["かけて"],["、"],["南","みなみ"],["は"],["アルノン"],["川","かわ"],["から"],["北","きた"],["は"],["ヤボク"],["川","かわ"],["、"],["東","ひがし"],["は"],["アンモン"],["人","にん"],["の"],["国境","こっきょう"],["まで"],["、"],["その"],["領土","りょうど"],["を"],["占領","せんりょう"],["した"],["。"],["アンモン"],["人","にん"],["の"],["国境","こっきょう"],["は"],["堅固","けんご"],["で"],["あった"],["。"]]},{"verse":25,"text":"イスラエルはこうして、そのすべての町を取り、ヘシュボンとその周辺の村落など、アモリ人のすべての町に住んだ。","tok":[["イスラエル"],["は"],["こう"],["して"],["、"],["その"],["すべて"],["の"],["町","まち"],["を"],["取り","とり"],["、"],["ヘシュボン"],["と"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["など"],["、"],["アモリ人","あもりにん"],["の"],["すべて"],["の"],["町","まち"],["に"],["住んだ","すんだ"],["。"]]},{"verse":26,"text":"ヘシュボンは、アモリ人の王シホンの都である。シホンは先代のモアブ王と戦って、その手からアルノン川に至るまでの全土を奪い取っていた。","tok":[["ヘシュボン"],["は"],["、"],["アモリ人","あもりにん"],["の"],["王","おう"],["シホン"],["の"],["都","みやこ"],["で"],["ある"],["。"],["シホン"],["は"],["先代","せんだい"],["の"],["モアブ"],["王","おう"],["と"],["戦って","たたかって"],["、"],["その"],["手","て"],["から"],["アルノン"],["川","かわ"],["に"],["至る","いたる"],["まで"],["の"],["全土","ぜんど"],["を"],["奪い取って","うばいとって"],["いた"],["。"]]},{"verse":27,"text":"それゆえ、次のように歌う者がいる。来れ、ヘシュボンは築かれシホンの都は固く建てられる。","tok":[["それ"],["ゆえ"],["、"],["次","つぎ"],["の"],["よう"],["に"],["歌う","うたう"],["者","もの"],["が"],["いる"],["。"],["来れ","これ"],["、"],["ヘシュボン"],["は"],["築かれ","きずかれ"],["シホン"],["の"],["都","と"],["は"],["固く","かたく"],["建てられる","たてられる"],["。"]]},{"verse":28,"text":"ヘシュボンから火が出シホンの都から炎が噴き出てモアブのアルを焼きアルノンのバモトの君たちを滅ぼした。","tok":[["ヘシュボン"],["から"],["火","ひ"],["が"],["出","で"],["シホン"],["の"],["都","と"],["から"],["炎","ほのお"],["が"],["噴き出て","ふきでて"],["モアブ"],["の"],["アル"],["を"],["焼き","やき"],["アルノン"],["の"],["バモト"],["の"],["君","きみ"],["たち"],["を"],["滅ぼした","ほろぼした"],["。"]]},{"verse":29,"text":"モアブよ、お前は災いだ。ケモシュの民よ、お前は滅びた。息子たちは難民となり娘たちはアモリ人の王シホンの捕虜となった。","tok":[["モアブ"],["よ"],["、"],["お前","おまえ"],["は"],["災い","わざわい"],["だ"],["。"],["ケモシュ"],["の"],["民","たみ"],["よ"],["、"],["お前","おまえ"],["は"],["滅びた","ほろびた"],["。"],["息子","むすこ"],["たち"],["は"],["難民","なんみん"],["と"],["なり"],["娘","むすめ"],["たち"],["は"],["アモリ人","あもりにん"],["の"],["王","おう"],["シホン"],["の"],["捕虜","ほりょ"],["と"],["なった"],["。"]]},{"verse":30,"text":"我々は彼らを撃ち滅ぼしたヘシュボンからディボンまで。我々は荒廃させたノファから、メデバまで。","tok":[["我々","われわれ"],["は"],["彼","かれ"],["ら"],["を"],["撃ち","うち"],["滅ぼした","ほろぼした"],["ヘシュボン"],["から"],["ディボン"],["まで"],["。"],["我々","われわれ"],["は"],["荒廃","こうはい"],["させた"],["ノファ"],["から"],["、"],["メデバ"],["まで"],["。"]]},{"verse":31,"text":"イスラエルはこうして、アモリ人の地に住んだ。","tok":[["イスラエル"],["は"],["こう"],["して"],["、"],["アモリ人","あもりにん"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["。"]]},{"verse":32,"text":"その後、モーセはヤゼルを偵察するために人を送り、その周辺の村落を占領し、そこに住んでいたアモリ人を追い出した。","tok":[["その"],["後","ご"],["、"],["モーセ"],["は"],["ヤゼル"],["を"],["偵察","ていさつ"],["する"],["ため"],["に"],["人","ひと"],["を"],["送り","おくり"],["、"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["を"],["占領","せんりょう"],["し"],["、"],["そこ"],["に"],["住んで","すんで"],["いた"],["アモリ人","あもりにん"],["を"],["追い出した","おいだした"],["。"]]},{"verse":33,"text":"それから転じて、バシャンに至る道を上って行くと、バシャンの王オグはこれを迎え撃つために、全軍を率いてエドレイに来た。","tok":[["それ"],["から"],["転じて","てんじて"],["、"],["バシャン"],["に"],["至る","いたる"],["道","みち"],["を"],["上って","のぼって"],["行く","いく"],["と"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["は"],["これ"],["を"],["迎え撃つ","むかえうつ"],["ため"],["に"],["、"],["全軍","ぜんぐん"],["を"],["率いて","ひきいて"],["エドレイ"],["に"],["来た","きた"],["。"]]},{"verse":34,"text":"主はモーセに言われた。「彼を恐れてはならない。わたしは彼とその全軍、その国をあなたの手に渡した。あなたは、ヘシュボンの住民アモリ人の王シホンにしたように、彼にもせよ。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["彼","かれ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["と"],["その"],["全軍","ぜんぐん"],["、"],["その"],["国","くに"],["を"],["あなた"],["の"],["手","て"],["に"],["渡した","わたした"],["。"],["あなた"],["は"],["、"],["ヘシュボン"],["の"],["住民","じゅうみん"],["アモリ人","あもりにん"],["の"],["王","おう"],["シホン"],["に"],["した"],["よう"],["に"],["、"],["彼","かれ"],["に"],["も"],["せよ"],["。"],["」"]]},{"verse":35,"text":"イスラエルは彼とその子らを含む全軍を一人残らず撃ち殺し、その国を占領した。","tok":[["イスラエル"],["は"],["彼","かれ"],["と"],["その"],["子","こ"],["ら"],["を"],["含む","ふくむ"],["全軍","ぜんぐん"],["を"],["一人","ひとり"],["残らず","のこらず"],["撃ち殺し","うちころし"],["、"],["その"],["国","くに"],["を"],["占領","せんりょう"],["した"],["。"]]}]
[{"verse":1,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":2,"text":"イスラエルの人々に命じて、こう言いなさい。あなたたちがカナンの土地に入るとき、嗣業としてあなたたちのものになる土地は、それぞれ境で囲まれたカナンの土地であって、それは次のとおりである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じて","めいじて"],["、"],["こう"],["言い","いい"],["なさい"],["。"],["あなた"],["たち"],["が"],["カナン"],["の"],["土地","とち"],["に"],["入る","はいる"],["とき"],["、"],["嗣業","しぎょう"],["として"],["あなた"],["たち"],["の"],["もの"],["に"],["なる"],["土地","とち"],["は"],["、"],["それぞれ"],["境","さかい"],["で"],["囲まれた","かこまれた"],["カナン"],["の"],["土地","とち"],["で"],["あって"],["、"],["それ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":3,"text":"南側は、エドムと国境を接するツィンの荒れ野に延びる。すなわち、その南境は、塩の海の南端を東の起点とし、","tok":[["南側","みなみがわ"],["は"],["、"],["エドム"],["と"],["国境","こっきょう"],["を"],["接する","せっする"],["ツィン"],["の"],["荒れ野","あれの"],["に"],["延びる","のびる"],["。"],["すなわち"],["、"],["その"],["南境","なんきょう"],["は"],["、"],["塩","しお"],["の"],["海","うみ"],["の"],["南端","なんたん"],["を"],["東","ひがし"],["の"],["起点","きてん"],["と"],["し"],["、"]]},{"verse":4,"text":"そこからアクラビムの坂を南に向かい、ツィンを経て、カデシュ‧バルネアの南に達する。そこから更に、ハツァル‧アダル、アツモンを経、","tok":[["そこ"],["から"],["アクラビム"],["の"],["坂","さか"],["を"],["南","みなみ"],["に"],["向かい","むかい"],["、"],["ツィン"],["を"],["経て","へて"],["、"],["カデシュ"],["‧"],["バルネア"],["の"],["南","みなみ"],["に"],["達する","たっする"],["。"],["そこ"],["から"],["更に","さらに"],["、"],["ハツァル"],["‧"],["アダル"],["、"],["アツモン"],["を"],["経","へ"],["、"]]},{"verse":5,"text":"アツモンからエジプトの川に向かい、海に達する。","tok":[["アツモン"],["から"],["エジプト"],["の"],["川","かわ"],["に"],["向かい","むかい"],["、"],["海","うみ"],["に"],["達する","たっする"],["。"]]},{"verse":6,"text":"西境は大海の沿岸である。これが西境である。","tok":[["西境","にしざかい"],["は"],["大海","たいかい"],["の"],["沿岸","えんがん"],["で"],["ある"],["。"],["これ"],["が"],["西境","にしざかい"],["で"],["ある"],["。"]]},{"verse":7,"text":"北境は次のとおりである。大海からホル山まで線を引き、","tok":[["北境","ほっきょう"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["大海","たいかい"],["から"],["ホル"],["山","やま"],["まで"],["線","せん"],["を"],["引き","ひき"],["、"]]},{"verse":8,"text":"更に、ホル山からレボ‧ハマトに線を引いて、ツェダドの境に達する。","tok":[["更に","さらに"],["、"],["ホル"],["山","やま"],["から"],["レボ"],["‧"],["ハマト"],["に"],["線","せん"],["を"],["引いて","ひいて"],["、"],["ツェダド"],["の"],["境","さかい"],["に"],["達する","たっする"],["。"]]},{"verse":9,"text":"更に、境界線はジフロンを経て、ハツァル‧エナンに達する。これが北境である。","tok":[["更に","さらに"],["、"],["境界線","きょうかいせん"],["は"],["ジフロン"],["を"],["経て","へて"],["、"],["ハツァル"],["‧"],["エナン"],["に"],["達する","たっする"],["。"],["これ"],["が"],["北境","ほっきょう"],["で"],["ある"],["。"]]},{"verse":10,"text":"東境は、ハツァル‧エナンからシェファムに線を引き、","tok":[["東境","とうきょう"],["は"],["、"],["ハツァル"],["‧"],["エナン"],["から"],["シェファム"],["に"],["線","せん"],["を"],["引き","ひき"],["、"]]},{"verse":11,"text":"シェファムからアインの東側のリブラに下る。更に境界線は、キネレト湖の東斜面を経て、","tok":[["シェファム"],["から"],["アイン"],["の"],["東側","ひがしがわ"],["の"],["リブラ"],["に"],["下る","くだる"],["。"],["更に","さらに"],["境界線","きょうかいせん"],["は"],["、"],["キネレト"],["湖","こ"],["の"],["東","ひがし"],["斜面","しゃめん"],["を"],["経て","へて"],["、"]]},{"verse":12,"text":"ヨルダン川を下り、塩の海に達する。以上の境界線の内側があなたたちの土地である。","tok":[["ヨルダン"],["川","かわ"],["を"],["下り","おり"],["、"],["塩","しお"],["の"],["海","うみ"],["に"],["達する","たっする"],["。"],["以上","いじょう"],["の"],["境界線","きょうかいせん"],["の"],["内側","うちがわ"],["が"],["あなた"],["たち"],["の"],["土地","とち"],["で"],["ある"],["。"]]},{"verse":13,"text":"モーセはイスラエルの人々に命じた。「これは、あなたたちがくじを引いて、嗣業として受け継ぐべき土地である。主はこれを九つの部族と半部族に与えよ、と命じられた。","tok":[["モーセ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じた","めいじた"],["。"],["「"],["これ"],["は"],["、"],["あなた"],["たち"],["が"],["くじ"],["を"],["引いて","ひいて"],["、"],["嗣業","しぎょう"],["として"],["受け継ぐべき","うけつぐべき"],["土地","とち"],["で"],["ある"],["。"],["主","ぬし"],["は"],["これ"],["を"],["九","ここの"],["つ"],["の"],["部族","ぶぞく"],["と"],["半","はん"],["部族","ぶぞく"],["に"],["与えよ","あたえよ"],["、"],["と"],["命じられた","めいじられた"],["。"]]},{"verse":14,"text":"ルベンの子孫の部族とガドの子孫の部族は、それぞれ家系に従って、既に嗣業の土地を受けており、マナセの半部族もそれを受けている。","tok":[["ルベン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["と"],["ガド"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["は"],["、"],["それぞれ"],["家系","かけい"],["に"],["従って","したがって"],["、"],["既に","すでに"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["受けて","うけて"],["おり"],["、"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["も"],["それ"],["を"],["受けて","うけて"],["いる"],["。"]]},{"verse":15,"text":"この二つの部族と半部族は、エリコに近いヨルダン川の対岸、日の昇る東側に、彼らの嗣業の土地を既に受けている。」","tok":[["この"],["二","ふた"],["つ"],["の"],["部族","ぶぞく"],["と"],["半","はん"],["部族","ぶぞく"],["は"],["、"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["川","かわ"],["の"],["対岸","たいがん"],["、"],["日","ひ"],["の"],["昇る","のぼる"],["東側","ひがしがわ"],["に"],["、"],["彼","かれ"],["ら"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["既に","すでに"],["受けて","うけて"],["いる"],["。"],["」"]]},{"verse":16,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":17,"text":"あなたたちにこの土地を嗣業として分け与える人の名は、次のとおりである。すなわち、祭司エルアザルとヌンの子ヨシュアである。","tok":[["あなた"],["たち"],["に"],["この"],["土地","とち"],["を"],["嗣業","しぎょう"],["として"],["分け与える","わけあたえる"],["人","ひと"],["の"],["名","な"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["祭司","さいし"],["エルアザル"],["と"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["で"],["ある"],["。"]]},{"verse":18,"text":"あなたたちは、各部族から指導者を一名選んで、土地を分け与えさせなさい。","tok":[["あなた"],["たち"],["は"],["、"],["各","かく"],["部族","ぶぞく"],["から"],["指導者","しどうしゃ"],["を"],["一","いち"],["名","めい"],["選んで","えらんで"],["、"],["土地","とち"],["を"],["分け与えさせ","わけあたえさせ"],["なさい"],["。"]]},{"verse":19,"text":"その人々の名は次のとおりである。ユダ族からは、エフネの子カレブ、","tok":[["その"],["人々","ひとびと"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ユダ族","ゆだぞく"],["から"],["は"],["、"],["エフネ"],["の"],["子","こ"],["カレブ"],["、"]]},{"verse":20,"text":"シメオンの子孫の部族からは、アミフドの子シェムエル、","tok":[["シメオン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["から"],["は"],["、"],["アミフド"],["の"],["子","こ"],["シェムエル"],["、"]]},{"verse":21,"text":"ベニヤミン族からは、キスロンの子エリダド、","tok":[["ベニヤミン"],["族","ぞく"],["から"],["は"],["、"],["キスロン"],["の"],["子","こ"],["エリダド"],["、"]]},{"verse":22,"text":"ダンの子孫の部族からは、指導者ヨグリの子ブキ、","tok":[["ダン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["から"],["は"],["、"],["指導者","しどうしゃ"],["ヨグリ"],["の"],["子","こ"],["ブキ"],["、"]]},{"verse":23,"text":"ヨセフの子マナセの子孫の部族からは、指導者エフォドの子ハニエル、","tok":[["ヨセフ"],["の"],["子","こ"],["マナセ"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["から"],["は"],["、"],["指導者","しどうしゃ"],["エフォド"],["の"],["子","こ"],["ハニエル"],["、"]]},{"verse":24,"text":"エフライムの子孫の部族からは、指導者シフタンの子ケムエル、","tok":[["エフライム"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["から"],["は"],["、"],["指導者","しどうしゃ"],["シフタン"],["の"],["子","こ"],["ケムエル"],["、"]]},{"verse":25,"text":"ゼブルンの子孫の部族からは、指導者パルナクの子エリツァファン、","tok":[["ゼブルン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["から"],["は"],["、"],["指導者","しどうしゃ"],["パルナク"],["の"],["子","こ"],["エリツァファン"],["、"]]},{"verse":26,"text":"イサカルの子孫の部族からは、指導者アザンの子パルティエル、","tok":[["イサカル"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["から"],["は"],["、"],["指導者","しどうしゃ"],["アザン"],["の"],["子","こ"],["パルティエル"],["、"]]},{"verse":27,"text":"アシェルの子孫の部族からは、指導者シェロミの子アヒフド、","tok":[["アシェル"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["から"],["は"],["、"],["指導者","しどうしゃ"],["シェロミ"],["の"],["子","こ"],["アヒフド"],["、"]]},{"verse":28,"text":"ナフタリの子孫の部族からは、指導者アミフドの子ペダフエル。","tok":[["ナフタリ"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["から"],["は"],["、"],["指導者","しどうしゃ"],["アミフド"],["の"],["子","こ"],["ペダフエル"],["。"]]},{"verse":29,"text":"以上は、主がカナンの土地でイスラエルの人々に嗣業を分け与えることを命じた人々である。","tok":[["以上","いじょう"],["は"],["、"],["主","ぬし"],["が"],["カナン"],["の"],["土地","とち"],["で"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["嗣業","しぎょう"],["を"],["分け与える","わけあたえる"],["こと"],["を"],["命じた","めいじた"],["人々","ひとびと"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"さて、レビの子ケハトの孫でイツハルの子であるコラは、ルベンの孫でエリアブの子であるダタンとアビラム、およびペレトの子であるオンと組み、","tok":[["さて"],["、"],["レビ"],["の"],["子","こ"],["ケハト"],["の"],["孫","まご"],["で"],["イツハル"],["の"],["子","こ"],["で"],["ある"],["コラ"],["は"],["、"],["ルベン"],["の"],["孫","まご"],["で"],["エリアブ"],["の"],["子","こ"],["で"],["ある"],["ダタン"],["と"],["アビラム"],["、"],["および"],["ペレト"],["の"],["子","こ"],["で"],["ある"],["オン"],["と"],["組み","くみ"],["、"]]},{"verse":2,"text":"集会の召集者である共同体の指導者、二百五十名の名のあるイスラエルの人々を仲間に引き入れ、モーセに反逆した。","tok":[["集会","しゅうかい"],["の"],["召集者","しょうしゅうしゃ"],["で"],["ある"],["共同体","きょうどうたい"],["の"],["指導者","しどうしゃ"],["、"],["二百五十","にひゃくごじゅう"],["名","めい"],["の"],["名","な"],["の"],["ある"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["仲間","なかま"],["に"],["引き入れ","ひきいれ"],["、"],["モーセ"],["に"],["反逆","はんぎゃく"],["した"],["。"]]},{"verse":3,"text":"彼らは徒党を組み、モーセとアロンに逆らって言った。「あなたたちは分を越えている。共同体全体、彼ら全員が聖なる者であって、主がその中におられるのに、なぜ、あなたたちは主の会衆の上に立とうとするのか。」","tok":[["彼","かれ"],["ら"],["は"],["徒党","ととう"],["を"],["組み","くみ"],["、"],["モーセ"],["と"],["アロン"],["に"],["逆らって","さからって"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["は"],["分","ぶん"],["を"],["越えて","こえて"],["いる"],["。"],["共同体","きょうどうたい"],["全体","ぜんたい"],["、"],["彼","かれ"],["ら"],["全員","ぜんいん"],["が"],["聖","せい"],["なる"],["者","もの"],["で"],["あって"],["、"],["主","ぬし"],["が"],["その"],["中","なか"],["に"],["おられる"],["のに"],["、"],["なぜ"],["、"],["あなた"],["たち"],["は"],["主","ぬし"],["の"],["会衆","かいしゅう"],["の"],["上","うえ"],["に"],["立とう","たとう"],["と"],["する"],["の"],["か"],["。"],["」"]]},{"verse":4,"text":"モーセはこれを聞くと、面を伏せた。","tok":[["モーセ"],["は"],["これ"],["を"],["聞く","きく"],["と"],["、"],["面","めん"],["を"],["伏せた","ふせた"],["。"]]},{"verse":5,"text":"彼はコラとその仲間すべてに言った。「主は明日の朝、主に属する者、聖とされる者を示して、その人を御自身のもとに近づけられる。すなわち、主のお選びになる者を御自身のもとに近づけられる。","tok":[["彼","かれ"],["は"],["コラ"],["と"],["その"],["仲間","なかま"],["すべて"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["明日","あす"],["の"],["朝","あさ"],["、"],["主","ぬし"],["に"],["属する","ぞくする"],["者","もの"],["、"],["聖","せい"],["と"],["される"],["者","もの"],["を"],["示して","しめして"],["、"],["その"],["人","ひと"],["を"],["御自身","ごじしん"],["の"],["もと"],["に"],["近づけられる","ちかづけられる"],["。"],["すなわち"],["、"],["主","ぬし"],["の"],["お選び","おえらび"],["に"],["なる"],["者","もの"],["を"],["御自身","ごじしん"],["の"],["もと"],["に"],["近づけられる","ちかづけられる"],["。"]]},{"verse":6,"text":"次のようにしなさい。コラとその仲間はすべて香炉を用意し、","tok":[["次","つぎ"],["の"],["よう"],["に"],["し"],["なさい"],["。"],["コラ"],["と"],["その"],["仲間","なかま"],["は"],["すべて"],["香炉","こうろ"],["を"],["用意","ようい"],["し"],["、"]]},{"verse":7,"text":"それに炭火を入れ、香をたいて、明日、主の御前に出なさい。そのとき主のお選びになる者が聖なる者なのだ。レビの子らよ、分を越えているのはあなたたちだ。」","tok":[["それ"],["に"],["炭火","すみび"],["を"],["入れ","いれ"],["、"],["香","こう"],["を"],["たいて"],["、"],["明日","あす"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["出","で"],["なさい"],["。"],["その"],["とき"],["主","ぬし"],["の"],["お選び","おえらび"],["に"],["なる"],["者","もの"],["が"],["聖","せい"],["なる"],["者","もの"],["な"],["の"],["だ"],["。"],["レビ"],["の"],["子","こ"],["ら"],["よ"],["、"],["分","ぶん"],["を"],["越えて","こえて"],["いる"],["の"],["は"],["あなた"],["たち"],["だ"],["。"],["」"]]},{"verse":8,"text":"モーセは更に、コラに言った。「レビの子らよ、聞きなさい。","tok":[["モーセ"],["は"],["更に","さらに"],["、"],["コラ"],["に"],["言った","いった"],["。"],["「"],["レビ"],["の"],["子","こ"],["ら"],["よ"],["、"],["聞き","きき"],["なさい"],["。"]]},{"verse":9,"text":"イスラエルの神はあなたたちをイスラエルの共同体から取り分けられた者として御自身のそばに置き、主の幕屋の仕事をし、共同体の前に立って彼らに仕えさせられる。あなたたちはそれを不足とするのか。","tok":[["イスラエル"],["の"],["神","かみ"],["は"],["あなた"],["たち"],["を"],["イスラエル"],["の"],["共同体","きょうどうたい"],["から"],["取り分けられた","とりわけられた"],["者","もの"],["として"],["御自身","ごじしん"],["の"],["そば"],["に"],["置き","おき"],["、"],["主","ぬし"],["の"],["幕屋","まくや"],["の"],["仕事","しごと"],["を"],["し"],["、"],["共同体","きょうどうたい"],["の"],["前","まえ"],["に"],["立って","たって"],["彼","かれ"],["ら"],["に"],["仕えさせられる","つかえさせられる"],["。"],["あなた"],["たち"],["は"],["それ"],["を"],["不足","ふそく"],["と"],["する"],["の"],["か"],["。"]]},{"verse":10,"text":"主は、あなたとあなたの兄弟であるレビの子らをすべて御自身のそばに近づけられたのだ。その上、あなたたちは祭司職をも要求するのか。","tok":[["主","ぬし"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["レビ"],["の"],["子","こ"],["ら"],["を"],["すべて"],["御自身","ごじしん"],["の"],["そば"],["に"],["近づけられた","ちかづけられた"],["の"],["だ"],["。"],["その"],["上","うえ"],["、"],["あなた"],["たち"],["は"],["祭司","さいし"],["職","しょく"],["を"],["も"],["要求","ようきゅう"],["する"],["の"],["か"],["。"]]},{"verse":11,"text":"そのために、あなたとあなたの仲間はすべて、主に逆らって集結したのか。アロンを何と思って、彼に対して不平を言うのか。」","tok":[["その"],["ため"],["に"],["、"],["あなた"],["と"],["あなた"],["の"],["仲間","なかま"],["は"],["すべて"],["、"],["主に","おもに"],["逆らって","さからって"],["集結","しゅうけつ"],["した"],["の"],["か"],["。"],["アロン"],["を"],["何","なん"],["と"],["思って","おもって"],["、"],["彼","かれ"],["に対して","にたいして"],["不平","ふへい"],["を"],["言う","いう"],["の"],["か"],["。"],["」"]]},{"verse":12,"text":"モーセは人をやって、エリアブの子であるダタンとアビラムを呼び寄せようとしたが、彼らは言った。「我々は行かない。","tok":[["モーセ"],["は"],["人","ひと"],["を"],["やって"],["、"],["エリアブ"],["の"],["子","こ"],["で"],["ある"],["ダタン"],["と"],["アビラム"],["を"],["呼び寄せよう","よびよせよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["我々","われわれ"],["は"],["行かない","いかない"],["。"]]},{"verse":13,"text":"あなたは我々を乳と蜜の流れる土地から導き上って、この荒れ野で死なせるだけでは不足なのか。我々の上に君臨したいのか。","tok":[["あなた"],["は"],["我々","われわれ"],["を"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["土地","とち"],["から"],["導き","みちびき"],["上って","のぼって"],["、"],["この"],["荒れ野","あれの"],["で"],["死なせる","しなせる"],["だけ"],["で"],["は"],["不足","ふそく"],["な"],["の"],["か"],["。"],["我々","われわれ"],["の"],["上","うえ"],["に"],["君臨","くんりん"],["したい"],["の"],["か"],["。"]]},{"verse":14,"text":"あなたは我々を乳と蜜の流れる土地に導き入れもせず、畑もぶどう畑も我々の嗣業としてくれない。あなたはこの人々の目をえぐり出すつもりなのか。我々は行かない。」","tok":[["あなた"],["は"],["我々","われわれ"],["を"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["土地","とち"],["に"],["導き入れ","みちびきいれ"],["も"],["せず"],["、"],["畑","はたけ"],["も"],["ぶどう"],["畑","はたけ"],["も"],["我々","われわれ"],["の"],["嗣業","しぎょう"],["として"],["くれない"],["。"],["あなた"],["は"],["この"],["人々","ひとびと"],["の"],["目","め"],["を"],["えぐり出す","えぐりだす"],["つもり"],["な"],["の"],["か"],["。"],["我々","われわれ"],["は"],["行かない","いかない"],["。"],["」"]]},{"verse":15,"text":"モーセは激しく憤って主に言った。「彼らの献げ物を顧みないでください。わたしは彼らから一頭のろばも取ったことはなく、だれをも苦しめたことはありません。」","tok":[["モーセ"],["は"],["激しく","はげしく"],["憤って","いきどおって"],["主に","おもに"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["の"],["献げ物","ささげもの"],["を"],["顧みないで","かえりみないで"],["ください"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["から"],["一頭","いちとう"],["の"],["ろば"],["も"],["取った","とった"],["こと"],["は"],["なく"],["、"],["だれ"],["を"],["も"],["苦しめた","くるしめた"],["こと"],["は"],["ありません"],["。"],["」"]]},{"verse":16,"text":"モーセはコラに言った。「明日、あなたとあなたの仲間すべて、すなわち、あなたも彼らも、アロンと共に主の御前に出なさい。","tok":[["モーセ"],["は"],["コラ"],["に"],["言った","いった"],["。"],["「"],["明日","あす"],["、"],["あなた"],["と"],["あなた"],["の"],["仲間","なかま"],["すべて"],["、"],["すなわち"],["、"],["あなた"],["も"],["彼","かれ"],["ら"],["も"],["、"],["アロン"],["と"],["共","とも"],["に"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["出","で"],["なさい"],["。"]]},{"verse":17,"text":"あなたたちは、おのおの香炉を取り、それに香を載せ、主の御前に持って来なさい。おのおの一つずつ、二百五十の香炉を持ち、あなたもアロンもそれぞれ自分の香炉を持って来なさい。」","tok":[["あなた"],["たち"],["は"],["、"],["おのおの"],["香炉","こうろ"],["を"],["取り","とり"],["、"],["それ"],["に"],["香","こう"],["を"],["載せ","のせ"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["おのおの"],["一","ひと"],["つ"],["ずつ"],["、"],["二百五十","にひゃくごじゅう"],["の"],["香炉","こうろ"],["を"],["持ち","もち"],["、"],["あなた"],["も"],["アロン"],["も"],["それぞれ"],["自分","じぶん"],["の"],["香炉","こうろ"],["を"],["持って","もって"],["来","き"],["なさい"],["。"],["」"]]},{"verse":18,"text":"彼らはおのおの香炉を取り、それに炭火を入れ、香を載せ、モーセとアロンと共に臨在の幕屋の入り口に立った。","tok":[["彼","かれ"],["ら"],["は"],["おのおの"],["香炉","こうろ"],["を"],["取り","とり"],["、"],["それ"],["に"],["炭火","すみび"],["を"],["入れ","いれ"],["、"],["香","こう"],["を"],["載せ","のせ"],["、"],["モーセ"],["と"],["アロン"],["と"],["共","とも"],["に"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["立った","たった"],["。"]]},{"verse":19,"text":"コラは共同体全体を集め、臨在の幕屋の入り口でモーセとアロンに相対した。主の栄光はそのとき、共同体全体に現れた。","tok":[["コラ"],["は"],["共同体","きょうどうたい"],["全体","ぜんたい"],["を"],["集め","あつめ"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["で"],["モーセ"],["と"],["アロン"],["に"],["相対","そうたい"],["した"],["。"],["主","ぬし"],["の"],["栄光","えいこう"],["は"],["その"],["とき"],["、"],["共同体","きょうどうたい"],["全体","ぜんたい"],["に"],["現れた","あらわれた"],["。"]]},{"verse":20,"text":"主はモーセとアロンに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":21,"text":"「この共同体と分かれて立ちなさい。わたしは直ちに彼らを滅ぼす。」","tok":[["「"],["この"],["共同体","きょうどうたい"],["と"],["分かれて","わかれて"],["立ち","たち"],["なさい"],["。"],["わたし"],["は"],["直ちに","ただちに"],["彼","かれ"],["ら"],["を"],["滅ぼす","ほろぼす"],["。"],["」"]]},{"verse":22,"text":"彼らはひれ伏して言った。「神よ、すべて肉なるものに霊を与えられる神よ。あなたは、一人が罪を犯すと、共同体全体に怒りを下されるのですか。」","tok":[["彼","かれ"],["ら"],["は"],["ひれ伏して","ひれふして"],["言った","いった"],["。"],["「"],["神","かみ"],["よ"],["、"],["すべて"],["肉","にく"],["なる"],["もの"],["に"],["霊","れい"],["を"],["与えられる","あたえられる"],["神","かみ"],["よ"],["。"],["あなた"],["は"],["、"],["一人","ひとり"],["が"],["罪","つみ"],["を"],["犯す","おかす"],["と"],["、"],["共同体","きょうどうたい"],["全体","ぜんたい"],["に"],["怒り","いかり"],["を"],["下される","くだされる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":23,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":24,"text":"「コラ、ダタン、アビラムの住まいの周りから離れるよう、共同体に告げなさい。」","tok":[["「"],["コラ"],["、"],["ダタン"],["、"],["アビラム"],["の"],["住まい","すまい"],["の"],["周り","まわり"],["から"],["離れる","はなれる"],["よう"],["、"],["共同体","きょうどうたい"],["に"],["告げ","つげ"],["なさい"],["。"],["」"]]},{"verse":25,"text":"モーセは立ち上がり、ダタンとアビラムのところに向かった。イスラエルの長老たちもついて行った。","tok":[["モーセ"],["は"],["立ち上がり","たちあがり"],["、"],["ダタン"],["と"],["アビラム"],["の"],["ところ"],["に"],["向かった","むかった"],["。"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["も"],["ついて"],["行った","いった"],["。"]]},{"verse":26,"text":"彼は共同体に言った。「この神に逆らう者どもの天幕から離れなさい。彼らの持ち物には一切触れてはならない。さもないと、彼らの罪のために、あなたたちは滅びる。」","tok":[["彼","かれ"],["は"],["共同体","きょうどうたい"],["に"],["言った","いった"],["。"],["「"],["この"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["ども"],["の"],["天幕","てんまく"],["から"],["離れ","はなれ"],["なさい"],["。"],["彼","かれ"],["ら"],["の"],["持ち物","もちもの"],["に"],["は"],["一切","いっさい"],["触れて","ふれて"],["は"],["ならない"],["。"],["さも"],["ない"],["と"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["の"],["ため"],["に"],["、"],["あなた"],["たち"],["は"],["滅びる","ほろびる"],["。"],["」"]]},{"verse":27,"text":"彼らはコラ、ダタン、アビラムの住まいから離れた。ダタンとアビラムは、妻子、幼児と一緒に出て来て、天幕の入り口に立った。","tok":[["彼","かれ"],["ら"],["は"],["コラ"],["、"],["ダタン"],["、"],["アビラム"],["の"],["住まい","すまい"],["から"],["離れた","はなれた"],["。"],["ダタン"],["と"],["アビラム"],["は"],["、"],["妻子","さいし"],["、"],["幼児","ようじ"],["と"],["一緒","いっしょ"],["に"],["出て","でて"],["来て","きて"],["、"],["天幕","てんまく"],["の"],["入り口","いりぐち"],["に"],["立った","たった"],["。"]]},{"verse":28,"text":"モーセは言った。「主がわたしを遣わして、これらすべてのことをさせられたので、わたしが自分勝手にしたのではない。それは次のことで分かるであろう。","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["わたし"],["を"],["遣わして","つかわして"],["、"],["これ"],["ら"],["すべて"],["の"],["こと"],["を"],["させられた"],["ので"],["、"],["わたし"],["が"],["自分","じぶん"],["勝手に","かってに"],["した"],["ので"],["は"],["ない"],["。"],["それ"],["は"],["次","つぎ"],["の"],["こと"],["で"],["分かるで","わかるで"],["あろう"],["。"]]},{"verse":29,"text":"もしこの者たちが人の普通の死に方で死に、人の普通の運命に会うならば、主がわたしを遣わされたのではない。","tok":[["もし"],["この"],["者","もの"],["たち"],["が"],["人","ひと"],["の"],["普通","ふつう"],["の"],["死に","しに"],["方","かた"],["で"],["死に","しに"],["、"],["人","ひと"],["の"],["普通","ふつう"],["の"],["運命","うんめい"],["に"],["会うならば","あうならば"],["、"],["主","ぬし"],["が"],["わたし"],["を"],["遣わされた","つかわされた"],["ので"],["は"],["ない"],["。"]]},{"verse":30,"text":"だが、もし主が新しいことを創始されて、大地が口を開き、彼らと彼らに属するものすべてを呑み込み、彼らが生きたまま陰府に落ちるならば、この者たちが主をないがしろにしたことをあなたたちは知るであろう。」","tok":[["だ"],["が"],["、"],["もし"],["主","ぬし"],["が"],["新しい","あたらしい"],["こと"],["を"],["創始","そうし"],["されて"],["、"],["大地","だいち"],["が"],["口","くち"],["を"],["開き","ひらき"],["、"],["彼","かれ"],["ら"],["と"],["彼","かれ"],["ら"],["に"],["属する","ぞくする"],["もの"],["すべて"],["を"],["呑み込み","のみこみ"],["、"],["彼","かれ"],["ら"],["が"],["生きた","いきた"],["まま"],["陰府","よみ"],["に"],["落ちるならば","おちるならば"],["、"],["この"],["者","もの"],["たち"],["が"],["主","ぬし"],["を"],["ないがしろ"],["に"],["した"],["こと"],["を"],["あなた"],["たち"],["は"],["知るで","しるで"],["あろう"],["。"],["」"]]},{"verse":31,"text":"こう語り終えるやいなや、彼らの足もとの大地が裂けた。","tok":[["こう"],["語り","かたり"],["終える","おえる"],["や"],["いな"],["や"],["、"],["彼","かれ"],["ら"],["の"],["足もと","あしもと"],["の"],["大地","だいち"],["が"],["裂けた","さけた"],["。"]]},{"verse":32,"text":"地は口を開き、彼らとコラの仲間たち、その持ち物一切を、家もろとも呑み込んだ。","tok":[["地","ち"],["は"],["口","くち"],["を"],["開き","ひらき"],["、"],["彼","かれ"],["ら"],["と"],["コラ"],["の"],["仲間","なかま"],["たち"],["、"],["その"],["持ち物","もちもの"],["一切","いっさい"],["を"],["、"],["家","いえ"],["もろとも"],["呑み込んだ","のみこんだ"],["。"]]},{"verse":33,"text":"彼らと彼らに属するものはすべて、生きたまま、陰府へ落ち、地がそれを覆った。彼らはこうして、会衆の間から滅び去った。","tok":[["彼","かれ"],["ら"],["と"],["彼","かれ"],["ら"],["に"],["属する","ぞくする"],["もの"],["は"],["すべて"],["、"],["生きた","いきた"],["まま"],["、"],["陰府","よみ"],["へ"],["落ち","おち"],["、"],["地","ち"],["が"],["それ"],["を"],["覆った","おおった"],["。"],["彼","かれ"],["ら"],["は"],["こう"],["して"],["、"],["会衆","かいしゅう"],["の"],["間","あいだ"],["から"],["滅び去った","ほろびさった"],["。"]]},{"verse":34,"text":"彼らの周りにいた全イスラエルは、彼らの叫び声を聞いて、大地に呑み込まれることのないようにと言って逃げた。","tok":[["彼","かれ"],["ら"],["の"],["周り","まわり"],["に"],["いた"],["全","ぜん"],["イスラエル"],["は"],["、"],["彼","かれ"],["ら"],["の"],["叫び声","さけびごえ"],["を"],["聞いて","きいて"],["、"],["大地","だいち"],["に"],["呑み込まれる","のみこまれる"],["こと"],["の"],["ない"],["よう"],["に"],["と"],["言って","いって"],["逃げた","にげた"],["。"]]},{"verse":35,"text":"また火が主のもとから出て、香をささげた二百五十人を焼き尽くした。","tok":[["また"],["火","ひ"],["が"],["主","ぬし"],["の"],["もと"],["から"],["出て","でて"],["、"],["香","こう"],["を"],["ささげた"],["二百五","にひゃくご"],["十人","じゅうにん"],["を"],["焼き","やき"],["尽くした","つくした"],["。"]]}]
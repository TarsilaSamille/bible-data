[{"verse":1,"text":"民は主の耳に達するほど、激しく不満を言った。主はそれを聞いて憤られ、主の火が彼らに対して燃え上がり、宿営を端から焼き尽くそうとした。","tok":[["民","みん"],["は"],["主","ぬし"],["の"],["耳","みみ"],["に"],["達する","たっする"],["ほど"],["、"],["激しく","はげしく"],["不満","ふまん"],["を"],["言った","いった"],["。"],["主","ぬし"],["は"],["それ"],["を"],["聞いて","きいて"],["憤られ","いきどおられ"],["、"],["主","ぬし"],["の"],["火","ひ"],["が"],["彼","かれ"],["ら"],["に対して","にたいして"],["燃え上がり","もえあがり"],["、"],["宿営","しゅくえい"],["を"],["端","はし"],["から"],["焼き","やき"],["尽くそう","つくそう"],["と"],["した"],["。"]]},{"verse":2,"text":"民はモーセに助けを求めて叫びをあげた。モーセが主に祈ると、火は鎮まった。","tok":[["民","みん"],["は"],["モーセ"],["に"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫び","さけび"],["を"],["あげた"],["。"],["モーセ"],["が"],["主に","おもに"],["祈る","いのる"],["と"],["、"],["火","ひ"],["は"],["鎮まった","しずまった"],["。"]]},{"verse":3,"text":"主の火が彼らに対して燃え上がったというので、人々はその場所をタブエラ（燃える）と呼んだ。","tok":[["主","ぬし"],["の"],["火","ひ"],["が"],["彼","かれ"],["ら"],["に対して","にたいして"],["燃え上がった","もえあがった"],["と"],["いう"],["ので"],["、"],["人々","ひとびと"],["は"],["その"],["場所","ばしょ"],["を"],["タブエラ"],["（"],["燃える","もえる"],["）"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":4,"text":"民に加わっていた雑多な他国人は飢えと渇きを訴え、イスラエルの人々も再び泣き言を言った。「誰か肉を食べさせてくれないものか。","tok":[["民","みん"],["に"],["加わって","くわわって"],["いた"],["雑多","ざった"],["な"],["他国人","たこくにん"],["は"],["飢え","うえ"],["と"],["渇き","かわき"],["を"],["訴え","うったえ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["も"],["再び","ふたたび"],["泣き言","なきごと"],["を"],["言った","いった"],["。"],["「"],["誰","だれ"],["か"],["肉","にく"],["を"],["食べさせて","たべさせて"],["くれない"],["もの"],["か"],["。"]]},{"verse":5,"text":"エジプトでは魚をただで食べていたし、きゅうりやメロン、葱や玉葱やにんにくが忘れられない。","tok":[["エジプト"],["で"],["は"],["魚","さかな"],["を"],["ただ"],["で"],["食べて","たべて"],["いた"],["し"],["、"],["きゅうり"],["や"],["メロン"],["、"],["葱","き"],["や"],["玉葱","たまねぎ"],["や"],["にんにく"],["が"],["忘れられない","わすれられない"],["。"]]},{"verse":6,"text":"今では、わたしたちの唾は干上がり、どこを見回してもマナばかりで、何もない。」","tok":[["今","いま"],["で"],["は"],["、"],["わたしたち"],["の"],["唾","つば"],["は"],["干上がり","ひあがり"],["、"],["どこ"],["を"],["見回して","みまわして"],["も"],["マナ"],["ばかり"],["で"],["、"],["何","なん"],["も"],["ない"],["。"],["」"]]},{"verse":7,"text":"マナは、コエンドロの種のようで、一見、琥珀の類のようであった。","tok":[["マナ"],["は"],["、"],["コエンドロ"],["の"],["種","しゅ"],["の"],["よう"],["で"],["、"],["一見","いっけん"],["、"],["琥珀","こはく"],["の"],["類","たぐい"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":8,"text":"民は歩き回って拾い集め、臼で粉にひくか、鉢ですりつぶし、鍋で煮て、菓子にした。それは、こくのあるクリームのような味であった。","tok":[["民","みん"],["は"],["歩き回って","あるきまわって"],["拾い集め","ひろいあつめ"],["、"],["臼","うす"],["で"],["粉","こな"],["に"],["ひく"],["か"],["、"],["鉢","ばち"],["で"],["すりつぶし"],["、"],["鍋","なべ"],["で"],["煮て","にて"],["、"],["菓子","かし"],["に"],["した"],["。"],["それ"],["は"],["、"],["こく"],["の"],["ある"],["クリーム"],["の"],["よう"],["な"],["味","あじ"],["で"],["あった"],["。"]]},{"verse":9,"text":"夜、宿営に露が降りると、マナも降った。","tok":[["夜","よる"],["、"],["宿営","しゅくえい"],["に"],["露","ろ"],["が"],["降りる","おりる"],["と"],["、"],["マナ"],["も"],["降った","ふった"],["。"]]},{"verse":10,"text":"モーセは、民がどの家族もそれぞれの天幕の入り口で泣き言を言っているのを聞いた。主が激しく憤られたので、モーセは苦しんだ。","tok":[["モーセ"],["は"],["、"],["民","みん"],["が"],["どの"],["家族","かぞく"],["も"],["それぞれ"],["の"],["天幕","てんまく"],["の"],["入り口","いりぐち"],["で"],["泣き言","なきごと"],["を"],["言って","いって"],["いる"],["の"],["を"],["聞いた","きいた"],["。"],["主","ぬし"],["が"],["激しく","はげしく"],["憤られた","いきどおられた"],["ので"],["、"],["モーセ"],["は"],["苦しんだ","くるしんだ"],["。"]]},{"verse":11,"text":"モーセは主に言った。「あなたは、なぜ、僕を苦しめられるのですか。なぜわたしはあなたの恵みを得ることなく、この民すべてを重荷として負わされねばならないのですか。","tok":[["モーセ"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["なぜ"],["、"],["僕","ぼく"],["を"],["苦しめられる","くるしめられる"],["の"],["です"],["か"],["。"],["なぜ"],["わたし"],["は"],["あなた"],["の"],["恵み","めぐみ"],["を"],["得る","える"],["こと"],["なく"],["、"],["この"],["民","みん"],["すべて"],["を"],["重荷","おもに"],["として"],["負わされねば","おわされねば"],["ならない"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"わたしがこの民すべてをはらみ、わたしが彼らを生んだのでしょうか。あなたはわたしに、乳母が乳飲み子を抱くように彼らを胸に抱き、あなたが先祖に誓われた土地に連れて行けと言われます。","tok":[["わたし"],["が"],["この"],["民","みん"],["すべて"],["を"],["はらみ"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["生んだ","うんだ"],["の"],["でしょう"],["か"],["。"],["あなた"],["は"],["わたし"],["に"],["、"],["乳母","うば"],["が"],["乳飲み子","ちのみご"],["を"],["抱く","いだく"],["よう"],["に"],["彼","かれ"],["ら"],["を"],["胸","むね"],["に"],["抱き","いだき"],["、"],["あなた"],["が"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["土地","とち"],["に"],["連れて","つれて"],["行け","いけ"],["と"],["言われます","いわれます"],["。"]]},{"verse":13,"text":"この民すべてに食べさせる肉をどこで見つければよいのでしょうか。彼らはわたしに泣き言を言い、肉を食べさせよと言うのです。","tok":[["この"],["民","みん"],["すべて"],["に"],["食べさせる","たべさせる"],["肉","にく"],["を"],["どこ"],["で"],["見つければ","みつければ"],["よい"],["の"],["でしょう"],["か"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["泣き言","なきごと"],["を"],["言い","いい"],["、"],["肉","にく"],["を"],["食べさせよ","たべさせよ"],["と"],["言う","いう"],["の"],["です"],["。"]]},{"verse":14,"text":"わたし一人では、とてもこの民すべてを負うことはできません。わたしには重すぎます。","tok":[["わたし"],["一人","ひとり"],["で"],["は"],["、"],["とても"],["この"],["民","みん"],["すべて"],["を"],["負う","おう"],["こと"],["は"],["できません"],["。"],["わたし"],["に"],["は"],["重","おも"],["すぎます"],["。"]]},{"verse":15,"text":"どうしてもこのようになさりたいなら、どうかむしろ、殺してください。あなたの恵みを得ているのであれば、どうかわたしを苦しみに遭わせないでください。」","tok":[["どう"],["して"],["も"],["この"],["よう"],["に"],["なさりたいなら"],["、"],["どう"],["か"],["むしろ"],["、"],["殺して","ころして"],["ください"],["。"],["あなた"],["の"],["恵み","めぐみ"],["を"],["得て","えて"],["いる"],["ので"],["あれば"],["、"],["どう"],["か"],["わたし"],["を"],["苦しみ","くるしみ"],["に"],["遭わせないで","あわせないで"],["ください"],["。"],["」"]]},{"verse":16,"text":"主はモーセに言われた。「イスラエルの長老たちのうちから、あなたが、民の長老およびその役人として認めうる者を七十人集め、臨在の幕屋に連れて来てあなたの傍らに立たせなさい。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["の"],["うち"],["から"],["、"],["あなた"],["が"],["、"],["民","みん"],["の"],["長老","ちょうろう"],["および"],["その"],["役人","やくにん"],["として"],["認め","みとめ"],["うる"],["者","もの"],["を"],["七","なな"],["十人","じゅうにん"],["集め","あつめ"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["に"],["連れて","つれて"],["来て","きて"],["あなた"],["の"],["傍ら","かたわら"],["に"],["立たせ","たたせ"],["なさい"],["。"]]},{"verse":17,"text":"わたしはそこに降って、あなたと語ろう。そして、あなたに授けてある霊の一部を取って、彼らに授ける。そうすれば、彼らは民の重荷をあなたと共に負うことができるようになり、あなたひとりで負うことはなくなる。","tok":[["わたし"],["は"],["そこ"],["に"],["降って","ふって"],["、"],["あなた"],["と"],["語ろう","かたろう"],["。"],["そして"],["、"],["あなた"],["に"],["授けて","さずけて"],["ある"],["霊","れい"],["の"],["一部","いちぶ"],["を"],["取って","とって"],["、"],["彼","かれ"],["ら"],["に"],["授ける","さずける"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["ら"],["は"],["民","みん"],["の"],["重荷","おもに"],["を"],["あなた"],["と"],["共","とも"],["に"],["負う","おう"],["こと"],["が"],["できる"],["よう"],["に"],["なり"],["、"],["あなた"],["ひとり"],["で"],["負う","おう"],["こと"],["は"],["なくなる"],["。"]]},{"verse":18,"text":"民に告げなさい。明日のために自分自身を聖別しなさい。あなたたちは肉を食べることができる。主の耳に達するほど、泣き言を言い、誰か肉を食べさせてくれないものか、エジプトでは幸せだったと訴えたから、主はあなたたちに肉をお与えになり、あなたたちは食べることができる。","tok":[["民","みん"],["に"],["告げ","つげ"],["なさい"],["。"],["明日","あす"],["の"],["ため"],["に"],["自分","じぶん"],["自身","じしん"],["を"],["聖別","せいべつ"],["し"],["なさい"],["。"],["あなた"],["たち"],["は"],["肉","にく"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["主","ぬし"],["の"],["耳","みみ"],["に"],["達する","たっする"],["ほど"],["、"],["泣き言","なきごと"],["を"],["言い","いい"],["、"],["誰","だれ"],["か"],["肉","にく"],["を"],["食べさせて","たべさせて"],["くれない"],["もの"],["か"],["、"],["エジプト"],["で"],["は"],["幸せ","しあわせ"],["だった"],["と"],["訴えた","うったえた"],["から"],["、"],["主","ぬし"],["は"],["あなた"],["たち"],["に"],["肉","にく"],["を"],["お与え","おあたえ"],["に"],["なり"],["、"],["あなた"],["たち"],["は"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":19,"text":"あなたたちがそれを食べるのは、一日や二日や五日や十日や二十日ではない。","tok":[["あなた"],["たち"],["が"],["それ"],["を"],["食べる","たべる"],["の"],["は"],["、"],["一","いち"],["日","にち"],["や"],["二日","ふたか"],["や"],["五日","いつか"],["や"],["十日","とうか"],["や"],["二十日","にとうか"],["で"],["は"],["ない"],["。"]]},{"verse":20,"text":"一か月に及び、ついにあなたたちの鼻から出るようになり、吐き気を催すほどになる。あなたたちは、あなたたちのうちにいます主を拒み、主の面前で、どうして我々はエジプトを出て来てしまったのか、と泣き言を言ったからだ。」","tok":[["一","いち"],["か月","かげつ"],["に"],["及び","および"],["、"],["ついに"],["あなた"],["たち"],["の"],["鼻","はな"],["から"],["出る","でる"],["よう"],["に"],["なり"],["、"],["吐き気","はきけ"],["を"],["催す","もよおす"],["ほど"],["に"],["なる"],["。"],["あなた"],["たち"],["は"],["、"],["あなた"],["たち"],["の"],["うち"],["に"],["います"],["主","ぬし"],["を"],["拒み","こばみ"],["、"],["主","ぬし"],["の"],["面前","めんぜん"],["で"],["、"],["どう"],["して"],["我々","われわれ"],["は"],["エジプト"],["を"],["出て","でて"],["来て","きて"],["しまった"],["の"],["か"],["、"],["と"],["泣き言","なきごと"],["を"],["言った","いった"],["から"],["だ"],["。"],["」"]]},{"verse":21,"text":"モーセは言った。「わたしの率いる民は男だけで六十万人います。それなのに、あなたは、『肉を彼らに与え、一か月の間食べさせよう』と言われます。","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["の"],["率いる","ひきいる"],["民","たみ"],["は"],["男","おとこ"],["だけ"],["で"],["六十万人","ろくじゅうまんにん"],["います"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["は"],["、"],["『"],["肉","にく"],["を"],["彼","かれ"],["ら"],["に"],["与え","あたえ"],["、"],["一","いち"],["か月","かげつ"],["の"],["間","あいだ"],["食べさせよう","たべさせよう"],["』"],["と"],["言われます","いわれます"],["。"]]},{"verse":22,"text":"しかし、彼らのために羊や牛の群れを屠れば、足りるのでしょうか。海の魚を全部集めれば、足りるのでしょうか。」","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["羊","ひつじ"],["や"],["牛","うし"],["の"],["群れ","むれ"],["を"],["屠れば","ほふれば"],["、"],["足りる","たりる"],["の"],["でしょう"],["か"],["。"],["海","うみ"],["の"],["魚","さかな"],["を"],["全部","ぜんぶ"],["集めれば","あつめれば"],["、"],["足りる","たりる"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":23,"text":"主はモーセに言われた。「主の手が短いというのか。わたしの言葉どおりになるかならないか、今、あなたに見せよう。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["主","ぬし"],["の"],["手","て"],["が"],["短い","みじかい"],["と"],["いう"],["の"],["か"],["。"],["わたし"],["の"],["言葉","ことば"],["どおり"],["に"],["なる"],["か"],["ならない"],["か"],["、"],["今","いま"],["、"],["あなた"],["に"],["見せよう","みせよう"],["。"],["」"]]},{"verse":24,"text":"モーセは出て行って、主の言葉を民に告げた。彼は民の長老の中から七十人を集め、幕屋の周りに立たせた。","tok":[["モーセ"],["は"],["出て","でて"],["行って","いって"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["民","たみ"],["に"],["告げた","つげた"],["。"],["彼","かれ"],["は"],["民","みん"],["の"],["長老","ちょうろう"],["の"],["中","なか"],["から"],["七","なな"],["十人","じゅうにん"],["を"],["集め","あつめ"],["、"],["幕屋","まくや"],["の"],["周り","まわり"],["に"],["立たせた","たたせた"],["。"]]},{"verse":25,"text":"主は雲のうちにあって降り、モーセに語られ、モーセに授けられている霊の一部を取って、七十人の長老にも授けられた。霊が彼らの上にとどまると、彼らは預言状態になったが、続くことはなかった。","tok":[["主","ぬし"],["は"],["雲","くも"],["の"],["うち"],["に"],["あって"],["降り","ふり"],["、"],["モーセ"],["に"],["語られ","かたられ"],["、"],["モーセ"],["に"],["授けられて","さずけられて"],["いる"],["霊","れい"],["の"],["一部","いちぶ"],["を"],["取って","とって"],["、"],["七","なな"],["十人","じゅうにん"],["の"],["長老","ちょうろう"],["に"],["も"],["授けられた","さずけられた"],["。"],["霊","れい"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["とどまる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["預言","よげん"],["状
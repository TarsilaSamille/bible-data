[{"verse":1,"text":"イスラエルの人々、その共同体全体は、第一の月にツィンの荒れ野に入った。そして、民はカデシュに滞在した。ミリアムはそこで死に、その地に埋葬された。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["、"],["その"],["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["、"],["第","だい"],["一","いち"],["の"],["月","つき"],["に"],["ツィン"],["の"],["荒れ野","あれの"],["に"],["入った","はいった"],["。"],["そして"],["、"],["民","みん"],["は"],["カデシュ"],["に"],["滞在","たいざい"],["した"],["。"],["ミリアム"],["は"],["そこ"],["で"],["死に","しに"],["、"],["その"],["地","ち"],["に"],["埋葬","まいそう"],["された"],["。"]]},{"verse":2,"text":"さて、そこには共同体に飲ませる水がなかったので、彼らは徒党を組んで、モーセとアロンに逆らった。","tok":[["さて"],["、"],["そこ"],["に"],["は"],["共同体","きょうどうたい"],["に"],["飲ませる","のませる"],["水","みず"],["が"],["なかった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["徒党","ととう"],["を"],["組んで","くんで"],["、"],["モーセ"],["と"],["アロン"],["に"],["逆らった","さからった"],["。"]]},{"verse":3,"text":"民はモーセに抗弁して言った。「同胞が主の御前で死んだとき、我々も一緒に死に絶えていたらよかったのだ。","tok":[["民","みん"],["は"],["モーセ"],["に"],["抗弁","こうべん"],["して"],["言った","いった"],["。"],["「"],["同胞","どうほう"],["が"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["死んだ","しんだ"],["とき"],["、"],["我々","われわれ"],["も"],["一緒","いっしょ"],["に"],["死に絶えて","しにたえて"],["いたら"],["よかった"],["の"],["だ"],["。"]]},{"verse":4,"text":"なぜ、こんな荒れ野に主の会衆を引き入れたのです。我々と家畜をここで死なせるためですか。","tok":[["なぜ"],["、"],["こんな"],["荒れ野","あれの"],["に"],["主","ぬし"],["の"],["会衆","かいしゅう"],["を"],["引き入れた","ひきいれた"],["の"],["です"],["。"],["我々","われわれ"],["と"],["家畜","かちく"],["を"],["ここ"],["で"],["死なせる","しなせる"],["ため"],["です"],["か"],["。"]]},{"verse":5,"text":"なぜ、我々をエジプトから導き上らせて、こんなひどい所に引き入れたのです。ここには種を蒔く土地も、いちじくも、ぶどうも、ざくろも、飲み水さえもないではありませんか。」","tok":[["なぜ"],["、"],["我々","われわれ"],["を"],["エジプト"],["から"],["導き","みちびき"],["上らせて","のぼらせて"],["、"],["こんな"],["ひどい"],["所","ところ"],["に"],["引き入れた","ひきいれた"],["の"],["です"],["。"],["ここ"],["に"],["は"],["種","しゅ"],["を"],["蒔く","まく"],["土地","とち"],["も"],["、"],["いちじく"],["も"],["、"],["ぶどう"],["も"],["、"],["ざくろ"],["も"],["、"],["飲み水","のみみず"],["さえ"],["も"],["ないで"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":6,"text":"モーセとアロンが会衆から離れて臨在の幕屋の入り口に行き、そこにひれ伏すと、主の栄光が彼らに向かって現れた。","tok":[["モーセ"],["と"],["アロン"],["が"],["会衆","かいしゅう"],["から"],["離れて","はなれて"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["行き","いき"],["、"],["そこ"],["に"],["ひれ伏す","ひれふす"],["と"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["現れた","あらわれた"],["。"]]},{"verse":7,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":8,"text":"「あなたは杖を取り、兄弟アロンと共に共同体を集め、彼らの目の前で岩に向かって、水を出せと命じなさい。あなたはその岩から彼らのために水を出し、共同体と家畜に水を飲ませるがよい。」","tok":[["「"],["あなた"],["は"],["杖","つえ"],["を"],["取り","とり"],["、"],["兄弟","きょうだい"],["アロン"],["と"],["共","とも"],["に"],["共同体","きょうどうたい"],["を"],["集め","あつめ"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["岩","いわ"],["に"],["向かって","むかって"],["、"],["水","みず"],["を"],["出せ","だせ"],["と"],["命じ","めいじ"],["なさい"],["。"],["あなた"],["は"],["その"],["岩","いわ"],["から"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["水","みず"],["を"],["出し","だし"],["、"],["共同体","きょうどうたい"],["と"],["家畜","かちく"],["に"],["水","みず"],["を"],["飲ませる","のませる"],["が"],["よい"],["。"],["」"]]},{"verse":9,"text":"モーセは、命じられたとおり、主の御前から杖を取った。","tok":[["モーセ"],["は"],["、"],["命じられた","めいじられた"],["とおり"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["から"],["杖","つえ"],["を"],["取った","とった"],["。"]]},{"verse":10,"text":"そして、モーセとアロンは会衆を岩の前に集めて言った。「反逆する者らよ、聞け。この岩からあなたたちのために水を出さねばならないのか。」","tok":[["そして"],["、"],["モーセ"],["と"],["アロン"],["は"],["会衆","かいしゅう"],["を"],["岩","いわ"],["の"],["前","まえ"],["に"],["集めて","あつめて"],["言った","いった"],["。"],["「"],["反逆","はんぎゃく"],["する"],["者","もの"],["ら"],["よ"],["、"],["聞け","きけ"],["。"],["この"],["岩","いわ"],["から"],["あなた"],["たち"],["の"],["ため"],["に"],["水","みず"],["を"],["出さねば","ださねば"],["ならない"],["の"],["か"],["。"],["」"]]},{"verse":11,"text":"モーセが手を上げ、その杖で岩を二度打つと、水がほとばしり出たので、共同体も家畜も飲んだ。","tok":[["モーセ"],["が"],["手","て"],["を"],["上げ","あげ"],["、"],["その"],["杖","つえ"],["で"],["岩","いわ"],["を"],["二","に"],["度","ど"],["打つ","うつ"],["と"],["、"],["水","みず"],["が"],["ほとばしり出た","ほとばしりでた"],["ので"],["、"],["共同体","きょうどうたい"],["も"],["家畜","かちく"],["も"],["飲んだ","のんだ"],["。"]]},{"verse":12,"text":"主はモーセとアロンに向かって言われた。「あなたたちはわたしを信じることをせず、イスラエルの人々の前に、わたしの聖なることを示さなかった。それゆえ、あなたたちはこの会衆を、わたしが彼らに与える土地に導き入れることはできない。」","tok":[["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["向かって","むかって"],["言われた","いわれた"],["。"],["「"],["あなた"],["たち"],["は"],["わたし"],["を"],["信じる","しんじる"],["こと"],["を"],["せず"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["示さなかった","しめさなかった"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["たち"],["は"],["この"],["会衆","かいしゅう"],["を"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["土地","とち"],["に"],["導き入れる","みちびきいれる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":13,"text":"これがメリバ（争い）の水であって、イスラエルの人々が主と争った所であり、主が御自分の聖なることを示された所である。","tok":[["これ"],["が"],["メリバ"],["（"],["争い","あらそい"],["）"],["の"],["水","みず"],["で"],["あって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["主","ぬし"],["と"],["争った","あらそった"],["所","ところ"],["で"],["あり"],["、"],["主","ぬし"],["が"],["御自分","ごじぶん"],["の"],["聖","せい"],["なる"],["こと"],["を"],["示された","しめされた"],["所","ところ"],["で"],["ある"],["。"]]},{"verse":14,"text":"モーセはカデシュからエドム王に使者を遣わした。「あなたの兄弟であるイスラエルはこう申します。あなたは、わたしたちの上にふりかかった患難をすべてご存じのことでしょう。","tok":[["モーセ"],["は"],["カデシュ"],["から"],["エドム"],["王","おう"],["に"],["使者","ししゃ"],["を"],["遣わした","つかわした"],["。"],["「"],["あなた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["イスラエル"],["は"],["こう"],["申します","もうします"],["。"],["あなた"],["は"],["、"],["わたしたち"],["の"],["上","うえ"],["に"],["ふりかかった"],["患難","かんなん"],["を"],["すべて"],["ご存じ","ごぞんじ"],["の"],["こと"],["でしょう"],["。"]]},{"verse":15,"text":"わたしたちの先祖はエジプトに下り、長年、エジプトに住んでおりました。エジプト人がわたしたちの先祖もわたしたちも苦しめたので、","tok":[["わたしたち"],["の"],["先祖","せんぞ"],["は"],["エジプト"],["に"],["下り","くだり"],["、"],["長年","ながねん"],["、"],["エジプト"],["に"],["住んで","すんで"],["おりました"],["。"],["エジプト"],["人","にん"],["が"],["わたしたち"],["の"],["先祖","せんぞ"],["も"],["わたしたち"],["も"],["苦しめた","くるしめた"],["ので"],["、"]]},{"verse":16,"text":"主に助けを求めて叫びますと、主はわたしたちの声を聞いて御使いを遣わし、エジプトから導き出してくださいました。今、わたしたちは、あなたの国境に近いカデシュの町におります。","tok":[["主に","おもに"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫びます","さけびます"],["と"],["、"],["主","ぬし"],["は"],["わたしたち"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["御使い","おつかい"],["を"],["遣わし","つかわし"],["、"],["エジプト"],["から"],["導き出して","みちびきだして"],["くださいました"],["。"],["今","いま"],["、"],["わたしたち"],["は"],["、"],["あなた"],["の"],["国境","こっきょう"],["に"],["近い","ちかい"],["カデシュ"],["の"],["町","まち"],["に"],["おります"],["。"]]},{"verse":17,"text":"どうか、あなたの領土を通過させてください。畑やぶどう畑の中を通ったり井戸の水を飲んだりしません。あなたの領土を通過するまで、右にも左にも曲がることなく、『王の道』を通って行きます。」","tok":[["どう"],["か"],["、"],["あなた"],["の"],["領土","りょうど"],["を"],["通過","つうか"],["させて"],["ください"],["。"],["畑","はたけ"],["や"],["ぶどう"],["畑","はたけ"],["の"],["中","なか"],["を"],["通っ","とおっ"],["たり"],["井戸","いど"],["の"],["水","みず"],["を"],["飲ん","のん"],["だり"],["しません"],["。"],["あなた"],["の"],["領土","りょうど"],["を"],["通過","つうか"],["する"],["まで"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["曲がる","まがる"],["こと"],["なく"],["、"],["『"],["王","おう"],["の"],["道","みち"],["』"],["を"],["通って","とおって"],["行きます","いきます"],["。"],["」"]]},{"verse":18,"text":"エドム人は彼に答えた。「わたしの領内を通ってはならない。もし、通るようなことがあれば、剣をとってお前を迎え撃つ。」","tok":[["エドム人","えどむにん"],["は"],["彼","かれ"],["に"],["答えた","こたえた"],["。"],["「"],["わたし"],["の"],["領内","りょうない"],["を"],["通って","とおって"],["は"],["ならない"],["。"],["もし"],["、"],["通る","とおる"],["よう"],["な"],["こと"],["が"],["あれば"],["、"],["剣","けん"],["を"],["とって"],["お前","おまえ"],["を"],["迎え撃つ","むかえうつ"],["。"],["」"]]},{"verse":19,"text":"イスラエルの人々は言った。「わたしたちは広い道を通りますし、その際、わたしや家畜があなたの水を飲むことがあれば、その代価は支払います。徒歩で通過するだけです。取るに足らぬことです。」","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["言った","いった"],["。"],["「"],["わたしたち"],["は"],["広い","ひろい"],["道","みち"],["を"],["通ります","とおります"],["し"],["、"],["その"],["際","さい"],["、"],["わたし"],["や"],["家畜","かちく"],["が"],["あなた"],["の"],["水","みず"],["を"],["飲む","のむ"],["こと"],["が"],["あれば"],["、"],["その"],["代価","だいか"],["は"],["支払います","しはらいます"],["。"],["徒歩","とほ"],["で"],["通過","つうか"],["する"],["だけ"],["です"],["。"],["取る","とる"],["に"],["足らぬ","たらぬ"],["こと"],["です"],["。"],["」"]]},{"verse":20,"text":"しかしエドム人は、「通過してはならない」と言い、強力な軍勢を率いて迎え撃とうとした。","tok":[["しかし"],["エドム人","えどむにん"],["は"],["、"],["「"],["通過","つうか"],["して"],["は"],["ならない"],["」"],["と"],["言い","いい"],["、"],["強力","きょうりょく"],["な"],["軍勢","ぐんぜい"],["を"],["率いて","ひきいて"],["迎え撃とう","むかえうとう"],["と"],["した"],["。"]]},{"verse":21,"text":"エドム人はこのように、自分の領土をイスラエルが通過することを許さず、イスラエルは迂回しなければならなかった。","tok":[["エドム人","えどむにん"],["は"],["この"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["領土","りょうど"],["を"],["イスラエル"],["が"],["通過","つうか"],["する"],["こと"],["を"],["許さず","ゆるさず"],["、"],["イスラエル"],["は"],["迂回","うかい"],["しなければ"],["ならなかった"],["。"]]},{"verse":22,"text":"イスラエルの人々、その共同体全体はカデシュを旅立って、ホル山に着いた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["、"],["その"],["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["カデシュ"],["を"],["旅立って","たびだって"],["、"],["ホル"],["山","やま"],["に"],["着いた","ついた"],["。"]]},{"verse":23,"text":"ホル山はエドム領との国境にあり、ここで、主はモーセとアロンに言われた。","tok":[["ホル"],["山","やま"],["は"],["エドム領","えどむりょう"],["と"],["の"],["国境","こっきょう"],["に"],["あり"],["、"],["ここ"],["で"],["、"],["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["。"]]},{"verse":24,"text":"「アロンは先祖の列に加えられる。わたしがイスラエルの人々に与える土地に、彼は入ることができない。あなたたちがメリバの水のことでわたしの命令に逆らったからだ。","tok":[["「"],["アロン"],["は"],["先祖","せんぞ"],["の"],["列","れつ"],["に"],["加えられる","くわえられる"],["。"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与える","あたえる"],["土地","とち"],["に"],["、"],["彼","かれ"],["は"],["入る","はいる"],["こと"],["が"],["できない"],["。"],["あなた"],["たち"],["が"],["メリバ"],["の"],["水","みず"],["の"],["こと"],["で"],["わたし"],["の"],["命令","めいれい"],["に"],["逆らった","さからった"],["から"],["だ"],["。"]]},{"verse":25,"text":"アロンとその子エルアザルを連れてホル山に登り、","tok":[["アロン"],["と"],["その"],["子","こ"],["エルアザル"],["を"],["連れて","つれて"],["ホル"],["山","やま"],["に"],["登り","のぼり"],["、"]]},{"verse":26,"text":"アロンの衣を脱がせ、その子エルアザルに着せなさい。アロンはそこで死に、先祖の列に加えられる。」","tok":[["アロン"],["の"],["衣","ころも"],["を"],["脱がせ","ぬがせ"],["、"],["その"],["子","こ"],["エルアザル"],["に"],["着せ","きせ"],["なさい"],["。"],["アロン"],["は"],["そこ"],["で"],["死に","しに"],["、"],["先祖","せんぞ"],["の"],["列","れつ"],["に"],["加えられる","くわえられる"],["。"],["」"]]},{"verse":27,"text":"モーセは主が命じられたとおりにした。彼らは、共同体全体の見守る中をホル山に登った。","tok":[["モーセ"],["は"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"],["彼","かれ"],["ら"],["は"],["、"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["見守る","みまもる"],["中","なか"],["を"],["ホル"],["山","やま"],["に"],["登った","のぼった"],["。"]]},{"verse":28,"text":"モーセはアロンの衣を脱がせ、その子エルアザルに着せた。アロンはその山の上で死んだ。モーセとエルアザルが山を下ると、","tok":[["モーセ"],["は"],["アロン"],["の"],["衣","ころも"],["を"],["脱がせ","ぬがせ"],["、"],["その"],["子","こ"],["エルアザル"],["に"],["着せた","きせた"],["。"],["アロン"],["は"],["その"],["山","やま"],["の"],["上","うえ"],["で"],["死んだ","しんだ"],["。"],["モーセ"],["と"],["エルアザル"],["が"],["山","やま"],["を"],["下る","くだる"],["と"],["、"]]},{"verse":29,"text":"共同体全体はアロンが息を引き取ったのを悟り、イスラエルの全家は三十日の間、アロンを悼んで泣いた。","tok":[["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["アロン"],["が"],["息","いき"],["を"],["引き取った","ひきとった"],["の"],["を"],["悟り","さとり"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["は"],["三十日","さんとうか"],["の"],["間","あいだ"],["、"],["アロン"],["を"],["悼んで","いたんで"],["泣いた","ないた"],["。"]]}]
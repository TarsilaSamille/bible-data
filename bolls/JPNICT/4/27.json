[{"verse":1,"text":"ヨセフの子マナセの一族であるヘフェルの子ツェロフハドの娘たちが進み出た。娘たちの名はマフラ、ノア、ホグラ、ミルカ、ティルツァといい、その祖父ヘフェルはギレアドの子、ギレアドはマキルの子、マキルはマナセの子であった。","tok":[["ヨセフ"],["の"],["子","こ"],["マナセ"],["の"],["一族","いちぞく"],["で"],["ある"],["ヘフェル"],["の"],["子","こ"],["ツェロフハド"],["の"],["娘","むすめ"],["たち"],["が"],["進み出た","すすみでた"],["。"],["娘","むすめ"],["たち"],["の"],["名","な"],["は"],["マフラ"],["、"],["ノア"],["、"],["ホグラ"],["、"],["ミルカ"],["、"],["ティルツァ"],["と"],["いい"],["、"],["その"],["祖父","そふ"],["ヘフェル"],["は"],["ギレアド"],["の"],["子","こ"],["、"],["ギレアド"],["は"],["マキル"],["の"],["子","こ"],["、"],["マキル"],["は"],["マナセ"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":2,"text":"娘たちは、臨在の幕屋の入り口にいるモーセと祭司エルアザル、指導者および共同体全体の前に立って言った。","tok":[["娘","むすめ"],["たち"],["は"],["、"],["臨在","りんざい"],["の"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["いる"],["モーセ"],["と"],["祭司","さいし"],["エルアザル"],["、"],["指導者","しどうしゃ"],["および"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["前","まえ"],["に"],["立って","たって"],["言った","いった"],["。"]]},{"verse":3,"text":"「わたしたちの父は荒れ野で死にましたが、主に逆らって集まった仲間、あのコラの仲間に加わりませんでした。彼は自分の罪のゆえに死に、男の子はありませんでした。","tok":[["「"],["わたしたち"],["の"],["父","ちち"],["は"],["荒れ野","あれの"],["で"],["死にました","しにました"],["が"],["、"],["主に","おもに"],["逆らって","さからって"],["集まった","あつまった"],["仲間","なかま"],["、"],["あの"],["コラ"],["の"],["仲間","なかま"],["に"],["加わりませんでした","くわわりませんでした"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死に","しに"],["、"],["男の子","おとこのこ"],["は"],["ありませんでした"],["。"]]},{"verse":4,"text":"男の子がないからといって、どうして父の名がその氏族の中から削られてよいでしょうか。父の兄弟たちと同じように、わたしたちにも所有地をください。」","tok":[["男の子","おとこのこ"],["が"],["ない"],["から"],["と"],["いって"],["、"],["どう"],["して"],["父","ちち"],["の"],["名","な"],["が"],["その"],["氏族","しぞく"],["の"],["中","なか"],["から"],["削られて","けずられて"],["よいでしょう"],["か"],["。"],["父","ちち"],["の"],["兄弟","きょうだい"],["たち"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["わたしたち"],["に"],["も"],["所有地","しょゆうち"],["を"],["ください"],["。"],["」"]]},{"verse":5,"text":"モーセが娘たちの訴えを主の御前に持ち出すと、","tok":[["モーセ"],["が"],["娘","むすめ"],["たち"],["の"],["訴え","うったえ"],["を"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["持ち出す","もちだす"],["と"],["、"]]},{"verse":6,"text":"主はモーセに言われた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"]]},{"verse":7,"text":"「ツェロフハドの娘たちの言い分は正しい。あなたは、必ず娘たちに、その父の兄弟たちと同じように、嗣業としての所有地を与えねばならない。娘たちにその父の嗣業の土地を渡しなさい。","tok":[["「"],["ツェロフハド"],["の"],["娘","むすめ"],["たち"],["の"],["言い分","いいぶん"],["は"],["正しい","ただしい"],["。"],["あなた"],["は"],["、"],["必ず","かならず"],["娘","むすめ"],["たち"],["に"],["、"],["その"],["父","ちち"],["の"],["兄弟","きょうだい"],["たち"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["嗣業","しぎょう"],["として"],["の"],["所有地","しょゆうち"],["を"],["与えねば","あたえねば"],["ならない"],["。"],["娘","むすめ"],["たち"],["に"],["その"],["父","ちち"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["渡し","わたし"],["なさい"],["。"]]},{"verse":8,"text":"あなたはイスラエルの人々にこう告げなさい。ある人が死に、男の子がないならば、その嗣業の土地を娘に渡しなさい。","tok":[["あなた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["こう"],["告げ","つげ"],["なさい"],["。"],["ある"],["人","ひと"],["が"],["死に","しに"],["、"],["男の子","おとこのこ"],["が"],["ないならば"],["、"],["その"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["娘","むすめ"],["に"],["渡し","わたし"],["なさい"],["。"]]},{"verse":9,"text":"もし、娘もいない場合には、嗣業の土地をその人の兄弟に与えなさい。","tok":[["もし"],["、"],["娘","むすめ"],["も"],["いない"],["場合","ばあい"],["に"],["は"],["、"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["その"],["人","ひと"],["の"],["兄弟","きょうだい"],["に"],["与え","あたえ"],["なさい"],["。"]]},{"verse":10,"text":"もし、兄弟もない場合には、嗣業の土地をその人の父の兄弟に与えなさい。","tok":[["もし"],["、"],["兄弟","きょうだい"],["も"],["ない"],["場合","ばあい"],["に"],["は"],["、"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["その"],["人","ひと"],["の"],["父","ちち"],["の"],["兄弟","きょうだい"],["に"],["与え","あたえ"],["なさい"],["。"]]},{"verse":11,"text":"父の兄弟もない場合には、嗣業の土地を氏族の中で最も近い親族に与えて、それを継がせなさい。主がモーセに命じられたとおり、イスラエルの人々はこれを法の定めとしなさい。」","tok":[["父","ちち"],["の"],["兄弟","きょうだい"],["も"],["ない"],["場合","ばあい"],["に"],["は"],["、"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["氏族","しぞく"],["の"],["中","なか"],["で"],["最も","もっとも"],["近い","ちかい"],["親族","しんぞく"],["に"],["与えて","あたえて"],["、"],["それ"],["を"],["継がせ","つがせ"],["なさい"],["。"],["主","ぬし"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["これ"],["を"],["法","ほう"],["の"],["定め","さだめ"],["と"],["し"],["なさい"],["。"],["」"]]},{"verse":12,"text":"主はまたモーセに言われた。「このアバリム山に登り、わたしがイスラエルの人々に与えた土地を見渡しなさい。","tok":[["主","ぬし"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["この"],["アバリム"],["山","さん"],["に"],["登り","のぼり"],["、"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与えた","あたえた"],["土地","とち"],["を"],["見渡し","みわたし"],["なさい"],["。"]]},{"verse":13,"text":"それを見た後、あなたもまた兄弟アロンと同じように、先祖の列に加えられるであろう。","tok":[["それ"],["を"],["見た","みた"],["後","あと"],["、"],["あなた"],["も"],["また"],["兄弟","きょうだい"],["アロン"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["先祖","せんぞ"],["の"],["列","れつ"],["に"],["加えられるで","くわえられるで"],["あろう"],["。"]]},{"verse":14,"text":"ツィンの荒れ野で共同体が争ったとき、あなたたちはわたしの命令に背き、あの水によって彼らの前にわたしの聖なることを示そうとしなかったからだ。」このことはツィンの荒れ野にあるカデシュのメリバの水のことを指している。","tok":[["ツィン"],["の"],["荒れ野","あれの"],["で"],["共同体","きょうどうたい"],["が"],["争った","あらそった"],["とき"],["、"],["あなた"],["たち"],["は"],["わたし"],["の"],["命令","めいれい"],["に"],["背き","そむき"],["、"],["あの"],["水","みず"],["によって"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["示そう","しめそう"],["と"],["しなかった"],["から"],["だ"],["。"],["」"],["この"],["こと"],["は"],["ツィン"],["の"],["荒れ野","あれの"],["に"],["ある"],["カデシュ"],["の"],["メリバ"],["の"],["水","みず"],["の"],["こと"],["を"],["指して","さして"],["いる"],["。"]]},{"verse":15,"text":"モーセは主に言った。","tok":[["モーセ"],["は"],["主に","おもに"],["言った","いった"],["。"]]},{"verse":16,"text":"「主よ、すべての肉なるものに霊を与えられる神よ、どうかこの共同体を指揮する人を任命し、","tok":[["「"],["主","ぬし"],["よ"],["、"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["に"],["霊","れい"],["を"],["与えられる","あたえられる"],["神","かみ"],["よ"],["、"],["どう"],["か"],["この"],["共同体","きょうどうたい"],["を"],["指揮","しき"],["する"],["人","ひと"],["を"],["任命","にんめい"],["し"],["、"]]},{"verse":17,"text":"彼らを率いて出陣し、彼らを率いて凱旋し、進ませ、また連れ戻す者とし、主の共同体を飼う者のいない羊の群れのようにしないでください。」","tok":[["彼","かれ"],["ら"],["を"],["率いて","ひきいて"],["出陣","しゅつじん"],["し"],["、"],["彼","かれ"],["ら"],["を"],["率いて","ひきいて"],["凱旋","がいせん"],["し"],["、"],["進ませ","すすませ"],["、"],["また"],["連れ戻す","つれもどす"],["者","もの"],["と"],["し"],["、"],["主","ぬし"],["の"],["共同体","きょうどうたい"],["を"],["飼う","かう"],["者","もの"],["の"],["いない"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["よう"],["に"],["しないで"],["ください"],["。"],["」"]]},{"verse":18,"text":"主はモーセに言われた。「霊に満たされた人、ヌンの子ヨシュアを選んで、手を彼の上に置き、","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["霊","れい"],["に"],["満たされた","みたされた"],["人","ひと"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["を"],["選んで","えらんで"],["、"],["手","て"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["置き","おき"],["、"]]},{"verse":19,"text":"祭司エルアザルと共同体全体の前に立たせて、彼らの見ている前で職に任じなさい。","tok":[["祭司","さいし"],["エルアザル"],["と"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["前","まえ"],["に"],["立たせて","たたせて"],["、"],["彼","かれ"],["ら"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["職","しょく"],["に"],["任じ","にんじ"],["なさい"],["。"]]},{"verse":20,"text":"あなたの権威を彼に分け与え、イスラエルの人々の共同体全体を彼に従わせなさい。","tok":[["あなた"],["の"],["権威","けんい"],["を"],["彼","かれ"],["に"],["分け与え","わけあたえ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["を"],["彼","かれ"],["に"],["従わせ","したがわせ"],["なさい"],["。"]]},{"verse":21,"text":"彼は祭司エルアザルの前に立ち、エルアザルは彼のために、主の御前でウリムによる判断を求めねばならない。ヨシュアとイスラエルのすべての人々、つまり共同体全体は、エルアザルの命令に従って出陣し、また引き揚げねばならない。」","tok":[["彼","かれ"],["は"],["祭司","さいし"],["エルアザル"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["エルアザル"],["は"],["彼","かれ"],["の"],["ため"],["に"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["ウリム"],["に"],["よる"],["判断","はんだん"],["を"],["求めねば","もとめねば"],["ならない"],["。"],["ヨシュア"],["と"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["、"],["つまり"],["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["、"],["エルアザル"],["の"],["命令","めいれい"],["に"],["従って","したがって"],["出陣","しゅつじん"],["し"],["、"],["また"],["引き揚げねば","ひきあげねば"],["ならない"],["。"],["」"]]},{"verse":22,"text":"モーセは、主が命じられたとおりに、ヨシュアを選んで祭司エルアザルと共同体全体の前に立たせ、","tok":[["モーセ"],["は"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["ヨシュア"],["を"],["選んで","えらんで"],["祭司","さいし"],["エルアザル"],["と"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["前","まえ"],["に"],["立たせ","たたせ"],["、"]]},{"verse":23,"text":"手を彼の上に置いて、主がモーセを通して命じられたとおりに、彼を職に任じた。","tok":[["手","て"],["を"],["彼","かれ"],["の"],["上","うえ"],["に"],["置いて","おいて"],["、"],["主","ぬし"],["が"],["モーセ"],["を"],["
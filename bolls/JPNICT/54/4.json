[{"verse":1,"text":"しかし、“霊”は次のように明確に告げておられます。終わりの時には、惑わす霊と、悪霊どもの教えとに心を奪われ、信仰から脱落する者がいます。","tok":[["しかし"],["、"],["“"],["霊","れい"],["”"],["は"],["次","つぎ"],["の"],["よう"],["に"],["明確","めいかく"],["に"],["告げて","つげて"],["おられます"],["。"],["終わり","おわり"],["の"],["時","とき"],["に"],["は"],["、"],["惑わす","まどわす"],["霊","れい"],["と"],["、"],["悪霊","あくりょう"],["ども"],["の"],["教え","おしえ"],["と"],["に"],["心","こころ"],["を"],["奪われ","うばわれ"],["、"],["信仰","しんこう"],["から"],["脱落","だつらく"],["する"],["者","もの"],["が"],["います"],["。"]]},{"verse":2,"text":"このことは、偽りを語る者たちの偽善によって引き起こされるのです。彼らは自分の良心に焼き印を押されており、","tok":[["この"],["こと"],["は"],["、"],["偽り","いつわり"],["を"],["語る","かたる"],["者","もの"],["たち"],["の"],["偽善","ぎぜん"],["によって"],["引き起こされる","ひきおこされる"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["良心","りょうしん"],["に"],["焼き印","やきいん"],["を"],["押されて","おされて"],["おり"],["、"]]},{"verse":3,"text":"結婚を禁じたり、ある種の食物を断つことを命じたりします。しかし、この食物は、信仰を持ち、真理を認識した人たちが感謝して食べるようにと、神がお造りになったものです。","tok":[["結婚","けっこん"],["を"],["禁じ","きんじ"],["たり"],["、"],["ある"],["種","しゅ"],["の"],["食物","しょくもつ"],["を"],["断つ","たつ"],["こと"],["を"],["命じ","めいじ"],["たり"],["します"],["。"],["しかし"],["、"],["この"],["食物","しょくもつ"],["は"],["、"],["信仰","しんこう"],["を"],["持ち","もち"],["、"],["真理","しんり"],["を"],["認識","にんしき"],["した"],["人","ひと"],["たち"],["が"],["感謝","かんしゃ"],["して"],["食べる","たべる"],["よう"],["に"],["と"],["、"],["神","かみ"],["が"],["お造り","おつくり"],["に"],["なった"],["もの"],["です"],["。"]]},{"verse":4,"text":"というのは、神がお造りになったものはすべて良いものであり、感謝して受けるならば、何一つ捨てるものはないからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["神","かみ"],["が"],["お造り","おつくり"],["に"],["なった"],["もの"],["は"],["すべて"],["良い","よい"],["もの"],["で"],["あり"],["、"],["感謝","かんしゃ"],["して"],["受けるならば","うけるならば"],["、"],["何","なん"],["一","ひと"],["つ"],["捨てる","すてる"],["もの"],["は"],["ない"],["から"],["です"],["。"]]},{"verse":5,"text":"神の言葉と祈りとによって聖なるものとされるのです。","tok":[["神","かみ"],["の"],["言葉","ことば"],["と"],["祈り","いのり"],["と"],["によって"],["聖","せい"],["なる"],["もの"],["と"],["される"],["の"],["です"],["。"]]},{"verse":6,"text":"これらのことを兄弟たちに教えるならば、あなたは、信仰の言葉とあなたが守ってきた善い教えの言葉とに養われて、キリスト‧イエスの立派な奉仕者になります。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["兄弟","きょうだい"],["たち"],["に"],["教えるならば","おしえるならば"],["、"],["あなた"],["は"],["、"],["信仰","しんこう"],["の"],["言葉","ことば"],["と"],["あなた"],["が"],["守って","まもって"],["きた"],["善い","よい"],["教え","おしえ"],["の"],["言葉","ことば"],["と"],["に"],["養われて","やしなわれて"],["、"],["キリスト"],["‧"],["イエス"],["の"],["立派","りっぱ"],["な"],["奉仕者","ほうししゃ"],["に"],["なります"],["。"]]},{"verse":7,"text":"俗悪で愚にもつかない作り話は退けなさい。信心のために自分を鍛えなさい。","tok":[["俗悪","ぞくあく"],["で"],["愚","ぐ"],["に"],["も"],["つかない"],["作り話","つくりばなし"],["は"],["退け","しりぞけ"],["なさい"],["。"],["信心","しんじん"],["の"],["ため"],["に"],["自分","じぶん"],["を"],["鍛え","きたえ"],["なさい"],["。"]]},{"verse":8,"text":"体の鍛練も多少は役に立ちますが、信心は、この世と来るべき世での命を約束するので、すべての点で益となるからです。","tok":[["体","からだ"],["の"],["鍛練","たんれん"],["も"],["多少","たしょう"],["は"],["役","やく"],["に"],["立ちます","たちます"],["が"],["、"],["信心","しんじん"],["は"],["、"],["この世","このよ"],["と"],["来るべき","きたるべき"],["世","よ"],["で"],["の"],["命","いのち"],["を"],["約束","やくそく"],["する"],["ので"],["、"],["すべて"],["の"],["点","てん"],["で"],["益","えき"],["と"],["なる"],["から"],["です"],["。"]]},{"verse":9,"text":"この言葉は真実であり、そのまま受け入れるに値します。","tok":[["この"],["言葉","ことば"],["は"],["真実","しんじつ"],["で"],["あり"],["、"],["そのまま"],["受け入れる","うけいれる"],["に"],["値","あたい"],["します"],["。"]]},{"verse":10,"text":"わたしたちが労苦し、奮闘するのは、すべての人、特に信じる人々の救い主である生ける神に希望を置いているからです。","tok":[["わたしたち"],["が"],["労苦","ろうく"],["し"],["、"],["奮闘","ふんとう"],["する"],["の"],["は"],["、"],["すべて"],["の"],["人","ひと"],["、"],["特に","とくに"],["信じる","しんじる"],["人々","ひとびと"],["の"],["救い主","すくいぬし"],["で"],["ある"],["生ける","いける"],["神","かみ"],["に"],["希望","きぼう"],["を"],["置いて","おいて"],["いる"],["から"],["です"],["。"]]},{"verse":11,"text":"これらのことを命じ、教えなさい。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["命じ","めいじ"],["、"],["教え","おしえ"],["なさい"],["。"]]},{"verse":12,"text":"あなたは、年が若いということで、だれからも軽んじられてはなりません。むしろ、言葉、行動、愛、信仰、純潔の点で、信じる人々の模範となりなさい。","tok":[["あなた"],["は"],["、"],["年","ねん"],["が"],["若い","わかい"],["と"],["いう"],["こと"],["で"],["、"],["だれ"],["から"],["も"],["軽んじられて","かろんじられて"],["は"],["なりません"],["。"],["むしろ"],["、"],["言葉","ことば"],["、"],["行動","こうどう"],["、"],["愛","あい"],["、"],["信仰","しんこう"],["、"],["純潔","じゅんけつ"],["の"],["点","てん"],["で"],["、"],["信じる","しんじる"],["人々","ひとびと"],["の"],["模範","もはん"],["と"],["なり"],["なさい"],["。"]]},{"verse":13,"text":"わたしが行くときまで、聖書の朗読と勧めと教えに専念しなさい。","tok":[["わたし"],["が"],["行く","いく"],["とき"],["まで"],["、"],["聖書","せいしょ"],["の"],["朗読","ろうどく"],["と"],["勧め","すすめ"],["と"],["教え","おしえ"],["に"],["専念","せんねん"],["し"],["なさい"],["。"]]},{"verse":14,"text":"あなたの内にある恵みの賜物を軽んじてはなりません。その賜物は、長老たちがあなたに手を置いたとき、預言によって与えられたものです。","tok":[["あなた"],["の"],["内","うち"],["に"],["ある"],["恵み","めぐみ"],["の"],["賜物","たまもの"],["を"],["軽んじて","かろんじて"],["は"],["なりません"],["。"],["その"],["賜物","たまもの"],["は"],["、"],["長老","ちょうろう"],["たち"],["が"],["あなた"],["に"],["手","て"],["を"],["置いた","おいた"],["とき"],["、"],["預言","よげん"],["によって"],["与えられた","あたえられた"],["もの"],["です"],["。"]]},{"verse":15,"text":"これらのことに努めなさい。そこから離れてはなりません。そうすれば、あなたの進歩はすべての人に明らかになるでしょう。","tok":[["これ"],["ら"],["の"],["こと"],["に"],["努め","つとめ"],["なさい"],["。"],["そこ"],["から"],["離れて","はなれて"],["は"],["なりません"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["進歩","しんぽ"],["は"],["すべて"],["の"],["人","ひと"],["に"],["明らか","あきらか"],["に"],["なるでしょう"],["。"]]},{"verse":16,"text":"自分自身と教えとに気を配りなさい。以上のことをしっかりと守りなさい。そうすれば、あなたは自分自身と、あなたの言葉を聞く人々とを救うことになります。","tok":[["自分","じぶん"],["自身","じしん"],["と"],["教え","おしえ"],["と"],["に"],["気","き"],["を"],["配り","くばり"],["なさい"],["。"],["以上","いじょう"],["の"],["こと"],["を"],["しっかり"],["と"],["守り","まもり"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["自分","じぶん"],["自身","じしん"],["と"],["、"],["あなた"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["人々","ひとびと"],["と"],["を"],["救う","すくう"],["こと"],["に"],["なります"],["。"]]}]
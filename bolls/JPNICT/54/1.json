[{"verse":1,"text":"わたしたちの救い主である神とわたしたちの希望であるキリスト‧イエスによって任命され、キリスト‧イエスの使徒となったパウロから、","tok":[["わたしたち"],["の"],["救い主","すくいぬし"],["で"],["ある"],["神","かみ"],["と"],["わたしたち"],["の"],["希望","きぼう"],["で"],["ある"],["キリスト"],["‧"],["イエス"],["によって"],["任命","にんめい"],["され"],["、"],["キリスト"],["‧"],["イエス"],["の"],["使徒","しと"],["と"],["なった"],["パウロ"],["から"],["、"]]},{"verse":2,"text":"信仰によるまことの子テモテへ。父である神とわたしたちの主キリスト‧イエスからの恵み、憐れみ、そして平和があるように。","tok":[["信仰","しんこう"],["に"],["よる"],["まこと"],["の"],["子","こ"],["テモテ"],["へ"],["。"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["わたしたち"],["の"],["主","ぬし"],["キリスト"],["‧"],["イエス"],["から"],["の"],["恵み","めぐみ"],["、"],["憐れみ","あわれみ"],["、"],["そして"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"マケドニア州に出発するときに頼んでおいたように、あなたはエフェソにとどまって、ある人々に命じなさい。異なる教えを説いたり、","tok":[["マケドニア"],["州","しゅう"],["に"],["出発","しゅっぱつ"],["する"],["とき"],["に"],["頼んで","たのんで"],["おいた"],["よう"],["に"],["、"],["あなた"],["は"],["エフェソ"],["に"],["とどまって"],["、"],["ある"],["人々","ひとびと"],["に"],["命じ","めいじ"],["なさい"],["。"],["異なる","ことなる"],["教え","おしえ"],["を"],["説い","とい"],["たり"],["、"]]},{"verse":4,"text":"作り話や切りのない系図に心を奪われたりしないようにと。このような作り話や系図は、信仰による神の救いの計画の実現よりも、むしろ無意味な詮索を引き起こします。","tok":[["作り話","つくりばなし"],["や"],["切り","きり"],["の"],["ない"],["系図","けいず"],["に"],["心","こころ"],["を"],["奪われ","うばわれ"],["たり"],["しない"],["よう"],["に"],["と"],["。"],["この"],["よう"],["な"],["作り話","つくりばなし"],["や"],["系図","けいず"],["は"],["、"],["信仰","しんこう"],["に"],["よる"],["神","かみ"],["の"],["救い","すくい"],["の"],["計画","けいかく"],["の"],["実現","じつげん"],["より"],["も"],["、"],["むしろ"],["無意味","むいみ"],["な"],["詮索","せんさく"],["を"],["引き起こします","ひきおこします"],["。"]]},{"verse":5,"text":"わたしのこの命令は、清い心と正しい良心と純真な信仰とから生じる愛を目指すものです。","tok":[["わたし"],["の"],["この"],["命令","めいれい"],["は"],["、"],["清い","きよい"],["心","こころ"],["と"],["正しい","ただしい"],["良心","りょうしん"],["と"],["純真","じゅんしん"],["な"],["信仰","しんこう"],["と"],["から"],["生じる","しょうじる"],["愛","あい"],["を"],["目指す","めざす"],["もの"],["です"],["。"]]},{"verse":6,"text":"ある人々はこれらのものからそれて、無益な議論の中に迷い込みました。","tok":[["ある"],["人々","ひとびと"],["は"],["これ"],["ら"],["の"],["もの"],["から"],["それ"],["て"],["、"],["無益","むえき"],["な"],["議論","ぎろん"],["の"],["中","なか"],["に"],["迷い込みました","まよいこみました"],["。"]]},{"verse":7,"text":"彼らは、自分の言っていることも主張している事柄についても理解していないのに、律法の教師でありたいと思っています。","tok":[["彼","かれ"],["ら"],["は"],["、"],["自分","じぶん"],["の"],["言って","いって"],["いる"],["こと"],["も"],["主張","しゅちょう"],["して"],["いる"],["事柄","ことがら"],["について"],["も"],["理解","りかい"],["して"],["いない"],["のに"],["、"],["律法","りっぽう"],["の"],["教師","きょうし"],["で"],["ありたい"],["と"],["思って","おもって"],["います"],["。"]]},{"verse":8,"text":"しかし、わたしたちは、律法は正しく用いるならば良いものであることを知っています。","tok":[["しかし"],["、"],["わたしたち"],["は"],["、"],["律法","りっぽう"],["は"],["正しく","ただしく"],["用いるならば","もちいるならば"],["良い","よい"],["もの"],["で"],["ある"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":9,"text":"すなわち、次のことを知って用いれば良いものです。律法は、正しい者のために与えられているのではなく、不法な者や不従順な者、不信心な者や罪を犯す者、神を畏れぬ者や俗悪な者、父を殺す者や母を殺す者、人を殺す者、","tok":[["すなわち"],["、"],["次","つぎ"],["の"],["こと"],["を"],["知って","しって"],["用いれば","もちいれば"],["良い","よい"],["もの"],["です"],["。"],["律法","りっぽう"],["は"],["、"],["正しい","ただしい"],["者","もの"],["の"],["ため"],["に"],["与えられて","あたえられて"],["いる"],["ので"],["は"],["なく"],["、"],["不法","ふほう"],["な"],["者","もの"],["や"],["不","ふ"],["従順","じゅうじゅん"],["な"],["者","もの"],["、"],["不信心","ふしんじん"],["な"],["者","もの"],["や"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["、"],["神","かみ"],["を"],["畏れぬ","おそれぬ"],["者","もの"],["や"],["俗悪","ぞくあく"],["な"],["者","もの"],["、"],["父","ちち"],["を"],["殺す","ころす"],["者","もの"],["や"],["母","はは"],["を"],["殺す","ころす"],["者","もの"],["、"],["人","ひと"],["を"],["殺す","ころす"],["者","もの"],["、"]]},{"verse":10,"text":"みだらな行いをする者、男色をする者、誘拐する者、偽りを言う者、偽証する者のために与えられ、そのほか、健全な教えに反することがあれば、そのために与えられているのです。","tok":[["みだら"],["な"],["行い","おこない"],["を"],["する"],["者","もの"],["、"],["男色","だんしょく"],["を"],["する"],["者","もの"],["、"],["誘拐","ゆうかい"],["する"],["者","もの"],["、"],["偽り","いつわり"],["を"],["言う","いう"],["者","もの"],["、"],["偽証","ぎしょう"],["する"],["者","もの"],["の"],["ため"],["に"],["与えられ","あたえられ"],["、"],["その"],["ほか"],["、"],["健全","けんぜん"],["な"],["教え","おしえ"],["に"],["反する","はんする"],["こと"],["が"],["あれば"],["、"],["その"],["ため"],["に"],["与えられて","あたえられて"],["いる"],["の"],["です"],["。"]]},{"verse":11,"text":"今述べたことは、祝福に満ちた神の栄光の福音に一致しており、わたしはその福音をゆだねられています。","tok":[["今","いま"],["述べた","のべた"],["こと"],["は"],["、"],["祝福","しゅくふく"],["に"],["満ちた","みちた"],["神","かみ"],["の"],["栄光","えいこう"],["の"],["福音","ふくいん"],["に"],["一致","いっち"],["して"],["おり"],["、"],["わたし"],["は"],["その"],["福音","ふくいん"],["を"],["ゆだねられて"],["います"],["。"]]},{"verse":12,"text":"わたしを強くしてくださった、わたしたちの主キリスト‧イエスに感謝しています。この方が、わたしを忠実な者と見なして務めに就かせてくださったからです。","tok":[["わたし"],["を"],["強く","つよく"],["して"],["くださった"],["、"],["わたしたち"],["の"],["主","ぬし"],["キリスト"],["‧"],["イエス"],["に"],["感謝","かんしゃ"],["して"],["います"],["。"],["この"],["方","ほう"],["が"],["、"],["わたし"],["を"],["忠実","ちゅうじつ"],["な"],["者","もの"],["と"],["見なして","みなして"],["務め","つとめ"],["に"],["就かせて","つかせて"],["くださった"],["から"],["です"],["。"]]},{"verse":13,"text":"以前、わたしは神を冒瀆する者、迫害する者、暴力を振るう者でした。しかし、信じていないとき知らずに行ったことなので、憐れみを受けました。","tok":[["以前","いぜん"],["、"],["わたし"],["は"],["神","かみ"],["を"],["冒瀆","ぼうとく"],["する"],["者","もの"],["、"],["迫害","はくがい"],["する"],["者","もの"],["、"],["暴力","ぼうりょく"],["を"],["振るう","ふるう"],["者","もの"],["でした"],["。"],["しかし"],["、"],["信じて","しんじて"],["いない"],["とき"],["知らず","しらず"],["に"],["行った","いった"],["こと"],["な"],["ので"],["、"],["憐れみ","あわれみ"],["を"],["受けました","うけました"],["。"]]},{"verse":14,"text":"そして、わたしたちの主の恵みが、キリスト‧イエスによる信仰と愛と共に、あふれるほど与えられました。","tok":[["そして"],["、"],["わたしたち"],["の"],["主","ぬし"],["の"],["恵み","めぐみ"],["が"],["、"],["キリスト"],["‧"],["イエス"],["に"],["よる"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["共","とも"],["に"],["、"],["あふれる"],["ほど"],["与えられました","あたえられました"],["。"]]},{"verse":15,"text":"「キリスト‧イエスは、罪人を救うために世に来られた」という言葉は真実であり、そのまま受け入れるに値します。わたしは、その罪人の中で最たる者です。","tok":[["「"],["キリスト"],["‧"],["イエス"],["は"],["、"],["罪人","ざいにん"],["を"],["救う","すくう"],["ため"],["に"],["世","よ"],["に"],["来られた","こられた"],["」"],["と"],["いう"],["言葉","ことば"],["は"],["真実","しんじつ"],["で"],["あり"],["、"],["そのまま"],["受け入れる","うけいれる"],["に"],["値","あたい"],["します"],["。"],["わたし"],["は"],["、"],["その"],["罪人","ざいにん"],["の"],["中","なか"],["で"],["最","さい"],["たる"],["者","もの"],["です"],["。"]]},{"verse":16,"text":"しかし、わたしが憐れみを受けたのは、キリスト‧イエスがまずそのわたしに限りない忍耐をお示しになり、わたしがこの方を信じて永遠の命を得ようとしている人々の手本となるためでした。","tok":[["しかし"],["、"],["わたし"],["が"],["憐れみ","あわれみ"],["を"],["受けた","うけた"],["の"],["は"],["、"],["キリスト"],["‧"],["イエス"],["が"],["まず"],["その"],["わたし"],["に"],["限りない","かぎりない"],["忍耐","にんたい"],["を"],["お示し","おしめし"],["に"],["なり"],["、"],["わたし"],["が"],["この"],["方","ほう"],["を"],["信じて","しんじて"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得よう","えよう"],["として"],["いる"],["人々","ひとびと"],["の"],["手本","てほん"],["と"],["なる"],["ため"],["でした"],["。"]]},{"verse":17,"text":"永遠の王、不滅で目に見えない唯一の神に、誉れと栄光が世々限りなくありますように、アーメン。","tok":[["永遠","えいえん"],["の"],["王","おう"],["、"],["不滅","ふめつ"],["で"],["目","め"],["に"],["見えない","みえない"],["唯一","ゆいいつ"],["の"],["神","かみ"],["に"],["、"],["誉れ","ほまれ"],["と"],["栄光","えいこう"],["が"],["世々","せいせい"],["限りなく","かぎりなく"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]},{"verse":18,"text":"わたしの子テモテ、あなたについて以前預言されたことに従って、この命令を与えます。その預言に力づけられ、雄々しく戦いなさい、","tok":[["わたし"],["の"],["子","こ"],["テモテ"],["、"],["あなた"],["について"],["以前","いぜん"],["預言","よげん"],["された"],["こと"],["に"],["従って","したがって"],["、"],["この"],["命令","めいれい"],["を"],["与えます","あたえます"],["。"],["その"],["預言","よげん"],["に"],["力づけられ","ちからづけられ"],["、"],["雄々しく","おおしく"],["戦い","たたかい"],["なさい"],["、"]]},{"verse":19,"text":"信仰と正しい良心とを持って。ある人々は正しい良心を捨て、その信仰は挫折してしまいました。","tok":[["信仰","しんこう"],["と"],["正しい","ただしい"],["良心","りょうしん"],["と"],["を"],["持って","もって"],["。"],["ある"],["人々","ひとびと"],["は"],["正しい","ただしい"],["良心","りょうしん"],["を"],["捨て","すて"],["、"],["その"],["信仰","しんこう"],["は"],["挫折","ざせつ"],["して"],["しまいました"],["。"]]},{"verse":20,"text":"その中には、ヒメナイとアレクサンドロがいます。わたしは、神を冒瀆してはならないことを学ばせるために、彼らをサタンに引き渡しました。","tok":[["その"],["中","なか"],["に"],["は"],["、"],["ヒメナイ"],["と"],["アレク"],["サンドロ"],["が"],["います"],["。"],["わたし"],["は"],["、"],["神","かみ"],["を"],["冒瀆","ぼうとく"],["して"],["は"],["ならない"],["こと"],["を"],["学ばせる","まなばせる"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["サタン"],["に"],["引き渡しました","ひきわたしました"],["。"]]}]
[{"verse":1,"text":"軛の下にある奴隷の身分の人は皆、自分の主人を十分尊敬すべきものと考えなければなりません。それは、神の御名とわたしたちの教えが冒瀆されないようにするためです。","tok":[["軛","くびき"],["の"],["下","した"],["に"],["ある"],["奴隷","どれい"],["の"],["身分","みぶん"],["の"],["人","ひと"],["は"],["皆","みな"],["、"],["自分","じぶん"],["の"],["主人","しゅじん"],["を"],["十分","じゅうぶん"],["尊敬","そんけい"],["すべき"],["もの"],["と"],["考えなければ","かんがえなければ"],["なりません"],["。"],["それ"],["は"],["、"],["神","かみ"],["の"],["御名","ぎょめい"],["と"],["わたしたち"],["の"],["教え","おしえ"],["が"],["冒瀆","ぼうとく"],["されない"],["よう"],["に"],["する"],["ため"],["です"],["。"]]},{"verse":2,"text":"主人が信者である場合は、自分の信仰上の兄弟であるからといって軽んぜず、むしろ、いっそう熱心に仕えるべきです。その奉仕から益を受ける主人は信者であり、神に愛されている者だからです。大きな利得これらのことを教え、勧めなさい。","tok":[["主人","しゅじん"],["が"],["信者","しんじゃ"],["で"],["ある"],["場合","ばあい"],["は"],["、"],["自分","じぶん"],["の"],["信仰上","しんこうじょう"],["の"],["兄弟","きょうだい"],["で"],["ある"],["から"],["と"],["いって"],["軽んぜず","かろんぜず"],["、"],["むしろ"],["、"],["いっそう"],["熱心","ねっしん"],["に"],["仕えるべきです","つかえるべきです"],["。"],["その"],["奉仕","ほうし"],["から"],["益","えき"],["を"],["受ける","うける"],["主人","しゅじん"],["は"],["信者","しんじゃ"],["で"],["あり"],["、"],["神","かみ"],["に"],["愛されて","あいされて"],["いる"],["者","もの"],["だ"],["から"],["です"],["。"],["大きな","おおきな"],["利得","りとく"],["これ"],["ら"],["の"],["こと"],["を"],["教え","おしえ"],["、"],["勧め","すすめ"],["なさい"],["。"]]},{"verse":3,"text":"異なる教えを説き、わたしたちの主イエス‧キリストの健全な言葉にも、信心に基づく教えにも従わない者がいれば、","tok":[["異なる","ことなる"],["教え","おしえ"],["を"],["説き","とき"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["健全","けんぜん"],["な"],["言葉","ことば"],["に"],["も"],["、"],["信心","しんじん"],["に"],["基づく","もとづく"],["教え","おしえ"],["に"],["も"],["従わない","したがわない"],["者","もの"],["が"],["いれば"],["、"]]},{"verse":4,"text":"その者は高慢で、何も分からず、議論や口論に病みつきになっています。そこから、ねたみ、争い、中傷、邪推、","tok":[["その"],["者","もの"],["は"],["高慢","こうまん"],["で"],["、"],["何","なん"],["も"],["分からず","わからず"],["、"],["議論","ぎろん"],["や"],["口論","こうろん"],["に"],["病みつき","やみつき"],["に"],["なって"],["います"],["。"],["そこ"],["から"],["、"],["ねたみ"],["、"],["争い","あらそい"],["、"],["中傷","ちゅうしょう"],["、"],["邪推","じゃすい"],["、"]]},{"verse":5,"text":"絶え間ない言い争いが生じるのです。これらは、精神が腐り、真理に背を向け、信心を利得の道と考える者の間で起こるものです。","tok":[["絶え間","たえま"],["ない"],["言い争い","いいあらそい"],["が"],["生じる","しょうじる"],["の"],["です"],["。"],["これ"],["ら"],["は"],["、"],["精神","せいしん"],["が"],["腐り","くさり"],["、"],["真理","しんり"],["に"],["背","せ"],["を"],["向け","むけ"],["、"],["信心","しんじん"],["を"],["利得","りとく"],["の"],["道","みち"],["と"],["考える","かんがえる"],["者","もの"],["の"],["間","あいだ"],["で"],["起こる","おこる"],["もの"],["です"],["。"]]},{"verse":6,"text":"もっとも、信心は、満ち足りることを知る者には、大きな利得の道です。","tok":[["もっとも"],["、"],["信心","しんじん"],["は"],["、"],["満ち足りる","みちたりる"],["こと"],["を"],["知る","しる"],["者","もの"],["に"],["は"],["、"],["大きな","おおきな"],["利得","りとく"],["の"],["道","みち"],["です"],["。"]]},{"verse":7,"text":"なぜならば、わたしたちは、何も持たずに世に生まれ、世を去るときは何も持って行くことができないからです。","tok":[["なぜ"],["ならば"],["、"],["わたしたち"],["は"],["、"],["何","なん"],["も"],["持たず","もたず"],["に"],["世","よ"],["に"],["生まれ","うまれ"],["、"],["世","よ"],["を"],["去る","さる"],["とき"],["は"],["何","なん"],["も"],["持って","もって"],["行く","いく"],["こと"],["が"],["できない"],["から"],["です"],["。"]]},{"verse":8,"text":"食べる物と着る物があれば、わたしたちはそれで満足すべきです。","tok":[["食べる","たべる"],["物","もの"],["と"],["着る","きる"],["物","もの"],["が"],["あれば"],["、"],["わたしたち"],["は"],["それ"],["で"],["満足","まんぞく"],["すべきです"],["。"]]},{"verse":9,"text":"金持ちになろうとする者は、誘惑、罠、無分別で有害なさまざまの欲望に陥ります。その欲望が、人を滅亡と破滅に陥れます。","tok":[["金持ち","かねもち"],["に"],["なろう"],["と"],["する"],["者","もの"],["は"],["、"],["誘惑","ゆうわく"],["、"],["罠","わな"],["、"],["無分別","むふんべつ"],["で"],["有害","ゆうがい"],["な"],["さまざま"],["の"],["欲望","よくぼう"],["に"],["陥ります","おちいります"],["。"],["その"],["欲望","よくぼう"],["が"],["、"],["人","ひと"],["を"],["滅亡","めつぼう"],["と"],["破滅","はめつ"],["に"],["陥れます","おとしいれます"],["。"]]},{"verse":10,"text":"金銭の欲は、すべての悪の根です。金銭を追い求めるうちに信仰から迷い出て、さまざまのひどい苦しみで突き刺された者もいます。","tok":[["金銭","きんせん"],["の"],["欲","よく"],["は"],["、"],["すべて"],["の"],["悪","あく"],["の"],["根","ね"],["です"],["。"],["金銭","きんせん"],["を"],["追い求める","おいもとめる"],["うち"],["に"],["信仰","しんこう"],["から"],["迷い出て","まよいでて"],["、"],["さまざま"],["の"],["ひどい"],["苦しみ","くるしみ"],["で"],["突き刺された","つきさされた"],["者","もの"],["も"],["います"],["。"]]},{"verse":11,"text":"しかし、神の人よ、あなたはこれらのことを避けなさい。正義、信心、信仰、愛、忍耐、柔和を追い求めなさい。","tok":[["しかし"],["、"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["あなた"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["避け","さけ"],["なさい"],["。"],["正義","まさよし"],["、"],["信心","しんじん"],["、"],["信仰","しんこう"],["、"],["愛","あい"],["、"],["忍耐","にんたい"],["、"],["柔和","にゅうわ"],["を"],["追い求め","おいもとめ"],["なさい"],["。"]]},{"verse":12,"text":"信仰の戦いを立派に戦い抜き、永遠の命を手に入れなさい。命を得るために、あなたは神から召され、多くの証人の前で立派に信仰を表明したのです。","tok":[["信仰","しんこう"],["の"],["戦い","たたかい"],["を"],["立派","りっぱ"],["に"],["戦い","たたかい"],["抜き","ぬき"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["手","て"],["に"],["入れ","いれ"],["なさい"],["。"],["命","いのち"],["を"],["得る","える"],["ため"],["に"],["、"],["あなた"],["は"],["神","かみ"],["から"],["召され","めされ"],["、"],["多く","おおく"],["の"],["証人","しょうにん"],["の"],["前","まえ"],["で"],["立派","りっぱ"],["に"],["信仰","しんこう"],["を"],["表明","ひょうめい"],["した"],["の"],["です"],["。"]]},{"verse":13,"text":"万物に命をお与えになる神の御前で、そして、ポンティオ‧ピラトの面前で立派な宣言によって証しをなさったキリスト‧イエスの御前で、あなたに命じます。","tok":[["万物","ばんぶつ"],["に"],["命","いのち"],["を"],["お与え","おあたえ"],["に"],["なる"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["そして"],["、"],["ポンティオ"],["‧"],["ピラト"],["の"],["面前","めんぜん"],["で"],["立派","りっぱ"],["な"],["宣言","せんげん"],["によって"],["証し","あかし"],["を"],["なさった"],["キリスト"],["‧"],["イエス"],["の"],["御前","ごぜん"],["で"],["、"],["あなた"],["に"],["命じます","めいじます"],["。"]]},{"verse":14,"text":"わたしたちの主イエス‧キリストが再び来られるときまで、おちどなく、非難されないように、この掟を守りなさい。","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["が"],["再び","ふたたび"],["来られる","こられる"],["とき"],["まで"],["、"],["おちど"],["なく"],["、"],["非難","ひなん"],["されない"],["よう"],["に"],["、"],["この"],["掟","おきて"],["を"],["守り","まもり"],["なさい"],["。"]]},{"verse":15,"text":"神は、定められた時にキリストを現してくださいます。神は、祝福に満ちた唯一の主権者、王の王、主の主、","tok":[["神","かみ"],["は"],["、"],["定められた","さだめられた"],["時","とき"],["に"],["キリスト"],["を"],["現して","あらわして"],["くださいます"],["。"],["神","かみ"],["は"],["、"],["祝福","しゅくふく"],["に"],["満ちた","みちた"],["唯一","ゆいいつ"],["の"],["主権者","しゅけんしゃ"],["、"],["王","おう"],["の"],["王","おう"],["、"],["主","ぬし"],["の"],["主","ぬし"],["、"]]},{"verse":16,"text":"唯一の不死の存在、近寄り難い光の中に住まわれる方、だれ一人見たことがなく、見ることのできない方です。この神に誉れと永遠の支配がありますように、アーメン。","tok":[["唯一","ゆいいつ"],["の"],["不死","ふし"],["の"],["存在","そんざい"],["、"],["近寄り","ちかより"],["難い","がたい"],["光","ひかり"],["の"],["中","なか"],["に"],["住まわれる","すまわれる"],["方","かた"],["、"],["だれ"],["一人","ひとり"],["見た","みた"],["こと"],["が"],["なく"],["、"],["見る","みる"],["こと"],["の"],["できない"],["方","ほう"],["です"],["。"],["この"],["神","かみ"],["に"],["誉れ","ほまれ"],["と"],["永遠","えいえん"],["の"],["支配","しはい"],["が"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]},{"verse":17,"text":"この世で富んでいる人々に命じなさい。高慢にならず、不確かな富に望みを置くのではなく、わたしたちにすべてのものを豊かに与えて楽しませてくださる神に望みを置くように。","tok":[["この世","このよ"],["で"],["富んで","とんで"],["いる"],["人々","ひとびと"],["に"],["命じ","めいじ"],["なさい"],["。"],["高慢","こうまん"],["に"],["ならず"],["、"],["不確か","ふたしか"],["な"],["富","とみ"],["に"],["望み","のぞみ"],["を"],["置く","おく"],["ので"],["は"],["なく"],["、"],["わたしたち"],["に"],["すべて"],["の"],["もの"],["を"],["豊か","ゆたか"],["に"],["与えて","あたえて"],["楽しませて","たのしませて"],["くださる"],["神","かみ"],["に"],["望み","のぞみ"],["を"],["置く","おく"],["よう"],["に"],["。"]]},{"verse":18,"text":"善を行い、良い行いに富み、物惜しみをせず、喜んで分け与えるように。","tok":[["善","ぜん"],["を"],["行い","おこない"],["、"],["良い","よい"],["行い","おこない"],["に"],["富み","とみ"],["、"],["物惜しみ","ものおしみ"],["を"],["せず"],["、"],["喜んで","よろこんで"],["分け与える","わけあたえる"],["よう"],["に"],["。"]]},{"verse":19,"text":"真の命を得るために、未来に備えて自分のために堅固な基礎を築くようにと。","tok":[["真","しん"],["の"],["命","いのち"],["を"],["得る","える"],["ため"],["に"],["、"],["未来","みらい"],["に"],["備えて","そなえて"],["自分","じぶん"],["の"],["ため"],["に"],["堅固","けんご"],["な"],["基礎","きそ"],["を"],["築く","きずく"],["よう"],["に"],["と"],["。"]]},{"verse":20,"text":"テモテ、あなたにゆだねられているものを守り、俗悪な無駄話と、不当にも知識と呼ばれている反対論とを避けなさい。","tok":[["テモテ"],["、"],["あなた"],["に"],["ゆだねられて"],["いる"],["もの"],["を"],["守り","まもり"],["、"],["俗悪","ぞくあく"],["な"],["無駄話","むだばなし"],["と"],["、"],["不当","ふとう"],["に"],["も"],["知識","ちしき"],["と"],["呼ばれて","よばれて"],["いる"],["反対論","はんたいろん"],["と"],["を"],["避け","さけ"],["なさい"],["。"]]},{"verse":21,"text":"その知識を鼻にかけ、信仰の道を踏み外してしまった者もいます。恵みがあなたがたと共にあるように。","tok":[["その"],["知識","ちしき"],["を"],["鼻","はな"],["に"],["かけ"],["、"],["信仰","しんこう"],["の"],["道","みち"],["を"],["踏み外して","ふみはずして"],["しまった"],["者","もの"],["も"],["います"],["。"],["恵み","めぐみ"],["が"],["あなた"],["がた"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
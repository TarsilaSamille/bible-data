[{"verse":1,"text":"そこでわたしは、そちらに行くことで再びあなたがたを悲しませるようなことはすまい、と決心しました。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["そちら"],["に"],["行く","いく"],["こと"],["で"],["再び","ふたたび"],["あなた"],["がた"],["を"],["悲しませる","かなしませる"],["よう"],["な"],["こと"],["は"],["すまい"],["、"],["と"],["決心","けっしん"],["しました"],["。"]]},{"verse":2,"text":"もしあなたがたを悲しませるとすれば、わたしが悲しませる人以外のいったいだれが、わたしを喜ばせてくれるでしょう。","tok":[["もし"],["あなた"],["がた"],["を"],["悲しませる","かなしませる"],["と"],["すれば"],["、"],["わたし"],["が"],["悲しませる","かなしませる"],["人","ひと"],["以外","いがい"],["の"],["いったい"],["だれ"],["が"],["、"],["わたし"],["を"],["喜ばせて","よろこばせて"],["くれるでしょう"],["。"]]},{"verse":3,"text":"あのようなことを書いたのは、そちらに行って、喜ばせてもらえるはずの人たちから悲しい思いをさせられたくなかったからです。わたしの喜びはあなたがたすべての喜びでもあると、あなたがた一同について確信しているからです。","tok":[["あの"],["よう"],["な"],["こと"],["を"],["書いた","かいた"],["の"],["は"],["、"],["そちら"],["に"],["行って","いって"],["、"],["喜ばせて","よろこばせて"],["もらえる"],["はず"],["の"],["人","ひと"],["たち"],["から"],["悲しい","かなしい"],["思い","おもい"],["を"],["させられたく"],["なかった"],["から"],["です"],["。"],["わたし"],["の"],["喜び","よろこび"],["は"],["あなた"],["がた"],["すべて"],["の"],["喜び","よろこび"],["で"],["も"],["ある"],["と"],["、"],["あなた"],["がた"],["一同","いちどう"],["について"],["確信","かくしん"],["して"],["いる"],["から"],["です"],["。"]]},{"verse":4,"text":"わたしは、悩みと愁いに満ちた心で、涙ながらに手紙を書きました。あなたがたを悲しませるためではなく、わたしがあなたがたに対してあふれるほど抱いている愛を知ってもらうためでした。","tok":[["わたし"],["は"],["、"],["悩み","なやみ"],["と"],["愁い","うれい"],["に"],["満ちた","みちた"],["心","こころ"],["で"],["、"],["涙","なみだ"],["ながら"],["に"],["手紙","てがみ"],["を"],["書きました","かきました"],["。"],["あなた"],["がた"],["を"],["悲しませる","かなしませる"],["ため"],["で"],["は"],["なく"],["、"],["わたし"],["が"],["あなた"],["がた"],["に対して","にたいして"],["あふれる"],["ほど"],["抱いて","いだいて"],["いる"],["愛","あい"],["を"],["知って","しって"],["もらう"],["ため"],["でした"],["。"]]},{"verse":5,"text":"悲しみの原因となった人がいれば、その人はわたしを悲しませたのではなく、大げさな表現は控えますが、あなたがたすべてをある程度悲しませたのです。","tok":[["悲しみ","かなしみ"],["の"],["原因","げんいん"],["と"],["なった"],["人","ひと"],["が"],["いれば"],["、"],["その"],["人","ひと"],["は"],["わたし"],["を"],["悲しませた","かなしませた"],["ので"],["は"],["なく"],["、"],["大げさ","おおげさ"],["な"],["表現","ひょうげん"],["は"],["控えます","ひかえます"],["が"],["、"],["あなた"],["がた"],["すべて"],["を"],["ある"],["程度","ていど"],["悲しませた","かなしませた"],["の"],["です"],["。"]]},{"verse":6,"text":"その人には、多数の者から受けたあの罰で十分です。","tok":[["その"],["人","ひと"],["に"],["は"],["、"],["多数","たすう"],["の"],["者","もの"],["から"],["受けた","うけた"],["あの"],["罰","ばつ"],["で"],["十分","じゅうぶん"],["です"],["。"]]},{"verse":7,"text":"むしろ、あなたがたは、その人が悲しみに打ちのめされてしまわないように、赦して、力づけるべきです。","tok":[["むしろ"],["、"],["あなた"],["がた"],["は"],["、"],["その"],["人","ひと"],["が"],["悲しみ","かなしみ"],["に"],["打ちのめされて","うちのめされて"],["しまわない"],["よう"],["に"],["、"],["赦して","ゆるして"],["、"],["力づけるべきです","ちからづけるべきです"],["。"]]},{"verse":8,"text":"そこで、ぜひともその人を愛するようにしてください。","tok":[["そこ"],["で"],["、"],["ぜひ"],["とも"],["その"],["人","ひと"],["を"],["愛する","あいする"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":9,"text":"わたしが前に手紙を書いたのも、あなたがたが万事について従順であるかどうかを試すためでした。","tok":[["わたし"],["が"],["前","まえ"],["に"],["手紙","てがみ"],["を"],["書いた","かいた"],["の"],["も"],["、"],["あなた"],["がた"],["が"],["万事","ばんじ"],["について"],["従順","じゅうじゅん"],["で"],["ある"],["か"],["どう"],["か"],["を"],["試す","ためす"],["ため"],["でした"],["。"]]},{"verse":10,"text":"あなたがたが何かのことで赦す相手は、わたしも赦します。わたしが何かのことで人を赦したとすれば、それは、キリストの前であなたがたのために赦したのです。","tok":[["あなた"],["がた"],["が"],["何","なん"],["か"],["の"],["こと"],["で"],["赦す","ゆるす"],["相手","あいて"],["は"],["、"],["わたし"],["も"],["赦します","ゆるします"],["。"],["わたし"],["が"],["何","なん"],["か"],["の"],["こと"],["で"],["人","ひと"],["を"],["赦した","ゆるした"],["と"],["すれば"],["、"],["それ"],["は"],["、"],["キリスト"],["の"],["前","まえ"],["で"],["あなた"],["がた"],["の"],["ため"],["に"],["赦した","ゆるした"],["の"],["です"],["。"]]},{"verse":11,"text":"わたしたちがそうするのは、サタンにつけ込まれないためです。サタンのやり口は心得ているからです。","tok":[["わたしたち"],["が"],["そう"],["する"],["の"],["は"],["、"],["サタン"],["に"],["つけ込まれない","つけこまれない"],["ため"],["です"],["。"],["サタン"],["の"],["やり口","やりくち"],["は"],["心得て","こころえて"],["いる"],["から"],["です"],["。"]]},{"verse":12,"text":"わたしは、キリストの福音を伝えるためにトロアスに行ったとき、主によってわたしのために門が開かれていましたが、","tok":[["わたし"],["は"],["、"],["キリスト"],["の"],["福音","ふくいん"],["を"],["伝える","つたえる"],["ため"],["に"],["トロアス"],["に"],["行った","いった"],["とき"],["、"],["主に","おもに"],["よって"],["わたし"],["の"],["ため"],["に"],["門","もん"],["が"],["開かれて","ひらかれて"],["いました"],["が"],["、"]]},{"verse":13,"text":"兄弟テトスに会えなかったので、不安の心を抱いたまま人々に別れを告げて、マケドニア州に出発しました。","tok":[["兄弟","きょうだい"],["テトス"],["に"],["会えなかった","あえなかった"],["ので"],["、"],["不安","ふあん"],["の"],["心","こころ"],["を"],["抱いた","いだいた"],["まま"],["人々","ひとびと"],["に"],["別れ","わかれ"],["を"],["告げて","つげて"],["、"],["マケドニア"],["州","しゅう"],["に"],["出発","しゅっぱつ"],["しました"],["。"]]},{"verse":14,"text":"神に感謝します。神は、わたしたちをいつもキリストの勝利の行進に連ならせ、わたしたちを通じて至るところに、キリストを知るという知識の香りを漂わせてくださいます。","tok":[["神","かみ"],["に"],["感謝","かんしゃ"],["します"],["。"],["神","かみ"],["は"],["、"],["わたしたち"],["を"],["いつも"],["キリスト"],["の"],["勝利","しょうり"],["の"],["行進","こうしん"],["に"],["連ならせ","つらならせ"],["、"],["わたしたち"],["を"],["通じて","つうじて"],["至る","いたる"],["ところ"],["に"],["、"],["キリスト"],["を"],["知る","しる"],["と"],["いう"],["知識","ちしき"],["の"],["香り","かおり"],["を"],["漂わせて","ただよわせて"],["くださいます"],["。"]]},{"verse":15,"text":"救いの道をたどる者にとっても、滅びの道をたどる者にとっても、わたしたちはキリストによって神に献げられる良い香りです。","tok":[["救い","すくい"],["の"],["道","みち"],["を"],["たどる"],["者","もの"],["にとって"],["も"],["、"],["滅び","ほろび"],["の"],["道","みち"],["を"],["たどる"],["者","もの"],["にとって"],["も"],["、"],["わたしたち"],["は"],["キリスト"],["によって"],["神","かみ"],["に"],["献げられる","ささげられる"],["良い","よい"],["香り","かおり"],["です"],["。"]]},{"verse":16,"text":"滅びる者には死から死に至らせる香りであり、救われる者には命から命に至らせる香りです。このような務めにだれがふさわしいでしょうか。","tok":[["滅びる","ほろびる"],["者","もの"],["に"],["は"],["死","し"],["から"],["死","し"],["に"],["至らせる","いたらせる"],["香り","かおり"],["で"],["あり"],["、"],["救われる","すくわれる"],["者","もの"],["に"],["は"],["命","いのち"],["から"],["命","いのち"],["に"],["至らせる","いたらせる"],["香り","かおり"],["です"],["。"],["この"],["よう"],["な"],["務め","つとめ"],["に"],["だれ"],["が"],["ふさわしいでしょう"],["か"],["。"]]},{"verse":17,"text":"わたしたちは、多くの人々のように神の言葉を売り物にせず、誠実に、また神に属する者として、神の御前でキリストに結ばれて語っています。","tok":[["わたしたち"],["は"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["の"],["よう"],["に"],["神","かみ"],["の"],["言葉","ことば"],["を"],["売り物","うりもの"],["に"],["せず"],["、"],["誠実","せいじつ"],["に"],["、"],["また"],["神","かみ"],["に"],["属する","ぞくする"],["者","もの"],["として"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["キリスト"],["に"],["結ばれて","むすばれて"],["語って","かたって"],["います"],["。"]]}]
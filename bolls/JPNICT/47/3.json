[{"verse":1,"text":"わたしたちは、またもや自分を推薦し始めているのでしょうか。それとも、ある人々のように、あなたがたへの推薦状、あるいはあなたがたからの推薦状が、わたしたちに必要なのでしょうか。","tok":[["わたしたち"],["は"],["、"],["またもや"],["自分","じぶん"],["を"],["推薦","すいせん"],["し"],["始めて","はじめて"],["いる"],["の"],["でしょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["ある"],["人々","ひとびと"],["の"],["よう"],["に"],["、"],["あなた"],["が"],["たへ"],["の"],["推薦状","すいせんじょう"],["、"],["あるいは"],["あなた"],["がた"],["から"],["の"],["推薦状","すいせんじょう"],["が"],["、"],["わたしたち"],["に"],["必要","ひつよう"],["な"],["の"],["でしょう"],["か"],["。"]]},{"verse":2,"text":"わたしたちの推薦状は、あなたがた自身です。それは、わたしたちの心に書かれており、すべての人々から知られ、読まれています。","tok":[["わたしたち"],["の"],["推薦状","すいせんじょう"],["は"],["、"],["あなた"],["がた"],["自身","じしん"],["です"],["。"],["それ"],["は"],["、"],["わたしたち"],["の"],["心","こころ"],["に"],["書かれて","かかれて"],["おり"],["、"],["すべて"],["の"],["人々","ひとびと"],["から"],["知られ","しられ"],["、"],["読まれて","よまれて"],["います"],["。"]]},{"verse":3,"text":"あなたがたは、キリストがわたしたちを用いてお書きになった手紙として公にされています。墨ではなく生ける神の霊によって、石の板ではなく人の心の板に、書きつけられた手紙です。","tok":[["あなた"],["がた"],["は"],["、"],["キリスト"],["が"],["わたしたち"],["を"],["用いて","もちいて"],["お書き","おかき"],["に"],["なった"],["手紙","てがみ"],["として"],["公","こう"],["に"],["されて"],["います"],["。"],["墨","すみ"],["で"],["は"],["なく"],["生ける","いける"],["神","かみ"],["の"],["霊","れい"],["によって"],["、"],["石","いし"],["の"],["板","いた"],["で"],["は"],["なく"],["人","ひと"],["の"],["心","こころ"],["の"],["板","いた"],["に"],["、"],["書きつけられた","かきつけられた"],["手紙","てがみ"],["です"],["。"]]},{"verse":4,"text":"わたしたちは、キリストによってこのような確信を神の前で抱いています。","tok":[["わたしたち"],["は"],["、"],["キリスト"],["によって"],["この"],["よう"],["な"],["確信","かくしん"],["を"],["神","かみ"],["の"],["前","まえ"],["で"],["抱いて","いだいて"],["います"],["。"]]},{"verse":5,"text":"もちろん、独りで何かできるなどと思う資格が、自分にあるということではありません。わたしたちの資格は神から与えられたものです。","tok":[["もちろん"],["、"],["独り","ひとり"],["で"],["何","なん"],["か"],["できる"],["など"],["と"],["思う","おもう"],["資格","しかく"],["が"],["、"],["自分","じぶん"],["に"],["ある"],["と"],["いう"],["こと"],["で"],["は"],["ありません"],["。"],["わたしたち"],["の"],["資格","しかく"],["は"],["神","かみ"],["から"],["与えられた","あたえられた"],["もの"],["です"],["。"]]},{"verse":6,"text":"神はわたしたちに、新しい契約に仕える資格、文字ではなく霊に仕える資格を与えてくださいました。文字は殺しますが、霊は生かします。","tok":[["神","かみ"],["は"],["わたしたち"],["に"],["、"],["新しい","あたらしい"],["契約","けいやく"],["に"],["仕える","つかえる"],["資格","しかく"],["、"],["文字","もじ"],["で"],["は"],["なく"],["霊","れい"],["に"],["仕える","つかえる"],["資格","しかく"],["を"],["与えて","あたえて"],["くださいました"],["。"],["文字","もじ"],["は"],["殺します","ころします"],["が"],["、"],["霊","れい"],["は"],["生かします","いかします"],["。"]]},{"verse":7,"text":"ところで、石に刻まれた文字に基づいて死に仕える務めさえ栄光を帯びて、モーセの顔に輝いていたつかのまの栄光のために、イスラエルの子らが彼の顔を見つめえないほどであったとすれば、","tok":[["ところ"],["で"],["、"],["石","いし"],["に"],["刻まれた","きざまれた"],["文字","もじ"],["に"],["基づいて","もとづいて"],["死","し"],["に"],["仕える","つかえる"],["務め","つとめ"],["さえ"],["栄光","えいこう"],["を"],["帯びて","おびて"],["、"],["モーセ"],["の"],["顔","かお"],["に"],["輝いて","かがやいて"],["いた"],["つかのま"],["の"],["栄光","えいこう"],["の"],["ため"],["に"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["が"],["彼","かれ"],["の"],["顔","かお"],["を"],["見つめ","みつめ"],["えない"],["ほど"],["で"],["あった"],["と"],["すれば"],["、"]]},{"verse":8,"text":"霊に仕える務めは、なおさら、栄光を帯びているはずではありませんか。","tok":[["霊","れい"],["に"],["仕える","つかえる"],["務め","つとめ"],["は"],["、"],["なおさら"],["、"],["栄光","えいこう"],["を"],["帯びて","おびて"],["いる"],["はず"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":9,"text":"人を罪に定める務めが栄光をまとっていたとすれば、人を義とする務めは、なおさら、栄光に満ちあふれています。","tok":[["人","ひと"],["を"],["罪","つみ"],["に"],["定める","さだめる"],["務め","つとめ"],["が"],["栄光","えいこう"],["を"],["まとって"],["いた"],["と"],["すれば"],["、"],["人","ひと"],["を"],["義","ぎ"],["と"],["する"],["務め","つとめ"],["は"],["、"],["なおさら"],["、"],["栄光","えいこう"],["に"],["満ちあふれて","みちあふれて"],["います"],["。"]]},{"verse":10,"text":"そして、かつて栄光を与えられたものも、この場合、はるかに優れた栄光のために、栄光が失われています。","tok":[["そして"],["、"],["かつて"],["栄光","えいこう"],["を"],["与えられた","あたえられた"],["もの"],["も"],["、"],["この"],["場合","ばあい"],["、"],["はるか"],["に"],["優れた","すぐれた"],["栄光","えいこう"],["の"],["ため"],["に"],["、"],["栄光","えいこう"],["が"],["失われて","うしなわれて"],["います"],["。"]]},{"verse":11,"text":"なぜなら、消え去るべきものが栄光を帯びていたのなら、永続するものは、なおさら、栄光に包まれているはずだからです。","tok":[["なぜ"],["なら"],["、"],["消え去るべき","きえさるべき"],["もの"],["が"],["栄光","えいこう"],["を"],["帯びて","おびて"],["いた"],["の"],["なら"],["、"],["永続","えいぞく"],["する"],["もの"],["は"],["、"],["なおさら"],["、"],["栄光","えいこう"],["に"],["包まれて","つつまれて"],["いる"],["はず"],["だ"],["から"],["です"],["。"]]},{"verse":12,"text":"このような希望を抱いているので、わたしたちは確信に満ちあふれてふるまっており、","tok":[["この"],["よう"],["な"],["希望","きぼう"],["を"],["抱いて","いだいて"],["いる"],["ので"],["、"],["わたしたち"],["は"],["確信","かくしん"],["に"],["満ちあふれて","みちあふれて"],["ふるまって"],["おり"],["、"]]},{"verse":13,"text":"モーセが、消え去るべきものの最後をイスラエルの子らに見られまいとして、自分の顔に覆いを掛けたようなことはしません。","tok":[["モーセ"],["が"],["、"],["消え去るべき","きえさるべき"],["もの"],["の"],["最後","さいご"],["を"],["イスラエル"],["の"],["子","こ"],["ら"],["に"],["見られまい","みられまい"],["として"],["、"],["自分","じぶん"],["の"],["顔","かお"],["に"],["覆い","おおい"],["を"],["掛けた","かけた"],["よう"],["な"],["こと"],["は"],["しません"],["。"]]},{"verse":14,"text":"しかし、彼らの考えは鈍くなってしまいました。今日に至るまで、古い契約が読まれる際に、この覆いは除かれずに掛かったままなのです。それはキリストにおいて取り除かれるものだからです。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["の"],["考え","かんがえ"],["は"],["鈍く","にぶく"],["なって"],["しまいました"],["。"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["古い","ふるい"],["契約","けいやく"],["が"],["読まれる","よまれる"],["際","さい"],["に"],["、"],["この"],["覆い","おおい"],["は"],["除かれず","のぞかれず"],["に"],["掛かった","かかった"],["まま"],["な"],["の"],["です"],["。"],["それ"],["は"],["キリスト"],["に"],["おいて"],["取り除かれる","とりのぞかれる"],["もの"],["だ"],["から"],["です"],["。"]]},{"verse":15,"text":"このため、今日に至るまでモーセの書が読まれるときは、いつでも彼らの心には覆いが掛かっています。","tok":[["この"],["ため"],["、"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["モーセ"],["の"],["書","しょ"],["が"],["読まれる","よまれる"],["とき"],["は"],["、"],["いつ"],["で"],["も"],["彼","かれ"],["ら"],["の"],["心","こころ"],["に"],["は"],["覆い","おおい"],["が"],["掛かって","かかって"],["います"],["。"]]},{"verse":16,"text":"しかし、主の方に向き直れば、覆いは取り去られます。","tok":[["しかし"],["、"],["主","ぬし"],["の"],["方","ほう"],["に"],["向き直れば","むきなおれば"],["、"],["覆い","おおい"],["は"],["取り去られます","とりさられます"],["。"]]},{"verse":17,"text":"ここでいう主とは、“霊”のことですが、主の霊のおられるところに自由があります。","tok":[["ここ"],["で"],["いう"],["主","ぬし"],["と"],["は"],["、"],["“"],["霊","れい"],["”"],["の"],["こと"],["です"],["が"],["、"],["主","ぬし"],["の"],["霊","れい"],["の"],["おられる"],["ところ"],["に"],["自由","じゆう"],["が"],["あります"],["。"]]},{"verse":18,"text":"わたしたちは皆、顔の覆いを除かれて、鏡のように主の栄光を映し出しながら、栄光から栄光へと、主と同じ姿に造りかえられていきます。これは主の霊の働きによることです。","tok":[["わたしたち"],["は"],["皆","みな"],["、"],["顔","かお"],["の"],["覆い","おおい"],["を"],["除かれて","のぞかれて"],["、"],["鏡","かがみ"],["の"],["よう"],["に"],["主","ぬし"],["の"],["栄光","えいこう"],["を"],["映し出し","うつしだし"],["ながら"],["、"],["栄光","えいこう"],["から"],["栄光","えいこう"],["へ"],["と"],["、"],["主","ぬし"],["と"],["同じ","おなじ"],["姿","すがた"],["に"],["造りかえられて","つくりかえられて"],["いきます"],["。"],["これ"],["は"],["主","ぬし"],["の"],["霊","れい"],["の"],["働き","はたらき"],["に"],["よる"],["こと"],["です"],["。"]]}]
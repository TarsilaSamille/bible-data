[{"verse":1,"text":"神の御心によってキリスト‧イエスの使徒とされたパウロと、兄弟テモテから、コリントにある神の教会と、アカイア州の全地方に住むすべての聖なる者たちへ。","tok":[["神","かみ"],["の"],["御心","おこころ"],["によって"],["キリスト"],["‧"],["イエス"],["の"],["使徒","しと"],["と"],["された"],["パウロ"],["と"],["、"],["兄弟","きょうだい"],["テモテ"],["から"],["、"],["コリント"],["に"],["ある"],["神","かみ"],["の"],["教会","きょうかい"],["と"],["、"],["アカイア"],["州","しゅう"],["の"],["全","ぜん"],["地方","ちほう"],["に"],["住む","すむ"],["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["たち"],["へ"],["。"]]},{"verse":2,"text":"わたしたちの父である神と主イエス‧キリストからの恵みと平和が、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["から"],["の"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしたちの主イエス‧キリストの父である神、慈愛に満ちた父、慰めを豊かにくださる神がほめたたえられますように。","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["、"],["慈愛","じあい"],["に"],["満ちた","みちた"],["父","ちち"],["、"],["慰め","なぐさめ"],["を"],["豊か","ゆたか"],["に"],["くださる"],["神","かみ"],["が"],["ほめたたえられます"],["よう"],["に"],["。"]]},{"verse":4,"text":"神は、あらゆる苦難に際してわたしたちを慰めてくださるので、わたしたちも神からいただくこの慰めによって、あらゆる苦難の中にある人々を慰めることができます。","tok":[["神","かみ"],["は"],["、"],["あらゆる"],["苦難","くなん"],["に"],["際して","さいして"],["わたしたち"],["を"],["慰めて","なぐさめて"],["くださる"],["ので"],["、"],["わたしたち"],["も"],["神","かみ"],["から"],["いただく"],["この"],["慰め","なぐさめ"],["によって"],["、"],["あらゆる"],["苦難","くなん"],["の"],["中","なか"],["に"],["ある"],["人々","ひとびと"],["を"],["慰める","なぐさめる"],["こと"],["が"],["できます"],["。"]]},{"verse":5,"text":"キリストの苦しみが満ちあふれてわたしたちにも及んでいるのと同じように、わたしたちの受ける慰めもキリストによって満ちあふれているからです。","tok":[["キリスト"],["の"],["苦しみ","くるしみ"],["が"],["満ちあふれて","みちあふれて"],["わたしたち"],["に"],["も"],["及んで","およんで"],["いる"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["わたしたち"],["の"],["受ける","うける"],["慰め","なぐさめ"],["も"],["キリスト"],["によって"],["満ちあふれて","みちあふれて"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"わたしたちが悩み苦しむとき、それはあなたがたの慰めと救いになります。また、わたしたちが慰められるとき、それはあなたがたの慰めになり、あなたがたがわたしたちの苦しみと同じ苦しみに耐えることができるのです。","tok":[["わたしたち"],["が"],["悩み苦しむ","なやみくるしむ"],["とき"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["慰め","なぐさめ"],["と"],["救い","すくい"],["に"],["なります"],["。"],["また"],["、"],["わたしたち"],["が"],["慰められる","なぐさめられる"],["とき"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["慰め","なぐさめ"],["に"],["なり"],["、"],["あなた"],["がた"],["が"],["わたしたち"],["の"],["苦しみ","くるしみ"],["と"],["同じ","おなじ"],["苦しみ","くるしみ"],["に"],["耐える","たえる"],["こと"],["が"],["できる"],["の"],["です"],["。"]]},{"verse":7,"text":"あなたがたについてわたしたちが抱いている希望は揺るぎません。なぜなら、あなたがたが苦しみを共にしてくれているように、慰めをも共にしていると、わたしたちは知っているからです。","tok":[["あなた"],["がた"],["について"],["わたしたち"],["が"],["抱いて","いだいて"],["いる"],["希望","きぼう"],["は"],["揺るぎません","ゆるぎません"],["。"],["なぜ"],["なら"],["、"],["あなた"],["がた"],["が"],["苦しみ","くるしみ"],["を"],["共","とも"],["に"],["して"],["くれて"],["いる"],["よう"],["に"],["、"],["慰め","なぐさめ"],["を"],["も"],["共","とも"],["に"],["して"],["いる"],["と"],["、"],["わたしたち"],["は"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":8,"text":"兄弟たち、アジア州でわたしたちが被った苦難について、ぜひ知っていてほしい。わたしたちは耐えられないほどひどく圧迫されて、生きる望みさえ失ってしまいました。","tok":[["兄弟","きょうだい"],["たち"],["、"],["アジア州","あじあしゅう"],["で"],["わたしたち"],["が"],["被った","かぶった"],["苦難","くなん"],["について"],["、"],["ぜひ"],["知って","しって"],["いて"],["ほしい"],["。"],["わたしたち"],["は"],["耐えられない","たえられない"],["ほど"],["ひどく"],["圧迫","あっぱく"],["されて"],["、"],["生きる","いきる"],["望み","のぞみ"],["さえ"],["失って","うしなって"],["しまいました"],["。"]]},{"verse":9,"text":"わたしたちとしては死の宣告を受けた思いでした。それで、自分を頼りにすることなく、死者を復活させてくださる神を頼りにするようになりました。","tok":[["わたしたち"],["として"],["は"],["死","し"],["の"],["宣告","せんこく"],["を"],["受けた","うけた"],["思い","おもい"],["でした"],["。"],["それ"],["で"],["、"],["自分","じぶん"],["を"],["頼り","たより"],["に"],["する"],["こと"],["なく"],["、"],["死者","ししゃ"],["を"],["復活","ふっかつ"],["させて"],["くださる"],["神","かみ"],["を"],["頼り","たより"],["に"],["する"],["よう"],["に"],["なりました"],["。"]]},{"verse":10,"text":"神は、これほど大きな死の危険からわたしたちを救ってくださったし、また救ってくださることでしょう。これからも救ってくださるにちがいないと、わたしたちは神に希望をかけています。","tok":[["神","かみ"],["は"],["、"],["これ"],["ほど"],["大きな","おおきな"],["死","し"],["の"],["危険","きけん"],["から"],["わたしたち"],["を"],["救って","すくって"],["くださった"],["し"],["、"],["また"],["救って","すくって"],["くださる"],["こと"],["でしょう"],["。"],["これ"],["から"],["も"],["救って","すくって"],["くださる"],["に"],["ちがい"],["ない"],["と"],["、"],["わたしたち"],["は"],["神","かみ"],["に"],["希望","きぼう"],["を"],["かけて"],["います"],["。"]]},{"verse":11,"text":"あなたがたも祈りで援助してください。そうすれば、多くの人のお陰でわたしたちに与えられた恵みについて、多くの人々がわたしたちのために感謝をささげてくれるようになるのです。","tok":[["あなた"],["がた"],["も"],["祈り","いのり"],["で"],["援助","えんじょ"],["して"],["ください"],["。"],["そう"],["すれば"],["、"],["多く","おおく"],["の"],["人","ひと"],["の"],["お陰","おかげ"],["で"],["わたしたち"],["に"],["与えられた","あたえられた"],["恵み","めぐみ"],["について"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["わたしたち"],["の"],["ため"],["に"],["感謝","かんしゃ"],["を"],["ささげて"],["くれる"],["よう"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":12,"text":"わたしたちは世の中で、とりわけあなたがたに対して、人間の知恵によってではなく、神から受けた純真と誠実によって、神の恵みの下に行動してきました。このことは、良心も証しするところで、わたしたちの誇りです。","tok":[["わたしたち"],["は"],["世の中","よのなか"],["で"],["、"],["とりわけ"],["あなた"],["がた"],["に対して","にたいして"],["、"],["人間","にんげん"],["の"],["知恵","ちえ"],["によって"],["で"],["は"],["なく"],["、"],["神","かみ"],["から"],["受けた","うけた"],["純真","じゅんしん"],["と"],["誠実","せいじつ"],["によって"],["、"],["神","かみ"],["の"],["恵み","めぐみ"],["の"],["下","した"],["に"],["行動","こうどう"],["して"],["きました"],["。"],["この"],["こと"],["は"],["、"],["良心","りょうしん"],["も"],["証し","あかし"],["する"],["ところ"],["で"],["、"],["わたしたち"],["の"],["誇り","ほこり"],["です"],["。"]]},{"verse":13,"text":"わたしたちは、あなたがたが読み、また理解できること以外何も書いていません。あなたがたは、わたしたちをある程度理解しているのですから、わたしたちの主イエスの来られる日に、わたしたちにとってもあなたがたが誇りであるように、あなたがたにとってもわたしたちが誇りであることを、十分に理解してもらいたい。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["が"],["読み","よみ"],["、"],["また"],["理解","りかい"],["できる"],["こと"],["以外","いがい"],["何","なん"],["も"],["書いて","かいて"],["いません"],["。"],["あなた"],["がた"],["は"],["、"],["わたしたち"],["を"],["ある"],["程度","ていど"],["理解","りかい"],["して"],["いる"],["の"],["です"],["から"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["の"],["来られる","こられる"],["日","ひ"],["に"],["、"],["わたしたち"],["にとって"],["も"],["あなた"],["がた"],["が"],["誇り","ほこり"],["で"],["ある"],["よう"],["に"],["、"],["あなた"],["がた"],["にとって"],["も"],["わたしたち"],["が"],["誇り","ほこり"],["で"],["ある"],["こと"],["を"],["、"],["十分","じゅうぶん"],["に"],["理解","りかい"],["して"],["もらいたい"],["。"]]},{"verse":15,"text":"このような確信に支えられて、わたしは、あなたがたがもう一度恵みを受けるようにと、まずあなたがたのところへ行く計画を立てました。","tok":[["この"],["よう"],["な"],["確信","かくしん"],["に"],["支えられて","ささえられて"],["、"],["わたし"],["は"],["、"],["あなた"],["がた"],["が"],["もう"],["一度","いちど"],["恵み","めぐみ"],["を"],["受ける","うける"],["よう"],["に"],["と"],["、"],["まず"],["あなた"],["がた"],["の"],["ところ"],["へ"],["行く","いく"],["計画","けいかく"],["を"],["立てました","たてました"],["。"]]},{"verse":16,"text":"そして、そちらを経由してマケドニア州に赴き、マケドニア州から再びそちらに戻って、ユダヤへ送り出してもらおうと考えたのでした。","tok":[["そして"],["、"],["そちら"],["を"],["経由","けいゆ"],["して"],["マケドニア"],["州","しゅう"],["に"],["赴き","おもむき"],["、"],["マケドニア"],["州","しゅう"],["から"],["再び","ふたたび"],["そちら"],["に"],["戻って","もどって"],["、"],["ユダヤ"],["へ"],["送り出して","おくりだして"],["もらおう"],["と"],["考えた","かんがえた"],["の"],["でした"],["。"]]},{"verse":17,"text":"このような計画を立てたのは、軽はずみだったでしょうか。それとも、わたしが計画するのは、人間的な考えによることで、わたしにとって「然り、然り」が同時に「否、否」となるのでしょうか。","tok":[["この"],["よう"],["な"],["計画","けいかく"],["を"],["立てた","たてた"],["の"],["は"],["、"],["軽はずみ","かるはずみ"],["だったでしょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["わたし"],["が"],["計画","けいかく"],["する"],["の"],["は"],["、"],["人間的","にんげんてき"],["な"],["考え","かんがえ"],["に"],["よる"],["こと"],["で"],["、"],["わたし"],["にとって"],["「"],["然り","しかり"],["、"],["然り","しかり"],["」"],["が"],["同時","どうじ"],["に"],["「"],["否","いな"],["、"],["否","いな"],["」"],["と"],["なる"],["の"],["でしょう"],["か"],["。"]]},{"verse":18,"text":"神は真実な方です。だから、あなたがたに向けたわたしたちの言葉は、「然り」であると同時に「否」であるというものではありません。","tok":[["神","かみ"],["は"],["真実","しんじつ"],["な"],["方","ほう"],["です"],["。"],["だ"],["から"],["、"],["あなた"],["がた"],["に"],["向けた","むけた"],["わたしたち"],["の"],["言葉","ことば"],["は"],["、"],["「"],["然り","しかり"],["」"],["で"],["ある"],["と"],["同時","どうじ"],["に"],["「"],["否","いな"],["」"],["で"],["ある"],["と"],["いう"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":19,"text":"わたしたち、つまり、わたしとシルワノとテモテが、あなたがたの間で宣べ伝えた神の子イエス‧キリストは、「然り」と同時に「否」となったような方ではありません。この方においては「然り」だけが実現したのです。","tok":[["わたしたち"],["、"],["つまり"],["、"],["わたし"],["と"],["シルワノ"],["と"],["テモテ"],["が"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["宣べ伝えた","のべつたえた"],["神","かみ"],["の"],["子","こ"],["イエス"],["‧"],["キリスト"],["は"],["、"],["「"],["然り","しかり"],["」"],["と"],["同時","どうじ"],["に"],["「"],["否","いな"],["」"],["と"],["なった"],["よう"],["な"],["方","かた"],["で"],["は"],["ありません"],["。"],["この"],["方","かた"],["に"],["おいて"],["は"],["「"],["然り","しかり"],["」"],["だけ"],["が"],["実現","じつげん"],["した"],["の"],["です"],["。"]]},{"verse":20,"text":"神の約束は、ことごとくこの方において「然り」となったからです。それで、わたしたちは神をたたえるため、この方を通して「アーメン」と唱えます。","tok":[["神","かみ"],["の"],["約束","やくそく"],["は"],["、"],["ことごとく"],["この"],["方","かた"],["に"],["おいて"],["「"],["然り","しかり"],["」"],["と"],["なった"],["から"],["です"],["。"],["それ"],["で"],["、"],["わたしたち"],["は"],["神","かみ"],["を"],["たたえる"],["ため"],["、"],["この"],["方","ほう"],["を"],["通して","とおして"],["「"],["アーメン"],["」"],["と"],["唱えます","となえます"],["。"]]},{"verse":21,"text":"わたしたちとあなたがたとをキリストに固く結び付け、わたしたちに油を注いでくださったのは、神です。","tok":[["わたしたち"],["と"],["あなた"],["がた"],["と"],["を"],["キリスト"],["に"],["固く","かたく"],["結び付け","むすびつけ"],["、"],["わたしたち"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["くださった"],["の"],["は"],["、"],["神","かみ"],["です"],["。"]]},{"verse":22,"text":"神はまた、わたしたちに証印を押して、保証としてわたしたちの心に“霊”を与えてくださいました。","tok":[["神","かみ"],["は"],["また"],["、"],["わたしたち"],["に"],["証印","しょういん"],["を"],["押して","おして"],["、"],["保証","ほしょう"],["として"],["わたしたち"],["の"],["心","こころ"],["に"],["“"],["霊","れい"],["”"],["を"],["与えて","あたえて"],["くださいました"],["。"]]},{"verse":23,"text":"神を証人に立てて、命にかけて誓いますが、わたしがまだコリントに行かずにいるのは、あなたがたへの思いやりからです。","tok":[["神","かみ"],["を"],["証人","しょうにん"],["に"],["立てて","たてて"],["、"],["命","いのち"],["に"],["かけて"],["誓います","ちかいます"],["が"],["、"],["わたし"],["が"],["まだ"],["コリント"],["に"],["行かず","いかず"],["に"],["いる"],["の"],["は"],["、"],["あなた"],["が"],["たへ"],["の"],["思いやり","おもいやり"],["から"],["です"],["。"]]},{"verse":24,"text":"わたしたちは、あなたがたの信仰を支配するつもりはなく、むしろ、あなたがたの喜びのために協力する者です。あなたがたは信仰に基づいてしっかり立っているからです。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["を"],["支配","しはい"],["する"],["つもり"],["は"],["なく"],["、"],["むしろ"],["、"],["あなた"],["がた"],["の"],["喜び","よろこび"],["の"],["ため"],["に"],["協力","きょうりょく"],["する"],["者","もの"],["です"],["。"],["あなた"],["がた"],["は"],["信仰","しんこう"],["に"],["基づいて","もとづいて"],["しっかり"],["立って","たって"],["いる"],["から"],["です"],["。"]]}]
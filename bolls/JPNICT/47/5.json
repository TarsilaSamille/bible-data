[{"verse":1,"text":"わたしたちの地上の住みかである幕屋が滅びても、神によって建物が備えられていることを、わたしたちは知っています。人の手で造られたものではない天にある永遠の住みかです。","tok":[["わたしたち"],["の"],["地上","ちじょう"],["の"],["住みか","すみか"],["で"],["ある"],["幕屋","まくや"],["が"],["滅びて","ほろびて"],["も"],["、"],["神","かみ"],["によって"],["建物","たてもの"],["が"],["備えられて","そなえられて"],["いる"],["こと"],["を"],["、"],["わたしたち"],["は"],["知って","しって"],["います"],["。"],["人","ひと"],["の"],["手","て"],["で"],["造られた","つくられた"],["もの"],["で"],["は"],["ない"],["天","てん"],["に"],["ある"],["永遠","えいえん"],["の"],["住みか","すみか"],["です"],["。"]]},{"verse":2,"text":"わたしたちは、天から与えられる住みかを上に着たいと切に願って、この地上の幕屋にあって苦しみもだえています。","tok":[["わたしたち"],["は"],["、"],["天","てん"],["から"],["与えられる","あたえられる"],["住みか","すみか"],["を"],["上","うえ"],["に"],["着たい","きたい"],["と"],["切に","せつに"],["願って","ねがって"],["、"],["この"],["地上","ちじょう"],["の"],["幕屋","まくや"],["に"],["あって"],["苦しみもだえて","くるしみもだえて"],["います"],["。"]]},{"verse":3,"text":"それを脱いでも、わたしたちは裸のままではおりません。","tok":[["それ"],["を"],["脱いで","ぬいで"],["も"],["、"],["わたしたち"],["は"],["裸","はだか"],["の"],["まま"],["で"],["は"],["おりません"],["。"]]},{"verse":4,"text":"この幕屋に住むわたしたちは重荷を負ってうめいておりますが、それは、地上の住みかを脱ぎ捨てたいからではありません。死ぬはずのものが命に飲み込まれてしまうために、天から与えられる住みかを上に着たいからです。","tok":[["この"],["幕屋","まくや"],["に"],["住む","すむ"],["わたしたち"],["は"],["重荷","おもに"],["を"],["負って","おって"],["うめいて"],["おります"],["が"],["、"],["それ"],["は"],["、"],["地上","ちじょう"],["の"],["住みか","すみか"],["を"],["脱ぎ捨てたい","ぬぎすてたい"],["から"],["で"],["は"],["ありません"],["。"],["死ぬ","しぬ"],["はず"],["の"],["もの"],["が"],["命","いのち"],["に"],["飲み込まれて","のみこまれて"],["しまう"],["ため"],["に"],["、"],["天","てん"],["から"],["与えられる","あたえられる"],["住みか","すみか"],["を"],["上","うえ"],["に"],["着たい","きたい"],["から"],["です"],["。"]]},{"verse":5,"text":"わたしたちを、このようになるのにふさわしい者としてくださったのは、神です。神は、その保証として“霊”を与えてくださったのです。","tok":[["わたしたち"],["を"],["、"],["この"],["よう"],["に"],["なる"],["のに"],["ふさわしい"],["者","もの"],["として"],["くださった"],["の"],["は"],["、"],["神","かみ"],["です"],["。"],["神","かみ"],["は"],["、"],["その"],["保証","ほしょう"],["として"],["“"],["霊","れい"],["”"],["を"],["与えて","あたえて"],["くださった"],["の"],["です"],["。"]]},{"verse":6,"text":"それで、わたしたちはいつも心強いのですが、体を住みかとしているかぎり、主から離れていることも知っています。","tok":[["それ"],["で"],["、"],["わたしたち"],["は"],["いつも"],["心強い","こころづよい"],["の"],["です"],["が"],["、"],["体","からだ"],["を"],["住みか","すみか"],["として"],["いる"],["かぎり"],["、"],["主","ぬし"],["から"],["離れて","はなれて"],["いる"],["こと"],["も"],["知って","しって"],["います"],["。"]]},{"verse":7,"text":"目に見えるものによらず、信仰によって歩んでいるからです。","tok":[["目","め"],["に"],["見える","みえる"],["もの"],["に"],["よらず"],["、"],["信仰","しんこう"],["によって"],["歩んで","あゆんで"],["いる"],["から"],["です"],["。"]]},{"verse":8,"text":"わたしたちは、心強い。そして、体を離れて、主のもとに住むことをむしろ望んでいます。","tok":[["わたしたち"],["は"],["、"],["心強い","こころづよい"],["。"],["そして"],["、"],["体","からだ"],["を"],["離れて","はなれて"],["、"],["主","ぬし"],["の"],["もと"],["に"],["住む","すむ"],["こと"],["を"],["むしろ"],["望んで","のぞんで"],["います"],["。"]]},{"verse":9,"text":"だから、体を住みかとしていても、体を離れているにしても、ひたすら主に喜ばれる者でありたい。","tok":[["だ"],["から"],["、"],["体","からだ"],["を"],["住みか","すみか"],["として"],["いて"],["も"],["、"],["体","からだ"],["を"],["離れて","はなれて"],["いる"],["に"],["して"],["も"],["、"],["ひたすら"],["主に","おもに"],["喜ばれる","よろこばれる"],["者","もの"],["で"],["ありたい"],["。"]]},{"verse":10,"text":"なぜなら、わたしたちは皆、キリストの裁きの座の前に立ち、善であれ悪であれ、めいめい体を住みかとしていたときに行ったことに応じて、報いを受けねばならないからです。","tok":[["なぜ"],["なら"],["、"],["わたしたち"],["は"],["皆","みな"],["、"],["キリスト"],["の"],["裁き","さばき"],["の"],["座","ざ"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["善","ぜん"],["で"],["あれ"],["悪","わる"],["で"],["あれ"],["、"],["めいめい"],["体","たい"],["を"],["住みか","すみか"],["として"],["いた"],["とき"],["に"],["行った","いった"],["こと"],["に"],["応じて","おうじて"],["、"],["報い","むくい"],["を"],["受けねば","うけねば"],["ならない"],["から"],["です"],["。"]]},{"verse":11,"text":"主に対する畏れを知っているわたしたちは、人々の説得に努めます。わたしたちは、神にはありのままに知られています。わたしは、あなたがたの良心にもありのままに知られたいと思います。","tok":[["主","ぬし"],["に"],["対する","たいする"],["畏れ","おそれ"],["を"],["知って","しって"],["いる"],["わたしたち"],["は"],["、"],["人々","ひとびと"],["の"],["説得","せっとく"],["に"],["努めます","つとめます"],["。"],["わたしたち"],["は"],["、"],["神","かみ"],["に"],["は"],["ありのまま"],["に"],["知られて","しられて"],["います"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["良心","りょうしん"],["に"],["も"],["ありのまま"],["に"],["知られたい","しられたい"],["と"],["思います","おもいます"],["。"]]},{"verse":12,"text":"わたしたちは、あなたがたにもう一度自己推薦をしようというのではありません。ただ、内面ではなく、外面を誇っている人々に応じられるように、わたしたちのことを誇る機会をあなたがたに提供しているのです。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["に"],["もう"],["一","いち"],["度","ど"],["自己","じこ"],["推薦","すいせん"],["を"],["しよう"],["と"],["いう"],["ので"],["は"],["ありません"],["。"],["ただ"],["、"],["内面","ないめん"],["で"],["は"],["なく"],["、"],["外面","そとづら"],["を"],["誇って","ほこって"],["いる"],["人々","ひとびと"],["に"],["応じられる","おうじられる"],["よう"],["に"],["、"],["わたしたち"],["の"],["こと"],["を"],["誇る","ほこる"],["機会","きかい"],["を"],["あなた"],["がた"],["に"],["提供","ていきょう"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":13,"text":"わたしたちが正気でないとするなら、それは神のためであったし、正気であるなら、それはあなたがたのためです。","tok":[["わたしたち"],["が"],["正気","しょうき"],["で"],["ない"],["と"],["するなら"],["、"],["それ"],["は"],["神","かみ"],["の"],["ため"],["で"],["あった"],["し"],["、"],["正気","しょうき"],["で"],["あるなら"],["、"],["それ"],["は"],["あなた"],["がた"],["の"],["ため"],["です"],["。"]]},{"verse":14,"text":"なぜなら、キリストの愛がわたしたちを駆り立てているからです。わたしたちはこう考えます。すなわち、一人の方がすべての人のために死んでくださった以上、すべての人も死んだことになります。","tok":[["なぜ"],["なら"],["、"],["キリスト"],["の"],["愛","あい"],["が"],["わたしたち"],["を"],["駆り立てて","かりたてて"],["いる"],["から"],["です"],["。"],["わたしたち"],["は"],["こう"],["考えます","かんがえます"],["。"],["すなわち"],["、"],["一人","ひとり"],["の"],["方","ほう"],["が"],["すべて"],["の"],["人","ひと"],["の"],["ため"],["に"],["死んで","しんで"],["くださった"],["以上","いじょう"],["、"],["すべて"],["の"],["人","ひと"],["も"],["死んだ","しんだ"],["こと"],["に"],["なります"],["。"]]},{"verse":15,"text":"その一人の方はすべての人のために死んでくださった。その目的は、生きている人たちが、もはや自分自身のために生きるのではなく、自分たちのために死んで復活してくださった方のために生きることなのです。","tok":[["その"],["一人","ひとり"],["の"],["方","ほう"],["は"],["すべて"],["の"],["人","ひと"],["の"],["ため"],["に"],["死んで","しんで"],["くださった"],["。"],["その"],["目的","もくてき"],["は"],["、"],["生きて","いきて"],["いる"],["人","ひと"],["たち"],["が"],["、"],["もはや"],["自分","じぶん"],["自身","じしん"],["の"],["ため"],["に"],["生きる","いきる"],["ので"],["は"],["なく"],["、"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["死んで","しんで"],["復活","ふっかつ"],["して"],["くださった"],["方","ほう"],["の"],["ため"],["に"],["生きる","いきる"],["こと"],["な"],["の"],["です"],["。"]]},{"verse":16,"text":"それで、わたしたちは、今後だれをも肉に従って知ろうとはしません。肉に従ってキリストを知っていたとしても、今はもうそのように知ろうとはしません。","tok":[["それ"],["で"],["、"],["わたしたち"],["は"],["、"],["今後","こんご"],["だれ"],["を"],["も"],["肉","にく"],["に"],["従って","したがって"],["知ろう","しろう"],["と"],["は"],["しません"],["。"],["肉","にく"],["に"],["従って","したがって"],["キリスト"],["を"],["知って","しって"],["いた"],["として"],["も"],["、"],["今","いま"],["は"],["もう"],["その"],["よう"],["に"],["知ろう","しろう"],["と"],["は"],["しません"],["。"]]},{"verse":17,"text":"だから、キリストと結ばれる人はだれでも、新しく創造された者なのです。古いものは過ぎ去り、新しいものが生じた。","tok":[["だ"],["から"],["、"],["キリスト"],["と"],["結ばれる","むすばれる"],["人","ひと"],["は"],["だれ"],["で"],["も"],["、"],["新しく","あたらしく"],["創造","そうぞう"],["された"],["者","もの"],["な"],["の"],["です"],["。"],["古い","ふるい"],["もの"],["は"],["過ぎ去り","すぎさり"],["、"],["新しい","あたらしい"],["もの"],["が"],["生じた","しょうじた"],["。"]]},{"verse":18,"text":"これらはすべて神から出ることであって、神は、キリストを通してわたしたちを御自分と和解させ、また、和解のために奉仕する任務をわたしたちにお授けになりました。","tok":[["これ"],["ら"],["は"],["すべて"],["神","かみ"],["から"],["出る","でる"],["こと"],["で"],["あって"],["、"],["神","かみ"],["は"],["、"],["キリスト"],["を"],["通して","とおして"],["わたしたち"],["を"],["御自分","ごじぶん"],["と"],["和解","わかい"],["させ"],["、"],["また"],["、"],["和解","わかい"],["の"],["ため"],["に"],["奉仕","ほうし"],["する"],["任務","にんむ"],["を"],["わたしたち"],["に"],["お授け","おさずけ"],["に"],["なりました"],["。"]]},{"verse":19,"text":"つまり、神はキリストによって世を御自分と和解させ、人々の罪の責任を問うことなく、和解の言葉をわたしたちにゆだねられたのです。","tok":[["つまり"],["、"],["神","かみ"],["は"],["キリスト"],["によって"],["世","よ"],["を"],["御自分","ごじぶん"],["と"],["和解","わかい"],["させ"],["、"],["人々","ひとびと"],["の"],["罪","つみ"],["の"],["責任","せきにん"],["を"],["問う","とう"],["こと"],["なく"],["、"],["和解","わかい"],["の"],["言葉","ことば"],["を"],["わたしたち"],["に"],["ゆだねられた"],["の"],["です"],["。"]]},{"verse":20,"text":"ですから、神がわたしたちを通して勧めておられるので、わたしたちはキリストの使者の務めを果たしています。キリストに代わってお願いします。神と和解させていただきなさい。","tok":[["です"],["から"],["、"],["神","かみ"],["が"],["わたしたち"],["を"],["通して","とおして"],["勧めて","すすめて"],["おられる"],["ので"],["、"],["わたしたち"],["は"],["キリスト"],["の"],["使者","ししゃ"],["の"],["務め","つとめ"],["を"],["果たして","はたして"],["います"],["。"],["キリスト"],["に"],["代わって","かわって"],["お願い","おねがい"],["します"],["。"],["神","かみ"],["と"],["和解","わかい"],["させて"],["いただき"],["なさい"],["。"]]},{"verse":21,"text":"罪と何のかかわりもない方を、神はわたしたちのために罪となさいました。わたしたちはその方によって神の義を得ることができたのです。","tok":[["罪","つみ"],["と"],["何","なん"],["の"],["かかわり"],["も"],["ない"],["方","ほう"],["を"],["、"],["神","かみ"],["は"],["わたしたち"],["の"],["ため"],["に"],["罪","つみ"],["と"],["なさいました"],["。"],["わたしたち"],["は"],["その"],["方","かた"],["によって"],["神","かみ"],["の"],["義","ぎ"],["を"],["得る","える"],["こと"],["が"],["できた"],["の"],["です"],["。"]]}]
[{"verse":1,"text":"わたしがあなたがたのところに行くのは、これで三度目です。すべてのことは、二人ないし三人の証人の口によって確定されるべきです。","tok":[["わたし"],["が"],["あなた"],["がた"],["の"],["ところ"],["に"],["行く","いく"],["の"],["は"],["、"],["これ"],["で"],["三度目","さんどめ"],["です"],["。"],["すべて"],["の"],["こと"],["は"],["、"],["二人","ふたり"],["ないし"],["三人","さんにん"],["の"],["証人","しょうにん"],["の"],["口","くち"],["によって"],["確定","かくてい"],["されるべきです"],["。"]]},{"verse":2,"text":"以前罪を犯した人と、他のすべての人々に、そちらでの二度目の滞在中に前もって言っておいたように、離れている今もあらかじめ言っておきます。今度そちらに行ったら、容赦しません。","tok":[["以前罪","いぜんざい"],["を"],["犯した","おかした"],["人","ひと"],["と"],["、"],["他","た"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["、"],["そちら"],["で"],["の"],["二度目","にどめ"],["の"],["滞在中","たいざいちゅう"],["に"],["前もって","まえもって"],["言って","いって"],["おいた"],["よう"],["に"],["、"],["離れて","はなれて"],["いる"],["今","いま"],["も"],["あらかじめ"],["言って","いって"],["おきます"],["。"],["今度","こんど"],["そちら"],["に"],["行ったら","いったら"],["、"],["容赦","ようしゃ"],["しません"],["。"]]},{"verse":3,"text":"なぜなら、あなたがたはキリストがわたしによって語っておられる証拠を求めているからです。キリストはあなたがたに対しては弱い方でなく、あなたがたの間で強い方です。","tok":[["なぜ"],["なら"],["、"],["あなた"],["がた"],["は"],["キリスト"],["が"],["わたし"],["によって"],["語って","かたって"],["おられる"],["証拠","しょうこ"],["を"],["求めて","もとめて"],["いる"],["から"],["です"],["。"],["キリスト"],["は"],["あなた"],["がた"],["に対して","にたいして"],["は"],["弱い","よわい"],["方","ほう"],["で"],["なく"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["強い","つよい"],["方","ほう"],["です"],["。"]]},{"verse":4,"text":"キリストは、弱さのゆえに十字架につけられましたが、神の力によって生きておられるのです。わたしたちもキリストに結ばれた者として弱い者ですが、しかし、あなたがたに対しては、神の力によってキリストと共に生きています。","tok":[["キリスト"],["は"],["、"],["弱","よわ"],["さ"],["の"],["ゆえ"],["に"],["十字架","じゅうじか"],["に"],["つけられました"],["が"],["、"],["神","かみ"],["の"],["力","ちから"],["によって"],["生きて","いきて"],["おられる"],["の"],["です"],["。"],["わたしたち"],["も"],["キリスト"],["に"],["結ばれた","むすばれた"],["者","もの"],["として"],["弱い","よわい"],["者","もの"],["です"],["が"],["、"],["しかし"],["、"],["あなた"],["がた"],["に"],["対し","たいし"],["ては"],["、"],["神","かみ"],["の"],["力","ちから"],["によって"],["キリスト"],["と"],["共","とも"],["に"],["生きて","いきて"],["います"],["。"]]},{"verse":5,"text":"信仰を持って生きているかどうか自分を反省し、自分を吟味しなさい。あなたがたは自分自身のことが分からないのですか。イエス‧キリストがあなたがたの内におられることが。あなたがたが失格者なら別ですが……。","tok":[["信仰","しんこう"],["を"],["持って","もって"],["生きて","いきて"],["いる"],["か"],["どう"],["か"],["自分","じぶん"],["を"],["反省","はんせい"],["し"],["、"],["自分","じぶん"],["を"],["吟味","ぎんみ"],["し"],["なさい"],["。"],["あなた"],["がた"],["は"],["自分","じぶん"],["自身","じしん"],["の"],["こと"],["が"],["分からない","わからない"],["の"],["です"],["か"],["。"],["イエス"],["‧"],["キリスト"],["が"],["あなた"],["がた"],["の"],["内","うち"],["に"],["おられる"],["こと"],["が"],["。"],["あなた"],["がた"],["が"],["失格者","しっかくしゃ"],["なら"],["別","べつ"],["です"],["が"],["…"],["…"],["。"]]},{"verse":6,"text":"わたしたちが失格者でないことを、あなたがたが知るようにと願っています。","tok":[["わたしたち"],["が"],["失格者","しっかくしゃ"],["で"],["ない"],["こと"],["を"],["、"],["あなた"],["がた"],["が"],["知る","しる"],["よう"],["に"],["と"],["願って","ねがって"],["います"],["。"]]},{"verse":7,"text":"わたしたちは、あなたがたがどんな悪も行わないようにと、神に祈っています。それはわたしたちが、適格者と見なされたいからではなく、たとえ失格者と見えようとも、あなたがたが善を行うためなのです。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["が"],["どんな"],["悪","あく"],["も"],["行わない","おこなわない"],["よう"],["に"],["と"],["、"],["神","かみ"],["に"],["祈って","いのって"],["います"],["。"],["それ"],["は"],["わたしたち"],["が"],["、"],["適格者","てきかくしゃ"],["と"],["見なされたい","みなされたい"],["から"],["で"],["は"],["なく"],["、"],["たとえ"],["失格者","しっかくしゃ"],["と"],["見えよう","みえよう"],["とも"],["、"],["あなた"],["がた"],["が"],["善","ぜん"],["を"],["行う","おこなう"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":8,"text":"わたしたちは、何事も真理に逆らってはできませんが、真理のためならばできます。","tok":[["わたしたち"],["は"],["、"],["何事","なにごと"],["も"],["真理","しんり"],["に"],["逆らって","さからって"],["は"],["できません"],["が"],["、"],["真理","しんり"],["の"],["ため"],["ならば"],["できます"],["。"]]},{"verse":9,"text":"わたしたちは自分が弱くても、あなたがたが強ければ喜びます。あなたがたが完全な者になることをも、わたしたちは祈っています。","tok":[["わたしたち"],["は"],["自分","じぶん"],["が"],["弱くて","よわくて"],["も"],["、"],["あなた"],["がた"],["が"],["強ければ","つよければ"],["喜びます","よろこびます"],["。"],["あなた"],["がた"],["が"],["完全","かんぜん"],["な"],["者","もの"],["に"],["なる"],["こと"],["を"],["も"],["、"],["わたしたち"],["は"],["祈って","いのって"],["います"],["。"]]},{"verse":10,"text":"遠くにいてこのようなことを書き送るのは、わたしがそちらに行ったとき、壊すためではなく造り上げるために主がお与えくださった権威によって、厳しい態度をとらなくても済むようにするためです。","tok":[["遠く","とおく"],["に"],["いて"],["この"],["よう"],["な"],["こと"],["を"],["書き送る","かきおくる"],["の"],["は"],["、"],["わたし"],["が"],["そちら"],["に"],["行った","いった"],["とき"],["、"],["壊す","こわす"],["ため"],["で"],["は"],["なく"],["造り上げる","つくりあげる"],["ため"],["に"],["主","ぬし"],["が"],["お与え","おあたえ"],["くださった"],["権威","けんい"],["によって"],["、"],["厳しい","きびしい"],["態度","たいど"],["を"],["とらなくて"],["も"],["済む","すむ"],["よう"],["に"],["する"],["ため"],["です"],["。"]]},{"verse":11,"text":"終わりに、兄弟たち、喜びなさい。完全な者になりなさい。励まし合いなさい。思いを一つにしなさい。平和を保ちなさい。そうすれば、愛と平和の神があなたがたと共にいてくださいます。","tok":[["終わり","おわり"],["に"],["、"],["兄弟","きょうだい"],["たち"],["、"],["喜び","よろこび"],["なさい"],["。"],["完全","かんぜん"],["な"],["者","もの"],["に"],["なり"],["なさい"],["。"],["励まし合い","はげましあい"],["なさい"],["。"],["思い","おもい"],["を"],["一","ひと"],["つ"],["に"],["し"],["なさい"],["。"],["平和","へいわ"],["を"],["保ち","たもち"],["なさい"],["。"],["そう"],["すれば"],["、"],["愛","あい"],["と"],["平和","へいわ"],["の"],["神","かみ"],["が"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いて"],["くださいます"],["。"]]},{"verse":12,"text":"聖なる口づけによって互いに挨拶を交わしなさい。すべての聖なる者があなたがたによろしくとのことです。","tok":[["聖","せい"],["なる"],["口づけ","くちづけ"],["によって"],["互い","たがい"],["に"],["挨拶","あいさつ"],["を"],["交わし","かわし"],["なさい"],["。"],["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["が"],["あなた"],["がた"],["に"],["よろしく"],["と"],["の"],["こと"],["です"],["。"]]},{"verse":13,"text":"主イエス‧キリストの恵み、神の愛、聖霊の交わりが、あなたがた一同と共にあるように。","tok":[["主","しゅ"],["イエス"],["‧"],["キリスト"],["の"],["恵み","めぐみ"],["、"],["神","かみ"],["の"],["愛","あい"],["、"],["聖霊","せいれい"],["の"],["交わり","まじわり"],["が"],["、"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
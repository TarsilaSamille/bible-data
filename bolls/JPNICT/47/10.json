[{"verse":1,"text":"さて、あなたがたの間で面と向かっては弱腰だが、離れていると強硬な態度に出る、と思われている、このわたしパウロが、キリストの優しさと心の広さとをもって、あなたがたに願います。","tok":[["さて"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["面","めん"],["と"],["向かって","むかって"],["は"],["弱腰","よわごし"],["だ"],["が"],["、"],["離れて","はなれて"],["いる"],["と"],["強硬","きょうこう"],["な"],["態度","たいど"],["に"],["出る","でる"],["、"],["と"],["思われて","おもわれて"],["いる"],["、"],["この"],["わたし"],["パウロ"],["が"],["、"],["キリスト"],["の"],["優し","やさし"],["さ"],["と"],["心","こころ"],["の"],["広さ","ひろさ"],["と"],["を"],["もって"],["、"],["あなた"],["がた"],["に"],["願います","ねがいます"],["。"]]},{"verse":2,"text":"わたしたちのことを肉に従って歩んでいると見なしている者たちに対しては、勇敢に立ち向かうつもりです。わたしがそちらに行くときには、そんな強硬な態度をとらずに済むようにと願っています。","tok":[["わたしたち"],["の"],["こと"],["を"],["肉","にく"],["に"],["従って","したがって"],["歩んで","あゆんで"],["いる"],["と"],["見なして","みなして"],["いる"],["者","もの"],["たち"],["に"],["対し","たいし"],["ては"],["、"],["勇敢","ゆうかん"],["に"],["立ち向かう","たちむかう"],["つもり"],["です"],["。"],["わたし"],["が"],["そちら"],["に"],["行く","いく"],["とき"],["に"],["は"],["、"],["そんな"],["強硬","きょうこう"],["な"],["態度","たいど"],["を"],["とらず"],["に"],["済む","すむ"],["よう"],["に"],["と"],["願って","ねがって"],["います"],["。"]]},{"verse":3,"text":"わたしたちは肉において歩んでいますが、肉に従って戦うのではありません。","tok":[["わたしたち"],["は"],["肉","にく"],["に"],["おいて"],["歩んで","あゆんで"],["います"],["が"],["、"],["肉","にく"],["に"],["従って","したがって"],["戦う","たたかう"],["ので"],["は"],["ありません"],["。"]]},{"verse":4,"text":"わたしたちの戦いの武器は肉のものではなく、神に由来する力であって要塞も破壊するに足ります。わたしたちは理屈を打ち破り、","tok":[["わたしたち"],["の"],["戦い","たたかい"],["の"],["武器","ぶき"],["は"],["肉","にく"],["の"],["もの"],["で"],["は"],["なく"],["、"],["神","かみ"],["に"],["由来","ゆらい"],["する"],["力","ちから"],["で"],["あって"],["要塞","ようさい"],["も"],["破壊","はかい"],["する"],["に"],["足ります","たります"],["。"],["わたしたち"],["は"],["理屈","りくつ"],["を"],["打ち破り","うちやぶり"],["、"]]},{"verse":5,"text":"神の知識に逆らうあらゆる高慢を打ち倒し、あらゆる思惑をとりこにしてキリストに従わせ、","tok":[["神","かみ"],["の"],["知識","ちしき"],["に"],["逆らう","さからう"],["あらゆる"],["高慢","こうまん"],["を"],["打ち倒し","うちたおし"],["、"],["あらゆる"],["思惑","おもわく"],["を"],["とりこ"],["に"],["して"],["キリスト"],["に"],["従わせ","したがわせ"],["、"]]},{"verse":6,"text":"また、あなたがたの従順が完全なものになるとき、すべての不従順を罰する用意ができています。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["従順","じゅうじゅん"],["が"],["完全","かんぜん"],["な"],["もの"],["に"],["なる"],["とき"],["、"],["すべて"],["の"],["不","ふ"],["従順","じゅうじゅん"],["を"],["罰する","ばっする"],["用意","ようい"],["が"],["できて"],["います"],["。"]]},{"verse":7,"text":"あなたがたは、うわべのことだけ見ています。自分がキリストのものだと信じきっている人がいれば、その人は、自分と同じくわたしたちもキリストのものであることを、もう一度考えてみるがよい。","tok":[["あなた"],["がた"],["は"],["、"],["うわべ"],["の"],["こと"],["だけ"],["見て","みて"],["います"],["。"],["自分","じぶん"],["が"],["キリスト"],["の"],["もの"],["だ"],["と"],["信じ","しんじ"],["きって"],["いる"],["人","ひと"],["が"],["いれば"],["、"],["その"],["人","ひと"],["は"],["、"],["自分","じぶん"],["と"],["同じく","おなじく"],["わたしたち"],["も"],["キリスト"],["の"],["もの"],["で"],["ある"],["こと"],["を"],["、"],["もう"],["一度","いちど"],["考えて","かんがえて"],["みる"],["が"],["よい"],["。"]]},{"verse":8,"text":"あなたがたを打ち倒すためではなく、造り上げるために主がわたしたちに授けてくださった権威について、わたしがいささか誇りすぎたとしても、恥にはならないでしょう。","tok":[["あなた"],["がた"],["を"],["打ち倒す","うちたおす"],["ため"],["で"],["は"],["なく"],["、"],["造り上げる","つくりあげる"],["ため"],["に"],["主","ぬし"],["が"],["わたしたち"],["に"],["授けて","さずけて"],["くださった"],["権威","けんい"],["について"],["、"],["わたし"],["が"],["いささか"],["誇り","ほこり"],["すぎた"],["として"],["も"],["、"],["恥","はじ"],["に"],["は"],["ならないでしょう"],["。"]]},{"verse":9,"text":"わたしは手紙であなたがたを脅していると思われたくない。","tok":[["わたし"],["は"],["手紙","てがみ"],["で"],["あなた"],["がた"],["を"],["脅して","おどして"],["いる"],["と"],["思われたく","おもわれたく"],["ない"],["。"]]},{"verse":10,"text":"わたしのことを、「手紙は重々しく力強いが、実際に会ってみると弱々しい人で、話もつまらない」と言う者たちがいるからです。","tok":[["わたし"],["の"],["こと"],["を"],["、"],["「"],["手紙","てがみ"],["は"],["重々しく","おもおもしく"],["力強い","ちからづよい"],["が"],["、"],["実際","じっさい"],["に"],["会って","あって"],["みる"],["と"],["弱々しい","よわよわしい"],["人","ひと"],["で"],["、"],["話","はなし"],["も"],["つまらない"],["」"],["と"],["言う","いう"],["者","もの"],["たち"],["が"],["いる"],["から"],["です"],["。"]]},{"verse":11,"text":"そのような者は心得ておくがよい。離れていて手紙で書くわたしたちと、その場に居合わせてふるまうわたしたちとに変わりはありません。","tok":[["その"],["よう"],["な"],["者","もの"],["は"],["心得て","こころえて"],["おく"],["が"],["よい"],["。"],["離れて","はなれて"],["いて"],["手紙","てがみ"],["で"],["書く","かく"],["わたしたち"],["と"],["、"],["その"],["場","ば"],["に"],["居合わせて","いあわせて"],["ふるまう"],["わたしたち"],["と"],["に"],["変わり","かわり"],["は"],["ありません"],["。"]]},{"verse":12,"text":"わたしたちは、自己推薦する者たちと自分を同列に置いたり、比較したりしようなどとは思いません。彼らは仲間どうしで評価し合い、比較し合っていますが、愚かなことです。","tok":[["わたしたち"],["は"],["、"],["自己","じこ"],["推薦","すいせん"],["する"],["者","もの"],["たち"],["と"],["自分","じぶん"],["を"],["同列","どうれつ"],["に"],["置い","おい"],["たり"],["、"],["比較","ひかく"],["し"],["たり"],["しよう"],["など"],["と"],["は"],["思いません","おもいません"],["。"],["彼","かれ"],["ら"],["は"],["仲間","なかま"],["どうし"],["で"],["評価","ひょうか"],["し"],["合い","あい"],["、"],["比較","ひかく"],["し"],["合って","あって"],["います"],["が"],["、"],["愚か","おろか"],["な"],["こと"],["です"],["。"]]},{"verse":13,"text":"わたしたちは限度を超えては誇らず、神が割り当ててくださった範囲内で誇る、つまり、あなたがたのところまで行ったということで誇るのです。","tok":[["わたしたち"],["は"],["限度","げんど"],["を"],["超えて","こえて"],["は"],["誇らず","ほこらず"],["、"],["神","かみ"],["が"],["割り当てて","わりあてて"],["くださった"],["範囲内","はんいない"],["で"],["誇る","ほこる"],["、"],["つまり"],["、"],["あなた"],["がた"],["の"],["ところ"],["まで"],["行った","いった"],["と"],["いう"],["こと"],["で"],["誇る","ほこる"],["の"],["です"],["。"]]},{"verse":14,"text":"わたしたちは、あなたがたのところまでは行かなかったかのように、限度を超えようとしているのではありません。実際、わたしたちはキリストの福音を携えてだれよりも先にあなたがたのもとを訪れたのです。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["の"],["ところ"],["まで"],["は"],["行かなかった","いかなかった"],["か"],["の"],["よう"],["に"],["、"],["限度","げんど"],["を"],["超えよう","こえよう"],["として"],["いる"],["ので"],["は"],["ありません"],["。"],["実際","じっさい"],["、"],["わたしたち"],["は"],["キリスト"],["の"],["福音","ふくいん"],["を"],["携えて","たずさえて"],["だれ"],["より"],["も"],["先","さき"],["に"],["あなた"],["がた"],["の"],["もと"],["を"],["訪れた","おとずれた"],["の"],["です"],["。"]]},{"verse":15,"text":"わたしたちは、他人の労苦の結果を限度を超えて誇るようなことはしません。ただ、わたしたちが希望しているのは、あなたがたの信仰が成長し、あなたがたの間でわたしたちの働きが定められた範囲内でますます増大すること、","tok":[["わたしたち"],["は"],["、"],["他人","たにん"],["の"],["労苦","ろうく"],["の"],["結果","けっか"],["を"],["限度","げんど"],["を"],["超えて","こえて"],["誇る","ほこる"],["よう"],["な"],["こと"],["は"],["しません"],["。"],["ただ"],["、"],["わたしたち"],["が"],["希望","きぼう"],["して"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["が"],["成長","せいちょう"],["し"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["わたしたち"],["の"],["働き","はたらき"],["が"],["定められた","さだめられた"],["範囲内","はんいない"],["で"],["ますます"],["増大","ぞうだい"],["する"],["こと"],["、"]]},{"verse":16,"text":"あなたがたを越えた他の地域にまで福音が告げ知らされるようになること、わたしたちが他の人々の領域で成し遂げられた活動を誇らないことです。","tok":[["あなた"],["がた"],["を"],["越えた","こえた"],["他","ほか"],["の"],["地域","ちいき"],["に"],["まで"],["福音","ふくいん"],["が"],["告げ知らされる","つげしらされる"],["よう"],["に"],["なる"],["こと"],["、"],["わたしたち"],["が"],["他","ほか"],["の"],["人々","ひとびと"],["の"],["領域","りょういき"],["で"],["成し遂げられた","なしとげられた"],["活動","かつどう"],["を"],["誇らない","ほこらない"],["こと"],["です"],["。"]]},{"verse":17,"text":"「誇る者は主を誇れ。」","tok":[["「"],["誇る","ほこる"],["者","もの"],["は"],["主","ぬし"],["を"],["誇れ","ほこれ"],["。"],["」"]]},{"verse":18,"text":"自己推薦する者ではなく、主から推薦される人こそ、適格者として受け入れられるのです。","tok":[["自己","じこ"],["推薦","すいせん"],["する"],["者","もの"],["で"],["は"],["なく"],["、"],["主","ぬし"],["から"],["推薦","すいせん"],["される"],["人","ひと"],["こそ"],["、"],["適格者","てきかくしゃ"],["として"],["受け入れられる","うけいれられる"],["の"],["です"],["。"]]}]
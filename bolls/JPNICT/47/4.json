[{"verse":1,"text":"こういうわけで、わたしたちは、憐れみを受けた者としてこの務めをゆだねられているのですから、落胆しません。","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["わたしたち"],["は"],["、"],["憐れみ","あわれみ"],["を"],["受けた","うけた"],["者","もの"],["として"],["この"],["務め","つとめ"],["を"],["ゆだねられて"],["いる"],["の"],["です"],["から"],["、"],["落胆","らくたん"],["しません"],["。"]]},{"verse":2,"text":"かえって、卑劣な隠れた行いを捨て、悪賢く歩まず、神の言葉を曲げず、真理を明らかにすることにより、神の御前で自分自身をすべての人の良心にゆだねます。","tok":[["かえって"],["、"],["卑劣","ひれつ"],["な"],["隠れた","かくれた"],["行い","おこない"],["を"],["捨て","すて"],["、"],["悪賢く","わるがしこく"],["歩まず","あゆまず"],["、"],["神","かみ"],["の"],["言葉","ことば"],["を"],["曲げず","まげず"],["、"],["真理","しんり"],["を"],["明らか","あきらか"],["に"],["する"],["こと"],["に"],["より"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["自分","じぶん"],["自身","じしん"],["を"],["すべて"],["の"],["人","ひと"],["の"],["良心","りょうしん"],["に"],["ゆだねます"],["。"]]},{"verse":3,"text":"わたしたちの福音に覆いが掛かっているとするなら、それは、滅びの道をたどる人々に対して覆われているのです。","tok":[["わたしたち"],["の"],["福音","ふくいん"],["に"],["覆い","おおい"],["が"],["掛かって","かかって"],["いる"],["と"],["するなら"],["、"],["それ"],["は"],["、"],["滅び","ほろび"],["の"],["道","みち"],["を"],["たどる"],["人々","ひとびと"],["に対して","にたいして"],["覆われて","おおわれて"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"この世の神が、信じようとはしないこの人々の心の目をくらまし、神の似姿であるキリストの栄光に関する福音の光が見えないようにしたのです。","tok":[["この世","このよ"],["の"],["神","かみ"],["が"],["、"],["信じよう","しんじよう"],["と"],["は"],["しない"],["この"],["人々","ひとびと"],["の"],["心","こころ"],["の"],["目","め"],["を"],["くらまし"],["、"],["神","かみ"],["の"],["似姿","にすがた"],["で"],["ある"],["キリスト"],["の"],["栄光","えいこう"],["に"],["関する","かんする"],["福音","ふくいん"],["の"],["光","ひかり"],["が"],["見えない","みえない"],["よう"],["に"],["した"],["の"],["です"],["。"]]},{"verse":5,"text":"わたしたちは、自分自身を宣べ伝えるのではなく、主であるイエス‧キリストを宣べ伝えています。わたしたち自身は、イエスのためにあなたがたに仕える僕なのです。","tok":[["わたしたち"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["宣べ伝える","のべつたえる"],["ので"],["は"],["なく"],["、"],["主","ぬし"],["で"],["ある"],["イエス"],["‧"],["キリスト"],["を"],["宣べ伝えて","のべつたえて"],["います"],["。"],["わたしたち"],["自身","じしん"],["は"],["、"],["イエス"],["の"],["ため"],["に"],["あなた"],["がた"],["に"],["仕える","つかえる"],["僕","ぼく"],["な"],["の"],["です"],["。"]]},{"verse":6,"text":"「闇から光が輝き出よ」と命じられた神は、わたしたちの心の内に輝いて、イエス‧キリストの御顔に輝く神の栄光を悟る光を与えてくださいました。","tok":[["「"],["闇","やみ"],["から"],["光","ひかり"],["が"],["輝き出よ","かがやきでよ"],["」"],["と"],["命じられた","めいじられた"],["神","かみ"],["は"],["、"],["わたしたち"],["の"],["心","こころ"],["の"],["内","うち"],["に"],["輝いて","かがやいて"],["、"],["イエス"],["‧"],["キリスト"],["の"],["御顔","おかお"],["に"],["輝く","かがやく"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["悟る","さとる"],["光","ひかり"],["を"],["与えて","あたえて"],["くださいました"],["。"]]},{"verse":7,"text":"ところで、わたしたちは、このような宝を土の器に納めています。この並外れて偉大な力が神のものであって、わたしたちから出たものでないことが明らかになるために。","tok":[["ところ"],["で"],["、"],["わたしたち"],["は"],["、"],["この"],["よう"],["な"],["宝","たから"],["を"],["土","つち"],["の"],["器","うつわ"],["に"],["納めて","おさめて"],["います"],["。"],["この"],["並外れて","なみはずれて"],["偉大","いだい"],["な"],["力","ちから"],["が"],["神","かみ"],["の"],["もの"],["で"],["あって"],["、"],["わたしたち"],["から"],["出た","でた"],["もの"],["で"],["ない"],["こと"],["が"],["明らか","あきらか"],["に"],["なる"],["ため"],["に"],["。"]]},{"verse":8,"text":"わたしたちは、四方から苦しめられても行き詰まらず、途方に暮れても失望せず、","tok":[["わたしたち"],["は"],["、"],["四方","しほう"],["から"],["苦しめられて","くるしめられて"],["も"],["行き詰まらず","いきづまらず"],["、"],["途方","とほう"],["に"],["暮れて","くれて"],["も"],["失望","しつぼう"],["せず"],["、"]]},{"verse":9,"text":"虐げられても見捨てられず、打ち倒されても滅ぼされない。","tok":[["虐げられて","しいたげられて"],["も"],["見捨てられず","みすてられず"],["、"],["打ち倒されて","うちたおされて"],["も"],["滅ぼされない","ほろぼされない"],["。"]]},{"verse":10,"text":"わたしたちは、いつもイエスの死を体にまとっています、イエスの命がこの体に現れるために。","tok":[["わたしたち"],["は"],["、"],["いつも"],["イエス"],["の"],["死","し"],["を"],["体","からだ"],["に"],["まとって"],["います"],["、"],["イエス"],["の"],["命","いのち"],["が"],["この"],["体","からだ"],["に"],["現れる","あらわれる"],["ため"],["に"],["。"]]},{"verse":11,"text":"わたしたちは生きている間、絶えずイエスのために死にさらされています、死ぬはずのこの身にイエスの命が現れるために。","tok":[["わたしたち"],["は"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["絶えず","たえず"],["イエス"],["の"],["ため"],["に"],["死","し"],["に"],["さらされて"],["います"],["、"],["死ぬ","しぬ"],["はず"],["の"],["この"],["身","み"],["に"],["イエス"],["の"],["命","いのち"],["が"],["現れる","あらわれる"],["ため"],["に"],["。"]]},{"verse":12,"text":"こうして、わたしたちの内には死が働き、あなたがたの内には命が働いていることになります。","tok":[["こう"],["して"],["、"],["わたしたち"],["の"],["内","うち"],["に"],["は"],["死","し"],["が"],["働き","はたらき"],["、"],["あなた"],["がた"],["の"],["内","うち"],["に"],["は"],["命","いのち"],["が"],["働いて","はたらいて"],["いる"],["こと"],["に"],["なります"],["。"]]},{"verse":13,"text":"「わたしは信じた。それで、わたしは語った」と書いてあるとおり、それと同じ信仰の霊を持っているので、わたしたちも信じ、それだからこそ語ってもいます。","tok":[["「"],["わたし"],["は"],["信じた","しんじた"],["。"],["それ"],["で"],["、"],["わたし"],["は"],["語った","かたった"],["」"],["と"],["書いて","かいて"],["ある"],["と"],["おり"],["、"],["それ"],["と"],["同じ","おなじ"],["信仰","しんこう"],["の"],["霊","れい"],["を"],["持って","もって"],["いる"],["ので"],["、"],["わたしたち"],["も"],["信じ","しんじ"],["、"],["それ"],["だ"],["から"],["こそ"],["語って","かたって"],["も"],["います"],["。"]]},{"verse":14,"text":"主イエスを復活させた神が、イエスと共にわたしたちをも復活させ、あなたがたと一緒に御前に立たせてくださると、わたしたちは知っています。","tok":[["主","しゅ"],["イエス"],["を"],["復活","ふっかつ"],["させた"],["神","かみ"],["が"],["、"],["イエス"],["と"],["共","とも"],["に"],["わたしたち"],["を"],["も"],["復活","ふっかつ"],["させ"],["、"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["御前","ごぜん"],["に"],["立たせて","たたせて"],["くださる"],["と"],["、"],["わたしたち"],["は"],["知って","しって"],["います"],["。"]]},{"verse":15,"text":"すべてこれらのことは、あなたがたのためであり、多くの人々が豊かに恵みを受け、感謝の念に満ちて神に栄光を帰すようになるためです。","tok":[["すべて"],["これ"],["ら"],["の"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["で"],["あり"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["豊か","ゆたか"],["に"],["恵み","めぐみ"],["を"],["受け","うけ"],["、"],["感謝","かんしゃ"],["の"],["念","ねん"],["に"],["満ちて","みちて"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰す","かえす"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":16,"text":"だから、わたしたちは落胆しません。たとえわたしたちの「外なる人」は衰えていくとしても、わたしたちの「内なる人」は日々新たにされていきます。","tok":[["だ"],["から"],["、"],["わたしたち"],["は"],["落胆","らくたん"],["しません"],["。"],["たとえ"],["わたしたち"],["の"],["「"],["外","そと"],["なる"],["人","ひと"],["」"],["は"],["衰えて","おとろえて"],["いく"],["として"],["も"],["、"],["わたしたち"],["の"],["「"],["内","うち"],["なる"],["人","ひと"],["」"],["は"],["日々","ひび"],["新た","あらた"],["に"],["されて"],["いきます"],["。"]]},{"verse":17,"text":"わたしたちの一時の軽い艱難は、比べものにならないほど重みのある永遠の栄光をもたらしてくれます。","tok":[["わたしたち"],["の"],["一時","いちじ"],["の"],["軽い","かるい"],["艱難","かんなん"],["は"],["、"],["比べもの","くらべもの"],["に"],["ならない"],["ほど"],["重み","おもみ"],["の"],["ある"],["永遠","えいえん"],["の"],["栄光","えいこう"],["を"],["もたらして"],["くれます"],["。"]]},{"verse":18,"text":"わたしたちは見えるものではなく、見えないものに目を注ぎます。見えるものは過ぎ去りますが、見えないものは永遠に存続するからです。","tok":[["わたしたち"],["は"],["見える","みえる"],["もの"],["で"],["は"],["なく"],["、"],["見えない","みえない"],["もの"],["に"],["目","め"],["を"],["注ぎます","そそぎます"],["。"],["見える","みえる"],["もの"],["は"],["過ぎ去ります","すぎさります"],["が"],["、"],["見えない","みえない"],["もの"],["は"],["永遠","えいえん"],["に"],["存続","そんぞく"],["する"],["から"],["です"],["。"]]}]
[{"verse":1,"text":"わたしは誇らずにいられません。誇っても無益ですが、主が見せてくださった事と啓示してくださった事について語りましょう。","tok":[["わたし"],["は"],["誇らず","ほこらず"],["に"],["いられません"],["。"],["誇って","ほこって"],["も"],["無益","むえき"],["です"],["が"],["、"],["主","ぬし"],["が"],["見せて","みせて"],["くださった"],["事","こと"],["と"],["啓示","けいじ"],["して"],["くださった"],["事","こと"],["について"],["語りましょう","かたりましょう"],["。"]]},{"verse":2,"text":"わたしは、キリストに結ばれていた一人の人を知っていますが、その人は十四年前、第三の天にまで引き上げられたのです。体のままか、体を離れてかは知りません。神がご存じです。","tok":[["わたし"],["は"],["、"],["キリスト"],["に"],["結ばれて","むすばれて"],["いた"],["一人","ひとり"],["の"],["人","ひと"],["を"],["知って","しって"],["います"],["が"],["、"],["その"],["人","ひと"],["は"],["十四","じゅうよん"],["年","ねん"],["前","まえ"],["、"],["第","だい"],["三","さん"],["の"],["天","てん"],["に"],["まで"],["引き上げられた","ひきあげられた"],["の"],["です"],["。"],["体","からだ"],["の"],["まま"],["か"],["、"],["体","からだ"],["を"],["離れて","はなれて"],["か"],["は"],["知りません","しりません"],["。"],["神","かみ"],["が"],["ご存じ","ごぞんじ"],["です"],["。"]]},{"verse":3,"text":"わたしはそのような人を知っています。体のままか、体を離れてかは知りません。神がご存じです。","tok":[["わたし"],["は"],["その"],["よう"],["な"],["人","ひと"],["を"],["知って","しって"],["います"],["。"],["体","からだ"],["の"],["まま"],["か"],["、"],["体","からだ"],["を"],["離れて","はなれて"],["か"],["は"],["知りません","しりません"],["。"],["神","かみ"],["が"],["ご存じ","ごぞんじ"],["です"],["。"]]},{"verse":4,"text":"彼は楽園にまで引き上げられ、人が口にするのを許されない、言い表しえない言葉を耳にしたのです。","tok":[["彼","かれ"],["は"],["楽園","らくえん"],["に"],["まで"],["引き上げられ","ひきあげられ"],["、"],["人","ひと"],["が"],["口","くち"],["に"],["する"],["の"],["を"],["許されない","ゆるされない"],["、"],["言い表し","いいあらわし"],["えない"],["言葉","ことば"],["を"],["耳","みみ"],["に"],["した"],["の"],["です"],["。"]]},{"verse":5,"text":"このような人のことをわたしは誇りましょう。しかし、自分自身については、弱さ以外には誇るつもりはありません。","tok":[["この"],["よう"],["な"],["人","ひと"],["の"],["こと"],["を"],["わたし"],["は"],["誇りましょう","ほこりましょう"],["。"],["しかし"],["、"],["自分","じぶん"],["自身","じしん"],["について"],["は"],["、"],["弱","よわ"],["さ"],["以外","いがい"],["に"],["は"],["誇る","ほこる"],["つもり"],["は"],["ありません"],["。"]]},{"verse":6,"text":"仮にわたしが誇る気になったとしても、真実を語るのだから、愚か者にはならないでしょう。だが、誇るまい。わたしのことを見たり、わたしから話を聞いたりする以上に、わたしを過大評価する人がいるかもしれないし、","tok":[["仮","かり"],["に"],["わたし"],["が"],["誇る","ほこる"],["気","き"],["に"],["なった"],["として"],["も"],["、"],["真実","しんじつ"],["を"],["語る","かたる"],["の"],["だ"],["から"],["、"],["愚か者","おろかもの"],["に"],["は"],["ならないでしょう"],["。"],["だ"],["が"],["、"],["誇るまい","ほこるまい"],["。"],["わたし"],["の"],["こと"],["を"],["見","み"],["たり"],["、"],["わたし"],["から"],["話","はなし"],["を"],["聞い","きい"],["たり"],["する"],["以上","いじょう"],["に"],["、"],["わたし"],["を"],["過大","かだい"],["評価","ひょうか"],["する"],["人","ひと"],["が"],["いる"],["か"],["も"],["しれない"],["し"],["、"]]},{"verse":7,"text":"また、あの啓示された事があまりにもすばらしいからです。それで、そのために思い上がることのないようにと、わたしの身に一つのとげが与えられました。それは、思い上がらないように、わたしを痛めつけるために、サタンから送られた使いです。","tok":[["また"],["、"],["あの"],["啓示","けいじ"],["された"],["事","こと"],["が"],["あまり"],["に"],["も"],["すばらしい"],["から"],["です"],["。"],["それ"],["で"],["、"],["その"],["ため"],["に"],["思い上がる","おもいあがる"],["こと"],["の"],["ない"],["よう"],["に"],["と"],["、"],["わたし"],["の"],["身","み"],["に"],["一","ひと"],["つ"],["の"],["とげ"],["が"],["与えられました","あたえられました"],["。"],["それ"],["は"],["、"],["思い上がらない","おもいあがらない"],["よう"],["に"],["、"],["わたし"],["を"],["痛めつける","いためつける"],["ため"],["に"],["、"],["サタン"],["から"],["送られた","おくられた"],["使い","つかい"],["です"],["。"]]},{"verse":8,"text":"この使いについて、離れ去らせてくださるように、わたしは三度主に願いました。","tok":[["この"],["使い","つかい"],["について"],["、"],["離れ去らせて","はなれさらせて"],["くださる"],["よう"],["に"],["、"],["わたし"],["は"],["三","さん"],["度","ど"],["主に","おもに"],["願いました","ねがいました"],["。"]]},{"verse":9,"text":"すると主は、「わたしの恵みはあなたに十分である。力は弱さの中でこそ十分に発揮されるのだ」と言われました。だから、キリストの力がわたしの内に宿るように、むしろ大いに喜んで自分の弱さを誇りましょう。","tok":[["する"],["と"],["主","ぬし"],["は"],["、"],["「"],["わたし"],["の"],["恵み","めぐみ"],["は"],["あなた"],["に"],["十分","じゅうぶん"],["で"],["ある"],["。"],["力","ちから"],["は"],["弱","よわ"],["さ"],["の"],["中","なか"],["で"],["こそ"],["十分","じゅうぶん"],["に"],["発揮","はっき"],["される"],["の"],["だ"],["」"],["と"],["言われました","いわれました"],["。"],["だ"],["から"],["、"],["キリスト"],["の"],["力","ちから"],["が"],["わたし"],["の"],["内","うち"],["に"],["宿る","やどる"],["よう"],["に"],["、"],["むしろ"],["大いに","おおいに"],["喜んで","よろこんで"],["自分","じぶん"],["の"],["弱","よわ"],["さ"],["を"],["誇りましょう","ほこりましょう"],["。"]]},{"verse":10,"text":"それゆえ、わたしは弱さ、侮辱、窮乏、迫害、そして行き詰まりの状態にあっても、キリストのために満足しています。なぜなら、わたしは弱いときにこそ強いからです。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["弱","よわ"],["さ"],["、"],["侮辱","ぶじょく"],["、"],["窮乏","きゅうぼう"],["、"],["迫害","はくがい"],["、"],["そして"],["行き詰まり","いきづまり"],["の"],["状態","じょうたい"],["に"],["あって"],["も"],["、"],["キリスト"],["の"],["ため"],["に"],["満足","まんぞく"],["して"],["います"],["。"],["なぜ"],["なら"],["、"],["わたし"],["は"],["弱い","よわい"],["とき"],["に"],["こそ"],["強い","つよい"],["から"],["です"],["。"]]},{"verse":11,"text":"わたしは愚か者になってしまいました。あなたがたが無理にそうさせたのです。わたしが、あなたがたから推薦してもらうべきだったのです。わたしは、たとえ取るに足りない者だとしても、あの大使徒たちに比べて少しも引けは取らなかったからです。","tok":[["わたし"],["は"],["愚か者","おろかもの"],["に"],["なって"],["しまいました"],["。"],["あなた"],["がた"],["が"],["無理","むり"],["に"],["そう"],["させた"],["の"],["です"],["。"],["わたし"],["が"],["、"],["あなた"],["がた"],["から"],["推薦","すいせん"],["して"],["もらうべきだった"],["の"],["です"],["。"],["わたし"],["は"],["、"],["たとえ"],["取る","とる"],["に"],["足りない","たりない"],["者","もの"],["だ"],["として"],["も"],["、"],["あの"],["大使","たいし"],["徒","と"],["たち"],["に"],["比べて","くらべて"],["少し","すこし"],["も"],["引け","ひけ"],["は"],["取らなかった","とらなかった"],["から"],["です"],["。"]]},{"verse":12,"text":"わたしは使徒であることを、しるしや、不思議な業や、奇跡によって、忍耐強くあなたがたの間で実証しています。","tok":[["わたし"],["は"],["使徒","しと"],["で"],["ある"],["こと"],["を"],["、"],["しるし"],["や"],["、"],["不思議","ふしぎ"],["な"],["業","ごう"],["や"],["、"],["奇跡","きせき"],["によって"],["、"],["忍耐","にんたい"],["強く","つよく"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["実証","じっしょう"],["して"],["います"],["。"]]},{"verse":13,"text":"あなたがたが他の諸教会よりも劣っている点は何でしょう。わたしが負担をかけなかったことだけではないですか。この不当な点をどうか許してほしい。","tok":[["あなた"],["がた"],["が"],["他","ほか"],["の"],["諸教","しょきょう"],["会","かい"],["より"],["も"],["劣って","おとって"],["いる"],["点","てん"],["は"],["何","なん"],["でしょう"],["。"],["わたし"],["が"],["負担","ふたん"],["を"],["かけなかった"],["こと"],["だけ"],["で"],["は"],["ないです"],["か"],["。"],["この"],["不当","ふとう"],["な"],["点","てん"],["を"],["どう"],["か"],["許して","ゆるして"],["ほしい"],["。"]]},{"verse":14,"text":"わたしはそちらに三度目の訪問をしようと準備しているのですが、あなたがたに負担はかけません。わたしが求めているのは、あなたがたの持ち物ではなく、あなたがた自身だからです。子は親のために財産を蓄える必要はなく、親が子のために蓄えなければならないのです。","tok":[["わたし"],["は"],["そちら"],["に"],["三度目","さんどめ"],["の"],["訪問","ほうもん"],["を"],["しよう"],["と"],["準備","じゅんび"],["して"],["いる"],["の"],["です"],["が"],["、"],["あなた"],["がた"],["に"],["負担","ふたん"],["は"],["かけません"],["。"],["わたし"],["が"],["求めて","もとめて"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["持ち物","もちもの"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["自身","じしん"],["だ"],["から"],["です"],["。"],["子","こ"],["は"],["親","おや"],["の"],["ため"],["に"],["財産","ざいさん"],["を"],["蓄える","たくわえる"],["必要","ひつよう"],["は"],["なく"],["、"],["親","おや"],["が"],["子","こ"],["の"],["ため"],["に"],["蓄えなければ","たくわえなければ"],["ならない"],["の"],["です"],["。"]]},{"verse":15,"text":"わたしはあなたがたの魂のために大いに喜んで自分の持ち物を使い、自分自身を使い果たしもしよう。あなたがたを愛すれば愛するほど、わたしの方はますます愛されなくなるのでしょうか。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["魂","たましい"],["の"],["ため"],["に"],["大いに","おおいに"],["喜んで","よろこんで"],["自分","じぶん"],["の"],["持ち物","もちもの"],["を"],["使い","つかい"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["使い果たし","つかいはたし"],["も"],["しよう"],["。"],["あなた"],["がた"],["を"],["愛すれば","あいすれば"],["愛する","あいする"],["ほど"],["、"],["わたし"],["の"],["方","ほう"],["は"],["ますます"],["愛されなく","あいされなく"],["なる"],["の"],["でしょう"],["か"],["。"]]},{"verse":16,"text":"わたしが負担をかけなかったとしても、悪賢くて、あなたがたからだまし取ったということになっています。","tok":[["わたし"],["が"],["負担","ふたん"],["を"],["かけなかった"],["として"],["も"],["、"],["悪賢くて","わるがしこくて"],["、"],["あなた"],["がた"],["から"],["だまし取った","だましとった"],["と"],["いう"],["こと"],["に"],["なって"],["います"],["。"]]},{"verse":17,"text":"そちらに派遣した人々の中のだれによって、あなたがたをだましたでしょうか。","tok":[["そちら"],["に"],["派遣","はけん"],["した"],["人々","ひとびと"],["の"],["中","なか"],["の"],["だれ"],["によって"],["、"],["あなた"],["がた"],["を"],["だましたでしょう"],["か"],["。"]]},{"verse":18,"text":"テトスにそちらに行くように願い、あの兄弟を同伴させましたが、そのテトスがあなたがたをだましたでしょうか。わたしたちは同じ霊に導かれ、同じ模範に倣って歩んだのではなかったのですか。","tok":[["テトス"],["に"],["そちら"],["に"],["行く","いく"],["よう"],["に"],["願い","ねがい"],["、"],["あの"],["兄弟","きょうだい"],["を"],["同伴","どうはん"],["させました"],["が"],["、"],["その"],["テトス"],["が"],["あなた"],["がた"],["を"],["だましたでしょう"],["か"],["。"],["わたしたち"],["は"],["同じ","おなじ"],["霊","れい"],["に"],["導かれ","みちびかれ"],["、"],["同じ","おなじ"],["模範","もはん"],["に"],["倣って","ならって"],["歩んだ","あゆんだ"],["ので"],["は"],["なかった"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"あなたがたは、わたしたちがあなたがたに対し自己弁護をしているのだと、これまでずっと思ってきたのです。わたしたちは神の御前で、キリストに結ばれて語っています。愛する人たち、すべてはあなたがたを造り上げるためなのです。","tok":[["あなた"],["がた"],["は"],["、"],["わたしたち"],["が"],["あなた"],["がた"],["に"],["対し","たいし"],["自己","じこ"],["弁護","べんご"],["を"],["して"],["いる"],["の"],["だ"],["と"],["、"],["これ"],["まで"],["ずっと"],["思って","おもって"],["きた"],["の"],["です"],["。"],["わたしたち"],["は"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["キリスト"],["に"],["結ばれて","むすばれて"],["語って","かたって"],["います"],["。"],["愛する","あいする"],["人","ひと"],["たち"],["、"],["すべて"],["は"],["あなた"],["がた"],["を"],["造り上げる","つくりあげる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":20,"text":"わたしは心配しています。そちらに行ってみると、あなたがたがわたしの期待していたような人たちではなく、わたしの方もあなたがたの期待どおりの者ではない、ということにならないだろうか。争い、ねたみ、怒り、党派心、そしり、陰口、高慢、騒動などがあるのではないだろうか。","tok":[["わたし"],["は"],["心配","しんぱい"],["して"],["います"],["。"],["そちら"],["に"],["行って","いって"],["みる"],["と"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["期待","きたい"],["して"],["いた"],["よう"],["な"],["人","ひと"],["たち"],["で"],["は"],["なく"],["、"],["わたし"],["の"],["方","ほう"],["も"],["あなた"],["がた"],["の"],["期待","きたい"],["どおり"],["の"],["者","もの"],["で"],["は"],["ない"],["、"],["と"],["いう"],["こと"],["に"],["ならないだろう"],["か"],["。"],["争い","あらそい"],["、"],["ねたみ"],["、"],["怒り","いかり"],["、"],["党派心","とうはしん"],["、"],["そしり"],["、"],["陰口","かげぐち"],["、"],["高慢","こうまん"],["、"],["騒動","そうどう"],["など"],["が"],["ある"],["ので"],["は"],["ないだろう"],["か"],["。"]]},{"verse":21,"text":"再びそちらに行くとき、わたしの神があなたがたの前でわたしに面目を失わせるようなことはなさらないだろうか。以前に罪を犯した多くの人々が、自分たちの行った不潔な行い、みだらな行い、ふしだらな行いを悔い改めずにいるのを、わたしは嘆き悲しむことになるのではないだろうか。","tok":[["再び","ふたたび"],["そちら"],["に"],["行く","いく"],["とき"],["、"],["わたし"],["の"],["神","かみ"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["で"],["わたし"],["に"],["面目","めんぼく"],["を"],["失わせる","うしなわせる"],["よう"],["な"],["こと"],["は"],["なさらないだろう"],["か"],["。"],["以前","いぜん"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["、"],["自分","じぶん"],["たち"],["の"],["行った","おこなった"],["不潔","ふけつ"],["な"],["行い","おこない"],["、"],["みだら"],["な"],["行い","おこない"],["、"],["ふしだら"],["な"],["行い","おこない"],["を"],["悔い改めず","くいあらためず"],["に"],["いる"],["の"],["を"],["、"],["わたし"],["は"],["嘆き悲しむ","なげきかなしむ"],["こと"],["に"],["なる"],["ので"],["は"],["ないだろう
[{"verse":1,"text":"聖なる者たちへの奉仕について、これ以上書く必要はありません。","tok":[["聖","せい"],["なる"],["者","もの"],["たち"],["へ"],["の"],["奉仕","ほうし"],["について"],["、"],["これ"],["以上","いじょう"],["書く","かく"],["必要","ひつよう"],["は"],["ありません"],["。"]]},{"verse":2,"text":"わたしはあなたがたの熱意を知っているので、アカイア州では去年から準備ができていると言って、マケドニア州の人々にあなたがたのことを誇りました。あなたがたの熱意は多くの人々を奮い立たせたのです。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["熱意","ねつい"],["を"],["知って","しって"],["いる"],["ので"],["、"],["アカイア"],["州","しゅう"],["で"],["は"],["去年","きょねん"],["から"],["準備","じゅんび"],["が"],["できて"],["いる"],["と"],["言って","いって"],["、"],["マケドニア"],["州","しゅう"],["の"],["人々","ひとびと"],["に"],["あなた"],["がた"],["の"],["こと"],["を"],["誇りました","ほこりました"],["。"],["あなた"],["がた"],["の"],["熱意","ねつい"],["は"],["多く","おおく"],["の"],["人々","ひとびと"],["を"],["奮い立たせた","ふるいたたせた"],["の"],["です"],["。"]]},{"verse":3,"text":"わたしが兄弟たちを派遣するのは、あなたがたのことでわたしたちが抱いている誇りが、この点で無意味なものにならないためです。また、わたしが言ったとおり用意していてもらいたいためです。","tok":[["わたし"],["が"],["兄弟","きょうだい"],["たち"],["を"],["派遣","はけん"],["する"],["の"],["は"],["、"],["あなた"],["がた"],["の"],["こと"],["で"],["わたしたち"],["が"],["抱いて","いだいて"],["いる"],["誇り","ほこり"],["が"],["、"],["この"],["点","てん"],["で"],["無意味","むいみ"],["な"],["もの"],["に"],["ならない"],["ため"],["です"],["。"],["また"],["、"],["わたし"],["が"],["言った","いった"],["とおり"],["用意","ようい"],["して"],["いて"],["もらいたい"],["ため"],["です"],["。"]]},{"verse":4,"text":"そうでないと、マケドニア州の人々がわたしと共に行って、まだ用意のできていないのを見たら、あなたがたはもちろん、わたしたちも、このように確信しているだけに、恥をかくことになりかねないからです。","tok":[["そう"],["で"],["ない"],["と"],["、"],["マケドニア"],["州","しゅう"],["の"],["人々","ひとびと"],["が"],["わたし"],["と"],["共","とも"],["に"],["行って","いって"],["、"],["まだ"],["用意","ようい"],["の"],["できて"],["いない"],["の"],["を"],["見たら","みたら"],["、"],["あなた"],["がた"],["は"],["もちろん"],["、"],["わたしたち"],["も"],["、"],["この"],["よう"],["に"],["確信","かくしん"],["して"],["いる"],["だけ"],["に"],["、"],["恥","はじ"],["を"],["かく"],["こと"],["に"],["なり"],["かね"],["ない"],["から"],["です"],["。"]]},{"verse":5,"text":"そこで、この兄弟たちに頼んで一足先にそちらに行って、以前あなたがたが約束した贈り物の用意をしてもらうことが必要だと思いました。渋りながらではなく、惜しまず差し出したものとして用意してもらうためです。","tok":[["そこ"],["で"],["、"],["この"],["兄弟","きょうだい"],["たち"],["に"],["頼んで","たのんで"],["一足先","ひとあしさき"],["に"],["そちら"],["に"],["行って","いって"],["、"],["以前","いぜん"],["あなた"],["がた"],["が"],["約束","やくそく"],["した"],["贈り物","おくりもの"],["の"],["用意","ようい"],["を"],["して"],["もらう"],["こと"],["が"],["必要","ひつよう"],["だ"],["と"],["思いました","おもいました"],["。"],["渋り","しぶり"],["ながら"],["で"],["は"],["なく"],["、"],["惜しまず","おしまず"],["差し出した","さしだした"],["もの"],["として"],["用意","ようい"],["して"],["もらう"],["ため"],["です"],["。"]]},{"verse":6,"text":"つまり、こういうことです。惜しんでわずかしか種を蒔かない者は、刈り入れもわずかで、惜しまず豊かに蒔く人は、刈り入れも豊かなのです。","tok":[["つまり"],["、"],["こう"],["いう"],["こと"],["です"],["。"],["惜しんで","おしんで"],["わずか"],["しか"],["種","しゅ"],["を"],["蒔かない","まかない"],["者","もの"],["は"],["、"],["刈り入れ","かりいれ"],["も"],["わずか"],["で"],["、"],["惜しまず","おしまず"],["豊か","ゆたか"],["に"],["蒔く","まく"],["人","ひと"],["は"],["、"],["刈り入れ","かりいれ"],["も"],["豊か","ゆたか"],["な"],["の"],["です"],["。"]]},{"verse":7,"text":"各自、不承不承ではなく、強制されてでもなく、こうしようと心に決めたとおりにしなさい。喜んで与える人を神は愛してくださるからです。","tok":[["各自","かくじ"],["、"],["不承","ふしょう"],["不承","ぶしょう"],["で"],["は"],["なく"],["、"],["強制","きょうせい"],["されて"],["で"],["も"],["なく"],["、"],["こう"],["しよう"],["と"],["心","こころ"],["に"],["決めた","きめた"],["とおり"],["に"],["し"],["なさい"],["。"],["喜んで","よろこんで"],["与える","あたえる"],["人","ひと"],["を"],["神","かみ"],["は"],["愛して","あいして"],["くださる"],["から"],["です"],["。"]]},{"verse":8,"text":"神は、あなたがたがいつもすべての点ですべてのものに十分で、あらゆる善い業に満ちあふれるように、あらゆる恵みをあなたがたに満ちあふれさせることがおできになります。","tok":[["神","かみ"],["は"],["、"],["あなた"],["がた"],["が"],["いつも"],["すべて"],["の"],["点","てん"],["で"],["すべて"],["の"],["もの"],["に"],["十分","じゅうぶん"],["で"],["、"],["あらゆる"],["善い","よい"],["業","ごう"],["に"],["満ちあふれる","みちあふれる"],["よう"],["に"],["、"],["あらゆる"],["恵み","めぐみ"],["を"],["あなた"],["がた"],["に"],["満ちあふれさせる","みちあふれさせる"],["こと"],["が"],["おでき"],["に"],["なります"],["。"]]},{"verse":9,"text":"「彼は惜しみなく分け与え、貧しい人に施した。彼の慈しみは永遠に続く」と書いてあるとおりです。","tok":[["「"],["彼","かれ"],["は"],["惜しみなく","おしみなく"],["分け与え","わけあたえ"],["、"],["貧しい","まずしい"],["人","ひと"],["に"],["施した","ほどこした"],["。"],["彼","かれ"],["の"],["慈しみ","いつくしみ"],["は"],["永遠","えいえん"],["に"],["続く","つづく"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":10,"text":"種を蒔く人に種を与え、パンを糧としてお与えになる方は、あなたがたに種を与えて、それを増やし、あなたがたの慈しみが結ぶ実を成長させてくださいます。","tok":[["種","しゅ"],["を"],["蒔く","まく"],["人","ひと"],["に"],["種","しゅ"],["を"],["与え","あたえ"],["、"],["パン"],["を"],["糧","かて"],["として"],["お与え","おあたえ"],["に"],["なる"],["方","かた"],["は"],["、"],["あなた"],["がた"],["に"],["種","しゅ"],["を"],["与えて","あたえて"],["、"],["それ"],["を"],["増やし","ふやし"],["、"],["あなた"],["がた"],["の"],["慈しみ","いつくしみ"],["が"],["結ぶ","むすぶ"],["実","じつ"],["を"],["成長","せいちょう"],["させて"],["くださいます"],["。"]]},{"verse":11,"text":"あなたがたはすべてのことに富む者とされて惜しまず施すようになり、その施しは、わたしたちを通じて神に対する感謝の念を引き出します。","tok":[["あなた"],["がた"],["は"],["すべて"],["の"],["こと"],["に"],["富む","とむ"],["者","もの"],["と"],["されて"],["惜しまず","おしまず"],["施す","ほどこす"],["よう"],["に"],["なり"],["、"],["その"],["施し","ほどこし"],["は"],["、"],["わたしたち"],["を"],["通じて","つうじて"],["神","かみ"],["に"],["対する","たいする"],["感謝","かんしゃ"],["の"],["念","ねん"],["を"],["引き出します","ひきだします"],["。"]]},{"verse":12,"text":"なぜなら、この奉仕の働きは、聖なる者たちの不足しているものを補うばかりでなく、神に対する多くの感謝を通してますます盛んになるからです。","tok":[["なぜ"],["なら"],["、"],["この"],["奉仕","ほうし"],["の"],["働き","はたらき"],["は"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["不足","ふそく"],["して"],["いる"],["もの"],["を"],["補う","おぎなう"],["ばかり"],["で"],["なく"],["、"],["神","かみ"],["に"],["対する","たいする"],["多く","おおく"],["の"],["感謝","かんしゃ"],["を"],["通して","とおして"],["ますます"],["盛ん","さかん"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":13,"text":"この奉仕の業が実際に行われた結果として、彼らは、あなたがたがキリストの福音を従順に公言していること、また、自分たちや他のすべての人々に惜しまず施しを分けてくれることで、神をほめたたえます。","tok":[["この"],["奉仕","ほうし"],["の"],["業","ごう"],["が"],["実際","じっさい"],["に"],["行われた","おこなわれた"],["結果","けっか"],["として"],["、"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["がた"],["が"],["キリスト"],["の"],["福音","ふくいん"],["を"],["従順","じゅうじゅん"],["に"],["公言","こうげん"],["して"],["いる"],["こと"],["、"],["また"],["、"],["自分","じぶん"],["たち"],["や"],["他","ほか"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["惜しまず","おしまず"],["施し","ほどこし"],["を"],["分けて","わけて"],["くれる"],["こと"],["で"],["、"],["神","かみ"],["を"],["ほめたたえます"],["。"]]},{"verse":14,"text":"更に、彼らはあなたがたに与えられた神のこの上なくすばらしい恵みを見て、あなたがたを慕い、あなたがたのために祈るのです。","tok":[["更に","さらに"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["がた"],["に"],["与えられた","あたえられた"],["神","かみ"],["の"],["この"],["上","うえ"],["なく"],["すばらしい"],["恵み","めぐみ"],["を"],["見て","みて"],["、"],["あなた"],["がた"],["を"],["慕い","したい"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["祈る","いのる"],["の"],["です"],["。"]]},{"verse":15,"text":"言葉では言い尽くせない贈り物について神に感謝します。","tok":[["言葉","ことば"],["で"],["は"],["言い","いい"],["尽くせない","つくせない"],["贈り物","おくりもの"],["について"],["神","かみ"],["に"],["感謝","かんしゃ"],["します"],["。"]]}]
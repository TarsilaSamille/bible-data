[{"verse":1,"text":"わたしの少しばかりの愚かさを我慢してくれたらよいが。いや、あなたがたは我慢してくれています。","tok":[["わたし"],["の"],["少し","すこし"],["ばかり"],["の"],["愚か","おろか"],["さ"],["を"],["我慢","がまん"],["して"],["くれたら"],["よい"],["が"],["。"],["いや"],["、"],["あなた"],["がた"],["は"],["我慢","がまん"],["して"],["くれて"],["います"],["。"]]},{"verse":2,"text":"あなたがたに対して、神が抱いておられる熱い思いをわたしも抱いています。なぜなら、わたしはあなたがたを純潔な処女として一人の夫と婚約させた、つまりキリストに献げたからです。","tok":[["あなた"],["がた"],["に対して","にたいして"],["、"],["神","かみ"],["が"],["抱いて","いだいて"],["おられる"],["熱い","あつい"],["思い","おもい"],["を"],["わたし"],["も"],["抱いて","いだいて"],["います"],["。"],["なぜ"],["なら"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["純潔","じゅんけつ"],["な"],["処女","しょじょ"],["として"],["一人","ひとり"],["の"],["夫","おっと"],["と"],["婚約","こんやく"],["させた"],["、"],["つまり"],["キリスト"],["に"],["献げた","ささげた"],["から"],["です"],["。"]]},{"verse":3,"text":"ただ、エバが蛇の悪だくみで欺かれたように、あなたがたの思いが汚されて、キリストに対する真心と純潔とからそれてしまうのではないかと心配しています。","tok":[["ただ"],["、"],["エバ"],["が"],["蛇","へび"],["の"],["悪だくみ","わるだくみ"],["で"],["欺かれた","あざむかれた"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["思い","おもい"],["が"],["汚されて","よごされて"],["、"],["キリスト"],["に"],["対する","たいする"],["真心","まごころ"],["と"],["純潔","じゅんけつ"],["と"],["からそれて"],["しまう"],["ので"],["は"],["ない"],["か"],["と"],["心配","しんぱい"],["して"],["います"],["。"]]},{"verse":4,"text":"なぜなら、あなたがたは、だれかがやって来てわたしたちが宣べ伝えたのとは異なったイエスを宣べ伝えても、あるいは、自分たちが受けたことのない違った霊や、受け入れたことのない違った福音を受けることになっても、よく我慢しているからです。","tok":[["なぜ"],["なら"],["、"],["あなた"],["がた"],["は"],["、"],["だれ"],["か"],["が"],["やって"],["来て","きて"],["わたしたち"],["が"],["宣べ伝えた","のべつたえた"],["の"],["と"],["は"],["異なった","ことなった"],["イエス"],["を"],["宣べ伝えて","のべつたえて"],["も"],["、"],["あるいは"],["、"],["自分","じぶん"],["たち"],["が"],["受けた","うけた"],["こと"],["の"],["ない"],["違った","ちがった"],["霊","れい"],["や"],["、"],["受け入れた","うけいれた"],["こと"],["の"],["ない"],["違った","ちがった"],["福音","ふくいん"],["を"],["受ける","うける"],["こと"],["に"],["なって"],["も"],["、"],["よく"],["我慢","がまん"],["して"],["いる"],["から"],["です"],["。"]]},{"verse":5,"text":"あの大使徒たちと比べて、わたしは少しも引けは取らないと思う。","tok":[["あの"],["大使","たいし"],["徒","と"],["たち"],["と"],["比べて","くらべて"],["、"],["わたし"],["は"],["少し","すこし"],["も"],["引け","ひけ"],["は"],["取らない","とらない"],["と"],["思う","おもう"],["。"]]},{"verse":6,"text":"たとえ、話し振りは素人でも、知識はそうではない。そして、わたしたちはあらゆる点あらゆる面で、このことをあなたがたに示してきました。","tok":[["たとえ"],["、"],["話し","はなし"],["振り","ふり"],["は"],["素人","しろうと"],["で"],["も"],["、"],["知識","ちしき"],["は"],["そう"],["で"],["は"],["ない"],["。"],["そして"],["、"],["わたしたち"],["は"],["あらゆる"],["点","てん"],["あらゆる"],["面","めん"],["で"],["、"],["この"],["こと"],["を"],["あなた"],["がた"],["に"],["示して","しめして"],["きました"],["。"]]},{"verse":7,"text":"それとも、あなたがたを高めるため、自分を低くして神の福音を無報酬で告げ知らせたからといって、わたしは罪を犯したことになるでしょうか。","tok":[["それ"],["と"],["も"],["、"],["あなた"],["がた"],["を"],["高める","たかめる"],["ため"],["、"],["自分","じぶん"],["を"],["低く","ひくく"],["して"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["無報酬","むほうしゅう"],["で"],["告げ知らせた","つげしらせた"],["から"],["と"],["いって"],["、"],["わたし"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["こと"],["に"],["なるでしょう"],["か"],["。"]]},{"verse":8,"text":"わたしは、他の諸教会からかすめ取るようにしてまでも、あなたがたに奉仕するための生活費を手に入れました。","tok":[["わたし"],["は"],["、"],["他","た"],["の"],["諸教","しょきょう"],["会","かい"],["から"],["かすめ取る","かすめとる"],["よう"],["に"],["して"],["まで"],["も"],["、"],["あなた"],["がた"],["に"],["奉仕","ほうし"],["する"],["ため"],["の"],["生活費","せいかつひ"],["を"],["手","て"],["に"],["入れました","いれました"],["。"]]},{"verse":9,"text":"あなたがたのもとで生活に不自由したとき、だれにも負担をかけませんでした。マケドニア州から来た兄弟たちが、わたしの必要を満たしてくれたからです。そして、わたしは何事においてもあなたがたに負担をかけないようにしてきたし、これからもそうするつもりです。","tok":[["あなた"],["がた"],["の"],["もと"],["で"],["生活","せいかつ"],["に"],["不自由","ふじゆう"],["した"],["とき"],["、"],["だれ"],["に"],["も"],["負担","ふたん"],["を"],["かけませんでした"],["。"],["マケドニア"],["州","しゅう"],["から"],["来た","きた"],["兄弟","きょうだい"],["たち"],["が"],["、"],["わたし"],["の"],["必要","ひつよう"],["を"],["満たして","みたして"],["くれた"],["から"],["です"],["。"],["そして"],["、"],["わたし"],["は"],["何事","なにごと"],["に"],["おいて"],["も"],["あなた"],["がた"],["に"],["負担","ふたん"],["を"],["かけない"],["よう"],["に"],["して"],["きた"],["し"],["、"],["これ"],["から"],["も"],["そう"],["する"],["つもり"],["です"],["。"]]},{"verse":10,"text":"わたしの内にあるキリストの真実にかけて言います。このようにわたしが誇るのを、アカイア地方で妨げられることは決してありません。","tok":[["わたし"],["の"],["内","うち"],["に"],["ある"],["キリスト"],["の"],["真実","しんじつ"],["に"],["かけて"],["言います","いいます"],["。"],["この"],["よう"],["に"],["わ
[{"verse":1,"text":"愛する人たち、わたしたちは、このような約束を受けているのですから、肉と霊のあらゆる汚れから自分を清め、神を畏れ、完全に聖なる者となりましょう。","tok":[["愛する","あいする"],["人","ひと"],["たち"],["、"],["わたしたち"],["は"],["、"],["この"],["よう"],["な"],["約束","やくそく"],["を"],["受けて","うけて"],["いる"],["の"],["です"],["から"],["、"],["肉","にく"],["と"],["霊","れい"],["の"],["あらゆる"],["汚れ","よごれ"],["から"],["自分","じぶん"],["を"],["清め","きよめ"],["、"],["神","かみ"],["を"],["畏れ","おそれ"],["、"],["完全","かんぜん"],["に"],["聖","せい"],["なる"],["者","もの"],["と"],["なりましょう"],["。"]]},{"verse":2,"text":"わたしたちに心を開いてください。わたしたちはだれにも不義を行わず、だれをも破滅させず、だれからもだまし取ったりしませんでした。","tok":[["わたしたち"],["に"],["心","こころ"],["を"],["開いて","ひらいて"],["ください"],["。"],["わたしたち"],["は"],["だれ"],["に"],["も"],["不義","ふぎ"],["を"],["行わず","おこなわず"],["、"],["だれ"],["を"],["も"],["破滅","はめつ"],["させず"],["、"],["だれ"],["から"],["も"],["だまし取っ","だましとっ"],["たり"],["しませんでした"],["。"]]},{"verse":3,"text":"あなたがたを、責めるつもりで、こう言っているのではありません。前にも言ったように、あなたがたはわたしたちの心の中にいて、わたしたちと生死を共にしているのです。","tok":[["あなた"],["がた"],["を"],["、"],["責める","せめる"],["つもり"],["で"],["、"],["こう"],["言って","いって"],["いる"],["ので"],["は"],["ありません"],["。"],["前","まえ"],["に"],["も"],["言った","いった"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["わたしたち"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["いて"],["、"],["わたしたち"],["と"],["生死","せいし"],["を"],["共","とも"],["に"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"わたしはあなたがたに厚い信頼を寄せており、あなたがたについて大いに誇っています。わたしは慰めに満たされており、どんな苦難のうちにあっても喜びに満ちあふれています。","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["厚い","あつい"],["信頼","しんらい"],["を"],["寄せて","よせて"],["おり"],["、"],["あなた"],["がた"],["について"],["大いに","おおいに"],["誇って","ほこって"],["います"],["。"],["わたし"],["は"],["慰め","なぐさめ"],["に"],["満たされて","みたされて"],["おり"],["、"],["どんな"],["苦難","くなん"],["の"],["うち"],["に"],["あって"],["も"],["喜び","よろこび"],["に"],["満ちあふれて","みちあふれて"],["います"],["。"]]},{"verse":5,"text":"マケドニア州に着いたとき、わたしたちの身には全く安らぎがなく、ことごとに苦しんでいました。外には戦い、内には恐れがあったのです。","tok":[["マケドニア"],["州","しゅう"],["に"],["着いた","ついた"],["とき"],["、"],["わたしたち"],["の"],["身","み"],["に"],["は"],["全く","まったく"],["安らぎ","やすらぎ"],["が"],["なく"],["、"],["こと"],["ごと"],["に"],["苦しんで","くるしんで"],["いました"],["。"],["外","そと"],["に"],["は"],["戦い","たたかい"],["、"],["内","うち"],["に"],["は"],["恐れ","おそれ"],["が"],["あった"],["の"],["です"],["。"]]},{"verse":6,"text":"しかし、気落ちした者を力づけてくださる神は、テトスの到着によってわたしたちを慰めてくださいました。","tok":[["しかし"],["、"],["気落ち","きおち"],["した"],["者","もの"],["を"],["力づけて","ちからづけて"],["くださる"],["神","かみ"],["は"],["、"],["テトス"],["の"],["到着","とうちゃく"],["によって"],["わたしたち"],["を"],["慰めて","なぐさめて"],["くださいました"],["。"]]},{"verse":7,"text":"テトスが来てくれたことによってだけではなく、彼があなたがたから受けた慰めによっても、そうしてくださったのです。つまり、あなたがたがわたしを慕い、わたしのために嘆き悲しみ、わたしに対して熱心であることを彼が伝えてくれたので、わたしはいっそう喜んだのです。","tok":[["テトス"],["が"],["来て","きて"],["くれた"],["こと"],["によって"],["だけ"],["で"],["は"],["なく"],["、"],["彼","かれ"],["が"],["あなた"],["がた"],["から"],["受けた","うけた"],["慰め","なぐさめ"],["によって"],["も"],["、"],["そう"],["して"],["くださった"],["の"],["です"],["。"],["つまり"],["、"],["あなた"],["がた"],["が"],["わたし"],["を"],["慕い","したい"],["、"],["わたし"],["の"],["ため"],["に"],["嘆き悲しみ","なげきかなしみ"],["、"],["わたし"],["に対して","にたいして"],["熱心","ねっしん"],["で"],["ある"],["こと"],["を"],["彼","かれ"],["が"],["伝えて","つたえて"],["くれた"],["ので"],["、"],["わたし"],["は"],["いっそう"],["喜んだ","よろこんだ"],["の"],["です"],["。"]]},{"verse":8,"text":"あの手紙によってあなたがたを悲しませたとしても、わたしは後悔しません。確かに、あの手紙が一時にもせよ、あなたがたを悲しませたことは知っています。たとえ後悔したとしても、","tok":[["あの"],["手紙","てがみ"],["によって"],["あなた"],["がた"],["を"],["悲しませた","かなしませた"],["として"],["も"],["、"],["わたし"],["は"],["後悔","こうかい"],["しません"],["。"],["確か","たしか"],["に"],["、"],["あの"],["手紙","てがみ"],["が"],["一時","いちじ"],["に"],["も"],["せよ"],["、"],["あなた"],["がた"],["を"],["悲しませた","かなしませた"],["こと"],["は"],["知って","しって"],["います"],["。"],["たとえ"],["後悔","こうかい"],["した"],["として"],["も"],["、"]]},{"verse":9,"text":"今は喜んでいます。あなたがたがただ悲しんだからではなく、悲しんで悔い改めたからです。あなたがたが悲しんだのは神の御心に適ったことなので、わたしたちからは何の害も受けずに済みました。","tok":[["今","いま"],["は"],["喜んで","よろこんで"],["います"],["。"],["あなた"],["がた"],["が"],["ただ"],["悲しんだ","かなしんだ"],["から"],["で"],["は"],["なく"],["、"],["悲しんで","かなしんで"],["悔い改めた","くいあらためた"],["から"],["です"],["。"],["あなた"],["がた"],["が"],["悲しんだ","かなしんだ"],["の"],["は"],["神","かみ"],["の"],["御心","おこころ"],["に"],["適った","かなった"],["こと"],["な"],["ので"],["、"],["わたしたち"],["から"],["は"],["何","なん"],["の"],["害","がい"],["も"],["受けず","うけず"],["に"],["済みました","すみました"],["。"]]},{"verse":10,"text":"神の御心に適った悲しみは、取り消されることのない救いに通じる悔い改めを生じさせ、世の悲しみは死をもたらします。","tok":[["神","かみ"],["の"],["御心","おこころ"],["に"],["適った","かなった"],["悲しみ","かなしみ"],["は"],["、"],["取り消される","とりけされる"],["こと"],["の"],["ない"],["救い","すくい"],["に"],["通じる","つうじる"],["悔い改め","くいあらため"],["を"],["生じさせ","しょうじさせ"],["、"],["世","よ"],["の"],["悲しみ","かなしみ"],["は"],["死","し"],["を"],["もたらします"],["。"]]},{"verse":11,"text":"神の御心に適ったこの悲しみが、あなたがたにどれほどの熱心、弁明、憤り、恐れ、あこがれ、熱意、懲らしめをもたらしたことでしょう。例の事件に関しては、あなたがたは自分がすべての点で潔白であることを証明しました。","tok":[["神","かみ"],["の"],["御心","おこころ"],["に"],["適った","かなった"],["この"],["悲しみ","かなしみ"],["が"],["、"],["あなた"],["がた"],["に"],["どれ"],["ほど"],["の"],["熱心","ねっしん"],["、"],["弁明","べんめい"],["、"],["憤り","いきどおり"],["、"],["恐れ","おそれ"],["、"],["あこがれ"],["、"],["熱意","ねつい"],["、"],["懲らしめ","こらしめ"],["を"],["もたらした"],["こと"],["でしょう"],["。"],["例","れい"],["の"],["事件","じけん"],["に"],["関し","かんし"],["ては"],["、"],["あなた"],["がた"],["は"],["自分","じぶん"],["が"],["すべて"],["の"],["点","てん"],["で"],["潔白","けっぱく"],["で"],["ある"],["こと"],["を"],["証明","しょうめい"],["しました"],["。"]]},{"verse":12,"text":"ですから、あなたがたに手紙を送ったのは、不義を行った者のためでも、その被害者のためでもなく、わたしたちに対するあなたがたの熱心を、神の御前であなたがたに明らかにするためでした。","tok":[["です"],["から"],["、"],["あなた"],["がた"],["に"],["手紙","てがみ"],["を"],["送った","おくった"],["の"],["は"],["、"],["不義","ふぎ"],["を"],["行った","おこなった"],["者","もの"],["の"],["ため"],["で"],["も"],["、"],["その"],["被害者","ひがいしゃ"],["の"],["ため"],["で"],["も"],["なく"],["、"],["わたしたち"],["に"],["対する","たいする"],["あなた"],["がた"],["の"],["熱心","ねっしん"],["を"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["あなた"],["がた"],["に"],["明らか","あきらか"],["に"],["する"],["ため"],["でした"],["。"]]},{"verse":13,"text":"こういうわけでわたしたちは慰められたのです。この慰めに加えて、テトスの喜ぶさまを見て、わたしたちはいっそう喜びました。彼の心があなたがた一同のお陰で元気づけられたからです。","tok":[["こう"],["いう"],["わけ"],["で"],["わたしたち"],["は"],["慰められた","なぐさめられた"],["の"],["です"],["。"],["この"],["慰め","なぐさめ"],["に"],["加えて","くわえて"],["、"],["テトス"],["の"],["喜ぶ","よろこぶ"],["さま"],["を"],["見て","みて"],["、"],["わたしたち"],["は"],["いっそう"],["喜びました","よろこびました"],["。"],["彼","かれ"],["の"],["心","こころ"],["が"],["あなた"],["がた"],["一同","いちどう"],["の"],["お陰","おかげ"],["で"],["元気","げんき"],["づけられた"],["から"],["です"],["。"]]},{"verse":14,"text":"わたしはあなたがたのことをテトスに少し誇りましたが、そのことで恥をかかずに済みました。それどころか、わたしたちはあなたがたにすべて真実を語ったように、テトスの前で誇ったことも真実となったのです。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["こと"],["を"],["テトス"],["に"],["少し","すこし"],["誇りました","ほこりました"],["が"],["、"],["その"],["こと"],["で"],["恥","はじ"],["を"],["かかず"],["に"],["済みました","すみました"],["。"],["それ"],["どころ"],["か"],["、"],["わたしたち"],["は"],["あなた"],["がた"],["に"],["すべて"],["真実","しんじつ"],["を"],["語った","かたった"],["よう"],["に"],["、"],["テトス"],["の"],["前","まえ"],["で"],["誇った","ほこった"],["こと"],["も"],["真実","しんじつ"],["と"],["なった"],["の"],["です"],["。"]]},{"verse":15,"text":"テトスは、あなたがた一同が従順で、どんなに恐れおののいて歓迎してくれたかを思い起こして、ますますあなたがたに心を寄せています。","tok":[["テトス"],["は"],["、"],["あなた"],["がた"],["一同","いちどう"],["が"],["従順","じゅうじゅん"],["で"],["、"],["どんな"],["に"],["恐れおののいて","おそれおののいて"],["歓迎","かんげい"],["して"],["くれた"],["か"],["を"],["思い起こして","おもいおこして"],["、"],["ますます"],["あなた"],["がた"],["に"],["心","こころ"],["を"],["寄せて","よせて"],["います"],["。"]]},{"verse":16,"text":"わたしは、すべての点であなたがたを信頼できることを喜んでいます。","tok":[["わたし"],["は"],["、"],["すべて"],["の"],["点","てん"],["で"],["あなた"],["がた"],["を"],["信頼","しんらい"],["できる"],["こと"],["を"],["喜んで","よろこんで"],["います"],["。"]]}]
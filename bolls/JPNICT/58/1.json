[{"verse":1,"text":"神は、かつて預言者たちによって、多くのかたちで、また多くのしかたで先祖に語られたが、","tok":[["神","かみ"],["は"],["、"],["かつて"],["預言者","よげんしゃ"],["たち"],["によって"],["、"],["多く","おおく"],["の"],["かたち"],["で"],["、"],["また"],["多く","おおく"],["の"],["しかた"],["で"],["先祖","せんぞ"],["に"],["語られた","かたられた"],["が"],["、"]]},{"verse":2,"text":"この終わりの時代には、御子によってわたしたちに語られました。神は、この御子を万物の相続者と定め、また、御子によって世界を創造されました。","tok":[["この"],["終わり","おわり"],["の"],["時代","じだい"],["に"],["は"],["、"],["御子","みこ"],["によって"],["わたしたち"],["に"],["語られました","かたられました"],["。"],["神","かみ"],["は"],["、"],["この"],["御子","みこ"],["を"],["万物","ばんぶつ"],["の"],["相続者","そうぞくしゃ"],["と"],["定め","さだめ"],["、"],["また"],["、"],["御子","みこ"],["によって"],["世界","せかい"],["を"],["創造","そうぞう"],["されました"],["。"]]},{"verse":3,"text":"御子は、神の栄光の反映であり、神の本質の完全な現れであって、万物を御自分の力ある言葉によって支えておられますが、人々の罪を清められた後、天の高い所におられる大いなる方の右の座にお着きになりました。","tok":[["御子","みこ"],["は"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["の"],["反映","はんえい"],["で"],["あり"],["、"],["神","かみ"],["の"],["本質","ほんしつ"],["の"],["完全","かんぜん"],["な"],["現れ","あらわれ"],["で"],["あって"],["、"],["万物","ばんぶつ"],["を"],["御自分","ごじぶん"],["の"],["力","ちから"],["ある"],["言葉","ことば"],["によって"],["支えて","ささえて"],["おられます"],["が"],["、"],["人々","ひとびと"],["の"],["罪","つみ"],["を"],["清められた","きよめられた"],["後","あと"],["、"],["天","てん"],["の"],["高い","たかい"],["所","ところ"],["に"],["おられる"],["大いなる","おおいなる"],["方","かた"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["お着き","おつき"],["に"],["なりました"],["。"]]},{"verse":4,"text":"御子は、天使たちより優れた者となられました。天使たちの名より優れた名を受け継がれたからです。","tok":[["御子","みこ"],["は"],["、"],["天使","てんし"],["たち"],["より"],["優れた","すぐれた"],["者","もの"],["と"],["なられました"],["。"],["天使","てんし"],["たち"],["の"],["名","な"],["より"],["優れた","すぐれた"],["名","な"],["を"],["受け継がれた","うけつがれた"],["から"],["です"],["。"]]},{"verse":5,"text":"いったい神は、かつて天使のだれに、「あなたはわたしの子、わたしは今日、あなたを産んだ」と言われ、更にまた、「わたしは彼の父となり、彼はわたしの子となる」と言われたでしょうか。","tok":[["いったい"],["神","かみ"],["は"],["、"],["かつて"],["天使","てんし"],["の"],["だれ"],["に"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["子","こ"],["、"],["わたし"],["は"],["今日","きょう"],["、"],["あなた"],["を"],["産んだ","うんだ"],["」"],["と"],["言われ","いわれ"],["、"],["更に","さらに"],["また"],["、"],["「"],["わたし"],["は"],["彼","かれ"],["の"],["父","ちち"],["と"],["なり"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["子","こ"],["と"],["なる"],["」"],["と"],["言われたでしょう","いわれたでしょう"],["か"],["。"]]},{"verse":6,"text":"更にまた、神はその長子をこの世界に送るとき、「神の天使たちは皆、彼を礼拝せよ」と言われました。","tok":[["更に","さらに"],["また"],["、"],["神","かみ"],["は"],["その"],["長子","ちょうし"],["を"],["この"],["世界","せかい"],["に"],["送る","おくる"],["とき"],["、"],["「"],["神","かみ"],["の"],["天使","てんし"],["たち"],["は"],["皆","みな"],["、"],["彼","かれ"],["を"],["礼拝","れいはい"],["せよ"],["」"],["と"],["言われました","いわれました"],["。"]]},{"verse":7,"text":"また、天使たちに関しては、「神は、その天使たちを風とし、御自分に仕える者たちを燃える炎とする」と言われ、","tok":[["また"],["、"],["天使","てんし"],["たち"],["に"],["関し","かんし"],["ては"],["、"],["「"],["神","かみ"],["は"],["、"],["その"],["天使","てんし"],["たち"],["を"],["風","かぜ"],["と"],["し"],["、"],["御自分","ごじぶん"],["に"],["仕える","つかえる"],["者","もの"],["たち"],["を"],["燃える","もえる"],["炎","ほのお"],["と"],["する"],["」"],["と"],["言われ","いわれ"],["、"]]},{"verse":8,"text":"一方、御子に向かっては、こう言われました。「神よ、あなたの玉座は永遠に続き、また、公正の笏が御国の笏である。","tok":[["一方","いっぽう"],["、"],["御子","みこ"],["に"],["向かって","むかって"],["は"],["、"],["こう"],["言われました","いわれました"],["。"],["「"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["玉座","ぎょくざ"],["は"],["永遠","えいえん"],["に"],["続き","つづき"],["、"],["また"],["、"],["公正","こうせい"],["の"],["笏","しゃく"],["が"],["御国","みくに"],["の"],["笏","しゃく"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたは義を愛し、不法を憎んだ。それゆえ、神よ、あなたの神は、喜びの油を、あなたの仲間に注ぐよりも多く、あなたに注いだ。」","tok":[["あなた"],["は"],["義","ぎ"],["を"],["愛し","あいし"],["、"],["不法","ふほう"],["を"],["憎んだ","にくんだ"],["。"],["それ"],["ゆえ"],["、"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["神","かみ"],["は"],["、"],["喜び","よろこび"],["の"],["油","あぶら"],["を"],["、"],["あなた"],["の"],["仲間","なかま"],["に"],["注ぐ","そそぐ"],["より"],["も"],["多く","おおく"],["、"],["あなた"],["に"],["注いだ","そそいだ"],["。"],["」"]]},{"verse":10,"text":"また、こうも言われています。「主よ、あなたは初めに大地の基を据えた。もろもろの天は、あなたの手の業である。","tok":[["また"],["、"],["こう"],["も"],["言われて","いわれて"],["います"],["。"],["「"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["初め","はじめ"],["に"],["大地","だいち"],["の"],["基","もと"],["を"],["据えた","すえた"],["。"],["もろもろ"],["の"],["天","てん"],["は"],["、"],["あなた"],["の"],["手","て"],["の"],["業","ごう"],["で"],["ある"],["。"]]},{"verse":11,"text":"これらのものは、やがて滅びる。だが、あなたはいつまでも生きている。すべてのものは、衣のように古び廃れる。","tok":[["これ"],["ら"],["の"],["もの"],["は"],["、"],["やがて"],["滅びる","ほろびる"],["。"],["だ"],["が"],["、"],["あなた"],["は"],["いつ"],["まで"],["も"],["生きて","いきて"],["いる"],["。"],["すべて"],["の"],["もの"],["は"],["、"],["衣","ころも"],["の"],["よう"],["に"],["古び","ふるび"],["廃れる","すたれる"],["。"]]},{"verse":12,"text":"あなたが外套のように巻くと、これらのものは、衣のように変わってしまう。しかし、あなたは変わることなく、あなたの年は尽きることがない。」","tok":[["あなた"],["が"],["外套","がいとう"],["の"],["よう"],["に"],["巻く","まく"],["と"],["、"],["これ"],["ら"],["の"],["もの"],["は"],["、"],["衣","ころも"],["の"],["よう"],["に"],["変わって","かわって"],["しまう"],["。"],["しかし"],["、"],["あなた"],["は"],["変わる","かわる"],["こと"],["なく"],["、"],["あなた"],["の"],["年","とし"],["は"],["尽きる","つきる"],["こと"],["が"],["ない"],["。"],["」"]]},{"verse":13,"text":"神は、かつて天使のだれに向かって、「わたしがあなたの敵をあなたの足台とするまで、わたしの右に座っていなさい」と言われたことがあるでしょうか。","tok":[["神","かみ"],["は"],["、"],["かつて"],["天使","てんし"],["の"],["だれ"],["に"],["向かって","むかって"],["、"],["「"],["わたし"],["が"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["足台","あしだい"],["と"],["する"],["まで"],["、"],["わたし"],["の"],["右","みぎ"],["に"],["座って","すわって"],["い"],["なさい"],["」"],["と"],["言われた","いわれた"],["こと"],["が"],["あるでしょう"],["か"],["。"]]},{"verse":14,"text":"天使たちは皆、奉仕する霊であって、救いを受け継ぐことになっている人々に仕えるために、遣わされたのではなかったですか。","tok":[["天使","てんし"],["たち"],["は"],["皆","みな"],["、"],["奉仕","ほうし"],["する"],["霊","れい"],["で"],["あって"],["、"],["救い","すくい"],["を"],["受け継ぐ","うけつぐ"],["こと"],["に"],["なって"],["いる"],["人々","ひとびと"],["に"],["仕える","つかえる"],["ため"],["に"],["、"],["遣わされた","つかわされた"],["ので"],["は"],["なかったです"],["か"],["。"]]}]
[{"verse":1,"text":"このメルキゼデクはサレムの王であり、いと高き神の祭司でしたが、王たちを滅ぼして戻って来たアブラハムを出迎え、そして祝福しました。","tok":[["この"],["メルキゼデク"],["は"],["サレム"],["の"],["王","おう"],["で"],["あり"],["、"],["いと"],["高き","たかき"],["神","かみ"],["の"],["祭司","さいし"],["でした"],["が"],["、"],["王","おう"],["たち"],["を"],["滅ぼして","ほろぼして"],["戻って","もどって"],["来た","きた"],["アブラハム"],["を"],["出迎え","でむかえ"],["、"],["そして"],["祝福","しゅくふく"],["しました"],["。"]]},{"verse":2,"text":"アブラハムは、メルキゼデクにすべてのものの十分の一を分け与えました。メルキゼデクという名の意味は、まず「義の王」、次に「サレムの王」、つまり「平和の王」です。","tok":[["アブラハム"],["は"],["、"],["メルキゼデク"],["に"],["すべて"],["の"],["もの"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["分け与えました","わけあたえました"],["。"],["メルキゼデク"],["と"],["いう"],["名","な"],["の"],["意味","いみ"],["は"],["、"],["まず"],["「"],["義","ぎ"],["の"],["王","おう"],["」"],["、"],["次","つぎ"],["に"],["「"],["サレム"],["の"],["王","おう"],["」"],["、"],["つまり"],["「"],["平和","へいわ"],["の"],["王","おう"],["」"],["です"],["。"]]},{"verse":3,"text":"彼には父もなく、母もなく、系図もなく、また、生涯の初めもなく、命の終わりもなく、神の子に似た者であって、永遠に祭司です。","tok":[["彼","かれ"],["に"],["は"],["父","ちち"],["も"],["なく"],["、"],["母","はは"],["も"],["なく"],["、"],["系図","けいず"],["も"],["なく"],["、"],["また"],["、"],["生涯","しょうがい"],["の"],["初め","はじめ"],["も"],["なく"],["、"],["命","いのち"],["の"],["終わり","おわり"],["も"],["なく"],["、"],["神","かみ"],["の"],["子","こ"],["に"],["似た","にた"],["者","もの"],["で"],["あって"],["、"],["永遠","えいえん"],["に"],["祭司","さいし"],["です"],["。"]]},{"verse":4,"text":"この人がどんなに偉大であったかを考えてみなさい。族長であるアブラハムさえ、最上の戦利品の中から十分の一を献げたのです。","tok":[["この"],["人","ひと"],["が"],["どんな"],["に"],["偉大","いだい"],["で"],["あった"],["か"],["を"],["考えて","かんがえて"],["み"],["なさい"],["。"],["族長","ぞくちょう"],["で"],["ある"],["アブラハム"],["さえ"],["、"],["最上","さいじょう"],["の"],["戦利品","せんりひん"],["の"],["中","なか"],["から"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["献げた","ささげた"],["の"],["です"],["。"]]},{"verse":5,"text":"ところで、レビの子らの中で祭司の職を受ける者は、同じアブラハムの子孫であるにもかかわらず、彼らの兄弟である民から十分の一を取るように、律法によって命じられています。","tok":[["ところ"],["で"],["、"],["レビ"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["で"],["祭司","さいし"],["の"],["職","しょく"],["を"],["受ける","うける"],["者","もの"],["は"],["、"],["同じ","おなじ"],["アブラハム"],["の"],["子孫","しそん"],["で"],["ある"],["に"],["も"],["かかわらず"],["、"],["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["で"],["ある"],["民","たみ"],["から"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["取る","とる"],["よう"],["に"],["、"],["律法","りっぽう"],["によって"],["命じられて","めいじられて"],["います"],["。"]]},{"verse":6,"text":"それなのに、レビ族の血統以外の者が、アブラハムから十分の一を受け取って、約束を受けている者を祝福したのです。","tok":[["それ"],["な"],["のに"],["、"],["レビ族","れびぞく"],["の"],["血統","けっとう"],["以外","いがい"],["の"],["者","もの"],["が"],["、"],["アブラハム"],["から"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["受け取って","うけとって"],["、"],["約束","やくそく"],["を"],["受けて","うけて"],["いる"],["者","もの"],["を"],["祝福","しゅくふく"],["した"],["の"],["です"],["。"]]},{"verse":7,"text":"さて、下の者が上の者から祝福を受けるのは、当然なことです。","tok":[["さて"],["、"],["下","した"],["の"],["者","もの"],["が"],["上","うえ"],["の"],["者","もの"],["から"],["祝福","しゅくふく"],["を"],["受ける","うける"],["の"],["は"],["、"],["当然","とうぜん"],["な"],["こと"],["です"],["。"]]},{"verse":8,"text":"更に、一方では、死ぬはずの人間が十分の一を受けているのですが、他方では、生きている者と証しされている者が、それを受けているのです。","tok":[["更に","さらに"],["、"],["一方","いっぽう"],["で"],["は"],["、"],["死ぬ","しぬ"],["はず"],["の"],["人間","にんげん"],["が"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["受けて","うけて"],["いる"],["の"],["です"],["が"],["、"],["他方","たほう"],["で"],["は"],["、"],["生きて","いきて"],["いる"],["者","もの"],["と"],["証し","あかし"],["されて"],["いる"],["者","もの"],["が"],["、"],["それ"],["を"],["受けて","うけて"],["いる"],["の"],["です"],["。"]]},{"verse":9,"text":"そこで、言ってみれば、十分の一を受けるはずのレビですら、アブラハムを通して十分の一を納めたことになります。","tok":[["そこ"],["で"],["、"],["言って","いって"],["みれば"],["、"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["受ける","うける"],["はず"],["の"],["レビ"],["で"],["すら"],["、"],["アブラハム"],["を"],["通して","とおして"],["十分","じゅうぶん"],["の"],["一","いち"],["を"],["納めた","おさめた"],["こと"],["に"],["なります"],["。"]]},{"verse":10,"text":"なぜなら、メルキゼデクがアブラハムを出迎えたとき、レビはまだこの父の腰の中にいたからです。","tok":[["なぜ"],["なら"],["、"],["メルキゼデク"],["が"],["アブラハム"],["を"],["出迎えた","でむかえた"],["とき"],["、"],["レビ"],["は"],["まだ"],["この"],["父","ちち"],["の"],["腰","こし"],["の"],["中","なか"],["に"],["いた"],["から"],["です"],["。"]]},{"verse":11,"text":"ところで、もし、レビの系統の祭司制度によって、人が完全な状態に達することができたとすれば、――というのは、民はその祭司制度に基づいて律法を与えられているのですから――いったいどうして、アロンと同じような祭司ではなく、メルキゼデクと同じような別の祭司が立てられる必要があるでしょう。","tok":[["ところ"],["で"],["、"],["もし"],["、"],["レビ"],["の"],["系統","けいとう"],["の"],["祭司","さいし"],["制度","せいど"],["によって"],["、"],["人","ひと"],["が"],["完全","かんぜん"],["な"],["状態","じょうたい"],["に"],["達する","たっする"],["こと"],["が"],["できた"],["と"],["すれば"],["、"],["―"],["―"],["と"],["いう"],["の"],["は"],["、"],["民","みん"],["は"],["その"],["祭司","さいし"],["制度","せいど"],["に"],["基づいて","もとづいて"],["律法","りっぽう"],["を"],["与えられて","あたえられて"],["いる"],["の"],["です"],["から"],["―"],["―"],["いったい"],["どう"],["して"],["、"],["アロン"],["と"],["同じ","おなじ"],["よう"],["な"],["祭司","さいし"],["で"],["は"],["なく"],["、"],["メルキゼデク"],["と"],["同じ","おなじ"],["よう"],["な"],["別","べつ"],["の"],["祭司","さいし"],["が"],["立てられる","たてられる"],["必要","ひつよう"],["が"],["あるでしょう"],["。"]]},{"verse":12,"text":"祭司制度に変更があれば、律法にも必ず変更があるはずです。","tok":[["祭司","さいし"],["制度","せいど"],["に"],["変更","へんこう"],["が"],["あれば"],["、"],["律法","りっぽう"],["に"],["も"],["必ず","かならず"],["変更","へんこう"],["が"],["ある"],["はず"],["です"],["。"]]},{"verse":13,"text":"このように言われている方は、だれも祭壇の奉仕に携わったことのない他の部族に属しておられます。","tok":[["この"],["よう"],["に"],["言われて","いわれて"],["いる"],["方","かた"],["は"],["、"],["だれ"],["も"],["祭壇","さいだん"],["の"],["奉仕","ほうし"],["に"],["携わった","たずさわった"],["こと"],["の"],["ない"],["他","ほか"],["の"],["部族","ぶぞく"],["に"],["属して","ぞくして"],["おられます"],["。"]]},{"verse":14,"text":"というのは、わたしたちの主がユダ族出身であることは明らかですが、この部族についてはモーセは、祭司に関することを何一つ述べていないからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["わたしたち"],["の"],["主","ぬし"],["が"],["ユダ族","ゆだぞく"],["出身","しゅっしん"],["で"],["ある"],["こと"],["は"],["明らか","あきらか"],["です"],["が"],["、"],["この"],["部族","ぶぞく"],["について"],["は"],["モーセ"],["は"],["、"],["祭司","さいし"],["に"],["関する","かんする"],["こと"],["を"],["何","なん"],["一","ひと"],["つ"],["述べて","のべて"],["いない"],["から"],["です"],["。"]]},{"verse":15,"text":"このことは、メルキゼデクと同じような別の祭司が立てられたことによって、ますます明らかです。","tok":[["この"],["こと"],["は"],["、"],["メルキゼデク"],["と"],["同じ","おなじ"],["よう"],["な"],["別","べつ"],["の"],["祭司","さいし"],["が"],["立てられた","たてられた"],["こと"],["によって"],["、"],["ますます"],["明らか","あきらか"],["です"],["。"]]},{"verse":16,"text":"この祭司は、肉の掟の律法によらず、朽ちることのない命の力によって立てられたのです。","tok":[["この"],["祭司","さいし"],["は"],["、"],["肉","にく"],["の"],["掟","おきて"],["の"],["律法","りっぽう"],["に"],["よらず"],["、"],["朽ちる","くちる"],["こと"],["の"],["ない"],["命","いのち"],["の"],["力","ちから"],["によって"],["立てられた","たてられた"],["の"],["です"],["。"]]},{"verse":17,"text":"なぜなら、「あなたこそ永遠に、メルキゼデクと同じような祭司である」と証しされているからです。","tok":[["なぜ"],["なら"],["、"],["「"],["あなた"],["こそ"],["永遠","えいえん"],["に"],["、"],["メルキゼデク"],["と"],["同じ","おなじ"],["よう"],["な"],["祭司","さいし"],["で"],["ある"],["」"],["と"],["証し","あかし"],["されて"],["いる"],["から"],["です"],["。"]]},{"verse":18,"text":"その結果、一方では、以前の掟が、その弱く無益なために廃止されました。――","tok":[["その"],["結果","けっか"],["、"],["一方","いっぽう"],["で"],["は"],["、"],["以前","いぜん"],["の"],["掟","おきて"],["が"],["、"],["その"],["弱く","よわく"],["無益","むえき"],["な"],["ため"],["に"],["廃止","はいし"],["されました"],["。"],["―"],["―"]]},{"verse":19,"text":"律法が何一つ完全なものにしなかったからです――しかし、他方では、もっと優れた希望がもたらされました。わたしたちは、この希望によって神に近づくのです。","tok":[["律法","りっぽう"],["が"],["何","なん"],["一","ひと"],["つ"],["完全","かんぜん"],["な"],["もの"],["に"],["しなかった"],["から"],["です"],["―"],["―"],["しかし"],["、"],["他方","たほう"],["で"],["は"],["、"],["もっと"],["優れた","すぐれた"],["希望","きぼう"],["が"],["もたらされました"],["。"],["わたしたち"],["は"],["、"],["この"],["希望","きぼう"],["によって"],["神","かみ"],["に"],["近づく","ちかづく"],["の"],["です"],["。"]]},{"verse":20,"text":"また、これは誓いによらないで行われたのではありません。レビの系統の祭司たちは、誓いによらないで祭司になっているのですが、","tok":[["また"],["、"],["これ"],["は"],["誓い","ちかい"],["に"],["よらないで"],["行われた","おこなわれた"],["ので"],["は"],["ありません"],["。"],["レビ"],["の"],["系統","けいとう"],["の"],["祭司","さいし"],["たち"],["は"],["、"],["誓い","ちかい"],["に"],["よらないで"],["祭司","さいし"],["に"],["なって"],["いる"],["の"],["です"],["が"],["、"]]},{"verse":21,"text":"この方は、誓いによって祭司となられたのです。神はこの方に対してこう言われました。「主はこう誓われ、その御心を変えられることはない。『あなたこそ、永遠に祭司である。』」","tok":[["この"],["方","かた"],["は"],["、"],["誓い","ちかい"],["によって"],["祭司","さいし"],["と"],["なられた"],["の"],["です"],["。"],["神","かみ"],["は"],["この"],["方","かた"],["に対して","にたいして"],["こう"],["言われました","いわれました"],["。"],["「"],["主","ぬし"],["は"],["こう"],["誓われ","ちかわれ"],["、"],["その"],["御心","おこころ"],["を"],["変えられる","かえられる"],["こと"],["は"],["ない"],["。"],["『"],["あなた"],["こそ"],["、"],["永遠","えいえん"],["に"],["祭司","さいし"],["で"],["ある"],["。"],["』"],["」"]]},{"verse":22,"text":"このようにして、イエスはいっそう優れた契約の保証となられたのです。","tok":[["この"],["よう"],["に"],["して"],["、"],["イエス"],["は"],["いっそう"],["優れた","すぐれた"],["契約","けいやく"],["の"],["保証","ほしょう"],["と"],["なられた"],["の"],["です"],["。"]]},{"verse":23,"text":"また、レビの系統の祭司たちの場合には、死というものがあるので、務めをいつまでも続けることができず、多くの人たちが祭司に任命されました。","tok":[["また"],["、"],["レビ"],["の"],["系統","けいとう"],["の"],["祭司","さいし"],["たち"],["の"],["場合","ばあい"],["に"],["は"],["、"],["死","し"],["と"],["いう"],["もの"],["が"],["ある"],["ので"],["、"],["務め","つとめ"],["を"],["いつ"],["まで"],["も"],["続ける","つづける"],["こと"],["が"],["できず"],["、"],["多く","おおく"],["の"],["人","ひと"],["たち"],["が"],["祭司","さいし"],["に"],["任命","にんめい"],["されました"],["。"]]},{"verse":24,"text":"しかし、イエスは永遠に生きているので、変わることのない祭司職を持っておられるのです。","tok":[["しかし"],["、"],["イエス"],["は"],["永遠","えいえん"],["に"],["生きて","いきて"],["いる"],["ので"],["、"],["変わる","かわる"],["こと"],["の"],["ない"],["祭司","さいし"],["職","しょく"],["を"],["持って","もって"],["おられる"],["の"],["です"],["。"]]},{"verse":25,"text":"それでまた、この方は常に生きていて、人々のために執り成しておられるので、御自分を通して神に近づく人たちを、完全に救うことがおできになります。","tok":[["それ"],["で"],["また"],["、"],["この"],["方","かた"],["は"],["常","つね"],["に"],["生きて","いきて"],["いて"],["、"],["人々","ひとびと"],["の"],["ため"],["に"],["執り成して","とりなして"],["おられる"],["ので"],["、"],["御自分","ごじぶん"],["を"],["通して","とおして"],["神","かみ"],["に"],["近づく","ちかづく"],["人","ひと"],["たち"],["を"],["、"],["完全","かんぜん"],["に"],["救う","すくう"],["こと"],["が"],["おでき"],["に"],["なります"],["。"]]},{"verse":26,"text":"このように聖であり、罪なく、汚れなく、罪人から離され、もろもろの天よりも高くされている大祭司こそ、わたしたちにとって必要な方なのです。","tok":[["この"],["よう"],["に"],["聖","せい"],["で"],["あり"],["、"],["罪","つみ"],["なく"],["、"],["汚れ","よごれ"],["なく"],["、"],["罪人","ざいにん"],["から"],["離され","はなされ"],["、"],["もろもろ"],["の"],["天","てん"],["より"],["も"],["高く","たかく"],["されて"],["いる"],["大","だい"],["祭司","さいし"],["こそ"],["、"],["わたしたち"],["にとって"],["必要","ひつよう"],["な"],["方","ほう"],["な"],["の"],["です"],["。"]]},{"verse":27,"text":"この方は、ほかの大祭司たちのように、まず自分の罪のため、次に民の罪のために毎日いけにえを献げる必要はありません。というのは、このいけにえはただ一度、御自身を献げることによって、成し遂げられたからです。","tok":[["この"],["方","かた"],["は"],["、"],["ほか"],["の"],["大","だい"],["祭司","さいし"],["たち"],["の"],["よう"],["に"],["、"],["まず"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ため"],["、"],["次","つぎ"],["に"],["民","たみ"],["の"],["罪","つみ"],["の"],["ため"],["に"],["毎日","まいにち"],["いけにえ"],["を"],["献げる","ささげる"],["必要","ひつよう"],["は"],["ありません"],["。"],["と"],["いう"],["の"],["は"],["、"],["この"],["いけにえ"],["は"],["ただ"],["一度","いちど"],["、"],["御自身","ごじしん"],["を"],["献げる","ささげる"],["こと"],["によって"],["、"],["成し遂げられた","なしとげられた"],["から"],["です"],["。"]]},{"verse":28,"text":"律法は弱さを持った人間を大祭司に任命しますが、律法の後になされた誓いの御言葉は、永遠に完全な者とされておられる御子を大祭司としたのです。","tok":[["律法","りっぽう"],["は"],["弱","よわ"],["さ"],["を"],["持った","もった"],["人間","にんげん"],["を"],["大","だい"],["祭司","さいし"],["に"],["任命","にんめい"],["します"],["が"],["、"],["律法","りっぽう"],["の"],["後","あと"],["に"],["なされた"],["誓い","ちかい"],["の"],["御言葉","おことば"],["は"],["、"],["永遠","えいえん"],["に"],["完全","かんぜん"],["な"],["者","もの"],["と"],["されて"],["おられる"],["御子","みこ"],["を"],["大","だい"],["祭司","さいし"],["と"],["した"],["の"],["です"],["。"]]}]
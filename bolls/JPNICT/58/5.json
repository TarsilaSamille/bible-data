[{"verse":1,"text":"大祭司はすべて人間の中から選ばれ、罪のための供え物やいけにえを献げるよう、人々のために神に仕える職に任命されています。","tok":[["大","だい"],["祭司","さいし"],["は"],["すべて"],["人間","にんげん"],["の"],["中","なか"],["から"],["選ばれ","えらばれ"],["、"],["罪","つみ"],["の"],["ため"],["の"],["供え物","そなえもの"],["や"],["いけにえ"],["を"],["献げる","ささげる"],["よう"],["、"],["人々","ひとびと"],["の"],["ため"],["に"],["神","かみ"],["に"],["仕える","つかえる"],["職","しょく"],["に"],["任命","にんめい"],["されて"],["います"],["。"]]},{"verse":2,"text":"大祭司は、自分自身も弱さを身にまとっているので、無知な人、迷っている人を思いやることができるのです。","tok":[["大","だい"],["祭司","さいし"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["も"],["弱","よわ"],["さ"],["を"],["身","み"],["に"],["まとって"],["いる"],["ので"],["、"],["無知","むち"],["な"],["人","ひと"],["、"],["迷って","まよって"],["いる"],["人","ひと"],["を"],["思いやる","おもいやる"],["こと"],["が"],["できる"],["の"],["です"],["。"]]},{"verse":3,"text":"また、その弱さのゆえに、民のためだけでなく、自分自身のためにも、罪の贖いのために供え物を献げねばなりません。","tok":[["また"],["、"],["その"],["弱","よわ"],["さ"],["の"],["ゆえ"],["に"],["、"],["民","みん"],["の"],["ため"],["だけ"],["で"],["なく"],["、"],["自分","じぶん"],["自身","じしん"],["の"],["ため"],["に"],["も"],["、"],["罪","つみ"],["の"],["贖い","あがない"],["の"],["ため"],["に"],["供え物","そなえもの"],["を"],["献げねば","ささげねば"],["なりません"],["。"]]},{"verse":4,"text":"また、この光栄ある任務を、だれも自分で得るのではなく、アロンもそうであったように、神から召されて受けるのです。","tok":[["また"],["、"],["この"],["光栄","こうえい"],["ある"],["任務","にんむ"],["を"],["、"],["だれ"],["も"],["自分","じぶん"],["で"],["得る","える"],["ので"],["は"],["なく"],["、"],["アロン"],["も"],["そう"],["で"],["あった"],["よう"],["に"],["、"],["神","かみ"],["から"],["召されて","めされて"],["受ける","うける"],["の"],["です"],["。"]]},{"verse":5,"text":"同じようにキリストも、大祭司となる栄誉を御自分で得たのではなく、「あなたはわたしの子、わたしは今日、あなたを産んだ」と言われた方が、それをお与えになったのです。","tok":[["同じ","おなじ"],["よう"],["に"],["キリスト"],["も"],["、"],["大","だい"],["祭司","さいし"],["と"],["なる"],["栄誉","えいよ"],["を"],["御自分","ごじぶん"],["で"],["得た","えた"],["ので"],["は"],["なく"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["子","こ"],["、"],["わたし"],["は"],["今日","きょう"],["、"],["あなた"],["を"],["産んだ","うんだ"],["」"],["と"],["言われた","いわれた"],["方","ほう"],["が"],["、"],["それ"],["を"],["お与え","おあたえ"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":6,"text":"また、神は他の個所で、「あなたこそ永遠に、メルキゼデクと同じような祭司である」と言われています。","tok":[["また"],["、"],["神","かみ"],["は"],["他","た"],["の"],["個所","かしょ"],["で"],["、"],["「"],["あなた"],["こそ"],["永遠","えいえん"],["に"],["、"],["メルキゼデク"],["と"],["同じ","おなじ"],["よう"],["な"],["祭司","さいし"],["で"],["ある"],["」"],["と"],["言われて","いわれて"],["います"],["。"]]},{"verse":7,"text":"キリストは、肉において生きておられたとき、激しい叫び声をあげ、涙を流しながら、御自分を死から救う力のある方に、祈りと願いとをささげ、その畏れ敬う態度のゆえに聞き入れられました。","tok":[["キリスト"],["は"],["、"],["肉","にく"],["に"],["おいて"],["生きて","いきて"],["おられた"],["とき"],["、"],["激しい","はげしい"],["叫び声","さけびごえ"],["を"],["あげ"],["、"],["涙","なみだ"],["を"],["流し","ながし"],["ながら"],["、"],["御自分","ごじぶん"],["を"],["死","し"],["から"],["救う","すくう"],["力","ちから"],["の"],["ある"],["方","かた"],["に"],["、"],["祈り","いのり"],["と"],["願い","ねがい"],["と"],["を"],["ささげ"],["、"],["その"],["畏れ","おそれ"],["敬う","うやまう"],["態度","たいど"],["の"],["ゆえ"],["に"],["聞き入れられました","ききいれられました"],["。"]]},{"verse":8,"text":"キリストは御子であるにもかかわらず、多くの苦しみによって従順を学ばれました。","tok":[["キリスト"],["は"],["御子","みこ"],["で"],["ある"],["に"],["も"],["かかわらず"],["、"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["によって"],["従順","じゅうじゅん"],["を"],["学ばれました","まなばれました"],["。"]]},{"verse":9,"text":"そして、完全な者となられたので、御自分に従順であるすべての人々に対して、永遠の救いの源となり、","tok":[["そして"],["、"],["完全","かんぜん"],["な"],["者","もの"],["と"],["なられた"],["ので"],["、"],["御自分","ごじぶん"],["に"],["従順","じゅうじゅん"],["で"],["ある"],["すべて"],["の"],["人々","ひとびと"],["に対して","にたいして"],["、"],["永遠","えいえん"],["の"],["救い","すくい"],["の"],["源","みなもと"],["と"],["なり"],["、"]]},{"verse":10,"text":"神からメルキゼデクと同じような大祭司と呼ばれたのです。","tok":[["神","かみ"],["から"],["メルキゼデク"],["と"],["同じ","おなじ"],["よう"],["な"],["大","だい"],["祭司","さいし"],["と"],["呼ばれた","よばれた"],["の"],["です"],["。"]]},{"verse":11,"text":"このことについては、話すことがたくさんあるのですが、あなたがたの耳が鈍くなっているので、容易に説明できません。","tok":[["この"],["こと"],["について"],["は"],["、"],["話す","はなす"],["こと"],["が"],["たくさん"],["ある"],["の"],["です"],["が"],["、"],["あなた"],["がた"],["の"],["耳","みみ"],["が"],["鈍く","にぶく"],["なって"],["いる"],["ので"],["、"],["容易","ようい"],["に"],["説明","せつめい"],["できません"],["。"]]},{"verse":12,"text":"実際、あなたがたは今ではもう教師となっているはずなのに、再びだれかに神の言葉の初歩を教えてもらわねばならず、また、固い食物の代わりに、乳を必要とする始末だからです。","tok":[["実際","じっさい"],["、"],["あなた"],["がた"],["は"],["今","いま"],["で"],["は"],["もう"],["教師","きょうし"],["と"],["なって"],["いる"],["はず"],["な"],["のに"],["、"],["再び","ふたたび"],["だれ"],["か"],["に"],["神","かみ"],["の"],["言葉","ことば"],["の"],["初歩","しょほ"],["を"],["教えて","おしえて"],["もらわねば"],["ならず"],["、"],["また"],["、"],["固い","かたい"],["食物","しょくもつ"],["の"],["代わり","かわり"],["に"],["、"],["乳","ちち"],["を"],["必要","ひつよう"],["と"],["する"],["始末","しまつ"],["だ"],["から"],["です"],["。"]]},{"verse":13,"text":"乳を飲んでいる者はだれでも、幼子ですから、義の言葉を理解できません。","tok":[["乳","ちち"],["を"],["飲んで","のんで"],["いる"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["幼子","おさなご"],["です"],["から"],["、"],["義","ぎ"],["の"],["言葉","ことば"],["を"],["理解","りかい"],["できません"],["。"]]},{"verse":14,"text":"固い食物は、善悪を見分ける感覚を経験によって訓練された、一人前の大人のためのものです。","tok":[["固い","かたい"],["食物","しょくもつ"],["は"],["、"],["善悪","ぜんあく"],["を"],["見分ける","みわける"],["感覚","かんかく"],["を"],["経験","けいけん"],["によって"],["訓練","くんれん"],["された"],["、"],["一人前","いちにんまえ"],["の"],["大人","おとな"],["の"],["ため"],["の"],["もの"],["です"],["。"]]}]
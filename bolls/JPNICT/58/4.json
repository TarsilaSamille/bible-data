[{"verse":1,"text":"だから、神の安息にあずかる約束がまだ続いているのに、取り残されてしまったと思われる者があなたがたのうちから出ないように、気をつけましょう。","tok":[["だ"],["から"],["、"],["神","かみ"],["の"],["安息","あんそく"],["に"],["あずかる"],["約束","やくそく"],["が"],["まだ"],["続いて","つづいて"],["いる"],["のに"],["、"],["取り残されて","とりのこされて"],["しまった"],["と"],["思われる","おもわれる"],["者","もの"],["が"],["あなた"],["がた"],["の"],["うち"],["から"],["出ない","でない"],["よう"],["に"],["、"],["気","き"],["を"],["つけましょう"],["。"]]},{"verse":2,"text":"というのは、わたしたちにも彼ら同様に福音が告げ知らされているからです。けれども、彼らには聞いた言葉は役に立ちませんでした。その言葉が、それを聞いた人々と、信仰によって結び付かなかったためです。","tok":[["と"],["いう"],["の"],["は"],["、"],["わたしたち"],["に"],["も"],["彼","かれ"],["ら"],["同様","どうよう"],["に"],["福音","ふくいん"],["が"],["告げ知らされて","つげしらされて"],["いる"],["から"],["です"],["。"],["けれど"],["も"],["、"],["彼","かれ"],["ら"],["に"],["は"],["聞いた","きいた"],["言葉","ことば"],["は"],["役","やく"],["に"],["立ちませんでした","たちませんでした"],["。"],["その"],["言葉","ことば"],["が"],["、"],["それ"],["を"],["聞いた","きいた"],["人々","ひとびと"],["と"],["、"],["信仰","しんこう"],["によって"],["結び付かなかった","むすびつかなかった"],["ため"],["です"],["。"]]},{"verse":3,"text":"信じたわたしたちは、この安息にあずかることができるのです。「わたしは怒って誓ったように、『彼らを決してわたしの安息にあずからせはしない』」と言われたとおりです。もっとも、神の業は天地創造の時以来、既に出来上がっていたのです。","tok":[["信じた","しんじた"],["わたしたち"],["は"],["、"],["この"],["安息","あんそく"],["に"],["あずかる"],["こと"],["が"],["できる"],["の"],["です"],["。"],["「"],["わたし"],["は"],["怒って","おこって"],["誓った","ちかった"],["よう"],["に"],["、"],["『"],["彼","かれ"],["ら"],["を"],["決して","けっして"],["わたし"],["の"],["安息","あんそく"],["に"],["あずからせ"],["は"],["しない"],["』"],["」"],["と"],["言われた","いわれた"],["とおり"],["です"],["。"],["もっとも"],["、"],["神","かみ"],["の"],["業","ごう"],["は"],["天地","てんち"],["創造","そうぞう"],["の"],["時","とき"],["以来","いらい"],["、"],["既に","すでに"],["出来上がって","できあがって"],["いた"],["の"],["です"],["。"]]},{"verse":4,"text":"なぜなら、ある個所で七日目のことについて、「神は七日目にすべての業を終えて休まれた」と言われているからです。","tok":[["なぜ"],["なら"],["、"],["ある"],["個所","かしょ"],["で"],["七日目","ななかめ"],["の"],["こと"],["について"],["、"],["「"],["神","かみ"],["は"],["七日目","ななかめ"],["に"],["すべて"],["の"],["業","ごう"],["を"],["終えて","おえて"],["休まれた","やすまれた"],["」"],["と"],["言われて","いわれて"],["いる"],["から"],["です"],["。"]]},{"verse":5,"text":"そして、この個所でも改めて、「彼らを決してわたしの安息にあずからせはしない」と言われています。","tok":[["そして"],["、"],["この"],["個所","かしょ"],["で"],["も"],["改めて","あらためて"],["、"],["「"],["彼","かれ"],["ら"],["を"],["決して","けっして"],["わたし"],["の"],["安息","あんそく"],["に"],["あずからせ"],["は"],["しない"],["」"],["と"],["言われて","いわれて"],["います"],["。"]]},{"verse":6,"text":"そこで、この安息にあずかるはずの人々がまだ残っていることになり、また、先に福音を告げ知らされた人々が、不従順のためにあずからなかったのですから、","tok":[["そこ"],["で"],["、"],["この"],["安息","あんそく"],["に"],["あずかる"],["はず"],["の"],["人々","ひとびと"],["が"],["まだ"],["残って","のこって"],["いる"],["こと"],["に"],["なり"],["、"],["また"],["、"],["先","さき"],["に"],["福音","ふくいん"],["を"],["告げ知らされた","つげしらされた"],["人々","ひとびと"],["が"],["、"],["不","ふ"],["従順","じゅうじゅん"],["の"],["ため"],["に"],["あずからなかった"],["の"],["です"],["から"],["、"]]},{"verse":7,"text":"再び、神はある日を「今日」と決めて、かなりの時がたった後、既に引用したとおり、「今日、あなたたちが神の声を聞くなら、心をかたくなにしてはならない」とダビデを通して語られたのです。","tok":[["再び","ふたたび"],["、"],["神","かみ"],["は"],["ある"],["日","ひ"],["を"],["「"],["今日","きょう"],["」"],["と"],["決めて","きめて"],["、"],["かなり"],["の"],["時","とき"],["が"],["たった"],["後","あと"],["、"],["既に","すでに"],["引用","いんよう"],["した"],["とおり"],["、"],["「"],["今日","きょう"],["、"],["あなた"],["たち"],["が"],["神","かみ"],["の"],["声","こえ"],["を"],["聞くなら","きくなら"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["」"],["と"],["ダビデ"],["を"],["通して","とおして"],["語られた","かたられた"],["の"],["です"],["。"]]},{"verse":8,"text":"もしヨシュアが彼らに安息を与えたとするのなら、神は後になって他の日について語られることはなかったでしょう。","tok":[["もし"],["ヨシュア"],["が"],["彼","かれ"],["ら"],["に"],["安息","あんそく"],["を"],["与えた","あたえた"],["と"],["する"],["の"],["なら"],["、"],["神","かみ"],["は"],["後","あと"],["に"],["なって"],["他","ほか"],["の"],["日","ひ"],["について"],["語られる","かたられる"],["こと"],["は"],["なかったでしょう"],["。"]]},{"verse":9,"text":"それで、安息日の休みが神の民に残されているのです。","tok":[["それ"],["で"],["、"],["安息日","あんそくび"],["の"],["休み","やすみ"],["が"],["神","かみ"],["の"],["民","たみ"],["に"],["残されて","のこされて"],["いる"],["の"],["です"],["。"]]},{"verse":10,"text":"なぜなら、神の安息にあずかった者は、神が御業を終えて休まれたように、自分の業を終えて休んだからです。","tok":[["なぜ"],["なら"],["、"],["神","かみ"],["の"],["安息","あんそく"],["に"],["あずかった"],["者","もの"],["は"],["、"],["神","かみ"],["が"],["御業","ごごう"],["を"],["終えて","おえて"],["休まれた","やすまれた"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["業","ごう"],["を"],["終えて","おえて"],["休んだ","やすんだ"],["から"],["です"],["。"]]},{"verse":11,"text":"だから、わたしたちはこの安息にあずかるように努力しようではありませんか。さもないと、同じ不従順の例に倣って堕落する者が出るかもしれません。","tok":[["だ"],["から"],["、"],["わたしたち"],["は"],["この"],["安息","あんそく"],["に"],["あずかる"],["よう"],["に"],["努力","どりょく"],["しようで"],["は"],["ありません"],["か"],["。"],["さも"],["ない"],["と"],["、"],["同じ","おなじ"],["不","ふ"],["従順","じゅうじゅん"],["の"],["例","れい"],["に"],["倣って","ならって"],["堕落","だらく"],["する"],["者","もの"],["が"],["出る","でる"],["か"],["も"],["しれません"],["。"]]},{"verse":12,"text":"というのは、神の言葉は生きており、力を発揮し、どんな両刃の剣よりも鋭く、精神と霊、関節と骨髄とを切り離すほどに刺し通して、心の思いや考えを見分けることができるからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["神","かみ"],["の"],["言葉","ことば"],["は"],["生きて","いきて"],["おり"],["、"],["力","ちから"],["を"],["発揮","はっき"],["し"],["、"],["どんな"],["両刃","りょうば"],["の"],["剣","けん"],["より"],["も"],["鋭く","するどく"],["、"],["精神","せいしん"],["と"],["霊","れい"],["、"],["関節","かんせつ"],["と"],["骨髄","こつずい"],["と"],["を"],["切り離す","きりはなす"],["ほど"],["に"],["刺し通して","さしとおして"],["、"],["心","こころ"],["の"],["思い","おもい"],["や"],["考え","かんがえ"],["を"],["見分ける","みわける"],["こと"],["が"],["できる"],["から"],["です"],["。"]]},{"verse":13,"text":"更に、神の御前では隠れた被造物は一つもなく、すべてのものが神の目には裸であり、さらけ出されているのです。この神に対して、わたしたちは自分のことを申し述べねばなりません。","tok":[["更に","さらに"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["は"],["隠れた","かくれた"],["被","ひ"],["造物","ぞうぶつ"],["は"],["一","ひと"],["つ"],["も"],["なく"],["、"],["すべて"],["の"],["もの"],["が"],["神","かみ"],["の"],["目","め"],["に"],["は"],["裸","はだか"],["で"],["あり"],["、"],["さらけ出されて","さらけだされて"],["いる"],["の"],["です"],["。"],["この"],["神","かみ"],["に対して","にたいして"],["、"],["わたしたち"],["は"],["自分","じぶん"],["の"],["こと"],["を"],["申し述べねば","もうしのべねば"],["なりません"],["。"]]},{"verse":14,"text":"さて、わたしたちには、もろもろの天を通過された偉大な大祭司、神の子イエスが与えられているのですから、わたしたちの公に言い表している信仰をしっかり保とうではありませんか。","tok":[["さて"],["、"],["わたしたち"],["に"],["は"],["、"],["もろもろ"],["の"],["天","てん"],["を"],["通過","つうか"],["された"],["偉大","いだい"],["な"],["大","だい"],["祭司","さいし"],["、"],["神","かみ"],["の"],["子","こ"],["イエス"],["が"],["与えられて","あたえられて"],["いる"],["の"],["です"],["から"],["、"],["わたしたち"],["の"],["公","おおやけ"],["に"],["言い表して","いいあらわして"],["いる"],["信仰","しんこう"],["を"],["しっかり"],["保とうで","たもとうで"],["は"],["ありません"],["か"],["。"]]},{"verse":15,"text":"この大祭司は、わたしたちの弱さに同情できない方ではなく、罪を犯されなかったが、あらゆる点において、わたしたちと同様に試練に遭われたのです。","tok":[["この"],["大","だい"],["祭司","さいし"],["は"],["、"],["わたしたち"],["の"],["弱","よわ"],["さ"],["に"],["同情","どうじょう"],["できない"],["方","ほう"],["で"],["は"],["なく"],["、"],["罪","つみ"],["を"],["犯されなかった","おかされなかった"],["が"],["、"],["あらゆる"],["点","てん"],["に"],["おいて"],["、"],["わたしたち"],["と"],["同様","どうよう"],["に"],["試練","しれん"],["に"],["遭われた","あわれた"],["の"],["です"],["。"]]},{"verse":16,"text":"だから、憐れみを受け、恵みにあずかって、時宜にかなった助けをいただくために、大胆に恵みの座に近づこうではありませんか。","tok":[["だ"],["から"],["、"],["憐れみ","あわれみ"],["を"],["受け","うけ"],["、"],["恵み","めぐみ"],["に"],["あずかって"],["、"],["時宜","じぎ"],["に"],["かなった"],["助け","たすけ"],["を"],["いただく"],["ため"],["に"],["、"],["大胆","だいたん"],["に"],["恵み","めぐみ"],["の"],["座","ざ"],["に"],["近づこうで","ちかづこうで"],["は"],["ありません"],["か"],["。"]]}]
[{"verse":1,"text":"今述べていることの要点は、わたしたちにはこのような大祭司が与えられていて、天におられる大いなる方の玉座の右の座に着き、","tok":[["今","いま"],["述べて","のべて"],["いる"],["こと"],["の"],["要点","ようてん"],["は"],["、"],["わたしたち"],["に"],["は"],["この"],["よう"],["な"],["大","だい"],["祭司","さいし"],["が"],["与えられて","あたえられて"],["いて"],["、"],["天","てん"],["に"],["おられる"],["大いなる","おおいなる"],["方","かた"],["の"],["玉座","ぎょくざ"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着き","つき"],["、"]]},{"verse":2,"text":"人間ではなく主がお建てになった聖所また真の幕屋で、仕えておられるということです。","tok":[["人間","にんげん"],["で"],["は"],["なく"],["主","ぬし"],["が"],["お建て","おたて"],["に"],["なった"],["聖所","しょうしょ"],["また"],["真","しん"],["の"],["幕屋","まくや"],["で"],["、"],["仕えて","つかえて"],["おられる"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":3,"text":"すべて大祭司は、供え物といけにえとを献げるために、任命されています。それで、この方も、何か献げる物を持っておられなければなりません。","tok":[["すべて"],["大","だい"],["祭司","さいし"],["は"],["、"],["供え物","そなえもの"],["と"],["いけにえ"],["と"],["を"],["献げる","ささげる"],["ため"],["に"],["、"],["任命","にんめい"],["されて"],["います"],["。"],["それ"],["で"],["、"],["この"],["方","かた"],["も"],["、"],["何","なん"],["か"],["献げる","ささげる"],["物","もの"],["を"],["持って","もって"],["おられなければ"],["なりません"],["。"]]},{"verse":4,"text":"もし、地上におられるのだとすれば、律法に従って供え物を献げる祭司たちが現にいる以上、この方は決して祭司ではありえなかったでしょう。","tok":[["もし"],["、"],["地上","ちじょう"],["に"],["おられる"],["の"],["だ"],["と"],["すれば"],["、"],["律法","りっぽう"],["に"],["従って","したがって"],["供え物","そなえもの"],["を"],["献げる","ささげる"],["祭司","さいし"],["たち"],["が"],["現に","げんに"],["いる"],["以上","いじょう"],["、"],["この"],["方","かた"],["は"],["決して","けっして"],["祭司","さいし"],["で"],["は"],["あり"],["えなかったでしょう"],["。"]]},{"verse":5,"text":"この祭司たちは、天にあるものの写しであり影であるものに仕えており、そのことは、モーセが幕屋を建てようとしたときに、お告げを受けたとおりです。神は、「見よ、山で示された型どおりに、すべてのものを作れ」と言われたのです。","tok":[["この"],["祭司","さいし"],["たち"],["は"],["、"],["天","てん"],["に"],["ある"],["もの"],["の"],["写し","うつし"],["で"],["あり"],["影","かげ"],["で"],["ある"],["もの"],["に"],["仕えて","つかえて"],["おり"],["、"],["その"],["こと"],["は"],["、"],["モーセ"],["が"],["幕屋","まくや"],["を"],["建てよう","たてよう"],["と"],["した"],["とき"],["に"],["、"],["お告げ","おつげ"],["を"],["受けた","うけた"],["とおり"],["です"],["。"],["神","かみ"],["は"],["、"],["「"],["見よ","みよ"],["、"],["山","やま"],["で"],["示された","しめされた"],["型どおり","かたどおり"],["に"],["、"],["すべて"],["の"],["もの"],["を"],["作れ","つくれ"],["」"],["と"],["言われた","いわれた"],["の"],["です"],["。"]]},{"verse":6,"text":"しかし、今、わたしたちの大祭司は、それよりはるかに優れた務めを得ておられます。更にまさった約束に基づいて制定された、更にまさった契約の仲介者になられたからです。","tok":[["しかし"],["、"],["今","いま"],["、"],["わたしたち"],["の"],["大","だい"],["祭司","さいし"],["は"],["、"],["それ"],["より"],["はるか"],["に"],["優れた","すぐれた"],["務め","つとめ"],["を"],["得て","えて"],["おられます"],["。"],["更に","さらに"],["まさった"],["約束","やくそく"],["に"],["基づいて","もとづいて"],["制定","せいてい"],["された"],["、"],["更に","さらに"],["まさった"],["契約","けいやく"],["の"],["仲介者","ちゅうかいしゃ"],["に"],["なられた"],["から"],["です"],["。"]]},{"verse":7,"text":"もし、あの最初の契約が欠けたところのないものであったなら、第二の契約の余地はなかったでしょう。","tok":[["もし"],["、"],["あの"],["最初","さいしょ"],["の"],["契約","けいやく"],["が"],["欠けた","かけた"],["ところ"],["の"],["ない"],["もの"],["で"],["あったなら"],["、"],["第","だい"],["二","に"],["の"],["契約","けいやく"],["の"],["余地","よち"],["は"],["なかったでしょう"],["。"]]},{"verse":8,"text":"事実、神はイスラエルの人々を非難して次のように言われています。「『見よ、わたしがイスラエルの家、またユダの家と、新しい契約を結ぶ時が来る』と、主は言われる。","tok":[["事実","じじつ"],["、"],["神","かみ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["非難","ひなん"],["して"],["次","つぎ"],["の"],["よう"],["に"],["言われて","いわれて"],["います"],["。"],["「"],["『"],["見よ","みよ"],["、"],["わたし"],["が"],["イスラエル"],["の"],["家","いえ"],["、"],["また"],["ユダ"],["の"],["家","いえ"],["と"],["、"],["新しい","あたらしい"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["時","とき"],["が"],["来る","くる"],["』"],["と"],["、"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"『それは、わたしが彼らの先祖の手を取って、エジプトの地から導き出した日に、彼らと結んだ契約のようなものではない。彼らはわたしの契約に忠実でなかったので、わたしも彼らを顧みなかった』と、主は言われる。","tok":[["『"],["それ"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["の"],["手","て"],["を"],["取って","とって"],["、"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["日","ひ"],["に"],["、"],["彼","かれ"],["ら"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["の"],["よう"],["な"],["もの"],["で"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["契約","けいやく"],["に"],["忠実","ちゅうじつ"],["で"],["なかった"],["ので"],["、"],["わたし"],["も"],["彼","かれ"],["ら"],["を"],["顧みなかった","かえりみなかった"],["』"],["と"],["、"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"『それらの日の後、わたしがイスラエルの家と結ぶ契約はこれである』と、主は言われる。『すなわち、わたしの律法を彼らの思いに置き、彼らの心にそれを書きつけよう。わたしは彼らの神となり、彼らはわたしの民となる。","tok":[["『"],["それ"],["ら"],["の"],["日","ひ"],["の"],["後","あと"],["、"],["わたし"],["が"],["イスラエル"],["の"],["家","いえ"],["と"],["結ぶ","むすぶ"],["契約","けいやく"],["は"],["これ"],["で"],["ある"],["』"],["と"],["、"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["『"],["すなわち"],["、"],["わたし"],["の"],["律法","りっぽう"],["を"],["彼","かれ"],["ら"],["の"],["思い","おもい"],["に"],["置き","おき"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["に"],["それ"],["を"],["書きつけよう","かきつけよう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なる"],["。"]]},{"verse":11,"text":"彼らはそれぞれ自分の同胞に、それぞれ自分の兄弟に、「主を知れ」と言って教える必要はなくなる。小さな者から大きな者に至るまで彼らはすべて、わたしを知るようになり、","tok":[["彼","かれ"],["ら"],["は"],["それぞれ"],["自分","じぶん"],["の"],["同胞","どうほう"],["に"],["、"],["それぞれ"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["に"],["、"],["「"],["主","ぬし"],["を"],["知れ","しれ"],["」"],["と"],["言って","いって"],["教える","おしえる"],["必要","ひつよう"],["は"],["なくなる"],["。"],["小さな","ちいさな"],["者","もの"],["から"],["大きな","おおきな"],["者","もの"],["に"],["至る","いたる"],["まで"],["彼","かれ"],["ら"],["は"],["すべて"],["、"],["わたし"],["を"],["知る","しる"],["よう"],["に"],["なり"],["、"]]},{"verse":12,"text":"わたしは、彼らの不義を赦し、もはや彼らの罪を思い出しはしないからである。』」","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["不義","ふぎ"],["を"],["赦し","ゆるし"],["、"],["もはや"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["思い出し","おもいだし"],["は"],["しない"],["から"],["で"],["ある"],["。"],["』"],["」"]]},{"verse":13,"text":"神は「新しいもの」と言われることによって、最初の契約は古びてしまったと宣言されたのです。年を経て古びたものは、間もなく消えうせます。","tok":[["神","かみ"],["は"],["「"],["新しい","あたらしい"],["もの"],["」"],["と"],["言われる","いわれる"],["こと"],["によって"],["、"],["最初","さいしょ"],["の"],["契約","けいやく"],["は"],["古びて","ふるびて"],["しまった"],["と"],["宣言","せんげん"],["された"],["の"],["です"],["。"],["年","ねん"],["を"],["経て","へて"],["古びた","ふるびた"],["もの"],["は"],["、"],["間","ま"],["も"],["なく"],["消えうせます","きえうせます"],["。"]]}]
[{"verse":1,"text":"こういうわけで、わたしたちもまた、このようにおびただしい証人の群れに囲まれている以上、すべての重荷や絡みつく罪をかなぐり捨てて、自分に定められている競走を忍耐強く走り抜こうではありませんか、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["わたしたち"],["も"],["また"],["、"],["この"],["よう"],["に"],["おびただしい"],["証人","しょうにん"],["の"],["群れ","むれ"],["に"],["囲まれて","かこまれて"],["いる"],["以上","いじょう"],["、"],["すべて"],["の"],["重荷","おもに"],["や"],["絡みつく","からみつく"],["罪","つみ"],["を"],["かなぐり捨てて","かなぐりすてて"],["、"],["自分","じぶん"],["に"],["定められて","さだめられて"],["いる"],["競走","きょうそう"],["を"],["忍耐","にんたい"],["強く","つよく"],["走り","はしり"],["抜こうで","ぬこうで"],["は"],["ありません"],["か"],["、"]]},{"verse":2,"text":"信仰の創始者また完成者であるイエスを見つめながら。このイエスは、御自身の前にある喜びを捨て、恥をもいとわないで十字架の死を耐え忍び、神の玉座の右にお座りになったのです。","tok":[["信仰","しんこう"],["の"],["創始者","そうししゃ"],["また"],["完成者","かんせいしゃ"],["で"],["ある"],["イエス"],["を"],["見つめ","みつめ"],["ながら"],["。"],["この"],["イエス"],["は"],["、"],["御自身","ごじしん"],["の"],["前","まえ"],["に"],["ある"],["喜び","よろこび"],["を"],["捨て","すて"],["、"],["恥","はじ"],["を"],["も"],["いとわないで"],["十字架","じゅうじか"],["の"],["死","し"],["を"],["耐え忍び","たえしのび"],["、"],["神","かみ"],["の"],["玉座","ぎょくざ"],["の"],["右","みぎ"],["に"],["お座り","おすわり"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":3,"text":"あなたがたが、気力を失い疲れ果ててしまわないように、御自分に対する罪人たちのこのような反抗を忍耐された方のことを、よく考えなさい。","tok":[["あなた"],["が"],["た"],["が"],["、"],["気力","きりょく"],["を"],["失い","うしない"],["疲れ","つかれ"],["果てて","はてて"],["しまわない"],["よう"],["に"],["、"],["御自分","ごじぶん"],["に"],["対する","たいする"],["罪人","ざいにん"],["たち"],["の"],["この"],["よう"],["な"],["反抗","はんこう"],["を"],["忍耐","にんたい"],["された"],["方","ほう"],["の"],["こと"],["を"],["、"],["よく"],["考え","かんがえ"],["なさい"],["。"]]},{"verse":4,"text":"あなたがたはまだ、罪と戦って血を流すまで抵抗したことがありません。","tok":[["あなた"],["がた"],["は"],["まだ"],["、"],["罪","つみ"],["と"],["戦って","たたかって"],["血","ち"],["を"],["流す","ながす"],["まで"],["抵抗","ていこう"],["した"],["こと"],["が"],["ありません"],["。"]]},{"verse":5,"text":"また、子供たちに対するようにあなたがたに話されている次の勧告を忘れています。「わが子よ、主の鍛錬を軽んじてはいけない。主から懲らしめられても、力を落としてはいけない。","tok":[["また"],["、"],["子供","こども"],["たち"],["に"],["対する","たいする"],["よう"],["に"],["あなた"],["がた"],["に"],["話されて","はなされて"],["いる"],["次","つぎ"],["の"],["勧告","かんこく"],["を"],["忘れて","わすれて"],["います"],["。"],["「"],["わが"],["子","こ"],["よ"],["、"],["主","ぬし"],["の"],["鍛錬","たんれん"],["を"],["軽んじて","かろんじて"],["は"],["いけない"],["。"],["主","ぬし"],["から"],["懲らしめられて","こらしめられて"],["も"],["、"],["力","ちから"],["を"],["落として","おとして"],["は"],["いけない"],["。"]]},{"verse":6,"text":"なぜなら、主は愛する者を鍛え、子として受け入れる者を皆、鞭打たれるからである。」","tok":[["なぜ"],["なら"],["、"],["主","ぬし"],["は"],["愛する","あいする"],["者","もの"],["を"],["鍛え","きたえ"],["、"],["子","こ"],["として"],["受け入れる","うけいれる"],["者","もの"],["を"],["皆","みな"],["、"],["鞭打たれる","むちうたれる"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":7,"text":"あなたがたは、これを鍛錬として忍耐しなさい。神は、あなたがたを子として取り扱っておられます。いったい、父から鍛えられない子があるでしょうか。","tok":[["あなた"],["がた"],["は"],["、"],["これ"],["を"],["鍛錬","たんれん"],["として"],["忍耐","にんたい"],["し"],["なさい"],["。"],["神","かみ"],["は"],["、"],["あなた"],["がた"],["を"],["子","こ"],["として"],["取り扱って","とりあつかって"],["おられます"],["。"],["いったい"],["、"],["父","ちち"],["から"],["鍛えられない","きたえられない"],["子","こ"],["が"],["あるでしょう"],["か"],["。"]]},{"verse":8,"text":"もしだれもが受ける鍛錬を受けていないとすれば、それこそ、あなたがたは庶子であって、実の子ではありません。","tok":[["もし"],["だれ"],["も"],["が"],["受ける","うける"],["鍛錬","たんれん"],["を"],["受けて","うけて"],["いない"],["と"],["すれば"],["、"],["それ"],["こそ"],["、"],["あなた"],["がた"],["は"],["庶子","しょし"],["で"],["あって"],["、"],["実","じつ"],["の"],["子","こ"],["で"],["は"],["ありません"],["。"]]},{"verse":9,"text":"更にまた、わたしたちには、鍛えてくれる肉の父があり、その父を尊敬していました。それなら、なおさら、霊の父に服従して生きるのが当然ではないでしょうか。","tok":[["更に","さらに"],["また"],["、"],["わたしたち"],["に"],["は"],["、"],["鍛えて","きたえて"],["くれる"],["肉","にく"],["の"],["父","ちち"],["が"],["あり"],["、"],["その"],["父","ちち"],["を"],["尊敬","そんけい"],["して"],["いました"],["。"],["それ"],["なら"],["、"],["なおさら"],["、"],["霊","れい"],["の"],["父","ちち"],["に"],["服従","ふくじゅう"],["して"],["生きる","いきる"],["の"],["が"],["当然","とうぜん"],["で"],["は"],["ないでしょう"],["か"],["。"]]},{"verse":10,"text":"肉の父はしばらくの間、自分の思うままに鍛えてくれましたが、霊の父はわたしたちの益となるように、御自分の神聖にあずからせる目的でわたしたちを鍛えられるのです。","tok":[["肉","にく"],["の"],["父","ちち"],["は"],["しばらく"],["の"],["間","あいだ"],["、"],["自分","じぶん"],["の"],["思う","おもう"],["まま"],["に"],["鍛えて","きたえて"],["くれました"],["が"],["、"],["霊","れい"],["の"],["父","ちち"],["は"],["わたしたち"],["の"],["益","えき"],["と"],["なる"],["よう"],["に"],["、"],["御自分","ごじぶん"],["の"],["神聖","しんせい"],["に"],["あずからせる"],["目的","もくてき"],["で"],["わたしたち"],["を"],["鍛えられる","きたえられる"],["の"],["です"],["。"]]},{"verse":11,"text":"およそ鍛錬というものは、当座は喜ばしいものではなく、悲しいものと思われるのですが、後になるとそれで鍛え上げられた人々に、義という平和に満ちた実を結ばせるのです。","tok":[["およそ"],["鍛錬","たんれん"],["と"],["いう"],["もの"],["は"],["、"],["当座","とうざ"],["は"],["喜ばしい","よろこばしい"],["もの"],["で"],["は"],["なく"],["、"],["悲しい","かなしい"],["もの"],["と"],["思われる","おもわれる"],["の"],["です"],["が"],["、"],["後","あと"],["に"],["なる"],["と"],["それ"],["で"],["鍛え上げられた","きたえあげられた"],["人々","ひとびと"],["に"],["、"],["義","ぎ"],["と"],["いう"],["平和","へいわ"],["に"],["満ちた","みちた"],["実","じつ"],["を"],["結ばせる","むすばせる"],["の"],["です"],["。"]]},{"verse":12,"text":"だから、萎えた手と弱くなったひざをまっすぐにしなさい。","tok":[["だ"],["から"],["、"],["萎えた","なえた"],["手","て"],["と"],["弱く","よわく"],["なった"],["ひざ"],["を"],["まっすぐ"],["に"],["し"],["なさい"],["。"]]},{"verse":13,"text":"また、足の不自由な人が踏み外すことなく、むしろいやされるように、自分の足でまっすぐな道を歩きなさい。","tok":[["また"],["、"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["が"],["踏み外す","ふみはずす"],["こと"],["なく"],["、"],["むしろ"],["いやされる"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["足","あし"],["で"],["まっすぐ"],["な"],["道","みち"],["を"],["歩き","あるき"],["なさい"],["。"]]},{"verse":14,"text":"すべての人との平和を、また聖なる生活を追い求めなさい。聖なる生活を抜きにして、だれも主を見ることはできません。","tok":[["すべて"],["の"],["人","ひと"],["と"],["の"],["平和","へいわ"],["を"],["、"],["また"],["聖","せい"],["なる"],["生活","せいかつ"],["を"],["追い求め","おいもとめ"],["なさい"],["。"],["聖","せい"],["なる"],["生活","せいかつ"],["を"],["抜き","ぬき"],["に"],["して"],["、"],["だれ"],["も"],["主","ぬし"],["を"],["見る","みる"],["こと"],["は"],["できません"],["。"]]},{"verse":15,"text":"神の恵みから除かれることのないように、また、苦い根が現れてあなたがたを悩まし、それによって多くの人が汚れることのないように、気をつけなさい。","tok":[["神","かみ"],["の"],["恵み","めぐみ"],["から"],["除かれる","のぞかれる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["また"],["、"],["苦い","にがい"],["根","ね"],["が"],["現れて","あらわれて"],["あなた"],["がた"],["を"],["悩まし","なやまし"],["、"],["それ"],["によって"],["多く","おおく"],["の"],["人","ひと"],["が"],["汚れる","よごれる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":16,"text":"また、だれであれ、ただ一杯の食物のために長子の権利を譲り渡したエサウのように、みだらな者や俗悪な者とならないよう気をつけるべきです。","tok":[["また"],["、"],["だれ"],["で"],["あれ"],["、"],["ただ"],["一杯","いっぱい"],["の"],["食物","しょくもつ"],["の"],["ため"],["に"],["長子","ちょうし"],["の"],["権利","けんり"],["を"],["譲り渡した","ゆずりわたした"],["エサウ"],["の"],["よう"],["に"],["、"],["みだら"],["な"],["者","もの"],["や"],["俗悪","ぞくあく"],["な"],["者","もの"],["と"],["ならない"],["よう"],["気","き"],["を"],["つけるべきです"],["。"]]},{"verse":17,"text":"あなたがたも知っているとおり、エサウは後になって祝福を受け継ぎたいと願ったが、拒絶されたからです。涙を流して求めたけれども、事態を変えてもらうことができなかったのです。","tok":[["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["エサウ"],["は"],["後","あと"],["に"],["なって"],["祝福","しゅくふく"],["を"],["受け継ぎたい","うけつぎたい"],["と"],["願った","ねがった"],["が"],["、"],["拒絶","きょぜつ"],["された"],["から"],["です"],["。"],["涙","なみだ"],["を"],["流して","ながして"],["求めた","もとめた"],["けれど"],["も"],["、"],["事態","じたい"],["を"],["変えて","かえて"],["もらう"],["こと"],["が"],["できなかった"],["の"],["です"],["。"]]},{"verse":18,"text":"あなたがたは手で触れることができるものや、燃える火、黒雲、暗闇、暴風、ラッパの音、更に、聞いた人々がこれ以上語ってもらいたくないと願ったような言葉の声に、近づいたのではありません。","tok":[["あなた"],["がた"],["は"],["手","て"],["で"],["触れる","ふれる"],["こと"],["が"],["できる"],["もの"],["や"],["、"],["燃える","もえる"],["火","ひ"],["、"],["黒雲","くろくも"],["、"],["暗闇","くらやみ"],["、"],["暴風","ぼうふう"],["、"],["ラッパ"],["の"],["音","おと"],["、"],["更に","さらに"],["、"],["聞いた","きいた"],["人々","ひとびと"],["が"],["これ"],["以上","いじょう"],["語って","かたって"],["もらいたく"],["ない"],["と"],["願った","ねがった"],["よう"],["な"],["言葉","ことば"],["の"],["声","こえ"],["に"],["、"],["近づいた","ちかづいた"],["ので"],["は"],["ありません"],["。"]]},{"verse":20,"text":"彼らは、「たとえ獣でも、山に触れれば、石を投げつけて殺さなければならない」という命令に耐えられなかったのです。","tok":[["彼","かれ"],["ら"],["は"],["、"],["「"],["たとえ"],["獣","けもの"],["で"],["も"],["、"],["山","やま"],["に"],["触れれば","ふれれば"],["、"],["石","いし"],["を"],["投げつけて","なげつけて"],["殺さなければ","ころさなければ"],["ならない"],["」"],["と"],["いう"],["命令","めいれい"],["に"],["耐えられなかった","たえられなかった"],["の"],["です"],["。"]]},{"verse":21,"text":"また、その様子があまりにも恐ろしいものだったので、モーセすら、「わたしはおびえ、震えている」と言ったほどです。","tok":[["また"],["、"],["その"],["様子","ようす"],["が"],["あまり"],["に"],["も"],["恐ろしい","おそろしい"],["もの"],["だった"],["ので"],["、"],["モーセ"],["すら"],["、"],["「"],["わたし"],["は"],["おびえ"],["、"],["震えて","ふるえて"],["いる"],["」"],["と"],["言った","いった"],["ほど"],["です"],["。"]]},{"verse":22,"text":"しかし、あなたがたが近づいたのは、シオンの山、生ける神の都、天のエルサレム、無数の天使たちの祝いの集まり、","tok":[["しかし"],["、"],["あなた"],["がた"],["が"],["近づいた","ちかづいた"],["の"],["は"],["、"],["シオン"],["の"],["山","やま"],["、"],["生ける","いける"],["神","かみ"],["の"],["都","と"],["、"],["天","てん"],["の"],["エルサレム"],["、"],["無数","むすう"],["の"],["天使","てんし"],["たち"],["の"],["祝い","いわい"],["の"],["集まり","あつまり"],["、"]]},{"verse":23,"text":"天に登録されている長子たちの集会、すべての人の審判者である神、完全なものとされた正しい人たちの霊、","tok":[["天","てん"],["に"],["登録","とうろく"],["されて"],["いる"],["長子","ちょうし"],["たち"],["の"],["集会","しゅうかい"],["、"],["すべて"],["の"],["人","ひと"],["の"],["審判者","しんぱんしゃ"],["で"],["ある"],["神","かみ"],["、"],["完全","かんぜん"],["な"],["もの"],["と"],["された"],["正しい","ただしい"],["人","ひと"],["たち"],["の"],["霊","れい"],["、"]]},{"verse":24,"text":"新しい契約の仲介者イエス、そして、アベルの血よりも立派に語る注がれた血です。","tok":[["新しい","あたらしい"],["契約","けいやく"],["の"],["仲介者","ちゅうかいしゃ"],["イエス"],["、"],["そして"],["、"],["アベル"],["の"],["血","ち"],["より"],["も"],["立派","りっぱ"],["に"],["語る","かたる"],["注がれた","そそがれた"],["血","ち"],["です"],["。"]]},{"verse":25,"text":"あなたがたは、語っている方を拒むことのないように気をつけなさい。もし、地上で神の御旨を告げる人を拒む者たちが、罰を逃れられなかったとするなら、天から御旨を告げる方に背を向けるわたしたちは、なおさらそうではありませんか。","tok":[["あなた"],["がた"],["は"],["、"],["語って","かたって"],["いる"],["方","かた"],["を"],["拒む","こばむ"],["こと"],["の"],["ない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["もし"],["、"],["地上","ちじょう"],["で"],["神","かみ"],["の"],["御旨","おむね"],["を"],["告げる","つげる"],["人","ひと"],["を"],["拒む","こばむ"],["者","もの"],["たち"],["が"],["、"],["罰","ばつ"],["を"],["逃れられなかった","のがれられなかった"],["と"],["するなら"],["、"],["天","てん"],["から"],["御旨","おむね"],["を"],["告げる","つげる"],["方","かた"],["に"],["背","せ"],["を"],["向ける","むける"],["わたしたち"],["は"],["、"],["なおさら"],["そう"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":26,"text":"あのときは、その御声が地を揺り動かしましたが、今は次のように約束しておられます。「わたしはもう一度、地だけではなく天をも揺り動かそう。」","tok":[["あの"],["とき"],["は"],["、"],["その"],["御声","おこえ"],["が"],["地","ち"],["を"],["揺り動かしました","ゆりうごかしました"],["が"],["、"],["今","いま"],["は"],["次","つぎ"],["の"],["よう"],["に"],["約束","やくそく"],["して"],["おられます"],["。"],["「"],["わたし"],["は"],["もう"],["一度","いちど"],["、"],["地","ち"],["だけ"],["で"],["は"],["なく"],["天","てん"],["を"],["も"],["揺り動かそう","ゆりうごかそう"],["。"],["」"]]},{"verse":27,"text":"この「もう一度」は、揺り動かされないものが存続するために、揺り動かされるものが、造られたものとして取り除かれることを示しています。","tok":[["この"],["「"],["もう"],["一度","いちど"],["」"],["は"],["、"],["揺り動かされない","ゆりうごかされない"],["もの"],["が"],["存続","そんぞく"],["する"],["ため"],["に"],["、"],["揺り動かされる","ゆりうごかされる"],["もの"],["が"],["、"],["造られた","つくられた"],["もの"],["として"],["取り除かれる","とりのぞかれる"],["こと"],["を"],["示して","しめして"],["います"],["。"]]},{"verse":28,"text":"このように、わたしたちは揺り動かされることのない御国を受けているのですから、感謝しよう。感謝の念をもって、畏れ敬いながら、神に喜ばれるように仕えていこう。","tok":[["この"],["よう"],["に"],["、"],["わたしたち"],["は"],["揺り動かされる","ゆりうごかされる"],["こと"],["の"],["ない"],["御国","みくに"],["を"],["受けて","うけて"],["いる"],["の"],["です"],["から"],["、"],["感謝","かんしゃ"],["しよう"],["。"],["感謝","かんしゃ"],["の"],["念","ねん"],["を"],["もって"],["、"],["畏れ","おそれ"],["敬い","うやまい"],["ながら"],["、"],["神","かみ"],["に"],["喜ばれる","よろこばれる"],["よう"],["に"],["仕えて","つかえて"],["いこう"],["。"]]},{"verse":29,"text":"実に、わたしたちの神は、焼き尽くす火です。","tok":[["実","じつ"],["に"],["、"],["わたしたち"],["の"],["神","かみ"],["は"],["、"],["焼き","やき"],["尽くす","つくす"],["火","ひ"],["です"],["。"]]}]
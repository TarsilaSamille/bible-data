[{"verse":1,"text":"だからわたしたちは、死んだ行いの悔い改め、神への信仰、種々の洗礼についての教え、手を置く儀式、死者の復活、永遠の審判などの基本的な教えを学び直すようなことはせず、キリストの教えの初歩を離れて、成熟を目指して進みましょう。","tok":[["だ"],["から"],["わたしたち"],["は"],["、"],["死んだ","しんだ"],["行い","おこない"],["の"],["悔い改め","くいあらため"],["、"],["神","かみ"],["へ"],["の"],["信仰","しんこう"],["、"],["種々","しゅじゅ"],["の"],["洗礼","せんれい"],["について"],["の"],["教え","おしえ"],["、"],["手","て"],["を"],["置く","おく"],["儀式","ぎしき"],["、"],["死者","ししゃ"],["の"],["復活","ふっかつ"],["、"],["永遠","えいえん"],["の"],["審判","しんぱん"],["など"],["の"],["基本的","きほんてき"],["な"],["教え","おしえ"],["を"],["学び直す","まなびなおす"],["よう"],["な"],["こと"],["は"],["せず"],["、"],["キリスト"],["の"],["教え","おしえ"],["の"],["初歩","しょほ"],["を"],["離れて","はなれて"],["、"],["成熟","せいじゅく"],["を"],["目指して","めざして"],["進みましょう","すすみましょう"],["。"]]},{"verse":3,"text":"神がお許しになるなら、そうすることにしましょう。","tok":[["神","かみ"],["が"],["お許し","おゆるし"],["に"],["なるなら"],["、"],["そう"],["する"],["こと"],["に"],["しましょう"],["。"]]},{"verse":4,"text":"一度光に照らされ、天からの賜物を味わい、聖霊にあずかるようになり、","tok":[["一度","いちど"],["光","ひかり"],["に"],["照らされ","てらされ"],["、"],["天","てん"],["から"],["の"],["賜物","たまもの"],["を"],["味わい","あじわい"],["、"],["聖霊","せいれい"],["に"],["あずかる"],["よう"],["に"],["なり"],["、"]]},{"verse":5,"text":"神のすばらしい言葉と来るべき世の力とを体験しながら、","tok":[["神","かみ"],["の"],["すばらしい"],["言葉","ことば"],["と"],["来るべき","きたるべき"],["世","よ"],["の"],["力","ちから"],["と"],["を"],["体験","たいけん"],["し"],["ながら"],["、"]]},{"verse":6,"text":"その後に堕落した者の場合には、再び悔い改めに立ち帰らせることはできません。神の子を自分の手で改めて十字架につけ、侮辱する者だからです。","tok":[["その後","そのあと"],["に"],["堕落","だらく"],["した"],["者","もの"],["の"],["場合","ばあい"],["に"],["は"],["、"],["再び","ふたたび"],["悔い改め","くいあらため"],["に"],["立ち帰らせる","たちかえらせる"],["こと"],["は"],["できません"],["。"],["神","かみ"],["の"],["子","こ"],["を"],["自分","じぶん"],["の"],["手","て"],["で"],["改めて","あらためて"],["十字架","じゅうじか"],["に"],["つけ"],["、"],["侮辱","ぶじょく"],["する"],["者","もの"],["だ"],["から"],["です"],["。"]]},{"verse":7,"text":"土地は、度々その上に降る雨を吸い込んで、耕す人々に役立つ農作物をもたらすなら、神の祝福を受けます。","tok":[["土地","とち"],["は"],["、"],["度々","たびたび"],["その"],["上","うえ"],["に"],["降る","ふる"],["雨","あめ"],["を"],["吸い込んで","すいこんで"],["、"],["耕す","たがやす"],["人々","ひとびと"],["に"],["役立つ","やくだつ"],["農作物","のうさくもつ"],["を"],["もたらすなら"],["、"],["神","かみ"],["の"],["祝福","しゅくふく"],["を"],["受けます","うけます"],["。"]]},{"verse":8,"text":"しかし、茨やあざみを生えさせると、役に立たなくなり、やがて呪われ、ついには焼かれてしまいます。","tok":[["しかし"],["、"],["茨","うばら"],["や"],["あざみ"],["を"],["生えさせる","はえさせる"],["と"],["、"],["役","やく"],["に"],["立たなく","たたなく"],["なり"],["、"],["やがて"],["呪われ","のろわれ"],["、"],["ついに"],["は"],["焼かれて","やかれて"],["しまいます"],["。"]]},{"verse":9,"text":"しかし、愛する人たち、こんなふうに話してはいても、わたしたちはあなたがたについて、もっと良いこと、救いにかかわることがあると確信しています。","tok":[["しかし"],["、"],["愛する","あいする"],["人","ひと"],["たち"],["、"],["こんな"],["ふう"],["に"],["話して","はなして"],["は"],["いて"],["も"],["、"],["わたしたち"],["は"],["あなた"],["がた"],["について"],["、"],["もっと"],["良い","よい"],["こと"],["、"],["救い","すくい"],["に"],["かかわる"],["こと"],["が"],["ある"],["と"],["確信","かくしん"],["して"],["います"],["。"]]},{"verse":10,"text":"神は不義な方ではないので、あなたがたの働きや、あなたがたが聖なる者たちに以前も今も仕えることによって、神の名のために示したあの愛をお忘れになるようなことはありません。","tok":[["神","かみ"],["は"],["不義","ふぎ"],["な"],["方","かた"],["で"],["は"],["ない"],["ので"],["、"],["あなた"],["がた"],["の"],["働き","はたらき"],["や"],["、"],["あなた"],["がた"],["が"],["聖","せい"],["なる"],["者","もの"],["たち"],["に"],["以前","いぜん"],["も"],["今","いま"],["も"],["仕える","つかえる"],["こと"],["によって"],["、"],["神","かみ"],["の"],["名","な"],["の"],["ため"],["に"],["示した","しめした"],["あの"],["愛","あい"],["を"],["お忘れ","おわすれ"],["に"],["なる"],["よう"],["な"],["こと"],["は"],["ありません"],["。"]]},{"verse":11,"text":"わたしたちは、あなたがたおのおのが最後まで希望を持ち続けるために、同じ熱心さを示してもらいたいと思います。","tok":[["わたしたち"],["は"],["、"],["あなた"],["がた"],["おのおの"],["が"],["最後","さいご"],["まで"],["希望","きぼう"],["を"],["持ち","もち"],["続ける","つづける"],["ため"],["に"],["、"],["同じ","おなじ"],["熱心","ねっしん"],["さ"],["を"],["示して","しめして"],["もらいたい"],["と"],["思います","おもいます"],["。"]]},{"verse":12,"text":"あなたがたが怠け者とならず、信仰と忍耐とによって、約束されたものを受け継ぐ人たちを見倣う者となってほしいのです。","tok":[["あなた"],["がた"],["が"],["怠け者","なまけもの"],["と"],["ならず"],["、"],["信仰","しんこう"],["と"],["忍耐","にんたい"],["と"],["によって"],["、"],["約束","やくそく"],["された"],["もの"],["を"],["受け継ぐ","うけつぐ"],["人","ひと"],["たち"],["を"],["見倣う","みならう"],["者","もの"],["と"],["なって"],["ほしい"],["の"],["です"],["。"]]},{"verse":13,"text":"神は、アブラハムに約束をする際に、御自身より偉大な者にかけて誓えなかったので、御自身にかけて誓い、","tok":[["神","かみ"],["は"],["、"],["アブラハム"],["に"],["約束","やくそく"],["を"],["する"],["際","さい"],["に"],["、"],["御自身","ごじしん"],["より"],["偉大","いだい"],["な"],["者","もの"],["に"],["かけて"],["誓えなかった","ちかえなかった"],["ので"],["、"],["御自身","ごじしん"],["に"],["かけて"],["誓い","ちかい"],["、"]]},{"verse":14,"text":"「わたしは必ずあなたを祝福し、あなたの子孫を大いに増やす」と言われました。","tok":[["「"],["わたし"],["は"],["必ず","かならず"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["の"],["子孫","しそん"],["を"],["大いに","おおいに"],["増やす","ふやす"],["」"],["と"],["言われました","いわれました"],["。"]]},{"verse":15,"text":"こうして、アブラハムは根気よく待って、約束のものを得たのです。","tok":[["こう"],["して"],["、"],["アブラハム"],["は"],["根気","こんき"],["よく"],["待って","まって"],["、"],["約束","やくそく"],["の"],["もの"],["を"],["得た","えた"],["の"],["です"],["。"]]},{"verse":16,"text":"そもそも人間は、自分より偉大な者にかけて誓うのであって、その誓いはあらゆる反対論にけりをつける保証となります。","tok":[["そもそも"],["人間","にんげん"],["は"],["、"],["自分","じぶん"],["より"],["偉大","いだい"],["な"],["者","もの"],["に"],["かけて"],["誓う","ちかう"],["ので"],["あって"],["、"],["その"],["誓い","ちかい"],["は"],["あらゆる"],["反対論","はんたいろん"],["に"],["けり"],["を"],["つける"],["保証","ほしょう"],["と"],["なります"],["。"]]},{"verse":17,"text":"神は約束されたものを受け継ぐ人々に、御自分の計画が変わらないものであることを、いっそうはっきり示したいと考え、それを誓いによって保証なさったのです。","tok":[["神","かみ"],["は"],["約束","やくそく"],["された"],["もの"],["を"],["受け継ぐ","うけつぐ"],["人々","ひとびと"],["に"],["、"],["御自分","ごじぶん"],["の"],["計画","けいかく"],["が"],["変わらない","かわらない"],["もの"],["で"],["ある"],["こと"],["を"],["、"],["いっそう"],["はっきり"],["示したい","しめしたい"],["と"],["考え","かんがえ"],["、"],["それ"],["を"],["誓い","ちかい"],["によって"],["保証","ほしょう"],["なさった"],["の"],["です"],["。"]]},{"verse":18,"text":"それは、目指す希望を持ち続けようとして世を逃れて来たわたしたちが、二つの不変の事柄によって力強く励まされるためです。この事柄に関して、神が偽ることはありえません。","tok":[["それ"],["は"],["、"],["目指す","めざす"],["希望","きぼう"],["を"],["持ち","もち"],["続けよう","つづけよう"],["として"],["世","よ"],["を"],["逃れて","のがれて"],["来た","きた"],["わたしたち"],["が"],["、"],["二","ふた"],["つ"],["の"],["不変","ふへん"],["の"],["事柄","ことがら"],["によって"],["力強く","ちからづよく"],["励まされる","はげまされる"],["ため"],["です"],["。"],["この"],["事柄","ことがら"],["に関して","にかんして"],["、"],["神","かみ"],["が"],["偽る","いつわる"],["こと"],["は"],["あり"],["えません"],["。"]]},{"verse":19,"text":"わたしたちが持っているこの希望は、魂にとって頼りになる、安定した錨のようなものであり、また、至聖所の垂れ幕の内側に入って行くものなのです。","tok":[["わたしたち"],["が"],["持って","もって"],["いる"],["この"],["希望","きぼう"],["は"],["、"],["魂","たましい"],["にとって"],["頼り","たより"],["に"],["なる"],["、"],["安定","あんてい"],["した"],["錨","いかり"],["の"],["よう"],["な"],["もの"],["で"],["あり"],["、"],["また"],["、"],["至聖所","しせいしょ"],["の"],["垂れ幕","たれまく"],["の"],["内側","うちがわ"],["に"],["入って","はいって"],["行く","いく"],["もの"],["な"],["の"],["です"],["。"]]},{"verse":20,"text":"イエスは、わたしたちのために先駆者としてそこへ入って行き、永遠にメルキゼデクと同じような大祭司となられたのです。","tok":[["イエス"],["は"],["、"],["わたしたち"],["の"],["ため"],["に"],["先駆者","せんくしゃ"],["として"],["そこ"],["へ"],["入って","はいって"],["行き","いき"],["、"],["永遠","えいえん"],["に"],["メルキゼデク"],["と"],["同じ","おなじ"],["よう"],["な"],["大","だい"],["祭司","さいし"],["と"],["なられた"],["の"],["です"],["。"]]}]
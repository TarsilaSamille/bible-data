[{"verse":1,"text":"だから、天の召しにあずかっている聖なる兄弟たち、わたしたちが公に言い表している使者であり、大祭司であるイエスのことを考えなさい。","tok":[["だ"],["から"],["、"],["天","てん"],["の"],["召し","めし"],["に"],["あずかって"],["いる"],["聖","せい"],["なる"],["兄弟","きょうだい"],["たち"],["、"],["わたしたち"],["が"],["公","おおやけ"],["に"],["言い表して","いいあらわして"],["いる"],["使者","ししゃ"],["で"],["あり"],["、"],["大","だい"],["祭司","さいし"],["で"],["ある"],["イエス"],["の"],["こと"],["を"],["考え","かんがえ"],["なさい"],["。"]]},{"verse":2,"text":"モーセが神の家全体の中で忠実であったように、イエスは、御自身を立てた方に忠実であられました。","tok":[["モーセ"],["が"],["神","かみ"],["の"],["家","いえ"],["全体","ぜんたい"],["の"],["中","なか"],["で"],["忠実","ちゅうじつ"],["で"],["あった"],["よう"],["に"],["、"],["イエス"],["は"],["、"],["御自身","ごじしん"],["を"],["立てた","たてた"],["方","ほう"],["に"],["忠実","ちゅうじつ"],["で"],["あられました"],["。"]]},{"verse":3,"text":"家を建てる人が家そのものよりも尊ばれるように、イエスはモーセより大きな栄光を受けるにふさわしい者とされました。","tok":[["家","いえ"],["を"],["建てる","たてる"],["人","ひと"],["が"],["家","いえ"],["その"],["もの"],["より"],["も"],["尊ばれる","とうとばれる"],["よう"],["に"],["、"],["イエス"],["は"],["モーセ"],["より"],["大きな","おおきな"],["栄光","えいこう"],["を"],["受ける","うける"],["に"],["ふさわしい"],["者","もの"],["と"],["されました"],["。"]]},{"verse":4,"text":"どんな家でもだれかが造るわけです。万物を造られたのは神なのです。","tok":[["どんな"],["家","いえ"],["で"],["も"],["だれ"],["か"],["が"],["造る","つくる"],["わけ"],["です"],["。"],["万物","ばんぶつ"],["を"],["造られた","つくられた"],["の"],["は"],["神","かみ"],["な"],["の"],["です"],["。"]]},{"verse":5,"text":"さて、モーセは将来語られるはずのことを証しするために、仕える者として神の家全体の中で忠実でしたが、","tok":[["さて"],["、"],["モーセ"],["は"],["将来","しょうらい"],["語られる","かたられる"],["はず"],["の"],["こと"],["を"],["証し","あかし"],["する"],["ため"],["に"],["、"],["仕える","つかえる"],["者","もの"],["として"],["神","かみ"],["の"],["家","いえ"],["全体","ぜんたい"],["の"],["中","なか"],["で"],["忠実","ちゅうじつ"],["でした"],["が"],["、"]]},{"verse":6,"text":"キリストは御子として神の家を忠実に治められるのです。もし確信と希望に満ちた誇りとを持ち続けるならば、わたしたちこそ神の家なのです。","tok":[["キリスト"],["は"],["御子","みこ"],["として"],["神","かみ"],["の"],["家","いえ"],["を"],["忠実","ちゅうじつ"],["に"],["治められる","おさめられる"],["の"],["です"],["。"],["もし"],["確信","かくしん"],["と"],["希望","きぼう"],["に"],["満ちた","みちた"],["誇り","ほこり"],["と"],["を"],["持ち","もち"],["続けるならば","つづけるならば"],["、"],["わたしたち"],["こそ"],["神","かみ"],["の"],["家","いえ"],["な"],["の"],["です"],["。"]]},{"verse":7,"text":"だから、聖霊がこう言われるとおりです。「今日、あなたたちが神の声を聞くなら、","tok":[["だ"],["から"],["、"],["聖霊","せいれい"],["が"],["こう"],["言われる","いわれる"],["とおり"],["です"],["。"],["「"],["今日","きょう"],["、"],["あなた"],["たち"],["が"],["神","かみ"],["の"],["声","こえ"],["を"],["聞くなら","きくなら"],["、"]]},{"verse":8,"text":"荒れ野で試練を受けたころ、神に反抗したときのように、心をかたくなにしてはならない。","tok":[["荒れ野","あれの"],["で"],["試練","しれん"],["を"],["受けた","うけた"],["ころ"],["、"],["神","かみ"],["に"],["反抗","はんこう"],["した"],["とき"],["の"],["よう"],["に"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["。"]]},{"verse":9,"text":"荒れ野であなたたちの先祖は","tok":[["荒れ野","あれの"],["で"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["は"]]},{"verse":10,"text":"わたしを試み、験し、四十年の間わたしの業を見た。だから、わたしは、その時代の者たちに対して憤ってこう言った。『彼らはいつも心が迷っており、わたしの道を認めなかった。』","tok":[["わたし"],["を"],["試み","こころみ"],["、"],["験し","ためし"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["わたし"],["の"],["業","ごう"],["を"],["見た","みた"],["。"],["だ"],["から"],["、"],["わたし"],["は"],["、"],["その"],["時代","じだい"],["の"],["者","もの"],["たち"],["に対して","にたいして"],["憤って","いきどおって"],["こう"],["言った","いった"],["。"],["『"],["彼","かれ"],["ら"],["は"],["いつも"],["心","こころ"],["が"],["迷って","まよって"],["おり"],["、"],["わたし"],["の"],["道","みち"],["を"],["認めなかった","みとめなかった"],["。"],["』"]]},{"verse":11,"text":"そのため、わたしは怒って誓った。『彼らを決してわたしの安息にあずからせはしない』と。」","tok":[["その"],["ため"],["、"],["わたし"],["は"],["怒って","おこって"],["誓った","ちかった"],["。"],["『"],["彼","かれ"],["ら"],["を"],["決して","けっして"],["わたし"],["の"],["安息","あんそく"],["に"],["あずからせ"],["は"],["しない"],["』"],["と"],["。"],["」"]]},{"verse":12,"text":"兄弟たち、あなたがたのうちに、信仰のない悪い心を抱いて、生ける神から離れてしまう者がないように注意しなさい。","tok":[["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["信仰","しんこう"],["の"],["ない"],["悪い","わるい"],["心","こころ"],["を"],["抱いて","いだいて"],["、"],["生ける","いける"],["神","かみ"],["から"],["離れて","はなれて"],["しまう"],["者","もの"],["が"],["ない"],["よう"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"]]},{"verse":13,"text":"あなたがたのうちだれ一人、罪に惑わされてかたくなにならないように、「今日」という日のうちに、日々励まし合いなさい。――","tok":[["あなた"],["がた"],["の"],["うち"],["だれ"],["一人","ひとり"],["、"],["罪","つみ"],["に"],["惑わされて","まどわされて"],["かたくな"],["に"],["ならない"],["よう"],["に"],["、"],["「"],["今日","きょう"],["」"],["と"],["いう"],["日","ひ"],["の"],["うち"],["に"],["、"],["日々","ひび"],["励まし合い","はげましあい"],["なさい"],["。"],["―"],["―"]]},{"verse":14,"text":"わたしたちは、最初の確信を最後までしっかりと持ち続けるなら、キリストに連なる者となるのです。――","tok":[["わたしたち"],["は"],["、"],["最初","さいしょ"],["の"],["確信","かくしん"],["を"],["最後","さいご"],["まで"],["しっかり"],["と"],["持ち","もち"],["続けるなら","つづけるなら"],["、"],["キリスト"],["に"],["連なる","つらなる"],["者","もの"],["と"],["なる"],["の"],["です"],["。"],["―"],["―"]]},{"verse":15,"text":"それについては、次のように言われています。「今日、あなたたちが神の声を聞くなら、神に反抗したときのように、心をかたくなにしてはならない。」","tok":[["それ"],["について"],["は"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われて","いわれて"],["います"],["。"],["「"],["今日","きょう"],["、"],["あなた"],["たち"],["が"],["神","かみ"],["の"],["声","こえ"],["を"],["聞くなら","きくなら"],["、"],["神","かみ"],["に"],["反抗","はんこう"],["した"],["とき"],["の"],["よう"],["に"],["、"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["は"],["ならない"],["。"],["」"]]},{"verse":16,"text":"いったいだれが、神の声を聞いたのに、反抗したのか。モーセを指導者としてエジプトを出たすべての者ではなかったか。","tok":[["いったい"],["だれ"],["が"],["、"],["神","かみ"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["のに"],["、"],["反抗","はんこう"],["した"],["の"],["か"],["。"],["モーセ"],["を"],["指導者","しどうしゃ"],["として"],["エジプト"],["を"],["出た","でた"],["すべて"],["の"],["者","もの"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":17,"text":"いったいだれに対して、神は四十年間憤られたのか。罪を犯して、死骸を荒れ野にさらした者に対してではなかったか。","tok":[["いったい"],["だれ"],["に対して","にたいして"],["、"],["神","かみ"],["は"],["四十","よんじゅう"],["年間","ねんかん"],["憤られた","いきどおられた"],["の"],["か"],["。"],["罪","つみ"],["を"],["犯して","おかして"],["、"],["死骸","しがい"],["を"],["荒れ野","あれの"],["に"],["さらした"],["者","もの"],["に対して","にたいして"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":18,"text":"いったいだれに対して、御自分の安息にあずからせはしないと、誓われたのか。従わなかった者に対してではなかったか。","tok":[["いったい"],["だれ"],["に対して","にたいして"],["、"],["御自分","ごじぶん"],["の"],["安息","あんそく"],["に"],["あずからせ"],["は"],["しない"],["と"],["、"],["誓われた","ちかわれた"],["の"],["か"],["。"],["従わなかった","したがわなかった"],["者","もの"],["に対して","にたいして"],["で"],["は"],["なかった"],["か"],["。"]]},{"verse":19,"text":"このようにして、彼らが安息にあずかることができなかったのは、不信仰のせいであったことがわたしたちに分かるのです。","tok":[["この"],["よう"],["に"],["して"],["、"],["彼","かれ"],["ら"],["が"],["安息","あんそく"],["に"],["あずかる"],["こと"],["が"],["できなかった"],["の"],["は"],["、"],["不","ふ"],["信仰","しんこう"],["の"],["せい"],["で"],["あった"],["こと"],["が"],["わたしたち"],["に"],["分かる","わかる"],["の"],["です"],["。"]]}]
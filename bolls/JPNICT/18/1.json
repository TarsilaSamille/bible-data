[{"verse":1,"text":"ウツの地にヨブという人がいた。無垢な正しい人で、神を畏れ、悪を避けて生きていた。","tok":[["ウツ"],["の"],["地","ち"],["に"],["ヨブ"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["無垢","むく"],["な"],["正しい","ただしい"],["人","ひと"],["で"],["、"],["神","かみ"],["を"],["畏れ","おそれ"],["、"],["悪","あく"],["を"],["避けて","さけて"],["生きて","いきて"],["いた"],["。"]]},{"verse":2,"text":"七人の息子と三人の娘を持ち、","tok":[["七人","しちにん"],["の"],["息子","むすこ"],["と"],["三人","さんにん"],["の"],["娘","むすめ"],["を"],["持ち","もち"],["、"]]},{"verse":3,"text":"羊七千匹、らくだ三千頭、牛五百くびき、雌ろば五百頭の財産があり、使用人も非常に多かった。彼は東の国一番の富豪であった。","tok":[["羊","ひつじ"],["七千匹","ななせんひき"],["、"],["らくだ"],["三千頭","さんせんとう"],["、"],["牛","うし"],["五百","ごひゃく"],["く"],["びき"],["、"],["雌","めす"],["ろば"],["五百頭","ごひゃくとう"],["の"],["財産","ざいさん"],["が"],["あり"],["、"],["使用人","しようにん"],["も"],["非常","ひじょう"],["に"],["多かった","おおかった"],["。"],["彼","かれ"],["は"],["東","ひがし"],["の"],["国","くに"],["一","いち"],["番","ばん"],["の"],["富豪","ふごう"],["で"],["あった"],["。"]]},{"verse":4,"text":"息子たちはそれぞれ順番に、自分の家で宴会の用意をし、三人の姉妹も招いて食事をすることにしていた。","tok":[["息子","むすこ"],["たち"],["は"],["それぞれ"],["順番","じゅんばん"],["に"],["、"],["自分","じぶん"],["の"],["家","いえ"],["で"],["宴会","えんかい"],["の"],["用意","ようい"],["を"],["し"],["、"],["三人","さんにん"],["の"],["姉妹","しまい"],["も"],["招いて","まねいて"],["食事","しょくじ"],["を"],["する"],["こと"],["に"],["して"],["いた"],["。"]]},{"verse":5,"text":"この宴会が一巡りするごとに、ヨブは息子たちを呼び寄せて聖別し、朝早くから彼らの数に相当するいけにえをささげた。「息子たちが罪を犯し、心の中で神を呪ったかもしれない」と思ったからである。ヨブはいつもこのようにした。","tok":[["この"],["宴会","えんかい"],["が"],["一巡り","ひとめぐり"],["する"],["ごと"],["に"],["、"],["ヨブ"],["は"],["息子","むすこ"],["たち"],["を"],["呼び寄せて","よびよせて"],["聖別","せいべつ"],["し"],["、"],["朝","あさ"],["早く","はやく"],["から"],["彼","かれ"],["ら"],["の"],["数","かず"],["に"],["相当","そうとう"],["する"],["いけにえ"],["を"],["ささげた"],["。"],["「"],["息子","むすこ"],["たち"],["が"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["神","かみ"],["を"],["呪った","のろった"],["か"],["も"],["しれない"],["」"],["と"],["思った","おもった"],["から"],["で"],["ある"],["。"],["ヨブ"],["は"],["いつも"],["この"],["よう"],["に"],["した"],["。"]]},{"verse":6,"text":"ある日、主の前に神の使いたちが集まり、サタンも来た。","tok":[["ある"],["日","ひ"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["神","かみ"],["の"],["使い","つかい"],["たち"],["が"],["集まり","あつまり"],["、"],["サタン"],["も"],["来た","きた"],["。"]]},{"verse":7,"text":"主はサタンに言われた。「お前はどこから来た。」「地上を巡回しておりました。ほうぼうを歩きまわっていました」とサタンは答えた。","tok":[["主","ぬし"],["は"],["サタン"],["に"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["どこ"],["から"],["来た","きた"],["。"],["」"],["「"],["地上","ちじょう"],["を"],["巡回","じゅんかい"],["して"],["おりました"],["。"],["ほうぼう"],["を"],["歩き","あるき"],["まわって"],["いました"],["」"],["と"],["サタン"],["は"],["答えた","こたえた"],["。"]]},{"verse":8,"text":"主はサタンに言われた。「お前はわたしの僕ヨブに気づいたか。地上に彼ほどの者はいまい。無垢な正しい人で、神を畏れ、悪を避けて生きている。」","tok":[["主","ぬし"],["は"],["サタン"],["に"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["わたし"],["の"],["僕","ぼく"],["ヨブ"],["に"],["気づいた","きづいた"],["か"],["。"],["地上","ちじょう"],["に"],["彼","かれ"],["ほど"],["の"],["者","もの"],["は"],["いまい"],["。"],["無垢","むく"],["な"],["正しい","ただしい"],["人","ひと"],["で"],["、"],["神","かみ"],["を"],["畏れ","おそれ"],["、"],["悪","あく"],["を"],["避けて","さけて"],["生きて","いきて"],["いる"],["。"],["」"]]},{"verse":9,"text":"サタンは答えた。「ヨブが、利益もないのに神を敬うでしょうか。","tok":[["サタン"],["は"],["答えた","こたえた"],["。"],["「"],["ヨブ"],["が"],["、"],["利益","りえき"],["も"],["ない"],["のに"],["神","かみ"],["を"],["敬うでしょう","うやまうでしょう"],["か"],["。"]]},{"verse":10,"text":"あなたは彼とその一族、全財産を守っておられるではありませんか。彼の手の業をすべて祝福なさいます。お陰で、彼の家畜はその地に溢れるほどです。","tok":[["あなた"],["は"],["彼","かれ"],["と"],["その"],["一族","いちぞく"],["、"],["全","ぜん"],["財産","ざいさん"],["を"],["守って","まもって"],["おられるで"],["は"],["ありません"],["か"],["。"],["彼","かれ"],["の"],["手","て"],["の"],["業","ごう"],["を"],["すべて"],["祝福","しゅくふく"],["なさいます"],["。"],["お陰","おかげ"],["で"],["、"],["彼","かれ"],["の"],["家畜","かちく"],["は"],["その"],["地","ち"],["に"],["溢れる","あふれる"],["ほど"],["です"],["。"]]},{"verse":11,"text":"ひとつこの辺で、御手を伸ばして彼の財産に触れてごらんなさい。面と向かってあなたを呪うにちがいありません。」","tok":[["ひと"],["つ"],["この"],["辺","へん"],["で"],["、"],["御手","おて"],["を"],["伸ばして","のばして"],["彼","かれ"],["の"],["財産","ざいさん"],["に"],["触れて","ふれて"],["ごらん"],["なさい"],["。"],["面","めん"],["と"],["向かって","むかって"],["あなた"],["を"],["呪う","のろう"],["に"],["ちがい"],["ありません"],["。"],["」"]]},{"verse":12,"text":"主はサタンに言われた。「それでは、彼のものを一切、お前のいいようにしてみるがよい。ただし彼には、手を出すな。」サタンは主のもとから出て行った。","tok":[["主","ぬし"],["は"],["サタン"],["に"],["言われた","いわれた"],["。"],["「"],["それ"],["で"],["は"],["、"],["彼","かれ"],["の"],["もの"],["を"],["一切","いっさい"],["、"],["お前","おまえ"],["の"],["いい"],["よう"],["に"],["して"],["みる"],["が"],["よい"],["。"],["ただし"],["彼","かれ"],["に"],["は"],["、"],["手","て"],["を"],["出す","だす"],["な"],["。"],["」"],["サタン"],["は"],["主","ぬし"],["の"],["もと"],["から"],["出て","でて"],["行った","いった"],["。"]]},{"verse":13,"text":"ヨブの息子、娘が、長兄の家で宴会を開いていた日のことである。","tok":[["ヨブ"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["が"],["、"],["長兄","ちょうけい"],["の"],["家","いえ"],["で"],["宴会","えんかい"],["を"],["開いて","ひらいて"],["いた"],["日","ひ"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":14,"text":"ヨブのもとに、一人の召使いが報告に来た。「御報告いたします。わたしどもが、牛に畑を耕させ、その傍らでろばに草を食べさせておりますと、シェバ人が襲いかかり、略奪していきました。牧童たちは切り殺され、わたしひとりだけ逃げのびて参りました。」","tok":[["ヨブ"],["の"],["もと"],["に"],["、"],["一人","ひとり"],["の"],["召使い","めしつかい"],["が"],["報告","ほうこく"],["に"],["来た","きた"],["。"],["「"],["御報告","ごほうこく"],["いたします"],["。"],["わたし"],["ども"],["が"],["、"],["牛","うし"],["に"],["畑","はたけ"],["を"],["耕させ","たがやさせ"],["、"],["その"],["傍ら","かたわら"],["で"],["ろば"],["に"],["草","くさ"],["を"],["食べさせて","たべさせて"],["おります"],["と"],["、"],["シェバ人","しぇばにん"],["が"],["襲いかかり","おそいかかり"],["、"],["略奪","りゃくだつ"],["して"],["いきました"],["。"],["牧童","ぼくどう"],["たち"],["は"],["切り殺され","きりころされ"],["、"],["わたし"],["ひとり"],["だけ"],["逃げのびて","にげのびて"],["参りました","まいりました"],["。"],["」"]]},{"verse":16,"text":"彼が話し終らないうちに、また一人が来て言った。「御報告いたします。天から神の火が降って、羊も羊飼いも焼け死んでしまいました。わたしひとりだけ逃げのびて参りました。」","tok":[["彼","かれ"],["が"],["話し","はなし"],["終らない","おわらない"],["うち"],["に"],["、"],["また"],["一人","ひとり"],["が"],["来て","きて"],["言った","いった"],["。"],["「"],["御報告","ごほうこく"],["いたします"],["。"],["天","てん"],["から"],["神","かみ"],["の"],["火","ひ"],["が"],["降って","ふって"],["、"],["羊","ひつじ"],["も"],["羊飼い","ひつじかい"],["も"],["焼け死んで","やけしんで"],["しまいました"],["。"],["わたし"],["ひとり"],["だけ"],["逃げのびて","にげのびて"],["参りました","まいりました"],["。"],["」"]]},{"verse":17,"text":"彼が話し終らないうちに、また一人来て言った。「御報告いたします。カルデア人が三部隊に分かれてらくだの群れを襲い、奪っていきました。牧童たちは切り殺され、わたしひとりだけ逃げのびて参りました。」","tok":[["彼","かれ"],["が"],["話し","はなし"],["終らない","おわらない"],["うち"],["に"],["、"],["また"],["一人","ひとり"],["来て","きて"],["言った","いった"],["。"],["「"],["御報告","ごほうこく"],["いたします"],["。"],["カルデア"],["人","にん"],["が"],["三","さん"],["部隊","ぶたい"],["に"],["分かれて","わかれて"],["らくだ"],["の"],["群れ","むれ"],["を"],["襲い","おそい"],["、"],["奪って","うばって"],["いきました"],["。"],["牧童","ぼくどう"],["たち"],["は"],["切り殺され","きりころされ"],["、"],["わたし"],["ひとり"],["だけ"],["逃げのびて","にげのびて"],["参りました","まいりました"],["。"],["」"]]},{"verse":18,"text":"彼が話し終らないうちに、更にもう一人来て言った。「御報告いたします。御長男のお宅で、御子息、御息女の皆様が宴会を開いておられました。","tok":[["彼","かれ"],["が"],["話し","はなし"],["終らない","おわらない"],["うち"],["に"],["、"],["更に","さらに"],["もう"],["一人","ひとり"],["来て","きて"],["言った","いった"],["。"],["「"],["御報告","ごほうこく"],["いたします"],["。"],["御長男","ごちょうなん"],["の"],["お宅","おたく"],["で"],["、"],["御子息","ごしそく"],["、"],["御息女","ごそくじょ"],["の"],["皆様","みなさま"],["が"],["宴会","えんかい"],["を"],["開いて","ひらいて"],["おられました"],["。"]]},{"verse":19,"text":"すると、荒れ野の方から大風が来て四方から吹きつけ、家は倒れ、若い方々は死んでしまわれました。わたしひとりだけ逃げのびて参りました。」","tok":[["する"],["と"],["、"],["荒れ野","あれの"],["の"],["方","ほう"],["から"],["大風","おおかぜ"],["が"],["来て","きて"],["四方","しほう"],["から"],["吹きつけ","ふきつけ"],["、"],["家","いえ"],["は"],["倒れ","たおれ"],["、"],["若い","わかい"],["方々","かたがた"],["は"],["死んで","しんで"],["しまわれました"],["。"],["わたし"],["ひとり"],["だけ"],["逃げのびて","にげのびて"],["参りました","まいりました"],["。"],["」"]]},{"verse":20,"text":"ヨブは立ち上がり、衣を裂き、髪をそり落とし、地にひれ伏して言った。","tok":[["ヨブ"],["は"],["立ち上がり","たちあがり"],["、"],["衣","ころも"],["を"],["裂き","さき"],["、"],["髪","かみ"],["を"],["そり落とし","そりおとし"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["言った","いった"],["。"]]},{"verse":21,"text":"「わたしは裸で母の胎を出た。裸でそこに帰ろう。主は与え、主は奪う。主の御名はほめたたえられよ。」","tok":[["「"],["わたし"],["は"],["裸","はだか"],["で"],["母","はは"],["の"],["胎","はら"],["を"],["出た","でた"],["。"],["裸","はだか"],["で"],["そこ"],["に"],["帰ろう","かえろう"],["。"],["主","ぬし"],["は"],["与え","あたえ"],["、"],["主","ぬし"],["は"],["奪う","うばう"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["は"],["ほめたたえられよ"],["。"],["」"]]},{"verse":22,"text":"このような時にも、ヨブは神を非難することなく、罪を犯さなかった。","tok":[["この"],["よう"],["な"],["時","とき"],["に"],["も"],["、"],["ヨブ"],["は"],["神","かみ"],["を"],["非難","ひなん"],["する"],["こと"],["なく"],["、"],["罪","つみ"],["を"],["犯さなかった
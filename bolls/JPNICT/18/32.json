[{"verse":1,"text":"ここで、この三人はヨブに答えるのをやめた。ヨブが自分は正しいと確信していたからである。","tok":[["ここ"],["で"],["、"],["この"],["三人","さんにん"],["は"],["ヨブ"],["に"],["答える","こたえる"],["の"],["を"],["やめた"],["。"],["ヨブ"],["が"],["自分","じぶん"],["は"],["正しい","ただしい"],["と"],["確信","かくしん"],["して"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"さて、エリフは怒った。この人はブズ出身でラム族のバラクエルの子である。ヨブが神よりも自分の方が正しいと主張するので、彼は怒った。","tok":[["さて"],["、"],["エリフ"],["は"],["怒った","おこった"],["。"],["この"],["人","ひと"],["は"],["ブズ"],["出身","しゅっしん"],["で"],["ラム族","らむぞく"],["の"],["バラクエル"],["の"],["子","こ"],["で"],["ある"],["。"],["ヨブ"],["が"],["神","かみ"],["より"],["も"],["自分","じぶん"],["の"],["方","ほう"],["が"],["正しい","ただしい"],["と"],["主張","しゅちょう"],["する"],["ので"],["、"],["彼","かれ"],["は"],["怒った","おこった"],["。"]]},{"verse":3,"text":"また、ヨブの三人の友人が、ヨブに罪のあることを示す適切な反論を見いだせなかったので、彼らに対しても怒った。","tok":[["また"],["、"],["ヨブ"],["の"],["三人","さんにん"],["の"],["友人","ゆうじん"],["が"],["、"],["ヨブ"],["に"],["罪","つみ"],["の"],["ある"],["こと"],["を"],["示す","しめす"],["適切","てきせつ"],["な"],["反論","はんろん"],["を"],["見いだせなかった","みいだせなかった"],["ので"],["、"],["彼","かれ"],["ら"],["に対して","にたいして"],["も"],["怒った","おこった"],["。"]]},{"verse":4,"text":"彼らが皆、年長だったので、エリフはヨブに話しかけるのを控えていたが、","tok":[["彼","かれ"],["ら"],["が"],["皆","みな"],["、"],["年長","ねんちょう"],["だった"],["ので"],["、"],["エリフ"],["は"],["ヨブ"],["に"],["話しかける","はなしかける"],["の"],["を"],["控えて","ひかえて"],["いた"],["が"],["、"]]},{"verse":5,"text":"この三人の口から何の反論も出ないのを見たので怒ったのである。","tok":[["この"],["三人","さんにん"],["の"],["口","くち"],["から"],["何","なん"],["の"],["反論","はんろん"],["も"],["出ない","でない"],["の"],["を"],["見た","みた"],["ので"],["怒った","おこった"],["ので"],["ある"],["。"]]},{"verse":6,"text":"ブズ人バラクエルの子、エリフは言った。わたしは若くあなたたちは年をとっておられる。だからわたしは遠慮しわたしの意見をあえて言わなかった。","tok":[["ブズ人","ぶずにん"],["バラクエル"],["の"],["子","こ"],["、"],["エリフ"],["は"],["言った","いった"],["。"],["わたし"],["は"],["若く","わかく"],["あなた"],["たち"],["は"],["年","とし"],["を"],["とって"],["おられる"],["。"],["だ"],["から"],["わたし"],["は"],["遠慮","えんりょ"],["し"],["わたし"],["の"],["意見","いけん"],["を"],["あえて"],["言わなかった","いわなかった"],["。"]]},{"verse":7,"text":"日数がものを言い年数が知恵を授けると思っていた。","tok":[["日数","にっすう"],["が"],["もの"],["を"],["言い","いい"],["年数","ねんすう"],["が"],["知恵","ちえ"],["を"],["授ける","さずける"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":8,"text":"しかし、人の中には霊があり悟りを与えるのは全能者の息吹なのだ。","tok":[["しかし"],["、"],["人","ひと"],["の"],["中","なか"],["に"],["は"],["霊","れい"],["が"],["あり"],["悟り","さとり"],["を"],["与える","あたえる"],["の"],["は"],["全能者","ぜんのうしゃ"],["の"],["息吹","いぶき"],["な"],["の"],["だ"],["。"]]},{"verse":9,"text":"日を重ねれば賢くなるというのではなく老人になればふさわしい分別ができるのでもない。","tok":[["日","ひ"],["を"],["重ねれば","かさねれば"],["賢く","かしこく"],["なる"],["と"],["いう"],["ので"],["は"],["なく"],["老人","ろうじん"],["に"],["なれば"],["ふさわしい"],["分別","ぶんべつ"],["が"],["できる"],["ので"],["も"],["ない"],["。"]]},{"verse":10,"text":"それゆえ、わたしの言うことも聞いてほしい。わたしの意見を述べてみたいと思う。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["の"],["言う","いう"],["こと"],["も"],["聞いて","きいて"],["ほしい"],["。"],["わたし"],["の"],["意見","いけん"],["を"],["述べて","のべて"],["みたい"],["と"],["思う","おもう"],["。"]]},{"verse":11,"text":"わたしはあなたたちの言葉を待ちその考えに耳を傾け言葉を尽くして論じるのを聞き","tok":[["わたし"],["は"],["あなた"],["たち"],["の"],["言葉","ことば"],["を"],["待ち","まち"],["その"],["考え","かんがえ"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["言葉","ことば"],["を"],["尽くして","つくして"],["論じる","ろんじる"],["の"],["を"],["聞き","きき"]]},{"verse":12,"text":"その論拠を理解しようとした。だが、あなたたちの中にはヨブを言い伏せ彼の言葉に反論しうる者がない。","tok":[["その"],["論拠","ろんきょ"],["を"],["理解","りかい"],["しよう"],["と"],["した"],["。"],["だ"],["が"],["、"],["あなた"],["たち"],["の"],["中","なか"],["に"],["は"],["ヨブ"],["を"],["言い伏せ","いいふせ"],["彼","かれ"],["の"],["言葉","ことば"],["に"],["反論","はんろん"],["し"],["うる"],["者","もの"],["が"],["ない"],["。"]]},{"verse":13,"text":"「いい知恵がある。彼を負かすのは神であって人ではないと言おう」などと考えるべきではない。","tok":[["「"],["いい"],["知恵","ちえ"],["が"],["ある"],["。"],["彼","かれ"],["を"],["負かす","まかす"],["の"],["は"],["神","かみ"],["で"],["あって"],["人","ひと"],["で"],["は"],["ない"],["と"],["言おう","いおう"],["」"],["など"],["と"],["考えるべきで","かんがえるべきで"],["は"],["ない"],["。"]]},{"verse":14,"text":"ヨブはわたしに対して議論したのではないがわたしはあなたたちのような論法で答えようとは思わない。","tok":[["ヨブ"],["は"],["わたし"],["に対して","にたいして"],["議論","ぎろん"],["した"],["ので"],["は"],["ない"],["が"],["わたし"],["は"],["あなた"],["たち"],["の"],["よう"],["な"],["論法","ろんぽう"],["で"],["答えよう","こたえよう"],["と"],["は"],["思わない","おもわない"],["。"]]},{"verse":15,"text":"彼らは気を挫かれて、答えようとせず言うべき言葉を失っている。","tok":[["彼","かれ"],["ら"],["は"],["気","き"],["を"],["挫かれて","くじかれて"],["、"],["答えよう","こたえよう"],["と"],["せず"],["言うべき","ゆうべき"],["言葉","ことば"],["を"],["失って","うしなって"],["いる"],["。"]]},{"verse":16,"text":"わたしは待ったが、彼らは語らず行き詰まり、もう答えようとしない。","tok":[["わたし"],["は"],["待った","まった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["語らず","かたらず"],["行き詰まり","いきづまり"],["、"],["もう"],["答えよう","こたえよう"],["と"],["しない"],["。"]]},{"verse":17,"text":"それならわたしが自分の言い分を述べさせてもらおう。わたしの意見を言わせてもらおう。","tok":[["それ"],["なら"],["わたし"],["が"],["自分","じぶん"],["の"],["言い分","いいぶん"],["を"],["述べさせて","のべさせて"],["もらおう"],["。"],["わたし"],["の"],["意見","いけん"],["を"],["言わせて","いわせて"],["もらおう"],["。"]]},{"verse":18,"text":"言いたいことはたくさんある。腹の内で霊がわたしを駆り立てている。","tok":[["言いたい","いいたい"],["こと"],["は"],["たくさん"],["ある"],["。"],["腹","はら"],["の"],["内","うち"],["で"],["霊","れい"],["が"],["わたし"],["を"],["駆り立てて","かりたてて"],["いる"],["。"]]},{"verse":19,"text":"見よ、わたしの腹は封じられたぶどう酒の袋新しい酒で張り裂けんばかりの革袋のようだ。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["腹","はら"],["は"],["封じられた","ふうじられた"],["ぶどう酒","ぶどうしゅ"],["の"],["袋","ふくろ"],["新しい","あたらしい"],["酒","さけ"],["で"],["張り裂けん","はりさけん"],["ばかり"],["の"],["革袋","かわぶくろ"],["の"],["よう"],["だ"],["。"]]},{"verse":20,"text":"わたしも話して、気持を静めたい。唇を開いて、答えたい。","tok":[["わたし"],["も"],["話して","はなして"],["、"],["気持","きもち"],["を"],["静めたい","しずめたい"],["。"],["唇","くちびる"],["を"],["開いて","ひらいて"],["、"],["答えたい","こたえたい"],["。"]]},{"verse":21,"text":"いや、わたしはだれの顔を立てようともしない。人間にへつらうことはしたくない。","tok":[["いや"],["、"],["わたし"],["は"],["だれ"],["の"],["顔","かお"],["を"],["立てよう","たてよう"],["と"],["も"],["しない"],["。"],["人間","にんげん"],["に"],["へつらう"],["こと"],["は"],["したく"],["ない"],["。"]]},{"verse":22,"text":"気づかずにへつらうようなことを言ったらどうか造り主が直ちにわたしを退けてくださるように。","tok":[["気づかず","きづかず"],["に"],["へつらう"],["よう"],["な"],["こと"],["を"],["言ったら","いったら"],["どう"],["か"],["造り主","つくりぬし"],["が"],["直ちに","ただちに"],["わたし"],["を"],["退けて","しりぞけて"],["くださる"],["よう"],["に"],["。"]]}]
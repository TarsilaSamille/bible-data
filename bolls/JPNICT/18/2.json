[{"verse":1,"text":"またある日、主の前に神の使いたちが集まり、サタンも来て、主の前に進み出た。","tok":[["また"],["ある"],["日","ひ"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["神","かみ"],["の"],["使い","つかい"],["たち"],["が"],["集まり","あつまり"],["、"],["サタン"],["も"],["来て","きて"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["進み出た","すすみでた"],["。"]]},{"verse":2,"text":"主はサタンに言われた。「お前はどこから来た。」「地上を巡回しておりました。ほうぼうを歩きまわっていました」とサタンは答えた。","tok":[["主","ぬし"],["は"],["サタン"],["に"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["どこ"],["から"],["来た","きた"],["。"],["」"],["「"],["地上","ちじょう"],["を"],["巡回","じゅんかい"],["して"],["おりました"],["。"],["ほうぼう"],["を"],["歩き","あるき"],["まわって"],["いました"],["」"],["と"],["サタン"],["は"],["答えた","こたえた"],["。"]]},{"verse":3,"text":"主はサタンに言われた。「お前はわたしの僕ヨブに気づいたか。地上に彼ほどの者はいまい。無垢な正しい人で、神を畏れ、悪を避けて生きている。お前は理由もなく、わたしを唆して彼を破滅させようとしたが、彼はどこまでも無垢だ。」","tok":[["主","ぬし"],["は"],["サタン"],["に"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["わたし"],["の"],["僕","ぼく"],["ヨブ"],["に"],["気づいた","きづいた"],["か"],["。"],["地上","ちじょう"],["に"],["彼","かれ"],["ほど"],["の"],["者","もの"],["は"],["いまい"],["。"],["無垢","むく"],["な"],["正しい","ただしい"],["人","ひと"],["で"],["、"],["神","かみ"],["を"],["畏れ","おそれ"],["、"],["悪","あく"],["を"],["避けて","さけて"],["生きて","いきて"],["いる"],["。"],["お前","おまえ"],["は"],["理由","りゆう"],["も"],["なく"],["、"],["わたし"],["を"],["唆して","そそのかして"],["彼","かれ"],["を"],["破滅","はめつ"],["させよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["は"],["どこ"],["まで"],["も"],["無垢","むく"],["だ"],["。"],["」"]]},{"verse":4,"text":"サタンは答えた。「皮には皮を、と申します。まして命のためには全財産を差し出すものです。","tok":[["サタン"],["は"],["答えた","こたえた"],["。"],["「"],["皮","かわ"],["に"],["は"],["皮","かわ"],["を"],["、"],["と"],["申します","もうします"],["。"],["まして"],["命","いのち"],["の"],["ため"],["に"],["は"],["全","ぜん"],["財産","ざいさん"],["を"],["差し出す","さしだす"],["もの"],["です"],["。"]]},{"verse":5,"text":"手を伸ばして彼の骨と肉に触れてごらんなさい。面と向かってあなたを呪うにちがいありません。」","tok":[["手","て"],["を"],["伸ばして","のばして"],["彼","かれ"],["の"],["骨","ほね"],["と"],["肉","にく"],["に"],["触れて","ふれて"],["ごらん"],["なさい"],["。"],["面","めん"],["と"],["向かって","むかって"],["あなた"],["を"],["呪う","のろう"],["に"],["ちがい"],["ありません"],["。"],["」"]]},{"verse":6,"text":"主はサタンに言われた。「それでは、彼をお前のいいようにするがよい。ただし、命だけは奪うな。」","tok":[["主","ぬし"],["は"],["サタン"],["に"],["言われた","いわれた"],["。"],["「"],["それ"],["で"],["は"],["、"],["彼","かれ"],["を"],["お前","おまえ"],["の"],["いい"],["よう"],["に"],["する"],["が"],["よい"],["。"],["ただし"],["、"],["命","いのち"],["だけ"],["は"],["奪う","うばう"],["な"],["。"],["」"]]},{"verse":7,"text":"サタンは主の前から出て行った。サタンはヨブに手を下し、頭のてっぺんから足の裏までひどい皮膚病にかからせた。","tok":[["サタン"],["は"],["主","ぬし"],["の"],["前","まえ"],["から"],["出て","でて"],["行った","いった"],["。"],["サタン"],["は"],["ヨブ"],["に"],["手","て"],["を"],["下し","くだし"],["、"],["頭","あたま"],["の"],["てっぺん"],["から"],["足","あし"],["の"],["裏","うら"],["まで"],["ひどい"],["皮膚病","ひふびょう"],["に"],["かからせた"],["。"]]},{"verse":8,"text":"ヨブは灰の中に座り、素焼きのかけらで体中をかきむしった。","tok":[["ヨブ"],["は"],["灰","はい"],["の"],["中","なか"],["に"],["座り","すわり"],["、"],["素焼き","すやき"],["の"],["かけら"],["で"],["体中","たいちゅう"],["を"],["かきむしった"],["。"]]},{"verse":9,"text":"彼の妻は、「どこまでも無垢でいるのですか。神を呪って、死ぬ方がましでしょう」と言ったが、","tok":[["彼","かれ"],["の"],["妻","つま"],["は"],["、"],["「"],["どこ"],["まで"],["も"],["無垢","むく"],["で"],["いる"],["の"],["です"],["か"],["。"],["神","かみ"],["を"],["呪って","のろって"],["、"],["死ぬ","しぬ"],["方","かた"],["が"],["まし"],["でしょう"],["」"],["と"],["言った","いった"],["が"],["、"]]},{"verse":10,"text":"ヨブは答えた。「お前まで愚かなことを言うのか。わたしたちは、神から幸福をいただいたのだから、不幸もいただこうではないか。」このようになっても、彼は唇をもって罪を犯すことをしなかった。","tok":[["ヨブ"],["は"],["答えた","こたえた"],["。"],["「"],["お前","おまえ"],["まで"],["愚か","おろか"],["な"],["こと"],["を"],["言う","いう"],["の"],["か"],["。"],["わたしたち"],["は"],["、"],["神","かみ"],["から"],["幸福","こうふく"],["を"],["いただいた"],["の"],["だ"],["から"],["、"],["不幸","ふこう"],["も"],["いただこうで"],["は"],["ない"],["か"],["。"],["」"],["この"],["よう"],["に"],["なって"],["も"],["、"],["彼","かれ"],["は"],["唇","くちびる"],["を"],["もって"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["を"],["しなかった"],["。"]]},{"verse":11,"text":"さて、ヨブと親しいテマン人エリファズ、シュア人ビルダド、ナアマ人ツォファルの三人は、ヨブにふりかかった災難の一部始終を聞くと、見舞い慰めようと相談して、それぞれの国からやって来た。","tok":[["さて"],["、"],["ヨブ"],["と"],["親しい","したしい"],["テマン人","てまんにん"],["エリファズ"],["、"],["シュア"],["人","にん"],["ビルダド"],["、"],["ナアマ人","なあまにん"],["ツォファル"],["の"],["三人","さんにん"],["は"],["、"],["ヨブ"],["に"],["ふりかかった"],["災難","さいなん"],["の"],["一部","いちぶ"],["始終","しじゅう"],["を"],["聞く","きく"],["と"],["、"],["見舞い","みまい"],["慰めよう","なぐさめよう"],["と"],["相談","そうだん"],["して"],["、"],["それぞれ"],["の"],["国","くに"],["から"],["やって"],["来た","きた"],["。"]]},{"verse":12,"text":"遠くからヨブを見ると、それと見分けられないほどの姿になっていたので、嘆きの声をあげ、衣を裂き、天に向かって塵を振りまき、頭にかぶった。","tok":[["遠く","とおく"],["から"],["ヨブ"],["を"],["見る","みる"],["と"],["、"],["それ"],["と"],["見分けられない","みわけられない"],["ほど"],["の"],["姿","すがた"],["に"],["なって"],["いた"],["ので"],["、"],["嘆き","なげき"],["の"],["声","こえ"],["を"],["あげ"],["、"],["衣","ころも"],["を"],["裂き","さき"],["、"],["天","てん"],["に"],["向かって","むかって"],["塵","ごみ"],["を"],["振りまき","ふりまき"],["、"],["頭","あたま"],["に"],["かぶった"],["。"]]},{"verse":13,"text":"彼らは七日七晩、ヨブと共に地面に座っていたが、その激しい苦痛を見ると、話しかけることもできなかった。","tok":[["彼","かれ"],["ら"],["は"],["七日","ななか"],["七","なな"],["晩","ばん"],["、"],["ヨブ"],["と"],["共","とも"],["に"],["地面","じめん"],["に"],["座って","すわって"],["いた"],["が"],["、"],["その"],["激しい","はげしい"],["苦痛","くつう"],["を"],["見る","みる"],["と"],["、"],["話しかける","はなしかける"],["こと"],["も"],["できなかった"],["。"]]}]
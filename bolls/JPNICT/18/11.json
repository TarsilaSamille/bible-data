[{"verse":1,"text":"ナアマ人ツォファルは話し始めた。","tok":[["ナアマ人","なあまにん"],["ツォファル"],["は"],["話し","はなし"],["始めた","はじめた"],["。"]]},{"verse":2,"text":"これだけまくし立てられては答えないわけにいくまい。口がうまければそれで正しいと認められるだろうか。","tok":[["これ"],["だけ"],["まくし立てられて","まくしたてられて"],["は"],["答えない","こたえない"],["わけ"],["に"],["いくまい"],["。"],["口","くち"],["が"],["うまければ"],["それ"],["で"],["正しい","ただしい"],["と"],["認められるだろう","みとめられるだろう"],["か"],["。"]]},{"verse":3,"text":"あなたの無駄口が人々を黙らせるだろうか。嘲りの言葉を吐いて恥をかかずに済むだろうか。","tok":[["あなた"],["の"],["無駄口","むだぐち"],["が"],["人々","ひとびと"],["を"],["黙らせるだろう","だまらせるだろう"],["か"],["。"],["嘲り","あざけり"],["の"],["言葉","ことば"],["を"],["吐いて","はいて"],["恥","はじ"],["を"],["かかず"],["に"],["済むだろう","すむだろう"],["か"],["。"]]},{"verse":4,"text":"あなたは言う。「わたしの主張は正しい。あなたの目にもわたしは潔白なはずだ」と。","tok":[["あなた"],["は"],["言う","ゆう"],["。"],["「"],["わたし"],["の"],["主張","しゅちょう"],["は"],["正しい","ただしい"],["。"],["あなた"],["の"],["目","め"],["に"],["も"],["わたし"],["は"],["潔白","けっぱく"],["な"],["はず"],["だ"],["」"],["と"],["。"]]},{"verse":5,"text":"しかし、神があなたに対して唇を開き何と言われるか聞きたいものだ。","tok":[["しかし"],["、"],["神","かみ"],["が"],["あなた"],["に対して","にたいして"],["唇","くちびる"],["を"],["開き","ひらき"],["何","なん"],["と"],["言われる","いわれる"],["か"],["聞きたい","ききたい"],["もの"],["だ"],["。"]]},{"verse":6,"text":"神が隠しておられるその知恵をその二重の効果をあなたに示されたならあなたの罪の一部を見逃していてくださったとあなたにも分かるだろう。","tok":[["神","かみ"],["が"],["隠して","かくして"],["おられる"],["その"],["知恵","ちえ"],["を"],["その"],["二","に"],["重","じゅう"],["の"],["効果","こうか"],["を"],["あなた"],["に"],["示されたなら","しめされたなら"],["あなた"],["の"],["罪","つみ"],["の"],["一部","いちぶ"],["を"],["見逃して","みのがして"],["いて"],["くださった"],["と"],["あなた"],["に"],["も"],["分かるだろう","わかるだろう"],["。"]]},{"verse":7,"text":"あなたは神を究めることができるか。全能者の極みまでも見ることができるか。","tok":[["あなた"],["は"],["神","かみ"],["を"],["究める","きわめる"],["こと"],["が"],["できる"],["か"],["。"],["全能者","ぜんのうしゃ"],["の"],["極み","きわみ"],["まで"],["も"],["見る","みる"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":8,"text":"高い天に対して何ができる。深い陰府について何が分かる。","tok":[["高い","たかい"],["天","てん"],["に対して","にたいして"],["何","なん"],["が"],["できる"],["。"],["深い","ふかい"],["陰府","よみ"],["について"],["何","なん"],["が"],["分かる","わかる"],["。"]]},{"verse":9,"text":"神は地の果てよりも遠く海
[{"verse":1,"text":"人は女から生まれ、人生は短く苦しみは絶えない。","tok":[["人","ひと"],["は"],["女","おんな"],["から"],["生まれ","うまれ"],["、"],["人生","じんせい"],["は"],["短く","みじかく"],["苦しみ","くるしみ"],["は"],["絶えない","たえない"],["。"]]},{"verse":2,"text":"花のように咲き出ては、しおれ影のように移ろい、永らえることはない。","tok":[["花","はな"],["の"],["よう"],["に"],["咲き出て","さきでて"],["は"],["、"],["しおれ"],["影","かげ"],["の"],["よう"],["に"],["移ろい","うつろい"],["、"],["永らえる","ながらえる"],["こと"],["は"],["ない"],["。"]]},{"verse":3,"text":"あなたが御目を開いて見ておられるのはこのような者なのです。このようなわたしをあなたに対して裁きの座に引き出されるのですか。","tok":[["あなた"],["が"],["御目","おめ"],["を"],["開いて","ひらいて"],["見て","みて"],["おられる"],["の"],["は"],["この"],["よう"],["な"],["者","もの"],["な"],["の"],["です"],["。"],["この"],["よう"],["な"],["わたし"],["を"],["あなた"],["に対して","にたいして"],["裁き","さばき"],["の"],["座","ざ"],["に"],["引き出される","ひきだされる"],["の"],["です"],["か"],["。"]]},{"verse":4,"text":"汚れたものから清いものを引き出すことができましょうか。だれひとりできないのです。","tok":[["汚れた","よごれた"],["もの"],["から"],["清い","きよい"],["もの"],["を"],["引き出す","ひきだす"],["こと"],["が"],["できましょう"],["か"],["。"],["だれ"],["ひとり"],["できない"],["の"],["です"],["。"]]},{"verse":5,"text":"人生はあなたが定められたとおり月日の数もあなた次第。あなたの決定されたことを人は侵せない。","tok":[["人生","じんせい"],["は"],["あなた"],["が"],["定められた","さだめられた"],["とおり"],["月日","つきひ"],["の"],["数","かず"],["も"],["あなた"],["次第","しだい"],["。"],["あなた"],["の"],["決定","けってい"],["された"],["こと"],["を"],["人","ひと"],["は"],["侵せない","おかせない"],["。"]]},{"verse":6,"text":"御目をこのような人間からそらせてください。彼の命は絶え傭兵のようにその日を喜ぶでしょう。","tok":[["御目","おめ"],["を"],["この"],["よう"],["な"],["人間","にんげん"],["から"],["そらせて"],["ください"],["。"],["彼","かれ"],["の"],["命","いのち"],["は"],["絶え","たえ"],["傭兵","ようへい"],["の"],["よう"],["に"],["その"],["日","ひ"],["を"],["喜ぶでしょう","よろこぶでしょう"],["。"]]},{"verse":7,"text":"木には希望がある、というように木は切られても、また新芽を吹き若枝の絶えることはない。","tok":[["木","き"],["に"],["は"],["希望","きぼう"],["が"],["ある"],["、"],["と"],["いう"],["よう"],["に"],["木","き"],["は"],["切られて","きられて"],["も"],["、"],["また"],["新芽","しんめ"],["を"],["吹き","ふき"],["若枝","わかえだ"],["の"],["絶える","たえる"],["こと"],["は"],["ない"],["。"]]},{"verse":8,"text":"地におろしたその根が老い幹が朽ちて、塵に返ろうとも","tok":[["地","ち"],["に"],["おろした"],["その"],["根","ね"],["が"],["老い","おい"],["幹","みき"],["が"],["朽ち
[{"verse":1,"text":"息は絶え、人生の日は尽きる。わたしには墓があるばかり。","tok":[["息","いき"],["は"],["絶え","たえ"],["、"],["人生","じんせい"],["の"],["日","ひ"],["は"],["尽きる","つきる"],["。"],["わたし"],["に"],["は"],["墓","はか"],["が"],["ある"],["ばかり"],["。"]]},{"verse":2,"text":"人々はなお、わたしを嘲りわたしの目は夜通し彼らの敵意を見ている。","tok":[["人々","ひとびと"],["は"],["なお"],["、"],["わたし"],["を"],["嘲り","あざけり"],["わたし"],["の"],["目","め"],["は"],["夜通し","よどおし"],["彼","かれ"],["ら"],["の"],["敵意","てきい"],["を"],["見て","みて"],["いる"],["。"]]},{"verse":3,"text":"あなた自ら保証人となってください。ほかの誰がわたしの味方をしてくれましょう。","tok":[["あなた"],["自ら","みずから"],["保証人","ほしょうにん"],["と"],["なって"],["ください"],["。"],["ほか"],["の"],["誰","だれ"],["が"],["わたし"],["の"],["味方","みかた"],["を"],["して"],["くれましょう"],["。"]]},{"verse":4,"text":"彼らの心を覆って目覚めることのないようにし彼らを高く上げないでください。","tok":[["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["覆って","おおって"],["目覚める","めざめる"],["こと"],["の"],["ない"],["よう"],["に"],["し"],["彼","かれ"],["ら"],["を"],["高く","たかく"],["上げないで","あげないで"],["ください"],["。"]]},{"verse":5,"text":"「利益のために友を裏切れば子孫の目がつぶれる。」","tok":[["「"],["利益","りえき"],["の"],["ため"],["に"],["友","とも"],["を"],["裏切れば","うらぎれば"],["子孫","しそん"],["の"],["目","め"],["が"],["つぶれる"],["。"],["」"]]},{"verse":6,"text":"この格言はわたしのことだと人は言う。わたしは顔につばきされる者。","tok":[["この"],["格言","かくげん"],["は"],["わたし"],["の"],["こと"],["だ"],["と"],["人","ひと"],["は"],["言う","ゆう"],["。"],["わたし"],["は"],["顔","かお"],["に"],["つばき"],["される"],["者","もの"],["。"]]},{"verse":7,"text":"目は苦悩にかすみ手足はどれも影のようだ。","tok":[["目","め"],["は"],["苦悩","くのう"],["に"],["かすみ"],["手足","てあし"],["は"],["どれ"],["も"],["影","かげ"],["の"],["よう"],["だ"],["。"]]},{"verse":8,"text":"正しい人よ、これに驚け。罪のない人よ神を無視する者に対して奮い立て。","tok":[["正しい","ただしい"],["人","ひと"],["よ"],["、"],["これ"],["に"],["驚け","おどろけ"],["。"],["罪","つみ"],["の"],["ない"],["人","ひと"],["よ"],["神","かみ"],["を"],["無視","むし"],["する"],["者","もの"],["に対して","にたいして"],["奮い立て","ふるいたて"],["。"]]},{"verse":9,"text":"神に従う人はその道を守り手の清い人は更に勇気をもて。","tok":[["神","かみ"],["に"],["従う","したがう"],["人","ひと"],["は"],["その"],["道","みち"],["を"],["守り手","まもりて"],["の"],["清い","きよい"],["人","ひと"],["は"],["更に","さらに"],["勇気","ゆうき"],["を"],["もて"],["。"]]},{"verse":10,"text":"あなたたちは皆、再び集まって来るがよい。あなたたちの中に知恵ある者はいないのか。","tok":[["あなた"],["たち"],["は"],["皆","みな"],["、"],["再び","ふたたび"],["集まって","あつまって"],["来る","くる"],["が"],["よい"],["。"],["あなた"],["たち"],["の"],["中","なか"],["に"],["知恵","ちえ"],["ある"],["者","もの"],["は"],["いない"],["の"],["か"],["。"]]},{"verse":11,"text":"わたしの人生は過ぎ去りわたしの計画も心の願いも失われた。","tok":[["わたし"],["の"],["人生","じんせい"],["は"],["過ぎ去り","すぎさり"],["わたし"],["の"],["計画","けいかく"],["も"],["心","こころ"],["の"],["願い","ねがい"],["も"],["失われた","うしなわれた"],["。"]]},{"verse":12,"text":"夜は昼となり暗黒の後に光が近づくと人は言うが","tok":[["夜","よる"],["は"],["昼","ひる"],["と"],["なり"],["暗黒","あんこく"],["の"],["後","あと"],["に"],["光","ひかり"],["が"],["近づく","ちかづく"],["と"],["人","ひと"],["は"],["言う","ゆう"],["が"]]},{"verse":13,"text":"わたしは陰府に自分のための家を求めその暗黒に寝床を整えた。","tok":[["わたし"],["は"],["陰府","よみ"],["に"],["自分","じぶん"],["の"],["ため"],["の"],["家","いえ"],["を"],["求め","もとめ"],["その"],["暗黒","あんこく"],["に"],["寝床","ねどこ"],["を"],["整えた","ととのえた"],["。"]]},{"verse":14,"text":"墓穴に向かって「あなたはわたしの父」と言い蛆虫に向かって「わたしの母、姉妹」と言う。","tok":[["墓穴","ぼけつ"],["に"],["向かって","むかって"],["「"],["あなた"],["は"],["わたし"],["の"],["父","ちち"],["」"],["と"],["言い","いい"],["蛆虫","うじむし"],["に"],["向かって","むかって"],["「"],["わたし"],["の"],["母","はは"],["、"],["姉妹","しまい"],["」"],["と"],["言う","ゆう"],["。"]]},{"verse":15,"text":"どこになお、わたしの希望があるのか。誰がわたしに希望を見せてくれるのか。","tok":[["どこ"],["に"],["なお"],["、"],["わたし"],["の"],["希望","きぼう"],["が"],["ある"],["の"],["か"],["。"],["誰","だれ"],["が"],["わたし"],["に"],["希望","きぼう"],["を"],["見せて","みせて"],["くれる"],["の"],["か"],["。"]]},{"verse":16,"text":"それはことごとく陰府に落ちた。すべては塵の上に横たわっている。","tok":[["それ"],["は"],["ことごとく"],["陰府","よみ"],["に"],["落ちた","おちた"],["。"],["すべて"],["は"],["塵","ごみ"],["の"],["上","うえ"],["に"],["横たわって","よこたわって"],["いる"],["。"]]}]
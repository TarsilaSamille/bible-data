[{"verse":1,"text":"シュア人ビルダドは答えた。","tok":[["シュア"],["人","にん"],["ビルダド"],["は"],["答えた","こたえた"],["。"]]},{"verse":2,"text":"恐るべき支配の力を神は御もとにそなえ天の最も高いところに平和を打ち立てられる。","tok":[["恐るべき","おそるべき"],["支配","しはい"],["の"],["力","ちから"],["を"],["神","かみ"],["は"],["御もと","おもと"],["に"],["そなえ"],["天","てん"],["の"],["最も","もっとも"],["高い","たかい"],["ところ"],["に"],["平和","へいわ"],["を"],["打ち立てられる","うちたてられる"],["。"]]},{"verse":3,"text":"まことにその軍勢は数限りなくその光はすべての人の上に昇る。","tok":[["まこと"],["に"],["その"],["軍勢","ぐんぜい"],["は"],["数","かず"],["限りなく","かぎりなく"],["その"],["光","ひかり"],["は"],["すべて"],["の"],["人","ひと"],["の"],["上","うえ"],["に"],["昇る","のぼる"],["。"]]},{"verse":4,"text":"どうして、人が神の前に正しくありえよう。どうして、女から生まれた者が清くありえよう。","tok":[["どう"],["して"],["、"],["人","ひと"],["が"],["神","かみ"],["の"],["前","まえ"],["に"],["正しく","ただしく"],["あり"],["えよう"],["。"],["どう"],["して"],["、"],["女","おんな"],["から"],["生まれた","うまれた"],["者","もの"],["が"],["清く","きよく"],["あり"],["えよう"],["。"]]},{"verse":5,"text":"月すらも神の前では輝かず星も神の目には清らかではない。","tok":[["月","つき"],["すら"],["も"],["神","かみ"],["の"],["前","まえ"],["で"],["は"],["輝かず","かがやかず"],["星","ほし"],["も"],["神","かみ"],["の"],["目","め"],["に"],["は"],["清らか","きよらか"],["で"],["は"],["ない"],["。"]]},{"verse":6,"text":"まして人間は蛆虫人の子は虫けらにすぎない。","tok":[["まして"],["人間","にんげん"],["は"],["蛆虫人","うじむしにん"],["の"],["子","こ"],["は"],["虫けら","むしけら"],["に"],["すぎない"],["。"]]}]
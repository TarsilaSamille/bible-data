[{"verse":1,"text":"見よ、ユダとエルサレムの繁栄を回復するその日、その時。","tok":[["見よ","みよ"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["繁栄","はんえい"],["を"],["回復","かいふく"],["する"],["その"],["日","ひ"],["、"],["その"],["時","とき"],["。"]]},{"verse":2,"text":"わたしは諸国の民を皆集めヨシャファト（主の裁き）の谷に連れて行きそこで、わたしは彼らを裁く。わたしの民、わたしの所有であるイスラエルを彼らは諸国の民の中に散らしわたしの土地を自分たちの間に分配したからだ。","tok":[["わたし"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["皆","みな"],["集め","あつめ"],["ヨシャファト"],["（"],["主","ぬし"],["の"],["裁き","さばき"],["）"],["の"],["谷","たに"],["に"],["連れて","つれて"],["行き","いき"],["そこ"],["で"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["裁く","さばく"],["。"],["わたし"],["の"],["民","たみ"],["、"],["わたし"],["の"],["所有","しょゆう"],["で"],["ある"],["イスラエル"],["を"],["彼","かれ"],["ら"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["散らし","ちらし"],["わたし"],["の"],["土地","とち"],["を"],["自分","じぶん"],["たち"],["の"],["間","あいだ"],["に"],["分配","ぶんぱい"],["した"],["から"],["だ"],["。"]]},{"verse":3,"text":"彼らはわたしの民の運命をくじで定め遊女を買うために少年を売り渡し酒を買うために少女を売った。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["の"],["運命","うんめい"],["を"],["くじ"],["で"],["定め","さだめ"],["遊女","ゆうじょ"],["を"],["買う","かう"],["ため"],["に"],["少年","しょうねん"],["を"],["売り渡し","うりわたし"],["酒","さけ"],["を"],["買う","かう"],["ため"],["に"],["少女","しょうじょ"],["を"],["売った","うった"],["。"]]},{"verse":4,"text":"ティルスとシドンよ、ペリシテの全土よお前たちはわたしにとって何であろうかわたしに復讐しようというのか。もし、お前たちがわたしに復讐するならわたしは直ちにお前たちの頭上に復讐を返す。","tok":[["ティルス"],["と"],["シドン"],["よ"],["、"],["ペリシテ"],["の"],["全土","ぜんど"],["よ"],["お前","おまえ"],["たち"],["は"],["わたし"],["にとって"],["何","なん"],["で"],["あろう"],["か"],["わたし"],["に"],["復讐","ふくしゅう"],["しよう"],["と"],["いう"],["の"],["か"],["。"],["もし"],["、"],["お前","おまえ"],["たち"],["が"],["わたし"],["に"],["復讐","ふくしゅう"],["するなら"],["わたし"],["は"],["直ちに","ただちに"],["お前","おまえ"],["たち"],["の"],["頭上","ずじょう"],["に"],["復讐","ふくしゅう"],["を"],["返す","かえす"],["。"]]},{"verse":5,"text":"お前たちは、わたしの銀と金を奪い貴重な宝をお前たちの神殿に運び去った。","tok":[["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["の"],["銀","ぎん"],["と"],["金","かね"],["を"],["奪い","うばい"],["貴重","きちょう"],["な"],["宝","たから"],["を"],["お前","おまえ"],["たち"],["の"],["神殿","しんでん"],["に"],["運び去った","はこびさった"],["。"]]},{"verse":6,"text":"ユダとエルサレムの人々をギリシア人に売り自分の国から遠く引き離した。","tok":[["ユダ"],["と"],["エルサレム"],["の"],["人々","ひとびと"],["を"],["ギリシア"],["人","にん"],["に"],["売り","うり"],["自分","じぶん"],["の"],["国","くに"],["から"],["遠く","とおく"],["引き離した","ひきはなした"],["。"]]},{"verse":7,"text":"見よ、お前たちが彼らを売ったその所からわたしは彼らを呼び戻しお前たちの頭上に復讐を返す。","tok":[["見よ","みよ"],["、"],["お前","おまえ"],["たち"],["が"],["彼","かれ"],["ら"],["を"],["売った","うった"],["その"],["所","ところ"],["から"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["呼び戻し","よびもどし"],["お前","おまえ"],["たち"],["の"],["頭上","ずじょう"],["に"],["復讐","ふくしゅう"],["を"],["返す","かえす"],["。"]]},{"verse":8,"text":"わたしは、お前たちの息子、娘をユダの人々の手に渡す。ユダの人々は、彼らを遠くシェバ人に売ると主が語られた。","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["を"],["ユダ"],["の"],["人々","ひとびと"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["ら"],["を"],["遠く","とおく"],["シェバ人","しぇばにん"],["に"],["売る","うる"],["と"],["主","ぬし"],["が"],["語られた","かたられた"],["。"]]},{"verse":9,"text":"諸国の民にこう呼ばわり、戦いを布告せよ。勇士を奮い立たせ兵士をことごとく集めて上らせよ。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["に"],["こう"],["呼ばわり","よばわり"],["、"],["戦い","たたかい"],["を"],["布告","ふこく"],["せよ"],["。"],["勇士","ゆうし"],["を"],["奮い立たせ","ふるいたたせ"],["兵士","へいし"],["を"],["ことごとく"],["集めて","あつめて"],["上らせ","のぼらせ"],["よ"],["。"]]},{"verse":10,"text":"お前たちの鋤を剣に、鎌を槍に打ち直せ。弱い者も、わたしは勇士だと言え。","tok":[["お前","おまえ"],["たち"],["の"],["鋤","すき"],["を"],["剣","けん"],["に"],["、"],["鎌","かま"],["を"],["槍","やり"],["に"],["打ち直せ","うちなおせ"],["。"],["弱い","よわい"],["者","もの"],["も"],["、"],["わたし"],["は"],["勇士","ゆうし"],["だ"],["と"],["言え","いえ"],["。"]]},{"verse":11,"text":"諸国の民は皆、周囲から集まり急いで来るがよい。――主よ、あなたの勇士を遣わしてください。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["は"],["皆","みな"],["、"],["周囲","しゅうい"],["から"],["集まり","あつまり"],["急いで","いそいで"],["来る","くる"],["が"],["よい"],["。"],["―"],["―"],["主","ぬし"],["よ"],["、"],["あなた"],["の"],["勇士","ゆうし"],["を"],["遣わして","つかわして"],["ください"],["。"]]},{"verse":12,"text":"諸国の民が奮い立ちヨシャファトの谷に上って来るとわたしはそこに座を設け周囲のすべての民を裁く。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["が"],["奮い立ち","ふるいたち"],["ヨシャファト"],["の"],["谷","たに"],["に"],["上って",
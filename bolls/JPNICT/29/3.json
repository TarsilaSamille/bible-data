[{"verse":1,"text":"その後わたしはすべての人にわが霊を注ぐ。あなたたちの息子や娘は預言し老人は夢を見、若者は幻を見る。","tok":[["その後","そのあと"],["わたし"],["は"],["すべて"],["の"],["人","ひと"],["に"],["わが"],["霊","れい"],["を"],["注ぐ","そそぐ"],["。"],["あなた"],["たち"],["の"],["息子","むすこ"],["や"],["娘","むすめ"],["は"],["預言","よげん"],["し"],["老人","ろうじん"],["は"],["夢","ゆめ"],["を"],["見","み"],["、"],["若者","わかもの"],["は"],["幻","まぼろし"],["を"],["見る","みる"],["。"]]},{"verse":2,"text":"その日、わたしは奴隷となっている男女にもわが霊を注ぐ。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["奴隷","どれい"],["と"],["なって"],["いる"],["男女","だんじょ"],["に"],["も"],["わが"],["霊","れい"],["を"],["注ぐ","そそぐ"],["。"]]},{"verse":3,"text":"天と地に、しるしを示す。それは、血と火と煙の柱である。","tok":[["天","てん"],["と"],["地","ち"],["に"],["、"],["しるし"],["を"],["示す","しめす"],["。"],["それ"],["は"],["、"],["血","ち"],["と"],["火","ひ"],["と"],["煙","けむり"],["の"],["柱","はしら"],["で"],["ある"],["。"]]},{"verse":4,"text":"主の日、大いなる恐るべき日が来る前に太陽は闇に、月は血に変わる。","tok":[["主","ぬし"],["の"],["日","ひ"],["、"],["大いなる","おおいなる"],["恐るべき","おそるべき"],["日","ひ"],["が"],["来る","くる"],["前","まえ"],["に"],["太陽","たいよう"],["は"],["闇","やみ"],["に"],["、"],["月","つき"],["は"],["血","ち"],["に"],["変わる","かわる"],["。"]]},{"verse":5,"text":"しかし、主の御名を呼ぶ者は皆、救われる。主が言われたようにシオンの山、エルサレムには逃れ場があり主が呼ばれる残りの者はそこにいる。","tok":[["しかし"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["呼ぶ","よぶ"],["者","もの"],["は"],["皆","みな"],["、"],["救われる","すくわれる"],["。"],["主","ぬし"],["が"],["言われた","いわれた"],["よう"],["に"],["シオン"],["の"],["山","やま"],["、"],["エルサレム"],["に"],["は"],["逃れ","のがれ"],["場","ば"],["が"],["あり"],["主","ぬし"],["が"],["呼ばれる","よばれる"],["残り","のこり"],["の"],["者","もの"],["は"],["そこ"],["に"],["いる"],["。"]]}]
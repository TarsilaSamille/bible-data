[{"verse":1,"text":"パウロ、シルワノ、テモテから、父である神と主イエス‧キリストとに結ばれているテサロニケの教会へ。恵みと平和が、あなたがたにあるように。","tok":[["パウロ"],["、"],["シルワノ"],["、"],["テモテ"],["から"],["、"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["と"],["に"],["結ばれて","むすばれて"],["いる"],["テサロニケ"],["の"],["教会","きょうかい"],["へ"],["。"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":2,"text":"わたしたちは、祈りの度に、あなたがたのことを思い起こして、あなたがた一同のことをいつも神に感謝しています。","tok":[["わたしたち"],["は"],["、"],["祈り","いのり"],["の"],["度","ど"],["に"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["思い起こして","おもいおこして"],["、"],["あなた"],["がた"],["一同","いちどう"],["の"],["こと"],["を"],["いつも"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":3,"text":"あなたがたが信仰によって働き、愛のために労苦し、また、わたしたちの主イエス‧キリストに対する、希望を持って忍耐していることを、わたしたちは絶えず父である神の御前で心に留めているのです。","tok":[["あなた"],["がた"],["が"],["信仰","しんこう"],["によって"],["働き","はたらき"],["、"],["愛","あい"],["の"],["ため"],["に"],["労苦","ろうく"],["し"],["、"],["また"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["に"],["対する","たいする"],["、"],["希望","きぼう"],["を"],["持って","もって"],["忍耐","にんたい"],["して"],["いる"],["こと"],["を"],["、"],["わたしたち"],["は"],["絶えず","たえず"],["父","ちち"],["で"],["ある"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["心","こころ"],["に"],["留めて","とめて"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"神に愛されている兄弟たち、あなたがたが神から選ばれたことを、わたしたちは知っています。","tok":[["神","かみ"],["に"],["愛されて","あいされて"],["いる"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["が"],["神","かみ"],["から"],["選ばれた","えらばれた"],["こと"],["を"],["、"],["わたしたち"],["は"],["知って","しって"],["います"],["。"]]},{"verse":5,"text":"わたしたちの福音があなたがたに伝えられたのは、ただ言葉だけによらず、力と、聖霊と、強い確信とによったからです。わたしたちがあなたがたのところで、どのようにあなたがたのために働いたかは、御承知のとおりです。","tok":[["わたしたち"],["の"],["福音","ふくいん"],["が"],["あなた"],["がた"],["に"],["伝えられた","つたえられた"],["の"],["は"],["、"],["ただ"],["言葉","ことば"],["だけ"],["に"],["よらず"],["、"],["力","ちから"],["と"],["、"],["聖霊","せいれい"],["と"],["、"],["強い","つよい"],["確信","かくしん"],["と"],["に"],["よった"],["から"],["です"],["。"],["わたしたち"],["が"],["あなた"],["がた"],["の"],["ところ"],["で"],["、"],["どの"],["よう"],["に"],["あなた"],["がた"],["の"],["ため"],["に"],["働いた","はたらいた"],["か"],["は"],["、"],["御承知","ごしょうち"],["の"],["とおり"],["です"],["。"]]},{"verse":6,"text":"そして、あなたがたはひどい苦しみの中で、聖霊による喜びをもって御言葉を受け入れ、わたしたちに倣う者、そして主に倣う者となり、","tok":[["そして"],["、"],["あなた"],["がた"],["は"],["ひどい"],["苦しみ","くるしみ"],["の"],["中","なか"],["で"],["、"],["聖霊","せいれい"],["に"],["よる"],["喜び","よろこび"],["を"],["もって"],["御言葉","おことば"],["を"],["受け入れ","うけいれ"],["、"],["わたしたち"],["に"],["倣う","ならう"],["者","もの"],["、"],["そして"],["主に","おもに"],["倣う","ならう"],["者","もの"],["と"],["なり"],["、"]]},{"verse":7,"text":"マケドニア州とアカイア州にいるすべての信者の模範となるに至ったのです。","tok":[["マケドニア"],["州","しゅう"],["と"],["アカイア"],["州","しゅう"],["に"],["いる"],["すべて"],["の"],["信者","しんじゃ"],["の"],["模範","もはん"],["と"],["なる"],["に"],["至った","いたった"],["の"],["です"],["。"]]},{"verse":8,"text":"主の言葉があなたがたのところから出て、マケドニア州やアカイア州に響き渡ったばかりでなく、神に対するあなたがたの信仰が至るところで伝えられているので、何も付け加えて言う必要はないほどです。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["あなた"],["がた"],["の"],["ところ"],["から"],["出て","でて"],["、"],["マケドニア"],["州","しゅう"],["や"],["アカイア"],["州","しゅう"],["に"],["響き","ひびき"],["渡った","わたった"],["ばかり"],["で"],["なく"],["、"],["神","かみ"],["に"],["対する","たいする"],["あなた"],["がた"],["の"],["信仰","しんこう"],["が"],["至る","いたる"],["ところ"],["で"],["伝えられて","つたえられて"],["いる"],["ので"],["、"],["何","なん"],["も"],["付け加えて","つけくわえて"],["言う","いう"],["必要","ひつよう"],["は"],["ない"],["ほど"],["です"],["。"]]},{"verse":9,"text":"彼ら自身がわたしたちについて言い広めているからです。すなわち、わたしたちがあなたがたのところでどのように迎えられたか、また、あなたがたがどのように偶像から離れて神に立ち帰り、生けるまことの神に仕えるようになったか、","tok":[["彼","かれ"],["ら"],["自身","じしん"],["が"],["わたしたち"],["について"],["言い広めて","いいひろめて"],["いる"],["から"],["です"],["。"],["すなわち"],["、"],["わたしたち"],["が"],["あなた"],["がた"],["の"],["ところ"],["で"],["どの"],["よう"],["に"],["迎えられた","むかえられた"],["か"],["、"],["また"],["、"],["あなた"],["がた"],["が"],["どの"],["よう"],["に"],["偶像","ぐうぞう"],["から"],["離れて","はなれて"],["神","かみ"],["に"],["立ち帰り","たちかえり"],["、"],["生ける","いける"],["まこと"],["の"],["神","かみ"],["に"],["仕える","つかえる"],["よう"],["に"],["なった"],["か"],["、"]]},{"verse":10,"text":"更にまた、どのように御子が天から来られるのを待ち望むようになったかを。この御子こそ、神が死者の中から復活させた方で、来るべき怒りからわたしたちを救ってくださるイエスです。","tok":[["更に","さらに"],["また"],["、"],["どの"],["よう"],["に"],["御子","みこ"],["が"],["天","てん"],["から"],["来られる","こられる"],["の"],["を"],["待ち望む","まちのぞむ"],["よう"],["に"],["なった"],["か"],["を"],["。"],["この"],["御子","みこ"],["こそ"],["、"],["神","かみ"],["が"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させた"],["方","ほう"],["で"],["、"],["来るべき","きたるべき"],["怒り","いかり"],["から"],["わたしたち"],["を"],["救って","すくって"],["くださる"],["イエス"],["です"],["。"]]}]
[{"verse":1,"text":"そこで、もはや我慢できず、わたしたちだけがアテネに残ることにし、","tok":[["そこ"],["で"],["、"],["もはや"],["我慢","がまん"],["できず"],["、"],["わたしたち"],["だけ"],["が"],["アテネ"],["に"],["残る","のこる"],["こと"],["に"],["し"],["、"]]},{"verse":2,"text":"わたしたちの兄弟で、キリストの福音のために働く神の協力者テモテをそちらに派遣しました。それは、あなたがたを励まして、信仰を強め、","tok":[["わたしたち"],["の"],["兄弟","きょうだい"],["で"],["、"],["キリスト"],["の"],["福音","ふくいん"],["の"],["ため"],["に"],["働く","はたらく"],["神","かみ"],["の"],["協力者","きょうりょくしゃ"],["テモテ"],["を"],["そちら"],["に"],["派遣","はけん"],["しました"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["を"],["励まして","はげまして"],["、"],["信仰","しんこう"],["を"],["強め","つよめ"],["、"]]},{"verse":3,"text":"このような苦難に遭っていても、だれ一人動揺することのないようにするためでした。わたしたちが苦難を受けるように定められていることは、あなたがた自身がよく知っています。","tok":[["この"],["よう"],["な"],["苦難","くなん"],["に"],["遭って","あって"],["いて"],["も"],["、"],["だれ"],["一人","ひとり"],["動揺","どうよう"],["する"],["こと"],["の"],["ない"],["よう"],["に"],["する"],["ため"],["でした"],["。"],["わたしたち"],["が"],["苦難","くなん"],["を"],["受ける","うける"],["よう"],["に"],["定められて","さだめられて"],["いる"],["こと"],["は"],["、"],["あなた"],["がた"],["自身","じしん"],["が"],["よく"],["知って","しって"],["います"],["。"]]},{"verse":4,"text":"あなたがたのもとにいたとき、わたしたちがやがて苦難に遭うことを、何度も予告しましたが、あなたがたも知っているように、事実そのとおりになりました。","tok":[["あなた"],["がた"],["の"],["もと"],["に"],["いた"],["とき"],["、"],["わたしたち"],["が"],["やがて"],["苦難","くなん"],["に"],["遭う","あう"],["こと"],["を"],["、"],["何度","なんど"],["も"],["予告","よこく"],["しました"],["が"],["、"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["よう"],["に"],["、"],["事実","じじつ"],["その"],["とおり"],["に"],["なりました"],["。"]]},{"verse":5,"text":"そこで、わたしも、もはやじっとしていられなくなって、誘惑する者があなたがたを惑わし、わたしたちの労苦が無駄になってしまうのではないかという心配から、あなたがたの信仰の様子を知るために、テモテを派遣したのです。","tok":[["そこ"],["で"],["、"],["わたし"],["も"],["、"],["もはや"],["じっと"],["して"],["いられなく"],["なって"],["、"],["誘惑","ゆうわく"],["する"],["者","もの"],["が"],["あなた"],["がた"],["を"],["惑わし","まどわし"],["、"],["わたしたち"],["の"],["労苦","ろうく"],["が"],["無駄","むだ"],["に"],["なって"],["しまう"],["ので"],["は"],["ない"],["か"],["と"],["いう"],["心配","しんぱい"],["から"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["の"],["様子","ようす"],["を"],["知る","しる"],["ため"],["に"],["、"],["テモテ"],["を"],["派遣","はけん"],["した"],["の"],["です"],["。"]]},{"verse":6,"text":"ところで、テモテがそちらからわたしたちのもとに今帰って来て、あなたがたの信仰と愛について、うれしい知らせを伝えてくれました。また、あなたがたがいつも好意をもってわたしたちを覚えていてくれること、更に、わたしたちがあなたがたにぜひ会いたいと望んでいるように、あなたがたもわたしたちにしきりに会いたがっていることを知らせてくれました。","tok":[["ところ"],["で"],["、"],["テモテ"],["が"],["そちら"],["から"],["わたしたち"],["の"],["もと"],["に"],["今","いま"],["帰って","かえって"],["来て","きて"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["と"],["愛","あい"],["について"],["、"],["うれしい"],["知らせ","しらせ"],["を"],["伝えて","つたえて"],["くれました"],["。"],["また"],["、"],["あなた"],["がた"],["が"],["いつも"],["好意","こうい"],["を"],["もって"],["わたしたち"],["を"],["覚えて","おぼえて"],["いて"],["くれる"],["こと"],["、"],["更に","さらに"],["、"],["わたしたち"],["が"],["あなた"],["がた"],["に"],["ぜひ"],["会いたい","あいたい"],["と"],["望んで","のぞんで"],["いる"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["わたしたち"],["に"],["しきり"],["に"],["会いたがって","あいたがって"],["いる"],["こと"],["を"],["知らせて","しらせて"],["くれました"],["。"]]},{"verse":7,"text":"それで、兄弟たち、わたしたちは、あらゆる困難と苦難に直面しながらも、あなたがたの信仰によって励まされました。","tok":[["それ"],["で"],["、"],["兄弟","きょうだい"],["たち"],["、"],["わたしたち"],["は"],["、"],["あらゆる"],["困難","こんなん"],["と"],["苦難","くなん"],["に"],["直面","ちょくめん"],["し"],["ながら"],["も"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["によって"],["励まされました","はげまされました"],["。"]]},{"verse":8,"text":"あなたがたが主にしっかりと結ばれているなら、今、わたしたちは生きていると言えるからです。","tok":[["あなた"],["がた"],["が"],["主に","おもに"],["しっかり"],["と"],["結ばれて","むすばれて"],["いるなら"],["、"],["今","いま"],["、"],["わたしたち"],["は"],["生きて","いきて"],["いる"],["と"],["言える","いえる"],["から"],["です"],["。"]]},{"verse":9,"text":"わたしたちは、神の御前で、あなたがたのことで喜びにあふれています。この大きな喜びに対して、どのような感謝を神にささげたらよいでしょうか。","tok":[["わたしたち"],["は"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["あなた"],["がた"],["の"],["こと"],["で"],["喜び","よろこび"],["に"],["あふれて"],["います"],["。"],["この"],["大きな","おおきな"],["喜び","よろこび"],["に対して","にたいして"],["、"],["どのような"],["感謝","かんしゃ"],["を"],["神","かみ"],["に"],["ささげたら"],["よいでしょう"],["か"],["。"]]},{"verse":10,"text":"顔を合わせて、あなたがたの信仰に必要なものを補いたいと、夜も昼も切に祈っています。","tok":[["顔","かお"],["を"],["合わせて","あわせて"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["に"],["必要","ひつよう"],["な"],["もの"],["を"],["補いたい","おぎないたい"],["と"],["、"],["夜","よる"],["も"],["昼","ひる"],["も"],["切に","せつに"],["祈って","いのって"],["います"],["。"]]},{"verse":11,"text":"どうか、わたしたちの父である神御自身とわたしたちの主イエスとが、わたしたちにそちらへ行く道を開いてくださいますように。","tok":[["どう"],["か"],["、"],["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["御自身","ごじしん"],["と"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["と"],["が"],["、"],["わたしたち"],["に"],["そちら"],["へ"],["行く","いく"],["道","みち"],["を"],["開いて","ひらいて"],["くださいます"],["よう"],["に"],["。"]]},{"verse":12,"text":"どうか、主があなたがたを、お互いの愛とすべての人への愛とで、豊かに満ちあふれさせてくださいますように、わたしたちがあなたがたを愛しているように。","tok":[["どう"],["か"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["を"],["、"],["お互い","おたがい"],["の"],["愛","あい"],["と"],["すべて"],["の"],["人","ひと"],["へ"],["の"],["愛","あい"],["と"],["で"],["、"],["豊か","ゆたか"],["に"],["満ちあふれさせて","みちあふれさせて"],["くださいます"],["よう"],["に"],["、"],["わたしたち"],["が"],["あなた"],["がた"],["を"],["愛して","あいして"],["いる"],["よう"],["に"],["。"]]},{"verse":13,"text":"そして、わたしたちの主イエスが、御自身に属するすべての聖なる者たちと共に来られるとき、あなたがたの心を強め、わたしたちの父である神の御前で、聖なる、非のうちどころのない者としてくださるように、アーメン。","tok":[["そして"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["が"],["、"],["御自身","ごじしん"],["に"],["属する","ぞくする"],["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["たち"],["と"],["共","とも"],["に"],["来られる","こられる"],["とき"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["強め","つよめ"],["、"],["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["聖","せい"],["なる"],["、"],["非","ひ"],["の"],["うち"],["どころ"],["の"],["ない"],["者","もの"],["として"],["くださる"],["よう"],["に"],["、"],["アーメン"],["。"]]}]
[{"verse":1,"text":"兄弟たち、その時と時期についてあなたがたには書き記す必要はありません。","tok":[["兄弟","きょうだい"],["たち"],["、"],["その"],["時","とき"],["と"],["時期","じき"],["について"],["あなた"],["がた"],["に"],["は"],["書き記す","かきしるす"],["必要","ひつよう"],["は"],["ありません"],["。"]]},{"verse":2,"text":"盗人が夜やって来るように、主の日は来るということを、あなたがた自身よく知っているからです。","tok":[["盗人","ぬすびと"],["が"],["夜","よる"],["やって"],["来る","くる"],["よう"],["に"],["、"],["主","ぬし"],["の"],["日","ひ"],["は"],["来る","くる"],["と"],["いう"],["こと"],["を"],["、"],["あなた"],["がた"],["自身","じしん"],["よく"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":3,"text":"人々が「無事だ。安全だ」と言っているそのやさきに、突然、破滅が襲うのです。ちょうど妊婦に産みの苦しみがやって来るのと同じで、決してそれから逃れられません。","tok":[["人々","ひとびと"],["が"],["「"],["無事","ぶじ"],["だ"],["。"],["安全","あんぜん"],["だ"],["」"],["と"],["言って","いって"],["いる"],["その"],["やさき"],["に"],["、"],["突然","とつぜん"],["、"],["破滅","はめつ"],["が"],["襲う","おそう"],["の"],["です"],["。"],["ちょうど"],["妊婦","にんぷ"],["に"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["が"],["やって"],["来る","くる"],["の"],["と"],["同じ","おなじ"],["で"],["、"],["決して","けっして"],["それ"],["から"],["逃れられません","のがれられません"],["。"]]},{"verse":4,"text":"しかし、兄弟たち、あなたがたは暗闇の中にいるのではありません。ですから、主の日が、盗人のように突然あなたがたを襲うことはないのです。","tok":[["しかし"],["、"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["は"],["暗闇","くらやみ"],["の"],["中","なか"],["に"],["いる"],["ので"],["は"],["ありません"],["。"],["です"],["から"],["、"],["主","ぬし"],["の"],["日","ひ"],["が"],["、"],["盗人","ぬすびと"],["の"],["よう"],["に"],["突然","とつぜん"],["あなた"],["がた"],["を"],["襲う","おそう"],["こと"],["は"],["ない"],["の"],["です"],["。"]]},{"verse":5,"text":"あなたがたはすべて光の子、昼の子だからです。わたしたちは、夜にも暗闇にも属していません。","tok":[["あなた"],["がた"],["は"],["すべて"],["光","ひかり"],["の"],["子","こ"],["、"],["昼","ひる"],["の"],["子","こ"],["だ"],["から"],["です"],["。"],["わたしたち"],["は"],["、"],["夜","よる"],["に"],["も"],["暗闇","くらやみ"],["に"],["も"],["属して","ぞくして"],["いません"],["。"]]},{"verse":6,"text":"従って、ほかの人々のように眠っていないで、目を覚まし、身を慎んでいましょう。","tok":[["従って","したがって"],["、"],["ほか"],["の"],["人々","ひとびと"],["の"],["よう"],["に"],["眠って","ねむって"],["いないで"],["、"],["目","め"],["を"],["覚まし","さまし"],["、"],["身","み"],["を"],["慎んで","つつしんで"],["いましょう"],["。"]]},{"verse":7,"text":"眠る者は夜眠り、酒に酔う者は夜酔います。",
[{"verse":1,"text":"兄弟たち、あなたがた自身が知っているように、わたしたちがそちらへ行ったことは無駄ではありませんでした。","tok":[["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["自身","じしん"],["が"],["知って","しって"],["いる"],["よう"],["に"],["、"],["わたしたち"],["が"],["そちら"],["へ"],["行った","いった"],["こと"],["は"],["無駄","むだ"],["で"],["は"],["ありませんでした"],["。"]]},{"verse":2,"text":"無駄ではなかったどころか、知ってのとおり、わたしたちは以前フィリピで苦しめられ、辱められたけれども、わたしたちの神に勇気づけられ、激しい苦闘の中であなたがたに神の福音を語ったのでした。","tok":[["無駄","むだ"],["で"],["は"],["なかった"],["どころ"],["か"],["、"],["知って","しって"],["の"],["とおり"],["、"],["わたしたち"],["は"],["以前","いぜん"],["フィリピ"],["で"],["苦しめられ","くるしめられ"],["、"],["辱められた","はずかしめられた"],["けれど"],["も"],["、"],["わたしたち"],["の"],["神","かみ"],["に"],["勇気","ゆうき"],["づけられ"],["、"],["激しい","はげしい"],["苦闘","くとう"],["の"],["中","なか"],["で"],["あなた"],["がた"],["に"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["語った","かたった"],["の"],["でした"],["。"]]},{"verse":3,"text":"わたしたちの宣教は、迷いや不純な動機に基づくものでも、また、ごまかしによるものでもありません。","tok":[["わたしたち"],["の"],["宣教","せんきょう"],["は"],["、"],["迷い","まよい"],["や"],["不純","ふじゅん"],["な"],["動機","どうき"],["に"],["基づく","もとづく"],["もの"],["で"],["も"],["、"],["また"],["、"],["ごまかし"],["に"],["よる"],["もの"],["で"],["も"],["ありません"],["。"]]},{"verse":4,"text":"わたしたちは神に認められ、福音をゆだねられているからこそ、このように語っています。人に喜ばれるためではなく、わたしたちの心を吟味される神に喜んでいただくためです。","tok":[["わたしたち"],["は"],["神","かみ"],["に"],["認められ","みとめられ"],["、"],["福音","ふくいん"],["を"],["ゆだねられて"],["いる"],["から"],["こそ"],["、"],["この"],["よう"],["に"],["語って","かたって"],["います"],["。"],["人","ひと"],["に"],["喜ばれる","よろこばれる"],["ため"],["で"],["は"],["なく"],["、"],["わたしたち"],["の"],["心","こころ"],["を"],["吟味","ぎんみ"],["される"],["神","かみ"],["に"],["喜んで","よろこんで"],["いただく"],["ため"],["です"],["。"]]},{"verse":5,"text":"あなたがたが知っているとおり、わたしたちは、相手にへつらったり、口実を設けてかすめ取ったりはしませんでした。そのことについては、神が証ししてくださいます。","tok":[["あなた"],["がた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["わたしたち"],["は"],["、"],["相手","あいて"],["に"],["へつらっ"],["たり"],["、"],["口実","こうじつ"],["を"],["設けて","もうけて"],["かすめ取っ","かすめとっ"],["たり"],["は"],["しませんでした"],["。"],["その"],["こと"],["について"],["は"],["、"],["神","かみ"],["が"],["証し","あかし"],["して"],["くださいます"],["。"]]},{"verse":6,"text":"また、あなたがたからもほかの人たちからも、人間の誉れを求めませんでした。","tok":[["また"],["、"],["あなた"],["がた"],["から"],["も"],["ほか"],["の"],["人","ひと"],["たち"],["から"],["も"],["、"],["人間","にんげん"],["の"],["誉れ","ほまれ"],["を"],["求めませんでした","もとめませんでした"],["。"]]},{"verse":7,"text":"わたしたちは、キリストの使徒として権威を主張することができたのです。しかし、あなたがたの間で幼子のようになりました。ちょうど母親がその子供を大事に育てるように、","tok":[["わたしたち"],["は"],["、"],["キリスト"],["の"],["使徒","しと"],["として"],["権威","けんい"],["を"],["主張","しゅちょう"],["する"],["こと"],["が"],["できた"],["の"],["です"],["。"],["しかし"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["幼子","おさなご"],["の"],["よう"],["に"],["なりました"],["。"],["ちょうど"],["母親","ははおや"],["が"],["その"],["子供","こども"],["を"],["大事","だいじ"],["に"],["育てる","そだてる"],["よう"],["に"],["、"]]},{"verse":8,"text":"わたしたちはあなたがたをいとおしく思っていたので、神の福音を伝えるばかりでなく、自分の命さえ喜んで与えたいと願ったほどです。あなたがたはわたしたちにとって愛する者となったからです。","tok":[["わたしたち"],["は"],["あなた"],["がた"],["を"],["いとおしく"],["思って","おもって"],["いた"],["ので"],["、"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["伝える","つたえる"],["ばかり"],["で"],["なく"],["、"],["自分","じぶん"],["の"],["命","いのち"],["さえ"],["喜んで","よろこんで"],["与えたい","あたえたい"],["と"],["願った","ねがった"],["ほど"],["です"],["。"],["あなた"],["がた"],["は"],["わたしたち"],["にとって"],["愛する","あいする"],["者","もの"],["と"],["なった"],["から"],["です"],["。"]]},{"verse":9,"text":"兄弟たち、わたしたちの労苦と骨折りを覚えているでしょう。わたしたちは、だれにも負担をかけまいとして、夜も昼も働きながら、神の福音をあなたがたに宣べ伝えたのでした。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたしたち"],["の"],["労苦","ろうく"],["と"],["骨折り","ほねおり"],["を"],["覚えて","おぼえて"],["いるでしょう"],["。"],["わたしたち"],["は"],["、"],["だれ"],["に"],["も"],["負担","ふたん"],["を"],["かけまい"],["として"],["、"],["夜","よる"],["も"],["昼","ひる"],["も"],["働き","はたらき"],["ながら"],["、"],["神","かみ"],["の"],["福音","ふくいん"],["を"],["あなた"],["がた"],["に"],["宣べ伝えた","のべつたえた"],["の"],["でした"],["。"]]},{"verse":10,"text":"あなたがた信者に対して、わたしたちがどれほど敬虔に、正しく、非難されることのないようにふるまったか、あなたがたが証しし、神も証ししてくださいます。","tok":[["あなた"],["がた"],["信者","しんじゃ"],["に対して","にたいして"],["、"],["わたしたち"],["が"],["どれ"],["ほど"],["敬虔","けいけん"],["に"],["、"],["正しく","ただしく"],["、"],["非難","ひなん"],["される"],["こと"],["の"],["ない"],["よう"],["に"],["ふるまった"],["か"],["、"],["あなた"],["がた"],["が"],["証し","しょうし"],["し"],["、"],["神","かみ"],["も"],["証し","あかし"],["して"],["くださいます"],["。"]]},{"verse":11,"text":"あなたがたが知っているとおり、わたしたちは、父親がその子供に対するように、あなたがた一人一人に","tok":[["あなた"],["がた"],["が"],["知って","しって"],["いる"],["とおり"],["、"],["わたしたち"],["は"],["、"],["父親","ちちおや"],["が"],["その"],["子供","こども"],["に"],["対する","たいする"],["よう"],["に"],["、"],["あなた"],["がた"],["一人一人","ひとりひとり"],["に"]]},{"verse":12,"text":"呼びかけて、神の御心にそって歩むように励まし、慰め、強く勧めたのでした。御自身の国と栄光にあずからせようと、神はあなたがたを招いておられます。","tok":[["呼びかけて","よびかけて"],["、"],["神","かみ"],["の"],["御心","おこころ"],["に"],["そって"],["歩む","あゆむ"],["よう"],["に"],["励まし","はげまし"],["、"],["慰め","なぐさめ"],["、"],["強く","つよく"],["勧めた","すすめた"],["の"],["でした"],["。"],["御自身","ごじしん"],["の"],["国","くに"],["と"],["栄光","えいこう"],["に"],["あずからせよう"],["と"],["、"],["神","かみ"],["は"],["あなた"],["がた"],["を"],["招いて","まねいて"],["おられます"],["。"]]},{"verse":13,"text":"このようなわけで、わたしたちは絶えず神に感謝しています。なぜなら、わたしたちから神の言葉を聞いたとき、あなたがたは、それを人の言葉としてではなく、神の言葉として受け入れたからです。事実、それは神の言葉であり、また、信じているあなたがたの中に現に働いているものです。","tok":[["この"],["よう"],["な"],["わけ"],["で"],["、"],["わたしたち"],["は"],["絶えず","たえず"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["います"],["。"],["なぜ"],["なら"],["、"],["わたしたち"],["から"],["神","かみ"],["の"],["言葉","ことば"],["を"],["聞いた","きいた"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["それ"],["を"],["人","ひと"],["の"],["言葉","ことば"],["として"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["言葉","ことば"],["として"],["受け入れた","うけいれた"],["から"],["です"],["。"],["事実","じじつ"],["、"],["それ"],["は"],["神","かみ"],["の"],["言葉","ことば"],["で"],["あり"],["、"],["また"],["、"],["信じて","しんじて"],["いる"],["あなた"],["がた"],["の"],["中","なか"],["に"],["現に","げんに"],["働いて","はたらいて"],["いる"],["もの"],["です"],["。"]]},{"verse":14,"text":"兄弟たち、あなたがたは、ユダヤの、キリスト‧イエスに結ばれている神の諸教会に倣う者となりました。彼らがユダヤ人たちから苦しめられたように、あなたがたもまた同胞から苦しめられたからです。","tok":[["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["は"],["、"],["ユダヤ"],["の"],["、"],["キリスト"],["‧"],["イエス"],["に"],["結ばれて","むすばれて"],["いる"],["神","かみ"],["の"],["諸教","しょきょう"],["会","かい"],["に"],["倣う","ならう"],["者","もの"],["と"],["なりました"],["。"],["彼","かれ"],["ら"],["が"],["ユダヤ人","ゆだやじん"],["たち"],["から"],["苦しめられた","くるしめられた"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["また"],["同胞","どうほう"],["から"],["苦しめられた","くるしめられた"],["から"],["です"],["。"]]},{"verse":15,"text":"ユダヤ人たちは、主イエスと預言者たちを殺したばかりでなく、わたしたちをも激しく迫害し、神に喜ばれることをせず、あらゆる人々に敵対し、","tok":[["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["主","しゅ"],["イエス"],["と"],["預言者","よげんしゃ"],["たち"],["を"],["殺した","ころした"],["ばかり"],["で"],["なく"],["、"],["わたしたち"],["を"],["も"],["激しく","はげしく"],["迫害","はくがい"],["し"],["、"],["神","かみ"],["に"],["喜ばれる","よろこばれる"],["こと"],["を"],["せず"],["、"],["あらゆる"],["人々","ひとびと"],["に"],["敵対","てきたい"],["し"],["、"]]},{"verse":16,"text":"異邦人が救われるようにわたしたちが語るのを妨げています。こうして、いつも自分たちの罪をあふれんばかりに増やしているのです。しかし、神の怒りは余すところなく彼らの上に臨みます。","tok":[["異邦人","いほうじん"],["が"],["救われる","すくわれる"],["よう"],["に"],["わたしたち"],["が"],["語る","かたる"],["の"],["を"],["妨げて","さまたげて"],["います"],["。"],["こう"],["して"],["、"],["いつも"],["自分","じぶん"],["たち"],["の"],["罪","つみ"],["を"],["あふれん"],["ばかり"],["に"],["増やして","ふやして"],["いる"],["の"],["です"],["。"],["しかし"],["、"],["神","かみ"],["の"],["怒り","いかり"],["は"],["余す","あます"],["ところ"],["なく"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["臨みます","のぞみます"],["。"]]},{"verse":17,"text":"兄弟たち、わたしたちは、あなたがたからしばらく引き離されていたので、――顔を見ないというだけで、心が離れていたわけではないのですが――なおさら、あなたがたの顔を見たいと切に望みました。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたしたち"],["は"],["、"],["あなた"],["がた"],["から"],["しばらく"],["引き離されて","ひきはなされて"],["いた"],["ので"],["、"],["―"],["―"],["顔","かお"],["を"],["見ない","みない"],["と"],["いう"],["だけ"],["で"],["、"],["心","こころ"],["が"],["離れて","はなれて"],["いた"],["わけ"],["で"],["は"],["ない"],["の"],["です"],["が"],["―"],["―"],["なおさら"],["、"],["あなた"],["がた"],["の"],["顔","かお"],["を"],["見たい","みたい"],["と"],["切に","せつに"],["望みました","のぞみました"],["。"]]},{"verse":18,"text":"だから、そちらへ行こうと思いました。殊に、わたしパウロは一度ならず行こうとしたのですが、サタンによって妨げられました。","tok":[["だ"],["から"],["、"],["そちら"],["へ"],["行こう","いこう"],["と"],["思いました","おもいました"],["。"],["殊に","ことに"],["、"],["わたし"],["パウロ"],["は"],["一度","いちど"],["ならず"],["行こう","いこう"],["と"],["した"],["の"],["です"],["が"],["、"],["サタン"],["によって"],["妨げられました","さまたげられました"],["。"]]},{"verse":19,"text":"わたしたちの主イエスが来られるとき、その御前でいったいあなたがた以外のだれが、わたしたちの希望、喜び、そして誇るべき冠でしょうか。","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["が"],["来られる","こられる"],["とき"],["、"],["その"],["御前","ごぜん"],["で"],["いったい"],["あなた"],["がた"],["以外","いがい"],["の"],["だれ"],["が"],["、"],["わたしたち"],["の"],["希望","きぼう"],["、"],["喜び","よろこび"],["、"],["そして"],["誇るべき","ほこるべき"],["冠","かんむり"],["でしょう"],["か"],["。"]]},{"verse":20,"text":"実に、あなたがたこそ、わたしたちの誉れであり、喜びなのです。","tok":[["実","じつ"],["に"],["、"],["あなた"],["がた"],["こそ"],["、"],["わたしたち"],["の"],["誉れ","ほまれ"],["で"],["あり"],["、"],["喜び","よろこび"],["な"],["の"],["です"],["。"]]}]
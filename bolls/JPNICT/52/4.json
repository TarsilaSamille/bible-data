[{"verse":1,"text":"さて、兄弟たち、主イエスに結ばれた者としてわたしたちは更に願い、また勧めます。あなたがたは、神に喜ばれるためにどのように歩むべきかを、わたしたちから学びました。そして、現にそのように歩んでいますが、どうか、その歩みを今後も更に続けてください。","tok":[["さて"],["、"],["兄弟","きょうだい"],["たち"],["、"],["主","しゅ"],["イエス"],["に"],["結ばれた","むすばれた"],["者","もの"],["として"],["わたしたち"],["は"],["更に","さらに"],["願い","ねがい"],["、"],["また"],["勧めます","すすめます"],["。"],["あなた"],["がた"],["は"],["、"],["神","かみ"],["に"],["喜ばれる","よろこばれる"],["ため"],["に"],["どの"],["よう"],["に"],["歩むべき","あゆむべき"],["か"],["を"],["、"],["わたしたち"],["から"],["学びました","まなびました"],["。"],["そして"],["、"],["現に","げんに"],["その"],["よう"],["に"],["歩んで","あゆんで"],["います"],["が"],["、"],["どう"],["か"],["、"],["その"],["歩み","あゆみ"],["を"],["今後","こんご"],["も"],["更に","さらに"],["続けて","つづけて"],["ください"],["。"]]},{"verse":2,"text":"わたしたちが主イエスによってどのように命令したか、あなたがたはよく知っているはずです。","tok":[["わたしたち"],["が"],["主","ぬし"],["イエス"],["によって"],["どの"],["よう"],["に"],["命令","めいれい"],["した"],["か"],["、"],["あなた"],["がた"],["は"],["よく"],["知って","しって"],["いる"],["はず"],["です"],["。"]]},{"verse":3,"text":"実に、神の御心は、あなたがたが聖なる者となることです。すなわち、みだらな行いを避け、","tok":[["実","じつ"],["に"],["、"],["神","かみ"],["の"],["御心","おこころ"],["は"],["、"],["あなた"],["がた"],["が"],["聖","せい"],["なる"],["者","もの"],["と"],["なる"],["こと"],["です"],["。"],["すなわち"],["、"],["みだら"],["な"],["行い","おこない"],["を"],["避け","さけ"],["、"]]},{"verse":4,"text":"おのおの汚れのない心と尊敬の念をもって妻と生活するように学ばねばならず、","tok":[["おのおの"],["汚れ","よごれ"],["の"],["ない"],["心","こころ"],["と"],["尊敬","そんけい"],["の"],["念","ねん"],["を"],["もって"],["妻","つま"],["と"],["生活","せいかつ"],["する"],["よう"],["に"],["学ばねば","まなばねば"],["ならず"],["、"]]},{"verse":5,"text":"神を知らない異邦人のように情欲におぼれてはならないのです。","tok":[["神","かみ"],["を"],["知らない","しらない"],["異邦人","いほうじん"],["の"],["よう"],["に"],["情欲","じょうよく"],["に"],["おぼれて"],["は"],["ならない"],["の"],["です"],["。"]]},{"verse":6,"text":"このようなことで、兄弟を踏みつけたり、欺いたりしてはいけません。わたしたちが以前にも告げ、また厳しく戒めておいたように、主はこれらすべてのことについて罰をお与えになるからです。","tok":[["この"],["よう"],["な"],["こと"],["で"],["、"],["兄弟","きょうだい"],["を"],["踏みつけ","ふみつけ"],["たり"],["、"],["欺い","あざむい"],["たり"],["して"],["は"],["いけません"],["。"],["わたしたち"],["が"],["以前","いぜん"],["に"],["も"],["告げ","つげ"],["、"],["また"],["厳しく","きびしく"],["戒めて","いましめて"],["おいた"],["よう"],["に"],["、"],["主","ぬし"],["は"],["これ"],["ら"],["すべて"],["の"],["こと"],["について"],["罰","ばつ"],["を"],["お与え","おあたえ"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":7,"text":"神がわたしたちを招かれたのは、汚れた生き方ではなく、聖なる生活をさせるためです。","tok":[["神","かみ"],["が"],["わたしたち"],["を"],["招かれた","まねかれた"],["の"],["は"],["、"],["汚れた","よごれた"],["生き方","いきかた"],["で"],["は"],["なく"],["、"],["聖","せい"],["なる"],["生活","せいかつ"],["を"],["させる"],["ため"],["です"],["。"]]},{"verse":8,"text":"ですから、これらの警告を拒む者は、人を拒むのではなく、御自分の聖霊をあなたがたの内に与えてくださる神を拒むことになるのです。","tok":[["です"],["から"],["、"],["これ"],["ら"],["の"],["警告","けいこく"],["を"],["拒む","こばむ"],["者","もの"],["は"],["、"],["人","ひと"],["を"],["拒む","こばむ"],["ので"],["は"],["なく"],["、"],["御自分","ごじぶん"],["の"],["聖霊","せいれい"],["を"],["あなた"],["がた"],["の"],["内","うち"],["に"],["与えて","あたえて"],["くださる"],["神","かみ"],["を"],["拒む","こばむ"],["こと"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":9,"text":"兄弟愛については、あなたがたに書く必要はありません。あなたがた自身、互いに愛し合うように、神から教えられているからです。","tok":[["兄弟","きょうだい"],["愛","あい"],["について"],["は"],["、"],["あなた"],["がた"],["に"],["書く","かく"],["必要","ひつよう"],["は"],["ありません"],["。"],["あなた"],["がた"],["自身","じしん"],["、"],["互い","たがい"],["に"],["愛し合う","あいしあう"],["よう"],["に"],["、"],["神","かみ"],["から"],["教えられて","おしえられて"],["いる"],["から"],["です"],["。"]]},{"verse":10,"text":"現にあなたがたは、マケドニア州全土に住むすべての兄弟に、それを実行しています。しかし、兄弟たち、なおいっそう励むように勧めます。","tok":[["現に","げんに"],["あなた"],["がた"],["は"],["、"],["マケドニア"],["州","しゅう"],["全土","ぜんど"],["に"],["住む","すむ"],["すべて"],["の"],["兄弟","きょうだい"],["に"],["、"],["それ"],["を"],["実行","じっこう"],["して"],["います"],["。"],["しかし"],["、"],["兄弟","きょうだい"],["たち"],["、"],["なお"],["いっそう"],["励む","はげむ"],["よう"],["に"],["勧めます","すすめます"],["。"]]},{"verse":11,"text":"そして、わたしたちが命じておいたように、落ち着いた生活をし、自分の仕事に励み、自分の手で働くように努めなさい。","tok":[["そして"],["、"],["わたしたち"],["が"],["命じて","めいじて"],["おいた"],["よう"],["に"],["、"],["落ち着いた","おちついた"],["生活","せいかつ"],["を"],["し"],["、"],["自分","じぶん"],["の"],["仕事","しごと"],["に"],["励み","はげみ"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["働く","はたらく"],["よう"],["に"],["努め","つとめ"],["なさい"],["。"]]},{"verse":12,"text":"そうすれば、外部の人々に対して品位をもって歩み、だれにも迷惑をかけないで済むでしょう。","tok":[["そう"],["すれば"],["、"],["外部","がいぶ"],["の"],["人々","ひとびと"],["に対して","にたいして"],["品位","ひんい"],["を"],["もって"],["歩み","あゆみ"],["、"],["だれ"],["に"],["も"],["迷惑","めいわく"],["を"],["かけないで"],["済むでしょう","すむでしょう"],["。"]]},{"verse":13,"text":"兄弟たち、既に眠りについた人たちについては、希望を持たないほかの人々のように嘆き悲しまないために、ぜひ次のことを知っておいてほしい。","tok":[["兄弟","きょうだい"],["たち"],["、"],["既に","すでに"],["眠り","ねむり"],["に"],["ついた"],["人","ひと"],["たち"],["について"],["は"],["、"],["希望","きぼう"],["を"],["持たない","もたない"],["ほか"],["の"],["人々","ひとびと"],["の"],["よう"],["に"],["嘆き悲しまない","なげきかなしまない"],["ため"],["に"],["、"],["ぜひ"],["次","つぎ"],["の"],["こと"],["を"],["知って","しって"],["おいて"],["ほしい"],["。"]]},{"verse":14,"text":"イエスが死んで復活されたと、わたしたちは信じています。神は同じように、イエスを信じて眠りについた人たちをも、イエスと一緒に導き出してくださいます。","tok":[["イエス"],["が"],["死んで","しんで"],["復活","ふっかつ"],["された"],["と"],["、"],["わたしたち"],["は"],["信じて","しんじて"],["います"],["。"],["神","かみ"],["は"],["同じ","おなじ"],["よう"],["に"],["、"],["イエス"],["を"],["信じて","しんじて"],["眠り","ねむり"],["に"],["ついた"],["人","ひと"],["たち"],["を"],["も"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["導き出して","みちびきだして"],["くださいます"],["。"]]},{"verse":15,"text":"主の言葉に基づいて次のことを伝えます。主が来られる日まで生き残るわたしたちが、眠りについた人たちより先になることは、決してありません。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["に"],["基づいて","もとづいて"],["次","つぎ"],["の"],["こと"],["を"],["伝えます","つたえます"],["。"],["主","ぬし"],["が"],["来られる","こられる"],["日","ひ"],["まで"],["生き残る","いきのこる"],["わたしたち"],["が"],["、"],["眠り","ねむり"],["に"],["ついた"],["人","ひと"],["たち"],["より"],["先","さき"],["に"],["なる"],["こと"],["は"],["、"],["決して","けっして"],["ありません"],["。"]]},{"verse":16,"text":"すなわち、合図の号令がかかり、大天使の声が聞こえて、神のラッパが鳴り響くと、主御自身が天から降って来られます。すると、キリストに結ばれて死んだ人たちが、まず最初に復活し、","tok":[["すなわち"],["、"],["合図","あいず"],["の"],["号令","ごうれい"],["が"],["かかり"],["、"],["大天使","だいてんし"],["の"],["声","こえ"],["が"],["聞こえて","きこえて"],["、"],["神","かみ"],["の"],["ラッパ"],["が"],["鳴り響く","なりひびく"],["と"],["、"],["主","しゅ"],["御自身","ごじしん"],["が"],["天","てん"],["から"],["降って","ふって"],["来られます","こられます"],["。"],["する"],["と"],["、"],["キリスト"],["に"],["結ばれて","むすばれて"],["死んだ","しんだ"],["人","ひと"],["たち"],["が"],["、"],["まず"],["最初","さいしょ"],["に"],["復活","ふっかつ"],["し"],["、"]]},{"verse":17,"tex
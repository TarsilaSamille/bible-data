[{"verse":1,"text":"わたしの妹、花嫁よ、わたしの園にわたしは来た。香り草やミルラを摘み蜜の滴るわたしの蜂の巣を吸いわたしのぶどう酒と乳を飲もう。友よ食べよ、友よ飲め。愛する者よ、愛に酔え。","tok":[["わたし"],["の"],["妹","いもうと"],["、"],["花嫁","はなよめ"],["よ"],["、"],["わたし"],["の"],["園","その"],["に"],["わたし"],["は"],["来た","きた"],["。"],["香り","かおり"],["草","くさ"],["や"],["ミルラ"],["を"],["摘み","つみ"],["蜜","みつ"],["の"],["滴る","したたる"],["わたし"],["の"],["蜂の巣","はちのす"],["を"],["吸い","すい"],["わたし"],["の"],["ぶどう酒","ぶどうしゅ"],["と"],["乳","ちち"],["を"],["飲もう","のもう"],["。"],["友","とも"],["よ"],["食べよ","たべよ"],["、"],["友","とも"],["よ"],["飲め","のめ"],["。"],["愛する","あいする"],["者","もの"],["よ"],["、"],["愛","あい"],["に"],["酔え","よえ"],["。"]]},{"verse":2,"text":"眠っていてもわたしの心は目覚めていました。恋しい人の声がする、戸をたたいています。「わたしの妹、恋人よ、開けておくれ。わたしの鳩、清らかなおとめよ。わたしの頭は露に髪は夜の露にぬれてしまった。」","tok":[["眠って","ねむって"],["いて"],["も"],["わたし"],["の"],["心","こころ"],["は"],["目覚めて","めざめて"],["いました"],["。"],["恋しい","こいしい"],["人","ひと"],["の"],["声","こえ"],["が"],["する"],["、"],["戸","と"],["を"],["たたいて"],["います"],["。"],["「"],["わたし"],["の"],["妹","いもうと"],["、"],["恋人","こいびと"],["よ"],["、"],["開けて","あけて"],["おくれ"],["。"],["わたし"],["の"],["鳩","はと"],["、"],["清らか","きよらか"],["な"],["おとめ"],["よ"],["。"],["わたし"],["の"],["頭","あたま"],["は"],["露","あらわ"],["に"],["髪","かみ"],["は"],["夜","よる"],["の"],["露","ろ"],["に"],["ぬれて"],["しまった"],["。"],["」"]]},{"verse":3,"text":"衣を脱いでしまったのにどうしてまた着られましょう。足を洗ってしまったのにどうしてまた汚せましょう。","tok":[["衣","ころも"],["を"],["脱いで","ぬいで"],["しまった"],["のに"],["どう"],["して"],["また"],["着られましょう","きられましょう"],["。"],["足","あし"],["を"],["洗って","あらって"],["しまった"],["のに"],["どう"],["して"],["また"],["汚せましょう","よごせましょう"],["。"]]},{"verse":4,"text":"恋しい人は透き間から手を差し伸べわたしの胸は高鳴りました。","tok":[["恋しい","こいしい"],["人","ひと"],["は"],["透き間","すきま"],["から"],["手","て"],["を"],["差し伸べ","さしのべ"],["わたし"],["の"],["胸","むね"],["は"],["高鳴りました","たかなりました"],["。"]]},{"verse":5,"text":"恋しい人に戸を開こうと起き上がりました。わたしの両手はミルラを滴らせミルラの滴は指から取っ手にこぼれ落ちました。","tok":[["恋しい","こいしい"],["人","ひと"],["に"],["戸","と"],["を"],["開こう","ひらこう"],["と"],["起き上がりました","おきあがりました"],["。"],["わたし"],["の"],["両手","りょうて"],["は"],["ミルラ"],["を"],["滴らせ","したたらせ"],["ミルラ"],["の"],["滴","しずく"],["は"],["指","ゆび"],["から"],["取っ手","とって"],["に"],["こぼれ落ちました","こぼれおちました"],["。"]]},{"verse":6,"text":"戸を開いたときには、恋しい人は去った後でした。恋しい人の言葉を追ってわたしの魂は出て行きます。求めても、あの人は見つかりません。呼び求めても、答えてくれません。","tok":[["戸","と"],["を"],["開いた","ひらいた"],["とき"],["に"],["は"],["、"],["恋しい","こいしい"],["人","ひと"],["は"],["去った","さった"],["後","あと"],["でした"],["。"],["恋しい","こいしい"],["人","ひと"],["の"],["言葉","ことば"],["を"],["追って","おって"],["わたし"],["の"],["魂","たましい"],["は"],["出て","でて"],["行きます","いきます"],["。"],["求めて","もとめて"],["も"],["、"],["あの"],["人","ひと"],["は"],["見つかりません","みつかりません"],["。"],["呼び求めて","よびもとめて"],["も"],["、"],["答えて","こたえて"],["くれません"],["。"]]},{"verse":7,"text":"街をめぐる夜警にわたしは見つかり打たれて傷を負いました。城壁の見張りは、わたしの衣をはぎ取りました。","tok":[["街","まち"],["を"],["めぐる"],["夜警","やけい"],["に"],["わたし"],["は"],["見つかり","みつかり"],["打たれて","うたれて"],["傷","きず"],["を"],["負いました","おいました"],["。"],["城壁","じょうへき"],["の"],["見張り","みはり"],["は"],["、"],["わたし"],["の"],["衣","ころも"],["を"],["はぎ取りました","はぎとりました"],["。"]]},{"verse":8,"text":"エルサレムのおとめたちよ、誓ってくださいもしわたしの恋しい人を見かけたらわたしが恋の病にかかっていることをその人に伝えると。","tok":[["エルサレム"],["の"],["おとめ"],["たち"],["よ"],["、"],["誓って","ちかって"],["ください"],["もし"],["わたし"],["の"],["恋しい","こいしい"],["人","ひと"],["を"],["見かけたら","みかけたら"],["わたし"],["が"],["恋","こい"],["の"],["病","やまい"],["に"],["かかって"],["いる"],["こと"],["を"],["その"],["人","ひと"],["に"],["伝える","つたえる"],["と"],["。"]]},{"verse":9,"text":"あなたの恋人はどんなにいいひとだれにもまして美しいおとめよ。あなたの恋人はどんなにいいひとこんな誓いをさせるとは。","tok":[["あなた"],["の"],["恋人","こいびと"],["は"],["どんな"],["に"],["いい"],["ひと"],["だれ"],["に"],["も"],["まして"],["美しい","うつくしい"],["おとめ"],["よ"],["。"],["あなた"],["の"],["恋人","こいびと"],["は"],["どんな"],["に"],["いい"],["ひと"],["こんな"],["誓い","ちかい"],["を"],["させる"],["と"],["は"],["。"]]},{"verse":10,"text":"わたしの恋しい人は赤銅色に輝き、ひときわ目立つ。","tok":[["わたし"],["の"],["恋しい","こいしい"],["人","ひと"],["は"],["赤銅色","しゃくどうしょく"],["に"],["輝き","かがやき"],["、"],["ひときわ"],["目立つ","めだつ"],["。"]]},{"verse":11,"text":"頭は金、純金で髪はふさふさと、烏の羽のように黒い。","tok":[["頭","あたま"],["は"],["金","きん"],["、"],["純金","じゅんきん"],["で"],["髪","かみ"],["は"],["ふさふさ"],["と"],["、"],["烏","からす"],["の"],["羽","はね"],["の"],["よう"],["に"],["黒い","くろい"],["。"]]},{"verse":12,"text":"目は水のほとりの鳩乳で身を洗い、形よく座っている。","tok":[["目","め"],["は"],["水","みず"],["の"],["ほとり"],["の"],["鳩","はと"],["乳","ちち"],["で"],["身","み"],["を"],["洗い","あらい"],["、"],["形","かたち"],["よく"],["座って","すわって"],["いる"],["。"]]},{"verse":13,"text":"頬は香り草の花床、かぐわしく茂っている。唇はゆりの花、ミルラのしずくを滴らせる。","tok":[["頬","ほお"],["は"],["香り","かおり"],["草","くさ"],["の"],["花床","かしょう"],["、"],["かぐわしく"],["茂って","しげって"],["いる"],["。"],["唇","くちびる"],["は"],["ゆり"],["の"],["花","はな"],["、"],["ミルラ"],["の"],["しずく"],["を"],["滴らせる","したたらせる"],["。"]]},{"verse":14,"text":"手はタルシシュの珠玉をはめた金の円筒胸はサファイアをちりばめた象牙の板","tok":[["手","て"],["は"],["タルシシュ"],["の"],["珠玉","しゅぎょく"],["を"],["はめた"],["金","かね"],["の"],["円筒","えんとう"],["胸","むね"],["は"],["サファイア"],["を"],["ちりばめた"],["象牙","ぞうげ"],["の"],["板","いた"]]},{"verse":15,"text":"脚は純金の台に据えられた大理石の柱。姿はレバノンの山、レバノン杉のような若者。","tok":[["脚","あし"],["は"],["純金","じゅんきん"],["の"],["台","だい"],["に"],["据えられた","すえられた"],["大理石","だいりせき"],["の"],["柱","はしら"],["。"],["姿","すがた"],["は"],["レバノン"],["の"],["山","やま"],["、"],["レバノン"],["杉","すぎ"],["の"],["よう"],["な"],["若者","わかもの"],["。"]]},{"verse":16,"text":"その口は甘美、なにもかもわたしを魅惑する。エルサレムのおとめたちよこれがわたしの恋する人、これがわたしの慕う人。","tok":[["その"],["口","くち"],["は"],["甘美","かんび"],["、"],["なに"],["も"],["か"],["も"],["わたし"],["を"],["魅惑","みわく"],["する"],["。"],["エルサレム"],["の"],["おとめ"],["たち"],["よ"],["これ"],["が"],["わたし"],["の"],["恋","こい"],["する"],["人","ひと"],["、"],["これ"],["が"],["わたし"],["の"],["慕う","したう"],["人","ひと"],["。"]]}]
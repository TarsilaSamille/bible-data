[{"verse":1,"text":"あなたの恋人はどこに行ってしまったの。だれにもまして美しいおとめよあなたの恋人はどこに行ってしまったの。一緒に探してあげましょう。","tok":[["あなた"],["の"],["恋人","こいびと"],["は"],["どこ"],["に"],["行って","いって"],["しまった"],["の"],["。"],["だれ"],["に"],["も"],["まして"],["美しい","うつくしい"],["おとめよ"],["あなた"],["の"],["恋人","こいびと"],["は"],["どこ"],["に"],["行って","いって"],["しまった"],["の"],["。"],["一緒","いっしょ"],["に"],["探して","さがして"],["あげましょう"],["。"]]},{"verse":2,"text":"わたしの恋しい人は園に香り草の花床に下りて行きました。園で群れを飼い、ゆりの花を手折っています。","tok":[["わたし"],["の"],["恋しい","こいしい"],["人","ひと"],["は"],["園","その"],["に"],["香り","かおり"],["草","くさ"],["の"],["花床","かしょう"],["に"],["下りて","おりて"],["行きました","いきました"],["。"],["園","その"],["で"],["群れ","むれ"],["を"],["飼い","かい"],["、"],["ゆり"],["の"],["花","はな"],["を"],["手折って","たおって"],["います"],["。"]]},{"verse":3,"text":"恋しいあの人はわたしのものわたしは恋しいあの人のものゆりの中で群れを飼っているあの人のもの。","tok":[["恋しい","こいしい"],["あの"],["人","ひと"],["は"],["わたし"],["の"],["もの"],["わたし"],["は"],["恋しい","こいしい"],["あの"],["人","ひと"],["の"],["もの"],["ゆり"],["の"],["中","なか"],["で"],["群れ","むれ"],["を"],["飼って","かって"],["いる"],["あの"],["人","ひと"],["の"],["もの"],["。"]]},{"verse":4,"text":"恋人よ、あなたはティルツァのように美しくエルサレムのように麗しく旗を掲げた軍勢のように恐ろしい。","tok":[["恋人","こいびと"],["よ"],["、"],["あなた"],["は"],["ティルツァ"],["の"],["よう"],["に"],["美しく","うつくしく"],["エルサレム"],["の"],["よう"],["に"],["麗しく","うるわしく"],["旗","はた"],["を"],["掲げた","かかげた"],["軍勢","ぐんぜい"],["の"],["よう"],["に"],["恐ろしい","おそろしい"],["。"]]},{"verse":5,"text":"わたしを混乱させるその目をわたしからそらせておくれ。あなたの髪はギレアドを駆け下る山羊の群れ。","tok":[["わたし"],["を"],["混乱","こんらん"],["させる"],["その"],["目","め"],["を"],["わたし"],["から"],["そらせて"],["おくれ"],["。"],["あなた"],["の"],["髪","かみ"],["は"],["ギレアド"],["を"],["駆け下る","かけくだる"],["山羊","やぎ"],["の"],["群れ","むれ"],["。"]]},{"verse":6,"text":"歯は雌羊の群れ。毛を刈られ洗い場から上って来る雌羊の群れ。対になってそろい、連れあいを失ったものはない。","tok":[["歯","は"],["は"],["雌羊","めひつじ"],["の"],["群れ","むれ"],["。"],["毛","け"],["を"],["刈られ","かられ"],["洗い場","あらいば"],["から"],["上って","のぼって"],["来る","くる"],["雌羊","めひつじ"],["の"],["群れ","むれ"],["。"],["対","たい"],["に"],["なって"],["そろい"],["、"],["連れあい","つれあい"],["を"],["失った","うしなった"],["もの"],["は"],["ない"],["。"]]},{"verse":7,"text":"ベールの陰のこめかみはざくろの花。","tok":[["ベール"],["の"],["陰","かげ"],["の"],["こめかみ"],["は"],["ざくろ"],["の"],["花","はな"],["。"]]},{"verse":8,"text":"王妃が六十人、側女が八十人若い娘の数は知れないが","tok":[["王妃","おうひ"],["が"],["六","ろく"],["十人","じゅうにん"],["、"],["側女","そばめ"],["が"],["八","はち"],["十人","じゅうにん"],["若い","わかい"],["娘","むすめ"],["の"],["数","かず"],["は"],["知れない","しれない"],["が"]]},{"verse":9,"text":"わたしの鳩、清らかなおとめはひとり。その母のただひとりの娘産みの親のかけがえのない娘。彼女を見ておとめたちは祝福し王妃も側女も彼女をたたえる。","tok":[["わたし"],["の"],["鳩","はと"],["、"],["清らか","きよらか"],["な"],["おとめ"],["は"],["ひとり"],["。"],["その"],["母","はは"],["の"],["ただ"],["ひとり"],["の"],["娘","むすめ"],["産みの親","うみのおや"],["の"],["かけがえ"],["の"],["ない"],["娘","むすめ"],["。"],["彼女","かのじょ"],["を"],["見て","みて"],["おとめ"],["たち"],["は"],["祝福","しゅくふく"],["し"],["王妃","おうひ"],["も"],["側女","そばめ"],["も"],["彼女","かのじょ"],["を"],["たたえる"],["。"]]},{"verse":10,"text":"曙のように姿を現すおとめは誰か。満月のように美しく、太陽のように輝き旗を掲げた軍勢のように恐ろしい。","tok":[["曙","あけぼの"],["の"],["よう"],["に"],["姿","すがた"],["を"],["現す","あらわす"],["おとめ"],["は"],["誰","だれ"],["か"],["。"],["満月","まんげつ"],["の"],["よう"],["に"],["美しく","うつくしく"],["、"],["太陽","たいよう"],["の"],["よう"],["に"],["輝き","かがやき"],["旗","はた"],["を"],["掲げた","かかげた"],["軍勢","ぐんぜい"],["の"],["よう"],["に"],["恐ろしい","おそろしい"],["。"]]},{"verse":11,"text":"わたしはくるみの園に下りて行きました。流れのほとりの緑の茂みにぶどうの花は咲いたかざくろのつぼみは開いたか、見ようとして。","tok":[["わたし"],["は"],["くるみ"],["の"],["園","その"],["に"],["下りて","おりて"],["行きました","いきました"],["。"],["流れ","ながれ"],["の"],["ほとり"],["の"],["緑","みどり"],["の"],["茂み","しげみ"],["に"],["ぶどう"],["の"],["花","はな"],["は"],["咲いた","さいた"],["か"],["ざくろ"],["の"],["つぼみ"],["は"],["開いた","ひらいた"],["か"],["、"],["見よう","みよう"],["として"],["。"]]},{"verse":12,"text":"知らぬ間にわたしはアミナディブの車に乗せられていました。","tok":[["知らぬ","しらぬ"],["間","ま"],["に"],["わたし"],["は"],["アミナディブ"],["の"],["車","くるま"],["に"],["乗せられて","のせられて"],["いました"],["。"]]}]
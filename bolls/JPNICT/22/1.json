[{"verse":1,"text":"ソロモンの雅歌。","tok":[["ソロモン"],["の"],["雅歌","みやびか"],["。"]]},{"verse":2,"text":"どうかあの方が、その口のくちづけをもってわたしにくちづけしてくださるように。おとめの歌ぶどう酒にもましてあなたの愛は快く","tok":[["どう"],["か"],["あの"],["方","ほう"],["が"],["、"],["その"],["口","くち"],["の"],["くちづけ"],["を"],["もって"],["わたし"],["に"],["くちづけ"],["して"],["くださる"],["よう"],["に"],["。"],["おとめ"],["の"],["歌","うた"],["ぶどう酒","ぶどうしゅ"],["に"],["も"],["まして"],["あなた"],["の"],["愛","あい"],["は"],["快く","こころよく"]]},{"verse":3,"text":"あなたの香油、流れるその香油のようにあなたの名はかぐわしい。おとめたちはあなたを慕っています。","tok":[["あなた"],["の"],["香油","こうゆ"],["、"],["流れる","ながれる"],["その"],["香油","こうゆ"],["の"],["よう"],["に"],["あなた"],["の"],["名","な"],["は"],["かぐわしい"],["。"],["おとめ"],["たち"],["は"],["あなた"],["を"],["慕って","したって"],["います"],["。"]]},{"verse":4,"text":"お誘いください、わたしを。急ぎましょう、王様わたしをお部屋に伴ってください。おとめたちの歌わたしたちもあなたと共に喜び祝います。ぶどう酒にもまさるあなたの愛をたたえます。人は皆、ひたすらあなたをお慕いします。","tok":[["お誘い","おさそい"],["ください"],["、"],["わたし"],["を"],["。"],["急ぎましょう","いそぎましょう"],["、"],["王様","おうさま"],["わたし"],["を"],["お部屋","おへや"],["に"],["伴って","ともなって"],["ください"],["。"],["おとめ"],["たち"],["の"],["歌","うた"],["わたしたち"],["も"],["あなた"],["と"],["共","とも"],["に"],["喜び祝います","よろこびいわいます"],["。"],["ぶどう酒","ぶどうしゅ"],["に"],["も"],["まさる"],["あなた"],["の"],["愛","あい"],["を"],["たたえます"],["。"],["人","ひと"],["は"],["皆","みな"],["、"],["ひたすら"],["あなた"],["を"],["お慕い","おしたい"],["します"],["。"]]},{"verse":5,"text":"エルサレムのおとめたちよわたしは黒いけれども愛らしい。ケダルの天幕、ソロモンの幕屋のように。","tok":[["エルサレム"],["の"],["おとめ"],["たち"],["よ"],["わたし"],["は"],["黒い","くろい"],["けれど"],["も"],["愛らしい","あいらしい"],["。"],["ケダル"],["の"],["天幕","てんまく"],["、"],["ソロモン"],["の"],["幕屋","まくや"],["の"],["よう"],["に"],["。"]]},{"verse":6,"text":"どうぞ、そんなに見ないでください日焼けして黒くなったわたしを。兄弟たちに叱られてぶどう畑の見張りをさせられたのです。自分の畑は見張りもできないで。","tok":[["どうぞ"],["、"],["そんな"],["に"],["見ないで","みないで"],["ください"],["日焼け","ひやけ"],["して"],["黒く","くろく"],["なった"],["わたし"],["を"],["。"],["兄弟","きょうだい"],["たち"],["に"],["叱られて","しかられて"],["ぶどう"],["畑","はたけ"],["の"],["見張り","みはり"],["を"],["させられた"],["の"],["です"],["。"],["自分","じぶん"],["の"],["畑","はたけ"],["は"],["見張り","みはり"],["も"],["できないで"],["。"]]},{"verse":7,"text":"教えてください、わたしの恋い慕う人あなたはどこで群れを飼い真昼には、どこで群れを憩わせる
[{"verse":1,"text":"恋人よ、あなたは美しい。あなたは美しく、その目は鳩のようベールの奥にひそんでいる。髪はギレアドの山を駆け下る山羊の群れ。","tok":[["恋人","こいびと"],["よ"],["、"],["あなた"],["は"],["美しい","うつくしい"],["。"],["あなた"],["は"],["美しく","うつくしく"],["、"],["その"],["目","め"],["は"],["鳩","はと"],["の"],["よう"],["ベール"],["の"],["奥","おく"],["に"],["ひそんで"],["いる"],["。"],["髪","かみ"],["は"],["ギレアド"],["の"],["山","やま"],["を"],["駆け下る","かけくだる"],["山羊","やぎ"],["の"],["群れ","むれ"],["。"]]},{"verse":2,"text":"歯は雌羊の群れ。毛を刈られ洗い場から上って来る雌羊の群れ。対になってそろい、連れあいを失ったものはない。","tok":[["歯","は"],["は"],["雌羊","めひつじ"],["の"],["群れ","むれ"],["。"],["毛","け"],["を"],["刈られ","かられ"],["洗い場","あらいば"],["から"],["上って","のぼって"],["来る","くる"],["雌羊","めひつじ"],["の"],["群れ","むれ"],["。"],["対","たい"],["に"],["なって"],["そろい"],["、"],["連れあい","つれあい"],["を"],["失った","うしなった"],["もの"],["は"],["ない"],["。"]]},{"verse":3,"text":"唇は紅の糸。言葉がこぼれるときにはとりわけ愛らしい。ベールの陰のこめかみはざくろの花。","tok":[["唇","くちびる"],["は"],["紅","くれない"],["の"],["糸","いと"],["。"],["言葉","ことば"],["が"],["こぼれる"],["とき"],["に"],["は"],["とりわけ"],["愛らしい","あいらしい"],["。"],["ベール"],["の"],["陰","かげ"],["の"],["こめかみ"],["は"],["ざくろ"],["の"],["花","はな"],["。"]]},{"verse":4,"text":"首はみごとに積み上げられたダビデの塔。千の盾、勇士の小盾が掛けられている。","tok":[["首","くび"],["は"],["みごと"],["に"],["積み上げられた","つみあげられた"],["ダビデ"],["の"],["塔","とう"],["。"],["千","せん"],["の"],["盾","たて"],["、"],["勇士","ゆうし"],["の"],["小","こ"],["盾","たて"],["が"],["掛けられて","かけられて"],["いる"],["。"]]},{"verse":5,"text":"乳房は二匹の小鹿。ゆりに囲まれ草をはむ双子のかもしか。","tok":[["乳房","ちぶさ"],["は"],["二匹","にひき"],["の"],["小鹿","そろく"],["。"],["ゆり"],["に"],["囲まれ","かこまれ"],["草","くさ"],["を"],["はむ"],["双子","ふたご"],["の"],["かもしか"],["。"]]},{"verse":6,"text":"夕べの風が騒ぎ、影が闇にまぎれる前にミルラの山に登ろう、乳香の丘にわたしは登ろう。","tok":[["夕べ","ゆうべ"],["の"],["風","かぜ"],["が"],["騒ぎ","さわぎ"],["、"],["影","かげ"],["が"],["闇","やみ"],["に"],["まぎれる"],["前","まえ"],["に"],["ミルラ"],["の"],["山","やま"],["に"],["登ろう","のぼろう"],["、"],["乳香","にゅうこう"],["の"],["丘","おか"],["に"],["わたし"],["は"],["登ろう","のぼろう"],["。"]]},{"verse":7,"text":"恋人よ、あなたはなにもかも美しく傷はひとつもない。","tok":[["恋人","こいびと"],["よ"],["、"],["あなた"],["は"],["なに"],["も"],["か"],["も"],["美しく","うつくしく"],["傷","きず"],["は"],["ひと"],["つ"],["も"],["ない"],["。"]]},{"verse":8,"text":"花嫁よ、レバノンからおいでおいで、レバノンから出ておいで。アマナの頂から、セニル、ヘルモンの頂から獅子の隠れが、豹の住む山から下りておいで。","tok":[["花嫁","はなよめ"],["よ"],["、"],["レバノン"],["から"],["おいで"],["おいで"],["、"],["レバノン"],["から"],["出て","でて"],["おいで"],["。"],["アマナ"],["の"],["頂","いただき"],["から"],["、"],["セニル"],["、"],["ヘルモン"],["の"],["頂","いただき"],["から"],["獅子","しし"],["の"],["隠れ","かくれ"],["が"],["、"],["豹","ひょう"],["の"],["住む","すむ"],["山","やま"],["から"],["下りて","おりて"],["おいで"],["。"]]},{"verse":9,"text":"わたしの妹、花嫁よあなたはわたしの心をときめかす。あなたのひと目も、首飾りのひとつの玉もそれだけで、わたしの心をときめかす。","tok":[["わたし"],["の"],["妹","いもうと"],["、"],["花嫁","はなよめ"],["よ"],["あなた"],["は"],["わたし"],["の"],["心","こころ"],["を"],["ときめかす"],["。"],["あなた"],["の"],["ひと目","ひとめ"],["も"],["、"],["首飾り","くびかざり"],["の"],["ひと"],["つ"],["の"],["玉","たま"],["も"],["それ"],["だけ"],["で"],["、"],["わたし"],["の"],["心","こころ"],["を"],["ときめかす"],["。"]]},{"verse":10,"text":"わたしの妹、花嫁よ、あなたの愛は美しくぶどう酒よりもあなたの愛は快い。あなたの香油はどんな香り草よりもかぐわしい。","tok":[["わたし"],["の"],["妹","いもうと"],["、"],["花嫁","はなよめ"],["よ"],["、"],["あなた"],["の"],["愛","あい"],["は"],["美しく","うつくしく"],["ぶどう酒","ぶどうしゅ"],["より"],["も"],["あなた"],["の"],["愛","あい"],["は"],["快い","こころよい"],["。"],["あなた"],["の"],["香油","こうゆ"],["は"],["どんな"],["香り草","かおりそう"],["より"],["も"],["かぐわしい"],["。"]]},{"verse":11,"text":"花嫁よ、あなたの唇は蜜を滴らせ舌には蜂蜜と乳がひそむ。あなたの衣はレバノンの香り。","tok":[["花嫁","はなよめ"],["よ"],["、"],["あなた"],["の"],["唇","くちびる"],["は"],["蜜","みつ"],["を"],["滴らせ","したたらせ"],["舌","した"],["に"],["は"],["蜂蜜","はちみつ"],["と"],["乳","ちち"],["が"],["ひそむ"],["。"],["あなた"],["の"],["衣","ころも"],["は"],["レバノン"],["の"],["香り","かおり"],["。"]]},{"verse":12,"text":"わたしの妹、花嫁は、閉ざされた園。閉ざされた園、封じられた泉。","tok":[["わたし"],["の"],["妹","いもうと"],["、"],["花嫁","はなよめ"],["は"],["、"],["閉ざされた","とざされた"],["園","その"],["。"],["閉ざされた","とざされた"],["園","その"],["、"],["封じられた","ふうじられた"],["泉","いずみ"],["。"]]},{"verse":13,"text":"ほとりには、みごとな実を結ぶざくろの森ナルドやコフェルの花房","tok":[["ほとり"],["に"],["は"],["、"],["みごと"],["な"],["実","じつ"],["を"],["結ぶ","むすぶ"],["ざくろ"],["の"],["森","もり"],["ナルド"],["や"],["コフェル"],["の"],["花房","はなぶさ"]]},{"verse":14,"text":"ナルドやサフラン、菖蒲やシナモン乳香の木、ミルラやアロエさまざまな、すばらしい香り草。","tok":[["ナルド"],["や"],["サフラン"],["、"],["菖蒲","しょうぶ"],["や"],["シナモン"],["乳香","にゅうこう"],["の"],["木","き"],["、"],["ミルラ"],["や"],["アロエ"],["さまざま"],["な"],["、"],["すばらしい"],["香り","かおり"],["草","くさ"],["。"]]},{"verse":15,"text":"園の泉は命の水を汲むところレバノンの山から流れて来る水を。","tok":[["園","その"],["の"],["泉","いずみ"],["は"],["命","いのち"],["の"],["水","みず"],["を"],["汲む","くむ"],["ところ"],["レバノン"],["の"],["山","やま"],["から"],["流れて","ながれて"],["来る","くる"],["水","みず"],["を"],["。"]]},{"verse":16,"text":"北風よ、目覚めよ。南風よ、吹け。わたしの園を吹き抜けて香りを振りまいておくれ。恋しい人がこの園をわがものとしてこのみごとな実を食べてくださるように。","tok":[["北風","きたかぜ"],["よ"],["、"],["目覚め","めざめ"],["よ"],["。"],["南風","はえ"],["よ"],["、"],["吹け","ふけ"],["。"],["わたし"],["の"],["園","その"],["を"],["吹き抜けて","ふきぬけて"],["香り","かおり"],["を"],["振りまいて","ふりまいて"],["おくれ"],["。"],["恋しい","こいしい"],["人","ひと"],["が"],["この"],["園","その"],["を"],["わが"],["もの"],["として"],["この"],["みごと"],["な"],["実","じつ"],["を"],["食べて","たべて"],["くださる"],["よう"],["に"],["。"]]}]
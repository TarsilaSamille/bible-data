[{"verse":1,"text":"もう一度出ておいで、シュラムのおとめもう一度出ておいで、姿を見せておくれ。マハナイムの踊りをおどるシュラムのおとめになぜ、それほど見とれるのか。","tok":[["もう"],["一度","いちど"],["出て","でて"],["おいで"],["、"],["シュラム"],["の"],["おとめ"],["もう"],["一度","いちど"],["出て","でて"],["おいで"],["、"],["姿","すがた"],["を"],["見せて","みせて"],["おくれ"],["。"],["マハナイム"],["の"],["踊り","おどり"],["を"],["おどる"],["シュラム"],["の"],["おとめ"],["に"],["なぜ"],["、"],["それ"],["ほど"],["見とれる","みとれる"],["の"],["か"],["。"]]},{"verse":2,"text":"気高いおとめよサンダルをはいたあなたの足は美しい。ふっくらとしたももはたくみの手に磨かれた彫り物。","tok":[["気高い","けだかい"],["おとめよ"],["サンダル"],["を"],["はいた"],["あなた"],["の"],["足","あし"],["は"],["美しい","うつくしい"],["。"],["ふっくら"],["と"],["した"],["もも"],["は"],["たくみ"],["の"],["手","て"],["に"],["磨かれた","みがかれた"],["彫り物","ほりもの"],["。"]]},{"verse":3,"text":"秘められたところは丸い杯かぐわしい酒に満ちている。腹はゆりに囲まれた小麦の山。","tok":[["秘められた","ひめられた"],["ところ"],["は"],["丸い","まるい"],["杯","さかずき"],["かぐわしい"],["酒","さけ"],["に"],["満ちて","みちて"],["いる"],["。"],["腹","はら"],["は"],["ゆり"],["に"],["囲まれた","かこまれた"],["小麦","こむぎ"],["の"],["山","やま"],["。"]]},{"verse":4,"text":"乳房は二匹の子鹿、双子のかもしか。","tok":[["乳房","ちぶさ"],["は"],["二匹","にひき"],["の"],["子鹿","こじか"],["、"],["双子","ふたご"],["の"],["かもしか"],["。"]]},{"verse":5,"text":"首は象牙の塔。目はバト‧ラビムの門の傍らにあるヘシュボンの二つの池。鼻はレバノンの塔、ダマスコを見はるかす。","tok":[["首","くび"],["は"],["象牙","ぞうげ"],["の"],["塔","とう"],["。"],["目","め"],["は"],["バト"],["‧"],["ラビム"],["の"],["門","もん"],["の"],["傍ら","かたわら"],["に"],["ある"],["ヘシュボン"],["の"],["二","ふた"],["つ"],["の"],["池","いけ"],["。"],["鼻","はな"],["は"],["レバノン"],["の"],["塔","とう"],["、"],["ダマスコ"],["を"],["見はるかす","みはるかす"],["。"]]},{"verse":6,"text":"高く起こした頭はカルメルの山。長い紫の髪、王はその房のとりこになった。","tok":[["高く","たかく"],["起こした","おこした"],["頭","あたま"],["は"],["カルメル"],["の"],["山","やま"],["。"],["長い","ながい"],["紫","むらさき"],["の"],["髪","かみ"],["、"],["王","おう"],["は"],["その"],["房","ぼう"],["の"],["とりこ"],["に"],["なった"],["。"]]},{"verse":7,"text":"喜びに満ちた愛よあなたはなんと美しく楽しいおとめか。","tok":[["喜び","よろこび"],["に"],["満ちた","みちた"],["愛","あい"],["よ"],["あなた"],["は"],["なん"],["と"],["美しく","うつくしく"],["楽しい","たのしい"],["おとめ"],["か"],["。"]]},{"verse":8,"text":"あなたの立ち姿はなつめやし、乳房はその実の房。","tok":[["あなた"],["の"],["立ち姿","たちすがた"],["は"],["なつめやし"],["、"],["乳房","ちぶさ"],["は"],["その"],["実","じつ"],["の"],["房","ふさ"],["。"]]},{"verse":9,"text":"なつめやしの木に登り甘い実の房をつかんでみたい。わたしの願いはぶどうの房のようなあなたの乳房りんごの香りのようなあなたの息","tok":[["なつめやし"],["の"],["木","き"],["に"],["登り","のぼり"],["甘い","あまい"],["実","じつ"],["の"],["房","ふさ"],["を"],["つかんで"],["みたい"],["。"],["わたし"],["の"],["願い","ねがい"],["は"],["ぶどう"],["の"],["房","ふさ"],["の"],["よう"],["な"],["あなた"],["の"],["乳房","にゅうぼう"],["りんご"],["の"],["香り","かおり"],["の"],["よう"],["な"],["あなた"],["の"],["息","いき"]]},{"verse":10,"text":"うまいぶどう酒のようなあなたの口。おとめの歌それはわたしの恋しい人へ滑らかに流れ眠っているあの人の唇に滴ります。","tok":[["うまい"],["ぶどう酒","ぶどうしゅ"],["の"],["よう"],["な"],["あなた"],["の"],["口","くち"],["。"],["おとめ"],["の"],["歌","うた"],["それ"],["は"],["わたし"],["の"],["恋しい","こいしい"],["人","ひと"],["へ"],["滑らか","なめらか"],["に"],["流れ","ながれ"],["眠って","ねむって"],["いる"],["あの"],["人","ひと"],["の"],["唇","くちびる"],["に"],["滴ります","したたります"],["。"]]},{"verse":11,"text":"わたしは恋しい人のものあの人はわたしを求めている。","tok":[["わたし"],["は"],["恋しい","こいしい"],["人","ひと"],["の"],["もの"],["あの"],["人","ひと"],["は"],["わたし"],["を"],["求めて","もとめて"],["いる"],["。"]]},{"verse":12,"text":"恋しい人よ、来てください。野に出ましょうコフェルの花房のもとで夜を過ごしましょう。","tok":[["恋しい","こいしい"],["人","ひと"],["よ"],["、"],["来て","きて"],["ください"],["。"],["野","の"],["に"],["出ましょう","でましょう"],["コフェル"],["の"],["花房","はなぶさ"],["の"],["もと"],["で"],["夜","よる"],["を"],["過ごしましょう","すごしましょう"],["。"]]},{"verse":13,"text":"朝になったらぶどう畑に急ぎ見ましょう、ぶどうの花は咲いたか、花盛りかざくろのつぼみも開いたか。それから、あなたにわたしの愛をささげます。","tok":[["朝","あさ"],["に"],["なったら"],["ぶどう"],["畑","はたけ"],["に"],["急ぎ","いそぎ"],["見ましょう","みましょう"],["、"],["ぶどう"],["の"],["花","はな"],["は"],["咲いた","さいた"],["か"],["、"],["花盛り","はなざかり"],["か"],["ざくろ"],["の"],["つぼみ"],["も"],["開いた","ひらいた"],["か"],["。"],["それ"],["から"],["、"],["あなた"],["に"],["わたし"],["の"],["愛","あい"],["を"],["ささげます"],["。"]]},{"verse":14,"text":"恋なすは香りそのみごとな実が戸口に並んでいます。新しい実も、古い実も恋しい人よ、あなたのために取っておきました。","tok":[["恋","こい"],["なす"],["は"],["香り","かおり"],["その"],["みごと"],["な"],["実","じつ"],["が"],["戸口","とぐち"],["に"],["並んで","ならんで"],["います"],["。"],["新しい","あたらしい"],["実","じつ"],["も"],["、"],["古い","ふるい"],["実","じつ"],["も"],["恋しい","こいしい"],["人","ひと"],["よ"],["、"],["あなた"],["の"],["ため"],["に"],["取
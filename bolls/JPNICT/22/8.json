[{"verse":1,"text":"あなたが、わたしの母の乳房を吸った本当の兄だと思う人ならわたしをとがめたりはしないでしょう外であなたにお会いしてくちづけするわたしを見ても。","tok":[["あなた"],["が"],["、"],["わたし"],["の"],["母","はは"],["の"],["乳房","ちぶさ"],["を"],["吸った","すった"],["本当","ほんとう"],["の"],["兄","あに"],["だ"],["と"],["思う","おもう"],["人","ひと"],["なら"],["わたし"],["を"],["とがめ"],["たり"],["は"],["しないでしょう"],["外","そと"],["で"],["あなた"],["に"],["お会い","おあい"],["して"],["くちづけ"],["する"],["わたし"],["を"],["見て","みて"],["も"],["。"]]},{"verse":2,"text":"わたしを育ててくれた母の家にあなたをお連れして香り高いぶどう酒をざくろの飲み物を差し上げます。","tok":[["わたし"],["を"],["育てて","そだてて"],["くれた"],["母","はは"],["の"],["家","いえ"],["に"],["あなた"],["を"],["お連れ","おつれ"],["して"],["香り","かおり"],["高い","たかい"],["ぶどう酒","ぶどうしゅ"],["を"],["ざくろ"],["の"],["飲み物","のみもの"],["を"],["差し上げます","さしあげます"],["。"]]},{"verse":3,"text":"あの人が左の腕をわたしの頭の下に伸べ右の腕でわたしを抱いてくださればよいのに。","tok":[["あの"],["人","ひと"],["が"],["左","ひだり"],["の"],["腕","うで"],["を"],["わたし"],["の"],["頭","あたま"],["の"],["下","した"],["に"],["伸べ","のべ"],["右","みぎ"],["の"],["腕","うで"],["で"],["わたし"],["を"],["抱いて","いだいて"],["くだされば"],["よい"],["のに"],["。"]]},{"verse":4,"text":"エルサレムのおとめたちよ、誓ってください愛がそれを望むまでは愛を呼びさまさないと。","tok":[["エルサレム"],["の"],["おとめ"],["たち"],["よ"],["、"],["誓って","ちかって"],["ください"],["愛","あい"],["が"],["それ"],["を"],["望む","のぞむ"],["まで"],["は"],["愛","あい"],["を"],["呼びさまさない","よびさまさない"],["と"],["。"]]},{"verse":5,"text":"荒れ野から上って来るおとめは誰か恋人の腕に寄りかかって。おとめの歌りんごの木の下でわたしはあなたを呼びさましましょう。あなたの母もここであなたをみごもりました。あなたを産んだ方もここであなたをみごもりました。","tok":[["荒れ野","あれの"],["から"],["上って","のぼって"],["来る","くる"],["おとめ"],["は"],["誰","だれ"],["か"],["恋人","こいびと"],["の"],["腕","うで"],["に"],["寄りかかって","よりかかって"],["。"],["おとめ"],["の"],["歌","うた"],["りんご"],["の"],["木","き"],["の"],["下","もと"],["で"],["わたし"],["は"],["あなた"],["を"],["呼びさましましょう","よびさましましょう"],["。"],["あなた"],["の"],["母","はは"],["も"],["ここ"],["で"],["あなた"],["を"],["みごもりました"],["。"],["あなた"],["を"],["産んだ","うんだ"],["方","ほう"],["も"],["ここ"],["で"],["あなた"],["を"],["みごもりました"],["。"]]},{"verse":6,"text":"わたしを刻みつけてくださいあなたの心に、印章としてあなたの腕に、印章として。合唱 一愛は死のように強く熱情は陰府のように酷い。火花を散らして燃える炎。","tok":[["わたし"],["を"],["刻みつけて","きざみつけて"],["ください"],["あなた"],["の"],["心","こころ"],["に"],["、"],["印章","いんしょう"],["として"],["あなた"],["の"],["腕","うで"],["に"],["、"],["印章","いんしょう"],["として"],["。"],["合唱","がっしょう"],[" "],["一","いち"],["愛","あい"],["は"],["死","し"],["の"],["よう"],["に"],["強く","つよく"],["熱情","ねつじょう"],["は"],["陰府","よみ"],["の"],["よう"],["に"],["酷い","ひどい"],["。"],["火花","ひばな"],["を"],["散らして","ちらして"],["燃える","もえる"],["炎","ほのお"],["。"]]},{"verse":7,"text":"大水も愛を消すことはできない洪水もそれを押し流すことはできない。愛を支配しようと財宝などを差し出す人があればその人は必ずさげすまれる。","tok":[["大水","おおみず"],["も"],["愛","あい"],["を"],["消す","けす"],["こと"],["は"],["できない"],["洪水","こうずい"],["も"],["それ"],["を"],["押し流す","おしながす"],["こと"],["は"],["できない"],["。"],["愛","あい"],["を"],["支配","しはい"],["しよう"],["と"],["財宝","ざいほう"],["など"],["を"],["差し出す","さしだす"],["人","ひと"],["が"],["あれば"],["その"],["人","ひと"],["は"],["必ず","かならず"],["さげすまれる"],["。"]]},{"verse":8,"text":"わたしたちの妹は幼くて、乳房はまだない。この妹が求愛されたら、どうすればよいのか。","tok":[["わたしたち"],["の"],["妹","いもうと"],["は"],["幼くて","おさなくて"],["、"],["乳房","ちぶさ"],["は"],["まだ"],["ない"],["。"],["この"],["妹","いもうと"],["が"],["求愛","きゅうあい"],["されたら"],["、"],["どう"],["すれば"],["よい"],["の"],["か"],["。"]]},{"verse":9,"text":"この子が城壁ならば、その上に銀の柵をめぐらしこの子が扉ならばレバノン杉の板で覆うことにしよう。","tok":[["この"],["子","こ"],["が"],["城壁","じょうへき"],["ならば"],["、"],["その"],["上","うえ"],["に"],["銀","ぎん"],["の"],["柵","さく"],["を"],["めぐらし"],["この"],["子","こ"],["が"],["扉","とびら"],["ならば"],["レバノン"],["杉","すぎ"],["の"],["板","いた"],["で"],["覆う","おおう"],["こと"],["に"],["しよう"],["。"]]},{"verse":10,"text":"わたしは城壁、わたしの乳房は二つの塔。あの人の目には、もう満足を与えるものと見えています。","tok":[["わたし"],["は"],["城壁","じょうへき"],["、"],["わたし"],["の"],["乳房","ちぶさ"],["は"],["二","ふた"],["つ"],["の"],["塔","とう"],["。"],["あの"],["人","ひと"],["の"],["目","め"],["に"],["は"],["、"],["もう"],["満足","まんぞく"],["を"],["与える","あたえる"],["もの"],["と"],["見えて","みえて"],["います"],["。"]]},{"verse":11,"text":"ソロモンはぶどう畑をバアル‧ハモンに持っていてぶどうの世話を番人たちに任せました。番人たちはそれぞれのぶどうに代えて銀一千を納めます。","tok":[["ソロモン"],["は"],["ぶどう"],["畑","はたけ"],["を"],["バアル"],["‧"],["ハモン"],["に"],["持って","もって"],["いて"],["ぶどう"],["の"],["世話","せわ"],["を"],["番人","ばんにん"],["たち"],["に"],["任せました","まかせました"],["。"],["番人","ばんにん"],["たち"],["は"],["それぞれ"],["の"],["ぶどう"],["に"],["代えて","かえて"],["銀一","ぎんいち"],["千","せん"],["を"],["納めます","おさめます"],["。"]]},{"verse":12,"text":"「これがわたしのぶどう畑、ソロモン様。銀一千はあなたの取り分。銀二百は世話をした番人へ。」","tok":[["「"],["これ"],["が"],["わたし"],["の"],["ぶどう"],["畑","はたけ"],["、"],["ソロモン"],["様","さま"],["。"],["銀一","ぎんいち"],["千","せん"],["は"],["あなた"],["の"],["取り分","とりぶん"],["。"],["銀","ぎん"],["二百","にひゃく"],["は"],["世話","せわ"],["を"],["した"],["番人","ばんにん"],["へ"],["。"],["」"]]},{"verse":13,"text":"園に座っているおとめよ友は皆、あなたの声に耳を傾けている。わたしにも聞かせておくれ。","tok":[["園","その"],["に"],["座って","すわって"],["いる"],["おとめよ"],["友","とも"],["は"],["皆","みな"],["、"],["あなた"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["いる"],["。"],["わたし"],["に"],["も"],["聞かせて","きかせて"],["おくれ"],["。"]]},{"verse":14,"text":"恋しい人よ急いでください、かもしかや子鹿のように香り草の山々へ。","tok":[["恋しい","こいしい"],["人","ひと"],["よ"],["急いで","いそいで"],["ください"],["、"],["かもしか"],["や"],["子鹿","こじか"],["の"],["よう"],["に"],["香り","かおり"],["草","くさ"],["の"],["山々","やまやま"],["へ"],["。"]]}]
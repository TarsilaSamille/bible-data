"は"],["子","こ"],["を"],["死","し"],["に"],["追いやり","おいやり"],["、"],["子","こ"],["は"],["親","おや"],["に"],["反抗","はんこう"],["して"],["殺すだろう","ころすだろう"],["。"]]},{"verse":13,"text":"また、わたしの名のために、あなたがたはすべての人に憎まれる。しかし、最後まで耐え忍ぶ者は救われる。」","tok":[["また"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["は"],["すべて"],["の"],["人","ひと"],["に"],["憎まれる","にくまれる"],["。"],["しかし"],["、"],["最後","さいご"],["まで"],["耐え忍ぶ","たえしのぶ"],["者","もの"],["は"],["救われる","すくわれる"],["。"],["」"]]},{"verse":14,"text":"「憎むべき破壊者が立ってはならない所に立つのを見たら――読者は悟れ――、そのとき、ユダヤにいる人々は山に逃げなさい。","tok":[["「"],["憎むべき","にくむべき"],["破壊者","はかいしゃ"],["が"],["立って","たって"],["は"],["ならない"],["所","ところ"],["に"],["立つ","たつ"],["の"],["を"],["見たら","みたら"],["―"],["―"],["読者","どくしゃ"],["は"],["悟れ","さとれ"],["―"],["―"],["、"],["その"],["とき"],["、"],["ユダヤ"],["に"],["いる"],["人々","ひとびと"],["は"],["山","やま"],["に"],["逃げ","にげ"],["なさい"],["。"]]},{"verse":15,"text":"屋上にいる者は下に降りてはならない。家にある物を何か取り出そうとして中に入ってはならない。","tok":[["屋上","おくじょう"],["に"],["いる"],["者","もの"],["は"],["下","した"],["に"],["降りて","おりて"],["は"],["ならない"],["。"],["家","いえ"],["に"],["ある"],["物","もの"],["を"],["何","なん"],["か"],["取り出そう","とりだそう"],["として"],["中","なか"],["に"],["入って","はいって"],["は"],["ならない"],["。"]]},{"verse":16,"text":"畑にいる者は、上着を取りに帰ってはならない。","tok":[["畑","はたけ"],["に"],["いる"],["者","もの"],["は"],["、"],["上着","うわぎ"],["を"],["取り","とり"],["に"],["帰って","かえって"],["は"],["ならない"],["。"]]},{"verse":17,"text":"それらの日には、身重の女と乳飲み子を持つ女は不幸だ。","tok":[["それ"],["ら"],["の"],["日","ひ"],["に"],["は"],["、"],["身重","みおも"],["の"],["女","おんな"],["と"],["乳飲み子","ちのみご"],["を"],["持つ","もつ"],["女","おんな"],["は"],["不幸","ふこう"],["だ"],["。"]]},{"verse":18,"text":"このことが冬に起こらないように、祈りなさい。","tok":[["この"],["こと"],["が"],["冬","ふゆ"],["に"],["起こらない","おこらない"],["よう"],["に"],["、"],["祈り","いのり"],["なさい"],["。"]]},{"verse":19,"text":"それらの日には、神が天地を造られた創造の初めから今までなく、今後も決してないほどの苦難が来るからである。","tok":[["それ"],["ら"],["の"],["日","ひ"],["に"],["は"],["、"],["神","かみ"],["が"],["天地","てんち"],["を"],["造られた","つくられた"],["創造","そうぞう"],["の"],["初め","はじめ"],["から"],["今まで","いままで"],["なく"],["、"],["今後","こんご"],["も"],["決して","けっして"],["ない"],["ほど"],["の"],
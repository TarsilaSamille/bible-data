],["いつ"],["な"],["の"],["か"],["、"],["あなた"],["がた"],["に"],["は"],["分からない","わからない"],["から"],["で"],["ある"],["。"]]},{"verse":34,"text":"それは、ちょうど、家を後に旅に出る人が、僕たちに仕事を割り当てて責任を持たせ、門番には目を覚ましているようにと、言いつけておくようなものだ。","tok":[["それ"],["は"],["、"],["ちょうど"],["、"],["家","いえ"],["を"],["後","あと"],["に"],["旅","たび"],["に"],["出る","でる"],["人","ひと"],["が"],["、"],["僕たち","ぼくたち"],["に"],["仕事","しごと"],["を"],["割り当てて","わりあてて"],["責任","せきにん"],["を"],["持たせ","もたせ"],["、"],["門番","もんばん"],["に"],["は"],["目","め"],["を"],["覚まして","さまして"],["いる"],["よう"],["に"],["と"],["、"],["言いつけて","いいつけて"],["おく"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":35,"text":"だから、目を覚ましていなさい。いつ家の主人が帰って来るのか、夕方か、夜中か、鶏の鳴くころか、明け方か、あなたがたには分からないからである。","tok":[["だ"],["から"],["、"],["目","め"],["を"],["覚まして","さまして"],["い"],["なさい"],["。"],["いつ"],["家","や"],["の"],["主人","しゅじん"],["が"],["帰って","かえって"],["来る","くる"],["の"],["か"],["、"],["夕方","ゆうがた"],["か"],["、"],["夜中","よなか"],["か"],["、"],["鶏","にわとり"],["の"],["鳴く","なく"],["ころ"],["か"],["、"],["明け方","あけがた"],["か"],["、"],["あなた"],["がた"],["に"],["は"],["分からない","わからない"],["から"],["で"],["ある"],["。"]]},{"verse":36,"text":"主人が突然帰って来て、あなたがたが眠っているのを見つけるかもしれない。","tok":[["主人","しゅじん"],["が"],["突然","とつぜん"],["帰って","かえって"],["来て","きて"],["、"],["あなた"],["がた"],["が"],["眠って","ねむって"],["いる"],["の"],["を"],["見つける","みつける"],["か"],["も"],["しれない"],["。"]]},{"verse":37,"text":"あなたがたに言うことは、すべての人に言うのだ。目を覚ましていなさい。」","tok":[["あなた"],["がた"],["に"],["言う","いう"],["こと"],["は"],["、"],["すべて"],["の"],["人","ひと"],["に"],["言う","いう"],["の"],["だ"],["。"],["目","め"],["を"],["覚まして","さまして"],["い"],["なさい"],["。"],["」"]]}]
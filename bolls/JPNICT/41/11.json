[{"verse":1,"text":"一行がエルサレムに近づいて、オリーブ山のふもとにあるベトファゲとベタニアにさしかかったとき、イエスは二人の弟子を使いに出そうとして、","tok":[["一行","いっこう"],["が"],["エルサレム"],["に"],["近づいて","ちかづいて"],["、"],["オリーブ"],["山","さん"],["の"],["ふもと"],["に"],["ある"],["ベトファゲ"],["と"],["ベタニア"],["に"],["さしかかった"],["とき"],["、"],["イエス"],["は"],["二人","ふたり"],["の"],["弟子","でし"],["を"],["使い","つかい"],["に"],["出そう","だそう"],["として"],["、"]]},{"verse":2,"text":"言われた。「向こうの村へ行きなさい。村に入るとすぐ、まだだれも乗ったことのない子ろばのつないであるのが見つかる。それをほどいて、連れて来なさい。","tok":[["言われた","いわれた"],["。"],["「"],["向こう","むこう"],["の"],["村","むら"],["へ"],["行き","いき"],["なさい"],["。"],["村","むら"],["に"],["入る","はいる"],["と"],["すぐ"],["、"],["まだ"],["だれ"],["も"],["乗った","のった"],["こと"],["の"],["ない"],["子","こ"],["ろば"],["の"],["つないで"],["ある"],["の"],["が"],["見つかる","みつかる"],["。"],["それ"],["を"],["ほどいて"],["、"],["連れて","つれて"],["来","き"],["なさい"],["。"]]},{"verse":3,"text":"もし、だれかが、『なぜ、そんなことをするのか』と言ったら、『主がお入り用なのです。すぐここにお返しになります』と言いなさい。」","tok":[["もし"],["、"],["だれ"],["か"],["が"],["、"],["『"],["なぜ"],["、"],["そんな"],["こと"],["を"],["する"],["の"],["か"],["』"],["と"],["言ったら","いったら"],["、"],["『"],["主","ぬし"],["が"],["お入り","おはいり"],["用","よう"],["な"],["の"],["です"],["。"],["すぐ"],["ここ"],["に"],["お返し","おかえし"],["に"],["なります"],["』"],["と"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":4,"text":"二人は、出かけて行くと、表通りの戸口に子ろばのつないであるのを見つけたので、それをほどいた。","tok":[["二人","ふたり"],["は"],["、"],["出かけて","でかけて"],["行く","いく"],["と"],["、"],["表通り","おもてどおり"],["の"],["戸口","とぐち"],["に"],["子","こ"],["ろば"],["の"],["つないで"],["ある"],["の"],["を"],["見つけた","みつけた"],["ので"],["、"],["それ"],["を"],["ほどいた"],["。"]]},{"verse":5,"text":"すると、そこに居合わせたある人々が、「その子ろばをほどいてどうするのか」と言った。","tok":[["する"],["と"],["、"],["そこ"],["に"],["居合わせた","いあわせた"],["ある"],["人々","ひとびと"],["が"],["、"],["「"],["その"],["子","こ"],["ろば"],["を"],["ほどいて"],["どう"],["する"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"二人が、イエスの言われたとおり話すと、許してくれた。","tok":[["二人","ふたり"],["が"],["、"],["イエス"],["の"],["言われた","いわれた"],["とおり"],["話す","はなす"],["と"],["、"],["許して","ゆるして"],["くれた"],["。"]]},{"verse":7,"text":"二人が子ろばを連れてイエスのところに戻って来て、その上に自分の服をかけると、イエスはそれにお乗りになった。","tok":[["二人","ふたり"],["が"],["子","こ"],["ろば"],["を"],["連れて","つれて"],["イエス"],["の"],["ところ"],["に"],["戻って","もどって"],["来て","きて"],["、"],["その"],["上","うえ"],["に"],["自分","じぶん"],["の"],["服","ふく"],["を"],["かける"],["と"],["、"],["イエス"],["は"],["それ"],["に"],["お乗り","おのり"],["に"],["なった"],["。"]]},{"verse":8,"text":"多くの人が自分の服を道に敷き、また、ほかの人々は野原から葉の付いた枝を切って来て道に敷いた。","tok":[["多く","おおく"],["の"],["人","ひと"],["が"],["自分","じぶん"],["の"],["服","ふく"],["を"],["道","みち"],["に"],["敷き","しき"],["、"],["また"],["、"],["ほか"],["の"],["人々","ひとびと"],["は"],["野原","のはら"],["から"],["葉","は"],["の"],["付いた","ついた"],["枝","えだ"],["を"],["切って","きって"],["来て","きて"],["道","みち"],["に"],["敷いた","しいた"],["。"]]},{"verse":9,"text":"そして、前を行く者も後に従う者も叫んだ。「ホサナ。主の名によって来られる方に、祝福があるように。","tok":[["そして"],["、"],["前","まえ"],["を"],["行く","いく"],["者","もの"],["も"],["後","あと"],["に"],["従う","したがう"],["者","もの"],["も"],["叫んだ","さけんだ"],["。"],["「"],["ホサナ"],["。"],["主","ぬし"],["の"],["名","な"],["によって"],["来られる","こられる"],["方","かた"],["に"],["、"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":10,"text":"我らの父ダビデの来るべき国に、祝福があるように。いと高きところにホサナ。」","tok":[["我","われ"],["ら"],["の"],["父","ちち"],["ダビデ"],["の"],["来るべき","きたるべき"],["国","くに"],["に"],["、"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["。"],["いと"],["高き","たかき"],["ところ"],["に"],["ホサナ"],["。"],["」"]]},{"verse":11,"text":"こうして、イエスはエルサレムに着いて、神殿の境内に入り、辺りの様子を見て回った後、もはや夕方になったので、十二人を連れてベタニアへ出て行かれた。","tok":[["こう"],["して"],["、"],["イエス"],["は"],["エルサレム"],["に"],["着いて","ついて"],["、"],["神殿","しんでん"],["の"],["境内","けいだい"],["に"],["入り","はいり"],["、"],["辺り","あたり"],["の"],["様子","ようす"],["を"],["見て","みて"],["回った","まわった"],["後","あと"],["、"],["もはや"],["夕方","ゆうがた"],["に"],["なった"],["ので"],["、"],["十二人","じゅうににん"],["を"],["連れて","つれて"],["ベタニア"],["へ"],["出て","でて"],["行かれた","いかれた"],["。"]]},{"verse":12,"text":"翌日、一行がベタニアを出るとき、イエスは空腹を覚えられた。","tok":[["翌日","よくじつ"],["、"],["一行","いっこう"],["が"],["ベタニア"],["を"],["出る","でる"],["とき"],["、"],["イエス"],["は"],["空腹","くうふく"],["を"],["覚えられた","おぼえられた"],["。"]]},{"verse":13,"text":"そこで、葉の茂ったいちじくの木を遠くから見て、実がなってはいないかと近寄られたが、葉のほかは何もなかった。いちじくの季節ではなかったからである。","tok":[["そこ"],["で"],["、"],["葉","は"],["の"],["茂った","しげった"],["いちじく"],["の"],["木","き"],["を"],["遠く","とおく"],["から"],["見て","みて"],["、"],["実","じつ"],["が"],["なって"],["は"],["いない"],["か"],["と"],["近寄られた","ちかよられた"],["が"],["、"],["葉","は"],["の"],["ほか"],["は"],["何","なん"],["も"],["なかった"],["。"],["いちじく"],["の"],["季節","きせつ"],["で"],["は"],["なかった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"イエスはその木に向かって、「今から後いつまでも、お前から実を食べる者がないように」と言われた。弟子たちはこれを聞いていた。","tok":[["イエス"],["は"],["その"],["木","き"],["に"],["向かって","むかって"],["、"],["「"],["今","いま"],["から"],["後","あと"],["いつ"],["まで"],["も"],["、"],["お前","おまえ"],["から"],["実","じつ"],["を"],["食べる","たべる"],["者","もの"],["が"],["ない"],["よう"],["に"],["」"],["と"],["言われた","いわれた"],["。"],["弟子","でし"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["いた"],["。"]]},{"verse":15,"text":"それから、一行はエルサレムに来た。イエスは神殿の境内に入り、そこで売り買いしていた人々を追い出し始め、両替人の台や鳩を売る者の腰掛けをひっくり返された。","tok":[["それ"],["から"],["、"],["一行","いっこう"],["は"],["エルサレム"],["に"],["来た","きた"],["。"],["イエス"],["は"],["神殿","しんでん"],["の"],["境内","けいだい"],["に"],["入り","はいり"],["、"],["そこ"],["で"],["売り買い","うりかい"],["して"],["いた"],["人々","ひとびと"],["を"],["追い出し","おいだし"],["始め","はじめ"],["、"],["両替人","りょうがえにん"],["の"],["台","だい"],["や"],["鳩","はと"],["を"],["売る","うる"],["者","もの"],["の"],["腰掛け","こしかけ"],["を"],["ひっくり返された","ひっくりかえされた"],["。"]]},{"verse":16,"text":"また、境内を通って物を運ぶこともお許しにならなかった。","tok":[["また"],["、"],["境内","けいだい"],["を"],["通って","とおって"],["物","もの"],["を"],["運ぶ","はこぶ"],["こと"],["も"],["お許し","おゆるし"],["に"],["ならなかった"],["。"]]},{"verse":17,"text":"そして、人々に教えて言われた。「こう書いてあるではないか。『わたしの家は、すべての国の人の祈りの家と呼ばれるべきである。』ところが、あなたたちはそれを強盗の巣にしてしまった。」","tok":[["そして"],["、"],["人々","ひとびと"],["に"],["教えて","おしえて"],["言われた","いわれた"],["。"],["「"],["こう"],["書いて","かいて"],["ある"],["で"],["は"],["ない"],["か"],["。"],["『"],["わたし"],["の"],["家","いえ"],["は"],["、"],["すべて"],["の"],["国","くに"],["の"],["人","ひと"],["の"],["祈り","いのり"],["の"],["家","いえ"],["と"],["呼ばれるべきで","よばれるべきで"],["ある"],["。"],["』"],["ところ"],["が"],["、"],["あなた"],["たち"],["は"],["それ"],["を"],["強盗","ごうとう"],["の"],["巣","す"],["に"],["して"],["しまった"],["。"],["」"]]},{"verse":18,"text":"祭司長たちや律法学者たちはこれを聞いて、イエスをどのようにして殺そうかと謀った。群衆が皆その教えに打たれていたので、彼らはイエスを恐れたからである。","tok":[["祭司長","さいしちょう"],["たち"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["イエス"],["を"],["どの"],["よう"],["に"],["して"],["殺そう","ころそう"],["か"],["と"],["謀った","はかった"],["。"],["群衆","ぐんしゅう"],["が"],["皆","みな"],["その"],["教え","おしえ"],["に"],["打たれて","うたれて"],["いた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["を"],["恐れた","おそれた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"夕方になると、イエスは弟子たちと都の外に出て行かれた。","tok":[["夕方","ゆうがた"],["に"],["なる"],["と"],["、"],["イエス"],["は"],["弟子","でし"],["たち"],["と"],["都","と"],["の"],["外","そと"],["に"],["出て","でて"],["行かれた","いかれた"],["。"]]},{"verse":20,"text":"翌朝早く、一行は通りがかりに、あのいちじくの木が根元から枯れているのを見た。","tok":[["翌朝","よくあさ"],["早く","はやく"],["、"],["一行","いっこう"],["は"],["通りがかり","とおりがかり"],["に"],["、"],["あの"],["いちじく"],["の"],["木","き"],["が"],["根元","ねもと"],["から"],["枯れて","かれて"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":21,"text":"そこで、ペトロは思い出してイエスに言った。「先生、御覧ください。あなたが呪われたいちじくの木が、枯れています。」","tok":[["そこ"],["で"],["、"],["ペトロ"],["は"],["思い出して","おもいだして"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["、"],["御覧","ごらん"],["ください"],["。"],["あなた"],["が"],["呪われた","のろわれた"],["いちじく"],["の"],["木","き"],["が"],["、"],["枯れて","かれて"],["います"],["。"],["」"]]},{"verse":22,"text":"そこで、イエスは言われた。「神を信じなさい。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["神","かみ"],["を"],["信じ","しんじ"],["なさい"],["。"]]},{"verse":23,"text":"はっきり言っておく。だれでもこの山に向かい、『立ち上がって、海に飛び込め』と言い、少しも疑わず、自分の言うとおりになると信じるならば、そのとおりになる。","tok":[["はっきり"],["言って","いって"],["おく"],["。"],["だれ"],["で"],["も"],["この"],["山","やま"],["に"],["向かい","むかい"],["、"],["『"],["立ち上がって","たちあがって"],["、"],["海","うみ"],["に"],["飛び込め","とびこめ"],["』"],["と"],["言い","いい"],["、"],["少し","すこし"],["も"],["疑わず","うたがわず"],["、"],["自分","じぶん"],["の"],["言う","いう"],["とおり"],["に"],["なる"],["と"],["信じるならば","しんじるならば"],["、"],["その"],["とおり"],["に"],["なる"],["。"]]},{"verse":24,"text":"だから、言っておく。祈り求めるものはすべて既に得られたと信じなさい。そうすれば、そのとおりになる。","tok":[["だ"],["から"],["、"],["言って","いって"],["おく"],["。"],["祈り求める","いのりもとめる"],["もの"],["は"],["すべて"],["既に","すでに"],["得られた","えられた"],["と"],["信じ","しんじ"],["なさい"],["。"],["そう"],["すれば"],["、"],["その"],["とおり"],["に"],["なる"],["。"]]},{"verse":25,"text":"また、立って祈るとき、だれかに対して何か恨みに思うことがあれば、赦してあげなさい。そうすれば、あなたがたの天の父も、あなたがたの過ちを赦してくださる。」","tok":[["また"],["、"],["立って","たって"],["祈る","いのる"],["とき"],["、"],["だれ"],["か"],["に対して","にたいして"],["何","なん"],["か"],["恨み","うらみ"],["に"],["思う","おもう"],["こと"],["が"],["あれば"],["、"],["赦して","ゆるして"],["あげ"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["も"],["、"],["あなた"],["がた"],["の"],["過ち","あやまち"],["を"],["赦して","ゆるして"],["くださる"],["。"],["」"]]},{"verse":26,"text":"†〔もし赦さないなら、あなたがたの天の父も、あなたがたの過ちをお赦しにならない。〕","tok":[["†"],["〔"],["もし"],["赦さないなら","ゆるさないなら"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["も"],["、"],["あなた"],["がた"],["の"],["過ち","あやまち"],["を"],["お赦し","おゆるし"],["に"],["ならない"],["。"],["〕"]]},{"verse":27,"text":"一行はまたエルサレムに来た。イエスが神殿の境内を歩いておられると、祭司長、律法学者、長老たちがやって来て、","tok":[["一行","いっこう"],["は"],["また"],["エルサレム"],["に"],["来た","きた"],["。"],["イエス"],["が"],["神殿","しんでん"],["の"],["境内","けいだい"],["を"],["歩いて","あるいて"],["おられる"],["と"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["、"],["長老","ちょうろう"],["たち"],["が"],["やって"],["来て","きて"],["、"]]},{"verse":28,"text":"言った。「何の権威で、このようなことをしているのか。だれが、そうする権威を与えたのか。」","tok":[["言った","いった"],["。"],["「"],["何","なん"],["の"],["権威","けんい"],["で"],["、"],["この"],["よう"],["な"],["こと"],["を"],["して"],["いる"],["の"],["か"],["。"],["だれ"],["が"],["、"],["そう"],["する"],["権威","けんい"],["を"],["与えた","あたえた"],["の"],["か"],["。"],["」"]]},{"verse":29,"text":"イエスは言われた。「では、一つ尋ねるから、それに答えなさい。そうしたら、何の権威でこのようなことをするのか、あなたたちに言おう。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["で"],["は"],["、"],["一","ひと"],["つ"],["尋ねる","たずねる"],["から"],["、"],["それ"],["に"],["答え","こたえ"],["なさい"],["。"],["そう"],["したら"],["、"],["何","なん"],["の"],["権威","けんい"],["で"],["この"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["たち"],["に"],["言おう","いおう"],["。"]]},{"verse":30,"text":"ヨハネの洗礼は天からのものだったか、それとも、人からのものだったか。答えなさい。」","tok":[["ヨハネ"],["の"],["洗礼","せんれい"],["は"],["天","てん"],["から"],["の"],["もの"],["だった"],["か"],["、"],["それ"],["と"],["も"],["、"],["人","ひと"],["から"],["の"],["もの"],["だった"],["か"],["。"],["答え","こたえ"],["なさい"],["。"],["」"]]},{"verse":31,"text":"彼らは論じ合った。「『天からのものだ』と言えば、『では、なぜヨハネを信じなかったのか』と言うだろう。","tok":[["彼","かれ"],["ら"],["は"],["論じ合った","ろんじあった"],["。"],["「"],["『"],["天","てん"],["から"],["の"],["もの"],["だ"],["』"],["と"],["言えば","いえば"],["、"],["『"],["で"],["は"],["、"],["なぜ"],["ヨハネ"],["を"],["信じなかった","しんじなかった"],["の"],["か"],["』"],["と"],["言うだろう","ゆうだろう"],["。"]]},{"verse":32,"text":"しかし、『人からのものだ』と言えば……。」彼らは群衆が怖かった。皆が、ヨハネは本当に預言者だと思っていたからである。","tok":[["しかし"],["、"],["『"],["人","ひと"],["から"],["の"],["もの"],["だ"],["』"],["と"],["言えば","いえば"],["…"],["…"],["。"],["」"],["彼","かれ"],["ら"],["は"],["群衆","ぐんしゅう"],["が"],["怖かった","こわかった"],["。"],["皆","みな"],["が"],["、"],["ヨハネ"],["は"],["本当","ほんとう"],["に"],["預言者","よげんしゃ"],["だ"],["と"],["思って","おもって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"そこで、彼らはイエスに、「分からない」と答えた。すると、イエスは言われた。「それなら、何の権威でこのようなことをするのか、わたしも言うまい。」","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["、"],["「"],["分からない","わからない"],["」"],["と"],["答えた","こたえた"],["。"],["する"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["それ"],["なら"],["、"],["何","なん"],["の"],["権威","けんい"],["で"],["この"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["、"],["わたし"],["も"],["言うまい","ゆうまい"],["。"],["」"]]}]
t":"そこで、イエスは彼らに言われた。「まるで強盗にでも向かうように、剣や棒を持って捕らえに来たのか。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["まるで"],["強盗","ごうとう"],["に"],["で"],["も"],["向かう","むかう"],["よう"],["に"],["、"],["剣","けん"],["や"],["棒","ぼう"],["を"],["持って","もって"],["捕らえ","とらえ"],["に"],["来た","きた"],["の"],["か"],["。"]]},{"verse":49,"text":"わたしは毎日、神殿の境内で一緒にいて教えていたのに、あなたたちはわたしを捕らえなかった。しかし、これは聖書の言葉が実現するためである。」","tok":[["わたし"],["は"],["毎日","まいにち"],["、"],["神殿","しんでん"],["の"],["境内","けいだい"],["で"],["一緒","いっしょ"],["に"],["いて"],["教えて","おしえて"],["いた"],["のに"],["、"],["あなた"],["たち"],["は"],["わたし"],["を"],["捕らえなかった","とらえなかった"],["。"],["しかし"],["、"],["これ"],["は"],["聖書","せいしょ"],["の"],["言葉","ことば"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":50,"text":"弟子たちは皆、イエスを見捨てて逃げてしまった。","tok":[["弟子","でし"],["たち"],["は"],["皆","みな"],["、"],["イエス"],["を"],["見捨てて","みすてて"],["逃げて","にげて"],["しまった"],["。"]]},{"verse":51,"text":"一人の若者が、素肌に亜麻布をまとってイエスについて来ていた。人々が捕らえようとすると、","tok":[["一人","ひとり"],["の"],["若者","わかもの"],["が"],["、"],["素肌","すはだ"],["に"],["亜","あ"],["麻布","まふ"],["を"],["まとって"],["イエス"],["について"],["来て","きて"],["いた"],["。"],["人々","ひとびと"],["が"],["捕らえよう","とらえよう"],["と"],["する"],["と"],["、"]]},{"verse":52,"text":"亜麻布を捨てて裸で逃げてしまった。","tok":[["亜","あ"],["麻布","まふ"],["を"],["捨てて","すてて"],["裸","はだか"],["で"],["逃げて","にげて"],["しまった"],["。"]]},{"verse":53,"text":"人々は、イエスを大祭司のところへ連れて行った。祭司長、長老、律法学者たちが皆、集まって来た。","tok":[["人々","ひとびと"],["は"],["、"],["イエス"],["を"],["大","だい"],["祭司","さいし"],["の"],["ところ"],["へ"],["連れて","つれて"],["行った","いった"],["。"],["祭司長","さいしちょう"],["、"],["長老","ちょうろう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["皆","みな"],["、"],["集まって","あつまって"],["来た","きた"],["。"]]},{"verse":54,"text":"ペトロは遠く離れてイエスに従い、大祭司の屋敷の中庭まで入って、下役たちと一緒に座って、火にあたっていた。","tok":[["ペトロ"],["は"],["遠く","とおく"],["離れて","はなれて"],["イエス"],["に"],["従い","したがい"],["、"],["大","だい"],["祭司","さいし"],["の"],["屋敷","やしき"],["の"],["中庭","なかにわ"],["まで"],["入って","はいって"],["、"],["下役","したやく"],["たち"],["と"],["一緒","いっしょ"],["に"],["座って","すわって"],["、"],["火","ひ"],["に"],["あたって"],["いた"],["。"]]},{"verse":55,"text":"祭司長たちと最高法院の全員は、死刑にするためイエスにとって不利な証言を求めたが、得られなかった。","tok":[["祭司長","さいしちょう"],["たち"],["と"],["最高","さいこう"],["法院","ほういん"],["の"],["全員","ぜんいん"],["は"],["、"],["死刑","しけい"],["に"],["する"],["ため"],["イエス"],["にとって"],["不利","ふり"],["な"],["証言","しょうげん"],["を"],["求めた","もとめた"],["が"],["、"],["得られなかった","えられなかった"],["。"]]},{"verse":56,"text":"多くの者がイエスに不利な偽証をしたが、その証言は食い違っていたからである。","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["イエス"],["に"],["不利","ふり"],["な"],["偽証","ぎしょう"],["を"],["した"],["が"],["、"],["その"],["証言","しょうげん"],["は"],["食い違って","くいちがって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":57,"text":"すると、数人の者が立ち上がって、イエスに不利な偽証をした。","tok":[["する"],["と"],["、"],["数人","すうにん"],["の"],["者","もの"],["が"],["立ち上がって","たちあがって"],["、"],["イエス"],["に"],["不利","ふり"],["な"],["偽証","ぎしょう"],["を"],["した"],["。"]]},{"verse":58,"text":"「この男が、『わたしは人間の手で造ったこの神殿を打ち倒し、三日あれば、手で造らない別の神殿を建ててみせる』と言うのを、わたしたちは聞きました。」","tok":[["「"],["この"],["男","おとこ"],["が"],["、"],["『"],["わたし"],["は"],["人間","にんげん"],["の"],["手","て"],["で"],["造った","つくった"],["この"],["神殿","しんでん"],["を"],["打ち倒し","うちたおし"],["、"],["三日","みっか"],["あれば"],["、"],["手","て"],["で"],["造らない","つくらない"],["別","べつ"],["の"],["神殿","しんでん"],["を"],["建てて","たてて"],["みせる"],["』"],["と"],["言う","いう"],["の"],["を"],["、"],["わたしたち"],["は"],["聞きました","ききました"],["。"],["」"]]},{"verse":59,"text":"しかし、この場合も、彼らの証言は食い違った。","tok":[["しかし"],["、"],["この"],["場合","ばあい"],["も"],["、"],["彼","かれ"],["ら"],["の"],["証言","しょうげん"],["は"],["食い違った","くいちがった"],["。"]]},{"verse":60,"text":"そこで、大祭司は立ち上がり、真ん中に進み出て、イエスに尋ねた。「何も答えないのか、この者たちがお前に不利な証言をしているが、どうなのか。」","tok":[["そこ"],["で"],["、"],["大","だい"],["祭司","さいし"],["は"],["立ち上がり","たちあがり"],["、"],["真ん中","まんなか"],["に"],["進み出て","すすみでて"],["、"],["イエス"],["に"],["尋ねた","たずねた"],["。"],["「"],["何","なん"],["も"],["答えない","こたえない"],["の"],["か"],["、"],["この"],["者","もの"],["たち"],["が"],["お前","おまえ"],["に"],["不利","ふり"],["な"],["証言","しょうげん"],["を"],["して"],["いる"],["が"],["、"],["どう"],["な"],["の"],["か"],["。"],["」"]]},{"verse":61,"text":"しかし、イエスは黙り続け何もお答えにならなかった。そこで、重ねて大祭司は尋ね、「お前はほむべき方の子、メシアなのか」と言った。","tok":[["しかし"],["、"],["イエス"],["は"],["黙り","だまり"],["続け","つづけ"],["何","なん"],["も"],["お答え","おこたえ"],["に"],["ならなかった"],["。"],["そこ"],["で"],["、"],["重ねて","かさねて"],["大","だい"],["祭司","さいし"],["は"],["尋ね","たずね"],["、"],["「"],["お前","おまえ"],["は"],["ほ"],["むべき"],["方","ほう"],["の"],["子","こ"],["、"],["メシア"],["な"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":62,"text":"イエスは言われた。「そうです。あなたたちは、人の子が全能の神の右に座り、天の雲に囲まれて来るのを見る。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["そう"],["です"],["。"],["あなた"],["たち"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["全能","ぜんのう"],["の"],["神","かみ"],["の"],["右","みぎ"],["に"],["座り","すわり"],["、"],["天","てん"],["の"],["雲","くも"],["に"],["囲まれて","かこまれて"],["来る","くる"],["の"],["を"],["見る","みる"],["。"],["」"]]},{"verse":63,"text":"大祭司は、衣を引き裂きながら言った。「これでもまだ証人が必要だろうか。","tok":[["大","だい"],["祭司","さいし"],["は"],["、"],["衣","ころも"],["を"],["引き裂き","ひきさき"],["ながら"],["言った","いった"],["。"],["「"],["これ"],["で"],["も"],["まだ"],["証人","しょうにん"],["が"],["必要","ひつよう"],["だろう"],["か"],["。"]]},{"verse":64,"text":"諸君は冒瀆の言葉を聞いた。どう考えるか。」一同は、死刑にすべきだと決議した。","tok":[["諸君","しょくん"],["は"],["冒瀆","ぼうとく"],["の"],["言葉","ことば"],["を"],["聞いた","きいた"],["。"],["どう"],["考える","かんがえる"],["か"],["。"],["」"],["一同","いちどう"],["は"],["、"],["死刑","しけい"],["に"],["すべきだ"],["と"],["決議","けつぎ"],["した"],["。"]]},{"verse":65,"text":"それから、ある者はイエスに唾を吐きかけ、目隠しをしてこぶしで殴りつけ、「言い当ててみろ」と言い始めた。また、下役たちは、イエスを平手で打った。","tok":[["それ"],["から"],["、"],["ある"],["者","もの"],["は"],["イエス"],["に"],["唾","つば"],["を"],["吐き","はき"],["かけ"],["、"],["目隠し","めかくし"],["を"],["して"],["こぶし"],["で"],["殴りつけ","なぐりつけ"],["、"],["「"],["言い当てて","いいあてて"],["みろ"],["」"],["と"],["言い","いい"],["始めた","はじめた"],["。"],["また"],["、"],["下役","したやく"],["たち"],["は"],["、"],["イエス"],["を"],["平手","ひらて"],["で"],["打った","うった"],["。"]]},{"verse":66,"text":"ペトロが下の中庭にいたとき、大祭司に仕える女中の一人が来て、","tok":[["ペトロ"],["が"],["下","した"],["の"],["中庭","なかにわ"],["に"],["いた"],["とき"],["、"],["大","だい"],["祭司","さいし"],["に"],["仕える","つかえる"],["女中","じょちゅう"],["の"],["一人","ひとり"],["が"],["来て","きて"],["、"]]},{"verse":67,"text":"ペトロが火にあたっているのを目にすると、じっと見つめて言った。「あなたも、あのナザレのイエスと一緒にいた。」","tok":[["ペトロ"],["が"],["火","ひ"],["に"],["あたって"],["いる"],["の"],["を"],["目","め"],["に"],["する"],["と"],["、"],["じっと"],["見つめて","みつめて"],["言った","いった"],["。"],["「"],["あなた"],["も"],["、"],["あの"],["ナザレ"],["の"],["イエス"],["と"],["一緒","いっしょ"],["に"],["いた"],["。"],["」"]]},{"verse":68,"text":"しかし、ペトロは打ち消して、「あなたが何のことを言っているのか、わたしには分からないし、見当もつかない」と言った。そして、出口の方へ出て行くと、鶏が鳴いた。","tok":[["しかし"],["、"],["ペトロ"],["は"],["打ち消して","うちけして"],["、"],["「"],["あなた"],["が"],["何","なん"],["の"],["こと"],["を"],["言って","いって"],["いる"],["の"],["か"],["、"],["わたし"],["に"],["は"],["分からない","わからない"],["し"],["、"],["見当","けんとう"],["も"],["つかない"],["」"],["と"],["言った","いった"],["。"],["そして"],["、"],["出口","でぐち"],["の"],["方","ほう"],["へ"],["出て","でて"],["行く","いく"],["と"],["、"],["鶏","にわとり"],["が"],["鳴いた","ないた"],["。"]]},{"verse":69,"text":"女中はペトロを見て、周りの人々に、「この人は、あの人たちの仲間です」とまた言いだした。","tok":[["女中","じょちゅう"],["は"],["ペトロ"],["を"],["見て","みて"],["、"],["周り","まわり"],["の"],["人々","ひとびと"],["に"],["、"],["「"],["この"],["人","ひと"],["は"],["、"],["あの"],["人","ひと"],["たち"],["の"],["仲間","なかま"],["です"],["」"],["と"],["また"],["言い","いい"],["だした"],["。"]]},{"verse":70,"text":"ペトロは、再び打ち消した。しばらくして、今度は、居合わせた人々がペトロに言った。「確かに、お前はあの連中の仲間だ。ガリラヤの者だから。」","tok":[["ペトロ"],["は"],["、"],["再び","ふたたび"],["打ち消した","うちけした"],["。"],["しばらく"],["して"],["、"],["今度","こんど"],["は"],["、"],["居合わせた","いあわせた"],["人々","ひとびと"],["が"],["ペトロ"],["に"],["言った","いった"],["。"],["「"],["確か","たしか"],["に"],["、"],["お前","おまえ"],["は"],["あの"],["連中","れんちゅう"],["の"],["仲間","なかま"],["だ"],["。"],["ガリラヤ"],["の"],["者","もの"],["だ"],["から"],["。"],["」"]]},{"verse":71,"text":"すると、ペトロは呪いの言葉さえ口にしながら、「あなたがたの言っているそんな人は知らない」と誓い始めた。","tok":[["する"],["と"],["、"],["ペトロ"],["は"],["呪い","のろい"],["の"],["言葉","ことば"],["さえ"],["口","くち"],["に"],["し"],["ながら"],["、"],["「"],["あなた"],["がた"],["の"],["言って","いって"],["いる"],["そんな"],["人","ひと"],["は"],["知らない","しらない"],["」"],["と"],["誓い","ちかい"],["始めた","はじめた"],["。"]]},{"verse":72,"text":"するとすぐ、鶏が再び鳴いた。ペトロは、「鶏が二度鳴く前に、あなたは三度わたしを知らないと言うだろう」とイエスが言われた言葉を思い出して、いきなり泣きだした。","tok":[["する"],["と"],["すぐ"],["、"],["鶏","にわとり"],["が"],["再び","ふたたび"],["鳴いた","ないた"],["。"],["ペトロ"],["は"],["、"],["「"],["鶏","にわとり"],["が"],["二","に"],["度","ど"],["鳴く","なく"],["前","まえ"],["
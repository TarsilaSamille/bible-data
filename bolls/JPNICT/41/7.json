[{"verse":1,"text":"ファリサイ派の人々と数人の律法学者たちが、エルサレムから来て、イエスのもとに集まった。","tok":[["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["と"],["数人","かずひと"],["の"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["、"],["エルサレム"],["から"],["来て","きて"],["、"],["イエス"],["の"],["もと"],["に"],["集まった","あつまった"],["。"]]},{"verse":2,"text":"そして、イエスの弟子たちの中に汚れた手、つまり洗わない手で食事をする者がいるのを見た。","tok":[["そして"],["、"],["イエス"],["の"],["弟子","でし"],["たち"],["の"],["中","なか"],["に"],["汚れた","よごれた"],["手","て"],["、"],["つまり"],["洗わない","あらわない"],["手","て"],["で"],["食事","しょくじ"],["を"],["する"],["者","もの"],["が"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":3,"text":"――ファリサイ派の人々をはじめユダヤ人は皆、昔の人の言い伝えを固く守って、念入りに手を洗ってからでないと食事をせず、","tok":[["―"],["―"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["を"],["はじめ"],["ユダヤ人","ゆだやじん"],["は"],["皆","みな"],["、"],["昔","むかし"],["の"],["人","ひと"],["の"],["言い伝え","いいつたえ"],["を"],["固く","かたく"],["守って","まもって"],["、"],["念入り","ねんいり"],["に"],["手","て"],["を"],["洗って","あらって"],["から"],["で"],["ない"],["と"],["食事","しょくじ"],["を"],["せず"],["、"]]},{"verse":4,"text":"また、市場から帰ったときには、身を清めてからでないと食事をしない。そのほか、杯、鉢、銅の器や寝台を洗うことなど、昔から受け継いで固く守っていることがたくさんある。――","tok":[["また"],["、"],["市場","しじょう"],["から"],["帰った","かえった"],["とき"],["に"],["は"],["、"],["身","み"],["を"],["清めて","きよめて"],["から"],["で"],["ない"],["と"],["食事","しょくじ"],["を"],["しない"],["。"],["その"],["ほか"],["、"],["杯","さかずき"],["、"],["鉢","ばち"],["、"],["銅","どう"],["の"],["器","うつわ"],["や"],["寝台","しんだい"],["を"],["洗う","あらう"],["こと"],["など"],["、"],["昔","むかし"],["から"],["受け継いで","うけついで"],["固く","かたく"],["守って","まもって"],["いる"],["こと"],["が"],["たくさん"],["ある"],["。"],["―"],["―"]]},{"verse":5,"text":"そこで、ファリサイ派の人々と律法学者たちが尋ねた。「なぜ、あなたの弟子たちは昔の人の言い伝えに従って歩まず、汚れた手で食事をするのですか。」","tok":[["そこ"],["で"],["、"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["と"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["尋ねた","たずねた"],["。"],["「"],["なぜ"],["、"],["あなた"],["の"],["弟子","でし"],["たち"],["は"],["昔","むかし"],["の"],["人","ひと"],["の"],["言い伝え","いいつたえ"],["に"],["従って","したがって"],["歩まず","あゆまず"],["、"],["汚れた","よごれた"],["手","て"],["で"],["食事","しょくじ"],["を"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":6,"text":"イエスは言われた。「イザヤは、あなたたちのような偽善者のことを見事に預言したものだ。彼はこう書いている。『この民は口先ではわたしを敬うが、その心はわたしから遠く離れている。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["イザヤ"],["は"],["、"],["あなた"],["たち"],["の"],["よう"],["な"],["偽善者","ぎぜんしゃ"],["の"],["こと"],["を"],["見事","みごと"],["に"],["預言","よげん"],["した"],["もの"],["だ"],["。"],["彼","かれ"],["は"],["こう"],["書いて","かいて"],["いる"],["。"],["『"],["この"],["民","みん"],["は"],["口先","くちさき"],["で"],["は"],["わたし"],["を"],["敬う","うやまう"],["が"],["、"],["その"],["心","こころ"],["は"],["わたし"],["から"],["遠く","とおく"],["離れて","はなれて"],["いる"],["。"]]},{"verse":7,"text":"人間の戒めを教えとしておしえ、むなしくわたしをあがめている。』","tok":[["人間","にんげん"],["の"],["戒め","いましめ"],["を"],["教え","おしえ"],["として"],["おしえ"],["、"],["むなしく"],["わたし"],["を"],["あがめて"],["いる"],["。"],["』"]]},{"verse":8,"text":"あなたたちは神の掟を捨てて、人間の言い伝えを固く守っている。」","tok":[["あなた"],["たち"],["は"],["神","かみ"],["の"],["掟","おきて"],["を"],["捨てて","すてて"],["、"],["人間","にんげん"],["の"],["言い伝え","いいつたえ"],["を"],["固く","かたく"],["守って","まもって"],["いる"],["。"],["」"]]},{"verse":9,"text":"更に、イエスは言われた。「あなたたちは自分の言い伝えを大事にして、よくも神の掟をないがしろにしたものである。","tok":[["更に","さらに"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["たち"],["は"],["自分","じぶん"],["の"],["言い伝え","いいつたえ"],["を"],["大事","だいじ"],["に"],["して"],["、"],["よく"],["も"],["神","かみ"],["の"],["掟","おきて"],["を"],["ないがしろ"],["に"],["した"],["もの"],["で"],["ある"],["。"]]},{"verse":10,"text":"モーセは、『父と母を敬え』と言い、『父または母をののしる者は死刑に処せられるべきである』とも言っている。","tok":[["モーセ"],["は"],["、"],["『"],["父","ちち"],["と"],["母","はは"],["を"],["敬え","うやまえ"],["』"],["と"],["言い","いい"],["、"],["『"],["父","ちち"],["また"],["は"],["母","はは"],["を"],["ののしる"],["者","もの"],["は"],["死刑","しけい"],["に"],["処せられるべきで","しょせられるべきで"],["ある"],["』"],["と"],["も"],["言って","いって"],["いる"],["。"]]},{"verse":11,"text":"それなのに、あなたたちは言っている。『もし、だれかが父または母に対して、「あなたに差し上げるべきものは、何でもコルバン、つまり神への供え物です」と言えば、","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["たち"],["は"],["言って","いって"],["いる"],["。"],["『"],["もし"],["、"],["だれ"],["か"],["が"],["父","ちち"],["また"],["は"],["母","はは"],["に対して","にたいして"],["、"],["「"],["あなた"],["に"],["差し上げるべき","さしあげるべき"],["もの"],["は"],["、"],["何","なん"],["で"],["も"],["コルバン"],["、"],["つまり"],["神","かみ"],["へ"],["の"],["供え物","そなえもの"],["です"],["」"],["と"],["言えば","いえば"],["、"]]},{"verse":12,"text":"その人はもはや父または母に対して何もしないで済むのだ』と。","tok":[["その"],["人","ひと"],["は"],["もはや"],["父","ちち"],["また"],["は"],["母","はは"],["に対して","にたいして"],["何","なん"],["も"],["しないで"],["済む","すむ"],["の"],["だ"],["』"],["と"],["。"]]},{"verse":13,"text":"こうして、あなたたちは、受け継いだ言い伝えで神の言葉を無にしている。また、これと同じようなことをたくさん行っている。」","tok":[["こう"],["して"],["、"],["あなた"],["たち"],["は"],["、"],["受け継いだ","うけついだ"],["言い伝え","いいつたえ"],["で"],["神","かみ"],["の"],["言葉","ことば"],["を"],["無","む"],["に"],["して"],["いる"],["。"],["また"],["、"],["これ"],["と"],["同じ","おなじ"],["よう"],["な"],["こと"],["を"],["たくさん"],["行って","いって"],["いる"],["。"],["」"]]},{"verse":14,"text":"それから、イエスは再び群衆を呼び寄せて言われた。「皆、わたしの言うことを聞いて悟りなさい。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["再び","ふたたび"],["群衆","ぐんしゅう"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["。"],["「"],["皆","みな"],["、"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["悟り","さとり"],["なさい"],["。"]]},{"verse":15,"text":"外から人の体に入るもので人を汚すことができるものは何もなく、人の中から出て来るものが、人を汚すのである。」","tok":[["外","そと"],["から"],["人","ひと"],["の"],["体","からだ"],["に"],["入る","はいる"],["もの"],["で"],["人","ひと"],["を"],["汚す","けがす"],["こと"],["が"],["できる"],["もの"],["は"],["何","なん"],["も"],["なく"],["、"],["人","ひと"],["の"],["中","なか"],["から"],["出て","でて"],["来る","くる"],["もの"],["が"],["、"],["人","ひと"],["を"],["汚す","けがす"],["ので"],["ある"],["。"],["」"]]},{"verse":16,"text":"†〔聞く耳のある者は聞きなさい。〕","tok":[["†"],["〔"],["聞く","きく"],["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞き","きき"],["なさい"],["。"],["〕"]]},{"verse":17,"text":"イエスが群衆と別れて家に入られると、弟子たちはこのたとえについて尋ねた。","tok":[["イエス"],["が"],["群衆","ぐんしゅう"],["と"],["別れて","わかれて"],["家","いえ"],["に"],["入られる","はいられる"],["と"],["、"],["弟子","でし"],["たち"],["は"],["この"],["たとえ"],["について"],["尋ねた","たずねた"],["。"]]},{"verse":18,"text":"イエスは言われた。「あなたがたも、そんなに物分かりが悪いのか。すべて外から人の体に入るものは、人を汚すことができないことが分からないのか。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["も"],["、"],["そんな"],["に"],["物分かり","ものわかり"],["が"],["悪い","わるい"],["の"],["か"],["。"],["すべて"],["外","そと"],["から"],["人","ひと"],["の"],["体","からだ"],["に"],["入る","はいる"],["もの"],["は"],["、"],["人","ひと"],["を"],["汚す","けがす"],["こと"],["が"],["できない"],["こと"],["が"],["分からない","わからない"],["の"],["か"],["。"]]},{"verse":19,"text":"それは人の心の中に入るのではなく、腹の中に入り、そして外に出される。こうして、すべての食べ物は清められる。」","tok":[["それ"],["は"],["人","ひと"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["入る","はいる"],["ので"],["は"],["なく"],["、"],["腹","はら"],["の"],["中","なか"],["に"],["入り","はいり"],["、"],["そして"],["外","そと"],["に"],["出される","だされる"],["。"],["こう"],["して"],["、"],["すべて"],["の"],["食べ物","たべもの"],["は"],["清められる","きよめられる"],["。"],["」"]]},{"verse":20,"text":"更に、次のように言われた。「人から出て来るものこそ、人を汚す。","tok":[["更に","さらに"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["から"],["出て","でて"],["来る","くる"],["もの"],["こそ"],["、"],["人","ひと"],["を"],["汚す","よごす"],["。"]]},{"verse":21,"text":"中から、つまり人間の心から、悪い思いが出て来るからである。みだらな行い、盗み、殺意、","tok":[["中","なか"],["から"],["、"],["つまり"],["人間","にんげん"],["の"],["心","こころ"],["から"],["、"],["悪い","わるい"],["思い","おもい"],["が"],["出て","でて"],["来る","くる"],["から"],["で"],["ある"],["。"],["みだら"],["な"],["行い","おこない"],["、"],["盗み","ぬすみ"],["、"],["殺意","さつい"],["、"]]},{"verse":22,"text":"姦淫、貪欲、悪意、詐欺、好色、ねたみ、悪口、傲慢、無分別など、","tok":[["姦淫","かんいん"],["、"],["貪欲","とんよく"],["、"],["悪意","あくい"],["、"],["詐欺","さぎ"],["、"],["好色","こうしょく"],["、"],["ねたみ"],["、"],["悪口","わるぐち"],["、"],["傲慢","ごうまん"],["、"],["無分別","むふんべつ"],["など"],["、"]]},{"verse":23,"text":"これらの悪はみな中から出て来て、人を汚すのである。」","tok":[["これ"],["ら"],["の"],["悪","あく"],["は"],["みな中","みなちゅう"],["から"],["出て","でて"],["来て","きて"],["、"],["人","ひと"],["を"],["汚す","けがす"],["ので"],["ある"],["。"],["」"]]},{"verse":24,"text":"イエスはそこを立ち去って、ティルスの地方に行かれた。ある家に入り、だれにも知られたくないと思っておられたが、人々に気づかれてしまった。","tok":[["イエス"],["は"],["そこ"],["を"],["立ち去って","たちさって"],["、"],["ティルス"],["の"],["地方","ちほう"],["に"],["行かれた","いかれた"],["。"],["ある"],["家","いえ"],["に"],["入り","はいり"],["、"],["だれ"],["に"],["も"],["知られたく","しられたく"],["ない"],["と"],["思って","おもって"],["おられた"],["が"],["、"],["人々","ひとびと"],["に"],["気づかれて","きづかれて"],["しまった"],["。"]]},{"verse":25,"text":"汚れた霊に取りつかれた幼い娘を持つ女が、すぐにイエスのことを聞きつけ、来てその足もとにひれ伏した。","tok":[["汚れた","よごれた"],["霊","れい"],["に"],["取りつかれた","とりつかれた"],["幼い","おさない"],["娘","むすめ"],["を"],["持つ","もつ"],["女","おんな"],["が"],["、"],["すぐ"],["に"],["イエス"],["の"],["こと"],["を"],["聞きつけ","ききつけ"],["、"],["来て","きて"],["その"],["足もと","あしもと"],["に"],["ひれ伏した","ひれふした"],["。"]]},{"verse":26,"text":"女はギリシア人でシリア‧フェニキアの生まれであったが、娘から悪霊を追い出してくださいと頼んだ。","tok":[["女","おんな"],["は"],["ギリシア"],["人","にん"],["で"],["シリア"],["‧"],["フェニキア"],["の"],["生まれ","うまれ"],["で"],["あった"],["が"],["、"],["娘","むすめ"],["から"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["ください"],["と"],["頼んだ","たのんだ"],["。"]]},{"verse":27,"text":"イエスは言われた。「まず、子供たちに十分食べさせなければならない。子供たちのパンを取って、小犬にやってはいけない。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["まず"],["、"],["子供","こども"],["たち"],["に"],["十分","じゅうぶん"],["食べさせなければ","たべさせなければ"],["ならない"],["。"],["子供","こども"],["たち"],["の"],["パン"],["を"],["取って","とって"],["、"],["小犬","こいぬ"],["に"],["やって"],["は"],["いけない"],["。"],["」"]]},{"verse":28,"text":"ところが、女は答えて言った。「主よ、しかし、食卓の下の小犬も、子供のパン屑はいただきます。」","tok":[["ところ"],["が"],["、"],["女","おんな"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["しかし"],["、"],["食卓","しょくたく"],["の"],["下","した"],["の"],["小犬","こいぬ"],["も"],["、"],["子供","こども"],["の"],["パン"],["屑","くず"],["は"],["いただきます"],["。"],["」"]]},{"verse":29,"text":"そこで、イエスは言われた。「それほど言うなら、よろしい。家に帰りなさい。悪霊はあなたの娘からもう出てしまった。」","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["それ"],["ほど"],["言うなら","ゆうなら"],["、"],["よろしい"],["。"],["家","いえ"],["に"],["帰り","かえり"],["なさい"],["。"],["悪霊","あくりょう"],["は"],["あなた"],["の"],["娘","むすめ"],["から"],["もう"],["出て","でて"],["しまった"],["。"],["」"]]},{"verse":30,"text":"女が家に帰ってみると、その子は床の上に寝ており、悪霊は出てしまっていた。","tok":[["女","おんな"],["が"],["家","いえ"],["に"],["帰って","かえって"],["みる"],["と"],["、"],["その"],["子","こ"],["は"],["床","ゆか"],["の"],["上","うえ"],["に"],["寝て","ねて"],["おり"],["、"],["悪霊","あくりょう"],["は"],["出て","でて"],["しまって"],["いた"],["。"]]},{"verse":31,"text":"それからまた、イエスはティルスの地方を去り、シドンを経てデカポリス地方を通り抜け、ガリラヤ湖へやって来られた。","tok":[["それ"],["から"],["また"],["、"],["イエス"],["は"],["ティルス"],["の"],["地方","ちほう"],["を"],["去り","さり"],["、"],["シドン"],["を"],["経て","へて"],["デカポリス"],["地方","ちほう"],["を"],["通り抜け","とおりぬけ"],["、"],["ガリラヤ"],["湖","こ"],["へ"],["やって"],["来られた","こられた"],["。"]]},{"verse":32,"text":"人々は耳が聞こえず舌の回らない人を連れて来て、その上に手を置いてくださるようにと願った。","tok":[["人々","ひとびと"],["は"],["耳","みみ"],["が"],["聞こえず","きこえず"],["舌","した"],["の"],["回らない","まわらない"],["人","ひと"],["を"],["連れて","つれて"],["来て","きて"],["、"],["その"],["上","うえ"],["に"],["手","て"],["を"],["置いて","おいて"],["くださる"],["よう"],["に"],["と"],["願った","ねがった"],["。"]]},{"verse":33,"text":"そこで、イエスはこの人だけを群衆の中から連れ出し、指をその両耳に差し入れ、それから唾をつけてその舌に触れられた。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["この"],["人","ひと"],["だけ"],["を"],["群衆","ぐんしゅう"],["の"],["中","なか"],["から"],["連れ出し","つれだし"],["、"],["指","ゆび"],["を"],["その"],["両耳","りょうじ"],["に"],["差し入れ","さしいれ"],["、"],["それ"],["から"],["唾","つば"],["を"],["つけて"],["その"],["舌","した"],["に"],["触れられた","ふれられた"],["。"]]},{"verse":34,"text":"そして、天を仰いで深く息をつき、その人に向かって、「エッファタ」と言われた。これは、「開け」という意味である。","tok":[["そして"],["、"],["天","てん"],["を"],["仰いで","あおいで"],["深く","ふかく"],["息","いき"],["を"],["つき"],["、"],["その"],["人","ひと"],["に"],["向かって","むかって"],["、"],["「"],["エッファタ"],["」"],["と"],["言われた","いわれた"],["。"],["これ"],["は"],["、"],["「"],["開け","あけ"],["」"],["と"],["いう"],["意味","いみ"],["で"],["ある"],["。"]]},{"verse":35,"text":"すると、たちまち耳が開き、舌のもつれが解け、はっきり話すことができるようになった。","tok":[["する"],["と"],["、"],["たちまち"],["耳","みみ"],["が"],["開き","ひらき"],["、"],["舌","した"],["の"],["もつれ"],["が"],["解け","とけ"],["、"],["はっきり"],["話す","はなす"],["こと"],["が"],["できる"],["よう"],["に"],["なった"],["。"]]},{"verse":36,"text":"イエスは人々に、だれにもこのことを話してはいけない、と口止めをされた。しかし、イエスが口止めをされればされるほど、人々はかえってますます言い広めた。","tok":[["イエス"],["は"],["人々","ひとびと"],["に"],["、"],["だれ"],["に"],["も"],["この"],["こと"],["を"],["話して","はなして"],["は"],["いけない"],["、"],["と"],["口止め","くちどめ"],["を"],["された"],["。"],["しかし"],["、"],["イエス"],["が"],["口止め","くちどめ"],["を"],["されれば"],["される"],["ほど"],["、"],["人々","ひとびと"],["は"],["かえって"],["ますます"],["言い広めた","いいひろめた"],["。"]]},{"verse":37,"text":"そして、すっかり驚いて言った。「この方のなさったことはすべて、すばらしい。耳の聞こえない人を聞こえるようにし、口の利けない人を話せるようにしてくださる。」","tok":[["そして"],["、"],["すっかり"],["驚いて","おどろいて"],["言った","いった"],["。"],["「"],["この"],["方","かた"],["の"],["なさった"],["こと"],["は"],["すべて"],["、"],["すばらしい"],["。"
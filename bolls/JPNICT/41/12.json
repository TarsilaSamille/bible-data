[{"verse":1,"text":"イエスは、たとえで彼らに話し始められた。「ある人がぶどう園を作り、垣を巡らし、搾り場を掘り、見張りのやぐらを立て、これを農夫たちに貸して旅に出た。","tok":[["イエス"],["は"],["、"],["たとえ"],["で"],["彼","かれ"],["ら"],["に"],["話し","はなし"],["始められた","はじめられた"],["。"],["「"],["ある"],["人","ひと"],["が"],["ぶどう園","ぶどうえん"],["を"],["作り","つくり"],["、"],["垣","かき"],["を"],["巡らし","めぐらし"],["、"],["搾り","しぼり"],["場","ば"],["を"],["掘り","ほり"],["、"],["見張り","みはり"],["の"],["やぐら"],["を"],["立て","たて"],["、"],["これ"],["を"],["農夫","のうふ"],["たち"],["に"],["貸して","かして"],["旅","たび"],["に"],["出た","でた"],["。"]]},{"verse":2,"text":"収穫の時になったので、ぶどう園の収穫を受け取るために、僕を農夫たちのところへ送った。","tok":[["収穫","しゅうかく"],["の"],["時","とき"],["に"],["なった"],["ので"],["、"],["ぶどう園","ぶどうえん"],["の"],["収穫","しゅうかく"],["を"],["受け取る","うけとる"],["ため"],["に"],["、"],["僕","ぼく"],["を"],["農夫","のうふ"],["たち"],["の"],["ところ"],["へ"],["送った","おくった"],["。"]]},{"verse":3,"text":"だが、農夫たちは、この僕を捕まえて袋だたきにし、何も持たせないで帰した。","tok":[["だ"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["、"],["この"],["僕","ぼく"],["を"],["捕まえて","つかまえて"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["何","なん"],["も"],["持たせないで","もたせないで"],["帰した","かえした"],["。"]]},{"verse":4,"text":"そこでまた、他の僕を送ったが、農夫たちはその頭を殴り、侮辱した。","tok":[["そこ"],["で"],["また"],["、"],["他","た"],["の"],["僕","ぼく"],["を"],["送った","おくった"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["その"],["頭","あたま"],["を"],["殴り","なぐり"],["、"],["侮辱","ぶじょく"],["した"],["。"]]},{"verse":5,"text":"更に、もう一人を送ったが、今度は殺した。そのほかに多くの僕を送ったが、ある者は殴られ、ある者は殺された。","tok":[["更に","さらに"],["、"],["もう"],["一人","ひとり"],["を"],["送った","おくった"],["が"],["、"],["今度","こんど"],["は"],["殺した","ころした"],["。"],["その"],["ほか"],["に"],["多く","おおく"],["の"],["僕","ぼく"],["を"],["送った","おくった"],["が"],["、"],["ある"],["者","もの"],["は"],["殴られ","なぐられ"],["、"],["ある"],["者","もの"],["は"],["殺された","ころされた"],["。"]]},{"verse":6,"text":"まだ一人、愛する息子がいた。『わたしの息子なら敬ってくれるだろう』と言って、最後に息子を送った。","tok":[["まだ"],["一人","ひとり"],["、"],["愛する","あいする"],["息子","むすこ"],["が"],["いた"],["。"],["『"],["わたし"],["の"],["息子","むすこ"],["なら"],["敬って","うやまって"],["くれるだろう"],["』"],["と"],["言って","いって"],["、"],["最後","さいご"],["に"],["息子","むすこ"],["を"],["送った","おくった"],["。"]]},{"verse":7,"text":"農夫たちは話し合った。『これは跡取りだ。さあ、殺してしまおう。そうすれば、相続財産は我々のものになる。』","tok":[["農夫","のうふ"],["たち"],["は"],["話し合った","はなしあった"],["。"],["『"],["これ"],["は"],["跡取り","あととり"],["だ"],["。"],["さあ"],["、"],["殺して","ころして"],["しまおう"],["。"],["そう"],["すれば"],["、"],["相続","そうぞく"],["財産","ざいさん"],["は"],["我々","われわれ"],["の"],["もの"],["に"],["なる"],["。"],["』"]]},{"verse":8,"text":"そして、息子を捕まえて殺し、ぶどう園の外にほうり出してしまった。","tok":[["そして"],["、"],["息子","むすこ"],["を"],["捕まえて","つかまえて"],["殺し","ころし"],["、"],["ぶどう園","ぶどうえん"],["の"],["外","そと"],["に"],["ほうり出して","ほうりだして"],["しまった"],["。"]]},{"verse":9,"text":"さて、このぶどう園の主人は、どうするだろうか。戻って来て農夫たちを殺し、ぶどう園をほかの人たちに与えるにちがいない。","tok":[["さて"],["、"],["この"],["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["は"],["、"],["どう"],["するだろう"],["か"],["。"],["戻って","もどって"],["来て","きて"],["農夫","のうふ"],["たち"],["を"],["殺し","ころし"],["、"],["ぶどう園","ぶどうえん"],["を"],["ほか"],["の"],["人","ひと"],["たち"],["に"],["与える","あたえる"],["に"],["ちがい"],["ない"],["。"]]},{"verse":10,"text":"聖書にこう書いてあるのを読んだことがないのか。『家を建てる者の捨てた石、これが隅の親石となった。","tok":[["聖書","せいしょ"],["に"],["こう"],["書いて","かいて"],["ある"],["の"],["を"],["読んだ","よんだ"],["こと"],["が"],["ない"],["の"],["か"],["。"],["『"],["家","いえ"],["を"],["建てる","たてる"],["者","もの"],["の"],["捨てた","すてた"],["石","いし"],["、"],["これ"],["が"],["隅","すみ"],["の"],["親","おや"],["石","いし"],["と"],["なった"],["。"]]},{"verse":11,"text":"これは、主がなさったことで、わたしたちの目には不思議に見える。』」","tok":[["これ"],["は"],["、"],["主","ぬし"],["が"],["なさった"],["こと"],["で"],["、"],["わたしたち"],["の"],["目","め"],["に"],["は"],["不思議","ふしぎ"],["に"],["見える","みえる"],["。"],["』"],["」"]]},{"verse":12,"text":"彼らは、イエスが自分たちに当てつけてこのたとえを話されたと気づいたので、イエスを捕らえようとしたが、群衆を恐れた。それで、イエスをその場に残して立ち去った。","tok":[["彼","かれ"],["ら"],["は"],["、"],["イエス"],["が"],["自分","じぶん"],["たち"],["に"],["当てつけて","あてつけて"],["この"],["たとえ"],["を"],["話された","はなされた"],["と"],["気づいた","きづいた"],["ので"],["、"],["イエス"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["が"],["、"],["群衆","ぐんしゅう"],["を"],["恐れた","おそれた"],["。"],["それ"],["で"],["、"],["イエス"],["を"],["その"],["場","ば"],["に"],["残して","のこして"],["立ち去った","たちさった"],["。"]]},{"verse":13,"text":"さて、人々は、イエスの言葉じりをとらえて陥れようとして、ファリサイ派やヘロデ派の人を数人イエスのところに遣わした。","tok":[["さて"],["、"],["人々","ひとびと"],["は"],["、"],["イエス"],["の"],["言葉じり","ことばじり"],["を"],["とらえて"],["陥れよう","おとしいれよう"],["として"],["、"],["ファリサイ"],["派","は"],["や"],["ヘロデ派","へろでは"],["の"],["人","ひと"],["を"],["数人","すうにん"],["イエス"],["の"],["ところ"],["に"],["遣わした","つかわした"],["。"]]},{"verse":14,"text":"彼らは来て、イエスに言った。「先生、わたしたちは、あなたが真実な方で、だれをもはばからない方であることを知っています。人々を分け隔てせず、真理に基づいて神の道を教えておられるからです。ところで、皇帝に税金を納めるのは、律法に適っているでしょうか、適っていないでしょうか。納めるべきでしょうか、納めてはならないのでしょうか。」","tok":[["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["、"],["わたしたち"],["は"],["、"],["あなた"],["が"],["真実","しんじつ"],["な"],["方","かた"],["で"],["、"],["だれ"],["を"],["も"],["はばからない"],["方","ほう"],["で"],["ある"],["こと"],["を"],["知って","しって"],["います"],["。"],["人々","ひとびと"],["を"],["分け隔てせず","わけへだてせず"],["、"],["真理","しんり"],["に"],["基づいて","もとづいて"],["神","かみ"],["の"],["道","みち"],["を"],["教えて","おしえて"],["おられる"],["から"],["です"],["。"],["ところ"],["で"],["、"],["皇帝","こうてい"],["に"],["税金","ぜいきん"],["を"],["納める","おさめる"],["の"],["は"],["、"],["律法","りっぽう"],["に"],["適って","かなって"],["いるでしょう"],["か"],["、"],["適って","かなって"],["いないでしょう"],["か"],["。"],["納めるべきでしょう","おさめるべきでしょう"],["か"],["、"],["納めて","おさめて"],["は"],["ならない"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":15,"text":"イエスは、彼らの下心を見抜いて言われた。「なぜ、わたしを試そうとするのか。デナリオン銀貨を持って来て見せなさい。」","tok":[["イエス"],["は"],["、"],["彼","かれ"],["ら"],["の"],["下心","したごころ"],["を"],["見抜いて","みぬいて"],["言われた","いわれた"],["。"],["「"],["なぜ"],["、"],["わたし"],["を"],["試そう","ためそう"],["と"],["する"],["の"],["か"],["。"],["デナリオン"],["銀貨","ぎんか"],["を"],["持って","もって"],["来て","きて"],["見せ","みせ"],["なさい"],["。"],["」"]]},{"verse":16,"text":"彼らがそれを持って来ると、イエスは、「これは、だれの肖像と銘か」と言われた。彼らが、「皇帝のものです」と言うと、","tok":[["彼","かれ"],["ら"],["が"],["それ"],["を"],["持って","もって"],["来る","くる"],["と"],["、"],["イエス"],["は"],["、"],["「"],["これ"],["は"],["、"],["だれ"],["の"],["肖像","しょうぞう"],["と"],["銘","めい"],["か"],["」"],["と"],["言われた","いわれた"],["。"],["彼","かれ"],["ら"],["が"],["、"],["「"],["皇帝","こうてい"],["の"],["もの"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":17,"text":"イエスは言われた。「皇帝のものは皇帝に、神のものは神に返しなさい。」彼らは、イエスの答えに驚き入った。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["皇帝","こうてい"],["の"],["もの"],["は"],["皇帝","こうてい"],["に"],["、"],["神","かみ"],["の"],["もの"],["は"],["神","かみ"],["に"],["返し","かえし"],["なさい"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["イエス"],["の"],["答え","こたえ"],["に"],["驚き入った","おどろきいった"],["。"]]},{"verse":18,"text":"復活はないと言っているサドカイ派の人々が、イエスのところへ来て尋ねた。","tok":[["復活","ふっかつ"],["は"],["ない"],["と"],["言って","いって"],["いる"],["サドカイ"],["派","は"],["の"],["人々","ひとびと"],["が"],["、"],["イエス"],["の"],["ところ"],["へ"],["来て","きて"],["尋ねた","たずねた"],["。"]]},{"verse":19,"text":"「先生、モーセはわたしたちのために書いています。『ある人の兄が死に、妻を後に残して子がない場合、その弟は兄嫁と結婚して、兄の跡継ぎをもうけねばならない』と。","tok":[["「"],["先生","せんせい"],["、"],["モーセ"],["は"],["わたしたち"],["の"],["ため"],["に"],["書いて","かいて"],["います"],["。"],["『"],["ある"],["人","ひと"],["の"],["兄","あに"],["が"],["死に","しに"],["、"],["妻","つま"],["を"],["後","あと"],["に"],["残して","のこして"],["子","こ"],["が"],["ない"],["場合","ばあい"],["、"],["その"],["弟","おとうと"],["は"],["兄嫁","あによめ"],["と"],["結婚","けっこん"],["して"],["、"],["兄","あに"],["の"],["跡継ぎ","あとつぎ"],["を"],["もうけねば"],["ならない"],["』"],["と"],["。"]]},{"verse":20,"text":"ところで、七人の兄弟がいました。長男が妻を迎えましたが、跡継ぎを残さないで死にました。","tok":[["ところ"],["で"],["、"],["七人","しちにん"],["の"],["兄弟","きょうだい"],["が"],["いました"],["。"],["長男","ちょうなん"],["が"],["妻","つま"],["を"],["迎えました","むかえました"],["が"],["、"],["跡継ぎ","あとつぎ"],["を"],["残さないで","のこさないで"],["死にました","しにました"],["。"]]},{"verse":21,"text":"次男がその女を妻にしましたが、跡継ぎを残さないで死に、三男も同様でした。","tok":[["次男","じなん"],["が"],["その"],["女","おんな"],["を"],["妻","つま"],["に"],["しました"],["が"],["、"],["跡継ぎ","あとつぎ"],["を"],["残さないで","のこさないで"],["死に","しに"],["、"],["三男","さんなん"],["も"],["同様","どうよう"],["でした"],["。"]]},{"verse":22,"text":"こうして、七人とも跡継ぎを残しませんでした。最後にその女も死にました。","tok":[["こう"],["して"],["、"],["七人","しちにん"],["とも"],["跡継ぎ","あとつぎ"],["を"],["残しませんでした","のこしませんでした"],["。"],["最後","さいご"],["に"],["その"],["女","おんな"],["も"],["死にました","しにました"],["。"]]},{"verse":23,"text":"復活の時、彼らが復活すると、その女はだれの妻になるのでしょうか。七人ともその女を妻にしたのです。」","tok":[["復活","ふっかつ"],["の"],["時","とき"],["、"],["彼","かれ"],["ら"],["が"],["復活","ふっかつ"],["する"],["と"],["、"],["その"],["女","おんな"],["は"],["だれ"],["の"],["妻","つま"],["に"],["なる"],["の"],["でしょう"],["か"],["。"],["七人","ななにん"],["とも"],["その"],["女","おんな"],["を"],["妻","つま"],["に"],["した"],["の"],["です"],["。"],["」"]]},{"verse":24,"text":"イエスは言われた。「あなたたちは聖書も神の力も知らないから、そんな思い違いをしているのではないか。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["たち"],["は"],["聖書","せいしょ"],["も"],["神","かみ"],["の"],["力","ちから"],["も"],["知らない","しらない"],["から"],["、"],["そんな"],["思い違い","おもいちがい"],["を"],["して"],["いる"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":25,"text":"死者の中から復活するときには、めとることも嫁ぐこともなく、天使のようになるのだ。","tok":[["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["する"],["とき"],["に"],["は"],["、"],["めとる"],["こと"],["も"],["嫁ぐ","とつぐ"],["こと"],["も"],["なく"],["、"],["天使","てんし"],["の"],["よう"],["に"],["なる"],["の"],["だ"],["。"]]},{"verse":26,"text":"死者が復活することについては、モーセの書の『柴』の個所で、神がモーセにどう言われたか、読んだことがないのか。『わたしはアブラハムの神、イサクの神、ヤコブの神である』とあるではないか。","tok":[["死者","ししゃ"],["が"],["復活","ふっかつ"],["する"],["こと"],["について"],["は"],["、"],["モーセ"],["の"],["書","しょ"],["の"],["『"],["柴","しば"],["』"],["の"],["個所","かしょ"],["で"],["、"],["神","かみ"],["が"],["モーセ"],["に"],["どう"],["言われた","いわれた"],["か"],["、"],["読んだ","よんだ"],["こと"],["が"],["ない"],["の"],["か"],["。"],["『"],["わたし"],["は"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["で"],["ある"],["』"],["と"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":27,"text":"神は死んだ者の神ではなく、生きている者の神なのだ。あなたたちは大変な思い違いをしている。」","tok":[["神","かみ"],["は"],["死んだ","しんだ"],["者","もの"],["の"],["神","かみ"],["で"],["は"],["なく"],["、"],["生きて","いきて"],["いる"],["者","もの"],["の"],["神","かみ"],["な"],["の"],["だ"],["。"],["あなた"],["たち"],["は"],["大変","たいへん"],["な"],["思い違い","おもいちがい"],["を"],["して"],["いる"],["。"],["」"]]},{"verse":28,"text":"彼らの議論を聞いていた一人の律法学者が進み出、イエスが立派にお答えになったのを見て、尋ねた。「あらゆる掟のうちで、どれが第一でしょうか。」","tok":[["彼","かれ"],["ら"],["の"],["議論","ぎろん"],["を"],["聞いて","きいて"],["いた"],["一人","ひとり"],["の"],["律法学者","りっぽうがくしゃ"],["が"],["進み出","すすみで"],["、"],["イエス"],["が"],["立派","りっぱ"],["に"],["お答え","おこたえ"],["に"],["なった"],["の"],["を"],["見て","みて"],["、"],["尋ねた","たずねた"],["。"],["「"],["あらゆる"],["掟","おきて"],["の"],["うち"],["で"],["、"],["どれ"],["が"],["第","だい"],["一","いち"],["でしょう"],["か"],["。"],["」"]]},{"verse":29,"text":"イエスはお答えになった。「第一の掟は、これである。『イスラエルよ、聞け、わたしたちの神である主は、唯一の主である。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["第","だい"],["一","いち"],["の"],["掟","おきて"],["は"],["、"],["これ"],["で"],["ある"],["。"],["『"],["イスラエル"],["よ"],["、"],["聞け","きけ"],["、"],["わたしたち"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["、"],["唯一","ゆいいつ"],["の"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":30,"text":"心を尽くし、精神を尽くし、思いを尽くし、力を尽くして、あなたの神である主を愛しなさい。』","tok":[["心","こころ"],["を"],["尽くし","つくし"],["、"],["精神","せいしん"],["を"],["尽くし","つくし"],["、"],["思い","おもい"],["を"],["尽くし","つくし"],["、"],["力","ちから"],["を"],["尽くして","つくして"],["、"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["を"],["愛し","あいし"],["なさい"],["。"],["』"]]},{"verse":31,"text":"第二の掟は、これである。『隣人を自分のように愛しなさい。』この二つにまさる掟はほかにない。」","tok":[["第","だい"],["二","に"],["の"],["掟","おきて"],["は"],["、"],["これ"],["で"],["ある"],["。"],["『"],["隣人","りんじん"],["を"],["自分","じぶん"],["の"],["よう"],["に"],["愛し","あいし"],["なさい"],["。"],["』"],["この"],["二","ふた"],["つ"],["に"],["まさる"],["掟","おきて"],["は"],["ほか"],["に"],["ない"],["。"],["」"]]},{"verse":32,"text":"律法学者はイエスに言った。「先生、おっしゃるとおりです。『神は唯一である。ほかに神はない』とおっしゃったのは、本当です。","tok":[["律法学者","りっぽうがくしゃ"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["先生","せんせい"],["、"],["おっしゃる"],["とおり"],["です"],["。"],["『"],["神","かみ"],["は"],["唯一","ゆいいつ"],["で"],["ある"],["。"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["』"],["と"],["おっしゃった"],["の"],["は"],["、"],["本当","ほんとう"],["です"],["。"]]},{"verse":33,"text":"そして、『心を尽くし、知恵を尽くし、力を尽くして神を愛し、また隣人を自分のように愛する』ということは、どんな焼き尽くす献げ物やいけにえよりも優れています。」","tok":[["そして"],["、"],["『"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["知恵","ちえ"],["を"],["尽くし","つくし"],["、"],["力","ちから"],["を"],["尽くして","つくして"],["神","かみ"],["を"],["愛し","あいし"],["、"],["また"],["隣人","りんじん"],["を"],["自分","じぶん"],["の"],["よう"],["に"],["愛する","あいする"],["』"],["と"],["いう"],["こと"],["は"],["、"],["どんな"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["や"],["いけにえ"],["より"],["も"],["優れて","すぐれて"],["います"],["。"],["」"]]},{"verse":34,"text":"イエスは律法学者が適切な答えをしたのを見て、「あなたは、神の国から遠くない」と言われた。もはや、あえて
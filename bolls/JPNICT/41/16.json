[{"verse":1,"text":"安息日が終わると、マグダラのマリア、ヤコブの母マリア、サロメは、イエスに油を塗りに行くために香料を買った。","tok":[["安息日","あんそくび"],["が"],["終わる","おわる"],["と"],["、"],["マグダラ"],["の"],["マリア"],["、"],["ヤコブ"],["の"],["母","はは"],["マリア"],["、"],["サロメ"],["は"],["、"],["イエス"],["に"],["油","あぶら"],["を"],["塗り","ぬり"],["に"],["行く","いく"],["ため"],["に"],["香料","こうりょう"],["を"],["買った","かった"],["。"]]},{"verse":2,"text":"そして、週の初めの日の朝ごく早く、日が出るとすぐ墓に行った。","tok":[["そして"],["、"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["の"],["朝","あさ"],["ごく"],["早く","はやく"],["、"],["日","ひ"],["が"],["出る","でる"],["と"],["すぐ"],["墓","はか"],["に"],["行った","いった"],["。"]]},{"verse":3,"text":"彼女たちは、「だれが墓の入り口からあの石を転がしてくれるでしょうか」と話し合っていた。","tok":[["彼女","かのじょ"],["たち"],["は"],["、"],["「"],["だれ"],["が"],["墓","はか"],["の"],["入り口","いりぐち"],["から"],["あの"],["石","いし"],["を"],["転がして","ころがして"],["くれるでしょう"],["か"],["」"],["と"],["話し合って","はなしあって"],["いた"],["。"]]},{"verse":4,"text":"ところが、目を上げて見ると、石は既にわきへ転がしてあった。石は非常に大きかったのである。","tok":[["ところ"],["が"],["、"],["目","め"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["石","いし"],["は"],["既に","すでに"],["わき"],["へ"],["転がして","ころがして"],["あった"],["。"],["石","いし"],["は"],["非常","ひじょう"],["に"],["大きかった","おおきかった"],["ので"],["ある"],["。"]]},{"verse":5,"text":"墓の中に入ると、白い長い衣を着た若者が右手に座っているのが見えたので、婦人たちはひどく驚いた。","tok":[["墓","はか"],["の"],["中","なか"],["に"],["入る","はいる"],["と"],["、"],["白い","しろい"],["長い","ながい"],["衣","ころも"],["を"],["着た","きた"],["若者","わかもの"],["が"],["右手","みぎて"],["に"],["座って","すわって"],["いる"],["の"],["が"],["見えた","みえた"],["ので"],["、"],["婦人","ふじん"],["たち"],["は"],["ひどく"],["驚いた","おどろいた"],["。"]]},{"verse":6,"text":"若者は言った。「驚くことはない。あなたがたは十字架につけられたナザレのイエスを捜しているが、あの方は復活なさって、ここにはおられない。御覧なさい。お納めした場所である。","tok":[["若者","わかもの"],["は"],["言った","いった"],["。"],["「"],["驚く","おどろく"],["こと"],["は"],["ない"],["。"],["あなた"],["がた"],["は"],["十字架","じゅうじか"],["に"],["つけられた"],["ナザレ"],["の"],["イエス"],["を"],["捜して","さがして"],["いる"],["が"],["、"],["あの"],["方","かた"],["は"],["復活","ふっかつ"],["なさって"],["、"],["ここ"],["に"],["は"],["おられない"],["。"],["御覧","ごらん"],["なさい"],["。"],["お納め","おおさめ"],["した"],["場所","ばしょ"],["で"],["ある"],["。"]]},{"verse":7,"text":"さあ、行って、弟子たちとペトロに告げなさい。『あの方は、あなたがたより先にガリラヤへ行かれる。かねて言われたとおり、そこでお目にかかれる』と。」","tok":[["さあ"],["、"],["行って","いって"],["、"],["弟子","でし"],["たち"],["と"],["ペトロ"],["に"],["告げ","つげ"],["なさい"],["。"],["『"],["あの"],["方","かた"],["は"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["ガリラヤ"],["へ"],["行かれる","いかれる"],["。"],["かねて"],["言われた","いわれた"],["とおり"],["、"],["そこ"],["で"],["お目","おめ"],["に"],["かかれる"],["』"],["と"],["。"],["」"]]},{"verse":8,"text":"婦人たちは墓を出て逃げ去った。震え上がり、正気を失っていた。そして、だれにも何も言わなかった。恐ろしかったからである。","tok":[["婦人","ふじん"],["たち"],["は"],["墓","はか"],["を"],["出て","でて"],["逃げ去った","にげさった"],["。"],["震え上がり","ふるえあがり"],["、"],["正気","せいき"],["を"],["失って","うしなって"],["いた"],["。"],["そして"],["、"],["だれ"],["に"],["も"],["何","なん"],["も"],["言わなかった","いわなかった"],["。"],["恐ろしかった","おそろしかった"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"〔イエスは週の初めの日の朝早く、復活して、まずマグダラのマリアに御自身を現された。このマリアは、以前イエスに七つの悪霊を追い出していただいた婦人である。","tok":[["〔"],["イエス"],["は"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["の"],["朝","あさ"],["早く","はやく"],["、"],["復活","ふっかつ"],["して"],["、"],["まず"],["マグダラ"],["の"],["マリア"],["に"],["御自身","ごじしん"],["を"],["現された","あらわされた"],["。"],["この"],["マリア"],["は"],["、"],["以前","いぜん"],["イエス"],["に"],["七","なな"],["つ"],["の"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["いただいた"],["婦人","ふじん"],["で"],["ある"],["。"]]},{"verse":10,"text":"マリアは、イエスと一緒にいた人々が泣き悲しんでいるところへ行って、このことを知らせた。","tok":[["マリア"],["は"],["、"],["イエス"],["と"],["一緒","いっしょ"],["に"],["いた"],["人々","ひとびと"],["が"],["泣き悲しんで","なきかなしんで"],["いる"],["ところ"],["へ"],["行って","いって"],["、"],["この"],["こと"],["を"],["知らせた","しらせた"],["。"]]},{"verse":11,"text":"しかし彼らは、イエスが生きておられること、そしてマリアがそのイエスを見たことを聞いても、信じなかった。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["、"],["イエス"],["が"],["生きて","いきて"],["おられる"],["こと"],["、"],["そして"],["マリア"],["が"],["その"],["イエス"],["を"],["見た","みた"],["こと"],["を"],["聞いて","きいて"],["も"],["、"],["信じなかった","しんじなかった"],["。"]]},{"verse":12,"text":"その後、彼らのうちの二人が田舎の方へ歩いて行く途中、イエスが別の姿で御自身を現された。","tok":[["その"],["後","ご"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["二人","ふたり"],["が"],["田舎","いなか"],["の"],["方","ほう"],["へ"],["歩いて","あるいて"],["行く","いく"],["途中","とちゅう"],["、"],["イエス"],["が"],["別","べつ"],["の"],["姿","すがた"],["で"],["御自身","ごじしん"],["を"],["現された","あらわされた"],["。"]]},{"verse":13,"text":"この二人も行って残りの人たちに知らせたが、彼らは二人の言うことも信じなかった。","tok":[["この"],["二人","ふたり"],["も"],["行って","いって"],["残り","のこり"],["の"],["人","ひと"],["たち"],["に"],["知らせた","しらせた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["二人","ふたり"],["の"],["言う","いう"],["こと"],["も"],["信じなかった","しんじなかった"],["。"]]},{"verse":14,"text":"その後、十一人が食事をしているとき、イエスが現れ、その不信仰とかたくなな心をおとがめになった。復活されたイエスを見た人々の言うことを、信じなかったからである。","tok":[["その"],["後","ご"],["、"],["十一人","じゅういちにん"],["が"],["食事","しょくじ"],["を"],["して"],["いる"],["とき"],["、"],["イエス"],["が"],["現れ","あらわれ"],["、"],["その"],["不","ふ"],["信仰","しんこう"],["と"],["かたくな"],["な"],["心","こころ"],["を"],["おとがめ"],["に"],["なった"],["。"],["復活","ふっかつ"],["された"],["イエス"],["を"],["見た","みた"],["人々","ひとびと"],["の"],["言う","いう"],["こと"],["を"],["、"],["信じなかった","しんじなかった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"それから、イエスは言われた。「全世界に行って、すべての造られたものに福音を宣べ伝えなさい。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["全","ぜん"],["世界","せかい"],["に"],["行って","いって"],["、"],["すべて"],["の"],["造られた","つくられた"],["もの"],["に"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["なさい"],["。"]]},{"verse":16,"text":"信じて洗礼を受ける者は救われるが、信じない者は滅びの宣告を受ける。","tok":[["信じて","しんじて"],["洗礼","せんれい"],["を"],["受ける","うける"],["者","もの"],["は"],["救われる","すくわれる"],["が"],["、"],["信じない","しんじない"],["者","もの"],["は"],["滅び","ほろび"],["の"],["宣告","せんこく"],["を"],["受ける","うける"],["。"]]},{"verse":17,"text":"信じる者には次のようなしるしが伴う。彼らはわたしの名によって悪霊を追い出し、新しい言葉を語る。","tok":[["信じる","しんじる"],["者","もの"],["に"],["は"],["次","つぎ"],["の"],["よう"],["な"],["しるし"],["が"],["伴う","ともなう"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["名","な"],["によって"],["悪霊","あくりょう"],["を"],["追い出し","おいだし"],["、"],["新しい","あたらしい"],["言葉","ことば"],["を"],["語る","かたる"],["。"]]},{"verse":18,"text":"手で蛇をつかみ、また、毒を飲んでも決して害を受けず、病人に手を置けば治る。」","tok":[["手","て"],["で"],["蛇","へび"],["を"],["つかみ"],["、"],["また"],["、"],["毒","どく"],["を"],["飲んで","のんで"],["も"],["決して","けっして"],["害","がい"],["を"],["受けず","うけず"],["、"],["病人","びょうにん"],["に"],["手","て"],["を"],["置けば","おけば"],["治る","なおる"],["。"],["」"]]},{"verse":19,"text":"主イエスは、弟子たちに話した後、天に上げられ、神の右の座に着かれた。","tok":[["主","しゅ"],["イエス"],["は"],["、"],["弟子","でし"],["たち"],["に"],["話した","はなした"],["後","あと"],["、"],["天","てん"],["に"],["上げられ","あげられ"],["、"],["神","かみ"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着かれた","つかれた"],["。"]]},{"verse":20,"text":"一方、弟子たちは出かけて行って、至るところで宣教した。主は彼らと共に働き、彼らの語る言葉が真実であることを、それに伴うしるしによってはっきりとお示しになった。〕結び 二〔婦人たちは、命じられたことをすべてペトロとその仲間たちに手短に伝えた。その後、イエス御自身も、東から西まで、彼らを通して、永遠の救いに関する聖なる朽ちることのない福音を広められた。アーメン。〕","tok":[["一方","いっぽう"],["、"],["弟子","でし"],["たち"],["は"],["出かけて","でかけて"],["行って","いって"],["、"],["至る","いたる"],["ところ"],["で"],["宣教","せんきょう"],["した"],["。"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["働き","はたらき"],["、"],["彼","かれ"],["ら"],["の"],["語る","かたる"],["言葉","ことば"],["が"],["真実","しんじつ"],["で"],["ある"],["こと"],["を"],["、"],["それ"],["に"],["伴う","ともなう"],["しるし"],["によって"],["はっきり"],["と"],["お示し","おしめし"],["に"],["なった"],["。"],["〕"],["結び","むすび"],[" "],["二","に"],["〔"],["婦人","ふじん"],["たち"],["は"],["、"],["命じられた","めいじられた"],["こと"],["を"],["すべて"],["ペトロ"],["と"],["その"],["仲間","なかま"],["たち"],["に"],["手短","てみじか"],["に"],["伝えた","つたえた"],["。"],["その"],["後","ご"],["、"],["イエス"],["御自身","ごじしん"],["も"],["、"],["東","ひがし"],["から"],["西","にし"],["まで"],["、"],["彼","かれ"],["ら"],["を"],["通して","とおして"],["、"],["永遠","えいえん"],["の"],["救い","すくい"],["に"],["関する","かんする"],["聖","せい"],["なる"],["朽ちる","くちる"],["こと"],["の"],["ない"],["福音","ふくいん"],["を"],["広められた","ひろめられた"],["。"],["アーメン"],["。"],["〕"]]}]
,["夕方","ゆうがた"],["に"],["なった"],["。"],["その"],["日","ひ"],["は"],["準備","じゅんび"],["の"],["日","ひ"],["、"],["すなわち"],["安息日","あんそくび"],["の"],["前日","ぜんじつ"],["で"],["あった"],["ので"],["、"]]},{"verse":43,"text":"アリマタヤ出身で身分の高い議員ヨセフが来て、勇気を出してピラトのところへ行き、イエスの遺体を渡してくれるようにと願い出た。この人も神の国を待ち望んでいたのである。","tok":[["アリマタヤ"],["出身","しゅっしん"],["で"],["身分","みぶん"],["の"],["高い","たかい"],["議員","ぎいん"],["ヨセフ"],["が"],["来て","きて"],["、"],["勇気","ゆうき"],["を"],["出して","だして"],["ピラト"],["の"],["ところ"],["へ"],["行き","いき"],["、"],["イエス"],["の"],["遺体","いたい"],["を"],["渡して","わたして"],["くれる"],["よう"],["に"],["と"],["願い出た","ねがいでた"],["。"],["この"],["人","ひと"],["も"],["神","かみ"],["の"],["国","くに"],["を"],["待ち望んで","まちのぞんで"],["いた"],["ので"],["ある"],["。"]]},{"verse":44,"text":"ピラトは、イエスがもう死んでしまったのかと不思議に思い、百人隊長を呼び寄せて、既に死んだかどうかを尋ねた。","tok":[["ピラト"],["は"],["、"],["イエス"],["が"],["もう"],["死んで","しんで"],["しまった"],["の"],["か"],["と"],["不思議","ふしぎ"],["に"],["思い","おもい"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["を"],["呼び寄せて","よびよせて"],["、"],["既に","すでに"],["死んだ","しんだ"],["か"],["どう"],["か"],["を"],["尋ねた","たずねた"],["。"]]},{"verse":45,"text":"そして、百人隊長に確かめたうえ、遺体をヨセフに下げ渡した。","tok":[["そして"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["に"],["確かめた","たしかめた"],["うえ"],["、"],["遺体","いたい"],["を"],["ヨセフ"],["に"],["下げ渡した","さげわたした"],["。"]]},{"verse":46,"text":"ヨセフは亜麻布を買い、イエスを十字架から降ろしてその布で巻き、岩を掘って作った墓の中に納め、墓の入り口には石を転がしておいた。","tok":[["ヨセフ"],["は"],["亜","あ"],["麻布","まふ"],["を"],["買い","かい"],["、"],["イエス"],["を"],["十字架","じゅうじか"],["から"],["降ろして","おろして"],["その"],["布","ぬの"],["で"],["巻き","まき"],["、"],["岩","いわ"],["を"],["掘って","ほって"],["作った","つくった"],["墓","はか"],["の"],["中","なか"],["に"],["納め","おさめ"],["、"],["墓","はか"],["の"],["入り口","いりぐち"],["に"],["は"],["石","いし"],["を"],["転がして","ころがして"],["おいた"],["。"]]},{"verse":47,"text":"マグダラのマリアとヨセの母マリアとは、イエスの遺体を納めた場所を見つめていた。","tok":[["マグダラ"],["の"],["マリア"],["と"],["ヨセ"],["の"],["母","はは"],["マリア"],["と"],["は"],["、"],["イエス"],["の"],["遺体","いたい"],["を"],["納めた","おさめた"],["場所","ばしょ"],["を"],["見つめて","みつめて"],["いた"],["。"]]}]
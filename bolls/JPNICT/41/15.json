[{"verse":1,"text":"夜が明けるとすぐ、祭司長たちは、長老や律法学者たちと共に、つまり最高法院全体で相談した後、イエスを縛って引いて行き、ピラトに渡した。","tok":[["夜","よる"],["が"],["明ける","あける"],["と"],["すぐ"],["、"],["祭司長","さいしちょう"],["たち"],["は"],["、"],["長老","ちょうろう"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["と"],["共","とも"],["に"],["、"],["つまり"],["最高","さいこう"],["法院","ほういん"],["全体","ぜんたい"],["で"],["相談","そうだん"],["した"],["後","あと"],["、"],["イエス"],["を"],["縛って","しばって"],["引いて","ひいて"],["行き","いき"],["、"],["ピラト"],["に"],["渡した","わたした"],["。"]]},{"verse":2,"text":"ピラトがイエスに、「お前がユダヤ人の王なのか」と尋問すると、イエスは、「それは、あなたが言っていることです」と答えられた。","tok":[["ピラト"],["が"],["イエス"],["に"],["、"],["「"],["お前","おまえ"],["が"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["な"],["の"],["か"],["」"],["と"],["尋問","じんもん"],["する"],["と"],["、"],["イエス"],["は"],["、"],["「"],["それ"],["は"],["、"],["あなた"],["が"],["言って","いって"],["いる"],["こと"],["です"],["」"],["と"],["答えられた","こたえられた"],["。"]]},{"verse":3,"text":"そこで祭司長たちが、いろいろとイエスを訴えた。","tok":[["そこ"],["で"],["祭司長","さいしちょう"],["たち"],["が"],["、"],["いろいろ"],["と"],["イエス"],["を"],["訴えた","うったえた"],["。"]]},{"verse":4,"text":"ピラトが再び尋問した。「何も答えないのか。彼らがあのようにお前を訴えているのに。」","tok":[["ピラト"],["が"],["再び","ふたたび"],["尋問","じんもん"],["した"],["。"],["「"],["何","なん"],["も"],["答えない","こたえない"],["の"],["か"],["。"],["彼","かれ"],["ら"],["が"],["あの"],["よう"],["に"],["お前","おまえ"],["を"],["訴えて","うったえて"],["いる"],["のに"],["。"],["」"]]},{"verse":5,"text":"しかし、イエスがもはや何もお答えにならなかったので、ピラトは不思議に思った。","tok":[["しかし"],["、"],["イエス"],["が"],["もはや"],["何","なん"],["も"],["お答え","おこたえ"],["に"],["ならなかった"],["ので"],["、"],["ピラト"],["は"],["不思議","ふしぎ"],["に"],["思った","おもった"],["。"]]},{"verse":6,"text":"ところで、祭りの度ごとに、ピラトは人々が願い出る囚人を一人釈放していた。","tok":[["ところ"],["で"],["、"],["祭り","まつり"],["の"],["度","ど"],["ごと"],["に"],["、"],["ピラト"],["は"],["人々","ひとびと"],["が"],["願い出る","ねがいでる"],["囚人","しゅうじん"],["を"],["一人","ひとり"],["釈放","しゃくほう"],["して"],["いた"],["。"]]},{"verse":7,"text":"さて、暴動のとき人殺しをして投獄されていた暴徒たちの中に、バラバという男がいた。","tok":[["さて"],["、"],["暴動","ぼうどう"],["の"],["とき"],["人殺し","ひとごろし"],["を"],["して"],["投獄","とうごく"],["されて"],["いた"],["暴徒","ぼうと"],["たち"],["の"],["中","なか"],["に"],["、"],["バラバ"],["と"],["いう"],["男","おとこ"],["が"],["
[{"verse":1,"text":"さて、過越祭と言われている除酵祭が近づいていた。","tok":[["さて"],["、"],["過越","すぎこし"],["祭","まつり"],["と"],["言われて","いわれて"],["いる"],["除","じょ"],["酵祭"],["が"],["近づいて","ちかづいて"],["いた"],["。"]]},{"verse":2,"text":"祭司長たちや律法学者たちは、イエスを殺すにはどうしたらよいかと考えていた。彼らは民衆を恐れていたのである。","tok":[["祭司長","さいしちょう"],["たち"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["イエス"],["を"],["殺す","ころす"],["に"],["は"],["どう"],["したら"],["よい"],["か"],["と"],["考えて","かんがえて"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["民衆","みんしゅう"],["を"],["恐れて","おそれて"],["いた"],["ので"],["ある"],["。"]]},{"verse":3,"text":"しかし、十二人の中の一人で、イスカリオテと呼ばれるユダの中に、サタンが入った。","tok":[["しかし"],["、"],["十二人","じゅうににん"],["の"],["中","なか"],["の"],["一人","ひとり"],["で"],["、"],["イスカリオテ"],["と"],["呼ばれる","よばれる"],["ユダ"],["の"],["中","なか"],["に"],["、"],["サタン"],["が"],["入った","はいった"],["。"]]},{"verse":4,"text":"ユダは祭司長たちや神殿守衛長たちのもとに行き、どのようにしてイエスを引き渡そうかと相談をもちかけた。","tok":[["ユダ"],["は"],["祭司長","さいしちょう"],["たち"],["や"],["神殿","しんでん"],["守衛長","しゅえいちょう"],["たち"],["の"],["もと"],["に"],["行き","いき"],["、"],["どの"],["よう"],["に"],["して"],["イエス"],["を"],["引き渡そう","ひきわたそう"],["か"],["と"],["相談","そうだん"],["を"],["もちかけた"],["。"]]},{"verse":5,"text":"彼らは喜び、ユダに金を与えることに決めた。","tok":[["彼","かれ"],["ら"],["は"],["喜び","よろこび"],["、"],["ユダ"],["に"],["金","かね"],["を"],["与える","あたえる"],["こと"],["に"],["決めた","きめた"],["。"]]},{"verse":6,"text":"ユダは承諾して、群衆のいないときにイエスを引き渡そうと、良い機会をねらっていた。","tok":[["ユダ"],["は"],["承諾","しょうだく"],["して"],["、"],["群衆","ぐんしゅう"],["の"],["いない"],["とき"],["に"],["イエス"],["を"],["引き渡そう","ひきわたそう"],["と"],["、"],["良い","よい"],["機会","きかい"],["を"],["ねらって"],["いた"],["。"]]},{"verse":7,"text":"過越の小羊を屠るべき除酵祭の日が来た。","tok":[["過越","すぎこし"],["の"],["小羊","こひつじ"],["を"],["屠るべき","ほふるべき"],["除","じょ"],["酵祭"],["の"],["日","ひ"],["が"],["来た","きた"],["。"]]},{"verse":8,"text":"イエスはペトロとヨハネとを使いに出そうとして、「行って過越の食事ができるように準備しなさい」と言われた。","tok":[["イエス"],["は"],["ペトロ"],["と"],["ヨハネ"],["と"],["を"],["使い","つかい"],["に"],["出そう","だそう"],["として"],["、"],["「"],["行って","いって"],["過越","すぎこし"],["の"],["食事","しょくじ"],["が"],["できる"],["よう"],["に"],["準備","じゅんび"],["し"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":9,"text":"二人が、「どこに用意いたしましょうか」と言うと、","tok":[["二人","ふたり"],["が"],["、"],["「"],["どこ"],["に"],["用意","ようい"],["いたしましょう"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":10,"text":"イエスは言われた。「都に入ると、水がめを運んでいる男に出会う。その人が入る家までついて行き、","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["都","と"],["に"],["入る","はいる"],["と"],["、"],["水がめ","みずがめ"],["を"],["運んで","はこんで"],["いる"],["男","おとこ"],["に"],["出会う","であう"],["。"],["その"],["人","ひと"],["が"],["入る","はいる"],["家","いえ"],["まで"],["ついて"],["行き","いき"],["、"]]},{"verse":11,"text":"家の主人にはこう言いなさい。『先生が、「弟子たちと一緒に過越の食事をする部屋はどこか」とあなたに言っています。』","tok":[["家","いえ"],["の"],["主人","しゅじん"],["に"],["は"],["こう"],["言い","いい"],["なさい"],["。"],["『"],["先生","せんせい"],["が"],["、"],["「"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["する"],["部屋","へや"],["は"],["どこ"],["か"],["」"],["と"],["あなた"],["に"],["言って","いって"],["います"],["。"],["』"]]},{"verse":12,"text":"すると、席の整った二階の広間を見せてくれるから、そこに準備をしておきなさい。」","tok":[["する"],["と"],["、"],["席","せき"],["の"],["整った","ととのった"],["二","に"],["階","かい"],["の"],["広間","ひろま"],["を"],["見せて","みせて"],["くれる"],["から"],["、"],["そこ"],["に"],["準備","じゅんび"],["を"],["して"],["おき"],["なさい"],["。"],["」"]]},{"verse":13,"text":"二人が行ってみると、イエスが言われたとおりだったので、過越の食事を準備した。","tok":[["二人","ふたり"],["が"],["行って","いって"],["みる"],["と"],["、"],["イエス"],["が"],["言われた","いわれた"],["とおり"],["だった"],["ので"],["、"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["準備","じゅんび"],["した"],["。"]]},{"verse":14,"text":"時刻になったので、イエスは食事の席に着かれたが、使徒たちも一緒だった。","tok":[["時刻","じこく"],["に"],["なった"],["ので"],["、"],["イエス"],["は"],["食事","しょくじ"],["の"],["席","せき"],["に"],["着かれた","つかれた"],["が"],["、"],["使徒","しと"],["たち"],["も"],["一緒","いっしょ"],["だった"],["。"]]},{"verse":15,"text":"イエスは言われた。「苦しみを受ける前に、あなたがたと共にこの過越の食事をしたいと、わたしは切に願っていた。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["苦しみ","くるしみ"],["を"],["受ける","うける"],["前","まえ"],["に"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["この"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["したい"],["と"],["、"],["わたし"],["は"],["切に","せつに"],["願って","ねがって"],["いた"],["。"]]},{"verse":16,"text":"言っておくが、神の国で過越が成し遂げられるまで、わたしは決してこの過越の食事をとることはない。」","tok":[["言って","いって"],["おく"],["が"],["、"],["神","かみ"],["の"],["国","くに"],["で"],["過越","すぎこし"],["が"],["成し遂げられる","なしとげられる"],["まで"],["、"],["わたし"],["は"],["決して","けっして"],["この"],["過越","すぎこし"],["の"],["食事","しょくじ"],["を"],["とる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":17,"text":"そして、イエスは杯を取り上げ、感謝の祈りを唱えてから言われた。「これを取り、互いに回して飲みなさい。","tok":[["そして"],["、"],["イエス"],["は"],["杯","さかずき"],["を"],["取り上げ","とりあげ"],["、"],["感謝","かんしゃ"],["の"],["祈り","いのり"],["を"],["唱えて","となえて"],["から"],["言われた","いわれた"],["。"],["「"],["これ"],["を"],["取り","とり"],["、"],["互い","たがい"],["に"],["回して","まわして"],["飲み","のみ"],["なさい"],["。"]]},{"verse":18,"text":"言っておくが、神の国が来るまで、わたしは今後ぶどうの実から作ったものを飲むことは決してあるまい。」","tok":[["言って","いって"],["おく"],["が"],["、"],["神","かみ"],["の"],["国","くに"],["が"],["来る","くる"],["まで"],["、"],["わたし"],["は"],["今後","こんご"],["ぶどう"],["の"],["実","じつ"],["から"],["作った","つくった"],["もの"],["を"],["飲む","のむ"],["こと"],["は"],["決して","けっして"],["あるまい"],["。"],["」"]]},{"verse":19,"text":"それから、イエスはパンを取り、感謝の祈りを唱えて、それを裂き、使徒たちに与えて言われた。「これは、あなたがたのために与えられるわたしの体である。わたしの記念としてこのように行いなさい。」","tok":[["それ"],["から"],["、"],["イエス"],["は"],["パン"],["を"],["取り","とり"],["、"],["感謝","かんしゃ"],["の"],["祈り","いのり"],["を"],["唱えて","となえて"],["、"],["それ"],["を"],["裂き","さき"],["、"],["使徒","しと"],["たち"],["に"],["与えて","あたえて"],["言われた","いわれた"],["。"],["「"],["これ"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["与えられる","あたえられる"],["わたし"],["の"],["体","からだ"],["で"],["ある"],["。"],["わたし"],["の"],["記念","きねん"],["として"],["この"],["よう"],["に"],["行い","おこない"],["なさい"],["。"],["」"]]},{"verse":20,"text":"食事を終えてから、杯も同じようにして言われた。「この杯は、あなたがたのために流される、わたしの血による新しい契約である。","tok":[["食事","しょくじ"],["を"],["終えて","おえて"],["から"],["、"],["杯","さかずき"],["も"],["同じ","おなじ"],["よう"],["に"],["して"],["言われた","いわれた"],["。"],["「"],["この"],["杯","さかずき"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["流される","ながされる"],["、"],["わたし"],["の"],["血","ち"],["に"],["よる"],["新しい","あたらしい"],["契約","けいやく"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかし、見よ、わたしを裏切る者が、わたしと一緒に手を食卓に置いている。","tok":[["しかし"],["、"],["見よ","みよ"],["、"],["わたし"],["を"],["裏切る","うらぎる"],["者","もの"],["が"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["手","て"],["を"],["食卓","しょくたく"],["に"],["置いて","おいて"],["いる"],["。"]]},{"verse":22,"text":"人の子は、定められたとおり去って行く。だが、人の子を裏切るその者は不幸だ。」","tok":[["人","ひと"],["の"],["子","こ"],["は"],["、"],["定められた","さだめられた"],["とおり"],["去って","さって"],["行く","いく"],["。"],["だ"],["が"],["、"],["人","ひと"],["の"],["子","こ"],["を"],["裏切る","うらぎる"],["その"],["者","もの"],["は"],["不幸","ふこう"],["だ"],["。"],["」"]]},{"verse":23,"text":"そこで使徒たちは、自分たちのうち、いったいだれが、そんなことをしようとしているのかと互いに議論をし始めた。","tok":[["そこ"],["で"],["使徒","しと"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["うち"],["、"],["いったい"],["だれ"],["が"],["、"],["そんな"],["こと"],["を"],["しよう"],["として"],["いる"],["の"],["か"],["と"],["互い","たがい"],["に"],["議論","ぎろん"],["を"],["し"],["始めた","はじめた"],["。"]]},{"verse":24,"text":"また、使徒たちの間に、自分たちのうちでだれがいちばん偉いだろうか、という議論も起こった。","tok":[["また"],["、"],["使徒","しと"],["たち"],["の"],["間","あいだ"],["に"],["、"],["自分","じぶん"],["たち"],["の"],["うち"],["で"],["だれ"],["が"],["いちばん"],["偉いだろう","えらいだろう"],["か"],["、"],["と"],["いう"],["議論","ぎろん"],["も"],["起こった","おこった"],["。"]]},{"verse":25,"text":"そこで、イエスは言われた。「異邦人の間では、王が民を支配し、民の上に権力を振るう者が守護者と呼ばれている。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["異邦人","いほうじん"],["の"],["間","あいだ"],["で"],["は"],["、"],["王","おう"],["が"],["民","たみ"],["を"],["支配","しはい"],["し"],["、"],["民","みん"],["の"],["上","うえ"],["に"],["権力","けんりょく"],["を"],["振るう","ふるう"],["者","もの"],["が"],["守護者","しゅごしゃ"],["と"],["呼ばれて","よばれて"],["いる"],["。"]]},{"verse":26,"text":"しかし、あなたがたはそれではいけない。あなたがたの中でいちばん偉い人は、いちばん若い者のようになり、上に立つ人は、仕える者のようになりなさい。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["それ"],["で"],["は"],["いけない"],["。"],["あなた"],["がた"],["の"],["中","なか"],["で"],["いちばん"],["偉い","えらい"],["人","ひと"],["は"],["、"],["いちばん"],["若い","わかい"],["者","もの"],["の"],["よう"],["に"],["なり"],["、"],["上","うえ"],["に"],["立つ","たつ"],["人","ひと"],["は"],["、"],["仕える","つかえる"],["者","もの"],["の"],["よう"],["に"],["なり"],["なさい"],["。"]]},{"verse":27,"text":"食事の席に着く人と給仕する者とは、どちらが偉いか。食事の席に着く人ではないか。しかし、わたしはあなたがたの中で、いわば給仕する者である。","tok":[["食事","しょくじ"],["の"],["席","せき"],["に"],["着く","つく"],["人","ひと"],["と"],
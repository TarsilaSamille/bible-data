[{"verse":1,"text":"イエスはある所で祈っておられた。祈りが終わると、弟子の一人がイエスに、「主よ、ヨハネが弟子たちに教えたように、わたしたちにも祈りを教えてください」と言った。","tok":[["イエス"],["は"],["ある"],["所","ところ"],["で"],["祈って","いのって"],["おられた"],["。"],["祈り","いのり"],["が"],["終わる","おわる"],["と"],["、"],["弟子","でし"],["の"],["一人","ひとり"],["が"],["イエス"],["に"],["、"],["「"],["主","ぬし"],["よ"],["、"],["ヨハネ"],["が"],["弟子","でし"],["たち"],["に"],["教えた","おしえた"],["よう"],["に"],["、"],["わたしたち"],["に"],["も"],["祈り","いのり"],["を"],["教えて","おしえて"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"そこで、イエスは言われた。「祈るときには、こう言いなさい。『父よ、御名が崇められますように。御国が来ますように。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["祈る","いのる"],["とき"],["に"],["は"],["、"],["こう"],["言い","いい"],["なさい"],["。"],["『"],["父","ちち"],["よ"],["、"],["御名","ぎょめい"],["が"],["崇められます","あがめられます"],["よう"],["に"],["。"],["御国","みくに"],["が"],["来ます","きます"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしたちに必要な糧を毎日与えてください。","tok":[["わたしたち"],["に"],["必要","ひつよう"],["な"],["糧","かて"],["を"],["毎日","まいにち"],["与えて","あたえて"],["ください"],["。"]]},{"verse":4,"text":"わたしたちの罪を赦してください、わたしたちも自分に負い目のある人を皆赦しますから。わたしたちを誘惑に遭わせないでください。』」","tok":[["わたしたち"],["の"],["罪","つみ"],["を"],["赦して","ゆるして"],["ください"],["、"],["わたしたち"],["も"],["自分","じぶん"],["に"],["負い目","おいめ"],["の"],["ある"],["人","ひと"],["を"],["皆","みな"],["赦します","ゆるします"],["から"],["。"],["わたしたち"],["を"],["誘惑","ゆうわく"],["に"],["遭わせないで","あわせないで"],["ください"],["。"],["』"],["」"]]},{"verse":5,"text":"また、弟子たちに言われた。「あなたがたのうちのだれかに友達がいて、真夜中にその人のところに行き、次のように言ったとしよう。『友よ、パンを三つ貸してください。","tok":[["また"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["がた"],["の"],["うち"],["の"],["だれ"],["か"],["に"],["友達","ともだち"],["が"],["いて"],["、"],["真夜中","まよなか"],["に"],["その"],["人","ひと"],["の"],["ところ"],["に"],["行き","いき"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["と"],["しよう"],["。"],["『"],["友","とも"],["よ"],["、"],["パン"],["を"],["三","みっ"],["つ"],["貸して","かして"],["ください"],["。"]]},{"verse":6,"text":"旅行中の友達がわたしのところに立ち寄ったが、何も出すものがないのです。』","tok":[["旅行中","りょこうちゅう"],["の"],["友達","ともだち"],["が"],["わたし"],["の"],["ところ"],["に"],["立ち寄った","たちよった"],["が"],["、"],["何","なん"],["も"],["出す","だす"],["もの"],["が"],["ない"],["の"],["です"],["。"],["』"]]},{"verse":7,"text":"すると、その人は家の中から答えるにちがいない。『面倒をかけないでください。もう戸は閉めたし、子供たちはわたしのそばで寝ています。起きてあなたに何かをあげるわけにはいきません。』","tok":[["する"],["と"],["、"],["その"],["人","ひと"],["は"],["家","いえ"],["の"],["中","なか"],["から"],["答える","こたえる"],["に"],["ちがい"],["ない"],["。"],["『"],["面倒","めんどう"],["を"],["かけないで"],["ください"],["。"],["もう"],["戸","と"],["は"],["閉めた","しめた"],["し"],["、"],["子供","こども"],["たち"],["は"],["わたし"],["の"],["そば"],["で"],["寝て","ねて"],["います"],["。"],["起きて","おきて"],["あなた"],["に"],["何","なん"],["か"],["を"],["あげる"],["わけ"],["に"],["は"],["いきません"],["。"],["』"]]},{"verse":8,"text":"しかし、言っておく。その人は、友達だからということでは起きて何か与えるようなことはなくても、しつように頼めば、起きて来て必要なものは何でも与えるであろう。","tok":[["しかし"],["、"],["言って","いって"],["おく"],["。"],["その"],["人","ひと"],["は"],["、"],["友達","ともだち"],["だ"],["から"],["と"],["いう"],["こと"],["で"],["は"],["起きて","おきて"],["何","なん"],["か"],["与える","あたえる"],["よう"],["な"],["こと"],["は"],["なくて"],["も"],["、"],["しつよう"],["に"],["頼めば","たのめば"],["、"],["起きて","おきて"],["来て","きて"],["必要","ひつよう"],["な"],["もの"],["は"],["何","なん"],["で"],["も"],["与えるで","あたえるで"],["あろう"],["。"]]},{"verse":9,"text":"そこで、わたしは言っておく。求めなさい。そうすれば、与えられる。探しなさい。そうすれば、見つかる。門をたたきなさい。そうすれば、開かれる。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["言って","いって"],["おく"],["。"],["求め","もとめ"],["なさい"],["。"],["そう"],["すれば"],["、"],["与えられる","あたえられる"],["。"],["探し","さがし"],["なさい"],["。"],["そう"],["すれば"],["、"],["見つかる","みつかる"],["。"],["門","もん"],["を"],["たたき"],["なさい"],["。"],["そう"],["すれば"],["、"],["開かれる","ひらかれる"],["。"]]},{"verse":10,"text":"だれでも、求める者は受け、探す者は見つけ、門をたたく者には開かれる。","tok":[["だれ"],["で"],["も"],["、"],["求める","もとめる"],["者","もの"],["は"],["受け","うけ"],["、"],["探す","さがす"],["者","もの"],["は"],["見つけ","みつけ"],["、"],["門","もん"],["を"],["たたく"],["者","もの"],["に"],["は"],["開かれる","ひらかれる"],["。"]]},{"verse":11,"text":"あなたがたの中に、魚を欲しがる子供に、魚の代わりに蛇を与える父親がいるだろうか。","tok":[["あなた"],["がた"],["の"],["中","なか"],["に"],["、"],["魚","さかな"],["を"],["欲し","ほし"],["がる"],["子供","こども"],["に"],["、"],["魚","さかな"],["の"],["代わり","かわり"],["に"],["蛇","へび"],["を"],["与える","あたえる"],["父親","ちちおや"],["が"],["いるだろう"],["か"],["。"]]},{"verse":12,"text":"また、卵を欲しがるのに、さそりを与える父親がいるだろうか。","tok":[["また"],["、"],["卵","たまご"],["を"],["欲し","ほし"],["がる"],["のに"],["、"],["さそり"],["を"],["与える","あたえる"],["父親","ちちおや"],["が"],["いるだろう"],["か"],["。"]]},{"verse":13,"text":"このように、あなたがたは悪い者でありながらも、自分の子供には良い物を与えることを知っている。まして天の父は求める者に聖霊を与えてくださる。」","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["悪い","わるい"],["者","もの"],["で"],["あり"],["ながら"],["も"],["、"],["自分","じぶん"],["の"],["子供","こども"],["に"],["は"],["良い","よい"],["物","もの"],["を"],["与える","あたえる"],["こと"],["を"],["知って","しって"],["いる"],["。"],["まして"],["天","てん"],["の"],["父","ちち"],["は"],["求める","もとめる"],["者","もの"],["に"],["聖霊","せいれい"],["を"],["与えて","あたえて"],["くださる"],["。"],["」"]]},{"verse":14,"text":"イエスは悪霊を追い出しておられたが、それは口を利けなくする悪霊であった。悪霊が出て行くと、口の利けない人がものを言い始めたので、群衆は驚嘆した。","tok":[["イエス"],["は"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["おられた"],["が"],["、"],["それ"],["は"],["口","くち"],["を"],["利けなく","きけなく"],["する"],["悪霊","あくりょう"],["で"],["あった"],["。"],["悪霊","あくりょう"],["が"],["出て","でて"],["行く","いく"],["と"],["、"],["口","くち"],["の"],["利けない","きけない"],["人","ひと"],["が"],["もの"],["を"],["言い","いい"],["始めた","はじめた"],["ので"],["、"],["群衆","ぐんしゅう"],["は"],["驚嘆","きょうたん"],["した"],["。"]]},{"verse":15,"text":"しかし、中には、「あの男は悪霊の頭ベルゼブルの力で悪霊を追い出している」と言う者や、","tok":[["しかし"],["、"],["中","なか"],["に"],["は"],["、"],["「"],["あの"],["男","おとこ"],["は"],["悪霊","あくりょう"],["の"],["頭","あたま"],["ベルゼブル"],["の"],["力","ちから"],["で"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["いる"],["」"],["と"],["言う","いう"],["者","もの"],["や"],["、"]]},{"verse":16,"text":"イエスを試そうとして、天からのしるしを求める者がいた。","tok":[["イエス"],["を"],["試そう","ためそう"],["として"],["、"],["天","てん"],["から"],["の"],["しるし"],["を"],["求める","もとめる"],["者","もの"],["が"],["いた"],["。"]]},{"verse":17,"text":"しかし、イエスは彼らの心を見抜いて言われた。「内輪で争えば、どんな国でも荒れ果て、家は重なり合って倒れてしまう。","tok":[["しかし"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["見抜いて","みぬいて"],["言われた","いわれた"],["。"],["「"],["内輪","うちわ"],["で"],["争えば","あらそえば"],["、"],["どんな"],["国","くに"],["で"],["も"],["荒れ果て","あれはて"],["、"],["家","いえ"],["は"],["重なり合って","かさなりあって"],["倒れて","たおれて"],["しまう"],["。"]]},{"verse":18,"text":"あなたたちは、わたしがベルゼブルの力で悪霊を追い出していると言うけれども、サタンが内輪もめすれば、どうしてその国は成り立って行くだろうか。","tok":[["あなた"],["たち"],["は"],["、"],["わたし"],["が"],["ベルゼブル"],["の"],["力","ちから"],["で"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["いる"],["と"],["言う","ゆう"],["けれど"],["も"],["、"],["サタン"],["が"],["内輪","うちわ"],["もめ"],["すれば"],["、"],["どう"],["して"],["その"],["国","くに"],["は"],["成り立って","なりたって"],["行くだろう","いくだろう"],["か"],["。"]]},{"verse":19,"text":"わたしがベルゼブルの力で悪霊を追い出すのなら、あなたたちの仲間は何の力で追い出すのか。だから、彼ら自身があなたたちを裁く者となる。","tok":[["わたし"],["が"],["ベルゼブル"],["の"],["力","ちから"],["で"],["悪霊","あくりょう"],["を"],["追い出す","おいだす"],["の"],["なら"],["、"],["あなた"],["たち"],["の"],["仲間","なかま"],["は"],["何","なん"],["の"],["力","ちから"],["で"],["追い出す","おいだす"],["の"],["か"],["。"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["が"],["あなた"],["たち"],["を"],["裁く","さばく"],["者","もの"],["と"],["なる"],["。"]]},{"verse":20,"text":"しかし、わたしが神の指で悪霊を追い出しているのであれば、神の国はあなたたちのところに来ているのだ。","tok":[["しかし"],["、"],["わたし"],["が"],["神","かみ"],["の"],["指","ゆび"],["で"],["悪霊","あくりょう"],["を"],["追い出して","おいだして"],["いる"],["ので"],["あれば"],["、"],["神","かみ"],["の"],["国","くに"],["は"],["あなた"],["たち"],["の"],["ところ"],["に"],["来て","きて"],["いる"],["の"],["だ"],["。"]]},{"verse":21,"text":"強い人が武装して自分の屋敷を守っているときには、その持ち物は安全である。","tok":[["強い","つよい"],["人","ひと"],["が"],["武装","ぶそう"],["して"],["自分","じぶん"],["の"],["屋敷","やしき"],["を"],["守って","まもって"],["いる"],["とき"],["に"],["は"],["、"],["その"],["持ち物","もちもの"],["は"],["安全","あんぜん"],["で"],["ある"],["。"]]},{"verse":22,"text":"しかし、もっと強い者が襲って来てこの人に勝つと、頼みの武具をすべて奪い取り、分捕り品を分配する。","tok":[["しかし"],["、"],["もっと"],["強い","つよい"],["者","もの"],["が"],["襲って","おそって"],["来て","きて"],["この"],["人","ひと"],["に"],["勝つ","かつ"],["と"],["、"],["頼み","たのみ"],["の"],["武具","ぶぐ"],["を"],["すべて"],["奪い取り","うばいとり"],["、"],["分捕り品","ぶんどりひん"],["を"],["分配","ぶんぱい"],["する"],["。"]]},{"verse":23,"text":"わたしに味方しない者はわたしに敵対し、わたしと一緒に集めない者は散らしている。」","tok":[["わたし"],["に"],["味方","みかた"],["しない"],["者","もの"],["は"],["わたし"],["に"],["敵対","てきたい"],["し"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["集めない","あつめない"],["者","もの"],["は"],["散らして","ちらして"],["いる"],["。"],["」"]]},{"verse":24,"text":"「汚れた霊は、人から出て行くと、砂漠をうろつき、休む場所を探すが、見つからない。それで、『出て来たわが家に戻ろう』と言う。","tok":[["「"],["汚れた","よごれた"],["霊","れい"],["は"],["、"],["人","ひと"],["から"],["出て","でて"],["行く","いく"],["と"],["、"],["砂漠","さばく"],["を"],["うろつき"],["、"],["休む","やすむ"],["場所","ばしょ"],["を"],["探す","さがす"],["が"],["、"],["見つからない","みつからない"],["。"],["それ"],["で"],["、"],["『"],["出て","でて"],["来た","きた"],["わが家","わがや"],["に"],["戻ろう","もどろう"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":25,"text":"そして、戻ってみると、家は掃除をして、整えられていた。","tok":[["そして"],["、"],["戻って","もどって"],["みる"],["と"],["、"],["家","いえ"],["は"],["掃除","そうじ"],["を"],["して"],["、"],["整えられて","ととのえられて"],["いた"],["。"]]},{"verse":26,"text":"そこで、出かけて行き、自分よりも悪いほかの七つの霊を連れて来て、中に入り込んで、住み着く。そうなると、その人の後の状態は前よりも悪くなる。」","tok":[["そこ"],["で"],["、"],["出かけて","でかけて"],["行き","いき"],["、"],["自分","じぶん"],["より"],["も"],["悪い","わるい"],["ほか"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["を"],["連れて","つれて"],["来て","きて"],["、"],["中","なか"],["に"],["入り込んで","はいりこんで"],["、"],["住み着く","すみつく"],["。"],["そう"],["なる"],["と"],["、"],["その"],["人","ひと"],["の"],["後","あと"],["の"],["状態","じょうたい"],["は"],["前","まえ"],["より"],["も"],["悪く","わるく"],["なる"],["。"],["」"]]},{"verse":27,"text":"イエスがこれらのことを話しておられると、ある女が群衆の中から声高らかに言った。「なんと幸いなことでしょう、あなたを宿した胎、あなたが吸った乳房は。」","tok":[["イエス"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["話して","はなして"],["おられる"],["と"],["、"],["ある"],["女","おんな"],["が"],["群衆","ぐんしゅう"],["の"],["中","なか"],["から"],["声","こえ"],["高らか","たからか"],["に"],["言った","いった"],["。"],["「"],["なん"],["と"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["、"],["あなた"],["を"],["宿した","やどした"],["胎","はら"],["、"],["あなた"],["が"],["吸った","すった"],["乳房","ちぶさ"],["は"],["。"],["」"]]},{"verse":28,"text":"しかし、イエスは言われた。「むしろ、幸いなのは神の言葉を聞き、それを守る人である。」","tok":[["しかし"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["むしろ"],["、"],["幸い","さいわい"],["な"],["の"],["は"],["神","かみ"],["の"],["言葉","ことば"],["を"],["聞き","きき"],["、"],["それ"],["を"],["守る","まもる"],["人","ひと"],["で"],["ある"],["。"],["」"]]},{"verse":29,"text":"群衆の数がますます増えてきたので、イエスは話し始められた。「今の時代の者たちはよこしまだ。しるしを欲しがるが、ヨナのしるしのほかには、しるしは与えられない。","tok":[["群衆","ぐんしゅう"],["の"],["数","かず"],["が"],["ますます"],["増えて","ふえて"],["きた"],["ので"],["、"],["イエス"],["は"],["話し","はなし"],["始められた","はじめられた"],["。"],["「"],["今","いま"],["の"],["時代","じだい"],["の"],["者","もの"],["たち"],["は"],["よこしま"],["だ"],["。"],["しるし"],["を"],["欲し","ほっし"],["がる"],["が"],["、"],["ヨナ"],["の"],["しるし"],["の"],["ほか"],["に"],["は"],["、"],["しるし"],["は"],["与えられない","あたえられない"],["。"]]},{"verse":30,"text":"つまり、ヨナがニネベの人々に対してしるしとなったように、人の子も今の時代の者たちに対してしるしとなる。","tok":[["つまり"],["、"],["ヨナ"],["が"],["ニネベ"],["の"],["人々","ひとびと"],["に対して","にたいして"],["しるし"],["と"],["なった"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["今","いま"],["の"],["時代","じだい"],["の"],["者","もの"],["たち"],["に対して","にたいして"],["しるし"],["と"],["なる"],["。"]]},{"verse":31,"text":"南の国の女王は、裁きの時、今の時代の者たちと一緒に立ち上がり、彼らを罪に定めるであろう。この女王はソロモンの知恵を聞くために、地の果てから来たからである。ここに、ソロモンにまさるものがある。","tok":[["南","みなみ"],["の"],["国","くに"],["の"],["女王","じょおう"],["は"],["、"],["裁き","さばき"],["の"],["時","とき"],["、"],["今","いま"],["の"],["時代","じだい"],["の"],["者","もの"],["たち"],["と"],["一緒","いっしょ"],["に"],["立ち上がり","たちあがり"],["、"],["彼","かれ"],["ら"],["を"],["罪","つみ"],["に"],["定めるで","さだめるで"],["あろう"],["。"],["この"],["女王","じょおう"],["は"],["ソロモン"],["の"],["知恵","ちえ"],["を"],["聞く","きく"],["ため"],["に"],["、"],["地","ち"],["の"],["果て","はて"],["から"],["来た","きた"],["から"],["で"],["ある"],["。"],["ここ"],["に"],["、"],["ソロモン"],["に"],["まさる"],["もの"],["が"],["ある"],["。"]]},{"verse":32,"text":"また、ニネベの人々は裁きの時、今の時代の者たちと一緒に立ち上がり、彼らを罪に定めるであろう。ニネベの人々は、ヨナの説教を聞いて悔い改めたからである。ここに、ヨナにまさるものがある。」","tok":[["また"],["、"],["ニネベ"],["の"],["人々","ひとびと"],["は"],["裁き","さばき"],["の"],["時","とき"],["、"],["今","いま"],["の"],["時代","じだい"],["の"],["者","もの"],["たち"],["と"],["一緒","いっしょ"],["に"],["立ち上がり","たちあがり"],["、"],["彼","かれ"],["ら"],["を"],["罪","つみ"],["に"],["定めるで","さだめるで"],["あろう"],["。"],["ニネベ"],["の"],["人々","ひとびと"],["は"],["、"],["ヨナ"],["の"],["説教","せっきょう"],["を"],["聞いて","きいて"],["悔い改めた","くいあらためた"],["から"],["で"],["ある"],["。"],["ここ"],["に"],["、"],["ヨナ"],["に"],["まさる"],["もの"],["が"],["ある"],["。"],["」"]]},{"verse":33,"text":"「ともし火をともして、それを穴蔵の中や、升の下に置く者はいない。入って来る人に光が見えるように、燭台の上に置く。","tok":[["「"],["ともし火","ともしび"],["を"],["ともして"],["、"],["それ"],["を"],["穴蔵","あなぐら"],[
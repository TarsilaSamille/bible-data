,["屠って","ほふって"],["おやり"],["に"],["なる"],["。"],["』"]]},{"verse":31,"text":"すると、父親は言った。『子よ、お前はいつもわたしと一緒にいる。わたしのものは全部お前のものだ。","tok":[["する"],["と"],["、"],["父親","ちちおや"],["は"],["言った","いった"],["。"],["『"],["子","こ"],["よ"],["、"],["お前","おまえ"],["は"],["いつも"],["わたし"],["と"],["一緒","いっしょ"],["に"],["いる"],["。"],["わたし"],["の"],["もの"],["は"],["全部","ぜんぶ"],["お前","おまえ"],["の"],["もの"],["だ"],["。"]]},{"verse":32,"text":"だが、お前のあの弟は死んでいたのに生き返った。いなくなっていたのに見つかったのだ。祝宴を開いて楽しみ喜ぶのは当たり前ではないか。』」","tok":[["だ"],["が"],["、"],["お前","おまえ"],["の"],["あの"],["弟","おとうと"],["は"],["死んで","しんで"],["いた"],["のに"],["生き返った","いきかえった"],["。"],["いなく"],["なって"],["いた"],["のに"],["見つかった","みつかった"],["の"],["だ"],["。"],["祝宴","しゅくえん"],["を"],["開いて","ひらいて"],["楽しみ","たのしみ"],["喜ぶ","よろこぶ"],["の"],["は"],["当たり前","あたりまえ"],["で"],["は"],["ない"],["か"],["。"],["』"],["」"]]}]
],["うち"],["に"],["、"],["下","した"],["の"],["息子","むすこ"],["は"],["全部","ぜんぶ"],["を"],["金","かね"],["に"],["換えて","かえて"],["、"],["遠い","とおい"],["国","くに"],["に"],["旅立ち","たびだち"],["、"],["そこ"],["で"],["放蕩","ほうとう"],["の"],["限り","かぎり"],["を"],["尽くして","つくして"],["、"],["財産","ざいさん"],["を"],["無駄遣い","むだづかい"],["して"],["しまった"],["。"]]},{"verse":14,"text":"何もかも使い果たしたとき、その地方にひどい飢饉が起こって、彼は食べるにも困り始めた。","tok":[["何","なん"],["も"],["か"],["も"],["使い果たした","つかいはたした"],["とき"],["、"],["その"],["地方","ちほう"],["に"],["ひどい"],["飢饉","ききん"],["が"],["起こって","おこって"],["、"],["彼","かれ"],["は"],["食べる","たべる"],["に"],["も"],["困り","こまり"],["始めた","はじめた"],["。"]]},{"verse":15,"text":"それで、その地方に住むある人のところに身を寄せたところ、その人は彼を畑にやって豚の世話をさせた。","tok":[["それ"],["で"],["、"],["その"],["地方","ちほう"],["に"],["住む","すむ"],["ある"],["人","ひと"],["の"],["ところ"],["に"],["身","み"],["を"],["寄せた","よせた"],["ところ"],["、"],["その"],["人","ひと"],["は"],["彼","かれ"],["を"],["畑","はたけ"],["に"],["やって"],["豚","ぶた"],["の"],["世話","せわ"],["を"],["させた"],["。"]]},{"verse":16,"text":"彼は豚の食べるいなご豆を食べてでも腹を満たしたかったが、食べ物をくれる人はだれもいなかった。","tok":[["彼","かれ"],["は"],["豚","ぶた"],["の"],["食べる","たべる"],["いなご"],["豆","まめ"],["を"],["食べて","たべて"],["で"],["も"],["腹","はら"],["を"],["満たしたかった","みたしたかった"],["が"],["、"],["食べ物","たべもの"],["を"],["くれる"],["人","ひと"],["は"],["だれ"],["も"],["いなかった"],["。"]]},{"verse":17,"text":"そこで、彼は我に返って言った。『父のところでは、あんなに大勢の雇い人に、有り余るほどパンがあるのに、わたしはここで飢え死にしそうだ。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["我","われ"],["に"],["返って","かえって"],["言った","いった"],["。"],["『"],["父","ちち"],["の"],["ところ"],["で"],["は"],["、"],["あんな"],["に"],["大勢","おおぜい"],["の"],["雇い人","やといにん"],["に"],["、"],["有り余る","ありあまる"],["ほど"],["パン"],["が"],["ある"],["のに"],["、"],["わたし"],["は"],["ここ"],["で"],["飢え死に","うえじに"],["し"],["そう"],["だ"],["。"]]},{"verse":18,"text":"ここをたち、父のところに行って言おう。「お父さん、わたしは天に対しても、またお父さんに対しても罪を犯しました。","tok":[["ここ"],["を"],["たち"],["、"],["父","ちち"],["の"],["ところ"],["に"],["行って","いって"],["言おう","いおう"],["。"],["「"],["お父さん","おとうさん"],["、"],["わたし"],["は"],["天","てん"],["に対して","にたいして"],["も"],["、"],["また"],["お父さん","おとうさん"],["に対して","にたいして"],["も"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"]]},{"verse":19,"text":"もう息子と呼ばれる資格はありません。雇い人の一人にしてください」と。』","tok":[["もう"],["息子","むすこ"],["と"],["呼ばれる","よばれる"],["資格","しかく"],["は"],["ありません"],["。"],["雇い人","やといにん"],["の"],["一人","ひとり"],["に"],["して"],["ください"],["」"],["と"],["。"],["』"]]},{"verse":20,"text":"そして、彼はそこをたち、父親のもとに行った。ところが、まだ遠く離れていたのに、父親は息子を見つけて、憐れに思い、走り寄って首を抱き、接吻した。","tok":[["そして"],["、"],["彼","かれ"],["は"],["そこ"],["を"],["たち"],["、"],["父親","ちちおや"],["の"],["もと"],["に"],["行った","いった"],["。"],["ところ"],["が"],["、"],["まだ"],["遠く","とおく"],["離れて","はなれて"],["いた"],["のに"],["、"],["父親","ちちおや"],["は"],["息子","むすこ"],["を"],["見つけて","みつけて"],["、"],["憐れ","あわれ"],["に"],["思い","おもい"],["、"],["走り寄って","はしりよって"],["首","くび"],["を"],["抱き","いだき"],["、"],["接吻","せっぷん"],["した"],["。"]]},{"verse":21,"text":"息子は言った。『お父さん、わたしは天に対しても、またお父さんに対しても罪を犯しました。もう息子と呼ばれる資格はありません。』","tok":[["息子","むすこ"],["は"],["言った","いった"],["。"],["『"],["お父さん","おとうさん"],["、"],["わたし"],["は"],["天","てん"],["に対して","にたいして"],["も"],["、"],["また"],["お父さん","おとうさん"],["に対して","にたいして"],["も"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["もう"],["息子","むすこ"],["と"],["呼ばれる","よばれる"],["資格","しかく"],["は"],["ありません"],["。"],["』"]]},{"verse":22,"text":"しかし、父親は僕たちに言った。『急いでいちばん良い服を持って来て、この子に着せ、手に指輪をはめてやり、足に履物を履かせなさい。","tok":[["しかし"],["、"],["父親","ちちおや"],["は"],["僕たち","ぼくたち"],["に"],["言った","いった"],["。"],["『"],["急いで","いそいで"],["いちばん"],["良い","よい"],["服","ふく"],["を"],["持って","もって"],["来て","きて"],["、"],["この"],["子","こ"],["に"],["着せ","きせ"],["、"],["手","て"],["に"],["指輪","ゆびわ"],["を"],["はめて"],["やり"],["、"],["足","あし"],["に"],["履物","はきもの"],["を"],["履かせ","はかせ"],["なさい"],["。"]]},{"verse":23,"text":"それから、肥えた子牛を連れて来て屠りなさい。食べて祝おう。","tok":[["それ"],["から"],["、"],["肥えた","こえた"],["子牛","こうし"],["を"],["連れて","つれて"],["来て","きて"],["屠り","ほふり"],["なさい"],["。"],["食べて","たべて"],["祝おう","いわおう"],["。"]]},{"verse":24,"text":"この息子は、死んでいたのに生き返り、いなくなっていたのに見つかったからだ。』そして、祝宴を始めた。","tok":[["この"],["息子","むすこ"],["は"],["、"],["死んで","しんで"],["いた"],["のに"],["生き返り","いきかえり"],["、"],["いなく"],["なって"],["いた"],["のに"],["見つかった","みつかった"],["から"],["だ"],["。"],["』"],["そして"],["、"],["祝宴","しゅくえん"],["を"],["始めた","はじめた"],["。"]]},{"verse":25,"
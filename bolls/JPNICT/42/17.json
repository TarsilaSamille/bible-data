[{"verse":1,"text":"イエスは弟子たちに言われた。「つまずきは避けられない。だが、それをもたらす者は不幸である。","tok":[["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["つまずき"],["は"],["避けられない","さけられない"],["。"],["だ"],["が"],["、"],["それ"],["を"],["もたらす"],["者","もの"],["は"],["不幸","ふこう"],["で"],["ある"],["。"]]},{"verse":2,"text":"そのような者は、これらの小さい者の一人をつまずかせるよりも、首にひき臼を懸けられて、海に投げ込まれてしまう方がましである。","tok":[["その"],["よう"],["な"],["者","もの"],["は"],["、"],["これ"],["ら"],["の"],["小さい","ちいさい"],["者","もの"],["の"],["一人","ひとり"],["を"],["つまずかせる"],["より"],["も"],["、"],["首","くび"],["に"],["ひき臼","ひきうす"],["を"],["懸けられて","かけられて"],["、"],["海","うみ"],["に"],["投げ込まれて","なげこまれて"],["しまう"],["方","かた"],["が"],["まし"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたがたも気をつけなさい。もし兄弟が罪を犯したら、戒めなさい。そして、悔い改めれば、赦してやりなさい。","tok":[["あなた"],["がた"],["も"],["気","き"],["を"],["つけ"],["なさい"],["。"],["もし"],["兄弟","きょうだい"],["が"],["罪","つみ"],["を"],["犯したら","おかしたら"],["、"],["戒め","いましめ"],["なさい"],["。"],["そして"],["、"],["悔い改めれば","くいあらためれば"],["、"],["赦して","ゆるして"],["やり"],["なさい"],["。"]]},{"verse":4,"text":"一日に七回あなたに対して罪を犯しても、七回、『悔い改めます』と言ってあなたのところに来るなら、赦してやりなさい。」","tok":[["一","いち"],["日","にち"],["に"],["七","しち"],["回","かい"],["あなた"],["に対して","にたいして"],["罪","つみ"],["を"],["犯して","おかして"],["も"],["、"],["七","なな"],["回","かい"],["、"],["『"],["悔い改めます","くいあらためます"],["』"],["と"],["言って","いって"],["あなた"],["の"],["ところ"],["に"],["来るなら","くるなら"],["、"],["赦して","ゆるして"],["やり"],["なさい"],["。"],["」"]]},{"verse":5,"text":"使徒たちが、「わたしどもの信仰を増してください」と言ったとき、","tok":[["使徒","しと"],["たち"],["が"],["、"],["「"],["わたし"],["ども"],["の"],["信仰","しんこう"],["を"],["増して","まして"],["ください"],["」"],["と"],["言った","いった"],["とき"],["、"]]},{"verse":6,"text":"主は言われた。「もしあなたがたにからし種一粒ほどの信仰があれば、この桑の木に、『抜け出して海に根を下ろせ』と言っても、言うことを聞くであろう。","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["もし"],["あなた"],["がた"],["に"],["からし"],["種一","たねいち"],["粒","つぶ"],["ほど"],["の"],["信仰","しんこう"],["が"],["あれば"],["、"],["この"],["桑","くわ"],["の"],["木","き"],["に"],["、"],["『"],["抜け出して","ぬけだして"],["海","うみ"],["に"],["根","ね"],["を"],["下ろせ","おろせ"],["』"],["と"],["言って","いって"],["も"],["、"],["言う","いう"],["こと"],["を"],["聞くで","きくで"],["
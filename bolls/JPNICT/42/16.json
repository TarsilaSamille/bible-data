[{"verse":1,"text":"イエスは、弟子たちにも次のように言われた。「ある金持ちに一人の管理人がいた。この男が主人の財産を無駄遣いしていると、告げ口をする者があった。","tok":[["イエス"],["は"],["、"],["弟子","でし"],["たち"],["に"],["も"],["次","つぎ"],["の"],["よう"],["に"],["言われた","いわれた"],["。"],["「"],["ある"],["金持ち","かねもち"],["に"],["一人","ひとり"],["の"],["管理人","かんりにん"],["が"],["いた"],["。"],["この"],["男","おとこ"],["が"],["主人","しゅじん"],["の"],["財産","ざいさん"],["を"],["無駄遣い","むだづかい"],["して"],["いる"],["と"],["、"],["告げ口","つげぐち"],["を"],["する"],["者","もの"],["が"],["あった"],["。"]]},{"verse":2,"text":"そこで、主人は彼を呼びつけて言った。『お前について聞いていることがあるが、どうなのか。会計の報告を出しなさい。もう管理を任せておくわけにはいかない。』","tok":[["そこ"],["で"],["、"],["主人","しゅじん"],["は"],["彼","かれ"],["を"],["呼びつけて","よびつけて"],["言った","いった"],["。"],["『"],["お前","おまえ"],["について"],["聞いて","きいて"],["いる"],["こと"],["が"],["ある"],["が"],["、"],["どう"],["な"],["の"],["か"],["。"],["会計","かいけい"],["の"],["報告","ほうこく"],["を"],["出し","だし"],["なさい"],["。"],["もう"],["管理","かんり"],["を"],["任せて","まかせて"],["おく"],["わけ"],["に"],["は"],["いかない"],["。"],["』"]]},{"verse":3,"text":"管理人は考えた。『どうしようか。主人はわたしから管理の仕事を取り上げようとしている。土を掘る力もないし、物乞いをするのも恥ずかしい。","tok":[["管理人","かんりにん"],["は"],["考えた","かんがえた"],["。"],["『"],["どう"],["しよう"],["か"],["。"],["主人","しゅじん"],["は"],["わたし"],["から"],["管理","かんり"],["の"],["仕事","しごと"],["を"],["取り上げよう","とりあげよう"],["として"],["いる"],["。"],["土","つち"],["を"],["掘る","ほる"],["力","ちから"],["も"],["ない"],["し"],["、"],["物乞い","ものごい"],["を"],["する"],["の"],["も"],["恥ずかしい","はずかしい"],["。"]]},{"verse":4,"text":"そうだ。こうしよう。管理の仕事をやめさせられても、自分を家に迎えてくれるような者たちを作ればいいのだ。』","tok":[["そう"],["だ"],["。"],["こう"],["しよう"],["。"],["管理","かんり"],["の"],["仕事","しごと"],["を"],["やめさせられて"],["も"],["、"],["自分","じぶん"],["を"],["家","いえ"],["に"],["迎えて","むかえて"],["くれる"],["よう"],["な"],["者","もの"],["たち"],["を"],["作れば","つくれば"],["いい"],["の"],["だ"],["。"],["』"]]},{"verse":5,"text":"そこで、管理人は主人に借りのある者を一人一人呼んで、まず最初の人に、『わたしの主人にいくら借りがあるのか』と言った。","tok":[["そこ"],["で"],["、"],["管理人","かんりにん"],["は"],["主人","しゅじん"],["に"],["借り","かり"],["の"],["ある"],["者","もの"],["を"],["一人一人","ひとりひとり"],["呼んで","よんで"],["、"],["まず"],["最初","さいしょ"],["の"],["人","ひと"],["に"],["、"],["『"],["わたし"],["の"],["主人","しゅじん"],["に"],["いくら"],["借り","かり"],["が"],["ある"],["の"],["か"],["』"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"『油百バトス』と言うと、管理人は言った。『これがあなたの証文だ。急いで、腰を掛けて、五十バトスと書き直しなさい。』","tok":[["『"],["油","あぶら"],["百","ひゃく"],["バトス"],["』"],["と"],["言う","ゆう"],["と"],["、"],["管理人","かんりにん"],["は"],["言った","いった"],["。"],["『"],["これ"],["が"],["あなた"],["の"],["証文","しょうもん"],["だ"],["。"],["急いで","いそいで"],["、"],["腰","こし"],["を"],["掛けて","かけて"],["、"],["五十","ごじゅう"],["バトス"],["と"],["書き直し","かきなおし"],["なさい"],["。"],["』"]]},{"verse":7,"text":"また別の人には、『あなたは、いくら借りがあるのか』と言った。『小麦百コロス』と言うと、管理人は言った。『これがあなたの証文だ。八十コロスと書き直しなさい。』","tok":[["また"],["別","べつ"],["の"],["人","ひと"],["に"],["は"],["、"],["『"],["あなた"],["は"],["、"],["いくら"],["借り","かり"],["が"],["ある"],["の"],["か"],["』"],["と"],["言った","いった"],["。"],["『"],["小麦","こむぎ"],["百","ひゃく"],["コロス"],["』"],["と"],["言う","ゆう"],["と"],["、"],["管理人","かんりにん"],["は"],["言った","いった"],["。"],["『"],["これ"],["が"],["あなた"],["の"],["証文","しょうもん"],["だ"],["。"],["八十","やそ"],["コロス"],["と"],["書き直し","かきなおし"],["なさい"],["。"],["』"]]},{"verse":8,"text":"主人は、この不正な管理人の抜け目のないやり方をほめた。この世の子らは、自分の仲間に対して、光の子らよりも賢くふるまっている。","tok":[["主人","しゅじん"],["は"],["、"],["この"],["不正","ふせい"],["な"],["管理人","かんりにん"],["の"],["抜け目","ぬけめ"],["の"],["ない"],["やり方","やりかた"],["を"],["ほめた"],["。"],["この世","このよ"],["の"],["子","こ"],["ら"],["は"],["、"],["自分","じぶん"],["の"],["仲間","なかま"],["に対して","にたいして"],["、"],["光","ひかり"],["の"],["子","こ"],["ら"],["より"],["も"],["賢く","かしこく"],["ふるまって"],["いる"],["。"]]},{"verse":9,"text":"そこで、わたしは言っておくが、不正にまみれた富で友達を作りなさい。そうしておけば、金がなくなったとき、あなたがたは永遠の住まいに迎え入れてもらえる。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["言って","いって"],["おく"],["が"],["、"],["不正","ふせい"],["に"],["まみれた"],["富","とみ"],["で"],["友達","ともだち"],["を"],["作り","つくり"],["なさい"],["。"],["そう"],["して"],["おけば"],["、"],["金","きん"],["が"],["なくなった"],["とき"],["、"],["あなた"],["がた"],["は"],["永遠","えいえん"],["の"],["住まい","すまい"],["に"],["迎え入れて","むかえいれて"],["もらえる"],["。"]]},{"verse":10,"text":"ごく小さな事に忠実な者は、大きな事にも忠実である。ごく小さな事に不忠実な者は、大きな事にも不忠実である。","tok":[["ごく"],["小さな","ちいさな"],["事","こと"],["に"],["忠実","ちゅうじつ"],["な"],["者","もの"],["は"],["、"],["大きな","おおきな"],["事","こと"],["に"],["も"],["忠実","ちゅうじつ"],["で"],["ある"],["。"],["ごく"],["小さな","ちいさな"],["事","こと"],["に"],["不","ふ"],["忠実","ちゅうじつ"],["な"],["者","もの"],["は"],["、"],["大きな","おおきな"],["事","こと"],["に"],["も"],["不","ふ"],["忠実","ちゅうじつ"],["で"],["ある"],["。"]]},{"verse":11,"text":"だから、不正にまみれた富について忠実でなければ、だれがあなたがたに本当に価値あるものを任せるだろうか。","tok":[["だ"],["から"],["、"],["不正","ふせい"],["に"],["まみれた"],["富","とみ"],["について"],["忠実","ちゅうじつ"],["で"],["なければ"],["、"],["だれ"],["が"],["あなた"],["がた"],["に"],["本当","ほんとう"],["に"],["価値","かち"],["ある"],["もの"],["を"],["任せるだろう","まかせるだろう"],["か"],["。"]]},{"verse":12,"text":"また、他人のものについて忠実でなければ、だれがあなたがたのものを与えてくれるだろうか。","tok":[["また"],["、"],["他人","たにん"],["の"],["もの"],["について"],["忠実","ちゅうじつ"],["で"],["なければ"],["、"],["だれ"],["が"],["あなた"],["がた"],["の"],["もの"],["を"],["与えて","あたえて"],["くれるだろう"],["か"],["。"]]},{"verse":13,"text":"どんな召し使いも二人の主人に仕えることはできない。一方を憎んで他方を愛するか、一方に親しんで他方を軽んじるか、どちらかである。あなたがたは、神と富とに仕えることはできない。」","tok":[["どんな"],["召し使い","めしつかい"],["も"],["二人","ふたり"],["の"],["主人","しゅじん"],["に"],["仕える","つかえる"],["こと"],["は"],["できない"],["。"],["一方","いっぽう"],["を"],["憎んで","にくんで"],["他方","たほう"],["を"],["愛する","あいする"],["か"],["、"],["一方","いっぽう"],["に"],["親しんで","したしんで"],["他方","たほう"],["を"],["軽んじる","かろんじる"],["か"],["、"],["どちら"],["か"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["神","かみ"],["と"],["富","とみ"],["と"],["に"],["仕える","つかえる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":14,"text":"金に執着するファリサイ派の人々が、この一部始終を聞いて、イエスをあざ笑った。","tok":[["金","きん"],["に"],["執着","しゅうちゃく"],["する"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["が"],["、"],["この"],["一部","いちぶ"],["始終","しじゅう"],["を"],["聞いて","きいて"],["、"],["イエス"],["を"],["あざ笑った","あざわらった"],["。"]]},{"verse":15,"text":"そこで、イエスは言われた。「あなたたちは人に自分の正しさを見せびらかすが、神はあなたたちの心をご存じである。人に尊ばれるものは、神には忌み嫌われるものだ。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["たち"],["は"],["人","ひと"],["に"],["自分","じぶん"],["の"],["正し","ただし"],["さ"],["を"],["見せびらかす","みせびらかす"],["が"],["、"],["神","かみ"],["は"],["あなた"],["たち"],["の"],["心","こころ"],["を"],["ご存じ","ごぞんじ"],["で"],["ある"],["。"],["人","ひと"],["に"],["尊ばれる","とうとばれる"],["もの"],["は"],["、"],["神","かみ"],["に"],["は"],["忌み嫌われる","いみきらわれる"],["もの"],["だ"],["。"]]},{"verse":16,"text":"律法と預言者は、ヨハネの時までである。それ以来、神の国の福音が告げ知らされ、だれもが力ずくでそこに入ろうとしている。","tok":[["律法","りっぽう"],["と"],["預言者","よげんしゃ"],["は"],["、"],["ヨハネ"],["の"],["時","とき"],["まで"],["で"],["ある"],["。"],["それ"],["以来","いらい"],["、"],["神","かみ"],["の"],["国","くに"],["の"],["福音","ふくいん"],["が"],["告げ知らされ","つげしらされ"],["、"],["だれ"],["も"],["が"],["力","ちから"],["ずく"],["で"],["そこ"],["に"],["入ろう","はいろう"],["として"],["いる"],["。"]]},{"verse":17,"text":"しかし、律法の文字の一画がなくなるよりは、天地の消えうせる方が易しい。","tok":[["しかし"],["、"],["律法","りっぽう"],["の"],["文字","もじ"],["の"],["一画","いっかく"],["が"],["なくなる"],["より"],["は"],["、"],["天地","てんち"],["の"],["消えうせる","きえうせる"],["方","ほう"],["が"],["易しい","やさしい"],["。"]]},{"verse":18,"text":"妻を離縁して他の女を妻にする者はだれでも、姦通の罪を犯すことになる。離縁された女を妻にする者も姦通の罪を犯すことになる。」","tok":[["妻","つま"],["を"],["離縁","りえん"],["して"],["他","ほか"],["の"],["女","おんな"],["を"],["妻","つま"],["に"],["する"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["姦通","かんつう"],["の"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["に"],["なる"],["。"],["離縁","りえん"],["された"],["女","おんな"],["を"],["妻","つま"],["に"],["する"],["者","もの"],["も"],["姦通","かんつう"],["の"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["に"],["なる"],["。"],["」"]]},{"verse":19,"text":"「ある金持ちがいた。いつも紫の衣や柔らかい麻布を着て、毎日ぜいたくに遊び暮らしていた。","tok":[["「"],["ある"],["金持ち","かねもち"],["が"],["いた"],["。"],["いつも"],["紫","むらさき"],["の"],["衣","ころも"],["や"],["柔らかい","やわらかい"],["麻布","あざぶ"],["を"],["着て","きて"],["、"],["毎日","まいにち"],["ぜいたく"],["に"],["遊び暮らして","あそびくらして"],["いた"],["。"]]},{"verse":20,"text":"この金持ちの門前に、ラザロというできものだらけの貧しい人が横たわり、","tok":[["この"],["金持ち","かねもち"],["の"],["門前","もんぜん"],["に"],["、"],["ラザロ"],["と"],["いう"],["できもの"],["だらけ"],["の"],["貧しい","まずしい"],["人","ひと"],["が"],["横たわり","よこたわり"],["、"]]},{"verse":21,"text":"その食卓から落ちる物で腹を満たしたいものだと思っていた。犬もやって来ては、そのできものをなめた。","tok":[["その"],["食卓","しょくたく"],["から"],["落ちる","おちる"],["物","もの"],["で"],["腹","はら"],["を"],["満たしたい","みたしたい"],["もの"],["だ"],["と"],["思って","おもって"],["いた"],["。"],["犬","いぬ"],["も"],["やって"],["来て","きて"],["は"],["、"],["その"],["できもの"],["を"],["なめた"],["。"]]},{"verse":22,"text":"やがて、この貧しい人は死んで、天使たちによって宴席にいるアブラハムのすぐそばに連れて行かれた。金持ちも死んで葬られた。","tok":[["やがて"],["、"],["この"],["貧しい","まずしい"],["人","ひと"],["は"],["死んで","しんで"],["、"],["天使","てんし"],["たち"],["によって"],["宴席","えんせき"],["に"],["いる"],["アブラハム"],["の"],["すぐ"],["そば"],["に"],["連れて","つれて"],["行かれた","いかれた"],["。"],["金持ち","かねもち"],["も"],["死んで","しんで"],["葬られた","ほうむられた"],["。"]]},{"verse":23,"text":"そして、金持ちは陰府でさいなまれながら目を上げると、宴席でアブラハムとそのすぐそばにいるラザロとが、はるかかなたに見えた。","tok":[["そして"],["、"],["金持ち","かねもち"],["は"],["陰府","よみ"],["で"],["さいなまれ"],["ながら"],["目","め"],["を"],["上げる","あげる"],["と"],["、"],["宴席","えんせき"],["で"],["アブラハム"],["と"],["その"],["すぐ"],["そば"],["に"],["いる"],["ラザロ"],["と"],["が"],["、"],["はるか"],["かなた"],["に"],["見えた","みえた"],["。"]]},{"verse":24,"text":"そこで、大声で言った。『父アブラハムよ、わたしを憐れんでください。ラザロをよこして、指先を水に浸し、わたしの舌を冷やさせてください。わたしはこの炎の中でもだえ苦しんでいます。』","tok":[["そこ"],["で"],["、"],["大声","おおごえ"],["で"],["言った","いった"],["。"],["『"],["父","ちち"],["アブラハム"],["よ"],["、"],["わたし"],["を"],["憐れんで","あわれんで"],["ください"],["。"],["ラザロ"],["を"],["よこして"],["、"],["指先","ゆびさき"],["を"],["水","みず"],["に"],["浸し","ひたし"],["、"],["わたし"],["の"],["舌","した"],["を"],["冷やさせて","ひやさせて"],["ください"],["。"],["わたし"],["は"],["この"],["炎","ほのお"],["の"],["中","なか"],["で"],["もだえ苦しんで","もだえくるしんで"],["います"],["。"],["』"]]},{"verse":25,"text":"しかし、アブラハムは言った。『子よ、思い出してみるがよい。お前は生きている間に良いものをもらっていたが、ラザロは反対に悪いものをもらっていた。今は、ここで彼は慰められ、お前はもだえ苦しむのだ。","tok":[["しかし"],["、"],["アブラハム"],["は"],["言った","いった"],["。"],["『"],["子","こ"],["よ"],["、"],["思い出して","おもいだして"],["みる"],["が"],["よい"],["。"],["お前","おまえ"],["は"],["生きて","いきて"],["いる"],["間","あいだ"],["に"],["良い","よい"],["もの"],["を"],["もらって"],["いた"],["が"],["、"],["ラザロ"],["は"],["反対","はんたい"],["に"],["悪い","わるい"],["もの"],["を"],["もらって"],["いた"],["。"],["今","いま"],["は"],["、"],["ここ"],["で"],["彼","かれ"],["は"],["慰められ","なぐさめられ"],["、"],["お前","おまえ"],["は"],["もだえ苦しむ","もだえくるしむ"],["の"],["だ"],["。"]]},{"verse":26,"text":"そればかりか、わたしたちとお前たちの間には大きな淵があって、ここからお前たちの方へ渡ろうとしてもできないし、そこからわたしたちの方に越えて来ることもできない。』","tok":[["それ"],["ばかり"],["か"],["、"],["わたしたち"],["と"],["お前","おまえ"],["たち"],["の"],["間","あいだ"],["に"],["は"],["大きな","おおきな"],["淵","ふち"],["が"],["あって"],["、"],["ここ"],["から"],["お前","おまえ"],["たち"],["の"],["方","ほう"],["へ"],["渡ろう","わたろう"],["として"],["も"],["できない"],["し"],["、"],["そこ"],["から"],["わたしたち"],["の"],["方","ほう"],["に"],["越えて","こえて"],["来る","くる"],["こと"],["も"],["できない"],["。"],["』"]]},{"verse":27,"text":"金持ちは言った。『父よ、ではお願いです。わたしの父親の家にラザロを遣わしてください。","tok":[["金持ち","かねもち"],["は"],["言った","いった"],["。"],["『"],["父","ちち"],["よ"],["、"],["で"],["は"],["お願い","おねがい"],["です"],["。"],["わたし"],["の"],["父親","ちちおや"],["の"],["家","いえ"],["に"],["ラザロ"],["を"],["遣わして","つかわして"],["ください"],["。"]]},{"verse":28,"text":"わたしには兄弟が五人います。あの者たちまで、こんな苦しい場所に来ることのないように、よく言い聞かせてください。』","tok":[["わたし"],["に"],["は"],["兄弟","きょうだい"],["が"],["五人","ごにん"],["います"],["。"],["あの"],["者","もの"],["たち"],["まで"],["、"],["こんな"],["苦しい","くるしい"],["場所","ばしょ"],["に"],["来る","くる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["よく"],["言い聞かせて","いいきかせて"],["ください"],["。"],["』"]]},{"verse":29,"text":"しかし、アブラハムは言った。『お前の兄弟たちにはモーセと預言者がいる。彼らに耳を傾けるがよい。』","tok":[["しかし"],["、"],["アブラハム"],["は"],["言った","いった"],["。"],["『"],["お前","おまえ"],["の"],["兄弟","きょうだい"],["たち"],["に"],["は"],["モーセ"],["と"],["預言者","よげんしゃ"],["が"],["いる"],["。"],["彼","かれ"],["ら"],["に"],["耳","みみ"],["を"],["傾ける","かたむける"],["が"],["よい"],["。"],["』"]]},{"verse":30,"text":"金持ちは言った。『いいえ、父アブラハムよ、もし、死んだ者の中からだれかが兄弟のところに行ってやれば、悔い改めるでしょう。』","tok":[["金持ち","かねもち"],["は"],["言った","いった"],["。"],["『"],["いいえ"],["、"],["父","ちち"],["アブラハム"],["よ"],["、"],["もし"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["中","なか"],["から"],["だれ"],["か"],["が"],["兄弟","きょうだい"],["の"],["ところ"],["に"],["行って","いって"],["やれば"],["、"],["悔い改めるでしょう","くいあらためるでしょう"],["。"],["』"]]},{"verse":31,"text":"アブラハムは言った。『もし、モーセと預言者に耳を傾けないのなら、たとえ死者の中から生き返る者があっても、その言うことを聞き入れはしないだろう。』」","tok":[["アブラハム"],["は"],["言った","いった"],["。"],["『"],["もし"],["、"],["モーセ"],["と"],["預言者","よげんしゃ"],["に"],["耳","みみ"],["を"],["傾けない","かたむけない"],["の"],["なら"],["、"],["たとえ"],["死者","ししゃ"],["の"],["中","なか"],["から"],["生き返る","いきかえる"],["者","もの"],["が"],["あって"],["も"],["、"],["その"],["言う","いう"],["こと"],["を"],["聞き入れ","ききいれ"],["は"],["しないだろう"],["。"],["』"],["」"]]}]
[{"verse":1,"text":"イエスは、民衆にこれらの言葉をすべて話し終えてから、カファルナウムに入られた。","tok":[["イエス"],["は"],["、"],["民衆","みんしゅう"],["に"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["すべて"],["話し","はなし"],["終えて","おえて"],["から"],["、"],["カファルナウム"],["に"],["入られた","はいられた"],["。"]]},{"verse":2,"text":"ところで、ある百人隊長に重んじられている部下が、病気で死にかかっていた。","tok":[["ところ"],["で"],["、"],["ある"],["百人","ひゃくにん"],["隊長","たいちょう"],["に"],["重んじられて","おもんじられて"],["いる"],["部下","ぶか"],["が"],["、"],["病気","びょうき"],["で"],["死にかかって","しにかかって"],["いた"],["。"]]},{"verse":3,"text":"イエスのことを聞いた百人隊長は、ユダヤ人の長老たちを使いにやって、部下を助けに来てくださるように頼んだ。","tok":[["イエス"],["の"],["こと"],["を"],["聞いた","きいた"],["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["長老","ちょうろう"],["たち"],["を"],["使い","つかい"],["に"],["やって"],["、"],["部下","ぶか"],["を"],["助け","たすけ"],["に"],["来て","きて"],["くださる"],["よう"],["に"],["頼んだ","たのんだ"],["。"]]},{"verse":4,"text":"長老たちはイエスのもとに来て、熱心に願った。「あの方は、そうしていただくのにふさわしい人です。","tok":[["長老","ちょうろう"],["たち"],["は"],["イエス"],["の"],["もと"],["に"],["来て","きて"],["、"],["熱心","ねっしん"],["に"],["願った","ねがった"],["。"],["「"],["あの"],["方","かた"],["は"],["、"],["そう"],["して"],["いただく"],["のに"],["ふさわしい"],["人","ひと"],["です"],["。"]]},{"verse":5,"text":"わたしたちユダヤ人を愛して、自ら会堂を建ててくれたのです。」","tok":[["わたしたち"],["ユダヤ人","ゆだやじん"],["を"],["愛して","あいして"],["、"],["自ら","みずから"],["会堂","かいどう"],["を"],["建てて","たてて"],["くれた"],["の"],["です"],["。"],["」"]]},{"verse":6,"text":"そこで、イエスは一緒に出かけられた。ところが、その家からほど遠からぬ所まで来たとき、百人隊長は友達を使いにやって言わせた。「主よ、御足労には及びません。わたしはあなたを自分の屋根の下にお迎えできるような者ではありません。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["一緒","いっしょ"],["に"],["出かけられた","でかけられた"],["。"],["ところ"],["が"],["、"],["その"],["家","いえ"],["から"],["ほど"],["遠からぬ","とおからぬ"],["所","ところ"],["まで"],["来た","きた"],["とき"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["友達","ともだち"],["を"],["使い","つかい"],["に"],["やって"],["言わせた","いわせた"],["。"],["「"],["主","ぬし"],["よ"],["、"],["御足労","ごそくろう"],["に"],["は"],["及びません","およびません"],["。"],["わたし"],["は"],["あなた"],["を"],["自分","じぶん"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["お迎え","おむかえ"],["できる"],["よう"],["な"],["者","もの"],["で"],["は"],["ありません"],["。"]]},{"verse":7,"text":"ですから、わたしの方からお伺いするのさえふさわしくないと思いました。ひと言おっしゃってください。そして、わたしの僕をいやしてください。","tok":[["です"],["から"],["、"],["わたし"],["の"],["方","ほう"],["から"],["お伺い","おうかがい"],["する"],["の"],["さえ"],["ふさわしく"],["ない"],["と"],["思いました","おもいました"],["。"],["ひと言","ひとこと"],["おっしゃって"],["ください"],["。"],["そして"],["、"],["わたし"],["の"],["僕","ぼく"],["を"],["いやして"],["ください"],["。"]]},{"verse":8,"text":"わたしも権威の下に置かれている者ですが、わたしの下には兵隊がおり、一人に『行け』と言えば行きますし、他の一人に『来い』と言えば来ます。また部下に『これをしろ』と言えば、そのとおりにします。」","tok":[["わたし"],["も"],["権威","けんい"],["の"],["下","した"],["に"],["置かれて","おかれて"],["いる"],["者","もの"],["です"],["が"],["、"],["わたし"],["の"],["下","した"],["に"],["は"],["兵隊","へいたい"],["が"],["おり"],["、"],["一人","ひとり"],["に"],["『"],["行け","いけ"],["』"],["と"],["言えば","いえば"],["行きます","いきます"],["し"],["、"],["他","た"],["の"],["一人","ひとり"],["に"],["『"],["来い","こい"],["』"],["と"],["言えば","いえば"],["来ます","きます"],["。"],["また"],["部下","ぶか"],["に"],["『"],["これ"],["を"],["しろ"],["』"],["と"],["言えば","いえば"],["、"],["その"],["とおり"],["に"],["します"],["。"],["」"]]},{"verse":9,"text":"イエスはこれを聞いて感心し、従っていた群衆の方を振り向いて言われた。「言っておくが、イスラエルの中でさえ、わたしはこれほどの信仰を見たことがない。」","tok":[["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["感心","かんしん"],["し"],["、"],["従って","したがって"],["いた"],["群衆","ぐんしゅう"],["の"],["方","ほう"],["を"],["振り向いて","ふりむいて"],["言われた","いわれた"],["。"],["「"],["言って","いって"],["おく"],["が"],["、"],["イスラエル"],["の"],["中","なか"],["で"],["さえ"],["、"],["わたし"],["は"],["これ"],["ほど"],["の"],["信仰","しんこう"],["を"],["見た","みた"],["こと"],["が"],["ない"],["。"],["」"]]},{"verse":10,"text":"使いに行った人たちが家に帰ってみると、その部下は元気になっていた。","tok":[["使い","つかい"],["に"],["行った","いった"],["人","ひと"],["たち"],["が"],["家","いえ"],["に"],["帰って","かえって"],["みる"],["と"],["、"],["その"],["部下","ぶか"],["は"],["元気","げんき"],["に"],["なって"],["いた"],["。"]]},{"verse":11,"text":"それから間もなく、イエスはナインという町に行かれた。弟子たちや大勢の群衆も一緒であった。","tok":[["それ"],["から"],["間","ま"],["も"],["なく"],["、"],["イエス"],["は"],["ナイン"],["と"],["いう"],["町","まち"],["に"],["行かれた","いかれた"],["。"],["弟子","でし"],["たち"],["や"],["大勢","たいせい"],["の"],["群衆","ぐんしゅう"],["も"],["一緒","いっしょ"],["で"],["あった"],["。"]]},{"verse":12,"text":"イエスが町の門に近づかれると、ちょうど、ある母親の一人息子が死んで、棺が担ぎ出されるところだった。その母親はやもめであって、町の人が大勢そばに付き添っていた。","tok":[["イエス"],["が"],["町","まち"],["の"],["門","もん"],["に"],["近づかれる","ちかづかれる"],["と"],["、"],["ちょうど"],["、"],["ある"],["母親","ははおや"],["の"],["一人","ひとり"],["息子","むすこ"],["が"],["死んで","しんで"],["、"],["棺","ひつぎ"],["が"],["担ぎ出される","かつぎだされる"],["ところ"],["だった"],["。"],["その"],["母親","ははおや"],["は"],["やもめ"],["で"],["あって"],["、"],["町","まち"],["の"],["人","ひと"],["が"],["大勢","おおぜい"],["そば"],["に"],["付き添って","つきそって"],["いた"],["。"]]},{"verse":13,"text":"主はこの母親を見て、憐れに思い、「もう泣かなくともよい」と言われた。","tok":[["主","ぬし"],["は"],["この"],["母親","ははおや"],["を"],["見て","みて"],["、"],["憐れ","あわれ"],["に"],["思い","おもい"],["、"],["「"],["もう"],["泣かなく","なかなく"],["とも"],["よい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":14,"text":"そして、近づいて棺に手を触れられると、担いでいる人たちは立ち止まった。イエスは、「若者よ、あなたに言う。起きなさい」と言われた。","tok":[["そして"],["、"],["近づいて","ちかづいて"],["棺","ひつぎ"],["に"],["手","て"],["を"],["触れられる","ふれられる"],["と"],["、"],["担いで","かついで"],["いる"],["人","ひと"],["たち"],["は"],["立ち止まった","たちどまった"],["。"],["イエス"],["は"],["、"],["「"],["若者","わかもの"],["よ"],["、"],["あなた"],["に"],["言う","ゆう"],["。"],["起き","おき"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":15,"text":"すると、死人は起き上がってものを言い始めた。イエスは息子をその母親にお返しになった。","tok":[["する"],["と"],["、"],["死人","しにん"],["は"],["起き上がって","おきあがって"],["もの"],["を"],["言い","いい"],["始めた","はじめた"],["。"],["イエス"],["は"],["息子","むすこ"],["を"],["その"],["母親","ははおや"],["に"],["お返し","おかえし"],["に"],["なった"],["。"]]},{"verse":16,"text":"人々は皆恐れを抱き、神を賛美して、「大預言者が我々の間に現れた」と言い、また、「神はその民を心にかけてくださった」と言った。","tok":[["人々","ひとびと"],["は"],["皆","みな"],["恐れ","おそれ"],["を"],["抱き","いだき"],["、"],["神","かみ"],["を"],["賛美","さんび"],["して"],["、"],["「"],["大","だい"],["預言者","よげんしゃ"],["が"],["我々","われわれ"],["の"],["間","あいだ"],["に"],["現れた","あらわれた"],["」"],["と"],["言い","いい"],["、"],["また"],["、"],["「"],["神","かみ"],["は"],["その"],["民","たみ"],["を"],["心","こころ"],["に"],["かけて"],["くださった"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"イエスについてのこの話は、ユダヤの全土と周りの地方一帯に広まった。","tok":[["イエス"],["について"],["の"],["この"],["話","はなし"],["は"],["、"],["ユダヤ"],["の"],["全土","ぜんど"],["と"],["周り","まわり"],["の"],["地方","ちほう"],["一帯","いったい"],["に"],["広まった","ひろまった"],["。"]]},{"verse":18,"text":"ヨハネの弟子たちが、これらすべてのことについてヨハネに知らせた。そこで、ヨハネは弟子の中から二人を呼んで、","tok":[["ヨハネ"],["の"],["弟子","でし"],["たち"],["が"],["、"],["これ"],["ら"],["すべて"],["の"],["こと"],["について"],["ヨハネ"],["に"],["知らせた","しらせた"],["。"],["そこ"],["で"],["、"],["ヨハネ"],["は"],["弟子","でし"],["の"],["中","なか"],["から"],["二人","ふたり"],["を"],["呼んで","よんで"],["、"]]},{"verse":19,"text":"主のもとに送り、こう言わせた。「来るべき方は、あなたでしょうか。それとも、ほかの方を待たなければなりませんか。」","tok":[["主","ぬし"],["の"],["もと"],["に"],["送り","おくり"],["、"],["こう"],["言わせた","いわせた"],["。"],["「"],["来るべき","きたるべき"],["方","かた"],["は"],["、"],["あなた"],["でしょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["ほか"],["の"],["方","ほう"],["を"],["待たなければ","またなければ"],["なりません"],["か"],["。"],["」"]]},{"verse":20,"text":"二人はイエスのもとに来て言った。「わたしたちは洗礼者ヨハネからの使いの者ですが、『来るべき方は、あなたでしょうか。それとも、ほかの方を待たなければなりませんか』とお尋ねするようにとのことです。」","tok":[["二人","ふたり"],["は"],["イエス"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["わたしたち"],["は"],["洗礼者","せんれいしゃ"],["ヨハネ"],["から"],["の"],["使い","つかい"],["の"],["者","もの"],["です"],["が"],["、"],["『"],["来るべき","きたるべき"],["方","かた"],["は"],["、"],["あなた"],["でしょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["ほか"],["の"],["方","ほう"],["を"],["待たなければ","またなければ"],["なりません"],["か"],["』"],["と"],["お尋ね","おたずね"],["する"],["よう"],["に"],["と"],["の"],["こと"],["です"],["。"],["」"]]},{"verse":21,"text":"そのとき、イエスは病気や苦しみや悪霊に悩んでいる多くの人々をいやし、大勢の盲人を見えるようにしておられた。","tok":[["その"],["とき"],["、"],["イエス"],["は"],["病気","びょうき"],["や"],["苦しみ","くるしみ"],["や"],["悪霊","あくりょう"],["に"],["悩んで","なやんで"],["いる"],["多く","おおく"],["の"],["人々","ひとびと"],["を"],["いやし"],["、"],["大勢","おおぜい"],["の"],["盲人","もうじん"],["を"],["見える","みえる"],["よう"],["に"],["して"],["おられた"],["。"]]},{"verse":22,"text":"それで、二人にこうお答えになった。「行って、見聞きしたことをヨハネに伝えなさい。目の見えない人は見え、足の不自由な人は歩き、重い皮膚病を患っている人は清くなり、耳の聞こえない人は聞こえ、死者は生き返り、貧しい人は福音を告げ知らされている。","tok":[["それ"],["で"],["、"],["二人","ふたり"],["に"],["こう"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["行って","いって"],["、"],["見聞き","みきき"],["した"],["こと"],["を"],["ヨハネ"],["に"],["伝え","つたえ"],["なさい"],["。"],["目","め"],["の"],["見えない","みえない"],["人","ひと"],["は"],["見え","みえ"],["、"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["は"],["歩き","あるき"],["、"],["重い","おもい"],["皮膚病","ひふびょう"],["を"],["患って","わずらって"],["いる"],["人","ひと"],["は"],["清く","きよく"],["なり"],["、"],["耳","みみ"],["の"],["聞こえない","きこえない"],["人","ひと"],["は"],["聞こえ","きこえ"],["、"],["死者","ししゃ"],["は"],["生き返り","いきかえり"],["、"],["貧しい","まずしい"],["人","ひと"],["は"],["福音","ふくいん"],["を"],["告げ知らされて","つげしらされて"],["いる"],["。"]]},{"verse":23,"text":"わたしにつまずかない人は幸いである。」","tok":[["わたし"],["に"],["つまずかない"],["人","ひと"],["は"],["幸い","さいわい"],["で"],["ある"],["。"],["」"]]},{"verse":24,"text":"ヨハネの使いが去ってから、イエスは群衆に向かってヨハネについて話し始められた。「あなたがたは何を見に荒れ野へ行ったのか。風にそよぐ葦か。","tok":[["ヨハネ"],["の"],["使い","つかい"],["が"],["去って","さって"],["から"],["、"],["イエス"],["は"],["群衆","ぐんしゅう"],["に"],["向かって","むかって"],["ヨハネ"],["について"],["話し","はなし"],["始められた","はじめられた"],["。"],["「"],["あなた"],["がた"],["は"],["何","なん"],["を"],["見","み"],["に"],["荒れ野","あれの"],["へ"],["行った","いった"],["の"],["か"],["。"],["風","かぜ"],["に"],["そよぐ"],["葦","あし"],["か"],["。"]]},{"verse":25,"text":"では、何を見に行ったのか。しなやかな服を着た人か。華やかな衣を着て、ぜいたくに暮らす人なら宮殿にいる。","tok":[["で"],["は"],["、"],["何","なん"],["を"],["見","み"],["に"],["行った","いった"],["の"],["か"],["。"],["しなやか"],["な"],["服","ふく"],["を"],["着た","きた"],["人","ひと"],["か"],["。"],["華やか","はなやか"],["な"],["衣","ころも"],["を"],["着て","きて"],["、"],["ぜいたく"],["に"],["暮らす","くらす"],["人","ひと"],["なら"],["宮殿","きゅうでん"],["に"],["いる"],["。"]]},{"verse":26,"text":"では、何を見に行ったのか。預言者か。そうだ、言っておく。預言者以上の者である。","tok":[["で"],["は"],["、"],["何","なん"],["を"],["見","み"],["に"],["行った","いった"],["の"],["か"],["。"],["預言者","よげんしゃ"],["か"],["。"],["そう"],["だ"],["、"],["言って","いって"],["おく"],["。"],["預言者","よげんしゃ"],["以上","いじょう"],["の"],["者","もの"],["で"],["ある"],["。"]]},{"verse":27,"text":"『見よ、わたしはあなたより先に使者を遣わし、あなたの前に道を準備させよう』と書いてあるのは、この人のことだ。","tok":[["『"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["より"],["先","さき"],["に"],["使者","ししゃ"],["を"],["遣わし","つかわし"],["、"],["あなた"],["の"],["前","まえ"],["に"],["道","みち"],["を"],["準備","じゅんび"],["させよう"],["』"],["と"],["書いて","かいて"],["ある"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["だ"],["。"]]},{"verse":28,"text":"言っておくが、およそ女から生まれた者のうち、ヨハネより偉大な者はいない。しかし、神の国で最も小さな者でも、彼よりは偉大である。」","tok":[["言って","いって"],["おく"],["が"],["、"],["およそ"],["女","おんな"],["から"],["生まれた","うまれた"],["者","もの"],["の"],["うち"],["、"],["ヨハネ"],["より"],["偉大","いだい"],["な"],["者","もの"],["は"],["いない"],["。"],["しかし"],["、"],["神","かみ"],["の"],["国","くに"],["で"],["最も","もっとも"],["小さな","ちいさな"],["者","もの"],["で"],["も"],["、"],["彼","かれ"],["より"],["は"],["偉大","いだい"],["で"],["ある"],["。"],["」"]]},{"verse":29,"text":"民衆は皆ヨハネの教えを聞き、徴税人さえもその洗礼を受け、神の正しさを認めた。","tok":[["民衆","みんしゅう"],["は"],["皆","みな"],["ヨハネ"],["の"],["教え","おしえ"],["を"],["聞き","きき"],["、"],["徴税人","ちょうぜいにん"],["さえ"],["も"],["その"],["洗礼","せんれい"],["を"],["受け","うけ"],["、"],["神","かみ"],["の"],["正し","ただし"],["さ"],["を"],["認めた","みとめた"],["。"]]},{"verse":30,"text":"しかし、ファリサイ派の人々や律法の専門家たちは、彼から洗礼を受けないで、自分に対する神の御心を拒んだ。","tok":[["しかし"],["、"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["や"],["律法","りっぽう"],["の"],["専門家","せんもんか"],["たち"],["は"],["、"],["彼","かれ"],["から"],["洗礼","せんれい"],["を"],["受けないで","うけないで"],["、"],["自分","じぶん"],["に"],["対する","たいする"],["神","かみ"],["の"],["御心","おこころ"],["を"],["拒んだ","こばんだ"],["。"]]},{"verse":31,"text":"「では、今の時代の人たちは何にたとえたらよいか。彼らは何に似ているか。","tok":[["「"],["で"],["は"],["、"],["今","いま"],["の"],["時代","じだい"],["の"],["人","ひと"],["たち"],["は"],["何","なん"],["に"],["たとえたら"],["よい"],["か"],["。"],["彼","かれ"],["ら"],["は"],["何","なん"],["に"],["似て","にて"],["いる"],["か"],["。"]]},{"verse":32,"text":"広場に座って、互いに呼びかけ、こう言っている子供たちに似ている。『笛を吹いたのに、踊ってくれなかった。葬式の歌をうたったのに、泣いてくれなかった。』","tok":[["広場","ひろば"],["に"],["座って","すわって"],["、"],["互い","たがい"],["に"],["呼びかけ","よびかけ"],["、"],["こう"],["言って","いって"],["いる"],["子供","こども"],["たち"],["に"],["似て","にて"],["いる"],["。"],["『"],["笛","ふえ"],["を"],["吹いた","ふいた"],["のに"],["、"],["踊って","おどって"],["くれなかった"],["。"],["葬式","そうしき"],["の"],["歌","うた"],["を"],["うたった"],["のに"],["、"],["泣いて","ないて"],["くれなかった"],["。"],["』"]]},{"verse":33,"text":"洗礼者ヨハネが来て、パンも食べずぶどう酒も飲まずにいると、あなたがたは、『あれは悪霊に取りつかれている』と言い、","tok":[["洗礼者","せんれいしゃ"],["ヨハネ"],["が"],["来て","きて"],["、"],["パン"],["も"],["食べず","たべず"],["ぶどう酒","ぶどうしゅ"],["も"],["飲まず","のまず"],["に"],["いる"],["と"],["、"],["あなた"],["がた"],["は"],["、"],["『"],["あれ"],["は"],["悪霊","あくりょう"],["に"],[
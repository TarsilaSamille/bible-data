[{"verse":1,"text":"そのころ、皇帝アウグストゥスから全領土の住民に、登録をせよとの勅令が出た。","tok":[["その"],["ころ"],["、"],["皇帝","こうてい"],["アウグストゥス"],["から"],["全","ぜん"],["領土","りょうど"],["の"],["住民","じゅうみん"],["に"],["、"],["登録","とうろく"],["を"],["せよ"],["と"],["の"],["勅令","ちょくれい"],["が"],["出た","でた"],["。"]]},{"verse":2,"text":"これは、キリニウスがシリア州の総督であったときに行われた最初の住民登録である。","tok":[["これ"],["は"],["、"],["キリニウス"],["が"],["シリア"],["州","しゅう"],["の"],["総督","そうとく"],["で"],["あった"],["とき"],["に"],["行われた","おこなわれた"],["最初","さいしょ"],["の"],["住民","じゅうみん"],["登録","とうろく"],["で"],["ある"],["。"]]},{"verse":3,"text":"人々は皆、登録するためにおのおの自分の町へ旅立った。","tok":[["人々","ひとびと"],["は"],["皆","みな"],["、"],["登録","とうろく"],["する"],["ため"],["に"],["おのおの"],["自分","じぶん"],["の"],["町","まち"],["へ"],["旅立った","たびだった"],["。"]]},{"verse":4,"text":"ヨセフもダビデの家に属し、その血筋であったので、ガリラヤの町ナザレから、ユダヤのベツレヘムというダビデの町へ上って行った。","tok":[["ヨセフ"],["も"],["ダビデ"],["の"],["家","いえ"],["に"],["属し","ぞくし"],["、"],["その"],["血筋","ちすじ"],["で"],["あった"],["ので"],["、"],["ガリラヤ"],["の"],["町","まち"],["ナザレ"],["から"],["、"],["ユダヤ"],["の"],["ベツレヘム"],["と"],["いう"],["ダビデ"],["の"],["町","まち"],["へ"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":5,"text":"身ごもっていた、いいなずけのマリアと一緒に登録するためである。","tok":[["身ごもって","みごもって"],["いた"],["、"],["いいなずけ"],["の"],["マリア"],["と"],["一緒","いっしょ"],["に"],["登録","とうろく"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"ところが、彼らがベツレヘムにいるうちに、マリアは月が満ちて、","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["が"],["ベツレヘム"],["に"],["いる"],["うち"],["に"],["、"],["マリア"],["は"],["月","つき"],["が"],["満ちて","みちて"],["、"]]},{"verse":7,"text":"初めての子を産み、布にくるんで飼い葉桶に寝かせた。宿屋には彼らの泊まる場所がなかったからである。","tok":[["初めて","はじめて"],["の"],["子","こ"],["を"],["産み","うみ"],["、"],["布","ぬの"],["に"],["くる"],["ん"],["で"],["飼い葉","かいば"],["桶","おけ"],["に"],["寝かせた","ねかせた"],["。"],["宿屋","やどや"],["に"],["は"],["彼","かれ"],["ら"],["の"],["泊まる","とまる"],["場所","ばしょ"],["が"],["なかった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"その地方で羊飼いたちが野宿をしながら、夜通し羊の群れの番をしていた。","tok":[["その"],["地方","ちほう"],["で"],["羊飼い","ひつじかい"],["たち"],["が"],["野宿","のじゅく"],["を"],["し"],["ながら"],["、"],["夜通し","よどおし"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["番","ばん
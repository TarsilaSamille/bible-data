[{"verse":1,"text":"イエスはエリコに入り、町を通っておられた。","tok":[["イエス"],["は"],["エリコ"],["に"],["入り","はいり"],["、"],["町","まち"],["を"],["通って","とおって"],["おられた"],["。"]]},{"verse":2,"text":"そこにザアカイという人がいた。この人は徴税人の頭で、金持ちであった。","tok":[["そこ"],["に"],["ザアカイ"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["この"],["人","ひと"],["は"],["徴税人","ちょうぜいにん"],["の"],["頭","あたま"],["で"],["、"],["金持ち","かねもち"],["で"],["あった"],["。"]]},{"verse":3,"text":"イエスがどんな人か見ようとしたが、背が低かったので、群衆に遮られて見ることができなかった。","tok":[["イエス"],["が"],["どんな"],["人","ひと"],["か"],["見よう","みよう"],["と"],["した"],["が"],["、"],["背","せ"],["が"],["低かった","ひくかった"],["ので"],["、"],["群衆","ぐんしゅう"],["に"],["遮られて","さえぎられて"],["見る","みる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":4,"text":"それで、イエスを見るために、走って先回りし、いちじく桑の木に登った。そこを通り過ぎようとしておられたからである。","tok":[["それ"],["で"],["、"],["イエス"],["を"],["見る","みる"],["ため"],["に"],["、"],["走って","はしって"],["先回り","さきまわり"],["し"],["、"],["いちじく"],["桑","くわ"],["の"],["木","き"],["に"],["登った","のぼった"],["。"],["そこ"],["を"],["通り過ぎよう","とおりすぎよう"],["として"],["おられた"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"イエスはその場所に来ると、上を見上げて言われた。「ザアカイ、急いで降りて来なさい。今日は、ぜひあなたの家に泊まりたい。」","tok":[["イエス"],["は"],["その"],["場所","ばしょ"],["に"],["来る","くる"],["と"],["、"],["上","うえ"],["を"],["見上げて","みあげて"],["言われた","いわれた"],["。"],["「"],["ザアカイ"],["、"],["急いで","いそいで"],["降りて","おりて"],["来","き"],["なさい"],["。"],["今日","きょう"],["は"],["、"],["ぜひ"],["あなた"],["の"],["家","いえ"],["に"],["泊まりたい","とまりたい"],["。"],["」"]]},{"verse":6,"text":"ザアカイは急いで降りて来て、喜んでイエスを迎えた。","tok":[["ザアカイ"],["は"],["急いで","いそいで"],["降りて","おりて"],["来て","きて"],["、"],["喜んで","よろこんで"],["イエス"],["を"],["迎えた","むかえた"],["。"]]},{"verse":7,"text":"これを見た人たちは皆つぶやいた。「あの人は罪深い男のところに行って宿をとった。」","tok":[["これ"],["を"],["見た","みた"],["人","ひと"],["たち"],["は"],["皆","みな"],["つぶやいた"],["。"],["「"],["あの"],["人","ひと"],["は"],["罪深い","つみぶかい"],["男","おとこ"],["の"],["ところ"],["に"],["行って","いって"],["宿","やど"],["を"],["とった"],["。"],["」"]]},{"verse":8,"text":"しかし、ザアカイは立ち上がって、主に言った。「主よ、わたしは財産の半分を貧しい人々に施します。また、だれかから何かだまし取っていたら、それを四倍にして返します。」","tok":[["しかし"],["、"],["ザアカイ"],["は"],["立ち上がって","たちあがって"],["、"],["主に","おもに"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["わたし"],["は"],["財産","ざいさん"],["の"],["半分","はんぶん"],["を"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["施します","ほどこします"],["。"],["また"],["、"],["だれ"],["か"],["から"],["何","なん"],["か"],["だまし取って","だましとって"],["いたら"],["、"],["それ"],["を"],["四","よん"],["倍","ばい"],["に"],["して"],["返します","かえします"],["。"],["」"]]},{"verse":9,"text":"イエスは言われた。「今日、救いがこの家を訪れた。この人もアブラハムの子なのだから。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["今日","きょう"],["、"],["救い","すくい"],["が"],["この"],["家","いえ"],["を"],["訪れた","おとずれた"],["。"],["この"],["人","ひと"],["も"],["アブラハム"],["の"],["子","こ"],["な"],["の"],["だ"],["から"],["。"]]},{"verse":10,"text":"人の子は、失われたものを捜して救うために来たのである。」","tok":[["人","ひと"],["の"],["子","こ"],["は"],["、"],["失われた","うしなわれた"],["もの"],["を"],["捜して","さがして"],["救う","すくう"],["ため"],["に"],["来た","きた"],["ので"],["ある"],["。"],["」"]]},{"verse":11,"text":"人々がこれらのことに聞き入っているとき、イエスは更に一つのたとえを話された。エルサレムに近づいておられ、それに、人々が神の国はすぐにも現れるものと思っていたからである。","tok":[["人々","ひとびと"],["が"],["これ"],["ら"],["の"],["こと"],["に"],["聞き入って","ききいって"],["いる"],["とき"],["、"],["イエス"],["は"],["更に","さらに"],["一","ひと"],["つ"],["の"],["たとえ"],["を"],["話された","はなされた"],["。"],["エルサレム"],["に"],["近づいて","ちかづいて"],["おられ"],["、"],["それ"],["に"],["、"],["人々","ひとびと"],["が"],["神","かみ"],["の"],["国","くに"],["は"],["すぐ"],["に"],["も"],["現れる","あらわれる"],["もの"],["と"],["思って","おもって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"イエスは言われた。「ある立派な家柄の人が、王の位を受けて帰るために、遠い国へ旅立つことになった。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["ある"],["立派","りっぱ"],["な"],["家柄","いえがら"],["の"],["人","ひと"],["が"],["、"],["王","おう"],["の"],["位","くらい"],["を"],["受けて","うけて"],["帰る","かえる"],["ため"],["に"],["、"],["遠い","とおい"],["国","くに"],["へ"],["旅立つ","たびだつ"],["こと"],["に"],["なった"],["。"]]},{"verse":13,"text":"そこで彼は、十人の僕を呼んで十ムナの金を渡し、『わたしが帰って来るまで、これで商売をしなさい』と言った。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["、"],["十人","じゅうにん"],["の"],["僕","ぼく"],["を"],["呼んで","よんで"],["十","じゅう"],["ムナ"],["の"],["金","かね"],["を"],["渡し","わたし"],["、"],["『"],["わたし"],["が"],["帰って","かえって"],["来る","くる"],["まで"],["、"],["これ"],["で"],["商売","しょうばい"],["を"],["し"],["なさい"],["』"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"しかし、国民は彼を憎んでいたので、後から使者を送り、『我々はこの人を王にいただきたくない』と言わせた。","tok":[["しかし"],["、"],["国民","こくみん"],["は"],["彼","かれ"],["を"],["憎んで","にくんで"],["いた"],["ので"],["、"],["後","あと"],["から"],["使者","ししゃ"],["を"],["送り","おくり"],["、"],["『"],["我々","われわれ"],["は"],["この"],["人","ひと"],["を"],["王","おう"],["に"],["いただきたく"],["ない"],["』"],["と"],["言わせた","いわせた"],["。"]]},{"verse":15,"text":"さて、彼は王の位を受けて帰って来ると、金を渡しておいた僕を呼んで来させ、どれだけ利益を上げたかを知ろうとした。","tok":[["さて"],["、"],["彼","かれ"],["は"],["王","おう"],["の"],["位","くらい"],["を"],["受けて","うけて"],["帰って","かえって"],["来る","くる"],["と"],["、"],["金","きん"],["を"],["渡して","わたして"],["おいた"],["僕","ぼく"],["を"],["呼んで","よんで"],["来させ","きさせ"],["、"],["どれ"],["だけ"],["利益","りえき"],["を"],["上げた","あげた"],["か"],["を"],["知ろう","しろう"],["と"],["した"],["。"]]},{"verse":16,"text":"最初の者が進み出て、『御主人様、あなたの一ムナで十ムナもうけました』と言った。","tok":[["最初","さいしょ"],["の"],["者","もの"],["が"],["進み出て","すすみでて"],["、"],["『"],["御主人様","みうしさま"],["、"],["あなた"],["の"],["一","いち"],["ムナ"],["で"],["十","じゅう"],["ムナ"],["もうけました"],["』"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"主人は言った。『良い僕だ。よくやった。お前はごく小さな事に忠実だったから、十の町の支配権を授けよう。』","tok":[["主人","しゅじん"],["は"],["言った","いった"],["。"],["『"],["良い","よい"],["僕","ぼく"],["だ"],["。"],["よく"],["やった"],["。"],["お前","おまえ"],["は"],["ごく"],["小さな","ちいさな"],["事","こと"],["に"],["忠実","ちゅうじつ"],["だった"],["から"],["、"],["十","じゅう"],["の"],["町","まち"],["の"],["支配権","しはいけん"],["を"],["授けよう","さずけよう"],["。"],["』"]]},{"verse":18,"text":"二番目の者が来て、『御主人様、あなたの一ムナで五ムナ稼ぎました』と言った。","tok":[["二番目","にばんめ"],["の"],["者","もの"],["が"],["来て","きて"],["、"],["『"],["御主人様","みうしさま"],["、"],["あなた"],["の"],["一","いち"],["ムナ"],["で"],["五","ご"],["ムナ"],["稼ぎました","かせぎました"],["』"],["と"],["言った","いった"],["。"]]},{"verse":19,"text":"主人は、『お前は五つの町を治めよ』と言った。","tok":[["主人","しゅじん"],["は"],["、"],["『"],["お前","おまえ"],["は"],["五","いつ"],["つ"],["の"],["町","まち"],["を"],["治めよ","おさめよ"],["』"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"また、ほかの者が来て言った。『御主人様、これがあなたの一ムナです。布に包んでしまっておきました。","tok":[["また"],["、"],["ほか"],["の"],["者","もの"],["が"],["来て","きて"],["言った","いった"],["。"],["『"],["御主人様","みうしさま
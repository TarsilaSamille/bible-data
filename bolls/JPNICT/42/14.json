[{"verse":1,"text":"安息日のことだった。イエスは食事のためにファリサイ派のある議員の家にお入りになったが、人々はイエスの様子をうかがっていた。","tok":[["安息日","あんそくび"],["の"],["こと"],["だった"],["。"],["イエス"],["は"],["食事","しょくじ"],["の"],["ため"],["に"],["ファリサイ"],["派","は"],["の"],["ある"],["議員","ぎいん"],["の"],["家","いえ"],["に"],["お入り","おいり"],["に"],["なった"],["が"],["、"],["人々","ひとびと"],["は"],["イエス"],["の"],["様子","ようす"],["を"],["うかがって"],["いた"],["。"]]},{"verse":2,"text":"そのとき、イエスの前に水腫を患っている人がいた。","tok":[["その"],["とき"],["、"],["イエス"],["の"],["前","まえ"],["に"],["水腫","すいしゅ"],["を"],["患って","わずらって"],["いる"],["人","ひと"],["が"],["いた"],["。"]]},{"verse":3,"text":"そこで、イエスは律法の専門家たちやファリサイ派の人々に言われた。「安息日に病気を治すことは律法で許されているか、いないか。」","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["律法","りっぽう"],["の"],["専門家","せんもんか"],["たち"],["や"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["に"],["言われた","いわれた"],["。"],["「"],["安息日","あんそくび"],["に"],["病気","びょうき"],["を"],["治す","なおす"],["こと"],["は"],["律法","りっぽう"],["で"],["許されて","ゆるされて"],["いる"],["か"],["、"],["いない"],["か"],["。"],["」"]]},{"verse":4,"text":"彼らは黙っていた。すると、イエスは病人の手を取り、病気をいやしてお帰しになった。","tok":[["彼","かれ"],["ら"],["は"],["黙って","だまって"],["いた"],["。"],["する"],["と"],["、"],["イエス"],["は"],["病人","びょうにん"],["の"],["手","て"],["を"],["取り","とり"],["、"],["病気","びょうき"],["を"],["いやして"],["お帰し","おかえし"],["に"],["なった"],["。"]]},{"verse":5,"text":"そして、言われた。「あなたたちの中に、自分の息子か牛が井戸に落ちたら、安息日だからといって、すぐに引き上げてやらない者がいるだろうか。」","tok":[["そして"],["、"],["言われた","いわれた"],["。"],["「"],["あなた"],["たち"],["の"],["中","なか"],["に"],["、"],["自分","じぶん"],["の"],["息子","むすこ"],["か"],["牛","うし"],["が"],["井戸","いど"],["に"],["落ちたら","おちたら"],["、"],["安息日","あんそくび"],["だ"],["から"],["と"],["いって"],["、"],["すぐ"],["に"],["引き上げて","ひきあげて"],["やらない"],["者","もの"],["が"],["いるだろう"],["か"],["。"],["」"]]},{"verse":6,"text":"彼らは、これに対して答えることができなかった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["これ"],["に対して","にたいして"],["答える","こたえる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":7,"text":"イエスは、招待を受けた客が上席を選ぶ様子に気づいて、彼らにたとえを話された。","tok":[["イエス"],["は"],["、"],["招待","しょうたい"],["を"],["受けた","うけた"],["客","きゃく"],["が"],["上席","じょうせき"],["を"],["選ぶ","えらぶ"],["様子","ようす"],["に"],["気づいて","きづいて"],["、"],["彼","かれ"],["ら"],["に"],["たとえ"],["を"],["話された","はなされた"],["。"]]},{"verse":8,"text":"「婚宴に招待されたら、上席に着いてはならない。あなたよりも身分の高い人が招かれており、","tok":[["「"],["婚","こん"],["宴","えん"],["に"],["招待","しょうたい"],["されたら"],["、"],["上席","じょうせき"],["に"],["着いて","ついて"],["は"],["ならない"],["。"],["あなた"],["より"],["も"],["身分","みぶん"],["の"],["高い","たかい"],["人","ひと"],["が"],["招かれて","まねかれて"],["おり"],["、"]]},{"verse":9,"text":"あなたやその人を招いた人が来て、『この方に席を譲ってください』と言うかもしれない。そのとき、あなたは恥をかいて末席に着くことになる。","tok":[["あなた"],["や"],["その"],["人","ひと"],["を"],["招いた","まねいた"],["人","ひと"],["が"],["来て","きて"],["、"],["『"],["この"],["方","かた"],["に"],["席","せき"],["を"],["譲って","ゆずって"],["ください"],["』"],["と"],["言う","ゆう"],["か"],["も"],["しれない"],["。"],["その"],["とき"],["、"],["あなた"],["は"],["恥","はじ"],["を"],["かいて"],["末席","まっせき"],["に"],["着く","つく"],["こと"],["に"],["なる"],["。"]]},{"verse":10,"text":"招待を受けたら、むしろ末席に行って座りなさい。そうすると、あなたを招いた人が来て、『さあ、もっと上席に進んでください』と言うだろう。そのときは、同席の人みんなの前で面目を施すことになる。","tok":[["招待","しょうたい"],["を"],["受けたら","うけたら"],["、"],["むしろ"],["末席","まっせき"],["に"],["行って","いって"],["座り","すわり"],["なさい"],["。"],["そう"],["する"],["と"],["、"],["あなた"],["を"],["招いた","まねいた"],["人","ひと"],["が"],["来て","きて"],["、"],["『"],["さあ"],["、"],["もっと"],["上席","じょうせき"],["に"],["進んで","すすんで"],["ください"],["』"],["と"],["言うだろう","ゆうだろう"],["。"],["その"],["とき"],["は"],["、"],["同席","どうせき"],["の"],["人","ひと"],["みんな"],["の"],["前","まえ"],["で"],["面目","めんぼく"],["を"],["施す","ほどこす"],["こと"],["に"],["なる"],["。"]]},{"verse":11,"text":"だれでも高ぶる者は低くされ、へりくだる者は高められる。」","tok":[["だれ"],["で"],["も"],["高ぶる","たかぶる"],["者","もの"],["は"],["低く","ひくく"],["され"],["、"],["へりくだる"],["者","もの"],["は"],["高められる","たかめられる"],["。"],["」"]]},{"verse":12,"text":"また、イエスは招いてくれた人にも言われた。「昼食や夕食の会を催すときには、友人も、兄弟も、親類も、近所の金持ちも呼んではならない。その人たちも、あなたを招いてお返しをするかも知れないからである。","tok":[["また"],["、"],["イエス"],["は"],["招いて","まねいて"],["くれた"],["人","ひと"],["に"],["も"],["言われた","いわれた"],["。"],["「"],["昼食","ちゅうしょく"],["や"],["夕食","ゆうしょく"],["の"],["会","かい"],["を"],["催す","もよおす"],["とき"],["に"],["は"],["、"],["友人","ゆうじん"],["も"],["、"],["兄弟","きょうだい"],["も"],["、"],["親類","しんるい"],["も"],["、"],["近所","きんじょ"],["の"],["金持ち","かねもち"],["も"],["呼んで","よんで"],["は"],["ならない"],["。"],["その"],["人","ひと"],["たち"],["も"],["、"],["あなた"],["を"],["招いて","まねいて"],["お返し","おかえし"],["を"],["する"],["か"],["も"],["知れない","しれない"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"宴会を催すときには、むしろ、貧しい人、体の不自由な人、足の不自由な人、目の見えない人を招きなさい。","tok":[["宴会","えんかい"],["を"],["催す","もよおす"],["とき"],["に"],["は"],["、"],["むしろ"],["、"],["貧しい","まずしい"],["人","ひと"],["、"],["体","からだ"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["、"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["、"],["目","め"],["の"],["見えない","みえない"],["人","ひと"],["を"],["招き","まねき"],["なさい"],["。"]]},{"verse":14,"text":"そうすれば、その人たちはお返しができないから、あなたは幸いだ。正しい者たちが復活するとき、あなたは報われる。」","tok":[["そう"],["すれば"],["、"],["その"],["人","ひと"],["たち"],["は"],["お返し","おかえし"],["が"],["できない"],["から"],["、"],["あなた"],["は"],["幸い","さいわい"],["だ"],["。"],["正しい","ただしい"],["者","もの"],["たち"],["が"],["復活","ふっかつ"],["する"],["とき"],["、"],["あなた"],["は"],["報われる","むくわれる"],["。"],["」"]]},{"verse":15,"text":"食事を共にしていた客の一人は、これを聞いてイエスに、「神の国で食事をする人は、なんと幸いなことでしょう」と言った。","tok":[["食事","しょくじ"],["を"],["共","とも"],["に"],["して"],["いた"],["客","きゃく"],["の"],["一人","ひとり"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["イエス"],["に"],["、"],["「"],["神","かみ"],["の"],["国","くに"],["で"],["食事","しょくじ"],["を"],["する"],["人","ひと"],["は"],["、"],["なん"],["と"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":16,"text":"そこで、イエスは言われた。「ある人が盛大な宴会を催そうとして、大勢の人を招き、","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["ある"],["人","ひと"],["が"],["盛大","せいだい"],["な"],["宴会","えんかい"],["を"],["催そう","もよおそう"],["として"],["、"],["大勢","おおぜい"],["の"],["人","ひと"],["を"],["招き","まねき"],["、"]]},{"verse":17,"text":"宴会の時刻になったので、僕を送り、招いておいた人々に、『もう用意ができましたから、おいでください』と言わせた。","tok":[["宴会","えんかい"],["の"],["時刻","じこく"],["に"],["なった"],["ので"],["、"],["僕","ぼく"],["を"],["送り","おくり"],["、"],["招いて","まねいて"],["おいた"],["人々","ひとびと"],["に"],["、"],["『"],["もう"],["用意","ようい"],["が"],["できました"],["から"],["、"],["おいで"],["ください"],["』"],["と"],["言わせた","いわせた"],["。"]]},{"verse":18,"text":"すると皆、次々に断った。最初の人は、『畑を買ったので、見に行かねばなりません。どうか、失礼させてください』と言った。","tok":[["する"],["と"],["皆","みな"],["、"],["次々","つぎつぎ"],["に"],["断った","ことわった"],["。"],["最初","さいしょ"],["の"],["人","ひと"],["は"],["、"],["『"],["畑","はたけ"],["を"],["買った","かった"],["ので"],["、"],["見","み"],["に"],["行かねば","いかねば"],["なりません"],["。"],["どう"],["か"],["、"],["失礼","しつれい"],["させて"],["ください"],["』"],["と"],["言った","いった"],["。"]]},{"verse":19,"text":"ほかの人は、『牛を二頭ずつ五組買ったので、それを調べに行くところです。どうか、失礼させてください』と言った。","tok":[["ほか"],["の"],["人","ひと"],["は"],["、"],["『"],["牛","うし"],["を"],["二頭","にとう"],["ずつ"],["五","ご"],["組","くみ"],["買った","かった"],["ので"],["、"],["それ"],["を"],["調べ","しらべ"],["に"],["行く","いく"],["ところ"],["です"],["。"],["どう"],["か"],["、"],["失礼","しつれい"],["させて"],["ください"],["』"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"また別の人は、『妻を迎えたばかりなので、行くことができません』と言った。","tok":[["また"],["別","べつ"],["の"],["人","ひと"],["は"],["、"],["『"],["妻","つま"],["を"],["迎えた","むかえた"],["ばかり"],["な"],["ので"],["、"],["行く","いく"],["こと"],["が"],["できません"],["』"],["と"],["言った","いった"],["。"]]},{"verse":21,"text":"僕は帰って、このことを主人に報告した。すると、家の主人は怒って、僕に言った。『急いで町の広場や路地へ出て行き、貧しい人、体の不自由な人、目の見えない人、足の不自由な人をここに連れて来なさい。』","tok":[["僕","ぼく"],["は"],["帰って","かえって"],["、"],["この"],["こと"],["を"],["主人","しゅじん"],["に"],["報告","ほうこく"],["した"],["。"],["する"],["と"],["、"],["家","いえ"],["の"],["主人","しゅじん"],["は"],["怒って","おこって"],["、"],["僕","ぼく"],["に"],["言った","いった"],["。"],["『"],["急いで","いそいで"],["町","まち"],["の"],["広場","ひろば"],["や"],["路地","ろじ"],["へ"],["出て","でて"],["行き","いき"],["、"],["貧しい","まずしい"],["人","ひと"],["、"],["体","からだ"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["、"],["目","め"],["の"],["見えない","みえない"],["人","ひと"],["、"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["を"],["ここ"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"],["』"]]},{"verse":22,"text":"やがて、僕が、『御主人様、仰せのとおりにいたしましたが、まだ席があります』と言うと、","tok":[["やがて"],["、"],["僕","ぼく"],["が"],["、"],["『"],["御主人様","みうしさま"],["、"],["仰せ","おおせ"],["の"],["とおり"],["に"],["いたしました"],["が"],["、"],["まだ"],["席","せき"],["が"],["あります"],["』"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":23,"text":"主人は言った。『通りや小道に出て行き、無理にでも人々を連れて来て、この家をいっぱいにしてくれ。","tok":[["主人","しゅじん"],["は"],["言った","いった"],["。"],["『"],["通り","とおり"],["や"],["小道","こみち"],["に"],["出て","でて"],["行き","いき"],["、"],["無理","むり"],["に"],["で"],["も"],["人々","ひとびと"],["を"],["連れて","つれて"],["来て","きて"],["、"],["この"],["家","いえ"],["を"],["いっぱい"],["に"],["して"],["くれ"],["。"]]},{"verse":24,"text":"言っておくが、あの招かれた人たちの中で、わたしの食事を味わう者は一人もいない。』」","tok":[["言って","いって"],["おく"],["が"],["、"],["あの"],["招かれた","まねかれた"],["人","ひと"],["たち"],["の"],["中","なか"],["で"],["、"],["わたし"],["の"],["食事","しょくじ"],["を"],["味わう","あじわう"],["者","もの"],["は"],["一人","ひとり"],["も"],["いない"],["。"],["』"],["」"]]},{"verse":25,"text":"大勢の群衆が一緒について来たが、イエスは振り向いて言われた。","tok":[["大勢","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["一緒","いっしょ"],["について"],["来た","きた"],["が"],["、"],["イエス"],["は"],["振り向いて","ふりむいて"],["言われた","いわれた"],["。"]]},{"verse":26,"text":"「もし、だれかがわたしのもとに来るとしても、父、母、妻、子供、兄弟、姉妹を、更に自分の命であろうとも、これを憎まないなら、わたしの弟子ではありえない。","tok":[["「"],["もし"],["、"],["だれ"],["か"],["が"],["わたし"],["の"],["もと"],["に"],["来る","くる"],["として"],["も"],["、"],["父","ちち"],["、"],["母","はは"],["、"],["妻","つま"],["、"],["子供","こども"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["を"],["、"],["更に","さらに"],["自分","じぶん"],["の"],["命","いのち"],["で"],["あろう"],["とも"],["、"],["これ"],["を"],["憎まないなら","にくまないなら"],["、"],["わたし"],["の"],["弟子","でし"],["で"],["は"],["あり"],["えない"],["。"]]},{"verse":27,"text":"自分の十字架を背負ってついて来る者でなければ、だれであれ、わたしの弟子ではありえない。","tok":[["自分","じぶん"],["の"],["十字架","じゅうじか"],["を"],["背負って","せおって"],["ついて"],["来る","くる"],["者","もの"],["で"],["なければ"],["、"],["だれ"],["で"],["あれ"],["、"],["わたし"],["の"],["弟子","でし"],["で"],["は"],["あり"],["えない"],["。"]]},{"verse":28,"text":"あなたがたのうち、塔を建てようとするとき、造り上げるのに十分な費用があるかどうか、まず腰をすえて計算しない者がいるだろうか。","tok":[["あなた"],["がた"],["の"],["うち"],["、"],["塔","とう"],["を"],["建てよう","たてよう"],["と"],["する"],["とき"],["、"],["造り上げる","つくりあげる"],["のに"],["十分","じゅうぶん"],["な"],["費用","ひよう"],["が"],["ある"],["か"],["どう"],["か"],["、"],["まず"],["腰","こし"],["を"],["すえて"],["計算","けいさん"],["しない"],["者","もの"],["が"],["いるだろう"],["か"],["。"]]},{"verse":29,"text":"そうしないと、土台を築いただけで完成できず、見ていた人々は皆あざけって、","tok":[["そう"],["しない"],["と"],["、"],["土台","どだい"],["を"],["築いた","きずいた"],["だけ"],["で"],["完成","かんせい"],["できず"],["、"],["見て","みて"],["いた"],["人々","ひとびと"],["は"],["皆","みな"],["あざけって"],["、"]]},{"verse":30,"text":"『あの人は建て始めたが、完成することはできなかった』と言うだろう。","tok":[["『"],["あの"],["人","ひと"],["は"],["建て","たて"],["始めた","はじめた"],["が"],["、"],["完成","かんせい"],["する"],["こと"],["は"],["できなかった"],["』"],["と"],["言うだろう","ゆうだろう"],["。"]]},{"verse":31,"text":"また、どんな王でも、ほかの王と戦いに行こうとするときは、二万の兵を率いて進軍して来る敵を、自分の一万の兵で迎え撃つことができるかどうか、まず腰をすえて考えてみないだろうか。","tok":[["また"],["、"],["どんな"],["王","おう"],["で"],["も"],["、"],["ほか"],["の"],["王","おう"],["と"],["戦い","たたかい"],["に"],["行こう","いこう"],["と"],["する"],["とき"],["は"],["、"],["二万","にまん"],["の"],["兵","へい"],["を"],["率いて","ひきいて"],["進軍","しんぐん"],["して"],["来る","くる"],["敵","てき"],["を"],["、"],["自分","じぶん"],["の"],["一万","いちまん"],["の"],["兵","へい"],["で"],["迎え撃つ","むかえうつ"],["こと"],["が"],["できる"],["か"],["どう"],["か"],["、"],["まず"],["腰","こし"],["を"],["すえて"],["考えて","かんがえて"],["みないだろう"],["か"],["。"]]},{"verse":32,"text":"もしできないと分かれば、敵がまだ遠方にいる間に使節を送って、和を求めるだろう。","tok":[["もし"],["できない"],["と"],["分かれば","わかれば"],["、"],["敵","てき"],["が"],["まだ"],["遠方","えんぽう"],["に"],["いる"],["間","あいだ"],["に"],["使節","しせつ"],["を"],["送って","おくって"],["、"],["和","わ"],["を"],["求めるだろう","もとめるだろう"],["。"]]},{"verse":33,"text":"だから、同じように、自分の持ち物を一切捨てないならば、あなたがたのだれ一人としてわたしの弟子ではありえない。」","tok":[["だ"],["から"],["、"],["同じ","おなじ"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["持ち物","もちもの"],["を"],["一","いち"],["切捨てないならば","きりすてないならば"],["、"],["あなた"],["がた"],["の"],["だれ"],["一人","ひとり"],["として"],["わたし"],["の"],["弟子","でし"],["で"],["は"],["あり"],["えない"],["。"],["」"]]},{"verse":34,"text":"「確かに塩は良いものだ。だが、塩も塩気がなくなれば、その塩は何によって味が付けられようか。","tok":[["「"],["確か","たしか"],["に"],["塩","しお"],["は"],["良い","よい"],["もの"],["だ"],["。"],["だ"],["が"],["、"],["塩","しお"],["も"],["塩気","しおけ"],["が"],["なくなれば"],["、"],["その"],["塩","しお"],["は"],["何","なん"],["によって"],["味","あじ"],["が"],["付けられよう","つけられよう"],["か"],["。"]]},{"verse":35,"text":"畑にも肥料にも、役立たず、外に投げ捨てられるだけだ。聞く耳のある者は聞きなさい。」","tok":[["畑","はたけ"],["に"],["も"],["肥料","ひりょう"],["に"],["も"],["、"],["役","やく"],["立たず","たたず"],["、"],["外","そと"],["に"],["投げ捨てられる","なげすてられる"],["だけ"],["だ"],["。"],["聞く","きく"],["耳","みみ"],["の"],["ある"],["者","もの"],[
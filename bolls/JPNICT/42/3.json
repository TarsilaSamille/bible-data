[{"verse":1,"text":"皇帝ティベリウスの治世の第十五年、ポンティオ‧ピラトがユダヤの総督、ヘロデがガリラヤの領主、その兄弟フィリポがイトラヤとトラコン地方の領主、リサニアがアビレネの領主、","tok":[["皇帝","こうてい"],["ティベリウス"],["の"],["治世","ちせい"],["の"],["第","だい"],["十五","じゅうご"],["年","ねん"],["、"],["ポンティオ"],["‧"],["ピラト"],["が"],["ユダヤ"],["の"],["総督","そうとく"],["、"],["ヘロデ"],["が"],["ガリラヤ"],["の"],["領主","りょうしゅ"],["、"],["その"],["兄弟","きょうだい"],["フィリポ"],["が"],["イトラヤ"],["と"],["トラコン"],["地方","ちほう"],["の"],["領主","りょうしゅ"],["、"],["リサニア"],["が"],["アビレネ"],["の"],["領主","りょうしゅ"],["、"]]},{"verse":2,"text":"アンナスとカイアファとが大祭司であったとき、神の言葉が荒れ野でザカリアの子ヨハネに降った。","tok":[["アンナス"],["と"],["カイアファ"],["と"],["が"],["大","だい"],["祭司","さいし"],["で"],["あった"],["とき"],["、"],["神","かみ"],["の"],["言葉","ことば"],["が"],["荒れ野","あれの"],["で"],["ザカリア"],["の"],["子","こ"],["ヨハネ"],["に"],["降った","ふった"],["。"]]},{"verse":3,"text":"そこで、ヨハネはヨルダン川沿いの地方一帯に行って、罪の赦しを得させるために悔い改めの洗礼を宣べ伝えた。","tok":[["そこ"],["で"],["、"],["ヨハネ"],["は"],["ヨルダン"],["川沿い","かわぞい"],["の"],["地方","ちほう"],["一帯","いったい"],["に"],["行って","いって"],["、"],["罪","つみ"],["の"],["赦し","ゆるし"],["を"],["得させる","えさせる"],["ため"],["に"],["悔い改め","くいあらため"],["の"],["洗礼","せんれい"],["を"],["宣べ伝えた","のべつたえた"],["。"]]},{"verse":4,"text":"これは、預言者イザヤの書に書いてあるとおりである。「荒れ野で叫ぶ者の声がする。『主の道を整え、その道筋をまっすぐにせよ。","tok":[["これ"],["は"],["、"],["預言者","よげんしゃ"],["イザヤ"],["の"],["書","しょ"],["に"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"],["「"],["荒れ野","あれの"],["で"],["叫ぶ","さけぶ"],["者","もの"],["の"],["声","こえ"],["が"],["する"],["。"],["『"],["主","ぬし"],["の"],["道","みち"],["を"],["整え","ととのえ"],["、"],["その"],["道筋","みちすじ"],["を"],["まっすぐ"],["に"],["せよ"],["。"]]},{"verse":5,"text":"谷はすべて埋められ、山と丘はみな低くされる。曲がった道はまっすぐに、でこぼこの道は平らになり、","tok":[["谷","たに"],["は"],["すべて"],["埋められ","うめられ"],["、"],["山","やま"],["と"],["丘","おか"],["は"],["みな"],["低く","ひくく"],["される"],["。"],["曲がった","まがった"],["道","みち"],["は"],["まっすぐ"],["に"],["、"],["でこぼこ"],["の"],["道","みち"],["は"],["平ら","たいら"],["に"],["なり"],["、"]]},{"verse":6,"text":"人は皆、神の救いを仰ぎ見る。』」","tok":[["人","ひと"],["は"],["皆","みな"],["、"],["神","かみ"],["の"],["救い","すくい"],["を"],["仰ぎ見る","あおぎみる"],["。"],["』"],["」"]]},{"verse":7,"text":"そこでヨハネは、洗礼を授けてもらおうとして出て来た群衆に言った。「蝮の子らよ、差し迫った神の怒りを免れると、だれが教えたのか。","tok":[["そこ"],["で"],["ヨハネ"],["は"],["、"],["洗礼","せんれい"],["を"],["授けて","さずけて"],["もらおう"],["として"],["出て","でて"],["来た","きた"],["群衆","ぐんしゅう"],["に"],["言った","いった"],["。"],["「"],["蝮","まむし"],["の"],["子","こ"],["ら"],["よ"],["、"],["差し迫った","さしせまった"],["神","かみ"],["の"],["怒り","いかり"],["を"],["免れる","まぬがれる"],["と"],["、"],["だれ"],["が"],["教えた","おしえた"],["の"],["か"],["。"]]},{"verse":8,"text":"悔い改めにふさわしい実を結べ。『我々の父はアブラハムだ』などという考えを起こすな。言っておくが、神はこんな石ころからでも、アブラハムの子たちを造り出すことがおできになる。","tok":[["悔い改め","くいあらため"],["に"],["ふさわしい"],["実","じつ"],["を"],["結べ","むすべ"],["。"],["『"],["我々","われわれ"],["の"],["父","ちち"],["は"],["アブラハム"],["だ"],["』"],["など"],["と"],["いう"],["考え","かんがえ"],["を"],["起こす","おこす"],["な"],["。"],["言って","いって"],["おく"],["が"],["、"],["神","かみ"],["は"],["こんな"],["石ころ","いしころ"],["から"],["で"],["も"],["、"],["アブラハム"],["の"],["子","こ"],["たち"],["を"],["造り出す","つくりだす"],["こと"],["が"],["おでき"],["に"],["なる"],["。"]]},{"verse":9,"text":"斧は既に木の根元に置かれている。良い実を結ばない木はみな、切り倒されて火に投げ込まれる。」","tok":[["斧","おの"],["は"],["既に","すでに"],["木","き"],["の"],["根元","ねもと"],["に"],["置かれて","おかれて"],["いる"],["。"],["良い","よい"],["実","じつ"],["を"],["結ばない","むすばない"],["木","き"],["は"],["みな"],["、"],["切り倒されて","きりたおされて"],["火","ひ"],["に"],["投げ込まれる","なげこまれる"],["。"],["」"]]},{"verse":10,"text":"そこで群衆は、「では、わたしたちはどうすればよいのですか」と尋ねた。","tok":[["そこ"],["で"],["群衆","ぐんしゅう"],["は"],["、"],["「"],["で"],["は"],["、"],["わたしたち"],["は"],["どう"],["すれば"],["よい"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":11,"text":"ヨハネは、「下着を二枚持っている者は、一枚も持たない者に分けてやれ。食べ物を持っている者も同じようにせよ」と答えた。","tok":[["ヨハネ"],["は"],["、"],["「"],["下着","したぎ"],["を"],["二枚","にまい"],["持って","もって"],["いる"],["者","もの"],["は"],["、"],["一枚","いちまい"],["も"],["持たない","もたない"],["者","もの"],["に"],["分けて","わけて"],["やれ"],["。"],["食べ物","たべもの"],["を"],["持って","もって"],["いる"],["者","もの"],["も"],["同じ","おなじ"],["よう"],["に"],["せよ"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":12,"text":"徴税人も洗礼を受けるために来て、「先生、わたしたちはどうすればよいのですか」と言った。","tok":[["徴税人","ちょうぜいにん"],["も"],["洗礼","せんれい"],["を"],["受ける","うける"],["ため"],["に"],["来て","きて"],["、"],["「"],["先生","せんせい"],["、"],["わたしたち"],["は"],["どう"],["すれば"],["よい"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":13,"text":"ヨハネは、「規定以上のものは取り立てるな」と言った。","tok":[["ヨハネ"],["は"],["、"],["「"],["規定","きてい"],["以上","いじょう"],["の"],["もの"],["は"],["取り立てる","とりたてる"],["な"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"兵士も、「このわたしたちはどうすればよいのですか」と尋ねた。ヨハネは、「だれからも金をゆすり取ったり、だまし取ったりするな。自分の給料で満足せよ」と言った。","tok":[["兵士","へいし"],["も"],["、"],["「"],["この"],["わたしたち"],["は"],["どう"],["すれば"],["よい"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["ヨハネ"],["は"],["、"],["「"],["だれ"],["から"],["も"],["金","きん"],["を"],["ゆすり取っ","ゆすりとっ"],["たり"],["、"],["だまし取っ","だましとっ"],["たり"],["する"],["な"],["。"],["自分","じぶん"],["の"],["給料","きゅうりょう"],["で"],["満足","まんぞく"],["せよ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"民衆はメシアを待ち望んでいて、ヨハネについて、もしかしたら彼がメシアではないかと、皆心の中で考えていた。","tok":[["民衆","みんしゅう"],["は"],["メシア"],["を"],["待ち望んで","まちのぞんで"],["いて"],["、"],["ヨハネ"],["について"],["、"],["もし"],["か"],["したら"],["彼","かれ"],["が"],["メシア"],["で"],["は"],["ない"],["か"],["と"],["、"],["皆","みな"],["心","こころ"],["の"],["中","なか"],["で"],["考えて","かんがえて"],["いた"],["。"]]},{"verse":16,"text":"そこで、ヨハネは皆に向かって言った。「わたしはあなたたちに水で洗礼を授けるが、わたしよりも優れた方が来られる。わたしは、その方の履物のひもを解く値打ちもない。その方は、聖霊と火であなたたちに洗礼をお授けになる。","tok":[["そこ"],["で"],["、"],["ヨハネ"],["は"],["皆","みな"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["わたし"],["は"],["あなた"],["たち"],["に"],["水","みず"],["で"],["洗礼","せんれい"],["を"],["授ける","さずける"],["が"],["、"],["わたし"],["より"],["も"],["優れた","すぐれた"],["方","ほう"],["が"],["来られる","こられる"],["。"],["わたし"],["は"],["、"],["その"],["方","かた"],["の"],["履物","はきもの"],["の"],["ひも"],["を"],["解く","とく"],["値打ち","ねうち"],["も"],["ない"],["。"],["その"],["方","かた"],["は"],["、"],["聖霊","せいれい"],["と"],["火","ひ"],["で"],["あなた"],["たち"],["に"],["洗礼","せんれい"],["を"],["お授け","おさずけ"],["に"],["なる"],["。"]]},{"verse":17,"text":"そして、手に箕を持って、脱穀場を隅々まできれいにし、麦を集めて倉に入れ、殻を消えることのない火で焼き払われる。」","tok":[["そして"],["、"],["手","て"],["に"],["箕","み"],["を"],["持って","もって"],["、"],["脱穀場","だっこくじょう"],["を"],["隅々","すみずみ"],["まで"],["きれい"],["に"],["し"],["、"],["麦","むぎ"],["を"],["集めて","あつめて"],["倉","くら"
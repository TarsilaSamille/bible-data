,["その"],["こと"],["が"],["起こる","おこる"],["とき"],["に"],["は"],["、"],["どんな"],["徴","しるし"],["が"],["ある"],["の"],["です"],["か"],["。"],["」"]]},{"verse":8,"text":"イエスは言われた。「惑わされないように気をつけなさい。わたしの名を名乗る者が大勢現れ、『わたしがそれだ』とか、『時が近づいた』とか言うが、ついて行ってはならない。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["惑わされない","まどわされない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["わたし"],["の"],["名","な"],["を"],["名乗る","なのる"],["者","もの"],["が"],["大勢","おおぜい"],["現れ","あらわれ"],["、"],["『"],["わたし"],["が"],["それ"],["だ"],["』"],["と"],["か"],["、"],["『"],["時","じ"],["が"],["近づいた","ちかづいた"],["』"],["と"],["か"],["言う","ゆう"],["が"],["、"],["ついて"],["行って","いって"],["は"],["ならない"],["。"]]},{"verse":9,"text":"戦争とか暴動のことを聞いても、おびえてはならない。こういうことがまず起こるに決まっているが、世の終わりはすぐには来ないからである。」","tok":[["戦争","せんそう"],["と"],["か"],["暴動","ぼうどう"],["の"],["こと"],["を"],["聞いて","きいて"],["も"],["、"],["おびえて"],["は"],["ならない"],["。"],["こう"],["いう"],["こと"],["が"],["まず"],["起こる","おこる"],["に"],["決まって","きまって"],["いる"],["が"],["、"],["世","よ"],["の"],["終わり","おわり"],["は"],["すぐ"],["に"],["は"],["来ない","こない"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":10,"text":"そして更に、言われた。「民は民に、国は国に敵対して立ち上がる。","tok":[["そして"],["更に","さらに"],["、"],["言われた","いわれた"],["。"],["「"],["民","みん"],["は"],["民","みん"],["に"],["、"],["国","くに"],["は"],["国","くに"],["に"],["敵対","てきたい"],["して"],["立ち上がる","たちあがる"],["。"]]},{"verse":11,"text":"そして、大きな地震があり、方々に飢饉や疫病が起こり、恐ろしい現象や著しい徴が天に現れる。","tok":[["そして"],["、"],["大きな","おおきな"],["地震","じしん"],["が"],["あり"],["、"],["方々","かたがた"],["に"],["飢饉","ききん"],["や"],["疫病","やくびょう"],["が"],["起こり","おこり"],["、"],["恐ろしい","おそろしい"],["現象","げんしょう"],["や"],["著しい","いちじるしい"],["徴","しるし"],["が"],["天","てん"],["に"],["現れる","あらわれる"],["。"]]},{"verse":12,"text":"しかし、これらのことがすべて起こる前に、人々はあなたがたに手を下して迫害し、会堂や牢に引き渡し、わたしの名のために王や総督の前に引っ張って行く。","tok":[["しかし"],["、"],["これ"],["ら"],["の"],["こと"],["が"],["すべて"],["起こる","おこる"],["前","まえ"],["に"],["、"],["人々","ひとびと"],["は"],["あなた"],["がた"],["に"],["手","て"],["を"],["下して","くだして"],["迫害","はくがい"],["し"],["、"],["会堂","かいどう"],["や"],["牢","ろう"],["に"],["引き渡し","ひきわたし"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["王","おう"],["や"]
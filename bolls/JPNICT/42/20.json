[{"verse":1,"text":"ある日、イエスが神殿の境内で民衆に教え、福音を告げ知らせておられると、祭司長や律法学者たちが、長老たちと一緒に近づいて来て、","tok":[["ある"],["日","ひ"],["、"],["イエス"],["が"],["神殿","しんでん"],["の"],["境内","けいだい"],["で"],["民衆","みんしゅう"],["に"],["教え","おしえ"],["、"],["福音","ふくいん"],["を"],["告げ知らせて","つげしらせて"],["おられる"],["と"],["、"],["祭司長","さいしちょう"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["が"],["、"],["長老","ちょうろう"],["たち"],["と"],["一緒","いっしょ"],["に"],["近づいて","ちかづいて"],["来て","きて"],["、"]]},{"verse":2,"text":"言った。「我々に言いなさい。何の権威でこのようなことをしているのか。その権威を与えたのはだれか。」","tok":[["言った","いった"],["。"],["「"],["我々","われわれ"],["に"],["言い","いい"],["なさい"],["。"],["何","なん"],["の"],["権威","けんい"],["で"],["この"],["よう"],["な"],["こと"],["を"],["して"],["いる"],["の"],["か"],["。"],["その"],["権威","けんい"],["を"],["与えた","あたえた"],["の"],["は"],["だれ"],["か"],["。"],["」"]]},{"verse":3,"text":"イエスはお答えになった。「では、わたしも一つ尋ねるから、それに答えなさい。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["で"],["は"],["、"],["わたし"],["も"],["一","ひと"],["つ"],["尋ねる","たずねる"],["から"],["、"],["それ"],["に"],["答え","こたえ"],["なさい"],["。"]]},{"verse":4,"text":"ヨハネの洗礼は、天からのものだったか、それとも、人からのものだったか。」","tok":[["ヨハネ"],["の"],["洗礼","せんれい"],["は"],["、"],["天","てん"],["から"],["の"],["もの"],["だった"],["か"],["、"],["それ"],["と"],["も"],["、"],["人","ひと"],["から"],["の"],["もの"],["だった"],["か"],["。"],["」"]]},{"verse":5,"text":"彼らは相談した。「『天からのものだ』と言えば、『では、なぜヨハネを信じなかったのか』と言うだろう。","tok":[["彼","かれ"],["ら"],["は"],["相談","そうだん"],["した"],["。"],["「"],["『"],["天","てん"],["から"],["の"],["もの"],["だ"],["』"],["と"],["言えば","いえば"],["、"],["『"],["で"],["は"],["、"],["なぜ"],["ヨハネ"],["を"],["信じなかった","しんじなかった"],["の"],["か"],["』"],["と"],["言うだろう","ゆうだろう"],["。"]]},{"verse":6,"text":"『人からのものだ』と言えば、民衆はこぞって我々を石で殺すだろう。ヨハネを預言者だと信じ込んでいるのだから。」","tok":[["『"],["人","ひと"],["から"],["の"],["もの"],["だ"],["』"],["と"],["言えば","いえば"],["、"],["民衆","みんしゅう"],["は"],["こぞって"],["我々","われわれ"],["を"],["石","いし"],["で"],["殺すだろう","ころすだろう"],["。"],["ヨハネ"],["を"],["預言者","よげんしゃ"],["だ"],["と"],["信じ込んで","しんじこんで"],["いる"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":7,"text":"そこで彼らは、「どこからか、分からない」と答えた。","tok":[["そこ"],["で"],["彼","かれ"],["ら"],["は"],["、"],["「"],["どこ"],["から"],["か"],["、"],["分からない","わからない"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":8,"text":"すると、イエスは言われた。「それなら、何の権威でこのようなことをするのか、わたしも言うまい。」","tok":[["する"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["それ"],["なら"],["、"],["何","なん"],["の"],["権威","けんい"],["で"],["この"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["、"],["わたし"],["も"],["言うまい","ゆうまい"],["。"],["」"]]},{"verse":9,"text":"イエスは民衆にこのたとえを話し始められた。「ある人がぶどう園を作り、これを農夫たちに貸して長い旅に出た。","tok":[["イエス"],["は"],["民衆","みんしゅう"],["に"],["この"],["たとえ"],["を"],["話し","はなし"],["始められた","はじめられた"],["。"],["「"],["ある"],["人","ひと"],["が"],["ぶどう園","ぶどうえん"],["を"],["作り","つくり"],["、"],["これ"],["を"],["農夫","のうふ"],["たち"],["に"],["貸して","かして"],["長い","ながい"],["旅","たび"],["に"],["出た","でた"],["。"]]},{"verse":10,"text":"収穫の時になったので、ぶどう園の収穫を納めさせるために、僕を農夫たちのところへ送った。ところが、農夫たちはこの僕を袋だたきにして、何も持たせないで追い返した。","tok":[["収穫","しゅうかく"],["の"],["時","とき"],["に"],["なった"],["ので"],["、"],["ぶどう園","ぶどうえん"],["の"],["収穫","しゅうかく"],["を"],["納めさせる","おさめさせる"],["ため"],["に"],["、"],["僕","ぼく"],["を"],["農夫","のうふ"],["たち"],["の"],["ところ"],["へ"],["送った","おくった"],["。"],["ところ"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["この"],["僕","ぼく"],["を"],["袋だたき","ふくろだたき"],["に"],["して"],["、"],["何","なん"],["も"],["持たせないで","もたせないで"],["追い返した","おいかえした"],["。"]]},{"verse":11,"text":"そこでまた、ほかの僕を送ったが、農夫たちはこの僕をも袋だたきにし、侮辱して何も持たせないで追い返した。","tok":[["そこ"],["で"],["また"],["、"],["ほか"],["の"],["僕","ぼく"],["を"],["送った","おくった"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["この"],["僕","ぼく"],["を"],["も"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["侮辱","ぶじょく"],["して"],["何","なん"],["も"],["持たせないで","もたせないで"],["追い返した","おいかえした"],["。"]]},{"verse":12,"text":"更に三人目の僕を送ったが、これにも傷を負わせてほうり出した。","tok":[["更に","さらに"],["三人目","さんにんめ"],["の"],["僕","ぼく"],["を"],["送った","おくった"],["が"],["、"],["これ"],["に"],["も"],["傷","きず"],["を"],["負わせて","おわせて"],["ほうり出した","ほうりだした"],["。"]]},{"verse":13,"text":"そこで、ぶどう園の主人は言った。『どうしようか。わたしの愛する息子を送ってみよう。この子ならたぶん敬ってくれるだろう。』","tok":[["そこ"],["で"],["、"],["ぶどう園","ぶどうえん"],["の"],["主人","しゅじん"],["は"],["言った","いった"],["。"],["『"],["どう"],["しよう"],["か"],["。"],["わたし"],["の"],["愛する
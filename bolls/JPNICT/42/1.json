[{"verse":1,"text":"わたしたちの間で実現した事柄について、最初から目撃して御言葉のために働いた人々がわたしたちに伝えたとおりに、物語を書き連ねようと、多くの人々が既に手を着けています。","tok":[["わたしたち"],["の"],["間","あいだ"],["で"],["実現","じつげん"],["した"],["事柄","ことがら"],["について"],["、"],["最初","さいしょ"],["から"],["目撃","もくげき"],["して"],["御言葉","おことば"],["の"],["ため"],["に"],["働いた","はたらいた"],["人々","ひとびと"],["が"],["わたしたち"],["に"],["伝えた","つたえた"],["とおり"],["に"],["、"],["物語","ものがたり"],["を"],["書き連ねよう","かきつらねよう"],["と"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["既に","すでに"],["手","て"],["を"],["着けて","つけて"],["います"],["。"]]},{"verse":3,"text":"そこで、敬愛するテオフィロさま、わたしもすべての事を初めから詳しく調べていますので、順序正しく書いてあなたに献呈するのがよいと思いました。","tok":[["そこ"],["で"],["、"],["敬愛","けいあい"],["する"],["テオフィロ"],["さま"],["、"],["わたし"],["も"],["すべて"],["の"],["事","こと"],["を"],["初め","はじめ"],["から"],["詳しく","くわしく"],["調べて","しらべて"],["います"],["ので"],["、"],["順序","じゅんじょ"],["正しく","ただしく"],["書いて","かいて"],["あなた"],["に"],["献呈","けんてい"],["する"],["の"],["が"],["よい"],["と"],["思いました","おもいました"],["。"]]},{"verse":4,"text":"お受けになった教えが確実なものであることを、よく分かっていただきたいのであります。","tok":[["お受け","おうけ"],["に"],["なった"],["教え","おしえ"],["が"],["確実","かくじつ"],["な"],["もの"],["で"],["ある"],["こと"],["を"],["、"],["よく"],["分かって","わかって"],["いただきたい"],["ので"],["あります"],["。"]]},{"verse":5,"text":"ユダヤの王ヘロデの時代、アビヤ組の祭司にザカリアという人がいた。その妻はアロン家の娘の一人で、名をエリサベトといった。","tok":[["ユダヤ"],["の"],["王","おう"],["ヘロデ"],["の"],["時代","じだい"],["、"],["アビヤ"],["組","くみ"],["の"],["祭司","さいし"],["に"],["ザカリア"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["その"],["妻","つま"],["は"],["アロン家","あろんか"],["の"],["娘","むすめ"],["の"],["一人","ひとり"],["で"],["、"],["名","な"],["を"],["エリサベト"],["と"],["いった"],["。"]]},{"verse":6,"text":"二人とも神の前に正しい人で、主の掟と定めをすべて守り、非のうちどころがなかった。","tok":[["二人","ふたり"],["とも"],["神","かみ"],["の"],["前","まえ"],["に"],["正しい","ただしい"],["人","ひと"],["で"],["、"],["主","ぬし"],["の"],["掟","おきて"],["と"],["定め","さだめ"],["を"],["すべて"],["守り","まもり"],["、"],["非","ひ"],["の"],["うち"],["どころ"],["が"],["なかった"],["。"]]},{"verse":7,"text":"しかし、エリサベトは不妊の女だったので、彼らには、子供がなく、二人とも既に年をとっていた。","tok":[["しかし"],["、"],["エリサベト"],["は"],["不妊","ふにん"],["の"],["女","おんな"],["だった"],["ので"],["、"],["彼","かれ"],["ら"],["に"],["は"],["、"],["子供","こども"],["が"],["なく"],["、"],["二人","ふたり"],["とも"],["既に","すでに"],["年","とし"],["を"],["とって"],["いた"],["。"]]},{"verse":8,"text":"さて、ザカリアは自分の組が当番で、神の御前で祭司の務めをしていたとき、","tok":[["さて"],["、"],["ザカリア"],["は"],["自分","じぶん"],["の"],["組","くみ"],["が"],["当番","とうばん"],["で"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["して"],["いた"],["とき"],["、"]]},{"verse":9,"text":"祭司職のしきたりによってくじを引いたところ、主の聖所に入って香をたくことになった。","tok":[["祭司","さいし"],["職","しょく"],["の"],["しきたり"],["によって"],["くじ"],["を"],["引いた","ひいた"],["ところ"],["、"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["に"],["入って","はいって"],["香","こう"],["を"],["たく"],["こと"],["に"],["なった"],["。"]]},{"verse":10,"text":"香をたいている間、大勢の民衆が皆外で祈っていた。","tok":[["香","こう"],["を"],["たいて"],["いる"],["間","あいだ"],["、"],["大勢","おおぜい"],["の"],["民衆","みんしゅう"],["が"],["皆","みな"],["外","そと"],["で"],["祈って","いのって"],["いた"],["。"]]},{"verse":11,"text":"すると、主の天使が現れ、香壇の右に立った。","tok":[["する"],["と"],["、"],["主","ぬし"],["の"],["天使","てんし"],["が"],["現れ","あらわれ"],["、"],["香","こう"],["壇","だん"],["の"],["右","みぎ"],["に"],["立った","たった"],["。"]]},{"verse":12,"text":"ザカリアはそれを見て不安になり、恐怖の念に襲われた。","tok":[["ザカリア"],["は"],["それ"],["を"],["見て","みて"],["不安","ふあん"],["に"],["なり"],["、"],["恐怖","きょうふ"],["の"],["念","ねん"],["に"],["襲われた","おそわれた"],["。"]]},{"verse":13,"text":"天使は言った。「恐れることはない。ザカリア、あなたの願いは聞き入れられた。あなたの妻エリサベトは男の子を産む。その子をヨハネと名付けなさい。","tok":[["天使","てんし"],["は"],["言った","いった"],["。"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["ザカリア"],["、"],["あなた"],["の"],["願い","ねがい"],["は"],["聞き入れられた","ききいれられた"],["。"],["あなた"],["の"],["妻","つま"],["エリサベト"],["は"],["男の子","おとこのこ"],["を"],["産む","うむ"],["。"],["その"],["子","こ"],["を"],["ヨハネ"],["と"],["名付け","なづけ"],["なさい"],["。"]]},{"verse":14,"text":"その子はあなたにとって喜びとなり、楽しみとなる。多くの人もその誕生を喜ぶ。","tok":[["その"],["子","こ"],["は"],["あなた"],["にとって"],["喜び","よろこび"],["と"],["なり"],["、"],["楽しみ","たのしみ"],["と"],["なる"],["。"],["多く","おおく"],["の"],["人","ひと"],["も"],["その"],["誕生","たんじょう"],["を"],["喜ぶ","よろこぶ"],["。"]]},{"verse":15,"text":"彼は主の御前に偉大な人になり、ぶどう酒や強い酒を飲まず、既に母の胎にいるときから聖霊に満たされていて、","tok":[["彼","かれ"],["は"],["主","
[{"verse":1,"text":"ちょうどそのとき、何人かの人が来て、ピラトがガリラヤ人の血を彼らのいけにえに混ぜたことをイエスに告げた。","tok":[["ちょうど"],["その"],["とき"],["、"],["何人","なんにん"],["か"],["の"],["人","ひと"],["が"],["来て","きて"],["、"],["ピラト"],["が"],["ガリラヤ"],["人","にん"],["の"],["血","ち"],["を"],["彼","かれ"],["ら"],["の"],["いけにえ"],["に"],["混ぜた","まぜた"],["こと"],["を"],["イエス"],["に"],["告げた","つげた"],["。"]]},{"verse":2,"text":"イエスはお答えになった。「そのガリラヤ人たちがそのような災難に遭ったのは、ほかのどのガリラヤ人よりも罪深い者だったからだと思うのか。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["その"],["ガリラヤ"],["人","にん"],["たち"],["が"],["その"],["よう"],["な"],["災難","さいなん"],["に"],["遭った","あった"],["の"],["は"],["、"],["ほか"],["の"],["どの"],["ガリラヤ"],["人","にん"],["より"],["も"],["罪深い","つみぶかい"],["者","もの"],["だった"],["から"],["だ"],["と"],["思う","おもう"],["の"],["か"],["。"]]},{"verse":3,"text":"決してそうではない。言っておくが、あなたがたも悔い改めなければ、皆同じように滅びる。","tok":[["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"],["言って","いって"],["おく"],["が"],["、"],["あなた"],["がた"],["も"],["悔い改めなければ","くいあらためなければ"],["、"],["皆","みな"],["同じ","おなじ"],["よう"],["に"],["滅びる","ほろびる"],["。"]]},{"verse":4,"text":"また、シロアムの塔が倒れて死んだあの十八人は、エルサレムに住んでいたほかのどの人々よりも、罪深い者だったと思うのか。","tok":[["また"],["、"],["シロアム"],["の"],["塔","とう"],["が"],["倒れて","たおれて"],["死んだ","しんだ"],["あの"],["十八人","じゅうはちにん"],["は"],["、"],["エルサレム"],["に"],["住んで","すんで"],["いた"],["ほか"],["の"],["どの"],["人々","ひとびと"],["より"],["も"],["、"],["罪深い","つみぶかい"],["者","もの"],["だった"],["と"],["思う","おもう"],["の"],["か"],["。"]]},{"verse":5,"text":"決してそうではない。言っておくが、あなたがたも悔い改めなければ、皆同じように滅びる。」","tok":[["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"],["言って","いって"],["おく"],["が"],["、"],["あなた"],["がた"],["も"],["悔い改めなければ","くいあらためなければ"],["、"],["皆","みな"],["同じ","おなじ"],["よう"],["に"],["滅びる","ほろびる"],["。"],["」"]]},{"verse":6,"text":"そして、イエスは次のたとえを話された。「ある人がぶどう園にいちじくの木を植えておき、実を探しに来たが見つからなかった。","tok":[["そして"],["、"],["イエス"],["は"],["次","つぎ"],["の"],["たとえ"],["を"],["話された","はなされた"],["。"],["「"],["ある"],["人","ひと"],["が"],["ぶどう園","ぶどうえん"],["に"],["いちじく"],["の"],["木","き"],["を"],["植えて","うえて"],["おき"],["、"],["実","じつ"],["を"],["探し","さがし"],["に"],["来た","きた"],["が"],["見つからなかった","みつからなかった"],["。"]]},{"verse":7,"text":"そこで、園丁に言った。『もう三年もの間、このいちじくの木に実を探しに来ているのに、見つけたためしがない。だから切り倒せ。なぜ、土地をふさがせておくのか。』","tok":[["そこ"],["で"],["、"],["園丁","えんてい"],["に"],["言った","いった"],["。"],["『"],["もう"],["三","さん"],["年","ねん"],["も"],["の"],["間","あいだ"],["、"],["この"],["いちじく"],["の"],["木","き"],["に"],["実","じつ"],["を"],["探し","さがし"],["に"],["来て","きて"],["いる"],["のに"],["、"],["見つけた","みつけた"],["ためし"],["が"],["ない"],["。"],["だ"],["から"],["切り倒せ","きりたおせ"],["。"],["なぜ"],["、"],["土地","とち"],["を"],["ふさがせて"],["おく"],["の"],["か"],["。"],["』"]]},{"verse":8,"text":"園丁は答えた。『御主人様、今年もこのままにしておいてください。木の周りを掘って、肥やしをやってみます。","tok":[["園丁","えんてい"],["は"],["答えた","こたえた"],["。"],["『"],["御主人様","みうしさま"],["、"],["今年","ことし"],["も"],["この"],["まま"],["に"],["して"],["おいて"],["ください"],["。"],["木","き"],["の"],["周り","まわり"],["を"],["掘って","ほって"],["、"],["肥やし","こやし"],["を"],["やって"],["みます"],["。"]]},{"verse":9,"text":"そうすれば、来年は実がなるかもしれません。もしそれでもだめなら、切り倒してください。』」","tok":[["そう"],["すれば"],["、"],["来年","らいねん"],["は"],["実","じつ"],["が"],["なる"],["か"],["も"],["しれません"],["。"],["もし"],["それ"],["で"],["も"],["だめ"],["なら"],["、"],["切り倒して","きりたおして"],["ください"],["。"],["』"],["」"]]},{"verse":10,"text":"安息日に、イエスはある会堂で教えておられた。","tok":[["安息日","あんそくび"],["に"],["、"],["イエス"],["は"],["ある"],["会堂","かいどう"],["で"],["教えて","おしえて"],["おられた"],["。"]]},{"verse":11,"text":"そこに、十八年間も病の霊に取りつかれている女がいた。腰が曲がったまま、どうしても伸ばすことができなかった。","tok":[["そこ"],["に"],["、"],["十八","じゅうはち"],["年間","ねんかん"],["も"],["病","やまい"],["の"],["霊","れい"],["に"],["取りつかれて","とりつかれて"],["いる"],["女","おんな"],["が"],["いた"],["。"],["腰","こし"],["が"],["曲がった","まがった"],["まま"],["、"],["どう"],["して"],["も"],["伸ばす","のばす"],["こと"],["が"],["できなかった"],["。"]]},{"verse":12,"text":"イエスはその女を見て呼び寄せ、「婦人よ、病気は治った」と言って、","tok":[["イエス"],["は"],["その"],["女","おんな"],["を"],["見て","みて"],["呼び寄せ","よびよせ"],["、"],["「"],["婦人","ふじん"],["よ"],["、"],["病気","びょうき"],["は"],["治った","なおった"],["」"],["と"],["言って","いって"],["、"]]},{"verse":13,"text":"その上に手を置かれた。女は、たちどころに腰がまっすぐになり、神を賛美した。","tok":[["その"],["上","うえ"],["に"],["手","て"],["を"],["置かれた","おかれた"],["。"],["女","おんな"],["は"],["、"],["たちどころ"],["に"],["腰","こし"],["が"],["まっすぐ"],["に"],["なり"],["、"],["神","かみ"],["を"],["賛美","さんび"],["した"],["。"]]},{"verse":14,"text":"ところが会堂長は、イエスが安息日に病人をいやされたことに腹を立て、群衆に言った。「働くべき日は六日ある。その間に来て治してもらうがよい。安息日はいけない。」","tok":[["ところ"],["が"],["会堂長","かいどうちょう"],["は"],["、"],["イエス"],["が"],["安息日","あんそくび"],["に"],["病人","びょうにん"],["を"],["いやされた"],["こと"],["に"],["腹","はら"],["を"],["立て","たて"],["、"],["群衆","ぐんしゅう"],["に"],["言った","いった"],["。"],["「"],["働くべき","はたらくべき"],["日","ひ"],["は"],["六日","むいか"],["ある"],["。"],["その"],["間","あいだ"],["に"],["来て","きて"],["治して","なおして"],["もらう"],["が"],["よい"],["。"],["安息日","あんそくび"],["は"],["いけない"],["。"],["」"]]},{"verse":15,"text":"しかし、主は彼に答えて言われた。「偽善者たちよ、あなたたちはだれでも、安息日にも牛やろばを飼い葉桶から解いて、水を飲ませに引いて行くではないか。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["彼","かれ"],["に"],["答えて","こたえて"],["言われた","いわれた"],["。"],["「"],["偽善者","ぎぜんしゃ"],["たち"],["よ"],["、"],["あなた"],["たち"],["は"],["だれ"],["で"],["も"],["、"],["安息日","あんそくび"],["に"],["も"],["牛","うし"],["や"],["ろば"],["を"],["飼い葉","かいば"],["桶","おけ"],["から"],["解いて","といて"],["、"],["水","みず"],["を"],["飲ませ","のませ"],["に"],["引いて","ひいて"],["行くで","いくで"],["は"],["ない"],["か"],["。"]]},{"verse":16,"text":"この女はアブラハムの娘なのに、十八年もの間サタンに縛られていたのだ。安息日であっても、その束縛から解いてやるべきではなかったのか。」","tok":[["この"],["女","おんな"],["は"],["アブラハム"],["の"],["娘","むすめ"],["な"],["のに"],["、"],["十八","じゅうはち"],["年","ねん"],["も"],["の"],["間","あいだ"],["サタン"],["に"],["縛られて","しばられて"],["いた"],["の"],["だ"],["。"],["安息日","あんそくび"],["で"],["あって"],["も"],["、"],["その"],["束縛","そくばく"],["から"],["解いて","といて"],["やるべきで"],["は"],["なかった"],["の"],["か"],["。"],["」"]]},{"verse":17,"text":"こう言われると、反対者は皆恥じ入ったが、群衆はこぞって、イエスがなさった数々のすばらしい行いを見て喜んだ。","tok":[["こう"],["言われる","いわれる"],["と"],["、"],["反対者","はんたいしゃ"],["は"],["皆","みな"],["恥じ入った","はじいった"],["が"],["、"],["群衆","ぐんしゅう"],["は"],["こぞって"],["、"],["イエス"],["が"],["なさった"],["数々","かずかず"],["の"],["すばらしい"],["行い","おこない"],["を"],["見て","みて"],["喜んだ","よろこんだ"],["。"]]},{"verse":18,"text":"そこで、イエスは言われた。「神の国は何に似ているか。何にたとえようか。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["神","かみ"],["の"],["国","くに"],["は"],["何","なん"],["に"],["似て","にて"],["いる"],["か"],["。"],["何","なん"],["に"],["たとえよう"],["か"],["。"]]},{"verse":19,"text":"それは、からし種に似ている。人がこれを取って庭に蒔くと、成長して木になり、その枝には空の鳥が巣を作る。」","tok":[["それ"],["は"],["、"],["からし"],["種","しゅ"],["に"],["似て","にて"],["いる"],["。"],["人","ひと"],["が"],["これ"],["を"],["取って","とって"],["庭","にわ"],["に"],["蒔く","まく"],["と"],["、"],["成長","せいちょう"],["して"],["木","き"],["に"],["なり"],["、"],["その"],["枝","えだ"],["に"],["は"],["空","そら"],["の"],["鳥","とり"],["が"],["巣","す"],["を"],["作る","つくる"],["。"],["」"]]},{"verse":20,"text":"また言われた。「神の国を何にたとえようか。","tok":[["また"],["言われた","いわれた"],["。"],["「"],["神","かみ"],["の"],["国","くに"],["を"],["何","なん"],["に"],["たとえよう"],["か"],["。"]]},{"verse":21,"text":"パン種に似ている。女がこれを取って三サトンの粉に混ぜると、やがて全体が膨れる。」","tok":[["パン種","ぱんだね"],["に"],["似て","にて"],["いる"],["。"],["女","おんな"],["が"],["これ"],["を"],["取って","とって"],["三","さん"],["サトン"],["の"],["粉","こな"],["に"],["混ぜる","まぜる"],["と"],["、"],["やがて"],["全体","ぜんたい"],["が"],["膨れる","ふくれる"],["。"],["」"]]},{"verse":22,"text":"イエスは町や村を巡って教えながら、エルサレムへ向かって進んでおられた。","tok":[["イエス"],["は"],["町","まち"],["や"],["村","むら"],["を"],["巡って","めぐって"],["教え","おしえ"],["ながら"],["、"],["エルサレム"],["へ"],["向かって","むかって"],["進んで","すすんで"],["おられた"],["。"]]},{"verse":23,"text":"すると、「主よ、救われる者は少ないのでしょうか」と言う人がいた。イエスは一同に言われた。","tok":[["する"],["と"],["、"],["「"],["主","ぬし"],["よ"],["、"],["救われる","すくわれる"],["者","もの"],["は"],["少ない","すくない"],["の"],["でしょう"],["か"],["」"],["と"],["言う","いう"],["人","ひと"],["が"],["いた"],["。"],["イエス"],["は"],["一同","いちどう"],["に"],["言われた","いわれた"],["。"]]},{"verse":24,"text":"「狭い戸口から入るように努めなさい。言っておくが、入ろうとしても入れない人が多いのだ。","tok":[["「"],["狭い","せまい"],["戸口","とぐち"],["から"],["入る","はいる"],["よう"],["に"],["努め","つとめ"],["なさい"],["。"],["言って","いって"],["おく"],["が"],["、"],["入ろう","はいろう"],["として"],["も"],["入れない","いれない"],["人","ひと"],["が"],["多い","おおい"],["の"],["だ"],["。"]]},{"verse":25,"text":"家の主人が立ち上がって、戸を閉めてしまってからでは、あなたがたが外に立って戸をたたき、『御主人様、開けてください』と言っても、『お前たちがどこの者か知らない』という答えが返ってくるだけである。","tok":[["家","いえ"],["の"],["主人","しゅじん"],["が"],["立ち上がって","たちあがって"],["、"],["戸","と"],["を"],["閉めて","しめて"],["しまって"],["から"],["で"],["は"],["、"],["あなた"],["がた"],["が"],["外","そと"],["に"],["立って","たって"],["戸","と"],["を"],["たたき"],["、"],["『"],["御主人様","みうしさま"],["、"],["開けて","あけて"],["ください"],["』"],["と"],["言って","いって"],["も"],["、"],["『"],["お前","おまえ"],["たち"],["が"],["どこ"],["の"],["者","もの"],["か"],["知らない","しらない"],["』"],["と"],["いう"],["答え","こたえ"],["が"],["返って","かえって"],["くる"],["だけ"],["で"],["ある"],["。"]]},{"verse":26,"text":"そのとき、あなたがたは、『御一緒に食べたり飲んだりしましたし、また、わたしたちの広場でお教えを受けたのです』と言いだすだろう。","tok":[["その"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["『"],["御一緒","ごいっしょ"],["に"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["しました"],["し"],["、"],["また"],["、"],["わたしたち"],["の"],["広場","ひろば"],["で"],["お教え","おおしえ"],["を"],["受けた","うけた"],["の"],["です"],["』"],["と"],["言い","いい"],["だすだろう"],["。"]]},{"verse":27,"text":"しかし主人は、『お前たちがどこの者か知らない。不義を行う者ども、皆わたしから立ち去れ』と言うだろう。","tok":[["しかし"],["主人","しゅじん"],["は"],["、"],["『"],["お前","おまえ"],["たち"],["が"],["どこ"],["の"],["者","もの"],["か"],["知らない","しらない"],["。"],["不義","ふぎ"],["を"],["行う","おこなう"],["者","もの"],["ども"],["、"],["皆","みな"],["わたし"],["から"],["立ち去れ","たちされ"],["』"],["と"],["言うだろう","ゆうだろう"],["。"]]},{"verse":28,"text":"あなたがたは、アブラハム、イサク、ヤコブやすべての預言者たちが神の国に入っているのに、自分は外に投げ出されることになり、そこで泣きわめいて歯ぎしりする。","tok":[["あなた"],["がた"],["は"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["や"],["すべて"],["の"],["預言者","よげんしゃ"],["たち"],["が"],["神","かみ"],["の"],["国","くに"],["に"],["入って","はいって"],["いる"],["のに"],["、"],["自分","じぶん"],["は"],["外","そと"],["に"],["投げ出される","なげだされる"],["こと"],["に"],["なり"],["、"],["そこ"],["で"],["泣きわめいて","なきわめいて"],["歯ぎしり","はぎしり"],["する"],["。"]]},{"verse":29,"text":"そして人々は、東から西から、また南から北から来て、神の国で宴会の席に着く。","tok":[["そして"],["人々","ひとびと"],["は"],["、"],["東","ひがし"],["から"],["西","にし"],["から"],["、"],["また"],["南","みなみ"],["から"],["北","きた"],["から"],["来て","きて"],["、"],["神","かみ"],["の"],["国","くに"],["で"],["宴会","えんかい"],["の"],["席","せき"],["に"],["着く","つく"],["。"]]},{"verse":30,"text":"そこでは、後の人で先になる者があり、先の人で後になる者もある。」","tok":[["そこ"],["で"],["は"],["、"],["後","あと"],["の"],["人","ひと"],["で"],["先","さき"],["に"],["なる"],["者","もの"],["が"],["あり"],["、"],["先","さき"],["の"],["人","ひと"],["で"],["後","あと"],["に"],["なる"],["者","もの"],["も"],["ある"],["。"],["」"]]},{"verse":31,"text":"ちょうどそのとき、ファリサイ派の人々が何人か近寄って来て、イエスに言った。「ここを立ち去ってください。ヘロデがあなたを殺そうとしています。」","tok":[["ちょうど"],["その"],["とき"],["、"],["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["が"],["何人","なんにん"],["か"],["近寄って","ちかよって"],["来て","きて"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["ここ"],["を"],["立ち去って","たちさって"],["ください"],["。"],["ヘロデ"],["が"],["あなた"],["を"],["殺そう","ころそう"],["として"],["います"],["。"],["」"]]},{"verse":32,"text":"イエスは言われた。「行って、あの狐に、『今日も明日も、悪霊を追い出し、病気をいやし、三日目にすべてを終える』とわたしが言ったと伝えなさい。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["行って","いって"],["、"],["あの"],["狐","きつね"],["に"],["、"],["『"],["今日","きょう"],["も"],["明日","あす"],["も"],["、"],["悪霊","あくりょう"],["を"],["追い出し","おいだし"],["、"],["病気","びょうき"],["を"],["いやし"],["、"],["三日目","みっかめ"],["に"],["すべて"],["を"],["終える","おえる"],["』"],["と"],["わたし"],["が"],["言った","いった"],["と"],["伝え","つたえ"],["なさい"],["。"]]},{"verse":33,"text":"だが、わたしは今日も明日も、その次の日も自分の道を進まねばならない。預言者がエルサレム以外の所で死ぬことは、ありえないからだ。","tok":[["だ"],["が"],["、"],["わたし"],["は"],["今日","きょう"],["も"],["明日","あす"],["も"],["、"],["その"],["次","つぎ"],["の"],["日","ひ"],["も"],["自分","じぶん"],["の"],["道","みち"],["を"],["進まねば","すすまねば"],["ならない"],["。"],["預言者","よげんしゃ"],["が"],["エルサレム"],["以外","いがい"],["の"],["所","ところ"],["で"],["死ぬ","しぬ"],["こと"],["は"],["、"],["あり"],["えない"],["から"],["だ"],["。"]]},{"verse":34,"text":"エルサレム、エルサレム、預言者たちを殺し、自分に遣わされた人々を石で打ち殺す者よ、めん鳥が雛を羽の下に集めるように、わたしはお前の子らを何度集めようとしたことか。だが、お前たちは応じようとしなかった。","tok":[["エルサレム"],["、"],["エルサレム"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["殺し","ころし"],["、"],["自分","じぶん"],["に"],["遣わされた","つかわされた"],["人々","ひとびと"],["を"],["石","いし"],["で"],["打ち殺す","うちころす"],["者","もの"],["よ"],["、"],["めん鳥","めんちょう"],["が"],["雛","ひな"],["を"],["羽","はね"],["の"],["下","した"],["に"],["集める","あつめる"],["よう"],["に"],["、"],["わたし"],["は"],["お前","おまえ"],["の"],["子","こ"],["ら"],["を"],["何度","なんど"],["集めよう","あつめよう"],["と"],["した"],["こと"],["か"],["。"],["だ"],["が"],["、"],["お前","おまえ"],["たち"],["は"],["応じよう","おうじよう"],["と"],["しなかった"],["。"]]},{"verse":35,"text":"見よ、お前たちの家は見捨てられる。言っておくが、お前たちは、『主の名によって来られる方に、祝福があるように』と言う時が来るまで、決してわたしを見ることがない。」","tok":[["見よ","みよ"],["、"],["お前","おまえ"],["たち"],["の"],["家","いえ"],["は"],["見捨てられる","みすてられる"],["。"],["言って","いって"],["おく"],["が"],["、"],["お前","おまえ"],["たち"],["は"],["、"],["『"],["主","ぬし"],["の"],["名","な"],["によって"],["来られる","こられる"],["方","かた"],["に"],["、"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["』"],["と"],["言う","いう"],["時","とき"],["が"],["来る","くる"],["まで"],["、"],["決して","けっして"],["わたし"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"],["」"]]}]
[{"verse":1,"text":"ヨアシュは七歳で王となり、四十年間エルサレムで王位にあった。その母は名をツィブヤといい、ベエル‧シェバの出身であった。","tok":[["ヨアシュ"],["は"],["七歳","ななさい"],["で"],["王","おう"],["と"],["なり"],["、"],["四十","よんじゅう"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["ツィブヤ"],["と"],["いい"],["、"],["ベエル"],["‧"],["シェバ"],["の"],["出身","しゅっしん"],["で"],["あった"],["。"]]},{"verse":2,"text":"ヨアシュは祭司ヨヤダの生きている間は主の目にかなう正しいことを行った。","tok":[["ヨアシュ"],["は"],["祭司","さいし"],["ヨヤダ"],["の"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["かなう"],["正しい","ただしい"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":3,"text":"ヨヤダは二人の妻を彼にめとらせ、彼らの間に息子や娘が生まれた。","tok":[["ヨヤダ"],["は"],["二人","ふたり"],["の"],["妻","つま"],["を"],["彼","かれ"],["に"],["めとらせ"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["息子","むすこ"],["や"],["娘","むすめ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":4,"text":"その後、ヨアシュは主の神殿の修復に意欲を示し、","tok":[["その"],["後","ご"],["、"],["ヨアシュ"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["修復","しゅうふく"],["に"],["意欲","いよく"],["を"],["示し","しめし"],["、"]]},{"verse":5,"text":"祭司とレビ人を集めて言った。「ユダの町々に出かけて行って、あなたたちの神の神殿を毎年修理するため、すべてのイスラエル人から資金を集めよ。速やかに取りかかれ。」しかし、レビ人たちは速やかに取りかからなかった。","tok":[["祭司","さいし"],["と"],["レビ人","れびにん"],["を"],["集めて","あつめて"],["言った","いった"],["。"],["「"],["ユダ"],["の"],["町々","まちまち"],["に"],["出かけて","でかけて"],["行って","いって"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["の"],["神殿","しんでん"],["を"],["毎年","まいとし"],["修理","しゅうり"],["する"],["ため"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["から"],["資金","しきん"],["を"],["集めよ","あつめよ"],["。"],["速やか","すみやか"],["に"],["取り","とり"],["かかれ"],["。"],["」"],["しかし"],["、"],["レビ人","れびにん"],["たち"],["は"],["速やか","すみやか"],["に"],["取り","とり"],["かからなかった"],["。"]]},{"verse":6,"text":"そこで王は祭司長ヨヤダを呼んで言った。「なぜあなたはレビ人に要求し、主の僕モーセとイスラエルの会衆が、掟の幕屋のために定めた税をユダとエルサレムから徴収しないのか。」","tok":[["そこ"],["で"],["王","おう"],["は"],["祭","まつり"],["司長","しちょう"],["ヨヤダ"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["なぜ"],["あなた"],["は"],["レビ人","れびにん"],["に"],["要求","ようきゅう"],["し"],["、"],["主","ぬし"],["の"],["僕","ぼく"],["モーセ"],["と"],["イスラエル"],["の"],["会衆","かいしゅう"],["が"],["、"],["掟","おきて"],["の"],["幕屋","まくや"],["の"],["ため"],["に"],["定めた","さだめた"],["税","ぜい"],["を"],["ユダ"],["と"],["エルサレム"],["から"],["徴収","ちょうしゅう"],["しない"],["の"],["か"],["。"],["」"]]},{"verse":7,"text":"悪女アタルヤとその子たちが神殿を損い、主の神殿の聖なる物もすべてバアルのものとしていた。","tok":[["悪女","あくじょ"],["アタルヤ"],["と"],["その"],["子","こ"],["たち"],["が"],["神殿","しんでん"],["を"],["損い","そこない"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["聖","せい"],["なる"],["物","もの"],["も"],["すべて"],["バアル"],["の"],["もの"],["として"],["いた"],["。"]]},{"verse":8,"text":"王は命令を出して一つの箱を作らせ、主の神殿の門の外に置かせた。","tok":[["王","おう"],["は"],["命令","めいれい"],["を"],["出して","だして"],["一","ひと"],["つ"],["の"],["箱","ばこ"],["を"],["作らせ","つくらせ"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["門","もん"],["の"],["外","そと"],["に"],["置かせた","おかせた"],["。"]]},{"verse":9,"text":"そして、神の僕モーセが荒れ野でイスラエルに対して定めた税を主に納めるように、ユダとエルサレムに呼びかけさせた。","tok":[["そして"],["、"],["神","かみ"],["の"],["僕","ぼく"],["モーセ"],["が"],["荒れ野","あれの"],["で"],["イスラエル"],["に対して","にたいして"],["定めた","さだめた"],["税","ぜい"],["を"],["主に","おもに"],["納める","おさめる"],["よう"],["に"],["、"],["ユダ"],["と"],["エルサレム"],["に"],["呼びかけさせた","よびかけさせた"],["。"]]},{"verse":10,"text":"高官も民も皆喜んで持って来て、溢れるまで箱に投げ入れた。","tok":[["高官","こうかん"],["も"],["民","みん"],["も"],["皆","みな"],["喜んで","よろこんで"],["持って","もって"],["来て","きて"],["、"],["溢れる","あふれる"],["まで"],["箱","ばこ"],["に"],["投げ入れた","なげいれた"],["。"]]},{"verse":11,"text":"その箱がレビ人によって運び込まれ、王の監査にかけられるとき、献金がたまっているのが認められると、王の書記官と祭司長の代表が来て箱を空け、また持って行って元の場所に戻しておいた。毎日このようにして、彼らは多くの献金を集めた。","tok":[["その"],["箱","ばこ"],["が"],["レビ人","れびにん"],["によって"],["運び込まれ","はこびこまれ"],["、"],["王","おう"],["の"],["監査","かんさ"],["に"],["かけられる"],["とき"],["、"],["献金","けんきん"],["が"],["たまって"],["いる"],["の"],["が"],["認められる","みとめられる"],["と"],["、"],["王","おう"],["の"],["書記官","しょきかん"],["と"],["祭司長","さいしちょう"],["の"],["代表","だいひょう"],["が"],["来て","きて"],["箱","ばこ"],["を"],["空け","あけ"],["、"],["また"],["持って","もって"],["行って","いって"],["元","もと"],["の"],["場所","ばしょ"],["に"],["戻して","もどして"],["おいた"],["。"],["毎日","まいにち"],["この"],["よう"],["に"],["して"],["、"],["彼","かれ"],["ら"],["は"],["多く","おおく"],["の"],["献金","けんきん"],["を"],["集めた","あつめた"],["。"]]},{"verse":12,"text":"王とヨヤダは、その献金を主の神殿の工事の担当者たちに渡した。彼らは神殿を修復するために石工と大工を雇い、また神殿を修理するために鉄と青銅の職人を雇った。","tok":[["王","おう"],["と"],["ヨヤダ"],["は"],["、"],["その"],["献金","けんきん"],["を"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["工事","こうじ"],["の"],["担当者","たんとうしゃ"],["たち"],["に"],["渡した","わたした"],["。"],["彼","かれ"],["ら"],["は"],["神殿","しんでん"],["を"],["修復","しゅうふく"],["する"],["ため"],["に"],["石工","せっこう"],["と"],["大工","だいく"],["を"],["雇い","やとい"],["、"],["また"],["神殿","しんでん"],["を"],["修理","しゅうり"],["する"],["ため"],["に"],["鉄","てつ"],["と"],["青銅","せいどう"],["の"],["職人","しょくにん"],["を"],["雇った","やとった"],["。"]]},{"verse":13,"text":"工事の担当者たちはそのように行い、彼らの働きによって修理の作業は進んだ。彼らは神殿を元の状態にし、また補強した。","tok":[["工事","こうじ"],["の"],["担当者","たんとうしゃ"],["たち"],["は"],["その"],["よう"],["に"],["行い","おこない"],["、"],["彼","かれ"],["ら"],["の"],["働き","はたらき"],["によって"],["修理","しゅうり"],["の"],["作業","さぎょう"],["は"],["進んだ","すすんだ"],["。"],["彼","かれ"],["ら"],["は"],["神殿","しんでん"],["を"],["元","もと"],["の"],["状態","じょうたい"],["に"],["し"],["、"],["また"],["補強","ほきょう"],["した"],["。"]]},{"verse":14,"text":"作業が終わると、彼らは残った献金を王とヨヤダに差し出した。これをもって儀式や焼き尽くす献げ物のための祭具、盃、金と銀の祭具など、主の神殿の祭具類が作られた。ヨヤダの生きている間、主の神殿では焼き尽くす献げ物が絶えずささげられた。","tok":[["作業","さぎょう"],["が"],["終わる","おわる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["残った","のこった"],["献金","けんきん"],["を"],["王","おう"],["と"],["ヨヤダ"],["に"],["差し出した","さしだした"],["。"],["これ"],["を"],["もって"],["儀式","ぎしき"],["や"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["の"],["ため"],["の"],["祭具","さいぐ"],["、"],["盃","さかずき"],["、"],["金","きん"],["と"],["銀","ぎん"],["の"],["祭具","さいぐ"],["など"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["祭具類","さいぐるい"],["が"],["作られた","つくられた"],["。"],["ヨヤダ"],["の"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["で"],["は"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["が"],["絶えず","たえず"],["ささげられた"],["。"]]},{"verse":15,"text":"ヨヤダは年老い、長寿を全うして死んだ。死んだとき、彼は百三十歳であった。","tok":[["ヨヤダ"],["は"],["年老い","としおい"],["、"],["長寿","ちょうじゅ"],["を"],["全う","まっとう"],["して"],["死んだ","しんだ"],["。"],["死んだ","しんだ"],["とき"],["、"],["彼","かれ"],["は"],["百三十歳","ひゃくさんじゅうさい"],["で"],["あった"],["。"]]},{"verse":16,"text":"その遺体はダビデの町に諸王と共に葬られた。彼はイスラエルにおいて神とその神殿のために著しい貢献をしたからである。","tok":[["その"],["遺体","いたい"],["は"],["ダビデ"],["の"],["町","まち"],["に"],["諸王","しょおう"],["と"],["共","とも"],["に"],["葬られた","ほうむられた"],["。"],["彼","かれ"],["は"],["イスラエル"],["に"],["おいて"],["神","かみ"],["と"],["その"],["神殿","しんでん"],["の"],["ため"],["に"],["著しい","いちじるしい"],["貢献","こうけん"],["を"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"ヨヤダの死後、ユダの高官たちが王のもとに来て、ひれ伏した。そのとき、王は彼らの言うことを聞き入れた。","tok":[["ヨヤダ"],["の"],["死後","しご"],["、"],["ユダ"],["の"],["高官","こうかん"],["たち"],["が"],["王","おう"],["の"],["もと"],["に"],["来て","きて"],["、"],["ひれ伏した","ひれふした"],["。"],["その"],["とき"],["、"],["王","おう"],["は"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞き入れた","ききいれた"],["。"]]},{"verse":18,"text":"彼らは先祖の神、主の神殿を捨て、アシェラと偶像に仕えた。この罪悪のゆえに、神の怒りがユダとエルサレムに下った。","tok":[["彼","かれ"],["ら"],["は"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["を"],["捨て","すて"],["、"],["アシェラ"],["と"],["偶像","ぐうぞう"],["に"],["仕えた","つかえた"],["。"],["この"],["罪悪","ざいあく"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["の"],["怒り","いかり"],["が"],["ユダ"],["と"],["エルサレム"],["に"],["下った","くだった"],["。"]]},{"verse":19,"text":"彼らを主に立ち帰らせるため、預言者が次々と遣わされた。しかし、彼らは戒められても耳を貸さなかった。","tok":[["彼","かれ"],["ら"],["を"],["主に","おもに"],["立ち帰らせる","たちかえらせる"],["ため"],["、"],["預言者","よげんしゃ"],["が"],["次々","つぎつぎ"],["と"],["遣わされた","つかわされた"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["戒められて","いましめられて"],["も"],["耳","みみ"],["を"],["貸さなかった","かさなかった"],["。"]]},{"verse":20,"text":"神の霊が祭司ヨヤダの子ゼカルヤを捕らえた。彼は民に向かって立ち、語った。「神はこう言われる。『なぜあなたたちは主の戒めを破るのか。あなたたちは栄えない。あなたたちが主を捨てたから、主もあなたたちを捨てる。』」","tok":[["神","かみ"],["の"],["霊","れい"],["が"],["祭司","さいし"],["ヨヤダ"],["の"],["子","こ"],["ゼカルヤ"],["を"],["捕らえた","とらえた"],["。"],["彼","かれ"],["は"],["民","みん"],["に"],["向かって","むかって"],["立ち","たち"],["、"],["語った","かたった"],["。"],["「"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["なぜ"],["あなた"],["たち"],["は"],["主","ぬし"],["の"],["戒め","いましめ"],["を"],["破る","やぶる"],["の"],["か"],["。"],["あなた"],["たち"],["は"],["栄えない","さかえない"],["。"],["あなた"],["たち"],["が"],["主","ぬし"],["を"],["捨てた","すてた"],["から"],["、"],["主","ぬし"],["も"],["あなた"],["たち"],["を"],["捨てる","すてる"],["。"],["』"],["」"]]},{"verse":21,"text":"ところが彼らは共謀し、王の命令により、主の神殿の庭でゼカルヤを石で打ち殺した。","tok":[["ところ"],["が"],["彼","かれ"],["ら"],["は"],["共謀","きょうぼう"],["し"],["、"],["王","おう"],["の"],["命令","めいれい"],["に"],["より"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["庭","にわ"],["で"],["ゼカルヤ"],["を"],["石","いし"],["で"],["打ち殺した","うちころした"],["。"]]},{"verse":22,"text":"ヨアシュ王も、彼の父ヨヤダから寄せられた慈しみを顧みず、その息子を殺した。ゼカルヤは、死に際して言った。「主がこれを御覧になり、責任を追及してくださいますように。」","tok":[["ヨアシュ"],["王","おう"],["も"],["、"],["彼","かれ"],["の"],["父","ちち"],["ヨヤダ"],["から"],["寄せられた","よせられた"],["慈しみ","いつくしみ"],["を"],["顧みず","かえりみず"],["、"],["その"],["息子","むすこ"],["を"],["殺した","ころした"],["。"],["ゼカルヤ"],["は"],["、"],["死","し"],["に"],["際して","さいして"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["これ"],["を"],["御覧","ごらん"],["に"],["なり"],["、"],["責任","せきにん"],["を"],["追及","ついきゅう"],["して"],["くださいます"],["よう"],["に"],["。"],["」"]]},{"verse":23,"text":"年が改まるころ、アラムの軍隊がヨアシュに向かって攻め上った。彼らはユダとエルサレムに攻めて来て、民の中の高官をすべて殺し、戦利品をことごとくダマスコの王のもとに送った。","tok":[["年","ねん"],["が"],["改まる","あらたまる"],["ころ"],["、"],["アラム"],["の"],["軍隊","ぐんたい"],["が"],["ヨアシュ"],["に"],["向かって","むかって"],["攻め上った","せめのぼった"],["。"],["彼","かれ"],["ら"],["は"],["ユダ"],["と"],["エルサレム"],["に"],["攻めて","せめて"],["来て","きて"],["、"],["民","みん"],["の"],["中","なか"],["の"],["高官","こうかん"],["を"],["すべて"],["殺し","ころし"],["、"],["戦利品","せんりひん"],["を"],["ことごとく"],["ダマスコ"],["の"],["王","おう"],["の"],["もと"],["に"],["送った","おくった"],["。"]]},{"verse":24,"text":"攻めて来たアラム軍の兵士は少数だったが、ユダとエルサレムの人々が先祖の神、主を捨てたので、主は極めて大きな軍隊をアラム軍の手に渡された。こうして彼らはヨアシュに裁きを行った。","tok":[["攻めて","せめて"],["来た","きた"],["アラム"],["軍","ぐん"],["の"],["兵士","へいし"],["は"],["少数","しょうすう"],["だった"],["が"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["人々","ひとびと"],["が"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["捨てた","すてた"],["ので"],["、"],["主","ぬし"],["は"],["極めて","きわめて"],["大きな","おおきな"],["軍隊","ぐんたい"],["を"],["アラム"],["軍","ぐん"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["ヨアシュ"],["に"],["裁き","さばき"],["を"],["行った","おこなった"],["。"]]},{"verse":25,"text":"彼らがヨアシュに重傷を負わせて去ると、家臣た
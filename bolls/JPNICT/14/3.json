[{"verse":1,"text":"ソロモンはエルサレムのモリヤ山で、主の神殿の建築を始めた。そこは、主が父ダビデに御自身を現され、ダビデがあらかじめ準備しておいた所で、かつてエブス人オルナンの麦打ち場があった。","tok":[["ソロモン"],["は"],["エルサレム"],["の"],["モリヤ"],["山","やま"],["で"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["建築","けんちく"],["を"],["始めた","はじめた"],["。"],["そこ"],["は"],["、"],["主","ぬし"],["が"],["父","ちち"],["ダビデ"],["に"],["御自身","ごじしん"],["を"],["現され","あらわされ"],["、"],["ダビデ"],["が"],["あらかじめ"],["準備","じゅんび"],["して"],["おいた"],["所","ところ"],["で"],["、"],["かつて"],["エブス人","えぶすにん"],["オルナン"],["の"],["麦打ち","むぎうち"],["場","ば"],["が"],["あった"],["。"]]},{"verse":2,"text":"建築を始めたのは、その治世第四年の第二の月の二日であった。","tok":[["建築","けんちく"],["を"],["始めた","はじめた"],["の"],["は"],["、"],["その"],["治世","ちせい"],["第","だい"],["四","よん"],["年","ねん"],["の"],["第","だい"],["二","に"],["の"],["月","つき"],["の"],["二日","ふたか"],["で"],["あった"],["。"]]},{"verse":3,"text":"神殿建築のためにソロモンが据えた基礎は、次のような規模のものであった。奥行きは古い尺度に従って六十アンマ、間口は二十アンマ。","tok":[["神殿","しんでん"],["建築","けんちく"],["の"],["ため"],["に"],["ソロモン"],["が"],["据えた","すえた"],["基礎","きそ"],["は"],["、"],["次","つぎ"],["の"],["よう"],["な"],["規模","きぼ"],["の"],["もの"],["で"],["あった"],["。"],["奥行き","おくゆき"],["は"],["古い","ふるい"],["尺度","しゃくど"],["に"],["従って","したがって"],["六十","ろくじゅう"],["アンマ"],["、"],["間口","まぐち"],["は"],["二十","にじゅう"],["アンマ"],["。"]]},{"verse":4,"text":"前廊は、奥行きが神殿の間口と同じ二十アンマ。高さは百二十アンマ。彼は純金で内部を覆った。","tok":[["前","ぜん"],["廊","ろう"],["は"],["、"],["奥行き","おくゆき"],["が"],["神殿","しんでん"],["の"],["間口","まぐち"],["と"],["同じ","おなじ"],["二十","にじゅう"],["アンマ"],["。"],["高さ","たかさ"],["は"],["百二十","ひゃくにじゅう"],["アンマ"],["。"],["彼","かれ"],["は"],["純金","じゅんきん"],["で"],["内部","ないぶ"],["を"],["覆った","おおった"],["。"]]},{"verse":5,"text":"この大いなる神殿に糸杉材をはり付け、それを上質の金で覆い、その上になつめやしと網目模様の浮き彫りを施し、","tok":[["この"],["大いなる","おおいなる"],["神殿","しんでん"],["に"],["糸杉材","いとすぎざい"],["を"],["はり付け","はりつけ"],["、"],["それ"],["を"],["上質","じょうしつ"],["の"],["金","かね"],["で"],["覆い","おおい"],["、"],["その"],["上","うえ"],["に"],["なつめやし"],["と"],["網目","あみめ"],["模様","もよう"],["の"],["浮き彫り","うきぼり"],["を"],["施し","ほどこし"],["、"]]},{"verse":6,"text":"宝石で神殿を美しく飾った。金はパルワイムの金であった。","tok":[["宝石","ほうせき"],["で"],["神殿","しんでん"],["を"],["美しく","うつくしく"],["飾った","かざった"],["。"],["金","きん"],["は"],["パルワイム"],["の"],["金","かね"],["で"],["あった"],["。"]]},{"verse":7,"text":"神殿の梁、敷居、壁、扉も金で覆い、壁にはケルビムの浮き彫りをつけた。","tok":[["神殿","しんでん"],["の"],["梁","はり"],["、"],["敷居","しきい"],["、"],["壁","かべ"],["、"],["扉","とびら"],["も"],["金","きん"],["で"],["覆い","おおい"],["、"],["壁","かべ"],["に"],["は"],["ケルビム"],["の"],["浮き彫り","うきぼり"],["を"],["つけた"],["。"]]},{"verse":8,"text":"また彼は至聖所を造った。その奥行きは神殿の間口と同じ二十アンマ、その間口も二十アンマであり、上質の金六百キカルで覆った。","tok":[["また"],["彼","かれ"],["は"],["至聖所","しせいしょ"],["を"],["造った","つくった"],["。"],["その"],["奥行き","おくゆき"],["は"],["神殿","しんでん"],["の"],["間口","まぐち"],["と"],["同じ","おなじ"],["二十","にじゅう"],["アンマ"],["、"],["その"],["間口","まぐち"],["も"],["二十","にじゅう"],["アンマ"],["で"],["あり"],["、"],["上質","じょうしつ"],["の"],["金","きん"],["六百","ろくひゃく"],["キカル"],["で"],["覆った","おおった"],["。"]]},{"verse":9,"text":"釘は金で重さが五十シェケル、階上の部屋も金で覆った。","tok":[["釘","くぎ"],["は"],["金","きん"],["で"],["重さ","おもさ"],["が"],["五十","ごじゅう"],["シェケル"],["、"],["階上","かいじょう"],["の"],["部屋","へや"],["も"],["金","きん"],["で"],["覆った","おおった"],["。"]]},{"verse":10,"text":"彼は、至聖所の中に二体のケルビムを鋳物で造り、それを金で覆った。","tok":[["彼","かれ"],["は"],["、"],["至聖所","しせいしょ"],["の"],["中","なか"],["に"],["二","に"],["体","たい"],["の"],["ケルビム"],["を"],["鋳物","いもの"],["で"],["造り","つくり"],["、"],["それ"],["を"],["金","かね"],["で"],["覆った","おおった"],["。"]]},{"verse":11,"text":"その二体のケルビムの翼は長さが合わせて二十アンマであった。一方のケルビムの翼の一つは五アンマで神殿の壁に触れ、もう一つの翼も五アンマで、もう一方のケルビムの翼に触れていた。","tok":[["その"],["二","に"],["体","たい"],["の"],["ケルビム"],["の"],["翼","つばさ"],["は"],["長さ","ながさ"],["が"],["合わせて","あわせて"],["二十","にじゅう"],["アンマ"],["で"],["あった"],["。"],["一方","いっぽう"],["の"],["ケルビム"],["の"],["翼","つばさ"],["の"],["一","ひと"],["つ"],["は"],["五","ご"],["アンマ"],["で"],["神殿","しんでん"],["の"],["壁","かべ"],["に"],["触れ","ふれ"],["、"],["もう"],["一","ひと"],["つ"],["の"],["翼","つばさ"],["も"],["五","ご"],["アンマ"],["で"],["、"],["もう"],["一方","いっぽう"],["の"],["ケルビム"],["の"],["翼","つばさ"],["に"],["触れて","ふれて"],["いた"],["。"]]},{"verse":12,"text":"このもう一方のケルビムの翼も、一つは五アンマで神殿の壁に触れ、もう一つの翼も五アンマで、他方のケルビムの翼に触れていた。","tok":[["この"],["もう"],["一方","いっぽう"],["の"],["ケルビム"],["の"],["翼","つばさ"],["も"],["、"],["一","ひと"],["つ"],["は"],["五","ご"],["アンマ"],["で"],["神殿","しんでん"],["の"],["壁","かべ"],["に"],["触れ","ふれ"],["、"],["もう"],["一","ひと"],["つ"],["の"],["翼","つばさ"],["も"],["五","ご"],["アンマ"],["で"],["、"],["他方","たほう"],["の"],["ケルビム"],["の"],["翼","つばさ"],["に"],["触れて","ふれて"],["いた"],["。"]]},{"verse":13,"text":"このケルビムの広げた翼は合わせて二十アンマであった。ケルビムは顔を内側に向けて足で立っていた。","tok":[["この"],["ケルビム"],["の"],["広げた","ひろげた"],["翼","つばさ"],["は"],["合わせて","あわせて"],["二十","にじゅう"],["アンマ"],["で"],["あった"],["。"],["ケルビム"],["は"],["顔","かお"],["を"],["内側","うちがわ"],["に"],["向けて","むけて"],["足","あし"],["で"],["立って","たって"],["いた"],["。"]]},{"verse":14,"text":"彼は、青の織物、深紅の織物、緋の織物、麻の織物で垂れ幕を作ったが、それにもケルビムの縫い取りを施した。","tok":[["彼","かれ"],["は"],["、"],["青","あお"],["の"],["織物","おりもの"],["、"],["深紅","しんく"],["の"],["織物","おりもの"],["、"],["緋","ひ"],["の"],["織物","おりもの"],["、"],["麻","あさ"],["の"],["織物","おりもの"],["で"],["垂れ幕","たれまく"],["を"],["作った","つくった"],["が"],["、"],["それ"],["に"],["も"],["ケルビム"],["の"],["縫い取り","ぬいとり"],["を"],["施した","ほどこした"],["。"]]},{"verse":15,"text":"彼は神殿の前に二本の柱を作った。高さは三十五アンマ、頂の柱頭は五アンマであった。","tok":[["彼","かれ"],["は"],["神殿","しんでん"],["の"],["前","まえ"],["に"],["二本","にぽん"],["の"],["柱","はしら"],["を"],["作った","つくった"],["。"],["高さ","たかさ"],["は"],["三十五","さんじゅうご"],["アンマ"],["、"],["頂","いただき"],["の"],["柱頭","ちゅうとう"],["は"],["五","ご"],["アンマ"],["で"],["あった"],["。"]]},{"verse":16,"text":"また内陣に網目模様の浮き彫りを造り、それを柱頭につけ、百個のざくろを造って、網目模様の浮き彫りにつけた。","tok":[["また"],["内陣","ないじん"],["に"],["網目","あみめ"],["模様","もよう"],["の"],["浮き彫り","うきぼり"],["を"],["造り","つくり"],["、"],["それ"],["を"],["柱頭","ちゅうとう"],["に"],["つけ"],["、"],["百個","ひゃくこ"],["の"],["ざくろ"],["を"],["造って","つくって"],["、"],["網目","あみめ"],["模様","もよう"],["の"],["浮き彫り","うきぼり"],["に"],["つけた"],["。"]]},{"verse":17,"text":"その柱を聖所の正面の右と左に一本ずつ立て、右の柱をヤキン、左の柱をボアズと名付けた。","tok":[["その"],["柱","はしら"],["を"],["聖","せい"],["所","しょ"],["の"],["正面","しょうめん"],["の"],["右","みぎ"],["と"],["左","ひだり"],["に"],["一本","いちぽん"],["ずつ"],["立て","たて"],["、"],["右","みぎ"],["の"],["柱","はしら"],["を"],["ヤキン"],["、"],["左","ひだり"],["の"],["柱","はしら"],["を"],["ボアズ"],["と"],["名付けた","なづけた"],["。"]]}]
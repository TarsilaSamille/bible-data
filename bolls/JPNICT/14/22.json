[{"verse":1,"text":"エルサレムの住民は、ヨラムの最年少の子アハズヤを彼の代わりに王とした。アラブ人と共に陣営に攻め込んできた部隊によって年上のすべての王子が殺されてしまったからである。こうして、ユダの王ヨラムの子アハズヤが王となった。","tok":[["エルサレム"],["の"],["住民","じゅうみん"],["は"],["、"],["ヨラム"],["の"],["最年少","さいねんしょう"],["の"],["子","こ"],["アハズヤ"],["を"],["彼","かれ"],["の"],["代わり","かわり"],["に"],["王","おう"],["と"],["した"],["。"],["アラブ人","あらぶじん"],["と"],["共","とも"],["に"],["陣営","じんえい"],["に"],["攻め込んで","せめこんで"],["きた"],["部隊","ぶたい"],["によって"],["年上","としうえ"],["の"],["すべて"],["の"],["王子","おうじ"],["が"],["殺されて","ころされて"],["しまった"],["から"],["で"],["ある"],["。"],["こう"],["して"],["、"],["ユダ"],["の"],["王","おう"],["ヨラム"],["の"],["子","こ"],["アハズヤ"],["が"],["王","おう"],["と"],["なった"],["。"]]},{"verse":2,"text":"アハズヤは四十二歳で王となり、一年間エルサレムで王位にあった。その母は名をアタルヤといい、オムリの孫娘であった。","tok":[["アハズヤ"],["は"],["四十二歳","よんじゅうにさい"],["で"],["王","おう"],["と"],["なり"],["、"],["一","いち"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["アタルヤ"],["と"],["いい"],["、"],["オムリ"],["の"],["孫娘","まごむすめ"],["で"],["あった"],["。"]]},{"verse":3,"text":"この母が悪い勧めを与えたので、彼もアハブの家の道を歩んだ。","tok":[["この"],["母","はは"],["が"],["悪い","わるい"],["勧め","すすめ"],["を"],["与えた","あたえた"],["ので"],["、"],["彼","かれ"],["も"],["アハブ"],["の"],["家","いえ"],["の"],["道","みち"],["を"],["歩んだ","あゆんだ"],["。"]]},{"verse":4,"text":"彼はアハブの家と同じように主の目に悪とされることを行った。父の死後、アハブの家の者が顧問となって彼を滅びに至らせたのである。","tok":[["彼","かれ"],["は"],["アハブ"],["の"],["家","いえ"],["と"],["同じ","おなじ"],["よう"],["に"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["。"],["父","ちち"],["の"],["死後","しご"],["、"],["アハブ"],["の"],["家","いえ"],["の"],["者","もの"],["が"],["顧問","こもん"],["と"],["なって"],["彼","かれ"],["を"],["滅び","ほろび"],["に"],["至らせた","いたらせた"],["ので"],["ある"],["。"]]},{"verse":5,"text":"アハズヤは彼らの勧めによって、イスラエルの王、アハブの子ヨラムと共にアラムの王ハザエルと戦うため、ラモト‧ギレアドに行った。しかし、アラム兵がヨラムに傷を負わせた。","tok":[["アハズヤ"],["は"],["彼","かれ"],["ら"],["の"],["勧め","すすめ"],["によって"],["、"],["イスラエル"],["の"],["王","おう"],["、"],["アハブ"],["の"],["子","こ"],["ヨラム"],["と"],["共","とも"],["に"],["アラム"],["の"],["王","おう"],["ハザエル"],["と"],["戦う","たたかう"],["ため"],["、"],["ラモト"],["‧"],["ギレアド"],["に"],["行った","いった"],["。"],["しかし"],["、"],["アラム"],["兵","へい"],["が"],["ヨラム"],["に"],["傷","きず"],["を"],["負わせた","おわせた"],["。"]]},{"verse":6,"text":"ヨラム王は、アラムの王ハザエルとのラマにおける戦いで負った傷をいやすため、イズレエルに戻った。ユダの王、ヨラムの子アハズヤは、病床にあるアハブの子ヨラムを見舞うため、イズレエルに下って行った。","tok":[["ヨラム"],["王","おう"],["は"],["、"],["アラム"],["の"],["王","おう"],["ハザエル"],["と"],["の"],["ラマ"],["に"],["おける"],["戦い","たたかい"],["で"],["負った","おった"],["傷","きず"],["を"],["いやす"],["ため"],["、"],["イズレエル"],["に"],["戻った","もどった"],["。"],["ユダ"],["の"],["王","おう"],["、"],["ヨラム"],["の"],["子","こ"],["アハズヤ"],["は"],["、"],["病床","びょうしょう"],["に"],["ある"],["アハブ"],["の"],["子","こ"],["ヨラム"],["を"],["見舞う","みまう"],["ため"],["、"],["イズレエル"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":7,"text":"――アハズヤがヨラムを訪れることによって滅ぶに至ったのは神による。――彼はそこに着くと、ニムシの子イエフのもとにヨラムと共に出かけた。イエフは、アハブの家を絶つために主が油を注がれた者である。","tok":[["―"],["―"],["アハズヤ"],["が"],["ヨラム"],["を"],["訪れる","おとずれる"],["こと"],["によって"],["滅ぶ","ほろぶ"],["に"],["至った","いたった"],["の"],["は"],["神","かみ"],["に"],["よる"],["。"],["―"],["―"],["彼","かれ"],["は"],["そこ"],["に"],["着く","つく"],["と"],["、"],["ニムシ"],["の"],["子","こ"],["イエフ"],["の"],["もと"],["に"],["ヨラム"],["と"],["共","とも"],["に"],["出かけた","でかけた"],["。"],["イエフ"],["は"],["、"],["アハブ"],["の"],["家","いえ"],["を"],["絶つ","たつ"],["ため"],["に"],["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":8,"text":"イエフがアハブの家に裁きを行うとき、彼はアハズヤに仕えるユダの高官とアハズヤの兄弟の子らを見つけて殺した。","tok":[["イエフ"],["が"],["アハブ"],["の"],["家","いえ"],["に"],["裁き","さばき"],["を"],["行う","おこなう"],["とき"],["、"],["彼","かれ"],["は"],["アハズヤ"],["に"],["仕える","つかえる"],["ユダ"],["の"],["高官","こうかん"],["と"],["アハズヤ"],["の"],["兄弟","きょうだい"],["の"],["子","こ"],["ら"],["を"],["見つけて","みつけて"],["殺した","ころした"],["。"]]},{"verse":9,"text":"更にアハズヤを捜し求めていたところ、人々はサマリアに潜んでいるアハズヤを捕らえ、イエフのもとに連れて来て、その命を絶った。彼らは、「これは心を尽くして主を求めたヨシャファトの子なのだ」と言って、彼を葬った。こうして、アハズヤの家には国を治めることのできる者はいなくなった。","tok":[["更に","さらに"],["アハズヤ"],["を"],["捜し求めて","さがしもとめて"],["いた"],["ところ"],["、"],["人々","ひとびと"],["は"],["サマリア"],["に"],["潜んで","ひそんで"],["いる"],["アハズヤ"],["を"],["捕らえ","とらえ"],["、"],["イエフ"],["の"],["もと"],["に"],["連れて","つれて"],["来て","きて"],["、"],["その"],["命","いのち"],["を"],["絶った","たった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["「"],["これ"],["は"],["心","こころ"],["を"],["尽くして","つくして"],["主","ぬし"],["を"],["求めた","もとめた"],["ヨシャファト"],["の"],["子","こ"],["な"],["の"],["だ"],["」"],["と"],["言って","いって"],["、"],["彼","かれ"],["を"],["葬った","ほうむった"],["。"],["こう"],["して"],["、"],["アハズヤ"],["の"],["家","いえ"],["に"],["は"],["国","くに"],["を"],["治める","おさめる"],["こと"],["の"],["できる"],["者","もの"],["は"],["いなく"],["なった"],["。"]]},{"verse":10,"text":"アハズヤの母アタルヤは息子の死んだのを見て、直ちにユダの家の王族をすべて滅ぼそうとした。","tok":[["アハズヤ"],["の"],["母","はは"],["アタルヤ"],["は"],["息子","むすこ"],["の"],["死んだ","しんだ"],["の"],["を"],["見て","みて"],["、"],["直ちに","ただちに"],["ユダ"],["の"],["家","いえ"],["の"],["王族","おうぞく"],["を"],["すべて"],["滅ぼそう","ほろぼそう"],["と"],["した"],["。"]]},{"verse":11,"text":"しかし、王女ヨシェバがアハズヤの子ヨアシュを抱き、殺されようとしている王子たちの中からひそかに連れ出し、乳母と共に寝具の部屋に入れておいた。祭司ヨヤダの妻であり、アハズヤの妹である、ヨラム王の娘ヨシェバは、ヨアシュをアタルヤからかくまい、彼は殺されずに済んだ。","tok":[["しかし"],["、"],["王女","おうじょ"],["ヨシェバ"],["が"],["アハズヤ"],["の"],["子","こ"],["ヨアシュ"],["を"],["抱き","いだき"],["、"],["殺されよう","ころされよう"],["として"],["いる"],["王子","おうじ"],["たち"],["の"],["中","なか"],["から"],["ひそか"],["に"],["連れ出し","つれだし"],["、"],["乳母","うば"],["と"],["共","とも"],["に"],["寝具","しんぐ"],["の"],["部屋","へや"],["に"],["入れて","いれて"],["おいた"],["。"],["祭司","さいし"],["ヨヤダ"],["の"],["妻","つま"],["で"],["あり"],["、"],["アハズヤ"],["の"],["妹","いもうと"],["で"],["ある"],["、"],["ヨラム"],["王","おう"],["の"],["娘","むすめ"],["ヨシェバ"],["は"],["、"],["ヨアシュ"],["を"],["アタルヤ"],["から"],["かくまい"],["、"],["彼","かれ"],["は"],["殺されず","ころされず"],["に"],["済んだ","すんだ"],["。"]]},{"verse":12,"text":"こうして、アタルヤが国を支配していた六年の間、ヨアシュは彼らと共に神殿の中に隠れていた。","tok":[["こう"],["して"],["、"],["アタルヤ"],["が"],["国","くに"],["を"],["支配","しはい"],["して"],["いた"],["六","ろく"],["年","ねん"],["の"],["間","あいだ"],["、"],["ヨアシュ"],["は"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["神殿","しんでん"],["の"],["中","なか"],["に"],["隠れて","かくれて"],["いた"],["。"]]}]
[{"verse":1,"text":"アマツヤは二十五歳で王となり、二十九年間エルサレムで王位にあった。その母は名をヨアダンといい、エルサレムの出身であった。","tok":[["アマツヤ"],["は"],["二十五歳","にじゅうごさい"],["で"],["王","おう"],["と"],["なり"],["、"],["二十九","にじゅうきゅう"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["ヨアダン"],["と"],["いい"],["、"],["エルサレム"],["の"],["出身","しゅっしん"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼は主の目にかなう正しいことを行ったが、心からそうしたのではなかった。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["かなう"],["正しい","ただしい"],["こと"],["を"],["行った","おこなった"],["が"],["、"],["心","こころ"],["から"],["そう"],["した"],["ので"],["は"],["なかった"],["。"]]},{"verse":3,"text":"彼は国を掌握すると、父ヨアシュ王を殺害した家臣たちを殺した。","tok":[["彼","かれ"],["は"],["国","くに"],["を"],["掌握","しょうあく"],["する"],["と"],["、"],["父","ちち"],["ヨアシュ"],["王","おう"],["を"],["殺害","さつがい"],["した"],["家臣","かしん"],["たち"],["を"],["殺した","ころした"],["。"]]},{"verse":4,"text":"しかし、モーセの書、律法に記されているところに従い、その子供たちは殺さなかった。主がこう命じておられるからである。「父は子のゆえに死に定められず、子は父のゆえに死に定められない。人は、それぞれ自分の罪のゆえに死に定められる。」","tok":[["しかし"],["、"],["モーセ"],["の"],["書","しょ"],["、"],["律法","りっぽう"],["に"],["記されて","しるされて"],["いる"],["ところ"],["に"],["従い","したがい"],["、"],["その"],["子供","こども"],["たち"],["は"],["殺さなかった","ころさなかった"],["。"],["主","ぬし"],["が"],["こう"],["命じて","めいじて"],["おられる"],["から"],["で"],["ある"],["。"],["「"],["父","ちち"],["は"],["子","こ"],["の"],["ゆえ"],["に"],["死に","しに"],["定められず","さだめられず"],["、"],["子","こ"],["は"],["父","ちち"],["の"],["ゆえ"],["に"],["死に","しに"],["定められない","さだめられない"],["。"],["人","ひと"],["は"],["、"],["それぞれ"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死に","しに"],["定められる","さだめられる"],["。"],["」"]]},{"verse":5,"text":"アマツヤはユダの人々を召集し、ユダ族とベニヤミン族のすべての人々を家系に従って千人隊の長および百人隊の長のもとに配属した。二十歳以上の者の数を調べたところ、槍と盾を携える戦闘員として三十万の若者がいることが分かった。","tok":[["アマツヤ"],["は"],["ユダ"],["の"],["人々","ひとびと"],["を"],["召集","しょうしゅう"],["し"],["、"],["ユダ族","ゆだぞく"],["と"],["ベニヤミン"],["族","ぞく"],["の"],["すべて"],["の"],["人々","ひとびと"],["を"],["家系","かけい"],["に"],["従って","したがって"],["千人隊","せんにんたい"],["の"],["長","なが"],["および"],["百人隊","ひゃくにんたい"],["の"],["長","ちょう"],["の"],["もと"],["に"],["配属","はいぞく"],["した"],["。"],["二十歳","はたち"],["以上","いじょう"],["の"],["者","もの"],["の"],["数","かず"],["を"],["調べた","しらべた"],["ところ"],["、"],["槍","やり"],["と"],["盾","たて"],["を"],["携える","たずさえる"],["戦闘員","せんとういん"],["として"],["三十万","さんじゅうまん"],["の"],["若者","わかもの"],["が"],["いる"],["こと"],["が"],["分かった","わかった"],["。"]]},{"verse":6,"text":"また彼は銀百キカルを費やして、イスラエルから勇士十万を雇った。","tok":[["また"],["彼","かれ"],["は"],["銀","ぎん"],["百","ひゃく"],["キカル"],["を"],["費やして","ついやして"],["、"],["イスラエル"],["から"],["勇士","ゆうし"],["十万","じゅうまん"],["を"],["雇った","やとった"],["。"]]},{"verse":7,"text":"ところが、ある神の人が来て言った。「王よ、イスラエルの軍隊を同行させてはなりません。主はイスラエルの者、すなわちどのエフライム人とも共においでにならないからです。","tok":[["ところ"],["が"],["、"],["ある"],["神","かみ"],["の"],["人","ひと"],["が"],["来て","きて"],["言った","いった"],["。"],["「"],["王","おう"],["よ"],["、"],["イスラエル"],["の"],["軍隊","ぐんたい"],["を"],["同行","どうこう"],["させて"],["は"],["なりません"],["。"],["主","ぬし"],["は"],["イスラエル"],["の"],["者","もの"],["、"],["すなわち"],["どの"],["エフライム"],["人","にん"],["とも"],["共","とも"],["に"],["おいで"],["に"],["ならない"],["から"],["です"],["。"]]},{"verse":8,"text":"もし行くなら、単独で行って勇敢に戦いなさい。そうでなければ、神は敵の前であなたを挫かれます。神には力があって、助けることも、挫くこともおできになります。」","tok":[["もし"],["行くなら","いくなら"],["、"],["単独","たんどく"],["で"],["行って","いって"],["勇敢","ゆうかん"],["に"],["戦い","たたかい"],["なさい"],["。"],["そう"],["で"],["なければ"],["、"],["神","かみ"],["は"],["敵","てき"],["の"],["前","まえ"],["で"],["あなた"],["を"],["挫かれます","くじかれます"],["。"],["神","かみ"],["に"],["は"],["力","ちから"],["が"],["あって"],["、"],["助ける","たすける"],["こと"],["も"],["、"],["挫く","くじく"],["こと"],["も"],["おでき"],["に"],["なります"],["。"],["」"]]},{"verse":9,"text":"アマツヤは神の人に言った。「イスラエルの部隊に払った百キカルはどうしたらよいのか。」神の人は答えた。「主はそれより多くのものを与えることがおできになります。」","tok":[["アマツヤ"],["は"],["神","かみ"],["の"],["人","ひと"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["部隊","ぶたい"],["に"],["払った","はらった"],["百","ひゃく"],["キカル"],["は"],["どう"],["したら"],["よい"],["の"],["か"],["。"],["」"],["神","かみ"],["の"],["人","ひと"],["は"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["は"],["それ"],["より"],["多く","おおく"],["の"],["もの"],["を"],["与える","あたえる"],["こと"],["が"],["おでき"],["に"],["なります"],["。"],["」"]]},{"verse":10,"text":"そこでアマツヤはエフライムから来た部隊を、彼らの地に帰らせるために分離した。そのため、彼らはユダに対して激しく憤り、怒りに燃えながら彼らの地に帰って行った。","tok":[["そこ"],["で"],["アマツヤ"],["は"],["エフライム"],["から"],["来た","きた"],["部隊","ぶたい"],["を"],["、"],["彼","かれ"],["ら"],["の"],["地","ち"],["に"],["帰らせる","かえらせる"],["ため"],["に"],["分離","ぶんり"],["した"],["。"],["その"],["ため"],["、"],["彼","かれ"],["ら"],["は"],["ユダ"],["に対して","にたいして"],["激しく","はげしく"],["憤り","いきどおり"],["、"],["怒り","いかり"],["に"],["燃え","もえ"],["ながら"],["彼","かれ"],["ら"],["の"],["地","ち"],["に"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":11,"text":"しかしアマツヤは、勇気を奮い起こし、自分の軍隊を率いて塩の谷まで進み、一万のセイル兵を打ち倒した。","tok":[["しかし"],["アマツヤ"],["は"],["、"],["勇気","ゆうき"],["を"],["奮い起こし","ふるいおこし"],["、"],["自分","じぶん"],["の"],["軍隊","ぐんたい"],["を"],["率いて","ひきいて"],["塩","しお"],["の"],["谷","たに"],["まで"],["進み","すすみ"],["、"],["一万","いちまん"],["の"],["セイル"],["兵","へい"],["を"],["打ち倒した","うちたおした"],["。"]]},{"verse":12,"text":"またユダの兵はほかに一万の敵兵を生け捕りにし、岩山の頂に引いて行き、彼らをその岩山の頂から突き落としたので、皆砕かれて死んだ。","tok":[["また"],["ユダ"],["の"],["兵","へい"],["は"],["ほか"],["に"],["一万","いちまん"],["の"],["敵兵","てきへい"],["を"],["生け捕り","いけどり"],["に"],["し"],["、"],["岩山","いわやま"],["の"],["頂","いただき"],["に"],["引いて","ひいて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["を"],["その"],["岩山","いわやま"],["の"],["頂","いただき"],["から"],["突き落とした","つきおとした"],["ので"],["、"],["皆","みな"],["砕かれて","くだかれて"],["死んだ","しんだ"],["。"]]},{"verse":13,"text":"他方、アマツヤが戦いに同行させずに送り返した部隊の兵士らは、サマリアからベト‧ホロンまでのユダの町々を荒らしまわり、三千人の住民を打ち殺し、略奪をほしいままにした。","tok":[["他方","たほう"],["、"],["アマツヤ"],["が"],["戦い","たたかい"],["に"],["同行","どうこう"],["させず"],["に"],["送り返した","おくりかえした"],["部隊","ぶたい"],["の"],["兵士","へいし"],["ら"],["は"],["、"],["サマリア"],["から"],["ベト"],["‧"],["ホロン"],["まで"],["の"],["ユダ"],["の"],["町々","まちまち"],["を"],["荒らし","あらし"],["まわり"],["、"],["三千人","さんせんにん"],["の"],["住民","じゅうみん"],["を"],["打ち殺し","うちころし"],["、"],["略奪","りゃくだつ"],["を"],["ほしいまま"],["に"],["した"],["。"]]},{"verse":14,"text":"アマツヤはエドム人の討伐から帰った後、セイル人の神々を導入し、これを自分の神とし、その前にひれ伏して香をたいた。","tok":[["アマツヤ"],["は"],["エドム人","えどむにん"],["の"],["討伐","とうばつ"],["から"],["帰った","かえった"],["後","あと"],["、"],["セイル人","せいるにん"],["の"],["神々","かみがみ"],["を"],["導入","どうにゅう"],["し"],["、"],["これ"],["を"],["自分","じぶん"],["の"],["神","かみ"],["と"],["し"],["、"],["その"],["前","まえ"],["に"],["ひれ伏して","ひれふして"],["香","こう"],["を"],["たいた"],["。"]]},{"verse":15,"text":"主はそのアマツヤに対して怒りに燃え、預言者を遣わされた。彼は王に言った。「あなたの手から自分の民を救えなかった神々を、どうしてあなたは求めるのか。」","tok":[["主","ぬし"],["は"],["その"],["アマツヤ"],["に対して","にたいして"],["怒り","いかり"],["に"],["燃え","もえ"],["、"],["預言者","よげんしゃ"],["を"],["遣わされた","つかわされた"],["。"],["彼","かれ"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["手","て"],["から"],["自分","じぶん"],["の"],["民","たみ"],["を"],["救えなかった","すくえなかった"],["神々","かみがみ"],["を"],["、"],["どう"],["して"],["あなた"],["は"],["求める","もとめる"],["の"],["か"],["。"],["」"]]},{"verse":16,"text":"彼がこう告げているときに、アマツヤは言った。「お前を王の顧問にした覚えはない。もうよい。打ち殺されてもよいのか。」預言者は語るのをやめたが、こう付け加えた。「あなたはこのような事を行い、またわたしの忠告も聞かない。それゆえ神はあなたを滅ぼそうと決められたことが、分かりました。」","tok":[["彼","かれ"],["が"],["こう"],["告げて","つげて"],["いる"],["とき"],["に"],["、"],["アマツヤ"],["は"],["言った","いった"],["。"],["「"],["お前","おまえ"],["を"],["王","おう"],["の"],["顧問","こもん"],["に"],["した"],["覚え","おぼえ"],["は"],["ない"],["。"],["もう"],["よい"],["。"],["打ち殺されて","うちころされて"],["も"],["よい"],["の"],["か"],["。"],["」"],["預言者","よげんしゃ"],["は"],["語る","かたる"],["の"],["を"],["やめた"],["が"],["、"],["こう"],["付け加えた","つけくわえた"],["。"],["「"],["あなた"],["は"],["この"],["よう"],["な"],["事","こと"],["を"],["行い","おこない"],["、"],["また"],["わたし"],["の"],["忠告","ちゅうこく"],["も"],["聞かない","きかない"],["。"],["それ"],["ゆえ"],["神","かみ"],["は"],["あなた"],["を"],["滅ぼそう","ほろぼそう"],["と"],["決められた","きめられた"],["こと"],["が"],["、"],["分かりました","わかりました"],["。"],["」"]]},{"verse":17,"text":"ユダの王アマツヤは、協議の結果、イスラエルの王、イエフの孫でヨアハズの子であるヨアシュに使者を遣わし、「来るがよい、戦いを交えよう」と言わせた。","tok":[["ユダ"],["の"],["王","おう"],["アマツヤ"],["は"],["、"],["協議","きょうぎ"],["の"],["結果","けっか"],["、"],["イスラエル"],["の"],["王","おう"],["、"],["イエフ"],["の"],["孫","まご"],["で"],["ヨアハズ"],["の"],["子","こ"],["で"],["ある"],["ヨアシュ"],["に"],["使者","ししゃ"],["を"],["遣わし","つかわし"],["、"],["「"],["来る","くる"],["が"],["よい"],["、"],["戦い","たたかい"],["を"],["交えよう","まじえよう"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":18,"text":"だが、イスラエルの王ヨアシュは、ユダの王アマツヤに次のような返事を送った。「レバノンのあざみがレバノンの杉に、『あなたの娘をわたしの息子の嫁にくれ』と申し込んだが、レバノンの野の獣が通りかかって、あざみを踏み倒してしまった。","tok":[["だ"],["が"],["、"],["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["は"],["、"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["返事","へんじ"],["を"],["送った","おくった"],["。"],["「"],["レバノン"],["の"],["あざみ"],["が"],["レバノン"],["の"],["杉","すぎ"],["に"],["、"],["『"],["あなた"],["の"],["娘","むすめ"],["を"],["わたし"],["の"],["息子","むすこ"],["の"],["嫁","よめ"],["に"],["くれ"],["』"],["と"],["申し込んだ","もうしこんだ"],["が"],["、"],["レバノン"],["の"],["野","の"],["の"],["獣","けもの"],["が"],["通りかかって","とおりかかって"],["、"],["あざみ"],["を"],["踏み倒して","ふみたおして"],["しまった"],["。"]]},{"verse":19,"text":"あなたはエドムを打ち破ったと言って、思い上がり、うぬぼれている。今は家にとどまっているがよい。なぜ挑発して災いを招き、あなただけでなく、ユダも一緒に倒れるようなことをするのか。」","tok":[["あなた"],["は"],["エドム"],["を"],["打ち破った","うちやぶった"],["と"],["言って","いって"],["、"],["思い上がり","おもいあがり"],["、"],["うぬぼれて"],["いる"],["。"],["今","いま"],["は"],["家","いえ"],["に"],["とどまって"],["いる"],["が"],["よい"],["。"],["なぜ"],["挑発","ちょうはつ"],["して"],["災い","わざわい"],["を"],["招き","まねき"],["、"],["あなた"],["だけ"],["で"],["なく"],["、"],["ユダ"],["も"],["一緒","いっしょ"],["に"],["倒れる","たおれる"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["。"],["」"]]},{"verse":20,"text":"しかしアマツヤはこれを聞き入れなかった。それは神の計らいによる。ユダの人々がエドムの神々を求めたため、神は彼らを敵の手に渡そうとされたのである。","tok":[["しかし"],["アマツヤ"],["は"],["これ"],["を"],["聞き入れなかった","ききいれなかった"],["。"],["それ"],["は"],["神","かみ"],["の"],["計らい","はからい"],["に"],["よる"],["。"],["ユダ"],["の"],["人々","ひとびと"],["が"],["エドム"],["の"],["神々","かみがみ"],["を"],["求めた","もとめた"],["ため"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡そう","わたそう"],["と"],["された"],["ので"],["ある"],["。"]]},{"verse":21,"text":"イスラエルの王ヨアシュは上って来て、ユダのベト‧シェメシュでユダの王アマツヤと戦いを交えた。","tok":[["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["は"],["上って","のぼって"],["来て","きて"],["、"],["ユダ"],["の"],["ベト"],["‧"],["シェメシュ"],["で"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["と"],["戦い","たたかい"],["を"],["交えた","まじえた"],["。"]]},{"verse":22,"text":"その結果、ユダはイスラエルに惨敗し、兵はおのおのその天幕に逃げ帰ってしまった。","tok":[["その"],["結果","けっか"],["、"],["ユダ"],["は"],["イスラエル"],["に"],["惨敗","ざんぱい"],["し"],["、"],["兵","へい"],["は"],["おのおの"],["その"],["天幕","てんまく"],["に"],["逃げ帰って","にげかえって"],["しまった"],["。"]]},{"verse":23,"text":"イスラエルの王ヨアシュはベト‧シェメシュで、ヨアハズの孫でヨアシュの子であるユダの王アマツヤを捕らえ、エルサレムに引いて来て、その城壁をエフライムの門から角の門まで四百アンマにわたって破壊した。","tok":[["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["は"],["ベト"],["‧"],["シェメシュ"],["で"],["、"],["ヨアハズ"],["の"],["孫","まご"],["で"],["ヨアシュ"],["の"],["子","こ"],["で"],["ある"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["を"],["捕らえ","とらえ"],["、"],["エルサレム"],["に"],["引いて","ひいて"],["来て","きて"],["、"],["その"],["城壁","じょうへき"],["を"],["エフライム"],["の"],["門","もん"],["から"],["角","かど"],["の"],["門","もん"],["まで"],["四百","よんひゃく"],["アンマ"],["に"],["わたって"],["破壊","はかい"],["した"],["。"]]},{"verse":24,"text":"また彼は、オベド‧エドムの管理下にあった、神殿のすべての金、銀、祭具、更に王宮の宝物および人質を取って、サマリアに凱旋した。","tok":[["また"],["彼","かれ"],["は"],["、"],["オベド"],["‧"],["エドム"],["の"],["管理下","かんりか"],["に"],["あった"],["、"],["神殿","しんでん"],["の"],["すべて"],["の"],["金","かね"],["、"],["銀","ぎん"],["、"],["祭具","さいぐ"],["、"],["更に","さらに"],["王宮","おうきゅう"],["の"],["宝物","たからもの"],["および"],["人質","ひとじち"],["を"],["取って","とって"],["、"],["サマリア"],["に"],["凱旋","がいせん"],["した"],["。"]]},{"verse":25,"text":"ユダの王、ヨアシュの子アマツヤは、イスラエルの王、ヨアハズの子ヨアシュの死後、なお十五年生き永らえた。","tok":[["ユダ"],["の"],["王","おう"],["、"],["ヨアシュ"],["の"],["子","こ"],["アマツヤ"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["、"],["ヨアハズ"],["の"],["子","こ"],["ヨアシュ"],["の"],["死後","しご"],["、"],["なお"],["十五","じゅうご"],["年","ねん"],["生き永らえた","いきながらえた"],["。"]]},{"verse":26,"text":"アマツヤの他の事績は、初期のことも後期のことも、『ユダとイスラエルの列王の書』に記されている。","tok":[["アマツヤ"],["の"],["他","ほか"],["の"],["事績","じせき"],["は"],["、"],["初期","しょき"],["の"],["こと"],["も"],["後期","こうき"],["の"],["こと"],["も"],["、"],["『"],["ユダ"],["と"],["イスラエル"],["の"],["列王","れつおう"],["の"],["書","しょ"],["』"],["に"],["記されて","しるされて"],["いる"],["。"]]},{"verse":27,"text":"アマツヤが主に背を向けた時から、彼に対する謀反がエルサレムで企てられたため、彼はラキシュに逃れたが、ラキシュに送られた追っ手によって殺された。","tok":[["アマツヤ"],["が"],["主に","おもに"],["背","せ"],["を"],["向けた","むけた"],["時","とき"],["から"],["、"],["彼","かれ"],["に"],["対する","たいする"],["謀反","むほん"],["が"],["エルサレム"],["で"],["企てられた","くわだてられた"],["ため"],["、"],["彼","かれ"],["は"],["ラキシュ"],["に"],["逃れた","のがれた"],["が"],["、"],["ラキシュ"],["に"],["送られた","おくられた"],["追っ手","おって"],["によって"],["殺された","ころされた"],["。"]]},{"verse":28,"text":"その遺体は馬に乗せて運ばれ、ユダの町に先祖と共に葬られた。","tok":[
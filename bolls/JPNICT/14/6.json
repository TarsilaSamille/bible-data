,["向かって","むかって"],["手","て"],["を"],["伸ばして","のばして"],["祈るなら","いのるなら"],["、"],["その"],["どの"],["祈り","いのり"],["、"],["どの"],["願い","ねがい"],["に"],["も"],["、"]]},{"verse":30,"text":"あなたはお住まいである天から耳を傾け、罪を赦してください。あなたは人間の心をご存じですから、どの人にもその人の歩んできたすべての道に従って報いてください。まことにあなただけが人の心をご存じです。","tok":[["あなた"],["は"],["お住まい","おすまい"],["で"],["ある"],["天","てん"],["から"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["罪","つみ"],["を"],["赦して","ゆるして"],["ください"],["。"],["あなた"],["は"],["人間","にんげん"],["の"],["心","こころ"],["を"],["ご存じ","ごぞんじ"],["です"],["から"],["、"],["どの"],["人","ひと"],["に"],["も"],["その"],["人","ひと"],["の"],["歩んで","あゆんで"],["きた"],["すべて"],["の"],["道","みち"],["に"],["従って","したがって"],["報いて","むくいて"],["ください"],["。"],["まこと"],["に"],["あなた"],["だけ"],["が"],["人","ひと"],["の"],["心","こころ"],["を"],["ご存じ","ごぞんじ"],["です"],["。"]]},{"verse":31,"text":"こうして彼らは、あなたがわたしたちの先祖にお与えになった地で生を営む間、絶えずあなたを畏れ敬い、あなたの道に従って歩み続けるでしょう。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["が"],["わたしたち"],["の"],["先祖","せんぞ"],["に"],["お与え","おあたえ"],["に"],["なった"],["地","ち"],["で"],["生","なま"],["を"],["営む","いとなむ"],["間","あいだ"],["、"],["絶えず","たえず"],["あなた"],["を"],["畏れ","おそれ"],["敬い","うやまい"],["、"],["あなた"],["の"],["道","みち"],["に"],["従って","したがって"],["歩み","あゆみ"],["続けるでしょう","つづけるでしょう"],["。"]]},{"verse":32,"text":"更に、あなたの民イスラエルに属さない異国人が、大いなる御名、力強い御手、伸ばされた御腕を慕って、遠い国からこの神殿に来て祈るなら、","tok":[["更に","さらに"],["、"],["あなた"],["の"],["民","みん"],["イスラエル"],["に"],["属さない","ぞくさない"],["異国人","いこくにん"],["が"],["、"],["大いなる","おおいなる"],["御名","ぎょめい"],["、"],["力強い","ちからづよい"],["御手","おて"],["、"],["伸ばされた","のばされた"],["御腕","おうで"],["を"],["慕って","したって"],["、"],["遠い","とおい"],["国","くに"],["から"],["この"],["神殿","しんでん"],["に"],["来て","きて"],["祈るなら","いのるなら"],["、"]]},{"verse":33,"text":"あなたはお住まいである天から耳を傾け、その異国人があなたに叫び求めることをすべてかなえてください。こうして、地上のすべての民は御名を知り、あなたの民イスラエルと同様にあなたを畏れ敬い、わたしの建てたこの神殿が御名をもって呼ばれていることを知るでしょう。","tok":[["あなた"],["は"],["お住まい","おすまい"],["で"],["ある"],["天","てん"],["から"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["その"],["異国人","いこくにん"],["が"],["あなた"],["に"],["叫び","さけび"],["求める","もとめる"],["こと"],["を"],["すべて"],["かなえて"],["ください"],["。"],["こう"],["して"],["、
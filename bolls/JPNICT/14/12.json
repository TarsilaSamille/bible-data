[{"verse":1,"text":"レハブアムは国が固まり、自らも力をつけると、すべてのイスラエル人と共に主の律法を捨てた。","tok":[["レハブアム"],["は"],["国","くに"],["が"],["固まり","かたまり"],["、"],["自ら","みずから"],["も"],["力","ちから"],["を"],["つける"],["と"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["と"],["共","とも"],["に"],["主","ぬし"],["の"],["律法","りっぽう"],["を"],["捨てた","すてた"],["。"]]},{"verse":2,"text":"レハブアム王の治世第五年に、エジプトの王シシャクがエルサレムに攻め上って来た。彼らが主に背いたからである。","tok":[["レハブアム"],["王","おう"],["の"],["治世","ちせい"],["第","だい"],["五","ご"],["年","ねん"],["に"],["、"],["エジプト"],["の"],["王","おう"],["シシャク"],["が"],["エルサレム"],["に"],["攻め上って","せめのぼって"],["来た","きた"],["。"],["彼","かれ"],["ら"],["が"],["主","ぬし"],["に"],["背いた","そむいた"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼は戦車千二百両、騎兵六万を擁し、彼がエジプトから率いてきたリビア人、スキイム人、クシュ人の民は数えきれないほどであった。","tok":[["彼","かれ"],["は"],["戦車","せんしゃ"],["千二百","せんにひゃく"],["両","りょう"],["、"],["騎兵","きへい"],["六万","ろくまん"],["を"],["擁し","ようし"],["、"],["彼","かれ"],["が"],["エジプト"],["から"],["率いて","ひきいて"],["きた"],["リビア人","りびあにん"],["、"],["スキイム"],["人","にん"],["、"],["クシュ人","くしゅにん"],["の"],["民","たみ"],["は"],["数え","かぞえ"],["きれない"],["ほど"],["で"],["あった"],["。"]]},{"verse":4,"text":"彼はユダの砦の町を次々に陥れ、エルサレムにまで迫った。","tok":[["彼","かれ"],["は"],["ユダ"],["の"],["砦","とりで"],["の"],["町","まち"],["を"],["次々","つぎつぎ"],["に"],["陥れ","おとしいれ"],["、"],["エルサレム"],["に"],["まで"],["迫った","せまった"],["。"]]},{"verse":5,"text":"預言者シェマヤが、シシャクのことでエルサレムに集まっているレハブアムとユダの将軍たちのところに来て言った。「主はこう言われる。『あなたたちはわたしを捨てた。わたしもあなたたちを捨て、シシャクの手に渡す。』」","tok":[["預言者","よげんしゃ"],["シェマヤ"],["が"],["、"],["シシャク"],["の"],["こと"],["で"],["エルサレム"],["に"],["集まって","あつまって"],["いる"],["レハブアム"],["と"],["ユダ"],["の"],["将軍","しょうぐん"],["たち"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["あなた"],["たち"],["は"],["わたし"],["を"],["捨てた","すてた"],["。"],["わたし"],["も"],["あなた"],["たち"],["を"],["捨て","すて"],["、"],["シシャク"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["』"],["」"]]},{"verse":6,"text":"イスラエルの将軍たちは王と共にへりくだって言った。「主は正しい。」","tok":[["イスラエル"],["の"],["将軍","しょうぐん"],["たち"],["は"],["王","おう"],["と"],["共","とも"],["に"],["へりくだって"],["言った","いった"],["。"],["「"],["
[{"verse":1,"text":"ソロモンは、二十年を費やして主の神殿と王宮を建て終わると、","tok":[["ソロモン"],["は"],["、"],["二十","にじゅう"],["年","ねん"],["を"],["費やして","ついやして"],["主","ぬし"],["の"],["神殿","しんでん"],["と"],["王宮","おうきゅう"],["を"],["建て","たて"],["終わる","おわる"],["と"],["、"]]},{"verse":2,"text":"フラムから贈られた町を次々と再建し、そこにイスラエル人を住まわせた。","tok":[["フラム"],["から"],["贈られた","おくられた"],["町","まち"],["を"],["次々","つぎつぎ"],["と"],["再建","さいけん"],["し"],["、"],["そこ"],["に"],["イスラエル"],["人","にん"],["を"],["住まわせた","すまわせた"],["。"]]},{"verse":3,"text":"ソロモンは更にハマト‧ツォバに向かい、これを攻略し、","tok":[["ソロモン"],["は"],["更に","さらに"],["ハマト"],["‧"],["ツォバ"],["に"],["向かい","むかい"],["、"],["これ"],["を"],["攻略","こうりゃく"],["し"],["、"]]},{"verse":4,"text":"荒れ野のタドモルと、ハマト地方の補給基地の町をすべて築き上げた。","tok":[["荒れ野","あれの"],["の"],["タドモル"],["と"],["、"],["ハマト"],["地方","ちほう"],["の"],["補給","ほきゅう"],["基地","きち"],["の"],["町","まち"],["を"],["すべて"],["築き上げた","きずきあげた"],["。"]]},{"verse":5,"text":"彼はまた城壁で囲まれ、門扉とかんぬきで固められた砦の町、上ベト‧ホロンと下ベト‧ホロンを築き、","tok":[["彼","かれ"],["は"],["また"],["城壁","じょうへき"],["で"],["囲まれ","かこまれ"],["、"],["門扉","もんぴ"],["と"],["かんぬき"],["で"],["固められた","かためられた"],["砦","とりで"],["の"],["町","まち"],["、"],["上","うえ"],["ベト"],["‧"],["ホロン"],["と"],["下","した"],["ベト"],["‧"],["ホロン"],["を"],["築き","きずき"],["、"]]},{"verse":6,"text":"更にバアラトと、ソロモンに属する補給基地の町、戦車隊の町、騎兵隊の町をすべて築いた。ソロモンはエルサレム、レバノン、および彼の支配下にある全地域に、築こうと望んだ町々をすべて築き上げた。","tok":[["更に","さらに"],["バアラト"],["と"],["、"],["ソロモン"],["に"],["属する","ぞくする"],["補給","ほきゅう"],["基地","きち"],["の"],["町","まち"],["、"],["戦車隊","せんしゃたい"],["の"],["町","まち"],["、"],["騎兵隊","きへいたい"],["の"],["町","まち"],["を"],["すべて"],["築いた","きずいた"],["。"],["ソロモン"],["は"],["エルサレム"],["、"],["レバノン"],["、"],["および"],["彼","かれ"],["の"],["支配下","しはいか"],["に"],["ある"],["全","ぜん"],["地域","ちいき"],["に"],["、"],["築こう","きずこう"],["と"],["望んだ","のぞんだ"],["町々","まちまち"],["を"],["すべて"],["築き上げた","きずきあげた"],["。"]]},{"verse":7,"text":"イスラエル人ではない者、ヘト人、アモリ人、ペリジ人、ヒビ人、エブス人の生き残りの民のすべて、","tok":[["イスラエル"],["人","にん"],["で"],["は"],["ない"],["者","もの"],["、"],["ヘト人","へとにん"],["、"],["アモリ人","あもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["生き残り","いきのこり"],["の"],["民","たみ"
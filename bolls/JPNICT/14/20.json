[{"verse":1,"text":"その後、モアブ人とアンモン人が、メウニム人の一部と共にヨシャファトに戦いを挑んだ。","tok":[["その"],["後","ご"],["、"],["モアブ人","もあぶにん"],["と"],["アンモン"],["人","にん"],["が"],["、"],["メウニム"],["人","にん"],["の"],["一部","いちぶ"],["と"],["共","とも"],["に"],["ヨシャファト"],["に"],["戦い","たたかい"],["を"],["挑んだ","いどんだ"],["。"]]},{"verse":2,"text":"人々が来て、ヨシャファトに、「死海のかなたのエドムから大軍が攻めて来て、ハツェツォン‧タマル、つまりエン‧ゲディにいます」と告げると、","tok":[["人々","ひとびと"],["が"],["来て","きて"],["、"],["ヨシャファト"],["に"],["、"],["「"],["死海","しかい"],["の"],["かなた"],["の"],["エドム"],["から"],["大軍","たいぐん"],["が"],["攻めて","せめて"],["来て","きて"],["、"],["ハツェツォン"],["‧"],["タマル"],["、"],["つまり"],["エン"],["‧"],["ゲディ"],["に"],["います"],["」"],["と"],["告げる","つげる"],["と"],["、"]]},{"verse":3,"text":"ヨシャファトは恐れ、主を求めることを決意し、ユダのすべての人々に断食を呼びかけた。","tok":[["ヨシャファト"],["は"],["恐れ","おそれ"],["、"],["主","ぬし"],["を"],["求める","もとめる"],["こと"],["を"],["決意","けつい"],["し"],["、"],["ユダ"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["断食","だんじき"],["を"],["呼びかけた","よびかけた"],["。"]]},{"verse":4,"text":"ユダの人々は主を求めて集まった。ユダのすべての町から人々が主を求めて集まって来た。","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["主","ぬし"],["を"],["求めて","もとめて"],["集まった","あつまった"],["。"],["ユダ"],["の"],["すべて"],["の"],["町","まち"],["から"],["人々","ひとびと"],["が"],["主","ぬし"],["を"],["求めて","もとめて"],["集まって","あつまって"],["来た","きた"],["。"]]},{"verse":5,"text":"ヨシャファトは主の神殿の新しい庭の前でユダおよびエルサレムの会衆の中に立ち、","tok":[["ヨシャファト"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["新しい","あたらしい"],["庭","にわ"],["の"],["前","まえ"],["で"],["ユダ"],["および"],["エルサレム"],["の"],["会衆","かいしゅう"],["の"],["中","なか"],["に"],["立ち","たち"],["、"]]},{"verse":6,"text":"こう祈った。「わたしたちの先祖の神、主よ。あなたは天にいます神、異邦人の国をすべて支配しておられる方ではありませんか。御手には力と勢いがあり、あなたに立ち向かうことのできる者はいません。","tok":[["こう"],["祈った","いのった"],["。"],["「"],["わたしたち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["天","てん"],["に"],["います"],["神","かみ"],["、"],["異邦人","いほうじん"],["の"],["国","くに"],["を"],["すべて"],["支配","しはい"],["して"],["おられる"],["方","かた"],["で"],["は"],["ありません"],["か"],["。"],["御手","おて"],["に"],["は"],["力","ちから"],["と"],["勢い","いきおい"],["が"],["あり"],["、"],["あなた"],["に"],["立ち向かう","たちむかう"],["こと"],["の"],["できる"],["者","もの"],["は"],["いません"],["。"]]},{"verse":7,"text":"わたしたちの神よ、あなたはあなたの民イスラエルの前からこの地の先住民を追い払い、この地をあなたの友アブラハムの子孫にとこしえにお与えになったではありませんか。","tok":[["わたしたち"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["あなた"],["の"],["民","みん"],["イスラエル"],["の"],["前","まえ"],["から"],["この"],["地","ち"],["の"],["先住民","せんじゅうみん"],["を"],["追い払い","おいはらい"],["、"],["この"],["地","ち"],["を"],["あなた"],["の"],["友","とも"],["アブラハム"],["の"],["子孫","しそん"],["に"],["とこしえ"],["に"],["お与え","おあたえ"],["に"],["なったで"],["は"],["ありません"],["か"],["。"]]},{"verse":8,"text":"彼らはここに住み、ここにあなたの御名のために聖所を建てて言いました。","tok":[["彼","かれ"],["ら"],["は"],["ここ"],["に"],["住み","すみ"],["、"],["ここ"],["に"],["あなた"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["聖","せい"],["所","しょ"],["を"],["建てて","たてて"],["言いました","いいました"],["。"]]},{"verse":9,"text":"もしわたしたちが裁きとして剣、疫病、飢饉などの災いに襲われたなら、この神殿にこそ御名がとどめられているのですから、この神殿の前で御前に立ち、苦悩の中からあなたに助けを求めて叫びます。あなたはそれに耳を傾け、救ってください。","tok":[["もし"],["わたしたち"],["が"],["裁き","さばき"],["として"],["剣","けん"],["、"],["疫病","やくびょう"],["、"],["飢饉","ききん"],["など"],["の"],["災い","わざわい"],["に"],["襲われたなら","おそわれたなら"],["、"],["この"],["神殿","しんでん"],["に"],["こそ"],["御名","ぎょめい"],["が"],["とどめられて"],["いる"],["の"],["です"],["から"],["、"],["この"],["神殿","しんでん"],["の"],["前","まえ"],["で"],["御前","ごぜん"],["に"],["立ち","たち"],["、"],["苦悩","くのう"],["の"],["中","なか"],["から"],["あなた"],["に"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫びます","さけびます"],["。"],["あなた"],["は"],["それ"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["救って","すくって"],["ください"],["。"]]},{"verse":10,"text":"今、アンモン人、モアブ人、セイルの山の人々を見てください。かつてイスラエル人がエジプトの地から出て来たとき、あなたは彼らの土地に入って行くことをお許しになりませんでした。そのためイスラエル人は、彼らを避け、滅ぼさずにおきました。","tok":[["今","いま"],["、"],["アンモン"],["人","にん"],["、"],["モアブ人","もあぶにん"],["、"],["セイル"],["の"],["山","やま"],["の"],["人々","ひとびと"],["を"],["見て","みて"],["ください"],["。"],["かつて"],["イスラエル"],["人","にん"],["が"],["エジプト"],["の"],["地","ち"],["から"],["出て","でて"],["来た","きた"],["とき"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["土地","とち"],["に"],["入って","はいって"],["行く","いく"],["こと"],["を"],["お許し","おゆるし"],["に"],["なりませんでした"],["。"],["その"],["ため"],["イスラエル"],["人","にん"],["は"],["、"],["彼","かれ"],["ら"],["を"],["避け","さけ"],["、"],["滅ぼさず","ほろぼさず"],["に"],["おきました"],["。"]]},{"verse":11,"text":"御覧のように、今彼らはわたしたちに報いて、あなたがわたしたちにお与えになったこの土地から、わたしたちを追い出そうと攻めて来たのです。","tok":[["御覧","ごらん"],["の"],["よう"],["に"],["、"],["今","いま"],["彼","かれ"],["ら"],["は"],["わたしたち"],["に"],["報いて","むくいて"],["、"],["あなた"],["が"],["わたしたち"],["に"],["お与え","おあたえ"],["に"],["なった"],["この"],["土地","とち"],["から"],["、"],["わたしたち"],["を"],["追い出そう","おいだそう"],["と"],["攻めて","せめて"],["来た","きた"],["の"],["です"],["。"]]},{"verse":12,"text":"わたしたちの神よ、彼らをお裁きにならないのですか。わたしたちには、攻めて来るこの大軍を迎え撃つ力はなく、何をなすべきか分からず、ただあなたを仰ぐことしかできません。」","tok":[["わたしたち"],["の"],["神","かみ"],["よ"],["、"],["彼","かれ"],["ら"],["を"],["お裁き","おさばき"],["に"],["ならない"],["の"],["です"],["か"],["。"],["わたしたち"],["に"],["は"],["、"],["攻めて","せめて"],["来る","くる"],["この"],["大軍","たいぐん"],["を"],["迎え撃つ","むかえうつ"],["力","ちから"],["は"],["なく"],["、"],["何","なん"],["を"],["なすべき"],["か"],["分からず","わからず"],["、"],["ただ"],["あなた"],["を"],["仰ぐ","あおぐ"],["こと"],["しか"],["できません"],["。"],["」"]]},{"verse":13,"text":"ユダのすべての人々がその幼子も、妻も、息子と共に主の御前に立っていた。","tok":[["ユダ"],["の"],["すべて"],["の"],["人々","ひとびと"],["が"],["その"],["幼子","おさなご"],["も"],["、"],["妻","つま"],["も"],["、"],["息子","むすこ"],["と"],["共","とも"],["に"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":14,"text":"その会衆の中で、アサフの子孫のレビ人ヤハジエルに主の霊が臨んだ。ヤハジエルの父はゼカルヤ、祖父はベナヤ、更にエイエル、マタンヤとさかのぼる。","tok":[["その"],["会衆","かいしゅう"],["の"],["中","なか"],["で"],["、"],["アサフ"],["の"],["子孫","しそん"],["の"],["レビ人","れびにん"],["ヤハジエル"],["に"],["主","ぬし"],["の"],["霊","れい"],["が"],["臨んだ","のぞんだ"],["。"],["ヤハジエル"],["の"],["父","ちち"],["は"],["ゼカルヤ"],["、"],["祖父","そふ"],["は"],["ベナヤ"],["、"],["更に","さらに"],["エイエル"],["、"],["マタンヤ"],["と"],["さかのぼる"],["。"]]},{"verse":15,"text":"彼は言った。「すべてのユダよ、エルサレムの住民とヨシャファト王よ、よく聞け。主はあなたたちにこう言われる。『この大軍を前にしても恐れるな。おじけるな。これはあなたたちの戦いではなく、神の戦いである。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["すべて"],["の"],["ユダ"],["よ"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["と"],["ヨシャファト"],["王","おう"],["よ"],["、"],["よく"],["聞け","きけ"],["。"],["主","ぬし"],["は"],["あなた"],["たち"],["に"],["こう"],["言われる","いわれる"],["。"],["『"],["この"],["大軍","たいぐん"],["を"],["前","まえ"],["に"],["して"],["も"],["恐れる","おそれる"],["な"],["。"],["おじける"],["な"],["。"],["これ"],["は"],["あなた"],["たち"],["の"],["戦い","たたかい"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["戦い","たたかい"],["で"],["ある"],["。"]]},{"verse":16,"text":"明日敵に向かって攻め下れ。見よ、彼らはツィツの坂を上って来る。あなたたちはエルエルの荒れ野の前、谷の出口で彼らに会う。","tok":[["明日","あす"],["敵","てき"],["に"],["向かって","むかって"],["攻め下れ","せめくだれ"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["ツィツ"],["の"],["坂","さか"],["を"],["上って","のぼって"],["来る","くる"],["。"],["あなた"],["たち"],["は"],["エルエル"],["の"],["荒れ野","あれの"],["の"],["前","まえ"],["、"],["谷","たに"],["の"],["出口","でぐち"],["で"],["彼","かれ"],["ら"],["に"],["会う","あう"],["。"]]},{"verse":17,"text":"そのときあなたたちが戦う必要はない。堅く立って、主があなたたちを救うのを見よ。ユダとエルサレムの人々よ、恐れるな。おじけるな。明日敵に向かって出て行け。主が共にいる。』」","tok":[["その"],["とき"],["あなた"],["たち"],["が"],["戦う","たたかう"],["必要","ひつよう"],["は"],["ない"],["。"],["堅く","かたく"],["立って","たって"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["を"],["救う","すくう"],["の"],["を"],["見よ","みよ"],["。"],["ユダ"],["と"],["エルサレム"],["の"],["人々","ひとびと"],["よ"],["、"],["恐れる","おそれる"],["な"],["。"],["おじける"],["な"],["。"],["明日","あす"],["敵","てき"],["に"],["向かって","むかって"],["出て","でて"],["行け","いけ"],["。"],["主","ぬし"],["が"],["共","とも"],["に"],["いる"],["。"],["』"],["」"]]},{"verse":18,"text":"ヨシャファトは地にひれ伏し、すべてのユダとエルサレムの住民も主の御前に伏して、主を礼拝した。","tok":[["ヨシャファト"],["は"],["地","ち"],["に"],["ひれ伏し","ひれふし"],["、"],["すべて"],["の"],["ユダ"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["も"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["伏して","ふして"],["、"],["主","ぬし"],["を"],["礼拝","れいはい"],["した"],["。"]]},{"verse":19,"text":"レビ人のケハトの子孫とコラの子孫は立ち上がり、大声を張り上げてイスラエルの神、主を賛美した。","tok":[["レビ人","れびにん"],["の"],["ケハト"],["の"],["子孫","しそん"],["と"],["コラ"],["の"],["子孫","しそん"],["は"],["立ち上がり","たちあがり"],["、"],["大声","おおごえ"],["を"],["張り上げて","はりあげて"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["賛美","さんび"],["した"],["。"]]},{"verse":20,"text":"翌朝早く、彼らはテコアの荒れ野に向かって出て行った。出て行くとき、ヨシャファトは立って言った。「ユダとエルサレムの住民よ、聞け。あなたたちの神、主に信頼せよ。そうすればあなたたちは確かに生かされる。またその預言者に信頼せよ。そうすれば勝利を得ることができる。」","tok":[["翌朝","よくあさ"],["早く","はやく"],["、"],["彼","かれ"],["ら"],["は"],["テコア"],["の"],["荒れ野","あれの"],["に"],["向かって","むかって"],["出て","でて"],["行った","いった"],["。"],["出て","でて"],["行く","いく"],["とき"],["、"],["ヨシャファト"],["は"],["立って","たって"],["言った","いった"],["。"],["「"],["ユダ"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["よ"],["、"],["聞け","きけ"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["信頼","しんらい"],["せよ"],["。"],["そう"],["すれば"],["あなた"],["たち"],["は"],["確か","たしか"],["に"],["生かされる","いかされる"],["。"],["また"],["その"],["預言者","よげんしゃ"],["に"],["信頼","しんらい"],["せよ"],["。"],["そう"],["すれば"],["勝利","しょうり"],["を"],["得る","える"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":21,"text":"彼は民と協議したうえで、主に向かって歌をうたい、主の聖なる輝きをたたえる者たちを任命し、彼らに軍隊の先頭を進ませ、こう言わせた。「主に感謝せよ、その慈しみはとこしえに。」","tok":[["彼","かれ"],["は"],["民","みん"],["と"],["協議","きょうぎ"],["した"],["うえ"],["で"],["、"],["主に","おもに"],["向かって","むかって"],["歌","うた"],["を"],["うたい"],["、"],["主","ぬし"],["の"],["聖","せい"],["なる"],["輝き","かがやき"],["を"],["たたえる"],["者","もの"],["たち"],["を"],["任命","にんめい"],["し"],["、"],["彼","かれ"],["ら"],["に"],["軍隊","ぐんたい"],["の"],["先頭","せんとう"],["を"],["進ませ","すすませ"],["、"],["こう"],["言わせた","いわせた"],["。"],["「"],["主に","おもに"],["感謝","かんしゃ"],["せよ"],["、"],["その"],["慈しみ","いつくしみ"],["は"],["とこしえ"],["に"],["。"],["」"]]},{"verse":22,"text":"彼らが喜びと賛美の歌をうたい始めると、主はユダに攻め込んできたアンモン人、モアブ人、セイルの山の人々に伏兵を向けられたので、彼らは敗れた。","tok":[["彼","かれ"],["ら"],["が"],["喜び","よろこび"],["と"],["賛美","さんび"],["の"],["歌","うた"],["を"],["うたい"],["始める","はじめる"],["と"],["、"],["主","ぬし"],["は"],["ユダ"],["に"],["攻め込んで","せめこんで"],["きた"],["アンモン"],["人","にん"],["、"],["モアブ人","もあぶにん"],["、"],["セイル"],["の"],["山","やま"],["の"],["人々","ひとびと"],["に"],["伏兵","ふくへい"],["を"],["向けられた","むけられた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["敗れた","やぶれた"],["。"]]},{"verse":23,"text":"するとアンモン人とモアブ人は、セイルの山の住民に立ち向かい、一人残らず討って、全滅させた。セイルの住民を絶やすと、彼らは互いに戦って自滅した。","tok":[["する"],["と"],["アンモン"],["人","にん"],["と"],["モアブ人","もあぶにん"],["は"],["、"],["セイル"],["の"],["山","やま"],["の"],["住民","じゅうみん"],["に"],["立ち向かい","たちむかい"],["、"],["一人","ひとり"],["残らず","のこらず"],["討って","うって"],["、"],["全滅","ぜんめつ"],["させた"],["。"],["セイル"],["の"],["住民","じゅうみん"],["を"],["絶やす","たやす"],["と"],["、"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["戦って","たたかって"],["自滅","じめつ"],["した"],["。"]]},{"verse":24,"text":"ユダの人々が荒れ野を見渡せる所に来て、大軍のいた方を向くと、その地には死体が横たわり、生き残った者は一人もなかった。","tok":[["ユダ"],["の"],["人々","ひとびと"],["が"],["荒れ野","あれの"],["を"],["見渡せる","みわたせる"],["所","ところ"],["に"],["来て","きて"],["、"],["大軍","たいぐん"],["の"],["いた"],["方","ほう"],["を"],["向く","むく"],["と"],["、"],["その"],["地","ち"],["に"],["は"],["死体","したい"],["が"],["横たわり","よこたわり"],["、"],["生き残った","いきのこった"],["者","もの"],["は"],["一人","ひとり"],["も"],["なかった"],["。"]]},{"verse":25,"text":"ヨシャファトと軍隊は戦利品を奪うために来て、多くの家畜、装備、衣類、宝物を見つけ、運ぶことができなくなるまで取り去った。戦利品は多く、それを奪い去るのに三日かかった。","tok":[["ヨシャファト"],["と"],["軍隊","ぐんたい"],["は"],["戦利品","せんりひん"],["を"],["奪う","うばう"],["ため"],["に"],["来て","きて"],["、"],["多く","おおく"],["の"],["家畜","かちく"],["、"],["装備","そうび"],["、"],["衣類","いるい"],["、"],["宝物","ほうもつ"],["を"],["見つけ","みつけ"],["、"],["運ぶ","はこぶ"],["こと"],["が"],["できなく"],["なる"],["まで"],["取り去った","とりさった"],["。"],["戦利品","せんりひん"],["は"],["多く","おおく"],["、"],["それ"],["を"],["奪い去る","うばいさる"],["のに"],["三","さん"],["日","にち"],["かかった"],["。"]]},{"verse":26,"text":"四日目に、彼らはベラカの谷に集まった。そこで主をたたえたので、その地名はベラカ（たたえること）の谷と呼ばれ、今日に至っている。","tok":[["四日目","よんかめ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["ベラカ"],["の"],["谷","たに"],["に"],["集まった","あつまった"],["。"],["そこ"],["で"],["主","ぬし"],["を"],["たたえた"],["ので"],["、"],["その"],["地名","ちめい"],["は"],["ベラカ"],["（"],["たたえる"],["こと"],["）"],["の"],["谷","たに"],["と"],["呼ばれ","よばれ"],["、"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":27,"text":"ユダとエルサレムの人々は皆、ヨシャファトを先頭にして喜び祝いながらエルサレムに帰った。主が敵を破って、彼らに喜びを与えられたからである。","tok":[["ユダ"],["と"],["エルサレム"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["ヨシャファト"],["を"],["先頭","せんとう"],["に"],["して"],["喜び祝い","よろこびいわい"],["ながら"],["エルサレム"],["に"],["帰った","かえった"],["。"],["主","ぬし"],["が"],["敵","てき"],["を"],["破って","やぶって"],["、"],["彼","かれ"],["ら"],["に"],["喜び","よろこび"],["を"],["与えられた","あたえられた"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"彼らは琴と竪琴を奏で、ラッパを吹き鳴らして、エルサレムの主の神殿に入った。","tok":[["彼","かれ"],["ら"],["は"],["琴","こと"],["と"],["竪琴","たてごと"],["を"],["奏で","かなで"],["、"],["ラッパ"],["を"],["吹き鳴らして","ふきならして"],["、"],["エルサレム"],["の"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["入った","はいった"],["。"]]},{"verse":29,"text":"主がイスラエルの敵と戦われたということを聞いて、地のすべての国がどこも神への恐れに襲われた。","tok":[["主","ぬし"],["が"],["イスラエル"],["の"],["敵","てき"],["と"],["戦われた","たたかわれた"],["と"],["いう"],["こと"],["を"],["聞いて","きいて"],["、"],["地","ち"],["の"],["すべて"],["の"],["国","くに"],["が"],["どこ"],["も"],["神","かみ"],["へ"],["の"],["恐れ","おそれ"],["に"],["襲われた","おそわれた"],["。"]]},{"verse":30,"text":"ヨシャファトの王国は平穏で、神は、周囲の者たちから彼を守って、安らぎを与えられた。","tok":[["ヨシャファト"],["の"],["王国","おうこく"],["は"],["平穏","へいおん"],["で"],["、"],["神","かみ"],["は"],["、"],["周囲","しゅうい"],["の"],["者","もの"],["たち"],["から"],["彼","かれ"],["を"],["守って","まもって"],["、"],["安らぎ","やすらぎ"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":31,"text":"ヨシャファトは三十五歳で王となり、ユダを治めた。彼は二十五年間エルサレムで王位にあった。その母は名をアズバと言い、シルヒの娘であった。","tok":[["ヨシャファト"],["は"],["三十五歳","さんじゅうごさい"],["で"],["王","おう"],["と"],["なり"],["、"],["ユダ"],["を"],["治めた","おさめた"],["。"],["彼","かれ"],["は"],["二十五","にじゅうご"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["アズバ"],["と"],["言い","いい"],["、"],["シルヒ"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":32,"text":"彼は父アサの道を歩み、それを離れず、主の目にかなう正しいことを行った。","tok":[["彼","かれ"],["は"],["父","ちち"],["アサ"],["の"],["道","みち"],["を"],["歩み","あゆみ"],["、"],["それ"],["を"],["離れず","はなれず"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["かなう"],["正しい","ただしい"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":33,"text":"しかし、聖なる高台は取り除かなかった。民はまだ先祖の神に揺るぎない心を向けてはいなかった。","tok":[["しかし"],["、"],["聖","せい"],["なる"],["高台","たかだい"],["は"],["取り除かなかった","とりのぞかなかった"],["。"],["民","たみ"],["は"],["まだ"],["先祖","せんぞ"],["の"],["神","かみ"],["に"],["揺るぎない","ゆるぎない"],["心","こころ"],["を"],["向けて","むけて"],["は"],["いなかった"],["。"]]},{"verse":34,"text":"ヨシャファトの他の事績は、初期のことも後期のことも、『ハナニの子イエフの言葉』に記されている。これは『イスラエルの列王の書』にも載せられている。","tok":[["ヨシャファト"],["の"],["他","ほか"],["の"],["事績","じせき"],["は"],["、"],["初期","しょき"],["の"],["こと"],["も"],["後期","こうき"],["の"],["こと"],["も"],["、"],["『"],["ハナニ"],["の"],["子","こ"],["イエフ"],["の"],["言葉","ことば"],["』"],["に"],["記されて","しるされて"],["いる"],["。"],["これ"],["は"],["『"],["イスラエル"],["の"],["列王","れつおう"],["の"],["書","しょ"],["』"],["に"],["も"],["載せられて","のせられて"],["いる"],["。"]]},{"verse":35,"text":"その後、ユダの王ヨシャファトはイスラエルの王アハズヤと協定を結んだ。この王は悪を行った。","tok":[["その"],["後","ご"],["、"],["ユダ"],["の"],["王","おう"],["ヨシャファト"],["は"],["イスラエル"],["の"],["王","おう"],["アハズヤ"],["と"],["協定","きょうてい"],["を"],["結んだ","むすんだ"],["。"],["この"],["王","おう"],["は"],["悪","あく"],["を"],["行った","おこなった"],["。"]]},{"verse":36,"text":"彼らはタルシシュ行きの船団を造るために協定を結び、エツヨン‧ゲベルで船団を造った。","tok":[["彼","かれ"],["ら"],["は"],["タルシシュ"],["行き","いき"],["の"],["船団","せんだん"],["を"],["造る","つくる"],["ため"],["に"],["協定","きょうてい"],["を"],["結び","むすび"],["、"],["エツヨン"],["‧"],["ゲベル"],["で"],["船団","せんだん"],["を"],["造った","つくった"],["。"]]},{"verse":37,"text":"そのとき、マレシャ出身のドダワフの子エリエゼルがヨシャファトに向かってこう預言した。「アハズヤと協定を結んだため、主はあなたの事業を打ち壊される。」こうして船は難破し、タルシシュに行くことは妨げられた。","tok":[["その"],["とき"],["、"],["マレシャ"],["出身","しゅっしん"],["の"],["ドダワフ"],["の"],["子","こ"],["エリエゼル"],["が"],["ヨシャファト"],["に"],["向かって","むかって"],["こう"],["預言","よげん"],["した"],["。"],["「"],["アハズヤ"],["と"],["協定","きょうてい"],["を"],["結んだ","むすんだ"],["ため"],["、"],["主","ぬし"],["は"],["あなた"],["の"],["事業","じぎょう"],["を"],["打ち壊される","ぶちこわされる"],["。"],["」"],["こう"],["して"],["船","ふね"],["は"],["難破","なんぱ"],["し"],["、"],["タルシシュ"],["に"],["行く","いく"],["こと"],["は"],["妨げられた","さまたげられた"],["。"]]}]
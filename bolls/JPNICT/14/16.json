[{"verse":1,"text":"アサの治世第三十六年に、イスラエルの王バシャはユダに攻め上って来て、ラマに砦を築き、ユダの王アサの動きを封じようとした。","tok":[["アサ"],["の"],["治世","ちせい"],["第","だい"],["三十六","さんじゅうろく"],["年","ねん"],["に"],["、"],["イスラエル"],["の"],["王","おう"],["バシャ"],["は"],["ユダ"],["に"],["攻め上って","せめのぼって"],["来て","きて"],["、"],["ラマ"],["に"],["砦","とりで"],["を"],["築き","きずき"],["、"],["ユダ"],["の"],["王","おう"],["アサ"],["の"],["動き","うごき"],["を"],["封じよう","ふうじよう"],["と"],["した"],["。"]]},{"verse":2,"text":"アサは主の神殿と王宮の宝物庫から銀と金を取り出し、ダマスコに座を置くアラムの王ベン‧ハダドに贈って言った。","tok":[["アサ"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["と"],["王宮","おうきゅう"],["の"],["宝物庫","ほうもつこ"],["から"],["銀","ぎん"],["と"],["金","かね"],["を"],["取り出し","とりだし"],["、"],["ダマスコ"],["に"],["座","ざ"],["を"],["置く","おく"],["アラム"],["の"],["王","おう"],["ベン"],["‧"],["ハダド"],["に"],["贈って","おくって"],["言った","いった"],["。"]]},{"verse":3,"text":"「わたしとあなた、わたしの父とあなたの父との間には同盟が結ばれています。わたしはここに銀と金をあなたにお届けします。イスラエルの王バシャとの同盟を直ちに破棄し、彼をわたしから離れ去らせてください。」","tok":[["「"],["わたし"],["と"],["あなた"],["、"],["わたし"],["の"],["父","ちち"],["と"],["あなた"],["の"],["父","ちち"],["と"],["の"],["間","あいだ"],["に"],["は"],["同盟","どうめい"],["が"],["結ばれて","むすばれて"],["います"],["。"],["わたし"],["は"],["ここ"],["に"],["銀","ぎん"],["と"],["金","かね"],["を"],["あなた"],["に"],["お届け","おとどけ"],["します"],["。"],["イスラエル"],["の"],["王","おう"],["バシャ"],["と"],["の"],["同盟","どうめい"],["を"],["直ちに","ただちに"],["破棄","はき"],["し"],["、"],["彼","かれ"],["を"],["わたし"],["から"],["離れ去らせて","はなれさらせて"],["ください"],["。"],["」"]]},{"verse":4,"text":"ベン‧ハダドはアサ王の願いを入れ、配下の軍の長たちをイスラエルの町々に送り、イヨン、ダン、アベル‧マイムおよびナフタリの町のすべての補給基地を攻略させた。","tok":[["ベン"],["‧"],["ハダド"],["は"],["アサ"],["王","おう"],["の"],["願い","ねがい"],["を"],["入れ","いれ"],["、"],["配下","はいか"],["の"],["軍","ぐん"],["の"],["長","なが"],["たち"],["を"],["イスラエル"],["の"],["町々","まちまち"],["に"],["送り","おくり"],["、"],["イヨン"],["、"],["ダン"],["、"],["アベル"],["‧"],["マイム"],["および"],["ナフタリ"],["の"],["町","まち"],["の"],["すべて"],["の"],["補給","ほきゅう"],["基地","きち"],["を"],["攻略","こうりゃく"],["させた"],["。"]]},{"verse":5,"text":"バシャはこれを聞くと、ラマの構築をやめ、その作業を中止した。","tok":[["バシャ"],["は"],["これ"],["を"],["聞く","きく"],["と"],["、"],["ラマ"],["の"],["構築","こうちく"],["を"],["やめ"],["、"],["その"],["作業","さぎょう"],["を"],["中止","ちゅうし"],["した"],["。"]]},{"verse":6,"text":"アサ王はユダの人々を総動員して、バシャがラマ構築に用いた石材と木材を運んで来させ、それを用いて、ゲバとミツパに砦を築いた。","tok":[["アサ"],["王","おう"],["は"],["ユダ"],["の"],["人々","ひとびと"],["を"],["総動員","そうどういん"],["して"],["、"],["バシャ"],["が"],["ラマ"],["構築","こうちく"],["に"],["用いた","もちいた"],["石材","せきざい"],["と"],["木材","もくざい"],["を"],["運んで","はこんで"],["来させ","きさせ"],["、"],["それ"],["を"],["用いて","もちいて"],["、"],["ゲバ"],["と"],["ミツパ"],["に"],["砦","とりで"],["を"],["築いた","きずいた"],["。"]]},{"verse":7,"text":"そのとき、先見者ハナニがユダの王アサのもとに来て言った。「あなたはアラム王を頼みとし、あなたの神、主を頼みとしなかった。それゆえ、アラムの王の軍隊はあなたの支配を離れる。","tok":[["その"],["とき"],["、"],["先見者","せんけんしゃ"],["ハナニ"],["が"],["ユダ"],["の"],["王","おう"],["アサ"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["アラム"],["王","おう"],["を"],["頼み","たのみ"],["と"],["し"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["頼み","たのみ"],["と"],["しなかった"],["。"],["それ"],["ゆえ"],["、"],["アラム"],["の"],["王","おう"],["の"],["軍隊","ぐんたい"],["は"],["あなた"],["の"],["支配","しはい"],["を"],["離れる","はなれる"],["。"]]},{"verse":8,"text":"クシュ人とリビア人は非常に多くの戦車と騎兵を有する大きな軍隊であったが、あなたが主を頼みとしたので、主は彼らをあなたの手に渡されたではないか。","tok":[["クシュ人","くしゅにん"],["と"],["リビア人","りびあにん"],["は"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["を"],["有する","ゆうする"],["大きな","おおきな"],["軍隊","ぐんたい"],["で"],["あった"],["が"],["、"],["あなた"],["が"],["主","ぬし"],["を"],["頼み","たのみ"],["と"],["した"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["手","て"],["に"],["渡されたで","わたされたで"],["は"],["ない"],["か"],["。"]]},{"verse":9,"text":"主は世界中至るところを見渡され、御自分と心を一つにする者を力づけようとしておられる。この事について、あなたは愚かだった。今後、あなたには戦争が続く。」","tok":[["主","ぬし"],["は"],["世界中","せかいじゅう"],["至る","いたる"],["ところ"],["を"],["見渡され","みわたされ"],["、"],["御自分","ごじぶん"],["と"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["する"],["者","もの"],["を"],["力づけよう","ちからづけよう"],["として"],["おられる"],["。"],["この"],["事","こと"],["について"],["、"],["あなた"],["は"],["愚か","おろか"],["だった"],["。"],["今後","こんご"],["、"],["あなた"],["に"],["は"],["戦争","せんそう"],["が"],["続く","つづく"],["。"],["」"]]},{"verse":10,"text":"アサは先見者のこの言葉を聞いて怒り、彼を獄に投じた。この事で彼に対して激しく怒ったからである。またアサはそのとき、民の中のある者たちを虐待した。","tok":[["アサ"],["は"],["先見者","せんけんしゃ"],["の"],["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["怒り","おこり"],["、"],["彼","かれ"],["を"],["獄","ごく"],["に"],["投じた","とうじた"],["。"],["この"],["事","こと"],["で"],["彼","かれ"],["に対して","にたいして"],["激しく","はげしく"],["怒った","おこった"],["から"],["で"],["ある"],["。"],["また"],["アサ"],["は"],["その"],["とき"],["、"],["民","みん"],["の"],["中","なか"],["の"],["ある"],["者","もの"],["たち"],["を"],["虐待","ぎゃくたい"],["した"],["。"]]},{"verse":11,"text":"アサの事績は、初期のことも後期のことも、『ユダとイスラエルの列王の書』に記されている。","tok":[["アサ"],["の"],["事績","じせき"],["は"],["、"],["初期","しょき"],["の"],["こと"],["も"],["後期","こうき"],["の"],["こと"],["も"],["、"],["『"],["ユダ"],["と"],["イスラエル"],["の"],["列王","れつおう"],["の"],["書","しょ"],["』"],["に"],["記されて","しるされて"],["いる"],["。"]]},{"verse":12,"text":"アサはその治世第三十九年に足の病にかかり、その病は極めて重かった。その病の中にあっても、彼は主を求めず、医者に頼った。","tok":[["アサ"],["は"],["その"],["治世","ちせい"],["第","だい"],["三十九","さんじゅうきゅう"],["年","ねん"],["に"],["足","あし"],["の"],["病","やまい"],["に"],["かかり"],["、"],["その"],["病","やまい"],["は"],["極めて","きわめて"],["重かった","おもかった"],["。"],["その"],["病","やまい"],["の"],["中","なか"],["に"],["あって"],["も"],["、"],["彼","かれ"],["は"],["主","ぬし"],["を"],["求めず","もとめず"],["、"],["医者","いしゃ"],["に"],["頼った","たよった"],["。"]]},{"verse":13,"text":"アサはその治世第四十一年に先祖と共に眠りにつき、死んだ。","tok":[["アサ"],["は"],["その"],["治世","ちせい"],["第","だい"],["四十一","よんじゅういち"],["年","ねん"],["に"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠り","ねむり"],["に"],["つき"],["、"],["死んだ","しんだ"],["。"]]},{"verse":14,"text":"彼はダビデの町に掘っておいた墓に葬られた。人々は特別な技術で混ぜ合わせた種々の香料の満ちた棺に彼を納め、また彼のために非常に大きな火をたいた。","tok":[["彼","かれ"],["は"],["ダビデ"],["の"],["町","まち"],["に"],["掘って","ほって"],["おいた"],["墓","はか"],["に"],["葬られた","ほうむられた"],["。"],["人々","ひとびと"],["は"],["特別","とくべつ"],["な"],["技術","ぎじゅつ"],["で"],["混ぜ合わせた","まぜあわせた"],["種々","しゅじゅ"],["の"],["香料","こうりょう"],["の"],["満ちた","みちた"],["棺","ひつぎ"],["に"],["彼","かれ"],["を"],["納め","おさめ"],["、"],["また"],["彼","かれ"],["の"],["ため"],["に"],["非常","ひじょう"],["に"],["大きな","おおきな"],["火","ひ"],["を"],["たいた"],["。"]]}]
ュロスの心を動かされた。キュロスは文書にも記して、国中に次のような布告を行き渡らせた。","tok":[["ペルシア"],["の"],["王","おう"],["キュロス"],["の"],["第","だい"],["一","いち"],["年","ねん"],["の"],["こと"],["で"],["ある"],["。"],["主","ぬし"],["は"],["かつて"],["エレミヤ"],["の"],["口","くち"],["を"],["通して","とおして"],["約束","やくそく"],["された"],["こと"],["を"],["成就","じょうじゅ"],["する"],["ため"],["、"],["ペルシア"],["の"],["王","おう"],["キュロス"],["の"],["心","こころ"],["を"],["動かされた","うごかされた"],["。"],["キュロス"],["は"],["文書","ぶんしょ"],["に"],["も"],["記して","しるして"],["、"],["国中","くにちゅう"],["に"],["次","つぎ"],["の"],["よう"],["な"],["布告","ふこく"],["を"],["行き","いき"],["渡らせた","わたらせた"],["。"]]},{"verse":23,"text":"「ペルシアの王キュロスはこう言う。天にいます神、主は、地上のすべての国をわたしに賜った。この主がユダのエルサレムに御自分の神殿を建てることをわたしに命じられた。あなたたちの中で主の民に属する者はだれでも、上って行くがよい。神なる主がその者と共にいてくださるように。」","tok":[["「"],["ペルシア"],["の"],["王","おう"],["キュロス"],["は"],["こう"],["言う","ゆう"],["。"],["天","てん"],["に"],["います"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["地上","ちじょう"],["の"],["すべて"],["の"],["国","くに"],["を"],["わたし"],["に"],["賜った","たまわった"],["。"],["この"],["主","ぬし"],["が"],["ユダ"],["の"],["エルサレム"],["に"],["御自分","ごじぶん"],["の"],["神殿","しんでん"],["を"],["建てる","たてる"],["こと"],["を"],["わたし"],["に"],["命じられた","めいじられた"],["。"],["あなた"],["たち"],["の"],["中","なか"],["で"],["主","ぬし"],["の"],["民","たみ"],["に"],["属する","ぞくする"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["上って","のぼって"],["行く","いく"],["が"],["よい"],["。"],["神","かみ"],["なる"],["主","ぬし"],["が"],["その"],["者","もの"],["と"],["共","とも"],["に"],["いて"],["くださる"],["よう"],["に"],["。"],["」"]]}]
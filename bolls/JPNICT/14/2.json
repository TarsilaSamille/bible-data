[{"verse":1,"text":"ソロモンは荷役の労働者七万人、山中で石を切り出す労働者八万人、その監督三千六百人を動員した。","tok":[["ソロモン"],["は"],["荷役","にやく"],["の"],["労働者","ろうどうしゃ"],["七万人","ななまんにん"],["、"],["山中","さんちゅう"],["で"],["石","いし"],["を"],["切り出す","きりだす"],["労働者","ろうどうしゃ"],["八万人","はちまんにん"],["、"],["その"],["監督","かんとく"],["三千六百","さんせんろくひゃく"],["人","にん"],["を"],["動員","どういん"],["した"],["。"]]},{"verse":2,"text":"彼はまたティルスの王フラムに使節を遣わして、こう言わせた。「あなたは、父ダビデに協力を惜しまず、父の住まいとなる王宮の建築のためにレバノン杉を送ってくださいました。","tok":[["彼","かれ"],["は"],["また"],["ティルス"],["の"],["王","おう"],["フラム"],["に"],["使節","しせつ"],["を"],["遣わして","つかわして"],["、"],["こう"],["言わせた","いわせた"],["。"],["「"],["あなた"],["は"],["、"],["父","ちち"],["ダビデ"],["に"],["協力","きょうりょく"],["を"],["惜しまず","おしまず"],["、"],["父","ちち"],["の"],["住まい","すまい"],["と"],["なる"],["王宮","おうきゅう"],["の"],["建築","けんちく"],["の"],["ため"],["に"],["レバノン"],["杉","すぎ"],["を"],["送って","おくって"],["くださいました"],["。"]]},{"verse":3,"text":"わたしはわが神なる主の御名のために神殿を建て、これを主のために聖別して、その御前に香草の香をたき、絶えずパンを供え、朝に夕に、安息日と新月祭、我らの神なる主の祝祭日に、焼き尽くす献げ物をささげ、この事がイスラエルにおいていつまでも守られるようにしようとしています。","tok":[["わたし"],["は"],["わが"],["神","かみ"],["なる"],["主","ぬし"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["建て","たて"],["、"],["これ"],["を"],["主","ぬし"],["の"],["ため"],["に"],["聖別","せいべつ"],["して"],["、"],["その"],["御前","ごぜん"],["に"],["香草","こうそう"],["の"],["香","こう"],["を"],["たき"],["、"],["絶えず","たえず"],["パン"],["を"],["供え","そなえ"],["、"],["朝","あさ"],["に"],["夕","ゆう"],["に"],["、"],["安息日","あんそくび"],["と"],["新月祭","しんげつさい"],["、"],["我","われ"],["ら"],["の"],["神","かみ"],["なる"],["主","ぬし"],["の"],["祝祭日","しゅくさいじつ"],["に"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげ"],["、"],["この"],["事","こと"],["が"],["イスラエル"],["に"],["おいて"],["いつ"],["まで"],["も"],["守られる","まもられる"],["よう"],["に"],["しよう"],["として"],["います"],["。"]]},{"verse":4,"text":"わたしが建てようとしている神殿は大いなるものです。わたしたちの神はすべての神々にまさる大いなる方だからです。","tok":[["わたし"],["が"],["建てよう","たてよう"],["として"],["いる"],["神殿","しんでん"],["は"],["大いなる","おおいなる"],["もの"],["です"],["。"],["わたしたち"],["の"],["神","かみ"],["は"],["すべて"],["の"],["神々","かみがみ"],["に"],["まさる"],["大いなる","おおいなる"],["方","ほう"],["だ"],["から"],["です"],["。"]]},{"verse":5,"text":"しかし、この方のために神殿を建てる力が誰にありましょうか。天も、天の天もこの方をお納めすることができないからです。主のために神殿を建てようとするわたしは何者でしょうか。神殿はただ主の御前に香をたくためのものでしかありません。","tok":[["しかし"],["、"],["この"],["方","かた"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["建てる","たてる"],["力","ちから"],["が"],["誰","だれ"],["に"],["ありましょう"],["か"],["。"],["天","てん"],["も"],["、"],["天","てん"],["の"],["天","てん"],["も"],["この"],["方","ほう"],["を"],["お納め","おおさめ"],["する"],["こと"],["が"],["できない"],["から"],["です"],["。"],["主","ぬし"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["建てよう","たてよう"],["と"],["する"],["わたし"],["は"],["何者","なにもの"],["でしょう"],["か"],["。"],["神殿","しんでん"],["は"],["ただ"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["香","こう"],["を"],["たく"],["ため"],["の"],["もの"],["で"],["しか"],["ありません"],["。"]]},{"verse":6,"text":"従って、今、金、銀、青銅、鉄、深紅の織物、緋の織物、青の織物を扱う熟練した者で、種々の彫刻にたけた者を一人こちらに送ってください。父ダビデがそろえて、わたしのもとにいるユダとエルサレムの熟練した者に力添えをさせていただきたいのです。","tok":[["従って","したがって"],["、"],["今","いま"],["、"],["金","きん"],["、"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"],["鉄","てつ"],["、"],["深紅","しんく"],["の"],["織物","おりもの"],["、"],["緋","ひ"],["の"],["織物","おりもの"],["、"],["青","あお"],["の"],["織物","おりもの"],["を"],["扱う","あつかう"],["熟練","じゅくれん"],["した"],["者","もの"],["で"],["、"],["種々","しゅじゅ"],["の"],["彫刻","ちょうこく"],["に"],["たけた"],["者","もの"],["を"],["一人","ひとり"],["こちら"],["に"],["送って","おくって"],["ください"],["。"],["父","ちち"],["ダビデ"],["が"],["そろえて"],["、"],["わたし"],["の"],["もと"],["に"],["いる"],["ユダ"],["と"],["エルサレム"],["の"],["熟練","じゅくれん"],["した"],["者","もの"],["に"],["力添え","ちからぞえ"],["を"],["させて"],["いただきたい"],["の"],["です"],["。"]]},{"verse":7,"text":"またレバノンからレバノン杉、糸杉、白檀の木材を送ってください。わたしは、あなたの家臣たちがレバノンの山林の伐採のことをよくわきまえていることを知っています。わたしの家臣をあなたの家臣と共に働かせ、","tok":[["また"],["レバノン"],["から"],["レバノン"],["杉","すぎ"],["、"],["糸杉","いとすぎ"],["、"],["白檀","びゃくだん"],["の"],["木材","もくざい"],["を"],["送って","おくって"],["ください"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["家臣","かしん"],["たち"],["が"],["レバノン"],["の"],["山林","さんりん"],["の"],["伐採","ばっさい"],["の"],["こと"],["を"],["よく"],["わきまえて"],["いる"],["こと"],["を"],["知って","しって"],["います"],["。"],["わたし"],["の"],["家臣","かしん"],["を"],["あなた"],["の"],["家臣","かしん"],["と"],["共","とも"],["に"],["働かせ","はたらかせ"],["、"]]},{"verse":8,"text":"大量の木材を準備させていただけないでしょうか。わたしは輝かしく偉容を誇る神殿を建てようとしているのです。","tok":[["大量","たいりょう"],["の"],["木材","もくざい"],["を"],["準備","じゅんび"],["させて"],["いただけないでしょう"],["か"],["。"],["わたし"],["は"],["輝かしく","かがやかしく"],["偉容","いよう"],["を"],["誇る","ほこる"],["神殿","しんでん"],["を"],["建てよう","たてよう"],["として"],["いる"],["の"],["です"],["。"]]},{"verse":9,"text":"伐採作業に当たるきこり、あなたの家臣に、わたしは小麦二万コル、大麦二万コル、ぶどう酒二万バト、オリーブ油二万バトを送り届けます。」","tok":[["伐採","ばっさい"],["作業","さぎょう"],["に"],["当たる","あたる"],["きこり"],["、"],["あなた"],["の"],["家臣","かしん"],["に"],["、"],["わたし"],["は"],["小麦","こむぎ"],["二万","にまん"],["コル"],["、"],["大麦","おおむぎ"],["二万","にまん"],["コル"],["、"],["ぶどう酒","ぶどうしゅ"],["二万","にまん"],["バト"],["、"],["オリーブ油","おりーぶゆ"],["二万","にまん"],["バト"],["を"],["送り届けます","おくりとどけます"],["。"],["」"]]},{"verse":10,"text":"ティルスの王フラムは、ソロモンに次のような返書を送ってきた。「主は御自分の民を愛して、あなたをその王とされた。」","tok":[["ティルス"],["の"],["王","おう"],["フラム"],["は"],["、"],["ソロモン"],["に"],["次","つぎ"],["の"],["よう"],["な"],["返書","へんしょ"],["を"],["送って","おくって"],["きた"],["。"],["「"],["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["を"],["愛して","あいして"],["、"],["あなた"],["を"],["その"],["王","おう"],["と"],["された"],["。"],["」"]]},{"verse":11,"text":"彼はまたこう言った。「天と地をお造りになったイスラエルの神なる主はたたえられますように。主はダビデ王に賢明で聡明な洞察力のある子をお与えになり、その子が主のために神殿を、国のために王宮を建てようとしています。","tok":[["彼","かれ"],["は"],["また"],["こう"],["言った","いった"],["。"],["「"],["天","てん"],["と"],["地","ち"],["を"],["お造り","おつくり"],["に"],["なった"],["イスラエル"],["の"],["神","かみ"],["なる"],["主","ぬし"],["は"],["たたえられます"],["よう"],["に"],["。"],["主","ぬし"],["は"],["ダビデ"],["王","おう"],["に"],["賢明","けんめい"],["で"],["聡明","そうめい"],["な"],["洞察力","どうさつりょく"],["の"],["ある"],["子","こ"],["を"],["お与え","おあたえ"],["に"],["なり"],["、"],["その"],["子","こ"],["が"],["主","ぬし"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["、"],["国","くに"],["の"],["ため"],["に"],["王宮","おうきゅう"],["を"],["建てよう","たてよう"],["として"],["います"],["。"]]},{"verse":12,"text":"今わたしは、聡明で熟練した者、職人の頭フラムを送ります。","tok":[["今","いま"],["わたし"],["は"],["、"],["聡明","そうめい"],["で"],["熟練","じゅくれん"],["した"],["者","もの"],["、"],["職人","しょくにん"],["の"],["頭","あたま"],["フラム"],["を"],["送ります","おくります"],["。"]]},{"verse":13,"text":"ダンの娘を母とし、ティルスの男を父として生まれた彼は、金、銀、青銅、鉄、石材、木材、深紅の織物、青の織物、麻の織物、緋の織物を扱い、どんな彫刻も作り、ゆだねられればどんな計画でも立てる能力があり、そちらの熟練した者、かつてのわたしの盟主、あなたの父ダビデの熟練した者に力添えをすることができます。","tok":[["ダン"],["の"],["娘","むすめ"],["を"],["母","はは"],["と"],["し"],["、"],["ティルス"],["の"],["男","おとこ"],["を"],["父","ちち"],["として"],["生まれた","うまれた"],["彼","かれ"],["は"],["、"],["金","きん"],["、"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"],["鉄","てつ"],["、"],["石材","せきざい"],["、"],["木材","もくざい"],["、"],["深紅","しんく"],["の"],["織物","おりもの"],["、"],["青","あお"],["の"],["織物","おりもの"],["、"],["麻","あさ"],["の"],["織物","おりもの"],["、"],["緋","ひ"],["の"],["織物","おりもの"],["を"],["扱い","あつかい"],["、"],["どんな"],["彫刻","ちょうこく"],["も"],["作り","つくり"],["、"],["ゆだねられれば"],["どんな"],["計画","けいかく"],["で"],["も"],["立てる","たてる"],["能力","のうりょく"],["が"],["あり"],["、"],["そちら"],["の"],["熟練","じゅくれん"],["した"],["者","もの"],["、"],["かつて"],["の"],["わたし"],["の"],["盟主","めいしゅ"],["、"],["あなた"],["の"],["父","ちち"],["ダビデ"],["の"],["熟練","じゅくれん"],["した"],["者","もの"],["に"],["力添え","ちからぞえ"],["を"],["する"],["こと"],["が"],["できます"],["。"]]},{"verse":14,"text":"お申し出のあった小麦、大麦、ぶどう酒、オリーブ油はわたしの家臣にお送りください。","tok":[["お申し出","おもうしで"],["の"],["あった"],["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["ぶどう酒","ぶどうしゅ"],["、"],["オリーブ油","おりーぶゆ"],["は"],["わたし"],["の"],["家臣","かしん"],["に"],["お送り","おおくり"],["ください"],["。"]]},{"verse":15,"text":"我々はあなたの必要とする木材をレバノンで伐採し、いかだに組んで海路ヤッファまで届けます。それをエルサレムまで運ぶのは、そちらでお願いします。」","tok":[["我々","われわれ"],["は"],["あなた"],["の"],["必要","ひつよう"],["と"],["する"],["木材","もくざい"],["を"],["レバノン"],["で"],["伐採","ばっさい"],["し"],["、"],["いかだ"],["に"],["組んで","くんで"],["海路","かいろ"],["ヤッファ"],["まで"],["届けます","とどけます"],["。"],["それ"],["を"],["エルサレム"],["まで"],["運ぶ","はこぶ"],["の"],["は"],["、"],["そちら"],["で"],["お願い","おねがい"],["します"],["。"],["」"]]},{"verse":16,"text":"ソロモンは、父ダビデが人口を調べたように、イスラエルの地にいるすべての寄留民の人口を調べたところ、その数は十五万三千六百人であった。","tok":[["ソロモン"],["は"],["、"],["父","ちち"],["ダビデ"],["が"],["人口","じんこう"],["を"],["調べた","しらべた"],["よう"],["に"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["いる"],["すべて"],["の"],["寄留民","きりゅうみん"],["の"],["人口","じんこう"],["を"],["調べた","しらべた"],["ところ"],["、"],["その"],["数","すう"],["は"],["十五万三千六百","じゅうごまんさんせんろくひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":17,"text":"そのうち七万人を荷役の労働者、八万人を山で石を切り出す労働者、三千六百人を民を働かせるための監督とした。","tok":[["その"],["うち"],["七万人","ななまんにん"],["を"],["荷役","にやく"],["の"],["労働者","ろうどうしゃ"],["、"],["八万人","はちまんにん"],["を"],["山","やま"],["で"],["石","いし"],["を"],["切り出す","きりだす"],["労働者","ろうどうしゃ"],["、"],["三千六百","さんせんろくひゃく"],["人","にん"],["を"],["民","たみ"],["を"],["働かせる","はたらかせる"],["ため"],["の"],["監督","かんとく"],["と"],["した"],["。"]]}]
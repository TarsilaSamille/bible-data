[{"verse":1,"text":"ヒゼキヤがこれらの真実な事を行った後、アッシリアの王センナケリブが攻めて来た。彼はユダに侵入し、その砦の町々に対して陣を張り、町々を攻め取ろうとした。","tok":[["ヒゼキヤ"],["が"],["これ"],["ら"],["の"],["真実","しんじつ"],["な"],["事","こと"],["を"],["行った","おこなった"],["後","あと"],["、"],["アッシリア"],["の"],["王","おう"],["センナケリブ"],["が"],["攻めて","せめて"],["来た","きた"],["。"],["彼","かれ"],["は"],["ユダ"],["に"],["侵入","しんにゅう"],["し"],["、"],["その"],["砦","とりで"],["の"],["町々","まちまち"],["に対して","にたいして"],["陣","じん"],["を"],["張り","はり"],["、"],["町々","まちまち"],["を"],["攻め取ろう","せめとろう"],["と"],["した"],["。"]]},{"verse":2,"text":"ヒゼキヤは、センナケリブが来て、エルサレム攻略を目指しているのを見ると、","tok":[["ヒゼキヤ"],["は"],["、"],["センナケリブ"],["が"],["来て","きて"],["、"],["エルサレム"],["攻略","こうりゃく"],["を"],["目指して","めざして"],["いる"],["の"],["を"],["見る","みる"],["と"],["、"]]},{"verse":3,"text":"将軍や勇士たちと協議し、町の外にある泉の水をせき止めることにした。彼らは王を支持した。","tok":[["将軍","しょうぐん"],["や"],["勇士","ゆうし"],["たち"],["と"],["協議","きょうぎ"],["し"],["、"],["町","まち"],["の"],["外","そと"],["に"],["ある"],["泉","いずみ"],["の"],["水","みず"],["を"],["せき止める","せきとめる"],["こと"],["に"],["した"],["。"],["彼","かれ"],["ら"],["は"],["王","おう"],["を"],["支持","しじ"],["した"],["。"]]},{"verse":4,"text":"多くの民が集まり、そのすべての泉と、この地を流れる谷川をせき止め、「アッシリアの王が来るとき、豊富な水を得させてはならない」と言った。","tok":[["多く","おおく"],["の"],["民","たみ"],["が"],["集まり","あつまり"],["、"],["その"],["すべて"],["の"],["泉","いずみ"],["と"],["、"],["この"],["地","ち"],["を"],["流れる","ながれる"],["谷川","たにがわ"],["を"],["せき止め","せきとめ"],["、"],["「"],["アッシリア"],["の"],["王","おう"],["が"],["来る","くる"],["とき"],["、"],["豊富","ほうふ"],["な"],["水","みず"],["を"],["得させて","えさせて"],["は"],["ならない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"王は意欲的に、壊れた城壁を修理し、その上に塔を立て、外側にもう一つの城壁を築いた。ダビデの町のミロを堅固にし、多くの投げ槍と盾を作った。","tok":[["王","おう"],["は"],["意欲的","いよくてき"],["に"],["、"],["壊れた","こわれた"],["城壁","じょうへき"],["を"],["修理","しゅうり"],["し"],["、"],["その"],["上","うえ"],["に"],["塔","とう"],["を"],["立て","たて"],["、"],["外側","そとがわ"],["に"],["もう"],["一","ひと"],["つ"],["の"],["城壁","じょうへき"],["を"],["築いた","きずいた"],["。"],["ダビデ"],["の"],["町","まち"],["の"],["ミロ"],["を"],["堅固","けんご"],["に"],["し"],["、"],["多く","おおく"],["の"],["投げ槍","なげやり"],["と"],["盾","たて"],["を"],["作った","つくった"],["。"]]},{"verse":6,"text":"王は指揮官を民の上に立て、彼らを城門の前にある広場に集めて激励して言った。","tok":[["王","おう"],["は"],["指揮官","しきかん"],["を"],["民","たみ"],["の"],["上","うえ"],["に"],["立て","たて"],["、"],["彼","かれ"],["ら"],["を"],["城門","じょうもん"],["の"],["前","まえ"],["に"],["ある"],["広場","ひろば"],["に"],["集めて","あつめて"],["激励","げきれい"],["して"],["言った","いった"],["。"]]},{"verse":7,"text":"「強く雄々しくあれ。アッシリアの王とその全軍団を見ても、恐れてはならない。おじけてはならない。我々と共においでになる方は、敵と共にいる者より力強い。","tok":[["「"],["強く","つよく"],["雄々しく","おおしく"],["あれ"],["。"],["アッシリア"],["の"],["王","おう"],["と"],["その"],["全","ぜん"],["軍団","ぐんだん"],["を"],["見て","みて"],["も"],["、"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おじけて"],["は"],["ならない"],["。"],["我々","われわれ"],["と"],["共","とも"],["に"],["おいで"],["に"],["なる"],["方","かた"],["は"],["、"],["敵","てき"],["と"],["共","とも"],["に"],["いる"],["者","もの"],["より"],["力強い","ちからづよい"],["。"]]},{"verse":8,"text":"敵には人の力しかないが、我々には我々の神、主がいて助けとなり、我々のために戦ってくださる。」民はユダの王ヒゼキヤの言葉に力づけられた。","tok":[["敵","てき"],["に"],["は"],["人","ひと"],["の"],["力","ちから"],["しか"],["ない"],["が"],["、"],["我々","われわれ"],["に"],["は"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["いて"],["助け","たすけ"],["と"],["なり"],["、"],["我々","われわれ"],["の"],["ため"],["に"],["戦って","たたかって"],["くださる"],["。"],["」"],["民","みん"],["は"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["の"],["言葉","ことば"],["に"],["力づけられた","ちからづけられた"],["。"]]},{"verse":9,"text":"その後、全軍を率いてラキシュを攻めていたアッシリアの王センナケリブは、エルサレムに家臣たちを遣わし、エルサレムにいるユダの王ヒゼキヤとユダのすべての人々にこう言わせた。","tok":[["その"],["後","ご"],["、"],["全軍","ぜんぐん"],["を"],["率いて","ひきいて"],["ラキシュ"],["を"],["攻めて","せめて"],["いた"],["アッシリア"],["の"],["王","おう"],["センナケリブ"],["は"],["、"],["エルサレム"],["に"],["家臣","かしん"],["たち"],["を"],["遣わし","つかわし"],["、"],["エルサレム"],["に"],["いる"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["と"],["ユダ"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["こう"],["言わせた","いわせた"],["。"]]},{"verse":10,"text":"「アッシリアの王センナケリブはこう言われる。お前たちは何を頼りにして、包囲されたエルサレムにとどまっているのか。","tok":[["「"],["アッシリア"],["の"],["王","おう"],["センナケリブ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["何","なん"],["を"],["頼り","たより"],["に"],["して"],["、"],["包囲","ほうい"],["された"],["エルサレム"],["に"],["とどまって"],["いる"],["の"],["か"],["。"]]},{"verse":11,"text":"ヒゼキヤは、『我々の神、主がアッシリアの王の手から救ってくださる』と言って、お前たちを唆し、飢えと渇きで死なせようとしているのではないか。","tok":[["ヒゼキヤ"],["は"],["、"],["『"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["アッシリア"],["の"],["王","おう"],["の"],["手","て"],["から"],["救って","すくって"],["くださる"],["』"],["と"],["言って","いって"],["、"],["お前","おまえ"],["たち"],["を"],["唆し","そそのかし"],["、"],["飢え","うえ"],["と"],["渇き","かわき"],["で"],["死なせよう","しなせよう"],["として"],["いる"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":12,"text":"ヒゼキヤはユダとエルサレムに向かい、『ただ一つの祭壇の前で礼拝し、その上で犠牲を燃やして煙にせよ』と言って、彼の主の聖なる高台と祭壇を取り除いたのではなかったか。","tok":[["ヒゼキヤ"],["は"],["ユダ"],["と"],["エルサレム"],["に"],["向かい","むかい"],["、"],["『"],["ただ"],["一","ひと"],["つ"],["の"],["祭壇","さいだん"],["の"],["前","まえ"],["で"],["礼拝","れいはい"],["し"],["、"],["その"],["上","うえ"],["で"],["犠牲","ぎせい"],["を"],["燃やして","もやして"],["煙","けむり"],["に"],["せよ"],["』"],["と"],["言って","いって"],["、"],["彼","かれ"],["の"],["主","ぬし"],["の"],["聖","せい"],["なる"],["高台","たかだい"],["と"],["祭壇","さいだん"],["を"],["取り除いた","とりのぞいた"],["ので"],["は"],["なかった"],["か"],["。"]]},{"verse":13,"text":"お前たちは、わたしとわたしの先祖が全世界の民に行ったことを知らないのか。諸国の神々がわたしの手からその国を救い出すことができたか。","tok":[["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["と"],["わたし"],["の"],["先祖","せんぞ"],["が"],["全","ぜん"],["世界","せかい"],["の"],["民","たみ"],["に"],["行った","いった"],["こと"],["を"],["知らない","しらない"],["の"],["か"],["。"],["諸国","しょこく"],["の"],["神々","かみがみ"],["が"],["わたし"],["の"],["手","て"],["から"],["その"],["国","くに"],["を"],["救い出す","すくいだす"],["こと"],["が"],["できた"],["か"],["。"]]},{"verse":14,"text":"わたしの先祖によって滅ぼされたこれら諸国の神々のうち、どの神がわたしの手からその民を救い出すことができたか。お前たちの神は、わたしの手からお前たちを救うことができるというのか。","tok":[["わたし"],["の"],["先祖","せんぞ"],["によって"],["滅ぼされた","ほろぼされた"],["これ"],["ら"],["諸国","しょこく"],["の"],["神々","かみがみ"],["の"],["うち"],["、"],["どの"],["神","かみ"],["が"],["わたし"],["の"],["手","て"],["から"],["その"],["民","たみ"],["を"],["救い出す","すくいだす"],["こと"],["が"],["できた"],["か"],["。"],["お前","おまえ"],["たち"],["の"],["神","かみ"],["は"],["、"],["わたし"],["の"],["手","て"],["から"],["お前","おまえ"],["たち"],["を"],["救う","すくう"],["こと"],["が"],["できる"],["と"],["いう"],["の"],["か"],["。"]]},{"verse":15,"text":"そのようにしてヒゼキヤに欺かれ、唆されてはならない。彼を信じてはならない。どの民、どの国のどの神も、わたしの手から、またわたしの先祖の手からその民を救うことができなかった。お前たちの神も、このわたしの手からお前たちを救い出すことはできない。」","tok":[["その"],["よう"],["に"],["して"],["ヒゼキヤ"],["に"],["欺かれ","あざむかれ"],["、"],["唆されて","そそのかされて"],["は"],["ならない"],["。"],["彼","かれ"],["を"],["信じて","しんじて"],["は"],["ならない"],["。"],["どの"],["民","たみ"],["、"],["どの"],["国","くに"],["の"],["どの"],["神","かみ"],["も"],["、"],["わたし"],["の"],["手","て"],["から"],["、"],["また"],["わたし"],["の"],["先祖","せんぞ"],["の"],["手","て"],["から"],["その"],["民","たみ"],["を"],["救う","すくう"],["こと"],["が"],["できなかった"],["。"],["お前","おまえ"],["たち"],["の"],["神","かみ"],["も"],["、"],["この"],["わたし"],["の"],["手","て"],["から"],["お前","おまえ"],["たち"],["を"],["救い出す","すくいだす"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":16,"text":"センナケリブの家臣たちは、神なる主とその僕ヒゼキヤに向かってなお語り続けた。","tok":[["センナケリブ"],["の"],["家臣","かしん"],["たち"],["は"],["、"],["神","かみ"],["なる"],["主","ぬし"],["と"],["その"],["僕","ぼく"],["ヒゼキヤ"],["に"],["向かって","むかって"],["な"],["お語り","おかたり"],["続けた","つづけた"],["。"]]},{"verse":17,"text":"またセンナケリブ自らイスラエルの神、主を侮る手紙を書き、主に逆らって言った。「わたしの手から自分の民を救うことのできなかった諸国の神々と同じように、ヒゼキヤの神も、わたしの手からその民を救い出すことはできない。」","tok":[["また"],["センナケリブ"],["自ら","みずから"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["侮る","あなどる"],["手紙","てがみ"],["を"],["書き","かき"],["、"],["主に","おもに"],["逆らって","さからって"],["言った","いった"],["。"],["「"],["わたし"],["の"],["手","て"],["から"],["自分","じぶん"],["の"],["民","たみ"],["を"],["救う","すくう"],["こと"],["の"],["できなかった"],["諸国","しょこく"],["の"],["神々","かみがみ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["ヒゼキヤ"],["の"],["神","かみ"],["も"],["、"],["わたし"],["の"],["手","て"],["から"],["その"],["民","たみ"],["を"],["救い出す","すくいだす"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":18,"text":"彼らは城壁の上にいたエルサレムの民に、ユダの言葉を使って大声で呼びかけ、恐れと戸惑いを起こさせ、町を占領しようとした。","tok":[["彼","かれ"],["ら"],["は"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["いた"],["エルサレム"],["の"],["民","たみ"],["に"],["、"],["ユダ"],["の"],["言葉","ことば"],["を"],["使って","つかって"],["大声","おおごえ"],["で"],["呼びかけ","よびかけ"],["、"],["恐れ","おそれ"],["と"],["戸惑い","とまどい"],["を"],["起こさせ","おこさせ"],["、"],["町","まち"],["を"],["占領","せんりょう"],["しよう"],["と"],["した"],["。"]]},{"verse":19,"text":"彼らは、エルサレムの神を、人の手の業にすぎない諸国の神々と同じ
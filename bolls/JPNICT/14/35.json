[{"verse":1,"text":"ヨシヤはエルサレムにおいて主の過越祭を祝い、第一の月の十四日に過越のいけにえを屠った。","tok":[["ヨシヤ"],["は"],["エルサレム"],["に"],["おいて"],["主","ぬし"],["の"],["過越","すぎこし"],["祭","まつり"],["を"],["祝い","いわい"],["、"],["第","だい"],["一","いち"],["の"],["月","つき"],["の"],["十四日","じゅうよんか"],["に"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["屠った","ほふった"],["。"]]},{"verse":2,"text":"彼は祭司たちを任務に就かせ、彼らを励まして主の神殿の奉仕を行わせた。","tok":[["彼","かれ"],["は"],["祭司","さいし"],["たち"],["を"],["任務","にんむ"],["に"],["就かせ","つかせ"],["、"],["彼","かれ"],["ら"],["を"],["励まして","はげまして"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["奉仕","ほうし"],["を"],["行わせた","おこなわせた"],["。"]]},{"verse":3,"text":"すべてのイスラエルの教師であり、主のために聖別されたレビ人に、王はこう言った。「イスラエルの王ダビデの子ソロモンが建てた神殿に、聖なる箱を納めよ。あなたたちはもはやそれを担う必要がない。あなたたちの神、主とその民イスラエルに奉仕せよ。","tok":[["すべて"],["の"],["イスラエル"],["の"],["教師","きょうし"],["で"],["あり"],["、"],["主","ぬし"],["の"],["ため"],["に"],["聖別","せいべつ"],["された"],["レビ人","れびにん"],["に"],["、"],["王","おう"],["は"],["こう"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["王","おう"],["ダビデ"],["の"],["子","こ"],["ソロモン"],["が"],["建てた","たてた"],["神殿","しんでん"],["に"],["、"],["聖","せい"],["なる"],["箱","ばこ"],["を"],["納めよ","おさめよ"],["。"],["あなた"],["たち"],["は"],["もはや"],["それ"],["を"],["担う","になう"],["必要","ひつよう"],["が"],["ない"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["と"],["その"],["民","みん"],["イスラエル"],["に"],["奉仕","ほうし"],["せよ"],["。"]]},{"verse":4,"text":"あなたたちはイスラエルの王ダビデの書とその子ソロモンの文書にのっとり、組分けどおりに家系ごとに準備を整え、","tok":[["あなた"],["たち"],["は"],["イスラエル"],["の"],["王","おう"],["ダビデ"],["の"],["書","しょ"],["と"],["その"],["子","こ"],["ソロモン"],["の"],["文書","ぶんしょ"],["に"],["のっとり"],["、"],["組分け","くみわけ"],["どおり"],["に"],["家系","かけい"],["ごと"],["に"],["準備","じゅんび"],["を"],["整え","ととのえ"],["、"]]},{"verse":5,"text":"兄弟である民の家系の区分に従い、またレビ人の家系の組ごとに聖所に立て。","tok":[["兄弟","きょうだい"],["で"],["ある"],["民","たみ"],["の"],["家系","かけい"],["の"],["区分","くぶん"],["に"],["従い","したがい"],["、"],["また"],["レビ人","れびにん"],["の"],["家系","かけい"],["の"],["組","くみ"],["ごと"],["に"],["聖","せい"],["所","しょ"],["に"],["立て","たて"],["。"]]},{"verse":6,"text":"過越のいけにえを屠り、自分を聖別し、あなたたちの兄弟が、モーセを通して伝えられた主の言葉に従って祝いができるように整えよ。」","tok":[["過越","すぎこし"],["の"],["いけにえ"],["を"],["屠り","ほふり"],["、"],["自分","じぶん"],["を"],["聖別","せいべつ"],["し"],["、"],["あなた"],["たち"],["の"],["兄弟","きょうだい"],["が"],["、"],["モーセ"],["を"],["通して","とおして"],["伝えられた","つたえられた"],["主","ぬし"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["祝い","いわい"],["が"],["できる"],["よう"],["に"],["整え","ととのえ"],["よ"],["。"],["」"]]},{"verse":7,"text":"ヨシヤ王は民のために羊、小羊、子山羊を提供した。これらは皆、そこにいるすべての人の過越のいけにえのためであり、その数は三万匹、牛も三千頭に及んだ。これらは王の財産の中から提供された。","tok":[["ヨシヤ"],["王","おう"],["は"],["民","みん"],["の"],["ため"],["に"],["羊","ひつじ"],["、"],["小羊","こひつじ"],["、"],["子山羊","こやぎ"],["を"],["提供","ていきょう"],["した"],["。"],["これ"],["ら"],["は"],["皆","みな"],["、"],["そこ"],["に"],["いる"],["すべて"],["の"],["人","ひと"],["の"],["過越","すぎこし"],["の"],["いけにえ"],["の"],["ため"],["で"],["あり"],["、"],["その"],["数","すう"],["は"],["三万匹","さんまんひき"],["、"],["牛","うし"],["も"],["三千頭","さんせんとう"],["に"],["及んだ","およんだ"],["。"],["これ"],["ら"],["は"],["王","おう"],["の"],["財産","ざいさん"],["の"],["中","なか"],["から"],["提供","ていきょう"],["された"],["。"]]},{"verse":8,"text":"高官たちも、民と祭司、レビ人のために進んで提供した。神殿の主管ヒルキヤ、ゼカルヤ、エヒエルは過越のいけにえとして小羊二千六百匹、牛三百頭を祭司たちに与えた。","tok":[["高官","こうかん"],["たち"],["も"],["、"],["民","みん"],["と"],["祭司","さいし"],["、"],["レビ人","れびにん"],["の"],["ため"],["に"],["進んで","すすんで"],["提供","ていきょう"],["した"],["。"],["神殿","しんでん"],["の"],["主管","しゅかん"],["ヒルキヤ"],["、"],["ゼカルヤ"],["、"],["エヒエル"],["は"],["過越","すぎこし"],["の"],["いけにえ"],["として"],["小羊","こひつじ"],["二千六百","にせんろくひゃく"],["匹","ひき"],["、"],["牛","うし"],["三百頭","さんひゃくとう"],["を"],["祭司","さいし"],["たち"],["に"],["与えた","あたえた"],["。"]]},{"verse":9,"text":"コナンヤ、その兄弟シェマヤとネタンエル、レビ人の指導者ハシャブヤ、エイエル、ヨザバドは、過越のいけにえとして小羊五千匹、牛五百頭をレビ人に提供した。","tok":[["コナンヤ"],["、"],["その"],["兄弟","きょうだい"],["シェマヤ"],["と"],["ネタンエル"],["、"],["レビ人","れびにん"],["の"],["指導者","しどうしゃ"],["ハシャブヤ"],["、"],["エイエル"],["、"],["ヨザバド"],["は"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["として"],["小羊","こひつじ"],["五千匹","ごせんひき"],["、"],["牛","うし"],["五百頭","ごひゃくとう"],["を"],["レビ人","れびにん"],["に"],["提供","ていきょう"],["した"],["。"]]},{"verse":10,"text":"奉仕の準備は整った。王の指示に従って、祭司はその持ち場に、レビ人はその組ごとに立った。","tok":[["奉仕","ほうし"],["の"],["準備","じゅんび"],["は"],["整った","ととのった"],["。"],["王","おう"],["の"],["指示","しじ"],["に"],["従って","したがって"],["、"],["祭司","さいし"],["は"],["その"],["持ち場","もちば"],["に"],["、"],["レビ人","れびにん"],["は"],["その"],["組","くみ"],["ごと"],["に"],["立った","たった"],["。"]]},{"verse":11,"text":"彼らは過越のいけにえを屠り、祭司は血を受け取って振りかけ、レビ人はいけにえの皮をはいだ。","tok":[["彼","かれ"],["ら"],["は"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["屠り","ほふり"],["、"],["祭司","さいし"],["は"],["血","ち"],["を"],["受け取って","うけとって"],["振りかけ","ふりかけ"],["、"],["レビ人","れびにん"],["は"],["いけにえ"],["の"],["皮","かわ"],["を"],["はいだ"],["。"]]},{"verse":12,"text":"彼らは焼き尽くす献げ物とする部分を別にして、それを民の家系の区分に従って与え、モーセの書に記されているとおり主にささげさせた。牛についても同様にした。","tok":[["彼","かれ"],["ら"],["は"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["する"],["部分","ぶぶん"],["を"],["別","べつ"],["に"],["して"],["、"],["それ"],["を"],["民","たみ"],["の"],["家系","かけい"],["の"],["区分","くぶん"],["に"],["従って","したがって"],["与え","あたえ"],["、"],["モーセ"],["の"],["書","しょ"],["に"],["記されて","しるされて"],["いる"],["とおり"],["主","ぬし"],["に"],["ささげさせた"],["。"],["牛","うし"],["について"],["も"],["同様","どうよう"],["に"],["した"],["。"]]},{"verse":13,"text":"彼らは定められているように、過越のいけにえを火で焼き、他の聖なる物は鍋や釜や平鍋で煮て、急いで民の全員に配った。","tok":[["彼","かれ"],["ら"],["は"],["定められて","さだめられて"],["いる"],["よう"],["に"],["、"],["過越","すぎこし"],["の"],["いけにえ"],["を"],["火","ひ"],["で"],["焼き","やき"],["、"],["他","た"],["の"],["聖","せい"],["なる"],["物","もの"],["は"],["鍋","なべ"],["や"],["釜","かま"],["や"],["平鍋","ひらなべ"],["で"],["煮て","にて"],["、"],["急いで","いそいで"],["民","みん"],["の"],["全員","ぜんいん"],["に"],["配った","くばった"],["。"]]},{"verse":14,"text":"その後、彼らは自分と祭司のために準備した。アロンの子らである祭司たちは夜になるまで焼き尽くす献げ物や脂肪をささげるのに追われていたからである。レビ人は自分とアロンの子孫である祭司のために準備した。","tok":[["その"],["後","ご"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["と"],["祭司","さいし"],["の"],["ため"],["に"],["準備","じゅんび"],["した"],["。"],["アロン"],["の"],["子","こ"],["ら"],["で"],["ある"],["祭司","さいし"],["たち"],["は"],["夜","よる"],["に"],["なる"],["まで"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["や"],["脂肪","しぼう"],["を"],["ささげる"],["のに"],["追われて","おわれて"],["いた"],["から"],["で"],["ある"],["。"],["レビ人","れびにん"],["は"],["自分","じぶん"],["と"],["アロン"],["の"],["子孫","しそん"],["で"],["ある"],["祭司","さいし"],["の"],["ため"],["に"],["準備","じゅんび"],["した"],["。"]]},{"verse":15,"text":"アサフの一族である詠唱者たちは、ダビデおよび王の先見者アサフ、ヘマン、エドトンの指示に従って自分の持ち場につき、門衛もそれぞれの門に立っていた。兄弟であるレビ人が彼らのために準備してくれたので、彼らの中のだれも、自分の奉仕を離れる必要がなかった。","tok":[["アサフ"],["の"],["一族","いちぞく"],["で"],["ある"],["詠唱者","えいしょうしゃ"],["たち"],["は"],["、"],["ダビデ"],["および"],["王","おう"],["の"],["先見者","せんけんしゃ"],["アサフ"],["、"],["ヘマン"],["、"],["エドトン"],["の"],["指示","しじ"],["に"],["従って","したがって"],["自分","じぶん"],["の"],["持ち場","もちば"],["に"],["つき"],["、"],["門衛","もんえい"],["も"],["それぞれ"],["の"],["門","もん"],["に"],["立って","たって"],["いた"],["。"],["兄弟","きょうだい"],["で"],["ある"],["レビ人","れびにん"],["が"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["準備","じゅんび"],["して"],["くれた"],["ので"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["の"],["だれ"],["も"],["、"],["自分","じぶん"],["の"],["奉仕","ほうし"],["を"],["離れる","はなれる"],["必要","ひつよう"],["が"],["なかった"],["。"]]},{"verse":16,"text":"ヨシヤ王の指示に従って過越祭を祝い、主の祭壇に焼き尽くす献げ物をささげるために、主に対する奉仕の準備は、その日にすべて整った。","tok":[["ヨシヤ"],["王","おう"],["の"],["指示","しじ"],["に"],["従って","したがって"],["過越","すぎこし"],["祭","まつり"],["を"],["祝い","いわい"],["、"],["主","ぬし"],["の"],["祭壇","さいだん"],["に"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげる"],["ため"],["に"],["、"],["主","ぬし"],["に"],["対する","たいする"],["奉仕","ほうし"],["の"],["準備","じゅんび"],["は"],["、"],["その"],["日","ひ"],["に"],["すべて"],["整った","ととのった"],["。"]]},{"verse":17,"text":"こうしてその時、そこにいたイスラエルの人々は過越祭を祝い、除酵祭を七日間にわたって祝った。","tok":[["こう"],["して"],["その"],["時","とき"],["、"],["そこ"],["に"],["いた"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["過越","すぎこし"],["祭","まつり"],["を"],["祝い","いわい"],["、"],["除","じょ"],["酵祭"],["を"],["七","なな"],["日間","かかん"],["に"],["わたって"],["祝った","いわった"],["。"]]},{"verse":18,"text":"預言者サムエルの時代以来、イスラエルにおいてこのような過越祭が祝われたことはなく、ヨシヤが祭司、レビ人、そこに居合わせたすべてのユダとイスラエルの人々、およびエルサレムの住民と共に祝ったような過越祭を行った者は、イスラエルの歴代の王の中に一人もいなかった。","tok":[["預言者","よげんしゃ"],["サムエル"],["の"],["時代","じだい"],["以来","いらい"],["、"],["イスラエル"],["に"],["おいて"],["この"],["よう"],["な"],["過越","すぎこし"],["祭","まつり"],["が"],["祝われた","いわわれた"],["こと"],["は"],["なく"],["、"],["ヨシヤ"],["が"],["祭司","さいし"],["、"],["レビ人","れびにん"],["、"],["そこ"],["に"],["居合わせた","いあわせた"],["すべて"],["の"],["ユダ"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["、"],["および"],["エルサレム"],["の"],["住民","じゅうみん"],["と"],["共","とも"],["に"],["祝った","いわった"],["よう"],["な"],["過越","すぎこし"],["祭","まつり"],["を"],["行った","おこなった"],["者","もの"],["は"],["、"],["イスラエル"],["の"],["歴代","れきだい"],["の"],["王","おう"],["の"],["中","なか"],["に"],["一人","ひとり"],["も"],["いなかった"],["。"]]},{"verse":19,"text":"この過越祭はヨシヤ王の治世第十八年に祝われた。","tok":[["この"],["過越","すぎこし"],["祭","まつり"],["は"],["ヨシヤ"],["王","おう"],["の"],["治世","ちせい"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["に"],["祝われた","いわわれた"],["。"]]},{"verse":20,"text":"ヨシヤが神殿を整えるために行ったこれらのすべての事の後、エジプトの王ネコがユーフラテス川の近くのカルケミシュを攻めようとして上って来た。ヨシヤはこれを迎え撃つために出陣した。","tok":[["ヨシヤ"],["が"],["神殿","しんでん"],["を"],["整える","ととのえる"],["ため"],["に"],["行った","いった"],["これ"],["ら"],["の"],["すべて"],["の"],["事","こと"],["の"],["後","あと"],["、"],["エジプト"],["の"],["王","おう"],["ネコ"],["が"],["ユーフラテス"],["川","かわ"],["の"],["近く","ちかく"],["の"],["カルケミシュ"],["を"],["攻めよう","せめよう"],["として"],["上って","のぼって"],["来た","きた"],["。"],["ヨシヤ"],["は"],["これ"],["を"],["迎え撃つ","むかえうつ"],["ため"],["に"],["出陣","しゅつじん"],["した"],["。"]]},{"verse":21,"text":"しかしネコは使いを送って言った。「ユダの王よ、わたしはあなたと何のかかわりがあろうか。今日攻めて来たのはあなたに対してではなく、わたしが敵とする家に対してである。神はわたしに急ぐようにと命じられた。わたしと共にいる神に逆らわずにいなさい。さもなければ、神はあなたを滅ぼされる。」","tok":[["しかし"],["ネコ"],["は"],["使い","つかい"],["を"],["送って","おくって"],["言った","いった"],["。"],["「"],["ユダ"],["の"],["王","おう"],["よ"],["、"],["わたし"],["は"],["あなた"],["と"],["何","なん"],["の"],["かかわり"],["が"],["あろう"],["か"],["。"],["今日","きょう"],["攻めて","せめて"],["来た","きた"],["の"],["は"],["あなた"],["に対して","にたいして"],["で"],["は"],["なく"],["、"],["わたし"],["が"],["敵","てき"],["と"],["する"],["家","いえ"],["に対して","にたいして"],["で"],["ある"],["。"],["神","かみ"],["は"],["わたし"],["に"],["急ぐ","いそぐ"],["よう"],["に"],["と"],["命じられた","めいじられた"],["。"],["わたし"],["と"],["共","とも"],["に"],["いる"],["神","かみ"],["に"],["逆らわず","さからわず"],["に"],["い"],["なさい"],["。"],["さも"],["なければ"],["、"],["神","かみ"],["は"],["あなた"],["を"],["滅ぼされる","ほろぼされる"],["。"],["」"]]},{"verse":22,"text":"しかし、ヨシヤは引き返さず、攻撃のために変装して、神の口から出たネコの言葉を聞かなかった。そして彼はメギド平野の戦いに臨んだ。","tok":[["しかし"],["、"],["ヨシヤ"],["は"],["引き返さず","ひきかえさず"],["、"],["攻撃","こうげき"],["の"],["ため"],["に"],["変装","へんそう"],["して"],["、"],["神","かみ"],["の"],["口","くち"],["から"],["出た","でた"],["ネコ"],["の"],["言葉","ことば"],["を"],["聞かなかった","きかなかった"],["。"],["そして"],["彼","かれ"],["は"],["メギド"],["平野","へいや"],["の"],["戦い","たたかい"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":23,"text":"射手たちがヨシヤ王を射た。王が家臣たちに、「傷は重い。わたしを運び出してくれ」と言ったので、","tok":[["射手","いて"],["たち"],["が"],["ヨシヤ"],["王","おう"],["を"],["射た","いた"],["。"],["王","おう"],["が"],["家臣","かしん"],["たち"],["に"],["、"],["「"],["傷","きず"],["は"],["重い","おもい"],["。"],["わたし"],["を"],["運び出して","はこびだして"],["くれ"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":24,"text":"家臣たちは王を戦車から降ろし、王の第二の車に乗せてエルサレムに連れ帰った。王は死んで、先祖の墓に葬られた。ユダとエルサレムのすべての人々がヨシヤの死を嘆いた。","tok":[["家臣","かしん"],["たち"],["は"],["王","おう"],["を"],["戦車","せんしゃ"],["から"],["降ろし","おろし"],["、"],["王","おう"],["の"],["第","だい"],["二","に"],["の"],["車","くるま"],["に"],["乗せて","のせて"],["エルサレム"],["に"],["連れ帰った","つれかえった"],["。"],["王","おう"],["は"],["死んで","しんで"],["、"],["先祖","せんぞ"],["の"],["墓","はか"],["に"],["葬られた","ほうむられた"],["。"],["ユダ"],["と"],["エルサレム"],["の"],["すべて"],["の"],["人々","ひとびと"],["が"],["ヨシヤ"],["の"],["死","し"],["を"],["嘆いた","なげいた"],["。"]]},{"verse":25,"text":"エレミヤはヨシヤを悼んで哀歌を作った。男女のすべての歌い手がその哀歌によってヨシヤを語り伝えるようになり、今日に至っている。それがイスラエルの定めとなり、歌は『哀歌』に記されている。","tok":[["エレミヤ"],["は"],["ヨシヤ"],["を"],["悼んで","いたんで"],["哀歌","あいか"],["を"],["作った","つくった"],["。"],["男女","だんじょ"],["の"],["すべて"],["の"],["歌い手","うたいて"],["が"],["その"],["哀歌","あいか"],["によって"],["ヨシヤ"],["を"],["語り伝える","かたりつたえる"],["よう"],["に"],["なり"],["、"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"],["それ"],["が"],["イスラエル"],["の"],["定め","さだめ"],["と"],["なり"],["、"],["歌","うた"],["は"],["『"],["哀歌","あいか"],["』"],["に"],["記されて","しるされて"],["いる"],["。"]]},{"verse":26,"text":"ヨシヤの他の事績および主の律法に忠実に従った行為の数々は、","tok":[["ヨシヤ"],["の"],["他","ほか"],["の"],["事績","じせき"],["および"],["主","ぬし"],["の"],["律法","りっぽう"],["に"],["忠実","ちゅうじつ"],["に"],["従った","したがった"],["行為","こうい"],["の"],["数々","かずかず"],["は"],["、"]]},{"verse":27,"text":"初期のことも後期のことも、『イスラエルとユダの列王の書』に記されている。","tok":[["初期","しょき"],["の"],["こと"],["も"],["後期","こうき"],["の"],["こと"],["も"],["、"],["『"],["イスラエル"],["と"],["ユダ"],["の"],["列王","れつおう"],["の"],["書","しょ"],["』"],["に"]
[{"verse":1,"text":"ソロモン王は、主の神殿のために行われてきた仕事がすべて完了すると、父ダビデが聖別した物、銀、金、その他あらゆる祭具を運び入れ、神殿の宝物庫に納めた。","tok":[["ソロモン"],["王","おう"],["は"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["ため"],["に"],["行われて","おこなわれて"],["きた"],["仕事","しごと"],["が"],["すべて"],["完了","かんりょう"],["する"],["と"],["、"],["父","ちち"],["ダビデ"],["が"],["聖別","せいべつ"],["した"],["物","もの"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["その"],["他","た"],["あらゆる"],["祭具","さいぐ"],["を"],["運び入れ","はこびいれ"],["、"],["神殿","しんでん"],["の"],["宝物庫","ほうもつこ"],["に"],["納めた","おさめた"],["。"]]},{"verse":2,"text":"ソロモンは、そこでイスラエルの長老、すべての部族長、イスラエル人諸家系の首長をエルサレムに召集した。「ダビデの町」シオンから主の契約の箱を担ぎ上るためであった。","tok":[["ソロモン"],["は"],["、"],["そこ"],["で"],["イスラエル"],["の"],["長老","ちょうろう"],["、"],["すべて"],["の"],["部族長","ぶぞくちょう"],["、"],["イスラエル"],["人","にん"],["諸家系","しょかけい"],["の"],["首長","しゅちょう"],["を"],["エルサレム"],["に"],["召集","しょうしゅう"],["した"],["。"],["「"],["ダビデ"],["の"],["町","まち"],["」"],["シオン"],["から"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担ぎ","かつぎ"],["上る","のぼる"],["ため"],["で"],["あった"],["。"]]},{"verse":3,"text":"第七の月の祭りに、すべてのイスラエル人が王のもとに集まった。","tok":[["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["祭り","まつり"],["に"],["、"],["すべて"],["の"],["イスラエル"],["人","にん"],["が"],["王","おう"],["の"],["もと"],["に"],["集まった","あつまった"],["。"]]},{"verse":4,"text":"イスラエルの全長老が到着すると、レビ人はその箱を担ぎ、","tok":[["イスラエル"],["の"],["全","ぜん"],["長老","ちょうろう"],["が"],["到着","とうちゃく"],["する"],["と"],["、"],["レビ人","れびにん"],["は"],["その"],["箱","ばこ"],["を"],["担ぎ","かつぎ"],["、"]]},{"verse":5,"text":"その箱のみならず臨在の幕屋も、幕屋にあった聖なる祭具もすべて担ぎ上った。祭司たちはレビ人たちと共にこれらのものを担ぎ上った。","tok":[["その"],["箱","ばこ"],["のみ"],["ならず"],["臨在","りんざい"],["の"],["幕屋","まくや"],["も"],["、"],["幕屋","まくや"],["に"],["あった"],["聖","せい"],["なる"],["祭具","さいぐ"],["も"],["すべて"],["担ぎ","かつぎ"],["上った","のぼった"],["。"],["祭司","さいし"],["たち"],["は"],["レビ人","れびにん"],["たち"],["と"],["共","とも"],["に"],["これ"],["ら"],["の"],["もの"],["を"],["担ぎ","かつぎ"],["上った","のぼった"],["。"]]},{"verse":6,"text":"ソロモン王は、彼のもとに集まったイスラエルの全共同体と共に、その箱の前でいけにえとして羊や牛をささげた。その数はあまりにも多く、調べることも数えることもできなかった。","tok":[["ソロモン"],["王","おう"],["は"],["、"],["彼","かれ"],["の"],["もと"],["に"],["集まった","あつまった"],["イスラエル"],["の"],["全","ぜん"],["共同体","きょうどうたい"],["と"],["共","とも"],["に"],["、"],["その"],["箱","ばこ"],["の"],["前","まえ"],["で"],["いけにえ"],["として"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["ささげた"],["。"],["その"],["数","すう"],["は"],["あまり"],["に"],["も"],["多く","おおく"],["、"],["調べる","しらべる"],["こと"],["も"],["数える","かぞえる"],["こと"],["も"],["できなかった"],["。"]]},{"verse":7,"text":"祭司たちは主の契約の箱を定められた場所、至聖所といわれる神殿の内陣に運び入れ、ケルビムの翼の下に安置した。","tok":[["祭司","さいし"],["たち"],["は"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["定められた","さだめられた"],["場所","ばしょ"],["、"],["至聖所","しせいしょ"],["と"],["いわれる"],["神殿","しんでん"],["の"],["内陣","ないじん"],["に"],["運び入れ","はこびいれ"],["、"],["ケルビム"],["の"],["翼","つばさ"],["の"],["下","した"],["に"],["安置","あんち"],["した"],["。"]]},{"verse":8,"text":"ケルビムは箱のある場所の上に翼を広げ、その箱と担ぎ棒の上を覆うかたちになった。","tok":[["ケルビム"],["は"],["箱","ばこ"],["の"],["ある"],["場所","ばしょ"],["の"],["上","うえ"],["に"],["翼","つばさ"],["を"],["広げ","ひろげ"],["、"],["その"],["箱","ばこ"],["と"],["担ぎ棒","かつぎぼう"],["の"],["上","うえ"],["を"],["覆う","おおう"],["かたち"],["に"],["なった"],["。"]]},{"verse":9,"text":"その棒は長かったので、先端が内陣の前の聖所からは見えたが、外からは見えなかった。それは、今日もなおそこに置かれている。","tok":[["その"],["棒","ぼう"],["は"],["長かった","ながかった"],["ので"],["、"],["先端","せんたん"],["が"],["内陣","ないじん"],["の"],["前","まえ"],["の"],["聖","せい"],["所","しょ"],["から"],["は"],["見えた","みえた"],["が"],["、"],["外","そと"],["から"],["は"],["見えなかった","みえなかった"],["。"],["それ"],["は"],["、"],["今日","きょう"],["も"],["なお"],["そこ"],["に"],["置かれて","おかれて"],["いる"],["。"]]},{"verse":10,"text":"箱の中には石の板二枚のほか何もなかった。この石の板は、主がエジプトから出たイスラエル人と契約を結ばれたとき、ホレブでモーセが納めたものである。","tok":[["箱","ばこ"],["の"],["中","なか"],["に"],["は"],["石","いし"],["の"],["板","いた"],["二枚","にまい"],["の"],["ほか"],["何","なん"],["も"],["なかった"],["。"],["この"],["石","いし"],["の"],["板","いた"],["は"],["、"],["主","ぬし"],["が"],["エジプト"],["から"],["出た","でた"],["イスラエル"],["人","にん"],["と"],["契約","けいやく"],["を"],["結ばれた","むすばれた"],["とき"],["、"],["ホレブ"],["で"],["モーセ"],["が"],["納めた","おさめた"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"祭司たちが聖所から出ると――そこにいたすべての祭司たちは、組分けによる務めにかかわらず聖別されていた――、","tok":[["祭司","さいし"],["たち"],["が"],["聖","せい"],["所","しょ"],["から"],["出る","でる"],["と"],["―"],["―"],["そこ"],["に"],["いた"],["すべて"],["の"],["祭司","さいし"],["たち"],["は"],["、"],["組分け","くみわけ"],["に"],["よる"],["務め","つとめ"],["に"],["かかわらず"],["聖別","せいべつ"],["されて"],["いた"],["―"],["―"],["、"]]},{"verse":12,"text":"レビ人の詠唱者全員、すなわちアサフ、ヘマン、エドトンおよび彼らの子らと兄弟らは、麻布の衣をまとい、シンバル、竪琴、琴を持ち、百二十人のラッパ奏者の祭司たちと共に祭壇の東側に立っていた。","tok":[["レビ人","れびにん"],["の"],["詠唱者","えいしょうしゃ"],["全員","ぜんいん"],["、"],["すなわち"],["アサフ"],["、"],["ヘマン"],["、"],["エドトン"],["および"],["彼","かれ"],["ら"],["の"],["子","こ"],["ら"],["と"],["兄弟","きょうだい"],["ら"],["は"],["、"],["麻布","あざぶ"],["の"],["衣","ころも"],["を"],["まとい"],["、"],["シンバル"],["、"],["竪琴","たてごと"],["、"],["琴","こと"],["を"],["持ち","もち"],["、"],["百二","ひゃくに"],["十人","じゅうにん"],["の"],["ラッパ"],["奏者","そうしゃ"],["の"],["祭司","さいし"],["たち"],["と"],["共","とも"],["に"],["祭壇","さいだん"],["の"],["東側","ひがしがわ"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":13,"text":"ラッパ奏者と詠唱者は声を合わせて主を賛美し、ほめたたえた。そして、ラッパ、シンバルなどの楽器と共に声を張り上げ、「主は恵み深く、その慈しみはとこしえに」と主を賛美すると、雲が神殿、主の神殿に満ちた。","tok":[["ラッパ"],["奏者","そうしゃ"],["と"],["詠唱者","えいしょうしゃ"],["は"],["声","こえ"],["を"],["合わせて","あわせて"],["主","ぬし"],["を"],["賛美","さんび"],["し"],["、"],["ほめたたえた"],["。"],["そして"],["、"],["ラッパ"],["、"],["シンバル"],["など"],["の"],["楽器","がっき"],["と"],["共","とも"],["に"],["声","こえ"],["を"],["張り上げ","はりあげ"],["、"],["「"],["主","ぬし"],["は"],["恵み","めぐみ"],["深く","ふかく"],["、"],["その"],["慈しみ","いつくしみ"],["は"],["とこしえ"],["に"],["」"],["と"],["主","ぬし"],["を"],["賛美","さんび"],["する"],["と"],["、"],["雲","くも"],["が"],["神殿","しんでん"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["満ちた","みちた"],["。"]]},{"verse":14,"text":"その雲のために祭司たちは奉仕を続けることができなかった。主の栄光が神殿に満ちたからである。","tok":[["その"],["雲","くも"],["の"],["ため"],["に"],["祭司","さいし"],["たち"],["は"],["奉仕","ほうし"],["を"],["続ける","つづける"],["こと"],["が"],["できなかった"],["。"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["神殿","しんでん"],["に"],["満ちた","みちた"],["から"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"わたしに語りかけた御使いが戻って来て、わたしを起こした。わたしは眠りから揺り起こされた者のようであった。","tok":[["わたし"],["に"],["語りかけた","かたりかけた"],["御使い","おつかい"],["が"],["戻って","もどって"],["来て","きて"],["、"],["わたし"],["を"],["起こした","おこした"],["。"],["わたし"],["は"],["眠り","ねむり"],["から"],["揺り起こされた","ゆりおこされた"],["者","もの"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼はわたしに、「何を見ていたのか」と尋ねたので、わたしは答えた。「わたしが見ていたのは、すべてが金でできた燭台で、頭部には容器が置かれていました。その上に七つのともし火皿が付けられており、頭部に置かれているともし火皿には七つの管が付いていました。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["、"],["「"],["何","なん"],["を"],["見て","みて"],["いた"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["ので"],["、"],["わたし"],["は"],["答えた","こたえた"],["。"],["「"],["わたし"],["が"],["見て","みて"],["いた"],["の"],["は"],["、"],["すべて"],["が"],["金","かね"],["で"],["できた"],["燭台","しょくだい"],["で"],["、"],["頭部","とうぶ"],["に"],["は"],["容器","ようき"],["が"],["置かれて","おかれて"],["いました"],["。"],["その"],["上","うえ"],["に"],["七","なな"],["つ"],["の"],["ともし"],["火皿","ひざら"],["が"],["付けられて","つけられて"],["おり"],["、"],["頭部","とうぶ"],["に"],["置かれて","おかれて"],["いる"],["と"],["もし"],["火皿","ひざら"],["に"],["は"],["七","なな"],["つ"],["の"],["管","くだ"],["が"],["付いて","ついて"],["いました"],["。"]]},{"verse":3,"text":"その傍らに二本のオリーブの木があり、一つは容器の右に、一つは左に立っていました。」","tok":[["その"],["傍ら","かたわら"],["に"],["二本","にぽん"],["の"],["オリーブ"],["の"],["木","き"],["が"],["あり"],["、"],["一","ひと"],["つ"],["は"],["容器","ようき"],["の"],["右","みぎ"],["に"],["、"],["一","ひと"],["つ"],["は"],["左","ひだり"],["に"],["立って","たって"],["いました"],["。"],["」"]]},{"verse":4,"text":"わたしは言葉をついで、わたしに語りかけた御使いに言った。「主よ、これは何でしょうか。」","tok":[["わたし"],["は"],["言葉","ことば"],["を"],["ついで"],["、"],["わたし"],["に"],["語りかけた","かたりかけた"],["御使い","おつかい"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["これ"],["は"],["何","なん"],["でしょう"],["か"],["。"],["」"]]},{"verse":5,"text":"わたしに語りかけた御使いは答えて、「これが何か分からないのか」と言ったので、わたしが「主よ、分かりません」と言うと、","tok":[["わたし"],["に"],["語りかけた","かたりかけた"],["御使い","おつかい"],["は"],["答えて","こたえて"],["、"],["「"],["これ"],["が"],["何","なん"],["か"],["分からない","わからない"],["の"],["か"],["」"],["と"],["言った","いった"],["ので"],["、"],["わたし"],["が"],["「"],["主","ぬし"],["よ"],["、"],["分かりません","わかりません"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":6,"text":"彼は答えて、わたしに言った。「これがゼルバベルに向けられた主の言葉である。武力によらず、権力によらずただわが霊によって、と万軍の主は言われる。","tok":[["彼","かれ"],["は"],["答えて","こたえて"],["、"],["わたし"],["に"],["言った","いった"],["。"],["「"],["これ"],["が"],["ゼルバベル"],["に"],["向けられた","むけられた"],["主","ぬし"],["の"],["言葉","ことば"],["で"],["ある"],["。"],["武力","ぶりょく"],["に"],["よらず"],["、"],["権力","けんりょく"],["に"],["よらず"],["ただ"],["わが"],["霊","れい"],["によって"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":7,"text":"大いなる山よ、お前は何者かゼルバベルの前では平らにされる。彼が親石を取り出せば見事、見事と叫びがあがる。」","tok":[["大いなる","おおいなる"],["山","やま"],["よ"],["、"],["お前","おまえ"],["は"],["何者","なにもの"],["か"],["ゼルバベル"],["の"],["前","まえ"],["で"],["は"],["平ら","たいら"],["に"],["される"],["。"],["彼","かれ"],["が"],["親","おや"],["石","いし"],["を"],["取り出せば","とりだせば"],["見事","みごと"],["、"],["見事","みごと"],["と"],["叫び","さけび"],["が"],["あがる"],["。"],["」"]]},{"verse":8,"text":"また主の言葉がわたしに臨んだ。","tok":[["また"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":9,"text":"「ゼルバベルの手がこの家の基を据えた。彼自身の手がそれを完成するであろう。こうして、あなたは万軍の主がわたしをあなたたちに遣わされたことを知るようになる。","tok":[["「"],["ゼルバベル"],["の"],["手","て"],["が"],["この"],["家","いえ"],["の"],["基","もと"],["を"],["据えた","すえた"],["。"],["彼","かれ"],["自身","じしん"],["の"],["手","て"],["が"],["それ"],["を"],["完成","かんせい"],["するで"],["あろう"],["。"],["こう"],["して"],["、"],["あなた"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["わたし"],["を"],["あなた"],["たち"],["に"],["遣わされた","つかわされた"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":10,"text":"誰が初めのささやかな日をさげすむのか。ゼルバベルの手にある選び抜かれた石を見て喜び祝うべきである。その七つのものは、地上をくまなく見回る主の御目である。」","tok":[["誰","だれ"],["が"],["初め","はじめ"],["の"],["ささやか"],["な"],["日","ひ"],["を"],["さげすむ"],["の"],["か"],["。"],["ゼルバベル"],["の"],["手","て"],["に"],["ある"],["選び抜かれた","えらびぬかれた"],["石","いし"],["を"],["見て","みて"],["喜び祝うべきで","よろこびいわうべきで"],["ある"],["。"],["その"],["七","なな"],["つ"],["の"],["もの"],["は"],["、"],["地上","ちじょう"],["を"],["くまなく"],["見回る","みまわる"],["主","ぬし"],["の"],["御目","おめ"],["で"],["ある"],["。"],["」"]]},{"verse":11,"text":"わたしは言葉をついで御使いに尋ねた。「燭台の右と左にある、これら二本のオリーブの木は何ですか。」","tok":[["わたし"],["は"],["言葉","ことば"],["を"],["ついで"],["御使い","おつかい"],["に"],["尋ねた","たずねた"],["。"],["「"],["燭台","しょくだい"],["の"],["右","みぎ"],["と"],["左","ひだり"],["に"],["ある"],["、"],["これ"],["ら"],["二本","にぽん"],["の"],["オリーブ"],["の"],["木","き"],["は"],["何","なん"],["です"],["か"],["。"],["」"]]},{"verse":12,"text":"わたしは重ねて彼に尋ねた。「その二本のオリーブの木の枝先は何ですか。それは二本の金の管によって、そこから油を注ぎ出しています。」","tok":[["わたし"],["は"],["重ねて","かさねて"],["彼","かれ"],["に"],["尋ねた","たずねた"],["。"],["「"],["その"],["二本","にぽん"],["の"],["オリーブ"],["の"],["木","き"],["の"],["枝先","えださき"],["は"],["何","なん"],["です"],["か"],["。"],["それ"],["は"],["二本","にぽん"],["の"],["金","かね"],["の"],["管","くだ"],["によって"],["、"],["そこ"],["から"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["出して","だして"],["います"],["。"],["」"]]},{"verse":13,"text":"彼がわたしに、「これが何か分からないのか」と言ったので、わたしは「主よ、分かりません」と答えると、","tok":[["彼","かれ"],["が"],["わたし"],["に"],["、"],["「"],["これ"],["が"],["何","なん"],["か"],["分からない","わからない"],["の"],["か"],["」"],["と"],["言った","いった"],["ので"],["、"],["わたし"],["は"],["「"],["主","ぬし"],["よ"],["、"],["分かりません","わかりません"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":14,"text":"彼は、「これは全地の主の御前に立つ、二人の油注がれた人たちである」と言った。","tok":[["彼","かれ"],["は"],["、"],["「"],["これ"],["は"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["立つ","たつ"],["、"],["二人","ふたり"],["の"],["油","あぶら"],["注がれた","そそがれた"],["人","ひと"],["たち"],["で"],["ある"],["」"],["と"],["言った","いった"],["。"]]}]
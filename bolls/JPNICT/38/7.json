[{"verse":1,"text":"ダレイオス王の第四年になって、主の言葉がゼカリヤに臨んだ。それは九月、キスレウの月の四日のことであった。","tok":[["ダレイオス"],["王","おう"],["の"],["第","だい"],["四","よん"],["年","ねん"],["に"],["なって"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["ゼカリヤ"],["に"],["臨んだ","のぞんだ"],["。"],["それ"],["は"],["九","きゅう"],["月","がつ"],["、"],["キスレウ"],["の"],["月","つき"],["の"],["四日","よんか"],["の"],["こと"],["で"],["あった"],["。"]]},{"verse":2,"text":"ベテルはサル‧エツェルとレゲム‧メレクおよび彼の従者たちを遣わして、主の恵みを求めさせ、","tok":[["ベテル"],["は"],["サル"],["‧"],["エツェル"],["と"],["レゲム"],["‧"],["メレク"],["および"],["彼","かれ"],["の"],["従者","じゅうしゃ"],["たち"],["を"],["遣わして","つかわして"],["、"],["主","ぬし"],["の"],["恵み","めぐみ"],["を"],["求めさせ","もとめさせ"],["、"]]},{"verse":3,"text":"また万軍の主の神殿の祭司たち、および預言者たちに次のような質問をさせた。「わたしは、長年実行してきたように、五月には節制して悲しみのときを持つべきでしょうか。」","tok":[["また"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["祭司","さいし"],["たち"],["、"],["および"],["預言者","よげんしゃ"],["たち"],["に"],["次","つぎ"],["の"],["よう"],["な"],["質問","しつもん"],["を"],["させた"],["。"],["「"],["わたし"],["は"],["、"],["長年","ながねん"],["実行","じっこう"],["して"],["きた"],["よう"],["に"],["、"],["五","ご"],["月","がつ"],["に"],["は"],["節制","せっせい"],["して"],["悲しみ","かなしみ"],["の"],["とき"],["を"],["持つべきでしょう","もつべきでしょう"],["か"],["。"],["」"]]},{"verse":4,"text":"そのとき、万軍の主の言葉がわたしに臨んだ。","tok":[["その"],["とき"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":5,"text":"「国の民すべてに言いなさい。また祭司たちにも言いなさい。五月にも、七月にもあなたたちは断食し、嘆き悲しんできた。こうして七十年にもなるが果たして、真にわたしのために断食してきたか。","tok":[["「"],["国","くに"],["の"],["民","みん"],["すべて"],["に"],["言い","いい"],["なさい"],["。"],["また"],["祭司","さいし"],["たち"],["に"],["も"],["言い","いい"],["なさい"],["。"],["五","ご"],["月","がつ"],["に"],["も"],["、"],["七","なな"],["月","がつ"],["に"],["も"],["あなた"],["たち"],["は"],["断食","だんじき"],["し"],["、"],["嘆き悲しんで","なげきかなしんで"],["きた"],["。"],["こう"],["して"],["七十","ななじゅう"],["年","ねん"],["に"],["も"],["なる"],["が"],["果たして","はたして"],["、"],["真","しん"],["に"],["わたし"],["の"],["ため"],["に"],["断食","だんじき"],["して"],["きた"],["か"],["。"]]},{"verse":6,"text":"あなたたちは食べるにしても飲むにしても、ただあなたたち自身のために食べたり飲んだりしてきただけではないか。","tok":[["あなた"],["たち"],["は"],["食べる","たべる"],["に"],["して"],["も"],["飲む","のむ"],["に"],["して"],["も"],["、"],["ただ"],["あなた"],["たち"],["自身","じしん"],["の"],["ため"],["に"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["して"],["きた"],["だけ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":7,"text":"エルサレムとその周りの町々に人が住み、平穏であり、ネゲブにもシェフェラにも人が住んでいたころ、主が先の預言者たちによって呼びかけられた言葉を知らないのか。」","tok":[["エルサレム"],["と"],["その"],["周り","まわり"],["の"],["町々","まちまち"],["に"],["人","ひと"],["が"],["住み","すみ"],["、"],["平穏","へいおん"],["で"],["あり"],["、"],["ネゲブ"],["に"],["も"],["シェフェラ"],["に"],["も"],["人","ひと"],["が"],["住んで","すんで"],["いた"],["ころ"],["、"],["主","ぬし"],["が"],["先","さき"],["の"],["預言者","よげんしゃ"],["たち"],["によって"],["呼びかけられた","よびかけられた"],["言葉","ことば"],["を"],["知らない","しらない"],["の"],["か"],["。"],["」"]]},{"verse":8,"text":"そのとき、主の言葉がゼカリヤに臨んだ。","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["ゼカリヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":9,"text":"「万軍の主はこう言われる。正義と真理に基づいて裁き互いにいたわり合い、憐れみ深くあり","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["正義","まさよし"],["と"],["真理","しんり"],["に"],["基づいて","もとづいて"],["裁き","さばき"],["互い","たがい"],["に"],["いたわり合い","いたわりあい"],["、"],["憐れみ","あわれみ"],["深く","ふかく"],["あり"]]},{"verse":10,"text":"やもめ、みなしご寄留者、貧しい者らを虐げず互いに災いを心にたくらんではならない。」","tok":[["やもめ"],["、"],["みなしご"],["寄留者","きりゅうしゃ"],["、"],["貧しい","まずしい"],["者","もの"],["ら"],["を"],["虐げず","しいたげず"],["互い","たがい"],["に"],["災い","わざわい"],["を"],["心","こころ"],["に"],["たくらんで"],["は"],["ならない"],["。"],["」"]]},{"verse":11,"text":"ところが、彼らは耳を傾けることを拒み、かたくなに背を向け、耳を鈍くして聞こうとせず、","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["耳","みみ"],["を"],["傾ける","かたむける"],["こと"],["を"],["拒み","こばみ"],["、"],["かたくな"],["に"],["背","せ"],["を"],["向け","むけ"],["、"],["耳","みみ"],["を"],["鈍く","にぶく"],["して"],["聞こう","きこう"],["と"],["せず"],["、"]]},{"verse":12,"text":"心を石のように硬くして、万軍の主がその霊によって、先の預言者たちを通して与えられた律法と言葉を聞こうとしなかった。こうして万軍の主の怒りは激しく燃えた。","tok":[["心","こころ"],["を"],["石","いし"],["の"],["よう"],["に"],["硬く","かたく"],["して"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["その"],["霊","れい"],["によって"],["、"],["先","さき"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["与えられた","あたえられた"],["律法","りっぽう"],["と"],["言葉","ことば"],["を"],["聞こう","きこう"],["と"],["しなかった"],["。"],["こう"],["して"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["激しく","はげしく"],["燃えた","もえた"],["。"]]},{"verse":13,"text":"「わたしが呼びかけても彼らが聞かなかったように、彼らが呼びかけても、わたしは聞かない」と万軍の主は言われる。","tok":[["「"],["わたし"],["が"],["呼びかけて","よびかけて"],["も"],["彼","かれ"],["ら"],["が"],["聞かなかった","きかなかった"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["が"],["呼びかけて","よびかけて"],["も"],["、"],["わたし"],["は"],["聞かない","きかない"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"「わたしは彼らを、彼らの知らなかったあらゆる国に散らした。 その後に、地は荒れ果て、行き来する者もなくなった。 彼らは喜びの地を荒廃に帰させた。」","tok":[["「"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["彼","かれ"],["ら"],["の"],["知らなかった","しらなかった"],["あらゆる"],["国","くに"],["に"],["散らした","ちらした"],["。"],[" "],["その後","そのあと"],["に"],["、"],["地","ち"],["は"],["荒れ果て","あれはて"],["、"],["行き来","いきき"],["する"],["者","もの"],["も"],["なくなった"],["。"],[" "],["彼","かれ"],["ら"],["は"],["喜び","よろこび"],["の"],["地","ち"],["を"],["荒廃","こうはい"],["に"],["帰させた","かえさせた"],["。"],["」"]]}]
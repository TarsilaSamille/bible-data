[{"verse":1,"text":"わたしが再び目を留めて見ると、一つの巻物が飛んでいた。","tok":[["わたし"],["が"],["再び","ふたたび"],["目","め"],["を"],["留めて","とめて"],["見る","みる"],["と"],["、"],["一","ひと"],["つ"],["の"],["巻物","まきもの"],["が"],["飛んで","とんで"],["いた"],["。"]]},{"verse":2,"text":"御使いがわたしに、「何を見ているのか」と尋ねたので、わたしは答えた。「巻物が飛んでいるのが見えます。その長さは二十アンマ、幅は十アンマです。」","tok":[["御使い","おつかい"],["が"],["わたし"],["に"],["、"],["「"],["何","なん"],["を"],["見て","みて"],["いる"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["ので"],["、"],["わたし"],["は"],["答えた","こたえた"],["。"],["「"],["巻物","まきもの"],["が"],["飛んで","とんで"],["いる"],["の"],["が"],["見えます","みえます"],["。"],["その"],["長さ","ながさ"],["は"],["二十","にじゅう"],["アンマ"],["、"],["幅","はば"],["は"],["十","じゅう"],["アンマ"],["です"],["。"],["」"]]},{"verse":3,"text":"彼はわたしに言った。「これは全地に向かって出て行く呪いである。すべての盗人はその一方の面に記されている呪いに従って一掃される。また偽って誓う者も、他の面の呪いに従って一掃される。」","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["これ"],["は"],["全地","ぜんち"],["に"],["向かって","むかって"],["出て","でて"],["行く","いく"],["呪い","のろい"],["で"],["ある"],["。"],["すべて"],["の"],["盗人","ぬすびと"],["は"],["その"],["一方","いっぽう"],["の"],["面","めん"],["に"],["記されて","しるされて"],["いる"],["呪い","のろい"],["に"],["従って","したがって"],["一掃","いっそう"],["される"],["。"],["また"],["偽","にせ"],["って"],["誓う","ちかう"],["者","もの"],["も"],["、"],["他","た"],["の"],["面","めん"],["の"],["呪い","のろい"],["に"],["従って","したがって"],["一掃","いっそう"],["される"],["。"],["」"]]},{"verse":4,"text":"わたしがこれを送り出す、と万軍の主は言われる。それは盗人の家にわが名によって偽りの誓いをする者の家に入りその家の中に宿り梁も石ももろともに滅ぼし尽くす。","tok":[["わたし"],["が"],["これ"],["を"],["送り出す","おくりだす"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["それ"],["は"],["盗人","ぬすびと"],["の"],["家","いえ"],["に"],["わが"],["名","な"],["によって"],["偽り","いつわり"],["の"],["誓い","ちかい"],["を"],["する"],["者","もの"],["の"],["家","いえ"],["に"],["入り","はいり"],["その"],["家","いえ"],["の"],["中","なか"],["に"],["宿り","やどり"],["梁","はり"],["も"],["石","いし"],["も"],["もろとも"],["に"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"]]},{"verse":5,"text":"わたしに語りかけた御使いが現れ、わたしに言った。「目を留めて、そこに出て来るものが何であるか、よく見るがよい。」","tok":[["わたし"],["に"],["語りかけた","かたりかけた"],["御使い","おつかい"],["が"],["現れ","あらわれ"],["、"],["わたし"],["に"],["言った","いった"],["。"],["「"],["目","め"],["を"],["留めて","とめて"],["、"],["そこ"],["に"],["出て","でて"],["来る","くる"],["もの"],["が"],["何","なん"],["で"],["ある"],["か"],["、"],["よく"],["見る","みる"],["が"],["よい"],["。"],["」"]]},{"verse":6,"text":"わたしが、「それは何ですか」と尋ねると、彼は、「そこに出て来たのはエファ升である」と答え、「それは全地を見る彼らの目である」と言った。","tok":[["わたし"],["が"],["、"],["「"],["それ"],["は"],["何","なん"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["彼","かれ"],["は"],["、"],["「"],["そこ"],["に"],["出て","でて"],["来た","きた"],["の"],["は"],["エファ"],["升","ます"],["で"],["ある"],["」"],["と"],["答え","こたえ"],["、"],["「"],["それ"],["は"],["全地","ぜんち"],["を"],["見る","みる"],["彼","かれ"],["ら"],["の"],["目","め"],["で"],["ある"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"鉛の円盤が取り除かれると、エファ升の中に一人の女が座っていた。","tok":[["鉛","なまり"],["の"],["円盤","えんばん"],["が"],["取り除かれる","とりのぞかれる"],["と"],["、"],["エファ"],["升","ます"],["の"],["中","なか"],["に"],["一人","ひとり"],["の"],["女","おんな"],["が"],["座って","すわって"],["いた"],["。"]]},{"verse":8,"text":"彼は、「それは邪悪そのものである」と言って、かの女をエファ升の中に投げ返し、エファ升の口に鉛の重しを置いた。","tok":[["彼","かれ"],["は"],["、"],["「"],["それ"],["は"],["邪悪","じゃあく"],["その"],["もの"],["で"],["ある"],["」"],["と"],["言って","いって"],["、"],["かの"],["女","おんな"],["を"],["エファ"],["升","ます"],["の"],["中","なか"],["に"],["投げ返し","なげかえし"],["、"],["エファ"],["升","ます"],["の"],["口","くち"],["に"],["鉛","なまり"],["の"],["重し","おもし"],["を"],["置いた","おいた"],["。"]]},{"verse":9,"text":"わたしが目を留めて見ると、二人の女が翼に風を受けて出て来た。かの女たちはこうのとりの翼のような翼を持ち、地と天の間でエファ升を運び去ろうとしていた。","tok":[["わたし"],["が"],["目","め"],["を"],["留めて","とめて"],["見る","みる"],["と"],["、"],["二人","ふたり"],["の"],["女","おんな"],["が"],["翼","つばさ"],["に"],["風","かぜ"],["を"],["受けて","うけて"],["出て","でて"],["来た","きた"],["。"],["かの"],["女","おんな"],["たち"],["は"],["こうのとり"],["の"],["翼","つばさ"],["の"],["よう"],["な"],["翼","つばさ"],["を"],["持ち","もち"],["、"],["地","ち"],["と"],["天","てん"],["の"],["間","あいだ"],["で"],["エファ"],["升","ます"],["を"],["運び去ろう","はこびさろう"],["として"],["いた"],["。"]]},{"verse":10,"text":"わたしに語りかけた御使いに、「かの女たちはどこにエファ升を持って行こうとしているのですか」と尋ねると、","tok":[["わたし"],["に"],["語りかけた","かたりかけた"],["御使い","おつかい"],["に"],["、"],["「"],["かの"],["女","おんな"],["たち"],["は"],["どこ"],["に"],["エファ"],["升","ます"],["を"],["持って","もって"],["行こう","いこう"],["として"],["いる"],["の"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"]]},{"verse":11,"text":"彼はわたしに答えた。「かの女のため、シンアルの地に神殿を築こうとしているのだ。神殿が整えられると、その地に備えられた場所に置かれるはずだ。」","tok":[["彼","かれ"],["は"],["わたし"],["に"],["答えた","こたえた"],["。"],["「"],["かの"],["女","おんな"],["の"],["ため"],["、"],["シンアル"],["の"],["地","ち"],["に"],["神殿","しんでん"],["を"],["築こう","きずこう"],["として"],["いる"],["の"],["だ"],["。"],["神殿","しんでん"],["が"],["整えられる","ととのえられる"],["と"],["、"],["その"],["地","ち"],["に"],["備えられた","そなえられた"],["場所","ばしょ"],["に"],["置かれる","おかれる"],["はず"],["だ"],["。"],["」"]]}]
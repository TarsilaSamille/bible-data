[{"verse":1,"text":"春の雨の季節には、主に雨を求めよ。主は稲妻を放ち、彼らに豊かな雨を降らせすべての人に野の草を与えられる。","tok":[["春","はる"],["の"],["雨","あめ"],["の"],["季節","きせつ"],["に"],["は"],["、"],["主に","おもに"],["雨","あめ"],["を"],["求めよ","もとめよ"],["。"],["主","ぬし"],["は"],["稲妻","いなずま"],["を"],["放ち","はなち"],["、"],["彼","かれ"],["ら"],["に"],["豊か","ゆたか"],["な"],["雨","あめ"],["を"],["降らせ","ふらせ"],["すべて"],["の"],["人","ひと"],["に"],["野","の"],["の"],["草","くさ"],["を"],["与えられる","あたえられる"],["。"]]},{"verse":2,"text":"テラフィムは空虚なことを語り占い師は偽りを幻に見、虚偽の夢を語る。その慰めは空しい。それゆえ、人々は羊のようにさまよい羊飼いがいないので苦しむ。","tok":[["テラフィム"],["は"],["空虚","くうきょ"],["な"],["こと"],["を"],["語り","かたり"],["占い師","うらないし"],["は"],["偽り","いつわり"],["を"],["幻","まぼろし"],["に"],["見","み"],["、"],["虚偽","きょぎ"],["の"],["夢","ゆめ"],["を"],["語る","かたる"],["。"],["その"],["慰め","なぐさめ"],["は"],["空しい","むなしい"],["。"],["それ"],["ゆえ"],["、"],["人々","ひとびと"],["は"],["羊","ひつじ"],["の"],["よう"],["に"],["さまよい"],["羊飼い","ひつじかい"],["が"],["いない"],["ので"],["苦しむ","くるしむ"],["。"]]},{"verse":3,"text":"羊飼いたちに対して、わたしの怒りは燃える。わたしは雄山羊を罰する。万軍の主は御自分の羊の群れ、ユダの家を顧み彼らを輝かしい軍馬のようにされる。","tok":[["羊飼い","ひつじかい"],["たち"],["に対して","にたいして"],["、"],["わたし"],["の"],["怒り","いかり"],["は"],["燃える","もえる"],["。"],["わたし"],["は"],["雄山羊","おすやぎ"],["を"],["罰する","ばっする"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["、"],["ユダ"],["の"],["家","いえ"],["を"],["顧み","かえりみ"],["彼","かれ"],["ら"],["を"],["輝かしい","かがやかしい"],["軍馬","ぐんば"],["の"],["よう"],["に"],["される"],["。"]]},{"verse":4,"text":"彼らから隅の石が、彼らから杭が彼らから戦いの弓が彼らからすべての指揮者が出る。皆、","tok":[["彼","かれ"],["ら"],["から"],["隅","すみ"],["の"],["石","いし"],["が"],["、"],["彼","かれ"],["ら"],["から"],["杭","くい"],["が"],["彼","かれ"],["ら"],["から"],["戦い","たたかい"],["の"],["弓","ゆみ"],["が"],["彼","かれ"],["ら"],["から"],["すべて"],["の"],["指揮者","しきしゃ"],["が"],["出る","でる"],["。"],["皆","みな"],["、"]]},{"verse":5,"text":"勇士のようになり戦って野の土くれを踏みつける。主が共におられるので、彼らは戦いを挑み馬に乗る者らを慌てさせる。","tok":[["勇士","ゆうし"],["の"],["よう"],["に"],["なり"],["戦って","たたかって"],["野","の"],["の"],["土くれ","つちくれ"],["を"],["踏みつける","ふみつける"],["。"],["主","ぬし"],["が"],["共","とも"],["に"],["おられる"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["戦い","たたかい"],["を"],["挑み","いどみ"],["馬","うま"],["に"],["乗る","のる"],["者","もの"],["ら"],["を"],["慌てさせる","あわてさせる"],["。"]]},{"verse":6,"text":"わたしはユダの家に力を与えヨセフの家を救う。わたしは彼らを憐れむゆえに連れ戻す。彼らはわたしが退けなかった者のようになる。わたしは彼らの神なる主であり彼らの祈りに答えるからだ。","tok":[["わたし"],["は"],["ユダ"],["の"],["家","いえ"],["に"],["力","ちから"],["を"],["与え","あたえ"],["ヨセフ"],["の"],["家","いえ"],["を"],["救う","すくう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["憐れむ","あわれむ"],["ゆえ"],["に"],["連れ戻す","つれもどす"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["退けなかった","しりぞけなかった"],["者","もの"],["の"],["よう"],["に"],["なる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["なる"],["主","ぬし"],["で"],["あり"],["彼","かれ"],["ら"],["の"],["祈り","いのり"],["に"],["答える","こたえる"],["から"],["だ"],["。"]]},{"verse":7,"text":"エフライムは勇士のようになりぶどう酒を飲んだように、心は喜びに溢れる。その子らも見て喜び、心は主にあって躍る。","tok":[["エフライム"],["は"],["勇士","ゆうし"],["の"],["よう"],["に"],["なり"],["ぶどう酒","ぶどうしゅ"],["を"],["飲んだ","のんだ"],["よう"],["に"],["、"],["心","こころ"],["は"],["喜び","よろこび"],["に"],["溢れる","あふれる"],["。"],["その"],["子","こ"],["ら"],["も"],["見て","みて"],["喜び","よろこび"],["、"],["心","こころ"],["は"],["主に","おもに"],["あって"],["躍る","おどる"],["。"]]},{"verse":8,"text":"わたしは彼らを贖い口笛を吹いて集める。彼らはかつてのように再び多くなる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["贖い","あがない"],["口笛","くちぶえ"],["を"],["吹いて","ふいて"],["集める","あつめる"],["。"],["彼","かれ"],["ら"],["は"],["かつて"],["の"],["よう"],["に"],["再び","ふたたび"],["多く","おおく"],["なる"],["。"]]},{"verse":9,"text":"わたしは彼らを諸国の間にまき散らしたが遠い国にあっても彼らはわたしに心を留めその子らと共に生き続け、帰って来る。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["諸国","しょこく"],["の"],["間","あいだ"],["に"],["まき散らした","まきちらした"],["が"],["遠い","とおい"],["国","くに"],["に"],["あって"],["も"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["心","こころ"],["を"],["留め","とめ"],["その"],["子","こ"],["ら"],["と"],["共","とも"],["に"],["生き","いき"],["続け","つづけ"],["、"],["帰って","かえって"],["来る","くる"],["。"]]},{"verse":10,"text":"わたしは彼らをエジプトの地から帰らせアッシリアから呼び集めギレアドとレバノンの地に来させる。それらも彼らには十分ではないだろう。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["エジプト"],["の"],["地","ち"],["から"],["帰らせ","かえらせ"],["アッシリア"],["から"],["呼び集め","よびあつめ"],["ギレアド"],["と"],["レバノン"],["の"],["地","ち"],["に"],["来させる","きさせる"],["。"],["それ"],["ら"],["も"],["彼","かれ"],["ら"],["に"],["は"],["十分","じゅうぶん"],["で"],["は"],["ないだろう"],["。"]]},{"verse":11,"text":"彼らは苦しみの海を通って進み波立つ海を打つ。ナイルの深みはすべて干上がりアッシリアの高ぶりは引き降ろされエジプトの王笏は失われる。","tok":[["彼","かれ"],["ら"],["は"],["苦しみ","くるしみ"],["の"],["海","うみ"],["を"],["通って","とおって"],["進み","すすみ"],["波立つ","なみだつ"],["海","うみ"],["を"],["打つ","うつ"],["。"],["ナイル"],["の"],["深み","ふかみ"],["は"],["すべて"],["干上がり","ひあがり"],["アッシリア"],["の"],["高ぶり","たかぶり"],["は"],["引き降ろされ","ひきおろされ"],["エジプト"],["の"],["王笏","おうしゃく"],["は"],["失われる","うしなわれる"],["。"]]},{"verse":12,"text":"わたしは主にあって彼らに力を与える。彼らは御名において歩み続けると主は言われる。","tok":[["わたし"],["は"],["主に","おもに"],["あって"],["彼","かれ"],["ら"],["に"],["力","ちから"],["を"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["御名","ぎょめい"],["に"],["おいて"],["歩み","あゆみ"],["続ける","つづける"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
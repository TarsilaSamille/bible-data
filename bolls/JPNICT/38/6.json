[{"verse":1,"text":"わたしが再び目を留めて見ると、四両の戦車が二つの山の間から出て来た。その山は青銅の山であった。","tok":[["わたし"],["が"],["再び","ふたたび"],["目","め"],["を"],["留めて","とめて"],["見る","みる"],["と"],["、"],["四","よん"],["両","りょう"],["の"],["戦車","せんしゃ"],["が"],["二","ふた"],["つ"],["の"],["山","やま"],["の"],["間","あいだ"],["から"],["出て","でて"],["来た","きた"],["。"],["その"],["山","やま"],["は"],["青銅","せいどう"],["の"],["山","やま"],["で"],["あった"],["。"]]},{"verse":2,"text":"最初の戦車には赤毛の馬数頭、二番目の戦車には黒い馬数頭、","tok":[["最初","さいしょ"],["の"],["戦車","せんしゃ"],["に"],["は"],["赤毛","あかげ"],["の"],["馬","うま"],["数頭","すうとう"],["、"],["二番目","にばんめ"],["の"],["戦車","せんしゃ"],["に"],["は"],["黒い","くろい"],["馬","うま"],["数頭","すうとう"],["、"]]},{"verse":3,"text":"三番目の戦車には白い馬数頭、四番目の戦車にはまだらの強い馬数頭がつけられていた。","tok":[["三番目","さんばんめ"],["の"],["戦車","せんしゃ"],["に"],["は"],["白い","しろい"],["馬","うま"],["数頭","すうとう"],["、"],["四番目","よんばんめ"],["の"],["戦車","せんしゃ"],["に"],["は"],["まだら"],["の"],["強い","つよい"],["馬","うま"],["数頭","すうとう"],["が"],["つけられて"],["いた"],["。"]]},{"verse":4,"text":"わたしは言葉をついで、わたしに語りかけた御使いに、「主よ、これは何ですか」と尋ねると、","tok":[["わたし"],["は"],["言葉","ことば"],["を"],["ついで"],["、"],["わたし"],["に"],["語りかけた","かたりかけた"],["御使い","おつかい"],["に"],["、"],["「"],["主","ぬし"],["よ"],["、"],["これ"],["は"],["何","なん"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"]]},{"verse":5,"text":"御使いはわたしに言った。「これは天の四方に向かう風で、全地の主の御前に立った後に出て行くものである。","tok":[["御使い","おつかい"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["これ"],["は"],["天","てん"],["の"],["四方","しほう"],["に"],["向かう","むかう"],["風","ふう"],["で"],["、"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["立った","たった"],["後","あと"],["に"],["出て","でて"],["行く","いく"],["もの"],["で"],["ある"],["。"]]},{"verse":6,"text":"その中の黒い馬は北の国に向かって出て行き、白い馬は西の方へ出て行き、まだらの馬は南の国に向かって出て行く。」","tok":[["その"],["中","なか"],["の"],["黒い","くろい"],["馬","うま"],["は"],["北","きた"],["の"],["国","くに"],["に"],["向かって","むかって"],["出て","でて"],["行き","いき"],["、"],["白い","しろい"],["馬","うま"],["は"],["西","にし"],["の"],["方","ほう"],["へ"],["出て","でて"],["行き","いき"],["、"],["まだら"],["の"],["馬","うま"],["は"],["南","みなみ"],["の"],["国","くに"],["に"],["向かって","むかって"],["出て","でて"],["行く","いく"],["。"],["」"]]},{"verse":7,"text":"強い馬も出て来て、今にも飛び出して地上を行き巡ろうとしていたところ、彼が、「さあ地上を行き巡れ」と命じたので、彼らは地上を行き巡った。","tok":[["強い","つよい"],["馬","うま"],["も"],["出て","でて"],["来て","きて"],["、"],["今","いま"],["に"],["も"],["飛び出して","とびだして"],["地上","ちじょう"],["を"],["行き","いき"],["巡ろう","めぐろう"],["として"],["いた"],["ところ"],["、"],["彼","かれ"],["が"],["、"],["「"],["さあ"],["地上","ちじょう"],["を"],["行き","いき"],["巡れ","めぐれ"],["」"],["と"],["命じた","めいじた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["地上","ちじょう"],["を"],["行き","いき"],["巡った","めぐった"],["。"]]},{"verse":8,"text":"彼はわたしに叫びながら言った。「よく見るがよい。北の国に向かって出て行ったものが、わが霊を北の国にとどまらせた。」","tok":[["彼","かれ"],["は"],["わたし"],["に"],["叫び","さけび"],["ながら"],["言った","いった"],["。"],["「"],["よく"],["見る","みる"],["が"],["よい"],["。"],["北","きた"],["の"],["国","くに"],["に"],["向かって","むかって"],["出て","でて"],["行った","いった"],["もの"],["が"],["、"],["わが"],["霊","れい"],["を"],["北","きた"],["の"],["国","くに"],["に"],["とどまらせた"],["。"],["」"]]},{"verse":9,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":10,"text":"「帰還した捕囚の中から、ヘルダイ、トビヤ、エダヤの家族から、贈り物を受け取りなさい。あなたはその日のうちに、ツェファンヤの子ヨシヤの家に入りなさい。彼らはバビロンから帰ったばかりである。","tok":[["「"],["帰還","きかん"],["した"],["捕囚","ほしゅう"],["の"],["中","なか"],["から"],["、"],["ヘルダイ"],["、"],["トビヤ"],["、"],["エダヤ"],["の"],["家族","かぞく"],["から"],["、"],["贈り物","おくりもの"],["を"],["受け取り","うけとり"],["なさい"],["。"],["あなた"],["は"],["その"],["日","ひ"],["の"],["うち"],["に"],["、"],["ツェファンヤ"],["の"],["子","こ"],["ヨシヤ"],["の"],["家","いえ"],["に"],["入り","はいり"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["バビロン"],["から"],["帰った","かえった"],["ばかり"],["で"],["ある"],["。"]]},{"verse":11,"text":"銀と金を受け取り、冠をつくり、それをヨツァダクの子、大祭司ヨシュアの頭に載せて、","tok":[["銀","ぎん"],["と"],["金","かね"],["を"],["受け取り","うけとり"],["、"],["冠","かんむり"],["を"],["つくり"],["、"],["それ"],["を"],["ヨツァダク"],["の"],["子","こ"],["、"],["大","だい"],["祭司","さいし"],["ヨシュア"],["の"],["頭","あたま"],["に"],["載せて","のせて"],["、"]]},{"verse":12,"text":"宣言しなさい。万軍の主はこう言われる。見よ、これが『若枝』という名の人である。その足もとから若枝が萌えいでる。彼は主の神殿を建て直す。","tok":[["宣言","せんげん"],["し"],["なさい"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["これ"],["が"],["『"],["若枝","わかえだ"],["』"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["で"],["ある"],["。"],["その"],["足もと","あしもと"],["から"],["若枝","わかえだ"],["が"],["萌えいでる","もえいでる"],["。"],["彼","かれ"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["を"],["建て直す","たてなおす"],["。"]]},{"verse":13,"text":"彼こそ主の神殿を建て直し威光をまとい、王座に座して治める。その王座の傍らに祭司がいて平和の計画が二人の間に生ずる。","tok":[["彼","かれ"],["こそ"],["主","ぬし"],["の"],["神殿","しんでん"],["を"],["建て直し","たてなおし"],["威光","いこう"],["を"],["まとい"],["、"],["王座","おうざ"],["に"],["座して","ざして"],["治める","おさめる"],["。"],["その"],["王座","おうざ"],["の"],["傍ら","かたわら"],["に"],["祭司","さいし"],["が"],["いて"],["平和","へいわ"],["の"],["計画","けいかく"],["が"],["二人","ふたり"],["の"],["間","あいだ"],["に"],["生ずる","しょうずる"],["。"]]},{"verse":14,"text":"冠はヘレム、トビヤ、エダヤ、およびツェファンヤの子の好意を記念するものとして、主の神殿に置かれる。","tok":[["冠","かんむり"],["は"],["ヘレム"],["、"],["トビヤ"],["、"],["エダヤ"],["、"],["および"],["ツェファンヤ"],["の"],["子","こ"],["の"],["好意","こうい"],["を"],["記念","きねん"],["する"],["もの"],["として"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["置かれる","おかれる"],["。"]]},{"verse":15,"text":"遠方からも人々が来て、主の神殿の建築に携わる。」こうして、あなたたちがひたすらあなたたちの神である主の声に聞き従うなら、万軍の主がわたしをあなたたちに遣わされたことを知るようになる。","tok":[["遠方","えんぽう"],["から"],["も"],["人々","ひとびと"],["が"],["来て","きて"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["建築","けんちく"],["に"],["携わる","たずさわる"],["。"],["」"],["こう"],["して"],["、"],["あなた"],["たち"],["が"],["ひたすら"],["あなた"],["たち"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["声","こえ"],["に"],["聞き従うなら","ききしたがうなら"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["わたし"],["を"],["あなた"],["たち"],["に"],["遣わされた","つかわされた"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]}]
[{"verse":1,"text":"ダレイオスの第二年八月に、イドの孫でベレクヤの子である預言者ゼカリヤに主の言葉が臨んだ。","tok":[["ダレイオス"],["の"],["第","だい"],["二","に"],["年","ねん"],["八","はち"],["月","がつ"],["に"],["、"],["イド"],["の"],["孫","まご"],["で"],["ベレクヤ"],["の"],["子","こ"],["で"],["ある"],["預言者","よげんしゃ"],["ゼカリヤ"],["に"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「主はあなたたちの先祖に向かって激しく怒られた。","tok":[["「"],["主","ぬし"],["は"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["に"],["向かって","むかって"],["激しく","はげしく"],["怒られた","おこられた"],["。"]]},{"verse":3,"text":"あなたは彼らに言いなさい。万軍の主はこう言われる。わたしに立ち帰れ、と万軍の主は言われる。そうすれば、わたしもあなたたちのもとに立ち帰る、と万軍の主は言われる。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["に"],["立ち帰れ","たちかえれ"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["そう"],["すれば"],["、"],["わたし"],["も"],["あなた"],["たち"],["の"],["もと"],["に"],["立ち帰る","たちかえる"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":4,"text":"あなたたちは先祖のようであってはならない。先の預言者たちは彼らに、『万軍の主はこう言われる。悪の道と悪い行いを離れて、立ち帰れ』と呼びかけた。しかし、彼らはわたしに聞き従わず、耳を傾けなかった、と主は言われる。","tok":[["あなた"],["たち"],["は"],["先祖","せんぞ"],["の"],["よう"],["で"],["あって"],["は"],["ならない"],["。"],["先","さき"],["の"],["預言者","よげんしゃ"],["たち"],["は"],["彼","かれ"],["ら"],["に"],["、"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["悪","あく"],["の"],["道","みち"],["と"],["悪い","わるい"],["行い","おこない"],["を"],["離れて","はなれて"],["、"],["立ち帰れ","たちかえれ"],["』"],["と"],["呼びかけた","よびかけた"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["聞き従わず","ききしたがわず"],["、"],["耳","みみ"],["を"],["傾けなかった","かたむけなかった"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"その先祖たちは、今どこにいるか。預言者たちは永遠に生きているだろうか。","tok":[["その"],["先祖","せんぞ"],["たち"],["は"],["、"],["今","いま"],["どこ"],["に"],["いる"],["か"],["。"],["預言者","よげんしゃ"],["たち"],["は"],["永遠","えいえん"],["に"],["生きて","いきて"],["いるだろう"],["か"],["。"]]},{"verse":6,"text":"だが、わたしが僕である預言者たちに命じた言葉と掟は先祖たちに届かなかったろうか。彼らは立ち帰って言った。『万軍の主は、わたしたちの歩んだ道と行った業に従って、わたしたちを扱おうと思い定められ、そのようにされた。』」","tok":[["だ"],["が"],["、"],["わたし"],["が"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["に"],["命じた","めいじた"],["言葉","ことば"],["と"],["掟","おきて"],["は"],["先祖","せんぞ"],["たち"],["に"],["届かなかったろう","とどかなかったろう"],["か"],["。"],["彼","かれ"],["ら"],["は"],["立ち帰って","たちかえって"],["言った","いった"],["。"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["わたしたち"],["の"],["歩んだ","あゆんだ"],["道","みち"],["と"],["行った","いった"],["業","ごう"],["に"],["従って","したがって"],["、"],["わたしたち"],["を"],["扱おう","あつかおう"],["と"],["思い定められ","おもいさだめられ"],["、"],["その"],["よう"],["に"],["された"],["。"],["』"],["」"]]},{"verse":7,"text":"ダレイオスの第二年十一月、シェバトの月の二十四日に、イドの孫でベレクヤの子である預言者ゼカリヤに主の言葉が臨んだ。","tok":[["ダレイオス"],["の"],["第","だい"],["二","に"],["年","ねん"],["十一","じゅういち"],["月","がつ"],["、"],["シェバト"],["の"],["月","つき"],["の"],["二十四日","にじゅうよんか"],["に"],["、"],["イド"],["の"],["孫","まご"],["で"],["ベレクヤ"],["の"],["子","こ"],["で"],["ある"],["預言者","よげんしゃ"],["ゼカリヤ"],["に"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["臨んだ","のぞんだ"],["。"]]},{"verse":8,"text":"「その夜、わたしは見た。ひとりの人が赤毛の馬に乗って、谷底のミルトスの林の中に立っているではないか。その後ろには、赤毛の馬、栗毛の馬、白い馬がいた。","tok":[["「"],["その"],["夜","よる"],["、"],["わたし"],["は"],["見た","みた"],["。"],["ひとり"],["の"],["人","ひと"],["が"],["赤毛","あかげ"],["の"],["馬","うま"],["に"],["乗って","のって"],["、"],["谷底","たにそこ"],["の"],["ミルトス"],["の"],["林","はやし"],["の"],["中","なか"],["に"],["立って","たって"],["いるで"],["は"],["ない"],["か"],["。"],["その"],["後ろ","うしろ"],["に"],["は"],["、"],["赤毛","あかげ"],["の"],["馬","うま"],["、"],["栗毛","くりげ"],["の"],["馬","うま"],["、"],["白い","しろい"],["馬","うま"],["が"],["いた"],["。"]]},{"verse":9,"text":"わたしが、『わが主よ、これは何ですか』と尋ねると、ひとりの御使いがわたしに語りかけ、『それが何なのか、教えよう』と言った。","tok":[["わたし"],["が"],["、"],["『"],["わが"],["主","ぬし"],["よ"],["、"],["これ"],["は"],["何","なん"],["です"],["か"],["』"],["と"],["尋ねる","たずねる"],["と"],["、"],["ひとり"],["の"],["御使い","おつかい"],["が"],["わたし"],["に"],["語りかけ","かたりかけ"],["、"],["『"],["それ"],["が"],["何","なん"],["な"],["の"],["か"],["、"],["教えよう","おしえよう"],["』"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"すると、ミルトスの林の中に立っている人が答えて、『これらは地上を巡回させるため、主がお遣わしになったものだ』と言った。","tok":[["する"],["と"],["、"],["ミルトス"],["の"],["林","はやし"],["の"],["中","なか"],["に"],["立って","たって"],["いる"],["人","ひと"],["が"],["答えて","こたえて"],["、"],["『"],["これ"],["ら"],["は"],["地上","ちじょう"],["を"],["巡回","じゅんかい"],["させる"],["ため"],["、"],["主","ぬし"],["が"],["お遣わし","おつかわし"],["に"],["なった"],["もの"],["だ"],["』"],["と"],["言った","いった"],["。"]]},{"verse":11,"text":"彼らはミルトスの林の中に立っている主の御使いに向かって答えた。『わたしたちは地上を巡回して来ました。地上の人々はすべて安らかに暮らしています。』","tok":[["彼","かれ"],["ら"],["は"],["ミルトス"],["の"],["林","はやし"],["の"],["中","なか"],["に"],["立って","たって"],["いる"],["主","ぬし"],["の"],["御使い","おつかい"],["に"],["向かって","むかって"],["答えた","こたえた"],["。"],["『"],["わたしたち"],["は"],["地上","ちじょう"],["を"],["巡回","じゅんかい"],["して"],["来ました","きました"],["。"],["地上","ちじょう"],["の"],["人々","ひとびと"],["は"],["すべて"],["安らか","やすらか"],["に"],["暮らして","くらして"],["います"],["。"],["』"]]},{"verse":12,"text":"それに答えて、主の御使いは言った。『万軍の主よ、いつまでエルサレムとユダの町々を憐れんでくださらないのですか。あなたの怒りは七十年も続いています。』","tok":[["それ"],["に"],["答えて","こたえて"],["、"],["主","ぬし"],["の"],["御使い","おつかい"],["は"],["言った","いった"],["。"],["『"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["、"],["いつ"],["まで"],["エルサレム"],["と"],["ユダ"],["の"],["町々","まちまち"],["を"],["憐れんで","あわれんで"],["くださらない"],["の"],["です"],["か"],["。"],["あなた"],["の"],["怒り","いかり"],["は"],["七十","ななじゅう"],["年","ねん"],["も"],["続いて","つづいて"],["います"],["。"],["』"]]},{"verse":13,"text":"わたしに語りかけた御使いに、主は優しい言葉、慰めの言葉をもって答えられた。","tok":[["わたし"],["に"],["語りかけた","かたりかけた"],["御使い","おつかい"],["に"],["、"],["主","ぬし"],["は"],["優しい","やさしい"],["言葉","ことば"],["、"],["慰め","なぐさめ"],["の"],["言葉","ことば"],["を"],["もって"],["答えられた","こたえられた"],["。"]]},{"verse":14,"text":"わたしに語りかけた御使いはわたしに言った。『呼びかけて言え、万軍の主はこう言われる。わたしはエルサレムとシオンに激しい情熱を傾け","tok":[["わたし"],["に"],["語りかけた","かたりかけた"],["御使い","おつかい"],["は"],["わたし"],["に"],["言った","いった"],["。"],["『"],["呼びかけて","よびかけて"],["言え","いえ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["エルサレム"],["と"],["シオン"],["に"],["激しい","はげしい"],["情熱","じょうねつ"],["を"],["傾け","かたむけ"]]},{"verse":15,"text":"安穏にしている諸国の民に対して激しく怒る。わたしはわずかに怒っただけだが彼らはそれに乗じて災いをもたらした。","tok":[["安穏","あんのん"],["に"],["して"],["いる"],["諸国","しょこく"],["の"],["民","たみ"],["に対して","にたいして"],["激しく","はげしく"],["怒る","おこる"],["。"],["わたし"],["は"],["わずか"],["に"],["怒った","おこった"],["だけ"],["だ"],["が"],["彼","かれ"],["ら"],["は"],["それ"],["に"],["乗じて","じょうじて"],["災い","わざわい"],["を"],["もたらした"],["。"]]},{"verse":16,"text":"それゆえ、主はこう言われる。わたしは憐れみをもってエルサレムに帰りわが家をそこに建て直させると万軍の主はこう言われる。エルサレムには、測り縄が張られる。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["憐れみ","あわれみ"],["を"],["もって"],["エルサレム"],["に"],["帰り","かえり"],["わが家","わがや"],["を"],["そこ"],["に"],["建て直させる","たてなおさせる"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["エルサレム"],["に"],["は"],["、"],["測り","はかり"],["縄","なわ"],["が"],["張られる","はられる"],["。"]]},{"verse":17,"text":"再び、呼びかけて言え。万軍の主はこう言われる。わたしの町々は再び恵みで溢れ主はシオンを再び慰めエルサレムを再び選ばれる。』」","tok":[["再び","ふたたび"],["、"],["呼びかけて","よびかけて"],["言え","いえ"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["の"],["町々","まちまち"],["は"],["再び","ふたたび"],["恵み","めぐみ"],["で"],["溢れ","あふれ"],["主","ぬし"],["は"],["シオン"],["を"],["再び","ふたたび"],["慰め","なぐさめ"],["エルサレム"],["を"],["再び","ふたたび"],["選ばれる","えらばれる"],["。"],["』"],["」"]]}]
[{"verse":1,"text":"万軍の主の言葉が臨んだ。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「万軍の主はこう言われる。わたしはシオンに激しい熱情を注ぐ。激しい憤りをもって熱情を注ぐ。","tok":[["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["シオン"],["に"],["激しい","はげしい"],["熱情","ねつじょう"],["を"],["注ぐ","そそぐ"],["。"],["激しい","はげしい"],["憤り","いきどおり"],["を"],["もって"],["熱情","ねつじょう"],["を"],["注ぐ","そそぐ"],["。"]]},{"verse":3,"text":"主はこう言われる。わたしは再びシオンに来てエルサレムの真ん中に住まう。エルサレムは信頼に値する都と呼ばれ万軍の主の山は聖なる山と呼ばれる。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["再び","ふたたび"],["シオン"],["に"],["来て","きて"],["エルサレム"],["の"],["真ん中","まんなか"],["に"],["住まう","すまう"],["。"],["エルサレム"],["は"],["信頼","しんらい"],["に"],["値","あたい"],["する"],["都","みやこ"],["と"],["呼ばれ","よばれ"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["山","やま"],["は"],["聖","せい"],["なる"],["山","やま"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":4,"text":"万軍の主はこう言われる。エルサレムの広場には再び、老爺、老婆が座すようになるそれぞれ、長寿のゆえに杖を手にして。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["エルサレム"],["の"],["広場","ひろば"],["に"],["は"],["再び","ふたたび"],["、"],["老爺","ろうや"],["、"],["老婆","ろうば"],["が"],["座す","ざす"],["よう"],["に"],["なる"],["それぞれ"],["、"],["長寿","ちょうじゅ"],["の"],["ゆえ"],["に"],["杖","つえ"],["を"],["手","て"],["に"],["して"],["。"]]},{"verse":5,"text":"都の広場はわらべとおとめに溢れ彼らは広場で笑いさざめく。","tok":[["都","と"],["の"],["広場","ひろば"],["は"],["わらべ"],["と"],["おとめ"],["に"],["溢れ","あふれ"],["彼","かれ"],["ら"],["は"],["広場","ひろば"],["で"],["笑いさざめく","わらいさざめく"],["。"]]},{"verse":6,"text":"万軍の主はこう言われる。そのときになってこの民の残りの者が見て驚くことをわたしも見て驚くであろうかと万軍の主は言われる。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["その"],["とき"],["に"],["なって"],["この"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["が"],["見て","みて"],["驚く","おどろく"],["こと"],["を"],["わたし"],["も"],["見て","みて"],["驚くで","おどろくで"],["あろう"],["か"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":7,"text":"万軍の主はこう言われる。見よ、日が昇る国からも、日の沈む国からもわたしはわが民を救い出し","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["日","ひ"],["が"],["昇る","のぼる"],["国","くに"],["から"],["も"],["、"],["日","ひ"],["の"],["沈む","しずむ"],["国","くに"],["から"],["も"],["わたし"],["は"],["わが"],["民","たみ"],["を"],["救い出し","すくいだし"]]},{"verse":8,"text":"彼らを連れて来て、エルサレムに住まわせる。こうして、彼らはわたしの民となりわたしは真実と正義に基づいて彼らの神となる。","tok":[["彼","かれ"],["ら"],["を"],["連れて","つれて"],["来て","きて"],["、"],["エルサレム"],["に"],["住まわせる","すまわせる"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["わたし"],["は"],["真実","しんじつ"],["と"],["正義","せいぎ"],["に"],["基づいて","もとづいて"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":9,"text":"万軍の主はこう言われる。勇気を出せ。あなたたちは、近ごろこれらの言葉を預言者の口から、度々聞いているではないか。万軍の主の家である神殿の基礎が置かれ再建が始まった日から。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["勇気","ゆうき"],["を"],["出せ","だせ"],["。"],["あなた"],["たち"],["は"],["、"],["近ごろ","ちかごろ"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["預言者","よげんしゃ"],["の"],["口","くち"],["から"],["、"],["度々","たびたび"],["聞いて","きいて"],["いるで"],["は"],["ない"],["か"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["家","いえ"],["で"],["ある"],["神殿","しんでん"],["の"],["基礎","きそ"],["が"],["置かれ","おかれ"],["再建","さいけん"],["が"],["始まった","はじまった"],["日","ひ"],["から"],["。"]]},{"verse":10,"text":"以前には、人間の働きに報いはなく家畜も、働きの報いに何の食も得なかった。出入りするにも安全に敵から守られてはいなかった。わたしがすべての人を互いに思うがままにさせておいたからだ。","tok":[["以前","いぜん"],["に"],["は"],["、"],["人間","にんげん"],["の"],["働き","はたらき"],["に"],["報い","むくい"],["は"],["なく"],["家畜","かちく"],["も"],["、"],["働き","はたらき"],["の"],["報い","むくい"],["に"],["何","なん"],["の"],["食","しょく"],["も"],["得なかった","えなかった"],["。"],["出入り","でいり"],["する"],["に"],["も"],["安全","あんぜん"],["に"],["敵","てき"],["から"],["守られて","まもられて"],["は"],["いなかった"],["。"],["わたし"],["が"],["すべて"],["の"],["人","ひと"],["を"],["互い","たがい"],["に"],["思う","おもう"],["が"],["まま"],["に"],["させて"],["おいた"],["から"],["だ"],["。"]]},{"verse":11,"text":"しかし今、わたしはこの民の残りの者に対して以前のようではない、と万軍の主は言われる。","tok":[["しかし"],["今","いま"],["、"],["わたし"],["は"],["この"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["に対して","にたいして"],["
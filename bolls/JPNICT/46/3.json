[{"verse":1,"text":"兄弟たち、わたしはあなたがたには、霊の人に対するように語ることができず、肉の人、つまり、キリストとの関係では乳飲み子である人々に対するように語りました。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["は"],["、"],["霊","れい"],["の"],["人","ひと"],["に"],["対する","たいする"],["よう"],["に"],["語る","かたる"],["こと"],["が"],["できず"],["、"],["肉","にく"],["の"],["人","ひと"],["、"],["つまり"],["、"],["キリスト"],["と"],["の"],["関係","かんけい"],["で"],["は"],["乳飲み子","ちのみご"],["で"],["ある"],["人々","ひとびと"],["に"],["対する","たいする"],["よう"],["に"],["語りました","かたりました"],["。"]]},{"verse":2,"text":"わたしはあなたがたに乳を飲ませて、固い食物は与えませんでした。まだ固い物を口にすることができなかったからです。いや、今でもできません。","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["乳","ちち"],["を"],["飲ませて","のませて"],["、"],["固い","かたい"],["食物","しょくもつ"],["は"],["与えませんでした","あたえませんでした"],["。"],["まだ"],["固い","かたい"],["物","もの"],["を"],["口","くち"],["に"],["する"],["こと"],["が"],["できなかった"],["から"],["です"],["。"],["いや"],["、"],["今","いま"],["で"],["も"],["できません"],["。"]]},{"verse":3,"text":"相変わらず肉の人だからです。お互いの間にねたみや争いが絶えない以上、あなたがたは肉の人であり、ただの人として歩んでいる、ということになりはしませんか。","tok":[["相変わらず","あいかわらず"],["肉","にく"],["の"],["人","ひと"],["だ"],["から"],["です"],["。"],["お互い","おたがい"],["の"],["間","あいだ"],["に"],["ねたみ"],["や"],["争い","あらそい"],["が"],["絶えない","たえない"],["以上","いじょう"],["、"],["あなた"],["がた"],["は"],["肉","にく"],["の"],["人","ひと"],["で"],["あり"],["、"],["ただ"],["の"],["人","ひと"],["として"],["歩んで","あゆんで"],["いる"],["、"],["と"],["いう"],["こと"],["に"],["なり"],["は"],["しません"],["か"],["。"]]},{"verse":4,"text":"ある人が「わたしはパウロにつく」と言い、他の人が「わたしはアポロに」などと言っているとすれば、あなたがたは、ただの人にすぎないではありませんか。","tok":[["ある"],["人","ひと"],["が"],["「"],["わたし"],["は"],["パウロ"],["に"],["つく"],["」"],["と"],["言い","いい"],["、"],["他","た"],["の"],["人","ひと"],["が"],["「"],["わたし"],["は"],["アポロ"],["に"],["」"],["など"],["と"],["言って","いって"],["いる"],["と"],["すれば"],["、"],["あなた"],["がた"],["は"],["、"],["ただ"],["の"],["人","ひと"],["に"],["すぎないで"],["は"],["ありません"],["か"],["。"]]},{"verse":5,"text":"アポロとは何者か。また、パウロとは何者か。この二人は、あなたがたを信仰に導くためにそれぞれ主がお与えになった分に応じて仕えた者です。","tok":[["アポロ"],["と"],["は"],["何者","なにもの"],["か"],["。"],["また"],["、"],["パウロ"],["と"],["は"],["何者","なにもの"],["か"],["。"],["この"],["二人","ふたり"],["は"],["、"],["あなた"],["がた"],["を"],["信仰","しんこう"],["に"],["導く","みちびく"],["ため"],["に"],["それぞれ"],["主","ぬし"],["が"],["お与え","おあたえ"],["に"],["なった"],["分","ぶん"],["に"],["応じて","おうじて"],["仕えた","つかえた"],["者","もの"],["です"],["。"]]},{"verse":6,"text":"わたしは植え、アポロは水を注いだ。しかし、成長させてくださったのは神です。","tok":[["わたし"],["は"],["植え","うえ"],["、"],["アポロ"],["は"],["水","みず"],["を"],["注いだ","そそいだ"],["。"],["しかし"],["、"],["成長","せいちょう"],["させて"],["くださった"],["の"],["は"],["神","かみ"],["です"],["。"]]},{"verse":7,"text":"ですから、大切なのは、植える者でも水を注ぐ者でもなく、成長させてくださる神です。","tok":[["です"],["から"],["、"],["大切","たいせつ"],["な"],["の"],["は"],["、"],["植える","うえる"],["者","もの"],["で"],["も"],["水","みず"],["を"],["注ぐ","そそぐ"],["者","もの"],["で"],["も"],["なく"],["、"],["成長","せいちょう"],["させて"],["くださる"],["神","かみ"],["です"],["。"]]},{"verse":8,"text":"植える者と水を注ぐ者とは一つですが、それぞれが働きに応じて自分の報酬を受け取ることになります。","tok":[["植える","うえる"],["者","もの"],["と"],["水","みず"],["を"],["注ぐ","そそぐ"],["者","もの"],["と"],["は"],["一","ひと"],["つ"],["です"],["が"],["、"],["それぞれ"],["が"],["働き","はたらき"],["に"],["応じて","おうじて"],["自分","じぶん"],["の"],["報酬","ほうしゅう"],["を"],["受け取る","うけとる"],["こと"],["に"],["なります"],["。"]]},{"verse":9,"text":"わたしたちは神のために力を合わせて働く者であり、あなたがたは神の畑、神の建物なのです。","tok":[["わたしたち"],["は"],["神","かみ"],["の"],["ため"],["に"],["力","ちから"],["を"],["合わせて","あわせて"],["働く","はたらく"],["者","もの"],["で"],["あり"],["、"],["あなた"],["がた"],["は"],["神","かみ"],["の"],["畑","はたけ"],["、"],["神","かみ"],["の"],["建物","たてもの"],["な"],["の"],["です"],["。"]]},{"verse":10,"text":"わたしは、神からいただいた恵みによって、熟練した建築家のように土台を据えました。そして、他の人がその上に家を建てています。ただ、おのおの、どのように建てるかに注意すべきです。","tok":[["わたし"],["は"],["、"],["神","かみ"],["から"],["いただいた"],["恵み","めぐみ"],["によって"],["、"],["熟練","じゅくれん"],["した"],["建築家","けんちくか"],["の"],["よう"],["に"],["土台","どだい"],["を"],["据えました","すえました"],["。"],["そして"],["、"],["他","た"],["の"],["人","ひと"],["が"],["その"],["上","うえ"],["に"],["家","いえ"],["を"],["建てて","たてて"],["います"],["。"],["ただ"],["、"],["おのおの"],["、"],["どの"],["よう"],["に"],["建てる","たてる"],["か"],["に"],["注意","ちゅうい"],["すべきです"],["。"]]},{"verse":11,"text":"イエス‧キリストという既に据えられている土台を無視して、だれもほかの土台を据えることはできません。","tok":[["イエス"],["‧"],["キリスト"],["と"],["いう"],["既に","すでに"],["据えられて","すえられて"],["いる"],["土台","どだい"],["を"],["無視","むし"],["して"],["、"],["だれ"],["も"],["ほか"],["の"],["土台","どだい"],["を"],["据える","すえる"],["こと"],["は"],["できません"],["。"]]},{"verse":12,"text":"この土台の上に、だれかが金、銀、宝石、木、草、わらで家を建てる場合、","tok":[["この"],["土台","どだい"],["の"],["上","うえ"],["に"],["、"],["だれ"],["か"],["が"],["金","かね"],["、"],["銀","ぎん"],["、"],["宝石","ほうせき"],["、"],["木","き"],["、"],["草","くさ"],["、"],["わら"],["で"],["家","いえ"],["を"],["建てる","たてる"],["場合","ばあい"],["、"]]},{"verse":13,"text":"おのおのの仕事は明るみに出されます。かの日にそれは明らかにされるのです。なぜなら、かの日が火と共に現れ、その火はおのおのの仕事がどんなものであるかを吟味するからです。","tok":[["おのおの"],["の"],["仕事","しごと"],["は"],["明るみ","あかるみ"],["に"],["出されます","だされます"],["。"],["かの"],["日","ひ"],["に"],["それ"],["は"],["明らか","あきらか"],["に"],["される"],["の"],["です"],["。"],["なぜ"],["なら"],["、"],["かの"],["日","ひ"],["が"],["火","ひ"],["と"],["共","とも"],["に"],["現れ","あらわれ"],["、"],["その"],["火","ひ"],["は"],["おのおの"],["の"],["仕事","しごと"],["が"],["どんな"],["もの"],["で"],["ある"],["か"],["を"],["吟味","ぎんみ"],["する"],["から"],["です"],["。"]]},{"verse":14,"text":"だれかがその土台の上に建てた仕事が残れば、その人は報いを受けますが、","tok":[["だれ"],["か"],["が"],["その"],["土台","どだい"],["の"],["上","うえ"],["に"],["建てた","たてた"],["仕事","しごと"],["が"],["残れば","のこれば"],["、"],["その"],["人","ひと"],["は"],["報い","むくい"],["を"],["受けます","うけます"],["が"],["、"]]},{"verse":15,"text":"燃え尽きてしまえば、損害を受けます。ただ、その人は、火の中をくぐり抜けて来た者のように、救われます。","tok":[["燃え尽きて","もえつきて"],["しまえば"],["、"],["損害","そんがい"],["を"],["受けます","うけます"],["。"],["ただ"],["、"],["その"],["人","ひと"],["は"],["、"],["火","ひ"],["の"],["中","なか"],["を"],["くぐり抜けて","くぐりぬけて"],["来た","きた"],["者","もの"],["の"],["よう"],["に"],["、"],["救われます","すくわれます"],["。"]]},{"verse":16,"text":"あなたがたは、自分が神の神殿であり、神の霊が自分たちの内に住んでいることを知らないのですか。","tok":[["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["が"],["神","かみ"],["の"],["神殿","しんでん"],["で"],["あり"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["自分","じぶん"],["たち"],["の"],["内","うち"],["に"],["住んで","すんで"],["いる"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"]]},{"verse":17,"text":"神の神殿を壊す者がいれば、神はその人を滅ぼされるでしょう。神の神殿は聖なるものだからです。あなたがたはその神殿なのです。","tok":[["神","かみ"],["の"],["神殿","しんでん"],["を"],["壊す","こわす"],["者","もの"],["が"],["いれば"],["、"],["神","かみ"],["は"],["その"],["人","ひと"],["を"],["滅ぼされるでしょう","ほろぼされるでしょう"],["。"],["神","かみ"],["の"],["神殿","しんでん"],["は"],["聖","せい"],["なる"],["もの"],["だ"],["から"],["です"],["。"],["あなた"],["がた"],["は"],["その"],["神殿","しんでん"],["な"],["の"],["です"],["。"]]},{"verse":18,"text":"だれも自分を欺いてはなりません。もし、あなたがたのだれかが、自分はこの世で知恵のある者だと考えているなら、本当に知恵のある者となるために愚かな者になりなさい。","tok":[["だれ"],["も"],["自分","じぶん"],["を"],["欺いて","あざむいて"],["は"],["なりません"],["。"],["もし"],["、"],["あなた"],["がた"],["の"],["だれ"],["か"],["が"],["、"],["自分","じぶん"],["は"],["この世","このよ"],["で"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["だ"],["と"],["考えて","かんがえて"],["いるなら"],["、"],["本当","ほんとう"],["に"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["と"],["なる"],["ため"],["に"],["愚か","おろか"],["な"],["者","もの"],["に"],["なり"],["なさい"],["。"]]},{"verse":19,"text":"この世の知恵は、神の前では愚かなものだからです。「神は、知恵のある者たちをその悪賢さによって捕らえられる」と書いてあり、","tok":[["この世","このよ"],["の"],["知恵","ちえ"],["は"],["、"],["神","かみ"],["の"],["前","まえ"],["で"],["は"],["愚か","おろか"],["な"],["もの"],["だ"],["から"],["です"],["。"],["「"],["神","かみ"],["は"],["、"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["たち"],["を"],["その"],["悪賢","わるがしこ"],["さ"],["によって"],["捕らえられる","とらえられる"],["」"],["と"],["書いて","かいて"],["あり"],["、"]]},{"verse":20,"text":"また、「主は知っておられる、知恵のある者たちの論議がむなしいことを」とも書いてあります。","tok":[["また"],["、"],["「"],["主","ぬし"],["は"],["知って","しって"],["おられる"],["、"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["たち"],["の"],["論議","ろんぎ"],["が"],["むなしい"],["こと"],["を"],["」"],["と"],["も"],["書いて","かいて"],["あります"],["。"]]},{"verse":21,"text":"ですから、だれも人間を誇ってはなりません。すべては、あなたがたのものです。","tok":[["です"],["から"],["、"],["だれ"],["も"],["人間","にんげん"],["を"],["誇って","ほこって"],["は"],["なりません"],["。"],["すべて"],["は"],["、"],["あなた"],["がた"],["の"],["もの"],["です"],["。"]]},{"verse":22,"text":"パウロもアポロもケファも、世界も生も死も、今起こっていることも将来起こることも。一切はあなたがたのもの、","tok":[["パウロ"],["も"],["アポロ"],["も"],["ケファ"],["も"],["、"],["世界","せかい"],["も"],["生","なま"],["も"],["死","し"],["も"],["、"],["今","いま"],["起こって","おこって"],["いる"],["こと"],["も"],["将来","しょうらい"],["起こる","おこる"],["こと"],["も"],["。"],["一切","いっさい"],["は"],["あなた"],["がた"],["の"],["もの"],["、"]]},{"verse":23,"text":"あなたがたはキリストのもの、キリストは神のものなのです。","tok":[["あなた"],["がた"],["は"],["キリスト"],["の"],["もの"],["、"],["キリスト"],["は"],["神","かみ"],["の"],["もの"],["な"],["の"],["です"],["。"]]}]
[{"verse":1,"text":"たとえ、人々の異言、天使たちの異言を語ろうとも、愛がなければ、わたしは騒がしいどら、やかましいシンバル。","tok":[["たとえ"],["、"],["人々","ひとびと"],["の"],["異言","いげん"],["、"],["天使","てんし"],["たち"],["の"],["異言","いげん"],["を"],["語ろう","かたろう"],["とも"],["、"],["愛","あい"],["が"],["なければ"],["、"],["わたし"],["は"],["騒がしい","さわがしい"],["どら"],["、"],["やかましい"],["シンバル"],["。"]]},{"verse":2,"text":"たとえ、預言する賜物を持ち、あらゆる神秘とあらゆる知識に通じていようとも、たとえ、山を動かすほどの完全な信仰を持っていようとも、愛がなければ、無に等しい。","tok":[["たとえ"],["、"],["預言","よげん"],["する"],["賜物","たまもの"],["を"],["持ち","もち"],["、"],["あらゆる"],["神秘","しんぴ"],["と"],["あらゆる"],["知識","ちしき"],["に"],["通じて","つうじて"],["いよう"],["とも"],["、"],["たとえ"],["、"],["山","やま"],["を"],["動かす","うごかす"],["ほど"],["の"],["完全","かんぜん"],["な"],["信仰","しんこう"],["を"],["持って","もって"],["いよう"],["とも"],["、"],["愛","あい"],["が"],["なければ"],["、"],["無","む"],["に"],["等しい","ひとしい"],["。"]]},{"verse":3,"text":"全財産を貧しい人々のために使い尽くそうとも、誇ろうとしてわが身を死に引き渡そうとも、愛がなければ、わたしに何の益もない。","tok":[["全","ぜん"],["財産","ざいさん"],["を"],["貧しい","まずしい"],["人々","ひとびと"],["の"],["ため"],["に"],["使い尽くそう","つかいつくそう"],["とも"],["、"],["誇ろう","ほころう"],["として"],["わが"],["身","み"],["を"],["死に","しに"],["引き渡そう","ひきわたそう"],["とも"],["、"],["愛","あい"],["が"],["なければ"],["、"],["わたし"],["に"],["何","なん"],["の"],["益","えき"],["も"],["ない"],["。"]]},{"verse":4,"text":"愛は忍耐強い。愛は情け深い。ねたまない。愛は自慢せず、高ぶらない。","tok":[["愛","あい"],["は"],["忍耐","にんたい"],["強い","つよい"],["。"],["愛","あい"],["は"],["情け深い","なさけぶかい"],["。"],["ねたまない"],["。"],["愛","あい"],["は"],["自慢","じまん"],["せず"],["、"],["高ぶらない","たかぶらない"],["。"]]},{"verse":5,"text":"礼を失せず、自分の利益を求めず、いらだたず、恨みを抱かない。","tok":[["礼","れい"],["を"],["失せず","うせず"],["、"],["自分","じぶん"],["の"],["利益","りえき"],["を"],["求めず","もとめず"],["、"],["いらだたず"],["、"],["恨み","うらみ"],["を"],["抱かない","いだかない"],["。"]]},{"verse":6,"text":"不義を喜ばず、真実を喜ぶ。","tok":[["不義","ふぎ"],["を"],["喜ばず","よろこばず"],["、"],["真実","しんじつ"],["を"],["喜ぶ","よろこぶ"],["。"]]},{"verse":7,"text":"すべてを忍び、すべてを信じ、すべてを望み、すべてに耐える。","tok":[["すべて"],["を"],["忍び","しのび"],["、"],["すべて"],["を"],["信じ","しんじ"],["、"],["すべて"],["を"],["望み","のぞみ"],["、"],["すべて"],["に"],["耐える","たえる"],["。"]]},{"verse":8,"text":"愛は決して滅びない。預言は廃れ、異言はやみ、知識は廃れよう、","tok":[["愛","あい"],["は"],["決して","けっして"],["滅びない","ほろびない"],["。"],["預言","よげん"],["は"],["廃れ","すたれ"],["、"],["異言","いげん"],["は"],["やみ"],["、"],["知識","ちしき"],["は"],["廃れよう","すたれよう"],["、"]]},{"verse":9,"text":"わたしたちの知識は一部分、預言も一部分だから。","tok":[["わたしたち"],["の"],["知識","ちしき"],["は"],["一部分","いちぶぶん"],["、"],["預言","よげん"],["も"],["一部分","いちぶぶん"],["だ"],["から"],["。"]]},{"verse":10,"text":"完全なものが来たときには、部分的なものは廃れよう。","tok":[["完全","かんぜん"],["な"],["もの"],["が"],["来た","きた"],["とき"],["に"],["は"],["、"],["部分的","ぶぶんてき"],["な"],["もの"],["は"],["廃れよう","すたれよう"],["。"]]},{"verse":11,"text":"幼子だったとき、わたしは幼子のように話し、幼子のように思い、幼子のように考えていた。成人した今、幼子のことを棄てた。","tok":[["幼子","おさなご"],["だった"],["とき"],["、"],["わたし"],["は"],["幼子","おさなご"],["の"],["よう"],["に"],["話し","はなし"],["、"],["幼子","おさなご"],["の"],["よう"],["に"],["思い","おもい"],["、"],["幼子","おさなご"],["の"],["よう"],["に"],["考えて","かんがえて"],["いた"],["。"],["成人","せいじん"],["した"],["今","いま"],["、"],["幼子","おさなご"],["の"],["こと"],["を"],["棄てた","すてた"],["。"]]},{"verse":12,"text":"わたしたちは、今は、鏡におぼろに映ったものを見ている。だがそのときには、顔と顔とを合わせて見ることになる。わたしは、今は一部しか知らなくとも、そのときには、はっきり知られているようにはっきり知ることになる。","tok":[["わたしたち"],["は"],["、"],["今","いま"],["は"],["、"],["鏡","かがみ"],["に"],["おぼろ"],["に"],["映った","うつった"],["もの"],["を"],["見て","みて"],["いる"],["。"],["だ"],["が"],["その"],["とき"],["に"],["は"],["、"],["顔","かお"],["と"],["顔","かお"],["と"],["を"],["合わせて","あわせて"],["見る","みる"],["こと"],["に"],["なる"],["。"],["わたし"],["は"],["、"],["今","いま"],["は"],["一部","いちぶ"],["しか"],["知らなく","しらなく"],["とも"],["、"],["その"],["とき"],["に"],["は"],["、"],["はっきり"],["知られて","しられて"],["いる"],["よう"],["に"],["はっきり"],["知る","しる"],["こと"],["に"],["なる"],["。"]]},{"verse":13,"text":"それゆえ、信仰と、希望と、愛、この三つは、いつまでも残る。その中で最も大いなるものは、愛である。","tok":[["それ"],["ゆえ"],["、"],["信仰","しんこう"],["と"],["、"],["希望","きぼう"],["と"],["、"],["愛","あい"],["、"],["この"],["三","みっ"],["つ"],["は"],["、"],["いつ"],["まで"],["も"],["残る","のこる"],["。"],["その"],["中","なか"],["で"],["最も","もっとも"],["大いなる","おおいなる"],["もの"],["は"],["、"],["愛","あい"],["で"],["ある"],["。"]]}]
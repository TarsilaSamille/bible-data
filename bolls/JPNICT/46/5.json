[{"verse":1,"text":"現に聞くところによると、あなたがたの間にみだらな行いがあり、しかもそれは、異邦人の間にもないほどのみだらな行いで、ある人が父の妻をわがものとしているとのことです。","tok":[["現に","げんに"],["聞く","きく"],["ところ"],["に"],["よる"],["と"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["みだら"],["な"],["行い","おこない"],["が"],["あり"],["、"],["しかも"],["それ"],["は"],["、"],["異邦人","いほうじん"],["の"],["間","あいだ"],["に"],["も"],["ない"],["ほど"],["の"],["みだら"],["な"],["行い","おこない"],["で"],["、"],["ある"],["人","ひと"],["が"],["父","ちち"],["の"],["妻","つま"],["を"],["わが"],["もの"],["として"],["いる"],["と"],["の"],["こと"],["です"],["。"]]},{"verse":2,"text":"それにもかかわらず、あなたがたは高ぶっているのか。むしろ悲しんで、こんなことをする者を自分たちの間から除外すべきではなかったのですか。","tok":[["それ"],["に"],["も"],["かかわらず"],["、"],["あなた"],["がた"],["は"],["高ぶって","たかぶって"],["いる"],["の"],["か"],["。"],["むしろ"],["悲しんで","かなしんで"],["、"],["こんな"],["こと"],["を"],["する"],["者","もの"],["を"],["自分","じぶん"],["たち"],["の"],["間","あいだ"],["から"],["除外","じょがい"],["すべきで"],["は"],["なかった"],["の"],["です"],["か"],["。"]]},{"verse":3,"text":"わたしは体では離れていても霊ではそこにいて、現に居合わせた者のように、そんなことをした者を既に裁いてしまっています。","tok":[["わたし"],["は"],["体","からだ"],["で"],["は"],["離れて","はなれて"],["いて"],["も"],["霊","れい"],["で"],["は"],["そこ"],["に"],["いて"],["、"],["現に","げんに"],["居合わせた","いあわせた"],["者","もの"],["の"],["よう"],["に"],["、"],["そんな"],["こと"],["を"],["した"],["者","もの"],["を"],["既に","すでに"],["裁いて","さばいて"],["しまって"],["います"],["。"]]},{"verse":4,"text":"つまり、わたしたちの主イエスの名により、わたしたちの主イエスの力をもって、あなたがたとわたしの霊が集まり、","tok":[["つまり"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["の"],["名","な"],["に"],["より"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["の"],["力","ちから"],["を"],["もって"],["、"],["あなた"],["がた"],["と"],["わたし"],["の"],["霊","れい"],["が"],["集まり","あつまり"],["、"]]},{"verse":5,"text":"このような者を、その肉が滅ぼされるようにサタンに引き渡したのです。それは主の日に彼の霊が救われるためです。","tok":[["この"],["よう"],["な"],["者","もの"],["を"],["、"],["その"],["肉","にく"],["が"],["滅ぼされる","ほろぼされる"],["よう"],["に"],["サタン"],["に"],["引き渡した","ひきわたした"],["の"],["です"],["。"],["それ"],["は"],["主","ぬし"],["の"],["日","ひ"],["に"],["彼","かれ"],["の"],["霊","れい"],["が"],["救われる","すくわれる"],["ため"],["です"],["。"]]},{"verse":6,"text":"あなたがたが誇っているのは、よくない。わずかなパン種が練り粉全体を膨らませることを、知らないのですか。","tok":[["あなた"],["がた"],["が"],["誇って","ほこって"],["いる"],["の"],["は"],["、"],["よく"],["ない"],["。"],["わずか"],["な"],["パン種","ぱんだね"],["が"],["練り粉","ねりこ"],["全体","ぜんたい"],["を"],["膨らませる","ふくらませる"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["です"],["か"],["。"]]},{"verse":7,"text":"いつも新しい練り粉のままでいられるように、古いパン種をきれいに取り除きなさい。現に、あなたがたはパン種の入っていない者なのです。キリストが、わたしたちの過越の小羊として屠られたからです。","tok":[["いつも"],["新しい","あたらしい"],["練り粉","ねりこ"],["の"],["まま"],["で"],["いられる"],["よう"],["に"],["、"],["古い","ふるい"],["パン種","ぱんだね"],["を"],["きれい"],["に"],["取り除き","とりのぞき"],["なさい"],["。"],["現に","げんに"],["、"],["あなた"],["がた"],["は"],["パン種","ぱんだね"],["の"],["入って","はいって"],["いない"],["者","もの"],["な"],["の"],["です"],["。"],["キリスト"],["が"],["、"],["わたしたち"],["の"],["過越","すぎこし"],["の"],["小羊","こひつじ"],["として"],["屠られた","ほふられた"],["から"],["です"],["。"]]},{"verse":8,"text":"だから、古いパン種や悪意と邪悪のパン種を用いないで、パン種の入っていない、純粋で真実のパンで過越祭を祝おうではありませんか。","tok":[["だ"],["から"],["、"],["古い","ふるい"],["パン種","ぱんだね"],["や"],["悪意","あくい"],["と"],["邪悪","じゃあく"],["の"],["パン種","ぱんだね"],["を"],["用いないで","もちいないで"],["、"],["パン種","ぱんだね"],["の"],["入って","はいって"],["いない"],["、"],["純粋","じゅんすい"],["で"],["真実","しんじつ"],["の"],["パン"],["で"],["過越","すぎこし"],["祭","まつり"],["を"],["祝おうで","いわおうで"],["は"],["ありません"],["か"],["。"]]},{"verse":9,"text":"わたしは以前手紙で、みだらな者と交際してはいけないと書きましたが、","tok":[["わたし"],["は"],["以前","いぜん"],["手紙","てがみ"],["で"],["、"],["みだら"],["な"],["者","もの"],["と"],["交際","こうさい"],["して"],["は"],["いけない"],["と"],["書きました","かきました"],["が"],["、"]]},{"verse":10,"text":"その意味は、この世のみだらな者とか強欲な者、また、人の物を奪う者や偶像を礼拝する者たちと一切つきあってはならない、ということではありません。もし、そうだとしたら、あなたがたは世の中から出て行かねばならないでしょう。","tok":[["その"],["意味","いみ"],["は"],["、"],["この世","このよ"],["の"],["みだら"],["な"],["者","もの"],["と"],["か"],["強欲","ごうよく"],["な"],["者","もの"],["、"],["また"],["、"],["人","ひと"],["の"],["物","もの"],["を"],["奪う","うばう"],["者","もの"],["や"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["たち"],["と"],["一切","いっさい"],["つきあって"],["は"],["ならない"],["、"],["と"],["いう"],["こと"],["で"],["は"],["ありません"],["。"],["もし"],["、"],["そう"],["だ"],["と"],["したら"],["、"],["あなた"],["がた"],["は"],["世の中","よのなか"],["から"],["出て","でて"],["行かねば","いかねば"],["ならないでしょう"],["。"]]},{"verse":11,"text":"わたしが書いたのは、兄弟と呼ばれる人で、みだらな者、強欲な者、偶像を礼拝する者、人を悪く言う者、酒におぼれる者、人の物を奪う者がいれば、つきあうな、そのような人とは一緒に食事もするな、ということだったのです。","tok":[["わたし"],["が"],["書いた","かいた"],["の"],["は"],["、"],["兄弟","きょうだい"],["と"],["呼ばれる","よばれる"],["人","ひと"],["で"],["、"],["みだら"],["な"],["者","もの"],["、"],["強欲","ごうよく"],["な"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["、"],["人","ひと"],["を"],["悪く","わるく"],["言う","いう"],["者","もの"],["、"],["酒","さけ"],["に"],["おぼれる"],["者","もの"],["、"],["人","ひと"],["の"],["物","もの"],["を"],["奪う","うばう"],["者","もの"],["が"],["いれば"],["、"],["つきあう"],["な"],["、"],["その"],["よう"],["な"],["人","ひと"],["と"],["は"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["も"],["する"],["な"],["、"],["と"],["いう"],["こと"],["だった"],["の"],["です"],["。"]]},{"verse":12,"text":"外部の人々を裁くことは、わたしの務めでしょうか。内部の人々をこそ、あなたがたは裁くべきではありませんか。","tok":[["外部","がいぶ"],["の"],["人々","ひとびと"],["を"],["裁く","さばく"],["こと"],["は"],["、"],["わたし"],["の"],["務め","つとめ"],["でしょう"],["か"],["。"],["内部","ないぶ"],["の"],["人々","ひとびと"],["を"],["こそ"],["、"],["あなた"],["がた"],["は"],["裁くべきで","さばくべきで"],["は"],["ありません"],["か"],["。"]]},{"verse":13,"text":"外部の人々は神がお裁きになります。「あなたがたの中から悪い者を除き去りなさい。」","tok":[["外部","がいぶ"],["の"],["人々","ひとびと"],["は"],["神","かみ"],["が"],["お裁き","おさばき"],["に"],["なります"],["。"],["「"],["あなた"],["がた"],["の"],["中","なか"],["から"],["悪い","わるい"],["者","もの"],["を"],["除き去り","のぞきさり"],["なさい"],["。"],["」"]]}]
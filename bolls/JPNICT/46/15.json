[{"verse":1,"text":"兄弟たち、わたしがあなたがたに告げ知らせた福音を、ここでもう一度知らせます。これは、あなたがたが受け入れ、生活のよりどころとしている福音にほかなりません。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["告げ知らせた","つげしらせた"],["福音","ふくいん"],["を"],["、"],["ここ"],["で"],["もう"],["一度","いちど"],["知らせます","しらせます"],["。"],["これ"],["は"],["、"],["あなた"],["がた"],["が"],["受け入れ","うけいれ"],["、"],["生活","せいかつ"],["の"],["よりどころ"],["として"],["いる"],["福音","ふくいん"],["に"],["ほか"],["なりません"],["。"]]},{"verse":2,"text":"どんな言葉でわたしが福音を告げ知らせたか、しっかり覚えていれば、あなたがたはこの福音によって救われます。さもないと、あなたがたが信じたこと自体が、無駄になってしまうでしょう。","tok":[["どんな"],["言葉","ことば"],["で"],["わたし"],["が"],["福音","ふくいん"],["を"],["告げ知らせた","つげしらせた"],["か"],["、"],["しっかり"],["覚えて","おぼえて"],["いれば"],["、"],["あなた"],["がた"],["は"],["この"],["福音","ふくいん"],["によって"],["救われます","すくわれます"],["。"],["さも"],["ない"],["と"],["、"],["あなた"],["がた"],["が"],["信じた","しんじた"],["こと"],["自体","じたい"],["が"],["、"],["無駄","むだ"],["に"],["なって"],["しまうでしょう"],["。"]]},{"verse":3,"text":"最も大切なこととしてわたしがあなたがたに伝えたのは、わたしも受けたものです。すなわち、キリストが、聖書に書いてあるとおりわたしたちの罪のために死んだこと、","tok":[["最も","もっとも"],["大切","たいせつ"],["な"],["こと"],["として"],["わたし"],["が"],["あなた"],["がた"],["に"],["伝えた","つたえた"],["の"],["は"],["、"],["わたし"],["も"],["受けた","うけた"],["もの"],["です"],["。"],["すなわち"],["、"],["キリスト"],["が"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["とおり"],["わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["死んだ","しんだ"],["こと"],["、"]]},{"verse":4,"text":"葬られたこと、また、聖書に書いてあるとおり三日目に復活したこと、","tok":[["葬られた","ほうむられた"],["こと"],["、"],["また"],["、"],["聖書","せいしょ"],["に"],["書いて","かいて"],["ある"],["とおり"],["三日目","みっかめ"],["に"],["復活","ふっかつ"],["した"],["こと"],["、"]]},{"verse":5,"text":"ケファに現れ、その後十二人に現れたことです。","tok":[["ケファ"],["に"],["現れ","あらわれ"],["、"],["その"],["後","ご"],["十二人","じゅうににん"],["に"],["現れた","あらわれた"],["こと"],["です"],["。"]]},{"verse":6,"text":"次いで、五百人以上もの兄弟たちに同時に現れました。そのうちの何人かは既に眠りについたにしろ、大部分は今なお生き残っています。","tok":[["次いで","ついで"],["、"],["五百人","ごひゃくにん"],["以上","いじょう"],["も"],["の"],["兄弟","きょうだい"],["たち"],["に"],["同時","どうじ"],["に"],["現れました","あらわれました"],["。"],["その"],["うち"],["の"],["何人","なんにん"],["か"],["は"],["既に","すでに"],["眠り","ねむり"],["に"],["ついた"],["に"],["しろ"],["、"],["大部分","だいぶぶん"],["は"],["今","いま"],["なお"],["生き残って","いきのこって"],["います"],["。"]]},{"verse":7,"text":"次いで、ヤコブに現れ、その後すべての使徒に現れ、","tok":[["次いで","ついで"],["、"],["ヤコブ"],["に"],["現れ","あらわれ"],["、"],["その"],["後","ご"],["すべて"],["の"],["使徒","しと"],["に"],["現れ","あらわれ"],["、"]]},{"verse":8,"text":"そして最後に、月足らずで生まれたようなわたしにも現れました。","tok":[["そして"],["最後","さいご"],["に"],["、"],["月足らず","つきたらず"],["で"],["生まれた","うまれた"],["よう"],["な"],["わたし"],["に"],["も"],["現れました","あらわれました"],["。"]]},{"verse":9,"text":"わたしは、神の教会を迫害したのですから、使徒たちの中でもいちばん小さな者であり、使徒と呼ばれる値打ちのない者です。","tok":[["わたし"],["は"],["、"],["神","かみ"],["の"],["教会","きょうかい"],["を"],["迫害","はくがい"],["した"],["の"],["です"],["から"],["、"],["使徒","しと"],["たち"],["の"],["中","なか"],["で"],["も"],["いちばん"],["小さな","ちいさな"],["者","もの"],["で"],["あり"],["、"],["使徒","しと"],["と"],["呼ばれる","よばれる"],["値打ち","ねうち"],["の"],["ない"],["者","もの"],["です"],["。"]]},{"verse":10,"text":"神の恵みによって今日のわたしがあるのです。そして、わたしに与えられた神の恵みは無駄にならず、わたしは他のすべての使徒よりずっと多く働きました。しかし、働いたのは、実はわたしではなく、わたしと共にある神の恵みなのです。","tok":[["神","かみ"],["の"],["恵み","めぐみ"],["によって"],["今日","きょう"],["の"],["わたし"],["が"],["ある"],["の"],["です"],["。"],["そして"],["、"],["わたし"],["に"],["与えられた","あたえられた"],["神","かみ"],["の"],["恵み","めぐみ"],["は"],["無駄","むだ"],["に"],["ならず"],["、"],["わたし"],["は"],["他","た"],["の"],["すべて"],["の"],["使徒","しと"],["より"],["ずっと"],["多く","おおく"],["働きました","はたらきました"],["。"],["しかし"],["、"],["働いた","はたらいた"],["の"],["は"],["、"],["実","じつ"],["は"],["わたし"],["で"],["は"],["なく"],["、"],["わたし"],["と"],["共","とも"],["に"],["ある"],["神","かみ"],["の"],["恵み","めぐみ"],["な"],["の"],["です"],["。"]]},{"verse":11,"text":"とにかく、わたしにしても彼らにしても、このように宣べ伝えているのですし、あなたがたはこのように信じたのでした。","tok":[["とにかく"],["、"],["わたし"],["に"],["して"],["も"],["彼","かれ"],["ら"],["に"],["して"],["も"],["、"],["この"],["よう"],["に"],["宣べ伝えて","のべつたえて"],["いる"],["の"],["です"],["し"],["、"],["あなた"],["がた"],["は"],["この"],["よう"],["に"],["信じた","しんじた"],["の"],["でした"],["。"]]},{"verse":12,"text":"キリストは死者の中から復活した、と宣べ伝えられているのに、あなたがたの中のある者が、死者の復活などない、と言っているのはどういうわけですか。","tok":[["キリスト"],["は"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["した"],["、"],["と"],["宣べ伝えられて","のべつたえられて"],["いる"],["のに"],["、"],["あなた"],["がた"],["の"],["中","なか"],["の"],["ある"],["者","もの"],["が"],["、"],["死者","ししゃ"],["の"],["復活","ふっかつ"],["など"],["ない"],["、"],["と"],["言って","いって"],["いる"],["の"],["は"],["どういう"],["わけ"],["です"],["か"],["。"]]},{"verse":13,"text":"死者の復活がなければ、キリストも復活しなかったはずです。","tok":[["死者","ししゃ"],["の"],["復活","ふっかつ"],["が"],["なければ"],["、"],["キリスト"],["も"],["復活","ふっかつ"],["しなかった"],["はず"],["です"],["。"]]},{"verse":14,"text":"そして、キリストが復活しなかったのなら、わたしたちの宣教は無駄であるし、あなたがたの信仰も無駄です。","tok":[["そして"],["、"],["キリスト"],["が"],["復活","ふっかつ"],["しなかった"],["の"],["なら"],["、"],["わたしたち"],["の"],["宣教","せんきょう"],["は"],["無駄","むだ"],["で"],["ある"],["し"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["も"],["無駄","むだ"],["です"],["。"]]},{"verse":15,"text":"更に、わたしたちは神の偽証人とさえ見なされます。なぜなら、もし、本当に死者が復活しないなら、復活しなかったはずのキリストを神が復活させたと言って、神に反して証しをしたことになるからです。","tok":[["更に","さらに"],["、"],["わたしたち"],["は"],["神","かみ"],["の"],["偽証人","ぎしょうにん"],["と"],["さえ"],["見なされます","みなされます"],["。"],["なぜ"],["なら"],["、"],["もし"],["、"],["本当","ほんとう"],["に"],["死者","ししゃ"],["が"],["復活","ふっかつ"],["しないなら"],["、"],["復活","ふっかつ"],["しなかった"],["はず"],["の"],["キリスト"],["を"],["神","かみ"],["が"],["復活","ふっかつ"],["させた"],["と"],["言って","いって"],["、"],["神","かみ"],["に"],["反して","はんして"],["証し","あかし"],["を"],["した"],["こと"],["に"],["なる"],["から"],["です"],["。"]]},{"verse":16,"text":"死者が復活しないのなら、キリストも復活しなかったはずです。","tok":[["死者","ししゃ"],["が"],["復活","ふっかつ"],["しない"],["の"],["なら"],["、"],["キリスト"],["も"],["復活","ふっかつ"],["しなかった"],["はず"],["です"],["。"]]},{"verse":17,"text":"そして、キリストが復活しなかったのなら、あなたがたの信仰はむなしく、あなたがたは今もなお罪の中にあることになります。","tok":[["そして"],["、"],["キリスト"],["が"],["復活","ふっかつ"],["しなかった"],["の"],["なら"],["、"],["あなた"],["がた"],["の"],["信仰","しんこう"],["は"],["むなしく"],["、"],["あなた"],["がた"],["は"],["今","いま"],["も"],["なお"],["罪","つみ"],["の"],["中","なか"],["に"],["ある"],["こと"],["に"],["なります"],["。"]]},{"verse":18,"text":"そうだとすると、キリストを信じて眠りについた人々も滅んでしまったわけです。","tok":[["そう"],["だ"],["と"],["する"],["と"],["、"],["キリスト"],["を"],["信じて","しんじて"],["眠り","ねむり"],["に"],["ついた"],["人々","ひとびと"],["も"],["滅んで","ほろんで"],["しまった"],["わけ"],["です"],["。"]]},{"verse":19,"text":"この世の生活でキリストに望みをかけているだけだとすれば、わたしたちはすべての人の中で最も惨めな者です。","tok":[["この世","このよ"],["の"],["生活","せいかつ"],["で"],["キリスト"],["に"],["望み","のぞみ"],["を"],["かけて"],["いる"],["だけ"],["だ"],["と"],["すれば"],["、"],["わたしたち"],["は"],["すべて"],["の"],["人","ひと"],["の"],["中","なか"],["で"],["最も","もっとも"],["惨め","みじめ"],["な"],["者","もの"],["です"],["。"]]},{"verse":20,"text":"しかし、実際、キリストは死者の中から復活し、眠りについた人たちの初穂となられました。","tok":[["しかし"],["、"],["実際","じっさい"],["、"],["キリスト"],["は"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["し"],["、"],["眠り","ねむり"],["に"],["ついた"],["人","ひと"],["たち"],["の"],["初穂","はつほ"],["と"],["なられました"],["。"]]},{"verse":21,"text":"死が一人の人によって来たのだから、死者の復活も一人の人によって来るのです。","tok":[["死","し"],["が"],["一人","ひとり"],["の"],["人","ひと"],["によって"],["来た","きた"],["の"],["だ"],["から"],["、"],["死者","ししゃ"],["の"],["復活","ふっかつ"],["も"],["一人","ひとり"],["の"],["人","ひと"],["によって"],["来る","くる"],["の"],["です"],["。"]]},{"verse":22,"text":"つまり、アダムによってすべての人が死ぬことになったように、キリストによってすべての人が生かされることになるのです。","tok":[["つまり"],["、"],["アダム"],["によって"],["すべて"],["の"],["人","ひと"],["が"],["死ぬ","しぬ"],["こと"],["に"],["なった"],["よう"],["に"],["、"],["キリスト"],["によって"],["すべて"],["の"],["人","ひと"],["が"],["生かされる","いかされる"],["こと"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":23,"text":"ただ、一人一人にそれぞれ順序があります。最初にキリスト、次いで、キリストが来られるときに、キリストに属している人たち、","tok":[["ただ"],["、"],["一人一人","ひとりひとり"],["に"],["それぞれ"],["順序","じゅんじょ"],["が"],["あります"],["。"],["最初","さいしょ"],["に"],["キリスト"],["、"],["次いで","ついで"],["、"],["キリスト"],["が"],["来られる","こられる"],["とき"],["に"],["、"],["キリスト"],["に"],["属して","ぞくして"],["いる"],["人","ひと"],["たち"],["、"]]},{"verse":24,"text":"次いで、世の終わりが来ます。そのとき、キリストはすべての支配、すべての権威や勢力を滅ぼし、父である神に国を引き渡されます。","tok":[["次いで","ついで"],["、"],["世","よ"],["の"],["終わり","おわり"],["が"],["来ます","きます"],["。"],["その"],["とき"],["、"],["キリスト"],["は"],["すべて"],["の"],["支配","しはい"],["、"],["すべて"],["の"],["権威","けんい"],["や"],["勢力","せいりょく"],["を"],["滅ぼし","ほろぼし"],["、"],["父","ちち"],["で"],["ある"],["神","かみ"],["に"],["国","くに"],["を"],["引き渡されます","ひきわたされます"],["。"]]},{"verse":25,"text":"キリストはすべての敵を御自分の足の下に置くまで、国を支配されることになっているからです。","tok":[["キリスト"],["は"],["すべて"],["の"],["
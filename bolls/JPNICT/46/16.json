[{"verse":1,"text":"聖なる者たちのための募金については、わたしがガラテヤの諸教会に指示したように、あなたがたも実行しなさい。","tok":[["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["ため"],["の"],["募金","ぼきん"],["について"],["は"],["、"],["わたし"],["が"],["ガラテヤ"],["の"],["諸教","しょきょう"],["会","かい"],["に"],["指示","しじ"],["した"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["実行","じっこう"],["し"],["なさい"],["。"]]},{"verse":2,"text":"わたしがそちらに着いてから初めて募金が行われることのないように、週の初めの日にはいつも、各自収入に応じて、幾らかずつでも手もとに取って置きなさい。","tok":[["わたし"],["が"],["そちら"],["に"],["着いて","ついて"],["から"],["初めて","はじめて"],["募金","ぼきん"],["が"],["行われる","おこなわれる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["に"],["は"],["いつも"],["、"],["各自","かくじ"],["収入","しゅうにゅう"],["に"],["応じて","おうじて"],["、"],["幾ら","いくら"],["か"],["ずつ"],["で"],["も"],["手もと","てもと"],["に"],["取って","とって"],["置き","おき"],["なさい"],["。"]]},{"verse":3,"text":"そちらに着いたら、あなたがたから承認された人たちに手紙を持たせて、その贈り物を届けにエルサレムに行かせましょう。","tok":[["そちら"],["に"],["着いたら","ついたら"],["、"],["あなた"],["がた"],["から"],["承認","しょうにん"],["された"],["人","ひと"],["たち"],["に"],["手紙","てがみ"],["を"],["持たせて","もたせて"],["、"],["その"],["贈り物","おくりもの"],["を"],["届け","とどけ"],["に"],["エルサレム"],["に"],["行かせましょう","いかせましょう"],["。"]]},{"verse":4,"text":"わたしも行く方がよければ、その人たちはわたしと一緒に行くことになるでしょう。","tok":[["わたし"],["も"],["行く","いく"],["方","ほう"],["が"],["よければ"],["、"],["その"],["人","ひと"],["たち"],["は"],["わたし"],["と"],["一緒","いっしょ"],["に"],["行く","いく"],["こと"],["に"],["なるでしょう"],["。"]]},{"verse":5,"text":"わたしは、マケドニア経由でそちらへ行きます。マケドニア州を通りますから、","tok":[["わたし"],["は"],["、"],["マケドニア"],["経由","けいゆ"],["で"],["そちら"],["へ"],["行きます","いきます"],["。"],["マケドニア"],["州","しゅう"],["を"],["通ります","とおります"],["から"],["、"]]},{"verse":6,"text":"たぶんあなたがたのところに滞在し、場合によっては、冬を越すことになるかもしれません。そうなれば、次にどこに出かけるにしろ、あなたがたから送り出してもらえるでしょう。","tok":[["たぶん"],["あなた"],["がた"],["の"],["ところ"],["に"],["滞在","たいざい"],["し"],["、"],["場合","ばあい"],["によって"],["は"],["、"],["冬","ふゆ"],["を"],["越す","こす"],["こと"],["に"],["なる"],["か"],["も"],["しれません"],["。"],["そう"],["なれば"],["、"],["次","つぎ"],["に"],["どこ"],["に"],["出かける","でかける"],["に"],["しろ"],["、"],["あなた"],["がた"],["から"],["送り出して","おくりだして"],["もらえるでしょう"],["。"]]},{"verse":7,"text":"わたしは、今、旅のついでにあなたがたに会うようなことはしたくない。主が許してくだされば、しばらくあなたがたのところに滞在したいと思っています。","tok":[["わたし"],["は"],["、"],["今","いま"],["、"],["旅","たび"],["の"],["ついで"],["に"],["あなた"],["がた"],["に"],["会う","あう"],["よう"],["な"],["こと"],["は"],["したく"],["ない"],["。"],["主","ぬし"],["が"],["許して","ゆるして"],["くだされば"],["、"],["しばらく"],["あなた"],["がた"],["の"],["ところ"],["に"],["滞在","たいざい"],["したい"],["と"],["思って","おもって"],["います"],["。"]]},{"verse":8,"text":"しかし、五旬祭まではエフェソに滞在します。","tok":[["しかし"],["、"],["五","ご"],["旬","しゅん"],["祭","まつり"],["まで"],["は"],["エフェソ"],["に"],["滞在","たいざい"],["します"],["。"]]},{"verse":9,"text":"わたしの働きのために大きな門が開かれているだけでなく、反対者もたくさんいるからです。","tok":[["わたし"],["の"],["働き","はたらき"],["の"],["ため"],["に"],["大きな","おおきな"],["門","もん"],["が"],["開かれて","ひらかれて"],["いる"],["だけ"],["で"],["なく"],["、"],["反対者","はんたいしゃ"],["も"],["たくさん"],["いる"],["から"],["です"],["。"]]},{"verse":10,"text":"テモテがそちらに着いたら、あなたがたのところで心配なく過ごせるようお世話ください。わたしと同様、彼は主の仕事をしているのです。","tok":[["テモテ"],["が"],["そちら"],["に"],["着いたら","ついたら"],["、"],["あなた"],["がた"],["の"],["ところ"],["で"],["心配","しんぱい"],["なく"],["過ごせる","すごせる"],["よう"],["お世話","おせわ"],["ください"],["。"],["わたし"],["と"],["同様","どうよう"],["、"],["彼","かれ"],["は"],["主","ぬし"],["の"],["仕事","しごと"],["を"],["して"],["いる"],["の"],["です"],["。"]]},{"verse":11,"text":"だれも彼をないがしろにしてはならない。わたしのところに来るときには、安心して来られるように送り出してください。わたしは、彼が兄弟たちと一緒に来るのを、待っているのです。","tok":[["だれ"],["も"],["彼","かれ"],["を"],["ないがしろ"],["に"],["して"],["は"],["ならない"],["。"],["わたし"],["の"],["ところ"],["に"],["来る","くる"],["とき"],["に"],["は"],["、"],["安心","あんしん"],["して"],["来られる","こられる"],["よう"],["に"],["送り出して","おくりだして"],["ください"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["が"],["兄弟","きょうだい"],["たち"],["と"],["一緒","いっしょ"],["に"],["来る","くる"],["の"],["を"],["、"],["待って","まって"],["いる"],["の"],["です"],["。"]]},{"verse":12,"text":"兄弟アポロについては、兄弟たちと一緒にあなたがたのところに行くようにと、しきりに勧めたのですが、彼は今行く意志は全くありません。良い機会が来れば、行くことでしょう。","tok":[["兄弟","きょうだい"],["アポロ"],["について"],["は"],["、"],["兄弟","きょうだい"],["たち"],["と"],["一緒","いっしょ"],["に"],["あなた"],["がた"],["の"],["ところ"],["に"],["行く","いく"],["よう"],["に"],["と"],["、"],["しきり"],["に"],["勧めた","すすめた"],["の"],["です"],["が"],["、"],["彼","かれ"],["は"],["今","いま"],["行く","いく"],["意志","いし"],["は"],["全く","まったく"],["ありません"],["。"],["良い","よい"],["機会","きかい"],["が"],["来れば","くれば"],["、"],["行く","いく"],["こと"],["でしょう"],["。"]]},{"verse":13,"text":"目を覚ましていなさい。信仰に基づいてしっかり立ちなさい。雄々しく強く生きなさい。","tok":[["目","め"],["を"],["覚まして","さまして"],["い"],["なさい"],["。"],["信仰","しんこう"],["に"],["基づいて","もとづいて"],["しっかり"],["立ち","たち"],["なさい"],["。"],["雄々しく","おおしく"],["強く","つよく"],["生き","いき"],["なさい"],["。"]]},{"verse":14,"text":"何事も愛をもって行いなさい。","tok":[["何事","なにごと"],["も"],["愛","あい"],["を"],["もって"],["行い","おこない"],["なさい"],["。"]]},{"verse":15,"text":"兄弟たち、お願いします。あなたがたも知っているように、ステファナの一家は、アカイア州の初穂で、聖なる者たちに対して労を惜しまず世話をしてくれました。","tok":[["兄弟","きょうだい"],["たち"],["、"],["お願い","おねがい"],["します"],["。"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["よう"],["に"],["、"],["ステファナ"],["の"],["一家","いっか"],["は"],["、"],["アカイア"],["州","しゅう"],["の"],["初穂","はつほ"],["で"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["に対して","にたいして"],["労","ろう"],["を"],["惜しまず","おしまず"],["世話","せわ"],["を"],["して"],["くれました"],["。"]]},{"verse":16,"text":"どうか、あなたがたもこの人たちや、彼らと一緒に働き、労苦してきたすべての人々に従ってください。","tok":[["どう"],["か"],["、"],["あなた"],["がた"],["も"],["この"],["人","ひと"],["たち"],["や"],["、"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["働き","はたらき"],["、"],["労苦","ろうく"],["して"],["きた"],["すべて"],["の"],["人々","ひとびと"],["に"],["従って","したがって"],["ください"],["。"]]},{"verse":17,"text":"ステファナ、フォルトナト、アカイコが来てくれたので、大変うれしく思っています。この人たちは、あなたがたのいないときに、代わりを務めてくれました。","tok":[["ステファナ"],["、"],["フォルトナト"],["、"],["アカイコ"],["が"],["来て","きて"],["くれた"],["ので"],["、"],["大変","たいへん"],["うれしく"],["思って","おもって"],["います"],["。"],["この"],["人","ひと"],["たち"],["は"],["、"],["あなた"],["がた"],["の"],["いない"],["とき"],["に"],["、"],["代わり","かわり"],["を"],["務めて","つとめて"],["くれました"],["。"]]},{"verse":18,"text":"わたしとあなたがたとを元気づけてくれたのです。このような人たちを重んじてください。","tok":[["わたし"],["と"],["あなた"],["がた"],["と"],["を"],["元気","げんき"],["づけて"],["くれた"],["の"],["です"],["。"],["この"],["よう"],["な"],["人","ひと"],["たち"],["を"],["重んじて","おもんじて"],["ください"],["。"]]},{"verse":19,"text":"アジア州の諸教会があなたがたによろしくと言っています。アキラとプリスカが、その家に集まる教会の人々と共に、主においてあなたがたにくれぐれもよろしくとのことです。","tok":[["アジア州","あじあしゅう"],["の"],["諸教","しょきょう"],["会","かい"],["が"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["アキラ"],["と"],["プリスカ"],["が"],["、"],["その"],["家","いえ"],["に"],["集まる","あつまる"],["教会","きょうかい"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["、"],["主に","おもに"],["おいて"],["あなた"],["がた"],["に"],["くれぐれ"],["も"],["よろしく"],["と"],["の"],["こと"],["です"],["。"]]},{"verse":20,"text":"すべての兄弟があなたがたによろしくと言っています。あなたがたも、聖なる口づけによって互いに挨拶を交わしなさい。","tok":[["すべて"],["の"],["兄弟","きょうだい"],["が"],["あなた"],["がた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["あなた"],["がた"],["も"],["、"],["聖","せい"],["なる"],["口づけ","くちづけ"],["によって"],["互い","たがい"],["に"],["挨拶","あいさつ"],["を"],["交わし","かわし"],["なさい"],["。"]]},{"verse":21,"text":"わたしパウロが、自分の手で挨拶を記します。","tok":[["わたし"],["パウロ"],["が"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["挨拶","あいさつ"],["を"],["記します","しるします"],["。"]]},{"verse":22,"text":"主を愛さない者は、神から見捨てられるがいい。マラナ‧タ（主よ、来てください）。","tok":[["主","ぬし"],["を"],["愛さない","あいさない"],["者","もの"],["は"],["、"],["神","かみ"],["から"],["見捨てられる","みすてられる"],["が"],["いい"],["。"],["マラナ"],["‧"],["タ"],["（"],["主","ぬし"],["よ"],["、"],["来て","きて"],["ください"],["）"],["。"]]},{"verse":23,"text":"主イエスの恵みが、あなたがたと共にあるように。","tok":[["主","しゅ"],["イエス"],["の"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":24,"text":"わたしの愛が、キリスト‧イエスにおいてあなたがた一同と共にあるように。","tok":[["わたし"],["の"],["愛","あい"],["が"],["、"],["キリスト"],["‧"],["イエス"],["に"],["おいて"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
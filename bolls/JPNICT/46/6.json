[{"verse":1,"text":"あなたがたの間で、一人が仲間の者と争いを起こしたとき、聖なる者たちに訴え出ないで、正しくない人々に訴え出るようなことを、なぜするのです。","tok":[["あなた"],["がた"],["の"],["間","あいだ"],["で"],["、"],["一人","ひとり"],["が"],["仲間","なかま"],["の"],["者","もの"],["と"],["争い","あらそい"],["を"],["起こした","おこした"],["とき"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["に"],["訴え出ないで","うったえでないで"],["、"],["正しく","ただしく"],["ない"],["人々","ひとびと"],["に"],["訴え出る","うったえでる"],["よう"],["な"],["こと"],["を"],["、"],["なぜ"],["する"],["の"],["です"],["。"]]},{"verse":2,"text":"あなたがたは知らないのですか。聖なる者たちが世を裁くのです。世があなたがたによって裁かれるはずなのに、あなたがたにはささいな事件すら裁く力がないのですか。","tok":[["あなた"],["がた"],["は"],["知らない","しらない"],["の"],["です"],["か"],["。"],["聖","せい"],["なる"],["者","もの"],["たち"],["が"],["世","よ"],["を"],["裁く","さばく"],["の"],["です"],["。"],["世","よ"],["が"],["あなた"],["がた"],["によって"],["裁かれる","さばかれる"],["はず"],["な"],["のに"],["、"],["あなた"],["がた"],["に"],["は"],["ささい"],["な"],["事件","じけん"],["すら"],["裁く","さばく"],["力","ちから"],["が"],["ない"],["の"],["です"],["か"],["。"]]},{"verse":3,"text":"わたしたちが天使たちさえ裁く者だということを、知らないのですか。まして、日常の生活にかかわる事は言うまでもありません。","tok":[["わたしたち"],["が"],["天使","てんし"],["たち"],["さえ"],["裁く","さばく"],["者","もの"],["だ"],["と"],["いう"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["です"],["か"],["。"],["まして"],["、"],["日常","にちじょう"],["の"],["生活","せいかつ"],["に"],["かかわる"],["事","こと"],["は"],["言う","いう"],["まで"],["も"],["ありません"],["。"]]},{"verse":4,"text":"それなのに、あなたがたは、日常の生活にかかわる争いが起きると、教会では疎んじられている人たちを裁判官の席に着かせるのですか。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["がた"],["は"],["、"],["日常","にちじょう"],["の"],["生活","せいかつ"],["に"],["かかわる"],["争い","あらそい"],["が"],["起きる","おきる"],["と"],["、"],["教会","きょうかい"],["で"],["は"],["疎んじられて","うとんじられて"],["いる"],["人","ひと"],["たち"],["を"],["裁判官","さいばんかん"],["の"],["席","せき"],["に"],["着かせる","つかせる"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"あなたがたを恥じ入らせるために、わたしは言っています。あなたがたの中には、兄弟を仲裁できるような知恵のある者が、一人もいないのですか。","tok":[["あなた"],["がた"],["を"],["恥じ入らせる","はじいらせる"],["ため"],["に"],["、"],["わたし"],["は"],["言って","いって"],["います"],["。"],["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["、"],["兄弟","きょうだい"],["を"],["仲裁","ちゅうさい"],["できる"],["よう"],["な"],["知恵","ちえ"],["の"],["ある"],["者","もの"],["が"],["、"],["一人","ひとり"],["も"],["いない"],["の"],["です"],["か"],["。"]]},{"verse":6,"text":"兄弟が兄弟を訴えるのですか。しかも信仰のない人々の前で。","tok":[["兄弟","きょうだい"],["が"],["兄弟","きょうだい"],["を"],["訴える","うったえる"],["の"],["です"],["か"],["。"],["しかも"],["信仰","しんこう"],["の"],["ない"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["。"]]},{"verse":7,"text":"そもそも、あなたがたの間に裁判ざたがあること自体、既にあなたがたの負けです。なぜ、むしろ不義を甘んじて受けないのです。なぜ、むしろ奪われるままでいないのです。","tok":[["そもそも"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["裁判","さいばん"],["ざた"],["が"],["ある"],["こと"],["自体","じたい"],["、"],["既に","すでに"],["あなた"],["がた"],["の"],["負け","まけ"],["です"],["。"],["なぜ"],["、"],["むしろ"],["不義","ふぎ"],["を"],["甘んじて","あまんじて"],["受けない","うけない"],["の"],["です"],["。"],["なぜ"],["、"],["むしろ"],["奪われる","うばわれる"],["まま"],["で"],["いない"],["の"],["です"],["。"]]},{"verse":8,"text":"それどころか、あなたがたは不義を行い、奪い取っています。しかも、兄弟たちに対してそういうことをしている。","tok":[["それ"],["どころ"],["か"],["、"],["あなた"],["がた"],["は"],["不義","ふぎ"],["を"],["行い","おこない"],["、"],["奪い取って","うばいとって"],["います"],["。"],["しかも"],["、"],["兄弟","きょうだい"],["たち"],["に対して","にたいして"],["そう"],["いう"],["こと"],["を"],["して"],["いる"],["。"]]},{"verse":9,"text":"正しくない者が神の国を受け継げないことを、知らないのですか。思い違いをしてはいけない。みだらな者、偶像を礼拝する者、姦通する者、男娼、男色をする者、","tok":[["正しく","ただしく"],["ない"],["者","もの"],["が"],["神","かみ"],["の"],["国","くに"],["を"],["受け継げない","うけつげない"],["こと"],["を"],["、"],["知らない","しらない"],["の"],["です"],["か"],["。"],["思い違い","おもいちがい"],["を"],["して"],["は"],["いけない"],["。"],["みだら"],["な"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["、"],["姦通","かんつう"],["する"],["者","もの"],["、"],["男娼","だんしょう"],["、"],["男色","だんしょく"],["を"],["する"],["者","もの"],["、"]]},{"verse":10,"text":"泥棒、強欲な者、酒におぼれる者、人を悪く言う者、人の物を奪う者は、決して神の国を受け継ぐことができません。","tok":[["泥棒","どろぼう"],["、"],["強欲","ごうよく"],["な"],["者","もの"],["、"],["酒","さけ"],["に"],["おぼれる"],["者","もの"],["、"],["人","ひと"],["を"],["悪く","わるく"],["言う","いう"],["者","もの"],["、"],["人","ひと"],["の"],["物","もの"],["を"],["奪う","うばう"],["者","もの"],["は"],["、"],["決して","けっして"],["神","かみ"],["の"],["国","くに"],["を"],["受け継ぐ","うけつぐ"],["こと"],["が"],["できません"],["。"]]},{"verse":11,"text":"あなたがたの中にはそのような者もいました。しかし、主イエス‧キリストの名とわたしたちの神の霊によって洗われ、聖なる者とされ、義とされています。","tok":[["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["その"],["よう"],["な"],["者","もの"],["も"],["いました"],["。"],["しかし"],["、"],["主","しゅ"],["イエス"],["‧"],["キリスト"],["の"],["名","な"],["と"],["わたしたち"],["の"],["神","かみ"],["の"],["霊","れい"],["によって"],["洗われ","あらわれ"],["、"],["聖","せい"],["なる"],["者","もの"],["と"],["され"],["、"],["義","ぎ"],["と"],["されて"],["います"],["。"]]},{"verse":12,"text":"「わたしには、すべてのことが許されている。」しかし、すべてのことが益になるわけではない。「わたしには、すべてのことが許されている。」しかし、わたしは何事にも支配されはしない。","tok":[["「"],["わたし"],["に"],["は"],["、"],["すべて"],["の"],["こと"],["が"],["許されて","ゆるされて"],["いる"],["。"],["」"],["しかし"],["、"],["すべて"],["の"],["こと"],["が"],["益","えき"],["に"],["なる"],["わけ"],["で"],["は"],["ない"],["。"],["「"],["わたし"],["に"],["は"],["、"],["すべて"],["の"],["こと"],["が"],["許されて","ゆるされて"],["いる"],["。"],["」"],["しかし"],["、"],["わたし"],["は"],["何事","なにごと"],["に"],["も"],["支配","しはい"],["され"],["は"],["しない"],["。"]]},{"verse":13,"text":"食物は腹のため、腹は食物のためにあるが、神はそのいずれをも滅ぼされます。体はみだらな行いのためではなく、主のためにあり、主は体のためにおられるのです。","tok":[["食物","しょくもつ"],["は"],["腹","はら"],["の"],["ため"],["、"],["腹","はら"],["は"],["食物","しょくもつ"],["の"],["ため"],["に"],["ある"],["が"],["、"],["神","かみ"],["は"],["その"],["いずれ"],["を"],["も"],["滅ぼされます","ほろぼされます"],["。"],["体","からだ"],["は"],["みだら"],["な"],["行い","おこない"],["の"],["ため"],["で"],["は"],["なく"],["、"],["主","ぬし"],["の"],["ため"],["に"],["あり"],["、"],["主","ぬし"],["は"],["体","からだ"],["の"],["ため"],["に"],["おられる"],["の"],["です"],["。"]]},{"verse":14,"text":"神は、主を復活させ、また、その力によってわたしたちをも復活させてくださいます。","tok":[["神","かみ"],["は"],["、"],["主","ぬし"],["を"],["復活","ふっかつ"],["させ"],["、"],["また"],["、"],["その"],["力","ちから"],["によって"],["わたしたち"],["を"],["も"],["復活","ふっかつ"],["させて"],["くださいます"],["。"]]},{"verse":15,"text":"あなたがたは、自分の体がキリストの体の一部だとは知らないのか。キリストの体の一部を娼婦の体の一部としてもよいのか。決してそうではない。","tok":[["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["の"],["体","からだ"],["が"],["キリスト"],["の"],["体","からだ"],["の"],["一部","いちぶ"],["だ"],["と"],["は"],["知らない","しらない"],["の"],["か"],["。"],["キリスト"],["の"],["体","からだ"],["の"],["一部","いちぶ"],["を"],["娼婦","しょうふ"],["の"],["体","からだ"],["の"],["一部","いちぶ"],["として"],["も"],["よい"],["の"],["か"],["。"],["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"]]},{"verse":16,"text":"娼婦と交わる者はその女と一つの体となる、ということを知らないのですか。「二人は一体となる」と言われています。","tok":[["娼婦","しょうふ"],["と"],["交わる","まじわる"],["者","もの"],["は"],["その"],["女","おんな"],["と"],["一","ひと"],["つ"],["の"],["体","からだ"],["と"],["なる"],["、"],["と"],["いう"],["こと"],["を"],["知らない","しらない"],["の"],["です"],["か"],["。"],["「"],["二人","ふたり"],["は"],["一体","いったい"],["と"],["なる"],["」"],["と"],["言われて","いわれて"],["います"],["。"]]},{"verse":17,"text":"しかし、主に結び付く者は主と一つの霊となるのです。","tok":[["しかし"],["、"],["主に","おもに"],["結び付く","むすびつく"],["者","もの"],["は"],["主","ぬし"],["と"],["一","ひと"],["つ"],["の"],["霊","れい"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":18,"text":"みだらな行いを避けなさい。人が犯す罪はすべて体の外にあります。しかし、みだらな行いをする者は、自分の体に対して罪を犯しているのです。","tok":[["みだら"],["な"],["行い","おこない"],["を"],["避け","さけ"],["なさい"],["。"],["人","ひと"],["が"],["犯す","おかす"],["罪","つみ"],["は"],["すべて"],["体","からだ"],["の"],["外","そと"],["に"],["あります"],["。"],["しかし"],["、"],["みだら"],["な"],["行い","おこない"],["を"],["する"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["体","からだ"],["に対して","にたいして"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["の"],["です"],["。"]]},{"verse":19,"text":"知らないのですか。あなたがたの体は、神からいただいた聖霊が宿ってくださる神殿であり、あなたがたはもはや自分自身のものではないのです。","tok":[["知らない","しらない"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["の"],["体","からだ"],["は"],["、"],["神","かみ"],["から"],["いただいた"],["聖霊","せいれい"],["が"],["宿って","やどって"],["くださる"],["神殿","しんでん"],["で"],["あり"],["、"],["あなた"],["がた"],["は"],["もはや"],["自分","じぶん"],["自身","じしん"],["の"],["もの"],["で"],["は"],["ない"],["の"],["です"],["。"]]},{"verse":20,"text":"あなたがたは、代価を払って買い取られたのです。だから、自分の体で神の栄光を現しなさい。","tok":[["あなた"],["がた"],["は"],["、"],["代価","だいか"],["を"],["払って","はらって"],["買い取られた","かいとられた"],["の"],["です"],["。"],["だ"],["から"],["、"],["自分","じぶん"],["の"],["体","からだ"],["で"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["現し","あらわし"],["なさい"],["。"]]}]
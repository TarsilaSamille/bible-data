[{"verse":1,"text":"兄弟たち、わたしもそちらに行ったとき、神の秘められた計画を宣べ伝えるのに優れた言葉や知恵を用いませんでした。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたし"],["も"],["そちら"],["に"],["行った","いった"],["とき"],["、"],["神","かみ"],["の"],["秘められた","ひめられた"],["計画","けいかく"],["を"],["宣べ伝える","のべつたえる"],["のに"],["優れた","すぐれた"],["言葉","ことば"],["や"],["知恵","ちえ"],["を"],["用いませんでした","もちいませんでした"],["。"]]},{"verse":2,"text":"なぜなら、わたしはあなたがたの間で、イエス‧キリスト、それも十字架につけられたキリスト以外、何も知るまいと心に決めていたからです。","tok":[["なぜ"],["なら"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["、"],["イエス"],["‧"],["キリスト"],["、"],["それ"],["も"],["十字架","じゅうじか"],["に"],["つけられた"],["キリスト"],["以外","いがい"],["、"],["何","なん"],["も"],["知るまい","しるまい"],["と"],["心","こころ"],["に"],["決めて","きめて"],["いた"],["から"],["です"],["。"]]},{"verse":3,"text":"そちらに行ったとき、わたしは衰弱していて、恐れに取りつかれ、ひどく不安でした。","tok":[["そちら"],["に"],["行った","いった"],["とき"],["、"],["わたし"],["は"],["衰弱","すいじゃく"],["して"],["いて"],["、"],["恐れ","おそれ"],["に"],["取りつかれ","とりつかれ"],["、"],["ひどく"],["不安","ふあん"],["でした"],["。"]]},{"verse":4,"text":"わたしの言葉もわたしの宣教も、知恵にあふれた言葉によらず、“霊”と力の証明によるものでした。","tok":[["わたし"],["の"],["言葉","ことば"],["も"],["わたし"],["の"],["宣教","せんきょう"],["も"],["、"],["知恵","ちえ"],["に"],["あふれた"],["言葉","ことば"],["に"],["よらず"],["、"],["“"],["霊","れい"],["”"],["と"],["力","ちから"],["の"],["証明","しょうめい"],["に"],["よる"],["もの"],["でした"],["。"]]},{"verse":5,"text":"それは、あなたがたが人の知恵によってではなく、神の力によって信じるようになるためでした。","tok":[["それ"],["は"],["、"],["あなた"],["がた"],["が"],["人","ひと"],["の"],["知恵","ちえ"],["によって"],["で"],["は"],["なく"],["、"],["神","かみ"],["の"],["力","ちから"],["によって"],["信じる","しんじる"],["よう"],["に"],["なる"],["ため"],["でした"],["。"]]},{"verse":6,"text":"しかし、わたしたちは、信仰に成熟した人たちの間では知恵を語ります。それはこの世の知恵ではなく、また、この世の滅びゆく支配者たちの知恵でもありません。","tok":[["しかし"],["、"],["わたしたち"],["は"],["、"],["信仰","しんこう"],["に"],["成熟","せいじゅく"],["した"],["人","ひと"],["たち"],["の"],["間","あいだ"],["で"],["は"],["知恵","ちえ"],["を"],["語ります","かたります"],["。"],["それ"],["は"],["この世","このよ"],["の"],["知恵","ちえ"],["で"],["は"],["なく"],["、"],["また"],["、"],["この世","このよ"],["の"],["滅び","ほろび"],["ゆく"],["支配者","しはいしゃ"],["たち"],["の"],["知恵","ちえ"],["で"],["も"],["ありません"],["。"]]},{"verse":7,"text":"わたしたちが語るのは、隠されていた、神秘としての神の知恵であり、神がわたしたちに栄光を与えるために、世界の始まる前から定めておられたものです。","tok":[["わたしたち"],["が"],["語る","かたる"],["の"],["は"],["、"],["隠されて","かくされて"],["いた"],["、"],["神秘","しんぴ"],["として"],["の"],["神","かみ"],["の"],["知恵","ちえ"],["で"],["あり"],["、"],["神","かみ"],["が"],["わたしたち"],["に"],["栄光","えいこう"],["を"],["与える","あたえる"],["ため"],["に"],["、"],["世界","せかい"],["の"],["始まる","はじまる"],["前","まえ"],["から"],["定めて","さだめて"],["おられた"],["もの"],["です"],["。"]]},{"verse":8,"text":"この世の支配者たちはだれ一人、この知恵を理解しませんでした。もし理解していたら、栄光の主を十字架につけはしなかったでしょう。","tok":[["この世","このよ"],["の"],["支配者","しはいしゃ"],["たち"],["は"],["だれ"],["一人","ひとり"],["、"],["この"],["知恵","ちえ"],["を"],["理解","りかい"],["しませんでした"],["。"],["もし"],["理解","りかい"],["して"],["いたら"],["、"],["栄光","えいこう"],["の"],["主","ぬし"],["を"],["十字架","じゅうじか"],["に"],["つけ"],["は"],["しなかったでしょう"],["。"]]},{"verse":9,"text":"しかし、このことは、「目が見もせず、耳が聞きもせず、人の心に思い浮かびもしなかったことを、神は御自分を愛する者たちに準備された」と書いてあるとおりです。","tok":[["しかし"],["、"],["この"],["こと"],["は"],["、"],["「"],["目","め"],["が"],["見","み"],["も"],["せず"],["、"],["耳","みみ"],["が"],["聞き","きき"],["も"],["せず"],["、"],["人","ひと"],["の"],["心","こころ"],["に"],["思い浮かび","おもいうかび"],["も"],["しなかった"],["こと"],["を"],["、"],["神","かみ"],["は"],["御自分","ごじぶん"],["を"],["愛する","あいする"],["者","もの"],["たち"],["に"],["準備","じゅんび"],["された"],["」"],["と"],["書いて","かいて"],["ある"],["とおり"],["です"],["。"]]},{"verse":10,"text":"わたしたちには、神が“霊”によってそのことを明らかに示してくださいました。“霊”は一切のことを、神の深みさえも究めます。","tok":[["わたしたち"],["に"],["は"],["、"],["神","かみ"],["が"],["“"],["霊","れい"],["”"],["によって"],["その"],["こと"],["を"],["明らか","あきらか"],["に"],["示して","しめして"],["くださいました"],["。"],["“"],["霊","れい"],["”"],["は"],["一切","いっさい"],["の"],["こと"],["を"],["、"],["神","かみ"],["の"],["深み","ふかみ"],["さえ"],["も"],["究めます","きわめます"],["。"]]},{"verse":11,"text":"人の内にある霊以外に、いったいだれが、人のことを知るでしょうか。同じように、神の霊以外に神のことを知る者はいません。","tok":[["人","ひと"],["の"],["内","うち"],["に"],["ある"],["霊","れい"],["以外","いがい"],["に"],["、"],["いったい"],["だれ"],["が"],["、"],["人","ひと"],["の"],["こと"],["を"],["知るでしょう","しるでしょう"],["か"],["。"],["同じ","おなじ"],["よう"],["に"],["、"],["神","かみ"],["の"],["霊","れい"],["以外","いがい"],["に"],["神","かみ"],["の"],["こと"],["を"],["知る","しる"],["者","もの"],["は"],["いません"],["。"]]},{"verse":12,"text":"わたしたちは、世の霊ではなく、神からの霊を受けました。それでわたしたちは、神から恵みとして与えられたものを知るようになったのです。","tok":[["わたしたち"],["は"],["、"],["世","よ"],["の"],["霊","れい"],["で"],["は"],["なく"],["、"],["神","かみ"],["から"],["の"],["霊","れい"],["を"],["受けました","うけました"],["。"],["それ"],["で"],["わたしたち"],["は"],["、"],["神","かみ"],["から"],["恵み","めぐみ"],["として"],["与えられた","あたえられた"],["もの"],["を"],["知る","しる"],["よう"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":13,"text":"そして、わたしたちがこれについて語るのも、人の知恵に教えられた言葉によるのではなく、“霊”に教えられた言葉によっています。つまり、霊的なものによって霊的なことを説明するのです。","tok":[["そして"],["、"],["わたしたち"],["が"],["これ"],["について"],["語る","かたる"],["の"],["も"],["、"],["人","ひと"],["の"],["知恵","ちえ"],["に"],["教えられた","おしえられた"],["言葉","ことば"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["“"],["霊","れい"],["”"],["に"],["教えられた","おしえられた"],["言葉","ことば"],["によって"],["います"],["。"],["つまり"],["、"],["霊的","れいてき"],["な"],["もの"],["によって"],["霊的","れいてき"],["な"],["こと"],["を"],["説明","せつめい"],["する"],["の"],["です"],["。"]]},{"verse":14,"text":"自然の人は神の霊に属する事柄を受け入れません。その人にとって、それは愚かなことであり、理解できないのです。霊によって初めて判断できるからです。","tok":[["自然","しぜん"],["の"],["人","ひと"],["は"],["神","かみ"],["の"],["霊","れい"],["に"],["属する","ぞくする"],["事柄","ことがら"],["を"],["受け入れません","うけいれません"],["。"],["その"],["人","ひと"],["にとって"],["、"],["それ"],["は"],["愚か","おろか"],["な"],["こと"],["で"],["あり"],["、"],["理解","りかい"],["できない"],["の"],["です"],["。"],["霊","れい"],["によって"],["初めて","はじめて"],["判断","はんだん"],["できる"],["から"],["です"],["。"]]},{"verse":15,"text":"霊の人は一切を判断しますが、その人自身はだれからも判断されたりしません。","tok":[["霊","れい"],["の"],["人","ひと"],["は"],["一切","いっさい"],["を"],["判断","はんだん"],["します"],["が"],["、"],["その"],["人","ひと"],["自身","じしん"],["は"],["だれ"],["から"],["も"],["判断","はんだん"],["され"],["たり"],["しません"],["。"]]},{"verse":16,"text":"「だれが主の思いを知り、主を教えるというのか。」しかし、わたしたちはキリストの思いを抱いています。","tok":[["「"],["だれ"],["が"],["主","ぬし"],["の"],["思い","おもい"],["を"],["知り","しり"],["、"],["主","ぬし"],["を"],["教える","おしえる"],["と"],["いう"],["の"],["か"],["。"],["」"],["しかし"],["、"],["わたしたち"],["は"],["キリスト"],["の"],["思い","おもい"],["を"],["抱いて","いだいて"],["います"],["。"]]}]
[{"verse":1,"text":"神の御心によって召されてキリスト‧イエスの使徒となったパウロと、兄弟ソステネから、","tok":[["神","かみ"],["の"],["御心","おこころ"],["によって"],["召されて","めされて"],["キリスト"],["‧"],["イエス"],["の"],["使徒","しと"],["と"],["なった"],["パウロ"],["と"],["、"],["兄弟","きょうだい"],["ソステネ"],["から"],["、"]]},{"verse":2,"text":"コリントにある神の教会へ、すなわち、至るところでわたしたちの主イエス‧キリストの名を呼び求めているすべての人と共に、キリスト‧イエスによって聖なる者とされた人々、召されて聖なる者とされた人々へ。イエス‧キリストは、この人たちとわたしたちの主であります。","tok":[["コリント"],["に"],["ある"],["神","かみ"],["の"],["教会","きょうかい"],["へ"],["、"],["すなわち"],["、"],["至る","いたる"],["ところ"],["で"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["名","な"],["を"],["呼び求めて","よびもとめて"],["いる"],["すべて"],["の"],["人","ひと"],["と"],["共","とも"],["に"],["、"],["キリスト"],["‧"],["イエス"],["によって"],["聖","せい"],["なる"],["者","もの"],["と"],["された"],["人々","ひとびと"],["、"],["召されて","めされて"],["聖","せい"],["なる"],["者","もの"],["と"],["された"],["人々","ひとびと"],["へ"],["。"],["イエス"],["‧"],["キリスト"],["は"],["、"],["この"],["人","ひと"],["たち"],["と"],["わたしたち"],["の"],["主","ぬし"],["で"],["あります"],["。"]]},{"verse":3,"text":"わたしたちの父である神と主イエス‧キリストからの恵みと平和が、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["から"],["の"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":4,"text":"わたしは、あなたがたがキリスト‧イエスによって神の恵みを受けたことについて、いつもわたしの神に感謝しています。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["が"],["キリスト"],["‧"],["イエス"],["によって"],["神","かみ"],["の"],["恵み","めぐみ"],["を"],["受けた","うけた"],["こと"],["について"],["、"],["いつも"],["わたし"],["の"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":5,"text":"あなたがたはキリストに結ばれ、あらゆる言葉、あらゆる知識において、すべての点で豊かにされています。","tok":[["あなた"],["がた"],["は"],["キリスト"],["に"],["結ばれ","むすばれ"],["、"],["あらゆる"],["言葉","ことば"],["、"],["あらゆる"],["知識","ちしき"],["に"],["おいて"],["、"],["すべて"],["の"],["点","てん"],["で"],["豊か","ゆたか"],["に"],["されて"],["います"],["。"]]},{"verse":6,"text":"こうして、キリストについての証しがあなたがたの間で確かなものとなったので、","tok":[["こう"],["して"],["、"],["キリスト"],["について"],["の"],["証し","あかし"],["が"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["確か","たしか"],["な"],["もの"],["と"],[
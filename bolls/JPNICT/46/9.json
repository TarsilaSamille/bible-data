[{"verse":1,"text":"わたしは自由な者ではないか。使徒ではないか。わたしたちの主イエスを見たではないか。あなたがたは、主のためにわたしが働いて得た成果ではないか。","tok":[["わたし"],["は"],["自由","じゆう"],["な"],["者","もの"],["で"],["は"],["ない"],["か"],["。"],["使徒","しと"],["で"],["は"],["ない"],["か"],["。"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["を"],["見たで","みたで"],["は"],["ない"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["主","ぬし"],["の"],["ため"],["に"],["わたし"],["が"],["働いて","はたらいて"],["得た","えた"],["成果","せいか"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":2,"text":"他の人たちにとってわたしは使徒でないにしても、少なくともあなたがたにとっては使徒なのです。あなたがたは主に結ばれており、わたしが使徒であることの生きた証拠だからです。","tok":[["他","ほか"],["の"],["人","ひと"],["たち"],["にとって"],["わたし"],["は"],["使徒","しと"],["で"],["ない"],["に"],["して"],["も"],["、"],["少なく","すくなく"],["とも"],["あなた"],["がた"],["にとって"],["は"],["使徒","しと"],["な"],["の"],["です"],["。"],["あなた"],["がた"],["は"],["主に","おもに"],["結ばれて","むすばれて"],["おり"],["、"],["わたし"],["が"],["使徒","しと"],["で"],["ある"],["こと"],["の"],["生きた","いきた"],["証拠","しょうこ"],["だ"],["から"],["です"],["。"]]},{"verse":3,"text":"わたしを批判する人たちには、こう弁明します。","tok":[["わたし"],["を"],["批判","ひはん"],["する"],["人","ひと"],["たち"],["に"],["は"],["、"],["こう"],["弁明","べんめい"],["します"],["。"]]},{"verse":4,"text":"わたしたちには、食べたり、飲んだりする権利が全くないのですか。","tok":[["わたしたち"],["に"],["は"],["、"],["食べ","たべ"],["たり"],["、"],["飲ん","のん"],["だり"],["する"],["権利","けんり"],["が"],["全く","まったく"],["ない"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"わたしたちには、他の使徒たちや主の兄弟たちやケファのように、信者である妻を連れて歩く権利がないのですか。","tok":[["わたしたち"],["に"],["は"],["、"],["他","た"],["の"],["使徒","しと"],["たち"],["や"],["主","ぬし"],["の"],["兄弟","きょうだい"],["たち"],["や"],["ケファ"],["の"],["よう"],["に"],["、"],["信者","しんじゃ"],["で"],["ある"],["妻","つま"],["を"],["連れて","つれて"],["歩く","あるく"],["権利","けんり"],["が"],["ない"],["の"],["です"],["か"],["。"]]},{"verse":6,"text":"あるいは、わたしとバルナバだけには、生活の資を得るための仕事をしなくてもよいという権利がないのですか。","tok":[["あるいは"],["、"],["わたし"],["と"],["バルナバ"],["だけ"],["に"],["は"],["、"],["生活","せいかつ"],["の"],["資","し"],["を"],["得る","える"],["ため"],["の"],["仕事","しごと"],["を"],["しなくて"],["も"],["よい"],["と"],["いう"],["権利","けんり"],["が"],["ない"],["の"],["です"],["か"],["。"]]},{"verse":7,"text":"そもそも、いったいだれが自費で戦争に行きますか。ぶどう畑を作って、その実を食べない者がいますか。羊の群れを飼って、その乳を飲まない者がいますか。","tok":[["そもそも"],["、"],["いったい"],["だれ"],["が"],["自費","じひ"],["で"],["戦争","せんそう"],["に"],["行きます","いきます"],["か"],["。"],["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["、"],["その"],["実","じつ"],["を"],["食べない","たべない"],["者","もの"],["が"],["います"],["か"],["。"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["飼って","かって"],["、"],["その"],["乳","ちち"],["を"],["飲まない","のまない"],["者","もの"],["が"],["います"],["か"],["。"]]},{"verse":8,"text":"わたしがこう言うのは、人間の思いからでしょうか。律法も言っているではないですか。","tok":[["わたし"],["が"],["こう"],["言う","いう"],["の"],["は"],["、"],["人間","にんげん"],["の"],["思い","おもい"],["から"],["でしょう"],["か"],["。"],["律法","りっぽう"],["も"],["言って","いって"],["いるで"],["は"],["ないです"],["か"],["。"]]},{"verse":9,"text":"モーセの律法に、「脱穀している牛に口籠をはめてはならない」と書いてあります。神が心にかけておられるのは、牛のことですか。","tok":[["モーセ"],["の"],["律法","りっぽう"],["に"],["、"],["「"],["脱穀","だっこく"],["して"],["いる"],["牛","うし"],["に"],["口","くち"],["籠","かご"],["を"],["はめて"],["は"],["ならない"],["」"],["と"],["書いて","かいて"],["あります"],["。"],["神","かみ"],["が"],["心","こころ"],["に"],["かけて"],["おられる"],["の"],["は"],["、"],["牛","うし"],["の"],["こと"],["です"],["か"],["。"]]},{"verse":10,"text":"それとも、わたしたちのために言っておられるのでしょうか。もちろん、わたしたちのためにそう書かれているのです。耕す者が望みを持って耕し、脱穀する者が分け前にあずかることを期待して働くのは当然です。","tok":[["それ"],["と"],["も"],["、"],["わたしたち"],["の"],["ため"],["に"],["言って","いって"],["おられる"],["の"],["でしょう"],["か"],["。"],["もちろん"],["、"],["わたしたち"],["の"],["ため"],["に"],["そう"],["書かれて","かかれて"],["いる"],["の"],["です"],["。"],["耕す","たがやす"],["者","もの"],["が"],["望み","のぞみ"],["を"],["持って","もって"],["耕し","たがやし"],["、"],["脱穀","だっこく"],["する"],["者","もの"],["が"],["分け前","わけまえ"],["に"],["あずかる"],["こと"],["を"],["期待","きたい"],["して"],["働く","はたらく"],["の"],["は"],["当然","とうぜん"],["です"],["。"]]},{"verse":11,"text":"わたしたちがあなたがたに霊的なものを蒔いたのなら、あなたがたから肉のものを刈り取ることは、行き過ぎでしょうか。","tok":[["わたしたち"],["が"],["あなた"],["がた"],["に"],["霊的","れいてき"],["な"],["もの"],["を"],["蒔いた","まいた"],["の"],["なら"],["、"],["あなた"],["がた"],["から"],["肉","にく"],["の"],["もの"],["を"],["刈り取る","かりとる"],["こと"],["は"],["、"],["行き","いき"],["過ぎでしょう","すぎでしょう"],["か"],["。"]]},{"verse":12,"text":"他の人たちが、あなたがたに対するこの権利を持っているとすれば、わたしたちはなおさらそうではありませんか。し
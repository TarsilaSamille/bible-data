[{"verse":1,"text":"長老のわたしから、愛するガイオへ。わたしは、あなたを真に愛しています。","tok":[["長老","ちょうろう"],["の"],["わたし"],["から"],["、"],["愛する","あいする"],["ガイオ"],["へ"],["。"],["わたし"],["は"],["、"],["あなた"],["を"],["真","しん"],["に"],["愛して","あいして"],["います"],["。"]]},{"verse":2,"text":"愛する者よ、あなたの魂が恵まれているように、あなたがすべての面で恵まれ、健康であるようにと祈っています。","tok":[["愛する","あいする"],["者","もの"],["よ"],["、"],["あなた"],["の"],["魂","たましい"],["が"],["恵まれて","めぐまれて"],["いる"],["よう"],["に"],["、"],["あなた"],["が"],["すべて"],["の"],["面","めん"],["で"],["恵まれ","めぐまれ"],["、"],["健康","けんこう"],["で"],["ある"],["よう"],["に"],["と"],["祈って","いのって"],["います"],["。"]]},{"verse":3,"text":"兄弟たちが来ては、あなたが真理に歩んでいることを証ししてくれるので、わたしは非常に喜んでいます。実際、あなたは真理に歩んでいるのです。","tok":[["兄弟","きょうだい"],["たち"],["が"],["来て","きて"],["は"],["、"],["あなた"],["が"],["真理","しんり"],["に"],["歩んで","あゆんで"],["いる"],["こと"],["を"],["証し","あかし"],["して"],["くれる"],["ので"],["、"],["わたし"],["は"],["非常","ひじょう"],["に"],["喜んで","よろこんで"],["います"],["。"],["実際","じっさい"],["、"],["あなた"],["は"],["真理","しんり"],["に"],["歩んで","あゆんで"],["いる"],["の"],["です"],["。"]]},{"verse":4,"text":"自分の子供たちが真理に歩んでいると聞くほど、うれしいことはありません。","tok":[["自分","じぶん"],["の"],["子供","こども"],["たち"],["が"],["真理","しんり"],["に"],["歩んで","あゆんで"],["いる"],["と"],["聞く","きく"],["ほど"],["、"],["うれしい"],["こと"],["は"],["ありません"],["。"]]},{"verse":5,"text":"愛する者よ、あなたは、兄弟たち、それも、よそから来た人たちのために誠意をもって尽くしています。","tok":[["愛する","あいする"],["者","もの"],["よ"],["、"],["あなた"],["は"],["、"],["兄弟","きょうだい"],["たち"],["、"],["それ"],["も"],["、"],["よそ"],["から"],["来た","きた"],["人","ひと"],["たち"],["の"],["ため"],["に"],["誠意","せいい"],["を"],["もって"],["尽くして","つくして"],["います"],["。"]]},{"verse":6,"text":"彼らは教会であなたの愛を証ししました。どうか、神に喜ばれるように、彼らを送り出してください。","tok":[["彼","かれ"],["ら"],["は"],["教会","きょうかい"],["で"],["あなた"],["の"],["愛","あい"],["を"],["証し","あかし"],["しました"],["。"],["どう"],["か"],["、"],["神","かみ"],["に"],["喜ばれる","よろこばれる"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["送り出して","おくりだして"],["ください"],["。"]]},{"verse":7,"text":"この人たちは、御名のために旅に出た人で、異邦人からは何ももらっていません。","tok":[["この"],["人","ひと"],["たち"],["は"],["、"],["御名","ぎょめい"],["の"],["ため"],["に"],["旅","たび"],["に"],["出た","でた"],["人","ひと"],["で"],["、"],["異邦人","いほうじん"],["から"],["は"],["何","なん"],["も"],["もらって"],["いません"],["。"]]},{"verse":8,"text":"だから、わたしたちはこのような人たちを助けるべきです。そうすれば、真理のために共に働く者となるのです。","tok":[["だ"],["から"],["、"],["わたしたち"],["は"],["この"],["よう"],["な"],["人","ひと"],["たち"],["を"],["助けるべきです","たすけるべきです"],["。"],["そう"],["すれば"],["、"],["真理","しんり"],["の"],["ため"],["に"],["共","とも"],["に"],["働く","はたらく"],["者","もの"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":9,"text":"わたしは教会に少しばかり書き送りました。ところが、指導者になりたがっているディオトレフェスは、わたしたちを受け入れません。","tok":[["わたし"],["は"],["教会","きょうかい"],["に"],["少し","すこし"],["ばかり"],["書き送りました","かきおくりました"],["。"],["ところ"],["が"],["、"],["指導者","しどうしゃ"],["に"],["なりたがって"],["いる"],["ディオトレフェス"],["は"],["、"],["わたしたち"],["を"],["受け入れません","うけいれません"],["。"]]},{"verse":10,"text":"だから、そちらに行ったとき、彼のしていることを指摘しようと思います。彼は、悪意に満ちた言葉でわたしたちをそしるばかりか、兄弟たちを受け入れず、受け入れようとする人たちの邪魔をし、教会から追い出しています。","tok":[["だ"],["から"],["、"],["そちら"],["に"],["行った","いった"],["とき"],["、"],["彼","かれ"],["の"],["して"],["いる"],["こと"],["を"],["指摘","してき"],["しよう"],["と"],["思います","おもいます"],["。"],["彼","かれ"],["は"],["、"],["悪意","あくい"],["に"],["満ちた","みちた"],["言葉","ことば"],["で"],["わたしたち"],["を"],["そしる"],["ばかり"],["か"],["、"],["兄弟","きょうだい"],["たち"],["を"],["受け入れず","うけいれず"],["、"],["受け入れよう","うけいれよう"],["と"],["する"],["人","ひと"],["たち"],["の"],["邪魔","じゃま"],["を"],["し"],["、"],["教会","きょうかい"],["から"],["追い出して","おいだして"],["います"],["。"]]},{"verse":11,"text":"愛する者よ、悪いことではなく、善いことを見倣ってください。善を行う者は神に属する人であり、悪を行う者は、神を見たことのない人です。","tok":[["愛する","あいする"],["者","もの"],["よ"],["、"],["悪い","わるい"],["こと"],["で"],["は"],["なく"],["、"],["善い","よい"],["こと"],["を"],["見倣って","みならって"],["ください"],["。"],["善","ぜん"],["を"],["行う","おこなう"],["者","もの"],["は"],["神","かみ"],["に"],["属する","ぞくする"],["人","ひと"],["で"],["あり"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["神","かみ"],["を"],["見た","みた"],["こと"],["の"],["ない"],["人","ひと"],["です"],["。"]]},{"verse":12,"text":"デメトリオについては、あらゆる人と真理そのものの証しがあります。わたしたちもまた証しします。そして、あなたは、わたしたちの証しが真実であることを知っています。","tok":[["デメトリオ"],["について"],["は"],["、"],["あらゆる"],["人","ひと"],["と"],["真理","しんり"],["その"],["もの"],["の"],["証し","あかし"],["が"],["あります"],["。"],["わたしたち"],["も"],["また"],["証し","あかし"],["します"],["。"],["そして"],["、"],["あなた"],["は"],["、"],["わたしたち"],["の"],["証し","あかし"],["が"],["真実","しんじつ"],["で"],["ある"],["こと"],["を"],["知って","しって"],["います"],["。"]]},{"verse":13,"text":"あなたに書くことはまだいろいろありますが、インクとペンで書こうとは思いません。","tok":[["あなた"],["に"],["書く","かく"],["こと"],["は"],["まだ"],["いろいろ"],["あります"],["が"],["、"],["インク"],["と"],["ペン"],["で"],["書こう","かこう"],["と"],["は"],["思いません","おもいません"],["。"]]},{"verse":14,"text":"それよりも、近いうちにお目にかかって親しく話し合いたいものです。","tok":[["それ"],["より"],["も"],["、"],["近い","ちかい"],["うち"],["に"],["お目","おめ"],["に"],["かかって"],["親しく","したしく"],["話し合いたい","はなしあいたい"],["もの"],["です"],["。"]]},{"verse":15,"text":"あなたに平和があるように。友人たちがよろしくと言っています。そちらの友人一人一人に、よろしく伝えてください。","tok":[["あなた"],["に"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"],["友人","ゆうじん"],["たち"],["が"],["よろしく"],["と"],["言って","いって"],["います"],["。"],["そちら"],["の"],["友人","ゆうじん"],["一人一人","ひとりひとり"],["に"],["、"],["よろしく"],["伝えて","つたえて"],["ください"],["。"]]}]
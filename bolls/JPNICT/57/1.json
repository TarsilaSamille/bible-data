[{"verse":1,"text":"キリスト‧イエスの囚人パウロと兄弟テモテから、わたしたちの愛する協力者フィレモン、","tok":[["キリスト"],["‧"],["イエス"],["の"],["囚人","しゅうじん"],["パウロ"],["と"],["兄弟","きょうだい"],["テモテ"],["から"],["、"],["わたしたち"],["の"],["愛する","あいする"],["協力者","きょうりょくしゃ"],["フィレモン"],["、"]]},{"verse":2,"text":"姉妹アフィア、わたしたちの戦友アルキポ、ならびにあなたの家にある教会へ。","tok":[["姉妹","しまい"],["アフィア"],["、"],["わたしたち"],["の"],["戦友","せんゆう"],["アルキポ"],["、"],["ならびに"],["あなた"],["の"],["家","いえ"],["に"],["ある"],["教会","きょうかい"],["へ"],["。"]]},{"verse":3,"text":"わたしたちの父である神と主イエス‧キリストからの恵みと平和が、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["から"],["の"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":4,"text":"わたしは、祈りの度に、あなたのことを思い起こして、いつもわたしの神に感謝しています。","tok":[["わたし"],["は"],["、"],["祈り","いのり"],["の"],["度","ど"],["に"],["、"],["あなた"],["の"],["こと"],["を"],["思い起こして","おもいおこして"],["、"],["いつも"],["わたし"],["の"],["神","かみ"],["に"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":5,"text":"というのは、主イエスに対するあなたの信仰と、聖なる者たち一同に対するあなたの愛とについて聞いているからです。","tok":[["と"],["いう"],["の"],["は"],["、"],["主","しゅ"],["イエス"],["に"],["対する","たいする"],["あなた"],["の"],["信仰","しんこう"],["と"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["一同","いちどう"],["に"],["対する","たいする"],["あなた"],["の"],["愛","あい"],["と"],["について"],["聞いて","きいて"],["いる"],["から"],["です"],["。"]]},{"verse":6,"text":"わたしたちの間でキリストのためになされているすべての善いことを、あなたが知り、あなたの信仰の交わりが活発になるようにと祈っています。","tok":[["わたしたち"],["の"],["間","あいだ"],["で"],["キリスト"],["の"],["ため"],["に"],["なされて"],["いる"],["すべて"],["の"],["善い","よい"],["こと"],["を"],["、"],["あなた"],["が"],["知り","しり"],["、"],["あなた"],["の"],["信仰","しんこう"],["の"],["交わり","まじわり"],["が"],["活発","かっぱつ"],["に"],["なる"],["よう"],["に"],["と"],["祈って","いのって"],["います"],["。"]]},{"verse":7,"text":"兄弟よ、わたしはあなたの愛から大きな喜びと慰めを得ました。聖なる者たちの心があなたのお陰で元気づけられたからです。","tok":[["兄弟","きょうだい"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["愛","あい"],["から"],["大きな","おおきな"],["喜び","よろこび"],["と"],["慰め","なぐさめ"],["を"],["得ました","えました"],["。"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["心","こころ"],["が"],["あなた"],["の"],["お陰","おかげ"],["で"],["元気","げんき"],["づけられた"],["から"],["です"],["。"]]},{"verse":8,"text":"それで、わたしは、あなたのなすべきことを、キリストの名によって遠慮なく命じてもよいのですが、","tok":[["それ"],["で"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["なすべき"],["こと"],["を"],["、"],["キリスト"],["の"],["名","な"],["によって"],["遠慮","えんりょ"],["なく"],["命じて","めいじて"],["も"],["よい"],["の"],["です"],["が"],["、"]]},{"verse":9,"text":"むしろ愛に訴えてお願いします、年老いて、今はまた、キリスト‧イエスの囚人となっている、このパウロが。","tok":[["むしろ"],["愛","あい"],["に"],["訴えて","うったえて"],["お願い","おねがい"],["します"],["、"],["年老いて","としおいて"],["、"],["今","いま"],["は"],["また"],["、"],["キリスト"],["‧"],["イエス"],["の"],["囚人","しゅうじん"],["と"],["なって"],["いる"],["、"],["この"],["パウロ"],["が"],["。"]]},{"verse":10,"text":"監禁中にもうけたわたしの子オネシモのことで、頼みがあるのです。","tok":[["監禁中","かんきんちゅう"],["に"],["もうけた"],["わたし"],["の"],["子","こ"],["オネシモ"],["の"],["こと"],["で"],["、"],["頼み","たのみ"],["が"],["ある"],["の"],["です"],["。"]]},{"verse":11,"text":"彼は、以前はあなたにとって役に立たない者でしたが、今は、あなたにもわたしにも役立つ者となっています。","tok":[["彼","かれ"],["は"],["、"],["以前","いぜん"],["は"],["あなた"],["にとって"],["役","やく"],["に"],["立たない","たたない"],["者","もの"],["でした"],["が"],["、"],["今","いま"],["は"],["、"],["あなた"],["に"],["も"],["わたし"],["に"],["も"],["役立つ","やくだつ"],["者","もの"],["と"],["なって"],["います"],["。"]]},{"verse":12,"text":"わたしの心であるオネシモを、あなたのもとに送り帰します。","tok":[["わたし"],["の"],["心","こころ"],["で"],["ある"],["オネシモ"],["を"],["、"],["あなた"],["の"],["もと"],["に"],["送り帰します","おくりかえします"],["。"]]},{"verse":13,"text":"本当は、わたしのもとに引き止めて、福音のゆえに監禁されている間、あなたの代わりに仕えてもらってもよいと思ったのですが、","tok":[["本当","ほんとう"],["は"],["、"],["わたし"],["の"],["もと"],["に"],["引き止めて","ひきとめて"],["、"],["福音","ふくいん"],["の"],["ゆえ"],["に"],["監禁","かんきん"],["されて"],["いる"],["間","あいだ"],["、"],["あなた"],["の"],["代わり","かわり"],["に"],["仕えて","つかえて"],["もらって"],["も"],["よい"],["と"],["思った","おもった"],["の"],["です"],["が"],["、"]]},{"verse":14,"text":"あなたの承諾なしには何もしたくありません。それは、あなたのせっかくの善い行いが、強いられたかたちでなく、自発的になされるようにと思うからです。","tok":[["あなた"],["の"],["承諾","しょうだく"],["なし"],["に"],["は"],["何","なん"],["も"],["したく"],["ありません"],["。"],["それ"],["は"],["、"],["あなた"],["の"],["せっかく"],["の"],["善い","よい"],["行い","おこない"],["が"],["、"],["強いられた","しいられた"],["かたち"],["で"],["なく"],["、"],["自発的","じはつてき"],["に"],["なされる"],["よう"],["に"],["と"],["思う","おもう"],["から"],["です"],["。"]]},{"verse":15,"text":"恐らく彼がしばらくあなたのもとから引き離されていたのは、あなたが彼をいつまでも自分のもとに置くためであったかもしれません。","tok":[["恐らく","おそらく"],["彼","かれ"],["が"],["しばらく"],["あなた"],["の"],["もと"],["から"],["引き離されて","ひきはなされて"],["いた"],["の"],["は"],["、"],["あなた"],["が"],["彼","かれ"],["を"],["いつ"],["まで"],["も"],["自分","じぶん"],["の"],["もと"],["に"],["置く","おく"],["ため"],["で"],["あった"],["か"],["も"],["しれません"],["。"]]},{"verse":16,"text":"その場合、もはや奴隷としてではなく、奴隷以上の者、つまり愛する兄弟としてです。オネシモは特にわたしにとってそうですが、あなたにとってはなおさらのこと、一人の人間としても、主を信じる者としても、愛する兄弟であるはずです。","tok":[["その"],["場合","ばあい"],["、"],["もはや"],["奴隷","どれい"],["として"],["で"],["は"],["なく"],["、"],["奴隷","どれい"],["以上","いじょう"],["の"],["者","もの"],["、"],["つまり"],["愛する","あいする"],["兄弟","きょうだい"],["として"],["です"],["。"],["オネシモ"],["は"],["特に","とくに"],["わたし"],["にとって"],["そう"],["です"],["が"],["、"],["あなた"],["にとって"],["は"],["なおさら"],["の"],["こと"],["、"],["一人","ひとり"],["の"],["人間","にんげん"],["として"],["も"],["、"],["主","ぬし"],["を"],["信じる","しんじる"],["者","もの"],["として"],["も"],["、"],["愛する","あいする"],["兄弟","きょうだい"],["で"],["ある"],["はず"],["です"],["。"]]},{"verse":17,"text":"だから、わたしを仲間と見なしてくれるのでしたら、オネシモをわたしと思って迎え入れてください。","tok":[["だ"],["から"],["、"],["わたし"],["を"],["仲間","なかま"],["と"],["見なして","みなして"],["くれる"],["の"],["でしたら"],["、"],["オネシモ"],["を"],["わたし"],["と"],["思って","おもって"],["迎え入れて","むかえいれて"],["ください"],["。"]]},{"verse":18,"text":"彼があなたに何か損害を与えたり、負債を負ったりしていたら、それはわたしの借りにしておいてください。","tok":[["彼","かれ"],["が"],["あなた"],["に"],["何","なん"],["か"],["損害","そんがい"],["を"],["与え","あたえ"],["たり"],["、"],["負債","ふさい"],["を"],["負っ","おっ"],["たり"],["して"],["いたら"],["、"],["それ"],["は"],["わたし"],["の"],["借り","かり"],["に"],["して"],["おいて"],["ください"],["。"]]},{"verse":19,"text":"わたしパウロが自筆で書いています。わたしが自分で支払いましょう。あなたがあなた自身を、わたしに負うていることは、よいとしましょう。","tok":[["わたし"],["パウロ"],["が"],["自筆","じひつ"],["で"],["書いて","かいて"],["います"],["。"],["わたし"],["が"],["自分","じぶん"],["で"],["支払いましょう","しはらいましょう"],["。"],["あなた"],["が"],["あなた"],["自身","じしん"],["を"],["、"],["わたし"],["に"],["負うて","おうて"],["いる"],["こと"],["は"],["、"],["よい"],["と"],["しましょう"],["。"]]}
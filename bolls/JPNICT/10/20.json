[{"verse":1,"text":"そこにベニヤミン人ビクリの息子でシェバという名のならず者が居合わせた。彼は角笛を吹き鳴らして言った。「我々にはダビデと分け合うものはない。エッサイの子と共にする嗣業はない。イスラエルよ、自分の天幕に帰れ。」","tok":[["そこ"],["に"],["ベニヤミン"],["人","にん"],["ビクリ"],["の"],["息子","むすこ"],["で"],["シェバ"],["と"],["いう"],["名","な"],["の"],["ならず者","ならずもの"],["が"],["居合わせた","いあわせた"],["。"],["彼","かれ"],["は"],["角笛","つのぶえ"],["を"],["吹き鳴らして","ふきならして"],["言った","いった"],["。"],["「"],["我々","われわれ"],["に"],["は"],["ダビデ"],["と"],["分け合う","わけあう"],["もの"],["は"],["ない"],["。"],["エッサイ"],["の"],["子","こ"],["と"],["共","とも"],["に"],["する"],["嗣業","しぎょう"],["は"],["ない"],["。"],["イスラエル"],["よ"],["、"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["帰れ","かえれ"],["。"],["」"]]},{"verse":2,"text":"イスラエルの人々は皆ダビデを離れ、ビクリの息子シェバに従った。しかし、ユダの人々はヨルダン川からエルサレムまで彼らの王につき従った。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["ダビデ"],["を"],["離れ","はなれ"],["、"],["ビクリ"],["の"],["息子","むすこ"],["シェバ"],["に"],["従った","したがった"],["。"],["しかし"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["ヨルダン"],["川","かわ"],["から"],["エルサレム"],["まで"],["彼","かれ"],["ら"],["の"],["王","おう"],["に"],["つき従った","つきしたがった"],["。"]]},{"verse":3,"text":"ダビデはエルサレムの王宮に戻ると、家を守るために残した十人の側女を集め、監視付きの家に入れた。彼は側女たちの面倒は見たが、彼女たちのところに入ることはなかった。彼女たちは死ぬまで閉じ込められ、やもめのような生涯を送った。","tok":[["ダビデ"],["は"],["エルサレム"],["の"],["王宮","おうきゅう"],["に"],["戻る","もどる"],["と"],["、"],["家","いえ"],["を"],["守る","まもる"],["ため"],["に"],["残した","のこした"],["十人","じゅうにん"],["の"],["側女","そばめ"],["を"],["集め","あつめ"],["、"],["監視付き","かんしつき"],["の"],["家","いえ"],["に"],["入れた","いれた"],["。"],["彼","かれ"],["は"],["側女","そばめ"],["たち"],["の"],["面倒","めんどう"],["は"],["見た","みた"],["が"],["、"],["彼女","かのじょ"],["たち"],["の"],["ところ"],["に"],["入る","はいる"],["こと"],["は"],["なかった"],["。"],["彼女","かのじょ"],["たち"],["は"],["死ぬ","しぬ"],["まで"],["閉じ込められ","とじこめられ"],["、"],["やもめ"],["の"],["よう"],["な"],["生涯","しょうがい"],["を"],["送った","おくった"],["。"]]},{"verse":4,"text":"王はアマサに命じた。「ユダの人々を三日のうちに動員してここに来なさい。」","tok":[["王","おう"],["は"],["アマサ"],["に"],["命じた","めいじた"],["。"],["「"],["ユダ"],["の"],["人々","ひとびと"],["を"],["三日","みっか"],["の"],["うち"],["に"],["動員","どういん"],["して"],["ここ"],["に"],["来","き"],["なさい"],["。"],["」"]]},{"verse":5,"text":"アマサはユダの人々を動員するために出て行ったが、定められた期日に戻らなかった。","tok":[["アマサ"],["は"],["ユダ"],["の"],["人々","ひとびと"],["を"],["動員","どういん"],["する"],["ため"],["に"],["出て","でて"],["行った","いった"],["が"],["、"],["定められた","さだめられた"],["期日","きじつ"],["に"],["戻らなかった","もどらなかった"],["。"]]},{"verse":6,"text":"ダビデはアビシャイに言った。「我々にとってビクリの子シェバはアブサロム以上に危険だ。シェバが砦の町々を見つけて我々の目から隠れることがないように、お前は主君の家臣を率いて彼を追跡しなさい。」","tok":[["ダビデ"],["は"],["アビシャイ"],["に"],["言った","いった"],["。"],["「"],["我々","われわれ"],["にとって"],["ビクリ"],["の"],["子","こ"],["シェバ"],["は"],["アブサロム"],["以上","いじょう"],["に"],["危険","きけん"],["だ"],["。"],["シェバ"],["が"],["砦","とりで"],["の"],["町々","まちまち"],["を"],["見つけて","みつけて"],["我々","われわれ"],["の"],["目","め"],["から"],["隠れる","かくれる"],["こと"],["が"],["ない"],["よう"],["に"],["、"],["お前","おまえ"],["は"],["主君","しゅくん"],["の"],["家臣","かしん"],["を"],["率いて","ひきいて"],["彼","かれ"],["を"],["追跡","ついせき"],["し"],["なさい"],["。"],["」"]]},{"verse":7,"text":"ヨアブの兵、クレタ人とペレティ人、および勇士の全員が彼に従ってエルサレムを出発し、ビクリの息子シェバを追跡した。","tok":[["ヨアブ"],["の"],["兵","へい"],["、"],["クレタ人","くれたにん"],["と"],["ペレティ"],["人","にん"],["、"],["および"],["勇士","ゆうし"],["の"],["全員","ぜんいん"],["が"],["彼","かれ"],["に"],["従って","したがって"],["エルサレム"],["を"],["出発","しゅっぱつ"],["し"],["、"],["ビクリ"],["の"],["息子","むすこ"],["シェバ"],["を"],["追跡","ついせき"],["した"],["。"]]},{"verse":8,"text":"彼らがギブオンの大石のところにさしかかったとき、アマサが彼らの前に現れた。ヨアブは武装して、さやに納めた剣を腰に帯びていたが、ヨアブが前に出ると、剣が抜けた。","tok":[["彼","かれ"],["ら"],["が"],["ギブオン"],["の"],["大石","おおいし"],["の"],["ところ"],["に"],["さしかかった"],["とき"],["、"],["アマサ"],["が"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["現れた","あらわれた"],["。"],["ヨアブ"],["は"],["武装","ぶそう"],["して"],["、"],["さや"],["に"],["納めた","おさめた"],["剣","けん"],["を"],["腰","こし"],["に"],["帯びて","おびて"],["いた"],["が"],["、"],["ヨアブ"],["が"],["前","まえ"],["に"],["出る","でる"],["と"],["、"],["剣","けん"],["が"],["抜けた","ぬけた"],["。"]]},{"verse":9,"text":"ヨアブはアマサに、「兄弟、無事か」と声をかけ、口づけしようと右手でアマサのひげをつかんだ。","tok":[["ヨアブ"],["は"],["アマサ"],["に"],["、"],["「"],["兄弟","きょうだい"],["、"],["無事","ぶじ"],["か"],["」"],["と"],["声","こえ"],["を"],["かけ"],["、"],["口づけ","くちづけ"],["しよう"],["と"],["右手","みぎて"],["で"],["アマサ"],["の"],["ひげ"],["を"],["つかんだ"],["。"]]},{"verse":10,"text":"アマサはヨアブの手にある剣に気づかなかった。ヨアブは剣でアマサの下腹を突き刺した。はらわたが地に流れ出て、二度突くまでもなくアマサは死んだ。ヨアブと弟アビシャイはビクリの息子シェバの追跡を続けた。","tok":[["アマサ"],["は"],["ヨアブ"],["の"],["手","て"],["に"],["ある"],["剣","けん"],["に"],["気づかなかった","きづかなかった"],["。"],["ヨアブ"],["は"],["剣","けん"],["で"],["アマサ"],["の"],["下腹","したはら"],["を"],["突き刺した","つきさした"],["。"],["はらわた"],["が"],["地","ち"],["に"],["流れ出て","ながれでて"],["、"],["二","に"],["度","ど"],["突く","つく"],["まで"],["も"],["なく"],["アマサ"],["は"],["死んだ","しんだ"],["。"],["ヨアブ"],["と"],["弟","おとうと"],["アビシャイ"],["は"],["ビクリ"],["の"],["息子","むすこ"],["シェバ"],["の"],["追跡","ついせき"],["を"],["続けた","つづけた"],["。"]]},{"verse":11,"text":"ヨアブの従者の一人が傍らに立って言った。「ヨアブを愛する者、ダビデに味方する者はヨアブに続け。」","tok":[["ヨアブ"],["の"],["従者","じゅうしゃ"],["の"],["一人","ひとり"],["が"],["傍ら","かたわら"],["に"],["立って","たって"],["言った","いった"],["。"],["「"],["ヨアブ"],["を"],["愛する","あいする"],["者","もの"],["、"],["ダビデ"],["に"],["味方","みかた"],["する"],["者","もの"],["は"],["ヨアブ"],["に"],["続け","つづけ"],["。"],["」"]]},{"verse":12,"text":"だが、アマサが道の真ん中に血にまみれて転がっていたので、兵士たちは皆立ち止まった。この男はそれを見てアマサを道から畑に移し、そこまで来た者がそれを見て立ち止まることのないように、その上に衣をかぶせた。","tok":[["だ"],["が"],["、"],["アマサ"],["が"],["道","みち"],["の"],["真ん中","まんなか"],["に"],["血","ち"],["に"],["まみれて"],["転がって","ころがって"],["いた"],["ので"],["、"],["兵士","へいし"],["たち"],["は"],["皆","みな"],["立ち止まった","たちどまった"],["。"],["この"],["男","おとこ"],["は"],["それ"],["を"],["見て","みて"],["アマサ"],["を"],["道","みち"],["から"],["畑","はたけ"],["に"],["移し","うつし"],["、"],["そこ"],["まで"],["来た","きた"],["者","もの"],["が"],["それ"],["を"],["見て","みて"],["立ち止まる","たちどまる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["その"],["上","うえ"],["に"],["衣","ころも"],["を"],["かぶせた"],["。"]]},{"verse":13,"text":"アマサが道から除かれると、兵は皆、ヨアブの後についてビクリの息子シェバを追跡した。","tok":[["アマサ"],["が"],["道","みち"],["から"],["除かれる","のぞかれる"],["と"],["、"],["兵","へい"],["は"],["皆","みな"],["、"],["ヨアブ"],["の"],["後","あと"],["について"],["ビクリ"],["の"],["息子","むすこ"],["シェバ"],["を"],["追跡","ついせき"],["した"],["。"]]},{"verse":14,"text":"シェバはイスラエルの全部族を通って行って、ベト‧マアカのアベルまで来ていた。選び抜かれた兵が寄り集まり彼に従った。","tok":[["シェバ"],["は"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["を"],["通って","とおって"],["行って","いって"],["、"],["ベト"],["‧"],["マアカ"],["の"],["アベル"],["まで"],["来て","きて"],["いた"],["。"],["選び抜かれた","えらびぬかれた"],["兵","へい"],["が"],["寄り集まり","よりあつまり"],["彼","かれ"],["に"],["従った","したがった"],["。"]]},{"verse":15,"text":"ヨアブに従う兵士全員がベト‧マアカのアベルに到着しシェバを包囲した。町に向けて外壁の高さほどの塁を築き、城壁を崩そうと試みていると、","tok":[["ヨアブ"],["に"],["従う","したがう"],["兵士","へいし"],["全員","ぜんいん"],["が"],["ベト"],["‧"],["マアカ"],["の"],["アベル"],["に"],["到着","とうちゃく"],["し"],["シェバ"],["を"],["包囲","ほうい"],["した"],["。"],["町","まち"],["に"],["向けて","むけて"],["外壁","がいへき"],["の"],["高さ","たかさ"],["ほど"],["の"],["塁","るい"],["を"],["築き","きずき"],["、"],["城壁","じょうへき"],["を"],["崩そう","くずそう"],["と"],["試みて","こころみて"],["いる"],["と"],["、"]]},{"verse":16,"text":"知恵のある女が町から呼ばわった。「聞いてください。聞いてください。『ここに近寄ってください。申し上げたいことがあります』とヨアブさまに伝えてください。」","tok":[["知恵","ちえ"],["の"],["ある"],["女","おんな"],["が"],["町","まち"],["から"],["呼ばわった","よばわった"],["。"],["「"],["聞いて","きいて"],["ください"],["。"],["聞いて","きいて"],["ください"],["。"],["『"],["ここ"],["に"],["近寄って","ちかよって"],["ください"],["。"],["申し上げたい","もうしあげたい"],["こと"],["が"],["あります"],["』"],["と"],["ヨアブ"],["さま"],["に"],["伝えて","つたえて"],["ください"],["。"],["」"]]},{"verse":17,"text":"ヨアブが近寄ると女は言った。「あなたがヨアブさまですか。」「そうだ」と彼は答えた。彼女は言った。「はしための言葉を聞いてください。」「聞こう」とヨアブが答えると、","tok":[["ヨアブ"],["が"],["近寄る","ちかよる"],["と"],["女","おんな"],["は"],["言った","いった"],["。"],["「"],["あなた"],["が"],["ヨアブ"],["さま"],["です"],["か"],["。"],["」"],["「"],["そう"],["だ"],["」"],["と"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["はし"],["ため"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["ください"],["。"],["」"],["「"],["聞こう","きこう"],["」"],["と"],["ヨアブ"],["が"],["答える","こたえる"],["と"],["、"]]},{"verse":18,"text":"女は言った。「昔から、『アベルで尋ねよ』と言えば、事は片づいたのです。","tok":[["女","おんな"],["は"],["言った","いった"],["。"],["「"],["昔","むかし"],["から"],["、"],["『"],["アベル"],["で"],["尋ね","たずね"],["よ"],["』"],["と"],["言えば","いえば"],["、"],["事","こと"],["は"],["片づいた","かたづいた"],["の"],["です"],["。"]]},{"verse":19,"text":"わたしはイスラエルの中で平和を望む忠実な者の一人です。あなたはイスラエルの母なる町を滅ぼそうとしておられます。何故、あなたは主の嗣業を呑み尽くそうとなさるのですか。」","tok":[["わたし"],["は"],["イスラエル"],["の"],["中","なか"],["で"],["平和","へいわ"],["を"],["望む","のぞむ"],["忠実","ちゅうじつ"],["な"],["者","もの"],["の"],["一人","ひとり"],["です"],["。"],["あなた"],["は"],["イスラエル"],["の"],["母","はは"],["なる"],["町","まち"],["を"],["滅ぼそう","ほろぼそう"],["として"],["おられます"],["。"],["何故","なぜ"],["、"],["あなた"],["は"],["主","ぬし"],["の"],["嗣業","しぎょう"],["を"],["呑み","のみ"],["尽くそう","つくそう"],["と"],["なさる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":20,"text":"ヨアブは答えた。「決してそのようなことはない。呑み尽くしたり、滅ぼしたりすることなど考えてもいない。","tok":[["ヨアブ"],["は"],["答えた","こたえた"],["。"],["「"],["決して","けっして"],["その"],["よう"],["な"],["こと"],["は"],["ない"],["。"],["呑み","のみ"],["尽くし","つくし"],["たり"],["、"],["滅ぼし","ほろぼし"],["たり"],["する"],["こと"],["など"],["考えて","かんがえて"],["も"],["いない"],["。"]]},{"verse":21,"text":"そうではない。エフライム山地の出身で、名をビクリの子シェバという者がダビデ王に向かって手を上げたのだ。その男一人を渡してくれれば、この町から引き揚げよう。」女はヨアブに言った。「その男の首を城壁の上からあなたのもとへ投げ落とします。」","tok":[["そう"],["で"],["は"],["ない"],["。"],["エフライム"],["山地","さんち"],["の"],["出身","しゅっしん"],["で"],["、"],["名","な"],["を"],["ビクリ"],["の"],["子","こ"],["シェバ"],["と"],["いう"],["者","もの"],["が"],["ダビデ"],["王","おう"],["に"],["向かって","むかって"],["手","て"],["を"],["上げた","あげた"],["の"],["だ"],["。"],["その"],["男","おとこ"],["一人","ひとり"],["を"],["渡して","わたして"],["くれれば"],["、"],["この"],["町","まち"],["から"],["引き揚げよう","ひきあげよう"],["。"],["」"],["女","おんな"],["は"],["ヨアブ"],["に"],["言った","いった"],["。"],["「"],["その"],["男","おとこ"],["の"],["首","くび"],["を"],["城壁","じょうへき"],["の"],["上","うえ"],["から"],["あなた"],["の"],["もと"],["へ"],["投げ落とします","なげおとします"],["。"],["」"]]},{"verse":22,"text":"女は知恵を用いてすべての民のもとに行き、ビクリの子シェバの首を切り落とさせ、ヨアブに向けてそれを投げ落とした。ヨアブは角笛を吹き鳴らし、兵はこの町からそれぞれの天幕に散って行った。ヨアブはエルサレムの王のもとへ戻った。","tok":[["女","おんな"],["は"],["知恵","ちえ"],["を"],["用いて","もちいて"],["すべて"],["の"],["民","たみ"],["の"],["もと"],["に"],["行き","いき"],["、"],["ビクリ"],["の"],["子","こ"],["シェバ"],["の"],["首","くび"],["を"],["切り落とさせ","きりおとさせ"],["、"],["ヨアブ"],["に"],["向けて","むけて"],["それ"],["を"],["投げ落とした","なげおとした"],["。"],["ヨアブ"],["は"],["角笛","つのぶえ"],["を"],["吹き鳴らし","ふきならし"],["、"],["兵","へい"],["は"],["この"],["町","まち"],["から"],["それぞれ"],["の"],["天幕","てんまく"],["に"],["散って","ちって"],["行った","いった"],["。"],["ヨアブ"],["は"],["エルサレム"],["の"],["王","おう"],["の"],["もと"],["へ"],["戻った","もどった"],["。"]]},{"verse":23,"text":"ヨアブはイスラエル全軍の司令官。ヨヤダの子ベナヤはクレタ人とペレティ人の監督官。","tok":[["ヨアブ"],["は"],["イスラエル"],["全軍","ぜんぐん"],["の"],["司令官","しれいかん"],["。"],["ヨヤダ"],["の"],["子","こ"],["ベナヤ"],["は"],["クレタ人","くれたにん"],["と"],["ペレティ"],["人","にん"],["の"],["監督官","かんとくかん"],["。"]]},{"verse":24,"text":"アドラムは労役の監督官。アヒルドの子ヨシャファトは補佐官。","tok":[["アドラム"],["は"],["労役","ろうえき"],["の"],["監督官","かんとくかん"],["。"],["アヒルド"],["の"],["子","こ"],["ヨシャファト"],["は"],["補佐官","ほさかん"],["。"]]},{"verse":25,"text":"シェワは書記官。ツァドクとアビアタルは祭司。","tok":[["シェワ"],["は"],["書記官","しょきかん"],["。"],["ツァドク"],["と"],["アビアタル"],["は"],["祭司","さいし"],["。"]]},{"verse":26,"text":"ヤイル人イラもダビデの祭司。","tok":[["ヤイル人","やいるにん"],["イラ"],["も"],["ダビデ"],["の"],["祭司","さいし"],["。"]]}]
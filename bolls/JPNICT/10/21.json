[{"verse":1,"text":"ダビデの世に、三年続いて飢饉が襲った。ダビデは主に託宣を求めた。主は言われた。「ギブオン人を殺害し、血を流したサウルとその家に責任がある。」","tok":[["ダビデ"],["の"],["世","よ"],["に"],["、"],["三","さん"],["年","ねん"],["続いて","つづいて"],["飢饉","ききん"],["が"],["襲った","おそった"],["。"],["ダビデ"],["は"],["主に","おもに"],["託宣","たくせん"],["を"],["求めた","もとめた"],["。"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["ギブオン"],["人","にん"],["を"],["殺害","さつがい"],["し"],["、"],["血","ち"],["を"],["流した","ながした"],["サウル"],["と"],["その"],["家","いえ"],["に"],["責任","せきにん"],["が"],["ある"],["。"],["」"]]},{"verse":2,"text":"王はギブオン人を招いて言った。――ギブオン人はアモリ人の生き残りで、イスラエルの人々に属する者ではないが、イスラエルの人々は彼らと誓約を交わしていた。ところがサウルは、イスラエルとユダの人々への熱情の余り、ギブオン人を討とうとしたことがあった。","tok":[["王","おう"],["は"],["ギブオン"],["人","にん"],["を"],["招いて","まねいて"],["言った","いった"],["。"],["―"],["―"],["ギブオン"],["人","にん"],["は"],["アモリ人","あもりにん"],["の"],["生き残り","いきのこり"],["で"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["属する","ぞくする"],["者","もの"],["で"],["は"],["ない"],["が"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["と"],["誓約","せいやく"],["を"],["交わして","かわして"],["いた"],["。"],["ところ"],["が"],["サウル"],["は"],["、"],["イスラエル"],["と"],["ユダ"],["の"],["人々","ひとびと"],["へ"],["の"],["熱情","ねつじょう"],["の"],["余り","あまり"],["、"],["ギブオン"],["人","にん"],["を"],["討とう","うとう"],["と"],["した"],["こと"],["が"],["あった"],["。"]]},{"verse":3,"text":"ダビデはギブオン人に言った。「あなたたちに何をしたらよいのだろう。どのように償えば主の嗣業を祝福してもらえるだろうか。」","tok":[["ダビデ"],["は"],["ギブオン"],["人","にん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["に"],["何","なん"],["を"],["したら"],["よい"],["の"],["だろう"],["。"],["どの"],["よう"],["に"],["償えば","つぐなえば"],["主","ぬし"],["の"],["嗣業","しぎょう"],["を"],["祝福","しゅくふく"],["して"],["もらえるだろう"],["か"],["。"],["」"]]},{"verse":4,"text":"ギブオン人はダビデに答えた。「サウルとその家のことで問題なのは金銀ではありません。イスラエルの人々をだれかれなく殺すというのでもありません。」ダビデは言った。「言ってくれれば何でもそのとおりにしよう。」","tok":[["ギブオン"],["人","にん"],["は"],["ダビデ"],["に"],["答えた","こたえた"],["。"],["「"],["サウル"],["と"],["その"],["家","いえ"],["の"],["こと"],["で"],["問題","もんだい"],["な"],["の"],["は"],["金銀","きんぎん"],["で"],["は"],["ありません"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["だれかれ"],["なく"],["殺す","ころす"],["と"],["いう"],["ので"],["も"],["ありません"],["。"],["」"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["言って","いって"],["くれれば"],["何","なん"],["で"],["も"],["その"],["とおり"],["に"],["しよう"],["。"],["」"]]},{"verse":5,"text":"彼らは王に答えた。「わたしたちを滅ぼし尽くし、わたしたちがイスラエルの領土のどこにも定着できないように滅亡を謀った男、","tok":[["彼","かれ"],["ら"],["は"],["王","おう"],["に"],["答えた","こたえた"],["。"],["「"],["わたしたち"],["を"],["滅ぼし","ほろぼし"],["尽くし","つくし"],["、"],["わたしたち"],["が"],["イスラエル"],["の"],["領土","りょうど"],["の"],["どこ"],["に"],["も"],["定着","ていちゃく"],["できない"],["よう"],["に"],["滅亡","めつぼう"],["を"],["謀った","はかった"],["男","おとこ"],["、"]]},{"verse":6,"text":"あの男の子孫の中から七人をわたしたちに渡してください。わたしたちは主がお選びになった者サウルの町ギブアで、主の御前に彼らをさらし者にします。」王は、「引き渡そう」と言った。","tok":[["あの"],["男","おとこ"],["の"],["子孫","しそん"],["の"],["中","なか"],["から"],["七人","しちにん"],["を"],["わたしたち"],["に"],["渡して","わたして"],["ください"],["。"],["わたしたち"],["は"],["主","ぬし"],["が"],["お選び","おえらび"],["に"],["なった"],["者","もの"],["サウル"],["の"],["町","まち"],["ギブア"],["で"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["彼","かれ"],["ら"],["を"],["さらし者","さらしもの"],["に"],["します"],["。"],["」"],["王","おう"],["は"],["、"],["「"],["引き渡そう","ひきわたそう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"しかし、王はサウルの子ヨナタンの息子メフィボシェトを惜しんだ。ダビデとサウルの子ヨナタンとの間には主をさして立てた誓いがあったからである。","tok":[["しかし"],["、"],["王","おう"],["は"],["サウル"],["の"],["子","こ"],["ヨナタン"],["の"],["息子","むすこ"],["メフィボシェト"],["を"],["惜しんだ","おしんだ"],["。"],["ダビデ"],["と"],["サウル"],["の"],["子","こ"],["ヨナタン"],["と"],["の"],["間","あいだ"],["に"],["は"],["主","ぬし"],["を"],["さして"],["立てた","たてた"],["誓い","ちかい"],["が"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"王はアヤの娘リツパとサウルの間に生まれた二人の息子、アルモニとメフィボシェトと、サウルの娘ミカルとメホラ人バルジライの子アドリエルとの間に生まれた五人の息子を捕らえ、","tok":[["王","おう"],["は"],["アヤ"],["の"],["娘","むすめ"],["リツパ"],["と"],["サウル"],["の"],["間","あいだ"],["に"],["生まれた","うまれた"],["二人","ふたり"],["の"],["息子","むすこ"],["、"],["アルモニ"],["と"],["メフィボシェト"],["と"],["、"],["サウル"],["の"],["娘","むすめ"],["ミカル"],["と"],["メホラ人","めほらにん"],["バルジライ"],["の"],["子","こ"],["アドリエル"],["と"],["の"],["間","あいだ"],["に"],["生まれた","うまれた"],["五人","ごにん"],["の"],["息子","むすこ"],["を"],["捕らえ","とらえ"],["、"]]},{"verse":9,"text":"ギブオン人の手に渡した。ギブオンの人々は彼らを山で主の御前にさらした。七人は一度に処刑された。彼らが殺されたのは刈り入れの初め、大麦の収穫が始まるころであった。","tok":[["ギブオン"],["人","にん"],["の"],["手","て"],["に"],["渡した","わたした"],["。"],["ギブオン"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["を"],["山","やま"],["で"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["さらした"],["。"],["七人","ななにん"],["は"],["一度","いちど"],["に"],["処刑","しょけい"],["された"],["。"],["彼","かれ"],["ら"],["が"],["殺された","ころされた"],["の"],["は"],["刈り入れ","かりいれ"],["の"],["初め","はじめ"],["、"],["大麦","おおむぎ"],["の"],["収穫","しゅうかく"],["が"],["始まる","はじまる"],["ころ"],["で"],["あった"],["。"]]},{"verse":10,"text":"アヤの娘リツパは粗布を取って岩の上に広げた。収穫の初めのころから、死者たちに雨が天から降り注ぐころまで、リツパは昼は空の鳥が死者の上にとまることを、夜は野の獣が襲うことを防いだ。","tok":[["アヤ"],["の"],["娘","むすめ"],["リツパ"],["は"],["粗布","そふ"],["を"],["取って","とって"],["岩","いわ"],["の"],["上","うえ"],["に"],["広げた","ひろげた"],["。"],["収穫","しゅうかく"],["の"],["初め","はじめ"],["の"],["ころ"],["から"],["、"],["死者","ししゃ"],["たち"],["に"],["雨","あめ"],["が"],["天","てん"],["から"],["降り注ぐ","ふりそそぐ"],["ころ"],["まで"],["、"],["リツパ"],["は"],["昼","ひる"],["は"],["空","そら"],["の"],["鳥","とり"],["が"],["死者","ししゃ"],["の"],["上","うえ"],["に"],["とまる"],["こと"],["を"],["、"],["夜","よる"],["は"],["野","の"],["の"],["獣","けもの"],["が"],["襲う","おそう"],["こと"],["を"],["防いだ","ふせいだ"],["。"]]},{"verse":11,"text":"サウルの側女、アヤの子リツパのこの行いは王に報告された。","tok":[["サウル"],["の"],["側女","そばめ"],["、"],["アヤ"],["の"],["子","こ"],["リツパ"],["の"],["この"],["行い","おこない"],["は"],["王","おう"],["に"],["報告","ほうこく"],["された"],["。"]]},{"verse":12,"text":"ダビデはギレアドのヤベシュの人々のところへ行って、サウルの骨とその子ヨナタンの骨を受け取った。その遺骨はギレアドのヤベシュの人々がベト‧シャンの広場から奪い取って来たもので、ペリシテ人がギルボアでサウルを討った日に、そこにさらしたものであった。","tok":[["ダビデ"],["は"],["ギレアド"],["の"],["ヤベシュ"],["の"],["人々","ひとびと"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["サウル"],["の"],["骨","ほね"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["を"],["受け取った","うけとった"],["。"],["その"],["遺骨","いこつ"],["は"],["ギレアド"],["の"],["ヤベシュ"],["の"],["人々","ひとびと"],["が"],["ベト"],["‧"],["シャン"],["の"],["広場","ひろば"],["から"],["奪い取って","うばいとって"],["来た","きた"],["もの"],["で"],["、"],["ペリシテ"],["人","にん"],["が"],["ギルボア"],["で"],["サウル"],["を"],["討った","うった"],["日","ひ"],["に"],["、"],["そこ"],["に"],["さらした"],["もの"],["で"],["あった"],["。"]]},{"verse":13,"text":"ダビデはそこからサウルの骨とその子ヨナタンの骨を運び、人々は今回さらされた者たちの骨を集め、","tok":[["ダビデ"],["は"],["そこ"],["から"],["サウル"],["の"],["骨","ほね"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["を"],["運び","はこび"],["、"],["人々","ひとびと"],["は"],["今回","こんかい"],["さらされた"],["者","もの"],["たち"],["の"],["骨","ほね"],["を"],["集め","あつめ"],["、"]]},{"verse":14,"text":"サウルとその子ヨナタンの骨と共にベニヤミンの地ツェラにあるサウルの父キシュの墓に葬った。人々は王の命令をすべて果たした。この後、神はこの国の祈りにこたえられた。","tok":[["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["の"],["骨","ほね"],["と"],["共","とも"],["に"],["ベニヤミン"],["の"],["地","ち"],["ツェラ"],["に"],["ある"],["サウル"],["の"],["父","ちち"],["キシュ"],["の"],["墓","はか"],["に"],["葬った","ほうむった"],["。"],["人々","ひとびと"],["は"],["王","おう"],["の"],["命令","めいれい"],["を"],["すべて"],["果たした","はたした"],["。"],["この"],["後","ご"],["、"],["神","かみ"],["は"],["この"],["国","くに"],["の"],["祈り","いのり"],["に"],["こたえられた"],["。"]]},{"verse":15,"text":"ペリシテ人は再びイスラエルと戦った。ダビデは家臣を率いて出陣し、ペリシテと戦ったが、ダビデは疲れていた。","tok":[["ペリシテ"],["人","にん"],["は"],["再び","ふたたび"],["イスラエル"],["と"],["戦った","たたかった"],["。"],["ダビデ"],["は"],["家臣","かしん"],["を"],["率いて","ひきいて"],["出陣","しゅつじん"],["し"],["、"],["ペリシテ"],["と"],["戦った","たたかった"],["が"],["、"],["ダビデ"],["は"],["疲れて","つかれて"],["いた"],["。"]]},{"verse":16,"text":"ラファの子孫の一人イシュビ‧ベノブは、三百シェケルの重さの青銅の槍を持ち、新しい帯を付けて、ダビデを討つ、と言った。","tok":[["ラファ"],["の"],["子孫","しそん"],["の"],["一人","ひとり"],["イシュビ"],["‧"],["ベノブ"],["は"],["、"],["三百","さんひゃく"],["シェケル"],["の"],["重さ","おもさ"],["の"],["青銅","せいどう"],["の"],["槍","やり"],["を"],["持ち","もち"],["、"],["新しい","あたらしい"],["帯","おび"],["を"],["付けて","つけて"],["、"],["ダビデ"],["を"],["討つ","うつ"],["、"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"しかし、ツェルヤの子アビシャイは、ダビデを助けてこのペリシテ人を打ち殺した。それ以来、ダビデの家来たちはダビデに誓わせた。「以後、我々と共に戦いに出てはなりません。イスラエルの灯を消さぬよう心掛けてください。」","tok":[["しかし"],["、"],["ツェルヤ"],["の"],["子","こ"],["アビシャイ"],["は"],["、"],["ダビデ"],["を"],["助けて","たすけて"],["この"],["ペリシテ"],["人","にん"],["を"],["打ち殺した","うちころした"],["。"],["それ"],["以来","いらい"],["、"],["ダビデ"],["の"],["家来","けらい"],["たち"],["は"],["ダビデ"],["に"],["誓わせた","ちかわせた"],["。"],["「"],["以後","いご"],["、"],["我々","われわれ"],["と"],["共","とも"],["に"],["戦い","たたかい"],["に"],["出て","でて"],["は"],["なりません"],["。"],["イスラエル"],["の"],["灯","あかり"],["を"],["消さぬ","けさぬ"],["よう"],["心掛けて","こころがけて"],["ください"],["。"],["」"]]},{"verse":18,"text":"その後、ゴブの地で、再びペリシテ人との戦いがあった。このときは、フシャ人シベカイがラファの子孫の一人サフを打ち殺した。","tok":[["その"],["後","ご"],["、"],["ゴブ"],["の"],["地","ち"],["で"],["、"],["再び","ふたたび"],["ペリシテ"],["人","にん"],["と"],["の"],["戦い","たたかい"],["が"],["あった"],["。"],["この"],["とき"],["は"],["、"],["フシャ"],["人","ひと"],["シベカイ"],["が"],["ラファ"],["の"],["子孫","しそん"],["の"],["一人","ひとり"],["サフ"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":19,"text":"ゴブで、またペリシテ人との戦いがあったとき、ベツレヘム出身のヤアレ‧オルギムの子エルハナンが、ガト人ゴリアトを打ち殺した。ゴリアトの槍の柄は機織りの巻き棒ほどもあった。","tok":[["ゴブ"],["で"],["、"],["また"],["ペリシテ"],["人","にん"],["と"],["の"],["戦い","たたかい"],["が"],["あった"],["とき"],["、"],["ベツレヘム"],["出身","しゅっしん"],["の"],["ヤアレ"],["‧"],["オルギム"],["の"],["子","こ"],["エルハナン"],["が"],["、"],["ガト人","がとにん"],["ゴリアト"],["を"],["打ち殺した","うちころした"],["。"],["ゴリアト"],["の"],["槍","やり"],["の"],["柄","がら"],["は"],["機織り","はたおり"],["の"],["巻き","まき"],["棒","ぼう"],["ほど"],["も"],["あった"],["。"]]},{"verse":20,"text":"別の戦いがガトでもあった。ラファの子孫で、手足の指が六本ずつ、合わせて二十四本ある巨人が出て来て、","tok":[["別","べつ"],["の"],["戦い","たたかい"],["が"],["ガト"],["で"],["も"],["あった"],["。"],["ラファ"],["の"],["子孫","しそん"],["で"],["、"],["手足","てあし"],["の"],["指","ゆび"],["が"],["六本","ろくぽん"],["ずつ"],["、"],["合わせて","あわせて"],["二十四本","にじゅうよんぽん"],["ある"],["巨人","きょじん"],["が"],["出て","でて"],["来て","きて"],["、"]]},{"verse":21,"text":"イスラエルを辱めたが、ダビデの兄弟シムアの子ヨナタンが彼を討ち取った。","tok":[["イスラエル"],["を"],["辱めた","はずかしめた"],["が"],["、"],["ダビデ"],["の"],["兄弟","きょうだい"],["シムア"],["の"],["子","こ"],["ヨナタン"],["が"],["彼","かれ"],["を"],["討ち取った","うちとった"],["。"]]},{"verse":22,"text":"これら四人はガトにいたラファの子孫で、ダビデとその家臣の手によって倒された。","tok":[["これ"],["ら"],["四人","よんにん"],["は"],["ガト"],["に"],["いた"],["ラファ"],["の"],["子孫","しそん"],["で"],["、"],["ダビデ"],["と"],["その"],["家臣","かしん"],["の"],["手","て"],["によって"],["倒された","たおされた"],["。"]]}]
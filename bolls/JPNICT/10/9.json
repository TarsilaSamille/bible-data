[{"verse":1,"text":"ダビデは言った。「サウル家の者がまだ生き残っているならば、ヨナタンのために、その者に忠実を尽くしたい。」","tok":[["ダビデ"],["は"],["言った","いった"],["。"],["「"],["サウル家","さうるか"],["の"],["者","もの"],["が"],["まだ"],["生き残って","いきのこって"],["いるならば"],["、"],["ヨナタン"],["の"],["ため"],["に"],["、"],["その"],["者","もの"],["に"],["忠実","ちゅうじつ"],["を"],["尽くしたい","つくしたい"],["。"],["」"]]},{"verse":2,"text":"サウル家に仕えていたツィバという名の者がダビデのもとに呼び出された。「お前がツィバか」と王が尋ねると、「僕でございます」と彼は答えた。","tok":[["サウル家","さうるか"],["に"],["仕えて","つかえて"],["いた"],["ツィバ"],["と"],["いう"],["名","な"],["の"],["者","もの"],["が"],["ダビデ"],["の"],["もと"],["に"],["呼び出された","よびだされた"],["。"],["「"],["お前","おまえ"],["が"],["ツィバ"],["か"],["」"],["と"],["王","おう"],["が"],["尋ねる","たずねる"],["と"],["、"],["「"],["僕","ぼく"],["で"],["ございます"],["」"],["と"],["彼","かれ"],["は"],["答えた","こたえた"],["。"]]},{"verse":3,"text":"王は言った。「サウル家には、もうだれも残っていないのか。いるなら、その者に神に誓った忠実を尽くしたいが。」「ヨナタンさまの御子息が一人おられます。両足の萎えた方でございます」とツィバは王に答えた。","tok":[["王","おう"],["は"],["言った","いった"],["。"],["「"],["サウル家","さうるか"],["に"],["は"],["、"],["もう"],["だれ"],["も"],["残って","のこって"],["いない"],["の"],["か"],["。"],["いるなら"],["、"],["その"],["者","もの"],["に"],["神","かみ"],["に"],["誓った","ちかった"],["忠実","ちゅうじつ"],["を"],["尽くしたい","つくしたい"],["が"],["。"],["」"],["「"],["ヨナタン"],["さま"],["の"],["御子息","ごしそく"],["が"],["一人","ひとり"],["おられます"],["。"],["両足","りょうあし"],["の"],["萎えた","なえた"],["方","ほう"],["で"],["ございます"],["」"],["と"],["ツィバ"],["は"],["王","おう"],["に"],["答えた","こたえた"],["。"]]},{"verse":4,"text":"王は「どこにいるのか」と問い、ツィバは王に、「ロ‧デバルにあるアミエルの子マキルの家におられます」と答えた。","tok":[["王","おう"],["は"],["「"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["問い","とい"],["、"],["ツィバ"],["は"],["王","おう"],["に"],["、"],["「"],["ロ"],["‧"],["デバル"],["に"],["ある"],["アミエル"],["の"],["子","こ"],["マキル"],["の"],["家","いえ"],["に"],["おられます"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":5,"text":"ダビデ王は人を遣わし、ロ‧デバルにあるアミエルの子マキルの家から彼を連れて来させた。","tok":[["ダビデ"],["王","おう"],["は"],["人","ひと"],["を"],["遣わし","つかわし"],["、"],["ロ"],["‧"],["デバル"],["に"],["ある"],["アミエル"],["の"],["子","こ"],["マキル"],["の"],["家","いえ"],["から"],["彼","かれ"],["を"],["連れて","つれて"],["来させた","きさせた"],["。"]]},{"verse":6,"text":"サウルの子ヨナタンの子メフィボシェトは、ダビデの前に来るとひれ伏して礼をした。「メフィボシェトよ」とダビデが言うと、「僕です」と彼は答えた。","tok":[["サウル"],["の"],["子","こ"],["ヨナタン"],["の"],["子","こ"],["メフィボシェト"],["は"],["、"],["ダビデ"],["の"],["前","まえ"],["に"],["来る","くる"],["と"],["ひれ伏して","ひれふして"],["礼","れい"],["を"],["した"],["。"],["「"],["メフィボシェト"],["よ"],["」"],["と"],["ダビデ"],["が"],["言う","ゆう"],["と"],["、"],["「"],["僕","ぼく"],["です"],["」"],["と"],["彼","かれ"],["は"],["答えた","こたえた"],["。"]]},{"verse":7,"text":"「恐れることはない。あなたの父ヨナタンのために、わたしはあなたに忠実を尽くそう。祖父サウルの地所はすべて返す。あなたはいつもわたしの食卓で食事をするように」とダビデが言うと、","tok":[["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["あなた"],["の"],["父","ちち"],["ヨナタン"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["あなた"],["に"],["忠実","ちゅうじつ"],["を"],["尽くそう","つくそう"],["。"],["祖父","そふ"],["サウル"],["の"],["地所","じしょ"],["は"],["すべて"],["返す","かえす"],["。"],["あなた"],["は"],["いつも"],["わたし"],["の"],["食卓","しょくたく"],["で"],["食事","しょくじ"],["を"],["する"],["よう"],["に"],["」"],["と"],["ダビデ"],["が"],["言う","ゆう"],["と"],["、"]]},{"verse":8,"text":"メフィボシェトは礼をして言った。「僕など何者でありましょうか。死んだ犬も同然のわたしを顧みてくださるとは。」","tok":[["メフィボシェト"],["は"],["礼","れい"],["を"],["して"],["言った","いった"],["。"],["「"],["僕","ぼく"],["など"],["何者","なにもの"],["で"],["ありましょう"],["か"],["。"],["死んだ","しんだ"],["犬","いぬ"],["も"],["同然","どうぜん"],["の"],["わたし"],["を"],["顧みて","かえりみて"],["くださる"],["と"],["は"],["。"],["」"]]},{"verse":9,"text":"王は、サウルの従者であったツィバを呼んで言った。「サウルとその家の所有であったものはすべてお前の主人の子息に与えることにした。","tok":[["王","おう"],["は"],["、"],["サウル"],["の"],["従者","じゅうしゃ"],["で"],["あった"],["ツィバ"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["サウル"],["と"],["その"],["家","いえ"],["の"],["所有","しょゆう"],["で"],["あった"],["もの"],["は"],["すべて"],["お前","おまえ"],["の"],["主人","しゅじん"],["の"],["子息","しそく"],["に"],["与える","あたえる"],["こと"],["に"],["した"],["。"]]},{"verse":10,"text":"お前は、息子たち、召し使いたちと共に、その土地を耕して収穫をあげ、お前の主人の子息のために生計を立てよ。お前の主人の子息メフィボシェトは、いつもわたしの食卓で食事をすることになる。」ツィバには十五人の息子と二十人の召し使いがいた。","tok":[["お前","おまえ"],["は"],["、"],["息子","むすこ"],["たち"],["、"],["召し使い","めしつかい"],["たち"],["と"],["共","とも"],["に"],["、"],["その"],["土地","とち"],["を"],["耕して","たがやして"],["収穫","しゅうかく"],["を"],["あげ"],["、"],["お前","おまえ"],["の"],["主人","しゅじん"],["の"],["子息","しそく"],["の"],["ため"],["に"],["生計","せいけい"],["を"],["立て","たて"],["よ"],["。"],["お前","おまえ"],["の"],["主人","しゅじん"],["の"],["子息","しそく"],["メフィボシェト"],["は"],["、"],["いつも"],["わたし"],["の"],["食卓","しょくたく"],["で"],["食事","しょくじ"],["を"],["する"],["こと"],["に"],["なる"],["。"],["」"],["ツィバ"],["に"],["は"],["十五人","じゅうごにん"],["の"],["息子","むすこ"],["と"],["二","に"],["十人","じゅうにん"],["の"],["召し使い","めしつかい"],["が"],["いた"],["。"]]},{"verse":11,"text":"ツィバは王に答えた。「私の主君、王が僕にお命じになりましたことはすべて、僕が間違いなく実行いたします。」メフィボシェトは王子の一人のように、ダビデの食卓で食事をした。","tok":[["ツィバ"],["は"],["王","おう"],["に"],["答えた","こたえた"],["。"],["「"],["私","わたくし"],["の"],["主君","しゅくん"],["、"],["王","おう"],["が"],["僕","ぼく"],["に"],["お命じ","おめいじ"],["に"],["なりました"],["こと"],["は"],["すべて"],["、"],["僕","ぼく"],["が"],["間違い","まちがい"],["なく"],["実行","じっこう"],["いたします"],["。"],["」"],["メフィボシェト"],["は"],["王子","おうじ"],["の"],["一人","ひとり"],["の"],["よう"],["に"],["、"],["ダビデ"],["の"],["食卓","しょくたく"],["で"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":12,"text":"メフィボシェトにはミカという幼い息子がいた。ツィバの家に住む者は皆、メフィボシェトの召し使いとなった。","tok":[["メフィボシェト"],["に"],["は"],["ミカ"],["と"],["いう"],["幼い","おさない"],["息子","むすこ"],["が"],["いた"],["。"],["ツィバ"],["の"],["家","いえ"],["に"],["住む","すむ"],["者","もの"],["は"],["皆","みな"],["、"],["メフィボシェト"],["の"],["召し使い","めしつかい"],["と"],["なった"],["。"]]},{"verse":13,"text":"メフィボシェトは王の食卓に連なるのが常のことであり、両足とも不自由なので、エルサレムに住んだ。","tok":[["メフィボシェト"],["は"],["王","おう"],["の"],["食卓","しょくたく"],["に"],["連なる","つらなる"],["の"],["が"],["常","つね"],["の"],["こと"],["で"],["あり"],["、"],["両足","りょうあし"],["とも"],["不自由","ふじゆう"],["な"],["ので"],["、"],["エルサレム"],["に"],["住んだ","すんだ"],["。"]]}]
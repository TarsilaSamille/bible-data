[{"verse":1,"text":"主はナタンをダビデのもとに遣わされた。ナタンは来て、次のように語った。「二人の男がある町にいた。一人は豊かで、一人は貧しかった。","tok":[["主","ぬし"],["は"],["ナタン"],["を"],["ダビデ"],["の"],["もと"],["に"],["遣わされた","つかわされた"],["。"],["ナタン"],["は"],["来て","きて"],["、"],["次","つぎ"],["の"],["よう"],["に"],["語った","かたった"],["。"],["「"],["二人","ふたり"],["の"],["男","おとこ"],["が"],["ある"],["町","まち"],["に"],["いた"],["。"],["一人","ひとり"],["は"],["豊か","ゆたか"],["で"],["、"],["一人","ひとり"],["は"],["貧しかった","まずしかった"],["。"]]},{"verse":2,"text":"豊かな男は非常に多くの羊や牛を持っていた。","tok":[["豊か","ゆたか"],["な"],["男","おとこ"],["は"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":3,"text":"貧しい男は自分で買った一匹の雌の小羊のほかに何一つ持っていなかった。彼はその小羊を養い小羊は彼のもとで育ち、息子たちと一緒にいて彼の皿から食べ、彼の椀から飲み彼のふところで眠り、彼にとっては娘のようだった。","tok":[["貧しい","まずしい"],["男","おとこ"],["は"],["自分","じぶん"],["で"],["買った","かった"],["一匹","いちひき"],["の"],["雌","めす"],["の"],["小羊","こひつじ"],["の"],["ほか"],["に"],["何","なん"],["一","ひと"],["つ"],["持って","もって"],["いなかった"],["。"],["彼","かれ"],["は"],["その"],["小羊","こひつじ"],["を"],["養い","やしない"],["小羊","こひつじ"],["は"],["彼","かれ"],["の"],["もと"],["で"],["育ち","そだち"],["、"],["息子","むすこ"],["たち"],["と"],["一緒","いっしょ"],["に"],["いて"],["彼","かれ"],["の"],["皿","さら"],["から"],["食べ","たべ"],["、"],["彼","かれ"],["の"],["椀","わん"],["から"],["飲み","のみ"],["彼","かれ"],["の"],["ふところ"],["で"],["眠り","ねむり"],["、"],["彼","かれ"],["にとって"],["は"],["娘","むすめ"],["の"],["よう"],["だった"],["。"]]},{"verse":4,"text":"ある日、豊かな男に一人の客があった。彼は訪れて来た旅人をもてなすのに自分の羊や牛を惜しみ貧しい男の小羊を取り上げて自分の客に振る舞った。」","tok":[["ある"],["日","ひ"],["、"],["豊か","ゆたか"],["な"],["男","おとこ"],["に"],["一人","ひとり"],["の"],["客","きゃく"],["が"],["あった"],["。"],["彼","かれ"],["は"],["訪れて","おとずれて"],["来た","きた"],["旅人","たびびと"],["を"],["もてなす"],["のに"],["自分","じぶん"],["の"],["羊","ひつじ"],["や"],["牛","うし"],["を"],["惜しみ","おしみ"],["貧しい","まずしい"],["男","おとこ"],["の"],["小羊","こひつじ"],["を"],["取り上げて","とりあげて"],["自分","じぶん"],["の"],["客","きゃく"],["に"],["振る舞った","ふるまった"],["。"],["」"]]},{"verse":5,"text":"ダビデはその男に激怒し、ナタンに言った。「主は生きておられる。そんなことをした男は死罪だ。","tok":[["ダビデ"],["は"],["その"],["男","おとこ"],["に"],["激怒","げきど"],["し"],["、"],["ナタン"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["そんな"],["こと"],["を"],["した"],["男","おとこ"],["は"],["死罪","しざい"],["だ"],["。"]]},{"verse":6,"text":"小羊の償いに四倍の価を払うべきだ。そんな無慈悲なことをしたのだから。」","tok":[["小羊","こひつじ"],["の"],["償い","つぐない"],["に"],["四","よん"],["倍","ばい"],["の"],["価","あたい"],["を"],["払うべきだ","はらうべきだ"],["。"],["そんな"],["無慈悲","むじひ"],["な"],["こと"],["を"],["した"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":7,"text":"ナタンはダビデに向かって言った。「その男はあなただ。イスラエルの神、主はこう言われる。『あなたに油を注いでイスラエルの王としたのはわたしである。わたしがあなたをサウルの手から救い出し、","tok":[["ナタン"],["は"],["ダビデ"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["その"],["男","おとこ"],["は"],["あなた"],["だ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["あなた"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["の"],["は"],["わたし"],["で"],["ある"],["。"],["わたし"],["が"],["あなた"],["を"],["サウル"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"]]},{"verse":8,"text":"あなたの主君であった者の家をあなたに与え、その妻たちをあなたのふところに置き、イスラエルとユダの家をあなたに与えたのだ。不足なら、何であれ加えたであろう。","tok":[["あなた"],["の"],["主君","しゅくん"],["で"],["あった"],["者","もの"],["の"],["家","いえ"],["を"],["あなた"],["に"],["与え","あたえ"],["、"],["その"],["妻たち","つまたち"],["を"],["あなた"],["の"],["ふところ"],["に"],["置き","おき"],["、"],["イスラエル"],["と"],["ユダ"],["の"],["家","いえ"],["を"],["あなた"],["に"],["与えた","あたえた"],["の"],["だ"],["。"],["不足","ふそく"],["なら"],["、"],["何","なん"],["で"],["あれ"],["加えたで","くわえたで"],["あろう"],["。"]]},{"verse":9,"text":"なぜ主の言葉を侮り、わたしの意に背くことをしたのか。あなたはヘト人ウリヤを剣にかけ、その妻を奪って自分の妻とした。ウリヤをアンモン人の剣で殺したのはあなただ。","tok":[["なぜ"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["侮り","あなどり"],["、"],["わたし"],["の"],["意","い"],["に"],["背く","そむく"],["こと"],["を"],["した"],["の"],["か"],["。"],["あなた"],["は"],["ヘト人","へとにん"],["ウリヤ"],["を"],["剣","けん"],["に"],["かけ"],["、"],["その"],["妻","つま"],["を"],["奪って","うばって"],["自分","じぶん"],["の"],["妻","つま"],["と"],["した"],["。"],["ウリヤ"],["を"],["アンモン"],["人","にん"],["の"],["剣","けん"],["で"],["殺した","ころした"],["の"],["は"],["あなた"],["だ"],["。"]]},{"verse":10,"text":"それゆえ、剣はとこしえにあなたの家から去らないであろう。あなたがわたしを侮り、ヘト人ウリヤの妻を奪って自分の妻としたからだ。』","tok":[["それ"],["ゆえ"],["、"],["剣","けん"],["は"],["とこしえ"],["に"],["あなた"],["の"],["家","いえ"],["から"],["去らないで","さらないで"],["あろう"],["。"],["あなた"],["が"],["わたし"],["を"],["侮り","あなどり"],["、"],["ヘト人","へとにん"],["ウリヤ"],["の"],["妻","つま"],["を"],["奪って","うばって"],["自分","じぶん"],["の"],["妻","つま"],["と"],["した"],["から"],["だ"],["。"],["』"]]},{"verse":11,"text":"主はこう言われる。『見よ、わたしはあなたの家の者の中からあなたに対して悪を働く者を起こそう。あなたの目の前で妻たちを取り上げ、あなたの隣人に与える。彼はこの太陽の下であなたの妻たちと床を共にするであろう。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["家","いえ"],["の"],["者","もの"],["の"],["中","なか"],["から"],["あなた"],["に対して","にたいして"],["悪","あく"],["を"],["働く","はたらく"],["者","もの"],["を"],["起こそう","おこそう"],["。"],["あなた"],["の"],["目","め"],["の"],["前","まえ"],["で"],["妻たち","つまたち"],["を"],["取り上げ","とりあげ"],["、"],["あなた"],["の"],["隣人","りんじん"],["に"],["与える","あたえる"],["。"],["彼","かれ"],["は"],["この"],["太陽","たいよう"],["の"],["下","もと"],["で"],["あなた"],["の"],["妻たち","つまたち"],["と"],["床","ゆか"],["を"],["共","とも"],["に"],["するで"],["あろう"],["。"]]},{"verse":12,"text":"あなたは隠れて行ったが、わたしはこれを全イスラエルの前で、太陽の下で行う。』」","tok":[["あなた"],["は"],["隠れて","かくれて"],["行った","いった"],["が"],["、"],["わたし"],["は"],["これ"],["を"],["全","ぜん"],["イスラエル"],["の"],["前","まえ"],["で"],["、"],["太陽","たいよう"],["の"],["下","もと"],["で"],["行う","おこなう"],["。"],["』"],["」"]]},{"verse":13,"text":"ダビデはナタンに言った。「わたしは主に罪を犯した。」ナタンはダビデに言った。「その主があなたの罪を取り除かれる。あなたは死の罰を免れる。","tok":[["ダビデ"],["は"],["ナタン"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["主に","おもに"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["」"],["ナタン"],["は"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["その"],["主","ぬし"],["が"],["あなた"],["の"],["罪","つみ"],["を"],["取り除かれる","とりのぞかれる"],["。"],["あなた"],["は"],["死","し"],["の"],["罰","ばつ"],["を"],["免れる","まぬがれる"],["。"]]},{"verse":14,"text":"しかし、このようなことをして主を甚だしく軽んじたのだから、生まれてくるあなたの子は必ず死ぬ。」","tok":[["しかし"],["、"],["この"],["よう"],["な"],["こと"],["を"],["して"],["主","ぬし"],["を"],["甚だしく","はなはだしく"],["軽んじた","かろんじた"],["の"],["だ"],["から"],["、"],["生まれて","うまれて"],["くる"],["あなた"],["の"],["子","こ"],["は"],["必ず","かならず"],["死ぬ","しぬ"],["。"],["」"]]},{"verse":15,"text":"ナタンは自分の家に帰って行った。主はウリヤの妻が産んだダビデの子を打たれ、その子は弱っていった。","tok":[["ナタン"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰って","かえって"],["行った","いった"],["。"],["主","ぬし"],["は"],["ウリヤ"],["の"],["妻","つま"],["が"],["産んだ","うんだ"],["ダビデ"],["の"],["子","こ"],["を"],["打たれ","うたれ"],["、"],["その"],["子","こ"],["は"],["弱って","よわって"],["いった"],["。"]]},{"verse":16,"text":"ダビデはその子のために神に願い求め、断食した。彼は引きこもり、地面に横たわって夜を過ごした。","tok":[["ダビデ"],["は"],["その"],["子","こ"],["の"],["ため"],["に"],["神","かみ"],["に"],["願い求め","ねがいもとめ"],["、"],["断食","だんじき"],["した"],["。"],["彼","かれ"],["は"],["引きこもり","ひきこもり"],["、"],["地面","じめん"],["に"],["横たわって","よこたわって"],["夜","よる"],["を"],["過ごした","すごした"],["。"]]},{"verse":17,"text":"王家の長老たちはその傍らに立って、王を地面から起き上がらせようとしたが、ダビデはそれを望まず、彼らと共に食事をとろうともしなかった。","tok":[["王家","おうけ"],["の"],["長老","ちょうろう"],["たち"],["は"],["その"],["傍ら","かたわら"],["に"],["立って","たって"],["、"],["王","おう"],["を"],["地面","じめん"],["から"],["起き上がらせよう","おきあがらせよう"],["と"],["した"],["が"],["、"],["ダビデ"],["は"],["それ"],["を"],["望まず","のぞまず"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["食事","しょくじ"],["を"],["とろう"],["と"],["も"],["しなかった"],["。"]]},{"verse":18,"text":"七日目にその子は死んだ。家臣たちは、その子が死んだとダビデに告げるのを恐れ、こう話し合った。「お子様がまだ生きておられたときですら、何を申し上げてもわたしたちの声に耳を傾けてくださらなかったのに、どうして亡くなられたとお伝えできよう。何かよくないことをなさりはしまいか。」","tok":[["七日目","ななかめ"],["に"],["その"],["子","こ"],["は"],["死んだ","しんだ"],["。"],["家臣","かしん"],["たち"],["は"],["、"],["その"],["子","こ"],["が"],["死んだ","しんだ"],["と"],["ダビデ"],["に"],["告げる","つげる"],["の"],["を"],["恐れ","おそれ"],["、"],["こう"],["話し合った","はなしあった"],["。"],["「"],["お子様","おこさま"],["が"],["まだ"],["生きて","いきて"],["おられた"],["とき"],["で"],["すら"],["、"],["何","なん"],["を"],["申し上げて","もうしあげて"],["も"],["わたしたち"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["くださらなかった"],["のに"],["、"],["どう"],["して"],["亡くなられた","なくなられた"],["と"],["お伝え","おつたえ"],["できよう"],["。"],["何","なん"],["か"],["よく"],["ない"],["こと"],["を"],["なさり"],["は"],["しまい"],["か"],["。"],["」"]]},{"verse":19,"text":"ダビデは家臣がささやき合っているのを見て、子が死んだと悟り、言った。「あの子は死んだのか。」彼らは答えた。「お亡くなりになりました。」","tok":[["ダビデ"],["は"],["家臣","かしん"],["が"],["ささやき合って","ささやきあって"],["いる"],["の"],["を"],["見て","みて"],["、"],["子","こ"],["が"],["死んだ","しんだ"],["と"],["悟り","さとり"],["、"],["言った","いった"],["。"],["「"],["あの"],["子","こ"],["は"],["死んだ","しんだ"],["の"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["お亡くなり","おなくなり"],["に"],["なりました"],["。"],["」"]]},{"verse":20,"text":"ダビデは地面から起き上がり、身を洗って香油を塗り、衣を替え、主の家に行って礼拝した。王宮に戻ると、命じて食べ物を用意させ、食事をした。","tok":[["ダビデ"],["は"],["地面","じめん"],["から"],["起き上がり","おきあがり"],["、"],["身","み"],["を"],["洗って","あらって"],["香油","こうゆ"],["を"],["塗り","ぬり"],["、"],["衣","ころも"],["を"],["替え","かえ"],["、"],["主","ぬし"],["の"],["家","いえ"],["に"],["行って","いって"],["礼拝","れいはい"],["した"],["。"],["王宮","おうきゅう"],["に"],["戻る","もどる"],["と"],["、"],["命じて","めいじて"],["食べ物","たべもの"],["を"],["用意","ようい"],["させ"],["、"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":21,"text":"家臣は尋ねた。「どうしてこのようにふるまわれるのですか。お子様の生きておられるときは断食してお泣きになり、お子様が亡くなられると起き上がって食事をなさいます。」","tok":[["家臣","かしん"],["は"],["尋ねた","たずねた"],["。"],["「"],["どう"],["して"],["この"],["よう"],["に"],["ふるまわれる"],["の"],["です"],["か"],["。"],["お子様","おこさま"],["の"],["生きて","いきて"],["おられる"],["とき"],["は"],["断食","だんじき"],["して"],["お泣き","おなき"],["に"],["なり"],["、"],["お子様","おこさま"],["が"],["亡くなられる","なくなられる"],["と"],["起き上がって","おきあがって"],["食事","しょくじ"],["を"],["なさいます"],["。"],["」"]]},{"verse":22,"text":"彼は言った。「子がまだ生きている間は、主がわたしを憐れみ、子を生かしてくださるかもしれないと思ったからこそ、断食して泣いたのだ。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["子","こ"],["が"],["まだ"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["主","ぬし"],["が"],["わたし"],["を"],["憐れみ","あわれみ"],["、"],["子","こ"],["を"],["生かして","いかして"],["くださる"],["か"],["も"],["しれない"],["と"],["思った","おもった"],["から"],["こそ"],["、"],["断食","だんじき"],["して"],["泣いた","ないた"],["の"],["だ"],["。"]]},{"verse":23,"text":"だが死んでしまった。断食したところで、何になろう。あの子を呼び戻せようか。わたしはいずれあの子のところに行く。しかし、あの子がわたしのもとに帰って来ることはない。」","tok":[["だ"],["が"],["死んで","しんで"],["しまった"],["。"],["断食","だんじき"],["した"],["ところ"],["で"],["、"],["何","なん"],["に"],["なろう"],["。"],["あの"],["子","こ"],["を"],["呼び戻せよう","よびもどせよう"],["か"],["。"],["わたし"],["は"],["いずれ"],["あの"],["子","こ"],["の"],["ところ"],["に"],["行く","いく"],["。"],["しかし"],["、"],["あの"],["子","こ"],["が"],["わたし"],["の"],["もと"],["に"],["帰って","かえって"],["来る","くる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":24,"text":"ダビデは妻バト‧シェバを慰め、彼女のところに行って床を共にした。バト‧シェバは男の子を産み、ダビデはその子をソロモンと名付けた。主はその子を愛され、","tok":[["ダビデ"],["は"],["妻","つま"],["バト"],["‧"],["シェバ"],["を"],["慰め","なぐさめ"],["、"],["彼女","かのじょ"],["の"],["ところ"],["に"],["行って","いって"],["床","ゆか"],["を"],["共","とも"],["に"],["した"],["。"],["バト"],["‧"],["シェバ"],["は"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["ダビデ"],["は"],["その"],["子","こ"],["を"],["ソロモン"],["と"],["名付けた","なづけた"],["。"],["主","ぬし"],["は"],["その"],["子","こ"],["を"],["愛され","あいされ"],["、"]]},{"verse":25,"text":"預言者ナタンを通してそのことを示されたので、主のゆえにその子をエディドヤ（主に愛された者）とも名付けた。","tok":[["預言者","よげんしゃ"],["ナタン"],["を"],["通して","とおして"],["その"],["こと"],["を"],["示された","しめされた"],["ので"],["、"],["主","ぬし"],["の"],["ゆえ"],["に"],["その"],["子","こ"],["を"],["エディドヤ"],["（"],["主に","おもに"],["愛された","あいされた"],["者","もの"],["）"],["と"],["も"],["名付けた","なづけた"],["。"]]},{"verse":26,"text":"ヨアブはアンモン人の町ラバと戦い、この王の町を陥れた。","tok":[["ヨアブ"],["は"],["アンモン"],["人","にん"],["の"],["町","まち"],["ラバ"],["と"],["戦い","たたかい"],["、"],["この"],["王","おう"],["の"],["町","まち"],["を"],["陥れた","おとしいれた"],["。"]]},{"verse":27,"text":"ヨアブは使者をダビデに送って言わせた。「わたしはラバと戦い、『水の町』を陥れました。","tok":[["ヨアブ"],["は"],["使者","ししゃ"],["を"],["ダビデ"],["に"],["送って","おくって"],["言わせた","いわせた"],["。"],["「"],["わたし"],["は"],["ラバ"],["と"],["戦い","たたかい"],["、"],["『"],["水","みず"],["の"],["町","まち"],["』"],["を"],["陥れました","おとしいれました"],["。"]]},{"verse":28,"text":"直ちに残りの兵士を集結させ、この町に対して陣を敷き、陥れてください。わたしがこの町を陥れると、この町はわたしの名で呼ばれてしまいます。」","tok":[["直ちに","ただちに"],["残り","のこり"],["の"],["兵士","へいし"],["を"],["集結","しゅうけつ"],["させ"],["、"],["この"],["町","まち"],["に対して","にたいして"],["陣","じん"],["を"],["敷き","しき"],["、"],["陥れて","おとしいれて"],["ください"],["。"],["わたし"],["が"],["この"],["町","まち"],["を"],["陥れる","おとしいれる"],["と"],["、"],["この"],["町","まち"],["は"],["わたし"],["の"],["名","な"],["で"],["呼ばれて","よばれて"],["しまいます"],["。"],["」"]]},{"verse":29,"text":"ダビデは兵士全員を集結させ、ラバに出撃して戦い、これを陥れた。","tok":[["ダビデ"],["は"],["兵士","へいし"],["全員","ぜんいん"],["を"],["集結","しゅうけつ"],["させ"],["、"],["ラバ"],["に"],["出撃","しゅつげき"],["して"],["戦い","たたかい"],["、"],["これ"],["を"],["陥れた","おとしいれた"],["。"]]},{"verse":30,"text":"ダビデはその王の冠を王の頭から奪い取った。それは一キカルの金で作られ、宝石で飾られていた。これはダビデの頭を飾ることになった。ダビデがこの町から奪い去った戦利品はおびただしかった。","tok":[["ダビデ"],["は"],["その"],["王","おう"],["の"],["冠","かんむり"],["を"],["王","おう"],["の"],["頭","あたま"],["から"],["奪い取った","うばいとった"],["。"],["それ"],["は"],["一","いち"],["キカル"],["の"],["金","かね"],["で"],["作られ","つくられ"],["、"],["宝石","ほうせき"],["で"],["飾られて","かざられて"],["いた"],["。"],["これ"],["は"],["ダビデ"],["の"],["頭","あたま"],["を"],["飾る","かざる"],["こと"],["に"],["なった"],["。"],["ダビデ"],["が"],["この"],["町","まち"],["から"],["奪い去った","うばいさった"],["戦利品","せんりひん"],["は"],["おびただしかった"],["。"]]},{"verse":31,"text":"そこにいた人々を引き出し、のこぎり、鉄のつるはし、鉄の斧を持たせて働かせ、れんが作りをさせた。また、アンモン人のほかの町々もすべてこのようにした。それからダビデと兵士は皆、エルサレムに凱旋した。","tok":[["そこ"],["に"],["いた"],["人々","ひとびと"],["を"],["引き出し","ひきだし"],["、"],["のこぎり"],["、"],["鉄","てつ"],["の"],["つるはし"],["、"],["鉄","てつ"],["の"],["斧","おの"],["を"],["持たせて","もたせて"],["働かせ","はたらかせ"],["、"],["れんが"],["作り","つくり"],["を"],["させた"],["。"],["また"],["、"],["アンモン"],["人","にん"],["の"],["ほか"],["の"],["町々","まちまち"],["も"],["すべて"],["この"],["よう"],["に"],["した"],["。"],["それ"],["から"],["ダビデ"],["と"],["兵士","へいし"],["は"],["皆","みな"],["、"],["エルサレム"],["に"],["凱旋","がいせん"],["した"],["。"]]}]
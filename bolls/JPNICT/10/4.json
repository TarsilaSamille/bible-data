[{"verse":1,"text":"アブネルがヘブロンで殺されたと聞いて、サウルの息子イシュ‧ボシェトは力を落とし、全イスラエルはおびえた。","tok":[["アブネル"],["が"],["ヘブロン"],["で"],["殺された","ころされた"],["と"],["聞いて","きいて"],["、"],["サウル"],["の"],["息子","むすこ"],["イシュ"],["‧"],["ボシェト"],["は"],["力","ちから"],["を"],["落とし","おとし"],["、"],["全","ぜん"],["イスラエル"],["は"],["おびえた"],["。"]]},{"verse":2,"text":"このサウルの息子のもとに二人の略奪隊の長がいた。名をバアナとレカブといい、共にベニヤミンの者で、ベエロトのリモンの息子であった。ベエロトもベニヤミン領と考えられるからである。","tok":[["この"],["サウル"],["の"],["息子","むすこ"],["の"],["もと"],["に"],["二人","ふたり"],["の"],["略奪隊","りゃくだつたい"],["の"],["長","ちょう"],["が"],["いた"],["。"],["名","な"],["を"],["バアナ"],["と"],["レカブ"],["と"],["いい"],["、"],["共","とも"],["に"],["ベニヤミン"],["の"],["者","もの"],["で"],["、"],["ベエロト"],["の"],["リモン"],["の"],["息子","むすこ"],["で"],["あった"],["。"],["ベエロト"],["も"],["ベニヤミン"],["領","りょう"],["と"],["考えられる","かんがえられる"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"ベエロトの人々はかつてギタイムに逃げ、今日もそこに寄留している。","tok":[["ベエロト"],["の"],["人々","ひとびと"],["は"],["かつて"],["ギタイム"],["に"],["逃げ","にげ"],["、"],["今日","きょう"],["も"],["そこ"],["に"],["寄留","きりゅう"],["して"],["いる"],["。"]]},{"verse":4,"text":"サウルの子ヨナタンには両足の萎えた息子がいた。サウルとヨナタンの訃報がイズレエルから届いたとき、その子は五歳であった。乳母が抱いて逃げたが、逃げようとして慌てたので彼を落とし、足が不自由になったのである。彼の名はメフィボシェトといった。","tok":[["サウル"],["の"],["子","こ"],["ヨナタン"],["に"],["は"],["両足","りょうあし"],["の"],["萎えた","なえた"],["息子","むすこ"],["が"],["いた"],["。"],["サウル"],["と"],["ヨナタン"],["の"],["訃報","ふほう"],["が"],["イズレエル"],["から"],["届いた","とどいた"],["とき"],["、"],["その"],["子","こ"],["は"],["五歳","ごさい"],["で"],["あった"],["。"],["乳母","うば"],["が"],["抱いて","いだいて"],["逃げた","にげた"],["が"],["、"],["逃げよう","にげよう"],["として"],["慌てた","あわてた"],["ので"],["彼","かれ"],["を"],["落とし","おとし"],["、"],["足","あし"],["が"],["不自由","ふじゆう"],["に"],["なった"],["ので"],["ある"],["。"],["彼","かれ"],["の"],["名","な"],["は"],["メフィボシェト"],["と"],["いった"],["。"]]},{"verse":5,"text":"ベエロト人リモンの子レカブとバアナは、日盛りのころイシュ‧ボシェトの家にやって来た。イシュ‧ボシェトは昼寝をしていた。","tok":[["ベエロト"],["人","にん"],["リモン"],["の"],["子","こ"],["レカブ"],["と"],["バアナ"],["は"],["、"],["日盛り","ひざかり"],["の"],["ころ"],["イシュ"],["‧"],["ボシェト"],["の"],["家","いえ"],["に"],["やって"],["来た","きた"],["。"],["イシュ"],["‧"],["ボシェト"],["は"],["昼寝","ひるね"],["を"],["して"],["いた"],["。"]]},{"verse":6,"text":"レカブとその兄弟バアナは、小麦を受け取る振りをして家の中に入り、彼の下腹を突き刺して殺し、逃亡した。","tok":[["レカブ"],["と"],["その"],["兄弟","きょうだい"],["バアナ"],["は"],["、"],["小麦","こむぎ"],["を"],["受け取る","うけとる"],["振り","ふり"],["を"],["して"],["家","いえ"],["の"],["中","なか"],["に"],["入り","はいり"],["、"],["彼","かれ"],["の"],["下腹","したはら"],["を"],["突き刺して","つきさして"],["殺し","ころし"],["、"],["逃亡","とうぼう"],["した"],["。"]]},{"verse":7,"text":"すなわち、彼らが家に入ると、イシュ‧ボシェトが寝室の寝床に横たわっていたので、二人は彼を突き刺して殺し、首をはねた。彼らはその首を携えてアラバへの道を夜通し歩き、","tok":[["すなわち"],["、"],["彼","かれ"],["ら"],["が"],["家","いえ"],["に"],["入る","はいる"],["と"],["、"],["イシュ"],["‧"],["ボシェト"],["が"],["寝室","しんしつ"],["の"],["寝床","ねどこ"],["に"],["横たわって","よこたわって"],["いた"],["ので"],["、"],["二人","ふたり"],["は"],["彼","かれ"],["を"],["突き刺して","つきさして"],["殺し","ころし"],["、"],["首","くび"],["を"],["はねた"],["。"],["彼","かれ"],["ら"],["は"],["その"],["首","くび"],["を"],["携えて","たずさえて"],["アラバ"],["へ"],["の"],["道","みち"],["を"],["夜通し","よどおし"],["歩き","あるき"],["、"]]},{"verse":8,"text":"ヘブロンのダビデのもとに、その首を持参した。二人は王に言った。「御覧ください。お命をねらっていた、王の敵サウルの子イシュ‧ボシェトの首です。主は、主君、王のために、サウルとその子孫に報復されました。」","tok":[["ヘブロン"],["の"],["ダビデ"],["の"],["もと"],["に"],["、"],["その"],["首","くび"],["を"],["持参","じさん"],["した"],["。"],["二人","ふたり"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["御覧","ごらん"],["ください"],["。"],["お命","おいのち"],["を"],["ねらって"],["いた"],["、"],["王","おう"],["の"],["敵","てき"],["サウル"],["の"],["子","こ"],["イシュ"],["‧"],["ボシェト"],["の"],["首","くび"],["です"],["。"],["主","ぬし"],["は"],["、"],["主君","しゅくん"],["、"],["王","おう"],["の"],["ため"],["に"],["、"],["サウル"],["と"],["その"],["子孫","しそん"],["に"],["報復","ほうふく"],["されました"],["。"],["」"]]},{"verse":9,"text":"ダビデはベエロト人リモンの子レカブとその兄弟バアナに答えて言った。「あらゆる苦難からわたしの命を救われた主は生きておられる。","tok":[["ダビデ"],["は"],["ベエロト"],["人","にん"],["リモン"],["の"],["子","こ"],["レカブ"],["と"],["その"],["兄弟","きょうだい"],["バアナ"],["に"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["あらゆる"],["苦難","くなん"],["から"],["わたし"],["の"],["命","いのち"],["を"],["救われた","すくわれた"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"]]},{"verse":10,"text":"かつてサウルの死をわたしに告げた者は、自分では良い知らせをもたらしたつもりであった。だが、わたしはその者を捕らえ、ツィクラグで処刑した。それが彼の知らせへの報いであった。","tok":[["かつて"],["サウル"],["の"],["死","し"],["を"],["わたし"],["に"],["告げた","つげた"],["者","もの"],["は"],["、"],["自分","じぶん"],["で"],["は"],["良い","よい"],["知らせ","しらせ"],["を"],["もたらした"],["つもり"],["で"],["あった"],["。"],["だ"],["が"],["、"],["わたし"],["は"],["その"],["者","もの"],["を"],["捕らえ","とらえ"],["、"],["ツィクラグ"],["で"],["処刑","しょけい"],["した"],["。"],["それ"],["が"],["彼","かれ"],["の"],["知らせ","しらせ"],["へ"],["の"],["報い","むくい"],["で"],["あった"],["。"]]},{"verse":11,"text":"まして、自分の家の寝床で休んでいた正しい人を、神に逆らう者が殺したのだ。その流血の罪をお前たちの手に問わずにいられようか。お前たちを地上から除き去らずにいられようか。」","tok":[["まして"],["、"],["自分","じぶん"],["の"],["家","いえ"],["の"],["寝床","ねどこ"],["で"],["休んで","やすんで"],["いた"],["正しい","ただしい"],["人","ひと"],["を"],["、"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["が"],["殺した","ころした"],["の"],["だ"],["。"],["その"],["流血","りゅうけつ"],["の"],["罪","つみ"],["を"],["お前","おまえ"],["たち"],["の"],["手","て"],["に"],["問わず","とわず"],["に"],["いられよう"],["か"],["。"],["お前","おまえ"],["たち"],["を"],["地上","ちじょう"],["から"],["除き去らず","のぞきさらず"],["に"],["いられよう"],["か"],["。"],["」"]]},{"verse":12,"text":"ダビデの命令によって、従者は二人を殺して両手両足を切り落とし、ヘブロンの池のほとりで木につるした。イシュ‧ボシェトの首はヘブロンに運ばれ、アブネルの墓に葬られた。","tok":[["ダビデ"],["の"],["命令","めいれい"],["によって"],["、"],["従者","じゅうしゃ"],["は"],["二人","ふたり"],["を"],["殺して","ころして"],["両手","りょうて"],["両足","りょうあし"],["を"],["切り落とし","きりおとし"],["、"],["ヘブロン"],["の"],["池","いけ"],["の"],["ほとり"],["で"],["木","き"],["に"],["つるした"],["。"],["イシュ"],["‧"],["ボシェト"],["の"],["首","くび"],["は"],["ヘブロン"],["に"],["運ばれ","はこばれ"],["、"],["アブネル"],["の"],["墓","はか"],["に"],["葬られた","ほうむられた"],["。"]]}]
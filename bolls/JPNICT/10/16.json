[{"verse":1,"text":"ダビデが山頂を少し下ったときに、メフィボシェトの従者ツィバが、ダビデを迎えた。彼は二頭の鞍を置いたろばに、二百個のパン、百房の干しぶどう、百個の夏の果物、ぶどう酒一袋を積んでいた。","tok":[["ダビデ"],["が"],["山頂","さんちょう"],["を"],["少し","すこし"],["下った","くだった"],["とき"],["に"],["、"],["メフィボシェト"],["の"],["従者","じゅうしゃ"],["ツィバ"],["が"],["、"],["ダビデ"],["を"],["迎えた","むかえた"],["。"],["彼","かれ"],["は"],["二頭","にとう"],["の"],["鞍","くら"],["を"],["置いた","おいた"],["ろば"],["に"],["、"],["二百個","にひゃくこ"],["の"],["パン"],["、"],["百","ひゃく"],["房","ぼう"],["の"],["干し","ほし"],["ぶどう"],["、"],["百個","ひゃくこ"],["の"],["夏","なつ"],["の"],["果物","くだもの"],["、"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["袋","ふくろ"],["を"],["積んで","つんで"],["いた"],["。"]]},{"verse":2,"text":"王が、「お前はこれらのものをどうするのか」と尋ねると、ツィバは、「ろばは王様の御家族の乗用に、パンと夏の果物は従者の食用に、ぶどう酒は荒れ野で疲れた者の飲料に持参いたしました」と答えた。","tok":[["王","おう"],["が"],["、"],["「"],["お前","おまえ"],["は"],["これ"],["ら"],["の"],["もの"],["を"],["どう"],["する"],["の"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["ツィバ"],["は"],["、"],["「"],["ろば"],["は"],["王様","おうさま"],["の"],["御家族","ごかぞく"],["の"],["乗用","じょうよう"],["に"],["、"],["パン"],["と"],["夏","なつ"],["の"],["果物","くだもの"],["は"],["従者","じゅうしゃ"],["の"],["食用","しょくよう"],["に"],["、"],["ぶどう酒","ぶどうしゅ"],["は"],["荒れ野","あれの"],["で"],["疲れた","つかれた"],["者","もの"],["の"],["飲料","いんりょう"],["に"],["持参","じさん"],["いたしました"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":3,"text":"王がツィバに、「お前の主人の息子はどこにいるのか」と尋ねると、ツィバは王に、「エルサレムにとどまっています。『イスラエルの家は今日、父の王座をわたしに返す』と申していました」と答えた。","tok":[["王","おう"],["が"],["ツィバ"],["に"],["、"],["「"],["お前","おまえ"],["の"],["主人","しゅじん"],["の"],["息子","むすこ"],["は"],["どこ"],["に"],["いる"],["の"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["ツィバ"],["は"],["王","おう"],["に"],["、"],["「"],["エルサレム"],["に"],["とどまって"],["います"],["。"],["『"],["イスラエル"],["の"],["家","いえ"],["は"],["今日","きょう"],["、"],["父","ちち"],["の"],["王座","おうざ"],["を"],["わたし"],["に"],["返す","かえす"],["』"],["と"],["申して","もうして"],["いました"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":4,"text":"王はツィバに、「それなら、メフィボシェトに属する物はすべてお前のものにしてよろしい」と言った。ツィバは、「お礼申し上げます。主君である王様の御厚意にあずかることができますように」と言った。","tok":[["王","おう"],["は"],["ツィバ"],["に"],["、"],["「"],["それ"],["なら"],["、"],["メフィボシェト"],["に"],["属する","ぞくする"],["物","もの"],["は"],["すべて"],["お前","おまえ"],["の"],["もの"],["に"],["して"],["よろしい"],["」"],["と"],["言った","いった"],["。"],["ツィバ"],["は"],["、"],["「"],["お礼","おれい"],["申し上げます","もうしあげます"],["。"],["主君","しゅくん"],["で"],["ある"],["王様","おうさま"],["の"],["御厚意","ごこうい"],["に"],["あずかる"],["こと"],["が"],["できます"],["よう"],["に"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"ダビデ王がバフリムにさしかかると、そこからサウル家の一族の出で、ゲラの子、名をシムイという男が呪いながら出て来て、","tok":[["ダビデ"],["王","おう"],["が"],["バフリム"],["に"],["さしかかる"],["と"],["、"],["そこ"],["から"],["サウル家","さうるか"],["の"],["一族","いちぞく"],["の"],["出","で"],["で"],["、"],["ゲラ"],["の"],["子","こ"],["、"],["名","な"],["を"],["シムイ"],["と"],["いう"],["男","おとこ"],["が"],["呪い","のろい"],["ながら"],["出て","でて"],["来て","きて"],["、"]]},{"verse":6,"text":"兵士、勇士が王の左右をすべて固めているにもかかわらず、ダビデ自身とダビデ王の家臣たち皆に石を投げつけた。","tok":[["兵士","へいし"],["、"],["勇士","ゆうし"],["が"],["王","おう"],["の"],["左右","さゆう"],["を"],["すべて"],["固めて","かためて"],["いる"],["に"],["も"],["かかわらず"],["、"],["ダビデ"],["自身","じしん"],["と"],["ダビデ"],["王","おう"],["の"],["家臣","かしん"],["たち"],["皆","みな"],["に"],["石","いし"],["を"],["投げつけた","なげつけた"],["。"]]},{"verse":7,"text":"シムイは呪ってこう言った。「出て行け、出て行け。流血の罪を犯した男、ならず者。","tok":[["シムイ"],["は"],["呪って","のろって"],["こう"],["言った","いった"],["。"],["「"],["出て","でて"],["行け","いけ"],["、"],["出て","でて"],["行け","いけ"],["。"],["流血","りゅうけつ"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["男","おとこ"],["、"],["ならず者","ならずもの"],["。"]]},{"verse":8,"text":"サウル家のすべての血を流して王位を奪ったお前に、主は報復なさる。主がお前の息子アブサロムに王位を渡されたのだ。お前は災難を受けている。お前が流血の罪を犯した男だからだ。」","tok":[["サウル家","さうるか"],["の"],["すべて"],["の"],["血","ち"],["を"],["流して","ながして"],["王位","おうい"],["を"],["奪った","うばった"],["お前","おまえ"],["に"],["、"],["主","ぬし"],["は"],["報復","ほうふく"],["なさる"],["。"],["主","ぬし"],["が"],["お前","おまえ"],["の"],["息子","むすこ"],["アブサロム"],["に"],["王位","おうい"],["を"],["渡された","わたされた"],["の"],["だ"],["。"],["お前","おまえ"],["は"],["災難","さいなん"],["を"],["受けて","うけて"],["いる"],["。"],["お前","おまえ"],["が"],["流血","りゅうけつ"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["男","おとこ"],["だ"],["から"],["だ"],["。"],["」"]]},{"verse":9,"text":"ツェルヤの子アビシャイが王に言った。「なぜあの死んだ犬に主君、王を呪わせておかれるのですか。行かせてください。首を切り落としてやります。」","tok":[["ツェルヤ"],["の"],["子","こ"],["アビシャイ"],["が"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["なぜ"],["あの"],["死んだ","しんだ"],["犬","いぬ"],["に"],["主君","しゅくん"],["、"],["王","おう"],["を"],["呪わせて","のろわせて"],["おかれる"],["の"],["です"],["か"],["。"],["行かせて","いかせて"],["ください"],["。"],["首","くび"],["を"],["切り落として","きりおとして"],["やります"],["。"],["」"]]},{"verse":10,"text":"王は言った。「ツェルヤの息子たちよ、ほうっておいてくれ。主がダビデを呪えとお命じになったのであの男は呪っているのだろうから、『どうしてそんなことをするのか』と誰が言えよう。」","tok":[["王","おう"],["は"],["言った","いった"],["。"],["「"],["ツェルヤ"],["の"],["息子","むすこ"],["たち"],["よ"],["、"],["ほうって"],["おいて"],["くれ"],["。"],["主","ぬし"],["が"],["ダビデ"],["を"],["呪え","のろえ"],["と"],["お命じ","おめいじ"],["に"],["なった"],["ので"],["あの"],["男","おとこ"],["は"],["呪って","のろって"],["いる"],["の"],["だろう"],["から"],["、"],["『"],["どう"],["して"],["そんな"],["こと"],["を"],["する"],["の"],["か"],["』"],["と"],["誰","だれ"],["が"],["言えよう","いえよう"],["。"],["」"]]},{"verse":11,"text":"ダビデは更にアビシャイと家臣の全員に言った。「わたしの身から出た子がわたしの命をねらっている。ましてこれはベニヤミン人だ。勝手にさせておけ。主の御命令で呪っているのだ。","tok":[["ダビデ"],["は"],["更に","さらに"],["アビシャイ"],["と"],["家臣","かしん"],["の"],["全員","ぜんいん"],["に"],["言った","いった"],["。"],["「"],["わたし"],["の"],["身","み"],["から"],["出た","でた"],["子","こ"],["が"],["わたし"],["の"],["命","いのち"],["を"],["ねらって"],["いる"],["。"],["まして"],["これ"],["は"],["ベニヤミン"],["人","にん"],["だ"],["。"],["勝手に","かってに"],["させて"],["おけ"],["。"],["主","ぬし"],["の"],["御命令","ごめいれい"],["で"],["呪って","のろって"],["いる"],["の"],["だ"],["。"]]},{"verse":12,"text":"主がわたしの苦しみを御覧になり、今日の彼の呪いに代えて幸いを返してくださるかもしれない。」","tok":[["主","ぬし"],["が"],["わたし"],["の"],["苦しみ","くるしみ"],["を"],["御覧","ごらん"],["に"],["なり"],["、"],["今日","きょう"],["の"],["彼","かれ"],["の"],["呪い","のろい"],["に"],["代えて","かえて"],["幸い","さいわい"],["を"],["返して","かえして"],["くださる"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":13,"text":"ダビデと一行は道を進んだ。シムイはダビデと平行して山腹を進み、呪っては石を投げ、塵を浴びせかけた。","tok":[["ダビデ"],["と"],["一行","いっこう"],["は"],["道","みち"],["を"],["進んだ","すすんだ"],["。"],["シムイ"],["は"],["ダビデ"],["と"],["平行","へいこう"],["して"],["山腹","さんぷく"],["を"],["進み","すすみ"],["、"],["呪って","のろって"],["は"],["石","いし"],["を"],["投げ","なげ"],["、"],["塵","ごみ"],["を"],["浴びせかけた","あびせかけた"],["。"]]},{"verse":14,"text":"王も同行の兵士も皆、疲れて到着し、そこで一息ついた。","tok":[["王","おう"],["も"],["同行","どうこう"],["の"],["兵士","へいし"],["も"],["皆","みな"],["、"],["疲れて","つかれて"],["到着","とうちゃく"],["し"],["、"],["そこ"],["で"],["一息","ひといき"],["ついた"],["。"]]},{"verse":15,"text":"アブサロムはイスラエル人の兵士を全員率いてエルサレムに入城し、アヒトフェルも共にいた。","tok":[["アブサロム"],["は"],["イスラエル"],["人","にん"],["の"],["兵士","へいし"],["を"],["全員","ぜんいん"],["率いて","ひきいて"],["エルサレム"],["に"],["入城","にゅうじょう"],["し"],["、"],["アヒトフェル"],["も"],["共","とも"],["に"],["いた"],["。"]]},{"verse":16,"text":"ダビデの友、アルキ人フシャイはアブサロムのもとに来て、アブサロムに向かって言った。「王様万歳、王様万歳。」","tok":[["ダビデ"],["の"],["友","とも"],["、"],["アルキ人","あるきにん"],["フシャイ"],["は"],["アブサロム"],["の"],["もと"],["に"],["来て","きて"],["、"],["アブサロム"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["王様","おうさま"],["万歳","ばんざい"],["、"],["王様","おうさま"],["万歳","ばんざい"],["。"],["」"]]},{"verse":17,"text":"アブサロムはフシャイに言った。「お前の友に対する忠実はそのようなものか。なぜ、お前の友について行かなかったのか。」","tok":[["アブサロム"],["は"],["フシャイ"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["の"],["友","とも"],["に"],["対する","たいする"],["忠実","ちゅうじつ"],["は"],["その"],["よう"],["な"],["もの"],["か"],["。"],["なぜ"],["、"],["お前","おまえ"],["の"],["友","とも"],["について"],["行かなかった","いかなかった"],["の"],["か"],["。"],["」"]]},{"verse":18,"text":"フシャイはアブサロムに答えた。「いいえ。主とここにいる兵士とイスラエルの全員が選んだ方にわたしは従い、その方と共にとどまります。","tok":[["フシャイ"],["は"],["アブサロム"],["に"],["答えた","こたえた"],["。"],["「"],["いいえ"],["。"],["主","ぬし"],["と"],["ここ"],["に"],["いる"],["兵士","へいし"],["と"],["イスラエル"],["の"],["全員","ぜんいん"],["が"],["選んだ","えらんだ"],["方","ほう"],["に"],["わたし"],["は"],["従い","したがい"],["、"],["その"],["方","かた"],["と"],["共","とも"],["に"],["とどまります"],["。"]]},{"verse":19,"text":"それでは、わたしは誰に仕えればよいのでしょう。御子息以外にありえましょうか。お父上にお仕えしたようにあなたにお仕えします。」","tok":[["それ"],["で"],["は"],["、"],["わたし"],["は"],["誰","だれ"],["に"],["仕えれば","つかえれば"],["よい"],["の"],["でしょう"],["。"],["御子息","ごしそく"],["以外","いがい"],["に"],["あり"],["えましょう"],["か"],["。"],["お父上","おちちじょう"],["に"],["お仕え","おつかえ"],["した"],["よう"],["に"],["あなた"],["に"],["お仕え","おつかえ"],["します"],["。"],["」"]]},{"verse":20,"text":"アブサロムはアヒトフェルに、「どのようにすべきか、お前たちで策を練ってくれ」と命じた。","tok":[["アブサロム"],["は"],["アヒトフェル"],["に"],["、"],["「"],["どの"],["よう"],["に"],["すべき"],["か"],["、"],["お前","おまえ"],["たち"],["で"],["策","さく"],["を"],["練って","ねって"],["くれ"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":21,"text":"アヒトフェルはアブサロムに言った。「お父上の側女たちのところにお入りになるのがよいでしょう。お父上は王宮を守らせるため側女たちを残しておられます。あなたがあえてお父上の憎悪の的となられたと全イスラエルが聞けば、あなたについている者はすべて、奮い立つでしょう。」","tok":[["アヒトフェル"],["は"],["アブサロム"],["に"],["言った","いった"],["。"],["「"],["お父上","おちちじょう"],["の"],["側女","そばめ"],["たち"],["の"],["ところ"],["に"],["お入り","おいり"],["に"],["なる"],["の"],["が"],["よいでしょう"],["。"],["お父上","おちちじょう"],["は"],["王宮","おうきゅう"],["を"],["守らせる","まもらせる"],["ため"],["側女","そばめ"],["たち"],["を"],["残して","のこして"],["おられます"],["。"],["あなた"],["が"],["あえて"],["お父上","おちちじょう"],["の"],["憎悪","ぞうお"],["の"],["的","まと"],["と"],["なられた"],["と"],["全","ぜん"],["イスラエル"],["が"],["聞けば","きけば"],["、"],["あなた"],["について"],["いる"],["者","もの"],["は"],["すべて"],["、"],["奮い立つでしょう","ふるいたつでしょう"],["。"],["」"]]},{"verse":22,"text":"アブサロムのために屋上に天幕が張られ、全イスラエルの注目の中で、アブサロムは父の側女たちのところに入った。","tok":[["アブサロム"],["の"],["ため"],["に"],["屋上","おくじょう"],["に"],["天幕","てんまく"],["が"],["張られ","はられ"],["、"],["全","ぜん"],["イスラエル"],["の"],["注目","ちゅうもく"],["の"],["中","なか"],["で"],["、"],["アブサロム"],["は"],["父","ちち"],["の"],["側女","そばめ"],["たち"],["の"],["ところ"],["に"],["入った","はいった"],["。"]]},{"verse":23,"text":"そのころ、アヒトフェルの提案は、神託のように受け取られていた。ダビデにとっても、アブサロムにとっても、アヒトフェルの提案はそのようなものであった。","tok":[["その"],["ころ"],["、"],["アヒトフェル"],["の"],["提案","ていあん"],["は"],["、"],["神託","しんたく"],["の"],["よう"],["に"],["受け取られて","うけとられて"],["いた"],["。"],["ダビデ"],["にとって"],["も"],["、"],["アブサロム"],["にとって"],["も"],["、"],["アヒトフェル"],["の"],["提案","ていあん"],["は"],["その"],["よう"],["な"],["もの"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"サウルが死んだ後のことである。ダビデはアマレク人を討ってツィクラグに帰り、二日過ごした。","tok":[["サウル"],["が"],["死んだ","しんだ"],["後","あと"],["の"],["こと"],["で"],["ある"],["。"],["ダビデ"],["は"],["アマレク"],["人","にん"],["を"],["討って","うって"],["ツィクラグ"],["に"],["帰り","かえり"],["、"],["二日","ふたか"],["過ごした","すごした"],["。"]]},{"verse":2,"text":"三日目に、サウルの陣営から一人の男がたどりついた。衣服は裂け、頭に土をかぶっていた。男はダビデの前に出ると、地にひれ伏して礼をした。","tok":[["三日目","みっかめ"],["に"],["、"],["サウル"],["の"],["陣営","じんえい"],["から"],["一人","ひとり"],["の"],["男","おとこ"],["が"],["たどりついた"],["。"],["衣服","いふく"],["は"],["裂け","さけ"],["、"],["頭","あたま"],["に"],["土","つち"],["を"],["かぶって"],["いた"],["。"],["男","おとこ"],["は"],["ダビデ"],["の"],["前","まえ"],["に"],["出る","でる"],["と"],["、"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["礼","れい"],["を"],["した"],["。"]]},{"verse":3,"text":"ダビデは尋ねた。「どこから来たのだ。」「イスラエルの陣営から逃れて参りました」と彼は答えた。","tok":[["ダビデ"],["は"],["尋ねた","たずねた"],["。"],["「"],["どこ"],["から"],["来た","きた"],["の"],["だ"],["。"],["」"],["「"],["イスラエル"],["の"],["陣営","じんえい"],["から"],["逃れて","のがれて"],["参りました","まいりました"],["」"],["と"],["彼","かれ"],["は"],["答えた","こたえた"],["。"]]},{"verse":4,"text":"「状況はどうか。話してくれ」とダビデは彼に言った。彼は言った。「兵士は戦場から逃げ去り、多くの兵士が倒れて死にました。サウル王と王子のヨナタンも亡くなられました。」","tok":[["「"],["状況","じょうきょう"],["は"],["どう"],["か"],["。"],["話して","はなして"],["くれ"],["」"],["と"],["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["兵士","へいし"],["は"],["戦場","せんじょう"],["から"],["逃げ去り","にげさり"],["、"],["多く","おおく"],["の"],["兵士","へいし"],["が"],["倒れて","たおれて"],["死にました","しにました"],["。"],["サウル"],["王","おう"],["と"],["王子","おうじ"],["の"],["ヨナタン"],["も"],["亡くなられました","なくなられました"],["。"],["」"]]},{"verse":5,"text":"ダビデは知らせをもたらしたこの若者に尋ねた。「二人の死をどうして知ったのか。」","tok":[["ダビデ"],["は"],["知らせ","しらせ"],["を"],["もたらした"],["この"],["若者","わかもの"],["に"],["尋ねた","たずねた"],["。"],["「"],["二人","ふたり"],["の"],["死","し"],["を"],["どう"],["して"],["知った","しった"],["の"],["か"],["。"],["」"]]},{"verse":6,"text":"この若者は答えた。「わたしはたまたまギルボア山におりました。そのとき、サウル王は槍にもたれかかっておられましたが、戦車と騎兵が王に迫っていました。","tok":[["この"],["若者","わかもの"],["は"],["答えた","こたえた"],["。"],["「"],["わたし"],["は"],["たまたま"],["ギルボア"],["山","やま"],["に"],["おりました"],["。"],["その"],["とき"],["、"],["サウル"],["王","おう"],["は"],["槍","やり"],["に"],["もたれかかって"],["おられました"],["が"],["、"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["が"],["王","おう"],["に"],["迫って","せまって"],["いました"],["。"]]},{"verse":7,"text":"王は振り返ってわたしを御覧になり、お呼びになりました。『はい』とお答えすると、","tok":[["王","おう"],["は"],["振り返って","ふりかえって"],["わたし"],["を"],["御覧","ごらん"],["に"],["なり"],["、"],["お呼び","および"],["に"],["なりました"],["。"],["『"],["はい"],["』"],["と"],["お答え","おこたえ"],["する"],["と"],["、"]]},{"verse":8,"text":"『お前は何者だ』とお尋ねになり、『アマレクの者です』とお答えすると、","tok":[["『"],["お前","おまえ"],["は"],["何者","なにもの"],["だ"],["』"],["と"],["お尋ね","おたずね"],["に"],["なり"],["、"],["『"],["アマレク"],["の"],["者","もの"],["です"],["』"],["と"],["お答え","おこたえ"],["する"],["と"],["、"]]},{"verse":9,"text":"『そばに来て、とどめを刺してくれ。痙攣が起こったが死にきれない』と言われました。","tok":[["『"],["そば"],["に"],["来て","きて"],["、"],["とどめ"],["を"],["刺して","さして"],["くれ"],["。"],["痙攣","けいれん"],["が"],["起こった","おこった"],["が"],["死に","しに"],["きれない"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":10,"text":"そこでおそばに行って、とどめを刺しました。倒れてしまわれ、もはや生き延びることはできまいと思ったからです。頭にかぶっておられた王冠と腕につけておられた腕輪を取って、御主人様に持って参りました。これでございます。」","tok":[["そこ"],["で"],["おそば"],["に"],["行って","いって"],["、"],["とどめ"],["を"],["刺しました","さしました"],["。"],["倒れて","たおれて"],["しまわれ"],["、"],["もはや"],["生き延びる","いきのびる"],["こと"],["は"],["できまい"],["と"],["思った","おもった"],["から"],["です"],["。"],["頭","あたま"],["に"],["かぶって"],["おられた"],["王冠","おうかん"],["と"],["腕","うで"],["に"],["つけて"],["おられた"],["腕輪","うでわ"],["を"],["取って","とって"],["、"],["御主人様","みうしさま"],["に"],["持って","もって"],["参りました","まいりました"],["。"],["これ"],["で"],["ございます"],["。"],["」"]]},{"verse":11,"text":"ダビデは自分の衣をつかんで引き裂いた。共にいた者は皆それに倣った。","tok":[["ダビデ"],["は"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["つかんで"],["引き裂いた","ひきさいた"],["。"],["共","とも"],["に"],["いた"],["者","もの"],["は"],["皆","みな"],["それ"],["に"],["倣った","ならった"],["。"]]},{"verse":12,"text":"彼らは、剣に倒れたサウルとその子ヨナタン、そして主の民とイスラエルの家を悼んで泣き、夕暮れまで断食した。","tok":[["彼","かれ"],["ら"],["は"],["、"],["剣","けん"],["に"],["倒れた","たおれた"],["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["、"],["そして"],["主","ぬし"],["の"],["民","たみ"],["と"],["イスラエル"],["の"],["家","いえ"],["を"],["悼んで","いたんで"],["泣き","なき"],["、"],["夕暮れ","ゆうぐれ"],["まで"],["断食","だんじき"],["した"],["。"]]},{"verse":13,"text":"ダビデは、知らせをもたらした若者に尋ねた。「お前はどこの出身か。」「わたしは寄留のアマレク人の子です」と彼は答えた。","tok":[["ダビデ"],["は"],["、"],["知らせ","しらせ"],["を"],["もたらした"],["若者","わかもの"],["に"],["尋ねた","たずねた"],["。"],["「"],["お前","おまえ"],["は"],["どこ"],["の"],["出身","しゅっしん"],["か"],["。"],["」"],["「"],["わたし"],["は"],["寄留","きりゅう"],["の"],["アマレク"],["人","にん"],["の"],["子","こ"],["です"],["」"],["と"],["彼","かれ"],["は"],["答えた","こたえた"],["。"]]},{"verse":14,"text":"ダビデは彼に言った。「主が油を注がれた方を、恐れもせず手にかけ、殺害するとは何事か。」","tok":[["ダビデ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["方","ほう"],["を"],["、"],["恐れ","おそれ"],["も"],["せず"],["手","て"],["に"],["かけ"],["、"],["殺害","さつがい"],["する"],["と"],["は"],["何事","なにごと"],["か"],["。"],["」"]]},{"verse":15,"text":"ダビデは従者の一人を呼び、「近寄って、この者を討て」と命じた。従者は彼を打ち殺した。","tok":[["ダビデ"],["は"],["従者","じゅうしゃ"],["の"],["一人","ひとり"],["を"],["呼び","よび"],["、"],["「"],["近寄って","ちかよって"],["、"],["この"],["者","もの"],["を"],["討て","うて"],["」"],["と"],["命じた","めいじた"],["。"],["従者","じゅうしゃ"],["は"],["彼","かれ"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":16,"text":"ダビデは言った。「お前の流した血はお前の頭に返る。お前自身の口が、『わたしは主が油を注がれた方を殺した』と証言したのだから。」","tok":[["ダビデ"],["は"],["言った","いった"],["。"],["「"],["お前","おまえ"],["の"],["流した","ながした"],["血","ち"],["は"],["お前","おまえ"],["の"],["頭","あたま"],["に"],["返る","かえる"],["。"],["お前","おまえ"],["自身","じしん"],["の"],["口","くち"],["が"],["、"],["『"],["わたし"],["は"],["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["方","ほう"],["を"],["殺した","ころした"],["』"],["と"],["証言","しょうげん"],["した"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":17,"text":"ダビデはサウルとその子ヨナタンを悼む歌を詠み、","tok":[["ダビデ"],["は"],["サウル"],["と"],["その"],["子","こ"],["ヨナタン"],["を"],["悼む","いたむ"],["歌","うた"],["を"],["詠み","よみ"],["、"]]},{"verse":18,"text":"「弓」と題して、ユダの人々に教えるように命じた。この詩は『ヤシャルの書』に収められている。","tok":[["「"],["弓","ゆみ"],["」"],["と"],["題して","だいして"],["、"],["ユダ"],["の"],["人々","ひとびと"],["に"],["教える","おしえる"],["よう"],["に"],["命じた","めいじた"],["。"],["この"],["詩","し"],["は"],["『"],["ヤシャル"],["の"],["書","しょ"],["』"],["に"],["収められて","おさめられて"],["いる"],["。"]]},{"verse":19,"text":"イスラエルよ、「麗しき者」はお前の高い丘の上で刺し殺された。ああ、勇士らは倒れた。","tok":[["イスラエル"],["よ"],["、"],["「"],["麗しき","うるわしき"],["者","もの"],["」"],["は"],["お前","おまえ"],["の"],["高い","たかい"],["丘","おか"],["の"],["上","うえ"],["で"],["刺し殺された","さしころされた"],["。"],["ああ"],["、"],["勇士","ゆうし"],["ら"],["は"],["倒れた","たおれた"],["。"]]},{"verse":20,"text":"ガトに告げるなアシュケロンの街々にこれを知らせるなペリシテの娘らが喜び祝い割礼なき者の娘らが喜び勇むことのないように。","tok":[["ガト"],["に"],["告げる","つげる"],["な"],["アシュケロン"],["の"],["街々","まちまち"],["に"],["これ"],["を"],["知らせるな","しらせるな"],["ペリシテ"],["の"],["娘","むすめ"],["ら"],["が"],["喜び祝い","よろこびいわい"],["割礼","かつれい"],["なき"],["者","もの"],["の"],["娘","むすめ"],["ら"],["が"],["喜び勇む","よろこびいさむ"],["こと"],["の"],["ない"],["よう"],["に"],["。"]]},{"verse":21,"text":"ギルボアの山々よ、いけにえを求めた野よお前たちの上には露も結ぶな、雨も降るな。勇士らの盾がそこに見捨てられサウルの盾が油も塗られずに見捨てられている。","tok":[["ギルボア"],["の"],["山々","やまやま"],["よ"],["、"],["いけにえ"],["を"],["求めた","もとめた"],["野","の"],["よ"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["は"],["露","ろ"],["も"],["結ぶ","むすぶ"],["な"],["、"],["雨","あめ"],["も"],["降る","ふる"],["な"],["。"],["勇士","ゆうし"],["ら"],["の"],["盾","たて"],["が"],["そこ"],["に"],["見捨てられ","みすてられ"],["サウル"],["の"],["盾","たて"],["が"],["油","あぶら"],["も"],["塗られず","ぬられず"],["に"],["見捨てられて","みすてられて"],["いる"],["。"]]},{"verse":22,"text":"刺し殺した者たちの血勇士らの脂をなめずにはヨナタンの弓は決して退かずサウルの剣がむなしく納められることもなかった。","tok":[["刺し殺した","さしころした"],["者","もの"],["たち"],["の"],["血","けつ"],["勇士","ゆうし"],["ら"],["の"],["脂","あぶら"],["を"],["なめず"],["に"],["は"],["ヨナタン"],["の"],["弓","ゆみ"],["は"],["決して","けっして"],["退かず","しりぞかず"],["サウル"],["の"],["剣","けん"],["が"],["むなしく"],["納められる","おさめられる"],["こと"],["も"],["なかった"],["。"]]},{"verse":23,"text":"サウルとヨナタン、愛され喜ばれた二人鷲よりも速く、獅子よりも雄々しかった。命ある時も死に臨んでも二人が離れることはなかった。","tok":[["サウル"],["と"],["ヨナタン"],["、"],["愛され","あいされ"],["喜ばれた","よろこばれた"],["二人","ふたり"],["鷲","わし"],["より"],["も"],["速く","はやく"],["、"],["獅子","しし"],["より"],["も"],["雄々しかった","おおしかった"],["。"],["命","いのち"],["ある"],["時","とき"],["も"],["死に","しに"],["臨んで","のぞんで"],["も"],["二人","ふたり"],["が"],["離れる","はなれる"],["こと"],["は"],["なかった"],["。"]]},{"verse":24,"text":"泣け、イスラエルの娘らよ、サウルのために。紅の衣をお前たちに着せお前たちの衣の上に金の飾りをおいたサウルのために。","tok":[["泣け","なけ"],["、"],["イスラエル"],["の"],["娘","むすめ"],["ら"],["よ"],["、"],["サウル"],["の"],["ため"],["に"],["。"],["紅","くれない"],["の"],["衣","ころも"],["を"],["お前","おまえ"],["たち"],["に"],["着せ","きせ"],["お前","おまえ"],["たち"],["の"],["衣","ころも"],["の"],["上","うえ"],["に"],["金","かね"],["の"],["飾り","かざり"],["を"],["おいた"],["サウル"],["の"],["ため"],["に"],["。"]]},{"verse":25,"text":"ああ、勇士らは戦いのさなかに倒れた。ヨナタンはイスラエルの高い丘で刺し殺された。","tok":[["ああ"],["、"],["勇士","ゆうし"],["ら"],["は"],["戦い","たたかい"],["の"],["さなか"],["に"],["倒れた","たおれた"],["。"],["ヨナタン"],["は"],["イスラエル"],["の"],["高い","たかい"],["丘","おか"],["で"],["刺し殺された","さしころされた"],["。"]]},{"verse":26,"text":"あなたを思ってわたしは悲しむ兄弟ヨナタンよ、まことの喜び女の愛にまさる驚くべきあなたの愛を。","tok":[["あなた"],["を"],["思って","おもって"],["わたし"],["は"],["悲しむ","かなしむ"],["兄弟","きょうだい"],["ヨナタン"],["よ"],["、"],["まこと"],["の"],["喜び","よろこび"],["女","おんな"],["の"],["愛","あい"],["に"],["まさる"],["驚くべき","おどろくべき"],["あなた"],["の"],["愛","あい"],["を"],["。"]]},{"verse":27,"text":"ああ、勇士らは倒れた。戦いの器は失われた。","tok":[["ああ"],["、"],["勇士","ゆうし"],["ら"],["は"],["倒れた","たおれた"],["。"],["戦い","たたかい"],["の"],["器","うつわ"],["は"],["失われた","うしなわれた"],["。"]]}]
[{"verse":1,"text":"イスラエルの全部族はヘブロンのダビデのもとに来てこう言った。「御覧ください。わたしたちはあなたの骨肉です。","tok":[["イスラエル"],["の"],["全部族","ぜんぶぞく"],["は"],["ヘブロン"],["の"],["ダビデ"],["の"],["もと"],["に"],["来て","きて"],["こう"],["言った","いった"],["。"],["「"],["御覧","ごらん"],["ください"],["。"],["わたしたち"],["は"],["あなた"],["の"],["骨肉","こつにく"],["です"],["。"]]},{"verse":2,"text":"これまで、サウルがわたしたちの王であったときにも、イスラエルの進退の指揮をとっておられたのはあなたでした。主はあなたに仰せになりました。『わが民イスラエルを牧するのはあなただ。あなたがイスラエルの指導者となる』と。」","tok":[["これ"],["まで"],["、"],["サウル"],["が"],["わたしたち"],["の"],["王","おう"],["で"],["あった"],["とき"],["に"],["も"],["、"],["イスラエル"],["の"],["進退","しんたい"],["の"],["指揮","しき"],["を"],["とって"],["おられた"],["の"],["は"],["あなた"],["でした"],["。"],["主","ぬし"],["は"],["あなた"],["に"],["仰せ","おおせ"],["に"],["なりました"],["。"],["『"],["わが"],["民","みん"],["イスラエル"],["を"],["牧","まき"],["する"],["の"],["は"],["あなた"],["だ"],["。"],["あなた"],["が"],["イスラエル"],["の"],["指導者","しどうしゃ"],["と"],["なる"],["』"],["と"],["。"],["」"]]},{"verse":3,"text":"イスラエルの長老たちは全員、ヘブロンの王のもとに来た。ダビデ王はヘブロンで主の御前に彼らと契約を結んだ。長老たちはダビデに油を注ぎ、イスラエルの王とした。","tok":[["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["は"],["全員","ぜんいん"],["、"],["ヘブロン"],["の"],["王","おう"],["の"],["もと"],["に"],["来た","きた"],["。"],["ダビデ"],["王","おう"],["は"],["ヘブロン"],["で"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"],["長老","ちょうろう"],["たち"],["は"],["ダビデ"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["。"]]},{"verse":4,"text":"ダビデは三十歳で王となり、四十年間王位にあった。","tok":[["ダビデ"],["は"],["三十歳","さんじゅうさい"],["で"],["王","おう"],["と"],["なり"],["、"],["四十","よんじゅう"],["年間","ねんかん"],["王位","おうい"],["に"],["あった"],["。"]]},{"verse":5,"text":"七年六か月の間ヘブロンでユダを、三十三年の間エルサレムでイスラエルとユダの全土を統治した。","tok":[["七","なな"],["年","ねん"],["六","ろく"],["か月","かげつ"],["の"],["間","あいだ"],["ヘブロン"],["で"],["ユダ"],["を"],["、"],["三十三","さんじゅうさん"],["年","ねん"],["の"],["間","あいだ"],["エルサレム"],["で"],["イスラエル"],["と"],["ユダ"],["の"],["全土","ぜんど"],["を"],["統治","とうち"],["した"],["。"]]},{"verse":6,"text":"王とその兵はエルサレムに向かい、その地の住民のエブス人を攻めようとした。エブス人はダビデが町に入ることはできないと思い、ダビデに言った。「お前はここに入れまい。目の見えない者、足の不自由な者でも、お前を追い払うことは容易だ。」","tok":[["王","おう"],["と"],["その"],["兵","へい"],["は"],["エルサレム"],["に"],["向かい","むかい"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["の"],["エブス"],["人","ひと"],["を"],["攻めよう","せめよう"],["と"],["した"],["。"],["エブス人","えぶすにん"],["は"],["ダビデ"],["が"],["町","まち"],["に"],["入る","はいる"],["こと"],["は"],["できない"],["と"],["思い","おもい"],["、"],["ダビデ"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["は"],["ここ"],["に"],["入れまい","いれまい"],["。"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["、"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["者","もの"],["で"],["も"],["、"],["お前","おまえ"],["を"],["追い払う","おいはらう"],["こと"],["は"],["容易","ようい"],["だ"],["。"],["」"]]},{"verse":7,"text":"しかしダビデはシオンの要害を陥れた。これがダビデの町である。","tok":[["しかし"],["ダビデ"],["は"],["シオン"],["の"],["要害","ようがい"],["を"],["陥れた","おとしいれた"],["。"],["これ"],["が"],["ダビデ"],["の"],["町","まち"],["で"],["ある"],["。"]]},{"verse":8,"text":"そのとき、ダビデは言った。「エブス人を討とうとする者は皆、水くみのトンネルを通って町に入り、ダビデの命を憎むという足の不自由な者、目の見えない者を討て。」このために、目や足の不自由な者は神殿に入ってはならない、と言われるようになった。","tok":[["その"],["とき"],["、"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["エブス"],["人","ひと"],["を"],["討とう","うとう"],["と"],["する"],["者","もの"],["は"],["皆","みな"],["、"],["水くみ","みずくみ"],["の"],["トンネル"],["を"],["通って","とおって"],["町","まち"],["に"],["入り","はいり"],["、"],["ダビデ"],["の"],["命","いのち"],["を"],["憎む","にくむ"],["と"],["いう"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["者","もの"],["、"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["を"],["討て","うて"],["。"],["」"],["この"],["ため"],["に"],["、"],["目","め"],["や"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["者","もの"],["は"],["神殿","しんでん"],["に"],["入って","はいって"],["は"],["ならない"],["、"],["と"],["言われる","いわれる"],["よう"],["に"],["なった"],["。"]]},{"verse":9,"text":"ダビデはこの要害に住み、それをダビデの町と呼び、ミロから内部まで、周囲に城壁を築いた。","tok":[["ダビデ"],["は"],["この"],["要害","ようがい"],["に"],["住み","すみ"],["、"],["それ"],["を"],["ダビデ"],["の"],["町","まち"],["と"],["呼び","よび"],["、"],["ミロ"],["から"],["内部","ないぶ"],["まで"],["、"],["周囲","しゅうい"],["に"],["城壁","じょうへき"],["を"],["築いた","きずいた"],["。"]]},{"verse":10,"text":"ダビデは次第に勢力を増し、万軍の神、主は彼と共におられた。","tok":[["ダビデ"],["は"],["次第","しだい"],["に"],["勢力","せいりょく"],["を"],["増し","まし"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["おられた"],["。"]]},{"verse":11,"text":"ティルスの王ヒラムはダビデのもとに使節を派遣し、レバノン杉、木工、石工を送って来た。彼らはダビデの王宮を建てた。","tok":[["ティルス"],["の"],["王","おう"],["ヒラム"],["は"],["ダビデ"],["の"],["もと"],["に"],["使節","しせつ"],["を"],["派遣","はけん"],["し"],["、"],["レバノン"],["杉","すぎ"],["、"],["木工","もっこう"],["、"],["石工","せっこう"],["を"],["送って","おくって"],["来た","きた"],["。"],["彼","かれ"],["ら"],["は"],["ダビデ"],["の"],["王宮","おうきゅう"],["を"],["建てた","たてた"],["。"]]},{"verse":12,"text":"ダビデは、主が彼をイスラエルの王として揺るぎないものとされ、主の民イスラエルのために彼の王権を高めてくださったことを悟った。","tok":[["ダビデ"],["は"],["、"],["主","ぬし"],["が"],["彼","かれ"],["を"],["イスラエル"],["の"],["王","おう"],["として"],["揺るぎない","ゆるぎない"],["もの"],["と"],["され"],["、"],["主","ぬし"],["の"],["民","みん"],["イスラエル"],["の"],["ため"],["に"],["彼","かれ"],["の"],["王権","おうけん"],["を"],["高めて","たかめて"],["くださった"],["こと"],["を"],["悟った","さとった"],["。"]]},{"verse":13,"text":"ダビデはヘブロンから移った後、エルサレムでも妻をめとり、側女を置いたので、息子や娘が更に生まれた。","tok":[["ダビデ"],["は"],["ヘブロン"],["から"],["移った","うつった"],["後","あと"],["、"],["エルサレム"],["で"],["も"],["妻","つま"],["を"],["めとり"],["、"],["側女","そばめ"],["を"],["置いた","おいた"],["ので"],["、"],["息子","むすこ"],["や"],["娘","むすめ"],["が"],["更に","さらに"],["生まれた","うまれた"],["。"]]},{"verse":14,"text":"エルサレムで生まれた子供たちの名は次のとおりである。シャムア、ショバブ、ナタン、ソロモン、","tok":[["エルサレム"],["で"],["生まれた","うまれた"],["子供","こども"],["たち"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["シャムア"],["、"],["ショバブ"],["、"],["ナタン"],["、"],["ソロモン"],["、"]]},{"verse":15,"text":"イブハル、エリシュア、ネフェグ、ヤフィア、","tok":[["イブハル"],["、"],["エリシュア"],["、"],["ネフェグ"],["、"],["ヤフィア"],["、"]]},{"verse":16,"text":"エリシャマ、エルヤダ、エリフェレト。","tok":[["エリシャマ"],["、"],["エルヤダ"],["、"],["エリフェレト"],["。"]]},{"verse":17,"text":"ペリシテ人は、ダビデが油を注がれてイスラエルの王になったことを聞いた。すべてのペリシテ人が、ダビデの命をねらって攻め上って来た。ダビデはこれを聞いて要害に下った。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["ダビデ"],["が"],["油","あぶら"],["を"],["注がれて","そそがれて"],["イスラエル"],["の"],["王","おう"],["に"],["なった"],["こと"],["を"],["聞いた","きいた"],["。"],["すべて"],["の"],["ペリシテ"],["人","にん"],["が"],["、"],["ダビデ"],["の"],["命","いのち"],["を"],["ねらって"],["攻め上って","せめのぼって"],["来た","きた"],["。"],["ダビデ"],["は"],["これ"],["を"],["聞いて","きいて"],["要害","ようがい"],["に"],["下った","くだった"],["。"]]},{"verse":18,"text":"やって来たペリシテ人はレファイムの谷に陣を広げた。","tok":[["やって"],["来た","きた"],["ペリシテ"],["人","にん"],["は"],["レファイム"],["の"],["谷","たに"],["に"],["陣","じん"],["を"],["広げた","ひろげた"],["。"]]},{"verse":19,"text":"ダビデは主に託宣を求めた。「ペリシテ人に向かって攻め上るべきでしょうか。彼らをこの手にお渡しくださるでしょうか。」主はダビデに答えられた。「攻め上れ。必ずペリシテ人をあなたの手に渡す。」","tok":[["ダビデ"],["は"],["主に","おもに"],["託宣","たくせん"],["を"],["求めた","もとめた"],["。"],["「"],["ペリシテ"],["人","にん"],["に"],["向かって","むかって"],["攻め上るべきでしょう","せめのぼるべきでしょう"],["か"],["。"],["彼","かれ"],["ら"],["を"],["この"],["手","て"],["に"],["お渡し","おわたし"],["くださるでしょう"],["か"],["。"],["」"],["主","ぬし"],["は"],["ダビデ"],["に"],["答えられた","こたえられた"],["。"],["「"],["攻め上れ","せめのぼれ"],["。"],["必ず","かならず"],["ペリシテ"],["人","にん"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["」"]]},{"verse":20,"text":"ダビデはバアル‧ペラツィムに攻め入り、彼らを討ち滅ぼして、こう言った。「主は敵をわたしの前で、水が堤防を破るように打ち破ってくださった。」その場所をバアル‧ペラツィム（破れ目の主）と呼ぶのは、このためである。","tok":[["ダビデ"],["は"],["バアル"],["‧"],["ペラツィム"],["に"],["攻め入り","せめいり"],["、"],["彼","かれ"],["ら"],["を"],["討ち滅ぼして","うちほろぼして"],["、"],["こう"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["敵","てき"],["を"],["わたし"],["の"],["前","まえ"],["で"],["、"],["水","みず"],["が"],["堤防","ていぼう"],["を"],["破る","やぶる"],["よう"],["に"],["打ち破って","うちやぶって"],["くださった"],["。"],["」"],["その"],["場所","ばしょ"],["を"],["バアル"],["‧"],["ペラツィム"],["（"],["破れ目","やぶれめ"],["の"],["主","ぬし"],["）"],["と"],["呼ぶ","よぶ"],["の"],["は"],["、"],["この"],["ため"],["で"],["ある"],["。"]]},{"verse":21,"text":"ペリシテ人が自分たちの偶像をそこに捨てて行ったので、ダビデとその兵はそれを運び去った。","tok":[["ペリシテ"],["人","にん"],["が"],["自分","じぶん"],["たち"],["の"],["偶像","ぐうぞう"],["を"],["そこ"],["に"],["捨てて","すてて"],["行った","いった"],["ので"],["、"],["ダビデ"],["と"],["その"],["兵","へい"],["は"],["それ"],["を"],["運び去った","はこびさった"],["。"]]},{"verse":22,"text":"ペリシテ人は再び攻め上り、レファイムの谷に陣を広げた。","tok":[["ペリシテ"],["人","にん"],["は"],["再び","ふたたび"],["攻め上り","せめのぼり"],["、"],["レファイム"],["の"],["谷","たに"],["に"],["陣","じん"],["を"],["広げた","ひろげた"],["。"]]},{"verse":23,"text":"ダビデが主に託宣を求めると、次のように答えられた。「攻め上らず、背後に回れ。バルサムの茂みの反対側から敵に向かえ。","tok":[["ダビデ"],["が"],["主に","おもに"],["託宣","たくせん"],["を"],["求める","もとめる"],["と"],["、"],["次","つぎ"],["の"],["よう"],["に"],["答えられた","こたえられた"],["。"],["「"],["攻め上らず","せめのぼらず"],["、"],["背後","はいご"],["に"],["回れ","まわれ"],["。"],["バルサム"],["の"],["茂み","しげみ"],["の"],["反対","はんたい"],["側","がわ"],["から"],["敵","てき"],["に"],["向かえ","むかえ"],["。"]]},{"verse":24,"text":"茂み越しに行軍の音を聞いたら、攻めかかれ。主がペリシテの陣営を討つために、お前に先んじて出陣されるのだ。」","tok":[["茂み越し","しげみごし"],["に"],["行軍","こうぐん"],["の"],["音","おと"],["を"],["聞いたら","きいたら"],["、"],["攻めかかれ","せめかかれ"],["。"],["主","ぬし"],["が"],["ペリシテ"],["の"],["陣営","じんえい"],["を"],["討つ","うつ"],["ため"],["に"],["、"],["お前","おまえ"],["に"],["先んじて","さきんじて"],["出陣","しゅつじん"],["される"],["の"],["だ"],["。"],["」"]]},{"verse":25,"text":"ダビデは主の命じられたとおりに行動し、ゲバからゲゼルに至るまで、ペリシテ人を討ち滅ぼした。","tok":[["ダビデ"],["は"],["主","ぬし"],["の"],["命じられた","めいじられた"],["とおり"],["に"],["行動","こうどう"],["し"],["、"],["ゲバ"],["から"],["ゲゼル"],["に"],["至る","いたる"],["まで"],["、"],["ペリシテ"],["人","にん"],["を"],["討ち滅ぼした","うちほろぼした"],["。"]]}]
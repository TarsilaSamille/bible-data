[{"verse":1,"text":"王は王宮に住むようになり、主は周囲の敵をすべて退けて彼に安らぎをお与えになった。","tok":[["王","おう"],["は"],["王宮","おうきゅう"],["に"],["住む","すむ"],["よう"],["に"],["なり"],["、"],["主","ぬし"],["は"],["周囲","しゅうい"],["の"],["敵","てき"],["を"],["すべて"],["退けて","しりぞけて"],["彼","かれ"],["に"],["安らぎ","やすらぎ"],["を"],["お与え","おあたえ"],["に"],["なった"],["。"]]},{"verse":2,"text":"王は預言者ナタンに言った。「見なさい。わたしはレバノン杉の家に住んでいるが、神の箱は天幕を張った中に置いたままだ。」","tok":[["王","おう"],["は"],["預言者","よげんしゃ"],["ナタン"],["に"],["言った","いった"],["。"],["「"],["見","み"],["なさい"],["。"],["わたし"],["は"],["レバノン"],["杉","すぎ"],["の"],["家","いえ"],["に"],["住んで","すんで"],["いる"],["が"],["、"],["神","かみ"],["の"],["箱","ばこ"],["は"],["天幕","てんまく"],["を"],["張った","はった"],["中","なか"],["に"],["置いた","おいた"],["まま"],["だ"],["。"],["」"]]},{"verse":3,"text":"ナタンは王に言った。「心にあることは何でも実行なさるとよいでしょう。主はあなたと共におられます。」","tok":[["ナタン"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["心","こころ"],["に"],["ある"],["こと"],["は"],["何","なん"],["で"],["も"],["実行","じっこう"],["なさる"],["と"],["よいでしょう"],["。"],["主","ぬし"],["は"],["あなた"],["と"],["共","とも"],["に"],["おられます"],["。"],["」"]]},{"verse":4,"text":"しかし、その夜、ナタンに臨んだ主の言葉は次のとおりであった。","tok":[["しかし"],["、"],["その"],["夜","よる"],["、"],["ナタン"],["に"],["臨んだ","のぞんだ"],["主","ぬし"],["の"],["言葉","ことば"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["あった"],["。"]]},{"verse":5,"text":"「わたしの僕ダビデのもとに行って告げよ。主はこう言われる。あなたがわたしのために住むべき家を建てようというのか。","tok":[["「"],["わたし"],["の"],["僕","ぼく"],["ダビデ"],["の"],["もと"],["に"],["行って","いって"],["告げ","つげ"],["よ"],["。"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["あなた"],["が"],["わたし"],["の"],["ため"],["に"],["住むべき","すむべき"],["家","いえ"],["を"],["建てよう","たてよう"],["と"],["いう"],["の"],["か"],["。"]]},{"verse":6,"text":"わたしはイスラエルの子らをエジプトから導き上った日から今日に至るまで、家に住まず、天幕、すなわち幕屋を住みかとして歩んできた。","tok":[["わたし"],["は"],["イスラエル"],["の"],["子","こ"],["ら"],["を"],["エジプト"],["から"],["導き","みちびき"],["上った","のぼった"],["日","ひ"],["から"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["家","いえ"],["に"],["住まず","すまず"],["、"],["天幕","てんまく"],["、"],["すなわち"],["幕屋","まくや"],["を"],["住みか","すみか"],["として"],["歩んで","あゆんで"],["きた"],["。"]]},{"verse":7,"text":"わたしはイスラエルの子らと常に共に歩んできたが、その間、
"いなく"],["なる"],["。"]]},{"verse":18,"text":"しかし、わたしは主によって喜びわが救いの神のゆえに踊る。","tok":[["しかし"],["、"],["わたし"],["は"],["主に","おもに"],["よって"],["喜び","よろこび"],["わが"],["救い","すくい"],["の"],["神","かみ"],["の"],["ゆえ"],["に"],["踊る","おどる"],["。"]]},{"verse":19,"text":"わたしの主なる神は、わが力。わたしの足を雌鹿のようにし聖なる高台を歩ませられる。指揮者によって、伴奏付き。","tok":[["わたし"],["の"],["主","ぬし"],["なる"],["神","かみ"],["は"],["、"],["わが"],["力","ちから"],["。"],["わたし"],["の"],["足","あし"],["を"],["雌鹿","めじか"],["の"],["よう"],["に"],["し"],["聖","せい"],["なる"],["高台","たかだい"],["を"],["歩ませられる","あゆませられる"],["。"],["指揮者","しきしゃ"],["によって"],["、"],["伴奏付き","ばんそうつき"],["。"]]}]
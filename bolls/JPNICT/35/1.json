[{"verse":1,"text":"預言者ハバククが、幻で示された託宣。","tok":[["預言者","よげんしゃ"],["ハバクク"],["が"],["、"],["幻","まぼろし"],["で"],["示された","しめされた"],["託宣","たくせん"],["。"]]},{"verse":2,"text":"主よ、わたしが助けを求めて叫んでいるのにいつまで、あなたは聞いてくださらないのか。わたしが、あなたに「不法」と訴えているのにあなたは助けてくださらない。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["が"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んで","さけんで"],["いる"],["のに"],["いつ"],["まで"],["、"],["あなた"],["は"],["聞いて","きいて"],["くださらない"],["の"],["か"],["。"],["わたし"],["が"],["、"],["あなた"],["に"],["「"],["不法","ふほう"],["」"],["と"],["訴えて","うったえて"],["いる"],["のに"],["あなた"],["は"],["助けて","たすけて"],["くださらない"],["。"]]},{"verse":3,"text":"どうして、あなたはわたしに災いを見させ労苦に目を留めさせられるのか。暴虐と不法がわたしの前にあり争いが起こり、いさかいが持ち上がっている。","tok":[["どう"],["して"],["、"],["あなた"],["は"],["わたし"],["に"],["災い","わざわい"],["を"],["見させ","みさせ"],["労苦","ろうく"],["に"],["目","め"],["を"],["留めさせられる","とめさせられる"],["の"],["か"],["。"],["暴虐","ぼうぎゃく"],["と"],["不法","ふほう"],["が"],["わたし"],["の"],["前","まえ"],["に"],["あり"],["争い","あらそい"],["が"],["起こり","おこり"],["、"],["いさかい"],["が"],["持ち上がって","もちあがって"],["いる"],["。"]]},{"verse":4,"text":"律法は無力となり正義はいつまでも示されない。神に逆らう者が正しい人を取り囲む。たとえ、正義が示されても曲げられてしまう。","tok":[["律法","りっぽう"],["は"],["無力","むりょく"],["と"],["なり"],["正義","せいぎ"],["は"],["いつ"],["まで"],["も"],["示されない","しめされない"],["。"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["が"],["正しい","ただしい"],["人","ひと"],["を"],["取り囲む","とりかこむ"],["。"],["たとえ"],["、"],["正義","せいぎ"],["が"],["示されて","しめされて"],["も"],["曲げられて","まげられて"],["しまう"],["。"]]},{"verse":5,"text":"諸国を見渡し、目を留め大いに驚くがよい。お前たちの時代に一つのことが行われる。それを告げられても、お前たちは信じまい。","tok":[["諸国","しょこく"],["を"],["見渡し","みわたし"],["、"],["目","め"],["を"],["留め","とめ"],["大いに","おおいに"],["驚く","おどろく"],["が"],["よい"],["。"],["お前","おまえ"],["たち"],["の"],["時代","じだい"],["に"],["一","ひと"],["つ"],["の"],["こと"],["が"],["行われる","おこなわれる"],["。"],["それ"],["を"],["告げられて","つげられて"],["も"],["、"],["お前","おまえ"],["たち"],["は"],["信じまい","しんじまい"],["。"]]},{"verse":6,"text":"見よ、わたしはカルデア人を起こす。それは冷酷で剽悍な国民。地上の広い領域に軍を進め自分のものでない領土を占領する。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["カルデア"],["人","にん"],["を"],["起こす","おこす"],["。"],["それ"],["は"],["冷酷","れいこく"],["で"],["剽悍","ひょうかん"],["な"],["国民","こくみん"],["。"],["地上","ちじょう"],["の"],["広い","ひろい"],["領域","りょういき"],["に"],["軍","ぐん"],["を"],["進め","すすめ"],["自分","じぶん"],["の"],["もの"],["で"],["ない"],["領土","りょうど"],["を"],["占領","せんりょう"],["する"],["。"]]},{"verse":7,"text":"彼らは恐ろしく、すさまじい。彼らから、裁きと支配が出る。","tok":[["彼","かれ"],["ら"],["は"],["恐ろしく","おそろしく"],["、"],["すさまじい"],["。"],["彼","かれ"],["ら"],["から"],["、"],["裁き","さばき"],["と"],["支配","しはい"],["が"],["出る","でる"],["。"]]},{"verse":8,"text":"彼らの馬は豹よりも速く夕暮れの狼よりも素早くその騎兵は跳びはねる。騎兵は遠くから来て獲物に襲いかかる鷲のように飛ぶ。","tok":[["彼","かれ"],["ら"],["の"],["馬","うま"],["は"],["豹","ひょう"],["より"],["も"],["速く","はやく"],["夕暮れ","ゆうぐれ"],["の"],["狼","おおかみ"],["より"],["も"],["素早く","すばやく"],["その"],["騎兵","きへい"],["は"],["跳びはねる","とびはねる"],["。"],["騎兵","きへい"],["は"],["遠く","とおく"],["から"],["来て","きて"],["獲物","えもの"],["に"],["襲いかかる","おそいかかる"],["鷲","わし"],["の"],["よう"],["に"],["飛ぶ","とぶ"],["。"]]},{"verse":9,"text":"彼らは来て、皆、暴虐を行う。どの顔も前方に向き砂を集めるようにとりこを集める。","tok":[["彼","かれ"],["ら"],["は"],["来て","きて"],["、"],["皆","みな"],["、"],["暴虐","ぼうぎゃく"],["を"],["行う","おこなう"],["。"],["どの"],["顔","かお"],["も"],["前方","ぜんぽう"],["に"],["向き","むき"],["砂","すな"],["を"],["集める","あつめる"],["よう"],["に"],["とりこ"],["を"],["集める","あつめる"],["。"]]},{"verse":10,"text":"彼らは王たちを嘲り支配者たちを嘲笑う。どんな砦をも嘲笑って土を積み上げ、それを攻め取る。","tok":[["彼","かれ"],["ら"],["は"],["王","おう"],["たち"],["を"],["嘲り","あざけり"],["支配者","しはいしゃ"],["たち"],["を"],["嘲笑う","あざけわらう"],["。"],["どんな"],["砦","とりで"],["を"],["も"],["嘲笑って","あざけわらって"],["土","つち"],["を"],["積み上げ","つみあげ"],["、"],["それ"],["を"],["攻め取る","せめとる"],["。"]]},{"verse":11,"text":"彼らは風のように来て、過ぎ去る。しかし、彼らは罪に定められる。自分の力を神としたからだ。","tok":[["彼","かれ"],["ら"],["は"],["風","かぜ"],["の"],["よう"],["に"],["来て","きて"],["、"],["過ぎ去る","すぎさる"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["罪","つみ"],["に"],["定められる","さだめられる"],["。"],["自分","じぶん"],["の"],["力","ちから"],["を"],["神","かみ"],["と"],["した"],["から"],["だ"],["。"]]},{"verse":12,"text":"主よ、あなたは永遠の昔からわが神、わが聖なる方ではありませんか。我々は死ぬことはありません。主よ、あなたは我々を裁くために彼らを備えられた。岩なる神よ、あなたは我々を懲らしめるため彼らを立てられた。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["永遠","えいえん"],["の"],["昔","むかし"],["から"],["わが"],["神","かみ"],["、"],["わが"],["聖","せい"],["なる"],["方","かた"],["で"],["は"],["ありません"],["か"],["。"],["我々","われわれ"],["は"],["死ぬ","しぬ"],["こと"],["は"],["ありません"],["。"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["我々","われわれ"],["を"],["裁く","さばく"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["備えられた","そなえられた"],["。"],["岩","いわ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["我々","われわれ"],["を"],["懲らしめる","こらしめる"],["ため"],["彼","かれ"],["ら"],["を"],["立てられた","たてられた"],["。"]]},{"verse":13,"text":"あなたの目は悪を見るにはあまりに清い。人の労苦に目を留めながら捨てて置かれることはない。それなのになぜ、欺く者に目を留めながら黙っておられるのですか神に逆らう者が、自分より正しい者を呑み込んでいるのに。","tok":[["あなた"],["の"],["目","め"],["は"],["悪","あく"],["を"],["見る","みる"],["に"],["は"],["あまり"],["に"],["清い","きよい"],["。"],["人","ひと"],["の"],["労苦","ろうく"],["に"],["目","め"],["を"],["留め","とめ"],["ながら"],["捨てて","すてて"],["置かれる","おかれる"],["こと"],["は"],["ない"],["。"],["それ"],["な"],["のに"],["なぜ"],["、"],["欺く","あざむく"],["者","もの"],["に"],["目","め"],["を"],["留め","とめ"],["ながら"],["黙って","だまって"],["おられる"],["の"],["です"],["か"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["が"],["、"],["自分","じぶん"],["より"],["正しい","ただしい"],["者","もの"],["を"],["呑み込んで","のみこんで"],["いる"],["のに"],["。"]]},{"verse":14,"text":"あなたは人間を海の魚のように治める者もない、這うもののようにされました。","tok":[["あなた"],["は"],["人間","にんげん"],["を"],["海","うみ"],["の"],["魚","さかな"],["の"],["よう"],["に"],["治める","おさめる"],["者","もの"],["も"],["ない"],["、"],["這う","はう"],["もの"],["の"],["よう"],["に"],["されました"],["。"]]},{"verse":15,"text":"彼らはすべての人を鉤にかけて釣り上げ網に入れて引き寄せ、投網を打って集める。こうして、彼らは喜び躍っています。","tok":[["彼","かれ"],["ら"],["は"],["すべて"],["の"],["人","ひと"],["を"],["鉤","はり"],["に"],["かけて"],["釣り上げ","つりあげ"],["網","もう"],["に"],["入れて","いれて"],["引き寄せ","ひきよせ"],["、"],["投網","なげあみ"],["を"],["打って","うって"],["集める","あつめる"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["喜び","よろこび"],["躍って","おどって"],["います"],["。"]]},{"verse":16,"text":"それゆえ、彼らはその網にいけにえをささげ投網に向かって香をたいています。これを使って、彼らは豊かな分け前を得食物に潤うからです。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["は"],["その"],["網","あみ"],["に"],["いけにえ"],["を"],["ささげ"],["投網","なげあみ"],["に"],["向かって","むかって"],["香","こう"],["を"],["たいて"],["います"],["。"],["これ"],["を"],["使って","つかって"],["、"],["彼","かれ"],["ら"],["は"],["豊か","ゆたか"]
[{"verse":1,"text":"わたしは歩哨の部署につき砦の上に立って見張り神がわたしに何を語りわたしの訴えに何と答えられるかを見よう。","tok":[["わたし"],["は"],["歩哨","ほしょう"],["の"],["部署","ぶしょ"],["に"],["つき"],["砦","とりで"],["の"],["上","うえ"],["に"],["立って","たって"],["見張り","みはり"],["神","かみ"],["が"],["わたし"],["に"],["何","なん"],["を"],["語り","かたり"],["わたし"],["の"],["訴え","うったえ"],["に"],["何","なん"],["と"],["答えられる","こたえられる"],["か"],["を"],["見よう","みよう"],["。"]]},{"verse":2,"text":"主はわたしに答えて、言われた。「幻を書き記せ。走りながらでも読めるように板の上にはっきりと記せ。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["答えて","こたえて"],["、"],["言われた","いわれた"],["。"],["「"],["幻","まぼろし"],["を"],["書き記せ","かきしるせ"],["。"],["走り","はしり"],["ながら"],["で"],["も"],["読める","よめる"],["よう"],["に"],["板","いた"],["の"],["上","うえ"],["に"],["はっきり"],["と"],["記せ","しるせ"],["。"]]},{"verse":3,"text":"定められた時のためにもうひとつの幻があるからだ。それは終わりの時に向かって急ぐ。人を欺くことはない。たとえ、遅くなっても、待っておれ。それは必ず来る、遅れることはない。","tok":[["定められた","さだめられた"],["時","とき"],["の"],["ため"],["に"],["もう"],["ひと"],["つ"],["の"],["幻","まぼろし"],["が"],["ある"],["から"],["だ"],["。"],["それ"],["は"],["終わり","おわり"],["の"],["時","とき"],["に"],["向かって","むかって"],["急ぐ","いそぐ"],["。"],["人","ひと"],["を"],["欺く","あざむく"],["こと"],["は"],["ない"],["。"],["たとえ"],["、"],["遅く","おそく"],["なって"],["も"],["、"],["待って","まって"],["おれ"],["。"],["それ"],["は"],["必ず","かならず"],["来る","くる"],["、"],["遅れる","おくれる"],["こと"],["は"],["ない"],["。"]]},{"verse":4,"text":"見よ、高慢な者を。彼の心は正しくありえない。しかし、神に従う人は信仰によって生きる。」","tok":[["見よ","みよ"],["、"],["高慢","こうまん"],["な"],["者","もの"],["を"],["。"],["彼","かれ"],["の"],["心","こころ"],["は"],["正しく","ただしく"],["あり"],["えない"],["。"],["しかし"],["、"],["神","かみ"],["に"],["従う","したがう"],["人","ひと"],["は"],["信仰","しんこう"],["によって"],["生きる","いきる"],["。"],["」"]]},{"verse":5,"text":"確かに富は人を欺く。高ぶる者は目指すところに達しない。彼は陰府のように喉を広げ死のように飽くことがない。彼はすべての国を自分のもとに集めすべての民を自分のもとに引き寄せる。","tok":[["確か","たしか"],["に"],["富","とみ"],["は"],["人","ひと"],["を"],["欺く","あざむく"],["。"],["高ぶる","たかぶる"],["者","もの"],["は"],["目指す","めざす"],["ところ"],["に"],["達しない","たっしない"],["。"],["彼","かれ"],["は"],["陰府","よみ"],["の"],["よう"],["に"],["喉","のど"],["を"],["広げ","ひろげ"],["死","し"],["の"],["よう"],["に"],["飽く","あく"],["こと"],["が"],["ない"],["。"],["彼","かれ"],["は"],["すべて"],["の"],["国","くに"],["を"],["自分","じぶん"],["の"],["もと"],["に"],["集め","あつめ"],["すべて"],["の"],["民","たみ"],["を"],["自分","じぶん"],["の"],["もと"],["に"],["引き寄せる","ひきよせる"],["。"]]},{"verse":6,"text":"この人々は皆彼に対して嘲りのことわざを歌い謎の風刺を浴びせる。災いだ、自分のものでないものを増し加える者は。いつまで続けるのか重い負債を自分の上に積む者よ。","tok":[["この"],["人々","ひとびと"],["は"],["皆","みな"],["彼","かれ"],["に対して","にたいして"],["嘲り","あざけり"],["の"],["ことわざ"],["を"],["歌い","うたい"],["謎","なぞ"],["の"],["風刺","ふうし"],["を"],["浴びせる","あびせる"],["。"],["災い","わざわい"],["だ"],["、"],["自分","じぶん"],["の"],["もの"],["で"],["ない"],["もの"],["を"],["増し加える","ましくわえる"],["者","もの"],["は"],["。"],["いつ"],["まで"],["続ける","つづける"],["の"],["か"],["重い","おもい"],["負債","ふさい"],["を"],["自分","じぶん"],["の"],["上","うえ"],["に"],["積む","つむ"],["者","もの"],["よ"],["。"]]},{"verse":7,"text":"突然、お前の債権者が立ち上がり恐れさせる者が目覚めお前は彼らの獲物にされないだろうか。","tok":[["突然","とつぜん"],["、"],["お前","おまえ"],["の"],["債権者","さいけんしゃ"],["が"],["立ち上がり","たちあがり"],["恐れさせる","おそれさせる"],["者","もの"],["が"],["目覚め","めざめ"],["お前","おまえ"],["は"],["彼","かれ"],["ら"],["の"],["獲物","えもの"],["に"],["されないだろう"],["か"],["。"]]},{"verse":8,"text":"まことに、お前は多くの国々を略奪したので諸国の民の残りの者すべてがお前を略奪する。お前が人々の血を流し、国中で不法を町とそのすべての住民に対して行ったからだ。","tok":[["まこと"],["に"],["、"],["お前","おまえ"],["は"],["多く","おおく"],["の"],["国々","くにぐに"],["を"],["略奪","りゃくだつ"],["した"],["ので"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["すべて"],["が"],["お前","おまえ"],["を"],["略奪","りゃくだつ"],["する"],["。"],["お前","おまえ"],["が"],["人々","ひとびと"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["国中","くにちゅう"],["で"],["不法","ふほう"],["を"],["町","まち"],["と"],["その"],["すべて"],["の"],["住民","じゅうみん"],["に対して","にたいして"],["行った","いった"],["から"],["だ"],["。"]]},{"verse":9,"text":"災いだ、自分の家に災いを招くまで不当な利益をむさぼり災いの手から逃れるために高い所に巣を構える者よ。","tok":[["災い","わざわい"],["だ"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["災い","わざわい"],["を"],["招く","まねく"],["まで"],["不当","ふとう"],["な"],["利益","りえき"],["を"],["むさぼり"],["災い","わざわい"],["の"],["手","て"],["から"],["逃れる","のがれる"],["ため"],["に"],["高い","たかい"],["所","ところ"],["に"],["巣","す"],["を"],["構える","かまえる"],["者","もの"],["よ"],["。"]]},{"verse":10,"text":"お前は、自分の家に対して恥ずべきことを謀り多くの民の滅びを招き、自分をも傷つけた。","tok":[["お前","おまえ"],["は"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に対して","にたいして"],["恥ずべき","はずべき"],["こと"],["を"],["謀り","はかり"],["多く","おおく"],["の"],["民","たみ"],["の"],["滅び","ほろび"],["を"],["招き","まねき"],["、"],["自分","じぶん"],["を"],["も"],["傷つけた","きずつけた"],["。"]]},{"verse":11,"text":"まことに石は石垣から叫び梁は建物からそれに答えている。","tok":[["まこと"],["に"],["石","いし"],["は"],["石垣","いしがき"],["から"],["叫び","さけび"],["梁","はり"],["は"],["建物","たてもの"],["から"],["それ"],["に"],["答えて","こたえて"],["いる"],["。"]]},{"verse":12,"text":"災いだ、流血によって都を築き不正によって町を建てる者よ。","tok":[["災い","わざわい"],["だ"],["、"],["流血","りゅうけつ"],["によって"],["都","と"],["を"],["築き","きずき"],["不正","ふせい"],["によって"],["町","まち"],["を"],["建てる","たてる"],["者","もの"],["よ"],["。"]]},{"verse":13,"text":"見よ、これは万軍の主から出たことではないか。諸国の民は力を費やしても火で焼かれるのみ。諸民族はむなしい業のために疲れ果てる。","tok":[["見よ","みよ"],["、"],["これ"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["から"],["出た","でた"],["こと"],["で"],["は"],["ない"],["か"],["。"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["力","ちから"],["を"],["費やして","ついやして"],["も"],["火","ひ"],["で"],["焼かれる","やかれる"],["のみ"],["。"],["諸","しょ"],["民族","みんぞく"],["は"],["むなしい"],["業","ごう"],["の"],["ため"],["に"],["疲れ","つかれ"],["果てる","はてる"],["。"]]},{"verse":14,"text":"水が海を覆うように大地は主の栄光の知識で満たされる。","tok":[["水","みず"],["が"],["海","うみ"],["を"],["覆う","おおう"],["よう"],["に"],["大地","だいち"],["は"],["主","ぬし"],["の"],["栄光","えいこう"],["の"],["知識","ちしき"],["で"],["満たされる","みたされる"],["。"]]},{"verse":15,"text":"災いだ自分の隣人に怒りの熱を加えた酒を飲ませ酔わせて、その裸を見ようとする者は。","tok":[["災い","わざわい"],["だ"],["自分","じぶん"],["の"],["隣人","りんじん"],["に"],["怒り","いかり"],["の"],["熱","ねつ"],["を"],["加えた","くわえた"],["酒","さけ"],["を"],["飲ませ","のませ"],["酔わせて","よわせて"],["、"],["その"],["裸","はだか"],["を"],["見よう","みよう"],["と"],["する"],["者","もの"],["は"],["。"]]},{"verse":16,"text":"お前は栄光よりも恥を飽きるほど受ける。酔え、お前も隠し所を見られる。お前のもとに、主の右の手の杯と恥辱がお前の栄光の代わりに回ってくる。","tok":[["お前","おまえ"],["は"],["栄光","えいこう"],["より"],["も"],["恥","はじ"],["を"],["飽きる","あきる"],["ほど"],["受ける","うける"],["。"],["酔え","よえ"],["、"],["お前","おまえ"],["も"],["隠し所","かくしどころ"],["を"],["見られる","みられる"],["。"],["お前","おまえ"],["の"],["もと"],["に"],["、"],["主","ぬし"],["の"],["右","みぎ"],["の"],["手","て"],["の"],["杯","さかずき"],["と"],["恥辱","ちじょく"],["が"],["お前","おまえ"],["の"],["栄光","えいこう"],["の"],["代わり","かわり"],["に"],["回って","まわって"],["くる"],["。"]]},{"verse":17,"text":"レバノンに加えられた不法がお前を覆い獣も絶えて、お前を恐れさせる。お前が人々の血を流し、国中で不法を町とそのすべての住民に対して行ったからだ。","tok":[["レバノン"],["に"],["加えられた","くわえられた"],["不法","ふほう"],["が"],["お前","おまえ"],["を"],["覆い","おおい"],["獣","けもの"],["も"],["絶えて","たえて"],["、"],["お前","おまえ"],["を"],["恐れさせる","おそれさせる"],["。"],["お前","おまえ"],["が"],["人々","ひとびと"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["国中","くにちゅう"],["で"],["不法","ふほう"],["を"],["町","まち"],["と"],["その"],["すべて"],["の"],["住民","じゅうみん"],["に対して","にたいして"],["行った","いった"],["から"],["だ"],["。"]]},{"verse":18,"text":"彫刻師の刻んだ彫像や鋳像また、偽りを教える者が何の役に立つのか。口の利けない偶像を造り造った者がそれに依り頼んでも何の役に立つのか。","tok":[["彫刻師","ちょうこくし"],["の"],["刻んだ","きざんだ"],["彫像","ちょうぞう"],["や"],["鋳像","ちゅうぞう"],["また"],["、"],["偽り","いつわり"],["を"],["教える","おしえる"],["者","もの"],["が"],["何","なん"],["の"],["役","やく"],["に"],["立つ","たつ"],["の"],["か"],["。"],["口","くち"],["の"],["利けない","きけない"],["偶像","ぐうぞう"],["を"],["造り","つくり"],["造った","つくった"],["者","もの"],["が"],["それ"],["に"],["依り頼んで","よりたのんで"],["も"],["何","なん"],["の"],["役","やく"],["に"],["立つ","たつ"],["の"],["か"],["。"]]},{"verse":19,"text":"災いだ、木に向かって「目を覚ませ」と言い物言わぬ石に向かって「起きよ」と言う者は。それが託宣を下しうるのか。見よ、これは金と銀をかぶせたものでその中に命の息は全くない。","tok":[["災い","わざわい"],["だ"],["、"],["木","き"],["に"],["向かって","むかって"],["「"],["目","め"],["を"],["覚ませ","さませ"],["」"],["と"],["言い","いい"],["物","もの"],["言わぬ","いわぬ"],["石","いし"],["に"],["向かって","むかって"],["「"],["起き","おき"],["よ"],["」"],["と"],["言う","いう"],["者","もの"],["は"],["。"],["それ"],["が"],["託宣","たくせん"],["を"],["下し","くだし"],["うる"],["の"],["か"],["。"],["見よ","みよ"],["、"],["これ"],["は"],["金","きん"],["と"],["銀","ぎん"],["を"],["かぶせた"],["もの"],["で"],["その"],["中","なか"],["に"],["命","いのち"],["の"],["息","いき"],["は"],["全く","まったく"],["ない"],["。"]]},{"verse":20,"text":"しかし、主はその聖なる神殿におられる。全地よ、御前に沈黙せよ。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["その"],["聖","せい"],["なる"],["神殿","しんでん"],["に"],["おられる"],["。"],["全地","ぜんち"],["よ"],["、"],["御前","ごぜん"],["に"],["沈黙","ちんもく"],["せよ"],["。"]]}]
[{"verse":1,"text":"「さあ、我々は主のもとに帰ろう。主は我々を引き裂かれたが、いやし我々を打たれたが、傷を包んでくださる。","tok":[["「"],["さあ"],["、"],["我々","われわれ"],["は"],["主","ぬし"],["の"],["もと"],["に"],["帰ろう","かえろう"],["。"],["主","ぬし"],["は"],["我々","われわれ"],["を"],["引き裂かれた","ひきさかれた"],["が"],["、"],["いやし"],["我々","われわれ"],["を"],["打たれた","うたれた"],["が"],["、"],["傷","きず"],["を"],["包んで","つつんで"],["くださる"],["。"]]},{"verse":2,"text":"二日の後、主は我々を生かし三日目に、立ち上がらせてくださる。我々は御前に生きる。","tok":[["二日","ふたか"],["の"],["後","あと"],["、"],["主","ぬし"],["は"],["我々","われわれ"],["を"],["生かし","いかし"],["三日目","みっかめ"],["に"],["、"],["立ち上がらせて","たちあがらせて"],["くださる"],["。"],["我々","われわれ"],["は"],["御前","ごぜん"],["に"],["生きる","いきる"],["。"]]},{"verse":3,"text":"我々は主を知ろう。主を知ることを追い求めよう。主は曙の光のように必ず現れ降り注ぐ雨のように大地を潤す春雨のように我々を訪れてくださる。」","tok":[["我々","われわれ"],["は"],["主","ぬし"],["を"],["知ろう","しろう"],["。"],["主","ぬし"],["を"],["知る","しる"],["こと"],["を"],["追い求めよう","おいもとめよう"],["。"],["主","ぬし"],["は"],["曙","あけぼの"],["の"],["光","ひかり"],["の"],["よう"],["に"],["必ず","かならず"],["現れ","あらわれ"],["降り注ぐ","ふりそそぐ"],["雨","あめ"],["の"],["よう"],["に"],["大地","だいち"],["を"],["潤す","うるおす"],["春雨","はるさめ"],["の"],["よう"],["に"],["我々","われわれ"],["を"],["訪れて","おとずれて"],["くださる"],["。"],["」"]]},{"verse":4,"text":"エフライムよわたしはお前をどうしたらよいのか。ユダよ、お前をどうしたらよいのか。お前たちの愛は朝の霧すぐに消えうせる露のようだ。","tok":[["エフライム"],["よ"],["わたし"],["は"],["お前","おまえ"],["を"],["どう"],["したら"],["よい"],["の"],["か"],["。"],["ユダ"],["よ"],["、"],["お前","おまえ"],["を"],["どう"],["したら"],["よい"],["の"],["か"],["。"],["お前","おまえ"],["たち"],["の"],["愛","あい"],["は"],["朝","あさ"],["の"],["霧","きり"],["すぐ"],["に"],["消えうせる","きえうせる"],["露","ろ"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"それゆえ、わたしは彼らを預言者たちによって切り倒しわたしの口の言葉をもって滅ぼす。わたしの行う裁きは光のように現れる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["預言者","よげんしゃ"],["たち"],["によって"],["切り倒し","きりたおし"],["わたし"],["の"],["口","くち"],["の"],["言葉","ことば"],["を"],["もって"],["滅ぼす","ほろぼす"],["。"],["わたし"],["の"],["行う","おこなう"],["裁き","さばき"],["は"],["光","ひかり"],["の"],["よう"],["に"],["現れる","あらわれる"],["。"]]},{"verse":6,"text":"わたしが喜ぶのは愛であっていけにえではなく神を知ることであって焼き尽くす献げ物ではない。","tok":[["わたし"],["が"],["喜ぶ","よろこぶ"],["の"],["は"],["愛","あい"],["で"],["あって"],["いけにえ"],["で"],["は"],["なく"],["神","かみ"],["を"],["知る","しる"],["こと"],["で"],["あって"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["で"],["は"],["ない"],["。"]]},{"verse":7,"text":"彼らはアダムで契約を破りそこでわたしを裏切った。","tok":[["彼","かれ"],["ら"],["は"],["アダム"],["で"],["契約","けいやく"],["を"],["破り","やぶり"],["そこ"],["で"],["わたし"],["を"],["裏切った","うらぎった"],["。"]]},{"verse":8,"text":"ギレアドは悪を行う者どもの住みか流血の罪を犯した者の足跡がしるされている。","tok":[["ギレアド"],["は"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["ども"],["の"],["住みか","すみか"],["流血","りゅうけつ"],["の"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["の"],["足跡","あしあと"],["が"],["しるされて"],["いる"],["。"]]},{"verse":9,"text":"祭司の一団は待ち伏せる強盗のようにシケムへの道で人を殺す。なんという悪事を彼らは行うことか。","tok":[["祭司","さいし"],["の"],["一団","いちだん"],["は"],["待ち伏せる","まちぶせる"],["強盗","ごうとう"],["の"],["よう"],["に"],["シケム"],["へ"],["の"],["道","みち"],["で"],["人","ひと"],["を"],["殺す","ころす"],["。"],["なん"],["と"],["いう"],["悪事","あくじ"],["を"],["彼","かれ"],["ら"],["は"],["行う","おこなう"],["こと"],["か"],["。"]]},{"verse":10,"text":"イスラエルの家に、恐るべきことをわたしは見た。そこでエフライムは姦淫をしイスラエルは自分を汚した。","tok":[["イスラエル"],["の"],["家","いえ"],["に"],["、"],["恐るべき","おそるべき"],["こと"],["を"],["わたし"],["は"],["見た","みた"],["。"],["そこ"],["で"],["エフライム"],["は"],["姦淫","かんいん"],["を"],["し"],["イスラエル"],["は"],["自分","じぶん"],["を"],["汚した","よごした"],["。"]]},{"verse":11,"text":"ユダよ、お前にも刈り取られる時が定められている。わたしが民を回復させようとし","tok":[["ユダ"],["よ"],["、"],["お前","おまえ"],["に"],["も"],["刈り取られる","かりとられる"],["時","とき"],["が"],["定められて","さだめられて"],["いる"],["。"],["わたし"],["が"],["民","たみ"],["を"],["回復","かいふく"],["させよう"],["と"],["し"]]}]
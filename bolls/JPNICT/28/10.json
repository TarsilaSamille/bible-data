[{"verse":1,"text":"イスラエルは伸びほうだいのぶどうの木。実もそれに等しい。実を結ぶにつれて、祭壇を増し国が豊かになるにつれて、聖なる柱を飾り立てた。","tok":[["イスラエル"],["は"],["伸び","のび"],["ほうだい"],["の"],["ぶどう"],["の"],["木","き"],["。"],["実","じつ"],["も"],["それ"],["に"],["等しい","ひとしい"],["。"],["実","じつ"],["を"],["結ぶ","むすぶ"],["に"],["つれて"],["、"],["祭壇","さいだん"],["を"],["増し","まし"],["国","くに"],["が"],["豊か","ゆたか"],["に"],["なる"],["に"],["つれて"],["、"],["聖","せい"],["なる"],["柱","はしら"],["を"],["飾り立てた","かざりたてた"],["。"]]},{"verse":2,"text":"彼らの偽る心は、今や罰せられる。主は彼らの祭壇を打ち砕き聖なる柱を倒される。","tok":[["彼","かれ"],["ら"],["の"],["偽る","いつわる"],["心","こころ"],["は"],["、"],["今","いま"],["や"],["罰せられる","ばっせられる"],["。"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["を"],["打ち砕き","うちくだき"],["聖","せい"],["なる"],["柱","はしら"],["を"],["倒される","たおされる"],["。"]]},{"verse":3,"text":"今、彼らは言う。「我々には王がいなくなった。主を畏れ敬わなかったからだ。だが王がいたとしても、何になろうか」と。","tok":[["今","いま"],["、"],["彼","かれ"],["ら"],["は"],["言う","ゆう"],["。"],["「"],["我々","われわれ"],["に"],["は"],["王","おう"],["が"],["いなく"],["なった"],["。"],["主","ぬし"],["を"],["畏れ","おそれ"],["敬わなかった","うやまわなかった"],["から"],["だ"],["。"],["だ"],["が"],["王","おう"],["が"],["いた"],["として"],["も"],["、"],["何","なん"],["に"],["なろう"],["か"],["」"],["と"],["。"]]},{"verse":4,"text":"彼らは言葉を連ね偽り誓って、契約を結ぶ。裁きが生え出てもわが畑の畝に毒草が生えるようだ。","tok":[["彼","かれ"],["ら"],["は"],["言葉","ことば"],["を"],["連ね","つらね"],["偽り","いつわり"],["誓って","ちかって"],["、"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"],["裁き","さばき"],["が"],["生え出て","はえでて"],["も"],["わが"],["畑","はたけ"],["の"],["畝","うね"],["に"],["毒草","どくそう"],["が"],["生える","はえる"],["よう"],["だ"],["。"]]},{"verse":5,"text":"サマリアの住民はベト‧アベンの子牛のためにおびえ民はそのために嘆き悲しむ。神官たちがその栄光をたたえてもそれは彼らから取り去られる。","tok":[["サマリア"],["の"],["住民","じゅうみん"],["は"],["ベト"],["‧"],["アベン"],["の"],["子牛","こうし"],["の"],["ため"],["に"],["おびえ"],["民","みん"],["は"],["その"],["ため"],["に"],["嘆き悲しむ","なげきかなしむ"],["。"],["神官","しんかん"],["たち"],["が"],["その"],["栄光","えいこう"],["を"],["たたえて"],["も"],["それ"],["は"],["彼","かれ"],["ら"],["から"],["取り去られる","とりさられる"],["。"]]},{"verse":6,"text":"偶像はアッシリアへ運び去られ大王の貢ぎ物となる。エフライムは嘲りを受けイスラエルは謀のゆえに辱められる。","tok":[["偶像","ぐうぞう"],["は"],["アッシリア"],["へ"],["運び去られ","はこびさられ"],["大王","だいおう"],["の"],["貢ぎ物","みつぎもの"],["と"],["なる"],["。"],["エフライム"],["は"],["嘲り","あざけり"],["を"],["受け","うけ"],["イスラエル"],["は"],["謀","はかりごと"],["の"],["ゆえ"],["に"],["辱められる","はずかしめられる"],["。"]]},{"verse":7,"text":"サマリアは滅ぼされ王は水に浮かぶ泡のようになる。","tok":[["サマリア"],["は"],["滅ぼされ","ほろぼされ"],["王","おう"],["は"],["水","みず"],["に"],["浮かぶ","うかぶ"],["泡","あわ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"アベンの聖なる高台このイスラエルの罪は破壊され茨とあざみがその祭壇の周りに生い茂る。そのとき、彼らは山に向かい「我々を覆い隠せ」丘に向かっては「我々の上に崩れ落ちよ」と叫ぶ。","tok":[["アベン"],["の"],["聖","せい"],["なる"],["高台","たかだい"],["この"],["イスラエル"],["の"],["罪","つみ"],["は"],["破壊","はかい"],["され"],["茨","うばら"],["と"],["あざみ"],["が"],["その"],["祭壇","さいだん"],["の"],["周り","まわり"],["に"],["生い茂る","おいしげる"],["。"],["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["山","やま"],["に"],["向かい","むかい"],["「"],["我々","われわれ"],["を"],["覆い隠せ","おおいかくせ"],["」"],["丘","おか"],["に"],["向かって","むかって"],["は"],["「"],["我々","われわれ"],["の"],["上","うえ"],["に"],["崩れ落ち","くずれおち"],["よ"],["」"],["と"],["叫ぶ","さけぶ"],["。"]]},{"verse":9,"text":"イスラエルよ、ギブアの日々以来お前は罪を犯し続けている。罪にとどまり、背く者らにギブアで戦いが襲いかからないだろうか。","tok":[["イスラエル"],["よ"],["、"],["ギブア"],["の"],["日々","ひび"],["以来","いらい"],["お前","おまえ"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["続けて","つづけて"],["いる"],["。"],["罪","つみ"],["に"],["とどまり"],["、"],["背く","そむく"],["者","もの"],["ら"],["に"],["ギブア"],["で"],["戦い","たたかい"],["が"],["襲いかからないだろう","おそいかからないだろう"],["か"],["。"]]},{"verse":10,"text":"いや、わたしは必ず彼らを懲らしめる。諸国民は彼らに対して結集し二つの悪のゆえに彼らを捕らえる。","tok":[["いや"],["、"],["わたし"],["は"],["必ず","かならず"],["彼","かれ"],["ら"],["を"],["懲らしめる","こらしめる"],["。"],["諸","しょ"],["国民","こくみん"],["は"],["彼","かれ"],["ら"],["に対して","にたいして"],["結集","けっしゅう"],["し"],["二","ふた"],["つ"],["の"],["悪","あく"],["の"],["ゆえ"],["に"],["彼","かれ"],["ら"],["を"],["捕らえる","とらえる"],["。"]]},{"verse":11,"text":"エフライムは飼い馴らされた雌の子牛わたしは彼女に脱穀させるのを好んだ。わたしはその美しい首の傍らに来た。エフライムに働く支度をさせよう。ユダは耕し、ヤコブは鋤を引く。","tok":[["エフライム"],["は"],["飼い馴らされた","かいならされた"],["雌","めす"],["の"],["子牛","こうし"],["わたし"],["は"],["彼女","かのじょ"],["に"],["脱穀","だっこく"],["させる"],["の"],["を"],["好んだ","このんだ"],["。"],["わたし"],["は"],["その"],["美しい","うつくしい"],["首","くび"],["の"],["傍ら","かたわら"],["に"],["来た","きた"],["。"],["エフライム"],["に"],["働く","はたらく"],["支度","したく"],["を"],["させよう"],["。"],["ユダ"],["は"],["耕し","たがやし"],["、"],["ヤコブ"],["は"],["鋤","すき"],["を"],["引く","ひく"],["。"]]},{"verse":12,"text":"恵みの業をもたらす種を蒔け愛の実りを刈り入れよ。新しい土地を耕せ。主を求める時が来た。ついに主が訪れて恵みの雨を注いでくださるように。","tok":[["恵み","めぐみ"],["の"],["業","ごう"],["を"],["もたらす"],["種","たね"],["を"],["蒔け","まけ"],["愛","あい"],["の"],["実り","みのり"],["を"],["刈り入れよ","かりいれよ"],["。"],["新しい","あたらしい"],["土地","とち"],["を"],["耕せ","たがやせ"],["。"],["主","ぬし"],["を"],["求める","もとめる"],["時","とき"],["が"],["来た","きた"],["。"],["ついに"],["主","ぬし"],["が"],["訪れて","おとずれて"],["恵み","めぐみ"],["の"],["雨","あめ"],["を"],["注いで","そそいで"],["くださる"],["よう"],["に"],["。"]]},{"verse":13,"text":"ところがお前たちは悪を耕し不正を刈り入れ、欺きの実を食べた。自分の力と勇士の数を頼りにしたのだ。","tok":[["ところ"],["が"],["お前","おまえ"],["たち"],["は"],["悪","あく"],["を"],["耕し","たがやし"],["不正","ふせい"],["を"],["刈り入れ","かりいれ"],["、"],["欺き","あざむき"],["の"],["実","じつ"],["を"],["食べた","たべた"],["。"],["自分","じぶん"],["の"],["力","ちから"],["と"],["勇士","ゆうし"],["の"],["数","かず"],["を"],["頼り","たより"],["に"],["した"],["の"],["だ"],["。"]]},{"verse":14,"text":"どよめきがお前の民に向かって起こり砦はすべて破壊される。それはシャルマンがベト‧アルベルを破壊し母も子らも打ち殺したあの戦の日のようである。","tok":[["どよめき"],["が"],["お前","おまえ"],["の"],["民","たみ"],["に"],["向かって","むかって"],["起こり","おこり"],["砦","とりで"],["は"],["すべて"],["破壊","はかい"],["される"],["。"],["それ"],["は"],["シャルマン"],["が"],["ベト"],["‧"],["アルベル"],["を"],["破壊","はかい"],["し"],["母","はは"],["も"],["子","こ"],["ら"],["も"],["打ち殺した","うちころした"],["あの"],["戦","いくさ"],["の"],["日","ひ"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":15,"text":"ベテルよ、お前たちの甚だしい悪のゆえに同じことがお前にも起こる。夜明けと共にイスラエルの王は必ず断たれる。","tok":[["ベテル"],["よ"],["、"],["お前","おまえ"],["たち"],["の"],["甚だしい","はなはだしい"],["悪","あく"],["の"],["ゆえ"],["に"],["同じ","おなじ"],["こと"],["が"],["お前","おまえ"],["に"],["も"],["起こる","おこる"],["。"],["夜明け","よあけ"],["と"],["共","とも"],["に"],["イスラエル"],["の"],["王","おう"],["は"],["必ず","かならず"],["断たれる","たたれる"],["。"]]}]
[{"verse":1,"text":"イスラエルをいやそうとしてもかえって、エフライムの不義サマリアの悪が現れる。実に、彼らは偽りをたくらむ。盗人は家に忍び込み外では追いはぎの群れが人を襲う。","tok":[["イスラエル"],["を"],["いやそう"],["として"],["も"],["かえって"],["、"],["エフライム"],["の"],["不義","ふぎ"],["サマリア"],["の"],["悪","あく"],["が"],["現れる","あらわれる"],["。"],["実","じつ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["偽り","いつわり"],["を"],["たくらむ"],["。"],["盗人","ぬすびと"],["は"],["家","いえ"],["に"],["忍び込み","しのびこみ"],["外","がい"],["で"],["は"],["追いはぎ","おいはぎ"],["の"],["群れ","むれ"],["が"],["人","ひと"],["を"],["襲う","おそう"],["。"]]},{"verse":2,"text":"わたしは彼らの悪事をすべて心に留めている。しかし、彼らは少しも意に介さない。今や、彼らは悪に取り囲まれその有様はわたしの目の前にある。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["悪事","あくじ"],["を"],["すべて"],["心","こころ"],["に"],["留めて","とめて"],["いる"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["少し","すこし"],["も"],["意","い"],["に"],["介さない","かいさない"],["。"],["今","いま"],["や"],["、"],["彼","かれ"],["ら"],["は"],["悪","わる"],["に"],["取り囲まれ","とりかこまれ"],["その"],["有様","ありさま"],["は"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["ある"],["。"]]},{"verse":3,"text":"彼らは悪事によって王を欺きによって高官たちを喜ばせる。","tok":[["彼","かれ"],["ら"],["は"],["悪事","あくじ"],["によって"],["王","おう"],["を"],["欺き","あざむき"],["によって"],["高官","こうかん"],["たち"],["を"],["喜ばせる","よろこばせる"],["。"]]},{"verse":4,"text":"彼らは皆、姦淫を行う者燃えるかまどのようだ。パンを焼く者は小麦粉をこねると膨むまで、火をかき立てずにじっと待つ。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["姦淫","かんいん"],["を"],["行う","おこなう"],["者","もの"],["燃える","もえる"],["かまど"],["の"],["よう"],["だ"],["。"],["パン"],["を"],["焼く","やく"],["者","もの"],["は"],["小麦粉","こむぎこ"],["を"],["こねる"],["と"],["膨む","ふくらむ"],["まで"],["、"],["火","ひ"],["を"],["かき立てず","かきたてず"],["に"],["じっと"],["待つ","まつ"],["。"]]},{"verse":5,"text":"我々の王の祝いの日に高官たちはぶどう酒の熱で無力になり王は陰謀を働く者たちと手を結び","tok":[["我々","われわれ"],["の"],["王","おう"],["の"],["祝い","いわい"],["の"],["日","ひ"],["に"],["高官","こうかん"],["たち"],["は"],["ぶどう酒","ぶどうしゅ"],["の"],["熱","ねつ"],["で"],["無力","むりょく"],["に"],["なり"],["王","おう"],["は"],["陰謀","いんぼう"],["を"],["働く","はたらく"],["者","もの"],["たち"],["と"],["手","て"],["を"],["結び","むすび"]]},{"verse":6,"text":"燃えるかまどのようなたくらみに心を近づける。夜の間眠っていた彼らの怒りは朝になると燃え盛る火のように炎を噴く。","tok":[["燃える","もえる"],["か"],["ま"],["どのような"],["たくらみ"],["に"],["心","こころ"],["を"],["近づける","ちかづける"],["。"],["夜","よる"],["の"],["間","あいだ"],["眠って","ねむって"],["いた"],["彼","かれ"],["ら"],["の"],["怒り","いかり"],["は"],["朝","あさ"],["に"],["なる"],["と"],["燃え盛る","もえさかる"],["火","ひ"],["の"],["よう"],["に"],["炎","ほのお"],["を"],["噴く","ふく"],["。"]]},{"verse":7,"text":"彼らは皆、かまどのように熱くなり自分たちを支配する者を焼き尽くした。王たちはことごとく倒れひとりとして、わたしを呼ぶ者はなかった。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["かまど"],["の"],["よう"],["に"],["熱く","あつく"],["なり"],["自分","じぶん"],["たち"],["を"],["支配","しはい"],["する"],["者","もの"],["を"],["焼き","やき"],["尽くした","つくした"],["。"],["王","おう"],["たち"],["は"],["ことごとく"],["倒れ","たおれ"],["ひとり"],["として"],["、"],["わたし"],["を"],["呼ぶ","よぶ"],["者","もの"],["は"],["なかった"],["。"]]},{"verse":8,"text":"エフライムは諸国民の中に交ぜ合わされエフライムは裏返さずに焼かれた菓子となった。","tok":[["エフライム"],["は"],["諸","しょ"],["国民","こくみん"],["の"],["中","なか"],["に"],["交ぜ","まぜ"],["合わされ","あわされ"],["エフライム"],["は"],["裏返さず","うらがえさず"],["に"],["焼かれた","やかれた"],["菓子","かし"],["と"],["なった"],["。"]]},{"verse":9,"text":"他国の人々が彼の力を食い尽くしても彼はそれに気づかない。白髪が多くなっても彼はそれに気づかない。","tok":[["他国","たこく"],["の"],["人々","ひとびと"],["が"],["彼","かれ"],["の"],["力","ちから"],["を"],["食い","くい"],["尽くして","つくして"],["も"],["彼","かれ"],["は"],["それ"],["に"],["気づかない","きづかない"],["。"],["白髪","はくはつ"],["が"],["多く","おおく"],["なって"],["も"],["彼","かれ"],["は"],["それ"],["に"],["気づかない","きづかない"],["。"]]},{"verse":10,"text":"イスラエルを罪に落とすのは自らの高慢である。彼らは神なる主に帰らずこれらすべてのことがあっても主を尋ね求めようとしない。","tok":[["イスラエル"],["を"],["罪","つみ"],["に"],["落とす","おとす"],["の"],["は"],["自ら","みずから"],["の"],["高慢","こうまん"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["神","かみ"],["なる"],["主","ぬし"],["に"],["帰らず","かえらず"],["これ"],["ら"],["すべて"],["の"],["こと"],["が"],["あって"],["も"],["主","ぬし"],["を"],["尋ね求めよう","たずねもとめよう"],["と"],["しない"],["。"]]},{"verse":11,"text":"エフライムは鳩のようだ。愚かで、悟りがない。エジプトに助けを求めあるいは、アッシリアに頼って行く。","tok":[["エフライム"],["は"],["鳩","はと"],["の"],["よう"],["だ"],["。"],["愚か","おろか"],["で"],["、"],["悟り","さとり"],["が"],["ない"],["。"],["エジプト"],["に"],["助け","たすけ"],["を"],["求め","もとめ"],["あるいは"],["、"],["アッシリア"],["に"],["頼って","たよって"],["行く","いく"],["。"]]},{"verse":12,"text":"彼らが出て行こうとするときわたしはその上に網を張り網にかかった音を聞くと空の鳥のように、引き落として捕らえる。","tok":[["彼","かれ"],["ら"],["が"],["出て","でて"],["行こう","いこう"],["と"],["する"],["とき"],["わたし"],["は"],["その"],["上","うえ"],["に"],["網","あみ"],["を"],["張り網","はりあみ"],["に"],["かかった"],["音","おと"],["を"],["聞く","きく"],["と"],["空","そら"],["の"],["鳥","とり"],["の"],["よう"],["に"],["、"],["引き落として","ひきおとして"],["捕らえる","とらえる"],["。"]]},{"verse":13,"text":"なんと災いなことか。彼らはわたしから離れ去った。わたしに背いたから、彼らは滅びる。どんなに彼らを救おうとしても彼らはわたしに偽って語る。","tok":[["なん"],["と"],["災い","わざわい"],["な"],["こと"],["か"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["から"],["離れ去った","はなれさった"],["。"],["わたし"],["に"],["背いた","そむいた"],["から"],["、"],["彼","かれ"],["ら"],["は"],["滅びる","ほろびる"],["。"],["どんな"],["に"],["彼","かれ"],["ら"],["を"],["救おう","すくおう"],["として"],["も"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["偽って","いつわって"],["語る","かたる"],["。"]]},{"verse":14,"text":"彼らは心からわたしの助けを求めようとはしない。寝床の上で泣き叫び穀物と新しい酒を求めて身を傷つけるがわたしには背を向けている。","tok":[["彼","かれ"],["ら"],["は"],["心","こころ"],["から"],["わたし"],["の"],["助け","たすけ"],["を"],["求めよう","もとめよう"],["と"],["は"],["しない"],["。"],["寝床","ねどこ"],["の"],["上","うえ"],["で"],["泣き叫び","なきさけび"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["酒","さけ"],["を"],["求めて","もとめて"],["身","み"],["を"],["傷つける","きずつける"],["が"],["わたし"],["に"],["は"],["背","せ"],["を"],["向けて","むけて"],["いる"],["。"]]},{"verse":15,"text":"わたしは、彼らを教えてその腕を強くしたが彼らはわたしに対して悪事をたくらんだ。","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["教えて","おしえて"],["その"],["腕","うで"],["を"],["強く","つよく"],["した"],["が"],["彼","かれ"],["ら"],["は"],["わたし"],["に対して","にたいして"],["悪事","あくじ"],["を"],["たくらんだ"],["。"]]},{"verse":16,"text":"彼らは戻ってきたがねじれた弓のようにむなしいものに向かった。高官たちは自分で吐いた呪いのために剣にかかって倒れエジプトの地で、物笑いの種となる。","tok":[["彼","かれ"],["ら"],["は"],["戻って","もどって"],["きた"],["が"],["ねじれた"],["弓","ゆみ"],["の"],["よう"],["に"],["むなしい"],["もの"],["に"],["向かった","むかった"],["。"],["高官","こうかん"],["たち"],["は"],["自分","じぶん"],["で"],["吐いた","はいた"],["呪い","のろい"],["の"],["ため"],["に"],["剣","けん"],["に"],["かかって"],["倒れ","たおれ"],["エジプト"],["の"],["地","ち"],["で"],["、"],["物笑い","ものわらい"],["の"],["種","しゅ"],["と"],["なる"],["。"]]}]
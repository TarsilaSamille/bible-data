[{"verse":1,"text":"ユダの王、ウジヤ、ヨタム、アハズ、ヒゼキヤの時代、イスラエルの王ヨアシュの子ヤロブアムの時代に、ベエリの子ホセアに臨んだ主の言葉。","tok":[["ユダ"],["の"],["王","おう"],["、"],["ウジヤ"],["、"],["ヨタム"],["、"],["アハズ"],["、"],["ヒゼキヤ"],["の"],["時代","じだい"],["、"],["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["の"],["子","こ"],["ヤロブアム"],["の"],["時代","じだい"],["に"],["、"],["ベエリ"],["の"],["子","こ"],["ホセア"],["に"],["臨んだ","のぞんだ"],["主","ぬし"],["の"],["言葉","ことば"],["。"]]},{"verse":2,"text":"主がホセアに語られたことの初め。主はホセアに言われた。「行け、淫行の女をめとり淫行による子らを受け入れよ。この国は主から離れ、淫行にふけっているからだ。」","tok":[["主","ぬし"],["が"],["ホセア"],["に"],["語られた","かたられた"],["こと"],["の"],["初め","はじめ"],["。"],["主","ぬし"],["は"],["ホセア"],["に"],["言われた","いわれた"],["。"],["「"],["行け","いけ"],["、"],["淫行","いんこう"],["の"],["女","おんな"],["を"],["めとり"],["淫行","いんこう"],["に"],["よる"],["子","こ"],["ら"],["を"],["受け入れよ","うけいれよ"],["。"],["この"],["国","くに"],["は"],["主","ぬし"],["から"],["離れ","はなれ"],["、"],["淫行","いんこう"],["に"],["ふけって"],["いる"],["から"],["だ"],["。"],["」"]]},{"verse":3,"text":"彼は行って、ディブライムの娘ゴメルをめとった。彼女は身ごもり、男の子を産んだ。","tok":[["彼","かれ"],["は"],["行って","いって"],["、"],["ディブ"],["ライム"],["の"],["娘","むすめ"],["ゴメル"],["を"],["めとった"],["。"],["彼女","かのじょ"],["は"],["身ごもり","みごもり"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":4,"text":"主は彼に言われた。「その子をイズレエルと名付けよ。間もなく、わたしはイエフの王家にイズレエルにおける流血の罰を下しイスラエルの家におけるその支配を絶つ。","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["その"],["子","こ"],["を"],["イズレエル"],["と"],["名付け","なづけ"],["よ"],["。"],["間","ま"],["も"],["なく"],["、"],["わたし"],["は"],["イエフ"],["の"],["王家","おうけ"],["に"],["イズレエル"],["に"],["おける"],["流血","りゅうけつ"],["の"],["罰","ばつ"],["を"],["下し","くだし"],["イスラエル"],["の"],["家","いえ"],["に"],["おける"],["その"],["支配","しはい"],["を"],["絶つ","たつ"],["。"]]},{"verse":5,"text":"その日が来るとイズレエルの平野でわたしはイスラエルの弓を折る。」","tok":[["その"],["日","ひ"],["が"],["来る","くる"],["と"],["イズレエル"],["の"],["平野","へいや"],["で"],["わたし"],["は"],["イスラエル"],["の"],["弓","ゆみ"],["を"],["折る","おる"],["。"],["」"]]},{"verse":6,"text":"彼女は再び身ごもり、女の子を産んだ。主は彼に言われた。「その子をロ‧ルハマ（憐れまれぬ者）と名付けよ。わたしは、もはやイスラエルの家を憐れまず彼らを決して赦さないからだ。","tok":[["彼女","かのじょ"],["は"],["再び","ふたたび"],["身ごもり","みごもり"],["、"],["女の子","おんなのこ"],["を"],["産んだ","うんだ"],["。"],["主","ぬし"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["その"],["子","こ"],["を"],["ロ"],["‧"],["ルハマ"],["（"],["憐れまれぬ","あわれまれぬ"],["者","もの"],["）"],["と"],["名付け","なづけ"],["よ"],["。"],["わたし"],["は"],["、"],["もはや"],["イスラエル"],["の"],["家","いえ"],["を"],["憐れまず","あわれまず"],["彼","かれ"],["ら"],["を"],["決して","けっして"],["赦さない","ゆるさない"],["から"],["だ"],["。"]]},{"verse":7,"text":"だが、ユダの家には憐れみをかけ彼らの神なる主として、わたしは彼らを救う。弓、剣、戦い、馬、騎兵によって救うのではない。」","tok":[["だ"],["が"],["、"],["ユダ"],["の"],["家","いえ"],["に"],["は"],["憐れみ","あわれみ"],["を"],["かけ"],["彼","かれ"],["ら"],["の"],["神","かみ"],["なる"],["主","ぬし"],["として"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["救う","すくう"],["。"],["弓","ゆみ"],["、"],["剣","けん"],["、"],["戦い","たたかい"],["、"],["馬","うま"],["、"],["騎兵","きへい"],["によって"],["救う","すくう"],["ので"],["は"],["ない"],["。"],["」"]]},{"verse":8,"text":"彼女はロ‧ルハマを乳離れさせると、また身ごもって、男の子を産んだ。","tok":[["彼女","かのじょ"],["は"],["ロ"],["‧"],["ルハマ"],["を"],["乳離れ","ちばなれ"],["させる"],["と"],["、"],["また"],["身ごもって","みごもって"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":9,"text":"主は言われた。「その子をロ‧アンミ（わが民でない者）と名付けよ。あなたたちはわたしの民ではなくわたしはあなたたちの神ではないからだ。」","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["その"],["子","こ"],["を"],["ロ"],["‧"],["アンミ"],["（"],["わが"],["民","たみ"],["で"],["ない"],["者","もの"],["）"],["と"],["名付け","なづけ"],["よ"],["。"],["あなた"],["たち"],["は"],["わたし"],["の"],["民","たみ"],["で"],["は"],["なく"],["わたし"],["は"],["あなた"],["たち"],["の"],["神","かみ"],["で"],["は"],["ない"],["から"],["だ"],["。"],["」"]]}]
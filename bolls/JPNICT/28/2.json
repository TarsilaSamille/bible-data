[{"verse":1,"text":"イスラエルの人々は、その数を増し海の砂のようになり量ることも、数えることもできなくなる。彼らは「あなたたちは、ロ‧アンミ（わが民でない者）」と言われるかわりに「生ける神の子ら」と言われるようになる。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["その"],["数","かず"],["を"],["増し","まし"],["海","うみ"],["の"],["砂","すな"],["の"],["よう"],["に"],["なり"],["量る","はかる"],["こと"],["も"],["、"],["数える","かぞえる"],["こと"],["も"],["できなく"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["「"],["あなた"],["たち"],["は"],["、"],["ロ"],["‧"],["アンミ"],["（"],["わが"],["民","たみ"],["で"],["ない"],["者","もの"],["）"],["」"],["と"],["言われる","いわれる"],["かわり"],["に"],["「"],["生ける","いける"],["神","かみ"],["の"],["子","こ"],["ら"],["」"],["と"],["言われる","いわれる"],["よう"],["に"],["なる"],["。"]]},{"verse":2,"text":"ユダの人々とイスラエルの人々はひとつに集められ一人の頭を立てて、その地から上って来る。イズレエルの日は栄光に満たされる。","tok":[["ユダ"],["の"],["人々","ひとびと"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["ひと"],["つ"],["に"],["集められ","あつめられ"],["一人","ひとり"],["の"],["頭","あたま"],["を"],["立てて","たてて"],["、"],["その"],["地","ち"],["から"],["上って","のぼって"],["来る","くる"],["。"],["イズレエル"],["の"],["日","ひ"],["は"],["栄光","えいこう"],["に"],["満たされる","みたされる"],["。"]]},{"verse":3,"text":"あなたたちは兄弟に向かって「アンミ（わが民）」と言え。あなたたちは姉妹に向かって「ルハマ（憐れまれる者）」と言え。","tok":[["あなた"],["たち"],["は"],["兄弟","きょうだい"],["に"],["向かって","むかって"],["「"],["アンミ"],["（"],["わが"],["民","みん"],["）"],["」"],["と"],["言え","いえ"],["。"],["あなた"],["たち"],["は"],["姉妹","しまい"],["に"],["向かって","むかって"],["「"],["ルハマ"],["（"],["憐れまれる","あわれまれる"],["者","もの"],["）"],["」"],["と"],["言え","いえ"],["。"]]},{"verse":4,"text":"告発せよ、お前たちの母を告発せよ。彼女はもはやわたしの妻ではなくわたしは彼女の夫ではない。彼女の顔から淫行を乳房の間から姦淫を取り除かせよ。","tok":[["告発","こくはつ"],["せよ"],["、"],["お前","おまえ"],["たち"],["の"],["母","はは"],["を"],["告発","こくはつ"],["せよ"],["。"],["彼女","かのじょ"],["は"],["もはや"],["わたし"],["の"],["妻","つま"],["で"],["は"],["なく"],["わたし"],["は"],["彼女","かのじょ"],["の"],["夫","おっと"],["で"],["は"],["ない"],["。"],["彼女","かのじょ"],["の"],["顔","かお"],["から"],["淫行","いんこう"],["を"],["乳房","ちぶさ"],["の"],["間","あいだ"],["から"],["姦淫","かんいん"],["を"],["取り除かせ","とりのぞかせ"],["よ"],["。"]]},{"verse":5,"text":"さもなければ、わたしが衣をはぎ取って裸にし生まれた日の姿にして、さらしものにする。また、彼女を荒れ野のように乾いた地のように干上がらせ彼女を渇きで死なせる。","tok":[["さも"],["なければ"],["、"],["わたし"],["が"],["衣","ころも"],["を"],["はぎ取って","はぎとって"],["裸","はだか"],["に"],["し"],["生まれた","うまれた"],["日","ひ"],["の"],["姿","すがた"],["に"],["して"],["、"],["さらしもの"],["に"],["する"],["。"],["また"],["、"],["彼女","かのじょ"],["を"],["荒れ野","あれの"],["の"],["よう"],["に"],["乾いた","かわいた"],["地","ち"],["の"],["よう"],["に"],["干上がらせ","ひあがらせ"],["彼女","かのじょ"],["を"],["渇き","かわき"],["で"],["死なせる","しなせる"],["。"]]},{"verse":6,"text":"わたしはその子らを憐れまない。淫行による子らだから。","tok":[["わたし"],["は"],["その"],["子","こ"],["ら"],["を"],["憐れまない","あわれまない"],["。"],["淫行","いんこう"],["に"],["よる"],["子","こ"],["ら"],["だ"],["から"],["。"]]},{"verse":7,"text":"その母は淫行にふけり彼らを身ごもった者は恥ずべきことを行った。彼女は言う。「愛人たちについて行こう。パンと水、羊毛と麻オリーブ油と飲み物をくれるのは彼らだ。」","tok":[["その"],["母","はは"],["は"],["淫行","いんこう"],["に"],["ふけり"],["彼","かれ"],["ら"],["を"],["身ごもった","みごもった"],["者","もの"],["は"],["恥ずべき","はずべき"],["こと"],["を"],["行った","おこなった"],["。"],["彼女","かのじょ"],["は"],["言う","ゆう"],["。"],["「"],["愛人","あいじん"],["たち"],["について"],["行こう","いこう"],["。"],["パン"],["と"],["水","みず"],["、"],["羊毛","ようもう"],["と"],["麻","あさ"],["オリーブ油","おりーぶゆ"],["と"],["飲み物","のみもの"],["を"],["くれる"],["の"],["は"],["彼","かれ"],["ら"],["だ"],["。"],["」"]]},{"verse":8,"text":"それゆえ、わたしは彼女の行く道を茨でふさぎ石垣で遮り道を見いだせないようにする。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["彼女","かのじょ"],["の"],["行く","いく"],["道","みち"],["を"],["茨","うばら"],["で"],["ふさぎ"],["石垣","いしがき"],["で"],["遮り","さえぎり"],["道","みち"],["を"],["見いだせない","みいだせない"],["よう"],["に"],["する"],["。"]]},{"verse":9,"text":"彼女は愛人の後を追っても追いつけず尋ね求めても見いだせない。そのとき、彼女は言う。「初めの夫のもとに帰ろうあのときは、今よりも幸せだった」と。","tok":[["彼女","かのじょ"],["は"],["愛人","あいじん"],["の"],["後","あと"],["を"],["追って","おって"],["も"],["追いつけず","おいつけず"],["尋ね求めて","たずねもとめて"],["も"],["見いだせない","みいだせない"],["。"],["その"],["とき"],["、"],["彼女","かのじょ"],["は"],["言う","ゆう"],["。"],["「"],["初め","はじめ"],["の"],["夫","おっと"],["の"],["もと"],["に"],["帰ろう","かえろう"],["あの"],["とき"],["は"],["、"],["今","いま"],["より"],["も"],["幸せ","しあわせ"],["だった"],["」"],["と"],["。"]]},{"verse":10,"text":"彼女は知らないのだ。穀物、新しい酒、オリーブ油を与えバアル像を造った金銀を、豊かに得させたのはわたしだということを。","tok":[["彼女","かのじょ"],["は"],["知らない","しらない"],["の"],["だ"],["。"],["穀物","こくもつ"],["、"],["新しい","あたらしい"],["酒","さけ"],["、"],["オリーブ油","おりーぶゆ"],["を"],["与え","あたえ"],["バアル"],["像","ぞう"],["を"],["造った","つくった"],["金銀","きんぎん"],["を"],["、"],["豊か","ゆたか"],["に"],["得させた","えさせた"],["の"],["は"],["わたし"],["だ"],["と"],["いう"],["こと"],["を"],["。"]]},{"verse":11,"text":"それゆえ、わたしは刈り入れのときに穀物を取り入れのときに新しい酒を取り戻す。また、彼女の裸を覆っているわたしの羊毛と麻とを奪い取る。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["刈り入れ","かりいれ"],["の"],["とき"],["に"],["穀物","こくもつ"],["を"],["取り入れ","とりいれ"],["の"],["とき"],["に"],["新しい","あたらしい"],["酒","さけ"],["を"],["取り戻す","とりもどす"],["。"],["また"],["、"],["彼女","かのじょ"],["の"],["裸","はだか"],["を"],["覆って","おおって"],["いる"],["わたし"],["の"],["羊毛","ようもう"],["と"],["麻","あさ"],["と"],["を"],["奪い取る","うばいとる"],["。"]]},{"verse":12,"text":"こうして、彼女の恥を愛人たちの目の前にさらす。この手から彼女を救い出す者はだれもない。","tok":[["こう"],["して"],["、"],["彼女","かのじょ"],["の"],["恥","はじ"],["を"],["愛人","あいじん"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["に"],["さらす"],["。"],["この"],["手","て"],["から"],["彼女","かのじょ"],["を"],["救い出す","すくいだす"],["者","もの"],["は"],["だれ"],["も"],["ない"],["。"]]},{"verse":13,"text":"わたしは彼女の楽しみをすべて絶ち祭り、新月祭、安息日などの祝いをすべてやめさせる。","tok":[["わたし"],["は"],["彼女","かのじょ"],["の"],["楽しみ","たのしみ"],["を"],["すべて"],["絶ち","たち"],["祭り","まつり"],["、"],["新月祭","しんげつさい"],["、"],["安息日","あんそくび"],["など"],["の"],["祝い","いわい"],["を"],["すべて"],["やめさせる"],["。"]]},{"verse":14,"text":"また、彼女のぶどうといちじくの園を荒らす。「これは愛人たちの贈り物だ」と彼女は言っているがわたしはそれを茂みに変え野の獣がそれを食い荒らす。","tok":[["また"],["、"],["彼女","かのじょ"],["の"],["ぶどう"],["と"],["いちじく"],["の"],["園","その"],["を"],["荒らす","あらす"],["。"],["「"],["これ"],["は"],["愛人","あいじん"],["たち"],["の"],["贈り物","おくりもの"],["だ"],["」"],["と"],["彼女","かのじょ"],["は"],["言って","いって"],["いる"],["が"],["わたし"],["は"],["それ"],["を"],["茂み","しげみ"],["に"],["変え","かえ"],["野","の"],["の"],["獣","けもの"],["が"],["それ"],["を"],["食い荒らす","くいあらす"],["。"]]},{"verse":15,"text":"バアルを祝って過ごした日々についてわたしは彼女を罰する。彼女はバアルに香をたき鼻輪や首飾りで身を飾り愛人の後について行きわたしを忘れ去った、と主は言われる。","tok":[["バアル"],["を"],["祝って","いわって"],["過ごした","すごした"],["日々","ひび"],["について"],["わたし"],["は"],["彼女","かのじょ"],["を"],["罰する","ばっする"],["。"],["彼女","かのじょ"],["は"],["バアル"],["に"],["香","こう"],["を"],["たき"],["鼻輪","はなわ"],["や"],["首飾り","くびかざり"],["で"],["身","み"],["を"],["飾り","かざり"],["愛人","あいじん"],["の"],["後","あと"],["について"],["行き","いき"],["わたし"],["を"],["忘れ去った","わすれさった"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":16,"text":"それゆえ、わたしは彼女をいざなって荒れ野に導き、その心に語りかけよう。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["彼女","かのじょ"],["を"],["いざなって"],["荒れ野","あれの"],["に"],["導き","みちびき"],["、"],["その"],["心","こころ"],["に"],["語りかけよう","かたりかけよう"],["。"]]},{"verse":17,"text":"そのところで、わたしはぶどう園を与えアコル（苦悩）の谷を希望の門として与える。そこで、彼女はわたしにこたえる。おとめであったときエジプトの地から上ってきた日のように。","tok":[["その"],["ところ"],["で"],["、"],["わたし"],["は"],["ぶどう園","ぶどうえん"],["を"],["与え","あたえ"],["アコル"],["（"],["苦悩","くのう"],["）"],["の"],["谷","たに"],["を"],["希望","きぼう"],["の"],["門","もん"],["として"],["与える","あたえる"],["。"],["そこ"],["で"],["、"],["彼女","かのじょ"],["は"],["わたし"],["に"],["こたえる"],["。"],["おとめ"],["で"],["あった"],["とき"],["エジプト"],["の"],["地","ち"],["から"],["上って","のぼって"],["きた"],["日","ひ"],["の"],["よう"],["に"],["。"]]},{"verse":18,"text":"その日が来ればと主は言われる。あなたはわたしを、「わが夫」と呼びもはや、「わが主人（バアル）」とは呼ばない。","tok":[["その"],["日","ひ"],["が"],["来れば","くれば"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["あなた"],["は"],["わたし"],["を"],["、"],["「"],["わが"],["夫","おっと"],["」"],["と"],["呼び","よび"],["もはや"],["、"],["「"],["わが"],["主人（バアル）","しゅじん"],["」"],["と"],["は"],["呼ばない","よばない"],["。"]]},{"verse":19,"text":"わたしは、どのバアルの名をも彼女の口から取り除く。もはやその名が唱えられることはない。","tok":[["わたし"],["は"],["、"],["どの"],["バアル"],["の"],["名","な"],["を"],["も"],["彼女","かのじょ"],["の"],["口","くち"],["から"],["取り除く","とりのぞく"],["。"],["もはや"],["その"],["名","な"],["が"],["唱えられる","となえられる"],["こと"],["は"],["ない"],["。"]]},{"verse":20,"text":"その日には、わたしは彼らのために野の獣、空の鳥、土を這うものと契約を結ぶ。弓も剣も戦いもこの地から絶ち彼らを安らかに憩わせる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["野","の"],["の"],["獣","けもの"],["、"],["空","そら"],["の"],["鳥","とり"],["、"],["土","つち"],["を"],["這う","はう"],["もの"],["と"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"],["弓","ゆみ"],["も"],["剣","けん"],["も"],["戦い","たたかい"],["も"],["この"],["地","ち"],["から"],["絶ち","たち"],["彼","かれ"],["ら"],["を"],["安らか","やすらか"],["に"],["憩わせる","いこわせる"],["。"]]},{"verse":21,"text":"わたしは、あなたととこしえの契りを結ぶ。わたしは、あなたと契りを結び正義と公平を与え、慈しみ憐れむ。","tok":[["わたし"],["は"],["、"],["あなた"],["と"],["とこしえ"],["の"],["契り","ちぎり"],["を"],["結ぶ","むすぶ"],["。"],["わたし"],["は"],["、"],["あなた"],["と"],["契り","ちぎり"],["を"],["結び","むすび"],["正義","せいぎ"],["と"],["公平","こうへい"],["を"],["与え","あたえ"],["、"],["慈しみ","いつくしみ"],["憐れむ","あわれむ"],["。"]]},{"verse":22,"text":"わたしはあなたとまことの契りを結ぶ。あなたは主を知るようになる。","tok":[["わたし"],["は"],["あなた"],["と"],["まこと"],["の"],["契り","ちぎり"],["を"],["結ぶ","むすぶ"],["。"],["あなた"],["は"],["主","ぬし"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":23,"text":"その日が来れば、わたしはこたえると主は言われる。わたしは天にこたえ天は地にこたえる。","tok":[["その"],["日","ひ"],["が"],["来れば","くれば"],["、"],["わたし"],["は"],["こたえる"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["天","てん"],["に"],["こたえ"],["天","てん"],["は"],["地","ち"],["に"],["こたえる"],["。"]]},{"verse":24,"text":"地は、穀物と新しい酒とオリーブ油にこたえそれらはイズレエル（神が種を蒔く）にこたえる。","tok":[["地","ち"],["は"],["、"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["酒","さけ"],["と"],["オリーブ油","おりーぶゆ"],["に"],["こたえ"],["それ"],["ら"],["は"],["イズレエル"],["（"],["神","かみ"],["が"],["種","たね"],["を"],["蒔く","まく"],["）"],["に"],["こたえる"],["。"]]},{"verse":25,"text":"わたしは彼女を地に蒔きロ‧ルハマ（憐れまれぬ者）を憐れみロ‧アンミ（わが民でない者）に向かって「あなたはアンミ（わが民）」と言う。彼は、「わが神よ」とこたえる。","tok":[["わたし"],["は"],["彼女","かのじょ"],["を"],["地","ち"],["に"],["蒔き","まき"],["ロ"],["‧"],["ルハマ"],["（"],["憐れまれぬ","あわれまれぬ"],["者","もの"],["）"],["を"],["憐れみ","あわれみ"],["ロ"],["‧"],["アンミ"],["（"],["わが"],["民","たみ"],["で"],["ない"],["者","もの"],["）"],["に"],["向かって","むかって"],["「"],["あなた"],["は"],["アンミ"],["（"],["わが"],["民","みん"],["）"],["」"],["と"],["言う","ゆう"],["。"],["彼","かれ"],["は"],["、"],["「"],["わが"],["神","かみ"],["よ"],["」"],["と"],["こたえる"],["。"]]}]
[{"verse":1,"text":"エフライムは偽りをもってイスラエルの家は欺きをもってわたしを取り巻いた。ユダはいまだに神から離れてさまよい偶像を聖なるものとして信頼している。","tok":[["エフライム"],["は"],["偽り","いつわり"],["を"],["もって"],["イスラエル"],["の"],["家","いえ"],["は"],["欺き","あざむき"],["を"],["もって"],["わたし"],["を"],["取り巻いた","とりまいた"],["。"],["ユダ"],["は"],["いまだ"],["に"],["神","かみ"],["から"],["離れて","はなれて"],["さまよい"],["偶像","ぐうぞう"],["を"],["聖","せい"],["なる"],["もの"],["として"],["信頼","しんらい"],["して"],["いる"],["。"]]},{"verse":2,"text":"エフライムは風の牧者となり一日中、熱風を追って歩く。欺瞞と暴虐を重ねアッシリアと契約を結び油をエジプトへ貢ぐ。","tok":[["エフライム"],["は"],["風","かぜ"],["の"],["牧者","ぼくしゃ"],["と"],["なり"],["一","いち"],["日中","にちちゅう"],["、"],["熱風","ねっぷう"],["を"],["追って","おって"],["歩く","あるく"],["。"],["欺瞞","ぎまん"],["と"],["暴虐","ぼうぎゃく"],["を"],["重ね","かさね"],["アッシリア"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["油","あぶら"],["を"],["エジプト"],["へ"],["貢ぐ","みつぐ"],["。"]]},{"verse":3,"text":"主はユダを告発される。ヤコブをその歩みにしたがって罰しその悪い行いに報いられる。","tok":[["主","ぬし"],["は"],["ユダ"],["を"],["告発","こくはつ"],["される"],["。"],["ヤコブ"],["を"],["その"],["歩み","あゆみ"],["に"],["したがって"],["罰し","ばっし"],["その"],["悪い","わるい"],["行い","おこない"],["に"],["報いられる","むくいられる"],["。"]]},{"verse":4,"text":"ヤコブは母の胎にいたときから兄のかかとをつかみ力を尽くして神と争った。","tok":[["ヤコブ"],["は"],["母","はは"],["の"],["胎","はら"],["に"],["いた"],["とき"],["から"],["兄","あに"],["の"],["かかと"],["を"],["つかみ"],["力","ちから"],["を"],["尽くして","つくして"],["神","かみ"],["と"],["争った","あらそった"],["。"]]},{"verse":5,"text":"神の使いと争って勝ち泣いて恵みを乞うた。神はベテルで彼を見いだしそこで彼と語られた。","tok":[["神","かみ"],["の"],["使い","つかい"],["と"],["争って","あらそって"],["勝ち","かち"],["泣いて","ないて"],["恵み","めぐみ"],["を"],["乞うた","こうた"],["。"],["神","かみ"],["は"],["ベテル"],["で"],["彼","かれ"],["を"],["見いだし","みいだし"],["そこ"],["で"],["彼","かれ"],["と"],["語られた","かたられた"],["。"]]},{"verse":6,"text":"主こそ万軍の神その御名は主と唱えられる。","tok":[["主","ぬし"],["こそ"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["その"],["御名","ぎょめい"],["は"],["主","ぬし"],["と"],["唱えられる","となえられる"],["。"]]},{"verse":7,"text":"神のもとに立ち帰れ。愛と正義を保ち常にあなたの神を待ち望め。","tok":[["神","かみ"],["の"],["もと"],["に"],["立ち帰れ","たちかえれ"],["。"],["愛","あい"],["と"],["正義","せいぎ"],["を"],["保ち","たもち"],["常","つね"],["に"],["あなた"],["の"],["神","かみ"],["を"],["待ち望め","まちのぞめ"],["。"]]},{"verse":8,"text":"商人は欺きの秤を手にし、搾取を愛する。","tok":[["商人","しょうにん"],["は"],["欺き","あざむき"],["の"],["秤","はかり"],["を"],["手","て"],["に"],["し"],["、"],["搾取","さくしゅ"],["を"],["愛する","あいする"],["。"]]},{"verse":9,"text":"エフライムは言う。「わたしは豊かになり、富を得た。この財産がすべて罪と悪とで積み上げられたとはだれも気づくまい。」","tok":[["エフライム"],["は"],["言う","ゆう"],["。"],["「"],["わたし"],["は"],["豊か","ゆたか"],["に"],["なり"],["、"],["富","とみ"],["を"],["得た","えた"],["。"],["この"],["財産","ざいさん"],["が"],["すべて"],["罪","つみ"],["と"],["悪","あく"],["と"],["で"],["積み上げられた","つみあげられた"],["と"],["は"],["だれ"],["も"],["気づくまい","きづくまい"],["。"],["」"]]},{"verse":10,"text":"わたしこそあなたの神、主。エジプトの地からあなたを導き上った。わたしは再びあなたを天幕に住まわせるわたしがあなたと共にあった日々のように。","tok":[["わたし"],["こそ"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["。"],["エジプト"],["の"],["地","ち"],["から"],["あなた"],["を"],["導き","みちびき"],["上った","のぼった"],["。"],["わたし"],["は"],["再び","ふたたび"],["あなた"],["を"],["天幕","てんまく"],["に"],["住まわせる","すまわせる"],["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["あった"],["日々","ひび"],["の"],["よう"],["に"],["。"]]},{"verse":11,"text":"わたしは預言者たちに言葉を伝え多くの幻を示し預言者たちによってたとえを示した。","tok":[["わたし"],["は"],["預言者","よげんしゃ"],["たち"],["に"],["言葉","ことば"],["を"],["伝え","つたえ"],["多く","おおく"],["の"],["幻","まぼろし"],["を"],["示し","しめし"],["預言者","よげんしゃ"],["たち"],["によって"],["たとえ"],["を"],["示した","しめした"],["。"]]},{"verse":12,"text":"ギレアドには忌むべきものがある。まことにそれらはむなしい。ギルガルでは雄牛に犠牲をささげている。その祭壇は畑の畝に積まれた石塚にすぎない。","tok":[["ギレアド"],["に"],["は"],["忌むべき","いむべき"],["もの"],["が"],["ある"],["。"],["まこと"],["に"],["それ"],["ら"],["は"],["むなしい"],["。"],["ギルガル"],["で"],["は"],["雄牛","おうし"],["に"],["犠牲","ぎせい"],["を"],["ささげて"],["いる"],["。"],["その"],["祭壇","さいだん"],["は"],["畑","はたけ"],["の"],["畝","うね"],["に"],["積まれた","つまれた"],["石塚","いしづか"],["に"],["すぎない"],["。"]]},{"verse":13,"text":"ヤコブはアラムの野に逃れイスラエルは妻を得るために仕えまた妻を得るために群れを守った。","tok":[["ヤコブ"],["は"],["アラム"],["の"],["野","の"],["に"],["逃れ","のがれ"],["イスラエル"],["は"],["妻","つま"],["を"],["得る","える"],["ため"],["に"],["仕え","つかえ"],["また"],["妻","つま"],["を"],["得る","える"],["ため"],["に"],["群れ","むれ"],["を"],["守った","まもった"],["。"]]},{"verse":14,"text":"主は一人の預言者によってイスラエルをエジプトから導き上らせ預言者によって彼らを守られた。","tok":[["主","ぬし"],["は"],["一人","ひとり"],["の"],["預言者","よげんしゃ"],["によって"],["イスラエル"],["を"],["エジプト"],["から"],["導き","みちびき"],["上らせ","のぼらせ"],["預言者","よげんしゃ"],["によって"],["彼","かれ"],["ら"],["を"],["守られた","まもられた"],["。"]]},{"verse":15,"text":"エフライムは主を激しく怒らせた。主は流血の報いを彼に下しその恥辱を彼に返される。","tok":[["エフライム"],["は"],["主","ぬし"],["を"],["激しく","はげしく"],["怒らせた","おこらせた"],["。"],["主","ぬし"],["は"],["流血","りゅうけつ"],["の"],["報い","むくい"],["を"],["彼","かれ"],["に"],["下し","くだし"],["その"],["恥辱","ちじょく"],["を"],["彼","かれ"],["に"],["返される","かえされる"],["。"]]}]
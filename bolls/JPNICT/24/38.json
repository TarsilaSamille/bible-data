[{"verse":1,"text":"マタンの子シェファトヤ、パシュフルの子ゲダルヤ、シェレムヤの子ユカル、マルキヤの子パシュフルは、エレミヤがすべての民に次のように語っているのを聞いた。","tok":[["マタン"],["の"],["子","こ"],["シェファトヤ"],["、"],["パシュフル"],["の"],["子","こ"],["ゲダルヤ"],["、"],["シェレムヤ"],["の"],["子","こ"],["ユカル"],["、"],["マルキヤ"],["の"],["子","こ"],["パシュフル"],["は"],["、"],["エレミヤ"],["が"],["すべて"],["の"],["民","たみ"],["に"],["次","つぎ"],["の"],["よう"],["に"],["語って","かたって"],["いる"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"「主はこう言われる。この都にとどまる者は、剣、飢饉、疫病で死ぬ。しかし、出てカルデア軍に投降する者は生き残る。命だけは助かって生き残る。","tok":[["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["この"],["都","と"],["に"],["とどまる"],["者","もの"],["は"],["、"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["疫病","やくびょう"],["で"],["死ぬ","しぬ"],["。"],["しかし"],["、"],["出て","でて"],["カルデア"],["軍","ぐん"],["に"],["投降","とうこう"],["する"],["者","もの"],["は"],["生き残る","いきのこる"],["。"],["命","いのち"],["だけ"],["は"],["助かって","たすかって"],["生き残る","いきのこる"],["。"]]},{"verse":3,"text":"主はこう言われる。この都は必ずバビロンの王の軍隊の手に落ち、占領される。」","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["この"],["都","と"],["は"],["必ず","かならず"],["バビロン"],["の"],["王","おう"],["の"],["軍隊","ぐんたい"],["の"],["手","て"],["に"],["落ち","おち"],["、"],["占領","せんりょう"],["される"],["。"],["」"]]},{"verse":4,"text":"役人たちは王に言った。「どうか、この男を死刑にしてください。あのようなことを言いふらして、この都に残った兵士と民衆の士気を挫いています。この民のために平和を願わず、むしろ災いを望んでいるのです。」","tok":[["役人","やくにん"],["たち"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["この"],["男","おとこ"],["を"],["死刑","しけい"],["に"],["して"],["ください"],["。"],["あの"],["よう"],["な"],["こと"],["を"],["言いふらして","いいふらして"],["、"],["この"],["都","と"],["に"],["残った","のこった"],["兵士","へいし"],["と"],["民衆","みんしゅう"],["の"],["士気","しき"],["を"],["挫いて","くじいて"],["います"],["。"],["この"],["民","たみ"],["の"],["ため"],["に"],["平和","へいわ"],["を"],["願わず","ねがわず"],["、"],["むしろ"],["災い","わざわい"],["を"],["望んで","のぞんで"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":5,"text":"ゼデキヤ王は答えた。「あの男のことはお前たちに任せる。王であっても、お前たちの意に反しては何もできないのだから。」","tok":[["ゼデキヤ"],["王","おう"],["は"],["答えた","こたえた"],["。"],["「"],["あの"],["男","おとこ"],["の"],["こと"],["は"],["お前","おまえ"],["たち"],["に"],["任せる","まかせる"],["。"],["王","おう"],["で"],["あって"],["も"],["、"],["お前","おまえ"],["たち"],["の"],["意","い"],["に"],["反して","はんして"],["は"],["何","なん"],["も"],["できない"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":6,"text":"そこで、役人たちはエレミヤを捕らえ、監視の庭にある王子マルキヤの水溜めへ綱でつり降ろした。水溜めには水がなく泥がたまっていたので、エレミヤは泥の中に沈んだ。","tok":[["そこ"],["で"],["、"],["役人","やくにん"],["たち"],["は"],["エレミヤ"],["を"],["捕らえ","とらえ"],["、"],["監視","かんし"],["の"],["庭","にわ"],["に"],["ある"],["王子","おうじ"],["マルキヤ"],["の"],["水溜め","みずだめ"],["へ"],["綱","つな"],["で"],["つり"],["降ろした","おろした"],["。"],["水溜め","みずだめ"],["に"],["は"],["水","みず"],["が"],["なく"],["泥","どろ"],["が"],["たまって"],["いた"],["ので"],["、"],["エレミヤ"],["は"],["泥","どろ"],["の"],["中","なか"],["に"],["沈んだ","しずんだ"],["。"]]},{"verse":7,"text":"宮廷にいたクシュ人の宦官エベド‧メレクは、エレミヤが水溜めに投げ込まれたことを聞いた。そのとき、王はベニヤミン門の広場に座していた。","tok":[["宮廷","きゅうてい"],["に"],["いた"],["クシュ人","くしゅにん"],["の"],["宦官","かんがん"],["エベド"],["‧"],["メレク"],["は"],["、"],["エレミヤ"],["が"],["水溜め","みずだめ"],["に"],["投げ込まれた","なげこまれた"],["こと"],["を"],["聞いた","きいた"],["。"],["その"],["とき"],["、"],["王","おう"],["は"],["ベニヤミン"],["門","もん"],["の"],["広場","ひろば"],["に"],["座して","ざして"],["いた"],["。"]]},{"verse":8,"text":"エベド‧メレクは宮廷を出て王に訴えた。","tok":[["エベド"],["‧"],["メレク"],["は"],["宮廷","きゅうてい"],["を"],["出て","でて"],["王","おう"],["に"],["訴えた","うったえた"],["。"]]},{"verse":9,"text":"「王様、この人々は、預言者エレミヤにありとあらゆるひどいことをしています。彼を水溜めに投げ込みました。エレミヤはそこで飢えて死んでしまいます。もう都にはパンがなくなりましたから。」","tok":[["「"],["王様","おうさま"],["、"],["この"],["人々","ひとびと"],["は"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["あり"],["と"],["あらゆる"],["ひどい"],["こと"],["を"],["して"],["います"],["。"],["彼","かれ"],["を"],["水溜め","みずだめ"],["に"],["投げ込みました","なげこみました"],["。"],["エレミヤ"],["は"],["そこ"],["で"],["飢えて","うえて"],["死んで","しんで"],["しまいます"],["。"],["もう"],["都","と"],["に"],["は"],["パン"],["が"],["なくなりました"],["から"],["。"],["」"]]},{"verse":10,"text":"王はクシュ人エベド‧メレクに、「ここから三十人の者を連れて行き、預言者エレミヤが死なないうちに、水溜めから引き上げるがよい」と命じた。","tok":[["王","おう"],["は"],["クシュ人","くしゅにん"],["エベド"],["‧"],["メレク"],["に"],["、"],["「"],["ここ"],["から"],["三","さん"],["十人","じゅうにん"],["の"],["者","もの"],["を"],["連れて","つれて"],["行き","いき"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["が"],["死なない","しなない"],["うち"],["に"],["、"],["水溜め","みずだめ"],["から"],["引き上げる","ひきあげる"],["が"],["よい"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":11,"text":"エベド‧メレクはその人々を連れて宮廷に帰り、倉庫の下から古着やぼろ切れを取って来て、それを綱で水溜めの中のエレミヤにつり降ろした。","tok":[["エベド"],["‧"],["メレク"],["は"],["その"],["人々","ひとびと"],["を"],["連れて","つれて"],["宮廷","きゅうてい"],["に"],["帰り","かえり"],["、"],["倉庫","そうこ"],["の"],["下","した"],["から"],["古着","ふるぎ"],["や"],["ぼろ切れ","ぼろきれ"],["を"],["取って","とって"],["来て","きて"],["、"],["それ"],["を"],["綱","つな"],["で"],["水溜め","みずだめ"],["の"],["中","なか"],["の"],["エレミヤ"],["に"],["つり"],["降ろした","おろした"],["。"]]},{"verse":12,"text":"クシュ人エベド‧メレクはエレミヤに言った。「古着とぼろ切れを脇の下にはさんで、綱にあてがいなさい。」エレミヤはそのとおりにした。","tok":[["クシュ人","くしゅにん"],["エベド"],["‧"],["メレク"],["は"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["古着","ふるぎ"],["と"],["ぼろ切れ","ぼろきれ"],["を"],["脇の下","わきのした"],["に"],["はさんで"],["、"],["綱","つな"],["に"],["あてがい"],["なさい"],["。"],["」"],["エレミヤ"],["は"],["その"],["とおり"],["に"],["した"],["。"]]},{"verse":13,"text":"そこで、彼らはエレミヤを水溜めから綱で引き上げた。そして、エレミヤは監視の庭に留めて置かれた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["エレミヤ"],["を"],["水溜め","みずだめ"],["から"],["綱","つな"],["で"],["引き上げた","ひきあげた"],["。"],["そして"],["、"],["エレミヤ"],["は"],["監視","かんし"],["の"],["庭","にわ"],["に"],["留めて","とめて"],["置かれた","おかれた"],["。"]]},{"verse":14,"text":"ゼデキヤ王は使者を遣わして、預言者エレミヤを主の神殿の第三の入り口にいる自分のもとに連れて来させ、「あなたに尋ねたいことがある。何も隠さずに話してくれ」と言った。","tok":[["ゼデキヤ"],["王","おう"],["は"],["使者","ししゃ"],["を"],["遣わして","つかわして"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["を"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["第","だい"],["三","さん"],["の"],["入り口","いりぐち"],["に"],["いる"],["自分","じぶん"],["の"],["もと"],["に"],["連れて","つれて"],["来させ","きさせ"],["、"],["「"],["あなた"],["に"],["尋ねたい","たずねたい"],["こと"],["が"],["ある"],["。"],["何","なん"],["も"],["隠さず","かくさず"],["に"],["話して","はなして"],["くれ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"エレミヤはゼデキヤに答えた。「もし、わたしが率直に申し上げれば、あなたはわたしを殺そうとされるのではないですか。仮に進言申し上げても、お聞きにはなりますまい。」","tok":[["エレミヤ"],["は"],["ゼデキヤ"],["に"],["答えた","こたえた"],["。"],["「"],["もし"],["、"],["わたし"],["が"],["率直","そっちょく"],["に"],["申し上げれば","もうしあげれば"],["、"],["あなた"],["は"],["わたし"],["を"],["殺そう","ころそう"],["と"],["される"],["ので"],["は"],["ないです"],["か"],["。"],["仮","かり"],["に"],["進言","しんげん"],["申し上げて","もうしあげて"],["も"],["、"],["お聞き","おきき"],["に"],["は"],["なりますまい"],["。"],["」"]]},{"verse":16,"text":"ゼデキヤ王はエレミヤにひそかに誓って言った。「我々の命を造られた主にかけて誓う。わたしはあなたを決して殺さない。またあなたの命をねらっている人々に引き渡したりはしない。」","tok":[["ゼデキヤ"],["王","おう"],["は"],["エレミヤ"],["に"],["ひそか"],["に"],["誓って","ちかって"],["言った","いった"],["。"],["「"],["我々","われわれ"],["の"],["命","いのち"],["を"],["造られた","つくられた"],["主","ぬし"],["に"],["かけて"],["誓う","ちかう"],["。"],["わたし"],["は"],["あなた"],["を"],["決して","けっして"],["殺さない","ころさない"],["。"],["また"],["あなた"],["の"],["命","いのち"],["を"],["ねらって"],["いる"],["人々","ひとびと"],["に"],["引き渡し","ひきわたし"],["たり"],["は"],["しない"],["。"],["」"]]},{"verse":17,"text":"そこで、エレミヤはゼデキヤに言った。「イスラエルの神、万軍の神なる主はこう言われる。もし、あなたがバビロンの王の将軍たちに降伏するなら、命は助かり、都は火で焼かれずに済む。また、あなたは家族と共に生き残る。","tok":[["そこ"],["で"],["、"],["エレミヤ"],["は"],["ゼデキヤ"],["に"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["なる"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["もし"],["、"],["あなた"],["が"],["バビロン"],["の"],["王","おう"],["の"],["将軍","しょうぐん"],["たち"],["に"],["降伏","こうふく"],["するなら"],["、"],["命","いのち"],["は"],["助かり","たすかり"],["、"],["都","と"],["は"],["火","ひ"],["で"],["焼かれず","やかれず"],["に"],["済む","すむ"],["。"],["また"],["、"],["あなた"],["は"],["家族","かぞく"],["と"],["共","とも"],["に"],["生き残る","いきのこる"],["。"]]},{"verse":18,"text":"しかし、もしバビロンの王の将軍たちに降伏しないなら、都はカルデア軍の手に渡り、火で焼かれ、あなたは彼らの手から逃れることはできない。」","tok":[["しかし"],["、"],["もし"],["バビロン"],["の"],["王","おう"],["の"],["将軍","しょうぐん"],["たち"],["に"],["降伏","こうふく"],["しないなら"],["、"],["都","と"],["は"],["カルデア"],["軍","ぐん"],["の"],["手","て"],["に"],["渡り","わたり"],["、"],["火","ひ"],["で"],["焼かれ","やかれ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["逃れる","のがれる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":19,"text":"ゼデキヤ王はエレミヤに言った。「わたしが恐れているのは、既にカルデア軍のもとに脱走したユダの人々である。彼らに引き渡されると、わたしはなぶりものにされるかもしれない。」","tok":[["ゼデキヤ"],["王","おう"],["は"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["が"],["恐れて","おそれて"],["いる"],["の"],["は"],["、"],["既に","すでに"],["カルデア"],["軍","ぐん"],["の"],["もと"],["に"],["脱走","だっそう"],["した"],["ユダ"],["の"],["人々","ひとびと"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["に"],["引き渡される","ひきわたされる"],["と"],["、"],["わたし"],["は"],["なぶりもの"],["に"],["される"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":20,"text":"そこで、エレミヤは言った。「いいえ、彼らに引き渡されることはありません。どうか、わたしが申し上げる主の声に聞き従ってください。必ず、首尾よくいき、あなたは生き長らえることができます。","tok":[["そこ"],["で"],["、"],["エレミヤ"],["は"],["言った","いった"],["。"],["「"],["いいえ"],["、"],["彼","かれ"],["ら"],["に"],["引き渡される","ひきわたされる"],["こと"],["は"],["ありません"],["。"],["どう"],["か"],["、"],["わたし"],["が"],["申し上げる","もうしあげる"],["主","ぬし"],["の"],["声","こえ"],["に"],["聞き従って","ききしたがって"],["ください"],["。"],["必ず","かならず"],["、"],["首尾","しゅび"],["よく"],["いき"],["、"],["あなた"],["は"],["生き長らえる","いきながらえる"],["こと"],["が"],["できます"],["。"]]},{"verse":21,"text":"もし降伏することを拒否するならこうなる、と主がわたしに示されました。","tok":[["もし"],["降伏","こうふく"],["する"],["こと"],["を"],["拒否","きょひ"],["するなら"],["こう"],["なる"],["、"],["と"],["主","ぬし"],["が"],["わたし"],["に"],["示されました","しめされました"],["。"]]},{"verse":22,"text":"ユダの王宮に残っている女たちは皆、バビロンの王の将軍たちのところへ連れて行かれ、こう言うでしょう。あなたの親しい友人たちはあなたをいざない、説き伏せた。あなたの足が泥に取られると背を向け、逃げ去った。","tok":[["ユダ"],["の"],["王宮","おうきゅう"],["に"],["残って","のこって"],["いる"],["女","おんな"],["たち"],["は"],["皆","みな"],["、"],["バビロン"],["の"],["王","おう"],["の"],["将軍","しょうぐん"],["たち"],["の"],["ところ"],["へ"],["連れて","つれて"],["行かれ","いかれ"],["、"],["こう"],["言うでしょう","ゆうでしょう"],["。"],["あなた"],["の"],["親しい","したしい"],["友人","ゆうじん"],["たち"],["は"],["あなた"],["を"],["いざない"],["、"],["説き伏せた","ときふせた"],["。"],["あなた"],["の"],["足","あし"],["が"],["泥","どろ"],["に"],["取られる","とられる"],["と"],["背","せ"],["を"],["向け","むけ"],["、"],["逃げ去った","にげさった"],["。"]]},{"verse":23,"text":"王妃や、王子たちは皆、カルデア軍のもとに連れて行かれ、王御自身も彼らの手を逃れることができません。必ずバビロンの王の手に捕らえられ、都は火で焼き払われます。」","tok":[["王妃","おうひ"],["や"],["、"],["王子","おうじ"],["たち"],["は"],["皆","みな"],["、"],["カルデア"],["軍","ぐん"],["の"],["もと"],["に"],["連れて","つれて"],["行かれ","いかれ"],["、"],["王","おう"],["御自身","ごじしん"],["も"],["彼","かれ"],["ら"],["の"],["手","て"],["を"],["逃れる","のがれる"],["こと"],["が"],["できません"],["。"],["必ず","かならず"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["捕らえられ","とらえられ"],["、"],["都","と"],["は"],["火","ひ"],["で"],["焼き払われます","やきはらわれます"],["。"],["」"]]},{"verse":24,"text":"ゼデキヤ王はエレミヤに言った。「このことは、だれにも知られないようにしよう。そうすれば、あなたは殺されないで済む。","tok":[["ゼデキヤ"],["王","おう"],["は"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["この"],["こと"],["は"],["、"],["だれ"],["に"],["も"],["知られない","しられない"],["よう"],["に"],["しよう"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["殺されないで","ころされないで"],["済む","すむ"],["。"]]},{"verse":25,"text":"役人たちは、わたしがあなたと話し合ったことを聞きつければ、きっと、あなたのもとに来て、『王に何を話したのか言え。隠さずに話せ。殺しはしないから。何を王がお前に話したかを言え』と言うだろう。","tok":[["役人","やくにん"],["たち"],["は"],["、"],["わたし"],["が"],["あなた"],["と"],["話し合った","はなしあった"],["こと"],["を"],["聞きつければ","ききつければ"],["、"],["きっと"],["、"],["あなた"],["の"],["もと"],["に"],["来て","きて"],["、"],["『"],["王","おう"],["に"],["何","なん"],["を"],["話した","はなした"],["の"],["か"],["言え","いえ"],["。"],["隠さず","かくさず"],["に"],["話せ","はなせ"],["。"],["殺し","ころし"],["は"],["しない"],["から"],["。"],["何","なん"],["を"],["王","おう"],["が"],["お前","おまえ"],["に"],["話した","はなした"],["か"],["を"],["言え","いえ"],["』"],["と"],["言うだろう","ゆうだろう"],["。"]]},{"verse":26,"text":"そのときは、こう答えるがよい。『わたしは王に憐れみを乞い、ヨナタンの家に送り返さないでください。あそこでは殺されてしまいます、と言いました』と。」","tok":[["その"],["とき"],["は"],["、"],["こう"],["答える","こたえる"],["が"],["よい"],["。"],["『"],["わたし"],["は"],["王","おう"],["に"],["憐れみ","あわれみ"],["を"],["乞い","こい"],["、"],["ヨナタン"],["の"],["家","いえ"],["に"],["送り返さないで","おくりかえさないで"],["ください"],["。"],["あそこ"],["で"],["は"],["殺されて","ころされて"],["しまいます"],["、"],["と"],["言いました","いいました"],["』"],["と"],["。"],["」"]]},{"verse":27,"text":"役人たちは皆、エレミヤのもとに来て尋ねたが、エレミヤがすべて王の命じたとおりに答えたので、黙って去って行った。エレミヤが王に告げたことはついに知られなかった。","tok":[["役人","やくにん"],["たち"],["は"],["皆","みな"],["、"],["エレミヤ"],["の"],["もと"],["に"],["来て","きて"],["尋ねた","たずねた"],["が"],["、"],["エレミヤ"],["が"],["すべて"],["王","おう"],["の"],["命じた","めいじた"],["とおり"],["に"],["答えた","こたえた"],["ので"],["、"],["黙って","だまって"],["去って","さって"],["行った","いった"],["。"],["エレミヤ"],["が"],["王","おう"],["に"],["告げた","つげた"],["こと"],["は"],["ついに"],["知られなかった","しられなかった"],["。"]]},{"verse":28,"text":"エレミヤは、エルサレムが占領される日まで監視の庭に留めて置かれた。彼はエルサレムが占領されたときそこにいた。","tok":[["エレミヤ"],["は"],["、"],["エルサレム"],["が"],["占領","せんりょう"],["される"],["日","ひ"],["まで"],["監視","かんし"],["の"]
[{"verse":1,"text":"預言者エレミヤに臨んだ諸国民に対する主の言葉。","tok":[["預言者","よげんしゃ"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["諸","しょ"],["国民","こくみん"],["に"],["対する","たいする"],["主","ぬし"],["の"],["言葉","ことば"],["。"]]},{"verse":2,"text":"エジプトに向かって。すなわち、ユーフラテス河畔のカルケミシュに近い地点に出陣していたエジプトの王ファラオ‧ネコの軍隊に対する言葉。バビロンの王ネブカドレツァルは、ユダの王、ヨシヤの子ヨヤキムの第四年に彼らを撃ち破った。","tok":[["エジプト"],["に"],["向かって","むかって"],["。"],["すなわち"],["、"],["ユーフラテス"],["河畔","かはん"],["の"],["カルケミシュ"],["に"],["近い","ちかい"],["地点","ちてん"],["に"],["出陣","しゅつじん"],["して"],["いた"],["エジプト"],["の"],["王","おう"],["ファラオ"],["‧"],["ネコ"],["の"],["軍隊","ぐんたい"],["に"],["対する","たいする"],["言葉","ことば"],["。"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["は"],["、"],["ユダ"],["の"],["王","おう"],["、"],["ヨシヤ"],["の"],["子","こ"],["ヨヤキム"],["の"],["第","だい"],["四","よん"],["年","ねん"],["に"],["彼","かれ"],["ら"],["を"],["撃ち破った","うちやぶった"],["。"]]},{"verse":3,"text":"盾と大盾を取って、戦いに出よ。","tok":[["盾","たて"],["と"],["大","だい"],["盾","たて"],["を"],["取って","とって"],["、"],["戦い","たたかい"],["に"],["出よ","でよ"],["。"]]},{"verse":4,"text":"騎兵よ、鞍を置き、馬に乗れ。兜をかぶり、隊を整えよ。槍を構え、鎧を着けよ。","tok":[["騎兵","きへい"],["よ"],["、"],["鞍","くら"],["を"],["置き","おき"],["、"],["馬","うま"],["に"],["乗れ","のれ"],["。"],["兜","かぶと"],["を"],["かぶり"],["、"],["隊","たい"],["を"],["整え","ととのえ"],["よ"],["。"],["槍","やり"],["を"],["構え","かまえ"],["、"],["鎧","よろい"],["を"],["着けよ","つけよ"],["。"]]},{"verse":5,"text":"何故、彼らは隊を乱して退くのか。勇士らはちりぢりに逃げ去るのか。彼らは振り向くこともしない。恐怖が四方から迫る、と主は言われる。","tok":[["何故","なぜ"],["、"],["彼","かれ"],["ら"],["は"],["隊","たい"],["を"],["乱して","みだして"],["退く","しりぞく"],["の"],["か"],["。"],["勇士","ゆうし"],["ら"],["は"],["ちりぢり"],["に"],["逃げ去る","にげさる"],["の"],["か"],["。"],["彼","かれ"],["ら"],["は"],["振り向く","ふりむく"],["こと"],["も"],["しない"],["。"],["恐怖","きょうふ"],["が"],["四方","しほう"],["から"],["迫る","せまる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"素早い者も逃げきれず勇士も免れることはない。北で、ユーフラテス川の岸辺で彼らはよろめき倒れた。","tok":[["素早い","すばやい"],["者","もの"],["も"],["逃げ","にげ"],["きれず"],["勇士","ゆうし"],["も"],["免れる","まぬがれる"],["こと"],["は"],["ない"],["。"],["北","きた"],["で"],["、"],["ユーフラテス"],["川","かわ"],["の"],["岸辺","きしべ"],["で"],["彼","かれ"],["ら"],["は"],["よろめき"],["倒れた","たおれた"],["。"]]},{"verse":7,"text":"ナイルのように湧き上がり大河のように逆巻く者は誰か。","tok":[["ナイル"],["の"],["よう"],["に"],["湧き上がり","わきあがり"],["大河","たいが"],["の"],["よう"],["に"],["逆巻く","さかまく"],["者","もの"],["は"],["誰","だれ"],["か"],["。"]]},{"verse":8,"text":"エジプトはナイルのように湧き上がり大河のように逆巻く。彼は言う。「わたしは湧き上がって大地を覆い都とその住民を滅ぼし尽くす。","tok":[["エジプト"],["は"],["ナイル"],["の"],["よう"],["に"],["湧き上がり","わきあがり"],["大河","たいが"],["の"],["よう"],["に"],["逆巻く","さかまく"],["。"],["彼","かれ"],["は"],["言う","ゆう"],["。"],["「"],["わたし"],["は"],["湧き上がって","わきあがって"],["大地","だいち"],["を"],["覆い","おおい"],["都","と"],["と"],["その"],["住民","じゅうみん"],["を"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"]]},{"verse":9,"text":"勇士たちよ、馬に乗り戦車を駆って突進せよ。盾を取るクシュとプトの兵よ。弓を引くルドの兵よ。」","tok":[["勇士","ゆうし"],["たち"],["よ"],["、"],["馬","うま"],["に"],["乗り","のり"],["戦車","せんしゃ"],["を"],["駆って","かって"],["突進","とっしん"],["せよ"],["。"],["盾","たて"],["を"],["取る","とる"],["クシュ"],["と"],["プト"],["の"],["兵","へい"],["よ"],["。"],["弓","ゆみ"],["を"],["引く","ひく"],["ルド"],["の"],["兵","へい"],["よ"],["。"],["」"]]},{"verse":10,"text":"その日は、主なる万軍の神の日主が敵に報いられる報復の日。剣は肉を食らって飽き、血を滴らす。それは、主なる万軍の神のいけにえとなる北の地、ユーフラテスの岸辺で。","tok":[["その"],["日","ひ"],["は"],["、"],["主","おも"],["なる"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["の"],["日","ひ"],["主","ぬし"],["が"],["敵","てき"],["に"],["報いられる","むくいられる"],["報復","ほうふく"],["の"],["日","ひ"],["。"],["剣","けん"],["は"],["肉","にく"],["を"],["食らって","くらって"],["飽き","あき"],["、"],["血","ち"],["を"],["滴らす","たらす"],["。"],["それ"],["は"],["、"],["主","おも"],["なる"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["の"],["いけにえ"],["と"],["なる"],["北","きた"],["の"],["地","ち"],["、"],["ユーフラテス"],["の"],["岸辺","きしべ"],["で"],["。"]]},{"verse":11,"text":"おとめである娘エジプトよギレアドに上り、乳香を手に入れよ。いくら手当てをしても無駄だ傷がいやされることはない。","tok":[["おとめ"],["で"],["ある"],["娘","むすめ"],["エジプト"],["よ"],["ギレアド"],["に"],["上り","のぼり"],["、"],["乳香","にゅうこう"],["を"],["手","て"],["に"],["入れよ","いれよ"],["。"],["いくら"],["手当て","てあて"],["を"],["して"],["も"],["無駄","むだ"],["だ"],["傷","きず"],["が"],["いやされる"],["こと"],["は"],["ない"],["。"]]},{"verse":12,"text":"諸国民はお前が辱められるのを聞いた。お前の悲鳴は地を満たす。勇士は勇士と共によろめき、もろともに倒れる。","tok":[["諸","しょ"],["国民","こくみん"],["は"],["お前","おまえ"],["が"],["辱められる","はずかしめられる"],["の"],["を"],["聞いた","きいた"],["。"],["お前","おまえ"],["の"],["悲鳴","ひめい"],["は"],["地","ち"],["を"],["満たす","みたす"],["。"],["勇士","ゆうし"],["は"],["勇士","ゆうし"],["と"],["共","とも"],["に"],["よろめき"],["、"],["もろとも"],["に"],["倒れる","たおれる"],["。"]]},{"verse":13,"text":"主が預言者エレミヤに語られた言葉。バビロンの王ネブカドレツァルがエジプトの国を撃つために出陣することについて。","tok":[["主","ぬし"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["語られた","かたられた"],["言葉","ことば"],["。"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["が"],["エジプト"],["の"],["国","くに"],["を"],["撃つ","うつ"],["ため"],["に"],["出陣","しゅつじん"],["する"],["こと"],["について"],["。"]]},{"verse":14,"text":"エジプトで告げ、ミグドルで知らせよ。メンフィスとタフパンヘスで知らせて言え。「隊を整え、準備せよ。剣はお前の周囲を食い尽くす。」","tok":[["エジプト"],["で"],["告げ","つげ"],["、"],["ミグドル"],["で"],["知らせ","しらせ"],["よ"],["。"],["メンフィス"],["と"],["タフパンヘス"],["で"],["知らせて","しらせて"],["言え","いえ"],["。"],["「"],["隊","たい"],["を"],["整え","ととのえ"],["、"],["準備","じゅんび"],["せよ"],["。"],["剣","けん"],["は"],["お前","おまえ"],["の"],["周囲","しゅうい"],["を"],["食い","くい"],["尽くす","つくす"],["。"],["」"]]},{"verse":15,"text":"何故、アピスは逃げたのかお前の雄牛は耐ええなかったのか。主が彼を追い払われたのだ。","tok":[["何故","なぜ"],["、"],["アピス"],["は"],["逃げた","にげた"],["の"],["か"],["お前","おまえ"],["の"],["雄牛","おうし"],["は"],["耐え","たえ"],["えなかった"],["の"],["か"],["。"],["主","ぬし"],["が"],["彼","かれ"],["を"],["追い払われた","おいはらわれた"],["の"],["だ"],["。"]]},{"verse":16,"text":"よろめき、倒れる者は多く彼らは互いに言った。「さあ、我らの民のもとへ帰ろう。脅かす剣を逃れて、生まれた国へ帰ろう。」","tok":[["よろめき"],["、"],["倒れる","たおれる"],["者","もの"],["は"],["多く","おおく"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["言った","いった"],["。"],["「"],["さあ"],["、"],["我","われ"],["ら"],["の"],["民","たみ"],["の"],["もと"],["へ"],["帰ろう","かえろう"],["。"],["脅かす","おびやかす"],["剣","けん"],["を"],["逃れて","のがれて"],["、"],["生まれた","うまれた"],["国","くに"],["へ"],["帰ろう","かえろう"],["。"],["」"]]},{"verse":17,"text":"彼らはエジプトの王ファラオの名を「騒ぎ立てるが、時期を逸する者」と呼ぶ。","tok":[["彼","かれ"],["ら"],["は"],["エジプト"],["の"],["王","おう"],["ファラオ"],["の"],["名","な"],["を"],["「"],["騒ぎ立てる","さわぎたてる"],["が"],["、"],["時期","じき"],["を"],["逸する","いっする"],["者","もの"],["」"],["と"],["呼ぶ","よぶ"],["。"]]},{"verse":18,"text":"「わたしは生きている」とその御名を万軍の主と呼ばれる王は言われる。タボルが山々の間にあるようにカルメル山が海辺にそびえているように彼は確かに来る。","tok":[["「"],["わたし"],["は"],["生きて","いきて"],["いる"],["」"],["と"],["その"],["御名","ぎょめい"],["を"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["と"],["呼ばれる","よばれる"],["王","おう"],["は"],["言われる","いわれる"],["。"],["タボル"],["が"],["山々","やまやま"],["の"],["間","あいだ"],["に"],["ある"],["よう"],["に"],["カルメル"],["山","さん"],["が"],["海辺","うみべ"],["に"],["そびえて"],["いる"],["よう"],["に"],["彼","かれ"],["は"],["確か","たしか"],["に"],["来る","くる"],["。"]]},{"verse":19,"text":"安らかに住んでいる娘エジプトよ。捕囚として行く支度をせよ。メンフィスは荒廃し焼き払われて、住む人はいなくなる。","tok":[["安らか","やすらか"],["に"],["住んで","すんで"],["いる"],["娘","むすめ"],["エジプト"],["よ"],["。"],["捕囚","ほしゅう"],["として"],["行く","いく"],["支度","したく"],["を"],["せよ"],["。"],["メンフィス"],["は"],["荒廃","こうはい"],["し"],["焼き払われて","やきはらわれて"],["、"],["住む","すむ"],["人","ひと"],["は"],["いなく"],["なる"],["。"]]},{"verse":20,"text":"エジプトは美しい雌の子牛だ。あぶが北から襲いかかる。","tok":[["エジプト"],["は"],["美しい","うつくしい"],["雌","めす"],["の"],["子牛","こうし"],["だ"],["。"],["あぶ"],["が"],["北","きた"],["から"],["襲いかかる","おそいかかる"],["。"]]},{"verse":21,"text":"彼女の中にいる傭兵も肥えた子牛のようだ。その彼らも向きを変え一斉に逃げ、耐えうるものはない。災いの日が彼らを襲い彼らの罰せられるときが来るからだ。","tok":[["彼女","かのじょ"],["の"],["中","なか"],["に"],["いる"],["傭兵","ようへい"],["も"],["肥えた","こえた"],["子牛","こうし"],["の"],["よう"],["だ"],["。"],["その"],["彼","かれ"],["ら"],["も"],["向き","むき"],["を"],["変え","かえ"],["一斉","いっせい"],["に"],["逃げ","にげ"],["、"],["耐え","たえ"],["うる"],["もの"],["は"],["ない"],["。"],["災い","わざわい"],["の"],["日","ひ"],["が"],["彼","かれ"],["ら"],["を"],["襲い","おそい"],["彼","かれ"],["ら"],["の"],["罰せられる","ばっせられる"],["とき"],["が"],["来る","くる"],["から"],["だ"],["。"]]},{"verse":22,"text":"力をもって敵が迫るときエジプトの声は蛇が逃げるように消える。敵はきこりのように斧をかざして襲いかかる。","tok":[["力","ちから"],["を"],["もって"],["敵","てき"],["が"],["迫る","せまる"],["とき"],["エジプト"],["の"],["声","こえ"],["は"],["蛇","へび"],["が"],["逃げる","にげる"],["よう"],["に"],["消える","きえる"],["。"],["敵","てき"],["は"],["きこり"],["の"],["よう"],["に"],["斧","おの"],["を"],["かざして"],["襲いかかる","おそいかかる"],["。"]]},{"verse":23,"text":"彼らはその森を切り倒す、と主は言われる。森が彼らを遮るからだ。敵の数はいなごよりも多くて、数えきれない。","tok":[["彼","かれ"],["ら"],["は"],["その"],["森","もり"],["を"],["切り倒す","きりたおす"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["森","もり"],["が"],["彼","かれ"],["ら"],["を"],["遮る","さえぎる"],["から"],["だ"],["。"],["敵","てき"],["の"],["数","かず"],["は"],["いなご"],["より"],["も"],["多くて","おおくて"],["、"],["数え","かぞえ"],["きれない"],["。"]]},{"verse":24,"text":"娘エジプトは恥を受け彼らは北からの民の手に渡された。","tok":[["娘","むすめ"],["エジプト"],["は"],["恥","はじ"],["を"],["受け","うけ"],["彼","かれ"],["ら"],["は"],["北","きた"],["から"],["の"],["民","たみ"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"]]},{"verse":25,"text":"万軍の主、イスラエルの神は言われた。「見よ、わたしはテーベの神アモンを罰する。またファラオとエジプト、その神々と王たち、ファラオと彼に頼る者を罰する。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["言われた","いわれた"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["テーベ"],["の"],["神","かみ"],["アモン"],["を"],["罰する","ばっする"],["。"],["また"],["ファラオ"],["と"],["エジプト"],["、"],["その"],["神々","かみがみ"],["と"],["王","おう"],["たち"],["、"],["ファラオ"],["と"],["彼","かれ"],["に"],["頼る","たよる"],["者","もの"],["を"],["罰する","ばっする"],["。"]]},{"verse":26,"text":"わたしは、命を求める者の手に彼らを渡す。すなわち、バビロンの王ネブカドレツァルとその家来たちの手に。その後、エジプトは昔のように人の住む所となる」と主は言われる。","tok":[["わたし"],["は"],["、"],["命","いのち"],["を"],["求める","もとめる"],["者","もの"],["の"],["手","て"],["に"],["彼","かれ"],["ら"],["を"],["渡す","わたす"],["。"],["すなわち"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["と"],["その"],["家来","けらい"],["たち"],["の"],["手","て"],["に"],["。"],["その"],["後","ご"],["、"],["エジプト"],["は"],["昔","むかし"],["の"],["よう"],["に"],["人","ひと"],["の"],["住む","すむ"],["所","ところ"],["と"],["なる"],["」"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":27,"text":"わたしの僕ヤコブよ、恐れるな。イスラエルよ、おののくな。見よ、わたしはお前を遠い地からお前の子孫を捕囚の地から救い出す。ヤコブは帰って来て、安らかに住む。彼らを脅かす者はいない。","tok":[["わたし"],["の"],["僕","ぼく"],["ヤコブ"],["よ"],["、"],["恐れる","おそれる"],["な"],["。"],["イスラエル"],["よ"],["、"],["おののく"],["な"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["を"],["遠い","とおい"],["地","ち"],["から"],["お前","おまえ"],["の"],["子孫","しそん"],["を"],["捕囚","ほしゅう"],["の"],["地","ち"],["から"],["救い出す","すくいだす"],["。"],["ヤコブ"],["は"],["帰って","かえって"],["来て","きて"],["、"],["安らか","やすらか"],["に"],["住む","すむ"],["。"],["彼","かれ"],["ら"],["を"],["脅かす","おびやかす"],["者","もの"],["は"],["いない"],["。"]]},{"verse":28,"text":"わたしの僕ヤコブよ、恐れるなと主は言われる。わたしがお前と共にいる。お前を追いやった国々をわたしは滅
,["の"],["餌食","えじき"],["と"],["した"],["。"]]},{"verse":31,"text":"この世代の者よ、見よ、これは主の言葉だ。わたしはイスラエルにとって荒れ野なのか。深い闇の地なのか。どうして、わたしの民は言うのか。「迷い出てしまったからにはあなたのもとには帰りません」と。","tok":[["この"],["世代","せだい"],["の"],["者","もの"],["よ"],["、"],["見よ","みよ"],["、"],["これ"],["は"],["主","ぬし"],["の"],["言葉","ことば"],["だ"],["。"],["わたし"],["は"],["イスラエル"],["にとって"],["荒れ野","あれの"],["な"],["の"],["か"],["。"],["深い","ふかい"],["闇","やみ"],["の"],["地","ち"],["な"],["の"],["か"],["。"],["どう"],["して"],["、"],["わたし"],["の"],["民","たみ"],["は"],["言う","いう"],["の"],["か"],["。"],["「"],["迷い出て","まよいでて"],["しまった"],["から"],["に"],["は"],["あなた"],["の"],["もと"],["に"],["は"],["帰りません","かえりません"],["」"],["と"],["。"]]},{"verse":32,"text":"おとめがその身を飾るものを花嫁が晴れ着の帯を忘れるだろうか。しかし、わたしの民はわたしを忘れ数えきれない月日が過ぎた。","tok":[["おとめ"],["が"],["その"],["身","み"],["を"],["飾る","かざる"],["もの"],["を"],["花嫁","はなよめ"],["が"],["晴れ着","はれぎ"],["の"],["帯","おび"],["を"],["忘れるだろう","わすれるだろう"],["か"],["。"],["しかし"],["、"],["わたし"],["の"],["民","たみ"],["は"],["わたし"],["を"],["忘れ","わすれ"],["数え","かぞえ"],["きれない"],["月日","つきひ"],["が"],["過ぎた","すぎた"],["。"]]},{"verse":33,"text":"なんと巧みにお前は情事を求めることか。悪い女たちにさえ、その道を教えるほどだ。","tok":[["なん"],["と"],["巧み","たくみ"],["に"],["お前","おまえ"],["は"],["情事","じょうじ"],["を"],["求める","もとめる"],["こと"],["か"],["。"],["悪い","わるい"],["女","おんな"],["たち"],["に"],["さえ"],["、"],["その"],["道","みち"],["を"],["教える","おしえる"],["ほど"],["だ"],["。"]]},{"verse":34,"text":"お前の着物の裾には罪のない貧しい者を殺した血が染みついている。それは、盗みに押し入ったときに付いたものではない。それにもかかわらず","tok":[["お前","おまえ"],["の"],["着物","きもの"],["の"],["裾","すそ"],["に"],["は"],["罪","つみ"],["の"],["ない"],["貧しい","まずしい"],["者","もの"],["を"],["殺した","ころした"],["血","ち"],["が"],["染みついて","しみついて"],["いる"],["。"],["それ"],["は"],["、"],["盗み","ぬすみ"],["に"],["押し入った","おしいった"],["とき"],["に"],["付いた","ついた"],["もの"],["で"],["は"],["ない"],["。"],["それ"],["に"],["も"],["かかわらず"]]},{"verse":35,"text":"「わたしには罪がない」とか「主の怒りはわたしから去った」とお前は言う。だが、見よ。「わたしは罪を犯していない」と言うならお前は裁きの座に引き出される。","tok":[["「"],["わたし"],["に"],["は"],["罪","つみ"],["が"],["ない"],["」"],["と"],["か"],["「"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["わたし"],["から"],["去った","さった"],["」"],["と"],["お前","おまえ"],["は"],["言う","ゆう"],["。"],["だ"],["が"],["、"],["見","み"],["よ"],["。"],["「"],["わたし"],["は"],["罪","つみ"],["を"],["犯して","おかして"],["いない"],["」"],["と"],["言うなら","ゆうなら"],["お前","おまえ"],["は"],["裁き","さばき"],["の"],["座","ざ"],["に"],["引き出される","ひきだされる"],["。"]]},{"verse":36,"text":"なんと軽率にお前は道を変えるのか。アッシリアによって辱められたようにエジプトにも辱められるであろう。","tok":[["なん"],["と"],["軽率","けいそつ"],["に"],["お前","おまえ"],["は"],["道","みち"],["を"],["変える","かえる"],["の"],["か"],["。"],["アッシリア"],["によって"],["辱められた","はずかしめられた"],["よう"],["に"],["エジプト"],["に"],["も"],["辱められるで","はずかしめられるで"],["あろう"],["。"]]},{"verse":37,"text":"そこからも、お前は両手を頭に置いて出て来る。主はお前が頼りにしているものを退けられる。彼らに頼ろうとしても成功するはずがない。","tok":[["そこ"],["から"],["も"],["、"],["お前","おまえ"],["は"],["両手","りょうて"],["を"],["頭","あたま"],["に"],["置いて","おいて"],["出て","でて"],["来る","くる"],["。"],["主","ぬし"],["は"],["お前","おまえ"],["が"],["頼り","たより"],["に"],["して"],["いる"],["もの"],["を"],["退けられる","しりぞけられる"],["。"],["彼","かれ"],["ら"],["に"],["頼ろう","たよろう"],["として"],["も"],["成功","せいこう"],["する"],["はず"],["が"],["ない"],["。"]]}]
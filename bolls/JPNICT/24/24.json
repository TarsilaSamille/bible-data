[{"verse":1,"text":"主がわたしに示された。見よ、主の神殿の前に、いちじくを盛った二つの籠が置いてあった。それは、バビロンの王ネブカドレツァルが、ユダの王、ヨヤキムの子エコンヤ、ユダの高官たち、それに工匠や鍛冶をエルサレムから捕囚としてバビロンに連れて行った後のことであった。","tok":[["主","ぬし"],["が"],["わたし"],["に"],["示された","しめされた"],["。"],["見よ","みよ"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["前","まえ"],["に"],["、"],["いちじく"],["を"],["盛った","もった"],["二","ふた"],["つ"],["の"],["籠","かご"],["が"],["置いて","おいて"],["あった"],["。"],["それ"],["は"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["が"],["、"],["ユダ"],["の"],["王","おう"],["、"],["ヨヤキム"],["の"],["子","こ"],["エコンヤ"],["、"],["ユダ"],["の"],["高官","こうかん"],["たち"],["、"],["それ"],["に"],["工匠","こうしょう"],["や"],["鍛冶","たんや"],["を"],["エルサレム"],["から"],["捕囚","ほしゅう"],["として"],["バビロン"],["に"],["連れて","つれて"],["行った","いった"],["後","あと"],["の"],["こと"],["で"],["あった"],["。"]]},{"verse":2,"text":"一つの籠には、初なりのいちじくのような、非常に良いいちじくがあり、もう一つの籠には、非常に悪くて食べられないいちじくが入っていた。","tok":[["一","ひと"],["つ"],["の"],["籠","かご"],["に"],["は"],["、"],["初なり","はつなり"],["の"],["いちじく"],["の"],["よう"],["な"],["、"],["非常","ひじょう"],["に"],["良い","よい"],["いちじく"],["が"],["あり"],["、"],["もう"],["一","ひと"],["つ"],["の"],["籠","かご"],["に"],["は"],["、"],["非常","ひじょう"],["に"],["悪くて","わるくて"],["食べられない","たべられない"],["いちじく"],["が"],["入って","はいって"],["いた"],["。"]]},{"verse":3,"text":"主はわたしに言われた。「エレミヤよ、何が見えるか。」わたしは言った。「いちじくです。良い方のいちじくは非常に良いのですが、悪い方は非常に悪くて食べられません。」","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["エレミヤ"],["よ"],["、"],["何","なん"],["が"],["見える","みえる"],["か"],["。"],["」"],["わたし"],["は"],["言った","いった"],["。"],["「"],["いちじく"],["です"],["。"],["良い","よい"],["方","ほう"],["の"],["いちじく"],["は"],["非常","ひじょう"],["に"],["良い","よい"],["の"],["です"],["が"],["、"],["悪い","わるい"],["方","ほう"],["は"],["非常","ひじょう"],["に"],["悪くて","わるくて"],["食べられません","たべられません"],["。"],["」"]]},{"verse":4,"text":"そのとき、主の言葉がわたしに臨んだ。","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":5,"text":"「イスラエルの神、主はこう言われる。このところからカルデア人の国へ送ったユダの捕囚の民を、わたしはこの良いいちじくのように見なして、恵みを与えよう。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["この"],["ところ"],["から"],["カルデア"],["人","にん"],["の"],["国","くに"],["へ"],["送った","おくった"],["ユダ"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["を"],["、"],["わたし"],["は"],["この"],["良い","よい"],["いちじく"],["の"],["よう"],["に"],["見なして","みなして"],["、"],["恵み","めぐみ"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":6,"text":"彼らに目を留めて恵みを与え、この地に連れ戻す。彼らを建てて、倒さず、植えて、抜くことはない。","tok":[["彼","かれ"],["ら"],["に"],["目","め"],["を"],["留めて","とめて"],["恵み","めぐみ"],["を"],["与え","あたえ"],["、"],["この"],["地","ち"],["に"],["連れ戻す","つれもどす"],["。"],["彼","かれ"],["ら"],["を"],["建てて","たてて"],["、"],["倒さず","たおさず"],["、"],["植えて","うえて"],["、"],["抜く","ぬく"],["こと"],["は"],["ない"],["。"]]},{"verse":7,"text":"そしてわたしは、わたしが主であることを知る心を彼らに与える。彼らはわたしの民となり、わたしは彼らの神となる。彼らは真心をもってわたしのもとへ帰って来る。","tok":[["そして"],["わたし"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["心","こころ"],["を"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["真心","まごころ"],["を"],["もって"],["わたし"],["の"],["もと"],["へ"],["帰って","かえって"],["来る","くる"],["。"]]},{"verse":8,"text":"主はまたこう言われる。ユダの王ゼデキヤとその高官たち、エルサレムの残りの者でこの国にとどまっている者、エジプトの国に住み着いた者を、非常に悪くて食べられないいちじくのようにする。","tok":[["主","ぬし"],["は"],["また"],["こう"],["言われる","いわれる"],["。"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["と"],["その"],["高官","こうかん"],["たち"],["、"],["エルサレム"],["の"],["残り","のこり"],["の"],["者","もの"],["で"],["この"],["国","くに"],["に"],["とどまって"],["いる"],["者","もの"],["、"],["エジプト"],["の"],["国","くに"],["に"],["住み着いた","すみついた"],["者","もの"],["を"],["、"],["非常","ひじょう"],["に"],["悪くて","わるくて"],["食べられない","たべられない"],["いちじく"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":9,"text":"わたしは彼らを、世界のあらゆる国々の恐怖と嫌悪の的とする。彼らはわたしが追いやるあらゆるところで、辱めと物笑いの種、嘲りと呪いの的となる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["世界","せかい"],["の"],["あらゆる"],["国々","くにぐに"],["の"],["恐怖","きょうふ"],["と"],["嫌悪","けんお"],["の"],["的","まと"],["と"],["する"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["追いやる","おいやる"],["あらゆる"],["ところ"],["で"],["、"],["辱め","はずかしめ"],["と"],["物笑い","ものわらい"],["の"],["種","しゅ"],["、"],["嘲り","あざけり"],["と"],["呪い","のろい"],["の"],["的","まと"],["と"],["なる"],["。"]]},{"verse":10,"text":"わたしは彼らに剣、飢饉、疫病を送って、わたしが彼らと父祖たちに与えた土地から滅ぼし尽くす。」","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["疫病","やくびょう"],["を"],["送って","おくって"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["と"],["父祖","ふそ"],["たち"],["に"],["与えた","あたえた"],["土地","とち"],["から"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"],["」"]]}]
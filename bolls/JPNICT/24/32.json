[{"verse":1,"text":"主からエレミヤに臨んだ言葉。ユダの王ゼデキヤの第十年、ネブカドレツァルの第十八年のことであった。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["第","だい"],["十","じゅう"],["年","ねん"],["、"],["ネブカドレツァル"],["の"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["の"],["こと"],["で"],["あった"],["。"]]},{"verse":2,"text":"そのとき、バビロンの王の軍隊がエルサレムを包囲していた。預言者エレミヤは、ユダの王の宮殿にある獄舎に拘留されていた。","tok":[["その"],["とき"],["、"],["バビロン"],["の"],["王","おう"],["の"],["軍隊","ぐんたい"],["が"],["エルサレム"],["を"],["包囲","ほうい"],["して"],["いた"],["。"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["、"],["ユダ"],["の"],["王","おう"],["の"],["宮殿","きゅうでん"],["に"],["ある"],["獄舎","ごくしゃ"],["に"],["拘留","こうりゅう"],["されて"],["いた"],["。"]]},{"verse":3,"text":"ユダの王ゼデキヤが、「なぜ、お前はこんなことを預言するのか」と言って、彼を拘留したのである。エレミヤの預言はこうである。「主はこう言われる。見よ、わたしはこの都をバビロンの王の手に渡す。彼はこの町を占領する。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["が"],["、"],["「"],["なぜ"],["、"],["お前","おまえ"],["は"],["こんな"],["こと"],["を"],["預言","よげん"],["する"],["の"],["か"],["」"],["と"],["言って","いって"],["、"],["彼","かれ"],["を"],["拘留","こうりゅう"],["した"],["ので"],["ある"],["。"],["エレミヤ"],["の"],["預言","よげん"],["は"],["こう"],["で"],["ある"],["。"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["都","と"],["を"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["この"],["町","まち"],["を"],["占領","せんりょう"],["する"],["。"]]},{"verse":4,"text":"ユダの王ゼデキヤはカルデア人の手から逃げることはできない。彼は必ずバビロンの王の手に渡され、王の前に引き出されて直接尋問される。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["は"],["カルデア"],["人","にん"],["の"],["手","て"],["から"],["逃げる","にげる"],["こと"],["は"],["できない"],["。"],["彼","かれ"],["は"],["必ず","かならず"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["引き出されて","ひきだされて"],["直接","ちょくせつ"],["尋問","じんもん"],["される"],["。"]]},{"verse":5,"text":"ゼデキヤはバビロンへ連行され、わたしが彼を顧みるときまで、そこにとどめ置かれるであろう、と主は言われる。お前たちはカルデア人と戦っても、決して勝つことはできない。」","tok":[["ゼデキヤ"],["は"],["バビロン"],["へ"],["連行","れんこう"],["され"],["、"],["わたし"],["が"],["彼","かれ"],["を"],["顧みる","かえりみる"],["とき"],["まで"],["、"],["そこ"],["に"],["とどめ"],["置かれるで","おかれるで"],["あろう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["カルデア"],["人","にん"],["と"],["戦って","たたかって"],["も"],["、"],["決して","けっして"],["勝つ","かつ"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":6,"text":"さて、エレミヤは言った。「主の言葉がわたしに臨んだ。","tok":[["さて"],["、"],["エレミヤ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":7,"text":"見よ、お前の伯父シャルムの子ハナムエルが、お前のところに来て、『アナトトにあるわたしの畑を買い取ってください。あなたが、親族として買い取り、所有する権利があるのです』と言うであろう。」","tok":[["見よ","みよ"],["、"],["お前","おまえ"],["の"],["伯父","おじ"],["シャルム"],["の"],["子","こ"],["ハナムエル"],["が"],["、"],["お前","おまえ"],["の"],["ところ"],["に"],["来て","きて"],["、"],["『"],["アナトト"],["に"],["ある"],["わたし"],["の"],["畑","はたけ"],["を"],["買い取って","かいとって"],["ください"],["。"],["あなた"],["が"],["、"],["親族","しんぞく"],["として"],["買い取り","かいとり"],["、"],["所有","しょゆう"],["する"],["権利","けんり"],["が"],["ある"],["の"],["です"],["』"],["と"],["言うで","ゆうで"],["あろう"],["。"],["」"]]},{"verse":8,"text":"主の言葉どおり、いとこのハナムエルが獄舎にいるわたしのところに来て言った。「ベニヤミン族の所領に属する、アナトトの畑を買い取ってください。あなたに親族として相続し所有する権利があるのですから、どうか買い取ってください。」わたしは、これが主の言葉によることを知っていた。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["どおり"],["、"],["いとこ"],["の"],["ハナムエル"],["が"],["獄舎","ごくしゃ"],["に"],["いる"],["わたし"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["ベニヤミン"],["族","ぞく"],["の"],["所領","しょりょう"],["に"],["属する","ぞくする"],["、"],["アナトト"],["の"],["畑","はたけ"],["を"],["買い取って","かいとって"],["ください"],["。"],["あなた"],["に"],["親族","しんぞく"],["として"],["相続","そうぞく"],["し"],["所有","しょゆう"],["する"],["権利","けんり"],["が"],["ある"],["の"],["です"],["から"],["、"],["どう"],["か"],["買い取って","かいとって"],["ください"],["。"],["」"],["わたし"],["は"],["、"],["これ"],["が"],["主","ぬし"],["の"],["言葉","ことば"],["に"],["よる"],["こと"],["を"],["知って","しって"],["いた"],["。"]]},{"verse":9,"text":"そこで、わたしはいとこのハナムエルからアナトトにある畑を買い取り、銀十七シェケルを量って支払った。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["いとこ"],["の"],["ハナムエル"],["から"],["アナトト"],["に"],["ある"],["畑","はたけ"],["を"],["買い取り","かいとり"],["、"],["銀","ぎん"],["十七","じゅうなな"],["シェケル"],["を"],["量って","はかって"],["支払った","しはらった"],["。"]]},{"verse":10,"text":"わたしは、証書を作成して、封印し、証人を立て、銀を秤で量った。","tok":[["わたし"],["は"],["、"],["証書","しょうしょ"],["を"],["作成","さくせい"],["して"],["、"],["封印","ふういん"],["し"],["、"],["証人","しょうにん"],["を"],["立て","たて"],["、"],["銀","ぎん"],["を"],["秤","はかり"],["で"],["量った","はかった"],["。"]]},{"verse":11,"text":"そしてわたしは、定められた慣習どおり、封印した購入証書と、封印されていない写しを取って、","tok":[["そして"],["わたし"],["は"],["、"],["定められた","さだめられた"],["慣習","かんしゅう"],["どおり"],["、"],["封印","ふういん"],["した"],["購入","こうにゅう"],["証書","しょうしょ"],["と"],["、"],["封印","ふういん"],["されて"],["いない"],["写し","うつし"],["を"],["取って","とって"],["、"]]},{"verse":12,"text":"マフセヤの孫であり、ネリヤの子であるバルクにそれを手渡した。いとこのハナムエルと、購入証書に署名した証人たちと、獄舎にいたユダの人々全員がそれを見ていた。","tok":[["マフセヤ"],["の"],["孫","まご"],["で"],["あり"],["、"],["ネリヤ"],["の"],["子","こ"],["で"],["ある"],["バルク"],["に"],["それ"],["を"],["手渡した","てわたした"],["。"],["いとこ"],["の"],["ハナムエル"],["と"],["、"],["購入","こうにゅう"],["証書","しょうしょ"],["に"],["署名","しょめい"],["した"],["証人","しょうにん"],["たち"],["と"],["、"],["獄舎","ごくしゃ"],["に"],["いた"],["ユダ"],["の"],["人々","ひとびと"],["全員","ぜんいん"],["が"],["それ"],["を"],["見て","みて"],["いた"],["。"]]},{"verse":13,"text":"そして、彼らの見ている前でバルクに命じた。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["バルク"],["に"],["命じた","めいじた"],["。"]]},{"verse":14,"text":"「イスラエルの神、万軍の主はこう言われる。これらの証書、すなわち、封印した購入証書と、その写しを取り、素焼きの器に納めて長く保存せよ。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["これ"],["ら"],["の"],["証書","しょうしょ"],["、"],["すなわち"],["、"],["封印","ふういん"],["した"],["購入","こうにゅう"],["証書","しょうしょ"],["と"],["、"],["その"],["写し","うつし"],["を"],["取り","とり"],["、"],["素焼き","すやき"],["の"],["器","うつわ"],["に"],["納めて","おさめて"],["長く","ながく"],["保存","ほぞん"],["せよ"],["。"]]},{"verse":15,"text":"イスラエルの神、万軍の主が、『この国で家、畑、ぶどう園を再び買い取る時が来る』と言われるからだ。」","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["、"],["『"],["この"],["国","くに"],["で"],["家","いえ"],["、"],["畑","はたけ"],["、"],["ぶどう園","ぶどうえん"],["を"],["再び","ふたたび"],["買い取る","かいとる"],["時","とき"],["が"],["来る","くる"],["』"],["と"],["言われる","いわれる"],["から"],["だ"],["。"],["」"]]},{"verse":16,"text":"購入証書をネリヤの子バルクに渡したあとで、わたしは主に祈った。","tok":[["購入","こうにゅう"],["証書","しょうしょ"],["を"],["ネリヤ"],["の"],["子","こ"],["バルク"],["に"],["渡した","わたした"],["あと"],["で"],["、"],["わたし"],["は"],["主に","おもに"],["祈った","いのった"],["。"]]},{"verse":17,"text":"「ああ、主なる神よ、あなたは大いなる力を振るい、腕を伸ばして天と地を造られました。あなたの御力の及ばない事は何一つありません。","tok":[["「"],["ああ"],["、"],["主","おも"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["大いなる","おおいなる"],["力","ちから"],["を"],["振るい","ふるい"],["、"],["腕","うで"],["を"],["伸ばして","のばして"],["天","てん"],["と"],["地","ち"],["を"],["造られました","つくられました"],["。"],["あなた"],["の"],["御力","おちから"],["の"],["及ばない","およばない"],["事","こと"],["は"],["何","なん"],["一","ひと"],["つ"],["ありません"],["。"]]},{"verse":18,"text":"あなたは恵みを幾千代に及ぼし、父祖の罪を子孫の身に報いられます。大いなる神、力ある神、その御名は万軍の主。","tok":[["あなた"],["は"],["恵み","めぐみ"],["を"],["幾","いく"],["千代","ちよ"],["に"],["及ぼし","およぼし"],["、"],["父祖","ふそ"],["の"],["罪","つみ"],["を"],["子孫","しそん"],["の"],["身","み"],["に"],["報いられます","むくいられます"],["。"],["大いなる","おおいなる"],["神","かみ"],["、"],["力","ちから"],["ある"],["神","かみ"],["、"],["その"],["御名","ぎょめい"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["。"]]},{"verse":19,"text":"その謀は偉大であり、御業は力強い。あなたの目は人の歩みをすべて御覧になり、各人の道、行いの実りに応じて報いられます。","tok":[["その"],["謀","はかりごと"],["は"],["偉大","いだい"],["で"],["あり"],["、"],["御業","ごぎょう"],["は"],["力強い","ちからづよい"],["。"],["あなた"],["の"],["目","め"],["は"],["人","ひと"],["の"],["歩み","あゆみ"],["を"],["すべて"],["御覧","ごらん"],["に"],["なり"],["、"],["各人","かくじん"],["の"],["道","みち"],["、"],["行い","おこない"],["の"],["実り","みのり"],["に"],["応じて","おうじて"],["報いられます","むくいられます"],["。"]]},{"verse":20,"text":"あなたはエジプトの国で現されたように今日に至るまで、イスラエルをはじめ全人類に対してしるしと奇跡を現し、今日のように御名があがめられるようにされました。","tok":[["あなた"],["は"],["エジプト"],["の"],["国","くに"],["で"],["現された","あらわされた"],["よう"],["に"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["イスラエル"],["を"],["はじめ"],["全","ぜん"],["人類","じんるい"],["に対して","にたいして"],["しるし"],["と"],["奇跡","きせき"],["を"],["現し","あらわし"],["、"],["今日","きょう"],["の"],["よう"],["に"],["御名","ぎょめい"],["が"],["あがめられる"],["よう"],["に"],["されました"],["。"]]},{"verse":21,"text":"あなたは、しるしと奇跡をもって強い力を振るい、腕を伸ばして大いなる恐れを与え、あなたの民イスラエルをエジプトの国から導き出されました。","tok":[["あなた"],["は"],["、"],["しるし"],["と"],["奇跡","きせき"],["を"],["もって"],["強い","つよい"],["力","ちから"],["を"],["振るい","ふるい"],["、"],["腕","うで"],["を"],["伸ばして","のばして"],["大いなる","おおいなる"],["恐れ","おそれ"],["を"],["与え","あたえ"],["、"],["あなた"],["の"],["民","みん"],["イスラエル"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出されました","みちびきだされました"],["。"]]},{"verse":22,"text":"そして、かつて先祖に誓われたとおり、この土地を彼らに賜りました。乳と蜜の流れるこの土地です。","tok":[["そして"],["、"],["かつて"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["とおり"],["、"],["この"],["土地","とち"],["を"],["彼","かれ"],["ら"],["に"],["賜りました","たまわりました"],["。"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["この"],["土地","とち"],["です"],["。"]]},{"verse":23,"text":"ところが、彼らはここに来て、土地を所有すると、あなたの声に聞き従わず、またあなたの律法に従って歩まず、あなたが命じられたことを何一つ行わなかったので、あなたは彼らにこの災いをくだされました。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["は"],["ここ"],["に"],["来て","きて"],["、"],["土地","とち"],["を"],["所有","しょゆう"],["する"],["と"],["、"],["あなた"],["の"],["声","こえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["また"],["あなた"],["の"],["律法","りっぽう"],["に"],["従って","したがって"],["歩まず","あゆまず"],["、"],["あなた"],["が"],["命じられた","めいじられた"],["こと"],["を"],["何","なん"],["一","ひと"],["つ"],["行わなかった","おこなわなかった"],["ので"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["この"],["災い","わざわい"],["を"],["くだされました"],["。"]]},{"verse":24,"text":"今や、この都を攻め落とそうとして、城攻めの土塁が築かれています。間もなくこの都は剣、飢饉、疫病のゆえに、攻め囲んでいるカルデア人の手に落ちようとしています。あなたの御言葉どおりになっていることは、御覧のとおりです。","tok":[["今","いま"],["や"],["、"],["この"],["都","と"],["を"],["攻め落とそう","せめおとそう"],["として"],["、"],["城攻め","しろぜめ"],["の"],["土塁","どるい"],["が"],["築かれて","きずかれて"],["います"],["。"],["間","ま"],["も"],["なく"],["この"],["都","と"],["は"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["疫病","やくびょう"],["の"],["ゆえ"],["に"],["、"],["攻め囲んで","せめかこんで"],["いる"],["カルデア"],["人","にん"],["の"],["手","て"],["に"],["落ちよう","おちよう"],["として"],["います"],["。"],["あなた"],["の"],["御言葉","おことば"],["どおり"],["に"],["なって"],["いる"],["こと"],["は"],["、"],["御覧","ごらん"],["の"],["とおり"],["です"],["。"]]},{"verse":25,"text":"それにもかかわらず、主なる神よ、あなたはわたしに、『銀で畑を買い、証人を立てよ』と言われました。この都がカルデア人の手に落ちようとしているこのときにです。」","tok":[["それ"],["に"],["も"],["かかわらず"],["、"],["主","おも"],["なる"],["神","かみ"],["よ"],["、"],[
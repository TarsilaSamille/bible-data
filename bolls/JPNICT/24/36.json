[{"verse":1,"text":"ユダの王、ヨシヤの子ヨヤキムの第四年に、次の言葉が主からエレミヤに臨んだ。","tok":[["ユダ"],["の"],["王","おう"],["、"],["ヨシヤ"],["の"],["子","こ"],["ヨヤキム"],["の"],["第","だい"],["四","よん"],["年","ねん"],["に"],["、"],["次","つぎ"],["の"],["言葉","ことば"],["が"],["主","ぬし"],["から"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「巻物を取り、わたしがヨシヤの時代から今日に至るまで、イスラエルとユダ、および諸国について、あなたに語ってきた言葉を残らず書き記しなさい。","tok":[["「"],["巻物","まきもの"],["を"],["取り","とり"],["、"],["わたし"],["が"],["ヨシヤ"],["の"],["時代","じだい"],["から"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["イスラエル"],["と"],["ユダ"],["、"],["および"],["諸国","しょこく"],["について"],["、"],["あなた"],["に"],["語って","かたって"],["きた"],["言葉","ことば"],["を"],["残らず","のこらず"],["書き記し","かきしるし"],["なさい"],["。"]]},{"verse":3,"text":"ユダの家は、わたしがくだそうと考えているすべての災いを聞いて、それぞれ悪の道から立ち帰るかもしれない。そうすれば、わたしは彼らの罪と咎を赦す。」","tok":[["ユダ"],["の"],["家","いえ"],["は"],["、"],["わたし"],["が"],["くだそう"],["と"],["考えて","かんがえて"],["いる"],["すべて"],["の"],["災い","わざわい"],["を"],["聞いて","きいて"],["、"],["それぞれ"],["悪","わる"],["の"],["道","みち"],["から"],["立ち帰る","たちかえる"],["か"],["も"],["しれない"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["と"],["咎","とが"],["を"],["赦す","ゆるす"],["。"],["」"]]},{"verse":4,"text":"エレミヤはネリヤの子バルクを呼び寄せた。バルクはエレミヤの口述に従って、主が語られた言葉をすべて巻物に書き記した。","tok":[["エレミヤ"],["は"],["ネリヤ"],["の"],["子","こ"],["バルク"],["を"],["呼び寄せた","よびよせた"],["。"],["バルク"],["は"],["エレミヤ"],["の"],["口述","こうじゅつ"],["に"],["従って","したがって"],["、"],["主","ぬし"],["が"],["語られた","かたられた"],["言葉","ことば"],["を"],["すべて"],["巻物","まきもの"],["に"],["書き記した","かきしるした"],["。"]]},{"verse":5,"text":"エレミヤはバルクに命じた。「わたしは主の神殿に入ることを禁じられている。","tok":[["エレミヤ"],["は"],["バルク"],["に"],["命じた","めいじた"],["。"],["「"],["わたし"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["入る","はいる"],["こと"],["を"],["禁じられて","きんじられて"],["いる"],["。"]]},{"verse":6,"text":"お前は断食の日に行って、わたしが口述したとおりに書き記したこの巻物から主の言葉を読み、神殿に集まった人々に聞かせなさい。また、ユダの町々から上って来るすべての人々にも読み聞かせなさい。","tok":[["お前","おまえ"],["は"],["断食","だんじき"],["の"],["日","ひ"],["に"],["行って","いって"],["、"],["わたし"],["が"],["口述","こうじゅつ"],["した"],["とおり"],["に"],["書き記した","かきしるした"],["この"],["巻物","まきもの"],["から"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["読み","よみ"],["、"],["神殿","しんでん"],["に"],["集まった","あつまった"],["人々","ひとびと"],["に"],["聞かせ","きかせ"],["なさい"],["。"],["また"],["、"],["ユダ"],["の"],["町々","まちまち"],["から"],["上って","のぼって"],["来る","くる"],["すべて"],["の"],["人々","ひとびと"],["に"],["も"],["読み聞かせ","よみきかせ"],["なさい"],["。"]]},{"verse":7,"text":"この民に向かって告げられた主の怒りと憤りが大きいことを知って、人々が主に憐れみを乞い、それぞれ悪の道から立ち帰るかもしれない。」","tok":[["この"],["民","たみ"],["に"],["向かって","むかって"],["告げられた","つげられた"],["主","ぬし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["が"],["大きい","おおきい"],["こと"],["を"],["知って","しって"],["、"],["人々","ひとびと"],["が"],["主に","おもに"],["憐れみ","あわれみ"],["を"],["乞い","こい"],["、"],["それぞれ"],["悪","わる"],["の"],["道","みち"],["から"],["立ち帰る","たちかえる"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":8,"text":"そこで、ネリヤの子バルクは、預言者エレミヤが命じたとおり、巻物に記された主の言葉を主の神殿で読んだ。","tok":[["そこ"],["で"],["、"],["ネリヤ"],["の"],["子","こ"],["バルク"],["は"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["が"],["命じた","めいじた"],["とおり"],["、"],["巻物","まきもの"],["に"],["記された","しるされた"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["主","ぬし"],["の"],["神殿","しんでん"],["で"],["読んだ","よんだ"],["。"]]},{"verse":9,"text":"ユダの王、ヨシヤの子ヨヤキムの治世の第五年九月に、エルサレムの全市民およびユダの町々からエルサレムに上って来るすべての人々に、主の前で断食をする布告が出された。","tok":[["ユダ"],["の"],["王","おう"],["、"],["ヨシヤ"],["の"],["子","こ"],["ヨヤキム"],["の"],["治世","ちせい"],["の"],["第","だい"],["五","ご"],["年","ねん"],["九","きゅう"],["月","がつ"],["に"],["、"],["エルサレム"],["の"],["全","ぜん"],["市民","しみん"],["および"],["ユダ"],["の"],["町々","まちまち"],["から"],["エルサレム"],["に"],["上って","のぼって"],["来る","くる"],["すべて"],["の"],["人々","ひとびと"],["に"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["断食","だんじき"],["を"],["する"],["布告","ふこく"],["が"],["出された","だされた"],["。"]]},{"verse":10,"text":"そのとき、バルクは主の神殿で巻物に記されたエレミヤの言葉を読んだ。彼は書記官、シャファンの子ゲマルヤの部屋からすべての人々に読み聞かせたのであるが、それは主の神殿の上の前庭にあり、新しい門の入り口の傍らにあった。","tok":[["その"],["とき"],["、"],["バルク"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["で"],["巻物","まきもの"],["に"],["記された","しるされた"],["エレミヤ"],["の"],["言葉","ことば"],["を"],["読んだ","よんだ"],["。"],["彼","かれ"],["は"],["書記官","しょきかん"],["、"],["シャファン"],["の"],["子","こ"],["ゲマルヤ"],["の"],["部屋","へや"],["から"],["すべて"],["の"],["人々","ひとびと"],["に"],["読み聞かせた","よみきかせた"],["ので"],["ある"],["が"],["、"],["それ"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["上","うえ"],["の"],["前庭","ぜんてい"],["に"],["あり"],["、"],["新しい","あたらしい"],["門","もん"],["の"],["入り口","いりぐち"],["の"],["傍ら","かたわら"],["に"],["あった"],["。"]]},{"verse":11,"text":"シャファンの孫でゲマルヤの子であるミカヤは、その巻物に記された主の言葉をすべて聞くと、","tok":[["シャファン"],["の"],["孫","まご"],["で"],["ゲマルヤ"],["の"],["子","こ"],["で"],["ある"],["ミカヤ"],["は"],["、"],["その"],["巻物","まきもの"],["に"],["記された","しるされた"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["すべて"],["聞く","きく"],["と"],["、"]]},{"verse":12,"text":"王宮にある書記官の部屋へ下って行った。そこには、役人たちが皆、席に着いていた。書記官エリシャマ、シェマヤの子デラヤ、アクボルの子エルナタン、シャファンの子ゲマルヤ、ハナンヤの子ツィドキヤをはじめすべての役人たちがいた。","tok":[["王宮","おうきゅう"],["に"],["ある"],["書記官","しょきかん"],["の"],["部屋","へや"],["へ"],["下って","くだって"],["行った","いった"],["。"],["そこ"],["に"],["は"],["、"],["役人","やくにん"],["たち"],["が"],["皆","みな"],["、"],["席","せき"],["に"],["着いて","ついて"],["いた"],["。"],["書記官","しょきかん"],["エリシャマ"],["、"],["シェマヤ"],["の"],["子","こ"],["デラヤ"],["、"],["アクボル"],["の"],["子","こ"],["エルナタン"],["、"],["シャファン"],["の"],["子","こ"],["ゲマルヤ"],["、"],["ハナンヤ"],["の"],["子","こ"],["ツィドキヤ"],["を"],["はじめ"],["すべて"],["の"],["役人","やくにん"],["たち"],["が"],["いた"],["。"]]},{"verse":13,"text":"ミカヤは、バルクが民の前で巻物を読んだときに聞いた言葉を、すべて役人たちに伝えた。","tok":[["ミカヤ"],["は"],["、"],["バルク"],["が"],["民","たみ"],["の"],["前","まえ"],["で"],["巻物","まきもの"],["を"],["読んだ","よんだ"],["とき"],["に"],["聞いた","きいた"],["言葉","ことば"],["を"],["、"],["すべて"],["役人","やくにん"],["たち"],["に"],["伝えた","つたえた"],["。"]]},{"verse":14,"text":"役人たちは、ユディをバルクのもとに遣わして、「あなたが民に読み聞かせたあの巻物を持って来るように」と言わせた。ユディの父はネタンヤ、祖父はシェレムヤ、曽祖父はクシである。そこで、ネリヤの子バルクは、巻物を持って、彼らのところに来た。","tok":[["役人","やくにん"],["たち"],["は"],["、"],["ユディ"],["を"],["バルク"],["の"],["もと"],["に"],["遣わして","つかわして"],["、"],["「"],["あなた"],["が"],["民","たみ"],["に"],["読み聞かせた","よみきかせた"],["あの"],["巻物","まきもの"],["を"],["持って","もって"],["来る","くる"],["よう"],["に"],["」"],["と"],["言わせた","いわせた"],["。"],["ユディ"],["の"],["父","ちち"],["は"],["ネタンヤ"],["、"],["祖父","そふ"],["は"],["シェレムヤ"],["、"],["曽","そ"],["祖父","そふ"],["は"],["クシ"],["で"],["ある"],["。"],["そこ"],["で"],["、"],["ネリヤ"],["の"],["子","こ"],["バルク"],["は"],["、"],["巻物","まきもの"],["を"],["持って","もって"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["来た","きた"],["。"]]},{"verse":15,"text":"彼らはバルクに言った。「座って、我々にも巻物を読んでください。」そこで、バルクは彼らに巻物を読み聞かせた。","tok":[["彼","かれ"],["ら"],["は"],["バルク"],["に"],["言った","いった"],["。"],["「"],["座って","すわって"],["、"],["我々","われわれ"],["に"],["も"],["巻物","まきもの"],["を"],["読んで","よんで"],["ください"],["。"],["」"],["そこ"],["で"],["、"],["バルク"],["は"],["彼","かれ"],["ら"],["に"],["巻物","まきもの"],["を"],["読み聞かせた","よみきかせた"],["。"]]},{"verse":16,"text":"その言葉をすべて聞き終わると、彼らは皆、おののいて互いに顔を見合わせ、バルクに言った。「この言葉はすべて王に伝えねばならない。」","tok":[["その"],["言葉","ことば"],["を"],["すべて"],["聞き","きき"],["終わる","おわる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["おののいて"],["互い","たがい"],["に"],["顔","かお"],["を"],["見合わせ","みあわせ"],["、"],["バルク"],["に"],["言った","いった"],["。"],["「"],["この"],["言葉","ことば"],["は"],["すべて"],["王","おう"],["に"],["伝えねば","つたえねば"],["ならない"],["。"],["」"]]},{"verse":17,"text":"更にバルクに尋ねた。「どのようにして、このすべての言葉を書き記したのか教えてください。彼の口述ですか。」","tok":[["更に","さらに"],["バルク"],["に"],["尋ねた","たずねた"],["。"],["「"],["どの"],["よう"],["に"],["して"],["、"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["書き記した","かきしるした"],["の"],["か"],["教えて","おしえて"],["ください"],["。"],["彼","かれ"],["の"],["口述","こうじゅつ"],["です"],["か"],["。"],["」"]]},{"verse":18,"text":"バルクは答えた。「エレミヤが自らわたしにこのすべての言葉を口述したので、わたしが巻物にインクで書き記したのです。」","tok":[["バルク"],["は"],["答えた","こたえた"],["。"],["「"],["エレミヤ"],["が"],["自ら","みずから"],["わたし"],["に"],["この"],["すべて"],["の"],["言葉","ことば"],["を"],["口述","こうじゅつ"],["した"],["ので"],["、"],["わたし"],["が"],["巻物","まきもの"],["に"],["インク"],["で"],["書き記した","かきしるした"],["の"],["です"],["。"],["」"]]},{"verse":19,"text":"そこで、役人たちはバルクに言った。「あなたとエレミヤは急いで身を隠しなさい。だれにも居どころを知られてはなりません。」","tok":[["そこ"],["で"],["、"],["役人","やくにん"],["たち"],["は"],["バルク"],["に"],["言った","いった"],["。"],["「"],["あなた"],["と"],["エレミヤ"],["は"],["急いで","いそいで"],["身","み"],["を"],["隠し","かくし"],["なさい"],["。"],["だれ"],["に"],["も"],["居どころ","いどころ"],["を"],["知られて","しられて"],["は"],["なりません"],["。"],["」"]]},{"verse":20,"text":"彼らは巻物を書記官エリシャマの部屋に納めて、宮廷にいる王のもとに赴き、その言葉をすべて王に伝えた。","tok":[["彼","かれ"],["ら"],["は"],["巻物","まきもの"],["を"],["書記官","しょきかん"],["エリシャマ"],["の"],["部屋","へや"],["に"],["納めて","おさめて"],["、"],["宮廷","きゅうてい"],["に"],["いる"],["王","おう"],["の"],["もと"],["に"],["赴き","おもむき"],["、"],["その"],["言葉","ことば"],["を"],["すべて"],["王","おう"],["に"],["伝えた","つたえた"],["。"]]},{"verse":21,"text":"王はユディを遣わして、巻物を取って来させた。彼は書記官エリシャマの部屋から巻物を取って来て、王と王に仕えるすべての役人が聞いているところで読み上げた。","tok":[["王","おう"],["は"],["ユディ"],["を"],["遣わして","つかわして"],["、"],["巻物","まきもの"],["を"],["取って","とって"],["来させた","きさせた"],["。"],["彼","かれ"],["は"],["書記官","しょきかん"],["エリシャマ"],["の"],["部屋","へや"],["から"],["巻物","まきもの"],["を"],["取って","とって"],["来て","きて"],["、"],["王","おう"],["と"],["王","おう"],["に"],["仕える","つかえる"],["すべて"],["の"],["役人","やくにん"],["が"],["聞いて","きいて"],["いる"],["ところ"],["で"],["読み上げた","よみあげた"],["。"]]},{"verse":22,"text":"王は宮殿の冬の家にいた。時は九月で暖炉の火は王の前で赤々と燃えていた。","tok":[["王","おう"],["は"],["宮殿","きゅうでん"],["の"],["冬","ふゆ"],["の"],["家","いえ"],["に"],["いた"],["。"],["時","とき"],["は"],["九","きゅう"],["月","がつ"],["で"],["暖炉","だんろ"],["の"],["火","ひ"],["は"],["王","おう"],["の"],["前","まえ"],["で"],["赤々","あかあか"],["と"],["燃えて","もえて"],["いた"],["。"]]},{"verse":23,"text":"ユディが三、四欄読み終わるごとに、王は巻物をナイフで切り裂いて暖炉の火にくべ、ついに、巻物をすべて燃やしてしまった。","tok":[["ユディ"],["が"],["三","さん"],["、"],["四","よん"],["欄","らん"],["読み","よみ"],["終わる","おわる"],["ごと"],["に"],["、"],["王","おう"],["は"],["巻物","まきもの"],["を"],["ナイフ"],["で"],["切り裂いて","きりさいて"],["暖炉","だんろ"],["の"],["火","ひ"],["に"],["くべ"],["、"],["ついに"],["、"],["巻物","まきもの"],["を"],["すべて"],["燃やして","もやして"],["しまった"],["。"]]},{"verse":24,"text":"このすべての言葉を聞きながら、王もその側近もだれひとり恐れを抱かず、衣服を裂こうともしなかった。","tok":[["この"],["すべて"],["の"],["言葉","ことば"],["を"],["聞き","きき"],["ながら"],["、"],["王","おう"],["も"],["その"],["側近","そっきん"],["も"],["だれ"],["ひとり"],["恐れ","おそれ"],["を"],["抱かず","いだかず"],["、"],["衣服","いふく"],["を"],["裂こう","さこう"],["と"],["も"],["しなかった"],["。"]]},{"verse":25,"text":"また、エルナタン、デラヤ、ゲマルヤの三人が巻物を燃やさないように懇願したが、王はこれに耳を貸さなかった。","tok":[["また"],["、"],["エルナタン"],["、"],["デラヤ"],["、"],["ゲマルヤ"],["の"],["三人","さんにん"],["が"],["巻物","まきもの"],["を"],["燃やさない","もやさない"],["よう"],["に"],["懇願","こんがん"],["した"],["が"],["、"],["王","おう"],["は"],["これ"],["に"],["耳","みみ"],["を"],["貸さなかった","かさなかった"],["。"]]},{"verse":26,"text":"かえって、王は、王子エラフメエル、アズリエルの子セラヤ、アブデエルの子シェレムヤに命じて、書記バルクと預言者エレミヤを捕らえようとした。しかし、主は二人を隠された。","tok":[["かえって"],["、"],["王","おう"],["は"],["、"],["王子","おうじ"],["エラフメエル"],["、"],["アズリエル"],["の"],["子","こ"],["セラヤ"],["、"],["アブデエル"],["の"],["子","こ"],["シェレムヤ"],["に"],["命じて","めいじて"],["、"],["書記","しょき"],["バルク"],["と"],["預言者","よげんしゃ"],["エレミヤ"],["を"],["捕らえよう","とらえよう"],["と"],["した"],["。"],["しかし"],["、"],["主","ぬし"],["は"],["二人","ふたり"],["を"],["隠された","かくされた"],["。"]]},{"verse":27,"text":"バルクがエレミヤの口述に従ってこれらの言葉を書き記した巻物を王が燃やした後に、主の言葉がエレミヤに臨んだ。","tok":[["バルク"],["が"],["エレミヤ"],["の"],["口述","こうじゅつ"],["に"],["従って","したがって"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["書き記した","かきしるした"],["巻物","まきもの"],["を"],["王","おう"],["が"],["燃やした","もやした"],["後","あと"],["に"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":28,"text":"「改めて、別の巻物を取れ。ユダの王ヨヤキムが燃やした初めの巻物に記されていたすべての言葉を、元どおりに書き記せ。","tok":[["「"],["改めて","あらためて"],["、"],["別","べつ"],["の"],["巻物","まきもの"],["を"],["取れ","とれ"],["。"],["ユダ"],["の"],["王","おう"],["ヨヤキム"],["が"],["燃やした","もやした"],["初め","はじめ"],["の"],["巻物","まきもの"],["に"],["記されて","しるされて"],["いた"],["すべて"],["の"],["言葉","ことば"],["を"],["、"],["元どおり","もとどおり"],["に"],["書き記せ","かきしるせ"],["。"]]},{"verse":29,"text":"そして、ユダの王ヨヤキムに対して、あなたはこう言いなさい。主はこう言われる。お前はこの巻物を燃やしてしまった。お前はエレミヤを非難して、『なぜ、この巻物にバビロンの王が必ず来て、この国を滅ぼし、人も獣も絶滅させると書いたのか』と言った。","tok":[["そして"],["、"],["ユダ"],["の"],["王","おう"],["ヨヤキム"],["に対して","にたいして"],["、"],["あなた"],["は"],["こう"],["言い","いい"],["なさい"],["。"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["は"],["この"],["巻物","まきもの"],["を"],["燃やして","もやして"],["しまった"],["。"],["お前","おまえ"],["は"],["エレミヤ"],["を"],["非難","ひなん"],["して"],["、"],["『"],["なぜ"],["、"],["この"],["巻物","まきもの"],["に"],["バビロン"],["の"],["王","おう"],["が"],["必ず","かならず"],["来て","きて"],["、"],["この"],["国","くに"],["を"],["滅ぼし","ほろぼし"],["、"],["人","ひと"],["も"],["獣","けもの"],["も"],["絶滅","ぜつめつ"],["させる"],["と"],["書いた","かいた"],["の"],["か"],["』"],["と"],["言った","いった"],["。"]]},{"verse":30,"text":"それゆえ、主はユダの王ヨヤキムについてこう言われる。彼の子孫には、ダビデの王座につく者がなくなる。ヨヤキムの死体は投げ出されて、昼は炎熱に、夜は霜にさらされる。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["ユダ"],["の"],["王","おう"],["ヨヤキム"],["について"],["こう"],["言われる","いわれる"],["。"],["彼","かれ"],["の"],["子孫","しそん"],["に"],["は"],["、"],["ダビデ"],["の"],["王座","おうざ"],["に"],["つく"],["者","もの"],["が"],["なくなる"],["。"],["ヨヤキム"],["の"],["死体","したい"],["は"],["投げ出されて","なげだされて"],["、"],["昼","ひる"],["は"],["炎熱","えんねつ"],["に"],["、"],["夜","よる"],["は"],["霜","しも"],["に"],["さらされる"],["。"]]},{"verse":31,"text":"わたしは、王とその子孫と家来たちをその咎のゆえに罰する。彼らとエルサレムの住民およびユダの人々に災いをくだす。この災いは、すべて既に繰り返し告げたものであるが、彼らは聞こうとはしなかった。」","tok":[["わたし"],["は"],["、"],["王","おう"],["と"],["その"],["子孫","しそん"],["と"],["家来","けらい"],["たち"],["を"],["その"],["咎","とが"],["の"],["ゆえ"],["に"],["罰する","ばっする"],["。"],["彼","かれ"],["ら"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["および"],["ユダ"],["の"],["人々","ひとびと"],["に"],["災い","わざわい"],["を"],["くだす"],["。"],["この"],["災い","わざわい"],["は"],["、"],["すべて"],["既に","すでに"],["繰り返し","くりかえし"],["告げた","つげた"],["もの"],["で"],["ある"],["が"],["、"],["彼","かれ"],["ら"],["は"],["聞こう","きこう"],["と"],["は"],["しなかった"],["。"],["」"]]},{"verse":32,"text":"そこで、エレミヤは別の巻物を取って、書記ネリヤの子バルクに渡した。バルクは、ユダの王ヨヤキムが火に投じた巻物に記されていたすべての言葉を、エレミヤの口述に従って書き記した。また、同じような言葉を数多く加えた。","tok":[["そこ"],["で"],["、"],["エレミヤ"],["は"],["別","べつ"],["の"],["巻物","まきもの"],["を"],["取って","とって"],["、"],["書記","しょき"],["ネリヤ"],["の"],["子","こ"],["バルク"],["に"],["渡した","わたした"],["。"],["バルク"],["は"],["、"],["ユダ"],["の"],["王","おう"],["ヨヤキム"],["が"],["火","ひ"],["に"],["投じた","とうじた"],["巻物","まきもの"],["に"],["記されて","しるされて"],["いた"],["すべて"],["の"],["言葉","ことば"],["を"],["、"],["エレミヤ"],["の"],["口述","こうじゅつ"],["に"],["従って","したがって"],["書き記した","かきしるした"],["。"],["また"],["、"],["同じ","おなじ"],["よう"],["な"],["言葉","ことば"],["を"],["数多く","かずおおく"],["加えた","くわえた"],["。"]]}]
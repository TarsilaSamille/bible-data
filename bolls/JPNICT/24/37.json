[{"verse":1,"text":"ヨヤキムの子コンヤに代わって、ヨシヤの子ゼデキヤが王位についた。バビロンの王ネブカドレツァルが、彼をユダの国の王としたのである。","tok":[["ヨヤキム"],["の"],["子","こ"],["コンヤ"],["に"],["代わって","かわって"],["、"],["ヨシヤ"],["の"],["子","こ"],["ゼデキヤ"],["が"],["王位","おうい"],["に"],["ついた"],["。"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["が"],["、"],["彼","かれ"],["を"],["ユダ"],["の"],["国","くに"],["の"],["王","おう"],["と"],["した"],["ので"],["ある"],["。"]]},{"verse":2,"text":"王も家来も国の民も、主が預言者エレミヤによって告げられた主の言葉に聞き従わなかった。","tok":[["王","おう"],["も"],["家来","けらい"],["も"],["国","くに"],["の"],["民","たみ"],["も"],["、"],["主","ぬし"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["によって"],["告げられた","つげられた"],["主","ぬし"],["の"],["言葉","ことば"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"]]},{"verse":3,"text":"ゼデキヤ王は、シェレムヤの子ユカルと祭司であるマアセヤの子ツェファンヤとを預言者エレミヤのもとに遣わして、「どうか、我々のために、我々の神、主に祈ってほしい」と頼んだ。","tok":[["ゼデキヤ"],["王","おう"],["は"],["、"],["シェレムヤ"],["の"],["子","こ"],["ユカル"],["と"],["祭司","さいし"],["で"],["ある"],["マアセヤ"],["の"],["子","こ"],["ツェファンヤ"],["と"],["を"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["もと"],["に"],["遣わして","つかわして"],["、"],["「"],["どう"],["か"],["、"],["我々","われわれ"],["の"],["ため"],["に"],["、"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈って","いのって"],["ほしい"],["」"],["と"],["頼んだ","たのんだ"],["。"]]},{"verse":4,"text":"エレミヤはまだ投獄されておらず、人々の間で出入りしていた。","tok":[["エレミヤ"],["は"],["まだ"],["投獄","とうごく"],["されて"],["おらず"],["、"],["人々","ひとびと"],["の"],["間","あいだ"],["で"],["出入り","でいり"],["して"],["いた"],["。"]]},{"verse":5,"text":"折しも、ファラオの軍隊がエジプトから進撃して来た。エルサレムを包囲していたカルデア軍はこの知らせを聞いて、エルサレムから撤退した。","tok":[["折","おり"],["しも"],["、"],["ファラオ"],["の"],["軍隊","ぐんたい"],["が"],["エジプト"],["から"],["進撃","しんげき"],["して"],["来た","きた"],["。"],["エルサレム"],["を"],["包囲","ほうい"],["して"],["いた"],["カルデア"],["軍","ぐん"],["は"],["この"],["知らせ","しらせ"],["を"],["聞いて","きいて"],["、"],["エルサレム"],["から"],["撤退","てったい"],["した"],["。"]]},{"verse":6,"text":"このとき、主の言葉が預言者エレミヤに臨んだ。","tok":[["この"],["とき"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":7,"text":"「イスラエルの神なる主はこう言われる。わたしの言葉を求めて、お前たちを遣わしたユダの王にこう言うがよい。お前たちを救援しようと出動したファラオの軍隊は、自分の国エジプトへ帰って行く。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["なる"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["の"],["言葉","ことば"],["を"],["求めて","もとめて"],["、"],["お前","おまえ"],["たち"],["を"],["遣わした","つかわした"],["ユダ"],["の"],["王","おう"],["に"],["こう"],["言う","ゆう"],["が"],["よい"],["。"],["お前","おまえ"],["たち"],["を"],["救援","きゅうえん"],["しよう"],["と"],["出動","しゅつどう"],["した"],["ファラオ"],["の"],["軍隊","ぐんたい"],["は"],["、"],["自分","じぶん"],["の"],["国","くに"],["エジプト"],["へ"],["帰って","かえって"],["行く","いく"],["。"]]},{"verse":8,"text":"カルデア軍が再び来て、この都を攻撃し、占領し火を放つ。","tok":[["カルデア"],["軍","ぐん"],["が"],["再び","ふたたび"],["来て","きて"],["、"],["この"],["都","と"],["を"],["攻撃","こうげき"],["し"],["、"],["占領","せんりょう"],["し"],["火","ひ"],["を"],["放つ","はなつ"],["。"]]},{"verse":9,"text":"主はこう言われる。カルデア軍は必ず我々のもとから立ち去ると言って、自分を欺いてはならない。カルデア軍は決して立ち去らない。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["カルデア"],["軍","ぐん"],["は"],["必ず","かならず"],["我々","われわれ"],["の"],["もと"],["から"],["立ち去る","たちさる"],["と"],["言って","いって"],["、"],["自分","じぶん"],["を"],["欺いて","あざむいて"],["は"],["ならない"],["。"],["カルデア"],["軍","ぐん"],["は"],["決して","けっして"],["立ち去らない","たちさらない"],["。"]]},{"verse":10,"text":"たとえ、お前たちが戦いを交えているカルデアの全軍を撃ち破り、負傷兵だけが残ったとしても、彼らはそれぞれの天幕から立ち上がって、この都に火を放つ。」","tok":[["たとえ"],["、"],["お前","おまえ"],["たち"],["が"],["戦い","たたかい"],["を"],["交えて","まじえて"],["いる"],["カルデア"],["の"],["全軍","ぜんぐん"],["を"],["撃ち破り","うちやぶり"],["、"],["負傷兵","ふしょうへい"],["だけ"],["が"],["残った","のこった"],["として"],["も"],["、"],["彼","かれ"],["ら"],["は"],["それぞれ"],["の"],["天幕","てんまく"],["から"],["立ち上がって","たちあがって"],["、"],["この"],["都","と"],["に"],["火","ひ"],["を"],["放つ","はなつ"],["。"],["」"]]},{"verse":11,"text":"カルデア軍は、ファラオの軍隊が進撃して来たので、エルサレムから撤退した。","tok":[["カルデア"],["軍","ぐん"],["は"],["、"],["ファラオ"],["の"],["軍隊","ぐんたい"],["が"],["進撃","しんげき"],["して"],["来た","きた"],["ので"],["、"],["エルサレム"],["から"],["撤退","てったい"],["した"],["。"]]},{"verse":12,"text":"そのとき、エレミヤはエルサレムを出て、親族の間で郷里の所有地を相続するために、ベニヤミン族の地へ行こうとした。","tok":[["その"],["とき"],["、"],["エレミヤ"],["は"],["エルサレム"],["を"],["出て","でて"],["、"],["親族","しんぞく"],["の"],["間","あいだ"],["で"],["郷里","きょうり"],["の"],["所有地","しょゆうち"],["を"],["相続","そうぞく"],["する"],["ため"],["に"],["、"],["ベニヤミン"],["族","ぞく"],["の"],["地","ち"],["へ"],["行こう","いこう"],["と"],["した"],["。"]]},{"verse":13,"text":"彼がベニヤミン門にさしかかったとき、ハナンヤの孫で、シェレムヤの子であるイルイヤという守備隊長が、預言者エレミヤを捕らえて言った。「お前は、カルデア軍に投降しようとしている。」","tok":[["彼","かれ"],["が"],["ベニヤミン"],["門","もん"],["に"],["さしかかった"],["とき"],["、"],["ハナンヤ"],["の"],["孫","まご"],["で"],["、"],["シェレムヤ"],["の"],["子","こ"],["で"],["ある"],["イルイヤ"],["と"],["いう"],["守備","しゅび"],["隊長","たいちょう"],["が"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["を"],["捕らえて","とらえて"],["言った","いった"],["。"],["「"],["お前","おまえ"],["は"],["、"],["カルデア"],["軍","ぐん"],["に"],["投降","とうこう"],["しよう"],["として"],["いる"],["。"],["」"]]},{"verse":14,"text":"そこで、エレミヤは言った。「それは違う。わたしはカルデア軍に投降したりはしない。」しかし、イルイヤは聞き入れず、エレミヤを捕らえ、役人たちのところへ連れて行った。","tok":[["そこ"],["で"],["、"],["エレミヤ"],["は"],["言った","いった"],["。"],["「"],["それ"],["は"],["違う","ちがう"],["。"],["わたし"],["は"],["カルデア"],["軍","ぐん"],["に"],["投降","とうこう"],["し"],["たり"],["は"],["しない"],["。"],["」"],["しかし"],["、"],["イルイヤ"],["は"],["聞き入れず","ききいれず"],["、"],["エレミヤ"],["を"],["捕らえ","とらえ"],["、"],["役人","やくにん"],["たち"],["の"],["ところ"],["へ"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":15,"text":"役人たちは激怒してエレミヤを打ちたたき、書記官ヨナタンの家に監禁した。そこが牢獄として使われていたからである。","tok":[["役人","やくにん"],["たち"],["は"],["激怒","げきど"],["して"],["エレミヤ"],["を"],["打ちたたき","うちたたき"],["、"],["書記官","しょきかん"],["ヨナタン"],["の"],["家","いえ"],["に"],["監禁","かんきん"],["した"],["。"],["そこ"],["が"],["牢獄","ろうごく"],["として"],["使われて","つかわれて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"エレミヤは丸天井のある地下牢に入れられ、長期間そこに留めて置かれた。","tok":[["エレミヤ"],["は"],["丸","まる"],["天井","てんじょう"],["の"],["ある"],["地下","ちか"],["牢","ろう"],["に"],["入れられ","いれられ"],["、"],["長期間","ちょうきかん"],["そこ"],["に"],["留めて","とめて"],["置かれた","おかれた"],["。"]]},{"verse":17,"text":"ゼデキヤ王は使者を送ってエレミヤを連れて来させ、宮廷でひそかに尋ねた。「主から何か言葉があったか。」エレミヤは答えた。「ありました。バビロンの王の手にあなたは渡されます。」","tok":[["ゼデキヤ"],["王","おう"],["は"],["使者","ししゃ"],["を"],["送って","おくって"],["エレミヤ"],["を"],["連れて","つれて"],["来させ","きさせ"],["、"],["宮廷","きゅうてい"],["で"],["ひそか"],["に"],["尋ねた","たずねた"],["。"],["「"],["主","ぬし"],["から"],["何","なん"],["か"],["言葉","ことば"],["が"],["あった"],["か"],["。"],["」"],["エレミヤ"],["は"],["答えた","こたえた"],["。"],["「"],["ありました"],["。"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["あなた"],["は"],["渡されます","わたされます"],["。"],["」"]]},{"verse":18,"text":"更に、エレミヤはゼデキヤ王に言った。「わたしを牢獄に監禁しておられますが、一体わたしは、どのような罪をあなたとあなたの臣下、あるいはこの民に対して犯したのですか。","tok":[["更に","さらに"],["、"],["エレミヤ"],["は"],["ゼデキヤ"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["わたし"],["を"],["牢獄","ろうごく"],["に"],["監禁","かんきん"],["して"],["おられます"],["が"],["、"],["一体","いったい"],["わたし"],["は"],["、"],["どのような"],["罪","つみ"],["を"],["あなた"],["と"],["あなた"],["の"],["臣下","しんか"],["、"],["あるいは"],["この"],["民","たみ"],["に対して","にたいして"],["犯した","おかした"],["の"],["です"],["か"],["。"]]},{"verse":19,"text":"『バビロンの王は、あなたたちも、この国をも攻撃することはない』と預言していたあの預言者たちは、一体どこへ行ってしまったのですか。","tok":[["『"],["バビロン"],["の"],["王","おう"],["は"],["、"],["あなた"],["たち"],["も"],["、"],["この"],["国","くに"],["を"],["も"],["攻撃","こうげき"],["する"],["こと"],["は"],["ない"],["』"],["と"],["預言","よげん"],["して"],["いた"],["あの"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["一体","いったい"],["どこ"],["へ"],["行って","いって"],["しまった"],["の"],["です"],["か"],["。"]]},{"verse":20,"text":"王よ、今どうか、聞いてください。どうか、わたしの願いを受け入れ、書記官ヨナタンの家に送り返さないでください。わたしがそこで殺されないように。」","tok":[["王","おう"],["よ"],["、"],["今","いま"],["どう"],["か"],["、"],["聞いて","きいて"],["ください"],["。"],["どう"],["か"],["、"],["わたし"],["の"],["願い","ねがい"],["を"],["受け入れ","うけいれ"],["、"],["書記官","しょきかん"],["ヨナタン"],["の"],["家","いえ"],["に"],["送り返さないで","おくりかえさないで"],["ください"],["。"],["わたし"],["が"],["そこ"],["で"],["殺されない","ころされない"],["よう"],["に"],["。"],["」"]]},{"verse":21,"text":"ゼデキヤ王は、エレミヤを監視の庭に拘留しておくよう命じ、パン屋街から毎日パンを一つ届けさせた。これは都にパンがなくなるまで続いた。エレミヤは監視の庭に留めて置かれた。","tok":[["ゼデキヤ"],["王","おう"],["は"],["、"],["エレミヤ"],["を"],["監視","かんし"],["の"],["庭","にわ"],["に"],["拘留","こうりゅう"],["して"],["おく"],["よう"],["命じ","めいじ"],["、"],["パン屋街","ぱんやがい"],["から"],["毎日","まいにち"],["パン"],["を"],["一","ひと"],["つ"],["届けさせた","とどけさせた"],["。"],["これ"],["は"],["都","と"],["に"],["パン"],["が"],["なくなる"],["まで"],["続いた","つづいた"],["。"],["エレミヤ"],["は"],["監視","かんし"],["の"],["庭","にわ"],["に"],["留めて","とめて"],["置かれた","おかれた"],["。"]]}]
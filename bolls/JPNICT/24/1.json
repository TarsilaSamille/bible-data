[{"verse":1,"text":"エレミヤの言葉。彼はベニヤミンの地のアナトトの祭司ヒルキヤの子であった。","tok":[["エレミヤ"],["の"],["言葉","ことば"],["。"],["彼","かれ"],["は"],["ベニヤミン"],["の"],["地","ち"],["の"],["アナトト"],["の"],["祭司","さいし"],["ヒルキヤ"],["の"],["子","こ"],["で"],["あった"],["。"]]},{"verse":2,"text":"主の言葉が彼に臨んだのは、ユダの王、アモンの子ヨシヤの時代、その治世の第十三年のことであり、","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["彼","かれ"],["に"],["臨んだ","のぞんだ"],["の"],["は"],["、"],["ユダ"],["の"],["王","おう"],["、"],["アモン"],["の"],["子","こ"],["ヨシヤ"],["の"],["時代","じだい"],["、"],["その"],["治世","ちせい"],["の"],["第","だい"],["十三","じゅうさん"],["年","ねん"],["の"],["こと"],["で"],["あり"],["、"]]},{"verse":3,"text":"更にユダの王、ヨシヤの子ヨヤキムの時代にも臨み、ユダの王、ヨシヤの子ゼデキヤの治世の第十一年の終わり、すなわち、その年の五月に、エルサレムの住民が捕囚となるまで続いた。","tok":[["更に","さらに"],["ユダ"],["の"],["王","おう"],["、"],["ヨシヤ"],["の"],["子","こ"],["ヨヤキム"],["の"],["時代","じだい"],["に"],["も"],["臨み","のぞみ"],["、"],["ユダ"],["の"],["王","おう"],["、"],["ヨシヤ"],["の"],["子","こ"],["ゼデキヤ"],["の"],["治世","ちせい"],["の"],["第","だい"],["十一","じゅういち"],["年","ねん"],["の"],["終わり","おわり"],["、"],["すなわち"],["、"],["その"],["年","とし"],["の"],["五","ご"],["月","がつ"],["に"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["が"],["捕囚","ほしゅう"],["と"],["なる"],["まで"],["続いた","つづいた"],["。"]]},{"verse":4,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":5,"text":"「わたしはあなたを母の胎内に造る前からあなたを知っていた。母の胎から生まれる前にわたしはあなたを聖別し諸国民の預言者として立てた。」","tok":[["「"],["わたし"],["は"],["あなた"],["を"],["母","はは"],["の"],["胎内","たいない"],["に"],["造る","つくる"],["前","まえ"],["から"],["あなた"],["を"],["知って","しって"],["いた"],["。"],["母","はは"],["の"],["胎","はら"],["から"],["生まれる","うまれる"],["前","まえ"],["に"],["わたし"],["は"],["あなた"],["を"],["聖別","せいべつ"],["し"],["諸","しょ"],["国民","こくみん"],["の"],["預言者","よげんしゃ"],["として"],["立てた","たてた"],["。"],["」"]]},{"verse":6,"text":"わたしは言った。「ああ、わが主なる神よわたしは語る言葉を知りません。わたしは若者にすぎませんから。」","tok":[["わたし"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["わが"],["主","ぬし"],["なる"],["神","かみ"],["よ"],["わたし"],["は"],["語る","かたる"],["言葉","ことば"],["を"],["知りません","しりません"],["。"],["わたし"],["は"],["若者","わかもの"],["に"],["すぎません"],["から"],["。"],["」"]]},{"verse":7,"text":"しかし、主はわたしに言われた。「若者にすぎないと言ってはならない。わたしがあなたを、だれのところへ遣わそうとも、行ってわたしが命じることをすべて語れ。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["若者","わかもの"],["に"],["すぎない"],["と"],["言って","いって"],["は"],["ならない"],["。"],["わたし"],["が"],["あなた"],["を"],["、"],["だれ"],["の"],["ところ"],["へ"],["遣わそう","つかわそう"],["とも"],["、"],["行って","いって"],["わたし"],["が"],["命じる","めいじる"],["こと"],["を"],["すべて"],["語れ","かたれ"],["。"]]},{"verse":8,"text":"彼らを恐れるな。わたしがあなたと共にいて必ず救い出す」と主は言われた。","tok":[["彼","かれ"],["ら"],["を"],["恐れる","おそれる"],["な"],["。"],["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["いて"],["必ず","かならず"],["救い出す","すくいだす"],["」"],["と"],["主","ぬし"],["は"],["言われた","いわれた"],["。"]]},{"verse":9,"text":"主は手を伸ばして、わたしの口に触れ主はわたしに言われた。「見よ、わたしはあなたの口にわたしの言葉を授ける。","tok":[["主","ぬし"],["は"],["手","て"],["を"],["伸ばして","のばして"],["、"],["わたし"],["の"],["口","くち"],["に"],["触れ","ふれ"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["口","くち"],["に"],["わたし"],["の"],["言葉","ことば"],["を"],["授ける","さずける"],["。"]]},{"verse":10,"text":"見よ、今日、あなたに諸国民、諸王国に対する権威をゆだねる。抜き、壊し、滅ぼし、破壊しあるいは建て、植えるために。」","tok":[["見よ","みよ"],["、"],["今日","きょう"],["、"],["あなた"],["に"],["諸国民","しょこくみん"],["、"],["諸王国","しょおうこく"],["に"],["対する","たいする"],["権威","けんい"],["を"],["ゆだねる"],["。"],["抜き","ぬき"],["、"],["壊し","こわし"],["、"],["滅ぼし","ほろぼし"],["、"],["破壊","はかい"],["し"],["あるいは"],["建て","たて"],["、"],["植える","うえる"],["ため"],["に"],["。"],["」"]]},{"verse":11,"text":"主の言葉がわたしに臨んだ。「エレミヤよ、何が見えるか。」わたしは答えた。「アーモンド（シャーケード）の枝が見えます。」","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"],["「"],["エレミヤ"],["よ"],["、"],["何","なん"],["が"],["見える","みえる"],["か"],["。"],["」"],["わたし"],["は"],["答えた","こたえた"],["。"],["「"],["アーモンド"],["（"],["シャーケード"],["）"],["の"],["枝","えだ"],["が"],["見えます","みえます"],["。"],["」"]]},{"verse":12,"text":"主はわたしに言われた。「あなたの見るとおりだ。わたしは、わたしの言葉を成し遂げようと見張っている（ショーケード）。」","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["見る","みる"],["とおり"],["だ"],["。"],["わたし"],["は"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["成し遂げよう","なしとげよう"],["と"],["見張って","みはって"],["いる"],["（"],["ショーケード"],["）"],["。"],["」"]]},{"verse":13,"text":"主の言葉が再びわたしに臨んで言われた。「何が見えるか。」わたしは答えた。「煮えたぎる鍋が見えます。北からこちらへ傾いています。」","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["再び","ふたたび"],["わたし"],["に"],["臨んで","のぞんで"],["言われた","いわれた"],["。"],["「"],["何","なん"],["が"],["見える","みえる"],["か"],["。"],["」"],["わたし"],["は"],["答えた","こたえた"],["。"],["「"],["煮えたぎる","にえたぎる"],["鍋","なべ"],["が"],["見えます","みえます"],["。"],["北","きた"],["から"],["こちら"],["へ"],["傾いて","かたむいて"],["います"],["。"],["」"]]},{"verse":14,"text":"主はわたしに言われた。北から災いが襲いかかるこの地に住む者すべてに。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["北","きた"],["から"],["災い","わざわい"],["が"],["襲いかかる","おそいかかる"],["この"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["すべて"],["に"],["。"]]},{"verse":15,"text":"北のすべての民とすべての国にわたしは今、呼びかける、と主は言われる。彼らはやって来て、エルサレムの門の前に都をとりまく城壁とユダのすべての町に向かってそれぞれ王座を据える。","tok":[["北","きた"],["の"],["すべて"],["の"],["民","たみ"],["と"],["すべて"],["の"],["国","くに"],["に"],["わたし"],["は"],["今","いま"],["、"],["呼びかける","よびかける"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["彼","かれ"],["ら"],["は"],["やって"],["来て","きて"],["、"],["エルサレム"],["の"],["門","もん"],["の"],["前","まえ"],["に"],["都","と"],["を"],["とりまく"],["城壁","じょうへき"],["と"],["ユダ"],["の"],["すべて"],["の"],["町","まち"],["に"],["向かって","むかって"],["それぞれ"],["王座","おうざ"],["を"],["据える","すえる"],["。"]]},{"verse":16,"text":"わたしは、わが民の甚だしい悪に対して裁きを告げる。彼らはわたしを捨て、他の神々に香をたき手で造ったものの前にひれ伏した。","tok":[["わたし"],["は"],["、"],["わが"],["民","たみ"],["の"],["甚だしい","はなはだしい"],["悪","あく"],["に対して","にたいして"],["裁き","さばき"],["を"],["告げる","つげる"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["捨て","すて"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["手","しゅ"],["で"],["造った","つくった"],["もの"],["の"],["前","まえ"],["に"],["ひれ伏した","ひれふした"],["。"]]},{"verse":17,"text":"あなたは腰に帯を締め立って、彼らに語れわたしが命じることをすべて。彼らの前におののくなわたし自身があなたを彼らの前でおののかせることがないように。","tok":[["あなた"],["は"],["腰","こし"],["に"],["帯","おび"],["を"],["締め","しめ"],["立って","たって"],["、"],["彼","かれ"],["ら"],["に"],["語れ","かたれ"],["わたし"],["が"],["命じる","めいじる"],["こと"],["を"],["すべて"],["。"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["おののく"],["な"],["わたし"],["自身","じしん"],["が"],["あなた"],["を"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["おののかせる"],["こと"],["が"],["ない"],["よう"],["に"],["。"]]},{"verse":18,"text":"わたしは今日、あなたをこの国全土に向けて堅固な町とし、鉄の柱、青銅の城壁としてユダの王やその高官たちその祭司や国の民に立ち向かわせる。","tok":[["わたし"],["は"],["今日","きょう"],["、"],["あなた"],["を"],["この"],["国","くに"],["全土","ぜんど"],["に"],["向けて","むけて"],["堅固","けんご"],["な"],["町","まち"],["と"],["し"],["、"],["鉄","てつ"],["の"],["柱","はしら"],["、"],["青銅","せいどう"],["の"],["城壁","じょうへき"],["として"],["ユダ"],["の"],["王","おう"],["や"],["その"],["高官","こうかん"],["たち"],["その"],["祭司","さいし"],["や"],["国","くに"],["の"],["民","たみ"],["に"],["立ち向かわせる","たちむかわせる"],["。"]]},{"verse":19,"text":"彼らはあなたに戦いを挑むが勝つことはできない。わたしがあなたと共にいて、救い出すと主は言われた。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["に"],["戦い","たたかい"],["を"],["挑む","いどむ"],["が"],["勝つ","かつ"],["こと"],["は"],["できない"],["。"],["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["いて"],["、"],["救い出す","すくいだす"],["と"],["主","ぬし"],["は"],["言われた","いわれた"],["。"]]}]
[{"verse":1,"text":"彼らの神である主がエレミヤを遣わして伝えさせたすべての言葉を、彼が民の全員に語り終えたとき、","tok":[["彼","かれ"],["ら"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["エレミヤ"],["を"],["遣わして","つかわして"],["伝えさせた","つたえさせた"],["すべて"],["の"],["言葉","ことば"],["を"],["、"],["彼","かれ"],["が"],["民","たみ"],["の"],["全員","ぜんいん"],["に"],["語り","かたり"],["終えた","おえた"],["とき"],["、"]]},{"verse":2,"text":"ホシャヤの子アザルヤ、カレアの子ヨハナンおよび高慢な人々はエレミヤに向かって言った。「あなたの言っていることは偽りだ。我々の神である主はあなたを遣わしていない。主は、『エジプトへ行って寄留してはならない』と言ってはおられない。","tok":[["ホシャヤ"],["の"],["子","こ"],["アザルヤ"],["、"],["カレア"],["の"],["子","こ"],["ヨハナン"],["および"],["高慢","こうまん"],["な"],["人々","ひとびと"],["は"],["エレミヤ"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["あなた"],["の"],["言って","いって"],["いる"],["こと"],["は"],["偽り","いつわり"],["だ"],["。"],["我々","われわれ"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["あなた"],["を"],["遣わして","つかわして"],["いない"],["。"],["主","ぬし"],["は"],["、"],["『"],["エジプト"],["へ"],["行って","いって"],["寄留","きりゅう"],["して"],["は"],["ならない"],["』"],["と"],["言って","いって"],["は"],["おられない"],["。"]]},{"verse":3,"text":"ネリヤの子バルクがあなたを唆して、我々に対立させ、我々をカルデア人に渡して殺すか、あるいは捕囚としてバビロンへ行かせようとしているのだ。」","tok":[["ネリヤ"],["の"],["子","こ"],["バルク"],["が"],["あなた"],["を"],["唆して","そそのかして"],["、"],["我々","われわれ"],["に"],["対立","たいりつ"],["させ"],["、"],["我々","われわれ"],["を"],["カルデア"],["人","にん"],["に"],["渡して","わたして"],["殺す","ころす"],["か"],["、"],["あるいは"],["捕囚","ほしゅう"],["として"],["バビロン"],["へ"],["行かせよう","いかせよう"],["として"],["いる"],["の"],["だ"],["。"],["」"]]},{"verse":4,"text":"こうして、カレアの子ヨハナンと軍の長たちすべて、および民の全員は、ユダの地にとどまれ、という主の声に聞き従わなかった。","tok":[["こう"],["して"],["、"],["カレア"],["の"],["子","こ"],["ヨハナン"],["と"],["軍","ぐん"],["の"],["長","なが"],["たち"],["すべて"],["、"],["および"],["民","みん"],["の"],["全員","ぜんいん"],["は"],["、"],["ユダ"],["の"],["地","ち"],["に"],["とどまれ"],["、"],["と"],["いう"],["主","ぬし"],["の"],["声","こえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"]]},{"verse":5,"text":"カレアの子ヨハナンと軍の長たちはすべて、避難先の国々からユダの国に引き揚げて来たユダの残留民をすべて集めた。","tok":[["カレア"],["の"],["子","こ"],["ヨハナン"],["と"],["軍","ぐん"],["の"],["長","なが"],["たち"],["は"],["すべて"],["、"],["避難先","ひなんさき"],["の"],["国々","くにぐに"],["から"],["ユダ"],["の"],["国","くに"],["に"],["引き揚げて","ひきあげて"],["来た","きた"],["ユダ"],["の"],["残留民","ざんりゅうみん"],["を"],["すべて"],["集めた","あつめた"],["。"]]},{"verse":6,"text":"そこには、親衛隊長ネブザルアダンが、シャファンの孫でアヒカムの子であるゲダルヤに託した男、女、子供、王の娘たちをはじめすべての人々、および預言者エレミヤ、ネリヤの子バルクがいた。","tok":[["そこ"],["に"],["は"],["、"],["親衛","しんえい"],["隊長","たいちょう"],["ネブザルアダン"],["が"],["、"],["シャファン"],["の"],["孫","まご"],["で"],["アヒカム"],["の"],["子","こ"],["で"],["ある"],["ゲダルヤ"],["に"],["託した","たくした"],["男","おとこ"],["、"],["女","おんな"],["、"],["子供","こども"],["、"],["王","おう"],["の"],["娘","むすめ"],["たち"],["を"],["はじめ"],["すべて"],["の"],["人々","ひとびと"],["、"],["および"],["預言者","よげんしゃ"],["エレミヤ"],["、"],["ネリヤ"],["の"],["子","こ"],["バルク"],["が"],["いた"],["。"]]},{"verse":7,"text":"そして彼らは主の声に聞き従わず、エジプトの地へ赴き、タフパンヘスにたどりついた。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["声","こえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["エジプト"],["の"],["地","ち"],["へ"],["赴き","おもむき"],["、"],["タフパンヘス"],["に"],["たどりついた"],["。"]]},{"verse":8,"text":"主の言葉がタフパンヘスでエレミヤに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["タフパンヘス"],["で"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":9,"text":"「大きな石を手に取り、ユダの人々の見ている前で、ファラオの宮殿の入り口の敷石の下にモルタルで埋め込み、","tok":[["「"],["大きな","おおきな"],["石","いし"],["を"],["手","て"],["に"],["取り","とり"],["、"],["ユダ"],["の"],["人々","ひとびと"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["ファラオ"],["の"],["宮殿","きゅうでん"],["の"],["入り口","いりぐち"],["の"],["敷石","しきいし"],["の"],["下","した"],["に"],["モルタル"],["で"],["埋め込み","うめこみ"],["、"]]},{"verse":10,"text":"彼らに言いなさい。イスラエルの神、万軍の主はこう言われる。わたしは使者を遣わして、わたしの僕であるバビロンの王ネブカドレツァルを招き寄せ、彼の王座を、今埋めたこの大石の上に置く。彼は天蓋をその上に張る。","tok":[["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["使者","ししゃ"],["を"],["遣わして","つかわして"],["、"],["わたし"],["の"],["僕","ぼく"],["で"],["ある"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["を"],["招き寄せ","まねきよせ"],["、"],["彼","かれ"],["の"],["王座","おうざ"],["を"],["、"],["今","いま"],["埋めた","うめた"],["この"],["大石","おおいし"],["の"],["上","うえ"],["に"],["置く","おく"],["。"],["彼","かれ"],["は"],["天蓋","てんがい"],["を"],["その"],["上","うえ"],["に"],["張る","はる"],["。"]]},{"verse":11,"text":"彼は来て、エジプトの地を撃ち、疫病に定められた者を疫病に、捕囚に定められた者を捕囚に、剣に定められた者を剣に渡す。","tok":[["彼","かれ"],["は"],["来て","きて"],["、"],["エジプト"],["の"],["地","ち"],["を"],["撃ち","うち"],["、"],["疫病","やくびょう"],["に"],["定められた","さだめられた"],["者","もの"],["を"],["疫病","やくびょう"],["に"],["、"],["捕囚","ほしゅう"],["に"],["定められた","さだめられた"],["者","もの"],["を"],["捕囚","ほしゅう"],["に"],["、"],["剣","けん"],["に"],["定められた","さだめられた"],["者","もの"],["を"],["剣","けん"],["に"],["渡す","わたす"],["。"]]},{"verse":12,"text":"彼はエジプトの神殿に火を放ち、神殿を焼き払い、また神々を奪い去る。また羊飼いが上着のしらみを払い落とすように、エジプトの国土を打ち払って、安らかに引き揚げて行く。","tok":[["彼","かれ"],["は"],["エジプト"],["の"],["神殿","しんでん"],["に"],["火","ひ"],["を"],["放ち","はなち"],["、"],["神殿","しんでん"],["を"],["焼き払い","やきはらい"],["、"],["また"],["神々","かみがみ"],["を"],["奪い去る","うばいさる"],["。"],["また"],["羊飼い","ひつじかい"],["が"],["上着","うわぎ"],["の"],["しらみ"],["を"],["払い落とす","はらいおとす"],["よう"],["に"],["、"],["エジプト"],["の"],["国土","こくど"],["を"],["打ち払って","うちはらって"],["、"],["安らか","やすらか"],["に"],["引き揚げて","ひきあげて"],["行く","いく"],["。"]]},{"verse":13,"text":"また、エジプトの太陽の神殿のオベリスクを破壊し、エジプトの神々の神殿を火で焼き払う。」","tok":[["また"],["、"],["エジプト"],["の"],["太陽","たいよう"],["の"],["神殿","しんでん"],["の"],["オベリスク"],["を"],["破壊","はかい"],["し"],["、"],["エジプト"],["の"],["神々","かみがみ"],["の"],["神殿","しんでん"],["を"],["火","ひ"],["で"],["焼き払う","やきはらう"],["。"],["」"]]}]
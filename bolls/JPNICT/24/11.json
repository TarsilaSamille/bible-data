[{"verse":1,"text":"主からエレミヤに臨んだ言葉。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"]]},{"verse":2,"text":"「この契約の言葉を聞け。それをユダの人、エルサレムの住民に告げよ。","tok":[["「"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["それ"],["を"],["ユダ"],["の"],["人","ひと"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["告げ","つげ"],["よ"],["。"]]},{"verse":3,"text":"彼らに向かって言え。イスラエルの神、主はこう言われる。この契約の言葉に聞き従わない者は呪われる。","tok":[["彼","かれ"],["ら"],["に"],["向かって","むかって"],["言え","いえ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["に"],["聞き従わない","ききしたがわない"],["者","もの"],["は"],["呪われる","のろわれる"],["。"]]},{"verse":4,"text":"これらの言葉はわたしがあなたたちの先祖を、鉄の炉であるエジプトの地から導き出したとき、命令として与えたものである。わたしは言った。わたしの声に聞き従い、あなたたちに命じるところをすべて行えば、あなたたちはわたしの民となり、わたしはあなたたちの神となる。","tok":[["これ"],["ら"],["の"],["言葉","ことば"],["は"],["わたし"],["が"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["を"],["、"],["鉄","てつ"],["の"],["炉","ろ"],["で"],["ある"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["とき"],["、"],["命令","めいれい"],["として"],["与えた","あたえた"],["もの"],["で"],["ある"],["。"],["わたし"],["は"],["言った","いった"],["。"],["わたし"],["の"],["声","こえ"],["に"],["聞き従い","ききしたがい"],["、"],["あなた"],["たち"],["に"],["命じる","めいじる"],["ところ"],["を"],["すべて"],["行えば","おこなえば"],["、"],["あなた"],["たち"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":5,"text":"それは、わたしがあなたたちの先祖に誓った誓いを果たし、今日見るように、乳と蜜の流れる地を彼らに与えるためであった。」わたしは答えて言った。「アーメン、主よ」と。","tok":[["それ"],["は"],["、"],["わたし"],["が"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["に"],["誓った","ちかった"],["誓い","ちかい"],["を"],["果たし","はたし"],["、"],["今日","きょう"],["見る","みる"],["よう"],["に"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["を"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["ため"],["で"],["あった"],["。"],["」"],["わたし"],["は"],["答えて","こたえて"],["言った","いった"],["。"],["「"],["アーメン"],["、"],["主","ぬし"],["よ"],["」"],["と"],["。"]]},{"verse":6,"text":"主はわたしに言われた。「ユダの町々とエルサレムの通りで、これらの言葉をすべて呼ばわって言え。この契約の言葉を聞き、これを行え。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["通り","とおり"],["で"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["すべて"],["呼ばわって","よばわって"],["言え","いえ"],["。"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["を"],["聞き","きき"],["、"],["これ"],["を"],["行え","おこなえ"],["。"]]},{"verse":7,"text":"わたしは、あなたたちの先祖をエジプトの地から導き上ったとき、彼らに厳しく戒め、また今日に至るまで、繰り返し戒めて、わたしの声に聞き従え、と言ってきた。","tok":[["わたし"],["は"],["、"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き","みちびき"],["上った","のぼった"],["とき"],["、"],["彼","かれ"],["ら"],["に"],["厳しく","きびしく"],["戒め","いましめ"],["、"],["また"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["繰り返し","くりかえし"],["戒めて","いましめて"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞き従え","ききしたがえ"],["、"],["と"],["言って","いって"],["きた"],["。"]]},{"verse":8,"text":"しかし、彼らはわたしに耳を傾けず、聞き従わず、おのおのその悪い心のかたくなさのままに歩んだ。今、わたしは、この契約の言葉をことごとく彼らの上に臨ませる。それを行うことを命じたが、彼らが行わなかったからだ。」","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["聞き従わず","ききしたがわず"],["、"],["おのおの"],["その"],["悪い","わるい"],["心","こころ"],["の"],["かたくな"],["さ"],["の"],["まま"],["に"],["歩んだ","あゆんだ"],["。"],["今","いま"],["、"],["わたし"],["は"],["、"],["この"],["契約","けいやく"],["の"],["言葉","ことば"],["を"],["ことごとく"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["臨ませる","のぞませる"],["。"],["それ"],["を"],["行う","おこなう"],["こと"],["を"],["命じた","めいじた"],["が"],["、"],["彼","かれ"],["ら"],["が"],["行わなかった","おこなわなかった"],["から"],["だ"],["。"],["」"]]},{"verse":9,"text":"主はわたしに言われた。「ユダの人とエルサレムの住民が共謀しているのが見える。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["ユダ"],["の"],["人","ひと"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["が"],["共謀","きょうぼう"],["して"],["いる"],["の"],["が"],["見える","みえる"],["。"]]},{"verse":10,"text":"彼らは昔、先祖が犯した罪に戻り、わたしの言葉に聞き従うことを拒み、他の神々に従ってそれらを礼拝している。こうしてイスラエルの家とユダの家は、わたしが彼らの先祖と結んだ契約を破った。」","tok":[["彼","かれ"],["ら"],["は"],["昔","むかし"],["、"],["先祖","せんぞ"],["が"],["犯した","おかした"],["罪","つみ"],["に"],["戻り","もどり"],["、"],["わたし"],["の"],["言葉","ことば"],["に"],["聞き従う","ききしたがう"],["こと"],["を"],["拒み","こばみ"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["それ"],["ら"],["を"],["礼拝","れいはい"],["して"],["いる"],["。"],["こう"],["して"],["イスラエル"],["の"],["家","いえ"],["と"],["ユダ"],["の"],["家","いえ"],["は"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["と"],["結んだ","むすんだ"],["契約","けいやく"],["を"],["破った","やぶった"],["。"],["」"]]},{"verse":11,"text":"それゆえ、主はこう言われる。「見よ、わたしは彼らに災いをくだす。彼らはこれを逃れることはできない。わたしに助けを求めて叫んでも、わたしはそれを聞き入れない。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["災い","わざわい"],["を"],["くだす"],["。"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["逃れる","のがれる"],["こと"],["は"],["できない"],["。"],["わたし"],["に"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んで","さけんで"],["も"],["、"],["わたし"],["は"],["それ"],["を"],["聞き入れない","ききいれない"],["。"]]},{"verse":12,"text":"ユダの町々とエルサレムの住民は、彼らが香をたいていた神々のところに行って助けを求めるが、災いがふりかかるとき、神々は彼らを救うことができない。","tok":[["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["は"],["、"],["彼","かれ"],["ら"],["が"],["香","こう"],["を"],["たいて"],["いた"],["神々","かみがみ"],["の"],["ところ"],["に"],["行って","いって"],["助け","たすけ"],["を"],["求める","もとめる"],["が"],["、"],["災い","わざわい"],["が"],["ふりかかる"],["とき"],["、"],["神々","かみがみ"],["は"],["彼","かれ"],["ら"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"]]},{"verse":13,"text":"ユダよ、お前の町の数ほど神々があり、お前たちはエルサレムの通りの数ほど、恥ずべきものへの祭壇とバアルに香をたくための祭壇を設けた。","tok":[["ユダ"],["よ"],["、"],["お前","おまえ"],["の"],["町","まち"],["の"],["数","かず"],["ほど"],["神々","かみがみ"],["が"],["あり"],["、"],["お前","おまえ"],["たち"],["は"],["エルサレム"],["の"],["通り","とおり"],["の"],["数","かず"],["ほど"],["、"],["恥ずべき","はずべき"],["もの"],["へ"],["の"],["祭壇","さいだん"],["と"],["バアル"],["に"],["香","こう"],["を"],["たく"],["ため"],["の"],["祭壇","さいだん"],["を"],["設けた","もうけた"],["。"]]},{"verse":14,"text":"あなたは、この民のために祈ってはならない。彼らのために嘆きと祈りの声をあげてはならない。災いのゆえに、彼らがわたしを呼び求めてもわたしは聞き入れない。」","tok":[["あなた"],["は"],["、"],["この"],["民","たみ"],["の"],["ため"],["に"],["祈って","いのって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["嘆き","なげき"],["と"],["祈り","いのり"],["の"],["声","こえ"],["を"],["あげて"],["は"],["ならない"],["。"],[
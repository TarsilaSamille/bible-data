[{"verse":1,"text":"主はこう言われる。「行って、陶工の壺を買い、民の長老と、長老格の祭司を幾人か連れて、","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["行って","いって"],["、"],["陶工","とうこう"],["の"],["壺","つぼ"],["を"],["買い","かい"],["、"],["民","みん"],["の"],["長老","ちょうろう"],["と"],["、"],["長老","ちょうろう"],["格","かく"],["の"],["祭司","さいし"],["を"],["幾人","いくにん"],["か"],["連れて","つれて"],["、"]]},{"verse":2,"text":"陶片の門を出たところにある、ベン‧ヒノムの谷へ出て行き、そこでわたしがあなたに語る言葉を呼ばわって、","tok":[["陶片","とうへん"],["の"],["門","もん"],["を"],["出た","でた"],["ところ"],["に"],["ある"],["、"],["ベン"],["‧"],["ヒノム"],["の"],["谷","たに"],["へ"],["出て","でて"],["行き","いき"],["、"],["そこ"],["で"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["言葉","ことば"],["を"],["呼ばわって","よばわって"],["、"]]},{"verse":3,"text":"言うがいい。ユダの王たち、エルサレムの住民よ、主の言葉を聞け。イスラエルの神、万軍の主はこう言われる。見よ、わたしは災いをこのところにもたらす。それを聞く者は耳鳴りがする。","tok":[["言う","ゆう"],["が"],["いい"],["。"],["ユダ"],["の"],["王","おう"],["たち"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["よ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["災い","わざわい"],["を"],["この"],["ところ"],["に"],["もたらす"],["。"],["それ"],["を"],["聞く","きく"],["者","もの"],["は"],["耳鳴り","みみなり"],["が"],["する"],["。"]]},{"verse":4,"text":"それは彼らがわたしを捨て、このところを異教の地とし、そこで彼らも彼らの先祖もユダの王たちも知らなかった他の神々に香をたき、このところを無実の人の血で満たしたからである。","tok":[["それ"],["は"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["捨て","すて"],["、"],["この"],["ところ"],["を"],["異教","いきょう"],["の"],["地","ち"],["と"],["し"],["、"],["そこ"],["で"],["彼","かれ"],["ら"],["も"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["も"],["ユダ"],["の"],["王","おう"],["たち"],["も"],["知らなかった","しらなかった"],["他","ほか"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["、"],["この"],["ところ"],["を"],["無実","むじつ"],["の"],["人","ひと"],["の"],["血","ち"],["で"],["満たした","みたした"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"彼らはバアルのために聖なる高台を築き、息子たちを火で焼き、焼き尽くす献げ物としてバアルにささげた。わたしはこのようなことを命じもせず、語りもせず、心に思い浮かべもしなかった。","tok":[["彼","かれ"],["ら"],["は"],["バアル"],["の"],["ため"],["に"],["聖","せい"],["なる"],["高台","たかだい"],["を"],["築き","きずき"],["、"],["息子","むすこ"],["たち"],["を"],["火","ひ"],["で"],["焼き","やき"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["として"],["バアル"],["に"],["ささげた"],["。"],["わたし"],["は"],["この"],["よう"],["な"],["こと"],["を"],["命じ","めいじ"],["も"],["せず"],["、"],["語り","かたり"],["も"],["せず"],["、"],["心","こころ"],["に"],["思い浮かべ","おもいうかべ"],["も"],["しなかった"],["。"]]},{"verse":6,"text":"それゆえ、見よ、と主は言われる。このところがもはやトフェトとか、ベン‧ヒノムの谷とか呼ばれることなく、殺戮の谷と呼ばれる日が来る。","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["この"],["ところ"],["が"],["もはや"],["トフェト"],["と"],["か"],["、"],["ベン"],["‧"],["ヒノム"],["の"],["谷","たに"],["と"],["か"],["呼ばれる","よばれる"],["こと"],["なく"],["、"],["殺戮","さつりく"],["の"],["谷","たに"],["と"],["呼ばれる","よばれる"],["日","ひ"],["が"],["来る","くる"],["。"]]},{"verse":7,"text":"わたしはユダとエルサレムの策略をこのところで砕く。わたしは彼らを剣によって、敵の前に倒し、その命を奪おうとする者の手に渡し、彼らの死体を空の鳥、野の獣の餌食とする。","tok":[["わたし"],["は"],["ユダ"],["と"],["エルサレム"],["の"],["策略","さくりゃく"],["を"],["この"],["ところ"],["で"],["砕く","くだく"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["剣","けん"],["によって"],["、"],["敵","てき"],["の"],["前","まえ"],["に"],["倒し","たおし"],["、"],["その"],["命","いのち"],["を"],["奪おう","うばおう"],["と"],["する"],["者","もの"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["彼","かれ"],["ら"],["の"],["死体","したい"],["を"],["空","そら"],["の"],["鳥","とり"],["、"],["野","の"],["の"],["獣","けもの"],["の"],["餌食","えじき"],["と"],["する"],["。"]]},{"verse":8,"text":"わたしはこの都を恐怖の的とし、嘲られるものとする。通りかかる者は皆、恐怖を抱き、その打撃を見て嘲る。","tok":[["わたし"],["は"],["この"],["都","と"],["を"],["恐怖","きょうふ"],["の"],["的","まと"],["と"],["し"],["、"],["嘲られる","あざけられる"],["もの"],["と"],["する"],["。"],["通りかかる","とおりかかる"],["者","もの"],["は"],["皆","みな"],["、"],["恐怖","きょうふ"],["を"],["抱き","いだき"],["、"],["その"],["打撃","だげき"],["を"],["見て","みて"],["嘲る","あざける"],["。"]]},{"verse":9,"text":"彼らの敵と命を奪おうとする者が彼らを悩ますとき、その悩みと苦しみの中で、わたしは彼らに自分の息子や娘の肉を食らい、また互いに肉を食らうに至らせる。","tok":[["彼","かれ"],["ら"],["の"],["敵","てき"],["と"],["命","いのち"],["を"],["奪おう","うばおう"],["と"],["する"],["者","もの"],["が"],["彼","かれ"],["ら"],["を"],["悩ます","なやます"],["とき"],["、"],["その"],["悩み","なやみ"],["と"],["苦しみ","くるしみ"],["の"],["中","なか"],["で"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["自分","じぶん"],["の"],["息子","むすこ"],["や"],["娘","むすめ"],["の"],["肉","にく"],["を"],["食らい","くらい"],["、"],["また"],["互い","たがい"],["に"],["肉","にく"],["を"],["食らう","くらう"],["に"],["至らせる","いたらせる"],["。"]]},{"verse":10,"text":"あなたは、共に行く人々の見ているところで、その壺を砕き、","tok":[["あなた"],["は"],["、"],["共","とも"],["に"],["行く","いく"],["人々","ひとびと"],["の"],["見て","みて"],["いる"],["ところ"],["で"],["、"],["その"],["壺","つぼ"],["を"],["砕き","くだき"],["、"]]},{"verse":11,"text":"彼らに言うがよい。万軍の主はこう言われる。陶工の作った物は、一度砕いたなら元に戻すことができない。それほどに、わたしはこの民とこの都を砕く。人々は葬る場所がないのでトフェトに葬る。","tok":[["彼","かれ"],["ら"],["に"],["言う","ゆう"],["が"],["よい"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["陶工","とうこう"],["の"],["作った","つくった"],["物","もの"],["は"],["、"],["一度","いちど"],["砕いたなら","くだいたなら"],["元","もと"],["に"],["戻す","もどす"],["こと"],["が"],["できない"],["。"],["それ"],["ほど"],["に"],["、"],["わたし"],["は"],["この"],["民","たみ"],["と"],["この"],["都","と"],["を"],["砕く","くだく"],["。"],["人々","ひとびと"],["は"],["葬る","ほうむる"],["場所","ばしょ"],["が"],["ない"],["ので"],["トフェト"],["に"],["葬る","ほうむる"],["。"]]},{"verse":12,"text":"わたしはこのようにこのところとその住民とに対して行う、と主は言われる。そしてこの都をトフェトのようにする。","tok":[["わたし"],["は"],["この"],["よう"],["に"],["この"],["ところ"],["と"],["その"],["住民","じゅうみん"],["と"],["に対して","にたいして"],["行う","おこなう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["そして"],["この"],["都","と"],["を"],["トフェト"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":13,"text":"エルサレムの家々、ユダの王たちの家々は、トフェトのように汚れたものとなる。これらの家はすべて、屋上で人々が天の万象に香をたき、他の神々にぶどう酒の献げ物をささげた家だ。」","tok":[["エルサレム"],["の"],["家々","いえいえ"],["、"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["家々","いえいえ"],["は"],["、"],["トフェト"],["の"],["よう"],["に"],["汚れた","よごれた"],["もの"],["と"],["なる"],["。"],["これ"],["ら"],["の"],["家","いえ"],["は"],["すべて"],["、"],["屋上","おくじょう"],["で"],["人々","ひとびと"],["が"],["天","てん"],["の"],["万象","ばんしょう"],["に"],["香","こう"],["を"],["たき"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["ぶどう酒","ぶどうしゅ"],["の"],["献げ物","ささげもの"],["を"],["ささげた"],["家","いえ"],["だ"],["。"],["」"]]},{"verse":14,"text":"エレミヤは、主が預言させるために遣わされたトフェトから帰って来て、主の神殿の庭に立ち、民のすべてに向かって言った。","tok":[["エレミヤ"],["は"],["、"],["主","ぬし"],["が"],["預言","よげん"],["させる"],["ため"],["に"],["遣わされた","つかわされた"],["トフェト"],["から"],["帰って","かえって"],["来て","きて"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["庭","にわ"],["に"],["立ち","たち"],["、"],["民","みん"],["の"],["すべて"],["に"],["向かって","むかって"],["言った","いった"],["。"]]},{"verse":15,"text":"「イスラエルの神、万軍の主はこう言われる。見よ、わたしはこの都と、それに属するすべての町々に、わたしが告げたすべての災いをもたらす。彼らはうなじを固くし、わたしの言葉に聞き従おうとしなかったからだ。」","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["都","と"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["すべて"],["の"],["町々","まちまち"],["に"],["、"],["わたし"],["が"],["告げた","つげた"],["すべて"],["の"],["災い","わざわい"],["を"],["もたらす"],["。"],["彼","かれ"],["ら"],["は"],["うなじ"],["を"],["固く","かたく"],["し"],["、"],["わたし"],["の"],["言葉","ことば"],["に"],["聞き従おう","ききしたがおう"],["と"],["しなかった"],["から"],["だ"],["。"],["」"]]}]
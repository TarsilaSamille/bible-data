[{"verse":1,"text":"その同じ年、ユダの王ゼデキヤの治世の初め、第四年の五月に、主の神殿において、ギブオン出身の預言者、アズルの子ハナンヤが、祭司とすべての民の前でわたしに言った。","tok":[["その"],["同じ","おなじ"],["年","とし"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["治世","ちせい"],["の"],["初め","はじめ"],["、"],["第","だい"],["四","よん"],["年","ねん"],["の"],["五","ご"],["月","がつ"],["に"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["おいて"],["、"],["ギブオン"],["出身","しゅっしん"],["の"],["預言者","よげんしゃ"],["、"],["アズル"],["の"],["子","こ"],["ハナンヤ"],["が"],["、"],["祭司","さいし"],["と"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["わたし"],["に"],["言った","いった"],["。"]]},{"verse":2,"text":"「イスラエルの神、万軍の主はこう言われる。わたしはバビロンの王の軛を打ち砕く。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["バビロン"],["の"],["王","おう"],["の"],["軛","くびき"],["を"],["打ち砕く","うちくだく"],["。"]]},{"verse":3,"text":"二年のうちに、わたしはバビロンの王ネブカドネツァルがこの場所から奪って行った主の神殿の祭具をすべてこの場所に持ち帰らせる。","tok":[["二","に"],["年","ねん"],["の"],["うち"],["に"],["、"],["わたし"],["は"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["が"],["この"],["場所","ばしょ"],["から"],["奪って","うばって"],["行った","いった"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["祭具","さいぐ"],["を"],["すべて"],["この"],["場所","ばしょ"],["に"],["持ち帰らせる","もちかえらせる"],["。"]]},{"verse":4,"text":"また、バビロンへ連行されたユダの王、ヨヤキムの子エコンヤおよびバビロンへ行ったユダの捕囚の民をすべて、わたしはこの場所へ連れ帰る、と主は言われる。なぜなら、わたしがバビロンの王の軛を打ち砕くからである。」","tok":[["また"],["、"],["バビロン"],["へ"],["連行","れんこう"],["された"],["ユダ"],["の"],["王","おう"],["、"],["ヨヤキム"],["の"],["子","こ"],["エコンヤ"],["および"],["バビロン"],["へ"],["行った","いった"],["ユダ"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["を"],["すべて"],["、"],["わたし"],["は"],["この"],["場所","ばしょ"],["へ"],["連れ帰る","つれかえる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["なぜ"],["なら"],["、"],["わたし"],["が"],["バビロン"],["の"],["王","おう"],["の"],["軛","くびき"],["を"],["打ち砕く","うちくだく"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"そこで、預言者エレミヤは主の神殿に立っていた祭司たちとすべての民の前で、預言者ハナンヤに言った。","tok":[["そこ"],["で"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["立って","たって"],["いた"],["祭司","さいし"],["たち"],["と"],["すべて"],["の"],["民","たみ"],["の"],["前","まえ"],["で"],["、"],["預言者","よげんしゃ"],["ハナンヤ"],["に"],["言った","いった"],["。"]]},{"verse":6,"text":"預言者エレミヤは言った。「アーメン、どうか主がそのとおりにしてくださるように。どうか主があなたの預言の言葉を実現し、主の神殿の祭具と捕囚の民すべてをバビロンからこの場所に戻してくださるように。","tok":[["預言者","よげんしゃ"],["エレミヤ"],["は"],["言った","いった"],["。"],["「"],["アーメン"],["、"],["どう"],["か"],["主","ぬし"],["が"],["その"],["とおり"],["に"],["して"],["くださる"],["よう"],["に"],["。"],["どう"],["か"],["主","ぬし"],["が"],["あなた"],["の"],["預言","よげん"],["の"],["言葉","ことば"],["を"],["実現","じつげん"],["し"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["祭具","さいぐ"],["と"],["捕囚","ほしゅう"],["の"],["民","みん"],["すべて"],["を"],["バビロン"],["から"],["この"],["場所","ばしょ"],["に"],["戻して","もどして"],["くださる"],["よう"],["に"],["。"]]},{"verse":7,"text":"だが、わたしがあなたと民すべての耳に告げるこの言葉をよく聞け。","tok":[["だ"],["が"],["、"],["わたし"],["が"],["あなた"],["と"],["民","みん"],["すべて"],["の"],["耳","みみ"],["に"],["告げる","つげる"],["この"],["言葉","ことば"],["を"],["よく"],["聞け","きけ"],["。"]]},{"verse":8,"text":"あなたやわたしに先立つ昔の預言者たちは、多くの国、強大な王国に対して、戦争や災害や疫病を預言した。","tok":[["あなた"],["や"],["わたし"],["に"],["先立つ","さきだつ"],["昔","むかし"],["の"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["多く","おおく"],["の"],["国","くに"],["、"],["強大","きょうだい"],["な"],["王国","おうこく"],["に対して","にたいして"],["、"],["戦争","せんそう"],["や"],["災害","さいがい"],["や"],["疫病","やくびょう"],["を"],["預言","よげん"],["した"],["。"]]},{"verse":9,"text":"平和を預言する者は、その言葉が成就するとき初めて、まことに主が遣わされた預言者であることが分かる。」","tok":[["平和","へいわ"],["を"],["預言","よげん"],["する"],["者","もの"],["は"],["、"],["その"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["する"],["とき"],["初めて","はじめて"],["、"],["まこと"],["に"],["主","ぬし"],["が"],["遣わされた","つかわされた"],["預言者","よげんしゃ"],["で"],["ある"],["こと"],["が"],["分かる","わかる"],["。"],["」"]]},{"verse":10,"text":"すると預言者ハナンヤは、預言者エレミヤの首から軛をはずして打ち砕いた。","tok":[["する"],["と"],["預言者","よげんしゃ"],["ハナンヤ"],["は"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["首","くび"],["から"],["軛","くびき"],["を"],["はずして"],["打ち砕いた","うちくだいた"],["。"]]},{"verse":11,"text":"そして、ハナンヤは民すべての前で言った。「主はこう言われる。わたしはこのように、二年のうちに、あらゆる国々の首にはめられているバビロンの王ネブカドネツァルの軛を打ち砕く。」そこで、預言者エレミヤは立ち去った。","tok":[["そして"],["、"],["ハナンヤ"],["は"],["民","みん"],["すべて"],["の"],["前","まえ"],["で"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["この"],["よう"],["に"],["、"],["二","に"],["年","ねん"],["の"],["うち"],["に"],["、"],["あらゆる"],["国々","くにぐに"],["の"],["首","くび"],["に"],["はめられて"],["いる"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["の"],["軛","くびき"],["を"],["打ち砕く","うちくだく"],["。"],["」"],["そこ"],["で"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["立ち去った","たちさった"],["。"]]},{"verse":12,"text":"預言者ハナンヤが、預言者エレミヤの首から軛をはずして打ち砕いた後に、主の言葉がエレミヤに臨んだ。","tok":[["預言者","よげんしゃ"],["ハナンヤ"],["が"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["首","くび"],["から"],["軛","くびき"],["を"],["はずして"],["打ち砕いた","うちくだいた"],["後","あと"],["に"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":13,"text":"「行って、ハナンヤに言え。主はこう言われる。お前は木の軛を打ち砕いたが、その代わりに、鉄の軛を作った。","tok":[["「"],["行って","いって"],["、"],["ハナンヤ"],["に"],["言え","いえ"],["。"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["は"],["木","き"],["の"],["軛","くびき"],["を"],["打ち砕いた","うちくだいた"],["が"],["、"],["その"],["代わり","かわり"],["に"],["、"],["鉄","てつ"],["の"],["軛","くびき"],["を"],["作った","つくった"],["。"]]},{"verse":14,"text":"イスラエルの神、万軍の主はこう言われる。わたしは、これらの国すべての首に鉄の軛をはめて、バビロンの王ネブカドネツァルに仕えさせる。彼らはその奴隷となる。わたしは野の獣まで彼に与えた。」","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["これ"],["ら"],["の"],["国","くに"],["すべて"],["の"],["首","くび"],["に"],["鉄","てつ"],["の"],["軛","くびき"],["を"],["はめて"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["に"],["仕えさせる","つかえさせる"],["。"],["彼","かれ"],["ら"],["は"],["その"],["奴隷","どれい"],["と"],["なる"],["。"],["わたし"],["は"],["野","の"],["の"],["獣","けもの"],["まで"],["彼","かれ"],["に"],["与えた","あたえた"],["。"],["」"]]},{"verse":15,"text":"更に、預言者エレミヤは、預言者ハナンヤに言った。「ハナンヤよ、よく聞け。主はお前を遣わされていない。お前はこの民を安心させようとしているが、それは偽りだ。","tok":[["更に","さらに"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["は"],["、"],["預言者","よげんしゃ"],["ハナンヤ"],["に"],["言った","いった"],["。"],["「"],["ハナンヤ"],["よ"],["、"],["よく"],["聞け","きけ"],["。"],["主","ぬし"],["は"],["お前","おまえ"],["を"],["遣わされて","つかわされて"],["いない"],["。"],["お前","おまえ"],["は"],["この"],["民","たみ"],["を"],["安心","あんしん"],["させよう"],["として"],["いる"],["が"],["、"],["それ"],["は"],["偽り","いつわり"],["だ"],["。"]]},{"verse":16,"text":"それゆえ、主はこう言われる。『わたしはお前を地の面から追い払う』と。お前は今年のうちに死ぬ。主に逆らって語ったからだ。」","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["わたし"],["は"],["お前","おまえ"],["を"],["地","ち"],["の"],["面","めん"],["から"],["追い払う","おいはらう"],["』"],["と"],["。"],["お前","おまえ"],["は"],["今年","ことし"],["の"],["うち"],["に"],["死ぬ","しぬ"],["。"],["主に","おもに"],["逆らって","さからって"],["語った","かたった"],["から"],["だ"],["。"],["」"]]},{"verse":17,"text":"預言者ハナンヤは、その年の七月に死んだ。","tok":[["預言者","よげんしゃ"],["ハナンヤ"],["は"],["、"],["その"],["年","とし"],["の"],["七","なな"],["月","がつ"],["に"],["死んだ","しんだ"],["。"]]}]
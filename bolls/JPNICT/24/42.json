[{"verse":1,"text":"カレアの子ヨハナンとホシャヤの子エザンヤをはじめ、すべての軍の長と民の全員が、身分の上下を問わず、訪ねて来て、","tok":[["カレア"],["の"],["子","こ"],["ヨハナン"],["と"],["ホシャヤ"],["の"],["子","こ"],["エザンヤ"],["を"],["はじめ"],["、"],["すべて"],["の"],["軍","ぐん"],["の"],["長","ちょう"],["と"],["民","たみ"],["の"],["全員","ぜんいん"],["が"],["、"],["身分","みぶん"],["の"],["上下","じょうげ"],["を"],["問わず","とわず"],["、"],["訪ねて","たずねて"],["来て","きて"],["、"]]},{"verse":2,"text":"預言者エレミヤに言った。「どうか、我々の願いを受け入れてください。我々のため、またこの残った人々のために、あなたの神である主に祈ってください。御覧のとおり、大勢の中からわずかに、我々だけが残ったのです。","tok":[["預言者","よげんしゃ"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["どう"],["か"],["、"],["我々","われわれ"],["の"],["願い","ねがい"],["を"],["受け入れて","うけいれて"],["ください"],["。"],["我々","われわれ"],["の"],["ため"],["、"],["また"],["この"],["残った","のこった"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["に"],["祈って","いのって"],["ください"],["。"],["御覧","ごらん"],["の"],["とおり"],["、"],["大勢","おおぜい"],["の"],["中","なか"],["から"],["わずか"],["に"],["、"],["我々","われわれ"],["だけ"],["が"],["残った","のこった"],["の"],["です"],["。"]]},{"verse":3,"text":"あなたの神である主に求めて、我々に歩むべき道、なすべきことを示していただきたいのです。」","tok":[["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["に"],["求めて","もとめて"],["、"],["我々","われわれ"],["に"],["歩むべき","あゆむべき"],["道","みち"],["、"],["なすべき"],["こと"],["を"],["示して","しめして"],["いただきたい"],["の"],["です"],["。"],["」"]]},{"verse":4,"text":"預言者エレミヤは答えた。「承知しました。おっしゃるとおり、あなたたちの神である主に祈りましょう。主があなたたちに答えられるなら、そのすべての言葉をお伝えします。」","tok":[["預言者","よげんしゃ"],["エレミヤ"],["は"],["答えた","こたえた"],["。"],["「"],["承知","しょうち"],["しました"],["。"],["おっしゃる"],["とおり"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["に"],["祈りましょう","いのりましょう"],["。"],["主","ぬし"],["が"],["あなた"],["たち"],["に"],["答えられるなら","こたえられるなら"],["、"],["その"],["すべて"],["の"],["言葉","ことば"],["を"],["お伝え","おつたえ"],["します"],["。"],["」"]]},{"verse":5,"text":"すると、人々はエレミヤに言った。「主が我々に対して真実の証人となられますように。わたしたちは、必ずあなたの神である主が、あなたを我々に遣わして告げられる言葉のとおり、すべて実行することを誓います。","tok":[["する"],["と"],["、"],["人々","ひとびと"],["は"],["エレミヤ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["我々","われわれ"],["に対して","にたいして"],["真実","しんじつ"],["の"],["証人","しょうにん"],["と"],["なられます"],["よう"],["に"],["。"],["わたしたち"],["は"],["、"],["必ず","かならず"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["、"],["あなた"],["を"],["我々","われわれ"],["に"],["遣わして","つかわして"],["告げられる","つげられる"],["言葉","ことば"],["の"],["とおり"],["、"],["すべて"],["実行","じっこう"],["する"],["こと"],["を"],["誓います","ちかいます"],["。"]]},{"verse":6,"text":"良くても悪くても、我々はあなたを遣わして語られる我々の神である主の御声に聞き従います。我々の神である主の御声に聞き従うことこそ最善なのですから。」","tok":[["良くて","よくて"],["も"],["悪くて","わるくて"],["も"],["、"],["我々","われわれ"],["は"],["あなた"],["を"],["遣わして","つかわして"],["語られる","かたられる"],["我々","われわれ"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従います","ききしたがいます"],["。"],["我々","われわれ"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従う","ききしたがう"],["こと"],["こそ"],["最善","さいぜん"],["な"],["の"],["です"],["から"],["。"],["」"]]},{"verse":7,"text":"十日たって、主の言葉がエレミヤに臨んだ。","tok":[["十日","とうか"],["たって"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":8,"text":"そこで、エレミヤはカレアの子ヨハナンと、彼と共にいたすべての軍の長たちをはじめ、身分の上下を問わず、民の全員を召集し、","tok":[["そこ"],["で"],["、"],["エレミヤ"],["は"],["カレア"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["すべて"],["の"],["軍","ぐん"],["の"],["長","なが"],["たち"],["を"],["はじめ"],["、"],["身分","みぶん"],["の"],["上下","じょうげ"],["を"],["問わず","とわず"],["、"],["民","みん"],["の"],["全員","ぜんいん"],["を"],["召集","しょうしゅう"],["し"],["、"]]},{"verse":9,"text":"次のように語った。「あなたたちは、わたしを主のもとに遣わし、あなたたちの願いを受け入れてくださるよう求めさせたが、そのイスラエルの神、主はこう言われる。","tok":[["次","つぎ"],["の"],["よう"],["に"],["語った","かたった"],["。"],["「"],["あなた"],["たち"],["は"],["、"],["わたし"],["を"],["主","ぬし"],["の"],["もと"],["に"],["遣わし","つかわし"],["、"],["あなた"],["たち"],["の"],["願い","ねがい"],["を"],["受け入れて","うけいれて"],["くださる"],["よう"],["求めさせた","もとめさせた"],["が"],["、"],["その"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"もし、あなたたちがこの国にとどまるならば、わたしはあなたたちを立て、倒しはしない。植えて、抜きはしない。わたしはあなたたちにくだした災いを悔いている。","tok":[["もし"],["、"],["あなた"],["たち"],["が"],["この"],["国","くに"],["に"],["とどまるならば"],["、"],["わたし"],["は"],["あなた"],["たち"],["を"],["立て","たて"],["、"],["倒し","たおし"],["は"],["しない"],["。"],["植えて","うえて"],["、"],["抜き","ぬき"],["は"],["しない"],["。"],["わたし"],["は"],["あなた"],["たち"],["に"],["くだした"],["災い","わざわい"],["を"],["悔いて","くいて"],["いる"],["。"]]},{"verse":11,"text":"今、あなたたちはバビロンの王を恐れているが、彼を恐れてはならない。彼を恐れるな、と主は言われる。わたしがあなたたちと共にいて、必ず救い、彼の手から助け出すからである。","tok":[["今","いま"],["、"],["あなた"],["たち"],["は"],["バビロン"],["の"],["王","おう"],["を"],["恐れて","おそれて"],["いる"],["が"],["、"],["彼","かれ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["彼","かれ"],["を"],["恐れる","おそれる"],["な"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["が"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いて"],["、"],["必ず","かならず"],["救い","すくい"],["、"],["彼","かれ"],["の"],["手","て"],["から"],["助け出す","たすけだす"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"わたしはあなたたちに憐れみを示す。バビロンの王もあなたたちに憐れみを示して、この土地に住むことを許すであろう。","tok":[["わたし"],["は"],["あなた"],["たち"],["に"],["憐れみ","あわれみ"],["を"],["示す","しめす"],["。"],["バビロン"],["の"],["王","おう"],["も"],["あなた"],["たち"],["に"],["憐れみ","あわれみ"],["を"],["示して","しめして"],["、"],["この"],["土地","とち"],["に"],["住む","すむ"],["こと"],["を"],["許すで","ゆるすで"],["あろう"],["。"]]},{"verse":13,"text":"もしあなたたちが、『我々はこの国にとどまることはできない』と言って、あなたたちの神である主の声に聞き従わず、","tok":[["もし"],["あなた"],["たち"],["が"],["、"],["『"],["我々","われわれ"],["は"],["この"],["国","くに"],["に"],["とどまる"],["こと"],["は"],["できない"],["』"],["と"],["言って","いって"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["声","こえ"],["に"],["聞き従わず","ききしたがわず"],["、"]]},{"verse":14,"text":"また、『いや、エジプトの地へ行こう。あそこでは戦争もないし、危険を知らせる角笛の音もせず、食べ物がなくて飢えることもない。あそこへ行って住もう』と言うなら、","tok":[["また"],["、"],["『"],["いや"],["、"],["エジプト"],["の"],["地","ち"],["へ"],["行こう","いこう"],["。"],["あそこ"],["で"],["は"],["戦争","せんそう"],["も"],["ない"],["し"],["、"],["危険","きけん"],["を"],["知らせる","しらせる"],["角笛","つのぶえ"],["の"],["音","おと"],["も"],["せず"],["、"],["食べ物","たべもの"],["が"],["なくて"],["飢える","うえる"],["こと"],["も"],["ない"],["。"],["あそこ"],["へ"],["行って","いって"],["住もう","すもう"],["』"],["と"],["言うなら","ゆうなら"],["、"]]},{"verse":15,"text":"今、ユダの残った人々よ、主の言葉を聞くがよい。イスラエルの神、万軍の主はこう言われる。もしあなたたちが、どうしてもエジプトへ行こうと決意し、そこに行って寄留するなら、","tok":[["今","いま"],["、"],["ユダ"],["の"],["残った","のこった"],["人々","ひとびと"],["よ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["が"],["よい"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["もし"],["あなた"],["たち"],["が"],["、"],["どう"],["して"],["も"],["エジプト"],["へ"],["行こう","いこう"],["と"],["決意","けつい"],["し"],["、"],["そこ"],["に"],["行って","いって"],["寄留","きりゅう"],["するなら"],["、"]]},{"verse":16,"text":"まさに、あなたたちが恐れている剣が、エジプトの地で襲いかかり、心配している飢えがエジプトまで後を追ってとりつき、あなたたちはそこで死ぬ。","tok":[["まさに"],["、"],["あなた"],["たち"],["が"],["恐れて","おそれて"],["いる"],["剣","けん"],["が"],["、"],["エジプト"],["の"],["地","ち"],["で"],["襲いかかり","おそいかかり"],["、"],["心配","しんぱい"],["して"],["いる"],["飢え","うえ"],["が"],["エジプト"],["まで"],["後","あと"],["を"],["追って","おって"],["とりつき"],["、"],["あなた"],["たち"],["は"],["そこ"],["で"],["死ぬ","しぬ"],["。"]]},{"verse":17,"text":"エジプトへ行って寄留しようと決意している者はすべて剣、飢饉、疫病で死ぬ。わたしが臨ませる災いを免れ、生き残る者はひとりもない。","tok":[["エジプト"],["へ"],["行って","いって"],["寄留","きりゅう"],["しよう"],["と"],["決意","けつい"],["して"],["いる"],["者","もの"],["は"],["すべて"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["疫病","やくびょう"],["で"],["死ぬ","しぬ"],["。"],["わたし"],["が"],["臨ませる","のぞませる"],["災い","わざわい"],["を"],["免れ","まぬがれ"],["、"],["生き残る","いきのこる"],["者","もの"],["は"],["ひとり"],["も"],["ない"],["。"]]},{"verse":18,"text":"まことに、イスラエルの神、万軍の主はこう言われる。あなたたちがエジプトへ行けば、わたしの怒りと憤りがエルサレムの住民にふりかかったように、あなたたちにふりかかる。あなたたちは、呪い、恐怖、ののしり、恥辱の的となり、二度とこの場所を見ることはできない。","tok":[["まこと"],["に"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["あなた"],["たち"],["が"],["エジプト"],["へ"],["行けば","いけば"],["、"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["が"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["ふりかかった"],["よう"],["に"],["、"],["あなた"],["たち"],["に"],["ふりかかる"],["。"],["あなた"],["たち"],["は"],["、"],["呪い","のろい"],["、"],["恐怖","きょうふ"],["、"],["ののしり"],["、"],["恥辱","ちじょく"],["の"],["的","まと"],["と"],["なり"],["、"],["二","に"],["度","ど"],["と"],["この"],["場所","ばしょ"],["を"],["見る","みる"],["こと"],["は"],["できない"],["。"]]},{"verse":19,"text":"ユダの残った人々よ、主はあなたたちに対して、『エジプトへ行ってはならない』と語られた。今日、わたしがこの警告を伝えたことを、しっかり心に留めなさい。","tok":[["ユダ"],["の"],["残った","のこった"],["人々","ひとびと"],["よ"],["、"],["主","ぬし"],["は"],["あなた"],["たち"],["に対して","にたいして"],["、"],["『"],["エジプト"],["へ"],["行って","いって"],["は"],["ならない"],["』"],["と"],["語られた","かたられた"],["。"],["今日","きょう"],["、"],["わたし"],["が"],["この"],["警告","けいこく"],["を"],["伝えた","つたえた"],["こと"],["を"],["、"],["しっかり"],["心","こころ"],["に"],["留め","とめ"],["なさい"],["。"]]},{"verse":20,"text":"あなたたちは、致命的な誤りを犯そうとしている。『我々のために我々の神である主に祈ってください。我々の神である主が語られることを知らせてくださるなら、すべてそのとおりにします』と言って、わたしをあなたたちの神である主のもとに遣わしたのは、あなたたち自身である。","tok":[["あなた"],["たち"],["は"],["、"],["致命的","ちめいてき"],["な"],["誤り","あやまり"],["を"],["犯そう","おかそう"],["として"],["いる"],["。"],["『"],["我々","われわれ"],["の"],["ため"],["に"],["我々","われわれ"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["に"],["祈って","いのって"],["ください"],["。"],["我々","われわれ"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["語られる","かたられる"],["こと"],["を"],["知らせて","しらせて"],["くださるなら"],["、"],["すべて"],["その"],["とおり"],["に"],["します"],["』"],["と"],["言って","いって"],["、"],["わたし"],["を"],["あなた"],["たち"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["もと"],["に"],["遣わした","つかわした"],["の"],["は"],["、"],["あなた"],["たち"],["自身","じしん"],["で"],["ある"],["。"]]},{"verse":21,"text":"そこで、わたしが今日それを告げたのに、自分の神である主の声を聞こうとせず、主がわたしを遣わして語られたことを全く聞こうとしない。","tok":[["そこ"],["で"],["、"],["わたし"],["が"],["今日","きょう"],["それ"],["を"],["告げた","つげた"],["のに"],["、"],["自分","じぶん"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["の"],["声","こえ"],["を"],["聞こう","きこう"],["と"],["せず"],["、"],["主","ぬし"],["が"],["わたし"],["を"],["遣わして","つかわして"],["語られた","かたられた"],["こと"],["を"],["全く","まったく"],["聞こう","きこう"],["と"],["しない"],["。"]]},{"verse":22,"text":"だから今、行って寄留しようとしているその場所で、あなたたちは剣、飢饉、疫病によって死ぬことを、しっかりと知らねばならない。」","tok":[["だ"],["から"],["今","いま"],["、"],["行って","いって"],["寄留","きりゅう"],["しよう"],["として"],["いる"],["その"],["場所","ばしょ"],["で"],["、"],["あなた"],["たち"],["は"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["疫病","やくびょう"],["によって"],["死ぬ","しぬ"],["こと"],["を"],["、"],["しっかり"],["と"],["知らねば","しらねば"],["ならない"],["。"],["」"]]}]
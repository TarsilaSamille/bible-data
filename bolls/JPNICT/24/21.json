[{"verse":1,"text":"ゼデキヤ王に派遣されて、マルキヤの子パシュフルとマアセヤの子、祭司ツェファンヤが来たとき、主からエレミヤに臨んだ言葉。彼らは言った。","tok":[["ゼデキヤ"],["王","おう"],["に"],["派遣","はけん"],["されて"],["、"],["マルキヤ"],["の"],["子","こ"],["パシュフル"],["と"],["マアセヤ"],["の"],["子","こ"],["、"],["祭司","さいし"],["ツェファンヤ"],["が"],["来た","きた"],["とき"],["、"],["主","ぬし"],["から"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"]]},{"verse":2,"text":"「どうか、わたしたちのために主に伺ってください。バビロンの王ネブカドレツァルがわたしたちを攻めようとしています。主はこれまでのように驚くべき御業を、わたしたちにもしてくださるかもしれません。そうすれば彼は引き上げるでしょう。」","tok":[["「"],["どう"],["か"],["、"],["わたしたち"],["の"],["ため"],["に"],["主","ぬし"],["に"],["伺って","うかがって"],["ください"],["。"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["が"],["わたしたち"],["を"],["攻めよう","せめよう"],["として"],["います"],["。"],["主","ぬし"],["は"],["これ"],["まで"],["の"],["よう"],["に"],["驚くべき","おどろくべき"],["御業","ごごう"],["を"],["、"],["わたしたち"],["に"],["も"],["して"],["くださる"],["か"],["も"],["しれません"],["。"],["そう"],["すれば"],["彼","かれ"],["は"],["引き上げるでしょう","ひきあげるでしょう"],["。"],["」"]]},{"verse":3,"text":"エレミヤは彼らに答えた。「ゼデキヤにこう言いなさい。","tok":[["エレミヤ"],["は"],["彼","かれ"],["ら"],["に"],["答えた","こたえた"],["。"],["「"],["ゼデキヤ"],["に"],["こう"],["言い","いい"],["なさい"],["。"]]},{"verse":4,"text":"イスラエルの神、主はこう言われる。見よ、お前たちを包囲しているバビロンの王やカルデア人と、お前たちは武器を手にして戦ってきたが、わたしはその矛先を城壁の外から転じさせ、この都の真ん中に集める。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["お前","おまえ"],["たち"],["を"],["包囲","ほうい"],["して"],["いる"],["バビロン"],["の"],["王","おう"],["や"],["カルデア"],["人","にん"],["と"],["、"],["お前","おまえ"],["たち"],["は"],["武器","ぶき"],["を"],["手","て"],["に"],["して"],["戦って","たたかって"],["きた"],["が"],["、"],["わたし"],["は"],["その"],["矛先","ほこさき"],["を"],["城壁","じょうへき"],["の"],["外","そと"],["から"],["転じさせ","てんじさせ"],["、"],["この"],["都","と"],["の"],["真ん中","まんなか"],["に"],["集める","あつめる"],["。"]]},{"verse":5,"text":"わたしは手を伸ばし、力ある腕をもってお前たちに敵対し、怒り、憤り、激怒して戦う。","tok":[["わたし"],["は"],["手","て"],["を"],["伸ばし","のばし"],["、"],["力","ちから"],["ある"],["腕","うで"],["を"],["もって"],["お前","おまえ"],["たち"],["に"],["敵対","てきたい"],["し"],["、"],["怒り","いかり"],["、"],["憤り","いきどおり"],["、"],["激怒","げきど"],["して"],["戦う","たたかう"],["。"]]},{"verse":6,"text":"そして、この都に住む者を、人も獣も撃つ。彼らは激しい疫病によって死ぬ。","tok":[["そして"],["、"],["この"],["都","と"],["に"],["住む","すむ"],["者","もの"],["を"],["、"],["人","ひと"],["も"],["獣","けもの"],["も"],["撃つ","うつ"],["。"],["彼","かれ"],["ら"],["は"],["激しい","はげしい"],["疫病","やくびょう"],["によって"],["死ぬ","しぬ"],["。"]]},{"verse":7,"text":"その後、と主は言われる。わたしはユダの王ゼデキヤとその家臣、その民のうち、疫病、戦争、飢饉を生き延びてこの都に残った者を、バビロンの王ネブカドレツァルの手、敵の手、命を奪おうとする者の手に渡す。バビロンの王は彼らを剣をもって撃つ。ためらわず、惜しまず、憐れまない。","tok":[["その"],["後","ご"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["と"],["その"],["家臣","かしん"],["、"],["その"],["民","たみ"],["の"],["うち"],["、"],["疫病","やくびょう"],["、"],["戦争","せんそう"],["、"],["飢饉","ききん"],["を"],["生き延びて","いきのびて"],["この"],["都","と"],["に"],["残った","のこった"],["者","もの"],["を"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["の"],["手","て"],["、"],["敵","てき"],["の"],["手","て"],["、"],["命","いのち"],["を"],["奪おう","うばおう"],["と"],["する"],["者","もの"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["バビロン"],["の"],["王","おう"],["は"],["彼","かれ"],["ら"],["を"],["剣","けん"],["を"],["もって"],["撃つ","うつ"],["。"],["ためらわず"],["、"],["惜しまず","おしまず"],["、"],["憐れまない","あわれまない"],["。"]]},{"verse":8,"text":"あなたはこの民に向かって言うがよい。主はこう言われる。見よ、わたしはお前たちの前に命の道と死の道を置く。","tok":[["あなた"],["は"],["この"],["民","たみ"],["に"],["向かって","むかって"],["言う","ゆう"],["が"],["よい"],["。"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["前","まえ"],["に"],["命","いのち"],["の"],["道","みち"],["と"],["死","し"],["の"],["道","みち"],["を"],["置く","おく"],["。"]]},{"verse":9,"text":"この都にとどまる者は、戦いと飢饉と疫病によって死ぬ。この都を出て包囲しているカルデア人に、降伏する者は生き残り、命だけは助かる。","tok":[["この"],["都","と"],["に"],["とどまる"],["者","もの"],["は"],["、"],["戦い","たたかい"],["と"],["飢饉","ききん"],["と"],["疫病","やくびょう"],["によって"],["死ぬ","しぬ"],["。"],["この"],["都","と"],["を"],["出て","でて"],["包囲","ほうい"],["して"],["いる"],["カルデア"],["人","にん"],["に"],["、"],["降伏","こうふく"],["する"],["者","もの"],["は"],["生き残り","いきのこり"],["、"],["命","いのち"],["だけ"],["は"],["助かる","たすかる"],["。"]]},{"verse":10,"text":"わたしは、顔をこの都に向けて災いをくだし、幸いを与えない、と主は言われる。この都はバビロンの王の手に渡され、火で焼き払われる。」","tok":[["わたし"],["は"],["、"],["顔","かお"],["を"],["この"],["都","と"],["に"],["向けて","むけて"],["災い","わざわい"],["を"],["くだし"],["、"],["幸い","さいわい"],["を"],["与えない","あたえない"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["この"],["都","と"],["は"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["火","ひ"],["で"],["焼き払われる","やきはらわれる"],["。"],["」"]]},{"verse":11,"text":"ユダの王家に対して。「主の言葉を聞け。","tok":[["ユダ"],["の"],["王家","おうけ"],["に対して","にたいして"],["。"],["「"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":12,"text":"ダビデの家よ、主はこう言われる。朝ごとに正しい裁きを行え。搾取されている人を虐げる者の手から救い出せ。わたしが火のような怒りを発することのないように。お前たちの悪事のゆえにその火は燃え消す者はいないであろう。","tok":[["ダビデ"],["の"],["家","いえ"],["よ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["朝","あさ"],["ごと"],["に"],["正しい","ただしい"],["裁き","さばき"],["を"],["行え","おこなえ"],["。"],["搾取","さくしゅ"],["されて"],["いる"],["人","ひと"],["を"],["虐げる","しいたげる"],["者","もの"],["の"],["手","て"],["から"],["救い出せ","すくいだせ"],["。"],["わたし"],["が"],["火","ひ"],["の"],["よう"],["な"],["怒り","いかり"],["を"],["発する","はっする"],["こと"],["の"],["ない"],["よう"],["に"],["。"],["お前","おまえ"],["たち"],["の"],["悪事","あくじ"],["の"],["ゆえ"],["に"],["その"],["火","ひ"],["は"],["燃え","もえ"],["消す","けす"],["者","もの"],["は"],["いないで"],["あろう"],["。"]]},{"verse":13,"text":"谷に臨んで座する者よ、平野の岩よ見よ、わたしはお前に向かう、と主は言われる。『誰が我々に襲いかかるであろうか誰が我々の住まいに攻め寄せるだろうか』と言う者よ","tok":[["谷","たに"],["に"],["臨んで","のぞんで"],["座する","ざする"],["者","もの"],["よ"],["、"],["平野","へいや"],["の"],["岩","いわ"],["よ"],["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["に"],["向かう","むかう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["『"],["誰","だれ"],["が"],["我々","われわれ"],["に"],["襲いかかるで","おそいかかるで"],["あろう"],["か"],["誰","だれ"],["が"],["我々","われわれ"],["の"],["住まい","すまい"],["に"],["攻め寄せるだろう","せめよせるだろう"],["か"],["』"],["と"],["言う","いう"],["者","もの"],["よ"]]},{"verse":14,"text":"わたしはお前たちの悪事の結果に従って報いると主は言われる。わたしは火を周囲の森に放ち火はすべてを焼き尽くす。」","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["悪事","あくじ"],["の"],["結果","けっか"],["に"],["従って","したがって"],["報いる","むくいる"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["火","ひ"],["を"],["周囲","しゅうい"],["の"],["森","もり"],["に"],["放ち","はなち"],["火","ひ"],["は"],["すべて"],["を"],["焼き","やき"],["尽くす","つくす"],["。"],["」"]]}]
[{"verse":1,"text":"主はわたしに言われた。「たとえモーセとサムエルが執り成そうとしても、わたしはこの民を顧みない。わたしの前から彼らを追い出しなさい。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["たとえ"],["モーセ"],["と"],["サムエル"],["が"],["執り成そう","とりなそう"],["として"],["も"],["、"],["わたし"],["は"],["この"],["民","たみ"],["を"],["顧みない","かえりみない"],["。"],["わたし"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い出し","おいだし"],["なさい"],["。"]]},{"verse":2,"text":"彼らがあなたに向かって、『どこへ行けばよいのか』と問うならば、彼らに答えて言いなさい。『主はこう言われる。疫病に定められた者は、疫病に剣に定められた者は、剣に飢えに定められた者は、飢えに捕囚に定められた者は、捕囚に。』","tok":[["彼","かれ"],["ら"],["が"],["あなた"],["に"],["向かって","むかって"],["、"],["『"],["どこ"],["へ"],["行けば","いけば"],["よい"],["の"],["か"],["』"],["と"],["問うならば","とうならば"],["、"],["彼","かれ"],["ら"],["に"],["答えて","こたえて"],["言い","いい"],["なさい"],["。"],["『"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["疫病","やくびょう"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["、"],["疫病","やくびょう"],["に"],["剣","けん"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["、"],["剣","けん"],["に"],["飢え","うえ"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["、"],["飢え","うえ"],["に"],["捕囚","ほしゅう"],["に"],["定められた","さだめられた"],["者","もの"],["は"],["、"],["捕囚","ほしゅう"],["に"],["。"],["』"]]},{"verse":3,"text":"わたしは彼らを四種のもので罰する、と主は言われる。剣が殺し、犬が引きずって行き、空の鳥と地の獣が餌食として滅ぼす。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["四","よん"],["種","しゅ"],["の"],["もの"],["で"],["罰する","ばっする"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["剣","けん"],["が"],["殺し","ころし"],["、"],["犬","いぬ"],["が"],["引きずって","ひきずって"],["行き","いき"],["、"],["空","そら"],["の"],["鳥","とり"],["と"],["地","ち"],["の"],["獣","けもの"],["が"],["餌食","えじき"],["として"],["滅ぼす","ほろぼす"],["。"]]},{"verse":4,"text":"わたしは地上のすべての国が、彼らを見て恐怖を抱くようにする。それはヒゼキヤの子ユダの王マナセがエルサレムでしたことのためである。」","tok":[["わたし"],["は"],["地上","ちじょう"],["の"],["すべて"],["の"],["国","くに"],["が"],["、"],["彼","かれ"],["ら"],["を"],["見て","みて"],["恐怖","きょうふ"],["を"],["抱く","いだく"],["よう"],["に"],["する"],["。"],["それ"],["は"],["ヒゼキヤ"],["の"],["子","こ"],["ユダ"],["の"],["王","おう"],["マナセ"],["が"],["エルサレム"],["でした"],["こと"],["の"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"エルサレムよ、誰がお前を憐れみ誰がお前のために嘆くであろうか。誰が安否を問おうとして、立ち寄るであろうか。","tok":[["エルサレム"],["よ"],["、"],["誰","だれ"],["が"],["お前","おまえ"],["を"],["憐れみ","あわれみ"],["誰","だれ"],["が"],["お前","おまえ"],["の"],["ため"],["に"],["嘆くで","なげくで"],["あろう"],["か"],["。"],["誰","だれ"],["が"],["安否","あんぴ"],["を"],["問おう","とおう"],["として"],["、"],["立ち寄るで","たちよるで"],["あろう"],["か"],["。"]]},{"verse":6,"text":"お前はわたしを捨て、背いて行ったと主は言われる。わたしは手を伸ばしてお前を滅ぼす。お前を憐れむことに疲れた。","tok":[["お前","おまえ"],["は"],["わたし"],["を"],["捨て","すて"],["、"],["背いて","そむいて"],["行った","いった"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["手","て"],["を"],["伸ばして","のばして"],["お前","おまえ"],["を"],["滅ぼす","ほろぼす"],["。"],["お前","おまえ"],["を"],["憐れむ","あわれむ"],["こと"],["に"],["疲れた","つかれた"],["。"]]},{"verse":7,"text":"わたしはこの地の町々の城門で彼らを箕であおり、まき散らしわが民の子らを奪い、滅ぼす。彼らがその道を改めないからだ。","tok":[["わたし"],["は"],["この"],["地","ち"],["の"],["町々","まちまち"],["の"],["城門","じょうもん"],["で"],["彼","かれ"],["ら"],["を"],["箕","み"],["で"],["あおり"],["、"],["まき散らし","まきちらし"],["わが"],["民","たみ"],["の"],["子","こ"],["ら"],["を"],["奪い","うばい"],["、"],["滅ぼす","ほろぼす"],["。"],["彼","かれ"],["ら"],["が"],["その"],["道","みち"],["を"],["改めない","あらためない"],["から"],["だ"],["。"]]},{"verse":8,"text":"やもめの数は海の砂よりも多くなった。わたしは白昼、荒らす者に若者の母を襲わせた。彼女はたちまち恐れとおののきに捕らえられ","tok":[["やもめ"],["の"],["数","かず"],["は"],["海","うみ"],["の"],["砂","すな"],["より"],["も"],["多く","おおく"],["なった"],["。"],["わたし"],["は"],["白昼","はくちゅう"],["、"],["荒らす","あらす"],["者","もの"],["に"],["若者","わかもの"],["の"],["母","はは"],["を"],["襲わせた","おそわせた"],["。"],["彼女","かのじょ"],["は"],["たちまち"],["恐れ","おそれ"],["と"],["おののき"],["に"],["捕らえられ","とらえられ"]]},{"verse":9,"text":"七人の子の母はくずおれてあえぐ。太陽は日盛りに沈み彼女はうろたえ、絶望する。わたしは敵の前で民の残りの者を剣に渡すと主は言われる。","tok":[["七人","しちにん"],["の"],["子","こ"],["の"],["母","はは"],["は"],["くずおれて"],["あえぐ"],["。"],["太陽","たいよう"],["は"],["日盛り","ひざかり"],["に"],["沈み","しずみ"],["彼女","かのじょ"],["は"],["うろたえ"],["、"],["絶望","ぜつぼう"],["する"],["。"],["わたし"],["は"],["敵","てき"],["の"],["前","まえ"],["で"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["剣","けん"],["に"],["渡す","わたす"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"ああ、わたしは災いだ。わが母よ、どうしてわたしを産んだのか。国中でわたしは争いの絶えぬ男いさかいの絶えぬ男とされている。わたしはだれの債権者になったこともだれの債務者になったこともないのにだれもがわたしを呪う。","tok":[["ああ"],["、"],["わたし"],["は"],["災い","わざわい"],["だ"],["。"],["わが"],["母","はは"],["よ"],["、"],["どう"],["して"],["わたし"],["を"],["産んだ","うんだ"],["の"],["か"],["。"],["国中","くにちゅう"],["で"],["わたし"],["は"],["争い","あらそい"],["の"],["絶えぬ","たえぬ"],["男","おとこ"],["いさかい"],["の"],["絶えぬ","たえぬ"],["男","おとこ"],["と"],["されて"],["いる"],["。"],["わたし"],["は"],["だれ"],["の"],["債権者","さいけんしゃ"],["に"],["なった"],["こと"],["も"],["だれ"],["の"],["債務者","さいむしゃ"],["に"],["なった"],["こと"],["も"],["ない"],["のに"],["だれ"],["も"],["が"],["わたし"],["を"],["呪う","のろう"],["。"]]},{"verse":11,"text":"主よ、わたしは敵対する者のためにも幸いを願い彼らに災いや苦しみの襲うときあなたに執り成しをしたではありませんか。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["は"],["敵対","てきたい"],["する"],["者","もの"],["の"],["ため"],["に"],["も"],["幸い","さいわい"],["を"],["願い","ねがい"],["彼","かれ"],["ら"],["に"],["災い","わざわい"],["や"],["苦しみ","くるしみ"],["の"],["襲う","おそう"],["とき"],["あなた"],["に"],["執り成し","とりなし"],["を"],["した"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":12,"text":"鉄は砕かれるだろうか北からの鉄と青銅は。","tok":[["鉄","てつ"],["は"],["砕かれるだろう","くだかれるだろう"],["か"],["北","きた"],["から"],["の"],["鉄","てつ"],["と"],["青銅","せいどう"],["は"],["。"]]},{"verse":13,"text":"わたしはお前の富と宝をお前のあらゆる罪の報いとして至るところで、敵の奪うにまかせる。","tok":[["わたし"],["は"],["お前","おまえ"],["の"],["富","とみ"],["と"],["宝","たから"],["を"],["お前","おまえ"],["の"],["あらゆる"],["罪","つみ"],["の"],["報い","むくい"],["として"],["至る","いたる"],["ところ"],["で"],["、"],["敵","てき"],["の"],["奪う","うばう"],["に"],["まかせる"],["。"]]},{"verse":14,"text":"また、お前を敵の奴隷としお前の知らない国に行かせる。わたしの怒りによって火が点じられお前たちに対して燃え続ける。","tok":[["また"],["、"],["お前","おまえ"],["を"],["敵","てき"],["の"],["奴隷","どれい"],["と"],["し"],["お前","おまえ"],["の"],["知らない","しらない"],["国","くに"],["に"],["行かせる","いかせる"],["。"],["わたし"],["の"],["怒り","いかり"],["によって"],["火","ひ"],["が"],["点じられ","てんじられ"],["お前","おまえ"],["たち"],["に対して","にたいして"],["燃え","もえ"],["続ける","つづける"],["。"]]},{"verse":15,"text":"あなたはご存じのはずです。主よ、わたしを思い起こし、わたしを顧みわたしを迫害する者に復讐してください。いつまでも怒りを抑えてわたしが取り去られるようなことがないようにしてください。わたしがあなたのゆえに辱めに耐えているのを知ってください。","tok":[["あなた"],["は"],["ご存じ","ごぞんじ"],["の"],["はず"],["です"],["。"],["主","ぬし"],["よ"],["、"],["わたし"],["を"],["思い起こし","おもいおこし"],["、"],["わたし"],["を"],["顧み","かえりみ"],["わたし"],["を"],["迫害","はくがい"],["する"],["者","もの"],["に"],["復讐","ふくしゅう"],["して"],["ください"],["。"],["いつ"],["まで"],["も"],["怒り","いかり"],["を"],["抑えて","おさえて"],["わたし"],["が"],["取り去られる","とりさられる"],["よう"],["な"],["こと"],["が"],["ない"],["よう"],["に"],["して"],["ください"],["。"],["わたし"],["が"],["あなた"],["の"],["ゆえ"],["に"],["辱め","はずかしめ"],["に"],["耐えて","たえて"],["いる"],["の"],["を"],["知って","しって"],["ください"],["。"]]},{"verse":16,"text":"あなたの御言葉が見いだされたときわたしはそれをむさぼり食べました。あなたの御言葉は、わたしのものとなりわたしの心は喜び躍りました。万軍の神、主よ。わたしはあなたの御名をもって呼ばれている者です。","tok":[["あなた"],["の"],["御言葉","おことば"],["が"],["見いだされた","みいだされた"],["とき"],["わたし"],["は"],["それ"],["を"],["むさぼり食べました","むさぼりたべました"],["。"],["あなた"],["の"],["御言葉","おことば"],["は"],["、"],["わたし"],["の"],["もの"],["と"],["なり"],["わたし"],["の"],["心","こころ"],["は"],["喜び","よろこび"],["躍りました","おどりました"],["。"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["わたし"],["は"],["あなた"],["の"],["御名","ぎょめい"],["を"],["もって"],["呼ばれて","よばれて"],["いる"],["者","もの"],["です"],["。"]]},{"verse":17,"text":"わたしは笑い戯れる者と共に座って楽しむことなく御手に捕らえられ、独りで座っていました。あなたはわたしを憤りで満たされました。","tok":[["わたし"],["は"],["笑い","わらい"],["戯れる","たわむれる"],["者","もの"],["と"],["共","とも"],["に"],["座って","すわって"],["楽しむ","たのしむ"],["こと"],["なく"],["御手","おて"],["に"],["捕らえられ","とらえられ"],["、"],["独り","ひとり"],["で"],["座って","すわって"],["いました"],["。"],["あなた"],["は"],["わたし"],["を"],["憤り","いきどおり"],["で"],["満たされました","みたされました"],["。"]]},{"verse":18,"text":"なぜ、わたしの痛みはやむことなくわたしの傷は重くて、いえないのですか。あなたはわたしを裏切り当てにならない流れのようになられました。","tok":[["なぜ"],["、"],["わたし"],["の"],["痛み","いたみ"],["は"],["やむ"],["こと"],["なく"],["わたし"],["の"],["傷","きず"],["は"],["重くて","おもくて"],["、"],["いえない"],["の"],["です"],["か"],["。"],["あなた"],["は"],["わたし"],["を"],["裏切り","うらぎり"],["当て","あて"],["に"],["ならない"],["流れ","ながれ"],["の"],["よう"],["に"],["なられました"],["。"]]},{"verse":19,"text":"それに対して、主はこう言われた。「あなたが帰ろうとするならわたしのもとに帰らせわたしの前に立たせよう。もし、あなたが軽率に言葉を吐かず熟慮して語るならわたしはあなたを、わたしの口とする。あなたが彼らの所に帰るのではない。彼らこそあなたのもとに帰るのだ。","tok":[["それ"],["に対して","にたいして"],["、"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["「"],["あなた"],["が"],["帰ろう","かえろう"],["と"],["するなら"],["わたし"],["の"],["もと"],["に"],["帰らせ","かえらせ"],["わたし"],["の"],["前","まえ"],["に"],["立たせよう","たたせよう"],["。"],["もし"],["、"],["あなた"],["が"],["軽率","けいそつ"],["に"],["言葉","ことば"],["を"],["吐かず","はかず"],["熟慮","じゅくりょ"],["して"],["語るなら","かたるなら"],["わたし"],["は"],["あなた"],["を"],["、"],["わたし"],["の"],["口","くち"],["と"],["する"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["所","ところ"],["に"],["帰る","かえる"],["ので"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["こそ"],["あなた"],["の"],["もと"],["に"],["帰る","かえる"],["の"],["だ"],["。"]]},{"verse":20,"text":"この民に対してわたしはあなたを堅固な青銅の城壁とする。彼らはあなたに戦いを挑むが勝つことはできない。わたしがあなたと共にいて助けあなたを救い出す、と主は言われる。","tok":[["この"],["民","たみ"],["に対して","にたいして"],["わたし"],["は"],["あなた"],["を"],["堅固","けんご"],["な"],["青銅","せいどう"],["の"],["城壁","じょうへき"],["と"],["する"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["戦い","たたかい"],["を"],["挑む","いどむ"],["が"],["勝つ","かつ"],["こと"],["は"],["できない"],["。"],["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["いて"],["助け","たすけ"],["あなた"],["を"],["救い出す","すくいだす"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":21,"text":"わたしはあなたを悪人の手から救い出し強暴な者の手から解き放つ。」","tok":[["わたし"],["は"],["あなた"],["を"],["悪人","あくにん"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["強暴","きょうぼう"],["な"],["者","もの"],["の"],["手","て"],["から"],["解き放つ","ときはなつ"],["。"],["」"]]}]
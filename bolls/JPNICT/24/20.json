[{"verse":1,"text":"主の神殿の最高監督者である祭司、イメルの子パシュフルは、エレミヤが預言してこれらの言葉を語るのを聞いた。","tok":[["主","ぬし"],["の"],["神殿","しんでん"],["の"],["最高","さいこう"],["監督者","かんとくしゃ"],["で"],["ある"],["祭司","さいし"],["、"],["イメル"],["の"],["子","こ"],["パシュフル"],["は"],["、"],["エレミヤ"],["が"],["預言","よげん"],["して"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["語る","かたる"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"パシュフルは預言者エレミヤを打たせ、主の家の上のベニヤミン門に拘留した。","tok":[["パシュフル"],["は"],["預言者","よげんしゃ"],["エレミヤ"],["を"],["打たせ","うたせ"],["、"],["主","ぬし"],["の"],["家","いえ"],["の"],["上","うえ"],["の"],["ベニヤミン"],["門","もん"],["に"],["拘留","こうりゅう"],["した"],["。"]]},{"verse":3,"text":"翌日、パシュフルがエレミヤの拘留を解いたとき、エレミヤは彼に言った。「主はお前の名をパシュフルではなく、『恐怖が四方から迫る』と呼ばれる。","tok":[["翌日","よくじつ"],["、"],["パシュフル"],["が"],["エレミヤ"],["の"],["拘留","こうりゅう"],["を"],["解いた","といた"],["とき"],["、"],["エレミヤ"],["は"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["お前","おまえ"],["の"],["名","な"],["を"],["パシュフル"],["で"],["は"],["なく"],["、"],["『"],["恐怖","きょうふ"],["が"],["四方","しほう"],["から"],["迫る","せまる"],["』"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":4,"text":"主はこう言われる。見よ、わたしはお前を『恐怖』に引き渡す。お前も、お前の親しい者も皆。彼らは敵の剣に倒れ、お前は自分の目でそれを見る。わたしはユダの人をことごとく、バビロンの王の手に渡す。彼は彼らを捕囚としてバビロンに連れ去り、また剣にかけて殺す。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["を"],["『"],["恐怖","きょうふ"],["』"],["に"],["引き渡す","ひきわたす"],["。"],["お前","おまえ"],["も"],["、"],["お前","おまえ"],["の"],["親しい","したしい"],["者","もの"],["も"],["皆","みな"],["。"],["彼","かれ"],["ら"],["は"],["敵","てき"],["の"],["剣","けん"],["に"],["倒れ","たおれ"],["、"],["お前","おまえ"],["は"],["自分","じぶん"],["の"],["目","め"],["で"],["それ"],["を"],["見る","みる"],["。"],["わたし"],["は"],["ユダ"],["の"],["人","ひと"],["を"],["ことごとく"],["、"],["バビロン"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["を"],["捕囚","ほしゅう"],["として"],["バビロン"],["に"],["連れ去り","つれさり"],["、"],["また"],["剣","けん"],["に"],["かけて"],["殺す","ころす"],["。"]]},{"verse":5,"text":"わたしはこの都に蓄えられている物、労して得た物、高価な物、ユダの王たちの宝物をすべて敵の手に渡す。彼らはそれを奪い取り、バビロンへ運び去る。","tok":[["わたし"],["は"],["この"],["都","と"],["に"],["蓄えられて","たくわえられて"],["いる"],["物","もの"],["、"],["労して","ろうして"],["得た","えた"],["物","もの"],["、"],["高価","こうか"],["な"],["物","もの"],["、"],["ユダ"],["の"],["王","おう"],["たち"],["の"],["宝物","たからもの"],["を"],["すべて"],["敵","てき"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["奪い取り","うばいとり"],["、"],["バビロン"],["へ"],["運び去る","はこびさる"],["。"]]},{"verse":6,"text":"パシュフルよ、お前は一族の者と共に、捕らえられて行き、バビロンに行って死に、そこに葬られる。お前も、お前の偽りの預言を聞いた親しい者らも共に。」","tok":[["パシュフル"],["よ"],["、"],["お前","おまえ"],["は"],["一族","いちぞく"],["の"],["者","もの"],["と"],["共","とも"],["に"],["、"],["捕らえられて","とらえられて"],["行き","いき"],["、"],["バビロン"],["に"],["行って","いって"],["死に","しに"],["、"],["そこ"],["に"],["葬られる","ほうむられる"],["。"],["お前","おまえ"],["も"],["、"],["お前","おまえ"],["の"],["偽り","いつわり"],["の"],["預言","よげん"],["を"],["聞いた","きいた"],["親しい","したしい"],["者","もの"],["ら"],["も"],["共","とも"],["に"],["。"],["」"]]},{"verse":7,"text":"主よ、あなたがわたしを惑わしわたしは惑わされてあなたに捕らえられました。あなたの勝ちです。わたしは一日中、笑い者にされ人が皆、わたしを嘲ります。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["が"],["わたし"],["を"],["惑わし","まどわし"],["わたし"],["は"],["惑わされて","まどわされて"],["あなた"],["に"],["捕らえられました","とらえられました"],["。"],["あなた"],["の"],["勝ち","かち"],["です"],["。"],["わたし"],["は"],["一","いち"],["日中","にちちゅう"],["、"],["笑い者","わらいもの"],["に"],["され"],["人","ひと"],["が"],["皆","みな"],["、"],["わたし"],["を"],["嘲ります","あざけります"],["。"]]},{"verse":8,"text":"わたしが語ろうとすれば、それは嘆きとなり「不法だ、暴力だ」と叫ばずにはいられません。主の言葉のゆえに、わたしは一日中恥とそしりを受けねばなりません。","tok":[["わたし"],["が"],["語ろう","かたろう"],["と"],["すれば"],["、"],["それ"],["は"],["嘆き","なげき"],["と"],["なり"],["「"],["不法","ふほう"],["だ"],["、"],["暴力","ぼうりょく"],["だ"],["」"],["と"],["叫ばず","さけばず"],["に"],["は"],["いられません"],["。"],["主","ぬし"],["の"],["言葉","ことば"],["の"],["ゆえ"],["に"],["、"],["わたし"],["は"],["一","いち"],["日中","にちちゅう"],["恥","はじ"],["と"],["そ"],["しり"],["を"],["受けねば","うけねば"],["なりません"],["。"]]},{"verse":9,"text":"主の名を口にすまいもうその名によって語るまい、と思っても主の言葉は、わたしの心の中骨の中に閉じ込められて火のように燃え上がります。押さえつけておこうとしてわたしは疲れ果てました。わたしの負けです。","tok":[["主","ぬし"],["の"],["名","な"],["を"],["口","くち"],["に"],["すまい"],["もう"],["その"],["名","な"],["によって"],["語るまい","かたるまい"],["、"],["と"],["思って","おもって"],["も"],["主","ぬし"],["の"],["言葉","ことば"],["は"],["、"],["わたし"],["の"],["心","こころ"],["の"],["中骨","なかぼね"],["の"],["中","なか"],["に"],["閉じ込められて","とじこめられて"],["火","ひ"],["の"],["よう"],["に"],["燃え上がります","もえあがります"],["。"],["押さえつけて","おさえつけて"],["おこう"],["として"],["わたし"],["は"],["疲れ","つかれ"],["果てました","はてました"],["。"],["わたし"],["の"],["負け","まけ"],["です"],["。"]]},{"verse":10,"text":"わたしには聞こえています多くの人の非難が。「恐怖が四方から迫る」と彼らは言う。「共に彼を弾劾しよう」と。わたしの味方だった者も皆わたしがつまずくのを待ち構えている。「彼は惑わされて我々は勝つことができる。彼に復讐してやろう」と。","tok":[["わたし"],["に"],["は"],["聞こえて","きこえて"],["います"],["多く","おおく"],["の"],["人","ひと"],["の"],["非難","ひなん"],["が"],["。"],["「"],["恐怖","きょうふ"],["が"],["四方","しほう"],["から"],["迫る","せまる"],["」"],["と"],["彼","かれ"],["ら"],["は"],["言う","ゆう"],["。"],["「"],["共","とも"],["に"],["彼","かれ"],["を"],["弾劾","だんがい"],["しよう"],["」"],["と"],["。"],["わたし"],["の"],["味方","みかた"],["だった"],["者","もの"],["も"],["皆","みな"],["わたし"],["が"],["つまずく"],["の"],["を"],["待ち構えて","まちかまえて"],["いる"],["。"],["「"],["彼","かれ"],["は"],["惑わされて","まどわされて"],["我々","われわれ"],["は"],["勝つ","かつ"],["こと"],["が"],["できる"],["。"],["彼","かれ"],["に"],["復讐","ふくしゅう"],["して"],["やろう"],["」"],["と"],["。"]]},{"verse":11,"text":"しかし主は、恐るべき勇士としてわたしと共にいます。それゆえ、わたしを迫害する者はつまずき勝つことを得ず、成功することなく甚だしく辱めを受ける。それは忘れられることのないとこしえの恥辱である。","tok":[["しかし"],["主","ぬし"],["は"],["、"],["恐るべき","おそるべき"],["勇士","ゆうし"],["として"],["わたし"],["と"],["共","とも"],["に"],["います"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["を"],["迫害","はくがい"],["する"],["者","もの"],["は"],["つまずき"],["勝つ","かつ"],["こと"],["を"],["得ず","えず"],["、"],["成功","せいこう"],["する"],["こと"],["なく"],["甚だしく","はなはだしく"],["辱め","はずかしめ"],["を"],["受ける","うける"],["。"],["それ"],["は"],["忘れられる","わすれられる"],["こと"],["の"],["ない"],["とこしえ"],["の"],["恥辱","ちじょく"],["で"],["ある"],["。"]]},{"verse":12,"text":"万軍の主よ正義をもって人のはらわたと心を究め見抜かれる方よ。わたしに見させてくださいあなたが彼らに復讐されるのを。わたしの訴えをあなたに打ち明けお任せします。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["よ"],["正義","まさよし"],["を"],["もって"],["人","ひと"],["の"],["はらわた"],["と"],["心","こころ"],["を"],["究め","きわめ"],["見抜かれる","みぬかれる"],["方","かた"],["よ"],["。"],["わたし"],["に"],["見させて","みさせて"],["ください"],["あなた"],["が"],["彼","かれ"],["ら"],["に"],["復讐","ふくしゅう"],["される"],["の"],["を"],["。"],["わたし"],["の"],["訴え","うったえ"],["を"],["あなた"],["に"],["打ち明け","うちあけ"],["お任せ","おまかせ"],["します"],["。"]]},{"verse":13,"text":"主に向かって歌い、主を賛美せよ。主は貧しい人の魂を悪事を謀る者の手から助け出される。","tok":[["主に","おもに"],["向かって","むかって"],["歌い","うたい"],["、"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],["。"],["主","ぬし"],["は"],["貧しい","まずしい"],["人","ひと"],["の"],["魂","たましい"],["を"],["悪事","あくじ"],["を"],["謀る","はかる"],["者","もの"],["の"],["手","て"],["から"],["助け出される","たすけだされる"],["。"]]},{"verse":14,"text":"呪われよ、わたしの生まれた日は。母がわたしを産んだ日は祝福されてはならない。","tok":[["呪われよ","のろわれよ"],["、"],["わたし"],["の"],["生まれた","うまれた"],["日","ひ"],["は"],["。"],["母","はは"],["が"],["わたし"],["を"],["産んだ","うんだ"],["日","ひ"],["は"],["祝福","しゅくふく"],["されて"],["は"],["ならない"],["。"]]},{"verse":15,"text":"呪われよ、父に良い知らせをもたらしあなたに男の子が生まれたと言って大いに喜ばせた人は。","tok":[["呪われよ","のろわれよ"],["、"],["父","ちち"],["に"],["良い","よい"],["知らせ","しらせ"],["を"],["もたらし"],["あなた"],["に"],["男の子","おとこのこ"],["が"],["生まれた","うまれた"],["と"],["言って","いって"],["大いに","おおいに"],["喜ばせた","よろこばせた"],["人","ひと"],["は"],["。"]]},{"verse":16,"text":"その人は、憐れみを受けることなく主に滅ぼされる町のように朝には助けを求める叫びを聞き昼には鬨の声を聞くであろう。","tok":[["その"],["人","ひと"],["は"],["、"],["憐れみ","あわれみ"],["を"],["受ける","うける"],["こと"],["なく"],["主に","おもに"],["滅ぼされる","ほろぼされる"],["町","まち"],["の"],["よう"],["に"],["朝","あさ"],["に"],["は"],["助け","たすけ"],["を"],["求める","もとめる"],["叫び","さけび"],["を"],["聞き","きき"],["昼","ひる"],["に"],["は"],["鬨の声","ときのこえ"],["を"],["聞くで","きくで"],["あろう"],["。"]]},{"verse":17,"text":"その日は、わたしを母の胎内で殺さず母をわたしの墓とせずはらんだその胎をそのままにしておかなかったから。","tok":[["その"],["日","ひ"],["は"],["、"],["わたし"],["を"],["母","はは"],["の"],["胎内","たいない"],["で"],["殺さず","ころさず"],["母","はは"],["を"],["わたし"],["の"],["墓","はか"],["と"],["せず"],["はらんだ"],["その"],["胎","はら"],["を"],["そのまま"],["に"],["して"],["おかなかった"],["から"],["。"]]},{"verse":18,"text":"なぜ、わたしは母の胎から出て労苦と嘆きに遭い生涯を恥の中に終わらねばならないのか。","tok":[["なぜ"],["、"],["わたし"],["は"],["母","はは"],["の"],["胎","はら"],["から"],["出て","でて"],["労苦","ろうく"],["と"],["嘆き","なげき"],["に"],["遭い","あい"],["生涯","しょうがい"],["を"],["恥","はじ"],["の"],["中","なか"],["に"],["終わらねば","おわらねば"],["ならない"],["の"],["か"],["。"]]}]
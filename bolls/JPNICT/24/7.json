[{"verse":1,"text":"主からエレミヤに臨んだ言葉。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"]]},{"verse":2,"text":"主の神殿の門に立ち、この言葉をもって呼びかけよ。そして、言え。「主を礼拝するために、神殿の門を入って行くユダの人々よ、皆、主の言葉を聞け。","tok":[["主","ぬし"],["の"],["神殿","しんでん"],["の"],["門","もん"],["に"],["立ち","たち"],["、"],["この"],["言葉","ことば"],["を"],["もって"],["呼びかけ","よびかけ"],["よ"],["。"],["そして"],["、"],["言え","いえ"],["。"],["「"],["主","ぬし"],["を"],["礼拝","れいはい"],["する"],["ため"],["に"],["、"],["神殿","しんでん"],["の"],["門","もん"],["を"],["入って","はいって"],["行く","いく"],["ユダ"],["の"],["人々","ひとびと"],["よ"],["、"],["皆","みな"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":3,"text":"イスラエルの神、万軍の主はこう言われる。お前たちの道と行いを正せ。そうすれば、わたしはお前たちをこの所に住まわせる。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["の"],["道","みち"],["と"],["行い","おこない"],["を"],["正せ","ただせ"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["この"],["所","ところ"],["に"],["住まわせる","すまわせる"],["。"]]},{"verse":4,"text":"主の神殿、主の神殿、主の神殿という、むなしい言葉に依り頼んではならない。","tok":[["主","ぬし"],["の"],["神殿","しんでん"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["と"],["いう"],["、"],["むなしい"],["言葉","ことば"],["に"],["依り頼んで","よりたのんで"],["は"],["ならない"],["。"]]},{"verse":5,"text":"この所で、お前たちの道と行いを正し、お互いの間に正義を行い、寄留の外国人、孤児、寡婦を虐げず、無実の人の血を流さず、異教の神々に従うことなく、自ら災いを招いてはならない。","tok":[["この"],["所","ところ"],["で"],["、"],["お前","おまえ"],["たち"],["の"],["道","みち"],["と"],["行い","おこない"],["を"],["正し","ただし"],["、"],["お互い","おたがい"],["の"],["間","あいだ"],["に"],["正義","せいぎ"],["を"],["行い","おこない"],["、"],["寄留","きりゅう"],["の"],["外国人","がいこくじん"],["、"],["孤児","こじ"],["、"],["寡婦","かふ"],["を"],["虐げず","しいたげず"],["、"],["無実","むじつ"],["の"],["人","ひと"],["の"],["血","ち"],["を"],["流さず","ながさず"],["、"],["異教","いきょう"],["の"],["神々","かみがみ"],["に"],["従う","したがう"],["こと"],["なく"],["、"],["自ら","みずから"],["災い","わざわい"],["を"],["招いて","まねいて"],["は"],["ならない"],["。"]]},{"verse":7,"text":"そうすれば、わたしはお前たちを先祖に与えたこの地、この所に、とこしえからとこしえまで住まわせる。","tok":[["そう"],["すれば"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["この"],["地","ち"],["、"],["この"],["所","ところ"],["に"],["、"],["とこしえ"],["から"],["とこしえ"],["まで"],["住まわせる","すまわせる"],["。"]]},{"verse":8,"text":"しかし見よ、お前たちはこのむなしい言葉に依り頼んでいるが、それは救う力を持たない。","tok":[["しかし"],["見よ","みよ"],["、"],["お前","おまえ"],["たち"],["は"],["この"],["むなしい"],["言葉","ことば"],["に"],["依り頼んで","よりたのんで"],["いる"],["が"],["、"],["それ"],["は"],["救う","すくう"],["力","ちから"],["を"],["持たない","もたない"],["。"]]},{"verse":9,"text":"盗み、殺し、姦淫し、偽って誓い、バアルに香をたき、知ることのなかった異教の神々に従いながら、","tok":[["盗み","ぬすみ"],["、"],["殺し","ころし"],["、"],["姦淫","かんいん"],["し"],["、"],["偽って","いつわって"],["誓い","ちかい"],["、"],["バアル"],["に"],["香","こう"],["を"],["たき"],["、"],["知る","しる"],["こと"],["の"],["なかった"],["異教","いきょう"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["ながら"],["、"]]},{"verse":10,"text":"わたしの名によって呼ばれるこの神殿に来てわたしの前に立ち、『救われた』と言うのか。お前たちはあらゆる忌むべきことをしているではないか。","tok":[["わたし"],["の"],["名","な"],["によって"],["呼ばれる","よばれる"],["この"],["神殿","しんでん"],["に"],["来て","きて"],["わたし"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["『"],["救われた","すくわれた"],["』"],["と"],["言う","いう"],["の"],["か"],["。"],["お前","おまえ"],["たち"],["は"],["あらゆる"],["忌むべき","いむべき"],["こと"],["を"],["して"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":11,"text":"わたしの名によって呼ばれるこの神殿は、お前たちの目に強盗の巣窟と見えるのか。そのとおり。わたしにもそう見える、と主は言われる。","tok":[["わたし"],["の"],["名","な"],["によって"],["呼ばれる","よばれる"],["この"],["神殿","しんでん"],["は"],["、"],["お前","おまえ"],["たち"],["の"],["目","め"],["に"],["強盗","ごうとう"],["の"],["巣窟","そうくつ"],["と"],["見える","みえる"],["の"],["か"],["。"],["その"],["とおり"],["。"],["わたし"],["に"],["も"],["そう"],["見える","みえる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"シロのわたしの聖所に行ってみよ。かつてわたしはそこにわたしの名を置いたが、わが民イスラエルの悪のゆえに、わたしがそれをどのようにしたかを見るがよい。","tok":[["シロ"],["の"],["わたし"],["の"],["聖","せい"],["所","しょ"],["に"],["行って","いって"],["み"],["よ"],["。"],["かつて"],["わたし"],["は"],["そこ"],["に"],["わたし"],["の"],["名","な"],["を"],["置いた","おいた"],["が"],["、"],["わが"],["民","みん"],["イスラエル"],["の"],["悪","あく"],["の"],["ゆえ"],["に"],["、"],["わたし"],["が"],["それ"],["を"],["どの"],["よう"],["に"],["した"],["か"],["を"],["見る","みる"],["が"],["よい"],["。"]]},{"verse":13,"text":"今や、お前たちがこれらのことをしたから――と主は言われる――そしてわたしが先に繰り返し語ったのに、その言葉に従わず、呼びかけたのに答えなかったから、","tok":[["今","いま"],["や"],["、"],["お前","おまえ"],["たち"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["した"],["から"],["―"],["―"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["―"],["―"],["そして"],["わたし"],["が"],["先","さき"],["に"],["繰り返し","くりかえし"],["語った","かたった"],["のに"],["、"],["その"],["言葉","ことば"],["に"],["従わず","したがわず"],["、"],["呼びかけた","よびかけた"],["のに"],["答えなかった","こたえなかった"],["から"],["、"]]},{"verse":14,"text":"わたしの名によって呼ばれ、お前たちが依り頼んでいるこの神殿に、そしてお前たちと先祖に与えたこの所に対して、わたしはシロにしたようにする。","tok":[["わたし"],["の"],["名","な"],["によって"],["呼ばれ","よばれ"],["、"],["お前","おまえ"],["たち"],["が"],["依り頼んで","よりたのんで"],["いる"],["この"],["神殿","しんでん"],["に"],["、"],["そして"],["お前","おまえ"],["たち"],["と"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["この"],["所","ところ"],["に対して","にたいして"],["、"],["わたし"],["は"],["シロ"],["に"],["した"],["よう"],["に"],["する"],["。"]]},{"verse":15,"text":"わたしは、お前たちの兄弟である、エフライムの子孫をすべて投げ捨てたように、お前たちをわたしの前から投げ捨てる。」","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["の"],["兄弟","きょうだい"],["で"],["ある"],["、"],["エフライム"],["の"],["子孫","しそん"],["を"],["すべて"],["投げ捨てた","なげすてた"],["よう"],["に"],["、"],["お前","おまえ"],["たち"],["を"],["わたし"],["の"],["前","まえ"],["から"],["投げ捨てる","なげすてる"],["。"],["」"]]},{"verse":16,"text":"あなたはこの民のために祈ってはならない。彼らのために嘆きと祈りの声をあげてわたしを煩わすな。わたしはあなたに耳を傾けない。","tok":[["あなた"],["は"],["この"],["民","たみ"],["の"],["ため"],["に"],["祈って","いのって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["嘆き","なげき"],["と"],["祈り","いのり"],["の"],["声","こえ"],["を"],["あげて"],["わたし"],["を"],["煩わす","わずらわす"],["な"],["。"],["わたし"],["は"],["あなた"],["に"],["耳","みみ"],["を"],["傾けない","かたむけない"],["。"]]},{"verse":17,"text":"ユダの町々、エルサレムの巷で彼らがどのようなことをしているか、あなたには見えないのか。","tok":[["ユダ"],["の"],["町々","まちまち"],["、"],["エルサレム"],["の"],["巷","ちまた"],["で"],["彼","かれ"],["ら"],["が"],["どのような"],["こと"],["を"],["して"],["いる"],["か"],["、"],["あなた"],["に"],["は"],["見えない","みえない"],["の"],["か"],["。"]]},{"verse":18,"text":"子らは薪を集め、父は火を燃やし、女たちは粉を練り、天の女王のために献げ物の菓子を作り、異教の神々に献げ物のぶどう酒を注いで、わたしを怒らせている。","tok":[["子","こ"],["ら"],["は"],["薪","たきぎ"],["を"],["集め","あつめ"],["、"],["父","ちち"],["は"],["火","ひ"],["を"],["燃やし","もやし"],["、"],["女","おんな"],["たち"],["は"],["粉","こな"],["を"],["練り","ねり"],["、"],["天","てん"],["の"],["女王","じょおう"],["の"],["ため"],["に"],["献げ物","ささげもの"],["の"],["菓子","かし"],["を"],["作り","つくり"],["、"],["異教","いきょう"],["の"],["神々","かみがみ"],["に"],["献げ物","ささげもの"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["注いで","そそいで"],["、"],["わたし"],["を"],["怒らせて","おこらせて"],["いる"],["。"]]},{"verse":19,"text":"彼らはわたしを怒らせているのか――と主は言われる――むしろ、自らの恥によって自らを怒らせているのではないか。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["を"],["怒らせて","おこらせて"],["いる"],["の"],["か"],["―"],["―"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["―"],["―"],["むしろ"],["、"],["自ら","みずから"],["の"],["恥","はじ"],["によって"],["自ら","みずから"],["を"],["怒らせて","おこらせて"],["いる"],["ので"],["は"],["ない"],["か"],["。"]]},{"verse":20,"text":"それゆえ、主なる神はこう言われる。見よ、わたしの怒りと憤りが、この所で、人間、家畜、野の木、地の実りに注がれる。それは燃え上がり、消えることはない。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["が"],["、"],["この"],["所","ところ"],["で"],["、"],["人間","にんげん"],["、"],["家畜","かちく"],["、"],["野","の"],["の"],["木","き"],["、"],["地","ち"],["の"],["実り","みのり"],["に"],["注がれる","そそがれる"],["。"],["それ"],["は"],["燃え上がり","もえあがり"],["、"],["消える","きえる"],["こと"],["は"],["ない"],["。"]]},{"verse":21,"text":"イスラエルの神、万軍の主はこう言われる。お前たちの焼き尽くす献げ物の肉を、いけにえの肉に加えて食べるがよい。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["の"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["の"],["肉","にく"],["を"],["、"],["いけにえ"],["の"],["肉","にく"],["に"],["加えて","くわえて"],["食べる","たべる"],["が"],["よい"],["。"]]},{"verse":22,"text":"わたしはお前たちの先祖をエジプトの地から導き出したとき、わたしは焼き尽くす献げ物やいけにえについて、語ったことも命じたこともない。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["先祖","せんぞ"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["とき"],["、"],["わたし"],["は"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["や"],["いけにえ"],["について"],["、"],["語った","かたった"],["こと"],["も"],["命じた","めいじた"],["こと"],["も"],["ない"],["。"]]},{"verse":23,"text":"むしろ、わたしは次のことを彼らに命じた。「わたしの声に聞き従え。そうすれば、わたしはあなたたちの神となり、あなたたちはわたしの民となる。わたしが命じる道にのみ歩むならば、あなたたちは幸いを得る。」","tok":[["むしろ"],["、"],["わたし"],["は"],["次","つぎ"],["の"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["。"],["「"],["わたし"],["の"],["声","こえ"],["に"],["聞き従え","ききしたがえ"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["神","かみ"],["と"],["なり"],["、"],["あなた"],["たち"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なる"],["。"],["わたし"],["が"],["命じる","めいじる"],["道","みち"],["に"],["のみ"],["歩むならば","あゆむならば"],["、"],["あなた"],["たち"],["は"],["幸い","さいわい"],["を"],["得る","うる"],["。"],["」"]]},{"verse":24,"text":"しかし、彼らは聞き従わず、耳を傾けず、彼らのかたくなで悪い心のたくらみに従って歩み、わたしに背を向け、顔を向けなかった。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["聞き従わず","ききしたがわず"],["、"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["彼","かれ"],["ら"],["の"],["かたくな"],["で"],["悪い","わるい"],["心","こころ"],["の"],["たくらみ"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"],["わたし"],["に"],["背","せ"],["を"],["向け","むけ"],["、"],["顔","かお"],["を"],["向けなかった","むけなかった"],["。"]]},{"verse":25,"text":"お前たちの先祖がエジプトの地から出たその日から、今日に至るまで、わたしの僕である預言者らを、常に繰り返しお前たちに遣わした。","tok":[["お前","おまえ"],["たち"],["の"],["先祖","せんぞ"],["が"],["エジプト"],["の"],["地","ち"],["から"],["出た","でた"],["その"],["日","ひ"],["から"],["、"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["わたし"],["の"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["ら"],["を"],["、"],["常","つね"],["に"],["繰り返し","くりかえし"],["お前","おまえ"],["たち"],["に"],["遣わした","つかわした"],["。"]]},{"verse":26,"text":"それでも、わたしに聞き従わず、耳を傾けず、かえって、うなじを固くし、先祖よりも悪い者となった。","tok":[["それ"],["で"],["も"],["、"],["わたし"],["に"],["聞き従わず","ききしたがわず"],["、"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["かえって"],["、"],["うなじ"],["を"],["固く","かたく"],["し"],["、"],["先祖","せんぞ"],["より"],["も"],["悪い","わるい"],["者","もの"],["と"],["なった"],["。"]]},{"verse":27,"text":"あなたが彼らにこれらすべての言葉を語っても、彼らはあなたに聞き従わず、呼びかけても答えないであろう。","tok":[["あなた"],["が"],["彼","かれ"],["ら"],["に"],["これ"],["ら"],["すべて"],["の"],["言葉","ことば"],["を"],["語って","かたって"],["も"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["聞き従わず","ききしたがわず"],["、"],["呼びかけて","よびかけて"],["も"],["答えないで","こたえないで"],["あろう"],["。"]]},{"verse":28,"text":"それゆえあなたは彼らに言うがよい。「これは、その神、主の声に聞き従わず、懲らしめを受け入れず、その口から真実が失われ、断たれている民だ。」","tok":[["それ"],["ゆえ"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言う","ゆう"],["が"],["よい"],["。"],["「"],["これ"],["は"],["、"],["その"],["神","かみ"],["、"],["主","ぬし"],["の"],["声","こえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["懲らしめ","こらしめ"],["を"],["受け入れず","うけいれず"],["、"],["その"],["口","くち"],["から"],["真実","しんじつ"],["が"],["失われ","うしなわれ"],["、"],["断たれて","たたれて"],["いる"],["民","たみ"],["だ"],["。"],["」"]]},{"verse":29,"text":"「お前の長い髪を切り、それを捨てよ。裸の山々で哀歌をうたえ。主を怒らせたこの世代を主は退け、見捨てられた。」","tok":[["「"],["お前","おまえ"],["の"],["長い","ながい"],["髪","かみ"],["を"],["切り","きり"],["、"],["それ"],["を"],["捨てよ","すてよ"],["。"],["裸","はだか"],["の"],["山々","やまやま"],["で"],["哀歌","あいか"],["を"],["うたえ"],["。"],["主","ぬし"],["を"],["怒らせた","おこらせた"],["この"],["世代","せだい"],["を"],["主","ぬし"],["は"],["退け","しりぞけ"],["、"],["見捨てられた","みすてられた"],["。"],["」"]]},{"verse":30,"text":"まことに、ユダの人々はわたしの目の前で悪を行った、と主は言われる。わたしの名によって呼ばれるこの神殿に、彼らは憎むべき物を置いてこれを汚した。","tok":[["まこと"],["に"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["で"],["悪","あく"],["を"],["行った","おこなった"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["の"],["名","な"],["によって"],["呼ばれる","よばれる"],["この"],["神殿","しんでん"],["に"],["、"],["彼","かれ"],["ら"],["は"],["憎むべき","にくむべき"],["物","もの"],["を"],["置いて","おいて"],["これ"],["を"],["汚した","よごした"],["。"]]},{"verse":31,"text":"彼らはベン‧ヒノムの谷にトフェトの聖なる高台を築いて息子、娘を火で焼いた。このようなことをわたしは命じたこともなく、心に思い浮かべたこともない。","tok":[["彼","かれ"],["ら"],["は"],["ベン"],["‧"],["ヒノム"],["の"],["谷","たに"],["に"],["トフェト"],["の"],["聖","せい"],["なる"],["高台","たかだい"],["を"],["築いて","きずいて"],["息子","むすこ"],["、"],["娘","むすめ"],["を"],["火","ひ"],["で"],["焼いた","やいた"],["。"],["この"],["よう"],["な"],["こと"],["を"],["わたし"],["は"],["命じた","めいじた"],["こと"],["も"],["なく"],["、"],["心","こころ"],["に"],["思い浮かべた","おもいうかべた"],["こと"],["も"],["ない"],["。"]]},{"verse":32,"text":"それゆえ、見よ、もはやトフェトとかベン‧ヒノムの谷とか呼ばれることなく、殺戮の谷と呼ばれる日が来る、と主は言われる。そのとき、人々はもはや余地を残さぬまで、トフェトに人を葬る。","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["もはや"],["トフェト"],["と"],["か"],["ベン"],["‧"],["ヒノム"],["の"],["谷","たに"],["と"],["か"],["呼ばれる","よばれる"],["こと"],["なく"],["、"],["殺戮","さつりく"],["の"],["谷","たに"],["と"],["呼ばれる","よばれる"],["日","ひ"],["が"],["来る","くる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["その"],["とき"],["、"],["人々","ひとびと"],["は"],["もはや"],["余地","よち"],["を"],["残さぬ","のこさぬ"],["まで"],["、"],["トフェト"],["に"],["人","ひと"],["を"],["葬る","ほうむる"],["。"]]},{"verse":33,"text":"この民の死体は空の鳥、野の獣の餌食となる。それを追い払う者もない。","tok":[["この"],["民","たみ"],["の"],["死体","したい"],["は"],["空","そら"],["の"],["鳥","とり"],["、"],["野","の"],["の"],["獣","けもの"],["の"],["餌食","えじき"],["と"],["なる"],["。"],["それ"],["を"],["追い払う","おいはらう"],["者","もの"],["も"],["ない"],["。"]]},{"verse":34,"text":"わたしはユダの町々とエルサレムの巷から、喜びの声と祝いの声、花婿の声と花嫁の声を絶つ。この地は廃虚となる。","tok":[["わたし"],["は"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["巷","ちまた"],["から"],["、"],["喜び","よろこび"],["の"],["声","こえ"],["と"],["祝い","いわい"],["の"],["声","こえ"],["、"],["花婿","はなむこ"],["の"],["声","こえ"],["と"],["花嫁","はなよめ"],["の"],["声","こえ"],["を"],["絶つ","たつ"],["。"],["この"],["地","ち"],["は"],["廃虚","はいきょ"],["と"],["なる"],["。"]]}]
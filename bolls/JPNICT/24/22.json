,["を"],["見る","みる"],["こと"],["は"],["ない"],["。"]]},{"verse":11,"text":"父ヨシヤに代わって王となったが、このところから引いて行かれたユダの王、ヨシヤの子シャルムについて主はこう言われる。「彼は再びここに帰ることはない。","tok":[["父","ちち"],["ヨシヤ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["が"],["、"],["この"],["ところ"],["から"],["引いて","ひいて"],["行かれた","いかれた"],["ユダ"],["の"],["王","おう"],["、"],["ヨシヤ"],["の"],["子","こ"],["シャルム"],["について"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["彼","かれ"],["は"],["再び","ふたたび"],["ここ"],["に"],["帰る","かえる"],["こと"],["は"],["ない"],["。"]]},{"verse":12,"text":"彼は捕囚となっているそのところで死に、この国を再び見ることはない。」","tok":[["彼","かれ"],["は"],["捕囚","ほしゅう"],["と"],["なって"],["いる"],["その"],["ところ"],["で"],["死に","しに"],["、"],["この"],["国","くに"],["を"],["再び","ふたたび"],["見る","みる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":13,"text":"災いだ、恵みの業を行わず自分の宮殿を正義を行わずに高殿を建て同胞をただで働かせ賃金を払わない者は。","tok":[["災い","わざわい"],["だ"],["、"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["行わず","おこなわず"],["自分","じぶん"],["の"],["宮殿","きゅうでん"],["を"],["正義","せいぎ"],["を"],["行わず","おこなわず"],["に"],["高殿","たかどの"],["を"],["建て","たて"],["同胞","どうほう"],["を"],["ただ"],["で"],["働かせ","はたらかせ"],["賃金","ちんぎん"],["を"],["払わない","はらわない"],["者","もの"],["は"],["。"]]},{"verse":14,"text":"彼は言う。「自分のために広い宮殿を建て大きな高殿を造ろう」と。彼は窓を大きく開けレバノン杉で覆い、朱色に塗り上げる。","tok":[["彼","かれ"],["は"],["言う","ゆう"],["。"],["「"],["自分","じぶん"],["の"],["ため"],["に"],["広い","ひろい"],["宮殿","きゅうでん"],["を"],["建て","たて"],["大きな","おおきな"],["高殿","たかどの"],["を"],["造ろう","つくろう"],["」"],["と"],["。"],["彼","かれ"],["は"],["窓","まど"],["を"],["大きく","おおきく"],["開け","あけ"],["レバノン"],["杉","すぎ"],["で"],["覆い","おおい"],["、"],["朱色","しゅいろ"],["に"],["塗り上げる","ぬりあげる"],["。"]]},{"verse":15,"text":"あなたは、レバノン杉を多く得れば立派な王だと思うのか。あなたの父は、質素な生活をし正義と恵みの業を行ったではないか。そのころ、彼には幸いがあった。","tok":[["あなた"],["は"],["、"],["レバノン"],["杉","すぎ"],["を"],["多く","おおく"],["得れば","えれば"],["立派","りっぱ"],["な"],["王","おう"],["だ"],["と"],["思う","おもう"],["の"],["か"],["。"],["あなた"],["の"],["父","ちち"],["は"],["、"],["質素","しっそ"],["な"],["生活","せいかつ"],["を"],["し"],["正義","まさよし"],["と"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["行ったで","おこなったで"],["は"],["ない"],["か"],["。"],["その"],["ころ"],["、"],["彼","かれ"],["に"],["は"],["幸い","さいわい"],["が"],["あった"],["。"]]},{"verse":16,"text":"彼は貧しい人、乏しい人の訴えを裁きそのころ、人々は幸いであった。こうすることこそわたしを知ることではないか、と主は言われる。","tok":[["彼","かれ"],["は"],["貧しい","まずしい"],["人","ひと"],["、"],["乏しい","とぼしい"],["人","ひと"],["の"],["訴え","うったえ"],["を"],["裁き","さばき"],["その"],["ころ"],["、"],["人々","ひとびと"],["は"],["幸い","さいわい"],["で"],["あった"],["。"],["こう"],["する"],["こと"],["こそ"],["わたし"],["を"],["知る","しる"],["こと"],["で"],["は"],["ない"],["か"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":17,"text":"あなたの目も心も不当な利益を追い求め無実の人の血を流し、虐げと圧制を行っている。","tok":[["あなた"],["の"],["目","め"],["も"],["心","こころ"],["も"],["不当","ふとう"],["な"],["利益","りえき"],["を"],["追い求め","おいもとめ"],["無実","むじつ"],["の"],["人","ひと"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["虐げ","しいたげ"],["と"],["圧制","あっせい"],["を"],["行って","おこなって"],["いる"],["。"]]},{"verse":18,"text":"それゆえ、ユダの王、ヨシヤの子ヨヤキムについて主はこう言われる。だれひとり、「ああ、わたしの兄弟ああ、わたしの姉妹」と言って彼の死を悼み「ああ、主よ、ああ陛下よ」と言って、悼む者はない。","tok":[["それ"],["ゆえ"],["、"],["ユダ"],["の"],["王","おう"],["、"],["ヨシヤ"],["の"],["子","こ"],["ヨヤキム"],["について"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["だれ"],["ひとり"],["、"],["「"],["ああ"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["ああ"],["、"],["わたし"],["の"],["姉妹","しまい"],["」"],["と"],["言って","いって"],["彼","かれ"],["の"],["死","し"],["を"],["悼み","いたみ"],["「"],["ああ"],["、"],["主","ぬし"],["よ"],["、"],["ああ"],["陛下","へいか"],["よ"],["」"],["と"],["言って","いって"],["、"],["悼む","いたむ"],["者","もの"],["は"],["ない"],["。"]]},{"verse":19,"text":"彼はろばを埋めるように埋められる。引きずり出されて投げ捨てられるエルサレムの門の外へ。","tok":[["彼","かれ"],["は"],["ろば"],["を"],["埋める","うめる"],["よう"],["に"],["埋められる","うめられる"],["。"],["引きずり","ひきずり"],["出されて","だされて"],["投げ捨てられる","なげすてられる"],["エルサレム"],["の"],["門","もん"],["の"],["外","そと"],["へ"],["。"]]},{"verse":20,"text":"お前はレバノンに登って叫びバシャンで声をあげアバリムから叫ぶがよい。お前の愛人たちは皆、打ち破られる。","tok":[["お前","おまえ"],["は"],["レバノン"],["に"],["登って","のぼって"],["叫び","さけび"],["バシャン"],["で"],["声","こえ"],["を"],["あげ"],["アバリム"],["から"],["叫ぶ","さけぶ"],["が"],["よい"],["。"],["お前","おまえ"],["の"],["愛人","あいじん"],["たち"],["は"],["皆","みな"],["、"],["打ち破られる","うちやぶられる"],["。"]]},{"verse":21,"text":"お前が栄えていたころ、わたしが何か言うとお前は、「聞きたくない」と言った。これが、お前の若い時からの態度であった。お前はわたしの声に聞き従ったことはない。","tok":[["お前","おまえ"],["が"],["栄えて","さかえて"],["いた"],["ころ"],["、"],["わたし"],["が"],["何","なん"],["か"],["言う","ゆう"],["と"],["お前","おまえ"],["は"],["、"],["「"],["聞きたく","ききたく"],["ない"],["」"],["と"],["言った","いった"],["。"],["これ"],["が"],["、"],["お前","おまえ"],["の"],["若い","わかい"],["時","とき"],["から"],["の"],["態度","たいど"],["で"],["あった"],["。"],["お前","おまえ"],["は"],["わたし"],["の"],["声","こえ"],["に"],["聞き従った","ききしたがった"],["こと"],["は"],["ない"],["。"]]},{"verse":22,"text":"お前の牧者たちは風に追われ愛人たちは、捕らえられて行く。そのとき、お前は自分のあらゆる悪のゆえに恥を受け、卑しめられる。","tok":[["お前","おまえ"],["の"],["牧者","ぼくしゃ"],["たち"],["は"],["風","ふう"],["に"],["追われ","おわれ"],["愛人","あいじん"],["たち"],["は"],["、"],["捕らえられて","とらえられて"],["行く","いく"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["は"],["自分","じぶん"],["の"],["あらゆる"],["悪","あく"],["の"],["ゆえ"],["に"],["恥","はじ"],["を"],["受け","うけ"],["、"],["卑しめられる","いやしめられる"],["。"]]},{"verse":23,"text":"レバノンに住みレバノン杉に巣を作っている者よ産婦の苦しみのような苦痛が襲うときお前はどんなに呻くことか。","tok":[["レバノン"],["に"],["住み","すみ"],["レバノン"],["杉","すぎ"],["に"],["巣","す"],["を"],["作って","つくって"],["いる"],["者","もの"],["よ"],["産婦","さんぷ"],["の"],["苦しみ","くるしみ"],["の"],["よう"],["な"],["苦痛","くつう"],["が"],["襲う","おそう"],["とき"],["お前","おまえ"],["は"],["どんな"],["に"],["呻く","うめく"],["こと"],["か"],["。"]]},{"verse":24,"text":"「わたしは生きている」と主は言われる。「ユダの王、ヨヤキムの子コンヤは、もはやわたしの右手の指輪ではない。わたしはあなたを指から抜き取る。","tok":[["「"],["わたし"],["は"],["生きて","いきて"],["いる"],["」"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["「"],["ユダ"],["の"],["王","おう"],["、"],["ヨヤキム"],["の"],["子","こ"],["コンヤ"],["は"],["、"],["もはや"],["わたし"],["の"],["右手","みぎて"],["の"],["指輪","ゆびわ"],["で"],["は"],["ない"],["。"],["わたし"],["は"],["あなた"],["を"],["指","ゆび"],["から"],["抜き取る","ぬきとる"],["。"]]},{"verse":25,"text":"わたしはあなたを、あなたの命をねらっている者の手、あなたが恐れている者の手、バビロンの王ネブカドレツァルとカルデア人の手に渡す。","tok":[["わたし"],["は"],["あなた"],["を"],["、"],["あなた"],["の"],["命","いのち"],["を"],["ねらって"],["いる"],["者","もの"],["の"],["手","て"],["、"],["あなた"],["が"],["恐れて","おそれて"],["いる"],["者","もの"],["の"],["手","て"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["と"],["カルデア"],["人","にん"],["の"],["手","て"],["に"],["渡す","わたす"],["。"]]},{"ve
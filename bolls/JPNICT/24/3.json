[{"verse":1,"text":"もし人がその妻を出し彼女が彼のもとを去って他の男のものとなれば前の夫は彼女のもとに戻るだろうか。その地は汚れてしまうではないか。お前は多くの男と淫行にふけったのにわたしに戻ろうと言うのかと主は言われる。","tok":[["もし"],["人","ひと"],["が"],["その"],["妻","つま"],["を"],["出し","だし"],["彼女","かのじょ"],["が"],["彼","かれ"],["の"],["もと"],["を"],["去って","さって"],["他","ほか"],["の"],["男","おとこ"],["の"],["もの"],["と"],["なれば"],["前","まえ"],["の"],["夫","おっと"],["は"],["彼女","かのじょ"],["の"],["もと"],["に"],["戻るだろう","もどるだろう"],["か"],["。"],["その"],["地","ち"],["は"],["汚れて","よごれて"],["しまうで"],["は"],["ない"],["か"],["。"],["お前","おまえ"],["は"],["多く","おおく"],["の"],["男","おとこ"],["と"],["淫行","いんこう"],["に"],["ふけった"],["のに"],["わたし"],["に"],["戻ろう","もどろう"],["と"],["言う","いう"],["の"],["か"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":2,"text":"目を上げて裸の山々を見よお前が男に抱かれなかった所があろうか。荒れ野でアラビア人が座っているようにお前は道端に座って彼らを待つ。淫行の悪によってお前はこの地を汚した。","tok":[["目","め"],["を"],["上げて","あげて"],["裸","はだか"],["の"],["山々","やまやま"],["を"],["見よ","みよ"],["お前","おまえ"],["が"],["男","おとこ"],["に"],["抱かれなかった","いだかれなかった"],["所","ところ"],["が"],["あろう"],["か"],["。"],["荒れ野","あれの"],["で"],["アラビア"],["人","にん"],["が"],["座って","すわって"],["いる"],["よう"],["に"],["お前","おまえ"],["は"],["道端","みちばた"],["に"],["座って","すわって"],["彼","かれ"],["ら"],["を"],["待つ","まつ"],["。"],["淫行","いんこう"],["の"],["悪","わる"],["によって"],["お前","おまえ"],["は"],["この"],["地","ち"],["を"],["汚した","よごした"],["。"]]},{"verse":3,"text":"雨がとどめられ春の雨も降らなかったのはそのためだ。お前には遊女の額があり少しも恥じようとしない。","tok":[["雨","あめ"],["が"],["とどめられ"],["春","はる"],["の"],["雨","あめ"],["も"],["降らなかった","ふらなかった"],["の"],["は"],["その"],["ため"],["だ"],["。"],["お前","おまえ"],["に"],["は"],["遊女","ゆうじょ"],["の"],["額","がく"],["が"],["あり"],["少し","すこし"],["も"],["恥じよう","はじよう"],["と"],["しない"],["。"]]},{"verse":4,"text":"「あなたは、わが父、わたしの若い日の夫」とお前がわたしに呼びかけるのは今が初めてだろうか。","tok":[["「"],["あなた"],["は"],["、"],["わが"],["父","ちち"],["、"],["わたし"],["の"],["若い","わかい"],["日","ひ"],["の"],["夫","おっと"],["」"],["と"],["お前","おまえ"],["が"],["わたし"],["に"],["呼びかける","よびかける"],["の"],["は"],["今","いま"],["が"],["初めて","はじめて"],["だろう"],["か"],["。"]]},{"verse":5,"text":"「主はいつまでも憤り限りなく怒り続けるだろうか」とお前は言いながら悪を重ねる。それでもお前は平気だ。","tok":[["「"],["主","ぬし"],["は"],["いつ"],["まで"],["も"],["憤り","いきどおり"],["限りなく","かぎりなく"],["怒り","おこり"],["続けるだろう","つづけるだろう"],["か"],["」"],["と"],["お前","おまえ"],["は"],["言い","いい"],["ながら"],["悪","あく"],["を"],["重ねる","かさねる"],["。"],["それ"],["で"],["も"],["お前","おまえ"],["は"],["平気","へいき"],["だ"],["。"]]},{"verse":6,"text":"ヨシヤ王の時代に、主はわたしに言われた。あなたは背信の女イスラエルのしたことを見たか。彼女は高い山の上、茂る木の下のどこにでも行って淫行にふけった。","tok":[["ヨシヤ"],["王","おう"],["の"],["時代","じだい"],["に"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["あなた"],["は"],["背信","はいしん"],["の"],["女","じょ"],["イスラエル"],["の"],["した"],["こと"],["を"],["見た","みた"],["か"],["。"],["彼女","かのじょ"],["は"],["高い","たかい"],["山","やま"],["の"],["上","うえ"],["、"],["茂る","しげる"],["木","き"],["の"],["下","した"],["の"],["どこ"],["に"],["で"],["も"],["行って","いって"],["淫行","いんこう"],["に"],["ふけった"],["。"]]},{"verse":7,"text":"彼女がこのようなことをしたあとにもなお、わたしは言った。「わたしに立ち帰れ」と。しかし、彼女は立ち帰らなかった。その姉妹である裏切りの女ユダはそれを見た。","tok":[["彼女","かのじょ"],["が"],["この"],["よう"],["な"],["こと"],["を"],["した"],["あと"],["に"],["も"],["なお"],["、"],["わたし"],["は"],["言った","いった"],["。"],["「"],["わたし"],["に"],["立ち帰れ","たちかえれ"],["」"],["と"],["。"],["しかし"],["、"],["彼女","かのじょ"],["は"],["立ち帰らなかった","たちかえらなかった"],["。"],["その"],["姉妹","しまい"],["で"],["ある"],["裏切り","うらぎり"],["の"],["女","おんな"],["ユダ"],["は"],["それ"],["を"],["見た","みた"],["。"]]},{"verse":8,"text":"背信の女イスラエルが姦淫したのを見て、わたしは彼女を離別し、離縁状を渡した。しかし、裏切りの女であるその姉妹ユダは恐れるどころか、その淫行を続けた。","tok":[["背信","はいしん"],["の"],["女","じょ"],["イスラエル"],["が"],["姦淫","かんいん"],["した"],["の"],["を"],["見て","みて"],["、"],["わたし"],["は"],["彼女","かのじょ"],["を"],["離別","りべつ"],["し"],["、"],["離縁状","りえんじょう"],["を"],["渡した","わたした"],["。"],["しかし"],["、"],["裏切り","うらぎり"],["の"],["女","おんな"],["で"],["ある"],["その"],["姉妹","しまい"],["ユダ"],["は"],["恐れる","おそれる"],["どころ"],["か"],["、"],["その"],["淫行","いんこう"],["を"],["続けた","つづけた"],["。"]]},{"verse":9,"text":"彼女は軽薄にも淫行を繰り返して地を汚し、また石や木と姦淫している。","tok":[["彼女","かのじょ"],["は"],["軽薄","けいはく"],["に"],["も"],["淫行","いんこう"],["を"],["繰り返して","くりかえして"],["地","ち"],["を"],["汚し","よごし"],["、"],["また"],["石","いし"],["や"],["木","き"],["と"],["姦淫","かんいん"],["して"],["いる"],["。"]]},{"verse":10,"text":"そればかりでなく、その姉妹である裏切りの女ユダは真心からわたしに立ち帰ろうとせず、偽っているだけだ、と主は言われる。","tok":[["それ"],["ばかり"],["で"],["なく"],["、"],["その"],["姉妹","しまい"],["で"],["ある"],["裏切り","うらぎり"],["の"],["女","おんな"],["ユダ"],["は"],["真心","まごころ"],["から"],["わたし"],["に"],["立ち帰ろう","たちかえろう"],["と"],["せず"],["、"],["偽って","いつわって"],["いる"],["だけ"],["だ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":11,"text":"主はわたしに言われる。裏切りの女ユダに比べれば、背信の女イスラエルは正しかった。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われる","いわれる"],["。"],["裏切り","うらぎり"],["の"],["女","おんな"],["ユダ"],["に"],["比べれば","くらべれば"],["、"],["背信","はいしん"],["の"],["女","じょ"],["イスラエル"],["は"],["正しかった","ただしかった"],["。"]]},{"verse":12,"text":"行け、これらの言葉をもって北に呼びかけよ。背信の女イスラエルよ、立ち帰れと主は言われる。わたしはお前に怒りの顔を向けない。わたしは慈しみ深くとこしえに怒り続ける者ではないと主は言われる。","tok":[["行け","いけ"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["もって"],["北","きた"],["に"],["呼びかけ","よびかけ"],["よ"],["。"],["背信","はいしん"],["の"],["女","じょ"],["イスラエル"],["よ"],["、"],["立ち帰れ","たちかえれ"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["お前","おまえ"],["に"],["怒り","いかり"],["の"],["顔","かお"],["を"],["向けない","むけない"],["。"],["わたし"],["は"],["慈しみ深く","いつくしみぶかく"],["とこしえ"],["に"],["怒り","おこり"],["続ける","つづける"],["者","もの"],["で"],["は"],["ない"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"ただ、お前の犯した罪を認めよ。お前は、お前の主なる神に背きどこにでも茂る木があれば、その下で他国の男たちと乱れた行いをしわたしの声に聞き従わなかったと主は言われる。","tok":[["ただ"],["、"],["お前","おまえ"],["の"],["犯した","おかした"],["罪","つみ"],["を"],["認めよ","みとめよ"],["。"],["お前","おまえ"],["は"],["、"],["お前","おまえ"],["の"],["主","ぬし"],["なる"],["神","かみ"],["に"],["背き","そむき"],["どこ"],["に"],["で"],["も"],["茂る","しげる"],["木","き"],["が"],["あれば"],["、"],["その"],["下","もと"],["で"],["他国","たこく"],["の"],["男","おとこ"],["たち"],["と"],["乱れた","みだれた"],["行い","おこない"],["を"],["し"],["わたし"],["の"],["声","こえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"背信の子らよ、立ち帰れ、と主は言われる。わたしこそあなたたちの主である。一つの町から一人、一つの氏族から二人ではあるが、わたしはあなたたちを連れてシオンに行こう。","tok":[["背信","はいしん"],["の"],["子","こ"],["ら"],["よ"],["、"],["立ち帰れ","たちかえれ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["こそ"],["あなた"],["たち"],["の"],["主","ぬし"],["で"],["ある"],["。"],["一","ひと"],["つ"],["の"],["町","まち"],["から"],["一人","ひとり"],["、"],["一","ひと"],["つ"],["の"],["氏族","しぞく"],["から"],["二人","ふたり"],["で"],["は"],["ある"],["が"],["、"],["わたし"],["は"],["あなた"],["たち"],["を"],["連れて","つれて"],["シオン"],["に"],["行こう","いこう"],["。"]]},{"verse":15,"text":"わたしはあなたたちに、心にかなう牧者たちを与える。彼らは賢く、巧みに導く。","tok":[["わたし"],["は"],["あなた"],["たち"],["に"],["、"],["心","こころ"],["に"],["かなう"],["牧者","ぼくしゃ"],["たち"],["を"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["賢く","かしこく"],["、"],["巧み","たくみ"],["に"],["導く","みちびく"],["。"]]},{"verse":16,"text":"あなたたちがこの地で大いに増えるとき、その日には、と主は言われる。人々はもはや、主の契約の箱について語らず、心に浮かべることも、思い起こすこともない。求めることも、作ることももはやない。","tok":[["あなた"],["たち"],["が"],["この"],["地","ち"],["で"],["大いに","おおいに"],["増える","ふえる"],["とき"],["、"],["その"],["日","ひ"],["に"],["は"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["人々","ひとびと"],["は"],["もはや"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["について"],["語らず","かたらず"],["、"],["心","こころ"],["に"],["浮かべる","うかべる"],["こと"],["も"],["、"],["思い起こす","おもいおこす"],["こと"],["も"],["ない"],["。"],["求める","もとめる"],["こと"],["も"],["、"],["作る","つくる"],["こと"],["も"],["もはや"],["ない"],["。"]]},{"verse":17,"text":"その時、エルサレムは主の王座と呼ばれ、諸国の民は皆、そこに向かい、主の御名のもとにエルサレムに集まる。彼らは再び、かたくなで悪い心に従って歩むことをしない。","tok":[["その"],["時","とき"],["、"],["エルサレム"],["は"],["主","ぬし"],["の"],["王座","おうざ"],["と"],["呼ばれ","よばれ"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["皆","みな"],["、"],["そこ"],["に"],["向かい","むかい"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["の"],["もと"],["に"],["エルサレム"],["に"],["集まる","あつまる"],["。"],["彼","かれ"],["ら"],["は"],["再び","ふたたび"],["、"],["かたくな"],["で"],["悪い","わるい"],["心","こころ"],["に"],["従って","したがって"],["歩む","あゆむ"],["こと"],["を"],["しない"],["。"]]},{"verse":18,"text":"その日、ユダの家はイスラエルの家と合流し、わたしがあなたたちの先祖の所有とした国へ、北の国から共に帰って来る。","tok":[["その"],["日","ひ"],["、"],["ユダ"],["の"],["家","いえ"],["は"],["イスラエル"],["の"],["家","いえ"],["と"],["合流","ごうりゅう"],["し"],["、"],["わたし"],["が"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["の"],["所有","しょゆう"],["と"],["した"],["国","くに"],["へ"],["、"],["北","きた"],["の"],["国","くに"],["から"],["共","とも"],["に"],["帰って","かえって"],["来る","くる"],["。"]]},{"verse":19,"text":"わたしは思っていた。「子らの中でも、お前には何をしようか。お前に望ましい土地あらゆる国の中で最も麗しい地を継がせよう」と。そして、思った。「わが父と、お前はわたしを呼んでいる。わたしから離れることはあるまい」と。","tok":[["わたし"],["は"],["思って","おもって"],["いた"],["。"],["「"],["子","こ"],["ら"],["の"],["中","なか"],["で"],["も"],["、"],["お前","おまえ"],["に"],["は"],["何","なん"],["を"],["しよう"],["か"],["。"],["お前","おまえ"],["に"],["望ましい","のぞましい"],["土地","とち"],["あらゆる"],["国","くに"],["の"],["中","なか"],["で"],["最も","もっとも"],["麗しい","うるわしい"],["地","ち"],["を"],["継がせよう","つがせよう"],["」"],["と"],["。"],["そして"],["、"],["思った","おもった"],["。"],["「"],["わが"],["父","ちち"],["と"],["、"],["お前","おまえ"],["は"],["わたし"],["を"],["呼んで","よんで"],["いる"],["。"],["わたし"],["から"],["離れる","はなれる"],["こと"],["は"],["あるまい"],["」"],["と"],["。"]]},{"verse":20,"text":"だが、妻が夫を欺くようにイスラエルの家よ、お前はわたしを欺いたと主は言われる。","tok":[["だ"],["が"],["、"],["妻","つま"],["が"],["夫","おっと"],["を"],["欺く","あざむく"],["よう"],["に"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["お前","おまえ"],["は"],["わたし"],["を"],["欺いた","あざむいた"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":21,"text":"裸の山々に声が聞こえるイスラエルの子らの嘆き訴える声が。彼らはその道を曲げ主なる神を忘れたからだ。","tok":[["裸","はだか"],["の"],["山々","やまやま"],["に"],["声","こえ"],["が"],["聞こえる","きこえる"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["嘆き","なげき"],["訴える","うったえる"],["声","こえ"],["が"],["。"],["彼","かれ"],["ら"],["は"],["その"],["道","みち"],["を"],["曲げ","まげ"],["主","ぬし"],["なる"],["神","かみ"],["を"],["忘れた","わすれた"],["から"],["だ"],["。"]]},{"verse":22,"text":"「背信の子らよ、立ち帰れ。わたしは背いたお前たちをいやす。」「我々はあなたのもとに参ります。あなたこそ我々の主なる神です。","tok":[["「"],["背信","はいしん"],["の"],["子","こ"],["ら"],["よ"],["、"],["立ち帰れ","たちかえれ"],["。"],["わたし"],["は"],["背いた","そむいた"],["お前","おまえ"],["たち"],["を"],["いやす"],["。"],["」"],["「"],["我々","われわれ"],["は"],["あなた"],["の"],["もと"],["に"],["参ります","まいります"],["。"],["あなた"],["こそ"],["我々","われわれ"],["の"],["主","ぬし"],["なる"],["神","かみ"],["です"],["。"]]},{"verse":23,"text":"まことに、どの丘の祭りも山々での騒ぎも偽りにすぎません。まことに、我々の主なる神にイスラエルの救いがあるのです。","tok":[["まこと"],["に"],["、"],["どの"],["丘","おか"],["の"],["祭り","まつり"],["も"],["山々","やまやま"],["で"],["の"],["騒ぎ","さわぎ"],["も"],["偽り","いつわり"],["に"],["すぎません"],["。"],["まこと"],["に"],["、"],["我々","われわれ"],["の"],["主","ぬし"],["なる"],["神","かみ"],["に"],["イスラエル"],["の"],["救い","すくい"],["が"],["ある"],["の"],["です"],["。"]]},{"verse":24,"text":"我々の若いときから恥ずべきバアルが食い尽くしてきました先祖たちが労して得たものをその羊、牛、息子、娘らを。","tok":[["我々","われわれ"],["の"],["若い","わかい"],["とき"],["から"],["恥ずべき","はずべき"],["バアル"],["が"],["食い","くい"],["尽くして","つくして"],["きました"],["先祖","せんぞ"],["たち"],["が"],["労して","ろうして"],["得た","えた"],["もの"],["を"],["その"],["羊","ひつじ"],["、"],["牛","うし"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["ら"],["を"],["。"]]},{"verse":25,"text":"我々は恥の中に横たわり辱めに覆われています。我々は主なる神に罪を犯しました。我々も、先祖も若いときから今日に至るまで主なる神の御声に聞き従いませんでした。」","tok":[["我々","われわれ"],["は"],["恥","はじ"],["の"],["中","なか"],["に"],["横たわり","よこたわり"],["辱め","はずかしめ"],["に"],["覆われて","おおわれて"],["います"],["。"],["我々","われわれ"],["は"],["主","おも"],["なる"],["神","かみ"],["に"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["我々","われわれ"],["も"],["、"],["先祖","せんぞ"],["も"],["若い","わかい"],["とき"],["から"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["主","おも"],["なる"],["神","かみ"],["の"],["御声","おこえ"],["に"],["聞き従いませんでした","ききしたがいませんでした"],["。"],["」"]]}]
[{"verse":1,"text":"アンモンの人々に向かって主はこう言われる。イスラエルには息子がいないのか跡を継ぐ者がいないのか。なぜ、ミルコムがガドを占領しその民が、ガドの町々に住んでいるのか。","tok":[["アンモン"],["の"],["人々","ひとびと"],["に"],["向かって","むかって"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["イスラエル"],["に"],["は"],["息子","むすこ"],["が"],["いない"],["の"],["か"],["跡","あと"],["を"],["継ぐ","つぐ"],["者","もの"],["が"],["いない"],["の"],["か"],["。"],["なぜ"],["、"],["ミルコム"],["が"],["ガド"],["を"],["占領","せんりょう"],["し"],["その"],["民","たみ"],["が"],["、"],["ガド"],["の"],["町々","まちまち"],["に"],["住んで","すんで"],["いる"],["の"],["か"],["。"]]},{"verse":2,"text":"それゆえ、わたしがアンモンのラバに向かって鬨の声を聞かせる日が来る、と主は言われる。この町は廃虚となり周囲の町々は火で焼かれる。イスラエルは、自分を追い出した者たちを追い出す、と主は言われる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["が"],["アンモン"],["の"],["ラバ"],["に"],["向かって","むかって"],["鬨の声","ときのこえ"],["を"],["聞かせる","きかせる"],["日","ひ"],["が"],["来る","くる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["この"],["町","まち"],["は"],["廃虚","はいきょ"],["と"],["なり"],["周囲","しゅうい"],["の"],["町々","まちまち"],["は"],["火","ひ"],["で"],["焼かれる","やかれる"],["。"],["イスラエル"],["は"],["、"],["自分","じぶん"],["を"],["追い出した","おいだした"],["者","もの"],["たち"],["を"],["追い出す","おいだす"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":3,"text":"ヘシュボンよ、嘆け。アイは滅びた。ラバの娘らよ、泣き叫べ、粗布をまとって泣け。壁の中を歩き回るがよい。ミルコムの像が、その祭司と役人たちと共に捕囚に連れ去られるからだ。","tok":[["ヘシュボン"],["よ"],["、"],["嘆け","なげけ"],["。"],["アイ"],["は"],["滅びた","ほろびた"],["。"],["ラバ"],["の"],["娘","むすめ"],["ら"],["よ"],["、"],["泣き叫べ","なきさけべ"],["、"],["粗布","そふ"],["を"],["まとって"],["泣け","なけ"],["。"],["壁","かべ"],["の"],["中","なか"],["を"],["歩き回る","あるきまわる"],["が"],["よい"],["。"],["ミルコム"],["の"],["像","ぞう"],["が"],["、"],["その"],["祭司","さいし"],["と"],["役人","やくにん"],["たち"],["と"],["共","とも"],["に"],["捕囚","ほしゅう"],["に"],["連れ去られる","つれさられる"],["から"],["だ"],["。"]]},{"verse":4,"text":"背信の娘よなぜ、お前の谷、豊かな谷を誇るのか。お前は自分の宝に頼り誰がわたしを攻撃しうるか、と言っている。","tok":[["背信","はいしん"],["の"],["娘","むすめ"],["よ"],["なぜ"],["、"],["お前","おまえ"],["の"],["谷","たに"],["、"],["豊か","ゆたか"],["な"],["谷","たに"],["を"],["誇る","ほこる"],["の"],["か"],["。"],["お前","おまえ"],["は"],["自分","じぶん"],["の"],["宝","たから"],["に"],["頼り","たより"],["誰","だれ"],["が"],["わたし"],["を"],["攻撃","こうげき"],["し"],["うる"],["か"],["、"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":5,"text":"見よ、わたしは恐れを四方からお前に臨ませると万軍の主なる神は言われる。お前たちは、ちりぢりに追われ逃げる者を集める者はない。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["恐れ","おそれ"],["を"],["四方","しほう"],["から"],["お前","おまえ"],["に"],["臨ませる","のぞませる"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["、"],["ちりぢり"],["に"],["追われ","おわれ"],["逃げる","にげる"],["者","もの"],["を"],["集める","あつめる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":6,"text":"この後わたしはアンモンの人々の繁栄を回復すると主は言われる。","tok":[["この"],["後","あと"],["わたし"],["は"],["アンモン"],["の"],["人々","ひとびと"],["の"],["繁栄","はんえい"],["を"],["回復","かいふく"],["する"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":7,"text":"エドムに向かって万軍の主はこう言われる。テマンには、もはや知恵がないのか知者たちの策略は尽きたのか彼らの知恵は消えうせたのか。","tok":[["エドム"],["に"],["向かって","むかって"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["テマン"],["に"],["は"],["、"],["もはや"],["知恵","ちえ"],["が"],["ない"],["の"],["か"],["知者","ちしゃ"],["たち"],["の"],["策略","さくりゃく"],["は"],["尽きた","つきた"],["の"],["か"],["彼","かれ"],["ら"],["の"],["知恵","ちえ"],["は"],["消えうせた","きえうせた"],["の"],["か"],["。"]]},{"verse":8,"text":"デダンの住民たちよ。逃げよ、退け、深い谷に隠れよ。なぜなら、わたしがエサウに災いを彼を罰する時を来させるからだ。","tok":[["デダン"],["の"],["住民","じゅうみん"],["たち"],["よ"],["。"],["逃げよ","にげよ"],["、"],["退け","しりぞけ"],["、"],["深い","ふかい"],["谷","たに"],["に"],["隠れ","かくれ"],["よ"],["。"],["なぜ"],["なら"],["、"],["わたし"],["が"],["エサウ"],["に"],["災い","わざわい"],["を"],["彼","かれ"],["を"],["罰する","ばっする"],["時","とき"],["を"],["来させる","きたさせる"],["から"],["だ"],["。"]]},{"verse":9,"text":"ぶどうを取り入れる者が来ればひと房も残すことはない。盗人が夜来れば欲しいものをすべて持って行く。","tok":[["ぶどう"],["を"],["取り入れる","とりいれる"],["者","もの"],["が"],["来れば","くれば"],["ひと"],["房","ぼう"],["も"],["残す","のこす"],["こと"],["は"],["ない"],["。"],["盗人","ぬすびと"],["が"],["夜","よる"],["来れば","くれば"],["欲しい","ほしい"],["もの"],["を"],["すべて"],["持って","もって"],["行く","いく"],["。"]]},{"verse":10,"text":"このわたしもエサウを身ぐるみはがして隠れがを暴いた。彼は身を隠すことができない。彼の子孫は滅びた。親族も隣人も失われて、だれも","tok":[["この"],["わたし"],["も"],["エサウ"],["を"],["身ぐるみ","みぐるみ"],["はがして"],["隠れ","かくれ"],["が"],["を"],["暴いた","あばいた"],["。"],["彼","かれ"],["は"],["身","み"],["を"],["隠す","かくす"],["こと"],["が"],["できない"],["。"],["彼","かれ"],["の"],["子孫","しそん"],["は"],["滅びた","ほろびた"],["。"],["親族","しんぞく"],["も"],["隣人","りんじん"],["も"],["失われて","うしなわれて"],["、"],["だれ"],["も"]]},{"verse":11,"text":"「あなたのみなしごを置いて行けわたしが育てる。あなたのやもめらをわたしにゆだねよ」と言う者はない。","tok":[["「"],["あなた"],["の"],["みなしご"],["を"],["置いて","おいて"],["行け","いけ"],["わたし"],["が"],["育てる","そだてる"],["。"],["あなた"],["の"],["やもめ"],["ら"],["を"],["わたし"],["に"],["ゆだねよ"],["」"],["と"],["言う","いう"],["者","もの"],["は"],["ない"],["。"]]},{"verse":12,"text":"主はこう言われる。「わたしの怒りの杯を、飲まなくてもよい者すら飲まされるのに、お前が罰を受けずに済むだろうか。そうはいかない。必ず罰せられ、必ず飲まねばならない。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["わたし"],["の"],["怒り","いかり"],["の"],["杯","さかずき"],["を"],["、"],["飲まなくて","のまなくて"],["も"],["よい"],["者","もの"],["すら"],["飲まされる","のまされる"],["のに"],["、"],["お前","おまえ"],["が"],["罰","ばつ"],["を"],["受けず","うけず"],["に"],["済むだろう","すむだろう"],["か"],["。"],["そう"],["は"],["いかない"],["。"],["必ず","かならず"],["罰せられ","ばっせられ"],["、"],["必ず","かならず"],["飲まねば","のまねば"],["ならない"],["。"]]},{"verse":13,"text":"わたしは自分自身にかけて誓う、と主は言われる。ボツラは、廃虚となり、恐怖、恥辱、ののしりの的となる。その町々は皆、とこしえの廃虚となる。」","tok":[["わたし"],["は"],["自分","じぶん"],["自身","じしん"],["に"],["かけて"],["誓う","ちかう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["ボツラ"],["は"],["、"],["廃虚","はいきょ"],["と"],["なり"],["、"],["恐怖","きょうふ"],["、"],["恥辱","ちじょく"],["、"],["ののしり"],["の"],["的","まと"],["と"],["なる"],["。"],["その"],["町々","まちまち"],["は"],["皆","みな"],["、"],["とこしえ"],["の"],["廃虚","はいきょ"],["と"],["なる"],["。"],["」"]]},{"verse":14,"text":"わたしは主から知らせを聞いた。使者が諸国へ遣わされ「集まれ、エドムを攻めよ。戦いに出よ」と言う。","tok":[["わたし"],["は"],["主","ぬし"],["から"],["知らせ","しらせ"],["を"],["聞いた","きいた"],["。"],["使者","ししゃ"],["が"],["諸国","しょこく"],["へ"],["遣わされ","つかわされ"],["「"],["集まれ","あつまれ"],["、"],["エドム"],["を"],["攻めよ","せめよ"],["。"],["戦い","たたかい"],["に"],["出よ","でよ"],["」"],["と"],["言う","ゆう"],["。"]]},{"verse":15,"text":"見よ、わたしはお前を諸国のうちで最も小さいものとする。お前は人々にさげすまれる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["を"],["諸国","しょこく"],["の"],["うち"],["で"],["最も","もっとも"],["小さい","ちいさい"],["もの"],["と"],["する"],["。"],["お前",
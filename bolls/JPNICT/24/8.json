,["ら"],["は"],["偶像","ぐうぞう"],["によって"],["異教","いきょう"],["の"],["空しい","むなしい"],["もの"],["によって"],["わたし"],["を"],["怒らせる","おこらせる"],["の"],["か"],["。"]]},{"verse":20,"text":"刈り入れの時は過ぎ、夏は終わった。しかし、我々は救われなかった。","tok":[["刈り入れ","かりいれ"],["の"],["時","とき"],["は"],["過ぎ","すぎ"],["、"],["夏","なつ"],["は"],["終わった","おわった"],["。"],["しかし"],["、"],["我々","われわれ"],["は"],["救われなかった","すくわれなかった"],["。"]]},{"verse":21,"text":"娘なるわが民の破滅のゆえにわたしは打ち砕かれ、嘆き、恐怖に襲われる。","tok":[["娘","むすめ"],["なる"],["わが"],["民","たみ"],["の"],["破滅","はめつ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["打ち砕かれ","うちくだかれ"],["、"],["嘆き","なげき"],["、"],["恐怖","きょうふ"],["に"],["襲われる","おそわれる"],["。"]]},{"verse":22,"text":"ギレアドに乳香がないというのかそこには医者がいないのか。なぜ、娘なるわが民の傷はいえないのか。","tok":[["ギレアド"],["に"],["乳香","にゅうこう"],["が"],["ない"],["と"],["いう"],["の"],["か"],["そこ"],["に"],["は"],["医者","いしゃ"],["が"],["いない"],["の"],["か"],["。"],["なぜ"],["、"],["娘","むすめ"],["なる"],["わが"],["民","たみ"],["の"],["傷","きず"],["は"],["いえない"],["の"],["か"],["。"]]},{"verse":23,"text":"わたしの頭が大水の源となりわたしの目が涙の源となればよいのに。そうすれば、昼も夜もわたしは泣こう娘なるわが民の倒れた者のために。","tok":[["わたし"],["の"],["頭","あたま"],["が"],["大水","おおみず"],["の"],["源","みなもと"],["と"],["なり"],["わたし"],["の"],["目","め"],["が"],["涙","なみだ"],["の"],["源","みなもと"],["と"],["なれば"],["よい"],["のに"],["。"],["そう"],["すれば"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["わたし"],["は"],["泣こう","なこう"],["娘","むすめ"],["なる"],["わが"],["民","たみ"],["の"],["倒れた","たおれた"],["者","もの"],["の"],["ため"],["に"],["。"]]}]
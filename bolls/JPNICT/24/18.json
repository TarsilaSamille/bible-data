[{"verse":1,"text":"主からエレミヤに臨んだ言葉。","tok":[["主","ぬし"],["から"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"]]},{"verse":2,"text":"「立って、陶工の家に下って行け。そこでわたしの言葉をあなたに聞かせよう。」","tok":[["「"],["立って","たって"],["、"],["陶工","とうこう"],["の"],["家","いえ"],["に"],["下って","くだって"],["行け","いけ"],["。"],["そこ"],["で"],["わたし"],["の"],["言葉","ことば"],["を"],["あなた"],["に"],["聞かせよう","きかせよう"],["。"],["」"]]},{"verse":3,"text":"わたしは陶工の家に下って行った。彼はろくろを使って仕事をしていた。","tok":[["わたし"],["は"],["陶工","とうこう"],["の"],["家","いえ"],["に"],["下って","くだって"],["行った","いった"],["。"],["彼","かれ"],["は"],["ろくろ"],["を"],["使って","つかって"],["仕事","しごと"],["を"],["して"],["いた"],["。"]]},{"verse":4,"text":"陶工は粘土で一つの器を作っても、気に入らなければ自分の手で壊し、それを作り直すのであった。","tok":[["陶工","とうこう"],["は"],["粘土","ねんど"],["で"],["一","ひと"],["つ"],["の"],["器","うつわ"],["を"],["作って","つくって"],["も"],["、"],["気","き"],["に"],["入らなければ","いらなければ"],["自分","じぶん"],["の"],["手","て"],["で"],["壊し","こわし"],["、"],["それ"],["を"],["作り直す","つくりなおす"],["ので"],["あった"],["。"]]},{"verse":5,"text":"そのとき主の言葉がわたしに臨んだ。","tok":[["その"],["とき"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":6,"text":"「イスラエルの家よ、この陶工がしたように、わたしもお前たちに対してなしえないと言うのか、と主は言われる。見よ、粘土が陶工の手の中にあるように、イスラエルの家よ、お前たちはわたしの手の中にある。","tok":[["「"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["この"],["陶工","とうこう"],["が"],["した"],["よう"],["に"],["、"],["わたし"],["も"],["お前","おまえ"],["たち"],["に対して","にたいして"],["なし"],["えない"],["と"],["言う","いう"],["の"],["か"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["粘土","ねんど"],["が"],["陶工","とうこう"],["の"],["手","て"],["の"],["中","なか"],["に"],["ある"],["よう"],["に"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["手","て"],["の"],["中","なか"],["に"],["ある"],["。"]]},{"verse":7,"text":"あるとき、わたしは一つの民や王国を断罪して、抜き、壊し、滅ぼすが、","tok":[["ある"],["とき"],["、"],["わたし"],["は"],["一","ひと"],["つ"],["の"],["民","たみ"],["や"],["王国","おうこく"],["を"],["断罪","だんざい"],["して"],["、"],["抜き","ぬき"],["、"],["壊し","こわし"],["、"],["滅ぼす","ほろぼす"],["が"],["、"]]},{"verse":8,"text":"もし、断罪したその民が、悪を悔いるならば、わたしはその民に災いをくだそうとしたことを思いとどまる。","tok":[["もし"],["、"],["断罪","だんざい"],["した"],["その"],["民","たみ"],["が"],["、"],["悪","あく"],["を"],["悔いるならば","くいるならば"],["、"],["わたし"],["は"],["その"],["民","たみ"],["に"],["災い","わざわい"],["を"],["くだそう"],["と"],["した"],["こと"],["を"],["思いとどまる","おもいとどまる"],["。"]]},{"verse":9,"text":"またあるときは、一つの民や王国を建て、また植えると約束するが、","tok":[["また"],["ある"],["とき"],["は"],["、"],["一","ひと"],["つ"],["の"],["民","たみ"],["や"],["王国","おうこく"],["を"],["建て","たて"],["、"],["また"],["植える","うえる"],["と"],["約束","やくそく"],["する"],["が"],["、"]]},{"verse":10,"text":"わたしの目に悪とされることを行い、わたしの声に聞き従わないなら、彼らに幸いを与えようとしたことを思い直す。」","tok":[["わたし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行い","おこない"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞き従わないなら","ききしたがわないなら"],["、"],["彼","かれ"],["ら"],["に"],["幸い","さいわい"],["を"],["与えよう","あたえよう"],["と"],["した"],["こと"],["を"],["思い直す","おもいなおす"],["。"],["」"]]},{"verse":11,"text":"今、ユダの人々とエルサレムの住民に言うがよい。「主はこう言われる。見よ、わたしはお前たちに災いを備え、災いを計画している。お前たちは皆、悪の道から立ち帰り、お前たちの道と行いを正せ。」","tok":[["今","いま"],["、"],["ユダ"],["の"],["人々","ひとびと"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["言う","ゆう"],["が"],["よい"],["。"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["に"],["災い","わざわい"],["を"],["備え","そなえ"],["、"],["災い","わざわい"],["を"],["計画","けいかく"],["して"],["いる"],["。"],["お前","おまえ"],["たち"],["は"],["皆","みな"],["、"],["悪","あく"],["の"],["道","みち"],["から"],["立ち帰り","たちかえり"],["、"],["お前","おまえ"],["たち"],["の"],["道","みち"],["と"],["行い","おこない"],["を"],["正せ","ただせ"],["。"],["」"]]},{"verse":12,"text":"彼らは言った。「それは無駄です。我々は我々の思いどおりにし、おのおのかたくなな悪い心のままにふるまいたいのだから。」","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["それ"],["は"],["無駄","むだ"],["です"],["。"],["我々","われわれ"],["は"],["我々","われわれ"],["の"],["思い","おもい"],["どおり"],["に"],["し"],["、"],["おのおの"],["かたくな"],["な"],["悪い","わるい"],["心","こころ"],["の"],["まま"],["に"],["ふるまいたい"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":13,"text":"それゆえ、主はこう言われる。「国々に尋ねて見よ。誰がこのようなことを聞いたであろうか。おとめイスラエルはおぞましいことをした。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["国々","くにぐに"],["に"],["尋ねて","たずねて"
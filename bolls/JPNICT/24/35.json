[{"verse":1,"text":"ユダの王、ヨシヤの子ヨヤキムの時代に、主からエレミヤに臨んだ言葉。","tok":[["ユダ"],["の"],["王","おう"],["、"],["ヨシヤ"],["の"],["子","こ"],["ヨヤキム"],["の"],["時代","じだい"],["に"],["、"],["主","ぬし"],["から"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["言葉","ことば"],["。"]]},{"verse":2,"text":"「レカブ人一族のところへ行って、主の神殿の一室に来るように言い、彼らにぶどう酒を飲ませなさい。」","tok":[["「"],["レカブ人","れかぶにん"],["一族","いちぞく"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["一室","いっしつ"],["に"],["来る","くる"],["よう"],["に"],["言い","いい"],["、"],["彼","かれ"],["ら"],["に"],["ぶどう酒","ぶどうしゅ"],["を"],["飲ませ","のませ"],["なさい"],["。"],["」"]]},{"verse":3,"text":"そこで、わたしは、ハバツィンヤの孫であり、イルメヤの子であるヤアザンヤとその兄弟、その子ら、つまりレカブ人の一族全員を連れて、","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["、"],["ハバツィンヤ"],["の"],["孫","まご"],["で"],["あり"],["、"],["イルメヤ"],["の"],["子","こ"],["で"],["ある"],["ヤアザンヤ"],["と"],["その"],["兄弟","きょうだい"],["、"],["その"],["子","こ"],["ら"],["、"],["つまり"],["レカブ人","れかぶにん"],["の"],["一族","いちぞく"],["全員","ぜんいん"],["を"],["連れて","つれて"],["、"]]},{"verse":4,"text":"主の神殿にある、神の人イグダルヤの子ハナンの弟子たちがいる部屋へ行った。この部屋は、貴族の部屋の隣にあって、門衛、シャルムの子マアセヤの部屋の上に当たる。","tok":[["主","ぬし"],["の"],["神殿","しんでん"],["に"],["ある"],["、"],["神","かみ"],["の"],["人","ひと"],["イグダルヤ"],["の"],["子","こ"],["ハナン"],["の"],["弟子","でし"],["たち"],["が"],["いる"],["部屋","へや"],["へ"],["行った","いった"],["。"],["この"],["部屋","へや"],["は"],["、"],["貴族","きぞく"],["の"],["部屋","へや"],["の"],["隣","となり"],["に"],["あって"],["、"],["門衛","もんえい"],["、"],["シャルム"],["の"],["子","こ"],["マアセヤ"],["の"],["部屋","へや"],["の"],["上","うえ"],["に"],["当たる","あたる"],["。"]]},{"verse":5,"text":"そこで、わたしはレカブ人一族の前にぶどう酒を満たした壺と杯を出し、彼らに、「ぶどう酒を飲んでください」と言った。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["レカブ人","れかぶにん"],["一族","いちぞく"],["の"],["前","まえ"],["に"],["ぶどう酒","ぶどうしゅ"],["を"],["満たした","みたした"],["壺","つぼ"],["と"],["杯","さかずき"],["を"],["出し","だし"],["、"],["彼","かれ"],["ら"],["に"],["、"],["「"],["ぶどう酒","ぶどうしゅ"],["を"],["飲んで","のんで"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"すると、彼らは答えた。「我々はぶどう酒を飲みません。父祖レカブの子ヨナダブが、子々孫々に至るまでぶどう酒を飲んではならない、と命じたからです。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["我々","われわれ"],["は"],["ぶどう酒","ぶどうしゅ"],["を"],["飲みません","のみません"],["。"],["父祖","ふそ"],["レカブ"],["の"],["子","こ"],["ヨナダブ"],["が"],["、"],["子々","しし"],["孫々","そんそん"],["に"],["至る","いたる"],["まで"],["ぶどう酒","ぶどうしゅ"],["を"],["飲んで","のんで"],["は"],["ならない"],["、"],["と"],["命じた","めいじた"],["から"],["です"],["。"]]},{"verse":7,"text":"また、家を建てるな、種を蒔くな、ぶどう園を作るな、また、それらを所有せず、生涯天幕に住むように。そうすれば、お前たちが滞在する土地で長く生きることができる、と言いました。","tok":[["また"],["、"],["家","いえ"],["を"],["建てる","たてる"],["な"],["、"],["種","しゅ"],["を"],["蒔く","まく"],["な"],["、"],["ぶどう園","ぶどうえん"],["を"],["作る","つくる"],["な"],["、"],["また"],["、"],["それ"],["ら"],["を"],["所有","しょゆう"],["せず"],["、"],["生涯","しょうがい"],["天幕","てんまく"],["に"],["住む","すむ"],["よう"],["に"],["。"],["そう"],["すれば"],["、"],["お前","おまえ"],["たち"],["が"],["滞在","たいざい"],["する"],["土地","とち"],["で"],["長く","ながく"],["生きる","いきる"],["こと"],["が"],["できる"],["、"],["と"],["言いました","いいました"],["。"]]},{"verse":8,"text":"我々の先祖である、レカブの子ヨナダブの命じたすべてのことに聞き従ってきました。生涯、我々も妻も、息子、娘たちもぶどう酒を飲まず、","tok":[["我々","われわれ"],["の"],["先祖","せんぞ"],["で"],["ある"],["、"],["レカブ"],["の"],["子","こ"],["ヨナダブ"],["の"],["命じた","めいじた"],["すべて"],["の"],["こと"],["に"],["聞き従って","ききしたがって"],["きました"],["。"],["生涯","しょうがい"],["、"],["我々","われわれ"],["も"],["妻","つま"],["も"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["も"],["ぶどう酒","ぶどうしゅ"],["を"],["飲まず","のまず"],["、"]]},{"verse":9,"text":"住む家を建てず、ぶどう園、畑、種を所有せず、","tok":[["住む","すむ"],["家","いえ"],["を"],["建てず","たてず"],["、"],["ぶどう園","ぶどうえん"],["、"],["畑","はたけ"],["、"],["種","しゅ"],["を"],["所有","しょゆう"],["せず"],["、"]]},{"verse":10,"text":"天幕に住んでいます。我々は父祖ヨナダブの命じたすべてのことに従って行ってきました。","tok":[["天幕","てんまく"],["に"],["住んで","すんで"],["います"],["。"],["我々","われわれ"],["は"],["父祖","ふそ"],["ヨナダブ"],["の"],["命じた","めいじた"],["すべて"],["の"],["こと"],["に"],["従って","したがって"],["行って","いって"],["きました"],["。"]]},{"verse":11,"text":"今は、バビロンの王ネブカドレツァルがこの国に攻め上って来たので、『エルサレムに行き、カルデア軍とアラム軍の攻撃を避けよう』と言って、エルサレムに滞在しているのです。」","tok":[["今","いま"],["は"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["が"],["この"],["国","くに"],["に"],["攻め上って","せめのぼって"],["来た","きた"],["ので"],["、"],["『"],["エルサレム"],["に"],["行き","いき"],["、"],["カルデア"],["軍","ぐん"],["と"],["アラム"],["軍","ぐん"],["の"],["攻撃","こうげき"],["を"],["避けよう","さけよう"],["』"],["と"],["言って","いって"],["、"],["エルサレム"],["に"],["滞在","たいざい"],["して"],["いる"],["の"],["です"],["。"],["」"]]},{"verse":12,"text":"そのとき、主の言葉がエレミヤに臨んだ。","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":13,"text":"「イスラエルの神、万軍の主はこう言われる。行って、ユダの人々とエルサレムの住民に告げよ。お前たちはわたしの言葉に従えという戒めを受け入れないのか、と主は言われる。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["行って","いって"],["、"],["ユダ"],["の"],["人々","ひとびと"],["と"],["エルサレム"],["の"],["住民","じゅうみん"],["に"],["告げ","つげ"],["よ"],["。"],["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["言葉","ことば"],["に"],["従え","したがえ"],["と"],["いう"],["戒め","いましめ"],["を"],["受け入れない","うけいれない"],["の"],["か"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"レカブの子ヨナダブが一族の者たちに、ぶどう酒を飲むなと命じた言葉は守られ、彼らはこの父祖の命令に聞き従い、今日に至るまでぶどう酒を飲まずにいる。ところがお前たちは、わたしが繰り返し語り続けてきたのに聞き従おうとしなかった。","tok":[["レカブ"],["の"],["子","こ"],["ヨナダブ"],["が"],["一族","いちぞく"],["の"],["者","もの"],["たち"],["に"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["飲む","のむ"],["な"],["と"],["命じた","めいじた"],["言葉","ことば"],["は"],["守られ","まもられ"],["、"],["彼","かれ"],["ら"],["は"],["この"],["父祖","ふそ"],["の"],["命令","めいれい"],["に"],["聞き従い","ききしたがい"],["、"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["ぶどう酒","ぶどうしゅ"],["を"],["飲まず","のまず"],["に"],["いる"],["。"],["ところ"],["が"],["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["繰り返し","くりかえし"],["語り","かたり"],["続けて","つづけて"],["きた"],["のに"],["聞き従おう","ききしたがおう"],["と"],["しなかった"],["。"]]},{"verse":15,"text":"わたしは、お前たちにわたしの僕である預言者を、繰り返し遣わして命じた。『おのおの悪の道を離れて立ち帰り、行いを正せ。他の神々に仕え従うな。そうすれば、わたしがお前たちと父祖に与えた国土にとどまることができる』と。しかし、お前たちは耳を傾けず、わたしに聞こうとしなかった。","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["に"],["わたし"],["の"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["を"],["、"],["繰り返し","くりかえし"],["遣わして","つかわして"],["命じた","めいじた"],["。"],["『"],["おのおの"],["悪","わる"],["の"],["道","みち"],["を"],["離れて","はなれて"],["立ち帰り","たちかえり"],["、"],["行い","おこない"],["を"],["正せ","ただせ"],["。"],["他","ほか"],["の"],["神々","かみがみ"],["に"],["仕え","つかえ"],["従う","したがう"],["な"],["。"],["そう"],["すれば"],["、"],["わたし"],["が"],["お前","おまえ"],["たち"],["と"],["父祖","ふそ"],["に"],["与えた","あたえた"],["国土","こくど"],["に"],["とどまる"],["こと"],["が"],["できる"],["』"],["と"],["。"],["しかし"],["、"],["お前","おまえ"],["たち"],["は"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["わたし"],["に"],["聞こう","きこう"],["と"],["しなかった"],["。"]]},{"verse":16,"text":"レカブの子ヨナダブの一族が、父祖の命じた命令を固く守っているというのに、この民はわたしに従おうとしない。","tok":[["レカブ"],["の"],["子","こ"],["ヨナダブ"],["の"],["一族","いちぞく"],["が"],["、"],["父祖","ふそ"],["の"],["命じた","めいじた"],["命令","めいれい"],["を"],["固く","かたく"],["守って","まもって"],["いる"],["と"],["いう"],["のに"],["、"],["この"],["民","みん"],["は"],["わたし"],["に"],["従おう","したがおう"],["と"],["しない"],["。"]]},{"verse":17,"text":"それゆえ、イスラエルの神、万軍の主はこう言われる。わたしは、ユダとエルサレムの全住民に対して予告したとおり、あらゆる災いを送る。わたしが語ったのに彼らは聞かず、わたしが呼びかけたのに答えなかったからである。」","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["全住民","ぜんじゅうみん"],["に対して","にたいして"],["予告","よこく"],["した"],["とおり"],["、"],["あらゆる"],["災い","わざわい"],["を"],["送る","おくる"],["。"],["わたし"],["が"],["語った","かたった"],["のに"],["彼","かれ"],["ら"],["は"],["聞かず","きかず"],["、"],["わたし"],["が"],["呼びかけた","よびかけた"],["のに"],["答えなかった","こたえなかった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":18,"text":"また、レカブ人一族にエレミヤは言った。「イスラエルの神、万軍の主はこう言われる。あなたたちは、父祖ヨナダブの命令に聞き従い、命令をことごとく守り、命じられたとおりに行ってきた。","tok":[["また"],["、"],["レカブ人","れかぶにん"],["一族","いちぞく"],["に"],["エレミヤ"],["は"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["あなた"],["たち"],["は"],["、"],["父祖","ふそ"],["ヨナダブ"],["の"],["命令","めいれい"],["に"],["聞き従い","ききしたがい"],["、"],["命令","めいれい"],["を"],["ことごとく"],["守り","まもり"],["、"],["命じられた","めいじられた"],["とおり"],["に"],["行って","いって"],["きた"],["。"]]},{"verse":19,"text":"それゆえ、イスラエルの神、万軍の主はこう言われる。レカブの子ヨナダブの一族には、わたしの前に立って仕える者がいつまでも絶えることがない。」","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる"
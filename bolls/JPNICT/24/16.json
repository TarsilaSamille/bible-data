[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「あなたはこのところで妻をめとってはならない。息子や娘を得てはならない。」","tok":[["「"],["あなた"],["は"],["この"],["ところ"],["で"],["妻","つま"],["を"],["めとって"],["は"],["ならない"],["。"],["息子","むすこ"],["や"],["娘","むすめ"],["を"],["得て","えて"],["は"],["ならない"],["。"],["」"]]},{"verse":3,"text":"このところで生まれる息子、娘、この地で彼らを産む母、彼らをもうけた父について、主はこう言われる。","tok":[["この"],["ところ"],["で"],["生まれる","うまれる"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["この"],["地","ち"],["で"],["彼","かれ"],["ら"],["を"],["産む","うむ"],["母","はは"],["、"],["彼","かれ"],["ら"],["を"],["もうけた"],["父","ちち"],["について"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"]]},{"verse":4,"text":"「彼らは弱り果てて死ぬ。嘆く者も、葬る者もなく、土の肥やしとなる。彼らは剣と飢饉によって滅びる。その死体は空の鳥、野の獣の餌食となる。」","tok":[["「"],["彼","かれ"],["ら"],["は"],["弱り","よわり"],["果てて","はてて"],["死ぬ","しぬ"],["。"],["嘆く","なげく"],["者","もの"],["も"],["、"],["葬る","ほうむる"],["者","もの"],["も"],["なく"],["、"],["土","つち"],["の"],["肥やし","こやし"],["と"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["剣","けん"],["と"],["飢饉","ききん"],["によって"],["滅びる","ほろびる"],["。"],["その"],["死体","したい"],["は"],["空","そら"],["の"],["鳥","とり"],["、"],["野","の"],["の"],["獣","けもの"],["の"],["餌食","えじき"],["と"],["なる"],["。"],["」"]]},{"verse":5,"text":"主はこう言われる。「あなたは弔いの家に入るな。嘆くために行くな。悲しみを表すな。わたしはこの民から、わたしの与えた平和も慈しみも憐れみも取り上げる」と主は言われる。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["あなた"],["は"],["弔い","とむらい"],["の"],["家","いえ"],["に"],["入る","はいる"],["な"],["。"],["嘆く","なげく"],["ため"],["に"],["行く","いく"],["な"],["。"],["悲しみ","かなしみ"],["を"],["表す","あらわす"],["な"],["。"],["わたし"],["は"],["この"],["民","たみ"],["から"],["、"],["わたし"],["の"],["与えた","あたえた"],["平和","へいわ"],["も"],["慈しみ","いつくしみ"],["も"],["憐れみ","あわれみ"],["も"],["取り上げる","とりあげる"],["」"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"「身分の高い者も低い者もこの地で死に、彼らを葬る者はない。彼らのために嘆く者も、体を傷つける者も、髪をそり落とす者もない。","tok":[["「"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["も"],["低い","ひくい"],["者","もの"],["も"],["この"],["地","ち"],["で"],["死に","しに"],["、"],["彼","かれ"],["ら"],["を"],["葬る","ほうむる"],["者","もの"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["嘆く","なげく"],["者","もの"],["も"],["、"],["体","からだ"],["を"],["傷つける","きずつける"],["者","もの"],["も"],["、"],["髪","かみ"],["を"],["そり落とす","そりおとす"],["者","もの"],["も"],["ない"],["。"]]},{"verse":7,"text":"死者を悼む人を力づけるために、パンを裂く者もなく、死者の父や母を力づけるために、杯を与える者もない。","tok":[["死者","ししゃ"],["を"],["悼む","いたむ"],["人","ひと"],["を"],["力づける","ちからづける"],["ため"],["に"],["、"],["パン"],["を"],["裂く","さく"],["者","もの"],["も"],["なく"],["、"],["死者","ししゃ"],["の"],["父","ちち"],["や"],["母","はは"],["を"],["力づける","ちからづける"],["ため"],["に"],["、"],["杯","さかずき"],["を"],["与える","あたえる"],["者","もの"],["も"],["ない"],["。"]]},{"verse":8,"text":"あなたは酒宴の家に入るな。彼らと共に座って、飲み食いしてはならない。」","tok":[["あなた"],["は"],["酒宴","しゅえん"],["の"],["家","いえ"],["に"],["入る","はいる"],["な"],["。"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["座って","すわって"],["、"],["飲み食い","のみくい"],["して"],["は"],["ならない"],["。"],["」"]]},{"verse":9,"text":"万軍の主、イスラエルの神はこう言われる。「見よ、わたしはこのところから、お前たちの目の前から、お前たちが生きているかぎり、喜びの声、祝いの声、花婿の声、花嫁の声を絶えさせる。」","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["、"],["イスラエル"],["の"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["ところ"],["から"],["、"],["お前","おまえ"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["から"],["、"],["お前","おまえ"],["たち"],["が"],["生きて","いきて"],["いる"],["かぎり"],["、"],["喜び","よろこび"],["の"],["声","こえ"],["、"],["祝い","いわい"],["の"],["声","こえ"],["、"],["花婿","はなむこ"],["の"],["声","こえ"],["、"],["花嫁","はなよめ"],["の"],["声","こえ"],["を"],["絶えさせる","たえさせる"],["。"],["」"]]},{"verse":10,"text":"あなたが、この民にこれらの言葉をすべて告げるならば、彼らはあなたに、「なぜ主はこの大いなる災いをもたらす、と言って我々を脅かされるのか。我々は、どのような悪、どのような罪を我々の神、主に対して犯したのか」と言うであろう。","tok":[["あなた"],["が"],["、"],["この"],["民","たみ"],["に"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["すべて"],["告げるならば","つげるならば"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["、"],["「"],["なぜ"],["主","ぬし"],["は"],["この"],["大いなる","おおいなる"],["災い","わざわい"],["を"],["もたらす"],["、"],["と"],["言って","いって"],["我々","われわれ"],["を"],["脅かされる","おびやかされる"],["の"],["か"],["。"],["我々","われわれ"],["は"],["、"],["どのような"],["悪","わる"],["、"],["どのような"],["罪","つみ"],["を"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["対して","たいして"],["犯した","おかした"],["の"],["か"],["」"],["と"],["言うで","ゆうで"],["あろう"],["。"]]},{"verse":11,"text":"あなたは、彼らに答えるがよい。「お前たちの先祖がわたしを捨てたからだ」と主は言われる。「彼らは他の神々に従って歩み、それに仕え、ひれ伏し、わたしを捨て、わたしの律法を守らなかった。","tok":[["あなた"],["は"],["、"],["彼","かれ"],["ら"],["に"],["答える","こたえる"],["が"],["よい"],["。"],["「"],["お前","おまえ"],["たち"],["の"],["先祖","せんぞ"],["が"],["わたし"],["を"],["捨てた","すてた"],["から"],["だ"],["」"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["「"],["彼","かれ"],["ら"],["は"],["他","た"],["の"],["神々","かみがみ"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"],["それ"],["に"],["仕え","つかえ"],["、"],["ひれ伏し","ひれふし"],["、"],["わたし"],["を"],["捨て","すて"],["、"],["わたし"],["の"],["律法","りっぽう"],["を"],["守らなかった","まもらなかった"],["。"]]},{"verse":12,"text":"お前たちは先祖よりも、更に重い悪を行った。おのおのそのかたくなで悪い心に従って歩み、わたしに聞き従わなかった。","tok":[["お前","おまえ"],["たち"],["は"],["先祖","せんぞ"],["より"],["も"],["、"],["更に","さらに"],["重い","おもい"],["悪","あく"],["を"],["行った","おこなった"],["。"],["おのおの"],["その"],["かたくな"],["で"],["悪い","わるい"],["心","こころ"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"],["わたし"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"]]},{"verse":13,"text":"わたしは、お前たちをこの地から、お前たちも先祖も知らなかった地へ追放する。お前たちは、そのところで昼も夜も他の神々に仕えるがよい。もはやわたしは、お前たちに恩恵をほどこさない。」","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["を"],["この"],["地","ち"],["から"],["、"],["お前","おまえ"],["たち"],["も"],["先祖","せんぞ"],["も"],["知らなかった","しらなかった"],["地","ち"],["へ"],["追放","ついほう"],["する"],["。"],["お前","おまえ"],["たち"],["は"],["、"],["その"],["ところ"],["で"],["昼","ひる"],["も"],["夜","よる"],["も"],["他","た"],["の"],["神々","かみがみ"],["に"],["仕える","つかえる"],["が"],["よい"],["。"],["もはや"],["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["に"],["恩恵","おんけい"],["を"],["ほどこさない"],["。"],["」"]]},{"verse":14,"text":"見よ、このような日が来る、と主は言われる。人々はもう、「イスラエルの人々をエジプトから導き上られた主は生きておられる」と言わず、","tok":[["見よ","みよ"],["、"],["この"],["よう"],["な"],["日","ひ"],["が"],["来る","くる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["人々","ひとびと"],["は"],["もう"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["から"],["導き","みちびき"],["上られた","のぼられた"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["」"],["と"],["
[{"verse":1,"text":"エジプトのミグドル、タフパンヘス、メンフィスならびに上エジプト地方に住む、ユダの人々に対する言葉がエレミヤに臨んだ。","tok":[["エジプト"],["の"],["ミグドル"],["、"],["タフパンヘス"],["、"],["メンフィス"],["ならび"],["に"],["上","うえ"],["エジプト"],["地方","ちほう"],["に"],["住む","すむ"],["、"],["ユダ"],["の"],["人々","ひとびと"],["に"],["対する","たいする"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「イスラエルの神、万軍の主はこう言われる。エルサレムとユダのすべての町にわたしがくだしたあらゆる災いをお前たちは見た。これらの町々は今や廃虚と化し、住む者もない。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["エルサレム"],["と"],["ユダ"],["の"],["すべて"],["の"],["町","まち"],["に"],["わたし"],["が"],["くだした"],["あらゆる"],["災い","わざわい"],["を"],["お前","おまえ"],["たち"],["は"],["見た","みた"],["。"],["これ"],["ら"],["の"],["町々","まちまち"],["は"],["今","いま"],["や"],["廃虚","はいきょ"],["と"],["化し","かし"],["、"],["住む","すむ"],["者","もの"],["も"],["ない"],["。"]]},{"verse":3,"text":"これは、彼らが悪を行ってわたしを怒らせたためである。彼らは自ら――お前たちも父祖たちも――知らなかった異教の神々のもとへ行って香をたき、礼拝した。","tok":[["これ"],["は"],["、"],["彼","かれ"],["ら"],["が"],["悪","あく"],["を"],["行って","おこなって"],["わたし"],["を"],["怒らせた","おこらせた"],["ため"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["自ら","みずから"],["―"],["―"],["お前","おまえ"],["たち"],["も"],["父祖","ふそ"],["たち"],["も"],["―"],["―"],["知らなかった","しらなかった"],["異教","いきょう"],["の"],["神々","かみがみ"],["の"],["もと"],["へ"],["行って","いって"],["香","こう"],["を"],["たき"],["、"],["礼拝","れいはい"],["した"],["。"]]},{"verse":4,"text":"わたしは、わが僕である預言者たちをお前たちのところへ繰り返し派遣して、わたしが憎むこの忌まわしいことを行ってはならないと命じた。","tok":[["わたし"],["は"],["、"],["わが"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["を"],["お前","おまえ"],["たち"],["の"],["ところ"],["へ"],["繰り返し","くりかえし"],["派遣","はけん"],["して"],["、"],["わたし"],["が"],["憎む","にくむ"],["この"],["忌まわしい","いまわしい"],["こと"],["を"],["行って","おこなって"],["は"],["ならない"],["と"],["命じた","めいじた"],["。"]]},{"verse":5,"text":"しかし、彼らは聞かず、耳を傾けず、悪を改めず、異教の神々に香をたくことをやめなかった。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["聞かず","きかず"],["、"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["悪","あく"],["を"],["改めず","あらためず"],["、"],["異教","いきょう"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たく"],["こと"],["を"],["やめなかった"],["。"]]},{"verse":6,"text":"そこでわたしの怒りと憤りがお前たちにふりかかり、ユダの町々とエルサレムの巷で燃え上がったので、今日のように荒れ果てて廃虚と化した。","tok":[["そこ"],["で"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["が"],["お前","おまえ"],["たち"],["に"],["ふりかかり"],["、"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["巷","ちまた"],["で"],["燃え上がった","もえあがった"],["ので"],["、"],["今日","きょう"],["の"],["よう"],["に"],["荒れ果てて","あれはてて"],["廃虚","はいきょ"],["と"],["化した","かした"],["。"]]},{"verse":7,"text":"そこで今、イスラエルの神、万軍の神である主はこう言われる。なぜ、お前たちは自分の身にこのように大きな悪を行い、男、女、子供、乳飲み子までユダの国から絶たれてひとりも残らないようにするのか。","tok":[["そこ"],["で"],["今","いま"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["なぜ"],["、"],["お前","おまえ"],["たち"],["は"],["自分","じぶん"],["の"],["身","み"],["に"],["この"],["よう"],["に"],["大きな","おおきな"],["悪","あく"],["を"],["行い","おこない"],["、"],["男","おとこ"],["、"],["女","おんな"],["、"],["子供","こども"],["、"],["乳飲み子","ちのみご"],["まで"],["ユダ"],["の"],["国","くに"],["から"],["絶たれて","たたれて"],["ひとり"],["も"],["残らない","のこらない"],["よう"],["に"],["する"],["の"],["か"],["。"]]},{"verse":8,"text":"何故、お前たちは移って寄留しているエジプトで、自分の手で偶像を造り、異教の神々に香をたき、わたしを怒らせ、自分を滅ぼし、世界のあらゆる国々で、ののしりと恥辱の的となるのか。","tok":[["何故","なぜ"],["、"],["お前","おまえ"],["たち"],["は"],["移って","うつって"],["寄留","きりゅう"],["して"],["いる"],["エジプト"],["で"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["偶像","ぐうぞう"],["を"],["造り","つくり"],["、"],["異教","いきょう"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["、"],["わたし"],["を"],["怒らせ","おこらせ"],["、"],["自分","じぶん"],["を"],["滅ぼし","ほろぼし"],["、"],["世界","せかい"],["の"],["あらゆる"],["国々","くにぐに"],["で"],["、"],["ののしり"],["と"],["恥辱","ちじょく"],["の"],["的","まと"],["と"],["なる"],["の"],["か"],["。"]]},{"verse":9,"text":"ユダの国とエルサレムの巷で行われたお前たちの父祖の悪、ユダの王と王妃たちの悪、また、お前たち自身と妻たちの悪を忘れたのか。","tok":[["ユダ"],["の"],["国","くに"],["と"],["エルサレム"],["の"],["巷","ちまた"],["で"],["行われた","おこなわれた"],["お前","おまえ"],["たち"],["の"],["父祖","ふそ"],["の"],["悪","わる"],["、"],["ユダ"],["の"],["王","おう"],["と"],["王妃","おうひ"],["たち"],["の"],["悪","わる"],["、"],["また"],["、"],["お前","おまえ"],["たち"],["自身","じしん"],["と"],["妻たち","つまたち"],["の"],["悪","あく"],["を"],["忘れた","わすれた"],["の"],["か"],["。"]]},{"verse":10,"text":"今日に至るまで、だれひとり悔いて、神を畏れようとはせず、またわたしがお前たちと父祖たちに授けた律法と掟に従って歩もうとはしなかった。","tok":[["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["だれ"],["ひとり"],["悔いて","くいて"],["、"],["神","かみ"],["を"],["畏れよう","おそれよう"],["と"],["は"],["せず"],["、"],["また"],["わたし"],["が"],["お前","おまえ"],["たち"],["と"],["父祖","ふそ"],["たち"],["に"],["授けた","さずけた"],["律法","りっぽう"],["と"],["掟","おきて"],["に"],["従って","したがって"],["歩もう","あゆもう"],["と"],["は"],["しなかった"],["。"]]},{"verse":11,"text":"それゆえ、イスラエルの神、万軍の主はこう言われる。わたしは、必ずお前たちに災いをくだし、ユダをことごとく滅ぼす。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["必ず","かならず"],["お前","おまえ"],["たち"],["に"],["災い","わざわい"],["を"],["くだし"],["、"],["ユダ"],["を"],["ことごとく"],["滅ぼす","ほろぼす"],["。"]]},{"verse":12,"text":"ユダに残っている者で、あくまでエジプトへ行って寄留しようとする人々をわたしは取り除く。彼らはひとり残らずエジプトの地で滅びる。彼らは剣と飢饉で倒れ、身分の上下を問わず、剣によって滅ぼされ、飢饉で死に絶え、呪い、恐怖、ののしり、恥辱の的となる。","tok":[["ユダ"],["に"],["残って","のこって"],["いる"],["者","もの"],["で"],["、"],["あくまで"],["エジプト"],["へ"],["行って","いって"],["寄留","きりゅう"],["しよう"],["と"],["する"],["人々","ひとびと"],["を"],["わたし"],["は"],["取り除く","とりのぞく"],["。"],["彼","かれ"],["ら"],["は"],["ひとり"],["残らず","のこらず"],["エジプト"],["の"],["地","ち"],["で"],["滅びる","ほろびる"],["。"],["彼","かれ"],["ら"],["は"],["剣","けん"],["と"],["飢饉","ききん"],["で"],["倒れ","たおれ"],["、"],["身分","みぶん"],["の"],["上下","じょうげ"],["を"],["問わず","とわず"],["、"],["剣","けん"],["によって"],["滅ぼされ","ほろぼされ"],["、"],["飢饉","ききん"],["で"],["死に絶え","しにたえ"],["、"],["呪い","のろい"],["、"],["恐怖","きょうふ"],["、"],["ののしり"],["、"],["恥辱","ちじょく"],["の"],["的","まと"],["と"],["なる"],["。"]]},{"verse":13,"text":"既にエルサレムを剣、飢饉、疫病をもって罰したように、わたしはエジプトに住む者を罰する。","tok":[["既に","すでに"],["エルサレム"],["を"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["疫病","やくびょう"],["を"],["もって"],["罰した","ばっした"],["よう"],["に"],["、"],["わたし"],["は"],["エジプト"],["に"],["住む","すむ"],["者","もの"],["を"],["罰する","ばっする"],["。"]]},{"verse":14,"text":"エジプトの地へ移って寄留しているユダの残留者には、難を免れ生き残り、ユダの地に帰りうる者はひとりもない。彼らは再びそこに帰って住むことを切望しているが、少数の難を免れた者を除けば、だれも帰ることはできない。」","tok":[["エジプト"],["の"],["地","ち"],["へ"],["移って","うつって"],["寄留","きりゅう"],["して"],["いる"],["ユダ"],["の"],["残留者","ざんりゅうしゃ"],["に"],["は"],["、"],["難","なん"],["を"],["免れ","まぬがれ"],["生き残り","いきのこり"],["、"],["ユダ"],["の"],["地","ち"],["に"],["帰り","かえり"],["うる"],["者","もの"],["は"],["ひとり"],["も"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["再び","ふたたび"],["そこ"],["に"],["帰って","かえって"],["住む","すむ"],["こと"],["を"],["切望","せつぼう"],["して"],["いる"],["が"],["、"],["少数","しょうすう"],["の"],["難","なん"],["を"],["免れた","まぬがれた"],["者","もの"],["を"],["除けば","のぞけば"],["、"],["だれ"],["も"],["帰る","かえる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":15,"text":"すると、自分たちの妻が異教の神々に香をたいているのを知っている男たち、そこに多く集まって居合わせていた女たち、更にはエジプトの上エジプトに住む人々がこぞってエレミヤに反論して言った。","tok":[["する"],["と"],["、"],["自分","じぶん"],["たち"],["の"],["妻","つま"],["が"],["異教","いきょう"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たいて"],["いる"],["の"],["を"],["知って","しって"],["いる"],["男","おとこ"],["たち"],["、"],["そこ"],["に"],["多く","おおく"],["集まって","あつまって"],["居合わせて","いあわせて"],["いた"],["女","おんな"],["たち"],["、"],["更に","さらに"],["は"],["エジプト"],["の"],["上","うえ"],["エジプト"],["に"],["住む","すむ"],["人々","ひとびと"],["が"],["こぞって"],["エレミヤ"],["に"],["反論","はんろん"],["して"],["言った","いった"],["。"]]},{"verse":16,"text":"「あなたが主の名を借りて我々に語った言葉に聞き従う者はない。","tok":[["「"],["あなた"],["が"],["主","ぬし"],["の"],["名","な"],["を"],["借りて","かりて"],["我々","われわれ"],["に"],["語った","かたった"],["言葉","ことば"],["に"],["聞き従う","ききしたがう"],["者","もの"],["は"],["ない"],["。"]]},{"verse":17,"text":"我々は誓ったとおり必ず行い、天の女王に香をたき、ぶどう酒を注いで献げ物とする。我々は、昔から父祖たちも歴代の王も高官たちも、ユダの町々とエルサレムの巷でそうしてきたのだ。我々は食物に満ち足り、豊かで、災いを見ることはなかった。","tok":[["我々","われわれ"],["は"],["誓った","ちかった"],["とおり"],["必ず","かならず"],["行い","おこない"],["、"],["天","てん"],["の"],["女王","じょおう"],["に"],["香","こう"],["を"],["たき"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["注いで","そそいで"],["献げ物","ささげもの"],["と"],["する"],["。"],["我々","われわれ"],["は"],["、"],["昔","むかし"],["から"],["父祖","ふそ"],["たち"],["も"],["歴代","れきだい"],["の"],["王","おう"],["も"],["高官","こうかん"],["たち"],["も"],["、"],["ユダ"],["の"],["町々","まちまち"],["と"],["エルサレム"],["の"],["巷","ちまた"],["で"],["そう"],["して"],["きた"],["の"],["だ"],["。"],["我々","われわれ"],["は"],["食物","しょくもつ"],["に"],["満ち足り","みちたり"],["、"],["豊か","ゆたか"],["で"],["、"],["災い","わざわい"],["を"],["見る","みる"],["こと"],["は"],["なかった"],["。"]]},{"verse":18,"text":"ところが、天の女王に香をたくのをやめ、ぶどう酒を注いでささげなくなって以来、我々はすべてのものに欠乏し、剣と飢饉によって滅亡の状態に陥った。","tok":[["ところ"],["が"],["、"],["天","てん"],["の"],["女王","じょおう"],["に"],["香","こう"],["を"],["たく"],["の"],["を"],["やめ"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["注いで","そそいで"],["ささげなく"],["なって"],["以来","いらい"],["、"],["我々","われわれ"],["は"],["すべて"],["の"],["もの"],["に"],["欠乏","けつぼう"],["し"],["、"],["剣","けん"],["と"],["飢饉","ききん"],["によって"],["滅亡","めつぼう"],["の"],["状態","じょうたい"],["に"],["陥った","おちいった"],["。"]]},{"verse":19,"text":"また、女たちは、『わたしたちが天の女王に香をたき、ぶどう酒を注いでささげていたとき、天の女王の像をかたどったパンを供え、ぶどう酒を注いでささげたのは、夫も承知のうえのことではなかったでしょうか』と言った。」","tok":[["また"],["、"],["女","おんな"],["たち"],["は"],["、"],["『"],["わたしたち"],["が"],["天","てん"],["の"],["女王","じょおう"],["に"],["香","こう"],["を"],["たき"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["注いで","そそいで"],["ささげて"],["いた"],["とき"],["、"],["天","てん"],["の"],["女王","じょおう"],["の"],["像","ぞう"],["を"],["かたどった"],["パン"],["を"],["供え","そなえ"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["注いで","そそいで"],["ささげた"],["の"],["は"],["、"],["夫","おっと"],["も"],["承知","しょうち"],["の"],["うえ"],["の"],["こと"],["で"],["は"],["なかったでしょう"],["か"],["』"],["と"],["言った","いった"],["。"],["」"]]},{"verse":20,"text":"そこで、エレミヤは、男女を問わず、彼に反論したすべての者に向かって、次のように言った。","tok":[["そこ"],["で"],["、"],["エレミヤ"],["は"],["、"],["男女","だんじょ"],["を"],["問わず","とわず"],["、"],["彼","かれ"],["に"],["反論","はんろん"],["した"],["すべて"],["の"],["者","もの"],["に"],["向かって","むかって"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"]]},{"verse":21,"text":"「お前たちは、父祖たちや歴代の王と高官、国の民と同様、ユダの町々やエルサレムの巷で香をたいたが、そのことを主が覚えておられず、心に留めておられないことがありえようか。","tok":[["「"],["お前","おまえ"],["たち"],["は"],["、"],["父祖","ふそ"],["たち"],["や"],["歴代","れきだい"],["の"],["王","おう"],["と"],["高官","こうかん"],["、"],["国","くに"],["の"],["民","たみ"],["と"],["同様","どうよう"],["、"],["ユダ"],["の"],["町々","まちまち"],["や"],["エルサレム"],["の"],["巷","ちまた"],["で"],["香","こう"],["を"],["たいた"],["が"],["、"],["その"],["こと"],["を"],["主","ぬし"],["が"],["覚えて","おぼえて"],["おられず"],["、"],["心","こころ"],["に"],["留めて","とめて"],["おられない"],["こと"],["が"],["あり"],["えよう"],["か"],["。"]]},{"verse":22,"text":"主は、お前たちが行った悪行や忌むべきことをもはや忍ぶことはおできにならなかった。だからお前たちの国は今日のように荒れ果てて廃虚と化し、ののしりの的となり、住む人もいなくなったのだ。","tok":[["主","ぬし"],["は"],["、"],["お前","おまえ"],["たち"],["が"],["行った","おこなった"],["悪行","あくぎょう"],["や"],["忌むべき","いむべき"],["こと"],["を"],["もはや"],["忍ぶ","しのぶ"],["こと"],["は"],["おでき"],["に"],["ならなかった"],["。"],["だ"],["から"],["お前","おまえ"],["たち"],["の"],["国","くに"],["は"],["今日","きょう"],["の"],["よう"],["に"],["荒れ果てて","あれはてて"],["廃虚","はいきょ"],["と"],["化し","かし"],["、"],["ののしり"],["の"],["的","まと"],["と"],["なり"],["、"],["住む","すむ"],["人","ひと"],["も"],["いなく"],["なった"],["の"],["だ"],["。"]]},{"verse":23,"text":"お前たちが香をたき、主に罪を犯し、主の声に聞き従わず、律法と掟と勧めに従って歩まなかったために、今日のようにこの災いが臨んだのだ。」","tok":[["お前","おまえ"],["たち"],["が"],["香","こう"],["を"],["たき"],["、"],["主に","おもに"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["主","ぬし"],["の"],["声","こえ"],["に"],["聞き従わず","ききしたがわず"],["、"],["律法","りっぽう"],["と"],["掟","おきて"],["と"],["勧め","すすめ"],["に"],["従って","したがって"],["歩まなかった","あゆまなかった"],["ため"],["に"],["、"],["今日","きょう"],["の"],["よう"],["に"],["この"],["災い","わざわい"],["が"],["臨んだ","のぞんだ"],["の"],["だ"],["。"],["」"]]},{"verse":24,"text":"エレミヤは一同と女たちに向かって言った。「エジプトにいるユダのすべての人よ、主の言葉を聞け。","tok":[["エレミヤ"],["は"],["一同","いちどう"],["と"],["女","おんな"],["たち"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["エジプト"],["に"],["いる"],["ユダ"],["の"],["すべて"],["の"],["人","ひと"],["よ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":25,"text":"イスラエルの神、万軍の主はこう言われる。お前たちは、妻たちと共に口で約束した事は手で実行する、我々が天の女王に香をたき、ぶどう酒を注いでささげると誓った以上、必ず誓いを果たす、と言っている。お前たちの誓いを果たし、誓いを必ず実行するがよい。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["、"],["妻たち","つまたち"],["と"],["共","とも"],["に"],["口","くち"],["で"],["約束","やくそく"],["した"],["事","こと"],["は"],["手","て"],["で"],["実行","じっこう"],["する"],["、"],["我々","われわれ"],["が"],["天","てん"],["の"],["女王","じょおう"],["に"],["香","こう"],["を"],["たき"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["注いで","そそいで"],["ささげる"],["と"],["誓った","ちかった"],["以上","いじょう"],["、"],["必ず","かならず"],["誓い","ちかい"],["を"],["果たす","はたす"],["、"],["と"],["言って","いって"],["いる"],["。"],["お前","おまえ"],["たち"],["の"],["誓い","ちかい"],["を"],["果たし","はたし"],["、"],["誓い","ちかい"],["を"],["必ず","かならず"],["実行","じっこう"],["する"],["が"],["よい"],["。"]]},{"verse":26,"text":"それゆえ、エジプトに住むユダのすべての人よ、主の言葉を聞け。わたしはわが大いなる名にかけて誓う、と主は言われる。エジプト全土のユダの人々の中に、『神である主は生きておられる』と言って、わたしの名を口に唱えて誓う人はひとりもなくなる。","tok":[["それ"],["ゆえ"],["、"],["エジプト"],["に"],["住む","すむ"],["ユダ"],["の"],["すべて"],["の"],["人","ひと"],["よ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["わたし"],["は"],["わが"],["大いなる","おおいなる"],["名","な"],["に"],["かけて"],["誓う","ちかう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["エジプト"],["全土","ぜんど"],["の"],["ユダ"],["の"],["人々","ひとびと"],["の"],["中","なか"],["に"],["、"],["『"],["神","かみ"],["で"],["ある"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["言って","いって"],["、"],["わたし"],["の"],["名","な"],["を"],["口","くち"],["に"],["唱えて","となえて"],["誓う","ちかう"],["人","ひと"],["は"],["ひとり"],["も"],["なくなる"],["。"]]},{"verse":27,"text":"見よ、わたしは彼らに災いをくだそうとして見張っている。幸いを与えるためではない。エジプトにいるユダの人々は、ひとり残らず剣と飢饉に襲われて滅びる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["災い","わざわい"],["を"],["くだそう"],["として"],["見張って","みはって"],["いる"],["。"],["幸い","さいわい"],["を"],["与える","あたえる"],["ため"],["で"],["は"],["ない"],["。"],["エジプト"],["に"],["いる"],["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["ひとり"],["残らず","のこらず"],["剣","けん"],["と"],["飢饉","ききん"],["に"],["襲われて","おそわれて"],["滅びる","ほろびる"],["。"]]},{"verse":28,"text":"剣を逃れてエジプトの地からユダの国へ帰還する者の数はまことにわずかである。そのときエジプトへ移って寄留したユダの残留者はすべて、わたしの言葉か、彼らの言葉か、どちらが本当であったかを悟るであろう。","tok":[["剣","けん"],["を"],["逃れて","のがれて"],["エジプト"],["の"],["地","ち"],["から"],["ユダ"],["の"],["国","くに"],["へ"],["帰還","きかん"],["する"],["者","もの"],["の"],["数","かず"],["は"],["まこと"],["に"],["わずか"],["で"],["ある"],["。"],["その"],["とき"],["エジプト"],["へ"],["移って","うつって"],["寄留","きりゅう"],["した"],["ユダ"],["の"],["残留者","ざんりゅうしゃ"],["は"],["すべて"],["、"],["わたし"],["の"],["言葉","ことば"],["か"],["、"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["か"],["、"],["どちら"],["が"],["本当","ほんとう"],["で"],["あった"],["か"],["を"],["悟るで","さとるで"],["あろう"],["。"]]},{"verse":29,"text":"このことこそ、わたしがこの場所でお前たちを罰したことのしるしとなるであろう、と主は言われる。そしてお前たちに災いを告げたわたしの言葉が実現したことを知るようになる。","tok":[["この"],["こと"],["こそ"],["、"],["わたし"],["が"],["この"],["場所","ばしょ"],["で"],["お前","おまえ"],["たち"],["を"],["罰した","ばっした"],["こと"],["の"],["しるし"],["と"],["なるで"],["あろう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["そして"],["お前","おまえ"],["たち"],["に"],["災い","わざわい"],["を"],["告げた","つげた"],["わたし"],["の"],["言葉","ことば"],["が"],["実現","じつげん"],["した"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":30,"text":"主はこう言われる。わたしは、エジプトの王であるファラオ、ホフラを、その命を求める敵の手に渡す。ちょうどユダの王ゼデキヤを、その命を求める敵、バビロンの王ネブカドレツァルの手に渡したように。」","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["エジプト"],["の"],["王","おう"],["で"],["ある"],["ファラオ"],["、"],["ホフラ"],["を"],["、"],["その"],["命","いのち"],["を"],["求める","もとめる"],["敵","てき"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["ちょうど"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["を"],["、"],["その"],["命","いのち"],["を"],["求める","もとめる"],["敵","てき"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["の"],["手","て"],["に"],["渡した","わたした"],["よう"],["に"],["。"],["」"]]}]
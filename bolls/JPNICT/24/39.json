[{"verse":1,"text":"ユダの王ゼデキヤの第九年十月に、バビロンの王ネブカドレツァルは全軍を率いてエルサレムに到着し、これを包囲した。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["の"],["第","だい"],["九","きゅう"],["年","ねん"],["十","じゅう"],["月","がつ"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["は"],["全軍","ぜんぐん"],["を"],["率いて","ひきいて"],["エルサレム"],["に"],["到着","とうちゃく"],["し"],["、"],["これ"],["を"],["包囲","ほうい"],["した"],["。"]]},{"verse":2,"text":"ゼデキヤの第十一年四月九日になって、都の一角が破られた。","tok":[["ゼデキヤ"],["の"],["第","だい"],["十一","じゅういち"],["年","ねん"],["四","し"],["月","がつ"],["九日","ここのか"],["に"],["なって"],["、"],["都","と"],["の"],["一角","いっかく"],["が"],["破られた","やぶられた"],["。"]]},{"verse":3,"text":"バビロンの王のすべての将軍が来て、中央の門に座を設けた。ネレガル‧サル‧エツェル、サムガル‧ネブ、侍従長サル‧セキム、指揮官ネレガル‧サル‧エツェル、およびバビロンの王の他のすべての将軍たちである。","tok":[["バビロン"],["の"],["王","おう"],["の"],["すべて"],["の"],["将軍","しょうぐん"],["が"],["来て","きて"],["、"],["中央","ちゅうおう"],["の"],["門","もん"],["に"],["座","ざ"],["を"],["設けた","もうけた"],["。"],["ネレガル"],["‧"],["サル"],["‧"],["エツェル"],["、"],["サムガル"],["‧"],["ネブ"],["、"],["侍従長","じじゅうちょう"],["サル"],["‧"],["セキム"],["、"],["指揮官","しきかん"],["ネレガル"],["‧"],["サル"],["‧"],["エツェル"],["、"],["および"],["バビロン"],["の"],["王","おう"],["の"],["他","ほか"],["の"],["すべて"],["の"],["将軍","しょうぐん"],["たち"],["で"],["ある"],["。"]]},{"verse":4,"text":"ユダの王ゼデキヤと戦士たちは皆、これを見て逃げた。夜中に彼らは二つの城壁の間にある門から、王の園を通り都を出て、アラバに向かって行った。","tok":[["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["と"],["戦士","せんし"],["たち"],["は"],["皆","みな"],["、"],["これ"],["を"],["見て","みて"],["逃げた","にげた"],["。"],["夜中","よなか"],["に"],["彼","かれ"],["ら"],["は"],["二","ふた"],["つ"],["の"],["城壁","じょうへき"],["の"],["間","あいだ"],["に"],["ある"],["門","もん"],["から"],["、"],["王","おう"],["の"],["園","その"],["を"],["通り","とおり"],["都","と"],["を"],["出て","でて"],["、"],["アラバ"],["に"],["向かって","むかって"],["行った","いった"],["。"]]},{"verse":5,"text":"カルデア軍は彼らの後を追い、エリコの荒れ地でゼデキヤに追いついた。王は捕らえられて、ハマト地方のリブラにいるバビロンの王ネブカドレツァルのもとに連れて行かれ、裁きを受けた。","tok":[["カルデア"],["軍","ぐん"],["は"],["彼","かれ"],["ら"],["の"],["後","あと"],["を"],["追い","おい"],["、"],["エリコ"],["の"],["荒れ地","あれち"],["で"],["ゼデキヤ"],["に"],["追いついた","おいついた"],["。"],["王","おう"],["は"],["捕らえられて","とらえられて"],["、"],["ハマト"],["地方","ちほう"],["の"],["リブラ"],["に"],["いる"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["の"],["もと"],["に"],["連れて","つれて"],["行かれ","いかれ"],["、"],["裁き","さばき"],["を"],["受けた","うけた"],["。"]]},{"verse":6,"text":"リブラでバビロンの王は、ゼデキヤの目の前でその王子たちを殺した。バビロンの王はユダの貴族たちもすべて殺した。","tok":[["リブラ"],["で"],["バビロン"],["の"],["王","おう"],["は"],["、"],["ゼデキヤ"],["の"],["目","め"],["の"],["前","まえ"],["で"],["その"],["王子","おうじ"],["たち"],["を"],["殺した","ころした"],["。"],["バビロン"],["の"],["王","おう"],["は"],["ユダ"],["の"],["貴族","きぞく"],["たち"],["も"],["すべて"],["殺した","ころした"],["。"]]},{"verse":7,"text":"その上で、バビロンの王はゼデキヤの両眼をつぶし、青銅の足枷をはめ、彼をバビロンに連れて行った。","tok":[["その"],["上","うえ"],["で"],["、"],["バビロン"],["の"],["王","おう"],["は"],["ゼデキヤ"],["の"],["両眼","りょうめ"],["を"],["つぶし"],["、"],["青銅","せいどう"],["の"],["足枷","あしかせ"],["を"],["はめ"],["、"],["彼","かれ"],["を"],["バビロン"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":8,"text":"カルデア人は、王宮と民家に火を放って焼き払い、エルサレムの城壁を取り壊した。","tok":[["カルデア"],["人","にん"],["は"],["、"],["王宮","おうきゅう"],["と"],["民家","みんか"],["に"],["火","ひ"],["を"],["放って","はなって"],["焼き払い","やきはらい"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["取り壊した","とりこわした"],["。"]]},{"verse":9,"text":"民のうち都に残っていたほかの者、投降した者、その他の生き残った民は、バビロンの親衛隊の長ネブザルアダンによって捕囚とされ、連れ去られた。","tok":[["民","みん"],["の"],["うち"],["都","みやこ"],["に"],["残って","のこって"],["いた"],["ほか"],["の"],["者","もの"],["、"],["投降","とうこう"],["した"],["者","もの"],["、"],["その"],["他","た"],["の"],["生き残った","いきのこった"],["民","たみ"],["は"],["、"],["バビロン"],["の"],["親衛隊","しんえいたい"],["の"],["長","ちょう"],["ネブザルアダン"],["によって"],["捕囚","ほしゅう"],["と"],["され"],["、"],["連れ去られた","つれさられた"],["。"]]},{"verse":10,"text":"その日、無産の貧しい民の一部は、親衛隊の長ネブザルアダンによってユダの土地に残され、ぶどう畑と耕地を与えられた。","tok":[["その"],["日","ひ"],["、"],["無産","むさん"],["の"],["貧しい","まずしい"],["民","たみ"],["の"],["一部","いちぶ"],["は"],["、"],["親衛隊","しんえいたい"],["の"],["長","ちょう"],["ネブザルアダン"],["によって"],["ユダ"],["の"],["土地","とち"],["に"],["残され","のこされ"],["、"],["ぶどう"],["畑","はたけ"],["と"],["耕地","こうち"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":11,"text":"バビロンの王ネブカドレツァルはエレミヤに関して、親衛隊の長ネブザルアダンに命令を下した。","tok":[["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["は"],["エレミヤ"],["に関して","にかんして"],["、"],["親衛隊","しんえいたい"],["の"],["長","ちょう"],["ネブザルアダン"],["に"],["命令","めいれい"],["を"],["下した","くだした"],["。"]]},{"verse":12,"text":"「彼を連れ出し、よく世話をするように。いかなる害も加えてはならない。彼が求めることは、何でもかなえてやるように。」","tok":[["「"],["彼","かれ"],["を"],["連れ出し","つれだし"],["、"],["よく"],["世話","せわ"],["を"],["する"],["よう"],["に"],["。"],["いかなる"],["害","がい"],["も"],["加えて","くわえて"],["は"],["ならない"],["。"],["彼","かれ"],["が"],["求める","もとめる"],["こと"],["は"],["、"],["何","なん"],["で"],["も"],["かなえて"],["やる"],["よう"],["に"],["。"],["」"]]},{"verse":13,"text":"そこで、親衛隊の長ネブザルアダンは侍従長ネブシャズバン、指揮官ネレガル‧サル‧エツェルはじめ、バビロンの王の長官たちを遣わし、","tok":[["そこ"],["で"],["、"],["親衛隊","しんえいたい"],["の"],["長","ちょう"],["ネブザルアダン"],["は"],["侍従長","じじゅうちょう"],["ネブシャズバン"],["、"],["指揮官","しきかん"],["ネレガル"],["‧"],["サル"],["‧"],["エツェル"],["はじめ"],["、"],["バビロン"],["の"],["王","おう"],["の"],["長官","ちょうかん"],["たち"],["を"],["遣わし","つかわし"],["、"]]},{"verse":14,"text":"監視の庭からエレミヤを連れ出し、シャファンの孫で、アヒカムの子であるゲダルヤに預け、家に送り届けさせた。こうして、エレミヤは民の間にとどまった。","tok":[["監視","かんし"],["の"],["庭","にわ"],["から"],["エレミヤ"],["を"],["連れ出し","つれだし"],["、"],["シャファン"],["の"],["孫","まご"],["で"],["、"],["アヒカム"],["の"],["子","こ"],["で"],["ある"],["ゲダルヤ"],["に"],["預け","あずけ"],["、"],["家","いえ"],["に"],["送り届けさせた","おくりとどけさせた"],["。"],["こう"],["して"],["、"],["エレミヤ"],["は"],["民","みん"],["の"],["間","あいだ"],["に"],["とどまった"],["。"]]},{"verse":15,"text":"エレミヤに主の言葉が臨んだ。それは、彼が監視の庭に監禁されているときのことであった。","tok":[["エレミヤ"],["に"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["臨んだ","のぞんだ"],["。"],["それ"],["は"],["、"],["彼","かれ"],["が"],["監視","かんし"],["の"],["庭","にわ"],["に"],["監禁","かんきん"],["されて"],["いる"],["とき"],["の"],["こと"],["で"],["あった"],["。"]]},{"verse":16,"text":"「クシュ人エベド‧メレクのもとに赴いて告げよ。イスラエルの神、万軍の主はこう言われる。見よ、わたしはこの都について告げたわたしの言葉を実現させる。それは災いであって、幸いではない。その日には、あなたの見ている前でこれらのことが起こる。","tok":[["「"],["クシュ人","くしゅにん"],["エベド"],["‧"],["メレク"],["の"],["もと"],["に"],["赴いて","おもむいて"],["告げ","つげ"],["よ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["都","と"],["について"],["告げた","つげた"],["わたし"],["の"],["言葉","ことば"],["を"],["実現","じつげん"],["させる"],["。"],["それ"],["は"],["災い","わざわい"],["で"],["あって"],["、"],["幸い","さいわい"],["で"],["は"],["ない"],["。"],["その"],["日","ひ"],["に"],["は"],["、"],["あなた"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["これ"],["ら"],["の"],["こと"],["が"],["起こる","おこる"],["。"]]},{"verse":17,"text":"しかし、その日に、わたしはあなたを救い出す、と主は言われる。あなたが恐れている人々の手に渡されることはない。","tok":[["しかし"],["、"],["その"],["日","ひ"],["に"],["、"],["わたし"],["は"],["あなた"],["を"],["救い出す","すくいだす"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["あなた"],["が"],["恐れて","おそれて"],["いる"],["人々","ひとびと"],["の"],["手","て"],["に"],["渡される","わたされる"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"わたしは必ずあなたを救う。剣にかけられることはなく、命だけは助かって生き残る。あなたがわたしを信頼したからである、と主は言われる。」","tok":[["わたし"],["は"],["必ず","かならず"],["あなた"],["を"],["救う","すくう"],["。"],["剣","けん"],["に"],["かけられる"],["こと"],["は"],["なく"],["、"],["命","いのち"],["だけ"],["は"],["助かって","たすかって"],["生き残る","いきのこる"],["。"],["あなた"],["が"],["わたし"],["を"],["信頼","しんらい"],["した"],["から"],["で"],["ある"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["」"]]}]
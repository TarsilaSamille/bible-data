[{"verse":1,"text":"正しいのは、主よ、あなたです。それでも、わたしはあなたと争い裁きについて論じたい。なぜ、神に逆らう者の道は栄え欺く者は皆、安穏に過ごしているのですか。","tok":[["正しい","ただしい"],["の"],["は"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["です"],["。"],["それ"],["で"],["も"],["、"],["わたし"],["は"],["あなた"],["と"],["争い","あらそい"],["裁き","さばき"],["について"],["論じたい","ろんじたい"],["。"],["なぜ"],["、"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["の"],["道","みち"],["は"],["栄え","さかえ"],["欺く","あざむく"],["者","もの"],["は"],["皆","みな"],["、"],["安穏","あんのん"],["に"],["過ごして","すごして"],["いる"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"あなたが彼らを植えられたので彼らは根を張り育って実を結んでいます。口先ではあなたに近く腹ではあなたから遠いのです。","tok":[["あなた"],["が"],["彼","かれ"],["ら"],["を"],["植えられた","うえられた"],["ので"],["彼","かれ"],["ら"],["は"],["根","ね"],["を"],["張り","はり"],["育って","そだって"],["実","じつ"],["を"],["結んで","むすんで"],["います"],["。"],["口先","くちさき"],["で"],["は"],["あなた"],["に"],["近く","ちかく"],["腹","はら"],["で"],["は"],["あなた"],["から"],["遠い","とおい"],["の"],["です"],["。"]]},{"verse":3,"text":"主よ、あなたはわたしをご存じです。わたしを見て、あなたに対するわたしの心を究められたはずです。彼らを屠られる羊として引き出し殺戮の日のために取り分けてください。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["ご存じ","ごぞんじ"],["です"],["。"],["わたし"],["を"],["見て","みて"],["、"],["あなた"],["に"],["対する","たいする"],["わたし"],["の"],["心","こころ"],["を"],["究められた","きわめられた"],["はず"],["です"],["。"],["彼","かれ"],["ら"],["を"],["屠られる","ほふられる"],["羊","ひつじ"],["として"],["引き出し","ひきだし"],["殺戮","さつりく"],["の"],["日","ひ"],["の"],["ため"],["に"],["取り分けて","とりわけて"],["ください"],["。"]]},{"verse":4,"text":"いつまで、この地は乾き野の青草もすべて枯れたままなのか。そこに住む者らの悪が鳥や獣を絶やしてしまった。まことに、彼らは言う。「神は我々の行く末を見てはおられない」と。","tok":[["いつ"],["まで"],["、"],["この"],["地","ち"],["は"],["乾き","かわき"],["野","や"],["の"],["青草","あおくさ"],["も"],["すべて"],["枯れた","かれた"],["まま"],["な"],["の"],["か"],["。"],["そこ"],["に"],["住む","すむ"],["者","もの"],["ら"],["の"],["悪","あく"],["が"],["鳥","とり"],["や"],["獣","けもの"],["を"],["絶やして","たやして"],["しまった"],["。"],["まこと"],["に"],["、"],["彼","かれ"],["ら"],["は"],["言う","ゆう"],["。"],["「"],["神","かみ"],["は"],["我々","われわれ"],["の"],["行く末","ゆくすえ"],["を"],["見て","みて"],["は"],["おられない"],["」"],["と"],["。"]]},{"verse":5,"text":"あなたが徒歩で行く者と競っても疲れるならどうして馬で行く者と争えようか。平穏な地でだけ、安んじていられるのならヨルダンの森林ではどうするのか。","tok":[["あなた"],["が"],["徒歩","とほ"],["で"],["行く","いく"],["者","もの"],["と"],["競って","きそって"],["も"],["疲れるなら","つかれるなら"],["どう"],["して"],["馬","うま"],["で"],["行く","いく"],["者","もの"],["と"],["争えよう","あらそえよう"],["か"],["。"],["平穏","へいおん"],["な"],["地","ち"],["で"],["だけ"],["、"],["安んじて","やすんじて"],["いられる"],["の"],["なら"],["ヨルダン"],["の"],["森林","しんりん"],["で"],["は"],["どう"],["する"],["の"],["か"],["。"]]},{"verse":6,"text":"あなたの兄弟や父の家の人々彼らでさえあなたを欺き彼らでさえあなたの背後で徒党を組んでいる。彼らを信じるな彼らが好意を示して話しかけても。","tok":[["あなた"],["の"],["兄弟","きょうだい"],["や"],["父","ちち"],["の"],["家","いえ"],["の"],["人々","ひとびと"],["彼","かれ"],["ら"],["で"],["さえ"],["あなた"],["を"],["欺き","あざむき"],["彼","かれ"],["ら"],["で"],["さえ"],["あなた"],["の"],["背後","はいご"],["で"],["徒党","ととう"],["を"],["組んで","くんで"],["いる"],["。"],["彼","かれ"],["ら"],["を"],["信じる","しんじる"],["な"],["彼","かれ"],["ら"],["が"],["好意","こうい"],["を"],["示して","しめして"],["話しかけて","はなしかけて"],["も"],["。"]]},{"verse":7,"text":"わたしはわたしの家を捨てわたしの嗣業を見放しわたしの愛するものを敵の手に渡した。","tok":[["わたし"],["は"],["わたし"],["の"],["家","いえ"],["を"],["捨て","すて"],["わたし"],["の"],["嗣業","しぎょう"],["を"],["見放し","みはなし"],["わたし"],["の"],["愛する","あいする"],["もの"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡した","わたした"],["。"]]},{"verse":8,"text":"わたしの嗣業はわたしに対して森の中の獅子となりわたしに向かってうなり声をあげる。わたしはそれを憎む。","tok":[["わたし"],["の"],["嗣業","しぎょう"],["は"],["わたし"],["に対して","にたいして"],["森","もり"],["の"],["中","なか"],["の"],["獅子","しし"],["と"],["なり"],["わたし"],["に"],["向かって","むかって"],["うなり声","うなりごえ"],["を"],["あげる"],["。"],["わたし"],["は"],["それ"],["を"],["憎む","にくむ"],["。"]]},{"verse":9,"text":"わたしの嗣業はわたしにとって猛禽がその上を舞っているハイエナのねぐらなのだろうか。野の獣よ、集まって餌を襲え。","tok":[["わたし"],["の"],["嗣業","しぎょう"],["は"],["わたし"],["にとって"],["猛禽","もうきん"],["が"],["その"],["上","うえ"],["を"],["舞って","まって"],["いる"],["ハイエナ"],["の"],["ねぐら"],["な"],["の"],["だろう"],["か"],["。"],["野","の"],["の"],["獣","けもの"],["よ"],["、"],["集まって","あつまって"],["餌","えさ"],["を"],["襲え","おそえ"],["。"]]},{"verse":10,"text":"多くの牧者がわたしのぶどう畑を滅ぼしわたしの所有地を踏みにじった。わたしの喜びとする所有地を打ち捨てられた荒れ野とし","tok":[["多く","おおく"],["の"],["牧者","ぼくしゃ"],["が"],["わたし"],["の"],["ぶどう"],["畑","はたけ"],["を"],["滅ぼし","ほろぼし"],["わたし"],["の"],["所有地","しょゆうち"],["を"],["踏みにじった","ふみにじった"],["。"],["わたし"],["の"],["喜び","よろこび"],["と"],["する"],["所有地","しょゆうち"],["を"],["打ち捨てられた","うちすてられた"],["荒れ野","あれの"],["と"],["し"]]},{"verse":11,"text":"それを打ち捨てられて嘆く地とした。それは打ち捨てられてわたしの前にある。大地はすべて打ち捨てられ心にかける者もない。","tok":[["それ"],["を"],["打ち捨てられて","うちすてられて"],["嘆く","なげく"],["地","ち"],["と"],["した"],["。"],["それ"],["は"],["打ち捨てられて","うちすてられて"],["わたし"],["の"],["前","まえ"],["に"],["ある"],["。"],["大地","だいち"],["は"],["すべて"],["打ち捨てられ","うちすてられ"],["心","こころ"],["に"],["かける"],["者","もの"],["も"],["ない"],["。"]]},{"verse":12,"text":"荒れ野の裸の山に略奪する者が来る。主の剣はむさぼる地の果てから果てまで。すべて肉なる者に平和はない。","tok":[["荒れ野","あれの"],["の"],["裸","はだか"],["の"],["山","やま"],["に"],["略奪","りゃくだつ"],["する"],["者","もの"],["が"],["来る","くる"],["。"],["主","ぬし"],["の"],["剣","けん"],["は"],["むさぼる"],["地","ち"],["の"],["果て","はて"],["から"],["果て","はて"],["まで"],["。"],["すべて"],["肉","にく"],["なる"],["者","もの"],["に"],["平和","へいわ"],["は"],["ない"],["。"]]},{"verse":13,"text":"麦を蒔いても、刈り取るのは茨でしかない。力を使い果たしても、効果はない。彼らは収穫がなくてうろたえる主の怒りと憤りのゆえに。","tok":[["麦","むぎ"],["を"],["蒔いて","まいて"],["も"],["、"],["刈り取る","かりとる"],["の"],["は"],["茨","うばら"],["で"],["しか"],["ない"],["。"],["力","ちから"],["を"],["使い果たして","つかいはたして"],["も"],["、"],["効果","こうか"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["収穫","しゅうかく"],["が"],["なくて"],["うろたえる"],["主","ぬし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["の"],["ゆえ"],["に"],["。"]]},{"verse":14,"text":"主はこう言われる。「わたしが、わたしの民イスラエルに継がせた嗣業に手を触れる近隣の悪い民をすべて、彼らの地から抜き捨てる。また、ユダの家を彼らの間から抜き取る。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["わたし"],["が"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["に"],["継がせた","つがせた"],["嗣業","しぎょう"],["に"],["手","て"],["を"],["触れる","ふれる"],["近隣","きんりん"],["の"],["悪い","わるい"],["民","たみ"],["を"],["すべて"],["、"],["彼","かれ"],["ら"],["の"],["地","ち"],["から"],["抜き捨てる","ぬきすてる"],["。"],["また"],["、"],["ユダ"],["の"],["家","いえ"],["を"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["から"],["抜き取る","ぬきとる"],["。"]]},{"verse":15,"text":"わたしは彼らを抜き取った後、再び彼らを憐れみ、そのひとりひとりをその嗣業に、その土地に帰らせる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["抜き取った","ぬきとった"],["後","あと"],["、"],["再び","ふたたび"],["彼","かれ"],["ら"],["を"],["憐れみ","あわれみ"],["、"],["その"],["ひとりひとり"],["を"],["その"],["嗣業","しぎょう"],["に"],["、"],["その"],["土地","とち"],["に"],["帰らせる","かえらせる"],["。"]]},{"verse":16,"text":"もしこれらの民が、かつてバアルによって誓うことをわたしの民に教えたように、わが名によって、『主は生きておられる』と誓うことを確かに学ぶならば、彼らはわたしの民の間に建てられる。","tok":[["もし"],["これ"],["ら"],["の"],["民","たみ"],["が"],["、"],["かつて"],["バアル"],["によって"],["誓う","ちかう"],["こと"],["を"],["わたし"],["の"],["民","たみ"],["に"],["教えた","おしえた"],["よう"],["に"],["、"],["わが"],["名","な"],["によって"],["、"],["『"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["』"],["と"],["誓う","ちかう"],["こと"],["を"],["確か","たしか"],["に"],["学ぶならば","まなぶならば"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["建てられる","たてられる"],["。"]]},{"verse":17,"text":"もし彼らが従わなければ、わたしはその民を必ず抜き捨てて、滅ぼす」と主は言われる。","tok":[["もし"],["彼","かれ"],["ら"],["が"],["従わなければ","したがわなければ"],["、"],["わたし"],["は"],["その"],["民","たみ"],["を"],["必ず","かならず"],["抜き捨てて","ぬきすてて"],["、"],["滅ぼす","ほろぼす"],["」"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
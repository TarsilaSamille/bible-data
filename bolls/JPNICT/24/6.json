[{"verse":1,"text":"ベニヤミンの人々よエルサレムの中から避難せよ。テコアで角笛を吹き鳴らしベト‧ケレムに向かってのろしを上げよ。災いと大いなる破壊が北から迫っている。","tok":[["ベニヤミン"],["の"],["人々","ひとびと"],["よ"],["エルサレム"],["の"],["中","なか"],["から"],["避難","ひなん"],["せよ"],["。"],["テコア"],["で"],["角笛","つのぶえ"],["を"],["吹き鳴らし","ふきならし"],["ベト"],["‧"],["ケレム"],["に"],["向かって","むかって"],["のろし"],["を"],["上げ","あげ"],["よ"],["。"],["災い","わざわい"],["と"],["大いなる","おおいなる"],["破壊","はかい"],["が"],["北","きた"],["から"],["迫って","せまって"],["いる"],["。"]]},{"verse":2,"text":"美しく、快楽になれた女、娘シオンよわたしはお前を滅ぼす。","tok":[["美しく","うつくしく"],["、"],["快楽","かいらく"],["に"],["なれた"],["女","おんな"],["、"],["娘","むすめ"],["シオン"],["よ"],["わたし"],["は"],["お前","おまえ"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":3,"text":"羊飼いが、その群れと共にやって来る。彼女に向かって周囲に天幕を張りそれぞれに、草を食い尽くす。","tok":[["羊飼い","ひつじかい"],["が"],["、"],["その"],["群れ","むれ"],["と"],["共","とも"],["に"],["やって"],["来る","くる"],["。"],["彼女","かのじょ"],["に"],["向かって","むかって"],["周囲","しゅうい"],["に"],["天幕","てんまく"],["を"],["張り","はり"],["それぞれ"],["に"],["、"],["草","くさ"],["を"],["食い","くい"],["尽くす","つくす"],["。"]]},{"verse":4,"text":"シオンに対して戦闘を開始せよ。立て、昼の間に攻め上ろう。大変だ、日が傾き、夕日の影が伸びてきた。","tok":[["シオン"],["に対して","にたいして"],["戦闘","せんとう"],["を"],["開始","かいし"],["せよ"],["。"],["立て","たて"],["、"],["昼","ひる"],["の"],["間","あいだ"],["に"],["攻め上ろう","せめのぼろう"],["。"],["大変","たいへん"],["だ"],["、"],["日","ひ"],["が"],["傾き","かたむき"],["、"],["夕日","ゆうひ"],["の"],["影","かげ"],["が"],["伸びて","のびて"],["きた"],["。"]]},{"verse":5,"text":"立て、夜襲をかけよう。城郭を破壊しよう。","tok":[["立て","たて"],["、"],["夜襲","やしゅう"],["を"],["かけよう"],["。"],["城郭","じょうかく"],["を"],["破壊","はかい"],["しよう"],["。"]]},{"verse":6,"text":"まことに、万軍の主はこう言われる。「木を切り、土を盛りエルサレムに対して攻城の土塁を築け。彼女は罰せられるべき都その中には抑圧があるのみ。","tok":[["まこと"],["に"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["木","き"],["を"],["切り","きり"],["、"],["土","つち"],["を"],["盛り","もり"],["エルサレム"],["に対して","にたいして"],["攻城","こうじょう"],["の"],["土塁","どるい"],["を"],["築け","きずけ"],["。"],["彼女","かのじょ"],["は"],["罰せられるべき","ばっせられるべき"],["都","と"],["その"],["中","なか"],["に"],["は"],["抑圧","よくあつ"],["が"],["ある"],["のみ"],["。"]]},{"verse":7,"text":"泉の水が湧くように彼女の悪は湧き出る。不法と暴力の叫びが聞こえてくる。病と傷は、常にわたしの前にある。","tok":[["泉","いずみ"],["の"],["水","みず"],["が"],["湧く","わく"],["よう"],["に"],["彼女","かのじょ"],["の"],["悪","あく"],["は"],["湧き出る","わきでる"],["。"],["不法","ふほう"],["と"],["暴力","ぼうりょく"],["の"],["叫び","さけび"],["が"],["聞こえて","きこえて"],["くる"],["。"],["病","やまい"],["と"],["傷","きず"],["は"],["、"],["常","つね"],["に"],["わたし"],["の"],["前","まえ"],["に"],["ある"],["。"]]},{"verse":8,"text":"エルサレムよ、懲らしめを受け入れよ。さもないと、わたしはお前を見捨て荒れ果てて人の住まない地とする。」","tok":[["エルサレム"],["よ"],["、"],["懲らしめ","こらしめ"],["を"],["受け入れよ","うけいれよ"],["。"],["さも"],["ない"],["と"],["、"],["わたし"],["は"],["お前","おまえ"],["を"],["見捨て","みすて"],["荒れ果てて","あれはてて"],["人","ひと"],["の"],["住まない","すまない"],["地","ち"],["と"],["する"],["。"],["」"]]},{"verse":9,"text":"万軍の主はこう言われる。「ぶどうの残りを摘むようにイスラエルの残りの者を摘み取れ。ぶどうを摘む者がするようにお前は、手をもう一度ぶどうの枝に伸ばせ。」","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["ぶどう"],["の"],["残り","のこり"],["を"],["摘む","つむ"],["よう"],["に"],["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["摘み取れ","つみとれ"],["。"],["ぶどう"],["を"],["摘む","つむ"],["者","もの"],["が"],["する"],["よう"],["に"],["お前","おまえ"],["は"],["、"],["手","て"],["を"],["もう"],["一","いち"],["度","ど"],["ぶどう"],["の"],["枝","えだ"],["に"],["伸ばせ","のばせ"],["。"],["」"]]},{"verse":10,"text":"誰に向かって語り、警告すれば聞き入れるのだろうか。見よ、彼らの耳は無割礼で耳を傾けることができない。見よ、主の言葉が彼らに臨んでもそれを侮り、受け入れようとしない。","tok":[["誰","だれ"],["に"],["向かって","むかって"],["語り","かたり"],["、"],["警告","けいこく"],["すれば"],["聞き入れる","ききいれる"],["の"],["だろう"],["か"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["の"],["耳","みみ"],["は"],["無","む"],["割礼","かつれい"],["で"],["耳","みみ"],["を"],["傾ける","かたむける"],["こと"],["が"],["できない"],["。"],["見よ","みよ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["彼","かれ"],["ら"],["に"],["臨んで","のぞんで"],["も"],["それ"],["を"],["侮り","あなどり"],["、"],["受け入れよう","うけいれよう"],["と"],["しない"],["。"]]},{"verse":11,"text":"主の怒りでわたしは満たされそれに耐えることに疲れ果てた。「それを注ぎ出せ通りにいる幼子、若者の集いに。男も女も、長老も年寄りも必ず捕らえられる。","tok":[["主","ぬし"],["の"],["怒り","いかり"],["で"],["わたし"],["は"],["満たされ","みたされ"],["それ"],["に"],["耐える","たえる"],["こと"],["に"],["疲れ","つかれ"],["果てた","はてた"],["。"],["「"],["それ"],["を"],["注ぎ","そそぎ"],["出せ","だせ"],["通り","とおり"],["に"],["いる"],["幼子","おさなご"],["、"],["若者","わかもの"],["の"],["集い","つどい"],["に"],["。"],["男","おとこ"],["も"],["女","おんな"],["も"],["、"],["長老","ちょうろう"],["も"],["年寄り","としより"],["も"],["必ず","かならず"],["捕らえられる","とらえられる"],["。"]]},{"verse":12,"text":"家も畑も妻もすべて他人の手に渡る。この国に住む者に対してわたしが手を伸ばすからだ」と主は言われる。","tok":[["家","いえ"],["も"],["畑","はたけ"],["も"],["妻","つま"],["も"],["すべて"],["他人","たにん"],["の"],["手","て"],["に"],["渡る","わたる"],["。"],["この"],["国","くに"],["に"],["住む","すむ"],["者","もの"],["に対して","にたいして"],["わたし"],["が"],["手","て"],["を"],["伸ばす","のばす"],["から"],["だ"],["」"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"「身分の低い者から高い者に至るまで皆、利をむさぼり預言者から祭司に至るまで皆、欺く。","tok":[["「"],["身分","みぶん"],["の"],["低い","ひくい"],["者","もの"],["から"],["高い","たかい"],["者","もの"],["に"],["至る","いたる"],["まで"],["皆","みな"],["、"],["利","り"],["を"],["むさぼり"],["預言者","よげんしゃ"],["から"],["祭司","さいし"],["に"],["至る","いたる"],["まで"],["皆","みな"],["、"],["欺く","あざむく"],["。"]]},{"verse":14,"text":"彼らは、わが民の破滅を手軽に治療して平和がないのに、『平和、平和』と言う。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わが"],["民","たみ"],["の"],["破滅","はめつ"],["を"],["手軽","てがる"],["に"],["治療","ちりょう"],["して"],["平和","へいわ"],["が"],["ない"],["のに"],["、"],["『"],["平和","へいわ"],["、"],["平和","へいわ"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":15,"text":"彼らは忌むべきことをして恥をさらした。しかも、恥ずかしいとは思わず嘲られていることに気づかない。それゆえ、人々が倒れるとき、彼らも倒れわたしが彼らを罰するとき彼らはつまずく」と主は言われる。","tok":[["彼","かれ"],["ら"],["は"],["忌むべき","いむべき"],["こと"],["を"],["して"],["恥","はじ"],["を"],["さらした"],["。"],["しかも"],["、"],["恥ずかしい","はずかしい"],["と"],["は"],["思わず","おもわず"],["嘲られて","あざけられて"],["いる"],["こと"],["に"],["気づかない","きづかない"],["。"],["それ"],["ゆえ"],["、"],["人々","ひとびと"],["が"],["倒れる","たおれる"],["とき"],["、"],["彼","かれ"],["ら"],["も"],["倒れ","たおれ"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["罰する","ばっする"],["とき"],["彼","かれ"],["ら"],["は"],["つまずく"],["」"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":16,"text":"主はこう言われる。「さまざまな道に立って、眺めよ。昔からの道に問いかけてみよどれが、幸いに至る道か、と。その道を歩み、魂に安らぎを得よ。」しかし、彼らは言った。「そこを歩むことをしない」と。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["さまざま"],["な"],["道","みち"],["に"],["立って","たって"],["、"],["眺め","ながめ"],["よ"],["。"],["昔","むかし"],["から"],["の"],["道","みち"],["に"],["問いかけて","といかけて"],["みよ"],["どれ"],["が"],["、"],["幸い","さいわい"],["に"],["至る","いたる"],["道","みち"],["か"],["、"],["と"],["。"],["その"],["道","みち"],["を"],["歩み","あゆみ"],["、"],["魂","たましい"],["に"],["安らぎ","やすらぎ"],["を"],["得","え"],["よ"],["。"],["」"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["そこ"],["を"],["歩む","あゆむ"],["こと"],["を"],["しない"],["」"],["と"],["。"]]},{"verse":17,"text":"わたしは、「あなたたちのために見張りを立て耳を澄まして角笛の響きを待て」と言った。しかし、彼らは言った。「耳を澄まして待つことはしない」と。","tok":[["わたし"],["は"],["、"],["「"],["あなた"],["たち"],["の"],["ため"],["に"],["見張り","みはり"],["を"],["立て","たて"],["耳","みみ"],["を"],["澄まして","すまして"],["角笛","つのぶえ"],["の"],["響き","ひびき"],["を"],["待て","まて"],["」"],["と"],["言った","いった"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["耳","みみ"],["を"],["澄まして","すまして"],["待つ","まつ"],["こと"],["は"],["しない"],["」"],["と"],["。"]]},{"verse":18,"text":"「それゆえ、国々よ、聞け。わたしが彼らにしようとすることを知れ。","tok":[["「"],["それ"],["ゆえ"],["、"],["国々","くにぐに"],["よ"],["、"],["聞け","きけ"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["しよう"],["と"],["する"],["こと"],["を"],["知れ","しれ"],["。"]]},{"verse":19,"text":"この地よ、聞け。見よ、わたしはこの民に災いをもたらす。それは彼らのたくらみが結んだ実である。彼らがわたしの言葉に耳を傾けずわたしの教えを拒んだからだ。","tok":[["この"],["地","ち"],["よ"],["、"],["聞け","きけ"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["民","たみ"],["に"],["災い","わざわい"],["を"],["もたらす"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["の"],["たくらみ"],["が"],["結んだ","むすんだ"],["実","じつ"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["言葉","ことば"],["に"],["耳","みみ"],["を"],["傾けず","かたむけず"],["わたし"],["の"],["教え","おしえ"],["を"],["拒んだ","こばんだ"],["から"],["だ"],["。"]]},{"verse":20,"text":"シェバから持って来た乳香やはるかな国からの香水萱がわたしにとって何の意味があろうか。あなたたちの焼き尽くす献げ物を喜ばずいけにえをわたしは好まない。」","tok":[["シェバ"],["から"],["持って","もって"],["来た","きた"],["乳香","にゅうこう"],["や"],["はるか"],["な"],["国","くに"],["から"],["の"],["香水","こうすい"],["萱","かや"],["が"],["わたし"],["にとって"],["何","なん"],["の"],["意味","いみ"],["が"],["あろう"],["か"],["。"],["あなた"],["たち"],["の"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["喜ばず","よろこばず"],["いけにえ"],["を"],["わたし"],["は"],["好まない","このまない"],["。"],["」"]]},{"verse":21,"text":"それゆえ、主はこう言われる。「見よ、わたしはこの民につまずきを置く。彼らはそれにつまずく。父も子も共に、隣人も友も皆、滅びる。」","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["この"],["民","たみ"],["に"],["つまずき"],["を"],["置く","おく"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["に"],["つまずく"],["。"],["父","ちち"],["も"],["子","こ"],["も"],["共","とも"],["に"],["、"],["隣人","りんじん"],["も"],["友","とも"],["も"],["皆","みな"],["、"],["滅びる","ほろびる"],["。"],["」"]]},{"verse":22,"text":"主はこう言われる。「見よ、一つの民が北の国から来る。大いなる国が地の果てから奮い立って来る。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["見よ","みよ"],["、"],["一","ひと"],["つ"],["の"],["民","たみ"],["が"],["北","きた"],["の"],["国","くに"],["から"],["来る","くる"],["。"],["大いなる","おおいなる"],["国","くに"],["が"],["地","ち"],["の"],["果て","はて"],["から"],["奮い立って","ふるいたって"],["来る","くる"],["。"]]},{"verse":23,"text":"弓と投げ槍を取り、残酷で、容赦しない。海のとどろくような声をあげ、馬を駆り戦いに備えて武装している。娘シオンよ、あなたに向かって。」","tok":[["弓","ゆみ"],["と"],["投げ槍","なげやり"],["を"],["取り","とり"],["、"],["残酷","ざんこく"],["で"],["、"],["容赦","ようしゃ"],["しない"],["。"],["海","うみ"],["の"],["とどろく"],["よう"],["な"],["声","こえ"],["を"],["あげ"],["、"],["馬","うま"],["を"],["駆り","かり"],["戦い","たたかい"],["に"],["備えて","そなえて"],["武装","ぶそう"],["して"],["いる"],["。"],["娘","むすめ"],["シオン"],["よ"],["、"],["あなた"],["に"],["向かって","むかって"],["。"],["」"]]},{"verse":24,"text":"我々はその知らせを聞き、手の力は抜けた。苦しみに捕らえられ我々は産婦のようにもだえる。","tok":[["我々","われわれ"],["は"],["その"],["知らせ","しらせ"],["を"],["聞き","きき"],["、"],["手","て"],["の"],["力","ちから"],["は"],["抜けた","ぬけた"],["。"],["苦しみ","くるしみ"],["に"],["捕らえられ","とらえられ"],["我々","われわれ"],["は"],["産婦","さんぷ"],["の"],["よう"],["に"],["もだえる"],["。"]]},{"verse":25,"text":"「野に出るな、道を行くな。敵は剣を取り、恐怖が四方から迫る。","tok":[["「"],["野","の"],["に"],["出る","でる"],["な"],["、"],["道","みち"],["を"],["行く","いく"],["な"],["。"],["敵","てき"],["は"],["剣","けん"],["を"],["取り","とり"],["、"],["恐怖","きょうふ"],["が"],["四方","しほう"],["から"],["迫る","せまる"],["。"]]},{"verse":26,"text":"わが民の娘よ、粗布をまとい灰を身にかぶれ。独り子を失ったように喪に服し苦悩に満ちた嘆きの声をあげよ。略奪する者が、突如として我々を襲う。」","tok":[["わが"],["民","たみ"],["の"],["娘","むすめ"],["よ"],["、"],["粗布","そふ"],["を"],["まとい"],["灰","はい"],["を"],["身","み"],["に"],["かぶれ"],["。"],["独り子","ひとりご"],["を"],["失った","うしなった"],["よう"],["に"],["喪","も"],["に"],["服し","ふくし"],["苦悩","くのう"],["に"],["満ちた","みちた"],["嘆き","なげき"],["の"],["声","こえ"],["を"],["あげ"],["よ"],["。"],["略奪","りゃくだつ"],["する"],["者","もの"],["が"],["、"],["突如","とつじょ"],["として"],["我々","われわれ"],["を"],["襲う","おそう"],["。"],["」"]]},{"verse":27,"text":"わたしはあなたをわが民の中に金を試す者として立てた。彼らの道を試し、知るがよい。","tok":[["わたし"],["は"],["あなた"],["を"],["わが"],["民","たみ"],["の"],["中","なか"],["に"],["金","かね"],["を"],["試す","ためす"],["者","もの"],["として"],["立てた","たてた"],["。"],["彼","かれ"],["ら"],["の"],["道","みち"],["を"],["試し","ためし"],["、"],["知る","しる"],["が"],["よい"],["。"]]},{"verse":28,"text":"彼らは皆、道を外れ、中傷して歩く。彼らは皆、青銅や鉄の滓罠を仕掛けて人を滅ぼす者だ。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["道","みち"],["を"],["外れ","はずれ"],["、"],["中傷","ちゅうしょう"],["して"],["歩く","あるく"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["青銅","せいどう"],["や"],["鉄","てつ"],["の"],["滓","かす"],["罠","わな"],["を"],["仕掛けて","しかけて"],["人","ひと"],["を"],["滅ぼす","ほろぼす"],["者","もの"],["だ"],["。"]]},{"verse":29,"text":"鉛はふいごで起こした火に溶ける。彼らも火で試されたが、空しかった。彼らの悪は取り除かれることがなかった。","tok":[["鉛","なまり"],["は"],["ふいご"],["で"],["起こした","おこした"],["火","ひ"],["に"],["溶ける","とける"],["。"],["彼","かれ"],["ら"],["も"],["火","ひ"],["で"],["試された","ためされた"],["が"],["、"],["空しかった","むなしかった"],["。"],["彼","かれ"],["ら"],["の"],["悪","あく"],["は"],["取り除かれる","とりのぞかれる"],["こと"],["が"],["なかった"],["。"]]},{"verse":30,"text":"捨てられた銀の滓、と彼らは呼ばれる。主が彼らを捨てられたからだ。","tok":[["捨てられた","すてられた"],["銀","ぎん"],["の"],["滓","かす"],["、"],["と"],["彼","かれ"],["ら"],["は"],["呼ばれる","よばれる"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["捨てられた","すてられた"],["から"],["だ"],["。"]]}]
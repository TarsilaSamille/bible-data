[{"verse":1,"text":"以下に記すのは、ネブカドネツァルがエルサレムからバビロンへ捕囚として連れて行った長老、祭司、預言者たち、および民のすべてに、預言者エレミヤがエルサレムから書き送った手紙の文面である。","tok":[["以下","いか"],["に"],["記す","しるす"],["の"],["は"],["、"],["ネブカドネツァル"],["が"],["エルサレム"],["から"],["バビロン"],["へ"],["捕囚","ほしゅう"],["として"],["連れて","つれて"],["行った","いった"],["長老","ちょうろう"],["、"],["祭司","さいし"],["、"],["預言者","よげんしゃ"],["たち"],["、"],["および"],["民","みん"],["の"],["すべて"],["に"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["が"],["エルサレム"],["から"],["書き送った","かきおくった"],["手紙","てがみ"],["の"],["文面","ぶんめん"],["で"],["ある"],["。"]]},{"verse":2,"text":"それは、エコンヤ王、太后、宦官、ユダとエルサレムの高官、工匠と鍛冶とがエルサレムを去った後のことである。","tok":[["それ"],["は"],["、"],["エコンヤ"],["王","おう"],["、"],["太后","たいごう"],["、"],["宦官","かんがん"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["高官","こうかん"],["、"],["工匠","こうしょう"],["と"],["鍛冶","たんや"],["と"],["が"],["エルサレム"],["を"],["去った","さった"],["後","あと"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":3,"text":"この手紙は、ユダの王ゼデキヤが、バビロンの王ネブカドネツァルのもとに派遣したシャファンの子エルアサとヒルキヤの子ゲマルヤに託された。","tok":[["この"],["手紙","てがみ"],["は"],["、"],["ユダ"],["の"],["王","おう"],["ゼデキヤ"],["が"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["の"],["もと"],["に"],["派遣","はけん"],["した"],["シャファン"],["の"],["子","こ"],["エルアサ"],["と"],["ヒルキヤ"],["の"],["子","こ"],["ゲマルヤ"],["に"],["託された","たくされた"],["。"]]},{"verse":4,"text":"「イスラエルの神、万軍の主はこう言われる。わたしは、エルサレムからバビロンへ捕囚として送ったすべての者に告げる。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["エルサレム"],["から"],["バビロン"],["へ"],["捕囚","ほしゅう"],["として"],["送った","おくった"],["すべて"],["の"],["者","もの"],["に"],["告げる","つげる"],["。"]]},{"verse":5,"text":"家を建てて住み、園に果樹を植えてその実を食べなさい。","tok":[["家","いえ"],["を"],["建てて","たてて"],["住み","すみ"],["、"],["園","その"],["に"],["果樹","かじゅ"],["を"],["植えて","うえて"],["その"],["実","じつ"],["を"],["食べ","たべ"],["なさい"],["。"]]},{"verse":6,"text":"妻をめとり、息子、娘をもうけ、息子には嫁をとり、娘は嫁がせて、息子、娘を産ませるように。そちらで人口を増やし、減らしてはならない。","tok":[["妻","つま"],["を"],["めとり"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["を"],["もうけ"],["、"],["息子","むすこ"],["に"],["は"],["嫁","よめ"],["を"],["とり"],["、"],["娘","むすめ"],["は"],["嫁がせて","とつがせて"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["を"],["産ませる","うませる"],["よう"],["に"],["。"],["そちら"],["で"],["人口","じんこう"],["を"],["増やし","ふやし"],["、"],["減らして","へらして"],["は"],["ならない"],["。"]]},{"verse":7,"text":"わたしが、あなたたちを捕囚として送った町の平安を求め、その町のために主に祈りなさい。その町の平安があってこそ、あなたたちにも平安があるのだから。","tok":[["わたし"],["が"],["、"],["あなた"],["たち"],["を"],["捕囚","ほしゅう"],["として"],["送った","おくった"],["町","まち"],["の"],["平安","へいあん"],["を"],["求め","もとめ"],["、"],["その"],["町","まち"],["の"],["ため"],["に"],["主","ぬし"],["に"],["祈り","いのり"],["なさい"],["。"],["その"],["町","まち"],["の"],["平安","へいあん"],["が"],["あって"],["こそ"],["、"],["あなた"],["たち"],["に"],["も"],["平安","へいあん"],["が"],["ある"],["の"],["だ"],["から"],["。"]]},{"verse":8,"text":"イスラエルの神、万軍の主はこう言われる。あなたたちのところにいる預言者や占い師たちにだまされてはならない。彼らの見た夢に従ってはならない。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["あなた"],["たち"],["の"],["ところ"],["に"],["いる"],["預言者","よげんしゃ"],["や"],["占い師","うらないし"],["たち"],["に"],["だまされて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["見た","みた"],["夢","ゆめ"],["に"],["従って","したがって"],["は"],["ならない"],["。"]]},{"verse":9,"text":"彼らは、わたしの名を使って偽りの預言をしているからである。わたしは、彼らを遣わしてはいない、と主は言われる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["名","な"],["を"],["使って","つかって"],["偽り","いつわり"],["の"],["預言","よげん"],["を"],["して"],["いる"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["遣わして","つかわして"],["は"],["いない"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"主はこう言われる。バビロンに七十年の時が満ちたなら、わたしはあなたたちを顧みる。わたしは恵みの約束を果たし、あなたたちをこの地に連れ戻す。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["バビロン"],["に"],["七十","ななじゅう"],["年","ねん"],["の"],["時","とき"],["が"],["満ちたなら","みちたなら"],["、"],["わたし"],["は"],["あなた"],["たち"],["を"],["顧みる","かえりみる"],["。"],["わたし"],["は"],["恵み","めぐみ"],["の"],["約束","やくそく"],["を"],["果たし","はたし"],["、"],["あなた"],["たち"],["を"],["この"],["地","ち"],["に"],["連れ戻す","つれもどす"],["。"]]},{"verse":11,"text":"わたしは、あなたたちのために立てた計画をよく心に留めている、と主は言われる。それは平和の計画であって、災いの計画ではない。将来と希望を与えるものである。","tok":[["わたし"],["は"],["、"],["あなた"],["たち"],["の"],["ため"],["に"],["立てた","たてた"],["計画","けいかく"],["を"],["よく"],["心","こころ"],["に"],["留めて","とめて"],["いる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["それ"],["は"],["平和","へいわ"],["の"],["計画","けいかく"],["で"],["あって"],["、"],["災い","わざわい"],["の"],["計画","けいかく"],["で"],["は"],["ない"],["。"],["将来","しょうらい"],["と"],["希望","きぼう"],["を"],["与える","あたえる"],["もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"そのとき、あなたたちがわたしを呼び、来てわたしに祈り求めるなら、わたしは聞く。","tok":[["その"],["とき"],["、"],["あなた"],["たち"],["が"],["わたし"],["を"],["呼び","よび"],["、"],["来て","きて"],["わたし"],["に"],["祈り求めるなら","いのりもとめるなら"],["、"],["わたし"],["は"],["聞く","きく"],["。"]]},{"verse":13,"text":"わたしを尋ね求めるならば見いだし、心を尽くしてわたしを求めるなら、","tok":[["わたし"],["を"],["尋ね求めるならば","たずねもとめるならば"],["見いだし","みいだし"],["、"],["心","こころ"],["を"],["尽くして","つくして"],["わたし"],["を"],["求めるなら","もとめるなら"],["、"]]},{"verse":14,"text":"わたしに出会うであろう、と主は言われる。わたしは捕囚の民を帰らせる。わたしはあなたたちをあらゆる国々の間に、またあらゆる地域に追いやったが、そこから呼び集め、かつてそこから捕囚として追い出した元の場所へ連れ戻す、と主は言われる。","tok":[["わたし"],["に"],["出会うで","であうで"],["あろう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["捕囚","ほしゅう"],["の"],["民","たみ"],["を"],["帰らせる","かえらせる"],["。"],["わたし"],["は"],["あなた"],["たち"],["を"],["あらゆる"],["国々","くにぐに"],["の"],["間","あいだ"],["に"],["、"],["また"],["あらゆる"],["地域","ちいき"],["に"],["追いやった","おいやった"],["が"],["、"],["そこ"],["から"],["呼び集め","よびあつめ"],["、"],["かつて"],["そこ"],["から"],["捕囚","ほしゅう"],["として"],["追い出した","おいだした"],["元","もと"],["の"],["場所","ばしょ"],["へ"],["連れ戻す","つれもどす"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"あなたたちは、『主が我々のために、バビロンでも預言者を立ててくださった』と言っている。","tok":[["あなた"],["たち"],["は"],["、"],["『"],["主","ぬし"],["が"],["我々","われわれ"],["の"],["ため"],["に"],["、"],["バビロン"],["で"],["も"],["預言者","よげんしゃ"],["を"],["立てて","たてて"],["くださった"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":16,"text":"そこで、ダビデの王座についている王と、この都に住む民のすべて、すなわち捕囚としてあなたたちと共に出て行かなかった同胞に対して、主はこう言われる。","tok":[["そこ"],["で"],["、"],["ダビデ"],["の"],["王座","おうざ"],["について"],["いる"],["王","おう"],["と"],["、"],["この"],["都","と"],["に"],["住む","すむ"],["民","たみ"],["の"],["すべて"],["、"],["すなわち"],["捕囚","ほしゅう"],["として"],["あなた"],["たち"],["と"],["共","とも"],["に"],["出て","でて"],["行かなかった","いかなかった"],["同胞","どうほう"],["に対して","にたいして"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"]]},{"verse":17,"text":"万軍の主はこう言われる。わたしは彼らに剣、飢饉、疫病を送り、腐って食べられない、いちじくのようにする。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["疫病","やくびょう"],["を"],["送り","おくり"],["、"],["腐って","くさって"],["食べられない","たべられない"],["、"],["いちじく"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":18,"text":"わたしは、剣、飢饉、疫病をもって、彼らを追い、全世界の国々の嫌悪の的とし、わたしが追いやる国々で、呪い、驚愕、物笑い、恥さらしとする。","tok":[["わたし"],["は"],["、"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["疫病","やくびょう"],["を"],["もって"],["、"],["彼","かれ"],["ら"],["を"],["追い","おい"],["、"],["全","ぜん"],["世界","せかい"],["の"],["国々","くにぐに"],["の"],["嫌悪","けんお"],["の"],["的","まと"],["と"],["し"],["、"],["わたし"],["が"],["追いやる","おいやる"],["国々","くにぐに"],["で"],["、"],["呪い","のろい"],["、"],["驚愕","きょうがく"],["、"],["物笑い","ものわらい"],["、"],["恥さらし","はじさらし"],["と"],["する"],["。"]]},{"verse":19,"text":"彼らがわたしの言葉に聞き従わなかったからである、と主は言われる。わたしは、わたしの僕である預言者たちを通して、この言葉を繰り返し伝えたが、彼らは少しも聞こうとしなかった、と主は言われる。","tok":[["彼","かれ"],["ら"],["が"],["わたし"],["の"],["言葉","ことば"],["に"],["聞き従わなかった","ききしたがわなかった"],["から"],["で"],["ある"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["わたし"],["の"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["、"],["この"],["言葉","ことば"],["を"],["繰り返し","くりかえし"],["伝えた","つたえた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["少し","すこし"],["も"],["聞こう","きこう"],["と"],["しなかった"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":20,"text":"しかし、あなたたちは主の言葉を聞きなさい。わたしがエルサレムからバビロンへ送ったすべての捕囚の民よ。","tok":[["しかし"],["、"],["あなた"],["たち"],["は"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞き","きき"],["なさい"],["。"],["わたし"],["が"],["エルサレム"],["から"],["バビロン"],["へ"],["送った","おくった"],["すべて"],["の"],["捕囚","ほしゅう"],["の"],["民","たみ"],["よ"],["。"]]},{"verse":21,"text":"イスラエルの神、万軍の主はこう言われる。それは、わたしの名を使って、あなたたちに偽りの預言をしているコラヤの子アハブとマアセヤの子ゼデキヤに対してである。今、わたしは彼らをバビロンの王ネブカドレツァルの手に渡す。王は彼らをあなたたちの目の前で殺す。","tok":[["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["それ"],["は"],["、"],["わたし"],["の"],["名","な"],["を"],["使って","つかって"],["、"],["あなた"],["たち"],["に"],["偽り","いつわり"],["の"],["預言","よげん"],["を"],["して"],["いる"],["コラヤ"],["の"],["子","こ"],["アハブ"],["と"],["マアセヤ"],["の"],["子","こ"],["ゼデキヤ"],["に対して","にたいして"],["で"],["ある"],["。"],["今","いま"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["バビロン"],["の"],["王","おう"],["ネブカドレツァル"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["王","おう"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["殺す","ころす"],["。"]]},{"verse":22,"text":"この二人のことは、呪いの言葉として使われ、バビロンにいるユダの捕囚民は皆、『主が、お前をバビロンの王に火あぶりにされたゼデキヤとアハブのようにしてくださるように』と言うようになるだろう。","tok":[["この"],["二人","ふたり"],["の"],["こと"],["は"],["、"],["呪い","のろい"],["の"],["言葉","ことば"],["として"],["使われ","つかわれ"],["、"],["バビロン"],["に"],["いる"],["ユダ"],["の"],["捕囚民","ほしゅうみん"],["は"],["皆","みな"],["、"],["『"],["主","ぬし"],["が"],["、"],["お前","おまえ"],["を"],["バビロン"],["の"],["王","おう"],["に"],["火あぶり","ひあぶり"],["に"],["された"],["ゼデキヤ"],["と"],["アハブ"],["の"],["よう"],["に"],["して"],["くださる"],["よう"],["に"],["』"],["と"],["言う","いう"],["よう"],["に"],["なるだろう"],["。"]]},{"verse":23,"text":"これは彼らがイスラエルにおいて愚かな行いをし、隣人の妻と姦通し、また命じもしないのに、わたしの名を使って偽りを語ったからである。わたしはこのことを知っており、証言をする、と主は言われる。」","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["イスラエル"],["に"],["おいて"],["愚か","おろか"],["な"],["行い","おこない"],["を"],["し"],["、"],["隣人","りんじん"],["の"],["妻","つま"],["と"],["姦通","かんつう"],["し"],["、"],["また"],["命じ","めいじ"],["も"],["しない"],["のに"],["、"],["わたし"],["の"],["名","な"],["を"],["使って","つかって"],["偽り","いつわり"],["を"],["語った","かたった"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["この"],["こと"],["を"],["知って","しって"],["おり"],["、"],["証言","しょうげん"],["を"],["する"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["」"]]},{"verse":24,"text":"あなたはネヘラミ人シェマヤに対して告げよ。","tok":[["あなた"],["は"],["ネヘラミ"],["人","にん"],["シェマヤ"],["に対して","にたいして"],["告げ","つげ"],["よ"],["。"]]},{"verse":25,"text":"「イスラエルの神、万軍の主はこう言われる。それは、お前が自分の名で、次の手紙をエルサレムのすべての民と、祭司であるマアセヤの子ツェファンヤと、すべての祭司に送ったことに関してである。","tok":[["「"],["イスラエル"],["の"],["神","かみ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["それ"],["は"],["、"],["お前","おまえ"],["が"],["自分","じぶん"],["の"],["名","な"],["で"],["、"],["次","つぎ"],["の"],["手紙","てがみ"],["を"],["エルサレム"],["の"],["すべて"],["の"],["民","たみ"],["と"],["、"],["祭司","さいし"],["で"],["ある"],["マアセヤ"],["の"],["子","こ"],["ツェファンヤ"],["と"],["、"],["すべて"],["の"],["祭司","さいし"],["に"],["送った","おくった"],["こと"],["に関して","にかんして"],["で"],["ある"],["。"]]},{"verse":26,"text":"すなわち、『主は祭司ヨヤダに代えて、あなたを祭司とし、主の神殿の監督とし、狂い、預言する者すべてに手枷、足枷をはめ、取り締まらせた。","tok":[["すなわち"],["、"],["『"],["主","ぬし"],["は"],["祭司","さいし"],["ヨヤダ"],["に"],["代えて","かえて"],["、"],["あなた"],["を"],["祭司","さいし"],["と"],["し"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["監督","かんとく"],["と"],["し"],["、"],["狂い","くるい"],["、"],["預言","よげん"],["する"],["者","もの"],["すべて"],["に"],["手枷","てかせ"],["、"],["足枷","あしかせ"],["を"],["はめ"],["、"],["取り締まらせた","とりしまらせた"],["。"]]},{"verse":27,"text":"それなのに、あなたたちに預言しているアナトトの人エレミヤをなぜ取り締まらないのか。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["たち"],["に"],["預言","よげん"],["して"],["いる"],["アナトト"],["の"],["人","ひと"],["エレミヤ"],["を"],["なぜ"],["取り締まらない","とりしまらない"],["の"],["か"],["。"]]},{"verse":28,"text":"エレミヤは、バビロンにいる我々のところにまで手紙を送って、捕囚は長引くので、家を建てて住めとか、園に果樹を植え、その実を食べよ、などと言ってきた。』」","tok":[["エレミヤ"],["は"],["、"],["バビロン"],["に"],["いる"],["我々","われわれ"],["の"],["ところ"],["に"],["まで"],["手紙","てがみ"],["を"],["送って","おくって"],["、"],["捕囚","ほしゅう"],["は"],["長引く","ながびく"],["ので"],["、"],["家","いえ"],["を"],["建てて","たてて"],["住め","すめ"],["と"],["か"],["、"],["園","その"],["に"],["果樹","かじゅ"],["を"],["植え","うえ"],["、"],["その"],["実","じつ"],["を"],["食べよ","たべよ"],["、"],["など"],["と"],["言って","いって"],["きた"],["。"],["』"],["」"]]},{"verse":29,"text":"祭司ツェファンヤは預言者エレミヤに、この手紙を読んで聞かせた。","tok":[["祭司","さいし"],["ツェファンヤ"],["は"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["、"],["この"],["手紙","てがみ"],["を"],["読んで","よんで"],["聞かせた","きかせた"],["。"]]},{"verse":30,"text":"そのとき、主の言葉がエレミヤに臨んだ。","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["エレミヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":31,"text":"「すべての捕囚民に書き送れ。ネヘラミ人シェマヤに対して主はこう言われる。シェマヤは、あなたたちに預言したが、わたしは彼を遣わしてはいない。彼は偽ってあなたたちを安心させようとしている。","tok":[["「"],["すべて"],["の"],["捕囚民","ほしゅうみん"],["に"],["書き送れ","かきおくれ"],["。"],["ネヘラミ"],["人","にん"],["シェマヤ"],["に対して","にたいして"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["シェマヤ"],["は"],["、"],["あなた"],["たち"],["に"],["預言","よげん"],["した"],["が"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["遣わして","つかわして"],["は"],["いない"],["。"],["彼","かれ"],["は"],["偽って","いつわって"],["あなた"],["たち"],["を"],["安心","あんしん"],["させよう"],["として"],["いる"],["。"]]},{"verse":32,"text":"それゆえ、主はこう言われる。見よ、わたしはネヘラミ人シェマヤとその子孫を罰する。彼には、この民の中に住む子孫は一人もいなくなる。また、わたしがわが民に行う恵みの業にあずかる者は一人もない、と主は言われる。彼が主に逆らって語ったからである。」","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["ネヘラミ"],["人","にん"],["シェマヤ"],["と"],["その"],["子孫","しそん"],["を"],["罰する","ばっする"],["。"],["彼","かれ"],["に"],["は"],["、"],["この"],["民","たみ"],["の"],["中","なか"],["に"],["住む","すむ"],["子孫","しそん"],["は"],["一人","ひとり"],["も"],["いなく"],["なる"],["。"],["また"],["、"],["わたし"],["が"],["わが"],["民","たみ"],["に"],["行う","おこなう"],["恵み","めぐみ"],["の"],["業","ごう"],["に"],["あずかる"],["者","もの"],["は"],["一人","ひとり"],["も"],["ない"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["彼","かれ"],["が"],["主に","おもに"],["逆らって","さからって"],["語った","かたった"],["から"],["で"],["ある"],["。"],["」"]]}]
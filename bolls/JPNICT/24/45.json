[{"verse":1,"text":"ユダの王ヨシヤの子ヨヤキムの第四年に、ネリヤの子バルクは、預言者エレミヤの口述に従ってこれらの言葉を巻物に書き記した。そのとき、エレミヤは次のように語った。","tok":[["ユダ"],["の"],["王","おう"],["ヨシヤ"],["の"],["子","こ"],["ヨヤキム"],["の"],["第","だい"],["四","よん"],["年","ねん"],["に"],["、"],["ネリヤ"],["の"],["子","こ"],["バルク"],["は"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["の"],["口述","こうじゅつ"],["に"],["従って","したがって"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["巻物","まきもの"],["に"],["書き記した","かきしるした"],["。"],["その"],["とき"],["、"],["エレミヤ"],["は"],["次","つぎ"],["の"],["よう"],["に"],["語った","かたった"],["。"]]},{"verse":2,"text":"「バルクよ、イスラエルの神、主は、あなたについてこう言われる。","tok":[["「"],["バルク"],["よ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["について"],["こう"],["言われる","いわれる"],["。"]]},{"verse":3,"text":"あなたは、かつてこう言った。『ああ、災いだ。主は、わたしの苦しみに悲しみを加えられた。わたしは疲れ果てて呻き、安らぎを得ない。』","tok":[["あなた"],["は"],["、"],["かつて"],["こう"],["言った","いった"],["。"],["『"],["ああ"],["、"],["災い","わざわい"],["だ"],["。"],["主","ぬし"],["は"],["、"],["わたし"],["の"],["苦しみ","くるしみ"],["に"],["悲しみ","かなしみ"],["を"],["加えられた","くわえられた"],["。"],["わたし"],["は"],["疲れ","つかれ"],["果てて","はてて"],["呻き","うめき"],["、"],["安らぎ","やすらぎ"],["を"],["得ない","えない"],["。"],["』"]]},{"verse":4,"text":"バルクにこう言いなさい。主はこう言われる。わたしは建てたものを破壊し、植えたものを抜く。全世界をこのようにする。","tok":[["バルク"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["建てた","たてた"],["もの"],["を"],["破壊","はかい"],["し"],["、"],["植えた","うえた"],["もの"],["を"],["抜く","ぬく"],["。"],["全","ぜん"],["世界","せかい"],["を"],["この"],["よう"],["に"],["する"],["。"]]},{"verse":5,"text":"あなたは自分に何か大きなことを期待しているのか。そのような期待を抱いてはならない。なぜなら、わたしは生けるものすべてに災いをくだそうとしているからだ、と主は言われる。ただ、あなたの命だけは、どこへ行っても守り、あなたに与える。」","tok":[["あなた"],["は"],["自分","じぶん"],["に"],["何","なん"],["か"],["大きな","おおきな"],["こと"],["を"],["期待","きたい"],["して"],["いる"],["の"],["か"],["。"],["その"],["よう"],["な"],["期待","きたい"],["を"],["抱いて","いだいて"],["は"],["ならない"],["。"],["なぜ"],["なら"],["、"],["わたし"],["は"],["生ける","いける"],["もの"],["すべて"],["に"],["災い","わざわい"],["を"],["くだそう"],["として"],["いる"],["から"],["だ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["ただ"],["、"],["あなた"],["の"],["命","いのち"],["だけ"],["は"],["、"],["どこ"],["へ"],["行って","いって"],["も"],["守り","まもり"],["、"],["あなた"],["に"],["与える","あたえる"],["。"],["」"]]}]
[{"verse":1,"text":"ところが七月に、王族の一人で、王の高官でもあった、エリシャマの孫でネタンヤの子であるイシュマエルが、十人の部下を率いてミツパに赴き、アヒカムの子ゲダルヤを訪ね、ミツパで食事を共にした。","tok":[["ところ"],["が"],["七","なな"],["月","がつ"],["に"],["、"],["王族","おうぞく"],["の"],["一人","ひとり"],["で"],["、"],["王","おう"],["の"],["高官","こうかん"],["で"],["も"],["あった"],["、"],["エリシャマ"],["の"],["孫","まご"],["で"],["ネタンヤ"],["の"],["子","こ"],["で"],["ある"],["イシュマエル"],["が"],["、"],["十人","じゅうにん"],["の"],["部下","ぶか"],["を"],["率いて","ひきいて"],["ミツパ"],["に"],["赴き","おもむき"],["、"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["を"],["訪ね","たずね"],["、"],["ミツパ"],["で"],["食事","しょくじ"],["を"],["共","とも"],["に"],["した"],["。"]]},{"verse":2,"text":"そのとき、ネタンヤの子イシュマエルと、彼と共にいた十人の部下は、突然襲いかかって、バビロンの王がその地に立てて総督としたシャファンの孫でアヒカムの子であるゲダルヤを剣にかけて殺した。","tok":[["その"],["とき"],["、"],["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["と"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["十人","じゅうにん"],["の"],["部下","ぶか"],["は"],["、"],["突然","とつぜん"],["襲いかかって","おそいかかって"],["、"],["バビロン"],["の"],["王","おう"],["が"],["その"],["地","ち"],["に"],["立てて","たてて"],["総督","そうとく"],["と"],["した"],["シャファン"],["の"],["孫","まご"],["で"],["アヒカム"],["の"],["子","こ"],["で"],["ある"],["ゲダルヤ"],["を"],["剣","けん"],["に"],["かけて"],["殺した","ころした"],["。"]]},{"verse":3,"text":"またイシュマエルは、ゲダルヤと共にミツパにいたユダのすべての人々と、そこに占領軍として駐留していたカルデア人を打ち殺した。","tok":[["また"],["イシュマエル"],["は"],["、"],["ゲダルヤ"],["と"],["共","とも"],["に"],["ミツパ"],["に"],["いた"],["ユダ"],["の"],["すべて"],["の"],["人々","ひとびと"],["と"],["、"],["そこ"],["に"],["占領軍","せんりょうぐん"],["として"],["駐留","ちゅうりゅう"],["して"],["いた"],["カルデア"],["人","にん"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":4,"text":"ゲダルヤ暗殺の翌日、まだだれにも知られないうちに、","tok":[["ゲダルヤ"],["暗殺","あんさつ"],["の"],["翌日","よくじつ"],["、"],["まだ"],["だれ"],["に"],["も"],["知られない","しられない"],["うち"],["に"],["、"]]},{"verse":5,"text":"シケム、シロ、サマリアから来た八十人の一行が、ひげをそり、衣服を裂き、身を傷つけた姿で通りかかった。彼らは、主の神殿にささげる供え物と香を携えていた。","tok":[["シケム"],["、"],["シロ"],["、"],["サマリア"],["から"],["来た","きた"],["八","はち"],["十人","じゅうにん"],["の"],["一行","いっこう"],["が"],["、"],["ひげ"],["を"],["そり"],["、"],["衣服","いふく"],["を"],["裂き","さき"],["、"],["身","み"],["を"],["傷つけた","きずつけた"],["姿","すがた"],["で"],["通りかかった","とおりかかった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["ささげる"],["供え物","そなえもの"],["と"],["香","こう"],["を"],["携えて","たずさえて"],["いた"],["。"]]},{"verse":6,"text":"ネタンヤの子イシュマエルがミツパから出て彼らを迎えた。彼は泣きながら歩いて行き、彼らに会うと、「アヒカムの子ゲダルヤのもとへおいでください」と言った。","tok":[["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["が"],["ミツパ"],["から"],["出て","でて"],["彼","かれ"],["ら"],["を"],["迎えた","むかえた"],["。"],["彼","かれ"],["は"],["泣き","なき"],["ながら"],["歩いて","あるいて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["に"],["会う","あう"],["と"],["、"],["「"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["の"],["もと"],["へ"],["おいで"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"一行が町の中に入ると、ネタンヤの子イシュマエルは、家来たちと共に彼らを殺し、穴の中にほうり込んだ。","tok":[["一行","いっこう"],["が"],["町","まち"],["の"],["中","なか"],["に"],["入る","はいる"],["と"],["、"],["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["、"],["家来","けらい"],["たち"],["と"],["共","とも"],["に"],["彼","かれ"],["ら"],["を"],["殺し","ころし"],["、"],["穴","あな"],["の"],["中","なか"],["に"],["ほうり込んだ","ほうりこんだ"],["。"]]},{"verse":8,"text":"しかし、一行の中にいた十人の者は、「我々を殺さないでください。小麦、大麦、油、蜜など貴重なものを畑に隠していますから」とイシュマエルに哀願したので、この十人だけは殺さずにおいた。","tok":[["しかし"],["、"],["一行","いっこう"],["の"],["中","なか"],["に"],["いた"],["十人","じゅうにん"],["の"],["者","もの"],["は"],["、"],["「"],["我々","われわれ"],["を"],["殺さないで","ころさないで"],["ください"],["。"],["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["油","あぶら"],["、"],["蜜","みつ"],["など"],["貴重","きちょう"],["な"],["もの"],["を"],["畑","はたけ"],["に"],["隠して","かくして"],["います"],["から"],["」"],["と"],["イシュマエル"],["に"],["哀願","あいがん"],["した"],["ので"],["、"],["この"],["十人","じゅうにん"],["だけ"],["は"],["殺さず","ころさず"],["に"],["おいた"],["。"]]},{"verse":9,"text":"イシュマエルが、ゲダルヤの名を使って殺したすべての人々の死骸を投げ込んだ穴は、アサ王がイスラエルの王バシャの攻撃に備えて掘ったものであった。それをネタンヤの子イシュマエルは死体で満たした。","tok":[["イシュマエル"],["が"],["、"],["ゲダルヤ"],["の"],["名","な"],["を"],["使って","つかって"],["殺した","ころした"],["すべて"],["の"],["人々","ひとびと"],["の"],["死骸","しがい"],["を"],["投げ込んだ","なげこんだ"],["穴","あな"],["は"],["、"],["アサ"],["王","おう"],["が"],["イスラエル"],["の"],["王","おう"],["バシャ"],["の"],["攻撃","こうげき"],["に"],["備えて","そなえて"],["掘った","ほった"],["もの"],["で"],["あった"],["。"],["それ"],["を"],["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["死体","したい"],["で"],["満たした","みたした"],["。"]]},{"verse":10,"text":"イシュマエルは、王の娘たちをも含めて、ミツパにいた民の残留者すべて、すなわち、親衛隊の長ネブザルアダンがアヒカムの子ゲダルヤの監督のもとにおき、ミツパに残っていた民をすべて捕虜とした。ネタンヤの子イシュマエルは彼らを引き立てて、アンモン人のもとに逃れようと出発した。","tok":[["イシュマエル"],["は"],["、"],["王","おう"],["の"],["娘","むすめ"],["たち"],["を"],["も"],["含めて","ふくめて"],["、"],["ミツパ"],["に"],["いた"],["民","たみ"],["の"],["残留者","ざんりゅうしゃ"],["すべて"],["、"],["すなわち"],["、"],["親衛隊","しんえいたい"],["の"],["長","ちょう"],["ネブザルアダン"],["が"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["の"],["監督","かんとく"],["の"],["もと"],["に"],["おき"],["、"],["ミツパ"],["に"],["残って","のこって"],["いた"],["民","たみ"],["を"],["すべて"],["捕虜","ほりょ"],["と"],["した"],["。"],["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["彼","かれ"],["ら"],["を"],["引き立てて","ひきたてて"],["、"],["アンモン"],["人","にん"],["の"],["もと"],["に"],["逃れよう","のがれよう"],["と"],["出発","しゅっぱつ"],["した"],["。"]]},{"verse":11,"text":"カレアの子ヨハナンをはじめとする軍の長は皆、ネタンヤの子イシュマエルが行った悪事を聞き、","tok":[["カレア"],["の"],["子","こ"],["ヨハナン"],["を"],["はじめ"],["と"],["する"],["軍","ぐん"],["の"],["長","ちょう"],["は"],["皆","みな"],["、"],["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["が"],["行った","おこなった"],["悪事","あくじ"],["を"],["聞き","きき"],["、"]]},{"verse":12,"text":"直ちに、すべての兵を率いてネタンヤの子イシュマエルと戦うために出発し、ギブオンの大池のほとりで彼に追いついた。","tok":[["直ちに","ただちに"],["、"],["すべて"],["の"],["兵","へい"],["を"],["率いて","ひきいて"],["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["と"],["戦う","たたかう"],["ため"],["に"],["出発","しゅっぱつ"],["し"],["、"],["ギブオン"],["の"],["大池","おおいけ"],["の"],["ほとり"],["で"],["彼","かれ"],["に"],["追いついた","おいついた"],["。"]]},{"verse":13,"text":"イシュマエルに捕らえられていた人々は皆、カレアの子ヨハナンと軍の長たちの姿を見て歓喜した。","tok":[["イシュマエル"],["に"],["捕らえられて","とらえられて"],["いた"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["カレア"],["の"],["子","こ"],["ヨハナン"],["と"],["軍","ぐん"],["の"],["長","なが"],["たち"],["の"],["姿","すがた"],["を"],["見て","みて"],["歓喜","かんき"],["した"],["。"]]},{"verse":14,"text":"イシュマエルがミツパから捕虜として連行した人々は、一斉に身を翻してカレアの子ヨハナンのもとに帰って行った。","tok":[["イシュマエル"],["が"],["ミツパ"],["から"],["捕虜","ほりょ"],["として"],["連行","れんこう"],["した"],["人々","ひとびと"],["は"],["、"],["一斉","いっせい"],["に"],["身","み"],["を"],["翻して","ひるがえして"],["カレア"],["の"],["子","こ"],["ヨハナン"],["の"],["もと"],["に"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":15,"text":"ネタンヤの子イシュマエルは八人の家来と共に、ヨハナンの前から逃れて、アンモン人のもとに向かった。","tok":[["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["は"],["八人","はちにん"],["の"],["家来","けらい"],["と"],["共","とも"],["に"],["、"],["ヨハナン"],["の"],["前","まえ"],["から"],["逃れて","のがれて"],["、"],["アンモン"],["人","にん"],["の"],["もと"],["に"],["向かった","むかった"],["。"]]},{"verse":16,"text":"アヒカムの子ゲダルヤの暗殺の後、カレアの子ヨハナンと、彼と共にいたすべての軍の長たちは、ネタンヤの子イシュマエルのもとから救い出した民の残りの者をすべて、すなわち、ギブオンから連れ戻した指揮者、兵士、女、子供、宦官らをミツパから連れて、","tok":[["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["の"],["暗殺","あんさつ"],["の"],["後","あと"],["、"],["カレア"],["の"],["子","こ"],["ヨハナン"],["と"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["すべて"],["の"],["軍","ぐん"],["の"],["長","なが"],["たち"],["は"],["、"],["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["の"],["もと"],["から"],["救い出した","すくいだした"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["すべて"],["、"],["すなわち"],["、"],["ギブオン"],["から"],["連れ戻した","つれもどした"],["指揮者","しきしゃ"],["、"],["兵士","へいし"],["、"],["女","おんな"],["、"],["子供","こども"],["、"],["宦官","かんがん"],["ら"],["を"],["ミツパ"],["から"],["連れて","つれて"],["、"]]},{"verse":17,"text":"出発し、ベツレヘムに近いキムハムの宿場にとどまった。彼らはエジプトへ向かおうとしていた。","tok":[["出発","しゅっぱつ"],["し"],["、"],["ベツレヘム"],["に"],["近い","ちかい"],["キムハム"],["の"],["宿場","しゅくば"],["に"],["とどまった"],["。"],["彼","かれ"],["ら"],["は"],["エジプト"],["へ"],["向かおう","むかおう"],["として"],["いた"],["。"]]},{"verse":18,"text":"バビロンの王がその地の監督をゆだねたアヒカムの子ゲダルヤを、ネタンヤの子イシュマエルが殺したために、彼らはカルデア人の報復を恐れたのである。","tok":[["バビロン"],["の"],["王","おう"],["が"],["その"],["地","ち"],["の"],["監督","かんとく"],["を"],["ゆだねた"],["アヒカム"],["の"],["子","こ"],["ゲダルヤ"],["を"],["、"],["ネタンヤ"],["の"],["子","こ"],["イシュマエル"],["が"],["殺した","ころした"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["は"],["カルデア"],["人","にん"],["の"],["報復","ほうふく"],["を"],["恐れた","おそれた"],["ので"],["ある"],["。"]]}]
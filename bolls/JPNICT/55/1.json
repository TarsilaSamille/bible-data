[{"verse":1,"text":"キリスト‧イエスによって与えられる命の約束を宣べ伝えるために、神の御心によってキリスト‧イエスの使徒とされたパウロから、","tok":[["キリスト"],["‧"],["イエス"],["によって"],["与えられる","あたえられる"],["命","いのち"],["の"],["約束","やくそく"],["を"],["宣べ伝える","のべつたえる"],["ため"],["に"],["、"],["神","かみ"],["の"],["御心","おこころ"],["によって"],["キリスト"],["‧"],["イエス"],["の"],["使徒","しと"],["と"],["された"],["パウロ"],["から"],["、"]]},{"verse":2,"text":"愛する子テモテへ。父である神とわたしたちの主キリスト‧イエスからの恵み、憐れみ、そして平和があるように。","tok":[["愛する","あいする"],["子","こ"],["テモテ"],["へ"],["。"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["わたしたち"],["の"],["主","ぬし"],["キリスト"],["‧"],["イエス"],["から"],["の"],["恵み","めぐみ"],["、"],["憐れみ","あわれみ"],["、"],["そして"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしは、昼も夜も祈りの中で絶えずあなたを思い起こし、先祖に倣い清い良心をもって仕えている神に、感謝しています。","tok":[["わたし"],["は"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["祈り","いのり"],["の"],["中","なか"],["で"],["絶えず","たえず"],["あなた"],["を"],["思い起こし","おもいおこし"],["、"],["先祖","せんぞ"],["に"],["倣い","ならい"],["清い","きよい"],["良心","りょうしん"],["を"],["もって"],["仕えて","つかえて"],["いる"],["神","かみ"],["に"],["、"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":4,"text":"わたしは、あなたの涙を忘れることができず、ぜひあなたに会って、喜びで満たされたいと願っています。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["涙","なみだ"],["を"],["忘れる","わすれる"],["こと"],["が"],["できず"],["、"],["ぜひ"],["あなた"],["に"],["会って","あって"],["、"],["喜び","よろこび"],["で"],["満たされたい","みたされたい"],["と"],["願って","ねがって"],["います"],["。"]]},{"verse":5,"text":"そして、あなたが抱いている純真な信仰を思い起こしています。その信仰は、まずあなたの祖母ロイスと母エウニケに宿りましたが、それがあなたにも宿っていると、わたしは確信しています。","tok":[["そして"],["、"],["あなた"],["が"],["抱いて","いだいて"],["いる"],["純真","じゅんしん"],["な"],["信仰","しんこう"],["を"],["思い起こして","おもいおこして"],["います"],["。"],["その"],["信仰","しんこう"],["は"],["、"],["まず"],["あなた"],["の"],["祖母","そぼ"],["ロイス"],["と"],["母","はは"],["エウニケ"],["に"],["宿りました","やどりました"],["が"],["、"],["それ"],["が"],["あなた"],["に"],["も"],["宿って","やどって"],["いる"],["と"],["、"],["わたし"],["は"],["確信","かくしん"],["して"],["います"],["。"]]},{"verse":6,"text":"そういうわけで、わたしが手を置いたことによってあなたに与えられている神の賜物を、再び燃えたたせるように勧めます。","tok":[["そう"],["いう"],["わけ"],["で"],["、"],["わたし"],["が"],["手","て"],["を"],["置いた","おいた"],["こと"],["によって"],["あなた"],["に"],["与えられて","あたえられて"],["いる"],["神","かみ"],["の"],["賜物","たまもの"],["を"],["、"],["再び","ふたたび"],["燃えたたせる","もえたたせる"],["よう"],["に"],["勧めます","すすめます"],["。"]]},{"verse":7,"text":"神は、おくびょうの霊ではなく、力と愛と思慮分別の霊をわたしたちにくださったのです。","tok":[["神","かみ"],["は"],["、"],["おくびょう"],["の"],["霊","れい"],["で"],["は"],["なく"],["、"],["力","ちから"],["と"],["愛","あい"],["と"],["思慮","しりょ"],["分別","ぶんべつ"],["の"],["霊","れい"],["を"],["わたしたち"],["に"],["くださった"],["の"],["です"],["。"]]},{"verse":8,"text":"だから、わたしたちの主を証しすることも、わたしが主の囚人であることも恥じてはなりません。むしろ、神の力に支えられて、福音のためにわたしと共に苦しみを忍んでください。","tok":[["だ"],["から"],["、"],["わたしたち"],["の"],["主","ぬし"],["を"],["証し","あかし"],["する"],["こと"],["も"],["、"],["わたし"],["が"],["主","ぬし"],["の"],["囚人","しゅうじん"],["で"],["ある"],["こと"],["も"],["恥じ","はじ"],["ては"],["なりません"],["。"],["むしろ"],["、"],["神","かみ"],["の"],["力","ちから"],["に"],["支えられて","ささえられて"],["、"],["福音","ふくいん"],["の"],["ため"],["に"],["わたし"],["と"],["共","とも"],["に"],["苦しみ","くるしみ"],["を"],["忍んで","しのんで"],["ください"],["。"]]},{"verse":9,"text":"神がわたしたちを救い、聖なる招きによって呼び出してくださったのは、わたしたちの行いによるのではなく、御自身の計画と恵みによるのです。この恵みは、永遠の昔にキリスト‧イエスにおいてわたしたちのために与えられ、","tok":[["神","かみ"],["が"],["わたしたち"],["を"],["救い","すくい"],["、"],["聖","せい"],["なる"],["招き","まねき"],["によって"],["呼び出して","よびだして"],["くださった"],["の"],["は"],["、"],["わたしたち"],["の"],["行い","おこない"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["御自身","ごじしん"],["の"],["計画","けいかく"],["と"],["恵み","めぐみ"],["に"],["よる"],["の"],["です"],["。"],["この"],["恵み","めぐみ"],["は"],["、"],["永遠","えいえん"],["の"],["昔","むかし"],["に"],["キリスト"],["‧"],["イエス"],["に"],["おいて"],["わたしたち"],["の"],["ため"],["に"],["与えられ","あたえられ"],["、"]]},{"verse":10,"text":"今や、わたしたちの救い主キリスト‧イエスの出現によって明らかにされたものです。キリストは死を滅ぼし、福音を通して不滅の命を現してくださいました。","tok":[["今","いま"],["や"],["、"],["わたしたち"],["の"],["救い主","すくいぬし"],["キリスト"],["‧"],["イエス"],["の"],["出現","しゅつげん"],["によって"],["明らか","あきらか"],["に"],["された"],["もの"],["です"],["。"],["キリスト"],["は"],["死","し"],["を"],["滅ぼし","ほろぼし"],["、"],["福音","ふくいん"],["を"],["通して","とおして"],["不滅","ふめつ"],["の"],["命","いのち"],["を"],["現して","あらわして"],["くださいました"],["。"]]},{"verse":11,"text":"この福音のために、わたしは宣教者、使徒、教師に任命されました。","tok":[["この"],["福音","ふくいん"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["宣教者","せんきょうしゃ"],["、"],["使徒","しと"],["、"],["教師","きょうし"],["に"],["任命","にんめい"],["されました"],["。"]]},{"verse":12,"text":"そのために、わたしはこのように苦しみを受けているのですが、それを恥じていません。というのは、わたしは自分が信頼している方を知っており、わたしにゆだねられているものを、その方がかの日まで守ることがおできになると確信しているからです。","tok":[["その"],["ため"],["に"],["、"],["わたし"],["は"],["この"],["よう"],["に"],["苦しみ","くるしみ"],["を"],["受けて","うけて"],["いる"],["の"],["です"],["が"],["、"],["それ"],["を"],["恥じて","はじて"],["いません"],["。"],["と"],["いう"],["の"],["は"],["、"],["わたし"],["は"],["自分","じぶん"],["が"],["信頼","しんらい"],["して"],["いる"],["方","かた"],["を"],["知って","しって"],["おり"],["、"],["わたし"],["に"],["ゆだねられて"],["いる"],["もの"],["を"],["、"],["その"],["方","ほう"],["が"],["かの"],["日","ひ"],["まで"],["守る","まもる"],["こと"],["が"],["おでき"],["に"],["なる"],["と"],["確信","かくしん"],["して"],["いる"],["から"],["です"],["。"]]},{"verse":13,"text":"キリスト‧イエスによって与えられる信仰と愛をもって、わたしから聞いた健全な言葉を手本としなさい。","tok":[["キリスト"],["‧"],["イエス"],["によって"],["与えられる","あたえられる"],["信仰","しんこう"],["と"],["愛","あい"],["を"],["もって"],["、"],["わたし"],["から"],["聞いた","きいた"],["健全","けんぜん"],["な"],["言葉","ことば"],["を"],["手本","てほん"],["と"],["し"],["なさい"],["。"]]},{"verse":14,"text":"あなたにゆだねられている良いものを、わたしたちの内に住まわれる聖霊によって守りなさい。","tok":[["あなた"],["に"],["ゆだねられて"],["いる"],["良い","よい"],["もの"],["を"],["、"],["わたしたち"],["の"],["内","うち"],["に"],["住まわれる","すまわれる"],["聖霊","せいれい"],["によって"],["守り","まもり"],["なさい"],["。"]]},{"verse":15,"text":"あなたも知っているように、アジア州の人々は皆、わたしから離れ去りました。その中にはフィゲロとヘルモゲネスがいます。","tok":[["あなた"],["も"],["知って","しって"],["いる"],["よう"],["に"],["、"],["アジア州","あじあしゅう"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["わたし"],["から"],["離れ去りました","はなれさりました"],["。"],["その"],["中","なか"],["に"],["は"],["フィゲロ"],["と"],["ヘルモゲネス"],["が"],["います"],["。"]]},{"verse":16,"text":"どうか、主がオネシフォロの家族を憐れんでくださいますように。彼は、わたしをしばしば励まし、わたしが囚人の身であることを恥とも思わず、","tok":[["どう"],["か"],["、"],["主","ぬし"],["が"],["オネシフォロ"],["の"],["家族","かぞく"],["を"],["憐れんで","あわれんで"],["くださいます"],["よう"],["に"],["。"],["彼","かれ"],["は"],["、"],["わたし"],["を"],["しばしば"],["励まし","はげまし"],["、"],["わたし"],["が"],["囚人","しゅうじん"],["の"],["身","み"],["で"],["ある"],["こと"],["を"],["恥","はじ"],["と"],["も"],["思わず","おもわず"],["、"]]},{"verse":17,"text":"ローマに着くとわたしを熱心に探し、見つけ出してくれたのです。","tok":[["ローマ"],["に"],["着く","つく"],["と"],["わたし"],["を"],["熱心","ねっしん"],["に"],["探し","さがし"],["、"],["見つけ","みつけ"],["出して","だして"],["くれた"],["の"],["です"],["。"]]},{"verse":18,"text":"どうか、主がかの日に、主のもとで彼に憐れみを授けてくださいますように。彼がエフェソでどれほどわたしに仕えてくれたか、あなたがだれよりもよく知っています。","tok":[["どう"],["か"],["、"],["主","ぬし"],["が"],["かの"],["日","ひ"],["に"],["、"],["主","ぬし"],["の"],["もと"],["で"],["彼","かれ"],["に"],["憐れみ","あわれみ"],["を"],["授けて","さずけて"],["くださいます"],["よう"],["に"],["。"],["彼","かれ"],["が"],["エフェソ"],["で"],["どれ"],["ほど"],["わたし"],["に"],["仕えて","つかえて"],["くれた"],["か"],["、"],["あなた"],["が"],["だれ"],["より"],["も"],["よく"],["知って","しって"],["います"],["。"]]}]
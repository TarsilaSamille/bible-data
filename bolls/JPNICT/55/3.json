[{"verse":1,"text":"しかし、終わりの時には困難な時期が来ることを悟りなさい。","tok":[["しかし"],["、"],["終わり","おわり"],["の"],["時","とき"],["に"],["は"],["困難","こんなん"],["な"],["時期","じき"],["が"],["来る","くる"],["こと"],["を"],["悟り","さとり"],["なさい"],["。"]]},{"verse":2,"text":"そのとき、人々は自分自身を愛し、金銭を愛し、ほらを吹き、高慢になり、神をあざけり、両親に従わず、恩を知らず、神を畏れなくなります。","tok":[["その"],["とき"],["、"],["人々","ひとびと"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["愛し","あいし"],["、"],["金銭","きんせん"],["を"],["愛し","あいし"],["、"],["ほら"],["を"],["吹き","ふき"],["、"],["高慢","こうまん"],["に"],["なり"],["、"],["神","かみ"],["を"],["あざけり"],["、"],["両親","りょうしん"],["に"],["従わず","したがわず"],["、"],["恩","おん"],["を"],["知らず","しらず"],["、"],["神","かみ"],["を"],["畏れなく","おそれなく"],["なります"],["。"]]},{"verse":3,"text":"また、情けを知らず、和解せず、中傷し、節度がなく、残忍になり、善を好まず、","tok":[["また"],["、"],["情け","なさけ"],["を"],["知らず","しらず"],["、"],["和解","わかい"],["せず"],["、"],["中傷","ちゅうしょう"],["し"],["、"],["節度","せつど"],["が"],["なく"],["、"],["残忍","ざんにん"],["に"],["なり"],["、"],["善","ぜん"],["を"],["好まず","このまず"],["、"]]},{"verse":4,"text":"人を裏切り、軽率になり、思い上がり、神よりも快楽を愛し、","tok":[["人","ひと"],["を"],["裏切り","うらぎり"],["、"],["軽率","けいそつ"],["に"],["なり"],["、"],["思い上がり","おもいあがり"],["、"],["神","かみ"],["より"],["も"],["快楽","かいらく"],["を"],["愛し","あいし"],["、"]]},{"verse":5,"text":"信心を装いながら、その実、信心の力を否定するようになります。こういう人々を避けなさい。","tok":[["信心","しんじん"],["を"],["装い","よそおい"],["ながら"],["、"],["その"],["実","じつ"],["、"],["信心","しんじん"],["の"],["力","ちから"],["を"],["否定","ひてい"],["する"],["よう"],["に"],["なります"],["。"],["こう"],["いう"],["人々","ひとびと"],["を"],["避け","さけ"],["なさい"],["。"]]},{"verse":6,"text":"彼らの中には、他人の家に入り込み、愚かな女どもをたぶらかしている者がいるのです。彼女たちは罪に満ち、さまざまの情欲に駆り立てられており、","tok":[["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["は"],["、"],["他人","たにん"],["の"],["家","いえ"],["に"],["入り込み","はいりこみ"],["、"],["愚か","おろか"],["な"],["女","おんな"],["ども"],["を"],["たぶらかして"],["いる"],["者","もの"],["が"],["いる"],["の"],["です"],["。"],["彼女","かのじょ"],["たち"],["は"],["罪","つみ"],["に"],["満ち","みち"],["、"],["さまざま"],["の"],["情欲","じょうよく"],["に"],["駆り立てられて","かりたてられて"],["おり"],["、"]]},{"verse":7,"text":"いつも学んでいながら、決して真理の認識に達することができません。","tok":[["いつも"],["学んで","まなんで"],["い"],["ながら"],["、"],["決して","けっ
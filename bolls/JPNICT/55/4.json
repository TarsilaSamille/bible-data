[{"verse":1,"text":"神の御前で、そして、生きている者と死んだ者を裁くために来られるキリスト‧イエスの御前で、その出現とその御国とを思いつつ、厳かに命じます。","tok":[["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["そして"],["、"],["生きて","いきて"],["いる"],["者","もの"],["と"],["死んだ","しんだ"],["者","もの"],["を"],["裁く","さばく"],["ため"],["に"],["来られる","こられる"],["キリスト"],["‧"],["イエス"],["の"],["御前","ごぜん"],["で"],["、"],["その"],["出現","しゅつげん"],["と"],["その"],["御国","みくに"],["と"],["を"],["思い","おもい"],["つつ"],["、"],["厳か","おごそか"],["に"],["命じます","めいじます"],["。"]]},{"verse":2,"text":"御言葉を宣べ伝えなさい。折が良くても悪くても励みなさい。とがめ、戒め、励ましなさい。忍耐強く、十分に教えるのです。","tok":[["御言葉","おことば"],["を"],["宣べ伝え","のべつたえ"],["なさい"],["。"],["折","おり"],["が"],["良くて","よくて"],["も"],["悪くて","わるくて"],["も"],["励み","はげみ"],["なさい"],["。"],["とがめ"],["、"],["戒め","いましめ"],["、"],["励まし","はげまし"],["なさい"],["。"],["忍耐","にんたい"],["強く","つよく"],["、"],["十分","じゅうぶん"],["に"],["教える","おしえる"],["の"],["です"],["。"]]},{"verse":3,"text":"だれも健全な教えを聞こうとしない時が来ます。そのとき、人々は自分に都合の良いことを聞こうと、好き勝手に教師たちを寄せ集め、","tok":[["だれ"],["も"],["健全","けんぜん"],["な"],["教え","おしえ"],["を"],["聞こう","きこう"],["と"],["しない"],["時","とき"],["が"],["来ます","きます"],["。"],["その"],["とき"],["、"],["人々","ひとびと"],["は"],["自分","じぶん"],["に"],["都合","つごう"],["の"],["良い","よい"],["こと"],["を"],["聞こう","きこう"],["と"],["、"],["好き勝手","すきかって"],["に"],["教師","きょうし"],["たち"],["を"],["寄せ集め","よせあつめ"],["、"]]},{"verse":4,"text":"真理から耳を背け、作り話の方にそれて行くようになります。","tok":[["真理","しんり"],["から"],["耳","みみ"],["を"],["背け","そむけ"],["、"],["作り話","つくりばなし"],["の"],["方","ほう"],["に"],["それ"],["て"],["行く","いく"],["よう"],["に"],["なります"],["。"]]},{"verse":5,"text":"しかしあなたは、どんな場合にも身を慎み、苦しみを耐え忍び、福音宣教者の仕事に励み、自分の務めを果たしなさい。","tok":[["しかし"],["あなた"],["は"],["、"],["どんな"],["場合","ばあい"],["に"],["も"],["身","み"],["を"],["慎み","つつしみ"],["、"],["苦しみ","くるしみ"],["を"],["耐え忍び","たえしのび"],["、"],["福音","ふくいん"],["宣教者","せんきょうしゃ"],["の"],["仕事","しごと"],["に"],["励み","はげみ"],["、"],["自分","じぶん"],["の"],["務め","つとめ"],["を"],["果たし","はたし"],["なさい"],["。"]]},{"verse":6,"text":"わたし自身は、既にいけにえとして献げられています。世を去る時が近づきました。","tok":[["わたし"],["自身","じしん"],["は"],["、"],["既に","すでに"],["いけにえ"],["として"],["献げられて","ささげられて"],["います"],["。"],["世","よ"],["を"],["去る","さる"],["時","とき"],["が"],["近づきました","ちかづきました"],["。"]]},{"verse":7,"text":"わたしは、戦いを立派に戦い抜き、決められた道を走りとおし、信仰を守り抜きました。","tok":[["わたし"],["は"],["、"],["戦い","たたかい"],["を"],["立派","りっぱ"],["に"],["戦い","たたかい"],["抜き","ぬき"],["、"],["決められた","きめられた"],["道","みち"],["を"],["走り","はしり"],["とおし"],["、"],["信仰","しんこう"],["を"],["守り","まもり"],["抜きました","ぬきました"],["。"]]},{"verse":8,"text":"今や、義の栄冠を受けるばかりです。正しい審判者である主が、かの日にそれをわたしに授けてくださるのです。しかし、わたしだけでなく、主が来られるのをひたすら待ち望む人には、だれにでも授けてくださいます。","tok":[["今","いま"],["や"],["、"],["義","ぎ"],["の"],["栄冠","えいかん"],["を"],["受ける","うける"],["ばかり"],["です"],["。"],["正しい","ただしい"],["審判者","しんぱんしゃ"],["で"],["ある"],["主","ぬし"],["が"],["、"],["かの"],["日","ひ"],["に"],["それ"],["を"],["わたし"],["に"],["授けて","さずけて"],["くださる"],["の"],["です"],["。"],["しかし"],["、"],["わたし"],["だけ"],["で"],["なく"],["、"],["主","ぬし"],["が"],["来られる","こられる"],["の"],["を"],["ひたすら"],["待ち望む","まちのぞむ"],["人","ひと"],["に"],["は"],["、"],["だれ"],["に"],["で"],["も"],["授けて","さずけて"],["くださいます"],["。"]]},{"verse":9,"text":"ぜひ、急いでわたしのところへ来てください。","tok":[["ぜひ"],["、"],["急いで","いそいで"],["わたし"],["の"],["ところ"],["へ"],["来て","きて"],["ください"],["。"]]},{"verse":10,"text":"デマスはこの世を愛し、わたしを見捨ててテサロニケに行ってしまい、クレスケンスはガラテヤに、テトスはダルマティアに行っているからです。","tok":[["デマス"],["は"],["この世","このよ"],["を"],["愛し","あいし"],["、"],["わたし"],["を"],["見捨てて","みすてて"],["テサロニケ"],["に"],["行って","いって"],["しまい"],["、"],["クレスケンス"],["は"],["ガラテヤ"],["に"],["、"],["テトス"],["は"],["ダルマ"],["ティア"],["に"],["行って","いって"],["いる"],["から"],["です"],["。"]]},{"verse":11,"text":"ルカだけがわたしのところにいます。マルコを連れて来てください。彼はわたしの務めをよく助けてくれるからです。","tok":[["ルカ"],["だけ"],["が"],["わたし"],["の"],["ところ"],["に"],["います"],["。"],["マルコ"],["を"],["連れて","つれて"],["来て","きて"],["ください"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["務め","つとめ"],["を"],["よく"],["助けて","たすけて"],["くれる"],["から"],["です"],["。"]]},{"verse":12,"text":"わたしはティキコをエフェソに遣わしました。","tok":[["わたし"],["は"],["ティキコ"],["を"],["エフェソ"],["に"],["遣わしました","つかわしました"],["。"]]},{"verse":13,"text":"あなたが来るときには、わたしがトロアスのカルポのところに置いてきた外套を持って来てください。また書物、特に羊皮紙のものを持って来てください。","tok":[["あなた"],["が"],["来る","くる"],["とき"],["に"],["は"],["、"],["わたし"],["が"],["トロアス"],["の"],["カルポ"],["の"],["ところ"],["に"],["置いて","おいて"],["きた"],["外套","がいとう"],["を"],["持って","もって"],["来て","きて"],["ください"],["。"],["また"],["書物","しょもつ"],["、"],["特に","とくに"],["羊皮紙","ようひし"],["の"],["もの"],["を"],["持って","もって"],["来て","きて"],["ください"],["。"]]},{"verse":14,"text":"銅細工人アレクサンドロがわたしをひどく苦しめました。主は、その仕業に応じて彼にお報いになります。","tok":[["銅","どう"],["細工人","さいくにん"],["アレク"],["サンドロ"],["が"],["わたし"],["を"],["ひどく"],["苦しめました","くるしめました"],["。"],["主","ぬし"],["は"],["、"],["その"],["仕業","しわざ"],["に"],["応じて","おうじて"],["彼","かれ"],["に"],["お報い","おむくい"],["に"],["なります"],["。"]]},{"verse":15,"text":"あなたも彼には用心しなさい。彼はわたしたちの語ることに激しく反対したからです。","tok":[["あなた"],["も"],["彼","かれ"],["に"],["は"],["用心","ようじん"],["し"],["なさい"],["。"],["彼","かれ"],["は"],["わたしたち"],["の"],["語る","かたる"],["こと"],["に"],["激しく","はげしく"],["反対","はんたい"],["した"],["から"],["です"],["。"]]},{"verse":16,"text":"わたしの最初の弁明のときには、だれも助けてくれず、皆わたしを見捨てました。彼らにその責めが負わされませんように。","tok":[["わたし"],["の"],["最初","さいしょ"],["の"],["弁明","べんめい"],["の"],["とき"],["に"],["は"],["、"],["だれ"],["も"],["助けて","たすけて"],["くれず"],["、"],["皆","みな"],["わたし"],["を"],["見捨てました","みすてました"],["。"],["彼","かれ"],["ら"],["に"],["その"],["責め","せめ"],["が"],["負わされません","おわされません"],["よう"],["に"],["。"]]},{"verse":17,"text":"しかし、わたしを通して福音があまねく宣べ伝えられ、すべての民族がそれを聞くようになるために、主はわたしのそばにいて、力づけてくださいました。そして、わたしは獅子の口から救われました。","tok":[["しかし"],["、"],["わたし"],["を"],["通して","とおして"],["福音","ふくいん"],["が"],["あまねく"],["宣べ伝えられ","のべつたえられ"],["、"],["すべて"],["の"],["民族","みんぞく"],["が"],["それ"],["を"],["聞く","きく"],["よう"],["に"],["なる"],["ため"],["に"],["、"],["主","ぬし"],["は"],["わたし"],["の"],["そば"],["に"],["いて"],["、"],["力づけて","ちからづけて"],["くださいました"],["。"],["そして"],["、"],["わたし"],["は"],["獅子","しし"],["の"],["口","くち"],["から"],["救われました","すくわれました"],["。"]]},{"verse":18,"text":"主はわたしをすべての悪い業から助け出し、天にある御自分の国へ救い入れてくださいます。主に栄光が世々限りなくありますように、アーメン。","tok":[["主","ぬし"],["は"],["わたし"],["を"],["すべて"],["の"],["悪い","わるい"],["業","ごう"],["から"],["助け出し","たすけだし"],["、"],["天","てん"],["に"],["ある"],["御自分","ごじぶん"],["の"],["国","くに"],["へ"],["救い","すくい"],["入れて","いれて"],["くださいます"],["。"],["主に","おもに"],["栄光","えいこう"],["が"],["世々","せいせい"],["限りなく","かぎりなく"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]},{"verse":19,"text":"プリスカとアキラに、そしてオネシフォロの家の人々によろしく伝えてください。","tok":[["プリスカ"],["と"],["アキラ"],["に"],["、"],["そして"],["オネシフォロ"],["の"],["家","いえ"],["の"],["人々","ひとびと"],["に"],["よろしく"],["伝えて","つたえて"],["ください"],["。"]]},{"verse":20,"text":"エラストはコリントにとどまりました。トロフィモは病気なのでミレトスに残してきました。","tok":[["エラスト"],["は"],["コリント"],["に"],["とどまりました"],["。"],["トロフィモ"],["は"],["病気","びょうき"],["な"],["ので"],["ミレトス"],["に"],["残して","のこして"],["きました"],["。"]]},{"verse":21,"text":"冬になる前にぜひ来てください。エウブロ、プデンス、リノス、クラウディア、およびすべての兄弟があなたによろしくと言っています。","tok":[["冬","ふゆ"],["に"],["なる"],["前","まえ"],["に"],["ぜひ"],["来て","きて"],["ください"],["。"],["エウブロ"],["、"],["プデンス"],["、"],["リノス"],["、"],["クラウディア"],["、"],["および"],["すべて"],["の"],["兄弟","きょうだい"],["が"],["あなた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]},{"verse":22,"text":"主があなたの霊と共にいてくださるように。恵みがあなたがたと共にあるように。","tok":[["主","ぬし"],["が"],["あなた"],["の"],["霊","れい"],["と"],["共","とも"],["に"],["いて"],["くださる"],["よう"],["に"],["。"],["恵み","めぐみ"],["が"],["あなた"],["がた"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
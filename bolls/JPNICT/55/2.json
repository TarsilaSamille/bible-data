[{"verse":1,"text":"そこで、わたしの子よ、あなたはキリスト‧イエスにおける恵みによって強くなりなさい。","tok":[["そこ"],["で"],["、"],["わたし"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["キリスト"],["‧"],["イエス"],["に"],["おける"],["恵み","めぐみ"],["によって"],["強く","つよく"],["なり"],["なさい"],["。"]]},{"verse":2,"text":"そして、多くの証人の面前でわたしから聞いたことを、ほかの人々にも教えることのできる忠実な人たちにゆだねなさい。","tok":[["そして"],["、"],["多く","おおく"],["の"],["証人","しょうにん"],["の"],["面前","めんぜん"],["で"],["わたし"],["から"],["聞いた","きいた"],["こと"],["を"],["、"],["ほか"],["の"],["人々","ひとびと"],["に"],["も"],["教える","おしえる"],["こと"],["の"],["できる"],["忠実","ちゅうじつ"],["な"],["人","ひと"],["たち"],["に"],["ゆだね"],["なさい"],["。"]]},{"verse":3,"text":"キリスト‧イエスの立派な兵士として、わたしと共に苦しみを忍びなさい。","tok":[["キリスト"],["‧"],["イエス"],["の"],["立派","りっぱ"],["な"],["兵士","へいし"],["として"],["、"],["わたし"],["と"],["共","とも"],["に"],["苦しみ","くるしみ"],["を"],["忍び","しのび"],["なさい"],["。"]]},{"verse":4,"text":"兵役に服している者は生計を立てるための仕事に煩わされず、自分を召集した者の気に入ろうとします。","tok":[["兵役","へいえき"],["に"],["服して","ふくして"],["いる"],["者","もの"],["は"],["生計","せいけい"],["を"],["立てる","たてる"],["ため"],["の"],["仕事","しごと"],["に"],["煩わされず","わずらわされず"],["、"],["自分","じぶん"],["を"],["召集","しょうしゅう"],["した"],["者","もの"],["の"],["気","き"],["に"],["入ろう","いろう"],["と"],["します"],["。"]]},{"verse":5,"text":"また、競技に参加する者は、規則に従って競技をしないならば、栄冠を受けることができません。","tok":[["また"],["、"],["競技","きょうぎ"],["に"],["参加","さんか"],["する"],["者","もの"],["は"],["、"],["規則","きそく"],["に"],["従って","したがって"],["競技","きょうぎ"],["を"],["しないならば"],["、"],["栄冠","えいかん"],["を"],["受ける","うける"],["こと"],["が"],["できません"],["。"]]},{"verse":6,"text":"労苦している農夫こそ、最初に収穫の分け前にあずかるべきです。","tok":[["労苦","ろうく"],["して"],["いる"],["農夫","のうふ"],["こそ"],["、"],["最初","さいしょ"],["に"],["収穫","しゅうかく"],["の"],["分け前","わけまえ"],["に"],["あずかるべきです"],["。"]]},{"verse":7,"text":"わたしの言うことをよく考えてみなさい。主は、あなたがすべてのことを理解できるようにしてくださるからです。","tok":[["わたし"],["の"],["言う","いう"],["こと"],["を"],["よく"],["考えて","かんがえて"],["み"],["なさい"],["。"],["主","ぬし"],["は"],["、"],["あなた"],["が"],["すべて"],["の"],["こと"],["を"],["理解","りかい"],["できる"],["よう"],["に"],["して"],["くださる"],["から"],["です"],["。"]]},{"verse":8,"text":"イエス‧キリストのことを思い起こしなさい。わたしの宣べ伝える福音によれば、この方は、ダビデの子孫で、死者の中から復活されたのです。","tok":[["イエス"],["‧"],["キリスト"],["の"],["こと"],["を"],["思い起こし","おもいおこし"],["なさい"],["。"],["わたし"],["の"],["宣べ伝える","のべつたえる"],["福音","ふくいん"],["に"],["よれば"],["、"],["この"],["方","かた"],["は"],["、"],["ダビデ"],["の"],["子孫","しそん"],["で"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["された"],["の"],["です"],["。"]]},{"verse":9,"text":"この福音のためにわたしは苦しみを受け、ついに犯罪人のように鎖につながれています。しかし、神の言葉はつながれていません。","tok":[["この"],["福音","ふくいん"],["の"],["ため"],["に"],["わたし"],["は"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["ついに"],["犯罪人","はんざいにん"],["の"],["よう"],["に"],["鎖","くさり"],["に"],["つながれて"],["います"],["。"],["しかし"],["、"],["神","かみ"],["の"],["言葉","ことば"],["は"],["つながれて"],["いません"],["。"]]},{"verse":10,"text":"だから、わたしは、選ばれた人々のために、あらゆることを耐え忍んでいます。彼らもキリスト‧イエスによる救いを永遠の栄光と共に得るためです。","tok":[["だ"],["から"],["、"],["わたし"],["は"],["、"],["選ばれた","えらばれた"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["あらゆる"],["こと"],["を"],["耐え忍んで","たえしのんで"],["います"],["。"],["彼","かれ"],["ら"],["も"],["キリスト"],["‧"],["イエス"],["に"],["よる"],["救い","すくい"],["を"],["永遠","えいえん"],["の"],["栄光","えいこう"],["と"],["共","とも"],["に"],["得る","える"],["ため"],["です"],["。"]]},{"verse":11,"text":"次の言葉は真実です。「わたしたちは、キリストと共に死んだのなら、キリストと共に生きるようになる。","tok":[["次","つぎ"],["の"],["言葉","ことば"],["は"],["真実","しんじつ"],["です"],["。"],["「"],["わたしたち"],["は"],["、"],["キリスト"],["と"],["共","とも"],["に"],["死んだ","しんだ"],["の"],["なら"],["、"],["キリスト"],["と"],["共","とも"],["に"],["生きる","いきる"],["よう"],["に"],["なる"],["。"]]},{"verse":12,"text":"耐え忍ぶなら、キリストと共に支配するようになる。キリストを否むなら、キリストもわたしたちを否まれる。","tok":[["耐え忍ぶなら","たえしのぶなら"],["、"],["キリスト"],["と"],["共","とも"],["に"],["支配","しはい"],["する"],["よう"],["に"],["なる"],["。"],["キリスト"],["を"],["否むなら","いなむなら"],["、"],["キリスト"],["も"],["わたしたち"],["を"],["否まれる","いなまれる"],["。"]]},{"verse":13,"text":"わたしたちが誠実でなくても、キリストは常に真実であられる。キリストは御自身を否むことができないからである。」","tok":[["わたしたち"],["が"],["誠実","せいじつ"],["で"],["なくて"],["も"],["、"],["キリスト"],["は"],["常","つね"],["に"],["真実","しんじつ"],["で"],["あられる"],["。"],["キリスト"],["は"],["御自身","ごじしん"],["を"],["否む","いなむ"],["こと"],["が"],["できない"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":14,"text":"これらのことを人々に思い起こさせ、言葉をあげつらわないようにと、神の御前で厳かに命じなさい。そのようなことは、何の役にも立たず、聞く者を破滅させるのです。","tok":[["これ"],["ら"],["の"],["こと"],["を"],["人々","ひとびと"],["に"],["思い起こさせ","おもいおこさせ"],["、"],["言葉","ことば"],["を"],["あげつらわない"],["よう"],["に"],["と"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["厳か","おごそか"],["に"],["命じ","めいじ"],["なさい"],["。"],["その"],["よう"],["な"],["こと"],["は"],["、"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立たず","たたず"],["、"],["聞く","きく"],["者","もの"],["を"],["破滅","はめつ"],["させる"],["の"],["です"],["。"]]},{"verse":15,"text":"あなたは、適格者と認められて神の前に立つ者、恥じるところのない働き手、真理の言葉を正しく伝える者となるように努めなさい。","tok":[["あなた"],["は"],["、"],["適格者","てきかくしゃ"],["と"],["認められて","みとめられて"],["神","かみ"],["の"],["前","まえ"],["に"],["立つ","たつ"],["者","もの"],["、"],["恥じる","はじる"],["ところ"],["の"],["ない"],["働き手","はたらきて"],["、"],["真理","しんり"],["の"],["言葉","ことば"],["を"],["正しく","まさしく"],["伝える","つたえる"],["者","もの"],["と"],["なる"],["よう"],["に"],["努め","つとめ"],["なさい"],["。"]]},{"verse":16,"text":"俗悪な無駄話を避けなさい。そのような話をする者はますます不信心になっていき、","tok":[["俗悪","ぞくあく"],["な"],["無駄話","むだばなし"],["を"],["避け","さけ"],["なさい"],["。"],["その"],["よう"],["な"],["話","はなし"],["を"],["する"],["者","もの"],["は"],["ますます"],["不信心","ふしんじん"],["に"],["なって"],["いき"],["、"]]},{"verse":17,"text":"その言葉は悪いはれ物のように広がります。その中には、ヒメナイとフィレトがいます。","tok":[["その"],["言葉","ことば"],["は"],["悪い","わるい"],["はれ物","はれもの"],["の"],["よう"],["に"],["広がります","ひろがります"],["。"],["その"],["中","なか"],["に"],["は"],["、"],["ヒメナイ"],["と"],["フィレト"],["が"],["います"],["。"]]},{"verse":18,"text":"彼らは真理の道を踏み外し、復活はもう起こったと言って、ある人々の信仰を覆しています。","tok":[["彼","かれ"],["ら"],["は"],["真理","しんり"],["の"],["道","みち"],["を"],["踏み外し","ふみはずし"],["、"],["復活","ふっかつ"],["は"],["もう"],["起こった","おこった"],["と"],["言って","いって"],["、"],["ある"],["人々","ひとびと"],["の"],["信仰","しんこう"],["を"],["覆して","くつがえして"],["います"],["。"]]},{"verse":19,"text":"しかし、神が据えられた堅固な基礎は揺るぎません。そこには、「主は御自分の者たちを知っておられる」と、また「主の名を呼ぶ者は皆、不義から身を引くべきである」と刻まれています。","tok":[["しかし"],["、"],["神","かみ"],["が"],["据えられた","すえられた"],["堅固","けんご"],["な"],["基礎","きそ"],["は"],["揺るぎません","ゆるぎません"],["。"],["そこ"],["に"],["は"],["、"],["「"],["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["者","もの"],["たち"],["を"],["知って","しって"],["おられる"],["」"],["と"],["、"],["また"],["「"],["主","ぬし"],["の"],["名","な"],["を"],["呼ぶ","よぶ"],["者","もの"],["は"],["皆","みな"],["、"],["不義","ふぎ"],["から"],["身","み"],["を"],["引くべきで","ひくべきで"],["ある"],["」"],["と"],["刻まれて","きざまれて"],["います"],["。"]]},{"verse":20,"text":"さて、大きな家には金や銀の器だけではなく、木や土の器もあります。一方は貴いことに、他方は普通のことに用いられます。","tok":[["さて"],["、"],["大きな","おおきな"],["家","いえ"],["に"],["は"],["金","きん"],["や"],["銀","ぎん"],["の"],["器","うつわ"],["だけ"],["で"],["は"],["なく"],["、"],["木","き"],["や"],["土","つち"],["の"],["器","うつわ"],["も"],["あります"],["。"],["一方","いっぽう"],["は"],["貴い","とうとい"],["こと"],["に"],["、"],["他方","たほう"],["は"],["普通","ふつう"],["の"],["こと"],["に"],["用いられます","もちいられます"],["。"]]},{"verse":21,"text":"だから、今述べた諸悪から自分を清める人は、貴いことに用いられる器になり、聖なるもの、主人に役立つもの、あらゆる善い業のために備えられたものとなるのです。","tok":[["だ"],["から"],["、"],["今","いま"],["述べた","のべた"],["諸悪","しょあく"],["から"],["自分","じぶん"],["を"],["清める","きよめる"],["人","ひと"],["は"],["、"],["貴い","とうとい"],["こと"],["に"],["用いられる","もちいられる"],["器","うつわ"],["に"],["なり"],["、"],["聖","せい"],["なる"],["もの"],["、"],["主人","しゅじん"],["に"],["役立つ","やくだつ"],["もの"],["、"],["あらゆる"],["善い","よい"],["業","ごう"],["の"],["ため"],["に"],["備えられた","そなえられた"],["もの"],["と"],["なる"],["の"],["です"],["。"]]},{"verse":22,"text":"若いころの情欲から遠ざかり、清い心で主を呼び求める人々と共に、正義と信仰と愛と平和を追い求めなさい。","tok":[["若い","わかい"],["ころ"],["の"],["情欲","じょうよく"],["から"],["遠ざかり","とおざかり"],["、"],["清い","きよい"],["心","こころ"],["で"],["主","ぬし"],["を"],["呼び求める","よびもとめる"],["人々","ひとびと"],["と"],["共","とも"],["に"],["、"],["正義","まさよし"],["と"],["信仰","しんこう"],["と"],["愛","あい"],["と"],["平和","へいわ"],["を"],["追い求め","おいもとめ"],["なさい"],["。"]]},{"verse":23,"text":"愚かで無知な議論を避けなさい。あなたも知っているとおり、そのような議論は争いのもとになります。","tok":[["愚か","おろか"],["で"],["無知","むち"],["な"],["議論","ぎろん"],["を"],["避け","さけ"],["なさい"],["。"],["あなた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["その"],["よう"],["な"],["議論","ぎろん"],["は"],["争い","あらそい"],["の"],["もと"],["に"],["なります"],["。"]]},{"verse":24,"text":"主の僕たる者は争わず、すべての人に柔和に接し、教えることができ、よく忍び、","tok":[["主","ぬし"],["の"],["僕","ぼく"],["たる"],["者","もの"],["は"],["争わず","あらそわず"],["、"],["すべて"],["の"],["人","ひと"],["に"],["柔和","にゅうわ"],["に"],["接し","せっし"],["、"],["教える","おしえる"],["こと"],["が"],["でき"],["、"],["よく"],["忍び","しのび"],["、"]]},{"verse":25,"text":"反抗する者を優しく教え導かねばなりません。神は彼らを悔い改めさせ、真理を認識させてくださるかもしれないのです。","tok":[["反抗","はんこう"],["する"],["者","もの"],["を"],["優しく","やさしく"],["教え導かねば","おしえみちびかねば"],["なりません"],["。"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["悔い改めさせ","くいあらためさせ"],["、"],["真理","しんり"],["を"],["認識","にんしき"],["させて"],["くださる"],["か"],["も"],["しれない"],["の"],["です"],["。"]]},{"verse":26,"text":"こうして彼らは、悪魔に生け捕りにされてその意のままになっていても、いつか目覚めてその罠から逃れるようになるでしょう。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["悪魔","あくま"],["に"],["生け捕り","いけどり"],["に"],["されて"],["その"],["意","い"],["の"],["まま"],["に"],["なって"],["いて"],["も"],["、"],["いつ"],["か"],["目覚めて","めざめて"],["その"],["罠","わな"],["から"],["逃れる","のがれる"],["よう"],["に"],["なるでしょう"],["。"]]}]
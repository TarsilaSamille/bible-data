,["レウ"],["、"]]},{"verse":26,"text":"セルグ、ナホル、テラ、","tok":[["セルグ"],["、"],["ナホル"],["、"],["テラ"],["、"]]},{"verse":27,"text":"アブラム、これがアブラハムである。","tok":[["アブラム"],["、"],["これ"],["が"],["アブラハム"],["で"],["ある"],["。"]]},{"verse":28,"text":"アブラハムの子は、イサク、イシュマエル。","tok":[["アブラハム"],["の"],["子","こ"],["は"],["、"],["イサク"],["、"],["イシュマエル"],["。"]]},{"verse":29,"text":"彼らの系図は次のとおりである。イシュマエルの長男はネバヨト、次はケダル、アドベエル、ミブサム、","tok":[["彼","かれ"],["ら"],["の"],["系図","けいず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["イシュマエル"],["の"],["長男","ちょうなん"],["は"],["ネバヨト"],["、"],["次","つぎ"],["は"],["ケダル"],["、"],["アドベエル"],["、"],["ミブサム"],["、"]]},{"verse":30,"text":"ミシュマ、ドマ、マサ、ハダド、テマ、","tok":[["ミシュマ"],["、"],["ドマ"],["、"],["マサ"],["、"],["ハダド"],["、"],["テマ"],["、"]]},{"verse":31,"text":"エトル、ナフィシュ、ケデマであり、以上がイシュマエルの息子たちであった。","tok":[["エトル"],["、"],["ナフィシュ"],["、"],["ケデマ"],["で"],["あり"],["、"],["以上","いじょう"],["が"],["イシュマエル"],["の"],["息子","むすこ"],["たち"],["で"],["あった"],["。"]]},{"verse":32,"text":"アブラハムの側女ケトラが産んだ子は、ジムラン、ヨクシャン、メダン、ミディアン、イシュバク、シュア。ヨクシャンの子は、シェバ、デダン。","tok":[["アブラハム"],["の"],["側女","そばめ"],["ケトラ"],["が"],["産んだ","うんだ"],["子","こ"],["は"],["、"],["ジムラン"],["、"],["ヨクシャン"],["、"],["メダン"],["、"],["ミディアン"],["、"],["イシュバク"],["、"],["シュア"],["。"],["ヨクシャン"],["の"],["子","こ"],["は"],["、"],["シェバ"],["、"],["デダン"],["。"]]},{"verse":33,"text":"ミディアンの子は、エファ、エフェル、ハノク、アビダ、エルダア。これらは皆、ケトラの子孫である。","tok":[["ミディアン"],["の"],["子","こ"],["は"],["、"],["エファ"],["、"],["エフェル"],["、"],["ハノク"],["、"],["アビダ"],["、"],["エルダア"],["。"],["これ"],["ら"],["は"],["皆","みな"],["、"],["ケトラ"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":34,"text":"アブラハムにはイサクが生まれた。イサクの子は、エサウ、イスラエル。","tok":[["アブラハム"],["に"],["は"],["イサク"],["が"],["生まれた","うまれた"],["。"],["イサク"],["の"],["子","こ"],["は"],["、"],["エサウ"],["、"],["イスラエル"],["。"]]},{"verse":35,"text":"エサウの子は、エリファズ、レウエル、エウシュ、ヤラム、コラ。","tok":[["エサウ"],["の"],["子","こ"],["は"],["、"],["エリファズ"],["、"],["レウエル"],["、"],["エウシュ"],["、"],["ヤラム"],["、"],["コラ"],["。"]]},{"verse":36,"text":"エリファズの子は、テマン、オマル、ツェフィ、ガタム、ケナズ、ティムナ、アマレク。","tok":[["エリファズ"],["の"],["子","こ"],["は"],["、"],["テマン"],["、
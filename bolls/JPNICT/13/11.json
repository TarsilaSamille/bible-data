[{"verse":1,"text":"すべてのイスラエル人はヘブロンのダビデのもとに集まり、こう言った。「御覧ください。わたしたちはあなたの骨肉です。","tok":[["すべて"],["の"],["イスラエル"],["人","にん"],["は"],["ヘブロン"],["の"],["ダビデ"],["の"],["もと"],["に"],["集まり","あつまり"],["、"],["こう"],["言った","いった"],["。"],["「"],["御覧","ごらん"],["ください"],["。"],["わたしたち"],["は"],["あなた"],["の"],["骨肉","こつにく"],["です"],["。"]]},{"verse":2,"text":"これまで、サウルが王であったときにも、イスラエルの進退の指揮をとっておられたのはあなたでした。あなたの神、主はあなたに仰せになりました。『わが民イスラエルを牧するのはあなただ。あなたがわが民イスラエルの指導者となる』と。」","tok":[["これ"],["まで"],["、"],["サウル"],["が"],["王","おう"],["で"],["あった"],["とき"],["に"],["も"],["、"],["イスラエル"],["の"],["進退","しんたい"],["の"],["指揮","しき"],["を"],["とって"],["おられた"],["の"],["は"],["あなた"],["でした"],["。"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["あなた"],["に"],["仰せ","おおせ"],["に"],["なりました"],["。"],["『"],["わが"],["民","みん"],["イスラエル"],["を"],["牧","まき"],["する"],["の"],["は"],["あなた"],["だ"],["。"],["あなた"],["が"],["わが"],["民","みん"],["イスラエル"],["の"],["指導者","しどうしゃ"],["と"],["なる"],["』"],["と"],["。"],["」"]]},{"verse":3,"text":"イスラエルの長老たちは全員、ヘブロンの王のもとに来た。ダビデはヘブロンで主の御前に彼らと契約を結んだ。長老たちは、主がサムエルによって告げられたように、ダビデに油を注ぎ、イスラエルの王とした。","tok":[["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["は"],["全員","ぜんいん"],["、"],["ヘブロン"],["の"],["王","おう"],["の"],["もと"],["に"],["来た","きた"],["。"],["ダビデ"],["は"],["ヘブロン"],["で"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["。"],["長老","ちょうろう"],["たち"],["は"],["、"],["主","ぬし"],["が"],["サムエル"],["によって"],["告げられた","つげられた"],["よう"],["に"],["、"],["ダビデ"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["イスラエル"],["の"],["王","おう"],["と"],["した"],["。"]]},{"verse":4,"text":"ダビデはすべてのイスラエル人と共にエルサレムに向かった。この町はエブスと言われ、エブス人がその地の住民であった。","tok":[["ダビデ"],["は"],["すべて"],["の"],["イスラエル"],["人","にん"],["と"],["共","とも"],["に"],["エルサレム"],["に"],["向かった","むかった"],["。"],["この"],["町","まち"],["は"],["エブス"],["と"],["言われ","いわれ"],["、"],["エブス"],["人","ひと"],["が"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["で"],["あった"],["。"]]},{"verse":5,"text":"エブスの住民はダビデに、「お前はここに入れまい」と言った。しかし、ダビデはシオンの要害を陥れた。これがダビデの町である。","tok":[["エブス"],["の"],["住民","じゅうみん"],["は"],["ダビデ"],["に"],["、"],["「"],["お前","おまえ"],["は"],["ここ"],["に"],["入れまい","いれまい"],["」"],["と"],["言った","いった"],["。"],["しかし"],["、"],["ダビデ"],["は"],["シオン"],["の"],["要害","ようがい"],["を"],["陥れた","おとしいれた"],["。"],["これ"],["が"],["ダビデ"],["の"],["町","まち"],["で"],["ある"],["。"]]},{"verse":6,"text":"ダビデは、「真っ先にエブス人を撃ち倒した者が頭となり、将軍となる」と言ったが、ツェルヤの子ヨアブが真っ先に攻め上って頭となった。","tok":[["ダビデ"],["は"],["、"],["「"],["真っ先","まっさき"],["に"],["エブス"],["人","ひと"],["を"],["撃ち倒した","うちたおした"],["者","もの"],["が"],["頭","あたま"],["と"],["なり"],["、"],["将軍","しょうぐん"],["と"],["なる"],["」"],["と"],["言った","いった"],["が"],["、"],["ツェルヤ"],["の"],["子","こ"],["ヨアブ"],["が"],["真っ先","まっさき"],["に"],["攻め上って","せめのぼって"],["頭","あたま"],["と"],["なった"],["。"]]},{"verse":7,"text":"ダビデはこの要害に住んだ。それゆえ、それはダビデの町と呼ばれるようになった。","tok":[["ダビデ"],["は"],["この"],["要害","ようがい"],["に"],["住んだ","すんだ"],["。"],["それ"],["ゆえ"],["、"],["それ"],["は"],["ダビデ"],["の"],["町","まち"],["と"],["呼ばれる","よばれる"],["よう"],["に"],["なった"],["。"]]},{"verse":8,"text":"彼は町の周囲をミロから一周するまで築城して固め、ヨアブは町の他の部分を修復した。","tok":[["彼","かれ"],["は"],["町","まち"],["の"],["周囲","しゅうい"],["を"],["ミロ"],["から"],["一","いち"],["周","しゅう"],["する"],["まで"],["築城","ちくじょう"],["して"],["固め","かため"],["、"],["ヨアブ"],["は"],["町","まち"],["の"],["他","ほか"],["の"],["部分","ぶぶん"],["を"],["修復","しゅうふく"],["した"],["。"]]},{"verse":9,"text":"ダビデは次第に勢力を増し、万軍の主は彼と共におられた。","tok":[["ダビデ"],["は"],["次第","しだい"],["に"],["勢力","せいりょく"],["を"],["増し","まし"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["おられた"],["。"]]},{"verse":10,"text":"ダビデの勇士の頭は次のとおりである。彼らはダビデの統治に協力し、イスラエルのすべての人々と共に、主がイスラエルに告げられたとおり、ダビデが王となるように尽力した。","tok":[["ダビデ"],["の"],["勇士","ゆうし"],["の"],["頭","あたま"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["ダビデ"],["の"],["統治","とうち"],["に"],["協力","きょうりょく"],["し"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["、"],["主","ぬし"],["が"],["イスラエル"],["に"],["告げられた","つげられた"],["とおり"],["、"],["ダビデ"],["が"],["王","おう"],["と"],["なる"],["よう"],["に"],["尽力","じんりょく"],["した"],["。"]]},{"verse":11,"text":"ダビデの勇士たちの名簿は次のとおりである。ハクモニの子ヤショブアム、三十人隊の頭。槍を振るって一度に三百人を刺し殺した。","tok":[["ダビデ"],["の"],["勇士","ゆうし"],["たち"],["の"],["名簿","めいぼ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ハクモニ"],["の"],["子","こ"],["ヤショブアム"],["、"],["三","さん"],["十人隊","じゅうにんたい"],["の"],["頭","あたま"],["。"],["槍","やり"],["を"],["振るって","ふるって"],["一度","いちど"],["に"],["三百人","さんひゃくにん"],["を"],["刺し殺した","さしころした"],["。"]]},{"verse":12,"text":"次にアホア人ドドの子エルアザル。三勇士の一人。","tok":[["次","つぎ"],["に"],["アホア人","あほあにん"],["ドド"],["の"],["子","こ"],["エルアザル"],["。"],["三","さん"],["勇士","ゆうし"],["の"],["一人","ひとり"],["。"]]},{"verse":13,"text":"彼がダビデに同行してパス‧ダミムにいたとき、ペリシテ人が集結して戦いを挑んできた。そこには豊作の大麦畑があった。民はペリシテ人を前にして逃走したが、","tok":[["彼","かれ"],["が"],["ダビデ"],["に"],["同行","どうこう"],["して"],["パス"],["‧"],["ダミム"],["に"],["いた"],["とき"],["、"],["ペリシテ"],["人","にん"],["が"],["集結","しゅうけつ"],["して"],["戦い","たたかい"],["を"],["挑んで","いどんで"],["きた"],["。"],["そこ"],["に"],["は"],["豊作","ほうさく"],["の"],["大麦","おおむぎ"],["畑","はたけ"],["が"],["あった"],["。"],["民","たみ"],["は"],["ペリシテ"],["人","にん"],["を"],["前","まえ"],["に"],["して"],["逃走","とうそう"],["した"],["が"],["、"]]},{"verse":14,"text":"二人は畑にとどまってこれを救い、ペリシテ人を討った。主は大勝利をもたらされた。","tok":[["二人","ふたり"],["は"],["畑","はたけ"],["に"],["とどまって"],["これ"],["を"],["救い","すくい"],["、"],["ペリシテ"],["人","にん"],["を"],["討った","うった"],["。"],["主","ぬし"],["は"],["大勝利","だいしょうり"],["を"],["もたらされた"],["。"]]},{"verse":15,"text":"三十人の頭の中の三人が、アドラムの洞窟にいるダビデを訪ねて岩山に来たことがあった。ペリシテ人の陣営がレファイムの谷に張られていた。","tok":[["三","さん"],["十人","じゅうにん"],["の"],["頭","あたま"],["の"],["中","なか"],["の"],["三人","さんにん"],["が"],["、"],["アドラム"],["の"],["洞窟","どうくつ"],["に"],["いる"],["ダビデ"],["を"],["訪ねて","たずねて"],["岩山","いわやま"],["に"],["来た","きた"],["こと"],["が"],["あった"],["。"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["が"],["レファイム"],["の"],["谷","たに"],["に"],["張られて","はられて"],["いた"],["。"]]},{"verse":16,"text":"ダビデは要害におり、ペリシテ人の駐屯部隊はベツレヘムにいた。","tok":[["ダビデ"],["は"],["要害","ようがい"],["に"],["おり"],["、"],["ペリシテ"],["人","にん"],["の"],["駐屯","ちゅうとん"],["部隊","ぶたい"],["は"],["ベツレヘム"],["に"],["いた"],["。"]]},{"verse":17,"text":"ダビデは、「ベツレヘムの城門の傍らにある、あの井戸の水を飲ませてくれる者があればよいのに」と切望した。","tok":[["ダビデ"],["は"],["、"],["「"],["ベツレヘム"],["の"],["城門","じょうもん"],["の"],["傍ら","かたわら"],["に"],["ある"],["、"],["あの"],["井戸","いど"],["の"],["水","みず"],["を"],["飲ませて","のませて"],["くれる"],["者","もの"],["が"],["あれば"],["よい"],["のに"],["」"],["と"],["切望","せつぼう"],["した"],["。"]]},{"verse":18,"text":"三人はペリシテの陣を突破し、ベツレヘムの城門の傍らにある井戸から水をくみ、ダビデのもとに持ち帰った。ダビデはこの水を飲むことを望まず、注いで主にささげ、","tok":[["三人","さんにん"],["は"],["ペリシテ"],["の"],["陣","じん"],["を"],["突破","とっぱ"],["し"],["、"],["ベツレヘム"],["の"],["城門","じょうもん"],["の"],["傍ら","かたわら"],["に"],["ある"],["井戸","いど"],["から"],["水","みず"],["を"],["くみ"],["、"],["ダビデ"],["の"],["もと"],["に"],["持ち帰った","もちかえった"],["。"],["ダビデ"],["は"],["この"],["水","みず"],["を"],["飲む","のむ"],["こと"],["を"],["望まず","のぞまず"],["、"],["注いで","そそいで"],["主に","おもに"],["ささげ"],["、"]]},{"verse":19,"text":"こう言った。「わが神よ、わたしはこのようなことを決してすべきではありません。彼らは命をかけて持ってきてくれたのです。彼らの命のかかった血をわたしが飲むことができましょうか。」ダビデはその水を飲もうとしなかった。以上が三勇士の武勲である。","tok":[["こう"],["言った","いった"],["。"],["「"],["わが"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["この"],["よう"],["な"],["こと"],["を"],["決して","けっして"],["すべきで"],["は"],["ありません"],["。"],["彼","かれ"],["ら"],["は"],["命","いのち"],["を"],["かけて"],["持って","もって"],["きて"],["くれた"],["の"],["です"],["。"],["彼","かれ"],["ら"],["の"],["命","いのち"],["の"],["かかった"],["血","ち"],["を"],["わたし"],["が"],["飲む","のむ"],["こと"],["が"],["できましょう"],["か"],["。"],["」"],["ダビデ"],["は"],["その"],["水","みず"],["を"],["飲もう","のもう"],["と"],["しなかった"],["。"],["以上","いじょう"],["が"],["三","さん"],["勇士","ゆうし"],["の"],["武勲","ぶくん"],["で"],["ある"],["。"]]},{"verse":20,"text":"ヨアブの兄弟アブシャイ。三勇士の頭。槍を振るって三百人を刺し殺したが、三勇士の中に名はなかった。","tok":[["ヨアブ"],["の"],["兄弟","きょうだい"],["アブシャイ"],["。"],["三","さん"],["勇士","ゆうし"],["の"],["頭","あたま"],["。"],["槍","やり"],["を"],["振るって","ふるって"],["三百人","さんひゃくにん"],["を"],["刺し殺した","さしころした"],["が"],["、"],["三","さん"],["勇士","ゆうし"],["の"],["中","なか"],["に"],["名","な"],["は"],["なかった"],["。"]]},{"verse":21,"text":"三勇士の中の二人によって重んじられ、彼らの長でもあったが、武勲は三勇士に及ばなかった。","tok":[["三","さん"],["勇士","ゆうし"],["の"],["中","なか"],["の"],["二人","ふたり"],["によって"],["重んじられ","おもんじられ"],["、"],["彼","かれ"],["ら"],["の"],["長","ちょう"],["で"],["も"],["あった"],["が"],["、"],["武勲","ぶくん"],["は"],["三","さん"],["勇士","ゆうし"],["に"],["及ばなかった","およばなかった"],["。"]]},{"verse":22,"text":"ヨヤダの子
[{"verse":1,"text":"ヘブロンで生まれたダビデの息子は次のとおりである。長男はアムノン、母はイズレエル人アヒノアム。次男はダニエル、母はカルメル人アビガイル。","tok":[["ヘブロン"],["で"],["生まれた","うまれた"],["ダビデ"],["の"],["息子","むすこ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["長男","ちょうなん"],["は"],["アムノン"],["、"],["母","はは"],["は"],["イズレエル"],["人","にん"],["アヒノアム"],["。"],["次男","じなん"],["は"],["ダニエル"],["、"],["母","はは"],["は"],["カルメル"],["人","にん"],["アビガイル"],["。"]]},{"verse":2,"text":"三男はアブサロム、ゲシュルの王タルマイの娘マアカの子。四男はアドニヤ、ハギトの子。","tok":[["三男","さんなん"],["は"],["アブサロム"],["、"],["ゲシュル"],["の"],["王","おう"],["タルマイ"],["の"],["娘","むすめ"],["マアカ"],["の"],["子","こ"],["。"],["四男","よんなん"],["は"],["アドニヤ"],["、"],["ハギト"],["の"],["子","こ"],["。"]]},{"verse":3,"text":"五男はシェファトヤ、母はアビタル。六男はイトレアム、母はダビデの妻エグラ。","tok":[["五男","いつお"],["は"],["シェファトヤ"],["、"],["母","はは"],["は"],["アビタル"],["。"],["六男","むつお"],["は"],["イトレアム"],["、"],["母","はは"],["は"],["ダビデ"],["の"],["妻","つま"],["エグラ"],["。"]]},{"verse":4,"text":"ヘブロンで六人の息子がダビデに生まれた。ダビデはそこで七年と六か月、エルサレムで三十三年間王位にあった。","tok":[["ヘブロン"],["で"],["六人","ろくにん"],["の"],["息子","むすこ"],["が"],["ダビデ"],["に"],["生まれた","うまれた"],["。"],["ダビデ"],["は"],["そこ"],["で"],["七","なな"],["年","ねん"],["と"],["六","ろく"],["か月","かげつ"],["、"],["エルサレム"],["で"],["三十三","さんじゅうさん"],["年間","ねんかん"],["王位","おうい"],["に"],["あった"],["。"]]},{"verse":5,"text":"エルサレムで彼に生まれた息子は次のとおりである。シムア、ショバブ、ナタン、ソロモンの四人。母はアミエルの娘バト‧シュア。","tok":[["エルサレム"],["で"],["彼","かれ"],["に"],["生まれた","うまれた"],["息子","むすこ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["シムア"],["、"],["ショバブ"],["、"],["ナタン"],["、"],["ソロモン"],["の"],["四人","よんにん"],["。"],["母","はは"],["は"],["アミエル"],["の"],["娘","むすめ"],["バト"],["‧"],["シュア"],["。"]]},{"verse":6,"text":"更に、イブハル、エリシャマ、エリフェレト、","tok":[["更に","さらに"],["、"],["イブハル"],["、"],["エリシャマ"],["、"],["エリフェレト"],["、"]]},{"verse":7,"text":"ノガ、ネフェグ、ヤフィア、","tok":[["ノガ"],["、"],["ネフェグ"],["、"],["ヤフィア"],["、"]]},{"verse":8,"text":"エリシャマ、エルヤダ、エリフェレトの九人がいる。","tok":[["エリシャマ"],["、"],["エルヤダ"],["、"],["エリフェレト"],["の"],["九人","きゅうにん"],["が"],["いる"],["。"]]},{"verse":9,"text":"これが側女らによる子を除くダビデの子のすべてである。タマルは彼らの姉妹である。","tok":[["これ"],["が"],["側女","そばめ"],["ら"],["に"],["よる"],["子","こ"],["を"],["除く","のぞく"],["ダビデ"],["の"],["子","こ"],["の"],["すべて"],["で"],["ある"],["。"],["タマル"],["は"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["で"],["ある"],["。"]]},{"verse":10,"text":"ソロモンの子孫は子がレハブアム、孫がアビヤ、更にアサ、ヨシャファト、","tok":[["ソロモン"],["の"],["子孫","しそん"],["は"],["子","こ"],["が"],["レハブアム"],["、"],["孫","まご"],["が"],["アビヤ"],["、"],["更に","さらに"],["アサ"],["、"],["ヨシャファト"],["、"]]},{"verse":11,"text":"ヨラム、アハズヤ、ヨアシュ、","tok":[["ヨラム"],["、"],["アハズヤ"],["、"],["ヨアシュ"],["、"]]},{"verse":12,"text":"アマツヤ、アザルヤ、ヨタム、","tok":[["アマツヤ"],["、"],["アザルヤ"],["、"],["ヨタム"],["、"]]},{"verse":13,"text":"アハズ、ヒゼキヤ、マナセ、","tok":[["アハズ"],["、"],["ヒゼキヤ"],["、"],["マナセ"],["、"]]},{"verse":14,"text":"アモン、ヨシヤと続く。","tok":[["アモン"],["、"],["ヨシヤ"],["と"],["続く","つづく"],["。"]]},{"verse":15,"text":"ヨシヤの子は、長男ヨハナン、次男ヨヤキム、三男ゼデキヤ、四男シャルム。","tok":[["ヨシヤ"],["の"],["子","こ"],["は"],["、"],["長男","ちょうなん"],["ヨハナン"],["、"],["次男","じなん"],["ヨヤキム"],["、"],["三男","さんなん"],["ゼデキヤ"],["、"],["四男","よんなん"],["シャルム"],["。"]]},{"verse":16,"text":"ヨヤキムの子はエコンヤ。その子はゼデキヤである。","tok":[["ヨヤキム"],["の"],["子","こ"],["は"],["エコンヤ"],["。"],["その"],["子","こ"],["は"],["ゼデキヤ"],["で"],["ある"],["。"]]},{"verse":17,"text":"捕虜となったエコンヤの子は、息子シェアルティエルをはじめ、","tok":[["捕虜","ほりょ"],["と"],["なった"],["エコンヤ"],["の"],["子","こ"],["は"],["、"],["息子","むすこ"],["シェアルティエル"],["を"],["はじめ"],["、"]]},{"verse":18,"text":"マルキラム、ペダヤ、シェンアツァル、エカムヤ、ホシャマ、ネダブヤ。","tok":[["マルキラム"],["、"],["ペダヤ"],["、"],["シェンアツァル"],["、"],["エカムヤ"],["、"],["ホシャマ"],["、"],["ネダブヤ"],["。"]]},{"verse":19,"text":"ペダヤの子は、ゼルバベル、シムイ。ゼルバベルの子は、メシュラム、ハナンヤ、彼らの姉妹シェロミト、","tok":[["ペダヤ"],["の"],["子","こ"],["は"],["、"],["ゼルバベル"],["、"],["シムイ"],["。"],["ゼルバベル"],["の"],["子","こ"],["は"],["、"],["メシュラム"],["、"],["ハナンヤ"],["、"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["シェロミト"],["、"]]},{"verse":20,"text":"それにハシュバ、オヘル、ベレクヤ、ハサドヤ、ユシャブ‧ヘセドの五人。","tok":[["それ"],["に"],["ハシュバ"],["、"],["オヘル"],["、"],["ベレクヤ"],["、"],["ハサドヤ"],["、"],["ユシャブ"],["‧"],["ヘセド"],["の"],["五人","ごにん"],["。"]]},{"verse":21,"text":"ハナンヤの子は、ペラトヤ、エシャヤ、その子はレファヤ、その子はアルナン、その子はオバドヤ、その子はシェカンヤ。","tok":[["ハナンヤ"],["の"],["子","こ"],["は"],["、"],["ペラトヤ"],["、"],["エシャヤ"],["、"],["その"],["子","こ"],["は"],["レファヤ"],["、"],["その"],["子","こ"],["は"],["アルナン"],["、"],["その"],["子","こ"],["は"],["オバドヤ"],["、"],["その"],["子","こ"],["は"],["シェカンヤ"],["。"]]},{"verse":22,"text":"シェカンヤの子は、シェマヤと、シェマヤの子ハトシュ、イグアル、バリア、ネアルヤ、シャファトの六人。","tok":[["シェカンヤ"],["の"],["子","こ"],["は"],["、"],["シェマヤ"],["と"],["、"],["シェマヤ"],["の"],["子","こ"],["ハトシュ"],["、"],["イグアル"],["、"],["バリア"],["、"],["ネアルヤ"],["、"],["シャファト"],["の"],["六人","ろくにん"],["。"]]},{"verse":23,"text":"ネアルヤの子は、エルヨエナイ、ヒズキヤ、アズリカムの三人。","tok":[["ネアルヤ"],["の"],["子","こ"],["は"],["、"],["エルヨエナイ"],["、"],["ヒズキヤ"],["、"],["アズリカム"],["の"],["三人","さんにん"],["。"]]},{"verse":24,"text":"エルヨエナイの子は、ホダウヤ、エルヤシブ、ペラヤ、アクブ、ヨハナン、デラヤ、アナニの七人。","tok":[["エルヨエナイ"],["の"],["子","こ"],["は"],["、"],["ホダウヤ"],["、"],["エルヤシブ"],["、"],["ペラヤ"],["、"],["アクブ"],["、"],["ヨハナン"],["、"],["デラヤ"],["、"],["アナニ"],["の"],["七人","しちにん"],["。"]]}]
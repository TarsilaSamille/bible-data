[{"verse":1,"text":"ダビデ王は全会衆を前にして言った。「わが子ソロモンを神はただ一人お選びになったが、まだ若くて力弱く、この工事は大きい。この宮は人のためではなく神なる主のためのものだからである。","tok":[["ダビデ"],["王","おう"],["は"],["全","ぜん"],["会衆","かいしゅう"],["を"],["前","まえ"],["に"],["して"],["言った","いった"],["。"],["「"],["わが"],["子","こ"],["ソロモン"],["を"],["神","かみ"],["は"],["ただ"],["一人","ひとり"],["お選び","おえらび"],["に"],["なった"],["が"],["、"],["まだ"],["若くて","わかくて"],["力","ちから"],["弱く","よわく"],["、"],["この"],["工事","こうじ"],["は"],["大きい","おおきい"],["。"],["この"],["宮","みや"],["は"],["人","ひと"],["の"],["ため"],["で"],["は"],["なく"],["神","かみ"],["なる"],["主","ぬし"],["の"],["ため"],["の"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"わたしは、わたしの神の神殿のために力を尽くして準備してきた。金のために金を、銀のために銀を、青銅のために青銅を、鉄のために鉄を、木材のために木材を、縞めのうの石、象眼用の飾り石、淡い色の石、色彩豊かな石などあらゆる種類の宝石と大量の大理石を調えた。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["神","かみ"],["の"],["神殿","しんでん"],["の"],["ため"],["に"],["力","ちから"],["を"],["尽くして","つくして"],["準備","じゅんび"],["して"],["きた"],["。"],["金","きん"],["の"],["ため"],["に"],["金","かね"],["を"],["、"],["銀","ぎん"],["の"],["ため"],["に"],["銀","ぎん"],["を"],["、"],["青銅","せいどう"],["の"],["ため"],["に"],["青銅","せいどう"],["を"],["、"],["鉄","てつ"],["の"],["ため"],["に"],["鉄","てつ"],["を"],["、"],["木材","もくざい"],["の"],["ため"],["に"],["木材","もくざい"],["を"],["、"],["縞","しま"],["めのう"],["の"],["石","いし"],["、"],["象眼用","ぞうがんよう"],["の"],["飾り石","かざりいし"],["、"],["淡い","あわい"],["色","いろ"],["の"],["石","いし"],["、"],["色彩","しきさい"],["豊か","ゆたか"],["な"],["石","いし"],["など"],["あらゆる"],["種類","しゅるい"],["の"],["宝石","ほうせき"],["と"],["大量","たいりょう"],["の"],["大理石","だいりせき"],["を"],["調えた","ととのえた"],["。"]]},{"verse":3,"text":"更にわたしは、わたしの神の神殿に対するあつい思いのゆえに、わたし個人の財産である金銀を、聖所のために準備したこれらすべてに加えて、わたしの神の神殿のために寄贈する。","tok":[["更に","さらに"],["わたし"],["は"],["、"],["わたし"],["の"],["神","かみ"],["の"],["神殿","しんでん"],["に"],["対する","たいする"],["あつい"],["思い","おもい"],["の"],["ゆえ"],["に"],["、"],["わたし"],["個人","こじん"],["の"],["財産","ざいさん"],["で"],["ある"],["金銀","きんぎん"],["を"],["、"],["聖","せい"],["所","しょ"],["の"],["ため"],["に"],["準備","じゅんび"],["した"],["これ"],["ら"],["すべて"],["に"],["加えて","くわえて"],["、"],["わたし"],["の"],["神","かみ"],["の"],["神殿","しんでん"],["の"],["ため"],["に"],["寄贈","きぞう"],["する"],["。"]]},{"verse":4,"text":"建物の壁を覆うためにオフィル産の金を三千キカル、精錬された銀を七千キカル寄贈する。","tok":[["建物","たてもの"],["の"],["壁","かべ"],["を"],["覆う","おおう"],["ため"],["に"],["オフィル"],["産","さん"],["の"],["金","かね"],["を"],["三千","さんせん"],["キカル"],["、"],["精錬","せいれん"],["された"],["銀","ぎん"],["を"],["七千","ななせん"],["キカル"],["寄贈","きぞう"],["する"],["。"]]},{"verse":5,"text":"金は金製品のため、銀は銀製品のためであり、職人の手によるすべての作業に用いられる。今日、自ら進んで手を満たし、主に差し出す者はいないか。」","tok":[["金","きん"],["は"],["金製品","きんせいひん"],["の"],["ため"],["、"],["銀","ぎん"],["は"],["銀製品","ぎんせいひん"],["の"],["ため"],["で"],["あり"],["、"],["職人","しょくにん"],["の"],["手","て"],["に"],["よる"],["すべて"],["の"],["作業","さぎょう"],["に"],["用いられる","もちいられる"],["。"],["今日","きょう"],["、"],["自ら","みずから"],["進んで","すすんで"],["手","て"],["を"],["満たし","みたし"],["、"],["主に","おもに"],["差し出す","さしだす"],["者","もの"],["は"],["いない"],["か"],["。"],["」"]]},{"verse":6,"text":"すると、家系の長たち、イスラエル諸部族の部族長たち、千人隊と百人隊の長たち、それに王の執務に携わる高官たちは、自ら進んで、","tok":[["する"],["と"],["、"],["家系","かけい"],["の"],["長","なが"],["たち"],["、"],["イスラエル"],["諸","しょ"],["部族","ぶぞく"],["の"],["部族長","ぶぞくちょう"],["たち"],["、"],["千人隊","せんにんたい"],["と"],["百人隊","ひゃくにんたい"],["の"],["長","なが"],["たち"],["、"],["それ"],["に"],["王","おう"],["の"],["執務","しつむ"],["に"],["携わる","たずさわる"],["高官","こうかん"],["たち"],["は"],["、"],["自ら","みずから"],["進んで","すすんで"],["、"]]},{"verse":7,"text":"神殿に奉仕するために金五千キカル一万ダリク、銀一万キカル、青銅一万八千キカル、鉄十万キカルを寄贈した。","tok":[["神殿","しんでん"],["に"],["奉仕","ほうし"],["する"],["ため"],["に"],["金","きん"],["五千","ごせん"],["キカル"],["一万","いちまん"],["ダリク"],["、"],["銀","ぎん"],["一万","いちまん"],["キカル"],["、"],["青銅","せいどう"],["一万八千","いちまんはちせん"],["キカル"],["、"],["鉄","てつ"],["十万","じゅうまん"],["キカル"],["を"],["寄贈","きぞう"],["した"],["。"]]},{"verse":8,"text":"宝石を持つ者は、それをゲルション一族のエヒエルの手に託して主の神殿の宝物庫に寄贈した。","tok":[["宝石","ほうせき"],["を"],["持つ","もつ"],["者","もの"],["は"],["、"],["それ"],["を"],["ゲルション"],["一族","いちぞく"],["の"],["エヒエル"],["の"],["手","て"],["に"],["託して","たくして"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["宝物庫","ほうもつこ"],["に"],["寄贈","きぞう"],["した"],["。"]]},{"verse":9,"text":"民は彼らが自ら進んでささげたことを喜んだ。彼らが全き心をもって自ら進んで主にささげたからである。ダビデ王も大いに喜んだ。","tok":[["民","みん"],["は"],["彼","かれ"],["ら"],["が"],["自ら","みずから"],["進んで","すすんで"],["ささげた"],["こと"],["を"],["喜んだ","よろこんだ"],["。"],["彼","かれ"],["ら"],["が"],["全","ぜん"],["き"],["心","こころ"],["を"],["もって"],["自ら","みずから"],["進んで","すすんで"],["主に","おもに"],["ささげた"],["から"],["で"],["ある"],["。"],["ダビデ"],["王","おう"],["も"],["大いに","おおいに"],["喜んだ","よろこんだ"],["。"]]},{"verse":10,"text":"ダビデは全会衆の前で主をたたえて言った。「わたしたちの父祖イスラエルの神、主よ、あなたは世々とこしえにほめたたえられますように。","tok":[["ダビデ"],["は"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["で"],["主","ぬし"],["を"],["たたえて"],["言った","いった"],["。"],["「"],["わたしたち"],["の"],["父祖","ふそ"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["世々","せいせい"],["とこしえ"],["に"],["ほめたたえられます"],["よう"],["に"],["。"]]},{"verse":11,"text":"偉大さ、力、光輝、威光、栄光は、主よ、あなたのもの。まことに天と地にあるすべてのものはあなたのもの。主よ、国もあなたのもの。あなたはすべてのものの上に頭として高く立っておられる。","tok":[["偉大","いだい"],["さ"],["、"],["力","ちから"],["、"],["光輝","こうき"],["、"],["威光","いこう"],["、"],["栄光","えいこう"],["は"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["の"],["もの"],["。"],["まこと"],["に"],["天","てん"],["と"],["地","ち"],["に"],["ある"],["すべて"],["の"],["もの"],["は"],["あなた"],["の"],["もの"],["。"],["主","ぬし"],["よ"],["、"],["国","くに"],["も"],["あなた"],["の"],["もの"],["。"],["あなた"],["は"],["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["頭","あたま"],["として"],["高く","たかく"],["立って","たって"],["おられる"],["。"]]},{"verse":12,"text":"富と栄光は御前にあり、あなたは万物を支配しておられる。勢いと力は御手の中にあり、またその御手をもっていかなるものでも大いなる者、力ある者となさることができる。","tok":[["富","とみ"],["と"],["栄光","えいこう"],["は"],["御前","ごぜん"],["に"],["あり"],["、"],["あなた"],["は"],["万物","ばんぶつ"],["を"],["支配","しはい"],["して"],["おられる"],["。"],["勢い","いきおい"],["と"],["力","ちから"],["は"],["御手","おて"],["の"],["中","なか"],["に"],["あり"],["、"],["また"],["その"],["御手","おて"],["を"],["もって"],["いかなる"],["もの"],["で"],["も"],["大いなる","おおいなる"],["者","もの"],["、"],["力","ちから"],["ある"],["者","もの"],["と"],["なさる"],["こと"],["が"],["できる"],["。"]]},{"verse":13,"text":"わたしたちの神よ、今こそわたしたちはあなたに感謝し、輝かしい御名を賛美します。","tok":[["わたしたち"],["の"],["神","かみ"],["よ"],["、"],["今","いま"],["こそ"],["わたしたち"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["、"],["輝かしい","かがやかしい"],["御名","ぎょめい"],["を"],["賛美","さんび"],["します"],["。"]]},{"verse":14,"text":"このような寄進ができるとしても、わたしなど果たして何者でしょう、わたしの民など何者でしょう。すべてはあなたからいただいたもの、わたしたちは御手から受け取って、差し出したにすぎません。","tok":[["この"],["よう"],["な"],["寄進","きしん"],["が"],["できる"],["として"],["も"],["、"],["わたし"],["など"],["果たして","はたして"],["何者","なにもの"],["でしょう"],["、"],["わたし"],["の"],["民","たみ"],["など"],["何者","なにもの"],["でしょう"],["。"],["すべて"],["は"],["あなた"],["から"],["いただいた"],["もの"],["、"],["わたしたち"],["は"],["御手","おて"],["から"],["受け取って","うけとって"],["、"],["差し出した","さしだした"],["に"],["すぎません"],["。"]]},{"verse":15,"text":"わたしたちは、わたしたちの先祖が皆そうであったように、あなたの御前では寄留民にすぎず、移住者にすぎません。この地上におけるわたしたちの人生は影のようなもので、希望はありません。","tok":[["わたしたち"],["は"],["、"],["わたしたち"],["の"],["先祖","せんぞ"],["が"],["皆","みな"],["そう"],["で"],["あった"],["よう"],["に"],["、"],["あなた"],["の"],["御前","ごぜん"],["で"],["は"],["寄留民","きりゅうみん"],["に"],["すぎず"],["、"],["移住者","いじゅうしゃ"],["に"],["すぎません"],["。"],["この"],["地上","ちじょう"],["に"],["おける"],["わたしたち"],["の"],["人生","じんせい"],["は"],["影","かげ"],["の"],["よう"],["な"],["もの"],["で"],["、"],["希望","きぼう"],["は"],["ありません"],["。"]]},{"verse":16,"text":"わたしたちの神、主よ、わたしたちがあなたの聖なる御名のために神殿を築こうとして準備したこの大量のものは、すべて御手によるもの、すべてはあなたのものです。","tok":[["わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["わたしたち"],["が"],["あなた"],["の"],["聖","せい"],["なる"],["御名","ぎょめい"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["築こう","きずこう"],["として"],["準備","じゅんび"],["した"],["この"],["大量","たいりょう"],["の"],["もの"],["は"],["、"],["すべて"],["御手","おて"],["に"],["よる"],["もの"],["、"],["すべて"],["は"],["あなた"],["の"],["もの"],["です"],["。"]]},{"verse":17,"text":"わたしの神よ、わたしはあなたが人の心を調べ、正しいものを喜ばれることを知っています。わたしは正しい心をもってこのすべてのものを寄進いたしました。また今、ここにいるあなたの民が寄進するのを、わたしは喜びながら見ました。","tok":[["わたし"],["の"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["あなた"],["が"],["人","ひと"],["の"],["心","こころ"],["を"],["調べ","しらべ"],["、"],["正しい","ただしい"],["もの"],["を"],["喜ばれる","よろこばれる"],["こと"],["を"],["知って","しって"],["います"],["。"],["わたし"],["は"],["正しい","ただしい"],["心","こころ"],["を"],["もって"],["この"],["すべて"],["の"],["もの"],["を"],["寄進","きしん"],["いたしました"],["。"],["また"],["今","いま"],["、"],["ここ"],["に"],["いる"],["あなた"],["の"],["民","たみ"],["が"],["寄進","きしん"],["する"],["の"],["を"],["、"],["わたし"],["は"],["喜び","よろこび"],["ながら"],["見ました","みました"],["。"]]},{"verse":18,"text":"わたしたちの先祖アブラハム、イサク、イスラエルの神、主よ、これをあなたの民の心の思い計ることとしてとこしえに御心に留め、民の心を確かにあなたに向かうものとしてください。","tok":[["わたしたち"],["の"],["先祖","せんぞ"],["アブラハム"],["、"],["イサク"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["これ"],["を"],["あなた"],["の"],["民","たみ"],["の"],["心","こころ"],["の"],["思い計る","おもいはかる"],["こと"],["として"],["とこしえ"],["に"],["御心","おこころ"],["に"],["留め","とめ"],["、"],["民","みん"],["の"],["心","こころ"],["を"],["確か","たしか"],["に"],["あなた"],["に"],["向かう","むかう"],["もの"],["として"],["ください"],["。"]]},{"verse":19,"text":"わが子ソロモンに全き心を与え、あなたの戒めと定めと掟を守って何事も行うようにし、わたしが準備した宮を築かせてください。」","tok":[["わが"],["子","こ"],["ソロモン"],["に"],["全","ぜん"],["き"],["心","こころ"],["を"],["与え","あたえ"],["、"],["あなた"],["の"],["戒め","いましめ"],["と"],["定め","さだめ"],["と"],["掟","おきて"],["を"],["守って","まもって"],["何事","なにごと"],["も"],["行う","おこなう"],["よう"],["に"],["し"],["、"],["わたし"],["が"],["準備","じゅんび"],["した"],["宮","みや"],["を"],["築かせて","きずかせて"],["ください"],["。"],["」"]]},{"verse":20,"text":"こうしてダビデが全会衆に、「あなたたちの神、主をほめたたえよ」と言うと、会衆は皆、先祖の神、主をほめたたえ、主の御前と王の前にひざまずいて拝した。","tok":[["こう"],["して"],["ダビデ"],["が"],["全","ぜん"],["会衆","かいしゅう"],["に"],["、"],["「"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["ほめたたえよ"],["」"],["と"],["言う","ゆう"],["と"],["、"],["会衆","かいしゅう"],["は"],["皆","みな"],["、"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["ほめたたえ"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["と"],["王","おう"],["の"],["前","まえ"],["に"],["ひざまずいて"],["拝した","はいした"],["。"]]},{"verse":21,"text":"その翌日、彼らは主にいけにえをささげ、焼き尽くす献げ物をささげた。雄牛千頭、雄羊千匹、小羊千匹、それにぶどう酒の献げ物もささげ、全イスラエルのために多くのいけにえをささげた。","tok":[["その"],["翌日","よくじつ"],["、"],["彼","かれ"],["ら"],["は"],["主に","おもに"],["いけにえ"],["を"],["ささげ"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげた"],["。"],["雄牛","おうし"],["千頭","せんとう"],["、"],["雄羊","おひつじ"],["千匹","せんひき"],["、"],["小羊","こひつじ"],["千匹","せんひき"],["、"],["それ"],["に"],["ぶどう酒","ぶどうしゅ"],["の"],["献げ物","ささげもの"],["も"],["ささげ"],["、"],["全","ぜん"],["イスラエル"],["の"],["ため"],["に"],["多く","おおく"],["の"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":22,"text":"その日、彼らは主の御前で大いに喜び祝って食べて飲み、ダビデの子ソロモンを改めて王と宣言し、油を注いで主のものとし君主とした。また、ツァドクを祭司とした。","tok":[["その"],["日","ひ"],["、"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["大いに","おおいに"],["喜び祝って","よろこびいわって"],["食べて","たべて"],["飲み","のみ"],["、"],["ダビデ"],["の"],["子","こ"],["ソロモン"],["を"],["改めて","あらためて"],["王","おう"],["と"],["宣言","せんげん"],["し"],["、"],["油","あぶら"],["を"],["注いで","そそいで"],["主","ぬし"],["の"],["もの"],["と"],["し"],["君主","くんしゅ"],["と"],["した"],["。"],["また"],["、"],["ツァドク"],["を"],["祭司","さいし"],["と"],["した"],["。"]]},{"verse":23,"text":"ソロモンは主の王座につき、父ダビデに代わって王となった。彼は栄え、全イスラエルが彼に従った。","tok":[["ソロモン"],["は"],["主","ぬし"],["の"],["王座","おうざ"],["に"],["つき"],["、"],["父","ちち"],["ダビデ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"],["彼","かれ"],["は"],["栄え","さかえ"],["、"],["全","ぜん"],["イスラエル"],["が"],["彼","かれ"],["に"],["従った","したがった"],["。"]]},{"verse":24,"text":"すべての将軍と勇士、ダビデ王のすべての王子がソロモン王に服従を誓って手を差し出した。","tok":[["すべて"],["の"],["将軍","しょうぐん"],["と"],["勇士","ゆうし"],["、"],["ダビデ"],["王","おう"],["の"],["すべて"],["の"],["王子","おうじ"],["が"],["ソロモン"],["王","おう"],["に"],["服従","ふくじゅう"],["を"],["誓って","ちかって"],["手","て"],["を"],["差し出した","さしだした"],["。"]]},{"verse":25,"text":"主はソロモンを全イスラエルの目の前にこの上もなく偉大な者とされ、かつてイスラエルに君臨したどの王にも見られなかった王者の威厳を帯びる者とされた。","tok":[["主","ぬし"],["は"],["ソロモン"],["を"],["全","ぜん"],["イスラエル"],["の"],["目","め"],["の"],["前","まえ"],["に"],["この"],["上","うえ"],["も"],["なく"],["偉大","いだい"],["な"],["者","もの"],["と"],["され"],["、"],["かつて"],["イスラエル"],["に"],["君臨","くんりん"],["した"],["どの"],["王","おう"],["に"],["も"],["見られなかった","みられなかった"],["王者","おうじゃ"],["の"],["威厳","いげん"],["を"],["帯びる","おびる"],["者","もの"],["と"],["された"],["。"]]},{"verse":26,"text":"エッサイの子ダビデは全イスラエルの王となった。","tok":[["エッサイ"],["の"],["子","こ"],["ダビデ"],["は"],["全","ぜん"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["。"]]},{"verse":27,"text":"彼がイスラエルの王であった期間は四十年に及んだ。ヘブロンで七年、エルサレムで三十三年間王位にあった。","tok":[["彼","かれ"],["が"],["イスラエル"],["の"],["王","おう"],["で"],["あった"],["期間","きかん"],["は"],["四十","よんじゅう"],["年","ねん"],["に"],["及んだ","およんだ"],["。"],["ヘブロン"],["で"],["七","なな"],["年","ねん"],["、"],["エルサレム"],["で"],["三十三","さんじゅうさん"],["年間","ねんかん"],["王位","おうい"],["に"],["あった"],["。"]]},{"verse":28,"text":"彼は高齢に達し、富と栄光に恵まれた人生に満足して死に、彼に代わって息子のソロモンが王となった。","tok":[["彼","かれ"],["は"],["高齢","こうれい"],["に"],["達し","たっし"],["、"],["富","とみ"],["と"],["栄光","えいこう"],["に"],["恵まれた","めぐまれた"],["人生","じんせい"],["に"],["満足","まんぞく"],["して"],["死に","しに"],["、"],["彼","かれ"],["に"],["代わって","かわって"],["息子","むすこ"],["の"],["ソロモン"],["が"],["王","おう"],["と"],["なった"],["。"]]},{"verse":29,"text":"ダビデ王の事績は、初期のことも後期のことも、『先見者サムエルの言葉』『預言者ナタンの言葉』、および『先見者ガドの言葉』に記されている。","tok":[["ダビデ"],["王","おう"],["の"],["事績","じせき"],["は"],["、"],["初期","しょき"],["の"],["こと"],["も"],["後期","こうき"],["の"],["こと"],["も"],["、"],["『"],["先見者","せんけんしゃ"],["サムエル"],["の"],["言葉","ことば"],["』"],["『"],["預言者","よげんしゃ"],["ナタン"],["の"],["言葉","ことば"],["』"],["、"],["および"],["『"],["先見者","せんけんしゃ"],["ガド"],["の"],["言葉","ことば"],["』"],["に"],["記されて","しるされて"],["いる"],["。"]]},{"verse":30,"text":"そこには彼の統治のすべてとその業績、また彼とイスラエル、およびすべての近隣諸国に起こった出来事の経過が記されている。","tok":[["そこ"],["に"],["は"],["彼","かれ"],["の"],["統治","とうち"],["の"],["すべて"],["と"],["その"],["業績","ぎょうせき"],["、"],["また"],["彼","かれ"],["と"],["イスラエル"],["、"],["および"],["すべて"],["の"],["近隣","きんりん"],["諸国","しょこく"],["に"],["起こった","おこった"],["出来事","できごと"],["の"],["経過","けいか"],["が"],["記されて","しるされて"],["いる"],["。"]]}]
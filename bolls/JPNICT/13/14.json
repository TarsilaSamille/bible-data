[{"verse":1,"text":"ティルスの王ヒラムは、ダビデのもとに使節を派遣し、王宮建設のためにレバノン杉、石工、大工を送ってきた。","tok":[["ティルス"],["の"],["王","おう"],["ヒラム"],["は"],["、"],["ダビデ"],["の"],["もと"],["に"],["使節","しせつ"],["を"],["派遣","はけん"],["し"],["、"],["王宮","おうきゅう"],["建設","けんせつ"],["の"],["ため"],["に"],["レバノン"],["杉","すぎ"],["、"],["石工","せっこう"],["、"],["大工","だいく"],["を"],["送って","おくって"],["きた"],["。"]]},{"verse":2,"text":"ダビデは、主が彼をイスラエルの王として揺るぎないものとされ、主の民イスラエルのために彼の王権を非常に高めてくださったことを悟った。","tok":[["ダビデ"],["は"],["、"],["主","ぬし"],["が"],["彼","かれ"],["を"],["イスラエル"],["の"],["王","おう"],["として"],["揺るぎない","ゆるぎない"],["もの"],["と"],["され"],["、"],["主","ぬし"],["の"],["民","みん"],["イスラエル"],["の"],["ため"],["に"],["彼","かれ"],["の"],["王権","おうけん"],["を"],["非常","ひじょう"],["に"],["高めて","たかめて"],["くださった"],["こと"],["を"],["悟った","さとった"],["。"]]},{"verse":3,"text":"ダビデはエルサレムでも妻をめとり、息子や娘が更に生まれた。","tok":[["ダビデ"],["は"],["エルサレム"],["で"],["も"],["妻","つま"],["を"],["めとり"],["、"],["息子","むすこ"],["や"],["娘","むすめ"],["が"],["更に","さらに"],["生まれた","うまれた"],["。"]]},{"verse":4,"text":"エルサレムで生まれたダビデの子供たちの名は次のとおりである。シャムア、ショバブ、ナタン、ソロモン、","tok":[["エルサレム"],["で"],["生まれた","うまれた"],["ダビデ"],["の"],["子供","こども"],["たち"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["シャムア"],["、"],["ショバブ"],["、"],["ナタン"],["、"],["ソロモン"],["、"]]},{"verse":5,"text":"イブハル、エリシュア、エルペレト、","tok":[["イブハル"],["、"],["エリシュア"],["、"],["エルペレト"],["、"]]},{"verse":6,"text":"ノガ、ネフェグ、ヤフィア、","tok":[["ノガ"],["、"],["ネフェグ"],["、"],["ヤフィア"],["、"]]},{"verse":7,"text":"エリシャマ、ベエルヤダ、エリフェレト。","tok":[["エリシャマ"],["、"],["ベエルヤダ"],["、"],["エリフェレト"],["。"]]},{"verse":8,"text":"ペリシテ人は、ダビデが油を注がれて全イスラエルの王となったことを聞いた。すべてのペリシテ人が、ダビデの命をねらって攻め上って来た。ダビデはこれを聞いて彼らに向かって出陣した。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["ダビデ"],["が"],["油","あぶら"],["を"],["注がれて","そそがれて"],["全","ぜん"],["イスラエル"],["の"],["王","おう"],["と"],["なった"],["こと"],["を"],["聞いた","きいた"],["。"],["すべて"],["の"],["ペリシテ"],["人","にん"],["が"],["、"],["ダビデ"],["の"],["命","いのち"],["を"],["ねらって"],["攻め上って","せめのぼって"],["来た","きた"],["。"],["ダビデ"],["は"],["これ"],["を"],["聞いて","きいて"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["出陣","しゅつじん"],["した"],["。"]]},{"verse":9,"text":"やって来たペリシテ人はレファイムの谷に侵入した。","tok":[["やって"],["来た","きた"],["ペリシテ"],["人","にん"],["は"],["レファイム"],["の"],["谷","たに"],["に"],["侵入","しんにゅう"],["した"],["。"]]},{"verse":10,"text":"ダビデは神に託宣を求めた。「ペリシテ人に向かって攻め上るべきでしょうか。彼らをこの手にお渡しくださるでしょうか。」主はダビデに答えられた。「攻め上れ。あなたの手に渡す。」","tok":[["ダビデ"],["は"],["神","かみ"],["に"],["託宣","たくせん"],["を"],["求めた","もとめた"],["。"],["「"],["ペリシテ"],["人","にん"],["に"],["向かって","むかって"],["攻め上るべきでしょう","せめのぼるべきでしょう"],["か"],["。"],["彼","かれ"],["ら"],["を"],["この"],["手","て"],["に"],["お渡し","おわたし"],["くださるでしょう"],["か"],["。"],["」"],["主","ぬし"],["は"],["ダビデ"],["に"],["答えられた","こたえられた"],["。"],["「"],["攻め上れ","せめのぼれ"],["。"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["」"]]},{"verse":11,"text":"彼らはバアル‧ペラツィムに攻め上り、ダビデは敵を討ち滅ぼして、こう言った。「神は敵をこの手で、水が堤防を破るように打ち破ってくださった。」その場所をバアル‧ペラツィム（破れ目の主）と呼ぶのは、このためである。","tok":[["彼","かれ"],["ら"],["は"],["バアル"],["‧"],["ペラツィム"],["に"],["攻め上り","せめのぼり"],["、"],["ダビデ"],["は"],["敵","てき"],["を"],["討ち滅ぼして","うちほろぼして"],["、"],["こう"],["言った","いった"],["。"],["「"],["神","かみ"],["は"],["敵","てき"],["を"],["この"],["手","て"],["で"],["、"],["水","みず"],["が"],["堤防","ていぼう"],["を"],["破る","やぶる"],["よう"],["に"],["打ち破って","うちやぶって"],["くださった"],["。"],["」"],["その"],["場所","ばしょ"],["を"],["バアル"],["‧"],["ペラツィム"],["（"],["破れ目","やぶれめ"],["の"],["主","ぬし"],["）"],["と"],["呼ぶ","よぶ"],["の"],["は"],["、"],["この"],["ため"],["で"],["ある"],["。"]]},{"verse":12,"text":"ペリシテ人が自分たちの神々をそこに捨てて行ったので、ダビデは命じて、それを火で焼かせた。","tok":[["ペリシテ"],["人","にん"],["が"],["自分","じぶん"],["たち"],["の"],["神々","かみがみ"],["を"],["そこ"],["に"],["捨てて","すてて"],["行った","いった"],["ので"],["、"],["ダビデ"],["は"],["命じて","めいじて"],["、"],["それ"],["を"],["火","ひ"],["で"],["焼かせた","やかせた"],["。"]]},{"verse":13,"text":"ペリシテ人は再び谷に侵入した。","tok":[["ペリシテ"],["人","にん"],["は"],["再び","ふたたび"],["谷","たに"],["に"],["侵入","しんにゅう"],["した"],["。"]]},{"verse":14,"text":"ダビデが再び神に託宣を求めると、神は次のように答えられた。「彼らを追って攻め上らず、彼らを避けて回り込め。バルサムの茂みの反対側から敵に向かえ。","tok":[["ダビデ"],["が"],["再び","ふたたび"],["神","かみ"],["に"],["託宣","たくせん"],["を"],["求める","もとめる"],["と"],["、"],["神","かみ"],["は"],["次","つぎ"],["の"],["よう"],["に"],["答えられた","こたえられた"],["。"],["「"],["彼","かれ"],["ら"],["を"],["追って","おって"],["攻め上らず","せめのぼらず"],["、"],["彼","かれ"],["ら"],["を"],["避けて","さけて"],["回り込め","まわりこめ"],["。"],["バルサム"],["の"],["茂み","しげみ"],["の"],["反対","はんたい"],["側","がわ"],["から"],["敵","てき"],["に"],["向かえ","むかえ"],["。"]]},{"verse":15,"text":"茂み越しに行軍の音を聞いたら、そのとき出て行って戦え。神がペリシテの陣営を討つために、あなたに先んじて出陣されるのだ。」","tok":[["茂み越し","しげみごし"],["に"],["行軍","こうぐん"],["の"],["音","おと"],["を"],["聞いたら","きいたら"],["、"],["その"],["とき"],["出て","でて"],["行って","いって"],["戦え","たたかえ"],["。"],["神","かみ"],["が"],["ペリシテ"],["の"],["陣営","じんえい"],["を"],["討つ","うつ"],["ため"],["に"],["、"],["あなた"],["に"],["先んじて","さきんじて"],["出陣","しゅつじん"],["される"],["の"],["だ"],["。"],["」"]]},{"verse":16,"text":"ダビデは神の命じられたとおりに行動し、彼らはギブオンからゲゼルに至るまで、ペリシテ人の陣営を討ち滅ぼした。","tok":[["ダビデ"],["は"],["神","かみ"],["の"],["命じられた","めいじられた"],["とおり"],["に"],["行動","こうどう"],["し"],["、"],["彼","かれ"],["ら"],["は"],["ギブオン"],["から"],["ゲゼル"],["に"],["至る","いたる"],["まで"],["、"],["ペリシテ"],["人","にん"],["の"],["陣営","じんえい"],["を"],["討ち滅ぼした","うちほろぼした"],["。"]]},{"verse":17,"text":"こうしてダビデの名声はすべての国々に及んだ。主は諸国の民が皆、彼を恐れるようにされた。","tok":[["こう"],["して"],["ダビデ"],["の"],["名声","めいせい"],["は"],["すべて"],["の"],["国々","くにぐに"],["に"],["及んだ","およんだ"],["。"],["主","ぬし"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["が"],["皆","みな"],["、"],["彼","かれ"],["を"],["恐れる","おそれる"],["よう"],["に"],["された"],["。"]]}]
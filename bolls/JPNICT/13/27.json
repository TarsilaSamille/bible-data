[{"verse":1,"text":"イスラエルの子らの数は次のとおりである。家系の長、千人隊と百人隊の長、役人たちは、王に仕えて、一年中どの月も、月ごとに交替する各組のあらゆる事柄に当たった。一組に二万四千人いた。","tok":[["イスラエル"],["の"],["子","こ"],["ら"],["の"],["数","かず"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["家系","かけい"],["の"],["長","ちょう"],["、"],["千人隊","せんにんたい"],["と"],["百人隊","ひゃくにんたい"],["の"],["長","ちょう"],["、"],["役人","やくにん"],["たち"],["は"],["、"],["王","おう"],["に"],["仕えて","つかえて"],["、"],["一","いち"],["年中","ねんちゅう"],["どの"],["月","つき"],["も"],["、"],["月","つき"],["ごと"],["に"],["交替","こうたい"],["する"],["各","かく"],["組","くみ"],["の"],["あらゆる"],["事柄","ことがら"],["に"],["当たった","あたった"],["。"],["一","いち"],["組","くみ"],["に"],["二万四千","にまんよんせん"],["人","にん"],["いた"],["。"]]},{"verse":2,"text":"第一の月を担当する第一の組を率いるのは、ザブディエルの子ヤショブアムであった。その組に二万四千人いた。","tok":[["第","だい"],["一","いち"],["の"],["月","つき"],["を"],["担当","たんとう"],["する"],["第","だい"],["一","いち"],["の"],["組","くみ"],["を"],["率いる","ひきいる"],["の"],["は"],["、"],["ザブディエル"],["の"],["子","こ"],["ヤショブアム"],["で"],["あった"],["。"],["その"],["組","くみ"],["に"],["二万四千","にまんよんせん"],["人","にん"],["いた"],["。"]]},{"verse":3,"text":"彼はペレツの子らの一人で、第一の月にかかわる全将軍の頭であった。","tok":[["彼","かれ"],["は"],["ペレツ"],["の"],["子","こ"],["ら"],["の"],["一人","ひとり"],["で"],["、"],["第","だい"],["一","いち"],["の"],["月","つき"],["に"],["かかわる"],["全","ぜん"],["将軍","しょうぐん"],["の"],["頭","あたま"],["で"],["あった"],["。"]]},{"verse":4,"text":"第二の月を担当する組を率いるのはアホアの人ドダイであった。その組と共に指導者ミクロトもいた。その組に二万四千人いた。","tok":[["第","だい"],["二","に"],["の"],["月","つき"],["を"],["担当","たんとう"],["する"],["組","くみ"],["を"],["率いる","ひきいる"],["の"],["は"],["アホア"],["の"],["人","ひと"],["ドダイ"],["で"],["あった"],["。"],["その"],["組","くみ"],["と"],["共","とも"],["に"],["指導者","しどうしゃ"],["ミクロト"],["も"],["いた"],["。"],["その"],["組","くみ"],["に"],["二万四千","にまんよんせん"],["人","にん"],["いた"],["。"]]},{"verse":5,"text":"第三の月を担当する第三の将軍は祭司長ヨヤダの子ベナヤ。その組に二万四千人いた。","tok":[["第","だい"],["三","さん"],["の"],["月","つき"],["を"],["担当","たんとう"],["する"],["第","だい"],["三","さん"],["の"],["将軍","しょうぐん"],["は"],["祭","まつり"],["司長","しちょう"],["ヨヤダ"],["の"],["子","こ"],["ベナヤ"],["。"],["その"],["組","くみ"],["に"],["二万四千","にまんよんせん"],["人","にん"],["いた"],["。"]]},{"verse":6,"text":"このベナヤは三十人隊の勇士
[{"verse":1,"text":"イスラエルの長男ルベンの子孫について。ルベンは長男であったが、父の寝床を汚したので、長子の権利を同じイスラエルの子ヨセフの子孫に譲らねばならなかった。そのため彼は長男として登録されてはいない。","tok":[["イスラエル"],["の"],["長男","ちょうなん"],["ルベン"],["の"],["子孫","しそん"],["について"],["。"],["ルベン"],["は"],["長男","ちょうなん"],["で"],["あった"],["が"],["、"],["父","ちち"],["の"],["寝床","ねどこ"],["を"],["汚した","よごした"],["ので"],["、"],["長子","ちょうし"],["の"],["権利","けんり"],["を"],["同じ","おなじ"],["イスラエル"],["の"],["子","こ"],["ヨセフ"],["の"],["子孫","しそん"],["に"],["譲らねば","ゆずらねば"],["ならなかった"],["。"],["その"],["ため"],["彼","かれ"],["は"],["長男","ちょうなん"],["として"],["登録","とうろく"],["されて"],["は"],["いない"],["。"]]},{"verse":2,"text":"彼の兄弟の中で最も勢力があったのはユダで、指導者もその子孫から出たが、長子の権利を得たのはヨセフである。","tok":[["彼","かれ"],["の"],["兄弟","きょうだい"],["の"],["中","なか"],["で"],["最も","もっとも"],["勢力","せいりょく"],["が"],["あった"],["の"],["は"],["ユダ"],["で"],["、"],["指導者","しどうしゃ"],["も"],["その"],["子孫","しそん"],["から"],["出た","でた"],["が"],["、"],["長子","ちょうし"],["の"],["権利","けんり"],["を"],["得た","えた"],["の"],["は"],["ヨセフ"],["で"],["ある"],["。"]]},{"verse":3,"text":"イスラエルの長男ルベンの子は、ハノク、パル、ヘツロン、カルミ。","tok":[["イスラエル"],["の"],["長男","ちょうなん"],["ルベン"],["の"],["子","こ"],["は"],["、"],["ハノク"],["、"],["パル"],["、"],["ヘツロン"],["、"],["カルミ"],["。"]]},{"verse":4,"text":"ヨエルの子孫は、息子がシェマヤ、孫がゴグ、更にシムイ、","tok":[["ヨエル"],["の"],["子孫","しそん"],["は"],["、"],["息子","むすこ"],["が"],["シェマヤ"],["、"],["孫","まご"],["が"],["ゴグ"],["、"],["更に","さらに"],["シムイ"],["、"]]},{"verse":5,"text":"ミカ、レアヤ、バアル、","tok":[["ミカ"],["、"],["レアヤ"],["、"],["バアル"],["、"]]},{"verse":6,"text":"ベエラと続く。このベエラはアッシリアの王ティグラト‧ピレセルによって捕囚として連れ去られた。彼はルベン族の首長であった。","tok":[["ベエラ"],["と"],["続く","つづく"],["。"],["この"],["ベエラ"],["は"],["アッシリア"],["の"],["王","おう"],["ティグラト"],["‧"],["ピレセル"],["によって"],["捕囚","ほしゅう"],["として"],["連れ去られた","つれさられた"],["。"],["彼","かれ"],["は"],["ルベン族","るべんぞく"],["の"],["首長","しゅちょう"],["で"],["あった"],["。"]]},{"verse":7,"text":"彼の兄弟は、その氏族の系図の登録によると、頭のエイエル、それにゼカルヤ、","tok":[["彼","かれ"],["の"],["兄弟","きょうだい"],["は"],["、"],["その"],["氏族","しぞく"],["の"],["系図","けいず"],["の"],["登録","とうろく"],["に"],["よる"],["と"],["、"],["頭","あたま"],["の"],["エイエル"],["、"],["それ"],["に"],["ゼカルヤ"],["、"]]},{"verse":8,"text":"ベラである。ベラは、父がアザズ、祖父がシェマ、更にヨエルとさかのぼる。ベラはアロエルに住んだが、ネボとバアル‧メオンにまで、","tok":[["ベラ"],["で"],["ある"],["。"],["ベラ"],["は"],["、"],["父","ちち"],["が"],["アザズ"],["、"],["祖父","そふ"],["が"],["シェマ"],["、"],["更に","さらに"],["ヨエル"],["と"],["さかのぼる"],["。"],["ベラ"],["は"],["アロエル"],["に"],["住んだ","すんだ"],["が"],["、"],["ネボ"],["と"],["バアル"],["‧"],["メオン"],["に"],["まで"],["、"]]},{"verse":9,"text":"また東はユーフラテス川から荒れ野の入り口に及ぶ地にも住んだ。彼らの家畜がギレアドの地で増えたからである。","tok":[["また"],["東","ひがし"],["は"],["ユーフラテス"],["川","かわ"],["から"],["荒れ野","あれの"],["の"],["入り口","いりぐち"],["に"],["及ぶ","およぶ"],["地","ち"],["に"],["も"],["住んだ","すんだ"],["。"],["彼","かれ"],["ら"],["の"],["家畜","かちく"],["が"],["ギレアド"],["の"],["地","ち"],["で"],["増えた","ふえた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"また彼らはサウルの時代にハガル人と戦い、その手で彼らを倒し、ギレアドの東の全域に天幕を張って住んだ。","tok":[["また"],["彼","かれ"],["ら"],["は"],["サウル"],["の"],["時代","じだい"],["に"],["ハガル人","はがるにん"],["と"],["戦い","たたかい"],["、"],["その"],["手","て"],["で"],["彼","かれ"],["ら"],["を"],["倒し","たおし"],["、"],["ギレアド"],["の"],["東","ひがし"],["の"],["全域","ぜんいき"],["に"],["天幕","てんまく"],["を"],["張って","はって"],["住んだ","すんだ"],["。"]]},{"verse":11,"text":"ガドの子孫は、ルベンの子孫に向かい合ってバシャンの地に住んで、サルカにまで及んだ。","tok":[["ガド"],["の"],["子孫","しそん"],["は"],["、"],["ルベン"],["の"],["子孫","しそん"],["に"],["向かい合って","むかいあって"],["バシャン"],["の"],["地","ち"],["に"],["住んで","すんで"],["、"],["サルカ"],["に"],["まで"],["及んだ","およんだ"],["。"]]},{"verse":12,"text":"その頭ヨエル、次のシャファム、更にヤナイとシャファトがバシャンにいた。","tok":[["その"],["頭","あたま"],["ヨエル"],["、"],["次","つぎ"],["の"],["シャファム"],["、"],["更に","さらに"],["ヤナイ"],["と"],["シャファト"],["が"],["バシャン"],["に"],["いた"],["。"]]},{"verse":13,"text":"その家系に属する兄弟はミカエル、メシュラム、シェバ、ヨライ、ヤカン、ジア、エベルの七人である。","tok":[["その"],["家系","かけい"],["に"],["属する","ぞくする"],["兄弟","きょうだい"],["は"],["ミカエル"],["、"],["メシュラム"],["、"],["シェバ"],["、"],["ヨライ"],["、"],["ヤカン"],["、"],["ジア"],["、"],["エベル"],["の"],["七人","しちにん"],["で"],["ある"],["。"]]},{"verse":14,"text":"これらはアビハイルの子孫である。このアビハイルの父はフリ、祖父はヤロア、更にギレアド、ミカエル、エシシャイ、ヤフド、ブズとさかのぼる。","tok":[["これ"],["ら"],["は"],["アビハイル"],["の"],["子孫","しそん"],["で"],["ある"],["。"],["この"],["アビハイル"],["の"],["父","ちち"],["は"],["フリ"],["、"],["祖父","そふ"],["は"],["ヤロア"],["、"],["更に","さらに"],["ギレアド"],["、"],["ミカエル"],["、"],["エシシャイ"],["、"],["ヤフド"],["、"],["ブズ"],["と"],["さかのぼる"],["。"]]},{"verse":15,"text":"グニの孫でアブディエルの子であるアヒ、彼がその家系の長であった。","tok":[["グニ"],["の"],["孫","まご"],["で"],["アブディエル"],["の"],["子","こ"],["で"],["ある"],["アヒ"],["、"],["彼","かれ"],["が"],["その"],["家系","かけい"],["の"],["長","ちょう"],["で"],["あった"],["。"]]},{"verse":16,"text":"彼らはギレアド、バシャン、その周辺の村落、更にシャロンの牧草地全域の隅々にまで住んでいた。","tok":[["彼","かれ"],["ら"],["は"],["ギレアド"],["、"],["バシャン"],["、"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["、"],["更に","さらに"],["シャロン"],["の"],["牧草地","ぼくそうち"],["全域","ぜんいき"],["の"],["隅々","すみずみ"],["に"],["まで"],["住んで","すんで"],["いた"],["。"]]},{"verse":17,"text":"彼らは皆、ユダの王ヨタムとイスラエルの王ヤロブアムの時代に登録された。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["ユダ"],["の"],["王","おう"],["ヨタム"],["と"],["イスラエル"],["の"],["王","おう"],["ヤロブアム"],["の"],["時代","じだい"],["に"],["登録","とうろく"],["された"],["。"]]},{"verse":18,"text":"ルベンとガドの子孫およびマナセの半部族は、盾と剣を取る者、弓を引く者、戦いに熟練した兵士から成る四万四千七百六十人の戦闘員を持っていた。","tok":[["ルベン"],["と"],["ガド"],["の"],["子孫","しそん"],["および"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["は"],["、"],["盾","たて"],["と"],["剣","けん"],["を"],["取る","とる"],["者","もの"],["、"],["弓","ゆみ"],["を"],["引く","ひく"],["者","もの"],["、"],["戦い","たたかい"],["に"],["熟練","じゅくれん"],["した"],["兵士","へいし"],["から"],["成る","なる"],["四万四千七百六","よんまんよんせんななひゃくろく"],["十人","じゅうにん"],["の"],["戦闘員","せんとういん"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":19,"text":"彼らはハガル人、エトル、ナフィシュ、ノダブの諸族と戦った。","tok":[["彼","かれ"],["ら"],["は"],["ハガル人","はがるにん"],["、"],["エトル"],["、"],["ナフィシュ"],["、"],["ノダブ"],["の"],["諸族","しょぞく"],["と"],["戦った","たたかった"],["。"]]},{"verse":20,"text":"彼らは戦いに際して神に助けを求め、その信頼のゆえに祈りは聞き入れられて敵に打ち勝つ助けを得、ハガル人とそのすべての援軍が彼らの手に渡された。","tok":[["彼","かれ"],["ら"],["は"],["戦い","たたかい"],["に"],["際して","さいして"],["神","かみ"],["に"],["助け","たすけ"],["を"],["求め","もとめ"],["、"],["その"],["信頼","しんらい"],["の"],["ゆえ"],["に"],["祈り","いのり"],["は"],["聞き入れられて","ききいれられて"],["敵","てき"],["に"],["打ち勝つ","うちかつ"],["助け","たすけ"],["を"],["得","え"],["、"],["ハガル人","はがるにん"],["と"],["その"],["すべて"],["の"],["援軍","えんぐん"],["が"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡さ
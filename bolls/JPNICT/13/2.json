[{"verse":1,"text":"イスラエルの子らは次のとおりである。ルベン、シメオン、レビ、ユダ、イサカル、ゼブルン、","tok":[["イスラエル"],["の"],["子","こ"],["ら"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ルベン"],["、"],["シメオン"],["、"],["レビ"],["、"],["ユダ"],["、"],["イサカル"],["、"],["ゼブルン"],["、"]]},{"verse":2,"text":"ダン、ヨセフ、ベニヤミン、ナフタリ、ガド、アシェル。","tok":[["ダン"],["、"],["ヨセフ"],["、"],["ベニヤミン"],["、"],["ナフタリ"],["、"],["ガド"],["、"],["アシェル"],["。"]]},{"verse":3,"text":"ユダの子エル、オナン、シェラの三人は、カナン人バト‧シュアを母として生まれた。ユダの長男エルは、主の御旨に背いたので、主は彼の命を絶たれた。","tok":[["ユダ"],["の"],["子","こ"],["エル"],["、"],["オナン"],["、"],["シェラ"],["の"],["三人","さんにん"],["は"],["、"],["カナン人","かなんにん"],["バト"],["‧"],["シュア"],["を"],["母","はは"],["として"],["生まれた","うまれた"],["。"],["ユダ"],["の"],["長男","ちょうなん"],["エル"],["は"],["、"],["主","ぬし"],["の"],["御旨","おむね"],["に"],["背いた","そむいた"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["の"],["命","いのち"],["を"],["絶たれた","たたれた"],["。"]]},{"verse":4,"text":"ユダの嫁タマルはユダの子ペレツとゼラを産んだ。ユダの子は皆で五人であった。","tok":[["ユダ"],["の"],["嫁","よめ"],["タマル"],["は"],["ユダ"],["の"],["子","こ"],["ペレツ"],["と"],["ゼラ"],["を"],["産んだ","うんだ"],["。"],["ユダ"],["の"],["子","こ"],["は"],["皆","みな"],["で"],["五人","ごにん"],["で"],["あった"],["。"]]},{"verse":5,"text":"ペレツの子は、ヘツロン、ハムル。","tok":[["ペレツ"],["の"],["子","こ"],["は"],["、"],["ヘツロン"],["、"],["ハムル"],["。"]]},{"verse":6,"text":"ゼラの子は、ジムリ、エタン、ヘマン、カルコル、ダラの五人。","tok":[["ゼラ"],["の"],["子","こ"],["は"],["、"],["ジムリ"],["、"],["エタン"],["、"],["ヘマン"],["、"],["カルコル"],["、"],["ダラ"],["の"],["五人","ごにん"],["。"]]},{"verse":7,"text":"カルミの子は、アカル。このアカル（災いをもたらす者）は、滅ぼし尽くしてささげるべきことに対して不誠実で、イスラエルに災いをもたらした。","tok":[["カルミ"],["の"],["子","こ"],["は"],["、"],["アカル"],["。"],["この"],["アカル"],["（"],["災い","わざわい"],["を"],["もたらす"],["者","もの"],["）"],["は"],["、"],["滅ぼし","ほろぼし"],["尽くして","つくして"],["ささげるべき"],["こと"],["に対して","にたいして"],["不誠実","ふせいじつ"],["で"],["、"],["イスラエル"],["に"],["災い","わざわい"],["を"],["もたらした"],["。"]]},{"verse":8,"text":"エタンの子は、アザルヤ。","tok":[["エタン"],["の"],["子","こ"],["は"],["、"],["アザルヤ"],["。"]]},{"verse":9,"text":"ヘツロンに生まれた子は、エラフメエル、ラム、ケルバイ。","tok":[["ヘツロン"],["に"],["生まれた","うまれた"],["子","こ"],["は"],["、"],["エラフメエル"],["、"],["ラム"],["、"],["ケルバイ"],["。"]]},{"verse":10,"text":"ラムにはアミナダブが生まれ、アミナダブにはナフションが生まれ、彼はユダ族の首長となった。","tok":[["ラム"],["に"],["は"],["アミナダブ"],["が"],["生まれ","うまれ"],["、"],["アミナダブ"],["に"],["は"],["ナフション"],["が"],["生まれ","うまれ"],["、"],["彼","かれ"],["は"],["ユダ族","ゆだぞく"],["の"],["首長","しゅちょう"],["と"],["なった"],["。"]]},{"verse":11,"text":"ナフションにはサルマが生まれ、サルマにはボアズが生まれ、","tok":[["ナフション"],["に"],["は"],["サルマ"],["が"],["生まれ","うまれ"],["、"],["サルマ"],["に"],["は"],["ボアズ"],["が"],["生まれ","うまれ"],["、"]]},{"verse":12,"text":"ボアズにはオベドが生まれ、オベドにはエッサイが生まれ、","tok":[["ボアズ"],["に"],["は"],["オベド"],["が"],["生まれ","うまれ"],["、"],["オベド"],["に"],["は"],["エッサイ"],["が"],["生まれ","うまれ"],["、"]]},{"verse":13,"text":"エッサイには長男エリアブ、次男アビナダブ、三男シムア、","tok":[["エッサイ"],["に"],["は"],["長男","ちょうなん"],["エリアブ"],["、"],["次男","じなん"],["アビナダブ"],["、"],["三男","さんなん"],["シムア"],["、"]]},{"verse":14,"text":"四男ネタンエル、五男ラダイ、","tok":[["四男","よんなん"],["ネタンエル"],["、"],["五男","ごなん"],["ラダイ"],["、"]]},{"verse":15,"text":"六男オツェム、七男ダビデが生まれた。","tok":[["六男","むつお"],["オツェム"],["、"],["七","なな"],["男","おとこ"],["ダビデ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":16,"text":"彼らの姉妹は、ツェルヤ、アビガイル。ツェルヤの子は、アブシャイ、ヨアブ、アサエルの三人。","tok":[["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["は"],["、"],["ツェルヤ"],["、"],["アビガイル"],["。"],["ツェルヤ"],["の"],["子","こ"],["は"],["、"],["アブシャイ"],["、"],["ヨアブ"],["、"],["アサエル"],["の"],["三人","さんにん"],["。"]]},{"verse":17,"text":"アビガイルはアマサを産んだ。アマサの父はイシュマエル人イエテルであった。","tok":[["アビガイル"],["は"],["アマサ"],["を"],["産んだ","うんだ"],["。"],["アマサ"],["の"],["父","ちち"],["は"],["イシュマエル"],["人","にん"],["イエテル"],["で"],["あった"],["。"]]},{"verse":18,"text":"ヘツロンの子カレブには、妻アズバとエリオトによって子が生まれたが、その子らがイエシェル、ショバブ、アルドンである。","tok":[["ヘツロン"],["の"],["子","こ"],["カレブ"],["に"],["は"],["、"],["妻","つま"],["アズバ"],["と"],["エリオト"],["によって"],["子","こ"],["が"],["生まれた","うまれた"],["が"],["、"],["その"],["子","こ"],["ら"],["が"],["イエシェル"],["、"],["ショバブ"],["、"],["アルドン"],["で"],["ある"],["。"]]},{"verse":19,"text":"アズバの死後、カレブはエフラトを妻とし、このエフラトはフルを産んだ。","tok":[["アズバ"],["の"],["死後","しご"],["、"],["カレブ"],["は"],["エフラト"],["を"],["妻","つま"],["と"],["し"],["、"],["この"],["エフラト"],["は"],["フル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":20,"text":"フルにはウリが生まれ、ウリにはベツァルエルが生まれた。","tok":[["フル"],["に"],["は"],["ウリ"],["が"],["生まれ","うまれ"],["、"],["ウリ"],["に"],["は"],["ベツァルエル"],["が"],["生まれた","うまれた"],["。"]]},{"verse":21,"text":"その後、ヘツロンはギレアドの父マキルの娘に近づき、これを妻としたが、そのとき彼は六十歳であった。この妻はセグブを産んだ。","tok":[["その"],["後","ご"],["、"],["ヘツロン"],["は"],["ギレアド"],["の"],["父","ちち"],["マキル"],["の"],["娘","むすめ"],["に"],["近づき","ちかづき"],["、"],["これ"],["を"],["妻","つま"],["と"],["した"],["が"],["、"],["その"],["とき"],["彼","かれ"],["は"],["六十歳","ろくじゅうさい"],["で"],["あった"],["。"],["この"],["妻","つま"],["は"],["セグブ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":22,"text":"セグブにはヤイルが生まれた。ヤイルはギレアドの地に二十三の町を所有した。","tok":[["セグブ"],["に"],["は"],["ヤイル"],["が"],["生まれた","うまれた"],["。"],["ヤイル"],["は"],["ギレアド"],["の"],["地","ち"],["に"],["二十三","にじゅうさん"],["の"],["町","まち"],["を"],["所有","しょゆう"],["した"],["。"]]},{"verse":23,"text":"ただし、ゲシュルとアラムが、ハボト‧ヤイル、ケナトとその周辺の村落である六十の町を奪った。これらは皆、ギレアドの父マキルの子孫である。","tok":[["ただし"],["、"],["ゲシュル"],["と"],["アラム"],["が"],["、"],["ハボト"],["‧"],["ヤイル"],["、"],["ケナト"],["と"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["で"],["ある"],["六十","ろくじゅう"],["の"],["町","まち"],["を"],["奪った","うばった"],["。"],["これ"],["ら"],["は"],["皆","みな"],["、"],["ギレアド"],["の"],["父","ちち"],["マキル"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":24,"text":"ヘツロンの死後、カレブは自分の父ヘツロンの妻エフラタと結婚し、エフラタはテコアの父アシュフルを産んだ。","tok":[["ヘツロン"],["の"],["死後","しご"],["、"],["カレブ"],["は"],["自分","じぶん"],["の"],["父","ちち"],["ヘツロン"],["の"],["妻","つま"],["エフラタ"],["と"],["結婚","けっこん"],["し"],["、"],["エフラタ"],["は"],["テコア"],["の"],["父","ちち"],["アシュフル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":25,"text":"ヘツロンの長男エラフメエルの子は、長男ラム、ブナ、オレン、オツェム、アヒヤ。","tok":[["ヘツロン"],["の"],["長男","ちょうなん"],["エラフメエル"],["の"],["子","こ"],["は"],["、"],["長男","ちょうなん"],["ラム"],["、"],["ブナ"],["、"],["オレン"],["、"],["オツェム"],["、"],["アヒヤ"],["。"]]},{"verse":26,"text":"またエラフメエルには、アタラという名の妻がほかにいて、これがオナムの母である。","tok":[["また"],["エラフメエル"],["に"],["は"],["、"],["アタラ"],["と"],["いう"],["名","な"],["の"],["妻","つま"],["が"],["ほか"],["に"],["いて"],["、"],["これ"],["が"],["オナム"],["の"],["母","はは"],["で"],["ある"],["。"]]},{"verse":27,"text":"エラフメエルの長男ラムの子は、マアツ、ヤミン、エケル。","tok":[["エラフメエル"],["の"],["長男","ちょうなん"],["ラム"],["の"],["子","こ"],["は"],["、"],["マアツ"],["、"],["ヤミン"],["、"],["エケル"],["。"]]},{"verse":28,"text":"オナムの子は、シャマイ、ヤダ。シャマイの子は、ナダブ、アビシュル。","tok":[["オナム"],["の"],["子","こ"],["は"],["、"],["シャマイ"],["、"],["ヤダ"],["。"],["シャマイ"],["の"],["子","こ"],["は"],["、"],["ナダブ"],["、"],["アビシュル"],["。"]]},{"verse":29,"text":"アビシュルの妻の名はアビハイルで、彼女はアフバンとモリドを産んだ。","tok":[["アビシュル"],["の"],["妻","つま"],["の"],["名","な"],["は"],["アビハイル"],["で"],["、"],["彼女","かのじょ"],["は"],["アフバン"],["と"],["モリド"],["を"],["産んだ","うんだ"],["。"]]},{"verse":30,"text":"ナダブの子は、セレド、アパイム。セレドは子を持つことなく死んだ。","tok":[["ナダブ"],["の"],["子","こ"],["は"],["、"],["セレド"],["、"],["アパイム"],["。"],["セレド"],["は"],["子","こ"],["を"],["持つ","もつ"],["こと"],["なく"],["死んだ","しんだ"],["。"]]},{"verse":31,"text":"アパイムの子孫は息子がイシュイ、孫がシェシャン、更にアフライと続く。","tok":[["アパイム"],["の"],["子孫","しそん"],["は"],["息子","むすこ"],["が"],["イシュイ"],["、"],["孫","まご"],["が"],["シェシャン"],["、"],["更に","さらに"],["アフライ"],["と"],["続く","つづく"],["。"]]},{"verse":32,"text":"シャマイの兄弟ヤダの子は、イエテル、ヨナタン。イエテルは子を持つことなく死んだ。","tok":[["シャマイ"],["の"],["兄弟","きょうだい"],["ヤダ"],["の"],["子","こ"],["は"],["、"],["イエテル"],["、"],["ヨナタン"],["。"],["イエテル"],["は"],["子","こ"],["を"],["持つ","もつ"],["こと"],["なく"],["死んだ","しんだ"],["。"]]},{"verse":33,"text":"ヨナタンの子は、ペレト、ザザ。これらがエラフメエルの子孫である。","tok":[["ヨナタン"],["の"],["子","こ"],["は"],["、"],["ペレト"],["、"],["ザザ"],["。"],["これ"],["ら"],["が"],["エラフメエル"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]},{"verse":34,"text":"シェシャンには息子がなく、娘だけがいた。彼にはヤルハという名のエジプト人の召し使いがいて、","tok":[["シェシャン"],["に"],["は"],["息子","むすこ"],["が"],["なく"],["、"],["娘","むすめ"],["だけ"],["が"],["いた"],["。"],["彼","かれ"],["に"],["は"],["ヤルハ"],["と"],["いう"],["名","な"],["の"],["エジプト"],["人","にん"],["の"],["召し使い","めしつかい"],["が"],["いて"],["、"]]},{"verse":35,"text":"この召し使いヤルハに、彼は娘を妻として与えた。こうして娘はアタイを産んだ。","tok":[["この"],["召し使い","めしつかい"],["ヤルハ"],["に"],["、"],["彼","かれ"],["は"],["娘","むすめ"],["を"],["妻","つま"],["として"],["与えた","あたえた"],["。"],["こう"],["して"],["娘","むすめ"],["は"],["アタイ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":36,"text":"アタイにはナタンが生まれ、ナタンにはザバドが生まれ、","tok":[["アタイ"],["に"],["は"],["ナタン"],["が"],["生まれ","うまれ"],["、"],["ナタン"],["に"],["は"],["ザバド"],["が"],["生まれ","うまれ"],["、"]]},{"verse":37,"text":"ザバドにはエフラルが生まれ、エフラルにはオベドが生まれ、","tok":[["ザバド"],["に"],["は"],["エフラル"],["が"],["生まれ","うまれ"],["、"],["エフラル"],["に"],["は"],["オベド"],["が"],["生まれ","うまれ"],["、"]]},{"verse":38,"text":"オベドにはイエフが生まれ、イエフにはアザルヤが生まれ、","tok":[["オベド"],["に"],["は"],["イエフ"],["が"],["生まれ","うまれ"],["、"],["イエフ"],["に"],["は"],["アザルヤ"],["が"],["生まれ","うまれ"],["、"]]},{"verse":39,"text":"アザルヤにはヘレツが生まれ、ヘレツにはエルアサが生まれ、","tok":[["アザルヤ"],["に"],["は"],["ヘレツ"],["が"],["生まれ","うまれ"],["、"],["ヘレツ"],["に"],["は"],["エルアサ"],["が"],["生まれ","うまれ"],["、"]]},{"verse":40,"text":"エルアサにはシスマイが生まれ、シスマイにはシャルムが生まれ、","tok":[["エルアサ"],["に"],["は"],["シスマイ"],["が"],["生まれ","うまれ"],["、"],["シスマイ"],["に"],["は"],["シャルム"],["が"],["生まれ","うまれ"],["、"]]},{"verse":41,"text":"シャルムにはエカムヤが生まれ、エカムヤにはエリシャマが生まれた。","tok":[["シャルム"],["に"],["は"],["エカムヤ"],["が"],["生まれ","うまれ"],["、"],["エカムヤ"],["に"],["は"],["エリシャマ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":42,"text":"エラフメエルの兄弟カレブの子は、長男がメシャであって、メシャはジフの父である。次男はマレシャで、ヘブロンの父である。","tok":[["エラフメエル"],["の"],["兄弟","きょうだい"],["カレブ"],["の"],["子","こ"],["は"],["、"],["長男","ちょうなん"],["が"],["メシャ"],["で"],["あって"],["、"],["メシャ"],["は"],["ジフ"],["の"],["父","ちち"],["で"],["ある"],["。"],["次男","じなん"],["は"],["マレシャ"],["で"],["、"],["ヘブロン"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":43,"text":"ヘブロンの子は、コラ、タプア、レケム、シェマ。","tok":[["ヘブロン"],["の"],["子","こ"],["は"],["、"],["コラ"],["、"],["タプア"],["、"],["レケム"],["、"],["シェマ"],["。"]]},{"verse":44,"text":"シェマにはヨルコアムの父ラハムが生まれ、レケムにはシャマイが生まれた。","tok":[["シェマ"],["に"],["は"],["ヨルコアム"],["の"],["父","ちち"],["ラハム"],["が"],["生まれ","うまれ"],["、"],["レケム"],["に"],["は"],["シャマイ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":45,"text":"シャマイの子はマオンで、マオンはベト‧ツルの父である。","tok":[["シャマイ"],["の"],["子","こ"],["は"],["マオン"],["で"],["、"],["マオン"],["は"],["ベト"],["‧"],["ツル"],["の"],["父","ちち"],["で"],["ある"],["。"]]},{"verse":46,"text":"カレブの側女エファは、ハラン、モツァ、ガゼズを産んだ。ハランにはガゼズが生まれた。","tok":[["カレブ"],["の"],["側女","そばめ"],["エファ"],["は"],["、"],["ハラン"],["、"],["モツァ"],["、"],["ガゼズ"],["を"],["産んだ","うんだ"],["。"],["ハラン"],["に"],["は"],["ガゼズ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":47,"text":"ヤフダイの子は、レゲム、ヨタム、ゲシャン、ペレト、エファ、シャアフ。","tok":[["ヤフダイ"],["の"],["子","こ"],["は"],["、"],["レゲム"],["、"],["ヨタム"],["、"],["ゲシャン"],["、"],["ペレト"],["、"],["エファ"],["、"],["シャアフ"],["。"]]},{"verse":48,"text":"カレブの側女マアカは、シェベルとティルハナを産んだ。","tok":[["カレブ"],["の"],["側女","そばめ"],["マアカ"],["は"],["、"],["シェベル"],["と"],["ティルハナ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":49,"text":"また彼女はマドマナの父シャアフ、マクベナの父でありギブアの父であるシェワを産んだ。カレブの娘はアクサである。","tok":[["また"],["彼女","かのじょ"],["は"],["マドマナ"],["の"],["父","ちち"],["シャアフ"],["、"],["マクベナ"],["の"],["父","ちち"],["で"],["あり"],["ギブア"],["の"],["父","ちち"],["で"],["ある"],["シェワ"],["を"],["産んだ","うんだ"],["。"],["カレブ"],["の"],["娘","むすめ"],["は"],["アクサ"],["で"],["ある"],["。"]]},{"verse":50,"text":"これらもカレブの子孫である。エフラタの長男フルの子は、キルヤト‧エアリムの父ショバル、","tok":[["これ"],["ら"],["も"],["カレブ"],["の"],["子孫","しそん"],["で"],["ある"],["。"],["エフラタ"],["の"],["長男","ちょうなん"],["フル"],["の"],["子","こ"],["は"],["、"],["キルヤト"],["‧"],["エアリム"],["の"],["父","ちち"],["ショバル"],["、"]]},{"verse":51,"text":"ベツレヘムの父サルマ、ベト‧ガデルの父ハレフ。","tok":[["ベツレヘム"],["の"],["父","ちち"],["サルマ"],["、"],["ベト"],["‧"],["ガデル"],["の"],["父","ちち"],["ハレフ"],["。"]]},{"verse":52,"text":"キルヤト‧エアリムの父ショバルの子らは、ハロエ、メヌホトの住民の半数。","tok":[["キルヤト"],["‧"],["エアリム"],["の"],["父","ちち"],["ショバル"],["の"],["子","こ"],["ら"],["は"],["、"],["ハロエ"],["、"],["メヌホト"],["の"],["住民","じゅうみん"],["の"],["半数","はんすう"],["。"]]},{"verse":53,"text":"キルヤト‧エアリムの氏族イエテル、プティ、シュマ、ミシュライ。これらからツォルアとエシュタオルの氏族が出た。","tok":[["キルヤト"],["‧"],["エアリム"],["の"],["氏族","しぞく"],["イエテル"],["、"],["プティ"],["、"],["シュマ"],["、"],["ミシュライ"],["。"],["これ"],["ら"],["から"],["ツォルア"],["と"],["エシュタオル"],["の"],["氏族","しぞく"],["が"],["出た","でた"],["。"]]},{"verse":54,"text":"サルマの子らは、ベツレヘム、ネトファの住民、アトロト‧ベト‧ヨアブ、マナフティの住民の半数、ツォルアの住民、","tok":[["サルマ"],["の"],["子","こ"],["ら"],["は"],["、"],["ベツレヘム"],["、"],["ネトファ"],["の"],["住民","じゅうみん"],["、"],["アトロト"],["‧"],["ベト"],["‧"],["ヨアブ"],["、"],["マナフティ"],["の"],["住民","じゅうみん"],["の"],["半数","はんすう"],["、"],["ツォルア"],["の"],["住民","じゅうみん"],["、"]]},{"verse":55,"text":"ヤベツに住んでいたセフェルの氏族ティルアティム、シムアティム、スカティム。これらは、
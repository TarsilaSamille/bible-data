[{"verse":1,"text":"ベニヤミンには、長男ベラ、次男アシュベル、三男アフラ、","tok":[["ベニヤミン"],["に"],["は"],["、"],["長男","ちょうなん"],["ベラ"],["、"],["次男","じなん"],["アシュベル"],["、"],["三男","さんなん"],["アフラ"],["、"]]},{"verse":2,"text":"四男ノハ、五男ラファが生まれた。","tok":[["四男","よんなん"],["ノハ"],["、"],["五男","いつお"],["ラファ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":3,"text":"ベラの子は、アダル、ゲラ、アビフド、","tok":[["ベラ"],["の"],["子","こ"],["は"],["、"],["アダル"],["、"],["ゲラ"],["、"],["アビフド"],["、"]]},{"verse":4,"text":"アビシュア、ナアマン、アホア、","tok":[["アビシュア"],["、"],["ナアマン"],["、"],["アホア"],["、"]]},{"verse":5,"text":"ゲラ、シェフファン、フラム。","tok":[["ゲラ"],["、"],["シェフ"],["ファン"],["、"],["フラム"],["。"]]},{"verse":6,"text":"エフドの子はゲバの住民の家系の長、ナアマン、アヒヤ、ゲラである。その住民はマナハトに移された。彼らを移したのはゲラで、彼にはウザとアヒフドが生まれた。","tok":[["エフド"],["の"],["子","こ"],["は"],["ゲバ"],["の"],["住民","じゅうみん"],["の"],["家系","かけい"],["の"],["長","ちょう"],["、"],["ナアマン"],["、"],["アヒヤ"],["、"],["ゲラ"],["で"],["ある"],["。"],["その"],["住民","じゅうみん"],["は"],["マナハト"],["に"],["移された","うつされた"],["。"],["彼","かれ"],["ら"],["を"],["移した","うつした"],["の"],["は"],["ゲラ"],["で"],["、"],["彼","かれ"],["に"],["は"],["ウザ"],["と"],["アヒフド"],["が"],["生まれた","うまれた"],["。"]]},{"verse":8,"text":"シャハライムには、妻のフシムとバアラを追い出した後、モアブの野で子が生まれた。","tok":[["シャハ"],["ライム"],["に"],["は"],["、"],["妻","つま"],["の"],["フシム"],["と"],["バアラ"],["を"],["追い出した","おいだした"],["後","あと"],["、"],["モアブ"],["の"],["野","の"],["で"],["子","こ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":9,"text":"すなわち、妻のホデシュがヨバブ、ツィブヤ、メシャ、マルカム、","tok":[["すなわち"],["、"],["妻","つま"],["の"],["ホデシュ"],["が"],["ヨバブ"],["、"],["ツィブヤ"],["、"],["メシャ"],["、"],["マルカム"],["、"]]},{"verse":10,"text":"エウツ、サケヤ、ミルマを産んだ。これらはシャハライムの子で、家系の長となった者である。","tok":[["エウツ"],["、"],["サケヤ"],["、"],["ミルマ"],["を"],["産んだ","うんだ"],["。"],["これ"],["ら"],["は"],["シャハ"],["ライム"],["の"],["子","こ"],["で"],["、"],["家系","かけい"],["の"],["長","ちょう"],["と"],["なった"],["者","もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"フシムはアビトブとエルパアルを産んだ。","tok":[["フシム"],["は"],["アビトブ"],["と"],["エルパアル"],["を"],["産んだ","うんだ"],["。"]]},{"verse":12,"text":"エルパアルの子は、エベル、ミシュアム、シェメド。この人はオノとロドおよびその周辺の村落を建てた。","tok":[["エルパアル"],["の"],["子","こ"],["は"],["、"],["エベル"],["、"],["ミシュアム"],["、"],["シェメド"],["。"],["この"],["人","ひと"],["は"],["オノ"],["と"],["ロド"],["および"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["を"],["建てた","たてた"],["。"]]},{"verse":13,"text":"ベリアとシェマは、アヤロンの住民の家系の長である。彼らはガトの住民を追い払った。","tok":[["ベリア"],["と"],["シェマ"],["は"],["、"],["アヤロン"],["の"],["住民","じゅうみん"],["の"],["家系","かけい"],["の"],["長","ちょう"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["ガト"],["の"],["住民","じゅうみん"],["を"],["追い払った","おいはらった"],["。"]]},{"verse":14,"text":"彼らの兄弟は、シャシャク、エレモト。","tok":[["彼","かれ"],["ら"],["の"],["兄弟","きょうだい"],["は"],["、"],["シャシャク"],["、"],["エレモト"],["。"]]},{"verse":15,"text":"ゼバドヤ、アラド、エデル、","tok":[["ゼバドヤ"],["、"],["アラド"],["、"],["エデル"],["、"]]},{"verse":16,"text":"ミカエル、イシュパ、ヨハはベリアの子である。","tok":[["ミカエル"],["、"],["イシュパ"],["、"],["ヨハ"],["は"],["ベリア"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":17,"text":"ゼバドヤ、メシュラム、ヒズキ、ヘベル、","tok":[["ゼバドヤ"],["、"],["メシュラム"],["、"],["ヒズキ"],["、"],["ヘベル"],["、"]]},{"verse":18,"text":"イシュメライ、イズリア、ヨバブはエルパアルの子である。","tok":[["イシュメライ"],["、"],["イズリア"],["、"],["ヨバブ"],["は"],["エルパアル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":19,"text":"ヤキム、ジクリ、ザブディ、","tok":[["ヤキム"],["、"],["ジクリ"],["、"],["ザブディ"],["、"]]},{"verse":20,"text":"エリエナイ、ツィレタイ、エリエル、","tok":[["エリエナイ"],["、"],["ツィレタイ"],["、"],["エリエル"],["、"]]},{"verse":21,"text":"アダヤ、ベラヤ、シムラトはシェマの子である。","tok":[["アダヤ"],["、"],["ベラヤ"],["、"],["シムラト"],["は"],["シェマ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":22,"text":"イシュパン、エベル、エリエル、","tok":[["イシュパン"],["、"],["エベル"],["、"],["エリエル"],["、"]]},{"verse":23,"text":"アブドン、ジクリ、ハナン、","tok":[["アブドン"],["、"],["ジクリ"],["、"],["ハナン"],["、"]]},{"verse":24,"text":"ハナンヤ、エラム、アントティヤ、","tok":[["ハナンヤ"],["、"],["エラム"],["、"],["アントティヤ"],["、"]]},{"verse":25,"text":"イフデヤ、ペヌエルはシャシャクの子である。","tok":[["イフデヤ"],["、"],["ペヌエル"],["は"],["シャシャク"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":26,"text":"シャムシェライ、シェハルヤ、アタルヤ、","tok":[["シャムシェライ"],["、"],["シェハルヤ"],["、"],["アタルヤ"],["、"]]},{"verse":27,"text":"ヤアレシュヤ、エリヤ、ジクリはエロハムの子である。","tok":[["ヤアレシュヤ"],["、"],["エリヤ"],["、"],["ジクリ"],["は"],["エロハム"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":28,"text":"彼らは、系図に記された家系の長たちである。この家系の長たちはエルサレムに住んだ。","tok":[["彼","かれ"],["ら"],["は"],["、"],["系図","けいず"],["に"],["記された","しるされた"],["家系","かけい"],["の"],["長","なが"],["たち"],["で"],["ある"],["。"],["この"],["家系","かけい"],["の"],["長","なが"],["たち"],["は"],["エルサレム"],["に"],["住んだ","すんだ"],["。"]]},{"verse":29,"text":"ギブオンにはギブオンの父が住み、妻の名はマアカといった。","tok":[["ギブオン"],["に"],["は"],["ギブオン"],["の"],["父","ちち"],["が"],["住み","すみ"],["、"],["妻","つま"],["の"],["名","な"],["は"],["マアカ"],["と"],["いった"],["。"]]},{"verse":30,"text":"その子は、長男アブドン、更にツル、キシュ、バアル、ナダブ、","tok":[["その"],["子","こ"],["は"],["、"],["長男","ちょうなん"],["アブドン"],["、"],["更に","さらに"],["ツル"],["、"],["キシュ"],["、"],["バアル"],["、"],["ナダブ"],["、"]]},{"verse":31,"text":"ゲドル、アフヨ、ゼケル。","tok":[["ゲドル"],["、"],["アフヨ"],["、"],["ゼケル"],["。"]]},{"verse":32,"text":"ミクロトにはシムアが生まれた。彼らもその兄弟たちの傍らで共にエルサレムに住んだ。","tok":[["ミクロト"],["に"],["は"],["シムア"],["が"],["生まれた","うまれた"],["。"],["彼","かれ"],["ら"],["も"],["その"],["兄弟","きょうだい"],["たち"],["の"],["傍ら","かたわら"],["で"],["共","とも"],["に"],["エルサレム"],["に"],["住んだ","すんだ"],["。"]]},{"verse":33,"text":"ネルにはキシュが生まれ、キシュにはサウルが生まれ、サウルにはヨナタン、マルキ‧シュア、アビナダブ、エシュバアルが生まれた。","tok":[["ネル"],["に"],["は"],["キシュ"],["が"],["生まれ","うまれ"],["、"],["キシュ"],["に"],["は"],["サウル"],["が"],["生まれ","うまれ"],["、"],["サウル"],["に"],["は"],["ヨナタン"],["、"],["マルキ"],["‧"],["シュア"],["、"],["アビナダブ"],["、"],["エシュバアル"],["が"],["生まれた","うまれた"],["。"]]},{"verse":34,"text":"ヨナタンの子は、メリブ‧バアル。メリブ‧バアルにはミカが生まれた。","tok":[["ヨナタン"],["の"],["子","こ"],["は"],["、"],["メリブ"],["‧"],["バアル"],["。"],["メリブ"],["‧"],["バアル"],["に"],["は"],["ミカ"],["が"],["生まれた","うまれた"],["。"]]},{"verse":35,"text":"ミカの子は、ピトン、メレク、タレア、アハズ。","tok":[["ミカ"],["の"],["子","こ"],["は"],["、"],["ピトン"],["、"],["メレク"],["、"],["タレア"],["、"],["アハズ"],["。"]]},{"verse":36,"text":"アハズにはヨアダが生まれ、ヨアダにはアレメト、アズマベト、ジムリが生まれ、ジムリにはモツァが生まれ、","tok":[["アハズ"],["に"],["は"],["ヨアダ"],["が"],["生まれ","うまれ"],["、"],["ヨアダ"],["に"],["は"],["アレメト"],["、"],["アズマベト"],["、"],["ジムリ"],["が"],["生まれ","うまれ"],["、"],["ジムリ"],["に"],["は"],["モツァ"],["が"],["生まれ","うまれ"],["、"]]},{"verse":37,"text":"モツァにはビンアが生まれた。その子は、ラファ、孫はエルアサ、ひ孫はアツェル。","tok":[["モツァ"],["に"],["は"],["ビンア"],["が"],["生まれた","うまれた"],["。"],["その"],["子","こ"],["は"],["、"],["ラファ"],["、"],["孫","まご"],["は"],["エルアサ"],["、"],["ひ孫","ひまご"],["は"],["アツェル"],["。"]]},{"verse":38,"text":"アツェルには六人の子があり、その名はアズリカム、ボクル、イシュマエル、シェアルヤ、オバドヤ、ハナンである。彼らは皆アツェルの子である。","tok":[["アツェル"],["に"],["は"],["六人","ろくにん"],["の"],["子","こ"],["が"],["あり"],["、"],["その"],["名","な"],["は"],["アズリカム"],["、"],["ボクル"],["、"],["イシュマエル"],["、"],["シェアルヤ"],["、"],["オバドヤ"],["、"],["ハナン"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["アツェル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":39,"text":"アツェルの兄弟エシェクの子は、長男ウラム、次男エウシュ、三男エリフェレト。","tok":[["アツェル"],["の"],["兄弟","きょうだい"],["エシェク"],["の"],["子","こ"],["は"],["、"],["長男","ちょうなん"],["ウラム"],["、"],["次男","じなん"],["エウシュ"],["、"],["三男","さんなん"],["エリフェレト"],["。"]]},{"verse":40,"text":"ウラムの子らは、弓を引く勇士となり、多くの子と孫に恵まれ、その数は百五十人に達した。彼らは皆ベニヤミンの子孫である。","tok":[["ウラム"],["の"],["子","こ"],["ら"],["は"],["、"],["弓","ゆみ"],["を"],["引く","ひく"],["勇士","ゆうし"],["と"],["なり"],["、"],["多く","おおく"],["の"],["子","こ"],["と"],["孫","まご"],["に"],["恵まれ","めぐまれ"],["、"],["その"],["数","すう"],["は"],["百五","ひゃくご"],["十人","じゅうにん"],["に"],["達した","たっした"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["ベニヤミン"],["の"],["子孫","しそん"],["で"],["ある"],["。"]]}]
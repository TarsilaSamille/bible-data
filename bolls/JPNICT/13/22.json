[{"verse":1,"text":"そこでダビデは言った。「神なる主の神殿はここにこそあるべきだ。イスラエルのために焼き尽くす献げ物をささげる祭壇は、ここにこそあるべきだ。」","tok":[["そこ"],["で"],["ダビデ"],["は"],["言った","いった"],["。"],["「"],["神","かみ"],["なる"],["主","ぬし"],["の"],["神殿","しんでん"],["は"],["ここ"],["に"],["こそ"],["あるべきだ"],["。"],["イスラエル"],["の"],["ため"],["に"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげる"],["祭壇","さいだん"],["は"],["、"],["ここ"],["に"],["こそ"],["あるべきだ"],["。"],["」"]]},{"verse":2,"text":"ダビデは、イスラエル国内の寄留民を集めるよう命じ、彼らを神殿造営に必要な切り石を切り出すための採石労働者に任じた。","tok":[["ダビデ"],["は"],["、"],["イスラエル"],["国内","こくない"],["の"],["寄留民","きりゅうみん"],["を"],["集める","あつめる"],["よう"],["命じ","めいじ"],["、"],["彼","かれ"],["ら"],["を"],["神殿","しんでん"],["造営","ぞうえい"],["に"],["必要","ひつよう"],["な"],["切り石","きりいし"],["を"],["切り出す","きりだす"],["ため"],["の"],["採石","さいせき"],["労働者","ろうどうしゃ"],["に"],["任じた","にんじた"],["。"]]},{"verse":3,"text":"ダビデはまた門の扉の釘とちょうつがいを造るために鉄を大量に準備した。青銅もおびただしく、量ることができず、","tok":[["ダビデ"],["は"],["また"],["門","もん"],["の"],["扉","とびら"],["の"],["釘","くぎ"],["と"],["ちょうつがい"],["を"],["造る","つくる"],["ため"],["に"],["鉄","てつ"],["を"],["大量","たいりょう"],["に"],["準備","じゅんび"],["した"],["。"],["青銅","せいどう"],["も"],["おびただしく"],["、"],["量る","はかる"],["こと"],["が"],["できず"],["、"]]},{"verse":4,"text":"レバノン杉も、シドン人とティルス人が大量にダビデのもとに運んで来たので、その数は分からなかった。","tok":[["レバノン"],["杉","すぎ"],["も"],["、"],["シドン人","しどんにん"],["と"],["ティルス"],["人","にん"],["が"],["大量","たいりょう"],["に"],["ダビデ"],["の"],["もと"],["に"],["運んで","はこんで"],["来た","きた"],["ので"],["、"],["その"],["数","すう"],["は"],["分からなかった","わからなかった"],["。"]]},{"verse":5,"text":"ダビデは、「わが子ソロモンは、主のために壮大な神殿を築き、その名声と光輝を万国に行き渡らせるためにはまだ若くて弱い。わたしが準備しなければならない」と言って、死ぬ前に多くの準備をした。","tok":[["ダビデ"],["は"],["、"],["「"],["わが"],["子","こ"],["ソロモン"],["は"],["、"],["主","ぬし"],["の"],["ため"],["に"],["壮大","そうだい"],["な"],["神殿","しんでん"],["を"],["築き","きずき"],["、"],["その"],["名声","めいせい"],["と"],["光輝","こうき"],["を"],["万国","ばんこく"],["に"],["行き","いき"],["渡らせる","わたらせる"],["ため"],["に"],["は"],["まだ"],["若くて","わかくて"],["弱い","よわい"],["。"],["わたし"],["が"],["準備","じゅんび"],["しなければ"],["ならない"],["」"],["と"],["言って","いって"],["、"],["死ぬ","しぬ"],["前","まえ"],["に"],["多く","おおく"],["の"],["準備","じゅんび"],["を"],["した"],["。"]]},{"verse":6,"text":"ダビデはその子ソロモンを呼び、イスラエルの神、主のために神殿を築くことを命じて、","tok":[["ダビデ"],["は"],["その"],["子","こ"],["ソロモン"],["を"],["呼び","よび"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["築く","きずく"],["こと"],["を"],["命じて","めいじて"],["、"]]},{"verse":7,"text":"ソロモンに言った。「わたしの子よ、わたしはわたしの神、主の御名のために神殿を築く志を抱いていた。","tok":[["ソロモン"],["に"],["言った","いった"],["。"],["「"],["わたし"],["の"],["子","こ"],["よ"],["、"],["わたし"],["は"],["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["築く","きずく"],["志","こころざし"],["を"],["抱いて","いだいて"],["いた"],["。"]]},{"verse":8,"text":"ところが主の言葉がわたしに臨んで、こう告げた。『あなたは多くの血を流し、大きな戦争を繰り返した。わたしの前で多くの血を大地に流したからには、あなたがわたしの名のために神殿を築くことは許されない。","tok":[["ところ"],["が"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んで","のぞんで"],["、"],["こう"],["告げた","つげた"],["。"],["『"],["あなた"],["は"],["多く","おおく"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["大きな","おおきな"],["戦争","せんそう"],["を"],["繰り返した","くりかえした"],["。"],["わたし"],["の"],["前","まえ"],["で"],["多く","おおく"],["の"],["血","ち"],["を"],["大地","だいち"],["に"],["流した","ながした"],["から"],["に"],["は"],["、"],["あなた"],["が"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["築く","きずく"],["こと"],["は"],["許されない","ゆるされない"],["。"]]},{"verse":9,"text":"見よ、あなたに子が生まれる。その子は安らぎの人である。わたしは周囲のすべての敵からその子を守って、安らぎを与える。それゆえ、その子の名はソロモンと呼ばれる。わたしは、この子が生きている間、イスラエルに平和と静けさを与える。","tok":[["見よ","みよ"],["、"],["あなた"],["に"],["子","こ"],["が"],["生まれる","うまれる"],["。"],["その"],["子","こ"],["は"],["安らぎ","やすらぎ"],["の"],["人","ひと"],["で"],["ある"],["。"],["わたし"],["は"],["周囲","しゅうい"],["の"],["すべて"],["の"],["敵","てき"],["から"],["その"],["子","こ"],["を"],["守って","まもって"],["、"],["安らぎ","やすらぎ"],["を"],["与える","あたえる"],["。"],["それ"],["ゆえ"],["、"],["その"],["子","こ"],["の"],["名","な"],["は"],["ソロモン"],["と"],["呼ばれる","よばれる"],["。"],["わたし"],["は"],["、"],["この"],["子","こ"],["が"],["生きて","いきて"],["いる"],["間","あいだ"],["、"],["イスラエル"],["に"],["平和","へいわ"],["と"],["静けさ","しずけさ"],["を"],["与える","あたえる"],["。"]]},{"verse":10,"text":"この子がわたしの名のために神殿を築く。この子はわたしの子となり、わたしはその父となる。わたしはその王座を堅く据え、とこしえにイスラエルを支配させる。』","tok":[["この"],["子","こ"],["が"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["神殿","しんでん"],["を"],["築く","きずく"],["。"],["この"],["子","こ"],["は"],["わたし"],["の"],["子","こ"],["と"],["なり"],["、"],["わたし"],["は"],["その"],["父","ちち"],["と"],["なる"],["。"],["わたし"],["は"],["その"],["王座","おうざ"],["を"],["堅く","かたく"],["据え","すえ"],["、"],["とこしえ"],["に"],["イスラエル"],["を"],["支配","しはい"],["させる"],["。"],["』"]]},{"verse":11,"text":"わたしの子よ、今こそ主が共にいてくださり、あなたについて告げられたとおり、あなたの神、主の神殿の建築を成し遂げることができるように。","tok":[["わたし"],["の"],["子","こ"],["よ"],["、"],["今","いま"],["こそ"],["主","ぬし"],["が"],["共","とも"],["に"],["いて"],["くださり"],["、"],["あなた"],["について"],["告げられた","つげられた"],["とおり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["建築","けんちく"],["を"],["成し遂げる","なしとげる"],["こと"],["が"],["できる"],["よう"],["に"],["。"]]},{"verse":12,"text":"賢明に判断し識別する力を主があなたに与え、イスラエルの統治を託してくださり、あなたの神、主の律法を守らせてくださるように。","tok":[["賢明","けんめい"],["に"],["判断","はんだん"],["し"],["識別","しきべつ"],["する"],["力","ちから"],["を"],["主","ぬし"],["が"],["あなた"],["に"],["与え","あたえ"],["、"],["イスラエル"],["の"],["統治","とうち"],["を"],["託して","たくして"],["くださり"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["律法","りっぽう"],["を"],["守らせて","まもらせて"],["くださる"],["よう"],["に"],["。"]]},{"verse":13,"text":"あなたは、主がイスラエルのために、モーセにお授けになった掟と法を行うよう心掛けるなら、そのとき成し遂げることができる。勇気をもて。雄々しくあれ。恐れてはならない。おじけてはならない。","tok":[["あなた"],["は"],["、"],["主","ぬし"],["が"],["イスラエル"],["の"],["ため"],["に"],["、"],["モーセ"],["に"],["お授け","おさずけ"],["に"],["なった"],["掟","おきて"],["と"],["法","ほう"],["を"],["行う","おこなう"],["よう"],["心掛けるなら","こころがけるなら"],["、"],["その"],["とき"],["成し遂げる","なしとげる"],["こと"],["が"],["できる"],["。"],["勇気","ゆうき"],["を"],["もて"],["。"],["雄々しく","おおしく"],["あれ"],["。"],["恐れて","おそれて"],["は"],["ならない"],["。"],["おじけて"],["は"],["ならない"],["。"]]},{"verse":14,"text":"見よ、わたしは苦労して主の神殿のために金十万キカル、銀百万キカルを準備した。青銅も鉄もおびただしくて量りきれない。材木も石材も準備した。更に増し加えるがよい。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["苦労","くろう"],["して"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["ため"],["に"],["金","きん"],["十万","じゅうまん"],["キカル"],["、"],["銀","ぎん"],["百万","ひゃくまん"],["キカル"],["を"],["準備","じゅんび"],["した"],["。"],["青銅","せいどう"],["も"],["鉄","てつ"],["も"],["おびただしくて"],["量り","はかり"],["きれない"],["。"],["材木","ざいもく"],["も"],["石材","せきざい"],["も"],["準備","じゅんび"],["した"],["。"],["更に","さらに"],["増し加える","ましくわえる"],["が"],["よい"],["。"]]},{"verse":15,"text":"あなたのもとには多くの職人、採石労働者、石工、大工、あらゆる分野のあらゆる達人がおり、","tok":[["あなた"],["の"],["もと"],["に"],["は"],["多く","おおく"],["の"],["職人","しょくにん"],["、"],["採石","さいせき"],["労働者","ろうどうしゃ"],["、"],["石工","せっこう"],["、"],["大工","だいく"],["、"],["あらゆる"],["分野","ぶんや"],["の"],["あらゆる"],["達人","たつじん"],["が"],["おり"],["、"]]},{"verse":16,"text":"金、銀、青銅、鉄も数えきれない。立ち上がって実行せよ。主が共にいてくださるように。」","tok":[["金","きん"],["、"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"],["鉄","てつ"],["も"],["数え","かぞえ"],["きれない"],["。"],["立ち上がって","たちあがって"],["実行","じっこう"],["せよ"],["。"],["主","ぬし"],["が"],["共","とも"],["に"],["いて"],["くださる"],["よう"],["に"],["。"],["」"]]},{"verse":17,"text":"ダビデは、その子ソロモンを支援するように、イスラエルの高官たちすべてに命じた。","tok":[["ダビデ"],["は"],["、"],["その"],["子","こ"],["ソロモン"],["を"],["支援","しえん"],["する"],["よう"],["に"],["、"],["イスラエル"],["の"],["高官","こうかん"],["たち"],["すべて"],["に"],["命じた","めいじた"],["。"]]},{"verse":18,"text":"「あなたたちの神、主は、あなたたちと共にいて、周囲の者たちからあなたたちを守り、安らぎを与えられたではないか。主がこの地の住民をわたしの手に渡され、この地は主とその民の前に従うようになったからである。","tok":[["「"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いて"],["、"],["周囲","しゅうい"],["の"],["者","もの"],["たち"],["から"],["あなた"],["たち"],["を"],["守り","まもり"],["、"],["安らぎ","やすらぎ"],["を"],["与えられたで","あたえられたで"],["は"],["ない"],["か"],["。"],["主","ぬし"],["が"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["を"],["わたし"],["の"],["手","て"],["に"],["渡され","わたされ"],["、"],["この"],["地","ち"],["は"],["主","ぬし"],["と"],["その"],["民","たみ"],["の"],["前","まえ"],["に"],["従う","したがう"],["よう"],["に"],["なった"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"今こそ、心と魂を傾けてあなたたちの神、主を求め、神なる主の聖所の建築に立ち上がれ。主の御名のために建てられる神殿に、主の契約の箱と神の聖なる祭具を運び入れよ。」","tok":[["今","いま"],["こそ"],["、"],["心","こころ"],["と"],["魂","たましい"],["を"],["傾けて","かたむけて"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["求め","もとめ"],["、"],["神","かみ"],["なる"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["の"],["建築","けんちく"],["に"],["立ち上がれ","たちあがれ"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["建てられる","たてられる"],["神殿","しんでん"],["に"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["と"],["神","かみ"],["の"],["聖","せい"],["なる"],["祭具","さいぐ"],["を"],["運び入れよ","はこびいれよ"],["。"],["」"]]}]
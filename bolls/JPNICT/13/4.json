,["コゼバ"],["の"],["住民","じゅうみん"],["、"],["また"],["ヨアシュ"],["と"],["サラフ"],["で"],["ある"],["。"],["この"],["二人","ふたり"],["は"],["モアブ"],["で"],["支配力","しはいりょく"],["を"],["持って","もって"],["いた"],["が"],["、"],["レヘム"],["に"],["戻って","もどって"],["来た","きた"],["。"],["これ"],["は"],["古い","ふるい"],["言い伝え","いいつたえ"],["に"],["よる"],["。"]]},{"verse":23,"text":"彼らは焼き物師で、ネタイムとゲデラに住み、そこで王の近くにとどまって王の仕事に従事した。","tok":[["彼","かれ"],["ら"],["は"],["焼き物師","やきものし"],["で"],["、"],["ネタイム"],["と"],["ゲデラ"],["に"],["住み","すみ"],["、"],["そこ"],["で"],["王","おう"],["の"],["近く","ちかく"],["に"],["とどまって"],["王","おう"],["の"],["仕事","しごと"],["に"],["従事","じゅうじ"],["した"],["。"]]},{"verse":24,"text":"シメオンの子は、ネムエル、ヤミン、ヤリブ、ゼラ、シャウル。","tok":[["シメオン"],["の"],["子","こ"],["は"],["、"],["ネムエル"],["、"],["ヤミン"],["、"],["ヤリブ"],["、"],["ゼラ"],["、"],["シャウル"],["。"]]},{"verse":25,"text":"シャウルの子孫は、息子がシャルム、孫がミブサム、更にミシュマと続く。","tok":[["シャウル"],["の"],["子孫","しそん"],["は"],["、"],["息子","むすこ"],["が"],["シャルム"],["、"],["孫","まご"],["が"],["ミブサム"],["、"],["更に","さらに"],["ミシュマ"],["と"],["続く","つづく"],["。"]]},{"verse":26,"text":"ミシュマの子孫は、息子がハムエル、孫がザクル、更にシムイと続く。","tok":[["ミシュマ"],["の"],["子孫","しそん"],["は"],["、"],["息子","むすこ"],["が"],["ハムエル"],["、"],["孫","まご"],["が"],["ザクル"],["、"],["更に","さらに"],["シムイ"],["と"],["続く","つづく"],["。"]]},{"verse":27,"text":"シムイには息子が十六人、娘が六人いたが、兄弟たちの子は多くなかったので、これらの氏族はどれもユダの子孫ほど大きなものにはならなかった。","tok":[["シムイ"],["に"],["は"],["息子","むすこ"],["が"],["十六人","じゅうろくにん"],["、"],["娘","むすめ"],["が"],["六人","ろくにん"],["いた"],["が"],["、"],["兄弟","きょうだい"],["たち"],["の"],["子","こ"],["は"],["多く","おおく"],["なかった"],["ので"],["、"],["これ"],["ら"],["の"],["氏族","しぞく"],["は"],["どれ"],["も"],["ユダ"],["の"],["子孫","しそん"],["ほど"],["大きな","おおきな"],["もの"],["に"],["は"],["ならなかった"],["。"]]},{"verse":28,"text":"彼らが住んだのは、ベエル‧シェバ、モラダ、ハツァル‧シュアル、","tok":[["彼","かれ"],["ら"],["が"],["住んだ","すんだ"],["の"],["は"],["、"],["ベエル"],["‧"],["シェバ"],["、"],["モラダ"],["、"],["ハツァル"],["‧"],["シュアル"],["、"]]},{"verse":29,"text":"ビルハ、エツェム、トラド、","tok":[["ビルハ"],["、"],["エツェム"],["、"],["トラド"],["、"]]},{"verse":30,"text":"ベトエル、ホルマ、ツィクラグ、","tok":[["ベトエル"],["、"],["ホルマ"],["、"],["ツィクラグ"],["、"]]},{"verse":31,"text":
[{"verse":1,"text":"ユダの子は、ペレツ、ヘツロン、カルミ、フル、ショバル。","tok":[["ユダ"],["の"],["子","こ"],["は"],["、"],["ペレツ"],["、"],["ヘツロン"],["、"],["カルミ"],["、"],["フル"],["、"],["ショバル"],["。"]]},{"verse":2,"text":"ショバルの子レアヤにはヤハトが生まれ、ヤハトにはアフマイとラハドが生まれた。彼らがツォルアの氏族である。","tok":[["ショバル"],["の"],["子","こ"],["レアヤ"],["に"],["は"],["ヤハト"],["が"],["生まれ","うまれ"],["、"],["ヤハト"],["に"],["は"],["アフマイ"],["と"],["ラハド"],["が"],["生まれた","うまれた"],["。"],["彼","かれ"],["ら"],["が"],["ツォルア"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":3,"text":"エタムの父の子は、イズレエル、イシュマ、イドバシュ、彼らの姉妹の名はハツレルポニ。","tok":[["エタム"],["の"],["父","ちち"],["の"],["子","こ"],["は"],["、"],["イズレエル"],["、"],["イシュマ"],["、"],["イドバシュ"],["、"],["彼","かれ"],["ら"],["の"],["姉妹","しまい"],["の"],["名","な"],["は"],["ハツレルポニ"],["。"]]},{"verse":4,"text":"ペヌエルはゲドルの父、エゼルはフシャの父である。彼らはベツレヘムの父、エフラタの長男フルの子である。","tok":[["ペヌエル"],["は"],["ゲドル"],["の"],["父","ちち"],["、"],["エゼル"],["は"],["フシャ"],["の"],["父","ちち"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["ベツレヘム"],["の"],["父","ちち"],["、"],["エフラタ"],["の"],["長男","ちょうなん"],["フル"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":5,"text":"テコアの父アシュフルには、ヘルアとナアラという二人の妻がいた。","tok":[["テコア"],["の"],["父","ちち"],["アシュフル"],["に"],["は"],["、"],["ヘルア"],["と"],["ナアラ"],["と"],["いう"],["二人","ふたり"],["の"],["妻","つま"],["が"],["いた"],["。"]]},{"verse":6,"text":"ナアラはアフザム、ヘフェル、テメニの人々とアハシュタリの人々を産んだ。彼らはナアラの子である。","tok":[["ナアラ"],["は"],["アフザム"],["、"],["ヘフェル"],["、"],["テメニ"],["の"],["人々","ひとびと"],["と"],["アハシュタリ"],["の"],["人々","ひとびと"],["を"],["産んだ","うんだ"],["。"],["彼","かれ"],["ら"],["は"],["ナアラ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":7,"text":"ヘルアの子はツェレト、ツォハル、エトナン。","tok":[["ヘルア"],["の"],["子","こ"],["は"],["ツェレト"],["、"],["ツォハル"],["、"],["エトナン"],["。"]]},{"verse":8,"text":"コツにはアヌブ、ツォベバ、またハルムの子アハルヘルの氏族が生まれた。","tok":[["コツ"],["に"],["は"],["アヌブ"],["、"],["ツォベバ"],["、"],["また"],["ハルム"],["の"],["子","こ"],["アハルヘル"],["の"],["氏族","しぞく"],["が"],["生まれた","うまれた"],["。"]]},{"verse":9,"text":"ヤベツは兄弟たちの中で最も尊敬されていた。母は、「わたしは苦しんで産んだから」と言って、彼の名をヤベツと呼んだ。","tok":[["ヤベツ"],["は"],["兄弟","きょうだい"],["たち"],["の"],["中","なか"],["で"],["最も","もっとも"],["尊敬","そんけい"],["さ
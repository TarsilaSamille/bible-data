[{"verse":1,"text":"イスラエルの人々はすべて登録され、『イスラエルの列王の書』に記されている。ユダは神に背いたためにバビロンに捕囚として連れ去られた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["すべて"],["登録","とうろく"],["され"],["、"],["『"],["イスラエル"],["の"],["列王","れつおう"],["の"],["書","しょ"],["』"],["に"],["記されて","しるされて"],["いる"],["。"],["ユダ"],["は"],["神","かみ"],["に"],["背いた","そむいた"],["ため"],["に"],["バビロン"],["に"],["捕囚","ほしゅう"],["として"],["連れ去られた","つれさられた"],["。"]]},{"verse":2,"text":"最初に自分たちの町の所有地に帰って住んだのは、イスラエルの人々、祭司、レビ人、神殿の使用人であった。","tok":[["最初","さいしょ"],["に"],["自分","じぶん"],["たち"],["の"],["町","まち"],["の"],["所有地","しょゆうち"],["に"],["帰って","かえって"],["住んだ","すんだ"],["の"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["、"],["神殿","しんでん"],["の"],["使用人","しようにん"],["で"],["あった"],["。"]]},{"verse":3,"text":"また、エルサレムにはユダの一族の一部、ベニヤミンの一族の一部、エフライムとマナセの一族の一部が住んだ。","tok":[["また"],["、"],["エルサレム"],["に"],["は"],["ユダ"],["の"],["一族","いちぞく"],["の"],["一部","いちぶ"],["、"],["ベニヤミン"],["の"],["一族","いちぞく"],["の"],["一部","いちぶ"],["、"],["エフライム"],["と"],["マナセ"],["の"],["一族","いちぞく"],["の"],["一部","いちぶ"],["が"],["住んだ","すんだ"],["。"]]},{"verse":4,"text":"ウタイ。その父はアミフド、祖父はオムリ、更にイムリ、バニ、ペレツ、ユダとさかのぼる。","tok":[["ウタイ"],["。"],["その"],["父","ちち"],["は"],["アミフド"],["、"],["祖父","そふ"],["は"],["オムリ"],["、"],["更に","さらに"],["イムリ"],["、"],["バニ"],["、"],["ペレツ"],["、"],["ユダ"],["と"],["さかのぼる"],["。"]]},{"verse":5,"text":"シロの出身者では長男のアサヤとその子ら。","tok":[["シロ"],["の"],["出身者","しゅっしんしゃ"],["で"],["は"],["長男","ちょうなん"],["の"],["アサヤ"],["と"],["その"],["子","こ"],["ら"],["。"]]},{"verse":6,"text":"ゼラの一族ではエウエルとその兄弟六百九十人。","tok":[["ゼラ"],["の"],["一族","いちぞく"],["で"],["は"],["エウエル"],["と"],["その"],["兄弟","きょうだい"],["六百九","ろくひゃくきゅう"],["十人","じゅうにん"],["。"]]},{"verse":7,"text":"ベニヤミンの一族ではサル。その父はメシュラム、祖父はホダウヤ、更にセヌアとさかのぼる。","tok":[["ベニヤミン"],["の"],["一族","いちぞく"],["で"],["は"],["サル"],["。"],["その"],["父","ちち"],["は"],["メシュラム"],["、"],["祖父","そふ"],["は"],["ホダウヤ"],["、"],["更に","さらに"],["セヌア"],["と"],["さかのぼる"],["。"]]},{"verse":8,"text":"また、エロハムの子イブネヤ、ミクリの孫でウジの子であるエラ、イブニヤのひ孫でレウエルの孫でシェファトヤの子であるメシュラム。","tok":[["また"],["、"],["エロハム"],["の"],["子","こ"],["イブネヤ"],["、"],["ミクリ"],[
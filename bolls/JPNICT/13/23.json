[{"verse":1,"text":"老人となり、長寿に恵まれたダビデは、その子ソロモンをイスラエルの王とし、","tok":[["老人","ろうじん"],["と"],["なり"],["、"],["長寿","ちょうじゅ"],["に"],["恵まれた","めぐまれた"],["ダビデ"],["は"],["、"],["その"],["子","こ"],["ソロモン"],["を"],["イスラエル"],["の"],["王","おう"],["と"],["し"],["、"]]},{"verse":2,"text":"イスラエルの全高官、祭司、レビ人を呼び集めた。","tok":[["イスラエル"],["の"],["全","ぜん"],["高官","こうかん"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["を"],["呼び集めた","よびあつめた"],["。"]]},{"verse":3,"text":"三十歳以上のレビ人を数えたところ、その男子の数は、三万八千人であった。","tok":[["三十歳","さんじゅうさい"],["以上","いじょう"],["の"],["レビ人","れびにん"],["を"],["数えた","かぞえた"],["ところ"],["、"],["その"],["男子","だんし"],["の"],["数","かず"],["は"],["、"],["三万八千","さんまんはちせん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":4,"text":"そのうち、二万四千人は主の神殿における務めを指揮する者に、六千人は役人と裁判官に、","tok":[["その"],["うち"],["、"],["二万四千","にまんよんせん"],["人","にん"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["おける"],["務め","つとめ"],["を"],["指揮","しき"],["する"],["者","もの"],["に"],["、"],["六千人","ろくせんにん"],["は"],["役人","やくにん"],["と"],["裁判官","さいばんかん"],["に"],["、"]]},{"verse":5,"text":"四千人は門衛に、四千人は、ダビデが賛美するために作った楽器を奏でて、主を賛美する者になった。","tok":[["四千人","よんせんにん"],["は"],["門衛","もんえい"],["に"],["、"],["四千人","よんせんにん"],["は"],["、"],["ダビデ"],["が"],["賛美","さんび"],["する"],["ため"],["に"],["作った","つくった"],["楽器","がっき"],["を"],["奏でて","かなでて"],["、"],["主","ぬし"],["を"],["賛美","さんび"],["する"],["者","もの"],["に"],["なった"],["。"]]},{"verse":6,"text":"ダビデはレビ人をレビの子ゲルション、ケハト、メラリの組に分けた。","tok":[["ダビデ"],["は"],["レビ人","れびにん"],["を"],["レビ"],["の"],["子","こ"],["ゲルション"],["、"],["ケハト"],["、"],["メラリ"],["の"],["組","くみ"],["に"],["分けた","わけた"],["。"]]},{"verse":7,"text":"ゲルションの組に属したのはラダンとシムイ。","tok":[["ゲルション"],["の"],["組","くみ"],["に"],["属した","ぞくした"],["の"],["は"],["ラダン"],["と"],["シムイ"],["。"]]},{"verse":8,"text":"ラダンの子らはエヒエルを頭として、ゼタム、ヨエルの三人。","tok":[["ラダン"],["の"],["子","こ"],["ら"],["は"],["エヒエル"],["を"],["頭","あたま"],["として"],["、"],["ゼタム"],["、"],["ヨエル"],["の"],["三人","さんにん"],["。"]]},{"verse":9,"text":"シムイの子らはシェロモト、ハジエル、ハランの三人。彼らはラダンの家系の長であった。","tok":[["シムイ"],["の"],["子","こ"],["ら"],["は"],["シェロモト"],["、"],["ハジエル"],["、"],["ハラン"],["の"],["三人","さんにん"],["。"],["彼","かれ"],["ら"],["は"],["
[{"verse":1,"text":"ユダの王アモンの子ヨシヤの時代に、クシの子ゼファニヤに臨んだ主の言葉。クシはゲダルヤの子、ゲダルヤはアマルヤの子、アマルヤはヒズキヤの子である。","tok":[["ユダ"],["の"],["王","おう"],["アモン"],["の"],["子","こ"],["ヨシヤ"],["の"],["時代","じだい"],["に"],["、"],["クシ"],["の"],["子","こ"],["ゼファニヤ"],["に"],["臨んだ","のぞんだ"],["主","ぬし"],["の"],["言葉","ことば"],["。"],["クシ"],["は"],["ゲダルヤ"],["の"],["子","こ"],["、"],["ゲダルヤ"],["は"],["アマルヤ"],["の"],["子","こ"],["、"],["アマルヤ"],["は"],["ヒズキヤ"],["の"],["子","こ"],["で"],["ある"],["。"]]},{"verse":2,"text":"わたしは地の面からすべてのものを一掃する、と主は言われる。","tok":[["わたし"],["は"],["地","ち"],["の"],["面","めん"],["から"],["すべて"],["の"],["もの"],["を"],["一掃","いっそう"],["する"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":3,"text":"わたしは、人も獣も取り去り空の鳥も海の魚も取り去る。神に逆らう者をつまずかせ人を地の面から絶つ、と主は言われる。","tok":[["わたし"],["は"],["、"],["人","ひと"],["も"],["獣","けもの"],["も"],["取り去り","とりさり"],["空","そら"],["の"],["鳥","とり"],["も"],["海","うみ"],["の"],["魚","さかな"],["も"],["取り去る","とりさる"],["。"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["を"],["つまずかせ"],["人","ひと"],["を"],["地","ち"],["の"],["面","めん"],["から"],["絶つ","たつ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":4,"text":"わたしは、ユダの上とエルサレムの全住民の上に手を伸ばしバアルのあらゆる名残とその神官の名声を祭司たちと共に、この場所から絶つ。","tok":[["わたし"],["は"],["、"],["ユダ"],["の"],["上","うえ"],["と"],["エルサレム"],["の"],["全住民","ぜんじゅうみん"],["の"],["上","うえ"],["に"],["手","て"],["を"],["伸ばし","のばし"],["バアル"],["の"],["あらゆる"],["名残","なごり"],["と"],["その"],["神官","しんかん"],["の"],["名声","めいせい"],["を"],["祭司","さいし"],["たち"],["と"],["共","とも"],["に"],["、"],["この"],["場所","ばしょ"],["から"],["絶つ","たつ"],["。"]]},{"verse":5,"text":"屋上で天の万象を拝む者主を拝み、主に誓いを立てながらマルカムにも誓いを立てる者","tok":[["屋上","おくじょう"],["で"],["天","てん"],["の"],["万象","ばんしょう"],["を"],["拝む","おがむ"],["者","もの"],["主","ぬし"],["を"],["拝み","おがみ"],["、"],["主に","おもに"],["誓い","ちかい"],["を"],["立て","たて"],["ながら"],["マルカム"],["に"],["も"],["誓い","ちかい"],["を"],["立てる","たてる"],["者","もの"]]},{"verse":6,"text":"主に背を向け主を尋ねず、主を求めようとしない者を絶つ。","tok":[["主に","おもに"],["背","せ"],["を"],["向け","むけ"],["主","ぬし"],["を"],["尋ねず","たずねず"],["、"],["主","ぬし"],["を"],["求めよう","もとめよう"],["と"],["しない"],["者","もの"],["を"],["絶つ","たつ"],["。"]]},{"verse":7,"text":"主なる神の御前に沈黙せよ。主の日は近づいている。主はいけにえを用意し呼び集められた者を屠るために聖別された。","tok":[["主","おも"],["なる"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["沈黙","ちんもく"],["せよ"],["。"],["主","ぬし"],["の"],["日","ひ"],["は"],["近づいて","ちかづいて"],["いる"],["。"],["主","ぬし"],["は"],["いけにえ"],["を"],["用意","ようい"],["し"],["呼び集められた","よびあつめられた"],["者","もの"],["を"],["屠る","ほふる"],["ため"],["に"],["聖別","せいべつ"],["された"],["。"]]},{"verse":8,"text":"主のいけにえの日が来ればわたしは、高官たちと王の子らをまた、異邦人の服を着たすべての者を罰する。","tok":[["主","ぬし"],["の"],["いけにえ"],["の"],["日","ひ"],["が"],["来れば","くれば"],["わたし"],["は"],["、"],["高官","こうかん"],["たち"],["と"],["王","おう"],["の"],["子","こ"],["ら"],["を"],["また"],["、"],["異邦人","いほうじん"],["の"],["服","ふく"],["を"],["着た","きた"],["すべて"],["の"],["者","もの"],["を"],["罰する","ばっする"],["。"]]},{"verse":9,"text":"その日、わたしは敷居を跳び越える者すべてを主君の家を不法と偽りで満たす者らを罰する。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["敷居","しきい"],["を"],["跳び越える","とびこえる"],["者","もの"],["すべて"],["を"],["主君","しゅくん"],["の"],["家","いえ"],["を"],["不法","ふほう"],["と"],["偽り","いつわり"],["で"],["満たす","みたす"],["者","もの"],["ら"],["を"],["罰する","ばっする"],["。"]]},{"verse":10,"text":"その日が来れば、と主は言われる。魚の門からは、助けを求める声がミシュネ地区からは、泣き叫ぶ声がもろもろの丘からは、大きな崩壊の音が起こる。","tok":[["その"],["日","ひ"],["が"],["来れば","くれば"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["魚","さかな"],["の"],["門","もん"],["から"],["は"],["、"],["助け","たすけ"],["を"],["求める","もとめる"],["声","こえ"],["が"],["ミシュネ"],["地区","ちく"],["から"],["は"],["、"],["泣き叫ぶ","なきさけぶ"],["声","こえ"],["が"],["もろもろ"],["の"],["丘","おか"],["から"],["は"],["、"],["大きな","おおきな"],["崩壊","ほうかい"],["の"],["音","おと"],["が"],["起こる","おこる"],["。"]]},{"verse":11,"text":"マクテシュ地区の住民よ、泣き叫べ。商人たちはすべて滅ぼされ銀を量る者は皆、絶たれるからだ。","tok":[["マクテシュ"],["地区","ちく"],["の"],["住民","じゅうみん"],["よ"],["、"],["泣き叫べ","なきさけべ"],["。"],["商人","しょうにん"],["たち"],["は"],["すべて"],["滅ぼされ","ほろぼされ"],["銀","ぎん"],["を"],["量る","はかる"],["者","もの"],["は"],["皆","みな"],["、"],["絶たれる","たたれる"],["から"],["だ"],["。"]]},{"verse":12,"text":"そのときが来ればわたしはともし火をかざしてエルサレムを捜し酒のおりの上に凝り固まり、心の中で「主は幸いをも、災いをもくだされない」と言っている者を罰する。","tok":[["その"],["とき"],["が"],["来れば","くれば"],["わたし"],["は"],["ともし火","ともしび"],["を"],["かざして"],["エルサレム"],["を"],["捜し","さがし"],["酒","さけ"],["の"],["おり"],["の"],["上","うえ"],["に"],["凝り固まり","こりかたまり"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["「"],["主","ぬし"],["は"],["幸い","さいわい"],["を"],["も"],["、"],["災い","わざわい"],["を"],["も"],["くだされない"],["」"],["と"],["言って","いって"],["いる"],["者","もの"],["を"],["罰する","ばっする"],["。"]]},{"verse":13,"text":"彼らの財産は略奪され、家は荒れ果てる。彼らは家を建てても、住むことができずぶどう畑を植えてもその酒を飲むことができない。","tok":[["彼","かれ"],["ら"],["の"],["財産","ざいさん"],["は"],["略奪","りゃくだつ"],["され"],["、"],["家","いえ"],["は"],["荒れ果てる","あれはてる"],["。"],["彼","かれ"],["ら"],["は"],["家","いえ"],["を"],["建てて","たてて"],["も"],["、"],["住む","すむ"],["こと"],["が"],["できず"],["ぶどう"],["畑","はたけ"],["を"],["植えて","うえて"],["も"],["その"],["酒","さけ"],["を"],["飲む","のむ"],["こと"],["が"],["できない"],["。"]]},{"verse":14,"text":"主の大いなる日は近づいている。極めて速やかに近づいている。聞け、主の日にあがる声を。その日には、勇士も苦しみの叫びをあげる。","tok":[["主","ぬし"],["の"],["大いなる","おおいなる"],["日","ひ"],["は"],["近づいて","ちかづいて"],["いる"],["。"],["極めて","きわめて"],["速やか","すみやか"],["に"],["近づいて","ちかづいて"],["いる"],["。"],["聞け","きけ"],["、"],["主","ぬし"],["の"],["日","ひ"],["に"],["あがる"],["声","こえ"],["を"],["。"],["その"],["日","ひ"],["に"],["は"],["、"],["勇士","ゆうし"],["も"],["苦しみ","くるしみ"],["の"],["叫び","さけび"],["を"],["あげる"],["。"]]},{"verse":15,"text":"その日は憤りの日苦しみと悩みの日、荒廃と滅亡の日闇と暗黒の日、雲と濃霧の日である。","tok":[["その"],["日","ひ"],["は"],["憤り","いきどおり"],["の"],["日","ひ"],["苦しみ","くるしみ"],["と"],["悩み","なやみ"],["の"],["日","ひ"],["、"],["荒廃","こうはい"],["と"],["滅亡","めつぼう"],["の"],["日","ひ"],["闇","やみ"],["と"],["暗黒","あんこく"],["の"],["日","ひ"],["、"],["雲","くも"],["と"],["濃霧","のうむ"],["の"],["日","ひ"],["で"],["ある"],["。"]]},{"verse":16,"text":"城壁に囲まれた町、城壁の角の高い塔に向かい角笛が鳴り、鬨の声があがる日である。","tok":[["城壁","じょうへき"],["に"],["囲まれた","かこまれた"],["町","まち"],["、"],["城壁","じょうへき"],["の"],["角","かど"],["の"],["高い","たかい"],["塔","とう"],["に"],["向かい","むかい"],["角笛","つのぶえ"],["が"],["鳴り","なり"],["、"],["鬨の声","ときのこえ"],["が"],["あがる"],["日","ひ"],["で"],["ある"],["。"]]},{"verse":17,"text":"わたしは人々を苦しみに遭わせ目が見えない者のように歩かせる。彼らが主に対して罪を犯したからだ。彼らの血は塵のようにはらわたは糞のようにまき散らされる。","tok":[["わたし"],["は"],["人々","ひとびと"],["を"],["苦しみ","くるしみ"],["に"],["遭わせ","あわせ"],["目","め"],["が"],["見えない","みえない"],["者","もの"],["の"],["よう"],["に"],["歩かせる","あるかせる"],["。"],["彼","かれ"],["ら"],["が"],["主","ぬし"],["に対して","にたいして"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["だ"],["。"],["彼","かれ"],["ら"],["の"],["血","ち"],["は"],["塵","ごみ"],["の"],["よう"],["に"],["はらわた"],["は"],["糞","ふん"],["の"],["よう"],["に"],["まき散らされる","まきちらされる"],["。"]]},{"verse":18,"text":"金も銀も彼らを救い出すことはできない。主の憤りの日に地上はくまなく主の熱情の火に焼き尽くされる。主は恐るべき破滅を地上に住むすべての者に臨ませられる。","tok":[["金","きん"],["も"],["銀","ぎん"],["も"],["彼","かれ"],["ら"],["を"],["救い出す","すくいだす"],["こと"],["は"],["できない"],["。"],["主","ぬし"],["の"],["憤り","いきどおり"],["の"],["日","ひ"],["に"],["地上","ちじょう"],["は"],["くまなく"],["主","ぬし"],["の"],["熱情","ねつじょう"],["の"],["火","ひ"],["に"],["焼き","やき"],["尽くされる","つくされる"],["。"],["主","ぬし"],["は"],["恐るべき","おそるべき"],["破滅","はめつ"],["を"],["地上","ちじょう"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["に"],["臨ませられる","のぞませられる"],["。"]]}]
[{"verse":1,"text":"終わりに、兄弟たち、わたしたちのために祈ってください。主の言葉が、あなたがたのところでそうであったように、速やかに宣べ伝えられ、あがめられるように、","tok":[["終わり","おわり"],["に"],["、"],["兄弟","きょうだい"],["たち"],["、"],["わたしたち"],["の"],["ため"],["に"],["祈って","いのって"],["ください"],["。"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["、"],["あなた"],["がた"],["の"],["ところ"],["で"],["そう"],["で"],["あった"],["よう"],["に"],["、"],["速やか","すみやか"],["に"],["宣べ伝えられ","のべつたえられ"],["、"],["あがめられる"],["よう"],["に"],["、"]]},{"verse":2,"text":"また、わたしたちが道に外れた悪人どもから逃れられるように、と祈ってください。すべての人に、信仰があるわけではないのです。","tok":[["また"],["、"],["わたしたち"],["が"],["道","みち"],["に"],["外れた","はずれた"],["悪人","あくにん"],["ども"],["から"],["逃れられる","のがれられる"],["よう"],["に"],["、"],["と"],["祈って","いのって"],["ください"],["。"],["すべて"],["の"],["人","ひと"],["に"],["、"],["信仰","しんこう"],["が"],["ある"],["わけ"],["で"],["は"],["ない"],["の"],["です"],["。"]]},{"verse":3,"text":"しかし、主は真実な方です。必ずあなたがたを強め、悪い者から守ってくださいます。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["真実","しんじつ"],["な"],["方","ほう"],["です"],["。"],["必ず","かならず"],["あなた"],["がた"],["を"],["強め","つよめ"],["、"],["悪い","わるい"],["者","もの"],["から"],["守って","まもって"],["くださいます"],["。"]]},{"verse":4,"text":"そして、わたしたちが命令することを、あなたがたは現に実行しており、また、これからもきっと実行してくれることと、主によって確信しています。","tok":[["そして"],["、"],["わたしたち"],["が"],["命令","めいれい"],["する"],["こと"],["を"],["、"],["あなた"],["がた"],["は"],["現に","げんに"],["実行","じっこう"],["して"],["おり"],["、"],["また"],["、"],["これ"],["から"],["も"],["きっと"],["実行","じっこう"],["して"],["くれる"],["こと"],["と"],["、"],["主に","おもに"],["よって"],["確信","かくしん"],["して"],["います"],["。"]]},{"verse":5,"text":"どうか、主が、あなたがたに神の愛とキリストの忍耐とを深く悟らせてくださるように。","tok":[["どう"],["か"],["、"],["主","ぬし"],["が"],["、"],["あなた"],["がた"],["に"],["神","かみ"],["の"],["愛","あい"],["と"],["キリスト"],["の"],["忍耐","にんたい"],["と"],["を"],["深く","ふかく"],["悟らせて","さとらせて"],["くださる"],["よう"],["に"],["。"]]},{"verse":6,"text":"兄弟たち、わたしたちは、わたしたちの主イエス‧キリストの名によって命じます。怠惰な生活をして、わたしたちから受けた教えに従わないでいるすべての兄弟を避けなさい。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたしたち"],["は"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["名","な"],["によって"],["命じます","めいじます"],["。"],["怠惰","たいだ"],["な"],["生活","せいかつ"],["を"],["して"],["、"],["わたしたち"],["から"],["受けた","うけた"],["教え","おしえ"],["に"],["従わないで","したがわないで"],["いる"],["すべて"],["の"],["兄弟","きょうだい"],["を"],["避け","さけ"],["なさい"],["。"]]},{"verse":7,"text":"あなたがた自身、わたしたちにどのように倣えばよいか、よく知っています。わたしたちは、そちらにいたとき、怠惰な生活をしませんでした。","tok":[["あなた"],["がた"],["自身","じしん"],["、"],["わたしたち"],["に"],["どの"],["よう"],["に"],["倣えば","ならえば"],["よい"],["か"],["、"],["よく"],["知って","しって"],["います"],["。"],["わたしたち"],["は"],["、"],["そちら"],["に"],["いた"],["とき"],["、"],["怠惰","たいだ"],["な"],["生活","せいかつ"],["を"],["しませんでした"],["。"]]},{"verse":8,"text":"また、だれからもパンをただでもらって食べたりはしませんでした。むしろ、だれにも負担をかけまいと、夜昼大変苦労して、働き続けたのです。","tok":[["また"],["、"],["だれ"],["から"],["も"],["パン"],["を"],["ただ"],["で"],["もらって"],["食べ","たべ"],["たり"],["は"],["しませんでした"],["。"],["むしろ"],["、"],["だれ"],["に"],["も"],["負担","ふたん"],["を"],["かけまい"],["と"],["、"],["夜","よる"],["昼","ひる"],["大変","たいへん"],["苦労","くろう"],["して"],["、"],["働き","はたらき"],["続けた","つづけた"],["の"],["です"],["。"]]},{"verse":9,"text":"援助を受ける権利がわたしたちになかったからではなく、あなたがたがわたしたちに倣うように、身をもって模範を示すためでした。","tok":[["援助","えんじょ"],["を"],["受ける","うける"],["権利","けんり"],["が"],["わたしたち"],["に"],["なかった"],["から"],["で"],["は"],["なく"],["、"],["あなた"],["がた"],["が"],["わたしたち"],["に"],["倣う","ならう"],["よう"],["に"],["、"],["身","み"],["を"],["もって"],["模範","もはん"],["を"],["示す","しめす"],["ため"],["でした"],["。"]]},{"verse":10,"text":"実際、あなたがたのもとにいたとき、わたしたちは、「働きたくない者は、食べてはならない」と命じていました。","tok":[["実際","じっさい"],["、"],["あなた"],["がた"],["の"],["もと"],["に"],["いた"],["とき"],["、"],["わたしたち"],["は"],["、"],["「"],["働きたく","はたらきたく"],["ない"],["者","もの"],["は"],["、"],["食べて","たべて"],["は"],["ならない"],["」"],["と"],["命じて","めいじて"],["いました"],["。"]]},{"verse":11,"text":"ところが、聞くところによると、あなたがたの中には怠惰な生活をし、少しも働かず、余計なことをしている者がいるということです。","tok":[["ところ"],["が"],["、"],["聞く","きく"],["ところ"],["に"],["よる"],["と"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["は"],["怠惰","たいだ"],["な"],["生活","せいかつ"],["を"],["し"],["、"],["少し","すこし"],["も"],["働かず","はたらかず"],["、"],["余計","よけい"],["な"],["こと"],["を"],["して"],["いる"],["者","もの"],["が"],["いる"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":12,"text":"そのような者たちに、わたしたちは主イエス‧キリストに結ばれた者として命じ、勧めます。自分で得たパンを食べるように、落ち着いて仕事をしなさい。","tok":[["その"],["よう"],["な"],["者","もの"],["たち"],["に"],["、"],["わたしたち"],["は"],["主","しゅ"],["イエス"],["‧"],["キリスト"],["に"],["結ばれた","むすばれた"],["者","もの"],["として"],["命じ","めいじ"],["、"],["勧めます","すすめます"],["。"],["自分","じぶん"],["で"],["得た","えた"],["パン"],["を"],["食べる","たべる"],["よう"],["に"],["、"],["落ち着いて","おちついて"],["仕事","しごと"],["を"],["し"],["なさい"],["。"]]},{"verse":13,"text":"そして、兄弟たち、あなたがたは、たゆまず善いことをしなさい。","tok":[["そして"],["、"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["は"],["、"],["たゆまず"],["善い","よい"],["こと"],["を"],["し"],["なさい"],["。"]]},{"verse":14,"text":"もし、この手紙でわたしたちの言うことに従わない者がいれば、その者には特に気をつけて、かかわりを持たないようにしなさい。そうすれば、彼は恥じ入るでしょう。","tok":[["もし"],["、"],["この"],["手紙","てがみ"],["で"],["わたしたち"],["の"],["言う","いう"],["こと"],["に"],["従わない","したがわない"],["者","もの"],["が"],["いれば"],["、"],["その"],["者","もの"],["に"],["は"],["特に","とくに"],["気","き"],["を"],["つけて"],["、"],["かかわり"],["を"],["持たない","もたない"],["よう"],["に"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["は"],["恥じ入るでしょう","はじいるでしょう"],["。"]]},{"verse":15,"text":"しかし、その人を敵とは見なさず、兄弟として警告しなさい。","tok":[["しかし"],["、"],["その"],["人","ひと"],["を"],["敵","てき"],["と"],["は"],["見なさず","みなさず"],["、"],["兄弟","きょうだい"],["として"],["警告","けいこく"],["し"],["なさい"],["。"]]},{"verse":16,"text":"どうか、平和の主御自身が、いついかなる場合にも、あなたがたに平和をお与えくださるように。主があなたがた一同と共におられるように。","tok":[["どう"],["か"],["、"],["平和","へいわ"],["の"],["主","ぬし"],["御自身","ごじしん"],["が"],["、"],["いつ"],["いかなる"],["場合","ばあい"],["に"],["も"],["、"],["あなた"],["がた"],["に"],["平和","へいわ"],["を"],["お与え","おあたえ"],["くださる"],["よう"],["に"],["。"],["主","ぬし"],["が"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["おられる"],["よう"],["に"],["。"]]},{"verse":17,"text":"わたしパウロが、自分の手で挨拶を記します。これはどの手紙にも記す印です。わたしはこのように書きます。","tok":[["わたし"],["パウロ"],["が"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["挨拶","あいさつ"],["を"],["記します","しるします"],["。"],["これ"],["は"],["どの"],["手紙","てがみ"],["に"],["も"],["記す","しるす"],["印","しるし"],["です"],["。"],["わたし"],["は"],["この"],["よう"],["に"],["書きます","かきます"],["。"]]},{"verse":18,"text":"わたしたちの主イエス‧キリストの恵みが、あなたがた一同と共にあるように。","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["一同","いちどう"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
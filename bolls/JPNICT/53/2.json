[{"verse":1,"text":"さて、兄弟たち、わたしたちの主イエス‧キリストが来られることと、そのみもとにわたしたちが集められることについてお願いしたい。","tok":[["さて"],["、"],["兄弟","きょうだい"],["たち"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["が"],["来られる","こられる"],["こと"],["と"],["、"],["その"],["みもと"],["に"],["わたしたち"],["が"],["集められる","あつめられる"],["こと"],["について"],["お願い","おねがい"],["したい"],["。"]]},{"verse":2,"text":"霊や言葉によって、あるいは、わたしたちから書き送られたという手紙によって、主の日は既に来てしまったかのように言う者がいても、すぐに動揺して分別を無くしたり、慌てふためいたりしないでほしい。","tok":[["霊","れい"],["や"],["言葉","ことば"],["によって"],["、"],["あるいは"],["、"],["わたしたち"],["から"],["書き送られた","かきおくられた"],["と"],["いう"],["手紙","てがみ"],["によって"],["、"],["主","ぬし"],["の"],["日","ひ"],["は"],["既に","すでに"],["来て","きて"],["しまった"],["か"],["の"],["よう"],["に"],["言う","いう"],["者","もの"],["が"],["いて"],["も"],["、"],["すぐ"],["に"],["動揺","どうよう"],["して"],["分別","ぶんべつ"],["を"],["無くし","なくし"],["たり"],["、"],["慌てふためい","あわてふためい"],["たり"],["しないで"],["ほしい"],["。"]]},{"verse":3,"text":"だれがどのような手段を用いても、だまされてはいけません。なぜなら、まず、神に対する反逆が起こり、不法の者、つまり、滅びの子が出現しなければならないからです。","tok":[["だれ"],["が"],["どのような"],["手段","しゅだん"],["を"],["用いて","もちいて"],["も"],["、"],["だまされて"],["は"],["いけません"],["。"],["なぜ"],["なら"],["、"],["まず"],["、"],["神","かみ"],["に"],["対する","たいする"],["反逆","はんぎゃく"],["が"],["起こり","おこり"],["、"],["不法","ふほう"],["の"],["者","もの"],["、"],["つまり"],["、"],["滅び","ほろび"],["の"],["子","こ"],["が"],["出現","しゅつげん"],["しなければ"],["ならない"],["から"],["です"],["。"]]},{"verse":4,"text":"この者は、すべて神と呼ばれたり拝まれたりするものに反抗して、傲慢にふるまい、ついには、神殿に座り込み、自分こそは神であると宣言するのです。","tok":[["この"],["者","もの"],["は"],["、"],["すべて"],["神","かみ"],["と"],["呼ばれ","よばれ"],["たり"],["拝まれ","おがまれ"],["たり"],["する"],["もの"],["に"],["反抗","はんこう"],["して"],["、"],["傲慢","ごうまん"],["に"],["ふるまい"],["、"],["ついに"],["は"],["、"],["神殿","しんでん"],["に"],["座り込み","すわりこみ"],["、"],["自分","じぶん"],["こそ"],["は"],["神","かみ"],["で"],["ある"],["と"],["宣言","せんげん"],["する"],["の"],["です"],["。"]]},{"verse":5,"text":"まだわたしがあなたがたのもとにいたとき、これらのことを繰り返し語っていたのを思い出しませんか。","tok":[["まだ"],["わたし"],["が"],["あなた"],["がた"],["の"],["もと"],["に"],["いた"],["とき"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["繰り返し","くりかえし"],["語って","かたって"],["いた"],["の"],["を"],["思い出しません","おもいだしません"],["か"],["。"]]},{"verse":6,"text":"今、彼を抑えているものがあることは、あなたがたも知っているとおりです。それは、定められた時に彼が現れるためなのです。","tok":[["今","いま"],["、"],["彼","かれ"],["を"],["抑えて","おさえて"],["いる"],["もの"],["が"],["ある"],["こと"],["は"],["、"],["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["です"],["。"],["それ"],["は"],["、"],["定められた","さだめられた"],["時","とき"],["に"],["彼","かれ"],["が"],["現れる","あらわれる"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":7,"text":"不法の秘密の力は既に働いています。ただそれは、今のところ抑えている者が、取り除かれるまでのことです。","tok":[["不法","ふほう"],["の"],["秘密","ひみつ"],["の"],["力","ちから"],["は"],["既に","すでに"],["働いて","はたらいて"],["います"],["。"],["ただ"],["それ"],["は"],["、"],["今","いま"],["の"],["ところ"],["抑えて","おさえて"],["いる"],["者","もの"],["が"],["、"],["取り除かれる","とりのぞかれる"],["まで"],["の"],["こと"],["です"],["。"]]},{"verse":8,"text":"その時が来ると、不法の者が現れますが、主イエスは彼を御自分の口から吐く息で殺し、来られるときの御姿の輝かしい光で滅ぼしてしまわれます。","tok":[["その"],["時","とき"],["が"],["来る","くる"],["と"],["、"],["不法","ふほう"],["の"],["者","もの"],["が"],["現れます","あらわれます"],["が"],["、"],["主","しゅ"],["イエス"],["は"],["彼","かれ"],["を"],["御自分","ごじぶん"],["の"],["口","くち"],["から"],["吐く","はく"],["息","いき"],["で"],["殺し","ころし"],["、"],["来られる","こられる"],["とき"],["の"],["御姿","おすがた"],["の"],["輝かしい","かがやかしい"],["光","ひかり"],["で"],["滅ぼして","ほろぼして"],["しまわれます"],["。"]]},{"verse":9,"text":"不法の者は、サタンの働きによって現れ、あらゆる偽りの奇跡としるしと不思議な業とを行い、","tok":[["不法","ふほう"],["の"],["者","もの"],["は"],["、"],["サタン"],["の"],["働き","はたらき"],["によって"],["現れ","あらわれ"],["、"],["あらゆる"],["偽り","いつわり"],["の"],["奇跡","きせき"],["と"],["しるし"],["と"],["不思議","ふしぎ"],["な"],["業","ごう"],["と"],["を"],["行い","おこない"],["、"]]},{"verse":10,"text":"そして、あらゆる不義を用いて、滅びていく人々を欺くのです。彼らが滅びるのは、自分たちの救いとなる真理を愛そうとしなかったからです。","tok":[["そして"],["、"],["あらゆる"],["不義","ふぎ"],["を"],["用いて","もちいて"],["、"],["滅びて","ほろびて"],["いく"],["人々","ひとびと"],["を"],["欺く","あざむく"],["の"],["です"],["。"],["彼","かれ"],["ら"],["が"],["滅びる","ほろびる"],["の"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["救い","すくい"],["と"],["なる"],["真理","しんり"],["を"],["愛そう","あいそう"],["と"],["しなかった"],["から"],["です"],["。"]]},{"verse":11,"text":"それで、神は彼らに惑わす力を送られ、その人たちは偽りを信じるようになります。","tok":[["それ"],["で"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["に"],["惑わす","まどわす"],["力","ちから"],["を"],["送られ","おくられ"],["、"],["その"],["人","ひと"],["たち"],["は"],["偽り","いつわり"],["を"],["信じる","しんじる"],["よう"],["に"],["なります"],["。"]]},{"verse":12,"text":"こうして、真理を信じないで不義を喜んでいた者は皆、裁かれるのです。","tok":[["こう"],["して"],["、"],["真理","しんり"],["を"],["信じないで","しんじないで"],["不義","ふぎ"],["を"],["喜んで","よろこんで"],["いた"],["者","もの"],["は"],["皆","みな"],["、"],["裁かれる","さばかれる"],["の"],["です"],["。"]]},{"verse":13,"text":"しかし、主に愛されている兄弟たち、あなたがたのことについて、わたしたちはいつも神に感謝せずにはいられません。なぜなら、あなたがたを聖なる者とする“霊”の力と、真理に対するあなたがたの信仰とによって、神はあなたがたを、救われるべき者の初穂としてお選びになったからです。","tok":[["しかし"],["、"],["主に","おもに"],["愛されて","あいされて"],["いる"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["の"],["こと"],["について"],["、"],["わたしたち"],["は"],["いつも"],["神","かみ"],["に"],["感謝","かんしゃ"],["せず"],["に"],["は"],["いられません"],["。"],["なぜ"],["なら"],["、"],["あなた"],["がた"],["を"],["聖","せい"],["なる"],["者","もの"],["と"],["する"],["“"],["霊","れい"],["”"],["の"],["力","ちから"],["と"],["、"],["真理","しんり"],["に"],["対する","たいする"],["あなた"],["がた"],["の"],["信仰","しんこう"],["と"],["によって"],["、"],["神","かみ"],["は"],["あなた"],["がた"],["を"],["、"],["救われるべき","すくわれるべき"],["者","もの"],["の"],["初穂","はつほ"],["として"],["お選び","おえらび"],["に"],["なった"],["から"],["です"],["。"]]},{"verse":14,"text":"神は、このことのために、すなわち、わたしたちの主イエス‧キリストの栄光にあずからせるために、わたしたちの福音を通して、あなたがたを招かれたのです。","tok":[["神","かみ"],["は"],["、"],["この"],["こと"],["の"],["ため"],["に"],["、"],["すなわち"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["栄光","えいこう"],["に"],["あずからせる"],["ため"],["に"],["、"],["わたしたち"],["の"],["福音","ふくいん"],["を"],["通して","とおして"],["、"],["あなた"],["がた"],["を"],["招かれた","まねかれた"],["の"],["です"],["。"]]},{"verse":15,"text":"ですから、兄弟たち、しっかり立って、わたしたちが説教や手紙で伝えた教えを固く守り続けなさい。","tok":[["です"],["から"],["、"],["兄弟","きょうだい"],["たち"],["、"],["しっかり"],["立って","たって"],["、"],["わたしたち"],["が"],["説教","せっきょう"],["や"],["手紙","てがみ"],["で"],["伝えた","つたえた"],["教え","おしえ"],["を"],["固く","かたく"],["守り","まもり"],["続け","つづけ"],["なさい"],["。"]]},{"verse":16,"text":"わたしたちの主イエス‧キリスト御自身、ならびに、わたしたちを愛して、永遠の慰めと確かな希望とを恵みによって与えてくださる、わたしたちの父である神が、","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["御自身","ごじしん"],["、"],["ならびに"],["、"],["わたしたち"],["を"],["愛して","あいして"],["、"],["永遠","えいえん"],["の"],["慰め","なぐさめ"],["と"],["確か","たしか"],["な"],["希望","きぼう"],["と"],["を"],["恵み","めぐみ"],["によって"],["与えて","あたえて"],["くださる"],["、"],["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["が"],["、"]]},{"verse":17,"text":"どうか、あなたがたの心を励まし、また強め、いつも善い働きをし、善い言葉を語る者としてくださるように。","tok":[["どう"],["か"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["励まし","はげまし"],["、"],["また"],["強め","つよめ"],["、"],["いつも"],["善い","よい"],["働き","はたらき"],["を"],["し"],["、"],["善い","よい"],["言葉","ことば"],["を"],["語る","かたる"],["者","もの"],["として"],["くださる"],["よう"],["に"],["。"]]}]
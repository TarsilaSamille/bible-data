[{"verse":1,"text":"長老のわたしから、選ばれた婦人とその子たちへ。わたしは、あなたがたを真に愛しています。わたしばかりでなく、真理を知っている人はすべて、あなたがたを愛しています。","tok":[["長老","ちょうろう"],["の"],["わたし"],["から"],["、"],["選ばれた","えらばれた"],["婦人","ふじん"],["と"],["その"],["子","こ"],["たち"],["へ"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["を"],["真","しん"],["に"],["愛して","あいして"],["います"],["。"],["わたし"],["ばかり"],["で"],["なく"],["、"],["真理","しんり"],["を"],["知って","しって"],["いる"],["人","ひと"],["は"],["すべて"],["、"],["あなた"],["がた"],["を"],["愛して","あいして"],["います"],["。"]]},{"verse":2,"text":"それは、いつもわたしたちの内にある真理によることで、真理は永遠にわたしたちと共にあります。","tok":[["それ"],["は"],["、"],["いつも"],["わたしたち"],["の"],["内","うち"],["に"],["ある"],["真理","しんり"],["に"],["よる"],["こと"],["で"],["、"],["真理","しんり"],["は"],["永遠","えいえん"],["に"],["わたしたち"],["と"],["共","とも"],["に"],["あります"],["。"]]},{"verse":3,"text":"父である神と、その父の御子イエス‧キリストからの恵みと憐れみと平和は、真理と愛のうちにわたしたちと共にあります。","tok":[["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["、"],["その"],["父","ちち"],["の"],["御子","みこ"],["イエス"],["‧"],["キリスト"],["から"],["の"],["恵み","めぐみ"],["と"],["憐れみ","あわれみ"],["と"],["平和","へいわ"],["は"],["、"],["真理","しんり"],["と"],["愛","あい"],["の"],["うち"],["に"],["わたしたち"],["と"],["共","とも"],["に"],["あります"],["。"]]},{"verse":4,"text":"あなたの子供たちの中に、わたしたちが御父から受けた掟どおりに、真理に歩んでいる人がいるのを知って、大変うれしく思いました。","tok":[["あなた"],["の"],["子供","こども"],["たち"],["の"],["中","なか"],["に"],["、"],["わたしたち"],["が"],["御父","おちち"],["から"],["受けた","うけた"],["掟","おきて"],["どおり"],["に"],["、"],["真理","しんり"],["に"],["歩んで","あゆんで"],["いる"],["人","ひと"],["が"],["いる"],["の"],["を"],["知って","しって"],["、"],["大変","たいへん"],["うれしく"],["思いました","おもいました"],["。"]]},{"verse":5,"text":"さて、婦人よ、あなたにお願いしたいことがあります。わたしが書くのは新しい掟ではなく、初めからわたしたちが持っていた掟、つまり互いに愛し合うということです。","tok":[["さて"],["、"],["婦人","ふじん"],["よ"],["、"],["あなた"],["に"],["お願い","おねがい"],["したい"],["こと"],["が"],["あります"],["。"],["わたし"],["が"],["書く","かく"],["の"],["は"],["新しい","あたらしい"],["掟","おきて"],["で"],["は"],["なく"],["、"],["初め","はじめ"],["から"],["わたしたち"],["が"],["持って","もって"],["いた"],["掟","おきて"],["、"],["つまり"],["互い","たがい"],["に"],["愛し合う","あいしあう"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":6,"text":"愛とは、御父の掟に従って歩むことであり、この掟とは、あなたがたが初めから聞いていたように、愛に歩むことです。","tok":[["愛","あい"],["と"],["は"],["、"],["御父","おちち"],["の"],["掟","おきて"],["に"],["従って","したがって"],["歩む","あゆむ"],["こと"],["で"],["あり"],["、"],["この"],["掟","おきて"],["と"],["は"],["、"],["あなた"],["がた"],["が"],["初め","はじめ"],["から"],["聞いて","きいて"],["いた"],["よう"],["に"],["、"],["愛","あい"],["に"],["歩む","あゆむ"],["こと"],["です"],["。"]]},{"verse":7,"text":"このように書くのは、人を惑わす者が大勢世に出て来たからです。彼らは、イエス‧キリストが肉となって来られたことを公に言い表そうとしません。こういう者は人を惑わす者、反キリストです。","tok":[["この"],["よう"],["に"],["書く","かく"],["の"],["は"],["、"],["人","ひと"],["を"],["惑わす","まどわす"],["者","もの"],["が"],["大勢世","たいせいせい"],["に"],["出て","でて"],["来た","きた"],["から"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["イエス"],["‧"],["キリスト"],["が"],["肉","にく"],["と"],["なって"],["来られた","こられた"],["こと"],["を"],["公","おおやけ"],["に"],["言い表そう","いいあらわそう"],["と"],["しません"],["。"],["こう"],["いう"],["者","もの"],["は"],["人","ひと"],["を"],["惑わす","まどわす"],["者","もの"],["、"],["反","はん"],["キリスト"],["です"],["。"]]},{"verse":8,"text":"気をつけて、わたしたちが努力して得たものを失うことなく、豊かな報いを受けるようにしなさい。","tok":[["気","き"],["を"],["つけて"],["、"],["わたしたち"],["が"],["努力","どりょく"],["して"],["得た","えた"],["もの"],["を"],["失う","うしなう"],["こと"],["なく"],["、"],["豊か","ゆたか"],["な"],["報い","むくい"],["を"],["受ける","うける"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":9,"text":"だれであろうと、キリストの教えを越えて、これにとどまらない者は、神に結ばれていません。その教えにとどまっている人にこそ、御父も御子もおられます。","tok":[["だれ"],["で"],["あろう"],["と"],["、"],["キリスト"],["の"],["教え","おしえ"],["を"],["越えて","こえて"],["、"],["これ"],["に"],["とどまらない"],["者","もの"],["は"],["、"],["神","かみ"],["に"],["結ばれて","むすばれて"],["いません"],["。"],["その"],["教え","おしえ"],["に"],["とどまって"],["いる"],["人","ひと"],["に"],["こそ"],["、"],["御父","おちち"],["も"],["御子","みこ"],["も"],["おられます"],["。"]]},{"verse":10,"text":"この教えを携えずにあなたがたのところに来る者は、家に入れてはなりません。挨拶してもなりません。","tok":[["この"],["教え","おしえ"],["を"],["携えず","たずさえず"],["に"],["あなた"],["がた"],["の"],["ところ"],["に"],["来る","くる"],["者","もの"],["は"],["、"],["家","いえ"],["に"],["入れて","いれて"],["は"],["なりません"],["。"],["挨拶","あいさつ"],["して"],["も"],["なりません"],["。"]]},{"verse":11,"text":"そのような者に挨拶する人は、その悪い行いに加わるのです。","tok":[["その"],["よう"],["な"],["者","もの"],["に"],["挨拶","あいさつ"],["する"],["人","ひと"],["は"],["、"],["その"],["悪い","わるい"],["行い","おこない"],["に"],["加わる","くわわる"],["の"],["です"],["。"]]},{"verse":12,"text":"あなたがたに書くことはまだいろいろありますが、紙とインクで書こうとは思いません。わたしたちの喜びが満ちあふれるように、あなたがたのところに行って親しく話し合いたいものです。","tok":[["あなた"],["がた"],["に"],["書く","かく"],["こと"],["は"],["まだ"],["いろいろ"],["あります"],["が"],["、"],["紙","かみ"],["と"],["インク"],["で"],["書こう","かこう"],["と"],["は"],["思いません","おもいません"],["。"],["わたしたち"],["の"],["喜び","よろこび"],["が"],["満ちあふれる","みちあふれる"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["ところ"],["に"],["行って","いって"],["親しく","したしく"],["話し合いたい","はなしあいたい"],["もの"],["です"],["。"]]},{"verse":13,"text":"あなたの姉妹、選ばれた婦人の子供たちが、あなたによろしくと言っています。","tok":[["あなた"],["の"],["姉妹","しまい"],["、"],["選ばれた","えらばれた"],["婦人","ふじん"],["の"],["子供","こども"],["たち"],["が"],["、"],["あなた"],["に"],["よろしく"],["と"],["言って","いって"],["います"],["。"]]}]
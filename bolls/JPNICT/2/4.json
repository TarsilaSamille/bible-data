,["あろう"],["。"]]},{"verse":15,"text":"彼によく話し、語るべき言葉を彼の口に託すがよい。わたしはあなたの口と共にあり、また彼の口と共にあって、あなたたちのなすべきことを教えよう。","tok":[["彼","かれ"],["に"],["よく"],["話し","はなし"],["、"],["語るべき","かたるべき"],["言葉","ことば"],["を"],["彼","かれ"],["の"],["口","くち"],["に"],["託す","たくす"],["が"],["よい"],["。"],["わたし"],["は"],["あなた"],["の"],["口","くち"],["と"],["共","とも"],["に"],["あり"],["、"],["また"],["彼","かれ"],["の"],["口","くち"],["と"],["共","とも"],["に"],["あって"],["、"],["あなた"],["たち"],["の"],["なすべき"],["こと"],["を"],["教えよう","おしえよう"],["。"]]},{"verse":16,"text":"彼はあなたに代わって民に語る。彼はあなたの口となり、あなたは彼に対して神の代わりとなる。","tok":[["彼","かれ"],["は"],["あなた"],["に"],["代わって","かわって"],["民","みん"],["に"],["語る","かたる"],["。"],["彼","かれ"],["は"],["あなた"],["の"],["口","くち"],["と"],["なり"],["、"],["あなた"],["は"],["彼","かれ"],["に対して","にたいして"],["神","かみ"],["の"],["代わり","かわり"],["と"],["なる"],["。"]]},{"verse":17,"text":"あなたはこの杖を手に取って、しるしを行うがよい。」","tok":[["あなた"],["は"],["この"],["杖","つえ"],["を"],["手","て"],["に"],["取って","とって"],["、"],["しるし"],["を"],["行う","おこなう"],["が"],["よい"],["。"],["」"]]},{"verse":18,"text":"モーセがしゅうとのエトロのもとに帰って、「エジプトにいる親族のもとへ帰らせてください。まだ元気でいるかどうか見届けたいのです」と言うと、エトロは言った。「無事で行きなさい。」","tok":[["モーセ"],["が"],["しゅうと"],["の"],["エトロ"],["の"],["もと"],["に"],["帰って","かえって"],["、"],["「"],["エジプト"],["に"],["いる"],["親族","しんぞく"],["の"],["もと"],["へ"],["帰らせて","かえらせて"],["ください"],["。"],["まだ"],["元気","げんき"],["で"],["いる"],["か"],["どう"],["か"],["見届けたい","みとどけたい"],["の"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"],["エトロ"],["は"],["言った","いった"],["。"],["「"],["無事","ぶじ"],["で"],["行き","いき"],["なさい"],["。"],["」"]]},{"verse":19,"text":"主はミディアンでモーセに言われた。「さあ、エジプトに帰るがよい、あなたの命をねらっていた者は皆、死んでしまった。」","tok":[["主","ぬし"],["は"],["ミディアン"],["で"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["さあ"],["、"],["エジプト"],["に"],["帰る","かえる"],["がよい"],["、"],["あなた"],["の"],["命","いのち"],["を"],["ねらって"],["いた"],["者","もの"],["は"],["皆","みな"],["、"],["死んで","しんで"],["しまった"],["。"],["」"]]},{"verse":20,"text":"モーセは、妻子をろばに乗せ、手には神の杖を携えて、エジプトの国を指して帰って行った。","tok":[["モーセ"],["は"],["、"],["妻子","さいし"],["を"],["ろば"],["に"],["乗せ","のせ"],["、"],["手","て"],["に"],["は"],["神","かみ"],["の"],["杖","つえ"],["を"],["携えて","たずさえて"],["、"],["エジプト"],["の"],["国","くに"],["を"],["指して","さして"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":21,"text":"主はモーセに言われた。「エジプトに帰ったら、わたしがあなたの手に授けたすべての奇跡を、心してファラオの前で行うがよい。しかし、わたしが彼の心をかたくなにするので、王は民を去らせないであろう。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["エジプト"],["に"],["帰ったら","かえったら"],["、"],["わたし"],["が"],["あなた"],["の"],["手","て"],["に"],["授けた","さずけた"],["すべて"],["の"],["奇跡","きせき"],["を"],["、"],["心","こころ"],["して"],["ファラオ"],["の"],["前","まえ"],["で"],["行う","おこなう"],["が"],["よい"],["。"],["しかし"],["、"],["わたし"],["が"],["彼","かれ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["ので"],["、"],["王","おう"],["は"],["民","みん"],["を"],["去らせないで","さらせないで"],["あろう"],["。"]]},{"verse":22,"text":"あなたはファラオに言うがよい。主はこう言われた。『イスラエルはわたしの子、わたしの長子である。","tok":[["あなた"],["は"],["ファラオ"],["に"],["言う","ゆう"],["が"],["よい"],["。"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["『"],["イスラエル"],["は"],["わたし"],["の"],["子","こ"],["、"],["わたし"],["の"],["長子","ちょうし"],["で"],["ある"],["。"]]},{"verse":23,"text":"わたしの子を去らせてわたしに仕えさせよと命じたのに、お前はそれを断った。それゆえ、わたしはお前の子、お前の長子を殺すであろう』と。」","tok":[["わたし"],["の"],["子","こ"],["を"],["去らせて","さらせて"],["わたし"],["に"],["仕えさせよ","つかえさせよ"],["と"],["命じた","めいじた"],["のに"],["、"],["お前","おまえ"],["は"],["それ"],["を"],["断った","ことわった"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["お前","おまえ"],["の"],["子","こ"],["、"],["お前","おまえ"],["の"],["長子","ちょうし"],["を"],["殺すで","ころすで"],["あろう"],["』"],["と"],["。"],["」"]]},{"verse":24,"text":"途中、ある所に泊まったとき、主はモーセと出会い、彼を殺そうとされた。","tok":[["途中","とちゅう"],["、"],["ある"],["所","ところ"],["に"],["泊まった","とまった"],["とき"],["、"],["主","ぬし"],["は"],["モーセ"],["と"],["出会い","であい"],["、"],["彼","かれ"],["を"],["殺そう","ころそう"],["と"],["された"],["。"]]},{"verse":25,"text":"ツィポラは、とっさに石刀を手にして息子の包皮を切り取り、それをモーセの両足に付け、「わたしにとって、あなたは血の花婿です」と叫んだので、","tok":[["ツィポラ"],["は"],["、"],["とっさ"],["に"],["石刀","せきとう"],["を"],["手","て"],["に"],["して"],["息子","むすこ"],["の"],["包皮","ほうひ"],["を"],["切り取り","きりとり"],["、"],["それ"],["を"],["モーセ"],["の"],["両足","りょうあし"],["に"],["付け","つけ"],["、"],["「"],["わたし"],["にとって"],["、"],["あなた"],["は"],["血","ち"],["の"],["花婿","はなむこ"],["です"],["」"],["と"],["叫んだ","さけんだ"],["ので"],["、"]]},{"verse":26,"text":"主は彼を放された。彼女は、そのとき、割礼のゆえに「血の花婿」と言ったのである。","tok":[["主","ぬし"],["は"],["彼","かれ"],["を"],["放された","はなされた"],["。"],["彼女","かのじょ"],["は"],["、"],["その"],["とき"],["、"],["割礼","かつれい"],["の"],["ゆえ"],["に"],["「"],["血","ち"],["の"],["花婿","はなむこ"],["」"],["と"],["言った","いった"],["ので"],["ある"],["。"]]},{"verse":27,"text":"主はアロンに向かって、「さあ、荒れ野へ行って、モーセに会いなさい」と命じられたので、彼は出かけて行き、神の山でモーセと会い、口づけした。","tok":[["主","ぬし"],["は"],["アロン"],["に"],["向かって","むかって"],["、"],["「"],["さあ"],["、"],["荒れ野","あれの"],["へ"],["行って","いって"],["、"],["モーセ"],["に"],["会い","あい"],["なさい"],["」"],["と"],["命じられた","めいじられた"],["ので"],["、"],["彼","かれ"],["は"],["出かけて","でかけて"],["行き","いき"],["、"],["神","かみ"],["の"],["山","やま"],["で"],["モーセ"],["と"],["会い","あい"],["、"],["口づけ","くちづけ"],["した"],["。"]]},{"verse":28,"text":"モーセは自分を遣わされた主の言葉と、命じられたしるしをすべてアロンに告げた。","tok":[["モーセ"],["は"],["自分","じぶん"],["を"],["遣わされた","つかわされた"],["主","ぬし"],["の"],["言葉","ことば"],["と"],["、"],["命じられた","めいじられた"],["しるし"],["を"],["すべて"],["アロン"],["に"],["告げた","つげた"],["。"]]},{"verse":29,"text":"モーセはアロンを伴って出かけ、イスラエルの人々の長老を全員集めた。","tok":[["モーセ"],["は"],["アロン"],["を"],["伴って","ともなって"],["出かけ","でかけ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["長老","ちょうろう"],["を"],["全員","ぜんいん"],["集めた","あつめた"],["。"]]},{"verse":30,"text":"アロンは主がモーセに語られた言葉をことごとく語り、民の面前でしるしを行ったので、","tok":[["アロン"],["は"],["主","ぬし"],["が"],["モーセ"],["に"],["語られた","かたられた"],["言葉","ことば"],["を"],["ことごとく"],["語り","かたり"],["、"],["民","みん"],["の"],["面前","めんぜん"],["で"],["しるし"],["を"],["行った","おこなった"],["ので"],["、"]]},{"verse":31,"text":"民は信じた。また、主が親しくイスラエルの人々を顧み、彼らの苦しみを御覧になったということを聞き、ひれ伏して礼拝した。","tok":[["民","みん"],["は"],["信じた","しんじた"],["。"],["また"],["、"],["主","ぬし"],["が"],["親しく","したしく"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["顧み","かえりみ"],["、"],["彼","かれ"],["ら"],["の"],["苦しみ","くるしみ"],["を"],["御覧","ごらん"],["に"],["なった"],["と"],["いう"],["こと"],["を"],["聞き","きき"],["、"],["ひれ伏して","ひれふして"],["礼拝","れいはい"],["した"],["。"]]}]
[{"verse":1,"text":"主はモーセに言われた。「見よ、わたしは、あなたをファラオに対しては神の代わりとし、あなたの兄アロンはあなたの預言者となる。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["あなた"],["を"],["ファラオ"],["に対して","にたいして"],["は"],["神","かみ"],["の"],["代わり","かわり"],["と"],["し"],["、"],["あなた"],["の"],["兄","あに"],["アロン"],["は"],["あなた"],["の"],["預言者","よげんしゃ"],["と"],["なる"],["。"]]},{"verse":2,"text":"わたしが命じるすべてのことをあなたが語れば、あなたの兄アロンが、イスラエルの人々を国から去らせるよう、ファラオに語るであろう。","tok":[["わたし"],["が"],["命じる","めいじる"],["すべて"],["の"],["こと"],["を"],["あなた"],["が"],["語れば","かたれば"],["、"],["あなた"],["の"],["兄","あに"],["アロン"],["が"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["国","くに"],["から"],["去らせる","さらせる"],["よう"],["、"],["ファラオ"],["に"],["語るで","かたるで"],["あろう"],["。"]]},{"verse":3,"text":"しかし、わたしはファラオの心をかたくなにするので、わたしがエジプトの国でしるしや奇跡を繰り返したとしても、","tok":[["しかし"],["、"],["わたし"],["は"],["ファラオ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["する"],["ので"],["、"],["わたし"],["が"],["エジプト"],["の"],["国","くに"],["で"],["しるし"],["や"],["奇跡","きせき"],["を"],["繰り返した","くりかえした"],["として"],["も"],["、"]]},{"verse":4,"text":"ファラオはあなたたちの言うことを聞かない。わたしはエジプトに手を下し、大いなる審判によって、わたしの部隊、わたしの民イスラエルの人々をエジプトの国から導き出す。","tok":[["ファラオ"],["は"],["あなた"],["たち"],["の"],["言う","いう"],["こと"],["を"],["聞かない","きかない"],["。"],["わたし"],["は"],["エジプト"],["に"],["手","て"],["を"],["下し","くだし"],["、"],["大いなる","おおいなる"],["審判","しんぱん"],["によって"],["、"],["わたし"],["の"],["部隊","ぶたい"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出す","みちびきだす"],["。"]]},{"verse":5,"text":"わたしがエジプトに対して手を伸ばし、イスラエルの人々をその中から導き出すとき、エジプト人は、わたしが主であることを知るようになる。」","tok":[["わたし"],["が"],["エジプト"],["に対して","にたいして"],["手","て"],["を"],["伸ばし","のばし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["その"],["中","なか"],["から"],["導き出す","みちびきだす"],["とき"],["、"],["エジプト"],["人","にん"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":6,"text":"モーセとアロンは、主が命じられたとおりに行った。","tok":[["モーセ"],["と"],["アロン"],["は"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"]]},{"verse":7,"text":"ファラオに語ったとき、モーセは八十歳、アロンは八十三歳であった。","tok":[["ファラオ"],["に"],["語った","かたった"],["とき"],["、"],["モーセ"],["は"],["八十歳","はちじゅうさい"],["、"],["アロン"],["は"],["八十三歳","はちじゅうさんさい"],["で"],["あった"],["。"]]},{"verse":8,"text":"主はモーセとアロンに言われた。","tok":[["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["。"]]},{"verse":9,"text":"「もし、ファラオがあなたたちに向かって、『奇跡を行ってみよ』と求めるならば、あなたはアロンに、『杖を取って、ファラオの前に投げよ』と言うと、杖は蛇になる。」","tok":[["「"],["もし"],["、"],["ファラオ"],["が"],["あなた"],["たち"],["に"],["向かって","むかって"],["、"],["『"],["奇跡","きせき"],["を"],["行って","おこなって"],["み"],["よ"],["』"],["と"],["求めるならば","もとめるならば"],["、"],["あなた"],["は"],["アロン"],["に"],["、"],["『"],["杖","つえ"],["を"],["取って","とって"],["、"],["ファラオ"],["の"],["前","まえ"],["に"],["投げ","なげ"],["よ"],["』"],["と"],["言う","ゆう"],["と"],["、"],["杖","つえ"],["は"],["蛇","へび"],["に"],["なる"],["。"],["」"]]},{"verse":10,"text":"モーセとアロンはファラオのもとに行き、主の命じられたとおりに行った。アロンが自分の杖をファラオとその家臣たちの前に投げると、杖は蛇になった。","tok":[["モーセ"],["と"],["アロン"],["は"],["ファラオ"],["の"],["もと"],["に"],["行き","いき"],["、"],["主","ぬし"],["の"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"],["アロン"],["が"],["自分","じぶん"],["の"],["杖","つえ"],["を"],["ファラオ"],["と"],["その"],["家臣","かしん"],["たち"],["の"],["前","まえ"],["に"],["投げる","なげる"],["と"],["、"],["杖","つえ"],["は"],["蛇","へび"],["に"],["なった"],["。"]]},{"verse":11,"text":"そこでファラオも賢者や呪術師を召し出した。エジプトの魔術師もまた、秘術を用いて同じことを行った。","tok":[["そこ"],["で"],["ファラオ"],["も"],["賢者","けんじゃ"],["や"],["呪術師","じゅじゅつし"],["を"],["召し出した","めしだした"],["。"],["エジプト"],["の"],["魔術師","まじゅつし"],["も"],["また"],["、"],["秘術","ひじゅつ"],["を"],["用いて","もちいて"],["同じ","おなじ"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":12,"text":"それぞれ自分の杖を投げると、蛇になったが、アロンの杖は彼らの杖をのみ込んだ。","tok":[["それぞれ"],["自分","じぶん"],["の"],["杖","つえ"],["を"],["投げる","なげる"],["と"],["、"],["蛇","へび"],["に"],["なった"],["が"],["、"],["アロン"],["の"],["杖","つえ"],["は"],["彼","かれ"],["ら"],["の"],["杖","つえ"],["を"],["のみ込んだ","のみこんだ"],["。"]]},{"verse":13,"text":"しかし、ファラオの心はかたくなになり、彼らの言うことを聞かなかった。主が仰せになったとおりである。","tok":[["しかし"],["、"],["ファラオ"],["の"],["心","こころ"],["は"],["かたくな"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"],["主","ぬし"],["が"],["仰せ","おおせ"],["に"],["なった"],["とおり"],["で"],["ある"],["。"]]},{"verse":14,"text":"主はモーセに言われた。「ファラオの心は頑迷で、民を去らせない。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["ファラオ"],["の"],["心","こころ"],["は"],["頑迷","がんめい"],["で"],["、"],["民","みん"],["を"],["去らせない","さらせない"],["。"]]},{"verse":15,"text":"明朝、ファラオのところへ行きなさい。彼は水辺に下りて来る。あなたは蛇になったあの杖を手に持ち、ナイル川の岸辺に立って、彼を待ち受け、","tok":[["明朝","みょうちょう"],["、"],["ファラオ"],["の"],["ところ"],["へ"],["行き","いき"],["なさい"],["。"],["彼","かれ"],["は"],["水辺","みずべ"],["に"],["下りて","おりて"],["来る","くる"],["。"],["あなた"],["は"],["蛇","へび"],["に"],["なった"],["あの"],["杖","つえ"],["を"],["手","て"],["に"],["持ち","もち"],["、"],["ナイル"],["川","かわ"],["の"],["岸辺","きしべ"],["に"],["立って","たって"],["、"],["彼","かれ"],["を"],["待ち受け","まちうけ"],["、"]]},{"verse":16,"text":"彼に言いなさい。ヘブライ人の神、主がわたしをあなたのもとに遣わして、『わたしの民を去らせ、荒れ野でわたしに仕えさせよ』と命じられたのに、あなたは今に至るまで聞き入れない。","tok":[["彼","かれ"],["に"],["言い","いい"],["なさい"],["。"],["ヘブライ"],["人","にん"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["わたし"],["を"],["あなた"],["の"],["もと"],["に"],["遣わして","つかわして"],["、"],["『"],["わたし"],["の"],["民","たみ"],["を"],["去らせ","さらせ"],["、"],["荒れ野","あれの"],["で"],["わたし"],["に"],["仕えさせよ","つかえさせよ"],["』"],["と"],["命じられた","めいじられた"],["のに"],["、"],["あなた"],["は"],["今","いま"],["に"],["至る","いたる"],["まで"],["聞き入れない","ききいれない"],["。"]]},{"verse":17,"text":"主はこう言われた。『このことによって、あなたは、わたしが主であることを知る』と。見よ、わたしの手にある杖でナイル川の水を打つと、水は血に変わる。","tok":[["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["『"],["この"],["こと"],["によって"],["、"],["あなた"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["』"],["と"],["。"],["見よ","みよ"],["、"],["わたし"],["の"],["手","て"],["に"],["ある"],["杖","つえ"],["で"],["ナイル"],["川","かわ"],["の"],["水","みず"],["を"],["打つ","うつ"],["と"],["、"],["水","みず"],["は"],["血","ち"],["に"],["変わる","かわる"],["。"]]},{"verse":18,"text":"川の魚は死に、川は悪臭を放つ。エジプト人はナイル川の水を飲むのを嫌がるようになる。」","tok":[["川","かわ"],["の"],["魚","さかな"],["は"],["死に","しに"],["、"],["川","かわ"],["は"],["悪臭","あくしゅう"],["を"],["放つ","はなつ"],["。"],["エジプト"],["人","にん"],["は"],["ナイル"],["川","かわ"],["の"],["水","みず"],["を"],["飲む","のむ"],["の"],["を"],["嫌","いや"],["がる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":19,"text":"主は更にモーセに言われた。「アロンに言いなさい。『杖を取り、エジプトの水という水の上、河川、水路、池、水たまりの上に手を伸ばし、血に変えなさい』と。エジプトの国中、木や石までも血に浸るであろう。」","tok":[["主","ぬし"],["は"],["更に","さらに"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["アロン"],["に"],["言い","いい"],["なさい"],["。"],["『"],["杖","つえ"],["を"],["取り","とり"],["、"],["エジプト"],["の"],["水","みず"],["と"],["いう"],["水","みず"],["の"],["上","うえ"],["、"],["河川","かせん"],["、"],["水路","すいろ"],["、"],["池","いけ"],["、"],["水たまり","みずたまり"],["の"],["上","うえ"],["に"],["手","て"],["を"],["伸ばし","のばし"],["、"],["血","ち"],["に"],["変え","かえ"],["なさい"],["』"],["と"],["。"],["エジプト"],["の"],["国中","くにちゅう"],["、"],["木","き"],["や"],["石","いし"],["まで"],["も"],["血","ち"],["に"],["浸るで","ひたるで"],["あろう"],["。"],["」"]]},{"verse":20,"text":"モーセとアロンは、主の命じられたとおりにした。彼は杖を振り上げて、ファラオとその家臣の前でナイル川の水を打った。川の水はことごとく血に変わり、","tok":[["モーセ"],["と"],["アロン"],["は"],["、"],["主","ぬし"],["の"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"],["彼","かれ"],["は"],["杖","つえ"],["を"],["振り上げて","ふりあげて"],["、"],["ファラオ"],["と"],["その"],["家臣","かしん"],["の"],["前","まえ"],["で"],["ナイル"],["川","かわ"],["の"],["水","みず"],["を"],["打った","うった"],["。"],["川","かわ"],["の"],["水","みず"],["は"],["ことごとく"],["血","ち"],["に"],["変わり","かわり"],["、"]]},{"verse":21,"text":"川の魚は死に、川は悪臭を放ち、エジプト人はナイル川の水を飲めなくなった。こうして、エジプトの国中が血に浸った。","tok":[["川","かわ"],["の"],["魚","さかな"],["は"],["死に","しに"],["、"],["川","かわ"],["は"],["悪臭","あくしゅう"],["を"],["放ち","はなち"],["、"],["エジプト"],["人","にん"],["は"],["ナイル"],["川","かわ"],["の"],["水","みず"],["を"],["飲めなく","のめなく"],["なった"],["。"],["こう"],["して"],["、"],["エジプト"],["の"],["国中","くにちゅう"],["が"],["血","ち"],["に"],["浸った","ひたった"],["。"]]},{"verse":22,"text":"ところが、エジプトの魔術師も秘術を用いて同じことを行ったのでファラオの心はかたくなになり、二人の言うことを聞かなかった。主が仰せになったとおりである。","tok":[["ところ"],["が"],["、"],["エジプト"],["の"],["魔術師","まじゅつし"],["も"],["秘術","ひじゅつ"],["を"],["用いて","もちいて"],["同じ","おなじ"],["こと"],["を"],["行った","おこなった"],["ので"],["ファラオ"],["の"],["心","こころ"],["は"],["かたくな"],["に"],["なり"],["、"],["二人","ふたり"],["の"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"],["主","ぬし"],["が"],["仰せ","おおせ"],["に"],["なった"],["とおり"],["で"],["ある"],["。"]]},{"verse":23,"text":"ファラオは王宮に引き返し、このことをも心に留めなかった。","tok":[["ファラオ"],["は"],["王宮","おうきゅう"],["に"],["引き返し","ひきかえし"],["、"],["この"],["こと"],["を"],["も"],["心","こころ"],["に"],["留めなかった","とめなかった"],["。"]]},{"verse":24,"text":"エジプト人は皆、飲み水を求めて、ナイル川の周りを掘った。ナイルの水が飲めなくなったからである。","tok":[["エジプト"],["人","にん"],["は"],["皆","みな"],["、"],["飲み水","のみみず"],["を"],["求めて","もとめて"],["、"],["ナイル"],["川","かわ"],["の"],["周り","まわり"],["を"],["掘った","ほった"],["。"],["ナイル"],["の"],["水","みず"],["が"],["飲めなく","のめなく"],["なった"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"主がナイル川を打たれてから七日たつと、","tok":[["主","ぬし"],["が"],["ナイル"],["川","かわ"],["を"],["打たれて","うたれて"],["から"],["七日","ななか"],["たつ"],["と"],["、"]]},{"verse":26,"text":"主はモーセに言われた。「ファラオのもとに行って、彼に言いなさい。主はこう言われた。『わたしの民を去らせ、わたしに仕えさせよ。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["ファラオ"],["の"],["もと"],["に"],["行って","いって"],["、"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["。"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["去らせ","さらせ"],["、"],["わたし"],["に"],["仕えさせ","つかえさせ"],["よ"],["。"]]},{"verse":27,"text":"もしあなたが去らせることを拒むならば、わたしはあなたの領土全体に蛙の災いを引き起こす。","tok":[["もし"],["あなた"],["が"],["去らせる","さらせる"],["こと"],["を"],["拒むならば","こばむならば"],["、"],["わたし"],["は"],["あなた"],["の"],["領土","りょうど"],["全体","ぜんたい"],["に"],["蛙","かわず"],["の"],["災い","わざわい"],["を"],["引き起こす","ひきおこす"],["。"]]},{"verse":28,"text":"ナイル川に蛙が群がり、あなたの王宮を襲い、寝室に侵入し、寝台に上り、更に家臣や民の家にまで侵入し、かまど、こね鉢にも入り込む。","tok":[["ナイル"],["川","かわ"],["に"],["蛙","かわず"],["が"],["群がり","むらがり"],["、"],["あなた"],["の"],["王宮","おうきゅう"],["を"],["襲い","おそい"],["、"],["寝室","しんしつ"],["に"],["侵入","しんにゅう"],["し"],["、"],["寝台","しんだい"],["に"],["上り","のぼり"],["、"],["更に","さらに"],["家臣","かしん"],["や"],["民","たみ"],["の"],["家","いえ"],["に"],["まで"],["侵入","しんにゅう"],["し"],["、"],["かまど"],["、"],["こね鉢","こねばち"],["に"],["も"],["入り込む","はいりこむ"],["。"]]},{"verse":29,"text":"蛙はあなたも民もすべての家臣をも襲うであろう』と。」","tok":[["蛙","かわず"],["は"],["あなた"],["も"],["民","みん"],["も"],["すべて"],["の"],["家臣","かしん"],["を"],["も"],["襲うで","
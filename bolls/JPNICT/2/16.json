[{"verse":1,"text":"イスラエルの人々の共同体全体はエリムを出発し、エリムとシナイとの間にあるシンの荒れ野に向かった。それはエジプトの国を出た年の第二の月の十五日であった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["エリム"],["を"],["出発","しゅっぱつ"],["し"],["、"],["エリム"],["と"],["シナイ"],["と"],["の"],["間","あいだ"],["に"],["ある"],["シン"],["の"],["荒れ野","あれの"],["に"],["向かった","むかった"],["。"],["それ"],["は"],["エジプト"],["の"],["国","くに"],["を"],["出た","でた"],["年","とし"],["の"],["第","だい"],["二","に"],["の"],["月","つき"],["の"],["十五","じゅうご"],["日","にち"],["で"],["あった"],["。"]]},{"verse":2,"text":"荒れ野に入ると、イスラエルの人々の共同体全体はモーセとアロンに向かって不平を述べ立てた。","tok":[["荒れ野","あれの"],["に"],["入る","はいる"],["と"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["モーセ"],["と"],["アロン"],["に"],["向かって","むかって"],["不平","ふへい"],["を"],["述べ立てた","のべたてた"],["。"]]},{"verse":3,"text":"イスラエルの人々は彼らに言った。「我々はエジプトの国で、主の手にかかって、死んだ方がましだった。あのときは肉のたくさん入った鍋の前に座り、パンを腹いっぱい食べられたのに。あなたたちは我々をこの荒れ野に連れ出し、この全会衆を飢え死にさせようとしている。」","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["我々","われわれ"],["は"],["エジプト"],["の"],["国","くに"],["で"],["、"],["主","ぬし"],["の"],["手","て"],["に"],["かかって"],["、"],["死んだ","しんだ"],["方","ほう"],["が"],["まし"],["だった"],["。"],["あの"],["とき"],["は"],["肉","にく"],["の"],["たくさん"],["入った","はいった"],["鍋","なべ"],["の"],["前","まえ"],["に"],["座り","すわり"],["、"],["パン"],["を"],["腹","ふく"],["いっぱい"],["食べられた","たべられた"],["のに"],["。"],["あなた"],["たち"],["は"],["我々","われわれ"],["を"],["この"],["荒れ野","あれの"],["に"],["連れ出し","つれだし"],["、"],["この"],["全","ぜん"],["会衆","かいしゅう"],["を"],["飢え死に","うえじに"],["させよう"],["として"],["いる"],["。"],["」"]]},{"verse":4,"text":"主はモーセに言われた。「見よ、わたしはあなたたちのために、天からパンを降らせる。民は出て行って、毎日必要な分だけ集める。わたしは、彼らがわたしの指示どおりにするかどうかを試す。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["ため"],["に"],["、"],["天","てん"],["から"],["パン"],["を"],["降らせる","ふらせる"],["。"],["民","たみ"],["は"],["出て","でて"],["行って","いって"],["、"],["毎日","まいにち"],["必要","ひつよう"],["な"],["分","ぶん"],["だけ"],["集める","あつめる"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["指示","しじ"],["どおり"],["に"],["する"],["か"],["どう"],["か"],["を"],["試す","ためす"],["。"]]},{"verse":5,"text":"ただし、六日目に家に持ち帰ったものを整えれば、毎日集める分の二倍になっている。」","tok":[["ただし"],["、"],["六日目","むいかめ"],["に"],["家","いえ"],["に"],["持ち帰った","もちかえった"],["もの"],["を"],["整えれば","ととのえれば"],["、"],["毎日","まいにち"],["集める","あつめる"],["分","ぶん"],["の"],["二","に"],["倍","ばい"],["に"],["なって"],["いる"],["。"],["」"]]},{"verse":6,"text":"モーセとアロンはすべてのイスラエルの人々に向かって言った。「夕暮れに、あなたたちは、主があなたたちをエジプトの国から導き出されたことを知り、","tok":[["モーセ"],["と"],["アロン"],["は"],["すべて"],["の"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["向かって","むかって"],["言った","いった"],["。"],["「"],["夕暮れ","ゆうぐれ"],["に"],["、"],["あなた"],["たち"],["は"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出された","みちびきだされた"],["こと"],["を"],["知り","しり"],["、"]]},{"verse":7,"text":"朝に、主の栄光を見る。あなたたちが主に向かって不平を述べるのを主が聞かれたからだ。我々が何者なので、我々に向かって不平を述べるのか。」","tok":[["朝","あさ"],["に"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["を"],["見る","みる"],["。"],["あなた"],["たち"],["が"],["主に","おもに"],["向かって","むかって"],["不平","ふへい"],["を"],["述べる","のべる"],["の"],["を"],["主","ぬし"],["が"],["聞かれた","きかれた"],["から"],["だ"],["。"],["我々","われわれ"],["が"],["何者","なにもの"],["な"],["ので"],["、"],["我々","われわれ"],["に"],["向かって","むかって"],["不平","ふへい"],["を"],["述べる","のべる"],["の"],["か"],["。"],["」"]]},{"verse":8,"text":"モーセは更に言った。「主は夕暮れに、あなたたちに肉を与えて食べさせ、朝にパンを与えて満腹にさせられる。主は、あなたたちが主に向かって述べた不平を、聞かれたからだ。一体、我々は何者なのか。あなたたちは我々に向かってではなく、実は、主に向かって不平を述べているのだ。」","tok":[["モーセ"],["は"],["更に","さらに"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["夕暮れ","ゆうぐれ"],["に"],["、"],["あなた"],["たち"],["に"],["肉","にく"],["を"],["与えて","あたえて"],["食べさせ","たべさせ"],["、"],["朝","あさ"],["に"],["パン"],["を"],["与えて","あたえて"],["満腹","まんぷく"],["に"],["させられる"],["。"],["主","ぬし"],["は"],["、"],["あなた"],["たち"],["が"],["主に","おもに"],["向かって","むかって"],["述べた","のべた"],["不平","ふへい"],["を"],["、"],["聞かれた","きかれた"],["から"],["だ"],["。"],["一体","いったい"],["、"],["我々","われわれ"],["は"],["何者","なにもの"],["な"],["の"],["か"],["。"],["あなた"],["たち"],["は"],["我々","われわれ"],["に"],["向かって","むかって"],["で"],["は"],["なく"],["、"],["実","じつ"],["は"],["、"],["主に","おもに"],["向かって","むかって"],["不平","ふへい"],["を"],["述べて","のべて"],["いる"],["の"],["だ"],["。"],["」"]]},{"verse":9,"text":"モーセがアロンに、「あなたはイスラエルの人々の共同体全体に向かって、主があなたたちの不平を聞かれたから、主の前に集まれと命じなさい」と言うと、","tok":[["モーセ"],["が"],["アロン"],["に"],["、"],["「"],["あなた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["に"],["向かって","むかって"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["の"],["不平","ふへい"],["を"],["聞かれた","きかれた"],["から"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["集まれ","あつまれ"],["と"],["命じ","めいじ"],["なさい"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":10,"text":"アロンはイスラエルの人々の共同体全体にそのことを命じた。彼らが荒れ野の方を見ると、見よ、主の栄光が雲の中に現れた。","tok":[["アロン"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["に"],["その"],["こと"],["を"],["命じた","めいじた"],["。"],["彼","かれ"],["ら"],["が"],["荒れ野","あれの"],["の"],["方","ほう"],["を"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["雲","くも"],["の"],["中","なか"],["に"],["現れた","あらわれた"],["。"]]},{"verse":11,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":12,"text":"「わたしは、イスラエルの人々の不平を聞いた。彼らに伝えるがよい。『あなたたちは夕暮れには肉を食べ、朝にはパンを食べて満腹する。あなたたちはこうして、わたしがあなたたちの神、主であることを知るようになる』と。」","tok":[["「"],["わたし"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["不平","ふへい"],["を"],["聞いた","きいた"],["。"],["彼","かれ"],["ら"],["に"],["伝える","つたえる"],["が"],["よい"],["。"],["『"],["あなた"],["たち"],["は"],["夕暮れ","ゆうぐれ"],["に"],["は"],["肉","にく"],["を"],["食べ","たべ"],["、"],["朝","あさ"],["に"],["は"],["パン"],["を"],["食べて","たべて"],["満腹","まんぷく"],["する"],["。"],["あなた"],["たち"],["は"],["こう"],["して"],["、"],["わたし"],["が"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["』"],["と"],["。"],["」"]]},{"verse":13,"text":"夕方になると、うずらが飛んで来て、宿営を覆い、朝には宿営の周りに露が降りた。","tok":[["夕方","ゆうがた"],["に"],["なる"],["と"],["、"],["うずら"],["が"],["飛んで","とんで"],["来て","きて"],["、"],["宿営","しゅくえい"],["を"],["覆い","おおい"],["、"],["朝","あさ"],["に"],["は"],["宿営","しゅくえい"],["の"],["周り","まわり"],["に"],["露","ろ"],["が"],["降りた","おりた"],["。"]]},{"verse":14,"text":"この降りた露が蒸発すると、見よ、荒れ野の地表を覆って薄くて壊れやすいものが大地の霜のように薄く残っていた。","tok":[["この"],["降りた","おりた"],["露","ろ"],["が"],["蒸発","じょうはつ"],["する"],["と"],["、"],["見よ","みよ"],["、"],["荒れ野","あれの"],["の"],["地表","ちひょう"],["を"],["覆って","おおって"],["薄くて","うすくて"],["壊れ","こわれ"],["やすい"],["もの"],["が"],["大地","だいち"],["の"],["霜","しも"],["の"],["よう"],["に"],["薄く","うすく"],["残って","のこって"],["いた"],["。"]]},{"verse":15,"text":"イスラエルの人々はそれを見て、これは一体何だろうと、口々に言った。彼らはそれが何であるか知らなかったからである。モーセは彼らに言った。「これこそ、主があなたたちに食物として与えられたパンである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["それ"],["を"],["見て","みて"],["、"],["これ"],["は"],["一体","いったい"],["何","なん"],["だろう"],["と"],["、"],["口々","くちぐち"],["に"],["言った","いった"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["が"],["何","なん"],["で"],["ある"],["か"],["知らなかった","しらなかった"],["から"],["で"],["ある"],["。"],["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["これ"],["こそ"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["に"],["食物","しょくもつ"],["として"],["与えられた","あたえられた"],["パン"],["で"],["ある"],["。"]]},{"verse":16,"text":"主が命じられたことは次のことである。『あなたたちはそれぞれ必要な分、つまり一人当たり一オメルを集めよ。それぞれ自分の天幕にいる家族の数に応じて取るがよい。』」","tok":[["主","ぬし"],["が"],["命じられた","めいじられた"],["こと"],["は"],["次","つぎ"],["の"],["こと"],["で"],["ある"],["。"],["『"],["あなた"],["たち"],["は"],["それぞれ"],["必要","ひつよう"],["な"],["分","ぶん"],["、"],["つまり"],["一人","ひとり"],["当たり","あたり"],["一","いち"],["オメル"],["を"],["集めよ","あつめよ"],["。"],["それぞれ"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["いる"],["家族","かぞく"],["の"],["数","かず"],["に"],["応じて","おうじて"],["取る","とる"],["が"],["よい"],["。"],["』"],["」"]]},{"verse":17,"text":"イスラエルの人々はそのとおりにした。ある者は多く集め、ある者は少なく集めた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["その"],["とおり"],["に"],["した"],["。"],["ある"],["者","もの"],["は"],["多く","おおく"],["集め","あつめ"],["、"],["ある"],["者","もの"],["は"],["少なく","すくなく"],["集めた","あつめた"],["。"]]},{"verse":18,"text":"しかし、オメル升で量ってみると、多く集めた者も余ることなく、少なく集めた者も足りないことなく、それぞれが必要な分を集めた。","tok":[["しかし"],["、"],["オメル"],["升","ます"],["で"],["量って","はかって"],["みる"],["と"],["、"],["多く","おおく"],["集めた","あつめた"],["者","もの"],["も"],["余る","あまる"],["こと"],["なく"],["、"],["少なく","すくなく"],["集めた","あつめた"],["者","もの"],["も"],["足りない",
[{"verse":1,"text":"イスラエルの人々は、エジプトの国を出て三月目のその日に、シナイの荒れ野に到着した。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["エジプト"],["の"],["国","くに"],["を"],["出て","でて"],["三","さん"],["月目","がつめ"],["の"],["その"],["日","ひ"],["に"],["、"],["シナイ"],["の"],["荒れ野","あれの"],["に"],["到着","とうちゃく"],["した"],["。"]]},{"verse":2,"text":"彼らはレフィディムを出発して、シナイの荒れ野に着き、荒れ野に天幕を張った。イスラエルは、そこで、山に向かって宿営した。","tok":[["彼","かれ"],["ら"],["は"],["レフィディム"],["を"],["出発","しゅっぱつ"],["して"],["、"],["シナイ"],["の"],["荒れ野","あれの"],["に"],["着き","つき"],["、"],["荒れ野","あれの"],["に"],["天幕","てんまく"],["を"],["張った","はった"],["。"],["イスラエル"],["は"],["、"],["そこ"],["で"],["、"],["山","やま"],["に"],["向かって","むかって"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":3,"text":"モーセが神のもとに登って行くと、山から主は彼に語りかけて言われた。「ヤコブの家にこのように語りイスラエルの人々に告げなさい。","tok":[["モーセ"],["が"],["神","かみ"],["の"],["もと"],["に"],["登って","のぼって"],["行く","いく"],["と"],["、"],["山","やま"],["から"],["主","ぬし"],["は"],["彼","かれ"],["に"],["語りかけて","かたりかけて"],["言われた","いわれた"],["。"],["「"],["ヤコブ"],["の"],["家","いえ"],["に"],["この"],["よう"],["に"],["語り","かたり"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告げ","つげ"],["なさい"],["。"]]},{"verse":4,"text":"あなたたちは見たわたしがエジプト人にしたことまた、あなたたちを鷲の翼に乗せてわたしのもとに連れて来たことを。","tok":[["あなた"],["たち"],["は"],["見た","みた"],["わたし"],["が"],["エジプト"],["人","にん"],["に"],["した"],["こと"],["また"],["、"],["あなた"],["たち"],["を"],["鷲","わし"],["の"],["翼","つばさ"],["に"],["乗せて","のせて"],["わたし"],["の"],["もと"],["に"],["連れて","つれて"],["来た","きた"],["こと"],["を"],["。"]]},{"verse":5,"text":"今、もしわたしの声に聞き従いわたしの契約を守るならばあなたたちはすべての民の間にあってわたしの宝となる。世界はすべてわたしのものである。","tok":[["今","いま"],["、"],["もし"],["わたし"],["の"],["声","こえ"],["に"],["聞き従い","ききしたがい"],["わたし"],["の"],["契約","けいやく"],["を"],["守るならば","まもるならば"],["あなた"],["たち"],["は"],["すべて"],["の"],["民","たみ"],["の"],["間","あいだ"],["に"],["あって"],["わたし"],["の"],["宝","たから"],["と"],["なる"],["。"],["世界","せかい"],["は"],["すべて"],["わたし"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":6,"text":"あなたたちは、わたしにとって祭司の王国、聖なる国民となる。これが、イスラエルの人々に語るべき言葉である。」","tok":[["あなた"],["たち"],["は"],["、"],["わたし"],["にとって"],["祭司","さいし"],["の"],["王国","おうこく"],["、"],["聖","せい"],["なる"],["国民","こくみん"],["と"],["なる"],["。"],["これ"],["が"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["語るべき","かたるべき"],["言葉","ことば"],["で"],["ある"],["。"],["」"]]},{"verse":7,"text":"モーセは戻って、民の長老たちを呼び集め、主が命じられた言葉をすべて彼らの前で語った。","tok":[["モーセ"],["は"],["戻って","もどって"],["、"],["民","みん"],["の"],["長老","ちょうろう"],["たち"],["を"],["呼び集め","よびあつめ"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["言葉","ことば"],["を"],["すべて"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["語った","かたった"],["。"]]},{"verse":8,"text":"民は皆、一斉に答えて、「わたしたちは、主が語られたことをすべて、行います」と言った。モーセが民の言葉を主に取り次ぐと、","tok":[["民","みん"],["は"],["皆","みな"],["、"],["一斉","いっせい"],["に"],["答えて","こたえて"],["、"],["「"],["わたしたち"],["は"],["、"],["主","ぬし"],["が"],["語られた","かたられた"],["こと"],["を"],["すべて"],["、"],["行います","おこないます"],["」"],["と"],["言った","いった"],["。"],["モーセ"],["が"],["民","たみ"],["の"],["言葉","ことば"],["を"],["主に","おもに"],["取り次ぐ","とりつぐ"],["と"],["、"]]},{"verse":9,"text":"主はモーセに言われた。「見よ、わたしは濃い雲の中にあってあなたに臨む。わたしがあなたと語るのを民が聞いて、いつまでもあなたを信じるようになるためである。」モーセは民の言葉を主に告げた。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["濃い","こい"],["雲","くも"],["の"],["中","なか"],["に"],["あって"],["あなた"],["に"],["臨む","のぞむ"],["。"],["わたし"],["が"],["あなた"],["と"],["語る","かたる"],["の"],["を"],["民","たみ"],["が"],["聞いて","きいて"],["、"],["いつ"],["まで"],["も"],["あなた"],["を"],["信じる","しんじる"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"],["」"],["モーセ"],["は"],["民","みん"],["の"],["言葉","ことば"],["を"],["主に","おもに"],["告げた","つげた"],["。"]]},{"verse":10,"text":"主はモーセに言われた。「民のところに行き、今日と明日、彼らを聖別し、衣服を洗わせ、","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["民","みん"],["の"],["ところ"],["に"],["行き","いき"],["、"],["今日","きょう"],["と"],["明日","あす"],["、"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["し"],["、"],["衣服","いふく"],["を"],["洗わせ","あらわせ"],["、"]]},{"verse":11,"text":"三日目のために準備させなさい。三日目に、民全員の見ている前で、主はシナイ山に降られるからである。","tok":[["三日目","みっかめ"],["の"],["ため"],["に"],["準備","じゅんび"],["させ"],["なさい"],["。"],["三日目","みっかめ"],["に"],["、"],["民","みん"],["全員","ぜんいん"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["、"],["主","ぬし"],["は"],["シナイ"],["山","やま"],["に"],["降られる","ふられる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"民のために周囲に境を設けて、命じなさい。『山に登らぬよう、また、その境界に触れぬよう注意せよ。山に触れる者は必ず死刑に処せられる。","tok":[["民","みん"],["の"],["ため"],["に"],["周囲","しゅうい"],["に"],["境","さかい"],["を"],["設けて","もうけて"],["、"],["命じ","めいじ"],["なさい"],["。"],["『"],["山","やま"],["に"],["登らぬ","のぼらぬ"],["よう"],["、"],["また"],["、"],["その"],["境界","きょうかい"],["に"],["触れぬ","ふれぬ"],["よう"],["注意","ちゅうい"],["せよ"],["。"],["山","やま"],["に"],["触れる","ふれる"],["者","もの"],["は"],["必ず","かならず"],["死刑","しけい"],["に"],["処せられる","しょせられる"],["。"]]},{"verse":13,"text":"その人に手を触れずに、石で打ち殺すか、矢で射殺さねばならない。獣であれ、人であれ、生かしておいてはならない。角笛が長く吹き鳴らされるとき、ある人々は山に登ることができる。』」","tok":[["その"],["人","ひと"],["に"],["手","て"],["を"],["触れず","ふれず"],["に"],["、"],["石","いし"],["で"],["打ち殺す","うちころす"],["か"],["、"],["矢","や"],["で"],["射殺","しゃさつ"],["さねば"],["ならない"],["。"],["獣","けもの"],["で"],["あれ"],["、"],["人","ひと"],["で"],["あれ"],["、"],["生かして","いかして"],["おいて"],["は"],["ならない"],["。"],["角笛","つのぶえ"],["が"],["長く","ながく"],["吹き鳴らされる","ふきならされる"],["とき"],["、"],["ある"],["人々","ひとびと"],["は"],["山","やま"],["に"],["登る","のぼる"],["こと"],["が"],["できる"],["。"],["』"],["」"]]},{"verse":14,"text":"モーセは山から民のところに下って行き、民を聖別し、衣服を洗わせ、","tok":[["モーセ"],["は"],["山","やま"],["から"],["民","たみ"],["の"],["ところ"],["に"],["下って","くだって"],["行き","いき"],["、"],["民","みん"],["を"],["聖別","せいべつ"],["し"],["、"],["衣服","いふく"],["を"],["洗わせ","あらわせ"],["、"]]},{"verse":15,"text":"民に命じて、「三日目のために準備をしなさい。女に近づいてはならない」と言った。","tok":[["民","みん"],["に"],["命じて","めいじて"],["、"],["「"],["三日目","みっかめ"],["の"],["ため"],["に"],["準備","じゅんび"],["を"],["し"],["なさい"],["。"],["女","おんな"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["」"],["と"],["言った","いった"],["。"]]},{"verse":16,"text":"三日目の朝になると、雷鳴と稲妻と厚い雲が山に臨み、角笛の音が鋭く鳴り響いたので、宿営にいた民は皆、震えた。","tok":[["三日目","みっかめ"],["の"],["朝","あさ"],["に"],["なる"],["と"],["、"],["雷鳴","らいめい"],["と"],["稲妻","いなずま"],["と"],["厚い","あつい"],["雲","くも"],["が"],["山","やま"],["に"],["臨み","のぞみ"],["、"],["角笛","つのぶえ"],["の"],["音","おと"],["が"],["鋭く","するどく"],["鳴り響いた","なりひびいた"],["ので"],["、"],["宿営","しゅくえい"],["に"],["いた"],["民","たみ"],["は"],["皆","みな"],["、"],["震えた","ふるえた"],["。"]]},{"verse":17,"text":"しかし、モーセが民を神に会わせるために宿営から連れ出したので、彼らは山のふもとに立った。","tok":[["しかし"],["、"],["モーセ"],["が"],["民","たみ"],["を"],["神","かみ"],["に"],["会わせる","あわせる"],["ため"],["に"],["宿営","しゅくえい"],["から"],["連れ出した","つれだした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["山","やま"],["の"],["ふもと"],["に"],["立った","たった"],["。"]]},{"verse":18,"text":"シナイ山は全山煙に包まれた。主が火の中を山の上に降られたからである。煙は炉の煙のように立ち上り、山全体が激しく震えた。","tok":[["シナイ"],["山","やま"],["は"],["全山煙","ぜんざんえん"],["に"],["包まれた","つつまれた"],["。"],["主","ぬし"],["が"],["火","ひ"],["の"],["中","なか"],["を"],["山","やま"],["の"],["上","うえ"],["に"],["降られた","ふられた"],["から"],["で"],["ある"],["。"],["煙","けむり"],["は"],["炉","ろ"],["の"],["煙","けむり"],["の"],["よう"],["に"],["立ち上り","たちのぼり"],["、"],["山","やま"],["全体","ぜんたい"],["が"],["激しく","はげしく"],["震えた","ふるえた"],["。"]]},{"verse":19,"text":"角笛の音がますます鋭く鳴り響いたとき、モーセが語りかけると、神は雷鳴をもって答えられた。","tok":[["角笛","つのぶえ"],["の"],["音","おと"],["が"],["ますます"],["鋭く","するどく"],["鳴り響いた","なりひびいた"],["とき"],["、"],["モーセ"],["が"],["語りかける","かたりかける"],["と"],["、"],["神","かみ"],["は"],["雷鳴","らいめい"],["を"],["もって"],["答えられた","こたえられた"],["。"]]},{"verse":20,"text":"主はシナイ山の頂に降り、モーセを山の頂に呼び寄せられたので、モーセは登って行った。","tok":[["主","ぬし"],["は"],["シナイ"],["山","やま"],["の"],["頂","いただき"],["に"],["降り","ふり"],["、"],["モーセ"],["を"],["山","やま"],["の"],["頂","いただき"],["に"],["呼び寄せられた","よびよせられた"],["ので"],["、"],["モーセ"],["は"],["登って","のぼって"],["行った","いった"],["。"]]},{"verse":21,"text":"主はモーセに言われた。「あなたは下って行き、民が主を見ようとして越境し、多くの者が命を失うことのないように警告しなさい。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["下って","くだって"],["行き","いき"],["、"],["民","みん"],["が"],["主","ぬし"],["を"],["見よう","みよう"],["として"],["越境","えっきょう"],["し"],["、"],["多く","おおく"],["の"],["者","もの"],["が"],["命","いのち"],["を"],["失う","うしなう"],["こと"],["の"],["ない"],["よう"],["に"],["警告","けいこく"],["し"],["なさい"],["。"]]},{"verse":22,"text":"また主に近づく祭司たちも身を清め、主が彼らを撃たれることがないようにしなさい。」","tok":[["また"],["主に","おもに"],["近づく","ちかづく"],["祭司","さいし"],["たち"],["も"],["身","み"],["を"],["清め","きよめ"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["撃たれる","うたれる"],["こと"],["が"],["ない"],["よう"],["に"],["し"],["なさい"],["。"],["」"]]},{"verse":23,"text":"モーセは主に言った。「民がシナイ山に登ることはできません。山に境を設けて、それを聖別せよとあなたがわたしたちに警告されたからです。」","tok":[["モーセ"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["民","みん"],["が"],["シナイ"],["山","やま"],["に"],["登る","のぼる"],["こと"],["は"],["できません"],["。"],["山","やま"],["に"],["境","さかい"],["を"],["設けて","もうけて"],["、"],["それ"],["を"],["聖別","せいべつ"],["せよ"],["と"],["あなた"],["が"],["わたしたち"],["に"],["警告","けいこく"],["された"],["から"],["です"],["。"],["」"]]},{"verse":24,"text":"主は彼に言われた。「さあ、下って行き、あなたはアロンと共に登って来なさい。ただし、祭司たちと民とは越境して主のもとに登って来てはならない。主が彼らを撃つことがないためである。」","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["さあ"],["、"],["下って","くだって"],["行き","いき"],["、"],["あなた"],["は"],["アロン"],["と"],["共","とも"],["に"],["登って","のぼって"],["来","き"],["なさい"],["。"],["ただし"],["、"],["祭司","さいし"],["たち"],["と"],["民","たみ"],["と"],["は"],["越境","えっきょう"],["して"],["主","ぬし"],["の"],["もと"],["に"],["登って","のぼって"],["来て","きて"],["は"],["ならない"],["。"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["撃つ","うつ"],["こと"],["が"],["ない"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":25,"text":"モーセは民のもとに下って行き、彼らに告げた。","tok":[["モーセ"],["は"],["民","みん"],["の"],["もと"],["に"],["下って","くだって"],["行き","いき"],["、"],["彼","かれ"],["ら"],["に"],["告げた","つげた"],["。"]]}]
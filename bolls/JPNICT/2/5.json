[{"verse":1,"text":"その後、モーセとアロンはファラオのもとに出かけて行き、言った。「イスラエルの神、主がこう言われました。『わたしの民を去らせて、荒れ野でわたしのために祭りを行わせなさい』と。」","tok":[["その"],["後","ご"],["、"],["モーセ"],["と"],["アロン"],["は"],["ファラオ"],["の"],["もと"],["に"],["出かけて","でかけて"],["行き","いき"],["、"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["こう"],["言われました","いわれました"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["去らせて","さらせて"],["、"],["荒れ野","あれの"],["で"],["わたし"],["の"],["ため"],["に"],["祭り","まつり"],["を"],["行わせ","おこなわせ"],["なさい"],["』"],["と"],["。"],["」"]]},{"verse":2,"text":"ファラオは、「主とは一体何者なのか。どうして、その言うことをわたしが聞いて、イスラエルを去らせねばならないのか。わたしは主など知らないし、イスラエルを去らせはしない」と答えた。","tok":[["ファラオ"],["は"],["、"],["「"],["主","ぬし"],["と"],["は"],["一体","いったい"],["何者","なにもの"],["な"],["の"],["か"],["。"],["どう"],["して"],["、"],["その"],["言う","いう"],["こと"],["を"],["わたし"],["が"],["聞いて","きいて"],["、"],["イスラエル"],["を"],["去らせねば","さらせねば"],["ならない"],["の"],["か"],["。"],["わたし"],["は"],["主","ぬし"],["など"],["知らない","しらない"],["し"],["、"],["イスラエル"],["を"],["去らせ","さらせ"],["は"],["しない"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":3,"text":"二人は言った。「ヘブライ人の神がわたしたちに出現されました。どうか、三日の道のりを荒れ野に行かせて、わたしたちの神、主に犠牲をささげさせてください。そうしないと、神はきっと疫病か剣でわたしたちを滅ぼされるでしょう。」","tok":[["二人","ふたり"],["は"],["言った","いった"],["。"],["「"],["ヘブライ"],["人","にん"],["の"],["神","かみ"],["が"],["わたしたち"],["に"],["出現","しゅつげん"],["されました"],["。"],["どう"],["か"],["、"],["三日","みっか"],["の"],["道のり","みちのり"],["を"],["荒れ野","あれの"],["に"],["行かせて","いかせて"],["、"],["わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["犠牲","ぎせい"],["を"],["ささげさせて"],["ください"],["。"],["そう"],["しない"],["と"],["、"],["神","かみ"],["は"],["きっと"],["疫病","やくびょう"],["か"],["剣","けん"],["で"],["わたしたち"],["を"],["滅ぼされるでしょう","ほろぼされるでしょう"],["。"],["」"]]},{"verse":4,"text":"エジプト王は彼らに命じた。「モーセとアロン、お前たちはなぜ彼らを仕事から引き離そうとするのだ。お前たちも自分の労働に戻るがよい。」","tok":[["エジプト"],["王","おう"],["は"],["彼","かれ"],["ら"],["に"],["命じた","めいじた"],["。"],["「"],["モーセ"],["と"],["アロン"],["、"],["お前","おまえ"],["たち"],["は"],["なぜ"],["彼","かれ"],["ら"],["を"],["仕事","しごと"],["から"],["引き離そう","ひきはなそう"],["と"],["する"],["の"],["だ"],["。"],["お前","おまえ"],["たち"],["も"],["自分","じぶん"],["の"],["労働","ろうどう"],["に"],["戻る","もどる"],["が"],["よい"],["。"],["」"]]},{"verse":5,"text":"ファラオは更に、言った。「この国にいる者の数が増えているのに、お前たちは彼らに労働をやめさせようとするのか。」","tok":[["ファラオ"],["は"],["更に","さらに"],["、"],["言った","いった"],["。"],["「"],["この"],["国","くに"],["に"],["いる"],["者","もの"],["の"],["数","かず"],["が"],["増えて","ふえて"],["いる"],["のに"],["、"],["お前","おまえ"],["たち"],["は"],["彼","かれ"],["ら"],["に"],["労働","ろうどう"],["を"],["やめさせよう"],["と"],["する"],["の"],["か"],["。"],["」"]]},{"verse":6,"text":"ファラオはその日、民を追い使う者と下役の者に命じた。","tok":[["ファラオ"],["は"],["その"],["日","ひ"],["、"],["民","みん"],["を"],["追い使う","おいつかう"],["者","もの"],["と"],["下役","したやく"],["の"],["者","もの"],["に"],["命じた","めいじた"],["。"]]},{"verse":7,"text":"「これからは、今までのように、彼らにれんがを作るためのわらを与えるな。わらは自分たちで集めさせよ。","tok":[["「"],["これ"],["から"],["は"],["、"],["今まで","いままで"],["の"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["に"],["れんが"],["を"],["作る","つくる"],["ため"],["の"],["わら"],["を"],["与える","あたえる"],["な"],["。"],["わら"],["は"],["自分","じぶん"],["たち"],["で"],["集めさせよ","あつめさせよ"],["。"]]},{"verse":8,"text":"しかも、今まで彼らが作ってきた同じれんがの数量を課し、減らしてはならない。彼らは怠け者なのだ。だから、自分たちの神に犠牲をささげに行かせてくれなどと叫ぶのだ。","tok":[["しかも"],["、"],["今まで","いままで"],["彼","かれ"],["ら"],["が"],["作って","つくって"],["きた"],["同じ","おなじ"],["れんが"],["の"],["数量","すうりょう"],["を"],["課し","かし"],["、"],["減らして","へらして"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["怠け者","なまけもの"],["な"],["の"],["だ"],["。"],["だ"],["から"],["、"],["自分","じぶん"],["たち"],["の"],["神","かみ"],["に"],["犠牲","ぎせい"],["を"],["ささげ"],["に"],["行かせて","いかせて"],["くれ"],["など"],["と"],["叫ぶ","さけぶ"],["の"],["だ"],["。"]]},{"verse":9,"text":"この者たちは、仕事をきつくすれば、偽りの言葉に心を寄せることはなくなるだろう。」","tok":[["この"],["者","もの"],["たち"],["は"],["、"],["仕事","しごと"],["を"],["きつく"],["すれば"],["、"],["偽り","いつわり"],["の"],["言葉","ことば"],["に"],["心","こころ"],["を"],["寄せる","よせる"],["こと"],["は"],["なく"],["なるだろう"],["。"],["」"]]},{"verse":10,"text":"民を追い使う者と下役の者は出て行き、民に向かって、「ファラオはこう言われる。『今後、お前たちにわらは一切与えない。","tok":[["民","みん"],["を"],["追い使う","おいつかう"],["者","もの"],["と"],["下役","したやく"],["の"],["者","もの"],["は"],["出て","でて"],["行き","いき"],["、"],["民","みん"],["に"],["向かって","むかって"],["、"],["「"],["ファラオ"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["今後","こんご"],["、"],["お前","おまえ"],["たち"],["に"],["わら"],["は"],["一切","いっさい"],["与えない","あたえない"],["。"]]},{"verse":11,"text":"お前たちはどこにでも行って、自分でわらを見つけて取って来い。ただし、仕事の量は少しも減らさない』」と言ったので、","tok":[["お前","おまえ"],["たち"],["は"],["どこ"],["に"],["で"],["も"],["行って","いって"],["、"],["自分","じぶん"],["で"],["わら"],["を"],["見つけて","みつけて"],["取って","とって"],["来い","こい"],["。"],["ただし"],["、"],["仕事","しごと"],["の"],["量","りょう"],["は"],["少し","すこし"],["も"],["減らさない","へらさない"],["』"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":12,"text":"民はエジプト中に散ってわらの切り株まで集めた。","tok":[["民","みん"],["は"],["エジプト"],["中","ちゅう"],["に"],["散って","ちって"],["わら"],["の"],["切り株","きりかぶ"],["まで"],["集めた","あつめた"],["。"]]},{"verse":13,"text":"追い使う者たちは、「わらがあったときと同じように、その日の割り当てをその日のうちに仕上げろ」と言って、せきたてた。","tok":[["追い使う","おいつかう"],["者","もの"],["たち"],["は"],["、"],["「"],["わら"],["が"],["あった"],["とき"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["その"],["日","ひ"],["の"],["割り当て","わりあて"],["を"],["その"],["日","ひ"],["の"],["うち"],["に"],["仕上げろ","しあげろ"],["」"],["と"],["言って","いって"],["、"],["せきたてた"],["。"]]},{"verse":14,"text":"ファラオに任命された追い使う者たちは、監督として置いたイスラエルの人々の下役の者らに、「どうして、今までと同じ決められた量のれんがをその日のうちに仕上げることができないのか」と言って、彼らを打ったので、","tok":[["ファラオ"],["に"],["任命","にんめい"],["された"],["追い使う","おいつかう"],["者","もの"],["たち"],["は"],["、"],["監督","かんとく"],["として"],["置いた","おいた"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["下役","したやく"],["の"],["者","もの"],["ら"],["に"],["、"],["「"],["どう"],["して"],["、"],["今まで","いままで"],["と"],["同じ","おなじ"],["決められた","きめられた"],["量","りょう"],["の"],["れんが"],["を"],["その"],["日","ひ"],["の"],["うち"],["に"],["仕上げる","しあげる"],["こと"],["が"],["できない"],["の"],["か"],["」"],["と"],["言って","いって"],["、"],["彼","かれ"],["ら"],["を"],["打った","うった"],["ので"],["、"]]},{"verse":15,"text":"イスラエルの人々の下役の者らはファラオのもとに行って、訴えた。「どうしてあなたは僕たちにこのようにされるのですか。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["下役","したやく"],["の"],["者","もの"],["ら"],["は"],["ファラオ"],["の"],["もと"],["に"],["行って","いって"],["、"],["訴えた","うったえた"],["。"],["「"],["どう"],["して"],["あなた"],["は"],["僕たち","ぼくたち"],["に"],["この"],["よう"],["に"],["される"],["の"],["です"],["か"],["。"]]},{"verse":16,"text":"僕らにはわらが与えられません。それでも、れんがを作れと言われて、僕らは打たれているのです。間違っているのはあなたの民の方です。」","tok":[["僕","ぼく"],["ら"],["に"],["は"],["わら"],["が"],["与えられません","あたえられません"],["。"],["それ"],["で"],["も"],["、"],["れんが"],["を"],["作れ","つくれ"],["と"],["言われて","いわれて"],["、"],["僕","ぼく"],["ら"],["は"],["打たれて","うたれて"],["いる"],["の"],["です"],["。"],["間違って","まちがって"],["いる"],["の"],["は"],["あなた"],["の"],["民","たみ"],["の"],["方","ほう"],["です"],["。"],["」"]]},{"verse":17,"text":"彼は言った。「この怠け者めが。お前たちは怠け者なのだ。だから、主に犠牲をささげに行かせてくださいなどと言うのだ。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["この"],["怠け者","なまけもの"],["め"],["が"],["。"],["お前","おまえ"],["たち"],["は"],["怠け者","なまけもの"],["な"],["の"],["だ"],["。"],["だ"],["から"],["、"],["主に","おもに"],["犠牲","ぎせい"],["を"],["ささげ"],["に"],["行かせて","いかせて"],["ください"],["など"],["と"],["言う","いう"],["の"],["だ"],["。"]]},{"verse":18,"text":"すぐに行って働け。わらは与えない。しかし、割り当てられた量のれんがは必ず仕上げよ。」","tok":[["すぐ"],["に"],["行って","いって"],["働け","はたらけ"],["。"],["わら"],["は"],["与えない","あたえない"],["。"],["しかし"],["、"],["割り当てられた","わりあてられた"],["量","りょう"],["の"],["れんが"],["は"],["必ず","かならず"],["仕上げ","しあげ"],["よ"],["。"],["」"]]},{"verse":19,"text":"イスラエルの人々の下役の者たちは、「れんがの一日の割り当ては減らすな」と命じられて、自分たちが苦境に立たされたことを悟った。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["下役","したやく"],["の"],["者","もの"],["たち"],["は"],["、"],["「"],["れんが"],["の"],["一","いち"],["日","にち"],["の"],["割り当て","わりあて"],["は"],["減らす","へらす"],["な"],["」"],["と"],["命じられて","めいじられて"],["、"],["自分","じぶん"],["たち"],["が"],["苦境","くきょう"],["に"],["立たされた","たたされた"],["こと"],["を"],["悟った","さとった"],["。"]]},{"verse":20,"text":"彼らがファラオのもとから退出して来ると、待ち受けていたモーセとアロンに会った。","tok":[["彼","かれ"],["ら"],["が"],["ファラオ"],["の"],["もと"],["から"],["退出","たいしゅつ"],["して"],["来る","くる"],["と"],["、"],["待ち受けて","まちうけて"],["いた"],["モーセ"],["と"],["アロン"],["に"],["会った","あった"],["。"]]},{"verse":21,"text":"彼らは、二人に抗議した。「どうか、主があなたたちに現れてお裁きになるように。あなたたちのお陰で、我々はファラオとその家来たちに嫌われてしまった。我々を殺す剣を彼らの手に渡したのと同じです。」","tok":[["彼","かれ"],["ら"],["は"],["、"],["二人","ふたり"],["に"],["抗議","こうぎ"],["した"],["。"],["「"],["どう"],["か"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["に"],["現れて","あらわれて"],["お裁き","おさばき"],["に"],["なる"],["よう"],["に"],["。"],["あなた"],["たち"],["の"],["お陰","おかげ"],["で"],["、"],["我々","われわれ"],["は"],["ファラオ"],["と"],["その"],["家来","けらい"],["たち"],["に"],["嫌われて","きらわれて"],["しまった"],["。"],["我々","われわれ"],["を"],["殺す","ころす"],["剣","けん"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡した","わたした"],["の"],["と"],["同じ","おなじ"],["です"],["。"],["」"]]},{"verse":22,"text":"モーセは主のもとに帰って、訴えた。「わが主よ。あなたはなぜ、この民に災いをくだされるのですか。わたしを遣わされたのは、一体なぜですか。","tok":[["モーセ"],["は"],["主","ぬし"],["の"],["もと"],["に"],["帰って","かえって"],["、"],["訴えた","うったえた"],["。"],["「"],["わが"],["主","ぬし"],["よ"],["。"],["あなた"],["は"],["なぜ"],["、"],["この"],["民","たみ"],["に"],["災い","わざわい"],["を"],["くだされる"],["の"],["です"],["か"],["。"],["わたし"],["を"],["遣わされた","つかわされた"],["の"],["は"],["、"],["一体","いったい"],["なぜ"],["です"],["か"],["。"]]},{"verse":23,"text":"わたしがあなたの御名によって語るため、ファラオのもとに行ってから、彼はますますこの民を苦しめています。それなのに、あなたは御自分の民を全く救い出そうとされません。」","tok":[["わたし"],["が"],["あなた"],["の"],["御名","ぎょめい"],["によって"],["語る","かたる"],["ため"],["、"],["ファラオ"],["の"],["もと"],["に"],["行って","いって"],["から"],["、"],["彼","かれ"],["は"],["ますます"],["この"],["民","たみ"],["を"],["苦しめて","くるしめて"],["います"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["を"],["全く","まったく"],["救い出そう","すくいだそう"],["と"],["されません"],["。"],["」"]]}]
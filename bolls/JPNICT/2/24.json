[{"verse":1,"text":"主はモーセに言われた。「あなたは、アロン、ナダブ、アビフ、およびイスラエルの七十人の長老と一緒に主のもとに登りなさい。あなたたちは遠く離れて、ひれ伏さねばならない。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["、"],["アロン"],["、"],["ナダブ"],["、"],["アビフ"],["、"],["および"],["イスラエル"],["の"],["七","なな"],["十人","じゅうにん"],["の"],["長老","ちょうろう"],["と"],["一緒","いっしょ"],["に"],["主","ぬし"],["の"],["もと"],["に"],["登り","のぼり"],["なさい"],["。"],["あなた"],["たち"],["は"],["遠く","とおく"],["離れて","はなれて"],["、"],["ひれ伏さねば","ひれふさねば"],["ならない"],["。"]]},{"verse":2,"text":"しかし、モーセだけは主に近づくことができる。その他の者は近づいてはならない。民は彼と共に登ることはできない。」","tok":[["しかし"],["、"],["モーセ"],["だけ"],["は"],["主に","おもに"],["近づく","ちかづく"],["こと"],["が"],["できる"],["。"],["その"],["他","た"],["の"],["者","もの"],["は"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["民","たみ"],["は"],["彼","かれ"],["と"],["共","とも"],["に"],["登る","のぼる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":3,"text":"モーセは戻って、主のすべての言葉とすべての法を民に読み聞かせると、民は皆、声を一つにして答え、「わたしたちは、主が語られた言葉をすべて行います」と言った。","tok":[["モーセ"],["は"],["戻って","もどって"],["、"],["主","ぬし"],["の"],["すべて"],["の"],["言葉","ことば"],["と"],["すべて"],["の"],["法","ほう"],["を"],["民","たみ"],["に"],["読み聞かせる","よみきかせる"],["と"],["、"],["民","みん"],["は"],["皆","みな"],["、"],["声","こえ"],["を"],["一","ひと"],["つ"],["に"],["して"],["答え","こたえ"],["、"],["「"],["わたしたち"],["は"],["、"],["主","ぬし"],["が"],["語られた","かたられた"],["言葉","ことば"],["を"],["すべて"],["行います","おこないます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"モーセは主の言葉をすべて書き記し、朝早く起きて、山のふもとに祭壇を築き、十二の石の柱をイスラエルの十二部族のために建てた。","tok":[["モーセ"],["は"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["すべて"],["書き記し","かきしるし"],["、"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["、"],["山","やま"],["の"],["ふもと"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["十二","じゅうに"],["の"],["石","いし"],["の"],["柱","はしら"],["を"],["イスラエル"],["の"],["十二","じゅうに"],["部族","ぶぞく"],["の"],["ため"],["に"],["建てた","たてた"],["。"]]},{"verse":5,"text":"彼はイスラエルの人々の若者を遣わし、焼き尽くす献げ物をささげさせ、更に和解の献げ物として主に雄牛をささげさせた。","tok":[["彼","かれ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["若者","わかもの"],["を"],["遣わし","つかわし"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげさせ"],["、"],["更に","さらに"],["和解","わかい"],["の"],["献げ物","ささげもの"],["として"],["主に","おもに"],["雄牛","おうし"],["を"],["ささげさせた"],["。"]]},{"verse":6,"text":"モーセは血の半分を取って鉢に入れて、残りの半分を祭壇に振りかけると、","tok":[["モーセ"],["は"],["血","ち"],["の"],["半分","はんぶん"],["を"],["取って","とって"],["鉢","ばち"],["に"],["入れて","いれて"],["、"],["残り","のこり"],["の"],["半分","はんぶん"],["を"],["祭壇","さいだん"],["に"],["振りかける","ふりかける"],["と"],["、"]]},{"verse":7,"text":"契約の書を取り、民に読んで聞かせた。彼らが、「わたしたちは主が語られたことをすべて行い、守ります」と言うと、","tok":[["契約","けいやく"],["の"],["書","しょ"],["を"],["取り","とり"],["、"],["民","みん"],["に"],["読んで","よんで"],["聞かせた","きかせた"],["。"],["彼","かれ"],["ら"],["が"],["、"],["「"],["わたしたち"],["は"],["主","ぬし"],["が"],["語られた","かたられた"],["こと"],["を"],["すべて"],["行い","おこない"],["、"],["守ります","まもります"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":8,"text":"モーセは血を取り、民に振りかけて言った。「見よ、これは主がこれらの言葉に基づいてあなたたちと結ばれた契約の血である。」","tok":[["モーセ"],["は"],["血","ち"],["を"],["取り","とり"],["、"],["民","みん"],["に"],["振りかけて","ふりかけて"],["言った","いった"],["。"],["「"],["見よ","みよ"],["、"],["これ"],["は"],["主","ぬし"],["が"],["これ"],["ら"],["の"],["言葉","ことば"],["に"],["基づいて","もとづいて"],["あなた"],["たち"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["の"],["血","ち"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"モーセはアロン、ナダブ、アビフおよびイスラエルの七十人の長老と一緒に登って行った。","tok":[["モーセ"],["は"],["アロン"],["、"],["ナダブ"],["、"],["アビフ"],["および"],["イスラエル"],["の"],["七","なな"],["十人","じゅうにん"],["の"],["長老","ちょうろう"],["と"],["一緒","いっしょ"],["に"],["登って","のぼって"],["行った","いった"],["。"]]},{"verse":10,"text":"彼らがイスラエルの神を見ると、その御足の下にはサファイアの敷石のような物があり、それはまさに大空のように澄んでいた。","tok":[["彼","かれ"],["ら"],["が"],["イスラエル"],["の"],["神","かみ"],["を"],["見る","みる"],["と"],["、"],["その"],["御足","おあし"],["の"],["下","した"],["に"],["は"],["サファイア"],["の"],["敷石","しきいし"],["の"],["よう"],["な"],["物","もの"],["が"],["あり"],["、"],["それ"],["は"],["まさに"],["大空","おおぞら"],["の"],["よう"],["に"],["澄んで","すんで"],["いた"],["。"]]},{"verse":11,"text":"神はイスラエルの民の代表者たちに向かって手を伸ばされなかったので、彼らは神を見て、食べ、また飲んだ。","tok":[["神","かみ"],["は"],["イスラエル"],["の"],["民","たみ"],["の"],["代表者","だいひょうしゃ"],["たち"],["に"],["向かって","むかって"],["手","て"],["を"],["伸ばされなかった","のばされなかった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["神","かみ"],["を"],["見て","みて"],["、"],["食べ","たべ"],["、"],["また"],["飲んだ","のんだ"],["。"]]},{"verse":12,"text":"主が、「わたしのもとに登りなさい。山に来て、そこにいなさい。わたしは、彼らを教えるために、教えと戒めを記した石の板をあなたに授ける」とモーセに言われると、","tok":[["主","ぬし"],["が"],["、"],["「"],["わたし"],["の"],["もと"],["に"],["登り","のぼり"],["なさい"],["。"],["山","やま"],["に"],["来て","きて"],["、"],["そこ"],["に"],["い"],["なさい"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["教える","おしえる"],["ため"],["に"],["、"],["教え","おしえ"],["と"],["戒め","いましめ"],["を"],["記した","しるした"],["石","いし"],["の"],["板","いた"],["を"],["あなた"],["に"],["授ける","さずける"],["」"],["と"],["モーセ"],["に"],["言われる","いわれる"],["と"],["、"]]},{"verse":13,"text":"モーセは従者ヨシュアと共に立ち上がった。モーセは、神の山へ登って行くとき、","tok":[["モーセ"],["は"],["従者","じゅうしゃ"],["ヨシュア"],["と"],["共","とも"],["に"],["立ち上がった","たちあがった"],["。"],["モーセ"],["は"],["、"],["神","かみ"],["の"],["山","やま"],["へ"],["登って","のぼって"],["行く","いく"],["とき"],["、"]]},{"verse":14,"text":"長老たちに言った。「わたしたちがあなたたちのもとに帰って来るまで、ここにとどまっていなさい。見よ、アロンとフルとがあなたたちと共にいる。何か訴えのある者は、彼らのところに行きなさい。」","tok":[["長老","ちょうろう"],["たち"],["に"],["言った","いった"],["。"],["「"],["わたしたち"],["が"],["あなた"],["たち"],["の"],["もと"],["に"],["帰って","かえって"],["来る","くる"],["まで"],["、"],["ここ"],["に"],["とどまって"],["い"],["なさい"],["。"],["見よ","みよ"],["、"],["アロン"],["と"],["フル"],["と"],["が"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いる"],["。"],["何","なん"],["か"],["訴え","うったえ"],["の"],["ある"],["者","もの"],["は"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["行き","いき"],["なさい"],["。"],["」"]]},{"verse":15,"text":"モーセが山に登って行くと、雲は山を覆った。","tok":[["モーセ"],["が"],["山","やま"],["に"],["登って","のぼって"],["行く","いく"],["と"],["、"],["雲","くも"],["は"],["山","やま"],["を"],["覆った","おおった"],["。"]]},{"verse":16,"text":"主の栄光がシナイ山の上にとどまり、雲は六日の間、山を覆っていた。七日目に、主は雲の中からモーセに呼びかけられた。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["が"],["シナイ"],["山","やま"],["の"],["上","うえ"],["に"],["とどまり"],["、"],["雲","くも"],["は"],["六日","むいか"],["の"],["間","あいだ"],["、"],["山","やま"],["を"],["覆って","おおって"],["いた"],["。"],["七日目","ななかめ"],["に"],["、"],["主","ぬし"],["は"],["雲","くも"],["の"],["中","なか"],["から"],["モーセ"],["に"],["呼びかけられた","よびかけられた"],["。"]]},{"verse":17,"text":"主の
[{"verse":1,"text":"主はモーセに言われた。「ファラオのもとに行って彼に告げなさい。ヘブライ人の神、主はこう言われた。『わたしの民を去らせ、わたしに仕えさせよ』と。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["ファラオ"],["の"],["もと"],["に"],["行って","いって"],["彼","かれ"],["に"],["告げ","つげ"],["なさい"],["。"],["ヘブライ"],["人","にん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["去らせ","さらせ"],["、"],["わたし"],["に"],["仕えさせよ","つかえさせよ"],["』"],["と"],["。"]]},{"verse":2,"text":"もしあなたが去らせるのを拒み、なおも彼らをとどめておくならば、","tok":[["もし"],["あなた"],["が"],["去らせる","さらせる"],["の"],["を"],["拒み","こばみ"],["、"],["なお"],["も"],["彼","かれ"],["ら"],["を"],["とどめて"],["おくならば"],["、"]]},{"verse":3,"text":"見よ、主の手が甚だ恐ろしい疫病を野にいるあなたの家畜、馬、ろば、らくだ、牛、羊に臨ませる。","tok":[["見よ","みよ"],["、"],["主","ぬし"],["の"],["手","て"],["が"],["甚だ","はなはだ"],["恐ろしい","おそろしい"],["疫病","やくびょう"],["を"],["野","の"],["に"],["いる"],["あなた"],["の"],["家畜","かちく"],["、"],["馬","うま"],["、"],["ろば"],["、"],["らく"],["だ"],["、"],["牛","うし"],["、"],["羊","ひつじ"],["に"],["臨ませる","のぞませる"],["。"]]},{"verse":4,"text":"しかし主は、イスラエルの家畜とエジプトの家畜とを区別される。イスラエルの人々の家畜は一頭たりとも死ぬことはない。","tok":[["しかし"],["主","ぬし"],["は"],["、"],["イスラエル"],["の"],["家畜","かちく"],["と"],["エジプト"],["の"],["家畜","かちく"],["と"],["を"],["区別","くべつ"],["される"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["家畜","かちく"],["は"],["一頭","いちとう"],["たり"],["と"],["も"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":5,"text":"主はまた時を定め、明日、この地でこの事を行われる。」","tok":[["主","ぬし"],["は"],["また"],["時","とき"],["を"],["定め","さだめ"],["、"],["明日","あす"],["、"],["この"],["地","ち"],["で"],["この"],["事","こと"],["を"],["行われる","おこなわれる"],["。"],["」"]]},{"verse":6,"text":"翌日、主はこの事を行われたので、エジプト人の家畜はすべて死んだが、イスラエルの人々の家畜は一頭も死ななかった。","tok":[["翌日","よくじつ"],["、"],["主","ぬし"],["は"],["この"],["事","こと"],["を"],["行われた","おこなわれた"],["ので"],["、"],["エジプト"],["人","にん"],["の"],["家畜","かちく"],["は"],["すべて"],["死んだ","しんだ"],["が"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["家畜","かちく"],["は"],["一頭","いちとう"],["も"],["死ななかった","しななかった"],["。"]]},{"verse":7,"text":"ファラオが人を遣わして見させたところ、イスラエルの家畜は一頭といえども死んではいなかった。それでも、ファラオの心は頑迷になり民を去らせなかった。","tok":[["ファラオ"],["が"],["人","ひと"],["を"],["遣わして","つかわして"],["見させた","みさせた"],["ところ"],["、"],["イスラエル"],["の"],["家畜","かちく"],["は"],["一頭","いちとう"],["と"],["いえ"],["ど"],["も"],["死んで","しんで"],["は"],["いなかった"],["。"],["それ"],["で"],["も"],["、"],["ファラオ"],["の"],["心","こころ"],["は"],["頑迷","がんめい"],["に"],["なり"],["民","みん"],["を"],["去らせなかった","さらせなかった"],["。"]]},{"verse":8,"text":"主はモーセとアロンに言われた。「かまどのすすを両手にいっぱい取って、モーセはそれをファラオの前で天に向かってまき散らすがよい。","tok":[["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["。"],["「"],["かまど"],["の"],["すす"],["を"],["両手","りょうて"],["に"],["いっぱい"],["取って","とって"],["、"],["モーセ"],["は"],["それ"],["を"],["ファラオ"],["の"],["前","まえ"],["で"],["天","てん"],["に"],["向かって","むかって"],["まき散らす","まきちらす"],["が"],["よい"],["。"]]},{"verse":9,"text":"それはエジプト全土を覆う細かい塵となって、エジプト全土の人と家畜に降りかかり、膿の出るはれ物となるであろう。」","tok":[["それ"],["は"],["エジプト"],["全土","ぜんど"],["を"],["覆う","おおう"],["細かい","こまかい"],["塵","ごみ"],["と"],["なって"],["、"],["エジプト"],["全土","ぜんど"],["の"],["人","ひと"],["と"],["家畜","かちく"],["に"],["降りかかり","ふりかかり"],["、"],["膿","のう"],["の"],["出る","でる"],["はれ物","はれもの"],["と"],["なるで"],["あろう"],["。"],["」"]]},{"verse":10,"text":"二人はかまどのすすを取ってファラオの前に立ち、モーセがそれを天に向かってまき散らした。すると、膿の出るはれ物が人と家畜に生じた。","tok":[["二人","ふたり"],["は"],["かまど"],["の"],["すす"],["を"],["取って","とって"],["ファラオ"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["モーセ"],["が"],["それ"],["を"],["天","てん"],["に"],["向かって","むかって"],["まき散らした","まきちらした"],["。"],["する"],["と"],["、"],["膿","のう"],["の"],["出る","でる"],["はれ物","はれもの"],["が"],["人","ひと"],["と"],["家畜","かちく"],["に"],["生じた","しょうじた"],["。"]]},{"verse":11,"text":"魔術師もこのはれ物のためにモーセの前に立つことができなかった。はれ物は魔術師のみならず、エジプト人すべてに生じた。","tok":[["魔術師","まじゅつし"],["も"],["この"],["はれ物","はれもの"],["の"],["ため"],["に"],["モーセ"],["の"],["前","まえ"],["に"],["立つ","たつ"],["こと"],["が"],["できなかった"],["。"],["はれ物","はれもの"],["は"],["魔術師","まじゅつし"],["のみ"],["ならず"],["、"],["エジプト"],["人","にん"],["すべて"],["に"],["生じた","しょうじた"],["。"]]},{"verse":12,"text":"しかし、主がファラオの心をかたくなにされたので、彼は二人の言うことを聞かなかった。主がモーセに仰せになったとおりである。","tok":[["しかし"],["、"],["主","ぬし"],["が"],["ファラオ"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["された"],["ので"],["、"],["彼","かれ"],["は"],["二人","ふたり"],["の"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"],["主","ぬし"],["が"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["とおり"],["で"],["ある"],["。"]]},{"verse":13,"text":"主はモーセに言われた。「明朝早く起き、ファラオの前に立って、彼に言いなさい。ヘブライ人の神、主はこう言われた。『わたしの民を去らせ、わたしに仕えさせよ。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["明朝","みょうちょう"],["早く","はやく"],["起き","おき"],["、"],["ファラオ"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["。"],["ヘブライ"],["人","にん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["去らせ","さらせ"],["、"],["わたし"],["に"],["仕えさせ","つかえさせ"],["よ"],["。"]]},{"verse":14,"text":"今度こそ、わたしはあなた自身とあなたの家臣とあなたの民に、あらゆる災害をくだす。わたしのような神は、地上のどこにもいないことを、あなたに分からせるためである。","tok":[["今度","こんど"],["こそ"],["、"],["わたし"],["は"],["あなた"],["自身","じしん"],["と"],["あなた"],["の"],["家臣","かしん"],["と"],["あなた"],["の"],["民","たみ"],["に"],["、"],["あらゆる"],["災害","さいがい"],["を"],["くだす"],["。"],["わたし"],["の"],["よう"],["な"],["神","かみ"],["は"],["、"],["地上","ちじょう"],["の"],["どこ"],["に"],["も"],["いない"],["こと"],["を"],["、"],["あなた"],["に"],["分からせる","わからせる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"実際、今までにもわたしは手を伸ばし、あなたとあなたの民を疫病で打ち、地上から絶やすこともできたのだ。","tok":[["実際","じっさい"],["、"],["今まで","いままで"],["に"],["も"],["わたし"],["は"],["手","て"],["を"],["伸ばし","のばし"],["、"],["あなた"],["と"],["あなた"],["の"],["民","たみ"],["を"],["疫病","やくびょう"],["で"],["打ち","うち"],["、"],["地上","ちじょう"],["から"],["絶やす","たやす"],["こと"],["も"],["できた"],["の"],["だ"],["。"]]},{"verse":16,"text":"しかしわたしは、あなたにわたしの力を示してわたしの名を全地に語り告げさせるため、あなたを生かしておいた。","tok":[["しかし"],["わたし"],["は"],["、"],["あなた"],["に"],["わたし"],["の"],["力","ちから"],["を"],["示して","しめして"],["わたし"],["の"],["名","な"],["を"],["全地","ぜんち"],["に"],["語り告げさせる","かたりつげさせる"],["ため"],["、"],["あなた"],["を"],["生かして","いかして"],["おいた"],["。"]]},{"verse":17,"text":"あなたはいまだに、わたしの民に対して高ぶり、彼らを去らせようとしない。","tok":[["あなた"],["は"],["いまだ"],["に"],["、"],["わたし"],["の"],["民","たみ"],["に対して","にたいして"],["高ぶり","たかぶり"],["、"],["彼","かれ"],["ら"],["を"],["去らせよう","さらせよう"],["と"],["しない"],["。"]]},{"verse":18,"text":"見よ、明日の今ごろ、エジプト始まって以来、今日までかつてなかったほどの甚だ激しい雹を降らせる。","tok":[["見よ","みよ"],["、"],["明日","あす"],["の"],["今ごろ","いまごろ"],["、"],["エジプト"],["始まって","はじまって"],["以来","いらい"],["、"],["今日","きょう"],["まで"],["かつて"],["なかった"],["ほど"],["の"],["甚だ","はなはだ"],["激しい","はげしい"],["雹","ひょう"],["を"],["降らせる","ふらせる"],["。"]]},{"verse":19,"text":"それゆえ、今、人を遣わして、あなたの家畜で野にいるものは皆、避難させるがよい。野に出ていて家に連れ戻されない家畜は、人と共にすべて、雹に打たれて死ぬであろう』と。」","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["、"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["あなた"],["の"],["家畜","かちく"],["で"],["野","の"],["に"],["いる"],["もの"],["は"],["皆","みな"],["、"],["避難","ひなん"],["させる"],["が"],["よい"],["。"],["野","の"],["に"],["出て","でて"],["いて"],["家","いえ"],["に"],["連れ戻されない","つれもどされない"],["家畜","かちく"],["は"],["、"],["人","ひと"],["と"],["共","とも"],["に"],["すべて"],["、"],["雹","ひょう"],["に"],["打たれて","うたれて"],["死ぬで","しぬで"],["あろう"],["』"],["と"],["。"],["」"]]},{"verse":20,"text":"ファラオの家臣のうち、主の言葉を畏れた者は、自分の僕と家畜を家に避難させたが、","tok":[["ファラオ"],["の"],["家臣","かしん"],["の"],["うち"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["畏れた","おそれた"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["僕","ぼく"],["と"],["家畜","かちく"],["を"],["家","いえ"],["に"],["避難","ひなん"],["させた"],["が"],["、"]]},{"verse":21,"text":"主の言葉を心に留めなかった者は、僕と家畜を野に残しておいた。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["を"],["心","こころ"],["に"],["留めなかった","とめなかった"],["者","もの"],["は"],["、"],["僕","ぼく"],["と"],["家畜","かちく"],["を"],["野","の"],["に"],["残して","のこして"],["おいた"],["。"]]},{"verse":22,"text":"主はモーセに言われた。「あなたの手を天に向かって差し伸べ、エジプト全土に、人にも家畜にも、野のあらゆる草の上にも雹を降らせるがよい。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["手","て"],["を"],["天","てん"],["に"],["向かって","むかって"],["差し伸べ","さしのべ"],["、"],["エジプト"],["全土","ぜんど"],["に"],["、"],["人","ひと"],["に"],["も"],["家畜","かちく"],["に"],["も"],["、"],["野","の"],["の"],["あらゆる"],["草","くさ"],["の"],["上","うえ"],["に"],["も"],["雹","ひょう"],["を"],["降らせる","ふらせる"],["が"],["よい"],["。"],["」"]]},{"verse":23,"text":"モーセが天に向かって杖を差し伸べると、主は雷と雹を下され、稲妻が大地に向かって走った。主はエジプトの地に雹を降らせられた。","tok":[["モーセ"],["が"],["天","てん"],["に"],["向かって","むかって"],["杖","つえ"],["を"],["差し伸べる","さしのべる"],["と"],["、"],["主","ぬし"],["は"],["雷","かみなり"],["と"],["雹","ひょう"],["を"],["下され","くだされ"],["、"],["稲妻","いなずま"],["が"],["大地","だいち"],["に"],["向かって","むかって"],["走った","はしった"],["。"],["主","ぬし"],["は"],["エジプト"],["の"],["地","ち"],["に"],["雹","ひょう"],["を"],["降らせられた","ふらせられた"],["。"]]},{"verse":24,"text":"雹が降り、その間を絶え間なく稲妻が走った。それは甚だ激しく、このような雹が全土に降ったことは、エジプトの国始まって以来かつてなかったほどであった。","tok":[["雹","ひょう"],["が"],["降り","ふり"],["、"],["その"],["間","あいだ"],["を"],["絶え間","たえま"],["なく"],["稲妻","いなずま"],["が"],["走った","はしった"],["。"],["それ"],["は"],["甚だ","はなはだ"],["激しく","はげしく"],["、"],["この"],["よう"],["な"],["雹","ひょう"],["が"],["全土","ぜんど"],["に"],["降った","ふった"],["こと"],["は"],["、"],["エジプト"],["の"],["国","くに"],["始まって","はじまって"],["以来","いらい"],["かつて"],["なかった"],["ほど"],["で"],["あった"],["。"]]},{"verse":25,"text":"雹は、エジプト全土で野にいるすべてのもの、人も家畜も残らず打った。雹はまた、野のあらゆる草を打ち、野のすべての木を打ち砕いた。","tok":[["雹","ひょう"],["は"],["、"],["エジプト"],["全土","ぜんど"],["で"],["野","の"],["に"],["いる"],["すべて"],["の"],["もの"],["、"],["人","ひと"],["も"],["家畜","かちく"],["も"],["残らず","のこらず"],["打った","うった"],["。"],["雹","ひょう"],["は"],["また"],["、"],["野","の"],["の"],["あらゆる"],["草","くさ"],["を"],["打ち","うち"],["、"],["野","の"],["の"],["すべて"],["の"],["木","き"],["を"],["打ち砕いた","うちくだいた"],["。"]]},{"verse":26,"text":"ただし、イスラエルの人々の住むゴシェンの地域には雹は降らなかった。","tok":[["ただし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["住む","すむ"],["ゴシェン"],["の"],["地域","ちいき"],["に"],["は"],["雹","ひょう"],["は"],["降らなかった","ふらなかった"],["。"]]},{"verse":27,"text":"ファラオは人を遣わし、モーセとアロンを呼び寄せて言った。「今度ばかりはわたしが間違っていた。正しいのは主であり、悪いのはわたしとわたしの民である。","tok":[["ファラオ"],["は"],["人","ひと"],["を"],["遣わし","つかわし"],["、"],["モーセ"],["と"],["アロン"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["今度","こんど"],["ばかり"],["は"],["わたし"],["が"],["間違って","まちがって"],["いた"],["。"],["正しい","ただしい"],["の"],["は"],["主","ぬし"],["で"],["あり"],["、"],["悪い","わるい"],["の"],["は"],["わたし"],["と"],["わたし"],["の"],["民","たみ"],["で"],["ある"],["。"]]},{"verse":28,"text":"主に祈願してくれ。恐ろしい雷と雹はもうたくさんだ。あなたたちを去らせよう。これ以上ここにとどまることはない。」","tok":[["主に","おもに"],["祈願","きがん"],["して"],["くれ"],["。"],["恐ろしい","おそろしい"],["雷","かみなり"],["と"],["雹","ひょう"],["は"],["もう"],["たくさん"],["だ"],["。"],["あなた"],["たち"],["を"],["去らせよう","さらせよう"],["。"],["これ"],["以上","いじょう"],["ここ"],["に"],["とどまる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":29,"text":"モーセは言った。「町を出たら、早速両手を広げて主に祈りましょう。雷はやみ、雹はもう降らないでしょう。あなたはこうして、大地が主のものであることを知るでしょう。","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["町","まち"],["を"],["出たら","でたら"],["、"],["早速","さっそく"],["両手","りょうて"],["を"],["広げて","ひろげて"],["主に","おもに"],["祈りましょう","いのりましょう"],["。"],["雷","かみなり"],["は"],["やみ"],["、"],["雹","ひょう"],["は"],["もう"],["降らないでしょう","ふらないでしょう"],["。"],["あなた"],["は"],["こう"],["して"],["、"],["大地","だいち"],["が"],["主","ぬし"],["の"],["もの"],["で"],["ある"],["こと"],["を"],["知るでしょう","しるでしょう"],["。"]]},{"verse":30,"text":"しかし、あなたもあなたの家臣も、まだ主なる神を畏れるに至っていないことを、わたしは知っています。」","tok":[["しかし"],["、"],["あなた"],["も"],["あなた"],["の"],["家臣","かしん"],["も"],["、"],["まだ"],["主","おも"],["なる"],["神","かみ"],["を"],["畏れる","おそれる"],["に"],["至って","いたって"],["いない"],["こと"],["を"],["、"],["わたし"],["は"],["知って","しって"],["います"],["。"],["」"]]},{"verse":31,"text":"亜麻と大麦は壊滅した。大麦はちょうど穂の出る時期で、亜麻はつぼみの開く時期であったからである。","tok":[["亜麻","あま"],["と"],["大麦","おおむぎ"],["は"],["壊滅","かいめつ"],["した"],["。"],["大麦","おおむぎ"],["は"],["ちょうど"],["穂","ほ"],["の"],["出る","でる"],["時期","じき"],["で"],["、"],["亜麻","あま"],["は"],["つぼみ"],["の"],["開く","ひらく"],["時期","じき"],["で"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":32,"text":"小麦と裸麦は壊滅を免れた。穂の出る時期が遅いからである。","tok":[["小麦","こむぎ"],["と"],["裸麦","はだかむぎ"],["は"],["壊滅","かいめつ"],["を"],["免れた","まぬがれた"],["。"],["穂","ほ"],["の"],["出る","でる"],["時期","じき"],["が"],["遅い","おそい"],["から"],["で"],["ある"],["。"]]},{"verse":33,"text":"モーセは、ファラオのもとから退出し町を出ると、両手を広げて主に祈った。すると、雷も雹もやみ、大地に注ぐ雨もやんだ。","tok":[["モーセ"],["は"],["、"],["ファラオ"],["の"],["もと"],["から"],["退出","たいしゅつ"],["し"],["町","まち"],["を"],["出る","でる"],["と"],["、"],["両手","りょうて"],["を"],["広げて","ひろげて"],["主に","おもに"],["祈った","いのった"],["。"],["する"],["と"],["、"],["雷","かみなり"],["も"],["雹","ひょう"],["も"],["やみ"],["、"],["大地","だいち"],["に"],["注ぐ","そそぐ"],["雨","あめ"],["も"],["やんだ"],["。"]]},{"verse":34,"text":"ファラオは、雨も雹も雷もやんだのを見て、またもや過ちを重ね、彼も彼の家臣も心を頑迷にした。","tok":[["ファラオ"],["は"],["、"],["雨","あめ"],["も"],["雹","ひょう"],["も"],["雷","かみなり"],["も"],["
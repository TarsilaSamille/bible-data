[{"verse":1,"text":"主はモーセに言われた。「ファラオのもとに行きなさい。彼とその家臣の心を頑迷にしたのは、わたし自身である。それは、彼らのただ中でわたしがこれらのしるしを行うためであり、","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["ファラオ"],["の"],["もと"],["に"],["行き","いき"],["なさい"],["。"],["彼","かれ"],["と"],["その"],["家臣","かしん"],["の"],["心","こころ"],["を"],["頑迷","がんめい"],["に"],["した"],["の"],["は"],["、"],["わたし"],["自身","じしん"],["で"],["ある"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["ただ中","ただなか"],["で"],["わたし"],["が"],["これ"],["ら"],["の"],["しるし"],["を"],["行う","おこなう"],["ため"],["で"],["あり"],["、"]]},{"verse":2,"text":"わたしがエジプト人をどのようにあしらったか、どのようなしるしを行ったかをあなたが子孫に語り伝え、わたしが主であることをあなたたちが知るためである。」","tok":[["わたし"],["が"],["エジプト"],["人","にん"],["を"],["どの"],["よう"],["に"],["あしらった"],["か"],["、"],["どのような"],["しるし"],["を"],["行った","おこなった"],["か"],["を"],["あなた"],["が"],["子孫","しそん"],["に"],["語り伝え","かたりつたえ"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["あなた"],["たち"],["が"],["知る","しる"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":3,"text":"モーセとアロンはファラオのところに行き、彼に言った。「ヘブライ人の神、主はこう言われた。『いつまで、あなたはわたしの前に身を低くするのを拒むのか。わたしの民を去らせ、わたしに仕えさせなさい。","tok":[["モーセ"],["と"],["アロン"],["は"],["ファラオ"],["の"],["ところ"],["に"],["行き","いき"],["、"],["彼","かれ"],["に"],["言った","いった"],["。"],["「"],["ヘブライ"],["人","にん"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["『"],["いつ"],["まで"],["、"],["あなた"],["は"],["わたし"],["の"],["前","まえ"],["に"],["身","み"],["を"],["低く","ひくく"],["する"],["の"],["を"],["拒む","こばむ"],["の"],["か"],["。"],["わたし"],["の"],["民","たみ"],["を"],["去らせ","さらせ"],["、"],["わたし"],["に"],["仕えさせ","つかえさせ"],["なさい"],["。"]]},{"verse":4,"text":"もし、あなたがわたしの民を去らせることを拒み続けるならば、明日、わたしはあなたの領土にいなごを送り込む。","tok":[["もし"],["、"],["あなた"],["が"],["わたし"],["の"],["民","たみ"],["を"],["去らせる","さらせる"],["こと"],["を"],["拒み","こばみ"],["続けるならば","つづけるならば"],["、"],["明日","あす"],["、"],["わたし"],["は"],["あなた"],["の"],["領土","りょうど"],["に"],["いなご"],["を"],["送り込む","おくりこむ"],["。"]]},{"verse":5,"text":"いなごは地表を覆い尽くし、地面を見ることもできなくなる。そして、雹の害を免れた残りのものを食い荒らし、野に生えているすべての木を食い尽くす。","tok":[["いなご"],["は"],["地表","ちひょう"],["を"],["覆い","おおい"],["尽くし","つくし"],["、"],["地面","じめん"],["を"],["見る","みる"],["こと"],["も"],["できなく"],["なる"],["。"],["そして"],["、"],["雹","ひょう"],["の"],["害","がい"],["を"],["免れた","まぬがれた"],["残り","のこり"],["の"],["もの"],["を"],["食い荒らし","くいあらし"],["、"],["野","の"],["に"],["生えて","はえて"],["いる"],["すべて"],["の"],["木","き"],["を"],["食い","くい"],["尽くす","つくす"],["。"]]},{"verse":6,"text":"また、あなたの王宮、家臣のすべての家、エジプト中の家にいなごが満ちる。それは、あなたの先祖も、先祖の先祖も、この土地に住み着いたときから今日まで見たことがないものである』と。」彼が身を翻してファラオのもとから退出すると、","tok":[["また"],["、"],["あなた"],["の"],["王宮","おうきゅう"],["、"],["家臣","かしん"],["の"],["すべて"],["の"],["家","いえ"],["、"],["エジプト"],["中","ちゅう"],["の"],["家","いえ"],["に"],["いなご"],["が"],["満ちる","みちる"],["。"],["それ"],["は"],["、"],["あなた"],["の"],["先祖","せんぞ"],["も"],["、"],["先祖","せんぞ"],["の"],["先祖","せんぞ"],["も"],["、"],["この"],["土地","とち"],["に"],["住み着いた","すみついた"],["とき"],["から"],["今日","きょう"],["まで"],["見た","みた"],["こと"],["が"],["ない"],["もの"],["で"],["ある"],["』"],["と"],["。"],["」"],["彼","かれ"],["が"],["身","み"],["を"],["翻して","ひるがえして"],["ファラオ"],["の"],["もと"],["から"],["退出","たいしゅつ"],["する"],["と"],["、"]]},{"verse":7,"text":"ファラオの家臣が王に進言した。「いつまで、この男はわたしたちを陥れる罠となるのでしょうか。即刻あの者たちを去らせ、彼らの神、主に仕えさせてはいかがでしょう。エジプトが滅びかかっているのが、まだお分かりになりませんか。」","tok":[["ファラオ"],["の"],["家臣","かしん"],["が"],["王","おう"],["に"],["進言","しんげん"],["した"],["。"],["「"],["いつ"],["まで"],["、"],["この"],["男","おとこ"],["は"],["わたしたち"],["を"],["陥れる","おとしいれる"],["罠","わな"],["と"],["なる"],["の"],["でしょう"],["か"],["。"],["即刻","そっこく"],["あの"],["者","もの"],["たち"],["を"],["去らせ","さらせ"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主に","おもに"],["仕えさせて","つかえさせて"],["は"],["いかが"],["でしょう"],["。"],["エジプト"],["が"],["滅び","ほろび"],["かかって"],["いる"],["の"],["が"],["、"],["まだ"],["お分かり","おわかり"],["に"],["なりません"],["か"],["。"],["」"]]},{"verse":8,"text":"モーセとアロンがファラオのもとに呼び戻されると、ファラオは二人に言った。「行って、あなたたちの神、主に仕えるがよい。誰と誰が行くのか。」","tok":[["モーセ"],["と"],["アロン"],["が"],["ファラオ"],["の"],["もと"],["に"],["呼び戻される","よびもどされる"],["と"],["、"],["ファラオ"],["は"],["二人","ふたり"],["に"],["言った","いった"],["。"],["「"],["行って","いって"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["仕える","つかえる"],["が"],["よい"],["。"],["誰","だれ"],["と"],["誰","だれ"],["が"],["行く","いく"],["の"],["か"],["。"],["」"]]},{"verse":9,"text":"「若い者も年寄りも一緒に参ります。息子も娘も羊も牛も参ります。主の祭りは我々全員のものです」とモーセが答えると、","tok":[["「"],["若い","わかい"],["者","もの"],["も"],["年寄り","としより"],["も"],["一緒","いっしょ"],["に"],["参ります","まいります"],["。"],["息子","むすこ"],["も"],["娘","むすめ"],["も"],["羊","ひつじ"],["も"],["牛","うし"],["も"],["参ります","まいります"],["。"],["主","ぬし"],["の"],["祭り","まつり"],["は"],["我々","われわれ"],["全員","ぜんいん"],["の"],["もの"],["です"],["」"],["と"],["モーセ"],["が"],["答える","こたえる"],["と"],["、"]]},{"verse":10,"text":"ファラオは二人に言った。「よろしい。わたしがお前たちを家族ともども去らせるときは、主がお前たちと共におられるように。お前たちの前には災いが待っているのを知るがよい。","tok":[["ファラオ"],["は"],["二人","ふたり"],["に"],["言った","いった"],["。"],["「"],["よろしい"],["。"],["わたし"],["が"],["お前","おまえ"],["たち"],["を"],["家族","かぞく"],["ともども"],["去らせる","さらせる"],["とき"],["は"],["、"],["主","ぬし"],["が"],["お前","おまえ"],["たち"],["と"],["共","とも"],["に"],["おられる"],["よう"],["に"],["。"],["お前","おまえ"],["たち"],["の"],["前","まえ"],["に"],["は"],["災い","わざわい"],["が"],["待って","まって"],["いる"],["の"],["を"],["知る","しる"],["が"],["よい"],["。"]]},{"verse":11,"text":"いや、行くならば、男たちだけで行って、主に仕えるがよい。それがお前たちの求めていたことだ。」ファラオは自分の前から彼らを追い出した。","tok":[["いや"],["、"],["行くならば","いくならば"],["、"],["男","おとこ"],["たち"],["だけ"],["で"],["行って","いって"],["、"],["主に","おもに"],["仕える","つかえる"],["が"],["よい"],["。"],["それ"],["が"],["お前","おまえ"],["たち"],["の"],["求めて","もとめて"],["いた"],["こと"],["だ"],["。"],["」"],["ファラオ"],["は"],["自分","じぶん"],["の"],["前","まえ"],["から"],["彼","かれ"],["ら"],["を"],["追い出した","おいだした"],["。"]]},{"verse":12,"text":"主はモーセに言われた。「手をエジプトの地に差し伸べ、いなごを呼び寄せなさい。いなごはエジプトの国を襲い、地のあらゆる草、雹の害を免れたすべてのものを食い尽くすであろう。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["手","て"],["を"],["エジプト"],["の"],["地","ち"],["に"],["差し伸べ","さしのべ"],["、"],["いなご"],["を"],["呼び寄せ","よびよせ"],["なさい"],["。"],["いなご"],["は"],["エジプト"],["の"],["国","くに"],["を"],["襲い","おそい"],["、"],["地","ち"],["の"],["あらゆる"],["草","くさ"],["、"],["雹","ひょう"],["の"],["害","がい"],["を"],["免れた","まぬがれた"],["すべて"],["の"],["もの"],["を"],["食い","くい"],["尽くすで","つくすで"],["あろう"],["。"],["」"]]},{"verse":13,"text":"モーセがエジプトの地に杖を差し伸べると、主はまる一昼夜、東風を吹かせられた。朝になると、東風がいなごの大群を運んで来た。","tok":[["モーセ"],["が"],["エジプト"],["の"],["地","ち"],["に"],["杖","つえ"],["を"],["差し伸べる","さしのべる"],["と"],["、"],["主","ぬし"],["はまる"],["一昼夜","いっちゅうや"],["、"],["東風","とうふう"],["を"],["吹かせられた","ふかせられた"],["。"],["朝","あさ"],["に"],["なる"],["と"],["、"],["東風","とうふう"],["が"],["いなご"],["の"],["大群","たいぐん"],["を"],["運んで","はこんで"],["来た","きた"],["。"]]},{"verse":14,"text":"いなごは、エジプト全土を襲い、エジプトの領土全体にとどまった。このようにおびただしいいなごの大群は前にも後にもなかった。","tok":[["いなご"],["は"],["、"],["エジプト"],["全土","ぜんど"],["を"],["襲い","おそい"],["、"],["エジプト"],["の"],["領土","りょうど"],["全体","ぜんたい"],["に"],["とどまった"],["。"],["この"],["よう"],["に"],["おびただしい"],["いなご"],["の"],["大群","たいぐん"],["は"],["前","まえ"],["に"],["も"],["後","あと"],["に"],["も"],["なかった"],["。"]]},{"verse":15,"text":"いなごが地の面をすべて覆ったので、地は暗くなった。いなごは地のあらゆる草、雹の害を免れた木の実をすべて食い尽くしたので、木であれ、野の草であれ、エジプト全土のどこにも緑のものは何一つ残らなかった。","tok":[["いなご"],["が"],["地","ち"],["の"],["面","めん"],["を"],["すべて"],["覆った","おおった"],["ので"],["、"],["地","ち"],["は"],["暗く","くらく"],["なった"],["。"],["いなご"],["は"],["地","ち"],["の"],["あらゆる"],["草","くさ"],["、"],["雹","ひょう"],["の"],["害","がい"],["を"],["免れた","まぬがれた"],["木の実","このみ"],["を"],["すべて"],["食い","くい"],["尽くした","つくした"],["ので"],["、"],["木","き"],["で"],["あれ"],["、"],["野","の"],["の"],["草","くさ"],["で"],["あれ"],["、"],["エジプト"],["全土","ぜんど"],["の"],["どこ"],["に"],["も"],["緑","みどり"],["の"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["残らなかった","のこらなかった"],["。"]]},{"verse":16,"text":"ファラオは急いでモーセとアロンを呼んで頼んだ。「あなたたちの神、主に対し、またあなたたちに対しても、わたしは過ちを犯した。","tok":[["ファラオ"],["は"],["急いで","いそいで"],["モーセ"],["と"],["アロン"],["を"],["呼んで","よんで"],["頼んだ","たのんだ"],["。"],["「"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["対し","たいし"],["、"],["また"],["あなた"],["たち"],["に対して","にたいして"],["も"],["、"],["わたし"],["は"],["過ち","あやまち"],["を"],["犯した","おかした"],["。"]]},{"verse":17,"text":"どうか、もう一度だけ過ちを赦して、あなたたちの神、主に祈願してもらいたい。こんな死に方だけはしないで済むように。」","tok":[["どう"],["か"],["、"],["もう"],["一度","いちど"],["だけ"],["過ち","あやまち"],["を"],["赦して","ゆるして"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["祈願","きがん"],["して"],["もらいたい"],["。"],["こんな"],["死に","しに"],["方","かた"],["だけ"],["は"],["しないで"],["済む","すむ"],["よう"],["に"],["。"],["」"]]},{"verse":18,"tex
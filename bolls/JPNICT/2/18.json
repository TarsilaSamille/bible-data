[{"verse":1,"text":"モーセのしゅうとで、ミディアンの祭司であるエトロは、神がモーセとその民イスラエルのためになされたすべてのこと、すなわち、主がイスラエルをエジプトから導き出されたことを聞いた。","tok":[["モーセ"],["の"],["しゅうと"],["で"],["、"],["ミディアン"],["の"],["祭司","さいし"],["で"],["ある"],["エトロ"],["は"],["、"],["神","かみ"],["が"],["モーセ"],["と"],["その"],["民","みん"],["イスラエル"],["の"],["ため"],["に"],["なされた"],["すべて"],["の"],["こと"],["、"],["すなわち"],["、"],["主","ぬし"],["が"],["イスラエル"],["を"],["エジプト"],["から"],["導き出された","みちびきだされた"],["こと"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"モーセのしゅうとエトロは、モーセが先に帰していた妻のツィポラと、","tok":[["モーセ"],["の"],["しゅうと"],["エトロ"],["は"],["、"],["モーセ"],["が"],["先","さき"],["に"],["帰して","かえして"],["いた"],["妻","つま"],["の"],["ツィポラ"],["と"],["、"]]},{"verse":3,"text":"二人の息子を連れて来た。一人は、モーセが、「わたしは異国にいる寄留者だ」と言って、ゲルショムと名付け、","tok":[["二人","ふたり"],["の"],["息子","むすこ"],["を"],["連れて","つれて"],["来た","きた"],["。"],["一人","ひとり"],["は"],["、"],["モーセ"],["が"],["、"],["「"],["わたし"],["は"],["異国","いこく"],["に"],["いる"],["寄留者","きりゅうしゃ"],["だ"],["」"],["と"],["言って","いって"],["、"],["ゲルショム"],["と"],["名付け","なづけ"],["、"]]},{"verse":4,"text":"もう一人は、「わたしの父の神はわたしの助け、ファラオの剣からわたしを救われた」と言って、エリエゼルと名付けた。","tok":[["もう"],["一人","ひとり"],["は"],["、"],["「"],["わたし"],["の"],["父","ちち"],["の"],["神","かみ"],["は"],["わたし"],["の"],["助け","たすけ"],["、"],["ファラオ"],["の"],["剣","けん"],["から"],["わたし"],["を"],["救われた","すくわれた"],["」"],["と"],["言って","いって"],["、"],["エリエゼル"],["と"],["名付けた","なづけた"],["。"]]},{"verse":5,"text":"モーセのしゅうとエトロは、モーセの息子たちと妻を連れて荒れ野に行き、神の山に宿営しているモーセのところに行った。","tok":[["モーセ"],["の"],["しゅうと"],["エトロ"],["は"],["、"],["モーセ"],["の"],["息子","むすこ"],["たち"],["と"],["妻","つま"],["を"],["連れて","つれて"],["荒れ野","あれの"],["に"],["行き","いき"],["、"],["神","かみ"],["の"],["山","やま"],["に"],["宿営","しゅくえい"],["して"],["いる"],["モーセ"],["の"],["ところ"],["に"],["行った","いった"],["。"]]},{"verse":6,"text":"彼はモーセに、「あなたのしゅうとであるわたし、エトロがあなたの妻と二人の子供を連れて来た」と伝えると、","tok":[["彼","かれ"],["は"],["モーセ"],["に"],["、"],["「"],["あなた"],["の"],["しゅうと"],["で"],["ある"],["わたし"],["、"],["エトロ"],["が"],["あなた"],["の"],["妻","つま"],["と"],["二人","ふたり"],["の"],["子供","こども"],["を"],["連れて","つれて"],["来た","きた"],["」"],["と"],["伝える","つたえる"],["と"],["、"]]},{"verse":7,"text":"モーセは出て来てしゅうとを迎え、身をかがめて口づけした。彼らは互いに安否を尋ね合ってから、天幕の中に入った。","tok":[["モーセ"],["は"],["出て","でて"],["来て","きて"],["しゅうと"],["を"],["迎え","むかえ"],["、"],["身","み"],["を"],["かがめて"],["口づけ","くちづけ"],["した"],["。"],["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["安否","あんぴ"],["を"],["尋ね合って","たずねあって"],["から"],["、"],["天幕","てんまく"],["の"],["中","なか"],["に"],["入った","はいった"],["。"]]},{"verse":8,"text":"モーセはしゅうとに、主がイスラエルのためファラオとエジプトに対してなされたすべてのこと、すなわち、彼らは途中であらゆる困難に遭遇したが、主が彼らを救い出されたことを語り聞かせると、","tok":[["モーセ"],["は"],["しゅうと"],["に"],["、"],["主","ぬし"],["が"],["イスラエル"],["の"],["ため"],["ファラオ"],["と"],["エジプト"],["に対して","にたいして"],["なされた"],["すべて"],["の"],["こと"],["、"],["すなわち"],["、"],["彼","かれ"],["ら"],["は"],["途中","とちゅう"],["で"],["あらゆる"],["困難","こんなん"],["に"],["遭遇","そうぐう"],["した"],["が"],["、"],["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["救い出された","すくいだされた"],["こと"],["を"],["語り聞かせる","かたりきかせる"],["と"],["、"]]},{"verse":9,"text":"エトロは、主がイスラエルをエジプト人の手から救い出し、彼らに恵みを与えられたことを喜んで、","tok":[["エトロ"],["は"],["、"],["主","ぬし"],["が"],["イスラエル"],["を"],["エジプト"],["人","にん"],["の"],["手","て"],["から"],["救い出し","すくいだし"],["、"],["彼","かれ"],["ら"],["に"],["恵み","めぐみ"],["を"],["与えられた","あたえられた"],["こと"],["を"],["喜んで","よろこんで"],["、"]]},{"verse":10,"text":"言った。「主をたたえよ主はあなたたちをエジプト人の手からファラオの手から救い出された。主はエジプト人のもとから民を救い出された。","tok":[["言った","いった"],["。"],["「"],["主","ぬし"],["を"],["たたえよ"],["主","ぬし"],["は"],["あなた"],["たち"],["を"],["エジプト"],["人","にん"],["の"],["手","て"],["から"],["ファラオ"],["の"],["手","て"],["から"],["救い出された","すくいだされた"],["。"],["主","ぬし"],["は"],["エジプト"],["人","にん"],["の"],["もと"],["から"],["民","たみ"],["を"],["救い出された","すくいだされた"],["。"]]},{"verse":11,"text":"今、わたしは知った彼らがイスラエルに向かって高慢にふるまったときにも主はすべての神々にまさって偉大であったことを。」","tok":[["今","いま"],["、"],["わたし"],["は"],["知った","しった"],["彼","かれ"],["ら"],["が"],["イスラエル"],["に"],["向かって","むかって"],["高慢","こうまん"],["に"],["ふるまった"],["とき"],["に"],["も"],["主","ぬし"],["は"],["すべて"],["の"],["神々","かみがみ"],["に"],["まさって"],["偉大","いだい"],["で"],["あった"],["こと"],["を"],["。"],["」"]]},{"verse":12,"text":"モーセのしゅうとエトロは焼き尽くす献げ物といけにえを神にささげた。アロンとイスラエルの長老たちも皆来て、モーセのしゅうとと共に神の御前で食事をした。","tok":[["モーセ"],["の"],["しゅうと"],["エトロ"],["は"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["いけにえ"],["を"],["神","かみ"],["に"],["ささげた"],["。"],["アロン"],["と"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["も"],["皆","みな"],["来て","きて"],["、"],["モーセ"],["の"],["しゅうと"],["と"],["共","とも"],["に"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":13,"text":"翌日になって、モーセは座に着いて民を裁いたが、民は朝から晩までモーセの裁きを待って並んでいた。","tok":[["翌日","よくじつ"],["に"],["なって"],["、"],["モーセ"],["は"],["座","ざ"],["に"],["着いて","ついて"],["民","みん"],["を"],["裁いた","さばいた"],["が"],["、"],["民","みん"],["は"],["朝","あさ"],["から"],["晩","ばん"],["まで"],["モーセ"],["の"],["裁き","さばき"],["を"],["待って","まって"],["並んで","ならんで"],["いた"],["。"]]},{"verse":14,"text":"モーセのしゅうとは、彼が民のために行っているすべてのことを見て、「あなたが民のためにしているこのやり方はどうしたことか。なぜ、あなた一人だけが座に着いて、民は朝から晩まであなたの裁きを待って並んでいるのか」と尋ねた。","tok":[["モーセ"],["の"],["しゅうと"],["は"],["、"],["彼","かれ"],["が"],["民","たみ"],["の"],["ため"],["に"],["行って","いって"],["いる"],["すべて"],["の"],["こと"],["を"],["見て","みて"],["、"],["「"],["あなた"],["が"],["民","たみ"],["の"],["ため"],["に"],["して"],["いる"],["この"],["やり方","やりかた"],["は"],["どう"],["した"],["こと"],["か"],["。"],["なぜ"],["、"],["あなた"],["一人","ひとり"],["だけ"],["が"],["座","ざ"],["に"],["着いて","ついて"],["、"],["民","みん"],["は"],["朝","あさ"],["から"],["晩","ばん"],["まで"],["あなた"],["の"],["裁き","さばき"],["を"],["待って","まって"],["並んで","ならんで"],["いる"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":15,"text":"モーセはしゅうとに、「民は、神に問うためにわたしのところに来るのです。","tok":[["モーセ"],["は"],["しゅうと"],["に"],["、"],["「"],["民","みん"],["は"],["、"],["神","かみ"],["に"],["問う","とう"],["ため"],["に"],["わたし"],["の"],["ところ"],["に"],["来る","くる"],["の"],["です"],["。"]]},{"verse":16,"text":"彼らの間に何か事件が起こると、わたしのところに来ますので、わたしはそれぞれの間を裁き、また、神の掟と指示とを知らせるのです」と答えた。","tok":[["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["何","なん"],["か"],["事件","じけん"],["が"],["起こる","おこる"],["と"],["、"],["わたし"],["の"],["ところ"],["に"],["来ます","きます"],["ので"],["、"],["わたし"],["は"],["それぞれ"],["の"],["間","あいだ"],["を"],["裁き","さばき"],["、"],["また"],["、"],["神","かみ"],["の"],["掟","おきて"],["と"],["指示","しじ"],["と"],["を"],["知らせる","しらせる"],["の"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":17,"text":"モーセのしゅうとは言った。「あなたのやり方は良くない。","tok":[["モーセ"],["の"],["しゅうと"],["は"],["言った","いった"],["。"],["「"],["あなた"],["の"],["やり方","やりかた"],["は"],["良く","よく"],["ない"],["。"]]},{"verse":18,"text":"あなた自身も、あなたを訪ねて来る民も、きっと疲れ果ててしまうだろう。このやり方ではあなたの荷が重すぎて、一人では負いきれないからだ。","tok":[["あなた"],["自身","じしん"],["も"],["、"],["あなた"],["を"],["訪ねて","たずねて"],["来る","くる"],["民","たみ"],["も"],["、"],["きっと"],["疲れ","つかれ"],["果てて","はてて"],["しまうだろう"],["。"],["この"],["やり方","やりかた"],["で"],["は"],["あなた"],["の"],["荷","に"],["が"],["重","おも"],["すぎて"],["、"],["一人","ひとり"],["で"],["は"],["負い","おい"],["きれない"],["から"],["だ"],["。"]]},{"verse":19,"text":"わたしの言うことを聞きなさい。助言をしよう。神があなたと共におられるように。あなたが民に代わって神の前に立って事件について神に述べ、","tok":[["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["助言","じょげん"],["を"],["しよう"],["。"],["神","かみ"],["が"],["あなた"],["と"],["共","とも"],["に"],["おられる"],["よう"],["に"],["。"],["あなた"],["が"],["民","たみ"],["に"],["代わって","かわって"],["神","かみ"],["の"],["前","まえ"],["に"],["立って","たって"],["事件","じけん"],["について"],["神","かみ"],["に"],["述べ","のべ"],["、"]]},{"verse":20,"text":"彼らに掟と指示を示して、彼らの歩むべき道となすべき事を教えなさい。","tok":[["彼","かれ"],["ら"],["に"],["掟","おきて"],["と"],["指示","しじ"],["を"],["示して","しめして"],["、"],["彼","かれ"],["ら"],["の"],["歩むべき","あゆむべき"],["道","みち"],["と"],["なすべき"],["事","こと"],["を"],["教え","おしえ"],["なさい"],["。"]]},{"verse":21,"text":"あなたは、民全員の中から、神を畏れる有能な人で、不正な利得を憎み、信頼に値する人物を選び、千人隊長、百人隊長、五十人隊長、十人隊長として民の上に立てなさい。","tok":[["あなた"],["は"],["、"],["民","みん"],["全員","ぜんいん"],["の"],["中","なか"],["から"],["、"],["神","かみ"],["を"],["畏れる","おそれる"],["有能","ゆうのう"],["な"],["人","ひと"],["で"],["、"],["不正","ふせい"],["な"],["利得","りとく"],["を"],["憎み","にくみ"],["、"],["信頼","しんらい"],["に"],["値","あたい"],["する"],["人物","じんぶつ"],["を"],["選び","えらび"],["、"],["千人","せんにん"],["隊長","たいちょう"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["、"],["五","ご"],["十人隊長","じゅうにんたいちょう"],["、"],["十人隊長","じゅうにんたいちょう"],["として"],["民","みん"],["の"],["上","うえ"],["に"],["立て","たて"],["なさい"],["。"]]},{"verse":22,"text":"平素は彼らに民を裁かせ、大きな事件があったときだけ、あなたのもとに持って来させる。小さな事件は彼ら自身で裁かせ、あなたの負担を軽くし、あなたと共に彼らに分担させなさい。","tok":[["平素","へいそ"],["は"],["彼","かれ"],["ら"],["に"],["民","たみ"],[
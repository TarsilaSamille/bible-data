[{"verse":1,"text":"レビの家の出のある男が同じレビ人の娘をめとった。","tok":[["レビ"],["の"],["家","いえ"],["の"],["出","で"],["の"],["ある"],["男","おとこ"],["が"],["同じ","おなじ"],["レビ人","れびにん"],["の"],["娘","むすめ"],["を"],["めとった"],["。"]]},{"verse":2,"text":"彼女は身ごもり、男の子を産んだが、その子がかわいかったのを見て、三か月の間隠しておいた。","tok":[["彼女","かのじょ"],["は"],["身ごもり","みごもり"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["が"],["、"],["その"],["子","こ"],["が"],["かわいかった"],["の"],["を"],["見て","みて"],["、"],["三","さん"],["か月","かげつ"],["の"],["間","あいだ"],["隠して","かくして"],["おいた"],["。"]]},{"verse":3,"text":"しかし、もはや隠しきれなくなったので、パピルスの籠を用意し、アスファルトとピッチで防水し、その中に男の子を入れ、ナイル河畔の葦の茂みの間に置いた。","tok":[["しかし"],["、"],["もはや"],["隠し","かくし"],["きれなく"],["なった"],["ので"],["、"],["パピルス"],["の"],["籠","かご"],["を"],["用意","ようい"],["し"],["、"],["アスファルト"],["と"],["ピッチ"],["で"],["防水","ぼうすい"],["し"],["、"],["その"],["中","なか"],["に"],["男の子","おとこのこ"],["を"],["入れ","いれ"],["、"],["ナイル"],["河畔","かはん"],["の"],["葦","あし"],["の"],["茂み","しげみ"],["の"],["間","あいだ"],["に"],["置いた","おいた"],["。"]]},{"verse":4,"text":"その子の姉が遠くに立って、どうなることかと様子を見ていると、","tok":[["その"],["子","こ"],["の"],["姉","あね"],["が"],["遠く","とおく"],["に"],["立って","たって"],["、"],["どう"],["なる"],["こと"],["か"],["と"],["様子","ようす"],["を"],["見て","みて"],["いる"],["と"],["、"]]},{"verse":5,"text":"そこへ、ファラオの王女が水浴びをしようと川に下りて来た。その間侍女たちは川岸を行き来していた。王女は、葦の茂みの間に籠を見つけたので、仕え女をやって取って来させた。","tok":[["そこ"],["へ"],["、"],["ファラオ"],["の"],["王女","おうじょ"],["が"],["水浴び","みずあび"],["を"],["しよう"],["と"],["川","かわ"],["に"],["下りて","おりて"],["来た","きた"],["。"],["その"],["間","かん"],["侍女","じじょ"],["たち"],["は"],["川岸","かわぎし"],["を"],["行き来","いきき"],["して"],["いた"],["。"],["王女","おうじょ"],["は"],["、"],["葦","あし"],["の"],["茂み","しげみ"],["の"],["間","あいだ"],["に"],["籠","かご"],["を"],["見つけた","みつけた"],["ので"],["、"],["仕え","つかえ"],["女","おんな"],["を"],["やって"],["取って","とって"],["来させた","きさせた"],["。"]]},{"verse":6,"text":"開けてみると赤ん坊がおり、しかも男の子で、泣いていた。王女はふびんに思い、「これは、きっと、ヘブライ人の子です」と言った。","tok":[["開けて","あけて"],["みる"],["と"],["赤ん坊","あかんぼう"],["が"],["おり"],["、"],["しかも"],["男の子","おとこのこ"],["で"],["、"],["泣いて","ないて"],["いた"],["。"],["王女","おうじょ"],["は"],["ふ"],["びん"],["に"],["思い","おもい"],["、"],["「"],["これ"],["は"]
[{"verse":1,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":2,"text":"「すべての初子を聖別してわたしにささげよ。イスラエルの人々の間で初めに胎を開くものはすべて、人であれ家畜であれ、わたしのものである。」","tok":[["「"],["すべて"],["の"],["初子","ういご"],["を"],["聖別","せいべつ"],["して"],["わたし"],["に"],["ささげ"],["よ"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["間","あいだ"],["で"],["初め","はじめ"],["に"],["胎","はら"],["を"],["開く","ひらく"],["もの"],["は"],["すべて"],["、"],["人","ひと"],["で"],["あれ"],["家畜","かちく"],["で"],["あれ"],["、"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["」"]]},{"verse":3,"text":"モーセは民に言った。「あなたたちは、奴隷の家、エジプトから出たこの日を記念しなさい。主が力強い御手をもって、あなたたちをそこから導き出されたからである。酵母入りのパンを食べてはならない。","tok":[["モーセ"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["は"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["、"],["エジプト"],["から"],["出た","でた"],["この"],["日","ひ"],["を"],["記念","きねん"],["し"],["なさい"],["。"],["主","ぬし"],["が"],["力強い","ちからづよい"],["御手","おて"],["を"],["もって"],["、"],["あなた"],["たち"],["を"],["そこ"],["から"],["導き出された","みちびきだされた"],["から"],["で"],["ある"],["。"],["酵母","こうぼ"],["入り","いり"],["の"],["パン"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたたちはアビブの月のこの日に出発する。","tok":[["あなた"],["たち"],["は"],["アビブ"],["の"],["月","つき"],["の"],["この"],["日","ひ"],["に"],["出発","しゅっぱつ"],["する"],["。"]]},{"verse":5,"text":"主が、あなたに与えると先祖に誓われた乳と蜜の流れる土地、カナン人、ヘト人、アモリ人、ヒビ人、エブス人の土地にあなたを導き入れられるとき、あなたはこの月にこの儀式を行わねばならない。","tok":[["主","ぬし"],["が"],["、"],["あなた"],["に"],["与える","あたえる"],["と"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["土地","とち"],["、"],["カナン人","かなんにん"],["、"],["ヘト人","へとにん"],["、"],["アモリ人","あもりにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["土地","とち"],["に"],["あなた"],["を"],["導き入れられる","みちびきいれられる"],["とき"],["、"],["あなた"],["は"],["この"],["月","つき"],["に"],["この"],["儀式","ぎしき"],["を"],["行わねば","おこなわねば"],["ならない"],["。"]]},{"verse":6,"text":"七日の間、酵母を入れないパンを食べねばならない。七日目には主のための祭りをする。","tok":[["七日","ななか"],["の"],["間","あいだ"],["、"],["酵母","こうぼ"],["を"],["入れない","いれない"],["パン"],["を"],["食べねば","たべねば"],["ならない"],["。"],["七日目","ななかめ"],["に"],["は"],["主","ぬし"],["の"],["ため"],["の"],["祭り","まつり"],["を"],["する"],["。"]]},{"verse":7,"text":"酵母を入れないパンを七日の間食べる。あなたのもとに酵母入りのパンがあってはならないし、あなたの領土のどこにも酵母があってはならない。","tok":[["酵母","こうぼ"],["を"],["入れない","いれない"],["パン"],["を"],["七","しち"],["日","にち"],["の"],["間","あいだ"],["食べる","たべる"],["。"],["あなた"],["の"],["もと"],["に"],["酵母","こうぼ"],["入り","いり"],["の"],["パン"],["が"],["あって"],["は"],["ならない"],["し"],["、"],["あなた"],["の"],["領土","りょうど"],["の"],["どこ"],["に"],["も"],["酵母","こうぼ"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":8,"text":"あなたはこの日、自分の子供に告げなければならない。『これは、わたしがエジプトから出たとき、主がわたしのために行われたことのゆえである』と。","tok":[["あなた"],["は"],["この"],["日","ひ"],["、"],["自分","じぶん"],["の"],["子供","こども"],["に"],["告げなければ","つげなければ"],["ならない"],["。"],["『"],["これ"],["は"],["、"],["わたし"],["が"],["エジプト"],["から"],["出た","でた"],["とき"],["、"],["主","ぬし"],["が"],["わたし"],["の"],["ため"],["に"],["行われた","おこなわれた"],["こと"],["の"],["ゆえ"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":9,"text":"あなたは、この言葉を自分の腕と額に付けて記憶のしるしとし、主の教えを口ずさまねばならない。主が力強い御手をもって、あなたをエジプトから導き出されたからである。","tok":[["あなた"],["は"],["、"],["この"],["言葉","ことば"],["を"],["自分","じぶん"],["の"],["腕","うで"],["と"],["額","がく"],["に"],["付けて","つけて"],["記憶","きおく"],["の"],["しるし"],["と"],["し"],["、"],["主","ぬし"],["の"],["教え","おしえ"],["を"],["口ずさまねば","くちずさまねば"],["ならない"],["。"],["主","ぬし"],["が"],["力強い","ちからづよい"],["御手","おて"],["を"],["もって"],["、"],["あなた"],["を"],["エジプト"],["から"],["導き出された","みちびきだされた"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたはこの掟を毎年定められたときに守らねばならない。","tok":[["あなた"],["は"],["この"],["掟","おきて"],["を"],["毎年","まいとし"],["定められた","さだめられた"],["とき"],["に"],["守らねば","まもらねば"],["ならない"],["。"]]},{"verse":11,"text":"主があなたと先祖に誓われたとおり、カナン人の土地にあなたを導き入れ、それをあなたに与えられるとき、","tok":[["主","ぬし"],["が"],["あなた"],["と"],["先祖","せんぞ"],["に"],["誓われた","ちかわれた"],["とおり"],["、"],["カナン人","かなんにん"],["の"],["土地","とち"],["に"],["あなた"],["を"],["導き入れ","みちびきいれ"],["、"],["それ"],["を"],["あなた"],["に"],["与えられる","あたえられる"],["とき"],["、"]]},{"verse":12,"text":"初めに胎を開くものはすべて、主にささげなければならない。あなたの家畜の初子のうち、雄はすべて主のものである。","tok":[["初め","はじめ"],["に"],["胎","はら"],["を"],["開く","ひらく"],["もの"],["は"],["すべて"],["、"],["主に","おもに"],["ささげなければ"],["ならない"],["。"],["あなた"],["の"],["家畜","かちく"],["の"],["初子","ういご"],["の"],["うち"],["、"],["雄","おす"],["は"],["すべて"],["主","ぬし"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":13,"text":"ただし、ろばの初子の場合はすべて、小羊をもって贖わねばならない。もし、贖わない場合は、その首を折らねばならない。あなたの初子のうち、男の子の場合はすべて、贖わねばならない。","tok":[["ただし"],["、"],["ろば"],["の"],["初子","ういご"],["の"],["場合","ばあい"],["は"],["すべて"],["、"],["小羊","こひつじ"],["を"],["もって"],["贖わねば","あがなわねば"],["ならない"],["。"],["もし"],["、"],["贖わない","あがなわない"],["場合","ばあい"],["は"],["、"],["その"],["首","くび"],["を"],["折らねば","おらねば"],["ならない"],["。"],["あなた"],["の"],["初子","ういご"],["の"],["うち"],["、"],["男の子","おとこのこ"],["の"],["場合","ばあい"],["は"],["すべて"],["、"],["贖わねば","あがなわねば"],["ならない"],["。"]]},{"verse":14,"text":"将来、あなたの子供が、『これにはどういう意味があるのですか』と尋ねるときは、こう答えなさい。『主は、力強い御手をもって我々を奴隷の家、エジプトから導き出された。","tok":[["将来","しょうらい"],["、"],["あなた"],["の"],["子供","こども"],["が"],["、"],["『"],["これ"],["に"],["は"],["どういう"],["意味","いみ"],["が"],["ある"],["の"],["です"],["か"],["』"],["と"],["尋ねる","たずねる"],["とき"],["は"],["、"],["こう"],["答え","こたえ"],["なさい"],["。"],["『"],["主","ぬし"],["は"],["、"],["力強い","ちからづよい"],["御手","おて"],["を"],["もって"],["我々","われわれ"],["を"],["奴隷","どれい"],["の"],["家","いえ"],["、"],["エジプト"],["から"],["導き出された","みちびきだされた"],["。"]]},{"verse":15,"text":"ファラオがかたくなで、我々を去らせなかったため、主はエジプトの国中の初子を、人の初子から家畜の初子まで、ことごとく撃たれた。それゆえわたしは、初めに胎を開く雄をすべて主に犠牲としてささげ、また、自分の息子のうち初子は、必ず贖うのである。』","tok":[["ファラオ"],["が"],["かたくな"],["で"],["、"],["我々","われわれ"],["を"],["去らせなかった","さらせなかった"],["ため"],["、"],["主","ぬし"],["は"],["エジプト"],["の"],["国中","くにちゅう"],["の"],["初子","ういご"],["を"],["、"],["人","ひと"],["の"],["初子","ういご"],["から"],["家畜","かちく"],["の"],["初子","ういご"],["まで"],["、"],["ことごとく"],["撃たれた","うたれた"],["。"],["それ"],["ゆえ"],["わたし"],["は"],["、"],["初め","はじめ"],["に"],["胎","はら"],["を"],["開く","ひらく"],["雄","おす"],["を"],["すべて"],["主に","おもに"],["犠牲","ぎせい"],["として"],["ささげ"],["、"],["また"],["、"],["自分","じぶん"],["の"],["息子","むすこ"],["の"],["うち"],["初子","ういご"],["は"],["、"],["必ず","かならず"],["贖う","あがなう"],["ので"],["ある"],["。"],["』"]]},{"verse":16,"text":"あなたはこの言葉を腕に付けてしるしとし、額に付けて覚えとしなさい。主が力強い御手をもって、我々をエジプトから導き出されたからである。」","tok":[["あなた"],["は"],["この"],["言葉","ことば"],["を"],["腕","うで"],["に"],["付けて","つけて"],["しるし"],["と"],["し"],["、"],["額","がく"],["に"],["付けて","つけて"],["覚え","おぼえ"],["と"],["し"],["なさい"],["。"],["主","ぬし"],["が"],["力強い","ちからづよい"],["御手","おて"],["を"],["もって"],["、"],["我々","われわれ"],["を"],["エジプト"],["から"],["導き出された","みちびきだされた"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":17,"text":"さて、ファラオが民を去らせたとき、神は彼らをペリシテ街道には導かれなかった。それは近道であったが、民が戦わねばならぬことを知って後悔し、エジプトに帰ろうとするかもしれない、と思われたからである。","tok":[["さて"],["、"],["ファラオ"],["が"],["民","たみ"],["を"],["去らせた","さらせた"],["とき"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["ペリシテ"],["街道","かいどう"],["に"],["は"],["導かれなかった","みちびかれなかった"],["。"],["それ"],["は"],["近道","ちかみち"],["で"],["あった"],["が"],["、"],["民","みん"],["が"],["戦わねば","たたかわねば"],["ならぬ"],["こと"],["を"],["知って","しって"],["後悔","こうかい"],["し"],["、"],["エジプト"],["に"],["帰ろう","かえろう"],["と"],["する"],["か"],["も"],["しれない"],["、"],["と"],["思われた","おもわれた"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"神は民を、葦の海に通じる荒れ野の道に迂回させられた。イスラエルの人々は、隊伍を整えてエジプトの国から上った。","tok":[["神","かみ"],["は"],["民","みん"],["を"],["、"],["葦","あし"],["の"],["海","うみ"],["に"],["通じる","つうじる"],["荒れ野","あれの"],["の"],["道","みち"],["に"],["迂回","うかい"],["させられた"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["隊伍","たいご"],["を"],["整えて","ととのえて"],["エジプト"],["の"],["国","くに"],["から"],["上った","のぼった"],["。"]]},{"verse":19,"text":"モーセはヨセフの骨を携えていた。ヨセフが、「神は必ずあなたたちを顧みられる。そのとき、わたしの骨をここから一緒に携えて上るように」と言って、イスラエルの子らに固く誓わせたからである。","tok":[["モーセ"],["は"],["ヨセフ"],["の"],["骨","ほね"],["を"],["携えて","たずさえて"],["いた"],["。"],["ヨセフ"],["が"],["、"],["「"],["神","かみ"],["は"],["必ず","かならず"],["あなた"],["たち"],["を"],["顧みられる","かえりみられる"],["。"],["その"],["とき"],["、"],["わたし"],["の"],["骨","ほね"],["を"],["ここ"],["から"],["一緒","いっしょ"],["に"],["携えて","たずさえて"],["上る","のぼる"],["よう"],["に"],["」"],["と"],["言って","いって"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["に"],["固く","かたく"],["誓わせた","ちかわせた"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"一行はスコトから旅立って、荒れ野の端のエタムに宿営した。","tok":[["一行","いっこう"],["は"],["スコト"],["から"],["旅立って","たびだって"],["、"],["荒れ野","あれの"],["の"],["端","はし"],["の"],["エタム"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":21,"text":"主は彼らに先立って進み、昼は雲の柱をもって導き、夜は火の柱をもって彼らを照らされたので、彼らは昼も夜も行進することができた。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["に"],["先立って","さきだって"],["進み","すすみ"],["、"],["昼","ひる"],["は"],["雲","くも"],["の"],["柱","はしら"],["を"],["もって"],["導き","みちびき"],["、"],["夜","よる"],["は"],["火","ひ"],["の"],["柱","はしら"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["照らされた","てらされた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["行進","こうしん"],["する"],["こと"],["が"],["できた"],["。"]]},{"verse":22,"text":"昼は雲の柱が、夜は火の柱が、民の先頭を離れることはなかった。","tok":[["昼","ひる"],["は"],["雲","くも"],["の"],["柱","はしら"],["が"],["、"],["夜","よる"],["は"],["火","ひ"],["の"],["柱","はしら"],["が"],["、"],["民","みん"],["の"],["先頭","せんとう"],["を"],["離れる","はなれる"],["こと"],["は"],["なかった"],["。"]]}]
[{"verse":1,"text":"主はモーセに仰せになった。「さあ、あなたも、あなたがエジプトの国から導き上った民も、ここをたって、わたしがアブラハム、イサク、ヤコブに誓って、『あなたの子孫にそれを与える』と言った土地に上りなさい。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["さあ"],["、"],["あなた"],["も"],["、"],["あなた"],["が"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上った","のぼった"],["民","たみ"],["も"],["、"],["ここ"],["を"],["たって"],["、"],["わたし"],["が"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓って","ちかって"],["、"],["『"],["あなた"],["の"],["子孫","しそん"],["に"],["それ"],["を"],["与える","あたえる"],["』"],["と"],["言った","いった"],["土地","とち"],["に"],["上り","のぼり"],["なさい"],["。"]]},{"verse":2,"text":"わたしは、使いをあなたに先立って遣わし、カナン人、アモリ人、ヘト人、ペリジ人、ヒビ人、エブス人を追い出す。","tok":[["わたし"],["は"],["、"],["使い","つかい"],["を"],["あなた"],["に"],["先立って","さきだって"],["遣わし","つかわし"],["、"],["カナン人","かなんにん"],["、"],["アモリ人","あもりにん"],["、"],["ヘト人","へとにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス"],["人","ひと"],["を"],["追い出す","おいだす"],["。"]]},{"verse":3,"text":"あなたは乳と蜜の流れる土地に上りなさい。しかし、わたしはあなたの間にあって上ることはしない。途中であなたを滅ぼしてしまうことがないためである。あなたはかたくなな民である。」","tok":[["あなた"],["は"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["土地","とち"],["に"],["上り","のぼり"],["なさい"],["。"],["しかし"],["、"],["わたし"],["は"],["あなた"],["の"],["間","あいだ"],["に"],["あって"],["上る","のぼる"],["こと"],["は"],["しない"],["。"],["途中","とちゅう"],["で"],["あなた"],["を"],["滅ぼして","ほろぼして"],["しまう"],["こと"],["が"],["ない"],["ため"],["で"],["ある"],["。"],["あなた"],["は"],["かたくな"],["な"],["民","たみ"],["で"],["ある"],["。"],["」"]]},{"verse":4,"text":"民はこの悪い知らせを聞いて嘆き悲しみ、一人も飾りを身に着けなかった。","tok":[["民","みん"],["は"],["この"],["悪い","わるい"],["知らせ","しらせ"],["を"],["聞いて","きいて"],["嘆き悲しみ","なげきかなしみ"],["、"],["一人","ひとり"],["も"],["飾り","かざり"],["を"],["身","み"],["に"],["着けなかった","つけなかった"],["。"]]},{"verse":5,"text":"主がモーセに、「イスラエルの人々に告げなさい。『あなたたちはかたくなな民である。わたしがひとときでも、あなたの間にあって上るならば、あなたを滅ぼしてしまうかもしれない。直ちに、身に着けている飾りを取り去りなさい。そうすれば、わたしはあなたをどのようにするか考えよう』」と言われたので、","tok":[["主","ぬし"],["が"],["モーセ"],["に"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告げ","つげ"],["なさい"],["。"],["『"],["あなた"],["たち"],["は"],["かたくな"],["な"],["民","たみ"],["で"],["ある"],["。"],["わたし"],["が"],["ひととき"],["で"],["も"],["、"],["あなた"],["の"],["間","あいだ"],["に"],["あって"],["上るならば","のぼるならば"],["、"],["あなた"],["を"],["滅ぼして","ほろぼして"],["しまう"],["か"],["も"],["しれない"],["。"],["直ちに","ただちに"],["、"],["身","み"],["に"],["着けて","つけて"],["いる"],["飾り","かざり"],["を"],["取り去り","とりさり"],["なさい"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["あなた"],["を"],["どの"],["よう"],["に"],["する"],["か"],["考えよう","かんがえよう"],["』"],["」"],["と"],["言われた","いわれた"],["ので"],["、"]]},{"verse":6,"text":"イスラエルの人々は、ホレブ山をたって後、飾りをはずした。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["ホレブ"],["山","やま"],["を"],["たって"],["後","あと"],["、"],["飾り","かざり"],["を"],["はずした"],["。"]]},{"verse":7,"text":"モーセは一つの天幕を取って、宿営の外の、宿営から遠く離れた所に張り、それを臨在の幕屋と名付けた。主に伺いを立てる者はだれでも、宿営の外にある臨在の幕屋に行くのであった。","tok":[["モーセ"],["は"],["一","ひと"],["つ"],["の"],["天幕","てんまく"],["を"],["取って","とって"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["の"],["、"],["宿営","しゅくえい"],["から"],["遠く","とおく"],["離れた","はなれた"],["所","ところ"],["に"],["張り","はり"],["、"],["それ"],["を"],["臨在","りんざい"],["の"],["幕屋","まくや"],["と"],["名付けた","なづけた"],["。"],["主に","おもに"],["伺い","うかがい"],["を"],["立てる","たてる"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["ある"],["臨在","りんざい"],["の"],["幕屋","まくや"],["に"],["行く","いく"],["ので"],["あった"],["。"]]},{"verse":8,"text":"モーセが幕屋に出て行くときには、民は全員起立し、自分の天幕の入り口に立って、モーセが幕屋に入ってしまうまで見送った。","tok":[["モーセ"],["が"],["幕屋","まくや"],["に"],["出て","でて"],["行く","いく"],["とき"],["に"],["は"],["、"],["民","みん"],["は"],["全員","ぜんいん"],["起立","きりつ"],["し"],["、"],["自分","じぶん"],["の"],["天幕","てんまく"],["の"],["入り口","いりぐち"],["に"],["立って","たって"],["、"],["モーセ"],["が"],["幕屋","まくや"],["に"],["入って","はいって"],["しまう"],["まで"],["見送った","みおくった"],["。"]]},{"verse":9,"text":"モーセが幕屋に入ると、雲の柱が降りて来て幕屋の入り口に立ち、主はモーセと語られた。","tok":[["モーセ"],["が"],["幕屋","まくや"],["に"],["入る","はいる"],["と"],["、"],["雲","くも"],["の"],["柱","はしら"],["が"],["降りて","おりて"],["来て","きて"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["立ち","たち"],["、"],["主","ぬし"],["は"],["モーセ"],["と"],["語られた","かたられた"],["。"]]},{"verse":10,"text":"雲の柱が幕屋の入り口に立つのを見ると、民は全員起立し、おのおの自分の天幕の入り口で礼拝した。","tok":[["雲","くも"],["の"],["柱","はしら"],["が"],["幕屋","まくや"],["の"],["入り口","いりぐち"],["に"],["立つ","たつ"],["の"],["を"],["見る","みる"],["と"],["、"],["民","みん"],["は"],["全員","ぜんいん"],["起立","きりつ"],["し"],["、"],["おのおの"],["自分","じぶん"],["の"],["天幕","てんまく"],["の"],["入り口","いりぐち"],["で"],["礼拝","れいはい"],["した"],["。"]]},{"verse":11,"text":"主は人がその友と語るように、顔と顔を合わせてモーセに語られた。モーセは宿営に戻ったが、彼の従者である若者、ヌンの子ヨシュアは幕屋から離れなかった。","tok":[["主","ぬし"],["は"],["人","ひと"],["が"],["その"],["友","とも"],["と"],["語る","かたる"],["よう"],["に"],["、"],["顔","かお"],["と"],["顔","かお"],["を"],["合わせて","あわせて"],["モーセ"],["に"],["語られた","かたられた"],["。"],["モーセ"],["は"],["宿営","しゅくえい"],["に"],["戻った","もどった"],["が"],["、"],["彼","かれ"],["の"],["従者","じゅうしゃ"],["で"],["ある"],["若者","わかもの"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["幕屋","まくや"],["から"],["離れなかった","はなれなかった"],["。"]]},{"verse":12,"text":"モーセは主に言った。「あなたはわたしに、『この民を率いて上れ』と言われました。しかし、わたしと共に遣わされる者をお示しになりません。あなたは、また、『わたしはあなたを名指しで選んだ。わたしはあなたに好意を示す』と言われました。","tok":[["モーセ"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["あなた"],["は"],["わたし"],["に"],["、"],["『"],["この"],["民","たみ"],["を"],["率いて","ひきいて"],["上れ","のぼれ"],["』"],["と"],["言われました","いわれました"],["。"],["しかし"],["、"],["わたし"],["と"],["共","とも"],["に"],["遣わされる","つかわされる"],["者","もの"],["を"],["お示し","おしめし"],["に"],["なりません"],["。"],["あなた"],["は"],["、"],["また"],["、"],["『"],["わたし"],["は"],["あなた"],["を"],["名指し","なざし"],["で"],["選んだ","えらんだ"],["。"],["わたし"],["は"],["あなた"],["に"],["好意","こうい"],["を"],["示す","しめす"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":13,"text":"お願いです。もしあなたがわたしに御好意を示してくださるのでしたら、どうか今、あなたの道をお示しください。そうすれば、わたしはどのようにして、あなたがわたしに御好意を示してくださるか知りうるでしょう。どうか、この国民があなたの民であることも目にお留めください。」","tok":[["お願い","おねがい"],["です"],["。"],["もし"],["あなた"],["が"],["わたし"],["に"],["御好意","ごこうい"],["を"],["示して","しめして"],["くださる"],["の"],["でしたら"],["、"],["どう"],["か"],["今","いま"],["、"],["あなた"],["の"],["道","みち"],["を"],["お示し","おしめし"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["どの"],["よう"],["に"],["して"],["、"],["あなた"],["が"],["わたし"],["に"],["御好意","ごこうい"],["を"],["示して","しめして"],["くださる"],["か"],["知り","しり"],["うるでしょう"],["。"],["どう"],["か"],["、"],["この"],["国民","こくみん"],["が"],["あなた"],["の"],["民","たみ"],["で"],["ある"],["こと"],["も"],["目","め"],["に"],["お留め","おとめ"],["ください"],["。"],["」"]]},{"verse":14,"text":"主が、「わたしが自ら同行し、あなたに安息を与えよう」と言われると、","tok":[["主","ぬし"],["が"],["、"],["「"],["わたし"],["が"],["自ら","みずから"],["同行","どうこう"],["し"],["、"],["あなた"],["に"],["安息","あんそく"],["を"],["与えよう","あたえよう"],["」"],["と"],["言われる","いわれる"],["と"],["、"]]},{"verse":15,"text":"モーセは主に言った。「もし、あなた御自身が行ってくださらないのなら、わたしたちをここから上らせないでください。","tok":[["モーセ"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["もし"],["、"],["あなた"],["御自身","ごじしん"],["が"],["行って","いって"],["くださらない"],["の"],["なら"],["、"],["わたしたち"],["を"],["ここ"],["から"],["上らせないで","のぼらせないで"],["ください"],["。"]]},{"verse":16,"text":"一体何によって、わたしとあなたの民に御好意を示してくださることが分かるでしょうか。あなたがわたしたちと共に行ってくださることによってではありませんか。そうすれば、わたしとあなたの民は、地上のすべての民と異なる特別なものとなるでしょう。」","tok":[["一体","いったい"],["何","なん"],["によって"],["、"],["わたし"],["と"],["あなた"],["の"],["民","たみ"],["に"],["御好意","ごこうい"],["を"],["示して","しめして"],["くださる"],["こと"],["が"],["分かるでしょう","わかるでしょう"],["か"],["。"],["あなた"],["が"],["わたしたち"],["と"],["共","とも"],["に"],["行って","いって"],["くださる"],["こと"],["によって"],["で"],["は"],["ありません"],["か"],["。"],["そう"],["すれば"],["、"],["わたし"],["と"],["あなた"],["の"],["民","たみ"],["は"],["、"],["地上","ちじょう"],["の"],["すべて"],["の"],["民","たみ"],["と"],["異なる","ことなる"],["特別","とくべつ"],["な"],["もの"],["と"],["なるでしょう"],["。"],["」"]]},{"verse":17,"text":"主はモーセに言われた。「わたしは、あなたのこの願いもかなえよう。わたしはあなたに好意を示し、あなたを名指しで選んだからである。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["の"],["この"],["願い","ねがい"],["も"],["かなえよう"],["。"],["わたし"],["は"],["あなた"],["に"],["好意","こうい"],["を"],["示し","しめし"],["、"],["あなた"],["を"],["名指し","なざし"],["で"],["選んだ","えらんだ"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":18,"text":"モーセが、「どうか、あなたの栄光をお示しください」と言うと、","tok":[["モーセ"],["が"],["、"],["「"],["どう"],["か"],["、"],["あなた"],["の"],["栄光","えいこう"],["を"],["お示し","おしめし"],["ください"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":19,"text":"主は言われた。「わたしはあなたの前にすべてのわたしの善い賜物を通らせ、あなたの前に主という名を宣言する。わたしは恵もうとする者を恵み、憐れもうとする者を憐れむ。」","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["あなた"],["の"],["前","まえ"],["に"],["すべて"],["の"],["わたし"],["の"],["善い","よい"],["賜物","たまもの"],["を"],["通らせ","とおらせ"],["、"],["あなた"],["の"],["前","まえ"],["に"],["主","ぬし"],["と"],["いう"],["名","な"],["を"],["宣言","せんげん"],["する"],["。"],["わたし"],["は"],["恵もう","めぐもう"],["と"],["する"],["者","もの"],["を"],["恵み","めぐみ"],["、"],["憐れもう","あわれもう"],["と"],["する"],["者","もの"],["を"],["憐れむ","あわれむ"],["。"],["」"]]},{"verse":20,"text":"また言われた。「あなたはわたしの顔を見ることはできない。人はわたしを見て、なお生きていることはできないからである。」","tok":[["また"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["わたし"],["の"],["顔","かお"],["を"],["見る","みる"],["こと"],["は"],["できない"],["。"],["人","ひと"],["は"],["わたし"],["を"],["見て","みて"],["、"],["なお"],["生きて","いきて"],["いる"],["こと"],["は"],["できない"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":21,"text":"更に、主は言われた。「見よ、一つの場所がわたしの傍らにある。あなたはその岩のそばに立ちなさい。","tok":[["更に","さらに"],["、"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["見よ","みよ"],["、"],["一","ひと"],["つ"],["の"],["場所","ばしょ"],["が"],["わたし"],["の"],["傍ら","かたわら"],["に"],["ある"],["。"],["あなた"],["は"],["その"],["岩","いわ"],["の"],["そば"],["に"],["立ち","たち"],["なさい"],["。"]]},{"verse":22,"text":"わが栄光が通り過ぎるとき、わたしはあなたをその岩の裂け目に入れ、わたしが通り過ぎるまで、わたしの手であなたを覆う。","tok":[["わが"],["栄光","えいこう"],["が"],["通り過ぎる","とおりすぎる"],["とき"],["、"],["わたし"],["は"],["あなた"],["を"],["その"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["入れ","いれ"],["、"],["わたし"],["が"],["通り過ぎる","とおりすぎる"],["まで"],["、"],["わたし"],["の"],["手","て"],["で"],["あなた"],["を"],["覆う","おおう"],["。"]]},{"verse":23,"text":"わたしが手を離すとき、あなたはわたしの後ろを見るが、わたしの顔は見えない。」","tok":[["わたし"],["が"],["手","て"],["を"],["離す","はなす"],["とき"],["、"],["あなた"],["は"],["わたし"],["の"],["後ろ","うしろ"],["を"],["見る","みる"],["が"],["、"],["わたし"],["の"],["顔","かお"],["は"],["見えない","みえない"],["。"],["」"]]}]
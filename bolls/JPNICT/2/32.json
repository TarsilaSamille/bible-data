[{"verse":1,"text":"モーセが山からなかなか下りて来ないのを見て、民がアロンのもとに集まって来て、「さあ、我々に先立って進む神々を造ってください。エジプトの国から我々を導き上った人、あのモーセがどうなってしまったのか分からないからです」と言うと、","tok":[["モーセ"],["が"],["山","やま"],["から"],["なかなか"],["下りて","おりて"],["来ない","こない"],["の"],["を"],["見て","みて"],["、"],["民","みん"],["が"],["アロン"],["の"],["もと"],["に"],["集まって","あつまって"],["来て","きて"],["、"],["「"],["さあ"],["、"],["我々","われわれ"],["に"],["先立って","さきだって"],["進む","すすむ"],["神々","かみがみ"],["を"],["造って","つくって"],["ください"],["。"],["エジプト"],["の"],["国","くに"],["から"],["我々","われわれ"],["を"],["導き","みちびき"],["上った","のぼった"],["人","ひと"],["、"],["あの"],["モーセ"],["が"],["どう"],["なって"],["しまった"],["の"],["か"],["分からない","わからない"],["から"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":2,"text":"アロンは彼らに言った。「あなたたちの妻、息子、娘らが着けている金の耳輪をはずし、わたしのところに持って来なさい。」","tok":[["アロン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["の"],["妻","つま"],["、"],["息子","むすこ"],["、"],["娘","むすめ"],["ら"],["が"],["着けて","つけて"],["いる"],["金","かね"],["の"],["耳輪","みみわ"],["を"],["はずし"],["、"],["わたし"],["の"],["ところ"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["」"]]},{"verse":3,"text":"民は全員、着けていた金の耳輪をはずし、アロンのところに持って来た。","tok":[["民","みん"],["は"],["全員","ぜんいん"],["、"],["着けて","つけて"],["いた"],["金","かね"],["の"],["耳輪","みみわ"],["を"],["はずし"],["、"],["アロン"],["の"],["ところ"],["に"],["持って","もって"],["来た","きた"],["。"]]},{"verse":4,"text":"彼はそれを受け取ると、のみで型を作り、若い雄牛の鋳像を造った。すると彼らは、「イスラエルよ、これこそあなたをエジプトの国から導き上ったあなたの神々だ」と言った。","tok":[["彼","かれ"],["は"],["それ"],["を"],["受け取る","うけとる"],["と"],["、"],["のみ"],["で"],["型","かた"],["を"],["作り","つくり"],["、"],["若い","わかい"],["雄牛","おうし"],["の"],["鋳像","ちゅうぞう"],["を"],["造った","つくった"],["。"],["する"],["と"],["彼","かれ"],["ら"],["は"],["、"],["「"],["イスラエル"],["よ"],["、"],["これ"],["こそ"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上った","のぼった"],["あなた"],["の"],["神々","かみがみ"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"アロンはこれを見て、その前に祭壇を築き、「明日、主の祭りを行う」と宣言した。","tok":[["アロン"],["は"],["これ"],["を"],["見て","みて"],["、"],["その"],["前","まえ"],["に"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["「"],["明日","あす"],["、"],["主","ぬし"],["の"],["祭り","まつり"],["を"],["行う","おこなう"],["」"],["と"],["宣言","せんげん"],["した"],["。"]]},{"verse":6,"text":"彼らは次の朝早く起き、焼き尽くす献げ物をささげ、和解の献げ物を供えた。民は座って飲み食いし、立っては戯れた。","tok":[["彼","かれ"],["ら"],["は"],["次","つぎ"],["の"],["朝","あさ"],["早く","はやく"],["起き","おき"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげ"],["、"],["和解","わかい"],["の"],["献げ物","ささげもの"],["を"],["供えた","そなえた"],["。"],["民","たみ"],["は"],["座って","すわって"],["飲み食い","のみくい"],["し"],["、"],["立って","たって"],["は"],["戯れた","たわむれた"],["。"]]},{"verse":7,"text":"主はモーセに仰せになった。「直ちに下山せよ。あなたがエジプトの国から導き上った民は堕落し、","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["直ちに","ただちに"],["下山","げざん"],["せよ"],["。"],["あなた"],["が"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上った","のぼった"],["民","たみ"],["は"],["堕落","だらく"],["し"],["、"]]},{"verse":8,"text":"早くもわたしが命じた道からそれて、若い雄牛の鋳像を造り、それにひれ伏し、いけにえをささげて、『イスラエルよ、これこそあなたをエジプトの国から導き上った神々だ』と叫んでいる。」","tok":[["早く","はやく"],["も"],["わたし"],["が"],["命じた","めいじた"],["道","みち"],["から"],["それ"],["て"],["、"],["若い","わかい"],["雄牛","おうし"],["の"],["鋳像","ちゅうぞう"],["を"],["造り","つくり"],["、"],["それ"],["に"],["ひれ伏し","ひれふし"],["、"],["いけにえ"],["を"],["ささげて"],["、"],["『"],["イスラエル"],["よ"],["、"],["これ"],["こそ"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上った","のぼった"],["神々","かみがみ"],["だ"],["』"],["と"],["叫んで","さけんで"],["いる"],["。"],["」"]]},{"verse":9,"text":"主は更に、モーセに言われた。「わたしはこの民を見てきたが、実にかたくなな民である。","tok":[["主","ぬし"],["は"],["更に","さらに"],["、"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["この"],["民","たみ"],["を"],["見て","みて"],["きた"],["が"],["、"],["実","じつ"],["に"],["かたくな"],["な"],["民","たみ"],["で"],["ある"],["。"]]},{"verse":10,"text":"今は、わたしを引き止めるな。わたしの怒りは彼らに対して燃え上がっている。わたしは彼らを滅ぼし尽くし、あなたを大いなる民とする。」","tok":[["今","いま"],["は"],["、"],["わたし"],["を"],["引き止める","ひきとめる"],["な"],["。"],["わたし"],["の"],["怒り","いかり"],["は"],["彼","かれ"],["ら"],["に対して","にたいして"],["燃え上がって","もえあがって"],["いる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["尽くし","つくし"],["、"],["あなた"],["を"],["大いなる","おおいなる"],["民","たみ"],["と"],["する"],["。"],["」"]]},{"verse":11,"text":"モーセは主なる神をなだめて言った。「主よ、どうして御自分の民に向かって怒りを燃やされるのですか。あなたが大いなる御力と強い御手をもってエジプトの国から導き出された民ではありませんか。","tok":[["モーセ"],["は"],["主","おも"],["なる"],["神","かみ"],["を"],["なだめて"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["どう"],["して"],["御自分","ごじぶん"],["の"],["民","たみ"],["に"],["向かって","むかって"],["怒り","いかり"],["を"],["燃やされる","もやされる"],["の"],["です"],["か"],["。"],["あなた"],["が"],["大いなる","おおいなる"],["御力","おちから"],["と"],["強い","つよい"],["御手","おて"],["を"],["もって"],["エジプト"],["の"],["国","くに"],["から"],["導き出された","みちびきだされた"],["民","たみ"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":12,"text":"どうしてエジプト人に、『あの神は、悪意をもって彼らを山で殺し、地上から滅ぼし尽くすために導き出した』と言わせてよいでしょうか。どうか、燃える怒りをやめ、御自分の民にくだす災いを思い直してください。","tok":[["どう"],["して"],["エジプト"],["人","にん"],["に"],["、"],["『"],["あの"],["神","かみ"],["は"],["、"],["悪意","あくい"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["山","やま"],["で"],["殺し","ころし"],["、"],["地上","ちじょう"],["から"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["ため"],["に"],["導き出した","みちびきだした"],["』"],["と"],["言わせて","いわせて"],["よいでしょう"],["か"],["。"],["どう"],["か"],["、"],["燃える","もえる"],["怒り","いかり"],["を"],["やめ"],["、"],["御自分","ごじぶん"],["の"],["民","たみ"],["に"],["くだす"],["災い","わざわい"],["を"],["思い直して","おもいなおして"],["ください"],["。"]]},{"verse":13,"text":"どうか、あなたの僕であるアブラハム、イサク、イスラエルを思い起こしてください。あなたは彼らに自ら誓って、『わたしはあなたたちの子孫を天の星のように増やし、わたしが与えると約束したこの土地をことごとくあなたたちの子孫に授け、永久にそれを継がせる』と言われたではありませんか。」","tok":[["どう"],["か"],["、"],["あなた"],["の"],["僕","ぼく"],["で"],["ある"],["アブラハム"],["、"],["イサク"],["、"],["イスラエル"],["を"],["思い起こして","おもいおこして"],["ください"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["自ら","みずから"],["誓って","ちかって"],["、"],["『"],["わたし"],["は"],["あなた"],["たち"],["の"],["子孫","しそん"],["を"],["天","てん"],["の"],["星","ほし"],["の"],["よう"],["に"],["増やし","ふやし"],["、"],["わたし"],["が"],["与える","あたえる"],["と"],["約束","やくそく"],["した"],["この"],["土地","とち"],["を"],["ことごとく"],["あなた"],["たち"],["の"],["子孫","しそん"],["に"],["授け","さずけ"],["、"],["永久","えいきゅう"],["に"],["それ"],["を"],["継がせる","つがせる"],["』"],["と"],["言われたで","いわれたで"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":14,"text":"主は御自身の民にくだす、と告げられた災いを思い直された。","tok":[["主","ぬし"],["は"],["御自身","ごじしん"],["の"],["民","たみ"],["に"],["くだす"],["、"],["と"],["告げられた","つげられた"],["災い","わざわい"],["を"],["思い直された","おもいなおされた"],["。"]]},{"verse":15,"text":"モーセが身を翻して山を下るとき、二枚の掟の板が彼の手にあり、板には文字が書かれていた。その両面に、表にも裏にも文字が書かれていた。","tok":[["モーセ"],["が"],["身","み"],["を"],["翻して","ひるがえして"],["山","やま"],["を"],["下る","くだる"],["とき"],["、"],["二枚","にまい"],["の"],["掟","おきて"],["の"],["板","いた"],["が"],["彼","かれ"],["の"],["手","て"],["に"],["あり"],["、"],["板","いた"],["に"],["は"],["文字","もじ"],["が"],["書かれて","かかれて"],["いた"],["。"],["その"],["両面","りょうめん"],["に"],["、"],["表","ひょう"],["に"],["も"],["裏","うら"],["に"],["も"],["文字","もじ"],["が"],["書かれて","かかれて"],["いた"],["。"]]},{"verse":16,"text":"その板は神御自身が作られ、筆跡も神御自身のものであり、板に彫り刻まれていた。","tok":[["その"],["板","いた"],["は"],["神","かみ"],["御自身","ごじしん"],["が"],["作られ","つくられ"],["、"],["筆跡","ひっせき"],["も"],["神","かみ"],["御自身","ごじしん"],["の"],["もの"],["で"],["あり"],["、"],["板","いた"],["に"],["彫り刻まれて","ほりきざまれて"],["いた"],["。"]]},{"verse":17,"text":"ヨシュアが民のどよめく声を聞いて、モーセに、「宿営で戦いの声がします」と言うと、","tok":[["ヨシュア"],["が"],["民","たみ"],["の"],["どよめく"],["声","こえ"],["を"],["聞いて","きいて"],["、"],["モーセ"],["に"],["、"],["「"],["宿営","しゅくえい"],["で"],["戦い","たたかい"],["の"],["声","こえ"],["が"],["します"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":18,"text":"モーセは言った。「これは勝利の叫び声でも敗戦の叫び声でもない。わたしが聞くのは歌をうたう声だ。」","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["これ"],["は"],["勝利","しょうり"],["の"],["叫び声","さけびごえ"],["で"],["も"],["敗戦","はいせん"],["の"],["叫び声","さけびごえ"],["で"],["も"],["ない"],["。"],["わたし"],["が"],["聞く","きく"],["の"],["は"],["歌","うた"],["を"],["うたう"],["声","こえ"],["だ"],["。"],["」"]]},{"verse":19,"text":"宿営に近づくと、彼は若い雄牛の像と踊りを見た。モーセは激しく怒って、手に持っていた板を投げつけ、山のふもとで砕いた。","tok":[["宿営","しゅくえい"],["に"],["近づく","ちかづく"],["と"],["、"],["彼","かれ"],["は"],["若い","わかい"],["雄牛","おうし"],["の"],["像","ぞう"],["と"],["踊り","おどり"],["を"],["見た","みた"],["。"],["モーセ"],["は"],["激しく","はげしく"],["怒って","おこって"],["、"],["手","て"],["に"],["持って","もって"],["いた"],["板","いた"],["を"],["投げつけ","なげつけ"],["、"],["山","やま"],["の"],["ふもと"],["で"],["砕いた","くだいた"],["。"]]},{"verse":20,"text":"そして、彼らが造った若い雄牛の像を取って火で焼き、それを粉々に砕いて水の上にまき散らし、イスラエルの人々に飲ませた。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["が"],["造った","つくった"],["若い","わかい"],["雄牛","おうし"],["の"],["像","ぞう"],["を"],["取って","とって"],["火","ひ"],["で"],["焼き","やき"],["、"],["それ"],["を"],["粉々","こなごな"],["に"],["砕いて","くだいて"],["水","みず"],["の"],["上","うえ"],["に"],["まき散らし","まきちらし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["飲ませた","のませた"],["。"]]},{"verse":21,"text":"モーセはアロンに、「この民があなたに一体何をしたというので、あなたはこの民にこんな大きな罪を犯させたのか」と言うと、","tok":[["モーセ"],["は"],["アロン"],["に"],["、"],["「"],["この"],["民","たみ"],["が"],["あなた"],["に"],["一体","いったい"],["何","なん"],["を"],["した"],["と"],["いう"],["ので"],["、"],["あなた"],["は"],["この"],["民","たみ"],["に"],["こんな"],["大きな","おおきな"],["罪","つみ"],["を"],["犯させた","おかさせた"],["の"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":22,"text":"アロンは言った。「わたしの主よ、どうか怒らないでください。この民が悪いことはあなたもご存じです。","tok":[["アロン"],["は"],["言った","いった"],["。"],["「"],["わたし"],["の"],["主","ぬし"],["よ"],["、"],["どう"],["か"],["怒らないで","おこらないで"],["ください"],["。"],["この"],["民","たみ"],["が"],["悪い","わるい"],["こと"],["は"],["あなた"],["も"],["ご存じ","ごぞんじ"],["です"],["。"]]},{"verse":23,"text":"彼らはわたしに、『我々に先立って進む神々を造ってください。我々をエジプトの国から導き上った人、あのモーセがどうなってしまったのか分からないからです』と言いましたので、","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["に"],["、"],["『"],["我々","われわれ"],["に"],["先立って","さきだって"],["進む","すすむ"],["神々","かみがみ"],["を"],["造って","つくって"],["ください"],["。"],["我々","われわれ"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上った","のぼった"],["人","ひと"],["、"],["あの"],["モーセ"],["が"],["どう"],["なって"],["しまった"],["の"],["か"],["分からない","わからない"],["から"],["です"],["』"],["と"],["言いました","いいました"],["ので"],["、"]]},{"verse":24,"text":"わたしが彼らに、『だれでも金を持っている者は、それをはずしなさい』と言うと、彼らはわたしに差し出しました。わたしがそれを火に投げ入れると、この若い雄牛ができたのです。」","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["に"],["、"],["『"],["だれ"],["で"],["も"],["金","きん"],["を"],["持って","もって"],["いる"],["者","もの"],["は"],["、"],["それ"],["を"],["はずし"],["なさい"],["』"],["と"],["言う","ゆう"],["と"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["差し出しました","さしだしました"],["。"],["わたし"],["が"],["それ"],["を"],["火","ひ"],["に"],["投げ入れる","なげいれる"],["と"],["、"],["この"],["若い","わかい"],["雄牛","おうし"],["が"],["できた"],["の"],["です"],["。"],["」"]]},{"verse":25,"text":"モーセはこの民が勝手なふるまいをしたこと、アロンが彼らに勝手なふるまいをさせて、敵対する者の嘲りの種となったことを見ると、","tok":[["モーセ"],["は"],["この"],["民","たみ"],["が"],["勝手","かって"],["な"],["ふるまい"],["を"],["した"],["こと"],["、"],["アロン"],["が"],["彼","かれ"],["ら"],["に"],["勝手","かって"],["な"],["ふるまい"],["を"],["させて"],["、"],["敵対","てきたい"],["する"],["者","もの"],["の"],["嘲り","あざけり"],["の"],["種","しゅ"],["と"],["なった"],["こと"],["を"],["見る","みる"],["と"],["、"]]},{"verse":26,"text":"宿営の入り口に立ち、「だれでも主につく者は、わたしのもとに集まれ」と言った。レビの子らが全員彼のもとに集まると、","tok":[["宿営","しゅくえい"],["の"],["入り口","いりぐち"],["に"],["立ち","たち"],["、"],["「"],["だれ"],["で"],["も"],["主に","おもに"],["つく"],["者","もの"],["は"],["、"],["わたし"],["の"],["もと"],["に"],["集まれ","あつまれ"],["」"],["と"],["言った","いった"],["。"],["レビ"],["の"],["子","こ"],["ら"],["が"],["全員","ぜんいん"],["彼","かれ"],["の"],["もと"],["に"],["集まる","あつまる"],["と"],["、"]]},{"verse":27,"text":"彼らに、「イスラエルの神、主がこう言われる。『おのおの、剣を帯び、宿営を入り口から入り口まで行き巡って、おのおの自分の兄弟、友、隣人を殺せ』」と命じた。","tok":[["彼","かれ"],["ら"],["に"],["、"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["こう"],["言われる","いわれる"],["。"],["『"],["おのおの"],["、"],["剣","けん"],["を"],["帯び","おび"],["、"],["宿営","しゅくえい"],["を"],["入り口","いりぐち"],["から"],["入り口","いりぐち"],["まで"],["行き","いき"],["巡って","めぐって"],["、"],["おのおの"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["、"],["友","とも"],["、"],["隣人","りんじん"],["を"],["殺せ","ころせ"],["』"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":28,"text":"レビの子らは、モーセの命じたとおりに行った。その日、民のうちで倒れた者はおよそ三千人であった。","tok":[["レビ"],["の"],["子","こ"],["ら"],["は"],["、"],["モーセ"],["の"],["命じた","めいじた"],["とおり"],["に"],["行った","いった"],["。"],["その"],["日","ひ"],["、"],["民","みん"],["の"],["うち"],["で"],["倒れた","たおれた"],["者","もの"],["は"],["およそ"],["三千人","さんせんにん"],["で"],["あった"],["。"]]},{"verse":29,"text":"モーセは言った。「おのおの自分の子や兄弟に逆らったから、今日、あなたたちは主の祭司職に任命された。あなたたちは今日、祝福を受ける。」","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["おのおの"],["自分","じぶん"],["の"],["子","こ"],["や"],["兄弟","きょうだい"],["に"],["逆らった","さからった"],["から"],["、"],["今日","きょう"],["、"],["あなた"],["たち"],["は"],["主","ぬし"],["の"],["祭司","さいし"],["職","しょく"],["に"],["任命","にんめい"],["された"],["。"],["あなた"],["たち"],["は"],["今日","きょう"],["、"],["祝福","しゅくふく"],["を"],["受ける","うける"],["。"],["」"]]},{"verse":30,"text":"翌日になって、モーセは民に言った。「お前たちは大きな罪を犯した。今、わたしは主のもとに上って行く。あるいは、お前たちの罪のために贖いができるかもしれない。」","tok":[["翌日","よくじつ"],["に"],["なって"],["、"],["モーセ"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["たち"],["は"],["大きな","おおきな"],["罪","つみ"],["を"],["犯した","おかした"],["。"],["今","いま"],["、"],["わたし"],["は"],["主","ぬし"],["の"],["もと"],["に"],["上って","のぼって"],["行く","いく"],["。"],["あるいは"],["、"],["お前","おまえ"],["たち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["贖い","あがない"],["が"],["できる"],["か"],["も"],["しれない"],["。"],["」"]]},{"verse":31,"text":"モーセは主のもとに戻って言った。「ああ、この民は大きな罪を犯し、金の神を造りました。","tok":[["モーセ"],["は"],["主","ぬし"],["の"],["もと"],["に"],["戻って","もどって"],["言った","いった"],["。"],["「"],["ああ"],["、"],["この"],["民","みん"],["は"],["大きな","おおきな"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["金","きん"],["の"],["神","かみ"],["を"],["造りました","つくりました"],["。"]]},{"verse":32,"text":"今、もしもあなたが彼らの罪をお赦しくださるのであれば……。もし、それがかなわなければ、どうかこのわたしをあなたが書き記された書の中から消し去ってください。」","tok":[["今","いま"],["、"],["もし"],["も"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["お赦し","おゆるし"],["くださる"],["ので"],["あれば"],["…"],["…"],["。"],["もし"],["、"],["それ"],["が"],["かなわなければ"],["、"],["どう"],["か"],["この"],["わたし"],["を"],["あなた"],["が"],["書き記された","かきしるされた"],["書","しょ"],["の"],["中","なか"],["から"],["消し去って","けしさって"],["ください"],["。"],["」"]]},{"verse":33,"text":"主はモーセに言われた。「わたしに罪を犯した者はだれでも、わたしの書から消し去る。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["わたし"],["の"],["書","しょ"],["から"],["消し去る","けしさる"],["。"]]},{"verse":34,"text":"しかし今、わたしがあなたに告げた所にこの民を導いて行きなさい。見よ、わたしの使いがあなたに先立って行く。しかし、わたしの裁きの日に、わたしは彼らをその罪のゆえに罰する。」","tok":[["しかし"],["今","いま"],["、"],["わたし"],["が"],["あなた"],["に"],["告げた","つげた"],["所","ところ"],["に"],["この"],["民","たみ"],["を"],["導いて","みちびいて"],["行き","いき"],["なさい"],["。"],["見よ","みよ"],["、"],["わたし"],["の"],["使い","つかい"],["が"],["あなた"],["に"],["先立って","さきだって"],["行く","いく"],["。"],["しかし"],["、"],["わたし"],["の"],["裁き","さばき"],["の"],["日","ひ"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["その
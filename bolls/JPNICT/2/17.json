[{"verse":1,"text":"主の命令により、イスラエルの人々の共同体全体は、シンの荒れ野を出発し、旅程に従って進み、レフィディムに宿営したが、そこには民の飲み水がなかった。","tok":[["主","ぬし"],["の"],["命令","めいれい"],["に"],["より"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["、"],["シン"],["の"],["荒れ野","あれの"],["を"],["出発","しゅっぱつ"],["し"],["、"],["旅程","りょてい"],["に"],["従って","したがって"],["進み","すすみ"],["、"],["レフィディム"],["に"],["宿営","しゅくえい"],["した"],["が"],["、"],["そこ"],["に"],["は"],["民","みん"],["の"],["飲み水","のみみず"],["が"],["なかった"],["。"]]},{"verse":2,"text":"民がモーセと争い、「我々に飲み水を与えよ」と言うと、モーセは言った。「なぜ、わたしと争うのか。なぜ、主を試すのか。」","tok":[["民","みん"],["が"],["モーセ"],["と"],["争い","あらそい"],["、"],["「"],["我々","われわれ"],["に"],["飲み水","のみみず"],["を"],["与えよ","あたえよ"],["」"],["と"],["言う","ゆう"],["と"],["、"],["モーセ"],["は"],["言った","いった"],["。"],["「"],["なぜ"],["、"],["わたし"],["と"],["争う","あらそう"],["の"],["か"],["。"],["なぜ"],["、"],["主","ぬし"],["を"],["試す","ためす"],["の"],["か"],["。"],["」"]]},{"verse":3,"text":"しかし、民は喉が渇いてしかたないので、モーセに向かって不平を述べた。「なぜ、我々をエジプトから導き上ったのか。わたしも子供たちも、家畜までも渇きで殺すためなのか。」","tok":[["しかし"],["、"],["民","みん"],["は"],["喉","のど"],["が"],["渇いて","かわいて"],["しかたない"],["ので"],["、"],["モーセ"],["に"],["向かって","むかって"],["不平","ふへい"],["を"],["述べた","のべた"],["。"],["「"],["なぜ"],["、"],["我々","われわれ"],["を"],["エジプト"],["から"],["導き","みちびき"],["上った","のぼった"],["の"],["か"],["。"],["わたし"],["も"],["子供","こども"],["たち"],["も"],["、"],["家畜","かちく"],["まで"],["も"],["渇き","かわき"],["で"],["殺す","ころす"],["ため"],["な"],["の"],["か"],["。"],["」"]]},{"verse":4,"text":"モーセは主に、「わたしはこの民をどうすればよいのですか。彼らは今にも、わたしを石で打ち殺そうとしています」と叫ぶと、","tok":[["モーセ"],["は"],["主に","おもに"],["、"],["「"],["わたし"],["は"],["この"],["民","たみ"],["を"],["どう"],["すれば"],["よい"],["の"],["です"],["か"],["。"],["彼","かれ"],["ら"],["は"],["今","いま"],["に"],["も"],["、"],["わたし"],["を"],["石","いし"],["で"],["打ち殺そう","うちころそう"],["として"],["います"],["」"],["と"],["叫ぶ","さけぶ"],["と"],["、"]]},{"verse":5,"text":"主はモーセに言われた。「イスラエルの長老数名を伴い、民の前を進め。また、ナイル川を打った杖を持って行くがよい。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["イスラエル"],["の"],["長老","ちょうろう"],["数","すう"],["名","めい"],["を"],["伴い","ともない"],["、"],["民","みん"],["の"],["前","まえ"],["を"],["進め","すすめ"],["。"],["また"],["、"],["ナイル"],["川","かわ"],["を"],["打った","うった"],["杖","つえ"],["を"],["持って","もって"],["行く","いく"],["が"],["よい"],["。"]]},{"verse":6,"text":"見よ、わたしはホレブの岩の上であなたの前に立つ。あなたはその岩を打て。そこから水が出て、民は飲むことができる。」モーセは、イスラエルの長老たちの目の前でそのとおりにした。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["ホレブ"],["の"],["岩","いわ"],["の"],["上","うえ"],["で"],["あなた"],["の"],["前","まえ"],["に"],["立つ","たつ"],["。"],["あなた"],["は"],["その"],["岩","いわ"],["を"],["打て","うて"],["。"],["そこ"],["から"],["水","みず"],["が"],["出て","でて"],["、"],["民","みん"],["は"],["飲む","のむ"],["こと"],["が"],["できる"],["。"],["」"],["モーセ"],["は"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["その"],["とおり"],["に"],["した"],["。"]]},{"verse":7,"text":"彼は、その場所をマサ（試し）とメリバ（争い）と名付けた。イスラエルの人々が、「果たして、主は我々の間におられるのかどうか」と言って、モーセと争い、主を試したからである。","tok":[["彼","かれ"],["は"],["、"],["その"],["場所","ばしょ"],["を"],["マサ"],["（"],["試し","ためし"],["）"],["と"],["メリバ"],["（"],["争い","あらそい"],["）"],["と"],["名付けた","なづけた"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["「"],["果たして","はたして"],["、"],["主","ぬし"],["は"],["我々","われわれ"],["の"],["間","あいだ"],["に"],["おられる"],["の"],["か"],["どう"],["か"],["」"],["と"],["言って","いって"],["、"],["モーセ"],["と"],["争い","あらそい"],["、"],["主","ぬし"],["を"],["試した","ためした"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"アマレクがレフィディムに来てイスラエルと戦ったとき、","tok":[["アマレク"],["が"],["レフィディム"],["に"],["来て","きて"],["イスラエル"],["と"],["戦った","たたかった"],["とき"],["、"]]},{"verse":9,"text":"モーセはヨシュアに言った。「男子を選び出し、アマレクとの戦いに出陣させるがよい。明日、わたしは神の杖を手に持って、丘の頂に立つ。」","tok":[["モーセ"],["は"],["ヨシュア"],["に"],["言った","いった"],["。"],["「"],["男子","だんし"],["を"],["選び出し","えらびだし"],["、"],["アマレク"],["と"],["の"],["戦い","たたかい"],["に"],["出陣","しゅつじん"],["させる"],["が"],["よい"],["。"],["明日","あす"],["、"],["わたし"],["は"],["神","かみ"],["の"],["杖","つえ"],["を"],["手","て"],["に"],["持って","もって"],["、"],["丘","おか"],["の"],["頂","いただき"],["に"],["立つ","たつ"],["。"],["」"]]},{"verse":10,"text":"ヨシュアは、モーセの命じたとおりに実行し、アマレクと戦った。モーセとアロン、そしてフルは丘の頂に登った。","tok":[["ヨシュア"],["は"],["、"],["モーセ"],["の"],["命じた","めいじた"],["とおり"],["に"],["実行","じっこう"],["し"],["、"],["アマレク"],["と"],["戦った","たたかった"],["。"],["モーセ"],["と"],["アロン"],["、"],["そして"],["フル"],["は"],["丘","おか"],["の"],["頂","いただき"],["に"],["登った","のぼった"],["。"]]},{"verse":11,"text":"モーセが手を上げている間、イスラエルは優勢になり、手を下ろすと、アマレクが優勢になった。","tok":[["モーセ"],["が"],["手","て"],["を"],["上げて","あげて"],["いる"],["間","あいだ"],["、"],["イスラエル"],["は"],["優勢","ゆうせい"],["に"],["なり"],["、"],["手","て"],["を"],["下ろす","おろす"],["と"],["、"],["アマレク"],["が"],["優勢","ゆうせい"],["に"],["なった"],["。"]]},{"verse":12,"text":"モーセの手が重くなったので、アロンとフルは石を持って来てモーセの下に置いた。モーセはその上に座り、アロンとフルはモーセの両側に立って、彼の手を支えた。その手は、日の沈むまで、しっかりと上げられていた。","tok":[["モーセ"],["の"],["手","て"],["が"],["重く","おもく"],["なった"],["ので"],["、"],["アロン"],["と"],["フル"],["は"],["石","いし"],["を"],["持って","もって"],["来て","きて"],["モーセ"],["の"],["下","した"],["に"],["置いた","おいた"],["。"],["モーセ"],["は"],["その"],["上","うえ"],["に"],["座り","すわり"],["、"],["アロン"],["と"],["フル"],["は"],["モーセ"],["の"],["両側","りょうがわ"],["に"],["立って","たって"],["、"],["彼","かれ"],["の"],["手","て"],["を"],["支えた","ささえた"],["。"],["その"],["手","て"],["は"],["、"],["日","ひ"],["の"],["沈む","しずむ"],["まで"],["、"],["しっかり"],["と"],["上げられて","あげられて"],["いた"],["。"]]},{"verse":13,"text":"ヨシュアは、アマレクとその民を剣にかけて打ち破った。","tok":[["ヨシュア"],["は"],["、"],["アマレク"],["と"],["その"],["民","たみ"],["を"],["剣","けん"],["に"],["かけて"],["打ち破った","うちやぶった"],["。"]]},{"verse":14,"text":"主はモーセに言われた。「このことを文書に書き記して記念とし、また、ヨシュアに読み聞かせよ。『わたしは、アマレクの記憶を天の下から完全にぬぐい去る』と。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["この"],["こと"],["を"],["文書","ぶんしょ"],["に"],["書き記して","かきしるして"],["記念","きねん"],["と"],["し"],["、"],["また"],["、"],["ヨシュア"],["に"],["読み聞かせ","よみきかせ"],["よ"],["。"],["『"],["わたし"],["は"],["、"],["アマレク"],["の"],["記憶","きおく"],["を"],["天","てん"],["の"],["下","した"],["から"],["完全","かんぜん"],["に"],["ぬぐい去る","ぬぐいさる"],["』"],["と"],["。"],["」"]]},{"verse":15,"text":"モーセは祭壇を築いて、それを「主はわが旗」と名付けて、","tok":[["モーセ"],["は"],["祭壇","さいだん"],["を"],["築いて","きずいて"],["、"],["それ"],["を"],["「"],["主","ぬし"],["は"],["わが"],["旗","はた"],["」"],["と"],["名付けて","なづけて"],["、"]]},{"verse":16,"text":"言った。「彼らは主の御座に背いて手を上げた。主は代々アマレクと戦われる。」","tok":[["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["の"],["御座","ぎょざ"],["に"],["背いて","そむいて"],["手","て"],["を"],["上げた","あげた"],["。"],["主","ぬし"],["は"],["代々","だいだい"],["アマレク"],["と"],["戦われる","たたかわれる"],["。"],["」"]]}]
[{"verse":1,"text":"神はこれらすべての言葉を告げられた。","tok":[["神","かみ"],["は"],["これ"],["ら"],["すべて"],["の"],["言葉","ことば"],["を"],["告げられた","つげられた"],["。"]]},{"verse":2,"text":"「わたしは主、あなたの神、あなたをエジプトの国、奴隷の家から導き出した神である。","tok":[["「"],["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["の"],["神","かみ"],["、"],["あなた"],["を"],["エジプト"],["の"],["国","くに"],["、"],["奴隷","どれい"],["の"],["家","いえ"],["から"],["導き出した","みちびきだした"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":3,"text":"あなたには、わたしをおいてほかに神があってはならない。","tok":[["あなた"],["に"],["は"],["、"],["わたし"],["を"],["おいて"],["ほか"],["に"],["神","かみ"],["が"],["あって"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたはいかなる像も造ってはならない。上は天にあり、下は地にあり、また地の下の水の中にある、いかなるものの形も造ってはならない。","tok":[["あなた"],["は"],["いかなる"],["像","ぞう"],["も"],["造って","つくって"],["は"],["ならない"],["。"],["上","うえ"],["は"],["天","てん"],["に"],["あり"],["、"],["下","した"],["は"],["地","ち"],["に"],["あり"],["、"],["また"],["地","ち"],["の"],["下","した"],["の"],["水","みず"],["の"],["中","なか"],["に"],["ある"],["、"],["いかなる"],["もの"],["の"],["形","かたち"],["も"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":5,"text":"あなたはそれらに向かってひれ伏したり、それらに仕えたりしてはならない。わたしは主、あなたの神。わたしは熱情の神である。わたしを否む者には、父祖の罪を子孫に三代、四代までも問うが、","tok":[["あなた"],["は"],["それ"],["ら"],["に"],["向かって","むかって"],["ひれ伏し","ひれふし"],["たり"],["、"],["それ"],["ら"],["に"],["仕え","つかえ"],["たり"],["して"],["は"],["ならない"],["。"],["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["の"],["神","かみ"],["。"],["わたし"],["は"],["熱情","ねつじょう"],["の"],["神","かみ"],["で"],["ある"],["。"],["わたし"],["を"],["否む","いなむ"],["者","もの"],["に"],["は"],["、"],["父祖","ふそ"],["の"],["罪","つみ"],["を"],["子孫","しそん"],["に"],["三代","みよ"],["、"],["四","よん"],["代","だい"],["まで"],["も"],["問う","とう"],["が"],["、"]]},{"verse":6,"text":"わたしを愛し、わたしの戒めを守る者には、幾千代にも及ぶ慈しみを与える。","tok":[["わたし"],["を"],["愛し","あいし"],["、"],["わたし"],["の"],["戒め","いましめ"],["を"],["守る","まもる"],["者","もの"],["に"],["は"],["、"],["幾","いく"],["千代","ちよ"],["に"],["も"],["及ぶ","およぶ"],["慈しみ","いつくしみ"],["を"],["与える","あたえる"],["。"]]},{"verse":7,"text":"あなたの神、主の名をみだりに唱えてはならない。みだりにその名を唱える者を主は罰せずにはおかれない。","tok":[["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["名","な"],["を"],["みだり"],["に"],["唱えて","となえて"],["は"],["ならない"],["。"],["みだり"],["に"],["その"],["名","な"],["を"],["唱える","となえる"],["者","もの"],["を"],["主","ぬし"],["は"],["罰せず","ばっせず"],["に"],["は"],["おかれない"],["。"]]},{"verse":8,"text":"安息日を心に留め、これを聖別せよ。","tok":[["安息日","あんそくび"],["を"],["心","こころ"],["に"],["留め","とめ"],["、"],["これ"],["を"],["聖別","せいべつ"],["せよ"],["。"]]},{"verse":9,"text":"六日の間働いて、何であれあなたの仕事をし、","tok":[["六日","むいか"],["の"],["間","あいだ"],["働いて","はたらいて"],["、"],["何","なん"],["で"],["あれ"],["あなた"],["の"],["仕事","しごと"],["を"],["し"],["、"]]},{"verse":10,"text":"七日目は、あなたの神、主の安息日であるから、いかなる仕事もしてはならない。あなたも、息子も、娘も、男女の奴隷も、家畜も、あなたの町の門の中に寄留する人々も同様である。","tok":[["七日目","ななかめ"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["安息日","あんそくび"],["で"],["ある"],["から"],["、"],["いかなる"],["仕事","しごと"],["も"],["して"],["は"],["ならない"],["。"],["あなた"],["も"],["、"],["息子","むすこ"],["も"],["、"],["娘","むすめ"],["も"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["も"],["、"],["家畜","かちく"],["も"],["、"],["あなた"],["の"],["町","まち"],["の"],["門","もん"],["の"],["中","なか"],["に"],["寄留","きりゅう"],["する"],["人々","ひとびと"],["も"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":11,"text":"六日の間に主は天と地と海とそこにあるすべてのものを造り、七日目に休まれたから、主は安息日を祝福して聖別されたのである。","tok":[["六日","むいか"],["の"],["間","あいだ"],["に"],["主","ぬし"],["は"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["と"],["そこ"],["に"],["ある"],["すべて"],["の"],["もの"],["を"],["造り","つくり"],["、"],["七日目","ななかめ"],["に"],["休まれた","やすまれた"],["から"],["、"],["主","ぬし"],["は"],["安息日","あんそくび"],["を"],["祝福","しゅくふく"],["して"],["聖別","せいべつ"],["された"],["ので"],["ある"],["。"]]},{"verse":12,"text":"あなたの父母を敬え。そうすればあなたは、あなたの神、主が与えられる土地に長く生きることができる。","tok":[["あなた"],["の"],["父母","ふぼ"],["を"],["敬え","うやまえ"],["。"],["そう"],["すれば"],["あなた"],["は"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられる","あたえられる"],["土地","とち"],["に"],["長く","ながく"],["生きる","いきる"],["こと"],["が"],["できる"],["。"]]},{"verse":13,"text":"殺してはならない。","tok":[["殺して","ころして"],["は"],["ならない"],["。"]]},{"verse":14,"text":"姦淫してはならない。","tok":[["姦淫","かんいん"],["して"],["は"],["ならない"],["。"]]},{"verse":15,"text":"盗んではならない。","tok":[["盗んで","ぬすんで"],["は"],["ならない"],["。"]]},{"verse":16,"text":"隣人に関して偽証してはならない。","tok":[["隣人","りんじん"],["に関して","にかんして"],["偽証","ぎしょう"],["して"],["は"],["ならない"],["。"]]},{"verse":17,"text":"隣人の家を欲してはならない。隣人の妻、男女の奴隷、牛、ろばなど隣人のものを一切欲してはならない。」","tok":[["隣人","りんじん"],["の"],["家","いえ"],["を"],["欲して","ほっして"],["は"],["ならない"],["。"],["隣人","りんじん"],["の"],["妻","つま"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["、"],["牛","うし"],["、"],["ろば"],["など"],["隣人","りんじん"],["の"],["もの"],["を"],["一切","いっさい"],["欲して","ほっして"],["は"],["ならない"],["。"],["」"]]},{"verse":18,"text":"民全員は、雷鳴がとどろき、稲妻が光り、角笛の音が鳴り響いて、山が煙に包まれる有様を見た。民は見て恐れ、遠く離れて立ち、","tok":[["民","みん"],["全員","ぜんいん"],["は"],["、"],["雷鳴","らいめい"],["が"],["とどろき"],["、"],["稲妻","いなずま"],["が"],["光り","ひかり"],["、"],["角笛","つのぶえ"],["の"],["音","おと"],["が"],["鳴り響いて","なりひびいて"],["、"],["山","やま"],["が"],["煙","けむり"],["に"],["包まれる","つつまれる"],["有様","ありさま"],["を"],["見た","みた"],["。"],["民","たみ"],["は"],["見て","みて"],["恐れ","おそれ"],["、"],["遠く","とおく"],["離れて","はなれて"],["立ち","たち"],["、"]]},{"verse":19,"text":"モーセに言った。「あなたがわたしたちに語ってください。わたしたちは聞きます。神がわたしたちにお語りにならないようにしてください。そうでないと、わたしたちは死んでしまいます。」","tok":[["モーセ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["わたしたち"],["に"],["語って","かたって"],["ください"],["。"],["わたしたち"],["は"],["聞きます","ききます"],["。"],["神","かみ"],["が"],["わたしたち"],["に"],["お語り","おかたり"],["に"],["ならない"],["よう"],["に"],["して"],["ください"],["。"],["そう"],["で"],["ない"],["と"],["、"],["わたしたち"],["は"],["死んで","しんで"],["しまいます"],["。"],["」"]]},{"verse":20,"text":"モーセは民に答えた。「恐れることはない。神が来られたのは、あなたたちを試すためであり、また、あなたたちの前に神を畏れる畏れをおいて、罪を犯させないようにするためである。」","tok":[["モーセ"],["は"],["民","みん"],["に"],["答えた","こたえた"],["。"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["神","かみ"],["が"],["来られた","こられた"],["の"],["は"],["、"],["あなた"],["たち"],["を"],["試す","ためす"],["ため"],["で"],["あり"],["、"],["また"],["、"],["あなた"],["たち"],["の"],["前","まえ"],["に"],["神","かみ"],["を"],["畏れる","おそれる"],["畏れ","おそれ"],["を"],["おいて"],["、"],["罪","つみ"],["を"],["犯させない","おかさせない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":21,"text":"民は遠く離れて立ち、モーセだけが神のおられる密雲に近づいて行った。","tok":[["民","みん"],["は"],["遠く","とおく"],["離れて","はなれて"],["立ち","たち"],["、"],["モーセ"],["だけ"],["が"],["神","かみ"],["の"],["おられる"],["密雲","みつうん"],["に"],["近づいて","ちかづいて"],["行った","いった"],["。"]]},{"verse":22,"text":"主はモーセに言われた。イスラエルの人々にこう言いなさい。あなたたちは、わたしが天からあなたたちと語るのを見た。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["あなた"],["たち"],["は"],["、"],["わたし"],["が"],["天","てん"],["から"],["あなた"],["たち"],["と"],["語る","かたる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":23,"text":"あなたたちはわたしについて、何も造ってはならない。銀の神々も金の神々も造ってはならない。","tok":[["あなた"],["たち"],["は"],["わたし"],["について"],["、"],["何","なん"],["も"],["造って","つくって"],["は"],["ならない"],["。"],["銀","ぎん"],["の"],["神々","かみがみ"],["も"],["金","きん"],["の"],["神々","かみがみ"],["も"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":24,"text":"あなたは、わたしのために土の祭壇を造り、焼き尽くす献げ物、和解の献げ物、羊、牛をその上にささげなさい。わたしの名の唱えられるすべての場所において、わたしはあなたに臨み、あなたを祝福する。","tok":[["あなた"],["は"],["、"],["わたし"],["の"],["ため"],["に"],["土","つち"],["の"],["祭壇","さいだん"],["を"],["造り","つくり"],["、"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["、"],["和解","わかい"],["の"],["献げ物","ささげもの"],["、"],["羊","ひつじ"],["、"],["牛","うし"],["を"],["その"],["上","うえ"],["に"],["ささげ"],["なさい"],["。"],["わたし"],["の"],["名","な"],["の"],["唱えられる","となえられる"],["すべて"],["の"],["場所","ばしょ"],["に"],["おいて"],["、"],["わたし"],["は"],["あなた"],["に"],["臨み","のぞみ"],["、"],["あなた"],["を"],["祝福","しゅくふく"],["する"],["。"]]},{"verse":25,"text":"しかし、もしわたしのために石の祭壇を造るなら、切り石で築いてはならない。のみを当てると、石が汚されるからである。","tok":[["しかし"],["、"],["もし"],["わたし"],["の"],["ため"],["に"],["石","いし"],["の"],["祭壇","さいだん"],["を"],["造るなら","つくるなら"],["、"],["切り石","きりいし"],["で"],["築いて","きずいて"],["は"],["ならない"],["。"],["のみ"],["を"],["当てる","あてる"],["と"],["、"],["石","いし"],["が"],["汚される","よごされる"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"あなたは、階段を用いて祭壇に登ってはならない。あなたの隠し所があらわにならないためである。","tok":[["あなた"],["は"],["、"],["階段","かいだん"],["を"],["用いて","もちいて"],["祭壇","さいだん"],["に"],["登って","のぼって"],["は"],["ならない"],["。"],["あなた"],["の"],["隠し所","かくしどころ"],["が"],["あらわ"],["に"],["ならない"],["ため"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"主はモーセに言われた。「今や、あなたは、わたしがファラオにすることを見るであろう。わたしの強い手によって、ファラオはついに彼らを去らせる。わたしの強い手によって、ついに彼らを国から追い出すようになる。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["今","いま"],["や"],["、"],["あなた"],["は"],["、"],["わたし"],["が"],["ファラオ"],["に"],["する"],["こと"],["を"],["見るで","みるで"],["あろう"],["。"],["わたし"],["の"],["強い","つよい"],["手","て"],["によって"],["、"],["ファラオ"],["は"],["ついに"],["彼","かれ"],["ら"],["を"],["去らせる","さらせる"],["。"],["わたし"],["の"],["強い","つよい"],["手","て"],["によって"],["、"],["ついに"],["彼","かれ"],["ら"],["を"],["国","くに"],["から"],["追い出す","おいだす"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":2,"text":"神はモーセに仰せになった。「わたしは主である。","tok":[["神","かみ"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"]]},{"verse":3,"text":"わたしは、アブラハム、イサク、ヤコブに全能の神として現れたが、主というわたしの名を知らせなかった。","tok":[["わたし"],["は"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["全能","ぜんのう"],["の"],["神","かみ"],["として"],["現れた","あらわれた"],["が"],["、"],["主","ぬし"],["と"],["いう"],["わたし"],["の"],["名","な"],["を"],["知らせなかった","しらせなかった"],["。"]]},{"verse":4,"text":"わたしはまた、彼らと契約を立て、彼らが寄留していた寄留地であるカナンの土地を与えると約束した。","tok":[["わたし"],["は"],["また"],["、"],["彼","かれ"],["ら"],["と"],["契約","けいやく"],["を"],["立て","たて"],["、"],["彼","かれ"],["ら"],["が"],["寄留","きりゅう"],["して"],["いた"],["寄留","きりゅう"],["地","ち"],["で"],["ある"],["カナン"],["の"],["土地","とち"],["を"],["与える","あたえる"],["と"],["約束","やくそく"],["した"],["。"]]},{"verse":5,"text":"わたしはまた、エジプト人の奴隷となっているイスラエルの人々のうめき声を聞き、わたしの契約を思い起こした。","tok":[["わたし"],["は"],["また"],["、"],["エジプト"],["人","にん"],["の"],["奴隷","どれい"],["と"],["なって"],["いる"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うめき声","うめきごえ"],["を"],["聞き","きき"],["、"],["わたし"],["の"],["契約","けいやく"],["を"],["思い起こした","おもいおこした"],["。"]]},{"verse":6,"text":"それゆえ、イスラエルの人々に言いなさい。わたしは主である。わたしはエジプトの重労働の下からあなたたちを導き出し、奴隷の身分から救い出す。腕を伸ばし、大いなる審判によってあなたたちを贖う。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["は"],["エジプト"],["の"],["重労働","じゅうろうどう"],["の"],["下","した"],["から"],["あなた"],["たち"],["を"],["導き出し","みちびきだし"],["、"],["奴隷","どれい"],["の"],["身分","みぶん"],["から"],["救い出す","すくいだす"],["。"],["腕","うで"],["を"],["伸ばし","のばし"],["、"],["大いなる","おおいなる"],["審判","しんぱん"],["によって"],["あなた"],["たち"],["を"],["贖う","あがなう"],["。"]]},{"verse":7,"text":"そして、わたしはあなたたちをわたしの民とし、わたしはあなたたちの神となる。あなたたちはこうして、わたしがあなたたちの神、主であり、あなたたちをエジプトの重労働の下から導き出すことを知る。","tok":[["そして"],["、"],["わたし"],["は"],["あなた"],["たち"],["を"],["わたし"],["の"],["民","たみ"],["と"],["し"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["神","かみ"],["と"],["なる"],["。"],["あなた"],["たち"],["は"],["こう"],["して"],["、"],["わたし"],["が"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["あり"],["、"],["あなた"],["たち"],["を"],["エジプト"],["の"],["重労働","じゅうろうどう"],["の"],["下","した"],["から"],["導き出す","みちびきだす"],["こと"],["を"],["知る","しる"],["。"]]},{"verse":8,"text":"わたしは、アブラハム、イサク、ヤコブに与えると手を上げて誓った土地にあなたたちを導き入れ、その地をあなたたちの所有として与える。わたしは主である。」","tok":[["わたし"],["は"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["与える","あたえる"],["と"],["手","て"],["を"],["上げて","あげて"],["誓った","ちかった"],["土地","とち"],["に"],["あなた"],["たち"],["を"],["導き入れ","みちびきいれ"],["、"],["その"],["地","ち"],["を"],["あなた"],["たち"],["の"],["所有","しょゆう"],["として"],["与える","あたえる"],["。"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"モーセは、そのとおりイスラエルの人々に語ったが、彼らは厳しい重労働のため意欲を失って、モーセの言うことを聞こうとはしなかった。","tok":[["モーセ"],["は"],["、"],["その"],["とおり"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["語った","かたった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["厳しい","きびしい"],["重労働","じゅうろうどう"],["の"],["ため"],["意欲","いよく"],["を"],["失って","うしなって"],["、"],["モーセ"],["の"],["言う","いう"],["こと"],["を"],["聞こう","きこう"],["と"],["は"],["しなかった"],["。"]]},{"verse":10,"text":"主はモーセに仰せになった。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"]]},{"verse":11,"text":"「エジプトの王ファラオのもとに行って、イスラエルの人々を国から去らせるように説得しなさい。」","tok":[["「"],["エジプト"],["の"],["王","おう"],["ファラオ"],["の"],["もと"],["に"],["行って","いって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["国","くに"],["から"],["去らせる","さらせる"],["よう"],["に"],["説得","せっとく"],["し"],["なさい"],["。"],["」"]]},{"verse":12,"text":"モーセは主に訴えた。「御覧のとおり、イスラエルの人々でさえわたしに聞こうとしないのに、どうしてファラオが唇に割礼のないわたしの言うことを聞くでしょうか。」","tok":[["モーセ"],["は"],["主に","おもに"],["訴えた","うったえた"],["。"],["「"],["御覧","ごらん"],["の"],["とおり"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["で"],["さえ"],["わたし"],["に"],["聞こう","きこう"],["と"],["しない"],["のに"],["、"],["どう"],["して"],["ファラオ"],["が"],["唇","くちびる"],["に"],["割礼","かつれい"],["の"],["ない"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞くでしょう","きくでしょう"],["か"],["。"],["」"]]},{"verse":13,"text":"主はモーセとアロンに語って、イスラエルの人々とエジプトの王ファラオにかかわる命令を与えられた。それは、イスラエルの人々をエジプトの国から導き出せというものであった。","tok":[["主","ぬし"],["は"],["モーセ"],["と"],["アロン"],["に"],["語って","かたって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["エジプト"],["の"],["王","おう"],["ファラオ"],["に"],["かかわる"],["命令","めいれい"],["を"],["与えられた","あたえられた"],["。"],["それ"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出せ","みちびきだせ"],["と"],["いう"],["もの"],["で"],["あった"],["。"]]},{"verse":14,"text":"彼らの家系の長は次のとおりである。イスラエルの長男ルベンの子らは、ハノク、パル、ヘツロン、カルミで、これらがルベンの氏族である。","tok":[["彼","かれ"],["ら"],["の"],["家系","かけい"],["の"],["長","ちょう"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["イスラエル"],["の"],["長男","ちょうなん"],["ルベン"],["の"],["子","こ"],["ら"],["は"],["、"],["ハノク"],["、"],["パル"],["、"],["ヘツロン"],["、"],["カルミ"],["で"],["、"],["これ"],["ら"],["が"],["ルベン"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":15,"text":"シメオンの子らは、エムエル、ヤミン、オハド、ヤキン、ツォハルおよびカナンの女から生まれたシャウルで、これらがシメオンの氏族である。","tok":[["シメオン"],["の"],["子","こ"],["ら"],["は"],["、"],["エムエル"],["、"],["ヤミン"],["、"],["オハド"],["、"],["ヤキン"],["、"],["ツォハル"],["および"],["カナン"],["の"],["女","おんな"],["から"],["生まれた","うまれた"],["シャウル"],["で"],["、"],["これ"],["ら"],["が"],["シメオン"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":16,"text":"レビの子らの名は家系に従うと次のとおりである。ゲルション、ケハト、メラリ。レビの生涯は百三十七年であった。","tok":[["レビ"],["の"],["子","こ"],["ら"],["の"],["名","な"],["は"],["家系","かけい"],["に"],["従う","したがう"],["と"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ゲルション"],["、"],["ケハト"],["、"],["メラリ"],["。"],["レビ"],["の"],["生涯","しょうがい"],["は"],["百三十七","ひゃくさんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":17,"text":"ゲルションの子らは、氏族に従うと、リブニとシムイである。","tok":[["ゲルション"],["の"],["子","こ"],["ら"],["は"],["、"],["氏族","しぞく"],["に"],["従う","したがう"],["と"],["、"],["リブニ"],["と"],["シムイ"],["で"],["ある"],["。"]]},{"verse":18,"text":"ケハトの子らは、アムラム、イツハル、ヘブロン、ウジエルである。ケハトの生涯は百三十三年であった。","tok":[["ケハト"],["の"],["子","こ"],["ら"],["は"],["、"],["アムラム"],["、"],["イツハル"],["、"],["ヘブロン"],["、"],["ウジエル"],["で"],["ある"],["。"],["ケハト"],["の"],["生涯","しょうがい"],["は"],["百三十三","ひゃくさんじゅうさん"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":19,"text":"メラリの子らは、マフリとムシで、これらが家系に従ったレビの氏族である。","tok":[["メラリ"],["の"],["子","こ"],["ら"],["は"],["、"],["マフリ"],["と"],["ムシ"],["で"],["、"],["これ"],["ら"],["が"],["家系","かけい"],["に"],["従った","したがった"],["レビ"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":20,"text":"アムラムは叔母ヨケベドを妻に迎えた。彼女の産んだ子がアロンとモーセである。アムラムの生涯は百三十七年であった。","tok":[["アムラム"],["は"],["叔母","おば"],["ヨケベド"],["を"],["妻","つま"],["に"],["迎えた","むかえた"],["。"],["彼女","かのじょ"],["の"],["産んだ","うんだ"],["子","こ"],["が"],["アロン"],["と"],["モーセ"],["で"],["ある"],["。"],["アムラム"],["の"],["生涯","しょうがい"],["は"],["百三十七","ひゃくさんじゅうなな"],["年","ねん"],["で"],["あった"],["。"]]},{"verse":21,"text":"イツハルの子らは、コラ、ネフェグ、ジクリである。","tok":[["イツハル"],["の"],["子","こ"],["ら"],["は"],["、"],["コラ"],["、"],["ネフェグ"],["、"],["ジクリ"],["で"],["ある"],["。"]]},{"verse":22,"text":"ウジエルの子らは、ミシャエル、エルツァファン、シトリである。","tok":[["ウジエル"],["の"],["子","こ"],["ら"],["は"],["、"],["ミシャエル"],["、"],["エルツァファン"],["、"],["シトリ"],["で"],["ある"],["。"]]},{"verse":23,"text":"アロンは、アミナダブの娘でナフションの姉妹であるエリシェバを妻に迎えた。彼女の産んだ子がナダブ、アビフ、エルアザル、イタマルである。","tok":[["アロン"],["は"],["、"],["アミナダブ"],["の"],["娘","むすめ"],["で"],["ナフション"],["の"],["姉妹","しまい"],["で"],["ある"],["エリシェバ"],["を"],["妻","つま"],["に"],["迎えた","むかえた"],["。"],["彼女","かのじょ"],["の"],["産んだ","うんだ"],["子","こ"],["が"],["ナダブ"],["、"],["アビフ"],["、"],["エルアザル"],["、"],["イタマル"],["で"],["ある"],["。"]]},{"verse":24,"text":"コラの子らは、アシル、エルカナ、アビアサフで、これらがコラ人の氏族である。","tok":[["コラ"],["の"],["子","こ"],["ら"],["は"],["、"],["アシル"],["、"],["エルカナ"],["、"],["アビアサフ"],["で"],["、"],["これ"],["ら"],["が"],["コラ人","こらにん"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":25,"text":"アロンの子エルアザルは、プティエルの娘の一人を妻に迎えた。彼女の産んだ子がピネハスである。以上が氏族ごとのレビ人の家長である。","tok":[["アロン"],["の"],["子","こ"],["エルアザル"],["は"],["、"],["プティエル"],["の"],["娘","むすめ"],["の"],["一人","ひとり"],["を"],["妻","つま"],["に"],["迎えた","むかえた"],["。"],["彼女","かのじょ"],["の"],["産んだ","うんだ"],["子","こ"],["が"],["ピネハス"],["で"],["ある"],["。"],["以上","いじょう"],["が"],["氏族","しぞく"],["ごと"],["の"],["レビ人","れびにん"],["の"],["家長","かちょう"],["で"],["ある"],["。"]]},{"verse":26,"text":"主が、「イスラエルの人々を部隊ごとにエジプトの国から導き出せ」と命じられたのは、このアロンとモーセである。","tok":[["主","ぬし"],["が"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["部隊","ぶたい"],["ごと"],["に"],["エジプト"],["の"],["国","くに"],["から"],["導き出せ","みちびきだせ"],["」"],["と"],["命じられた","めいじられた"],["の"],["は"],["、"],["この"],["アロン"],["と"],["モーセ"],["で"],["ある"],["。"]]},{"verse":27,"text":"そして、イスラエルの人々をエジプトから導き出すよう、エジプトの王ファラオの説得に当たったのも、このモーセとアロンである。","tok":[["そして"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["から"],["導き出す","みちびきだす"],["よう"],["、"],["エジプト"],["の"],["王","おう"],["ファラオ"],["の"],["説得","せっとく"],["に"],["当たった","あたった"],["の"],["も"],["、"],["この"],["モーセ"],["と"],["アロン"],["で"],["ある"],["。"]]},{"verse":28,"text":"主がエジプトの国でモーセに語られたとき、","tok":[["主","ぬし"],["が"],["エジプト"],["の"],["国","くに"],["で"],["モーセ"],["に"],["語られた","かたられた"],["とき"],["、"]]},{"verse":29,"text":"主はモーセに仰せになった。「わたしは主である。わたしがあなたに語ることをすべて、エジプトの王ファラオに語りなさい。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["わたし"],["は"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["こと"],["を"],["すべて"],["、"],["エジプト"],["の"],["王","おう"],["ファラオ"],["に"],["語り","かたり"],["なさい"],["。"],["」"]]},{"verse":30,"text":"しかし、モーセは主に言った。「御覧のとおり、わたしは唇に割礼のない者です。どうしてファラオがわたしの言うことを聞き入れましょうか。」","tok":[["しかし"],["、"],["モーセ"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["御覧","ごらん"],["の"],["とおり"],["、"],["わたし"],["は"],["唇","くちびる"],["に"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["です"],["。"],["どう"],["して"],["ファラオ"],["が"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞き入れましょう","ききいれましょう"],["か"],["。"],["」"]]}]
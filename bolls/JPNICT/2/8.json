[{"verse":1,"text":"主は更にモーセに言われた。「アロンにこう言いなさい。杖を取って、河川、水路、池の上に手を伸ばし、蛙をエジプトの国に這い上がらせよ。」","tok":[["主","ぬし"],["は"],["更に","さらに"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["アロン"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["杖","つえ"],["を"],["取って","とって"],["、"],["河川","かせん"],["、"],["水路","すいろ"],["、"],["池の上","いけのうえ"],["に"],["手","て"],["を"],["伸ばし","のばし"],["、"],["蛙","かわず"],["を"],["エジプト"],["の"],["国","くに"],["に"],["這い上がらせ","はいあがらせ"],["よ"],["。"],["」"]]},{"verse":2,"text":"アロンがエジプトの水の上に手を差し伸べると、蛙が這い上がってきてエジプトの国を覆った。","tok":[["アロン"],["が"],["エジプト"],["の"],["水","みず"],["の"],["上","うえ"],["に"],["手","て"],["を"],["差し伸べる","さしのべる"],["と"],["、"],["蛙","かわず"],["が"],["這い上がって","はいあがって"],["きて"],["エジプト"],["の"],["国","くに"],["を"],["覆った","おおった"],["。"]]},{"verse":3,"text":"ところが、魔術師も秘術を用いて同じことをし、蛙をエジプトの国に這い上がらせた。","tok":[["ところ"],["が"],["、"],["魔術師","まじゅつし"],["も"],["秘術","ひじゅつ"],["を"],["用いて","もちいて"],["同じ","おなじ"],["こと"],["を"],["し"],["、"],["蛙","かわず"],["を"],["エジプト"],["の"],["国","くに"],["に"],["這い上がらせた","はいあがらせた"],["。"]]},{"verse":4,"text":"ファラオはモーセとアロンを呼んで、「主に祈願して、蛙がわたしとわたしの民のもとから退くようにしてもらいたい。そうすれば、民を去らせ、主に犠牲をささげさせよう」と言うと、","tok":[["ファラオ"],["は"],["モーセ"],["と"],["アロン"],["を"],["呼んで","よんで"],["、"],["「"],["主に","おもに"],["祈願","きがん"],["して"],["、"],["蛙","かわず"],["が"],["わたし"],["と"],["わたし"],["の"],["民","たみ"],["の"],["もと"],["から"],["退く","しりぞく"],["よう"],["に"],["して"],["もらいたい"],["。"],["そう"],["すれば"],["、"],["民","みん"],["を"],["去らせ","さらせ"],["、"],["主に","おもに"],["犠牲","ぎせい"],["を"],["ささげさせよう"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":5,"text":"モーセはファラオに答えた。「あなたのお望みの時を言ってください。いつでもあなたとあなたの家臣と民のために祈願して、蛙をあなたとあなたの家から断ち、ナイル川以外には残らぬようにしましょう。」","tok":[["モーセ"],["は"],["ファラオ"],["に"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["お望み","おのぞみ"],["の"],["時","とき"],["を"],["言って","いって"],["ください"],["。"],["いつ"],["で"],["も"],["あなた"],["と"],["あなた"],["の"],["家臣","かしん"],["と"],["民","たみ"],["の"],["ため"],["に"],["祈願","きがん"],["して"],["、"],["蛙","かわず"],["を"],["あなた"],["と"],["あなた"],["の"],["家","いえ"],["から"],["断ち","たち"],["、"],["ナイル"],["川","かわ"],["以外","いがい"],["に"],["は"],["残らぬ","のこらぬ"],["よう"],["に"],["しましょう"],["。"],["」"]]},{"verse":6,"text":"ファラオが、「明日」と言うと、モーセは答えた。「あなたの言われるとおりにしましょう。あなたは、我々の神、主のような神がほかにいないことを知るようになります。","tok":[["ファラオ"],["が"],["、"],["「"],["明日","あす"],["」"],["と"],["言う","ゆう"],["と"],["、"],["モーセ"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["言われる","いわれる"],["とおり"],["に"],["しましょう"],["。"],["あなた"],["は"],["、"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["よう"],["な"],["神","かみ"],["が"],["ほか"],["に"],["いない"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なります"],["。"]]},{"verse":7,"text":"蛙はあなたとあなたの王宮、家臣や民の間から退いて、ナイル川以外には残らなくなるでしょう。」","tok":[["蛙","かわず"],["は"],["あなた"],["と"],["あなた"],["の"],["王宮","おうきゅう"],["、"],["家臣","かしん"],["や"],["民","たみ"],["の"],["間","あいだ"],["から"],["退いて","しりぞいて"],["、"],["ナイル"],["川","かわ"],["以外","いがい"],["に"],["は"],["残らなく","のこらなく"],["なるでしょう"],["。"],["」"]]},{"verse":8,"text":"モーセとアロンがファラオのもとから出て来ると、モーセはファラオを悩ました蛙のことで主に訴えた。","tok":[["モーセ"],["と"],["アロン"],["が"],["ファラオ"],["の"],["もと"],["から"],["出て","でて"],["来る","くる"],["と"],["、"],["モーセ"],["は"],["ファラオ"],["を"],["悩ました","なやました"],["蛙","かわず"],["の"],["こと"],["で"],["主に","おもに"],["訴えた","うったえた"],["。"]]},{"verse":9,"text":"主はモーセの願いどおりにされ、蛙は家からも庭からも畑からも死に絶えた。","tok":[["主","ぬし"],["は"],["モーセ"],["の"],["願い","ねがい"],["どおり"],["に"],["され"],["、"],["蛙","かわず"],["は"],["家","いえ"],["から"],["も"],["庭","にわ"],["から"],["も"],["畑","はたけ"],["から"],["も"],["死に絶えた","しにたえた"],["。"]]},{"verse":10,"text":"人々はその死骸を幾山にも積み上げたので、国中に悪臭が満ちた。","tok":[["人々","ひとびと"],["は"],["その"],["死骸","しがい"],["を"],["幾山","いくやま"],["に"],["も"],["積み上げた","つみあげた"],["ので"],["、"],["国中","くにちゅう"],["に"],["悪臭","あくしゅう"],["が"],["満ちた","みちた"],["。"]]},{"verse":11,"text":"ファラオは一息つく暇ができたのを見ると、心を頑迷にして、また二人の言うことを聞き入れなくなった。主が仰せになったとおりである。","tok":[["ファラオ"],["は"],["一息","ひといき"],["つく"],["暇","ひま"],["が"],["できた"],["の"],["を"],["見る","みる"],["と"],["、"],["心","こころ"],["を"],["頑迷","がんめい"],["に"],["して"],["、"],["また"],["二人","ふたり"],["の"],["言う","いう"],["こと"],["を"],["聞き入れなく","ききいれなく"],["なった"],["。"],["主","ぬし"],["が"],["仰せ","おおせ"],["に"],["なった"],["とおり"],["で"],["ある"],["。"]]},{"verse":12,"text":"主はモーセに言われた。「アロンに言いなさい。『杖を差し伸べて土の塵を打ち、ぶよにさせてエジプト全土に及ぼせ』と。」","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["アロン"],["に"],["言い","いい"],["なさい"],["。"],["『"],["杖","つえ"],["を"],["差し伸べて","さしのべて"],["土","つち"],["の"],["塵","ごみ"],["を"],["打ち","うち"],["、"],["ぶよ"],["に"],["させて"],["エジプト"],["全土","ぜんど"],["に"],["及ぼせ","およぼせ"],["』"],["と"],["。"],["」"]]},{"verse":13,"text":"彼らは言われたとおりにし、アロンが杖を持った手を差し伸べ土の塵を打つと、土の塵はすべてぶよとなり、エジプト全土に広がって人と家畜を襲った。","tok":[["彼","かれ"],["ら"],["は"],["言われた","いわれた"],["とおり"],["に"],["し"],["、"],["アロン"],["が"],["杖","つえ"],["を"],["持った","もった"],["手","て"],["を"],["差し伸べ","さしのべ"],["土","つち"],["の"],["塵","ごみ"],["を"],["打つ","うつ"],["と"],["、"],["土","つち"],["の"],["塵","ごみ"],["は"],["すべて"],["ぶよ"],["と"],["なり"],["、"],["エジプト"],["全土","ぜんど"],["に"],["広がって","ひろがって"],["人","ひと"],["と"],["家畜","かちく"],["を"],["襲った","おそった"],["。"]]},{"verse":14,"text":"魔術師も秘術を用いて同じようにぶよを出そうとしたが、できなかった。ぶよが人と家畜を襲ったので、","tok":[["魔術師","まじゅつし"],["も"],["秘術","ひじゅつ"],["を"],["用いて","もちいて"],["同じ","おなじ"],["よう"],["に"],["ぶよ"],["を"],["出そう","だそう"],["と"],["した"],["が"],["、"],["できなかった"],["。"],["ぶよ"],["が"],["人","ひと"],["と"],["家畜","かちく"],["を"],["襲った","おそった"],["ので"],["、"]]},{"verse":15,"text":"魔術師はファラオに、「これは神の指の働きでございます」と言ったが、ファラオの心はかたくなになり、彼らの言うことを聞かなかった。主が仰せになったとおりである。","tok":[["魔術師","まじゅつし"],["は"],["ファラオ"],["に"],["、"],["「"],["これ"],["は"],["神","かみ"],["の"],["指","ゆび"],["の"],["働き","はたらき"],["で"],["ございます"],["」"],["と"],["言った","いった"],["が"],["、"],["ファラオ"],["の"],["心","こころ"],["は"],["かたくな"],["に"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞かなかった","きかなかった"],["。"],["主","ぬし"],["が"],["仰せ","おおせ"],["に"],["なった"],["とおり"],["で"],["ある"],["。"]]},{"verse":16,"text":"主はモーセに言われた。「明朝早く起きて、水辺に下りて来るファラオを出迎えて、彼に言いなさい。主はこう言われた。『わたしの民を去らせ、わたしに仕えさせよ。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["明朝","みょうちょう"],["早く","はやく"],["起きて","おきて"],["、"],["水辺","みずべ"],["に"],["下りて","おりて"],["来る","くる"],["ファラオ"],["を"],["出迎えて","でむかえて"],["、"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["。"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"],["『"],["わたし"],["の"],["民","たみ"],["を"],["去らせ","さらせ"],["、"],["わたし"],["に"],["仕えさせ","つかえさせ"],["よ"],["。"]]},{"verse":17,"text":"もしあなたがわたしの民を去らせないならば、見よ、わたしはあなたとあなたの家臣とあなたの民とあなたの家にあぶを送る。エジプトの人家にも人が働いている畑地にもあぶが満ちるであろう。","tok":[["もし"],["あなた"],["が"],["わたし"],["の"],["民","たみ"],["を"],["去らせないならば","さらせないならば"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["と"],["あなた"],["の"],["家臣","かしん"],["と"],["あなた"],["の"],["民","たみ"],["と"],["あなた"],["の"],["家","いえ"],["に"],["あぶ"],["を"],["送る","おくる"],["。"],["エジプト"],["の"],["人家","じんか"],["に"],["も"],["人","ひと"],["が"],["働いて","はたらいて"],["いる"],["畑地","はたち"],["に"],["も"],["あぶ"],["が"],["満ちるで","みちるで"],["あろう"],["。"]]},{"verse":18,"text":"しかし、その日、わたしはわたしの民の住むゴシェン地方を区別し、そこにあぶを入り込ませない。あなたはこうして、主なるわたしがこの地のただ中にいることを知るようになる。","tok":[["しかし"],["、"],["その"],["日","ひ"],["、"],["わたし"],["は"],["わたし"],["の"],["民","たみ"],["の"],["住む","すむ"],["ゴシェン"],["地方","ちほう"],["を"],["区別","くべつ"],["し"],["、"],["そこ"],["に"],["あぶ"],["を"],["入り込ませない","はいりこませない"],["。"],["あなた"],["は"],["こう"],["して"],["、"],["主","おも"],["なる"],["わたし"],["が"],["この"],["地","ち"],["の"],["ただ中","ただなか"],["に"],["いる"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":19,"text":"わたしは、わたしの民をあなたの民から区別して贖う。明日、このしるしが起こる』と。」","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["民","たみ"],["を"],["あなた"],["の"],["民","たみ"],["から"],["区別","くべつ"],["して"],["贖う","あがなう"],["。"],["明日","あす"],["、"],["この"],["しるし"],["が"],["起こる","おこる"],["』"],["と"],["。"],["」"]]},{"verse":20,"text":"主がそのとおり行われたので、あぶの大群がファラオの王宮や家臣の家に入り、エジプトの全土に及んだ。国はあぶのゆえに荒れ果てた。","tok":[["主","ぬし"],["が"],["その"],["とおり"],["行われた","おこなわれた"],["ので"],["、"],["あぶ"],["の"],["大群","たいぐん"],["が"],["ファラオ"],["の"],["王宮","おうきゅう"],["や"],["家臣","かしん"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],["エジプト"],["の"],["全土","ぜんど"],["に"],["及んだ","およんだ"],["。"],["国","くに"],["は"],["あぶ"],["の"],["ゆえ"],["に"],["荒れ果てた","あれはてた"],["。"]]},{"verse":21,"text":"ファラオがモーセとアロンを呼び寄せて、「行って、あなたたちの神にこの国の中で犠牲をささげるがよい」と言うと、","tok":[["ファラオ"],["が"],["モーセ"],["と"],["アロン"],["を"],["呼び寄せて","よびよせて"],["、"],["「"],["行って","いって"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["に"],["この"],["国","くに"],["の"],["中","なか"],["で"],["犠牲","ぎせい"],["を"],["ささげる"],["が"],["よい"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":22,"text":"モーセは答えた。「そうすることはできません。我々の神、主にささげる犠牲は、エジプト人のいとうものです。もし、彼らの前でエジプト人のいとうものをささげれば、我々を石で打ち殺すのではありませんか。","tok":[["モーセ"],["は"],["答えた","こたえた"],["。"],["「"],["そう"],["する"],["こと"],["は"],["できません"],["。"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["ささげる"],["犠牲","ぎせい"],["は"],["、"],["エジプト"],["人","にん"],["の"],["いとう"],["もの"],["です"],["。"],["もし"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["エジプト"],["人","にん"],["の"],["いとう"],["もの"],["を"],["ささげれば"],["、"],["我々","われわれ"],["を"],["石","いし"],["で"],["打ち殺す","うちころす"],["ので"],["は"],["ありません"],["か"],["。"]]},{"verse":23,"text":"我々の神、主に犠牲をささげるには、神が命じられたように、三日の道のりを荒れ野に入らねばなりません。」","tok":[["我々","われわれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["犠牲","ぎせい"],["を"],["ささげる"],["に"],["は"],["、"],["神","かみ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["、"],["三日","みっか"],["の"],["道のり","みちのり"],["を"],["荒れ野","あれの"],["に"],["入らねば","はいらねば"],["なりません"],["。"],["」"]]},{"verse":24,"text":"ファラオが、「よし、わたしはあなたたちを去らせる。荒れ野であなたたちの神、主に犠牲をささげるがよい。ただし、あまり遠くへ行ってはならない。わたしのためにも祈願してくれ」と言うと、","tok":[["ファラオ"],["が"],["、"],["「"],["よし"],["、"],["わたし"],["は"],["あなた"],["たち"],["を"],["去らせる","さらせる"],["。"],["荒れ野","あれの"],["で"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["犠牲","ぎせい"],["を"],["ささげる"],["が"],["よい"],["。"],["ただし"],["、"],["あまり"],["遠く","とおく"],["へ"],["行って","いって"],["は"],["ならない"],["。"],["わたし"],["の"],["ため"],["に"],["も"],["祈願","きがん"],["して"],["くれ"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":25,"text":"モーセは答えた。「では、あなたのもとから退出しましたら、早速主に祈願しましょう。明日になれば、あぶはファラオとその家臣と民の間から飛び去るでしょう。ただ、二度と、主に犠牲をささげるために民を去らせないなどと言って、我々を欺かないでください。」","tok":[["モーセ"],["は"],["答えた","こたえた"],["。"],["「"],["で"],["は"],["、"],["あなた"],["の"],["もと"],["から"],["退出","たいしゅつ"],["しましたら"],["、"],["早速","さっそく"],["主に","おもに"],["祈願","きがん"],["しましょう"],["。"],["明日","あす"],["に"],["なれば"],["、"],["あぶ"],["は"],["ファラオ"],["と"],["その"],["家臣","かしん"],["と"],["民","たみ"],["の"],["間","あいだ"],["から"],["飛び去るでしょう","とびさるでしょう"],["。"],["ただ"],["、"],["二","に"],["度","ど"],["と"],["、"],["主に","おもに"],["犠牲","ぎせい"],["を"],["ささげる"],["ため"],["に"],["民","たみ"],["を"],["去らせない","さらせない"],["など"],["と"],["言って","いって"],["、"],["我々","われわれ"],["を"],["欺かないで","あざむかないで"],["ください"],["。"],["」"]]},{"verse":26,"text":"モーセはファラオのもとから退出すると、主に祈願した。","tok":[["モーセ"],["は"],["ファラオ"],["の"],["もと"],["から"],["退出","たいしゅつ"],["する"],["と"],["、"],["主に","おもに"],["祈願","きがん"],["した"],["。"]]},{"verse":27,"text":"主はモーセの願いどおりにされ、あぶはファラオと家臣と民の間からすべて飛び去り、一匹も残らなかった。","tok":[["主","ぬし"],["は"],["モーセ"],["の"],["願い","ねがい"],["どおり"],["に"],["され"],["、"],["あぶ"],["は"],["ファラオ"],["と"],["家臣","かしん"],["と"],["民","たみ"],["の"],["間","あいだ"],["から"],["すべて"],["飛び去り","とびさり"],["、"],["一匹","いちひき"],["も"],["残らなかった","のこらなかった"],["。"]]},{"verse":28,"text":"しかし、ファラオは今度もまた心を頑迷にして民を去らせなかった。","tok":[["しかし"],["、"],["ファラオ"],["は"],["今度","こんど"],["も"],["また"],["心","こころ"],["を"],["頑迷","がんめい"],["に"],["して"],["民","みん"],["を"],["去らせなかった","さらせなかった"],["。"]]}]
,"うし"],["が"],["隣人","りんじん"],["の"],["牛","うし"],["を"],["突いて","ついて"],["死なせた","しなせた"],["場合","ばあい"],["、"],["生きて","いきて"],["いる"],["方","かた"],["の"],["牛","うし"],["を"],["売って","うって"],["、"],["その"],["代金","だいきん"],["を"],["折半","せっぱん"],["し"],["、"],["死んだ","しんだ"],["方","ほう"],["の"],["牛","うし"],["も"],["折半","せっぱん"],["する"],["。"]]},{"verse":36,"text":"しかし、牛に以前から突く癖のあることが分かっていながら、所有者が注意を怠った場合は、必ず、その牛の代償として牛で償わねばならない。ただし、死んだ牛は彼のものとなる。","tok":[["しかし"],["、"],["牛","うし"],["に"],["以前","いぜん"],["から"],["突く","つく"],["癖","くせ"],["の"],["ある"],["こと"],["が"],["分かって","わかって"],["い"],["ながら"],["、"],["所有者","しょゆうしゃ"],["が"],["注意","ちゅうい"],["を"],["怠った","おこたった"],["場合","ばあい"],["は"],["、"],["必ず","かならず"],["、"],["その"],["牛","うし"],["の"],["代償","だいしょう"],["として"],["牛","うし"],["で"],["償わねば","つぐなわねば"],["ならない"],["。"],["ただし"],["、"],["死んだ","しんだ"],["牛","うし"],["は"],["彼","かれ"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":37,"text":"人が牛あるいは羊を盗んで、これを屠るか、売るかしたならば、牛一頭の代償として牛五頭、羊一匹の代償として羊四匹で償わねばならない。","tok":[["人","ひと"],["が"],["牛","うし"],["あるいは"],["羊","ひつじ"],["を"],["盗んで","ぬすんで"],["、"],["これ"],["を"],["屠る","ほふる"],["か"],["、"],["売る","うる"],["か"],["したならば"],["、"],["牛","うし"],["一頭","いちとう"],["の"],["代償","だいしょう"],["として"],["牛","うし"],["五頭","ごとう"],["、"],["羊","ひつじ"],["一匹","いちひき"],["の"],["代償","だいしょう"],["として"],["羊","ひつじ"],["四匹","よんひき"],["で"],["償わねば","つぐなわねば"],["ならない"],["。"]]}]
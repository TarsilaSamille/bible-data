[{"verse":1,"text":"モーセは、しゅうとでありミディアンの祭司であるエトロの羊の群れを飼っていたが、あるとき、その群れを荒れ野の奥へ追って行き、神の山ホレブに来た。","tok":[["モーセ"],["は"],["、"],["しゅうと"],["で"],["あり"],["ミディアン"],["の"],["祭司","さいし"],["で"],["ある"],["エトロ"],["の"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["飼って","かって"],["いた"],["が"],["、"],["ある"],["とき"],["、"],["その"],["群れ","むれ"],["を"],["荒れ野","あれの"],["の"],["奥","おく"],["へ"],["追って","おって"],["行き","いき"],["、"],["神","かみ"],["の"],["山","やま"],["ホレブ"],["に"],["来た","きた"],["。"]]},{"verse":2,"text":"そのとき、柴の間に燃え上がっている炎の中に主の御使いが現れた。彼が見ると、見よ、柴は火に燃えているのに、柴は燃え尽きない。","tok":[["その"],["とき"],["、"],["柴","しば"],["の"],["間","あいだ"],["に"],["燃え上がって","もえあがって"],["いる"],["炎","ほのお"],["の"],["中","なか"],["に"],["主","ぬし"],["の"],["御使い","おつかい"],["が"],["現れた","あらわれた"],["。"],["彼","かれ"],["が"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["柴","しば"],["は"],["火","ひ"],["に"],["燃えて","もえて"],["いる"],["のに"],["、"],["柴","しば"],["は"],["燃え尽きない","もえつきない"],["。"]]},{"verse":3,"text":"モーセは言った。「道をそれて、この不思議な光景を見届けよう。どうしてあの柴は燃え尽きないのだろう。」","tok":[["モーセ"],["は"],["言った","いった"],["。"],["「"],["道","みち"],["を"],["それて"],["、"],["この"],["不思議","ふしぎ"],["な"],["光景","こうけい"],["を"],["見届けよう","みとどけよう"],["。"],["どう"],["して"],["あの"],["柴","しば"],["は"],["燃え尽きない","もえつきない"],["の"],["だろう"],["。"],["」"]]},{"verse":4,"text":"主は、モーセが道をそれて見に来るのを御覧になった。神は柴の間から声をかけられ、「モーセよ、モーセよ」と言われた。彼が、「はい」と答えると、","tok":[["主","ぬし"],["は"],["、"],["モーセ"],["が"],["道","みち"],["を"],["それて"],["見","み"],["に"],["来る","くる"],["の"],["を"],["御覧","ごらん"],["に"],["なった"],["。"],["神","かみ"],["は"],["柴","しば"],["の"],["間","あいだ"],["から"],["声","こえ"],["を"],["かけられ"],["、"],["「"],["モーセ"],["よ"],["、"],["モーセ"],["よ"],["」"],["と"],["言われた","いわれた"],["。"],["彼","かれ"],["が"],["、"],["「"],["はい"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":5,"text":"神が言われた。「ここに近づいてはならない。足から履物を脱ぎなさい。あなたの立っている場所は聖なる土地だから。」","tok":[["神","かみ"],["が"],["言われた","いわれた"],["。"],["「"],["ここ"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["足","あし"],["から"],["履物","はきもの"],["を"],["脱ぎ","ぬぎ"],["なさい"],["。"],["あなた"],["の"],["立って","たって"],["いる"],["場所","ばしょ"],["は"],["聖","せい"],["なる"],["土地","とち"],["だ"],["から"],["。"],["」"]]},{"verse":6,"text":"神は続けて言われた。「わたしはあなたの父の神である。アブラハムの神、イサクの神、ヤコブの神である。」モーセは、神を見ることを恐れて顔を覆った。","tok":[["神","かみ"],["は"],["続けて","つづけて"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["あなた"],["の"],["父","ちち"],["の"],["神","かみ"],["で"],["ある"],["。"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["で"],["ある"],["。"],["」"],["モーセ"],["は"],["、"],["神","かみ"],["を"],["見る","みる"],["こと"],["を"],["恐れて","おそれて"],["顔","かお"],["を"],["覆った","おおった"],["。"]]},{"verse":7,"text":"主は言われた。「わたしは、エジプトにいるわたしの民の苦しみをつぶさに見、追い使う者のゆえに叫ぶ彼らの叫び声を聞き、その痛みを知った。","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["、"],["エジプト"],["に"],["いる"],["わたし"],["の"],["民","たみ"],["の"],["苦しみ","くるしみ"],["を"],["つぶさに"],["見","み"],["、"],["追い使う","おいつかう"],["者","もの"],["の"],["ゆえ"],["に"],["叫ぶ","さけぶ"],["彼","かれ"],["ら"],["の"],["叫び声","さけびごえ"],["を"],["聞き","きき"],["、"],["その"],["痛み","いたみ"],["を"],["知った","しった"],["。"]]},{"verse":8,"text":"それゆえ、わたしは降って行き、エジプト人の手から彼らを救い出し、この国から、広々としたすばらしい土地、乳と蜜の流れる土地、カナン人、ヘト人、アモリ人、ペリジ人、ヒビ人、エブス人の住む所へ彼らを導き上る。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["降って","ふって"],["行き","いき"],["、"],["エジプト"],["人","にん"],["の"],["手","て"],["から"],["彼","かれ"],["ら"],["を"],["救い出し","すくいだし"],["、"],["この"],["国","くに"],["から"],["、"],["広々","ひろびろ"],["と"],["した"],["すばらしい"],["土地","とち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["土地","とち"],["、"],["カナン人","かなんにん"],["、"],["ヘト人","へとにん"],["、"],["アモリ人","あもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["住む","すむ"],["所","ところ"],["へ"],["彼","かれ"],["ら"],["を"],["導き","みちびき"],["上る","のぼる"],["。"]]},{"verse":9,"text":"見よ、イスラエルの人々の叫び声が、今、わたしのもとに届いた。また、エジプト人が彼らを圧迫する有様を見た。","tok":[["見よ","みよ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["叫び声","さけびごえ"],["が"],["、"],["今","いま"],["、"],["わたし"],["の"],["もと"],["に"],["届いた","とどいた"],["。"],["また"],["、"],["エジプト"],["人","にん"],["が"],["彼","かれ"],["ら"],["を"],["圧迫","あっぱく"],["する"],["有様","ありさま"],["を"],["見た","みた"],["。"]]},{"verse":10,"text":"今、行きなさい。わたしはあなたをファラオのもとに遣わす。わが民イスラエルの人々をエジプトから連れ出すのだ。」","tok":[["今","いま"],["、"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["あなた"],["を"],["ファラオ"],["の"],["もと"],["に"],["遣わす","つかわす"],["。"],["わが"],["民","みん"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["から"],["連れ出す","つれだす"],["の"],["だ"],["。"],["」"]]},{"verse":11,"text":"モーセは神に言った。「わたしは何者でしょう。どうして、ファラオのもとに行き、しかもイスラエルの人々をエジプトから導き出さねばならないのですか。」","tok":[["モーセ"],["は"],["神","かみ"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["何者","なにもの"],["でしょう"],["。"],["どう"],["して"],["、"],["ファラオ"],["の"],["もと"],["に"],["行き","いき"],["、"],["しかも"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["エジプト"],["から"],["導き出さねば","みちびきださねば"],["ならない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":12,"text":"神は言われた。「わたしは必ずあなたと共にいる。このことこそ、わたしがあなたを遣わすしるしである。あなたが民をエジプトから導き出したとき、あなたたちはこの山で神に仕える。」","tok":[["神","かみ"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["必ず","かならず"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"],["この"],["こと"],["こそ"],["、"],["わたし"],["が"],["あなた"],["を"],["遣わす","つかわす"],["しるし"],["で"],["ある"],["。"],["あなた"],["が"],["民","たみ"],["を"],["エジプト"],["から"],["導き出した","みちびきだした"],["とき"],["、"],["あなた"],["たち"],["は"],["この"],["山","やま"],["で"],["神","かみ"],["に"],["仕える","つかえる"],["。"],["」"]]},{"verse":13,"text":"モーセは神に尋ねた。「わたしは、今、イスラエルの人々のところへ参ります。彼らに、『あなたたちの先祖の神が、わたしをここに遣わされたのです』と言えば、彼らは、『その名は一体何か』と問うにちがいありません。彼らに何と答えるべきでしょうか。」","tok":[["モーセ"],["は"],["神","かみ"],["に"],["尋ねた","たずねた"],["。"],["「"],["わたし"],["は"],["、"],["今","いま"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ところ"],["へ"],["参ります","まいります"],["。"],["彼","かれ"],["ら"],["に"],["、"],["『"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["が"],["、"],["わたし"],["を"],["ここ"],["に"],["遣わされた","つかわされた"],["の"],["です"],["』"],["と"],["言えば","いえば"],["、"],["彼","かれ"],["ら"],["は"],["、"],["『"],["その"],["名","な"],["は"],["一体","いったい"],["何","なん"],["か"],["』"],["と"],["問う","とう"],["に"],["ちがい"],["ありません"],["。"],["彼","かれ"],["ら"],["に"],["何","なん"],["と"],["答えるべきでしょう","こたえるべきでしょう"],["か"],["。"],["」"]]},{"verse":14,"text":"神はモーセに、「わたしはある。わたしはあるという者だ」と言われ、また、「イスラエルの人々にこう言うがよい。『わたしはある』という方がわたしをあなたたちに遣わされたのだと。」","tok":[["神","かみ"],["は"],["モーセ"],["に"],["、"],["「"],["わたし"],["は"],["ある"],["。"],["わたし"],["は"],["ある"],["と"],["いう"],["者","もの"],["だ"],["」"],["と"],["言われ","いわれ"],["、"],["また"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["こう"],["言う","ゆう"],["が"],["よい"],["。"],["『"],["わたし"],["は"],["ある"],["』"],["と"],["いう"],["方","かた"],["が"],["わたし"],["を"],["あなた"],["たち"],["に"],["遣わされた","つかわされた"],["の"],["だ"],["と"],["。"],["」"]]},{"verse":15,"text":"神は、更に続けてモーセに命じられた。「イスラエルの人々にこう言うがよい。あなたたちの先祖の神、アブラハムの神、イサクの神、ヤコブの神である主がわたしをあなたたちのもとに遣わされた。これこそ、とこしえにわたしの名これこそ、世々にわたしの呼び名。","tok":[["神","かみ"],["は"],["、"],["更に","さらに"],["続けて","つづけて"],["モーセ"],["に"],["命じられた","めいじられた"],["。"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["こう"],["言う","ゆう"],["が"],["よい"],["。"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["アブラハム"],["の"],["神","かみ"],["、"],["イサク"],["の"],["神","かみ"],["、"],["ヤコブ"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["わたし"],["を"],["あなた"],["たち"],["の"],["もと"],["に"],["遣わされた","つかわされた"],["。"],["これ"],["こそ"],["、"],["とこしえ"],["に"],["わたし"],["の"],["名","な"],["これ"],["こそ"],["、"],["世々","せいせい"],["に"],["わたし"],["の"],["呼び名","よびな"],["。"]]},{"verse":16,"text":"さあ、行って、イスラエルの長老たちを集め、言うがよい。『あなたたちの先祖の神、アブラハム、イサク、ヤコブの神である主がわたしに現れて、こう言われた。わたしはあなたたちを顧み、あなたたちがエジプトで受けてきた仕打ちをつぶさに見た。","tok":[["さあ"],["、"],["行って","いって"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["を"],["集め","あつめ"],["、"],["言う","ゆう"],["が"],["よい"],["。"],["『"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["わたし"],["に"],["現れて","あらわれて"],["、"],["こう"],["言われた","いわれた"],["。"],["わたし"],["は"],["あなた"],["たち"],["を"],["顧み","かえりみ"],["、"],["あなた"],["たち"],["が"],["エジプト"],["で"],["受けて","うけて"],["きた"],["仕打ち","しうち"],["を"],["つぶさに"],["見た","みた"],["。"]]},{"verse":17,"text":"あなたたちを苦しみのエジプトから、カナン人、ヘト人、アモリ人、ペリジ人、ヒビ人、エブス人の住む乳と蜜の流れる土地へ導き上ろうと決心した』と。","tok":[["あなた"],["たち"],["を"],["苦しみ","くるしみ"],["の"],["エジプト"],["から"],["、"],["カナン人","かなんにん"],["、"],["ヘト人","へとにん"],["、"],["アモリ人","あもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["住む","すむ"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["土地","とち"],["へ"],["導き","みちびき"],["上ろう","のぼろう"],["と"],["決心","けっしん"],["した"],["』"],["と"],["。"]]},{"verse":18,"text":"彼らはあなたの言葉に従うであろう。あなたはイスラエルの長老たちを伴い、エジプト王のもとに行って彼に言いなさい。『ヘブライ人の神、主がわたしたちに出現されました。どうか、今、三日の道のりを荒れ野に行かせて、わたしたちの神、主に犠牲をささげさせてください。』","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["の"],["言葉","ことば"],["に"],["従うで","したがうで"],["あろう"],["。"],["あなた"],["は"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["を"],["伴い","ともない"],["、"],["エジプト"],["王","おう"],["の"],["もと"],["に"],["行って","いって"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["。"],["『"],["ヘブライ"],["人","にん"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["わたしたち"],["に"],["出現","しゅつげん"],["されました"],["。"],["どう"],["か"],["、"],["今","いま"],["、"],["三日","みっか"],["の"],["道のり","みちのり"],["を"],["荒れ野","あれの"],["に"],["行かせて","いかせて"],["、"],["わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["犠牲","ぎせい"],["を"],["ささげさせて"],["ください"],["。"],["』"]]},{"verse":19,"text":"しかしわたしは、強い手を用いなければ、エジプト王が行かせないことを知っている。","tok":[["しかし"],["わたし"],["は"],["、"],["強い","つよい"],["手","て"],["を"],["用いなければ","もちいなければ"],["、"],["エジプト"],["王","おう"],["が"],["行かせない","いかせない"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":20,"text":"わたしは自ら手を下しあらゆる驚くべき業をエジプトの中で行い、これを打つ。その後初めて、王はあなたたちを去らせるであろう。","tok":[["わたし"],["は"],["自ら","みずから"],["手","て"],["を"],["下し","くだし"],["あらゆる"],["驚くべき","おどろくべき"],["業","ごう"],["を"],["エジプト"],["の"],["中","なか"],["で"],["行い","おこない"],["、"],["これ"],["を"],["打つ","うつ"],["。"],["その後","そのあと"],["初めて","はじめて"],["、"],["王","おう"],["は"],["あなた"],["たち"],["を"],["去らせるで","さらせるで"],["あろう"],["。"]]},{"verse":21,"text":"そのとき、わたしは、この民にエジプト人の好意を得させるようにしよう。出国に際して、あなたたちは何も持たずに出ることはない。","tok":[["その"],["とき"],["、"],["わたし"],["は"],["、"],["この"],["民","たみ"],["に"],["エジプト"],["人","にん"],["の"],["好意","こうい"],["を"],["得させる","えさせる"],["よう"],["に"],["しよう"],["。"],["出国","しゅっこく"],["に"],["際して","さいして"],["、"],["あなた"],["たち"],["は"],["何","なん"],["も"],["持たず","もたず"],["に"],["出る","でる"],["こと"],["は"],["ない"],["。"]]},{"verse":22,"text":"女は皆、隣近所や同居の女たちに金銀の装身具や外套を求め、それを自分の息子、娘の身に着けさせ、エジプト人からの分捕り物としなさい。」","tok":[["女","おんな"],["は"],["皆","みな"],["、"],["隣","となり"],["近所","きんじょ"],["や"],["同居","どうきょ"],["の"],["女","おんな"],["たち"],["に"],["金銀","きんぎん"],["の"],["装身具","そうしんぐ"],["や"],["外套","がいとう"],["を"],["求め","もとめ"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["の"],["身","み"],["に"],["着けさせ","つけさせ"],["、"],["エジプト"],["人","にん"],["から"],["の"],["分","ぶん"],["捕り物","とりもの"],["と"],["し"],["なさい"],["。"],["」"]]}]
[{"verse":1,"text":"主はモーセに言われた。「前と同じ石の板を二枚切りなさい。わたしは、あなたが砕いた、前の板に書かれていた言葉を、その板に記そう。","tok":[["主","ぬし"],["は"],["モーセ"],["に"],["言われた","いわれた"],["。"],["「"],["前","まえ"],["と"],["同じ","おなじ"],["石","いし"],["の"],["板","いた"],["を"],["二枚","にまい"],["切り","きり"],["なさい"],["。"],["わたし"],["は"],["、"],["あなた"],["が"],["砕いた","くだいた"],["、"],["前","まえ"],["の"],["板","いた"],["に"],["書かれて","かかれて"],["いた"],["言葉","ことば"],["を"],["、"],["その"],["板","いた"],["に"],["記そう","しるそう"],["。"]]},{"verse":2,"text":"明日の朝までにそれを用意し、朝、シナイ山に登り、山の頂でわたしの前に立ちなさい。","tok":[["明日","あす"],["の"],["朝","あさ"],["まで"],["に"],["それ"],["を"],["用意","ようい"],["し"],["、"],["朝","あさ"],["、"],["シナイ"],["山","やま"],["に"],["登り","のぼり"],["、"],["山","やま"],["の"],["頂","いただき"],["で"],["わたし"],["の"],["前","まえ"],["に"],["立ち","たち"],["なさい"],["。"]]},{"verse":3,"text":"だれもあなたと一緒に登ってはならない。山のどこにも人の姿があってはならず、山のふもとで羊や牛の放牧もしてはならない。」","tok":[["だれ"],["も"],["あなた"],["と"],["一緒","いっしょ"],["に"],["登って","のぼって"],["は"],["ならない"],["。"],["山","やま"],["の"],["どこ"],["に"],["も"],["人","ひと"],["の"],["姿","すがた"],["が"],["あって"],["は"],["ならず"],["、"],["山","やま"],["の"],["ふもと"],["で"],["羊","ひつじ"],["や"],["牛","うし"],["の"],["放牧","ほうぼく"],["も"],["して"],["は"],["ならない"],["。"],["」"]]},{"verse":4,"text":"モーセは前と同じ石の板を二枚切り、朝早く起きて、主が命じられたとおりシナイ山に登った。手には二枚の石の板を携えていた。","tok":[["モーセ"],["は"],["前","まえ"],["と"],["同じ","おなじ"],["石","いし"],["の"],["板","いた"],["を"],["二枚切り","にまいきり"],["、"],["朝","あさ"],["早く","はやく"],["起きて","おきて"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["とおり"],["シナイ"],["山","やま"],["に"],["登った","のぼった"],["。"],["手","て"],["に"],["は"],["二枚","にまい"],["の"],["石","いし"],["の"],["板","いた"],["を"],["携えて","たずさえて"],["いた"],["。"]]},{"verse":5,"text":"主は雲のうちにあって降り、モーセと共にそこに立ち、主の御名を宣言された。","tok":[["主","ぬし"],["は"],["雲","くも"],["の"],["うち"],["に"],["あって"],["降り","ふり"],["、"],["モーセ"],["と"],["共","とも"],["に"],["そこ"],["に"],["立ち","たち"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["宣言","せんげん"],["された"],["。"]]},{"verse":6,"text":"主は彼の前を通り過ぎて宣言された。「主、主、憐れみ深く恵みに富む神、忍耐強く、慈しみとまことに満ち、","tok":[["主","ぬし"],["は"],["彼","かれ"],["の"],["前","まえ"],["を"],["通り過ぎて","とおりすぎて"],["宣言","せんげん"],["された"],["。"],["「"],["主","ぬし"],["、"],["主","ぬし"],["、"],["憐れみ","あわれみ"],["深く","ふかく"],["恵み","めぐみ"],["に"],["富む","とむ"],["神","かみ"],["、"],["忍耐","にんたい"],["強く","つよく"],["、"],["慈しみ","いつくしみ"],["と"],["まこと"],["に"],["満ち","みち"],["、"]]},{"verse":7,"text":"幾千代にも及ぶ慈しみを守り、罪と背きと過ちを赦す。しかし罰すべき者を罰せずにはおかず、父祖の罪を、子、孫に三代、四代までも問う者。」","tok":[["幾","いく"],["千代","ちよ"],["に"],["も"],["及ぶ","およぶ"],["慈しみ","いつくしみ"],["を"],["守り","まもり"],["、"],["罪","つみ"],["と"],["背き","そむき"],["と"],["過ち","あやまち"],["を"],["赦す","ゆるす"],["。"],["しかし"],["罰すべき","ばっすべき"],["者","もの"],["を"],["罰せず","ばっせず"],["に"],["は"],["おかず"],["、"],["父祖","ふそ"],["の"],["罪","つみ"],["を"],["、"],["子","こ"],["、"],["孫","まご"],["に"],["三代","みよ"],["、"],["四","よん"],["代","だい"],["まで"],["も"],["問う","とう"],["者","もの"],["。"],["」"]]},{"verse":8,"text":"モーセは急いで地にひざまずき、ひれ伏して、","tok":[["モーセ"],["は"],["急いで","いそいで"],["地","ち"],["に"],["ひざまずき"],["、"],["ひれ伏して","ひれふして"],["、"]]},{"verse":9,"text":"言った。「主よ、もし御好意を示してくださいますならば、主よ、わたしたちの中にあって進んでください。確かにかたくなな民ですが、わたしたちの罪と過ちを赦し、わたしたちをあなたの嗣業として受け入れてください。」","tok":[["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["もし"],["御好意","ごこうい"],["を"],["示して","しめして"],["くださいますならば"],["、"],["主","ぬし"],["よ"],["、"],["わたしたち"],["の"],["中","なか"],["に"],["あって"],["進んで","すすんで"],["ください"],["。"],["確か","たしか"],["に"],["かたくな"],["な"],["民","たみ"],["です"],["が"],["、"],["わたしたち"],["の"],["罪","つみ"],["と"],["過ち","あやまち"],["を"],["赦し","ゆるし"],["、"],["わたしたち"],["を"],["あなた"],["の"],["嗣業","しぎょう"],["として"],["受け入れて","うけいれて"],["ください"],["。"],["」"]]},{"verse":10,"text":"主は言われた。「見よ、わたしは契約を結ぶ。わたしはあなたの民すべての前で驚くべき業を行う。それは全地のいかなる民にもいまだかつてなされたことのない業である。あなたと共にいるこの民は皆、主の業を見るであろう。わたしがあなたと共にあって行うことは恐るべきものである。","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"],["わたし"],["は"],["あなた"],["の"],["民","みん"],["すべて"],["の"],["前","まえ"],["で"],["驚くべき","おどろくべき"],["業","ごう"],["を"],["行う","おこなう"],["。"],["それ"],["は"],["全地","ぜんち"],["の"],["いかなる"],["民","たみ"],["に"],["も"],["いまだ"],["かつて"],["なされた"],["こと"],["の"],["ない"],["業","ごう"],["で"],["ある"],["。"],["あなた"],["と"],["共","とも"],["に"],["いる"],["この"],["民","みん"],["は"],["皆","みな"],["、"],["主","ぬし"],["の"],["業","ごう"],["を"],["見るで","みるで"],["あろう"],["。"],["わたし"],["が"],["あなた"],["と"],["共","とも"],["に"],["あって"],["行う","おこなう"],["こと"],["は"],["恐るべき","おそるべき"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしが、今日命じることを守りなさい。見よ、わたしはあなたの前から、アモリ人、カナン人、ヘト人、ペリジ人、ヒビ人、エブス人を追い出す。","tok":[["わたし"],["が"],["、"],["今日","きょう"],["命じる","めいじる"],["こと"],["を"],["守り","まもり"],["なさい"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["前","まえ"],["から"],["、"],["アモリ人","あもりにん"],["、"],["カナン人","かなんにん"],["、"],["ヘト人","へとにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス"],["人","ひと"],["を"],["追い出す","おいだす"],["。"]]},{"verse":12,"text":"よく注意して、あなたがこれから入って行く土地の住民と契約を結ばないようにしなさい。それがあなたの間で罠とならないためである。","tok":[["よく"],["注意","ちゅうい"],["して"],["、"],["あなた"],["が"],["これ"],["から"],["入って","はいって"],["行く","いく"],["土地","とち"],["の"],["住民","じゅうみん"],["と"],["契約","けいやく"],["を"],["結ばない","むすばない"],["よう"],["に"],["し"],["なさい"],["。"],["それ"],["が"],["あなた"],["の"],["間","あいだ"],["で"],["罠","わな"],["と"],["ならない"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"あなたたちは、彼らの祭壇を引き倒し、石柱を打ち砕き、アシェラ像を切り倒しなさい。","tok":[["あなた"],["たち"],["は"],["、"],["彼","かれ"],["ら"],["の"],["祭壇","さいだん"],["を"],["引き倒し","ひきたおし"],["、"],["石柱","せきちゅう"],["を"],["打ち砕き","うちくだき"],["、"],["アシェラ"],["像","ぞう"],["を"],["切り倒し","きりたおし"],["なさい"],["。"]]},{"verse":14,"text":"あなたはほかの神を拝んではならない。主はその名を熱情といい、熱情の神である。","tok":[["あなた"],["は"],["ほか"],["の"],["神","かみ"],["を"],["拝んで","おがんで"],["は"],["ならない"],["。"],["主","ぬし"],["は"],["その"],["名","な"],["を"],["熱情","ねつじょう"],["と"],["いい"],["、"],["熱情","ねつじょう"],["の"],["神","かみ"],["で"],["ある"],["。"]]},{"verse":15,"text":"その土地の住民と契約を結ばないようにしなさい。彼らがその神々を求めて姦淫を行い、その神々にいけにえをささげるとき、あなたを招き、あなたはそのいけにえを食べるようになる。","tok":[["その"],["土地","とち"],["の"],["住民","じゅうみん"],["と"],["契約","けいやく"],["を"],["結ばない","むすばない"],["よう"],["に"],["し"],["なさい"],["。"],["彼","かれ"],["ら"],["が"],["その"],["神々","かみがみ"],["を"],["求めて","もとめて"],["姦淫","かんいん"],["を"],["行い","おこない"],["、"],["その"],["神々","かみがみ"],["に"],["いけにえ"],["を"],["ささげる"],["とき"],["、"],["あなた"],["を"],["招き","まねき"],["、"],["あなた"],["は"],["その"],["いけにえ"],["を"],["食べる","たべる"],["よう"],["に"],["なる"],["。"]]},{"verse":16,"text":"あなたが彼らの娘を自分の息子にめとると、彼女たちがその神々と姦淫を行い、あなたの息子たちを誘ってその神々と姦淫を行わせるようになる。","tok":[["あなた"],["が"],["彼","かれ"],["ら"],["の"],["娘","むすめ"],["を"],["自分","じぶん"],["の"],["息子","むすこ"],["に"],["めとる"],["と"],["、"],["彼女","かのじょ"],["たち"],["が"],["その"],["神々","かみがみ"],["と"],["姦淫","かんいん"],["を"],["行い","おこない"],["、"],["あなた"],["の"],["息子","むすこ"],["たち"],["を"],["誘って","さそって"],["その"],["神々","かみがみ"],["と"],["姦淫","かんいん"],["を"],["行わせる","おこなわせる"],["よう"],["に"],["なる"],["。"]]},{"verse":17,"text":"あなたは鋳像の神々を造ってはならない。","tok":[["あなた"],["は"],["鋳像","ちゅうぞう"],["の"],["神々","かみがみ"],["を"],["造って","つくって"],["は"],["ならない"],["。"]]},{"verse":18,"text":"あなたは除酵祭を守りなさい。七日の間、アビブの月の定めの日に、わたしが命じた酵母を入れないパンを食べなさい。アビブの月に、あなたはエジプトを出たからである。","tok":[["あなた"],["は"],["除","じょ"],["酵祭"],["を"],["守り","まもり"],["なさい"],["。"],["七日","ななか"],["の"],["間","あいだ"],["、"],["アビブ"],["の"],["月","つき"],["の"],["定め","さだめ"],["の"],["日","ひ"],["に"],["、"],["わたし"],["が"],["命じた","めいじた"],["酵母","こうぼ"],["を"],["入れない","いれない"],["パン"],["を"],["食べ","たべ"],["なさい"],["。"],["アビブ"],["の"],["月","つき"],["に"],["、"],["あなた"],["は"],["エジプト"],["を"],["出た","でた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"初めに胎を開くものはすべて、わたしのものである。あなたの家畜である牛や羊の初子が雄であるならば、すべて別にしなければならない。","tok":[["初め","はじめ"],["に"],["胎","はら"],["を"],["開く","ひらく"],["もの"],["は"],["すべて"],["、"],["わたし"],["の"],["もの"],["で"],["ある"],["。"],["あなた"],["の"],["家畜","かちく"],["で"],["ある"],["牛","うし"],["や"],["羊","ひつじ"],["の"],["初子","ういご"],["が"],["雄","おす"],["で"],["あるならば"],["、"],["すべて"],["別","べつ"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":20,"text":"ただし、ろばの初子の場合は、小羊をもって贖わねばならない。もし贖わない場合は、その首を折りなさい。あなたの初子のうち、男の子はすべて贖わねばならない。何も持たずに、わたしの前に出てはならない。","tok":[["ただし"],["、"],["ろば"],["の"],["初子","ういご"],["の"],["場合","ばあい"],["は"],["、"],["小羊","こひつじ"],["を"],["もって"],["贖わねば","あがなわねば"],["ならない"],["。"],["もし"],["贖わない","あがなわない"],["場合","ばあい"],["は"],["、"],["その"],["首","くび"],["を"],["折り","おり"],["なさい"],["。"],["あなた"],["の"],["初子","ういご"],["の"],["うち"],["、"],["男の子","おとこのこ"],["は"],["すべて"],["贖わねば","あがなわねば"],["ならない"],["
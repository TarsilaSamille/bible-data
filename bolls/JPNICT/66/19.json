[{"verse":1,"text":"その後、わたしは、大群衆の大声のようなものが、天でこう言うのを聞いた。「ハレルヤ。救いと栄光と力とは、わたしたちの神のもの。","tok":[["その"],["後","ご"],["、"],["わたし"],["は"],["、"],["大","だい"],["群衆","ぐんしゅう"],["の"],["大声","おおごえ"],["の"],["よう"],["な"],["もの"],["が"],["、"],["天","てん"],["で"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["ハレルヤ"],["。"],["救い","すくい"],["と"],["栄光","えいこう"],["と"],["力","ちから"],["と"],["は"],["、"],["わたしたち"],["の"],["神","かみ"],["の"],["もの"],["。"]]},{"verse":2,"text":"その裁きは真実で正しいからである。みだらな行いで地上を堕落させたあの大淫婦を裁き、御自分の僕たちの流した血の復讐を、彼女になさったからである。」","tok":[["その"],["裁き","さばき"],["は"],["真実","しんじつ"],["で"],["正しい","ただしい"],["から"],["で"],["ある"],["。"],["みだら"],["な"],["行い","おこない"],["で"],["地上","ちじょう"],["を"],["堕落","だらく"],["させた"],["あの"],["大","だい"],["淫婦","いんぷ"],["を"],["裁き","さばき"],["、"],["御自分","ごじぶん"],["の"],["僕たち","ぼくたち"],["の"],["流した","ながした"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["、"],["彼女","かのじょ"],["に"],["なさった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":3,"text":"また、こうも言った。「ハレルヤ。大淫婦が焼かれる煙は、世々限りなく立ち上る。」","tok":[["また"],["、"],["こう"],["も"],["言った","いった"],["。"],["「"],["ハレルヤ"],["。"],["大","だい"],["淫婦","いんぷ"],["が"],["焼かれる","やかれる"],["煙","けむり"],["は"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["立ち上る","たちのぼる"],["。"],["」"]]},{"verse":4,"text":"そこで、二十四人の長老と四つの生き物とはひれ伏して、玉座に座っておられる神を礼拝して言った。「アーメン、ハレルヤ。」","tok":[["そこ"],["で"],["、"],["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["と"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["は"],["ひれ伏して","ひれふして"],["、"],["玉座","ぎょくざ"],["に"],["座って","すわって"],["おられる"],["神","かみ"],["を"],["礼拝","れいはい"],["して"],["言った","いった"],["。"],["「"],["アーメン"],["、"],["ハレルヤ"],["。"],["」"]]},{"verse":5,"text":"また、玉座から声がして、こう言った。「すべて神の僕たちよ、神を畏れる者たちよ、小さな者も大きな者も、わたしたちの神をたたえよ。」","tok":[["また"],["、"],["玉座","ぎょくざ"],["から"],["声","こえ"],["が"],["して"],["、"],["こう"],["言った","いった"],["。"],["「"],["すべて"],["神","かみ"],["の"],["僕たち","ぼくたち"],["よ"],["、"],["神","かみ"],["を"],["畏れる","おそれる"],["者","もの"],["たち"],["よ"],["、"],["小さな","ちいさな"],["者","もの"],["も"],["大きな","おおきな"],["者","もの"],["も"],["、"],["わたしたち"],["の"],["神","かみ"],["を"],["たたえ"],["よ"],["。"],["」"]]},{"verse":6,"text":"わたしはまた、大群衆の声のようなもの、多くの水のとどろきや、激しい雷のようなものが、こう言うのを聞いた。「ハレルヤ、全能者であり、わたしたちの神である主が王となられた。","tok":[["わたし"],["は"],["また"],["、"],["大","だい"],["群衆","ぐんしゅう"],["の"],["声","こえ"],["の"],["よう"],["な"],["もの"],["、"],["多く","おおく"],["の"],["水","みず"],["の"],["とどろき"],["や"],["、"],["激しい","はげしい"],["雷","かみなり"],["の"],["よう"],["な"],["もの"],["が"],["、"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["ハレルヤ"],["、"],["全能者","ぜんのうしゃ"],["で"],["あり"],["、"],["わたしたち"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["王","おう"],["と"],["なられた"],["。"]]},{"verse":7,"text":"わたしたちは喜び、大いに喜び、神の栄光をたたえよう。小羊の婚礼の日が来て、花嫁は用意を整えた。","tok":[["わたしたち"],["は"],["喜び","よろこび"],["、"],["大いに","おおいに"],["喜び","よろこび"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["たたえよう"],["。"],["小羊","こひつじ"],["の"],["婚礼","こんれい"],["の"],["日","ひ"],["が"],["来て","きて"],["、"],["花嫁","はなよめ"],["は"],["用意","ようい"],["を"],["整えた","ととのえた"],["。"]]},{"verse":8,"text":"花嫁は、輝く清い麻の衣を着せられた。この麻の衣とは、聖なる者たちの正しい行いである。」","tok":[["花嫁","はなよめ"],["は"],["、"],["輝く","かがやく"],["清い","きよい"],["麻","あさ"],["の"],["衣","ころも"],["を"],["着せられた","きせられた"],["。"],["この"],["麻","あさ"],["の"],["衣","ころも"],["と"],["は"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["正しい","ただしい"],["行い","おこない"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"それから天使はわたしに、「書き記せ。小羊の婚宴に招かれている者たちは幸いだ」と言い、また、「これは、神の真実の言葉である」とも言った。","tok":[["それ"],["から"],["天使","てんし"],["は"],["わたし"],["に"],["、"],["「"],["書き記せ","かきしるせ"],["。"],["小羊","こひつじ"],["の"],["婚","こん"],["宴","えん"],["に"],["招かれて","まねかれて"],["いる"],["者","もの"],["たち"],["は"],["幸い","さいわい"],["だ"],["」"],["と"],["言い","いい"],["、"],["また"],["、"],["「"],["これ"],["は"],["、"],["神","かみ"],["の"],["真実","しんじつ"],["の"],["言葉","ことば"],["で"],["ある"],["」"],["と"],["も"],["言った","いった"],["。"]]},{"verse":10,"text":"わたしは天使を拝もうとしてその足もとにひれ伏した。すると、天使はわたしにこう言った。「やめよ。わたしは、あなたやイエスの証しを守っているあなたの兄弟たちと共に、仕える者である。神を礼拝せよ。イエスの証しは預言の霊なのだ。」","tok":[["わたし"],["は"],["天使","てんし"],["を"],["拝もう","おがもう"],["として"],["その"],["足もと","あしもと"],["に"],["ひれ伏した","ひれふした"],["。"],["する"],["と"],["、"],["天使","てんし"],["は"],["わたし"],["に"],["こう"],["言った","いった"],["。"],["「"],["やめ"],["よ"],["。"],["わたし"],["は"],["、"],["あなた"],["や"],["イエス"],["の"],["証し","あかし"],["を"],["守って","まもって"],["いる"],["あなた"],["の"],["兄弟","きょうだい"],["たち"],["と"],["共","とも"],["に"],["、"],["仕える","つかえる"],["者","もの"],["で"],["ある"],["。"],["神","かみ"],["を"],["礼拝","れいはい"],["せよ"],["。"],["イエス"],["の"],["証し","あかし"],["は"],["預言","よげん"],["の"],["霊","れい"],["な"],["の"],["だ"],["。"],["」"]]},{"verse":11,"text":"そして、わたしは天が開かれているのを見た。すると、見よ、白い馬が現れた。それに乗っている方は、「誠実」および「真実」と呼ばれて、正義をもって裁き、また戦われる。","tok":[["そして"],["、"],["わたし"],["は"],["天","てん"],["が"],["開かれて","ひらかれて"],["いる"],["の"],["を"],["見た","みた"],["。"],["する"],["と"],["、"],["見よ","みよ"],["、"],["白い","しろい"],["馬","うま"],["が"],["現れた","あらわれた"],["。"],["それ"],["に"],["乗って","のって"],["いる"],["方","かた"],["は"],["、"],["「"],["誠実","せいじつ"],["」"],["および"],["「"],["真実","しんじつ"],["」"],["と"],["呼ばれて","よばれて"],["、"],["正義","せいぎ"],["を"],["もって"],["裁き","さばき"],["、"],["また"],["戦われる","たたかわれる"],["。"]]},{"verse":12,"text":"その目は燃え盛る炎のようで、頭には多くの王冠があった。この方には、自分のほかはだれも知らない名が記されていた。","tok":[["その"],["目","め"],["は"],["燃え盛る","もえさかる"],["炎","ほのお"],["の"],["よう"],["で"],["、"],["頭","あたま"],["に"],["は"],["多く","おおく"],["の"],["王冠","おうかん"],["が"],["あった"],["。"],["この"],["方","かた"],["に"],["は"],["、"],["自分","じぶん"],["の"],["ほか"],["は"],["だれ"],["も"],["知らない","しらない"],["名","な"],["が"],["記されて","しるされて"],["いた"],["。"]]},{"verse":13,"text":"また、血に染まった衣を身にまとっており、その名は「神の言葉」と呼ばれた。","tok":[["また"],["、"],["血","ち"],["に"],["染まった","そまった"],["衣","ころも"],["を"],["身","み"],["に"],["まとって"],["おり"],["、"],["その"],["名","な"],["は"],["「"],["神","かみ"],["の"],["言葉","ことば"],["」"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":14,"text":"そして、天の軍勢が白い馬に乗り、白く清い麻の布をまとってこの方に従っていた。","tok":[["そして"],["、"],["天","てん"],["の"],["軍勢","ぐんぜい"],["が"],["白い","しろい"],["馬","うま"],["に"],["乗り","のり"],["、"],["白く","しろく"],["清い","きよい"],["麻","あさ"],["の"],["布","ぬの"],["を"],["まとって"],["この"],["方","かた"],["に"],["従って","したがって"],["いた"],["。"]]},{"verse":15,"text":"この方の口からは、鋭い剣が出ている。諸国の民をそれで打ち倒すのである。また、自ら鉄の杖で彼らを治める。この方はぶどう酒の搾り桶を踏むが、これには全能者である神の激しい怒りが込められている。","tok":[["この"],["方","かた"],["の"],["口","くち"],["から"],["は"],["、"],["鋭い","するどい"],["剣","けん"],["が"],["出て","でて"],["いる"],["。"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["それ"],["で"],["打ち倒す","うちたおす"],["ので"],["ある"],["。"],["また"],["、"],["自ら鉄","みずからてつ"],["の"],["杖","つえ"],["で"],["彼","かれ"],["ら"],["を"],["治める","おさめる"],["。"],["この"],["方","かた"],["は"],["ぶどう酒","ぶどうしゅ"],["の"],["搾り","しぼり"],["桶","おけ"],["を"],["踏む","ふむ"],["が"],["、"],["これ"],["に"],["は"],["全能者","ぜんのうしゃ"],["で"],["ある"],["神","かみ"],["の"],["激しい","はげしい"],["怒り","いかり"],["が"],["込められて","こめられて"],["いる"],["。"]]},{"verse":16,"text":"この方の衣と腿のあたりには、「王の王、主の主」という名が記されていた。","tok":[["この"],["方","かた"],["の"],["衣","ころも"],["と"],["腿","もも"],["の"],["あたり"],["に"],["は"],["、"],["「"],["王","おう"],["の"],["王","おう"],["、"],["主","ぬし"],["の"],["主","ぬし"],["」"],["と"],["いう"],["名","な"],["が"],["記されて","しるされて"],["いた"],["。"]]},{"verse":17,"text":"わたしはまた、一人の天使が太陽の中に立っているのを見た。この天使は、大声で叫び、空高く飛んでいるすべての鳥にこう言った。「さあ、神の大宴会に集まれ。","tok":[["わたし"],["は"],["また"],["、"],["一人","ひとり"],["の"],["天使","てんし"],["が"],["太陽","たいよう"],["の"],["中","なか"],["に"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["この"],["天使","てんし"],["は"],["、"],["大声","おおごえ"],["で"],["叫び","さけび"],["、"],["空","そら"],["高く","たかく"],["飛んで","とんで"],["いる"],["すべて"],["の"],["鳥","とり"],["に"],["こう"],["言った","いった"],["。"],["「"],["さあ"],["、"],["神","かみ"],["の"],["大","だい"],["宴会","えんかい"],["に"],["集まれ","あつまれ"],["。"]]},{"verse":18,"text":"王の肉、千人隊長の肉、権力者の肉を食べよ。また、馬とそれに乗る者の肉、あらゆる自由な身分の者、奴隷、小さな者や大きな者たちの肉を食べよ。」","tok":[["王","おう"],["の"],["肉","にく"],["、"],["千人","せんにん"],["隊長","たいちょう"],["の"],["肉","にく"],["、"],["権力者","けんりょくしゃ"],["の"],["肉","にく"],["を"],["食べ","たべ"],["よ"],["。"],["また"],["、"],["馬","うま"],["と"],["それ"],["に"],["乗る","のる"],["者","もの"],["の"],["肉","にく"],["、"],["あらゆる"],["自由","じゆう"],["な"],["身分","みぶん"],["の"],["者","もの"],["、"],["奴隷","どれい"],["、"],["小さな","ちいさな"],["者","もの"],["や"],["大きな","おおきな"],["者","もの"],["たち"],["の"],["肉","にく"],["を"],["食べ","たべ"],["よ"],["。"],["」"]]},{"verse":19,"text":"わたしはまた、あの獣と、地上の王たちとその軍勢とが、馬に乗っている方とその軍勢に対して戦うために、集まっているのを見た。","tok":[["わたし"],["は"],["また"],["、"],["あの"],["獣","けもの"],["と"],["、"],["地上","ちじょう"],["の"],["王","おう"],["たち"],["と"],["その"],["軍勢","ぐんぜい"],["と"],["が"],["、"],["馬","うま"],["に"],["乗って","のって"],["いる"],["方","かた"],["と"],["その"],["軍勢","ぐんぜい"],["に対して","にたいして"],["戦う","たたかう"],["ため"],["に"],["、"],["集まって","あつまって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":20,"text":"しかし、獣は捕らえられ、また、獣の前でしるしを行った偽預言者も、一緒に捕らえられた。このしるしによって、獣の刻印を受けた者や、獣の像を拝んでいた者どもは、惑わされていたのであった。獣と偽預言者の両者は、生きたまま硫黄の燃えている火の池に投げ込まれた。","tok":[["しかし"],["、"],["獣","けもの"],["は"],["捕らえられ","とらえられ"],["、"],["また"],["、"],["獣","けもの"],["の"],["前","まえ"],["で"],["しるし"],["を"],["行った","おこなった"],["偽","にせ"],["預言者","よげんしゃ"],["も"],["、"],["一緒","いっしょ"],["に"],["捕らえられた","とらえられた"],["。"],["この"],["しるし"],["によって"],["、"],["獣","けもの"],["の"],["刻印","こくいん"],["を"],["受けた","うけた"],["者","もの"],["や"],["、"],["獣","けもの"],["の"],["像","ぞう"],["を"],["拝んで","おがんで"],["いた"],["者","もの"],["ども"],["は"],["、"],["惑わされて","まどわされて"],["いた"],["ので"],["あった"],["。"],["獣","けもの"],["と"],["偽","にせ"],["預言者","よげんしゃ"],["の"],["両者","りょうしゃ"],["は"],["、"],["生きた","いきた"],["まま"],["硫黄","いおう"],["の"],["燃えて","もえて"],["いる"],["火","ひ"],["の"],["池","いけ"],["に"],["投げ込まれた","なげこまれた"],["。"]]},{"verse":21,"text":"残りの者どもは、馬に乗っている方の口から出ている剣で殺され、すべての鳥は、彼らの肉を飽きるほど食べた。","tok":[["残り","のこり"],["の"],["者","もの"],["ども"],["は"],["、"],["馬","うま"],["に"],["乗って","のって"],["いる"],["方","かた"],["の"],["口","くち"],["から"],["出て","でて"],["いる"],["剣","けん"],["で"],["殺され","ころされ"],["、"],["すべて"],["の"],["鳥","とり"],["は"],["、"],["彼","かれ"],["ら"],["の"],["肉","にく"],["を"],["飽きる","あきる"],["ほど"],["食べた","たべた"],["。"]]}]
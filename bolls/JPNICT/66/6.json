[{"verse":1,"text":"また、わたしが見ていると、小羊が七つの封印の一つを開いた。すると、四つの生き物の一つが、雷のような声で「出て来い」と言うのを、わたしは聞いた。","tok":[["また"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["小羊","こひつじ"],["が"],["七","なな"],["つ"],["の"],["封印","ふういん"],["の"],["一","ひと"],["つ"],["を"],["開いた","ひらいた"],["。"],["する"],["と"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["の"],["一","ひと"],["つ"],["が"],["、"],["雷","かみなり"],["の"],["よう"],["な"],["声","こえ"],["で"],["「"],["出て","でて"],["来い","こい"],["」"],["と"],["言う","いう"],["の"],["を"],["、"],["わたし"],["は"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"そして見ていると、見よ、白い馬が現れ、乗っている者は、弓を持っていた。彼は冠を与えられ、勝利の上に更に勝利を得ようと出て行った。","tok":[["そして"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["白い","しろい"],["馬","うま"],["が"],["現れ","あらわれ"],["、"],["乗って","のって"],["いる"],["者","もの"],["は"],["、"],["弓","ゆみ"],["を"],["持って","もって"],["いた"],["。"],["彼","かれ"],["は"],["冠","かんむり"],["を"],["与えられ","あたえられ"],["、"],["勝利","しょうり"],["の"],["上","うえ"],["に"],["更に","さらに"],["勝利","しょうり"],["を"],["得よう","えよう"],["と"],["出て","でて"],["行った","いった"],["。"]]},{"verse":3,"text":"小羊が第二の封印を開いたとき、第二の生き物が「出て来い」と言うのを、わたしは聞いた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["二","に"],["の"],["封印","ふういん"],["を"],["開いた","ひらいた"],["とき"],["、"],["第","だい"],["二","に"],["の"],["生き物","いきもの"],["が"],["「"],["出て","でて"],["来い","こい"],["」"],["と"],["言う","いう"],["の"],["を"],["、"],["わたし"],["は"],["聞いた","きいた"],["。"]]},{"verse":4,"text":"すると、火のように赤い別の馬が現れた。その馬に乗っている者には、地上から平和を奪い取って、殺し合いをさせる力が与えられた。また、この者には大きな剣が与えられた。","tok":[["する"],["と"],["、"],["火","ひ"],["の"],["よう"],["に"],["赤い","あかい"],["別","べつ"],["の"],["馬","うま"],["が"],["現れた","あらわれた"],["。"],["その"],["馬","うま"],["に"],["乗って","のって"],["いる"],["者","もの"],["に"],["は"],["、"],["地上","ちじょう"],["から"],["平和","へいわ"],["を"],["奪い取って","うばいとって"],["、"],["殺し合い","ころしあい"],["を"],["させる"],["力","ちから"],["が"],["与えられた","あたえられた"],["。"],["また"],["、"],["この"],["者","もの"],["に"],["は"],["大きな","おおきな"],["剣","けん"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":5,"text":"小羊が第三の封印を開いたとき、第三の生き物が「出て来い」と言うのを、わたしは聞いた。そして見ていると、見よ、黒い馬が現れ、乗っている者は、手に秤を持っていた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["三","さん"],["の"],["封印","ふういん"],["を"],["開いた","ひらいた"],["とき"],["、"],["第","だい"],["三","さん"],["の"],["生き物","いきもの"],["が"],["「"],["出て","でて"],["来い","こい"],["」"],["と"],["言う","いう"],["の"],["を"],["、"],["わたし"],["は"],["聞いた","きいた"],["。"],["そして"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["黒い","くろい"],["馬","うま"],["が"],["現れ","あらわれ"],["、"],["乗って","のって"],["いる"],["者","もの"],["は"],["、"],["手","て"],["に"],["秤","はかり"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":6,"text":"わたしは、四つの生き物の間から出る声のようなものが、こう言うのを聞いた。「小麦は一コイニクスで一デナリオン。大麦は三コイニクスで一デナリオン。オリーブ油とぶどう酒とを損なうな。」","tok":[["わたし"],["は"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["の"],["間","あいだ"],["から"],["出る","でる"],["声","こえ"],["の"],["よう"],["な"],["もの"],["が"],["、"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["小麦","こむぎ"],["は"],["一","いち"],["コイニクス"],["で"],["一","いち"],["デナリオン"],["。"],["大麦","おおむぎ"],["は"],["三","さん"],["コイニクス"],["で"],["一","いち"],["デナリオン"],["。"],["オリーブ油","おりーぶゆ"],["と"],["ぶどう酒","ぶどうしゅ"],["と"],["を"],["損なう","そこなう"],["な"],["。"],["」"]]},{"verse":7,"text":"小羊が第四の封印を開いたとき、「出て来い」と言う第四の生き物の声を、わたしは聞いた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["四","よん"],["の"],["封印","ふういん"],["を"],["開いた","ひらいた"],["とき"],["、"],["「"],["出て","でて"],["来い","こい"],["」"],["と"],["言う","いう"],["第","だい"],["四","よん"],["の"],["生き物","いきもの"],["の"],["声","こえ"],["を"],["、"],["わたし"],["は"],["聞いた","きいた"],["。"]]},{"verse":8,"text":"そして見ていると、見よ、青白い馬が現れ、乗っている者の名は「死」といい、これに陰府が従っていた。彼らには、地上の四分の一を支配し、剣と飢饉と死をもって、更に地上の野獣で人を滅ぼす権威が与えられた。","tok":[["そして"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["青白い","あおじろい"],["馬","うま"],["が"],["現れ","あらわれ"],["、"],["乗って","のって"],["いる"],["者","もの"],["の"],["名","な"],["は"],["「"],["死","し"],["」"],["と"],["いい"],["、"],["これ"],["に"],["陰府","よみ"],["が"],["従って","したがって"],["いた"],["。"],["彼","かれ"],["ら"],["に"],["は"],["、"],["地上","ちじょう"],["の"],["四分","よんぶん"],["の"],["一","いち"],["を"],["支配","しはい"],["し"],["、"],["剣","けん"],["と"],["飢饉","ききん"],["と"],["死","し"],["を"],["もって"],["、"],["更に","さらに"],["地上","ちじょう"],["の"],["野獣","やじゅう"],["で"],["人","ひと"],["を"],["滅ぼす","ほろぼす"],["権威","けんい"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":9,"text":"小羊が第五の封印を開いたとき、神の言葉と自分たちがたてた証しのために殺された人々の魂を、わたしは祭壇の下に見た。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["五","ご"],["の"],["封印","ふういん"],["を"],["開いた","ひらいた"],["とき"],["、"],["神","かみ"],["の"],["言葉","ことば"],["と"],["自分","じぶん"],["たち"],["が"],["たてた"],["証し","あかし"],["の"],["ため"],["に"],["殺された","ころされた"],["人々","ひとびと"],["の"],["魂","たましい"],["を"],["、"],["わたし"],["は"],["祭壇","さいだん"],["の"],["下","した"],["に"],["見た","みた"],["。"]]},{"verse":10,"text":"彼らは大声でこう叫んだ。「真実で聖なる主よ、いつまで裁きを行わず、地に住む者にわたしたちの血の復讐をなさらないのですか。」","tok":[["彼","かれ"],["ら"],["は"],["大声","おおごえ"],["で"],["こう"],["叫んだ","さけんだ"],["。"],["「"],["真実","しんじつ"],["で"],["聖","せい"],["なる"],["主","ぬし"],["よ"],["、"],["いつ"],["まで"],["裁き","さばき"],["を"],["行わず","おこなわず"],["、"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["に"],["わたしたち"],["の"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["なさらない"],["の"],["です"],["か"],["。"],["」"]]},{"verse":11,"text":"すると、その一人一人に、白い衣が与えられ、また、自分たちと同じように殺されようとしている兄弟であり、仲間の僕である者たちの数が満ちるまで、なお、しばらく静かに待つようにと告げられた。","tok":[["する"],["と"],["、"],["その"],["一人一人","ひとりひとり"],["に"],["、"],["白い","しろい"],["衣","ころも"],["が"],["与えられ","あたえられ"],["、"],["また"],["、"],["自分","じぶん"],["たち"],["と"],["同じ","おなじ"],["よう"],["に"],["殺されよう","ころされよう"],["として"],["いる"],["兄弟","きょうだい"],["で"],["あり"],["、"],["仲間","なかま"],["の"],["僕","ぼく"],["で"],["ある"],["者","もの"],["たち"],["の"],["数","かず"],["が"],["満ちる","みちる"],["まで"],["、"],["なお"],["、"],["しばらく"],["静か","しずか"],["に"],["待つ","まつ"],["よう"],["に"],["と"],["告げられた","つげられた"],["。"]]},{"verse":12,"text":"また、見ていると、小羊が第六の封印を開いた。そのとき、大地震が起きて、太陽は毛の粗い布地のように暗くなり、月は全体が血のようになって、","tok":[["また"],["、"],["見て","みて"],["いる"],["と"],["、"],["小羊","こひつじ"],["が"],["第","だい"],["六","ろく"],["の"],["封印","ふういん"],["を"],["開いた","ひらいた"],["。"],["その"],["とき"],["、"],["大地震","だいじしん"],["が"],["起きて","おきて"],["、"],["太陽","たいよう"],["は"],["毛","け"],["の"],["粗い","あらい"],["布地","ぬのじ"],["の"],["よう"],["に"],["暗く","くらく"],["なり"],["、"],["月","つき"],["は"],["全体","ぜんたい"],["が"],["血","ち"],["の"],["よう"],["に"],["なって"],["、"]]},{"verse":13,"text":"天の星は地上に落ちた。まるで、いちじくの青い実が、大風に揺さぶられて振り落とされるようだった。","tok":[["天","てん"],["の"],["星","ほし"],["は"],["地上","ちじょう"],["に"],["落ちた","おちた"],["。"],["まるで"],["、"],["いちじく"],["の"],["青い","あおい"],["実","じつ"],["が"],["、"],["大風","おおふう"],["に"],["揺さぶられて","ゆさぶられて"],["振り落とされる","ふりおとされる"],["よう"],["だった"],["。"]]},{"verse":14,"text":"天は巻物が巻き取られるように消え去り、山も島も、みなその場所から移された。","tok":[["天","てん"],["は"],["巻物","まきもの"],["が"],["巻き取られる","まきとられる"],["よう"],["に"],["消え去り","きえさり"],["、"],["山","やま"],["も"],["島","しま"],["も"],["、"],["みな"],["その"],["場所","ばしょ"],["から"],["移された","うつされた"],["。"]]},{"verse":15,"text":"地上の王、高官、千人隊長、富める者、力ある者、また、奴隷も自由な身分の者もことごとく、洞穴や山の岩間に隠れ、","tok":[["地上","ちじょう"],["の"],["王","おう"],["、"],["高官","こうかん"],["、"],["千人","せんにん"],["隊長","たいちょう"],["、"],["富める","とめる"],["者","もの"],["、"],["力","ちから"],["ある"],["者","もの"],["、"],["また"],["、"],["奴隷","どれい"],["も"],["自由","じゆう"],["な"],["身分","みぶん"],["の"],["者","もの"],["も"],["ことごとく"],["、"],["洞穴","ほらあな"],["や"],["山","やま"],["の"],["岩間","いわま"],["に"],["隠れ","かくれ"],["、"]]},{"verse":16,"text":"山と岩に向かって、「わたしたちの上に覆いかぶさって、玉座に座っておられる方の顔と小羊の怒りから、わたしたちをかくまってくれ」と言った。","tok":[["山","やま"],["と"],["岩","いわ"],["に"],["向かって","むかって"],["、"],["「"],["わたしたち"],["の"],["上","うえ"],["に"],["覆いかぶさって","おおいかぶさって"],["、"],["玉座","ぎょくざ"],["に"],["座って","すわって"],["おられる"],["方","かた"],["の"],["顔","かお"],["と"],["小羊","こひつじ"],["の"],["怒り","いかり"],["から"],["、"],["わたしたち"],["を"],["かくまって"],["くれ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":17,"text":"神と小羊の怒りの大いなる日が来たからである。だれがそれに耐えられるであろうか。","tok":[["神","かみ"],["と"],["小羊","こひつじ"],["の"],["怒り","いかり"],["の"],["大いなる","おおいなる"],["日","ひ"],["が"],["来た","きた"],["から"],["で"],["ある"],["。"],["だれ"],["が"],["それ"],["に"],["耐えられるで","たえられるで"],["あろう"],["か"],["。"]]}]
[{"verse":1,"text":"サルディスにある教会の天使にこう書き送れ。『神の七つの霊と七つの星とを持っている方が、次のように言われる。「わたしはあなたの行いを知っている。あなたが生きているとは名ばかりで、実は死んでいる。","tok":[["サルディス"],["に"],["ある"],["教会","きょうかい"],["の"],["天使","てんし"],["に"],["こう"],["書き送れ","かきおくれ"],["。"],["『"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["と"],["七","なな"],["つ"],["の"],["星","ほし"],["と"],["を"],["持って","もって"],["いる"],["方","ほう"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"],["「"],["わたし"],["は"],["あなた"],["の"],["行い","おこない"],["を"],["知って","しって"],["いる"],["。"],["あなた"],["が"],["生きて","いきて"],["いる"],["と"],["は"],["名","な"],["ばかり"],["で"],["、"],["実","じつ"],["は"],["死んで","しんで"],["いる"],["。"]]},{"verse":2,"text":"目を覚ませ。死にかけている残りの者たちを強めよ。わたしは、あなたの行いが、わたしの神の前に完全なものとは認めない。","tok":[["目","め"],["を"],["覚ませ","さませ"],["。"],["死","し"],["に"],["かけて"],["いる"],["残り","のこり"],["の"],["者","もの"],["たち"],["を"],["強めよ","つよめよ"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["が"],["、"],["わたし"],["の"],["神","かみ"],["の"],["前","まえ"],["に"],["完全","かんぜん"],["な"],["もの"],["と"],["は"],["認めない","みとめない"],["。"]]},{"verse":3,"text":"だから、どのように受け、また聞いたか思い起こして、それを守り抜き、かつ悔い改めよ。もし、目を覚ましていないなら、わたしは盗人のように行くであろう。わたしがいつあなたのところへ行くか、あなたには決して分からない。","tok":[["だ"],["から"],["、"],["どの"],["よう"],["に"],["受け","うけ"],["、"],["また"],["聞いた","きいた"],["か"],["思い起こして","おもいおこして"],["、"],["それ"],["を"],["守り","まもり"],["抜き","ぬき"],["、"],["かつ"],["悔い改め","くいあらため"],["よ"],["。"],["もし"],["、"],["目","め"],["を"],["覚まして","さまして"],["いないなら"],["、"],["わたし"],["は"],["盗人","ぬすびと"],["の"],["よう"],["に"],["行くで","いくで"],["あろう"],["。"],["わたし"],["が"],["いつ"],["あなた"],["の"],["ところ"],["へ"],["行く","いく"],["か"],["、"],["あなた"],["に"],["は"],["決して","けっして"],["分からない","わからない"],["。"]]},{"verse":4,"text":"しかし、サルディスには、少数ながら衣を汚さなかった者たちがいる。彼らは、白い衣を着てわたしと共に歩くであろう。そうするにふさわしい者たちだからである。","tok":[["しかし"],["、"],["サルディス"],["に"],["は"],["、"],["少数","しょうすう"],["ながら"],["衣","ころも"],["を"],["汚さなかった","よごさなかった"],["者","もの"],["たち"],["が"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["、"],["白い","しろい"],["衣","ころも"],["を"],["着て","きて"],["わたし"],["と"],["共","とも"],["に"],["歩くで","あるくで"],["あろう"],["。"],["そう"],["する"],["に"],["ふさわしい"],["者","もの"],["たち"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"勝利を得る者は、このように白い衣を着せられる。わたしは、彼の名を決して命の書から消すことはなく、彼の名を父の前と天使たちの前で公に言い表す。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["は"],["、"],["この"],["よう"],["に"],["白い","しろい"],["衣","ころも"],["を"],["着せられる","きせられる"],["。"],["わたし"],["は"],["、"],["彼","かれ"],["の"],["名","な"],["を"],["決して","けっして"],["命","いのち"],["の"],["書","しょ"],["から"],["消す","けす"],["こと"],["は"],["なく"],["、"],["彼","かれ"],["の"],["名","な"],["を"],["父","ちち"],["の"],["前","まえ"],["と"],["天使","てんし"],["たち"],["の"],["前","まえ"],["で"],["公","おおやけ"],["に"],["言い表す","いいあらわす"],["。"]]},{"verse":6,"text":"耳ある者は、“霊”が諸教会に告げることを聞くがよい。」』","tok":[["耳","みみ"],["ある"],["者","もの"],["は"],["、"],["“"],["霊","れい"],["”"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["告げる","つげる"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["。"],["」"],["』"]]},{"verse":7,"text":"フィラデルフィアにある教会の天使にこう書き送れ。『聖なる方、真実な方、ダビデの鍵を持つ方、この方が開けると、だれも閉じることなく、閉じると、だれも開けることがない。その方が次のように言われる。","tok":[["フィラデルフィア"],["に"],["ある"],["教会","きょうかい"],["の"],["天使","てんし"],["に"],["こう"],["書き送れ","かきおくれ"],["。"],["『"],["聖","せい"],["なる"],["方","かた"],["、"],["真実","しんじつ"],["な"],["方","かた"],["、"],["ダビデ"],["の"],["鍵","かぎ"],["を"],["持つ","もつ"],["方","かた"],["、"],["この"],["方","ほう"],["が"],["開ける","あける"],["と"],["、"],["だれ"],["も"],["閉じる","とじる"],["こと"],["なく"],["、"],["閉じる","とじる"],["と"],["、"],["だれ"],["も"],["開ける","あける"],["こと"],["が"],["ない"],["。"],["その"],["方","ほう"],["が"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"]]},{"verse":8,"text":"「わたしはあなたの行いを知っている。見よ、わたしはあなたの前に門を開いておいた。だれもこれを閉めることはできない。あなたは力が弱かったが、わたしの言葉を守り、わたしの名を知らないと言わなかった。","tok":[["「"],["わたし"],["は"],["あなた"],["の"],["行い","おこない"],["を"],["知って","しって"],["いる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["前","まえ"],["に"],["門","もん"],["を"],["開いて","ひらいて"],["おいた"],["。"],["だれ"],["も"],["これ"],["を"],["閉める","しめる"],["こと"],["は"],["できない"],["。"],["あなた"],["は"],["力","ちから"],["が"],["弱かった","よわかった"],["が"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["守り","まもり"],["、"],["わたし"],["の"],["名","な"],["を"],["知らない","しらない"],["と"],["言わなかった","いわなかった"],["。"]]},{"verse":9,"text":"見よ、サタンの集いに属して、自分はユダヤ人であると言う者たちには、こうしよう。実は、彼らはユダヤ人ではなく、偽っているのだ。見よ、彼らがあなたの足もとに来てひれ伏すようにし、わたしがあなたを愛していることを彼らに知らせよう。","tok":[["見よ","みよ"],["、"],["サタン"],["の"],["集い","つどい"],["に"],["属して","ぞくして"],["、"],["自分","じぶん"],["は"],["ユダヤ人","ゆだやじん"],["で"],["ある"],["と"],["言う","いう"],["者","もの"],["たち"],["に"],["は"],["、"],["こう"],["しよう"],["。"],["実","じつ"],["は"],["、"],["彼","かれ"],["ら"],["は"],["ユダヤ人","ゆだやじん"],["で"],["は"],["なく"],["、"],["偽って","いつわって"],["いる"],["の"],["だ"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["の"],["足もと","あしもと"],["に"],["来て","きて"],["ひれ伏す","ひれふす"],["よう"],["に"],["し"],["、"],["わたし"],["が"],["あなた"],["を"],["愛して","あいして"],["いる"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["知らせよう","しらせよう"],["。"]]},{"verse":10,"text":"あなたは忍耐についてのわたしの言葉を守った。それゆえ、地上に住む人々を試すため全世界に来ようとしている試練の時に、わたしもあなたを守ろう。","tok":[["あなた"],["は"],["忍耐","にんたい"],["について"],["の"],["わたし"],["の"],["言葉","ことば"],["を"],["守った","まもった"],["。"],["それ"],["ゆえ"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["人々","ひとびと"],["を"],["試す","ためす"],["ため"],["全","ぜん"],["世界","せかい"],["に"],["来よう","こよう"],["として"],["いる"],["試練","しれん"],["の"],["時","とき"],["に"],["、"],["わたし"],["も"],["あなた"],["を"],["守ろう","まもろう"],["。"]]},{"verse":11,"text":"わたしは、すぐに来る。あなたの栄冠をだれにも奪われないように、持っているものを固く守りなさい。","tok":[["わたし"],["は"],["、"],["すぐ"],["に"],["来る","くる"],["。"],["あなた"],["の"],["栄冠","えいかん"],["を"],["だれ"],["に"],["も"],["奪われない","うばわれない"],["よう"],["に"],["、"],["持って","もって"],["いる"],["もの"],["を"],["固く","かたく"],["守り","まもり"],["なさい"],["。"]]},{"verse":12,"text":"勝利を得る者を、わたしの神の神殿の柱にしよう。彼はもう決して外へ出ることはない。わたしはその者の上に、わたしの神の名と、わたしの神の都、すなわち、神のもとから出て天から下って来る新しいエルサレムの名、そして、わたしの新しい名を書き記そう。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["を"],["、"],["わたし"],["の"],["神","かみ"],["の"],["神殿","しんでん"],["の"],["柱","はしら"],["に"],["しよう"],["。"],["彼","かれ"],["は"],["もう"],["決して","けっして"],["外","そと"],["へ"],["出る","でる"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["その"],["者","もの"],["の"],["上","うえ"],["に"],["、"],["わたし"],["の"],["神","かみ"],["の"],["名","な"],["と"],["、"],["わたし"],["の"],["神","かみ"],["の"],["都","と"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["もと"],["から"],["出て","でて"],["天","てん"],["から"],["下って","くだって"],["来る","くる"],["新しい","あたらしい"],["エルサレム"],["の"],["名","な"],["、"],["そして"],["、"],["わたし"],["の"],["新しい","あたらしい"],["名","な"],["を"],["書き記そう","かきしるそう"],["。"]]},{"verse":13,"text":"耳ある者は、“霊”が諸教会に告げることを聞くがよい。」』","tok":[["耳","みみ"],["ある"],["者","もの"],["は"],["、"],["“"],["霊","れい"],["”"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["告げる","つげる"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["。"],["」"],["』"]]},{"verse":14,"text":"ラオディキアにある教会の天使にこう書き送れ。『アーメンである方、誠実で真実な証人、神に創造された万物の源である方が、次のように言われる。","tok":[["ラオディキア"],["に"],["ある"],["教会","きょうかい"],["の"],["天使","てんし"],["に"],["こう"],["書き送れ","かきおくれ"],["。"],["『"],["アーメン"],["で"],["ある"],["方","かた"],["、"],["誠実","せいじつ"],["で"],["真実","しんじつ"],["な"],["証人","しょうにん"],["、"],["神","かみ"],["に"],["創造","そうぞう"],["された"],["万物","ばんぶつ"],["の"],["源","みなもと"],["で"],["ある"],["方","かた"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"「わたしはあなたの行いを知っている。あなたは、冷たくもなく熱くもない。むしろ、冷たいか熱いか、どちらかであってほしい。","tok":[["「"],["わたし"],["は"],["あなた"],["の"],["行い","おこない"],["を"],["知って","しって"],["いる"],["。"],["あなた"],["は"],["、"],["冷たく","つめたく"],["も"],["なく"],["熱く","あつく"],["も"],["ない"],["。"],["むしろ"],["、"],["冷たい","つめたい"],["か"],["熱い","あつい"],["か"],["、"],["どちら"],["か"],["で"],["あって"],["ほしい"],["。"]]},{"verse":16,"text":"熱くも冷たくもなく、なまぬるいので、わたしはあなたを口から吐き出そうとしている。","tok":[["熱く","あつく"],["も"],["冷たく","つめたく"],["も"],["なく"],["、"],["なまぬるい"],["ので"],["、"],["わたし"],["は"],["あなた"],["を"],["口","くち"],["から"],["吐き出そう","はきだそう"],["として"],["いる"],["。"]]},{"verse":17,"text":"あなたは、『わたしは金持ちだ。満ち足りている。何一つ必要な物はない』と言っているが、自分が惨めな者、哀れな者、貧しい者、目の見えない者、裸の者であることが分かっていない。","tok":[["あなた"],["は"],["、"],["『"],["わたし"],["は"],["金持ち","かねもち"],["だ"],["。"],["満ち足りて","みちたりて"],["いる"],["。"],["何","なん"],["一","ひと"],["つ"],["必要","ひつよう"],["な"],["物","もの"],["は"],["ない"],["』"],["と"],["言って","いって"],["いる"],["が"],["、"],["自分","じぶん"],["が"],["惨め","みじめ"],["な"],["者","もの"],["、"],["哀れ","あわれ"],["な"],["者","もの"],["、"],["貧しい","まずしい"],["者","もの"],["、"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["、"],["裸","はだか"],["の"],["者","もの"],["で"],["ある"],["こと"],["が"],["分かって","わかって"],["いない"],["。"]]},{"verse":18,"text":"そこで、あなたに勧める。裕福になるように、火で精錬された金をわたしから買うがよい。裸の恥をさらさないように、身に着ける白い衣を買い、また、見えるようになるために、目に塗る薬を買うがよい。","tok":[["そこ"],["で"],["、"],["あなた"],["に"],["勧める","すすめる"],["。"],["裕福","ゆうふく"],["に"],["なる"],["よう"],["に"],["、"],["火","ひ"],["で"],["精錬","せいれん"],["された"],["金","かね"],["を"],["わたし"],["から"],["買う","かう"],["が"],["よい"],["。"],["裸","はだか"],["の"],["恥","はじ"],["を"],["さらさない"],["よう"],["に"],["、"],["身","み"],["に"],["着ける","つける"],["白い","しろい"],["衣","ころも"],["を"],["買い","かい"],["、"],["また"],["、"],["見える","みえる"],["よう"],["に"],["なる"],["ため"],["に"],["、"],["目","め"],["に"],["塗る","ぬる"],["薬","くすり"],["を"],["買う","かう"],["が"],["よい"],["。"]]},{"verse":19,"text":"わたしは愛する者を皆、叱ったり、鍛えたりする。だから、熱心に努めよ。悔い改めよ。","tok":[["わたし"],["は"],["愛する","あいする"],["者","もの"],["を"],["皆","みな"],["、"],["叱っ","しかっ"],["たり"],["、"],["鍛え","きたえ"],["たり"],["する"],["。"],["だ"],["から"],["、"],["熱心","ねっしん"],["に"],["努めよ","つとめよ"],["。"],["悔い改め","くいあらため"],["よ"],["。"]]},{"verse":20,"text":"見よ、わたしは戸口に立って、たたいている。だれかわたしの声を聞いて戸を開ける者があれば、わたしは中に入ってその者と共に食事をし、彼もまた、わたしと共に食事をするであろう。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["戸口","とぐち"],["に"],["立って","たって"],["、"],["たたいて"],["いる"],["。"],["だれ"],["か"],["わたし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["戸","と"],["を"],["開ける","あける"],["者","もの"],["が"],["あれば"],["、"],["わたし"],["は"],["中","なか"],["に"],["入って","はいって"],["その"],["者","もの"],["と"],["共","とも"],["に"],["食事","しょくじ"],["を"],["し"],["、"],["彼","かれ"],["も"],["また"],["、"],["わたし"],["と"],["共","とも"],["に"],["食事","しょくじ"],["を"],["するで"],["あろう"],["。"]]},{"verse":21,"text":"勝利を得る者を、わたしは自分の座に共に座らせよう。わたしが勝利を得て、わたしの父と共にその玉座に着いたのと同じように。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["を"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["座","ざ"],["に"],["共","とも"],["に"],["座らせよう","すわらせよう"],["。"],["わたし"],["が"],["勝利","しょうり"],["を"],["得て","えて"],["、"],["わたし"],["の"],["父","ちち"],["と"],["共","とも"],["に"],["その"],["玉座","ぎょくざ"],["に"],["着いた","ついた"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["。"]]},{"verse":22,"text":"耳ある者は、“霊”が諸教会に告げることを聞くがよい。」』」","tok":[["耳","みみ"],["ある"],["者","もの"],["は"],["、"],["“"],["霊","れい"],["”"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["告げる","つげる"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["。"],["」"],["』"],["」"]]}]
[{"verse":1,"text":"この後、わたしは大地の四隅に四人の天使が立っているのを見た。彼らは、大地の四隅から吹く風をしっかり押さえて、大地にも海にも、どんな木にも吹きつけないようにしていた。","tok":[["この"],["後","ご"],["、"],["わたし"],["は"],["大地","だいち"],["の"],["四隅","よすみ"],["に"],["四人","よんにん"],["の"],["天使","てんし"],["が"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["大地","だいち"],["の"],["四隅","よすみ"],["から"],["吹く","ふく"],["風","かぜ"],["を"],["しっかり"],["押さえて","おさえて"],["、"],["大地","だいち"],["に"],["も"],["海","うみ"],["に"],["も"],["、"],["どんな"],["木","き"],["に"],["も"],["吹きつけない","ふきつけない"],["よう"],["に"],["して"],["いた"],["。"]]},{"verse":2,"text":"わたしはまた、もう一人の天使が生ける神の刻印を持って、太陽の出る方角から上って来るのを見た。この天使は、大地と海とを損なうことを許されている四人の天使に、大声で呼びかけて、","tok":[["わたし"],["は"],["また"],["、"],["もう"],["一人","ひとり"],["の"],["天使","てんし"],["が"],["生ける","いける"],["神","かみ"],["の"],["刻印","こくいん"],["を"],["持って","もって"],["、"],["太陽","たいよう"],["の"],["出る","でる"],["方角","ほうがく"],["から"],["上って","のぼって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["この"],["天使","てんし"],["は"],["、"],["大地","だいち"],["と"],["海","うみ"],["と"],["を"],["損なう","そこなう"],["こと"],["を"],["許されて","ゆるされて"],["いる"],["四人","よんにん"],["の"],["天使","てんし"],["に"],["、"],["大声","おおごえ"],["で"],["呼びかけて","よびかけて"],["、"]]},{"verse":3,"text":"こう言った。「我々が、神の僕たちの額に刻印を押してしまうまでは、大地も海も木も損なってはならない。」","tok":[["こう"],["言った","いった"],["。"],["「"],["我々","われわれ"],["が"],["、"],["神","かみ"],["の"],["僕たち","ぼくたち"],["の"],["額","がく"],["に"],["刻印","こくいん"],["を"],["押して","おして"],["しまう"],["まで"],["は"],["、"],["大地","だいち"],["も"],["海","うみ"],["も"],["木","き"],["も"],["損なって","そこなって"],["は"],["ならない"],["。"],["」"]]},{"verse":4,"text":"わたしは、刻印を押された人々の数を聞いた。それは十四万四千人で、イスラエルの子らの全部族の中から、刻印を押されていた。","tok":[["わたし"],["は"],["、"],["刻印","こくいん"],["を"],["押された","おされた"],["人々","ひとびと"],["の"],["数","かず"],["を"],["聞いた","きいた"],["。"],["それ"],["は"],["十四万四千","じゅうよんまんよんせん"],["人","にん"],["で"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["全部族","ぜんぶぞく"],["の"],["中","なか"],["から"],["、"],["刻印","こくいん"],["を"],["押されて","おされて"],["いた"],["。"]]},{"verse":5,"text":"ユダ族の中から一万二千人が刻印を押され、ルベン族の中から一万二千人、ガド族の中から一万二千人、","tok":[["ユダ族","ゆだぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["が"],["刻印","こくいん"],["を"],["押され","おされ"],["、"],["ルベン族","るべんぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ガド族","がどぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":6,"text":"アシェル族の中から一万二千人、ナフタリ族の中から一万二千人、マナセ族の中から一万二千人、","tok":[["アシェル"],["族","ぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ナフタリ"],["族","ぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"],["マナセ族","まなせぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":7,"text":"シメオン族の中から一万二千人、レビ族の中から一万二千人、イサカル族の中から一万二千人、","tok":[["シメオン"],["族","ぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"],["レビ族","れびぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"],["イサカル"],["族","ぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":8,"text":"ゼブルン族の中から一万二千人、ヨセフ族の中から一万二千人、ベニヤミン族の中から一万二千人が刻印を押された。","tok":[["ゼブルン"],["族","ぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ヨセフ族","よせふぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ベニヤミン"],["族","ぞく"],["の"],["中","なか"],["から"],["一万二千","いちまんにせん"],["人","にん"],["が"],["刻印","こくいん"],["を"],["押された","おされた"],["。"]]},{"verse":9,"text":"この後、わたしが見ていると、見よ、あらゆる国民、種族、民族、言葉の違う民の中から集まった、だれにも数えきれないほどの大群衆が、白い衣を身に着け、手になつめやしの枝を持ち、玉座の前と小羊の前に立って、","tok":[["この"],["後","ご"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["あらゆる"],["国民","こくみん"],["、"],["種族","しゅぞく"],["、"],["民族","みんぞく"],["、"],["言葉","ことば"],["の"],["違う","ちがう"],["民","たみ"],["の"],["中","なか"],["から"],["集まった","あつまった"],["、"],["だれ"],["に"],["も"],["数え","かぞえ"],["きれない"],["ほど"],["の"],["大","だい"],["群衆","ぐんしゅう"],["が"],["、"],["白い","しろい"],["衣","ころも"],["を"],["身","み"],["に"],["着け","つけ"],["、"],["手","て"],["に"],["なつめやし"],["の"],["枝","えだ"],["を"],["持ち","もち"],["、"],["玉座","ぎょくざ"],["の"],["前","まえ"],["と"],["小羊","こひつじ"],["の"],["前","まえ"],["に"],["立って","たって"],["、"]]},{"verse":10,"text":"大声でこう叫んだ。「救いは、玉座に座っておられるわたしたちの神と、小羊とのものである。」","tok":[["大声","おおごえ"],["で"],["こう"],["叫んだ","さけんだ"],["。"],["「"],["救い","すくい"],["は"],["、"],["玉座","ぎょくざ"],["に"],["座って","すわって"],["おられる"],["わたしたち"],["の"],["神","かみ"],["と"],["、"],["小羊","こひつじ"],["と"],["の"],["もの"],["で"],["ある"],["。"],["」"]]},{"verse":11,"text":"また、天使たちは皆、玉座、長老たち、そして四つの生き物を囲んで立っていたが、玉座の前にひれ伏し、神を礼拝して、","tok":[["また"],["、"],["天使","てんし"],["たち"],["は"],["皆","みな"],["、"],["玉座","ぎょくざ"],["、"],["長老","ちょうろう"],["たち"],["、"],["そして"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["を"],["囲んで","かこんで"],["立って","たって"],["いた"],["が"],["、"],["玉座","ぎょくざ"],["の"],["前","まえ"],["に"],["ひれ伏し","ひれふし"],["、"],["神","かみ"],["を"],["礼拝","れいはい"],["して"],["、"]]},{"verse":12,"text":"こう言った。「アーメン。賛美、栄光、知恵、感謝、誉れ、力、威力が、世々限りなくわたしたちの神にありますように、アーメン。」","tok":[["こう"],["言った","いった"],["。"],["「"],["アーメン"],["。"],["賛美","さんび"],["、"],["栄光","えいこう"],["、"],["知恵","ちえ"],["、"],["感謝","かんしゃ"],["、"],["誉れ","ほまれ"],["、"],["力","ちから"],["、"],["威力","いりょく"],["が"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["わたしたち"],["の"],["神","かみ"],["に"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"],["」"]]},{"verse":13,"text":"すると、長老の一人がわたしに問いかけた。「この白い衣を着た者たちは、だれか。また、どこから来たのか。」","tok":[["する"],["と"],["、"],["長老","ちょうろう"],["の"],["一人","ひとり"],["が"],["わたし"],["に"],["問いかけた","といかけた"],["。"],["「"],["この"],["白い","しろい"],["衣","ころも"],["を"],["着た","きた"],["者","もの"],["たち"],["は"],["、"],["だれ"],["か"],["。"],["また"],["、"],["どこ"],["から"],["来た","きた"],["の"],["か"],["。"],["」"]]},{"verse":14,"text":"そこで、わたしが、「わたしの主よ、それはあなたの方がご存じです」と答えると、長老はまた、わたしに言った。「彼らは大きな苦難を通って来た者で、その衣を小羊の血で洗って白くしたのである。","tok":[["そこ"],["で"],["、"],["わたし"],["が"],["、"],["「"],["わたし"],["の"],["主","ぬし"],["よ"],["、"],["それ"],["は"],["あなた"],["の"],["方","ほう"],["が"],["ご存じ","ごぞんじ"],["です"],["」"],["と"],["答える","こたえる"],["と"],["、"],["長老","ちょうろう"],["は"],["また"],["、"],["わたし"],["に"],["言った","いった"],["。"],["「"],["彼","かれ"],["ら"],["は"],["大きな","おおきな"],["苦難","くなん"],["を"],["通って","とおって"],["来た","きた"],["者","もの"],["で"],["、"],["その"],["衣","ころも"],["を"],["小羊","こひつじ"],["の"],["血","ち"],["で"],["洗って","あらって"],["白く","しろく"],["した"],["ので"],["ある"],["。"]]},{"verse":15,"text":"それゆえ、彼らは神の玉座の前にいて、昼も夜もその神殿で神に仕える。玉座に座っておられる方が、この者たちの上に幕
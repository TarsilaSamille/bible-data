[{"verse":1,"text":"第五の天使がラッパを吹いた。すると、一つの星が天から地上へ落ちて来るのが見えた。この星に、底なしの淵に通じる穴を開く鍵が与えられ、","tok":[["第","だい"],["五","ご"],["の"],["天使","てんし"],["が"],["ラッパ"],["を"],["吹いた","ふいた"],["。"],["する"],["と"],["、"],["一","ひと"],["つ"],["の"],["星","ほし"],["が"],["天","てん"],["から"],["地上","ちじょう"],["へ"],["落ちて","おちて"],["来る","くる"],["の"],["が"],["見えた","みえた"],["。"],["この"],["星","ほし"],["に"],["、"],["底なし","そこなし"],["の"],["淵","ふち"],["に"],["通じる","つうじる"],["穴","あな"],["を"],["開く","ひらく"],["鍵","かぎ"],["が"],["与えられ","あたえられ"],["、"]]},{"verse":2,"text":"それが底なしの淵の穴を開くと、大きなかまどから出るような煙が穴から立ち上り、太陽も空も穴からの煙のために暗くなった。","tok":[["それ"],["が"],["底なし","そこなし"],["の"],["淵","ふち"],["の"],["穴","あな"],["を"],["開く","ひらく"],["と"],["、"],["大きな","おおきな"],["かまど"],["から"],["出る","でる"],["よう"],["な"],["煙","けむり"],["が"],["穴","あな"],["から"],["立ち上り","たちのぼり"],["、"],["太陽","たいよう"],["も"],["空","そら"],["も"],["穴","あな"],["から"],["の"],["煙","けむり"],["の"],["ため"],["に"],["暗く","くらく"],["なった"],["。"]]},{"verse":3,"text":"そして、煙の中から、いなごの群れが地上へ出て来た。このいなごには、地に住むさそりが持っているような力が与えられた。","tok":[["そして"],["、"],["煙","けむり"],["の"],["中","なか"],["から"],["、"],["いなご"],["の"],["群れ","むれ"],["が"],["地上","ちじょう"],["へ"],["出て","でて"],["来た","きた"],["。"],["この"],["いなご"],["に"],["は"],["、"],["地","ち"],["に"],["住む","すむ"],["さそり"],["が"],["持って","もって"],["いる"],["よう"],["な"],["力","ちから"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":4,"text":"いなごは、地の草やどんな青物も、またどんな木も損なってはならないが、ただ、額に神の刻印を押されていない人には害を加えてもよい、と言い渡された。","tok":[["いなご"],["は"],["、"],["地","ち"],["の"],["草","くさ"],["や"],["どんな"],["青物","あおもの"],["も"],["、"],["また"],["どんな"],["木","き"],["も"],["損なって","そこなって"],["は"],["ならない"],["が"],["、"],["ただ"],["、"],["額","がく"],["に"],["神","かみ"],["の"],["刻印","こくいん"],["を"],["押されて","おされて"],["いない"],["人","ひと"],["に"],["は"],["害","がい"],["を"],["加えて","くわえて"],["も"],["よい"],["、"],["と"],["言い渡された","いいわたされた"],["。"]]},{"verse":5,"text":"殺してはいけないが、五か月の間、苦しめることは許されたのである。いなごが与える苦痛は、さそりが人を刺したときの苦痛のようであった。","tok":[["殺して","ころして"],["は"],["いけない"],["が"],["、"],["五","ご"],["か月","かげつ"],["の"],["間","あいだ"],["、"],["苦しめる","くるしめる"],["こと"],["は"],["許された","ゆるされた"],["ので"],["ある"],["。"],["いなご"],["が"],["与える","あたえる"],["苦痛","くつう"],["は"],["、"],["さそり"],["が"],["人","ひと"],["を"],["刺した","さした"],["とき"],["の"],["苦痛","くつう"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":6,"text":"この人々は、その期間、死にたいと思っても死ぬことができず、切に死を望んでも、死の方が逃げて行く。","tok":[["この"],["人々","ひとびと"],["は"],["、"],["その"],["期間","きかん"],["、"],["死にたい","しにたい"],["と"],["思って","おもって"],["も"],["死ぬ","しぬ"],["こと"],["が"],["できず"],["、"],["切に","せつに"],["死","し"],["を"],["望んで","のぞんで"],["も"],["、"],["死","し"],["の"],["方","ほう"],["が"],["逃げて","にげて"],["行く","いく"],["。"]]},{"verse":7,"text":"さて、いなごの姿は、出陣の用意を整えた馬に似て、頭には金の冠に似たものを着け、顔は人間の顔のようであった。","tok":[["さて"],["、"],["いなご"],["の"],["姿","すがた"],["は"],["、"],["出陣","しゅつじん"],["の"],["用意","ようい"],["を"],["整えた","ととのえた"],["馬","うま"],["に"],["似て","にて"],["、"],["頭","あたま"],["に"],["は"],["金","きん"],["の"],["冠","かんむり"],["に"],["似た","にた"],["もの"],["を"],["着け","つけ"],["、"],["顔","かお"],["は"],["人間","にんげん"],["の"],["顔","かお"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":8,"text":"また、髪は女の髪のようで、歯は獅子の歯のようであった。","tok":[["また"],["、"],["髪","かみ"],["は"],["女","おんな"],["の"],["髪","かみ"],["の"],["よう"],["で"],["、"],["歯","は"],["は"],["獅子","しし"],["の"],["歯","は"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":9,"text":"また、胸には鉄の胸当てのようなものを着け、その羽の音は、多くの馬に引かれて戦場に急ぐ戦車の響きのようであった。","tok":[["また"],["、"],["胸","むね"],["に"],["は"],["鉄","てつ"],["の"],["胸当て","むねあて"],["の"],["よう"],["な"],["もの"],["を"],["着け","つけ"],["、"],["その"],["羽","はね"],["の"],["音","おと"],["は"],["、"],["多く","おおく"],["の"],["馬","うま"],["に"],["引かれて","ひかれて"],["戦場","せんじょう"],["に"],["急ぐ","いそぐ"],["戦車","せんしゃ"],["の"],["響き","ひびき"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":10,"text":"更に、さそりのように、尾と針があって、この尾には、五か月の間、人に害を加える力があった。","tok":[["更に","さらに"],["、"],["さそり"],["の"],["よう"],["に"],["、"],["尾","お"],["と"],["針","はり"],["が"],["あって"],["、"],["この"],["尾","お"],["に"],["は"],["、"],["五","ご"],["か月","かげつ"],["の"],["間","あいだ"],["、"],["人","ひと"],["に"],["害","がい"],["を"],["加える","くわえる"],["力","ちから"],["が"],["あった"],["。"]]},{"verse":11,"text":"いなごは、底なしの淵の使いを王としていただいている。その名は、ヘブライ語でアバドンといい、ギリシア語の名はアポリオンという。","tok":[["いなご"],["は"],["、"],["底なし","そこなし"],["の"],["淵","ふち"],["の"],["使い","つかい"],["を"],["王","おう"],["として"],["いただいて"],["いる"],["。"],["その"],["名","な"],["は"],["、"],["ヘブライ"],["語","ご"],["で"],["アバドン"],["と"],["いい"],["、"],["ギリシア"],["語","ご"],["の"],["名","な"],["は"],["アポリオン"],["と"],["いう"],["。"]]},{"verse":12,"text":"第一の災いが過ぎ去った。見よ、この後、更に二つの災いがやって来る。","tok":[["第","だい"],["一","いち"],["の"],["災い","わざわい"],["が"],["過ぎ去った","すぎさった"],["。"],["見よ","みよ"],["、"],["この"],["後","ご"],["、"],["更に","さらに"],["二","ふた"],["つ"],["の"],["災い","わざわい"],["が"],["やって"],["来る","くる"],["。"]]},{"verse":13,"text":"第六の天使がラッパを吹いた。すると、神の御前にある金の祭壇の四本の角から一つの声が聞こえた。","tok":[["第","だい"],["六","ろく"],["の"],["天使","てんし"],["が"],["ラッパ"],["を"],["吹いた","ふいた"],["。"],["する"],["と"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["ある"],["金","かね"],["の"],["祭壇","さいだん"],["の"],["四本","よんぽん"],["の"],["角","かど"],["から"],["一","ひと"],["つ"],["の"],["声","こえ"],["が"],["聞こえた","きこえた"],["。"]]},{"verse":14,"text":"その声は、ラッパを持っている第六の天使に向かってこう言った。「大きな川、ユーフラテスのほとりにつながれている四人の天使を放してやれ。」","tok":[["その"],["声","こえ"],["は"],["、"],["ラッパ"],["を"],["持って","もって"],["いる"],["第","だい"],["六","ろく"],["の"],["天使","てんし"],["に"],["向かって","むかって"],["こう"],["言った","いった"],["。"],["「"],["大きな","おおきな"],["川","かわ"],["、"],["ユーフラテス"],["の"],["ほとり"],["に"],["つながれて"],["いる"],["四人","よんにん"],["の"],["天使","てんし"],["を"],["放して","はなして"],["やれ"],["。"],["」"]]},{"verse":15,"text":"四人の天使は、人間の三分の一を殺すために解き放された。この天使たちは、その年、その月、その日、その時間のために用意されていたのである。","tok":[["四人","よんにん"],["の"],["天使","てんし"],["は"],["、"],["人間","にんげん"],["の"],["三分","さんぶん"],["の"],["一","いち"],["を"],["殺す","ころす"],["ため"],["に"],["解き放された","ときはなされた"],["。"],["この"],["天使","てんし"],["たち"],["は"],["、"],["その"],["年","とし"],["、"],["その"],["月","つき"],["、"],["その"],["日","ひ"],["、"],["その"],["時間","じかん"],["の"],["ため"],["に"],["用意","ようい"],["されて"],["いた"],["ので"],["ある"],["。"]]},{"verse":16,"text":"その騎兵の数は二億、わたしはその数を聞いた。","tok":[["その"],["騎兵","きへい"],["の"],["数","かず"],["は"],["二億","におく"],["、"],["わたし"],["は"],["その"],["数","かず"],["を"],["聞いた","きいた"],["。"]]},{"verse":17,"text":"わたしは幻の中で馬とそれに乗っている者たちを見たが、その様子はこうであった。彼らは、炎、紫、および硫黄の色の胸当てを着けており、馬の頭は獅子の頭のようで、口からは火と煙と硫黄とを吐いていた。","tok":[["わたし"],["は"],["幻","まぼろし"],["の"],["中","なか"],["で"],["馬","うま"],["と"],["それ"],["に"],["乗って","のって"],["いる"],["者","もの"],["たち"],["を"],["見た","みた"],["が"],["、"],["その"],["様子","ようす"],["は"],["こう"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["炎","ほのお"],["、"],["紫","むらさき"],["、"],["および"],["硫黄","いおう"],["の"],["色","いろ"],["の"],["胸当て","むねあて"],["を"],["着けて","つけて"],["おり"],["、"],["馬","うま"],["の"],["頭","あたま"],["は"],["獅子","しし"],["の"],["頭","あたま"],["の"],["よう"],["で"],["、"],["口","くち"],["から"],["は"],["火","ひ"],["と"],["煙","けむり"],["と"],["硫黄","いおう"],["と"],["を"],["吐いて","はいて"],["いた"],["。"]]},{"verse":18,"text":"その口から吐く火と煙と硫黄、この三つの災いで人間の三分の一が殺された。","tok":[["その"],["口","くち"],["から"],["吐く","はく"],["火","ひ"],["と"],["煙","けむり"],["と"],["硫黄","いおう"],["、"],["この"],["三","みっ"],["つ"],["の"],["災い","わざわい"],["で"],["人間","にんげん"],["の"],["三分","さんぶん"],["の"],["一","いち"],["が"],["殺された","ころされた"],["。"]]},{"verse":19,"text":"馬の力は口と尾にあって、尾は蛇に似て頭があり、この頭で害を加えるのである。","tok":[["馬","うま"],["の"],["力","ちから"],["は"],["口","くち"],["と"],["尾","お"],["に"],["あって"],["、"],["尾","お"],["は"],["蛇","へび"],["に"],["似て","にて"],["頭","あたま"],["が"],["あり"],["、"],["この"],["頭","あたま"],["で"],["害","がい"],["を"],["加える","くわえる"],["ので"],["ある"],["。"]]},{"verse":20,"text":"これらの災いに遭っても殺されずに残った人間は、自分の手で造ったものについて悔い改めず、なおも、悪霊どもや、金、銀、銅、石、木それぞれで造った偶像を礼拝することをやめなかった。このような偶像は、見ることも、聞くことも、歩くこともできないものである。","tok":[["これ"],["ら"],["の"],["災い","わざわい"],["に"],["遭って","あって"],["も"],["殺されず","ころされず"],["に"],["残った","のこった"],["人間","にんげん"],["は"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["造った","つくった"],["もの"],["について"],["悔い改めず","くいあらためず"],["、"],["なお"],["も"],["、"],["悪霊","あくりょう"],["ども"],["や"],["、"],["金","きん"],["、"],["銀","ぎん"],["、"],["銅","どう"],["、"],["石","いし"],["、"],["木","き"],["それぞれ"],["で"],["造った","つくった"],["偶像","ぐうぞう"],["を"],["礼拝","れいはい"],["する"],["こと"],["を"],["やめなかった"],["。"],["この"],["よう"],["な"],["偶像","ぐうぞう"],["は"],["、"],["見る","みる"],["こと"],["も"],["、"],["聞く","きく"],["こと"],["も"],["、"],["歩く","あるく"],["こと"],["も"],["できない"],["もの"],["で"],["ある"],["。"]]},{"verse":21,"text":"また彼らは人を殺すこと、まじない、みだらな行い、盗みを悔い改めなかった。","tok":[["また"],["彼","かれ"],["ら"],
[{"verse":1,"text":"さて、七つの鉢を持つ七人の天使の一人が来て、わたしに語りかけた。「ここへ来なさい。多くの水の上に座っている大淫婦に対する裁きを見せよう。","tok":[["さて"],["、"],["七","なな"],["つ"],["の"],["鉢","ばち"],["を"],["持つ","もつ"],["七人","ななにん"],["の"],["天使","てんし"],["の"],["一人","ひとり"],["が"],["来て","きて"],["、"],["わたし"],["に"],["語りかけた","かたりかけた"],["。"],["「"],["ここ"],["へ"],["来","き"],["なさい"],["。"],["多く","おおく"],["の"],["水","みず"],["の"],["上","うえ"],["に"],["座って","すわって"],["いる"],["大","だい"],["淫婦","いんぷ"],["に"],["対する","たいする"],["裁き","さばき"],["を"],["見せよう","みせよう"],["。"]]},{"verse":2,"text":"地上の王たちは、この女とみだらなことをし、地上に住む人々は、この女のみだらな行いのぶどう酒に酔ってしまった。」","tok":[["地上","ちじょう"],["の"],["王","おう"],["たち"],["は"],["、"],["この"],["女","おんな"],["と"],["みだら"],["な"],["こと"],["を"],["し"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["人々","ひとびと"],["は"],["、"],["この"],["女","おんな"],["の"],["みだら"],["な"],["行い","おこない"],["の"],["ぶどう酒","ぶどうしゅ"],["に"],["酔って","よって"],["しまった"],["。"],["」"]]},{"verse":3,"text":"そして、この天使は“霊”に満たされたわたしを荒れ野に連れて行った。わたしは、赤い獣にまたがっている一人の女を見た。この獣は、全身至るところ神を冒瀆する数々の名で覆われており、七つの頭と十本の角があった。","tok":[["そして"],["、"],["この"],["天使","てんし"],["は"],["“"],["霊","れい"],["”"],["に"],["満たされた","みたされた"],["わたし"],["を"],["荒れ野","あれの"],["に"],["連れて","つれて"],["行った","いった"],["。"],["わたし"],["は"],["、"],["赤い","あかい"],["獣","けもの"],["に"],["またがって"],["いる"],["一人","ひとり"],["の"],["女","おんな"],["を"],["見た","みた"],["。"],["この"],["獣","けもの"],["は"],["、"],["全身","ぜんしん"],["至る","いたる"],["ところ"],["神","かみ"],["を"],["冒瀆","ぼうとく"],["する"],["数々","かずかず"],["の"],["名","な"],["で"],["覆われて","おおわれて"],["おり"],["、"],["七","なな"],["つ"],["の"],["頭","あたま"],["と"],["十本","じゅうぽん"],["の"],["角","かど"],["が"],["あった"],["。"]]},{"verse":4,"text":"女は紫と赤の衣を着て、金と宝石と真珠で身を飾り、忌まわしいものや、自分のみだらな行いの汚れで満ちた金の杯を手に持っていた。","tok":[["女","おんな"],["は"],["紫","むらさき"],["と"],["赤","あか"],["の"],["衣","ころも"],["を"],["着て","きて"],["、"],["金","きん"],["と"],["宝石","ほうせき"],["と"],["真珠","しんじゅ"],["で"],["身","み"],["を"],["飾り","かざり"],["、"],["忌まわしい","いまわしい"],["もの"],["や"],["、"],["自分","じぶん"],["の"],["みだら"],["な"],["行い","おこない"],["の"],["汚れ","よごれ"],["で"],["満ちた","みちた"],["金","かね"],["の"],["杯","さかずき"],["を"],["手","て"],["に"],["持って","もって"],["いた"],["。"]]},{"verse":5,"text":"その額には、秘められた意味の名が記されていたが、それは、「大バビロン、みだらな女たちや、地上の忌まわしい者たちの母」という名である。","tok":[["その"],["額","がく"],["に"],["は"],["、"],["秘められた","ひめられた"],["意味","いみ"],["の"],["名","な"],["が"],["記されて","しるされて"],["いた"],["が"],["、"],["それ"],["は"],["、"],["「"],["大","だい"],["バビロン"],["、"],["みだら"],["な"],["女","おんな"],["たち"],["や"],["、"],["地上","ちじょう"],["の"],["忌まわしい","いまわしい"],["者","もの"],["たち"],["の"],["母","はは"],["」"],["と"],["いう"],["名","な"],["で"],["ある"],["。"]]},{"verse":6,"text":"わたしは、この女が聖なる者たちの血と、イエスの証人たちの血に酔いしれているのを見た。この女を見て、わたしは大いに驚いた。","tok":[["わたし"],["は"],["、"],["この"],["女","おんな"],["が"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["血","ち"],["と"],["、"],["イエス"],["の"],["証人","しょうにん"],["たち"],["の"],["血","ち"],["に"],["酔いしれて","よいしれて"],["いる"],["の"],["を"],["見た","みた"],["。"],["この"],["女","おんな"],["を"],["見て","みて"],["、"],["わたし"],["は"],["大いに","おおいに"],["驚いた","おどろいた"],["。"]]},{"verse":7,"text":"すると、天使がわたしにこう言った。「なぜ驚くのか。わたしは、この女の秘められた意味と、女を乗せた獣、七つの頭と十本の角がある獣の秘められた意味とを知らせよう。","tok":[["する"],["と"],["、"],["天使","てんし"],["が"],["わたし"],["に"],["こう"],["言った","いった"],["。"],["「"],["なぜ"],["驚く","おどろく"],["の"],["か"],["。"],["わたし"],["は"],["、"],["この"],["女","おんな"],["の"],["秘められた","ひめられた"],["意味","いみ"],["と"],["、"],["女","おんな"],["を"],["乗せた","のせた"],["獣","けもの"],["、"],["七","なな"],["つ"],["の"],["頭","あたま"],["と"],["十本","じゅうぽん"],["の"],["角","かど"],["が"],["ある"],["獣","けもの"],["の"],["秘められた","ひめられた"],["意味","いみ"],["と"],["を"],["知らせよう","しらせよう"],["。"]]},{"verse":8,"text":"あなたが見た獣は以前はいたが、今はいない。やがて底なしの淵から上って来るが、ついには滅びてしまう。地上に住む者で、天地創造の時から命の書にその名が記されていない者たちは、以前いて今はいないこの獣が、やがて来るのを見て驚くであろう。","tok":[["あなた"],["が"],["見た","みた"],["獣","けもの"],["は"],["以前","いぜん"],["は"],["いた"],["が"],["、"],["今","いま"],["は"],["いない"],["。"],["やがて"],["底なし","そこなし"],["の"],["淵","ふち"],["から"],["上って","のぼって"],["来る","くる"],["が"],["、"],["ついに"],["は"],["滅びて","ほろびて"],["しまう"],["。"],["地上","ちじょう"],["に"],["住む","すむ"],["者","もの"],["で"],["、"],["天地","てんち"],["創造","そうぞう"],["の"],["時","とき"],["から"],["命","いのち"],["の"],["書","しょ"],["に"],["その"],["名","な"],["が"],["記されて","しるされて"],["いない"],["者","もの"],["たち"],["は"],["、"],["以前","いぜん"],["いて"],["今","いま"],["は"],["いない"],["この"],["獣","けもの"],["が"],["、"],["やがて"],["来る","くる"],["の"],["を"],["見て","みて"],["驚くで","おどろくで"],["あろう"],["。"]]},{"verse":9,"text":"ここに、知恵のある考えが必要である。七つの頭とは、この女が座っている七つの丘のことである。そして、ここに七人の王がいる。","tok":[["ここ"],["に"],["、"],["知恵","ちえ"],["の"],["ある"],["考え","かんがえ"],["が"],["必要","ひつよう"],["で"],["ある"],["。"],["七","なな"],["つ"],["の"],["頭","あたま"],["と"],["は"],["、"],["この"],["女","おんな"],["が"],["座って","すわって"],["いる"],["七","なな"],["つ"],["の"],["丘","おか"],["の"],["こと"],["で"],["ある"],["。"],["そして"],["、"],["ここ"],["に"],["七人","しちにん"],["の"],["王","おう"],["が"],["いる"],["。"]]},{"verse":10,"text":"五人は既に倒れたが、一人は今王の位についている。他の一人は、まだ現れていないが、この王が現れても、位にとどまるのはごく短い期間だけである。","tok":[["五人","ごにん"],["は"],["既に","すでに"],["倒れた","たおれた"],["が"],["、"],["一人","ひとり"],["は"],["今","こん"],["王","おう"],["の"],["位","くらい"],["について"],["いる"],["。"],["他","ほか"],["の"],["一人","ひとり"],["は"],["、"],["まだ"],["現れて","あらわれて"],["いない"],["が"],["、"],["この"],["王","おう"],["が"],["現れて","あらわれて"],["も"],["、"],["位","くらい"],["に"],["とどまる"],["の"],["は"],["ごく"],["短い","みじかい"],["期間","きかん"],["だけ"],["で"],["ある"],["。"]]},{"verse":11,"text":"以前いて、今はいない獣は、第八の者で、またそれは先の七人の中の一人なのだが、やがて滅びる。","tok":[["以前","いぜん"],["いて"],["、"],["今","いま"],["は"],["いない"],["獣","けもの"],["は"],["、"],["第","だい"],["八","はち"],["の"],["者","もの"],["で"],["、"],["また"],["それ"],["は"],["先","さき"],["の"],["七人","しちにん"],["の"],["中","なか"],["の"],["一人","ひとり"],["な"],["の"],["だ"],["が"],["、"],["やがて"],["滅びる","ほろびる"],["。"]]},{"verse":12,"text":"また、あなたが見た十本の角は、十人の王である。彼らはまだ国を治めていないが、ひとときの間、獣と共に王の権威を受けるであろう。","tok":[["また"],["、"],["あなた"],["が"],["見た","みた"],["十本","じゅうぽん"],["の"],["角","かど"],["は"],["、"],["十人","じゅうにん"],["の"],["王","おう"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["まだ"],["国","くに"],["を"],["治めて","おさめて"],["いない"],["が"],["、"],["ひととき"],["の"],["間","あいだ"],["、"],["獣","けもの"],["と"],["共","とも"],["に"],["王","おう"],["の"],["権威","けんい"],["を"],["受けるで","うけるで"],["あろう"],["。"]]},{"verse":13,"text":"この者どもは、心を一つにしており、自分たちの力と権威を獣にゆだねる。","tok":[["この"],["者","もの"],["ども"],["は"],["、"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["して"],["おり"],["、"],["自分","じぶん"],["たち"],["の"],["力","ちから"],["と"],["権威","けんい"],["を"],["獣","けもの"],["に"],["ゆだねる"],["。"]]},{"verse":14,"text":"この者どもは小羊と戦うが、小羊は主の主、王の王だから、彼らに打ち勝つ。小羊と共にいる者、召された者、選ばれた者、忠実な者たちもまた、勝利を収める。」","tok":[["この"],["者","もの"],["ども"],["は"],["小羊","こひつじ"],["と"],["戦う","たたかう"],["が"],["、"],["小羊","こひつじ"],["は"],["主","ぬし"],["の"],["主","ぬし"],["、"],["王","おう"],["の"],["王","おう"],["だ"],["から"],["、"],["彼","かれ"],["ら"],["に"],["打ち勝つ","うちかつ"],["。"],["小羊","こひつじ"],["と"],["共","とも"],["に"],["いる"],["者","もの"],["、"],["召された","めされた"],["者","もの"],["、"],["選ばれた","えらばれた"],["者","もの"],["、"],["忠実","ちゅうじつ"],["な"],["者","もの"],["たち"],["も"],["また"],["、"],["勝利","しょうり"],["を"],["収める","おさめる"],["。"],["」"]]},{"verse":15,"text":"天使はまた、わたしに言った。「あなたが見た水、あの淫婦が座っている所は、さまざまの民族、群衆、国民、言葉の違う民である。","tok":[["天使","てんし"],["は"],["また"],["、"],["わたし"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["見た","みた"],["水","みず"],["、"],["あの"],["淫婦","いんぷ"],["が"],["座って","すわって"],["いる"],["所","ところ"],["は"],["、"],["さまざま"],["の"],["民族","みんぞく"],["、"],["群衆","ぐんしゅう"],["、"],["国民","こくみん"],["、"],["言葉","ことば"],["の"],["違う","ちがう"],["民","たみ"],["で"],["ある"],["。"]]},{"verse":16,"text":"また、あなたが見た十本の角とあの獣は、この淫婦を憎み、身に着けた物をはぎ取って裸にし、その肉を食い、火で焼き尽くすであろう。","tok":[["また"],["、"],["あなた"],["が"],["見た","みた"],["十本","じゅうぽん"],["の"],["角","かど"],["と"],["あの"],["獣","けもの"],["は"],["、"],["この"],["淫婦","いんぷ"],["を"],["憎み","にくみ"],["、"],["身","み"],["に"],["着けた","つけた"],["物","もの"],["を"],["はぎ取って","はぎとって"],["裸","はだか"],["に"],["し"],["、"],["その"],["肉","にく"],["を"],["食い","くい"],["、"],["火","ひ"],["で"],["焼き","やき"],["尽くすで","つくすで"],["あろう"],["。"]]},{"verse":17,"text":"神の言葉が成就するときまで、神は彼らの心を動かして御心を行わせ、彼らが心を一つにして、自分たちの支配権を獣に与えるようにされたからである。","tok":[["神","かみ"],["の"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["する"],["とき"],["まで"],["、"],["神","かみ"],["は"],["彼","かれ"],["ら"],["の"],["心","こころ"],["を"],["動かして","うごかして"],["御心","おこころ"],["を"],["行わせ","おこなわせ"],["、"],["彼","かれ"],["ら"],["が"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["して"],["、"],["自分","じぶん"],["たち"],["の"],["支配権","しはいけん"],["を"],["獣","けもの"],["に"],["与える","あたえる"],["よう"],["に"],["された"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"あなたが見た女とは、地上の王たちを支配しているあの大きな都のことである。」","tok":[["あなた"],["が"],["見た","みた"],["女","おんな"],["と"],["は"],["、"],["地上","ちじょう"],["の"],["王","おう"],["たち"],["を"],["支配","しはい"],["して"],["いる"],["あの"],["大きな","おおきな"],["都","と"],["の"],["こと"],["で"],["ある"],["。"],["」"]]}]
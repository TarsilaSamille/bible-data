[{"verse":1,"text":"またわたしは、玉座に座っておられる方の右の手に巻物があるのを見た。表にも裏にも字が書いてあり、七つの封印で封じられていた。","tok":[["また"],["わたし"],["は"],["、"],["玉座","ぎょくざ"],["に"],["座って","すわって"],["おられる"],["方","かた"],["の"],["右","みぎ"],["の"],["手","て"],["に"],["巻物","まきもの"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"],["表","ひょう"],["に"],["も"],["裏","うら"],["に"],["も"],["字","じ"],["が"],["書いて","かいて"],["あり"],["、"],["七","なな"],["つ"],["の"],["封印","ふういん"],["で"],["封じられて","ふうじられて"],["いた"],["。"]]},{"verse":2,"text":"また、一人の力強い天使が、「封印を解いて、この巻物を開くのにふさわしい者はだれか」と大声で告げるのを見た。","tok":[["また"],["、"],["一人","ひとり"],["の"],["力強い","ちからづよい"],["天使","てんし"],["が"],["、"],["「"],["封印","ふういん"],["を"],["解いて","といて"],["、"],["この"],["巻物","まきもの"],["を"],["開く","ひらく"],["のに"],["ふさわしい"],["者","もの"],["は"],["だれ"],["か"],["」"],["と"],["大声","おおごえ"],["で"],["告げる","つげる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":3,"text":"しかし、天にも地にも地の下にも、この巻物を開くことのできる者、見ることのできる者は、だれもいなかった。","tok":[["しかし"],["、"],["天","てん"],["に"],["も"],["地","ち"],["に"],["も"],["地","ち"],["の"],["下","した"],["に"],["も"],["、"],["この"],["巻物","まきもの"],["を"],["開く","ひらく"],["こと"],["の"],["できる"],["者","もの"],["、"],["見る","みる"],["こと"],["の"],["できる"],["者","もの"],["は"],["、"],["だれ"],["も"],["いなかった"],["。"]]},{"verse":4,"text":"この巻物を開くにも、見るにも、ふさわしい者がだれも見当たらなかったので、わたしは激しく泣いていた。","tok":[["この"],["巻物","まきもの"],["を"],["開く","ひらく"],["に"],["も"],["、"],["見る","みる"],["に"],["も"],["、"],["ふさわしい"],["者","もの"],["が"],["だれ"],["も"],["見当たらなかった","みあたらなかった"],["ので"],["、"],["わたし"],["は"],["激しく","はげしく"],["泣いて","ないて"],["いた"],["。"]]},{"verse":5,"text":"すると、長老の一人がわたしに言った。「泣くな。見よ。ユダ族から出た獅子、ダビデのひこばえが勝利を得たので、七つの封印を開いて、その巻物を開くことができる。」","tok":[["する"],["と"],["、"],["長老","ちょうろう"],["の"],["一人","ひとり"],["が"],["わたし"],["に"],["言った","いった"],["。"],["「"],["泣く","なく"],["な"],["。"],["見","み"],["よ"],["。"],["ユダ族","ゆだぞく"],["から"],["出た","でた"],["獅子","しし"],["、"],["ダビデ"],["の"],["ひこばえ"],["が"],["勝利","しょうり"],["を"],["得た","えた"],["ので"],["、"],["七","なな"],["つ"],["の"],["封印","ふういん"],["を"],["開いて","ひらいて"],["、"],["その"],["巻物","まきもの"],["を"],["開く","ひらく"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":6,"text":"わたしはまた、玉座と四つの生き物の間、長老たちの間に、屠られたような小羊が立っているのを見た。小羊には七つの角と七つの目があった。この七つの目は、全地に遣わされている神の七つの霊である。","tok":[["わたし"],["は"],["また"],["、"],["玉座","ぎょくざ"],["と"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["の"],["間","あいだ"],["、"],["長老","ちょうろう"],["たち"],["の"],["間","あいだ"],["に"],["、"],["屠られた","ほふられた"],["よう"],["な"],["小羊","こひつじ"],["が"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["小羊","こひつじ"],["に"],["は"],["七","なな"],["つ"],["の"],["角","かど"],["と"],["七","なな"],["つ"],["の"],["目","め"],["が"],["あった"],["。"],["この"],["七","なな"],["つ"],["の"],["目","め"],["は"],["、"],["全地","ぜんち"],["に"],["遣わされて","つかわされて"],["いる"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["で"],["ある"],["。"]]},{"verse":7,"text":"小羊は進み出て、玉座に座っておられる方の右の手から、巻物を受け取った。","tok":[["小羊","こひつじ"],["は"],["進み出て","すすみでて"],["、"],["玉座","ぎょくざ"],["に"],["座って","すわって"],["おられる"],["方","かた"],["の"],["右","みぎ"],["の"],["手","て"],["から"],["、"],["巻物","まきもの"],["を"],["受け取った","うけとった"],["。"]]},{"verse":8,"text":"巻物を受け取ったとき、四つの生き物と二十四人の長老は、おのおの、竪琴と、香のいっぱい入った金の鉢とを手に持って、小羊の前にひれ伏した。この香は聖なる者たちの祈りである。","tok":[["巻物","まきもの"],["を"],["受け取った","うけとった"],["とき"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["は"],["、"],["おのおの"],["、"],["竪琴","たてごと"],["と"],["、"],["香","こう"],["の"],["いっぱい"],["入った","はいった"],["金","かね"],["の"],["鉢","ばち"],["と"],["を"],["手","て"],["に"],["持って","もって"],["、"],["小羊","こひつじ"],["の"],["前","まえ"],["に"],["ひれ伏した","ひれふした"],["。"],["この"],["香","こう"],["は"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["祈り","いのり"],["で"],["ある"],["。"]]},{"verse":9,"text":"そして、彼らは新しい歌をうたった。「あなたは、巻物を受け取り、その封印を開くのにふさわしい方です。あなたは、屠られて、あらゆる種族と言葉の違う民、あらゆる民族と国民の中から、御自分の血で、神のために人々を贖われ、","tok":[["そして"],["、"],["彼","かれ"],["ら"],["は"],["新しい","あたらしい"],["歌","うた"],["を"],["うたった"],["。"],["「"],["あなた"],["は"],["、"],["巻物","まきもの"],["を"],["受け取り","うけとり"],["、"],["その"],["封印","ふういん"],["を"],["開く","ひらく"],["のに"],["ふさわしい"],["方","ほう"],["です"],["。"],["あなた"],["は"],["、"],["屠られて","ほふられて"],["、"],["あらゆる"],["種族","しゅぞく"],["と"],["言葉","ことば"],["の"],["違う","ちがう"],["民","たみ"],["、"],["あらゆる"],["民族","みんぞく"],["と"],["国民","こくみん"],["の"],["中","なか"],["から"],["、"],["御自分","ごじぶん"],["の"],["血","ち"],["で"],["、"],["神","かみ"],["の"],["ため"],["に"],["人々","ひとびと"],["を"],["贖われ","あがなわれ"],["、"]]},{"verse":10,"text":"彼らをわたしたちの神に仕える王、また、祭司となさったからです。彼らは地上を統治します。」","tok":[["彼","かれ"],["ら"],["を"],["わたしたち"],["の"],["神","かみ"],["に"],["仕える","つかえる"],["王","おう"],["、"],["また"],["、"],["祭司","さいし"],["と"],["なさった"],["から"],["です"],["。"],["彼","かれ"],["ら"],["は"],["地上","ちじょう"],["を"],["統治","とうち"],["します"],["。"],["」"]]},{"verse":11,"text":"また、わたしは見た。そして、玉座と生き物と長老たちとの周りに、多くの天使の声を聞いた。その数は万の数万倍、千の数千倍であった。","tok":[["また"],["、"],["わたし"],["は"],["見た","みた"],["。"],["そして"],["、"],["玉座","ぎょくざ"],["と"],["生き物","いきもの"],["と"],["長老","ちょうろう"],["たち"],["と"],["の"],["周り","まわり"],["に"],["、"],["多く","おおく"],["の"],["天使","てんし"],["の"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["その"],["数","すう"],["は"],["万","まん"],["の"],["数","すう"],["万","まん"],["倍","ばい"],["、"],["千","せん"],["の"],["数千","すうせん"],["倍","ばい"],["で"],["あった"],["。"]]},{"verse":12,"text":"天使たちは大声でこう言った。「屠られた小羊は、力、富、知恵、威力、誉れ、栄光、そして賛美を受けるにふさわしい方です。」","tok":[["天使","てんし"],["たち"],["は"],["大声","おおごえ"],["で"],["こう"],["言った","いった"],["。"],["「"],["屠られた","ほふられた"],["小羊","こひつじ"],["は"],["、"],["力","ちから"],["、"],["富","とみ"],["、"],["知恵","ちえ"],["、"],["威力","いりょく"],["、"],["誉れ","ほまれ"],["、"],["栄光","えいこう"],["、"],["そして"],["賛美","さんび"],["を"],["受ける","うける"],["に"],["ふさわしい"],["方","ほう"],["です"],["。"],["」"]]},{"verse":13,"text":"また、わたしは、天と地と地の下と海にいるすべての被造物、そして、そこにいるあらゆるものがこう言うのを聞いた。「玉座に座っておられる方と小羊とに、賛美、誉れ、栄光、そして権力が、世々限りなくありますように。」","tok":[["また"],["、"],["わたし"],["は"],["、"],["天","てん"],["と"],["地","ち"],["と"],["地","ち"],["の"],["下","した"],["と"],["海","うみ"],["に"],["いる"],["すべて"],["の"],["被","ひ"],["造物","ぞうぶつ"],["、"],["そして"],["、"],["そこ"],["に"],["いる"],["あらゆる"],["もの"],["が"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["玉座","ぎょくざ"],["に"],["座って","すわって"],["おられる"],["方","かた"],["と"],["小羊","こひつじ"],["と"],["に"],["、"],["賛美","さんび"],["、"],["誉れ","ほまれ"],["、"],["栄光","えいこう"],["、"],["そして"],["権力","けんりょく"],["が"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["あります"],["よう"],["に"],["。"],["」"]]},{"verse":14,"text":"四つの生き物は「アーメン」と言い、長老たちはひれ伏して礼拝した。","tok":[["四","よん"],["つ"],["の"],["生き物","いきもの"],["は"],["「"],["アーメン"],["」"],["と"],["言い","いい"],["、"],["長老","ちょうろう"],["たち"],["は"],["ひれ伏して","ひれふして"],["礼拝","れいはい"],["した"],["。"]]}]
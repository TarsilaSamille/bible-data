[{"verse":1,"text":"それから、わたしは杖のような物差しを与えられて、こう告げられた。「立って神の神殿と祭壇とを測り、また、そこで礼拝している者たちを数えよ。","tok":[["それ"],["から"],["、"],["わたし"],["は"],["杖","つえ"],["の"],["よう"],["な"],["物差し","ものさし"],["を"],["与えられて","あたえられて"],["、"],["こう"],["告げられた","つげられた"],["。"],["「"],["立って","たって"],["神","かみ"],["の"],["神殿","しんでん"],["と"],["祭壇","さいだん"],["と"],["を"],["測り","はかり"],["、"],["また"],["、"],["そこ"],["で"],["礼拝","れいはい"],["して"],["いる"],["者","もの"],["たち"],["を"],["数え","かぞえ"],["よ"],["。"]]},{"verse":2,"text":"しかし、神殿の外の庭はそのままにしておけ。測ってはいけない。そこは異邦人に与えられたからである。彼らは、四十二か月の間、この聖なる都を踏みにじるであろう。","tok":[["しかし"],["、"],["神殿","しんでん"],["の"],["外","そと"],["の"],["庭","にわ"],["は"],["そのまま"],["に"],["して"],["おけ"],["。"],["測って","はかって"],["は"],["いけない"],["。"],["そこ"],["は"],["異邦人","いほうじん"],["に"],["与えられた","あたえられた"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["四十二","よんじゅうに"],["か月","かげつ"],["の"],["間","あいだ"],["、"],["この"],["聖","せい"],["なる"],["都","と"],["を"],["踏みにじるで","ふみにじるで"],["あろう"],["。"]]},{"verse":3,"text":"わたしは、自分の二人の証人に粗布をまとわせ、千二百六十日の間、預言させよう。」","tok":[["わたし"],["は"],["、"],["自分","じぶん"],["の"],["二人","ふたり"],["の"],["証人","しょうにん"],["に"],["粗布","あらぬの"],["を"],["まとわせ"],["、"],["千二百六十","せんにひゃくろくとう"],["日","か"],["の"],["間","あいだ"],["、"],["預言","よげん"],["させよう"],["。"],["」"]]},{"verse":4,"text":"この二人の証人とは、地上の主の御前に立つ二本のオリーブの木、また二つの燭台である。","tok":[["この"],["二人","ふたり"],["の"],["証人","しょうにん"],["と"],["は"],["、"],["地上","ちじょう"],["の"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["立つ","たつ"],["二本","にぽん"],["の"],["オリーブ"],["の"],["木","き"],["、"],["また"],["二","ふた"],["つ"],["の"],["燭台","しょくだい"],["で"],["ある"],["。"]]},{"verse":5,"text":"この二人に害を加えようとする者があれば、彼らの口から火が出て、その敵を滅ぼすであろう。この二人に害を加えようとする者があれば、必ずこのように殺される。","tok":[["この"],["二人","ふたり"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["する"],["者","もの"],["が"],["あれば"],["、"],["彼","かれ"],["ら"],["の"],["口","くち"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["その"],["敵","てき"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"],["この"],["二人","ふたり"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["する"],["者","もの"],["が"],["あれば"],["、"],["必ず","かならず"],["この"],["よう"],["に"],["殺される","ころされる"],["。"]]},{"verse":6,"text":"彼らには、預言をしている間ずっと雨が降らないように天を閉じる力がある。また、水を血に変える力があって、望みのままに何度でも、あらゆる災いを地に及ぼすことができる。","tok":[["彼","かれ"],["ら"],["に"],["は"],["、"],["預言","よげん"],["を"],["して"],["いる"],["間","あいだ"],["ずっと"],["雨","あめ"],["が"],["降らない","ふらない"],["よう"],["に"],["天","てん"],["を"],["閉じる","とじる"],["力","ちから"],["が"],["ある"],["。"],["また"],["、"],["水","みず"],["を"],["血","ち"],["に"],["変える","かえる"],["力","ちから"],["が"],["あって"],["、"],["望み","のぞみ"],["の"],["まま"],["に"],["何度","なんど"],["で"],["も"],["、"],["あらゆる"],["災い","わざわい"],["を"],["地","ち"],["に"],["及ぼす","およぼす"],["こと"],["が"],["できる"],["。"]]},{"verse":7,"text":"二人がその証しを終えると、一匹の獣が、底なしの淵から上って来て彼らと戦って勝ち、二人を殺してしまう。","tok":[["二人","ふたり"],["が"],["その"],["証し","あかし"],["を"],["終える","おえる"],["と"],["、"],["一匹","いちひき"],["の"],["獣","けもの"],["が"],["、"],["底なし","そこなし"],["の"],["淵","ふち"],["から"],["上って","のぼって"],["来て","きて"],["彼","かれ"],["ら"],["と"],["戦って","たたかって"],["勝ち","かち"],["、"],["二人","ふたり"],["を"],["殺して","ころして"],["しまう"],["。"]]},{"verse":8,"text":"彼らの死体は、たとえてソドムとかエジプトとか呼ばれる大きな都の大通りに取り残される。この二人の証人の主も、その都で十字架につけられたのである。","tok":[["彼","かれ"],["ら"],["の"],["死体","したい"],["は"],["、"],["たとえて"],["ソドム"],["と"],["か"],["エジプト"],["と"],["か"],["呼ばれる","よばれる"],["大きな","おおきな"],["都","と"],["の"],["大通り","おおどおり"],["に"],["取り残される","とりのこされる"],["。"],["この"],["二人","ふたり"],["の"],["証人","しょうにん"],["の"],["主","ぬし"],["も"],["、"],["その"],["都","と"],["で"],["十字架","じゅうじか"],["に"],["つけられた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"さまざまの民族、種族、言葉の違う民、国民に属する人々は、三日半の間、彼らの死体を眺め、それを墓に葬ることは許さないであろう。","tok":[["さまざま"],["の"],["民族","みんぞく"],["、"],["種族","しゅぞく"],["、"],["言葉","ことば"],["の"],["違う","ちがう"],["民","たみ"],["、"],["国民","こくみん"],["に"],["属する","ぞくする"],["人々","ひとびと"],["は"],["、"],["三日","みっか"],["半","はん"],["の"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["の"],["死体","したい"],["を"],["眺め","ながめ"],["、"],["それ"],["を"],["墓","はか"],["に"],["葬る","ほうむる"],["こと"],["は"],["許さないで","ゆるさないで"],["あろう"],["。"]]},{"verse":10,"text":"地上の人々は、彼らのことで大いに喜び、贈り物をやり取りするであろう。この二人の預言者は、地上の人々を苦しめたからである。","tok":[["地上","ちじょう"],["の"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["ら"],["の"],["こと"],["で"],["大いに","おおいに"],["喜び","よろこび"],["、"],["贈り物","おくりもの"],["を"],["やり取り","やりとり"],["するで"],["あろう"],["。"],["この"],["二人","ふたり"],["の"],["預言者","よげんしゃ"],["は"],["、"],["地上","ちじょう"],["の"],["人々","ひとびと"],["を"],["苦しめた","くるしめた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"三日半たって、命の息が神から出て、この二人に入った。彼らが立ち上がると、これを見た人々は大いに恐れた。","tok":[["三日","みっか"],["半","はん"],["たって"],["、"],["命","いのち"],["の"],["息","いき"],["が"],["神","かみ"],["から"],["出て","でて"],["、"],["この"],["二人","ふたり"],["に"],["入った","はいった"],["。"],["彼","かれ"],["ら"],["が"],["立ち上がる","たちあがる"],["と"],["、"],["これ"],["を"],["見た","みた"],["人々","ひとびと"],["は"],["大いに","おおいに"],["恐れた","おそれた"],["。"]]},{"verse":12,"text":"二人は、天から大きな声があって、「ここに上って来い」と言うのを聞いた。そして雲に乗って天に上った。彼らの敵もそれを見た。","tok":[["二人","ふたり"],["は"],["、"],["天","てん"],["から"],["大きな","おおきな"],["声","こえ"],["が"],["あって"],["、"],["「"],["ここ"],["に"],["上って","のぼって"],["来い","こい"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["そして"],["雲","くも"],["に"],["乗って","のって"],["天","てん"],["に"],["上った","のぼった"],["。"],["彼","かれ"],["ら"],["の"],["敵","てき"],["も"],["それ"],["を"],["見た","みた"],["。"]]},{"verse":13,"text":"そのとき、大地震が起こり、都の十分の一が倒れ、この地震のために七千人が死に、残った人々は恐れを抱いて天の神の栄光をたたえた。","tok":[["その"],["とき"],["、"],["大地震","だいじしん"],["が"],["起こり","おこり"],["、"],["都","と"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["が"],["倒れ","たおれ"],["、"],["この"],["地震","じしん"],["の"],["ため"],["に"],["七千人","ななせんにん"],["が"],["死に","しに"],["、"],["残った","のこった"],["人々","ひとびと"],["は"],["恐れ","おそれ"],["を"],["抱いて","いだいて"],["天","てん"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["たたえた"],["。"]]},{"verse":14,"text":"第二の災いが過ぎ去った。見よ、第三の災いが速やかにやって来る。","tok":[["第","だい"],["二","に"],["の"],["災い","わざわい"],["が"],["過ぎ去った","すぎさった"],["。"],["見よ","みよ"],["、"],["第","だい"],["三","さん"],["の"],["災い","わざわい"],["が"],["速やか","すみやか"],["に"],["やって"],["来る","くる"],["。"]]},{"verse":15,"text":"さて、第七の天使がラッパを吹いた。すると、天にさまざまな大声があって、こう言った。「この世の国は、我らの主と、そのメシアのものとなった。主は世々限りなく統治される。」","tok":[["さて"],["、"],["第","だい"],["七","なな"],["の"],["天使","てんし"],["が"],["ラッパ"],["を"],["吹いた","ふいた"],["。"],["する"],["と"],["、"],["天","てん"],["に"],["さまざま"],["な"],["大声","おおごえ"],["が"],["あって"],["、"],["こう"],["言った","いった"],["。"],["「"],["この世","このよ"],["の"],["国","くに"],["は"],["、"],["我","われ"],["ら"],["の"],["主","ぬし"],["と"],["、"],["その"],["メシア"],["の"],["もの"],["と"],["なった"],["。"],["主","ぬし"],["は"],["世々","せいせい"],["限りなく","かぎりなく"],["統治","とうち"],["される"],["。"],["」"]]},{"verse":16,"text":"神の御前で、座に着いていた二十四人の長老は、ひれ伏して神を礼拝し、","tok":[["神","かみ"],["の"],["御前","ごぜん"],["で"],["、"],["座","ざ"],["に"],["着いて","ついて"],["いた"],["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["は"],["、"],["ひれ伏して","ひれふして"],["神","かみ"],["を"],["礼拝","れいはい"],["し"],["、"]]},{"verse":17,"text":"こう言った。「今おられ、かつておられた方、全能者である神、主よ、感謝いたします。大いなる力を振るって統治されたからです。","tok":[["こう"],["言った","いった"],["。"],["「"],["今","いま"],["おられ"],["、"],["かつて"],["おられた"],["方","かた"],["、"],["全能者","ぜんのうしゃ"],["で"],["ある"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["感謝","かんしゃ"],["いたします"],["。"],["大いなる","おおいなる"],["力","ちから"],["を"],["振るって","ふるって"],["統治","とうち"],["された"],["から"],["です"],["。"]]},{"verse":18,"text":"異邦人たちは怒り狂い、あなたも怒りを現された。死者の裁かれる時が来ました。あなたの僕、預言者、聖なる者、御名を畏れる者には、小さな者にも大きな者にも報いをお与えになり、地を滅ぼす者どもを滅ぼされる時が来ました。」","tok":[["異邦人","いほうじん"],["たち"],["は"],["怒り狂い","いかりくるい"],["、"],["あなた"],["も"],["怒り","いかり"],["を"],["現された","あらわされた"],["。"],["死者","ししゃ"],["の"],["裁かれる","さばかれる"],["時","とき"],["が"],["来ました","きました"],["。"],["あなた"],["の"],["僕","ぼく"],["、"],["預言者","よげんしゃ"],["、"],["聖","せい"],["なる"],["者","もの"],["、"],["御名","ぎょめい"],["を"],["畏れる","おそれる"],["者","もの"],["に"],["は"],["、"],["小さな","ちいさな"],["者","もの"],["に"],["も"],["大きな","おおきな"],["者","もの"],["に"],["も"],["報い","むくい"],["を"],["お与え","おあたえ"],["に"],["なり"],["、"],["地","ち"],["を"],["滅ぼす","ほろぼす"],["者","もの"],["ども"],["を"],["滅ぼされる","ほろぼされる"],["時","とき"],["が"],["来ました","きました"],["。"],["」"]]},{"verse":19,"text":"そして、天にある神の神殿が開かれて、その神殿の中にある契約の箱が見え、稲妻、さまざまな音、雷、地震が起こり、大粒の雹が降った。","tok":[["そして"],["、"],["天","てん"],["に"],["ある"],["神","かみ"],["の"],["神殿","しんでん"],["が"],["開かれて","ひらかれて"],["、"],["その"],["神殿","しんでん"],["の"],["中","なか"],["に"],["ある"],["契約","けいやく"],["の"],["箱","ばこ"],["が"],["見え","みえ"],["、"],["稲妻","いなずま"],["、"],["さまざま"],["な"],["音","おと"],["、"],["雷","かみなり"],["、"],["地震","じしん"],["が"],["起こり","おこり"],["、"],["大粒","おおつぶ"],["の"],["雹","ひょう"],["が"],["降った","ふった"],["。"]]}]
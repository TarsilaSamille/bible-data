[{"verse":1,"text":"わたしはまた、もう一人の力強い天使が、雲を身にまとい、天から降って来るのを見た。頭には虹をいただき、顔は太陽のようで、足は火の柱のようであり、","tok":[["わたし"],["は"],["また"],["、"],["もう"],["一人","ひとり"],["の"],["力強い","ちからづよい"],["天使","てんし"],["が"],["、"],["雲","くも"],["を"],["身","み"],["に"],["まとい"],["、"],["天","てん"],["から"],["降って","ふって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["頭","あたま"],["に"],["は"],["虹","にじ"],["を"],["いただき"],["、"],["顔","かお"],["は"],["太陽","たいよう"],["の"],["よう"],["で"],["、"],["足","あし"],["は"],["火","ひ"],["の"],["柱","はしら"],["の"],["よう"],["で"],["あり"],["、"]]},{"verse":2,"text":"手には開いた小さな巻物を持っていた。そして、右足で海を、左足で地を踏まえて、","tok":[["手","て"],["に"],["は"],["開いた","ひらいた"],["小さな","ちいさな"],["巻物","まきもの"],["を"],["持って","もって"],["いた"],["。"],["そして"],["、"],["右足","みぎあし"],["で"],["海","うみ"],["を"],["、"],["左足","ひだりあし"],["で"],["地","ち"],["を"],["踏まえて","ふまえて"],["、"]]},{"verse":3,"text":"獅子がほえるような大声で叫んだ。天使が叫んだとき、七つの雷がそれぞれの声で語った。","tok":[["獅子","しし"],["が"],["ほえる"],["よう"],["な"],["大声","おおごえ"],["で"],["叫んだ","さけんだ"],["。"],["天使","てんし"],["が"],["叫んだ","さけんだ"],["とき"],["、"],["七","なな"],["つ"],["の"],["雷","かみなり"],["が"],["それぞれ"],["の"],["声","こえ"],["で"],["語った","かたった"],["。"]]},{"verse":4,"text":"七つの雷が語ったとき、わたしは書き留めようとした。すると、天から声があって、「七つの雷が語ったことは秘めておけ。それを書き留めてはいけない」と言うのが聞こえた。","tok":[["七","なな"],["つ"],["の"],["雷","かみなり"],["が"],["語った","かたった"],["とき"],["、"],["わたし"],["は"],["書き留めよう","かきとめよう"],["と"],["した"],["。"],["する"],["と"],["、"],["天","てん"],["から"],["声","こえ"],["が"],["あって"],["、"],["「"],["七","なな"],["つ"],["の"],["雷","かみなり"],["が"],["語った","かたった"],["こと"],["は"],["秘めて","ひめて"],["おけ"],["。"],["それ"],["を"],["書き留めて","かきとめて"],["は"],["いけない"],["」"],["と"],["言う","いう"],["の"],["が"],["聞こえた","きこえた"],["。"]]},{"verse":5,"text":"すると、海と地の上に立つのをわたしが見たあの天使が、右手を天に上げ、","tok":[["する"],["と"],["、"],["海","うみ"],["と"],["地","ち"],["の"],["上","うえ"],["に"],["立つ","たつ"],["の"],["を"],["わたし"],["が"],["見た","みた"],["あの"],["天使","てんし"],["が"],["、"],["右手","みぎて"],["を"],["天","てん"],["に"],["上げ","あげ"],["、"]]},{"verse":6,"text":"世々限りなく生きておられる方にかけて誓った。すなわち、天とその中にあるもの、地とその中にあるもの、海とその中にあるものを創造された方にかけてこう誓った。「もはや時がない。","tok":[["世々","せいせい"],["限りなく","かぎりなく"],["生きて","いきて"],["おられる"],["方","かた"],["に"],["かけて"],["誓った","ちかった"],["。"],["すなわち"],["、"],["天","てん"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["、"],["地","ち"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["、"],["海","うみ"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["を"],["創造","そうぞう"],["された"],["方","ほう"],["に"],["かけて"],["こう"],["誓った","ちかった"],["。"],["「"],["もはや"],["時","とき"],["が"],["ない"],["。"]]},{"verse":7,"text":"第七の天使がラッパを吹くとき、神の秘められた計画が成就する。それは、神が御自分の僕である預言者たちに良い知らせとして告げられたとおりである。」","tok":[["第","だい"],["七","なな"],["の"],["天使","てんし"],["が"],["ラッパ"],["を"],["吹く","ふく"],["とき"],["、"],["神","かみ"],["の"],["秘められた","ひめられた"],["計画","けいかく"],["が"],["成就","じょうじゅ"],["する"],["。"],["それ"],["は"],["、"],["神","かみ"],["が"],["御自分","ごじぶん"],["の"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["に"],["良い","よい"],["知らせ","しらせ"],["として"],["告げられた","つげられた"],["とおり"],["で"],["ある"],["。"],["」"]]},{"verse":8,"text":"すると、天から聞こえたあの声が、再びわたしに語りかけて、こう言った。「さあ行って、海と地の上に立っている天使の手にある、開かれた巻物を受け取れ。」","tok":[["する"],["と"],["、"],["天","てん"],["から"],["聞こえた","きこえた"],["あの"],["声","こえ"],["が"],["、"],["再び","ふたたび"],["わたし"],["に"],["語りかけて","かたりかけて"],["、"],["こう"],["言った","いった"],["。"],["「"],["さあ"],["行って","いって"],["、"],["海","うみ"],["と"],["地","ち"],["の"],["上","うえ"],["に"],["立って","たって"],["いる"],["天使","てんし"],["の"],["手","て"],["に"],["ある"],["、"],["開かれた","ひらかれた"],["巻物","まきもの"],["を"],["受け取れ","うけとれ"],["。"],["」"]]},{"verse":9,"text":"そこで、天使のところへ行き、「その小さな巻物をください」と言った。すると、天使はわたしに言った。「受け取って、食べてしまえ。それは、あなたの腹には苦いが、口には蜜のように甘い。」","tok":[["そこ"],["で"],["、"],["天使","てんし"],["の"],["ところ"],["へ"],["行き","いき"],["、"],["「"],["その"],["小さな","ちいさな"],["巻物","まきもの"],["を"],["ください"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["、"],["天使","てんし"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["受け取って","うけとって"],["、"],["食べて","たべて"],["しまえ"],["。"],["それ"],["は"],["、"],["あなた"],["の"],["腹","はら"],["に"],["は"],["苦い","にがい"],["が"],["、"],["口","くち"],["に"],["は"],["蜜","みつ"],["の"],["よう"],["に"],["甘い","あまい"],["。"],["」"]]},{"verse":10,"text":"わたしは、その小さな巻物を天使の手から受け取って、食べてしまった。それは、口には蜜のように甘かったが、食べると、わたしの腹は苦くなった。","tok":[["わたし"],["は"],["、"],["その"],["小さな","ちいさな"],["巻物","まきもの"],["を"],["天使","てんし"],["の"],["手","て"],["から"],["受け取って","うけとって"],["、"],["食べて","たべて"],["しまった"],["。"],["それ"],["は"],["、"],["口","くち"],["に"],["は"],["蜜","みつ"],["の"],["よう"],["に"],["甘かった","あまかった"],["が"],["、"],["食べる","たべる"],["と"],["、"],["わたし"],["の"],["腹","はら"],["は"],["苦く","にがく"],["なった"],["。"]]},{"verse":11,"text":"すると、わたしにこう語りかける声が聞こえた。「あなたは、多くの民族、国民、言葉の違う民、また、王たちについて、再び預言しなければならない。」","tok":[["する"],["と"],["、"],["わたし"],["に"],["こう"],["語りかける","かたりかける"],["声","こえ"],["が"],["聞こえた","きこえた"],["。"],["「"],["あなた"],["は"],["、"],["多く","おおく"],["の"],["民族","みんぞく"],["、"],["国民","こくみん"],["、"],["言葉","ことば"],["の"],["違う","ちがう"],["民","たみ"],["、"],["また"],["、"],["王","おう"],["たち"],["について"],["、"],["再び","ふたたび"],["預言","よげん"],["しなければ"],["ならない"],["。"],["」"]]}]
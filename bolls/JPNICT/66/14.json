[{"verse":1,"text":"また、わたしが見ていると、見よ、小羊がシオンの山に立っており、小羊と共に十四万四千人の者たちがいて、その額には小羊の名と、小羊の父の名とが記されていた。","tok":[["また"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["小羊","こひつじ"],["が"],["シオン"],["の"],["山","やま"],["に"],["立って","たって"],["おり"],["、"],["小羊","こひつじ"],["と"],["共","とも"],["に"],["十四万四千","じゅうよんまんよんせん"],["人","にん"],["の"],["者","もの"],["たち"],["が"],["いて"],["、"],["その"],["額","がく"],["に"],["は"],["小羊","こひつじ"],["の"],["名","な"],["と"],["、"],["小羊","こひつじ"],["の"],["父","ちち"],["の"],["名","な"],["と"],["が"],["記されて","しるされて"],["いた"],["。"]]},{"verse":2,"text":"わたしは、大水のとどろくような音、また激しい雷のような音が天から響くのを聞いた。わたしが聞いたその音は、琴を弾く者たちが竪琴を弾いているようであった。","tok":[["わたし"],["は"],["、"],["大水","おおみず"],["の"],["とどろく"],["よう"],["な"],["音","おと"],["、"],["また"],["激しい","はげしい"],["雷","かみなり"],["の"],["よう"],["な"],["音","おと"],["が"],["天","てん"],["から"],["響く","ひびく"],["の"],["を"],["聞いた","きいた"],["。"],["わたし"],["が"],["聞いた","きいた"],["その"],["音","おと"],["は"],["、"],["琴","こと"],["を"],["弾く","ひく"],["者","もの"],["たち"],["が"],["竪琴","たてごと"],["を"],["弾いて","ひいて"],["いる"],["よう"],["で"],["あった"],["。"]]},{"verse":3,"text":"彼らは、玉座の前、また四つの生き物と長老たちの前で、新しい歌のたぐいをうたった。この歌は、地上から贖われた十四万四千人の者たちのほかは、覚えることができなかった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["玉座","ぎょくざ"],["の"],["前","まえ"],["、"],["また"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["長老","ちょうろう"],["たち"],["の"],["前","まえ"],["で"],["、"],["新しい","あたらしい"],["歌","うた"],["の"],["たぐい"],["を"],["うたった"],["。"],["この"],["歌","うた"],["は"],["、"],["地上","ちじょう"],["から"],["贖われた","あがなわれた"],["十四万四千","じゅうよんまんよんせん"],["人","にん"],["の"],["者","もの"],["たち"],["の"],["ほか"],["は"],["、"],["覚える","おぼえる"],["こと"],["が"],["できなかった"],["。"]]},{"verse":4,"text":"彼らは、女に触れて身を汚したことのない者である。彼らは童貞だからである。この者たちは、小羊の行くところへは、どこへでも従って行く。この者たちは、神と小羊に献げられる初穂として、人々の中から贖われた者たちで、","tok":[["彼","かれ"],["ら"],["は"],["、"],["女","おんな"],["に"],["触れて","ふれて"],["身","み"],["を"],["汚した","よごした"],["こと"],["の"],["ない"],["者","もの"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["童貞","どうてい"],["だ"],["から"],["で"],["ある"],["。"],["この"],["者","もの"],["たち"],["は"],["、"],["小羊","こひつじ"],["の"],["行く","いく"],["ところ"],["へ"],["は"],["、"],["どこ"],["へ"],["で"],["も"],["従って","したがって"],["行く","いく"],["。"],["この"],["者","もの"],["たち"],["は"],["、"],["神","かみ"],["と"],["小羊","こひつじ"],["に"],["献げられる","ささげられる"],["初穂","はつほ"],["として"],["、"],["人々","ひとびと"],["の"],["中","なか"],["から"],["贖われた","あがなわれた"],["者","もの"],["たち"],["で"],["、"]]},{"verse":5,"text":"その口には偽りがなく、とがめられるところのない者たちである。","tok":[["その"],["口","くち"],["に"],["は"],["偽り","いつわり"],["が"],["なく"],["、"],["とがめられる"],["ところ"],["の"],["ない"],["者","もの"],["たち"],["で"],["ある"],["。"]]},{"verse":6,"text":"わたしはまた、別の天使が空高く飛ぶのを見た。この天使は、地上に住む人々、あらゆる国民、種族、言葉の違う民、民族に告げ知らせるために、永遠の福音を携えて来て、","tok":[["わたし"],["は"],["また"],["、"],["別","べつ"],["の"],["天使","てんし"],["が"],["空","そら"],["高く","たかく"],["飛ぶ","とぶ"],["の"],["を"],["見た","みた"],["。"],["この"],["天使","てんし"],["は"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["人々","ひとびと"],["、"],["あらゆる"],["国民","こくみん"],["、"],["種族","しゅぞく"],["、"],["言葉","ことば"],["の"],["違う","ちがう"],["民","たみ"],["、"],["民族","みんぞく"],["に"],["告げ知らせる","つげしらせる"],["ため"],["に"],["、"],["永遠","えいえん"],["の"],["福音","ふくいん"],["を"],["携えて","たずさえて"],["来て","きて"],["、"]]},{"verse":7,"text":"大声で言った。「神を畏れ、その栄光をたたえなさい。神の裁きの時が来たからである。天と地、海と水の源を創造した方を礼拝しなさい。」","tok":[["大声","おおごえ"],["で"],["言った","いった"],["。"],["「"],["神","かみ"],["を"],["畏れ","おそれ"],["、"],["その"],["栄光","えいこう"],["を"],["たたえ"],["なさい"],["。"],["神","かみ"],["の"],["裁き","さばき"],["の"],["時","とき"],["が"],["来た","きた"],["から"],["で"],["ある"],["。"],["天","てん"],["と"],["地","ち"],["、"],["海","うみ"],["と"],["水","みず"],["の"],["源","みなもと"],["を"],["創造","そうぞう"],["した"],["方","ほう"],["を"],["礼拝","れいはい"],["し"],["なさい"],["。"],["」"]]},{"verse":8,"text":"また、別の第二の天使が続いて来て、こう言った。「倒れた。大バビロンが倒れた。怒りを招くみだらな行いのぶどう酒を、諸国の民に飲ませたこの都が。」","tok":[["また"],["、"],["別","べつ"],["の"],["第","だい"],["二","に"],["の"],["天使","てんし"],["が"],["続いて","つづいて"],["来て","きて"],["、"],["こう"],["言った","いった"],["。"],["「"],["倒れた","たおれた"],["。"],["大","だい"],["バビロン"],["が"],["倒れた","たおれた"],["。"],["怒り","いかり"],["を"],["招く","まねく"],["みだら"],["な"],["行い","おこない"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["飲ませた","のませた"],["この"],["都","と"],["が"],["。"],["」"]]},{"verse":9,"text":"また、別の第三の天使も続いて来て、大声でこう言った。「だれでも、獣とその像を拝み、額や手にこの獣の刻印を受ける者があれば、","tok":[["また"],["、"],["別","べつ"],["の"],["第","だい"],["三","さん"],["の"],["天使","てんし"],["も"],["続いて","つづいて"],["来て","きて"],["、"],["大声","おおごえ"],["で"],["こう"],["言った","いった"],["。"],["「"],["だれ"],["で"],["も"],["、"],["獣","けもの"],["と"],["その"],["像","ぞう"],["を"],["拝み","おがみ"],["、"],["額","がく"],["や"],["手","て"],["に"],["この"],["獣","けもの"],["の"],["刻印","こくいん"],["を"],["受ける","うける"],["者","もの"],["が"],["あれば"],["、"]]},{"verse":10,"text":"その者自身も、神の怒りの杯に混ぜものなしに注がれた、神の怒りのぶどう酒を飲むことになり、また、聖なる天使たちと小羊の前で、火と硫黄で苦しめられることになる。","tok":[["その"],["者","もの"],["自身","じしん"],["も"],["、"],["神","かみ"],["の"],["怒り","いかり"],["の"],["杯","さかずき"],["に"],["混ぜもの","まぜもの"],["なし"],["に"],["注がれた","そそがれた"],["、"],["神","かみ"],["の"],["怒り","いかり"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["飲む","のむ"],["こと"],["に"],["なり"],["、"],["また"],["、"],["聖","せい"],["なる"],["天使","てんし"],["たち"],["と"],["小羊","こひつじ"],["の"],["前","まえ"],["で"],["、"],["火","ひ"],["と"],["硫黄","いおう"],["で"],["苦しめられる","くるしめられる"],["こと"],["に"],["なる"],["。"]]},{"verse":11,"text":"その苦しみの煙は、世々限りなく立ち上り、獣とその像を拝む者たち、また、だれでも獣の名の刻印を受ける者は、昼も夜も安らぐことはない。」","tok":[["その"],["苦しみ","くるしみ"],["の"],["煙","けむり"],["は"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["立ち上り","たちのぼり"],["、"],["獣","けもの"],["と"],["その"],["像","ぞう"],["を"],["拝む","おがむ"],["者","もの"],["たち"],["、"],["また"],["、"],["だれ"],["で"],["も"],["獣","けもの"],["の"],["名","な"],["の"],["刻印","こくいん"],["を"],["受ける","うける"],["者","もの"],["は"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["安らぐ","やすらぐ"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":12,"text":"ここに、神の掟を守り、イエスに対する信仰を守り続ける聖なる者たちの忍耐が必要である。","tok":[["ここ"],["に"],["、"],["神","かみ"],["の"],["掟","おきて"],["を"],["守り","まもり"],["、"],["イエス"],["に"],["対する","たいする"],["信仰","しんこう"],["を"],["守り","まもり"],["続ける","つづける"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["忍耐","にんたい"],["が"],["必要","ひつよう"],["で"],["ある"],["。"]]},{"verse":13,"text":"また、わたしは天からこう告げる声を聞いた。「書き記せ。『今から後、主に結ばれて死ぬ人は幸いである』と。」“霊”も言う。「然り。彼らは労苦を解かれて、安らぎを得る。その行いが報われるからである。」","tok":[["また"],["、"],["わたし"],["は"],["天","てん"],["から"],["こう"],["告げる","つげる"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["「"],["書き記せ","かきしるせ"],["。"],["『"],["今","いま"],["から"],["後","あと"],["、"],["主に","おもに"],["結ばれて","むすばれて"],["死ぬ","しぬ"],["人","ひと"],["は"],["幸い","さいわい"],["で"],["ある"],["』"],["と"],["。"],["」"],["“"],["霊","れい"],["”"],["も"],["言う","ゆう"],["。"],["「"],["然り","しかり"],["。"],["彼","かれ"],["ら"],["は"],["労苦","ろうく"],["を"],["解かれて","とかれて"],["、"],["安らぎ","やすらぎ"],["を"],["得る","うる"],["。"],["その"],["行い","おこない"],["が"],["報われる","むくわれる"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":14,"text":"また、わたしが見ていると、見よ、白い雲が現れて、人の子のような方がその雲の上に座っており、頭には金の冠をかぶり、手には鋭い鎌を持っておられた。","tok":[["また"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["白い","しろい"],["雲","くも"],["が"],["現れて","あらわれて"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["な"],["方","ほう"],["が"],["その"],["雲","くも"],["の"],["上","うえ"],["に"],["座って","すわって"],["おり"],["、"],["頭","あたま"],["に"],["は"],["金","きん"],["の"],["冠","かんむり"],["を"],["かぶり"],["、"],["手","て"],["に"],["は"],["鋭い","するどい"],["鎌","かま"],["を"],["持って","もって"],["おられた"],["。"]]},{"verse":15,"text":"すると、別の天使が神殿から出て来て、雲の上に座っておられる方に向かって大声で叫んだ。「鎌を入れて、刈り取ってください。刈り入れの時が来ました。地上の穀物は実っています。」","tok":[["する"],["と"],["、"],["別","べつ"],["の"],["天使","てんし"],["が"],["神殿","しんでん"],["から"],["出て","でて"],["来て","きて"],["、"],["雲","くも"],["の"],["上","うえ"],["に"],["座って","すわって"],["おられる"],["方","かた"],["に"],["向かって","むかって"],["大声","おおごえ"],["で"],["叫んだ","さけんだ"],["。"],["「"],["鎌","かま"],["を"],["入れて","いれて"],["、"],["刈り取って","かりとって"],["ください"],["。"],["刈り入れ","かりいれ"],["の"],["時","とき"],["が"],["来ました","きました"],["。"],["地上","ちじょう"],["の"],["穀物","こくもつ"],["は"],["実って","みのって"],["います"],["。"],["」"]]},{"verse":16,"text":"そこで、雲の上に座っておられる方が、地に鎌を投げると、地上では刈り入れが行われた。","tok":[["そこ"],["で"],["、"],["雲","くも"],["の"],["上","うえ"],["に"],["座って","すわって"],["おられる"],["方","ほう"],["が"],["、"],["地","ち"],["に"],["鎌","かま"],["を"],["投げる","なげる"],["と"],["、"],["地上","ちじょう"],["で"],["は"],["刈り入れ","かりいれ"],["が"],["行われた","おこなわれた"],["。"]]},{"verse":17,"text":"また、別の天使が天にある神殿から出て来たが、この天使も手に鋭い鎌を持っていた。","tok":[["また"],["、"],["別","べつ"],["の"],["天使","てんし"],["が"],["天","てん"],["に"],["ある"],["神殿","しんでん"],["から"],["出て","でて"],["来た","きた"],["が"],["、"],["この"],["天使","てんし"],["も"],["手","て"],["に"],["鋭い","するどい"],["鎌","かま"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":18,"text":"すると、祭壇のところから、火をつかさどる権威を持つ別の天使が出て来て、鋭い鎌を持つ天使に大声でこう言った。「その鋭い鎌を入れて、地上のぶどうの房を取り入れよ。ぶどうの実は既に熟している。」","tok":[["する"],["と"],["、"],["祭壇","さいだん"],["の"],["ところ"],["から"],["、"],["火","ひ"],["を"],["つかさどる"],["権威","けんい"],["を"],["持つ","もつ"],["別","べつ"],["の"],["天使","てんし"],["が"],["出て","でて"],["来て","きて"],["、"],["鋭い","するどい"],["鎌","かま"],["を"],["持つ","もつ"],["天使","てんし"],["に"],["大声","おおごえ"],["で"],["こう"],["言った","いった"],["。"],["「"],["その"],["鋭い","するどい"],["鎌","かま"],["を"],["入れて","いれて"],["、"],["地上","ちじょう"],["の"],["ぶどう"],["の"],["房","ふさ"],["を"],["取り入れよ","とりいれよ"],["。"],["ぶどう"],["の"],["実","じつ"],["は"],["既に","すでに"],["熟して","じゅくして"],["いる"],["。"],["」"]]},{"verse":19,"text":"そこで、その天使は、地に鎌を投げ入れて地上のぶどうを取り入れ、これを神の怒りの大きな搾り桶に投げ入れた。","tok":[["そこ"],["で"],["、"],["その"],["天使","てんし"],["は"],["、"],["地","ち"],["に"],["鎌","かま"],["を"],["投げ入れて","なげいれて"],["地上","ちじょう"],["の"],["ぶどう"],["を"],["取り入れ","とりいれ"],["、"],["これ"],["を"],["神","かみ"],["の"],["怒り","いかり"],["の"],["大きな","おおきな"],["搾り","しぼり"],["桶","おけ"],["に"],["投げ入れた","なげいれた"],["。"]]},{"verse":20,"text":"搾り桶は、都の外で踏まれた。すると、血が搾り桶から流れ出て、馬のくつわに届くほどになり、千六百スタディオンにわたって広がった。","tok":[["搾り","しぼり"],["桶","おけ"],["は"],["、"],["都","と"],["の"],["外","そと"],["で"],["踏まれた","ふまれた"],["。"],["する"],["と"],["、"],["血","ち"],["が"],["搾り","しぼり"],["桶","おけ"],["から"],["流れ出て","ながれでて"],["、"],["馬","うま"],["の"],["くつわ"],["に"],["届く","とどく"],["ほど"],["に"],["なり"],["、"],["千六百","せんろくひゃく"],["スタディオン"],["に"],["わたって"],["広がった","ひろがった"],["。"]]}]
[{"verse":1,"text":"わたしはまた、一人の天使が、底なしの淵の鍵と大きな鎖とを手にして、天から降って来るのを見た。","tok":[["わたし"],["は"],["また"],["、"],["一人","ひとり"],["の"],["天使","てんし"],["が"],["、"],["底なし","そこなし"],["の"],["淵","ふち"],["の"],["鍵","かぎ"],["と"],["大きな","おおきな"],["鎖","くさり"],["と"],["を"],["手","て"],["に"],["して"],["、"],["天","てん"],["から"],["降って","ふって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":2,"text":"この天使は、悪魔でもサタンでもある、年を経たあの蛇、つまり竜を取り押さえ、千年の間縛っておき、","tok":[["この"],["天使","てんし"],["は"],["、"],["悪魔","あくま"],["で"],["も"],["サタン"],["で"],["も"],["ある"],["、"],["年","とし"],["を"],["経た","へた"],["あの"],["蛇","へび"],["、"],["つまり"],["竜","りゅう"],["を"],["取り押さえ","とりおさえ"],["、"],["千","せん"],["年","ねん"],["の"],["間","あいだ"],["縛って","しばって"],["おき"],["、"]]},{"verse":3,"text":"底なしの淵に投げ入れ、鍵をかけ、その上に封印を施して、千年が終わるまで、もうそれ以上、諸国の民を惑わさないようにした。その後で、竜はしばらくの間、解放されるはずである。","tok":[["底なし","そこなし"],["の"],["淵","ふち"],["に"],["投げ入れ","なげいれ"],["、"],["鍵","かぎ"],["を"],["かけ"],["、"],["その"],["上","うえ"],["に"],["封印","ふういん"],["を"],["施して","ほどこして"],["、"],["千","せん"],["年","ねん"],["が"],["終わる","おわる"],["まで"],["、"],["もう"],["それ"],["以上","いじょう"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["惑わさない","まどわさない"],["よう"],["に"],["した"],["。"],["その後","そのあと"],["で"],["、"],["竜","りゅう"],["は"],["しばらく"],["の"],["間","あいだ"],["、"],["解放","かいほう"],["される"],["はず"],["で"],["ある"],["。"]]},{"verse":4,"text":"わたしはまた、多くの座を見た。その上には座っている者たちがおり、彼らには裁くことが許されていた。わたしはまた、イエスの証しと神の言葉のために、首をはねられた者たちの魂を見た。この者たちは、あの獣もその像も拝まず、額や手に獣の刻印を受けなかった。彼らは生き返って、キリストと共に千年の間統治した。","tok":[["わたし"],["は"],["また"],["、"],["多く","おおく"],["の"],["座","ざ"],["を"],["見た","みた"],["。"],["その"],["上","うえ"],["に"],["は"],["座って","すわって"],["いる"],["者","もの"],["たち"],["が"],["おり"],["、"],["彼","かれ"],["ら"],["に"],["は"],["裁く","さばく"],["こと"],["が"],["許されて","ゆるされて"],["いた"],["。"],["わたし"],["は"],["また"],["、"],["イエス"],["の"],["証し","あかし"],["と"],["神","かみ"],["の"],["言葉","ことば"],["の"],["ため"],["に"],["、"],["首","くび"],["を"],["はねられた"],["者","もの"],["たち"],["の"],["魂","たましい"],["を"],["見た","みた"],["。"],["この"],["者","もの"],["たち"],["は"],["、"],["あの"],["獣","けもの"],["も"],["その"],["像","ぞう"],["も"],["拝まず","おがまず"],["、"],["額","がく"],["や"],["手","て"],["に"],["獣","けもの"],["の"],["刻印","こくいん"],["を"],["受けなかった","うけなかった"],["。"],["彼","かれ"],["ら"],["は"],["生き返って","いきかえって"],["、"],["キリスト"],["と"],["共","とも"],["に"],["千","せん"],["年","ねん"],["の"],["間","あいだ"],["統治","とうち"],["した"],["。"]]},{"verse":5,"text":"その他の死者は、千年たつまで生き返らなかった。これが第一の復活である。","tok":[["その"],["他","た"],["の"],["死者","ししゃ"],["は"],["、"],["千","せん"],["年","ねん"],["たつ"],["まで"],["生き返らなかった","いきかえらなかった"],["。"],["これ"],["が"],["第","だい"],["一","いち"],["の"],["復活","ふっかつ"],["で"],["ある"],["。"]]},{"verse":6,"text":"第一の復活にあずかる者は、幸いな者、聖なる者である。この者たちに対して、第二の死は何の力もない。彼らは神とキリストの祭司となって、千年の間キリストと共に統治する。","tok":[["第","だい"],["一","いち"],["の"],["復活","ふっかつ"],["に"],["あずかる"],["者","もの"],["は"],["、"],["幸い","さいわい"],["な"],["者","もの"],["、"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["。"],["この"],["者","もの"],["たち"],["に対して","にたいして"],["、"],["第","だい"],["二","に"],["の"],["死","し"],["は"],["何","なん"],["の"],["力","ちから"],["も"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["神","かみ"],["と"],["キリスト"],["の"],["祭司","さいし"],["と"],["なって"],["、"],["千","せん"],["年","ねん"],["の"],["間","あいだ"],["キリスト"],["と"],["共","とも"],["に"],["統治","とうち"],["する"],["。"]]},{"verse":7,"text":"この千年が終わると、サタンはその牢から解放され、","tok":[["この"],["千","せん"],["年","ねん"],["が"],["終わる","おわる"],["と"],["、"],["サタン"],["は"],["その"],["牢","ろう"],["から"],["解放","かいほう"],["され"],["、"]]},{"verse":8,"text":"地上の四方にいる諸国の民、ゴグとマゴグを惑わそうとして出て行き、彼らを集めて戦わせようとする。その数は海の砂のように多い。","tok":[["地上","ちじょう"],["の"],["四方","しほう"],["に"],["いる"],["諸国","しょこく"],["の"],["民","たみ"],["、"],["ゴグ"],["と"],["マゴグ"],["を"],["惑わそう","まどわそう"],["として"],["出て","でて"],["行き","いき"],["、"],["彼","かれ"],["ら"],["を"],["集めて","あつめて"],["戦わせよう","たたかわせよう"],["と"],["する"],["。"],["その"],["数","すう"],["は"],["海","うみ"],["の"],["砂","すな"],["の"],["よう"],["に"],["多い","おおい"],["。"]]},{"verse":9,"text":"彼らは地上の広い場所に攻め上って行って、聖なる者たちの陣営と、愛された都とを囲んだ。すると、天から火が下って来て、彼らを焼き尽くした。","tok":[["彼","かれ"],["ら"],["は"],["地上","ちじょう"],["の"],["広い","ひろい"],["場所","ばしょ"],["に"],["攻め上って","せめのぼって"],["行って","いって"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["陣営","じんえい"],["と"],["、"],["愛された","あいされた"],["都","と"],["と"],["を"],["囲んだ","かこんだ"],["。"],["する"],["と"],["、"],["天","てん"],["から"],["火","ひ"],["が"],["下って","くだって"],["来て","きて"],["、"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くした","つくした"],["。"]]},{"verse":10,"text":"そして彼らを惑わした悪魔は、火と硫黄の池に投げ込まれた。そこにはあの獣と偽預言者がいる。そして、この者どもは昼も夜も世々限りなく責めさいなまれる。","tok":[["そして"],["彼","かれ"],["ら"],["を"],["惑わした","まどわした"],["悪魔","あくま"],["は"],["、"],["火","ひ"],["と"],["硫黄","いおう"],["の"],["池","いけ"],["に"],["投げ込まれた","なげこまれた"],["。"],["そこ"],["に"],["は"],["あの"],["獣","けもの"],["と"],["偽","にせ"],["預言者","よげんしゃ"],["が"],["いる"],["。"],["そして"],["、"],["この"],["者","もの"],["ども"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["世々","せいせい"],["限りなく","かぎりなく"],["責めさいなまれる","せめさいなまれる"],["。"]]},{"verse":11,"text":"わたしはまた、大きな白い玉座と、そこに座っておられる方とを見た。天も地も、その御前から逃げて行き、行方が分からなくなった。","tok":[["わたし"],["は"],["また"],["、"],["大きな","おおきな"],["白い","しろい"],["玉座","ぎょくざ"],["と"],["、"],["そこ"],["に"],["座って","すわって"],["おられる"],["方","かた"],["と"],["を"],["見た","みた"],["。"],["天","てん"],["も"],["地","ち"],["も"],["、"],["その"],["御前","ごぜん"],["から"],["逃げて","にげて"],["行き","いき"],["、"],["行方","ゆくえ"],["が"],["分からなく","わからなく"],["なった"],["。"]]},{"verse":12,"text":"わたしはまた、死者たちが、大きな者も小さな者も、玉座の前に立っているのを見た。幾つかの書物が開かれたが、もう一つの書物も開かれた。それは命の書である。死者たちは、これらの書物に書かれていることに基づき、彼らの行いに応じて裁かれた。","tok":[["わたし"],["は"],["また"],["、"],["死者","ししゃ"],["たち"],["が"],["、"],["大きな","おおきな"],["者","もの"],["も"],["小さな","ちいさな"],["者","もの"],["も"],["、"],["玉座","ぎょくざ"],["の"],["前","まえ"],["に"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["幾つ","いくつ"],["か"],["の"],["書物","しょもつ"],["が"],["開かれた","ひらかれた"],["が"],["、"],["もう"],["一","ひと"],["つ"],["の"],["書物","しょもつ"],["も"],["開かれた","ひらかれた"],["。"],["それ"],["は"],["命","いのち"],["の"],["書","しょ"],["で"],["ある"],["。"],["死者","ししゃ"],["たち"],["は"],["、"],["これ"],["ら"],["の"],["書物","しょもつ"],["に"],["書かれて","かかれて"],["いる"],["こと"],["に"],["基づき","もとづき"],["、"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["に"],["応じて","おうじて"],["裁かれた","さばかれた"],["。"]]},{"verse":13,"text":"海は、その中にいた死者を外に出した。死と陰府も、その中にいた死者を出し、彼らはそれぞれ自分の行いに応じて裁かれた。","tok":[["海","うみ"],["は"],["、"],["その"],["中","なか"],["に"],["いた"],["死者","ししゃ"],["を"],[
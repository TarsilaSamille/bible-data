[{"verse":1,"text":"エフェソにある教会の天使にこう書き送れ。『右の手に七つの星を持つ方、七つの金の燭台の間を歩く方が、次のように言われる。","tok":[["エフェソ"],["に"],["ある"],["教会","きょうかい"],["の"],["天使","てんし"],["に"],["こう"],["書き送れ","かきおくれ"],["。"],["『"],["右","みぎ"],["の"],["手","て"],["に"],["七","なな"],["つ"],["の"],["星","ほし"],["を"],["持つ","もつ"],["方","かた"],["、"],["七","なな"],["つ"],["の"],["金","かね"],["の"],["燭台","しょくだい"],["の"],["間","あいだ"],["を"],["歩く","あるく"],["方","ほう"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"]]},{"verse":2,"text":"「わたしは、あなたの行いと労苦と忍耐を知っており、また、あなたが悪者どもに我慢できず、自ら使徒と称して実はそうでない者どもを調べ、彼らのうそを見抜いたことも知っている。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["と"],["労苦","ろうく"],["と"],["忍耐","にんたい"],["を"],["知って","しって"],["おり"],["、"],["また"],["、"],["あなた"],["が"],["悪者","わるもの"],["ども"],["に"],["我慢","がまん"],["できず"],["、"],["自ら","みずから"],["使徒","しと"],["と"],["称して","しょうして"],["実","じつ"],["は"],["そう"],["で"],["ない"],["者","もの"],["ども"],["を"],["調べ","しらべ"],["、"],["彼","かれ"],["ら"],["の"],["うそ"],["を"],["見抜いた","みぬいた"],["こと"],["も"],["知って","しって"],["いる"],["。"]]},{"verse":3,"text":"あなたはよく忍耐して、わたしの名のために我慢し、疲れ果てることがなかった。","tok":[["あなた"],["は"],["よく"],["忍耐","にんたい"],["して"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["我慢","がまん"],["し"],["、"],["疲れ","つかれ"],["果てる","はてる"],["こと"],["が"],["なかった"],["。"]]},{"verse":4,"text":"しかし、あなたに言うべきことがある。あなたは初めのころの愛から離れてしまった。","tok":[["しかし"],["、"],["あなた"],["に"],["言うべき","ゆうべき"],["こと"],["が"],["ある"],["。"],["あなた"],["は"],["初め","はじめ"],["の"],["ころ"],["の"],["愛","あい"],["から"],["離れて","はなれて"],["しまった"],["。"]]},{"verse":5,"text":"だから、どこから落ちたかを思い出し、悔い改めて初めのころの行いに立ち戻れ。もし悔い改めなければ、わたしはあなたのところへ行って、あなたの燭台をその場所から取りのけてしまおう。","tok":[["だ"],["から"],["、"],["どこ"],["から"],["落ちた","おちた"],["か"],["を"],["思い出し","おもいだし"],["、"],["悔い改めて","くいあらためて"],["初め","はじめ"],["の"],["ころ"],["の"],["行い","おこない"],["に"],["立ち戻れ","たちもどれ"],["。"],["もし"],["悔い改めなければ","くいあらためなければ"],["、"],["わたし"],["は"],["あなた"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["あなた"],["の"],["燭台","しょくだい"],["を"],["その"],["場所","ばしょ"],["から"],["取りのけて","とりのけて"],["しまおう"],["。"]]},{"verse":6,"text":"だが、あなたには取り柄もある。ニコライ派の者たちの行いを憎んでいることだ。わたしもそれを憎んでいる。","tok":[["だ"],["が"],["、"],["あなた"],["に"],["は"],["取り柄","とりえ"],["も"],["ある"],["。"],["ニコライ"],["派","は"],["の"],["者","もの"],["たち"],["の"],["行い","おこない"],["を"],["憎んで","にくんで"],["いる"],["こと"],["だ"],["。"],["わたし"],["も"],["それ"],["を"],["憎んで","にくんで"],["いる"],["。"]]},{"verse":7,"text":"耳ある者は、“霊”が諸教会に告げることを聞くがよい。勝利を得る者には、神の楽園にある命の木の実を食べさせよう。」』","tok":[["耳","みみ"],["ある"],["者","もの"],["は"],["、"],["“"],["霊","れい"],["”"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["告げる","つげる"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["。"],["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["に"],["は"],["、"],["神","かみ"],["の"],["楽園","らくえん"],["に"],["ある"],["命","いのち"],["の"],["木の実","このみ"],["を"],["食べさせよう","たべさせよう"],["。"],["」"],["』"]]},{"verse":8,"text":"スミルナにある教会の天使にこう書き送れ。『最初の者にして、最後の者である方、一度死んだが、また生きた方が、次のように言われる。","tok":[["スミルナ"],["に"],["ある"],["教会","きょうかい"],["の"],["天使","てんし"],["に"],["こう"],["書き送れ","かきおくれ"],["。"],["『"],["最初","さいしょ"],["の"],["者","もの"],["に"],["して"],["、"],["最後","さいご"],["の"],["者","もの"],["で"],["ある"],["方","かた"],["、"],["一度","いちど"],["死んだ","しんだ"],["が"],["、"],["また"],["生きた","いきた"],["方","ほう"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"「わたしは、あなたの苦難や貧しさを知っている。だが、本当はあなたは豊かなのだ。自分はユダヤ人であると言う者どもが、あなたを非難していることを、わたしは知っている。実は、彼らはユダヤ人ではなく、サタンの集いに属している者どもである。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["苦難","くなん"],["や"],["貧し","まずし"],["さ"],["を"],["知って","しって"],["いる"],["。"],["だ"],["が"],["、"],["本当","ほんとう"],["は"],["あなた"],["は"],["豊か","ゆたか"],["な"],["の"],["だ"],["。"],["自分","じぶん"],["は"],["ユダヤ人","ゆだやじん"],["で"],["ある"],["と"],["言う","いう"],["者","もの"],["ども"],["が"],["、"],["あなた"],["を"],["非難","ひなん"],["して"],["いる"],["こと"],["を"],["、"],["わたし"],["は"],["知って","しって"],["いる"],["。"],["実","じつ"],["は"],["、"],["彼","かれ"],["ら"],["は"],["ユダヤ人","ゆだやじん"],["で"],["は"],["なく"],["、"],["サタン"],["の"],["集い","つどい"],["に"],["属して","ぞくして"],["いる"],["者","もの"],["ども"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたは、受けようとしている苦難を決して恐れてはいけない。見よ、悪魔が試みるために、あなたがたの何人かを牢に投げ込もうとしている。あなたがたは、十日の間苦しめられるであろう。死に至るまで忠実であれ。そうすれば、あなたに命の冠を授けよう。","tok":[["あなた"],["は"],["、"],["受けよう","うけよう"],["として"],["いる"],["苦難","くなん"],["を"],["決して","けっして"],["恐れて","おそれて"],["は"],["いけない"],["。"],["見よ","みよ"],["、"],["悪魔","あくま"],["が"],["試みる","こころみる"],["ため"],["に"],["、"],["あなた"],["がた"],["の"],["何人","なんにん"],["か"],["を"],["牢","ろう"],["に"],["投げ込もう","なげこもう"],["として"],["いる"],["。"],["あなた"],["がた"],["は"],["、"],["十日","とうか"],["の"],["間","あいだ"],["苦しめられるで","くるしめられるで"],["あろう"],["。"],["死","し"],["に"],["至る","いたる"],["まで"],["忠実","ちゅうじつ"],["で"],["あれ"],["。"],["そう"],["すれば"],["、"],["あなた"],["に"],["命","いのち"],["の"],["冠","かんむり"],["を"],["授けよう","さずけよう"],["。"]]},{"verse":11,"text":"耳ある者は、“霊”が諸教会に告げることを聞くがよい。勝利を得る者は、決して第二の死から害を受けることはない。」』","tok":[["耳","みみ"],["ある"],["者","もの"],["は"],["、"],["“"],["霊","れい"],["”"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["告げる","つげる"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["。"],["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["は"],["、"],["決して","けっして"],["第","だい"],["二","に"],["の"],["死","し"],["から"],["害","がい"],["を"],["受ける","うける"],["こと"],["は"],["ない"],["。"],["」"],["』"]]},{"verse":12,"text":"ペルガモンにある教会の天使にこう書き送れ。『鋭い両刃の剣を持っている方が、次のように言われる。","tok":[["ペルガモン"],["に"],["ある"],["教会","きょうかい"],["の"],["天使","てんし"],["に"],["こう"],["書き送れ","かきおくれ"],["。"],["『"],["鋭い","するどい"],["両刃","りょうば"],["の"],["剣","けん"],["を"],["持って","もって"],["いる"],["方","ほう"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"「わたしは、あなたの住んでいる所を知っている。そこにはサタンの王座がある。しかし、あなたはわたしの名をしっかり守って、わたしの忠実な証人アンティパスが、サタンの住むあなたがたの所で殺されたときでさえ、わたしに対する信仰を捨てなかった。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["住んで","すんで"],["いる"],["所","ところ"],["を"],["知って","しって"],["いる"],["。"],["そこ"],["に"],["は"],["サタン"],["の"],["王座","おうざ"],["が"],["ある"],["。"],["しかし"],["、"],["あなた"],["は"],["わたし"],["の"],["名","な"],["を"],["しっかり"],["守って","まもって"],["、"],["わたし"],["の"],["忠実","ちゅうじつ"],["な"],["証人","しょうにん"],["アンティパス"],["が"],["、"],["サタン"],["の"],["住む","すむ"],["あなた"],["がた"],["の"],["所","ところ"],["で"],["殺された","ころされた"],["とき"],["で"],["さえ"],["、"],["わたし"],["に"],["対する","たいする"],["信仰","しんこう"],["を"],["捨てなかった","すてなかった"],["。"]]},{"verse":14,"text":"しかし、あなたに対して少しばかり言うべきことがある。あなたのところには、バラムの教えを奉ずる者がいる。バラムは、イスラエルの子らの前につまずきとなるものを置くようにバラクに教えた。それは、彼らに偶像に献げた肉を食べさせ、みだらなことをさせるためだった。","tok":[["しかし"],["、"],["あなた"],["に対して","にたいして"],["少し","すこし"],["ばかり"],["言うべき","ゆうべき"],["こと"],["が"],["ある"],["。"],["あなた"],["の"],["ところ"],["に"],["は"],["、"],["バラム"],["の"],["教え","おしえ"],["を"],["奉ずる","ほうずる"],["者","もの"],["が"],["いる"],["。"],["バラム"],["は"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["前","まえ"],["に"],["つまずき"],["と"],["なる"],["もの"],["を"],["置く","おく"],["よう"],["に"],["バラク"],["に"],["教えた","おしえた"],["。"],["それ"],["は"],["、"],["彼","かれ"],["ら"],["に"],["偶像","ぐうぞう"],["に"],["献げた","ささげた"],["肉","にく"],["を"],["食べさせ","たべさせ"],["、"],["みだら"],["な"],["こと"],["を"],["させる"],["ため"],["だった"],["。"]]},{"verse":15,"text":"同じように、あなたのところにもニコライ派の教えを奉ずる者たちがいる。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["の"],["ところ"],["に"],["も"],["ニコライ"],["派","は"],["の"],["教え","おしえ"],["を"],["奉ずる","ほうずる"],["者","もの"],["たち"],["が"],["いる"],["。"]]},{"verse":16,"text":"だから、悔い改めよ。さもなければ、すぐにあなたのところへ行って、わたしの口の剣でその者どもと戦おう。","tok":[["だ"],["から"],["、"],["悔い改め","くいあらため"],["よ"],["。"],["さも"],["なければ"],["、"],["すぐ"],["に"],["あなた"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["わたし"],["の"],["口","くち"],["の"],["剣","けん"],["で"],["その"],["者","もの"],["ども"],["と"],["戦おう","たたかおう"],["。"]]},{"verse":17,"text":"耳ある者は、“霊”が諸教会に告げることを聞くがよい。勝利を得る者には隠されていたマンナを与えよう。また、白い小石を与えよう。その小石には、これを受ける者のほかにはだれにも分からぬ新しい名が記されている。」』","tok":[["耳","みみ"],["ある"],["者","もの"],["は"],["、"],["“"],["霊","れい"],["”"],["が"],["諸教","しょきょう"],["会","かい"],["に"],["告げる","つげる"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["。"],["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["に"],["は"],["隠されて","かくされて"],["いた"],["マンナ"],["を"],["与えよう","あたえよう"],["。"],["また"],["、"],["白い","しろい"],["小石","こいし"],["を"],["与えよう","あたえよう"],["。"],["その"],["小石","こいし"],["に"],["は"],["、"],["これ"],["を"],["受ける","うける"],["者","もの"],["の"],["ほか"],["に"],["は"],["だれ"],["に"],["も"],["分からぬ","わからぬ"],["新しい","あたらしい"],["名","な"],["が"],["記されて","しるされて"],["いる"],["。"],["」"],["』"]]},{"verse":18,"text":"ティアティラにある教会の天使にこう書き送れ。『目は燃え盛る炎のようで、足はしんちゅうのように輝いている神の子が、次のように言われる。","tok":[["ティア"],["ティラ"],["に"],["ある"],["教会","きょうかい"],["の"],["天使","てんし"],["に"],["こう"],["書き送れ","かきおくれ"],["。"],["『"],["目","め"],["は"],["燃え盛る","もえさかる"],["炎","ほのお"],["の"],["よう"],["で"],["、"],["足","あし"],["は"],["しんちゅう"],["の"],["よう"],["に"],["輝いて","かがやいて"],["いる"],["神","かみ"],["の"],["子","こ"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"]]},{"verse":19,"text":"「わたしは、あなたの行い、愛、信仰、奉仕、忍耐を知っている。更に、あなたの近ごろの行いが、最初のころの行いにまさっていることも知っている。","tok":[["「"],["わたし"],["は"],["、"],["あなた"],["の"],["行い","おこない"],["、"],["愛","あい"],["、"],["信仰","しんこう"],["、"],["奉仕","ほうし"],["、"],["忍耐","にんたい"],["を"],["知って","しって"],["いる"],["。"],["更に","さらに"],["、"],["あなた"],["の"],["近ごろ","ちかごろ"],["の"],["行い","おこない"],["が"],["、"],["最初","さいしょ"],["の"],["ころ"],["の"],["行い","おこない"],["に"],["まさって"],["いる"],["こと"],["も"],["知って","しって"],["いる"],["。"]]},{"verse":20,"text":"しかし、あなたに対して言うべきことがある。あなたは、あのイゼベルという女のすることを大目に見ている。この女は、自ら預言者と称して、わたしの僕たちを教え、また惑わして、みだらなことをさせ、偶像に献げた肉を食べさせている。","tok":[["しかし"],["、"],["あなた"],["に対して","にたいして"],["言うべき","ゆうべき"],["こと"],["が"],["ある"],["。"],["あなた"],["は"],["、"],["あの"],["イゼベル"],["と"],["いう"],["女","おんな"],["の"],["する"],["こと"],["を"],["大目","おおめ"],["に"],["見て","みて"],["いる"],["。"],["この"],["女","おんな"],["は"],["、"],["自ら","みずから"],["預言者","よげんしゃ"],["と"],["称して","しょうして"],["、"],["わたし"],["の"],["僕たち","ぼくたち"],["を"],["教え","おしえ"],["、"],["また"],["惑わして","まどわして"],["、"],["みだら"],["な"],["こと"],["を"],["させ"],["、"],["偶像","ぐうぞう"],["に"],["献げた","ささげた"],["肉","にく"],["を"],["食べさせて","たべさせて"],["いる"],["。"]]},{"verse":21,"text":"わたしは悔い改める機会を与えたが、この女はみだらな行いを悔い改めようとしない。","tok":[["わたし"],["は"],["悔い改める","くいあらためる"],["機会","きかい"],["を"],["与えた","あたえた"],["が"],["、"],["この"],["女","おんな"],["は"],["みだら"],["な"],["行い","おこない"],["を"],["悔い改めよう","くいあらためよう"],["と"],["しない"],["。"]]},{"verse":22,"text":"見よ、わたしはこの女を床に伏せさせよう。この女と共にみだらなことをする者たちも、その行いを悔い改めないなら、ひどい苦しみに遭わせよう。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["この"],["女","おんな"],["を"],["床","ゆか"],["に"],["伏せさせよう","ふせさせよう"],["。"],["この"],["女","おんな"],["と"],["共","とも"],["に"],["みだら"],["な"],["こと"],["を"],["する"],["者","もの"],["たち"],["も"],["、"],["その"],["行い","おこない"],["を"],["悔い改めないなら","くいあらためないなら"],["、"],["ひどい"],["苦しみ","くるしみ"],["に"],["遭わせよう","あわせよう"],["。"]]},{"verse":23,"text":"また、この女の子供たちも打ち殺そう。こうして、全教会は、わたしが人の思いや判断を見通す者だということを悟るようになる。わたしは、あなたがたが行ったことに応じて、一人一人に報いよう。","tok":[["また"],["、"],["この"],["女","おんな"],["の"],["子供","こども"],["たち"],["も"],["打ち殺そう","うちころそう"],["。"],["こう"],["して"],["、"],["全教","ぜんきょう"],["会","かい"],["は"],["、"],["わたし"],["が"],["人","ひと"],["の"],["思い","おもい"],["や"],["判断","はんだん"],["を"],["見通す","みとおす"],["者","もの"],["だ"],["と"],["いう"],["こと"],["を"],["悟る","さとる"],["よう"],["に"],["なる"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["が"],["行った","おこなった"],["こと"],["に"],["応じて","おうじて"],["、"],["一人一人","ひとりひとり"],["に"],["報いよう","むくいよう"],["。"]]},{"verse":24,"text":"ティアティラの人たちの中にいて、この女の教えを受け入れず、サタンのいわゆる奥深い秘密を知らないあなたがたに言う。わたしは、あなたがたに別の重荷を負わせない。","tok":[["ティア"],["ティラ"],["の"],["人","ひと"],["たち"],["の"],["中","なか"],["に"],["いて"],["、"],["この"],["女","おんな"],["の"],["教え","おしえ"],["を"],["受け入れず","うけいれず"],["、"],["サタン"],["の"],["いわゆる"],["奥深い","おくふかい"],["秘密","ひみつ"],["を"],["知らない","しらない"],["あなた"],["がた"],["に"],["言う","ゆう"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["に"],["別","べつ"],["の"],["重荷","おもに"],["を"],["負わせない","おわせない"],["。"]]},{"verse":25,"text":"ただ、わたしが行くときまで、今持っているものを固く守れ。","tok":[["ただ"],["、"],["わたし"],["が"],["行く","いく"],["とき"],["まで"],["、"],["今","いま"],["持って","もって"],["いる"],["もの"],["を"],["固く","かたく"],["守れ","まもれ"],["。"]]},{"verse":26,"text":"勝利を得る者に、わたしの業を終わりまで守り続ける者に、わたしは、諸国の民の上に立つ権威を授けよう。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["に"],["、"],["わたし"],["の"],["業","ごう"],["を"],["終わり","おわり"],["まで"],["守り","まもり"],["続ける","つづける"],["者","もの"],["に"],["、"],["わたし"],["は"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["立つ","たつ"],["権威","けんい"],["を"],["授けよう","さずけよう"],["。"]]},{"verse":27,"text":"彼は鉄の杖をもって彼らを治める、土の器を打ち砕くように。","tok":[["彼","かれ"],["は"],["鉄","てつ"],["の"],["杖","つえ"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["治める","おさめる"],["、"],["土","つち"],["の"],["器","うつわ"],["を"],["打ち砕く","うちくだく"],["よう"],["に"],["。"]]},{"verse":28,"text":"同じように、わたしも父からその
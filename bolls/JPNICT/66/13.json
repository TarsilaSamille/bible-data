[{"verse":1,"text":"わたしはまた、一匹の獣が海の中から上って来るのを見た。これには十本の角と七つの頭があった。それらの角には十の王冠があり、頭には神を冒瀆するさまざまの名が記されていた。","tok":[["わたし"],["は"],["また"],["、"],["一匹","いちひき"],["の"],["獣","けもの"],["が"],["海","うみ"],["の"],["中","なか"],["から"],["上って","のぼって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["これ"],["に"],["は"],["十本","じゅうぽん"],["の"],["角","かど"],["と"],["七","なな"],["つ"],["の"],["頭","あたま"],["が"],["あった"],["。"],["それ"],["ら"],["の"],["角","かど"],["に"],["は"],["十","じゅう"],["の"],["王冠","おうかん"],["が"],["あり"],["、"],["頭","あたま"],["に"],["は"],["神","かみ"],["を"],["冒瀆","ぼうとく"],["する"],["さまざま"],["の"],["名","な"],["が"],["記されて","しるされて"],["いた"],["。"]]},{"verse":2,"text":"わたしが見たこの獣は、豹に似ており、足は熊の足のようで、口は獅子の口のようであった。竜はこの獣に、自分の力と王座と大きな権威とを与えた。","tok":[["わたし"],["が"],["見た","みた"],["この"],["獣","けもの"],["は"],["、"],["豹","ひょう"],["に"],["似て","にて"],["おり"],["、"],["足","あし"],["は"],["熊","くま"],["の"],["足","あし"],["の"],["よう"],["で"],["、"],["口","くち"],["は"],["獅子","しし"],["の"],["口","くち"],["の"],["よう"],["で"],["あった"],["。"],["竜","りゅう"],["は"],["この"],["獣","けもの"],["に"],["、"],["自分","じぶん"],["の"],["力","ちから"],["と"],["王座","おうざ"],["と"],["大きな","おおきな"],["権威","けんい"],["と"],["を"],["与えた","あたえた"],["。"]]},{"verse":3,"text":"この獣の頭の一つが傷つけられて、死んだと思われたが、この致命的な傷も治ってしまった。そこで、全地は驚いてこの獣に服従した。","tok":[["この"],["獣","けもの"],["の"],["頭","あたま"],["の"],["一","ひと"],["つ"],["が"],["傷つけられて","きずつけられて"],["、"],["死んだ","しんだ"],["と"],["思われた","おもわれた"],["が"],["、"],["この"],["致命的","ちめいてき"],["な"],["傷","きず"],["も"],["治って","なおって"],["しまった"],["。"],["そこ"],["で"],["、"],["全地","ぜんち"],["は"],["驚いて","おどろいて"],["この"],["獣","けもの"],["に"],["服従","ふくじゅう"],["した"],["。"]]},{"verse":4,"text":"竜が自分の権威をこの獣に与えたので、人々は竜を拝んだ。人々はまた、この獣をも拝んでこう言った。「だれが、この獣と肩を並べることができようか。だれが、この獣と戦うことができようか。」","tok":[["竜","りゅう"],["が"],["自分","じぶん"],["の"],["権威","けんい"],["を"],["この"],["獣","けもの"],["に"],["与えた","あたえた"],["ので"],["、"],["人々","ひとびと"],["は"],["竜","りゅう"],["を"],["拝んだ","おがんだ"],["。"],["人々","ひとびと"],["は"],["また"],["、"],["この"],["獣","けもの"],["を"],["も"],["拝んで","おがんで"],["こう"],["言った","いった"],["。"],["「"],["だれ"],["が"],["、"],["この"],["獣","けもの"],["と"],["肩","かた"],["を"],["並べる","ならべる"],["こと"],["が"],["できよう"],["か"],["。"],["だれ"],["が"],["、"],["この"],["獣","けもの"],["と"],["戦う","たたかう"],["こと"],["が"],["できよう"],["か"],["。"],["」"]]},{"verse":5,"text":"この獣にはまた、大言と冒瀆の言葉を吐く口が与えられ、四十二か月の間、活動する権威が与えられた。","tok":[["この"],["獣","けもの"],["に"],["は"],["また"],["、"],["大言","たいげん"],["と"],["冒瀆","ぼうとく"],["の"],["言葉","ことば"],["を"],["吐く","はく"],["口","くち"],["が"],["与えられ","あたえられ"],["、"],["四十二","よんじゅうに"],["か月","かげつ"],["の"],["間","あいだ"],["、"],["活動","かつどう"],["する"],["権威","けんい"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":6,"text":"そこで、獣は口を開いて神を冒瀆し、神の名と神の幕屋、天に住む者たちを冒瀆した。","tok":[["そこ"],["で"],["、"],["獣","けもの"],["は"],["口","くち"],["を"],["開いて","ひらいて"],["神","かみ"],["を"],["冒瀆","ぼうとく"],["し"],["、"],["神","かみ"],["の"],["名","な"],["と"],["神","かみ"],["の"],["幕屋","まくや"],["、"],["天","てん"],["に"],["住む","すむ"],["者","もの"],["たち"],["を"],["冒瀆","ぼうとく"],["した"],["。"]]},{"verse":7,"text":"獣は聖なる者たちと戦い、これに勝つことが許され、また、あらゆる種族、民族、言葉の違う民、国民を支配する権威が与えられた。","tok":[["獣","けもの"],["は"],["聖","せい"],["なる"],["者","もの"],["たち"],["と"],["戦い","たたかい"],["、"],["これ"],["に"],["勝つ","かつ"],["こと"],["が"],["許され","ゆるされ"],["、"],["また"],["、"],["あらゆる"],["種族","しゅぞく"],["、"],["民族","みんぞく"],["、"],["言葉","ことば"],["の"],["違う","ちがう"],["民","たみ"],["、"],["国民","こくみん"],["を"],["支配","しはい"],["する"],["権威","けんい"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":8,"text":"地上に住む者で、天地創造の時から、屠られた小羊の命の書にその名が記されていない者たちは皆、この獣を拝むであろう。","tok":[["地上","ちじょう"],["に"],["住む","すむ"],["者","もの"],["で"],["、"],["天地","てんち"],["創造","そうぞう"],["の"],["時","とき"],["から"],["、"],["屠られた","ほふられた"],["小羊","こひつじ"],["の"],["命","いのち"],["の"],["書","しょ"],["に"],["その"],["名","な"],["が"],["記されて","しるされて"],["いない"],["者","もの"],["たち"],["は"],["皆","みな"],["、"],["この"],["獣","けもの"],["を"],["拝むで","おがむで"],["あろう"],["。"]]},{"verse":9,"text":"耳ある者は、聞け。","tok":[["耳","みみ"],["ある"],["者","もの"],["は"],["、"],["聞け","きけ"],["。"]]},{"verse":10,"text":"捕らわれるべき者は、捕らわれて行く。剣で殺されるべき者は、剣で殺される。ここに、聖なる者たちの忍耐と信仰が必要である。","tok":[["捕らわれるべき","とらわれるべき"],["者","もの"],["は"],["、"],["捕らわれて","とらわれて"],["行く","いく"],["。"],["剣","けん"],["で"],["殺されるべき","ころされるべき"],["者","もの"],["は"],["、"],["剣","けん"],["で"],["殺される","ころされる"],["。"],["ここ"],["に"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["忍耐","にんたい"],["と"],["信仰","しんこう"],["が"],["必要","ひつよう"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしはまた、もう一匹の獣が地中から上って来るのを見た。この獣は、小羊の角に似た二本の角があって、竜のようにものを言っていた。","tok":[["わたし"],["は"],["また"],["、"],["もう"],["一匹","いちひき"],["の"],["獣","けもの"],["が"],["地中","ちちゅう"],["から"],["上って","のぼって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["この"],["獣","けもの"],["は"],["、"],["小羊","こひつじ"],["の"],["角","かど"],["に"],["似た","にた"],["二本","にぽん"],["の"],["角","かど"],["が"],["あって"],["、"],["竜","りゅう"],["の"],["よう"],["に"],["もの"],["を"],["言って","いって"],["いた"],["。"]]},{"verse":12,"text":"この獣は、先の獣が持っていたすべての権力をその獣の前で振るい、地とそこに住む人々に、致命的な傷が治ったあの先の獣を拝ませた。","tok":[["この"],["獣","けもの"],["は"],["、"],["先","さき"],["の"],["獣","けもの"],["が"],["持って","もって"],["いた"],["すべて"],["の"],["権力","けんりょく"],["を"],["その"],["獣","けもの"],["の"],["前","まえ"],["で"],["振るい","ふるい"],["、"],["地","ち"],["と"],["そこ"],["に"],["住む","すむ"],["人々","ひとびと"],["に"],["、"],["致命的","ちめいてき"],["な"],["傷","きず"],["が"],["治った","なおった"],["あの"],["先","さき"],["の"],["獣","けもの"],["を"],["拝ませた","おがませた"],["。"]]},{"verse":13,"text":"そして、大きなしるしを行って、人々の前で天から地上へ火を降らせた。","tok":[["そして"],["、"],["大きな","おおきな"],["しるし"],["を"],["行って","おこなって"],["、"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["天","てん"],["から"],["地上","ちじょう"],["へ"],["火","ひ"],["を"],["降らせた","ふらせた"],["。"]]},{"verse":14,"text":"更に、先の獣の前で行うことを許されたしるしによって、地上に住む人々を惑わせ、また、剣で傷を負ったがなお生きている先の獣の像を造るように、地上に住む人に命じた。","tok":[["更に","さらに"],["、"],["先","さき"],["の"],["獣","けもの"],["の"],["前","まえ"],["で"],["行う","おこなう"],["こと"],["を"],["許された","ゆるされた"],["しるし"],["によって"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["人々","ひとびと"],["を"],["惑わせ","まどわせ"],["、"],["また"],["、"],["剣","けん"],["で"],["傷","きず"],["を"],["負った","おった"],["が"],["なお"],["生きて","いきて"],["いる"],["先","さき"],["の"],["獣","けもの"],["の"],["像","ぞう"],["を"],["造る","つくる"],["よう"],["に"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["人","ひと"],["に"],["命じた","めいじた"],["。"]]},{"verse":15,"text":"第二の獣は、獣の像に息を吹き込むことを許されて、獣の像がものを言うことさえできるようにし、獣の像を拝もうとしない者があれば、皆殺しにさせた。","tok":[["第","だい"],["二","に"],["の"],["獣","けもの"],["は"],["、"],["獣","けもの"],["の"],["像","ぞう"],["に"],["息","いき"],["を"],["吹き込む","ふきこむ"],["こと"],["を"],["許されて","ゆるされて"],["、"],["獣","けもの"],["の"],["像","ぞう"],["が"],["もの"],["を"],["言う","いう"],["こと"],["さえ"],["できる"],["よう"],["に"],["し"],["、"],["獣","けもの"],["の"],["像","ぞう"],["を"],["拝もう","おがもう"],["と"],["しない"],["者","もの"],["が"],["あれば"],["、"],["皆殺し","みなごろし"],["に"],["させた"],["。"]]},{"verse":16,"text":"また、小さな者にも大きな者にも、富める者にも貧しい者にも、自由な身分の者にも奴隷にも、すべての者にその右手か額に刻印を押させた。","tok":[["また"],["、"],["小さな","ちいさな"],["者","もの"],["に"],["も"],["大きな","おおきな"],["者","もの"],["に"],["も"],["、"],["富める","とめる"],["者","もの"],["に"],["も"],["貧しい","まずしい"],["者","もの"],["に"],["も"],["、"],["自由","じゆう"],["な"],["身分","みぶん"],["の"],["者","もの"],["に"],["も"],["奴隷","どれい"],["に"],["も"],["、"],["すべて"],["の"],["者","もの"],["に"],["その"],["右手","みぎて"],["か"],["額","がく"],["に"],["刻印","こくいん"],["を"],["押させた","おさせた"],["。"]]},{"verse":17,"text":"そこで、この刻印のある者でなければ、物を買うことも、売ることもできないようになった。この刻印とはあの獣の名、あるいはその名の数字である。","tok":[["そこ"],["で"],["、"],["この"],["刻印","こくいん"],["の"],["ある"],["者","もの"],["で"],["なければ"],["、"],["物","もの"],["を"],["買う","かう"],["こと"],["も"],["、"],["売る","うる"],["こと"],["も"],["できない"],["よう"],["に"],["なった"],["。"],["この"],["刻印","こくいん"],["と"],["は"],["あの"],["獣","けもの"],["の"],["名","な"],["、"],["あるいは"],["その"],["名","な"],["の"],["数字","すうじ"],["で"],["ある"],["。"]]},{"verse":18,"text":"ここに知恵が必要である。賢い人は、獣の数字にどのような意味があるかを考えるがよい。数字は人間を指している。そして、数字は六百六十六である。","tok":[["ここ"],["に"],["知恵","ちえ"],["が"],["必要","ひつよう"],["で"],["ある"],["。"],["賢い","かしこい"],["人","ひと"],["は"],["、"],["獣","けもの"],["の"],["数字","すうじ"],["に"],["どのような"],["意味","いみ"],["が"],["ある"],["か"],["を"],["考える","かんがえる"],["が"],["よい"],["。"],["数字","すうじ"],["は"],["人間","にんげん"],["を"],["指して","さして"],["いる"],["。"],["そして"],["、"],["数字","すうじ"],["は"],["六百六十六","ろくひゃくろくじゅうろく"],["で"],["ある"],["。"]]}]
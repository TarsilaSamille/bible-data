[{"verse":1,"text":"また、わたしは大きな声が神殿から出て、七人の天使にこう言うのを聞いた。「行って、七つの鉢に盛られた神の怒りを地上に注ぎなさい。」","tok":[["また"],["、"],["わたし"],["は"],["大きな","おおきな"],["声","こえ"],["が"],["神殿","しんでん"],["から"],["出て","でて"],["、"],["七人","しちにん"],["の"],["天使","てんし"],["に"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["行って","いって"],["、"],["七","なな"],["つ"],["の"],["鉢","ばち"],["に"],["盛られた","もられた"],["神","かみ"],["の"],["怒り","いかり"],["を"],["地上","ちじょう"],["に"],["注ぎ","そそぎ"],["なさい"],["。"],["」"]]},{"verse":2,"text":"そこで、第一の天使が出て行って、その鉢の中身を地上に注ぐと、獣の刻印を押されている人間たち、また、獣の像を礼拝する者たちに悪性のはれ物ができた。","tok":[["そこ"],["で"],["、"],["第","だい"],["一","いち"],["の"],["天使","てんし"],["が"],["出て","でて"],["行って","いって"],["、"],["その"],["鉢","ばち"],["の"],["中身","なかみ"],["を"],["地上","ちじょう"],["に"],["注ぐ","そそぐ"],["と"],["、"],["獣","けもの"],["の"],["刻印","こくいん"],["を"],["押されて","おされて"],["いる"],["人間","にんげん"],["たち"],["、"],["また"],["、"],["獣","けもの"],["の"],["像","ぞう"],["を"],["礼拝","れいはい"],["する"],["者","もの"],["たち"],["に"],["悪性","あくせい"],["の"],["はれ物","はれもの"],["が"],["できた"],["。"]]},{"verse":3,"text":"第二の天使が、その鉢の中身を海に注ぐと、海は死人の血のようになって、その中の生き物はすべて死んでしまった。","tok":[["第","だい"],["二","に"],["の"],["天使","てんし"],["が"],["、"],["その"],["鉢","ばち"],["の"],["中身","なかみ"],["を"],["海","うみ"],["に"],["注ぐ","そそぐ"],["と"],["、"],["海","うみ"],["は"],["死人","しにん"],["の"],["血","ち"],["の"],["よう"],["に"],["なって"],["、"],["その"],["中","なか"],["の"],["生き物","いきもの"],["は"],["すべて"],["死んで","しんで"],["しまった"],["。"]]},{"verse":4,"text":"第三の天使が、その鉢の中身を川と水の源に注ぐと、水は血になった。","tok":[["第","だい"],["三","さん"],["の"],["天使","てんし"],["が"],["、"],["その"],["鉢","ばち"],["の"],["中身","なかみ"],["を"],["川","かわ"],["と"],["水","みず"],["の"],["源","みなもと"],["に"],["注ぐ","そそぐ"],["と"],["、"],["水","みず"],["は"],["血","ち"],["に"],["なった"],["。"]]},{"verse":5,"text":"そのとき、わたしは水をつかさどる天使がこう言うのを聞いた。「今おられ、かつておられた聖なる方、あなたは正しい方です。このような裁きをしてくださったからです。","tok":[["その"],["とき"],["、"],["わたし"],["は"],["水","みず"],["を"],["つかさどる"],["天使","てんし"],["が"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["今","いま"],["おられ"],["、"],["かつて"],["おられた"],["聖","せい"],["なる"],["方","かた"],["、"],["あなた"],["は"],["正しい","ただしい"],["方","ほう"],["です"],["。"],["この"],["よう"],["な"],["裁き","さばき"],["を"],["して"],["くださった"],["から"],["です"],["。"]]},{"verse":6,"text":"この者どもは、聖なる者たちと預言者たちとの血を流しましたが、あなたは彼らに血をお飲ませになりました。それは当然なことです。」","tok":[["この"],["者","もの"],["ども"],["は"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["と"],["預言者","よげんしゃ"],["たち"],["と"],["の"],["血","ち"],["を"],["流しました","ながしました"],["が"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["血","ち"],["を"],["お飲ませ","おのませ"],["に"],["なりました"],["。"],["それ"],["は"],["当然","とうぜん"],["な"],["こと"],["です"],["。"],["」"]]},{"verse":7,"text":"わたしはまた、祭壇がこう言うのを聞いた。「然り、全能者である神、主よ、あなたの裁きは真実で正しい。」","tok":[["わたし"],["は"],["また"],["、"],["祭壇","さいだん"],["が"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"],["「"],["然り","しかり"],["、"],["全能者","ぜんのうしゃ"],["で"],["ある"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["の"],["裁き","さばき"],["は"],["真実","しんじつ"],["で"],["正しい","ただしい"],["。"],["」"]]},{"verse":8,"text":"第四の天使が、その鉢の中身を太陽に注ぐと、太陽は人間を火で焼くことを許された。","tok":[["第","だい"],["四","よん"],["の"],["天使","てんし"],["が"],["、"],["その"],["鉢","ばち"],["の"],["中身","なかみ"],["を"],["太陽","たいよう"],["に"],["注ぐ","そそぐ"],["と"],["、"],["太陽","たいよう"],["は"],["人間","にんげん"],["を"],["火","ひ"],["で"],["焼く","やく"],["こと"],["を"],["許された","ゆるされた"],["。"]]},{"verse":9,"text":"人間は、激しい熱で焼かれ、この災いを支配する権威を持つ神の名を冒瀆した。そして、悔い改めて神の栄光をたたえることをしなかった。","tok":[["人間","にんげん"],["は"],["、"],["激しい","はげしい"],["熱","ねつ"],["で"],["焼かれ","やかれ"],["、"],["この"],["災い","わざわい"],["を"],["支配","しはい"],["する"],["権威","けんい"],["を"],["持つ","もつ"],["神","かみ"],["の"],["名","な"],["を"],["冒瀆","ぼうとく"],["した"],["。"],["そして"],["、"],["悔い改めて","くいあらためて"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["たたえる"],["こと"],["を"],["しなかった"],["。"]]},{"verse":10,"text":"第五の天使が、その鉢の中身を獣の王座に注ぐと、獣が支配する国は闇に覆われた。人々は苦しみもだえて自分の舌をかみ、","tok":[["第","だい"],["五","ご"],["の"],["天使","てんし"],["が"],["、"],["その"],["鉢","ばち"],["の"],["中身","なかみ"],["を"],["獣","けもの"],["の"],["王座","おうざ"],["に"],["注ぐ","そそぐ"],["と"],["、"],["獣","けもの"],["が"],["支配","しはい"],["する"],["国","くに"],["は"],["闇","やみ"],["に"],["覆われた","おおわれた"],["。"],["人々","ひとびと"],["は"],["苦しみもだえて","くるしみもだえて"],["自分","じぶん"],["の"],["舌","した"],["を"],["かみ"],["、"]]},{"verse":11,"text":"苦痛とはれ物のゆえに天の神を冒瀆し、その行いを悔い改めようとはしなかった。","tok":[["苦痛","くつう"],["と"],["はれ物","はれもの"],["の"],["ゆえ"],["に"],["天","てん"],["の"],["神","かみ"],["を"],["冒瀆","ぼうとく"],["し"],["、"],["その"],["行い","おこない"],["を"],["悔い改めよう","くいあらためよう"],["と"],["は"],["しなかった"],["。"]]},{"verse":12,"text":"第六の天使が、その鉢の中身を大きな川、ユーフラテスに注ぐと、川の水がかれて、日の出る方角から来る王たちの道ができた。","tok":[["第","だい"],["六","ろく"],["の"],["天使","てんし"],["が"],["、"],["その"],["鉢","ばち"],["の"],["中身","なかみ"],["を"],["大きな","おおきな"],["川","かわ"],["、"],["ユーフラテス"],["に"],["注ぐ","そそぐ"],["と"],["、"],["川","かわ"],["の"],["水","みず"],["が"],["かれて"],["、"],["日","ひ"],["の"],["出る","でる"],["方角","ほうがく"],["から"],["来る","くる"],["王","おう"],["たち"],["の"],["道","みち"],["が"],["できた"],["。"]]},{"verse":13,"text":"わたしはまた、竜の口から、獣の口から、そして、偽預言者の口から、蛙のような汚れた三つの霊が出て来るのを見た。","tok":[["わたし"],["は"],["また"],["、"],["竜","りゅう"],["の"],["口","くち"],["から"],["、"],["獣","けもの"],["の"],["口","くち"],["から"],["、"],["そして"],["、"],["偽","にせ"],["預言者","よげんしゃ"],["の"],["口","くち"],["から"],["、"],["蛙","かわず"],["の"],["よう"],["な"],["汚れた","よごれた"],["三","みっ"],["つ"],["の"],["霊","れい"],["が"],["出て","でて"],["来る","くる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":14,"text":"これはしるしを行う悪霊どもの霊であって、全世界の王たちのところへ出て行った。それは、全能者である神の大いなる日の戦いに備えて、彼らを集めるためである。","tok":[["これ"],["は"],["しるし"],["を"],["行う","おこなう"],["悪霊","あくりょう"],["ども"],["の"],["霊","れい"],["で"],["あって"],["、"],["全","ぜん"],["世界","せかい"],["の"],["王","おう"],["たち"],["の"],["ところ"],["へ"],["出て","でて"],["行った","いった"],["。"],["それ"],["は"],["、"],["全能者","ぜんのうしゃ"],["で"],["ある"],["神","かみ"],["の"],["大いなる","おおいなる"],["日","ひ"],["の"],["戦い","たたかい"],["に"],["備えて","そなえて"],["、"],["彼","かれ"],["ら"],["を"],["集める","あつめる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"――見よ、わたしは盗人のように来る。裸で歩くのを見られて恥をかかないように、目を覚まし、衣を身に着けている人は幸いである。――","tok":[["―"],["―"],["見よ","みよ"],["、"],["わたし"],["は"],["盗人","ぬすびと"],["の"],["よう"],["に"],["来る","くる"],["。"],["裸","はだか"],["で"],["歩く","あるく"],["の"],["を"],["見られて","みられて"],["恥","はじ"],["を"],["かかない"],["よう"],["に"],["、"],["目","め"],["を"],["覚まし","さまし"],["、"],["衣","ころも"],["を"],["身","み"],["に"],["着けて","つけて"],["いる"],["人","ひと"],["は"],["幸い","さいわい"],["で"],["ある"],["。"],["―"],["―"]]},{"verse":16,"text":"汚れた霊どもは、ヘブライ語で「ハルマゲドン」と呼ばれる所に、王たちを集めた。","tok":[["汚れた","よごれた"],["霊","れい"],["ども"],["は"],["、"],["ヘブライ"],["語","ご"],["で"],["「"],["ハルマゲドン"],["」"],["と"],["呼ばれる","よばれる"],["所","ところ"],["に"],["、"],["王","おう"],["たち"],["を"],["集めた","あつめた"],["。"]]},{"verse":17,"text":"第七の天使が、その鉢の中身を空中に注ぐと、神殿の玉座から大声が聞こえ、「事は成就した」と言った。","tok":[["第","だい"],["七","なな"],["の"],["天使","てんし"],["が"],["、"],["その"],["鉢","ばち"],["の"],["中身","なかみ"],["を"],["空中","くうちゅう"],["に"],["注ぐ","そそぐ"],["と"],["、"],["神殿","しんでん"],["の"],["玉座","ぎょくざ"],["から"],["大声","おおごえ"],["が"],["聞こえ","きこえ"],["、"],["「"],["事","こと"],["は"],["成就","じょうじゅ"],["した"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"そして、稲妻、さまざまな音、雷が起こり、また、大きな地震が起きた。それは、人間が地上に現れて以来、いまだかつてなかったほどの大地震であった。","tok":[["そして"],["、"],["稲妻","いなずま"],["、"],["さまざま"],["な"],["音","おと"],["、"],["雷","かみなり"],["が"],["起こり","おこり"],["、"],["また"],["、"],["大きな","おおきな"],["地震","じしん"],["が"],["起きた","おきた"],["。"],["それ"],["は"],["、"],["人間","にんげん"],["が"],["地上","ちじょう"],["に"],["現れて","あらわれて"],["以来","いらい"],["、"],["いまだ"],["かつて"],["なかった"],["ほど"],["の"],["大地震","だいじしん"],["で"],["あった"],["。"]]},{"verse":19,"text":"あの大きな都が三つに引き裂かれ、諸国の民の方々の町が倒れた。神は大バビロンを思い出して、御自分の激しい怒りのぶどう酒の杯をこれにお与えになった。","tok":[["あの"],["大きな","おおきな"],["都","と"],["が"],["三","みっ"],["つ"],["に"],["引き裂かれ","ひきさかれ"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["方々","かたがた"],["の"],["町","まち"],["が"],["倒れた","たおれた"],["。"],["神","かみ"],["は"],["大","だい"],["バビロン"],["を"],["思い出して","おもいだして"],["、"],["御自分","ごじぶん"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["ぶどう酒","ぶどうしゅ"],["の"],["杯","さかずき"],["を"],["これ"],["に"],["お与え","おあたえ"],["に"],["なった"],["。"]]},{"verse":20,"text":"すべての島は逃げ去り、山々も消えうせた。","tok":[["すべて"],["の"],["島","しま"],["は"],["逃げ去り","にげさり"],["、"],["山々","やまやま"],["も"],["消えうせた","きえうせた"],["。"]]},{"verse":21,"text":"一タラントンの重さほどの大粒の雹が、天から人々の上に降った。人々は雹の害を受けたので、神を冒瀆した。その被害があまりにも甚だしかったからである。","tok":[["一","いち"],["タラントン"],["の"],["重さ","おもさ"],["ほど"],["の"],["大粒","おおつぶ"],["の"],["雹","ひょう"],["が"],["、"],["天","てん"],["から"],["人々","ひとびと
[{"verse":1,"text":"小羊が第七の封印を開いたとき、天は半時間ほど沈黙に包まれた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["七","なな"],["の"],["封印","ふういん"],["を"],["開いた","ひらいた"],["とき"],["、"],["天","てん"],["は"],["半","はん"],["時間","じかん"],["ほど"],["沈黙","ちんもく"],["に"],["包まれた","つつまれた"],["。"]]},{"verse":2,"text":"そして、わたしは七人の天使が神の御前に立っているのを見た。彼らには七つのラッパが与えられた。","tok":[["そして"],["、"],["わたし"],["は"],["七人","ななにん"],["の"],["天使","てんし"],["が"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["に"],["は"],["七","なな"],["つ"],["の"],["ラッパ"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":3,"text":"また、別の天使が来て、手に金の香炉を持って祭壇のそばに立つと、この天使に多くの香が渡された。すべての聖なる者たちの祈りに添えて、玉座の前にある金の祭壇に献げるためである。","tok":[["また"],["、"],["別","べつ"],["の"],["天使","てんし"],["が"],["来て","きて"],["、"],["手","て"],["に"],["金","かね"],["の"],["香炉","こうろ"],["を"],["持って","もって"],["祭壇","さいだん"],["の"],["そば"],["に"],["立つ","たつ"],["と"],["、"],["この"],["天使","てんし"],["に"],["多く","おおく"],["の"],["香","こう"],["が"],["渡された","わたされた"],["。"],["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["祈り","いのり"],["に"],["添えて","そえて"],["、"],["玉座","ぎょくざ"],["の"],["前","まえ"],["に"],["ある"],["金","かね"],["の"],["祭壇","さいだん"],["に"],["献げる","ささげる"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"香の煙は、天使の手から、聖なる者たちの祈りと共に神の御前へ立ち上った。","tok":[["香","こう"],["の"],["煙","けむり"],["は"],["、"],["天使","てんし"],["の"],["手","て"],["から"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["祈り","いのり"],["と"],["共","とも"],["に"],["神","かみ"],["の"],["御前","ごぜん"],["へ"],["立ち上った","たちのぼった"],["。"]]},{"verse":5,"text":"それから、天使が香炉を取り、それに祭壇の火を満たして地上へ投げつけると、雷、さまざまな音、稲妻、地震が起こった。","tok":[["それ"],["から"],["、"],["天使","てんし"],["が"],["香炉","こうろ"],["を"],["取り","とり"],["、"],["それ"],["に"],["祭壇","さいだん"],["の"],["火","ひ"],["を"],["満たして","みたして"],["地上","ちじょう"],["へ"],["投げつける","なげつける"],["と"],["、"],["雷","かみなり"],["、"],["さまざま"],["な"],["音","おと"],["、"],["稲妻","いなずま"],["、"],["地震","じしん"],["が"],["起こった","おこった"],["。"]]},{"verse":6,"text":"さて、七つのラッパを持っている七人の天使たちが、ラッパを吹く用意をした。","tok":[["さて"],["、"],["七","なな"],["つ"],["の"],["ラッパ"],["を"],["持って","もって"],["いる"],["七人","ななにん"],["の"],["天使","てんし"],["たち"],["が"],["、"],["ラッパ"],["を"],["吹く","ふく"],["用意","ようい"],["を"],["した"],["。"]]},{"verse":7,"text":"第一の天使がラッパを吹いた。すると、血の混じった雹と火とが生じ、地上に投げ入れられた。地上の三分の一が焼け、木々の三分の一が焼け、すべての青草も焼けてしまった。","tok":[["第","だい"],["一","いち"],["の"],["天使","てんし"],["が"],["ラッパ"],["を"],["吹いた","ふいた"],["。"],["する"],["と"],["、"],["血","ち"],["の"],["混じった","まじった"],["雹","ひょう"],["と"],["火","ひ"],["と"],["が"],["生じ","しょうじ"],["、"],["地上","ちじょう"],["に"],["投げ入れられた","なげいれられた"],["。"],["地上","ちじょう"],["の"],["三分","さんぶん"],["の"],["一","いち"],["が"],["焼け","やけ"],["、"],["木々","きぎ"],["の"],["三分","さんぶん"],["の"],["一","いち"],["が"],["焼け","やけ"],["、"],["すべて"],["の"],["青草","あおくさ"],["も"],["焼けて","やけて"],["しまった"],["。"]]},{"verse":8,"text":"第二の天使がラッパを吹いた。すると、火で燃えている大きな山のようなものが、海に投げ入れられた。海の三分の一が血に変わり、","tok":[["第","だい"],["二","に"],["の"],["天使","てんし"],["が"],["ラッパ"],["を"],["吹いた","ふいた"],["。"],["する"],["と"],["、"],["火","ひ"],["で"],["燃えて","もえて"],["いる"],["大きな","おおきな"],["山","やま"],["の"],["よう"],["な"],["もの"],["が"],["、"],["海","うみ"],["に"],["投げ入れられた","なげいれられた"],["。"],["海","うみ"],["の"],["三分","さんぶん"],["の"],["一","いち"],["が"],["血","ち"],["に"],["変わり","かわり"],["、"]]},{"verse":9,"text":"また、被造物で海に住む生き物の三分の一は死に、船という船の三分の一が壊された。","tok":[["また"],["、"],["被","ひ"],["造物","ぞうぶつ"],["で"],["海","うみ"],["に"],["住む","すむ"],["生き物","いきもの"],["の"],["三分","さんぶん"],["の"],["一","いち"],["は"],["死に","しに"],["、"],["船","ふね"],["と"],["いう"],["船","ふね"],["の"],["三分","さんぶん"],["の"],["一","いち"],["が"],["壊された","こわされた"],["。"]]},{"verse":10,"text":"第三の天使がラッパを吹いた。すると、松明のように燃えている大きな星が、天から落ちて来て、川という川の三分の一と、その水源の上に落ちた。","tok":[["第","だい"],["三","さん"],["の"],["天使","てんし"],["が"],["ラッパ"],["を"],["吹いた","ふいた"],["。"],["する"],["と"],["、"],["松明","たいまつ"],["の"],["よう"],["に"],["燃えて","もえて"],["いる"],["大きな","おおきな"],["星","ほし"],["が"],["、"],["天","てん"],["から"],["落ちて","おちて"],["来て","きて"],["、"],["川","かわ"],["と"],["いう"],["川","かわ"],["の"],["三分","さんぶん"],["の"],["一","いち"],["と"],["、"],["その"],["水源","すいげん"],["の"],["上","うえ"],["に"],["落ちた","おちた"],["。"]]},{"verse":11,"text":"この星の名は「苦よもぎ」といい、水の三分の一が苦よもぎのように苦くなって、そのために多くの人が死んだ。","tok":[["この"],["星","ほし"],["の"],["名",
[{"verse":1,"text":"わたしはまた、新しい天と新しい地を見た。最初の天と最初の地は去って行き、もはや海もなくなった。","tok":[["わたし"],["は"],["また"],["、"],["新しい","あたらしい"],["天","てん"],["と"],["新しい","あたらしい"],["地","ち"],["を"],["見た","みた"],["。"],["最初","さいしょ"],["の"],["天","てん"],["と"],["最初","さいしょ"],["の"],["地","ち"],["は"],["去って","さって"],["行き","いき"],["、"],["もはや"],["海","うみ"],["も"],["なくなった"],["。"]]},{"verse":2,"text":"更にわたしは、聖なる都、新しいエルサレムが、夫のために着飾った花嫁のように用意を整えて、神のもとを離れ、天から下って来るのを見た。","tok":[["更に","さらに"],["わたし"],["は"],["、"],["聖","せい"],["なる"],["都","と"],["、"],["新しい","あたらしい"],["エルサレム"],["が"],["、"],["夫","おっと"],["の"],["ため"],["に"],["着飾った","きかざった"],["花嫁","はなよめ"],["の"],["よう"],["に"],["用意","ようい"],["を"],["整えて","ととのえて"],["、"],["神","かみ"],["の"],["もと"],["を"],["離れ","はなれ"],["、"],["天","てん"],["から"],["下って","くだって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":3,"text":"そのとき、わたしは玉座から語りかける大きな声を聞いた。「見よ、神の幕屋が人の間にあって、神が人と共に住み、人は神の民となる。神は自ら人と共にいて、その神となり、","tok":[["その"],["とき"],["、"],["わたし"],["は"],["玉座","ぎょくざ"],["から"],["語りかける","かたりかける"],["大きな","おおきな"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["「"],["見よ","みよ"],["、"],["神","かみ"],["の"],["幕屋","まくや"],["が"],["人","ひと"],["の"],["間","あいだ"],["に"],["あって"],["、"],["神","かみ"],["が"],["人","ひと"],["と"],["共","とも"],["に"],["住み","すみ"],["、"],["人","ひと"],["は"],["神","かみ"],["の"],["民","たみ"],["と"],["なる"],["。"],["神","かみ"],["は"],["自ら","みずから"],["人","ひと"],["と"],["共","とも"],["に"],["いて"],["、"],["その"],["神","かみ"],["と"],["なり"],["、"]]},{"verse":4,"text":"彼らの目の涙をことごとくぬぐい取ってくださる。もはや死はなく、もはや悲しみも嘆きも労苦もない。最初のものは過ぎ去ったからである。」","tok":[["彼","かれ"],["ら"],["の"],["目","め"],["の"],["涙","なみだ"],["を"],["ことごとく"],["ぬぐい取って","ぬぐいとって"],["くださる"],["。"],["もはや"],["死","し"],["は"],["なく"],["、"],["もはや"],["悲しみ","かなしみ"],["も"],["嘆き","なげき"],["も"],["労苦","ろうく"],["も"],["ない"],["。"],["最初","さいしょ"],["の"],["もの"],["は"],["過ぎ去った","すぎさった"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":5,"text":"すると、玉座に座っておられる方が、「見よ、わたしは万物を新しくする」と言い、また、「書き記せ。これらの言葉は信頼でき、また真実である」と言われた。","tok":[["する"],["と"],["、"],["玉座","ぎょくざ"],["に"],["座って","すわって"],["おられる"],["方","ほう"],["が"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["万物","ばんぶつ"],["を"],["新しく","あたらしく"],["する"],["」"],["と"],["言い","いい"],["、"],["また"],["、"],["「"],["書き記せ","かきしるせ"],["。"],["これ"],["ら"],["の"],["言葉","ことば"],["は"],["信頼","しんらい"],["でき"],["、"],["また"],["真実","しんじつ"],["で"],["ある"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":6,"text":"また、わたしに言われた。「事は成就した。わたしはアルファであり、オメガである。初めであり、終わりである。渇いている者には、命の水の泉から価なしに飲ませよう。","tok":[["また"],["、"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["事","こと"],["は"],["成就","じょうじゅ"],["した"],["。"],["わたし"],["は"],["アルファ"],["で"],["あり"],["、"],["オメガ"],["で"],["ある"],["。"],["初め","はじめ"],["で"],["あり"],["、"],["終わり","おわり"],["で"],["ある"],["。"],["渇いて","かわいて"],["いる"],["者","もの"],["に"],["は"],["、"],["命","いのち"],["の"],["水","みず"],["の"],["泉","いずみ"],["から"],["価","あたい"],["なし"],["に"],["飲ませよう","のませよう"],["。"]]},{"verse":7,"text":"勝利を得る者は、これらのものを受け継ぐ。わたしはその者の神になり、その者はわたしの子となる。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["は"],["、"],["これ"],["ら"],["の"],["もの"],["を"],["受け継ぐ","うけつぐ"],["。"],["わたし"],["は"],["その"],["者","もの"],["の"],["神","かみ"],["に"],["なり"],["、"],["その"],["者","もの"],["は"],["わたし"],["の"],["子","こ"],["と"],["なる"],["。"]]},{"verse":8,"text":"しかし、おくびょうな者、不信仰な者、忌まわしい者、人を殺す者、みだらな行いをする者、魔術を使う者、偶像を拝む者、すべてうそを言う者、このような者たちに対する報いは、火と硫黄の燃える池である。それが、第二の死である。」","tok":[["しかし"],["、"],["おくびょう"],["な"],["者","もの"],["、"],["不","ふ"],["信仰","しんこう"],["な"],["者","もの"],["、"],["忌まわしい","いまわしい"],["者","もの"],["、"],["人","ひと"],["を"],["殺す","ころす"],["者","もの"],["、"],["みだら"],["な"],["行い","おこない"],["を"],["する"],["者","もの"],["、"],["魔術","まじゅつ"],["を"],["使う","つかう"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["拝む","おがむ"],["者","もの"],["、"],["すべて"],["うそ"],["を"],["言う","いう"],["者","もの"],["、"],["この"],["よう"],["な"],["者","もの"],["たち"],["に"],["対する","たいする"],["報い","むくい"],["は"],["、"],["火","ひ"],["と"],["硫黄","いおう"],["の"],["燃える","もえる"],["池","いけ"],["で"],["ある"],["。"],["それ"],["が"],["、"],["第","だい"],["二","に"],["の"],["死","し"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"さて、最後の七つの災いの満ちた七つの鉢を持つ七人の天使がいたが、その中の一人が来て、わたしに語りかけてこう言った。「ここへ来なさい。小羊の妻である花嫁を見せてあげよう。」","tok":[["さて"],["、"],["最後","さいご"],["の"],["七","なな"],["つ"],["の"],["災い","わざわい"],["の"],["満ちた","みちた"],["七","なな"],["つ"],["の"],["鉢","ばち"],["を"],["持つ","もつ"],["七人","ななにん"],["の"],["天使","てんし"],["が"],["いた"],["が"],["、"],["その"],["中","なか"],["の"],["一人","ひとり"],["が"],["来て","きて"],["、"],["わたし"],["に"],["語りかけて","かたりかけて"],["こう"],["言った","いった"],["。"],["「"],["ここ"],["へ"],["来","き"],["なさい"],["。"],["小羊","こひつじ"],["の"],["妻","つま"],["で"],["ある"],["花嫁","はなよめ"],["を"],["見せて","みせて"],["あげよう"],["。"],["」"]]},{"verse":10,"text":"この天使が、“霊”に満たされたわたしを大きな高い山に連れて行き、聖なる都エルサレムが神のもとを離れて、天から下って来るのを見せた。","tok":[["この"],["天使","てんし"],["が"],["、"],["“"],["霊","れい"],["”"],["に"],["満たされた","みたされた"],["わたし"],["を"],["大きな","おおきな"],["高い","たかい"],["山","やま"],["に"],["連れて","つれて"],["行き","いき"],["、"],["聖","せい"],["なる"],["都","と"],["エルサレム"],["が"],["神","かみ"],["の"],["もと"],["を"],["離れて","はなれて"],["、"],["天","てん"],["から"],["下って","くだって"],["来る","くる"],["の"],["を"],["見せた","みせた"],["。"]]},{"verse":11,"text":"都は神の栄光に輝いていた。その輝きは、最高の宝石のようであり、透き通った碧玉のようであった。","tok":[["都","と"],["は"],["神","かみ"],["の"],["栄光","えいこう"],["に"],["輝いて","かがやいて"],["いた"],["。"],["その"],["輝き","かがやき"],["は"],["、"],["最高","さいこう"],["の"],["宝石","ほうせき"],["の"],["よう"],["で"],["あり"],["、"],["透き通った","すきとおった"],["碧玉","へきぎょく"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":12,"text":"都には、高い大きな城壁と十二の門があり、それらの門には十二人の天使がいて、名が刻みつけてあった。イスラエルの子らの十二部族の名であった。","tok":[["都","と"],["に"],["は"],["、"],["高い","たかい"],["大きな","おおきな"],["城壁","じょうへき"],["と"],["十二","じゅうに"],["の"],["門","もん"],["が"],["あり"],["、"],["それ"],["ら"],["の"],["門","もん"],["に"],["は"],["十二人","じゅうににん"],["の"],["天使","てんし"],["が"],["いて"],["、"],["名","な"],["が"],["刻みつけて","きざみつけて"],["あった"],["。"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["十二","じゅうに"],["部族","ぶぞく"],["の"],["名","な"],["で"],["あった"],["。"]]},{"verse":13,"text":"東に三つの門、北に三つの門、南に三つの門、西に三つの門があった。","tok":[["東","ひがし"],["に"],["三","みっ"],["つ"],["の"],["門","もん"],["、"],["北","きた"],["に"],["三","みっ"],["つ"],["の"],["門","もん"],["、"],["南","みなみ"],["に"],["三","みっ"],["つ"],["の"],["門","もん"],["、"],["西","にし"],["に"],["三","みっ"],["つ"],["の"],["門","もん"],["が"],["あった"],["。"]]},{"verse":14,"text":"都の城壁には十二の土台があって、それには小羊の十二使徒の十二の名が刻みつけてあった。","tok":[["都","と"],["の"],["城壁","じょうへき"],["に"],["は"],["十二","じゅうに"],["の"],["土台","どだい"],["が"],["あって"],["、"],["それ"],["に"],["は"],["小羊","こひつじ"],["の"],["十二","じゅうに"],["使徒","しと"],["の"],["十二","じゅうに"],["の"],["名","な"],["が"],["刻みつけて","きざみつけて"],["あった"],["。"]]},{"verse":15,"text":"わたしに語りかけた天使は、都とその門と城壁とを測るために、金の物差しを持っていた。","tok":[["わたし"],["に"],["語りかけた","かたりかけた"],["天使","てんし"],["は"],["、"],["都","と"],["と"],["その"],["門","もん"],["と"],["城壁","じょうへき"],["と"],["を"],["測る","はかる"],["ため"],["に"],["、"],["金","きん"],["の"],["物差し","ものさし"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":16,"text":"この都は四角い形で、長さと幅が同じであった。天使が物差しで都を測ると、一万二千スタディオンあった。長さも幅も高さも同じである。","tok":[["この"],["都","と"],["は"],["四角い","しかくい"],["形","かたち"],["で"],["、"],["長さ","ながさ"],["と"],["幅","はば"],["が"],["同じ","おなじ"],["で"],["あった"],["。"],["天使","てんし"],["が"],["物差し","ものさし"],["で"],["都","と"],["を"],["測る","はかる"],["と"],["、"],["一万二千","いちまんにせん"],["スタディオン"],["あった"],["。"],["長さ","ながさ"],["も"],["幅","はば"],["も"],["高さ","たかさ"],["も"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":17,"text":"また、城壁を測ると、百四十四ペキスであった。これは人間の物差しによって測ったもので、天使が用いたものもこれである。","tok":[["また"],["、"],["城壁","じょうへき"],["を"],["測る","はかる"],["と"],["、"],["百四十四","ひゃくよんじゅうよん"],["ペキス"],["で"],["あった"],["。"],["これ"],["は"],["人間","にんげん"],["の"],["物差し","ものさし"],["によって"],["測った","はかった"],["もの"],["で"],["、"],["天使","てんし"],["が"],["用いた","もちいた"],["もの"],["も"],["これ"],["で"],["ある"],["。"]]},{"verse":18,"text":"都の城壁は碧玉で築かれ、都は透き通ったガラスのような純金であった。","tok":[["都","と"],["の"],["城壁","じょうへき"],["は"],["碧玉","へきぎょく"],["で"],["築かれ","きずかれ"],["、"],["都","と"],["は"],["透き通った","すきとおった"],["ガラス"],["の"],["よう"],["な"],["純金","じゅんきん"],["で"],["あった"],["。"]]},{"verse":19,"text":"都の城壁の土台石は、あらゆる宝石で飾られていた。第一の土台石は碧玉、第二はサファイア、第三はめのう、第四はエメラルド、","tok":[["都","と"],["の"],["城壁","じょうへき"],["の"],["土台石","どだいせき"],["は"],["、"],["あらゆる"],["宝石","ほうせき"],["で"],["飾られて","かざられて"],["いた"],["。"],["第","だい"],["一","いち"],["の"],["土台石","どだいせき"],["は"],["碧玉","へきぎょく"],["、"],["第","だい"],["二","に"],["は"],["サファイア"],["、"],["第","だい"],["三","さん"],["は"],["めのう"],["、"],["第","だい"],["四","よん"],["は"],["エメラルド"],["、"]]},{"verse":20,"text":"第五は赤縞めのう、第六は赤めのう、第七はかんらん石、第八は緑柱石、第九は黄玉、第十はひすい、第十一は青玉、第十二は紫水晶であった。","tok":[["第","だい"],["五","ご"],["は"],["赤縞","あかしま"],["めのう"],["、"],["第","だい"],["六","ろく"],["は"],["赤め","あかめ"],["のう"],["、"],["第","だい"],["七","なな"],["は"],["かんらん"],["石","せき"],["、"],["第","だい"],["八","はち"],["は"],["緑柱石","りょくちゅうせき"],["、"],["第","だい"],["九","きゅう"],["は"],["黄玉","おうぎょく"],["、"],["第","だい"],["十","じゅう"],["は"],["ひすい"],["、"],["第","だい"],["十一","じゅういち"],["は"],["青玉","せいぎょく"],["、"],["第","だい"],["十二","じゅうに"],["は"],["紫水晶","むらさきすいしょう"],["で"],["あった"],["。"]]},{"verse":21,"text":"また、十二の門は十二の真珠であって、どの門もそれぞれ一個の真珠でできていた。都の大通りは、透き通ったガラスのような純金であった。","tok":[["また"],["、"],["十二","じゅうに"],["の"],["門","もん"],["は"],["十二","じゅうに"],["の"],["真珠","しんじゅ"],["で"],["あって"],["、"],["どの"],["門","もん"],["も"],["それぞれ"],["一個","いちこ"],["の"],["真珠","しんじゅ"],["で"],["できて"],["いた"],["。"],["都","と"],["の"],["大通り","おおどおり"],["は"],["、"],["透き通った","すきとおった"],["ガラス"],["の"],["よう"],["な"],["純金","じゅんきん"],["で"],["あった"],["。"]]},{"verse":22,"text":"わたしは、都の中に神殿を見なかった。全能者である神、主と小羊とが都の神殿だからである。","tok":[["わたし"],["は"],["、"],["都","と"],["の"],["中","なか"],["に"],["神殿","しんでん"],["を"],["見なかった","みなかった"],["。"],["全能者","ぜんのうしゃ"],["で"],["ある"],["神","かみ"],["、"],["主","ぬし"],["と"],["小羊","こひつじ"],["と"],["が"],["都","と"],["の"],["神殿","しんでん"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"この都には、それを照らす太陽も月も、必要でない。神の栄光が都を照らしており、小羊が都の明かりだからである。","tok":[["この"],["都","と"],["に"],["は"],["、"],["それ"],["を"],["照らす","てらす"],["太陽","たいよう"],["も"],["月","つき"],["も"],["、"],["必要","ひつよう"],["で"],["ない"],["。"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["都","と"],["を"],["照らして","てらして"],["おり"],["、"],["小羊","こひつじ"],["が"],["都","と"],["の"],["明かり","あかり"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"諸国の民は、都の光の中を歩き、地上の王たちは、自分たちの栄光を携えて、都に来る。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["は"],["、"],["都","と"],["の"],["光","ひかり"],["の"],["中","なか"],["を"],["歩き","あるき"],["、"],["地上","ちじょう"],["の"],["王","おう"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["栄光","えいこう"],["を"],["携えて","たずさえて"],["、"],["都","と"],["に"],["来る","くる"],["。"]]},{"verse":25,"text":"都の門は、一日中決して閉ざされない。そこには夜がないからである。","tok":[["都","と"],["の"],["門","もん"],["は"],["、"],["一","いち"],["日中","にちちゅう"],["決して","けっして"],["閉ざされない","とざされない"],["。"],["そこ"],["に"],["は"],["夜","よる"],["が"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"人々は、諸国の民の栄光と誉れとを携えて都に来る。","tok":[["人々","ひとびと"],["は"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["栄光","えいこう"],["と"],["誉れ","ほまれ"],["と"],["を"],["携えて","たずさえて"],["都","と"],["に"],["来る","くる"],["。"]]},{"verse":27,"text":"しかし、汚れた者、忌まわしいことと偽りを行う者はだれ一人、決して都に入れない。小羊の命の書に名が書いてある者だけが入れる。","tok":[["しかし"],["、"],["汚れた","よごれた"],["者","もの"],["、"],["忌まわしい","いまわしい"],["こと"],["と"],["偽り","いつわり"],["を"],["行う","おこなう"],["者","もの"],["は"],["だれ"],["一人","ひとり"],["、"],["決して","けっして"],["都","と"],["に"],["入れない","いれない"],["。"],["小羊","こひつじ"],["の"],["命","いのち"],["の"],["書","しょ"],["に"],["名","な"],["が"],["書いて","かいて"],["ある"],["者","もの"],["だけ"],["が"],["入れる","いれる"],["。"]]}]
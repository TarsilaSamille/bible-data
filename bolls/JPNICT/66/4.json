[{"verse":1,"text":"その後、わたしが見ていると、見よ、開かれた門が天にあった。そして、ラッパが響くようにわたしに語りかけるのが聞こえた、あの最初の声が言った。「ここへ上って来い。この後必ず起こることをあなたに示そう。」","tok":[["その"],["後","ご"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["開かれた","ひらかれた"],["門","もん"],["が"],["天","てん"],["に"],["あった"],["。"],["そして"],["、"],["ラッパ"],["が"],["響く","ひびく"],["よう"],["に"],["わたし"],["に"],["語りかける","かたりかける"],["の"],["が"],["聞こえた","きこえた"],["、"],["あの"],["最初","さいしょ"],["の"],["声","こえ"],["が"],["言った","いった"],["。"],["「"],["ここ"],["へ"],["上って","のぼって"],["来い","こい"],["。"],["この"],["後","あと"],["必ず","かならず"],["起こる","おこる"],["こと"],["を"],["あなた"],["に"],["示そう","しめそう"],["。"],["」"]]},{"verse":2,"text":"わたしは、たちまち“霊”に満たされた。すると、見よ、天に玉座が設けられていて、その玉座の上に座っている方がおられた。","tok":[["わたし"],["は"],["、"],["たちまち"],["“"],["霊","れい"],["”"],["に"],["満たされた","みたされた"],["。"],["する"],["と"],["、"],["見よ","みよ"],["、"],["天","てん"],["に"],["玉座","ぎょくざ"],["が"],["設けられて","もうけられて"],["いて"],["、"],["その"],["玉座","ぎょくざ"],["の"],["上","うえ"],["に"],["座って","すわって"],["いる"],["方","ほう"],["が"],["おられた"],["。"]]},{"verse":3,"text":"その方は、碧玉や赤めのうのようであり、玉座の周りにはエメラルドのような虹が輝いていた。","tok":[["その"],["方","かた"],["は"],["、"],["碧玉","へきぎょく"],["や"],["赤","あか"],["めのう"],["の"],["よう"],["で"],["あり"],["、"],["玉座","ぎょくざ"],["の"],["周り","まわり"],["に"],["は"],["エメラルド"],["の"],["よう"],["な"],["虹","にじ"],["が"],["輝いて","かがやいて"],["いた"],["。"]]},{"verse":4,"text":"また、玉座の周りに二十四の座があって、それらの座の上には白い衣を着て、頭に金の冠をかぶった二十四人の長老が座っていた。","tok":[["また"],["、"],["玉座","ぎょくざ"],["の"],["周り","まわり"],["に"],["二十四","にじゅうよん"],["の"],["座","ざ"],["が"],["あって"],["、"],["それ"],["ら"],["の"],["座","ざ"],["の"],["上","うえ"],["に"],["は"],["白い","しろい"],["衣","ころも"],["を"],["着て","きて"],["、"],["頭","あたま"],["に"],["金","かね"],["の"],["冠","かんむり"],["を"],["かぶった"],["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["が"],["座って","すわって"],["いた"],["。"]]},{"verse":5,"text":"玉座からは、稲妻、さまざまな音、雷が起こった。また、玉座の前には、七つのともし火が燃えていた。これは神の七つの霊である。","tok":[["玉座","ぎょくざ"],["から"],["は"],["、"],["稲妻","いなずま"],["、"],["さまざま"],["な"],["音","おと"],["、"],["雷","かみなり"],["が"],["起こった","おこった"],["。"],["また"],["、"],["玉座","ぎょくざ"],["の"],["前","まえ"],["に"],["は"],["、"],["七","なな"],["つ"],["の"],["ともし火","ともしび"],["が"],["燃えて","もえて"],["いた"],["。"],["これ"],["は"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["で"],["ある"],["。"]]},{"verse":6,"text":"また、玉座の前は、水晶に似たガラスの海のようであった。この玉座の中央とその周りに四つの生き物がいたが、前にも後ろにも一面に目があった。","tok":[["また"],["、"],["玉座","ぎょくざ"],["の"],["前","まえ"],["は"],["、"],["水晶","すいしょう"],["に"],["似た","にた"],["ガラス"],["の"],["海","うみ"],["の"],["よう"],["で"],["あった"],["。"],["この"],["玉座","ぎょくざ"],["の"],["中央","ちゅうおう"],["と"],["その"],["周り","まわり"],["に"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["が"],["いた"],["が"],["、"],["前","まえ"],["に"],["も"],["後ろ","うしろ"],["に"],["も"],["一面","いちめん"],["に"],["目","め"],["が"],["あった"],["。"]]},{"verse":7,"text":"第一の生き物は獅子のようであり、第二の生き物は若い雄牛のようで、第三の生き物は人間のような顔を持ち、第四の生き物は空を飛ぶ鷲のようであった。","tok":[["第","だい"],["一","いち"],["の"],["生き物","いきもの"],["は"],["獅子","しし"],["の"],["よう"],["で"],["あり"],["、"],["第","だい"],["二","に"],["の"],["生き物","いきもの"],["は"],["若い","わかい"],["雄牛","おうし"],["の"],["よう"],["で"],["、"],["第","だい"],["三","さん"],["の"],["生き物","いきもの"],["は"],["人間","にんげん"],["の"],["よう"],["な"],["顔","かお"],["を"],["持ち","もち"],["、"],["第","だい"],["四","よん"],["の"],["生き物","いきもの"],["は"],["空","そら"],["を"],["飛ぶ","とぶ"],["鷲","わし"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":8,"text":"この四つの生き物には、それぞれ六つの翼があり、その周りにも内側にも、一面に目があった。彼らは、昼も夜も絶え間なく言い続けた。「聖なるかな、聖なるかな、聖なるかな、全能者である神、主、かつておられ、今おられ、やがて来られる方。」","tok":[["この"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["に"],["は"],["、"],["それぞれ"],["六","むい"],["つ"],["の"],["翼","つばさ"],["が"],["あり"],["、"],["その"],["周り","まわり"],["に"],["も"],["内側","うちがわ"],["に"],["も"],["、"],["一面","いちめん"],["に"],["目","め"],["が"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["絶え間","たえま"],["なく"],["言い","いい"],["続けた","つづけた"],["。"],["「"],["聖","せい"],["なる"],["か"],["な"],["、"],["聖","せい"],["なる"],["か"],["な"],["、"],["聖","せい"],["なる"],["か"],["な"],["、"],["全能者","ぜんのうしゃ"],["で"],["ある"],["神","かみ"],["、"],["主","ぬし"],["、"],["かつて"],["おられ"],["、"],["今","いま"],["おられ"],["、"],["やがて"],["来られる","こられる"],["方","かた"],["。"],["」"]]},{"verse":9,"text":"玉座に座っておられ、世々限りなく生きておられる方に、これらの生き物が、栄光と誉れをたたえて感謝をささげると、","tok":[["玉座","ぎょくざ"],["に"],["座って","すわって"],["おられ"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["生きて","いきて"],["おられる"],["方","かた"],["に"],["、"],["これ"],["ら"],["の"],["生き物","いきもの"],["が"],["、"],["栄光","えいこう"],["と"],["誉れ","ほまれ"],["を"],["たたえて"],["感謝","かんしゃ"],["を"],["ささげる"],["と"],["、"]]},{"verse":10,"text":"二十四人の長老は、玉座に着いておられる方の前にひれ伏して、世々限りなく生きておられる方を礼拝し、自分たちの冠を玉座の前に投げ出して言った。","tok":[["二十四人","にじゅうよんにん"],["の"],["長老","ちょうろう"],["は"],["、"],["玉座","ぎょくざ"],["に"],["着いて","ついて"],["おられる"],["方","かた"],["の"],["前","まえ"],["に"],["ひれ伏して","ひれふして"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["生きて","いきて"],["おられる"],["方","かた"],["を"],["礼拝","れいはい"],["し"],["、"],["自分","じぶん"],["たち"],["の"],["冠","かんむり"],["を"],["玉座","ぎょくざ"],["の"],["前","まえ"],["に"],["投げ出して","なげだして"],["言った","いった"],["。"]]},{"verse":11,"text":"「主よ、わたしたちの神よ、あなたこそ、栄光と誉れと力とを受けるにふさわしい方。あなたは万物を造られ、御心によって万物は存在し、また創造されたからです。」","tok":[["「"],["主","ぬし"],["よ"],["、"],["わたしたち"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["こそ"],["、"],["栄光","えいこう"],["と"],["誉れ","ほまれ"],["と"],["力","ちから"],["と"],["を"],["受ける","うける"],["に"],["ふさわしい"],["方","ほう"],["。"],["あなた"],["は"],["万物","ばんぶつ"],["を"],["造られ","つくられ"],["、"],["御心","おこころ"],["によって"],["万物","ばんぶつ"],["は"],["存在","そんざい"],["し"],["、"],["また"],["創造","そうぞう"],["された"],["から"],["です"],["。"],["」"]]}]
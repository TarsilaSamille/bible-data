[{"verse":1,"text":"イエス‧キリストの黙示。この黙示は、すぐにも起こるはずのことを、神がその僕たちに示すためキリストにお与えになり、そして、キリストがその天使を送って僕ヨハネにお伝えになったものである。","tok":[["イエス"],["‧"],["キリスト"],["の"],["黙示","もくし"],["。"],["この"],["黙示","もくし"],["は"],["、"],["すぐ"],["に"],["も"],["起こる","おこる"],["はず"],["の"],["こと"],["を"],["、"],["神","かみ"],["が"],["その"],["僕たち","ぼくたち"],["に"],["示す","しめす"],["ため"],["キリスト"],["に"],["お与え","おあたえ"],["に"],["なり"],["、"],["そして"],["、"],["キリスト"],["が"],["その"],["天使","てんし"],["を"],["送って","おくって"],["僕","ぼく"],["ヨハネ"],["に"],["お伝え","おつたえ"],["に"],["なった"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"ヨハネは、神の言葉とイエス‧キリストの証し、すなわち、自分の見たすべてのことを証しした。","tok":[["ヨハネ"],["は"],["、"],["神","かみ"],["の"],["言葉","ことば"],["と"],["イエス"],["‧"],["キリスト"],["の"],["証し","あかし"],["、"],["すなわち"],["、"],["自分","じぶん"],["の"],["見た","みた"],["すべて"],["の"],["こと"],["を"],["証し","あかし"],["した"],["。"]]},{"verse":3,"text":"この預言の言葉を朗読する人と、これを聞いて、中に記されたことを守る人たちとは幸いである。時が迫っているからである。","tok":[["この"],["預言","よげん"],["の"],["言葉","ことば"],["を"],["朗読","ろうどく"],["する"],["人","ひと"],["と"],["、"],["これ"],["を"],["聞いて","きいて"],["、"],["中","なか"],["に"],["記された","しるされた"],["こと"],["を"],["守る","まもる"],["人","ひと"],["たち"],["と"],["は"],["幸い","さいわい"],["で"],["ある"],["。"],["時","じ"],["が"],["迫って","せまって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"ヨハネからアジア州にある七つの教会へ。今おられ、かつておられ、やがて来られる方から、また、玉座の前におられる七つの霊から、更に、証人、誠実な方、死者の中から最初に復活した方、地上の王たちの支配者、イエス‧キリストから恵みと平和があなたがたにあるように。わたしたちを愛し、御自分の血によって罪から解放してくださった方に、","tok":[["ヨハネ"],["から"],["アジア州","あじあしゅう"],["に"],["ある"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["へ"],["。"],["今","いま"],["おられ"],["、"],["かつて"],["おられ"],["、"],["やがて"],["来られる","こられる"],["方","かた"],["から"],["、"],["また"],["、"],["玉座","ぎょくざ"],["の"],["前","まえ"],["に"],["おられる"],["七","なな"],["つ"],["の"],["霊","れい"],["から"],["、"],["更に","さらに"],["、"],["証人","しょうにん"],["、"],["誠実","せいじつ"],["な"],["方","かた"],["、"],["死者","ししゃ"],["の"],["中","なか"],["から"],["最初","さいしょ"],["に"],["復活","ふっかつ"],["した"],["方","かた"],["、"],["地上","ちじょう"],["の"],["王","おう"],["たち"],["の"],["支配者","しはいしゃ"],["、"],["イエス"],["‧"],["キリスト"],["から"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"],["わたしたち"],["を"],["愛し","あいし"],["、"],["御自分","ごじぶん"],["の"],["血","ち"],["によって"],["罪","つみ"],["から"],["解放","かいほう"],["して"],["くださった"],["方","ほう"],["に"],["、"]]},{"verse":6,"text":"わたしたちを王とし、御自身の父である神に仕える祭司としてくださった方に、栄光と力が世々限りなくありますように、アーメン。","tok":[["わたしたち"],["を"],["王","おう"],["と"],["し"],["、"],["御自身","ごじしん"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["に"],["仕える","つかえる"],["祭司","さいし"],["として"],["くださった"],["方","ほう"],["に"],["、"],["栄光","えいこう"],["と"],["力","ちから"],["が"],["世々","せいせい"],["限りなく","かぎりなく"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]},{"verse":7,"text":"見よ、その方が雲に乗って来られる。すべての人の目が彼を仰ぎ見る、ことに、彼を突き刺した者どもは。地上の諸民族は皆、彼のために嘆き悲しむ。然り、アーメン。","tok":[["見よ","みよ"],["、"],["その"],["方","ほう"],["が"],["雲","くも"],["に"],["乗って","のって"],["来られる","こられる"],["。"],["すべて"],["の"],["人","ひと"],["の"],["目","め"],["が"],["彼","かれ"],["を"],["仰ぎ見る","あおぎみる"],["、"],["こと"],["に"],["、"],["彼","かれ"],["を"],["突き刺した","つきさした"],["者","もの"],["ども"],["は"],["。"],["地上","ちじょう"],["の"],["諸","しょ"],["民族","みんぞく"],["は"],["皆","みな"],["、"],["彼","かれ"],["の"],["ため"],["に"],["嘆き悲しむ","なげきかなしむ"],["。"],["然り","しかり"],["、"],["アーメン"],["。"]]},{"verse":8,"text":"神である主、今おられ、かつておられ、やがて来られる方、全能者がこう言われる。「わたしはアルファであり、オメガである。」","tok":[["神","かみ"],["で"],["ある"],["主","ぬし"],["、"],["今","いま"],["おられ"],["、"],["かつて"],["おられ"],["、"],["やがて"],["来られる","こられる"],["方","かた"],["、"],["全能者","ぜんのうしゃ"],["が"],["こう"],["言われる","いわれる"],["。"],["「"],["わたし"],["は"],["アルファ"],["で"],["あり"],["、"],["オメガ"],["で"],["ある"],["。"],["」"]]},{"verse":9,"text":"わたしは、あなたがたの兄弟であり、共にイエスと結ばれて、その苦難、支配、忍耐にあずかっているヨハネである。わたしは、神の言葉とイエスの証しのゆえに、パトモスと呼ばれる島にいた。","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["で"],["あり"],["、"],["共","とも"],["に"],["イエス"],["と"],["結ばれて","むすばれて"],["、"],["その"],["苦難","くなん"],["、"],["支配","しはい"],["、"],["忍耐","にんたい"],["に"],["あずかって"],["いる"],["ヨハネ"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["神","かみ"],["の"],["言葉","ことば"],["と"],["イエス"],["の"],["証し","あかし"],["の"],["ゆえ"],["に"],["、"],["パトモス"],["と"],["呼ばれる","よばれる"],["島","しま"],["に"],["いた"],["。"]]},{"verse":10,"text":"ある主の日のこと、わたしは“霊”に満たされていたが、後ろの方でラッパのように響く大声を聞いた。","tok":[["ある"],["主","ぬし"],["の"],["日","ひ"],["の"],["こと"],["、"],["わたし"],["は"],["“"],["霊","れい"],["”"],["に"],["満たされて","みたされて"],["いた"],["が"],["、"],["後ろ","うしろ"],["の"],["方","ほう"],["で"],["ラッパ"],["の"],["よう"],["に"],["響く","ひびく"],["大声","おおごえ"],["を"],["聞いた","きいた"],["。"]]},{"verse":11,"text":"その声はこう言った。「あなたの見ていることを巻物に書いて、エフェソ、スミルナ、ペルガモン、ティアティラ、サルディス、フィラデルフィア、ラオディキアの七つの教会に送れ。」","tok":[["その"],["声","こえ"],["は"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["の"],["見て","みて"],["いる"],["こと"],["を"],["巻物","まきもの"],["に"],["書いて","かいて"],["、"],["エフェソ"],["、"],["スミルナ"],["、"],["ペルガモン"],["、"],["ティア"],["ティラ"],["、"],["サルディス"],["、"],["フィラデルフィア"],["、"],["ラオディキア"],["の"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["に"],["送れ","おくれ"],["。"],["」"]]},{"verse":12,"text":"わたしは、語りかける声の主を見ようとして振り向いた。振り向くと、七つの金の燭台が見え、","tok":[["わたし"],["は"],["、"],["語りかける","かたりかける"],["声","こえ"],["の"],["主","ぬし"],["を"],["見よう","みよう"],["として"],["振り向いた","ふりむいた"],["。"],["振り向く","ふりむく"],["と"],["、"],["七","なな"],["つ"],["の"],["金","かね"],["の"],["燭台","しょくだい"],["が"],["見え","みえ"],["、"]]},{"verse":13,"text":"燭台の中央には、人の子のような方がおり、足まで届く衣を着て、胸には金の帯を締めておられた。","tok":[["燭台","しょくだい"],["の"],["中央","ちゅうおう"],["に"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["な"],["方","ほう"],["が"],["おり"],["、"],["足","あし"],["まで"],["届く","とどく"],["衣","ころも"],["を"],["着て","きて"],["、"],["胸","むね"],["に"],["は"],["金","きん"],["の"],["帯","おび"],["を"],["締めて","しめて"],["おられた"],["。"]]},{"verse":14,"text":"その頭、その髪の毛は、白い羊毛に似て、雪のように白く、目はまるで燃え盛る炎、","tok":[["その"],["頭","あたま"],["、"],["その"],["髪の毛","かみのけ"],["は"],["、"],["白い","しろい"],["羊毛","ようもう"],["に"],["似て","にて"],["、"],["雪","ゆき"],["の"],["よう"],["に"],["白く","しろく"],["、"],["目","め"],["は"],["まるで"],["燃え盛る","もえさかる"],["炎","ほのお"],["、"]]},{"verse":15,"text":"足は炉で精錬されたしんちゅうのように輝き、声は大水のとどろきのようであった。","tok":[["足","あし"],["は"],["炉","ろ"],["で"],["精錬","せいれん"],["された"],["しんちゅう"],["の"],["よう"],["に"],["輝き","かがやき"],["、"],["声","こえ"],["は"],["大水","おおみず"],["の"],["とどろき"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":16,"text":"右の手に七つの星を持ち、口からは鋭い両刃の剣が出て、顔は強く照り輝く太陽のようであった。","tok":[["右","みぎ"],["の"],["手","て"],["に"],["七","なな"],["つ"],["の"],["星","ほし"],["を"],["持ち","もち"],["、"],["口","くち"],["から"],["は"],["鋭い","するどい"],["両刃","りょうば"],["の"],["剣","けん"],["が"],["出て","でて"],["、"],["顔","かお"],["は"],["強く","つよく"],["照り輝く","てりかがやく"],["太陽","たいよう"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":17,"text":"わたしは、その方を見ると、その足もとに倒れて、死んだようになった。すると、その方は右手をわたしの上に置いて言われた。「恐れるな。わたしは最初の者にして最後の者、","tok":[["わたし"],["は"],["、"],["その"],["方","ほう"],["を"],["見る","みる"],["と"],["、"],["その"],["足もと","あしもと"],["に"],["倒れて","たおれて"],["、"],["死んだ","しんだ"],["よう"],["に"],["なった"],["。"],["する"],["と"],["、"],["その"],["方","かた"],["は"],["右手","みぎて"],["を"],["わたし"],["の"],["上","うえ"],["に"],["置いて","おいて"],["言われた","いわれた"],["。"],["「"],["恐れる","おそれる"],["な"],["。"],["わたし"],["は"],["最初","さいしょ"],["の"],["者","もの"],["に"],["して"],["最後","さいご"],["の"],["者","もの"],["、"]]},{"verse":18,"text":"また生きている者である。一度は死んだが、見よ、世々限りなく生きて、死と陰府の鍵を持っている。","tok":[["また"],["生きて","いきて"],["いる"],["者","もの"],["で"],["ある"],["。"],["一度","いちど"],["は"],["死んだ","しんだ"],["が"],["、"],["見よ","みよ"],["、"],["世々","せいせい"],["限りなく","かぎりなく"],["生きて","いきて"],["、"],["死","し"],["と"],["陰府","よみ"],["の"],["鍵","かぎ"],["を"],["持って","もって"],["いる"],["。"]]},{"verse":19,"text":"さあ、見たことを、今あることを、今後起ころうとしていることを書き留めよ。","tok":[["さあ"],["、"],["見た","みた"],["こと"],["を"],["、"],["今","いま"],["ある"],["こと"],["を"],["、"],["今後","こんご"],["起ころう","おころう"],["として"],["いる"],["こと"],["を"],["書き留めよ","かきとめよ"],["。"]]},{"verse":20,"text":"あなたは、わたしの右の手に七つの星と、七つの金の燭台とを見たが、それらの秘められた意味はこうだ。七つの星は七つの教会の天使たち、七つの燭台は七つの教会である。","tok":[["あなた"],["は"],["、"],["わたし"],["の"],["右","みぎ"],["の"],["手","て"],["に"],["七","なな"],["つ"],["の"],["星","ほし"],["と"],["、"],["七","なな"],["つ"],["の"],["金","かね"],["の"],["燭台","しょくだい"],["と"],["を"],["見た","みた"],["が"],["、"],["それ"],["ら"],["の"],["秘められた","ひめられた"],["意味","いみ"],["は"],["こう"],["だ"],["。"],["七","なな"],["つ"],["の"],["星","ほし"],["は"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["の"],["天使","てんし"],["たち"],["、"],["七","なな"],["つ"],["の"],["燭台","しょくだい"],["は"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["で"],["ある"],["。"]]}]
[{"verse":1,"text":"天使はまた、神と小羊の玉座から流れ出て、水晶のように輝く命の水の川をわたしに見せた。","tok":[["天使","てんし"],["は"],["また"],["、"],["神","かみ"],["と"],["小羊","こひつじ"],["の"],["玉座","ぎょくざ"],["から"],["流れ出て","ながれでて"],["、"],["水晶","すいしょう"],["の"],["よう"],["に"],["輝く","かがやく"],["命","いのち"],["の"],["水","みず"],["の"],["川","かわ"],["を"],["わたし"],["に"],["見せた","みせた"],["。"]]},{"verse":2,"text":"川は、都の大通りの中央を流れ、その両岸には命の木があって、年に十二回実を結び、毎月実をみのらせる。そして、その木の葉は諸国の民の病を治す。","tok":[["川","かわ"],["は"],["、"],["都","と"],["の"],["大通り","おおどおり"],["の"],["中央","ちゅうおう"],["を"],["流れ","ながれ"],["、"],["その"],["両岸","りょうがん"],["に"],["は"],["命","いのち"],["の"],["木","き"],["が"],["あって"],["、"],["年","ねん"],["に"],["十二","じゅうに"],["回","かい"],["実","じつ"],["を"],["結び","むすび"],["、"],["毎月","まいつき"],["実","じつ"],["を"],["みのらせる"],["。"],["そして"],["、"],["その"],["木の葉","このは"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["病","やまい"],["を"],["治す","なおす"],["。"]]},{"verse":3,"text":"もはや、呪われるものは何一つない。神と小羊の玉座が都にあって、神の僕たちは神を礼拝し、","tok":[["もはや"],["、"],["呪われる","のろわれる"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["ない"],["。"],["神","かみ"],["と"],["小羊","こひつじ"],["の"],["玉座","ぎょくざ"],["が"],["都","と"],["に"],["あって"],["、"],["神","かみ"],["の"],["僕たち","ぼくたち"],["は"],["神","かみ"],["を"],["礼拝","れいはい"],["し"],["、"]]},{"verse":4,"text":"御顔を仰ぎ見る。彼らの額には、神の名が記されている。","tok":[["御顔","おかお"],["を"],["仰ぎ見る","あおぎみる"],["。"],["彼","かれ"],["ら"],["の"],["額","がく"],["に"],["は"],["、"],["神","かみ"],["の"],["名","な"],["が"],["記されて","しるされて"],["いる"],["。"]]},{"verse":5,"text":"もはや、夜はなく、ともし火の光も太陽の光も要らない。神である主が僕たちを照らし、彼らは世々限りなく統治するからである。","tok":[["もはや"],["、"],["夜","よる"],["は"],["なく"],["、"],["ともし火","ともしび"],["の"],["光","ひかり"],["も"],["太陽","たいよう"],["の"],["光","ひかり"],["も"],["要らない","いらない"],["。"],["神","かみ"],["で"],["ある"],["主","ぬし"],["が"],["僕たち","ぼくたち"],["を"],["照らし","てらし"],["、"],["彼","かれ"],["ら"],["は"],["世々","せいせい"],["限りなく","かぎりなく"],["統治","とうち"],["する"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"そして、天使はわたしにこう言った。「これらの言葉は、信頼でき、また真実である。預言者たちの霊感の神、主が、その天使を送って、すぐにも起こるはずのことを、御自分の僕たちに示されたのである。","tok":[["そして"],["、"],["天使","てんし"],["は"],["わたし"],["に"],["こう"],["言った","いった"],["。"],["「"],["これ"],["ら"],["の"],["言葉","ことば"],["は"],["、"],["信頼","しんらい"],["でき"],["、"],["また"],["真実","しんじつ"],["で"],["ある"],["。"],["預言者","よげんしゃ"],["たち"],["の"],["霊感","れいかん"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["その"],["天使","てんし"],["を"],["送って","おくって"],["、"],["すぐ"],["に"],["も"],["起こる","おこる"],["はず"],["の"],["こと"],["を"],["、"],["御自分","ごじぶん"],["の"],["僕たち","ぼくたち"],["に"],["示された","しめされた"],["ので"],["ある"],["。"]]},{"verse":7,"text":"見よ、わたしはすぐに来る。この書物の預言の言葉を守る者は、幸いである。」","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["すぐ"],["に"],["来る","くる"],["。"],["この"],["書物","しょもつ"],["の"],["預言","よげん"],["の"],["言葉","ことば"],["を"],["守る","まもる"],["者","もの"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["。"],["」"]]},{"verse":8,"text":"わたしは、これらのことを聞き、また見たヨハネである。聞き、また見たとき、わたしは、このことを示してくれた天使の足もとにひれ伏して、拝もうとした。","tok":[["わたし"],["は"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["聞き","きき"],["、"],["また"],["見た","みた"],["ヨハネ"],["で"],["ある"],["。"],["聞き","きき"],["、"],["また"],["見た","みた"],["とき"],["、"],["わたし"],["は"],["、"],["この"],["こと"],["を"],["示して","しめして"],["くれた"],["天使","てんし"],["の"],["足もと","あしもと"],["に"],["ひれ伏して","ひれふして"],["、"],["拝もう","おがもう"],["と"],["した"],["。"]]},{"verse":9,"text":"すると、天使はわたしに言った。「やめよ。わたしは、あなたや、あなたの兄弟である預言者たちや、この書物の言葉を守っている人たちと共に、仕える者である。神を礼拝せよ。」","tok":[["する"],["と"],["、"],["天使","てんし"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["やめ"],["よ"],["。"],["わたし"],["は"],["、"],["あなた"],["や"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["や"],["、"],["この"],["書物","しょもつ"],["の"],["言葉","ことば"],["を"],["守って","まもって"],["いる"],["人","ひと"],["たち"],["と"],["共","とも"],["に"],["、"],["仕える","つかえる"],["者","もの"],["で"],["ある"],["。"],["神","かみ"],["を"],["礼拝","れいはい"],["せよ"],["。"],["」"]]},{"verse":10,"text":"また、わたしにこう言った。「この書物の預言の言葉を、秘密にしておいてはいけない。時が迫っているからである。","tok":[["また"],["、"],["わたし"],["に"],["こう"],["言った","いった"],["。"],["「"],["この"],["書物","しょもつ"],["の"],["預言","よげん"],["の"],["言葉","ことば"],["を"],["、"],["秘密","ひみつ"],["に"],["して"],["おいて"],["は"],["いけない"],["。"],["時","じ"],["が"],["迫って","せまって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"不正を行う者には、なお不正を行わせ、汚れた者は、なお汚れるままにしておけ。正しい者には、なお正しいことを行わせ、聖なる者は、なお聖なる者とならせよ。","tok":[["不正","ふせい"],["を"],["行う","おこなう"],["者","もの"],["に"],["は"],["、"],["なお"],["不正","ふせい"],["を"],["行わせ","おこなわせ"],["、"],["汚れた","よごれた"],["者","もの"],["は"],["、"],["なお"],["汚れる","よごれる"],["まま"],["に"],["して"],["おけ"],["。"],["正しい","ただしい"],["者","もの"],["に"],["は"],["、"],["なお"],["正しい","ただしい"],["こと"],["を"],["行わせ","おこなわせ"],["、"],["聖","せい"],["なる"],["者","もの"],["は"],["、"],["なお"],["聖","せい"],["なる"],["者","もの"],["と"],["ならせ"],["よ"],["。"]]},{"verse":12,"text":"見よ、わたしはすぐに来る。わたしは、報いを携えて来て、それぞれの行いに応じて報いる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["すぐ"],["に"],["来る","くる"],["。"],["わたし"],["は"],["、"],["報い","むくい"],["を"],["携えて","たずさえて"],["来て","きて"],["、"],["それぞれ"],["の"],["行い","おこない"],["に"],["応じて","おうじて"],["報いる","むくいる"],["。"]]},{"verse":13,"text":"わたしはアルファであり、オメガである。最初の者にして、最後の者。初めであり、終わりである。","tok":[["わたし"],["は"],["アルファ"],["で"],["あり"],["、"],["オメガ"],["で"],["ある"],["。"],["最初","さいしょ"],["の"],["者","もの"],["に"],["して"],["、"],["最後","さいご"],["の"],["者","もの"],["。"],["初め","はじめ"],["で"],["あり"],["、"],["終わり","おわり"],["で"],["ある"],["。"]]},{"verse":14,"text":"命の木に対する権利を与えられ、門を通って都に入れるように、自分の衣を洗い清める者は幸いである。","tok":[["命","いのち"],["の"],["木","き"],["に"],["対する","たいする"],["権利","けんり"],["を"],["与えられ","あたえられ"],["、"],["門","もん"],["を"],["通って","とおって"],["都","と"],["に"],["入れる","いれる"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["衣","ころも"],["を"],["洗い清める","あらいきよめる"],["者","もの"],["は"],["幸い","さいわい"],["で"],["ある"],["。"]]},{"verse":15,"text":"犬のような者、魔術を使う者、みだらなことをする者、人を殺す者、偶像を拝む者、すべて偽りを好み、また行う者は都の外にいる。","tok":[["犬","いぬ"],["の"],["よう"],["な"],["者","もの"],["、"],["魔術","まじゅつ"],["を"],["使う","つかう"],["者","もの"],["、"],["みだら"],["な"],["こと"],["を"],["する"],["者","もの"],["、"],["人","ひと"],["を"],["殺す","ころす"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["拝む","おがむ"],["者","もの"],["、"],["すべて"],["偽り","いつわり"],["を"],["好み","このみ"],["、"],["また"],["行う","おこなう"],["者","もの"],["は"],["都","と"],["の"],["外","そと"],["に"],["いる"],["。"]]},{"verse":16,"text":"わたし、イエスは使いを遣わし、諸教会のために以上のことをあなたがたに証しした。わたしは、ダビデのひこばえ、その一族、輝く明けの明星である。」","tok":[["わたし"],["、"],["イエス"],["は"],["使い","つかい"],["を"],["遣わし","つかわし"],["、"],["諸教","しょきょう"],["会","かい"],["の"],["ため"],["に"],["以上","いじょう"],["の"],["こと"],["を"],["あなた"],["がた"],["に"],["証し","あかし"],["した"],["。"],["わたし"],["は"],["、"],["ダビデ"],["の"],["ひこばえ"],["、"],["その"],["一族","いちぞく"],["、"],["輝く","かがやく"],["明け","あけ"],["の"],["明星","みょうじょう"],["で"],["ある"],["。"],["」"]]},{"verse":17,"text":"“霊”と花嫁とが言う。「来てください。」これを聞く者も言うがよい、「来てください」と。渇いている者は来るがよい。命の水が欲しい者は、価なしに飲むがよい。","tok":[["“"],["霊","れい"],["”"],["と"],["花嫁","はなよめ"],["と"],["が"],["言う","ゆう"],["。"],["「"],["来て","きて"],["ください"],["。"],["」"],["これ"],["を"],["聞く","きく"],["者","もの"],["も"],["言う","ゆう"],["が"],["よい"],["、"],["「"],["来て","きて"],["ください"],["」"],["と"],["。"],["渇いて","かわいて"],["いる"],["者","もの"],["は"],["来る","くる"],["が"],["よい"],["。"],["命","いのち"],["の"],["水","みず"],["が"],["欲しい","ほしい"],["者","もの"],["は"],["、"],["価","あたい"],["なし"],["に"],["飲む","のむ"],["が"],["よい"],["。"]]},{"verse":18,"text":"この書物の預言の言葉を聞くすべての者に、わたしは証しする。これに付け加える者があれば、神はこの書物に書いてある災いをその者に加えられる。","tok":[["この"],["書物","しょもつ"],["の"],["預言","よげん"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["すべて"],["の"],["者","もの"],["に"],["、"],["わたし"],["は"],["証し","あかし"],["する"],["。"],["これ"],["に"],["付け加える","つけくわえる"],["者","もの"],["が"],["あれば"],["、"],["神","かみ"],["は"],["この"],["書物","しょもつ"],["に"],["書いて","かいて"],["ある"],["災い","わざわい"],["を"],["その"],["者","もの"],["に"],["加えられる","くわえられる"],["。"]]},{"verse":19,"text":"また、この預言の書の言葉から何か取り去る者があれば、神は、この書物に書いてある命の木と聖なる都から、その者が受ける分を取り除かれる。","tok":[["また"],["、"],["この"],["預言","よげん"],["の"],["書","しょ"],["の"],["言葉","ことば"],["から"],["何","なん"],["か"],["取り去る","とりさる"],["者","もの"],["が"],["あれば"],["、"],["神","かみ"],["は"],["、"],["この"],["書物","しょもつ"],["に"],["書いて","かいて"],["ある"],["命","いのち"],["の"],["木","き"],["と"],["聖","せい"],["なる"],["都","と"],["から"],["、"],["その"],["者","もの"],["が"],["受ける","うける"],["分","ぶん"],["を"],["取り除かれる","とりのぞかれる"],["。"]]},{"verse":20,"text":"以上すべてを証しする方が、言われる。「然り、わたしはすぐに来る。」アーメン、主イエスよ、来てください。","tok":[["以上","いじょう"],["すべて"],["を"],["証し","あかし"],["する"],["方","ほう"],["が"],["、"],["言われる","いわれる"],["。"],["「"],["然り","しかり"],["、"],["わたし"],["は"],["すぐ"],["に"],["来る","くる"],["。"],["」"],["アーメン"],["、"],["主","しゅ"],["イエス"],["よ"],["、"],["来て","きて"],["ください"],["。"]]},{"verse":21,"text":"主イエスの恵みが、すべての者と共にあるように。","tok":[["主","しゅ"],["イエス"],["の"],["恵み","めぐみ"],["が"],["、"],["すべて"],["の"],["者","もの"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["。"]]}]
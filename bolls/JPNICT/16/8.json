[{"verse":1,"text":"民は皆、水の門の前にある広場に集まって一人の人のようになった。彼らは書記官エズラに主がイスラエルに授けられたモーセの律法の書を持って来るように求めた。","tok":[["民","みん"],["は"],["皆","みな"],["、"],["水","みず"],["の"],["門","もん"],["の"],["前","まえ"],["に"],["ある"],["広場","ひろば"],["に"],["集まって","あつまって"],["一人","ひとり"],["の"],["人","ひと"],["の"],["よう"],["に"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["書記官","しょきかん"],["エズラ"],["に"],["主","ぬし"],["が"],["イスラエル"],["に"],["授けられた","さずけられた"],["モーセ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["持って","もって"],["来る","くる"],["よう"],["に"],["求めた","もとめた"],["。"]]},{"verse":2,"text":"祭司エズラは律法を会衆の前に持って来た。そこには、男も女も、聞いて理解することのできる年齢に達した者は皆いた。第七の月の一日のことであった。","tok":[["祭司","さいし"],["エズラ"],["は"],["律法","りっぽう"],["を"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["持って","もって"],["来た","きた"],["。"],["そこ"],["に"],["は"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["、"],["聞いて","きいて"],["理解","りかい"],["する"],["こと"],["の"],["できる"],["年齢","ねんれい"],["に"],["達した","たっした"],["者","もの"],["は"],["皆","みな"],["いた"],["。"],["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["一","いち"],["日","にち"],["の"],["こと"],["で"],["あった"],["。"]]},{"verse":3,"text":"彼は水の門の前にある広場に居並ぶ男女、理解することのできる年齢に達した者に向かって、夜明けから正午までそれを読み上げた。民は皆、その律法の書に耳を傾けた。","tok":[["彼","かれ"],["は"],["水","みず"],["の"],["門","もん"],["の"],["前","まえ"],["に"],["ある"],["広場","ひろば"],["に"],["居並ぶ","いならぶ"],["男女","だんじょ"],["、"],["理解","りかい"],["する"],["こと"],["の"],["できる"],["年齢","ねんれい"],["に"],["達した","たっした"],["者","もの"],["に"],["向かって","むかって"],["、"],["夜明け","よあけ"],["から"],["正午","しょうご"],["まで"],["それ"],["を"],["読み上げた","よみあげた"],["。"],["民","たみ"],["は"],["皆","みな"],["、"],["その"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["耳","みみ"],["を"],["傾けた","かたむけた"],["。"]]},{"verse":4,"text":"書記官エズラは、このために用意された木の壇の上に立ち、その右にマティトヤ、シェマ、アナヤ、ウリヤ、ヒルキヤ、マアセヤが、左にペダヤ、ミシャエル、マルキヤ、ハシュム、ハシュバダナ、ゼカルヤ、メシュラムが立った。","tok":[["書記官","しょきかん"],["エズラ"],["は"],["、"],["この"],["ため"],["に"],["用意","ようい"],["された"],["木","き"],["の"],["壇","だん"],["の"],["上","うえ"],["に"],["立ち","たち"],["、"],["その"],["右","みぎ"],["に"],["マティトヤ"],["、"],["シェマ"],["、"],["アナヤ"],["、"],["ウリヤ"],["、"],["ヒルキヤ"],["、"],["マアセヤ"],["が"],["、"],["左","ひだり"],["に"],["ペダヤ"],["、"],["ミシャエル"],["、"],["マルキヤ"],["、"],["ハシュム"],["、"],["ハシュバダナ"],["、"],["ゼカルヤ"],["、"],["メシュラム"],["が"],["立った","たった"],["。"]]},{"verse":5,"text":"エズラは人々より高い所にいたので、皆が見守る中でその書を開いた。彼が書を開くと民は皆、立ち上がった。","tok":[["エズラ"],["は"],["人々","ひとびと"],["より"],["高い","たかい"],["所","ところ"],["に"],["いた"],["ので"],["、"],["皆","みな"],["が"],["見守る","みまもる"],["中","なか"],["で"],["その"],["書","しょ"],["を"],["開いた","ひらいた"],["。"],["彼","かれ"],["が"],["書","しょ"],["を"],["開く","ひらく"],["と"],["民","みん"],["は"],["皆","みな"],["、"],["立ち上がった","たちあがった"],["。"]]},{"verse":6,"text":"エズラが大いなる神、主をたたえると民は皆、両手を挙げて、「アーメン、アーメン」と唱和し、ひざまずき、顔を地に伏せて、主を礼拝した。","tok":[["エズラ"],["が"],["大いなる","おおいなる"],["神","かみ"],["、"],["主","ぬし"],["を"],["たたえる"],["と"],["民","みん"],["は"],["皆","みな"],["、"],["両手","りょうて"],["を"],["挙げて","あげて"],["、"],["「"],["アーメン"],["、"],["アーメン"],["」"],["と"],["唱和","しょうわ"],["し"],["、"],["ひざまずき"],["、"],["顔","かお"],["を"],["地","ち"],["に"],["伏せて","ふせて"],["、"],["主","ぬし"],["を"],["礼拝","れいはい"],["した"],["。"]]},{"verse":7,"text":"次いで、イエシュア、バニ、シェレブヤ、ヤミン、アクブ、シャベタイ、ホディヤ、マアセヤ、ケリタ、アザルヤ、ヨザバド、ハナン、ペラヤというレビ人がその律法を民に説明したが、その間民は立っていた。","tok":[["次いで","ついで"],["、"],["イエシュア"],["、"],["バニ"],["、"],["シェレブヤ"],["、"],["ヤミン"],["、"],["アクブ"],["、"],["シャベタイ"],["、"],["ホディヤ"],["、"],["マアセヤ"],["、"],["ケリタ"],["、"],["アザルヤ"],["、"],["ヨザバド"],["、"],["ハナン"],["、"],["ペラヤ"],["と"],["いう"],["レビ人","れびにん"],["が"],["その"],["律法","りっぽう"],["を"],["民","たみ"],["に"],["説明","せつめい"],["した"],["が"],["、"],["その"],["間民","まみん"],["は"],["立って","たって"],["いた"],["。"]]},{"verse":8,"text":"彼らは神の律法の書を翻訳し、意味を明らかにしながら読み上げたので、人々はその朗読を理解した。","tok":[["彼","かれ"],["ら"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["翻訳","ほんやく"],["し"],["、"],["意味","いみ"],["を"],["明らか","あきらか"],["に"],["し"],["ながら"],["読み上げた","よみあげた"],["ので"],["、"],["人々","ひとびと"],["は"],["その"],["朗読","ろうどく"],["を"],["理解","りかい"],["した"],["。"]]},{"verse":9,"text":"総督ネヘミヤと、祭司であり書記官であるエズラは、律法の説明に当たったレビ人と共に、民全員に言った。「今日は、あなたたちの神、主にささげられた聖なる日だ。嘆いたり、泣いたりしてはならない。」民は皆、律法の言葉を聞いて泣いていた。","tok":[["総督","そうとく"],["ネヘミヤ"],["と"],["、"],["祭司","さいし"],["で"],["あり"],["書記官","しょきかん"],["で"],["ある"],["エズラ"],["は"],["、"],["律法","りっぽう"],["の"],["説明","せつめい"],["に"],["当たった","あたった"],["レビ人","れびにん"],["と"],["共","とも"],["に"],["、"],["民","みん"],["全員","ぜんいん"],["に"],["言った","いった"],["。"],["「"],["今日","きょう"],["は"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主に","おもに"],["ささげられた"],["聖","せい"],["なる"],["日","ひ"],["だ"],["。"],["嘆い","なげい"],["たり"],["、"],["泣い","ない"],["たり"],["して"],["は"],["ならない"],["。"],["」"],["民","みん"],["は"],["皆","みな"],["、"],["律法","りっぽう"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["泣いて","ないて"],["いた"],["。"]]},{"verse":10,"text":"彼らは更に言った。「行って良い肉を食べ、甘い飲み物を飲みなさい。その備えのない者には、それを分け与えてやりなさい。今日は、我らの主にささげられた聖なる日だ。悲しんではならない。主を喜び祝うことこそ、あなたたちの力の源である。」","tok":[["彼","かれ"],["ら"],["は"],["更に","さらに"],["言った","いった"],["。"],["「"],["行って","いって"],["良い","よい"],["肉","にく"],["を"],["食べ","たべ"],["、"],["甘い","あまい"],["飲み物","のみもの"],["を"],["飲み","のみ"],["なさい"],["。"],["その"],["備え","そなえ"],["の"],["ない"],["者","もの"],["に"],["は"],["、"],["それ"],["を"],["分け与えて","わけあたえて"],["やり"],["なさい"],["。"],["今日","きょう"],["は"],["、"],["我","われ"],["ら"],["の"],["主","ぬし"],["に"],["ささげられた"],["聖","せい"],["なる"],["日","ひ"],["だ"],["。"],["悲しんで","かなしんで"],["は"],["ならない"],["。"],["主","ぬし"],["を"],["喜び祝う","よろこびいわう"],["こと"],["こそ"],["、"],["あなた"],["たち"],["の"],["力","ちから"],["の"],["源","みなもと"],["で"],["ある"],["。"],["」"]]},{"verse":11,"text":"レビ人も民全員を静かにさせた。「静かにしなさい。今日は聖なる日だ。悲しんではならない。」","tok":[["レビ人","れびにん"],["も"],["民","みん"],["全員","ぜんいん"],["を"],["静か","しずか"],["に"],["させた"],["。"],["「"],["静か","しずか"],["に"],["し"],["なさい"],["。"],["今日","きょう"],["は"],["聖","せい"],["なる"],["日","ひ"],["だ"],["。"],["悲しんで","かなしんで"],["は"],["ならない"],["。"],["」"]]},{"verse":12,"text":"民は皆、帰って、食べたり飲んだりし、備えのない者と分かち合い、大いに喜び祝った。教えられたことを理解したからである。","tok":[["民","みん"],["は"],["皆","みな"],["、"],["帰って","かえって"],["、"],["食べ","たべ"],["たり"],["飲ん","のん"],["だり"],["し"],["、"],["備え","そなえ"],["の"],["ない"],["者","もの"],["と"],["分かち合い","わかちあい"],["、"],["大いに","おおいに"],["喜び祝った","よろこびいわった"],["。"],["教えられた","おしえられた"],["こと"],["を"],["理解","りかい"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"二日目に、すべての民の家長たちは、祭司、レビ人と共に書記官エズラのもとに集まり、律法の言葉を深く悟ろうとし、","tok":[["二日目","ふたかめ"],["に"],["、"],["すべて"],["の"],["民","たみ"],["の"],["家長","かちょう"],["たち"],["は"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["と"],["共","とも"],["に"],["書記官","しょきかん"],["エズラ"],["の"],["もと"],["に"],["集まり","あつまり"],["、"],["律法","りっぽう"],["の"],["言葉","ことば"],["を"],["深く","ふかく"],["悟ろう","さとろう"],["と"],["し"],["、"]]},{"verse":14,"text":"主がモーセによって授けられたこの律法の中にこう記されているのを見いだした。イスラエルの人々は第七の月の祭りの期間を仮庵で過ごさなければならず、","tok":[["主","ぬし"],["が"],["モーセ"],["によって"],["授けられた","さずけられた"],["この"],["律法","りっぽう"],["の"],["中","なか"],["に"],["こう"],["記されて","しるされて"],["いる"],["の"],["を"],["見いだした","みいだした"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["第","だい"],["七","なな"],["の"],["月","つき"],["の"],["祭り","まつり"],["の"],["期間","きかん"],["を"],["仮庵","かりあん"],["で"],["過ごさなければ","すごさなければ"],["ならず"],["、"]]},{"verse":15,"text":"これを知らせ、エルサレムとすべての町に次のような布告を出さなければならない。「山に行き、オリーブの枝、野生オリーブの枝、ミルトスの枝、なつめやしの枝、その他の葉の多い木の枝を取って来て、書き記されているとおりに仮庵を作りなさい。」","tok":[["これ"],["を"],["知らせ","しらせ"],["、"],["エルサレム"],["と"],["すべて"],["の"],["町","まち"],["に"],["次","つぎ"],["の"],["よう"],["な"],["布告","ふこく"],["を"],["出さなければ","ださなければ"],["ならない"],["。"],["「"],["山","やま"],["に"],["行き","いき"],["、"],["オリーブ"],["の"],["枝","えだ"],["、"],["野生","やせい"],["オリーブ"],["の"],["枝","えだ"],["、"],["ミルトス"],["の"],["枝","えだ"],["、"],["なつめやし"],["の"],["枝","えだ"],["、"],["その"],["他","た"],["の"],["葉","は"],["の"],["多い","おおい"],["木","き"],["の"],["枝","えだ"],["を"],["取って","とって"],["来て","きて"],["、"],["書き記されて","かきしるされて"],["いる"],["とおり"],["に"],["仮庵","かりあん"],["を"],["作り","つくり"],["なさい"],["。"],["」"]]},{"verse":16,"text":"民は出て行き、枝を持って来て、各自の家の屋上、庭、神殿の庭、水の門の広場、エフライムの門の広場に仮庵を作った。","tok":[["民","みん"],["は"],["出て","でて"],["行き","いき"],["、"],["枝","えだ"],["を"],["持って","もって"],["来て","きて"],["、"],["各自","かくじ"],["の"],["家","いえ"],["の"],["屋上","おくじょう"],["、"],["庭","にわ"],["、"],["神殿","しんでん"],["の"],["庭","にわ"],["、"],["水","みず"],["の"],["門","もん"],["の"],["広場","ひろば"],["、"],["エフライム"],["の"],["門","もん"],["の"],["広場","ひろば"],["に"],["仮庵","かりあん"],["を"],["作った","つくった"],["。"]]},{"verse":17,"text":"こうして捕囚の地から帰った人々から成る会衆は、皆で仮庵を作り、そこで過ごした。ヌンの子ヨシュアの時代からこの日まで、イスラエルの人々がこのような祝いを行ったことはなかった。それは、まことに大きな喜びの祝いであった。","tok":[["こう"],["して"],["捕囚","ほしゅう"],["の"],["地","ち"],["から"],["帰った","かえった"],["人々","ひとびと"],["から"],["成る","なる"],["会衆","かいしゅう"],["は"],["、"],["皆","みな"],["で"],["仮庵","かりあん"],["を"],["作り","つくり"],["、"],["そこ"],["で"],["過ごした","すごした"],["。"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["の"],["時代","じだい"],["から"],["この"],["日","ひ"],["まで"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["この"],["よう"],["な"],["祝い","いわい"],["を"],["行った","おこなった"],["こと"],["は"],["なかった"],["。"],["それ"],["は"],["、"],["まこと"],["に"],["大きな","おおきな"],["喜び","よろこび"],["の"],["祝い","いわい"],["で"],["あった"],["。"]]},{"verse":18,"text":"最初の日から最後の日まで、毎日彼は神の律法の書を朗読し、彼らは七日間にわたって祭りを行い、八日目には定めに従って終わりの集会を行った。","tok":[["最初","さいしょ"],["の"],["日","ひ"],["から"],["最後","さいご"],["の"],["日","ひ"],["まで"],["、"],["毎日","まいにち"],["彼","かれ"],["は"],["神","かみ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["朗読","ろうどく"],["し"],["、"],["彼","かれ"],["ら"],["は"],["七","なな"],["日間","かかん"],["に"],["わたって"],["祭り","まつり"],["を"],["行い","おこない"],["、"],["八日目","ようかめ"],["に"],["は"],["定め","さだめ"],["に"],["従って","したがって"],["終わり","おわり"],["の"],["集会","しゅうかい"],["を"],["行った","おこなった"],["。"]]}]
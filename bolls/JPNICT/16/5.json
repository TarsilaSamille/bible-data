[{"verse":1,"text":"民とその妻たちから、同胞のユダの人々に対して大きな訴えの叫びがあがった。","tok":[["民","みん"],["と"],["その"],["妻たち","つまたち"],["から"],["、"],["同胞","どうほう"],["の"],["ユダ"],["の"],["人々","ひとびと"],["に対して","にたいして"],["大きな","おおきな"],["訴え","うったえ"],["の"],["叫び","さけび"],["が"],["あがった"],["。"]]},{"verse":2,"text":"ある者は言った。「わたしたちには多くの息子や娘がいる。食べて生き延びるために穀物がほしい。」","tok":[["ある"],["者","もの"],["は"],["言った","いった"],["。"],["「"],["わたしたち"],["に"],["は"],["多く","おおく"],["の"],["息子","むすこ"],["や"],["娘","むすめ"],["が"],["いる"],["。"],["食べて","たべて"],["生き延びる","いきのびる"],["ため"],["に"],["穀物","こくもつ"],["が"],["ほしい"],["。"],["」"]]},{"verse":3,"text":"またある者は言った。「この飢饉のときに穀物を得るには畑も、ぶどう園も、家も抵当に入れなければならない。」","tok":[["また"],["ある"],["者","もの"],["は"],["言った","いった"],["。"],["「"],["この"],["飢饉","ききん"],["の"],["とき"],["に"],["穀物","こくもつ"],["を"],["得る","うる"],["に"],["は"],["畑","はたけ"],["も"],["、"],["ぶどう園","ぶどうえん"],["も"],["、"],["家","いえ"],["も"],["抵当","ていとう"],["に"],["入れなければ","いれなければ"],["ならない"],["。"],["」"]]},{"verse":4,"text":"またある者は言った。「王が税をかけるので、畑もぶどう園も担保にして金を借りなければならない。","tok":[["また"],["ある"],["者","もの"],["は"],["言った","いった"],["。"],["「"],["王","おう"],["が"],["税","ぜい"],["を"],["かける"],["ので"],["、"],["畑","はたけ"],["も"],["ぶどう園","ぶどうえん"],["も"],["担保","たんぽ"],["に"],["して"],["金","きん"],["を"],["借りなければ","かりなければ"],["ならない"],["。"]]},{"verse":5,"text":"同胞もわたしたちも同じ人間だ。彼らに子供があれば、わたしたちにも子供がある。だが、わたしたちは息子や娘を手放して奴隷にしなければならない。ある娘はもう奴隷になっている。どうすることもできない。畑とぶどう園はもう他人のものだ。」","tok":[["同胞","どうほう"],["も"],["わたしたち"],["も"],["同じ","おなじ"],["人間","にんげん"],["だ"],["。"],["彼","かれ"],["ら"],["に"],["子供","こども"],["が"],["あれば"],["、"],["わたしたち"],["に"],["も"],["子供","こども"],["が"],["ある"],["。"],["だ"],["が"],["、"],["わたしたち"],["は"],["息子","むすこ"],["や"],["娘","むすめ"],["を"],["手放して","てばなして"],["奴隷","どれい"],["に"],["しなければ"],["ならない"],["。"],["ある"],["娘","むすめ"],["は"],["もう"],["奴隷","どれい"],["に"],["なって"],["いる"],["。"],["どう"],["する"],["こと"],["も"],["できない"],["。"],["畑","はたけ"],["と"],["ぶどう園","ぶどうえん"],["は"],["もう"],["他人","たにん"],["の"],["もの"],["だ"],["。"],["」"]]},{"verse":6,"text":"この嘆きと訴えを聞いて、わたしは大いに憤りを覚え、","tok":[["この"],["嘆き","なげき"],["と"],["訴え","うったえ"],["を"],["聞いて","きいて"],["、"],["わたし"],["は"],["大いに","おおいに"],["憤り","いきどおり"],["を"],["覚え","おぼえ"],["、"]]},{"verse":7,"text":"居たたまれなくなって貴族と役人をこう非難した。「あなたたちは同胞に重荷を負わせているではないか。」わたしはまた大きな集会を召集して、","tok":[["居たたまれなく","いたたまれなく"],["なって"],["貴族","きぞく"],["と"],["役人","やくにん"],["を"],["こう"],["非難","ひなん"],["した"],["。"],["「"],["あなた"],["たち"],["は"],["同胞","どうほう"],["に"],["重荷","おもに"],["を"],["負わせて","おわせて"],["いるで"],["は"],["ない"],["か"],["。"],["」"],["わたし"],["は"],["また"],["大きな","おおきな"],["集会","しゅうかい"],["を"],["召集","しょうしゅう"],["して"],["、"]]},{"verse":8,"text":"言った。「わたしたちは異邦人に売られていた同胞のユダの人々を、できるかぎり買い戻した。それなのに、あなたたちはその同胞を売ろうというのか。彼らはわたしたち自身に売られることになるのに。」彼らは黙りこみ、何も言えなかった。","tok":[["言った","いった"],["。"],["「"],["わたしたち"],["は"],["異邦人","いほうじん"],["に"],["売られて","うられて"],["いた"],["同胞","どうほう"],["の"],["ユダ"],["の"],["人々","ひとびと"],["を"],["、"],["できる"],["かぎり"],["買い戻した","かいもどした"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["たち"],["は"],["その"],["同胞","どうほう"],["を"],["売ろう","うろう"],["と"],["いう"],["の"],["か"],["。"],["彼","かれ"],["ら"],["は"],["わたしたち"],["自身","じしん"],["に"],["売られる","うられる"],["こと"],["に"],["なる"],["のに"],["。"],["」"],["彼","かれ"],["ら"],["は"],["黙りこみ","だまりこみ"],["、"],["何","なん"],["も"],["言えなかった","いえなかった"],["。"]]},{"verse":9,"text":"わたしは言った。「あなたたちの行いはよくない。敵である異邦人に辱められないために、神を畏れて生きるはずではないのか。","tok":[["わたし"],["は"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["の"],["行い","おこない"],["は"],["よく"],["ない"],["。"],["敵","てき"],["で"],["ある"],["異邦人","いほうじん"],["に"],["辱められない","はずかしめられない"],["ため"],["に"],["、"],["神","かみ"],["を"],["畏れて","おそれて"],["生きる","いきる"],["はず"],["で"],["は"],["ない"],["の"],["か"],["。"]]},{"verse":10,"text":"わたしも、わたしの兄弟も部下も金や穀物を貸している。わたしたちはその負債を帳消しにする。","tok":[["わたし"],["も"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["も"],["部下","ぶか"],["も"],["金","きん"],["や"],["穀物","こくもつ"],["を"],["貸して","かして"],["いる"],["。"],["わたしたち"],["は"],["その"],["負債","ふさい"],["を"],["帳消し","ちょうけし"],["に"],["する"],["。"]]},{"verse":11,"text":"あなたたちも今日あなたたちに負債のある者に返しなさい。畑も、ぶどう園も、オリーブ園も、家も、利子も、穀物も、ぶどう酒も、油も。」","tok":[["あなた"],["たち"],["も"],["今日","きょう"],["あなた"],["たち"],["に"],["負債","ふさい"],["の"],["ある"],["者","もの"],["に"],["返し","かえし"],["なさい"],["。"],["畑","はたけ"],["も"],["、"],["ぶどう園","ぶどうえん"],["も"],["、"],["オリーブ"],["園","えん"],["も"],["、"],["家","いえ"],["も"],["、"],["利子","りし"],["も"],["、"],["穀物","こくもつ"],["も"],["、"],["ぶどう酒","ぶどうしゅ"],["も"],["、"],["油","あぶら"],["も"],["。"],["」"]]},{"verse":12,"text":"彼らはそれに答えた。「返します。何も要求しません。お言葉どおりにします。」わたしはこの言葉どおり行うよう誓わせるために祭司たちを呼んだ。","tok":[["彼","かれ"],["ら"],["は"],["それ"],["に"],["答えた","こたえた"],["。"],["「"],["返します","かえします"],["。"],["何","なん"],["も"],["要求","ようきゅう"],["しません"],["。"],["お言葉","おことば"],["どおり"],["に"],["します"],["。"],["」"],["わたし"],["は"],["この"],["言葉","ことば"],["どおり"],["行う","おこなう"],["よう"],["誓わせる","ちかわせる"],["ため"],["に"],["祭司","さいし"],["たち"],["を"],["呼んだ","よんだ"],["。"]]},{"verse":13,"text":"わたしはまた衣の折り重ねたところを振るいながら言った。「この約束を守らない者はだれでも、このように神によってその家と財産から離され、振るい落とされるように。このように振るい落とされて無一物となるように。」会衆は皆で、「アーメン」と答え、神を賛美した。民はその言葉どおり行った。","tok":[["わたし"],["は"],["また"],["衣","ころも"],["の"],["折り重ねた","おりかさねた"],["ところ"],["を"],["振るい","ふるい"],["ながら"],["言った","いった"],["。"],["「"],["この"],["約束","やくそく"],["を"],["守らない","まもらない"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["この"],["よう"],["に"],["神","かみ"],["によって"],["その"],["家","いえ"],["と"],["財産","ざいさん"],["から"],["離され","はなされ"],["、"],["振るい落とされる","ふるいおとされる"],["よう"],["に"],["。"],["この"],["よう"],["に"],["振るい落とされて","ふるいおとされて"],["無一物","むいちもつ"],["と"],["なる"],["よう"],["に"],["。"],["」"],["会衆","かいしゅう"],["は"],["皆","みな"],["で"],["、"],["「"],["アーメン"],["」"],["と"],["答え","こたえ"],["、"],["神","かみ"],["を"],["賛美","さんび"],["した"],["。"],["民","たみ"],["は"],["その"],["言葉","ことば"],["どおり"],["行った","いった"],["。"]]},{"verse":14,"text":"アルタクセルクセス王の第二十年に、わたしはユダの地の長官に任命されたが、その日から第三十二年までの十二年間、わたしも兄弟たちも長官の給与を一度も受け取らなかった。","tok":[["アルタ"],["クセルクセス"],["王","おう"],["の"],["第","だい"],["二十","にじゅう"],["年","ねん"],["に"],["、"],["わたし"],["は"],["ユダ"],["の"],["地","ち"],["の"],["長官","ちょうかん"],["に"],["任命","にんめい"],["された"],["が"],["、"],["その"],["日","ひ"],["から"],["第","だい"],["三十二","さんじゅうに"],["年","ねん"],["まで"],["の"],["十二","じゅうに"],["年間","ねんかん"],["、"],["わたし"],["も"],["兄弟","きょうだい"],["たち"],["も"],["長官","ちょうかん"],["の"],["給与","きゅうよ"],["を"],["一度","いちど"],["も"],["受け取らなかった","うけとらなかった"],["。"]]},{"verse":15,"text":"わたしの前任者は民に重荷を負わせ、パンとぶどう酒に加えて、銀四十シェケルを徴収した。彼らの配下の者も民を圧迫した。しかし、わたしは神を畏れ、そのようなことを決して行わなかった。","tok":[["わたし"],["の"],["前任者","ぜんにんしゃ"],["は"],["民","みん"],["に"],["重荷","おもに"],["を"],["負わせ","おわせ"],["、"],["パン"],["と"],["ぶどう酒","ぶどうしゅ"],["に"],["加えて","くわえて"],["、"],["銀","ぎん"],["四十","よんじゅう"],["シェケル"],["を"],["徴収","ちょうしゅう"],["した"],["。"],["彼","かれ"],["ら"],["の"],["配下","はいか"],["の"],["者","もの"],["も"],["民","みん"],["を"],["圧迫","あっぱく"],["した"],["。"],["しかし"],["、"],["わたし"],["は"],["神","かみ"],["を"],["畏れ","おそれ"],["、"],["その"],["よう"],["な"],["こと"],["を"],["決して","けっして"],["行わなかった","おこなわなかった"],["。"]]},{"verse":16,"text":"わたしはこの城壁の工事にも力を注ぎ、土地を買収したりはしなかった。配下の者も皆、工事のためにここに集まっていた。","tok":[["わたし"],["は"],["この"],["城壁","じょうへき"],["の"],["工事","こうじ"],["に"],["も"],["力","ちから"],["を"],["注ぎ","そそぎ"],["、"],["土地","とち"],["を"],["買収","ばいしゅう"],["し"],["たり"],["は"],["しなかった"],["。"],["配下","はいか"],["の"],["者","もの"],["も"],["皆","みな"],["、"],["工事","こうじ"],["の"],["ため"],["に"],["ここ"],["に"],["集まって","あつまって"],["いた"],["。"]]},{"verse":17,"text":"ユダの人々と役人合わせて百五十人、それに周りの国々から来た人々も、わたしの食卓に着いた。","tok":[["ユダ"],["の"],["人々","ひとびと"],["と"],["役人","やくにん"],["合わせて","あわせて"],["百五","ひゃくご"],["十人","じゅうにん"],["、"],["それ"],["に"],["周り","まわり"],["の"],["国々","くにぐに"],["から"],["来た","きた"],["人々","ひとびと"],["も"],["、"],["わたし"],["の"],["食卓","しょくたく"],["に"],["着いた","ついた"],["。"]]},{"verse":18,"text":"毎日用意されたものは、牛一頭、特選の羊六匹、鳥で、わたしのために用意され、十日ごとにはあらゆる種類のぶどう酒が十分用意された。だが、このためにも長官の手当を要求しなかった。再建作業がこの民にとって重荷となっていたからである。","tok":[["毎日","まいにち"],["用意","ようい"],["された"],["もの"],["は"],["、"],["牛","うし"],["一頭","いちとう"],["、"],["特選","とくせん"],["の"],["羊","ひつじ"],["六匹","ろくひき"],["、"],["鳥","とり"],["で"],["、"],["わたし"],["の"],["ため"],["に"],["用意","ようい"],["され"],["、"],["十日","とうか"],["ごと"],["に"],["は"],["あらゆる"],["種類","しゅるい"],["の"],["ぶどう酒","ぶどうしゅ"],["が"],["十分","じゅうぶん"],["用意","ようい"],["された"],["。"],["だ"],["が"],["、"],["この"],["ため"],["に"],["も"],["長官","ちょうかん"],["の"],["手当","てあて"],["を"],["要求","ようきゅう"],["しなかった"],["。"],["再建","さいけん"],["作業","さぎょう"],["が"],["この"],["民","たみ"],["にとって"],["重荷","おもに"],["と"],["なって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"神よ、わたしがこの民に尽くしたすべてのことを快く心に留めてください。","tok":[["神","かみ"],["よ"],["、"],["わたし"],["が"],["この"],["民","たみ"],["に"],["尽くした","つくした"],["すべて"],["の"],["こと"],["を"],["快く","こころよく"],["心","こころ"],["に"],["留めて","とめて"],["ください"],["。"]]}]
[{"verse":1,"text":"アルタクセルクセス王の第二十年、ニサンの月のことであった。王はぶどう酒を前にし、わたしがぶどう酒を取って、王に差し上げていた。わたしは王の前で暗い表情をすることはなかったが、","tok":[["アルタ"],["クセルクセス"],["王","おう"],["の"],["第","だい"],["二十","にじゅう"],["年","ねん"],["、"],["ニサン"],["の"],["月","つき"],["の"],["こと"],["で"],["あった"],["。"],["王","おう"],["は"],["ぶどう酒","ぶどうしゅ"],["を"],["前","まえ"],["に"],["し"],["、"],["わたし"],["が"],["ぶどう酒","ぶどうしゅ"],["を"],["取って","とって"],["、"],["王","おう"],["に"],["差し上げて","さしあげて"],["いた"],["。"],["わたし"],["は"],["王","おう"],["の"],["前","まえ"],["で"],["暗い","くらい"],["表情","ひょうじょう"],["を"],["する"],["こと"],["は"],["なかった"],["が"],["、"]]},{"verse":2,"text":"王はわたしに尋ねた。「暗い表情をしているが、どうかしたのか。病気ではあるまい。何か心に悩みがあるにちがいない。」わたしは非常に恐縮して、","tok":[["王","おう"],["は"],["わたし"],["に"],["尋ねた","たずねた"],["。"],["「"],["暗い","くらい"],["表情","ひょうじょう"],["を"],["して"],["いる"],["が"],["、"],["どう"],["か"],["した"],["の"],["か"],["。"],["病気","びょうき"],["で"],["は"],["あるまい"],["。"],["何","なん"],["か"],["心","こころ"],["に"],["悩み","なやみ"],["が"],["ある"],["に"],["ちがい"],["ない"],["。"],["」"],["わたし"],["は"],["非常","ひじょう"],["に"],["恐縮","きょうしゅく"],["して"],["、"]]},{"verse":3,"text":"王に答えた。「王がとこしえに生き長らえられますように。わたしがどうして暗い表情をせずにおれましょう。先祖の墓のある町が荒廃し、城門は火で焼かれたままなのです。」","tok":[["王","おう"],["に"],["答えた","こたえた"],["。"],["「"],["王","おう"],["が"],["とこしえ"],["に"],["生き長らえられます","いきながらえられます"],["よう"],["に"],["。"],["わたし"],["が"],["どう"],["して"],["暗い","くらい"],["表情","ひょうじょう"],["を"],["せず"],["に"],["おれましょう"],["。"],["先祖","せんぞ"],["の"],["墓","はか"],["の"],["ある"],["町","まち"],["が"],["荒廃","こうはい"],["し"],["、"],["城門","じょうもん"],["は"],["火","ひ"],["で"],["焼かれた","やかれた"],["まま"],["な"],["の"],["です"],["。"],["」"]]},{"verse":4,"text":"すると王は、「何を望んでいるのか」と言った。わたしは天にいます神に祈って、","tok":[["する"],["と"],["王","おう"],["は"],["、"],["「"],["何","なん"],["を"],["望んで","のぞんで"],["いる"],["の"],["か"],["」"],["と"],["言った","いった"],["。"],["わたし"],["は"],["天","てん"],["に"],["います"],["神","かみ"],["に"],["祈って","いのって"],["、"]]},{"verse":5,"text":"王に答えた。「もしも僕がお心に適い、王にお差し支えがなければ、わたしをユダに、先祖の墓のある町にお遣わしください。町を再建したいのでございます。」","tok":[["王","おう"],["に"],["答えた","こたえた"],["。"],["「"],["もし"],["も"],["僕","ぼく"],["が"],["お心","おこころ"],["に"],["適い","かない"],["、"],["王","おう"],["に"],["お差し支え","おさしつかえ"],["が"],["なければ"],["、"],["わたし"],["を"],["ユダ"],["に"],["、"],["先祖","せんぞ"],["の"],["墓","はか"],["の"],["ある"],["町","まち"],["に"],["お遣わし","おつかわし"],["ください"],["。"],["町","まち"],["を"],["再建","さいけん"],["したい"],["ので"],["ございます"],["。"],["」"]]},{"verse":6,"text":"王は傍らに座っている王妃と共に、「旅にはどれほどの時を要するのか。いつ帰れるのか」と尋ねた。わたしの派遣について王が好意的であったので、どれほどの期間が必要なのかを説明し、","tok":[["王","おう"],["は"],["傍ら","かたわら"],["に"],["座って","すわって"],["いる"],["王妃","おうひ"],["と"],["共","とも"],["に"],["、"],["「"],["旅","たび"],["に"],["は"],["どれ"],["ほど"],["の"],["時","とき"],["を"],["要する","ようする"],["の"],["か"],["。"],["いつ"],["帰れる","かえれる"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["わたし"],["の"],["派遣","はけん"],["について"],["王","おう"],["が"],["好意的","こういてき"],["で"],["あった"],["ので"],["、"],["どれ"],["ほど"],["の"],["期間","きかん"],["が"],["必要","ひつよう"],["な"],["の"],["か"],["を"],["説明","せつめい"],["し"],["、"]]},{"verse":7,"text":"更に、わたしは王に言った。「もしもお心に適いますなら、わたしがユダに行き着くまで、わたしを通過させるようにと、ユーフラテス西方の長官たちにあてた書状をいただきとうございます。","tok":[["更に","さらに"],["、"],["わたし"],["は"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["もし"],["も"],["お心","おこころ"],["に"],["適いますなら","かないますなら"],["、"],["わたし"],["が"],["ユダ"],["に"],["行き着く","いきつく"],["まで"],["、"],["わたし"],["を"],["通過","つうか"],["させる"],["よう"],["に"],["と"],["、"],["ユーフラテス"],["西方","せいほう"],["の"],["長官","ちょうかん"],["たち"],["に"],["あてた"],["書状","しょじょう"],["を"],["いただきとう"],["ございます"],["。"]]},{"verse":8,"text":"また、神殿のある都の城門に梁を置くために、町を取り巻く城壁のためとわたしが入る家のために木材をわたしに与えるように、と王の森林管理者アサフにあてた書状もいただきとうございます。」神の御手がわたしを守ってくださったので、王はわたしの願いをかなえてくれた。","tok":[["また"],["、"],["神殿","しんでん"],["の"],["ある"],["都","みやこ"],["の"],["城門","じょうもん"],["に"],["梁","はり"],["を"],["置く","おく"],["ため"],["に"],["、"],["町","まち"],["を"],["取り巻く","とりまく"],["城壁","じょうへき"],["の"],["ため"],["と"],["わたし"],["が"],["入る","はいる"],["家","いえ"],["の"],["ため"],["に"],["木材","もくざい"],["を"],["わたし"],["に"],["与える","あたえる"],["よう"],["に"],["、"],["と"],["王","おう"],["の"],["森林","しんりん"],["管理者","かんりしゃ"],["アサフ"],["に"],["あてた"],["書状","しょじょう"],["も"],["いただきとう"],["ございます"],["。"],["」"],["神","かみ"],["の"],["御手","おて"],["が"],["わたし"],["を"],["守って","まもって"],["くださった"],["ので"],["、"],["王","おう"],["は"],["わたし"],["の"],["願い","ねがい"],["を"],["かなえて"],["くれた"],["。"]]},{"verse":9,"text":"こうして、わたしはユーフラテス西方の長官のもとに到着する度に、王の書状を差し出すことができた。王はまた将校と騎兵をわたしと共に派遣してくれた。","tok":[["こう"],["して"],["、"],["わたし"],["は"],["ユーフラテス"],["西方","せいほう"],["の"],["長官","ちょうかん"],["の"],["もと"],["に"],["到着","とうちゃく"],["する"],["度","たび"],["に"],["、"],["王","おう"],["の"],["書状","しょじょう"],["を"],["差し出す","さしだす"],["こと"],["が"],["できた"],["。"],["王","おう"],["は"],["また"],["将校","しょうこう"],["と"],["騎兵","きへい"],["を"],["わたし"],["と"],["共","とも"],["に"],["派遣","はけん"],["して"],["くれた"],["。"]]},{"verse":10,"text":"ホロニ人サンバラトとアンモン人の僕トビヤは、イスラエルの人々のためになることをしようとする人が遣わされて来たと聞いて、非常に機嫌を損ねた。","tok":[["ホロニ"],["人","ひと"],["サンバラト"],["と"],["アンモン"],["人","にん"],["の"],["僕","ぼく"],["トビヤ"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["なる"],["こと"],["を"],["しよう"],["と"],["する"],["人","ひと"],["が"],["遣わされて","つかわされて"],["来た","きた"],["と"],["聞いて","きいて"],["、"],["非常","ひじょう"],["に"],["機嫌","きげん"],["を"],["損ねた","そこねた"],["。"]]},{"verse":11,"text":"わたしはエルサレムに着き、三日間過ごしてから、","tok":[["わたし"],["は"],["エルサレム"],["に"],["着き","つき"],["、"],["三","みっ"],["日間","かかん"],["過ごして","すごして"],["から"],["、"]]},{"verse":12,"text":"夜、わずか数名の者と共に起きて出かけた。だが、エルサレムで何をすべきかについて、神がわたしの心に示されたことは、だれにも知らせなかった。わたしの乗ったもののほか、一頭の動物も引いて行かなかった。","tok":[["夜","よる"],["、"],["わずか"],["数","すう"],["名","めい"],["の"],["者","もの"],["と"],["共","とも"],["に"],["起きて","おきて"],["出かけた","でかけた"],["。"],["だ"],["が"],["、"],["エルサレム"],["で"],["何","なん"],["を"],["すべき"],["か"],["について"],["、"],["神","かみ"],["が"],["わたし"],["の"],["心","こころ"],["に"],["示された","しめされた"],["こと"],["は"],["、"],["だれ"],["に"],["も"],["知らせなかった","しらせなかった"],["。"],["わたし"],["の"],["乗った","のった"],["もの"],["の"],["ほか"],["、"],["一頭","いちとう"],["の"],["動物","どうぶつ"],["も"],["引いて","ひいて"],["行かなかった","いかなかった"],["。"]]},{"verse":13,"text":"夜中に谷の門を出て、竜の泉の前から糞の門へと巡って、エルサレムの城壁を調べた。城壁は破壊され、城門は焼け落ちていた。","tok":[["夜中","よなか"],["に"],["谷","たに"],["の"],["門","もん"],["を"],["出て","でて"],["、"],["竜","りゅう"],["の"],["泉","いずみ"],["の"],["前","まえ"],["から"],["糞","ふん"],["の"],["門","もん"],["へ"],["と"],["巡って","めぐって"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["調べた","しらべた"],["。"],["城壁","じょうへき"],["は"],["破壊","はかい"],["され"],["、"],["城門","じょうもん"],["は"],["焼け落ちて","やけおちて"],["いた"],["。"]]},{"verse":14,"text":"更に泉の門から王の池へと行ったが、わたしの乗っている動物が通る所もないほどであった。","tok":[["更に","さらに"],["泉","いずみ"],["の"],["門","もん"],["から"],["王","おう"],["の"],["池","いけ"],["へ"],["と"],["行った","いった"],["が"],["、"],["わたし"],["の"],["乗って","のって"],["いる"],["動物","どうぶつ"],["が"],["通る","とおる"],["所","ところ"],["も"],["ない"],["ほど"],["で"],["あった"],["。"]]},{"verse":15,"text":"夜のうちに谷に沿って上りながら城壁を調べ、再び谷の門を通って帰った。","tok":[["夜","よる"],["の"],["うち"],["に"],["谷","たに"],["に"],["沿って","そって"],["上り","のぼり"],["ながら"],["城壁","じょうへき"],["を"],["調べ","しらべ"],["、"],["再び","ふたたび"],["谷","たに"],["の"],["門","もん"],["を"],["通って","とおって"],["帰った","かえった"],["。"]]},{"verse":16,"text":"役人たちは、わたしがどこに行き、何をしたか知らなかった。それまでわたしは、ユダの人々にも、祭司にも、貴族にも、役人にも、工事に携わる他の人々にも、何も知らせてはいなかった。","tok":[["役人","やくにん"],["たち"],["は"],["、"],["わたし"],["が"],["どこ"],["に"],["行き","いき"],["、"],["何","なん"],["を"],["した"],["か"],["知らなかった","しらなかった"],["。"],["それ"],["まで"],["わたし"],["は"],["、"],["ユダ"],["の"],["人々","ひとびと"],["に"],["も"],["、"],["祭司","さいし"],["に"],["も"],["、"],["貴族","きぞく"],["に"],["も"],["、"],["役人","やくにん"],["に"],["も"],["、"],["工事","こうじ"],["に"],["携わる","たずさわる"],["他","ほか"],["の"],["人々","ひとびと"],["に"],["も"],["、"],["何","なん"],["も"],["知らせて","しらせて"],["は"],["いなかった"],["。"]]},{"verse":17,"text":"やがてわたしは彼らに言った。「御覧のとおり、わたしたちは不幸の中であえいでいる。エルサレムは荒廃し、城門は焼け落ちたままだ。エルサレムの城壁を建て直そうではないか。そうすれば、もう恥ずかしいことはない。」","tok":[["やがて"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["御覧","ごらん"],["の"],["とおり"],["、"],["わたしたち"],["は"],["不幸","ふこう"],["の"],["中","なか"],["で"],["あえいで"],["いる"],["。"],["エルサレム"],["は"],["荒廃","こうはい"],["し"],["、"],["城門","じょうもん"],["は"],["焼け落ちた","やけおちた"],["まま"],["だ"],["。"],["エルサレム"],["の"],["城壁","じょうへき"],["を"],["建て直そうで","たてなおそうで"],["は"],["ない"],["か"],["。"],["そう"],["すれば"],["、"],["もう"],["恥ずかしい","はずかしい"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":18,"text":"神の御手が恵み深くわたしを守り、王がわたしに言ってくれた言葉を彼らに告げると、彼らは「早速、建築に取りかかろう」と応じ、この良い企てに奮い立った。","tok":[["神","かみ"],["の"],["御手","おて"],["が"],["恵み","めぐみ"],["深く","ふか
[{"verse":1,"text":"シェアルティエルの子ゼルバベルとイエシュアと共に上って来た祭司とレビ人は、次のとおりである。セラヤ、イルメヤ、エズラ、","tok":[["シェアルティエル"],["の"],["子","こ"],["ゼルバベル"],["と"],["イエシュア"],["と"],["共","とも"],["に"],["上って","のぼって"],["来た","きた"],["祭司","さいし"],["と"],["レビ人","れびにん"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["セラヤ"],["、"],["イルメヤ"],["、"],["エズラ"],["、"]]},{"verse":2,"text":"アマルヤ、マルク、ハトシュ、","tok":[["アマルヤ"],["、"],["マルク"],["、"],["ハトシュ"],["、"]]},{"verse":3,"text":"シェカンヤ、レフム、メレモト、","tok":[["シェカンヤ"],["、"],["レフム"],["、"],["メレモト"],["、"]]},{"verse":4,"text":"イド、ギネトイ、アビヤ、","tok":[["イド"],["、"],["ギネトイ"],["、"],["アビヤ"],["、"]]},{"verse":5,"text":"ミヤミン、マアドヤ、ビルガ、","tok":[["ミヤミン"],["、"],["マアドヤ"],["、"],["ビルガ"],["、"]]},{"verse":6,"text":"シェマヤ、ヨヤリブ、エダヤ、","tok":[["シェマヤ"],["、"],["ヨヤリブ"],["、"],["エダヤ"],["、"]]},{"verse":7,"text":"サル、アモク、ヒルキヤ、エダヤ。以上、イエシュア時代の祭司長とその仲間である。","tok":[["サル"],["、"],["アモク"],["、"],["ヒルキヤ"],["、"],["エダヤ"],["。"],["以上","いじょう"],["、"],["イエシュア"],["時代","じだい"],["の"],["祭司長","さいしちょう"],["と"],["その"],["仲間","なかま"],["で"],["ある"],["。"]]},{"verse":8,"text":"レビ人では、イエシュア、ビヌイ、カドミエル、シェレブヤ、ユダ、マタンヤ。この彼とその仲間が賛歌の責任を負い、","tok":[["レビ人","れびにん"],["で"],["は"],["、"],["イエシュア"],["、"],["ビヌイ"],["、"],["カドミエル"],["、"],["シェレブヤ"],["、"],["ユダ"],["、"],["マタンヤ"],["。"],["この"],["彼","かれ"],["と"],["その"],["仲間","なかま"],["が"],["賛歌","さんか"],["の"],["責任","せきにん"],["を"],["負い","おい"],["、"]]},{"verse":9,"text":"バクブクヤとウンニおよびその仲間が彼らの前で任務に就いた。","tok":[["バクブクヤ"],["と"],["ウンニ"],["および"],["その"],["仲間","なかま"],["が"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["任務","にんむ"],["に"],["就いた","ついた"],["。"]]},{"verse":10,"text":"イエシュアにはヨヤキムが生まれ、ヨヤキムにはエルヤシブが生まれ、エルヤシブにはヨヤダが生まれ、","tok":[["イエシュア"],["に"],["は"],["ヨヤキム"],["が"],["生まれ","うまれ"],["、"],["ヨヤキム"],["に"],["は"],["エルヤシブ"],["が"],["生まれ","うまれ"],["、"],["エルヤシブ"],["に"],["は"],["ヨヤダ"],["が"],["生まれ","うまれ"],["、"]]},{"verse":11,"text":"ヨヤダにはヨナタンが生まれ、ヨナタンにはヤドアが生まれた。","tok":[["ヨヤダ"],["に"],["は"],["ヨナタン"],["が"],["生まれ","うまれ"],["、"],["ヨナタン"],["に"],["は"],["ヤドア"],["が"],["生まれた","うまれた"],["。"]]},{"verse":12,"text":"ヨヤキム時代に祭司で家長であった者は、セラヤ家のメラヤ、イルメヤ家のハナンヤ、","tok":[
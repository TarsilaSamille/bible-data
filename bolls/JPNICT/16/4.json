[{"verse":1,"text":"サンバラトとトビヤ、それにアラブ人、アンモン人、アシュドドの市民は、エルサレムの城壁の再建が進み、破損の修復が始まったと聞いて、大いに怒った。","tok":[["サンバラト"],["と"],["トビヤ"],["、"],["それ"],["に"],["アラブ人","あらぶじん"],["、"],["アンモン"],["人","にん"],["、"],["アシュドド"],["の"],["市民","しみん"],["は"],["、"],["エルサレム"],["の"],["城壁","じょうへき"],["の"],["再建","さいけん"],["が"],["進み","すすみ"],["、"],["破損","はそん"],["の"],["修復","しゅうふく"],["が"],["始まった","はじまった"],["と"],["聞いて","きいて"],["、"],["大いに","おおいに"],["怒った","おこった"],["。"]]},{"verse":2,"text":"彼らは皆で共謀してエルサレムに攻め上り、混乱に陥れようとした。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["で"],["共謀","きょうぼう"],["して"],["エルサレム"],["に"],["攻め上り","せめのぼり"],["、"],["混乱","こんらん"],["に"],["陥れよう","おとしいれよう"],["と"],["した"],["。"]]},{"verse":3,"text":"わたしたちはわたしたちの神に祈り、昼夜彼らに対し、彼らから身を守るために警戒した。","tok":[["わたしたち"],["は"],["わたしたち"],["の"],["神","かみ"],["に"],["祈り","いのり"],["、"],["昼夜","ちゅうや"],["彼","かれ"],["ら"],["に"],["対し","たいし"],["、"],["彼","かれ"],["ら"],["から"],["身","み"],["を"],["守る","まもる"],["ため"],["に"],["警戒","けいかい"],["した"],["。"]]},{"verse":4,"text":"しかし、ユダもこう言うのだった。「もっこを担ぐ力は弱り土くれの山はまだ大きい。城壁の再建などわたしたちにはできません。」","tok":[["しかし"],["、"],["ユダ"],["も"],["こう"],["言う","いう"],["の"],["だった"],["。"],["「"],["もっこ"],["を"],["担ぐ","かつぐ"],["力","ちから"],["は"],["弱り","よわり"],["土くれ","つちくれ"],["の"],["山","やま"],["は"],["まだ"],["大きい","おおきい"],["。"],["城壁","じょうへき"],["の"],["再建","さいけん"],["など"],["わたしたち"],["に"],["は"],["できません"],["。"],["」"]]},{"verse":5,"text":"わたしたちの敵はこう言っていた。「気づかれず、見つからないように侵入し、彼らを打ち殺して、工事をやめさせよう。」","tok":[["わたしたち"],["の"],["敵","てき"],["は"],["こう"],["言って","いって"],["いた"],["。"],["「"],["気づかれず","きづかれず"],["、"],["見つからない","みつからない"],["よう"],["に"],["侵入","しんにゅう"],["し"],["、"],["彼","かれ"],["ら"],["を"],["打ち殺して","うちころして"],["、"],["工事","こうじ"],["を"],["やめさせよう"],["。"],["」"]]},{"verse":6,"text":"彼らの近くに住むユダの人々がやって来て、十度もわたしたちに、「あなたたちが戻ると、あらゆるところからわたしたちは攻められます」と言った。","tok":[["彼","かれ"],["ら"],["の"],["近く","ちかく"],["に"],["住む","すむ"],["ユダ"],["の"],["人々","ひとびと"],["が"],["やって"],["来て","きて"],["、"],["十","じゅう"],["度","ど"],["も"],["わたしたち"],["に"],["、"],["「"],["あなた"],["たち"],["が"],["戻る","もどる"],["と"],["、"],["あらゆる"],["ところ"],["から"],["わたしたち"],["は"],["攻められます","せめられます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"そこでわたしは城壁外の低い所、むき出しになった所に、各家族の戦闘員を、剣と槍と弓を持たせて配置した。","tok":[["そこ"],["で"],["わたし"],["は"],["城壁外","じょうへきがい"],["の"],["低い","ひくい"],["所","ところ"],["、"],["むき出し","むきだし"],["に"],["なった"],["所","ところ"],["に"],["、"],["各","かく"],["家族","かぞく"],["の"],["戦闘員","せんとういん"],["を"],["、"],["剣","けん"],["と"],["槍","やり"],["と"],["弓","ゆみ"],["を"],["持たせて","もたせて"],["配置","はいち"],["した"],["。"]]},{"verse":8,"text":"わたしは見回して立ち、貴族や役人やその他の戦闘員に言った。「敵を恐れるな。偉大にして畏るべき主の御名を唱えて、兄弟のため、息子のため、娘のため、妻のため、家のために戦え。」","tok":[["わたし"],["は"],["見回して","みまわして"],["立ち","たち"],["、"],["貴族","きぞく"],["や"],["役人","やくにん"],["や"],["その"],["他","た"],["の"],["戦闘員","せんとういん"],["に"],["言った","いった"],["。"],["「"],["敵","てき"],["を"],["恐れる","おそれる"],["な"],["。"],["偉大","いだい"],["に"],["して"],["畏るべき","かしこまるべき"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["唱えて","となえて"],["、"],["兄弟","きょうだい"],["の"],["ため"],["、"],["息子","むすこ"],["の"],["ため"],["、"],["娘","むすめ"],["の"],["ため"],["、"],["妻","つま"],["の"],["ため"],["、"],["家","いえ"],["の"],["ため"],["に"],["戦え","たたかえ"],["。"],["」"]]},{"verse":9,"text":"わたしたちが気づき、神がその計略を破られたことを敵が知ったので、わたしたちは皆、城壁に戻り、それぞれ自分の作業に就いた。","tok":[["わたしたち"],["が"],["気づき","きづき"],["、"],["神","かみ"],["が"],["その"],["計略","けいりゃく"],["を"],["破られた","やぶられた"],["こと"],["を"],["敵","てき"],["が"],["知った","しった"],["ので"],["、"],["わたしたち"],["は"],["皆","みな"],["、"],["城壁","じょうへき"],["に"],["戻り","もどり"],["、"],["それぞれ"],["自分","じぶん"],["の"],["作業","さぎょう"],["に"],["就いた","ついた"],["。"]]},{"verse":10,"text":"その日からわたしの部下たちは、半分が作業に従事し、他の半分が槍と盾、弓と鎧を身に着け、将校たちがユダの家全体の背後に控えた。","tok":[["その"],["日","ひ"],["から"],["わたし"],["の"],["部下","ぶか"],["たち"],["は"],["、"],["半分","はんぶん"],["が"],["作業","さぎょう"],["に"],["従事","じゅうじ"],["し"],["、"],["他","た"],["の"],["半分","はんぶん"],["が"],["槍","やり"],["と"],["盾","たて"],["、"],["弓","ゆみ"],["と"],["鎧","よろい"],["を"],["身","み"],["に"],["着け","つけ"],["、"],["将校","しょうこう"],["たち"],["が"],["ユダ"],["の"],["家","いえ"],["全体","ぜんたい"],["の"],["背後","はいご"],["に"],["控えた","ひかえた"],["。"]]},{"verse":11,"text":"城壁を築く者、もっこを担いで運ぶ者は、一方の手で作業をし、もう一方の手には投げ槍を取った。","tok":[["城壁","じょうへき"],["を"],["築く","きずく"],["者","もの"],["、"],["もっこ"],["を"],["担いで","かついで"],["運ぶ","はこぶ"],["者","もの"],["は"],["、"],["一方","いっぽう"],["の"],["手","て"],["で"],["作業","さぎょう"],["を"],["し"],["、"],["もう"],["一方","いっぽう"],["の"],["手","て"],["に"],["は"],["投げ槍","なげやり"],["を"],["取った","とった"],["。"]]},{"verse":12,"text":"建築作業をする者は、各自腰に剣を帯びて作業した。わたしはそばに角笛を吹く者をつけた。","tok":[["建築","けんちく"],["作業","さぎょう"],["を"],["する"],["者","もの"],["は"],["、"],["各自","かくじ"],["腰","こし"],["に"],["剣","けん"],["を"],["帯びて","おびて"],["作業","さぎょう"],["した"],["。"],["わたし"],["は"],["そば"],["に"],["角笛","つのぶえ"],["を"],["吹く","ふく"],["者","もの"],["を"],["つけた"],["。"]]},{"verse":13,"text":"わたしは貴族と役人と他の戦闘員に言った。「仕事が多く、範囲は広い。わたしたちは互いに遠く離れて城壁の上に散らばっている。","tok":[["わたし"],["は"],["貴族","きぞく"],["と"],["役人","やくにん"],["と"],["他","ほか"],["の"],["戦闘員","せんとういん"],["に"],["言った","いった"],["。"],["「"],["仕事","しごと"],["が"],["多く","おおく"],["、"],["範囲","はんい"],["は"],["広い","ひろい"],["。"],["わたしたち"],["は"],["互い","たがい"],["に"],["遠く","とおく"],["離れて","はなれて"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["散らばって","ちらばって"],["いる"],["。"]]},{"verse":14,"text":"角笛の音を聞いたら、わたしたちのもとに集まれ。わたしたちの神はわたしたちのために戦ってくださる。」","tok":[["角笛","つのぶえ"],["の"],["音","おと"],["を"],["聞いたら","きいたら"],["、"],["わたしたち"],["の"],["もと"],["に"],["集まれ","あつまれ"],["。"],["わたしたち"],["の"],["神","かみ"],["は"],["わたしたち"],["の"],["ため"],["に"],["戦って","たたかって"],["くださる"],["。"],["」"]]},{"verse":15,"text":"夜が明けてから星が現れるころまでわたしたちは作業に就き、部下の半分は槍を手にしていた。","tok":[["夜","よる"],["が"],["明けて","あけて"],["から"],["星","ほし"],["が"],["現れる","あらわれる"],["ころ"],["まで"],["わたしたち"],["は"],["作業","さぎょう"],["に"],["就き","つき"],["、"],["部下","ぶか"],["の"],["半分","はんぶん"],["は"],["槍","やり"],["を"],["手","て"],["に"],["して"],["いた"],["。"]]},{"verse":16,"text":"このころわたしは戦闘員に言った。「各自、自分の部下と共にエルサレムの城壁内で夜を過ごしなさい。夜は警備に当たり、昼に仕事をしよう。」","tok":[["この"],["ころ"],["わたし"],["は"],["戦闘員","せんとういん"],["に"],["言った","いった"],["。"],["「"],["各自","かくじ"],["、"],["自分","じぶん"],["の"],["部下","ぶか"],["と"],["共","とも"],["に"],["エルサレム"],["の"],["城壁内","じょうへきない"],["で"],["夜","よる"],["を"],["過ごし","すごし"],["なさい"],["。"],["夜","よる"],["は"],["警備","けいび"],["に"],["当たり","あたり"],["、"],["昼","ひる"],["に"],["仕事","しごと"],["を"],["しよう"],["。"],["」"]]},{"verse":17,"text":"わたしも、兄弟も、部下の者も、わたしに従う警備の者も、わたしたちはだれも、服を脱がずにいて、各自投げ槍を右の手にしていた。","tok":[["わたし"],["も"],["、"],["兄弟","きょうだい"],["も"],["、"],["部下","ぶか"],["の"],["者","もの"],["も"],["、"],["わたし"],["に"],["従う","したがう"],["警備","けいび"],["の"],["者","もの"],["も"],["、"],["わたしたち"],["は"],["だれ"],["も"],["、"],["服","ふく"],["を"],["脱がず","ぬがず"],["に"],["いて"],["、"],["各自","かくじ"],["投げ槍","なげやり"],["を"],["右","みぎ"],["の"],["手","て"],["に"],["して"],["いた"],["。"]]}]
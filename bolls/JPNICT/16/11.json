[{"verse":1,"text":"民の長たちはエルサレムに住んでいた。ほかの民はくじを引き、十人のうち一人が聖なる都エルサレムに来て住み、残りの九人が他の町々にとどまるようにした。","tok":[["民","みん"],["の"],["長","なが"],["たち"],["は"],["エルサレム"],["に"],["住んで","すんで"],["いた"],["。"],["ほか"],["の"],["民","たみ"],["は"],["くじ"],["を"],["引き","ひき"],["、"],["十人","じゅうにん"],["の"],["うち"],["一人","ひとり"],["が"],["聖","せい"],["なる"],["都","と"],["エルサレム"],["に"],["来て","きて"],["住み","すみ"],["、"],["残り","のこり"],["の"],["九人","きゅうにん"],["が"],["他","ほか"],["の"],["町々","まちまち"],["に"],["とどまる"],["よう"],["に"],["した"],["。"]]},{"verse":2,"text":"民は、進んでエルサレムに住むすべての人々を祝福した。","tok":[["民","みん"],["は"],["、"],["進んで","すすんで"],["エルサレム"],["に"],["住む","すむ"],["すべて"],["の"],["人々","ひとびと"],["を"],["祝福","しゅくふく"],["した"],["。"]]},{"verse":3,"text":"この州の頭たちでエルサレムに住んだ者は次のとおりである。ユダの町々にはイスラエルの人々、祭司、レビ人、神殿の使用人、ソロモンの使用人の一族が、それぞれ自分の町に所有地を持って住み、","tok":[["この"],["州","しゅう"],["の"],["頭","あたま"],["たち"],["で"],["エルサレム"],["に"],["住んだ","すんだ"],["者","もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ユダ"],["の"],["町々","まちまち"],["に"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["、"],["祭司","さいし"],["、"],["レビ人","れびにん"],["、"],["神殿","しんでん"],["の"],["使用人","しようにん"],["、"],["ソロモン"],["の"],["使用人","しようにん"],["の"],["一族","いちぞく"],["が"],["、"],["それぞれ"],["自分","じぶん"],["の"],["町","まち"],["に"],["所有地","しょゆうち"],["を"],["持って","もって"],["住み","すみ"],["、"]]},{"verse":4,"text":"エルサレムにはユダの一族とベニヤミンの一族の者が住んだ。ユダの一族ではアタヤとマアセヤ。アタヤの父はウジヤ、祖父はゼカルヤ、更にアマルヤ、シェファトヤ、ペレツの子らの一人マハラルエルとさかのぼる。マアセヤの父はバルク、祖父はコル‧ホゼ、更にハザヤ、アダヤ、ヨヤリブ、シロ出身者の子ゼカルヤとさかのぼる。","tok":[["エルサレム"],["に"],["は"],["ユダ"],["の"],["一族","いちぞく"],["と"],["ベニヤミン"],["の"],["一族","いちぞく"],["の"],["者","もの"],["が"],["住んだ","すんだ"],["。"],["ユダ"],["の"],["一族","いちぞく"],["で"],["は"],["アタヤ"],["と"],["マアセヤ"],["。"],["アタヤ"],["の"],["父","ちち"],["は"],["ウジヤ"],["、"],["祖父","そふ"],["は"],["ゼカルヤ"],["、"],["更に","さらに"],["アマルヤ"],["、"],["シェファトヤ"],["、"],["ペレツ"],["の"],["子","こ"],["ら"],["の"],["一人","ひとり"],["マハラ"],["ルエル"],["と"],["さかのぼる"],["。"],["マアセヤ"],["の"],["父","ちち"],["は"],["バルク"],["、"],["祖父","そふ"],["は"],["コル"],["‧"],["ホゼ"],["、"],["更に","さらに"],["ハザヤ"],["、"],["アダヤ"],["、"],["ヨヤリブ"],["、"],["シロ"],["出身者","しゅっしんしゃ"],["の"],["子","こ"],["ゼカルヤ"],["と"],["さかのぼる"],["。"]]},{"verse":6,"text":"エルサレムに住んだペレツの一族は合計四百六十八人で、勇敢な人物であった。","tok":[["エルサレム"],["に"],["住んだ","すんだ"],["ペレツ"],["の"],["一族","いちぞく"],["は"],["合計","ごうけい"],["四百六十八","よんひゃくろくじゅうはち"],["人","にん"],["で"],["、"],["勇敢","ゆうかん"],["な"],["人物","じんぶつ"],["で"],["あった"],["。"]]},{"verse":7,"text":"ベニヤミンの一族では、次の者がいた。まずサル。彼の父はメシュラム、祖父はヨエド、更にペダヤ、コラヤ、マアセヤ、イティエル、エシャヤとさかのぼる。","tok":[["ベニヤミン"],["の"],["一族","いちぞく"],["で"],["は"],["、"],["次","つぎ"],["の"],["者","もの"],["が"],["いた"],["。"],["まず"],["サル"],["。"],["彼","かれ"],["の"],["父","ちち"],["は"],["メシュラム"],["、"],["祖父","そふ"],["は"],["ヨエド"],["、"],["更に","さらに"],["ペダヤ"],["、"],["コラヤ"],["、"],["マアセヤ"],["、"],["イティエル"],["、"],["エシャヤ"],["と"],["さかのぼる"],["。"]]},{"verse":8,"text":"次に、ガバイとサライら九百二十八人。","tok":[["次","つぎ"],["に"],["、"],["ガバイ"],["と"],["サライ"],["ら"],["九百二十八","きゅうひゃくにじゅうはち"],["人","にん"],["。"]]},{"verse":9,"text":"ジクリの子ヨエルが彼らの監督であり、セヌアの子ユダが町の次官であった。","tok":[["ジクリ"],["の"],["子","こ"],["ヨエル"],["が"],["彼","かれ"],["ら"],["の"],["監督","かんとく"],["で"],["あり"],["、"],["セヌア"],["の"],["子","こ"],["ユダ"],["が"],["町","まち"],["の"],["次官","じかん"],["で"],["あった"],["。"]]},{"verse":10,"text":"祭司では、ヨヤリブの子エダヤ、ヤキン、","tok":[["祭司","さいし"],["で"],["は"],["、"],["ヨヤリブ"],["の"],["子","こ"],["エダヤ"],["、"],["ヤキン"],["、"]]},{"verse":11,"text":"神殿の主管セラヤ。セラヤの父はヒルキヤ、祖父はメシュラム、更にツァドク、メラヨト、アヒトブとさかのぼる。","tok":[["神殿","しんでん"],["の"],["主管","しゅかん"],["セラヤ"],["。"],["セラヤ"],["の"],["父","ちち"],["は"],["ヒルキヤ"],["、"],["祖父","そふ"],["は"],["メシュラム"],["、"],["更に","さらに"],["ツァドク"],["、"],["メラヨト"],["、"],["アヒトブ"],["と"],["さかのぼる"],["。"]]},{"verse":12,"text":"それに彼らの仲間で神殿の務めに携わる者八百二十二人、アダヤとその仲間で家長である者二百四十二人がいた。アダヤの父はエロハム、祖父はペラルヤ、更にアムツィ、ゼカルヤ、パシュフル、マルキヤとさかのぼる。それにアマシュサイがいた。アマシュサイの父はアザルエル、祖父はアフザイ、更にメシレモト、イメルとさかのぼる。","tok":[["それ"],["に"],["彼","かれ"],["ら"],["の"],["仲間","なかま"],["で"],["神殿","しんでん"],["の"],["務め","つとめ"],["に"],["携わる","たずさわる"],["者","もの"],["八百二十二","はちひゃくにじゅうに"],["人","にん"],["、"],["アダヤ"],["と"],["その"],["仲間","なかま"],["で"],["家長","かちょう"],["で"],["ある"],["者","もの"],["二百四十二","にひゃくよんじゅうに"],["人","にん"],["が"],["いた"],["。"],["アダヤ"],["の"],["父","ちち"],["は"],["エロハム"],["、"],["祖父","そふ"],["は"],["ペラルヤ"],["、"],["更に","さらに"],["アムツィ"],["、"],["ゼカルヤ"],["、"],["パシュフル"],["、"],["マルキヤ"],["と"],["さかのぼる"],["。"],["それ"],["に"],["アマシュサイ"],["が"],["いた"],["。"],["アマシュサイ"],["の"],["父","ちち"],["は"],["アザルエル"],["、"],["祖父","そふ"],["は"],["アフザイ"],["、"],["更に","さらに"],["メシレモト"],["、"],["イメル"],["と"],["さかのぼる"],["。"]]},{"verse":14,"text":"彼らの仲間で勇敢な人物百二十八人もいた。ハゲドリムの子ザブディエルが彼らの監督であった。","tok":[["彼","かれ"],["ら"],["の"],["仲間","なかま"],["で"],["勇敢","ゆうかん"],["な"],["人物","じんぶつ"],["百二十八","ひゃくにじゅうはち"],["人","にん"],["も"],["いた"],["。"],["ハゲドリム"],["の"],["子","こ"],["ザブディエル"],["が"],["彼","かれ"],["ら"],["の"],["監督","かんとく"],["で"],["あった"],["。"]]},{"verse":15,"text":"レビ人では、シェマヤ。彼の父はハシュブ、祖父はアズリカム、更にハシャブヤ、ブンニとさかのぼる。","tok":[["レビ人","れびにん"],["で"],["は"],["、"],["シェマヤ"],["。"],["彼","かれ"],["の"],["父","ちち"],["は"],["ハシュブ"],["、"],["祖父","そふ"],["は"],["アズリカム"],["、"],["更に","さらに"],["ハシャブヤ"],["、"],["ブンニ"],["と"],["さかのぼる"],["。"]]},{"verse":16,"text":"また、レビ人の頭で神殿の外部の務めに就いていたシャベタイとヨザバド、","tok":[["また"],["、"],["レビ人","れびにん"],["の"],["頭","あたま"],["で"],["神殿","しんでん"],["の"],["外部","がいぶ"],["の"],["務め","つとめ"],["に"],["就いて","ついて"],["いた"],["シャベタイ"],["と"],["ヨザバド"],["、"]]},{"verse":17,"text":"祈りにおける賛歌の先唱者マタンヤ。彼の父はミカ、祖父はザブディ、更にアサフとさかのぼる。そのほかに仲間の副主任バクブクヤ、そしてアブダ。彼の父はシャムア、祖父はガラル、更にエドトンと続く。","tok":[["祈り","いのり"],["に"],["おける"],["賛歌","さんか"],["の"],["先","さき"],["唱者","しょうしゃ"],["マタンヤ"],["。"],["彼","かれ"],["の"],["父","ちち"],["は"],["ミカ"],["、"],["祖父","そふ"],["は"],["ザブディ"],["、"],["更に","さらに"],["アサ"],["フと"],["さかのぼる"],["。"],["その"],["ほか"],["に"],["仲間","なかま"],["の"],["副主任","ふくしゅにん"],["バクブクヤ"],["、"],["そして"],["アブダ"],["。"],["彼","かれ"],["の"],["父","ちち"],["は"],["シャムア"],["、"],["祖父","そふ"],["は"],["ガラル"],["、"],["更に","さらに"],["エドトン"],["と"],["続く","つづく"],["。"]]},{"verse":18,"text":"聖なる町にいるレビ人の合計は二百八十四人であった。","tok":[["聖","せい"],["なる"],["町","まち"],["に"],["いる"],["レビ人","れびにん"],["の"],["合計","ごうけい"],["は"],["二百八十四","にひゃくはちじゅうよん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":19,"text":"門衛では、アクブ、タルモンおよび門を警備する彼らの仲間百七十二人。","tok":[["門衛","もんえい"],["で"],["は"],["、"],["アクブ"],["、"],["タルモン"],
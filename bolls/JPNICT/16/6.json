[{"verse":1,"text":"サンバラト、トビヤ、アラブ人ゲシェム、その他わたしたちの敵は、わたしが城壁を再建し、崩れた所が一つとして残らず、あとは城門に扉を付けるだけだということを耳にした。","tok":[["サンバラト"],["、"],["トビヤ"],["、"],["アラブ人","あらぶじん"],["ゲシェム"],["、"],["その"],["他","た"],["わたしたち"],["の"],["敵","てき"],["は"],["、"],["わたし"],["が"],["城壁","じょうへき"],["を"],["再建","さいけん"],["し"],["、"],["崩れた","くずれた"],["所","ところ"],["が"],["一","ひと"],["つ"],["として"],["残らず","のこらず"],["、"],["あと"],["は"],["城門","じょうもん"],["に"],["扉","とびら"],["を"],["付ける","つける"],["だけ"],["だ"],["と"],["いう"],["こと"],["を"],["耳","みみ"],["に"],["した"],["。"]]},{"verse":2,"text":"サンバラトとゲシェムはわたしのもとに使者をよこして、「オノの谷にあるケフィリムで会おう」と言った。彼らはわたしに危害を加えようとたくらんだのであった。","tok":[["サンバラト"],["と"],["ゲシェム"],["は"],["わたし"],["の"],["もと"],["に"],["使者","ししゃ"],["を"],["よこして"],["、"],["「"],["オノ"],["の"],["谷","たに"],["に"],["ある"],["ケフィリム"],["で"],["会おう","あおう"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["危害","きがい"],["を"],["加えよう","くわえよう"],["と"],["たくらんだ"],["ので"],["あった"],["。"]]},{"verse":3,"text":"そこでわたしは使者を送って言わせた。「わたしは大きな工事をしているので、行けません。中断して出かけたのでは、どうして工事が終わるでしょうか。」","tok":[["そこ"],["で"],["わたし"],["は"],["使者","ししゃ"],["を"],["送って","おくって"],["言わせた","いわせた"],["。"],["「"],["わたし"],["は"],["大きな","おおきな"],["工事","こうじ"],["を"],["して"],["いる"],["ので"],["、"],["行けません","いけません"],["。"],["中断","ちゅうだん"],["して"],["出かけた","でかけた"],["ので"],["は"],["、"],["どう"],["して"],["工事","こうじ"],["が"],["終わるでしょう","おわるでしょう"],["か"],["。"],["」"]]},{"verse":4,"text":"彼らは同じことを四度も言ってきたが、わたしも同じように返事を繰り返した。","tok":[["彼","かれ"],["ら"],["は"],["同じ","おなじ"],["こと"],["を"],["四","よん"],["度","ど"],["も"],["言って","いって"],["きた"],["が"],["、"],["わたし"],["も"],["同じ","おなじ"],["よう"],["に"],["返事","へんじ"],["を"],["繰り返した","くりかえした"],["。"]]},{"verse":5,"text":"五度目にサンバラトは、配下の者を同じ言葉をもってわたしのもとによこしたが、その手には開封の手紙があった。","tok":[["五度目","ごどめ"],["に"],["サンバラト"],["は"],["、"],["配下","はいか"],["の"],["者","もの"],["を"],["同じ","おなじ"],["言葉","ことば"],["を"],["もって"],["わたし"],["の"],["もと"],["に"],["よこした"],["が"],["、"],["その"],["手","て"],["に"],["は"],["開封","かいふう"],["の"],["手紙","てがみ"],["が"],["あった"],["。"]]},{"verse":6,"text":"そこには、こう書かれていた。「あなたとユダの人々は反逆を企てていると、諸国のうわさにもなっているし、ガシュムも言っている。城壁を建てているのはそのためであろう。あなたはユダの人々の王になろうとしているということだ。","tok":[["そこ"],["に"],["は"],["、"],["こう"],["書かれて","かかれて"],["いた"],["。"],["「"],["あなた"],["と"],["ユダ"],["の"],["人々","ひとびと"],["は"],["反逆","はんぎゃく"],["を"],["企てて","くわだてて"],["いる"],["と"],["、"],["諸国","しょこく"],["の"],["うわさ"],["に"],["も"],["なって"],["いる"],["し"],["、"],["ガシュム"],["も"],["言って","いって"],["いる"],["。"],["城壁","じょうへき"],["を"],["建てて","たてて"],["いる"],["の"],["は"],["その"],["ため"],["で"],["あろう"],["。"],["あなた"],["は"],["ユダ"],["の"],["人々","ひとびと"],["の"],["王","おう"],["に"],["なろう"],["として"],["いる"],["と"],["いう"],["こと"],["だ"],["。"]]},{"verse":7,"text":"また、あなたはあなたのことを宣言する預言者をエルサレムに立てて、ユダの王だと言わせているそうだ。今このうわさは、王のもとに届こうとしている。早速相談しようではないか。」","tok":[["また"],["、"],["あなた"],["は"],["あなた"],["の"],["こと"],["を"],["宣言","せんげん"],["する"],["預言者","よげんしゃ"],["を"],["エルサレム"],["に"],["立てて","たてて"],["、"],["ユダ"],["の"],["王","おう"],["だ"],["と"],["言わせて","いわせて"],["いる"],["そう"],["だ"],["。"],["今","いま"],["この"],["うわさ"],["は"],["、"],["王","おう"],["の"],["もと"],["に"],["届こう","とどこう"],["として"],["いる"],["。"],["早速","さっそく"],["相談","そうだん"],["しようで"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":8,"text":"そこでわたしは返事を送った。「あなたの言うことは事実に反する。あなたの勝手な作り事だ。」","tok":[["そこ"],["で"],["わたし"],["は"],["返事","へんじ"],["を"],["送った","おくった"],["。"],["「"],["あなた"],["の"],["言う","いう"],["こと"],["は"],["事実","じじつ"],["に"],["反する","はんする"],["。"],["あなた"],["の"],["勝手","かって"],["な"],["作り事","つくりごと"],["だ"],["。"],["」"]]},{"verse":9,"text":"彼らは皆、わたしたちの手が弱り、工事は完成しないだろうと言って、わたしたちに恐怖を与えている。神よ、今こそわたしの手を強くしてください。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["わたしたち"],["の"],["手","て"],["が"],["弱り","よわり"],["、"],["工事","こうじ"],["は"],["完成","かんせい"],["しないだろう"],["と"],["言って","いって"],["、"],["わたしたち"],["に"],["恐怖","きょうふ"],["を"],["与えて","あたえて"],["いる"],["。"],["神","かみ"],["よ"],["、"],["今","いま"],["こそ"],["わたし"],["の"],["手","て"],["を"],["強く","つよく"],["して"],["ください"],["。"]]},{"verse":10,"text":"わたしが、メヘタブエルの孫でデラヤの子であるシェマヤの家に行くと、彼は閉じこもっていた。彼は言った。「神殿で会おう、聖所の中で。聖所の扉を閉じよう。あなたを殺しに来る者がある。夜、あなたを殺しにやって来る。」","tok":[["わたし"],["が"],["、"],["メヘタブエル"],["の"],["孫","まご"],["で"],["デラヤ"],["の"],["子","こ"],["で"],["ある"],["シェマヤ"],["の"],["家","いえ"],["に"],["行く","いく"],["と"],["、"],["彼","かれ"],["は"],["閉じこもって","とじこもって"],["いた"],["。"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["神殿","しんでん"],["で"],["会おう","あおう"],["、"],["聖","せい"],["所","しょ"],["の"],["中","なか"],["で"],["。"],["聖","せい"],["所","しょ"],["の"],["扉","とびら"],["を"],["閉じよう","とじよう"],["。"],["あなた"],["を"],["殺し","ころし"],["に"],["来る","くる"],["者","もの"],["が"],["ある"],["。"],["夜","よる"],["、"],["あなた"],["を"],["殺し","ころし"],["に"],["やって"],["来る","くる"],["。"],["」"]]},{"verse":11,"text":"しかし、わたしは言った。「わたしの立場にある者は逃げることはできない。わたしのような者で、聖所に入って、なお生き長らえることのできる者があろうか。わたしは入らない。」","tok":[["しかし"],["、"],["わたし"],["は"],["言った","いった"],["。"],["「"],["わたし"],["の"],["立場","たちば"],["に"],["ある"],["者","もの"],["は"],["逃げる","にげる"],["こと"],["は"],["できない"],["。"],["わたし"],["の"],["よう"],["な"],["者","もの"],["で"],["、"],["聖","せい"],["所","しょ"],["に"],["入って","はいって"],["、"],["なお"],["生き長らえる","いきながらえる"],["こと"],["の"],["できる"],["者","もの"],["が"],["あろう"],["か"],["。"],["わたし"],["は"],["入らない","はいらない"],["。"],["」"]]},{"verse":12,"text":"彼は神が遣わした者ではなく、トビヤとサンバラトに買収されてわたしに預言したのだということをわたしは悟った。","tok":[["彼","かれ"],["は"],["神","かみ"],["が"],["遣わした","つかわした"],["者","もの"],["で"],["は"],["なく"],["、"],["トビヤ"],["と"],["サンバラト"],["に"],["買収","ばいしゅう"],["されて"],["わたし"],["に"],["預言","よげん"],["した"],["の"],["だ"],["と"],["いう"],["こと"],["を"],["わたし"],["は"],["悟った","さとった"],["。"]]},{"verse":13,"text":"なぜ彼を買収したのか。それはわたしが恐怖心から彼らの言いなりになって罪を犯せば、彼らはそれを利用してわたしの悪口を言い、わたしを辱めることができるからである。","tok":[["なぜ"],["彼","かれ"],["を"],["買収","ばいしゅう"],["した"],["の"],["か"],["。"],["それ"],["は"],["わたし"],["が"],["恐怖心","きょうふしん"],["から"],["彼","かれ"],["ら"],["の"],["言い","いい"],["なり"],["に"],["なって"],["罪","つみ"],["を"],["犯せば","おかせば"],["、"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["利用","りよう"],["して"],["わたし"],["の"],["悪口","わるぐち"],["を"],["言い","いい"],["、"],["わたし"],["を"],["辱める","はずかしめる"],["こと"],["が"],["できる"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"わが神よ、トビヤとサンバラトのこの仕業と、わたしを脅迫した女預言者ノアドヤや他の預言者たちを覚えていてください。","tok":[["わが"],["神","かみ"],["よ"],["、"],["トビヤ"],["と"],["サンバラト"],["の"],["この"],["仕業","しわざ"],["と"],["、"],["わたし"],["を"],["脅迫","きょうはく"],["した"],["女","おんな"],["預言者","よげんしゃ"],["ノアドヤ"],["や"],["他","ほか"],["の"],["預言者","よげんしゃ"],["たち"],["を"],["覚えて","おぼえて"],["いて"],["ください"],["。"]]},{"verse":15,"text":"城壁は五十二日かかって、エルルの月の二十五日に完成した。","tok":[["城壁","じょうへき"],["は"],["五十二","ごじゅうに"],["日","にち"],["かかって"],["、"],["エルル"],["の"],["月","つき"],["の"],["二十五","にじゅうご"],["日","にち"],["に"],["完成","かんせい"],["した"],["。"]]},{"verse":16,"text":"わたしたちのすべての敵がそれを聞くに及んで、わたしたちの周囲にいる諸国の民も皆、恐れを抱き、自らの目に大いに面目を失った。わたしたちの神の助けによってこの工事がなされたのだということを悟ったからである。","tok":[["わたしたち"],["の"],["すべて"],["の"],["敵","てき"],["が"],["それ"],["を"],["聞く","きく"],["に"],["及んで","およんで"],["、"],["わたしたち"],["の"],["周囲","しゅうい"],["に"],["いる"],["諸国","しょこく"],["の"],["民","たみ"],["も"],["皆","みな"],["、"],["恐れ","おそれ"],["を"],["抱き","いだき"],["、"],["自ら","みずから"],["の"],["目","め"],["に"],["大いに","おおいに"],["面目","めんぼく"],["を"],["失った","うしなった"],["。"],["わたしたち"],["の"],["神","かみ"],["の"],["助け","たすけ"],["によって"],["この"],["工事","こうじ"],["が"],["なされた"],["の"],["だ"],["と"],["いう"],["こと"],["を"],["悟った","さとった"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"そのころ、ユダの貴族は頻繁にトビヤに手紙を送り、トビヤの手紙も彼らに届いていた。","tok":[["その"],["ころ"],["、"],["ユダ"],["の"],["貴族","きぞく"],["は"],["頻繁","ひんぱん"],["に"],["トビヤ"],["に"],["手紙","てがみ"],["を"],["送り","おくり"],["、"],["トビヤ"],["の"],["手紙","てがみ"],["も"],["彼","かれ"],["ら"],["に"],["届いて","とどいて"],["いた"],["。"]]},{"verse":18,"text":"ユダの多くの人は彼と互いに誓約を交わす関係にあったからで、トビヤはアラの子シェカンヤの娘婿であり、トビヤの子ヨハナンはベレクヤの子メシュラムの娘をめとっていた。","tok":[["ユダ"],["の"],["多く","おおく"],["の"],["人","ひと"],["は"],["彼","かれ"],["と"],["互い","たがい"],["に"],["誓約","せいやく"],["を"],["交わす","かわす"],["関係","かんけい"],["に"],["あった"],["から"],["で"],["、"],["トビヤ"],["は"],["アラ"],["の"],["子","こ"],["シェカンヤ"],["の"],["娘婿","むすめむこ"],["で"],["あり"],["、"],["トビヤ"],["の"],["子","こ"],["ヨハナン"],["は"],["ベレクヤ"],["の"],["子","こ"],["メシュラム"],["の"],["娘","むすめ"],["を"],["めとって"],["いた"],["。"]]},{"verse":19,"text":"彼らはわたしの前ではトビヤへの賛辞を述べ、トビヤにはわたしの言葉を密告した。トビヤはわたしに脅迫の手紙をよこした。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["の"],["前","まえ"],["で"],["は"],["トビヤ"],["へ"],["の"],["賛辞","さんじ"],["を"],["述べ","のべ"],["、"],["トビヤ"],["に"],["は"],["わたし"],["の"],["言葉","ことば"],["を"],["密告","みっこく"],["した"],["。"],["トビヤ"],["は"],["わたし"],["に"],["脅迫","きょうはく"],["の"],["手紙","てがみ"],["を"],["よこした"],["。"]]}]
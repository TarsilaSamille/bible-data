[{"verse":1,"text":"あなたがたは神に愛されている子供ですから、神に倣う者となりなさい。","tok":[["あなた"],["がた"],["は"],["神","かみ"],["に"],["愛されて","あいされて"],["いる"],["子供","こども"],["です"],["から"],["、"],["神","かみ"],["に"],["倣う","ならう"],["者","もの"],["と"],["なり"],["なさい"],["。"]]},{"verse":2,"text":"キリストがわたしたちを愛して、御自分を香りのよい供え物、つまり、いけにえとしてわたしたちのために神に献げてくださったように、あなたがたも愛によって歩みなさい。","tok":[["キリスト"],["が"],["わたしたち"],["を"],["愛して","あいして"],["、"],["御自分","ごじぶん"],["を"],["香り","かおり"],["の"],["よい"],["供え物","そなえもの"],["、"],["つまり"],["、"],["いけにえ"],["として"],["わたしたち"],["の"],["ため"],["に"],["神","かみ"],["に"],["献げて","ささげて"],["くださった"],["よう"],["に"],["、"],["あなた"],["がた"],["も"],["愛","あい"],["によって"],["歩み","あゆみ"],["なさい"],["。"]]},{"verse":3,"text":"あなたがたの間では、聖なる者にふさわしく、みだらなことやいろいろの汚れたこと、あるいは貪欲なことを口にしてはなりません。","tok":[["あなた"],["がた"],["の"],["間","あいだ"],["で"],["は"],["、"],["聖","せい"],["なる"],["者","もの"],["に"],["ふさわしく"],["、"],["みだら"],["な"],["こと"],["や"],["いろいろ"],["の"],["汚れた","よごれた"],["こと"],["、"],["あるいは"],["貪欲","どんよく"],["な"],["こと"],["を"],["口","くち"],["に"],["して"],["は"],["なりません"],["。"]]},{"verse":4,"text":"卑わいな言葉や愚かな話、下品な冗談もふさわしいものではありません。それよりも、感謝を表しなさい。","tok":[["卑わい","ひわい"],["な"],["言葉","ことば"],["や"],["愚か","おろか"],["な"],["話","はなし"],["、"],["下品","げひん"],["な"],["冗談","じょうだん"],["も"],["ふさわしい"],["もの"],["で"],["は"],["ありません"],["。"],["それ"],["より"],["も"],["、"],["感謝","かんしゃ"],["を"],["表し","あらわし"],["なさい"],["。"]]},{"verse":5,"text":"すべてみだらな者、汚れた者、また貪欲な者、つまり、偶像礼拝者は、キリストと神との国を受け継ぐことはできません。このことをよくわきまえなさい。","tok":[["すべて"],["みだら"],["な"],["者","もの"],["、"],["汚れた","よごれた"],["者","もの"],["、"],["また"],["貪欲","どんよく"],["な"],["者","もの"],["、"],["つまり"],["、"],["偶像","ぐうぞう"],["礼拝者","れいはいしゃ"],["は"],["、"],["キリスト"],["と"],["神","かみ"],["と"],["の"],["国","くに"],["を"],["受け継ぐ","うけつぐ"],["こと"],["は"],["できません"],["。"],["この"],["こと"],["を"],["よく"],["わきまえ"],["なさい"],["。"]]},{"verse":6,"text":"むなしい言葉に惑わされてはなりません。これらの行いのゆえに、神の怒りは不従順な者たちに下るのです。","tok":[["むなしい"],["言葉","ことば"],["に"],["惑わされて","まどわされて"],["は"],["なりません"],["。"],["これ"],["ら"],["の"],["行い","おこない"],["の"],["ゆえ"],["に"],["、"],["神","かみ"],["の"],["怒り","いかり"],["は"],["不","ふ"],["従順","じゅうじゅん"],["な"],["者","もの"],["たち"],["に"],["下る","くだる"],["の"],["です"],["。"]]},{"verse":7,"text":"だから、彼らの仲間に引き入れられないようにしなさい。","tok":[["だ"],["から"],["、"],["彼","かれ"],["ら"],["の"],["仲間","なかま"],["に"],["引き入れられない","ひきいれられない"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":8,"text":"あなたがたは、以前には暗闇でしたが、今は主に結ばれて、光となっています。光の子として歩みなさい。","tok":[["あなた"],["がた"],["は"],["、"],["以前","いぜん"],["に"],["は"],["暗闇","くらやみ"],["でした"],["が"],["、"],["今","いま"],["は"],["主に","おもに"],["結ばれて","むすばれて"],["、"],["光","ひかり"],["と"],["なって"],["います"],["。"],["光","ひかり"],["の"],["子","こ"],["として"],["歩み","あゆみ"],["なさい"],["。"]]},{"verse":9,"text":"――光から、あらゆる善意と正義と真実とが生じるのです。――","tok":[["―"],["―"],["光","ひかり"],["から"],["、"],["あらゆる"],["善意","ぜんい"],["と"],["正義","まさよし"],["と"],["真実","しんじつ"],["と"],["が"],["生じる","しょうじる"],["の"],["です"],["。"],["―"],["―"]]},{"verse":10,"text":"何が主に喜ばれるかを吟味しなさい。","tok":[["何","なん"],["が"],["主に","おもに"],["喜ばれる","よろこばれる"],["か"],["を"],["吟味","ぎんみ"],["し"],["なさい"],["。"]]},{"verse":11,"text":"実を結ばない暗闇の業に加わらないで、むしろ、それを明るみに出しなさい。","tok":[["実","じつ"],["を"],["結ばない","むすばない"],["暗闇","くらやみ"],["の"],["業","ごう"],["に"],["加わらないで","くわわらないで"],["、"],["むしろ"],["、"],["それ"],["を"],["明るみ","あかるみ"],["に"],["出し","だし"],["なさい"],["。"]]},{"verse":12,"text":"彼らがひそかに行っているのは、口にするのも恥ずかしいことなのです。","tok":[["彼","かれ"],["ら"],["が"],["ひそか"],["に"],["行って","おこなって"],["いる"],["の"],["は"],["、"],["口","くち"],["に"],["する"],["の"],["も"],["恥ずかしい","はずかしい"],["こと"],["な"],["の"],["です"],["。"]]},{"verse":13,"text":"しかし、すべてのものは光にさらされて、明らかにされます。","tok":[["しかし"],["、"],["すべて"],["の"],["もの"],["は"],["光","ひかり"],["に"],["さらされて"],["、"],["明らか","あきらか"],["に"],["されます"],["。"]]},{"verse":14,"text":"明らかにされるものはみな、光となるのです。それで、こう言われています。「眠りについている者、起きよ。死者の中から立ち上がれ。そうすれば、キリストはあなたを照らされる。」","tok":[["明らか","あきらか"],["に"],["される"],["もの"],["は"],["みな"],["、"],["光","ひかり"],["と"],["なる"],["の"],["です"],["。"],["それ"],["で"],["、"],["こう"],["言われて","いわれて"],["います"],["。"],["「"],["眠り","ねむり"],["について"],["いる"],["者","もの"],["、"],["起き","おき"],["よ"],["。"],["死者","ししゃ"],["の"],["中","なか"],["から"],["立ち上がれ","たちあがれ"],["。"],["そう"],["すれば"],["、"],["キリスト"],["は"],["あなた"],["を"],["照らされる","てらされる"],["。"],["」"]]},{"verse":15,"text":"愚かな者としてではなく、賢い者として、細かく気を配って歩みなさい。","tok":[["愚か","おろか"],["な"],["者","もの"],["として"],["で"],["は"],["なく"],["、"],["賢い","かしこい"],["者","もの"],["として"],["、"],["細かく","こまかく"],["気","き"],["を"],["配って","くばって"],["歩み","あゆみ"],["なさい"],["。"]]},{"verse":16,"text":"時をよく用いなさい。今は悪い時代なのです。","tok":[["時","とき"],["を"],["よく"],["用い","もちい"],["なさい"],["。"],["今","いま"],["は"],["悪い","わるい"],["時代","じだい"],["な"],["の"],["です"],["。"]]},{"verse":17,"text":"だから、無分別な者とならず、主の御心が何であるかを悟りなさい。","tok":[["だ"],["から"],["、"],["無分別","むふんべつ"],["な"],["者","もの"],["と"],["ならず"],["、"],["主","ぬし"],["の"],["御心","おこころ"],["が"],["何","なん"],["で"],["ある"],["か"],["を"],["悟り","さとり"],["なさい"],["。"]]},{"verse":18,"text":"酒に酔いしれてはなりません。それは身を持ち崩すもとです。むしろ、霊に満たされ、","tok":[["酒","さけ"],["に"],["酔いしれて","よいしれて"],["は"],["なりません"],["。"],["それ"],["は"],["身","み"],["を"],["持ち崩す","もちくずす"],["もと"],["です"],["。"],["むしろ"],["、"],["霊","れい"],["に"],["満たされ","みたされ"],["、"]]},{"verse":19,"text":"詩編と賛歌と霊的な歌によって語り合い、主に向かって心からほめ歌いなさい。","tok":[["詩編","しへん"],["と"],["賛歌","さんか"],["と"],["霊的","れいてき"],["な"],["歌","うた"],["によって"],["語り合い","かたりあい"],["、"],["主に","おもに"],["向かって","むかって"],["心","こころ"],["から"],["ほめ"],["歌い","うたい"],["なさい"],["。"]]},{"verse":20,"text":"そして、いつも、あらゆることについて、わたしたちの主イエス‧キリストの名により、父である神に感謝しなさい。","tok":[["そして"],["、"],["いつも"],["、"],["あらゆる"],["こと"],["について"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["名","な"],["に"],["より"],["、"],["父","ちち"],["で"],["ある"],["神","かみ"],["に"],["感謝","かんしゃ"],["し"],["なさい"],["。"]]},{"verse":21,"text":"キリストに対する畏れをもって、互いに仕え合いなさい。","tok":[["キリスト"],["に"],["対する","たいする"],["畏れ","おそれ"],["を"],["もって"],["、"],["互い","たがい"],["に"],["仕え","つかえ"],["合い","あい"],["なさい"],["。"]]},{"verse":22,"text":"妻たちよ、主に仕えるように、自分の夫に仕えなさい。","tok":[["妻たち","つまたち"],["よ"],["、"],["主に","おもに"],["仕える","つかえる"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["夫","おっと"],["に"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":23,"text":"キリストが教会の頭であり、自らその体の救い主であるように、夫は妻の頭だからです。","tok":[["キリスト"],["が"],["教会","きょうかい"],["の"],["頭","あたま"],["で"],["あり"],["、"],["自ら","みずから"],["その"],["体","からだ"],["の"],["救い主","すくいぬし"],["で"],["ある"],["よう"],["に"],["、"],["夫","おっと"],["は"],["妻","つま"],["の"],["頭","あたま"],["だ"],["から"],["です"],["。"]]},{"verse":24,"text":"また、教会がキリストに仕えるように、妻もすべての面で夫に仕えるべきです。","tok":[["また"],["、"],["教会","きょうかい"],["が"],["キリスト"],["に"],["仕える","つかえる"],["よう"],["に"],["、"],["妻","つま"],["も"],["すべて"],["の"],["面","めん"],["で"],["夫","おっと"],["に"],["仕えるべきです","つかえるべきです"],["。"]]},{"verse":25,"text":"夫たちよ、キリストが教会を愛し、教会のために御自分をお与えになったように、妻を愛しなさい。","tok":[["夫","おっと"],["たち"],["よ"],["、"],["キリスト"],["が"],["教会","きょうかい"],["を"],["愛し","あいし"],["、"],["教会","きょうかい"],["の"],["ため"],["に"],["御自分","ごじぶん"],["を"],["お与え","おあたえ"],["に"],["なった"],["よう"],["に"],["、"],["妻","つま"],["を"],["愛し","あいし"],["なさい"],["。"]]},{"verse":26,"text":"キリストがそうなさったのは、言葉を伴う水の洗いによって、教会を清めて聖なるものとし、","tok":[["キリスト"],["が"],["そう"],["なさった"],["の"],["は"],["、"],["言葉","ことば"],["を"],["伴う","ともなう"],["水","みず"],["の"],["洗い","あらい"],["によって"],["、"],["教会","きょうかい"],["を"],["清めて","きよめて"],["聖","せい"],["なる"],["もの"],["と"],["し"],["、"]]},{"verse":27,"text":"しみやしわやそのたぐいのものは何一つない、聖なる、汚れのない、栄光に輝く教会を御自分の前に立たせるためでした。","tok":[["しみ"],["や"],["しわ"],["や"],["その"],["たぐい"],["の"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["ない"],["、"],["聖","せい"],["なる"],["、"],["汚れ","よごれ"],["の"],["ない"],["、"],["栄光","えいこう"],["に"],["輝く","かがやく"],["教会","きょうかい"],["を"],["御自分","ごじぶん"],["の"],["前","まえ"],["に"],["立たせる","たたせる"],["ため"],["でした"],["。"]]},{"verse":28,"text":"そのように夫も、自分の体のように妻を愛さなくてはなりません。妻を愛する人は、自分自身を愛しているのです。","tok":[["その"],["よう"],["に"],["夫","おっと"],["も"],["、"],["自分","じぶん"],["の"],["体","からだ"],["の"],["よう"],["に"],["妻","つま"],["を"],["愛さなくて","あいさなくて"],["は"],["なりません"],["。"],["妻","つま"],["を"],["愛する","あいする"],["人","ひと"],["は"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["愛して","あいして"],["いる"],["の"],["です"],["。"]]},{"verse":29,"text":"わが身を憎んだ者は一人もおらず、かえって、キリストが教会になさったように、わが身を養い、いたわるものです。","tok":[["わが"],["身","み"],["を"],["憎んだ","にくんだ"],["者","もの"],["は"],["一人","ひとり"],["も"],["おらず"],["、"],["かえって"],["、"],["キリスト"],["が"],["教会","きょうかい"],["に"],["なさった"],["よう"],["に"],["、"],["わが"],["身","み"],["を"],["養い","やしな
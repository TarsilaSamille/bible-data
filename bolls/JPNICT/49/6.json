[{"verse":1,"text":"子供たち、主に結ばれている者として両親に従いなさい。それは正しいことです。","tok":[["子供","こども"],["たち"],["、"],["主に","おもに"],["結ばれて","むすばれて"],["いる"],["者","もの"],["として"],["両親","りょうしん"],["に"],["従い","したがい"],["なさい"],["。"],["それ"],["は"],["正しい","ただしい"],["こと"],["です"],["。"]]},{"verse":2,"text":"「父と母を敬いなさい。」これは約束を伴う最初の掟です。","tok":[["「"],["父","ちち"],["と"],["母","はは"],["を"],["敬い","うやまい"],["なさい"],["。"],["」"],["これ"],["は"],["約束","やくそく"],["を"],["伴う","ともなう"],["最初","さいしょ"],["の"],["掟","おきて"],["です"],["。"]]},{"verse":3,"text":"「そうすれば、あなたは幸福になり、地上で長く生きることができる」という約束です。","tok":[["「"],["そう"],["すれば"],["、"],["あなた"],["は"],["幸福","こうふく"],["に"],["なり"],["、"],["地上","ちじょう"],["で"],["長く","ながく"],["生きる","いきる"],["こと"],["が"],["できる"],["」"],["と"],["いう"],["約束","やくそく"],["です"],["。"]]},{"verse":4,"text":"父親たち、子供を怒らせてはなりません。主がしつけ諭されるように、育てなさい。","tok":[["父親","ちちおや"],["たち"],["、"],["子供","こども"],["を"],["怒らせて","おこらせて"],["は"],["なりません"],["。"],["主","ぬし"],["が"],["しつけ"],["諭される","さとされる"],["よう"],["に"],["、"],["育て","そだて"],["なさい"],["。"]]},{"verse":5,"text":"奴隷たち、キリストに従うように、恐れおののき、真心を込めて、肉による主人に従いなさい。","tok":[["奴隷","どれい"],["たち"],["、"],["キリスト"],["に"],["従う","したがう"],["よう"],["に"],["、"],["恐れおののき","おそれおののき"],["、"],["真心","まごころ"],["を"],["込めて","こめて"],["、"],["肉","にく"],["に"],["よる"],["主人","しゅじん"],["に"],["従い","したがい"],["なさい"],["。"]]},{"verse":6,"text":"人にへつらおうとして、うわべだけで仕えるのではなく、キリストの奴隷として、心から神の御心を行い、","tok":[["人","ひと"],["に"],["へつらおう"],["として"],["、"],["うわべ"],["だけ"],["で"],["仕える","つかえる"],["ので"],["は"],["なく"],["、"],["キリスト"],["の"],["奴隷","どれい"],["として"],["、"],["心","こころ"],["から"],["神","かみ"],["の"],["御心","おこころ"],["を"],["行い","おこない"],["、"]]},{"verse":7,"text":"人にではなく主に仕えるように、喜んで仕えなさい。","tok":[["人","ひと"],["に"],["で"],["は"],["なく"],["主に","おもに"],["仕える","つかえる"],["よう"],["に"],["、"],["喜んで","よろこんで"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":8,"text":"あなたがたも知っているとおり、奴隷であっても自由な身分の者であっても、善いことを行えば、だれでも主から報いを受けるのです。","tok":[["あなた"],["がた"],["も"],["知って","しって"],["いる"],["とおり"],["、"],["奴隷","どれい"],["で"],["あって"],["も"],["自由","じゆう"],["な"],["身分","みぶん"],["の"],["者","もの"],["で"],["あって"],["も"],["、"],["善い","よい"],[
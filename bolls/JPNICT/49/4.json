[{"verse":1,"text":"そこで、主に結ばれて囚人となっているわたしはあなたがたに勧めます。神から招かれたのですから、その招きにふさわしく歩み、","tok":[["そこ"],["で"],["、"],["主に","おもに"],["結ばれて","むすばれて"],["囚人","しゅうじん"],["と"],["なって"],["いる"],["わたし"],["は"],["あなた"],["がた"],["に"],["勧めます","すすめます"],["。"],["神","かみ"],["から"],["招かれた","まねかれた"],["の"],["です"],["から"],["、"],["その"],["招き","まねき"],["に"],["ふさわしく"],["歩み","あゆみ"],["、"]]},{"verse":2,"text":"一切高ぶることなく、柔和で、寛容の心を持ちなさい。愛をもって互いに忍耐し、","tok":[["一切","いっさい"],["高ぶる","たかぶる"],["こと"],["なく"],["、"],["柔和","にゅうわ"],["で"],["、"],["寛容","かんよう"],["の"],["心","こころ"],["を"],["持ち","もち"],["なさい"],["。"],["愛","あい"],["を"],["もって"],["互い","たがい"],["に"],["忍耐","にんたい"],["し"],["、"]]},{"verse":3,"text":"平和のきずなで結ばれて、霊による一致を保つように努めなさい。","tok":[["平和","へいわ"],["の"],["きずな"],["で"],["結ばれて","むすばれて"],["、"],["霊","れい"],["に"],["よる"],["一致","いっち"],["を"],["保つ","たもつ"],["よう"],["に"],["努め","つとめ"],["なさい"],["。"]]},{"verse":4,"text":"体は一つ、霊は一つです。それは、あなたがたが、一つの希望にあずかるようにと招かれているのと同じです。","tok":[["体","からだ"],["は"],["一","ひと"],["つ"],["、"],["霊","れい"],["は"],["一","ひと"],["つ"],["です"],["。"],["それ"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["一","ひと"],["つ"],["の"],["希望","きぼう"],["に"],["あずかる"],["よう"],["に"],["と"],["招かれて","まねかれて"],["いる"],["の"],["と"],["同じ","おなじ"],["です"],["。"]]},{"verse":5,"text":"主は一人、信仰は一つ、洗礼は一つ、","tok":[["主","ぬし"],["は"],["一人","ひとり"],["、"],["信仰","しんこう"],["は"],["一","ひと"],["つ"],["、"],["洗礼","せんれい"],["は"],["一","ひと"],["つ"],["、"]]},{"verse":6,"text":"すべてのものの父である神は唯一であって、すべてのものの上にあり、すべてのものを通して働き、すべてのものの内におられます。","tok":[["すべて"],["の"],["もの"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["は"],["唯一","ゆいいつ"],["で"],["あって"],["、"],["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["あり"],["、"],["すべて"],["の"],["もの"],["を"],["通して","とおして"],["働き","はたらき"],["、"],["すべて"],["の"],["もの"],["の"],["内","うち"],["に"],["おられます"],["。"]]},{"verse":7,"text":"しかし、わたしたち一人一人に、キリストの賜物のはかりに従って、恵みが与えられています。","tok":[["しかし"],["、"],["わたしたち"],["一人一人","ひとりひとり"],["に"],["、"],["キリスト"],["の"],["賜物","たまもの"],["の"],["はかり"],["に"],["従って","したがって"],["、"],["恵み","めぐみ"],["が"],["与えられて","あたえられて"],["います"],["。"]]},{"verse":8,"text":"そこで、「高い所に昇るとき、捕らわれ人を連れて行き、人々に賜物を分け与えられた」と言われています。","tok":[["そこ"],["で"],["、"],["「"],["高い","たかい"],["所","ところ"],["に"],["昇る","のぼる"],["とき"],["、"],["捕らわれ","とらわれ"],["人","ひと"],["を"],["連れて","つれて"],["行き","いき"],["、"],["人々","ひとびと"],["に"],["賜物","たまもの"],["を"],["分け与えられた","わけあたえられた"],["」"],["と"],["言われて","いわれて"],["います"],["。"]]},{"verse":9,"text":"「昇った」というのですから、低い所、地上に降りておられたのではないでしょうか。","tok":[["「"],["昇った","のぼった"],["」"],["と"],["いう"],["の"],["です"],["から"],["、"],["低い","ひくい"],["所","ところ"],["、"],["地上","ちじょう"],["に"],["降りて","おりて"],["おられた"],["ので"],["は"],["ないでしょう"],["か"],["。"]]},{"verse":10,"text":"この降りて来られた方が、すべてのものを満たすために、もろもろの天よりも更に高く昇られたのです。","tok":[["この"],["降りて","おりて"],["来られた","こられた"],["方","ほう"],["が"],["、"],["すべて"],["の"],["もの"],["を"],["満たす","みたす"],["ため"],["に"],["、"],["もろもろ"],["の"],["天","てん"],["より"],["も"],["更に","さらに"],["高く","たかく"],["昇られた","のぼられた"],["の"],["です"],["。"]]},{"verse":11,"text":"そして、ある人を使徒、ある人を預言者、ある人を福音宣教者、ある人を牧者、教師とされたのです。","tok":[["そして"],["、"],["ある"],["人","ひと"],["を"],["使徒","しと"],["、"],["ある"],["人","ひと"],["を"],["預言者","よげんしゃ"],["、"],["ある"],["人","ひと"],["を"],["福音","ふくいん"],["宣教者","せんきょうしゃ"],["、"],["ある"],["人","ひと"],["を"],["牧者","ぼくしゃ"],["、"],["教師","きょうし"],["と"],["された"],["の"],["です"],["。"]]},{"verse":12,"text":"こうして、聖なる者たちは奉仕の業に適した者とされ、キリストの体を造り上げてゆき、","tok":[["こう"],["して"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["は"],["奉仕","ほうし"],["の"],["業","ごう"],["に"],["適した","てきした"],["者","もの"],["と"],["され"],["、"],["キリスト"],["の"],["体","からだ"],["を"],["造り上げて","つくりあげて"],["ゆき"],["、"]]},{"verse":13,"text":"ついには、わたしたちは皆、神の子に対する信仰と知識において一つのものとなり、成熟した人間になり、キリストの満ちあふれる豊かさになるまで成長するのです。","tok":[["ついに"],["は"],["、"],["わたしたち"],["は"],["皆","みな"],["、"],["神","かみ"],["の"],["子","こ"],["に"],["対する","たいする"],["信仰","しんこう"],["と"],["知識","ちしき"],["に"],["おいて"],["一","ひと"],["つ"],["の"],["もの"],["と"],["なり"],["、"],["成熟","せいじゅく"],["した"],["人間","にんげん"],["に"],["なり"],["、"],["キリスト"],["の"],["満ちあふれる","みちあふれる"],["豊か","ゆたか"],["さ"],["に"],["なる"],["まで"],["成長","せいちょう"],["する"],["の"],["です"],["。"]]},{"verse":14,"text":"こうして、わたしたちは、もはや未熟な者ではなくなり、人々を誤りに導こうとする悪賢い人間の、風のように変わりやすい教えに、もてあそばれたり、引き回されたりすることなく、","tok":[["こう"],["して"],["、"],["わたしたち"],["は"],["、"],["もはや"],["未熟","みじゅく"],["な"],["者","もの"],["で"],["は"],["なくなり"],["、"],["人々","ひとびと"],["を"],["誤り","あやまり"],["に"],["導こう","みちびこう"],["と"],["する"],["悪賢い","わるがしこい"],["人間","にんげん"],["の"],["、"],["風","かぜ"],["の"],["よう"],["に"],["変わり","かわり"],["やすい"],["教え","おしえ"],["に"],["、"],["もてあそばれ"],["たり"],["、"],["引き回され","ひきまわされ"],["たり"],["する"],["こと"],["なく"],["、"]]},{"verse":15,"text":"むしろ、愛に根ざして真理を語り、あらゆる面で、頭であるキリストに向かって成長していきます。","tok":[["むしろ"],["、"],["愛","あい"],["に"],["根ざして","ねざして"],["真理","しんり"],["を"],["語り","かたり"],["、"],["あらゆる"],["面","めん"],["で"],["、"],["頭","あたま"],["で"],["ある"],["キリスト"],["に"],["向かって","むかって"],["成長","せいちょう"],["して"],["いきます"],["。"]]},{"verse":16,"text":"キリストにより、体全体は、あらゆる節々が補い合うことによってしっかり組み合わされ、結び合わされて、おのおのの部分は分に応じて働いて体を成長させ、自ら愛によって造り上げられてゆくのです。","tok":[["キリスト"],["に"],["より"],["、"],["体","たい"],["全体","ぜんたい"],["は"],["、"],["あらゆる"],["節々","ふしぶし"],["が"],["補い合う","おぎないあう"],["こと"],["によって"],["しっかり"],["組み合わされ","くみあわされ"],["、"],["結び合わされて","むすびあわされて"],["、"],["おのおの"],["の"],["部分","ぶぶん"],["は"],["分","ぶん"],["に"],["応じて","おうじて"],["働いて","はたらいて"],["体","からだ"],["を"],["成長","せいちょう"],["させ"],["、"],["自ら","みずから"],["愛","あい"],["によって"],["造り上げられて","つくりあげられて"],["ゆく"],["の"],["です"],["。"]]},{"verse":17,"text":"そこで、わたしは主によって強く勧めます。もはや、異邦人と同じように歩んではなりません。彼らは愚かな考えに従って歩み、","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["主に","おもに"],["よって"],["強く","つよく"],["勧めます","すすめます"],["。"],["もはや"],["、"],["異邦人","いほうじん"],["と"],["同じ","おなじ"],["よう"],["に"],["歩んで","あゆんで"],["は"],["なりません"],["。"],["彼","かれ"],["ら"],["は"],["愚か","おろか"],["な"],["考え","かんがえ"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"]]},{"verse":18,"text":"知性は暗くなり、彼らの中にある無知とその心のかたくなさのために、神の命から遠く離れています。","tok":[["知性","ちせい"],["は"],["暗く","くらく"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["ある"],["無知","むち"],["と"],["その"],["心","こころ"],["の"],["かたくな"],["さ"],["の"],["ため"],["に"],["、"],["神","かみ"],["の"],["命","いのち"],["から"],["遠く","とおく"],["離れて","はなれて"],["います"],["。"]]},{"verse":19,"text":"そして、無感覚になって放縦な生活をし、あらゆるふしだらな行いにふけってとどま
[{"verse":1,"text":"さて、あなたがたは、以前は自分の過ちと罪のために死んでいたのです。","tok":[["さて"],["、"],["あなた"],["がた"],["は"],["、"],["以前","いぜん"],["は"],["自分","じぶん"],["の"],["過ち","あやまち"],["と"],["罪","つみ"],["の"],["ため"],["に"],["死んで","しんで"],["いた"],["の"],["です"],["。"]]},{"verse":2,"text":"この世を支配する者、かの空中に勢力を持つ者、すなわち、不従順な者たちの内に今も働く霊に従い、過ちと罪を犯して歩んでいました。","tok":[["この世","このよ"],["を"],["支配","しはい"],["する"],["者","もの"],["、"],["かの"],["空中","くうちゅう"],["に"],["勢力","せいりょく"],["を"],["持つ","もつ"],["者","もの"],["、"],["すなわち"],["、"],["不","ふ"],["従順","じゅうじゅん"],["な"],["者","もの"],["たち"],["の"],["内","うち"],["に"],["今","いま"],["も"],["働く","はたらく"],["霊","れい"],["に"],["従い","したがい"],["、"],["過ち","あやまち"],["と"],["罪","つみ"],["を"],["犯して","おかして"],["歩んで","あゆんで"],["いました"],["。"]]},{"verse":3,"text":"わたしたちも皆、こういう者たちの中にいて、以前は肉の欲望の赴くままに生活し、肉や心の欲するままに行動していたのであり、ほかの人々と同じように、生まれながら神の怒りを受けるべき者でした。","tok":[["わたしたち"],["も"],["皆","みな"],["、"],["こう"],["いう"],["者","もの"],["たち"],["の"],["中","なか"],["に"],["いて"],["、"],["以前","いぜん"],["は"],["肉","にく"],["の"],["欲望","よくぼう"],["の"],["赴く","おもむく"],["まま"],["に"],["生活","せいかつ"],["し"],["、"],["肉","にく"],["や"],["心","こころ"],["の"],["欲する","ほっする"],["まま"],["に"],["行動","こうどう"],["して"],["いた"],["ので"],["あり"],["、"],["ほか"],["の"],["人々","ひとびと"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["生まれ","うまれ"],["ながら"],["神","かみ"],["の"],["怒り","いかり"],["を"],["受けるべき","うけるべき"],["者","もの"],["でした"],["。"]]},{"verse":4,"text":"しかし、憐れみ豊かな神は、わたしたちをこの上なく愛してくださり、その愛によって、","tok":[["しかし"],["、"],["憐れみ","あわれみ"],["豊か","ゆたか"],["な"],["神","かみ"],["は"],["、"],["わたしたち"],["を"],["この"],["上","うえ"],["なく"],["愛して","あいして"],["くださり"],["、"],["その"],["愛","あい"],["によって"],["、"]]},{"verse":5,"text":"罪のために死んでいたわたしたちをキリストと共に生かし、――あなたがたの救われたのは恵みによるのです――","tok":[["罪","つみ"],["の"],["ため"],["に"],["死んで","しんで"],["いた"],["わたしたち"],["を"],["キリスト"],["と"],["共","とも"],["に"],["生かし","いかし"],["、"],["―"],["―"],["あなた"],["がた"],["の"],["救われた","すくわれた"],["の"],["は"],["恵み","めぐみ"],["に"],["よる"],["の"],["です"],["―"],["―"]]},{"verse":6,"text":"キリスト‧イエスによって共に復活させ、共に天の王座に着かせてくださいました。","tok":[["キリスト"],["‧"],["イエス"],["によって"],["共","とも"],["に"],["復活","ふっかつ"],["させ"],["、"],["共","とも"],["に"],["天","てん"],["の"],["王座","おうざ"],["に"],["着かせて","つかせて"],["くださいました"],["。"]]},{"verse":7,"text":"こうして、神は、キリスト‧イエスにおいてわたしたちにお示しになった慈しみにより、その限りなく豊かな恵みを、来るべき世に現そうとされたのです。","tok":[["こう"],["して"],["、"],["神","かみ"],["は"],["、"],["キリスト"],["‧"],["イエス"],["に"],["おいて"],["わたしたち"],["に"],["お示し","おしめし"],["に"],["なった"],["慈しみ","いつくしみ"],["に"],["より"],["、"],["その"],["限り","かぎり"],["なく"],["豊か","ゆたか"],["な"],["恵み","めぐみ"],["を"],["、"],["来るべき","きたるべき"],["世","よ"],["に"],["現そう","あらわそう"],["と"],["された"],["の"],["です"],["。"]]},{"verse":8,"text":"事実、あなたがたは、恵みにより、信仰によって救われました。このことは、自らの力によるのではなく、神の賜物です。","tok":[["事実","じじつ"],["、"],["あなた"],["がた"],["は"],["、"],["恵み","めぐみ"],["に"],["より"],["、"],["信仰","しんこう"],["によって"],["救われました","すくわれました"],["。"],["この"],["こと"],["は"],["、"],["自ら","みずから"],["の"],["力","ちから"],["に"],["よる"],["ので"],["は"],["なく"],["、"],["神","かみ"],["の"],["賜物","たまもの"],["です"],["。"]]},{"verse":9,"text":"行いによるのではありません。それは、だれも誇ることがないためなのです。","tok":[["行い","おこない"],["に"],["よる"],["ので"],["は"],["ありません"],["。"],["それ"],["は"],["、"],["だれ"],["も"],["誇る","ほこる"],["こと"],["が"],["ない"],["ため"],["な"],["の"],["です"],["。"]]},{"verse":10,"text":"なぜなら、わたしたちは神に造られたものであり、しかも、神が前もって準備してくださった善い業のために、キリスト‧イエスにおいて造られたからです。わたしたちは、その善い業を行って歩むのです。","tok":[["なぜ"],["なら"],["、"],["わたしたち"],["は"],["神","かみ"],["に"],["造られた","つくられた"],["もの"],["で"],["あり"],["、"],["しかも"],["、"],["神","かみ"],["が"],["前もって","まえもって"],["準備","じゅんび"],["して"],["くださった"],["善い","よい"],["業","ごう"],["の"],["ため"],["に"],["、"],["キリスト"],["‧"],["イエス"],["に"],["おいて"],["造られた","つくられた"],["から"],["です"],["。"],["わたしたち"],["は"],["、"],["その"],["善い","よい"],["業","ごう"],["を"],["行って","おこなって"],["歩む","あゆむ"],["の"],["です"],["。"]]},{"verse":11,"text":"だから、心に留めておきなさい。あなたがたは以前には肉によれば異邦人であり、いわゆる手による割礼を身に受けている人々からは、割礼のない者と呼ばれていました。","tok":[["だ"],["から"],["、"],["心","こころ"],["に"],["留めて","とめて"],["おき"],["なさい"],["。"],["あなた"],["がた"],["は"],["以前","いぜん"],["に"],["は"],["肉","にく"],["に"],["よれば"],["異邦人","いほうじん"],["で"],["あり"],["、"],["いわゆる"],["手","て"],["に"],["よる"],["割礼","かつれい"],["を"],["身","み"],["に"],["受けて","うけて"],["いる"],["人々","ひとびと"],["から"]
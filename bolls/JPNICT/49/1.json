[{"verse":1,"text":"神の御心によってキリスト‧イエスの使徒とされたパウロから、エフェソにいる聖なる者たち、キリスト‧イエスを信ずる人たちへ。","tok":[["神","かみ"],["の"],["御心","おこころ"],["によって"],["キリスト"],["‧"],["イエス"],["の"],["使徒","しと"],["と"],["された"],["パウロ"],["から"],["、"],["エフェソ"],["に"],["いる"],["聖","せい"],["なる"],["者","もの"],["たち"],["、"],["キリスト"],["‧"],["イエス"],["を"],["信ずる","しんずる"],["人","ひと"],["たち"],["へ"],["。"]]},{"verse":2,"text":"わたしたちの父である神と主イエス‧キリストからの恵みと平和が、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["から"],["の"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":3,"text":"わたしたちの主イエス‧キリストの父である神は、ほめたたえられますように。神は、わたしたちをキリストにおいて、天のあらゆる霊的な祝福で満たしてくださいました。","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["は"],["、"],["ほめたたえられます"],["よう"],["に"],["。"],["神","かみ"],["は"],["、"],["わたしたち"],["を"],["キリスト"],["に"],["おいて"],["、"],["天","てん"],["の"],["あらゆる"],["霊的","れいてき"],["な"],["祝福","しゅくふく"],["で"],["満たして","みたして"],["くださいました"],["。"]]},{"verse":4,"text":"天地創造の前に、神はわたしたちを愛して、御自分の前で聖なる者、汚れのない者にしようと、キリストにおいてお選びになりました。","tok":[["天地","てんち"],["創造","そうぞう"],["の"],["前","まえ"],["に"],["、"],["神","かみ"],["は"],["わたしたち"],["を"],["愛して","あいして"],["、"],["御自分","ごじぶん"],["の"],["前","まえ"],["で"],["聖","せい"],["なる"],["者","もの"],["、"],["汚れ","よごれ"],["の"],["ない"],["者","もの"],["に"],["しよう"],["と"],["、"],["キリスト"],["に"],["おいて"],["お選び","おえらび"],["に"],["なりました"],["。"]]},{"verse":5,"text":"イエス‧キリストによって神の子にしようと、御心のままに前もってお定めになったのです。","tok":[["イエス"],["‧"],["キリスト"],["によって"],["神","かみ"],["の"],["子","こ"],["に"],["しよう"],["と"],["、"],["御心","おこころ"],["の"],["まま"],["に"],["前もって","まえもって"],["お定め","おさだめ"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":6,"text":"神がその愛する御子によって与えてくださった輝かしい恵みを、わたしたちがたたえるためです。","tok":[["神","かみ"],["が"],["その"],["愛する","あいする"],["御子","みこ"],["によって"],["与えて","あたえて"],["くださった"],["輝かしい","かがやかしい"],["恵み","めぐみ"],["を"],["、"],["わたしたち"],["が"],["たたえる"],["ため"],["です"],["。"]]},{"verse":7,"text":"わたしたちはこの御子において、その血によって贖われ、罪を赦されました。これは、神の豊かな恵みによるものです。","tok":[["わたしたち"],["は"],["この"],["御子","みこ"],["に"],["おいて"],["、"],["その"],["血","ち"],["によって"],["贖われ","あがなわれ"],["、"],["罪","つみ"],["を"],["赦されました","ゆるされました"],["。"],["これ"],["は"],["、"],["神","かみ"],["の"],["豊か","ゆたか"],["な"],["恵み","めぐみ"],["に"],["よる"],["もの"],["です"],["。"]]},{"verse":8,"text":"神はこの恵みをわたしたちの上にあふれさせ、すべての知恵と理解とを与えて、","tok":[["神","かみ"],["は"],["この"],["恵み","めぐみ"],["を"],["わたしたち"],["の"],["上","うえ"],["に"],["あふれさせ"],["、"],["すべて"],["の"],["知恵","ちえ"],["と"],["理解","りかい"],["と"],["を"],["与えて","あたえて"],["、"]]},{"verse":9,"text":"秘められた計画をわたしたちに知らせてくださいました。これは、前もってキリストにおいてお決めになった神の御心によるものです。","tok":[["秘められた","ひめられた"],["計画","けいかく"],["を"],["わたしたち"],["に"],["知らせて","しらせて"],["くださいました"],["。"],["これ"],["は"],["、"],["前もって","まえもって"],["キリスト"],["に"],["おいて"],["お決め","おきめ"],["に"],["なった"],["神","かみ"],["の"],["御心","おこころ"],["に"],["よる"],["もの"],["です"],["。"]]},{"verse":10,"text":"こうして、時が満ちるに及んで、救いの業が完成され、あらゆるものが、頭であるキリストのもとに一つにまとめられます。天にあるものも地にあるものもキリストのもとに一つにまとめられるのです。","tok":[["こう"],["して"],["、"],["時","とき"],["が"],["満ちる","みちる"],["に"],["及んで","およんで"],["、"],["救い","すくい"],["の"],["業","ごう"],["が"],["完成","かんせい"],["され"],["、"],["あらゆる"],["もの"],["が"],["、"],["頭","あたま"],["で"],["ある"],["キリスト"],["の"],["もと"],["に"],["一","ひと"],["つ"],["に"],["まとめられます"],["。"],["天","てん"],["に"],["ある"],["もの"],["も"],["地","ち"],["に"],["ある"],["もの"],["も"],["キリスト"],["の"],["もと"],["に"],["一","ひと"],["つ"],["に"],["まとめられる"],["の"],["です"],["。"]]},{"verse":11,"text":"キリストにおいてわたしたちは、御心のままにすべてのことを行われる方の御計画によって前もって定められ、約束されたものの相続者とされました。","tok":[["キリスト"],["に"],["おいて"],["わたしたち"],["は"],["、"],["御心","おこころ"],["の"],["まま"],["に"],["すべて"],["の"],["こと"],["を"],["行われる","おこなわれる"],["方","かた"],["の"],["御計画","ごけいかく"],["によって"],["前もって","まえもって"],["定められ","さだめられ"],["、"],["約束","やくそく"],["された"],["もの"],["の"],["相続者","そうぞくしゃ"],["と"],["されました"],["。"]]},{"verse":12,"text":"それは、以前からキリストに希望を置いていたわたしたちが、神の栄光をたたえるためです。","tok":[["それ"],["は"],["、"],["以前","いぜん"],["から"],["キリスト"],["に"],["希望","きぼう"],["を"],["置いて","おいて"],["いた"],["わたしたち"],["が"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["たたえる"],["ため"],["です"],["。"]]},{"verse":13,"text":"あなたがたもまた、キリストにおいて、真理の言葉、救いをもたらす福音を聞き、そして信じて、約束された聖霊で証印を押されたのです。","tok":[["あなた"],["がた"],["も"],["また"],["、"],["キリスト"],["に"],["おいて"],["、"],["真理","しんり"],["の"],["言葉","ことば"],["、"],["救い","すくい"],["を"],["もたらす"],["福音","ふくいん"],["を"],["聞き","きき"],["、"],["そして"],["信じて","しんじて"],["、"],["約束","やくそく"],["された"],["聖霊","せいれい"],["で"],["証印","しょういん"],["を"],["押された","おされた"],["の"],["です"],["。"]]},{"verse":14,"text":"この聖霊は、わたしたちが御国を受け継ぐための保証であり、こうして、わたしたちは贖われて神のものとなり、神の栄光をたたえることになるのです。","tok":[["この"],["聖霊","せいれい"],["は"],["、"],["わたしたち"],["が"],["御国","みくに"],["を"],["受け継ぐ","うけつぐ"],["ため"],["の"],["保証","ほしょう"],["で"],["あり"],["、"],["こう"],["して"],["、"],["わたしたち"],["は"],["贖われて","あがなわれて"],["神","かみ"],["の"],["もの"],["と"],["なり"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["を"],["たたえる"],["こと"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":15,"text":"こういうわけで、わたしも、あなたがたが主イエスを信じ、すべての聖なる者たちを愛していることを聞き、","tok":[["こう"],["いう"],["わけ"],["で"],["、"],["わたし"],["も"],["、"],["あなた"],["がた"],["が"],["主","ぬし"],["イエス"],["を"],["信じ","しんじ"],["、"],["すべて"],["の"],["聖","せい"],["なる"],["者","もの"],["たち"],["を"],["愛して","あいして"],["いる"],["こと"],["を"],["聞き","きき"],["、"]]},{"verse":16,"text":"祈りの度に、あなたがたのことを思い起こし、絶えず感謝しています。","tok":[["祈り","いのり"],["の"],["度","ど"],["に"],["、"],["あなた"],["がた"],["の"],["こと"],["を"],["思い起こし","おもいおこし"],["、"],["絶えず","たえず"],["感謝","かんしゃ"],["して"],["います"],["。"]]},{"verse":17,"text":"どうか、わたしたちの主イエス‧キリストの神、栄光の源である御父が、あなたがたに知恵と啓示との霊を与え、神を深く知ることができるようにし、","tok":[["どう"],["か"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["神","かみ"],["、"],["栄光","えいこう"],["の"],["源","みなもと"],["で"],["ある"],["御父","おちち"],["が"],["、"],["あなた"],["がた"],["に"],["知恵","ちえ"],["と"],["啓示","けいじ"],["と"],["の"],["霊","れい"],["を"],["与え","あたえ"],["、"],["神","かみ"],["を"],["深く","ふかく"],["知る","しる"],["こと"],["が"],["できる"],["よう"],["に"],["し"],["、"]]},{"verse":18,"text":"心の目を開いてくださるように。そして、神の招きによってどのような希望が与えられているか、聖なる者たちの受け継ぐものがどれほど豊かな栄光に輝いているか悟らせてくださるように。","tok":[["心","こころ"],["の"],["目","め"],["を"],["開いて","ひらいて"],["くださる"],["よう"],["に"],["。"],["そして"],["、"],["神","かみ"],["の"],["招き","まねき"],["によって"],["どのような"],["希望","きぼう"],["が"],["与えられて","あたえられて"],["いる"],["か"],["、"],["聖","せい"],["なる"],["者","もの"],["たち"],["の"],["受け継ぐ","うけつぐ"],["もの"],["が"],["どれ"],["ほど"],["豊か","ゆたか"],["な"],["栄光","えいこう"],["に"],["輝いて","かがやいて"],["いる"],["か"],["悟らせて","さとらせて"],["くださる"],["よう"],["に"],["。"]]},{"verse":19,"text":"また、わたしたち信仰者に対して絶大な働きをなさる神の力が、どれほど大きなものであるか、悟らせてくださるように。","tok":[["また"],["、"],["わたしたち"],["信仰者","しんこうしゃ"],["に対して","にたいして"],["絶大","ぜつだい"],["な"],["働き","はたらき"],["を"],["なさる"],["神","かみ"],["の"],["力","ちから"],["が"],["、"],["どれ"],["ほど"],["大きな","おおきな"],["もの"],["で"],["ある"],["か"],["、"],["悟らせて","さとらせて"],["くださる"],["よう"],["に"],["。"]]},{"verse":20,"text":"神は、この力をキリストに働かせて、キリストを死者の中から復活させ、天において御自分の右の座に着かせ、","tok":[["神","かみ"],["は"],["、"],["この"],["力","ちから"],["を"],["キリスト"],["に"],["働かせて","はたらかせて"],["、"],["キリスト"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させ"],["、"],["天","てん"],["に"],["おいて"],["御自分","ごじぶん"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着かせ","つかせ"],["、"]]},{"verse":21,"text":"すべての支配、権威、勢力、主権の上に置き、今の世ばかりでなく、来るべき世にも唱えられるあらゆる名の上に置かれました。","tok":[["すべて"],["の"],["支配","しはい"],["、"],["権威","けんい"],["、"],["勢力","せいりょく"],["、"],["主権","しゅけん"],["の"],["上","うえ"],["に"],["置き","おき"],["、"],["今","いま"],["の"],["世","よ"],["ばかり"],["で"],["なく"],["、"],["来るべき","きたるべき"],["世","よ"],["に"],["も"],["唱えられる","となえられる"],["あらゆる"],["名","な"],["の"],["上","うえ"],["に"],["置かれました","おかれました"],["。"]]},{"verse":22,"text":"神はまた、すべてのものをキリストの足もとに従わせ、キリストをすべてのものの上にある頭として教会にお与えになりました。","tok":[["神","かみ"],["は"],["また"],["、"],["すべて"],["の"],["もの"],["を"],["キリスト"],["の"],["足もと","あしもと"],["に"],["従わせ","したがわせ"],["、"],["キリスト"],["を"],["すべて"],["の"],["もの"],["の"],["上","うえ"],["に"],["ある"],["頭","あたま"],["として"],["教会","きょうかい"],["に"],["お与え","おあたえ"],["に"],["なりました"],["。"]]},{"verse":23,"text":"教会はキリストの体であり、すべてにおいてすべてを満たしている方の満ちておられる場です。","tok":[["教会","きょうかい"],["は"],["キリスト"],["の"],["体","からだ"],["で"],["あり"],["、"],["すべて"],["に"],["おいて"],["すべて"],["を"],["満たして","みたして"],["いる"],["方","かた"],["の"],["満ちて","みちて"],["おられる"],["場","ば"],["です"],["。"]]}]
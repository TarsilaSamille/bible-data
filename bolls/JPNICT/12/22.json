[{"verse":1,"text":"ヨシヤは八歳で王となり、三十一年間エルサレムで王位にあった。その母は名をエディダといい、ボツカト出身のアダヤの娘であった。","tok":[["ヨシヤ"],["は"],["八歳","はちさい"],["で"],["王","おう"],["と"],["なり"],["、"],["三十一","さんじゅういち"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["エディダ"],["と"],["いい"],["、"],["ボツカト"],["出身","しゅっしん"],["の"],["アダヤ"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼は主の目にかなう正しいことを行い、父祖ダビデの道をそのまま歩み、右にも左にもそれなかった。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["かなう"],["正しい","ただしい"],["こと"],["を"],["行い","おこない"],["、"],["父祖","ふそ"],["ダビデ"],["の"],["道","みち"],["を"],["そのまま"],["歩み","あゆみ"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それ"],["なかった"],["。"]]},{"verse":3,"text":"ヨシヤ王の治世第十八年に、王はメシュラムの孫でアツァルヤの子である書記官シャファンを主の神殿に遣わして言った。","tok":[["ヨシヤ"],["王","おう"],["の"],["治世","ちせい"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["に"],["、"],["王","おう"],["は"],["メシュラム"],["の"],["孫","まご"],["で"],["アツァルヤ"],["の"],["子","こ"],["で"],["ある"],["書記官","しょきかん"],["シャファン"],["を"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["遣わして","つかわして"],["言った","いった"],["。"]]},{"verse":4,"text":"「大祭司ヒルキヤのもとに上り、主の神殿に納められた献金、すなわち入り口を守る者たちが民から集めたものを集計させなさい。","tok":[["「"],["大","だい"],["祭司","さいし"],["ヒルキヤ"],["の"],["もと"],["に"],["上り","のぼり"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["納められた","おさめられた"],["献金","けんきん"],["、"],["すなわち"],["入り口","いりぐち"],["を"],["守る","まもる"],["者","もの"],["たち"],["が"],["民","たみ"],["から"],["集めた","あつめた"],["もの"],["を"],["集計","しゅうけい"],["させ"],["なさい"],["。"]]},{"verse":5,"text":"それを主の神殿の責任を負っている工事担当者の手に渡し、更に神殿の破損を修理するために主の神殿にいる工事担当者に渡しなさい。","tok":[["それ"],["を"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["責任","せきにん"],["を"],["負って","おって"],["いる"],["工事","こうじ"],["担当者","たんとうしゃ"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["更に","さらに"],["神殿","しんでん"],["の"],["破損","はそん"],["を"],["修理","しゅうり"],["する"],["ため"],["に"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["いる"],["工事","こうじ"],["担当者","たんとうしゃ"],["に"],["渡し","わたし"],["なさい"],["。"]]},{"verse":6,"text":"すなわち職人、建築作業員、石工に渡し、神殿修理のための木材や切り石を買わせなさい。","tok":[["すなわち"],["職人","しょくにん"],["、"],["建築","けんちく"],["作業員","さぎょういん"],["、"],["石工","せっこう"],["に"],["渡し","わたし"],["、"],["神殿","しんでん"],["修理","しゅうり"],["の"],["ため"],["の"],["木材","もくざい"],["や"],["切り石","きりいし"],["を"],["買わせ","かわせ"],["なさい"],["。"]]},{"verse":7,"text":"ただし、彼らは忠実に仕事をしているから、彼らに渡した金の監査は必要ではない。」","tok":[["ただし"],["、"],["彼","かれ"],["ら"],["は"],["忠実","ちゅうじつ"],["に"],["仕事","しごと"],["を"],["して"],["いる"],["から"],["、"],["彼","かれ"],["ら"],["に"],["渡した","わたした"],["金","かね"],["の"],["監査","かんさ"],["は"],["必要","ひつよう"],["で"],["は"],["ない"],["。"],["」"]]},{"verse":8,"text":"そのとき大祭司ヒルキヤは書記官シャファンに、「わたしは主の神殿で律法の書を見つけました」と言った。ヒルキヤがその書をシャファンに渡したので、彼はそれを読んだ。","tok":[["その"],["とき"],["大","だい"],["祭司","さいし"],["ヒルキヤ"],["は"],["書記官","しょきかん"],["シャファン"],["に"],["、"],["「"],["わたし"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["で"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["見つけました","みつけました"],["」"],["と"],["言った","いった"],["。"],["ヒルキヤ"],["が"],["その"],["書","しょ"],["を"],["シャファン"],["に"],["渡した","わたした"],["ので"],["、"],["彼","かれ"],["は"],["それ"],["を"],["読んだ","よんだ"],["。"]]},{"verse":9,"text":"書記官シャファンは王のもとに来て、王に報告した。「僕どもは神殿にあった献金を取り出して、主の神殿の責任を負っている工事担当者の手に渡しました。」","tok":[["書記官","しょきかん"],["シャファン"],["は"],["王","おう"],["の"],["もと"],["に"],["来て","きて"],["、"],["王","おう"],["に"],["報告","ほうこく"],["した"],["。"],["「"],["僕","ぼく"],["ども"],["は"],["神殿","しんでん"],["に"],["あった"],["献金","けんきん"],["を"],["取り出して","とりだして"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["責任","せきにん"],["を"],["負って","おって"],["いる"],["工事","こうじ"],["担当者","たんとうしゃ"],["の"],["手","て"],["に"],["渡しました","わたしました"],["。"],["」"]]},{"verse":10,"text":"更に書記官シャファンは王に、「祭司ヒルキヤがわたしに一つの書を渡しました」と告げ、王の前でその書を読み上げた。","tok":[["更に","さらに"],["書記官","しょきかん"],["シャファン"],["は"],["王","おう"],["に"],["、"],["「"],["祭司","さいし"],["ヒルキヤ"],["が"],["わたし"],["に"],["一","ひと"],["つ"],["の"],["書","しょ"],["を"],["渡しました","わたしました"],["」"],["と"],["告げ","つげ"],["、"],["王","おう"],["の"],["前","まえ"],["で"],["その"],["書","しょ"],["を"],["読み上げた","よみあげた"],["。"]]},{"verse":11,"text":"王はその律法の書の言葉を聞くと、衣を裂いた。","tok":[["王","おう"],["は"],["その"],["律法","りっぽう"],["の"],["書","しょ"],["の"],["言葉","ことば"],["を"],["聞く","きく"],["と"],["、"],["衣","ころも"],["を"],["裂いた","さいた"],["。"]]},{"verse":12,"text":"王は祭司ヒルキヤ、シャファンの子アヒカム、ミカヤの子アクボル、書記官シャファン、王の家臣アサヤにこう命じた。","tok":[["王","おう"],["は"],["祭司","さいし"],["ヒルキヤ"],["、"],["シャファン"],["の"],["子","こ"],["アヒカム"],["、"],["ミカヤ"],["の"],["子","こ"],["アクボル"],["、"],["書記官","しょきかん"],["シャファン"],["、"],["王","おう"],["の"],["家臣","かしん"],["アサヤ"],["に"],["こう"],["命じた","めいじた"],["。"]]},{"verse":13,"text":"「この見つかった書の言葉について、わたしのため、民のため、ユダ全体のために、主の御旨を尋ねに行け。我々の先祖がこの書の言葉に耳を傾けず、我々についてそこに記されたとおりにすべての事を行わなかったために、我々に向かって燃え上がった主の怒りは激しいからだ。」","tok":[["「"],["この"],["見つかった","みつかった"],["書","しょ"],["の"],["言葉","ことば"],["について"],["、"],["わたし"],["の"],["ため"],["、"],["民","みん"],["の"],["ため"],["、"],["ユダ"],["全体","ぜんたい"],["の"],["ため"],["に"],["、"],["主","ぬし"],["の"],["御旨","おむね"],["を"],["尋ね","たずね"],["に"],["行け","いけ"],["。"],["我々","われわれ"],["の"],["先祖","せんぞ"],["が"],["この"],["書","しょ"],["の"],["言葉","ことば"],["に"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["我々","われわれ"],["について"],["そこ"],["に"],["記された","しるされた"],["とおり"],["に"],["すべて"],["の"],["事","こと"],["を"],["行わなかった","おこなわなかった"],["ため"],["に"],["、"],["我々","われわれ"],["に"],["向かって","むかって"],["燃え上がった","もえあがった"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["激しい","はげしい"],["から"],["だ"],["。"],["」"]]},{"verse":14,"text":"祭司ヒルキヤ、アヒカム、アクボル、シャファン、アサヤは女預言者フルダのもとに行った。彼女はハルハスの孫でティクワの子である衣装係シャルムの妻で、エルサレムのミシュネ地区に住んでいた。彼らが彼女に話し聞かせると、","tok":[["祭司","さいし"],["ヒルキヤ"],["、"],["アヒカム"],["、"],["アクボル"],["、"],["シャファン"],["、"],["アサヤ"],["は"],["女","おんな"],["預言者","よげんしゃ"],["フルダ"],["の"],["もと"],["に"],["行った","いった"],["。"],["彼女","かのじょ"],["は"],["ハルハス"],["の"],["孫","まご"],["で"],["ティクワ"],["の"],["子","こ"],["で"],["ある"],["衣装","いしょう"],["係","かかり"],["シャルム"],["の"],["妻","つま"],["で"],["、"],["エルサレム"],["の"],["ミシュネ"],["地区","ちく"],["に"],["住んで","すんで"],["いた"],["。"],["彼","かれ"],["ら"],["が"],["彼女","かのじょ"],["に"],["話し","はなし"],["聞かせる","きかせる"],["と"],["、"]]},{"verse":15,"text":"彼女は答えた。「イスラエルの神、主はこう言われる。『あなたたちをわたしのもとに遣わした者に言いなさい。","tok":[["彼女","かのじょ"],["は"],["答えた","こたえた"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["あなた"],["たち"],["を"],["わたし"],["の"],["もと"],["に"],["遣わした","つかわした"],["者","もの"],["に"],["言い","いい"],["なさい"],["。"]]},{"verse":16,"text":"主はこう言われる。見よ、わたしはユダの王が読んだこの書のすべての言葉のとおりに、この所とその住民に災いをくだす。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["ユダ"],["の"],["王","おう"],["が"],["読んだ","よんだ"],["この"],["書","しょ"],["の"],["すべて"],["の"],["言葉","ことば"],["の"],["とおり"],["に"],["、"],["この"],["所","ところ"],["と"],["その"],["住民","じゅうみん"],["に"],["災い","わざわい"],["を"],["くだす"],["。"]]},{"verse":17,"text":"彼らがわたしを捨て、他の神々に香をたき、自分たちの手で造ったすべてのものによってわたしを怒らせたために、わたしの怒りはこの所に向かって燃え上がり、消えることはない。","tok":[["彼","かれ"],["ら"],["が"],["わたし"],["を"],["捨て","すて"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["香","こう"],["を"],["たき"],["、"],["自分","じぶん"],["たち"],["の"],["手","て"],["で"],["造った","つくった"],["すべて"],["の"],["もの"],["によって"],["わたし"],["を"],["怒らせた","おこらせた"],["ため"],["に"],["、"],["わたし"],["の"],["怒り","いかり"],["は"],["この"],["所","ところ"],["に"],["向かって","むかって"],["燃え上がり","もえあがり"],["、"],["消える","きえる"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"主の心を尋ねるためにあなたたちを遣わしたユダの王にこう言いなさい。あなたが聞いた言葉について、イスラエルの神、主はこう言われる。","tok":[["主","ぬし"],["の"],["心","こころ"],["を"],["尋ねる","たずねる"],["ため"],["に"],["あなた"],["たち"],["を"],["遣わした","つかわした"],["ユダ"],["の"],["王","おう"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["あなた"],["が"],["聞いた","きいた"],["言葉","ことば"],["について"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"]]},{"verse":19,"text":"わたしがこの所とその住民につき、それが荒れ果て呪われたものとなると言ったのを聞いて、あなたは心を痛め、主の前にへりくだり、衣を裂き、わたしの前で泣いたので、わたしはあなたの願いを聞き入れた、と主は言われる。","tok":[["わたし"],["が"],["この"],["所","ところ"],["と"],["その"],["住民","じゅうみん"],["に"],["つき"],["、"],["それ"],["が"],["荒れ果て","あれはて"],["呪われた","のろわれた"],["もの"],["と"],["なる"],["と"],["言った","いった"],["の"],["を"],["聞いて","きいて"],["、"],["あなた"],["は"],["心","こころ"],["を"],["痛め","いため"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["へりくだり"],["、"],["衣","ころも"],["を"],["裂き","さき"],["、"],["わたし"],["の"],["前","まえ"],["で"],["泣いた","ないた"],["ので"],["、"],["わたし"],["は"],["あなた"],["の"],["願い","ねがい"],["を"],["聞き入れた","ききいれた"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":20,"text":"それゆえ、見よ、わたしはあなたを先祖の数に加える。あなたは安らかに息を引き取って墓に葬られるであろう。わたしがこの所にくだす災いのどれも、その目で見ることがない。』」彼らはこれを王に報告した。","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["先祖","せんぞ"],["の"],["数","かず"],["に"],["加える","くわえる"],["。"],["あなた"],["は"],["安らか","やすらか"],["に"],["息","いき"],["を"],["引き取って","ひきとって"],["墓","はか"],["に"],["葬られるで","ほうむられるで"],["あろう"],["。"],["わたし"],["が"],["この"],["所","ところ"],["に"],["くだす"],["災い","わざわい"],["の"],["どれ"],["も"],["、"],["その"],["目","め"],["で"],["見る","みる"],["こと"],["が"],["ない"],["。"],["』"],["」"],["彼","かれ"],["ら"],["は"],["これ"],["を"],["王","おう"],["に"],["報告","ほうこく"],["した"],["。"]]}]
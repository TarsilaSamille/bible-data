[{"verse":1,"text":"ユダの王ヨシャファトの治世第十八年に、アハブの子ヨラムがサマリアでイスラエルの王となり、十二年間王位にあった。","tok":[["ユダ"],["の"],["王","おう"],["ヨシャファト"],["の"],["治世","ちせい"],["第","だい"],["十八","じゅうはち"],["年","ねん"],["に"],["、"],["アハブ"],["の"],["子","こ"],["ヨラム"],["が"],["サマリア"],["で"],["イスラエル"],["の"],["王","おう"],["と"],["なり"],["、"],["十二","じゅうに"],["年間","ねんかん"],["王位","おうい"],["に"],["あった"],["。"]]},{"verse":2,"text":"彼は主の目に悪とされることを行ったが、ただ彼の父や母ほどではなかった。父が作ったバアルの石柱を彼は取り除いた。","tok":[["彼","かれ"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["が"],["、"],["ただ"],["彼","かれ"],["の"],["父","ちち"],["や"],["母","はは"],["ほど"],["で"],["は"],["なかった"],["。"],["父","ちち"],["が"],["作った","つくった"],["バアル"],["の"],["石柱","せきちゅう"],["を"],["彼","かれ"],["は"],["取り除いた","とりのぞいた"],["。"]]},{"verse":3,"text":"しかし彼は、イスラエルに罪を犯させたネバトの子ヤロブアムの罪を自分も犯し続け、それを離れなかった。","tok":[["しかし"],["彼","かれ"],["は"],["、"],["イスラエル"],["に"],["罪","つみ"],["を"],["犯させた","おかさせた"],["ネバト"],["の"],["子","こ"],["ヤロブアム"],["の"],["罪","つみ"],["を"],["自分","じぶん"],["も"],["犯し","おかし"],["続け","つづけ"],["、"],["それ"],["を"],["離れなかった","はなれなかった"],["。"]]},{"verse":4,"text":"モアブの王メシャは羊を飼育しており、十万匹の小羊と雄羊十万匹分の羊毛とを貢ぎ物としてイスラエルの王に納めていた。","tok":[["モアブ"],["の"],["王","おう"],["メシャ"],["は"],["羊","ひつじ"],["を"],["飼育","しいく"],["して"],["おり"],["、"],["十万匹","じゅうまんひき"],["の"],["小羊","こひつじ"],["と"],["雄羊","おひつじ"],["十万匹","じゅうまんひき"],["分","ぶん"],["の"],["羊毛","ようもう"],["と"],["を"],["貢ぎ物","みつぎもの"],["として"],["イスラエル"],["の"],["王","おう"],["に"],["納めて","おさめて"],["いた"],["。"]]},{"verse":5,"text":"しかし、アハブが死ぬと、モアブの王はイスラエルの王に反旗を翻した。","tok":[["しかし"],["、"],["アハブ"],["が"],["死ぬ","しぬ"],["と"],["、"],["モアブ"],["の"],["王","おう"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["反旗","はんき"],["を"],["翻した","ひるがえした"],["。"]]},{"verse":6,"text":"ヨラム王は直ちにサマリアを出て、イスラエルのすべての人々を動員し、","tok":[["ヨラム"],["王","おう"],["は"],["直ちに","ただちに"],["サマリア"],["を"],["出て","でて"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["を"],["動員","どういん"],["し"],["、"]]},{"verse":7,"text":"出発した。また使者をユダの王ヨシャファトに遣わし、「モアブの王がわたしに反旗を翻しました。わたしと共にモアブに行って戦っていただけませんか」と言った。ヨシャファトは、「わたしも攻め上ります。わたしはあなたと一体、わたしの民はあなたの民と一体、わたしの馬はあなたの馬と一体です」と答え、","tok":[["出発","しゅっぱつ"],["した"],["。"],["また"],["使者","ししゃ"],["を"],["ユダ"],["の"],["王","おう"],["ヨシャファト"],["に"],["遣わし","つかわし"],["、"],["「"],["モアブ"],["の"],["王","おう"],["が"],["わたし"],["に"],["反旗","はんき"],["を"],["翻しました","ひるがえしました"],["。"],["わたし"],["と"],["共","とも"],["に"],["モアブ"],["に"],["行って","いって"],["戦って","たたかって"],["いただけません"],["か"],["」"],["と"],["言った","いった"],["。"],["ヨシャファト"],["は"],["、"],["「"],["わたし"],["も"],["攻め上ります","せめのぼります"],["。"],["わたし"],["は"],["あなた"],["と"],["一体","いったい"],["、"],["わたし"],["の"],["民","たみ"],["は"],["あなた"],["の"],["民","たみ"],["と"],["一体","いったい"],["、"],["わたし"],["の"],["馬","うま"],["は"],["あなた"],["の"],["馬","うま"],["と"],["一体","いったい"],["です"],["」"],["と"],["答え","こたえ"],["、"]]},{"verse":8,"text":"「我々はどの道を上ればよいのですか」と尋ねた。ヨラムは、「エドムの荒れ野の道を」と答えた。","tok":[["「"],["我々","われわれ"],["は"],["どの"],["道","みち"],["を"],["上れば","のぼれば"],["よい"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["ヨラム"],["は"],["、"],["「"],["エドム"],["の"],["荒れ野","あれの"],["の"],["道","みち"],["を"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":9,"text":"イスラエルの王は、ユダの王およびエドムの王と共に出発したが、迂回するのに七日を費やし、部隊と連れて来た家畜のための水が底をついてしまった。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["、"],["ユダ"],["の"],["王","おう"],["および"],["エドム"],["の"],["王","おう"],["と"],["共","とも"],["に"],["出発","しゅっぱつ"],["した"],["が"],["、"],["迂回","うかい"],["する"],["のに"],["七","しち"],["日","にち"],["を"],["費やし","ついやし"],["、"],["部隊","ぶたい"],["と"],["連れて","つれて"],["来た","きた"],["家畜","かちく"],["の"],["ため"],["の"],["水","みず"],["が"],["底","そこ"],["を"],["ついて"],["しまった"],["。"]]},{"verse":10,"text":"イスラエルの王は、「ああ、主はこの三人の王をモアブの手に渡すために呼び集められたのか」と言った。","tok":[["イスラエル"],["の"],["王","おう"],["は"],["、"],["「"],["ああ"],["、"],["主","ぬし"],["は"],["この"],["三人","さんにん"],["の"],["王","おう"],["を"],["モアブ"],["の"],["手","て"],["に"],["渡す","わたす"],["ため"],["に"],["呼び集められた","よびあつめられた"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":11,"text":"ヨシャファトが、「ここには我々が主の御旨を尋ねることのできる主の預言者はいないのですか」と尋ねると、イスラエルの王の家臣の一人が、「ここには、エリヤの手に水を注いでいた、シャファトの子エリシャがいます」と答えた。","tok":[["ヨシャファト"],["が"],["、"],["「"],["ここ"],["に"],["は"],["我々","われわれ"],["が"],["主","ぬし"],["の"],["御旨","おむね"],["を"],["尋ねる","たずねる"],["こと"],["の"],["できる"],["主","ぬし"],["の"],["預言者","よげんしゃ"],["は"],["いない"],["の"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["イスラエル"],["の"],["王","おう"],["の"],["家臣","かしん"],["の"],["一人","ひとり"],["が"],["、"],["「"],["ここ"],["に"],["は"],["、"],["エリヤ"],["の"],["手","て"],["に"],["水","みず"],["を"],["注いで","そそいで"],["いた"],["、"],["シャファト"],["の"],["子","こ"],["エリシャ"],["が"],["います"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":12,"text":"ヨシャファトは、「彼には主の言葉があります」と言った。イスラエルの王は、ヨシャファトおよびエドムの王と共に彼のもとに下って行った。","tok":[["ヨシャファト"],["は"],["、"],["「"],["彼","かれ"],["に"],["は"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["あります"],["」"],["と"],["言った","いった"],["。"],["イスラエル"],["の"],["王","おう"],["は"],["、"],["ヨシャファト"],["および"],["エドム"],["の"],["王","おう"],["と"],["共","とも"],["に"],["彼","かれ"],["の"],["もと"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":13,"text":"エリシャはイスラエルの王に言った。「わたしはあなたとどんなかかわりがあるのですか。あなたの父の預言者たちや母の預言者たちのもとに行きなさい。」イスラエルの王は答えた。「いいえ、モアブの手に渡そうとしてこの三人の王を呼び集められたのは主だからです。」","tok":[["エリシャ"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["あなた"],["と"],["どんな"],["かかわり"],["が"],["ある"],["の"],["です"],["か"],["。"],["あなた"],["の"],["父","ちち"],["の"],["預言者","よげんしゃ"],["たち"],["や"],["母","はは"],["の"],["預言者","よげんしゃ"],["たち"],["の"],["もと"],["に"],["行き","いき"],["なさい"],["。"],["」"],["イスラエル"],["の"],["王","おう"],["は"],["答えた","こたえた"],["。"],["「"],["いいえ"],["、"],["モアブ"],["の"],["手","て"],["に"],["渡そう","わたそう"],["として"],["この"],["三人","さんにん"],["の"],["王","おう"],["を"],["呼び集められた","よびあつめられた"],["の"],["は"],["主","ぬし"],["だ"],["から"],["です"],["。"],["」"]]},{"verse":14,"text":"エリシャは言った。「わたしの仕えている万軍の主は生きておられる。わたしは、ユダの王ヨシャファトに敬意を抱いていなければ、あなたには目もくれず、まして会いもしなかった。","tok":[["エリシャ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["の"],["仕えて","つかえて"],["いる"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["わたし"],["は"],["、"],["ユダ"],["の"],["王","おう"],["ヨシャファト"],["に"],["敬意","けいい"],["を"],["抱いて","いだいて"],["いなければ"],["、"],["あなた"],["に"],["は"],["目","め"],["も"],["くれず"],["、"],["まして"],["会い","あい"],["も"],["しなかった"],["。"]]},{"verse":15,"text":"今、楽を奏する者を連れて来なさい。」楽を奏する者が演奏をすると、主の御手がエリシャに臨み、","tok":[["今","いま"],["、"],["楽","らく"],["を"],["奏する","そうする"],["者","もの"],["を"],["連れて","つれて"],["来","き"],["なさい"],["。"],["」"],["楽","らく"],["を"],["奏する","そうする"],["者","もの"],["が"],["演奏","えんそう"],["を"],["する"],["と"],["、"],["主","ぬし"],["の"],["御手","おて"],["が"],["エリシャ"],["に"],["臨み","のぞみ"],["、"]]},{"verse":16,"text":"彼は言った。「主はこう言われる。『この涸れ谷に次々と堀を造りなさい。』","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["この"],["涸れ谷","かれだに"],["に"],["次々","つぎつぎ"],["と"],["堀","ほり"],["を"],["造り","つくり"],["なさい"],["。"],["』"]]},{"verse":17,"text":"主がこう言われるからである。『風もなく、雨もないのに、この涸れ谷に水が溢れ、あなたたちは家畜や荷役の動物と共にそれを飲む。』","tok":[["主","ぬし"],["が"],["こう"],["言われる","いわれる"],["から"],["で"],["ある"],["。"],["『"],["風","かぜ"],["も"],["なく"],["、"],["雨","あめ"],["も"],["ない"],["のに"],["、"],["この"],["涸れ谷","かれだに"],["に"],["水","みず"],["が"],["溢れ","あふれ"],["、"],["あなた"],["たち"],["は"],["家畜","かちく"],["や"],["荷役","にやく"],["の"],["動物","どうぶつ"],["と"],["共","とも"],["に"],["それ"],["を"],["飲む","のむ"],["。"],["』"]]},{"verse":18,"text":"これは主の目には小さいことである。主はモアブをあなたたちの手にお渡しになる。","tok":[["これ"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["は"],["小さい","ちいさい"],["こと"],["で"],["ある"],["。"],["主","ぬし"],["は"],["モアブ"],["を"],["あなた"],["たち"],["の"],["手","て"],["に"],["お渡し","おわたし"],["に"],["なる"],["。"]]},{"verse":19,"text":"あなたたちはすべての砦の町、すべてのえり抜きの町を打ち破り、すべての有用な木を倒し、すべての泉をふさぎ、すべての優れた耕地を石だらけの荒れ地とする。」","tok":[["あなた"],["たち"],["は"],["すべて"],["の"],["砦","とりで"],["の"],["町","まち"],["、"],["すべて"],["の"],["えり抜き","えりぬき"],["の"],["町","まち"],["を"],["打ち破り","うちやぶり"],["、"],["すべて"],["の"],["有用","ゆうよう"],["な"],["木","き"],["を"],["倒し","たおし"],["、"],["すべて"],["の"],["泉","いずみ"],["を"],["ふさぎ"],["、"],["すべて"],["の"],["優れた","すぐれた"],["耕地","こうち"],["を"],["石","いし"],["だらけ"],["の"],["荒れ地","あれち"],["と"],["する"],["。"],["」"]]},{"verse":20,"text":"翌朝、献げ物をささげるころ、見よ、水がエドムの方から流れ込んで、その地は水でいっぱいになった。","tok":[["翌朝","よくあさ"],["、"],["献げ物","ささげもの"],["を"],["ささげる"],["ころ"],["、"],["見よ","みよ"],["、"],["水","みず"],["が"],["エドム"],["の"],["方","ほう"],["から"],["流れ込んで","ながれこ
[{"verse":1,"text":"イスラエルの王、ヨアハズの子ヨアシュの治世第二年に、ユダの王ヨアシュの子アマツヤが王となった。","tok":[["イスラエル"],["の"],["王","おう"],["、"],["ヨアハズ"],["の"],["子","こ"],["ヨアシュ"],["の"],["治世","ちせい"],["第","だい"],["二","に"],["年","ねん"],["に"],["、"],["ユダ"],["の"],["王","おう"],["ヨアシュ"],["の"],["子","こ"],["アマツヤ"],["が"],["王","おう"],["と"],["なった"],["。"]]},{"verse":2,"text":"彼は二十五歳で王となり、二十九年間エルサレムで王位にあった。その母は名をヨアダンといい、エルサレムの出身であった。","tok":[["彼","かれ"],["は"],["二十五歳","にじゅうごさい"],["で"],["王","おう"],["と"],["なり"],["、"],["二十九","にじゅうきゅう"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["ヨアダン"],["と"],["いい"],["、"],["エルサレム"],["の"],["出身","しゅっしん"],["で"],["あった"],["。"]]},{"verse":3,"text":"彼は父祖ダビデほどではなかったが、父ヨアシュが行ったように、主の目にかなう正しいことをことごとく行った。","tok":[["彼","かれ"],["は"],["父祖","ふそ"],["ダビデ"],["ほど"],["で"],["は"],["なかった"],["が"],["、"],["父","ちち"],["ヨアシュ"],["が"],["行った","おこなった"],["よう"],["に"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["かなう"],["正しい","ただしい"],["こと"],["を"],["ことごとく"],["行った","いった"],["。"]]},{"verse":4,"text":"ただ聖なる高台は取り除かず、民は依然として聖なる高台でいけにえを屠り、香をたいていた。","tok":[["ただ"],["聖","せい"],["なる"],["高台","たかだい"],["は"],["取り除かず","とりのぞかず"],["、"],["民","みん"],["は"],["依然","いぜん"],["として"],["聖","せい"],["なる"],["高台","たかだい"],["で"],["いけにえ"],["を"],["屠り","ほふり"],["、"],["香","こう"],["を"],["たいて"],["いた"],["。"]]},{"verse":5,"text":"彼は国を掌握すると、父ヨアシュ王を殺害した家臣たちを打ち殺した。","tok":[["彼","かれ"],["は"],["国","くに"],["を"],["掌握","しょうあく"],["する"],["と"],["、"],["父","ちち"],["ヨアシュ"],["王","おう"],["を"],["殺害","さつがい"],["した"],["家臣","かしん"],["たち"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":6,"text":"しかし、モーセの律法の書に記されているところに従い、殺害者の子供たちは殺さなかった。主がこう命じておられるからである。「父は子のゆえに死に定められず、子は父のゆえに死に定められない。人は、それぞれ自分の罪のゆえに死に定められる。」","tok":[["しかし"],["、"],["モーセ"],["の"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["記されて","しるされて"],["いる"],["ところ"],["に"],["従い","したがい"],["、"],["殺害者","さつがいしゃ"],["の"],["子供","こども"],["たち"],["は"],["殺さなかった","ころさなかった"],["。"],["主","ぬし"],["が"],["こう"],["命じて","めいじて"],["おられる"],["から"],["で"],["ある"],["。"],["「"],["父","ちち"],["は"],["子","こ"],["の"],["ゆえ"],["に"],["死に","しに"],["定められず","さだめられず"],["、"],["子","こ"],["は"],["父","ちち"],["の"],["ゆえ"],["に"],["死に","しに"],["定められない","さだめられない"],["。"],["人","ひと"],["は"],["、"],["それぞれ"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死に","しに"],["定められる","さだめられる"],["。"],["」"]]},{"verse":7,"text":"アマツヤは塩の谷で一万人のエドム人を打ち、セラを攻め落とし、その名をヨクテエルと名付けた。こうしてそれは今日に至っている。","tok":[["アマツヤ"],["は"],["塩","しお"],["の"],["谷","たに"],["で"],["一万人","いちまんにん"],["の"],["エドム人","えどむにん"],["を"],["打ち","うち"],["、"],["セラ"],["を"],["攻め落とし","せめおとし"],["、"],["その"],["名","な"],["を"],["ヨクテエル"],["と"],["名付けた","なづけた"],["。"],["こう"],["して"],["それ"],["は"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":8,"text":"次いでアマツヤは、イスラエルの王、イエフの孫でヨアハズの子であるヨアシュに使者を遣わし、「来るがよい、戦いを交えよう」と言わせた。","tok":[["次いで","ついで"],["アマツヤ"],["は"],["、"],["イスラエル"],["の"],["王","おう"],["、"],["イエフ"],["の"],["孫","まご"],["で"],["ヨアハズ"],["の"],["子","こ"],["で"],["ある"],["ヨアシュ"],["に"],["使者","ししゃ"],["を"],["遣わし","つかわし"],["、"],["「"],["来る","くる"],["が"],["よい"],["、"],["戦い","たたかい"],["を"],["交えよう","まじえよう"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":9,"text":"だが、イスラエルの王ヨアシュは、ユダの王アマツヤに次のような返事を送った。「レバノンのあざみがレバノンの杉に、『あなたの娘をわたしの息子の嫁にくれ』と申し込んだが、レバノンの野の獣が通りかかって、あざみを踏み倒してしまった。","tok":[["だ"],["が"],["、"],["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["は"],["、"],["ユダ"],["の"],["王","おう"],["アマツヤ"],["に"],["次","つぎ"],["の"],["よう"],["な"],["返事","へんじ"],["を"],["送った","おくった"],["。"],["「"],["レバノン"],["の"],["あざみ"],["が"],["レバノン"],["の"],["杉","すぎ"],["に"],["、"],["『"],["あなた"],["の"],["娘","むすめ"],["を"],["わたし"],["の"],["息子","むすこ"],["の"],["嫁","よめ"],["に"],["くれ"],["』"],["と"],["申し込んだ","もうしこんだ"],["が"],["、"],["レバノン"],["の"],["野","の"],["の"],["獣","けもの"],["が"],["通りかかって","とおりかかって"],["、"],["あざみ"],["を"],["踏み倒して","ふみたおして"],["しまった"],["。"]]},{"verse":10,"text":"あなたはエドムを打ち破って思い上がっている。その栄誉に満足して家にとどまっているがよい。なぜ挑発して災いを招き、あなただけでなく、ユダも一緒に倒れるようなことをするのか。」","tok":[["あなた"],["は"],["エドム"],["を"],["打ち破って","うちやぶって"],["思い上がって","おもいあがって"],["いる"],["。"],["その"],["栄誉","えいよ"],["に"],["満足","まんぞく"],["して"],["家","いえ"],["に"],["とどまって"],["いる"],["が"],["よい"],["。"],["なぜ"],["挑発","ちょうはつ"],["して"],["災い","わざわい"],["を"],["招き"
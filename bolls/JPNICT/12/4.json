[{"verse":1,"text":"預言者の仲間の妻の一人がエリシャに助けを求めて叫んだ。「あなたの僕であるわたしの夫が死んでしまいました。ご存じのようにあなたの僕は主を畏れ敬う人でした。ところが債権者が来てわたしの子供二人を連れ去り、奴隷にしようとしています。」","tok":[["預言者","よげんしゃ"],["の"],["仲間","なかま"],["の"],["妻","つま"],["の"],["一人","ひとり"],["が"],["エリシャ"],["に"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んだ","さけんだ"],["。"],["「"],["あなた"],["の"],["僕","ぼく"],["で"],["ある"],["わたし"],["の"],["夫","おっと"],["が"],["死んで","しんで"],["しまいました"],["。"],["ご存じ","ごぞんじ"],["の"],["よう"],["に"],["あなた"],["の"],["僕","ぼく"],["は"],["主","ぬし"],["を"],["畏れ","おそれ"],["敬う","うやまう"],["人","ひと"],["でした"],["。"],["ところ"],["が"],["債権者","さいけんしゃ"],["が"],["来て","きて"],["わたし"],["の"],["子供","こども"],["二人","ふたり"],["を"],["連れ去り","つれさり"],["、"],["奴隷","どれい"],["に"],["しよう"],["として"],["います"],["。"],["」"]]},{"verse":2,"text":"エリシャが、「何をしてあげられるだろうか。あなたの家に何があるのか言いなさい」と促すと、彼女は、「油の壺一つのほか、はしための家には何もありません」と答えた。","tok":[["エリシャ"],["が"],["、"],["「"],["何","なん"],["を"],["して"],["あげられるだろう"],["か"],["。"],["あなた"],["の"],["家","いえ"],["に"],["何","なん"],["が"],["ある"],["の"],["か"],["言い","いい"],["なさい"],["」"],["と"],["促す","うながす"],["と"],["、"],["彼女","かのじょ"],["は"],["、"],["「"],["油","あぶら"],["の"],["壺","つぼ"],["一","ひと"],["つ"],["の"],["ほか"],["、"],["はし"],["ため"],["の"],["家","いえ"],["に"],["は"],["何","なん"],["も"],["ありません"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":3,"text":"彼は言った。「外に行って近所の人々皆から器を借りて来なさい。空の器をできるだけたくさん借りて来なさい。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["外","そと"],["に"],["行って","いって"],["近所","きんじょ"],["の"],["人々","ひとびと"],["皆","みな"],["から"],["器","うつわ"],["を"],["借りて","かりて"],["来","き"],["なさい"],["。"],["空","そら"],["の"],["器","うつわ"],["を"],["できる"],["だけ"],["たくさん"],["借りて","かりて"],["来","き"],["なさい"],["。"]]},{"verse":4,"text":"家に帰ったら、戸を閉めて子供たちと一緒に閉じこもり、その器のすべてに油を注ぎなさい。いっぱいになったものは脇に置くのです。」","tok":[["家","いえ"],["に"],["帰ったら","かえったら"],["、"],["戸","と"],["を"],["閉めて","しめて"],["子供","こども"],["たち"],["と"],["一緒","いっしょ"],["に"],["閉じこもり","とじこもり"],["、"],["その"],["器","うつわ"],["の"],["すべて"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["なさい"],["。"],["いっぱい"],["に"],["なった"],["もの"],["は"],["脇","わき"],["に"],["置く","おく"],["の"],["です"],["。"],["」"]]},{"verse":5,"text":"彼女はエリシャのもとから出て行くと、戸を閉めて子供たちと一緒に閉じこもり、子供たちが器を持って来ると、それに油を注いだ。","tok":[["彼女","かのじょ"],["は"],["エリシャ"],["の"],["もと"],["から"],["出て","でて"],["行く","いく"],["と"],["、"],["戸","と"],["を"],["閉めて","しめて"],["子供","こども"],["たち"],["と"],["一緒","いっしょ"],["に"],["閉じこもり","とじこもり"],["、"],["子供","こども"],["たち"],["が"],["器","うつわ"],["を"],["持って","もって"],["来る","くる"],["と"],["、"],["それ"],["に"],["油","あぶら"],["を"],["注いだ","そそいだ"],["。"]]},{"verse":6,"text":"器がどれもいっぱいになると、彼女は、「もっと器を持っておいで」と子供に言ったが、「器はもうない」と子供が答えた。油は止まった。","tok":[["器","うつわ"],["が"],["どれ"],["も"],["いっぱい"],["に"],["なる"],["と"],["、"],["彼女","かのじょ"],["は"],["、"],["「"],["もっと"],["器","うつわ"],["を"],["持って","もって"],["おいで"],["」"],["と"],["子供","こども"],["に"],["言った","いった"],["が"],["、"],["「"],["器","うつわ"],["は"],["もう"],["ない"],["」"],["と"],["子供","こども"],["が"],["答えた","こたえた"],["。"],["油","あぶら"],["は"],["止まった","とまった"],["。"]]},{"verse":7,"text":"彼女が神の人のもとに行ってそのことを知らせると、彼は言った。「その油を売りに行き、負債を払いなさい。あなたと子供たちはその残りで生活していくことができる。」","tok":[["彼女","かのじょ"],["が"],["神","かみ"],["の"],["人","ひと"],["の"],["もと"],["に"],["行って","いって"],["その"],["こと"],["を"],["知らせる","しらせる"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["その"],["油","あぶら"],["を"],["売り","うり"],["に"],["行き","いき"],["、"],["負債","ふさい"],["を"],["払い","はらい"],["なさい"],["。"],["あなた"],["と"],["子供","こども"],["たち"],["は"],["その"],["残り","のこり"],["で"],["生活","せいかつ"],["して"],["いく"],["こと"],["が"],["できる"],["。"],["」"]]},{"verse":8,"text":"ある日、エリシャはシュネムに行った。そこに一人の裕福な婦人がいて、彼を引き止め、食事を勧めた。以来彼はそこを通るたびに、立ち寄って食事をするようになった。","tok":[["ある"],["日","ひ"],["、"],["エリシャ"],["は"],["シュネム"],["に"],["行った","いった"],["。"],["そこ"],["に"],["一人","ひとり"],["の"],["裕福","ゆうふく"],["な"],["婦人","ふじん"],["が"],["いて"],["、"],["彼","かれ"],["を"],["引き止め","ひきとめ"],["、"],["食事","しょくじ"],["を"],["勧めた","すすめた"],["。"],["以来","いらい"],["彼","かれ"],["は"],["そこ"],["を"],["通る","とおる"],["たび"],["に"],["、"],["立ち寄って","たちよって"],["食事","しょくじ"],["を"],["する"],["よう"],["に"],["なった"],["。"]]},{"verse":9,"text":"彼女は夫に言った。「いつもわたしたちのところにおいでになるあの方は、聖なる神の人であることが分かりました。","tok":[["彼女","かのじょ"],["は"],["夫","おっと"],["に"],["言った","いった"],["。"],["「"],["いつも"],["わたしたち"],["の"],["ところ"],["に"],["おいで"],["に"],["なる"],["あの"],["方","かた"],["は"],["、"],["聖","せい"],["なる"],["神","かみ"],["の"],["人","ひと"],["で"],["ある"],["こと"],["が"],["分かりました","わかりました"],["。"]]},{"verse":10,"text":"あの方のために階上に壁で囲った小さな部屋を造り、寝台と机と椅子と燭台を備えましょう。おいでのときはそこに入っていただけます。」","tok":[["あの"],["方","かた"],["の"],["ため"],["に"],["階上","かいじょう"],["に"],["壁","かべ"],["で"],["囲った","かこった"],["小さな","ちいさな"],["部屋","へや"],["を"],["造り","つくり"],["、"],["寝台","しんだい"],["と"],["机","つくえ"],["と"],["椅子","いす"],["と"],["燭台","しょくだい"],["を"],["備えましょう","そなえましょう"],["。"],["おい"],["で"],["の"],["とき"],["は"],["そこ"],["に"],["入って","はいって"],["いただけます"],["。"],["」"]]},{"verse":11,"text":"ある日、エリシャはそこに来て、その階上の部屋に入って横になり、","tok":[["ある"],["日","ひ"],["、"],["エリシャ"],["は"],["そこ"],["に"],["来て","きて"],["、"],["その"],["階上","かいじょう"],["の"],["部屋","へや"],["に"],["入って","はいって"],["横","よこ"],["に"],["なり"],["、"]]},{"verse":12,"text":"従者ゲハジに、「あのシュネムの婦人を呼びなさい」と命じた。ゲハジが呼ぶと、彼女は彼の前に来て立った。","tok":[["従者","じゅうしゃ"],["ゲハジ"],["に"],["、"],["「"],["あの"],["シュネム"],["の"],["婦人","ふじん"],["を"],["呼び","よび"],["なさい"],["」"],["と"],["命じた","めいじた"],["。"],["ゲハジ"],["が"],["呼ぶ","よぶ"],["と"],["、"],["彼女","かのじょ"],["は"],["彼","かれ"],["の"],["前","まえ"],["に"],["来て","きて"],["立った","たった"],["。"]]},{"verse":13,"text":"エリシャはゲハジに言った。「彼女に伝えなさい。『あなたはわたしたちのためにこのように何事にも心を砕いてくれた。あなたのために何をしてあげればよいのだろうか。王か軍の司令官に話してほしいことが何かあるのか。』」彼女は、「わたしは同族の者に囲まれて何不足なく暮らしています」と答えた。","tok":[["エリシャ"],["は"],["ゲハジ"],["に"],["言った","いった"],["。"],["「"],["彼女","かのじょ"],["に"],["伝え","つたえ"],["なさい"],["。"],["『"],["あなた"],["は"],["わたしたち"],["の"],["ため"],["に"],["この"],["よう"],["に"],["何事","なにごと"],["に"],["も"],["心","こころ"],["を"],["砕いて","くだいて"],["くれた"],["。"],["あなた"],["の"],["ため"],["に"],["何","なん"],["を"],["して"],["あげれば"],["よい"],["の"],["だろう"],["か"],["。"],["王","おう"],["か"],["軍","ぐん"],["の"],["司令官","しれいかん"],["に"],["話して","はなして"],["ほしい"],["こと"],["が"],["何","なん"],["か"],["ある"],["の"],["か"],["。"],["』"],["」"],["彼女","かのじょ"],["は"],["、"],["「"],["わたし"],["は"],["同族","どうぞく"],["の"],["者","もの"],["に"],["囲まれて","かこまれて"],["何","なん"],["不足","ふそく"],["なく"],["暮らして","くらして"],["います"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":14,"text":"エリシャは、「彼女のために何をすればよいのだろうか」と言うので、ゲハジは、「彼女には子供がなく、夫は年を取っています」と答えた。","tok":[["エリシャ"],["は"],["、"],["「"],["彼女","かのじょ"],["の"],["ため"],["に"],["何","なん"],["を"],["すれば"],["よい"],["の"],["だろう"],["か"],["」"],["と"],["言う","いう"],["ので"],["、"],["ゲハジ"],["は"],["、"],["「"],["彼女","かのじょ"],["に"],["は"],["子供","こども"],["が"],["なく"],["、"],["夫","おっと"],["は"],["年","とし"],["を"],["取って","とって"],["います"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":15,"text":"そこでエリシャは彼女を呼ぶように命じた。ゲハジが呼びに行ったので、彼女は来て入り口に立った。","tok":[["そこ"],["で"],["エリシャ"],["は"],["彼女","かのじょ"],["を"],["呼ぶ","よぶ"],["よう"],["に"],["命じた","めいじた"],["。"],["ゲハジ"],["が"],["呼び","よび"],["に"],["行った","いった"],["ので"],["、"],["彼女","かのじょ"],["は"],["来て","きて"],["入り口","いりぐち"],["に"],["立った","たった"],["。"]]},{"verse":16,"text":"エリシャは、「来年の今ごろ、あなたは男の子を抱いている」と告げた。彼女は答えた。「いいえ、わたしの主人、神の人よ、はしためを欺かないでください」と答えた。","tok":[["エリシャ"],["は"],["、"],["「"],["来年","らいねん"],["の"],["今ごろ","いまごろ"],["、"],["あなた"],["は"],["男の子","おとこのこ"],["を"],["抱いて","いだいて"],["いる"],["」"],["と"],["告げた","つげた"],["。"],["彼女","かのじょ"],["は"],["答えた","こたえた"],["。"],["「"],["いいえ"],["、"],["わたし"],["の"],["主人","しゅじん"],["、"],["神","かみ"],["の"],["人","ひと"],["よ"],["、"],["はし"],["ため"],["を"],["欺かないで","あざむかないで"],["ください"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":17,"text":"しかし、この婦人は身ごもり、エリシャが告げたとおり翌年の同じころ、男の子を産んだ。","tok":[["しかし"],["、"],["この"],["婦人","ふじん"],["は"],["身ごもり","みごもり"],["、"],["エリシャ"],["が"],["告げた","つげた"],["とおり"],["翌年","よくねん"],["の"],["同じ","おなじ"],["ころ"],["、"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":18,"text":"その子は大きくなったが、ある日刈り入れをする人々と共にいた父のところに行ったとき、","tok":[["その"],["子","こ"],["は"],["大きく","おおきく"],["なった"],["が"],["、"],["ある"],["日","ひ"],["刈り入れ","かりいれ"],["を"],["する"],["人々","ひとびと"],["と"],["共","とも"],["に"],["いた"],["父","ちち"],["の"],["ところ"],["に"],["行った","いった"],["とき"],["、"]]},{"verse":19,"text":"「頭が、頭が」と言った。父が従者に、「この子を母親のところに抱いて行ってくれ」と言ったので、","tok":[["「"],["頭","あたま"],["が"],["、"],["頭","あたま"],["が"],["」"],["と"],["言った","いった"],["。"],["父","ちち"],["が"],["従者","じゅうしゃ"],["に"],["、"],["「"],["この"],["子","こ"],["を"],["母親","ははおや"],["の"],["ところ"],["に"],["抱いて","いだいて"],["行って","いって"],["くれ"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":20,"text":"従者はその子を母親のところに抱いて行った。その子は母の膝の上でじっとしていたが、昼ごろ死んでしまった。","tok":[["従者","じゅうしゃ"],["は"],["その"],["子","こ"],["を"],["母親","ははおや"],["の"],["ところ"],["に"],["抱いて","いだいて"],["行った","いった"],["。"],["その"],["子","こ"],["は"],["母","はは"],["の"],["膝","ひざ"],["の"],["上","うえ"],["で"],["じっと"],["して"],["いた"],["が"],["、"],["昼ごろ","ひるごろ"],["死んで","しんで"],["しまった"],["。"]]},{"verse":21,"text":"彼女は上って行って神の人の寝台にその子を横たえ、戸を閉めて出て来た。","tok":[["彼女","かのじょ"],["は"],["上って","のぼって"],["行って","いって"],["神","かみ"],["の"],["人","ひと"],["の"],["寝台","しんだい"],["に"],["その"],["子","こ"],["を"],["横たえ","よこたえ"],["、"],["戸","と"],["を"],["閉めて","しめて"],["出て","でて"],["来た","きた"],["。"]]},{"verse":22,"text":"それから夫を呼び、「従者一人と雌ろば一頭をわたしのために出してください。神の人のもとに急いで行って、すぐに戻って来ます」と言った。","tok":[["それ"],["から"],["夫","おっと"],["を"],["呼び","よび"],["、"],["「"],["従者","じゅうしゃ"],["一人","ひとり"],["と"],["雌","めす"],["ろば"],["一頭","いちとう"],["を"],["わたし"],["の"],["ため"],["に"],["出して","だして"],["ください"],["。"],["神","かみ"],["の"],["人","ひと"],["の"],["もと"],["に"],["急いで","いそいで"],["行って","いって"],["、"],["すぐ"],["に"],["戻って","もどって"],["来ます","きます"],["」"],["と"],["言った","いった"],["。"]]},{"verse":23,"text":"夫は、「どうして、今日その人のもとに行くのか。新月でも安息日でもないのに」と言ったが、「行って参ります」と彼女は言い、","tok":[["夫","おっと"],["は"],["、"],["「"],["どう"],["して"],["、"],["今日","きょう"],["その"],["人","ひと"],["の"],["もと"],["に"],["行く","いく"],["の"],["か"],["。"],["新月","しんげつ"],["で"],["も"],["安息日","あんそくび"],["で"],["も"],["ない"],["のに"],["」"],["と"],["言った","いった"],["が"],["、"],["「"],["行って","いって"],["参ります","まいります"],["」"],["と"],["彼女","かのじょ"],["は"],["言い","いい"],["、"]]},{"verse":24,"text":"雌ろばに鞍を置き、従者に、「手綱を引いて進んで行きなさい。わたしが命じないかぎり進むのをやめてはいけません」と命じた。","tok":[["雌","めす"],["ろば"],["に"],["鞍","くら"],["を"],["置き","おき"],["、"],["従者","じゅうしゃ"],["に"],["、"],["「"],["手綱","たづな"],["を"],["引いて","ひいて"],["進んで","すすんで"],["行き","いき"],["なさい"],["。"],["わたし"],["が"],["命じない","めいじない"],["かぎり"],["進む","すすむ"],["の"],["を"],["やめて"],["は"],["いけません"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":25,"text":"こうして彼女は出かけ、カルメル山にいる神の人のもとに来た。神の人は遠くから彼女を見て、従者ゲハジに言った。「見よ、あのシュネムの婦人だ。","tok":[["こう"],["して"],["彼女","かのじょ"],["は"],["出かけ","でかけ"],["、"],["カルメル"],["山","さん"],["に"],["いる"],["神","かみ"],["の"],["人","ひと"],["の"],["もと"],["に"],["来た","きた"],["。"],["神","かみ"],["の"],["人","ひと"],["は"],["遠く","とおく"],["から"],["彼女","かのじょ"],["を"],["見て","みて"],["、"],["従者","じゅうしゃ"],["ゲハジ"],["に"],["言った","いった"],["。"],["「"],["見よ","みよ"],["、"],["あの"],["シュネム"],["の"],["婦人","ふじん"],["だ"],["。"]]},{"verse":26,"text":"すぐに走って行って彼女を迎え、『お変わりありませんか、御主人はお変わりありませんか。お子さんはお変わりありませんか』と挨拶しなさい。」彼女は、「変わりはございません」と答えたが、","tok":[["すぐ"],["に"],["走って","はしって"],["行って","いって"],["彼女","かのじょ"],["を"],["迎え","むかえ"],["、"],["『"],["お変わり","おかわり"],["ありません"],["か"],["、"],["御主人","ごしゅじん"],["は"],["お変わり","おかわり"],["ありません"],["か"],["。"],["お子さん","おこさん"],["は"],["お変わり","おかわり"],["ありません"],["か"],["』"],["と"],["挨拶","あいさつ"],["し"],["なさい"],["。"],["」"],["彼女","かのじょ"],["は"],["、"],["「"],["変わり","かわり"],["は"],["ございません"],["」"],["と"],["答えた","こたえた"],["が"],["、"]]},{"verse":27,"text":"山の上にいる神の人のもとに来て、その足にすがりついた。ゲハジは近寄って引き離そうとしたが、神の人は言った。「そのままにしておきなさい。彼女はひどく苦しんでいる。主はそれをわたしに隠して知らされなかったのだ。」","tok":[["山","やま"],["の"],["上","うえ"],["に"],["いる"],["神","かみ"],["の"],["人","ひと"],["の"],["もと"],["に"],["来て","きて"],["、"],["その"],["足","あし"],["に"],["すがりついた"],["。"],["ゲハジ"],["は"],["近寄って","ちかよって"],["引き離そう","ひきはなそう"],["と"],["した"],["が"],["、"],["神","かみ"],["の"],["人","ひと"],["は"],["言った","いった"],["。"],["「"],["そのまま"],["に"],["して"],["おき"],["なさい"],["。"],["彼女","かのじょ"],["は"],["ひどく"],["苦しんで","くるしんで"],["いる"],["。"],["主","ぬし"],["は"],["それ"],["を"],["わたし"],["に"],["隠して","かくして"],["知らされなかった","しらされなかった"],["の"],["だ"],["。"],["」"]]},{"verse":28,"text":"すると彼女は言った。「わたしがあなたに子供を求めたことがありましょうか。わたしを欺かないでくださいと申し上げたではありませんか。」","tok":[["する"],["と"],["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["が"],["あなた"],["に"],["子供","こども"],["を"],["求めた","もとめた"],["こと"],["が"],["ありましょう"],["か"],["。"],["わたし"],["を"],["欺かないで","あざむかないで"],["ください"],["と"],["申し上げた","もうしあげた"],["で"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":29,"text":"そこでエリシャはゲハジに命じた。「腰に帯を締め、わたしの杖を手に持って行きなさい。だれかに会っても挨拶してはならない。まただれかが挨拶しても答えてはならない。お前はわたしの杖をその子供の顔の上に置きなさい。」","tok":
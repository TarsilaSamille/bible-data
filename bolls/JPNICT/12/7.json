[{"verse":1,"text":"エリシャは言った。「主の言葉を聞きなさい。主はこう言われる。『明日の今ごろ、サマリアの城門で上等の小麦粉一セアが一シェケル、大麦二セアが一シェケルで売られる。』」","tok":[["エリシャ"],["は"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞き","きき"],["なさい"],["。"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["明日","あす"],["の"],["今ごろ","いまごろ"],["、"],["サマリア"],["の"],["城門","じょうもん"],["で"],["上等","じょうとう"],["の"],["小麦粉","こむぎこ"],["一","いち"],["セア"],["が"],["一","いち"],["シェケル"],["、"],["大麦","おおむぎ"],["二","に"],["セア"],["が"],["一","いち"],["シェケル"],["で"],["売られる","うられる"],["。"],["』"],["」"]]},{"verse":2,"text":"王の介添えをしていた侍従は神の人に答えた。「主が天に窓を造られたとしても、そんなことはなかろう。」エリシャは言った。「あなたは自分の目でそれを見る。だが、それを食べることはない。」","tok":[["王","おう"],["の"],["介添え","かいぞえ"],["を"],["して"],["いた"],["侍従","じじゅう"],["は"],["神","かみ"],["の"],["人","ひと"],["に"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["が"],["天","てん"],["に"],["窓","まど"],["を"],["造られた","つくられた"],["として"],["も"],["、"],["そんな"],["こと"],["は"],["なかろう"],["。"],["」"],["エリシャ"],["は"],["言った","いった"],["。"],["「"],["あなた"],["は"],["自分","じぶん"],["の"],["目","め"],["で"],["それ"],["を"],["見る","みる"],["。"],["だ"],["が"],["、"],["それ"],["を"],["食べる","たべる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":3,"text":"城門の入り口に重い皮膚病を患う者が四人いて、互いに言い合った。「どうしてわたしたちは死ぬまでここに座っていられようか。","tok":[["城門","じょうもん"],["の"],["入り口","いりぐち"],["に"],["重い","おもい"],["皮膚病","ひふびょう"],["を"],["患う","わずらう"],["者","もの"],["が"],["四人","よんにん"],["いて"],["、"],["互い","たがい"],["に"],["言い合った","いいあった"],["。"],["「"],["どう"],["して"],["わたしたち"],["は"],["死ぬ","しぬ"],["まで"],["ここ"],["に"],["座って","すわって"],["いられよう"],["か"],["。"]]},{"verse":4,"text":"町に入ろうと言ってみたところで、町は飢饉に見舞われていて、わたしたちはそこで死ぬだけだし、ここに座っていても死ぬだけだ。そうならアラムの陣営に投降しよう。もし彼らが生かしてくれるなら、わたしたちは生き延びることができる。もしわたしたちを殺すなら、死ぬまでのことだ。」","tok":[["町","まち"],["に"],["入ろう","はいろう"],["と"],["言って","いって"],["みた"],["ところ"],["で"],["、"],["町","まち"],["は"],["飢饉","ききん"],["に"],["見舞われて","みまわれて"],["いて"],["、"],["わたしたち"],["は"],["そこ"],["で"],["死ぬ","しぬ"],["だけ"],["だ"],["し"],["、"],["ここ"],["に"],["座って","すわって"],["いて"],["も"],["死ぬ","しぬ"],["だけ"],["だ"],["。"],["そう"],["なら"],["アラム"],["の"],["陣営","じんえい"],["に"],["投降","とうこう"],["しよう"],["。"],["もし"],["彼","かれ"],["ら"],["が"],["生かして","いかして"],["くれるなら"],["、"],["わたしたち"],["は"],["生き延びる","いきのびる"],["こと"],["が"],["できる"],["。"],["もし"],["わたしたち"],["を"],["殺すなら","ころすなら"],["、"],["死ぬ","しぬ"],["まで"],["の"],["こと"],["だ"],["。"],["」"]]},{"verse":5,"text":"夕暮れに、彼らはアラムの陣営に行こうと立ち上がったが、アラムの陣営の外れまで来たところ、そこにはだれもいなかった。","tok":[["夕暮れ","ゆうぐれ"],["に"],["、"],["彼","かれ"],["ら"],["は"],["アラム"],["の"],["陣営","じんえい"],["に"],["行こう","いこう"],["と"],["立ち上がった","たちあがった"],["が"],["、"],["アラム"],["の"],["陣営","じんえい"],["の"],["外れ","はずれ"],["まで"],["来た","きた"],["ところ"],["、"],["そこ"],["に"],["は"],["だれ"],["も"],["いなかった"],["。"]]},{"verse":6,"text":"主が戦車の音や軍馬の音や大軍の音をアラムの陣営に響き渡らせられたため、彼らは、「見よ、イスラエルの王が我々を攻めるためにヘト人の諸王やエジプトの諸王を買収したのだ」と言い合い、","tok":[["主","ぬし"],["が"],["戦車","せんしゃ"],["の"],["音","おと"],["や"],["軍馬","ぐんば"],["の"],["音","おと"],["や"],["大軍","たいぐん"],["の"],["音","おと"],["を"],["アラム"],["の"],["陣営","じんえい"],["に"],["響き","ひびき"],["渡らせられた","わたらせられた"],["ため"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["見よ","みよ"],["、"],["イスラエル"],["の"],["王","おう"],["が"],["我々","われわれ"],["を"],["攻める","せめる"],["ため"],["に"],["ヘト人","へとにん"],["の"],["諸王","しょおう"],["や"],["エジプト"],["の"],["諸王","しょおう"],["を"],["買収","ばいしゅう"],["した"],["の"],["だ"],["」"],["と"],["言い合い","いいあい"],["、"]]},{"verse":7,"text":"夕暮れに立って逃げ去った。彼らは天幕も馬もろばも捨て、陣営をそのままにして、命を惜しんで逃げ去った。","tok":[["夕暮れ","ゆうぐれ"],["に"],["立って","たって"],["逃げ去った","にげさった"],["。"],["彼","かれ"],["ら"],["は"],["天幕","てんまく"],["も"],["馬","うま"],["も"],["ろば"],["も"],["捨て","すて"],["、"],["陣営","じんえい"],["を"],["そのまま"],["に"],["して"],["、"],["命","いのち"],["を"],["惜しんで","おしんで"],["逃げ去った","にげさった"],["。"]]},{"verse":8,"text":"重い皮膚病を患っている者たちは陣営の外れまで来て、一つの天幕に入り、飲み食いした後、銀、金、衣服を運び出して隠した。彼らはまた戻って来て他の天幕に入り、そこからも運び出して隠した。","tok":[["重い","おもい"],["皮膚病","ひふびょう"],["を"],["患って","わずらって"],["いる"],["者","もの"],["たち"],["は"],["陣営","じんえい"],["の"],["外れ","はずれ"],["まで"],["来て","きて"],["、"],["一","ひと"],["つ"],["の"],["天幕","てんまく"],["に"],["入り","はいり"],["、"],["飲み食い","のみくい"],["した"],["後","あと"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["衣服","いふく"],["を"],["運び出して","はこびだして"],["隠した","かくした"],["。"],["彼","かれ"],["ら"],["は"],["また"],["戻って","もどって"],["来て","きて"],["他","ほか"],["の"],["天幕","てんまく"],["に"],["入り","はいり"],["、"],["そこ"],["から"],["も"],["運び出して","はこびだして"],["隠した","かくした"],["。"]]},{"verse":9,"text":"彼らは互いに言い合った。「わたしたちはこのようなことをしていてはならない。この日は良い知らせの日だ。わたしたちが黙って朝日が昇るまで待っているなら、罰を受けるだろう。さあ行って、王家の人々に知らせよう。」","tok":[["彼","かれ"],["ら"],["は"],["互い","たがい"],["に"],["言い合った","いいあった"],["。"],["「"],["わたしたち"],["は"],["この"],["よう"],["な"],["こと"],["を"],["して"],["いて"],["は"],["ならない"],["。"],["この"],["日","ひ"],["は"],["良い","よい"],["知らせ","しらせ"],["の"],["日","ひ"],["だ"],["。"],["わたしたち"],["が"],["黙って","だまって"],["朝日","あさひ"],["が"],["昇る","のぼる"],["まで"],["待って","まって"],["いるなら"],["、"],["罰","ばつ"],["を"],["受けるだろう","うけるだろう"],["。"],["さあ"],["行って","いって"],["、"],["王家","おうけ"],["の"],["人々","ひとびと"],["に"],["知らせよう","しらせよう"],["。"],["」"]]},{"verse":10,"text":"彼らは行って町の門衛を呼び、こう伝えた。「わたしたちはアラムの陣営に行って来ましたが、そこにはだれもいませんでした。そこには人の声もなく、ただ馬やろばがつながれたままで、天幕もそのままでした。」","tok":[["彼","かれ"],["ら"],["は"],["行って","いって"],["町","まち"],["の"],["門衛","もんえい"],["を"],["呼び","よび"],["、"],["こう"],["伝えた","つたえた"],["。"],["「"],["わたしたち"],["は"],["アラム"],["の"],["陣営","じんえい"],["に"],["行って","いって"],["来ました","きました"],["が"],["、"],["そこ"],["に"],["は"],["だれ"],["も"],["いませんでした"],["。"],["そこ"],["に"],["は"],["人","ひと"],["の"],["声","こえ"],["も"],["なく"],["、"],["ただ"],["馬","うま"],["や"],["ろば"],["が"],["つながれた"],["まま"],["で"],["、"],["天幕","てんまく"],["も"],["そのまま"],["でした"],["。"],["」"]]},{"verse":11,"text":"門衛たちは叫んで、この知らせを中の王家の人々に知らせた。","tok":[["門衛","もんえい"],["たち"],["は"],["叫んで","さけんで"],["、"],["この"],["知らせ","しらせ"],["を"],["中","なか"],["の"],["王家","おうけ"],["の"],["人々","ひとびと"],["に"],["知らせた","しらせた"],["。"]]},{"verse":12,"text":"夜中に王は起きて家臣たちに言った。「アラム軍が我々に対して計っていることを教えよう。我々が飢えているのを知って、彼らは陣営を出て野に隠れ、『イスラエル人が町から出て来たら、彼らを生け捕りにし、町に攻め入ろう』と思っているのだ。」","tok":[["夜中","よなか"],["に"],["王","おう"],["は"],["起きて","おきて"],["家臣","かしん"],["たち"],["に"],["言った","いった"],["。"],["「"],["アラム"],["軍","ぐん"],["が"],["我々","われわれ"],["に対して","にたいして"],["計って","はかって"],["いる"],["こと"],["を"],["教えよう","おしえよう"],["。"],["我々","われわれ"],["が"],["飢えて","うえて"],["いる"],["の"],["を"],["知って","しって"],["、"],["彼","かれ"],["ら"],["は"],["陣営","じんえい"],[
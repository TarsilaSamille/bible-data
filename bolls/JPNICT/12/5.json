[{"verse":1,"text":"アラムの王の軍司令官ナアマンは、主君に重んじられ、気に入られていた。主がかつて彼を用いてアラムに勝利を与えられたからである。この人は勇士であったが、重い皮膚病を患っていた。","tok":[["アラム"],["の"],["王","おう"],["の"],["軍","ぐん"],["司令官","しれいかん"],["ナアマン"],["は"],["、"],["主君","しゅくん"],["に"],["重んじられ","おもんじられ"],["、"],["気","き"],["に"],["入られて","いられて"],["いた"],["。"],["主","ぬし"],["が"],["かつて"],["彼","かれ"],["を"],["用いて","もちいて"],["アラム"],["に"],["勝利","しょうり"],["を"],["与えられた","あたえられた"],["から"],["で"],["ある"],["。"],["この"],["人","ひと"],["は"],["勇士","ゆうし"],["で"],["あった"],["が"],["、"],["重い","おもい"],["皮膚病","ひふびょう"],["を"],["患って","わずらって"],["いた"],["。"]]},{"verse":2,"text":"アラム人がかつて部隊を編成して出動したとき、彼らはイスラエルの地から一人の少女を捕虜として連れて来て、ナアマンの妻の召し使いにしていた。","tok":[["アラム人","あらむにん"],["が"],["かつて"],["部隊","ぶたい"],["を"],["編成","へんせい"],["して"],["出動","しゅつどう"],["した"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["地","ち"],["から"],["一人","ひとり"],["の"],["少女","しょうじょ"],["を"],["捕虜","ほりょ"],["として"],["連れて","つれて"],["来て","きて"],["、"],["ナアマン"],["の"],["妻","つま"],["の"],["召し使い","めしつかい"],["に"],["して"],["いた"],["。"]]},{"verse":3,"text":"少女は女主人に言った。「御主人様がサマリアの預言者のところにおいでになれば、その重い皮膚病をいやしてもらえるでしょうに。」","tok":[["少女","しょうじょ"],["は"],["女","じょ"],["主人","しゅじん"],["に"],["言った","いった"],["。"],["「"],["御主人様","みうしさま"],["が"],["サマリア"],["の"],["預言者","よげんしゃ"],["の"],["ところ"],["に"],["おいで"],["に"],["なれば"],["、"],["その"],["重い","おもい"],["皮膚病","ひふびょう"],["を"],["いやして"],["もらえるでしょう"],["に"],["。"],["」"]]},{"verse":4,"text":"ナアマンが主君のもとに行き、「イスラエルの地から来た娘がこのようなことを言っています」と伝えると、","tok":[["ナアマン"],["が"],["主君","しゅくん"],["の"],["もと"],["に"],["行き","いき"],["、"],["「"],["イスラエル"],["の"],["地","ち"],["から"],["来た","きた"],["娘","むすめ"],["が"],["この"],["よう"],["な"],["こと"],["を"],["言って","いって"],["います"],["」"],["と"],["伝える","つたえる"],["と"],["、"]]},{"verse":5,"text":"アラムの王は言った。「行くがよい。わたしもイスラエルの王に手紙を送ろう。」こうしてナアマンは銀十キカル、金六千シェケル、着替えの服十着を携えて出かけた。","tok":[["アラム"],["の"],["王","おう"],["は"],["言った","いった"],["。"],["「"],["行く","いく"],["が"],["よい"],["。"],["わたし"],["も"],["イスラエル"],["の"],["王","おう"],["に"],["手紙","てがみ"],["を"],["送ろう","おくろう"],["。"],["」"],["こう"],["して"],["ナアマン"],["は"],["銀","ぎん"],["十","じゅう"],["キカル"],["、"],["金六","きんろく"],["千","せん"],["シェケル"],["、"],["着替え","きがえ"],["の"],["服","ふく"],["十","じゅう"],["着","ちゃく"],["を"],["携えて","たずさえて"],["出かけた","でかけた"],["。"]]},{"verse":6,"text":"彼はイスラエルの王に手紙を持って行った。そこには、こうしたためられていた。「今、この手紙をお届けするとともに、家臣ナアマンを送り、あなたに託します。彼の重い皮膚病をいやしてくださいますように。」","tok":[["彼","かれ"],["は"],["イスラエル"],["の"],["王","おう"],["に"],["手紙","てがみ"],["を"],["持って","もって"],["行った","いった"],["。"],["そこ"],["に"],["は"],["、"],["こう"],["したためられて"],["いた"],["。"],["「"],["今","いま"],["、"],["この"],["手紙","てがみ"],["を"],["お届け","おとどけ"],["する"],["と"],["とも"],["に"],["、"],["家臣","かしん"],["ナアマン"],["を"],["送り","おくり"],["、"],["あなた"],["に"],["託します","たくします"],["。"],["彼","かれ"],["の"],["重い","おもい"],["皮膚病","ひふびょう"],["を"],["いやして"],["くださいます"],["よう"],["に"],["。"],["」"]]},{"verse":7,"text":"イスラエルの王はこの手紙を読むと、衣を裂いて言った。「わたしが人を殺したり生かしたりする神だとでも言うのか。この人は皮膚病の男を送りつけていやせと言う。よく考えてみよ。彼はわたしに言いがかりをつけようとしているのだ。」","tok":[["イスラエル"],["の"],["王","おう"],["は"],["この"],["手紙","てがみ"],["を"],["読む","よむ"],["と"],["、"],["衣","ころも"],["を"],["裂いて","さいて"],["言った","いった"],["。"],["「"],["わたし"],["が"],["人","ひと"],["を"],["殺し","ころし"],["たり"],["生かし","いかし"],["たり"],["する"],["神","かみ"],["だ"],["と"],["で"],["も"],["言う","いう"],["の"],["か"],["。"],["この"],["人","ひと"],["は"],["皮膚病","ひふびょう"],["の"],["男","おとこ"],["を"],["送りつけて","おくりつけて"],["いやせ"],["と"],["言う","ゆう"],["。"],["よく"],["考えて","かんがえて"],["み"],["よ"],["。"],["彼","かれ"],["は"],["わたし"],["に"],["言いがかり","いいがかり"],["を"],["つけよう"],["として"],["いる"],["の"],["だ"],["。"],["」"]]},{"verse":8,"text":"神の人エリシャはイスラエルの王が衣を裂いたことを聞き、王のもとに人を遣わして言った。「なぜあなたは衣を裂いたりしたのですか。その男をわたしのところによこしてください。彼はイスラエルに預言者がいることを知るでしょう。」","tok":[["神","かみ"],["の"],["人","ひと"],["エリシャ"],["は"],["イスラエル"],["の"],["王","おう"],["が"],["衣","ころも"],["を"],["裂いた","さいた"],["こと"],["を"],["聞き","きき"],["、"],["王","おう"],["の"],["もと"],["に"],["人","ひと"],["を"],["遣わして","つかわして"],["言った","いった"],["。"],["「"],["なぜ"],["あなた"],["は"],["衣","ころも"],["を"],["裂い","さい"],["たり"],["した"],["の"],["です"],["か"],["。"],["その"],["男","おとこ"],["を"],["わたし"],["の"],["ところ"],["に"],["よこして"],["ください"],["。"],["彼","かれ"],["は"],["イスラエル"],["に"],["預言者","よげんしゃ"],["が"],["いる"],["こと"],["を"],["知るでしょう","しるでしょう"],["。"],["」"]]},{"verse":9,"text":"ナアマンは数頭の馬と共に戦車に乗ってエリシャの家に来て、その入り口に立った。","tok":[["ナアマン"],["は"],["数頭","すうとう"],["の"],["馬","うま"],["と"],["共","とも"],["に"],["戦車","せんしゃ"],["に"],["乗って","のって"],["エリシャ"],["の"],["家","いえ"],["に"],["来て","きて"],["、"],["その"],["入り口","いりぐち"],["に"],["立った","たった"],["。"]]},{"verse":10,"text":"エリシャは使いの者をやってこう言わせた。「ヨルダン川に行って七度身を洗いなさい。そうすれば、あなたの体は元に戻り、清くなります。」","tok":[["エリシャ"],["は"],["使い","つかい"],["の"],["者","もの"],["を"],["やって"],["こう"],["言わせた","いわせた"],["。"],["「"],["ヨルダン"],["川","かわ"],["に"],["行って","いって"],["七","なな"],["度","ど"],["身","み"],["を"],["洗い","あらい"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["の"],["体","からだ"],["は"],["元","もと"],["に"],["戻り","もどり"],["、"],["清く","きよく"],["なります"],["。"],["」"]]},{"verse":11,"text":"ナアマンは怒ってそこを去り、こう言った。「彼が自ら出て来て、わたしの前に立ち、彼の神、主の名を呼び、患部の上で手を動かし、皮膚病をいやしてくれるものと思っていた。","tok":[["ナアマン"],["は"],["怒って","おこって"],["そこ"],["を"],["去り","さり"],["、"],["こう"],["言った","いった"],["。"],["「"],["彼","かれ"],["が"],["自ら","みずから"],["出て","でて"],["来て","きて"],["、"],["わたし"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["彼","かれ"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["名","な"],["を"],["呼び","よび"],["、"],["患部","かんぶ"],["の"],["上","うえ"],["で"],["手","て"],["を"],["動かし","うごかし"],["、"],["皮膚病","ひふびょう"],["を"],["いやして"],["くれる"],["もの"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":12,"text":"イスラエルのどの流れの水よりもダマスコの川アバナやパルパルの方が良いではないか。これらの川で洗って清くなれないというのか。」彼は身を翻して、憤慨しながら去って行った。","tok":[["イスラエル"],["の"],["どの"],["流れ","ながれ"],["の"],["水","みず"],["より"],["も"],["ダマスコ"],["の"],["川","かわ"],["アバナ"],["や"],["パルパル"],["の"],["方","ほう"],["が"],["良いで","よいで"],["は"],["ない"],["か"],["。"],["これ"],["ら"],["の"],["川","かわ"],["で"],["洗って","あらって"],["清く","きよく"],["なれない"],["と"],["いう"],["の"],["か"],["。"],["」"],["彼","かれ"],["は"],["身","み"],["を"],["翻して","ひるがえして"],["、"],["憤慨","ふんがい"],["し"],["ながら"],["去って","さって"],["行った","いった"],["。"]]},{"verse":13,"text":"しかし、彼の家来たちが近づいて来ていさめた。「わが父よ、あの預言者が大変なことをあなたに命じたとしても、あなたはそのとおりなさったにちがいありません。あの預言者は、『身を洗え、そうすれば清くなる』と言っただけではありませんか。」","tok":[["しかし"],["、"],["彼","かれ"],["の"],["家来","けらい"],["たち"],["が"],["近づいて","ちかづいて"],["来て","きて"],["いさめた"],["。"],["「"],["わが"],["父","ちち"],["よ"],["、"],["あの"],["預言者","よげんしゃ"],["が"],["大変","たいへん"],["な"],["こと"],["を"],["あなた"],["に"],["命じた","めいじた"],["として"],["も"],["、"],["あなた"],["は"],["その"],["とおり"],["なさった"],["に"],["ちがい"],["ありません"],["。"],["あの"],["預言者","よげんしゃ"],["は"],["、"],["『"],["身","み"],["を"],["洗え","あらえ"],["、"],["そう"],["すれば"],["清く","きよく"],["なる"],["』"],["と"],["言った","いった"],["だけ"],["で"],["は"],["ありません"],["か"],["。"],["」"]]},{"verse":14,"text":"ナアマンは神の人の言葉どおりに下って行って、ヨルダンに七度身を浸した。彼の体は元に戻り、小さい子供の体のようになり、清くなった。","tok":[["ナアマン"],["は"],["神","かみ"],["の"],["人","ひと"],["の"],["言葉","ことば"],["どおり"],["に"],["下って","くだって"],["行って","いって"],["、"],["ヨルダン"],["に"],["七","しち"],["度","ど"],["身","み"],["を"],["浸した","ひたした"],["。"],["彼","かれ"],["の"],["体","からだ"],["は"],["元","もと"],["に"],["戻り","もどり"],["、"],["小さい","ちいさい"],["子供","こども"],["の"],["体","からだ"],["の"],["よう"],["に"],["なり"],["、"],["清く","きよく"],["なった"],["。"]]},{"verse":15,"text":"彼は随員全員を連れて神の人のところに引き返し、その前に来て立った。「イスラエルのほか、この世界のどこにも神はおられないことが分かりました。今この僕からの贈り物をお受け取りください。」","tok":[["彼","かれ"],["は"],["随員","ずいいん"],["全員","ぜんいん"],["を"],["連れて","つれて"],["神","かみ"],["の"],["人","ひと"],["の"],["ところ"],["に"],["引き返し","ひきかえし"],["、"],["その"],["前","まえ"],["に"],["来て","きて"],["立った","たった"],["。"],["「"],["イスラエル"],["の"],["ほか"],["、"],["この"],["世界","せかい"],["の"],["どこ"],["に"],["も"],["神","かみ"],["は"],["おられない"],["こと"],["が"],["分かりました","わかりました"],["。"],["今","いま"],["この"],["僕","ぼく"],["から"],["の"],["贈り物","おくりもの"],["を"],["お受け取り","おうけとり"],["ください"],["。"],["」"]]},{"verse":16,"text":"神の人は、「わたしの仕えている主は生きておられる。わたしは受け取らない」と辞退した。ナアマンは彼に強いて受け取らせようとしたが、彼は断った。","tok":[["神","かみ"],["の"],["人","ひと"],["は"],["、"],["「"],["わたし"],["の"],["仕えて","つかえて"],["いる"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["わたし"],["は"],["受け取らない","うけとらない"],["」"],["と"],["辞退","じたい"],["した"],["。"],["ナアマン"],["は"],["彼","かれ"],["に"],["強いて","つよいて"],["受け取らせよう","うけとらせよう"],["と"],["した"],["が"],["、"],["彼","かれ"],["は"],["断った","ことわった"],["。"]]},{"verse":17,"text":"ナアマンは言った。「それなら、らば二頭に負わせることができるほどの土をこの僕にください。僕は今後、主以外の他の神々に焼き尽くす献げ物やその他のいけにえをささげることはしません。","tok":[["ナアマン"],["は"],["言った","いった"],["。"],["「"],["それ"],["なら"],["、"],["らば"],["二頭","にとう"],["に"],["負わせる","おわせる"],["こと"],["が"],["できる"],["ほど"],["の"],["土","つち"],["を"],["この"],["僕","ぼく"],["に"],["ください"],["。"],["僕","ぼく"],["は"],["今後","こんご"],["、"],["主","ぬし"],["以外","いがい"],["の"],["他","ほか"],["の"],["神々","かみがみ"],["に"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["や"],["その"],["他","た"],["の"],["いけにえ"],["を"],["ささげる"],["こと"],["は"],["しません"],["。"]]},{"verse":18,"text":"ただし、この事については主が僕を赦してくださいますように。わたしの主君がリモンの神殿に行ってひれ伏すとき、わたしは介添えをさせられます。そのとき、わたしもリモンの神殿でひれ伏さねばなりません。わたしがリモンの神殿でひれ伏すとき、主がその事についてこの僕を赦してくださいますように。」","tok":[["ただし"],["、"],["この"],["事","こと"],["について"],["は"],["主","ぬし"],["が"],["僕","ぼく"],["を"],["赦して","ゆるして"],["くださいます"],["よう"],["に"],["。"],["わたし"],["の"],["主君","しゅくん"],["が"],["リモン"],["の"],["神殿","しんでん"],["に"],["行って","いって"],["ひれ伏す","ひれふす"],["とき"],["、"],["わたし"],["は"],["介添え","かいぞえ"],["を"],["させられます"],["。"],["その"],["とき"],["、"],["わたし"],["も"],["リモン"],["の"],["神殿","しんでん"],["で"],["ひれ伏さねば","ひれふさねば"],["なりません"],["。"],["わたし"],["が"],["リモン"],["の"],["神殿","しんでん"],["で"],["ひれ伏す","ひれふす"],["とき"],["、"],["主","ぬし"],["が"],["その"],["事","こと"],["について"],["この"],["僕","ぼく"],["を"],["赦して","ゆるして"],["くださいます"],["よう"],["に"],["。"],["」"]]},{"verse":19,"text":"エリシャは彼に、「安心して行きなさい」と言った。ナアマンがエリシャと別れて、少し行ったとき、","tok":[["エリシャ"],["は"],["彼","かれ"],["に"],["、"],["「"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["」"],["と"],["言った","いった"],["。"],["ナアマン"],["が"],["エリシャ"],["と"],["別れて","わかれて"],["、"],["少し","すこし"],["行った","いった"],["とき"],["、"]]},{"verse":20,"text":"神の人エリシャの従者ゲハジは、「わたしの主人は、あのアラム人ナアマンが持って来たものを何も受け取らずに帰してしまった。主は生きておられる。彼を追いかけて何かもらってこよう」と言って、","tok":[["神","かみ"],["の"],["人","ひと"],["エリシャ"],["の"],["従者","じゅうしゃ"],["ゲハジ"],["は"],["、"],["「"],["わたし"],["の"],["主人","しゅじん"],["は"],["、"],["あの"],["アラム人","あらむにん"],["ナアマン"],["が"],["持って","もって"],["来た","きた"],["もの"],["を"],["何","なん"],["も"],["受け取らず","うけとらず"],["に"],["帰して","かえして"],["しまった"],["。"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["彼","かれ"],["を"],["追いかけて","おいかけて"],["何","なん"],["か"],["もらって"],["こよう"],["」"],["と"],["言って","いって"],["、"]]},{"verse":21,"text":"ナアマンの後を追った。ナアマンは彼が後を追って来るのを見て、戦車から飛び降り、彼を迎え、「どうかなさいましたか」と尋ねた。","tok":[["ナアマン"],["の"],["後","あと"],["を"],["追った","おった"],["。"],["ナアマン"],["は"],["彼","かれ"],["が"],["後","あと"],["を"],["追って","おって"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["戦車","せんしゃ"],["から"],["飛び降り","とびおり"],["、"],["彼","かれ"],["を"],["迎え","むかえ"],["、"],["「"],["どう"],["か"],["なさいました"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":22,"text":"彼は答えた。「何でもありません。わたしの主人がわたしを遣わしてこう言いました。『今し方預言者の仲間の若い者が二人エフライムの山地から着いた。彼らに銀一キカルと着替えの服二着を与えてほしい。』」","tok":[["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["何","なん"],["で"],["も"],["ありません"],["。"],["わたし"],["の"],["主人","しゅじん"],["が"],["わたし"],["を"],["遣わして","つかわして"],["こう"],["言いました","いいました"],["。"],["『"],["今し方","いましがた"],["預言者","よげんしゃ"],["の"],["仲間","なかま"],["の"],["若い","わかい"],["者","もの"],["が"],["二人","ふたり"],["エフライム"],["の"],["山地","さんち"],["から"],["着いた","ついた"],["。"],["彼","かれ"],["ら"],["に"],["銀","ぎん"],["一","いち"],["キカル"],["と"],["着替え","きがえ"],["の"],["服","ふく"],["二","に"],["着","ちゃく"],["を"],["与えて","あたえて"],["ほしい"],["。"],["』"],["」"]]},{"verse":23,"text":"ナアマンは、「どうぞ、二キカル取ってください」と言ってしきりに勧め、二つの袋に銀二キカルを詰め、着替えの服二着を添えて、自分の従者二人に渡した。彼らはそれを持ち、ゲハジの先に立って進んだ。","tok":[["ナアマン"],["は"],["、"],["「"],["どうぞ"],["、"],["二","に"],["キカル"],["取って","とって"],["ください"],["」"],["と"],["言って","いって"],["しきり"],["に"],["勧め","すすめ"],["、"],["二","ふた"],["つ"],["の"],["袋","ふくろ"],["に"],["銀","ぎん"],["二","に"],["キカル"],["を"],["詰め","つめ"],["、"],["着替え","きがえ"],["の"],["服","ふく"],["二","に"],["着","ちゃく"],["を"],["添えて","そえて"],["、"],["自分","じぶん"],["の"],["従者","じゅうしゃ"],["二人","ふたり"],["に"],["渡した","わたした"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["持ち","もち"],["、"],["ゲハジ"],["の"],["先","さき"],["に"],["立って","たって"],["進んだ","すすんだ"],["。"]]},{"verse":24,"text":"オフェルに着いたとき、ゲハジは彼らからそれらを受け取って家にしまい込み、彼らを帰した。彼らは去って行った。","tok":[["オフェル"],["に"],["着いた","ついた"],["とき"],["、"],["ゲハジ"],["は"],["彼","かれ"],["ら"],["から"],["それ"],["ら"],["を"],["受け取って","うけとって"],["家","いえ"],["に"],["しまい込み","しまいこみ"],["、"],["彼","かれ"],["ら"],["を"],["帰した","かえした"],["。"],["彼","かれ"],["ら"],["は"],["去って","さって"],["行った","いった"],["。"]]},{"verse":25,"text":"彼が主人のところに来て立つと、エリシャは、「ゲハジ、お前はどこに行っていたのか」と言った。ゲハジは、「僕はどこにも行っていません」と答えたが、","tok":[["彼","かれ"],["が"],["主人","しゅじん"],["の"],["ところ"],["に"],["来て","きて"],["立つ","たつ"],["と"],["、"],["エリシャ"],["は"],["、"],["「"],["ゲハジ"],["、"],["お前","おまえ"],["は"],["どこ"],["に"],["行って","いって"],["いた"],["の"],["か"],["」"],["と"],["言った","いった"],["。"],["ゲハジ"],["は"],["、"],["「"],["僕","ぼく"],["は"],["どこ"],["に"],["も"],["行って","いって"],["いません"],["」"],["と"],["答えた","こたえた"],["が"],["、"]]},{"verse":26,"text":"エリシャは言った。「あの人が戦車から降りて引き返し、お前を迎えたとき、わたしの心がそこに行っていなかったとでも言うのか。今は銀を受け、衣服、オリーブの木やぶどう畑、羊や牛、男女の奴隷を受け取る時であろうか。","tok":[["エリシャ"],["は"],["言った","いった"],["。"],["「"],["あの"],["人","ひと"],["が"],["戦車","せんしゃ"],["から"],["降りて","おりて"],["引き返し","ひきかえし"],["、"],["お前","おまえ"],["を"],["迎えた","むかえた"],["とき"],["、"],["わたし"],["の"],["心","こころ"],["が"],["そこ"],["に"],["行って","いって"],["いなかった"],["と"],["で"],["も"],["言う","いう"],["の"],["か"],["。"],["今","いま"],["は"],["銀","ぎん"],["を"],["受け","うけ"],["、"],["衣服","いふく"],["、"],["オリーブ"],["の"],["木","き"],["や"],["ぶどう"],["畑","はたけ"],["、"],["羊","ひつじ"],["や"],["牛","うし"],["、"],["男女","だんじょ"],["の"],["奴隷","どれい"],["を"],["受け取る","うけとる"],["時","とき"],["で"],["あろう"],["か"],["。"]]},{"verse":27,"text":"ナアマンの重い皮膚病がお前とお前の子孫にいつまでもまといつくことになるのに。」ゲハジは重い皮膚病で雪のようになり、エリシャの前から立ち去った。","tok":[["ナアマン"],["の"],["重い","おもい"],["皮膚病","ひふびょう"],["が"],["お前","おまえ"],["と"],["お前","おまえ"],["の"],["子孫","しそん"],["に"],["いつ"],["まで"],["も"],["まといつく"],["こと"],["に"],["なる"],["のに"],["。"],["」"],["ゲハジ"],["は"],["重い","おもい"],["皮膚病","ひふびょう"],["で"],["雪","ゆき"],["の"],["よう"],["に"],["なり"],["、"],["エリシャ"],["の"],["前","まえ"],["から"],["立ち去った","たちさった"],["。"]]}]
[{"verse":1,"text":"マナセは十二歳で王となり、五十五年間エルサレムで王位にあった。その母は名をヘフツィ‧バと言った。","tok":[["マナセ"],["は"],["十二歳","じゅうにさい"],["で"],["王","おう"],["と"],["なり"],["、"],["五十五","ごじゅうご"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["ヘフツィ"],["‧"],["バ"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"彼は主がイスラエルの人々の前から追い払われた諸国の民の忌むべき慣習に倣い、主の目に悪とされることを行った。","tok":[["彼","かれ"],["は"],["主","ぬし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["から"],["追い払われた","おいはらわれた"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["忌むべき","いむべき"],["慣習","かんしゅう"],["に"],["倣い","ならい"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":3,"text":"彼は父ヒゼキヤが廃した聖なる高台を再建し、イスラエルの王アハブが行ったようにバアルの祭壇を築き、アシェラ像を造った。更に彼は天の万象の前にひれ伏し、これに仕えた。","tok":[["彼","かれ"],["は"],["父","ちち"],["ヒゼキヤ"],["が"],["廃した","はいした"],["聖","せい"],["なる"],["高台","たかだい"],["を"],["再建","さいけん"],["し"],["、"],["イスラエル"],["の"],["王","おう"],["アハブ"],["が"],["行った","おこなった"],["よう"],["に"],["バアル"],["の"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["アシェラ"],["像","ぞう"],["を"],["造った","つくった"],["。"],["更に","さらに"],["彼","かれ"],["は"],["天","てん"],["の"],["万象","ばんしょう"],["の"],["前","まえ"],["に"],["ひれ伏し","ひれふし"],["、"],["これ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":4,"text":"主はかつて、「エルサレムにわたしの名を置く」と言われたが、その主の神殿の中に彼は異教の祭壇を築いた。","tok":[["主","ぬし"],["は"],["かつて"],["、"],["「"],["エルサレム"],["に"],["わたし"],["の"],["名","な"],["を"],["置く","おく"],["」"],["と"],["言われた","いわれた"],["が"],["、"],["その"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["中","なか"],["に"],["彼","かれ"],["は"],["異教","いきょう"],["の"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]},{"verse":5,"text":"彼はまた、主の神殿の二つの庭に天の万象のための祭壇を築いた。","tok":[["彼","かれ"],["は"],["また"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["二","ふた"],["つ"],["の"],["庭","にわ"],["に"],["天","てん"],["の"],["万象","ばんしょう"],["の"],["ため"],["の"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]},{"verse":6,"text":"彼は自分の子に火の中を通らせ、占いやまじないを行い、口寄せや霊媒を用いるなど、主の目に悪とされることを数々行って主の怒りを招いた。","tok":[["彼","かれ"],["は"],["自分","じぶん"],["の"],["子","こ"],["に"],["火","ひ"],["の"],["中","なか"],["を"],["通らせ","とおらせ"],["、"],["占い","うらない"],["や"],["まじない"],["を"],["行い","おこない"],["、"],["口寄せ","くちよせ"],["や"],["霊媒","れいばい"],["を"],["用いる","もちいる"],["など"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["数々","かずかず"],["行って","いって"],["主","ぬし"],["の"],["怒り","いかり"],["を"],["招いた","まねいた"],["。"]]},{"verse":7,"text":"彼はまたアシェラの彫像を造り、神殿に置いた。主はその神殿について、かつてダビデとその子ソロモンにこう仰せになった。「わたしはこの神殿に、イスラエルの全部族の中から選んだエルサレムに、とこしえにわたしの名を置く。","tok":[["彼","かれ"],["は"],["また"],["アシェラ"],["の"],["彫像","ちょうぞう"],["を"],["造り","つくり"],["、"],["神殿","しんでん"],["に"],["置いた","おいた"],["。"],["主","ぬし"],["は"],["その"],["神殿","しんでん"],["について"],["、"],["かつて"],["ダビデ"],["と"],["その"],["子","こ"],["ソロモン"],["に"],["こう"],["仰せ","おおせ"],["に"],["なった"],["。"],["「"],["わたし"],["は"],["この"],["神殿","しんでん"],["に"],["、"],["イスラエル"],["の"],["全部族","ぜんぶぞく"],["の"],["中","なか"],["から"],["選んだ","えらんだ"],["エルサレム"],["に"],["、"],["とこしえ"],["に"],["わたし"],["の"],["名","な"],["を"],["置く","おく"],["。"]]},{"verse":8,"text":"もし彼らがわたしの命じるすべてのこと、すなわちわが僕モーセが彼らに授けたすべての律法を行うよう努めるなら、わたしはイスラエルをその先祖に与えた土地から二度と迷い出させない。」","tok":[["もし"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["命じる","めいじる"],["すべて"],["の"],["こと"],["、"],["すなわち"],["わが"],["僕","ぼく"],["モーセ"],["が"],["彼","かれ"],["ら"],["に"],["授けた","さずけた"],["すべて"],["の"],["律法","りっぽう"],["を"],["行う","おこなう"],["よう"],["努めるなら","つとめるなら"],["、"],["わたし"],["は"],["イスラエル"],["を"],["その"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["土地","とち"],["から"],["二","に"],["度","ど"],["と"],["迷い出させない","まよいでさせない"],["。"],["」"]]},{"verse":9,"text":"しかし彼らはこれに聞き従わず、マナセに惑わされて、主がイスラエルの人々の前で滅ぼされた諸国の民よりも更に悪い事を行った。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["これ"],["に"],["聞き従わず","ききしたがわず"],["、"],["マナセ"],["に"],["惑わされて","まどわされて"],["、"],["主","ぬし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["滅ぼされた","ほろぼされた"],["諸国","しょこく"],["の"],["民","たみ"],["より"],["も"],["更に","さらに"],["悪い","わるい"],["事","こと"],["を"],["行った","おこなった"],["。"]]},{"verse":10,"text":"主はその僕である預言者たちを通してこう告げられた。","tok":[["主","ぬし"],["は"],["その"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["こう"],["告げられた","つげられた"],["。"]]},{"verse":11,"text":"「ユダの王マナセはこれらの忌むべき事を行い、かつてアモリ人の行ったすべての事より、更に悪い事を行い、その偶像によってユダにまで罪を犯させた。","tok":[["「"],["ユダ"],["の"],["王","おう"],["マナセ"],["は"],["これ"],["ら"],["の"],["忌むべき","いむべき"],["事","こと"],["を"],["行い","おこない"],["、"],["かつて"],["アモリ人","あもりにん"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["より"],["、"],["更に","さらに"],["悪い","わるい"],["事","こと"],["を"],["行い","おこない"],["、"],["その"],["偶像","ぐうぞう"],["によって"],["ユダ"],["に"],["まで"],["罪","つみ"],["を"],["犯させた","おかさせた"],["。"]]},{"verse":12,"text":"それゆえ、イスラエルの神、主はこう言われる。見よ、わたしはエルサレムとユダに災いをもたらす。これを聞く者は皆、両方の耳が鳴る。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["エルサレム"],["と"],["ユダ"],["に"],["災い","わざわい"],["を"],["もたらす"],["。"],["これ"],["を"],["聞く","きく"],["者","もの"],["は"],["皆","みな"],["、"],["両方","りょうほう"],["の"],["耳","みみ"],["が"],["鳴る","なる"],["。"]]},{"verse":13,"text":"わたしはサマリアに使った測り縄とアハブの家に使った下げ振りをエルサレムに用いる。鉢をぬぐい、それをぬぐって伏せるように、わたしはエルサレムをぬぐい去る。","tok":[["わたし"],["は"],["サマリア"],["に"],["使った","つかった"],["測り","はかり"],["縄","なわ"],["と"],["アハブ"],["の"],["家","いえ"],["に"],["使った","つかった"],["下げ振り","さげふり"],["を"],["エルサレム"],["に"],["用いる","もちいる"],["。"],["鉢","ばち"],["を"],["ぬぐい"],["、"],["それ"],["を"],["ぬぐって"],["伏せる","ふせる"],["よう"],["に"],["、"],["わたし"],["は"],["エルサレム"],["を"],["ぬぐい去る","ぬぐいさる"],["。"]]},{"verse":14,"text":"わたしはわが嗣業の残りの者を見捨て、敵の手に渡す。彼らはそのすべての敵の餌食となり、略奪の的となる。","tok":[["わたし"],["は"],["わが"],["嗣業","しぎょう"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["見捨て","みすて"],["、"],["敵","てき"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["彼","かれ"],["ら"],["は"],["その"],["すべて"],["の"],["敵","てき"],["の"],["餌食","えじき"],["と"],["なり"],["、"],["略奪","りゃくだつ"],["の"],["的","まと"],["と"],["なる"],["。"]]},{"verse":15,"text":"彼らは先祖がエジプトを出た日から今日に至るまでわたしの意に背くことを行い、わたしを怒らせてきたからである。」","tok":[["彼","かれ"],["ら"],["は"],["先祖","せんぞ"],["が"],["エジプト"],["を"],["出た","でた"],["日","ひ"],["から"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["わたし"],["の"],["意","い"],["に"],["背く","そむく"],["こと"],["を"],["行い","おこない"],["、"],["わたし"],["を"],["怒らせて","おこらせて"],["きた"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":16,"text":"マナセは主の目に悪とされることをユダに行わせて、罪を犯させた。彼はその罪を犯したばかりでなく、罪のない者の血を非常に多く流し、その血でエルサレムを端から端まで満たした。","tok":[["マナセ"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["ユダ"],["に"],["行わせて","おこなわせて"],["、"],["罪","つみ"],["を"],["犯させた","おかさせた"],["。"],["彼","かれ"],["は"],["その"],["罪","つみ"],["を"],["犯した","おかした"],["ばかり"],["で"],["なく"],["、"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["非常","ひじょう"],["に"],["多く","おおく"],["流し","ながし"],["、"],["その"],["血","ち"],["で"],["エルサレム"],["を"],["端","はし"],["から"],["端","はし"],["まで"],["満たした","みたした"],["。"]]},{"verse":17,"text":"マナセの他の事績、彼の行ったすべての事、彼の犯した罪は、『ユダの王の歴代誌』に記されている。","tok":[["マナセ"],["の"],["他","ほか"],["の"],["事績","じせき"],["、"],["彼","かれ"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["、"],["彼","かれ"],["の"],["犯した","おかした"],["罪","つみ"],["は"],["、"],["『"],["ユダ"],["の"],["王","おう"],["の"],["歴代誌","れきだいし"],["』"],["に"],["記されて","しるされて"],["いる"],["。"]]},{"verse":18,"text":"マナセは先祖と共に眠りにつき、自分の宮殿の庭園、すなわちウザの庭園に葬られた。その子アモンがマナセに代わって王となった。","tok":[["マナセ"],["は"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠り","ねむり"],["に"],["つき"],["、"],["自分","じぶん"],["の"],["宮殿","きゅうでん"],["の"],["庭園","ていえん"],["、"],["すなわち"],["ウザ"],["の"],["庭園","ていえん"],["に"],["葬られた","ほうむられた"],["。"],["その"],["子","こ"],["アモン"],["が"],["マナセ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":19,"text":"アモンは二十二歳で王となり、二年間エルサレムで王位にあった。その母は名をメシュレメトといい、ヨトバ出身のハルツの娘であった。","tok":[["アモン"],["は"],["二十二歳","にじゅうにさい"],["で"],["王","おう"],["と"],["なり"],["、"],["二","に"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["メシュレメト"],["と"],["いい"],["、"],["ヨトバ"],["出身","しゅっしん"],["の"],["ハルツ"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":20,"text":"彼は父マナセが行ったように、主の目に悪とされることを行った。","tok":[["彼","かれ"],["は"],["父","ちち"],["マナセ"],["が"],["行った","おこなった"],["よう"],["に"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":21,"text":"父の歩んだ道をそのまま歩み、父が仕えた偶像に彼も仕え、その前
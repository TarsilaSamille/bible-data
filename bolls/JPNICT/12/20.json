[{"verse":1,"text":"そのころ、ヒゼキヤは死の病にかかった。預言者、アモツの子イザヤが訪ねて来て、「主はこう言われる。『あなたは死ぬことになっていて、命はないのだから、家族に遺言をしなさい』」と言った。","tok":[["その"],["ころ"],["、"],["ヒゼキヤ"],["は"],["死","し"],["の"],["病","やまい"],["に"],["かかった"],["。"],["預言者","よげんしゃ"],["、"],["アモツ"],["の"],["子","こ"],["イザヤ"],["が"],["訪ねて","たずねて"],["来て","きて"],["、"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["あなた"],["は"],["死ぬ","しぬ"],["こと"],["に"],["なって"],["いて"],["、"],["命","いのち"],["は"],["ない"],["の"],["だ"],["から"],["、"],["家族","かぞく"],["に"],["遺言","ゆいごん"],["を"],["し"],["なさい"],["』"],["」"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"ヒゼキヤは顔を壁に向けて、主にこう祈った。","tok":[["ヒゼキヤ"],["は"],["顔","かお"],["を"],["壁","かべ"],["に"],["向けて","むけて"],["、"],["主に","おもに"],["こう"],["祈った","いのった"],["。"]]},{"verse":3,"text":"「ああ、主よ、わたしがまことを尽くし、ひたむきな心をもって御前を歩み、御目にかなう善いことを行ってきたことを思い起こしてください。」こう言って、ヒゼキヤは涙を流して大いに泣いた。","tok":[["「"],["ああ"],["、"],["主","ぬし"],["よ"],["、"],["わたし"],["が"],["まこと"],["を"],["尽くし","つくし"],["、"],["ひたむき"],["な"],["心","こころ"],["を"],["もって"],["御前","ごぜん"],["を"],["歩み","あゆみ"],["、"],["御目","おめ"],["に"],["かなう"],["善い","よい"],["こと"],["を"],["行って","おこなって"],["きた"],["こと"],["を"],["思い起こして","おもいおこして"],["ください"],["。"],["」"],["こう"],["言って","いって"],["、"],["ヒゼキヤ"],["は"],["涙","なみだ"],["を"],["流して","ながして"],["大いに","おおいに"],["泣いた","ないた"],["。"]]},{"verse":4,"text":"イザヤが中庭を出ないうちに、主の言葉が彼に臨んだ。","tok":[["イザヤ"],["が"],["中庭","なかにわ"],["を"],["出ない","でない"],["うち"],["に"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["彼","かれ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":5,"text":"「わが民の君主ヒゼキヤのもとに戻って言いなさい。『あなたの父祖ダビデの神、主はこう言われる。わたしはあなたの祈りを聞き、涙を見た。見よ、わたしはあなたをいやし、三日目にあなたは主の神殿に上れるだろう。","tok":[["「"],["わが"],["民","たみ"],["の"],["君主","くんしゅ"],["ヒゼキヤ"],["の"],["もと"],["に"],["戻って","もどって"],["言い","いい"],["なさい"],["。"],["『"],["あなた"],["の"],["父祖","ふそ"],["ダビデ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["あなた"],["の"],["祈り","いのり"],["を"],["聞き","きき"],["、"],["涙","なみだ"],["を"],["見た","みた"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["いやし"],["、"],["三日目","みっかめ"],["に"],["あなた"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["上れるだろう","のぼれるだろう"],["。"]]},{"verse":6,"text":"わたしはあなたの寿命を十五年延ばし、アッシリアの王の手からあなたとこの都を救い出す。わたしはわたし自身のために、わが僕ダビデのために、この都を守り抜く。』」","tok":[["わたし"],["は"],["あなた"],["の"],["寿命","じゅみょう"],["を"],["十五","じゅうご"],["年","ねん"],["延ばし","のばし"],["、"],["アッシリア"],["の"],["王","おう"],["の"],["手","て"],["から"],["あなた"],["と"],["この"],["都","と"],["を"],["救い出す","すくいだす"],["。"],["わたし"],["は"],["わたし"],["自身","じしん"],["の"],["ため"],["に"],["、"],["わが"],["僕","ぼく"],["ダビデ"],["の"],["ため"],["に"],["、"],["この"],["都","と"],["を"],["守り","まもり"],["抜く","ぬく"],["。"],["』"],["」"]]},{"verse":7,"text":"イザヤが、「干しいちじくを取って来るように」と言うので、人々がそれを取って来て患部に当てると、ヒゼキヤは回復した。","tok":[["イザヤ"],["が"],["、"],["「"],["干し","ほし"],["いちじく"],["を"],["取って","とって"],["来る","くる"],["よう"],["に"],["」"],["と"],["言う","いう"],["ので"],["、"],["人々","ひとびと"],["が"],["それ"],["を"],["取って","とって"],["来て","きて"],["患部","かんぶ"],["に"],["当てる","あてる"],["と"],["、"],["ヒゼキヤ"],["は"],["回復","かいふく"],["した"],["。"]]},{"verse":8,"text":"ヒゼキヤはイザヤに言った。「主がわたしをいやされ、わたしが三日目に主の神殿に上れることを示すしるしは何でしょうか。」","tok":[["ヒゼキヤ"],["は"],["イザヤ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["わたし"],["を"],["いやされ"],["、"],["わたし"],["が"],["三日目","みっかめ"],["に"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["上れる","のぼれる"],["こと"],["を"],["示す","しめす"],["しるし"],["は"],["何","なん"],["でしょう"],["か"],["。"],["」"]]},{"verse":9,"text":"イザヤは答えた。「ここに主によって与えられるしるしがあります。それによって主は約束なさったことを実現されることが分かります。影が十度進むか、十度戻るかです。」","tok":[["イザヤ"],["は"],["答えた","こたえた"],["。"],["「"],["ここ"],["に"],["主","ぬし"],["によって"],["与えられる","あたえられる"],["しるし"],["が"],["あります"],["。"],["それ"],["によって"],["主","ぬし"],["は"],["約束","やくそく"],["なさった"],["こと"],["を"],["実現","じつげん"],["される"],["こと"],["が"],["分かります","わかります"],["。"],["影","かげ"],["が"],["十","じゅう"],["度","ど"],["進む","すすむ"],["か"],["、"],["十","じゅう"],["度","ど"],["戻る","もどる"],["か"],["です"],["。"],["」"]]},{"verse":10,"text":"ヒゼキヤは答えた。「影が十度伸びるのは容易なことです。むしろ影を十度後戻りさせてください。」","tok":[["ヒゼキヤ"],["は"],["答えた","こたえた"],["。"],["「"],["影","かげ"],["が"],["十","じゅう"],["度","ど"],["伸びる","のびる"],["の"],["は"],["容易","ようい"],["な"],["こと"],["です"],["。"],["むしろ"],["影","かげ"],["を"],["十","じゅう"],["度","ど"],["後戻り","あともどり"],["させて"],["ください"],["。"],["」"]]},{"verse":11,"text":"そこで預言者イザヤが主に祈ると、主は日時計の影、アハズの日時計に落ちた影を十度後戻りさせられた。","tok":[["そこ"],["で"],["預言者","よげんしゃ"],["イザヤ"],["が"],["主に","おもに"],["祈る","いのる"],["と"],["、"],["主","ぬし"],["は"],["日時計","ひどけい"],["の"],["影","かげ"],["、"],["アハズ"],["の"],["日時計","ひどけい"],["に"],["落ちた","おちた"],["影","かげ"],["を"],["十","じゅう"],["度","ど"],["後戻り","あともどり"],["させられた"],["。"]]},{"verse":12,"text":"そのころ、バビロンの王、バルアダンの子メロダク‧バルアダンは、ヒゼキヤが病気であるということを聞いて、ヒゼキヤに手紙と贈り物を送って来た。","tok":[["その"],["ころ"],["、"],["バビロン"],["の"],["王","おう"],["、"],["バルアダン"],["の"],["子","こ"],["メロダク"],["‧"],["バルアダン"],["は"],["、"],["ヒゼキヤ"],["が"],["病気","びょうき"],["で"],["ある"],["と"],["いう"],["こと"],["を"],["聞いて","きいて"],["、"],["ヒゼキヤ"],["に"],["手紙","てがみ"],["と"],["贈り物","おくりもの"],["を"],["送って","おくって"],["来た","きた"],["。"]]},{"verse":13,"text":"ヒゼキヤは使者たちを歓迎し、銀、金、香料、上等の油など宝物庫のすべて、武器庫、また、倉庫にある一切のものを彼らに見せた。ヒゼキヤが彼らに見せなかったものは、宮中はもとより国中に一つもなかった。","tok":[["ヒゼキヤ"],["は"],["使者","ししゃ"],["たち"],["を"],["歓迎","かんげい"],["し"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["香料","こうりょう"],["、"],["上等","じょうとう"],["の"],["油","あぶら"],["など"],["宝物庫","ほうもつこ"],["の"],["すべて"],["、"],["武器庫","ぶきこ"],["、"],["また"],["、"],["倉庫","そうこ"],["に"],["ある"],["一切","いっさい"],["の"],["もの"],["を"],["彼","かれ"],["ら"],["に"],["見せた","みせた"],["。"],["ヒゼキヤ"],["が"],["彼","かれ"],["ら"],["に"],["見せなかった","みせなかった"],["もの"],["は"],["、"],["宮中","きゅうちゅう"],["は"],["もとより"],["国中","くにちゅう"],["に"],["一","ひと"],["つ"],["も"],["なかった"],["。"]]},{"verse":14,"text":"預言者イザヤはヒゼキヤ王のところに来て、「あの人々は何を言ったのですか。どこから訪ねて来たのですか」と問うた。ヒゼキヤは、「彼らは遠い国、バビロンから来ました」と答えた。","tok":[["預言者","よげんしゃ"],["イザヤ"],["は"],["ヒゼキヤ"],["王","おう"],["の"],["ところ"],["に"],["来て","きて"],["、"],["「"],["あの"],["人々","ひとびと"],["は"],["何","なん"],["を"],["言った","いった"],["の"],["です"],["か"],["。"],["どこ"],["から"],["訪ねて","たずねて"],["来た","きた"],["の"],["です"],["か"],["」"],["と"],["問うた","とうた"],["。"],["ヒゼキヤ"],["は"],["、"],["「"],["彼","かれ"],["ら"],["は"],["遠い","とおい"],["国","くに"],["、"],["バビロン"],["から"],["来ました","きました"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":15,"text":"更に、「彼らは王宮で何を見たのですか」と問うと、ヒゼキヤは、「王宮にあるものは何もかも見ました。倉庫の中のものも見せなかったものは何一つありません」と答えた。","tok":[["更に","さらに"],["、"],["「"],["彼","かれ"],["ら"],["は"],["王宮","おうきゅう"],["で"],["何","なん"],["を"],["見た","みた"],["の"],["です"],["か"],["」"],["と"],["問う","とう"],["と"],["、"],["ヒゼキヤ"],["は"],["、"],["「"],["王宮","おうきゅう"],["に"],["ある"],["もの"],["は"],["何","なん"],["も"],["か"],["も"],["見ました","みました"],["。"],["倉庫","そうこ"],["の"],["中","なか"],["の"],["もの"],["も"],["見せなかった","みせなかった"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["ありません"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":16,"text":"そこでイザヤはヒゼキヤに言った。「主の言葉を聞きなさい。","tok":[["そこ"],["で"],["イザヤ"],["は"],["ヒゼキヤ"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞き","きき"],["なさい"],["。"]]},{"verse":17,"text":"『王宮にあるもの、あなたの先祖が今日まで蓄えてきたものが、ことごとくバビロンに運び去られ、何も残らなくなる日が来る、と主は言われる。","tok":[["『"],["王宮","おうきゅう"],["に"],["ある"],["もの"],["、"],["あなた"],["の"],["先祖","せんぞ"],["が"],["今日","きょう"],["まで"],["蓄えて","たくわえて"],["きた"],["もの"],["が"],["、"],["ことごとく"],["バビロン"],["に"],["運び去られ","はこびさられ"],["、"],["何","なん"],["も"],["残らなく","のこらなく"],["なる"],["日","ひ"],["が"],["来る","くる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":18,"text":"あなたから生まれた息子の中には、バビロン王の宮殿に連れて行かれ、宦官にされる者もある。』」","tok":[["あなた"],["から"],["生まれた","うまれた"],["息子","むすこ"],["の"],["中","なか"],["に"],["は"],["、"],["バビロン"],["王","おう"],["の"],["宮殿","きゅうでん"],["に"],["連れて","つれて"],["行かれ","いかれ"],["、"],["宦官","かんがん"],["に"],["される"],["者","もの"],["も"],["ある"],["。"],["』"],["」"]]},{"verse":19,"text":"ヒゼキヤはイザヤに、「あなたの告げる主の言葉はありがたいものです」と答えた。彼は、自分の在世中は平和と安定が続くのではないかと思っていた。","tok":[["ヒゼキヤ"],["は"],["イザヤ"],["に"],["、"],["「"],["あなた"],["の"],["告げる","つげる"],["主","ぬし"],["の"],["言葉","ことば"],["は"],["ありがたい"],["もの"],["です"],["」"],["と"],["答えた","こたえた"],["。"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["の"],["在世中","ざいせちゅう"],["は"],["平和","へいわ"],["と"],["安定","あんてい"],["が"],["続く","つづく"],["ので"],["は"],["ない"],["か"],["と"],["思って","おもって"],["いた"],["。"]]},{"verse":20,"text":"ヒゼキヤの他の事績、彼の功績のすべて、貯水池と水道を造って都に水を引いたことは、『ユダの王の歴代誌』に記されている。","tok":[["ヒゼキヤ"],["の"],["他","ほか"],["の"],["事績","じせき"],["、"],["彼","かれ"],["の"],["功績","こうせき"],["の"],["すべて"],["、"],["貯水池","ちょすいち"],["と"],["水道","すいどう"],["を"],["造って","つくって"],["都","と"],["に"],["水","みず"],["を"],["引いた","ひいた"],["こと"],["は"],["、"],["『"],["ユダ"],["の"],["王","おう"],["の"],["歴代誌","れきだいし"],["』"],["に"],["記されて","しるされて"],["いる"],["。"]]},{"verse":21,"text":"ヒゼキヤは先祖と共に眠りにつき、その子マナセがヒゼキヤに代わって王となった。","tok":[["ヒゼキヤ"],["は"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠り","ねむり"],["に"],["つき"],["、"],["その"],["子","こ"],["マナセ"],["が"],["ヒゼキヤ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]}]
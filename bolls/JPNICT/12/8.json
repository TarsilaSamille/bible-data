[{"verse":1,"text":"エリシャは、かつてその子供を生き返らせてやったことのある婦人に言った。「あなたは家族と共に立ち去り、住める所に移り住みなさい。主が飢饉を呼び起こし、それはこの地にも及んで七年も続くからだ。」","tok":[["エリシャ"],["は"],["、"],["かつて"],["その"],["子供","こども"],["を"],["生き返らせて","いきかえらせて"],["やった"],["こと"],["の"],["ある"],["婦人","ふじん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["家族","かぞく"],["と"],["共","とも"],["に"],["立ち去り","たちさり"],["、"],["住める","すめる"],["所","ところ"],["に"],["移り住み","うつりすみ"],["なさい"],["。"],["主","ぬし"],["が"],["飢饉","ききん"],["を"],["呼び起こし","よびおこし"],["、"],["それ"],["は"],["この"],["地","ち"],["に"],["も"],["及んで","およんで"],["七","なな"],["年","ねん"],["も"],["続く","つづく"],["から"],["だ"],["。"],["」"]]},{"verse":2,"text":"婦人は直ちに神の人の言葉どおりに行動し、家族と共に立ち去り、ペリシテ人の地に七年間住んだ。","tok":[["婦人","ふじん"],["は"],["直ちに","ただちに"],["神","かみ"],["の"],["人","ひと"],["の"],["言葉","ことば"],["どおり"],["に"],["行動","こうどう"],["し"],["、"],["家族","かぞく"],["と"],["共","とも"],["に"],["立ち去り","たちさり"],["、"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["に"],["七","しち"],["年間","ねんかん"],["住んだ","すんだ"],["。"]]},{"verse":3,"text":"七年たってから、その婦人はペリシテ人の地から帰り、王のもとに自分の家と畑の返還を求めて訴え出た。","tok":[["七","なな"],["年","ねん"],["たって"],["から"],["、"],["その"],["婦人","ふじん"],["は"],["ペリシテ"],["人","にん"],["の"],["地","ち"],["から"],["帰り","かえり"],["、"],["王","おう"],["の"],["もと"],["に"],["自分","じぶん"],["の"],["家","いえ"],["と"],["畑","はたけ"],["の"],["返還","へんかん"],["を"],["求めて","もとめて"],["訴え出た","うったえでた"],["。"]]},{"verse":4,"text":"そのとき、王は神の人の従者ゲハジに話しかけ、「エリシャの行った大いなる業をすべて語り聞かせてくれ」と言っていた。","tok":[["その"],["とき"],["、"],["王","おう"],["は"],["神","かみ"],["の"],["人","ひと"],["の"],["従者","じゅうしゃ"],["ゲハジ"],["に"],["話しかけ","はなしかけ"],["、"],["「"],["エリシャ"],["の"],["行った","おこなった"],["大いなる","おおいなる"],["業","ごう"],["を"],["すべて"],["語り聞かせて","かたりきかせて"],["くれ"],["」"],["と"],["言って","いって"],["いた"],["。"]]},{"verse":5,"text":"神の人が死人を生き返らせたことをゲハジが王に語り聞かせていると、ちょうどそのとき、かつて子供を生き返らせてもらった婦人が、自分の家と畑のことで訴えに来たのであった。ゲハジは、「わたしの主君、王よ、これがその婦人です。またこれがその子で、エリシャはこの子を生き返らせたのです」と言った。","tok":[["神","かみ"],["の"],["人","ひと"],["が"],["死人","しにん"],["を"],["生き返らせた","いきかえらせた"],["こと"],["を"],["ゲハジ"],["が"],["王","おう"],["に"],["語り聞かせて","かたりきかせて"],["いる"],["と"],["、"],["ちょうど"],["その"],["とき"],["、"],["かつて"],["子供","こども"],["を"],["生き返らせて","いきかえらせて"],["もらった"],["婦人","ふじん"],["が"],["、"],["自分","じぶん"],["の"],["家","いえ"],["と"],["畑","はたけ"],["の"],["こと"],["で"],["訴え","うったえ"],["に"],["来た","きた"],["ので"],["あった"],["。"],["ゲハジ"],["は"],["、"],["「"],["わたし"],["の"],["主君","しゅくん"],["、"],["王","おう"],["よ"],["、"],["これ"],["が"],["その"],["婦人","ふじん"],["です"],["。"],["また"],["これ"],["が"],["その"],["子","こ"],["で"],["、"],["エリシャ"],["は"],["この"],["子","こ"],["を"],["生き返らせた","いきかえらせた"],["の"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"婦人は王の求めに応じてその事実を語った。そこで王は彼女のために、一人の宦官に次のように命じた。「この婦人の物をすべて返しなさい。またこの地を後にした日から今に至るまでの畑のすべての収穫も返しなさい。」","tok":[["婦人","ふじん"],["は"],["王","おう"],["の"],["求め","もとめ"],["に"],["応じて","おうじて"],["その"],["事実","じじつ"],["を"],["語った","かたった"],["。"],["そこ"],["で"],["王","おう"],["は"],["彼女","かのじょ"],["の"],["ため"],["に"],["、"],["一人","ひとり"],["の"],["宦官","かんがん"],["に"],["次","つぎ"],["の"],["よう"],["に"],["命じた","めいじた"],["。"],["「"],["この"],["婦人","ふじん"],["の"],["物","もの"],["を"],["すべて"],["返し","かえし"],["なさい"],["。"],["また"],["この"],["地","ち"],["を"],["後","あと"],["に"],["した"],["日","ひ"],["から"],["今","いま"],["に"],["至る","いたる"],["まで"],["の"],["畑","はたけ"],["の"],["すべて"],["の"],["収穫","しゅうかく"],["も"],["返し","かえし"],["なさい"],["。"],["」"]]},{"verse":7,"text":"エリシャがダマスコに来たとき、アラムの王ベン‧ハダドは病気であった。「神の人がここに来た」と知らせる者があって、","tok":[["エリシャ"],["が"],["ダマスコ"],["に"],["来た","きた"],["とき"],["、"],["アラム"],["の"],["王","おう"],["ベン"],["‧"],["ハダド"],["は"],["病気","びょうき"],["で"],["あった"],["。"],["「"],["神","かみ"],["の"],["人","ひと"],["が"],["ここ"],["に"],["来た","きた"],["」"],["と"],["知らせる","しらせる"],["者","もの"],["が"],["あって"],["、"]]},{"verse":8,"text":"王はハザエルに言った。「贈り物を持って神の人を迎えに行き、わたしのこの病気が治るかどうか、彼を通して主の御旨を尋ねよ。」","tok":[["王","おう"],["は"],["ハザエル"],["に"],["言った","いった"],["。"],["「"],["贈り物","おくりもの"],["を"],["持って","もって"],["神","かみ"],["の"],["人","ひと"],["を"],["迎え","むかえ"],["に"],["行き","いき"],["、"],["わたし"],["の"],["この"],["病気","びょうき"],["が"],["治る","なおる"],["か"],["どう"],["か"],["、"],["彼","かれ"],["を"],["通して","とおして"],["主","ぬし"],["の"],["御旨","おむね"],["を"],["尋ね","たずね"],["よ"],["。"],["」"]]},{"verse":9,"text":"ハザエルは贈り物としてダマスコのすべての価値あるものをらくだ四十頭に載せて携え、エリシャを迎えに行った。彼はエリシャの前に立って言った。「あなたの子、アラムの王ベン‧ハダドがわたしをあなたに遣わしました。この病気が治るかどうかと言っています。」","tok":[["ハザエル"],["は"],["贈り物","おくりもの"],["として"],["ダマスコ"],["の"],["すべて"],["の"],["価値","かち"],["ある"],["もの"],["を"],["らくだ"],["四十頭","よんじゅうとう"],["に"],["載せて","のせて"],["携え","たずさえ"],["、"],["エリシャ"],["を"],["迎え","むかえ"],["に"],["行った","いった"],["。"],["彼","かれ"],["は"],["エリシャ"],["の"],["前","まえ"],["に"],["立って","たって"],["言った","いった"],["。"],["「"],["あなた"],["の"],["子","こ"],["、"],["アラム"],["の"],["王","おう"],["ベン"],["‧"],["ハダド"],["が"],["わたし"],["を"],["あなた"],["に"],["遣わしました","つかわしました"],["。"],["この"],["病気","びょうき"],["が"],["治る","なおる"],["か"],["どう"],["か"],["と"],["言って","いって"],["います"],["。"],["」"]]},{"verse":10,"text":"エリシャは言った。「行って王に言うがいい。『あなたは必ず治る』と。しかし、主は彼が必ず死ぬことをわたしに示された。」","tok":[["エリシャ"],["は"],["言った","いった"],["。"],["「"],["行って","いって"],["王","おう"],["に"],["言う","ゆう"],["が"],["いい"],["。"],["『"],["あなた"],["は"],["必ず","かならず"],["治る","なおる"],["』"],["と"],["。"],["しかし"],["、"],["主","ぬし"],["は"],["彼","かれ"],["が"],["必ず","かならず"],["死ぬ","しぬ"],["こと"],["を"],["わたし"],["に"],["示された","しめされた"],["。"],["」"]]},{"verse":11,"text":"神の人は、ハザエルが恥じ入るほど、じっと彼を見つめ、そして泣き出したので、","tok":[["神","かみ"],["の"],["人","ひと"],["は"],["、"],["ハザエル"],["が"],["恥じ入る","はじいる"],["ほど"],["、"],["じっと"],["彼","かれ"],["を"],["見つめ","みつめ"],["、"],["そして"],["泣き","なき"],["出した","だした"],["ので"],["、"]]},{"verse":12,"text":"ハザエルは、「どうしてあなたは泣かれるのですか」と尋ねた。エリシャは答えた。「わたしはあなたがイスラエルの人々に災いをもたらすことを知っているからです。あなたはその砦に火を放ち、若者を剣にかけて殺し、幼子を打ちつけ、妊婦を切り裂きます。」","tok":[["ハザエル"],["は"],["、"],["「"],["どう"],["して"],["あなた"],["は"],["泣かれる","なかれる"],["の"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["エリシャ"],["は"],["答えた","こたえた"],["。"],["「"],["わたし"],["は"],["あなた"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["災い","わざわい"],["を"],["もたらす"],["こと"],["を"],["知って","しって"],["いる"],["から"],["です"],["。"],["あなた"],["は"],["その"],["砦","とりで"],["に"],["火","ひ"],["を"],["放ち","はなち"],["、"],["若者","わかもの"],["を"],["剣","けん"],["に"],["かけて"],["殺し","ころし"],["、"],["幼子","おさなご"],["を"],["打ちつけ","うちつけ"],["、"],["妊婦","にんぷ"],["を"],["切り裂きます","きりさきます"],["。"],["」"]]},{"verse":13,"text":"ハザエルは、「この僕、この犬にどうしてそんな大それた事ができましょうか」と言ったが、エリシャは、「主はあなたがアラムの王になることをわたしに示された」と答えた。","tok":[["ハザエル"],["は"],["、"],["「"],["この"],["僕","ぼく"],["、"],["この"],["犬","いぬ"],["に"],["どう"],["して"],["そんな"],["大それた","だいそれた"],["事","こと"],["が"],["できましょう"],["か"],["」"],["と"],["言った","いった"],["が"],["、"],["エリシャ"],["は"],["、"],["「"],["主","ぬし"],["は"],["あなた"],["が"],["アラム"],["の"],["王","おう"],["に"],["なる"],["こと"],["を"],["わたし"],["に"],["示された","しめされた"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":14,"text":"彼はエリシャのもとを離れ、自分の主君のところに帰ると、王は、「エリシャはお前に何と言ったか」と尋ねたので、「必ず治ると彼は言いました」と答えた。","tok":[["彼","かれ"],["は"],["エリシャ"],["の"],["もと"],["を"],["離れ","はなれ"],["、"],["自分","じぶん"],["の"],["主君","しゅくん"],["の"],["ところ"],["に"],["帰る","かえる"],["と"],["、"],["王","おう"],["は"],["、"],["「"],["エリシャ"],["は"],["お前","おまえ"],["に"],["何","なん"],["と"],["言った","いった"],["か"],["」"],["と"],["尋ねた","たずねた"],["ので"],["、"],["「"],["必ず","かならず"],["治る","なおる"],["と"],["彼","かれ"],["は"],["言いました","いいました"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":15,"text":"しかし翌日、彼は布を取って水に浸し、王の顔を覆ったので、王は死んだ。ハザエルが彼に代わって王となった。","tok":[["しかし"],["翌日","よくじつ"],["、"],["彼","かれ"],["は"],["布","ぬの"],["を"],["取って","とって"],["水","みず"],["に"],["浸し","ひたし"],["、"],["王","おう"],["の"],["顔","かお"],["を"],["覆った","おおった"],["ので"],["、"],["王","おう"],["は"],["死んだ","しんだ"],["。"],["ハザエル"],["が"],["彼","かれ"],["に"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":16,"text":"イスラエルの王アハブの子ヨラムの治世第五年に、――ヨシャファトがユダの王であったが――ユダの王ヨシャファトの子ヨラムが王となった。","tok":[["イスラエル"],["の"],["王","おう"],["アハブ"],["の"],["子","こ"],["ヨラム"],["の"],["治世","ちせい"],["第","だい"],["五","ご"],["年","ねん"],["に"],["、"],["―"],["―"],["ヨシャファト"],["が"],["ユダ"],["の"],["王","おう"],["で"],["あった"],["が"],["―"],["―"],["ユダ"],["の"],["王","おう"],["ヨシャファト"],["の"],["子","こ"],["ヨラム"],["が"],["王","おう"],["と"],["なった"],["。"]]},{"verse":17,"text":"彼は三十二歳で王となり、八年間エルサレムで王位にあった。","tok":[["彼","かれ"],["は"],["三十二歳","さんじゅうにさい"],["で"],["王","おう"],["と"],["なり"],["、"],["八","はち"],["年間","ねんかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"]]},{"verse":18,"text":"彼はアハブの娘を妻としていたので、アハブの家が行ったように、イスラエルの王たちの道を歩み、主の目に悪とされることを行った。","tok":[["彼","かれ"],["は"],["アハブ"],["の"],["娘","むすめ"],["を"],["妻","つま"],["として"],["いた"],["ので"],["、"],["アハブ"],["の"],["家","いえ"],["が"],["行った","おこなった"],["よう"],["に"],["、"],["イスラエル"],["の"],["王","おう"],["たち"],["の"],["道","みち"],["を"],["歩み","あゆみ"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["。"]]},{"verse":19,"text":"しかし、主はその僕ダビデのゆえに、ユダを滅ぼそうとはされなかった。主は、ダビデとその子孫に絶えずともし火を与えると約束されたからである。","tok":[["しかし"],["、"],["主","ぬし"],["は"],["その"],["僕","ぼく"],["ダビデ"],["の"],["ゆえ"],["に"],["、"],["ユダ"],["を"],["滅ぼそう","ほろぼそう"],["と"],["は"],["されなかった"],["。"],["主","ぬし"],["は"],["、"],["ダビデ"],["と"],["その"],["子孫","しそん"],["に"],["絶えず","たえず"],["ともし火","ともしび"],["を"],["与える","あたえる"],["と"],["約束","やくそく"],["された"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"ヨラムの治世に、エドムがユダに反旗を翻してその支配から脱し、自分たちの王を立てた。","tok":[["ヨラム"],["の"],["治世","ちせい"],["に"],["、"],["エドム"],["が"],["ユダ"],["に"],["反旗","はんき"],["を"],["翻して","ひるがえして"],["その"],["支配","しはい"],["から"],["脱し","だっし"],["、"],["自分","じぶん"],["たち"],["の"],["王","おう"],["を"],["立てた","たてた"],["。"]]},{"verse":21,"text":"ヨラムは全戦車隊を率いてツァイルに進み、夜襲を試みて、自分を包囲するエドム兵とその戦車隊の長たちを打ち破った。しかし、その民は自分の天幕に逃げ帰った。","tok":[["ヨラム"],["は"],["全","ぜん"],["戦車隊","せんしゃたい"],["を"],["率いて","ひきいて"],["ツァイル"],["に"],["進み","すすみ"],["、"],["夜襲","やしゅう"],["を"],["試みて","こころみて"],["、"],["自分","じぶん"],["を"],["包囲","ほうい"],["する"],["エドム"],["兵","へい"],["と"],["その"],["戦車隊","せんしゃたい"],["の"],["長","なが"],["たち"],["を"],["打ち破った","うちやぶった"],["。"],["しかし"],["、"],["その"],["民","みん"],["は"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["逃げ帰った","にげかえった"],["。"]]},{"verse":22,"text":"こうしてエドムはユダに反旗を翻してその支配から脱し、今日に至っている。そのころ、同時にリブナが反旗を翻した。","tok":[["こう"],["して"],["エドム"],["は"],["ユダ"],["に"],["反旗","はんき"],["を"],["翻して","ひるがえして"],["その"],["支配","しはい"],["から"],["脱し","だっし"],["、"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"],["その"],["ころ"],["、"],["同時","どうじ"],["に"],["リブナ"],["が"],["反旗","はんき"],["を"],["翻した","ひるがえした"],["。"]]},{"verse":23,"text":"ヨラムの他の事績、彼の行ったすべての事は、『ユダの王の歴代誌』に記されている。","tok":[["ヨラム"],["の"],["他","ほか"],["の"],["事績","じせき"],["、"],["彼","かれ"],["の"],[
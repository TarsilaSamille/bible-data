[{"verse":1,"text":"彼の治世に、バビロンの王ネブカドネツァルが攻め上って来た。ヨヤキムは三年間彼に服従したが、再び反逆した。","tok":[["彼","かれ"],["の"],["治世","ちせい"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["が"],["攻め上って","せめのぼって"],["来た","きた"],["。"],["ヨヤキム"],["は"],["三","さん"],["年間","ねんかん"],["彼","かれ"],["に"],["服従","ふくじゅう"],["した"],["が"],["、"],["再び","ふたたび"],["反逆","はんぎゃく"],["した"],["。"]]},{"verse":2,"text":"主は彼に対してカルデア人の部隊、アラム人の部隊、モアブ人の部隊、アンモン人の部隊を遣わされた。主はその僕である預言者たちによってお告げになった主の言葉のとおり、ユダを滅ぼすために彼らを差し向けられた。","tok":[["主","ぬし"],["は"],["彼","かれ"],["に対して","にたいして"],["カルデア"],["人","にん"],["の"],["部隊","ぶたい"],["、"],["アラム人","あらむにん"],["の"],["部隊","ぶたい"],["、"],["モアブ人","もあぶにん"],["の"],["部隊","ぶたい"],["、"],["アンモン"],["人","にん"],["の"],["部隊","ぶたい"],["を"],["遣わされた","つかわされた"],["。"],["主","ぬし"],["は"],["その"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["によって"],["お告げ","おつげ"],["に"],["なった"],["主","ぬし"],["の"],["言葉","ことば"],["の"],["とおり"],["、"],["ユダ"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["差し向けられた","さしむけられた"],["。"]]},{"verse":3,"text":"ユダが主の御前から退けられることは、まさに主の御命令によるが、それはマナセの罪のため、彼の行ったすべての事のためであり、","tok":[["ユダ"],["が"],["主","ぬし"],["の"],["御前","ごぜん"],["から"],["退けられる","しりぞけられる"],["こと"],["は"],["、"],["まさに"],["主","ぬし"],["の"],["御命令","ごめいれい"],["に"],["よる"],["が"],["、"],["それ"],["は"],["マナセ"],["の"],["罪","つみ"],["の"],["ため"],["、"],["彼","かれ"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["の"],["ため"],["で"],["あり"],["、"]]},{"verse":4,"text":"またマナセが罪のない者の血を流し、エルサレムを罪のない者の血で満たしたためである。主はそれを赦そうとはされなかった。","tok":[["また"],["マナセ"],["が"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["を"],["流し","ながし"],["、"],["エルサレム"],["を"],["罪","つみ"],["の"],["ない"],["者","もの"],["の"],["血","ち"],["で"],["満たした","みたした"],["ため"],["で"],["ある"],["。"],["主","ぬし"],["は"],["それ"],["を"],["赦そう","ゆるそう"],["と"],["は"],["されなかった"],["。"]]},{"verse":5,"text":"ヨヤキムの他の事績、彼の行ったすべての事は、『ユダの王の歴代誌』に記されている。","tok":[["ヨヤキム"],["の"],["他","ほか"],["の"],["事績","じせき"],["、"],["彼","かれ"],["の"],["行った","おこなった"],["すべて"],["の"],["事","こと"],["は"],["、"],["『"],["ユダ"],["の"],["王","おう"],["の"],["歴代誌","れきだいし"],["』"],["に"],["記されて","しるされて"],["いる"],["。"]]},{"verse":6,"text":"ヨヤキムは先祖と共に眠りにつき、その子ヨヤキンが代わって王となった。","tok":[["ヨヤキム"],["は"],["先祖","せんぞ"],["と"],["共","とも"],["に"],["眠り","ねむり"],["に"],["つき"],["、"],["その"],["子","こ"],["ヨヤキン"],["が"],["代わって","かわって"],["王","おう"],["と"],["なった"],["。"]]},{"verse":7,"text":"エジプトの王は自分の地から再び出て来ることがなかった。バビロンの王が、エジプトの川からユーフラテス川に至るまで、エジプトの王のものであったすべての地方を占領したからである。","tok":[["エジプト"],["の"],["王","おう"],["は"],["自分","じぶん"],["の"],["地","ち"],["から"],["再び","ふたたび"],["出て","でて"],["来る","くる"],["こと"],["が"],["なかった"],["。"],["バビロン"],["の"],["王","おう"],["が"],["、"],["エジプト"],["の"],["川","かわ"],["から"],["ユーフラテス"],["川","かわ"],["に"],["至る","いたる"],["まで"],["、"],["エジプト"],["の"],["王","おう"],["の"],["もの"],["で"],["あった"],["すべて"],["の"],["地方","ちほう"],["を"],["占領","せんりょう"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"ヨヤキンは十八歳で王となり、三か月間エルサレムで王位にあった。その母は名をネフシュタといい、エルサレム出身のエルナタンの娘であった。","tok":[["ヨヤキン"],["は"],["十八歳","じゅうはちさい"],["で"],["王","おう"],["と"],["なり"],["、"],["三","さん"],["か月間","かげつかん"],["エルサレム"],["で"],["王位","おうい"],["に"],["あった"],["。"],["その"],["母","はは"],["は"],["名","な"],["を"],["ネフシュタ"],["と"],["いい"],["、"],["エルサレム"],["出身","しゅっしん"],["の"],["エルナタン"],["の"],["娘","むすめ"],["で"],["あった"],["。"]]},{"verse":9,"text":"彼は父が行ったように、主の目に悪とされることをことごとく行った。","tok":[["彼","かれ"],["は"],["父","ちち"],["が"],["行った","おこなった"],["よう"],["に"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["ことごとく"],["行った","いった"],["。"]]},{"verse":10,"text":"そのころ、バビロンの王ネブカドネツァルの部将たちがエルサレムに攻め上って来て、この都を包囲した。","tok":[["その"],["ころ"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["の"],["部将","ぶしょう"],["たち"],["が"],["エルサレム"],["に"],["攻め上って","せめのぼって"],["来て","きて"],["、"],["この"],["都","と"],["を"],["包囲","ほうい"],["した"],["。"]]},{"verse":11,"text":"部将たちが都を包囲しているところに、バビロンの王ネブカドネツァルも来た。","tok":[["部将","ぶしょう"],["たち"],["が"],["都","と"],["を"],["包囲","ほうい"],["して"],["いる"],["ところ"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["も"],["来た","きた"],["。"]]},{"verse":12,"text":"ユダの王ヨヤキンは母、家臣、高官、宦官らと共にバビロン王の前に出て行き、バビロンの王はその治世第八年に彼を捕らえた。","tok":[["ユダ"],["の"],["王","おう"],["ヨヤキン"],["は"],["母","はは"],["、"],["家臣","かしん"],["、"],["高官","こうかん"],["、"],["宦官","かんがん"],["ら"],["と"],["共","とも"],["に"],["バビロン"],["王","おう"],["の"],["前","まえ"],["に"],["出て","でて"],["行き","いき"],["、"],["バビロン"],["の"],["王","おう"],["は"],["その"],["治世","ちせい"],["第","だい"],["八","はち"],["年","ねん"],["に"],["彼","かれ"],["を"],["捕らえた","とらえた"],["。"]]},{"verse":13,"text":"主が告げられたとおり、バビロンの王は主の神殿の宝物と王宮の宝物をことごとく運び出し、イスラエルの王ソロモンが主の聖所のために造った金の器をことごとく切り刻んだ。","tok":[["主","ぬし"],["が"],["告げられた","つげられた"],["とおり"],["、"],["バビロン"],["の"],["王","おう"],["は"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["宝物","たからもの"],["と"],["王宮","おうきゅう"],["の"],["宝物","たからもの"],["を"],["ことごとく"],["運び出し","はこびだし"],["、"],["イスラエル"],["の"],["王","おう"],["ソロモン"],["が"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["の"],["ため"],["に"],["造った","つくった"],["金","かね"],["の"],["器","うつわ"],["を"],["ことごとく"],["切り刻んだ","きりきざんだ"],["。"]]},{"verse":14,"text":"彼はエルサレムのすべての人々、すなわちすべての高官とすべての勇士一万人、それにすべての職人と鍛冶を捕囚として連れ去り、残されたのはただ国の民の中の貧しい者だけであった。","tok":[["彼","かれ"],["は"],["エルサレム"],["の"],["すべて"],["の"],["人々","ひとびと"],["、"],["すなわち"],["すべて"],["の"],["高官","こうかん"],["と"],["すべて"],["の"],["勇士","ゆうし"],["一万人","いちまんにん"],["、"],["それ"],["に"],["すべて"],["の"],["職人","しょくにん"],["と"],["鍛冶","たんや"],["を"],["捕囚","ほしゅう"],["として"],["連れ去り","つれさり"],["、"],["残された","のこされた"],["の"],["は"],["ただ"],["国","くに"],["の"],["民","たみ"],["の"],["中","なか"],["の"],["貧しい","まずしい"],["者","もの"],["だけ"],["で"],["あった"],["。"]]},{"verse":15,"text":"彼はヨヤキンを捕囚としてバビロンに連れ去り、その王の母、王妃たち、宦官たち、国の有力者たちも、捕囚としてエルサレムからバビロンに行かせた。","tok":[["彼","かれ"],["は"],["ヨヤキン"],["を"],["捕囚","ほしゅう"],["として"],["バビロン"],["に"],["連れ去り","つれさり"],["、"],["その"],["王","おう"],["の"],["母","はは"],["、"],["王妃","おうひ"],["たち"],["、"],["宦官","かんがん"],["たち"],["、"],["国","くに"],["の"],["有力","ゆうりょく"],["者","しゃ"],["たち"],["も"],["、"],["捕囚","ほしゅう"],["として"],["エルサレム"],["から"],["バビロン"],["に"],["行かせた","いかせた"],["。"]]},{"verse":16,"text":"バビロンの王はすべての軍人七千人、職人と鍛冶千人、勇敢な戦士全員を、捕囚としてバビロンに連れて行った。","tok":[["バビロン"],["の"],["王","おう"],["は"],["すべて"],["の"],["軍人","ぐんじん"],["七千人","ななせんにん"],["、"],["職人","しょくにん"],["と"],["鍛冶","たんや"],["千人","せんにん"],["、"],["勇敢","ゆうかん"],["な"],["戦士","せんし
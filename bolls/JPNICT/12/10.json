[{"verse":1,"text":"アハブの子供が七十人サマリアにいた。イエフは手紙を書いてサマリアに送り、町の指導者、長老たちとアハブの子供の養育者たちにこう伝えた。","tok":[["アハブ"],["の"],["子供","こども"],["が"],["七","なな"],["十人","じゅうにん"],["サマリア"],["に"],["いた"],["。"],["イエフ"],["は"],["手紙","てがみ"],["を"],["書いて","かいて"],["サマリア"],["に"],["送り","おくり"],["、"],["町","まち"],["の"],["指導者","しどうしゃ"],["、"],["長老","ちょうろう"],["たち"],["と"],["アハブ"],["の"],["子供","こども"],["の"],["養育者","よういくしゃ"],["たち"],["に"],["こう"],["伝えた","つたえた"],["。"]]},{"verse":2,"text":"「今この手紙が届いたら、あなたたちのもとにはあなたたちの主君の子供、それに戦車、軍馬、および砦の町と武器があるのだから、","tok":[["「"],["今","いま"],["この"],["手紙","てがみ"],["が"],["届いたら","とどいたら"],["、"],["あなた"],["たち"],["の"],["もと"],["に"],["は"],["あなた"],["たち"],["の"],["主君","しゅくん"],["の"],["子供","こども"],["、"],["それ"],["に"],["戦車","せんしゃ"],["、"],["軍馬","ぐんば"],["、"],["および"],["砦","とりで"],["の"],["町","まち"],["と"],["武器","ぶき"],["が"],["ある"],["の"],["だ"],["から"],["、"]]},{"verse":3,"text":"その主君の子供の中から最も優れた正しい人物を選んで、父の王座につけ、あなたたちの主君の家のために戦え。」","tok":[["その"],["主君","しゅくん"],["の"],["子供","こども"],["の"],["中","なか"],["から"],["最も","もっとも"],["優れた","すぐれた"],["正しい","ただしい"],["人物","じんぶつ"],["を"],["選んで","えらんで"],["、"],["父","ちち"],["の"],["王座","おうざ"],["に"],["つけ"],["、"],["あなた"],["たち"],["の"],["主君","しゅくん"],["の"],["家","いえ"],["の"],["ため"],["に"],["戦え","たたかえ"],["。"],["」"]]},{"verse":4,"text":"彼らは大いに恐れ、「二人の王でさえ彼に立ち向かえなかったのに、どうして我々が立ち向かうことができよう」と言った。","tok":[["彼","かれ"],["ら"],["は"],["大いに","おおいに"],["恐れ","おそれ"],["、"],["「"],["二人","ふたり"],["の"],["王","おう"],["で"],["さえ"],["彼","かれ"],["に"],["立ち向かえなかった","たちむかえなかった"],["のに"],["、"],["どう"],["して"],["我々","われわれ"],["が"],["立ち向かう","たちむかう"],["こと"],["が"],["できよう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"そこで宮廷長、町の長、長老、養育者たちはイエフに人を送ってこう言わせた。「わたしたちはあなたの僕です。あなたがお命じになることは何でもいたします。わたしたちにはだれをも王として立てるつもりがありません。あなたの目に良いと映ることをなさってください。」","tok":[["そこ"],["で"],["宮廷長","きゅうていちょう"],["、"],["町","まち"],["の"],["長","ちょう"],["、"],["長老","ちょうろう"],["、"],["養育者","よういくしゃ"],["たち"],["は"],["イエフ"],["に"],["人","ひと"],["を"],["送って","おくって"],["こう"],["言わせた","いわせた"],["。"],["「"],["わたしたち"],["は"],["あなた"],["の"],["僕","ぼく"],["です"],["。"],["あなた"],["が"],["お命じ","おめいじ"],["に"],["なる"],["こと"],["は"],["何","なん"],["で"],["も"],["いたします"],["。"],["わたしたち"],["に"],["は"],["だれ"],["を"],["も"],["王","おう"],["として"],["立てる","たてる"],["つもり"],["が"],["ありません"],["。"],["あなた"],["の"],["目","め"],["に"],["良い","よい"],["と"],["映る","うつる"],["こと"],["を"],["なさって"],["ください"],["。"],["」"]]},{"verse":6,"text":"イエフは彼らにもう一通手紙を書いて、こう言った。「もしあなたたちがわたしの味方をし、わたしの命令に従うなら、あなたたちの主君の子供たちの首を取り、明日の今ごろ、イズレエルにいるわたしのもとに持って来なさい。」七十人の王子たちは、それぞれその養育に当たっていた町の有力者たちのところにいたが、","tok":[["イエフ"],["は"],["彼","かれ"],["ら"],["に"],["もう"],["一通","いちつう"],["手紙","てがみ"],["を"],["書いて","かいて"],["、"],["こう"],["言った","いった"],["。"],["「"],["もし"],["あなた"],["たち"],["が"],["わたし"],["の"],["味方","みかた"],["を"],["し"],["、"],["わたし"],["の"],["命令","めいれい"],["に"],["従うなら","したがうなら"],["、"],["あなた"],["たち"],["の"],["主君","しゅくん"],["の"],["子供","こども"],["たち"],["の"],["首","くび"],["を"],["取り","とり"],["、"],["明日","あす"],["の"],["今ごろ","いまごろ"],["、"],["イズレエル"],["に"],["いる"],["わたし"],["の"],["もと"],["に"],["持って","もって"],["来","き"],["なさい"],["。"],["」"],["七","なな"],["十人","じゅうにん"],["の"],["王子","おうじ"],["たち"],["は"],["、"],["それぞれ"],["その"],["養育","よういく"],["に"],["当たって","あたって"],["いた"],["町","まち"],["の"],["有力","ゆうりょく"],["者","しゃ"],["たち"],["の"],["ところ"],["に"],["いた"],["が"],["、"]]},{"verse":7,"text":"この手紙が届くと、彼らは王子たちを捕らえ、七十人を残らず殺し、その首を籠に入れ、イズレエルにいるイエフのもとに送った。","tok":[["この"],["手紙","てがみ"],["が"],["届く","とどく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["王子","おうじ"],["たち"],["を"],["捕らえ","とらえ"],["、"],["七","なな"],["十人","じゅうにん"],["を"],["残らず","のこらず"],["殺し","ころし"],["、"],["その"],["首","くび"],["を"],["籠","かご"],["に"],["入れ","いれ"],["、"],["イズレエル"],["に"],["いる"],["イエフ"],["の"],["もと"],["に"],["送った","おくった"],["。"]]},{"verse":8,"text":"使者が、「王子の首が届けられました」と知らせに来ると、イエフは、「その首は二つの山に積んで、明朝まで町の入り口にさらしておけ」と命じた。","tok":[["使者","ししゃ"],["が"],["、"],["「"],["王子","おうじ"],["の"],["首","くび"],["が"],["届けられました","とどけられました"],["」"],["と"],["知らせ","しらせ"],["に"],["来る","くる"],["と"],["、"],["イエフ"],["は"],["、"],["「"],["その"],["首","くび"],["は"],["二","ふた"],["つ"],["の"],["山","やま"],["に"],["積んで","つんで"],["、"],["明朝","みょうちょう"],["まで"],["町","まち"],["の"],["入り口","いりぐち"],["に"],["さらして"],["おけ"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":9,"text":"翌朝、彼はそこに出て行って立ち、すべての民に言った。「あなたたちに罪はない。わたしは主君に対して謀反を起こし、彼を殺した。だが、この者たちすべてを打ち殺したのは誰か。","tok":[["翌朝","よくあさ"],["、"],["彼","かれ"],["は"],["そこ"],["に"],["出て","でて"],["行って","いって"],["立ち","たち"],["、"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["に"],["罪","つみ"],["は"],["ない"],["。"],["わたし"],["は"],["主君","しゅくん"],["に対して","にたいして"],["謀反","むほん"],["を"],["起こし","おこし"],["、"],["彼","かれ"],["を"],["殺した","ころした"],["。"],["だ"],["が"],["、"],["この"],["者","もの"],["たち"],["すべて"],["を"],["打ち殺した","うちころした"],["の"],["は"],["誰","だれ"],["か"],["。"]]},{"verse":10,"text":"ただ、このことだけは知っておくがいい。主がアハブの家に対してお告げになった主の言葉は一つも地に落ちることがない。主はその僕エリヤによってお告げになったことを実現された。」","tok":[["ただ"],["、"],["この"],["こと"],["だけ"],["は"],["知って","しって"],["おく"],["が"],["いい"],["。"],["主","ぬし"],["が"],["アハブ"],["の"],["家","いえ"],["に対して","にたいして"],["お告げ","おつげ"],["に"],["なった"],["主","ぬし"],["の"],["言葉","ことば"],["は"],["一","ひと"],["つ"],["も"],["地","ち"],["に"],["落ちる","おちる"],["こと"],["が"],["ない"],["。"],["主","ぬし"],["は"],["その"],["僕","ぼく"],["エリヤ"],["によって"],["お告げ","おつげ"],["に"],["なった"],["こと"],["を"],["実現","じつげん"],["された"],["。"],["」"]]},{"verse":11,"text":"こうしてイエフは、イズレエルに残っていたアハブの家の者およびアハブについていた有力者、親友、祭司を皆打ち殺し、一人も残さなかった。","tok":[["こう"],["して"],["イエフ"],["は"],["、"],["イズレエル"],["に"],["残って","のこって"],["いた"],["アハブ"],["の"],["家","いえ"],["の"],["者","もの"],["および"],["アハブ"],["について"],["いた"],["有力","ゆうりょく"],["者","しゃ"],["、"],["親友","しんゆう"],["、"],["祭司","さいし"],["を"],["皆","みな"],["打ち殺し","うちころし"],["、"],["一人","ひとり"],["も"],["残さなかった","のこさなかった"],["。"]]},{"verse":12,"text":"イエフは立ってサマリアに向かったが、途中ベト‧エケド‧ロイムで、","tok":[["イエフ"],["は"],["立って","たって"],["サマリア"],["に"],["向かった","むかった"],["が"],["、"],["途中","とちゅう"],["ベト"],["‧"],["エケド"],["‧"],["ロイム"],["で"],["、"]]},{"verse":13,"text":"ユダの王アハズヤの身内の者たちに出会った。「あなたたちは誰か」と尋ねると、彼らは、「わたしたちはアハズヤの身内の者です。王子たち、王妃の子供たちの安否を問いに行くところです」と答えた。","tok":[["ユダ"],["の"],["王","おう"],["アハズヤ"],["の"],["身内","みうち"],["の"],["者","もの"],["たち"],["に"],["出会った","であった"],["。"],["「"],["あなた"],["たち"],["は"],["誰","だれ"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["わたしたち"],["は"],["アハズヤ"],["の"],["身内","みうち"],["の"],["者","もの"],["です"],["。"],["王子","おうじ"],["たち"],["、"],["王妃","おうひ"],["の"],["子供","こども"],["たち"],["の"],["安否","あんぴ"],["を"],["問い","とい"],["に"],["行く","いく"],["ところ"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":14,"text":"彼は、「この者たちを皆、生け捕りにせよ」と命じた。部下は彼らを生け捕りにして、ベト‧エケドの水溜めのところで、彼ら四十二人を殺し、一人も残さなかった。","tok":[["彼","かれ"],["は"],["、"],["「"],["この"],["者","もの"],["たち"],["を"],["皆","みな"],["、"],["生け捕り","いけどり"],["に"],["せよ"],["」"],["と"],["命じた","めいじた"],["。"],["部下","ぶか"],["は"],["彼","かれ"],["ら"],["を"],["生け捕り","いけどり"],["に"],["して"],["、"],["ベト"],["‧"],["エケド"],["の"],["水溜め","みずだめ"],["の"],["ところ"],["で"],["、"],["彼","かれ"],["ら"],["四十二人","よんじゅうににん"],["を"],["殺し","ころし"],["、"],["一人","ひとり"],["も"],["残さなかった","のこさなかった"],["。"]]},{"verse":15,"text":"イエフがそこを出て進んで行くと、彼を迎えに出たレカブの子ヨナダブに会った。イエフは彼に挨拶して言った。「わたしの心があなたの心に対して誠実であるように、あなたの心も誠実ですか。」ヨナダブは答えた。「そのとおりです。」イエフが、「そのとおりなら、手を出してください」と言ったので、ヨナダブが手を差し出すと、イエフは彼を引き上げて自分の戦車に乗せ、","tok":[["イエフ"],["が"],["そこ"],["を"],["出て","でて"],["進んで","すすんで"],["行く","いく"],["と"],["、"],["彼","かれ"],["を"],["迎え","むかえ"],["に"],["出た","でた"],["レカブ"],["の"],["子","こ"],["ヨナダブ"],["に"],["会った","あった"],["。"],["イエフ"],["は"],["彼","かれ"],["に"],["挨拶","あいさつ"],["して"],["言った","いった"],["。"],["「"],["わたし"],["の"],["心","こころ"],["が"],["あなた"],["の"],["心","こころ"],["に対して","にたいして"],["誠実","せいじつ"],["で"],["ある"],["よう"],["に"],["、"],["あなた"],["の"],["心","こころ"],["も"],["誠実","せいじつ"],["です"],["か"],["。"],["」"],["ヨナダブ"],["は"],["答えた","こたえた"],["。"],["「"],["その"],["とおり"],["です"],["。"],["」"],["イエフ"],["が"],["、"],["「"],["その"],["とおり"],["なら"],["、"],["手","て"],["を"],["出して","だして"],["ください"],["」"],["と"],["言った","いった"],["ので"],["、"],["ヨナダブ"],["が"],["手","て"],["を"],["差し出す","さしだす"],["と"],["、"],["イエフ"],["は"],["彼","かれ"],["を"],["引き上げて","ひきあげて"],["自分","じぶん"],["の"],["戦車","せんしゃ"],["に"],["乗せ","のせ"],["、"]]},{"verse":16,"text":"「一緒に来て、主に対するわたしの情熱を見てください」と言った。二人は彼の戦車に一緒に乗り、","tok":[["「"],["一緒","いっしょ"],["に"],["来て","きて"],["、"],["主","ぬし"],["に"],["対する","たいする"],["わたし"],["の"],["情熱","じょうねつ"],["を"],["見て","みて"],["ください"],["」"],["と"],["言った","いった"],["。"],["二人","ふたり"],["は"],["彼","かれ"],["の"],["戦車","せんしゃ"],["に"],["一緒","いっしょ"],["に"],["乗り","のり"],["、"]]},{"verse":17,"text":"サマリアに行った。彼は主がエリヤにお告げになった言葉のとおり、サマリアでアハブの家の者をことごとく打ち殺し、一族を全滅させた。","tok":[["サマリア"],["に"],["行った","いった"],["。"],["彼","かれ"],["は"],["主","ぬし"],["が"],["エリヤ"],["に"],["お告げ","おつげ"],["に"],["なった"],["言葉","ことば"],["の"],["とおり"],["、"],["サマリア"],["で"],["アハブ"],["の"],["家","いえ"],["の"],["者","もの"],["を"],["ことごとく"],["打ち殺し","うちころし"],["、"],["一族","いちぞく"],["を"],["全滅","ぜんめつ"],["させた"],["。"]]},{"verse":18,"text":"イエフはすべての民を集めて言った。「アハブは少ししかバアルに仕えなかったが、このイエフは大いにバアルに仕えるつもりだ。","tok":[["イエフ"],["は"],["すべて"],["の"],["民","たみ"],["を"],["集めて","あつめて"],["言った","いった"],["。"],["「"],["アハブ"],["は"],["少し","すこし"],["しか"],["バアル"],["に"],["仕えなかった","つかえなかった"],["が"],["、"],["この"],["イエフ"],["は"],["大いに","おおいに"],["バアル"],["に"],["仕える","つかえる"],["つもり"],["だ"],["。"]]},{"verse":19,"text":"今バアルのすべての預言者、バアルに仕えるすべての者、すべての祭司をわたしのもとに呼べ。一人も欠席させてはならない。わたしがバアルに大いなるいけにえをささげるからだ。欠席する者はだれも生かしてはおかない。」イエフはバアルに仕える者を絶やすために、策略を用いたのである。","tok":[["今","いま"],["バアル"],["の"],["すべて"],["の"],["預言者","よげんしゃ"],["、"],["バアル"],["に"],["仕える","つかえる"],["すべて"],["の"],["者","もの"],["、"],["すべて"],["の"],["祭司","さいし"],["を"],["わたし"],["の"],["もと"],["に"],["呼べ","よべ"],["。"],["一人","ひとり"],["も"],["欠席","けっせき"],["させて"],["は"],["ならない"],["。"],["わたし"],["が"],["バアル"],["に"],["大いなる","おおいなる"],["いけにえ"],["を"],["ささげる"],["から"],["だ"],["。"],["欠席","けっせき"],["する"],["者","もの"],["は"],["だれ"],["も"],["生かして","いかして"],["は"],["おかない"],["。"],["」"],["イエフ"],["は"],["バアル"],["に"],["仕える","つかえる"],["者","もの"],["を"],["絶やす","たやす"],["ため"],["に"],["、"],["策略","さくりゃく"],["を"],["用いた","もちいた"],["ので"],["ある"],["。"]]},{"verse":20,"text":"イエフが、「バアルのために聖なる集まりを催せ」と命じたので、彼らはそれを布告した。","tok":[["イエフ"],["が"],["、"],["「"],["バアル"],["の"],["ため"],["に"],["聖","せい"],["なる"],["集まり","あつまり"],["を"],["催せ","もよおせ"],["」"],["と"],["命じた","めいじた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["布告","ふこく"],["した"],["。"]]},{"verse":21,"text":"イエフがイスラエル中に使者を遣わすと、バアルに仕える者が皆集まって来た。来ない者は一人もなかった。彼らはバアルの神殿に入り、神殿は隅々まで満ちた。","tok":[["イエフ"],["が"],["イスラエル"],["中","ちゅう"],["に"],["使者","ししゃ"],["を"],["遣わす","つかわす"],["と"],["、"],["バアル"],["に"],["仕える","つかえる"],["者","もの"],["が"],["皆","みな"],["集まって","あつまって"],["来た","きた"],["。"],["来ない","こない"],["者","もの"],["は"],["一人","ひとり"],["も"],["なかった"],["。"],["彼","かれ"],["ら"],["は"],["バアル"],["の"],["神殿","しんでん"],["に"],["入り","はいり"],["、"],["神殿","しんでん"],["は"],["隅々","すみずみ"],["まで"],["満ちた","みちた"],["。"]]},{"verse":22,"text":"イエフは衣装係に、「バアルに仕えるすべての者に祭服を出してやれ」と言った。彼らは祭服を出した。","tok":[["イエフ"],["は"],["衣装","いしょう"],["係","かかり"],["に"],["、"],["「"],["バアル"],["に"],["仕える","つかえる"],["すべて"],["の"],["者","もの"],["に"],["祭服","さいふく"],["を"],["出して","だして"],["やれ"],["」"],["と"],["言った","いった"],["。"],["彼","かれ"],["ら"],["は"],["祭服","さいふく"],["を"],["出した","だした"],["。"]]},{"verse":23,"text":"そこでイエフはレカブ人ヨナダブと共にバアルの神殿に入り、バアルに仕える者たちに言った。「主に仕える者があなたたちと一緒にいることがないよう、ただバアルに仕える者だけがいるように、よく調べて見よ。」","tok":[["そこ"],["で"],["イエフ"],["は"],["レカブ人","れかぶにん"],["ヨナダブ"],["と"],["共","とも"],["に"],["バアル"],["の"],["神殿","しんでん"],["に"],["入り","はいり"],["、"],["バアル"],["に"],["仕える","つかえる"],["者","もの"],["たち"],["に"],["言った","いった"],["。"],["「"],["主に","おもに"],["仕える","つかえる"],["者","もの"],["が"],["あなた"],["たち"],["と"],["一緒","いっしょ"],["に"],["いる"],["こと"],["が"],["ない"],["よう"],["、"],["ただ"],["バアル"],["に"],["仕える","つかえる"],["者","もの"],["だけ"],["が"],["いる"],["よう"],["に"],["、"],["よく"],["調べて","しらべて"],["見","み"],["よ"],["。"],["」"]]},{"verse":24,"text":"二人はいけにえと焼き尽くす献げ物をささげるために入ったが、イエフは外に八十人の人を置き、次のように言った。「わたしがお前たちの手に渡す者を逃がした者は、自分の命をその逃がした者の命に代えなければならない。」","tok":[["二人","ふたり"],["は"],["いけにえ"],["と"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげる"],["ため"],["に"],["入った","はいった"],["が"],["、"],["イエフ"],["は"],["外","そと"],["に"],["八","はち"],["十人","じゅうにん"],["の"],["人","ひと"],["を"],["置き","おき"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言った","いった"],["。"],["「"],["わたし"],["が"],["お前","おまえ"],["たち"],["の"],["手","て"],["に"],["渡す","わたす"],["者","もの"],["を"],["逃がした","にがした"],["者","もの"],["は"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["その"],["逃がした","にがした"],["者","もの"],["の"],["命","いのち"],["に"],["代えなければ","かえなければ"],["ならない"],["。"],["」"]]},{"verse":2
[{"verse":1,"text":"ゼデキヤの治世第九年の第十の月の十日に、バビロンの王ネブカドネツァルは全軍を率いてエルサレムに到着し、陣を敷き、周りに堡塁を築いた。","tok":[["ゼデキヤ"],["の"],["治世","ちせい"],["第","だい"],["九","きゅう"],["年","ねん"],["の"],["第","だい"],["十","じゅう"],["の"],["月","つき"],["の"],["十日","とうか"],["に"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["は"],["全軍","ぜんぐん"],["を"],["率いて","ひきいて"],["エルサレム"],["に"],["到着","とうちゃく"],["し"],["、"],["陣","じん"],["を"],["敷き","しき"],["、"],["周り","まわり"],["に"],["堡塁","ほうるい"],["を"],["築いた","きずいた"],["。"]]},{"verse":2,"text":"都は包囲され、ゼデキヤ王の第十一年に至った。","tok":[["都","と"],["は"],["包囲","ほうい"],["され"],["、"],["ゼデキヤ"],["王","おう"],["の"],["第","だい"],["十一","じゅういち"],["年","ねん"],["に"],["至った","いたった"],["。"]]},{"verse":3,"text":"その月の九日に都の中で飢えが厳しくなり、国の民の食糧が尽き、","tok":[["その"],["月","つき"],["の"],["九日","ここのか"],["に"],["都","と"],["の"],["中","なか"],["で"],["飢え","うえ"],["が"],["厳しく","きびしく"],["なり"],["、"],["国","くに"],["の"],["民","たみ"],["の"],["食糧","しょくりょう"],["が"],["尽き","つき"],["、"]]},{"verse":4,"text":"都の一角が破られた。カルデア人が都を取り巻いていたが、戦士たちは皆、夜中に王の園に近い二つの城壁の間にある門を通って逃げ出した。王はアラバに向かって行った。","tok":[["都","と"],["の"],["一角","いっかく"],["が"],["破られた","やぶられた"],["。"],["カルデア"],["人","にん"],["が"],["都","と"],["を"],["取り巻いて","とりまいて"],["いた"],["が"],["、"],["戦士","せんし"],["たち"],["は"],["皆","みな"],["、"],["夜中","よなか"],["に"],["王","おう"],["の"],["園","その"],["に"],["近い","ちかい"],["二","ふた"],["つ"],["の"],["城壁","じょうへき"],["の"],["間","あいだ"],["に"],["ある"],["門","もん"],["を"],["通って","とおって"],["逃げ出した","にげだした"],["。"],["王","おう"],["は"],["アラバ"],["に"],["向かって","むかって"],["行った","いった"],["。"]]},{"verse":5,"text":"カルデア軍は王の後を追い、エリコの荒れ地で彼に追いついた。王の軍隊はすべて王を離れ去ってちりぢりになった。","tok":[["カルデア"],["軍","ぐん"],["は"],["王","おう"],["の"],["後","あと"],["を"],["追い","おい"],["、"],["エリコ"],["の"],["荒れ地","あれち"],["で"],["彼","かれ"],["に"],["追いついた","おいついた"],["。"],["王","おう"],["の"],["軍隊","ぐんたい"],["は"],["すべて"],["王","おう"],["を"],["離れ去って","はなれさって"],["ちりぢり"],["に"],["なった"],["。"]]},{"verse":6,"text":"王は捕らえられ、リブラにいるバビロンの王のもとに連れて行かれ、裁きを受けた。","tok":[["王","おう"],["は"],["捕らえられ","とらえられ"],["、"],["リブラ"],["に"],["いる"],["バビロン"],["の"],["王","おう"],["の"],["もと"],["に"],["連れて","つれて"],["行かれ","いかれ"],["、"],["裁き","さばき"],["を"],["受けた","うけた"],["。"]]},{"verse":7,"text":"彼らはゼデキヤの目の前で彼の王子たちを殺し、その上でバビロンの王は彼の両眼をつぶし、青銅の足枷をはめ、彼をバビロンに連れて行った。","tok":[["彼","かれ"],["ら"],["は"],["ゼデキヤ"],["の"],["目","め"],["の"],["前","まえ"],["で"],["彼","かれ"],["の"],["王子","おうじ"],["たち"],["を"],["殺し","ころし"],["、"],["その"],["上","うえ"],["で"],["バビロン"],["の"],["王","おう"],["は"],["彼","かれ"],["の"],["両眼","りょうめ"],["を"],["つぶし"],["、"],["青銅","せいどう"],["の"],["足枷","あしかせ"],["を"],["はめ"],["、"],["彼","かれ"],["を"],["バビロン"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":8,"text":"第五の月の七日、バビロンの王ネブカドネツァルの第十九年のこと、バビロンの王の家臣、親衛隊の長ネブザルアダンがエルサレムに来て、","tok":[["第","だい"],["五","ご"],["の"],["月","つき"],["の"],["七日","ななか"],["、"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["の"],["第","だい"],["十九","じゅうきゅう"],["年","ねん"],["の"],["こと"],["、"],["バビロン"],["の"],["王","おう"],["の"],["家臣","かしん"],["、"],["親衛隊","しんえいたい"],["の"],["長","ちょう"],["ネブザルアダン"],["が"],["エルサレム"],["に"],["来て","きて"],["、"]]},{"verse":9,"text":"主の神殿、王宮、エルサレムの家屋をすべて焼き払った。大いなる家屋もすべて、火を放って焼き払った。","tok":[["主","ぬし"],["の"],["神殿","しんでん"],["、"],["王宮","おうきゅう"],["、"],["エルサレム"],["の"],["家屋","かおく"],["を"],["すべて"],["焼き払った","やきはらった"],["。"],["大いなる","おおいなる"],["家屋","かおく"],["も"],["すべて"],["、"],["火","ひ"],["を"],["放って","はなって"],["焼き払った","やきはらった"],["。"]]},{"verse":10,"text":"また親衛隊の長と共に来たカルデア人は、軍をあげてエルサレムの周囲の城壁を取り壊した。","tok":[["また"],["親衛隊","しんえいたい"],["の"],["長","ちょう"],["と"],["共","とも"],["に"],["来た","きた"],["カルデア"],["人","にん"],["は"],["、"],["軍","ぐん"],["を"],["あげて"],["エルサレム"],["の"],["周囲","しゅうい"],["の"],["城壁","じょうへき"],["を"],["取り壊した","とりこわした"],["。"]]},{"verse":11,"text":"民のうち都に残っていたほかの者、バビロンの王に投降した者、その他の民衆は、親衛隊の長ネブザルアダンによって捕囚とされ、連れ去られた。","tok":[["民","みん"],["の"],["うち"],["都","みやこ"],["に"],["残って","のこって"],["いた"],["ほか"],["の"],["者","もの"],["、"],["バビロン"],["の"],["王","おう"],["に"],["投降","とうこう"],["した"],["者","もの"],["、"],["その"],["他","た"],["の"],["民衆","みんしゅう"],["は"],["、"],["親衛隊","しんえいたい"],["の"],["長","ちょう"],["ネブザルアダン"],["によって"],["捕囚","ほしゅう"],["と"],["され"],["、"],["連れ去られた","つれさられた"],["。"]]},{"verse":12,"text":"この地の貧しい民の一部は、親衛隊の長によってぶどう畑と耕地にそのまま残された。","tok":[["この"],["地","ち"],["の"
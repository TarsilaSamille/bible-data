[{"verse":1,"text":"預言者エリシャは預言者の仲間の一人を呼んで言った。「腰に帯を締め、手にこの油の壺を持って、ラモト‧ギレアドに行きなさい。","tok":[["預言者","よげんしゃ"],["エリシャ"],["は"],["預言者","よげんしゃ"],["の"],["仲間","なかま"],["の"],["一人","ひとり"],["を"],["呼んで","よんで"],["言った","いった"],["。"],["「"],["腰","こし"],["に"],["帯","おび"],["を"],["締め","しめ"],["、"],["手","て"],["に"],["この"],["油","あぶら"],["の"],["壺","つぼ"],["を"],["持って","もって"],["、"],["ラモト"],["‧"],["ギレアド"],["に"],["行き","いき"],["なさい"],["。"]]},{"verse":2,"text":"そこに着いたら、ニムシの孫でヨシャファトの子であるイエフに会いなさい。あなたは入って彼をその仲間の間から立たせ、奥の部屋に連れて行き、","tok":[["そこ"],["に"],["着いたら","ついたら"],["、"],["ニムシ"],["の"],["孫","まご"],["で"],["ヨシャファト"],["の"],["子","こ"],["で"],["ある"],["イエフ"],["に"],["会い","あい"],["なさい"],["。"],["あなた"],["は"],["入って","はいって"],["彼","かれ"],["を"],["その"],["仲間","なかま"],["の"],["間","あいだ"],["から"],["立たせ","たたせ"],["、"],["奥","おく"],["の"],["部屋","へや"],["に"],["連れて","つれて"],["行き","いき"],["、"]]},{"verse":3,"text":"油の壺を取って彼の頭に注いで言いなさい。『主はこう言われる。わたしはあなたに油を注ぎ、あなたをイスラエルの王とする』と。そして戸を開けて逃げて来なさい。ぐずぐずしていてはならない。」","tok":[["油","あぶら"],["の"],["壺","つぼ"],["を"],["取って","とって"],["彼","かれ"],["の"],["頭","あたま"],["に"],["注いで","そそいで"],["言い","いい"],["なさい"],["。"],["『"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["あなた"],["を"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["』"],["と"],["。"],["そして"],["戸","と"],["を"],["開けて","あけて"],["逃げて","にげて"],["来","き"],["なさい"],["。"],["ぐずぐず"],["して"],["いて"],["は"],["ならない"],["。"],["」"]]},{"verse":4,"text":"その若者、預言者の従者はラモト‧ギレアドに行った。","tok":[["その"],["若者","わかもの"],["、"],["預言者","よげんしゃ"],["の"],["従者","じゅうしゃ"],["は"],["ラモト"],["‧"],["ギレアド"],["に"],["行った","いった"],["。"]]},{"verse":5,"text":"彼がそこに着くと、軍の長たちが席に着いていた。彼が、「将軍、あなたに申し上げたいことがあります」と言うと、イエフは、「我々のうちの誰に対してか」と聞き返した。彼は、「将軍、あなたに対してです」と答えた。","tok":[["彼","かれ"],["が"],["そこ"],["に"],["着く","つく"],["と"],["、"],["軍","ぐん"],["の"],["長","なが"],["たち"],["が"],["席","せき"],["に"],["着いて","ついて"],["いた"],["。"],["彼","かれ"],["が"],["、"],["「"],["将軍","しょうぐん"],["、"],["あなた"],["に"],["申し上げたい","もうしあげたい"],["こと"],["が"],["あります"],["」"],["と"],["言う","ゆう"],["と"],["、"],["イエフ"],["は"],["、"],["「"],["我々","われわれ"],["の"],["うち"],["の"],["誰","だれ"],["に対して","にたいして"],["か"],["」"],["と"],["聞き返した","ききかえした"],["。"],["彼","かれ"],["は"],["、"],["「"],["将軍","しょうぐん"],["、"],["あなた"],["に対して","にたいして"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":6,"text":"イエフは立って家に入って来た。若者は彼の頭に油を注いで言った。「イスラエルの神、主はこう言われる。『わたしはあなたに油を注ぎ、あなたを主の民イスラエルの王とする。","tok":[["イエフ"],["は"],["立って","たって"],["家","いえ"],["に"],["入って","はいって"],["来た","きた"],["。"],["若者","わかもの"],["は"],["彼","かれ"],["の"],["頭","あたま"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["あなた"],["を"],["主","ぬし"],["の"],["民","みん"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["。"]]},{"verse":7,"text":"あなたはあなたの主君アハブの家を撃たねばならない。こうしてわたしはイゼベルの手にかかったわたしの僕たち、預言者たちの血、すべての主の僕たちの血の復讐をする。","tok":[["あなた"],["は"],["あなた"],["の"],["主君","しゅくん"],["アハブ"],["の"],["家","いえ"],["を"],["撃たねば","うたねば"],["ならない"],["。"],["こう"],["して"],["わたし"],["は"],["イゼベル"],["の"],["手","て"],["に"],["かかった"],["わたし"],["の"],["僕たち","ぼくたち"],["、"],["預言者","よげんしゃ"],["たち"],["の"],["血","ち"],["、"],["すべて"],["の"],["主","ぬし"],["の"],["僕たち","ぼくたち"],["の"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["。"]]},{"verse":8,"text":"アハブの家は全滅する。わたしは、イスラエルにおいて縛られている者も解き放たれている者も、アハブに属する男子をすべて絶ち滅ぼし、","tok":[["アハブ"],["の"],["家","いえ"],["は"],["全滅","ぜんめつ"],["する"],["。"],["わたし"],["は"],["、"],["イスラエル"],["に"],["おいて"],["縛られて","しばられて"],["いる"],["者","もの"],["も"],["解き放たれて","ときはなたれて"],["いる"],["者","もの"],["も"],["、"],["アハブ"],["に"],["属する","ぞくする"],["男子","だんし"],["を"],["すべて"],["絶ち","たち"],["滅ぼし","ほろぼし"],["、"]]},{"verse":9,"text":"アハブの家をネバトの子ヤロブアムの家のようにし、アヒヤの子バシャの家のようにする。","tok":[["アハブ"],["の"],["家","いえ"],["を"],["ネバト"],["の"],["子","こ"],["ヤロブアム"],["の"],["家","いえ"],["の"],["よう"],["に"],["し"],["、"],["アヒヤ"],["の"],["子","こ"],["バシャ"],["の"],["家","いえ"],["の"],["よう"],["に"],["する"],["。"]]},{"verse":10,"text":"犬がイズレエルの所有地でイゼベルを食い、彼女を葬る者はいない。』」彼は戸を開けて逃げ去った。","tok":[["犬","いぬ"],["が"],["イズレエル"],["の"],["所有地","しょゆうち"],["で"],["イゼベル"],["を"],["食い","くい"],["、"],["彼女","かのじょ"],["を"],["葬る","ほうむる"],["者","もの"],["は"],["いない"],["。"],["』"],["」"],["彼","かれ"],["は"],["戸","と"],["を"],["開けて","あけて"],["逃げ去った","にげさった"],["。"]]},{"verse":11,"text":"イエフが主君の家臣たちのところに出て行くと、彼らは、「どうだった。なぜあの狂った男があなたを訪ねて来たのか」と聞いた。イエフは、「あの男が誰で、何を言ったのか、あなたたちには分かっているはずだ」と答えたが、","tok":[["イエフ"],["が"],["主君","しゅくん"],["の"],["家臣","かしん"],["たち"],["の"],["ところ"],["に"],["出て","でて"],["行く","いく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["どう"],["だった"],["。"],["なぜ"],["あの"],["狂った","くるった"],["男","おとこ"],["が"],["あなた"],["を"],["訪ねて","たずねて"],["来た","きた"],["の"],["か"],["」"],["と"],["聞いた","きいた"],["。"],["イエフ"],["は"],["、"],["「"],["あの"],["男","おとこ"],["が"],["誰","だれ"],["で"],["、"],["何","なん"],["を"],["言った","いった"],["の"],["か"],["、"],["あなた"],["たち"],["に"],["は"],["分かって","わかって"],["いる"],["はず"],["だ"],["」"],["と"],["答えた","こたえた"],["が"],["、"]]},{"verse":12,"text":"彼らは言った。「それは違う。我々によく説明してくれ。」そこで彼は言った。「あの男はわたしにこのように告げた。『主はこう言われる。わたしはあなたに油を注ぎ、あなたをイスラエルの王とする。』」","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["それ"],["は"],["違う","ちがう"],["。"],["我々","われわれ"],["に"],["よく"],["説明","せつめい"],["して"],["くれ"],["。"],["」"],["そこ"],["で"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["あの"],["男","おとこ"],["は"],["わたし"],["に"],["この"],["よう"],["に"],["告げた","つげた"],["。"],["『"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["あなた"],["に"],["油","あぶら"],["を"],["注ぎ","そそぎ"],["、"],["あなた"],["を"],["イスラエル"],["の"],["王","おう"],["と"],["する"],["。"],["』"],["」"]]},{"verse":13,"text":"彼らはおのおの急いで上着を脱ぎ、階段の上にいた彼の足もとに敷き、角笛を吹いて、「イエフが王になった」と宣言した。","tok":[["彼","かれ"],["ら"],["は"],["おのおの"],["急いで","いそいで"],["上着","うわぎ"],["を"],["脱ぎ","ぬぎ"],["、"],["階段","かいだん"],["の"],["上","うえ"],["に"],["いた"],["彼","かれ"],["の"],["足もと","あしもと"],["に"],["敷き","しき"],["、"],["角笛","つのぶえ"],["を"],["吹いて","ふいて"],["、"],["「"],["イエフ"],["が"],["王","おう"],["に"],["なった"],["」"],["と"],["宣言","せんげん"],["した"],["。"]]},{"verse":14,"text":"ニムシの孫でヨシャファトの子であるイエフは、ヨラムに対して謀反を起こした。――ヨラムは全イスラエルを率い、アラムの王ハザエルに対して、ラモト‧ギレアドの防衛に当たったが、","tok":[["ニムシ"],["の"],["孫","まご"],["で"],["ヨシャファト"],["の"],["子","こ"],["で"],["ある"],["イエフ"],["は"],["、"],["ヨラム"],["に対して","にたいして"],["謀反","むほん"],["を"],["起こした","おこした"],["。"],["―"],["―"],["ヨラム"],["は"],["全","ぜん"],["イスラエル"],["を"],["率い","ひきい"],["、"],["アラム"],["の"],["王","おう"],["ハザエル"],["に対して","にたいして"],["、"],["ラモト"],["‧"],["ギレアド"],["の"],["防衛","ぼうえい"],["に"],["当たった","あたった"],["が"],["、"]]},{"verse":15,"text":"アラムの王ハザエルとの戦いでアラム兵に傷を負わされ、それをいやすためイズレエルに戻っていた。――イエフは言った。「もしあなたたちが本気でいるなら、だれもこの町を抜け出してイズレエルに知らせに行ってはならない。」","tok":[["アラム"],["の"],["王","おう"],["ハザエル"],["と"],["の"],["戦い","たたかい"],["で"],["アラム"],["兵","へい"],["に"],["傷","きず"],["を"],["負わされ","おわされ"],["、"],["それ"],["を"],["いやす"],["ため"],["イズレエル"],["に"],["戻って","もどって"],["いた"],["。"],["―"],["―"],["イエフ"],["は"],["言った","いった"],["。"],["「"],["もし"],["あなた"],["たち"],["が"],["本気","ほんき"],["で"],["いるなら"],["、"],["だれ"],["も"],["この"],["町","まち"],["を"],["抜け出して","ぬけだして"],["イズレエル"],["に"],["知らせ","しらせ"],["に"],["行って","いって"],["は"],["ならない"],["。"],["」"]]},{"verse":16,"text":"それから、イエフは戦車に乗ってイズレエルに向かった。ヨラムがそこで床に伏していたからである。またユダの王アハズヤがヨラムを見舞いに下って来ていた。","tok":[["それ"],["から"],["、"],["イエフ"],["は"],["戦車","せんしゃ"],["に"],["乗って","のって"],["イズレエル"],["に"],["向かった","むかった"],["。"],["ヨラム"],["が"],["そこ"],["で"],["床","ゆか"],["に"],["伏して","ふして"],["いた"],["から"],["で"],["ある"],["。"],["また"],["ユダ"],["の"],["王","おう"],["アハズヤ"],["が"],["ヨラム"],["を"],["見舞い","みまい"],["に"],["下って","くだって"],["来て","きて"],["いた"],["。"]]},{"verse":17,"text":"イズレエルの塔の上には見張りが立っていたが、イエフの軍勢が近づいて来るのを見て、「軍勢が見えます」と言った。ヨラムは、「騎兵を一人選んで迎えに行かせ、道中無事だったか、尋ねさせよ」と命じた。","tok":[["イズレエル"],["の"],["塔","とう"],["の"],["上","うえ"],["に"],["は"],["見張り","みはり"],["が"],["立って","たって"],["いた"],["が"],["、"],["イエフ"],["の"],["軍勢","ぐんぜい"],["が"],["近づいて","ちかづいて"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["「"],["軍勢","ぐんぜい"],["が"],["見えます","みえます"],["」"],["と"],["言った","いった"],["。"],["ヨラム"],["は"],["、"],["「"],["騎兵","きへい"],["を"],["一人","ひとり"],["選んで","えらんで"],["迎え","むかえ"],["に"],["行かせ","いかせ"],["、"],["道中","どうちゅう"],["無事","ぶじ"],["だった"],["か"],["、"],["尋ねさせよ","たずねさせよ"],["」"],["と"],["命じた","めいじた"],["。"]]},{"verse":18,"text":"騎兵は迎えに行って、「王が、道中御無事でしたかと尋ねておられます」と伝えた。しかしイエフは、「道中無事であったかどうか、お前と何のかかわりがあるのか。わたしの後ろにまわれ」と言った。一方、見張りは、「使いの者は彼らのところに行ったまま帰って来ません」と知らせた。","tok":[["騎兵","きへい"],["は"],["迎え","むかえ"],["に"],["行って","いって"],["、"],["「"],["王","おう"],["が"],["、"],["道中","どうちゅう"],["御無事","ごぶじ"],["でした"],["か"],["と"],["尋ねて","たずねて"],["おられます"],["」"],["と"],["伝えた","つたえた"],["。"],["しかし"],["イエフ"],["は"],["、"],["「"],["道中","どうちゅう"],["無事","ぶじ"],["で"],["あった"],["か"],["どう"],["か"],["、"],["お前","おまえ"],["と"],["何","なん"],["の"],["かかわり"],["が"],["ある"],["の"],["か"],["。"],["わたし"],["の"],["後ろ","うしろ"],["に"],["まわれ"],["」"],["と"],["言った","いった"],["。"],["一方","いっぽう"],["、"],["見張り","みはり"],["は"],["、"],["「"],["使い","つかい"],["の"],["者","もの"],["は"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["行った","いった"],["まま"],["帰って","かえって"],["来ません","きません"],["」"],["と"],["知らせた","しらせた"],["。"]]},{"verse":19,"text":"ヨラムは騎兵をもう一人遣わした。彼も彼らのところに行って、「王が、道中御無事でしたかと尋ねておられます」と伝えた。しかし、イエフは、「道中無事であったかどうか、お前と何のかかわりがあるのか。わたしの後ろにまわれ」と言った。","tok":[["ヨラム"],["は"],["騎兵","きへい"],["を"],["もう"],["一人","ひとり"],["遣わした","つかわした"],["。"],["彼","かれ"],["も"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["行って","いって"],["、"],["「"],["王","おう"],["が"],["、"],["道中","どうちゅう"],["御無事","ごぶじ"],["でした"],["か"],["と"],["尋ねて","たずねて"],["おられます"],["」"],["と"],["伝えた","つたえた"],["。"],["しかし"],["、"],["イエフ"],["は"],["、"],["「"],["道中","どうちゅう"],["無事","ぶじ"],["で"],["あった"],["か"],["どう"],["か"],["、"],["お前","おまえ"],["と"],["何","なん"],["の"],["かかわり"],["が"],["ある"],["の"],["か"],["。"],["わたし"],["の"],["後ろ","うしろ"],["に"],["まわれ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"見張りはまた、「彼らのところに行ったまま帰って来ません。あの戦車の走らせ方はニムシの子イエフの走らせ方と似ています。狂ったように走らせているからです」と報告した。","tok":[["見張り","みはり"],["は"],["また"],["、"],["「"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["行った","いった"],["まま"],["帰って","かえって"],["来ません","きません"],["。"],["あの"],["戦車","せんしゃ"],["の"],["走らせ","はしらせ"],["方","かた"],["は"],["ニムシ"],["の"],["子","こ"],["イエフ"],["の"],["走らせ","はしらせ"],["方","かた"],["と"],["似て","にて"],["います"],["。"],["狂った","くるった"],["よう"],["に"],["走らせて","はしらせて"],["いる"],["から"],["です"],["」"],["と"],["報告","ほうこく"],["した"],["。"]]},{"verse":21,"text":"ヨラムは、「馬をつなげ」と命じた。戦車に馬がつながれると、イスラエルの王ヨラムとユダの王アハズヤは、そ
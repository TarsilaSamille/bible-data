[{"verse":1,"text":"ダレイオスの治世第一年のことである。ダレイオスはメディア出身で、クセルクセスの子であり、カルデア人の国を治めていた。","tok":[["ダレイオス"],["の"],["治世","ちせい"],["第","だい"],["一","いち"],["年","ねん"],["の"],["こと"],["で"],["ある"],["。"],["ダレイオス"],["は"],["メディア"],["出身","しゅっしん"],["で"],["、"],["クセルクセス"],["の"],["子","こ"],["で"],["あり"],["、"],["カルデア"],["人","にん"],["の"],["国","くに"],["を"],["治めて","おさめて"],["いた"],["。"]]},{"verse":2,"text":"さて、わたしダニエルは文書を読んでいて、エルサレムの荒廃の時が終わるまでには、主が預言者エレミヤに告げられたように七十年という年数のあることを悟った。","tok":[["さて"],["、"],["わたし"],["ダニエル"],["は"],["文書","ぶんしょ"],["を"],["読んで","よんで"],["いて"],["、"],["エルサレム"],["の"],["荒廃","こうはい"],["の"],["時","とき"],["が"],["終わる","おわる"],["まで"],["に"],["は"],["、"],["主","ぬし"],["が"],["預言者","よげんしゃ"],["エレミヤ"],["に"],["告げられた","つげられた"],["よう"],["に"],["七十","ななじゅう"],["年","ねん"],["と"],["いう"],["年数","ねんすう"],["の"],["ある"],["こと"],["を"],["悟った","さとった"],["。"]]},{"verse":3,"text":"わたしは主なる神を仰いで断食し、粗布をまとい、灰をかぶって祈りをささげ、嘆願した。","tok":[["わたし"],["は"],["主","おも"],["なる"],["神","かみ"],["を"],["仰いで","あおいで"],["断食","だんじき"],["し"],["、"],["粗布","そふ"],["を"],["まとい"],["、"],["灰","はい"],["を"],["かぶって"],["祈り","いのり"],["を"],["ささげ"],["、"],["嘆願","たんがん"],["した"],["。"]]},{"verse":4,"text":"わたしは主なる神に祈り、罪を告白してこう言った。「主よ、畏るべき偉大な神よ、主を愛しその戒めに従う者には契約を守って慈しみを施される神よ、","tok":[["わたし"],["は"],["主","おも"],["なる"],["神","かみ"],["に"],["祈り","いのり"],["、"],["罪","つみ"],["を"],["告白","こくはく"],["して"],["こう"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["畏るべき","かしこまるべき"],["偉大","いだい"],["な"],["神","かみ"],["よ"],["、"],["主","ぬし"],["を"],["愛し","あいし"],["その"],["戒め","いましめ"],["に"],["従う","したがう"],["者","もの"],["に"],["は"],["契約","けいやく"],["を"],["守って","まもって"],["慈しみ","いつくしみ"],["を"],["施される","ほどこされる"],["神","かみ"],["よ"],["、"]]},{"verse":5,"text":"わたしたちは罪を犯し悪行を重ね、背き逆らって、あなたの戒めと裁きから離れ去りました。","tok":[["わたしたち"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["悪行","あくぎょう"],["を"],["重ね","かさね"],["、"],["背き","そむき"],["逆らって","さからって"],["、"],["あなた"],["の"],["戒め","いましめ"],["と"],["裁き","さばき"],["から"],["離れ去りました","はなれさりました"],["。"]]},{"verse":6,"text":"あなたの僕である預言者たちが、御名によってわたしたちの王、指導者、父祖、そして地の民のすべてに語ったのに、それに聞き従いませんでした。","tok":[["あなた"],["の"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["が"],["、"],["御名","ぎょめい"],["によって"],["わたしたち"],["の"],["王","おう"],["、"],["指導者","しどうしゃ"],["、"],["父祖","ふそ"],["、"],["そして"],["地","ち"],["の"],["民","たみ"],["の"],["すべて"],["に"],["語った","かたった"],["のに"],["、"],["それ"],["に"],["聞き従いませんでした","ききしたがいませんでした"],["。"]]},{"verse":7,"text":"主よ、あなたは正しくいます。わたしたちユダの者、エルサレムの住民、すなわち、あなたに背いた罪のために全世界に散らされて、遠くにまた近くに住むイスラエルの民すべてが、今日のように恥を被っているのは当然なのです。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["正しく","ただしく"],["います"],["。"],["わたしたち"],["ユダ"],["の"],["者","もの"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["、"],["すなわち"],["、"],["あなた"],["に"],["背いた","そむいた"],["罪","つみ"],["の"],["ため"],["に"],["全","ぜん"],["世界","せかい"],["に"],["散らされて","ちらされて"],["、"],["遠く","とおく"],["に"],["また"],["近く","ちかく"],["に"],["住む","すむ"],["イスラエル"],["の"],["民","みん"],["すべて"],["が"],["、"],["今日","きょう"],["の"],["よう"],["に"],["恥","はじ"],["を"],["被って","かぶって"],["いる"],["の"],["は"],["当然","とうぜん"],["な"],["の"],["です"],["。"]]},{"verse":8,"text":"主よ、恥を被るのはわたしたちであり、その王、指導者、父祖なのです。あなたに対して罪を犯したのですから。","tok":[["主","ぬし"],["よ"],["、"],["恥","はじ"],["を"],["被る","こうむる"],["の"],["は"],["わたしたち"],["で"],["あり"],["、"],["その"],["王","おう"],["、"],["指導者","しどうしゃ"],["、"],["父祖","ふそ"],["な"],["の"],["です"],["。"],["あなた"],["に対して","にたいして"],["罪","つみ"],["を"],["犯した","おかした"],["の"],["です"],["から"],["。"]]},{"verse":9,"text":"憐れみと赦しは主である神のもの。わたしたちは神に背きました。","tok":[["憐れみ","あわれみ"],["と"],["赦し","ゆるし"],["は"],["主","ぬし"],["で"],["ある"],["神","かみ"],["の"],["もの"],["。"],["わたしたち"],["は"],["神","かみ"],["に"],["背きました","そむきました"],["。"]]},{"verse":10,"text":"あなたの僕である預言者たちを通して与えられた、律法に従って歩むようにという主なる神の声に聞き従いませんでした。","tok":[["あなた"],["の"],["僕","ぼく"],["で"],["ある"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["与えられた","あたえられた"],["、"],["律法","りっぽう"],["に"],["従って","したがって"],["歩む","あゆむ"],["よう"],["に"],["と"],["いう"],["主","ぬし"],["なる"],["神","かみ"],["の"],["声","こえ"],["に"],["聞き従いませんでした","ききしたがいませんでした"],["。"]]},{"verse":11,"text":"イスラエルはすべて、あなたの律法を無視し、御声に耳を傾けませんでした。ですから、神の僕モーセの律法に記されている誓いの呪いが、わたしたちの上にふりかかってきたのです。あなたに対して罪を犯したからにほかなりません。","tok":[["イスラエル"],["は"],["すべて"],["、"],["あなた"],["の"],["律法","りっぽう"],["を"],["無視","むし"],["し"],["、"],["御声","おこえ"],["に"],["耳","みみ"],["を"],["傾けませんでした","かたむけませんでした"],["。"],["です"],["から"],["、"],["神","かみ"],["の"],["僕","ぼく"],["モーセ"],["の"],["律法","りっぽう"],["に"],["記されて","しるされて"],["いる"],["誓い","ちかい"],["の"],["呪い","のろい"],["が"],["、"],["わたしたち"],["の"],["上","うえ"],["に"],["ふりかかって"],["きた"],["の"],["です"],["。"],["あなた"],["に対して","にたいして"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["に"],["ほか"],["なりません"],["。"]]},{"verse":12,"text":"わたしたちにも、わたしたちを治めた指導者にも告げられていた主の御言葉は成就し、恐ろしい災難が襲いました。エルサレムに下されたこの災難ほど恐ろしいものは、いまだ天下に起こったことはありませんでした。","tok":[["わたしたち"],["に"],["も"],["、"],["わたしたち"],["を"],["治めた","おさめた"],["指導者","しどうしゃ"],["に"],["も"],["告げられて","つげられて"],["いた"],["主","ぬし"],["の"],["御言葉","おことば"],["は"],["成就","じょうじゅ"],["し"],["、"],["恐ろしい","おそろしい"],["災難","さいなん"],["が"],["襲いました","おそいました"],["。"],["エルサレム"],["に"],["下された","くだされた"],["この"],["災難","さいなん"],["ほど"],["恐ろしい","おそろしい"],["もの"],["は"],["、"],["いまだ"],["天下","てんか"],["に"],["起こった","おこった"],["こと"],["は"],["ありませんでした"],["。"]]},{"verse":13,"text":"モーセの律法に記されているこの恐ろしい災難は、紛れもなくわたしたちを襲いました。それでもなお、わたしたちは罪を離れて主なる神の怒りをなだめることをせず、またあなたのまことに目覚めることもできませんでした。","tok":[["モーセ"],["の"],["律法","りっぽう"],["に"],["記されて","しるされて"],["いる"],["この"],["恐ろしい","おそろしい"],["災難","さいなん"],["は"],["、"],["紛れ","まぎれ"],["も"],["なく"],["わたしたち"],["を"],["襲いました","おそいました"],["。"],["それ"],["で"],["も"],["なお"],["、"],["わたしたち"],["は"],["罪","つみ"],["を"],["離れて","はなれて"],["主","おも"],["なる"],["神","かみ"],["の"],["怒り","いかり"],["を"],["なだめる"],["こと"],["を"],["せず"],["、"],["また"],["あなた"],["の"],["まこと"],["に"],["目覚める","めざめる"],["こと"],["も"],["できませんでした"],["。"]]},{"verse":14,"text":"主はその悪を見張っておられ、それをわたしたちの上に下されました。わたしたちの主なる神のなさることはすべて正しく、それに対して、わたしたちは御声に聞き従いませんでした。","tok":[["主","ぬし"],["は"],["その"],["悪","あく"],["を"],["見張って","みはって"],["おられ"],["、"],["それ"],["を"],["わたしたち"],["の"],["上","うえ"],["に"],["下されました","くだされました"],["。"],["わたしたち"],["の"],["主","ぬし"],["なる"],["神","かみ"],["の"],["なさる"],["こと"],["は"],["すべて"],["正しく","ただしく"],["、"],["それ"],["に対して","にたいして"],["、"],["わたしたち"],["は"],["御声","おこえ"],["に"],["聞き従いませんでした","ききしたがいませんでした"],["。"]]},{"verse":15,"text":"わたしたちの神である主よ、強い御手をもって民をエジプトから導き出し、今日に至る名声を得られた神よ、わたしたちは罪を犯し、逆らいました。","tok":[["わたしたち"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["よ"],["、"],["強い","つよい"],["御手","おて"],["を"],["もって"],["民","みん"],["を"],["エジプト"],["から"],["導き出し","みちびきだし"],["、"],["今日","きょう"],["に"],["至る","いたる"],["名声","めいせい"],["を"],["得られた","えられた"],["神","かみ"],["よ"],["、"],["わたしたち"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["逆らいました","さからいました"],["。"]]},{"verse":16,"text":"主よ、常に変わらぬ恵みの御業をもってあなたの都、聖なる山エルサレムからあなたの怒りと憤りを翻してください。わたしたちの罪と父祖の悪行のために、エルサレムもあなたの民も、近隣の民すべてから嘲られています。","tok":[["主","ぬし"],["よ"],["、"],["常","つね"],["に"],["変わらぬ","かわらぬ"],["恵み","めぐみ"],["の"],["御業","ごごう"],["を"],["もって"],["あなた"],["の"],["都","と"],["、"],["聖","せい"],["なる"],["山","やま"],["エルサレム"],["から"],["あなた"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["を"],["翻して","ひるがえして"],["ください"],["。"],["わたしたち"],["の"],["罪","つみ"],["と"],["父祖","ふそ"],["の"],["悪行","あくぎょう"],["の"],["ため"],["に"],["、"],["エルサレム"],["も"],["あなた"],["の"],["民","たみ"],["も"],["、"],["近隣","きんりん"],["の"],["民","みん"],["すべて"],["から"],["嘲られて","あざけられて"],["います"],["。"]]},{"verse":17,"text":"わたしたちの神よ、僕の祈りと嘆願に耳を傾けて、荒廃した聖所に主御自身のために御顔の光を輝かしてください。","tok":[["わたしたち"],["の"],["神","かみ"],["よ"],["、"],["僕","ぼく"],["の"],["祈り","いのり"],["と"],["嘆願","たんがん"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["、"],["荒廃","こうはい"],["した"],["聖所","しょうしょ"],["に"],["主","ぬし"],["御自身","ごじしん"],["の"],["ため"],["に"],["御顔","おかお"],["の"],["光","ひかり"],["を"],["輝かして","かがやかして"],["ください"],["。"]]},{"verse":18,"text":"神よ、耳を傾けて聞いてください。目を開いて、わたしたちの荒廃と、御名をもって呼ばれる都の荒廃とを御覧ください。わたしたちが正しいからではなく、あなたの深い憐れみのゆえに、伏して嘆願の祈りをささげます。","tok":[["神","かみ"],["よ"],["、"],["耳","みみ"],["を"],["傾けて","かたむけて"],["聞いて","きいて"],["ください"],["。"],["目","め"],["を"],["開いて","ひらいて"],["、"],["わたしたち"],["の"],["荒廃","こうはい"],["と"],["、"],["御名","ぎょめい"],["を"],["もって"],["呼ばれる","よばれる"],["都","と"],["の"],["荒廃","こうはい"],["と"],["を"],["御覧","ごらん"],["ください"],["。"],["わたしたち"],["が"],["正しい","ただしい"],["から"],["で"],["は"],["なく"],["、"],["あなた"],["の"],["深い","ふかい"],["憐れみ","あわれみ"],["の"],["ゆえ"],["に"],["、"],["伏して","ふして"],["嘆願","たんがん"],["の"],["祈り","いのり"],["を"],["ささげます"],["。"]]},{"verse":19,"text":"主よ、聞いてください。主よ、お赦しください。主よ、耳を傾けて、お計らいください。わたしの神よ、御自身のために、救いを遅らせないでください。あなたの都、あなたの民は、御名をもって呼ばれているのですから。」","tok":[["主","ぬし"],["よ"],["、"],["聞いて","きいて"],["ください"],["。"],["主","ぬし"],["よ"],["、"],["お赦し","おゆるし"],["ください"],["。"],["主","ぬし"],["よ"],["、"],["耳","みみ"],["を"],["傾けて","かたむけて"],["、"],["お計らい","おはからい"],["ください"],["。"],["わたし"],["の"],["神","かみ"],["よ"],["、"],["御自身","ごじしん"],["の"],["ため"],["に"],["、"],["救い","すくい"],["を"],["遅らせないで","おくらせないで"],["ください"],["。"],["あなた"],["の"],["都","と"],["、"],["あなた"],["の"],["民","たみ"],["は"],["、"],["御名","ぎょめい"],["を"],["もって"],["呼ばれて","よばれて"],["いる"],["の"],["です"],["から"],["。"],["」"]]},{"verse":20,"text":"こうしてなお訴え、祈り、わたし自身とわたしの民イスラエルの罪を告白し、わたしの神の聖なる山について、主なるわたしの神に嘆願し続けた。","tok":[["こう"],["して"],["なお"],["訴え","うったえ"],["、"],["祈り","いのり"],["、"],["わたし"],["自身","じしん"],["と"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["罪","つみ"],["を"],["告白","こくはく"],["し"],["、"],["わたし"],["の"],["神","かみ"],["の"],["聖","せい"],["なる"],["山","やま"],["について"],["、"],["主","おも"],["なる"],["わたし"],["の"],["神","かみ"],["に"],["嘆願","たんがん"],["し"],["続けた","つづけた"],["。"]]},{"verse":21,"text":"こうして訴え祈っていると、先の幻で見た者、すなわちガブリエルが飛んで来て近づき、わたしに触れた。それは夕べの献げ物のころのことであった。","tok":[["こう"],["して"],["訴え","うったえ"],["祈って","いのって"],["いる"],["と"],["、"],["先","さき"],["の"],["幻","まぼろし"],["で"],["見た","みた"],["者","もの"],["、"],["すなわち"],["ガブリエル"],["が"],["飛んで","とんで"],["来て","きて"],["近づき","ちかづき"],["、"],["わたし"],["に"],["触れた","ふれた"],["。"],["それ"],["は"],["夕べ","ゆうべ"],["の"],["献げ物","ささげもの"],["の"],["ころ"],["の"],["こと"],["で"],["あった"],["。"]]},{"verse":22,"text":"彼は、わたしに理解させようとしてこう言った。「ダニエルよ、お前を目覚めさせるために来た。","tok":[["彼","かれ"],["は"],["、"],["わたし"],["に"],["理解","りかい"],["させよう"],["として"],["こう"],["言った","いった"],["。"],["「"],["ダニエル"],["よ"],["、"],["お前","おまえ"],["を"],["目覚めさせる","めざめさせる"],["ため"],["に"],["来た","きた"],["。"]]},{"verse":23,"text":"お前が嘆き祈り始めた時、御言葉が出されたので、それを告げに来た。お前は愛されている者なのだ。この御言葉を悟り、この幻を理解せよ。","tok":[["お前","おまえ"],["が"],["嘆き","なげき"],["祈り","いのり"],["始めた","はじめた"],["時","とき"],["、"],["御言葉","おことば"],["が"],["出された","だされた"],["ので"],["、"],["それ"],["を"],["告げ","つげ"],["に"],["来た","きた"],["。"],["お前","おまえ"],["は"],["愛されて","あいされて"],["いる"],["者","もの"],["な"],["の"],["だ"],["。"],["この"],["御言葉","おことば"],["を"],["悟り","さとり"],["、"],["この"],["幻","まぼろし"],["を"],["理解","りかい"],["せよ"],["。"]]},{"verse":24,"text":"お前の民と聖なる都に対して七十週が定められている。それが過ぎると逆らいは終わり罪は封じられ、不義は償われる。とこしえの正義が到来し幻と預言は封じられ最も聖なる者に油が注がれる。","tok":[["お前","おまえ"],["の"],["民","たみ"],["と"],["聖","せい"],["なる"],["都","と"],["に対して","にたいして"],["七十","ななじゅう"],["週","しゅう"],["が"],["定められて","さだめられて"],["いる"],["。"],["それ"],["が"],["過ぎる","すぎる"],["と"],["逆らい","さからい"],["は"],["終わり","おわり"],["罪","ざい"],["は"],["封じられ","ふうじられ"],["、"],["不義","ふぎ"],["は"],["償われる","つぐなわれる"],["。"],["とこしえ"],["の"],["正義","せいぎ"],["が"],["到来","とうらい"],["し"],["幻","まぼろし"],["と"],["預言","よげん"],["は"],["封じられ","ふうじられ"],["最も","もっとも"],["聖","せい"],["なる"],["者","もの"],["に"],["油","あぶら"],["が"],["注がれる","そそがれる"],["。"]]},{"verse":25,"text":"これを知り、目覚めよ。エルサレム復興と再建についての御言葉が出されてから油注がれた君の到来まで七週あり、また、六十二週あって危機のうちに広場と堀は再建される。","tok":[["これ"],["を"],["知り","しり"],["、"],["目覚め","めざめ"],["よ"],["。"],["エルサレム"],["復興","ふっこう"],["と"],["再建","さいけん"],["について"],["の"],["御言葉","おことば"],["が"],["出されて","だされて"],["から"],["油","あぶら"],["注がれた","そそがれた"],["君","きみ"],["の"],["到来","とうらい"],["まで"],["七","なな"],["週","しゅう"],["あり"],["、"],["また"],["、"],["六十二","ろくじゅうに"],["週","しゅう"],["あって"],["危機","きき"],["の"],["うち"],["に"],["広場","ひろば"],["と"],["堀","ほり"],["は"],["再建","さいけん"],["される"],["。"]]},{"verse":26,"text":"その六十二週のあと油注がれた者は 不当に断たれ都と聖所は次に来る指導者の民によって荒らされる。その終わりには洪水があり終わりまで戦いが続き荒廃は避けられない。","tok":[["その"],["六十二","ろくじゅうに"],["週","しゅう"],["の"],["あと"],["油","あぶら"],["注がれた","そそがれた"],["者","もの"],["は"],[" "],["不当","ふとう"],["に"],["断たれ","たたれ"],["都","と"],["と"],["聖","せい"],["所","しょ"],["は"],["次","つぎ"],["に"],["来る","くる"],["指導者","しどうしゃ"],["の"],["民","たみ"],["によって"],["荒らされる","あらされる"],["。"],["その"],["終わり","おわり"],["に"],["は"],["洪水","こうずい"],["が"],["あり"],["終わり","おわり"],["まで"],["戦い","たたかい"],["が"],["続き","つづき"],["荒廃","こうはい"],["は"],["避けられない","さけられない"],["。"]]},{"verse":27,"text":"彼は一週の間、多くの者と同盟を固め半週でいけにえと献げ物を廃止する。憎むべきものの翼の上に荒廃をもたらすものが座す。そしてついに、定められた破滅が荒廃の上に注がれる。」","tok":[["彼","かれ"],["は"],["一","いち"],["週","しゅう"],["の"],["間","あいだ"],["、"],["多く","おおく"],["の"],["者","もの"],["と"],["同盟","どうめい"],["を"],["固め","かため"],["半","はん"],["週","しゅう"],["で"],["いけにえ"],["と"],["献げ物","ささげもの"],["を"],["廃止","はいし"],["する"],["。"],["憎むべき","にくむべき"],["もの"],["の"],["翼","つばさ"],["の"],["上","うえ"],["に"],["荒廃","こうはい"],["を"],["もたらす"],["もの"],["が"],["座す","ざす"],["。"],["そして"],["ついに"],["、"],["定められた","さだめられた"],["破滅","はめつ"],["が"],["荒廃","こうはい"],["の"],["上","うえ"],["に"],["注がれる","そそがれる"],["。"],["」"]]}]
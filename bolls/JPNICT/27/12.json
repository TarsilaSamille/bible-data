[{"verse":1,"text":"その時、大天使長ミカエルが立つ。彼はお前の民の子らを守護する。その時まで、苦難が続く国が始まって以来、かつてなかったほどの苦難が。しかし、その時には救われるであろうお前の民、あの書に記された人々は。","tok":[["その"],["時","とき"],["、"],["大天使長","だいてんしちょう"],["ミカエル"],["が"],["立つ","たつ"],["。"],["彼","かれ"],["は"],["お前","おまえ"],["の"],["民","たみ"],["の"],["子","こ"],["ら"],["を"],["守護","しゅご"],["する"],["。"],["その"],["時","とき"],["まで"],["、"],["苦難","くなん"],["が"],["続く","つづく"],["国","くに"],["が"],["始まって","はじまって"],["以来","いらい"],["、"],["かつて"],["なかった"],["ほど"],["の"],["苦難","くなん"],["が"],["。"],["しかし"],["、"],["その"],["時","とき"],["に"],["は"],["救われるで","すくわれるで"],["あろう"],["お前","おまえ"],["の"],["民","たみ"],["、"],["あの"],["書","しょ"],["に"],["記された","しるされた"],["人々","ひとびと"],["は"],["。"]]},{"verse":2,"text":"多くの者が地の塵の中の眠りから目覚める。ある者は永遠の生命に入りある者は永久に続く恥と憎悪の的となる。","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["地","ち"],["の"],["塵","ごみ"],["の"],["中","なか"],["の"],["眠り","ねむり"],["から"],["目覚める","めざめる"],["。"],["ある"],["者","もの"],["は"],["永遠","えいえん"],["の"],["生命","せいめい"],["に"],["入り","はいり"],["ある"],["者","もの"],["は"],["永久","えいきゅう"],["に"],["続く","つづく"],["恥","はじ"],["と"],["憎悪","ぞうお"],["の"],["的","まと"],["と"],["なる"],["。"]]},{"verse":3,"text":"目覚めた人々は大空の光のように輝き多くの者の救いとなった人々はとこしえに星と輝く。","tok":[["目覚めた","めざめた"],["人々","ひとびと"],["は"],["大空","おおぞら"],["の"],["光","ひかり"],["の"],["よう"],["に"],["輝き","かがやき"],["多く","おおく"],["の"],["者","もの"],["の"],["救い","すくい"],["と"],["なった"],["人々","ひとびと"],["は"],["とこしえ"],["に"],["星","ほし"],["と"],["輝く","かがやく"],["。"]]},{"verse":4,"text":"ダニエルよ、終わりの時が来るまで、お前はこれらのことを秘め、この書を封じておきなさい。多くの者が動揺するであろう。そして、知識は増す。」","tok":[["ダニエル"],["よ"],["、"],["終わり","おわり"],["の"],["時","とき"],["が"],["来る","くる"],["まで"],["、"],["お前","おまえ"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["秘め","ひめ"],["、"],["この"],["書","しょ"],["を"],["封じて","ふうじて"],["おき"],["なさい"],["。"],["多く","おおく"],["の"],["者","もの"],["が"],["動揺","どうよう"],["するで"],["あろう"],["。"],["そして"],["、"],["知識","ちしき"],["は"],["増す","ます"],["。"],["」"]]},{"verse":5,"text":"わたしダニエルは、なお眺め続けていると、見よ、更に二人の人が、川の両岸に一人ずつ立っているのが見えた。","tok":[["わたし"],["ダニエル"],["は"],["、"],["なお"],["眺め","ながめ"],["続けて","つづけて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["更に","さらに"],["二人","ふたり"],["の"],["人","ひと"],["が"],["、"],["川","かわ"],["の"],["両岸","りょうがん"],["に"],["一人","ひとり"],["ずつ"],["立って","たって"],["いる"],["の"],["が"],["見えた","みえた"],["。"]]},{"verse":6,"text":"その一人が、川の流れの上に立つ、あの麻の衣を着た人に向かって、「これらの驚くべきことはいつまで続くのでしょうか」と尋ねた。","tok":[["その"],["一人","ひとり"],["が"],["、"],["川","かわ"],["の"],["流れ","ながれ"],["の"],["上","うえ"],["に"],["立つ","たつ"],["、"],["あの"],["麻","あさ"],["の"],["衣","ころも"],["を"],["着た","きた"],["人","ひと"],["に"],["向かって","むかって"],["、"],["「"],["これ"],["ら"],["の"],["驚くべき","おどろくべき"],["こと"],["は"],["いつ"],["まで"],["続く","つづく"],["の"],["でしょう"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":7,"text":"すると、川の流れの上に立つ、あの麻の衣を着た人が、左右の手を天に差し伸べ、永遠に生きるお方によってこう誓うのが聞こえた。「一時期、二時期、そして半時期たって、聖なる民の力が全く打ち砕かれると、これらの事はすべて成就する。」","tok":[["する"],["と"],["、"],["川","かわ"],["の"],["流れ","ながれ"],["の"],["上","うえ"],["に"],["立つ","たつ"],["、"],["あの"],["麻","あさ"],["の"],["衣","ころも"],["を"],["着た","きた"],["人","ひと"],["が"],["、"],["左右","さゆう"],["の"],["手","て"],["を"],["天","てん"],["に"],["差し伸べ","さしのべ"],["、"],["永遠","えいえん"],["に"],["生きる","いきる"],["お方","おかた"],["によって"],["こう"],["誓う","ちかう"],["の"],["が"],["聞こえた","きこえた"],["。"],["「"],["一時期","いちじき"],["、"],["二","に"],["時期","じき"],["、"],["そして"],["半","はん"],["時期","じき"],["たって"],["、"],["聖","せい"],["なる"],["民","たみ"],["の"],["力","ちから"],["が"],["全く","まったく"],["打ち砕かれる","うちくだかれる"],["と"],["、"],["これ"],["ら"],["の"],["事","こと"],["は"],["すべて"],["成就","じょうじゅ"],["する"],["。"],["」"]]},{"verse":8,"text":"こう聞いてもわたしには理解できなかったので、尋ねた。「主よ、これらのことの終わりはどうなるのでしょうか。」","tok":[["こう"],["聞いて","きいて"],["も"],["わたし"],["に"],["は"],["理解","りかい"],["できなかった"],["ので"],["、"],["尋ねた","たずねた"],["。"],["「"],["主","ぬし"],["よ"],["、"],["これ"],["ら"],["の"],["こと"],["の"],["終わり","おわり"],["は"],["どう"],["なる"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":9,"text":"彼は答えた。「ダニエルよ、もう行きなさい。終わりの時までこれらの事は秘められ、封じられている。","tok":[["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["ダニエル"],["よ"],["、"],["もう"],["行き","いき"],["なさい"],["。"],["終わり","おわり"],["の"],["時","とき"],["まで"],["これ"],["ら"],["の"],["事","こと"],["は"],["秘められ","ひめられ"],["、"],["封じられて","ふうじられて"],["いる"],["。"]]},{"verse":10,"text":"多くの者は清められ、白くされ、練られる。逆らう者はなお逆らう。逆らう者はだれも悟らないが、目覚めた人々は悟る。","tok":[["多く","おおく"],["の"],["者","もの"],["は"],["清められ","きよめられ"],["、"],["白く","しろく"],["され"],["、"],["練られる","ねられる"],["。"],["逆らう","さからう"],["者","もの"],["は"],["なお"],["逆らう","さからう"],["。"],["逆らう","さからう"],["者","もの"],["は"],["だれ"],["も"],["悟らない","さとらない"],["が"],["、"],["目覚めた","めざめた"],["人々","ひとびと"],["は"],["悟る","さとる"],["。"]]},{"verse":11,"text":"日ごとの供え物が廃止され、憎むべき荒廃をもたらすものが立てられてから、千二百九十日が定められている。","tok":[["日ごと","ひごと"],["の"],["供え物","そなえもの"],["が"],["廃止","はいし"],["され"],["、"],["憎むべき","にくむべき"],["荒廃","こうはい"],["を"],["もたらす"],["もの"],["が"],["立てられて","たてられて"],["から"],["、"],["千二百九十","せんにひゃくきゅうとう"],["日","か"],["が"],["定められて","さだめられて"],["いる"],["。"]]},{"verse":12,"text":"待ち望んで千三百三十五日に至る者は、まことに幸いである。","tok":[["待ち望んで","まちのぞんで"],["千三百三十五","せんさんひゃくさんじゅうご"],["日","にち"],["に"],["至る","いたる"],["者","もの"],["は"],["、"],["まこと"],["に"],["幸い","さいわい"],["で"],["ある"],["。"]]},{"verse":13,"text":"終わりまでお前の道を行き、憩いに入りなさい。時の終わりにあたり、お前に定められている運命に従って、お前は立ち上がるであろう。」","tok":[["終わり","おわり"],["まで"],["お前","おまえ"],["の"],["道","みち"],["を"],["行き","いき"],["、"],["憩い","いこい"],["に"],["入り","はいり"],["なさい"],["。"],["時","じ"],["の"],["終わり","おわり"],["に"],["あたり"],["、"],["お前","おまえ"],["に"],["定められて","さだめられて"],["いる"],["運命","うんめい"],["に"],["従って","したがって"],["、"],["お前","おまえ"],["は"],["立ち上がるで","たちあがるで"],["あろう"],["。"],["」"]]}]
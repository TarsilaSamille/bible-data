[{"verse":1,"text":"ペルシアの王キュロスの治世第三年のことである。ベルテシャツァルと呼ばれるダニエルに一つの言葉が啓示された。この言葉は真実であり、理解するのは非常に困難であったが、幻のうちに、ダニエルに説明が与えられた。","tok":[["ペルシア"],["の"],["王","おう"],["キュロス"],["の"],["治世","ちせい"],["第","だい"],["三","さん"],["年","ねん"],["の"],["こと"],["で"],["ある"],["。"],["ベルテシャツァル"],["と"],["呼ばれる","よばれる"],["ダニエル"],["に"],["一","ひと"],["つ"],["の"],["言葉","ことば"],["が"],["啓示","けいじ"],["された"],["。"],["この"],["言葉","ことば"],["は"],["真実","しんじつ"],["で"],["あり"],["、"],["理解","りかい"],["する"],["の"],["は"],["非常","ひじょう"],["に"],["困難","こんなん"],["で"],["あった"],["が"],["、"],["幻","まぼろし"],["の"],["うち"],["に"],["、"],["ダニエル"],["に"],["説明","せつめい"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":2,"text":"そのころわたしダニエルは、三週間にわたる嘆きの祈りをしていた。","tok":[["その"],["ころ"],["わたし"],["ダニエル"],["は"],["、"],["三","さん"],["週間","しゅうかん"],["に"],["わたる"],["嘆き","なげき"],["の"],["祈り","いのり"],["を"],["して"],["いた"],["。"]]},{"verse":3,"text":"その三週間は、一切の美食を遠ざけ、肉も酒も口にせず、体には香油も塗らなかった。","tok":[["その"],["三","さん"],["週間","しゅうかん"],["は"],["、"],["一切","いっさい"],["の"],["美食","びしょく"],["を"],["遠ざけ","とおざけ"],["、"],["肉","にく"],["も"],["酒","さけ"],["も"],["口","くち"],["に"],["せず"],["、"],["体","からだ"],["に"],["は"],["香油","こうゆ"],["も"],["塗らなかった","ぬらなかった"],["。"]]},{"verse":4,"text":"一月二十四日のこと、チグリスという大河の岸にわたしはいた。","tok":[["一","いち"],["月","がつ"],["二十四日","にじゅうよんか"],["の"],["こと"],["、"],["チグリス"],["と"],["いう"],["大河","たいが"],["の"],["岸","きし"],["に"],["わたし"],["は"],["いた"],["。"]]},{"verse":5,"text":"目を上げて眺めると、見よ、一人の人が麻の衣を着、純金の帯を腰に締めて立っていた。","tok":[["目","め"],["を"],["上げて","あげて"],["眺める","ながめる"],["と"],["、"],["見よ","みよ"],["、"],["一人","ひとり"],["の"],["人","ひと"],["が"],["麻","あさ"],["の"],["衣","ころも"],["を"],["着","き"],["、"],["純金","じゅんきん"],["の"],["帯","おび"],["を"],["腰","こし"],["に"],["締めて","しめて"],["立って","たって"],["いた"],["。"]]},{"verse":6,"text":"体は宝石のようで、顔は稲妻のよう、目は松明の炎のようで、腕と足は磨かれた青銅のよう、話す声は大群衆の声のようであった。","tok":[["体","からだ"],["は"],["宝石","ほうせき"],["の"],["よう"],["で"],["、"],["顔","かお"],["は"],["稲妻","いなずま"],["の"],["よう"],["、"],["目","め"],["は"],["松明","たいまつ"],["の"],["炎","ほのお"],["の"],["よう"],["で"],["、"],["腕","うで"],["と"],["足","あし"],["は"],["磨かれた","みがかれた"],["青銅","せいどう"],["の"],["よう"],["、"],["話す","はなす"],["声","こえ"],["は"],["大","だい"],["群衆","ぐんしゅう"],["の"],["声","こえ"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":7,"text":"この幻を見たのはわたしダニエルひとりであって、共にいた人々は何も見なかったのだが、強い恐怖に襲われて逃げ出し、隠れてしまった。","tok":[["この"],["幻","まぼろし"],["を"],["見た","みた"],["の"],["は"],["わたし"],["ダニエル"],["ひとり"],["で"],["あって"],["、"],["共","とも"],["に"],["いた"],["人々","ひとびと"],["は"],["何","なん"],["も"],["見なかった","みなかった"],["の"],["だ"],["が"],["、"],["強い","つよい"],["恐怖","きょうふ"],["に"],["襲われて","おそわれて"],["逃げ出し","にげだし"],["、"],["隠れて","かくれて"],["しまった"],["。"]]},{"verse":8,"text":"わたしはひとり残ってその壮大な幻を眺めていたが、力が抜けていき、姿は変わり果てて打ちのめされ、気力を失ってしまった。","tok":[["わたし"],["は"],["ひとり"],["残って","のこって"],["その"],["壮大","そうだい"],["な"],["幻","まぼろし"],["を"],["眺めて","ながめて"],["いた"],["が"],["、"],["力","ちから"],["が"],["抜けて","ぬけて"],["いき"],["、"],["姿","すがた"],["は"],["変わり","かわり"],["果てて","はてて"],["打ちのめされ","うちのめされ"],["、"],["気力","きりょく"],["を"],["失って","うしなって"],["しまった"],["。"]]},{"verse":9,"text":"その人の話す声が聞こえてきたが、わたしは聞きながら意識を失い、地に倒れた。","tok":[["その"],["人","ひと"],["の"],["話す","はなす"],["声","こえ"],["が"],["聞こえて","きこえて"],["きた"],["が"],["、"],["わたし"],["は"],["聞き","きき"],["ながら"],["意識","いしき"],["を"],["失い","うしない"],["、"],["地","ち"],["に"],["倒れた","たおれた"],["。"]]},{"verse":10,"text":"突然、一つの手がわたしに触れて引き起こしたので、わたしは手と膝をついた。","tok":[["突然","とつぜん"],["、"],["一","ひと"],["つ"],["の"],["手","て"],["が"],["わたし"],["に"],["触れて","ふれて"],["引き起こした","ひきおこした"],["ので"],["、"],["わたし"],["は"],["手","て"],["と"],["膝","ひざ"],["を"],["ついた"],["。"]]},{"verse":11,"text":"彼はこう言った。「愛されている者ダニエルよ、わたしがお前に語ろうとする言葉をよく理解せよ、そして、立ち上がれ。わたしはこうしてお前のところに遣わされて来たのだ。」こう話しかけられて、わたしは震えながら立ち上がった。","tok":[["彼","かれ"],["は"],["こう"],["言った","いった"],["。"],["「"],["愛されて","あいされて"],["いる"],["者","もの"],["ダニエル"],["よ"],["、"],["わたし"],["が"],["お前","おまえ"],["に"],["語ろう","かたろう"],["と"],["する"],["言葉","ことば"],["を"],["よく"],["理解","りかい"],["せよ"],["、"],["そして"],["、"],["立ち上がれ","たちあがれ"],["。"],["わたし"],["は"],["こう"],["して"],["お前","おまえ"],["の"],["ところ"],["に"],["遣わされて","つかわされて"],["来た","きた"],["の"],["だ"],["。"],["」"],["こう"],["話しかけられて","はなしかけられて"],["、"],["わたし"],["は"],["震え","ふるえ"],["ながら"],["立ち上がった","たちあがった"],["。"]]},{"verse":12,"text":"彼は言葉を継いだ。「ダニエルよ、恐れることはない。神の前に心を尽くして苦行し、神意を知ろうとし始めたその最初の日から、お前の言葉は聞き入れられており、お前の言葉のためにわたしは来た。","tok":[["彼","かれ"],["は"],["言葉","ことば"],["を"],["継いだ","ついだ"],["。"],["「"],["ダニエル"],["よ"],["、"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["神","かみ"],["の"],["前","まえ"],["に"],["心","こころ"],["を"],["尽くして","つくして"],["苦行","くぎょう"],["し"],["、"],["神意","しんい"],["を"],["知ろう","しろう"],["と"],["し"],["始めた","はじめた"],["その"],["最初","さいしょ"],["の"],["日","ひ"],["から"],["、"],["お前","おまえ"],["の"],["言葉","ことば"],["は"],["聞き入れられて","ききいれられて"],["おり"],["、"],["お前","おまえ"],["の"],["言葉","ことば"],["の"],["ため"],["に"],["わたし"],["は"],["来た","きた"],["。"]]},{"verse":13,"text":"ペルシア王国の天使長が二十一日間わたしに抵抗したが、大天使長のひとりミカエルが助けに来てくれたので、わたしはペルシアの王たちのところにいる必要がなくなった。","tok":[["ペルシア"],["王国","おうこく"],["の"],["天使長","てんしちょう"],["が"],["二十一","にじゅういち"],["日間","かかん"],["わたし"],["に"],["抵抗","ていこう"],["した"],["が"],["、"],["大天使長","だいてんしちょう"],["の"],["ひとり"],["ミカエル"],["が"],["助け","たすけ"],["に"],["来て","きて"],["くれた"],["ので"],["、"],["わたし"],["は"],["ペルシア"],["の"],["王","おう"],["たち"],["の"],["ところ"],["に"],["いる"],["必要","ひつよう"],["が"],["なくなった"],["。"]]},{"verse":14,"text":"それで、お前の民に将来起こるであろうことを知らせるために来たのだ。この幻はその時に関するものだ。」","tok":[["それ"],["で"],["、"],["お前","おまえ"],["の"],["民","たみ"],["に"],["将来","しょうらい"],["起こるで","おこるで"],["あろう"],["こと"],["を"],["知らせる","しらせる"],["ため"],["に"],["来た","きた"],["の"],["だ"],["。"],["この"],["幻","まぼろし"],["は"],["その"],["時","とき"],["に"],["関する","かんする"],["もの"],["だ"],["。"],["」"]]},{"verse":15,"text":"こう言われてわたしは顔を地に伏せ、言葉を失った。","tok":[["こう"],["言われて","いわれて"],["わたし"],["は"],["顔","かお"],["を"],["地","ち"],["に"],["伏せ","ふせ"],["、"],["言葉","ことば"],["を"],["失った","うしなった"],["。"]]},{"verse":16,"text":"すると見よ、人の子のような姿の者がわたしの唇に触れたので、わたしは口を開き、前に立つその姿に話しかけた。「主よ、この幻のためにわたしは大層苦しみ、力を失いました。","tok":[["する"],["と"],["見よ","みよ"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["な"],["姿","すがた"],["の"],["者","もの"],["が"],["わたし"],["の"],["唇","くちびる"],["に"],["触れた","ふれた"],["ので"],["、"],["わたし"],["は"],["口","くち"],["を"],["開き","ひらき"],["、"],["前","まえ"],["に"],["立つ","たつ"],["その"],["姿","すがた"],["に"],["話しかけた","はなしかけた"],["。"],["「"],["主","ぬし"],["よ"],["、"],["この"],["幻","まぼろし"],["の"],["ため"],["に"],["わたし"],["は"],["大層","たいそう"],["苦しみ","くるしみ"],["、"],["力","ちから"],["を"],["失いました","うしないました"],["。"]]},{"verse":17,"text":"どうして主の僕であるわたしのような者が、主のようなお方と話すことなどできましょうか。力はうせ、息も止まらんばかりです。」","tok":[["どう"],["して"],["主","ぬし"],["の"],["僕","ぼく"],["で"],["ある"],["わたし"],["の"],["よう"],["な"],["者","もの"],["が"],["、"],["主","ぬし"],["の"],["よう"],["な"],["お方","おかた"],["と"],["話す","はなす"],["こと"],["など"],["できましょう"],["か"],["。"],["力","ちから"],["は"],["うせ"],["、"],["息","いき"],["も"],["止まらん","とまらん"],["ばかり"],["です"],["。"],["」"]]},{"verse":18,"text":"人のようなその姿は、再びわたしに触れて力づけてくれた。","tok":[["人","ひと"],["の"],["よう"],["な"],["その"],["姿","すがた"],["は"],["、"],["再び","ふたたび"],["わたし"],["に"],["触れて","ふれて"],["力づけて","ちからづけて"],["くれた"],["。"]]},{"verse":19,"text":"彼は言った。「恐れることはない。愛されている者よ。平和を取り戻し、しっかりしなさい。」こう言われて、わたしは力を取り戻し、こう答えた。「主よ、お話しください。わたしは力が出てきました。」","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["愛されて","あいされて"],["いる"],["者","もの"],["よ"],["。"],["平和","へいわ"],["を"],["取り戻し","とりもどし"],["、"],["しっかり"],["し"],["なさい"],["。"],["」"],["こう"],["言われて","いわれて"],["、"],["わたし"],["は"],["力","ちから"],["を"],["取り戻し","とりもどし"],["、"],["こう"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["よ"],["、"],["お話し","おはなし"],["ください"],["。"],["わたし"],["は"],["力","ちから"],["が"],["出て","でて"],["きました"],["。"],["」"]]},{"verse":20,"text":"彼は言った。「なぜお前のところに来たか、分かったであろう。今、わたしはペルシアの天使長と闘うために帰る。わたしが去るとすぐギリシアの天使長が現れるであろう。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["なぜ"],["お前","おまえ"],["の"],["ところ"],["に"],["来た","きた"],["か"],["、"],["分かったで","わかったで"],["あろう"],["。"],["今","いま"],["、"],["わたし"],["は"],["ペルシア"],["の"],["天使長","てんしちょう"],["と"],["闘う","たたかう"],["ため"],["に"],["帰る","かえる"],["。"],["わたし"],["が"],["去る","さる"],["と"],["すぐ"],["ギリシア"],["の"],["天使長","てんしちょう"],["が"],["現れるで","あらわれるで"],["あろう"],["。"]]},{"verse":21,"text":"しかし、真理の書に記されていることをお前に教えよう。お前たちの天使長ミカエルのほかに、これらに対してわたしを助ける者はないのだ。","tok":[["しかし"],["、"],["真理","しんり"],["の"],["書","しょ"],["に"],["記されて","しるされて"],["いる"],["こと"],["を"],["お前","おまえ"],["に"],["教えよう","おしえよう"],["。"],["
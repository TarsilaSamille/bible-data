[{"verse":1,"text":"ユダの王ヨヤキムが即位して三年目のことであった。バビロンの王ネブカドネツァルが攻めて来て、エルサレムを包囲した。","tok":[["ユダ"],["の"],["王","おう"],["ヨヤキム"],["が"],["即位","そくい"],["して"],["三","さん"],["年目","ねんめ"],["の"],["こと"],["で"],["あった"],["。"],["バビロン"],["の"],["王","おう"],["ネブカドネツァル"],["が"],["攻めて","せめて"],["来て","きて"],["、"],["エルサレム"],["を"],["包囲","ほうい"],["した"],["。"]]},{"verse":2,"text":"主は、ユダの王ヨヤキムと、エルサレム神殿の祭具の一部を彼の手中に落とされた。ネブカドネツァルはそれらをシンアルに引いて行き、祭具類は自分の神々の宝物倉に納めた。","tok":[["主","ぬし"],["は"],["、"],["ユダ"],["の"],["王","おう"],["ヨヤキム"],["と"],["、"],["エルサレム"],["神殿","しんでん"],["の"],["祭具","さいぐ"],["の"],["一部","いちぶ"],["を"],["彼","かれ"],["の"],["手中","しゅちゅう"],["に"],["落とされた","おとされた"],["。"],["ネブカドネツァル"],["は"],["それ"],["ら"],["を"],["シンアル"],["に"],["引いて","ひいて"],["行き","いき"],["、"],["祭具類","さいぐるい"],["は"],["自分","じぶん"],["の"],["神々","かみがみ"],["の"],["宝物倉","ほうもつそう"],["に"],["納めた","おさめた"],["。"]]},{"verse":3,"text":"さて、ネブカドネツァル王は侍従長アシュペナズに命じて、イスラエル人の王族と貴族の中から、","tok":[["さて"],["、"],["ネブカドネツァル"],["王","おう"],["は"],["侍従長","じじゅうちょう"],["アシュペナズ"],["に"],["命じて","めいじて"],["、"],["イスラエル"],["人","にん"],["の"],["王族","おうぞく"],["と"],["貴族","きぞく"],["の"],["中","なか"],["から"],["、"]]},{"verse":4,"text":"体に難点がなく、容姿が美しく、何事にも才能と知恵があり、知識と理解力に富み、宮廷に仕える能力のある少年を何人か連れて来させ、カルデア人の言葉と文書を学ばせた。","tok":[["体","からだ"],["に"],["難点","なんてん"],["が"],["なく"],["、"],["容姿","ようし"],["が"],["美しく","うつくしく"],["、"],["何事","なにごと"],["に"],["も"],["才能","さいのう"],["と"],["知恵","ちえ"],["が"],["あり"],["、"],["知識","ちしき"],["と"],["理解力","りかいりょく"],["に"],["富み","とみ"],["、"],["宮廷","きゅうてい"],["に"],["仕える","つかえる"],["能力","のうりょく"],["の"],["ある"],["少年","しょうねん"],["を"],["何人","なんにん"],["か"],["連れて","つれて"],["来させ","きさせ"],["、"],["カルデア"],["人","にん"],["の"],["言葉","ことば"],["と"],["文書","ぶんしょ"],["を"],["学ばせた","まなばせた"],["。"]]},{"verse":5,"text":"王は、宮廷の肉類と酒を毎日彼らに与えるように定め、三年間養成してから自分に仕えさせることにした。","tok":[["王","おう"],["は"],["、"],["宮廷","きゅうてい"],["の"],["肉類","にくるい"],["と"],["酒","さけ"],["を"],["毎日","まいにち"],["彼","かれ"],["ら"],["に"],["与える","あたえる"],["よう"],["に"],["定め","さだめ"],["、"],["三","さん"],["年間","ねんかん"],["養成","ようせい"],["して"],["から"],["自分","じぶん"],["に"],["仕えさせる","つかえさせる"],["こと"],["に"],["した"],["。"]]},{"verse":6,"text":"この少年たちの中に、ユダ族出身のダニエル、ハナンヤ、ミシャエル、アザルヤの四人がいた。","tok":[["この"],["少年","しょうねん"],["たち"],["の"],["中","なか"],["に"],["、"],["ユダ族","ゆだぞく"],["出身","しゅっしん"],["の"],["ダニエル"],["、"],["ハナンヤ"],["、"],["ミシャエル"],["、"],["アザルヤ"],["の"],["四人","よんにん"],["が"],["いた"],["。"]]},{"verse":7,"text":"侍従長は彼らの名前を変えて、ダニエルをベルテシャツァル、ハナンヤをシャドラク、ミシャエルをメシャク、アザルヤをアベド‧ネゴと呼んだ。","tok":[["侍従長","じじゅうちょう"],["は"],["彼","かれ"],["ら"],["の"],["名前","なまえ"],["を"],["変えて","かえて"],["、"],["ダニエル"],["を"],["ベルテシャツァル"],["、"],["ハナンヤ"],["を"],["シャドラク"],["、"],["ミシャエル"],["を"],["メシャク"],["、"],["アザルヤ"],["を"],["アベド"],["‧"],["ネゴ"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":8,"text":"ダニエルは宮廷の肉類と酒で自分を汚すまいと決心し、自分を汚すようなことはさせないでほしいと侍従長に願い出た。","tok":[["ダニエル"],["は"],["宮廷","きゅうてい"],["の"],["肉類","にくるい"],["と"],["酒","さけ"],["で"],["自分","じぶん"],["を"],["汚すまい","よごすまい"],["と"],["決心","けっしん"],["し"],["、"],["自分","じぶん"],["を"],["汚す","けがす"],["よう"],["な"],["こと"],["は"],["させないで"],["ほしい"],["と"],["侍従長","じじゅうちょう"],["に"],["願い出た","ねがいでた"],["。"]]},{"verse":9,"text":"神の御計らいによって、侍従長はダニエルに好意を示し、親切にした。","tok":[["神","かみ"],["の"],["御計らい","おはからい"],["によって"],["、"],["侍従長","じじゅうちょう"],["は"],["ダニエル"],["に"],["好意","こうい"],["を"],["示し","しめし"],["、"],["親切","しんせつ"],["に"],["した"],["。"]]},{"verse":10,"text":"侍従長はダニエルに言った。「わたしは王様が恐ろしい。王様御自身がお前たちの食べ物と飲み物をお定めになったのだから。同じ年ごろの少年に比べてお前たちの顔色が悪くなったら、お前たちのためにわたしの首が危うくなるではないか。」","tok":[["侍従長","じじゅうちょう"],["は"],["ダニエル"],["に"],["言った","いった"],["。"],["「"],["わたし"],["は"],["王様","おうさま"],["が"],["恐ろしい","おそろしい"],["。"],["王様","おうさま"],["御自身","ごじしん"],["が"],["お前","おまえ"],["たち"],["の"],["食べ物","たべもの"],["と"],["飲み物","のみもの"],["を"],["お定め","おさだめ"],["に"],["なった"],["の"],["だ"],["から"],["。"],["同じ","おなじ"],["年ごろ","としごろ"],["の"],["少年","しょうねん"],["に"],["比べて","くらべて"],["お前","おまえ"],["たち"],["の"],["顔色","かおいろ"],["が"],["悪く","わるく"],["なったら"],["、"],["お前","おまえ"],["たち"],["の"],["ため"],["に"],["わたし"],["の"],["首","くび"],["が"],["危うく","あやうく"],["なるで"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":11,"text":"ダニエルは、侍従長が自分たち四人の世話係に定めた人に言った。","tok":[["ダニエル"],["は"],["、"],["侍従長","じじゅうちょう"],["が"],["自分","じぶん"],["たち"],["四人","よんにん"],["の"],["世話係","せわかかり"],["に"],["定めた","さだめた"],["人","ひと"],["に"],["言った","いった"],["。"]]},{"verse":12,"text":"「どうかわたしたちを十日間試してください。その間、食べる物は野菜だけ、飲む物は水だけにさせてください。","tok":[["「"],["どう"],["か"],["わたしたち"],["を"],["十","とう"],["日間","かかん"],["試して","ためして"],["ください"],["。"],["その"],["間","かん"],["、"],["食べる","たべる"],["物","もの"],["は"],["野菜","やさい"],["だけ"],["、"],["飲む","のむ"],["物","もの"],["は"],["水","みず"],["だけ"],["に"],["させて"],["ください"],["。"]]},{"verse":13,"text":"その後、わたしたちの顔色と、宮廷の肉類をいただいた少年の顔色をよくお比べになり、その上でお考えどおりにしてください。」","tok":[["その"],["後","ご"],["、"],["わたしたち"],["の"],["顔色","かおいろ"],["と"],["、"],["宮廷","きゅうてい"],["の"],["肉類","にくるい"],["を"],["いただいた"],["少年","しょうねん"],["の"],["顔色","かおいろ"],["を"],["よく"],["お比べ","おくらべ"],["に"],["なり"],["、"],["その"],["上","うえ"],["で"],["お考え","おかんがえ"],["どおり"],["に"],["して"],["ください"],["。"],["」"]]},{"verse":14,"text":"世話係はこの願いを聞き入れ、十日間彼らを試した。","tok":[["世話係","せわかかり"],["は"],["この"],["願い","ねがい"],["を"],["聞き入れ","ききいれ"],["、"],["十","とう"],["日間","かかん"],["彼","かれ"],["ら"],["を"],["試した","ためした"],["。"]]},{"verse":15,"text":"十日たってみると、彼らの顔色と健康は宮廷の食べ物を受けているどの少年よりも良かった。","tok":[["十日","とうか"],["たって"],["みる"],["と"],["、"],["彼","かれ"],["ら"],["の"],["顔色","かおいろ"],["と"],["健康","けんこう"],["は"],["宮廷","きゅうてい"],["の"],["食べ物","たべもの"],["を"],["受けて","うけて"],["いる"],["どの"],["少年","しょうねん"],["より"],["も"],["良かった","よかった"],["。"]]},{"verse":16,"text":"それ以来、世話係は彼らに支給される肉類と酒を除いて、野菜だけ与えることにした。","tok":[["それ"],["以来","いらい"],["、"],["世話係","せわかかり"],["は"],["彼","かれ"],["ら"],["に"],["支給","しきゅう"],["される"],["肉類","にくるい"],["と"],["酒","さけ"],["を"],["除いて","のぞいて"],["、"],["野菜","やさい"],["だけ"],["与える","あたえる"],["こと"],["に"],["した"],["。"]]},{"verse":17,"text":"この四人の少年は、知識と才能を神から恵まれ、文書や知恵についてもすべて優れていて、特にダニエルはどのような幻も夢も解くことができた。","tok":[["この"],["四人","よんにん"],["の"],["少年","しょうねん"],["は"],["、"],["知識","ちしき"],["と"],["才能","さいのう"],["を"],["神","かみ"],["から"],["恵まれ","めぐまれ"],["、"],["文書","ぶんしょ"],["や"],["知恵","ちえ"],["について"],["も"],["すべて"],["優れて","すぐれて"],["いて"],["、"],["特に","とくに"],["ダニエル"],["は"],["どのような"],["幻","まぼろし"],["も"],["夢","ゆめ"],["も"],["解く","とく"],["こと"],["が"],["できた"],["。"]]},{"verse":18,"text":"ネブカドネツァル王の定めた年数がたつと、侍従長は少年たちを王の前に連れて行った。","tok":[["ネブカドネツァル"],["王","おう"],["の"],["定めた","さだめた"],["年数","ねんすう"],["が"],["たつ"],["と"],["、"],["侍従長","じじゅうちょう"],["は"],["少年","しょうねん"],["たち"],["を"],["王","おう"],["の"],["前","まえ"],["に"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":19,"text":"王は彼らと語り合ったが、このダニエル、ハナンヤ、ミシャエル、アザルヤと並ぶ者はほかにだれもいなかったので、この四人は王のそばに仕えることになった。","tok":[["王","おう"],["は"],["彼","かれ"],["ら"],["と"],["語り合った","かたりあった"],["が"],["、"],["この"],["ダニエル"],["、"],["ハナンヤ"],["、"],["ミシャエル"],["、"],["アザルヤ"],["と"],["並ぶ","ならぶ"],["者","もの"],["は"],["ほか"],["に"],["だれ"],["も"],["いなかった"],["ので"],["、"],["この"],["四人","よんにん"],["は"],["王","おう"],["の"],["そば"],["に"],["仕える","つかえる"],["こと"],["に"],["なった"],["。"]]},{"verse":20,"text":"王は知恵と理解力を要する事柄があれば彼らに意見を求めたが、彼らは常に国中のどの占い師、祈禱師よりも十倍も優れていた。","tok":[["王","おう"],["は"],["知恵","ちえ"],["と"],["理解力","りかいりょく"],["を"],["要する","ようする"],["事柄","ことがら"],["が"],["あれば"],["彼","かれ"],["ら"],["に"],["意見","いけん"],["を"],["求めた","もとめた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["常","つね"],["に"],["国中","くにちゅう"],["の"],["どの"],["占い師","うらないし"],["、"],["祈禱師","きとうし"],["より"],["も"],["十","じゅう"],["倍","ばい"],["も"],["優れて","すぐれて"],["いた"],["。"]]},{"verse":21,"text":"ダニエルはキュロス王の元年まで仕えた。","tok":[["ダニエル"],["は"],["キュロス"],["王","おう"],["の"],["元年","がんねん"],["まで"],["仕えた","つかえた"],["。"]]}]
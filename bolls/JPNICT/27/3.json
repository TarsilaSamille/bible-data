[{"verse":1,"text":"ネブカドネツァル王は一つの金の像を造った。高さは六十アンマ、幅は六アンマで、これをバビロン州のドラという平野に建てた。","tok":[["ネブカドネツァル"],["王","おう"],["は"],["一","ひと"],["つ"],["の"],["金","かね"],["の"],["像","ぞう"],["を"],["造った","つくった"],["。"],["高さ","たかさ"],["は"],["六十","ろくじゅう"],["アンマ"],["、"],["幅","はば"],["は"],["六","ろく"],["アンマ"],["で"],["、"],["これ"],["を"],["バビロン"],["州","しゅう"],["の"],["ドラ"],["と"],["いう"],["平野","へいや"],["に"],["建てた","たてた"],["。"]]},{"verse":2,"text":"ネブカドネツァル王は人を遣わして、総督、執政官、地方長官、参議官、財務官、司法官、保安官、その他諸州の高官たちを集め、自分の建てた像の除幕式に参列させることにした。","tok":[["ネブカドネツァル"],["王","おう"],["は"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["総督","そうとく"],["、"],["執政官","しっせいかん"],["、"],["地方","ちほう"],["長官","ちょうかん"],["、"],["参議官","さんぎかん"],["、"],["財務官","ざいむかん"],["、"],["司法官","しほうかん"],["、"],["保安官","ほあんかん"],["、"],["その"],["他","た"],["諸州","しょしゅう"],["の"],["高官","こうかん"],["たち"],["を"],["集め","あつめ"],["、"],["自分","じぶん"],["の"],["建てた","たてた"],["像","ぞう"],["の"],["除幕式","じょまくしき"],["に"],["参列","さんれつ"],["させる"],["こと"],["に"],["した"],["。"]]},{"verse":3,"text":"総督、執政官、地方長官、参議官、財務官、司法官、保安官、その他諸州の高官たちはその王の建てた像の除幕式に集まり、像の前に立ち並んだ。","tok":[["総督","そうとく"],["、"],["執政官","しっせいかん"],["、"],["地方","ちほう"],["長官","ちょうかん"],["、"],["参議官","さんぎかん"],["、"],["財務官","ざいむかん"],["、"],["司法官","しほうかん"],["、"],["保安官","ほあんかん"],["、"],["その"],["他","た"],["諸州","しょしゅう"],["の"],["高官","こうかん"],["たち"],["は"],["その"],["王","おう"],["の"],["建てた","たてた"],["像","ぞう"],["の"],["除幕式","じょまくしき"],["に"],["集まり","あつまり"],["、"],["像","ぞう"],["の"],["前","まえ"],["に"],["立ち並んだ","たちならんだ"],["。"]]},{"verse":4,"text":"伝令は力を込めて叫んだ。「諸国、諸族、諸言語の人々よ、あなたたちに告げる。","tok":[["伝令","でんれい"],["は"],["力","ちから"],["を"],["込めて","こめて"],["叫んだ","さけんだ"],["。"],["「"],["諸国","しょこく"],["、"],["諸族","しょぞく"],["、"],["諸","しょ"],["言語","げんご"],["の"],["人々","ひとびと"],["よ"],["、"],["あなた"],["たち"],["に"],["告げる","つげる"],["。"]]},{"verse":5,"text":"角笛、横笛、六絃琴、竪琴、十三絃琴、風琴などあらゆる楽器による音楽が聞こえたなら、ネブカドネツァル王の建てられた金の像の前にひれ伏して拝め。","tok":[["角笛","つのぶえ"],["、"],["横笛","よこぶえ"],["、"],["六","ろく"],["絃","げん"],["琴","こと"],["、"],["竪琴","たてごと"],["、"],["十三","じゅうさん"],["絃","げん"],["琴","こと"],["、"],["風琴","ふうきん"],["など"],["あらゆる"],["楽器","がっき"],["に"],["よる"],["音楽","おんがく"],["が"],["聞こえたなら","きこえたなら"],["、"],["ネブカドネツァル"],["王","おう"],["の"],["建てられた","たてられた"],["金","かね"],["の"],["像","ぞう"],["の"],["前","まえ"],["に"],["ひれ伏して","ひれふして"],["拝め","おがめ"],["。"]]},{"verse":6,"text":"ひれ伏して拝まない者は、直ちに燃え盛る炉に投げ込まれる。」","tok":[["ひれ伏して","ひれふして"],["拝まない","おがまない"],["者","もの"],["は"],["、"],["直ちに","ただちに"],["燃え盛る","もえさかる"],["炉","ろ"],["に"],["投げ込まれる","なげこまれる"],["。"],["」"]]},{"verse":7,"text":"それで、角笛、横笛、六絃琴、竪琴、十三絃琴の音楽が聞こえてくると、諸国、諸族、諸言語の人々は皆ひれ伏し、ネブカドネツァル王の建てた金の像を拝んだ。","tok":[["それ"],["で"],["、"],["角笛","つのぶえ"],["、"],["横笛","よこぶえ"],["、"],["六","ろく"],["絃","げん"],["琴","こと"],["、"],["竪琴","たてごと"],["、"],["十三","じゅうさん"],["絃","げん"],["琴","こと"],["の"],["音楽","おんがく"],["が"],["聞こえて","きこえて"],["くる"],["と"],["、"],["諸国","しょこく"],["、"],["諸族","しょぞく"],["、"],["諸","しょ"],["言語","げんご"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["ひれ伏し","ひれふし"],["、"],["ネブカドネツァル"],["王","おう"],["の"],["建てた","たてた"],["金","かね"],["の"],["像","ぞう"],["を"],["拝んだ","おがんだ"],["。"]]},{"verse":8,"text":"さてこのとき、何人かのカルデア人がユダヤ人を中傷しようと進み出て、","tok":[["さて"],["この"],["とき"],["、"],["何人","なんにん"],["か"],["の"],["カルデア"],["人","にん"],["が"],["ユダヤ人","ゆだやじん"],["を"],["中傷","ちゅうしょう"],["しよう"],["と"],["進み出て","すすみでて"],["、"]]},{"verse":9,"text":"ネブカドネツァル王にこう言った。「王様がとこしえまでも生き永らえられますように。","tok":[["ネブカドネツァル"],["王","おう"],["に"],["こう"],["言った","いった"],["。"],["「"],["王様","おうさま"],["が"],["とこしえ"],["まで"],["も"],["生き永らえられます","いきながらえられます"],["よう"],["に"],["。"]]},{"verse":10,"text":"御命令によりますと、角笛、横笛、六絃琴、竪琴、十三絃琴、風琴などあらゆる楽器の音楽が聞こえたなら、だれでも金の像にひれ伏して拝め、ということでした。","tok":[["御命令","ごめいれい"],["に"],["よります"],["と"],["、"],["角笛","つのぶえ"],["、"],["横笛","よこぶえ"],["、"],["六","ろく"],["絃","げん"],["琴","こと"],["、"],["竪琴","たてごと"],["、"],["十三","じゅうさん"],["絃","げん"],["琴","こと"],["、"],["風琴","ふうきん"],["など"],["あらゆる"],["楽器","がっき"],["の"],["音楽","おんがく"],["が"],["聞こえたなら","きこえたなら"],["、"],["だれ"],["で"],["も"],["金","きん"],["の"],["像","ぞう"],["に"],["ひれ伏して","ひれふして"],["拝め","おがめ"],["、"],["と"],["いう"],["こと"],["でした"],["。"]]},{"verse":11,"text":"そうしなければ、燃え盛る炉に投げ込まれるはずです。","tok":[["そう"],["しなければ"],["、"],["燃え盛る","もえさかる"],["炉","ろ"],["に"],["投げ込まれる","なげこまれる"],["はず"],["です"],["。"]]},{"verse":12,"text":"バビロン州には、その行政をお任せになっているユダヤ人シャドラク、メシャク、アベド‧ネゴの三人がおりますが、この人々は御命令を無視して、王様の神に仕えず、お建てになった金の像を拝もうとしません。」","tok":[["バビロン"],["州","しゅう"],["に"],["は"],["、"],["その"],["行政","ぎょうせい"],["を"],["お任せ","おまかせ"],["に"],["なって"],["いる"],["ユダヤ人","ゆだやじん"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["の"],["三人","さんにん"],["が"],["おります"],["が"],["、"],["この"],["人々","ひとびと"],["は"],["御命令","ごめいれい"],["を"],["無視","むし"],["して"],["、"],["王様","おうさま"],["の"],["神","かみ"],["に"],["仕えず","つかえず"],["、"],["お建て","おたて"],["に"],["なった"],["金","かね"],["の"],["像","ぞう"],["を"],["拝もう","おがもう"],["と"],["しません"],["。"],["」"]]},{"verse":13,"text":"これを聞いたネブカドネツァル王は怒りに燃え、シャドラク、メシャク、アベド‧ネゴを連れて来るよう命じ、この三人は王の前に引き出された。","tok":[["これ"],["を"],["聞いた","きいた"],["ネブカドネツァル"],["王","おう"],["は"],["怒り","いかり"],["に"],["燃え","もえ"],["、"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["を"],["連れて","つれて"],["来る","くる"],["よう"],["命じ","めいじ"],["、"],["この"],["三人","さんにん"],["は"],["王","おう"],["の"],["前","まえ"],["に"],["引き出された","ひきだされた"],["。"]]},{"verse":14,"text":"王は彼らに言った。「シャドラク、メシャク、アベド‧ネゴ、お前たちがわたしの神に仕えず、わたしの建てた金の像を拝まないというのは本当か。","tok":[["王","おう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["、"],["お前","おまえ"],["たち"],["が"],["わたし"],["の"],["神","かみ"],["に"],["仕えず","つかえず"],["、"],["わたし"],["の"],["建てた","たてた"],["金","かね"],["の"],["像","ぞう"],["を"],["拝まない","おがまない"],["と"],["いう"],["の"],["は"],["本当","ほんとう"],["か"],["。"]]},{"verse":15,"text":"今、角笛、横笛、六絃琴、竪琴、十三絃琴、風琴などあらゆる楽器の音楽が聞こえると同時にひれ伏し、わたしの建てた金の像を拝むつもりでいるなら、それでよい。もしも拝まないなら、直ちに燃え盛る炉に投げ込ませる。お前たちをわたしの手から救い出す神があろうか。」","tok":[["今","いま"],["、"],["角笛","つのぶえ"],["、"],["横笛","よこぶえ"],["、"],["六","ろく"],["絃","げん"],["琴","こと"],["、"],["竪琴","たてごと"],["、"],["十三","じゅうさん"],["絃","げん"],["琴","こと"],["、"],["風琴","ふうきん"],["など"],["あらゆる"],["楽器","がっき"],["の"],["音楽","おんがく"],["が"],["聞こえる","きこえる"],["と"],["同時","どうじ"],["に"],["ひれ伏し","ひれふし"],["、"],["わたし"],["の"],["建てた","たてた"],["金","かね"],["の"],["像","ぞう"],["を"],["拝む","おがむ"],["つもり"],["で"],["いるなら"],["、"],["それ"],["で"],["よい"],["。"],["もし"],["も"],["拝まないなら","おがまないなら"],["、"],["直ちに","ただちに"],["燃え盛る","もえさかる"],["炉","ろ"],["に"],["投げ込ませる","なげこませる"],["。"],["お前","おまえ"],["たち"],["を"],["わたし"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["神","かみ"],["が"],["あろう"],["か"],["。"],["」"]]},{"verse":16,"text":"シャドラク、メシャク、アベド‧ネゴはネブカドネツァル王に答えた。「このお定めにつきまして、お答えする必要はございません。","tok":[["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["は"],["ネブカドネツァル"],["王","おう"],["に"],["答えた","こたえた"],["。"],["「"],["この"],["お定め","おさだめ"],["に"],["つきまして"],["、"],["お答え","おこたえ"],["する"],["必要","ひつよう"],["は"],["ございません"],["。"]]},{"verse":17,"text":"わたしたちのお仕えする神は、その燃え盛る炉や王様の手からわたしたちを救うことができますし、必ず救ってくださいます。","tok":[["わたしたち"],["の"],["お仕え","おつかえ"],["する"],["神","かみ"],["は"],["、"],["その"],["燃え盛る","もえさかる"],["炉","ろ"],["や"],["王様","おうさま"],["の"],["手","て"],["から"],["わたしたち"],["を"],["救う","すくう"],["こと"],["が"],["できます"],["し"],["、"],["必ず","かならず"],["救って","すくって"],["くださいます"],["。"]]},{"verse":18,"text":"そうでなくとも、御承知ください。わたしたちは王様の神々に仕えることも、お建てになった金の像を拝むことも、決していたしません。」","tok":[["そう"],["で"],["なく"],["とも"],["、"],["御承知","ごしょうち"],["ください"],["。"],["わたしたち"],["は"],["王様","おうさま"],["の"],["神々","かみがみ"],["に"],["仕える","つかえる"],["こと"],["も"],["、"],["お建て","おたて"],["に"],["なった"],["金","かね"],["の"],["像","ぞう"],["を"],["拝む","おがむ"],["こと"],["も"],["、"],["決して","けっして"],["いたしません"],["。"],["」"]]},{"verse":19,"text":"ネブカドネツァル王はシャドラク、メシャク、アベド‧ネゴに対して血相を変えて怒り、炉をいつもの七倍も熱く燃やすように命じた。","tok":[["ネブカドネツァル"],["王","おう"],["は"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["に対して","にたいして"],["血相","けっそう"],["を"],["変えて","かえて"],["怒り","おこり"],["、"],["炉","ろ"],["を"],["いつも"],["の"],["七","なな"],["倍","ばい"],["も"],["熱く","あつく"],["燃やす","もやす"],["よう"],["に"],["命じた","めいじた"],["。"]]},{"verse":20,"text":"そして兵士の中でも特に強い者に命じて、シャドラク、メシャク、アベド‧ネゴを縛り上げ、燃え盛る炉に投げ込ませた。","tok":[["そして"],["兵士","へいし"],["の"],["中","なか"],["で"],["も"],["特に","とくに"],["強い","つよい"],["者","もの"],["に"],["命じて","めいじて"],["、"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["を"],["縛り上げ","しばりあげ"],["、"],["燃え盛る","もえさかる"],["炉","ろ"],["に"],["投げ込ませた","なげこませた"],["。"]]},{"verse":21,"text":"彼らは上着、下着、帽子、その他の衣服を着けたまま縛られ、燃え盛る炉に投げ込まれた。","tok":[["彼","かれ"],["ら"],["は"],["上着","うわぎ"],["、"],["下着","したぎ"],["、"],["帽子","ぼうし"],["、"],["その"],["他","た"],["の"],["衣服","いふく"],["を"],["着けた","つけた"],["まま"],["縛られ","しばられ"],["、"],["燃え盛る","もえさかる"],["炉","ろ"],["に"],["投げ込まれた","なげこまれた"],["。"]]},{"verse":22,"text":"王の命令は厳しく、炉は激しく燃え上がっていたので、噴き出る炎はシャドラク、メシャク、アベド‧ネゴを引いて行った男たちをさえ焼き殺した。","tok":[["王","おう"],["の"],["命令","めいれい"],["は"],["厳しく","きびしく"],["、"],["炉","ろ"],["は"],["激しく","はげしく"],["燃え上がって","もえあがって"],["いた"],["ので"],["、"],["噴き出る","ふきでる"],["炎","ほのお"],["は"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["を"],["引いて","ひいて"],["行った","いった"],["男","おとこ"],["たち"],["を"],["さえ"],["焼き殺した","やきころした"],["。"]]},{"verse":23,"text":"シャドラク、メシャク、アベド‧ネゴの三人は縛られたまま燃え盛る炉の中に落ち込んで行った。","tok":[["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["の"],["三人","さんにん"],["は"],["縛られた","しばられた"],["まま"],["燃え盛る","もえさかる"],["炉","ろ"],["の"],["中","なか"],["に"],["落ち込んで","おちこんで"],["行った","いった"],["。"]]},{"verse":24,"text":"間もなく王は驚きの色を見せ、急に立ち上がり、側近たちに尋ねた。「あの三人の男は、縛ったまま炉に投げ込んだはずではなかったか。」彼らは答えた。「王様、そのとおりでございます。」","tok":[["間","ま"],["も"],["なく"],["王","おう"],["は"],["驚き","おどろき"],["の"],["色","いろ"],["を"],["見せ","みせ"],["、"],["急","きゅう"],["に"],["立ち上がり","たちあがり"],["、"],["側近","そっきん"],["たち"],["に"],["尋ねた","たずねた"],["。"],["「"],["あの"],["三人","さんにん"],["の"],["男","おとこ"],["は"],["、"],["縛った","しばった"],["まま"],["炉","ろ"],["に"],["投げ込んだ","なげこんだ"],["はず"],["で"],["は"],["なかった"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["答えた","こたえた"],["。"],["「"],["王様","おうさま"],["、"],["その"],["とおり"],["で"],["ございます"],["。"],["」"]]},{"verse":25,"text":"王は言った。「だが、わたしには四人の者が火の中を自由に歩いているのが見える。そして何の害も受けていない。それに四人目の者は神の子のような姿をしている。」","tok":[["王","おう"],["は"],["言った","いった"],["。"],["「"],["だ"],["が"],["、"],["わたし"],["に"],["は"],["四人","よんにん"],["の"],["者","もの"],["が"],["火","ひ"],["の"],["中","なか"],["を"],["自由","じゆう"],["に"],["歩いて","あるいて"],["いる"],["の"],["が"],["見える","みえる"],["。"],["そして"],["何","なん"],["の"],["害","がい"],["も"],["受けて","うけて"],["いない"],["。"],["それ"],["に"],["四人目","よにんめ"],["の"],["者","もの"],["は"],["神","かみ"],["の"],["子","こ"],["の"],["よう"],["な"],["姿","すがた"],["を"],["して"],["いる"],["。"],["」"]]},{"verse":26,"text":"ネブカドネツァル王は燃え盛る炉の口に近づいて呼びかけた。「シャドラク、メシャク、アベド‧ネゴ、いと高き神に仕える人々よ、出て来なさい。」すると、シャドラク、メシャク、アベド‧ネゴは炉の中から出て来た。","tok":[["ネブカドネツァル"],["王","おう"],["は"],["燃え盛る","もえさかる"],["炉","ろ"],["の"],["口","くち"],["に"],["近づいて","ちかづいて"],["呼びかけた","よびかけた"],["。"],["「"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["、"],["いと"],["高き","たかき"],["神","かみ"],["に"],["仕える","つかえる"],["人々","ひとびと"],["よ"],["、"],["出て","でて"],["来","き"],["なさい"],["。"],["」"],["する"],["と"],["、"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["は"],["炉","ろ"],["の"],["中","なか"],["から"],["出て","でて"],["来た","きた"],["。"]]},{"verse":27,"text":"総督、執政官、地方長官、王の側近たちは集まって三人を調べたが、火はその体を損なわず、髪の毛も焦げてはおらず、上着も元のままで火のにおいすらなかった。","tok":[["総督","そうとく"],["、"],["執政官","しっせいかん"],["、"],["地方","ちほう"],["長官","ちょうかん"],["、"],["王","おう"],["の"],["側近","そっきん"],["たち"],["は"],["集まって","あつまって"],["三人","さんにん"],["を"],["調べた","しらべた"],["が"],["、"],["火","ひ"],["は"],["その"],["体","からだ"],["を"],["損なわず","そこなわず"],["、"],["髪の毛","かみのけ"],["も"],["焦げて","こげて"],["は"],["おらず"],["、"],["上着","うわぎ"],["も"],["元","もと"],["の"],["まま"],["で"],["火","ひ"],["の"],["におい"],["すら"],["なかった"],["。"]]},{"verse":28,"text":"ネブカドネツァル王は言った。「シャドラク、メシャク、アベド‧ネゴの神をたたえよ。彼らは王の命令に背き、体を犠牲にしても自分の神に依り頼み、自分の神以外にはいかなる神にも仕えず、拝もうともしなかったので、この僕たちを、神は御使いを送って救われた。","tok":[["ネブカドネツァル"],["王","おう"],["は"],["言った","いった"],["。"],["「"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["の"],["神","かみ"],["を"],["たたえ"],["よ"],["。"],["彼","かれ"],["ら"],["は"],["王","おう"],["の"],["命令","めいれい"],["に"],["背き","そむき"],["、"],["体","からだ"],["を"],["犠牲","ぎせい"],["に"],["して"],["も"],["自分","じぶん"],["の"],["神","かみ"],["に"],["依り頼み","よりたのみ"],["、"],["自分","じぶん"],["の"],["神","かみ"],["以外","いがい"],["に"],["は"],["いかなる"],["神","かみ"],["に"],["も"],["仕えず","つかえず"],["、"],["拝もう","おがもう"],["と"],["も"],["しなかった"],["ので"],["、"],["この"],["僕たち","ぼくたち"],["を"],["、"],["神","かみ"],["は"],["御使い","おつかい"],["を"],["送って","おくって"],["救われた","すくわれた"],["。"]]},{"verse":29,"text":"わたしは命令する。いかなる国、民族、言語に属する者も、シャドラク、メシャク、アベド‧ネゴの神をののしる者があれば、その体は八つ裂きにされ、その家は破壊される。まことに人間をこのように救うことのできる神はほかにはない。」","tok":[["わたし"],["は"],["命令","めいれい"],["する"],["。"],["いかなる"],["国","くに"],["、"],["民族","みんぞく"],["、"],["言語","げんご"],["に"],["属する","ぞくする"],["者","もの"],["も"],["、"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["の"],["神","かみ"],["を"],["ののしる"],["者","もの"],["が"],["あれば"],["、"],["その"],["体","からだ"],["は"],["八つ裂き","やつざき"],["に"],["され"],["、"],["その"],["家","いえ"],["は"],["破壊","はかい"],["される"],["。"],["まこと"],["に"],["人間","にんげん"],["を"],["この"],["よう"],["に"],["救う","すくう"],["こと"],["の"],["できる"],["神","かみ"],["は"],["ほか"],["に"],["は"],["ない"],["。"],["」"]]},{"verse":30,"text":"こうして王は、シャドラク、メシャク、アベド‧ネゴをバビロン州で高い位につけた。","tok":[["こう"],["して"],["王","おう"],["は"],["、"],["シャドラク"],["、"],["メシャク"],["、"],["アベド"],["‧"],["ネゴ"],["を"],["バビロン"],["州","しゅう"],["で"],["高い","たかい"],["位","くらい"],["に"],["つけた"],["。"]]},{"verse":31,"text":"ネブカドネツァル王は、全世界の諸国、諸族、諸言語の住民に、いっそうの繁栄を願って、挨拶を送る。","tok":[["ネブカドネツァル"],["王","おう"],["は"],["、"],["全","ぜん"],["世界","せかい"],["の"],["諸国","しょこく"],["、"],["諸族","しょぞく"],["、"],["諸","しょ"],["言語","げんご"],["の"],["住民","じゅうみん"],["に"],["、"],["いっそう"],["の"],["繁栄","はんえい"],["を"],["願って","ねがって"],["、"],["挨拶","あいさつ"],["を"],["送る","おくる"],["。"]]},{"verse":32,"text":"さて、わたしはいと高き神がわたしになさったしるしと不思議な御業を知らせる。","tok":[["さて"],["、"],["わたし"],["はい"],["と"],["高き","たかき"],["神","かみ"],["が"],["わたし"],["に"],["なさった"],["しるし"],["と"],["不思議","ふしぎ"],["な"],["御業","ごごう"],["を"],["知らせる","しらせる"],["。"]]},{"verse":33,"text":"この神のしるしは、いかに偉大であり不思議な御業は、いかに力あることか。その御国は永遠の御国であり、支配は代々に及ぶ。","tok":[["この"],["神","かみ"],["の"],["しるし"],["は"],["、"],["いかに"],["偉大","いだい"],["で"],["あり"],["不思議","ふしぎ"],["な"],["御業","ごごう"],["は"],["、"],["いかに"],["力","ちから"],["ある"],["こと"],["か"],["。"],["その"],["御国","みくに"],["は"],["永遠","えいえん"],["の"],["御国","おくに"],["で"],["あり"],["、"],["支配","しはい"],["は"],["代々","だいだい"],["に"],["及ぶ","およぶ"],["。"]]}]
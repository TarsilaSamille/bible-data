[{"verse":1,"text":"奮い立て、奮い立て力をまとえ、シオンよ。輝く衣をまとえ、聖なる都、エルサレムよ。無割礼の汚れた者があなたの中に攻め込むことは再び起こらない。","tok":[["奮い立て","ふるいたて"],["、"],["奮い立て","ふるいたて"],["力","ちから"],["を"],["まとえ"],["、"],["シオン"],["よ"],["。"],["輝く","かがやく"],["衣","ころも"],["を"],["まとえ"],["、"],["聖","せい"],["なる"],["都","と"],["、"],["エルサレム"],["よ"],["。"],["無","む"],["割礼","かつれい"],["の"],["汚れた","よごれた"],["者","もの"],["が"],["あなた"],["の"],["中","なか"],["に"],["攻め込む","せめこむ"],["こと"],["は"],["再び","ふたたび"],["起こらない","おこらない"],["。"]]},{"verse":2,"text":"立ち上がって塵を払え、捕らわれのエルサレム。首の縄目を解け、捕らわれの娘シオンよ。","tok":[["立ち上がって","たちあがって"],["塵","ごみ"],["を"],["払え","はらえ"],["、"],["捕らわれ","とらわれ"],["の"],["エルサレム"],["。"],["首","くび"],["の"],["縄目","なわめ"],["を"],["解け","とけ"],["、"],["捕らわれ","とらわれ"],["の"],["娘","むすめ"],["シオン"],["よ"],["。"]]},{"verse":3,"text":"主はこう言われる。「ただ同然で売られたあなたたちは銀によらずに買い戻される」と。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["ただ"],["同然","どうぜん"],["で"],["売られた","うられた"],["あなた"],["たち"],["は"],["銀","ぎん"],["に"],["よらず"],["に"],["買い戻される","かいもどされる"],["」"],["と"],["。"]]},{"verse":4,"text":"主なる神はこう言われる。初め、わたしの民はエジプトに下り、そこに宿った。また、アッシリア人は故なくこの民を搾取した。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["初め","はじめ"],["、"],["わたし"],["の"],["民","たみ"],["は"],["エジプト"],["に"],["下り","くだり"],["、"],["そこ"],["に"],["宿った","やどった"],["。"],["また"],["、"],["アッシリア"],["人","にん"],["は"],["故","ゆえ"],["なく"],["この"],["民","たみ"],["を"],["搾取","さくしゅ"],["した"],["。"]]},{"verse":5,"text":"そして今、ここで起こっていることは何か、と主は言われる。わたしの民はただ同然で奪い去られ、支配者たちはわめき、わたしの名は常に、そして絶え間なく侮られている、と主は言われる。","tok":[["そして"],["今","いま"],["、"],["ここ"],["で"],["起こって","おこって"],["いる"],["こと"],["は"],["何","なん"],["か"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["の"],["民","たみ"],["は"],["ただ"],["同然","どうぜん"],["で"],["奪い去られ","うばいさられ"],["、"],["支配者","しはいしゃ"],["たち"],["は"],["わめき"],["、"],["わたし"],["の"],["名","な"],["は"],["常","つね"],["に"],["、"],["そして"],["絶え間","たえま"],["なく"],["侮られて","あなどられて"],["いる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"それゆえ、わたしの民はわたしの名を知るであろう。それゆえその日には、わたしが神であることを、「見よ、ここにいる」と言う者であることを知るようになる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["の"],["民","たみ"],["は"],["わたし"],["の"],["名","な"],["を"],["知るで","しるで"],["あろう"],["。"],["それ"],["ゆえ"],["その"],["日","ひ"],["に"],["は"],["、"],["わたし"],["が"],["神","かみ"],["で"],["ある"],["こと"],["を"],["、"],["「"],["見よ","みよ"],["、"],["ここ"],["に"],["いる"],["」"],["と"],["言う","いう"],["者","もの"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":7,"text":"いかに美しいことか山々を行き巡り、良い知らせを伝える者の足は。彼は平和を告げ、恵みの良い知らせを伝え救いを告げあなたの神は王となられた、とシオンに向かって呼ばわる。","tok":[["いかに"],["美しい","うつくしい"],["こと"],["か"],["山々","やまやま"],["を"],["行き","いき"],["巡り","めぐり"],["、"],["良い","よい"],["知らせ","しらせ"],["を"],["伝える","つたえる"],["者","もの"],["の"],["足","あし"],["は"],["。"],["彼","かれ"],["は"],["平和","へいわ"],["を"],["告げ","つげ"],["、"],["恵み","めぐみ"],["の"],["良い","よい"],["知らせ","しらせ"],["を"],["伝え","つたえ"],["救い","すくい"],["を"],["告げ","つげ"],["あなた"],["の"],["神","かみ"],["は"],["王","おう"],["と"],["なられた"],["、"],["と"],["シオン"],["に"],["向かって","むかって"],["呼ばわる","よばわる"],["。"]]},{"verse":8,"text":"その声に、あなたの見張りは声をあげ皆共に、喜び歌う。彼らは目の当たりに見る主がシオンに帰られるのを。","tok":[["その"],["声","こえ"],["に"],["、"],["あなた"],["の"],["見張り","みはり"],["は"],["声","こえ"],["を"],["あげ"],["皆","みな"],["共","とも"],["に"],["、"],["喜び歌う","よろこびうたう"],["。"],["彼","かれ"],["ら"],["は"],["目の当たり","まのあたり"],["に"],["見る","みる"],["主","ぬし"],["が"],["シオン"],["に"],["帰られる","かえられる"],["の"],["を"],["。"]]},{"verse":9,"text":"歓声をあげ、共に喜び歌え、エルサレムの廃虚よ。主はその民を慰め、エルサレムを贖われた。","tok":[["歓声","かんせい"],["を"],["あげ"],["、"],["共","とも"],["に"],["喜び歌え","よろこびうたえ"],["、"],["エルサレム"],["の"],["廃虚","はいきょ"],["よ"],["。"],["主","ぬし"],["は"],["その"],["民","たみ"],["を"],["慰め","なぐさめ"],["、"],["エルサレム"],["を"],["贖われた","あがなわれた"],["。"]]},{"verse":10,"text":"主は聖なる御腕の力を国々の民の目にあらわにされた。地の果てまで、すべての人がわたしたちの神の救いを仰ぐ。","tok":[["主","ぬし"],["は"],["聖","せい"],["なる"],["御腕","おうで"],["の"],["力","ちから"],["を"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["目","め"],["に"],["あらわ"],["に"],["された"],["。"],["地","ち"],["の"],["果て","はて"],["まで"],["、"],["すべて"],["の"],["人","ひと"],["が"],["わたしたち"],["の"],["神","かみ"],["の"],["救い","すくい"],["を"],["仰ぐ","あおぐ"],["。"]]},{"verse":11,"text":"立ち去れ、立ち去れ、そこを出よ汚れたものに触れるな。その中から出て、身を清めよ主の祭具を担う者よ。","tok":[["立ち去れ","たちされ"],["、"],["立ち去れ","たちされ"],["、"],["そこ"],["を"],["出よ","でよ"],["汚れた","よごれた"],["もの"],["に"],["触れる","ふれる"],["な"],["。"],["その"],["中","なか"],["から"],["出て","でて"],["、"],["身","み"],["を"],["清めよ","きよめよ"],["主","ぬし"],["の"],["祭具","さいぐ"],["を"],["担う","になう"],["者","もの"],["よ"],["。"]]},{"verse":12,"text":"しかし、急いで出る必要はない逃げ去ることもない。あなたたちの先を進むのは主でありしんがりを守るのもイスラエルの神だから。","tok":[["しかし"],["、"],["急いで","いそいで"],["出る","でる"],["必要","ひつよう"],["は"],["ない"],["逃げ去る","にげさる"],["こと"],["も"],["ない"],["。"],["あなた"],["たち"],["の"],["先","さき"],["を"],["進む","すすむ"],["の"],["は"],["主","ぬし"],["で"],["あり"],["しんがり"],["を"],["守る","まもる"],["の"],["も"],["イスラエル"],["の"],["神","かみ"],["だ"],["から"],["。"]]},{"verse":13,"text":"見よ、わたしの僕は栄える。はるかに高く上げられ、あがめられる。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["僕","ぼく"],["は"],["栄える","さかえる"],["。"],["はるか"],["に"],["高く","たかく"],["上げられ","あげられ"],["、"],["あがめられる"],["。"]]},{"verse":14,"text":"かつて多くの人をおののかせたあなたの姿のように彼の姿は損なわれ、人とは見えずもはや人の子の面影はない。","tok":[["かつて"],["多く","おおく"],["の"],["人","ひと"],["を"],["おののかせた"],["あなた"],["の"],["姿","すがた"],["の"],["よう"],["に"],["彼","かれ"],["の"],["姿","すがた"],["は"],["損なわれ","そこなわれ"],["、"],["人","ひと"],["と"],["は"],["見えず","みえず"],["もはや"],["人","ひと"],["の"],["子","こ"],["の"],["面影","おもかげ"],["は"],["ない"],["。"]]},{"verse":15,"text":"それほどに、彼は多くの民を驚かせる。彼を見て、王たちも口を閉ざす。だれも物語らなかったことを見一度も聞かされなかったことを悟ったからだ。","tok":[["それ"],["ほど"],["に"],["、"],["彼","かれ"],["は"],["多く","おおく"],["の"],["民","たみ"],["を"],["驚かせる","おどろかせる"],["。"],["彼","かれ"],["を"],["見て","みて"],["、"],["王","おう"],["たち"],["も"],["口","くち"],["を"],["閉ざす","とざす"],["。"],["だれ"],["も"],["物語らなかった","ものがたらなかった"],["こと"],["を"],["見","み"],["一度","いちど"],["も"],["聞かされなかった","きかされなかった"],["こと"],["を"],["悟った","さとった"],["から"],["だ"],["。"]]}]
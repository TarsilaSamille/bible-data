[{"verse":1,"text":"見よ、主なる万軍の神は支えとなり、頼みとなる者をまた、パンによる支え、水による支えをもエルサレムとユダから取り去られる。","tok":[["見よ","みよ"],["、"],["主","おも"],["なる"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["は"],["支え","ささえ"],["と"],["なり"],["、"],["頼み","たのみ"],["と"],["なる"],["者","もの"],["を"],["また"],["、"],["パン"],["に"],["よる"],["支え","ささえ"],["、"],["水","みず"],["に"],["よる"],["支え","ささえ"],["を"],["も"],["エルサレム"],["と"],["ユダ"],["から"],["取り去られる","とりさられる"],["。"]]},{"verse":2,"text":"勇士と戦士、裁きを行う者と預言者占い師と長老","tok":[["勇士","ゆうし"],["と"],["戦士","せんし"],["、"],["裁き","さばき"],["を"],["行う","おこなう"],["者","もの"],["と"],["預言者","よげんしゃ"],["占い師","うらないし"],["と"],["長老","ちょうろう"]]},{"verse":3,"text":"五十人の長と尊敬される者参議、魔術師、呪術師などを取り去られる。","tok":[["五","ご"],["十人","じゅうにん"],["の"],["長","ちょう"],["と"],["尊敬","そんけい"],["される"],["者","もの"],["参議","さんぎ"],["、"],["魔術師","まじゅつし"],["、"],["呪術師","じゅじゅつし"],["など"],["を"],["取り去られる","とりさられる"],["。"]]},{"verse":4,"text":"わたしは若者を支配者にした。気ままな者が国を治めるようになる。","tok":[["わたし"],["は"],["若者","わかもの"],["を"],["支配者","しはいしゃ"],["に"],["した"],["。"],["気まま","きまま"],["な"],["者","もの"],["が"],["国","くに"],["を"],["治める","おさめる"],["よう"],["に"],["なる"],["。"]]},{"verse":5,"text":"民は隣人どうしで虐げ合う。若者は長老に、卑しい者は尊い者に無礼を働く。","tok":[["民","みん"],["は"],["隣人","りんじん"],["どうし"],["で"],["虐げ","しいたげ"],["合う","あう"],["。"],["若者","わかもの"],["は"],["長老","ちょうろう"],["に"],["、"],["卑しい","いやしい"],["者","もの"],["は"],["尊い","とうとい"],["者","もの"],["に"],["無礼","ぶれい"],["を"],["働く","はたらく"],["。"]]},{"verse":6,"text":"人は父の家で兄弟に取りすがって言う。「お前にはまだ上着がある。我らの指導者になりこの破滅の始末をしてくれ」と。","tok":[["人","ひと"],["は"],["父","ちち"],["の"],["家","いえ"],["で"],["兄弟","きょうだい"],["に"],["取りすがって","とりすがって"],["言う","ゆう"],["。"],["「"],["お前","おまえ"],["に"],["は"],["まだ"],["上着","うわぎ"],["が"],["ある"],["。"],["我","われ"],["ら"],["の"],["指導者","しどうしゃ"],["に"],["なり"],["この"],["破滅","はめつ"],["の"],["始末","しまつ"],["を"],["して"],["くれ"],["」"],["と"],["。"]]},{"verse":7,"text":"だがその日には、彼も声をあげる。「わたしにも手当てはできない。家にはパンもなければ上着もない。わたしを民の指導者にしてもだめだ」と。","tok":[["だ"],["が"],["その"],["日","ひ"],["に"],["は"],["、"],["彼","かれ"],["も"],["声","こえ"],["を"],["あげる"],["。"],["「"],["わたし"],["に"],["も"],["手当て","てあて"],["は"],["できない"],["。"],["家","いえ"],["に"],["は"],["パン"],["も"],["なければ"],["上着","うわぎ"],["も"],["ない"],["。"],["わたし"],["を"],["民","たみ"],["の"],["指導者","しどうしゃ"],["に"],["して"],["も"],["だめ"],["だ"],["」"],["と"],["。"]]},{"verse":8,"text":"エルサレムはよろめき、ユダは倒れた。彼らは舌と行いをもって主に敵対しその栄光のまなざしに逆らった。","tok":[["エルサレム"],["は"],["よろめき"],["、"],["ユダ"],["は"],["倒れた","たおれた"],["。"],["彼","かれ"],["ら"],["は"],["舌","した"],["と"],["行い","おこない"],["を"],["もって"],["主に","おもに"],["敵対","てきたい"],["し"],["その"],["栄光","えいこう"],["の"],["まなざし"],["に"],["逆らった","さからった"],["。"]]},{"verse":9,"text":"彼らの表情が既に証言している。ソドムのような彼らの罪を表して、隠さない。災いだ、彼らは悪の報いを受ける。","tok":[["彼","かれ"],["ら"],["の"],["表情","ひょうじょう"],["が"],["既に","すでに"],["証言","しょうげん"],["して"],["いる"],["。"],["ソドム"],["の"],["よう"],["な"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["表して","あらわして"],["、"],["隠さない","かくさない"],["。"],["災い","わざわい"],["だ"],["、"],["彼","かれ"],["ら"],["は"],["悪","あく"],["の"],["報い","むくい"],["を"],["受ける","うける"],["。"]]},{"verse":10,"text":"しかし言え、主に従う人は幸い、と。彼らは自分の行いの実を食べることができる。","tok":[["しかし"],["言え","いえ"],["、"],["主に","おもに"],["従う","したがう"],["人","ひと"],["は"],["幸い","さいわい"],["、"],["と"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["行い","おこない"],["の"],["実","じつ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":11,"text":"主に逆らう悪人は災いだ。彼らはその手の業に応じて報いを受ける。","tok":[["主に","おもに"],["逆らう","さからう"],["悪人","あくにん"],["は"],["災い","わざわい"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["その"],["手","て"],["の"],["業","ごう"],["に"],["応じて","おうじて"],["報い","むくい"],["を"],["受ける","うける"],["。"]]},{"verse":12,"text":"わたしの民は、幼子に追い使われ女に支配されている。わたしの民よお前たちを導く者は、迷わせる者で行くべき道を乱す。","tok":[["わたし"],["の"],["民","たみ"],["は"],["、"],["幼子","おさなご"],["に"],["追い使われ","おいつかわれ"],["女","おんな"],["に"],["支配","しはい"],["されて"],["いる"],["。"],["わたし"],["の"],["民","たみ"],["よ"],["お前","おまえ"],["たち"],["を"],["導く","みちびく"],["者","もの"],["は"],["、"],["迷わせる","まよわせる"],["者","もの"],["で"],["行くべき","いくべき"],["道","みち"],["を"],["乱す","みだす"],["。"]]},{"verse":13,"text":"主は争うために構え民を裁くために立たれる。","tok":[["主","ぬし"],["は"],["争う","あらそう"],["ため"],["に"],["構え","かまえ"],["民","みん"],["を"],["裁く","さばく"],["ため"],["に"],["立たれる","たたれる"],["。"]]},{"verse":14,"text":"主は裁きに臨まれる民の長老、支配者らに対して。「お前たちはわたしのぶどう畑を食い尽くし貧しい者から奪って家を満たした。","tok":[["主","ぬし"],["は"],["裁き","さばき"],["に"],["臨まれる","のぞまれる"],["民","たみ"],["の"],["長老","ちょうろう"],["、"],["支配者","しはいしゃ"],["ら"],["に対して","にたいして"],["。"],["「"],["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["ぶどう"],["畑","はたけ"],["を"],["食い","くい"],["尽くし","つくし"],["貧しい","まずしい"],["者","もの"],["から"],["奪って","うばって"],["家","いえ"],["を"],["満たした","みたした"],["。"]]},{"verse":15,"text":"何故、お前たちはわたしの民を打ち砕き貧しい者の顔を臼でひきつぶしたのか」と主なる万軍の神は言われる。","tok":[["何故","なぜ"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["民","たみ"],["を"],["打ち砕き","うちくだき"],["貧しい","まずしい"],["者","もの"],["の"],["顔","かお"],["を"],["臼","うす"],["で"],["ひきつぶした"],["の"],["か"],["」"],["と"],["主","ぬし"],["なる"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":16,"text":"主は言われる。シオンの娘らは高慢で、首を伸ばして歩く。流し目を使い、気取って小股で歩き足首の飾りを鳴らしている。","tok":[["主","ぬし"],["は"],["言われる","いわれる"],["。"],["シオン"],["の"],["娘","むすめ"],["ら"],["は"],["高慢","こうまん"],["で"],["、"],["首","くび"],["を"],["伸ばして","のばして"],["歩く","あるく"],["。"],["流し目","ながしめ"],["を"],["使い","つかい"],["、"],["気取って","きどって"],["小股","こまた"],["で"],["歩き","あるき"],["足首","あしくび"],["の"],["飾り","かざり"],["を"],["鳴らして","ならして"],["いる"],["。"]]},{"verse":17,"text":"主はシオンの娘らの頭をかさぶたで覆い彼女らの額をあらわにされるであろう。","tok":[["主","ぬし"],["は"],["シオン"],["の"],["娘","むすめ"],["ら"],["の"],["頭","あたま"],["を"],["かさぶた"],["で"],["覆い","おおい"],["彼女","かのじょ"],["ら"],["の"],["額","がく"],["を"],["あらわ"],["に"],["されるで"],["あろう"],["。"]]},{"verse":18,"text":"その日には、主は飾られた美しさを奪われる。足首の飾り、額の飾り、三日月形の飾り、","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["主","ぬし"],["は"],["飾られた","かざられた"],["美し","うつくし"],["さ"],["を"],["奪われる","うばわれる"],["。"],["足首","あしくび"],["の"],["飾り","かざり"],["、"],["額","がく"],["の"],["飾り","かざり"],["、"],["三日月形","みかつきけい"],["の"],["飾り","かざり"],["、"]]},{"verse":19,"text":"耳輪、腕輪、ベール、","tok":[["耳輪","みみわ"],["、"],["腕輪","うでわ"],["、"],["ベール"],["、"]]},{"verse":20,"text":"頭飾り、すね飾り、飾り帯、匂袋、お守り、","tok":[["頭飾り","あたまかざり"],["、"],["す"],["ね"],["飾り","かざり"],["、"],["飾り帯","かざりおび"],["、"],["匂袋","においぶくろ"],["、"],["お守り","おまもり"],["、"]]},{"verse":21,"text":"指輪、鼻輪
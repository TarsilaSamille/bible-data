[{"verse":1,"text":"主はわたしに言われた。「大きな羊皮紙を取り、その上に分かりやすい書き方で、マヘル‧シャラル‧ハシュ‧バズ（分捕りは早く、略奪は速やかに来る）と書きなさい」と。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["大きな","おおきな"],["羊皮紙","ようひし"],["を"],["取り","とり"],["、"],["その"],["上","うえ"],["に"],["分かり","わかり"],["やすい"],["書き方","かきかた"],["で"],["、"],["マヘル"],["‧"],["シャラル"],["‧"],["ハシュ"],["‧"],["バズ"],["（"],["分捕り","ぶんどり"],["は"],["早く","はやく"],["、"],["略奪","りゃくだつ"],["は"],["速やか","すみやか"],["に"],["来る","くる"],["）"],["と"],["書き","かき"],["なさい"],["」"],["と"],["。"]]},{"verse":2,"text":"そのためにわたしは、祭司ウリヤとエベレクヤの子ゼカルヤを、信頼しうる証人として立てた。","tok":[["その"],["ため"],["に"],["わたし"],["は"],["、"],["祭司","さいし"],["ウリヤ"],["と"],["エベレクヤ"],["の"],["子","こ"],["ゼカルヤ"],["を"],["、"],["信頼","しんらい"],["し"],["うる"],["証人","しょうにん"],["として"],["立てた","たてた"],["。"]]},{"verse":3,"text":"わたしは女預言者に近づいた。彼女が身ごもって男の子を産むと、主はわたしに言われた。「この子にマヘル‧シャラル‧ハシュ‧バズという名を付けなさい。","tok":[["わたし"],["は"],["女","おんな"],["預言者","よげんしゃ"],["に"],["近づいた","ちかづいた"],["。"],["彼女","かのじょ"],["が"],["身ごもって","みごもって"],["男の子","おとこのこ"],["を"],["産む","うむ"],["と"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["この"],["子","こ"],["に"],["マヘル"],["‧"],["シャラル"],["‧"],["ハシュ"],["‧"],["バズ"],["と"],["いう"],["名","な"],["を"],["付け","つけ"],["なさい"],["。"]]},{"verse":4,"text":"この子がお父さん、お母さんと言えるようになる前に、ダマスコからはその富が、サマリアからはその戦利品が、アッシリアの王の前に運び去られる。」","tok":[["この"],["子","こ"],["が"],["お父さん","おとうさん"],["、"],["お母さん","おかあさん"],["と"],["言える","いえる"],["よう"],["に"],["なる"],["前","まえ"],["に"],["、"],["ダマスコ"],["から"],["は"],["その"],["富","とみ"],["が"],["、"],["サマリア"],["から"],["は"],["その"],["戦利品","せんりひん"],["が"],["、"],["アッシリア"],["の"],["王","おう"],["の"],["前","まえ"],["に"],["運び去られる","はこびさられる"],["。"],["」"]]},{"verse":5,"text":"主は重ねてわたしに語られた。","tok":[["主","ぬし"],["は"],["重ねて","かさねて"],["わたし"],["に"],["語られた","かたられた"],["。"]]},{"verse":6,"text":"「この民はゆるやかに流れるシロアの水を拒みレツィンとレマルヤの子のゆえにくずおれる。","tok":[["「"],["この"],["民","みん"],["は"],["ゆるやか"],["に"],["流れる","ながれる"],["シロア"],["の"],["水","みず"],["を"],["拒み","こばみ"],["レツィン"],["と"],["レマルヤ"],["の"],["子","こ"],["の"],["ゆえ"],["に"],["くずおれる"],["。"]]},{"verse":7,"text":"それゆえ、見よ、主は大河の激流を彼らの上に襲いかからせようとしておられる。すなわち、アッシリアの王とそのすべての栄光を。激流はどの川床も満たし至るところで堤防を越え","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["主","ぬし"],["は"],["大河","たいが"],["の"],["激流","げきりゅう"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["襲いかからせよう","おそいかからせよう"],["として"],["おられる"],["。"],["すなわち"],["、"],["アッシリア"],["の"],["王","おう"],["と"],["その"],["すべて"],["の"],["栄光","えいこう"],["を"],["。"],["激流","げきりゅう"],["は"],["どの"],["川床","かわどこ"],["も"],["満たし","みたし"],["至るところ","いたるところ"],["で"],["堤防","ていぼう"],["を"],["越え","こえ"]]},{"verse":8,"text":"ユダにみなぎり、首に達し、溢れ、押し流す。その広げた翼はインマヌエルよ、あなたの国土を覆い尽くす。」","tok":[["ユダ"],["に"],["みなぎり"],["、"],["首","くび"],["に"],["達し","たっし"],["、"],["溢れ","あふれ"],["、"],["押し流す","おしながす"],["。"],["その"],["広げた","ひろげた"],["翼","つばさ"],["は"],["インマヌエル"],["よ"],["、"],["あなた"],["の"],["国土","こくど"],["を"],["覆い","おおい"],["尽くす","つくす"],["。"],["」"]]},{"verse":9,"text":"諸国の民よ、連合せよ、だがおののけ。遠い国々よ、共に耳を傾けよ。武装せよ、だが、おののけ。武装せよ、だが、おののけ。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["よ"],["、"],["連合","れんごう"],["せよ"],["、"],["だ"],["が"],["おののけ"],["。"],["遠い","とおい"],["国々","くにぐに"],["よ"],["、"],["共","とも"],["に"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["武装","ぶそう"],["せよ"],["、"],["だ"],["が"],["、"],["おののけ"],["。"],["武装","ぶそう"],["せよ"],["、"],["だ"],["が"],["、"],["おののけ"],["。"]]},{"verse":10,"text":"戦略を練るがよい、だが、挫折する。決定するがよい、だが、実現することはない。神が我らと共におられる（インマヌエル）のだから。","tok":[["戦略","せんりゃく"],["を"],["練る","ねる"],["がよい"],["、"],["だ"],["が"],["、"],["挫折","ざせつ"],["する"],["。"],["決定","けってい"],["する"],["がよい"],["、"],["だ"],["が"],["、"],["実現","じつげん"],["する"],["こと"],["は"],["ない"],["。"],["神","かみ"],["が"],["我","われ"],["ら"],["と"],["共","とも"],["に"],["おられる"],["（"],["インマヌエル"],["）"],["の"],["だ"],["から"],["。"]]},{"verse":11,"text":"主は御手をもってわたしをとらえ、この民の行く道を行かないように戒めて言われた。","tok":[["主","ぬし"],["は"],["御手","おて"],["を"],["もって"],["わたし"],["を"],["とらえ"],["、"],["この"],["民","たみ"],["の"],["行く","いく"],["道","みち"],["を"],["行かない","いかない"],["よう"],["に"],["戒めて","いましめて"],["言われた","いわれた"],["。"]]},{"verse":12,"text":"あなたたちはこの民が同盟と呼ぶものを何一つ同盟と呼んではならない。彼らが恐れるものを、恐れてはならない。その前におののいてはならない。","tok":[["あなた"],["たち"],["は"],["この"],["民","たみ"],["が"],["同盟","どうめい"],["と"],["呼ぶ","よぶ"],["もの"],["を"],["何","なん"],["一","ひと"],["つ"],["同盟","どうめい"],["と"],["呼んで","よんで"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["恐れる","おそれる"],["もの"],["を"],["、"],["恐れて","おそれて"],["は"],["ならない"],["。"],["その"],["前","まえ"],["に"],["おののいて"],["は"],["ならない"],["。"]]},{"verse":13,"text":"万軍の主をのみ、聖なる方とせよ。あなたたちが畏るべき方は主。御前におののくべき方は主。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["を"],["のみ"],["、"],["聖","せい"],["なる"],["方","かた"],["と"],["せよ"],["。"],["あなた"],["たち"],["が"],["畏るべき","かしこまるべき"],["方","かた"],["は"],["主","ぬし"],["。"],["御前","ごぜん"],["に"],["おののくべき"],["方","かた"],["は"],["主","ぬし"],["。"]]},{"verse":14,"text":"主は聖所にとっては、つまずきの石イスラエルの両王国にとっては、妨げの岩エルサレムの住民にとっては仕掛け網となり、罠となられる。","tok":[["主","ぬし"],["は"],["聖","せい"],["所","しょ"],["にとって"],["は"],["、"],["つまずき"],["の"],["石","いし"],["イスラエル"],["の"],["両王国","りょうおうこく"],["にとって"],["は"],["、"],["妨げ","さまたげ"],["の"],["岩","いわ"],["エルサレム"],["の"],["住民","じゅうみん"],["にとって"],["は"],["仕掛け網","しかけもう"],["と"],["なり"],["、"],["罠","わな"],["と"],["なられる"],["。"]]},{"verse":15,"text":"多くの者がこれに妨げられ、倒れて打ち砕かれ罠にかかって捕らえられる。","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["これ"],["に"],["妨げられ","さまたげられ"],["、"],["倒れて","たおれて"],["打ち砕かれ","うちくだかれ"],["罠","わな"],["に"],["かかって"],["捕らえられる","とらえられる"],["。"]]},{"verse":16,"text":"わたしは弟子たちと共に証しの書を守り、教えを封じておこう。","tok":[["わたし"],["は"],["弟子","でし"],["たち"],["と"],["共","とも"],["に"],["証し","あかし"],["の"],["書","しょ"],["を"],["守り","まもり"],["、"],["教え","おしえ"],["を"],["封じて","ふうじて"],["おこう"],["。"]]},{"verse":17,"text":"わたしは主を待ち望む。主は御顔をヤコブの家に隠しておられるがなおわたしは、彼に望みをかける。","tok":[["わたし"],["は"],["主","ぬし"],["を"],["待ち望む","まちのぞむ"],["。"],["主","ぬし"],["は"],["御顔","おかお"],["を"],["ヤコブ"],["の"],["家","いえ"],["に"],["隠して","かくして"],["おられる"],["が"],["なお"],["わたし"],["は"],["、"],["彼","かれ"],["に"],["望み","のぞみ"],["を"],["かける"],["。"]]},{"verse":18,"text":"見よ、わたしと、主がわたしにゆだねられた子らは、シオンの山に住まわれる万軍の主が与えられたイスラエルのしるしと奇跡である。","tok":[["見よ","みよ"],["、"],["わたし"],["と"],["、"],["主","ぬし"],["が"],["わたし"],["に"],["ゆだねられた"],["子","こ"],["ら"],["は"],["、"],["シオン"],["の"],["山","やま"],["に"],["住まわれる","すまわれる"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["与えられた","あたえられた"],["イスラエル"],["の"],["しるし"],["と"],["奇跡","きせき"],["で"],["ある"],["。"]]},{"verse":19,"text":"人々は必ずあなたたちに言う。「ささやきつぶやく口寄せや、霊媒に伺いを立てよ。民は、命ある者のために、死者によって、自分の神に伺いを立てるべきではないか」と。","tok":[["人々","ひとびと"],["は"],["必ず","かならず"],["あなた"],["たち"],["に"],["言う","ゆう"],["。"],["「"],["ささやき"],["つぶやく"],["口寄せ","くちよせ"],["や"],["、"],["霊媒","れいばい"],["に"],["伺い","うかがい"],["を"],["立て","たて"],["よ"],["。"],["民","たみ"],["は"],["、"],["命","いのち"],["ある"],["者","もの"],["の"],["ため"],["に"],["、"],["死者","ししゃ"],["によって"],["、"],["自分","じぶん"],["の"],["神","かみ"],["に"],["伺い","うかがい"],["を"],["立てるべきで","たてるべきで"],["は"],["ない"],["か"],["」"],["と"],["。"]]},{"verse":20,"text":"そして、教えと証しの書についてはなおのこと、「このような言葉にまじないの力はない」と言うであろう。","tok":[["そして"],["、"],["教え","おしえ"],["と"],["証し","あかし"],["の"],["書","しょ"],["について"],["は"],["なお"],["の"],["こと"],["、"],["「"],["この"],["よう"],["な"],["言葉","ことば"],["に"],["まじない"],["の"],["力","ちから"],["は"],["ない"],["」"],["と"],["言うで","ゆうで"],["あろう"],["。"]]},{"verse":21,"text":"この地で、彼らは苦しみ、飢えてさまよう。民は飢えて憤り、顔を天に向けて王と神を呪う。","tok":[["この"],["地","ち"],["で"],["、"],["彼","かれ"],["ら"],["は"],["苦しみ","くるしみ"],["、"],["飢えて","うえて"],["さまよう"],["。"],["民","たみ"],["は"],["飢えて","うえて"],["憤り","いきどおり"],["、"],["顔","かお"],["を"],["天","てん"],["に"],["向けて","むけて"],["王","おう"],["と"],["神","かみ"],["を"],["呪う","のろう"],["。"]]},{"verse":22,"text":"地を見渡せば、見よ、苦難と闇、暗黒と苦悩、暗闇と追放。","tok":[["地","ち"],["を"],["見渡せば","みわたせば"],["、"],["見よ","みよ"],["、"],["苦難","くなん"],["と"],["闇","やみ"],["、"],["暗黒","あんこく"],["と"],["苦悩","くのう"],["、"],["暗闇","くらやみ"],["と"],["追放","ついほう"],["。"]]},{"verse":23,"text":"今、苦悩の中にある人々には逃れるすべがない。ダビデの位先にゼブルンの地、ナフタリの地は辱めを受けたが後には、海沿いの道、ヨルダン川のかなた異邦人のガリラヤは、栄光を受ける。","tok":[["今","いま"],["、"],["苦悩","くのう"],["の"],["中","なか"],["に"],["ある"],["人々","ひとびと"],["に"],["は"],["逃れる","のがれる"],["すべ"],["が"],["ない"],["。"],["ダビデ"],["の"],["位","くらい"],["先","さき"],["に"],["ゼブルン"],["の"],["地","ち"],["、"],["ナフタリ"],["の"],["地","ち"],["は"],["辱め","はずかしめ"],["を"],["受けた","うけた"],["が"],["後","あと"],["に"],["は"],["、"],["海沿い","うみぞい"],["の"],["道","みち"],["、"],["ヨルダン"],["川","かわ"],["の"],["かなた"],["異邦人","いほうじん"],["の"],["ガリラヤ"],["は"],["、"],["栄光","えいこう"],["を"],["受ける","うける"],["。"]]}]
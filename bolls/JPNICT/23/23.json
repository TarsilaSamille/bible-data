[{"verse":1,"text":"ティルスについての託宣。泣き叫べ、タルシシュの船よ。ティルスは破壊され、住む家もなくなった。キティムの地から帰るやいなや彼らはそのことを知らされた。","tok":[["ティルス"],["について"],["の"],["託宣","たくせん"],["。"],["泣き叫べ","なきさけべ"],["、"],["タルシシュ"],["の"],["船","ふね"],["よ"],["。"],["ティルス"],["は"],["破壊","はかい"],["され"],["、"],["住む","すむ"],["家","いえ"],["も"],["なくなった"],["。"],["キティム"],["の"],["地","ち"],["から"],["帰る","かえる"],["や"],["いな"],["や"],["彼","かれ"],["ら"],["は"],["その"],["こと"],["を"],["知らされた","しらされた"],["。"]]},{"verse":2,"text":"嘆け、海辺の住人たちシドンの貿易商たちよ。お前の使者たちは海を渡り","tok":[["嘆け","なげけ"],["、"],["海辺","うみべ"],["の"],["住人","じゅうにん"],["たち"],["シドン"],["の"],["貿易商","ぼうえきしょう"],["たち"],["よ"],["。"],["お前","おまえ"],["の"],["使者","ししゃ"],["たち"],["は"],["海","うみ"],["を"],["渡り","わたり"]]},{"verse":3,"text":"大いなる水を越えて行きシホルの穀物、ナイルの収穫がお前の収入となりお前は国々の行き交う場所であった。","tok":[["大いなる","おおいなる"],["水","みず"],["を"],["越えて","こえて"],["行き","いき"],["シホル"],["の"],["穀物","こくもつ"],["、"],["ナイル"],["の"],["収穫","しゅうかく"],["が"],["お前","おまえ"],["の"],["収入","しゅうにゅう"],["と"],["なり"],["お前","おまえ"],["は"],["国々","くにぐに"],["の"],["行き交う","いきかう"],["場所","ばしょ"],["で"],["あった"],["。"]]},{"verse":4,"text":"うろたえよ、海の砦シドンよ。海がこう言っている。「わたしは産みの苦しみをしない。子を産み、若者を育ておとめらを、はぐくむことはできない」と。","tok":[["うろたえよ"],["、"],["海","うみ"],["の"],["砦","とりで"],["シドン"],["よ"],["。"],["海","うみ"],["が"],["こう"],["言って","いって"],["いる"],["。"],["「"],["わたし"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["しない"],["。"],["子","こ"],["を"],["産み","うみ"],["、"],["若者","わかもの"],["を"],["育て","そだて"],["おとめ"],["ら"],["を"],["、"],["はぐくむ"],["こと"],["は"],["できない"],["」"],["と"],["。"]]},{"verse":5,"text":"この知らせがエジプトに達したとき人々はおののいたティルスについての知らせを聞いたときのように。","tok":[["この"],["知らせ","しらせ"],["が"],["エジプト"],["に"],["達した","たっした"],["とき"],["人々","ひとびと"],["は"],["おののいた"],["ティルス"],["について"],["の"],["知らせ","しらせ"],["を"],["聞いた","きいた"],["とき"],["の"],["よう"],["に"],["。"]]},{"verse":6,"text":"渡って行け、タルシシュに。泣き叫べ、海辺の住人たちよ。","tok":[["渡って","わたって"],["行け","いけ"],["、"],["タルシシュ"],["に"],["。"],["泣き叫べ","なきさけべ"],["、"],["海辺","うみべ"],["の"],["住人","じゅうにん"],["たち"],["よ"],["。"]]},{"verse":7,"text":"これがお前たちの陽気だった海辺の町か。町の初めは、遠い昔にさかのぼり足である船は、移住の地を求めて遠くへ市民を運んだ。","tok":[["これ"],["が"],["お前","おまえ"],["たち"],["の"],["陽気","ようき"],["だった"],["海辺","うみべ"],["の"],["町","まち"],["か"],["。"],["町","まち"],["の"],["初め","はじめ"],["は"],["、"],["遠い","とおい"],["昔","むかし"],["に"],["さかのぼり"],["足","あし"],["で"],["ある"],["船","ふね"],["は"],["、"],["移住","いじゅう"],["の"],["地","ち"],["を"],["求めて","もとめて"],["遠く","とおく"],["へ"],["市民","しみん"],["を"],["運んだ","はこんだ"],["。"]]},{"verse":8,"text":"ティルスに対してこのように定めた者は誰か。ティルスは王冠を戴き、その貿易商人たちは貴族。取り引きする者らは世界に重んじられていた。","tok":[["ティルス"],["に対して","にたいして"],["この"],["よう"],["に"],["定めた","さだめた"],["者","もの"],["は"],["誰","だれ"],["か"],["。"],["ティルス"],["は"],["王冠","おうかん"],["を"],["戴き","いただき"],["、"],["その"],["貿易","ぼうえき"],["商人","しょうにん"],["たち"],["は"],["貴族","きぞく"],["。"],["取り引き","とりひき"],["する"],["者","もの"],["ら"],["は"],["世界","せかい"],["に"],["重んじられて","おもんじられて"],["いた"],["。"]]},{"verse":9,"text":"それを定められたのは万軍の主である。ティルスの誇る美しさをことごとく汚し世界に重んじられていた者をすべて辱めることを。","tok":[["それ"],["を"],["定められた","さだめられた"],["の"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["で"],["ある"],["。"],["ティルス"],["の"],["誇る","ほこる"],["美し","うつくし"],["さ"],["を"],["ことごとく"],["汚し","よごし"],["世界","せかい"],["に"],["重んじられて","おもんじられて"],["いた"],["者","もの"],["を"],["すべて"],["辱める","はずかしめる"],["こと"],["を"],["。"]]},{"verse":10,"text":"娘タルシシュよナイルのように、お前の国を越えて行けもはや、遮るものはない。","tok":[["娘","むすめ"],["タルシシュ"],["よ"],["ナイル"],["の"],["よう"],["に"],["、"],["お前","おまえ"],["の"],["国","くに"],["を"],["越えて","こえて"],["行け","いけ"],["もはや"],["、"],["遮る","さえぎる"],["もの"],["は"],["ない"],["。"]]},{"verse":11,"text":"主は御手を海に伸ばして国々を震わせカナンに命じて、その砦を破壊される。","tok":[["主","ぬし"],["は"],["御手","おて"],["を"],["海","うみ"],["に"],["伸ばして","のばして"],["国々","くにぐに"],["を"],["震わせ","ふるわせ"],["カナン"],["に"],["命じて","めいじて"],["、"],["その"],["砦","とりで"],["を"],["破壊","はかい"],["される"],["。"]]},{"verse":12,"text":"主は言われた。「お前は、二度と陽気な町ではありえない。犯された娘である、おとめシドンよ立て、キティムへ渡れ。しかし、そこでもお前は休みを得ない」と。","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["お前","おまえ"],["は"],["、"],["二","に"],["度","ど"],["と"],["陽気","ようき"],["な"],["町","まち"],["で"],["は"],["あり"],["えない"],["。"],["犯された","おかされた"],["娘","むすめ"],["で"],["ある"],["、"],["おとめ"],["シドン"],["よ"],["立て","たて"],["、"],["キティム"],["へ"],["渡れ","わたれ"],["。"],["しかし"],["、"],["そこ"],["で"],["も"],["お前","おまえ"],["は"],["休み","やすみ"],["を"],["得ない","えない"],["」"],["と"],["。"]]},{"verse":13,"text":"カルデアの地もそのようだ。それはもはや存在しない民。アッシリアは、彼らを荒野の獣に渡した。人々は見張りの塔を建て館を建て連ねたがすべては廃虚に帰している。","tok":[["カルデア"],["の"],["地","ち"],["も"],["その"],["よう"],["だ"],["。"],["それ"],["は"],["もはや"],["存在","そんざい"],["しない"],["民","たみ"],["。"],["アッシリア"],["は"],["、"],["彼","かれ"],["ら"],["を"],["荒野","あらの"],["の"],["獣","けもの"],["に"],["渡した","わたした"],["。"],["人々","ひとびと"],["は"],["見張り","みはり"],["の"],["塔","とう"],["を"],["建て","たて"],["館","かん"],["を"],["建て連ねた","たてつらねた"],["が"],["すべて"],["は"],["廃虚","はいきょ"],["に"],["帰して","かえして"],["いる"],["。"]]},{"verse":14,"text":"泣き叫べ、タルシシュの船よお前たちの砦は破壊されてしまった。","tok":[["泣き叫べ","なきさけべ"],["、"],["タルシシュ"],["の"],["船","ふね"],["よ"],["お前","おまえ"],["たち"],["の"],["砦","とりで"],["は"],["破壊","はかい"],["されて"],["しまった"],["。"]]},{"verse":15,"text":"その日が来るとティルスは、一人の王の生涯に等しい七十年の間忘れられているがその七十年が終わるとティルスは遊女の歌にうたわれているようになる。","tok":[["その"],["日","ひ"],["が"],["来る","くる"],["と"],["ティルス"],["は"],["、"],["一人","ひとり"],["の"],["王","おう"],["の"],["生涯","しょうがい"],["に"],["等しい","ひとしい"],["七十","ななじゅう"],["年","ねん"],["の"],["間","あいだ"],["忘れられて","わすれられて"],["いる"],["が"],["その"],["七十","ななじゅう"],["年","ねん"],["が"],["終わる","おわる"],["と"],["ティルス"],["は"],["遊女","ゆうじょ"],["の"],["歌","うた"],["に"],["うたわれて"],["いる"],["よう"],["に"],["なる"],["。"]]},{"verse":16,"text":"「竪琴を取れ、町を巡れ忘れられた遊女よ。巧みに奏でよ、多くの歌をうたえ思い出されるために。」","tok":[["「"],["竪琴","たてごと"],["を"],["取れ","とれ"],["、"],["町","まち"],["を"],["巡れ","めぐれ"],["忘れられた","わすれられた"],["遊女","ゆうじょ"],["よ"],["。"],["巧み","たくみ"],["に"],["奏でよ","かなでよ"],["、"],["多く","おおく"],["の"],["歌","うた"],["を"],["うたえ"],["思い出される","おもいだされる"],["ため"],["に"],["。"],["」"]]},{"verse":17,"text":"七十年が終わると、主はティルスを顧みられる。そのとき、彼女は再び遊女の報酬を取り、地上にある世界のすべての国々と姦淫する。","tok":[["七十","ななじゅう"],["年","ねん"],["が"],["終わる","おわる"],["と"],["、"],["主","ぬし"],["は"],["ティルス"],["を"],["顧みられる","かえりみられる"],["。"],["その"],["とき"],["、"],["彼女","かのじょ"],["は"],["再び","ふたたび"],["遊女","ゆうじょ"],["の"],["報酬","ほうしゅう"],["を"],["取り","とり"],["、"],["地上","ちじょう"],["に"],["ある"],["世界","せかい"],["の"],["すべて"],["の"],["国々","くにぐに"],["と"],["姦淫","かんいん"],["する"],["。"]]},{"verse":18,"text":"しかし彼女の利益と報酬は、主の聖なるものとなり、積み上げられも、蓄えられもしない。主の御前に住む者たちの利益となり、彼らは飽きるほど食べ、華やかに装う。","tok":[["しかし"],["彼女","かのじょ"],["の"],["利益","りえき"],["と"],["報酬","ほうしゅう"],["は"],["、"],["主","ぬし"],["の"],["聖","せい"],["なる"],["もの"],["と"],["なり"],["、"],["積み上げられ","つみあげられ"],["も"],["、"],["蓄えられ","たくわえられ"],["も"],["しない"],["。"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["住む","すむ"],["者","もの"],["たち"],["の"],["利益","りえき"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["飽きる","あきる"],["ほど"],["食べ","たべ"],["、"],["華やか","はなやか"],["に"],["装う","よそおう"],["。"]]}]
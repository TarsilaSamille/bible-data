[{"verse":1,"text":"主はこう言われる。正義を守り、恵みの業を行え。わたしの救いが実現しわたしの恵みの業が現れるのは間近い。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["正義","せいぎ"],["を"],["守り","まもり"],["、"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["行え","おこなえ"],["。"],["わたし"],["の"],["救い","すくい"],["が"],["実現","じつげん"],["し"],["わたし"],["の"],["恵み","めぐみ"],["の"],["業","ごう"],["が"],["現れる","あらわれる"],["の"],["は"],["間近い","まじかい"],["。"]]},{"verse":2,"text":"いかに幸いなことか、このように行う人それを固く守る人の子は。安息日を守り、それを汚すことのない人悪事に手をつけないように自戒する人は。","tok":[["いかに"],["幸い","さいわい"],["な"],["こと"],["か"],["、"],["この"],["よう"],["に"],["行う","おこなう"],["人","ひと"],["それ"],["を"],["固く","かたく"],["守る","まもる"],["人","ひと"],["の"],["子","こ"],["は"],["。"],["安息日","あんそくび"],["を"],["守り","まもり"],["、"],["それ"],["を"],["汚す","けがす"],["こと"],["の"],["ない"],["人","ひと"],["悪事","あくじ"],["に"],["手","て"],["を"],["つけない"],["よう"],["に"],["自戒","じかい"],["する"],["人","ひと"],["は"],["。"]]},{"verse":3,"text":"主のもとに集って来た異邦人は言うな主は御自分の民とわたしを区別される、と。宦官も、言うな見よ、わたしは枯れ木にすぎない、と。","tok":[["主","ぬし"],["の"],["もと"],["に"],["集って","つどって"],["来た","きた"],["異邦人","いほうじん"],["は"],["言うな","ゆうな"],["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["と"],["わたし"],["を"],["区別","くべつ"],["される"],["、"],["と"],["。"],["宦官","かんがん"],["も"],["、"],["言うな","ゆうな"],["見よ","みよ"],["、"],["わたし"],["は"],["枯れ木","かれき"],["に"],["すぎない"],["、"],["と"],["。"]]},{"verse":4,"text":"なぜなら、主はこう言われる宦官が、わたしの安息日を常に守りわたしの望むことを選びわたしの契約を固く守るなら","tok":[["なぜ"],["なら"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["宦官","かんがん"],["が"],["、"],["わたし"],["の"],["安息日","あんそくび"],["を"],["常","つね"],["に"],["守り","まもり"],["わたし"],["の"],["望む","のぞむ"],["こと"],["を"],["選び","えらび"],["わたし"],["の"],["契約","けいやく"],["を"],["固く","かたく"],["守るなら","まもるなら"]]},{"verse":5,"text":"わたしは彼らのために、とこしえの名を与え息子、娘を持つにまさる記念の名をわたしの家、わたしの城壁に刻む。その名は決して消し去られることがない。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["、"],["とこしえ"],["の"],["名","な"],["を"],["与え","あたえ"],["息子","むすこ"],["、"],["娘","むすめ"],["を"],["持つ","もつ"],["に"],["まさる"],["記念","きねん"],["の"],["名","な"],["を"],["わたし"],["の"],["家","いえ"],["、"],["わたし"],["の"],["城壁","じょうへき"],["に"],["刻む","きざむ"],["。"],["その"],["名","な"],["は"],["決して","けっして"],["消し去られる","けしさられる"],["こと"],["が"],["ない"],["。"]]},{"verse":6,"text":"また、主のもとに集って来た異邦人が主に仕え、主の名を愛し、その僕となり安息日を守り、それを汚すことなくわたしの契約を固く守るなら","tok":[["また"],["、"],["主","ぬし"],["の"],["もと"],["に"],["集って","つどって"],["来た","きた"],["異邦人","いほうじん"],["が"],["主に","おもに"],["仕え","つかえ"],["、"],["主","ぬし"],["の"],["名","な"],["を"],["愛し","あいし"],["、"],["その"],["僕","ぼく"],["と"],["なり"],["安息日","あんそくび"],["を"],["守り","まもり"],["、"],["それ"],["を"],["汚す","けがす"],["こと"],["なく"],["わたし"],["の"],["契約","けいやく"],["を"],["固く","かたく"],["守るなら","まもるなら"]]},{"verse":7,"text":"わたしは彼らを聖なるわたしの山に導きわたしの祈りの家の喜びの祝いに連なることを許す。彼らが焼き尽くす献げ物といけにえをささげるならわたしの祭壇で、わたしはそれを受け入れる。わたしの家は、すべての民の祈りの家と呼ばれる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["聖","せい"],["なる"],["わたし"],["の"],["山","やま"],["に"],["導き","みちびき"],["わたし"],["の"],["祈り","いのり"],["の"],["家","いえ"],["の"],["喜び","よろこび"],["の"],["祝い","いわい"],["に"],["連なる","つらなる"],["こと"],["を"],["許す","ゆるす"],["。"],["彼","かれ"],["ら"],["が"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["いけにえ"],["を"],["ささげるなら"],["わたし"],["の"],["祭壇","さいだん"],["で"],["、"],["わたし"],["は"],["それ"],["を"],["受け入れる","うけいれる"],["。"],["わたし"],["の"],["家","いえ"],["は"],["、"],["すべて"],["の"],["民","たみ"],["の"],["祈り","いのり"],["の"],["家","いえ"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":8,"text":"追い散らされたイスラエルを集める方主なる神は言われる既に集められた者に、更に加えて集めよう、と。","tok":[["追い散らされた","おいちらされた"],["イスラエル"],["を"],["集める","あつめる"],["方","かた"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["既に","すでに"],["集められた","あつめられた"],["者","もの"],["に"],["、"],["更に","さらに"],["加えて","くわえて"],["集めよう","あつめよう"],["、"],["と"],["。"]]},{"verse":9,"text":"野のすべての獣よ、森のすべての獣よ食べに来るがよい。","tok":[["野","の"],["の"],["すべて"],["の"],["獣","けもの"],["よ"],["、"],["森","もり"],["の"],["すべて"],["の"],["獣","けもの"],["よ"],["食べ","たべ"],["に"],["来る","くる"],["が"],["よい"],["。"]]},{"verse":10,"text":"見張りはだれも、見る力がなく、何も知らない。口を閉ざされた犬で、ほえることができない。伏してうたたねし、眠ることを愛する。","tok":[["見張り","みはり"],["は"],["だれ"],["も"],["、"],["見る","みる"],["力","ちから"],["が"],["なく"],["、"],["何","なん"],["も"],["知らない","しらない"],["。"],["口","くち"],["を"],["閉ざされた","とざされた"],["犬","いぬ"],["で"],["、"],["ほえる"],["こと"],["が"],["できない"],["。"],["伏して","ふして"],["うたた"],["ねし"],["、"],["眠る","ねむる"],["こと"],["を"],["愛する","あいする"],["。"]]},{"verse":11,"text":"この犬どもは強欲で飽くことを知らない。彼らは羊飼いでありながらそれを自覚せずそれぞれ自分の好む道に向かい自分の利益を追い求める者ばかりだ。","tok":[["この"],["犬","いぬ"],["ども"],["は"],["強欲","ごうよく"],["で"],["飽く","あく"],["こと"],["を"],["知らない","しらない"],["。"],["彼","かれ"],["ら"],["は"],["羊飼い","ひつじかい"],["で"],["あり"],["ながら"],["それ"],["を"],["自覚","じかく"],["せず"],["それぞれ"],["自分","じぶん"],["の"],["好む","このむ"],["道","みち"],["に"],["向かい","むかい"],["自分","じぶん"],["の"],["利益","りえき"],["を"],["追い求める","おいもとめる"],["者","もの"],["ばかり"],["だ"],["。"]]},{"verse":12,"text":"「さあ、酒を手に入れよう。強い酒を浴びるように飲もう。明日も今日と同じこと。いや、もっとすばらしいにちがいない。」","tok":[["「"],["さあ"],["、"],["酒","さけ"],["を"],["手","て"],["に"],["入れよう","いれよう"],["。"],["強い","つよい"],["酒","さけ"],["を"],["浴びる","あびる"],["よう"],["に"],["飲もう","のもう"],["。"],["明日","あす"],["も"],["今日","きょう"],["と"],["同じ","おなじ"],["こと"],["。"],["いや"],["、"],["もっと"],["すばらしい"],["に"],["ちがい"],["ない"],["。"],["」"]]}]
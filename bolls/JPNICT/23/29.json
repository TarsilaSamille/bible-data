[{"verse":1,"text":"ああ、アリエルよ、アリエルよダビデが陣を張った都よ。年毎に、祭りの数を増し、巡り来らせよ。","tok":[["ああ"],["、"],["アリエル"],["よ"],["、"],["アリエル"],["よ"],["ダビデ"],["が"],["陣","じん"],["を"],["張った","はった"],["都","みやこ"],["よ"],["。"],["年毎","ねんごと"],["に"],["、"],["祭り","まつり"],["の"],["数","かず"],["を"],["増し","まし"],["、"],["巡り","めぐり"],["来らせ","きたらせ"],["よ"],["。"]]},{"verse":2,"text":"そのとき、わたしはアリエルを苦しめる。アリエルには嘆きと、ため息が臨み祭壇の炉（アリエル）のようになる。","tok":[["その"],["とき"],["、"],["わたし"],["は"],["アリエル"],["を"],["苦しめる","くるしめる"],["。"],["アリエル"],["に"],["は"],["嘆き","なげき"],["と"],["、"],["ため息","ためいき"],["が"],["臨み","のぞみ"],["祭壇","さいだん"],["の"],["炉（アリエル）","ろ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":3,"text":"わたしはお前を囲んで陣を張り砦を築き、城壁を建てる。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["囲んで","かこんで"],["陣","じん"],["を"],["張り","はり"],["砦","とりで"],["を"],["築き","きずき"],["、"],["城壁","じょうへき"],["を"],["建てる","たてる"],["。"]]},{"verse":4,"text":"お前は倒されて地の下から語りお前の言葉は塵の下から鈍く響く。亡霊のようなお前の声は地の下から聞こえお前の言葉は塵の下からかすかに響く。","tok":[["お前","おまえ"],["は"],["倒されて","たおされて"],["地","ち"],["の"],["下","した"],["から"],["語り","かたり"],["お前","おまえ"],["の"],["言葉","ことば"],["は"],["塵","ごみ"],["の"],["下","した"],["から"],["鈍く","にぶく"],["響く","ひびく"],["。"],["亡霊","ぼうれい"],["の"],["よう"],["な"],["お前","おまえ"],["の"],["声","こえ"],["は"],["地","ち"],["の"],["下","した"],["から"],["聞こえ","きこえ"],["お前","おまえ"],["の"],["言葉","ことば"],["は"],["塵","ごみ"],["の"],["下","した"],["から"],["かすか"],["に"],["響く","ひびく"],["。"]]},{"verse":5,"text":"群がる外敵は砂塵のようになり群がる暴虐の者らは吹き去られるもみ殻のようになる。そのことは突然、瞬く間に起こる。","tok":[["群がる","むらがる"],["外敵","がいてき"],["は"],["砂塵","さじん"],["の"],["よう"],["に"],["なり"],["群がる","むらがる"],["暴虐","ぼうぎゃく"],["の"],["者","もの"],["ら"],["は"],["吹き去られる","ふきさられる"],["もみ殻","もみがら"],["の"],["よう"],["に"],["なる"],["。"],["その"],["こと"],["は"],["突然","とつぜん"],["、"],["瞬く","しばたたく"],["間","あいだ"],["に"],["起こる","おこる"],["。"]]},{"verse":6,"text":"万軍の主によってお前は顧みられる。雷鳴、地震、大音響と共につむじ風、嵐、焼き尽くす炎のうちに。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["によって"],["お前","おまえ"],["は"],["顧みられる","かえりみられる"],["。"],["雷鳴","らいめい"],["、"],["地震","じしん"],["、"],["大","だい"],["音響","おんきょう"],["と"],["共","とも"],["に"],["つむじ風","つむじかぜ"],["、"],["嵐","あらし"],["、"],["焼き","やき"],["尽くす","つくす"],["炎","ほのお"],["の"],["うち"],["に"],["。"]]},{"verse":7,"text":"アリエルを群がって攻撃する国はすべて夢か夜の幻のようになる。彼女を攻撃し、取り囲み苦しめる者はすべて。","tok":[["アリエル"],["を"],["群がって","むらがって"],["攻撃","こうげき"],["する"],["国","くに"],["は"],["すべて"],["夢","ゆめ"],["か"],["夜","よる"],["の"],["幻","まぼろし"],["の"],["よう"],["に"],["なる"],["。"],["彼女","かのじょ"],["を"],["攻撃","こうげき"],["し"],["、"],["取り囲み","とりかこみ"],["苦しめる","くるしめる"],["者","もの"],["は"],["すべて"],["。"]]},{"verse":8,"text":"「飢えた者が夢を見た。見よ、彼は食べていた。だが目覚めてみると、彼は空腹のままであった。渇いた者が夢を見た。見よ、彼は飲んでいた。だが、目覚めてみると、疲れ果てて渇いたままだ。」シオンの山に群がって戦いを挑んだ国はすべてこのようになる。","tok":[["「"],["飢えた","うえた"],["者","もの"],["が"],["夢","ゆめ"],["を"],["見た","みた"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["食べて","たべて"],["いた"],["。"],["だ"],["が"],["目覚めて","めざめて"],["みる"],["と"],["、"],["彼","かれ"],["は"],["空腹","くうふく"],["の"],["まま"],["で"],["あった"],["。"],["渇いた","かわいた"],["者","もの"],["が"],["夢","ゆめ"],["を"],["見た","みた"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["飲んで","のんで"],["いた"],["。"],["だ"],["が"],["、"],["目覚めて","めざめて"],["みる"],["と"],["、"],["疲れ","つかれ"],["果てて","はてて"],["渇いた","かわいた"],["まま"],["だ"],["。"],["」"],["シオン"],["の"],["山","やま"],["に"],["群がって","むらがって"],["戦い","たたかい"],["を"],["挑んだ","いどんだ"],["国","くに"],["は"],["すべて"],["この"],["よう"],["に"],["なる"],["。"]]},{"verse":9,"text":"ためらえ、立ちすくめ。目をふさげ、そして見えなくなれ。酔っているが、ぶどう酒のゆえではない。よろめいているが、濃い酒のゆえではない。","tok":[["ためらえ"],["、"],["立ちすくめ","たちすくめ"],["。"],["目","め"],["を"],["ふさげ"],["、"],["そして"],["見えなく","みえなく"],["なれ"],["。"],["酔って","よって"],["いる"],["が"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["ゆえ"],["で"],["は"],["ない"],["。"],["よろめいて"],["いる"],["が"],["、"],["濃い","こい"],["酒","さけ"],["の"],["ゆえ"],["で"],["は"],["ない"],["。"]]},{"verse":10,"text":"主はお前たちに深い眠りの霊を注ぎお前たちの目である預言者の目を閉ざし頭である先見者を覆われた。","tok":[["主","ぬし"],["は"],["お前","おまえ"],["たち"],["に"],["深い","ふかい"],["眠り","ねむり"],["の"],["霊","れい"],["を"],["注ぎ","そそぎ"],["お前","おまえ"],["たち"],["の"],["目","め"],["で"],["ある"],["預言者","よげんしゃ"],["の"],["目","め"],["を"],["閉ざし","とざし"],["頭","あたま"],["で"],["ある"],["先見者","せんけんしゃ"],["を"],["覆われた","おおわれた"],["。"]]},{"verse":11,"text":"それゆえすべての幻は、お前たちにとって封じられた書物の中の言葉のようだ。字の読める人に渡して、「どうぞ、読んでください」と頼んでも、その人は「封じられているから読めない」と答える。","tok":[["それ"],["ゆえ"],["すべて"],["の"],["幻","まぼろし"],["は"],["、"],["お前","おまえ"],["たち"],["にとって"],["封じられた","ふうじられた"],["書物","しょもつ"],["の"],["中","なか"],["の"],["言葉","ことば"],["の"],["よう"],["だ"],["。"],["字","じ"],["の"],["読める","よめる"],["人","ひと"],["に"],["渡して","わたして"],["、"],["「"],["どうぞ"],["、"],["読んで","よんで"],["ください"],["」"],["と"],["頼んで","たのんで"],["も"],["、"],["その"],["人","ひと"],["は"],["「"],["封じられて","ふうじられて"],["いる"],["から"],["読めない","よめない"],["」"],["と"],["答える","こたえる"],["。"]]},{"verse":12,"text":"字の読めない人に渡して、「どうぞ、読んでください」と頼んでも、「わたしは字が読めない」と答える。","tok":[["字","じ"],["の"],["読めない","よめない"],["人","ひと"],["に"],["渡して","わたして"],["、"],["「"],["どうぞ"],["、"],["読んで","よんで"],["ください"],["」"],["と"],["頼んで","たのんで"],["も"],["、"],["「"],["わたし"],["は"],["字","じ"],["が"],["読めない","よめない"],["」"],["と"],["答える","こたえる"],["。"]]},{"verse":13,"text":"主は言われた。「この民は、口でわたしに近づき唇でわたしを敬うが心はわたしから遠く離れている。彼らがわたしを畏れ敬うとしてもそれは人間の戒めを覚え込んだからだ。","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["この"],["民","みん"],["は"],["、"],["口","くち"],["で"],["わたし"],["に"],["近づき","ちかづき"],["唇","くちびる"],["で"],["わたし"],["を"],["敬う","うやまう"],["が"],["心","こころ"],["は"],["わたし"],["から"],["遠く","とおく"],["離れて","はなれて"],["いる"],["。"],["彼","かれ"],["ら"],["が"],["わたし"],["を"],["畏れ","おそれ"],["敬う","うやまう"],["として"],["も"],["それ"],["は"],["人間","にんげん"],["の"],["戒め","いましめ"],["を"],["覚え込んだ","おぼえこんだ"],["から"],["だ"],["。"]]},{"verse":14,"text":"それゆえ、見よ、わたしは再び驚くべき業を重ねて、この民を驚かす。賢者の知恵は滅び聡明な者の分別は隠される。」","tok":[["それ"],["ゆえ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["再び","ふたたび"],["驚くべき","おどろくべき"],["業","ごう"],["を"],["重ねて","かさねて"],["、"],["この"],["民","たみ"],["を"],["驚かす","おどろかす"],["。"],["賢者","けんじゃ"],["の"],["知恵","ちえ"],["は"],["滅び","ほろび"],["聡明","そうめい"],["な"],["者","もの"],["の"],["分別","ぶんべつ"],["は"],["隠される","かくされる"],["。"],["」"]]},{"verse":15,"text":"災いだ、主を避けてその謀を深く隠す者は。彼らの業は闇の中にある。彼らは言う。「誰が我らを見るものか誰が我らに気づくものか」と。","tok":[["災い","わざわい"],["だ"],["、"],["主","ぬし"],["を"],["避けて","さけて"],["その"],["謀","はかりごと"],["を"],["深く","ふかく"],["隠す","かくす"],["者","もの"],["は"],["。"],["彼","かれ"],["ら"],["の"],["業","ごう"],["は"],[
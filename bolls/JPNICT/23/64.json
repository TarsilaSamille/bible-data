[{"verse":1,"text":"柴が火に燃えれば、湯が煮えたつようにあなたの御名が敵に示されれば国々は御前に震える。","tok":[["柴","しば"],["が"],["火","ひ"],["に"],["燃えれば","もえれば"],["、"],["湯","ゆ"],["が"],["煮えたつ","にえたつ"],["よう"],["に"],["あなた"],["の"],["御名","ぎょめい"],["が"],["敵","てき"],["に"],["示されれば","しめされれば"],["国々","くにぐに"],["は"],["御前","ごぜん"],["に"],["震える","ふるえる"],["。"]]},{"verse":2,"text":"期待もしなかった恐るべき業と共に降られればあなたの御前に山々は揺れ動く。","tok":[["期待","きたい"],["も"],["しなかった"],["恐るべき","おそるべき"],["業","ぎょう"],["と"],["共","とも"],["に"],["降られれば","ふられれば"],["あなた"],["の"],["御前","ごぜん"],["に"],["山々","やまやま"],["は"],["揺れ動く","ゆれうごく"],["。"]]},{"verse":3,"text":"あなたを待つ者に計らってくださる方は神よ、あなたのほかにはありません。昔から、ほかに聞いた者も耳にした者も目に見た者もありません。","tok":[["あなた"],["を"],["待つ","まつ"],["者","もの"],["に"],["計らって","はからって"],["くださる"],["方","かた"],["は"],["神","かみ"],["よ"],["、"],["あなた"],["の"],["ほか"],["に"],["は"],["ありません"],["。"],["昔","むかし"],["から"],["、"],["ほか"],["に"],["聞いた","きいた"],["者","もの"],["も"],["耳","みみ"],["に"],["した"],["者","もの"],["も"],["目","め"],["に"],["見た","みた"],["者","もの"],["も"],["ありません"],["。"]]},{"verse":4,"text":"喜んで正しいことを行いあなたの道に従って、あなたを心に留める者をあなたは迎えてくださいます。あなたは憤られましたわたしたちが罪を犯したからです。しかし、あなたの御業によってわたしたちはとこしえに救われます。","tok":[["喜んで","よろこんで"],["正しい","ただしい"],["こと"],["を"],["行い","おこない"],["あなた"],["の"],["道","みち"],["に"],["従って","したがって"],["、"],["あなた"],["を"],["心","こころ"],["に"],["留める","とめる"],["者","もの"],["を"],["あなた"],["は"],["迎えて","むかえて"],["くださいます"],["。"],["あなた"],["は"],["憤られました","いきどおられました"],["わたしたち"],["が"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["です"],["。"],["しかし"],["、"],["あなた"],["の"],["御業","ごごう"],["によって"],["わたしたち"],["は"],["とこしえ"],["に"],["救われます","すくわれます"],["。"]]},{"verse":5,"text":"わたしたちは皆、汚れた者となり正しい業もすべて汚れた着物のようになった。わたしたちは皆、枯れ葉のようになりわたしたちの悪は風のようにわたしたちを運び去った。","tok":[["わたしたち"],["は"],["皆","みな"],["、"],["汚れた","よごれた"],["者","もの"],["と"],["なり"],["正しい","ただしい"],["業","ごう"],["も"],["すべて"],["汚れた","よごれた"],["着物","きもの"],["の"],["よう"],["に"],["なった"],["。"],["わたしたち"],["は"],["皆","みな"],["、"],["枯れ葉","かれは"],["の"],["よう"],["に"],["なり"],["わたしたち"],["の"],["悪","あく"],["は"],["風","かぜ"],["の"],["よう"],["に"],["わたしたち"],["を"],["運び去った","はこびさった"],["。"]]},{"verse":6,"text":"あなたの御名を呼ぶ者はなくなり奮い立ってあなたにすがろうとする者もない。あなたはわたしたちから御顔を隠しわたしたちの悪のゆえに、力を奪われた。","tok":[["あなた"],["の"],["御名","ぎょめい"],["を"],["呼ぶ","よぶ"],["者","もの"],["は"],["なくなり"],["奮い立って","ふるいたって"],["あなた"],["に"],["すがろう"],["と"],["する"],["者","もの"],["も"],["ない"],["。"],["あなた"],["は"],["わたしたち"],["から"],["御顔","おかお"],["を"],["隠し","かくし"],["わたしたち"],["の"],["悪","あく"],["の"],["ゆえ"],["に"],["、"],["力","ちから"],["を"],["奪われた","うばわれた"],["。"]]},{"verse":7,"text":"しかし、主よ、あなたは我らの父。わたしたちは粘土、あなたは陶工わたしたちは皆、あなたの御手の業。","tok":[["しかし"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["我","われ"],["ら"],["の"],["父","ちち"],["。"],["わたしたち"],["は"],["粘土","ねんど"],["、"],["あなた"],["は"],["陶工","とうこう"],["わたしたち"],["は"],["皆","みな"],["、"],["あなた"],["の"],["御手","おて"],["の"],["業","ぎょう"],["。"]]},{"verse":8,"text":"どうか主が、激しく怒られることなくいつまでも悪に心を留められることなくあなたの民であるわたしたちすべてに目を留めてくださるように。","tok":[["どう"],["か"],["主","ぬし"],["が"],["、"],["激しく","はげしく"],["怒られる","おこられる"],["こと"],["なく"],["いつ"],["まで"],["も"],["悪","わる"],["に"],["心","こころ"],["を"],["留められる","とめられる"],["こと"],["なく"],["あなた"],["の"],["民","たみ"],["で"],["ある"],["わたしたち"],["すべて"],["に"],["目","め"],["を"],["留めて","とめて"],["くださる"],["よう"],["に"],["。"]]},{"verse":9,"text":"あなたの聖なる町々は荒れ野となった。シオンは荒れ野となり、エルサレムは荒廃し","tok":[["あなた"],["の"],["聖","せい"],["なる"],["町々","まちまち"],["は"],["荒れ野","あれの"],["と"],["なった"],["。"],["シオン"],["は"],["荒れ野","あれの"],["と"],["なり"],["、"],["エルサレム"],["は"],["荒廃","こうはい"],["し"]]},{"verse":10,"text":"わたしたちの輝き、わたしたちの聖所先祖があなたを賛美した所は、火に焼かれわたしたちの慕うものは廃虚となった。","tok":[["わたしたち"],["の"],["輝き","かがやき"],["、"],["わたしたち"],["の"],["聖","せい"],["所","しょ"],["先祖","せんぞ"],["が"],["あなた"],["を"],["賛美","さんび"],["した"],["所","ところ"],["は"],["、"],["火","ひ"],["に"],["焼かれ","やかれ"],["わたしたち"],["の"],["慕う","したう"],["もの"],["は"],["廃虚","はいきょ"],["と"],["なった"],["。"]]},{"verse":11,"text":"それでもなお、主よ、あなたは御自分を抑え黙して、わたしたちを苦しめられるのですか。","tok":[["それ"],["で"],["も"],["なお"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["御自分","ごじぶん"],["を"],["抑え","おさえ"],["黙して","もくして"],["、"],["わたしたち"],["を"],["苦しめられる","くるしめられる"],["の"],["です"],["か"],["。"]]}]
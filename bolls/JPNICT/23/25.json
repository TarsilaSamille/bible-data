[{"verse":1,"text":"主よ、あなたはわたしの神わたしはあなたをあがめ御名に感謝をささげます。あなたは驚くべき計画を成就された遠い昔からの揺るぎない真実をもって。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["わたし"],["は"],["あなた"],["を"],["あがめ"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["を"],["ささげます"],["。"],["あなた"],["は"],["驚くべき","おどろくべき"],["計画","けいかく"],["を"],["成就","じょうじゅ"],["された"],["遠い","とおい"],["昔","むかし"],["から"],["の"],["揺るぎない","ゆるぎない"],["真実","しんじつ"],["を"],["もって"],["。"]]},{"verse":2,"text":"あなたは都を石塚とし城壁のある町を瓦礫の山とし異邦人の館を都から取り去られた。永久に都が建て直されることはないであろう。","tok":[["あなた"],["は"],["都","と"],["を"],["石塚","いしづか"],["とし"],["城壁","じょうへき"],["の"],["ある"],["町","まち"],["を"],["瓦礫","がれき"],["の"],["山","やま"],["と"],["し"],["異邦人","いほうじん"],["の"],["館","やかた"],["を"],["都","と"],["から"],["取り去られた","とりさられた"],["。"],["永久","えいきゅう"],["に"],["都","と"],["が"],["建て直される","たてなおされる"],["こと"],["は"],["ないで"],["あろう"],["。"]]},{"verse":3,"text":"それゆえ、強い民もあなたを敬い暴虐な国々の都でも人々はあなたを恐れる。","tok":[["それ"],["ゆえ"],["、"],["強い","つよい"],["民","たみ"],["も"],["あなた"],["を"],["敬い","うやまい"],["暴虐","ぼうぎゃく"],["な"],["国々","くにぐに"],["の"],["都","と"],["で"],["も"],["人々","ひとびと"],["は"],["あなた"],["を"],["恐れる","おそれる"],["。"]]},{"verse":4,"text":"まことに、あなたは弱い者の砦苦難に遭う貧しい者の砦豪雨を逃れる避け所暑さを避ける陰となられる。暴虐な者の勢いは壁をたたく豪雨","tok":[["まこと"],["に"],["、"],["あなた"],["は"],["弱い","よわい"],["者","もの"],["の"],["砦","とりで"],["苦難","くなん"],["に"],["遭う","あう"],["貧しい","まずしい"],["者","もの"],["の"],["砦","とりで"],["豪雨","ごうう"],["を"],["逃れる","のがれる"],["避け所","よけしょ"],["暑さ","あつさ"],["を"],["避ける","さける"],["陰","かげ"],["と"],["なられる"],["。"],["暴虐","ぼうぎゃく"],["な"],["者","もの"],["の"],["勢い","いきおい"],["は"],["壁","かべ"],["を"],["たたく"],["豪雨","ごうう"]]},{"verse":5,"text":"乾ききった地の暑さのようだ。あなたは雲の陰が暑さを和らげるように異邦人の騒ぎを鎮め暴虐な者たちの歌声を低くされる。","tok":[["乾き","かわき"],["きった"],["地","ち"],["の"],["暑さ","あつさ"],["の"],["よう"],["だ"],["。"],["あなた"],["は"],["雲","くも"],["の"],["陰","かげ"],["が"],["暑さ","あつさ"],["を"],["和らげる","やわらげる"],["よう"],["に"],["異邦人","いほうじん"],["の"],["騒ぎ","さわぎ"],["を"],["鎮め","しずめ"],["暴虐","ぼうぎゃく"],["な"],["者","もの"],["たち"],["の"],["歌声","うたごえ"],["を"],["低く","ひくく"],["される"],["。"]]},{"verse":6,"text":"万軍の主はこの山で祝宴を開きすべての民に良い肉と古い酒を供される。それは脂肪に富む良い肉とえり抜きの酒。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["この"],["山","やま"],["で"],["祝宴","しゅくえん"],["を"],["開き","ひらき"],["すべて"],["の"],["民","たみ"],["に"],["良い","よい"],["肉","にく"],["と"],["古い","ふるい"],["酒","さけ"],["を"],["供される","きょうされる"],["。"],["それ"],["は"],["脂肪","しぼう"],["に"],["富む","とむ"],["良い","よい"],["肉","にく"],["と"],["えり抜き","えりぬき"],["の"],["酒","さけ"],["。"]]},{"verse":7,"text":"主はこの山ですべての民の顔を包んでいた布とすべての国を覆っていた布を滅ぼし","tok":[["主","ぬし"],["は"],["この"],["山","やま"],["で"],["すべて"],["の"],["民","たみ"],["の"],["顔","かお"],["を"],["包んで","つつんで"],["いた"],["布","ぬの"],["と"],["すべて"],["の"],["国","くに"],["を"],["覆って","おおって"],["いた"],["布","ぬの"],["を"],["滅ぼし","ほろぼし"]]},{"verse":8,"text":"死を永久に滅ぼしてくださる。主なる神は、すべての顔から涙をぬぐい御自分の民の恥を地上からぬぐい去ってくださる。これは主が語られたことである。","tok":[["死","し"],["を"],["永久","えいきゅう"],["に"],["滅ぼして","ほろぼして"],["くださる"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["、"],["すべて"],["の"],["顔","かお"],["から"],["涙","なみだ"],["を"],["ぬぐい"],["御自分","ごじぶん"],["の"],["民","たみ"],["の"],["恥","はじ"],["を"],["地上","ちじょう"],["から"],["ぬぐい去って","ぬぐいさって"],["くださる"],["。"],["これ"],["は"],["主","ぬし"],["が"],["語られた","かたられた"],["こと"],["で"],["ある"],["。"]]},{"verse":9,"text":"その日には、人は言う。見よ、この方こそわたしたちの神。わたしたちは待ち望んでいた。この方がわたしたちを救ってくださる。この方こそわたしたちが待ち望んでいた主。その救いを祝って喜び躍ろう。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["人","ひと"],["は"],["言う","ゆう"],["。"],["見よ","みよ"],["、"],["この"],["方","かた"],["こそ"],["わたしたち"],["の"],["神","かみ"],["。"],["わたしたち"],["は"],["待ち望んで","まちのぞんで"],["いた"],["。"],["この"],["方","ほう"],["が"],["わたしたち"],["を"],["救って","すくって"],["くださる"],["。"],["この"],["方","かた"],["こそ"],["わたしたち"],["が"],["待ち望んで","まちのぞんで"],["いた"],["主","ぬし"],["。"],["その"],["救い","すくい"],["を"],["祝って","いわって"],["喜び","よろこび"],["躍ろう","おどろう"],["。"]]},{"verse":10,"text":"主の御手はこの山の上にとどまる。モアブの滅亡モアブは主の下に踏みにじられるわらが踏みつけられて堆肥の山にされるように。","tok":[["主","ぬし"],["の"],["御手","おて"],["は"],["この"],["山","やま"],["の"],["上","うえ"],["に"],["とどまる"],["。"],["モアブ"],["の"],["滅亡","めつぼう"],["モアブ"],["は"],["主","ぬし"],["の"],["下","した"],["に"],["踏みにじられる","ふみにじられる"],["わら"],["が"],["踏みつけられて","ふみつけられて"],["堆肥","たいひ"],["の"],["山","やま"],["に"],["される"],["よう"],["に"],["。"]]},{"verse":11,"text":"モアブはそこで手を広げる泳ぐ人が泳ごうとして手を広げるように。しかし、巧みな手の業を重ねても主はその誇りを打ち倒される。","tok":[["モアブ"],["は"],["そこ"],["で"],["手","て"],["を"],["広げる","ひろげる"],["泳ぐ","およぐ"],["人","ひと"],["が"],["泳ごう","およごう"],["として"],["手","て"],["を"],["広げる","ひろげる"],["よう"],["に"],["。"],["しかし"],["、"],["巧み","たくみ"],["な"],["手","て"],["の"],["業","ごう"],["を"],["重ねて","かさねて"],["も"],["主","ぬし"],["は"],["その"],["誇り","ほこり"],["を"],["打ち倒される","うちたおされる"],["。"]]},{"verse":12,"text":"主はお前の城壁の砦と塔を砕き打ち倒して地の塵に伏させる。","tok":[["主","ぬし"],["は"],["お前","おまえ"],["の"],["城壁","じょうへき"],["の"],["砦","とりで"],["と"],["塔","とう"],["を"],["砕き","くだき"],["打ち倒して","うちたおして"],["地","ち"],["の"],["塵","ごみ"],["に"],["伏させる","ふさせる"],["。"]]}]
[{"verse":1,"text":"喜び歌え、不妊の女、子を産まなかった女よ。歓声をあげ、喜び歌え産みの苦しみをしたことのない女よ。夫に捨てられた女の子供らは夫ある女の子供らよりも数多くなると主は言われる。","tok":[["喜び歌え","よろこびうたえ"],["、"],["不妊","ふにん"],["の"],["女","おんな"],["、"],["子","こ"],["を"],["産まなかった","うまなかった"],["女","おんな"],["よ"],["。"],["歓声","かんせい"],["を"],["あげ"],["、"],["喜び歌え","よろこびうたえ"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["した"],["こと"],["の"],["ない"],["女","おんな"],["よ"],["。"],["夫","おっと"],["に"],["捨てられた","すてられた"],["女","おんな"],["の"],["子供","こども"],["ら"],["は"],["夫","おっと"],["ある"],["女","おんな"],["の"],["子供","こども"],["ら"],["より"],["も"],["数多く","かずおおく"],["なる"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":2,"text":"あなたの天幕に場所を広く取りあなたの住まいの幕を広げ惜しまず綱を伸ばし、杭を堅く打て。","tok":[["あなた"],["の"],["天幕","てんまく"],["に"],["場所","ばしょ"],["を"],["広く","ひろく"],["取り","とり"],["あなた"],["の"],["住まい","すまい"],["の"],["幕","まく"],["を"],["広げ","ひろげ"],["惜しまず","おしまず"],["綱","つな"],["を"],["伸ばし","のばし"],["、"],["杭","くい"],["を"],["堅く","かたく"],["打て","うて"],["。"]]},{"verse":3,"text":"あなたは右に左に増え広がりあなたの子孫は諸国の民の土地を継ぎ荒れ果てた町々には再び人が住む。","tok":[["あなた"],["は"],["右","みぎ"],["に"],["左","ひだり"],["に"],["増え広がり","ふえひろがり"],["あなた"],["の"],["子孫","しそん"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["土地","とち"],["を"],["継ぎ","つぎ"],["荒れ果てた","あれはてた"],["町々","まちまち"],["に"],["は"],["再び","ふたたび"],["人","ひと"],["が"],["住む","すむ"],["。"]]},{"verse":4,"text":"恐れるな、もはや恥を受けることはないから。うろたえるな、もはや辱められることはないから。若いときの恥を忘れよ。やもめのときの屈辱を再び思い出すな。","tok":[["恐れる","おそれる"],["な"],["、"],["もはや"],["恥","はじ"],["を"],["受ける","うける"],["こと"],["は"],["ない"],["から"],["。"],["うろたえる"],["な"],["、"],["もはや"],["辱められる","はずかしめられる"],["こと"],["は"],["ない"],["から"],["。"],["若い","わかい"],["とき"],["の"],["恥","はじ"],["を"],["忘れ","わすれ"],["よ"],["。"],["やもめ"],["の"],["とき"],["の"],["屈辱","くつじょく"],["を"],["再び","ふたたび"],["思い出す","おもいだす"],["な"],["。"]]},{"verse":5,"text":"あなたの造り主があなたの夫となられる。その御名は万軍の主。あなたを贖う方、イスラエルの聖なる神全地の神と呼ばれる方。","tok":[["あなた"],["の"],["造り主","つくりぬし"],["が"],["あなた"],["の"],["夫","おっと"],["と"],["なられる"],["。"],["その"],["御名","ぎょめい"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["。"],["あなた"],["を"],["贖う","あがなう"],["方","かた"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["神","かみ"],["全地","ぜんち"],["の"],["神","かみ"],["と"],["呼ばれる","よばれる"],["方","かた"],["。"]]},{"verse":6,"text":"捨てられて、苦悩する妻を呼ぶように主はあなたを呼ばれる。若いときの妻を見放せようかとあなたの神は言われる。","tok":[["捨てられて","すてられて"],["、"],["苦悩","くのう"],["する"],["妻","つま"],["を"],["呼ぶ","よぶ"],["よう"],["に"],["主","ぬし"],["は"],["あなた"],["を"],["呼ばれる","よばれる"],["。"],["若い","わかい"],["とき"],["の"],["妻","つま"],["を"],["見","み"],["放せよう","はなせよう"],["か"],["と"],["あなた"],["の"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":7,"text":"わずかの間、わたしはあなたを捨てたが深い憐れみをもってわたしはあなたを引き寄せる。","tok":[["わずか"],["の"],["間","あいだ"],["、"],["わたし"],["は"],["あなた"],["を"],["捨てた","すてた"],["が"],["深い","ふかい"],["憐れみ","あわれみ"],["を"],["もって"],["わたし"],["は"],["あなた"],["を"],["引き寄せる","ひきよせる"],["。"]]},{"verse":8,"text":"ひととき、激しく怒って顔をあなたから隠したがとこしえの慈しみをもってあなたを憐れむとあなたを贖う主は言われる。","tok":[["ひととき"],["、"],["激しく","はげしく"],["怒って","おこって"],["顔","かお"],["を"],["あなた"],["から"],["隠した","かくした"],["が"],["とこしえ"],["の"],["慈しみ","いつくしみ"],["を"],["もって"],["あなた"],["を"],["憐れむ","あわれむ"],["と"],["あなた"],["を"],["贖う","あがなう"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"これは、わたしにとってノアの洪水に等しい。再び地上にノアの洪水を起こすことはないとあのとき誓い今またわたしは誓う再びあなたを怒り、責めることはない、と。","tok":[["これ"],["は"],["、"],["わたし"],["にとって"],["ノア"],["の"],["洪水","こうずい"],["に"],["等しい","ひとしい"],["。"],["再び","ふたたび"],["地上","ちじょう"],["に"],["ノア"],["の"],["洪水","こうずい"],["を"],["起こす","おこす"],["こと"],["は"],["ない"],["と"],["あの"],["とき"],["誓い","ちかい"],["今","いま"],["また"],["わたし"],["は"],["誓う","ちかう"],["再び","ふたたび"],["あなた"],["を"],["怒り","おこり"],["、"],["責める","せめる"],["こと"],["は"],["ない"],["、"],["と"],["。"]]},{"verse":10,"text":"山が移り、丘が揺らぐこともあろう。しかし、わたしの慈しみはあなたから移らずわたしの結ぶ平和の契約が揺らぐことはないとあなたを憐れむ主は言われる。","tok":[["山","やま"],["が"],["移り","うつり"],["、"],["丘","おか"],["が"],["揺らぐ","ゆらぐ"],["こと"],["も"],["あろう"],["。"],["しかし"],["、"],["わたし"],["の"],["慈しみ","いつくしみ"],["は"],["あなた"],["から"],["移らず","うつらず"],["わたし"],["の"],["結ぶ","むすぶ"],["平和","へいわ"],["の"],["契約","けいやく"],["が"],["揺らぐ","ゆらぐ"],["こと"],["は"],["ない"],["と"],["あなた"],["を"],["憐れむ","あわれむ"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":11,"text":"苦しめられ、嵐にもてあそばれ慰める者もない都よ見よ、わたしはアンチモンを使ってあなたの石を積む。サファイアであなたの基を固め","tok":[["苦しめられ","くるしめられ"],["、"],["嵐","あらし"],["に"],["もてあそばれ"],["慰める","なぐさめる"],["者","もの"],["も"],["ない"],["都","みやこ"],["よ"],["見よ","みよ"],["、"],["わたし"],["は"],["アンチモン"],["を"],["使って","つかって"],["あなた"],["の"],["石","いし"],["を"],["積む","つむ"],["。"],["サファイア"],["で"],["あなた"],["の"],["基","もと"],["を"],["固め","かため"]]},{"verse":12,"text":"赤めのうであなたの塔をエメラルドであなたの門を飾り地境に沿って美しい石を連ねる。","tok":[["赤め","あかめ"],["の"],["うで"],["あなた"],["の"],["塔","とう"],["を"],["エメラルド"],["で"],["あなた"],["の"],["門","もん"],["を"],["飾り","かざり"],["地境","じざかい"],["に"],["沿って","そって"],["美しい","うつくしい"],["石","いし"],["を"],["連ねる","つらねる"],["。"]]},{"verse":13,"text":"あなたの子らは皆、主について教えを受けあなたの子らには平和が豊かにある。","tok":[["あなた"],["の"],["子","こ"],["ら"],["は"],["皆","みな"],["、"],["主に","おもに"],["ついて"],["教え","おしえ"],["を"],["受け","うけ"],["あなた"],["の"],["子","こ"],["ら"],["に"],["は"],["平和","へいわ"],["が"],["豊か","ゆたか"],["に"],["ある"],["。"]]},{"verse":14,"text":"あなたは恵みの業によって堅く立てられる。虐げる者から遠く離れよもはや恐れることはない。破壊する者から遠く離れよもはやそれがあなたに近づくことはない。","tok":[["あなた"],["は"],["恵み","めぐみ"],["の"],["業","ごう"],["によって"],["堅く","かたく"],["立てられる","たてられる"],["。"],["虐げる","しいたげる"],["者","もの"],["から"],["遠く","とおく"],["離れよ","はなれよ"],["もはや"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["破壊","はかい"],["する"],["者","もの"],["から"],["遠く","とおく"],["離れよ","はなれよ"],["もはや"],["それ"],["が"],["あなた"],["に"],["近づく","ちかづく"],["こと"],["は"],["ない"],["。"]]},{"verse":15,"text":"見よ、攻め寄せる者があってもわたしによらずには何もなしえない。攻め寄せる者はあなたの前に倒れる。","tok":[["見よ","みよ"],["、"],["攻め寄せる","せめよせる"],["者","もの"],["が"],["あって"],["も"],["わたし"],["に"],["よらず"],["に"],["は"],["何","なん"],["も"],["なし"],["えない"],["。"],["攻め寄せる","せめよせる"],["者","もの"],["は"],["あなた"],["の"],["前","まえ"],["に"],["倒れる","たおれる"],["。"]]},{"verse":16,"text":"見よ、わたしは職人を創造した。彼は炭火をおこし、仕事のために道具を作る。わたしは破壊する者も創造してそれを破壊させる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["職人","しょくにん"],["を"],["創造","そうぞう"],["した"],["。"],["彼","かれ"],["は"],["炭火","すみび"],["を"],["おこし"],["、"],["仕事","しごと"],["の"],["ため"],["に"],["道具","どうぐ"],["を"],["作る","つくる"],["。"],["わたし"],["は"],["破壊","はかい"],["する"],["者","もの"],["も"],["創造","そうぞう"],["して"],["それ"],["を"],["破壊","はかい"],["させる"],["。"]]},{"verse":17,"text":"どのような武器があなたに対して作られても何一つ役に立つことはない。裁きの座であなたに対立するすべての舌をあなたは罪に定めることができる。これが主の僕らの嗣業わたしの与える恵みの業だ、と主は言われる。","tok":[["どのような"],["武器","ぶき"],["が"],["あなた"],["に対して","にたいして"],["作られて","つくられて"],["も"],["何","なん"],["一","ひと"],["つ"],["役","やく"],["に"],["立つ","たつ"],["こと"],["は"],["ない"],["。"],["裁き","さばき"],["の"],["座","ざ"],["で"],["あなた"],["に"],["対立","たいりつ"],["する"],["すべて"],["の"],["舌","した"],["を"],["あなた"],["は"],["罪","つみ"],["に"],["定める","さだめる"],["こと"],["が"],["できる"],["。"],["これ"],["が"],["主","ぬし"],["の"],["僕","ぼく"],["ら"],["の"],["嗣業","しぎょう"],["わたし"],["の"],["与える","あたえる"],["恵み","めぐみ"],["の"],["業","ごう"],["だ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
[{"verse":1,"text":"そのころ、ヒゼキヤは死の病にかかった。預言者、アモツの子イザヤが訪ねて来て、「主はこう言われる。『あなたは死ぬことになっていて、命はないのだから、家族に遺言をしなさい』」と言った。","tok":[["その"],["ころ"],["、"],["ヒゼキヤ"],["は"],["死","し"],["の"],["病","やまい"],["に"],["かかった"],["。"],["預言者","よげんしゃ"],["、"],["アモツ"],["の"],["子","こ"],["イザヤ"],["が"],["訪ねて","たずねて"],["来て","きて"],["、"],["「"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["あなた"],["は"],["死ぬ","しぬ"],["こと"],["に"],["なって"],["いて"],["、"],["命","いのち"],["は"],["ない"],["の"],["だ"],["から"],["、"],["家族","かぞく"],["に"],["遺言","ゆいごん"],["を"],["し"],["なさい"],["』"],["」"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"ヒゼキヤは顔を壁に向けて、主にこう祈った。","tok":[["ヒゼキヤ"],["は"],["顔","かお"],["を"],["壁","かべ"],["に"],["向けて","むけて"],["、"],["主に","おもに"],["こう"],["祈った","いのった"],["。"]]},{"verse":3,"text":"「ああ、主よ、わたしがまことを尽くし、ひたむきな心をもって御前を歩み、御目にかなう善いことを行ってきたことを思い起こしてください。」こう言って、ヒゼキヤは涙を流して大いに泣いた。","tok":[["「"],["ああ"],["、"],["主","ぬし"],["よ"],["、"],["わたし"],["が"],["まこと"],["を"],["尽くし","つくし"],["、"],["ひたむき"],["な"],["心","こころ"],["を"],["もって"],["御前","ごぜん"],["を"],["歩み","あゆみ"],["、"],["御目","おめ"],["に"],["かなう"],["善い","よい"],["こと"],["を"],["行って","おこなって"],["きた"],["こと"],["を"],["思い起こして","おもいおこして"],["ください"],["。"],["」"],["こう"],["言って","いって"],["、"],["ヒゼキヤ"],["は"],["涙","なみだ"],["を"],["流して","ながして"],["大いに","おおいに"],["泣いた","ないた"],["。"]]},{"verse":4,"text":"主の言葉がイザヤに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["イザヤ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":5,"text":"「ヒゼキヤのもとに行って言いなさい。あなたの父祖ダビデの神、主はこう言われる。わたしはあなたの祈りを聞き、涙を見た。見よ、わたしはあなたの寿命を十五年延ばし、","tok":[["「"],["ヒゼキヤ"],["の"],["もと"],["に"],["行って","いって"],["言い","いい"],["なさい"],["。"],["あなた"],["の"],["父祖","ふそ"],["ダビデ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["あなた"],["の"],["祈り","いのり"],["を"],["聞き","きき"],["、"],["涙","なみだ"],["を"],["見た","みた"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["の"],["寿命","じゅみょう"],["を"],["十五","じゅうご"],["年","ねん"],["延ばし","のばし"],["、"]]},{"verse":6,"text":"アッシリアの王の手からあなたとこの都を救い出す。わたしはこの都を守り抜く。」","tok":[["アッシリア"],["の"],["王","おう"],["の"],["手","て"],["から"],["あなた"],["と"],["この"],["都","と"],["を"],["救い出す","すくいだす"],["。"],["わたし"],["は"],["この"],["都","と"],["を"],["守り","まもり"],["抜く","ぬく"],["。"],["」"]]},{"verse":7,"text":"ここに主によって与えられるしるしがあります。それによって、主は約束なさったことを実現されることが分かります。","tok":[["ここ"],["に"],["主","ぬし"],["によって"],["与えられる","あたえられる"],["しるし"],["が"],["あります"],["。"],["それ"],["によって"],["、"],["主","ぬし"],["は"],["約束","やくそく"],["なさった"],["こと"],["を"],["実現","じつげん"],["される"],["こと"],["が"],["分かります","わかります"],["。"]]},{"verse":8,"text":"「見よ、わたしは日時計の影、太陽によってアハズの日時計に落ちた影を、十度後戻りさせる。」太陽は陰の落ちた日時計の中で十度戻った。","tok":[["「"],["見よ","みよ"],["、"],["わたし"],["は"],["日時計","ひどけい"],["の"],["影","かげ"],["、"],["太陽","たいよう"],["によって"],["アハズ"],["の"],["日時計","ひどけい"],["に"],["落ちた","おちた"],["影","かげ"],["を"],["、"],["十","じゅう"],["度","ど"],["後戻り","あともどり"],["させる"],["。"],["」"],["太陽","たいよう"],["は"],["陰","かげ"],["の"],["落ちた","おちた"],["日時計","ひどけい"],["の"],["中","なか"],["で"],["十","じゅう"],["度","ど"],["戻った","もどった"],["。"]]},{"verse":9,"text":"病気であったが、その病気が治って命を得たユダの王ヒゼキヤの記した歌、ミクタブ。","tok":[["病気","びょうき"],["で"],["あった"],["が"],["、"],["その"],["病気","びょうき"],["が"],["治って","なおって"],["命","いのち"],["を"],["得た","えた"],["ユダ"],["の"],["王","おう"],["ヒゼキヤ"],["の"],["記した","しるした"],["歌","うた"],["、"],["ミクタブ"],["。"]]},{"verse":10,"text":"わたしは思った。人生の半ばにあって行かねばならないのか陰府の門に残る齢をゆだねるのか、と。","tok":[["わたし"],["は"],["思った","おもった"],["。"],["人生","じんせい"],["の"],["半ば","なかば"],["に"],["あって"],["行かねば","いかねば"],["ならない"],["の"],["か"],["陰府","よみ"],["の"],["門","もん"],["に"],["残る","のこる"],["齢","とし"],["を"],["ゆだねる"],["の"],["か"],["、"],["と"],["。"]]},{"verse":11,"text":"わたしは思った。命ある者の地にいて主を見ることもなくなり消えゆく者の国に住む者に加えられもう人を見ることもない、と。","tok":[["わたし"],["は"],["思った","おもった"],["。"],["命","いのち"],["ある"],["者","もの"],["の"],["地","ち"],["に"],["いて"],["主","ぬし"],["を"],["見る","みる"],["こと"],["も"],["なくなり"],["消えゆく","きえゆく"],["者","もの"],["の"],["国","くに"],["に"],["住む","すむ"],["者","もの"],["に"],["加えられ","くわえられ"],["もう"],["人","ひと"],["を"],["見る","みる"],["こと"],["も"],["ない"],["、"],["と"],["。"]]},{"verse":12,"text":"わたしの生涯は羊飼いの天幕のように引き抜かれ、取り去られてしまった。わたしはわたしの命を織物のように巻き終わり糸から切り離されてしまった。昼も夜もあなたはわたしの息の根を止めようとされる。","tok":[["わたし"],["の"],["生涯","しょうがい"],["は"],["羊飼い","ひつじかい"],["の"],["天幕","てんまく"],["の"],["よう"],["に"],["引き抜かれ","ひきぬかれ"],["、"],["取り去られて","とりさられて"],["しまった"],["。"],["わたし"],["は"],["わたし"],["の"],["命","いのち"],["を"],["織物","おりもの"],["の"],["よう"],["に"],["巻き","まき"],["終わり","おわり"],["糸","いと"],["から"],["切り離されて","きりはなされて"],["しまった"],["。"],["昼","ひる"],["も"],["夜","よる"],["も"],["あなた"],["は"],["わたし"],["の"],["息の根","いきのね"],["を"],["止めよう","とめよう"],["と"],["される"],["。"]]},{"verse":13,"text":"夜明けまでわたしはそれを甘んじて受け獅子に砕かれるようにわたしの骨はことごとく砕かれてしまう。昼も夜もあなたはわたしの息の根を止めようとされる。","tok":[["夜明け","よあけ"],["まで"],["わたし"],["は"],["それ"],["を"],["甘んじて","あまんじて"],["受け","うけ"],["獅子","しし"],["に"],["砕かれる","くだかれる"],["よう"],["に"],["わたし"],["の"],["骨","ほね"],["は"],["ことごとく"],["砕かれて","くだかれて"],["しまう"],["。"],["昼","ひる"],["も"],["夜","よる"],["も"],["あなた"],["は"],["わたし"],["の"],["息の根","いきのね"],["を"],["止めよう","とめよう"],["と"],["される"],["。"]]},{"verse":14,"text":"つばめや鶴のようにわたしはすすり泣きの声をあげ鳩のようにわたしは呻く。天を仰いでわたしの目は弱り果てる。わが主よ、わたしは責めさいなまれています。どうかわたしの保証人となってください。","tok":[["つばめ"],["や"],["鶴","つる"],["の"],["よう"],["に"],["わたし"],["は"],["すすり泣き","すすりなき"],["の"],["声","こえ"],["を"],["あげ"],["鳩","はと"],["の"],["よう"],["に"],["わたし"],["は"],["呻く","うめく"],["。"],["天","てん"],["を"],["仰いで","あおいで"],["わたし"],["の"],["目","め"],["は"],["弱り","よわり"],["果てる","はてる"],["。"],["わが"],["主","ぬし"],["よ"],["、"],["わたし"],["は"],["責めさいなまれて","せめさいなまれて"],["います"],["。"],["どう"],["か"],["わたし"],["の"],["保証人","ほしょうにん"],["と"],["なって"],["ください"],["。"]]},{"verse":15,"text":"わたしは何と言えば答えてもらえるのかそのようなことをなさる主に。わたしは心に苦痛を抱きながらすべての年月をあえぎ行かねばならないのか。","tok":[["わたし"],["は"],["何","なん"],["と"],["言えば","いえば"],["答えて","こたえて"],["もらえる"],["の"],["か"],["その"],["よう"],["な"],["こと"],["を"],["なさる"],["主に","おもに"],["。"],["わたし"],["は"],["心","こころ"],["に"],["苦痛","くつう"],["を"],["抱き","いだき"],["ながら"],["すべて"],["の"],["年月","としつき"],["を"],["あえぎ"],["行かねば","いかねば"],["ならない"],["の"],["か"],["。"]]},{"verse":16,"text":"主が近くにいてくだされば、人々は生き続けます。わたしの霊も絶えず生かしてください。わたしを健やかにし、わたしを生かしてください。","tok":[["主","ぬし"],["が"],["近く","ちかく"],["に"],["いて"],["くだされば"],["、"],["人々","ひとびと"],["は"],["生き","いき"],["続けます","つづけます"],["。"],["わたし"],["の"],["霊","れい"],["も"],["絶えず","たえず"],["生かして","いかして"],["ください"],["。"],["わたし"],["を"],["健やか","すこやか"],["に"],["し"],["、"],["わたし"],["を"],["生かして","いかして"],["ください"],["。"]]},{"verse":17,"text":"見よ、わたしの受けた苦痛は平和のためにほかならない。あなたはわたしの魂に思いを寄せ滅びの穴に陥らないようにしてくださった。あなたはわたしの罪をすべてあなたの後ろに投げ捨ててくださった。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["受けた","うけた"],["苦痛","くつう"],["は"],["平和","へいわ"],["の"],["ため"],["に"],["ほか"],["ならない"],["。"],["あなた"],["は"],["わたし"],["の"],["魂","たましい"],["に"],["思い","おもい"],["を"],["寄せ","よせ"],["滅び","ほろび"],["の"],["穴","あな"],["に"],["陥らない","おちいらない"],["よう"],["に"],["して"],["くださった"],["。"],["あなた"],["は"],["わたし"],["の"],["罪","つみ"],["を"],["すべて"],["あなた"],["の"],["後ろ","うしろ"],["に"],["投げ捨てて","なげすてて"],["くださった"],["。"]]},{"verse":18,"text":"陰府があなたに感謝することはなく死があなたを賛美することはないので墓に下る者はあなたのまことを期待することができない。","tok":[["陰府","よみ"],["が"],["あなた"],["に"],["感謝","かんしゃ"],["する"],["こと"],["は"],["なく"],["死","し"],["が"],["あなた"],["を"],["賛美","さんび"],["する"],["こと"],["は"],["ない"],["ので"],["墓","はか"],["に"],["下る","くだる"],["者","もの"],["は"],["あなた"],["の"],["まこと"],["を"],["期待","きたい"],["する"],["こと"],["が"],["できない"],["。"]]},{"verse":19,"text":"命ある者、命ある者のみが今日の、わたしのようにあなたに感謝し父は子にあなたのまことを知らせるのです。","tok":[["命","いのち"],["ある"],["者","もの"],["、"],["命","いのち"],["ある"],["者","もの"],["のみ"],["が"],["今日","きょう"],["の"],["、"],["わたし"],["の"],["よう"],["に"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["父","ちち"],["は"],["子","こ"],["に"],["あなた"],["の"],["まこと"],["を"],["知らせる","しらせる"],["の"],["です"],["。"]]},{"verse":20,"text":"主よ、あなたはわたしを救ってくださった。わたしたちは命のあるかぎり主の神殿でわたしの音楽を共に奏でるでしょう。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["わたし"],["を"],["救って","すくって"],["くださった"],["。"],["わたしたち"],["は"],["命","いのち"],["の"],["ある"],["かぎり"],["主","ぬし"],["の"],["神殿","しんでん"],["で"],["わたし"],["の"],["音楽","おんがく"],["を"],["共","とも"],["に"],["奏でるでしょう","かなでるでしょう"],["。"]]},{"verse":21,"text":"イザヤが、「干しいちじくを持って来るように」と言うので、人々がそれを患部につけると王は回復した。","tok":[["イザヤ"],["が"],["、"],["「"],["干し","ほし"],["いちじく"],["を"],["持って","もって"],["来る","くる"],["よう"],["に"],["」"],["と"],["言う","いう"],["ので"],["、"],["人々","ひとびと"],["が"],["それ"],["を"],["患部","かんぶ"],["に"],["つける"],["と"],["王","おう"],["は"],["回復","かいふく"],["した"],["。"]]},{"verse":22,"text":"ヒゼキヤは言った。 「わたしが主の神殿に上れることを示すしるしは何でしょうか。」","tok":[["ヒゼキヤ"],["は"],["言った","いった"],["。"],[" "],["「"],["わたし"],["が"],["主","ぬし"],["の"],["神殿","しんでん"],["に"],["上れる","のぼれる"],["こと"],["を"],["示す","しめす"],["しるし"],["は"],["何","なん"],["でしょう"],["か"],["。"],["」"]]}]
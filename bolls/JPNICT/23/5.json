[{"verse":1,"text":"わたしは歌おう、わたしの愛する者のためにそのぶどう畑の愛の歌を。わたしの愛する者は、肥沃な丘にぶどう畑を持っていた。","tok":[["わたし"],["は"],["歌おう","うたおう"],["、"],["わたし"],["の"],["愛する","あいする"],["者","もの"],["の"],["ため"],["に"],["その"],["ぶどう"],["畑","はたけ"],["の"],["愛","あい"],["の"],["歌","うた"],["を"],["。"],["わたし"],["の"],["愛する","あいする"],["者","もの"],["は"],["、"],["肥沃","ひよく"],["な"],["丘","おか"],["に"],["ぶどう"],["畑","はたけ"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":2,"text":"よく耕して石を除き、良いぶどうを植えた。その真ん中に見張りの塔を立て、酒ぶねを掘り良いぶどうが実るのを待った。しかし、実ったのは酸っぱいぶどうであった。","tok":[["よく"],["耕して","たがやして"],["石","いし"],["を"],["除き","のぞき"],["、"],["良い","よい"],["ぶどう"],["を"],["植えた","うえた"],["。"],["その"],["真ん中","まんなか"],["に"],["見張り","みはり"],["の"],["塔","とう"],["を"],["立て","たて"],["、"],["酒","さけ"],["ぶね"],["を"],["掘り","ほり"],["良い","よい"],["ぶどう"],["が"],["実る","みのる"],["の"],["を"],["待った","まった"],["。"],["しかし"],["、"],["実った","みのった"],["の"],["は"],["酸っぱい","すっぱい"],["ぶどう"],["で"],["あった"],["。"]]},{"verse":3,"text":"さあ、エルサレムに住む人、ユダの人よわたしとわたしのぶどう畑の間を裁いてみよ。","tok":[["さあ"],["、"],["エルサレム"],["に"],["住む","すむ"],["人","ひと"],["、"],["ユダ"],["の"],["人","ひと"],["よ"],["わたし"],["と"],["わたし"],["の"],["ぶどう"],["畑","はたけ"],["の"],["間","あいだ"],["を"],["裁いて","さばいて"],["み"],["よ"],["。"]]},{"verse":4,"text":"わたしがぶどう畑のためになすべきことで何か、しなかったことがまだあるというのか。わたしは良いぶどうが実るのを待ったのになぜ、酸っぱいぶどうが実ったのか。","tok":[["わたし"],["が"],["ぶどう"],["畑","はたけ"],["の"],["ため"],["に"],["なすべき"],["こと"],["で"],["何","なん"],["か"],["、"],["しなかった"],["こと"],["が"],["まだ"],["ある"],["と"],["いう"],["の"],["か"],["。"],["わたし"],["は"],["良い","よい"],["ぶどう"],["が"],["実る","みのる"],["の"],["を"],["待った","まった"],["のに"],["なぜ"],["、"],["酸っぱい","すっぱい"],["ぶどう"],["が"],["実った","みのった"],["の"],["か"],["。"]]},{"verse":5,"text":"さあ、お前たちに告げようわたしがこのぶどう畑をどうするか。囲いを取り払い、焼かれるにまかせ石垣を崩し、踏み荒らされるにまかせ","tok":[["さあ"],["、"],["お前","おまえ"],["たち"],["に"],["告げよう","つげよう"],["わたし"],["が"],["この"],["ぶどう"],["畑","はたけ"],["を"],["どう"],["する"],["か"],["。"],["囲い","かこい"],["を"],["取り払い","とりはらい"],["、"],["焼かれる","やかれる"],["に"],["まかせ"],["石垣","いしがき"],["を"],["崩し","くずし"],["、"],["踏み荒らされる","ふみあらされる"],["に"],["まかせ"]]},{"verse":6,"text":"わたしはこれを見捨てる。枝は刈り込まれず耕されることもなく茨やおどろが
[{"verse":1,"text":"ヤコブの家よ、これを聞け。ユダの水に源を発しイスラエルの名をもって呼ばれる者よ。まこともなく、恵みの業をすることもないのに主の名をもって誓いイスラエルの神の名を唱える者よ。","tok":[["ヤコブ"],["の"],["家","いえ"],["よ"],["、"],["これ"],["を"],["聞け","きけ"],["。"],["ユダ"],["の"],["水","みず"],["に"],["源","みなもと"],["を"],["発し","はっし"],["イスラエル"],["の"],["名","な"],["を"],["もって"],["呼ばれる","よばれる"],["者","もの"],["よ"],["。"],["まこと"],["も"],["なく"],["、"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["する"],["こと"],["も"],["ない"],["のに"],["主","ぬし"],["の"],["名","な"],["を"],["もって"],["誓い","ちかい"],["イスラエル"],["の"],["神","かみ"],["の"],["名","な"],["を"],["唱える","となえる"],["者","もの"],["よ"],["。"]]},{"verse":2,"text":"聖なる都に属する者と称されその御名を万軍の主と呼ぶイスラエルの神に依りすがる者よ。","tok":[["聖","せい"],["なる"],["都","と"],["に"],["属する","ぞくする"],["者","もの"],["と"],["称され","しょうされ"],["その"],["御名","ぎょめい"],["を"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["と"],["呼ぶ","よぶ"],["イスラエル"],["の"],["神","かみ"],["に"],["依り","より"],["すがる"],["者","もの"],["よ"],["。"]]},{"verse":3,"text":"初めからのことをわたしは既に告げてきた。わたしの口から出た事をわたしは知らせた。突如、わたしは事を起こし、それは実現した。","tok":[["初め","はじめ"],["から"],["の"],["こと"],["を"],["わたし"],["は"],["既に","すでに"],["告げて","つげて"],["きた"],["。"],["わたし"],["の"],["口","くち"],["から"],["出た","でた"],["事","こと"],["を"],["わたし"],["は"],["知らせた","しらせた"],["。"],["突如","とつじょ"],["、"],["わたし"],["は"],["事","こと"],["を"],["起こし","おこし"],["、"],["それ"],["は"],["実現","じつげん"],["した"],["。"]]},{"verse":4,"text":"お前が頑固で、鉄の首筋をもち青銅の額をもつことを知っているから","tok":[["お前","おまえ"],["が"],["頑固","がんこ"],["で"],["、"],["鉄","てつ"],["の"],["首筋","くびすじ"],["を"],["もち"],["青銅","せいどう"],["の"],["額","がく"],["を"],["もつ"],["こと"],["を"],["知って","しって"],["いる"],["から"]]},{"verse":5,"text":"わたしはお前に昔から知らせ事が起こる前に告げておいた。これらのことを起こしたのは、わたしの偶像だこれを命じたのは、わたしの木像と鋳像だとお前に言わせないためだ。","tok":[["わたし"],["は"],["お前","おまえ"],["に"],["昔","むかし"],["から"],["知らせ","しらせ"],["事","こと"],["が"],["起こる","おこる"],["前","まえ"],["に"],["告げて","つげて"],["おいた"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["起こした","おこした"],["の"],["は"],["、"],["わたし"],["の"],["偶像","ぐうぞう"],["だ"],["これ"],["を"],["命じた","めいじた"],["の"],["は"],["、"],["わたし"],["の"],["木像","もくぞう"],["と"],["鋳像","ちゅうぞう"],["だ"],["と"],["お前","おまえ"],["に"],["言わせない","いわせない"],["ため"],["だ"],["。"]]},{"verse":6,"text":"お前の聞いていたこと、そのすべての事を見よ。自分でもそれを告げうるではないか。これから起こる新しいことを知らせよう隠されていたこと、お前の知らぬことを。","tok":[["お前","おまえ"],["の"],["聞いて","きいて"],["いた"],["こと"],["、"],["その"],["すべて"],["の"],["事","こと"],["を"],["見よ","みよ"],["。"],["自分","じぶん"],["で"],["も"],["それ"],["を"],["告げ","つげ"],["うるで"],["は"],["ない"],["か"],["。"],["これ"],["から"],["起こる","おこる"],["新しい","あたらしい"],["こと"],["を"],["知らせよう","しらせよう"],["隠されて","かくされて"],["いた"],["こと"],["、"],["お前","おまえ"],["の"],["知らぬ","しらぬ"],["こと"],["を"],["。"]]},{"verse":7,"text":"それは今、創造された。昔にはなかったもの、昨日もなかったこと。それをお前に聞かせたことはない。見よ、わたしは知っていたとお前に言わせないためだ。","tok":[["それ"],["は"],["今","いま"],["、"],["創造","そうぞう"],["された"],["。"],["昔","むかし"],["に"],["は"],["なかった"],["もの"],["、"],["昨日","きのう"],["も"],["なかった"],["こと"],["。"],["それ"],["を"],["お前","おまえ"],["に"],["聞かせた","きかせた"],["こと"],["は"],["ない"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["知って","しって"],["いた"],["と"],["お前","おまえ"],["に"],["言わせない","いわせない"],["ため"],["だ"],["。"]]},{"verse":8,"text":"お前は聞いたこともなく、知ってもおらず耳も開かれたことはなかった。お前は裏切りを重ねる者生まれたときから背く者と呼ばれていることをわたしは知っていたから。","tok":[["お前","おまえ"],["は"],["聞いた","きいた"],["こと"],["も"],["なく"],["、"],["知って","しって"],["も"],["おらず"],["耳","みみ"],["も"],["開かれた","ひらかれた"],["こと"],["は"],["なかった"],["。"],["お前","おまえ"],["は"],["裏切り","うらぎり"],["を"],["重ねる","かさねる"],["者","もの"],["生まれた","うまれた"],["とき"],["から"],["背く","そむく"],["者","もの"],["と"],["呼ばれて","よばれて"],["いる"],["こと"],["を"],["わたし"],["は"],["知って","しって"],["いた"],["から"],["。"]]},{"verse":9,"text":"わたしは、わたしの名のために怒りを抑えわたしの栄誉のために耐えてお前を滅ぼさないようにした。","tok":[["わたし"],["は"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["怒り","いかり"],["を"],["抑え","おさえ"],["わたし"],["の"],["栄誉","えいよ"],["の"],["ため"],["に"],["耐えて","たえて"],["お前","おまえ"],["を"],["滅ぼさない","ほろぼさない"],["よう"],["に"],["した"],["。"]]},{"verse":10,"text":"見よ、わたしは火をもってお前を練るが銀としてではない。わたしは苦しみの炉でお前を試みる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["火","ひ"],["を"],["もって"],["お前","おまえ"],["を"],["練る","ねる"],["が"],["銀","ぎん"],["として"],["で"],["は"],["ない"],["。"],["わたし"],["は"],["苦しみ","くるしみ"],["の"],["炉","ろ"],["で"],["お前","おまえ"],["を"],["試みる","こころみる"],["。"]]},{"verse":11,"text":"わたし自身のために、わたし自身のためにわたしは事を起こす。わたしの栄光が汚されてよいであろうか。わたしはそれをほかの者には与えない。","tok":[["わたし"],["自身","じしん"],["の"],["ため"],["に"],["、"],["わたし"],["自身","じしん"],["の"],["ため"],["に"],["わたし"],["は"],["事","こと"],["を"],["起こす","おこす"],["。"],["わたし"],["の"],["栄光","えいこう"],["が"],["汚されて","よごされて"],["よいで"],["あろう"],["か"],["。"],["わたし"],["は"],["それ"],["を"],["ほか"],["の"],["者","もの"],["に"],["は"],["与えない","あたえない"],["。"]]},{"verse":12,"text":"ヤコブよ、わたしに耳を傾けよ。わたしが呼び出したイスラエル。わたしは神、初めでありまた終わりであるもの。","tok":[["ヤコブ"],["よ"],["、"],["わたし"],["に"],["耳","みみ"],["を"],["傾けよ","かたむけよ"],["。"],["わたし"],["が"],["呼び出した","よびだした"],["イスラエル"],["。"],["わたし"],["は"],["神","かみ"],["、"],["初め","はじめ"],["で"],["あり"],["また"],["終わり","おわり"],["で"],["ある"],["もの"],["。"]]},{"verse":13,"text":"わたしの手は地の基を据えわたしの右の手は天を延べた。わたしが彼らに呼びかけると、共に立ち上がる。","tok":[["わたし"],["の"],["手","て"],["は"],["地","ち"],["の"],["基","もと"],["を"],["据え","すえ"],["わたし"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["天","てん"],["を"],["延べた","のべた"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["呼びかける","よびかける"],["と"],["、"],["共","とも"],["に"],["立ち上がる","たちあがる"],["。"]]},{"verse":14,"text":"皆、集まって聞くがよい。彼らのうちに、これを告げた者があろうか。主の愛される者が、主の御旨をバビロンに行い主の御腕となる人が、カルデア人に行うことを。","tok":[["皆","みな"],["、"],["集まって","あつまって"],["聞く","きく"],["が"],["よい"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["、"],["これ"],["を"],["告げた","つげた"],["者","もの"],["が"],["あろう"],["か"],["。"],["主","ぬし"],["の"],["愛される","あいされる"],["者","もの"],["が"],["、"],["主","ぬし"],["の"],["御旨","おむね"],["を"],["バビロン"],["に"],["行い","おこない"],["主","ぬし"],["の"],["御腕","おうで"],["と"],["なる"],["人","ひと"],["が"],["、"],["カルデア"],["人","にん"],["に"],["行う","おこなう"],["こと"],["を"],["。"]]},{"verse":15,"text":"わたしが宣言し、わたしが彼を呼んだ。彼を連れて来て、その道を成し遂げさせる。","tok":[["わたし"],["が"],["宣言","せんげん"],["し"],["、"],["わたし"],["が"],["彼","かれ"],["を"],["呼んだ","よんだ"],["。"],["彼","かれ"],["を"],["連れて","つれて"],["来て","きて"],["、"],["その"],["道","みち"],["を"],["成し遂げさせる","なしとげさせる"],["。"]]},{"verse":16,"text":"わたしのもとに近づいて、聞くがよい。わたしは初めから、ひそかに語ったことはない。事の起こるとき、わたしは常にそこにいる。今、主である神はわたしを遣わしその霊を与えてくださった。","tok":[["わたし"],["の"],["もと"],["に"],["近づいて","ちかづいて"],["、"],["聞く","きく"],["が"],["よい"],["。"],["わたし"],["は"],["初め","はじめ"],["から"],["、"],["ひそか"],["に"],["語った","かたった"],["こと"],["は"],["ない"],["。"],["事","こと"],["の"],["起こる","おこる"],["とき"],["、"],["わたし"],["は"],["常","つね"],["に"],["そこ"],["に"],["いる"],["。"],["今","いま"],["、"],["主","ぬし"],["で"],["ある"],["神","かみ"],["は"],["わたし"],["を"],["遣わし","つかわし"],["その"],["霊","れい"],["を"],["与えて","あたえて"],["くださった"],["。"]]},{"verse":17,"text":"イスラエルの聖なる神あなたを贖う主はこう言われる。わたしは主、あなたの神わたしはあなたを教えて力をもたせあなたを導いて道を行かせる。","tok":[["イスラエル"],["の"],["聖","せい"],["なる"],["神","かみ"],["あなた"],["を"],["贖う","あがなう"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["の"],["神","かみ"],["わたし"],["は"],["あなた"],["を"],["教えて","おしえて"],["力","ちから"],["を"],["もたせ"],["あなた"],["を"],["導いて","みちびいて"],["道","みち"],["を"],["行かせる","いかせる"],["。"]]},{"verse":18,"text":"わたしの戒めに耳を傾けるならあなたの平和は大河のように恵みは海の波のようになる。","tok":[["わたし"],["の"],["戒め","いましめ"],["に"],["耳","みみ"],["を"],["傾けるなら","かたむけるなら"],["あなた"],["の"],["平和","へいわ"],["は"],["大河","たいが"],["の"],["よう"],["に"],["恵み","めぐみ"],["は"],["海","うみ"],["の"],["波","なみ"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":19,"text":"あなたの子孫は砂のようにあなたから出る子らは砂の粒のように増えその名はわたしの前から断たれることも、滅ぼされることもない。","tok":[["あなた"],["の"],["子孫","しそん"],["は"],["砂","すな"],["の"],["よう"],["に"],["あなた"],["から"],["出る","でる"],["子","こ"],["ら"],["は"],["砂","すな"],["の"],["粒","つぶ"],["の"],["よう"],["に"],["増え","ふえ"],["その"],["名","な"],["は"],["わたし"],["の"],["前","まえ"],["から"],["断たれる","たたれる"],["こと"],["も"],["、"],["滅ぼされる","ほろぼされる"],["こと"],["も"],["ない"],["。"]]},{"verse":20,"text":"バビロンを出よ、カルデアを逃げ去るがよい。喜びの声をもって告げ知らせ地の果てまで響かせ、届かせよ。主は僕ヤコブを贖われた、と言え。","tok":[["バビロン"],["を"],["出よ","でよ"],["、"],["カルデア"],["を"],["逃げ去る","にげさる"],["が"],["よい"],["。"],["喜び","よろこび"],["の"],["声","こえ"],["を"],["もって"],["告げ知らせ","つげしらせ"],["地","ち"],["の"],["果て","はて"],["まで"],["響かせ","ひびかせ"],["、"],["届かせ","とどかせ"],["よ"],["。"],["主","ぬし"],["は"],["僕","ぼく"],["ヤコブ"],["を"],["贖われた","あがなわれた"],["、"],["と"],["言え","いえ"],["。"]]},{"verse":21,"text":"主が彼らを導いて乾いた地を行かせるときも彼らは渇くことがない。主は彼らのために岩から水を流れ出させる。岩は裂け、水がほとばしる。","tok":[["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["導いて","みちびいて"],["乾いた","かわいた"],["地","ち"],["を"],["行かせる","いかせる"],["とき"],["も"],["彼","かれ"],["ら"],["は"],["渇く","かわく"],["こと"],["が"],["ない"],["。"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["岩","いわ"],["から"],["水","みず"],["を"],["流れ出させる","ながれださせる"],["。"],["岩","いわ"],["は"],["裂け","さけ"],["、"],["水","みず"],["が"],["ほとばしる"],["。"]]},{"verse":22,"text":"神に逆らう者に平和はない、と主は言われる。","tok":[["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["に"],["平和","へいわ"],["は"],["ない"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
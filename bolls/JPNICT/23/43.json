[{"verse":1,"text":"ヤコブよ、あなたを創造された主はイスラエルよ、あなたを造られた主は今、こう言われる。恐れるな、わたしはあなたを贖う。あなたはわたしのもの。わたしはあなたの名を呼ぶ。","tok":[["ヤコブ"],["よ"],["、"],["あなた"],["を"],["創造","そうぞう"],["された"],["主","ぬし"],["は"],["イスラエル"],["よ"],["、"],["あなた"],["を"],["造られた","つくられた"],["主","ぬし"],["は"],["今","いま"],["、"],["こう"],["言われる","いわれる"],["。"],["恐れる","おそれる"],["な"],["、"],["わたし"],["は"],["あなた"],["を"],["贖う","あがなう"],["。"],["あなた"],["は"],["わたし"],["の"],["もの"],["。"],["わたし"],["は"],["あなた"],["の"],["名","な"],["を"],["呼ぶ","よぶ"],["。"]]},{"verse":2,"text":"水の中を通るときも、わたしはあなたと共にいる。大河の中を通っても、あなたは押し流されない。火の中を歩いても、焼かれず炎はあなたに燃えつかない。","tok":[["水","みず"],["の"],["中","なか"],["を"],["通る","とおる"],["とき"],["も"],["、"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"],["大河","たいが"],["の"],["中","なか"],["を"],["通って","とおって"],["も"],["、"],["あなた"],["は"],["押し流されない","おしながされない"],["。"],["火","ひ"],["の"],["中","なか"],["を"],["歩いて","あるいて"],["も"],["、"],["焼かれず","やかれず"],["炎","ほのお"],["は"],["あなた"],["に"],["燃えつかない","もえつかない"],["。"]]},{"verse":3,"text":"わたしは主、あなたの神イスラエルの聖なる神、あなたの救い主。わたしはエジプトをあなたの身代金としクシュとセバをあなたの代償とする。","tok":[["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["の"],["神","かみ"],["イスラエル"],["の"],["聖","せい"],["なる"],["神","かみ"],["、"],["あなた"],["の"],["救い主","すくいぬし"],["。"],["わたし"],["は"],["エジプト"],["を"],["あなた"],["の"],["身代金","みのしろきん"],["と"],["し"],["クシュ"],["と"],["セバ"],["を"],["あなた"],["の"],["代償","だいしょう"],["と"],["する"],["。"]]},{"verse":4,"text":"わたしの目にあなたは価高く、貴くわたしはあなたを愛しあなたの身代わりとして人を与え国々をあなたの魂の代わりとする。","tok":[["わたし"],["の"],["目","め"],["に"],["あなた"],["は"],["価","あたい"],["高く","たかく"],["、"],["貴く","とうとく"],["わたし"],["は"],["あなた"],["を"],["愛し","あいし"],["あなた"],["の"],["身代わり","みがわり"],["として"],["人","ひと"],["を"],["与え","あたえ"],["国々","くにぐに"],["を"],["あなた"],["の"],["魂","たましい"],["の"],["代わり","かわり"],["と"],["する"],["。"]]},{"verse":5,"text":"恐れるな、わたしはあなたと共にいる。わたしは東からあなたの子孫を連れ帰り西からあなたを集める。","tok":[["恐れる","おそれる"],["な"],["、"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"],["わたし"],["は"],["東","ひがし"],["から"],["あなた"],["の"],["子孫","しそん"],["を"],["連れ帰り","つれかえり"],["西","にし"],["から"],["あなた"],["を"],["集める","あつめる"],["。"]]},{"verse":6,"text":"北に向かっては、行かせよ、と南に向かっては、引き止めるな、と言う。わたしの息子たちを遠くから娘たちを地の果てから連れ帰れ、と言う。","tok":[["北","きた"],["に"],["向かって","むかって"],["は"],["、"],["行かせ","いかせ"],["よ"],["、"],["と"],["南","みなみ"],["に"],["向かって","むかって"],["は"],["、"],["引き止める","ひきとめる"],["な"],["、"],["と"],["言う","ゆう"],["。"],["わたし"],["の"],["息子","むすこ"],["たち"],["を"],["遠く","とおく"],["から"],["娘","むすめ"],["たち"],["を"],["地","ち"],["の"],["果て","はて"],["から"],["連れ帰れ","つれかえれ"],["、"],["と"],["言う","ゆう"],["。"]]},{"verse":7,"text":"彼らは皆、わたしの名によって呼ばれる者。わたしの栄光のために創造し形づくり、完成した者。","tok":[["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["わたし"],["の"],["名","な"],["によって"],["呼ばれる","よばれる"],["者","もの"],["。"],["わたし"],["の"],["栄光","えいこう"],["の"],["ため"],["に"],["創造","そうぞう"],["し"],["形づくり","かたちづくり"],["、"],["完成","かんせい"],["した"],["者","もの"],["。"]]},{"verse":8,"text":"引き出せ、目があっても、見えぬ民を耳があっても、聞こえぬ民を。","tok":[["引き出せ","ひきだせ"],["、"],["目","め"],["が"],["あって"],["も"],["、"],["見えぬ","みえぬ"],["民","たみ"],["を"],["耳","みみ"],["が"],["あって"],["も"],["、"],["聞こえぬ","きこえぬ"],["民","たみ"],["を"],["。"]]},{"verse":9,"text":"国々を一堂に集わせ、すべての民を集めよ。彼らの中に、このことを告げ初めからのことを聞かせる者があろうか。自分たちの証人を立て、正しさを示し聞く者に、そのとおりだ、と言わせうる者があろうか。","tok":[["国々","くにぐに"],["を"],["一堂","いちどう"],["に"],["集わせ","つどわせ"],["、"],["すべて"],["の"],["民","たみ"],["を"],["集めよ","あつめよ"],["。"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["、"],["この"],["こと"],["を"],["告げ","つげ"],["初め","はじめ"],["から"],["の"],["こと"],["を"],["聞かせる","きかせる"],["者","もの"],["が"],["あろう"],["か"],["。"],["自分","じぶん"],["たち"],["の"],["証人","しょうにん"],["を"],["立て","たて"],["、"],["正し","ただし"],["さ"],["を"],["示し","しめし"],["聞く","きく"],["者","もの"],["に"],["、"],["その"],["とおり"],["だ"],["、"],["と"],["言わせ","いわせ"],["うる"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":10,"text":"わたしの証人はあなたたちわたしが選んだわたしの僕だ、と主は言われる。あなたたちはわたしを知り、信じ理解するであろうわたしこそ主、わたしの前に神は造られずわたしの後にも存在しないことを。","tok":[["わたし"],["の"],["証人","しょうにん"],["は"],["あなた"],["たち"],["わたし"],["が"],["選んだ","えらんだ"],["わたし"],["の"],["僕","ぼく"],["だ"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["あなた"],["たち"],["は"],["わたし"],["を"],["知り","しり"],["、"],["信じ","しんじ"],["理解","りかい"],["するで"],["あろう"],["わたし"],["こそ"],["主","ぬし"],["、"],["わたし"],["の"],["前","まえ"],["に"],["神","かみ"],["は"],["造られず","つくられず"],["わたし"],["の"],["後","あと"],["に"],["も"],["存在","そんざい"],["しない"],["こと"],["を"],["。"]]},{"verse":11,"text":"わたし、わたしが主である。わたしのほかに救い主はない。","tok":[["わたし"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["。"],["わたし"],["の"],["ほか"],["に"],["救い主","すくいぬし"],["は"],["ない"],["。"]]},{"verse":12,"text":"わたしはあらかじめ告げ、そして救いを与えあなたたちに、ほかに神はないことを知らせた。あなたたちがわたしの証人である、と主は言われる。わたしは神","tok":[["わたし"],["は"],["あらかじめ"],["告げ","つげ"],["、"],["そして"],["救い","すくい"],["を"],["与え","あたえ"],["あなた"],["たち"],["に"],["、"],["ほか"],["に"],["神","かみ"],["は"],["ない"],["こと"],["を"],["知らせた","しらせた"],["。"],["あなた"],["たち"],["が"],["わたし"],["の"],["証人","しょうにん"],["で"],["ある"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["神","かみ"]]},{"verse":13,"text":"今より後も、わたしこそ主。わたしの手から救い出せる者はない。わたしが事を起こせば、誰が元に戻しえようか。","tok":[["今","いま"],["より"],["後","あと"],["も"],["、"],["わたし"],["こそ"],["主","ぬし"],["。"],["わたし"],["の"],["手","て"],["から"],["救い出せる","すくいだせる"],["者","もの"],["は"],["ない"],["。"],["わたし"],["が"],["事","こと"],["を"],["起こせば","おこせば"],["、"],["誰","だれ"],["が"],["元","もと"],["に"],["戻し","もどし"],["えよう"],["か"],["。"]]},{"verse":14,"text":"あなたたちを贖う方、イスラエルの聖なる神主はこう言われる。わたしは、あなたたちのためにバビロンに人を遣わして、かんぬきをすべて外しカルデア人を歓楽の船から引き下ろす。","tok":[["あなた"],["たち"],["を"],["贖う","あがなう"],["方","かた"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["神主","かんぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["あなた"],["たち"],["の"],["ため"],["に"],["バビロン"],["に"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["かんぬき"],["を"],["すべて"],["外し","はずし"],["カルデア"],["人","にん"],["を"],["歓楽","かんらく"],["の"],["船","ふね"],["から"],["引き下ろす","ひきおろす"],["。"]]},{"verse":15,"text":"わたしは主、あなたたちの聖なる神イスラエルの創造主、あなたたちの王。","tok":[["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["たち"],["の"],["聖","せい"],["なる"],["神","かみ"],["イスラエル"],["の"],["創造主","そうぞうしゅ"],["、"],["あなた"],["たち"],["の"],["王","おう"],["。"]]},{"verse":16,"text":"主はこう言われる。海の中に道を通し恐るべき水の中に通路を開かれた方","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["海","うみ"],["の"],["中","なか"],["に"],["道","みち"],["を"],["通し","とおし"],["恐る
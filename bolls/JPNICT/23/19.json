[{"verse":1,"text":"エジプトについての託宣。見よ、主は速い雲を駆ってエジプトに来られる。主の御前に、エジプトの偶像はよろめきエジプト人の勇気は、全く失われる。","tok":[["エジプト"],["について"],["の"],["託宣","たくせん"],["。"],["見よ","みよ"],["、"],["主","ぬし"],["は"],["速い","はやい"],["雲","くも"],["を"],["駆って","かって"],["エジプト"],["に"],["来られる","こられる"],["。"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["、"],["エジプト"],["の"],["偶像","ぐうぞう"],["は"],["よろめき"],["エジプト"],["人","にん"],["の"],["勇気","ゆうき"],["は"],["、"],["全く","まったく"],["失われる","うしなわれる"],["。"]]},{"verse":2,"text":"「わたしは、エジプトをエジプトに刃向かわせる。人はその兄弟と、人はその隣人と町は町と、国は国と戦う。","tok":[["「"],["わたし"],["は"],["、"],["エジプト"],["を"],["エジプト"],["に"],["刃向かわせる","はむかわせる"],["。"],["人","ひと"],["は"],["その"],["兄弟","きょうだい"],["と"],["、"],["人","ひと"],["は"],["その"],["隣人","りんじん"],["と"],["町","まち"],["は"],["町","まち"],["と"],["、"],["国","くに"],["は"],["国","くに"],["と"],["戦う","たたかう"],["。"]]},{"verse":3,"text":"エジプト人の思いは、胸の中に乱れる。わたしが、その謀を乱すので彼らは、偶像と死者の霊口寄せと霊媒に指示を求める。","tok":[["エジプト"],["人","にん"],["の"],["思い","おもい"],["は"],["、"],["胸","むね"],["の"],["中","なか"],["に"],["乱れる","みだれる"],["。"],["わたし"],["が"],["、"],["その"],["謀","はかりごと"],["を"],["乱す","みだす"],["ので"],["彼","かれ"],["ら"],["は"],["、"],["偶像","ぐうぞう"],["と"],["死者","ししゃ"],["の"],["霊","れい"],["口寄せ","くちよせ"],["と"],["霊媒","れいばい"],["に"],["指示","しじ"],["を"],["求める","もとめる"],["。"]]},{"verse":4,"text":"わたしは、エジプトを過酷な支配者の手に渡す。厳しい王が、彼らを治める」と万軍の主なる神が言われる。","tok":[["わたし"],["は"],["、"],["エジプト"],["を"],["過酷","かこく"],["な"],["支配者","しはいしゃ"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["厳しい","きびしい"],["王","おう"],["が"],["、"],["彼","かれ"],["ら"],["を"],["治める","おさめる"],["」"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["なる"],["神","かみ"],["が"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"海の水は涸れ川の流れは尽きて干上がる。","tok":[["海","うみ"],["の"],["水","みず"],["は"],["涸れ川","かれがわ"],["の"],["流れ","ながれ"],["は"],["尽きて","つきて"],["干上がる","ひあがる"],["。"]]},{"verse":6,"text":"運河は悪臭を放ち下エジプトの支流は細り、乾いて葦やよしも枯れ果てる。","tok":[["運河","うんが"],["は"],["悪臭","あくしゅう"],["を"],["放ち","はなち"],["下","か"],["エジプト"],["の"],["支流","しりゅう"],["は"],["細り","ほそり"],["、"],["乾いて","かわいて"],["葦","あし"],["や"],["よし"],["も"],["枯れ","かれ"],["果てる","はてる"],["。"]]},{"verse":7,"text":"ナイルの河口のいぐさも川沿いに蒔かれたすべての草も枯れ、吹き飛ばされて、消えうせる。","tok":[["ナイル"],["の"],["河口","かこう"],["の"],["いぐさ"],["も"],["川沿い","かわそい"],["に"],["蒔かれた","まかれた"],["すべて"],["の"],["草","くさ"],["も"],["枯れ","かれ"],["、"],["吹き飛ばされて","ふきとばされて"],["、"],["消えうせる","きえうせる"],["。"]]},{"verse":8,"text":"漁師は嘆き、悲しむ。ナイルに釣り針を投げる者も水の面に網を広げる者もすべて衰える。","tok":[["漁師","りょうし"],["は"],["嘆き","なげき"],["、"],["悲しむ","かなしむ"],["。"],["ナイル"],["に"],["釣り針","つりばり"],["を"],["投げる","なげる"],["者","もの"],["も"],["水","みず"],["の"],["面","めん"],["に"],["網","あみ"],["を"],["広げる","ひろげる"],["者","もの"],["も"],["すべて"],["衰える","おとろえる"],["。"]]},{"verse":9,"text":"亜麻布を造る者はうろたえ梳く女も、織る男も青ざめ","tok":[["亜","あ"],["麻布","まふ"],["を"],["造る","つくる"],["者","もの"],["は"],["うろたえ"],["梳く","すく"],["女","おんな"],["も"],["、"],["織る","おる"],["男","おとこ"],["も"],["青ざめ","あおざめ"]]},{"verse":10,"text":"紡ぐ者も打ちのめされ雇われて働く者は皆、苦しむ。","tok":[["紡ぐ","つむぐ"],["者","もの"],["も"],["打ちのめされ","うちのめされ"],["雇われて","やとわれて"],["働く","はたらく"],["者","もの"],["は"],["皆","みな"],["、"],["苦しむ","くるしむ"],["。"]]},{"verse":11,"text":"ツォアンの司たちは、まことに無知だ。ファラオの賢者、参議らは、愚かな謀を立てる。どうして、お前たちはファラオに言えようか。「わたしは賢者の子です遠い昔の王たちの子孫です」と。","tok":[["ツォアン"],["の"],["司","つかさ"],["たち"],["は"],["、"],["まこと"],["に"],["無知","むち"],["だ"],["。"],["ファラオ"],["の"],["賢者","けんじゃ"],["、"],["参議","さんぎ"],["ら"],["は"],["、"],["愚か","おろか"],["な"],["謀","はかりごと"],["を"],["立てる","たてる"],["。"],["どう"],["して"],["、"],["お前","おまえ"],["たち"],["は"],["ファラオ"],["に"],["言えよう","いえよう"],["か"],["。"],["「"],["わたし"],["は"],["賢者","けんじゃ"],["の"],["子","こ"],["です"],["遠い","とおい"],["昔","むかし"],["の"],["王","おう"],["たち"],["の"],["子孫","しそん"],["です"],["」"],["と"],["。"]]},{"verse":12,"text":"どこにいるのか、お前の賢者たちは。彼らに命じて、お前に告げ知らせよ万軍の主が、エジプトについて定められたことを。","tok":[["どこ"],["に"],["いる"],["の"],["か"],["、"],["お前","おまえ"],["の"],["賢者","けんじゃ"],["たち"],["は"],["。"],["彼","かれ"],["ら"],["に"],["命じて","めいじて"],["、"],["お前","おまえ"],["に"],["告げ知らせよ","つげしらせよ"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["、"],["エジプト"],["について"],["定められた","さだめられた"],["こと"],["を"],["。"]]},{"verse":13,"text":"ツォアンの司たちは愚かである。メンフィスの司らは欺かれ諸州の長はエジプトをよろめかせた。","tok":[["ツォアン"],["の"],["司","つかさ"],["たち"],["は"],["愚か","おろか"],["で"],["ある"],["。"],["メンフィス"],["の"],["司","つかさ"],["ら"],["は"],["欺かれ","あざむかれ"],["諸州","しょしゅう"],["の"],["長","ちょう"],["は"],["エジプト"],["を"],["よろめかせた"],["。"]]},{"verse":14,"text":"主は、彼らの間に迷わす霊を注がれた。彼らは、エジプトをよろめかせエジプトが何をするときにも酒飲みが吐くときのように、よろめかせた。","tok":[["主","ぬし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["迷わす","まよわす"],["霊","れい"],["を"],["注がれた","そそがれた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["エジプト"],["を"],["よろめかせ"],["エジプト"],["が"],["何","なん"],["を"],["する"],["とき"],["に"],["も"],["酒飲み","さけのみ"],["が"],["吐く","はく"],["とき"],["の"],["よう"],["に"],["、"],["よろめかせた"],["。"]]},{"verse":15,"text":"もはやエジプトでは、だれも何もなしえない。頭であれ尾であれしゅろの枝であれ葦の茎であれ。","tok":[["もはや"],["エジプト"],["で"],["は"],["、"],["だれ"],["も"],["何","なん"],["も"],["なし"],["えない"],["。"],["頭","あたま"],["で"],["あれ"],["尾","お"],["で"],["あれ"],["しゅろ"],["の"],["枝","えだ"],["で"],["あれ"],["葦","あし"],["の"],["茎","くき"],["で"],["あれ"],["。"]]},{"verse":16,"text":"その日には、エジプトは女のように弱くなり、万軍の主が振りかざされる御手に恐れおののく。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["エジプト"],["は"],["女","おんな"],["の"],["よう"],["に"],["弱く","よわく"],["なり"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["振りかざされる","ふりかざされる"],["御手","おて"],["に"],["恐れおののく","おそれおののく"],["。"]]},{"verse":17,"text":"ユダの地は、エジプトを混乱に陥れるものとなる。それを思わせるものは何であれ、エジプトを恐れさせる。万軍の主がエジプトに対して事を謀られるからである。","tok":[["ユダ"],["の"],["地","ち"],["は"],["、"],["エジプト"],["を"],["混乱","こんらん"],["に"],["陥れる","おとしいれる"],["もの"],["と"],["なる"],["。"],["それ"],["を"],["思わせる","おもわせる"],["もの"],["は"],["何","なん"],["で"],["あれ"],["、"],["エジプト"],["を"],["恐れさせる","おそれさせる"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["エジプト"],["に対して","にたいして"],["事","こと"],["を"],["謀られる","はかられる"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"その日には、エジプトの地に五つの町ができる。そこでは、カナンの言葉が語られ、万軍の主に誓いが立てられる。その町の一つは、「太陽の町」ととなえられる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["エジプト"],["の"],["地","ち"],["に"],["五","いつ"],["つ"],["の"],["町","まち"],["が"],["できる"],["。"],["そこ"],["で"],["は"],["、"],["カナン"],["の"],["言葉","ことば"],["が"],["語られ","かたられ"],["、"],["万","まん"],["軍","ぐん"],["の"],["主に","おもに"],["誓い","ちかい"],["が"],["立てられる","たてられる"],["。"],["その"],["町","まち"],["の"],["一","ひと"],["つ"],["は"],["、"],["「"],["太陽","たいよう"],["の"],["町","まち"],["」"],["と"],["となえられる"],["。"]]},{"verse":19,"text":"その日には、エジプトの地の中心に、主のために祭壇が建てられ、その境には主のために柱が立てられる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["エジプト"],["の"],["地","ち"],["の"],["中心","ちゅうしん"],["に"],["、"],["主","ぬし"],["の"],["ため"],["に"],["祭壇","さいだん"],["が"],["建てられ","たてられ"],["、"],["その"],["境","さかい"],["に"],["は"],["主","ぬし"],["の"],["ため"],["に"],["柱","はしら"],["が"],["立てられる","たてられる"],["。"]]},{"verse":20,"text":"それは、エジプトの地において、万軍の主を指し示すしるしとなり、証しとなる。もし彼らが、抑圧する者のゆえに、主に叫ぶならば、主は彼らのために救助者を送り、彼らを救われる。","tok":[["それ"],["は"],["、"],["エジプト"],["の"],["地","ち"],["に"],["おいて"],["、"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["を"],["指し示す","さししめす"],["しるし"],["と"],["なり"],["、"],["証し","あかし"],["と"],["なる"],["。"],["もし"],["彼","かれ"],["ら"],["が"],["、"],["抑圧","よくあつ"],["する"],["者","もの"],["の"],["ゆえ"],["に"],["、"],["主に","おもに"],["叫ぶならば","さけぶならば"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["救助者","きゅうじょしゃ"],["を"],["送り","おくり"],["、"],["彼","かれ"],["ら"],["を"],["救われる","すくわれる"],["。"]]},{"verse":21,"text":"主は御自身をエジプト人に示される。その日には、エジプト人は主を知り、いけにえと供え物をささげ、また主に誓願を立てて、誓いの供え物をささげるであろう。","tok":[["主","ぬし"],["は"],["御自身","ごじしん"],["を"],["エジプト"],["人","にん"],["に"],["示される","しめされる"],["。"],["その"],["日","ひ"],["に"],["は"],["、"],["エジプト"],["人","にん"],["は"],["主","ぬし"],["を"],["知り","しり"],["、"],["いけにえ"],["と"],["供え物","そなえもの"],["を"],["ささげ"],["、"],["また"],["主に","おもに"],["誓願","せいがん"],["を"],["立てて","たてて"],["、"],["誓い","ちかい"],["の"],["供え物","そなえもの"],["を"],["ささげるで"],["あろう"],["。"]]},{"verse":22,"text":"主は、必ずエジプトを撃たれる。しかしまた、いやされる。彼らは主に立ち帰り、主は彼らの願いを聞き、彼らをいやされる。","tok":[["主","ぬし"],["は"],["、"],["必ず","かならず"],["エジプト"],["を"],["撃たれる","うたれる"],["。"],["しかし"],["また"],["、"],["いや"],["される"],["。"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["に"],["立ち帰り","たちかえり"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["願い","ねがい"],["を"],["聞き","きき"],["、"],["彼","かれ"],["ら"],["を"],["いやされる"],["。"]]},{"verse":23,"text":"その日には、エジプトからアッシリアまで道が敷かれる。アッシリア人はエジプトに行き、エジプト人はアッシリアに行き、エジプト人とアッシリア人は共に礼拝する。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["エジプト"],["から"],["アッシリア"],["まで"],["道","みち"],["が"],["敷かれる","しかれる"],["。"],["アッシリア"],["人","にん"],["は"],["エジプト"],["に"],["行き","いき"],["、"],["エジプト"],["人","にん"],["は"],["アッシリア"],["に"],["行き","いき"],["、"],["エジプト"],["人","にん"],["と"],["アッシリア"],["人","にん"],["は"],["共","とも"],["に"],["礼拝","れいはい"],["する"],["。"]]},{"verse":24,"text":"その日には、イスラエルは、エジプトとアッシリアと共に、世界を祝福する第三のものとなるであろう。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["イスラエル"],["は"],["、"],["エジプト"],["と"],["アッシリア"],["と"],["共","とも"],["に"],["、"],["世界","せかい"],["を"],["祝福","しゅくふく"],["する"],["第","だい"],["三","さん"],["の"],["もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":25,"text":"万軍の主は彼らを祝福して言われる。「祝福されよわが民エジプトわが手の業なるアッシリアわが嗣業なるイスラエル」と。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["して"],["言われる","いわれる"],["。"],["「"],["祝福","しゅくふく"],["されよ"],["わが"],["民","みん"],["エジプト"],["わが"],["手","て"],["の"],["業","ごう"],["なる"],["アッシリア"],["わが"],["嗣業","しぎょう"],["なる"],["イスラエル"],["」"],["と"],["。"]]}]
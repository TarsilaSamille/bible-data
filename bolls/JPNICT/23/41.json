[{"verse":1,"text":"島々よ、わたしのもとに来て静まれ。国々の民よ、力を新たにせよ。進み出て語れ。互いに近づいて裁きを行おう。","tok":[["島々","しまじま"],["よ"],["、"],["わたし"],["の"],["もと"],["に"],["来て","きて"],["静まれ","しずまれ"],["。"],["国々","くにぐに"],["の"],["民","たみ"],["よ"],["、"],["力","ちから"],["を"],["新た","あらた"],["に"],["せよ"],["。"],["進み出て","すすみでて"],["語れ","かたれ"],["。"],["互い","たがい"],["に"],["近づいて","ちかづいて"],["裁き","さばき"],["を"],["行おう","おこなおう"],["。"]]},{"verse":2,"text":"東からふさわしい人を奮い立たせ、足もとに招き国々を彼に渡して、王たちを従わせたのは誰か。この人の剣は彼らを塵のように弓は彼らをわらのように散らす。","tok":[["東","ひがし"],["から"],["ふさわしい"],["人","ひと"],["を"],["奮い立たせ","ふるいたたせ"],["、"],["足もと","あしもと"],["に"],["招き","まねき"],["国々","くにぐに"],["を"],["彼","かれ"],["に"],["渡して","わたして"],["、"],["王","おう"],["たち"],["を"],["従わせた","したがわせた"],["の"],["は"],["誰","だれ"],["か"],["。"],["この"],["人","ひと"],["の"],["剣","けん"],["は"],["彼","かれ"],["ら"],["を"],["塵","ごみ"],["の"],["よう"],["に"],["弓","ゆみ"],["は"],["彼","かれ"],["ら"],["を"],["わら"],["の"],["よう"],["に"],["散らす","ちらす"],["。"]]},{"verse":3,"text":"彼は敵を追い、安全に道を進み彼の足をとどめるものはない。","tok":[["彼","かれ"],["は"],["敵","てき"],["を"],["追い","おい"],["、"],["安全","あんぜん"],["に"],["道","みち"],["を"],["進み","すすみ"],["彼","かれ"],["の"],["足","あし"],["を"],["とどめる"],["もの"],["は"],["ない"],["。"]]},{"verse":4,"text":"この事を起こし、成し遂げたのは誰か。それは、主なるわたし。初めから代々の人を呼び出すもの初めであり、後の代と共にいるもの。","tok":[["この"],["事","こと"],["を"],["起こし","おこし"],["、"],["成し遂げた","なしとげた"],["の"],["は"],["誰","だれ"],["か"],["。"],["それ"],["は"],["、"],["主","おも"],["なる"],["わたし"],["。"],["初め","はじめ"],["から"],["代々","だいだい"],["の"],["人","ひと"],["を"],["呼び出す","よびだす"],["もの"],["初め","はじめ"],["で"],["あり"],["、"],["後","あと"],["の"],["代","だい"],["と"],["共","とも"],["に"],["いる"],["もの"],["。"]]},{"verse":5,"text":"島々は畏れをもって仰ぎ地の果てはおののき、共に近づいて来る。","tok":[["島々","しまじま"],["は"],["畏れ","おそれ"],["を"],["もって"],["仰ぎ","あおぎ"],["地","ち"],["の"],["果て","はて"],["は"],["おののき"],["、"],["共","とも"],["に"],["近づいて","ちかづいて"],["来る","くる"],["。"]]},{"verse":6,"text":"彼らは助け合い、互いに励ましの声をかける。","tok":[["彼","かれ"],["ら"],["は"],["助け合い","たすけあい"],["、"],["互い","たがい"],["に"],["励まし","はげまし"],["の"],["声","こえ"],["を"],["かける"],["。"]]},{"verse":7,"text":"職人は金工を励まし大鎚を振るう者は小鎚を使う者を励ます。ひとりが据え付けて、良しと言うとひとりは釘を打って動かないようにする。","tok":[["職人","しょくにん"],["は"],["金工","きんこう"],["を"],["励まし","はげまし"],["大","だい"],["鎚"],["を"],["振るう","ふるう"],["者","もの"],["は"],["小鎚","こづち"],["を"],["使う","つかう"],["者","もの"],["を"],["励ます","はげます"],["。"],["ひとり"],["が"],["据え付けて","すえつけて"],["、"],["良し","よし"],["と"],["言う","ゆう"],["と"],["ひとり"],["は"],["釘","くぎ"],["を"],["打って","うって"],["動かない","うごかない"],["よう"],["に"],["する"],["。"]]},{"verse":8,"text":"わたしの僕イスラエルよ。わたしの選んだヤコブよ。わたしの愛する友アブラハムの末よ。","tok":[["わたし"],["の"],["僕","ぼく"],["イスラエル"],["よ"],["。"],["わたし"],["の"],["選んだ","えらんだ"],["ヤコブ"],["よ"],["。"],["わたし"],["の"],["愛する","あいする"],["友","とも"],["アブラハム"],["の"],["末","すえ"],["よ"],["。"]]},{"verse":9,"text":"わたしはあなたを固くとらえ地の果て、その隅々から呼び出して言った。あなたはわたしの僕わたしはあなたを選び、決して見捨てない。","tok":[["わたし"],["は"],["あなた"],["を"],["固く","かたく"],["とらえ"],["地","ち"],["の"],["果て","はて"],["、"],["その"],["隅々","すみずみ"],["から"],["呼び出して","よびだして"],["言った","いった"],["。"],["あなた"],["は"],["わたし"],["の"],["僕","ぼく"],["わたし"],["は"],["あなた"],["を"],["選び","えらび"],["、"],["決して","けっして"],["見捨てない","みすてない"],["。"]]},{"verse":10,"text":"恐れることはない、わたしはあなたと共にいる神。たじろぐな、わたしはあなたの神。勢いを与えてあなたを助けわたしの救いの右の手であなたを支える。","tok":[["恐れる","おそれる"],["こと"],["は"],["ない"],["、"],["わたし"],["は"],["あなた"],["と"],["共","とも"],["に"],["いる"],["神","かみ"],["。"],["たじろぐ"],["な"],["、"],["わたし"],["は"],["あなた"],["の"],["神","かみ"],["。"],["勢い","いきおい"],["を"],["与えて","あたえて"],["あなた"],["を"],["助け","たすけ"],["わたし"],["の"],["救い","すくい"],["の"],["右","みぎ"],["の"],["手","て"],["で"],["あなた"],["を"],["支える","ささえる"],["。"]]},{"verse":11,"text":"見よ、あなたに対して怒りを燃やす者は皆恥を受け、辱められ争う者は滅ぼされ、無に等しくなる。","tok":[["見よ","みよ"],["、"],["あなた"],["に対して","にたいして"],["怒り","いかり"],["を"],["燃やす","もやす"],["者","もの"],["は"],["皆","みな"],["恥","はじ"],["を"],["受け","うけ"],["、"],["辱められ","はずかしめられ"],["争う","あらそう"],["者","もの"],["は"],["滅ぼされ","ほろぼされ"],["、"],["無","む"],["に"],["等しく","ひとしく"],["なる"],["。"]]},{"verse":12,"text":"争いを仕掛ける者は捜しても見いだせず戦いを挑む者は無に帰し、むなしくなる。","tok":[["争い","あらそい"],["を"],["仕掛ける","しかける"],["者","もの"],["は"],["捜して","さがして"],["も"],["見いだせず","みいだせず"],["戦い","たたかい"],["を"],["挑む","いどむ"],["者","もの"],["は"],["無","む"],["に"],["帰し","かえし"],["、"],["むなしく"],["なる"],["。"]]},{"verse":13,"text":"わたしは主、あなたの神。あなたの右の手を固く取って言う恐れるな、わたしはあなたを助ける、と。","tok":[["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["の"],["神","かみ"],["。"],["あなた"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["固く","かたく"],["取って","とって"],["言う","いう"],["恐れる","おそれる"],["な"],["、"],["わたし"],["は"],["あなた"],["を"],["助ける","たすける"],["、"],["と"],["。"]]},{"verse":14,"text":"あなたを贖う方、イスラエルの聖なる神主は言われる。恐れるな、虫けらのようなヤコブよイスラエルの人々よ、わたしはあなたを助ける。","tok":[["あなた"],["を"],["贖う","あがなう"],["方","かた"],["、"],["イスラエル"],["の"],["聖","せい"],["なる"],["神主","かんぬし"],["は"],["言われる","いわれる"],["。"],["恐れる","おそれる"],["な"],["、"],["虫けら","むしけら"],["の"],["よう"],["な"],["ヤコブ"],["よ"],["イスラエル"],["の"],["人々","ひとびと"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["助ける","たすける"],["。"]]},{"verse":15,"text":"見よ、わたしはあなたを打穀機とする新しく、鋭く、多くの刃をつけた打穀機と。あなたは山々を踏み砕き、丘をもみ殻とする。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["打","だ"],["穀","こく"],["機","き"],["と"],["する"],["新しく","あたらしく"],["、"],["鋭く","するどく"],["、"],["多く","おおく"],["の"],["刃","は"],["を"],["つけた"],["打","だ"],["穀","こく"],["機","き"],["と"],["。"],["あなた"],["は"],["山々","やまやま"],["を"],["踏み砕き","ふみくだき"],["、"],["丘","おか"],["を"],["もみ殻","もみがら"],["と"],["する"],["。"]]},{"verse":16,"text":"あなたがそれをあおると、風が巻き上げ嵐がそれを散らす。あなたは主によって喜び躍りイスラエルの聖なる神によって誇る。","tok":[["あなた"],["が"],["それ"],["を"],["あおる"],["と"],["、"],["風","かぜ"],["が"],["巻き上げ","まきあげ"],["嵐","あらし"],["が"],["それ"],["を"],["散らす","ちらす"],["。"],["あなた"],["は"],["主に","おもに"],["よって"],["喜び","よろこび"],["躍り","おどり"],["イスラエル"],["の"],["聖","せい"],["なる"],["神","かみ"],["によって"],["誇る","ほこる"],["。"]]},{"verse":17,"text":"苦しむ人、貧しい人は水を求めても得ず渇きに舌は干上がる。主であるわたしが彼らに答えよう。イスラエルの神であるわたしは彼らを見捨てない。","tok":[["苦しむ","くるしむ"],["人","ひと"],["、"],["貧しい","まずしい"],["人","ひと"],["は"],["水","みず"],["を"],["求めて","もとめて"],["も"],["得ず","えず"],["渇き","かわき"],["に"],["舌","した"],["は"],["干上がる","ひあがる"],["。"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["答えよう","こたえよう"],["。"],["イスラエル"],["の"],["神","かみ"],["で"],["ある"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["見捨てない","みすてない"],["。"]]},{"verse":18,"text":"わたしは不毛の高原に大河を開き谷あいの野に泉を湧き出させる。荒れ野を湖とし乾
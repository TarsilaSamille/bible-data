[{"verse":1,"text":"闇の中を歩む民は、大いなる光を見死の陰の地に住む者の上に、光が輝いた。","tok":[["闇","やみ"],["の"],["中","なか"],["を"],["歩む","あゆむ"],["民","たみ"],["は"],["、"],["大いなる","おおいなる"],["光","ひかり"],["を"],["見","み"],["死","し"],["の"],["陰","かげ"],["の"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["の"],["上","うえ"],["に"],["、"],["光","ひかり"],["が"],["輝いた","かがやいた"],["。"]]},{"verse":2,"text":"あなたは深い喜びと大きな楽しみをお与えになり人々は御前に喜び祝った。刈り入れの時を祝うように戦利品を分け合って楽しむように。","tok":[["あなた"],["は"],["深い","ふかい"],["喜び","よろこび"],["と"],["大きな","おおきな"],["楽しみ","たのしみ"],["を"],["お与え","おあたえ"],["に"],["なり"],["人々","ひとびと"],["は"],["御前","ごぜん"],["に"],["喜び祝った","よろこびいわった"],["。"],["刈り入れ","かりいれ"],["の"],["時","とき"],["を"],["祝う","いわう"],["よう"],["に"],["戦利品","せんりひん"],["を"],["分け合って","わけあって"],["楽しむ","たのしむ"],["よう"],["に"],["。"]]},{"verse":3,"text":"彼らの負う軛、肩を打つ杖、虐げる者の鞭をあなたはミディアンの日のように折ってくださった。","tok":[["彼","かれ"],["ら"],["の"],["負う","おう"],["軛","くびき"],["、"],["肩","かた"],["を"],["打つ","うつ"],["杖","つえ"],["、"],["虐げる","しいたげる"],["者","もの"],["の"],["鞭","むち"],["を"],["あなた"],["は"],["ミディアン"],["の"],["日","ひ"],["の"],["よう"],["に"],["折って","おって"],["くださった"],["。"]]},{"verse":4,"text":"地を踏み鳴らした兵士の靴血にまみれた軍服はことごとく火に投げ込まれ、焼き尽くされた。","tok":[["地","ち"],["を"],["踏み鳴らした","ふみならした"],["兵士","へいし"],["の"],["靴","くつ"],["血","ち"],["に"],["まみれた"],["軍服","ぐんぷく"],["は"],["ことごとく"],["火","ひ"],["に"],["投げ込まれ","なげこまれ"],["、"],["焼き","やき"],["尽くされた","つくされた"],["。"]]},{"verse":5,"text":"ひとりのみどりごがわたしたちのために生まれた。ひとりの男の子がわたしたちに与えられた。権威が彼の肩にある。その名は、「驚くべき指導者、力ある神永遠の父、平和の君」と唱えられる。","tok":[["ひとり"],["の"],["みどりご"],["が"],["わたしたち"],["の"],["ため"],["に"],["生まれた","うまれた"],["。"],["ひとり"],["の"],["男の子","おとこのこ"],["が"],["わたしたち"],["に"],["与えられた","あたえられた"],["。"],["権威","けんい"],["が"],["彼","かれ"],["の"],["肩","かた"],["に"],["ある"],["。"],["その"],["名","な"],["は"],["、"],["「"],["驚くべき","おどろくべき"],["指導者","しどうしゃ"],["、"],["力","ちから"],["ある"],["神","かみ"],["永遠","えいえん"],["の"],["父","ちち"],["、"],["平和","へいわ"],["の"],["君","きみ"],["」"],["と"],["唱えられる","となえられる"],["。"]]},{"verse":6,"text":"ダビデの王座とその王国に権威は増し平和は絶えることがない。王国は正義と恵みの業によって今もそしてとこしえに、立てられ支えられる。万軍の主の熱意がこれを成し遂げる。","tok":[["ダビデ"],["の"],["王座","おうざ"],["と"],["その"],["王国","おうこく"],["に"],["権威","けんい"],["は"],["増し","まし"],["平和","へいわ"],["は"],["絶える","たえる"],["こと"],["が"],["ない"],["。"],["王国","おうこく"],["は"],["正義","せいぎ"],["と"],["恵み","めぐみ"],["の"],["業","ごう"],["によって"],["今","いま"],["も"],["そして"],["とこしえ"],["に"],["、"],["立てられ","たてられ"],["支えられる","ささえられる"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["熱意","ねつい"],["が"],["これ"],["を"],["成し遂げる","なしとげる"],["。"]]},{"verse":7,"text":"主は御言葉をヤコブに対して送りそれはイスラエルにふりかかった。","tok":[["主","ぬし"],["は"],["御言葉","おことば"],["を"],["ヤコブ"],["に対して","にたいして"],["送り","おくり"],["それ"],["は"],["イスラエル"],["に"],["ふりかかった"],["。"]]},{"verse":8,"text":"民はだれもかれもエフライム、サマリアの住民もそれを認めたが、なお誇り、驕る心に言った。","tok":[["民","みん"],["は"],["だれ"],["も"],["かれ"],["も"],["エフライム"],["、"],["サマリア"],["の"],["住民","じゅうみん"],["も"],["それ"],["を"],["認めた","みとめた"],["が"],["、"],["なお"],["誇り","ほこり"],["、"],["驕る","おごる"],["心","こころ"],["に"],["言った","いった"],["。"]]},{"verse":9,"text":"「れんがが崩れるなら、切り石で家を築き桑の木が倒されるなら、杉を代わりにしよう。」","tok":[["「"],["れんが"],["が"],["崩れるなら","くずれるなら"],["、"],["切り石","きりいし"],["で"],["家","いえ"],["を"],["築き","きずき"],["桑","くわ"],["の"],["木","き"],["が"],["倒されるなら","たおされるなら"],["、"],["杉","すぎ"],["を"],["代わり","かわり"],["に"],["しよう"],["。"],["」"]]},{"verse":10,"text":"主は民に対して、苦しめる者レツィンを興し敵を奮い立たせられた。","tok":[["主","ぬし"],["は"],["民","みん"],["に対して","にたいして"],["、"],["苦しめる","くるしめる"],["者","もの"],["レツィン"],["を"],["興し","おこし"],["敵","てき"],["を"],["奮い立たせられた","ふるいたたせられた"],["。"]]},{"verse":11,"text":"アラムは東から、ペリシテは西から大口を開けて、イスラエルを食らった。しかしなお、主の怒りはやまず御手は伸ばされたままだ。","tok":[["アラム"],["は"],["東","ひがし"],["から"],["、"],["ペリシテ"],["は"],["西","にし"],["から"],["大口","おおぐち"],["を"],["開けて","あけて"],["、"],["イスラエル"],["を"],["食らった","くらった"],["。"],["しかし"],["なお"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["やまず"],["御手","おて"],["は"],["伸ばされた","のばされた"],["まま"],["だ"],["。"]]},{"verse":12,"text":"民は自分たちを打った方に立ち帰らず万軍の主を求めようとしなかった。","tok":[["民","みん"],["は"],["自分","じぶん"],["たち"],["を"],["打った","うった"],["方","ほう"],["に"],["立ち帰らず","たちかえらず"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["を"],["求めよう","もとめよう"],["と"],["しなかった"],["。"]]},{"verse":13,"text":"それゆえ主は、イスラエルから頭も尾もしゅろの枝も葦の茎も一日のうちに断たれた。","tok":[["それ"],["ゆえ"],["主","ぬし"],["は"],["、"],["イスラエル"],["から"],["頭","あたま"],["も"],["尾","お"],["も"],["しゅろ"],["の"],["枝","えだ"],["も"],["葦","あし"],["の"],["茎","くき"],["も"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["断たれた","たたれた"],["。"]]},{"verse":14,"text":"長老や尊敬される者、これが頭偽りを教える者、預言者、これが尾だ。","tok":[["長老","ちょうろう"],["や"],["尊敬","そんけい"],["される"],["者","もの"],["、"],["これ"],["が"],["頭","あたま"],["偽り","いつわり"],["を"],["教える","おしえる"],["者","もの"],["、"],["預言者","よげんしゃ"],["、"],["これ"],["が"],["尾","お"],["だ"],["。"]]},{"verse":15,"text":"この民を導くべき者は、迷わす者となり導かれる者は、惑わされる者となった。","tok":[["この"],["民","たみ"],["を"],["導くべき","みちびくべき"],["者","もの"],["は"],["、"],["迷わす","まよわす"],["者","もの"],["と"],["なり"],["導かれる","みちびかれる"],["者","もの"],["は"],["、"],["惑わされる","まどわされる"],["者","もの"],["と"],["なった"],["。"]]},{"verse":16,"text":"それゆえ、主は若者たちを喜ばれずみなしごややもめすらも憐れまれない。民はすべて、神を無視する者で、悪を行いどの口も不信心なことを語るからだ。しかしなお、主の怒りはやまず御手は伸ばされたままだ。","tok":[["それ"],["ゆえ"],["、"],["主","ぬし"],["は"],["若者","わかもの"],["たち"],["を"],["喜ばれず","よろこばれず"],["みなしご"],["や"],["やもめ"],["すら"],["も"],["憐れまれない","あわれまれない"],["。"],["民","たみ"],["は"],["すべて"],["、"],["神","かみ"],["を"],["無視","むし"],["する"],["者","もの"],["で"],["、"],["悪","あく"],["を"],["行い","おこない"],["どの"],["口","くち"],["も"],["不信心","ふしんじん"],["な"],["こと"],["を"],["語る","かたる"],["から"],["だ"],["。"],["しかし"],["なお"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["やまず"],["御手","おて"],["は"],["伸ばされた","のばされた"],["まま"],["だ"],["。"]]},{"verse":17,"text":"まことに悪は火のように燃え茨とおどろをなめ尽くす。森の茂みに燃えつき、煙の柱が巻き上がる。","tok":[["まこと"],["に"],["悪","あく"],["は"],["火","ひ"],["の"],["よう"],["に"],["燃え","もえ"],["茨","うばら"],["と"],["おどろ"],["を"],["なめ"],["尽くす","つくす"],["。"],["森","もり"],["の"],["茂み","しげみ"],["に"],["燃えつき","もえつき"],["、"],["煙","けむり"],["の"],["柱","はしら"],["が"],["巻き上がる","まきあがる"],["。"]]},{"verse":18,"text":"万軍の主の燃える怒りによって、地は焼かれ民は火の燃えくさのようになりだれもその兄弟を容赦しない。","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["燃える","もえる"],["怒り","いかり"],["によって"],["、"],["地","ち"],["は"],["焼かれ","やかれ"],["民","みん"],["は"],["火","ひ"],["の"],["燃え","もえ"],["くさ"],["の"],["よう"],["に"],["なり"],["だれ"],["も"],["その"],["兄弟","きょうだい"],["を"],["容赦","ようしゃ"],["しない"],["。"]]},{"verse":19,"text":"右から切り取っても、飢えている。左に食らいついても、飽くことができない。だれも皆、自分の同胞の肉を食らう。","tok":[["右","みぎ"],["から"],["切り取って","きりとって"],["も"],["、"],["飢えて","うえて"],["いる"],["。"],["左","ひだり"],["に"],["食らいついて","くらいついて"],["も"],["、"],["飽く","あく"],["こと"],["が"],["できない"],["。"],["だれ"],["も"],["皆","みな"],["、"],["自分","じぶん"],["の"],["同胞","どうほう"],["の"],["肉","にく"],["を"],["食らう","くらう"],["。"]]},{"verse":20,"text":"マナセはエフライムを、エフライムはマナセをそして彼らは共にユダを襲う。しかしなお、主の怒りはやまず御手は伸ばされたままだ。","tok":[["マナセ"],["は"],["エフライム"],["を"],["、"],["エフライム"],["は"],["マナセ"],["を"],["そして"],["彼","かれ"],["ら"],["は"],["共","とも"],["に"],["ユダ"],["を"],["襲う","おそう"],["。"],["しかし"],["なお"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["やまず"],["御手","おて"],["は"],["伸ばされた","のばされた"],["まま"],["だ"],["。"]]}]
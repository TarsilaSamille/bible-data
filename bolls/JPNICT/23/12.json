[{"verse":1,"text":"その日には、あなたは言うであろう。「主よ、わたしはあなたに感謝します。あなたはわたしに向かって怒りを燃やされたがその怒りを翻し、わたしを慰められたからです。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["あなた"],["は"],["言うで","ゆうで"],["あろう"],["。"],["「"],["主","ぬし"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["します"],["。"],["あなた"],["は"],["わたし"],["に"],["向かって","むかって"],["怒り","いかり"],["を"],["燃やされた","もやされた"],["が"],["その"],["怒り","いかり"],["を"],["翻し","ひるがえし"],["、"],["わたし"],["を"],["慰められた","なぐさめられた"],["から"],["です"],["。"]]},{"verse":2,"text":"見よ、わたしを救われる神。わたしは信頼して、恐れない。主こそわたしの力、わたしの歌わたしの救いとなってくださった。」","tok":[["見よ","みよ"],["、"],["わたし"],["を"],["救われる","すくわれる"],["神","かみ"],["。"],["わたし"],["は"],["信頼","しんらい"],["して"],["、"],["恐れない","おそれない"],["。"],["主","ぬし"],["こそ"],["わたし"],["の"],["力","ちから"],["、"],["わたし"],["の"],["歌","うた"],["わたし"],["の"],["救い","すくい"],["と"],["なって"],["くださった"],["。"],["」"]]},{"verse":3,"text":"あなたたちは喜びのうちに救いの泉から水を汲む。","tok":[["あなた"],["たち"],["は"],["喜び","よろこび"],["の"],["うち"],["に"],["救い","すくい"],["の"],["泉","いずみ"],["から"],["水","みず"],["を"],["汲む","くむ"],["。"]]},{"verse":4,"text":"その日には、あなたたちは言うであろう。「主に感謝し、御名を呼べ。諸国の民に御業を示し気高い御名を告げ知らせよ。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["あなた"],["たち"],["は"],["言うで","ゆうで"],["あろう"],["。"],["「"],["主に","おもに"],["感謝","かんしゃ"],["し"],["、"],["御名","ぎょめい"],["を"],["呼べ","よべ"],["。"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["御業","ごごう"],["を"],["示し","しめし"],["気高い","けだかい"],["御名","ぎょめい"],["を"],["告げ知らせ","つげしらせ"],["よ"],["。"]]},{"verse":5,"text":"主にほめ歌をうたえ。主は威厳を示された。全世界にその御業を示せ。","tok":[["主に","おもに"],["ほめ歌","ほめうた"],["を"],["うたえ"],["。"],["主","ぬし"],["は"],["威厳","いげん"],["を"],["示された","しめされた"],["。"],["全","ぜん"],["世界","せかい"],["に"],["その"],["御業","ごぎょう"],["を"],["示せ","しめせ"],["。"]]},{"verse":6,"text":"シオンに住む者よ叫び声をあげ、喜び歌え。イスラエルの聖なる方はあなたたちのただ中にいます大いなる方。」","tok":[["シオン"],["に"],["住む","すむ"],["者","もの"],["よ"],["叫び声","さけびごえ"],["を"],["あげ"],["、"],["喜び歌え","よろこびうたえ"],["。"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["は"],["あなた"],["たち"],["の"],["ただ中","ただなか"],["に"],["います"],["大いなる","おおいなる"],["方","かた"],["。"],["」"]]}]
[{"verse":1,"text":"主が油を注がれた人キュロスについて主はこう言われる。わたしは彼の右の手を固く取り国々を彼に従わせ、王たちの武装を解かせる。扉は彼の前に開かれどの城門も閉ざされることはない。","tok":[["主","ぬし"],["が"],["油","あぶら"],["を"],["注がれた","そそがれた"],["人","ひと"],["キュロス"],["について"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["右","みぎ"],["の"],["手","て"],["を"],["固く","かたく"],["取り","とり"],["国々","くにぐに"],["を"],["彼","かれ"],["に"],["従わせ","したがわせ"],["、"],["王","おう"],["たち"],["の"],["武装","ぶそう"],["を"],["解かせる","とかせる"],["。"],["扉","とびら"],["は"],["彼","かれ"],["の"],["前","まえ"],["に"],["開かれ","ひらかれ"],["どの"],["城門","じょうもん"],["も"],["閉ざされる","とざされる"],["こと"],["は"],["ない"],["。"]]},{"verse":2,"text":"わたしはあなたの前を行き、山々を平らにし青銅の扉を破り、鉄のかんぬきを折り","tok":[["わたし"],["は"],["あなた"],["の"],["前","まえ"],["を"],["行き","いき"],["、"],["山々","やまやま"],["を"],["平ら","たいら"],["に"],["し"],["青銅","せいどう"],["の"],["扉","とびら"],["を"],["破り","やぶり"],["、"],["鉄","てつ"],["の"],["かんぬき"],["を"],["折り","おり"]]},{"verse":3,"text":"暗闇に置かれた宝、隠された富をあなたに与える。あなたは知るようになるわたしは主、あなたの名を呼ぶ者イスラエルの神である、と。","tok":[["暗闇","くらやみ"],["に"],["置かれた","おかれた"],["宝","たから"],["、"],["隠された","かくされた"],["富","とみ"],["を"],["あなた"],["に"],["与える","あたえる"],["。"],["あなた"],["は"],["知る","しる"],["よう"],["に"],["なる"],["わたし"],["は"],["主","ぬし"],["、"],["あなた"],["の"],["名","な"],["を"],["呼ぶ","よぶ"],["者","もの"],["イスラエル"],["の"],["神","かみ"],["で"],["ある"],["、"],["と"],["。"]]},{"verse":4,"text":"わたしの僕ヤコブのためにわたしの選んだイスラエルのためにわたしはあなたの名を呼び、称号を与えたがあなたは知らなかった。","tok":[["わたし"],["の"],["僕","ぼく"],["ヤコブ"],["の"],["ため"],["に"],["わたし"],["の"],["選んだ","えらんだ"],["イスラエル"],["の"],["ため"],["に"],["わたし"],["は"],["あなた"],["の"],["名","な"],["を"],["呼び","よび"],["、"],["称号","しょうごう"],["を"],["与えた","あたえた"],["が"],["あなた"],["は"],["知らなかった","しらなかった"],["。"]]},{"verse":5,"text":"わたしが主、ほかにはいない。わたしをおいて神はない。わたしはあなたに力を与えたがあなたは知らなかった。","tok":[["わたし"],["が"],["主","ぬし"],["、"],["ほか"],["に"],["は"],["いない"],["。"],["わたし"],["を"],["おいて"],["神","かみ"],["は"],["ない"],["。"],["わたし"],["は"],["あなた"],["に"],["力","ちから"],["を"],["与えた","あたえた"],["が"],["あなた"],["は"],["知らなかった","しらなかった"],["。"]]},{"verse":6,"text":"日の昇るところから日の沈むところまで人々は知るようになるわたしのほかは、むなしいものだ、と。わたしが主、ほかにはいない。","tok":[["日","ひ"],["の"],["昇る","のぼる"],["ところ"],["から"],["日","ひ"],["の"],["沈む","しずむ"],["ところ"],["まで"],["人々","ひとびと"],["は"],["知る","しる"],["よう"],["に"],["なる"],["わたし"],["の"],["ほか"],["は"],["、"],["むなしい"],["もの"],["だ"],["、"],["と"],["。"],["わたし"],["が"],["主","ぬし"],["、"],["ほか"],["に"],["は"],["いない"],["。"]]},{"verse":7,"text":"光を造り、闇を創造し平和をもたらし、災いを創造する者。わたしが主、これらのことをするものである。","tok":[["光","ひかり"],["を"],["造り","つくり"],["、"],["闇","やみ"],["を"],["創造","そうぞう"],["し"],["平和","へいわ"],["を"],["もたらし"],["、"],["災い","わざわい"],["を"],["創造","そうぞう"],["する"],["者","もの"],["。"],["わたし"],["が"],["主","ぬし"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["する"],["もの"],["で"],["ある"],["。"]]},{"verse":8,"text":"天よ、露を滴らせよ。雲よ、正義を注げ。地が開いて、救いが実を結ぶように。恵みの御業が共に芽生えるように。わたしは主、それを創造する。","tok":[["天","てん"],["よ"],["、"],["露","ろ"],["を"],["滴らせ","したたらせ"],["よ"],["。"],["雲","くも"],["よ"],["、"],["正義","せいぎ"],["を"],["注げ","そそげ"],["。"],["地","ち"],["が"],["開いて","ひらいて"],["、"],["救い","すくい"],["が"],["実","じつ"],["を"],["結ぶ","むすぶ"],["よう"],["に"],["。"],["恵み","めぐみ"],["の"],["御業","ごごう"],["が"],["共","とも"],["に"],["芽生える","めばえる"],["よう"],["に"],["。"],["わたし"],["は"],["主","ぬし"],["、"],["それ"],["を"],["創造","そうぞう"],["する"],["。"]]},{"verse":9,"text":"災いだ、土の器のかけらにすぎないのに自分の造り主と争う者は。粘土が陶工に言うだろうか「何をしているのかあなたの作ったものに取っ手がない」などと。","tok":[["災い","わざわい"],["だ"],["、"],["土","つち"],["の"],["器","うつわ"],["の"],["かけら"],["に"],["すぎない"],["のに"],["自分","じぶん"],["の"],["造り主","つくりぬし"],["と"],["争う","あらそう"],["者","もの"],["は"],["。"],["粘土","ねんど"],["が"],["陶工","とうこう"],["に"],["言うだろう","ゆうだろう"],["か"],["「"],["何","なん"],["を"],["して"],["いる"],["の"],["か"],["あなた"],["の"],["作った","つくった"],["もの"],["に"],["取っ手","とって"],["が"],["ない"],["」"],["など"],["と"],["。"]]},{"verse":10,"text":"災いだ、なぜ子供をもうけるのか、と父親に言いなぜ産みの苦しみをするのか、と女に問う者は。","tok":[["災い","わざわい"],["だ"],["、"],["なぜ"],["子供","こども"],["を"],["もうける"],["の"],["か"],["、"],["と"],["父親","ちちおや"],["に"],["言い","いい"],["なぜ"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["の"],["か"],["、"],["と"],["女","おんな"],["に"],["問う","とう"],["者","もの"],["は"],["。"]]},{"verse":11,"text":"イスラエルの聖なる神、その造り主主はこう言われる。あなたたちはしるしを求めるのか。わたしの子ら、わたしの手の業についてわたしに命ずるのか。","tok":[["イスラエル"],["の"],["聖","せい"],["なる"],["神","かみ"],["、"],["その"],["造り主","つくりぬし"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["あなた"],["たち"],["は"],["しるし"],["を"],["求める","もとめる"],["の"],["か"],["。"],["わたし"],["の"],["子","こ"],["ら"],["、"],["わたし"],["の"],["手","て"],["の"],["業","ごう"],["について"],["わたし"],["に"],["命ずる","めいずる"],["の"],["か"],["。"]]},{"verse":12,"text":"大地を造り、その上に人間を創造したのはわたし。自分の手で天を広げその万象を指揮するもの。","tok":[["大地","だいち"],["を"],["造り","つくり"],["、"],["その"],["上","うえ"],["に"],["人間","にんげん"],["を"],["創造","そうぞう"],["した"],["の"],["は"],["わたし"],["。"],["自分","じぶん"],["の"],["手","て"],["で"],["天","てん"],["を"],["広げ","ひろげ"],["その"],["万象","ばんしょう"],["を"],["指揮","しき"],["する"],["もの"],["。"]]},{"verse":13,"text":"わたしは正義によって彼を奮い立たせその行く道をすべてまっすぐにする。彼はわたしの都を再建しわたしの捕らわれ人を釈放し報酬も賄賂も求めない。万軍の主はこう言われた。","tok":[["わたし"],["は"],["正義","せいぎ"],["によって"],["彼","かれ"],["を"],["奮い立たせ","ふるいたたせ"],["その"],["行く","いく"],["道","みち"],["を"],["すべて"],["まっすぐ"],["に"],["する"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["都","と"],["を"],["再建","さいけん"],["し"],["わたし"],["の"],["捕らわれ","とらわれ"],["人","にん"],["を"],["釈放","しゃくほう"],["し"],["報酬","ほうしゅう"],["も"],["賄賂","わいろ"],["も"],["求めない","もとめない"],["。"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われた","いわれた"],["。"]]},{"verse":14,"text":"主はこう言われる。エジプトの産物、クシュの商品背の高いセバ人があなたのもとに送り込まれ、あなたのものになる。彼らは鎖につながれて送り込まれあなたに従う。彼らはあなたにひれ伏し、あなたに願って言う。「神は確かにあなたのうちにいます。ほかにはおられない。他の神々はむなしい。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["エジプト"],["の"],["産物","さんぶつ"],["、"],["クシュ"],["の"],["商品","しょうひん"],["背","せ"],["の"],["高い","たかい"],["セバ人","せばにん"],["が"],["あなた"],["の"],["もと"],["に"],["送り込まれ","おくりこまれ"],["、"],["あなた"],["の"],["もの"],["に"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["鎖","くさり"],["に"],["つながれて"],["送り込まれ","おくりこまれ"],["あなた"],["に"],["従う","したがう"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["ひれ伏し","ひれふし"],["、"],["あなた"],["に"],["願って","ねがって"],["言う","ゆう"],["。"],["「"],["神","かみ"],["は"],["確か","たしか"],["に"],["あなた"],["の"],["うち"],["に"],["います"],["。"],["ほか"],["に"],["は"],["おられない"],["。"],["他","ほか"],["の"],["神々","かみがみ"],["は"],["むなしい"],["。"]]},{"verse":15,"text":"まことにあなたは御自分を隠される神イスラエルの神よ、あなたは救いを与えられる」と。","tok":[["まこと"],["に"],["あなた"],["は"],["御自分","ごじぶん"],["を"],["隠される","かくされる"],["神","かみ"],["イスラエル"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["救い","すくい"],["を"],["与えられる","あたえられる"],["」"],["と"],["。"]]},{"verse":16,"text":"偶像を造る者は辱めの中を行き皆共に恥を受け、辱められる。","tok":[["偶像","ぐうぞう"],["を"],["造る","つくる"],["者","もの"],["は"],["辱め","はずかしめ"],["の"],["中","なか"],["を"],["行き","いき"],["皆","みな"],["共","とも"],["に"],["恥","はじ"],["を"],["受け","うけ"],["、"],["辱められる","はずかしめられる"],["。"]]},{"verse":17,"text":"イスラエルは主によって救われる。それはとこしえに続く救いあなたたちは世々とこしえに恥を受けることも、辱められることもない。","tok":[["イスラエル"],["は"],["主に","おもに"],["よって"],["救われる","すくわれる"],["。"],["それ"],["は"],["とこしえ"],["に"],["続く","つづく"],["救い","すくい"],["あなた"],["たち"],["は"],["世々","せいせい"],["とこしえ"],["に"],["恥","はじ"],["を"],["受ける","うける"],["こと"],["も"],["、"],["辱められる","はずかしめられる"],["こと"],["も"],["ない"],["。"]]},{"verse":18,"text":"神である方、天を創造し、地を形づくり造り上げて、固く据えられた方混沌として創造されたのではなく人の住む所として形づくられた方主は、こう言われる。わたしが主、ほかにはいない。","tok":[["神","かみ"],["で"],["ある"],["方","かた"],["、"],["天","てん"],["を"],["創造","そうぞう"],["し"],["、"],["地","ち"],["を"],["形づくり","かたちづくり"],["造り上げて","つくりあげて"],["、"],["固く","かたく"],["据えられた","すえられた"],["方","ほう"],["混沌","こんとん"],["として"],["創造","そうぞう"],["された"],["ので"],["は"],["なく"],["人","ひと"],["の"],["住む","すむ"],["所","ところ"],["として"],["形づくられた","かたちづくられた"],["方","ほう"],["主","しゅ"],["は"],["、"],["こう"],["言われる","いわれる"],["。"],["わたし"],["が"],["主","ぬし"],["、"],["ほか"],["に"],["は"],["いない"],["。"]]},{"verse":19,"text":"わたしは隠れた所で、地の闇の所で語ったことはない。ヤコブの子孫に向かって混沌の中にわたしを求めよ、と言ったことはない。わたしは主正義を語り、公平を告知する者。","tok":[["わたし"],["は"],["隠れた","かくれた"],["所","ところ"],["で"],["、"],["地","ち"],["の"],["闇","やみ"],["の"],["所","ところ"],["で"],["語った","かたった"],["こと"],["は"],["ない"],["。"],["ヤコブ"],["の"],["子孫","しそん"],["に"],["向かって","むかって"],["混沌","こんとん"],["の"],["中","なか"],["に"],["わたし"],["を"],["求めよ","もとめよ"],["、"],["と"],["言った","いった"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["主","しゅ"],["正義","せいぎ"],["を"],["語り","かたり"],["、"],["公平","こうへい"],["を"],["告知","こくち"],["する"],["者","もの"],["。"]]},{"verse":20,"text":"国々から逃れて来た者は集まって共に近づいて来るがよい。偶像が木にすぎないことも知らずに担ぎ救う力のない神に祈る者。","tok":[["国々","くにぐに"],["から"],["逃れて","のがれて"],["来た","きた"],["者","もの"],["は"],["集まって","あつまって"],["共","とも"],["に"],["近づいて","ちかづいて"],["来る","くる"],["が"],["よい"],["。"],["偶像","ぐうぞう"],["が"],["木","き"],["に"],["すぎない"],["こと"],["も"],["知らず","しらず"],["に"],["担ぎ","かつぎ"],["救う","すくう"],["力","ちから"],["の"],["ない"],["神","かみ"],["に"],["祈る","いのる"],["者","もの"],["。"]]},{"verse":21,"text":"意見を交わし、それを述べ、示せ。だれがこのことを昔から知らせ以前から述べていたかを。それは主であるわたしではないか。わたしをおいて神はない。正しい神、救いを与える神はわたしのほかにはない。","tok":[["意見","いけん"],["を"],["交わし","かわし"],["、"],["それ"],["を"],["述べ","のべ"],["、"],["示せ","しめせ"],["。"],["だれ"],["が"],["この"],["こと"],["を"],["昔","むかし"],["から"],["知らせ","しらせ"],["以前","いぜん"],["から"],["述べて","のべて"],["いた"],["か"],["を"],["。"],["それ"],["は"],["主","ぬし"],["で"],["ある"],["わたし"],["で"],["は"],["ない"],["か"],["。"],["わたし"],["を"],["おいて"],["神","かみ"],["は"],["ない"],["。"],["正しい","ただしい"],["神","かみ"],["、"],["救い","すくい"],["を"],["与える","あたえる"],["神","かみ"],["は"],["わたし"],["の"],["ほか"],["に"],["は"],["ない"],["。"]]},{"verse":22,"text":"地の果てのすべての人々よわたしを仰いで、救いを得よ。わたしは神、ほかにはいない。","tok":[["地","ち"],["の"],["果て","はて"],["の"],["すべて"],["の"],["人々","ひとびと"],["よ"],["わたし"],["を"],["仰いで","あおいで"],["、"],["救い","すくい"],["を"],["得","え"],["よ"],["。"],["わたし"],["は"],["神","かみ"],["、"],["ほか"],["に"],["は"],["いない"],["。"]]},{"verse":23,"text":"わたしは自分にかけて誓う。わたしの口から恵みの言葉が出されたならばその言葉は決して取り消されない。わたしの前に、すべての膝はかがみすべての舌は誓いを立て","tok":[["わたし"],["は"],["自分","じぶん"],["に"],["かけて"],["誓う","ちかう"],["。"],["わたし"],["の"],["口","くち"],["から"],["恵み","めぐみ"],["の"],["言葉","ことば"],["が"],["出されたならば","だされたならば"],["その"],["言葉","ことば"],["は"],["決して","けっして"],["取り消されない","とりけされない"],["。"],["わたし"],["の"],["前","まえ"],["に"],["、"],["すべて"],["の"],["膝","ひざ"],["は"],["かがみ"],["すべて"],["の"],["舌","した"],["は"],["誓い","ちかい"],["を"],["立て","たて"]]},{"verse":24,"text":"恵みの御業と力は主にある、とわたしに言う。主に対して怒りを燃やした者はことごとく主に服し、恥を受ける。","tok":[["恵み","めぐみ"],["の"],["御業","ごぎょう"],["と"],["力","ちから"],["は"],["主に","おもに"],["ある"],["、"],["と"],["わたし"],["に"],["言う","ゆう"],["。"],["主に","おもに"],["対して","たいして"],["怒り","いかり"],["を"],["燃やした","もやした"],["者","もの"],["は"],["ことごとく
[{"verse":1,"text":"ヒゼキヤ王の治世第十四年に、アッシリアの王センナケリブが攻め上り、ユダの砦の町をことごとく占領した。","tok":[["ヒゼキヤ"],["王","おう"],["の"],["治世","ちせい"],["第","だい"],["十四","じゅうよん"],["年","ねん"],["に"],["、"],["アッシリア"],["の"],["王","おう"],["センナケリブ"],["が"],["攻め上り","せめのぼり"],["、"],["ユダ"],["の"],["砦","とりで"],["の"],["町","まち"],["を"],["ことごとく"],["占領","せんりょう"],["した"],["。"]]},{"verse":2,"text":"アッシリアの王は、ラキシュからラブ‧シャケを大軍と共にヒゼキヤ王のいるエルサレムに遣わした。彼は布さらしの野に至る大通りに沿って上の貯水池から来る水路の傍らに立ち止まった。","tok":[["アッシリア"],["の"],["王","おう"],["は"],["、"],["ラキシュ"],["から"],["ラブ"],["‧"],["シャケ"],["を"],["大軍","たいぐん"],["と"],["共","とも"],["に"],["ヒゼキヤ"],["王","おう"],["の"],["いる"],["エルサレム"],["に"],["遣わした","つかわした"],["。"],["彼","かれ"],["は"],["布","ぬの"],["さらし"],["の"],["野","の"],["に"],["至る","いたる"],["大通り","おおどおり"],["に"],["沿って","そって"],["上","うえ"],["の"],["貯水池","ちょすいち"],["から"],["来る","くる"],["水路","すいろ"],["の"],["傍ら","かたわら"],["に"],["立ち止まった","たちどまった"],["。"]]},{"verse":3,"text":"ヒルキヤの子である宮廷長エルヤキム、書記官シェブナ、アサフの子である補佐官ヨアが彼の前に出て行った。","tok":[["ヒルキヤ"],["の"],["子","こ"],["で"],["ある"],["宮廷長","きゅうていちょう"],["エルヤキム"],["、"],["書記官","しょきかん"],["シェブナ"],["、"],["アサフ"],["の"],["子","こ"],["で"],["ある"],["補佐官","ほさかん"],["ヨア"],["が"],["彼","かれ"],["の"],["前","まえ"],["に"],["出て","でて"],["行った","いった"],["。"]]},{"verse":4,"text":"そこで、ラブ‧シャケは彼らに言った。「ヒゼキヤに伝えよ。大王、アッシリアの王はこう言われる。なぜこんな頼りないものに頼っているのか。","tok":[["そこ"],["で"],["、"],["ラブ"],["‧"],["シャケ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["ヒゼキヤ"],["に"],["伝え","つたえ"],["よ"],["。"],["大王","だいおう"],["、"],["アッシリア"],["の"],["王","おう"],["は"],["こう"],["言われる","いわれる"],["。"],["なぜ"],["こんな"],["頼りない","たよりない"],["もの"],["に"],["頼って","たよって"],["いる"],["の"],["か"],["。"]]},{"verse":5,"text":"ただ舌先だけの言葉が戦略であり、戦力であるのかとわたしは言う。今お前は誰を頼みにしてわたしに刃向かうのか。","tok":[["ただ"],["舌先","したさき"],["だけ"],["の"],["言葉","ことば"],["が"],["戦略","せんりゃく"],["で"],["あり"],["、"],["戦力","せんりょく"],["で"],["ある"],["の"],["か"],["と"],["わたし"],["は"],["言う","ゆう"],["。"],["今","いま"],["お前","おまえ"],["は"],["誰","だれ"],["を"],["頼み","たのみ"],["に"],["して"],["わたし"],["に"],["刃向かう","はむかう"],["の"],["か"],["。"]]},{"verse":6,"text":"今お前はエジプトというあの折れかけの葦の杖を頼みにしているが、それはだれでも寄りかかる者の手を刺し貫くだけだ。エジプトの王ファラオは、自分を頼みとするすべての者にとってそのようになる。","tok":[["今","いま"],["お前","おまえ"],["は"],["エジプト"],["と"],["いう"],["あの"],["折れ","おれ"],["かけ"],["の"],["葦","あし"],["の"],["杖","つえ"],["を"],["頼み","たのみ"],["に"],["して"],["いる"],["が"],["、"],["それ"],["は"],["だれ"],["で"],["も"],["寄りかかる","よりかかる"],["者","もの"],["の"],["手","て"],["を"],["刺し貫く","さしつらぬく"],["だけ"],["だ"],["。"],["エジプト"],["の"],["王","おう"],["ファラオ"],["は"],["、"],["自分","じぶん"],["を"],["頼み","たのみ"],["と"],["する"],["すべて"],["の"],["者","もの"],["にとって"],["その"],["よう"],["に"],["なる"],["。"]]},{"verse":7,"text":"お前は、『我々は我々の神、主に依り頼む』と言っているが、ヒゼキヤはユダとエルサレムに向かい、『この祭壇の前で礼拝せよ』と言って、その主の聖なる高台と祭壇を取り除いたのではなかったか。","tok":[["お前","おまえ"],["は"],["、"],["『"],["我々","われわれ"],["は"],["我々","われわれ"],["の"],["神","かみ"],["、"],["主に","おもに"],["依り頼む","よりたのむ"],["』"],["と"],["言って","いって"],["いる"],["が"],["、"],["ヒゼキヤ"],["は"],["ユダ"],["と"],["エルサレム"],["に"],["向かい","むかい"],["、"],["『"],["この"],["祭壇","さいだん"],["の"],["前","まえ"],["で"],["礼拝","れいはい"],["せよ"],["』"],["と"],["言って","いって"],["、"],["その"],["主","ぬし"],["の"],["聖","せい"],["なる"],["高台","たかだい"],["と"],["祭壇","さいだん"],["を"],["取り除いた","とりのぞいた"],["ので"],["は"],["なかった"],["か"],["。"]]},{"verse":8,"text":"今わが主君、アッシリアの王とかけをせよ。もしお前の方でそれだけの乗り手を準備できるなら、こちらから二千頭の馬を与えよう。","tok":[["今","いま"],["わが"],["主君","しゅくん"],["、"],["アッシリア"],["の"],["王","おう"],["と"],["かけ"],["を"],["せよ"],["。"],["もし"],["お前","おまえ"],["の"],["方","ほう"],["で"],["それ"],["だけ"],["の"],["乗り手","のりて"],["を"],["準備","じゅんび"],["できるなら"],["、"],["こちら"],["から"],["二千頭","にせんとう"],["の"],["馬","うま"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":9,"text":"戦車について、騎兵についてエジプトなどを頼みにしているお前に、どうしてわが主君の家臣のうちの最も小さい総督の一人すら追い返すことができようか。","tok":[["戦車","せんしゃ"],["について"],["、"],["騎兵","きへい"],["について"],["エジプト"],["など"],["を"],["頼み","たのみ"],["に"],["して"],["いる"],["お前","おまえ"],["に"],["、"],["どう"],["して"],["わが"],["主君","しゅくん"],["の"],["家臣","かしん"],["の"],["うち"],["の"],["最も","もっとも"],["小さい","ちいさい"],["総督","そうとく"],["の"],["一人","ひとり"],["すら"],["追い返す","おいかえす"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":10,"text":"わたしは今、主とかかわりなくこの地を滅ぼしに来たのだろうか。主がわたしに、『この地に向かって攻め上り、これを滅ぼせ』とお命じになったのだ。」","tok":[["わたし"],["は"],["今","いま"],["、"],["主","ぬし"],["と"],["か"],["か"],["わりなく"],["この"],["地","ち"],["を"],["滅ぼし","ほろぼし"],["に"],["来た","きた"],["の"],["だろう"],["か"],["。"],["主","ぬし"],["が"],["わたし"],["に"],["、"],["『"],["この"],["地","ち"],["に"],["向かって","むかって"],["攻め上り","せめのぼり"],["、"],["これ"],["を"],["滅ぼせ","ほろぼせ"],["』"],["と"],["お命じ","おめいじ"],["に"],["なった"],["の"],["だ"],["。"],["」"]]},{"verse":11,"text":"エルヤキムとシェブナとヨアは、ラブ‧シャケに願った。「僕どもはアラム語が分かります。どうぞアラム語でお話しください。城壁の上にいる民が聞いているところで、わたしどもにユダの言葉で話さないでください。」","tok":[["エルヤキム"],["と"],["シェブナ"],["と"],["ヨア"],["は"],["、"],["ラブ"],["‧"],["シャケ"],["に"],["願った","ねがった"],["。"],["「"],["僕","ぼく"],["ども"],["は"],["アラム"],["語","ご"],["が"],["分かります","わかります"],["。"],["どうぞ"],["アラム"],["語","ご"],["で"],["お話し","おはなし"],["ください"],["。"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["いる"],["民","たみ"],["が"],["聞いて","きいて"],["いる"],["ところ"],["で"],["、"],["わたし"],["ども"],["に"],["ユダ"],["の"],["言葉","ことば"],["で"],["話さないで","はなさないで"],["ください"],["。"],["」"]]},{"verse":12,"text":"だがラブ‧シャケは言った。「わが主君がこれらのことを告げるためにわたしを遣わしたのは、お前の主君やお前のためだけだとでもいうのか。城壁の上に座っている者たちのためにも遣わしたのではないか。彼らもお前たちと共に自分の糞尿を飲み食いするようになるのだから。」","tok":[["だ"],["が"],["ラブ"],["‧"],["シャケ"],["は"],["言った","いった"],["。"],["「"],["わが"],["主君","しゅくん"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["告げる","つげる"],["ため"],["に"],["わたし"],["を"],["遣わした","つかわした"],["の"],["は"],["、"],["お前","おまえ"],["の"],["主君","しゅくん"],["や"],["お前","おまえ"],["の"],["ため"],["だけ"],["だ"],["と"],["で"],["も"],["いう"],["の"],["か"],["。"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["座って","すわって"],["いる"],["者","もの"],["たち"],["の"],["ため"],["に"],["も"],["遣わした","つかわした"],["ので"],["は"],["ない"],["か"],["。"],["彼","かれ"],["ら"],["も"],["お前","おまえ"],["たち"],["と"],["共","とも"],["に"],["自分","じぶん"],["の"],["糞尿","ふんにょう"],["を"],["飲み食い","のみくい"],["する"],["よう"],["に"],["なる"],["の"],["だ"],["から"],["。"],["」"]]},{"verse":13,"text":"ラブ‧シャケは立ってユダの言葉で大声で呼ばわり、こう言い放った。「大王、アッシリアの王の言葉を聞け。","tok":[["ラブ"],["‧"],["シャケ"],["は"],["立って","たって"],["ユダ"],["の"],["言葉","ことば"],["で"],["大声","おおごえ"],["で"],["呼ばわり","よばわり"],["、"],["こう"],["言い放った","いいはなった"],["。"],["「"],["大王","だいおう"],["、"],["アッシリア"],["の"],["王","おう"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":14,"text":"王はこう言われる。『ヒゼキヤにだまされるな。彼はお前たちを救い出すことはできない。","tok":[["王","おう"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["ヒゼキヤ"],["に"],["だまされる"],["な"],["。"],["彼","かれ"],["は"],["お前","おまえ"],["たち"],["を"],["救い出す","すくいだす"],["こと"],["は"],["できない"],["。"]]},{"verse":15,"text":"ヒゼキヤは、お前たちに、主が必ず我々を救い出してくださる。決してこの都がアッシリアの王の手に渡されることはない、と言って主に依り頼ませようとするが、そうさせてはならない。』","tok":[["ヒゼキヤ"],["は"],["、"],["お前","おまえ"],["たち"],["に"],["、"],["主","ぬし"],["が"],["必ず","かならず"],["我々","われわれ"],["を"],["救い出して","すくいだして"],["くださる"],["。"],["決して","けっして"],["この"],["都","と"],["が"],["アッシリア"],["の"],["王","おう"],["の"],["手","て"],["に"],["渡される","わたされる"],["こと"],["は"],["ない"],["、"],["と"],["言って","いって"],["主に","おもに"],["依り頼ませよう","よりたのませよう"],["と"],["する"],["が"],["、"],["そう"],["させて"],["は"],["ならない"],["。"],["』"]]},{"verse":16,"text":"ヒゼキヤの言うことを聞くな。アッシリアの王がこう言われるからだ。『わたしと和を結び、降伏せよ。そうすればお前たちは皆、自分のぶどうといちじくの実を食べ、自分の井戸の水を飲むことができる。","tok":[["ヒゼキヤ"],["の"],["言う","いう"],["こと"],["を"],["聞く","きく"],["な"],["。"],["アッシリア"],["の"],["王","おう"],["が"],["こう"],["言われる","いわれる"],["から"],["だ"],["。"],["『"],["わたし"],["と"],["和","わ"],["を"],["結び","むすび"],["、"],["降伏","こうふく"],["せよ"],["。"],["そう"],["すれば"],["お前","おまえ"],["たち"],["は"],["皆","みな"],["、"],["自分","じぶん"],["の"],["ぶどう"],["と"],["いちじく"],["の"],["実","じつ"],["を"],["食べ","たべ"],["、"],["自分","じぶん"],["の"],["井戸","いど"],["の"],["水","みず"],["を"],["飲む","のむ"],["こと"],["が"],["できる"],["。"]]},{"verse":17,"text":"やがてわたしは来て、お前たちをお前たちの地と同じような地、穀物と新しいぶどう酒の地、パンとぶどう畑の地に連れて行く』と。","tok":[["やがて"],["わたし"],["は"],["来て","きて"],["、"],["お前","おまえ"],["たち"],["を"],["お前","おまえ"],["たち"],["の"],["地","ち"],["と"],["同じ","おなじ"],["よう"],["な"],["地","ち"],["、"],["穀物","こくもつ"],["と"],["新しい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["の"],["地","ち"],["、"],["パン"],["と"],["ぶどう"],["畑","はたけ"],["の"],["地","ち"],["に"],["連れて","つれて"],["行く","いく"],["』"],["と"],["。"]]},{"verse":18,"text":"ヒゼキヤが、『主は我々を救い出してくださる』と言っても、惑わされるな。諸国の神々は、それぞれ自分の地をアッシリア王の手から救い出すことができたであろうか。","tok":[["ヒゼキヤ"],["が"],["、"],["『"],["主","ぬし"],["は"],["我々","われわれ"],["を"],["救い出して","すくいだして"],["くださる"],["』"],["と"],["言って","いって"],["も"],["、"],["惑わされる","まどわされる"],["な"],["。"],["諸国","しょこく"],["の"],["神々","かみがみ"],["は"],["、"],["それぞれ"],["自分","じぶん"],["の"],["地","ち"],["を"],["アッシリア"],["王","おう"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["こと"],["が"],["できたで"],["あろう"],["か"],["。"]]},{"verse":19,"text":"ハマトやアルパドの神々はどこに行ったのか。セファルワイムの神々はどこに行ったのか。サマリアをわたしの手から救い出した神があっただろうか。","tok":[["ハマト"],["や"],["アルパド"],["の"],["神々","かみがみ"],["は"],["どこ"],["に"],["行った","いった"],["の"],["か"],["。"],["セファルワイム"],["の"],["神々","かみがみ"],["は"],["どこ"],["に"],["行った","いった"],["の"],["か"],["。"],["サマリア"],["を"],["わたし"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["神","かみ"],["が"],["あっただろう"],["か"],["。"]]},{"verse":20,"text":"これらの国々のすべての神々のうち、どの神が自分の国をわたしの手から救い出したか。それでも主はエルサレムをわたしの手から救い出すと言うのか。」","tok":[["これ"],["ら"],["の"],["国々","くにぐに"],["の"],["すべて"],["の"],["神々","かみがみ"],["の"],["うち"],["、"],["どの"],["神","かみ"],["が"],["自分","じぶん"],["の"],["国","くに"],["を"],["わたし"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["か"],["。"],["それ"],["で"],["も"],["主","ぬし"],["は"],["エルサレム"],["を"],["わたし"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["と"],["言う","いう"],["の"],["か"],["。"],["」"]]},{"verse":21,"text":"しかし彼らは、答えてはならないと王に戒められていたので、押し黙ってひと言も答えなかった。","tok":[["しかし"],["彼","かれ"],["ら"],["は"],["、"],["答えて","こたえて"],["は"],["ならない"],["と"],["王","おう"],["に"],["戒められて","いましめられて"],["いた"],["ので"],["、"],["押し黙って","おしだまって"],["ひと言","ひとこと"],["も"],["答えなかった","こたえなかった"],["。"]]},{"verse":22,"text":"ヒルキヤの子である宮廷長エルヤキム、書記官シェブナ、アサフの子である補佐官ヨアは衣を裂き、ヒゼキヤのもとに来てラブ‧シャケの言葉を伝えた。","tok":[["ヒルキヤ"],["の"],["子","こ"],["で"],["ある"],["宮廷長","きゅうていちょう"],["エルヤキム"],["、"],["書記官","しょきかん"],["シェブナ"],["、"],["アサフ"],["の"],["子","こ"],["で"],["ある"],["補佐官","ほさかん"],["ヨア"],["は"],["衣","ころも"],["を"],["裂き","さき"],["、"],["ヒゼキヤ"],["の"],["もと"],["に"],["来て","きて"],["ラブ"],["‧"],["シャケ"],["の"],["言葉","ことば"],["を"],["伝えた","つたえた"],["。"]]}]
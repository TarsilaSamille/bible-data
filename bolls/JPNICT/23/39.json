[{"verse":1,"text":"そのころ、バビロンの王、バルアダンの子メロダク‧バルアダンがヒゼキヤに手紙と贈り物を送って来た。病気であった彼が健康を回復したことを聞いたからである。","tok":[["その"],["ころ"],["、"],["バビロン"],["の"],["王","おう"],["、"],["バルアダン"],["の"],["子","こ"],["メロダク"],["‧"],["バルアダン"],["が"],["ヒゼキヤ"],["に"],["手紙","てがみ"],["と"],["贈り物","おくりもの"],["を"],["送って","おくって"],["来た","きた"],["。"],["病気","びょうき"],["で"],["あった"],["彼","かれ"],["が"],["健康","けんこう"],["を"],["回復","かいふく"],["した"],["こと"],["を"],["聞いた","きいた"],["から"],["で"],["ある"],["。"]]},{"verse":2,"text":"ヒゼキヤは使者たちを歓迎し、銀、金、香料、上等の油など宝物庫と、武器庫、倉庫にある一切の物を彼らに見せた。ヒゼキヤが彼らに見せなかったものは、宮中はもとより国中にひとつもなかった。","tok":[["ヒゼキヤ"],["は"],["使者","ししゃ"],["たち"],["を"],["歓迎","かんげい"],["し"],["、"],["銀","ぎん"],["、"],["金","きん"],["、"],["香料","こうりょう"],["、"],["上等","じょうとう"],["の"],["油","あぶら"],["など"],["宝物庫","ほうもつこ"],["と"],["、"],["武器庫","ぶきこ"],["、"],["倉庫","そうこ"],["に"],["ある"],["一切","いっさい"],["の"],["物","もの"],["を"],["彼","かれ"],["ら"],["に"],["見せた","みせた"],["。"],["ヒゼキヤ"],["が"],["彼","かれ"],["ら"],["に"],["見せなかった","みせなかった"],["もの"],["は"],["、"],["宮中","きゅうちゅう"],["は"],["もとより"],["国中","くにちゅう"],["に"],["ひと"],["つ"],["も"],["なかった"],["。"]]},{"verse":3,"text":"預言者イザヤはヒゼキヤ王のところに来て、「あの人々は何を言ったのですか。どこから訪ねて来たのですか」と問うた。ヒゼキヤは、「彼らは遠い国、バビロンから来ました」と答えた。","tok":[["預言者","よげんしゃ"],["イザヤ"],["は"],["ヒゼキヤ"],["王","おう"],["の"],["ところ"],["に"],["来て","きて"],["、"],["「"],["あの"],["人々","ひとびと"],["は"],["何","なん"],["を"],["言った","いった"],["の"],["です"],["か"],["。"],["どこ"],["から"],["訪ねて","たずねて"],["来た","きた"],["の"],["です"],["か"],["」"],["と"],["問うた","とうた"],["。"],["ヒゼキヤ"],["は"],["、"],["「"],["彼","かれ"],["ら"],["は"],["遠い","とおい"],["国","くに"],["、"],["バビロン"],["から"],["来ました","きました"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":4,"text":"更に、「彼らは王宮で何を見たのですか」と問うと、ヒゼキヤは、「王宮にあるものは何もかも見ました。倉庫の中のものも見せなかったものは何一つありません」と答えた。","tok":[["更に","さらに"],["、"],["「"],["彼","かれ"],["ら"],["は"],["王宮","おうきゅう"],["で"],["何","なん"],["を"],["見た","みた"],["の"],["です"],["か"],["」"],["と"],["問う","とう"],["と"],["、"],["ヒゼキヤ"],["は"],["、"],["「"],["王宮","おうきゅう"],["に"],["ある"],["もの"],["は"],["何","なん"],["も"],["か"],["も"],["見ました","みました"],["。"],["倉庫","そうこ"],["の"],["中","なか"],["の"],["もの"],["も"],["見せなかった","みせなかった"],["もの"],["は"],["何","なん"],["一","ひと"],["つ"],["ありません"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":5,"text":"そこでイザヤはヒゼキヤに言った。「万軍の主の言葉を聞きなさい。","tok":[["そこ"],["で"],["イザヤ"],["は"],["ヒゼキヤ"],["に"],["言った","いった"],["。"],["「"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞き","きき"],["なさい"],["。"]]},{"verse":6,"text":"王宮にあるもの、あなたの先祖が今日まで蓄えてきたものが、ことごとくバビロンに運び去られ、何も残らなくなる日が来る、と主は言われる。","tok":[["王宮","おうきゅう"],["に"],["ある"],["もの"],["、"],["あなた"],["の"],["先祖","せんぞ"],["が"],["今日","きょう"],["まで"],["蓄えて","たくわえて"],["きた"],["もの"],["が"],["、"],["ことごとく"],["バビロン"],["に"],["運び去られ","はこびさられ"],["、"],["何","なん"],["も"],["残らなく","のこらなく"],["なる"],["日","ひ"],["が"],["来る","くる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":7,"text":"あなたから生まれた息子の中には、バビロン王の宮殿に連れて行かれ、宦官にされる者もある。」","tok":[["あなた"],["から"],["生まれた","うまれた"],["息子","むすこ"],["の"],["中","なか"],["に"],["は"],["、"],["バビロン"],["王","おう"],["の"],["宮殿","きゅうでん"],["に"],["連れて","つれて"],["行かれ","いかれ"],["、"],["宦官","かんがん"],["に"],["される"],["者","もの"],["も"],["ある"],["。"],["」"]]},{"verse":8,"text":"ヒゼキヤはイザヤに、「あなたの告げる主の言葉はありがたいものです」と答えた。彼は、自分の在世中は平和と安定が続くと思っていた。","tok":[["ヒゼキヤ"],["は"],["イザヤ"],["に"],["、"],["「"],["あなた"],["の"],["告げる","つげる"],["主","ぬし"],["の"],["言葉","ことば"],["は"],["ありがたい"],["もの"],["です"],["」"],["と"],["答えた","こたえた"],["。"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["の"],["在世中","ざいせちゅう"],["は"],["平和","へいわ"],["と"],["安定","あんてい"],["が"],["続く","つづく"],["と"],["思って","おもって"],["いた"],["。"]]}]
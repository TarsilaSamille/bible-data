[{"verse":1,"text":"身を低くして塵の中に座れおとめである、娘バビロンよ。王座を離れ、地に座れ、娘カルデアよ。柔らかでぜいたくな娘と呼ばれることは二度とない。","tok":[["身","み"],["を"],["低く","ひくく"],["して"],["塵","ごみ"],["の"],["中","なか"],["に"],["座れ","すわれ"],["おとめ"],["で"],["ある"],["、"],["娘","むすめ"],["バビロン"],["よ"],["。"],["王座","おうざ"],["を"],["離れ","はなれ"],["、"],["地","ち"],["に"],["座れ","すわれ"],["、"],["娘","むすめ"],["カルデア"],["よ"],["。"],["柔らか","やわらか"],["で"],["ぜいたく"],["な"],["娘","むすめ"],["と"],["呼ばれる","よばれる"],["こと"],["は"],["二","に"],["度","ど"],["と"],["ない"],["。"]]},{"verse":2,"text":"石臼を取って粉をひけ。ベールを脱ぎ、衣の裾をたくし上げすねをあらわにして川を渡れ。","tok":[["石臼","いしうす"],["を"],["取って","とって"],["粉","こな"],["を"],["ひけ"],["。"],["ベール"],["を"],["脱ぎ","ぬぎ"],["、"],["衣","ころも"],["の"],["裾","すそ"],["を"],["たくし上げ","たくしあげ"],["すね"],["を"],["あらわ"],["に"],["して"],["川","かわ"],["を"],["渡れ","わたれ"],["。"]]},{"verse":3,"text":"お前は裸にされ、恥はあらわになる。わたしは報復し、ひとりも容赦しない。","tok":[["お前","おまえ"],["は"],["裸","はだか"],["に"],["され"],["、"],["恥","はじ"],["は"],["あらわ"],["に"],["なる"],["。"],["わたし"],["は"],["報復","ほうふく"],["し"],["、"],["ひとり"],["も"],["容赦","ようしゃ"],["しない"],["。"]]},{"verse":4,"text":"わたしたちの贖い主、その御名は万軍の主イスラエルの聖なる神。","tok":[["わたしたち"],["の"],["贖い","あがない"],["主","ぬし"],["、"],["その"],["御名","ぎょめい"],["は"],["万","まん"],["軍","ぐん"],["の"],["主","しゅ"],["イスラエル"],["の"],["聖","せい"],["なる"],["神","かみ"],["。"]]},{"verse":5,"text":"沈黙して座り、闇の中に入れ、娘カルデアよ。諸国の女王と呼ばれることは二度とない。","tok":[["沈黙","ちんもく"],["して"],["座り","すわり"],["、"],["闇","やみ"],["の"],["中","なか"],["に"],["入れ","いれ"],["、"],["娘","むすめ"],["カルデア"],["よ"],["。"],["諸国","しょこく"],["の"],["女王","じょおう"],["と"],["呼ばれる","よばれる"],["こと"],["は"],["二","に"],["度","ど"],["と"],["ない"],["。"]]},{"verse":6,"text":"わたしは自分の民に対して怒りわたしの嗣業の民を汚し、お前の手に渡した。お前は彼らに憐れみをかけず老人にも軛を負わせ、甚だしく重くした。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["民","たみ"],["に対して","にたいして"],["怒り","おこり"],["わたし"],["の"],["嗣業","しぎょう"],["の"],["民","たみ"],["を"],["汚し","よごし"],["、"],["お前","おまえ"],["の"],["手","て"],["に"],["渡した","わたした"],["。"],["お前","おまえ"],["は"],["彼","かれ"],["ら"],["に"],["憐れみ","あわれみ"],["を"],["かけず"],["老人","ろうじん"],["に"],["も"],["軛","くびき"],["を"],["負わせ","おわせ"],["、"],["甚だしく","はなはだしく"],["重く","おもく"],["した"],["。"]]},{"verse":7,"text":"わたしは永遠に女王だ、とお前は言い何事も心に留めず、終わりの事を思わなかった。","tok":[["わたし"],["は"],["永遠","えいえん"],["に"],["女王","じょおう"],["だ"],["、"],["と"],["お前","おまえ"],["は"],["言い","いい"],["何事","なにごと"],["も"],["心","こころ"],["に"],["留めず","とめず"],["、"],["終わり","おわり"],["の"],["事","こと"],["を"],["思わなかった","おもわなかった"],["。"]]},{"verse":8,"text":"今、これを聞くがよい快楽に浸り、安んじて座る女よ。わたしだけわたしのほかにはだれもいない、と言いわたしはやもめになることなく子を失うこともない、と心に言う者よ。","tok":[["今","いま"],["、"],["これ"],["を"],["聞く","きく"],["が"],["よい"],["快楽","かいらく"],["に"],["浸り","ひたり"],["、"],["安んじて","やすんじて"],["座る","すわる"],["女","おんな"],["よ"],["。"],["わたし"],["だけ"],["わたし"],["の"],["ほか"],["に"],["は"],["だれ"],["も"],["いない"],["、"],["と"],["言いわたし","いいわたし"],["は"],["やもめ"],["に"],["なる"],["こと"],["なく"],["子","こ"],["を"],["失う","うしなう"],["こと"],["も"],["ない"],["、"],["と"],["心","こころ"],["に"],["言う","いう"],["者","もの"],["よ"],["。"]]},{"verse":9,"text":"その二つのことが一日のうちに、瞬く間にお前に起こり子を失いやもめとなる苦しみがすべてお前に臨む。どれほど呪文を唱えどれほど強いまじないをしても無駄だ。","tok":[["その"],["二","ふた"],["つ"],["の"],["こと"],["が"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["、"],["瞬く","しばたたく"],["間","あいだ"],["に"],["お前","おまえ"],["に"],["起こり","おこり"],["子","こ"],["を"],["失い","うしない"],["やもめ"],["と"],["なる"],["苦しみ","くるしみ"],["が"],["すべて"],["お前","おまえ"],["に"],["臨む","のぞむ"],["。"],["どれ"],["ほど"],["呪文","じゅもん"],["を"],["唱え","となえ"],["どれ"],["ほど"],["強い","つよい"],["まじない"],["を"],["して"],["も"],["無駄","むだ"],["だ"],["。"]]},{"verse":10,"text":"お前は平然と悪事をし「見ている者はない」と言っていた。お前の知恵と知識がお前を誤らせお前は心に言っていたわたしだけわたしのほかにはだれもいない、と。","tok":[["お前","おまえ"],["は"],["平然","へいぜん"],["と"],["悪事","あくじ"],["を"],["し"],["「"],["見て","みて"],["いる"],["者","もの"],["は"],["ない"],["」"],["と"],["言って","いって"],["いた"],["。"],["お前","おまえ"],["の"],["知恵","ちえ"],["と"],["知識","ちしき"],["が"],["お前","おまえ"],["を"],["誤らせ","あやまらせ"],["お前","おまえ"],["は"],["心","こころ"],["に"],["言って","いって"],["いた"],["わたし"],["だけ"],["わたし"],["の"],["ほか"],["に"],["は"],["だれ"],["も"],["いない"],["、"],["と"],["。"]]},{"verse":11,"text":"だが、災いがお前を襲うとそれに対するまじないを知らず災難がふりかかっても、払いのけられない。思いもかけない時、突然、破滅がお前を襲う。","tok":[["だ"],["が"],["、"],["災い","わざわい"],["が"],["お前","おまえ"],["を"],["襲う","おそう"],["と"],["それ"],["に"],["対する","たいする"],["まじない"],["を"],["知らず","しらず"],["災難","さいなん"],["が"],["ふりかかって"],["も"],["、"],["払いのけられない","はらいのけられない"],["。"],["思い","おもい"],["も"],["かけない"],["時","とき"],["、"],["突然","とつぜん"],["、"],["破滅","はめつ"],["が"],["お前","おまえ"],["を"],["襲う","おそう"],["。"]]},{"verse":12,"text":"まじないと呪文の数々をもって立ち向かえ。若い時から労して身につけたものがあるいは役に立ちそれを追い払うことができるかもしれない。","tok":[["まじない"],["と"],["呪文","じゅもん"],["の"],["数々","かずかず"],["を"],["もって"],["立ち向かえ","たちむかえ"],["。"],["若い","わかい"],["時","とき"],["から"],["労して","ろうして"],["身","み"],["に"],["つけた"],["もの"],["が"],["あるいは"],["役","やく"],["に"],["立ち","たち"],["それ"],["を"],["追い払う","おいはらう"],["こと"],["が"],["できる"],["か"],["も"],["しれない"],["。"]]},{"verse":13,"text":"助言が多すぎて、お前は弱ってしまった。天にしるしを見る者、星によって占う者新月によってお前の運命を告げる者などを立ち向かわせ、お前を救わせてみよ。","tok":[["助言","じょげん"],["が"],["多","おお"],["すぎて"],["、"],["お前","おまえ"],["は"],["弱って","よわって"],["しまった"],["。"],["天","てん"],["に"],["しるし"],["を"],["見る","みる"],["者","もの"],["、"],["星","ほし"],["によって"],["占う","うらなう"],["者","もの"],["新月","しんげつ"],["によって"],["お前","おまえ"],["の"],["運命","うんめい"],["を"],["告げる","つげる"],["者","もの"],["など"],["を"],["立ち向かわせ","たちむかわせ"],["、"],["お前","おまえ"],["を"],["救わせて","すくわせて"],["み"],["よ"],["。"]]},{"verse":14,"text":"見よ、彼らはわらにすぎず、火が彼らを焼き尽くし炎の力から自分の命を救い出しえない。この火は体を温める炭火でも傍らに座るための火でもない。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["わら"],["に"],["すぎず"],["、"],["火","ひ"],["が"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くし","つくし"],["炎","えん"],["の"],["力","ちから"],["から"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救い出し","すくいだし"],["えない"],["。"],["この"],["火","ひ"],["は"],["体","からだ"],["を"],["温める","あたためる"],["炭火","すみび"],["で"],["も"],["傍ら","かたわら"],["に"],["座る","すわる"],["ため"],["の"],["火","ひ"],["で"],["も"],["ない"],["。"]]},{"verse":15,"text":"呪文を若い時から労して身につけ売り物としてきた者すら、この様だ。彼らはおのおの勝手に迷って行きお前を救う者はひとりもいない。","tok":[["呪文","じゅもん"],["を"],["若い","わかい"],["時","とき"],["から"],["労して","ろうして"],["身","み"],["に"],["つけ"],["売り物","うりもの"],["として"],["きた"],["者","もの"],["すら"],["、"],["この"],["様","よう"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["おのおの"],["勝手","かって"],["に"],["迷って","まよって"],["行き","いき"],["お前","おまえ"],["を"],["救う","すくう"],["者","もの"],["は"],["ひとり"],["も"],["いない"],["。"]]}]
[{"verse":1,"text":"ユダの王ウジヤの孫であり、ヨタムの子であるアハズの治世のことである。アラムの王レツィンとレマルヤの子、イスラエルの王ペカが、エルサレムを攻めるため上って来たが、攻撃を仕掛けることはできなかった。","tok":[["ユダ"],["の"],["王","おう"],["ウジヤ"],["の"],["孫","まご"],["で"],["あり"],["、"],["ヨタム"],["の"],["子","こ"],["で"],["ある"],["アハズ"],["の"],["治世","ちせい"],["の"],["こと"],["で"],["ある"],["。"],["アラム"],["の"],["王","おう"],["レツィン"],["と"],["レマルヤ"],["の"],["子","こ"],["、"],["イスラエル"],["の"],["王","おう"],["ペカ"],["が"],["、"],["エルサレム"],["を"],["攻める","せめる"],["ため"],["上って","のぼって"],["来た","きた"],["が"],["、"],["攻撃","こうげき"],["を"],["仕掛ける","しかける"],["こと"],["は"],["できなかった"],["。"]]},{"verse":2,"text":"しかし、アラムがエフライムと同盟したという知らせは、ダビデの家に伝えられ、王の心も民の心も、森の木々が風に揺れ動くように動揺した。","tok":[["しかし"],["、"],["アラム"],["が"],["エフライム"],["と"],["同盟","どうめい"],["した"],["と"],["いう"],["知らせ","しらせ"],["は"],["、"],["ダビデ"],["の"],["家","いえ"],["に"],["伝えられ","つたえられ"],["、"],["王","おう"],["の"],["心","こころ"],["も"],["民","みん"],["の"],["心","こころ"],["も"],["、"],["森","もり"],["の"],["木々","きぎ"],["が"],["風","ふう"],["に"],["揺れ動く","ゆれうごく"],["よう"],["に"],["動揺","どうよう"],["した"],["。"]]},{"verse":3,"text":"主はイザヤに言われた。「あなたは息子のシェアル‧ヤシュブと共に出て行って、布さらしの野に至る大通りに沿う、上貯水池からの水路の外れでアハズに会い、","tok":[["主","ぬし"],["は"],["イザヤ"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["は"],["息子","むすこ"],["の"],["シェアル"],["‧"],["ヤシュブ"],["と"],["共","とも"],["に"],["出て","でて"],["行って","いって"],["、"],["布","ぬの"],["さらし"],["の"],["野","の"],["に"],["至る","いたる"],["大通り","おおどおり"],["に"],["沿う","そう"],["、"],["上","うえ"],["貯水池","ちょすいち"],["から"],["の"],["水路","すいろ"],["の"],["外れ","はずれ"],["で"],["アハズ"],["に"],["会い","あい"],["、"]]},{"verse":4,"text":"彼に言いなさい。落ち着いて、静かにしていなさい。恐れることはない。アラムを率いるレツィンとレマルヤの子が激しても、この二つの燃え残ってくすぶる切り株のゆえに心を弱くしてはならない。","tok":[["彼","かれ"],["に"],["言い","いい"],["なさい"],["。"],["落ち着いて","おちついて"],["、"],["静か","しずか"],["に"],["して"],["い"],["なさい"],["。"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["アラム"],["を"],["率いる","ひきいる"],["レツィン"],["と"],["レマルヤ"],["の"],["子","こ"],["が"],["激して","げきして"],["も"],["、"],["この"],["二","ふた"],["つ"],["の"],["燃え残って","もえのこって"],["くすぶる"],["切り株","きりかぶ"],["の"],["ゆえ"],["に"],["心","こころ"],["を"],["弱く","よわく"],["して"],["は"],["ならない"],["。"]]},{"verse":5,"text":"アラムがエフライムとレマルヤの子を語らって、あなたに対して災いを謀り、","tok":[["アラム"],["が"],["エフライム"],["と"],["レマルヤ"],["の"],["子","こ"],["を"],["語らって","かたらって"],["、"],["あなた"],["に対して","にたいして"],["災い","わざわい"],["を"],["謀り","はかり"],["、"]]},{"verse":6,"text":"『ユダに攻め上って脅かし、我々に従わせ、タベアルの子をそこに王として即位させよう』と言っているが、","tok":[["『"],["ユダ"],["に"],["攻め上って","せめのぼって"],["脅かし","おびやかし"],["、"],["我々","われわれ"],["に"],["従わせ","したがわせ"],["、"],["タベアル"],["の"],["子","こ"],["を"],["そこ"],["に"],["王","おう"],["として"],["即位","そくい"],["させよう"],["』"],["と"],["言って","いって"],["いる"],["が"],["、"]]},{"verse":7,"text":"主なる神はこう言われる。それは実現せず、成就しない。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["それ"],["は"],["実現","じつげん"],["せず"],["、"],["成就","じょうじゅ"],["しない"],["。"]]},{"verse":8,"text":"アラムの頭はダマスコ、ダマスコの頭はレツィン。（六十五年たてばエフライムの民は消滅する）","tok":[["アラム"],["の"],["頭","あたま"],["は"],["ダマスコ"],["、"],["ダマスコ"],["の"],["頭","あたま"],["は"],["レツィン"],["。"],["（"],["六十五","ろくじゅうご"],["年","ねん"],["たてば"],["エフライム"],["の"],["民","たみ"],["は"],["消滅","しょうめつ"],["する"],["）"]]},{"verse":9,"text":"エフライムの頭はサマリアサマリアの頭はレマルヤの子。信じなければ、あなたがたは確かにされない。」","tok":[["エフライム"],["の"],["頭","あたま"],["は"],["サマリア"],["サマリア"],["の"],["頭","あたま"],["は"],["レマルヤ"],["の"],["子","こ"],["。"],["信じなければ","しんじなければ"],["、"],["あなた"],["がた"],["は"],["確か","たしか"],["に"],["されない"],["。"],["」"]]},{"verse":10,"text":"主は更にアハズに向かって言われた。","tok":[["主","ぬし"],["は"],["更に","さらに"],["アハズ"],["に"],["向かって","むかって"],["言われた","いわれた"],["。"]]},{"verse":11,"text":"「主なるあなたの神に、しるしを求めよ。深く陰府の方に、あるいは高く天の方に。」","tok":[["「"],["主","おも"],["なる"],["あなた"],["の"],["神","かみ"],["に"],["、"],["しるし"],["を"],["求めよ","もとめよ"],["。"],["深く","ふかく"],["陰府","よみ"],["の"],["方","ほう"],["に"],["、"],["あるいは"],["高く","たかく"],["天","てん"],["の"],["方","ほう"],["に"],["。"],["」"]]},{"verse":12,"text":"しかし、アハズは言った。「わたしは求めない。主を試すようなことはしない。」","tok":[["しかし"],["、"],["アハズ"],["は"],["言った","いった"],["。"],["「"],["わたし"],["は"],["求めない","もとめない"],["。"],["主","ぬし"],["を"],["試す","ためす"],["よう"],["な"],["こと"],["は"],["しない"],["。"],["」"]]},{"verse":13,"text":"イザヤは言った。「ダビデの家よ聞け。あなたたちは人間にもどかしい思いをさせるだけでは足りずわたしの神にも、もどかしい思いをさせるのか。","tok":[["イザヤ"],["は"],["言った","いった"],["。"],["「"],["ダビデ"],["の"],["家","いえ"],["よ"],["聞け","きけ"],["。"],["あなた"],["たち"],["は"],["人間","にんげん"],["に"],["もどかしい"],["思い","おもい"],["を"],["させる"],["だけ"],["で"],["は"],["足りず","たりず"],["わたし"],["の"],["神","かみ"],["に"],["も"],["、"],["もどかしい"],["思い","おもい"],["を"],["させる"],["の"],["か"],["。"]]},{"verse":14,"text":"それゆえ、わたしの主が御自らあなたたちにしるしを与えられる。見よ、おとめが身ごもって、男の子を産みその名をインマヌエルと呼ぶ。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["の"],["主","ぬし"],["が"],["御自ら","おみずから"],["あなた"],["たち"],["に"],["しるし"],["を"],["与えられる","あたえられる"],["。"],["見よ","みよ"],["、"],["おとめ"],["が"],["身ごもって","みごもって"],["、"],["男の子","おとこのこ"],["を"],["産み","うみ"],["その"],["名","な"],["を"],["インマヌエル"],["と"],["呼ぶ","よぶ"],["。"]]},{"verse":15,"text":"災いを退け、幸いを選ぶことを知るようになるまで彼は凝乳と蜂蜜を食べ物とする。","tok":[["災い","わざわい"],["を"],["退け","しりぞけ"],["、"],["幸い","さいわい"],["を"],["選ぶ","えらぶ"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["まで"],["彼","かれ"],["は"],["凝乳","ぎょうにゅう"],["と"],["蜂蜜","はちみつ"],["を"],["食べ物","たべもの"],["と"],["する"],["。"]]},{"verse":16,"text":"その子が災いを退け、幸いを選ぶことを知る前に、あなたの恐れる二人の王の領土は必ず捨てられる。","tok":[["その"],["子","こ"],["が"],["災い","わざわい"],["を"],["退け","しりぞけ"],["、"],["幸い","さいわい"],["を"],["選ぶ","えらぶ"],["こと"],["を"],["知る","しる"],["前","まえ"],["に"],["、"],["あなた"],["の"],["恐れる","おそれる"],["二人","ふたり"],["の"],["王","おう"],["の"],["領土","りょうど"],["は"],["必ず","かならず"],["捨てられる","すてられる"],["。"]]},{"verse":17,"text":"主は、あなたとあなたの民と父祖の家の上に、エフライムがユダから分かれて以来、臨んだことのないような日々を臨ませる。アッシリアの王がそれだ。」","tok":[["主","ぬし"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["民","たみ"],["と"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["上","うえ"],["に"],["、"],["エフライム"],["が"],["ユダ"],["から"],["分かれて","わかれて"],["以来","いらい"],["、"],["臨んだ","のぞんだ"],["こと"],["の"],["ない"],["よう"],["な"],["日々","ひび"],["を"],["臨ませる","のぞませる"],["。"],["アッシリア"],["の"],["王","おう"],["が"],["それ"],["だ"],["。"],["」"]]},{"verse":18,"text":"その日が来れば主は口笛を吹いてエジプトの川の果てから蠅をアッシリアの地から蜂を呼ばれる。","tok":[["その"],["日","ひ"],["が"],["来れば","くれば"],["主","ぬし"],["は"],["口笛","くちぶえ"],["を"],["吹いて","ふいて"],["エジプト"],["の"],["川","かわ"],["の"],["果て","はて"],["から"],["蠅","はえ"],["を"],["アッシリア"],["の"],["地","ち"],["から"],["蜂","はち"],["を"],["呼ばれる","よばれる"],["。"]]},{"verse":19,"text":"彼らは一斉に飛んで来て深い谷間や岩の裂け目に宿りどの茨にも、どの牧場にも宿る。","tok":[["彼","かれ"],["ら"],["は"],["一斉","いっせい"],["に"],["飛んで","とんで"],["来て","きて"],["深い","ふかい"],["谷間","たにま"],["や"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["宿り","やどり"],["どの"],["茨","うばら"],["に"],["も"],["、"],["どの"],["牧場","ぼくじょう"],["に"],["も"],["宿る","やどる"],["。"]]},{"verse":20,"text":"その日には、わたしの主は大河のかなたでかみそりを雇われる。アッシリアの王がそれだ。頭髪も足の毛もひげもそり落とされる。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["わたし"],["の"],["主","ぬし"],["は"],["大河","たいが"],["の"],["かなた"],["で"],["かみそり"],["を"],["雇われる","やとわれる"],["。"],["アッシリア"],["の"],["王","おう"],["が"],["それ"],["だ"],["。"],["頭髪","とうはつ"],["も"],["足","あし"],["の"],["毛","け"],["も"],["ひげ"],["も"],["そり落とされる","そりおとされる"],["。"]]},{"verse":21,"text":"その日が来れば人は子牛一頭、羊二匹の命を救いうるのみ。","tok":[["その"],["日","ひ"],["が"],["来れば","くれば"],["人","ひと"],["は"],["子牛","こうし"],["一頭","いちとう"],["、"],["羊","ひつじ"],["二匹","にひき"],["の"],["命","いのち"],["を"],["救い","すくい"],["うる"],["のみ"],["。"]]},{"verse":22,"text":"しかし、それらは乳を豊かに出すようになり人は凝乳を食べることができるこの地に残った者は皆、凝乳と蜂蜜を食べる。","tok":[["しかし"],["、"],["それ"],["ら"],["は"],["乳","ちち"],["を"],["豊か","ゆたか"],["に"],["出す","だす"],["よう"],["に"],["なり"],["人","ひと"],["は"],["凝乳","ぎょうにゅう"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["この"],["地","ち"],["に"],["残った","のこった"],["者","もの"],["は"],["皆","みな"],["、"],["凝乳","ぎょうにゅう"],["と"],["蜂蜜","はちみつ"],["を"],["食べる","たべる"],["。"]]},{"verse":23,"text":"その日が来ればぶどうの木を千株も育てうるところ銀一千シェケルに値するところもすべて茨とおどろに覆われる。","tok":[["その"],["日","ひ"],["が"],["来れば","くれば"],["ぶどう"],["の"],["木","き"],["を"],["千","せん"],["株","かぶ"],["も"],["育て","そだて"],["うる"],["ところ"],["銀一","ぎんいち"],["千","せん"],["シェケル"],["に"],["値","あたい"],["する"],["ところ"],["も"],["すべて"],["茨","うばら"],["と"],["おどろ"],["に"],["覆われる","おおわれる"],["。"]]},{"verse":24,"text":"茨とおどろがこの地を覆うので人は弓矢を持ってそこへ行かねばならない。","tok":[["茨","うばら"],["と"],["おどろ"],["が"],["この"],["地","ち"],["を"],["覆う","おおう"],["ので"],["人","ひと"],["は"],["弓矢","ゆみや"],["を"],["持って","もって"],["そこ"],["へ"],["行かねば","いかねば"],["ならない"],["。"]]},{"verse":25,"text":"鍬で耕されていた山々にも人は茨とおどろを恐れて足を踏み入れずただ牛を放ち、羊が踏み歩くにまかせる。","tok":[["鍬","くわ"],["で"],["耕されて","たがやされて"],["いた"],["山々","やまやま"],["に"],["も"],["人","ひと"],["は"],["茨","うばら"],["と"],["おどろ"],["を"],["恐れて","おそれて"],["足","あし"],["を"],["踏み入れず","ふみいれず"],["ただ"],["牛","うし"],["を"],["放ち","はなち"],["、"],["羊","ひつじ"],["が"],["踏み","ふみ"],["歩く","あるく"],["に"],["まかせる"],["。"]]}]
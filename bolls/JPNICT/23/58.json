[{"verse":1,"text":"喉をからして叫べ、黙すな声をあげよ、角笛のように。わたしの民に、その背きをヤコブの家に、その罪を告げよ。","tok":[["喉","のど"],["を"],["からして"],["叫べ","さけべ"],["、"],["黙すな","もだすな"],["声","こえ"],["を"],["あげよ"],["、"],["角笛","つのぶえ"],["の"],["よう"],["に"],["。"],["わたし"],["の"],["民","たみ"],["に"],["、"],["その"],["背き","そむき"],["を"],["ヤコブ"],["の"],["家","いえ"],["に"],["、"],["その"],["罪","つみ"],["を"],["告げ","つげ"],["よ"],["。"]]},{"verse":2,"text":"彼らが日々わたしを尋ね求めわたしの道を知ろうと望むように。恵みの業を行い、神の裁きを捨てない民として彼らがわたしの正しい裁きを尋ね神に近くあることを望むように。","tok":[["彼","かれ"],["ら"],["が"],["日々","ひび"],["わたし"],["を"],["尋ね求め","たずねもとめ"],["わたし"],["の"],["道","みち"],["を"],["知ろう","しろう"],["と"],["望む","のぞむ"],["よう"],["に"],["。"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["行い","おこない"],["、"],["神","かみ"],["の"],["裁き","さばき"],["を"],["捨てない","すてない"],["民","たみ"],["として"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["正しい","ただしい"],["裁き","さばき"],["を"],["尋ね","たずね"],["神","かみ"],["に"],["近く","ちかく"],["ある"],["こと"],["を"],["望む","のぞむ"],["よう"],["に"],["。"]]},{"verse":3,"text":"何故あなたはわたしたちの断食を顧みず苦行しても認めてくださらなかったのか。見よ、断食の日にお前たちはしたい事をしお前たちのために労する人々を追い使う。","tok":[["何故","なぜ"],["あなた"],["は"],["わたしたち"],["の"],["断食","だんじき"],["を"],["顧みず","かえりみず"],["苦行","くぎょう"],["して"],["も"],["認めて","みとめて"],["くださらなかった"],["の"],["か"],["。"],["見よ","みよ"],["、"],["断食","だんじき"],["の"],["日","ひ"],["に"],["お前","おまえ"],["たち"],["は"],["したい"],["事","こと"],["を"],["し"],["お前","おまえ"],["たち"],["の"],["ため"],["に"],["労する","ろうする"],["人々","ひとびと"],["を"],["追い使う","おいつかう"],["。"]]},{"verse":4,"text":"見よお前たちは断食しながら争いといさかいを起こし神に逆らって、こぶしを振るう。お前たちが今しているような断食によってはお前たちの声が天で聞かれることはない。","tok":[["見よ","みよ"],["お前","おまえ"],["たち"],["は"],["断食","だんじき"],["し"],["ながら"],["争い","あらそい"],["と"],["いさかい"],["を"],["起こし","おこし"],["神","かみ"],["に"],["逆らって","さからって"],["、"],["こぶし"],["を"],["振るう","ふるう"],["。"],["お前","おまえ"],["たち"],["が"],["今","いま"],["して"],["いる"],["よう"],["な"],["断食","だんじき"],["によって"],["は"],["お前","おまえ"],["たち"],["の"],["声","こえ"],["が"],["天","てん"],["で"],["聞かれる","きかれる"],["こと"],["は"],["ない"],["。"]]},{"verse":5,"text":"そのようなものがわたしの選ぶ断食苦行の日であろうか。葦のように頭を垂れ、粗布を敷き、灰をまくことそれを、お前は断食と呼び主に喜ばれる日と呼ぶのか。","tok":[["その"],["よう"],["な"],["もの"],["が"],["わたし"],["の"],["選ぶ","えらぶ"],["断食","だんじき"],["苦行","くぎょう"],["の"],["日","ひ"],["で"],["あろう"],["か"],["。"],["葦","あし"],["の"],["よう"],["に"],["頭","あたま"],["を"],["垂れ","たれ"],["、"],["粗布","そふ"],["を"],["敷き","しき"],["、"],["灰","はい"],["を"],["まく"],["こと"],["それ"],["を"],["、"],["お前","おまえ"],["は"],["断食","だんじき"],["と"],["呼び","よび"],["主に","おもに"],["喜ばれる","よろこばれる"],["日","ひ"],["と"],["呼ぶ","よぶ"],["の"],["か"],["。"]]},{"verse":6,"text":"わたしの選ぶ断食とはこれではないか。悪による束縛を断ち、軛の結び目をほどいて虐げられた人を解放し、軛をことごとく折ること。","tok":[["わたし"],["の"],["選ぶ","えらぶ"],["断食","だんじき"],["と"],["は"],["これ"],["で"],["は"],["ない"],["か"],["。"],["悪","わる"],["に"],["よる"],["束縛","そくばく"],["を"],["断ち","たち"],["、"],["軛","くびき"],["の"],["結び目","むすびめ"],["を"],["ほどいて"],["虐げられた","しいたげられた"],["人","ひと"],["を"],["解放","かいほう"],["し"],["、"],["軛","くびき"],["を"],["ことごとく"],["折る","おる"],["こと"],["。"]]},{"verse":7,"text":"更に、飢えた人にあなたのパンを裂き与えさまよう貧しい人を家に招き入れ裸の人に会えば衣を着せかけ同胞に助けを惜しまないこと。","tok":[["更に","さらに"],["、"],["飢えた","うえた"],["人","ひと"],["に"],["あなた"],["の"],["パン"],["を"],["裂き与え","さきあたえ"],["さまよう"],["貧しい","まずしい"],["人","ひと"],["を"],["家","いえ"],["に"],["招き入れ","まねきいれ"],["裸","はだか"],["の"],["人","ひと"],["に"],["会えば","あえば"],["衣","ころも"],["を"],["着せ","きせ"],["かけ"],["同胞","どうほう"],["に"],["助け","たすけ"],["を"],["惜しまない","おしまない"],["こと"],["。"]]},{"verse":8,"text":"そうすれば、あなたの光は曙のように射し出であなたの傷は速やかにいやされる。あなたの正義があなたを先導し主の栄光があなたのしんがりを守る。","tok":[["そう"],["すれば"],["、"],["あなた"],["の"],["光","ひかり"],["は"],["曙","あけぼの"],["の"],["よう"],["に"],["射し","さし"],["出","で"],["で"],["あなた"],["の"],["傷","きず"],["は"],["速やか","すみやか"],["に"],["いやされる"],["。"],["あなた"],["の"],["正義","せいぎ"],["が"],["あなた"],["を"],["先導","せんどう"],["し"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["あなた"],["の"],["しんがり"],["を"],["守る","まもる"],["。"]]},{"verse":9,"text":"あなたが呼べば主は答えあなたが叫べば「わたしはここにいる」と言われる。軛を負わすこと、指をさすこと呪いの言葉をはくことをあなたの中から取り去るなら","tok":[["あなた"],["が"],["呼べば","よべば"],["主","ぬし"],["は"],["答え","こたえ"],["あなた"],["が"],["叫べば","さけべば"],["「"],["わたし"],["は"],["ここ"],["に"],["いる"],["」"],["と"],["言われる","いわれる"],["。"],["軛","くびき"],["を"],["負わす","おわす"],["こと"],["、"],["指","ゆび"],["を"],["さす"],["こと"],["呪い","のろい"],["の"],["言葉","ことば"],["を"],["はく"],["こと"],["を"],["あなた"],["の"],["中","なか"],["から"],["取り去るなら","とりさるなら"]]},{"verse":10,"text":"飢えている人に心を配り苦しめられている人の願いを満たすならあなたの光は、闇の中に輝き出であなたを包む闇は、真昼のようになる。","tok":[["飢えて","うえて"],["いる"],["人","ひと"],["に"],["心","こころ"],["を"],["配り","くばり"],["苦しめられて","くるしめられて"],["いる"],["人","ひと"],["の"],["願い","ねがい"],["を"],["満たすなら","みたすなら"],["あなた"],["の"],["光","ひかり"],["は"],["、"],["闇","やみ"],["の"],["中","なか"],["に"],["輝き出で","かがやきいで"],["あなた"],["を"],["包む","つつむ"],["闇","やみ"],["は"],["、"],["真昼","まひる"],["の"],["よう"],["に"],["なる"],["。"]]},{"verse":11,"text":"主は常にあなたを導き焼けつく地であなたの渇きをいやし骨に力を与えてくださる。あなたは潤された園、水の涸れない泉となる。","tok":[["主","ぬし"],["は"],["常","つね"],["に"],["あなた"],["を"],["導き","みちびき"],["焼けつく","やけつく"],["地","ち"],["で"],["あなた"],["の"],["渇き","かわき"],["を"],["いやし"],["骨","ほね"],["に"],["力","ちから"],["を"],["与えて","あたえて"],["くださる"],["。"],["あなた"],["は"],["潤された","うるおされた"],["園","その"],["、"],["水","みず"],["の"],["涸れない","かれない"],["泉","いずみ"],["と"],["なる"],["。"]]},{"verse":12,"text":"人々はあなたの古い廃虚を築き直しあなたは代々の礎を据え直す。人はあなたを「城壁の破れを直す者」と呼び「道を直して、人を再び住まわせる者」と呼ぶ。","tok":[["人々","ひとびと"],["は"],["あなた"],["の"],["古い","ふるい"],["廃虚","はいきょ"],["を"],["築き直し","きずきなおし"],["あなた"],["は"],["代々","だいだい"],["の"],["礎","いしずえ"],["を"],["据え直す","すえなおす"],["。"],["人","ひと"],["は"],["あなた"],["を"],["「"],["城壁","じょうへき"],["の"],["破れ","やぶれ"],["を"],["直す","なおす"],["者","もの"],["」"],["と"],["呼び","よび"],["「"],["道","みち"],["を"],["直して","なおして"],["、"],["人","ひと"],["を"],["再び","ふたたび"],["住まわせる","すまわせる"],["者","もの"],["」"],["と"],["呼ぶ","よぶ"],["。"]]},{"verse":13,"text":"安息日に歩き回ることをやめわたしの聖なる日にしたい事をするのをやめ安息日を喜びの日と呼び主の聖日を尊ぶべき日と呼びこれを尊び、旅をするのをやめしたいことをし続けず、取り引きを慎むなら","tok":[["安息日","あんそくび"],["に"],["歩き回る","あるきまわる"],["こと"],["を"],["やめ"],["わたし"],["の"],["聖","せい"],["なる"],["日","ひ"],["に"],["したい"],["事","こと"],["を"],["する"],["の"],["を"],["やめ"],["安息日","あんそくび"],["を"],["喜び","よろこび"],["の"],["日","ひ"],["と"],["呼び","よび"],["主","ぬし"],["の"],["聖日","せいじつ"],["を"],["尊ぶべき","とうとぶべき"],["日","ひ"],["と"],["呼び","よび"],["これ"],["を"],["尊び","とうとび"],["、"],["旅","たび"],["を"],["する"],["の"],["を"],["やめ"],["したい"],["こと"],["を"],["し"],["続けず","つづけず"],["、"],["取り引き","とりひき"],["を"],["慎むなら","つつしむなら"]]},{"verse":14,"text":"そのとき、あなたは主を喜びとする。わたしはあなたに地の聖なる高台を支配させ父祖ヤコブの嗣業を享受させる。主の口がこう宣言される。","tok":[["その"],["とき"],["、"],["あなた"],["は"],["主","ぬし"],["を"],["喜び","よろこび"],["と"],["する"],["。"],["わたし"],["は"],["あなた"],["に"],["地","ち"],["の"],["聖","せい"],["なる"],["高台","たかだい"],["を"],["支配","しはい"],["させ"],["父祖","ふそ"],["ヤコブ"],["の"],["嗣業","しぎょう"],["を"],["享受","きょうじゅ"],["させる"],["。"],["主","ぬし"],["の"],["口","くち"],["が"],["こう"],["宣言","せんげん"],["される"],["。"]]}]
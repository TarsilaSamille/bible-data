[{"verse":1,"text":"見よ、わたしの僕、わたしが支える者を。わたしが選び、喜び迎える者を。彼の上にわたしの霊は置かれ彼は国々の裁きを導き出す。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["僕","ぼく"],["、"],["わたし"],["が"],["支える","ささえる"],["者","もの"],["を"],["。"],["わたし"],["が"],["選び","えらび"],["、"],["喜び迎える","よろこびむかえる"],["者","もの"],["を"],["。"],["彼","かれ"],["の"],["上","うえ"],["に"],["わたし"],["の"],["霊","れい"],["は"],["置かれ","おかれ"],["彼","かれ"],["は"],["国々","くにぐに"],["の"],["裁き","さばき"],["を"],["導き出す","みちびきだす"],["。"]]},{"verse":2,"text":"彼は叫ばず、呼ばわらず、声を巷に響かせない。","tok":[["彼","かれ"],["は"],["叫ばず","さけばず"],["、"],["呼ばわらず","よばわらず"],["、"],["声","こえ"],["を"],["巷","ちまた"],["に"],["響かせない","ひびかせない"],["。"]]},{"verse":3,"text":"傷ついた葦を折ることなく暗くなってゆく灯心を消すことなく裁きを導き出して、確かなものとする。","tok":[["傷ついた","きずついた"],["葦","あし"],["を"],["折る","おる"],["こと"],["なく"],["暗く","くらく"],["なって"],["ゆく"],["灯心","とうしん"],["を"],["消す","けす"],["こと"],["なく"],["裁き","さばき"],["を"],["導き出して","みちびきだして"],["、"],["確か","たしか"],["な"],["もの"],["と"],["する"],["。"]]},{"verse":4,"text":"暗くなることも、傷つき果てることもないこの地に裁きを置くときまでは。島々は彼の教えを待ち望む。","tok":[["暗く","くらく"],["なる"],["こと"],["も"],["、"],["傷つき","きずつき"],["果てる","はてる"],["こと"],["も"],["ない"],["この"],["地","ち"],["に"],["裁き","さばき"],["を"],["置く","おく"],["とき"],["まで"],["は"],["。"],["島々","しまじま"],["は"],["彼","かれ"],["の"],["教え","おしえ"],["を"],["待ち望む","まちのぞむ"],["。"]]},{"verse":5,"text":"主である神はこう言われる。神は天を創造して、これを広げ地とそこに生ずるものを繰り広げその上に住む人々に息を与えそこを歩く者に霊を与えられる。","tok":[["主","ぬし"],["で"],["ある"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["神","かみ"],["は"],["天","てん"],["を"],["創造","そうぞう"],["して"],["、"],["これ"],["を"],["広げ","ひろげ"],["地","ち"],["と"],["そこ"],["に"],["生ずる","しょうずる"],["もの"],["を"],["繰り広げ","くりひろげ"],["その"],["上","うえ"],["に"],["住む","すむ"],["人々","ひとびと"],["に"],["息","いき"],["を"],["与え","あたえ"],["そこ"],["を"],["歩く","あるく"],["者","もの"],["に"],["霊","れい"],["を"],["与えられる","あたえられる"],["。"]]},{"verse":6,"text":"主であるわたしは、恵みをもってあなたを呼びあなたの手を取った。民の契約、諸国の光としてあなたを形づくり、あなたを立てた。","tok":[["主","ぬし"],["で"],["ある"],["わたし"],["は"],["、"],["恵み","めぐみ"],["を"],["もって"],["あなた"],["を"],["呼び","よび"],["あなた"],["の"],["手","て"],["を"],["取った","とった"],["。"],["民","たみ"],["の"],["契約","けいやく"],["、"],["諸国","しょこく"],["の"],["光","ひかり"],["として"],["あなた"],["を"],["形づくり","かたちづくり"],["、"],["あなた"],["を"],["立てた","たてた"],["。"]]},{"verse":7,"text":"見ることのできない目を開き捕らわれ人をその枷から闇に住む人をその牢獄から救い出すために。","tok":[["見る","みる"],["こと"],["の"],["できない"],["目","め"],["を"],["開き","ひらき"],["捕らわれ","とらわれ"],["人","ひと"],["を"],["その"],["枷","かせ"],["から"],["闇","やみ"],["に"],["住む","すむ"],["人","ひと"],["を"],["その"],["牢獄","ろうごく"],["から"],["救い出す","すくいだす"],["ため"],["に"],["。"]]},{"verse":8,"text":"わたしは主、これがわたしの名。わたしは栄光をほかの神に渡さずわたしの栄誉を偶像に与えることはしない。","tok":[["わたし"],["は"],["主","ぬし"],["、"],["これ"],["が"],["わたし"],["の"],["名","な"],["。"],["わたし"],["は"],["栄光","えいこう"],["を"],["ほか"],["の"],["神","かみ"],["に"],["渡さず","わたさず"],["わたし"],["の"],["栄誉","えいよ"],["を"],["偶像","ぐうぞう"],["に"],["与える","あたえる"],["こと"],["は"],["しない"],["。"]]},{"verse":9,"text":"見よ、初めのことは成就した。新しいことをわたしは告げよう。それが芽生えてくる前にわたしはあなたたちにそれを聞かせよう。","tok":[["見よ","みよ"],["、"],["初め","はじめ"],["の"],["こと"],["は"],["成就","じょうじゅ"],["した"],["。"],["新しい","あたらしい"],["こと"],["を"],["わたし"],["は"],["告げよう","つげよう"],["。"],["それ"],["が"],["芽生えて","めばえて"],["くる"],["前","まえ"],["に"],["わたし"],["は"],["あなた"],["たち"],["に"],["それ"],["を"],["聞かせよう","きかせよう"],["。"]]},{"verse":10,"text":"新しい歌を主に向かって歌え。地の果てから主の栄誉を歌え。海に漕ぎ出す者、海に満ちるもの島々とそこに住む者よ。","tok":[["新しい","あたらしい"],["歌","うた"],["を"],["主に","おもに"],["向かって","むかって"],["歌え","うたえ"],["。"],["地","ち"],["の"],["果て","はて"],["から"],["主","ぬし"],["の"],["栄誉","えいよ"],["を"],["歌え","うたえ"],["。"],["海","うみ"],["に"],["漕ぎ","こぎ"],["出す","だす"],["者","もの"],["、"],["海","うみ"],["に"],["満ちる","みちる"],["もの"],["島々","しまじま"],["と"],["そこ"],["に"],["住む","すむ"],["者","もの"],["よ"],["。"]]},{"verse":11,"text":"荒れ野とその町々よ。ケダル族の宿る村々よ、呼ばわれ。セラに住む者よ、喜び歌え。山々の頂から叫び声をあげよ。","tok":[["荒れ野","あれの"],["と"],["その"],["町々","まちまち"],["よ"],["。"],["ケダル族","けだるぞく"],["の"],["宿る","やどる"],["村々","むらむら"],["よ"],["、"],["呼ばわれ","よばわれ"],["。"],["セラ"],["に"],["住む","すむ"],["者","もの"],["よ"],["、"],["喜び歌え","よろこびうたえ"],["。"],["山々","やまやま"],["の"],["頂","いただき"],["から"],["叫び声","さけびごえ"],["を"],["あげ"],["よ"],["。"]]},{"verse":12,"text":"主に栄光を帰し主の栄誉を島々に告げ知らせよ。","tok":[["主に","おもに"],["栄光","えいこう"],["を"],["帰し","かえし"],["主","ぬし"],["の"],["栄誉","えいよ"],["を"],["島々","しまじま"],["に"],["告げ知らせ","つげしらせ"],["よ"],["。"]]},{"verse":13,"text":"主は、勇士のように出で立ち戦士のように熱情を奮い起こし叫びをあげ、鬨の声をあげ、敵を圧倒される。","tok":[["主","ぬし"],["は"],["、"],["勇士","ゆうし"],["の"],["よう"],["に"],["出で立ち","いでたち"],["戦士","せんし"],["の"],["よう"],["に"],["熱情","ねつじょう"],["を"],["奮い起こし","ふるいおこし"],["叫び","さけび"],["を"],["あげ"],["、"],["鬨の声","ときのこえ"],["を"],["あげ"],["、"],["敵","てき"],["を"],["圧倒","あっとう"],["される"],["。"]]},{"verse":14,"text":"わたしは決して声を立てず黙して、自分を抑えてきた。今、わたしは子を産む女のようにあえぎ激しく息を吸い、また息を吐く。","tok":[["わたし"],["は"],["決して","けっして"],["声","こえ"],["を"],["立てず","たてず"],["黙して","もくして"],["、"],["自分","じぶん"],["を"],["抑えて","おさえて"],["きた"],["。"],["今","いま"],["、"],["わたし"],["は"],["子","こ"],["を"],["産む","うむ"],["女","おんな"],["の"],["よう"],["に"],["あえぎ"],["激しく","はげしく"],["息","いき"],["を"],["吸い","すい"],["、"],["また"],["息","いき"],["を"],["吐く","はく"],["。"]]},{"verse":15,"text":"わたしは山も丘も廃虚とし、草をすべて枯らす。大河を島に変え、湖を干す。","tok":[["わたし"],["は"],["山","やま"],["も"],["丘","おか"],["も"],["廃虚","はいきょ"],["と"],["し"],["、"],["草","くさ"],["を"],["すべて"],["枯らす","からす"],["。"],["大河","たいが"],["を"],["島","しま"],["に"],["変え","かえ"],["、"],["湖","みずうみ"],["を"],["干す","ほす"],["。"]]},{"verse":16,"text":"目の見えない人を導いて知らない道を行かせ通ったことのない道を歩かせる。行く手の闇を光に変え曲がった道をまっすぐにする。わたしはこれらのことを成就させ見捨てることはない。","tok":[["目","め"],["の"],["見えない","みえない"],["人","ひと"],["を"],["導いて","みちびいて"],["知らない","しらない"],["道","みち"],["を"],["行かせ","いかせ"],["通った","かよった"],["こと"],["の"],["ない"],["道","みち"],["を"],["歩かせる","あるかせる"],["。"],["行く手","ゆくて"],["の"],["闇","やみ"],["を"],["光","ひかり"],["に"],["変え","かえ"],["曲がった","まがった"],["道","みち"],["を"],["まっすぐ"],["に"],["する"],["。"],["わたし"],["は"],["これ"],["ら"],["の"],["こと"],["を"],["成就","じょうじゅ"],["させ"],["見捨てる","みすてる"],["こと"],["は"],["ない"],["。"]]},{"verse":17,"text":"偶像に依り頼む者鋳た像に向かってあなたたちがわたしたちの神、と言う者は甚だしく恥を受けて退く。","tok":[["偶像","ぐうぞう"],["に"],["依り頼む","よりたのむ"],["者","もの"],["鋳た","いた"],["像","ぞう"],["に"],["向かって","むかって"],["あなた"],["たち"],["が"],["わたしたち"],["の"],["神","かみ"],["、"],["と"],["言う","いう"],["者","もの"],["は"],["甚だしく","はなはだしく"],["恥","はじ"],["を"],["受けて","うけて"],["退く","しりぞく"],["。"]]},{"verse":18,"text":"耳の聞こえない人よ、聞け。目の見えない人よ、よく見よ。","tok":[["耳","みみ"],["の"],["聞こえない","きこえない"],["人","ひと"],["よ"],["、"],["聞け","きけ"],["。"],["目","め"],["の"],["見えない","みえない"],["人","ひと"],["よ"],["、"],["よく"],["見よ","みよ"],["。"]]},{"verse":19,"text":"わたしの僕ほど目の見えない者があろうか。わたしが遣わす者ほど耳の聞こえない者があろうか。わたしが信任を与えた者ほど目の見えない者主の僕ほど目の見えない者があろうか。","tok":[["わたし"],["の"],["僕","ぼく"],["ほど"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["が"],["あろう"],["か"],["。"],["わたし"],["が"],["遣わす","つかわす"],["者","もの"],["ほど"],["耳","みみ"],["の"],["聞こえない","きこえない"],["者","もの"],["が"],["あろう"],["か"],["。"],["わたし"],["が"],["信任","しんにん"],["を"],["与えた","あたえた"],["者","もの"],["ほど"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["主","ぬし"],["の"],["僕","ぼく"],["ほど"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["が"],["あろう"],["か"],["。"]]},{"verse":20,"text":"多くのことが目に映っても何も見えず耳が開いているのに、何も聞こえない。","tok":[["多く","おおく"],["の"],["こと"],["が"],["目","め"],["に"],["映って","うつって"],["も"],["何","なん"],["も"],["見えず","みえず"],["耳","みみ"],["が"],["開いて","ひらいて"],["いる"],["のに"],["、"],["何","なん"],["も"],["聞こえない","きこえない"],["。"]]},{"verse":21,"text":"主は御自分の正しさゆえに教えを偉大なものとし、輝かすことを喜ばれる。","tok":[["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["正し","ただし"],["さ"],["ゆえ"],["に"],["教え","おしえ"],["を"],["偉大","いだい"],["な"],["もの"],["と"],["し"],["、"],["輝かす","かがやかす"],["こと"],["を"],["喜ばれる","よろこばれる"],["。"]]},{"verse":22,"text":"この民は略奪され、奪われ皆、穴の中に捕らえられ、牢につながれている。略奪に遭っても、助け出す者はなく奪われても、返せと言う者はない。","tok":[["この"],["民","みん"],["は"],["略奪","りゃくだつ"],["され"],["、"],["奪われ","うばわれ"],["皆","みな"],["、"],["穴","あな"],["の"],["中","なか"],["に"],["捕らえられ","とらえられ"],["、"],["牢","ろう"],["に"],["つながれて"],["いる"],["。"],["略奪","りゃくだつ"],["に"],["遭って","あって"],["も"],["、"],["助け出す","たすけだす"],["者","もの"],["は"],["なく"],["奪われて","うばわれて"],["も"],["、"],["返せ","かえせ"],["と"],["言う","いう"],["者","もの"],["は"],["ない"],["。"]]},{"verse":23,"text":"あなたたちの中にこれを聞き取る者があるか。後の日のために注意して聞く者があるか。","tok":[["あなた"],["たち"],["の"],["中","なか"],["に"],["これ"],["を"],["聞き取る","ききとる"],["者","もの"],["が"],["ある"],["か"],["。"],["後","あと"],["の"],["日","ひ"],["の"],["ため"],["に"],["注意","ちゅうい"],["して"],["聞く","きく"],["者","もの"],["が"],["ある"],["か"],["。"]]},{"vers
[{"verse":1,"text":"エッサイの株からひとつの芽が萌えいでその根からひとつの若枝が育ち","tok":[["エッサイ"],["の"],["株","かぶ"],["から"],["ひと"],["つ"],["の"],["芽","め"],["が"],["萌えいで","もえいで"],["その"],["根","ね"],["から"],["ひと"],["つ"],["の"],["若枝","わかえだ"],["が"],["育ち","そだち"]]},{"verse":2,"text":"その上に主の霊がとどまる。知恵と識別の霊思慮と勇気の霊主を知り、畏れ敬う霊。","tok":[["その"],["上","うえ"],["に"],["主","ぬし"],["の"],["霊","れい"],["が"],["とどまる"],["。"],["知恵","ちえ"],["と"],["識別","しきべつ"],["の"],["霊","れい"],["思慮","しりょ"],["と"],["勇気","ゆうき"],["の"],["霊主","れいしゅ"],["を"],["知り","しり"],["、"],["畏れ","おそれ"],["敬う","うやまう"],["霊","れい"],["。"]]},{"verse":3,"text":"彼は主を畏れ敬う霊に満たされる。目に見えるところによって裁きを行わず耳にするところによって弁護することはない。","tok":[["彼","かれ"],["は"],["主","ぬし"],["を"],["畏れ","おそれ"],["敬う","うやまう"],["霊","れい"],["に"],["満たされる","みたされる"],["。"],["目","め"],["に"],["見える","みえる"],["ところ"],["によって"],["裁き","さばき"],["を"],["行わず","おこなわず"],["耳","みみ"],["に"],["する"],["ところ"],["によって"],["弁護","べんご"],["する"],["こと"],["は"],["ない"],["。"]]},{"verse":4,"text":"弱い人のために正当な裁きを行いこの地の貧しい人を公平に弁護する。その口の鞭をもって地を打ち唇の勢いをもって逆らう者を死に至らせる。","tok":[["弱い","よわい"],["人","ひと"],["の"],["ため"],["に"],["正当","せいとう"],["な"],["裁き","さばき"],["を"],["行い","おこない"],["この"],["地","ち"],["の"],["貧しい","まずしい"],["人","ひと"],["を"],["公平","こうへい"],["に"],["弁護","べんご"],["する"],["。"],["その"],["口","くち"],["の"],["鞭","むち"],["を"],["もって"],["地","ち"],["を"],["打ち","うち"],["唇","くちびる"],["の"],["勢い","いきおい"],["を"],["もって"],["逆らう","さからう"],["者","もの"],["を"],["死","し"],["に"],["至らせる","いたらせる"],["。"]]},{"verse":5,"text":"正義をその腰の帯とし真実をその身に帯びる。","tok":[["正義","せいぎ"],["を"],["その"],["腰","こし"],["の"],["帯","おび"],["と"],["し"],["真実","しんじつ"],["を"],["その"],["身","み"],["に"],["帯びる","おびる"],["。"]]},{"verse":6,"text":"狼は小羊と共に宿り豹は子山羊と共に伏す。子牛は若獅子と共に育ち小さい子供がそれらを導く。","tok":[["狼","おおかみ"],["は"],["小羊","こひつじ"],["と"],["共","とも"],["に"],["宿り","やどり"],["豹","ひょう"],["は"],["子山羊","こやぎ"],["と"],["共","とも"],["に"],["伏す","ふす"],["。"],["子牛","こうし"],["は"],["若","わか"],["獅子","しし"],["と"],["共","とも"],["に"],["育ち","そだち"],["小さい","ちいさい"],["子供","こども"],["が"],["それ"],["ら"],["を"],["導く","みちびく"],["。"]]},{"verse":7,"text":"牛も熊も共に草をはみその子らは共に伏し獅子も牛もひとしく干し草を食らう。","tok":[["牛","うし"],["も"],["熊","くま"],["も"],["共","とも"],["に"],["草","くさ"],["を"],["はみ"],["その"],["子","こ"],["ら"],["は"],["共","とも"],["に"],["伏し","ふし"],["獅子","しし"],["も"],["牛","うし"],["も"],["ひとしく"],["干し草","ほしくさ"],["を"],["食らう","くらう"],["。"]]},{"verse":8,"text":"乳飲み子は毒蛇の穴に戯れ幼子は蝮の巣に手を入れる。","tok":[["乳飲み子","ちのみご"],["は"],["毒蛇","どくじゃ"],["の"],["穴","あな"],["に"],["戯れ","たわむれ"],["幼子","おさなご"],["は"],["蝮","まむし"],["の"],["巣","す"],["に"],["手","て"],["を"],["入れる","いれる"],["。"]]},{"verse":9,"text":"わたしの聖なる山においては何ものも害を加えず、滅ぼすこともない。水が海を覆っているように大地は主を知る知識で満たされる。","tok":[["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["に"],["おいて"],["は"],["何もの","なにもの"],["も"],["害","がい"],["を"],["加えず","くわえず"],["、"],["滅ぼす","ほろぼす"],["こと"],["も"],["ない"],["。"],["水","みず"],["が"],["海","うみ"],["を"],["覆って","おおって"],["いる"],["よう"],["に"],["大地","だいち"],["は"],["主","ぬし"],["を"],["知る","しる"],["知識","ちしき"],["で"],["満たされる","みたされる"],["。"]]},{"verse":10,"text":"その日が来ればエッサイの根はすべての民の旗印として立てられ国々はそれを求めて集う。そのとどまるところは栄光に輝く。","tok":[["その"],["日","ひ"],["が"],["来れば","くれば"],["エッサイ"],["の"],["根","ね"],["は"],["すべて"],["の"],["民","たみ"],["の"],["旗印","はたじるし"],["として"],["立てられ","たてられ"],["国々","くにぐに"],["は"],["それ"],["を"],["求めて","もとめて"],["集う","つどう"],["。"],["その"],["とどまる"],["ところ"],["は"],["栄光","えいこう"],["に"],["輝く","かがやく"],["。"]]},{"verse":11,"text":"その日が来れば、主は再び御手を下して御自分の民の残りの者を買い戻される。彼らはアッシリア、エジプト、上エジプト、クシュ、エラム、シンアル、ハマト、海沿いの国々などに残されていた者である。","tok":[["その"],["日","ひ"],["が"],["来れば","くれば"],["、"],["主","ぬし"],["は"],["再び","ふたたび"],["御手","おて"],["を"],["下して","くだして"],["御自分","ごじぶん"],["の"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["買い戻される","かいもどされる"],["。"],["彼","かれ"],["ら"],["は"],["アッシリア"],["、"],["エジプト"],["、"],["上","うえ"],["エジプト"],["、"],["クシュ"],["、"],["エラム"],["、"],["シンアル"],["、"],["ハマト"],["、"],["海沿い","うみぞい"],["の"],["国々","くにぐに"],["など"],["に"],["残されて","のこされて"],["いた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"主は諸国の民に向かって旗印を掲げ地の四方の果てからイスラエルの追放されていた者を引き寄せユダの散らされていた者を集められる。","tok":[["主","ぬし"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["向かって","むかって"],["旗印","はたじるし"],["を"],["掲げ","かかげ"],["地","ち"],["の"],["四方","しほう"],["の"],["果て","はて"],["から"],["イスラエル"],["の"],["追放","ついほう"],["されて"],["いた"],["者","もの"],["を"],["引き寄せ","ひきよせ"],["ユダ"],["の"],["散らされて","ちらされて"],["いた"],["者","もの"],["を"],["集められる","あつめられる"],["。"]]},{"verse":13,"text":"エフライムのねたみは取り去られユダの敵意は断たれる。エフライムはユダをねたまずユダはエフライムに敵対しない。","tok":[["エフライム"],["の"],["ねたみ"],["は"],["取り去られ","とりさられ"],["ユダ"],["の"],["敵意","てきい"],["は"],["断たれる","たたれる"],["。"],["エフライム"],["は"],["ユダ"],["を"],["ねたまず"],["ユダ"],["は"],["エフライム"],["に"],["敵対","てきたい"],["しない"],["。"]]},{"verse":14,"text":"彼らは、西のペリシテを側面から襲い共に、東の民を略奪する。彼らはエドムとモアブを支配しアンモンの人々を服従させる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["西","にし"],["の"],["ペリシテ"],["を"],["側面","そくめん"],["から"],["襲い","おそい"],["共","とも"],["に"],["、"],["東","ひがし"],["の"],["民","たみ"],["を"],["略奪","りゃくだつ"],["する"],["。"],["彼","かれ"],["ら"],["は"],["エドム"],["と"],["モアブ"],["を"],["支配","しはい"],["し"],["アンモン"],["の"],["人々","ひとびと"],["を"],["服従","ふくじゅう"],["させる"],["。"]]},{"verse":15,"text":"主はエジプトの海の入り江を干上がらせ御手を大河の上に振って、強風を起こしそれを打って七つの流れとしサンダルのまま渡れるようにされる。","tok":[["主","ぬし"],["は"],["エジプト"],["の"],["海","うみ"],["の"],["入り江","いりえ"],["を"],["干上がらせ","ひあがらせ"],["御手","おて"],["を"],["大河","たいが"],["の"],["上","うえ"],["に"],["振って","ふって"],["、"],["強風","きょうふう"],["を"],["起こし","おこし"],["それ"],["を"],["打って","うって"],["七","なな"],["つ"],["の"],["流れ","ながれ"],["と"],["し"],["サンダル"],["の"],["まま"],["渡れる","わたれる"],["よう"],["に"],["される"],["。"]]},{"verse":16,"text":"エジプトの地から上った日にイスラエルのために備えられたようにアッシリアに残されていたこの民の残りの者にも、広い道が備えられる。","tok":[["エジプト"],["の"],["地","ち"],["から"],["上った","のぼった"],["日","ひ"],["に"],["イスラエル"],["の"],["ため"],["に"],["備えられた","そなえられた"],["よう"],["に"],["アッシリア"],["に"],["残されて","のこされて"],["いた"],["この"],["民","たみ"],["の"],["残り","のこり"],["の"],["者","もの"],["に"],["も"],["、"],["広い","ひろい"],["道","みち"],["が"],["備えられる","そなえられる"],["。"]]}]
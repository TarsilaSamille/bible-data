[{"verse":1,"text":"慰めよ、わたしの民を慰めよとあなたたちの神は言われる。","tok":[["慰めよ","なぐさめよ"],["、"],["わたし"],["の"],["民","たみ"],["を"],["慰めよ","なぐさめよ"],["と"],["あなた"],["たち"],["の"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":2,"text":"エルサレムの心に語りかけ彼女に呼びかけよ苦役の時は今や満ち、彼女の咎は償われた、と。罪のすべてに倍する報いを主の御手から受けた、と。","tok":[["エルサレム"],["の"],["心","こころ"],["に"],["語りかけ","かたりかけ"],["彼女","かのじょ"],["に"],["呼びかけよ","よびかけよ"],["苦役","くえき"],["の"],["時","とき"],["は"],["今","いま"],["や"],["満ち","みち"],["、"],["彼女","かのじょ"],["の"],["咎","とが"],["は"],["償われた","つぐなわれた"],["、"],["と"],["。"],["罪","つみ"],["の"],["すべて"],["に"],["倍する","ばいする"],["報い","むくい"],["を"],["主","ぬし"],["の"],["御手","おて"],["から"],["受けた","うけた"],["、"],["と"],["。"]]},{"verse":3,"text":"呼びかける声がある。主のために、荒れ野に道を備えわたしたちの神のために、荒れ地に広い道を通せ。","tok":[["呼びかける","よびかける"],["声","こえ"],["が"],["ある"],["。"],["主","ぬし"],["の"],["ため"],["に"],["、"],["荒れ野","あれの"],["に"],["道","みち"],["を"],["備え","そなえ"],["わたしたち"],["の"],["神","かみ"],["の"],["ため"],["に"],["、"],["荒れ地","あれち"],["に"],["広い","ひろい"],["道","みち"],["を"],["通せ","とおせ"],["。"]]},{"verse":4,"text":"谷はすべて身を起こし、山と丘は身を低くせよ。険しい道は平らに、狭い道は広い谷となれ。","tok":[["谷","たに"],["は"],["すべて"],["身","み"],["を"],["起こし","おこし"],["、"],["山","やま"],["と"],["丘","おか"],["は"],["身","み"],["を"],["低く","ひくく"],["せよ"],["。"],["険しい","けわしい"],["道","みち"],["は"],["平ら","たいら"],["に"],["、"],["狭い","せまい"],["道","みち"],["は"],["広い","ひろい"],["谷","たに"],["と"],["なれ"],["。"]]},{"verse":5,"text":"主の栄光がこうして現れるのを肉なる者は共に見る。主の口がこう宣言される。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["が"],["こう"],["して"],["現れる","あらわれる"],["の"],["を"],["肉","にく"],["なる"],["者","もの"],["は"],["共","とも"],["に"],["見る","みる"],["。"],["主","ぬし"],["の"],["口","くち"],["が"],["こう"],["宣言","せんげん"],["される"],["。"]]},{"verse":6,"text":"呼びかけよ、と声は言う。わたしは言う、何と呼びかけたらよいのか、と。肉なる者は皆、草に等しい。永らえても、すべては野の花のようなもの。","tok":[["呼びかけ","よびかけ"],["よ"],["、"],["と"],["声","こえ"],["は"],["言う","ゆう"],["。"],["わたし"],["は"],["言う","いう"],["、"],["何","なん"],["と"],["呼びかけたら","よびかけたら"],["よい"],["の"],["か"],["、"],["と"],["。"],["肉","にく"],["なる"],["者","もの"],["は"],["皆","みな"],["、"],["草","くさ"],["に"],["等しい","ひとしい"],["。"],["永らえて","ながらえて"],["も"],["、"],[
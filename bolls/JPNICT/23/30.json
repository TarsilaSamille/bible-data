[{"verse":1,"text":"災いだ、背く子らは、と主は言われる。彼らは謀を立てるがわたしによるのではない。盟約の杯を交わすがわたしの霊によるのではない。こうして、罪に罪を重ねている。","tok":[["災い","わざわい"],["だ"],["、"],["背く","そむく"],["子","こ"],["ら"],["は"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["彼","かれ"],["ら"],["は"],["謀","はかりごと"],["を"],["立てる","たてる"],["が"],["わたし"],["に"],["よる"],["ので"],["は"],["ない"],["。"],["盟約","めいやく"],["の"],["杯","さかずき"],["を"],["交わす","かわす"],["が"],["わたし"],["の"],["霊","れい"],["に"],["よる"],["ので"],["は"],["ない"],["。"],["こう"],["して"],["、"],["罪","つみ"],["に"],["罪","つみ"],["を"],["重ねて","かさねて"],["いる"],["。"]]},{"verse":2,"text":"彼らはわたしの託宣を求めずエジプトへ下って行きファラオの砦に難を避けエジプトの陰に身を寄せる。","tok":[["彼","かれ"],["ら"],["は"],["わたし"],["の"],["託宣","たくせん"],["を"],["求めず","もとめず"],["エジプト"],["へ"],["下って","くだって"],["行き","いき"],["ファラオ"],["の"],["砦","とりで"],["に"],["難","なん"],["を"],["避け","さけ"],["エジプト"],["の"],["陰","かげ"],["に"],["身","み"],["を"],["寄せる","よせる"],["。"]]},{"verse":3,"text":"しかし、ファラオの砦はお前たちの恥となりエジプトの陰に身を寄せることは辱めとなる。","tok":[["しかし"],["、"],["ファラオ"],["の"],["砦","とりで"],["は"],["お前","おまえ"],["たち"],["の"],["恥","はじ"],["と"],["なり"],["エジプト"],["の"],["陰","かげ"],["に"],["身","み"],["を"],["寄せる","よせる"],["こと"],["は"],["辱め","はずかしめ"],["と"],["なる"],["。"]]},{"verse":4,"text":"たとえ高官らがツォアンにおり使者らがハネスに遣わされても","tok":[["たとえ"],["高官","こうかん"],["ら"],["が"],["ツォアン"],["に"],["おり"],["使者","ししゃ"],["ら"],["が"],["ハネス"],["に"],["遣わされて","つかわされて"],["も"]]},{"verse":5,"text":"彼らはすべて益を与えぬ国のゆえにうろたえるだけだ。その国は助けにならず、益を与えず恥と嘲りの種になるだけだ。","tok":[["彼","かれ"],["ら"],["は"],["すべて"],["益","えき"],["を"],["与えぬ","あたえぬ"],["国","くに"],["の"],["ゆえ"],["に"],["うろたえる"],["だけ"],["だ"],["。"],["その"],["国","くに"],["は"],["助け","たすけ"],["に"],["ならず"],["、"],["益","えき"],["を"],["与えず","あたえず"],["恥","はじ"],["と"],["嘲り","あざけり"],["の"],["種","しゅ"],["に"],["なる"],["だけ"],["だ"],["。"]]},{"verse":6,"text":"ネゲブの獣についての託宣。彼らはその富をろばの背に宝をらくだのこぶに載せてほえたける雌獅子や雄獅子蝮や、飛び回る炎の蛇が住む悩みと苦しみの道を経て益を与えることのない国に赴く。","tok":[["ネゲブ"],["の"],["獣","けもの"],["について"],["の"],["託宣","たくせん"],["。"],["彼","かれ"],["ら"],["は"],["その"],["富","とみ"],["を"],["ろば"],["の"],["背","せ"],["に"],["宝","たから"],["を"],["らくだ"],["の"],["こぶ"],["に"],["載せて","のせて"],["ほえ"],["たける"],["雌","めす"],["獅子","しし"],["や"],["雄","おす"],["獅子","しし"],["蝮","まむし"],["や"],["、"],["飛び回る","とびまわる"],["炎","ほのお"],["の"],["蛇","へび"],["が"],["住む","すむ"],["悩み","なやみ"],["と"],["苦しみ","くるしみ"],["の"],["道","みち"],["を"],["経て","へて"],["益","えき"],["を"],["与える","あたえる"],["こと"],["の"],["ない"],["国","くに"],["に"],["赴く","おもむく"],["。"]]},{"verse":7,"text":"エジプトの助けは空しくはかない。それゆえ、わたしはこれを「つながれたラハブ」と呼ぶ。","tok":[["エジプト"],["の"],["助け","たすけ"],["は"],["空しく","むなしく"],["はかない"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["これ"],["を"],["「"],["つながれた"],["ラハブ"],["」"],["と"],["呼ぶ","よぶ"],["。"]]},{"verse":8,"text":"今、行って、このことを彼らの前で板に書き、書に記せ。それを後の日のため、永遠の証しとせよ。","tok":[["今","いま"],["、"],["行って","いって"],["、"],["この"],["こと"],["を"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["板","いた"],["に"],["書き","かき"],["、"],["書","しょ"],["に"],["記せ","しるせ"],["。"],["それ"],["を"],["後","あと"],["の"],["日","ひ"],["の"],["ため"],["、"],["永遠","えいえん"],["の"],["証し","あかし"],["と"],["せよ"],["。"]]},{"verse":9,"text":"まことに、彼らは反逆の民であり偽りの子ら、主の教えを聞こうとしない子らだ。","tok":[["まこと"],["に"],["、"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["民","たみ"],["で"],["あり"],["偽り","いつわり"],["の"],["子","こ"],["ら"],["、"],["主","ぬし"],["の"],["教え","おしえ"],["を"],["聞こう","きこう"],["と"],["しない"],["子","こ"],["ら"],["だ"],["。"]]},{"verse":10,"text":"彼らは先見者に向かって、「見るな」と言い預言者に向かって「真実を我々に預言するな。滑らかな言葉を語り、惑わすことを預言せよ。","tok":[["彼","かれ"],["ら"],["は"],["先見者","せんけんしゃ"],["に"],["向かって","むかって"],["、"],["「"],["見る","みる"],["な"],["」"],["と"],["言い","いい"],["預言者","よげんしゃ"],["に"],["向かって","むかって"],["「"],["真実","しんじつ"],["を"],["我々","われわれ"],["に"],["預言","よげん"],["する"],["な"],["。"],["滑らか","なめらか"],["な"],["言葉","ことば"],["を"],["語り","かたり"],["、"],["惑わす","まどわす"],["こと"],["を"],["預言","よげん"],["せよ"],["。"]]},{"verse":11,"text":"道から離れ、行くべき道をそれ我々の前でイスラエルの聖なる方について語ることをやめよ」と言う。","tok":[["道","みち"],["から"],["離れ","はなれ"],["、"],["行くべき","いくべき"],["道","みち"],["を"],["それ"],["我々","われわれ"],["の"],["前","まえ"],["で"],["イスラエル"],["の"],["聖","せい"],["なる"],["方","かた"],["について"],["語る","かたる"],["こと"],["を"],["やめよ"],["」"],["と"],["言う","ゆう"],["。"]]},{"verse":12,"text":"それゆえイスラエルの聖なる方はこう言われる。「お前たちは、この言葉を拒み抑圧と不
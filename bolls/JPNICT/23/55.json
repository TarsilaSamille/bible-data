[{"verse":1,"text":"渇きを覚えている者は皆、水のところに来るがよい。銀を持たない者も来るがよい。穀物を求めて、食べよ。来て、銀を払うことなく穀物を求め価を払うことなく、ぶどう酒と乳を得よ。","tok":[["渇き","かわき"],["を"],["覚えて","おぼえて"],["いる"],["者","もの"],["は"],["皆","みな"],["、"],["水","みず"],["の"],["ところ"],["に"],["来る","くる"],["が"],["よい"],["。"],["銀","ぎん"],["を"],["持たない","もたない"],["者","もの"],["も"],["来る","くる"],["が"],["よい"],["。"],["穀物","こくもつ"],["を"],["求めて","もとめて"],["、"],["食べ","たべ"],["よ"],["。"],["来て","きて"],["、"],["銀","ぎん"],["を"],["払う","はらう"],["こと"],["なく"],["穀物","こくもつ"],["を"],["求め","もとめ"],["価","あたい"],["を"],["払う","はらう"],["こと"],["なく"],["、"],["ぶどう酒","ぶどうしゅ"],["と"],["乳","ちち"],["を"],["得","え"],["よ"],["。"]]},{"verse":2,"text":"なぜ、糧にならぬもののために銀を量って払い飢えを満たさぬもののために労するのか。わたしに聞き従えば良いものを食べることができる。あなたたちの魂はその豊かさを楽しむであろう。","tok":[["なぜ"],["、"],["糧","かて"],["に"],["ならぬ"],["もの"],["の"],["ため"],["に"],["銀","ぎん"],["を"],["量って","はかって"],["払い","はらい"],["飢え","うえ"],["を"],["満たさぬ","みたさぬ"],["もの"],["の"],["ため"],["に"],["労する","ろうする"],["の"],["か"],["。"],["わたし"],["に"],["聞き従えば","ききしたがえば"],["良い","よい"],["もの"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["あなた"],["たち"],["の"],["魂","たましい"],["は"],["その"],["豊か","ゆたか"],["さ"],["を"],["楽しむで","たのしむで"],["あろう"],["。"]]},{"verse":3,"text":"耳を傾けて聞き、わたしのもとに来るがよい。聞き従って、魂に命を得よ。わたしはあなたたちととこしえの契約を結ぶ。ダビデに約束した真実の慈しみのゆえに。","tok":[["耳","みみ"],["を"],["傾けて","かたむけて"],["聞き","きき"],["、"],["わたし"],["の"],["もと"],["に"],["来る","くる"],["が"],["よい"],["。"],["聞き従って","ききしたがって"],["、"],["魂","たましい"],["に"],["命","いのち"],["を"],["得","え"],["よ"],["。"],["わたし"],["は"],["あなた"],["たち"],["と"],["とこしえ"],["の"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"],["ダビデ"],["に"],["約束","やくそく"],["した"],["真実","しんじつ"],["の"],["慈しみ","いつくしみ"],["の"],["ゆえ"],["に"],["。"]]},{"verse":4,"text":"見よかつてわたしは彼を立てて諸国民への証人とし諸国民の指導者、統治者とした。","tok":[["見よ","みよ"],["かつて"],["わたし"],["は"],["彼","かれ"],["を"],["立てて","たてて"],["諸","しょ"],["国民","こくみん"],["へ"],["の"],["証人","しょうにん"],["と"],["し"],["諸","しょ"],["国民","こくみん"],["の"],["指導者","しどうしゃ"],["、"],["統治者","とうちしゃ"],["と"],["した"],["。"]]},{"verse":5,"text":"今、あなたは知らなかった国に呼びかける。あなたを知らなかった国はあなたのもとに馳せ参じるであろう。あなたの神である主あなたに輝きを与えられるイスラエルの聖なる神のゆえに。","tok":[["今","いま"],["、"],["あなた"],["は"],["知らなかった","しらなかった"],["国","くに"],["に"],["呼びかける","よびかける"],["。"],["あなた"],["を"],["知らなかった","しらなかった"],["国","くに"],["は"],["あなた"],["の"],["もと"],["に"],["馳せ参じるで","はせさんじるで"],["あろう"],["。"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["あなた"],["に"],["輝き","かがやき"],["を"],["与えられる","あたえられる"],["イスラエル"],["の"],["聖","せい"],["なる"],["神","かみ"],["の"],["ゆえ"],["に"],["。"]]},{"verse":6,"text":"主を尋ね求めよ、見いだしうるときに。呼び求めよ、近くにいますうちに。","tok":[["主","ぬし"],["を"],["尋ね求めよ","たずねもとめよ"],["、"],["見いだし","みいだし"],["うる"],["とき"],["に"],["。"],["呼び求めよ","よびもとめよ"],["、"],["近く","ちかく"],["に"],["います"],["うち"],["に"],["。"]]},{"verse":7,"text":"神に逆らう者はその道を離れ悪を行う者はそのたくらみを捨てよ。主に立ち帰るならば、主は憐れんでくださる。わたしたちの神に立ち帰るならば豊かに赦してくださる。","tok":[["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["は"],["その"],["道","みち"],["を"],["離れ","はなれ"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["は"],["その"],["たくらみ"],["を"],["捨てよ","すてよ"],["。"],["主に","おもに"],["立ち帰るならば","たちかえるならば"],["、"],["主","ぬし"],["は"],["憐れんで","あわれんで"],["くださる"],["。"],["わたしたち"],["の"],["神","かみ"],["に"],["立ち帰るならば","たちかえるならば"],["豊か","ゆたか"],["に"],["赦して","ゆるして"],["くださる"],["。"]]},{"verse":8,"text":"わたしの思いは、あなたたちの思いと異なりわたしの道はあなたたちの道と異なると主は言われる。","tok":[["わたし"],["の"],["思い","おもい"],["は"],["、"],["あなた"],["たち"],["の"],["思い","おもい"],["と"],["異なり","ことなり"],["わたし"],["の"],["道","みち"],["は"],["あなた"],["たち"],["の"],["道","みち"],["と"],["異なる","ことなる"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"天が地を高く超えているようにわたしの道は、あなたたちの道をわたしの思いはあなたたちの思いを、高く超えている。","tok":[["天","てん"],["が"],["地","ち"],["を"],["高く","たかく"],["超えて","こえて"],["いる"],["よう"],["に"],["わたし"],["の"],["道","みち"],["は"],["、"],["あなた"],["たち"],["の"],["道","みち"],["を"],["わたし"],["の"],["思い","おもい"],["は"],["あなた"],["たち"],["の"],["思い","おもい"],["を"],["、"],["高く","たかく"],["超えて","こえて"],["いる"],["。"]]},{"verse":10,"text":"雨も雪も、ひとたび天から降ればむなしく天に戻ることはない。それは大地を潤し、芽を出させ、生い茂らせ種蒔く人には種を与え食べる人には糧を与える。","tok":[["雨","あめ"],["も"],["雪","ゆき"],["も"],["、"],["ひとたび"],["天","てん"],["から"],["降れば","ふれば"],["むなしく"],["天","てん"],["に"],["戻る","もどる"],["こと"],["は"],["ない"],["。"],["それ"],["は"],["大地","だいち"],["を"],["潤し","うるおし"],["、"],["芽","め"],["を"],["出させ","ださせ"],["、"],["生い茂らせ","おいしげらせ"],["種蒔","たねまき"],["く人","くにん"],["に"],["は"],["種","しゅ"],["を"],["与え","あたえ"],["食べる","たべる"],["人","ひと"],["に"],["は"],["糧","かて"],["を"],["与える","あたえる"],["。"]]},{"verse":11,"text":"そのように、わたしの口から出るわたしの言葉もむなしくは、わたしのもとに戻らない。それはわたしの望むことを成し遂げわたしが与えた使命を必ず果たす。","tok":[["その"],["よう"],["に"],["、"],["わたし"],["の"],["口","くち"],["から"],["出る","でる"],["わたし"],["の"],["言葉","ことば"],["も"],["むなしく"],["は"],["、"],["わたし"],["の"],["もと"],["に"],["戻らない","もどらない"],["。"],["それ"],["は"],["わたし"],["の"],["望む","のぞむ"],["こと"],["を"],["成し遂げ","なしとげ"],["わたし"],["が"],["与えた","あたえた"],["使命","しめい"],["を"],["必ず","かならず"],["果たす","はたす"],["。"]]},{"verse":12,"text":"あなたたちは喜び祝いながら出で立ち平和のうちに導かれて行く。山と丘はあなたたちを迎え歓声をあげて喜び歌い野の木々も、手をたたく。","tok":[["あなた"],["たち"],["は"],["喜び祝い","よろこびいわい"],["ながら"],["出で立ち","いでたち"],["平和","へいわ"],["の"],["うち"],["に"],["導かれて","みちびかれて"],["行く","いく"],["。"],["山","やま"],["と"],["丘","おか"],["は"],["あなた"],["たち"],["を"],["迎え","むかえ"],["歓声","かんせい"],["を"],["あげて"],["喜び歌い","よろこびうたい"],["野","や"],["の"],["木々","きぎ"],["も"],["、"],["手","て"],["を"],["たたく"],["。"]]},{"verse":13,"text":"茨に代わって糸杉がおどろに代わってミルトスが生える。これは、主に対する記念となり、しるしとなる。それはとこしえに消し去られることがない。","tok":[["茨","うばら"],["に"],["代わって","かわって"],["糸杉","いとすぎ"],["が"],["おどろ"],["に"],["代わって","かわって"],["ミルトス"],["が"],["生える","はえる"],["。"],["これ"],["は"],["、"],["主","ぬし"],["に"],["対する","たいする"],["記念","きねん"],["と"],["なり"],["、"],["しるし"],["と"],["なる"],["。"],["それ"],["は"],["とこしえ"],["に"],["消し去られる","けしさられる"],["こと"],["が"],["ない"],["。"]]}]
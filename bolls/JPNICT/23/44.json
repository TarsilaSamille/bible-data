[{"verse":1,"text":"そして今、わたしの僕ヤコブよわたしの選んだイスラエルよ、聞け。","tok":[["そして"],["今","いま"],["、"],["わたし"],["の"],["僕","ぼく"],["ヤコブ"],["よ"],["わたし"],["の"],["選んだ","えらんだ"],["イスラエル"],["よ"],["、"],["聞け","きけ"],["。"]]},{"verse":2,"text":"あなたを造り、母の胎内に形づくりあなたを助ける主は、こう言われる。恐れるな、わたしの僕ヤコブよ。わたしの選んだエシュルンよ。","tok":[["あなた"],["を"],["造り","つくり"],["、"],["母","はは"],["の"],["胎内","たいない"],["に"],["形づくり","かたちづくり"],["あなた"],["を"],["助ける","たすける"],["主","ぬし"],["は"],["、"],["こう"],["言われる","いわれる"],["。"],["恐れる","おそれる"],["な"],["、"],["わたし"],["の"],["僕","ぼく"],["ヤコブ"],["よ"],["。"],["わたし"],["の"],["選んだ","えらんだ"],["エシュルン"],["よ"],["。"]]},{"verse":3,"text":"わたしは乾いている地に水を注ぎ乾いた土地に流れを与える。あなたの子孫にわたしの霊を注ぎあなたの末にわたしの祝福を与える。","tok":[["わたし"],["は"],["乾いて","かわいて"],["いる"],["地","ち"],["に"],["水","みず"],["を"],["注ぎ","そそぎ"],["乾いた","かわいた"],["土地","とち"],["に"],["流れ","ながれ"],["を"],["与える","あたえる"],["。"],["あなた"],["の"],["子孫","しそん"],["に"],["わたし"],["の"],["霊","れい"],["を"],["注ぎ","そそぎ"],["あなた"],["の"],["末","すえ"],["に"],["わたし"],["の"],["祝福","しゅくふく"],["を"],["与える","あたえる"],["。"]]},{"verse":4,"text":"彼らは草の生い茂る中に芽生え水のほとりの柳のように育つ。","tok":[["彼","かれ"],["ら"],["は"],["草","くさ"],["の"],["生い茂る","おいしげる"],["中","なか"],["に"],["芽生え","めばえ"],["水","みず"],["の"],["ほとり"],["の"],["柳","やなぎ"],["の"],["よう"],["に"],["育つ","そだつ"],["。"]]},{"verse":5,"text":"ある者は「わたしは主のもの」と言いある者はヤコブの名を名乗りまたある者は手に「主のもの」と記し「イスラエル」をその名とする。","tok":[["ある"],["者","もの"],["は"],["「"],["わたし"],["は"],["主","ぬし"],["の"],["もの"],["」"],["と"],["言い","いい"],["ある"],["者","もの"],["は"],["ヤコブ"],["の"],["名","な"],["を"],["名乗り","なのり"],["また"],["ある"],["者","もの"],["は"],["手","て"],["に"],["「"],["主","ぬし"],["の"],["もの"],["」"],["と"],["記し","しるし"],["「"],["イスラエル"],["」"],["を"],["その"],["名","な"],["と"],["する"],["。"]]},{"verse":6,"text":"イスラエルの王である主イスラエルを贖う万軍の主は、こう言われる。わたしは初めであり、終わりである。わたしをおいて神はない。","tok":[["イスラエル"],["の"],["王","おう"],["で"],["ある"],["主","ぬし"],["イスラエル"],["を"],["贖う","あがなう"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["、"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["初め","はじめ"],["で"],["あり"],["、"],["終わり","おわり"],["で"],["ある"],["。"],["わたし"],["を"],["おいて"],["神","かみ"],["は"],["ない"],["。"]]},{"verse":7,"text":"だれか、わたしに並ぶ者がいるなら声をあげ、発言し、わたしと競ってみよ。わたしがとこしえの民としるしを定めた日から来るべきことにいたるまでを告げてみよ。","tok":[["だれ"],["か"],["、"],["わたし"],["に"],["並ぶ","ならぶ"],["者","もの"],["が"],["いるなら"],["声","こえ"],["を"],["あげ"],["、"],["発言","はつげん"],["し"],["、"],["わたし"],["と"],["競って","きそって"],["み"],["よ"],["。"],["わたし"],["が"],["とこしえ"],["の"],["民","たみ"],["と"],["しるし"],["を"],["定めた","さだめた"],["日","ひ"],["から"],["来るべき","きたるべき"],["こと"],["に"],["いたる"],["まで"],["を"],["告げて","つげて"],["み"],["よ"],["。"]]},{"verse":8,"text":"恐れるな、おびえるな。既にわたしはあなたに聞かせ告げてきたではないか。あなたたちはわたしの証人ではないか。わたしをおいて神があろうか、岩があろうか。わたしはそれを知らない。","tok":[["恐れる","おそれる"],["な"],["、"],["おびえる"],["な"],["。"],["既に","すでに"],["わたし"],["は"],["あなた"],["に"],["聞かせ","きかせ"],["告げて","つげて"],["きたで"],["は"],["ない"],["か"],["。"],["あなた"],["たち"],["は"],["わたし"],["の"],["証人","しょうにん"],["で"],["は"],["ない"],["か"],["。"],["わたし"],["を"],["おいて"],["神","かみ"],["が"],["あろう"],["か"],["、"],["岩","いわ"],["が"],["あろう"],["か"],["。"],["わたし"],["は"],["それ"],["を"],["知らない","しらない"],["。"]]},{"verse":9,"text":"偶像を形づくる者は皆、無力で彼らが慕うものも役に立たない。彼ら自身が証人だ。見ることも、知ることもなく、恥を受ける。","tok":[["偶像","ぐうぞう"],["を"],["形づくる","かたちづくる"],["者","もの"],["は"],["皆","みな"],["、"],["無力","むりょく"],["で"],["彼","かれ"],["ら"],["が"],["慕う","したう"],["もの"],["も"],["役","やく"],["に"],["立たない","たたない"],["。"],["彼","かれ"],["ら"],["自身","じしん"],["が"],["証人","しょうにん"],["だ"],["。"],["見る","みる"],["こと"],["も"],["、"],["知る","しる"],["こと"],["も"],["なく"],["、"],["恥","はじ"],["を"],["受ける","うける"],["。"]]},{"verse":10,"text":"無力な神を造り役に立たない偶像を鋳る者はすべて","tok":[["無力","むりょく"],["な"],["神","かみ"],["を"],["造り","つくり"],["役","やく"],["に"],["立たない","たたない"],["偶像","ぐうぞう"],["を"],["鋳る","いる"],["者","もの"],["は"],["すべて"]]},{"verse":11,"text":"その仲間と共に恥を受ける。職人も皆、人間にすぎず皆集まって立ち、恐れ、恥を受ける。","tok":[["その"],["仲間","なかま"],["と"],["共","とも"],["に"],["恥","はじ"],["を"],["受ける","うける"],["。"],["職人","しょくにん"],["も"],["皆","みな"],["、"],["人間","にんげん"],["に"],["すぎず"],["皆","みな"],["集まって","あつまって"],["立ち","たち"],["、"],["恐れ","おそれ"],["、"],["恥","はじ"],["を"],["受ける","うける"],["。"]]},{"verse":12,"text":"鉄工は金槌と炭火を使って仕事をする。槌でたたいて形を造り、強い腕を振るって働くが飢えれば力も減り、水を飲まなければ疲れる。","tok":[["鉄工","てっこう"],["は"],["金槌","かなづち"],["と"],["炭火","すみび"],["を"],["使って","つかって"],["仕事","しごと"],["を"],["する"],["。"],["槌","つち"],["で"],["たたいて"],["形","かたち"],["を"],["造り","つくり"],["、"],["強い","つよい"],["腕","うで"],["を"],["振るって","ふるって"],["働く","はたらく"],["が"],["飢えれば","うえれば"],["力","ちから"],["も"],["減り","へり"],["、"],["水","みず"],["を"],["飲まなければ","のまなければ"],["疲れる","つかれる"],["。"]]},{"verse":13,"text":"木工は寸法を計り、石筆で図を描きのみで削り、コンパスで図を描き人の形に似せ、人間の美しさに似せて作り神殿に置く。","tok":[["木工","もっこう"],["は"],["寸法","すんぽう"],["を"],["計り","はかり"],["、"],["石筆","せきひつ"],["で"],["図","ず"],["を"],["描き","えがき"],["のみ"],["で"],["削り","けずり"],["、"],["コンパス"],["で"],["図","ず"],["を"],["描き","えがき"],["人","ひと"],["の"],["形","かたち"],["に"],["似せ","にせ"],["、"],["人間","にんげん"],["の"],["美し","うつくし"],["さ"],["に"],["似せて","にせて"],["作り","つくり"],["神殿","しんでん"],["に"],["置く","おく"],["。"]]},{"verse":14,"text":"彼は林の中で力を尽くし樅を切り、柏や樫の木を選びまた、樅の木を植え、雨が育てるのを待つ。","tok":[["彼","かれ"],["は"],["林","はやし"],["の"],["中","なか"],["で"],["力","ちから"],["を"],["尽くし","つくし"],["樅","もみ"],["を"],["切り","きり"],["、"],["柏","かしわ"],["や"],["樫","かし"],["の"],["木","き"],["を"],["選び","えらび"],["また"],["、"],["樅","もみ"],["の"],["木","き"],["を"],["植え","うえ"],["、"],["雨","あめ"],["が"],["育てる","そだてる"],["の"],["を"],["待つ","まつ"],["。"]]},{"verse":15,"text":"木は薪になるもの。人はその一部を取って体を温め一部を燃やしてパンを焼きその木で神を造ってそれにひれ伏し木像に仕立ててそれを拝むのか。","tok":[["木","き"],["は"],["薪","たきぎ"],["に"],["なる"],["もの"],["。"],["人","ひと"],["は"],["その"],["一部","いちぶ"],["を"],["取って","とって"],["体","からだ"],["を"],["温め","あたため"],["一部","いちぶ"],["を"],["燃やして","もやして"],["パン"],["を"],["焼き","やき"],["その"],["木","き"],["で"],["神","かみ"],["を"],["造って","つくって"],["それ"],["に"],["ひれ伏し","ひれふし"],["木像","もくぞう"],["に"],["仕立てて","したてて"],["それ"],["を"],["拝む","おがむ"],["の"],["か"],["。"]]},{"verse":16,"text":"また、木材の半分を燃やして火にし肉を食べようとしてその半分の上であぶり食べ飽きて身が温まると「ああ、温かい、炎が見える」などと言う。","tok":[["また"],["、"],["木材","もくざい"],["の"],["半分","はんぶん"],["を"],["燃やして","もやして"],["火","ひ"],["に"],["し"],["肉","にく"],["を"],["食べよう","たべよう"],["として"],["その"],["半分","はんぶん"],["の"],["上","うえ"],["で"],["あぶり"],["食べ飽きて","たべあきて"],["身","み"],["が"],["温まる","あたたまる"],["と"],["「"],["ああ"],["、"],["温かい","あたたか
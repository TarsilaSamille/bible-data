[{"verse":1,"text":"その日、主は厳しく、大きく、強い剣をもって逃げる蛇レビヤタン曲がりくねる蛇レビヤタンを罰しまた海にいる竜を殺される。","tok":[["その"],["日","ひ"],["、"],["主","ぬし"],["は"],["厳しく","きびしく"],["、"],["大きく","おおきく"],["、"],["強い","つよい"],["剣","けん"],["を"],["もって"],["逃げる","にげる"],["蛇","へび"],["レビヤタン"],["曲がりくねる","まがりくねる"],["蛇","へび"],["レビヤタン"],["を"],["罰し","ばっし"],["また"],["海","うみ"],["に"],["いる"],["竜","りゅう"],["を"],["殺される","ころされる"],["。"]]},{"verse":2,"text":"その日には、見事なぶどう畑について喜び歌え。","tok":[["その"],["日","ひ"],["に"],["は"],["、"],["見事","みごと"],["な"],["ぶどう"],["畑","はたけ"],["について"],["喜び歌え","よろこびうたえ"],["。"]]},{"verse":3,"text":"主であるわたしはその番人。常に水を注ぎ害する者のないよう、夜も昼もそれを見守る。","tok":[["主","ぬし"],["で"],["ある"],["わたし"],["は"],["その"],["番人","ばんにん"],["。"],["常","つね"],["に"],["水","みず"],["を"],["注ぎ","そそぎ"],["害する","がいする"],["者","もの"],["の"],["ない"],["よう"],["、"],["夜","よる"],["も"],["昼","ひる"],["も"],["それ"],["を"],["見守る","みまもる"],["。"]]},{"verse":4,"text":"わたしは、もはや憤っていない。茨とおどろをもって戦いを挑む者があればわたしは進み出て、彼らを焼き尽くす。","tok":[["わたし"],["は"],["、"],["もはや"],["憤って","いきどおって"],["いない"],["。"],["茨","うばら"],["と"],["おどろ"],["を"],["もって"],["戦い","たたかい"],["を"],["挑む","いどむ"],["者","もの"],["が"],["あれば"],["わたし"],["は"],["進み出て","すすみでて"],["、"],["彼","かれ"],["ら"],["を"],["焼き","やき"],["尽くす","つくす"],["。"]]},{"verse":5,"text":"そうではなく、わたしを砦と頼む者はわたしと和解するがよい。和解をわたしとするがよい。","tok":[["そう"],["で"],["は"],["なく"],["、"],["わたし"],["を"],["砦","とりで"],["と"],["頼む","たのむ"],["者","もの"],["は"],["わたし"],["と"],["和解","わかい"],["する"],["が"],["よい"],["。"],["和解","わかい"],["を"],["わたし"],["と"],["する"],["が"],["よい"],["。"]]},{"verse":6,"text":"時が来れば、ヤコブは根を下ろしイスラエルは芽を出し、花を咲かせ地上をその実りで満たす。","tok":[["時","とき"],["が"],["来れば","くれば"],["、"],["ヤコブ"],["は"],["根","ね"],["を"],["下ろし","おろし"],["イスラエル"],["は"],["芽","め"],["を"],["出し","だし"],["、"],["花","はな"],["を"],["咲かせ","さかせ"],["地上","ちじょう"],["を"],["その"],["実り","みのり"],["で"],["満たす","みたす"],["。"]]},{"verse":7,"text":"主は、彼を撃った者を撃たれたように彼をも撃たれたか。彼を殺した者を殺されたように彼をも殺されたか。","tok":[["主","ぬし"],["は"],["、"],["彼","かれ"],["を"],["撃った","うった"],["者","もの"],["を"],["撃たれた","うたれた"],["よう"],["に"],["彼","かれ"],["を"],["も"],["撃たれた","うたれた"],["か"],["。"],["彼","かれ"],["を"],["殺した","ころした"],["者","もの"],["を"],["殺された","ころされた"],["よう"],["に"],["彼","かれ"],["を"],["も"],["殺された","ころされた"],["か"],["。"]]},{"verse":8,"text":"あなたは彼と争って彼を追い立て、追放された。東風の日に、激しい風をもって彼を吹き払われた。","tok":[["あなた"],["は"],["彼","かれ"],["と"],["争って","あらそって"],["彼","かれ"],["を"],["追い立て","おいたて"],["、"],["追放","ついほう"],["された"],["。"],["東風","とうふう"],["の"],["日","ひ"],["に"],["、"],["激しい","はげしい"],["風","かぜ"],["を"],["もって"],["彼","かれ"],["を"],["吹き払われた","ふきはらわれた"],["。"]]},{"verse":9,"text":"それゆえ、ヤコブの咎はこのようにして贖われ罪が除かれると、その結果はこのようになる。すなわち、祭壇の石はことごとく砕けた石膏のようになりアシェラの柱や香炉台は再び建つことがなくなる。","tok":[["それ"],["ゆえ"],["、"],["ヤコブ"],["の"],["咎","とが"],["は"],["この"],["よう"],["に"],["して"],["贖われ","あがなわれ"],["罪","つみ"],["が"],["除かれる","のぞかれる"],["と"],["、"],["その"],["結果","けっか"],["は"],["この"],["よう"],["に"],["なる"],["。"],["すなわち"],["、"],["祭壇","さいだん"],["の"],["石","いし"],["は"],["ことごとく"],["砕けた","くだけた"],["石膏","せっこう"],["の"],["よう"],["に"],["なり"],["アシェラ"],["の"],["柱","はしら"],["や"],["香炉","こうろ"],["台","だい"],["は"],["再び","ふたたび"],["建つ","たつ"],["こと"],["が"],["なくなる"],["。"]]},{"verse":10,"text":"城壁に囲まれた都は孤立し置き去りになり、見捨てられて荒れ野となる。子牛はそこで草をはみ、そこに伏しまた、小枝をも食い尽くす。","tok":[["城壁","じょうへき"],["に"],["囲まれた","かこまれた"],["都","と"],["は"],["孤立","こりつ"],["し"],["置き去り","おきざり"],["に"],["なり"],["、"],["見捨てられて","みすてられて"],["荒れ野","あれの"],["と"],["なる"],["。"],["子牛","こうし"],["は"],["そこ"],["で"],["草","くさ"],["を"],["はみ"],["、"],["そこ"],["に"],["伏し","ふし"],["また"],["、"],["小枝","こえだ"],["を"],["も"],["食い","くい"],["尽くす","つくす"],["。"]]},{"verse":11,"text":"枝は枯れて折れ、女たちが来てそれを燃やす。これは全く分別のない民だ。それゆえ、造り主は憐れみをかけずその民を形づくられた方は恵みを与えられない。","tok":[["枝","えだ"],["は"],["枯れて","かれて"],["折れ","おれ"],["、"],["女","おんな"],["たち"],["が"],["来て","きて"],["それ"],["を"],["燃やす","もやす"],["。"],["これ"],["は"],["全く","まったく"],["分別","ぶんべつ"],["の"],["ない"],["民","たみ"],["だ"],["。"],["それ"],["ゆえ"],["、"],["造り主","つくりぬし"],["は"],["憐れみ","あわれみ"],["を"],["かけず"],["その"],["民","たみ"],["を"],["形づくられた","かたちづくられた"],["方","ほう"],["は"],["恵み","めぐみ"],["を"],["与えられない","あたえられない"],["。"]]},{"verse":12,"text":"その日が来るとユーフラテスの流れからエジプトの大河まで主は穂を打つように打たれる。しかし、イスラエルの人々よあなたたちは、ひとりひとり拾い集められる。","tok":[["その"],["日","ひ"],["が"],["来る","くる"],["と"],["ユーフラテス"],["の"],["流れ","ながれ"],["から"],["エジプト"],["の"],["大河","たいが"],["まで"],["主","ぬし"],["は"],["穂","ほ"],["を"],["打つ","うつ"],["よう"],["に"],["打たれる","うたれる"],["。"],["しかし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["よ"],["あなた"],["たち"],["は"],["、"],["ひとりひとり"],["拾い集められる","ひろいあつめられる"],["。"]]},{"verse":13,"text":"その日が来ると、大きな角笛が吹き鳴らされアッシリアの地に失われて行った者もエジプトの地に追いやられた者も来て聖なる山、エルサレムで主にひれ伏す。","tok":[["その"],["日","ひ"],["が"],["来る","くる"],["と"],["、"],["大きな","おおきな"],["角笛","つのぶえ"],["が"],["吹き鳴らされ","ふきならされ"],["アッシリア"],["の"],["地","ち"],["に"],["失われて","うしなわれて"],["行った","いった"],["者","もの"],["も"],["エジプト"],["の"],["地","ち"],["に"],["追いやられた","おいやられた"],["者","もの"],["も"],["来て","きて"],["聖","せい"],["なる"],["山","やま"],["、"],["エルサレム"],["で"],["主に","おもに"],["ひれ伏す","ひれふす"],["。"]]}]
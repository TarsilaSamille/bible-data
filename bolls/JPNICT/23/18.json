[{"verse":1,"text":"災いだ、遠くクシュの川のかなたで羽の音を立てている国は。","tok":[["災い","わざわい"],["だ"],["、"],["遠く","とおく"],["クシュ"],["の"],["川","かわ"],["の"],["かなた"],["で"],["羽","はね"],["の"],["音","おと"],["を"],["立てて","たてて"],["いる"],["国","くに"],["は"],["。"]]},{"verse":2,"text":"彼らは、パピルスの舟を水に浮かべ海を渡って使節を遣わす。行け、足の速い使者たちよ。背高く、肌の滑らかな国遠くの地でも恐れられている民へ。強い力で踏みにじる国幾筋もの川で区切られている国へ。","tok":[["彼","かれ"],["ら"],["は"],["、"],["パピルス"],["の"],["舟","ふね"],["を"],["水","みず"],["に"],["浮かべ","うかべ"],["海","うみ"],["を"],["渡って","わたって"],["使節","しせつ"],["を"],["遣わす","つかわす"],["。"],["行け","いけ"],["、"],["足","あし"],["の"],["速い","はやい"],["使者","ししゃ"],["たち"],["よ"],["。"],["背","せ"],["高く","たかく"],["、"],["肌","はだ"],["の"],["滑らか","なめらか"],["な"],["国","くに"],["遠く","とおく"],["の"],["地","ち"],["で"],["も"],["恐れられて","おそれられて"],["いる"],["民","たみ"],["へ"],["。"],["強い","つよい"],["力","ちから"],["で"],["踏みにじる","ふみにじる"],["国","くに"],["幾筋","いくすじ"],["も"],["の"],["川","かわ"],["で"],["区切られて","くぎられて"],["いる"],["国","くに"],["へ"],["。"]]},{"verse":3,"text":"世界の住民、地上に住むすべての人よ山に合図の旗が立てられたら、見るがよい角笛が吹き鳴らされたら、聞くがよい。","tok":[["世界","せかい"],["の"],["住民","じゅうみん"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["すべて"],["の"],["人","ひと"],["よ"],["山","やま"],["に"],["合図","あいず"],["の"],["旗","はた"],["が"],["立てられたら","たてられたら"],["、"],["見る","みる"],["が"],["よい"],["角笛","つのぶえ"],["が"],["吹き鳴らされたら","ふきならされたら"],["、"],["聞く","きく"],["が"],["よい"],["。"]]},{"verse":4,"text":"主はわたしにこう言われた。「わたしは黙してわたしの住む所から、目を注ごう。太陽よりも烈しく輝く熱のように暑い刈り入れ時を脅かす雨雲のように。」","tok":[["主","ぬし"],["は"],["わたし"],["に"],["こう"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["黙して","もくして"],["わたし"],["の"],["住む","すむ"],["所","ところ"],["から"],["、"],["目","め"],["を"],["注ごう","そそごう"],["。"],["太陽","たいよう"],["より"],["も"],["烈しく","はげしく"],["輝く","かがやく"],["熱","ねつ"],["の"],["よう"],["に"],["暑い","あつい"],["刈り入れ","かりいれ"],["時","とき"],["を"],["脅かす","おびやかす"],["雨雲","あまぐも"],["の"],["よう"],["に"],["。"],["」"]]},{"verse":5,"text":"刈り入れ時の前に、花が終わり花の房が実となり、熟し始めると主は枝を刃物で切り落としつるを折り、取り去られる。","tok":[["刈り入れ","かりいれ"],["時","とき"],["の"],["前","まえ"],["に"],["、"],["花","はな"],["が"],["終わり","おわり"],["花","はな"],["の"],["房","ふさ"],["が"],["実","じつ"],["と"],["なり"],["、"],["熟し","じゅくし"],["始める","はじめる"],["と"],["主","ぬし"],["は"],["枝","えだ"],["を"],["刃物","はもの"],["で"],["切り落とし","きりおとし"],["つる"],["を"],["折り","おり"],["、"],["取り去られる","とりさられる"],["。"]]},{"verse":6,"text":"それはすべて、山の猛禽と野の獣に与えられる。猛禽は、それを餌として夏を過ごし野獣もすべて、それを餌として冬を過ごす。","tok":[["それ"],["は"],["すべて"],["、"],["山","やま"],["の"],["猛禽","もうきん"],["と"],["野","の"],["の"],["獣","けもの"],["に"],["与えられる","あたえられる"],["。"],["猛禽","もうきん"],["は"],["、"],["それ"],["を"],["餌","えさ"],["として"],["夏","なつ"],["を"],["過ごし","すごし"],["野獣","やじゅう"],["も"],["すべて"],["、"],["それ"],["を"],["餌","えさ"],["として"],["冬","ふゆ"],["を"],["過ごす","すごす"],["。"]]},{"verse":7,"text":"そのとき、貢ぎ物が万軍の主にもたらされる。背高く、肌の滑らかな民から遠くの地でも恐れられている民から強い力で踏みにじる国幾筋もの川で区切られている国から万軍の主の名が置かれた場所シオンの山へもたらされる。","tok":[["その"],["とき"],["、"],["貢ぎ物","みつぎもの"],["が"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["に"],["もたらされる"],["。"],["背","せ"],["高く","たかく"],["、"],["肌","はだ"],["の"],["滑らか","なめらか"],["な"],["民","たみ"],["から"],["遠く","とおく"],["の"],["地","ち"],["で"],["も"],["恐れられて","おそれられて"],["いる"],["民","たみ"],["から"],["強い","つよい"],["力","ちから"],["で"],["踏みにじる","ふみにじる"],["国","くに"],["幾筋","いくすじ"],["も"],["の"],["川","かわ"],["で"],["区切られて","くぎられて"],["いる"],["国","くに"],["から"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["名","な"],["が"],["置かれた","おかれた"],["場所","ばしょ"],["シオン"],["の"],["山","やま"],["へ"],["もたらされる"],["。"]]}]
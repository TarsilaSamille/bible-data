],["こと"],["も"],["しなかった"],["。"],["わたし"],["が"],["とこしえ"],["に"],["沈黙","ちんもく"],["して"],["いる"],["と"],["思って","おもって"],["わたし"],["を"],["畏れない","おそれない"],["の"],["か"],["。"]]},{"verse":12,"text":"わたしが述べてみよう、お前の言い分お前の造ったものどもを。お前にとって、それらは何の役にも立たない。","tok":[["わたし"],["が"],["述べて","のべて"],["みよう"],["、"],["お前","おまえ"],["の"],["言い分","いいぶん"],["お前","おまえ"],["の"],["造った","つくった"],["もの"],["ども"],["を"],["。"],["お前","おまえ"],["にとって"],["、"],["それ"],["ら"],["は"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["。"]]},{"verse":13,"text":"助けを求めて叫んでもお前の偶像の一群はお前を救いはしない。風がそれらすべてを巻き上げひと息でそれらを吹き去るであろう。わたしに身を寄せる者がこの地を嗣業としわたしの聖なる山を継ぐであろう。","tok":[["助け","たすけ"],["を"],["求めて","もとめて"],["叫んで","さけんで"],["も"],["お前","おまえ"],["の"],["偶像","ぐうぞう"],["の"],["一群","いちぐん"],["は"],["お前","おまえ"],["を"],["救い","すくい"],["は"],["しない"],["。"],["風","かぜ"],["が"],["それ"],["ら"],["すべて"],["を"],["巻き上げ","まきあげ"],["ひと息","ひといき"],["で"],["それ"],["ら"],["を"],["吹き去るで","ふきさるで"],["あろう"],["。"],["わたし"],["に"],["身","み"],["を"],["寄せる","よせる"],["者","もの"],["が"],["この"],["地","ち"],["を"],["嗣業","しぎょう"],["と"],["し"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["を"],["継ぐで","つぐで"],["あろう"],["。"]]},{"verse":14,"text":"主は言われる。盛り上げよ、土を盛り上げて道を備えよ。わたしの民の道からつまずきとなる物を除け。","tok":[["主","ぬし"],["は"],["言われる","いわれる"],["。"],["盛り上げよ","もりあげよ"],["、"],["土","つち"],["を"],["盛り上げて","もりあげて"],["道","みち"],["を"],["備え","そなえ"],["よ"],["。"],["わたし"],["の"],["民","たみ"],["の"],["道","みち"],["から"],["つまずき"],["と"],["なる"],["物","もの"],["を"],["除け","よけ"],["。"]]},{"verse":15,"text":"高く、あがめられて、永遠にいましその名を聖と唱えられる方がこう言われる。わたしは、高く、聖なる所に住み打ち砕かれて、へりくだる霊の人と共にありへりくだる霊の人に命を得させ打ち砕かれた心の人に命を得させる。","tok":[["高く","たかく"],["、"],["あがめられて"],["、"],["永遠","えいえん"],["に"],["いまし"],["その"],["名","な"],["を"],["聖","せい"],["と"],["唱えられる","となえられる"],["方","かた"],["が"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["高く","たかく"],["、"],["聖","せい"],["なる"],["所","ところ"],["に"],["住み","すみ"],["打ち砕かれて","うちくだかれて"],["、"],["へりくだる"],["霊","れい"],["の"],["人","ひと"],["と"],["共","とも"],["に"],["あり"],["へりくだる"],["霊","れい"],["の"],["人","ひと"],["に"],["命","いのち"],["を"],["得させ","えさせ"],["打ち砕かれた","うちくだかれた"],["心","こころ"],["の"],["人","ひと"],["に"],["命","いのち"],["を"],["得させる","えさせる"],["。"]]},{"verse":16,"text":"わたしは、とこしえに責めるものではない。永遠に怒りを燃やすものでもない。霊がわたしの前で弱り果てることがないようにわたしの造った命ある者が。","tok":[["わたし"],["は"],["、"],["とこしえ"],["に"],["責める","せめる"],["もの"],["で"],["は"],["ない"],["。"],["永遠","えいえん"],["に"],["怒り","いかり"],["を"],["燃やす","もやす"],["もの"],["で"],["も"],["ない"],["。"],["霊","れい"],["が"],["わたし"],["の"],["前","まえ"],["で"],["弱り","よわり"],["果てる","はてる"],["こと"],["が"],["ない"],["よう"],["に"],["わたし"],["の"],["造った","つくった"],["命","いのち"],["ある"],["者","もの"],["が"],["。"]]},{"verse":17,"text":"貪欲な彼の罪をわたしは怒り彼を打ち、怒って姿を隠した。彼は背き続け、心のままに歩んだ。","tok":[["貪欲","どんよく"],["な"],["彼","かれ"],["の"],["罪","つみ"],["を"],["わたし"],["は"],["怒り","いかり"],["彼","かれ"],["を"],["打ち","うち"],["、"],["怒って","おこって"],["姿","すがた"],["を"],["隠した","かくした"],["。"],["彼","かれ"],["は"],["背き","そむき"],["続け","つづけ"],["、"],["心","こころ"],["の"],["まま"],["に"],["歩んだ","あゆんだ"],["。"]]},{"verse":18,"text":"わたしは彼の道を見た。わたしは彼をいやし、休ませ慰めをもって彼を回復させよう。民のうちの嘆く人々のために","tok":[["わたし"],["は"],["彼","かれ"],["の"],["道","みち"],["を"],["見た","みた"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["いやし"],["、"],["休ませ","やすませ"],["慰め","なぐさめ"],["を"],["もって"],["彼","かれ"],["を"],["回復","かいふく"],["させよう"],["。"],["民","たみ"],["の"],["うち"],["の"],["嘆く","なげく"],["人々","ひとびと"],["の"],["ため"],["に"]]},{"verse":19,"text":"わたしは唇の実りを創造し、与えよう。平和、平和、遠くにいる者にも近くにいる者にも。わたしは彼をいやす、と主は言われる。","tok":[["わたし"],["は"],["唇","くちびる"],["の"],["実り","みのり"],["を"],["創造","そうぞう"],["し"],["、"],["与えよう","あたえよう"],["。"],["平和","へいわ"],["、"],["平和","へいわ"],["、"],["遠く","とおく"],["に"],["いる"],["者","もの"],["に"],["も"],["近く","ちかく"],["に"],["いる"],["者","もの"],["に"],["も"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["いやす"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":20,"text":"神に逆らう者は巻き上がる海のようで静めることはできない。その水は泥や土を巻き上げる。","tok":[["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["は"],["巻き上がる","まきあがる"],["海","うみ"],["の"],["よう"],["で"],["静める","しずめる"],["こと"],["は"],["できない"],["。"],["その"],["水","みず"],["は"],["泥","どろ"],["や"],["土","つち"],["を"],["巻き上げる","まきあげる"],["。"]]},{"verse":21,"text":"神に逆らう者に平和はないとわたしの神は言われる。","tok":[["神
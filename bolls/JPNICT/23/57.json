[{"verse":1,"text":"神に従ったあの人は失われたがだれひとり心にかけなかった。神の慈しみに生きる人々が取り去られても気づく者はない。神に従ったあの人は、さいなまれて取り去られた。","tok":[["神","かみ"],["に"],["従った","したがった"],["あの"],["人","ひと"],["は"],["失われた","うしなわれた"],["が"],["だれ"],["ひとり"],["心","こころ"],["に"],["かけなかった"],["。"],["神","かみ"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人々","ひとびと"],["が"],["取り去られて","とりさられて"],["も"],["気づく","きづく"],["者","もの"],["は"],["ない"],["。"],["神","かみ"],["に"],["従った","したがった"],["あの"],["人","ひと"],["は"],["、"],["さいなまれて"],["取り去られた","とりさられた"],["。"]]},{"verse":2,"text":"しかし、平和が訪れる。真実に歩む人は横たわって憩う。","tok":[["しかし"],["、"],["平和","へいわ"],["が"],["訪れる","おとずれる"],["。"],["真実","しんじつ"],["に"],["歩む","あゆむ"],["人","ひと"],["は"],["横たわって","よこたわって"],["憩う","いこう"],["。"]]},{"verse":3,"text":"お前たち、女まじない師の子らよ姦淫する男と淫行の女との子孫よここに近づくがよい。","tok":[["お前","おまえ"],["たち"],["、"],["女","おんな"],["まじない"],["師","し"],["の"],["子","こ"],["ら"],["よ"],["姦淫","かんいん"],["する"],["男","おとこ"],["と"],["淫行","いんこう"],["の"],["女","おんな"],["と"],["の"],["子孫","しそん"],["よ"],["ここ"],["に"],["近づく","ちかづく"],["が"],["よい"],["。"]]},{"verse":4,"text":"お前たちは誰を快楽の相手とするのか。誰に向かって大口を開き、舌を出すのか。お前たちは背きの罪が産んだ子ら偽りの子孫ではないか。","tok":[["お前","おまえ"],["たち"],["は"],["誰","だれ"],["を"],["快楽","かいらく"],["の"],["相手","あいて"],["と"],["する"],["の"],["か"],["。"],["誰","だれ"],["に"],["向かって","むかって"],["大口","おおぐち"],["を"],["開き","ひらき"],["、"],["舌","した"],["を"],["出す","だす"],["の"],["か"],["。"],["お前","おまえ"],["たち"],["は"],["背き","そむき"],["の"],["罪","つみ"],["が"],["産んだ","うんだ"],["子","こ"],["ら"],["偽り","いつわり"],["の"],["子孫","しそん"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":5,"text":"大木の陰、すべての茂る木の下で身を焦がし谷間や岩の裂け目で子供を屠る者らではないか。","tok":[["大木","たいぼく"],["の"],["陰","かげ"],["、"],["すべて"],["の"],["茂る","しげる"],["木","き"],["の"],["下","もと"],["で"],["身","み"],["を"],["焦がし","こがし"],["谷間","たにま"],["や"],["岩","いわ"],["の"],["裂け目","さけめ"],["で"],["子供","こども"],["を"],["屠る","ほふる"],["者","もの"],["ら"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"お前は谷間の滑らかな岩を自分の分とし彼らを自分の運命としそれらにぶどう酒を注ぎ穀物の献げ物をささげた。わたしがそれらを容赦すると思うのか。","tok":[["お前","おまえ"],["は"],["谷間","たにま"],["の"],["滑らか","なめらか"],["な"],["岩","いわ"],["を"],["自分","じぶん"],["の"],["分","ぶん"],[
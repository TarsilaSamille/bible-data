[{"verse":1,"text":"「エドムから来るのは誰か。ボツラから赤い衣をまとって来るのは。その装いは威光に輝き勢い余って身を倒しているのは。」「わたしは勝利を告げ大いなる救いをもたらすもの。」","tok":[["「"],["エドム"],["から"],["来る","くる"],["の"],["は"],["誰","だれ"],["か"],["。"],["ボツラ"],["から"],["赤い","あかい"],["衣","ころも"],["を"],["まとって"],["来る","くる"],["の"],["は"],["。"],["その"],["装い","よそおい"],["は"],["威光","いこう"],["に"],["輝き","かがやき"],["勢い","いきおい"],["余って","あまって"],["身","み"],["を"],["倒して","たおして"],["いる"],["の"],["は"],["。"],["」"],["「"],["わたし"],["は"],["勝利","しょうり"],["を"],["告げ","つげ"],["大いなる","おおいなる"],["救い","すくい"],["を"],["もたらす"],["もの"],["。"],["」"]]},{"verse":2,"text":"「なぜ、あなたの装いは赤く染まり衣は酒ぶねを踏む者のようなのか。」","tok":[["「"],["なぜ"],["、"],["あなた"],["の"],["装い","よそおい"],["は"],["赤く","あかく"],["染まり","そまり"],["衣","ころも"],["は"],["酒","さか"],["ぶね"],["を"],["踏む","ふむ"],["者","もの"],["の"],["よう"],["な"],["の"],["か"],["。"],["」"]]},{"verse":3,"text":"「わたしはただひとりで酒ぶねを踏んだ。諸国の民はだれひとりわたしに伴わなかった。わたしは怒りをもって彼らを踏みつけ憤りをもって彼らを踏み砕いた。それゆえ、わたしの衣は血を浴びわたしは着物を汚した。」","tok":[["「"],["わたし"],["は"],["ただ"],["ひとり"],["で"],["酒","さけ"],["ぶね"],["を"],["踏んだ","ふんだ"],["。"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["だれ"],["ひとり"],["わたし"],["に"],["伴わなかった","ともなわなかった"],["。"],["わたし"],["は"],["怒り","いかり"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["踏みつけ","ふみつけ"],["憤り","いきどおり"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["踏み砕いた","ふみくだいた"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["の"],["衣","ころも"],["は"],["血","ち"],["を"],["浴び","あび"],["わたし"],["は"],["着物","きもの"],["を"],["汚した","よごした"],["。"],["」"]]},{"verse":4,"text":"わたしが心に定めた報復の日わたしの贖いの年が来たので","tok":[["わたし"],["が"],["心","こころ"],["に"],["定めた","さだめた"],["報復","ほうふく"],["の"],["日","ひ"],["わたし"],["の"],["贖い","あがない"],["の"],["年","とし"],["が"],["来た","きた"],["ので"]]},{"verse":5,"text":"わたしは見回したが、助ける者はなく驚くほど、支える者はいなかった。わたしの救いはわたしの腕によりわたしを支えたのはわたしの憤りだ。","tok":[["わたし"],["は"],["見回した","みまわした"],["が"],["、"],["助ける","たすける"],["者","もの"],["は"],["なく"],["驚く","おどろく"],["ほど"],["、"],["支える","ささえる"],["者","もの"],["は"],["いなかった"],["。"],["わたし"],["の"],["救い","すくい"],["は"],["わたし"],["の"],["腕","うで"],["に"],["より"],["わたし"],["を"],["支えた","ささえた"],["の"],["は"],["わたし"],["の"],["憤り","いきどおり"],["だ"],["。"]]},{"verse":6,"text":"わたしは怒りをもって諸国の民を踏みにじりわたしの憤りをもって彼らを酔わせ彼らの血を大地に流れさせた。","tok":[["わたし"],["は"],["怒り","いかり"],["を"],["もって"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["踏みにじり","ふみにじり"],["わたし"],["の"],["憤り","いきどおり"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["酔わせ","よわせ"],["彼","かれ"],["ら"],["の"],["血","ち"],["を"],["大地","だいち"],["に"],["流れさせた","ながれさせた"],["。"]]},{"verse":7,"text":"わたしは心に留める、主の慈しみと主の栄誉を主がわたしたちに賜ったすべてのことを主がイスラエルの家に賜った多くの恵み憐れみと豊かな慈しみを。","tok":[["わたし"],["は"],["心","こころ"],["に"],["留める","とめる"],["、"],["主","ぬし"],["の"],["慈しみ","いつくしみ"],["と"],["主","ぬし"],["の"],["栄誉","えいよ"],["を"],["主","ぬし"],["が"],["わたしたち"],["に"],["賜った","たまわった"],["すべて"],["の"],["こと"],["を"],["主","ぬし"],["が"],["イスラエル"],["の"],["家","いえ"],["に"],["賜った","たまわった"],["多く","おおく"],["の"],["恵み","めぐみ"],["憐れみ","あわれみ"],["と"],["豊か","ゆたか"],["な"],["慈しみ","いつくしみ"],["を"],["。"]]},{"verse":8,"text":"主は言われた彼らはわたしの民、偽りのない子らである、と。そして主は彼らの救い主となられた。","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["、"],["偽り","いつわり"],["の"],["ない"],["子","こ"],["ら"],["で"],["ある"],["、"],["と"],["。"],["そして"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["救い主","すくいぬし"],["と"],["なられた"],["。"]]},{"verse":9,"text":"彼らの苦難を常に御自分の苦難とし御前に仕える御使いによって彼らを救い愛と憐れみをもって彼らを贖い昔から常に彼らを負い、彼らを担ってくださった。","tok":[["彼","かれ"],["ら"],["の"],["苦難","くなん"],["を"],["常","つね"],["に"],["御自分","ごじぶん"],["の"],["苦難","くなん"],["と"],["し"],["御前","ごぜん"],["に"],["仕える","つかえる"],["御使い","おつかい"],["によって"],["彼","かれ"],["ら"],["を"],["救い","すくい"],["愛","あい"],["と"],["憐れみ","あわれみ"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["贖い","あがない"],["昔","むかし"],["から"],["常","つね"],["に"],["彼","かれ"],["ら"],["を"],["負い","おい"],["、"],["彼","かれ"],["ら"],["を"],["担って","になって"],["くださった"],["。"]]},{"verse":10,"text":"しかし、彼らは背き、主の聖なる霊を苦しめた。主はひるがえって敵となり、戦いを挑まれた。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["背き","そむき"],["、"],["主","ぬし"],["の"],["聖","せい"],["なる"],["霊","れい"],["を"],["苦しめた","くるしめた"],["。"],["主","ぬし"],["は"],["ひるがえって"],["敵","てき"],["と"],["なり"],["、"],["戦い","たたかい"],["を"],["挑まれた","いどまれた"],["。"]]},{"verse":11,"text":"そのとき、主の民は思い起こした昔の日々を、モーセを。どこにおられるのかその群れを飼う者を海から導き出された方は。どこにおられるのか聖なる霊を彼のうちにおかれた方は。","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["民","たみ"],["は"],["思い起こした","おもいおこした"],["昔","むかし"],["の"],["日々","ひび"],["を"],["、"],["モーセ"],["を"],["。"],["どこ"],["に"],["おられる"],["の"],["か"],["その"],["群れ","むれ"],["を"],["飼う","かう"],["者","もの"],["を"],["海","うみ"],["から"],["導き出された","みちびきだされた"],["方","ほう"],["は"],["。"],["どこ"],["に"],["おられる"],["の"],["か"],["聖","せい"],["なる"],["霊","れい"],["を"],["彼","かれ"],["の"],["うち"],["に"],["おかれた"],["方","ほう"],["は"],["。"]]},{"verse":12,"text":"主は輝く御腕をモーセの右に伴わせ民の前で海を二つに分けとこしえの名声を得られた。","tok":[["主","ぬし"],["は"],["輝く","かがやく"],["御腕","おうで"],["を"],["モーセ"],["の"],["右","みぎ"],["に"],["伴わせ","ともなわせ"],["民","たみ"],["の"],["前","まえ"],["で"],["海","うみ"],["を"],["二","ふた"],["つ"],["に"],["分け","わけ"],["とこしえ"],["の"],["名声","めいせい"],["を"],["得られた","えられた"],["。"]]},{"verse":13,"text":"主は彼らを導いて淵の中を通らせられたが彼らは荒れ野を行く馬のようにつまずくこともなかった。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["導いて","みちびいて"],["淵","ふち"],["の"],["中","なか"],["を"],["通らせられた","とおらせられた"],["が"],["彼","かれ"],["ら"],["は"],["荒れ野","あれの"],["を"],["行く","いく"],["馬","うま"],["の"],["よう"],["に"],["つまずく"],["こと"],["も"],["なかった"],["。"]]},{"verse":14,"text":"谷間に下りて行く家畜のように主の霊は彼らを憩わせられた。このようにあなたは御自分の民を導き輝く名声を得られた。","tok":[["谷間","たにま"],["に"],["下りて","おりて"],["行く","いく"],["家畜","かちく"],["の"],["よう"],["に"],["主","ぬし"],["の"],["霊","れい"],["は"],["彼","かれ"],["ら"],["を"],["憩わせられた","いこわせられた"],["。"],["この"],["よう"],["に"],["あなた"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["を"],["導き","みちびき"],["輝く","かがやく"],["名声","めいせい"],["を"],["得られた","えられた"],["。"]]},{"verse":15,"text":"どうか、天から見下ろし輝かしく聖なる宮から御覧ください。どこにあるのですかあなたの熱情と力強い御業は。あなたのたぎる思いと憐れみは抑えられていて、わたしに示されません。","tok":[["どう"],["か"],["、"],["天","てん"],["から"],["見下ろし","みおろし"],["輝かしく","かがやかしく"],["聖","せい"],["なる"],["宮","みや"],["から"],["御覧","ごらん"],["ください"],["。"],["どこ"],["に"],["ある"],["の"],["です"],["か"],["あなた"],["の"],["熱情","ねつじょう"],["と"],["力強い","ちからづよい"],["御業","ごごう"],["は"],["。"],["あなた"],["の"],["たぎる"],["思い","おもい"],["と"],["憐れみ","あわれみ"],["は"],["抑えられて","おさえられて"],["いて"],["、"],["わたし"],["に"],["示されません","しめされません"],["。"]]},{"verse":16,"text":"あなたはわたしたちの父です。アブラハムがわたしたちを見知らずイスラエルがわたしたちを認めなくても主よ、あなたはわたしたちの父です。「わたしたちの贖い主」これは永遠の昔からあなたの御名です。","tok":[["あなた"],["は"],["わたしたち"],["の"],["父","ちち"],["です"],["。"],["アブラハム"],["が"],["わたしたち"],["を"],["見知らず","みしらず"],["イスラエル"],["が"],["わたしたち"],["を"],["認めなくて","みとめなくて"],["も"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["わたしたち"],["の"],["父","ちち"],["です"],["。"],["「"],["わたしたち"],["の"],["贖い","あがない"],["主","ぬし"],["」"],["これ"],["は"],["永遠","えいえん"],["の"],["昔","むかし"],["から"],["あなた"],["の"],["御名","ぎょめい"],["です"],["。"]]},{"verse":17,"text":"なにゆえ主よ、あなたはわたしたちをあなたの道から迷い出させわたしたちの心をかたくなにしてあなたを畏れないようにされるのですか。立ち帰ってください、あなたの僕たちのためにあなたの嗣業である部族のために。","tok":[["なにゆえ"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["わたしたち"],["を"],["あなた"],["の"],["道","みち"],["から"],["迷い出させ","まよいでさせ"],["わたしたち"],["の"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["あなた"],["を"],["畏れない","おそれない"],["よう"],["に"],["される"],["の"],["です"],["か"],["。"],["立ち帰って","たちかえって"],["ください"],["、"],["あなた"],["の"],["僕たち","ぼくたち"],["の"],["ため"],["に"],["あなた"],["の"],["嗣業","しぎょう"],["で"],["ある"],["部族","ぶぞく"],["の"],["ため"],["に"],["。"]]},{"verse":18,"text":"あなたの聖なる民が継ぐべき土地を持ったのはわずかの間です。間もなく敵はあなたの聖所を踏みにじりました。","tok":[["あなた"],["の"],["聖","せい"],["なる"],["民","たみ"],["が"],["継ぐべき","つぐべき"],["土地","とち"],["を"],["持った","もった"],["の"],["は"],["わずか"],["の"],["間","あいだ"],["です"],["。"],["間","ま"],["も"],["なく"],["敵","てき"],["は"],["あなた"],["の"],["聖","せい"],["所","しょ"],["を"],["踏みにじりました","ふみにじりました"],["。"]]},{"verse":19,"text":"あなたの統治を受けられなくなってからあなたの御名で呼ばれない者となってからわたしたちは久しい時を過ごしています。どうか、天を裂いて降ってください。御前に山々が揺れ動くように。","tok":[["あなた"],["の"],["統治","とうち"],["を"],["受けられなく","うけられなく"],["なって"],["から"],["あなた"],["の"],["御名","ぎょめい"],["で"],["呼ばれない","よばれない"],["者","もの"],["と"],["なって"],["から"],["わたしたち"],["は"],["久しい","ひさしい"],["時","とき"],["を"],["過ごして","すごして"],["います"],["。"],["どう"],["か"],["、"],["天","てん"],["を"],["裂いて","さいて"],["降って","ふって"],["ください"],["。"],["御前","ごぜん"],["に"],["山々","やまやま"],["が"],["揺れ動く","ゆれうごく"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"わたしに尋ねようとしない者にもわたしは、尋ね出される者となりわたしを求めようとしない者にも見いだされる者となった。わたしの名を呼ばない民にもわたしはここにいる、ここにいると言った。","tok":[["わたし"],["に"],["尋ねよう","たずねよう"],["と"],["しない"],["者","もの"],["に"],["も"],["わたし"],["は"],["、"],["尋ね出される","たずねだされる"],["者","もの"],["と"],["なり"],["わたし"],["を"],["求めよう","もとめよう"],["と"],["しない"],["者","もの"],["に"],["も"],["見いだされる","みいだされる"],["者","もの"],["と"],["なった"],["。"],["わたし"],["の"],["名","な"],["を"],["呼ばない","よばない"],["民","たみ"],["に"],["も"],["わたし"],["は"],["ここ"],["に"],["いる"],["、"],["ここ"],["に"],["いる"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"反逆の民、思いのままに良くない道を歩く民に絶えることなく手を差し伸べてきた。","tok":[["反逆","はんぎゃく"],["の"],["民","たみ"],["、"],["思い","おもい"],["の"],["まま"],["に"],["良く","よく"],["ない"],["道","みち"],["を"],["歩く","あるく"],["民","たみ"],["に"],["絶える","たえる"],["こと"],["なく"],["手","て"],["を"],["差し伸べて","さしのべて"],["きた"],["。"]]},{"verse":3,"text":"この民は常にわたしを怒らせ、わたしに逆らう。園でいけにえをささげ、屋根の上で香をたき","tok":[["この"],["民","みん"],["は"],["常","つね"],["に"],["わたし"],["を"],["怒らせ","おこらせ"],["、"],["わたし"],["に"],["逆らう","さからう"],["。"],["園","その"],["で"],["いけにえ"],["を"],["ささげ"],["、"],["屋根","やね"],["の"],["上","うえ"],["で"],["香","こう"],["を"],["たき"]]},{"verse":4,"text":"墓場に座り、隠れた所で夜を過ごし豚の肉を食べ、汚れた肉の汁を器に入れながら","tok":[["墓場","はかば"],["に"],["座り","すわり"],["、"],["隠れた","かくれた"],["所","ところ"],["で"],["夜","よる"],["を"],["過ごし","すごし"],["豚","ぶた"],["の"],["肉","にく"],["を"],["食べ","たべ"],["、"],["汚れた","よごれた"],["肉","にく"],["の"],["汁","しる"],["を"],["器","うつわ"],["に"],["入れ","いれ"],["ながら"]]},{"verse":5,"text":"「遠ざかっているがよい、わたしに近づくなわたしはお前にとってあまりに清い」と言う。これらの者は、わたしに怒りの煙を吐かせ絶えることなく火を燃え上がらせる。","tok":[["「"],["遠ざかって","とおざかって"],["いる"],["が"],["よい"],["、"],["わたし"],["に"],["近づく","ちかづく"],["な"],["わたし"],["は"],["お前","おまえ"],["にとって"],["あまり"],["に"],["清い","きよい"],["」"],["と"],["言う","ゆう"],["。"],["これ"],["ら"],["の"],["者","もの"],["は"],["、"],["わたし"],["に"],["怒り","いかり"],["の"],["煙","けむり"],["を"],["吐かせ","はかせ"],["絶える","たえる"],["こと"],["なく"],["火","ひ"],["を"],["燃え上がらせる","もえあがらせる"],["。"]]},{"verse":6,"text":"見よ、わたしの前にそれは書き記されている。わたしは黙すことなく、必ず報いる。彼らのふところに報いる。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["前","まえ"],["に"],["それ"],["は"],["書き記されて","かきしるされて"],["いる"],["。"],["わたし"],["は"],["黙す","もくす"],["こと"],["なく"],["、"],["必ず","かならず"],["報いる","むくいる"],["。"],["彼","かれ"],["ら"],["の"],["ふところ"],["に"],["報いる","むくいる"],["。"]]},{"verse":7,"text":"彼らの悪も先祖の悪も共に、と主は言われる。彼らは山の上で香をたき丘の上でわたしを嘲った。わたしは、初めから彼らがしてきた業を量りそのふところに報いる。","tok":[["彼","かれ"],["ら"],["の"],["悪","あく"],["も"],["先祖","せんぞ"],["の"],["悪","あく"],["も"],["共","とも"],["に"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["彼","かれ"],["ら"],["は"],["山","やま"],["の"],["上","うえ"],["で"],["香","こう"],["を"],["たき"],["丘","きゅう"],["の"],["上","うえ"],["で"],["わたし"],["を"],["嘲った","あざけった"],["。"],["わたし"],["は"],["、"],["初め","はじめ"],["から"],["彼","かれ"],["ら"],["が"],["して"],["きた"],["業","ごう"],["を"],["量り","はかり"],["その"],["ふところ"],["に"],["報いる","むくいる"],["。"]]},{"verse":8,"text":"主はこう言われる。ぶどうの房に汁があれば、それを損なうなそこには祝福があるから、と人は言う。わたしはわが僕らのためにすべてを損なうことはしない。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["ぶどう"],["の"],["房","ふさ"],["に"],["汁","しる"],["が"],["あれば"],["、"],["それ"],["を"],["損なうな","そこなうな"],["そこ"],["に"],["は"],["祝福","しゅくふく"],["が"],["ある"],["から"],["、"],["と"],["人","ひと"],["は"],["言う","ゆう"],["。"],["わたし"],["は"],["わが"],["僕","ぼく"],["ら"],["の"],["ため"],["に"],["すべて"],["を"],["損なう","そこなう"],["こと"],["は"],["しない"],["。"]]},{"verse":9,"text":"ヤコブから子孫をユダからわたしの山々を継ぐ者を引き出そう。わたしの選んだ者らがそれを継ぎわたしの僕らがそこに住むであろう。","tok":[["ヤコブ"],["から"],["子孫","しそん"],["を"],["ユダ"],["から"],["わたし"],["の"],["山々","やまやま"],["を"],["継ぐ","つぐ"],["者","もの"],["を"],["引き出そう","ひきだそう"],["。"],["わたし"],["の"],["選んだ","えらんだ"],["者","もの"],["ら"],["が"],["それ"],["を"],["継ぎ","つぎ"],["わたし"],["の"],["僕","ぼく"],["ら"],["が"],["そこ"],["に"],["住むで","すむで"],["あろう"],["。"]]},{"verse":10,"text":"シャロンの野は羊の群がるところアコルの谷は牛の伏すところとなりわたしを尋ね求めるわが民のものとなる。","tok":[["シャロン"],["の"],["野","の"],["は"],["羊","ひつじ"],["の"],["群がる","むらがる"],["ところ"],["アコル"],["の"],["谷","たに"],["は"],["牛","うし"],["の"],["伏す","ふす"],["ところ"],["と"],["なり"],["わたし"],["を"],["尋ね求める","たずねもとめる"],["わが"],["民","たみ"],["の"],["もの"],["と"],["なる"],["。"]]},{"verse":11,"text":"お前たち、主を捨て、わたしの聖なる山を忘れ禍福の神に食卓を調え運命の神に混ぜ合わせた酒を注ぐ者よ。","tok":[["お前","おまえ"],["たち"],["、"],["主","ぬし"],["を"],["捨て","すて"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["を"],["忘れ","わすれ"],["禍福","かふく"],["の"],["神","かみ"],["に"],["食卓","しょくたく"],["を"],["調え","ととのえ"],["運命","うんめい"],["の"],["神","かみ"],["に"],["混ぜ合わせた","まぜあわせた"],["酒","さけ"],["を"],["注ぐ","そそぐ"],["者","もの"],["よ"],["。"]]},{"verse":12,"text":"わたしはお前たちを剣に渡す。お前たちは皆、倒され屠られる。呼んでも答えず、語りかけても聞かずわたしの目に悪とされることを行いわたしの喜ばないことを選んだからである。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["剣","けん"],["に"],["渡す","わたす"],["。"],["お前","おまえ"],["たち"],["は"],["皆","みな"],["、"],["倒され","たおされ"],["屠られる","ほふられる"],["。"],["呼んで","よんで"],["も"],["答えず","こたえず"],["、"],["語りかけて","かたりかけて"],["も"],["聞かず","きかず"],["わたし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行い","おこない"],["わたし"],["の"],["喜ばない","よろこばない"],["こと"],["を"],["選んだ","えらんだ"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"それゆえ、主なる神はこう言われる。見よ、わたしの僕らは糧を得るがお前たちは飢える。見よ、わたしの僕らは飲むことができるがお前たちは渇く。見よ、わたしの僕らは喜び祝うがお前たちは恥を受ける。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["の"],["僕","ぼく"],["ら"],["は"],["糧","かて"],["を"],["得る","うる"],["が"],["お前","おまえ"],["たち"],["は"],["飢える","うえる"],["。"],["見よ","みよ"],["、"],["わたし"],["の"],["僕","ぼく"],["ら"],["は"],["飲む","のむ"],["こと"],["が"],["できる"],["が"],["お前","おまえ"],["たち"],["は"],["渇く","かわく"],["。"],["見よ","みよ"],["、"],["わたし"],["の"],["僕","ぼく"],["ら"],["は"],["喜び祝う","よろこびいわう"],["が"],["お前","おまえ"],["たち"],["は"],["恥","はじ"],["を"],["受ける","うける"],["。"]]},{"verse":14,"text":"見よ、わたしの僕らは心の喜びに声をあげるがお前たちは心の痛みに叫びをあげ魂を砕かれて泣き叫ぶ。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["僕","ぼく"],["ら"],["は"],["心","こころ"],["の"],["喜び","よろこび"],["に"],["声","こえ"],["を"],["あげる"],["が"],["お前","おまえ"],["たち"],["は"],["心","こころ"],["の"],["痛み","いたみ"],["に"],["叫び","さけび"],["を"],["あげ"],["魂","たましい"],["を"],["砕かれて","くだかれて"],["泣き叫ぶ","なきさけぶ"],["。"]]},{"verse":15,"text":"お前たちが残す名はわたしに選ばれた者の誓いの言葉となり「主なる神はお前を滅ぼす」と唱えられる。しかし、僕たちは異なる名で呼ばれる。","tok":[["お前","おまえ"],["たち"],["が"],["残す","のこす"],["名","な"],["は"],["わたし"],["に"],["選ばれた","えらばれた"],["者","もの"],["の"],["誓い","ちかい"],["の"],["言葉","ことば"],["と"],["なり"],["「"],["主","おも"],["なる"],["神","かみ"],["は"],["お前","おまえ"],["を"],["滅ぼす","ほろぼす"],["」"],["と"],["唱えられる","となえられる"],["。"],["しかし"],["、"],["僕たち","ぼくたち"],["は"],["異なる","ことなる"],["名","な"],["で"],["呼ばれる","よばれる"],["。"]]},{"verse":16,"text":"この地で祝福される人は真実の神によって祝福されこの地で誓う人は真実の神によって誓う。初めからの苦しみは忘れられる。わたしの目から隠されるからである。","tok":[["この"],["地","ち"],["で"],["祝福","しゅくふく"],["される"],["人","ひと"],["は"],["真実","しんじつ"],["の"],["神","かみ"],["によって"],["祝福","しゅくふく"],["され"],["この"],["地","ち"],["で"],["誓う","ちかう"],["人","ひと"],["は"],["真実","しんじつ"],["の"],["神","かみ"],["によって"],["誓う","ちかう"],["。"],["初め","はじめ"],["から"],["の"],["苦しみ","くるしみ"],["は"],["忘れられる","わすれられる"],["。"],["わたし"],["の"],["目","め"],["から"],["隠される","かくされる"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"見よ、わたしは新しい天と新しい地を創造する。初めからのことを思い起こす者はない。それはだれの心にも上ることはない。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["新しい","あたらしい"],["天","てん"],["と"],["新しい","あたらしい"],["地","ち"],["を"],["創造","そうぞう"],["する"],["。"],["初め","はじめ"],["から"],["の"],["こと"],["を"],["思い起こす","おもいおこす"],["者","もの"],["は"],["ない"],["。"],["それ"],["は"],["だれ"],["の"],["心","こころ"],["に"],["も"],["上る","のぼる"],["こと"],["は"],["ない"],["。"]]},{"verse":18,"text":"代々とこしえに喜び楽しみ、喜び躍れ。わたしは創造する。見よ、わたしはエルサレムを喜び躍るものとしてその民を喜び楽しむものとして、創造する。","tok":[["代々","だいだい"],["とこしえ"],["に"],["喜び楽しみ","よろこびたのしみ"],["、"],["喜び","よろこび"],["躍れ","おどれ"],["。"],["わたし"],["は"],["創造","そうぞう"],["する"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["エルサレム"],["を"],["喜び","よろこび"],["躍る","おどる"],["もの"],["として"],["その"],["民","たみ"],["を"],["喜び楽しむ","よろこびたのしむ"],["もの"],["として"],["、"],["創造","そうぞう"],["する"],["。"]]},{"verse":19,"text":"わたしはエルサレムを喜びとしわたしの民を楽しみとする。泣く声、叫ぶ声は、再びその中に響くことがない。","tok":[["わたし"],["は"],["エルサレム"],["を"],["喜び","よろこび"],["と"],["し"],["わたし"],["の"],["民","たみ"],["を"],["楽しみ","たのしみ"],["と"],["する"],["。"],["泣く","なく"],["声","こえ"],["、"],["叫ぶ","さけぶ"],["声","こえ"],["は"],["、"],["再び","ふたたび"],["その"],["中","なか"],["に"],["響く","ひびく"],["こと"],["が"],["ない"],["。"]]},{"verse":20,"text":"そこには、もはや若死にする者も年老いて長寿を満たさない者もなくなる。百歳で死ぬ者は若者とされ百歳に達しない者は呪われた者とされる。","tok":[["そこ"],["に"],["は"],["、"],["もはや"],["若死に","わかじに"],["する"],["者",
[{"verse":1,"text":"わたしの兄弟たち、あなたがたのうち多くの人が教師になってはなりません。わたしたち教師がほかの人たちより厳しい裁きを受けることになると、あなたがたは知っています。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["の"],["うち"],["多く","おおく"],["の"],["人","ひと"],["が"],["教師","きょうし"],["に"],["なって"],["は"],["なりません"],["。"],["わたしたち"],["教師","きょうし"],["が"],["ほか"],["の"],["人","ひと"],["たち"],["より"],["厳しい","きびしい"],["裁き","さばき"],["を"],["受ける","うける"],["こと"],["に"],["なる"],["と"],["、"],["あなた"],["がた"],["は"],["知って","しって"],["います"],["。"]]},{"verse":2,"text":"わたしたちは皆、度々過ちを犯すからです。言葉で過ちを犯さないなら、それは自分の全身を制御できる完全な人です。","tok":[["わたしたち"],["は"],["皆","みな"],["、"],["度々","たびたび"],["過ち","あやまち"],["を"],["犯す","おかす"],["から"],["です"],["。"],["言葉","ことば"],["で"],["過ち","あやまち"],["を"],["犯さないなら","おかさないなら"],["、"],["それ"],["は"],["自分","じぶん"],["の"],["全身","ぜんしん"],["を"],["制御","せいぎょ"],["できる"],["完全","かんぜん"],["な"],["人","ひと"],["です"],["。"]]},{"verse":3,"text":"馬を御するには、口にくつわをはめれば、その体全体を意のままに動かすことができます。","tok":[["馬","うま"],["を"],["御する","ぎょする"],["に"],["は"],["、"],["口","くち"],["に"],["くつわ"],["を"],["はめれば"],["、"],["その"],["体","からだ"],["全体","ぜんたい"],["を"],["意","い"],["の"],["まま"],["に"],["動かす","うごかす"],["こと"],["が"],["できます"],["。"]]},{"verse":4,"text":"また、船を御覧なさい。あのように大きくて、強風に吹きまくられている船も、舵取りは、ごく小さい舵で意のままに操ります。","tok":[["また"],["、"],["船","ふね"],["を"],["御覧","ごらん"],["なさい"],["。"],["あの"],["よう"],["に"],["大きくて","おおきくて"],["、"],["強風","きょうふう"],["に"],["吹き","ふき"],["まくられて"],["いる"],["船","ふね"],["も"],["、"],["舵取り","かじとり"],["は"],["、"],["ごく"],["小さい","ちいさい"],["舵","かじ"],["で"],["意","い"],["の"],["まま"],["に"],["操ります","あやつります"],["。"]]},{"verse":5,"text":"同じように、舌は小さな器官ですが、大言壮語するのです。御覧なさい。どんなに小さな火でも大きい森を燃やしてしまう。","tok":[["同じ","おなじ"],["よう"],["に"],["、"],["舌","した"],["は"],["小さな","ちいさな"],["器官","きかん"],["です"],["が"],["、"],["大言","たいげん"],["壮語","そうご"],["する"],["の"],["です"],["。"],["御覧","ごらん"],["なさい"],["。"],["どんな"],["に"],["小さな","ちいさな"],["火","ひ"],["で"],["も"],["大きい","おおきい"],["森","もり"],["を"],["燃やして","もやして"],["しまう"],["。"]]},{"verse":6,"text":"舌は火です。舌は「不義の世界」です。わたしたちの体の器官の一つで、全身を汚し、移り変わる人生を焼き尽くし、自らも地獄の火によって燃やされます。","tok":[["舌","した"],["は"],["火","ひ"],["です"],["。"],["舌","した"],["は"],["「"],["不義","ふぎ"],["の"],["世界","せかい"],["」"],["です"],["。"],["わたしたち"],["の"],["体","からだ"],["の"],["器官","きかん"],["の"],["一","ひと"],["つ"],["で"],["、"],["全身","ぜんしん"],["を"],["汚し","よごし"],["、"],["移り変わる","うつりかわる"],["人生","じんせい"],["を"],["焼き","やき"],["尽くし","つくし"],["、"],["自ら","みずから"],["も"],["地獄","じごく"],["の"],["火","ひ"],["によって"],["燃やされます","もやされます"],["。"]]},{"verse":7,"text":"あらゆる種類の獣や鳥、また這うものや海の生き物は、人間によって制御されていますし、これまでも制御されてきました。","tok":[["あらゆる"],["種類","しゅるい"],["の"],["獣","けもの"],["や"],["鳥","とり"],["、"],["また"],["這う","はう"],["もの"],["や"],["海","うみ"],["の"],["生き物","いきもの"],["は"],["、"],["人間","にんげん"],["によって"],["制御","せいぎょ"],["されて"],["います"],["し"],["、"],["これ"],["まで"],["も"],["制御","せいぎょ"],["されて"],["きました"],["。"]]},{"verse":8,"text":"しかし、舌を制御できる人は一人もいません。舌は、疲れを知らない悪で、死をもたらす毒に満ちています。","tok":[["しかし"],["、"],["舌","した"],["を"],["制御","せいぎょ"],["できる"],["人","ひと"],["は"],["一人","ひとり"],["も"],["いません"],["。"],["舌","した"],["は"],["、"],["疲れ","つかれ"],["を"],["知らない","しらない"],["悪","わる"],["で"],["、"],["死","し"],["を"],["もたらす"],["毒","どく"],["に"],["満ちて","みちて"],["います"],["。"]]},{"verse":9,"text":"わたしたちは舌で、父である主を賛美し、また、舌で、神にかたどって造られた人間を呪います。","tok":[["わたしたち"],["は"],["舌","した"],["で"],["、"],["父","ちち"],["で"],["ある"],["主","ぬし"],["を"],["賛美","さんび"],["し"],["、"],["また"],["、"],["舌","した"],["で"],["、"],["神","かみ"],["に"],["かたどって"],["造られた","つくられた"],["人間","にんげん"],["を"],["呪います","のろいます"],["。"]]},{"verse":10,"text":"同じ口から賛美と呪いが出て来るのです。わたしの兄弟たち、このようなことがあってはなりません。","tok":[["同じ","おなじ"],["口","くち"],["から"],["賛美","さんび"],["と"],["呪い","のろい"],["が"],["出て","でて"],["来る","くる"],["の"],["です"],["。"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["この"],["よう"],["な"],["こと"],["が"],["あって"],["は"],["なりません"],["。"]]},{"verse":11,"text":"泉の同じ穴から、甘い水と苦い水がわき出るでしょうか。","tok":[["泉","いずみ"],["の"],["同じ","おなじ"],["穴","あな"],["から"],["、"],["甘い","あまい"],["水","みず"],["と"],["苦い","にがい"],["水","みず"],["が"],["わき出るでしょう","わきでるでしょう"],["か"],["。"]]},{"verse":12,"text":"わたしの兄弟たち、いちじくの木がオリーブの実を結び、ぶどうの木がいちじくの実を結ぶことができるでしょうか。塩水が甘い水を作ることもできません。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["いちじく"],["の"],["木","き"],["が"],["オリーブ"],["の"],["実","じつ"],["を"],["結び","むすび"],["、"],["ぶどう"],["の"],["木","き"],["が"],["いちじく"],["の"],["実","じつ"],["を"],["結ぶ","むすぶ"],["こと"],["が"],["できるでしょう"],["か"],["。"],["塩水","しおみず"],["が"],["甘い","あまい"],["水","みず"],["を"],["作る","つくる"],["こと"],["も"],["できません"],["。"]]},{"verse":13,"text":"あなたがたの中で、知恵があり分別があるのはだれか。その人は、知恵にふさわしい柔和な行いを、立派な生き方によって示しなさい。","tok":[["あなた"],["がた"],["の"],["中","なか"],["で"],["、"],["知恵","ちえ"],["が"],["あり"],["分別","ぶんべつ"],["が"],["ある"],["の"],["は"],["だれ"],["か"],["。"],["その"],["人","ひと"],["は"],["、"],["知恵","ちえ"],["に"],["ふさわしい"],["柔和","にゅうわ"],["な"],["行い","おこない"],["を"],["、"],["立派","りっぱ"],["な"],["生き方","いきかた"],["によって"],["示し","しめし"],["なさい"],["。"]]},{"verse":14,"text":"しかし、あなたがたは、内心ねたみ深く利己的であるなら、自慢したり、真理に逆らってうそをついたりしてはなりません。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["、"],["内心","ないしん"],["ねたみ"],["深く","ふかく"],["利己的","りこてき"],["で"],["あるなら"],["、"],["自慢","じまん"],["し"],["たり"],["、"],["真理","しんり"],["に"],["逆らって","さからって"],["うそ"],["を"],["つい"],["たり"],["して"],["は"],["なりません"],["。"]]},{"verse":15,"text":"そのような知恵は、上から出たものではなく、地上のもの、この世のもの、悪魔から出たものです。","tok":[["その"],["よう"],["な"],["知恵","ちえ"],["は"],["、"],["上","うえ"],["から"],["出た","でた"],["もの"],["で"],["は"],["なく"],["、"],["地上","ちじょう"],["の"],["もの"],["、"],["この世","このよ"],["の"],["もの"],["、"],["悪魔","あくま"],["から"],["出た","でた"],["もの"],["です"],["。"]]},{"verse":16,"text":"ねたみや利己心のあるところには、混乱やあらゆる悪い行いがあるからです。","tok":[["ねたみ"],["や"],["利己心","りこしん"],["の"],["ある"],["ところ"],["に"],["は"],["、"],["混乱","こんらん"],["や"],["あらゆる"],["悪い","わるい"],["行い","おこない"],["が"],["ある"],["から"],["です"],["。"]]},{"verse":17,"text":"上から出た知恵は、何よりもまず、純真で、更に、温和で、優しく、従順なものです。憐れみと良い実に満ちています。偏見はなく、偽善的でもありません。","tok":[["上","うえ"],["から"],["出た","でた"],["知恵","ちえ"],["は"],["、"],["何","なん"],["より"],["も"],["まず"],["、"],["純真","じゅんしん"],["で"],["、"],["更に","さらに"],["、"],["温和","おんわ"],["で"],["、"],["優しく","やさしく"],["、"],["従順","じゅうじゅん"],["な"],["もの"],["です"],["。"],["憐れみ","あわれみ"],["と"],["良い","よい"],["実","じつ"],["に"],["満ちて","みちて"],["います"],["。"],["偏見","へんけん"],["は"],["なく"],["、"],["偽善","ぎぜん"],["的","てき"],["で"],["も"],["ありません"],["。"]]},{"verse":18,"text":"義の実は、平和を実現する人たちによって、平和のうちに蒔かれるのです。","tok":[["義","ぎ"],["の"],["実","じつ"],["は"],["、"],["平和","へいわ"],["を"],["実現","じつげん"],["する"],["人","ひと"],["たち"],["によって"],["、"],["平和","へいわ"],["の"],["うち"],["に"],["蒔かれる","まかれる"],["の"],["です"],["。"]]}]
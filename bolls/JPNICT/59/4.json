[{"verse":1,"text":"何が原因で、あなたがたの間に戦いや争いが起こるのですか。あなたがた自身の内部で争い合う欲望が、その原因ではありませんか。","tok":[["何","なん"],["が"],["原因","げんいん"],["で"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["に"],["戦い","たたかい"],["や"],["争い","あらそい"],["が"],["起こる","おこる"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["自身","じしん"],["の"],["内部","ないぶ"],["で"],["争い合う","あらそいあう"],["欲望","よくぼう"],["が"],["、"],["その"],["原因","げんいん"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":2,"text":"あなたがたは、欲しても得られず、人を殺します。また、熱望しても手に入れることができず、争ったり戦ったりします。得られないのは、願い求めないからで、","tok":[["あなた"],["がた"],["は"],["、"],["欲して","ほっして"],["も"],["得られず","えられず"],["、"],["人","ひと"],["を"],["殺します","ころします"],["。"],["また"],["、"],["熱望","ねつぼう"],["して"],["も"],["手","て"],["に"],["入れる","いれる"],["こと"],["が"],["できず"],["、"],["争っ","あらそっ"],["たり"],["戦っ","たたかっ"],["たり"],["します"],["。"],["得られない","えられない"],["の"],["は"],["、"],["願い求めない","ねがいもとめない"],["から"],["で"],["、"]]},{"verse":3,"text":"願い求めても、与えられないのは、自分の楽しみのために使おうと、間違った動機で願い求めるからです。","tok":[["願い求めて","ねがいもとめて"],["も"],["、"],["与えられない","あたえられない"],["の"],["は"],["、"],["自分","じぶん"],["の"],["楽しみ","たのしみ"],["の"],["ため"],["に"],["使おう","つかおう"],["と"],["、"],["間違った","まちがった"],["動機","どうき"],["で"],["願い求める","ねがいもとめる"],["から"],["です"],["。"]]},{"verse":4,"text":"神に背いた者たち、世の友となることが、神の敵となることだとは知らないのか。世の友になりたいと願う人はだれでも、神の敵になるのです。","tok":[["神","かみ"],["に"],["背いた","そむいた"],["者","もの"],["たち"],["、"],["世","よ"],["の"],["友","とも"],["と"],["なる"],["こと"],["が"],["、"],["神","かみ"],["の"],["敵","てき"],["と"],["なる"],["こと"],["だ"],["と"],["は"],["知らない","しらない"],["の"],["か"],["。"],["世","よ"],["の"],["友","とも"],["に"],["なりたい"],["と"],["願う","ねがう"],["人","ひと"],["は"],["だれ"],["で"],["も"],["、"],["神","かみ"],["の"],["敵","てき"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":5,"text":"それとも、聖書に次のように書かれているのは意味がないと思うのですか。「神はわたしたちの内に住まわせた霊を、ねたむほどに深く愛しておられ、","tok":[["それ"],["と"],["も"],["、"],["聖書","せいしょ"],["に"],["次","つぎ"],["の"],["よう"],["に"],["書かれて","かかれて"],["いる"],["の"],["は"],["意味","いみ"],["が"],["ない"],["と"],["思う","おもう"],["の"],["です"],["か"],["。"],["「"],["神","かみ"],["は"],["わたしたち"],["の"],["内","うち"],["に"],["住まわせた","すまわせた"],["霊","れい"],["を"],["、"],["ねたむ"],["ほど"],["に"],["深く","ふかく"],["愛して","あいして"],["おられ"],["、"]]},{"verse":6,"text":"もっと豊かな恵みをくださる。」それで、こう書かれています。「神は、高慢な者を敵とし、謙遜な者には恵みをお与えになる。」","tok":[["もっと"],["豊か","ゆたか"],["な"],["恵み","めぐみ"],["を"],["くださる"],["。"],["」"],["それ"],["で"],["、"],["こう"],["書かれて","かかれて"],["います"],["。"],["「"],["神","かみ"],["は"],["、"],["高慢","こうまん"],["な"],["者","もの"],["を"],["敵","てき"],["と"],["し"],["、"],["謙遜","けんそん"],["な"],["者","もの"],["に"],["は"],["恵み","めぐみ"],["を"],["お与え","おあたえ"],["に"],["なる"],["。"],["」"]]},{"verse":7,"text":"だから、神に服従し、悪魔に反抗しなさい。そうすれば、悪魔はあなたがたから逃げて行きます。","tok":[["だ"],["から"],["、"],["神","かみ"],["に"],["服従","ふくじゅう"],["し"],["、"],["悪魔","あくま"],["に"],["反抗","はんこう"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["悪魔","あくま"],["は"],["あなた"],["がた"],["から"],["逃げて","にげて"],["行きます","いきます"],["。"]]},{"verse":8,"text":"神に近づきなさい。そうすれば、神は近づいてくださいます。罪人たち、手を清めなさい。心の定まらない者たち、心を清めなさい。","tok":[["神","かみ"],["に"],["近づき","ちかづき"],["なさい"],["。"],["そう"],["すれば"],["、"],["神","かみ"],["は"],["近づいて","ちかづいて"],["くださいます"],["。"],["罪人","ざいにん"],["たち"],["、"],["手","て"],["を"],["清め","きよめ"],["なさい"],["。"],["心","こころ"],["の"],["定まらない","さだまらない"],["者","もの"],["たち"],["、"],["心","こころ"],["を"],["清め","きよめ"],["なさい"],["。"]]},{"verse":9,"text":"悲しみ、嘆き、泣きなさい。笑いを悲しみに変え、喜びを愁いに変えなさい。","tok":[["悲しみ","かなしみ"],["、"],["嘆き","なげき"],["、"],["泣き","なき"],["なさい"],["。"],["笑い","わらい"],["を"],["悲しみ","かなしみ"],["に"],["変え","かえ"],["、"],["喜び","よろこび"],["を"],["愁い","うれい"],["に"],["変え","かえ"],["なさい"],["。"]]},{"verse":10,"text":"主の前にへりくだりなさい。そうすれば、主があなたがたを高めてくださいます。","tok":[["主","ぬし"],["の"],["前","まえ"],["に"],["へりくだり"],["なさい"],["。"],["そう"],["すれば"],["、"],["主","ぬし"],["が"],["あなた"],["がた"],["を"],["高めて","たかめて"],["くださいます"],["。"]]},{"verse":11,"text":"兄弟たち、悪口を言い合ってはなりません。兄弟の悪口を言ったり、自分の兄弟を裁いたりする者は、律法の悪口を言い、律法を裁くことになります。もし律法を裁くなら、律法の実践者ではなくて、裁き手です。","tok":[["兄弟","きょうだい"],["たち"],["、"],["悪口","わるぐち"],["を"],["言い合って","いいあって"],["は"],["なりません"],["。"],["兄弟","きょうだい"],["の"],["悪口","わるぐち"],["を"],["言っ","いっ"],["たり"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["裁い","さばい"],["たり"],["する"],["者","もの"],["は"],["、"],["律法","りっぽう"],["の"],["悪口","わるぐち"],["を"],["言い","いい"],["、"],["律法","りっぽう"],["を"],["裁く","さばく"],["こと"],["に"],["なります"],["。"],["もし"],["律法","りっぽう"],["を"],["裁くなら","さばくなら"],["、"],["律法","りっぽう"],["の"],["実践者","じっせんしゃ"],["で"],["は"],["なくて"],["、"],["裁き手","さばきて"],["です"],["。"]]},{"verse":12,"text":"律法を定め、裁きを行う方は、おひとりだけです。この方が、救うことも滅ぼすこともおできになるのです。隣人を裁くあなたは、いったい何者なのですか。","tok":[["律法","りっぽう"],["を"],["定め","さだめ"],["、"],["裁き","さばき"],["を"],["行う","おこなう"],["方","かた"],["は"],["、"],["おひとり"],["だけ"],["です"],["。"],["この"],["方","ほう"],["が"],["、"],["救う","すくう"],["こと"],["も"],["滅ぼす","ほろぼす"],["こと"],["も"],["おでき"],["に"],["なる"],["の"],["です"],["。"],["隣人","りんじん"],["を"],["裁く","さばく"],["あなた"],["は"],["、"],["いったい"],["何者","なにもの"],["な"],["の"],["です"],["か"],["。"]]},{"verse":13,"text":"よく聞きなさい。「今日か明日、これこれの町へ行って一年間滞在し、商売をして金もうけをしよう」と言う人たち、","tok":[["よく"],["聞き","きき"],["なさい"],["。"],["「"],["今日","きょう"],["か"],["明日","あす"],["、"],["これ"],["これ"],["の"],["町","まち"],["へ"],["行って","いって"],["一","いち"],["年間","ねんかん"],["滞在","たいざい"],["し"],["、"],["商売","しょうばい"],["を"],["して"],["金もうけ","かねもうけ"],["を"],["しよう"],["」"],["と"],["言う","いう"],["人","ひと"],["たち"],["、"]]},{"verse":14,"text":"あなたがたには自分の命がどうなるか、明日のことは分からないのです。あなたがたは、わずかの間現れて、やがて消えて行く霧にすぎません。","tok":[["あなた"],["がた"],["に"],["は"],["自分","じぶん"],["の"],["命","いのち"],["が"],["どう"],["なる"],["か"],["、"],["明日","あす"],["の"],["こと"],["は"],["分からない","わからない"],["の"],["です"],["。"],["あなた"],["がた"],["は"],["、"],["わずか"],["の"],["間","あいだ"],["現れて","あらわれて"],["、"],["やがて"],["消えて","きえて"],["行く","いく"],["霧","きり"],["に"],["すぎません"],["。"]]},{"verse":15,"text":"むしろ、あなたがたは、「主の御心であれば、生き永らえて、あのことやこのことをしよう」と言うべきです。","tok":[["むしろ"],["、"],["あなた"],["がた"],["は"],["、"],["「"],["主","ぬし"],["の"],["御心","おこころ"],["で"],["あれば"],["、"],["生き永らえて","いきながらえて"],["、"],["あの"],["こと"],["や"],["この"],["こと"],["を"],["しよう"],["」"],["と"],["言うべきです","ゆうべきです"],["。"]]},{"verse":16,"text":"ところが、実際は、誇り高ぶっています。そのような誇りはすべて、悪いことです。","tok":[["ところ"],["が"],["、"],["実際","じっさい"],["は"],["、"],["誇り","ほこり"],["高ぶって","たかぶって"],["います"],["。"],["その"],["よう"],["な"],["誇り","ほこり"],["は"],["すべて"],["、"],["悪い","わるい"],["こと"],["です"],["。"]]},{"verse":17,"text":"人がなすべき善を知りながら、それを行わないのは、その人にとって罪です。","tok":[["人","ひと"],["が"],["なすべき"],["善","ぜん"],["を"],["知り","しり"],["ながら"],["、"],["それ"],["を"],["行わない","おこなわない"],["の"],["は"],["、"],["その"],["人","ひと"],["にとって"],["罪","つみ"],["です"],["。"]]}]
[{"verse":1,"text":"わたしの兄弟たち、栄光に満ちた、わたしたちの主イエス‧キリストを信じながら、人を分け隔てしてはなりません。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["栄光","えいこう"],["に"],["満ちた","みちた"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["を"],["信じ","しんじ"],["ながら"],["、"],["人","ひと"],["を"],["分け隔て","わけへだて"],["して"],["は"],["なりません"],["。"]]},{"verse":2,"text":"あなたがたの集まりに、金の指輪をはめた立派な身なりの人が入って来、また、汚らしい服装の貧しい人も入って来るとします。","tok":[["あなた"],["がた"],["の"],["集まり","あつまり"],["に"],["、"],["金","きん"],["の"],["指輪","ゆびわ"],["を"],["はめた"],["立派","りっぱ"],["な"],["身なり","みなり"],["の"],["人","ひと"],["が"],["入って","はいって"],["来","き"],["、"],["また"],["、"],["汚らしい","きたならしい"],["服装","ふくそう"],["の"],["貧しい","まずしい"],["人","ひと"],["も"],["入って","はいって"],["来る","くる"],["と"],["します"],["。"]]},{"verse":3,"text":"その立派な身なりの人に特別に目を留めて、「あなたは、こちらの席にお掛けください」と言い、貧しい人には、「あなたは、そこに立っているか、わたしの足もとに座るかしていなさい」と言うなら、","tok":[["その"],["立派","りっぱ"],["な"],["身なり","みなり"],["の"],["人","ひと"],["に"],["特別","とくべつ"],["に"],["目","め"],["を"],["留めて","とめて"],["、"],["「"],["あなた"],["は"],["、"],["こちら"],["の"],["席","せき"],["に"],["お掛け","おかけ"],["ください"],["」"],["と"],["言い","いい"],["、"],["貧しい","まずしい"],["人","ひと"],["に"],["は"],["、"],["「"],["あなた"],["は"],["、"],["そこ"],["に"],["立って","たって"],["いる"],["か"],["、"],["わたし"],["の"],["足もと","あしもと"],["に"],["座る","すわる"],["か"],["して"],["い"],["なさい"],["」"],["と"],["言うなら","ゆうなら"],["、"]]},{"verse":4,"text":"あなたがたは、自分たちの中で差別をし、誤った考えに基づいて判断を下したことになるのではありませんか。","tok":[["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["中","なか"],["で"],["差別","さべつ"],["を"],["し"],["、"],["誤った","あやまった"],["考え","かんがえ"],["に"],["基づいて","もとづいて"],["判断","はんだん"],["を"],["下した","くだした"],["こと"],["に"],["なる"],["ので"],["は"],["ありません"],["か"],["。"]]},{"verse":5,"text":"わたしの愛する兄弟たち、よく聞きなさい。神は世の貧しい人たちをあえて選んで、信仰に富ませ、御自身を愛する者に約束された国を、受け継ぐ者となさったではありませんか。","tok":[["わたし"],["の"],["愛する","あいする"],["兄弟","きょうだい"],["たち"],["、"],["よく"],["聞き","きき"],["なさい"],["。"],["神","かみ"],["は"],["世","よ"],["の"],["貧しい","まずしい"],["人","ひと"],["たち"],["を"],["あえて"],["選んで","えらんで"],["、"],["信仰","しんこう"],["に"],["富ませ","とませ"],["、"],["御自身","ごじしん"],["を"],["愛する","あいする"],["者","もの"],["に"],["約束","やくそく"],["された"],["国","くに"],["を"],["、"],["受け継ぐ","うけつぐ"],["者","もの"],["と"],["なさったで"],["は"],["ありません"],["か"],["。"]]},{"verse":6,"text":"だが、あなたがたは、貧しい人を辱めた。富んでいる者たちこそ、あなたがたをひどい目に遭わせ、裁判所へ引っ張って行くではありませんか。","tok":[["だ"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["貧しい","まずしい"],["人","ひと"],["を"],["辱めた","はずかしめた"],["。"],["富んで","とんで"],["いる"],["者","もの"],["たち"],["こそ"],["、"],["あなた"],["がた"],["を"],["ひどい"],["目","め"],["に"],["遭わせ","あわせ"],["、"],["裁判所","さいばんしょ"],["へ"],["引っ張って","ひっぱって"],["行くで","いくで"],["は"],["ありません"],["か"],["。"]]},{"verse":7,"text":"また彼らこそ、あなたがたに与えられたあの尊い名を、冒瀆しているではないですか。","tok":[["また"],["彼","かれ"],["ら"],["こそ"],["、"],["あなた"],["がた"],["に"],["与えられた","あたえられた"],["あの"],["尊い","とうとい"],["名","な"],["を"],["、"],["冒瀆","ぼうとく"],["して"],["いるで"],["は"],["ないです"],["か"],["。"]]},{"verse":8,"text":"もしあなたがたが、聖書に従って、「隣人を自分のように愛しなさい」という最も尊い律法を実行しているのなら、それは結構なことです。","tok":[["もし"],["あなた"],["が"],["た"],["が"],["、"],["聖書","せいしょ"],["に"],["従って","したがって"],["、"],["「"],["隣人","りんじん"],["を"],["自分","じぶん"],["の"],["よう"],["に"],["愛し","あいし"],["なさい"],["」"],["と"],["いう"],["最も","もっとも"],["尊い","とうとい"],["律法","りっぽう"],["を"],["実行","じっこう"],["して"],["いる"],["の"],["なら"],["、"],["それ"],["は"],["結構","けっこう"],["な"],["こと"],["です"],["。"]]},{"verse":9,"text":"しかし、人を分け隔てするなら、あなたがたは罪を犯すことになり、律法によって違犯者と断定されます。","tok":[["しかし"],["、"],["人","ひと"],["を"],["分け隔て","わけへだて"],["するなら"],["、"],["あなた"],["がた"],["は"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["に"],["なり"],["、"],["律法","りっぽう"],["によって"],["違犯者","いはんしゃ"],["と"],["断定","だんてい"],["されます"],["。"]]},{"verse":10,"text":"律法全体を守ったとしても、一つの点でおちどがあるなら、すべての点について有罪となるからです。","tok":[["律法","りっぽう"],["全体","ぜんたい"],["を"],["守った","まもった"],["として"],["も"],["、"],["一","ひと"],["つ"],["の"],["点","てん"],["で"],["おちど"],["が"],["あるなら"],["、"],["すべて"],["の"],["点","てん"],["について"],["有罪","ゆうざい"],["と"],["なる"],["から"],["です"],["。"]]},{"verse":11,"text":"「姦淫するな」と言われた方は、「殺すな」とも言われました。そこで、たとえ姦淫はしなくても、人殺しをすれば、あなたは律法の違犯者になるのです。","tok":[["「"],["姦淫","かんいん"],["する"],["な"],["」"],["と"],["言われた","いわれた"],["方","ほう"],["は"],["、"],["「"],["殺す","ころす"],["な"],["」"],["と"],["も"],["言われました","いわれました"],["。"],["そこ"],["で"],["、"],["たとえ"],["姦淫","かんいん"],["は"],["しなくて"],["も"],["、"],["人殺し","ひとごろし"],["を"],["すれば"],["、"],["あなた"],["は"],["律法","りっぽう"],["の"],["違犯者","いはんしゃ"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":12,"text":"自由をもたらす律法によっていずれは裁かれる者として、語り、またふるまいなさい。","tok":[["自由","じゆう"],["を"],["もたらす"],["律法","りっぽう"],["によって"],["いずれ"],["は"],["裁かれる","さばかれる"],["者","もの"],["として"],["、"],["語り","かたり"],["、"],["また"],["ふるまい"],["なさい"],["。"]]},{"verse":13,"text":"人に憐れみをかけない者には、憐れみのない裁きが下されます。憐れみは裁きに打ち勝つのです。","tok":[["人","ひと"],["に"],["憐れみ","あわれみ"],["を"],["かけない"],["者","もの"],["に"],["は"],["、"],["憐れみ","あわれみ"],["の"],["ない"],["裁き","さばき"],["が"],["下されます","くだされます"],["。"],["憐れみ","あわれみ"],["は"],["裁き","さばき"],["に"],["打ち勝つ","うちかつ"],["の"],["です"],["。"]]},{"verse":14,"text":"わたしの兄弟たち、自分は信仰を持っていると言う者がいても、行いが伴わなければ、何の役に立つでしょうか。そのような信仰が、彼を救うことができるでしょうか。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["自分","じぶん"],["は"],["信仰","しんこう"],["を"],["持って","もって"],["いる"],["と"],["言う","いう"],["者","もの"],["が"],["いて"],["も"],["、"],["行い","おこない"],["が"],["伴わなければ","ともなわなければ"],["、"],["何","なん"],["の"],["役","やく"],["に"],["立つでしょう","たつでしょう"],["か"],["。"],["その"],["よう"],["な"],["信仰","しんこう"],["が"],["、"],["彼","かれ"],["を"],["救う","すくう"],["こと"],["が"],["できるでしょう"],["か"],["。"]]},{"verse":15,"text":"もし、兄弟あるいは姉妹が、着る物もなく、その日の食べ物にも事欠いているとき、","tok":[["もし"],["、"],["兄弟","きょうだい"],["あるいは"],["姉妹","しまい"],["が"],["、"],["着る","きる"],["物","もの"],["も"],["なく"],["、"],["その"],["日","ひ"],["の"],["食べ物","たべもの"],["に"],["も"],["事欠いて","ことかいて"],["いる"],["とき"],["、"]]},{"verse":16,"text":"あなたがたのだれかが、彼らに、「安心して行きなさい。温まりなさい。満腹するまで食べなさい」と言うだけで、体に必要なものを何一つ与えないなら、何の役に立つでしょう。","tok":[["あなた"],["がた"],["の"],["だれ"],["か"],["が"],["、"],["彼","かれ"],["ら"],["に"],["、"],["「"],["安心","あんしん"],["して"],["行き","いき"],["なさい"],["。"],["温まり","あたたまり"],["なさい"],["。"],["満腹","まんぷく"],["する"],["まで"],["食べ","たべ"],["なさい"],["」"],["と"],["言う","いう"],["だけ"],["で"],["、"],["体","からだ"],["に"],["必要","ひつよう"],["な"],["もの"],["を"],["何","なん"],["一","ひと"],["つ"],["与えないなら","あたえないなら"],["、"],["何","なん"],["の"],["役","やく"],["に"],["立つでしょう","たつでしょう"],["。"]]},{"verse":17,"text":"信仰もこれと同じです。行いが伴わないなら、信仰はそれだけでは死んだものです。","tok":[["信仰","しんこう"],["も"],["これ"],["と"],["同じ","おなじ"],["です"],["。"],["行い","おこない"],["が"],["伴わないなら","ともなわないなら"],["、"],["信仰","しんこう"],["は"],["それ"],["だけ"],["で"],["は"],["死んだ","しんだ"],["もの"],["です"],["。"]]},{"verse":18,"text":"しかし、「あなたには信仰があり、わたしには行いがある」と言う人がいるかもしれません。行いの伴わないあなたの信仰を見せなさい。そうすれば、わたしは行いによって、自分の信仰を見せましょう。","tok":[["しかし"],["、"],["「"],["あなた"],["に"],["は"],["信仰","しんこう"],["が"],["あり"],["、"],["わたし"],["に"],["は"],["行い","おこない"],["が"],["ある"],["」"],["と"],["言う","いう"],["人","ひと"],["が"],["いる"],["か"],["も"],["しれません"],["。"],["行い","おこない"],["の"],["伴わない","ともなわない"],["あなた"],["の"],["信仰","しんこう"],["を"],["見せ","みせ"],["なさい"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["行い","おこない"],["によって"],["、"],["自分","じぶん"],["の"],["信仰","しんこう"],["を"],["見せましょう","みせましょう"],["。"]]},{"verse":19,"text":"あなたは「神は唯一だ」と信じている。結構なことだ。悪霊どももそう信じて、おののいています。","tok":[["あなた"],["は"],["「"],["神","かみ"],["は"],["唯一","ゆいいつ"],["だ"],["」"],["と"],["信じて","しんじて"],["いる"],["。"],["結構","けっこう"],["な"],["こと"],["だ"],["。"],["悪霊","あくりょう"],["ども"],["も"],["そう"],["信じて","しんじて"],["、"],["おののいて"],["います"],["。"]]},{"verse":20,"text":"ああ、愚かな者よ、行いの伴わない信仰が役に立たない、ということを知りたいのか。","tok":[["ああ"],["、"],["愚か","おろか"],["な"],["者","もの"],["よ"],["、"],["行い","おこない"],["の"],["伴わない","ともなわない"],["信仰","しんこう"],["が"],["役","やく"],["に"],["立たない","たたない"],["、"],["と"],["いう"],["こと"],["を"],["知りたい","しりたい"],["の"],["か"],["。"]]},{"verse":21,"text":"神がわたしたちの父アブラハムを義とされたのは、息子のイサクを祭壇の上に献げるという行いによってではなかったですか。","tok":[["神","かみ"],["が"],["わたしたち"],["の"],["父","ちち"],["アブラハム"],["を"],["義","ぎ"],["と"],["された"],["の"],["は"],["、"],["息子","むすこ"],["の"],["イサク"],["を"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["献げる","ささげる"],["と"],["いう"],["行い","おこない"],["によって"],["で"],["は"],["なかったです"],["か"],["。"]]},{"verse":22,"text":"アブラハムの信仰がその行いと共に働き、信仰が行いによって完成されたことが、これで分かるでしょう。","tok":[["アブラハム"],["の"],["信仰","しんこう"],["が"],["その"],["行い","おこない"],["と"],["共","とも"],["に"],["働き","はたらき"],["、"],["信仰","しんこう"],["が"],["行い","おこない"],["によって"],["完成","かんせい"],["された"],["こと"],["が"],["、"],["これ"],["で"],["分かるでしょう","わかるでしょう"],["。"]]},{"verse":23,"text":"「アブラハムは神を信じた。それが彼の義と認められた」という聖書の言葉が実現し、彼は神の友と呼ばれたのです。","tok":[["「"],["アブラハム"],["は"],["神","かみ"],["を"],["信じた","しんじた"],["。"],["それ"],["が"],["彼","かれ"],["の"],["義","ぎ"],["と"],["認められた","みとめられた"],["」"],["と"],["いう"],["聖書","せいしょ"],["の"],["言葉","ことば"],["が"],["実現","じつげん"],["し"],["、"],["彼","かれ"],["は"],["神","かみ"],["の"],["友","とも"],["と"],["呼ばれた","よばれた"],["の"],["です"],["。"]]},{"verse":24,"text":"これであなたがたも分かるように、人は行いによって義とされるのであって、信仰だけによるのではありません。","tok":[["これ"],["で"],["あなた"],["がた"],["も"],["分かる","わかる"],["よう"],["に"],["、"],["人","ひと"],["は"],["行い","おこない"],["によって"],["義","ぎ"],["と"],["される"],["ので"],["あって"],["、"],["信仰","しんこう"],["だけ"],["に"],["よる"],["ので"],["は"],["ありません"],["。"]]},{"verse":25,"text":"同様に、娼婦ラハブも、あの使いの者たちを家に迎え入れ、別の道から送り出してやるという行いによって、義とされたではありませんか。","tok":[["同様","どうよう"],["に"],["、"],["娼婦","しょうふ"],["ラハブ"],["も"],["、"],["あの"],["使い","つかい"],["の"],["者","もの"],["たち"],["を"],["家","いえ"],["に"],["迎え入れ","むかえいれ"],["、"],["別","べつ"],["の"],["道","みち"],["から"],["送り出して","おくりだして"],["やる"],["と"],["いう"],["行い","おこない"],["によって"],["、"],["義","ぎ"],["と"],["されたで"],["は"],["ありません"],["か"],["。"]]},{"verse":26,"text":"魂のない肉体が死んだものであるように、行いを伴わない信仰は死んだものです。","tok":[["魂","たましい"],["の"],["ない"],["肉体","にくたい"],["が"],["死んだ","しんだ"],["もの"],["で"],["ある"],["よう"],["に"],["、"],["行い","おこない"],["を"],["伴わない","ともなわない"],["信仰","しんこう"],["は"],["死んだ","しんだ"],["もの"],["です"],["。"]]}]
[{"verse":1,"text":"神と主イエス‧キリストの僕であるヤコブが、離散している十二部族の人たちに挨拶いたします。","tok":[["神","かみ"],["と"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["僕","ぼく"],["で"],["ある"],["ヤコブ"],["が"],["、"],["離散","りさん"],["して"],["いる"],["十二","じゅうに"],["部族","ぶぞく"],["の"],["人","ひと"],["たち"],["に"],["挨拶","あいさつ"],["いたします"],["。"]]},{"verse":2,"text":"わたしの兄弟たち、いろいろな試練に出会うときは、この上ない喜びと思いなさい。","tok":[["わたし"],["の"],["兄弟","きょうだい"],["たち"],["、"],["いろいろ"],["な"],["試練","しれん"],["に"],["出会う","であう"],["とき"],["は"],["、"],["この"],["上","うえ"],["ない"],["喜び","よろこび"],["と"],["思い","おもい"],["なさい"],["。"]]},{"verse":3,"text":"信仰が試されることで忍耐が生じると、あなたがたは知っています。","tok":[["信仰","しんこう"],["が"],["試される","ためされる"],["こと"],["で"],["忍耐","にんたい"],["が"],["生じる","しょうじる"],["と"],["、"],["あなた"],["がた"],["は"],["知って","しって"],["います"],["。"]]},{"verse":4,"text":"あくまでも忍耐しなさい。そうすれば、完全で申し分なく、何一つ欠けたところのない人になります。","tok":[["あくまで"],["も"],["忍耐","にんたい"],["し"],["なさい"],["。"],["そう"],["すれば"],["、"],["完全","かんぜん"],["で"],["申し分","もうしぶん"],["なく"],["、"],["何","なん"],["一","ひと"],["つ"],["欠けた","かけた"],["ところ"],["の"],["ない"],["人","ひと"],["に"],["なります"],["。"]]},{"verse":5,"text":"あなたがたの中で知恵の欠けている人がいれば、だれにでも惜しみなくとがめだてしないでお与えになる神に願いなさい。そうすれば、与えられます。","tok":[["あなた"],["がた"],["の"],["中","なか"],["で"],["知恵","ちえ"],["の"],["欠けて","かけて"],["いる"],["人","ひと"],["が"],["いれば"],["、"],["だれ"],["に"],["で"],["も"],["惜しみなく","おしみなく"],["とがめだて"],["しないで"],["お与え","おあたえ"],["に"],["なる"],["神","かみ"],["に"],["願い","ねがい"],["なさい"],["。"],["そう"],["すれば"],["、"],["与えられます","あたえられます"],["。"]]},{"verse":6,"text":"いささかも疑わず、信仰をもって願いなさい。疑う者は、風に吹かれて揺れ動く海の波に似ています。","tok":[["いささか"],["も"],["疑わず","うたがわず"],["、"],["信仰","しんこう"],["を"],["もって"],["願い","ねがい"],["なさい"],["。"],["疑う","うたがう"],["者","もの"],["は"],["、"],["風","かぜ"],["に"],["吹かれて","ふかれて"],["揺れ動く","ゆれうごく"],["海","うみ"],["の"],["波","なみ"],["に"],["似て","にて"],["います"],["。"]]},{"verse":7,"text":"そういう人は、主から何かいただけると思ってはなりません。","tok":[["そう"],["いう"],["人","ひと"],["は"],["、"],["主","ぬし"],["から"],["何","なん"],["か"],["いただける"],["と"],["思って","おもって"],["は"],["なりません"],["。"]]},{"verse":8,"text":"心が定まらず、生き方全体に安定を欠く人です。","tok":[["心","こころ"],["が"],["定まらず","さだまらず"],["、"],["生き方","いきかた"],["全体","ぜんたい"],["に"],["安定","あんてい"],["を"],["欠く","かく"],["人","ひと"],["です"],["。"]]},{"verse":9,"text":"貧しい兄弟は、自分が高められることを誇りに思いなさい。","tok":[["貧しい","まずしい"],["兄弟","きょうだい"],["は"],["、"],["自分","じぶん"],["が"],["高められる","たかめられる"],["こと"],["を"],["誇り","ほこり"],["に"],["思い","おもい"],["なさい"],["。"]]},{"verse":10,"text":"また、富んでいる者は、自分が低くされることを誇りに思いなさい。富んでいる者は草花のように滅び去るからです。","tok":[["また"],["、"],["富んで","とんで"],["いる"],["者","もの"],["は"],["、"],["自分","じぶん"],["が"],["低く","ひくく"],["される"],["こと"],["を"],["誇り","ほこり"],["に"],["思い","おもい"],["なさい"],["。"],["富んで","とんで"],["いる"],["者","もの"],["は"],["草花","くさばな"],["の"],["よう"],["に"],["滅び去る","ほろびさる"],["から"],["です"],["。"]]},{"verse":11,"text":"日が昇り熱風が吹きつけると、草は枯れ、花は散り、その美しさは失せてしまいます。同じように、富んでいる者も、人生の半ばで消えうせるのです。","tok":[["日","ひ"],["が"],["昇り","のぼり"],["熱風","ねっぷう"],["が"],["吹きつける","ふきつける"],["と"],["、"],["草","くさ"],["は"],["枯れ","かれ"],["、"],["花","はな"],["は"],["散り","ちり"],["、"],["その"],["美し","うつくし"],["さ"],["は"],["失せて","うせて"],["しまいます"],["。"],["同じ","おなじ"],["よう"],["に"],["、"],["富んで","とんで"],["いる"],["者","もの"],["も"],["、"],["人生","じんせい"],["の"],["半ば","なかば"],["で"],["消えうせる","きえうせる"],["の"],["です"],["。"]]},{"verse":12,"text":"試練を耐え忍ぶ人は幸いです。その人は適格者と認められ、神を愛する人々に約束された命の冠をいただくからです。","tok":[["試練","しれん"],["を"],["耐え忍ぶ","たえしのぶ"],["人","ひと"],["は"],["幸い","さいわい"],["です"],["。"],["その"],["人","ひと"],["は"],["適格者","てきかくしゃ"],["と"],["認められ","みとめられ"],["、"],["神","かみ"],["を"],["愛する","あいする"],["人々","ひとびと"],["に"],["約束","やくそく"],["された"],["命","いのち"],["の"],["冠","かんむり"],["を"],["いただく"],["から"],["です"],["。"]]},{"verse":13,"text":"誘惑に遭うとき、だれも、「神に誘惑されている」と言ってはなりません。神は、悪の誘惑を受けるような方ではなく、また、御自分でも人を誘惑したりなさらないからです。","tok":[["誘惑","ゆうわく"],["に"],["遭う","あう"],["とき"],["、"],["だれ"],["も"],["、"],["「"],["神","かみ"],["に"],["誘惑","ゆうわく"],["されて"],["いる"],["」"],["と"],["言って","いって"],["は"],["なりません"],["。"],["神","かみ"],["は"],["、"],["悪","あく"],["の"],["誘惑","ゆうわく"],["を"],["受ける","うける"],["よう"],["な"],["方","かた"],["で"],["は"],["なく"],["、"],["また"],["、"],["御自分","ごじぶん"],["で"],["も"],["人","ひと"],["を"],["誘惑","ゆうわく"],["し"],["たり"],["なさらない"],["から"],["です"],["。"]]},{"verse":14,"text":"むしろ、人はそれぞれ、自分自身の欲望に引かれ、唆されて、誘惑に陥るのです。","tok":[["むしろ"],["、"],["人","ひと"],["は"],["それぞれ"],["、"],["自分","じぶん"],["自身","じしん"],["の"],["欲望","よくぼう"],["に"],["引かれ","ひかれ"],["、"],["唆されて","そそのかされて"],["、"],["誘惑","ゆうわく"],["に"],["陥る","おちいる"],["の"],["です"],["。"]]},{"verse":15,"text":"そして、欲望ははらんで罪を生み、罪が熟して死を生みます。","tok":[["そして"],["、"],["欲望","よくぼう"],["は"],["はらんで"],["罪","つみ"],["を"],["生み","うみ"],["、"],["罪","つみ"],["が"],["熟して","じゅくして"],["死","し"],["を"],["生みます","うみます"],["。"]]},{"verse":16,"text":"わたしの愛する兄弟たち、思い違いをしてはいけません。","tok":[["わたし"],["の"],["愛する","あいする"],["兄弟","きょうだい"],["たち"],["、"],["思い違い","おもいちがい"],["を"],["して"],["は"],["いけません"],["。"]]},{"verse":17,"text":"良い贈り物、完全な賜物はみな、上から、光の源である御父から来るのです。御父には、移り変わりも、天体の動きにつれて生ずる陰もありません。","tok":[["良い","よい"],["贈り物","おくりもの"],["、"],["完全","かんぜん"],["な"],["賜物","たまもの"],["は"],["みな"],["、"],["上","うえ"],["から"],["、"],["光","ひかり"],["の"],["源","みなもと"],["で"],["ある"],["御父","おちち"],["から"],["来る","くる"],["の"],["です"],["。"],["御父","おちち"],["に"],["は"],["、"],["移り変わり","うつりかわり"],["も"],["、"],["天体","てんたい"],["の"],["動き","うごき"],["に"],["つれて"],["生ずる","しょうずる"],["陰","かげ"],["も"],["ありません"],["。"]]},{"verse":18,"text":"御父は、御心のままに、真理の言葉によってわたしたちを生んでくださいました。それは、わたしたちを、いわば造られたものの初穂となさるためです。","tok":[["御父","おちち"],["は"],["、"],["御心","おこころ"],["の"],["まま"],["に"],["、"],["真理","しんり"],["の"],["言葉","ことば"],["によって"],["わたしたち"],["を"],["生んで","うんで"],["くださいました"],["。"],["それ"],["は"],["、"],["わたしたち"],["を"],["、"],["いわば"],["造られた","つくられた"],["もの"],["の"],["初穂","はつほ"],["と"],["なさる"],["ため"],["です"],["。"]]},{"verse":19,"text":"わたしの愛する兄弟たち、よくわきまえていなさい。だれでも、聞くのに早く、話すのに遅く、また怒るのに遅いようにしなさい。","tok":[["わたし"],["の"],["愛する","あいする"],["兄弟","きょうだい"],["たち"],["、"],["よく"],["わきまえて"],["い"],["なさい"],["。"],["だれ"],["で"],["も"],["、"],["聞く","きく"],["のに"],["早く","はやく"],["、"],["話す","はなす"],["のに"],["遅く","おそく"],["、"],["また"],["怒る","おこる"],["のに"],["遅い","おそい"],["よう"],["に"],["し"],["なさい"],["。"]]},{"verse":20,"text":"人の怒りは神の義を実現しないからです。","tok":[["人","ひと"],["の"],["怒り","いかり"],["は"],["神","かみ"],["の"],["義","ぎ"],["を"],["実現","じつげん"],["しない"],["から"],["です"],["。"]]},{"verse":21,"text":"だから、あらゆる汚れやあふれるほどの悪を素直に捨て去り、心に植え付けられた御言葉を受け入れなさい。この御言葉は、あなたがたの魂を救うことができます。","tok":[["だ"],["から"],["、"],["あらゆる"],["汚れ","よごれ"],["や"],["あふれる"],["ほど"],["の"],["悪","あく"],["を"],["素直","すなお"],["に"],["捨て去り","すてさり"],["、"],["心","こころ"],["に"],["植え付けられた","うえつけられた"],["御言葉","おことば"],["を"],["受け入れ","うけいれ"],["なさい"],["。"],["この"],["御言葉","おことば"],["は"],["、"],["あなた"],["がた"],["の"],["魂","たましい"],["を"],["救う","すくう"],["こと"],["が"],["できます"],["。"]]},{"verse":22,"text":"御言葉を行う人になりなさい。自分を欺いて、聞くだけで終わる者になってはいけません。","tok":[["御言葉","おことば"],["を"],["行う","おこなう"],["人","ひと"],["に"],["なり"],["なさい"],["。"],["自分","じぶん"],["を"],["欺いて","あざむいて"],["、"],["聞く","きく"],["だけ"],["で"],["終わる","おわる"],["者","もの"],["に"],["なって"],["は"],["いけません"],["。"]]},{"verse":23,"text":"御言葉を聞くだけで行わない者がいれば、その人は生まれつきの顔を鏡に映して眺める人に似ています。","tok":[["御言葉","おことば"],["を"],["聞く","きく"],["だけ"],["で"],["行わない","おこなわない"],["者","もの"],["が"],["いれば"],["、"],["その"],["人","ひと"],["は"],["生まれつき","うまれつき"],["の"],["顔","かお"],["を"],["鏡","かがみ"],["に"],["映して","うつして"],["眺める","ながめる"],["人","ひと"],["に"],["似て","にて"],["います"],["。"]]},{"verse":24,"text":"鏡に映った自分の姿を眺めても、立ち去ると、それがどのようであったか、すぐに忘れてしまいます。","tok":[["鏡","かがみ"],["に"],["映った","うつった"],["自分","じぶん"],["の"],["姿","すがた"],["を"],["眺めて","ながめて"],["も"],["、"],["立ち去る","たちさる"],["と"],["、"],["それ"],["が"],["どの"],["よう"],["で"],["あった"],["か"],["、"],["すぐ"],["に"],["忘れて","わすれて"],["しまいます"],["。"]]},{"verse":25,"text":"しかし、自由をもたらす完全な律法を一心に見つめ、これを守る人は、聞いて忘れてしまう人ではなく、行う人です。このような人は、その行いによって幸せになります。","tok":[["しかし"],["、"],["自由","じゆう"],["を"],["もたらす"],["完全","かんぜん"],["な"],["律法","りっぽう"],["を"],["一心","いっしん"],["に"],["見つめ","みつめ"],["、"],["これ"],["を"],["守る","まもる"],["人","ひと"],["は"],["、"],["聞いて","きいて"],["忘れて","わすれて"],["しまう"],["人","ひと"],["で"],["は"],["なく"],["、"],["行う","おこなう"],["人","ひと"],["です"],["。"],["この"],["よう"],["な"],["人","ひと"],["は"],["、"],["その"],["行い","おこない"],["によって"],["幸せ","しあわせ"],["に"],["なります"],["。"]]},{"verse":26,"text":"自分は信心深い者だと思っても、舌を制することができず、自分の心を欺くならば、そのような人の信心は無意味です。","tok":[["自分","じぶん"],["は"],["信心","しんじん"],["深い","ふかい"],["者","もの"],["だ"],["と"],["思って","おもって"],["も"],["、"],["舌","した"],["を"],["制する","せいする"],["こと"],["が"],["できず"],["、"],["自分","じぶん"],["の"],["心","こころ"],["を"],["欺くならば","あざむくならば"],["、"],["その"],["よう"],["な"],["人","ひと"],["の"],["信心","しんじん"],["は"],["無意味","むいみ"],["です"],["。"]]},{"verse":27,"text":"みなしごや、やもめが困っているときに世話をし、世の汚れに染まらないように自分を守ること、これこそ父である神の御前に清く汚れのない信心です。","tok":[["みなしご"],["や"],["、"],["やもめ"],["が"],["困って","こまって"],["いる"],["とき"],["に"],["世話","せわ"],["を"],["し"],["、"],["世","よ"],["の"],["汚れ","よごれ"],["に"],["染まらない","そまらない"],["よう"],["に"],["自分","じぶん"],["を"],["守る","まもる"],["こと"],["、"],["これ"],["こそ"],["父","ちち"],["で"],["ある"],["神","かみ"],["の"],["御前","ごぜん"],["に"],["清く","きよく"],["汚れ","よごれ"],["の"],["ない"],["信心","しんじん"],["です"],["。"]]}]
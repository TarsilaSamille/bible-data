[{"verse":1,"text":"祭司たちよ、今あなたたちにこの命令が下される。","tok":[["祭司","さいし"],["たち"],["よ"],["、"],["今","いま"],["あなた"],["たち"],["に"],["この"],["命令","めいれい"],["が"],["下される","くだされる"],["。"]]},{"verse":2,"text":"もし、あなたたちがこれを聞かず、心に留めず、わたしの名に栄光を帰さないなら、と万軍の主は言われる。わたしはあなたたちに呪いを送り、祝福を呪いに変える。いや既に呪いに変えてしまった。これを心に留める者があなたたちの間に一人もいなかったからだ。","tok":[["もし"],["、"],["あなた"],["たち"],["が"],["これ"],["を"],["聞かず","きかず"],["、"],["心","こころ"],["に"],["留めず","とめず"],["、"],["わたし"],["の"],["名","な"],["に"],["栄光","えいこう"],["を"],["帰さないなら","かえさないなら"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["あなた"],["たち"],["に"],["呪い","のろい"],["を"],["送り","おくり"],["、"],["祝福","しゅくふく"],["を"],["呪い","のろい"],["に"],["変える","かえる"],["。"],["いや"],["既に","すでに"],["呪い","のろい"],["に"],["変えて","かえて"],["しまった"],["。"],["これ"],["を"],["心","こころ"],["に"],["留める","とめる"],["者","もの"],["が"],["あなた"],["たち"],["の"],["間","あいだ"],["に"],["一人","ひとり"],["も"],["いなかった"],["から"],["だ"],["。"]]},{"verse":3,"text":"見よ、わたしはあなたたちの子孫を脅かしあなたたちの顔に汚物を浴びせる。それは祭りの犠牲の捨てられたものだ。あなたたちは、その上に投げ捨てられる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["子孫","しそん"],["を"],["脅かし","おびやかし"],["あなた"],["たち"],["の"],["顔","かお"],["に"],["汚物","おぶつ"],["を"],["浴びせる","あびせる"],["。"],["それ"],["は"],["祭り","まつり"],["の"],["犠牲","ぎせい"],["の"],["捨てられた","すてられた"],["もの"],["だ"],["。"],["あなた"],["たち"],["は"],["、"],["その"],["上","うえ"],["に"],["投げ捨てられる","なげすてられる"],["。"]]},{"verse":4,"text":"そのとき、あなたたちは知るようになる。わたしがこの命令を下したのはレビと結んだわが契約を保つためであったことをと万軍の主が言われた。","tok":[["その"],["とき"],["、"],["あなた"],["たち"],["は"],["知る","しる"],["よう"],["に"],["なる"],["。"],["わたし"],["が"],["この"],["命令","めいれい"],["を"],["下した","くだした"],["の"],["は"],["レビ"],["と"],["結んだ","むすんだ"],["わが"],["契約","けいやく"],["を"],["保つ","たもつ"],["ため"],["で"],["あった"],["こと"],["を"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["が"],["言われた","いわれた"],["。"]]},{"verse":5,"text":"レビと結んだわが契約は命と平和のためでありわたしはそれらを彼に与えた。それは畏れをもたらす契約であり彼はわたしを畏れ、わが名のゆえにおののいた。","tok":[["レビ"],["と"],["結んだ","むすんだ"],["わが"],["契約","けいやく"],["は"],["命","いのち"],["と"],["平和","へいわ"],["の"],["ため"],["で"],["あり"],["わたし"],["は"],["それ"],["ら"],["を"],["彼","かれ"],["に"],["与えた","あたえた"],["。"],["それ"],["は"],["畏れ","おそれ"],["を"],["もたらす"],["契約","けいやく"],["で"],["あり"],["彼","かれ"],["は"],["わたし"],["を"],["畏れ","おそれ"],["、"],["わが"],["名","な"],["の"],["ゆえ"],["に"],["おののいた"],["。"]]},{"verse":6,"text":"真理の教えが彼の口にありその唇に偽りは見いだされなかった。彼は平和と正しさのうちに、わたしと共に歩み多くの人々を罪から立ち帰らせた。","tok":[["真理","しんり"],["の"],["教え","おしえ"],["が"],["彼","かれ"],["の"],["口","くち"],["に"],["あり"],["その"],["唇","くちびる"],["に"],["偽り","いつわり"],["は"],["見いだされなかった","みいだされなかった"],["。"],["彼","かれ"],["は"],["平和","へいわ"],["と"],["正し","ただし"],["さ"],["の"],["うち"],["に"],["、"],["わたし"],["と"],["共","とも"],["に"],["歩み","あゆみ"],["多く","おおく"],["の"],["人々","ひとびと"],["を"],["罪","つみ"],["から"],["立ち帰らせた","たちかえらせた"],["。"]]},{"verse":7,"text":"祭司の唇は知識を守り人々は彼の口から教えを求める。彼こそ万軍の主の使者である。","tok":[["祭司","さいし"],["の"],["唇","くちびる"],["は"],["知識","ちしき"],["を"],["守り","まもり"],["人々","ひとびと"],["は"],["彼","かれ"],["の"],["口","くち"],["から"],["教え","おしえ"],["を"],["求める","もとめる"],["。"],["彼","かれ"],["こそ"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["使者","ししゃ"],["で"],["ある"],["。"]]},{"verse":8,"text":"だが、あなたたちは道を踏みはずし教えによって多くの人をつまずかせレビとの契約を破棄してしまったと万軍の主は言われる。","tok":[["だ"],["が"],["、"],["あなた"],["たち"],["は"],["道","みち"],["を"],["踏みはずし","ふみはずし"],["教え","おしえ"],["によって"],["多く","おおく"],["の"],["人","ひと"],["を"],["つまずかせ"],["レビ"],["と"],["の"],["契約","けいやく"],["を"],["破棄","はき"],["して"],["しまった"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"わたしも、あなたたちを民のすべてに軽んじられる価値なき者とした。あなたたちがわたしの道を守らず人を偏り見つつ教えたからだ。","tok":[["わたし"],["も"],["、"],["あなた"],["たち"],["を"],["民","たみ"],["の"],["すべて"],["に"],["軽んじられる","かろんじられる"],["価値","かち"],["なき"],["者","もの"],["と"],["した"],["。"],["あなた"],["たち"],["が"],["わたし"],["の"],["道","みち"],["を"],["守らず","まもらず"],["人","ひと"],["を"],["偏り","かたより"],["見","み"],["つつ"],["教えた","おしえた"],["から"],["だ"],["。"]]},{"verse":10,"text":"我々は皆、唯一の父を持っているではないか。我々を創造されたのは唯一の神ではないか。なぜ、兄弟が互いに裏切り我々の先祖の契約を汚すのか。","tok":[["我々","われわれ"],["は"],["皆","みな"],["、"],["唯一","ゆいいつ"],["の"],["父","ちち"],["を"],["持って","もって"],["いるで"],["は"],["ない"],["か"],["。"],["我々","われわれ"],["を"],["創造","そうぞう"],["された"],["の"],["は"],["唯一","ゆいいつ"],["の"],["神","かみ"],["で"],["は"],["ない"],["か"],["。"],["なぜ"],["、"],["兄弟","きょうだい"],["が"],["互い","たがい"],["に"],["裏切り","うらぎり"],["我々","われわれ"],["の"],["先祖","せんぞ"],["の"],["契約","けいやく"],["を"],["汚す","けがす"],["の"],["か"],["。"]]},{"verse":11,"text":"ユダは裏切りイスラエルとエルサレムでは忌まわしいことが行われている。まことに、ユダは主が慈しんでおられる聖なるものを汚し、異教の神を信じる娘をめとっている。","tok":[["ユダ"],["は"],["裏切り","うらぎり"],["イスラエル"],["と"],["エルサレム"],["で"],["は"],["忌まわしい","いまわしい"],["こと"],["が"],["行われて","おこなわれて"],["いる"],["。"],["まこと"],["に"],["、"],["ユダ"],["は"],["主","ぬし"],["が"],["慈しんで","いつくしんで"],["おられる"],["聖","せい"],["なる"],["もの"],["を"],["汚し","よごし"],["、"],["異教","いきょう"],["の"],["神","かみ"],["を"],["信じる","しんじる"],["娘","むすめ"],["を"],["めとって"],["いる"],["。"]]},{"verse":12,"text":"主よ、このようなことを行う者を、家族もろともヤコブの天幕から絶ち滅ぼしてください。たとえ彼が万軍の主に献げ物をささげたとしても。","tok":[["主","ぬし"],["よ"],["、"],["この"],["よう"],["な"],["こと"],["を"],["行う","おこなう"],["者","もの"],["を"],["、"],["家族","かぞく"],["もろとも"],["ヤコブ"],["の"],["天幕","てんまく"],["から"],["絶ち","たち"],["滅ぼして","ほろぼして"],["ください"],["。"],["たとえ"],["彼","かれ"],["が"],["万","まん"],["軍","ぐん"],["の"],["主に","おもに"],["献げ物","ささげもの"],["を"],["ささげた"],["として"],["も"],["。"]]},{"verse":13,"text":"同様に、あなたたちはこんなことをしている。泣きながら、叫びながら涙をもって主の祭壇を覆っている。もはや、献げ物が見向きもされずあなたたちの手から受け入れられないからだ。","tok":[["同様","どうよう"],["に"],["、"],["あなた"],["たち"],["は"],["こんな"],["こと"],["を"],["して"],["いる"],["。"],["泣き","なき"],["ながら"],["、"],["叫び","さけび"],["ながら"],["涙","なみだ"],["を"],["もって"],["主","ぬし"],["の"],["祭壇","さいだん"],["を"],["覆って","おおって"],["いる"],["。"],["もはや"],["、"],["献げ物","ささげもの"],["が"],["見向き","みむき"],["も"],["されず"],["あなた"],["たち"],["の"],["手","て"],["から"],["受け入れられない","うけいれられない"],["から"],["だ"],["。"]]},{"verse":14,"text":"あなたたちは、なぜかと問うている。それは、主があなたとあなたの若いときの妻との証人となられたのに、あなたが妻を裏切ったからだ。彼女こそ、あなたの伴侶、あなたと契約をした妻である。","tok":[["あなた"],["たち"],["は"],["、"],["なぜ"],["か"],["と"],["問うて","とうて"],["いる"],["。"],["それ"],["は"],["、"],["主","ぬし"],["が"],["あなた"],["と"],["あなた"],["の"],["若い","わかい"],["とき"],["の"],["妻","つま"],["と"],["の"],["証人","しょうにん"],["と"],["なられた"],["のに"],["、"],["あなた"],["が"],["妻","つま"],["を"],["裏切った","うらぎった"],["から"],["だ"],["。"],["彼女","かのじょ"],["こそ"],["、"],["あなた"],["の"],["伴侶","はんりょ"],["、"],["あなた"],["と"],["契約","けいやく"],["を"],["した"],["妻","つま"],["で"],["ある"],["。"]]},{"verse":15,"text":"主は、霊と肉を持つひとつのものを造られたではないか。そのひとつのものが求めるのは、神の民の子孫ではないか。あなたたちは、自分の霊に気をつけるがよい。あなたの若いときの妻を裏切ってはならない。","tok":[["主","ぬし"],["は"],["、"],["霊","れい"],["と"],["肉","にく"],["を"],["持つ","もつ"],["ひと"],["つ"],["の"],["もの"],["を"],["造られたで","つくられたで"],["は"],["ない"],["か"],["。"],["その"],["ひと"],["つ"],["の"],["もの"],["が"],["求める","もとめる"],["の"],["は"],["、"],["神","かみ"],["の"],["民","たみ"],["の"],["子孫","しそん"],["で"],["は"],["ない"],["か"],["。"],["あなた"],["たち"],["は"],["、"],["自分","じぶん"],["の"],["霊","れい"],["に"],["気","き"],["を"],["つける"],["が"],["よい"],["。"],["あなた"],["の"],["若い","わかい"],["とき"],["の"],["妻","つま"],["を"],["裏切って","うらぎって"],["は"],["ならない"],["。"]]},{"verse":16,"text":"わたしは離婚を憎むとイスラエルの神、主は言われる。離婚する人は、不法でその上着を覆っていると万軍の主は言われる。あなたたちは自分の霊に気をつけるがよい。あなたたちは裏切ってはならない。","tok":[["わたし"],["は"],["離婚","りこん"],["を"],["憎む","にくむ"],["と"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["離婚","りこん"],["する"],["人","ひと"],["は"],["、"],["不法","ふほう"],["で"],["その"],["上着","うわぎ"],["を"],["覆って","おおって"],["いる"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["あなた"],["たち"],["は"],["自分","じぶん"],["の"],["霊","れい"],["に"],["気","き"],["を"],["つける"],["が"],["よい"],["。"],["あなた"],["たち"],["は"],["裏切って","うらぎって"],["は"],["ならない"],["。"]]},{"verse":17,"text":"あなたたちは、自分の語る言葉によって主を疲れさせている。それなのに、あなたたちは言うどのように疲れさせたのですか、と。あなたたちが悪を行う者はすべて、主の目に良しとされるとか主は彼らを喜ばれるとか裁きの神はどこにおられるのか、などと言うことによってである。","tok":[["あなた"],["たち"],["は"],["、"],["自分","じぶん"],["の"],["語る","かたる"],["言葉","ことば"],["によって"],["主","ぬし"],["を"],["疲れさせて","つかれさせて"],["いる"],["。"],["それ"],["な"],["のに"],["、"],["あなた"],["たち"],["は"],["言う","いう"],["どの"],["よう"],["に"],["疲れ","つかれ"],["させた"],["の"],["です"],["か"],["、"],["と"],["。"],["あなた"],["たち"],["が"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["は"],["すべて"],["、"],["主","ぬし"],["の"],["目","め"],["に"],["良し","よし"],["と"],["される"],["と"],["か"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["喜ばれる",
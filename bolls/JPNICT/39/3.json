[{"verse":1,"text":"見よ、わたしは使者を送る。彼はわが前に道を備える。あなたたちが待望している主は突如、その聖所に来られる。あなたたちが喜びとしている契約の使者見よ、彼が来る、と万軍の主は言われる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["使者","ししゃ"],["を"],["送る","おくる"],["。"],["彼","かれ"],["は"],["わが"],["前","まえ"],["に"],["道","みち"],["を"],["備える","そなえる"],["。"],["あなた"],["たち"],["が"],["待望","たいぼう"],["して"],["いる"],["主","ぬし"],["は"],["突如","とつじょ"],["、"],["その"],["聖","せい"],["所","しょ"],["に"],["来られる","こられる"],["。"],["あなた"],["たち"],["が"],["喜び","よろこび"],["として"],["いる"],["契約","けいやく"],["の"],["使者","ししゃ"],["見よ","みよ"],["、"],["彼","かれ"],["が"],["来る","くる"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":2,"text":"だが、彼の来る日に誰が身を支えうるか。彼の現れるとき、誰が耐えうるか。彼は精錬する者の火、洗う者の灰汁のようだ。","tok":[["だ"],["が"],["、"],["彼","かれ"],["の"],["来る","くる"],["日","ひ"],["に"],["誰","だれ"],["が"],["身","み"],["を"],["支え","ささえ"],["うる"],["か"],["。"],["彼","かれ"],["の"],["現れる","あらわれる"],["とき"],["、"],["誰","だれ"],["が"],["耐え","たえ"],["うる"],["か"],["。"],["彼","かれ"],["は"],["精錬","せいれん"],["する"],["者","もの"],["の"],["火","ひ"],["、"],["洗う","あらう"],["者","もの"],["の"],["灰汁","あく"],["の"],["よう"],["だ"],["。"]]},{"verse":3,"text":"彼は精錬する者、銀を清める者として座しレビの子らを清め金や銀のように彼らの汚れを除く。彼らが主に献げ物を正しくささげる者となるためである。","tok":[["彼","かれ"],["は"],["精錬","せいれん"],["する"],["者","もの"],["、"],["銀","ぎん"],["を"],["清める","きよめる"],["者","もの"],["として"],["座し","ざし"],["レビ"],["の"],["子","こ"],["ら"],["を"],["清め","きよめ"],["金","きん"],["や"],["銀","ぎん"],["の"],["よう"],["に"],["彼","かれ"],["ら"],["の"],["汚れ","よごれ"],["を"],["除く","のぞく"],["。"],["彼","かれ"],["ら"],["が"],["主に","おもに"],["献げ物","ささげもの"],["を"],["正しく","ただしく"],["ささげる"],["者","もの"],["と"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"そのとき、ユダとエルサレムの献げ物は遠い昔の日々に過ぎ去った年月にそうであったように主にとって好ましいものとなる。","tok":[["その"],["とき"],["、"],["ユダ"],["と"],["エルサレム"],["の"],["献げ物","ささげもの"],["は"],["遠い","とおい"],["昔","むかし"],["の"],["日々","ひび"],["に"],["過ぎ去った","すぎさった"],["年月","としつき"],["に"],["そう"],["で"],["あった"],["よう"],["に"],["主に","おもに"],["とって"],["好ましい","このましい"],["もの"],["と"],["なる"],["。"]]},{"verse":5,"text":"裁きのために、わたしはあなたたちに近づき直ちに告発する。呪術を行う者、姦淫する者、偽って誓う者雇い人の賃金を不正に奪う者寡婦、孤児、寄留者を苦しめる者わたしを畏れぬ者らを、と万軍の主は言われる。","tok":[["裁き","さばき"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["あなた"],["たち"],["に"],["近づき","ちかづき"],["直ちに","ただちに"],["告発","こくはつ"],["する"],["。"],["呪術","じゅじゅつ"],["を"],["行う","おこなう"],["者","もの"],["、"],["姦淫","かんいん"],["する"],["者","もの"],["、"],["偽","にせ"],["って"],["誓う","ちかう"],["者","もの"],["雇い人","やといにん"],["の"],["賃金","ちんぎん"],["を"],["不正","ふせい"],["に"],["奪う","うばう"],["者","もの"],["寡婦","かふ"],["、"],["孤児","こじ"],["、"],["寄留者","きりゅうしゃ"],["を"],["苦しめる","くるしめる"],["者","もの"],["わたし"],["を"],["畏れぬ","おそれぬ"],["者","もの"],["ら"],["を"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"まことに、主であるわたしは変わることがない。あなたたちヤコブの子らにも終わりはない。","tok":[["まこと"],["に"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["は"],["変わる","かわる"],["こと"],["が"],["ない"],["。"],["あなた"],["たち"],["ヤコブ"],["の"],["子","こ"],["ら"],["に"],["も"],["終わり","おわり"],["は"],["ない"],["。"]]},{"verse":7,"text":"あなたたちは先祖の時代からわたしの掟を離れ、それを守らなかった。立ち帰れ、わたしに。そうすれば、わたしもあなたたちに立ち帰ると万軍の主は言われる。しかし、あなたたちは言うどのように立ち帰ればよいのか、と。","tok":[["あなた"],["たち"],["は"],["先祖","せんぞ"],["の"],["時代","じだい"],["から"],["わたし"],["の"],["掟","おきて"],["を"],["離れ","はなれ"],["、"],["それ"],["を"],["守らなかった","まもらなかった"],["。"],["立ち帰れ","たちかえれ"],["、"],["わたし"],["に"],["。"],["そう"],["すれば"],["、"],["わたし"],["も"],["あなた"],["たち"],["に"],["立ち帰る","たちかえる"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["しかし"],["、"],["あなた"],["たち"],["は"],["言う","いう"],["どの"],["よう"],["に"],["立ち帰れば","たちかえれば"],["よい"],["の"],["か"],["、"],["と"],["。"]]},{"verse":8,"text":"人は神を偽りうるか。あなたたちはわたしを偽っていながらどのようにあなたを偽っていますか、と言う。それは、十分の一の献げ物と献納物においてである。","tok":[["人","ひと"],["は"],["神","かみ"],["を"],["偽り","いつわり"],["うる"],["か"],["。"],["あなた"],["たち"],["は"],["わたし"],["を"],["偽って","いつわって"],["い"],["ながら"],["どの"],["よう"],["に"],["あなた"],["を"],["偽って","いつわって"],["います"],["か"],["、"],["と"],["言う","ゆう"],["。"],["それ"],["は"],["、"],["十分","じゅうぶん"],["の"],["一","いち"],["の"],["献げ物","ささげもの"],["と"],["献納物","けんのうぶつ"],["に"],["おいて"],["で"],["ある"],["。"]]},{"verse":9,"text":"あなたたちは、甚だしく呪われる。あなたたちは民全体で、わたしを偽っている。","tok":[["あなた"],["たち"],["は"],["、"],["甚だしく","はなはだしく"],["呪われる","のろわれる"],["。"],["あなた"],["たち"],["は"],["民","みん"],["全体","ぜんたい"],["で"],["、"],["わたし"],["を"],["偽って","いつわって"],["いる"],["。"]]},{"verse":10,"text":"十分の一の献げ物をすべて倉に運びわたしの家に食物があるようにせよ。これによって、わたしを試してみよと万軍の主は言われる。必ず、わたしはあなたたちのために天の窓を開き祝福を限りなく注ぐであろう。","tok":[["十分","じゅうぶん"],["の"],["一","いち"],["の"],["献げ物","ささげもの"],["を"],["すべて"],["倉","くら"],["に"],["運び","はこび"],["わたし"],["の"],["家","いえ"],["に"],["食物","しょくもつ"],["が"],["ある"],["よう"],["に"],["せよ"],["。"],["これ"],["によって"],["、"],["わたし"],["を"],["試して","ためして"],["みよ"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["必ず","かならず"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["ため"],["に"],["天","てん"],["の"],["窓","まど"],["を"],["開き","ひらき"],["祝福","しゅくふく"],["を"],["限りなく","かぎりなく"],["注ぐで","そそぐで"],["あろう"],["。"]]},{"verse":11,"text":"また、わたしはあなたたちのために食い荒らすいなごを滅ぼしてあなたたちの土地の作物が荒らされず畑のぶどうが不作とならぬようにすると万軍の主は言われる。","tok":[["また"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["ため"],["に"],["食い荒らす","くいあらす"],["いなご"],["を"],["滅ぼして","ほろぼして"],["あなた"],["たち"],["の"],["土地","とち"],["の"],["作物","さくもつ"],["が"],["荒らされず","あらされず"],["畑","はたけ"],["の"],["ぶどう"],["が"],["不作","ふさく"],["と"],["ならぬ"],["よう"],["に"],["する"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"諸国の民は皆、あなたたちを幸せな者と呼ぶ。あなたたちが喜びの国となるからだと万軍の主は言われる。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["は"],["皆","みな"],["、"],["あなた"],["たち"],["を"],["幸せ","しあわせ"],["な"],["者","もの"],["と"],["呼ぶ","よぶ"],["。"],["あなた"],["たち"],["が"],["喜び","よろこび"],["の"],["国","くに"],["と"],["なる"],["から"],["だ"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"あなたたちは、わたしにひどい言葉を語っている、と主は言われる。ところが、あなたたちは言うどんなことをあなたに言いましたか、と。","tok":[["あなた"],["たち"],["は"],["、"],["わたし"],["に"],["ひどい"],["言葉","ことば"],["を"],["語って","かたって"],["いる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["ところ"],["が"],["、"],["あなた"],["たち"],["は"],["言う","いう"],["どんな"],["こと"],["を"],["あなた"],["に"],["言いました","いいました"],["か"],["、"],["と"],["。"]]},{"verse":14,"text":"あなたたちは言っている。「神に仕えることはむなしい。たとえ、その戒
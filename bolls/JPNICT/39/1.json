[{"verse":1,"text":"託宣。マラキによってイスラエルに臨んだ主の言葉。","tok":[["託宣","たくせん"],["。"],["マラキ"],["によって"],["イスラエル"],["に"],["臨んだ","のぞんだ"],["主","ぬし"],["の"],["言葉","ことば"],["。"]]},{"verse":2,"text":"わたしはあなたたちを愛してきたと主は言われる。しかし、あなたたちは言うどのように愛を示してくださったのか、と。エサウはヤコブの兄ではないかと主は言われる。しかし、わたしはヤコブを愛し","tok":[["わたし"],["は"],["あなた"],["たち"],["を"],["愛して","あいして"],["きた"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["しかし"],["、"],["あなた"],["たち"],["は"],["言う","いう"],["どの"],["よう"],["に"],["愛","あい"],["を"],["示して","しめして"],["くださった"],["の"],["か"],["、"],["と"],["。"],["エサウ"],["は"],["ヤコブ"],["の"],["兄","あに"],["で"],["は"],["ない"],["か"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["しかし"],["、"],["わたし"],["は"],["ヤコブ"],["を"],["愛し","あいし"]]},{"verse":3,"text":"エサウを憎んだ。わたしは彼の山を荒廃させ彼の嗣業を荒れ野のジャッカルのものとした。","tok":[["エサウ"],["を"],["憎んだ","にくんだ"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["山","やま"],["を"],["荒廃","こうはい"],["させ"],["彼","かれ"],["の"],["嗣業","しぎょう"],["を"],["荒れ野","あれの"],["の"],["ジャッカル"],["の"],["もの"],["と"],["した"],["。"]]},{"verse":4,"text":"たとえエドムが、我々は打ちのめされたが廃虚を建て直す、と言っても万軍の主はこう言われるたとえ、彼らが建て直してもわたしはそれを破壊する、と。人々はそれを悪の領域と呼びとこしえに、主の怒りを受けた民と呼ぶ。","tok":[["たとえ"],["エドム"],["が"],["、"],["我々","われわれ"],["は"],["打ちのめされた","うちのめされた"],["が"],["廃虚","はいきょ"],["を"],["建て直す","たてなおす"],["、"],["と"],["言って","いって"],["も"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["たとえ"],["、"],["彼","かれ"],["ら"],["が"],["建て直して","たてなおして"],["も"],["わたし"],["は"],["それ"],["を"],["破壊","はかい"],["する"],["、"],["と"],["。"],["人々","ひとびと"],["は"],["それ"],["を"],["悪","あく"],["の"],["領域","りょういき"],["と"],["呼び","よび"],["とこしえ"],["に"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["を"],["受けた","うけた"],["民","たみ"],["と"],["呼ぶ","よぶ"],["。"]]},{"verse":5,"text":"あなたたちは、自分の目で見はっきりと言うべきである主はイスラエルの境を越えて大いなる方である、と。","tok":[["あなた"],["たち"],["は"],["、"],["自分","じぶん"],["の"],["目","め"],["で"],["見","み"],["はっきり"],["と"],["言うべきで","ゆうべきで"],["ある"],["主","ぬし"],["は"],["イスラエル"],["の"],["境","さかい"],["を"],["越えて","こえて"],["大いなる","おおいなる"],["方","かた"],["で"],["ある"],["、"],["と"],["。"]]},{"verse":6,"text":"子は父を、僕は主人を敬うものだ。しかし、わたしが父であるならわたしに対する尊敬はどこにあるのか。わたしが主人であるならわたしに対する畏れはどこにあるのかと万軍の主はあなたたちに言われる。わたしの名を軽んずる祭司たちよあなたたちは言う我々はどのようにして御名を軽んじましたか、と。","tok":[["子","こ"],["は"],["父","ちち"],["を"],["、"],["僕","ぼく"],["は"],["主人","しゅじん"],["を"],["敬う","うやまう"],["もの"],["だ"],["。"],["しかし"],["、"],["わたし"],["が"],["父","ちち"],["で"],["あるなら"],["わたし"],["に"],["対する","たいする"],["尊敬","そんけい"],["は"],["どこ"],["に"],["ある"],["の"],["か"],["。"],["わたし"],["が"],["主人","しゅじん"],["で"],["あるなら"],["わたし"],["に"],["対する","たいする"],["畏れ","おそれ"],["は"],["どこ"],["に"],["ある"],["の"],["か"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["あなた"],["たち"],["に"],["言われる","いわれる"],["。"],["わたし"],["の"],["名","な"],["を"],["軽んずる","かろんずる"],["祭司","さいし"],["たち"],["よ"],["あなた"],["たち"],["は"],["言う","いう"],["我々","われわれ"],["は"],["どの"],["よう"],["に"],["して"],["御名","ぎょめい"],["を"],["軽んじました","かろんじました"],["か"],["、"],["と"],["。"]]},{"verse":7,"text":"あなたたちは、わたしの祭壇に汚れたパンをささげておきながら我々はどのようにしてあなたを汚しましたか、と言う。しかも、あなたたちは主の食卓は軽んじられてもよい、と言う。","tok":[["あなた"],["たち"],["は"],["、"],["わたし"],["の"],["祭壇","さいだん"],["に"],["汚れた","よごれた"],["パン"],["を"],["ささげて"],["おき"],["ながら"],["我々","われわれ"],["は"],["どの"],["よう"],["に"],["して"],["あなた"],["を"],["汚しました","よごしました"],["か"],["、"],["と"],["言う","ゆう"],["。"],["しかも"],["、"],["あなた"],["たち"],["は"],["主","ぬし"],["の"],["食卓","しょくたく"],["は"],["軽んじられて","かろんじられて"],["も"],["よい"],["、"],["と"],["言う","ゆう"],["。"]]},{"verse":8,"text":"あなたたちが目のつぶれた動物をいけにえとしてささげても、悪ではないのか。足が傷ついたり、病気である動物をささげても悪ではないのか。それを総督に献上してみよ。彼はあなたを喜び、受け入れるだろうかと万軍の主は言われる。","tok":[["あなた"],["たち"],["が"],["目","め"],["の"],["つぶれた"],["動物","どうぶつ"],["を"],["いけにえ"],["として"],["ささげて"],["も"],["、"],["悪","わる"],["で"],["は"],["ない"],["の"],["か"],["。"],["足","あし"],["が"],["傷つい","きずつい"],["たり"],["、"],["病気","びょうき"],["で"],["ある"],["動物","どうぶつ"],["を"],["ささげて"],["も"],["悪","わる"],["で"],["は"],["ない"],["の"],["か"],["。"],["それ"],["を"],["総督","そうとく"],["に"],["献上","けんじょう"],["して"],["み"],["よ"],["。"],["彼","かれ"],["は"],["あなた"],["を"],["喜び","よろこび"],["、"],["受け入れるだろう","うけいれるだろう"],["か"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"今、神が恵みを与えられるようひたすら神に赦しを願うがよい。これは、あなたたちが自ら行ったことだ。神はあなたたちの誰かを受け入れてくださるだろうかと万軍の主は言われる。","tok":[["今","いま"],["、"],["神","かみ"],["が"],["恵み","めぐみ"],["を"],["与えられる","あたえられる"],["よう"],["ひたすら"],["神","かみ"],["に"],["赦し","ゆるし"],["を"],["願う","ねがう"],["が"],["よい"],["。"],["これ"],["は"],["、"],["あなた"],["たち"],["が"],["自ら","みずから"],["行った","いった"],["こと"],["だ"],["。"],["神","かみ"],["は"],["あなた"],["たち"],["の"],["誰","だれ"],["か"],["を"],["受け入れて","うけいれて"],["くださるだろう"],["か"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":10,"text":"あなたたちのうち誰か、わが祭壇にいたずらに火が点じられることがないよう戸を閉じる者はいないのか。わたしはあなたたちを喜ぶことはできないと万軍の主は言われる。わたしは献げ物をあなたたちの手から受け入れはしない。","tok":[["あなた"],["たち"],["の"],["うち"],["誰","だれ"],["か"],["、"],["わが"],["祭壇","さいだん"],["に"],["いたずら"],["に"],["火","ひ"],["が"],["点じられる","てんじられる"],["こと"],["が"],["ない"],["よう"],["戸","と"],["を"],["閉じる","とじる"],["者","もの"],["は"],["いない"],["の"],["か"],["。"],["わたし"],["は"],["あなた"],["たち"],["を"],["喜ぶ","よろこぶ"],["こと"],["は"],["できない"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["献げ物","ささげもの"],["を"],["あなた"],["たち"],["の"],["手","て"],["から"],["受け入れ","うけいれ"],["は"],["しない"],["。"]]},{"verse":11,"text":"日の出る所から日の入る所まで、諸国の間でわが名はあがめられ、至るところでわが名のために香がたかれ、清い献げ物がささげられている。わが名は諸国の間であがめられているからだ、と万軍の主は言われる。","tok":[["日","ひ"],["の"],["出る","でる"],["所","ところ"],["から"],["日","ひ"],["の"],["入る","はいる"],["所","ところ"],["まで"],["、"],["諸国","しょこく"],["の"],["間","あいだ"],["で"],["わが"],["名","な"],["は"],["あがめられ"],["、"],["至る","いたる"],["ところ"],["で"],["わが"],["名","な"],["の"],["ため"],["に"],["香","こう"],["がたかれ"],["、"],["清い","きよい"],["献げ物","ささげもの"],["が"],["ささげられて"],["いる"],["。"],["わが"],["名","な"],["は"],["諸国","しょこく"],["の"],["間","あいだ"],["で"],["あがめられて"],["いる"],["から"],["だ"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"それなのに、あなたたちは主の食卓は汚されてもよい、その食卓の果実は食物として軽んじられてもよいと言って、御名を冒瀆している。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["たち"],["は"],["主","ぬし"],["の"],["食卓","しょくたく"],["は"],["汚されて","よごされて"],["も"],["よい"],["、"],["その"],["食卓","しょくたく"],["の"],["果実","かじつ"],["は"],["食物","しょくもつ"],["として"],["軽んじられて","かろんじられて"],["も"],["よい"],["と"],["言って","いって"],["、"],["御名","ぎょめい"],["を"],["冒瀆","ぼうとく"],["して"],["いる"],["。"]]},{"verse":13,"text":"また、なんと煩わしいことかと言って、わたしをさげすんでいる、と万軍の主は言われる。あなたたちが盗んできた動物、足の傷ついた動物、病気の動物などを献げ物として携えてきているのに、わたしはあなたたちの手からそれを快く受け入れうるだろうか、と主は言われる。","tok":[["また"],["、"],["なん"],["と"],["煩わしい","わずらわしい"],["こと"],["か"],["と"],["言って","いって"],["、"],["わたし"],["を"],["さげすんで"],["いる"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["あなた"],["たち"],["が"],["盗んで","ぬすんで"],["きた"],["動物","どうぶつ"],["、"],["足","あし"],["の"],["傷ついた","きずついた"],["動物","どうぶつ"],["、"],["病気","びょうき"],["の"],["動物","どうぶつ"],["など"],["を"],["献げ物","ささげもの"],["として"],["携えて","たずさえて"],["きて"],["いる"],["のに"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["手","て"],["から"],["それ"],["を"],["快く","こころよく"],["受け入れ","うけいれ"],["うるだろう"],["か"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"群れの中に傷のない雄の動物を持っており、それをささげると誓いながら、傷のあるものを主にささげる偽り者は呪われよ。わたしは大いなる王で、わたしの名は諸国の間で畏れられている、と万軍の主は言われる。","tok":[["群れ","むれ"],["の"],["中","なか"],["に"],["傷","きず"],["の"],["ない"],["雄","おす"],["の"],["動物","どうぶつ"],["を"],["持って","もって"],["おり"],["、"],["それ"],["を"],["ささげる"],["と"],["誓い","ちかい"],["ながら"],["、"],["傷","きず"],["の"],["ある"],["もの"],["を"],["主に","おもに"],["ささげる"],["偽り者","いつわりしゃ"],["は"],["呪われ","のろわれ"],["よ"],["。"],["わたし"],["は"],["大いなる","おおいなる"],["王","おう"],["で"],["、"],["わたし"],["の"],["名","な"],["は"],["諸国","しょこく"],["の"],["間","あいだ"],["で"],["畏れられて","おそれられて"],["いる"],["、"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
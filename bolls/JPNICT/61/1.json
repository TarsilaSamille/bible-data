[{"verse":1,"text":"イエス‧キリストの僕であり、使徒であるシメオン‧ペトロから、わたしたちの神と救い主イエス‧キリストの義によって、わたしたちと同じ尊い信仰を受けた人たちへ。","tok":[["イエス"],["‧"],["キリスト"],["の"],["僕","ぼく"],["で"],["あり"],["、"],["使徒","しと"],["で"],["ある"],["シメオン"],["‧"],["ペトロ"],["から"],["、"],["わたしたち"],["の"],["神","かみ"],["と"],["救い主","すくいぬし"],["イエス"],["‧"],["キリスト"],["の"],["義","ぎ"],["によって"],["、"],["わたしたち"],["と"],["同じ","おなじ"],["尊い","とうとい"],["信仰","しんこう"],["を"],["受けた","うけた"],["人","ひと"],["たち"],["へ"],["。"]]},{"verse":2,"text":"神とわたしたちの主イエスを知ることによって、恵みと平和が、あなたがたにますます豊かに与えられるように。","tok":[["神","かみ"],["と"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["を"],["知る","しる"],["こと"],["によって"],["、"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ますます"],["豊か","ゆたか"],["に"],["与えられる","あたえられる"],["よう"],["に"],["。"]]},{"verse":3,"text":"主イエスは、御自分の持つ神の力によって、命と信心とにかかわるすべてのものを、わたしたちに与えてくださいました。それは、わたしたちを御自身の栄光と力ある業とで召し出してくださった方を認識させることによるのです。","tok":[["主","しゅ"],["イエス"],["は"],["、"],["御自分","ごじぶん"],["の"],["持つ","もつ"],["神","かみ"],["の"],["力","ちから"],["によって"],["、"],["命","いのち"],["と"],["信心","しんじん"],["と"],["に"],["かかわる"],["すべて"],["の"],["もの"],["を"],["、"],["わたしたち"],["に"],["与えて","あたえて"],["くださいました"],["。"],["それ"],["は"],["、"],["わたしたち"],["を"],["御自身","ごじしん"],["の"],["栄光","えいこう"],["と"],["力","ちから"],["ある"],["業","ぎょう"],["と"],["で"],["召し出して","めしだして"],["くださった"],["方","ほう"],["を"],["認識","にんしき"],["させる"],["こと"],["に"],["よる"],["の"],["です"],["。"]]},{"verse":4,"text":"この栄光と力ある業とによって、わたしたちは尊くすばらしい約束を与えられています。それは、あなたがたがこれらによって、情欲に染まったこの世の退廃を免れ、神の本性にあずからせていただくようになるためです。","tok":[["この"],["栄光","えいこう"],["と"],["力","ちから"],["ある"],["業","ぎょう"],["と"],["によって"],["、"],["わたしたち"],["は"],["尊く","とうとく"],["すばらしい"],["約束","やくそく"],["を"],["与えられて","あたえられて"],["います"],["。"],["それ"],["は"],["、"],["あなた"],["がた"],["が"],["これ"],["ら"],["によって"],["、"],["情欲","じょうよく"],["に"],["染まった","そまった"],["この世","このよ"],["の"],["退廃","たいはい"],["を"],["免れ","まぬがれ"],["、"],["神","かみ"],["の"],["本性","ほんしょう"],["に"],["あずからせて"],["いただく"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":5,"text":"だから、あなたがたは、力を尽くして信仰には徳を、徳には知識を、","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["力","ちから"],["を"],["尽くして","つくして"],["信仰","しんこう"],["に"],["は"],["徳","とく"],["を"],["、"],["徳","とく"],["に"],["は"],["知識","ちしき"],["を"],["、"]]},{"verse":6,"text":"知識には自制を、自制には忍耐を、忍耐には信心を、","tok":[["知識","ちしき"],["に"],["は"],["自制","じせい"],["を"],["、"],["自制","じせい"],["に"],["は"],["忍耐","にんたい"],["を"],["、"],["忍耐","にんたい"],["に"],["は"],["信心","しんじん"],["を"],["、"]]},{"verse":7,"text":"信心には兄弟愛を、兄弟愛には愛を加えなさい。","tok":[["信心","しんじん"],["に"],["は"],["兄弟","きょうだい"],["愛","あい"],["を"],["、"],["兄弟","きょうだい"],["愛","あい"],["に"],["は"],["愛","あい"],["を"],["加え","くわえ"],["なさい"],["。"]]},{"verse":8,"text":"これらのものが備わり、ますます豊かになるならば、あなたがたは怠惰で実を結ばない者とはならず、わたしたちの主イエス‧キリストを知るようになるでしょう。","tok":[["これ"],["ら"],["の"],["もの"],["が"],["備わり","そなわり"],["、"],["ますます"],["豊か","ゆたか"],["に"],["なるならば"],["、"],["あなた"],["がた"],["は"],["怠惰","たいだ"],["で"],["実","じつ"],["を"],["結ばない","むすばない"],["者","もの"],["と"],["は"],["ならず"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["を"],["知る","しる"],["よう"],["に"],["なるでしょう"],["。"]]},{"verse":9,"text":"これらを備えていない者は、視力を失っています。近くのものしか見えず、以前の罪が清められたことを忘れています。","tok":[["これ"],["ら"],["を"],["備えて","そなえて"],["いない"],["者","もの"],["は"],["、"],["視力","しりょく"],["を"],["失って","うしなって"],["います"],["。"],["近く","ちかく"],["の"],["もの"],["しか"],["見えず","みえず"],["、"],["以前","いぜん"],["の"],["罪","つみ"],["が"],["清められた","きよめられた"],["こと"],["を"],["忘れて","わすれて"],["います"],["。"]]},{"verse":10,"text":"だから兄弟たち、召されていること、選ばれていることを確かなものとするように、いっそう努めなさい。これらのことを実践すれば、決して罪に陥りません。","tok":[["だ"],["から"],["兄弟","きょうだい"],["たち"],["、"],["召されて","めされて"],["いる"],["こと"],["、"],["選ばれて","えらばれて"],["いる"],["こと"],["を"],["確か","たしか"],["な"],["もの"],["と"],["する"],["よう"],["に"],["、"],["いっそう"],["努め","つとめ"],["なさい"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["実践","じっせん"],["すれば"],["、"],["決して","けっして"],["罪","つみ"],["に"],["陥りません","おちいりません"],["。"]]},{"verse":11,"text":"こうして、わたしたちの主、救い主イエス‧キリストの永遠の御国に確かに入ることができるようになります。","tok":[["こう"],["して"],["、"],["わたしたち"],["の"],["主","ぬし"],["、"],["救い主","すくいぬし"],["イエス"],["‧"],["キリスト"],["の"],["永遠","えいえん"],["の"],["御国","おくに"],["に"],["確か","たしか"],["に"],["入る","はいる"],["こと"],["が"],["できる"],["よう"],["に"],["なります"],["。"]]},{"verse":12,"text":"従って、わたしはいつも、これらのことをあなたがたに思い出させたいのです。あなたがたは既に知っているし、授かった真理に基づいて生活しているのですが。","tok":[["従って","したがって"],["、"],["わたし"],["は"],["いつも"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["あなた"],["がた"],["に"],["思い出させたい","おもいださせたい"],["の"],["です"],["。"],["あなた"],["がた"],["は"],["既に","すでに"],["知って","しって"],["いる"],["し"],["、"],["授かった","さずかった"],["真理","しんり"],["に"],["基づいて","もとづいて"],["生活","せいかつ"],["して"],["いる"],["の"],["です"],["が"],["。"]]},{"verse":13,"text":"わたしは、自分がこの体を仮の宿としている間、あなたがたにこれらのことを思い出させて、奮起させるべきだと考えています。","tok":[["わたし"],["は"],["、"],["自分","じぶん"],["が"],["この"],["体","からだ"],["を"],["仮","かり"],["の"],["宿","やど"],["として"],["いる"],["間","あいだ"],["、"],["あなた"],["がた"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["思い出させて","おもいださせて"],["、"],["奮起","ふんき"],["させるべきだ"],["と"],["考えて","かんがえて"],["います"],["。"]]},{"verse":14,"text":"わたしたちの主イエス‧キリストが示してくださったように、自分がこの仮の宿を間もなく離れなければならないことを、わたしはよく承知しているからです。","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["が"],["示して","しめして"],["くださった"],["よう"],["に"],["、"],["自分","じぶん"],["が"],["この"],["仮","かり"],["の"],["宿","やど"],["を"],["間","ま"],["も"],["なく"],["離れなければ","はなれなければ"],["ならない"],["こと"],["を"],["、"],["わたし"],["は"],["よく"],["承知","しょうち"],["して"],["いる"],["から"],["です"],["。"]]},{"verse":15,"text":"自分が世を去った後もあなたがたにこれらのことを絶えず思い出してもらうように、わたしは努めます。","tok":[["自分","じぶん"],["が"],["世","よ"],["を"],["去った","さった"],["後","あと"],["も"],["あなた"],["がた"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["絶えず","たえず"],["思い出して","おもいだして"],["もらう"],["よう"],["に"],["、"],["わたし"],["は"],["努めます","つとめます"],["。"]]},{"verse":16,"text":"わたしたちの主イエス‧キリストの力に満ちた来臨を知らせるのに、わたしたちは巧みな作り話を用いたわけではありません。わたしたちは、キリストの威光を目撃したのです。","tok":[["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["力","ちから"],["に"],["満ちた","みちた"],["来臨","らいりん"],["を"],["知らせる","しらせる"],["のに"],["、"],["わたしたち"],["は"],["巧み","たくみ"],["な"],["作り話","つくりばなし"],["を"],["用いた","もちいた"],["わけ"],["で"],["は"],["ありません"],["。"],["わたしたち"],["は"],["、"],["キリスト"],["の"],["威光","いこう"],["を"],["目撃","もくげき"],["した"],["の"],["です"],["。"]]},{"verse":17,"text":"荘厳な栄光の中から、「これはわたしの愛する子。わたしの心に適う者」というような声があって、主イエスは父である神から誉れと栄光をお受けになりました。","tok":[["荘厳","そうごん"],["な"],["栄光","えいこう"],["の"],["中","なか"],["から"],["、"],["「"],["これ"],["は"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["。"],["わたし"],["の"],["心","こころ"],["に"],["適う","かなう"],["者","もの"],["」"],["と"],["いう"],["よう"],["な"],["声","こえ"],["が"],["あって"],["、"],["主","しゅ"],["イエス"],["は"],["父","ちち"],["で"],["ある"],["神","かみ"],["から"],["誉れ","ほまれ"],["と"],["栄光","えいこう"],["を"],["お受け","おうけ"],["に"],["なりました"],["。"]]},{"verse":18,"text":"わたしたちは、聖なる山にイエスといたとき、天から響いてきたこの声を聞いたのです。","tok":[["わたしたち"],["は"],["、"],["聖","せい"],["なる"],["山","やま"],["に"],["イエス"],["と"],["いた"],["とき"],["、"],["天","てん"],["から"],["響いて","ひびいて"],["きた"],["この"],["声","こえ"],["を"],["聞いた","きいた"],["の"],["です"],["。"]]},{"verse":19,"text":"こうして、わたしたちには、預言の言葉はいっそう確かなものとなっています。夜が明け、明けの明星があなたがたの心の中に昇るときまで、暗い所に輝くともし火として、どうかこの預言の言葉に留意していてください。","tok":[["こう"],["して"],["、"],["わたしたち"],["に"],["は"],["、"],["預言","よげん"],["の"],["言葉","ことば"],["は"],["いっそう"],["確か","たしか"],["な"],["もの"],["と"],["なって"],["います"],["。"],["夜","よる"],["が"],["明け","あけ"],["、"],["明け","あけ"],["の"],["明星","みょうじょう"],["が"],["あなた"],["がた"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["昇る","のぼる"],["とき"],["まで"],["、"],["暗い","くらい"],["所","ところ"],["に"],["輝く","かがやく"],["ともし火","ともしび"],["として"],["、"],["どう"],["か"],["この"],["預言","よげん"],["の"],["言葉","ことば"],["に"],["留意","りゅうい"],["して"],["いて"],["ください"],["。"]]},{"verse":20,"text":"何よりもまず心得てほしいのは、聖書の預言は何一つ、自分勝手に解釈すべきではないということです。","tok":[["何","なん"],["より"],["も"],["まず"],["心得て","こころえて"],["ほしい"],["の"],["は"],["、"],["聖書","せいしょ"],["の"],["預言","よげん"],["は"],["何","なん"],["一","ひと"],["つ"],["、"],["自分","じぶん"],["勝手に","かってに"],["解釈","かいしゃく"],["すべきで"],["は"],["ない"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":21,"text":"なぜなら、預言は、決して人間の意志に基づいて語られたのではなく、人々が聖霊に導かれて神からの言葉を語ったものだからです。","tok":[["なぜ"],["なら"],["、"],["預言","よげん"],["は"],["、"],["決して","けっして"],["人間","にんげん"],["の"],["意志","いし"],["に"],["基づいて","もとづいて"],["語られた","かたられた"],["ので"],["は"],["なく"],["、"],["人々","ひとびと"],["が"],["聖霊","せいれい"],["に"],["導かれて","みちびかれて"],["神","かみ"],["から"],["の"],["言葉","ことば"]
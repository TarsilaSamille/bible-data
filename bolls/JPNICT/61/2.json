[{"verse":1,"text":"かつて、民の中に偽預言者がいました。同じように、あなたがたの中にも偽教師が現れるにちがいありません。彼らは、滅びをもたらす異端をひそかに持ち込み、自分たちを贖ってくださった主を拒否しました。自分の身に速やかな滅びを招いており、","tok":[["かつて"],["、"],["民","みん"],["の"],["中","なか"],["に"],["偽","にせ"],["預言者","よげんしゃ"],["が"],["いました"],["。"],["同じ","おなじ"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["も"],["偽","にせ"],["教師","きょうし"],["が"],["現れる","あらわれる"],["に"],["ちがい"],["ありません"],["。"],["彼","かれ"],["ら"],["は"],["、"],["滅び","ほろび"],["を"],["もたらす"],["異端","いたん"],["を"],["ひそか"],["に"],["持ち込み","もちこみ"],["、"],["自分","じぶん"],["たち"],["を"],["贖って","あがなって"],["くださった"],["主","ぬし"],["を"],["拒否","きょひ"],["しました"],["。"],["自分","じぶん"],["の"],["身","み"],["に"],["速やか","すみやか"],["な"],["滅び","ほろび"],["を"],["招いて","まねいて"],["おり"],["、"]]},{"verse":2,"text":"しかも、多くの人が彼らのみだらな楽しみを見倣っています。彼らのために真理の道はそしられるのです。","tok":[["しかも"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["彼","かれ"],["ら"],["の"],["みだら"],["な"],["楽しみ","たのしみ"],["を"],["見倣って","みならって"],["います"],["。"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["真理","しんり"],["の"],["道","みち"],["は"],["そしられる"],["の"],["です"],["。"]]},{"verse":3,"text":"彼らは欲が深く、うそ偽りであなたがたを食い物にします。このような者たちに対する裁きは、昔から怠りなくなされていて、彼らの滅びも滞ることはありません。","tok":[["彼","かれ"],["ら"],["は"],["欲","よく"],["が"],["深く","ふかく"],["、"],["うそ偽り","うそいつわり"],["で"],["あなた"],["がた"],["を"],["食い物","くいもの"],["に"],["します"],["。"],["この"],["よう"],["な"],["者","もの"],["たち"],["に"],["対する","たいする"],["裁き","さばき"],["は"],["、"],["昔","むかし"],["から"],["怠り","おこたり"],["なくなされて"],["いて"],["、"],["彼","かれ"],["ら"],["の"],["滅び","ほろび"],["も"],["滞る","とどこおる"],["こと"],["は"],["ありません"],["。"]]},{"verse":4,"text":"神は、罪を犯した天使たちを容赦せず、暗闇という縄で縛って地獄に引き渡し、裁きのために閉じ込められました。","tok":[["神","かみ"],["は"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["天使","てんし"],["たち"],["を"],["容赦","ようしゃ"],["せず"],["、"],["暗闇","くらやみ"],["と"],["いう"],["縄","なわ"],["で"],["縛って","しばって"],["地獄","じごく"],["に"],["引き渡し","ひきわたし"],["、"],["裁き","さばき"],["の"],["ため"],["に"],["閉じ込められました","とじこめられました"],["。"]]},{"verse":5,"text":"また、神は昔の人々を容赦しないで、不信心な者たちの世界に洪水を引き起こし、義を説いていたノアたち八人を保護なさったのです。","tok":[["また"],["、"],["神","かみ"],["は"],["昔","むかし"],["の"],["人々","ひとびと"],["を"],["容赦","ようしゃ"],["しないで"],["、"],["不信心","ふしんじん"],["な"],["者","もの"],["たち"],["の"],["世界","せかい"],["に"],["洪水","こうずい"],["を"],["引き起こし","ひきおこし"],["、"],["義","ぎ"],["を"],["説いて","といて"],["いた"],["ノア"],["たち"],["八人","はちにん"],["を"],["保護","ほご"],["なさった"],["の"],["です"],["。"]]},{"verse":6,"text":"また、神はソドムとゴモラの町を灰にし、滅ぼし尽くして罰し、それから後の不信心な者たちへの見せしめとなさいました。","tok":[["また"],["、"],["神","かみ"],["は"],["ソドム"],["と"],["ゴモラ"],["の"],["町","まち"],["を"],["灰","はい"],["に"],["し"],["、"],["滅ぼし","ほろぼし"],["尽くして","つくして"],["罰し","ばっし"],["、"],["それ"],["から"],["後","あと"],["の"],["不信心","ふしんじん"],["な"],["者","もの"],["たち"],["へ"],["の"],["見せしめ","みせしめ"],["と"],["なさいました"],["。"]]},{"verse":7,"text":"しかし神は、不道徳な者たちのみだらな言動によって悩まされていた正しい人ロトを、助け出されました。","tok":[["しかし"],["神","かみ"],["は"],["、"],["不道徳","ふどうとく"],["な"],["者","もの"],["たち"],["の"],["みだら"],["な"],["言動","げんどう"],["によって"],["悩まされて","なやまされて"],["いた"],["正しい","ただしい"],["人","ひと"],["ロト"],["を"],["、"],["助け出されました","たすけだされました"],["。"]]},{"verse":8,"text":"なぜなら、この正しい人は、彼らの中で生活していたとき、毎日よこしまな行為を見聞きして正しい心を痛めていたからです。","tok":[["なぜ"],["なら"],["、"],["この"],["正しい","ただしい"],["人","ひと"],["は"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["で"],["生活","せいかつ"],["して"],["いた"],["とき"],["、"],["毎日","まいにち"],["よこしま"],["な"],["行為","こうい"],["を"],["見聞き","みきき"],["して"],["正しい","ただしい"],["心","こころ"],["を"],["痛めて","いためて"],["いた"],["から"],["です"],["。"]]},{"verse":9,"text":"主は、信仰のあつい人を試練から救い出す一方、正しくない者たちを罰し、裁きの日まで閉じ込めておくべきだと考えておられます。","tok":[["主","ぬし"],["は"],["、"],["信仰","しんこう"],["の"],["あつい"],["人","ひと"],["を"],["試練","しれん"],["から"],["救い出す","すくいだす"],["一方","いっぽう"],["、"],["正しく","ただしく"],["ない"],["者","もの"],["たち"],["を"],["罰し","ばっし"],["、"],["裁き","さばき"],["の"],["日","ひ"],["まで"],["閉じ込めて","とじこめて"],["おくべきだ"],["と"],["考えて","かんがえて"],["おられます"],["。"]]},{"verse":10,"text":"特に、汚れた情欲の赴くままに肉に従って歩み、権威を侮る者たちを、そのように扱われるのです。彼らは、厚かましく、わがままで、栄光ある者たちをそしってはばかりません。","tok":[["特に","とくに"],["、"],["汚れた","よごれた"],["情欲","じょうよく"],["の"],["赴く","おもむく"],["まま"],["に"],["肉","にく"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"],["権威","けんい"],["を"],["侮る","あなどる"],["者","もの"],["たち"],["を"],["、"],["その"],["よう"],["に"],["扱われる","あつかわれる"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["厚かましく","あつかましく"],["、"],["わがまま"],["で"],["、"],["栄光","えいこう"],["ある"],["者","もの"],["たち"],["を"],["そしって"],["はばかりません"],["。"]]},{"verse":11,"text":"天使たちは、力も権能もはるかにまさっているにもかかわらず、主の御前で彼らをそしったり訴え出たりはしません。","tok":[["天使","てんし"],["たち"],["は"],["、"],["力","ちから"],["も"],["権能","けんのう"],["も"],["はるか"],["に"],["まさって"],["いる"],["に"],["も"],["かかわらず"],["、"],["主","ぬし"],["の"],["御前","ごぜん"],["で"],["彼","かれ"],["ら"],["を"],["そしっ"],["たり"],["訴え出","うったえで"],["たり"],["は"],["しません"],["。"]]},{"verse":12,"text":"この者たちは、捕らえられ、殺されるために生まれてきた理性のない動物と同じで、知りもしないことをそしるのです。そういった動物が滅びるように、彼らも滅んでしまいます。","tok":[["この"],["者","もの"],["たち"],["は"],["、"],["捕らえられ","とらえられ"],["、"],["殺される","ころされる"],["ため"],["に"],["生まれて","うまれて"],["きた"],["理性","りせい"],["の"],["ない"],["動物","どうぶつ"],["と"],["同じ","おなじ"],["で"],["、"],["知り","しり"],["も"],["しない"],["こと"],["を"],["そしる"],["の"],["です"],["。"],["そう"],["いった"],["動物","どうぶつ"],["が"],["滅びる","ほろびる"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["も"],["滅んで","ほろんで"],["しまいます"],["。"]]},{"verse":13,"text":"不義を行う者は、不義にふさわしい報いを受けます。彼らは、昼間から享楽にふけるのを楽しみにしています。彼らは汚れやきずのようなもので、あなたがたと宴席に連なるとき、はめを外して騒ぎます。","tok":[["不義","ふぎ"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["不義","ふぎ"],["に"],["ふさわしい"],["報い","むくい"],["を"],["受けます","うけます"],["。"],["彼","かれ"],["ら"],["は"],["、"],["昼間","ひるま"],["から"],["享楽","きょうらく"],["に"],["ふける"],["の"],["を"],["楽しみ","たのしみ"],["に"],["して"],["います"],["。"],["彼","かれ"],["ら"],["は"],["汚れ","よごれ"],["や"],["きず"],["の"],["よう"],["な"],["もの"],["で"],["、"],["あなた"],["がた"],["と"],["宴席","えんせき"],["に"],["連なる","つらなる"],["とき"],["、"],["はめ"],["を"],["外して","はずして"],["騒ぎます","さわぎます"],["。"]]},{"verse":14,"text":"その目は絶えず姦通の相手を求め、飽くことなく罪を重ねています。彼らは心の定まらない人々を誘惑し、その心は強欲におぼれ、呪いの子になっています。","tok":[["その"],["目","め"],["は"],["絶えず","たえず"],["姦通","かんつう"],["の"],["相手","あいて"],["を"],["求め","もとめ"],["、"],["飽く","あく"],["こと"],["なく"],["罪","つみ"],["を"],["重ねて","かさねて"],["います"],["。"],["彼","かれ"],["ら"],["は"],["心","こころ"],["の"],["定まらない","さだまらない"],["人々","ひとびと"],["を"],["誘惑","ゆうわく"],["し"],["、"],["その"],["心","こころ"],["は"],["強欲","ごうよく"],["に"],["おぼれ"],["、"],["呪い","のろい"],["の"],["子","こ"],["に"],["なって"],["います"],["。"]]},{"verse":15,"text":"彼らは、正しい道から離れてさまよい歩き、ボソルの子バラムが歩んだ道をたどったのです。バラムは不義のもうけを好み、","tok":[["彼","かれ"],["ら"],["は"],["、"],["正しい","ただしい"],["道","みち"],["から"],["離れて","はなれて"],["さまよい"],["歩き","あるき"],["、"],["ボソル"],["の"],["子","こ"],["バラム"],["が"],["歩んだ","あゆんだ"],["道","みち"],["を"],["たどった"],["の"],["です"],["。"],["バラム"],["は"],["不義","ふぎ"],["の"],["もうけ"],["を"],["好み","このみ"],["、"]]},{"verse":16,"text":"それで、その過ちに対するとがめを受けました。ものを言えないろばが人間の声で話して、この預言者の常軌を逸した行いをやめさせたのです。","tok":[["それ"],["で"],["、"],["その"],["過ち","あやまち"],["に"],["対する","たいする"],["とがめ"],["を"],["受けました","うけました"],["。"],["もの"],["を"],["言えない","いえない"],["ろば"],["が"],["人間","にんげん"],["の"],["声","こえ"],["で"],["話して","はなして"],["、"],["この"],["預言者","よげんしゃ"],["の"],["常軌","じょうき"],["を"],["逸した","いっした"],["行い","おこない"],["を"],["やめさせた"],["の"],["です"],["。"]]},{"verse":17,"text":"この者たちは、干上がった泉、嵐に吹き払われる霧であって、彼らには深い暗闇が用意されているのです。","tok":[["この"],["者","もの"],["たち"],["は"],["、"],["干上がった","ひあがった"],["泉","いずみ"],["、"],["嵐","あらし"],["に"],["吹き払われる","ふきはらわれる"],["霧","きり"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["に"],["は"],["深い","ふかい"],["暗闇","くらやみ"],["が"],["用意","ようい"],["されて"],["いる"],["の"],["です"],["。"]]},{"verse":18,"text":"彼らは、無意味な大言壮語をします。また、迷いの生活からやっと抜け出て来た人たちを、肉の欲やみだらな楽しみで誘惑するのです。","tok":[["彼","かれ"],["ら"],["は"],["、"],["無意味","むいみ"],["な"],["大言","たいげん"],["壮語","そうご"],["を"],["します"],["。"],["また"],["、"],["迷い","まよい"],["の"],["生活","せいかつ"],["から"],["やっと"],["抜け出て","ぬけでて"],["来た","きた"],["人","ひと"],["たち"],["を"],["、"],["肉","にく"],["の"],["欲","よく"],["や"],["みだら"],["な"],["楽しみ","たのしみ"],["で"],["誘惑","ゆうわく"],["する"],["の"],["です"],["。"]]},{"verse":19,"text":"その人たちに自由を与えると約束しながら、自分自身は滅亡の奴隷です。人は、自分を打ち負かした者に服従するものです。","tok":[["その"],["人","ひと"],["たち"],["に"],["自由","じゆう"],["を"],["与える","あたえる"],["と"],["約束","やくそく"],["し"],["ながら"],["、"],["自分","じぶん"],["自身","じしん"],["は"],["滅亡","めつぼう"],["の"],["奴隷","どれい"],["です"],["。"],["人","ひと"],["は"],["、"],["自分","じぶん"],["を"],["打ち負かした","うちまかした"],["者","もの"],["に"],["服従","ふくじゅう"],["する"],["もの"],["です"],["。"]]},{"verse":20,"text":"わたしたちの主、救い主イエス‧キリストを深く知って世の汚れから逃れても、それに再び巻き込まれて打ち負かされるなら、そのような者たちの後の状態は、前よりずっと悪くなります。","tok":[["わたしたち"],["の"],["主","ぬし"],["、"],["救い主","すくいぬし"],["イエス"],["‧"],["キリスト"],["を"],["深く","ふかく"],["知って","しって"],["世","よ"],["の"],["汚れ","よごれ"],["から"],["逃れて","のがれて"],["も"],["、"],["それ"],["に"],["再び","ふたたび"],["巻き込まれて","まきこまれて"],["打ち負かされるなら","うちまかされるなら"],["、"],["その"],["よう"],["な"],["者","もの"],["たち"],["の"],["後","あと"],["の"],["状態","じょうたい"],["は"],["、"],["前","まえ"],["より"],["ずっと"],["悪く","わるく"],["なります"],["。"]]},{"verse":21,"text":"義の道を知っていながら、自分たちに伝えられた聖なる掟から離れ去るよりは、義の道を知らなかった方が、彼らのためによかったであろうに。","tok":[["義","ぎ"],["の"],["道","みち"],["を"],["知って","しって"],["い"],["ながら"],["、"],["自分","じぶん"],["たち"],["に"],["伝えられた","つたえられた"],["聖","せい"],["なる"],["掟","おきて"],["から"],["離れ去る","はなれさる"],["より"],["は"],["、"],["義","ぎ"],["の"],["道","みち"],["を"],["知らなかった","しらなかった"],["方","ほう"],["が"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["よかったで"],["あろう"],["に"],["。"]]},{"verse":22,"text":"ことわざに、「犬は、自分の吐いた物のところへ戻って来る」また、「豚は、体を洗って、また、泥の中を転げ回る」と言われているとおりのことが彼らの身に起こっているのです。","tok":[["ことわざ"],["に"],["、"],["「"],["犬","いぬ"],["は"],["、"],["自分","じぶん"],["の"],["吐いた","はいた"],["物","もの"],["の"],["ところ"],["へ"],["戻って","もどって"],["来る","くる"],["」"],["また"],["、"],["「"],["豚","ぶた"],["は"],["、"],["体","からだ"],["を"],["洗って","あらって"],["、"],["また"],["、"],["泥","どろ"],["の"],["中","なか"],["を"],["転げ回る","ころげまわる"],["」"],["と"],["言われて","いわれて"],["いる"],["とおり"],["の"],["こと"],["が"],["彼","かれ"],["ら"],["の"],["身","み"],["に"],["起こって","おこって"],["いる"],["の"],["です"],["。"]]}]
[{"verse":1,"text":"愛する人たち、わたしはあなたがたに二度目の手紙を書いていますが、それは、これらの手紙によってあなたがたの記憶を呼び起こして、純真な心を奮い立たせたいからです。","tok":[["愛する","あいする"],["人","ひと"],["たち"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["二度目","にどめ"],["の"],["手紙","てがみ"],["を"],["書いて","かいて"],["います"],["が"],["、"],["それ"],["は"],["、"],["これ"],["ら"],["の"],["手紙","てがみ"],["によって"],["あなた"],["がた"],["の"],["記憶","きおく"],["を"],["呼び起こして","よびおこして"],["、"],["純真","じゅんしん"],["な"],["心","こころ"],["を"],["奮い立たせたい","ふるいたたせたい"],["から"],["です"],["。"]]},{"verse":2,"text":"聖なる預言者たちがかつて語った言葉と、あなたがたの使徒たちが伝えた、主であり救い主である方の掟を思い出してもらうためです。","tok":[["聖","せい"],["なる"],["預言者","よげんしゃ"],["たち"],["が"],["かつて"],["語った","かたった"],["言葉","ことば"],["と"],["、"],["あなた"],["がた"],["の"],["使徒","しと"],["たち"],["が"],["伝えた","つたえた"],["、"],["主","ぬし"],["で"],["あり"],["救い主","すくいぬし"],["で"],["ある"],["方","かた"],["の"],["掟","おきて"],["を"],["思い出して","おもいだして"],["もらう"],["ため"],["です"],["。"]]},{"verse":3,"text":"まず、次のことを知っていなさい。終わりの時には、欲望の赴くままに生活してあざける者たちが現れ、あざけって、","tok":[["まず"],["、"],["次","つぎ"],["の"],["こと"],["を"],["知って","しって"],["い"],["なさい"],["。"],["終わり","おわり"],["の"],["時","とき"],["に"],["は"],["、"],["欲望","よくぼう"],["の"],["赴く","おもむく"],["まま"],["に"],["生活","せいかつ"],["して"],["あざける"],["者","もの"],["たち"],["が"],["現れ","あらわれ"],["、"],["あざけって"],["、"]]},{"verse":4,"text":"こう言います。「主が来るという約束は、いったいどうなったのだ。父たちが死んでこのかた、世の中のことは、天地創造の初めから何一つ変わらないではないか。」","tok":[["こう"],["言います","いいます"],["。"],["「"],["主","ぬし"],["が"],["来る","くる"],["と"],["いう"],["約束","やくそく"],["は"],["、"],["いったい"],["どう"],["なった"],["の"],["だ"],["。"],["父","ちち"],["たち"],["が"],["死んで","しんで"],["このかた"],["、"],["世の中","よのなか"],["の"],["こと"],["は"],["、"],["天地","てんち"],["創造","そうぞう"],["の"],["初め","はじめ"],["から"],["何","なん"],["一","ひと"],["つ"],["変わらないで","かわらないで"],["は"],["ない"],["か"],["。"],["」"]]},{"verse":5,"text":"彼らがそのように言うのは、次のことを認めようとしないからです。すなわち、天は大昔から存在し、地は神の言葉によって水を元として、また水によってできたのですが、","tok":[["彼","かれ"],["ら"],["が"],["その"],["よう"],["に"],["言う","いう"],["の"],["は"],["、"],["次","つぎ"],["の"],["こと"],["を"],["認めよう","みとめよう"],["と"],["しない"],["から"],["です"],["。"],["すなわち"],["、"],["天","てん"],["は"],["大昔","おおむかし"],["から"],["存在","そんざい"],["し"],["、"],["地","ち"],["は"],["神","かみ"],["の"],["言葉","ことば"],["によって"],["水","みず"],["を"],["元","もと"],["として"],["、"],["また"],["水","みず"],["によって"],["できた"],["の"],["です"],["が"],["、"]]},{"verse":6,"text":"当時の世界は、その水によって洪水に押し流されて滅んでしまいました。","tok":[["当時","とうじ"],["の"],["世界","せかい"],["は"],["、"],["その"],["水","みず"],["によって"],["洪水","こうずい"],["に"],["押し流されて","おしながされて"],["滅んで","ほろんで"],["しまいました"],["。"]]},{"verse":7,"text":"しかし、現在の天と地とは、火で滅ぼされるために、同じ御言葉によって取っておかれ、不信心な者たちが裁かれて滅ぼされる日まで、そのままにしておかれるのです。","tok":[["しかし"],["、"],["現在","げんざい"],["の"],["天","てん"],["と"],["地","ち"],["と"],["は"],["、"],["火","ひ"],["で"],["滅ぼされる","ほろぼされる"],["ため"],["に"],["、"],["同じ","おなじ"],["御言葉","おことば"],["によって"],["取って","とって"],["おかれ"],["、"],["不信心","ふしんじん"],["な"],["者","もの"],["たち"],["が"],["裁かれて","さばかれて"],["滅ぼされる","ほろぼされる"],["日","ひ"],["まで"],["、"],["そのまま"],["に"],["して"],["おかれる"],["の"],["です"],["。"]]},{"verse":8,"text":"愛する人たち、このことだけは忘れないでほしい。主のもとでは、一日は千年のようで、千年は一日のようです。","tok":[["愛する","あいする"],["人","ひと"],["たち"],["、"],["この"],["こと"],["だけ"],["は"],["忘れないで","わすれないで"],["ほしい"],["。"],["主","ぬし"],["の"],["もと"],["で"],["は"],["、"],["一","いち"],["日","にち"],["は"],["千","せん"],["年","ねん"],["の"],["よう"],["で"],["、"],["千","せん"],["年","ねん"],["は"],["一","いち"],["日","にち"],["の"],["よう"],["です"],["。"]]},{"verse":9,"text":"ある人たちは、遅いと考えているようですが、主は約束の実現を遅らせておられるのではありません。そうではなく、一人も滅びないで皆が悔い改めるようにと、あなたがたのために忍耐しておられるのです。","tok":[["ある"],["人","ひと"],["たち"],["は"],["、"],["遅い","おそい"],["と"],["考えて","かんがえて"],["いる"],["よう"],["です"],["が"],["、"],["主","ぬし"],["は"],["約束","やくそく"],["の"],["実現","じつげん"],["を"],["遅らせて","おくらせて"],["おられる"],["ので"],["は"],["ありません"],["。"],["そう"],["で"],["は"],["なく"],["、"],["一人","ひとり"],["も"],["滅びないで","ほろびないで"],["皆","みな"],["が"],["悔い改める","くいあらためる"],["よう"],["に"],["と"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["忍耐","にんたい"],["して"],["おられる"],["の"],["です"],["。"]]},{"verse":10,"text":"主の日は盗人のようにやって来ます。その日、天は激しい音をたてながら消えうせ、自然界の諸要素は熱に熔け尽くし、地とそこで造り出されたものは暴かれてしまいます。","tok":[["主","ぬし"],["の"],["日","ひ"],["は"],["盗人","ぬすびと"],["の"],["よう"],["に"],["やって"],["来ます","きます"],["。"],["その"],["日","ひ"],["、"],["天","てん"],["は"],["激しい","はげしい"],["音","おと"],["を"],["たて"],["ながら"],["消えうせ","きえうせ"],["、"],["自然界","しぜんかい"],["の"],["諸","しょ"],["要素","ようそ"],["は"],["熱","ねつ"],["に"],["熔け","とけ"],["尽くし","つくし"],["、"],["地","ち"],["と"],["そこ"],["で"],["造り出された","つくりだされた"],["もの"],["は"],["暴かれて","あばかれて"],["しまいます"],["。"]]},{"verse":11,"text":"このように、すべてのものは滅び去るのですから、あなたがたは聖なる信心深い生活を送らなければなりません。","tok":[["この"],["よう"],["に"],["、"],["すべて"],["の"],["もの"],["は"],["滅び去る","ほろびさる"],["の"],["です"],["から"],["、"],["あなた"],["がた"],["は"],["聖","せい"],["なる"],["信心","しんじん"],["深い","ふかい"],["生活","せいかつ"],["を"],["送らなければ","おくらなければ"],["なりません"],["。"]]},{"verse":12,"text":"神の日の来るのを待ち望み、また、それが来るのを早めるようにすべきです。その日、天は焼け崩れ、自然界の諸要素は燃え尽き、熔け去ることでしょう。","tok":[["神","かみ"],["の"],["日","ひ"],["の"],["来る","くる"],["の"],["を"],["待ち望み","まちのぞみ"],["、"],["また"],["、"],["それ"],["が"],["来る","くる"],["の"],["を"],["早める","はやめる"],["よう"],["に"],["すべきです"],["。"],["その"],["日","ひ"],["、"],["天","てん"],["は"],["焼け崩れ","やけくずれ"],["、"],["自然界","しぜんかい"],["の"],["諸","しょ"],["要素","ようそ"],["は"],["燃え尽き","もえつき"],["、"],["熔け","とけ"],["去る","さる"],["こと"],["でしょう"],["。"]]},{"verse":13,"text":"しかしわたしたちは、義の宿る新しい天と新しい地とを、神の約束に従って待ち望んでいるのです。","tok":[["しかし"],["わたしたち"],["は"],["、"],["義","ぎ"],["の"],["宿る","やどる"],["新しい","あたらしい"],["天","てん"],["と"],["新しい","あたらしい"],["地","ち"],["と"],["を"],["、"],["神","かみ"],["の"],["約束","やくそく"],["に"],["従って","したがって"],["待ち望んで","まちのぞんで"],["いる"],["の"],["です"],["。"]]},{"verse":14,"text":"だから、愛する人たち、このことを待ち望みながら、きずや汚れが何一つなく、平和に過ごしていると神に認めていただけるように励みなさい。","tok":[["だ"],["から"],["、"],["愛する","あいする"],["人","ひと"],["たち"],["、"],["この"],["こと"],["を"],["待ち望み","まちのぞみ"],["ながら"],["、"],["きず"],["や"],["汚れ","よごれ"],["が"],["何","なん"],["一","ひと"],["つ"],["なく"],["、"],["平和","へいわ"],["に"],["過ごして","すごして"],["いる"],["と"],["神","かみ"],["に"],["認めて","みとめて"],["いただける"],["よう"],["に"],["励み","はげみ"],["なさい"],["。"]]},{"verse":15,"text":"また、わたしたちの主の忍耐深さを、救いと考えなさい。それは、わたしたちの愛する兄弟パウロが、神から授かった知恵に基づいて、あなたがたに書き送ったことでもあります。","tok":[["また"],["、"],["わたしたち"],["の"],["主","ぬし"],["の"],["忍耐","にんたい"],["深さ","ふかさ"],["を"],["、"],["救い","すくい"],["と"],["考え","かんがえ"],["なさい"],["。"],["それ"],["は"],["、"],["わたしたち"],["の"],["愛する","あいする"],["兄弟","きょうだい"],["パウロ"],["が"],["、"],["神","かみ"],["から"],["授かった","さずかった"],["知恵","ちえ"],["に"],["基づいて","もとづいて"],["、"],["あなた"],["がた"],["に"],["書き送った","かきおくった"],["こと"],["で"],["も"],["あります"],["。"]]},{"verse":16,"text":"彼は、どの手紙の中でもこのことについて述べています。その手紙には難しく理解しにくい個所があって、無学な人や心の定まらない人は、それを聖書のほかの部分と同様に曲解し、自分の滅びを招いています。","tok":[["彼","かれ"],["は"],["、"],["どの"],["手紙","てがみ"],["の"],["中","なか"],["で"],["も"],["この"],["こと"],["について"],["述べて","のべて"],["います"],["。"],["その"],["手紙","てがみ"],["に"],["は"],["難しく","むずかしく"],["理解","りかい"],["し"],["にくい"],["個所","かしょ"],["が"],["あって"],["、"],["無学","むがく"],["な"],["人","ひと"],["や"],["心","こころ"],["の"],["定まらない","さだまらない"],["人","ひと"],["は"],["、"],["それ"],["を"],["聖書","せいしょ"],["の"],["ほか"],["の"],["部分","ぶぶん"],["と"],["同様","どうよう"],["に"],["曲解","きょっかい"],["し"],["、"],["自分","じぶん"],["の"],["滅び","ほろび"],["を"],["招いて","まねいて"],["います"],["。"]]},{"verse":17,"text":"それで、愛する人たち、あなたがたはこのことをあらかじめ知っているのですから、不道徳な者たちに唆されて、堅固な足場を失わないように注意しなさい。","tok":[["それ"],["で"],["、"],["愛する","あいする"],["人","ひと"],["たち"],["、"],["あなた"],["がた"],["は"],["この"],["こと"],["を"],["あらかじめ"],["知って","しって"],["いる"],["の"],["です"],["から"],["、"],["不道徳","ふどうとく"],["な"],["者","もの"],["たち"],["に"],["唆されて","そそのかされて"],["、"],["堅固","けんご"],["な"],["足場","あしば"],["を"],["失わない","うしなわない"],["よう"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"]]},{"verse":18,"text":"わたしたちの主、救い主イエス‧キリストの恵みと知識において、成長しなさい。このイエス‧キリストに、今も、また永遠に栄光がありますように、アーメン。","tok":[["わたしたち"],["の"],["主","ぬし"],["、"],["救い主","すくいぬし"],["イエス"],["‧"],["キリスト"],["の"],["恵み","めぐみ"],["と"],["知識","ちしき"],["に"],["おいて"],["、"],["成長","せいちょう"],["し"],["なさい"],["。"],["この"],["イエス"],["‧"],["キリスト"],["に"],["、"],["今","いま"],["も"],["、"],["また"],["永遠","えいえん"],["に"],["栄光","えいこう"],["が"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]}]
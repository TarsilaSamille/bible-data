[{"verse":1,"text":"エフドの死後、イスラエルの人々はまたも主の目に悪とされることを行い、","tok":[["エフド"],["の"],["死後","しご"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["また"],["も"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行い","おこない"],["、"]]},{"verse":2,"text":"主はハツォルで王位についていたカナンの王ヤビンの手に、彼らを売り渡された。ヤビンの将軍はシセラであって、ハロシェト‧ハゴイムに住んでいた。","tok":[["主","ぬし"],["は"],["ハツォル"],["で"],["王位","おうい"],["について"],["いた"],["カナン"],["の"],["王","おう"],["ヤビン"],["の"],["手","て"],["に"],["、"],["彼","かれ"],["ら"],["を"],["売り渡された","うりわたされた"],["。"],["ヤビン"],["の"],["将軍","しょうぐん"],["は"],["シセラ"],["で"],["あって"],["、"],["ハロシェト"],["‧"],["ハゴイム"],["に"],["住んで","すんで"],["いた"],["。"]]},{"verse":3,"text":"イスラエルの人々は、主に助けを求めて叫んだ。ヤビンは鉄の戦車九百両を有し、二十年にわたってイスラエルの人々を、力ずくで押さえつけたからである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["主に","おもに"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んだ","さけんだ"],["。"],["ヤビン"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["九百","きゅうひゃく"],["両","りょう"],["を"],["有し","ゆうし"],["、"],["二十","にじゅう"],["年","ねん"],["に"],["わたって"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["、"],["力","ちから"],["ずく"],["で"],["押さえつけた","おさえつけた"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"ラピドトの妻、女預言者デボラが、士師としてイスラエルを裁くようになったのはそのころである。","tok":[["ラピドト"],["の"],["妻","つま"],["、"],["女","おんな"],["預言者","よげんしゃ"],["デボラ"],["が"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁く","さばく"],["よう"],["に"],["なった"],["の"],["は"],["その"],["ころ"],["で"],["ある"],["。"]]},{"verse":5,"text":"彼女は、エフライム山地のラマとベテルの間にあるデボラのなつめやしの木の下に座を定め、イスラエルの人々はその彼女に裁きを求めて上ることにしていた。","tok":[["彼女","かのじょ"],["は"],["、"],["エフライム"],["山地","さんち"],["の"],["ラマ"],["と"],["ベテル"],["の"],["間","あいだ"],["に"],["ある"],["デボラ"],["の"],["なつめやし"],["の"],["木","き"],["の"],["下","した"],["に"],["座","ざ"],["を"],["定め","さだめ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["その"],["彼女","かのじょ"],["に"],["裁き","さばき"],["を"],["求めて","もとめて"],["上る","のぼる"],["こと"],["に"],["して"],["いた"],["。"]]},{"verse":6,"text":"さて、彼女は人を遣わして、ナフタリのケデシュからアビノアムの子バラクを呼び寄せて言った。「イスラエルの神、主がお命じになったではありませんか。『行け、ナフタリ人とゼブルン人一万を動員し、タボル山に集結させよ。","tok":[["さて"],["、"],["彼女","かのじょ"],["は"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["ナフタリ"],["の"],["ケデシュ"],["から"],["アビノアム"],["の"],["子","こ"],["バラク"],["を"],["呼び寄せて","よびよせて"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["お命じ","おめいじ"],["に"],["なったで"],["は"],["ありません"],["か"],["。"],["『"],["行け","いけ"],["、"],["ナフタリ"],["人","にん"],["と"],["ゼブルン"],["人","にん"],["一万","いちまん"],["を"],["動員","どういん"],["し"],["、"],["タボル山","たぼるさん"],["に"],["集結","しゅうけつ"],["させ"],["よ"],["。"]]},{"verse":7,"text":"わたしはヤビンの将軍シセラとその戦車、軍勢をお前に対してキション川に集結させる。わたしは彼をお前の手に渡す』と。」","tok":[["わたし"],["は"],["ヤビン"],["の"],["将軍","しょうぐん"],["シセラ"],["と"],["その"],["戦車","せんしゃ"],["、"],["軍勢","ぐんぜい"],["を"],["お前","おまえ"],["に対して","にたいして"],["キション"],["川","かわ"],["に"],["集結","しゅうけつ"],["させる"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["お前","おまえ"],["の"],["手","て"],["に"],["渡す","わたす"],["』"],["と"],["。"],["」"]]},{"verse":8,"text":"バラクはデボラに言った。「あなたが共に来てくださるなら、行きます。もし来てくださらないなら、わたしは行きません。」","tok":[["バラク"],["は"],["デボラ"],["に"],["言った","いった"],["。"],["「"],["あなた"],["が"],["共","とも"],["に"],["来て","きて"],["くださるなら"],["、"],["行きます","いきます"],["。"],["もし"],["来て","きて"],["くださらないなら"],["、"],["わたし"],["は"],["行きません","いきません"],["。"],["」"]]},{"verse":9,"text":"デボラは、「わたしも一緒に行きます。ただし今回の出陣で、あなたは栄誉を自分のものとすることはできません。主は女の手にシセラを売り渡されるからです」と答え、直ちにバラクと共にケデシュに向かった。","tok":[["デボラ"],["は"],["、"],["「"],["わたし"],["も"],["一緒","いっしょ"],["に"],["行きます","いきます"],["。"],["ただし"],["今回","こんかい"],["の"],["出陣","しゅつじん"],["で"],["、"],["あなた"],["は"],["栄誉","えいよ"],["を"],["自分","じぶん"],["の"],["もの"],["と"],["する"],["こと"],["は"],["できません"],["。"],["主","ぬし"],["は"],["女","おんな"],["の"],["手","て"],["に"],["シセラ"],["を"],["売り渡される","うりわたされる"],["から"],["です"],["」"],["と"],["答え","こたえ"],["、"],["直ちに","ただちに"],["バラク"],["と"],["共","とも"],["に"],["ケデシュ"],["に"],["向かった","むかった"],["。"]]},{"verse":10,"text":"バラクはゼブルンとナフタリをケデシュに召集した。一万人が彼に従って上り、彼と共にデボラも上った。","tok":[["バラク"],["は"],["ゼブルン"],["と"],["ナフタリ"],["を"],["ケデシュ"],["に"],["召集","しょうしゅう"],["した"],["。"],["一万人","いちまんにん"],["が"],["彼","かれ"],["に"],["従って","したがって"],["上り","のぼり"],["、"],["彼","かれ"],["と"],["共","とも"],["に"],["デボラ"],["も"],["上った","のぼった"],["。"]]},{"verse":11,"
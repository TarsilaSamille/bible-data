[{"verse":1,"text":"主の御使いが、ギルガルからボキムに上って来て言った。「わたしはあなたたちをエジプトから導き上り、あなたたちの先祖に与えると誓った土地に入らせ、こう告げた。わたしはあなたたちと交わしたわたしの契約を、決して破棄しない、","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["が"],["、"],["ギルガル"],["から"],["ボキム"],["に"],["上って","のぼって"],["来て","きて"],["言った","いった"],["。"],["「"],["わたし"],["は"],["あなた"],["たち"],["を"],["エジプト"],["から"],["導き","みちびき"],["上り","のぼり"],["、"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["に"],["与える","あたえる"],["と"],["誓った","ちかった"],["土地","とち"],["に"],["入らせ","はいらせ"],["、"],["こう"],["告げた","つげた"],["。"],["わたし"],["は"],["あなた"],["たち"],["と"],["交わした","かわした"],["わたし"],["の"],["契約","けいやく"],["を"],["、"],["決して","けっして"],["破棄","はき"],["しない"],["、"]]},{"verse":2,"text":"あなたたちもこの地の住民と契約を結んではならない、住民の祭壇は取り壊さなければならない、と。しかしあなたたちは、わたしの声に聞き従わなかった。なぜこのようなことをしたのか。","tok":[["あなた"],["たち"],["も"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["と"],["契約","けいやく"],["を"],["結んで","むすんで"],["は"],["ならない"],["、"],["住民","じゅうみん"],["の"],["祭壇","さいだん"],["は"],["取り壊さなければ","とりこわさなければ"],["ならない"],["、"],["と"],["。"],["しかし"],["あなた"],["たち"],["は"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["。"],["なぜ"],["この"],["よう"],["な"],["こと"],["を"],["した"],["の"],["か"],["。"]]},{"verse":3,"text":"わたしもこう言わざるをえない。わたしは彼らを追い払って、あなたたちの前から去らせることはしない。彼らはあなたたちと隣り合わせとなり、彼らの神々はあなたたちの罠となろう。」","tok":[["わたし"],["も"],["こう"],["言わざる","いわざる"],["を"],["えない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["追い払って","おいはらって"],["、"],["あなた"],["たち"],["の"],["前","まえ"],["から"],["去らせる","さらせる"],["こと"],["は"],["しない"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["たち"],["と"],["隣り合わせ","となりあわせ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["は"],["あなた"],["たち"],["の"],["罠","わな"],["と"],["なろう"],["。"],["」"]]},{"verse":4,"text":"主の御使いがすべてのイスラエルの人々にこれらのことを告げると、民は声をあげて泣いた。","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["が"],["すべて"],["の"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["これ"],["ら"],["の"],["こと"],["を"],["告げる","つげる"],["と"],["、"],["民","みん"],["は"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"]]},{"verse":5,"text":"こうしてこの場所の名をボキム（泣く者）と呼び、彼らはここで主にいけにえをささげた。","tok":[["こう"],["して"],["この"],["場所","ばしょ"],["の"],["名","な"],["を"],["ボキム"],["（"],["泣く","なく"],["者","もの"],["）"],["と"],["呼び","よび"],["、"],["彼","かれ"],["ら"],["は"],["ここ"],["で"],["主に","おもに"],["いけにえ"],["を"],["ささげた"],["。"]]},{"verse":6,"text":"ヨシュアが民を送り出したので、イスラエルの人々は土地を獲得するため、それぞれ自分の嗣業の地に向かった。","tok":[["ヨシュア"],["が"],["民","たみ"],["を"],["送り出した","おくりだした"],["ので"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["土地","とち"],["を"],["獲得","かくとく"],["する"],["ため"],["、"],["それぞれ"],["自分","じぶん"],["の"],["嗣業","しぎょう"],["の"],["地","ち"],["に"],["向かった","むかった"],["。"]]},{"verse":7,"text":"ヨシュアの在世中はもとより、ヨシュアの死後も生き永らえて、主がイスラエルに行われた大いなる御業をことごとく見た長老たちの存命中、民は主に仕えた。","tok":[["ヨシュア"],["の"],["在世中","ざいせちゅう"],["は"],["もとより"],["、"],["ヨシュア"],["の"],["死後","しご"],["も"],["生き永らえて","いきながらえて"],["、"],["主","ぬし"],["が"],["イスラエル"],["に"],["行われた","おこなわれた"],["大いなる","おおいなる"],["御業","ごぎょう"],["を"],["ことごとく"],["見た","みた"],["長老","ちょうろう"],["たち"],["の"],["存命中","ぞんめいちゅう"],["、"],["民","みん"],["は"],["主に","おもに"],["仕えた","つかえた"],["。"]]},{"verse":8,"text":"主の僕、ヌンの子ヨシュアは百十歳の生涯を閉じ、","tok":[["主","ぬし"],["の"],["僕","ぼく"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["百十歳","ひゃくとうさい"],["の"],["生涯","しょうがい"],["を"],["閉じ","とじ"],["、"]]},{"verse":9,"text":"エフライムの山地にある彼の嗣業の土地ティムナト‧ヘレスに葬られた。それはガアシュ山の北にある。","tok":[["エフライム"],["の"],["山地","さんち"],["に"],["ある"],["彼","かれ"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["ティムナト"],["‧"],["ヘレス"],["に"],["葬られた","ほうむられた"],["。"],["それ"],["は"],["ガアシュ"],["山","やま"],["の"],["北","きた"],["に"],["ある"],["。"]]},{"verse":10,"text":"その世代が皆絶えて先祖のもとに集められると、その後に、主を知らず、主がイスラエルに行われた御業も知らない別の世代が興った。","tok":[["その"],["世代","せだい"],["が"],["皆","みな"],["絶えて","たえて"],["先祖","せんぞ"],["の"],["もと"],["に"],["集められる","あつめられる"],["と"],["、"],["その後","そのあと"],["に"],["、"],["主","ぬし"],["を"],["知らず","しらず"],["、"],["主","ぬし"],["が"],["イスラエル"],["に"],["行われた","おこなわれた"],["御業","ごごう"],["も"],["知らない","しらない"],["別","べつ"],["の"],["世代","せだい"],["が"],["興った","おこった"],["。"]]},{"verse":11,"text":"イスラエルの人々は主の目に悪とされることを行い、バアルに仕えるものとなった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行い","おこない"],["、"],["バアル"],["に"],["仕える","つかえる"],["もの"],["と"],["なった"],["。"]]},{"verse":12,"text":"彼らは自分たちをエジプトの地から導き出した先祖の神、主を捨て、他の神々、周囲の国の神々に従い、これにひれ伏して、主を怒らせた。","tok":[["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出した","みちびきだした"],["先祖","せんぞ"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["捨て","すて"],["、"],["他","た"],["の"],["神々","かみがみ"],["、"],["周囲","しゅうい"],["の"],["国","くに"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["これ"],["に"],["ひれ伏して","ひれふして"],["、"],["主","ぬし"],["を"],["怒らせた","おこらせた"],["。"]]},{"verse":13,"text":"彼らは主を捨て、バアルとアシュトレトに仕えたので、","tok":[["彼","かれ"],["ら"],["は"],["主","ぬし"],["を"],["捨て","すて"],["、"],["バアル"],["と"],["アシュトレト"],["に"],["仕えた","つかえた"],["ので"],["、"]]},{"verse":14,"text":"主はイスラエルに対して怒りに燃え、彼らを略奪者の手に任せて、略奪されるがままにし、周りの敵の手に売り渡された。彼らはもはや、敵に立ち向かうことができなかった。","tok":[["主","ぬし"],["は"],["イスラエル"],["に対して","にたいして"],["怒り","いかり"],["に"],["燃え","もえ"],["、"],["彼","かれ"],["ら"],["を"],["略奪者","りゃくだつしゃ"],["の"],["手","て"],["に"],["任せて","まかせて"],["、"],["略奪","りゃくだつ"],["される"],["が"],["まま"],["に"],["し"],["、"],["周り","まわり"],["の"],["敵","てき"],["の"],["手","て"],["に"],["売り渡された","うりわたされた"],["。"],["彼","かれ"],["ら"],["は"],["もはや"],["、"],["敵","てき"],["に"],["立ち向かう","たちむかう"],["こと"],["が"],["できなかった"],["。"]]},{"verse":15,"text":"出陣するごとに、主が告げて彼らに誓われたとおり、主の御手が彼らに立ち向かい、災いをくだされた。彼らは苦境に立たされた。","tok":[["出陣","しゅつじん"],["する"],["ごと"],["に"],["、"],["主","ぬし"],["が"],["告げて","つげて"],["彼","かれ"],["ら"],["に"],["誓われた","ちかわれた"],["とおり"],["、"],["主","ぬし"],["の"],["御手","おて"],["が"],["彼","かれ"],["ら"],["に"],["立ち向かい","たちむかい"],["、"],["災い","わざわい"],["を"],["くだされた"],["。"],["彼","かれ"],["ら"],["は"],["苦境","くきょう"],["に"],["立たされた","たたされた"],["。"]]},{"verse":16,"text":"主は士師たちを立てて、彼らを略奪者の手から救い出された。","tok":[["主","ぬし"],["は"],["士師","しし"],["たち"],["を"],["立てて","たてて"],["、"],["彼","かれ"],["ら"],["を"],["略奪者","りゃくだつしゃ"],["の"],["手","て"],["から"],["救い出された","すくいだされた"],["。"]]},{"verse":17,"text":"しかし、彼らは士師たちにも耳を傾けず、他の神々を恋い慕って姦淫し、これにひれ伏した。彼らは、先祖が主の戒めに聞き従って歩んでいた道を早々に離れ、同じように歩もうとはしなかった。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["士師","しし"],["たち"],["に"],["も"],["耳","みみ"],["を"],["傾けず","かたむけず"],["、"],["他","た"],["の"],["神々","かみがみ"],["を"],["恋い慕って","こいしたって"],["姦淫","かんいん"],["し"],["、"],["これ"],["に"],["ひれ伏した","ひれふした"],["。"],["彼","かれ"],["ら"],["は"],["、"],["先祖","せんぞ"],["が"],["主","ぬし"],["の"],["戒め","いましめ"],["に"],["聞き従って","ききしたがって"],["歩んで","あゆんで"],["いた"],["道","みち"],["を"],["早々","そうそう"],["に"],["離れ","はなれ"],["、"],["同じ","おなじ"],["よう"],["に"],["歩もう","あゆもう"],["と"],["は"],["しなかった"],["。"]]},{"verse":18,"text":"主は彼らのために士師たちを立て、士師と共にいて、その士師の存命中敵の手から救ってくださったが、それは圧迫し迫害する者を前にしてうめく彼らを、主が哀れに思われたからである。","tok":[["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["士師","しし"],["たち"],["を"],["立て","たて"],["、"],["士師","しし"],["と"],["共","とも"],["に"],["いて"],["、"],["その"],["士師","しし"],["の"],["存命中","ぞんめいちゅう"],["敵","てき"],["の"],["手","て"],["から"],["救って","すくって"],["くださった"],["が"],["、"],["それ"],["は"],["圧迫","あっぱく"],["し"],["迫害","はくがい"],["する"],["者","もの"],["を"],["前","まえ"],["に"],["して"],["うめく"],["彼","かれ"],["ら"],["を"],["、"],["主","ぬし"],["が"],["哀れ","あわれ"],["に"],["思われた","おもわれた"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"その士師が死ぬと、彼らはまた先祖よりいっそう堕落して、他の神々に従い、これに仕え、ひれ伏し、その悪い行いとかたくなな歩みを何一つ断たなかった。","tok":[["その"],["士師","しし"],["が"],["死ぬ","しぬ"],["と"],["、"],["彼","かれ"],["ら"],["は"],["また"],["先祖","せんぞ"],["より"],["いっそう"],["堕落","だらく"],["して"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["これ"],["に"],["仕え","つかえ"],["、"],["ひれ伏し","ひれふし"],["、"],["その"],["悪い","わるい"],["行い","おこない"],["と"],["かたくな"],["な"],["歩み","あゆみ"],["を"],["何","なん"],["一","ひと"],["つ"],["断たなかった","たたなかった"],["。"]]},{"verse":20,"text":"主はイスラエルに対して怒りに燃え、こう言われた。「この民はわたしが先祖に命じたわたしの契約を破り、わたしの声に耳を傾けなかったので、","tok":[["主","ぬし"],["は"],["イスラエル"],["に対して","にたいして"],["怒り","いかり"],["に"],["燃え","もえ"],["、"],["こう"],["言われた","いわれた"],["。"],["「"],["この"],["民","みん"],["は"],["わたし"],["が"],["先祖","せんぞ"],["に"],["命じた","めいじた"],["わたし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["わたし"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けなかった","かたむけなかった"],["ので"],["、"]]},{"verse":21,"text":"ヨシュアが死んだときに残した諸国の民を、わたしはもうこれ以上一人も追い払わないことにする。","tok":[["ヨシュア"],["が"],["死んだ","しんだ"],["とき"],["に"],["残した","のこした"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["、"],["わたし"],["は"],["もう"],["これ"],["以上","いじょう"],["一人","ひとり"],["も"],["追い払わない","おいはらわない"],["こと"],["に"],["する"],["。"]]},{"verse":22,"text":"彼らによってイスラエルを試し、先祖が歩み続けたように主の道を歩み続けるかどうか見るためである。」","tok":[["彼","かれ"],["ら"],["によって"],["イスラエル"],["を"],["試し","ためし"],["、"],["先祖","せんぞ"],["が"],["歩み","あゆみ"],["続けた","つづけた"],["よう"],["に"],["主","ぬし"],["の"],["道","みち"],["を"],["歩み","あゆみ"],["続ける","つづける"],["か"],["どう"],["か"],["見る","みる"],["ため"],["で"],["ある"],["。"],["」"]]},{"verse":23,"text":"主はこれらの諸国の民をそのままとどまらせ、すぐ追い払うことはなさらなかった。彼らをヨシュアの手に渡すこともなさらなかった。","tok":[["主","ぬし"],["は"],["これ"],["ら"],["の"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["そのまま"],["とどまらせ"],["、"],["すぐ"],["追い払う","おいはらう"],["こと"],["は"],["なさらなかった"],["。"],["彼","かれ"],["ら"],["を"],["ヨシュア"],["の"],["手","て"],["に"],["渡す","わたす"],["こと"],["も"],["なさらなかった"],["。"]]}]
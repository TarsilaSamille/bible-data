[{"verse":1,"text":"サムソンはティムナに下って行ったが、そのティムナで一人の女、ペリシテ人の娘に目をひかれた。","tok":[["サムソン"],["は"],["ティムナ"],["に"],["下って","くだって"],["行った","いった"],["が"],["、"],["その"],["ティムナ"],["で"],["一人","ひとり"],["の"],["女","おんな"],["、"],["ペリシテ"],["人","にん"],["の"],["娘","むすめ"],["に"],["目","め"],["を"],["ひかれた"],["。"]]},{"verse":2,"text":"彼は父母のところに上って行って、「ティムナで、一人の女、ペリシテ人の娘に目をひかれました。どうか彼女をわたしの妻に迎えてください」と言った。","tok":[["彼","かれ"],["は"],["父母","ふぼ"],["の"],["ところ"],["に"],["上って","のぼって"],["行って","いって"],["、"],["「"],["ティムナ"],["で"],["、"],["一人","ひとり"],["の"],["女","おんな"],["、"],["ペリシテ"],["人","にん"],["の"],["娘","むすめ"],["に"],["目","め"],["を"],["ひかれました"],["。"],["どう"],["か"],["彼女","かのじょ"],["を"],["わたし"],["の"],["妻","つま"],["に"],["迎えて","むかえて"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"父母は言った。「お前の兄弟の娘や同族の中に、女がいないとでも言うのか。無割礼のペリシテ人の中から妻を迎えようとは。」だがサムソンは父に、「彼女をわたしの妻として迎えてください。わたしは彼女が好きです」と願った。","tok":[["父母","ふぼ"],["は"],["言った","いった"],["。"],["「"],["お前","おまえ"],["の"],["兄弟","きょうだい"],["の"],["娘","むすめ"],["や"],["同族","どうぞく"],["の"],["中","なか"],["に"],["、"],["女","おんな"],["が"],["いない"],["と"],["で"],["も"],["言う","いう"],["の"],["か"],["。"],["無","む"],["割礼","かつれい"],["の"],["ペリシテ"],["人","にん"],["の"],["中","なか"],["から"],["妻","つま"],["を"],["迎えよう","むかえよう"],["と"],["は"],["。"],["」"],["だ"],["が"],["サムソン"],["は"],["父","ちち"],["に"],["、"],["「"],["彼女","かのじょ"],["を"],["わたし"],["の"],["妻","つま"],["として"],["迎えて","むかえて"],["ください"],["。"],["わたし"],["は"],["彼女","かのじょ"],["が"],["好き","すき"],["です"],["」"],["と"],["願った","ねがった"],["。"]]},{"verse":4,"text":"父母にはこれが主の御計画であり、主がペリシテ人に手がかりを求めておられることが分からなかった。当時、ペリシテ人がイスラエルを支配していた。","tok":[["父母","ふぼ"],["に"],["は"],["これ"],["が"],["主","ぬし"],["の"],["御計画","ごけいかく"],["で"],["あり"],["、"],["主","ぬし"],["が"],["ペリシテ"],["人","にん"],["に"],["手がかり","てがかり"],["を"],["求めて","もとめて"],["おられる"],["こと"],["が"],["分からなかった","わからなかった"],["。"],["当時","とうじ"],["、"],["ペリシテ"],["人","にん"],["が"],["イスラエル"],["を"],["支配","しはい"],["して"],["いた"],["。"]]},{"verse":5,"text":"サムソンは父母と共に、ティムナに向けて下って行った。ティムナのぶどう畑まで来たところ、一頭の若い獅子がほえながら向かって来た。","tok":[["サムソン"],["は"],["父母","ふぼ"],["と"],["共","とも"],["に"],["、"],["ティムナ"],["に"],["向けて","むけて"],["下って","くだって"],["行った","いった"],["。"],["ティムナ"],["の"],["ぶどう"],["畑","はたけ"],["まで"],["来た","きた"],["ところ"],["、"],["一頭","いちとう"],["の"],["若い","わかい"],["獅子","しし"],["が"],["ほえ"],["ながら"],["向かって","むかって"],["来た","きた"],["。"]]},{"verse":6,"text":"そのとき主の霊が激しく彼に降ったので、彼は手に何も持たなくても、子山羊を裂くように獅子を裂いた。しかし、彼は自分の行ったことを父母には言わなかった。","tok":[["その"],["とき"],["主","ぬし"],["の"],["霊","れい"],["が"],["激しく","はげしく"],["彼","かれ"],["に"],["降った","ふった"],["ので"],["、"],["彼","かれ"],["は"],["手","て"],["に"],["何","なん"],["も"],["持たなくて","もたなくて"],["も"],["、"],["子山羊","こやぎ"],["を"],["裂く","さく"],["よう"],["に"],["獅子","しし"],["を"],["裂いた","さいた"],["。"],["しかし"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["行った","おこなった"],["こと"],["を"],["父母","ふぼ"],["に"],["は"],["言わなかった","いわなかった"],["。"]]},{"verse":7,"text":"彼は、女のところに下って行って言葉をかけた。サムソンは彼女が好きであった。","tok":[["彼","かれ"],["は"],["、"],["女","おんな"],["の"],["ところ"],["に"],["下って","くだって"],["行って","いって"],["言葉","ことば"],["を"],["かけた"],["。"],["サムソン"],["は"],["彼女","かのじょ"],["が"],["好き","すき"],["で"],["あった"],["。"]]},{"verse":8,"text":"しばらくして彼は彼女を迎えに戻って行ったが、あの獅子の屍を見ようと脇道にそれたところ、獅子の死骸には蜜蜂の群れがいて、蜜があった。","tok":[["しばらく"],["して"],["彼","かれ"],["は"],["彼女","かのじょ"],["を"],["迎え","むかえ"],["に"],["戻って","もどって"],["行った","いった"],["が"],["、"],["あの"],["獅子","しし"],["の"],["屍","しかばね"],["を"],["見よう","みよう"],["と"],["脇道","わきみち"],["に"],["それた"],["ところ"],["、"],["獅子","しし"],["の"],["死骸","しがい"],["に"],["は"],["蜜蜂","みつばち"],["の"],["群れ","むれ"],["が"],["いて"],["、"],["蜜","みつ"],["が"],["あった"],["。"]]},{"verse":9,"text":"彼は手で蜜をかき集め、歩きながら食べた。また父母のところに行ってそれを差し出したので、彼らも食べた。しかし、その蜜が獅子の死骸からかき集めたものだとは言わなかった。","tok":[["彼","かれ"],["は"],["手","て"],["で"],["蜜","みつ"],["を"],["かき集め","かきあつめ"],["、"],["歩き","あるき"],["ながら"],["食べた","たべた"],["。"],["また"],["父母","ふぼ"],["の"],["ところ"],["に"],["行って","いって"],["それ"],["を"],["差し出した","さしだした"],["ので"],["、"],["彼","かれ"],["ら"],["も"],["食べた","たべた"],["。"],["しかし"],["、"],["その"],["蜜","みつ"],["が"],["獅子","しし"],["の"],["死骸","しがい"],["から"],["かき集めた","かきあつめた"],["もの"],["だ"],["と"],["は"],["言わなかった","いわなかった"],["。"]]},{"verse":10,"text":"父がその女のところに下って来たとき、サムソンは若者たちの習慣に従い、宴会を催した。","tok":[["父","ちち"],["が"],["その"],["女","おんな"],["の"],["ところ"],["に"],["下って","くだって"],["来た","きた"],["とき"],["、"],["サムソン"],["は"],["若者","わかもの"],["たち"],["の"],["習慣","しゅうかん"],["に"],["従い","したがい"],["、"],["宴会","えんかい"],["を"],["催した","もよおした"],["。"]]},{"verse":11,"text":"サムソンを見て、人々は三十人の客を連れて来てサムソンと同席させた。","tok":[["サムソン"],["を"],["見て","みて"],["、"],["人々","ひとびと"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["客","きゃく"],["を"],["連れて","つれて"],["来て","きて"],["サムソン"],["と"],["同席","どうせき"],["させた"],["。"]]},{"verse":12,"text":"サムソンは彼らに言った。「あなたたちになぞをかけたい。宴会の続く七日の間にその意味を解き明かし、言い当てるなら、わたしは麻の衣三十着、着替えの衣三十着を差し上げる。","tok":[["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["に"],["なぞ"],["を"],["かけたい"],["。"],["宴会","えんかい"],["の"],["続く","つづく"],["七日","ななか"],["の"],["間","あいだ"],["に"],["その"],["意味","いみ"],["を"],["解き明かし","ときあかし"],["、"],["言い当てるなら","いいあてるなら"],["、"],["わたし"],["は"],["麻","あさ"],["の"],["衣","ころも"],["三十","さんじゅう"],["着","ちゃく"],["、"],["着替え","きがえ"],["の"],["衣","ころも"],["三十","さんじゅう"],["着","ちゃく"],["を"],["差し上げる","さしあげる"],["。"]]},{"verse":13,"text":"もし解き明かせなかったなら、あなたたちが麻の衣三十着と、着替えの衣三十着を差し出すことにしよう。」彼らは、「なぞをかけてもらおう。聞こうではないか」と応じた。","tok":[["もし"],["解き明かせなかったなら","ときあかせなかったなら"],["、"],["あなた"],["たち"],["が"],["麻","あさ"],["の"],["衣","ころも"],["三十","さんじゅう"],["着","ちゃく"],["と"],["、"],["着替え","きがえ"],["の"],["衣","ころも"],["三十","さんじゅう"],["着","ちゃく"],["を"],["差し出す","さしだす"],["こと"],["に"],["しよう"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["「"],["なぞ"],["を"],["かけて"],["もらおう"],["。"],["聞こうで","きこうで"],["は"],["ない"],["か"],["」"],["と"],["応じた","おうじた"],["。"]]},{"verse":14,"text":"サムソンは言った。「食べる者から食べ物が出た。強いものから甘いものが出た。」彼らは三日たっても、このなぞが解けなかった。","tok":[["サムソン"],["は"],["言った","いった"],["。"],["「"],["食べる","たべる"],["者","もの"],["から"],["食べ物","たべもの"],["が"],["出た","でた"],["。"],["強い","つよい"],["もの"],["から"],["甘い","あまい"],["もの"],["が"],["出た","でた"],["。"],["」"],["彼","かれ"],["ら"],["は"],["三日","みっか"],["たって"],["も"],["、"],["この"],["なぞ"],["が"],["解けなかった","とけなかった"],["。"]]},{"verse":15,"text":"七日目になって、彼らはサムソンの妻に言った。「夫をうまく言いくるめて、あのなぞの意味を我々に明かすようにしてほしい。さもないと、火を放ってあなたを家族もろとも焼き殺してやる。まさか、我々からはぎ取るために招待したわけではないだろう。」","tok":[["七日目","ななかめ"],["に"],["なって"],["、"],["彼","かれ"],["ら"],["は"],["サムソン"],["の"],["妻","つま"],["に"],["言った","いった"],["。"],["「"],["夫","おっと"],["を"],["うまく"],["言いくるめて","いいくるめて"],["、"],["あの"],["なぞ"],["の"],["意味","いみ"],["を"],["我々","われわれ"],["に"],["明かす","あかす"],["よう"],["に"],["して"],["ほしい"],["。"],["さも"],["ない"],["と"],["、"],["火","ひ"],["を"],["放って","はなって"],["あなた"],["を"],["家族","かぞく"],["もろとも"],["焼き殺して","やきころして"],["やる"],["。"],["まさか"],["、"],["我々","われわれ"],["から"],["はぎ取る","はぎとる"],["ため"],["に"],["招待","しょうたい"],["した"],["わけ"],["で"],["は"],["ないだろう"],["。"],["」"]]},{"verse":16,"text":"サムソンの妻は、夫に泣きすがって言った。「あなたはただわたしを嫌うだけで、少しも愛してくださらず、わたしの同族の者にかけたなぞの意味を、このわたしにも明かそうとなさいません。」彼は答えた。「父にも母にも明かしていないのに、お前に明かすわけがないだろう。」","tok":[["サムソン"],["の"],["妻","つま"],["は"],["、"],["夫","おっと"],["に"],["泣き","なき"],["すがって"],["言った","いった"],["。"],["「"],["あなた"],["は"],["ただ"],["わたし"],["を"],["嫌う","きらう"],["だけ"],["で"],["、"],["少し","すこし"],["も"],["愛して","あいして"],["くださらず"],["、"],["わたし"],["の"],["同族","どうぞく"],["の"],["者","もの"],["に"],["かけた"],["なぞ"],["の"],["意味","いみ"],["を"],["、"],["この"],["わたし"],["に"],["も"],["明かそう","あかそう"],["と"],["なさいません"],["。"],["」"],["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["父","ちち"],["に"],["も"],["母","はは"],["に"],["も"],["明かして","あかして"],["いない"],["のに"],["、"],["お前","おまえ"],["に"],["明かす","あかす"],["わけ"],["が"],["ないだろう"],["。"],["」"]]},{"verse":17,"text":"宴会が行われた七日間、彼女は夫に泣きすがった。彼女がしつこくせがんだので、七日目に彼は彼女に明かしてしまった。彼女は同族の者にそのなぞを明かした。","tok":[["宴会","えんかい"],["が"],["行われた","おこなわれた"],["七","なな"],["日間","かかん"],["、"],["彼女","かのじょ"],["は"],["夫","おっと"],["に"],["泣き","なき"],["すがった"],["。"],["彼女","かのじょ"],["が"],["しつこく"],["せがんだ"],["ので"],["、"],["七日目","ななかめ"],["に"],["彼","かれ"],["は"],["彼女","かのじょ"],["に"],["明かして","あかして"],["しまった"],["。"],["彼女","かのじょ"],["は"],["同族","どうぞく"],["の"],["者","もの"],["に"],["その"],["なぞ"],["を"],["明かした","あかした"],["。"]]},{"verse":18,"text":"七日目のこと、日が沈む前に町の人々は彼に言った。「蜂蜜より甘いものは何か獅子より強いものは何か。」するとサムソンは言った。「わたしの雌牛で耕さなかったならわたしのなぞは解けなかっただろう。」","tok":[["七日目","ななかめ"],["の"],["こと"],["、"],["日","ひ"],["が"],["沈む","しずむ"],["前","まえ"],["に"],["町","まち"],["の"],["人々","ひと
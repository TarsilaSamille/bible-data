[{"verse":1,"text":"イスラエルの人々は、またも主の目に悪とされることを行ったので、主は彼らを四十年間、ペリシテ人の手に渡された。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["また"],["も"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["四十","よんじゅう"],["年間","ねんかん"],["、"],["ペリシテ"],["人","にん"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"]]},{"verse":2,"text":"その名をマノアという一人の男がいた。彼はダンの氏族に属し、ツォルアの出身であった。彼の妻は不妊の女で、子を産んだことがなかった。","tok":[["その"],["名","な"],["を"],["マノア"],["と"],["いう"],["一人","ひとり"],["の"],["男","おとこ"],["が"],["いた"],["。"],["彼","かれ"],["は"],["ダン"],["の"],["氏族","しぞく"],["に"],["属し","ぞくし"],["、"],["ツォルア"],["の"],["出身","しゅっしん"],["で"],["あった"],["。"],["彼","かれ"],["の"],["妻","つま"],["は"],["不妊","ふにん"],["の"],["女","おんな"],["で"],["、"],["子","こ"],["を"],["産んだ","うんだ"],["こと"],["が"],["なかった"],["。"]]},{"verse":3,"text":"主の御使いが彼女に現れて言った。「あなたは不妊の女で、子を産んだことがない。だが、身ごもって男の子を産むであろう。","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["が"],["彼女","かのじょ"],["に"],["現れて","あらわれて"],["言った","いった"],["。"],["「"],["あなた"],["は"],["不妊","ふにん"],["の"],["女","おんな"],["で"],["、"],["子","こ"],["を"],["産んだ","うんだ"],["こと"],["が"],["ない"],["。"],["だ"],["が"],["、"],["身ごもって","みごもって"],["男の子","おとこのこ"],["を"],["産むで","うむで"],["あろう"],["。"]]},{"verse":4,"text":"今後、ぶどう酒や強い飲み物を飲まず、汚れた物も一切食べないように気をつけよ。","tok":[["今後","こんご"],["、"],["ぶどう酒","ぶどうしゅ"],["や"],["強い","つよい"],["飲み物","のみもの"],["を"],["飲まず","のまず"],["、"],["汚れた","よごれた"],["物","もの"],["も"],["一切","いっさい"],["食べない","たべない"],["よう"],["に"],["気","き"],["を"],["つけよ"],["。"]]},{"verse":5,"text":"あなたは身ごもって男の子を産む。その子は胎内にいるときから、ナジル人として神にささげられているので、その子の頭にかみそりを当ててはならない。彼は、ペリシテ人の手からイスラエルを解き放つ救いの先駆者となろう。」","tok":[["あなた"],["は"],["身ごもって","みごもって"],["男の子","おとこのこ"],["を"],["産む","うむ"],["。"],["その"],["子","こ"],["は"],["胎内","たいない"],["に"],["いる"],["とき"],["から"],["、"],["ナジル人","なじるにん"],["として"],["神","かみ"],["に"],["ささげられて"],["いる"],["ので"],["、"],["その"],["子","こ"],["の"],["頭","あたま"],["に"],["かみそり"],["を"],["当てて","あてて"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["、"],["ペリシテ"],["人","にん"],["の"],["手","て"],["から"],["イスラエル"],["を"],["解き放つ","ときはなつ"],["救い","すくい"],["の"],["先駆者","せんくしゃ"],["と"],["なろう"],["。"],["」"]]},{"verse":6,"text":"女は夫のもとに来て言った。「神の人がわたしのところにおいでになりました。姿は神の御使いのようで、非常に恐ろしく、どこからおいでになったのかと尋ねることもできず、その方も名前を明かされませんでした。","tok":[["女","おんな"],["は"],["夫","おっと"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["神","かみ"],["の"],["人","ひと"],["が"],["わたし"],["の"],["ところ"],["に"],["おいで"],["に"],["なりました"],["。"],["姿","すがた"],["は"],["神","かみ"],["の"],["御使い","おつかい"],["の"],["よう"],["で"],["、"],["非常","ひじょう"],["に"],["恐ろしく","おそろしく"],["、"],["どこ"],["から"],["おいで"],["に"],["なった"],["の"],["か"],["と"],["尋ねる","たずねる"],["こと"],["も"],["できず"],["、"],["その"],["方","かた"],["も"],["名前","なまえ"],["を"],["明かされませんでした","あかされませんでした"],["。"]]},{"verse":7,"text":"ただその方は、わたしが身ごもって男の子を産むことになっており、その子は胎内にいるときから死ぬ日までナジル人として神にささげられているので、わたしにぶどう酒や強い飲み物を飲まず、汚れた物も一切食べないようにとおっしゃいました。」","tok":[["ただ"],["その"],["方","かた"],["は"],["、"],["わたし"],["が"],["身ごもって","みごもって"],["男の子","おとこのこ"],["を"],["産む","うむ"],["こと"],["に"],["なって"],["おり"],["、"],["その"],["子","こ"],["は"],["胎内","たいない"],["に"],["いる"],["とき"],["から"],["死ぬ","しぬ"],["日","ひ"],["まで"],["ナジル人","なじるにん"],["として"],["神","かみ"],["に"],["ささげられて"],["いる"],["ので"],["、"],["わたし"],["に"],["ぶどう酒","ぶどうしゅ"],["や"],["強い","つよい"],["飲み物","のみもの"],["を"],["飲まず","のまず"],["、"],["汚れた","よごれた"],["物","もの"],["も"],["一切","いっさい"],["食べない","たべない"],["よう"],["に"],["と"],["おっしゃいました"],["。"],["」"]]},{"verse":8,"text":"そこでマノアは、主に向かってこう祈った。「わたしの主よ。お願いいたします。お遣わしになった神の人をもう一度わたしたちのところに来させ、生まれて来る子をどうすればよいのか教えてください。」","tok":[["そこ"],["で"],["マノア"],["は"],["、"],["主に","おもに"],["向かって","むかって"],["こう"],["祈った","いのった"],["。"],["「"],["わたし"],["の"],["主","ぬし"],["よ"],["。"],["お願い","おねがい"],["いたします"],["。"],["お遣わし","おつかわし"],["に"],["なった"],["神","かみ"],["の"],["人","ひと"],["を"],["もう"],["一度","いちど"],["わたしたち"],["の"],["ところ"],["に"],["来させ","きさせ"],["、"],["生まれて","うまれて"],["来る","くる"],["子","こ"],["を"],["どう"],["すれば"],["よい"],["の"],["か"],["教えて","おしえて"],["ください"],["。"],["」"]]},{"verse":9,"text":"神はマノアの声をお聞き入れになり、神の御使いが、再びその妻のところに現れた。彼女は畑に座っていて、夫マノアは一緒にいなかった。","tok":[["神","かみ"],["は"],["マノア"],["の"],["声","こえ"],["を"],["お聞き入れ","おききいれ"],["に"],["なり"],["、"],["神","かみ"],["の"],["御使い","おつかい"],["が"],["、"],["再び","ふたたび"],["その"],["妻","つま"],["の"],["ところ"],["に"],["現れた","あらわれた"],["。"],["彼女","かのじょ"],["は"],["畑","はたけ"],["に"],["座って","すわって"],["いて"],["、"],["夫","おっと"],["マノア"],["は"],["一緒","いっしょ"],["に"],["いなかった"],["。"]]},{"verse":10,"text":"妻は急いで夫に知らせようとして走り、「この間わたしのところにおいでになった方が、またお見えになっています」と言った。","tok":[["妻","つま"],["は"],["急いで","いそいで"],["夫","おっと"],["に"],["知らせよう","しらせよう"],["として"],["走り","はしり"],["、"],["「"],["この"],["間","あいだ"],["わたし"],["の"],["ところ"],["に"],["おいで"],["に"],["なった"],["方","ほう"],["が"],["、"],["また"],["お見え","おみえ"],["に"],["なって"],["います"],["」"],["と"],["言った","いった"],["。"]]},{"verse":11,"text":"マノアは立ち上がって妻について行き、その人のところに来て言った。「この女に話しかけたのはあなたですか。」その人は、「そうです」と答えた。","tok":[["マノア"],["は"],["立ち上がって","たちあがって"],["妻","つま"],["について"],["行き","いき"],["、"],["その"],["人","ひと"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["この"],["女","おんな"],["に"],["話しかけた","はなしかけた"],["の"],["は"],["あなた"],["です"],["か"],["。"],["」"],["その"],["人","ひと"],["は"],["、"],["「"],["そう"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":12,"text":"マノアが、「あなたのお言葉のとおりになるのでしたら、その子のためになすべき決まりとは何でしょうか」と尋ねると、","tok":[["マノア"],["が"],["、"],["「"],["あなた"],["の"],["お言葉","おことば"],["の"],["とおり"],["に"],["なる"],["の"],["でしたら"],["、"],["その"],["子","こ"],["の"],["ため"],["に"],["なすべき"],["決まり","きまり"],["と"],["は"],["何","なん"],["でしょう"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"]]},{"verse":13,"text":"主の御使いはマノアに答えた。「わたしがこの女に言ったことをすべて守りなさい。","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["は"],["マノア"],["に"],["答えた","こたえた"],["。"],["「"],["わたし"],["が"],["この"],["女","おんな"],["に"],["言った","いった"],["こと"],["を"],["すべて"],["守り","まもり"],["なさい"],["。"]]},{"verse":14,"text":"彼女はぶどう酒を作るぶどうの木からできるものは一切食べてはならず、ぶどう酒や強い飲み物も飲んではならない。また汚れた物を一切食べてはならない。わたしが彼女に戒めたことは、すべて守らなければならない。」","tok":[["彼女","かのじょ"],["は"],["ぶどう酒","ぶどうしゅ"],["を"],["作る","つくる"],["ぶどう"],["の"],["木","き"],["から"],["できる"],["もの"],["は"],["一切","いっさい"],["食べて","たべて"],["は"],["ならず"],["、"],["ぶどう酒","ぶどうしゅ"],["や"],["強い","つよい"],["飲み物","のみもの"],["も"],["飲んで","のんで"],["は"],["ならない"],["。"],["また"],["汚れた","よごれた"],["物","もの"],["を"],["一切","いっさい"],["食べて","たべて"],["は"],["ならない"],["。"],["わたし"],["が"],["彼女","かのじょ"],["に"],["戒めた","いましめた"],["こと"],["は"],["、"],["すべて"],["守らなければ","まもらなければ"],["ならない"],["。"],["」"]]},{"verse":15,"text":"マノアは主の御使いに言った。「あなたをお引き止めしてもよいでしょうか。子山羊をごちそうさせてください。」","tok":[["マノア"],["は"],["主","ぬし"],["の"],["御使い","おつかい"],["に"],["言った","いった"],["。"],["「"],["あなた"],["を"],["お引き止め","おひきとめ"],["して"],["も"],["よいでしょう"],["か"],["。"],["子山羊","こやぎ"],["を"],["ごちそう"],["させて"],["ください"],["。"],["」"]]},{"verse":16,"text":"主の御使いはマノアに答えた。「あなたが引き止めても、わたしはあなたの食べ物を食べない。もし焼き尽くす献げ物をささげたいなら、主にささげなさい。」マノアは、その人が主の御使いであることを知らなかった。","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["は"],["マノア"],["に"],["答えた","こたえた"],["。"],["「"],["あなた"],["が"],["引き止めて","ひきとめて"],["も"],["、"],["わたし"],["は"],["あなた"],["の"],["食べ物","たべもの"],["を"],["食べない","たべない"],["。"],["もし"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげたいなら"],["、"],["主に","おもに"],["ささげ"],["なさい"],["。"],["」"],["マノア"],["は"],["、"],["その"],["人","ひと"],["が"],["主","ぬし"],["の"],["御使い","おつかい"],["で"],["ある"],["こと"],["を"],["知らなかった","しらなかった"],["。"]]},{"verse":17,"text":"そこでマノアは主の御使いに、「お名前は何とおっしゃいますか。お言葉のとおりになりましたなら、あなたをおもてなししたいのです」と言った。","tok":[["そこ"],["で"],["マノア"],["は"],["主","ぬし"],["の"],["御使い","おつかい"],["に"],["、"],["「"],["お名前","おなまえ"],["は"],["何","なん"],["と"],["おっしゃいます"],["か"],["。"],["お言葉","おことば"],["の"],["とおり"],["に"],["なりましたなら"],["、"],["あなた"],["を"],["おもてなし"],["したい"],["の"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":18,"text":"主の御使いは、「なぜわたしの名を尋ねるのか。それは不思議と言う」と答えた。","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["は"],["、"],["「"],["なぜ"],["わたし"],["の"],["名","な"],["を"],["尋ねる","たずねる"],["の"],["か"],["。"],["それ"],["は"],["不思議","ふしぎ"],["と"],["言う","ゆう"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":19,"text":"マノアは子山羊と穀物の献げ物を携え、岩の上に上って主、不思議なことをなさる方にささげようとした。マノアとその妻は見ていた。","tok":[["マノア"],["は"],["子山羊","こやぎ"],["と"],["穀物","こくもつ"],["の"],["献げ物","ささげもの"],["を"],["携え","たずさえ"],["、"],["岩","いわ"],["の"],["上","うえ"],["に"],["上って","のぼって"],["主","ぬし"],["、"],["不思議","ふしぎ"],["な"],["こと"],["を"],["なさる"],["方","かた"],["に"],["ささげよう"],["と"],["した"],["。"],["マノア"],["と"],["その"],["妻","つま"],["は"],["見て","みて"],["いた"],["。"]]},{"verse":20,"text":"すると、祭壇から炎が天に上るとき、主の御使いも、その祭壇の炎と共に上って行った。マノアとその妻はそれを見て、ひれ伏して顔を地につけた。","tok":[["する"],["と"],["、"],["祭壇","さいだん"],["から"],["炎","ほのお"],["が"],["天","てん"],["に"],["上る","のぼる"],["とき"],["、"],["主","ぬし"],["の"],["御使い","おつかい"],["も"],["、"],["その"],["祭壇","さいだん"],["の"],["炎","ほのお"],["と"],["共","とも"],["に"],["上って","のぼって"],["行った","いった"],["。"],["マノア"],["と"],["その"],["妻","つま"],["は"],["それ"],["を"],["見て","みて"],["、"],["ひれ伏して","ひれふして"],["顔","かお"],["を"],["地","ち"],["に"],["つけた"],["。"]]},{"verse":21,"text":"主の御使いは再びマノアとその妻に現れることがなかった。マノアはそのとき、この方が主の御使いであったことを知った。","tok":[["主","ぬし"],["の"],["御使い","おつかい"],["は"],["再び","ふたたび"],["マノア"],["と"],["その"],["妻","つま"],["に"],["現れる","あらわれる"],["こと"],["が"],["なかった"],["。"],["マノア"],["は"],["その"],["とき"],["、"],["この"],["方","ほう"],["が"],["主","ぬし"],["の"],["御使い","おつかい"],["で"],["あった"],["こと"],["を"],["知った","しった"],["。"]]},{"verse":22,"text":"マノアは妻に、「わたしたちは神を見てしまったから、死なねばなるまい」と言った。","tok":[["マノア"],["は"],["妻","つま"],["に"],["、"],["「"],["わたしたち"],["は"],["神","かみ"],["を"],["見て","みて"],["しまった"],["から"],["、"],["死なねば","しなねば"],["なるまい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":23,"text":"だが妻は、「もし主がわたしたちを死なせようとお望みなら、わたしたちの手から焼き尽くす献げ物と穀物の献げ物をお受け取りにならなかったはずです。このようなことを一切お見せにならず、今こうした事をお告げにもならなかったはずです」と答えた。","tok":[["だ"],["が"],["妻","つま"],["は"],["、"],["「"],["もし"],["主","ぬし"],["が"],["わたしたち"],["を"],["死なせよう","しなせよう"],["と"],["お望みなら","おのぞみなら"],["、"],["わたしたち"],["の"],["手","て"],["から"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["穀物","こくもつ"],["の"],["献げ物","ささげもの"],["を"],["お受け取り","おうけとり"],["に"],["ならなかった"],["はず"],["です"],["。"],["この"],["よう"],["な"],["こと"],["を"],["一切","いっさい"],["お見せ","おみせ"],["に"],["ならず"],["、"],["今","いま"],["こう"],["した"],["事","こと"],["を"],["お告げ","おつげ"],["に"],["も"],["ならなかった"],["はず"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":24,"text":"この女は男の子を産み、その名をサムソンと名付けた。子は成長し、主はその子を祝福された。","tok":[["この"],["女","おんな"],["は"],["男の子","おとこのこ"],["を"],["産み","うみ"],["、"],["その"],["名","な"],["を"],["サムソン"],["と"],["名付けた","なづけた"],["。"],["子","こ"],["は"],["成長","せいちょう"],["し"],["、"],["主","ぬし"],["は"],["その"],["子","こ"],["を"],["祝福","しゅくふく"],["された"],["。"]]},{"verse":25,"text":"主の霊が彼を奮い立たせ始めたのは、彼がツォルアとエシュタオルの間にあるマハネ‧ダンにいたときのことであった。","tok":[["主","ぬし"],["の"],["霊","れい"],["が"],["彼","かれ"],["を"],["奮い立たせ","ふるいたたせ"],["始めた","はじめた"],["の"],["は"],["、"],["彼","かれ"],["が"],["ツォルア"],["と"],["エシュタオル"],["の"],["間","あいだ"],["に"],["ある"],["マハネ"],["‧"],["ダン"],["に"],["いた"],["とき"],["の"],["こと"],["で"],["あった"],["。"]]}]
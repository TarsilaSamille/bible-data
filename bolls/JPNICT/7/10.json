[{"verse":1,"text":"アビメレクの後、ドドの孫でプアの子であるイサカル人トラが、イスラエルを救うために立ち上がった。彼はエフライムの山地のシャミルに住み、","tok":[["アビメレク"],["の"],["後","あと"],["、"],["ドド"],["の"],["孫","まご"],["で"],["プア"],["の"],["子","こ"],["で"],["ある"],["イサカル"],["人","にん"],["トラ"],["が"],["、"],["イスラエル"],["を"],["救う","すくう"],["ため"],["に"],["立ち上がった","たちあがった"],["。"],["彼","かれ"],["は"],["エフライム"],["の"],["山地","さんち"],["の"],["シャミル"],["に"],["住み","すみ"],["、"]]},{"verse":2,"text":"二十三年間、士師としてイスラエルを裁いた。彼は死んで、シャミルに葬られた。","tok":[["二十三","にじゅうさん"],["年間","ねんかん"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"],["彼","かれ"],["は"],["死んで","しんで"],["、"],["シャミル"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":3,"text":"その後、ギレアド人ヤイルが立ち上がり、二十二年間、士師としてイスラエルを裁いた。","tok":[["その"],["後","ご"],["、"],["ギレアド"],["人","にん"],["ヤイル"],["が"],["立ち上がり","たちあがり"],["、"],["二十二","にじゅうに"],["年間","ねんかん"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"]]},{"verse":4,"text":"彼には三十人の息子があった。彼らは三十頭のろばに乗り、三十の町を持っていた。それらは今日もハボト‧ヤイルと呼ばれ、ギレアドの地にある。","tok":[["彼","かれ"],["に"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["息子","むすこ"],["が"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["三十頭","さんじゅうとう"],["の"],["ろば"],["に"],["乗り","のり"],["、"],["三十","さんじゅう"],["の"],["町","まち"],["を"],["持って","もって"],["いた"],["。"],["それ"],["ら"],["は"],["今日","きょう"],["も"],["ハボト"],["‧"],["ヤイル"],["と"],["呼ばれ","よばれ"],["、"],["ギレアド"],["の"],["地","ち"],["に"],["ある"],["。"]]},{"verse":5,"text":"ヤイルは死んで、カモンに葬られた。","tok":[["ヤイル"],["は"],["死んで","しんで"],["、"],["カモン"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":6,"text":"イスラエルの人々は、またも主の目に悪とされることを行い、バアルやアシュトレト、アラムの神々、シドンの神々、モアブの神々、アンモン人の神々、ペリシテ人の神々に仕えた。彼らは主を捨て、主に仕えなかった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["また"],["も"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行い","おこない"],["、"],["バアル"],["や"],["アシュトレト"],["、"],["アラム"],["の"],["神々","かみがみ"],["、"],["シドン"],["の"],["神々","かみがみ"],["、"],["モアブ"],["の"],["神々","かみがみ"],["、"],["アンモン"],["人","にん"],["の"],["神々","かみがみ"],["、"],["ペリシテ"],["人","にん"],["の"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["。"],["彼","かれ"],["ら"],["は"],["主","ぬし"],["を"],["捨て","すて"],["、"],["主に","おもに"],["仕えなかった","つかえなかった"],["。"]]},{"verse":7,"text":"主はイスラエルに対して怒りに燃え、彼らをペリシテ人とアンモン人の手に売り渡された。","tok":[["主","ぬし"],["は"],["イスラエル"],["に対して","にたいして"],["怒り","いかり"],["に"],["燃え","もえ"],["、"],["彼","かれ"],["ら"],["を"],["ペリシテ"],["人","にん"],["と"],["アンモン"],["人","にん"],["の"],["手","て"],["に"],["売り渡された","うりわたされた"],["。"]]},{"verse":8,"text":"敵は、その年から十八年間、イスラエルの人々、ヨルダンの向こう側ギレアドにあるアモリ人の地にいるすべてのイスラエルの人々を打ち砕き、打ちのめした。","tok":[["敵","てき"],["は"],["、"],["その"],["年","とし"],["から"],["十八","じゅうはち"],["年間","ねんかん"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["、"],["ヨルダン"],["の"],["向こう側","むこうがわ"],["ギレアド"],["に"],["ある"],["アモリ人","あもりにん"],["の"],["地","ち"],["に"],["いる"],["すべて"],["の"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["打ち砕き","うちくだき"],["、"],["打ちのめした","うちのめした"],["。"]]},{"verse":9,"text":"アンモン人はヨルダンを渡って、ユダ、ベニヤミン、エフライムの家にも攻撃を仕掛けて来たので、イスラエルは苦境に立たされた。","tok":[["アンモン"],["人","にん"],["は"],["ヨルダン"],["を"],["渡って","わたって"],["、"],["ユダ"],["、"],["ベニヤミン"],["、"],["エフライム"],["の"],["家","いえ"],["に"],["も"],["攻撃","こうげき"],["を"],["仕掛けて","しかけて"],["来た","きた"],["ので"],["、"],["イスラエル"],["は"],["苦境","くきょう"],["に"],["立たされた","たたされた"],["。"]]},{"verse":10,"text":"イスラエルの人々は、主に助けを求めて叫んだ。「わたしたちはあなたに罪を犯しました。わたしたちの神を捨て、バアルに仕えました。」","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["主に","おもに"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んだ","さけんだ"],["。"],["「"],["わたしたち"],["は"],["あなた"],["に"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["わたしたち"],["の"],["神","かみ"],["を"],["捨て","すて"],["、"],["バアル"],["に"],["仕えました","つかえました"],["。"],["」"]]},{"verse":11,"text":"主は、イスラエルの人々に言われた。「エジプト人、アモリ人、アンモン人、ペリシテ人、","tok":[["主","ぬし"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言われた","いわれた"],["。"],["「"],["エジプト"],["人","にん"],["、"],["アモリ人","あもりにん"],["、"],["アンモン"],["人","にん"],["、"],["ペリシテ"],["人","にん"],["、"]]},{"verse":12,"text":"シドン人、アマレク、マオンがあなたたちを圧迫し、あなたたちがわたしに助けを求めて叫んだとき、わたしは彼らの手からあなたたちを救ったではないか。","tok":[["シドン人","しどんにん"],["、"],["アマレク"],["、"],["マオン"],["が"],["あなた"],["たち"],["を"],["圧迫","あっぱく"],["し"],["、"],["あなた"],["たち"],["が"],["わたし"],["に"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んだ","さけんだ"],["とき"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["手","て"],["から"],["あなた"],["たち"],["を"],["救ったで","すくったで"],["は"],["ない"],["か"],["。"]]},{"verse":13,"text":"しかし、あなたたちはわたしを捨て、他の神々に仕えた。それゆえ、わたしはもうあなたたちを救わない。","tok":[["しかし"],["、"],["あなた"],["たち"],["は"],["わたし"],["を"],["捨て","すて"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["。"],["それ"],["ゆえ"],["、"],["わたし"],["は"],["もう"],["あなた"],["たち"],["を"],["救わない","すくわない"],["。"]]},{"verse":14,"text":"あなたたちの選んだ神々のもとに行って、助けを求めて叫ぶがよい。苦境に立たされたときには、その神々が救ってくれよう。」","tok":[["あなた"],["たち"],["の"],["選んだ","えらんだ"],["神々","かみがみ"],["の"],["もと"],["に"],["行って","いって"],["、"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫ぶ","さけぶ"],["が"],["よい"],["。"],["苦境","くきょう"],["に"],["立たされた","たたされた"],["とき"],["に"],["は"],["、"],["その"],["神々","かみがみ"],["が"],["救って","すくって"],["くれよう"],["。"],["」"]]},{"verse":15,"text":"イスラエルの人々は主に言った。「わたしたちは罪を犯しました。わたしたちに対して何事でも御目にかなうことを行ってください。ただ、今日わたしたちを救い出してください。」","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["主に","おもに"],["言った","いった"],["。"],["「"],["わたしたち"],["は"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["わたしたち"],["に対して","にたいして"],["何事","なにごと"],["で"],["も"],["御目","おめ"],["に"],["かなう"],["こと"],["を"],["行って","おこなって"],["ください"],["。"],["ただ"],["、"],["今日","きょう"],["わたしたち"],["を"],["救い出して","すくいだして"],["ください"],["。"],["」"]]},{"verse":16,"text":"彼らが異国の神々を自分たちの中から一掃し、主に仕えるようになったので、主はイスラエルの苦しみが耐えられなくなった。","tok":[["彼","かれ"],["ら"],["が"],["異国","いこく"],["の"],["神々","かみがみ"],["を"],["自分","じぶん"],["たち"],["の"],["中","なか"],["から"],["一掃","いっそう"],["し"],["、"],["主に","おもに"],["仕える","つかえる"],["よう"],["に"],["なった"],["ので"],["、"],["主","ぬし"],["は"],["イスラエル"],["の"],["苦しみ","くるしみ"],["が"],["耐えられなく","たえられなく"],["なった"],["。"]]},{"verse":17,"text":"アンモンの人々は集結してギレアドに陣を敷き、イスラエルの人々も集まってミツパに陣を敷いた。","tok":[["アンモン"],["の"],["人々","ひとびと"],["は"],["集結","しゅうけつ"],["して"],["ギレアド"],["に"],["陣","じん"],["を"],["敷き","しき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["も"],["集まって","あつまって"],["ミツパ"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"]]},{"verse":18,"text":"民ギレアドの指導者たちは互いに言い合った。「アンモンの人々に戦いを仕掛けるのは誰だろうか。その人が、ギレアド全住民の頭となろう。」","tok":[["民","みん"],["ギレアド"],["の"],["指導者","しどうしゃ"],["たち"],["は"],["互い","たがい"],["に"],["言い合った","いいあった"],["。"],["「"],["アンモン"],["の"],["人々","ひとびと"],["に"],["戦い","たたかい"],["を"],["仕掛ける","しかける"],["の"],["は"],["誰","だれ"],["だろう"],["か"],["。"],["その"],["人","ひと"],["が"],["、"],["ギレアド"],["全住民","ぜんじゅうみん"],["の"],["頭","あたま"],["と"],["なろう"],["。"],["」"]]}]
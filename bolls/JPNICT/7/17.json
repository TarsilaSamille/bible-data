[{"verse":1,"text":"エフライムの山地に名をミカという男がいて、","tok":[["エフライム"],["の"],["山地","さんち"],["に"],["名","な"],["を"],["ミカ"],["と"],["いう"],["男","おとこ"],["が"],["いて"],["、"]]},{"verse":2,"text":"母に言った。「銀千百シェケルが奪われたとき、あなたは呪い、そのことをわたしにも話してくれました。その銀はわたしが持っています。実はわたしが奪ったのです。」母は言った。「わたしの息子に主の祝福がありますように。」","tok":[["母","はは"],["に"],["言った","いった"],["。"],["「"],["銀","ぎん"],["千百","せんひゃく"],["シェケル"],["が"],["奪われた","うばわれた"],["とき"],["、"],["あなた"],["は"],["呪い","のろい"],["、"],["その"],["こと"],["を"],["わたし"],["に"],["も"],["話して","はなして"],["くれました"],["。"],["その"],["銀","ぎん"],["は"],["わたし"],["が"],["持って","もって"],["います"],["。"],["実","じつ"],["は"],["わたし"],["が"],["奪った","うばった"],["の"],["です"],["。"],["」"],["母","はは"],["は"],["言った","いった"],["。"],["「"],["わたし"],["の"],["息子","むすこ"],["に"],["主","ぬし"],["の"],["祝福","しゅくふく"],["が"],["あります"],["よう"],["に"],["。"],["」"]]},{"verse":3,"text":"彼が母に銀千百シェケルを返すと、母は言った。「息子のために彫像と鋳像を造っていただこうとして、この銀はこの手で聖別し、主におささげしたものです。今これをあなたに返します。」","tok":[["彼","かれ"],["が"],["母","はは"],["に"],["銀","ぎん"],["千百","せんひゃく"],["シェケル"],["を"],["返す","かえす"],["と"],["、"],["母","はは"],["は"],["言った","いった"],["。"],["「"],["息子","むすこ"],["の"],["ため"],["に"],["彫像","ちょうぞう"],["と"],["鋳像","ちゅうぞう"],["を"],["造って","つくって"],["いただこう"],["として"],["、"],["この"],["銀","ぎん"],["は"],["この"],["手","て"],["で"],["聖別","せいべつ"],["し"],["、"],["主に","おもに"],["おささげ"],["した"],["もの"],["です"],["。"],["今","いま"],["これ"],["を"],["あなた"],["に"],["返します","かえします"],["。"],["」"]]},{"verse":4,"text":"彼が銀を母に返すと、母は銀二百シェケルを取って銀細工師に渡し、彫像と鋳像を造らせた。ミカの家にあったのはそれである。","tok":[["彼","かれ"],["が"],["銀","ぎん"],["を"],["母","はは"],["に"],["返す","かえす"],["と"],["、"],["母","はは"],["は"],["銀","ぎん"],["二百","にひゃく"],["シェケル"],["を"],["取って","とって"],["銀","ぎん"],["細工師","さいくし"],["に"],["渡し","わたし"],["、"],["彫像","ちょうぞう"],["と"],["鋳像","ちゅうぞう"],["を"],["造らせた","つくらせた"],["。"],["ミカ"],["の"],["家","いえ"],["に"],["あった"],["の"],["は"],["それ"],["で"],["ある"],["。"]]},{"verse":5,"text":"このミカという男は神殿をもっており、エフォドとテラフィムを造って、息子の一人の手を満たして自分の祭司にしていた。","tok":[["この"],["ミカ"],["と"],["いう"],["男","おとこ"],["は"],["神殿","しんでん"],["を"],["もって"],["おり"],["、"],["エフォド"],["と"],["テラフィム"],["を"],["造って","つくって"],["、"],["息子","むすこ"],["の"],["一人","ひとり"],["の"],["手","て"],["を"],["満たして","みたして"],["自分","じぶん"],["の"],["祭司","さいし"],["に"],["して"],["いた"],["。"]]},{"verse":6,"text":"そのころイスラエルには王がなく、それぞれが自分の目に正しいとすることを行っていた。","tok":[["その"],["ころ"],["イスラエル"],["に"],["は"],["王","おう"],["が"],["なく"],["、"],["それぞれ"],["が"],["自分","じぶん"],["の"],["目","め"],["に"],["正しい","ただしい"],["と"],["する"],["こと"],["を"],["行って","おこなって"],["いた"],["。"]]},{"verse":7,"text":"ユダのベツレヘムに、ユダ族の一人の若者がいた。彼はレビ人でそこに寄留していた。","tok":[["ユダ"],["の"],["ベツレヘム"],["に"],["、"],["ユダ族","ゆだぞく"],["の"],["一人","ひとり"],["の"],["若者","わかもの"],["が"],["いた"],["。"],["彼","かれ"],["は"],["レビ人","れびにん"],["で"],["そこ"],["に"],["寄留","きりゅう"],["して"],["いた"],["。"]]},{"verse":8,"text":"適当な寄留地を求めて、その人はユダのベツレヘムの町を離れ、旅を続けてエフライムの山地にあるミカの家まで来た。","tok":[["適当","てきとう"],["な"],["寄留","きりゅう"],["地","ち"],["を"],["求めて","もとめて"],["、"],["その"],["人","ひと"],["は"],["ユダ"],["の"],["ベツレヘム"],["の"],["町","まち"],["を"],["離れ","はなれ"],["、"],["旅","たび"],["を"],["続けて","つづけて"],["エフライム"],["の"],["山地","さんち"],["に"],["ある"],["ミカ"],["の"],["家","いえ"],["まで"],["来た","きた"],["。"]]},{"verse":9,"text":"ミカが、「どちらからおいでになりましたか」と声をかけると、彼は、「わたしはレビ人で、ユダのベツレヘムから来ました。適当な寄留地を求めて歩いているのです」と答えた。","tok":[["ミカ"],["が"],["、"],["「"],["どちら"],["から"],["おいで"],["に"],["なりました"],["か"],["」"],["と"],["声","こえ"],["を"],["かける"],["と"],["、"],["彼","かれ"],["は"],["、"],["「"],["わたし"],["は"],["レビ人","れびにん"],["で"],["、"],["ユダ"],["の"],["ベツレヘム"],["から"],["来ました","きました"],["。"],["適当","てきとう"],["な"],["寄留","きりゅう"],["地","ち"],["を"],["求めて","もとめて"],["歩いて","あるいて"],["いる"],["の"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":10,"text":"ミカが、「わたしの家に住んで、父となり、祭司となってください。あなたには年に銀十シェケル、衣服一そろい、および食糧を差し上げます」と言った。レビ人は進み出た。","tok":[["ミカ"],["が"],["、"],["「"],["わたし"],["の"],["家","いえ"],["に"],["住んで","すんで"],["、"],["父","ちち"],["と"],["なり"],["、"],["祭司","さいし"],["と"],["なって"],["ください"],["。"],["あなた"],["に"],["は"],["年","ねん"],["に"],["銀","ぎん"],["十","じゅう"],["シェケル"],["、"],["衣服","いふく"],["一","いち"],["そろい"],["、"],["および"],["食糧","しょくりょう"],["を"],["差し上げます","さしあげます"],["」"],["と"],["言った","いった"],["。"],["レビ人","れびにん"],["は"],["進み出た","すすみでた"],["。"]]},{"verse":11,"text":"レビ人はその男と共に住むことに同意し、若者はその息子の一人のようになった。","tok":[["レビ人","れびにん"],["は"],["その"],["男","おとこ"],["と"],["共","とも"],["に"],["住む","すむ"],["こと"],["に"],["同意","どうい"],["し"],["、"],["若者","わかもの"],["は"],["その"],["息子","むすこ"],["の"],["一人","ひとり"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":12,"text":"ミカがこのレビ人の手を満たしたので、若者は祭司となり、ミカの家にとどまった。","tok":[["ミカ"],["が"],["この"],["レビ人","れびにん"],["の"],["手","て"],["を"],["満たした","みたした"],["ので"],["、"],["若者","わかもの"],["は"],["祭司","さいし"],["と"],["なり"],["、"],["ミカ"],["の"],["家","いえ"],["に"],["とどまった"],["。"]]},{"verse":13,"text":"ミカは、「レビ人がわたしの祭司になったのだから、今や主がわたしを幸せにしてくださることが分かった」と言った。","tok":[["ミカ"],["は"],["、"],["「"],["レビ人","れびにん"],["が"],["わたし"],["の"],["祭司","さいし"],["に"],["なった"],["の"],["だ"],["から"],["、"],["今","いま"],["や"],["主","ぬし"],["が"],["わたし"],["を"],["幸せ","しあわせ"],["に"],["して"],["くださる"],["こと"],["が"],["分かった","わかった"],["」"],["と"],["言った","いった"],["。"]]}]
[{"verse":1,"text":"カナン人とのいかなる戦いも知らないイスラエルとそのすべての者を試みるために用いようとして、主がとどまらせられた諸国の民は以下のとおりである。","tok":[["カナン人","かなんにん"],["と"],["の"],["いかなる"],["戦い","たたかい"],["も"],["知らない","しらない"],["イスラエル"],["と"],["その"],["すべて"],["の"],["者","もの"],["を"],["試みる","こころみる"],["ため"],["に"],["用いよう","もちいよう"],["として"],["、"],["主","ぬし"],["が"],["とどまらせられた"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["以下","いか"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"そうされたのは、ただ以前に戦いを知ることがなかったということで、そのイスラエルの人々の世代に戦いを学ばせるためにほかならなかった。","tok":[["そう"],["された"],["の"],["は"],["、"],["ただ"],["以前","いぜん"],["に"],["戦い","たたかい"],["を"],["知る","しる"],["こと"],["が"],["なかった"],["と"],["いう"],["こと"],["で"],["、"],["その"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["世代","せだい"],["に"],["戦い","たたかい"],["を"],["学ばせる","まなばせる"],["ため"],["に"],["ほか"],["ならなかった"],["。"]]},{"verse":3,"text":"ペリシテ人の五人の領主、すべてのカナン人、シドン人、バアル‧ヘルモンの山からレボ‧ハマトに及ぶレバノンの山地に住むヒビ人がそれである。","tok":[["ペリシテ"],["人","にん"],["の"],["五人","ごにん"],["の"],["領主","りょうしゅ"],["、"],["すべて"],["の"],["カナン人","かなんにん"],["、"],["シドン人","しどんにん"],["、"],["バアル"],["‧"],["ヘルモン"],["の"],["山","やま"],["から"],["レボ"],["‧"],["ハマト"],["に"],["及ぶ","およぶ"],["レバノン"],["の"],["山地","さんち"],["に"],["住む","すむ"],["ヒビ人","ひびにん"],["が"],["それ"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼らはイスラエルを試みるため、主がモーセによって先祖に授けられた戒めにイスラエルが聞き従うかどうかを知るためのものであった。","tok":[["彼","かれ"],["ら"],["は"],["イスラエル"],["を"],["試みる","こころみる"],["ため"],["、"],["主","ぬし"],["が"],["モーセ"],["によって"],["先祖","せんぞ"],["に"],["授けられた","さずけられた"],["戒め","いましめ"],["に"],["イスラエル"],["が"],["聞き従う","ききしたがう"],["か"],["どう"],["か"],["を"],["知る","しる"],["ため"],["の"],["もの"],["で"],["あった"],["。"]]},{"verse":5,"text":"しかし、イスラエルの人々はカナン人、ヘト人、アモリ人、ペリジ人、ヒビ人、エブス人の中に住んで、","tok":[["しかし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["カナン人","かなんにん"],["、"],["ヘト人","へとにん"],["、"],["アモリ人","あもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["中","なか"],["に"],["住んで","すんで"],["、"]]},{"verse":6,"text":"彼らの娘を妻に迎え、自分たちの娘を彼らの息子に嫁がせ、彼らの神々に仕えた。","tok":[["彼","かれ"],["ら"],["の"],["娘","むすめ"],["を"],["妻","つま"],["に"],["迎え","むかえ"],["、"],["自分","じぶん"],["たち"],["の"],["娘","むすめ"],["を"],["彼","かれ"],["ら"],["の"],["息子","むすこ"],["に"],["嫁がせ","とつがせ"],["、"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":7,"text":"イスラエルの人々は主の目に悪とされることを行い、彼らの神、主を忘れ、バアルとアシェラに仕えた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行い","おこない"],["、"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["忘れ","わすれ"],["、"],["バアル"],["と"],["アシェラ"],["に"],["仕えた","つかえた"],["。"]]},{"verse":8,"text":"主はイスラエルに対して怒りに燃え、彼らをアラム‧ナハライムの王クシャン‧リシュアタイムの手に売り渡されたので、イスラエルの人々は八年間、クシャン‧リシュアタイムに仕えなければならなかった。","tok":[["主","ぬし"],["は"],["イスラエル"],["に対して","にたいして"],["怒り","いかり"],["に"],["燃え","もえ"],["、"],["彼","かれ"],["ら"],["を"],["アラム"],["‧"],["ナハライム"],["の"],["王","おう"],["クシャン"],["‧"],["リシュアタイム"],["の"],["手","て"],["に"],["売り渡された","うりわたされた"],["ので"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["八","はち"],["年間","ねんかん"],["、"],["クシャン"],["‧"],["リシュアタイム"],["に"],["仕えなければ","つかえなければ"],["ならなかった"],["。"]]},{"verse":9,"text":"イスラエルの人々が主に助けを求めて叫んだので、主はイスラエルの人々のために一人の救助者を立て、彼らを救われた。これがカレブの弟ケナズの子オトニエルである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["主に","おもに"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んだ","さけんだ"],["ので"],["、"],["主","ぬし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["一人","ひとり"],["の"],["救助者","きゅうじょしゃ"],["を"],["立て","たて"],["、"],["彼","かれ"],["ら"],["を"],["救われた","すくわれた"],["。"],["これ"],["が"],["カレブ"],["の"],["弟","おとうと"],["ケナズ"],["の"],["子","こ"],["オトニエル"],["で"],["ある"],["。"]]},{"verse":10,"text":"主の霊が彼の上に臨み、彼は士師としてイスラエルを裁いた。彼が戦いに出ると、主は、アラムの王クシャン‧リシュアタイムを彼の手に渡してくださったので、彼の手はクシャン‧リシュアタイムを抑えることができた。","tok":[["主","ぬし"],["の"],["霊","れい"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["臨み","のぞみ"],["、"],["彼","かれ"],["は"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"],["彼","かれ"],["が"],["戦い","たたかい"],["に"],["出る","でる"],["と"],["、"],["主","ぬし"],["は"],["、"],["アラム"],["の"],["王","おう"],["クシャン"],["‧"],["リシュアタイム"],["を"],["彼","かれ"],["の"],["手","て"],["に"],["渡して","わたして"],["くださった"],["ので"],["、"],["彼","かれ"],["の"],["手","て"],["は"],["クシャン"],["‧"],["リシュアタイム"],["を"],["抑える","おさえる"],["こと"],["が"],["できた"],["。"]]},{"verse":11,"text":"国は四十年にわたって平穏であった。こうしてケナズの子オトニエルは死んだ。","tok":[["国","くに"],["は"],["四十","よんじゅう"],["年","ねん"],["に"],["わたって"],["平穏","へいおん"],["で"],["あった"],["。"],["こう"],["して"],["ケナズ"],["の"],["子","こ"],["オトニエル"],["は"],["死んだ","しんだ"],["。"]]},{"verse":12,"text":"イスラエルの人々は、またも主の目に悪とされることを行った。彼らが主の目に悪とされることを行ったので、主は、モアブの王エグロンを強くすることでイスラエルを脅かされた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["また"],["も"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["。"],["彼","かれ"],["ら"],["が"],["主","ぬし"],["の"],["目","め"],["に"],["悪","あく"],["と"],["される"],["こと"],["を"],["行った","おこなった"],["ので"],["、"],["主","ぬし"],["は"],["、"],["モアブ"],["の"],["王","おう"],["エグロン"],["を"],["強く","つよく"],["する"],["こと"],["で"],["イスラエル"],["を"],["脅かされた","おびやかされた"],["。"]]},{"verse":13,"text":"彼はアンモン人とアマレク人を集め、攻めて来てイスラエルを破り、なつめやしの町を占領した。","tok":[["彼","かれ"],["は"],["アンモン"],["人","にん"],["と"],["アマレク"],["人","にん"],["を"],["集め","あつめ"],["、"],["攻めて","せめて"],["来て","きて"],["イスラエル"],["を"],["破り","やぶり"],["、"],["なつめやし"],["の"],["町","まち"],["を"],["占領","せんりょう"],["した"],["。"]]},{"verse":14,"text":"こうしてイスラエルの人々は、十八年間、モアブの王エグロンに仕えなければならなかった。","tok":[["こう"],["して"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["十八","じゅうはち"],["年間","ねんかん"],["、"],["モアブ"],["の"],["王","おう"],["エグロン"],["に"],["仕えなければ","つかえなければ"],["ならなかった"],["。"]]},{"verse":15,"text":"イスラエルの人々が主に助けを求めて叫んだので、主は彼らのために一人の救助者を立てられた。これがベニヤミン族のゲラの子、左利きのエフドである。イスラエルの人々は貢ぎ物を彼の手に託して、モアブの王エグロンのもとに送った。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["主に","おもに"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫んだ","さけんだ"],["ので"],["、"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["一人","ひとり"],["の"],["救助者","きゅうじょしゃ"],["を"],["立てられた","たてられた"],["。"],["これ"],["が"],["ベニヤミン"],["族","ぞく"],["の"],["ゲラ"],["の"],["子","こ"],["、"],["左利き","ひだりきき"],["の"],["エフド"],["で"],["ある"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["貢ぎ物","みつぎもの"],["を"],["彼","かれ"],["の"],["手","て"],["に"],["託して","たくして"],["、"],["モアブ"],["の"],["王","おう"],["エグロン"],["の"],["もと"],["に"],["送った","おくった"],["。"]]},{"verse":16,"text":"エフドは刃渡り一ゴメドの両刃の剣を作り、それを右腰に帯びて上着で隠し、","tok":[["エフド"],["は"],["刃渡り","はわたり"],["一","いち"],["ゴメド"],["の"],["両刃","りょうば"],["の"],["剣","けん"],["を"],["作り","つくり"],["、"],["それ"],["を"],["右腰","みぎこし"],["に"],["帯びて","おびて"],["上着","うわぎ"],["で"],["隠し","かくし"],["、"]]},{"verse":17,"text":"モアブの王エグロンのもとに貢ぎ物を納めに行った。王は非常に太っていた。","tok":[["モアブ"],["の"],["王","おう"],["エグロン"],["の"],["もと"],["に"],["貢ぎ物","みつぎもの"],["を"],["納め","おさめ"],["に"],["行った","いった"],["。"],["王","おう"],["は"],["非常","ひじょう"],["に"],["太って","ふとって"],["いた"],["。"]]},{"verse":18,"text":"エフドは貢ぎ物を納め終わると、貢ぎ物を運んで来た者たちを去らせ、","tok":[["エフド"],["は"],["貢ぎ物","みつぎもの"],["を"],["納め","おさめ"],["終わる","おわる"],["と"],["、"],["貢ぎ物","みつぎもの"],["を"],["運んで","はこんで"],["来た","きた"],["者","もの"],["たち"],["を"],["去らせ","さらせ"],["、"]]},{"verse":19,"text":"自らはギルガルに近い偶像のあるところから引き返し、「王よ、内密の話がございます」と言った。王が、「黙れ」と言うと、そばにいた従臣たちは皆席をはずした。","tok":[["自ら","みずから"],["は"],["ギルガル"],["に"],["近い","ちかい"],["偶像","ぐうぞう"],["の"],["ある"],["ところ"],["から"],["引き返し","ひきかえし"],["、"],["「"],["王","おう"],["よ"],["、"],["内密","ないみつ"],["の"],["話","はなし"],["が"],["ございます"],["」"],["と"],["言った","いった"],["。"],["王","おう"],["が"],["、"],["「"],["黙れ","だまれ"],["」"],["と"],["言う","ゆう"],["と"],["、"],["そば"],["に"],["いた"],["従臣","じゅうしん"],["たち"],["は"],["皆","みな"],["席","せき"],["を"],["はずした"],["。"]]},{"verse":20,"text":"エフドは近づいたが、そのとき王は屋上にしつらえた涼しい部屋に座り、ただ一人になっていた。エフドが、「あなたへの神のお告げを持って来ました」と言うと、王は席から立ち上がった。","tok":[["エフド"],["は"],["近づいた","ちかづいた"],["が"],["、"],["その"],["とき"],["王","おう"],["は"],["屋上","おくじょう"],["に"],["しつらえた"],["涼しい","すずしい"],["部屋","へや"],["に"],["座り","すわり"],["、"],["ただ"],["一人","ひとり"],["に"],["なって"],["いた"],["。"],["エフド"],["が"],["、"],["「"],["あなた"],["へ"],["の"],["神","かみ"],["の"],["お告げ","おつげ"],["を"],["持って","もって"],["来ました","きました"],["」"],["と"],["言う","ゆう"],["と"],["、"],["王","おう"],["は"],["席","せき"],["から"],["立ち上がった","たちあがった"],["。"]]},{"verse":21,"text":"エフドは左手で右腰の剣を抜き、王の腹を刺した。","tok":[["エフド"],["は"],["左手","ひだりて"],["で"],["右腰","みぎこし"],["の"],["剣","けん"],["を"],["抜き","ぬき"],["、"],["王","おう"],["の"],["腹","はら"],["を"],["刺した","さした"],["。"]]},{"verse":
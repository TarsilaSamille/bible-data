[{"verse":1,"text":"しばらくして小麦の収穫のころ、サムソンは一匹の子山羊を携えて妻を訪ね、「妻の部屋に入りたい」と言ったが、彼女の父は入らせなかった。","tok":[["しばらく"],["して"],["小麦","こむぎ"],["の"],["収穫","しゅうかく"],["の"],["ころ"],["、"],["サムソン"],["は"],["一匹","いちひき"],["の"],["子山羊","こやぎ"],["を"],["携えて","たずさえて"],["妻","つま"],["を"],["訪ね","たずね"],["、"],["「"],["妻","つま"],["の"],["部屋","へや"],["に"],["入りたい","はいりたい"],["」"],["と"],["言った","いった"],["が"],["、"],["彼女","かのじょ"],["の"],["父","ちち"],["は"],["入らせなかった","はいらせなかった"],["。"]]},{"verse":2,"text":"父は言った。「わたしはあなたがあの娘を嫌ったものと思い、あなたの友に嫁がせた。妹の方がきれいではないか。その妹を代わりにあなたの妻にしてほしい。」","tok":[["父","ちち"],["は"],["言った","いった"],["。"],["「"],["わたし"],["は"],["あなた"],["が"],["あの"],["娘","むすめ"],["を"],["嫌った","きらった"],["もの"],["と"],["思い","おもい"],["、"],["あなた"],["の"],["友","とも"],["に"],["嫁がせた","とつがせた"],["。"],["妹","いもうと"],["の"],["方","ほう"],["が"],["きれい"],["で"],["は"],["ない"],["か"],["。"],["その"],["妹","いもうと"],["を"],["代わり","かわり"],["に"],["あなた"],["の"],["妻","つま"],["に"],["して"],["ほしい"],["。"],["」"]]},{"verse":3,"text":"サムソンは言った。「今度はわたしがペリシテ人に害を加えても、わたしには罪がない。」","tok":[["サムソン"],["は"],["言った","いった"],["。"],["「"],["今度","こんど"],["は"],["わたし"],["が"],["ペリシテ"],["人","にん"],["に"],["害","がい"],["を"],["加えて","くわえて"],["も"],["、"],["わたし"],["に"],["は"],["罪","つみ"],["が"],["ない"],["。"],["」"]]},{"verse":4,"text":"サムソンは出て行って、ジャッカルを三百匹捕らえ、松明を持って来て、ジャッカルの尾と尾を結び合わせ、その二つの尾の真ん中に松明を一本ずつ取り付けた。","tok":[["サムソン"],["は"],["出て","でて"],["行って","いって"],["、"],["ジャッカル"],["を"],["三百匹","さんひゃくひき"],["捕らえ","とらえ"],["、"],["松明","たいまつ"],["を"],["持って","もって"],["来て","きて"],["、"],["ジャッカル"],["の"],["尾","お"],["と"],["尾","お"],["を"],["結び合わせ","むすびあわせ"],["、"],["その"],["二","ふた"],["つ"],["の"],["尾","お"],["の"],["真ん中","まんなか"],["に"],["松明","たいまつ"],["を"],["一本","いちぽん"],["ずつ"],["取り付けた","とりつけた"],["。"]]},{"verse":5,"text":"その松明に火をつけると、彼はそれをペリシテ人の麦畑に送り込み、刈り入れた麦の山から麦畑、ぶどう畑、オリーブの木に至るまで燃やした。","tok":[["その"],["松明","たいまつ"],["に"],["火","ひ"],["を"],["つける"],["と"],["、"],["彼","かれ"],["は"],["それ"],["を"],["ペリシテ"],["人","にん"],["の"],["麦畑","むぎばたけ"],["に"],["送り込み","おくりこみ"],["、"],["刈り入れた","かりいれた"],["麦","むぎ"],["の"],["山","やま"],["から"],["麦畑","むぎばたけ"],["、"],["ぶどう"],["畑","はたけ"],["、"],["オリーブ"],["の"],["木","き"],["に"],["至る","いたる"],["まで"],["燃やした","もやした"],["。"]]},{"verse":6,"text":"ペリシテ人は、「誰がこんな事をしたのか」と言い合った。「あのティムナ人の婿のサムソンがした。彼が婿の妻を取り上げ、その友に与えたからだ」と答える者があった。ペリシテ人はそこで、彼女とその父のところに上って来て、火を放って焼き殺した。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["「"],["誰","だれ"],["が"],["こんな"],["事","こと"],["を"],["した"],["の"],["か"],["」"],["と"],["言い合った","いいあった"],["。"],["「"],["あの"],["ティムナ"],["人","にん"],["の"],["婿","むこ"],["の"],["サムソン"],["が"],["した"],["。"],["彼","かれ"],["が"],["婿","むこ"],["の"],["妻","つま"],["を"],["取り上げ","とりあげ"],["、"],["その"],["友","とも"],["に"],["与えた","あたえた"],["から"],["だ"],["」"],["と"],["答える","こたえる"],["者","もの"],["が"],["あった"],["。"],["ペリシテ"],["人","にん"],["は"],["そこ"],["で"],["、"],["彼女","かのじょ"],["と"],["その"],["父","ちち"],["の"],["ところ"],["に"],["上って","のぼって"],["来て","きて"],["、"],["火","ひ"],["を"],["放って","はなって"],["焼き殺した","やきころした"],["。"]]},{"verse":7,"text":"サムソンは彼らに、「これがお前たちのやり方なら、わたしはお前たちに報復せずにはいられない」と言って、","tok":[["サムソン"],["は"],["彼","かれ"],["ら"],["に"],["、"],["「"],["これ"],["が"],["お前","おまえ"],["たち"],["の"],["やり方","やりかた"],["なら"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["に"],["報復","ほうふく"],["せず"],["に"],["は"],["いられない"],["」"],["と"],["言って","いって"],["、"]]},{"verse":8,"text":"彼らを徹底的に打ちのめし、下って行って、エタムの岩の裂け目に住んだ。","tok":[["彼","かれ"],["ら"],["を"],["徹底的","てっていてき"],["に"],["打ちのめし","うちのめし"],["、"],["下って","くだって"],["行って","いって"],["、"],["エタム"],["の"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":9,"text":"ペリシテ人は、ユダに上って来て陣を敷き、レヒに向かって展開した。","tok":[["ペリシテ"],["人","にん"],["は"],["、"],["ユダ"],["に"],["上って","のぼって"],["来て","きて"],["陣","じん"],["を"],["敷き","しき"],["、"],["レヒ"],["に"],["向かって","むかって"],["展開","てんかい"],["した"],["。"]]},{"verse":10,"text":"ユダの人々は、「なぜ我々に向かって上って来るのか」とただしたところ、彼らは、「攻め上って来たのはサムソンを縛り上げ、我々に対する仕打ちのお返しをするためだ」と答えた。","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["、"],["「"],["なぜ"],["我々","われわれ"],["に"],["向かって","むかって"],["上って","のぼって"],["来る","くる"],["の"],["か"],["」"],["と"],["ただした"],["ところ"],["、"],["彼","かれ"],["ら"],["は"],["、"],["「"],["攻め上って","せめのぼって"],["来た","きた"],["の"],["は"],["サムソン"],["を"],["縛り上げ","しばりあげ"],["、"],["我々","われわれ"],["に"],["対する","たいする"],["仕打ち","しうち"],["の"],["お返し","おかえし"],["を"],["する"],["ため"],["だ"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":11,"text":"ユダの人々三千人が、エタムの岩の裂け目に下って行き、サムソンに言った。「我々がペリシテ人の支配下にあることを知らないのか。なんということをしてくれた。」サムソンは答えた。「彼らがわたしにしたように、彼らにしただけだ。」","tok":[["ユダ"],["の"],["人々","ひとびと"],["三千人","さんせんにん"],["が"],["、"],["エタム"],["の"],["岩","いわ"],["の"],["裂け目","さけめ"],["に"],["下って","くだって"],["行き","いき"],["、"],["サムソン"],["に"],["言った","いった"],["。"],["「"],["我々","われわれ"],["が"],["ペリシテ"],["人","にん"],["の"],["支配下","しはいか"],["に"],["ある"],["こと"],["を"],["知らない","しらない"],["の"],["か"],["。"],["なん"],["と"],["いう"],["こと"],["を"],["して"],["くれた"],["。"],["」"],["サムソン"],["は"],["答えた","こたえた"],["。"],["「"],["彼","かれ"],["ら"],["が"],["わたし"],["に"],["した"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["に"],["した"],["だけ"],["だ"],["。"],["」"]]},{"verse":12,"text":"彼らはサムソンに言った。「我々は、お前を縛ってペリシテ人の手に渡すためにやって来た。」サムソンは言った。「あなたたちはわたしに害を加えないと誓ってくれるか。」","tok":[["彼","かれ"],["ら"],["は"],["サムソン"],["に"],["言った","いった"],["。"],["「"],["我々","われわれ"],["は"],["、"],["お前","おまえ"],["を"],["縛って","しばって"],["ペリシテ"],["人","にん"],["の"],["手","て"],["に"],["渡す","わたす"],["ため"],["に"],["やって"],["来た","きた"],["。"],["」"],["サムソン"],["は"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["は"],["わたし"],["に"],["害","がい"],["を"],["加えない","くわえない"],["と"],["誓って","ちかって"],["くれる"],["か"],["。"],["」"]]},{"verse":13,"text":"彼らは言った。「我々はただお前を縛って彼らの手に渡すだけだ。殺しはしない。」彼らはこうして、新しい縄二本でサムソンを縛り、岩から連れ出し、上って来た。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["我々","われわれ"],["は"],["ただ"],["お前","おまえ"],["を"],["縛って","しばって"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡す","わたす"],["だけ"],["だ"],["。"],["殺し","ころし"],["は"],["しない"],["。"],["」"],["彼","かれ"],["ら"],["は"],["こう"],["して"],["、"],["新しい","あたらしい"],["縄","なわ"],["二本","にぽん"],["で"],["サムソン"],["を"],["縛り","しばり"],["、"],["岩","いわ"],["から"],["連れ出し","つれだし"],["、"],["上って","のぼって"],["来た","きた"],["。"]]},{"verse":14,"text":"サムソンがレヒに着くと、ペリシテ人は歓声をあげて彼を迎えた。そのとき、主の霊が激しく彼に降り、腕を縛っていた縄は、火がついて燃える亜麻の糸のようになり、縄目は解けて彼の手から落ちた。","tok":[["サムソン"],["が"],["レヒ"],["に"],["着く","つく"],["と"],["、"],["ペリシテ"],["人","にん"],["は"],["歓声","かんせい"],["を"],["あげて"],["彼","かれ"],["を"],["迎えた","むかえた"],["。"],["その"],["とき"],["、"],["主","ぬし"],["の"],["霊","れい"],["が"],["激しく","はげしく"],["彼","かれ"],["に"],["降り","ふり"],["、"],["腕","うで"],["を"],["縛って","しばって"],["いた"],["縄","なわ"],["は"],["、"],["火","ひ"],["が"],["ついて"],["燃える","もえる"],["亜麻","あま"],["の"],["糸","いと"],["の"],["よう"],["に"],["なり"],["、"],["縄目","なわめ"],["は"],["解けて","とけて"],["彼","かれ"],["の"],["手","て"],["から"],["落ちた","おちた"],["。"]]},{"verse":15,"text":"彼は、真新しいろばのあご骨を見つけ、手を伸ばして取り、これで千人を打ち殺した。","tok":[["彼","かれ"],["は"],["、"],["真新しい","まあたらしい"],["ろば"],["の"],["あご骨","あごぼね"],["を"],["見つけ","みつけ"],["、"],["手","て"],["を"],["伸ばして","のばして"],["取り","とり"],["、"],["これ"],["で"],["千人","せんにん"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":16,"text":"そこで彼は言った。「ろばのあご骨で、ひと山、ふた山ろばのあご骨で、千人を打ち殺した。」","tok":[["そこ"],["で"],["彼","かれ"],["は"],["言った","いった"],["。"],["「"],["ろば"],["の"],["あご骨","あごぼね"],["で"],["、"],["ひと"],["山","やま"],["、"],["ふた"],["山","やま"],["ろば"],["の"],["あご骨","あごぼね"],["で"],["、"],["千人","せんにん"],["を"],["打ち殺した","うちころした"],["。"],["」"]]},{"verse":17,"text":"こう言い終わると、彼は手に持っていたあご骨を投げ捨てた。こうして、その場所はラマト‧レヒ（あご骨の高台）と呼ばれるようになった。","tok":[["こう"],["言い","いい"],["終わる","おわる"],["と"],["、"],["彼","かれ"],["は"],["手","て"],["に"],["持って","もって"],["いた"],["あご骨","あごぼね"],["を"],["投げ捨てた","なげすてた"],["。"],["こう"],["して"],["、"],["その"],["場所","ばしょ"],["は"],["ラマト"],["‧"],["レヒ"],["（"],["あご骨","あごぼね"],["の"],["高台","たかだい"],["）"],["と"],["呼ばれる","よばれる"],["よう"],["に"],["なった"],["。"]]},{"verse":18,"text":"彼は非常に喉が渇いていたので、主に祈って言った。「あなたはこの大いなる勝利を、この僕の手によってお与えになりました。しかし今、わたしは喉が渇いて死にそうで、無割礼の者たちの手に落ちようとしています。」","tok":[["彼","かれ"],["は"],["非常","ひじょう"],["に"],["喉","のど"],["が"],["渇いて","かわいて"],["いた"],["ので"],["、"],["主に","おもに"],["祈って","いのって"],["言った","いった"],["。"],["「"],["あなた"],["は"],["この"],["大いなる","おおいなる"],["勝利","しょうり"],["を"],["、"],["この"],["僕","ぼく"],["の"],["手","て"],["によって"],["お与え","おあたえ"],["に"],["なりました"],["。"],["しかし"],["今","いま"],["、"],["わたし"],["は"],["喉","のど"],["が"],["渇いて","かわいて"],["死に","しに"],["そう"],["で"],["、"],["無","む"],["割礼","かつれい"],["の"],["者","もの"],["たち"],["の"],["手","て"],["に"],["落ちよう","おちよう"],["として"],["います"],["。"],["」"]]},{"verse":19,"text":"神はレヒのくぼんだ地を裂き、そこから水が湧き出るようにされた。彼はその水を飲んで元気を取り戻し、生き返った。それゆえ、その泉はエン‧ハコレ（祈る者の泉）と呼ばれ、今日もレヒにある。","tok":[["神","かみ"],["は"],["レヒ"],["の"],["くぼんだ"],["地","ち"],["を"],["裂き","さき"],["、"],["そこ"],["から"],["水","みず"],["が"],["湧き出る","わきでる"],["よう"],["に"],["された"],["。"],["彼","かれ"],["は"],["その"],["水","みず"],["を"],["飲んで","のんで"],["元気","げんき"],["を"],["取り戻し","とりもどし"],["、"],["生き返った","いきかえった"],["。"],["それ"],["ゆえ"],["、"],["その"],["泉","いずみ"],["は"],["エン"],["‧"],["ハコレ"],["（"],["祈る","いのる"],["者","もの"],["の"],["泉","いずみ"],["）"],["と"],["呼ばれ","よばれ"],["、"],["今日","きょう"],["も"],["レヒ"],["に"],["ある"],["。"]]},{"verse":20,"text":"彼はペリシテ人の時代に、二十年間、士師としてイスラエルを裁いた。","tok":[["彼","かれ"],["は"],["ペリシテ"],["人","にん"],["の"],["時代","じだい"],["に"],["、"],["二十","にじゅう"],["年間","ねんかん"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"]]}]
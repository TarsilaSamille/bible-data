[{"verse":1,"text":"エルバアルの子アビメレクはシケムに来て、母方のおじたちに会い、彼らと母の家族が属する一族全員とにこう言った。","tok":[["エルバアル"],["の"],["子","こ"],["アビメレク"],["は"],["シケム"],["に"],["来て","きて"],["、"],["母方","ははかた"],["の"],["おじ"],["たち"],["に"],["会い","あい"],["、"],["彼","かれ"],["ら"],["と"],["母","はは"],["の"],["家族","かぞく"],["が"],["属する","ぞくする"],["一族","いちぞく"],["全員","ぜんいん"],["と"],["に"],["こう"],["言った","いった"],["。"]]},{"verse":2,"text":"「シケムのすべての首長にこう言い聞かせてください。あなたたちにとって、エルバアルの息子七十人全部に治められるのと、一人の息子に治められるのと、どちらが得か。ただしわたしが、あなたたちの骨であり肉だということを心に留めよ。」","tok":[["「"],["シケム"],["の"],["すべて"],["の"],["首長","しゅちょう"],["に"],["こう"],["言い聞かせて","いいきかせて"],["ください"],["。"],["あなた"],["たち"],["にとって"],["、"],["エルバアル"],["の"],["息子","むすこ"],["七","なな"],["十人","じゅうにん"],["全部","ぜんぶ"],["に"],["治められる","おさめられる"],["の"],["と"],["、"],["一人","ひとり"],["の"],["息子","むすこ"],["に"],["治められる","おさめられる"],["の"],["と"],["、"],["どちら"],["が"],["得","とく"],["か"],["。"],["ただし"],["わたし"],["が"],["、"],["あなた"],["たち"],["の"],["骨","ほね"],["で"],["あり"],["肉","にく"],["だ"],["と"],["いう"],["こと"],["を"],["心","こころ"],["に"],["留めよ","とめよ"],["。"],["」"]]},{"verse":3,"text":"母方のおじたちは、彼に代わってこれらの言葉をことごとくシケムのすべての首長に告げた。彼らは、「これは我々の身内だ」と思い、その心はアビメレクに傾いた。","tok":[["母方","ははかた"],["の"],["おじ"],["たち"],["は"],["、"],["彼","かれ"],["に"],["代わって","かわって"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["ことごとく"],["シケム"],["の"],["すべて"],["の"],["首長","しゅちょう"],["に"],["告げた","つげた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["「"],["これ"],["は"],["我々","われわれ"],["の"],["身内","みうち"],["だ"],["」"],["と"],["思い","おもい"],["、"],["その"],["心","こころ"],["は"],["アビメレク"],["に"],["傾いた","かたむいた"],["。"]]},{"verse":4,"text":"彼らがバアル‧ベリトの神殿から銀七十をとってアビメレクに渡すと、彼はそれで命知らずのならず者を数名雇い入れ、自分に従わせた。","tok":[["彼","かれ"],["ら"],["が"],["バアル"],["‧"],["ベリト"],["の"],["神殿","しんでん"],["から"],["銀","ぎん"],["七十","ななじゅう"],["を"],["とって"],["アビメレク"],["に"],["渡す","わたす"],["と"],["、"],["彼","かれ"],["は"],["それ"],["で"],["命","いのち"],["知らず","しらず"],["の"],["ならず者","ならずもの"],["を"],["数","すう"],["名","めい"],["雇い入れ","やといいれ"],["、"],["自分","じぶん"],["に"],["従わせた","したがわせた"],["。"]]},{"verse":5,"text":"彼はオフラにある父の家に来て、自分の兄弟であるエルバアルの子七十人を一つの石の上で殺した。末の子ヨタムだけは身を隠して生き延びた。","tok":[["彼","かれ"],["は"],["オフラ"],["に"],["ある"],["父","ちち"],["の"],["家","いえ"],["に"],["来て","きて"],["、"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["で"],["ある"],["エルバアル"],["の"],["子","こ"],["七","なな"],["十人","じゅうにん"],["を"],["一","ひと"],["つ"],["の"],["石","いし"],["の"],["上","うえ"],["で"],["殺した","ころした"],["。"],["末","まつ"],["の"],["子","こ"],["ヨタム"],["だけ"],["は"],["身","み"],["を"],["隠して","かくして"],["生き延びた","いきのびた"],["。"]]},{"verse":6,"text":"シケムのすべての首長とベト‧ミロの全員が集まり、赴いて、シケムの石柱のあるテレビンの木の傍らでアビメレクを王とした。","tok":[["シケム"],["の"],["すべて"],["の"],["首長","しゅちょう"],["と"],["ベト"],["‧"],["ミロ"],["の"],["全員","ぜんいん"],["が"],["集まり","あつまり"],["、"],["赴いて","おもむいて"],["、"],["シケム"],["の"],["石柱","せきちゅう"],["の"],["ある"],["テレビン"],["の"],["木","き"],["の"],["傍ら","かたわら"],["で"],["アビメレク"],["を"],["王","おう"],["と"],["した"],["。"]]},{"verse":7,"text":"このことがヨタムに知らされると、彼はゲリジム山の頂に行って立ち、大声を張り上げて言った。「シケムの首長たちよ。わたしの言うことを聞いてください。そうすれば、神はあなたたちの言うことを聞き入れてくださる。","tok":[["この"],["こと"],["が"],["ヨタム"],["に"],["知らされる","しらされる"],["と"],["、"],["彼","かれ"],["は"],["ゲリジム"],["山","さん"],["の"],["頂","いただき"],["に"],["行って","いって"],["立ち","たち"],["、"],["大声","おおごえ"],["を"],["張り上げて","はりあげて"],["言った","いった"],["。"],["「"],["シケム"],["の"],["首長","しゅちょう"],["たち"],["よ"],["。"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞いて","きいて"],["ください"],["。"],["そう"],["すれば"],["、"],["神","かみ"],["は"],["あなた"],["たち"],["の"],["言う","いう"],["こと"],["を"],["聞き入れて","ききいれて"],["くださる"],["。"]]},{"verse":8,"text":"木々が、だれかに油を注いで自分たちの王にしようとしてまずオリーブの木に頼んだ。『王になってください。』","tok":[["木々","きぎ"],["が"],["、"],["だれ"],["か"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["自分","じぶん"],["たち"],["の"],["王","おう"],["に"],["しよう"],["として"],["まず"],["オリーブ"],["の"],["木","き"],["に"],["頼んだ","たのんだ"],["。"],["『"],["王","おう"],["に"],["なって"],["ください"],["。"],["』"]]},{"verse":9,"text":"オリーブの木は言った。『神と人に誉れを与えるわたしの油を捨てて木々に向かって手を振りに行ったりするものですか。』","tok":[["オリーブ"],["の"],["木","き"],["は"],["言った","いった"],["。"],["『"],["神","かみ"],["と"],["人","ひと"],["に"],["誉れ","ほまれ"],["を"],["与える","あたえる"],["わたし"],["の"],["油","あぶら"],["を"],["捨てて","すてて"],["木々","きぎ"],["に"],["向かって","むかって"],["手","て"],["を"],["振り","ふり"],["に"],["行っ","いっ"],["たり"],["する"],["もの"],["です"],["か"],["。"],["』"]]},{"verse":10,"text":"木々は、いちじくの木に頼んだ。『それではあなたが女王になってください。』","tok":[["木々","きぎ"],["は"],["、"],["いちじく"],["の"],["木","き"],["に"],["頼んだ","たのんだ"],["。"],["『"],["それ"],["で"],["は"],["あなた"],["が"],["女王","じょおう"],["に"],["なって"],["ください"],["。"],["』"]]},{"verse":11,"text":"いちじくの木は言った。『わたしの甘くて味のよい実を捨てて木々に向かって手を振りに行ったりするものですか。』","tok":[["いちじく"],["の"],["木","き"],["は"],["言った","いった"],["。"],["『"],["わたし"],["の"],["甘くて","あまくて"],["味","あじ"],["の"],["よい"],["実","じつ"],["を"],["捨てて","すてて"],["木々","きぎ"],["に"],["向かって","むかって"],["手","て"],["を"],["振り","ふり"],["に"],["行っ","いっ"],["たり"],["する"],["もの"],["です"],["か"],["。"],["』"]]},{"verse":12,"text":"木々は、ぶどうの木に頼んだ。『それではあなたが女王になってください。』","tok":[["木々","きぎ"],["は"],["、"],["ぶどう"],["の"],["木","き"],["に"],["頼んだ","たのんだ"],["。"],["『"],["それ"],["で"],["は"],["あなた"],["が"],["女王","じょおう"],["に"],["なって"],["ください"],["。"],["』"]]},{"verse":13,"text":"ぶどうの木は言った。『神と人を喜ばせるわたしのぶどう酒を捨てて木々に向かって手を振りに行ったりするものですか。』","tok":[["ぶどう"],["の"],["木","き"],["は"],["言った","いった"],["。"],["『"],["神","かみ"],["と"],["人","ひと"],["を"],["喜ばせる","よろこばせる"],["わたし"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["捨てて","すてて"],["木々","きぎ"],["に"],["向かって","むかって"],["手","て"],["を"],["振り","ふり"],["に"],["行っ","いっ"],["たり"],["する"],["もの"],["です"],["か"],["。"],["』"]]},{"verse":14,"text":"そこですべての木は茨に頼んだ。『それではあなたが王になってください。』","tok":[["そこ"],["で"],["すべて"],["の"],["木","き"],["は"],["茨","うばら"],["に"],["頼んだ","たのんだ"],["。"],["『"],["それ"],["で"],["は"],["あなた"],["が"],["王","おう"],["に"],["なって"],["ください"],["。"],["』"]]},{"verse":15,"text":"茨は木々に言った。『もしあなたたちが誠意のある者でわたしに油を注いで王とするなら来て、わたしの陰に身を寄せなさい。そうでないなら、この茨から火が出て、レバノンの杉を焼き尽くします。』","tok":[["茨","うばら"],["は"],["木々","きぎ"],["に"],["言った","いった"],["。"],["『"],["もし"],["あなた"],["たち"],["が"],["誠意","せいい"],["の"],["ある"],["者","もの"],["で"],["わたし"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["王","おう"],["と"],["するなら"],["来て","きて"],["、"],["わたし"],["の"],["陰","かげ"],["に"],["身","み"],["を"],["寄せ","よせ"],["なさい"],["。"],["そう"],["で"],["ないなら"],["、"],["この"],["茨","うばら"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["レバノン"],["の"],["杉","すぎ"],["を"],["焼き","やき"],["尽くします","つくします"],["。"],["』"]]},{"verse":16,"text":"さて、あなたたちはアビメレクを王としたが、それは誠意のある正しい行動だろうか。それがエルバアルとその一族を正当に遇し、彼の手柄にふさわしく報いることだろうか。","tok":[["さて"],["、"],["あなた"],["たち"],["は"],["アビメレク"],["を"],["王","おう"],["と"],["した"],["が"],["、"],["それ"],["は"],["誠意","せいい"],["の"],["ある"],["正しい","ただしい"],["行動","こうどう"],["だろう"],["か"],["。"],["それ"],["が"],["エルバアル"],["と"],["その"],["一族","いちぞく"],["を"],["正当","せいとう"],["に"],["遇し","ぐうし"],["、"],["彼","かれ"],["の"],["手柄","てがら"],["に"],["ふさわしく"],["報いる","むくいる"],["こと"],["だろう"],["か"],["。"]]},{"verse":17,"text":"わたしの父はあなたたちのために戦い、命をかけて、あなたたちをミディアンの手から救い出した。","tok":[["わたし"],["の"],["父","ちち"],["は"],["あなた"],["たち"],["の"],["ため"],["に"],["戦い","たたかい"],["、"],["命","いのち"],["を"],["かけて"],["、"],["あなた"],["たち"],["を"],["ミディアン"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["。"]]},{"verse":18,"text":"ところが今日、あなたたちはわたしの父の家に背いて立ち上がり、その息子七十人を一つの石の上で殺し、女奴隷の子アビメレクを、ただ自分たちの身内だからというだけで、シケムの首長たちの上に立てて王とした。","tok":[["ところ"],["が"],["今日","きょう"],["、"],["あなた"],["たち"],["は"],["わたし"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["背いて","そむいて"],["立ち上がり","たちあがり"],["、"],["その"],["息子","むすこ"],["七","なな"],["十人","じゅうにん"],["を"],["一","ひと"],["つ"],["の"],["石","いし"],["の"],["上","うえ"],["で"],["殺し","ころし"],["、"],["女","じょ"],["奴隷","どれい"],["の"],["子","こ"],["アビメレク"],["を"],["、"],["ただ"],["自分","じぶん"],["たち"],["の"],["身内","みうち"],["だ"],["から"],["と"],["いう"],["だけ"],["で"],["、"],["シケム"],["の"],["首長","しゅちょう"],["たち"],["の"],["上","うえ"],["に"],["立てて","たてて"],["王","おう"],["と"],["した"],["。"]]},{"verse":19,"text":"もし今日、あなたたちがエルバアルとその一族とに対して誠意をもって正しく行動したのなら、アビメレクと共に喜び祝うがよい。彼もまたあなたたちと共に喜び祝うがよい。","tok":[["もし"],["今日","きょう"],["、"],["あなた"],["たち"],["が"],["エルバアル"],["と"],["その"],["一族","いちぞく"],["と"],["に対して","にたいして"],["誠意","せいい"],["を"],["もって"],["正しく","ただしく"],["行動","こうどう"],["した"],["の"],["なら"],["、"],["アビメレク"],["と"],["共","とも"],["に"],["喜び祝う","よろこびいわう"],["が"],["よい"],["。"],["彼","かれ"],["も"],["また"],["あなた"],["たち"],["と"],["共","とも"],["に"],["喜び祝う","よろこびいわう"],["が"],["よい"],["。"]]},{"verse":20,"text":"もしそうでなければ、アビメレクから火が出て、シケムの首長たちとベト‧ミロをなめ尽くす。またシケムの首長たちとベト‧ミロから火が出て、アビメレクをなめ尽くす。」","tok":[["もし"],["そう"],["で"],["なければ"],["、"],["アビメレク"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["シケム"],["の"],["首長","しゅちょう"],["たち"],["と"],["ベト"],["‧"],["ミロ"],["を"],["なめ"],["尽くす","つくす"],["。"],["また"],["シケム"],["の"],["首長","しゅちょう"],["たち"],["と"],["ベト"],["‧"],["ミロ"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["アビメレク"],["を"],["なめ"],["尽くす","つくす"],["。"],["」"]]},{"verse":21,"text":"ヨタムは逃げ去った。彼は逃げてベエルに行き、兄弟アビメレクを避けてそこに住んだ。","tok":[["ヨタム"],["は"],["逃げ去った","にげさった"],["。"],["彼","かれ"],["は"],["逃げて","にげて"],["ベエル"],["に"],["行き","いき"],["、"],["兄弟","きょうだい"],["アビメレク"],["を"],["避けて","さけて"],["そこ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":22,"text":"一方、アビメレクは三年間イスラエルを支配下においていたが、","tok":[["一方","いっぽう"],["、"],["アビメレク"],["は"],["三","さん"],["年間","ねんかん"],["イスラエル"],["を"],["支配下","しはいか"],["に"],["おいて"],["いた"],["が"],["、"]]},{"verse":23,"text":"神はアビメレクとシケムの首長の間に、険悪な空気を送り込まれたので、シケムの首長たちはアビメレクを裏切ることになった。","tok":[["神","かみ"],["は"],["アビメレク"],["と"],["シケム"],["の"],["首長","しゅちょう"],["の"],["間","あいだ"],["に"],["、"],["険悪","けんあく"],["な"],["空気","くうき"],["を"],["送り込まれた","おくりこまれた"],["ので"],["、"],["シケム"],["の"],["首長","しゅちょう"],["たち"],["は"],["アビメレク"],["を"],["裏切る","うらぎる"],["こと"],["に"],["なった"],["。"]]},{"verse":24,"text":"こうしてエルバアルの七十人の息子に対する不法がそのままにされず、七十人を殺した兄弟アビメレクと、それに手を貸したシケムの首長たちの上に、血の報復が果たされることになる。","tok":[["こう"],["して"],["エルバアル"],["の"],["七","なな"],["十人","じゅうにん"],["の"],["息子","むすこ"],["に"],["対する","たいする"],["不法","ふほう"],["が"],["そのまま"],["に"],["されず"],["、"],["七","なな"],["十人","じゅうにん"],["を"],["殺した","ころした"],["兄弟","きょうだい"],["アビメレク"],["と"],["、"],["それ"],["に"],["手","て"],["を"],["貸した","かした"],["シケム"],["の"],["首長","しゅちょう"],["たち"],["の"],["上","うえ"],["に"],["、"],["血","ち"],["の"],["報復","ほうふく"],["が"],["果たされる","はたされる"],["こと"],["に"],["なる"],["。"]]},{"verse":25,"text":"シケムの首長たちは、山々の頂にアビメレクを待ち伏せる者を配置したが、彼らはそばを通りかかる旅人をだれかれなく襲った。そのことはやがてアビメレクの知るところとなった。","tok":[["シケム"],["の"],["首長","しゅちょう"],["たち"],["は"],["、"],["山々","やまやま"],["の"],["頂","いただき"],["に"],["アビメレク"],["を"],["待ち伏せる","まちぶせる"],["者","もの"],["を"],["配置","はいち"],["した"],["が"],["、"],["彼","かれ"],["ら"],["は"],["そば"],["を"],["通りかかる","とお
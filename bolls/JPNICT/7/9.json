","tok":[["町","まち"],["の"],["長","ちょう"],["ゼブル"],["は"],["、"],["エベド"],["の"],["子","こ"],["ガアル"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["激しく","はげしく"],["怒り","おこり"],["、"]]},{"verse":31,"text":"使者をアルマにいるアビメレクのもとに送って、こう言わせた。「エベドの子ガアルとその兄弟がシケムに来て、この町をあなたに背かせようとけしかけています。","tok":[["使者","ししゃ"],["を"],["アルマ"],["に"],["いる"],["アビメレク"],["の"],["もと"],["に"],["送って","おくって"],["、"],["こう"],["言わせた","いわせた"],["。"],["「"],["エベド"],["の"],["子","こ"],["ガアル"],["と"],["その"],["兄弟","きょうだい"],["が"],["シケム"],["に"],["来て","きて"],["、"],["この"],["町","まち"],["を"],["あなた"],["に"],["背かせよう","そむかせよう"],["と"],["けしかけて"],["います"],["。"]]},{"verse":32,"text":"早速夜のうちに行動を起こし、民を率い、野に待ち伏せして、","tok":[["早速","さっそく"],["夜","よる"],["の"],["うち"],["に"],["行動","こうどう"],["を"],["起こし","おこし"],["、"],["民","みん"],["を"],["率い","ひきい"],["、"],["野","の"],["に"],["待ち伏せ","まちぶせ"],["して"],["、"]]},{"verse":33,"text":"明朝、日の出とともに町に攻撃をかけてください。ガアルとガアルの率いる民があなたを迎え撃とうと出て来るはずです。あなたは、思いのままに彼をあしらうことができます。」","tok":[["明朝","みょうちょう"],["、"],["日の出","ひので"],["と"],["とも"],["に"],["町","まち"],["に"],["攻撃","こうげき"],["を"],["かけて"],["ください"],["。"],["ガアル"],["と"],["ガアル"],["の"],["率いる","ひきいる"],["民","たみ"],["が"],["あなた"],["を"],["迎え撃とう","むかえうとう"],["と"],["出て","でて"],["来る","くる"],["はず"],["です"],["。"],["あなた"],["は"],["、"],["思い","おもい"],["の"],["まま"],["に"],["彼","かれ"],["を"],["あしらう"],["こと"],["が"],["できます"],["。"],["」"]]},{"verse":34,"text":"アビメレクと配下のすべての民は夜のうちに行動を起こし、四隊に分かれてシケムに向かい、そこで待ち伏せた。","tok":[["アビメレク"],["と"],["配下","はいか"],["の"],["すべて"],["の"],["民","たみ"],["は"],["夜","よる"],["の"],["うち"],["に"],["行動","こうどう"],["を"],["起こし","おこし"],["、"],["四隊","よんたい"],["に"],["分かれて","わかれて"],["シケム"],["に"],["向かい","むかい"],["、"],["そこ"],["で"],["待ち伏せた","まちぶせた"],["。"]]},{"verse":35,"text":"エベドの子ガアルが出て来て、町の門の入り口に立った。アビメレクは率いる民と共に待ち伏せの場所から立ち上がると、","tok":[["エベド"],["の"],["子","こ"],["ガアル"],["が"],["出て","でて"],["来て","きて"],["、"],["町","まち"],["の"],["門","もん"],["の"],["入り口","いりぐち"],["に"],["立った","たった"],["。"],["アビメレク"],["は"],["率いる","ひきいる"],["民","たみ"],["と"],["共","とも"],["に"],["待ち伏せ","まちぶせ"],["の"],["場所","ばしょ"],["から"],["立ち上がる","たちあがる"],["と"],["、"]]},{"verse":36,"text":"ガアル
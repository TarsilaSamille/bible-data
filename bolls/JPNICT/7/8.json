[{"verse":1,"text":"エフライムの人々はギデオンに、「あなたはミディアンとの戦いに行くとき、わたしたちを呼ばなかったが、それはどういうことか」と言って、激しく彼を責めた。","tok":[["エフライム"],["の"],["人々","ひとびと"],["は"],["ギデオン"],["に"],["、"],["「"],["あなた"],["は"],["ミディアン"],["と"],["の"],["戦い","たたかい"],["に"],["行く","いく"],["とき"],["、"],["わたしたち"],["を"],["呼ばなかった","よばなかった"],["が"],["、"],["それ"],["は"],["どういう"],["こと"],["か"],["」"],["と"],["言って","いって"],["、"],["激しく","はげしく"],["彼","かれ"],["を"],["責めた","せめた"],["。"]]},{"verse":2,"text":"ギデオンは答えた。「あなたたちと比べて、わたしが特に何をしたというのか。エフライムに残ったぶどうは、アビエゼルが取ったぶどうよりも良かったではないか。","tok":[["ギデオン"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["たち"],["と"],["比べて","くらべて"],["、"],["わたし"],["が"],["特に","とくに"],["何","なん"],["を"],["した"],["と"],["いう"],["の"],["か"],["。"],["エフライム"],["に"],["残った","のこった"],["ぶどう"],["は"],["、"],["アビエゼル"],["が"],["取った","とった"],["ぶどう"],["より"],["も"],["良かったで","よかったで"],["は"],["ない"],["か"],["。"]]},{"verse":3,"text":"神はミディアンの将軍オレブとゼエブをあなたたちの手に、お渡しになったのだ。あなたたちと比べて、わたしに特に何ができたというのか。」彼がこう語ったので、彼らの憤りは和らいだ。","tok":[["神","かみ"],["は"],["ミディアン"],["の"],["将軍","しょうぐん"],["オレブ"],["と"],["ゼエブ"],["を"],["あなた"],["たち"],["の"],["手","て"],["に"],["、"],["お渡し","おわたし"],["に"],["なった"],["の"],["だ"],["。"],["あなた"],["たち"],["と"],["比べて","くらべて"],["、"],["わたし"],["に"],["特に","とくに"],["何","なん"],["が"],["できた"],["と"],["いう"],["の"],["か"],["。"],["」"],["彼","かれ"],["が"],["こう"],["語った","かたった"],["ので"],["、"],["彼","かれ"],["ら"],["の"],["憤り","いきどおり"],["は"],["和らいだ","やわらいだ"],["。"]]},{"verse":4,"text":"ギデオンはヨルダン川に着き、彼の率いる三百人と共に川を渡った。疲れきっていたが、彼らはなお追撃した。","tok":[["ギデオン"],["は"],["ヨルダン"],["川","かわ"],["に"],["着き","つき"],["、"],["彼","かれ"],["の"],["率いる","ひきいる"],["三百人","さんひゃくにん"],["と"],["共","とも"],["に"],["川","かわ"],["を"],["渡った","わたった"],["。"],["疲れ","つかれ"],["きって"],["いた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["なお"],["追撃","ついげき"],["した"],["。"]]},{"verse":5,"text":"彼はスコトの人々に言った。「わたしに従ってきた民にパンを恵んでいただきたい。彼らは疲れきっている。わたしはミディアンの王ゼバとツァルムナを追っているところだ。」","tok":[["彼","かれ"],["は"],["スコト"],["の"],["人々","ひとびと"],["に"],["言った","いった"],["。"],["「"],["わたし"],["に"],["従って","したがって"],["きた"],["民","たみ"],["に"],["パン"],["を"],["恵んで","めぐんで"],["いただきたい"],["。"],["彼","かれ"],["ら"],["は"],["疲れ","つかれ"],["きって"],["いる"],["。"],["わたし"],["は"],["ミディアン"],["の"],["王","おう"],["ゼバ"],["と"],["ツァルムナ"],["を"],["追って","おって"],["いる"],["ところ"],["だ"],["。"],["」"]]},{"verse":6,"text":"しかし、スコトの指導者たちは、「わたしたちがあなたの軍隊にパンを与えなければならないと言うからには、ゼバとツァルムナの手首を既に捕らえているのか」と言った。","tok":[["しかし"],["、"],["スコト"],["の"],["指導者","しどうしゃ"],["たち"],["は"],["、"],["「"],["わたしたち"],["が"],["あなた"],["の"],["軍隊","ぐんたい"],["に"],["パン"],["を"],["与えなければ","あたえなければ"],["ならない"],["と"],["言う","ゆう"],["から"],["に"],["は"],["、"],["ゼバ"],["と"],["ツァルムナ"],["の"],["手首","てくび"],["を"],["既に","すでに"],["捕らえて","とらえて"],["いる"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"ギデオンは、「そうか。それなら主がゼバとツァルムナをわたしの手にお渡しになるとき、わたしは、お前たちのその身を荒れ野の茨ととげで打ちのめす」と言った。","tok":[["ギデオン"],["は"],["、"],["「"],["そう"],["か"],["。"],["それ"],["なら"],["主","ぬし"],["が"],["ゼバ"],["と"],["ツァルムナ"],["を"],["わたし"],["の"],["手","て"],["に"],["お渡し","おわたし"],["に"],["なる"],["とき"],["、"],["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["の"],["その"],["身","み"],["を"],["荒れ野","あれの"],["の"],["茨","うばら"],["と"],["とげ"],["で"],["打ちのめす","うちのめす"],["」"],["と"],["言った","いった"],["。"]]},{"verse":8,"text":"彼はそこからペヌエルに上って、同じことを要求したが、ペヌエルの人々もスコトの人々と同様の答えをした。","tok":[["彼","かれ"],["は"],["そこ"],["から"],["ペヌエル"],["に"],["上って","のぼって"],["、"],["同じ","おなじ"],["こと"],["を"],["要求","ようきゅう"],["した"],["が"],["、"],["ペヌエル"],["の"],["人々","ひとびと"],["も"],["スコト"],["の"],["人々","ひとびと"],["と"],["同様","どうよう"],["の"],["答え","こたえ"],["を"],["した"],["。"]]},{"verse":9,"text":"そこで彼は、ペヌエルの人々にもこう言った。「わたしが無事に帰って来たなら、この塔を倒す。」","tok":[["そこ"],["で"],["彼","かれ"],["は"],["、"],["ペヌエル"],["の"],["人々","ひとびと"],["に"],["も"],["こう"],["言った","いった"],["。"],["「"],["わたし"],["が"],["無事","ぶじ"],["に"],["帰って","かえって"],["来たなら","きたなら"],["、"],["この"],["塔","とう"],["を"],["倒す","たおす"],["。"],["」"]]},{"verse":10,"text":"ゼバとツァルムナは、約一万五千の軍勢を率いてカルコルにいた。すべて東方の諸民族の全軍勢の敗残兵であった。剣を携えた兵士十二万が、既に戦死していた。","tok":[["ゼバ"],["と"],["ツァルムナ"],["は"],["、"],["約","やく"],["一万五千","いちまんごせん"],["の"],["軍勢","ぐんぜい"],["を"],["率いて","ひきいて"],["カルコル"],["に"],["いた"],["。"],["すべて"],["東方","とうほう"],["の"],["諸","しょ"],["民族","みんぞく"],["の"],["全","ぜん"],["軍勢","ぐんぜい"],["の"],["敗残","はいざん"],["兵","へい"],["で"],["あった"],["。"],["剣","けん"],["を"],["携えた","たずさえた"],["兵士","へいし"],["十二万","じゅうにまん"],["が"],["、"],["既に","すでに"],["戦死","せんし"],["して"],["いた"],["。"]]},{"verse":11,"text":"ギデオンは、ノバとヨグボハの東の天幕に住む人々の道を上って、敵の陣営を攻撃した。陣営は安心しきっていた。","tok":[["ギデオン"],["は"],["、"],["ノバ"],["と"],["ヨグボハ"],["の"],["東","ひがし"],["の"],["天幕","てんまく"],["に"],["住む","すむ"],["人々","ひとびと"],["の"],["道","みち"],["を"],["上って","のぼって"],["、"],["敵","てき"],["の"],["陣営","じんえい"],["を"],["攻撃","こうげき"],["した"],["。"],["陣営","じんえい"],["は"],["安心","あんしん"],["し"],["きって"],["いた"],["。"]]},{"verse":12,"text":"ゼバとツァルムナは逃げたが、彼はその後を追った。彼はこの二人のミディアンの王ゼバとツァルムナを捕らえ、その全陣営を混乱に陥れた。","tok":[["ゼバ"],["と"],["ツァルムナ"],["は"],["逃げた","にげた"],["が"],["、"],["彼","かれ"],["は"],["その後","そのあと"],["を"],["追った","おった"],["。"],["彼","かれ"],["は"],["この"],["二人","ふたり"],["の"],["ミディアン"],["の"],["王","おう"],["ゼバ"],["と"],["ツァルムナ"],["を"],["捕らえ","とらえ"],["、"],["その"],["全","ぜん"],["陣営","じんえい"],["を"],["混乱","こんらん"],["に"],["陥れた","おとしいれた"],["。"]]},{"verse":13,"text":"こうしてヨアシュの子ギデオンは、ヘレスの坂を通って戦いから帰って来た。","tok":[["こう"],["して"],["ヨアシュ"],["の"],["子","こ"],["ギデオン"],["は"],["、"],["ヘレス"],["の"],["坂","さか"],["を"],["通って","とおって"],["戦い","たたかい"],["から"],["帰って","かえって"],["来た","きた"],["。"]]},{"verse":14,"text":"彼はスコトの人々の中から一人の青年を捕らえて尋問し、スコトの指導者と、長老七十七人の名を書かせた。","tok":[["彼","かれ"],["は"],["スコト"],["の"],["人々","ひとびと"],["の"],["中","なか"],["から"],["一人","ひとり"],["の"],["青年","せいねん"],["を"],["捕らえて","とらえて"],["尋問","じんもん"],["し"],["、"],["スコト"],["の"],["指導者","しどうしゃ"],["と"],["、"],["長老","ちょうろう"],["七十七人","ななじゅうしちにん"],["の"],["名","な"],["を"],["書かせた","かかせた"],["。"]]},{"verse":15,"text":"ギデオンはスコトの人々のところに行って、こう言った。「あなたたちは、かつてわたしを嘲笑い、『わたしたちがあなたの疲れきった兵士たちにパンを与えなければならないと言うからには、ゼバとツァルムナの手首を既に捕らえているのか』と言ったが、見るがよい、これがそのゼバとツァルムナだ。」","tok":[["ギデオン"],["は"],["スコト"],["の"],["人々","ひとびと"],["の"],["ところ"],["に"],["行って","いって"],["、"],["こう"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["は"],["、"],["かつて"],["わたし"],["を"],["嘲笑い","あざけわらい"],["、"],["『"],["わたしたち"],["が"],["あなた"],["の"],["疲れ","つかれ"],["きった"],["兵士","へいし"],["たち"],["に"],["パン"],["を"],["与えなければ","あたえなければ"],["ならない"],["と"],["言う","ゆう"],["から"],["に"],["は"],["、"],["ゼバ"],["と"],["ツァルムナ"],["の"],["手首","てくび"],["を"],["既に","すでに"],["捕らえて","とらえて"],["いる"],["の"],["か"],["』"],["と"],["言った","いった"],["が"],["、"],["見る","みる"],["がよい"],["、"],["これ"],["が"],["その"],["ゼバ"],["と"],["ツァルムナ"],["だ"],["。"],["」"]]},{"verse":16,"text":"ギデオンは町の長老たちを捕らえ、荒れ野の茨ととげをもってスコトの人々に思い知らせた。","tok":[["ギデオン"],["は"],["町","まち"],["の"],["長老","ちょうろう"],["たち"],["を"],["捕らえ","とらえ"],["、"],["荒れ野","あれの"],["の"],["茨","うばら"],["と"],["とげ"],["を"],["もって"],["スコト"],["の"],["人々","ひとびと"],["に"],["思い知らせた","おもいしらせた"],["。"]]},{"verse":17,"text":"またペヌエルの塔を倒し、町の人々を殺した。","tok":[["また"],["ペヌエル"],["の"],["塔","とう"],["を"],["倒し","たおし"],["、"],["町","まち"],["の"],["人々","ひとびと"],["を"],["殺した","ころした"],["。"]]},{"verse":18,"text":"ギデオンは、ゼバとツァルムナに言った。「お前たちが、タボルで殺したのはどんな人々だったか。」彼らは、「あなたによく似ておられました。皆、王子のような風貌でした」と答えた。","tok":[["ギデオン"],["は"],["、"],["ゼバ"],["と"],["ツァルムナ"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["たち"],["が"],["、"],["タボル"],["で"],["殺した","ころした"],["の"],["は"],["どんな"],["人々","ひとびと"],["だった"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["「"],["あなた"],["に"],["よく"],["似て","にて"],["おられました"],["。"],["皆","みな"],["、"],["王子","おうじ"],["の"],["よう"],["な"],["風貌","ふうぼう"],["でした"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":19,"text":"ギデオンは、「それはわたしの兄弟、わたしの母の息子たちだ。主は生きておられる。もしお前たちが彼らを生かしておいてくれたなら、お前たちを殺さないのに」と言い、","tok":[["ギデオン"],["は"],["、"],["「"],["それ"],["は"],["わたし"],["の"],["兄弟","きょうだい"],["、"],["わたし"],["の"],["母","はは"],["の"],["息子","むすこ"],["たち"],["だ"],["。"],["主","ぬし"],["は"],["生きて","いきて"],["おられる"],["。"],["もし"],["お前","おまえ"],["たち"],["が"],["彼","かれ"],["ら"],["を"],["生かして","いかして"],["おいて"],["くれたなら"],["、"],["お前","おまえ"],["たち"],["を"],["殺さない","ころさない"],["のに"],["」"],["と"],["言い","いい"],["、"]]},{"verse":20,"text":"長子イエテルに向かって、「さあ、彼らを殺せ」と命じた。だが、若者は恐れて剣を抜かなかった。まだ若かったからである。","tok":[["長子","ちょうし"],["イエテル"],["に"],["向かって","むかって"],["、"],["「"],["さあ"],["、"],["彼","かれ"],["ら"],["を"],["殺せ","ころせ"],["」"],["と"],["命じた","めいじた"],["。"],["だ"],["が"],["、"],["若者","わかもの"],["は"],["恐れて","おそれて"],["剣","けん"],["を"],["抜かなかった","ぬかなかった"],["。"],["まだ"],["若かった","わかかった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"すると、ゼバとツァルムナが、「さあ、勇気のある男だったら、あなたが自分でわたしたちを討つがよい」と言ったので、ギデオンは自ら立ってゼバとツァルムナを殺し、彼らのらくだの首にかけてあった三日月形の飾りを取った。","tok":[["する"],["と"],["、"],["ゼバ"],["と"],["ツァルムナ"],["が"],["、"],["「"],["さあ"],["、"],["勇気","ゆうき"],["の"],["ある"],["男","おとこ"],["だったら"],["、"],["あなた"],["が"],["自分","じぶん"],["で"],["わたしたち"],["を"],["討つ","うつ"],["が"],["よい"],["」"],["と"],["言った","いった"],["ので"],["、"],["ギデオン"],["は"],["自ら","みずから"],["立って","たって"],["ゼバ"],["と"],["ツァルムナ"],["を"],["殺し","ころし"],["、"],["彼","かれ"],["ら"],["の"],["らくだ"],["の"],["首","くび"],["に"],["かけて"],["あった"],["三日月形","みかつきけい"],["の"],["飾り","かざり"],["を"],["取った","とった"],["。"]]},{"verse":22,"text":"イスラエルの人はギデオンに言った。「ミディアン人の手から我々を救ってくれたのはあなたですから、あなたはもとより、御子息、そのまた御子息が、我々を治めてください。」","tok":[["イスラエル"],["の"],["人","ひと"],["は"],["ギデオン"],["に"],["言った","いった"],["。"],["「"],["ミディアン"],["人","にん"],["の"],["手","て"],["から"],["我々","われわれ"],["を"],["救って","すくって"],["くれた"],["の"],["は"],["あなた"],["です"],["から"],["、"],["あなた"],["は"],["もとより"],["、"],["御子息","ごしそく"],["、"],["その"],["また"],["御子息","ごしそく"],["が"],["、"],["我々","われわれ"],["を"],["治めて","おさめて"],["ください"],["。"],["」"]]},{"verse":23,"text":"ギデオンは彼らに答えた。「わたしはあなたたちを治めない。息子もあなたたちを治めない。主があなたたちを治められる。」","tok":[["ギデオン"],["は"],["彼","かれ"],["ら"],["に"],["答えた","こたえた"],["。"],["「"],["わたし"],["は"],["あなた"],["たち"],["を"],["治めない","おさめない"],["。"],["息子","むすこ"],["も"],["あなた"],["たち"],["を"],["治めない","おさめない"],["。"],["主","ぬし"],["が"],["あなた"],["たち"],["を"],["治められる","おさめられる"],["。"],["」"]]},{"verse":24,"text":"ギデオンは更に、彼らに言った。「あなたたちにお願いしたいことがある。各自戦利品として手に入れた耳輪をわたしに渡してほしい。」敵はイシュマエル人であったから金の耳輪をつけていた。","tok":[["ギデオン"],["は"],["更に","さらに"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["に"],["お願い","おねがい"],["したい"],["こと"],["が"],["ある"],["。"],["各自","かくじ"],["戦利品","せんりひん"],["として"],["手","て"],["に"],["入れた","いれた"],["耳輪","みみわ"],["を"],["わたし"],["に"],["渡して","わたして"],["ほしい"],["。"],["」"],["敵","てき"],["は"],["イシュマエル"],["人","にん"],["で"],["あった"],["から"],["金","きん"],["の"],["耳輪","みみわ"],["を"],["つけて"],["いた"],["。"]]},{"verse":25,"text":"人々は、「喜んで差し上げます」と答え、衣を広げて、そこに各自戦利品の耳輪を投げ入れた。","tok":[["人々","ひとびと"],["は"],["、"],["「"],["喜んで","よろこんで"],["差し上げます","さしあげます"],["」"],["と"],["答え","こたえ"],["、"],["衣","ころも"],["を"],["広げて","ひろげて"],["、"],["そこ"],["に"],["各自","かくじ"],["戦利品","せんりひん"],["の"],["耳輪","みみわ"],["を"],["投げ入れた","なげいれた"],["。"]]},{"verse":26,"text":"彼の求めに応じて集まった金の耳輪の目方は、金千七百シェケルで、そのほかに三日月形の飾り、垂れ飾り、ミディアンの王たちがまとっていた紫布の衣服、らくだの首に巻きつけてあった飾り物があった。","tok":[["彼","かれ"],["の"],["求め","もとめ"],["に"],["応じて","おうじて"],["集まった","あつまった"],["金","かね"],["の"],["耳輪","みみわ"],["の"],["目方","めかた"],["は"],["、"],["金","きん"],["千","せん"],["七","しち"],["百","ひゃく"],["シェケル"],["で"],["、"],["その"],["ほか"],["に"],["三日月形","みかつきけい"],["の"],["飾り","かざり"],["、"],["垂れ","たれ"],["飾り","かざり"],["、"],["ミディアン"],["の"],["王","おう"],["たち"],["が"],["まとって"],["いた"],["紫布","むらさきぬの"],["の"],["衣服","いふく"],["、"],["らくだ"],["の"],["首","くび"],["に"],["巻きつけて","まきつけて"],["あった"],["飾り物","かざりもの"],["が"],["あった"],["。"]]},{"verse":27,"text":"ギデオンはそれを用いてエフォドを作り、自分の町オフラに置いた。すべてのイスラエルが、そこで彼に従って姦淫にふけることになり、それはギデオンとその一族にとって罠となった。","tok":[["ギデオン"],["は"],["それ"],["を"],["用いて","もちいて"],["エフォド"],["を"],["作り","つくり"],["、"],["自分","じぶん"],["の"],["町","まち"],["オフラ"],["に"],["置いた","おいた"],["。"],["すべて"],["の"],["イスラエル"],["が"],["、"],["そこ"],["で"],["彼","かれ"],["に"],["従って","したがって"],["姦淫","かんいん"],["に"],["ふける"],["こと"],["に"],["なり"],["、"],["それ"],["は"],["ギデオン"],["と"],["その"],["一族","いちぞく"],["にとって"],["罠","わな"],["と"],["なった"],["。"]]},{"verse":28,"text":"ミディアン人は、イスラエルの人々によって征服されたので、もはや頭をもたげることができず、ギデオンの時代四十年にわたって国は平穏であった。","tok":[["ミディアン"],["人","にん"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["によって"],["征服","せいふく"],["された"],["ので"],["、"],["もはや"],["頭","あたま"],["を"],["もたげる"],["こと"],["が"],["できず"],["、"],["ギデオン"],["の"],["時代","じだい"],["四十","よんじゅう"],["年","ねん"],["に"],["わたって"],["国","くに"],["は"],["平穏","へいおん"],["で"],["あった"],["。"]]},{"verse":29,"text":"ヨアシュの子エルバアルは、自分の家に帰って住んだ。","tok":[["ヨアシュ"],["の"],["子","こ"],["エルバアル"],["は"],["、"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰って","かえって"],["住んだ","すんだ"],["。"]]},{"verse":30,"text":"ギデオンには多くの妻がいたので、その腰から出た息子は七十人を数えた。
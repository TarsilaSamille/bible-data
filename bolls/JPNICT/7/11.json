,["来た","きた"],["とき"],["、"],["荒れ野","あれの"],["を"],["通って","とおって"],["葦","あし"],["の"],["海","うみ"],["まで"],["来て","きて"],["、"],["更に","さらに"],["カデシュ"],["に"],["たどりついた"],["。"]]},{"verse":17,"text":"そこからエドムの王に使者を送り、『あなたの国を通らせていただきたい』と頼んだが、エドムの王は聞き入れず、モアブの王にも使者を送ったが、この王も同意せず、イスラエルはカデシュにとどまったままであった。","tok":[["そこ"],["から"],["エドム"],["の"],["王","おう"],["に"],["使者","ししゃ"],["を"],["送り","おくり"],["、"],["『"],["あなた"],["の"],["国","くに"],["を"],["通らせて","とおらせて"],["いただきたい"],["』"],["と"],["頼んだ","たのんだ"],["が"],["、"],["エドム"],["の"],["王","おう"],["は"],["聞き入れず","ききいれず"],["、"],["モアブ"],["の"],["王","おう"],["に"],["も"],["使者","ししゃ"],["を"],["送った","おくった"],["が"],["、"],["この"],["王","おう"],["も"],["同意","どうい"],["せず"],["、"],["イスラエル"],["は"],["カデシュ"],["に"],["とどまった"],["まま"],["で"],["あった"],["。"]]},{"verse":18,"text":"イスラエルはやがて荒れ野を進み、エドムとモアブの地を迂回し、モアブの地の東側に出て、アルノンの向こう側に宿営した。アルノンがモアブの境界であったから、モアブの領土は侵さなかった。","tok":[["イスラエル"],["は"],["やがて"],["荒れ野","あれの"],["を"],["進み","すすみ"],["、"],["エドム"],["と"],["モアブ"],["の"],["地","ち"],["を"],["迂回","うかい"],["し"],["、"],["モアブ"],["の"],["地","ち"],["の"],["東側","ひがしがわ"],["に"],["出て","でて"],["、"],["アルノン"],["の"],["向こう側","むこうがわ"],["に"],["宿営","しゅくえい"],["した"],["。"],["アルノン"],["が"],["モアブ"],["の"],["境界","きょうかい"],["で"],["あった"],["から"],["、"],["モアブ"],["の"],["領土","りょうど"],["は"],["侵さなかった","おかさなかった"],["。"]]},{"verse":19,"text":"イスラエルは、ヘシュボンに君臨するアモリ人の王シホンに使者を送った。『あなたの国を通ってわたしの目指すところまで行かせてください』とイスラエルは頼んだが、","tok":[["イスラエル"],["は"],["、"],["ヘシュボン"],["に"],["君臨","くんりん"],["する"],["アモリ人","あもりにん"],["の"],["王","おう"],["シホン"],["に"],["使者","ししゃ"],["を"],["送った","おくった"],["。"],["『"],["あなた"],["の"],["国","くに"],["を"],["通って","とおって"],["わたし"],["の"],["目指す","めざす"],["ところ"],["まで"],["行かせて","いかせて"],["ください"],["』"],["と"],["イスラエル"],["は"],["頼んだ","たのんだ"],["が"],["、"]]},{"verse":20,"text":"シホンはイスラエルを信用せず、領土内を通らせないだけでなく、すべての民を結集してヤハツに陣を敷き、イスラエルに戦いを仕掛けてきた。","tok":[["シホン"],["は"],["イスラエル"],["を"],["信用","しんよう"],["せず"],["、"],["領土内","りょうどない"],["を"],["通らせない","とおらせない"],["だけ"],["で"],["なく"],["、"],["すべて"],["の"],["民","たみ"],["を"],["結集","けっしゅう"],["して"],["ヤハツ"],["に"],["陣","じん"],["を"],["敷き","しき"],["
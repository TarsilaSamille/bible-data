[{"verse":1,"text":"エフライム人が勢ぞろいして、ツァフォンに赴き、エフタに言った。「アンモン人との戦いに出向いたとき、なぜあなたは、わたしたちに同行を呼びかけなかったのか。あなたの家をあなたもろとも焼き払ってやる。」","tok":[["エフライム"],["人","にん"],["が"],["勢ぞろい","せいぞろい"],["して"],["、"],["ツァフォン"],["に"],["赴き","おもむき"],["、"],["エフタ"],["に"],["言った","いった"],["。"],["「"],["アンモン"],["人","にん"],["と"],["の"],["戦い","たたかい"],["に"],["出向いた","でむいた"],["とき"],["、"],["なぜ"],["あなた"],["は"],["、"],["わたしたち"],["に"],["同行","どうこう"],["を"],["呼びかけなかった","よびかけなかった"],["の"],["か"],["。"],["あなた"],["の"],["家","いえ"],["を"],["あなた"],["もろとも"],["焼き払って","やきはらって"],["やる"],["。"],["」"]]},{"verse":2,"text":"エフタは彼らに言った。「わたしとわたしの民がアンモン人と激しく争っていたとき、あなたたちに助けを求めたが、敵の手からわたしを救ってくれなかった。","tok":[["エフタ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["わたし"],["と"],["わたし"],["の"],["民","たみ"],["が"],["アンモン"],["人","にん"],["と"],["激しく","はげしく"],["争って","あらそって"],["いた"],["とき"],["、"],["あなた"],["たち"],["に"],["助け","たすけ"],["を"],["求めた","もとめた"],["が"],["、"],["敵","てき"],["の"],["手","て"],["から"],["わたし"],["を"],["救って","すくって"],["くれなかった"],["。"]]},{"verse":3,"text":"あなたたちが救ってくれることはないと思い、わたしは命がけでアンモン人に向かって行った。主は、わたしの手に彼らを渡してくださった。どうして今日になってわたしに向かって攻め上り、戦おうとするのか。」","tok":[["あなた"],["たち"],["が"],["救って","すくって"],["くれる"],["こと"],["は"],["ない"],["と"],["思い","おもい"],["、"],["わたし"],["は"],["命がけ","いのちがけ"],["で"],["アンモン"],["人","にん"],["に"],["向かって","むかって"],["行った","いった"],["。"],["主","ぬし"],["は"],["、"],["わたし"],["の"],["手","て"],["に"],["彼","かれ"],["ら"],["を"],["渡して","わたして"],["くださった"],["。"],["どう"],["して"],["今日","きょう"],["に"],["なって"],["わたし"],["に"],["向かって","むかって"],["攻め上り","せめのぼり"],["、"],["戦おう","たたかおう"],["と"],["する"],["の"],["か"],["。"],["」"]]},{"verse":4,"text":"エフタはそこでギレアドの人をすべて集めて、エフライムと戦い、ギレアドの人はエフライムを撃ち破った。エフライムが、「あなたたちはエフライムを逃げ出した者。ギレアドはエフライムの中、マナセの中にいるはずだ」と言ったからである。","tok":[["エフタ"],["は"],["そこ"],["で"],["ギレアド"],["の"],["人","ひと"],["を"],["すべて"],["集めて","あつめて"],["、"],["エフライム"],["と"],["戦い","たたかい"],["、"],["ギレアド"],["の"],["人","ひと"],["は"],["エフライム"],["を"],["撃ち破った","うちやぶった"],["。"],["エフライム"],["が"],["、"],["「"],["あなた"],["たち"],["は"],["エフライム"],["を"],["逃げ出した","にげだした"],["者","もの"],["。"],["ギレアド"],["は"],["エフライム"],["の"],["中","なか"],["、"],["マナセ"],["の"],["中","なか"],["に"],["いる"],["はず"],["だ"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"ギレアドはまた、エフライムへのヨルダンの渡し場を手中に収めた。エフライムを逃げ出した者が、「渡らせてほしい」と言って来ると、ギレアド人は、「あなたはエフライム人か」と尋ね、「そうではない」と答えると、","tok":[["ギレアド"],["は"],["また"],["、"],["エフライム"],["へ"],["の"],["ヨルダン"],["の"],["渡し場","わたしば"],["を"],["手中","しゅちゅう"],["に"],["収めた","おさめた"],["。"],["エフライム"],["を"],["逃げ出した","にげだした"],["者","もの"],["が"],["、"],["「"],["渡らせて","わたらせて"],["ほしい"],["」"],["と"],["言って","いって"],["来る","くる"],["と"],["、"],["ギレアド"],["人","にん"],["は"],["、"],["「"],["あなた"],["は"],["エフライム"],["人","にん"],["か"],["」"],["と"],["尋ね","たずね"],["、"],["「"],["そう"],["で"],["は"],["ない"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":6,"text":"「ではシイボレトと言ってみよ」と言い、その人が正しく発音できず、「シボレト」と言うと、直ちに捕らえ、そのヨルダンの渡し場で亡き者にした。そのときエフライム人四万二千人が倒された。","tok":[["「"],["で"],["は"],["シイボレト"],["と"],["言って","いって"],["み"],["よ"],["」"],["と"],["言い","いい"],["、"],["その"],["人","ひと"],["が"],["正しく","ただしく"],["発音","はつおん"],["できず"],["、"],["「"],["シボレト"],["」"],["と"],["言う","ゆう"],["と"],["、"],["直ちに","ただちに"],["捕らえ","とらえ"],["、"],["その"],["ヨルダン"],["の"],["渡し場","わたしば"],["で"],["亡き","なき"],["者","もの"],["に"],["した"],["。"],["その"],["とき"],["エフライム"],["人","にん"],["四万二千","よんまんにせん"],["人","にん"],["が"],["倒された","たおされた"],["。"]]},{"verse":7,"text":"エフタは六年間、士師としてイスラエルを裁いた。ギレアドの人エフタは死んで、自分の町ギレアドに葬られた。","tok":[["エフタ"],["は"],["六","ろく"],["年間","ねんかん"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"],["ギレアド"],["の"],["人","ひと"],["エフタ"],["は"],["死んで","しんで"],["、"],["自分","じぶん"],["の"],["町","まち"],["ギレアド"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":8,"text":"その後、ベツレヘム出身のイブツァンが、士師としてイスラエルを裁いた。","tok":[["その"],["後","ご"],["、"],["ベツレヘム"],["出身","しゅっしん"],["の"],["イブツァン"],["が"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"]]},{"verse":9,"text":"彼には三十人の息子と三十人の娘があった。三十人の娘は一族以外の者に嫁がせ、三十人の息子には一族以外から三十人の嫁を迎えた。彼は七年間、イスラエルを裁いた。","tok":[["彼","かれ"],["に"],["は"],["三","さん"],["十人","じゅうにん"],["の"],["息子","むすこ"],["と"],["三","さん"],["十人","じゅうにん"],["の"],["娘","むすめ"],["が"],["あった"],["。"],["三","さん"],["十人","じゅうにん"],["の"],["娘","むすめ"],["は"],["一族","いちぞく"],["以外","いがい"],["の"],["者","もの"],["に"],["嫁がせ","とつがせ"],["、"],["三","さん"],["十人","じゅうにん"],["の"],["息子","むすこ"],["に"],["は"],["一族","いちぞく"],["以外","いがい"],["から"],["三","さん"],["十人","じゅうにん"],["の"],["嫁","よめ"],["を"],["迎えた","むかえた"],["。"],["彼","かれ"],["は"],["七","なな"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["裁いた","さばいた"],["。"]]},{"verse":10,"text":"イブツァンは死んで、ベツレヘムに葬られた。","tok":[["イブツァン"],["は"],["死んで","しんで"],["、"],["ベツレヘム"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":11,"text":"その後、ゼブルンの人エロンが、士師としてイスラエルを裁いた。彼は十年間、イスラエルを裁いた。","tok":[["その"],["後","ご"],["、"],["ゼブルン"],["の"],["人","ひと"],["エロン"],["が"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"],["彼","かれ"],["は"],["十","じゅう"],["年間","ねんかん"],["、"],["イスラエル"],["を"],["裁いた","さばいた"],["。"]]},{"verse":12,"text":"ゼブルンの人エロンは死んで、ゼブルンの地アヤロンに葬られた。","tok":[["ゼブルン"],["の"],["人","ひと"],["エロン"],["は"],["死んで","しんで"],["、"],["ゼブルン"],["の"],["地","ち"],["アヤロン"],["に"],["葬られた","ほうむられた"],["。"]]},{"verse":13,"text":"その後、ピルアトンの人ヒレルの子アブドンが、士師としてイスラエルを裁いた。","tok":[["その"],["後","ご"],["、"],["ピルアトン"],["の"],["人","ひと"],["ヒレル"],["の"],["子","こ"],["アブドン"],["が"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"]]},{"verse":14,"text":"彼には四十人の息子と三十人の孫がいて、七十頭のろばに乗っていた。彼は八年間、士師としてイスラエルを裁いた。","tok":[["彼","かれ"],["に"],["は"],["四","よん"],["十人","じゅうにん"],["の"],["息子","むすこ"],["と"],["三","さん"],["十人","じゅうにん"],["の"],["孫","まご"],["が"],["いて"],["、"],["七十頭","ななじゅうとう"],["の"],["ろば"],["に"],["乗って","のって"],["いた"],["。"],["彼","かれ"],["は"],["八","はち"],["年間","ねんかん"],["、"],["士師","しし"],["として"],["イスラエル"],["を"],["裁いた","さばいた"],["。"]]},{"verse":15,"text":"ピルアトンの人ヒレルの子アブドンは死んで、アマレク人の山、エフライムの地にあるピルアトンに葬られた。","tok":[["ピルアトン"],["の"],["人","ひと"],["ヒレル"],["の"],["子","こ"],["アブドン"],["は"],["死んで","しんで"],["、"],["アマレク"],["人","にん"],["の"],["山","やま"],["、"],["エフライム"],["の"],["地","ち"],["に"],["ある"],["ピルアトン"],["に"],["葬られた","ほうむられた"],["。"]]}]
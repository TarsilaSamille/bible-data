[{"verse":1,"text":"エルバアル、つまりギデオンと彼の率いるすべての民は朝早く起き、エン‧ハロドのほとりに陣を敷いた。ミディアンの陣営はその北側、平野にあるモレの丘のふもとにあった。","tok":[["エルバアル"],["、"],["つまり"],["ギデオン"],["と"],["彼","かれ"],["の"],["率いる","ひきいる"],["すべて"],["の"],["民","たみ"],["は"],["朝","あさ"],["早く","はやく"],["起き","おき"],["、"],["エン"],["‧"],["ハロド"],["の"],["ほとり"],["に"],["陣","じん"],["を"],["敷いた","しいた"],["。"],["ミディアン"],["の"],["陣営","じんえい"],["は"],["その"],["北側","きたがわ"],["、"],["平野","へいや"],["に"],["ある"],["モレ"],["の"],["丘","おか"],["の"],["ふもと"],["に"],["あった"],["。"]]},{"verse":2,"text":"主はギデオンに言われた。「あなたの率いる民は多すぎるので、ミディアン人をその手に渡すわけにはいかない。渡せば、イスラエルはわたしに向かって心がおごり、自分の手で救いを勝ち取ったと言うであろう。","tok":[["主","ぬし"],["は"],["ギデオン"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["の"],["率いる","ひきいる"],["民","たみ"],["は"],["多","おお"],["すぎる"],["ので"],["、"],["ミディアン"],["人","にん"],["を"],["その"],["手","て"],["に"],["渡す","わたす"],["わけ"],["に"],["は"],["いかない"],["。"],["渡せば","わたせば"],["、"],["イスラエル"],["は"],["わたし"],["に"],["向かって","むかって"],["心","こころ"],["が"],["おごり"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["救い","すくい"],["を"],["勝ち取った","かちとった"],["と"],["言うで","ゆうで"],["あろう"],["。"]]},{"verse":3,"text":"それゆえ今、民にこう呼びかけて聞かせよ。恐れおののいている者は皆帰り、ギレアドの山を去れ、と。」こうして民の中から二万二千人が帰り、一万人が残った。","tok":[["それ"],["ゆえ"],["今","いま"],["、"],["民","みん"],["に"],["こう"],["呼びかけて","よびかけて"],["聞かせ","きかせ"],["よ"],["。"],["恐れおののいて","おそれおののいて"],["いる"],["者","もの"],["は"],["皆","みな"],["帰り","かえり"],["、"],["ギレアド"],["の"],["山","やま"],["を"],["去れ","され"],["、"],["と"],["。"],["」"],["こう"],["して"],["民","みん"],["の"],["中","なか"],["から"],["二万二千","にまんにせん"],["人","にん"],["が"],["帰り","かえり"],["、"],["一万人","いちまんにん"],["が"],["残った","のこった"],["。"]]},{"verse":4,"text":"主はギデオンに言われた。「民はまだ多すぎる。彼らを連れて水辺に下れ。そこで、あなたのために彼らをえり分けることにする。あなたと共に行くべきだとわたしが告げる者はあなたと共に行き、あなたと共に行くべきではないと告げる者は行かせてはならない。」","tok":[["主","ぬし"],["は"],["ギデオン"],["に"],["言われた","いわれた"],["。"],["「"],["民","みん"],["は"],["まだ"],["多","おお"],["すぎる"],["。"],["彼","かれ"],["ら"],["を"],["連れて","つれて"],["水辺","みずべ"],["に"],["下れ","くだれ"],["。"],["そこ"],["で"],["、"],["あなた"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["えり分ける","えりわける"],["こと"],["に"],["する"],["。"],["あなた"],["と"],["共","とも"],["に"],["行くべきだ","いくべきだ"],["と"],["わたし"],["が"],["告げる","つげる"],["者","もの"],["は"],["あなた"],["と"],["共","とも"],["に"],["行き","いき"],["、"],["あなた"],["と"],["共","とも"],["に"],["行くべきで","いくべきで"],["は"],["ない"],["と"],["告げる","つげる"],["者","もの"],["は"],["行かせて","いかせて"],["は"],["ならない"],["。"],["」"]]},{"verse":5,"text":"彼は民を連れて水辺に下った。主はギデオンに言われた。「犬のように舌で水をなめる者、すなわち膝をついてかがんで水を飲む者はすべて別にしなさい。」","tok":[["彼","かれ"],["は"],["民","みん"],["を"],["連れて","つれて"],["水辺","みずべ"],["に"],["下った","くだった"],["。"],["主","ぬし"],["は"],["ギデオン"],["に"],["言われた","いわれた"],["。"],["「"],["犬","いぬ"],["の"],["よう"],["に"],["舌","した"],["で"],["水","みず"],["を"],["なめる"],["者","もの"],["、"],["すなわち"],["膝","ひざ"],["を"],["ついて"],["かがんで"],["水","みず"],["を"],["飲む","のむ"],["者","もの"],["は"],["すべて"],["別","べつ"],["に"],["し"],["なさい"],["。"],["」"]]},{"verse":6,"text":"水を手にすくってすすった者の数は三百人であった。他の民は皆膝をついてかがんで水を飲んだ。","tok":[["水","みず"],["を"],["手","て"],["に"],["すくって"],["すすった"],["者","もの"],["の"],["数","かず"],["は"],["三百人","さんひゃくにん"],["で"],["あった"],["。"],["他","ほか"],["の"],["民","たみ"],["は"],["皆","みな"],["膝","ひざ"],["を"],["ついて"],["かがんで"],["水","みず"],["を"],["飲んだ","のんだ"],["。"]]},{"verse":7,"text":"主はギデオンに言われた。「手から水をすすった三百人をもって、わたしはあなたたちを救い、ミディアン人をあなたの手に渡そう。他の民はそれぞれ自分の所に帰しなさい。」","tok":[["主","ぬし"],["は"],["ギデオン"],["に"],["言われた","いわれた"],["。"],["「"],["手","て"],["から"],["水","みず"],["を"],["すすった"],["三百人","さんひゃくにん"],["を"],["もって"],["、"],["わたし"],["は"],["あなた"],["たち"],["を"],["救い","すくい"],["、"],["ミディアン"],["人","にん"],["を"],["あなた"],["の"],["手","て"],["に"],["渡そう","わたそう"],["。"],["他","ほか"],["の"],["民","たみ"],["は"],["それぞれ"],["自分","じぶん"],["の"],["所","ところ"],["に"],["帰し","かえし"],["なさい"],["。"],["」"]]},{"verse":8,"text":"その民の糧食と角笛は三百人が受け取った。彼はすべてのイスラエル人をそれぞれ自分の天幕に帰らせたが、その三百人だけは引き留めておいた。ミディアン人の陣営は下に広がる平野にあった。","tok":[["その"],["民","たみ"],["の"],["糧食","りょうしょく"],["と"],["角笛","つのぶえ"],["は"],["三百人","さんひゃくにん"],["が"],["受け取った","うけとった"],["。"],["彼","かれ"],["は"],["すべて"],["の"],["イスラエル"],["人","にん"],["を"],["それぞれ"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["帰らせた","かえらせた"],["が"],["、"],["その"],["三百人","さんひゃくにん"],["だけ"],["は"],["引き留めて","ひきとめて"],["おいた"],["。"],["ミディアン"],["人","にん"],["の"],["陣営","じんえい"],["は"],["下","した"],["に"],["広がる","ひろがる"],["平野","へいや"],["に"],["あった"],["。"]]},{"verse":9,"text":"その夜、主は彼に言われた。「起きて敵陣に下って行け。わたしは彼らをあなたの手に渡す。","tok":[["その"],["夜","よる"],["、"],["主","ぬし"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["起きて","おきて"],["敵陣","てきじん"],["に"],["下って","くだって"],["行け","いけ"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"]]},{"verse":10,"text":"もし下って行くのが恐ろしいなら、従者プラを連れて敵陣に下り、","tok":[["もし"],["下って","くだって"],["行く","いく"],["の"],["が"],["恐ろしいなら","おそろしいなら"],["、"],["従者","じゅうしゃ"],["プラ"],["を"],["連れて","つれて"],["敵陣","てきじん"],["に"],["下り","くだり"],["、"]]},{"verse":11,"text":"彼らが何を話し合っているかを聞け。そうすればあなたの手に力が加わり、敵陣の中に下って行くことができる。」彼は従者プラを連れて、敵陣の武装兵のいる前線に下って行った。","tok":[["彼","かれ"],["ら"],["が"],["何","なん"],["を"],["話し合って","はなしあって"],["いる"],["か"],["を"],["聞け","きけ"],["。"],["そう"],["すれば"],["あなた"],["の"],["手","て"],["に"],["力","ちから"],["が"],["加わり","くわわり"],["、"],["敵陣","てきじん"],["の"],["中","なか"],["に"],["下って","くだって"],["行く","いく"],["こと"],["が"],["できる"],["。"],["」"],["彼","かれ"],["は"],["従者","じゅうしゃ"],["プラ"],["を"],["連れて","つれて"],["、"],["敵陣","てきじん"],["の"],["武装","ぶそう"],["兵","へい"],["の"],["いる"],["前線","ぜんせん"],["に"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":12,"text":"ミディアン人、アマレク人、東方の諸民族は、いなごのように数多く、平野に横たわっていた。らくだも海辺の砂のように数多く、数えきれなかった。","tok":[["ミディアン"],["人","にん"],["、"],["アマレク"],["人","にん"],["、"],["東方","とうほう"],["の"],["諸","しょ"],["民族","みんぞく"],["は"],["、"],["いなご"],["の"],["よう"],["に"],["数多く","かずおおく"],["、"],["平野","へいや"],["に"],["横たわって","よこたわって"],["いた"],["。"],["らくだ"],["も"],["海辺","うみべ"],["の"],["砂","すな"],["の"],["よう"],["に"],["数多く","かずおおく"],["、"],["数え","かぞえ"],["きれなかった"],["。"]]},{"verse":13,"text":"ギデオンが来てみると、一人の男が仲間に夢の話をしていた。「わたしは夢を見た。大麦の丸いパンがミディアンの陣営に転がり込み、天幕まで達して一撃を与え、これを倒し、ひっくり返した。こうして天幕は倒れてしまった。」","tok":[["ギデオン"],["が"],["来て","きて"],["みる"],["と"],["、"],["一人","ひとり"],["の"],["男","おとこ"],["が"],["仲間","なかま"],["に"],["夢","ゆめ"],["の"],["話","はなし"],["を"],["して"],["いた"],["。"],["「"],["わたし"],["は"],["夢","ゆめ"],["を"],["見た","みた"],["。"],["大麦","おおむぎ"],["の"],["丸い","まるい"],["パン"],["が"],["ミディアン"],["の"],["陣営","じんえい"],["に"],["転がり込み","ころがりこみ"],["、"],["天幕","てんまく"],["まで"],["達して","たっして"],["一撃","いちげき"],["を"],["与え","あたえ"],["、"],["これ"],["を"],["倒し","たおし"],["、"],["ひっくり返した","ひっくりかえした"],["。"],["こう"],["して"],["天幕","てんまく"],["は"],["倒れて","たおれて"],["しまった"],["。"],["」"]]},{"verse":14,"text":"仲間は答えた。「それは、イスラエルの者ヨアシュの子ギデオンの剣にちがいない。神は、ミディアン人とその陣営を、すべて彼の手に渡されたのだ。」","tok":[["仲間","なかま"],["は"],["答えた","こたえた"],["。"],["「"],["それ"],["は"],["、"],["イスラエル"],["の"],["者","もの"],["ヨアシュ"],["の"],["子","こ"],["ギデオン"],["の"],["剣","けん"],["に"],["ちがい"],["ない"],["。"],["神","かみ"],["は"],["、"],["ミディアン"],["人","にん"],["と"],["その"],["陣営","じんえい"],["を"],["、"],["すべて"],["彼","かれ"],["の"],["手","て"],["に"],["渡された","わたされた"],["の"],["だ"],["。"],["」"]]},{"verse":15,"text":"ギデオンは、その夢の話と解釈を聞いてひれ伏し、イスラエルの陣営に帰って、言った。「立て。主はミディアン人の陣営をあなたたちの手に渡してくださった。」","tok":[["ギデオン"],["は"],["、"],["その"],["夢","ゆめ"],["の"],["話","はなし"],["と"],["解釈","かいしゃく"],["を"],["聞いて","きいて"],["ひれ伏し","ひれふし"],["、"],["イスラエル"],["の"],["陣営","じんえい"],["に"],["帰って","かえって"],["、"],["言った","いった"],["。"],["「"],["立て","たて"],["。"],["主","ぬし"],["は"],["ミディアン"],["人","にん"],["の"],["陣営","じんえい"],["を"],["あなた"],["たち"],["の"],["手","て"],["に"],["渡して","わたして"],["くださった"],["。"],["」"]]},{"verse":16,"text":"彼は三百人を三つの小隊に分け、全員に角笛と空の水がめを持たせた。その水がめの中には松明を入れさせ、","tok":[["彼","かれ"],["は"],["三百人","さんひゃくにん"],["を"],["三","みっ"],["つ"],["の"],["小隊","しょうたい"],["に"],["分け","わけ"],["、"],["全員","ぜんいん"],["に"],["角笛","つのぶえ"],["と"],["空","そら"],["の"],["水がめ","みずがめ"],["を"],["持たせた","もたせた"],["。"],["その"],["水がめ","みずがめ"],["の"],["中","なか"],["に"],["は"],["松明","たいまつ"],["を"],["入れさせ","いれさせ"],["、"]]},{"verse":17,"text":"彼らに言った。「わたしを見て、わたしのするとおりにせよ。わたしが敵陣の端に着いたら、わたしがするとおりにせよ。","tok":[["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["わたし"],["を"],["見て","みて"],["、"],["わたし"],["の"],["する"],["とおり"],["に"],["せよ"],["。"],["わたし"],["が"],["敵陣","てきじん"],["の"],["端","はし"],["に"],["着いたら","ついたら"],["、"],["わたし"],["が"],["する"],["とおり"],["に"],["せよ"],["。"]]},{"verse":18,"text":"わたしとわたしの率いる者が角笛を吹いたら、あなたたちも敵の陣営全体を包囲して角笛を吹き、『主のために、ギデオンのために』と叫ぶのだ。」","tok":[["わたし"],["と"],["わたし"],["の"],["率いる","ひきいる"],["者","もの"],["が"],["角笛","つのぶえ"],["を"],["吹いたら","ふいたら"],["、"],["あなた"],["たち"],["も"],["敵","てき"],["の"],["陣営","じんえい"],["全体","ぜんたい"],["を"],["包囲","ほうい"],["して"],["角笛","つのぶえ"],["を"],["吹き","ふき"],["、"],["『"],["主","ぬし"],["の"],["ため"],["に"],["、"],["ギデオン"],["の"],["ため"],["に"],["』"],["と"],["叫ぶ","さけぶ"],["の"],["だ"],["。"],["」"]]},{"verse":19,"text":"ギデオンと彼の率いる百人が、深夜の更の初めに敵陣の端に着いたとき、ちょうど歩哨が位置についたところであった。彼らは角笛を吹き、持っていた水がめを砕いた。","tok":[["ギデオン"],["と"],["彼","かれ"],["の"],["率いる","ひきいる"],["百人","ひゃくにん"],["が"],["、"],["深夜","しんや"],["の"],["更","さら"],["の"],["初め","はじめ"],["に"],["敵陣","てきじん"],["の"],["端","はし"],["に"],["着いた","ついた"],["とき"],["、"],["ちょうど"],["歩哨","ほしょう"],["が"],["位置","いち"],["に"],["ついた"],["ところ"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["角笛","つのぶえ"],["を"],["吹き","ふき"],["、"],["持って","もって"],["いた"],["水がめ","みずがめ"],["を"],["砕いた","くだいた"],["。"]]},{"verse":20,"text":"三つの小隊はそろって角笛を吹き、水がめを割って、松明を左手にかざし、右手で角笛を吹き続け、「主のために、ギデオンのために剣を」と叫んだ。","tok":[["三","みっ"],["つ"],["の"],["小隊","しょうたい"],["は"],["そろって"],["角笛","つのぶえ"],["を"],["吹き","ふき"],["、"],["水がめ","みずがめ"],["を"],["割って","わって"],["、"],["松明","たいまつ"],["を"],["左手","ひだりて"],["に"],["かざし"],["、"],["右手","みぎて"],["で"],["角笛","つのぶえ"],["を"],["吹き","ふき"],["続け","つづけ"],["、"],["「"],["主","ぬし"],["の"],["ため"],["に"],["、"],["ギデオン"],["の"],["ため"],["に"],["剣","けん"],["を"],["」"],["と"],["叫んだ","さけんだ"],["。"]]},{"verse":21,"text":"各自持ち場を守り、敵陣を包囲したので、敵の陣営は至るところで総立ちになり、叫び声をあげて、敗走した。","tok":[["各自","かくじ"],["持ち場","もちば"],["を"],["守り","まもり"],["、"],["敵陣","てきじん"],["を"],["包囲","ほうい"],["した"],["ので"],["、"],["敵","てき"],["の"],["陣営","じんえい"],["は"],["至る","いたる"],["ところ"],["で"],["総立ち","そうだち"],["に"],["なり"],["、"],["叫び声","さけびごえ"],["を"],["あげて"],["、"],["敗走","はいそう"],["した"],["。"]]},{"verse":22,"text":"三百人が角笛を吹くと、主は、敵の陣営の至るところで、同士討ちを起こされ、その軍勢はツェレラのベト·シタまで、またタバトの近くのアベル·メホラの境まで逃走した。","tok":[["三百人","さんひゃくにん"],["が"],["角笛","つのぶえ"],["を"],["吹く","ふく"],["と"],["、"],["主","ぬし"],["は"],["、"],["敵","てき"],["の"],["陣営","じんえい"],["の"],["至る","いたる"],["ところ"],["で"],["、"],["同士","どうし"],["討ち","うち"],["を"],["起こされ","おこされ"],["、
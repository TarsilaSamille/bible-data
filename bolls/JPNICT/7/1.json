[{"verse":1,"text":"ヨシュアの死後、イスラエルの人々は主に問うて言った。「わたしたちのうち、誰が最初に上って行って、カナン人を攻撃すべきでしょうか。」","tok":[["ヨシュア"],["の"],["死後","しご"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["主に","おもに"],["問うて","とうて"],["言った","いった"],["。"],["「"],["わたしたち"],["の"],["うち"],["、"],["誰","だれ"],["が"],["最初","さいしょ"],["に"],["上って","のぼって"],["行って","いって"],["、"],["カナン人","かなんにん"],["を"],["攻撃","こうげき"],["すべきでしょう"],["か"],["。"],["」"]]},{"verse":2,"text":"主は、「ユダが上れ。見よ、わたしはその地をユダの手に渡す」と言われた。","tok":[["主","ぬし"],["は"],["、"],["「"],["ユダ"],["が"],["上れ","のぼれ"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["その"],["地","ち"],["を"],["ユダ"],["の"],["手","て"],["に"],["渡す","わたす"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"ユダは兄弟シメオンに、「わたしに割り当てられた領土に一緒に上って、カナン人と戦ってください。あなたに割り当てられた領土にあなたが行かれるとき、わたしも一緒に行きます」と言った。シメオンはユダと同行することにした。","tok":[["ユダ"],["は"],["兄弟","きょうだい"],["シメオン"],["に"],["、"],["「"],["わたし"],["に"],["割り当てられた","わりあてられた"],["領土","りょうど"],["に"],["一緒","いっしょ"],["に"],["上って","のぼって"],["、"],["カナン人","かなんにん"],["と"],["戦って","たたかって"],["ください"],["。"],["あなた"],["に"],["割り当てられた","わりあてられた"],["領土","りょうど"],["に"],["あなた"],["が"],["行かれる","いかれる"],["とき"],["、"],["わたし"],["も"],["一緒","いっしょ"],["に"],["行きます","いきます"],["」"],["と"],["言った","いった"],["。"],["シメオン"],["は"],["ユダ"],["と"],["同行","どうこう"],["する"],["こと"],["に"],["した"],["。"]]},{"verse":4,"text":"こうしてユダが上って行くと、主はカナン人、ペリジ人を彼らの手に渡された。彼らはベゼクで一万の敵を撃ち破った。","tok":[["こう"],["して"],["ユダ"],["が"],["上って","のぼって"],["行く","いく"],["と"],["、"],["主","ぬし"],["は"],["カナン人","かなんにん"],["、"],["ペリジ"],["人","ひと"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["渡された","わたされた"],["。"],["彼","かれ"],["ら"],["は"],["ベゼク"],["で"],["一万","いちまん"],["の"],["敵","てき"],["を"],["撃ち破った","うちやぶった"],["。"]]},{"verse":5,"text":"すなわち、ベゼクでアドニ‧ベゼクと交戦し、カナン人とペリジ人を撃ち破った。","tok":[["すなわち"],["、"],["ベゼク"],["で"],["アドニ"],["‧"],["ベゼク"],["と"],["交戦","こうせん"],["し"],["、"],["カナン人","かなんにん"],["と"],["ペリジ人","ぺりじにん"],["を"],["撃ち破った","うちやぶった"],["。"]]},{"verse":6,"text":"アドニ‧ベゼクは逃走したが、彼らはその後を追い、彼を捕らえて、手足の親指を切断した。","tok":[["アドニ"],["‧"],["ベゼク"],["は"],["逃走","とうそう"],["した"],["が"],["、"],["彼","かれ"],["ら"],["は"],["その後","そのあと"],["を"],["追い","おい"],["、"],["彼","かれ"],["を"],["捕らえて","とらえて"],["、"],["手足","てあし"],["の"],["親指","おやゆび"],["を"],["切断","せつだん"],["した"],["。"]]},{"verse":7,"text":"アドニ‧ベゼクは言った。「かつて七十人の王の手足の親指を切って、わたしの食卓の下で食べかすを拾わせたことがあったが、神はわたしが行ったとおりにわたしに仕返しされた。」彼はエルサレムに連れて行かれ、そこで死んだ。","tok":[["アドニ"],["‧"],["ベゼク"],["は"],["言った","いった"],["。"],["「"],["かつて"],["七","なな"],["十人","じゅうにん"],["の"],["王","おう"],["の"],["手足","てあし"],["の"],["親指","おやゆび"],["を"],["切って","きって"],["、"],["わたし"],["の"],["食卓","しょくたく"],["の"],["下","もと"],["で"],["食べかす","たべかす"],["を"],["拾わせた","ひろわせた"],["こと"],["が"],["あった"],["が"],["、"],["神","かみ"],["は"],["わたし"],["が"],["行った","おこなった"],["とおり"],["に"],["わたし"],["に"],["仕返し","しかえし"],["された"],["。"],["」"],["彼","かれ"],["は"],["エルサレム"],["に"],["連れて","つれて"],["行かれ","いかれ"],["、"],["そこ"],["で"],["死んだ","しんだ"],["。"]]},{"verse":8,"text":"ユダの人々はエルサレムを攻撃し、剣をもってこれを占領、町には火を放った。","tok":[["ユダ"],["の"],["人々","ひとびと"],["は"],["エルサレム"],["を"],["攻撃","こうげき"],["し"],["、"],["剣","けん"],["を"],["もって"],["これ"],["を"],["占領","せんりょう"],["、"],["町","まち"],["に"],["は"],["火","ひ"],["を"],["放った","はなった"],["。"]]},{"verse":9,"text":"その後、ユダの人々は下って行って、山地、ネゲブ、シェフェラに住むカナン人に戦いを挑んだ。","tok":[["その"],["後","ご"],["、"],["ユダ"],["の"],["人々","ひとびと"],["は"],["下って","くだって"],["行って","いって"],["、"],["山地","さんち"],["、"],["ネゲブ"],["、"],["シェフェラ"],["に"],["住む","すむ"],["カナン人","かなんにん"],["に"],["戦い","たたかい"],["を"],["挑んだ","いどんだ"],["。"]]},{"verse":10,"text":"ユダはヘブロンに住むカナン人をも攻めた。ヘブロンはかつてキルヤト‧アルバと呼ばれていた。彼らはシェシャイ、アヒマン、タルマイを打ち殺した。","tok":[["ユダ"],["は"],["ヘブロン"],["に"],["住む","すむ"],["カナン人","かなんにん"],["を"],["も"],["攻めた","せめた"],["。"],["ヘブロン"],["は"],["かつて"],["キルヤト"],["‧"],["アルバ"],["と"],["呼ばれて","よばれて"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["シェシャイ"],["、"],["アヒマン"],["、"],["タルマイ"],["を"],["打ち殺した","うちころした"],["。"]]},{"verse":11,"text":"ユダはそこからデビルの住民をも攻めた。デビルはかつてキルヤト‧セフェルと呼ばれていた。","tok":[["ユダ"],["は"],["そこ"],["から"],["デビル"],["の"],["住民","じゅうみん"],["を"],["も"],["攻めた","せめた"],["。"],["デビル"],["は"],["かつて"],["キルヤト"],["‧"],["セフェル"],["と"],["呼ばれて","よばれて"],["いた"],["。"]]},{"verse":12,"text":"カレブは、「キルヤト‧セフェルを撃ち破って占領した者には、娘アクサを妻として与える」と約束した。","tok":[["カレブ"],["は"],["、"],["「"],["キルヤト"],["‧"],["セフェル"],["を"],["撃ち破って","うちやぶって"],["占領","せんりょう"],["した"],["者","もの"],["に"],["は"],["、"],["娘","むすめ"],["アクサ"],["を"],["妻","つま"],["として"],["与える","あたえる"],["」"],["と"],["約束","やくそく"],["した"],["。"]]},{"verse":13,"text":"カレブの弟ケナズの子オトニエルがそこを占領したので、カレブは彼に娘アクサを妻として与えた。","tok":[["カレブ"],["の"],["弟","おとうと"],["ケナズ"],["の"],["子","こ"],["オトニエル"],["が"],["そこ"],["を"],["占領","せんりょう"],["した"],["ので"],["、"],["カレブ"],["は"],["彼","かれ"],["に"],["娘","むすめ"],["アクサ"],["を"],["妻","つま"],["として"],["与えた","あたえた"],["。"]]},{"verse":14,"text":"アクサが嫁いで来ると、オトニエルは父に願って耕地をもらうように彼女を促した。彼女がろばの背から降りると、カレブは、「どうしたのか」と言った。","tok":[["アクサ"],["が"],["嫁いで","とついで"],["来る","くる"],["と"],["、"],["オトニエル"],["は"],["父","ちち"],["に"],["願って","ねがって"],["耕地","こうち"],["を"],["もらう"],["よう"],["に"],["彼女","かのじょ"],["を"],["促した","うながした"],["。"],["彼女","かのじょ"],["が"],["ろば"],["の"],["背","せ"],["から"],["降りる","おりる"],["と"],["、"],["カレブ"],["は"],["、"],["「"],["どう"],["した"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":15,"text":"彼女は言った。「お祝いをいただきたいのです。わたしにネゲブの地をくださったのですから、水溜めも添えてください。」カレブは上と下の溜池を娘に与えた。","tok":[["彼女","かのじょ"],["は"],["言った","いった"],["。"],["「"],["お祝い","おいわい"],["を"],["いただきたい"],["の"],["です"],["。"],["わたし"],["に"],["ネゲブ"],["の"],["地","ち"],["を"],["くださった"],["の"],["です"],["から"],["、"],["水溜め","みずだめ"],["も"],["添えて","そえて"],["ください"],["。"],["」"],["カレブ"],["は"],["上","うえ"],["と"],["下","した"],["の"],["溜池","ためいけ"],["を"],["娘","むすめ"],["に"],["与えた","あたえた"],["。"]]},{"verse":16,"text":"モーセのしゅうと、あのケニの人々は、ユダの人々と共になつめやしの町からユダの荒れ野、アラド近辺のネゲブに上って来て、そこの民と共に住んだ。","tok":[["モーセ"],["の"],["しゅうと"],["、"],["あの"],["ケニ"],["の"],["人々","ひとびと"],["は"],["、"],["ユダ"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["なつめやし"],["の"],["町","まち"],["から"],["ユダ"],["の"],["荒れ野","あれの"],["、"],["アラド"],["近辺","きんぺん"],["の"],["ネゲブ"],["に"],["上って","のぼって"],["来て","きて"],["、"],["そこ"],["の"],["民","たみ"],["と"],["共","とも"],["に"],["住んだ","すんだ"],["。"]]},{"verse":17,"text":"ユダは兄弟シメオンと行を共にしてツェファトに住むカナン人を打ち、滅ぼし尽くして、その町の名をホルマ（絶滅）と呼んだ。","tok":[["ユダ"],["は"],["兄弟","きょうだい"],["シメオン"],["と"],["行","ぎょう"],["を"],["共","とも"],["に"],["して"],["ツェファト"],["に"],["住む","すむ"],["カナン人","かなんにん"],["を"],["打ち","うち"],["、"],["滅ぼし","ほろぼし"],["尽くして","つくして"],["、"],["その"],["町","まち"],["の"],["名","な"],["を"],["ホルマ"],["（"],["絶滅","ぜつめつ"],["）"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":18,"text":"ユダはガザとその領土、アシュケロンとその領土、エクロンとその領土をも占領した。","tok":[["ユダ"],["は"],["ガザ"],["と"],["その"],["領土","りょうど"],["、"],["アシュケロン"],["と"],["その"],["領土","りょうど"],["、"],["エクロン"],["と"],["その"],["領土","りょうど"],["を"],["も"],["占領","せんりょう"],["した"],["。"]]},{"verse":19,"text":"主がユダと共におられたので、ユダは山地を獲得した。だが、平野の住民は鉄の戦車を持っていたので、これを追い出すことはできなかった。","tok":[["主","ぬし"],["が"],["ユダ"],["と"],["共","とも"],["に"],["おられた"],["ので"],["、"],["ユダ"],["は"],["山地","さんち"],["を"],["獲得","かくとく"],["した"],["。"],["だ"],["が"],["、"],["平野","へいや"],["の"],["住民","じゅうみん"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["を"],["持って","もって"],["いた"],["ので"],["、"],["これ"],["を"],["追い出す","おいだす"],["こと"],["は"],["できなかった"],["。"]]},{"verse":20,"text":"モーセが告げたとおり、ヘブロンはカレブに与えられ、カレブはそこからアナクの三人の子を追い出した。","tok":[["モーセ"],["が"],["告げた","つげた"],["とおり"],["、"],["ヘブロン"],["は"],["カレブ"],["に"],["与えられ","あたえられ"],["、"],["カレブ"],["は"],["そこ"],["から"],["アナク"],["の"],["三人","さんにん"],["の"],["子","こ"],["を"],["追い出した","おいだした"],["。"]]},{"verse":21,"text":"エルサレムに住むエブス人については、ベニヤミンの人々が追い出さなかったので、エブス人はベニヤミンの人々と共に今日までエルサレムに住み続けている。","tok":[["エルサレム"],["に"],["住む","すむ"],["エブス人","えぶすにん"],["について"],["は"],["、"],["ベニヤミン"],["の"],["人々","ひとびと"],["が"],["追い出さなかった","おいださなかった"],["ので"],["、"],["エブス人","えぶすにん"],["は"],["ベニヤミン"],["の"],["人々","ひとびと"],["と"],["共","とも"],["に"],["今日","きょう"],["まで"],["エルサレム"],["に"],["住み","すみ"],["続けて","つづけて"],["いる"],["。"]]},{"verse":22,"text":"ヨセフの一族も同様にベテルに上った。主は彼らと共におられた。","tok":[["ヨセフ"],["の"],["一族","いちぞく"],["も"],["同様","どうよう"],["に"],["ベテル"],["に"],["上った","のぼった"],["。"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["おられた"],["。"]]},{"verse":23,"text":"ヨセフの一族はベテルに探りを入れた。この町はかつてルズと呼ばれていた。","tok":[["ヨセフ"],["の"],["一族","いちぞく"],["は"],["ベテル"],["に"],["探り","さぐり"],["を"],["入れた","いれた"],["。"],["この"],["町","まち"],["は"],["かつて"],["ルズ"],["と"],["呼ばれて","よばれて"],["いた"],["。"]]},{"verse":24,"text":"見張っていた者が、町から出て来る人を見かけ、「どうすれば町に入れるか教えてください。あなたには憐れみをかけるから」と言った。","tok":[["見張って","みはって"],["いた"],["者","もの"],["が"],["、"],["町","まち"],["から"],["出て","でて"],["来る","くる"],["人","ひと"],["を"],["見かけ","みかけ"],["、"],["「"],["どう"],["すれば"],["町","まち"],["に"],["入れる","いれる"],["か"],["教えて","おしえて"],["ください"],["。"],["あなた"],["に"],["は"],["憐れみ","あわれみ"],["を"],["かける"],["から"],["」"],["と"],["言った","いった"],["。"]]},{"verse":25,"text":"その人が町の入り口を教えてくれたので、彼らは町を剣で討ったが、その人とその家族は皆逃がしてやった。","tok":[["その"],["人","ひと"],["が"],["町","まち"],["の"],["入り口","いりぐち"],["を"],["教えて","おしえて"],["くれた"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["町","まち"],["を"],["剣","けん"],["で"],["討った","うった"],["が"],["、"],["その"],["人","ひと"],["と"],["その"],["家族","かぞく"],["は"],["皆","みな"],["逃がして","にがして"],["やった"],["。"]]},{"verse":26,"text":"その人はヘト人の地に行って町を築き、それをルズと名付けた。この町の名は今日に至るまでそう呼ばれている。","tok":[["その"],["人","ひと"],["は"],["ヘト人","へとにん"],["の"],["地","ち"],["に"],["行って","いって"],["町","まち"],["を"],["築き","きずき"],["、"],["それ"],["を"],["ルズ"],["と"],["名付けた","なづけた"],["。"],["この"],["町","まち"],["の"],["名","な"],["は"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["そう"],["呼ばれて","よばれて"],["いる"],["。"]]},{"verse":27,"text":"マナセは、ベト‧シェアンとその周辺の村落、タナクとその周辺の村落、ドルの住民とその周辺の村落、イブレアムの住民とその周辺の村落、メギドの住民とその周辺の村落を占領しなかった。そのためカナン人はこれらの地に住み続けた。","tok":[["マナセ"],["は"],["、"],["ベト"],["‧"],["シェアン"],["と"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["、"],["タナク"],["と"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["、"],["ドル"],["の"],["住民","じゅうみん"],["と"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["、"],["イブレアム"],["の"],["住民","じゅうみん"],["と"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["、"],["メギド"],["の"],["住民","じゅうみん"],["と"],["その"],["周辺","しゅうへん"],["の"],["村落","そんらく"],["を"],["占領","せんりょう"],["しなかった"],["。"],["その"],["ため"],["カナン人","かなんにん"],["は"],["これ"],["ら"],["の"],["地","ち"],["に"],["住み","すみ"],["続けた","つづけた"],["。"]]},{"verse":28,"text":"イスラエルも、強くなってから、カナン人を強制労働に服させたが、徹底的に追い出すことはしなかった。","tok":[["イスラエル"],["も"],["、"],["強く","つよく"],["なって"],["から"],["、"],["カナン人","かなんにん"],["を"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服させた","ふくさせた"],["が"],["、"],["徹底的","てっていてき"],["に"],["追い出す","おいだす"],["こと"],["は"],["しなかった"],["。"]]},{"verse":29,"text":"エフライムは、ゲゼルに住むカナン人を追い出さなかったので、カナン人はその中にとどまり、ゲゼルに住み続けた。","tok":[["エフライム"],["は"],["、"],["ゲゼル"],["に"],["住む","すむ"],["カナン人","かなんにん"],["を"],["追い出さなかった","おいださなかった"],["ので"],["、"],["カナン人","かなんにん"],["は"],["その"],["中","なか"],["に"],["とどまり"],["、"],["ゲゼル"],["に"],["住み","すみ"],["続けた","つづけた"],["。"]]},{"verse":30,"text":"ゼブルンは、キトロンの住民と、ナハラルの住民を追い出さなかったので、カナン人はその中にとどまり、強制労働に服した。","tok":[["ゼブルン"],["は"],["、"],["キトロン"],["の"],["住民","じゅうみん"],["と"],["、"],["ナハラル"],["の"],["住民","じゅうみん"],["を"],["追い出さなかった","おいださなかった"],["ので"],["、"],["カナン人","かなんにん"],["は"],["その"],["中","なか"],["に"],["とどまり"],["、"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服した","ふくした"],["。"]]},{"verse":31,"text":"アシェルは、アコの住民、シドンの住民、マハレブ、アクジブ、ヘルバ、アフィク、レホブを占領しなかった。","tok":[["アシェル"],["は"],["、"],["アコ"],["の"],["住民","じゅうみん"],["、"],["シドン"],["の"],["住民","じゅうみん"],["、"],["マハレブ"],["、"],["アクジブ"],["、"],["ヘルバ"],["、"],["アフィク"],["、"],["レホブ"],["を"],["占領","せんりょう"],["しなかった"],["。"]]},{"verse":32,"text":"アシェルはこれらの地の住民であるカナン人を追い出さず、彼らの中に住み続けた。","tok":[["アシェル"],["は"],["これ"],["ら"],["の"],["地","ち"],["の"],["住民","じゅうみん"],["で"],["ある"],["カナン人","かなんにん"],["を"],["追い出さず","おいださず"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["住み","すみ"],["続けた","つづけた"],["。"]]},{"verse":33,"text":"ナフタリは、ベト‧シェメシュの住民、ベト‧アナトの住民を追い出さず、その地の住民であるカナン人の中に住み続けた。ベト‧シェメシュの住民とベト‧アナトの住民は、強制労働に服した。","tok":[["ナフタリ"],["は"],["、"],["ベト"],["‧"],["シェメシュ"],["の"],["住民","じゅうみん"],["、"],["ベト"],["‧"],["アナト"],["の"],["住民","じゅうみん"],["を"],["追い出さず","おいださず"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["で"],["ある"],["カナン人","かなんにん"],["の"],["中","なか"],["に"],["住み","すみ"],["続けた","つづけた"],["。"],["ベト"],["‧"],["シェメシュ"],["の"],["住民","じゅうみん"],["と"],["ベト"],["‧"],["アナト"],["の"],["住民","じゅうみん"],["は"],["、"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服した","ふくした"],["。"]]},{"verse":34,"text":"アモリ人はダンの人々を山地に追い込み、平野に下りて来ることを許さなかった。","tok":[["アモリ人","あもりにん"],["は"],["ダン"],["の"],["人々","ひとびと"],["を"],["山地","さんち"],["に"],["追い込み","おいこみ"],["、"],["平野","へいや"],["に"],["下りて","おりて"],["来る","くる"],["こと"],["を"],["許さなかった","ゆるさなかった"],["。"]]},{"verse":35,"text":"アモリ人はヘレス山、アヤロン、シャアルビムに住み続けたが、ヨセフ一族が力を増すに及んで、ついに強制労働に服した。","tok":[["アモリ人","あもりにん"],["は"],["ヘレス"],["山","やま"],["、"],["アヤロン"],["、"],["シャアルビム"],["に"],["住み","すみ"],["続けた","つづけた"],["が"],["、"],["ヨセフ"],["一族","いちぞく"],["が"],["力","ちから"],["を"],["増す","ます"],["に"],["及んで","およんで"],["、"],["ついに"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服した","ふくした"],["。"]]},{"verse":36,"text":"アモリ人の領土は、アクラビムの坂にあるセラから更に上にあった。","tok":[["アモリ人","あもりにん"],["の"],["領土","りょうど"],["は"],["、"],["アクラビム"],["の"],["坂","さか"],["に"],["ある"],["セラ"],["から"],["更に","さらに"],["上","うえ"],["に"],["あった"],["。"]]}]
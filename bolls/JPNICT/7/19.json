[{"verse":1,"text":"イスラエルに王がいなかったそのころ、エフライムの山地の奥に一人のレビ人が滞在していた。彼はユダのベツレヘムから一人の女を側女として迎え入れた。","tok":[["イスラエル"],["に"],["王","おう"],["が"],["いなかった"],["その"],["ころ"],["、"],["エフライム"],["の"],["山地","さんち"],["の"],["奥","おく"],["に"],["一人","ひとり"],["の"],["レビ人","れびにん"],["が"],["滞在","たいざい"],["して"],["いた"],["。"],["彼","かれ"],["は"],["ユダ"],["の"],["ベツレヘム"],["から"],["一人","ひとり"],["の"],["女","おんな"],["を"],["側女","そばめ"],["として"],["迎え入れた","むかえいれた"],["。"]]},{"verse":2,"text":"しかし、その側女は主人を裏切り、そのもとを去ってユダのベツレヘムの父の家に帰り、四か月ほどそこにいた。","tok":[["しかし"],["、"],["その"],["側女","そばめ"],["は"],["主人","しゅじん"],["を"],["裏切り","うらぎり"],["、"],["その"],["もと"],["を"],["去って","さって"],["ユダ"],["の"],["ベツレヘム"],["の"],["父","ちち"],["の"],["家","いえ"],["に"],["帰り","かえり"],["、"],["四","よん"],["か月","かげつ"],["ほど"],["そこ"],["に"],["いた"],["。"]]},{"verse":3,"text":"夫は若者を伴い、一軛のろばを連れて出で立ち、彼女の後を追い、その心に話しかけて連れ戻そうとした。彼女が彼を父の家に入れると、娘の父は彼を見て、喜び迎えた。","tok":[["夫","おっと"],["は"],["若者","わかもの"],["を"],["伴い","ともない"],["、"],["一","いち"],["軛","くびき"],["の"],["ろば"],["を"],["連れて","つれて"],["出で立ち","いでたち"],["、"],["彼女","かのじょ"],["の"],["後","あと"],["を"],["追い","おい"],["、"],["その"],["心","こころ"],["に"],["話しかけて","はなしかけて"],["連れ戻そう","つれもどそう"],["と"],["した"],["。"],["彼女","かのじょ"],["が"],["彼","かれ"],["を"],["父","ちち"],["の"],["家","いえ"],["に"],["入れる","いれる"],["と"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["彼","かれ"],["を"],["見て","みて"],["、"],["喜び迎えた","よろこびむかえた"],["。"]]},{"verse":4,"text":"そのしゅうと、娘の父が引き止めるので、彼は三日間そこにとどまり、食べて飲み、夜を過ごした。","tok":[["その"],["しゅうと"],["、"],["娘","むすめ"],["の"],["父","ちち"],["が"],["引き止める","ひきとめる"],["ので"],["、"],["彼","かれ"],["は"],["三","みっ"],["日間","かかん"],["そこ"],["に"],["とどまり"],["、"],["食べて","たべて"],["飲み","のみ"],["、"],["夜","よる"],["を"],["過ごした","すごした"],["。"]]},{"verse":5,"text":"四日目の朝早く彼は起きて出発しようとしたが、娘の父が婿に、「パンを一切れ食べて元気をつけ、それから出かけた方がいい」と言うので、","tok":[["四日目","よんかめ"],["の"],["朝","あさ"],["早く","はやく"],["彼","かれ"],["は"],["起きて","おきて"],["出発","しゅっぱつ"],["しよう"],["と"],["した"],["が"],["、"],["娘","むすめ"],["の"],["父","ちち"],["が"],["婿","むこ"],["に"],["、"],["「"],["パン"],["を"],["一切れ","ひときれ"],["食べて","たべて"],["元気","げんき"],["を"],["つけ"],["、"],["それ"],["から"],["出かけた","でかけた"],["方","ほう"],["が"],["いい"],["」"],["と"],["言う","いう"],["ので"],["、"]]},{"verse":6,"text":"二人は一緒に座り、食べて飲んだ。娘の父は男に、「どうか、もう一晩泊まってくつろいでください」と言った。","tok":[["二人","ふたり"],["は"],["一緒","いっしょ"],["に"],["座り","すわり"],["、"],["食べて","たべて"],["飲んだ","のんだ"],["。"],["娘","むすめ"],["の"],["父","ちち"],["は"],["男","おとこ"],["に"],["、"],["「"],["どう"],["か"],["、"],["もう"],["一","いち"],["晩","ばん"],["泊まって","とまって"],["くつろいで"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"男は立ち上がって出発しようとしたが、しゅうとがしきりに勧めるので、また泊まることにした。","tok":[["男","おとこ"],["は"],["立ち上がって","たちあがって"],["出発","しゅっぱつ"],["しよう"],["と"],["した"],["が"],["、"],["しゅうと"],["が"],["しきり"],["に"],["勧める","すすめる"],["ので"],["、"],["また"],["泊まる","とまる"],["こと"],["に"],["した"],["。"]]},{"verse":8,"text":"五日目も朝早く彼は出発しようとしたが、娘の父が、「元気をつけた方がいい」と言うので、二人は日の傾くころまでゆっくり食事をした。","tok":[["五日目","いつかめ"],["も"],["朝","あさ"],["早く","はやく"],["彼","かれ"],["は"],["出発","しゅっぱつ"],["しよう"],["と"],["した"],["が"],["、"],["娘","むすめ"],["の"],["父","ちち"],["が"],["、"],["「"],["元気","げんき"],["を"],["つけた"],["方","ほう"],["が"],["いい"],["」"],["と"],["言う","いう"],["ので"],["、"],["二人","ふたり"],["は"],["日","ひ"],["の"],["傾く","かたむく"],["ころ"],["まで"],["ゆっくり"],["食事","しょくじ"],["を"],["した"],["。"]]},{"verse":9,"text":"彼が側女と若者を連れて出発しようとすると、そのしゅうと、娘の父は、「日もかげってきて、もう夕方です。もう一晩お泊まりください。日は暮れかけています。ここに泊まってくつろぎ、明朝早く起きて旅路につき、家に帰ることにしてはどうですか」と言った。","tok":[["彼","かれ"],["が"],["側女","そばめ"],["と"],["若者","わかもの"],["を"],["連れて","つれて"],["出発","しゅっぱつ"],["しよう"],["と"],["する"],["と"],["、"],["その"],["しゅうと"],["、"],["娘","むすめ"],["の"],["父","ちち"],["は"],["、"],["「"],["日","ひ"],["も"],["かげって"],["きて"],["、"],["もう"],["夕方","ゆうがた"],["です"],["。"],["もう"],["一","いち"],["晩","ばん"],["お泊まり","おとまり"],["ください"],["。"],["日","ひ"],["は"],["暮れ","くれ"],["かけて"],["います"],["。"],["ここ"],["に"],["泊まって","とまって"],["くつろぎ"],["、"],["明朝","みょうちょう"],["早く","はやく"],["起きて","おきて"],["旅路","たびじ"],["に"],["つき"],["、"],["家","いえ"],["に"],["帰る","かえる"],["こと"],["に"],["して"],["は"],["どう"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"しかし、男は泊まろうとせず、立ち上がって出発し、エブスすなわちエルサレムを目の前にするところまで来た。彼は鞍をつけた一軛のろばと側女を連れていた。","tok":[["しかし"],["、"],["男","おとこ"],["は"],["泊まろう","とまろう"],["と"],["せず"],["、"],["立ち上がって","たちあがって"],["出発","しゅっぱつ"],["し"],["、"],["エブス"],["すなわち"],["エルサレム"],["を"],["目","め"],["の"],["前","まえ"],["に"],["する"],["ところ"],["まで"],["来た","きた"],["。"],["彼","かれ"],["は"],["鞍","くら"],["を"],["つけた"],["一","ひと"],["軛","くびき"],["の"],["ろば"],["と"],["側女","そばめ"],["を"],["連れて","つれて"],["いた"],["。"]]},{"verse":11,"text":"彼らがエブスの近くに来たとき、日は大きく傾いていた。若者は主人に、「あのエブス人の町に向かい、そこに泊まることにしてはいかがですか」と言ったが、","tok":[["彼","かれ"],["ら"],["が"],["エブス"],["の"],["近く","ちかく"],["に"],["来た","きた"],["とき"],["、"],["日","ひ"],["は"],["大きく","おおきく"],["傾いて","かたむいて"],["いた"],["。"],["若者","わかもの"],["は"],["主人","しゅじん"],["に"],["、"],["「"],["あの"],["エブス人","えぶすにん"],["の"],["町","まち"],["に"],["向かい","むかい"],["、"],["そこ"],["に"],["泊まる","とまる"],["こと"],["に"],["して"],["は"],["いかが"],["です"],["か"],["」"],["と"],["言った","いった"],["が"],["、"]]},{"verse":12,"text":"主人は、「イスラエルの人々ではないこの異国人の町には入るまい。ギブアまで進むことにしよう」と答えた。","tok":[["主人","しゅじん"],["は"],["、"],["「"],["イスラエル"],["の"],["人々","ひとびと"],["で"],["は"],["ない"],["この"],["異国人","いこくにん"],["の"],["町","まち"],["に"],["は"],["入るまい","はいるまい"],["。"],["ギブア"],["まで"],["進む","すすむ"],["こと"],["に"],["しよう"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":13,"text":"更に彼は若者に、「さあ、このいずれかの場所に近づいて行き、ギブアかラマに泊まることにしよう」と言った。","tok":[["更に","さらに"],["彼","かれ"],["は"],["若者","わかもの"],["に"],["、"],["「"],["さあ"],["、"],["この"],["いずれ"],["か"],["の"],["場所","ばしょ"],["に"],["近づいて","ちかづいて"],["行き","いき"],["、"],["ギブア"],["か"],["ラマ"],["に"],["泊まる","とまる"],["こと"],["に"],["しよう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"彼らは旅を続け、ベニヤミン領のギブアの近くで日は没した。","tok":[["彼","かれ"],["ら"],["は"],["旅","たび"],["を"],["続け","つづけ"],["、"],["ベニヤミン"],["領","りょう"],["の"],["ギブア"],["の"],["近く","ちかく"],["で"],["日","ひ"],["は"],["没した","ぼっした"],["。"]]},{"verse":15,"text":"彼らはギブアに入って泊まろうとして進み、町の広場に来て腰を下ろした。彼らを家に迎えて泊めてくれる者はいなかった。","tok":[["彼","かれ"],["ら"],["は"],["ギブア"],["に"],["入って","はいって"],["泊まろう","とまろう"],["として"],["進み","すすみ"],["、"],["町","まち"],["の"],["広場","ひろば"],["に"],["来て","きて"],["腰","こし"],["を"],["下ろした","おろした"],["。"],["彼","かれ"],["ら"],["を"],["家","いえ"],["に"],["迎えて","むかえ
[{"verse":1,"text":"イスラエルの人々は皆出て来て、ダンからベエル‧シェバ、またギレアドの地まで、一団となって一人の人のようになり、ミツパで主の前に集まった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["出て","でて"],["来て","きて"],["、"],["ダン"],["から"],["ベエル"],["‧"],["シェバ"],["、"],["また"],["ギレアド"],["の"],["地","ち"],["まで"],["、"],["一団","いちだん"],["と"],["なって"],["一人","ひとり"],["の"],["人","ひと"],["の"],["よう"],["に"],["なり"],["、"],["ミツパ"],["で"],["主","ぬし"],["の"],["前","まえ"],["に"],["集まった","あつまった"],["。"]]},{"verse":2,"text":"イスラエルの全部族、すべての民の要職にある者たちも、神の民、剣を携えた四十万の歩兵たちの集いに参加した。","tok":[["イスラエル"],["の"],["全部族","ぜんぶぞく"],["、"],["すべて"],["の"],["民","たみ"],["の"],["要職","ようしょく"],["に"],["ある"],["者","もの"],["たち"],["も"],["、"],["神","かみ"],["の"],["民","たみ"],["、"],["剣","けん"],["を"],["携えた","たずさえた"],["四十万","しじま"],["の"],["歩兵","ふひょう"],["たち"],["の"],["集い","つどい"],["に"],["参加","さんか"],["した"],["。"]]},{"verse":3,"text":"ベニヤミンの人々は、イスラエルの人々がミツパに上って来たことを伝え聞いた。イスラエルの人々が、「このような犯行がどうして行われたのか説明してもらいたい」と言ったので、","tok":[["ベニヤミン"],["の"],["人々","ひとびと"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["ミツパ"],["に"],["上って","のぼって"],["来た","きた"],["こと"],["を"],["伝え聞いた","つたえきいた"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["「"],["この"],["よう"],["な"],["犯行","はんこう"],["が"],["どう"],["して"],["行われた","おこなわれた"],["の"],["か"],["説明","せつめい"],["して"],["もらいたい"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":4,"text":"殺された女の夫であるレビ人はこう答えた。「ベニヤミンのギブアに来て、わたしは側女と共に宿をとっておりました。","tok":[["殺された","ころされた"],["女","おんな"],["の"],["夫","おっと"],["で"],["ある"],["レビ人","れびにん"],["は"],["こう"],["答えた","こたえた"],["。"],["「"],["ベニヤミン"],["の"],["ギブア"],["に"],["来て","きて"],["、"],["わたし"],["は"],["側女","そばめ"],["と"],["共","とも"],["に"],["宿","やど"],["を"],["とって"],["おりました"],["。"]]},{"verse":5,"text":"ギブアの首長たちがわたしに向かって来て、夜、わたしの泊まった家を取り囲み、わたしを殺そうとし、側女を辱めて死に至らせたのです。","tok":[["ギブア"],["の"],["首長","しゅちょう"],["たち"],["が"],["わたし"],["に"],["向かって","むかって"],["来て","きて"],["、"],["夜","よる"],["、"],["わたし"],["の"],["泊まった","とまった"],["家","いえ"],["を"],["取り囲み","とりかこみ"],["、"],["わたし"],["を"],["殺そう","ころそう"],["と"],["し"],["、"],["側女","そばめ"],["を"],["辱めて","はずかしめて"],["死","し"],["に"],["至らせた","いたらせた"],["の"],["です"],["。"]]},{"verse":6,"text":"わたしは側女をつかみ、その体を切り離して、イスラエルの嗣業の全耕地に送りました。彼らがイスラエルの中で極悪非道なことをしたからです。","tok":[["わたし"],["は"],["側女","そばめ"],["を"],["つかみ"],["、"],["その"],["体","からだ"],["を"],["切り離して","きりはなして"],["、"],["イスラエル"],["の"],["嗣業","しぎょう"],["の"],["全","ぜん"],["耕地","こうち"],["に"],["送りました","おくりました"],["。"],["彼","かれ"],["ら"],["が"],["イスラエル"],["の"],["中","なか"],["で"],["極悪","ごくあく"],["非道","ひどう"],["な"],["こと"],["を"],["した"],["から"],["です"],["。"]]},{"verse":7,"text":"あなたたちイスラエルのすべての人々よ。ここで話し合って協議していただきたい。」","tok":[["あなた"],["たち"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["よ"],["。"],["ここ"],["で"],["話し合って","はなしあって"],["協議","きょうぎ"],["して"],["いただきたい"],["。"],["」"]]},{"verse":8,"text":"すべての民は一人の人のように立ち上がり、こう言った。「我々はだれも自分の天幕に帰らず、だれも家に戻らない。","tok":[["すべて"],["の"],["民","たみ"],["は"],["一人","ひとり"],["の"],["人","ひと"],["の"],["よう"],["に"],["立ち上がり","たちあがり"],["、"],["こう"],["言った","いった"],["。"],["「"],["我々","われわれ"],["は"],["だれ"],["も"],["自分","じぶん"],["の"],["天幕","てんまく"],["に"],["帰らず","かえらず"],["、"],["だれ"],["も"],["家","いえ"],["に"],["戻らない","もどらない"],["。"]]},{"verse":9,"text":"我々が今、ギブアに対してなすべきことはこうだ。ギブアに対してまずくじを引いて攻め上ろう。","tok":[["我々","われわれ"],["が"],["今","いま"],["、"],["ギブア"],["に対して","にたいして"],["なすべき"],["こと"],["は"],["こう"],["だ"],["。"],["ギブア"],["に対して","にたいして"],["まず"],["くじ"],["を"],["引いて","ひいて"],["攻め上ろう","せめのぼろう"],["。"]]},{"verse":10,"text":"イスラエル全部族から百人につき十人、従って千人なら百人、一万人いれば千人を選んで糧食を調達させ、部隊をベニヤミンのギブアに行かせ、ベニヤミンがイスラエルの中で行ったすべての非道を制裁しよう。」","tok":[["イスラエル"],["全","ぜん"],["部族","ぶぞく"],["から"],["百人","ひゃくにん"],["に"],["つき"],["十人","じゅうにん"],["、"],["従って","したがって"],["千人","せんにん"],["なら"],["百人","ひゃくにん"],["、"],["一万人","いちまんにん"],["いれば"],["千人","せんにん"],["を"],["選んで","えらんで"],["糧食","りょうしょく"],["を"],["調達","ちょうたつ"],["させ"],["、"],["部隊","ぶたい"],["を"],["ベニヤミン"],["の"],["ギブア"],["に"],["行かせ","いかせ"],["、"],["ベニヤミン"],["が"],["イスラエル"],["の"],["中","なか"],["で"],["行った","おこなった"],["すべて"],["の"],["非道","ひどう"],["を"],["制裁","せいさい"],["しよう"],["。"],["」"]]},{"verse":11,"text":"こうしてイスラエルの者が皆、一人の人のように連帯を固めてその町に向かって集まった。","tok":[["こう"],["して"],["イスラエル"],["の"],["者","もの"],["が"],["皆","みな"],["、"],["一人","ひとり"],["の"],["人","ひと"],["の"],["よう"],["に"],["連帯","れんたい"],["を"],["固めて","かためて"],["その"],["町","まち"],["に"],["向かって","むかって"],["集まった","あつまった"],["。"]]},{"verse":12,"text":"イスラエルの諸部族は、全ベニヤミン族に人を送って、こう告げた。「あなたたちの中で行われたあの犯行はなんということか。","tok":[["イスラエル"],["の"],["諸","しょ"],["部族","ぶぞく"],["は"],["、"],["全","ぜん"],["ベニヤミン"],["族","ぞく"],["に"],["人","ひと"],["を"],["送って","おくって"],["、"],["こう"],["告げた","つげた"],["。"],["「"],["あなた"],["たち"],["の"],["中","なか"],["で"],["行われた","おこなわれた"],["あの"],["犯行","はんこう"],["は"],["なん"],["と"],["いう"],["こと"],["か"],["。"]]},{"verse":13,"text":"今、あのならず者の犯人がギブアにいれば、引き渡せ。犯人を殺してイスラエルの中から悪を取り除こう。」だが、ベニヤミンの人々は、その兄弟たち、イスラエルの人々の声を聞こうとはしなかった。","tok":[["今","いま"],["、"],["あの"],["ならず者","ならずもの"],["の"],["犯人","はんにん"],["が"],["ギブア"],["に"],["いれば"],["、"],["引き渡せ","ひきわたせ"],["。"],["犯人","はんにん"],["を"],["殺して","ころして"],["イスラエル"],["の"],["中","なか"],["から"],["悪","あく"],["を"],["取り除こう","とりのぞこう"],["。"],["」"],["だ"],["が"],["、"],["ベニヤミン"],["の"],["人々","ひとびと"],["は"],["、"],["その"],["兄弟","きょうだい"],["たち"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["声","こえ"],["を"],["聞こう","きこう"],["と"],["は"],["しなかった"],["。"]]},{"verse":14,"text":"かえってベニヤミンの人々は町々からギブアに集まり、イスラエルの人々と戦おうとして出て来た。","tok":[["かえって"],["ベニヤミン"],["の"],["人々","ひとびと"],["は"],["町々","まちまち"],["から"],["ギブア"],["に"],["集まり","あつまり"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["戦おう","たたかおう"],["として"],["出て","でて"],["来た","きた"],["。"]]},{"verse":15,"text":"その日、町々からはせ参じたベニヤミンの人々は、数を調べると、剣を携えた兵士二万六千人、そのほかにギブアの住民からえり抜きの兵士七百人であった。","tok":[["その"],["日","ひ"],["、"],["町々","まちまち"],["から"],["はせ参じた","はせさんじた"],["ベニヤミン"],["の"],["人々","ひとびと"],["は"],["、"],["数","すう"],["を"],["調べる","しらべる"],["と"],["、"],["剣","けん"],["を"],["携えた","たずさえた"],["兵士","へいし"],["二万六千","にまんろくせん"],["人","にん"],["、"],["その"],["ほか"],["に"],["ギブア"],["の"],["住民","じゅうみん"],["から"],["えり抜き","えりぬき"],["の"],["兵士","へいし"],["七百人","ななひゃくにん"],["で"],["あった"],["。"]]},{"verse":16,"text":"七百人のえり抜きの兵士からなるこの部隊の皆が左利きで、髪の毛一筋をねらって石を投げても、その的をはずすことがなかった。","tok":[["七","しち"],["百人","ひゃくにん"],["の"],["えり抜き","えりぬき"],["の"],["兵士","へいし"],["から"],["なる"],["この"],["部隊","ぶたい"],["の"],["皆","みな"],["が"],["左利き","
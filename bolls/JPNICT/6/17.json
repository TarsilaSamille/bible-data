[{"verse":1,"text":"マナセ部族もくじで領地の割り当てを受けた。マナセはヨセフの長男である。マナセの長男マキルは、ギレアドの父で、戦にたけ、ギレアドとバシャン地方を手に入れた。","tok":[["マナセ"],["部族","ぶぞく"],["も"],["くじ"],["で"],["領地","りょうち"],["の"],["割り当て","わりあて"],["を"],["受けた","うけた"],["。"],["マナセ"],["は"],["ヨセフ"],["の"],["長男","ちょうなん"],["で"],["ある"],["。"],["マナセ"],["の"],["長男","ちょうなん"],["マキル"],["は"],["、"],["ギレアド"],["の"],["父","ちち"],["で"],["、"],["戦","いくさ"],["に"],["たけ"],["、"],["ギレアド"],["と"],["バシャン"],["地方","ちほう"],["を"],["手","て"],["に"],["入れた","いれた"],["。"]]},{"verse":2,"text":"他のマナセの子孫、すなわちアビエゼル、ヘレク、アスリエル、シケム、ヘフェル、シェミダの人々も、氏族ごとに割り当てを受けた。彼らはヨセフの子マナセの子孫であって、氏族ごとの男子である。","tok":[["他","ほか"],["の"],["マナセ"],["の"],["子孫","しそん"],["、"],["すなわち"],["アビエゼル"],["、"],["ヘレク"],["、"],["アスリエル"],["、"],["シケム"],["、"],["ヘフェル"],["、"],["シェミダ"],["の"],["人々","ひとびと"],["も"],["、"],["氏族","しぞく"],["ごと"],["に"],["割り当て","わりあて"],["を"],["受けた","うけた"],["。"],["彼","かれ"],["ら"],["は"],["ヨセフ"],["の"],["子","こ"],["マナセ"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["氏族","しぞく"],["ごと"],["の"],["男子","だんし"],["で"],["ある"],["。"]]},{"verse":3,"text":"ツェロフハドは、マナセ、マキル、ギレアド、ヘフェルと続く家系に属していたが、彼には息子がなく、娘だけであった。娘たちの名は、マフラ、ノア、ホグラ、ミルカ、ティルツァといった。","tok":[["ツェロフハド"],["は"],["、"],["マナセ"],["、"],["マキル"],["、"],["ギレアド"],["、"],["ヘフェル"],["と"],["続く","つづく"],["家系","かけい"],["に"],["属して","ぞくして"],["いた"],["が"],["、"],["彼","かれ"],["に"],["は"],["息子","むすこ"],["が"],["なく"],["、"],["娘","むすめ"],["だけ"],["で"],["あった"],["。"],["娘","むすめ"],["たち"],["の"],["名","な"],["は"],["、"],["マフラ"],["、"],["ノア"],["、"],["ホグラ"],["、"],["ミルカ"],["、"],["ティルツァ"],["と"],["いった"],["。"]]},{"verse":4,"text":"彼女たちは、祭司エルアザル、ヌンの子ヨシュア、および指導者たちの前に進み出て、「主はわたしたちにも親族の間に嗣業の土地を与えるように、既にモーセに命じておられます」と申し立てた。彼女たちは、主の命令に従い、父の兄弟たちの間に嗣業の土地を与えられた。","tok":[["彼女","かのじょ"],["たち"],["は"],["、"],["祭司","さいし"],["エルアザル"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["、"],["および"],["指導者","しどうしゃ"],["たち"],["の"],["前","まえ"],["に"],["進み出て","すすみでて"],["、"],["「"],["主","ぬし"],["は"],["わたしたち"],["に"],["も"],["親族","しんぞく"],["の"],["間","あいだ"],["に"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["与える","あたえる"],["よう"],["に"],["、"],["既に","すでに"],["モーセ"],["に"],["命じて","めいじて"],["おられます"],["」"],["と"],["申し立てた","もうしたてた"],["。"],["彼女","かのじょ"],["たち"],["は"],["、"],["主","ぬし"],["の"],["命令","めいれい"],["に"],["従い","したがい"],["、"],["父","ちち"],["の"],["兄弟","きょうだい"],["たち"],["の"],["間","あいだ"],["に"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":5,"text":"マナセ族にはこうして、ヨルダン川の東、ギレアドとバシャン地方のほかに、十の地域が配分された。","tok":[["マナセ族","まなせぞく"],["に"],["は"],["こう"],["して"],["、"],["ヨルダン"],["川","かわ"],["の"],["東","ひがし"],["、"],["ギレアド"],["と"],["バシャン"],["地方","ちほう"],["の"],["ほか"],["に"],["、"],["十","じゅう"],["の"],["地域","ちいき"],["が"],["配分","はいぶん"],["された"],["。"]]},{"verse":6,"text":"マナセの娘たちが、息子たちと共に嗣業の土地を受け継いだからである。ただしギレアド地方は、他のマナセの子孫のものとなった。","tok":[["マナセ"],["の"],["娘","むすめ"],["たち"],["が"],["、"],["息子","むすこ"],["たち"],["と"],["共","とも"],["に"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["受け継いだ","うけついだ"],["から"],["で"],["ある"],["。"],["ただし"],["ギレアド"],["地方","ちほう"],["は"],["、"],["他","た"],["の"],["マナセ"],["の"],["子孫","しそん"],["の"],["もの"],["と"],["なった"],["。"]]},{"verse":7,"text":"マナセの領域は、アシェル領からシケムに近いミクメタトに広がり、更に南に延び、ヤシブ‧エン‧タプアに至った。","tok":[["マナセ"],["の"],["領域","りょういき"],["は"],["、"],["アシェル"],["領","りょう"],["から"],["シケム"],["に"],["近い","ちかい"],["ミクメタト"],["に"],["広がり","ひろがり"],["、"],["更に","さらに"],["南","みなみ"],["に"],["延び","のび"],["、"],["ヤシブ"],["‧"],["エン"],["‧"],["タプア"],["に"],["至った","いたった"],["。"]]},{"verse":8,"text":"タプア地方はマナセ領に属するが、境界線にあったタプアはエフライムの人々に属した。","tok":[["タプア"],["地方","ちほう"],["は"],["マナセ領","まなせりょう"],["に"],["属する","ぞくする"],["が"],["、"],["境界線","きょうかいせん"],["に"],["あった"],["タプア"],["は"],["エフライム"],["の"],["人々","ひとびと"],["に"],["属した","ぞくした"],["。"]]},{"verse":9,"text":"国境は更にカナ川沿いに下っていたが、川の南岸の町々はマナセの町々の中にありながらエフライムに属していた。マナセの国境は、川の北岸に沿い、海に達する。","tok":[["国境","こっきょう"],["は"],["更に","さらに"],["カナ"],["川沿い","かわそい"],["に"],["下って","くだって"],["いた"],["が"],["、"],["川","かわ"],["の"],["南岸","なんがん"],["の"],["町々","まちまち"],["は"],["マナセ"],["の"],["町々","まちまち"],["の"],["中","なか"],["に"],["あり"],["ながら"],["エフライム"],["に"],["属して","ぞくして"],["いた"],["。"],["マナセ"],["の"],["国境","こっきょう"],["は"],["、"],["川","かわ"],["の"],["北岸","ほくがん"],["に"],["沿い","そい"],["、"],["海","うみ"],["に"],["達する","たっする"],["。"]]},{"verse":10,"text":"すなわち川の南はエフライム領、北はマナセ領であった。西は海がその境となり、北はアシェル領、東はイサカル領と接していた。","tok":[["すなわち"],["川","かわ"],["の"],["南","みなみ"],["は"],["エフライム"],["領","りょう"],["、"],["北","きた"],["は"],["マナセ領","まなせりょう"],["で"],["あった"],["。"],["西","にし"],["は"],["海","うみ"],["が"],["その"],["境","さかい"],["と"],["なり"],["、"],["北","きた"],["は"],["アシェル"],["領","りょう"],["、"],["東","ひがし"],["は"],["イサカル"],["領","りょう"],["と"],["接して","せっして"],["いた"],["。"]]},{"verse":11,"text":"またイサカルおよびアシェル領内でも、ベト‧シェアン、イブレアムとそれぞれの周辺村落、ドルおよびエン‧ドルの住民とそれぞれの周辺村落、タナク、メギドの住民とそれぞれの周辺村落など三つの台地はマナセに属した。","tok":[["また"],["イサカル"],["および"],["アシェル"],["領","りょう"],["内","ない"],["で"],["も"],["、"],["ベト"],["‧"],["シェアン"],["、"],["イブレアム"],["と"],["それぞれ"],["の"],["周辺","しゅうへん"],["村落","そんらく"],["、"],["ドル"],["および"],["エン"],["‧"],["ドル"],["の"],["住民","じゅうみん"],["と"],["それぞれ"],["の"],["周辺","しゅうへん"],["村落","そんらく"],["、"],["タナク"],["、"],["メギド"],["の"],["住民","じゅうみん"],["と"],["それぞれ"],["の"],["周辺","しゅうへん"],["村落","そんらく"],["など"],["三","みっ"],["つ"],["の"],["台地","だいち"],["は"],["マナセ"],["に"],["属した","ぞくした"],["。"]]},{"verse":12,"text":"マナセの人々はこれらの町を占領できなかったので、カナン人はこの地域に住み続けた。","tok":[["マナセ"],["の"],["人々","ひとびと"],["は"],["これ"],["ら"],["の"],["町","まち"],["を"],["占領","せんりょう"],["できなかった"],["ので"],["、"],["カナン人","かなんにん"],["は"],["この"],["地域","ちいき"],["に"],["住み","すみ"],["続けた","つづけた"],["。"]]},{"verse":13,"text":"イスラエルの人々は強くなってからも、カナン人を強制労働に従事させただけで、徹底的に追い出すことはできなかった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["強く","つよく"],["なって"],["から"],["も"],["、"],["カナン人","かなんにん"],["を"],["強制","きょうせい"],["労働","ろうどう"],["に"],["従事","じゅうじ"],["させた"],["だけ"],["で"],["、"],["徹底的","てっていてき"],["に"],["追い出す","おいだす"],["こと"],["は"],["できなかった"],["。"]]},{"verse":14,"text":"ヨセフの子らがヨシュアに、「あなたはなぜ、ただ一つのくじによる嗣業の土地、一つの割り当てしかくださらないのですか。わたしの民は、主に祝福されて、これほど数多くなりました」と言うと、","tok":[["ヨセフ"],["の"],["子","こ"],["ら"],["が"],["ヨシュア"],["に"],["、"],["「"],["あなた"],["は"],["なぜ"],["、"],["ただ"],["一","ひと"],["つ"],["の"],["くじ"],["に"],["よる"],["嗣業","しぎょう"],["の"],["土地","とち"],["、"],["一","ひと"],["つ"],["の"],["割り当て","わりあて"],["しか"],["くださらない"],["の"],["です"],["か"],["。"],["わたし"],["の"],["民","たみ"],["は"],["、"],["主に","おもに"],["祝福","しゅくふく"],["されて"],["、"],["これ"],["ほど"],["数多く","かずおおく"],["なりました"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":15,"text":"ヨシュアは答えた。「あなたの民の数が多くて、エフライムの山地が手狭なら、森林地帯に入って行き、ペリジ人やレファイム人の地域を開拓するがよい。」","tok":[["ヨシュア"],["は"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["民","たみ"],["の"],["数","かず"],["が"],["多くて","おおくて"],["、"],["エフライム"],["の"],["山地","さんち"],["が"],["手狭","てぜま"],["なら"],["、"],["森林","しんりん"],["地帯","ちたい"],["に"],["入って","はいって"],["行き","いき"],["、"],["ペリジ人","ぺりじにん"],["や"],["レファイム"],["人","にん"],["の"],["地域","ちいき"],["を"],["開拓","かいたく"],["する"],["が"],["よい"],["。"],["」"]]},{"verse":16,"text":"ヨセフの子らが、「山地だけでは足りません。しかし平地に住むカナン人は、ベト‧シェアンとその周辺村落の住民もイズレエル平野の住民も皆、鉄の戦車を持っています」と言うと、","tok":[["ヨセフ"],["の"],["子","こ"],["ら"],["が"],["、"],["「"],["山地","さんち"],["だけ"],["で"],["は"],["足りません","たりません"],["。"],["しかし"],["平地","へいち"],["に"],["住む","すむ"],["カナン人","かなんにん"],["は"],["、"],["ベト"],["‧"],["シェアン"],["と"],["その"],["周辺","しゅうへん"],["村落","そんらく"],["の"],["住民","じゅうみん"],["も"],["イズレエル"],["平野","へいや"],["の"],["住民","じゅうみん"],["も"],["皆","みな"],["、"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["を"],["持って","もって"],["います"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":17,"text":"ヨシュアはヨセフの家、すなわちエフライムとマナセに答えた。「確かにあなたは数も多く、力も強い民となった。あなたの割り当ては、ただ一つのくじに限られてはならない。","tok":[["ヨシュア"],["は"],["ヨセフ"],["の"],["家","いえ"],["、"],["すなわち"],["エフライム"],["と"],["マナセ"],["に"],["答えた","こたえた"],["。"],["「"],["確か","たしか"],["に"],["あなた"],["は"],["数","すう"],["も"],["多く","おおく"],["、"],["力","ちから"],["も"],["強い","つよい"],["民","たみ"],["と"],["なった"],["。"],["あなた"],["の"],["割り当て","わりあて"],["は"],["、"],["ただ"],["一","ひと"],["つ"],["の"],["くじ"],["に"],["限られて","かぎられて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"山地は森林だが、開拓してことごとく自分のものにするがよい。カナン人は鉄の戦車を持っていて、強いかもしれないが、きっと追い出すことができよう。」","tok":[["山地","さんち"],["は"],["森林","しんりん"],["だ"],["が"],["、"],["開拓","かいたく"],["して"],["ことごとく"],["自分","じぶん"],["の"],["もの"],["に"],["する"],["が"],["よい"],["。"],["カナン人","かなんにん"],["は"],["鉄","てつ"],["の"],["戦車","せんしゃ"],["を"],["持って","もって"],["いて"],["、"],["強い","つよい"],["か"],["も"],["しれない"],["が"],["、"],["きっと"],["追い出す","おいだす"],["こと"],["が"],["できよう"],["。"],["」"]]}]
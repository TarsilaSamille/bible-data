[{"verse":1,"text":"主の僕モーセの死後、主はモーセの従者、ヌンの子ヨシュアに言われた。","tok":[["主","ぬし"],["の"],["僕","ぼく"],["モーセ"],["の"],["死後","しご"],["、"],["主","ぬし"],["は"],["モーセ"],["の"],["従者","じゅうしゃ"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["に"],["言われた","いわれた"],["。"]]},{"verse":2,"text":"「わたしの僕モーセは死んだ。今、あなたはこの民すべてと共に立ってヨルダン川を渡り、わたしがイスラエルの人々に与えようとしている土地に行きなさい。","tok":[["「"],["わたし"],["の"],["僕","ぼく"],["モーセ"],["は"],["死んだ","しんだ"],["。"],["今","いま"],["、"],["あなた"],["は"],["この"],["民","みん"],["すべて"],["と"],["共","とも"],["に"],["立って","たって"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["、"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与えよう","あたえよう"],["として"],["いる"],["土地","とち"],["に"],["行き","いき"],["なさい"],["。"]]},{"verse":3,"text":"モーセに告げたとおり、わたしはあなたたちの足の裏が踏む所をすべてあなたたちに与える。","tok":[["モーセ"],["に"],["告げた","つげた"],["とおり"],["、"],["わたし"],["は"],["あなた"],["たち"],["の"],["足","あし"],["の"],["裏","うら"],["が"],["踏む","ふむ"],["所","ところ"],["を"],["すべて"],["あなた"],["たち"],["に"],["与える","あたえる"],["。"]]},{"verse":4,"text":"荒れ野からレバノン山を越え、あの大河ユーフラテスまで、ヘト人の全地を含み、太陽の沈む大海に至るまでが、あなたたちの領土となる。","tok":[["荒れ野","あれの"],["から"],["レバノン"],["山","さん"],["を"],["越え","こえ"],["、"],["あの"],["大河","たいが"],["ユーフラテス"],["まで"],["、"],["ヘト人","へとにん"],["の"],["全地","ぜんち"],["を"],["含み","ふくみ"],["、"],["太陽","たいよう"],["の"],["沈む","しずむ"],["大海","たいかい"],["に"],["至る","いたる"],["まで"],["が"],["、"],["あなた"],["たち"],["の"],["領土","りょうど"],["と"],["なる"],["。"]]},{"verse":5,"text":"一生の間、あなたの行く手に立ちはだかる者はないであろう。わたしはモーセと共にいたように、あなたと共にいる。あなたを見放すことも、見捨てることもない。","tok":[["一生","いっしょう"],["の"],["間","あいだ"],["、"],["あなた"],["の"],["行く手","ゆくて"],["に"],["立ちはだかる","たちはだかる"],["者","もの"],["は"],["ないで"],["あろう"],["。"],["わたし"],["は"],["モーセ"],["と"],["共","とも"],["に"],["いた"],["よう"],["に"],["、"],["あなた"],["と"],["共","とも"],["に"],["いる"],["。"],["あなた"],["を"],["見放す","みはなす"],["こと"],["も"],["、"],["見捨てる","みすてる"],["こと"],["も"],["ない"],["。"]]},{"verse":6,"text":"強く、雄々しくあれ。あなたは、わたしが先祖たちに与えると誓った土地を、この民に継がせる者である。","tok":[["強く","つよく"],["、"],["雄々しく","おおしく"],["あれ"],["。"],["あなた"],["は"],["、"],["わたし"],["が"],["先祖","せんぞ"],["たち"],["に"],["与える","あたえる"],["と"],["誓った","ちかった"],["土地","とち"],["を"],["、"],["この"],["民","たみ"],["に"],["継がせる","つがせる"],["者","もの"],["で"],["ある"],["。"]]},{"verse":7,"text":"ただ、強く、大いに雄々しくあって、わたしの僕モーセが命じた律法をすべて忠実に守り、右にも左にもそれてはならない。そうすれば、あなたはどこに行っても成功する。","tok":[["ただ"],["、"],["強く","つよく"],["、"],["大いに","おおいに"],["雄々しく","おおしく"],["あって"],["、"],["わたし"],["の"],["僕","ぼく"],["モーセ"],["が"],["命じた","めいじた"],["律法","りっぽう"],["を"],["すべて"],["忠実","ちゅうじつ"],["に"],["守り","まもり"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それ"],["て"],["は"],["ならない"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["どこ"],["に"],["行って","いって"],["も"],["成功","せいこう"],["する"],["。"]]},{"verse":8,"text":"この律法の書をあなたの口から離すことなく、昼も夜も口ずさみ、そこに書かれていることをすべて忠実に守りなさい。そうすれば、あなたは、その行く先々で栄え、成功する。","tok":[["この"],["律法","りっぽう"],["の"],["書","しょ"],["を"],["あなた"],["の"],["口","くち"],["から"],["離す","はなす"],["こと"],["なく"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["口ずさみ","くちずさみ"],["、"],["そこ"],["に"],["書かれて","かかれて"],["いる"],["こと"],["を"],["すべて"],["忠実","ちゅうじつ"],["に"],["守り","まもり"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["は"],["、"],["その"],["行く","いく"],["先々","さきざき"],["で"],["栄え","さかえ"],["、"],["成功","せいこう"],["する"],["。"]]},{"verse":9,"text":"わたしは、強く雄々しくあれと命じたではないか。うろたえてはならない。おののいてはならない。あなたがどこに行ってもあなたの神、主は共にいる。」","tok":[["わたし"],["は"],["、"],["強く","つよく"],["雄々しく","おおしく"],["あれ"],["と"],["命じたで","めいじたで"],["は"],["ない"],["か"],["。"],["うろたえて"],["は"],["ならない"],["。"],["おののいて"],["は"],["ならない"],["。"],["あなた"],["が"],["どこ"],["に"],["行って","いって"],["も"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["共","とも"],["に"],["いる"],["。"],["」"]]},{"verse":10,"text":"ヨシュアは民の役人たちに命じた。","tok":[["ヨシュア"],["は"],["民","みん"],["の"],["役人","やくにん"],["たち"],["に"],["命じた","めいじた"],["。"]]},{"verse":11,"text":"「宿営内を巡って民に命じ、こう言いなさい。おのおの食糧を用意せよ。あなたたちは、あと三日のうちに、このヨルダン川を渡る。あなたたちの神、主が得させようとしておられる土地に入り、それを得る。」","tok":[["「"],["宿営内","しゅくえいない"],["を"],["巡って","めぐって"],["民","みん"],["に"],["命じ","めいじ"],["、"],["こう"],["言い","いい"],["なさい"],["。"],["おのおの"],["食糧","しょくりょう"],["を"],["用意","ようい"],["せよ"],["。"],["あなた"],["たち"],["は"],["、"],["あと"],["三日","みっか"],["の"],["うち"],["に"],["、"],["この"],["ヨルダン"],["川","かわ"],["を"],["渡る","わたる"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["得させよう","えさせよう"],["として"],["おられる"],["土地","とち"],["に"],["入り","はいり"],["、"],["それ"],["を"],["得る","うる"],["。"],["」"]]},{"verse":12,"text":"ヨシュアは、ルベン人、ガド人、マナセの半部族に告げた。","tok":[["ヨシュア"],["は"],["、"],["ルベン人","るべんにん"],["、"],["ガド人","がどにん"],["、"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["に"],["告げた","つげた"],["。"]]},{"verse":13,"text":"「主の僕モーセが命じた言葉を思い起こしなさい。彼はこう言った。『この土地はあなたたちの安住の地、あなたたちの神、主が与えてくださったものである』と。","tok":[["「"],["主","ぬし"],["の"],["僕","ぼく"],["モーセ"],["が"],["命じた","めいじた"],["言葉","ことば"],["を"],["思い起こし","おもいおこし"],["なさい"],["。"],["彼","かれ"],["は"],["こう"],["言った","いった"],["。"],["『"],["この"],["土地","とち"],["は"],["あなた"],["たち"],["の"],["安住","あんじゅう"],["の"],["地","ち"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えて","あたえて"],["くださった"],["もの"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":14,"text":"モーセがあなたたちに与えたヨルダン川の東の地に妻子と家畜を残し、あなたたち、勇士は皆、隊伍を整え、同胞たちに先立って川を渡り、彼らを助けなさい。","tok":[["モーセ"],["が"],["あなた"],["たち"],["に"],["与えた","あたえた"],["ヨルダン"],["川","かわ"],["の"],["東","ひがし"],["の"],["地","ち"],["に"],["妻子","さいし"],["と"],["家畜","かちく"],["を"],["残し","のこし"],["、"],["あなた"],["たち"],["、"],["勇士","ゆうし"],["は"],["皆","みな"],["、"],["隊伍","たいご"],["を"],["整え","ととのえ"],["、"],["同胞","どうほう"],["たち"],["に"],["先立って","さきだって"],["川","かわ"],["を"],["渡り","わたり"],["、"],["彼","かれ"],["ら"],["を"],["助け","たすけ"],["なさい"],["。"]]},{"verse":15,"text":"主が彼らをも、あなたたちと同じように安らかに住まわせ、あなたたちの神、主が与えられる土地を、彼らも得られるようにしなさい。あなたたちはその後、主の僕モーセがあなたたちの領地としたヨルダン川の東、すなわち太陽の昇る側の土地に帰り、それを得なさい。」","tok":[["主","ぬし"],["が"],["彼","かれ"],["ら"],["を"],["も"],["、"],["あなた"],["たち"],["と"],["同じ","おなじ"],["よう"],["に"],["安らか","やすらか"],["に"],["住まわせ","すまわせ"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられる","あたえられる"],["土地","とち"],["を"],["、"],["彼","かれ"],["ら"],["も"],["得られる","えられる"],["よう"],["に"],["し"],["なさい"],["。"],["あなた"],["たち"],["は"],["その"],["後","ご"],["、"],["主","ぬし"],["の"],["僕","ぼく"],["モーセ"],["が"],["あなた"],["たち"],["の"],["領地","りょうち"],["と"],["した"],["ヨルダン"],["川","かわ"],["の"],["東","ひがし"],["、"],["すなわち"],["太陽","たいよう"],["の"],["昇る","のぼる"],["側","がわ"],["の"],["土地","とち"],["に"],["帰り","かえり"],["、"],["それ"],["を"],["得","え"],["なさい"],["。"],["」"]]},{"verse":16,"text":"彼らはヨシュアに答えた。「我々は、御命令を行います。遣わされる所にはどこへでも参ります。","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["に"],["答えた","こたえた"],["。"],["「"],["我々","われわれ"],["は"],["、"],["御命令","ごめいれい"],["を"],["行います","おこないます"],["。"],["遣わされる","つかわされる"],["所","ところ"],["に"],["は"],["どこ"],["へ"],["で"],["も"],["参ります","まいります"],["。"]]},{"verse":17,"text":"我々はモーセに従ったように、あなたに従います。どうか、あなたの神、主がモーセと共におられたように、あなたと共におられますように。","tok":[["我々","われわれ"],["は"],["モーセ"],["に"],["従った","したがった"],["よう"],["に"],["、"],["あなた"],["に"],["従います","したがいます"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["モーセ"],["と"],["共","とも"],["に"],["おられた"],["よう"],["に"],["、"],["あなた"],["と"],["共","とも"],["に"],["おられます"],["よう"],["に"],["。"]]},{"verse":18,"text":"いかなる命令であっても、あなたの口から出る言葉に背いて、従わない者は死に定められねばなりません。どうぞ、強く、雄々しくあってください。」","tok":[["いかなる"],["命令","めいれい"],["で"],["あって"],["も"],["、"],["あなた"],["の"],["口","くち"],["から"],["出る","でる"],["言葉","ことば"],["に"],["背いて","そむいて"],["、"],["従わない","したがわない"],["者","もの"],["は"],["死","し"],["に"],["定められねば","さだめられねば"],["なりません"],["。"],["どうぞ"],["、"],["強く","つよく"],["、"],["雄々しく","おおしく"],["あって"],["ください"],["。"],["」"]]}]
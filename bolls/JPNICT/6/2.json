[{"verse":1,"text":"ヌンの子ヨシュアは二人の斥候をシティムからひそかに送り出し、「行って、エリコとその周辺を探れ」と命じた。二人は行って、ラハブという遊女の家に入り、そこに泊まった。","tok":[["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["二人","ふたり"],["の"],["斥候","せっこう"],["を"],["シティム"],["から"],["ひそか"],["に"],["送り出し","おくりだし"],["、"],["「"],["行って","いって"],["、"],["エリコ"],["と"],["その"],["周辺","しゅうへん"],["を"],["探れ","さぐれ"],["」"],["と"],["命じた","めいじた"],["。"],["二人","ふたり"],["は"],["行って","いって"],["、"],["ラハブ"],["と"],["いう"],["遊女","ゆうじょ"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],["そこ"],["に"],["泊まった","とまった"],["。"]]},{"verse":2,"text":"ところが、エリコの王に、「今夜、イスラエルの何者かがこの辺りを探るために忍び込んで来ました」と告げる者があったので、","tok":[["ところ"],["が"],["、"],["エリコ"],["の"],["王","おう"],["に"],["、"],["「"],["今夜","こんや"],["、"],["イスラエル"],["の"],["何者","なにもの"],["か"],["が"],["この"],["辺り","あたり"],["を"],["探る","さぐる"],["ため"],["に"],["忍び込んで","しのびこんで"],["来ました","きました"],["」"],["と"],["告げる","つげる"],["者","もの"],["が"],["あった"],["ので"],["、"]]},{"verse":3,"text":"王は人を遣わしてラハブに命じた。「お前のところに来て、家に入り込んだ者を引き渡せ。彼らはこの辺りを探りに来たのだ。」","tok":[["王","おう"],["は"],["人","ひと"],["を"],["遣わして","つかわして"],["ラハブ"],["に"],["命じた","めいじた"],["。"],["「"],["お前","おまえ"],["の"],["ところ"],["に"],["来て","きて"],["、"],["家","いえ"],["に"],["入り込んだ","はいりこんだ"],["者","もの"],["を"],["引き渡せ","ひきわたせ"],["。"],["彼","かれ"],["ら"],["は"],["この"],["辺り","あたり"],["を"],["探り","さぐり"],["に"],["来た","きた"],["の"],["だ"],["。"],["」"]]},{"verse":4,"text":"女は、急いで二人をかくまい、こう答えた。「確かに、その人たちはわたしのところに来ましたが、わたしはその人たちがどこから来たのか知りませんでした。","tok":[["女","おんな"],["は"],["、"],["急いで","いそいで"],["二人","ふたり"],["を"],["かくまい"],["、"],["こう"],["答えた","こたえた"],["。"],["「"],["確か","たしか"],["に"],["、"],["その"],["人","ひと"],["たち"],["は"],["わたし"],["の"],["ところ"],["に"],["来ました","きました"],["が"],["、"],["わたし"],["は"],["その"],["人","ひと"],["たち"],["が"],["どこ"],["から"],["来た","きた"],["の"],["か"],["知りませんでした","しりませんでした"],["。"]]},{"verse":5,"text":"日が暮れて城門が閉まるころ、その人たちは出て行きましたが、どこへ行ったのか分かりません。急いで追いかけたら、あるいは追いつけるかもしれません。」","tok":[["日","ひ"],["が"],["暮れて","くれて"],["城門","じょうもん"],["が"],["閉まる","しまる"],["ころ"],["、"],["その"],["人","ひと"],["たち"],["は"],["出て","でて"],["行きました","いきました"],["が"],["、"],["どこ"],["へ"],["行った","いった"],["の"],["か"],["分かりません","わかりません"],["。"],["急いで","いそいで"],["追いかけたら","おいかけたら"],["、"],["あるいは"],["追いつける","おいつける"],["か"],["も"],["しれません"],["。"],["」"]]},{"verse":6,"text":"彼女は二人を屋上に連れて行き、そこに積んであった亜麻の束の中に隠していたが、","tok":[["彼女","かのじょ"],["は"],["二人","ふたり"],["を"],["屋上","おくじょう"],["に"],["連れて","つれて"],["行き","いき"],["、"],["そこ"],["に"],["積んで","つんで"],["あった"],["亜麻","あま"],["の"],["束","たば"],["の"],["中","なか"],["に"],["隠して","かくして"],["いた"],["が"],["、"]]},{"verse":7,"text":"追っ手は二人を求めてヨルダン川に通じる道を渡し場まで行った。城門は、追っ手が出て行くとすぐに閉じられた。","tok":[["追っ手","おって"],["は"],["二人","ふたり"],["を"],["求めて","もとめて"],["ヨルダン"],["川","かわ"],["に"],["通じる","つうじる"],["道","みち"],["を"],["渡し場","わたしば"],["まで"],["行った","いった"],["。"],["城門","じょうもん"],["は"],["、"],["追っ手","おって"],["が"],["出て","でて"],["行く","いく"],["と"],["すぐ"],["に"],["閉じられた","とじられた"],["。"]]},{"verse":8,"text":"二人がまだ寝てしまわないうちに、ラハブは屋上に上って来て、","tok":[["二人","ふたり"],["が"],["まだ"],["寝て","ねて"],["しまわない"],["うち"],["に"],["、"],["ラハブ"],["は"],["屋上","おくじょう"],["に"],["上って","のぼって"],["来て","きて"],["、"]]},{"verse":9,"text":"言った。「主がこの土地をあなたたちに与えられたこと、またそのことで、わたしたちが恐怖に襲われ、この辺りの住民は皆、おじけづいていることを、わたしは知っています。","tok":[["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["この"],["土地","とち"],["を"],["あなた"],["たち"],["に"],["与えられた","あたえられた"],["こと"],["、"],["また"],["その"],["こと"],["で"],["、"],["わたしたち"],["が"],["恐怖","きょうふ"],["に"],["襲われ","おそわれ"],["、"],["この"],["辺り","あたり"],["の"],["住民","じゅうみん"],["は"],["皆","みな"],["、"],["おじけ"],["づいて"],["いる"],["こと"],["を"],["、"],["わたし"],["は"],["知って","しって"],["います"],["。"]]},{"verse":10,"text":"あなたたちがエジプトを出たとき、あなたたちのために、主が葦の海の水を干上がらせたことや、あなたたちがヨルダン川の向こうのアモリ人の二人の王に対してしたこと、すなわち、シホンとオグを滅ぼし尽くしたことを、わたしたちは聞いています。","tok":[["あなた"],["たち"],["が"],["エジプト"],["を"],["出た","でた"],["とき"],["、"],["あなた"],["たち"],["の"],["ため"],["に"],["、"],["主","ぬし"],["が"],["葦","あし"],["の"],["海","うみ"],["の"],["水","みず"],["を"],["干上がらせた","ひあがらせた"],["こと"],["や"],["、"],["あなた"],["たち"],["が"],["ヨルダン"],["川","かわ"],["の"],["向こう","むこう"],["の"],["アモリ人","あもりにん"],["の"],["二人","ふたり"],["の"],["王","おう"],["に対して","にたいして"],["した"],["こと"],["、"],["すなわち"],["、"],["シホン"],["と"],["オグ"],["を"],["滅ぼし","ほろぼし"],["尽くした","つくした"],["こと"],["を"],["、"],["わたしたち"],["は"],["聞いて","きいて"],["います"],["。"]]},{"verse":11,"text":"それを聞いたとき、わたしたちの心は挫け、もはやあなたたちに立ち向かおうとする者は一人もおりません。あなたたちの神、主こそ、上は天、下は地に至るまで神であられるからです。","tok":[["それ"],["を"],["聞いた","きいた"],["とき"],["、"],["わたしたち"],["の"],["心","こころ"],["は"],["挫け","くじけ"],["、"],["もはや"],["あなた"],["たち"],["に"],["立ち向かおう","たちむかおう"],["と"],["する"],["者","もの"],["は"],["一人","ひとり"],["も"],["おりません"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["こそ"],["、"],["上","うえ"],["は"],["天","てん"],["、"],["下","した"],["は"],["地","ち"],["に"],["至る","いたる"],["まで"],["神","かみ"],["で"],["あられる"],["から"],["です"],["。"]]},{"verse":12,"text":"わたしはあなたたちに誠意を示したのですから、あなたたちも、わたしの一族に誠意を示す、と今、主の前でわたしに誓ってください。そして、確かな証拠をください。","tok":[["わたし"],["は"],["あなた"],["たち"],["に"],["誠意","せいい"],["を"],["示した","しめした"],["の"],["です"],["から"],["、"],["あなた"],["たち"],["も"],["、"],["わたし"],["の"],["一族","いちぞく"],["に"],["誠意","せいい"],["を"],["示す","しめす"],["、"],["と"],["今","いま"],["、"],["主","ぬし"],["の"],["前","まえ"],["で"],["わたし"],["に"],["誓って","ちかって"],["ください"],["。"],["そして"],["、"],["確か","たしか"],["な"],["証拠","しょうこ"],["を"],["ください"],["。"]]},{"verse":13,"text":"父も母も、兄弟姉妹も、更に彼らに連なるすべての者たちも生かし、わたしたちの命を死から救ってください。」","tok":[["父","ちち"],["も"],["母","はは"],["も"],["、"],["兄弟","きょうだい"],["姉妹","しまい"],["も"],["、"],["更に","さらに"],["彼","かれ"],["ら"],["に"],["連なる","つらなる"],["すべて"],["の"],["者","もの"],["たち"],["も"],["生かし","いかし"],["、"],["わたしたち"],["の"],["命","いのち"],["を"],["死","し"],["から"],["救って","すくって"],["ください"],["。"],["」"]]},{"verse":14,"text":"二人は彼女に答えた。「あなたたちのために、我々の命をかけよう。もし、我々のことをだれにも漏らさないなら、主がこの土地を我々に与えられるとき、あなたに誠意と真実を示そう。」","tok":[["二人","ふたり"],["は"],["彼女","かのじょ"],["に"],["答えた","こたえた"],["。"],["「"],["あなた"],["たち"],["の"],["ため"],["に"],["、"],["我々","われわれ"],["の"],["命","いのち"],["を"],["かけよう"],["。"],["もし"],["、"],["我々","われわれ"],["の"],["こと"],["を"],["だれ"],["に"],["も"],["漏らさないなら","もらさないなら"],["、"],["主","ぬし"],["が"],["この"],["土地","とち"],["を"],["我々","われわれ"],["に"],["与えられる","あたえられる"],["とき"],["、"],["あなた"],["に"],["誠意","せいい"],["と"],["真実","しんじつ"],["を"],["示そう","しめそう"],["。"],["」"]]},{"verse":15,"text":"ラハブは二人を窓から綱でつり降ろした
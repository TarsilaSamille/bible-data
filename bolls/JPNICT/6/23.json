[{"verse":1,"text":"主が周囲のすべての敵を退け、イスラエルに安住の地を与えてから長い年月が流れ、ヨシュアは多くの日を重ね、老人となった。","tok":[["主","ぬし"],["が"],["周囲","しゅうい"],["の"],["すべて"],["の"],["敵","てき"],["を"],["退け","しりぞけ"],["、"],["イスラエル"],["に"],["安住","あんじゅう"],["の"],["地","ち"],["を"],["与えて","あたえて"],["から"],["長い","ながい"],["年月","としつき"],["が"],["流れ","ながれ"],["、"],["ヨシュア"],["は"],["多く","おおく"],["の"],["日","ひ"],["を"],["重ね","かさね"],["、"],["老人","ろうじん"],["と"],["なった"],["。"]]},{"verse":2,"text":"ヨシュアは、長老、長、裁判人、役人を含む全イスラエルを呼び寄せて、言った。「わたしは年を重ね、老人となった。","tok":[["ヨシュア"],["は"],["、"],["長老","ちょうろう"],["、"],["長","ちょう"],["、"],["裁判人","さいばんにん"],["、"],["役人","やくにん"],["を"],["含む","ふくむ"],["全","ぜん"],["イスラエル"],["を"],["呼び寄せて","よびよせて"],["、"],["言った","いった"],["。"],["「"],["わたし"],["は"],["年","とし"],["を"],["重ね","かさね"],["、"],["老人","ろうじん"],["と"],["なった"],["。"]]},{"verse":3,"text":"あなたたちの神、主があなたたちのために、これらすべての国々に行われたことを、ことごとく、あなたたちは見てきた。あなたたちの神、主は御自らあなたたちのために戦ってくださった。","tok":[["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["の"],["ため"],["に"],["、"],["これ"],["ら"],["すべて"],["の"],["国々","くにぐに"],["に"],["行われた","おこなわれた"],["こと"],["を"],["、"],["ことごとく"],["、"],["あなた"],["たち"],["は"],["見て","みて"],["きた"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["御自ら","おみずから"],["あなた"],["たち"],["の"],["ため"],["に"],["戦って","たたかって"],["くださった"],["。"]]},{"verse":4,"text":"見よ、わたしはヨルダン川から、太陽の沈む大海に至る全域、すなわち未征服の国々も、既に征服した国々もことごとく、くじによってあなたたち各部族の嗣業の土地として分け与えた。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["ヨルダン"],["川","かわ"],["から"],["、"],["太陽","たいよう"],["の"],["沈む","しずむ"],["大海","たいかい"],["に"],["至る","いたる"],["全域","ぜんいき"],["、"],["すなわち"],["未","み"],["征服","せいふく"],["の"],["国々","くにぐに"],["も"],["、"],["既に","すでに"],["征服","せいふく"],["した"],["国々","くにぐに"],["も"],["ことごとく"],["、"],["くじ"],["によって"],["あなた"],["たち"],["各","かく"],["部族","ぶぞく"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["として"],["分け与えた","わけあたえた"],["。"]]},{"verse":5,"text":"あなたたちの神、主は、御自ら彼らをあなたたちのために押しのけ、あなたたちのために追い出される。あなたたちの神、主の約束されたとおり、あなたたちは彼らの土地を占領するであろう。","tok":[["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["御自ら","おみずから"],["彼","かれ"],["ら"],["を"],["あなた"],["たち"],["の"],["ため"],["に"],["押しのけ","おしのけ"],["、"],["あなた"],["たち"],["の"],["ため"],["に"],["追い出される","おいだされる"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["約束","やくそく"],["された"],["とおり"],["、"],["あなた"],["たち"],["は"],["彼","かれ"],["ら"],["の"],["土地","とち"],["を"],["占領","せんりょう"],["するで"],["あろう"],["。"]]},{"verse":6,"text":"だから、右にも左にもそれることなく、モーセの教えの書に書かれていることをことごとく忠実に守りなさい。","tok":[["だ"],["から"],["、"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["それる"],["こと"],["なく"],["、"],["モーセ"],["の"],["教え","おしえ"],["の"],["書","しょ"],["に"],["書かれて","かかれて"],["いる"],["こと"],["を"],["ことごとく"],["忠実","ちゅうじつ"],["に"],["守り","まもり"],["なさい"],["。"]]},{"verse":7,"text":"あなたたちのうちに今なお残っているこれらの国民と交わり、その神々の名を唱えたり、誓ったりしてはならない。それらにひれ伏し拝んではならない。","tok":[["あなた"],["たち"],["の"],["うち"],["に"],["今","いま"],["なお"],["残って","のこって"],["いる"],["これ"],["ら"],["の"],["国民","こくみん"],["と"],["交わり","まじわり"],["、"],["その"],["神々","かみがみ"],["の"],["名","な"],["を"],["唱え","となえ"],["たり"],["、"],["誓っ","ちかっ"],["たり"],["して"],["は"],["ならない"],["。"],["それ"],["ら"],["に"],["ひれ"],["伏し拝んで","ふしおがんで"],["は"],["ならない"],["。"]]},{"verse":8,"text":"今日までしてきたように、ただあなたたちの神、主を固く信頼せよ。","tok":[["今日","きょう"],["まで"],["して"],["きた"],["よう"],["に"],["、"],["ただ"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["固く","かたく"],["信頼","しんらい"],["せよ"],["。"]]},{"verse":9,"text":"主が強大な国々をあなたたちのために追い払ってくださったから、あなたたちの行く手に立ちはだかる者は、今日まで一人もなかった。","tok":[["主","ぬし"],["が"],["強大","きょうだい"],["な"],["国々","くにぐに"],["を"],["あなた"],["たち"],["の"],["ため"],["に"],["追い払って","おいはらって"],["くださった"],["から"],["、"],["あなた"],["たち"],["の"],["行く手","ゆくて"],["に"],["立ちはだかる","たちはだかる"],["者","もの"],["は"],["、"],["今日","きょう"],["まで"],["一人","ひとり"],["も"],["なかった"],["。"]]},{"verse":10,"text":"あなたたちは一人で千人を追い払える。あなたたちの神、主が約束されたとおり御自らあなたたちのために戦ってくださるからである。","tok":[["あなた"],["たち"],["は"],["一人","ひとり"],["で"],["千人","せんにん"],["を"],["追い払える","おいはらえる"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["約束","やくそく"],["された"],["とおり"],["御自ら","おみずから"],["あなた"],["たち"],["の"],["ため"],["に"],["戦って","たたかって"],["くださる"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"だから、あなたたちも心を込めて、あなたたちの神、主を愛しなさい。","tok":[["だ"],["から"],["、"],["あなた"],["たち"],["も"],["心","こころ"],["を"],["込めて","こめて"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["愛し","あいし"],["なさい"],["。"]]},{"verse":12,"text":"しかし、もしあなたたちが背いて離れ去り、あなたたちのうちに残っているこれらの国民となれ親しんで、婚姻関係を結び、向こうに行ったり、こちらに迎えたりするなら、","tok":[["しかし"],["、"],["もし"],["あなた"],["たち"],["が"],["背いて","そむいて"],["離れ去り","はなれさり"],["、"],["あなた"],["たち"],["の"],["うち"],["に"],["残って","のこって"],["いる"],["これ"],["ら"],["の"],["国民","こくみん"],["と"],["なれ親しんで","なれしたしんで"],["、"],["婚姻","こんいん"],["関係","かんけい"],["を"],["結び","むすび"],["、"],["向こう","むこう"],["に"],["行っ","いっ"],["たり"],["、"],["こちら"],["に"],["迎え","むかえ"],["たり"],["するなら"],["、"]]},{"verse":13,"text":"あなたたちの神、主がもはや、これらの国民を追い払われないことを覚悟しなさい。彼らはあなたたちの罠となり、落とし穴となり、脇腹を打つ鞭、目に突き刺さるとげとなり、あなたたちは、あなたたちの神、主が与えられたこの良い土地から滅びうせる。","tok":[["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["もはや"],["、"],["これ"],["ら"],["の"],["国民","こくみん"],["を"],["追い払われない","おいはらわれない"],["こと"],["を"],["覚悟","かくご"],["し"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["たち"],["の"],["罠","わな"],["と"],["なり"],["、"],["落とし穴","おとしあな"],["と"],["なり"],["、"],["脇腹","わきばら"],["を"],["打つ","うつ"],["鞭","むち"],["、"],["目","め"],["に"],["突き刺さる","つきささる"],["とげ"],["と"],["なり"],["、"],["あなた"],["たち"],["は"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["与えられた","あたえられた"],["この"],["良い","よい"],["土地","とち"],["から"],["滅び","ほろび"],["うせる"],["。"]]},{"verse":14,"text":"わたしは今、この世のすべての者がたどるべき道を行こうとしている。あなたたちは心を尽くし、魂を尽くしてわきまえ知らねばならない。あなたたちの神、主があなたたちに約束されたすべての良いことは、何一つたがうことはなかった。何一つたがうことなく、すべてあなたたちに実現した。","tok":[["わたし"],["は"],["今","いま"],["、"],["この世","このよ"],["の"],["すべて"],["の"],["者","もの"],["が"],["たどるべき"],["道","みち"],["を"],["行こう","いこう"],["として"],["いる"],["。"],["あなた"],["たち"],["は"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["魂","たましい"],["を"],["尽くして","つくして"],["わきまえ知らねば","わきまえしらねば"],["ならない"],["。"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["に"],["約束","やくそく"],["された"],["すべて"],["の"],["良い","よい"],["こと"],["は"],["、"],["何","なん"],["一","ひと"],["つ"],["たがう"],["こと"],["は"],["なかった"],["。"],["何","なん"],["一","ひと"],["つ"],["たがう"],["こと"],["なく"],["、"],["すべて"],["あなた"],["たち"],["に"],["実現","じつげん"],["した"],["。"]]},{"verse":15,"text":"あなたたちの神、主が約束された良いことがすべて、あなたたちに実現したように、主はまた、あらゆる災いをあなたたちにくだして、主があなたたちに与えられたこの良い土地からあなたたちを滅ぼされる。","tok":[["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["約束","やくそく"],["された"],["良い","よい"],["こと"],["が"],["すべて"],["、"],["あなた"],["たち"],["に"],["実現","じつげん"],["した"],["よう"],["に"],["、"],["主","ぬし"],["は"],["また"],["、"],["あらゆる"],["災い","わざわい"],["を"],["あなた"],["たち"],["に"],["くだして"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["に"],["与えられた","あたえられた"],["この"],["良い","よい"],["土地","とち"],["から"],["あなた"],["たち"],["を"],["滅ぼされる","ほろぼされる"],["。"]]},{"verse":16,"text":"もし、あなたたちの神、主が命じられた契約を破り、他の神々に従い、仕え、これにひれ伏すなら、主の怒りが燃え上がり、あなたたちは与えられた良い土地から、速やかに滅び去る。」","tok":[["もし"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["命じられた","めいじられた"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["他","た"],["の"],["神々","かみがみ"],["に"],["従い","したがい"],["、"],["仕え","つかえ"],["、"],["これ"],["に"],["ひれ伏すなら","ひれふすなら"],["、"],["主","ぬし"],["の"],["怒り","いかり"],["が"],["燃え上がり","もえあがり"],["、"],["あなた"],["たち"],["は"],["与えられた","あたえられた"],["良い","よい"],["土地","とち"],["から"],["、"],["速やか","すみやか"],["に"],["滅び去る","ほろびさる"],["。"],["」"]]}]
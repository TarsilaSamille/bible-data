[{"verse":1,"text":"ヨセフの子孫がくじで割り当てられた領土は、エリコに近いヨルダン川、エリコの水の東から荒れ野を経て、山地を越えてベテルに至る。","tok":[["ヨセフ"],["の"],["子孫","しそん"],["が"],["くじ"],["で"],["割り当てられた","わりあてられた"],["領土","りょうど"],["は"],["、"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["川","かわ"],["、"],["エリコ"],["の"],["水","みず"],["の"],["東","ひがし"],["から"],["荒れ野","あれの"],["を"],["経て","へて"],["、"],["山地","さんち"],["を"],["越えて","こえて"],["ベテル"],["に"],["至る","いたる"],["。"]]},{"verse":2,"text":"そこからルズ、アルキ人の領地アタロトを経て、","tok":[["そこ"],["から"],["ルズ"],["、"],["アルキ人","あるきにん"],["の"],["領地","りょうち"],["アタロト"],["を"],["経て","へて"],["、"]]},{"verse":3,"text":"西に下り、ヤフレト人の領地から下ベト‧ホロンの地境、更にゲゼルを過ぎ、海に達する。","tok":[["西","にし"],["に"],["下り","くだり"],["、"],["ヤフレト"],["人","にん"],["の"],["領地","りょうち"],["から"],["下","した"],["ベト"],["‧"],["ホロン"],["の"],["地境","じざかい"],["、"],["更に","さらに"],["ゲゼル"],["を"],["過ぎ","すぎ"],["、"],["海","うみ"],["に"],["達する","たっする"],["。"]]},{"verse":4,"text":"ヨセフの子ら、マナセとエフライムは嗣業の土地を受け継いだ。","tok":[["ヨセフ"],["の"],["子","こ"],["ら"],["、"],["マナセ"],["と"],["エフライム"],["は"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["受け継いだ","うけついだ"],["。"]]},{"verse":5,"text":"エフライムの子孫が氏族ごとに得た領域は次のとおりである。その嗣業の土地の境は、東のアトロト‧アダルから上ベト‧ホロンを経て、","tok":[["エフライム"],["の"],["子孫","しそん"],["が"],["氏族","しぞく"],["ごと"],["に"],["得た","えた"],["領域","りょういき"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["その"],["嗣業","しぎょう"],["の"],["土地","とち"],["の"],["境","さかい"],["は"],["、"],["東","ひがし"],["の"],["アトロト"],["‧"],["アダル"],["から"],["上","うえ"],["ベト"],["‧"],["ホロン"],["を"],["経て","へて"],["、"]]},{"verse":6,"text":"西へ向かう。北境は、ミクメタトから東へ曲がり、タアナト‧シロを経てヤノハの東に出、","tok":[["西","にし"],["へ"],["向かう","むかう"],["。"],["北境","ほっきょう"],["は"],["、"],["ミクメタト"],["から"],["東","ひがし"],["へ"],["曲がり","まがり"],["、"],["タアナト"],["‧"],["シロ"],["を"],["経て","へて"],["ヤノハ"],["の"],["東","ひがし"],["に"],["出","で"],["、"]]},{"verse":7,"text":"そこからアタロト、ナアラ、エリコを経てヨルダン川に達する。","tok":[["そこ"],["から"],["アタロト"],["、"],["ナアラ"],["、"],["エリコ"],["を"],["経て","へて"],["ヨルダン"],["川","かわ"],["に"],["達する","たっする"],["。"]]},{"verse":8,"text":"西境はタプアからカナ川に沿い、海に達する。以上がエフライムの人々の部族が氏族ごとに受け継いだ嗣業の土地である。","tok":[["西境","にしざかい"],["は"],["タプア"],["から"],["カナ"],["川","かわ"],["に"],["沿い","そい"],["、"],["海","うみ"],["に"],["達する","たっする"],["。"],["以上","いじょう"],["が"],["エフライム"],["の"],["人々","ひとびと"],["の"],["部族","ぶぞく"],["が"],["氏族","しぞく"],["ごと"],["に"],["受け継いだ","うけついだ"],["嗣業","しぎょう"],["の"],["土地","とち"],["で"],["ある"],["。"]]},{"verse":9,"text":"このほか、マナセの人々の嗣業の土地の中にもエフライムの人々に配分された町々とそれに属する村があった。","tok":[["この"],["ほか"],["、"],["マナセ"],["の"],["人々","ひとびと"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["の"],["中","なか"],["に"],["も"],["エフライム"],["の"],["人々","ひとびと"],["に"],["配分","はいぶん"],["された"],["町々","まちまち"],["と"],["それ"],["に"],["属する","ぞくする"],["村","むら"],["が"],["あった"],["。"]]},{"verse":10,"text":"彼らがゲゼルに住むカナン人を追い出さなかったので、カナン人はエフライムと共にそこに住んで今日に至っている。ただし、彼らは強制労働に服している。","tok":[["彼","かれ"],["ら"],["が"],["ゲゼル"],["に"],["住む","すむ"],["カナン人","かなんにん"],["を"],["追い出さなかった","おいださなかった"],["ので"],["、"],["カナン人","かなんにん"],["は"],["エフライム"],["と"],["共","とも"],["に"],["そこ"],["に"],["住んで","すんで"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"],["ただし"],["、"],["彼","かれ"],["ら"],["は"],["強制","きょうせい"],["労働","ろうどう"],["に"],["服して","ふくして"],["いる"],["。"]]}]
[{"verse":1,"text":"エルサレムの王アドニ‧ツェデクは、ヨシュアがアイを占領し、滅ぼし尽くし、アイの町とその王をも、先のエリコとその王と同じように取り扱ったことを聞き、またギブオンの住民がイスラエルと和を結び、彼らのうちに住むことを許されたと聞くと、","tok":[["エルサレム"],["の"],["王","おう"],["アドニ"],["‧"],["ツェデク"],["は"],["、"],["ヨシュア"],["が"],["アイ"],["を"],["占領","せんりょう"],["し"],["、"],["滅ぼし","ほろぼし"],["尽くし","つくし"],["、"],["アイ"],["の"],["町","まち"],["と"],["その"],["王","おう"],["を"],["も"],["、"],["先","さき"],["の"],["エリコ"],["と"],["その"],["王","おう"],["と"],["同じ","おなじ"],["よう"],["に"],["取り扱った","とりあつかった"],["こと"],["を"],["聞き","きき"],["、"],["また"],["ギブオン"],["の"],["住民","じゅうみん"],["が"],["イスラエル"],["と"],["和","わ"],["を"],["結び","むすび"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["住む","すむ"],["こと"],["を"],["許された","ゆるされた"],["と"],["聞く","きく"],["と"],["、"]]},{"verse":2,"text":"非常に恐れた。ギブオンはアイよりも大きく、王をいただく都市ほどの大きな町であり、その上、そこの男たちは皆、勇士だったからである。","tok":[["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"],["ギブオン"],["は"],["アイ"],["より"],["も"],["大きく","おおきく"],["、"],["王","おう"],["を"],["いただく"],["都市","とし"],["ほど"],["の"],["大きな","おおきな"],["町","まち"],["で"],["あり"],["、"],["その"],["上","うえ"],["、"],["そこ"],["の"],["男","おとこ"],["たち"],["は"],["皆","みな"],["、"],["勇士","ゆうし"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":3,"text":"エルサレムの王アドニ‧ツェデクは、ヘブロンの王ホハム、ヤルムトの王ピルアム、ラキシュの王ヤフィア、エグロンの王デビルに人を遣わし、","tok":[["エルサレム"],["の"],["王","おう"],["アドニ"],["‧"],["ツェデク"],["は"],["、"],["ヘブロン"],["の"],["王","おう"],["ホハム"],["、"],["ヤルムト"],["の"],["王","おう"],["ピルアム"],["、"],["ラキシュ"],["の"],["王","おう"],["ヤフィア"],["、"],["エグロン"],["の"],["王","おう"],["デビル"],["に"],["人","ひと"],["を"],["遣わし","つかわし"],["、"]]},{"verse":4,"text":"「わたしのもとに上り、ギブオンを撃つのを助けていただきたい。彼らはヨシュアの率いるイスラエルの人々と和を結んだ」と伝えた。","tok":[["「"],["わたし"],["の"],["もと"],["に"],["上り","のぼり"],["、"],["ギブオン"],["を"],["撃つ","うつ"],["の"],["を"],["助けて","たすけて"],["いただきたい"],["。"],["彼","かれ"],["ら"],["は"],["ヨシュア"],["の"],["率いる","ひきいる"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["和","わ"],["を"],["結んだ","むすんだ"],["」"],["と"],["伝えた","つたえた"],["。"]]},{"verse":5,"text":"アモリ人の五人の王、すなわちエルサレム、ヘブロン、ヤルムト、ラキシュ、エグロンの王たちとその全軍勢は連合して攻め上り、ギブオンに向かって陣を敷き、戦いを仕掛けた。","tok":[["アモリ人","あもりにん"],["の"],["五人","ごにん"],["の"],["王","おう"],["、"],["すなわち"],["エルサレム"],["、"],["ヘブロン"],["、"],["ヤルムト"],["、"],["ラキシュ"],["、"],["エグロン"],["の"],["王","おう"],["たち"],["と"],["その"],["全","ぜん"],["軍勢","ぐんぜい"],["は"],["連合","れんごう"],["して"],["攻め上り","せめのぼり"],["、"],["ギブオン"],["に"],["向かって","むかって"],["陣","じん"],["を"],["敷き","しき"],["、"],["戦い","たたかい"],["を"],["仕掛けた","しかけた"],["。"]]},{"verse":6,"text":"ギブオンの人々はギルガルの陣営にいるヨシュアに人を遣わして、こう告げた。「あなたの僕から手を引かず、早く上って来て、わたしたちを救い、助けてください。山地に住むアモリ人のすべての王たちがわたしたちに向かって集結しています。」","tok":[["ギブオン"],["の"],["人々","ひとびと"],["は"],["ギルガル"],["の"],["陣営","じんえい"],["に"],["いる"],["ヨシュア"],["に"],["人","ひと"],["を"],["遣わして","つかわして"],["、"],["こう"],["告げた","つげた"],["。"],["「"],["あなた"],["の"],["僕","ぼく"],["から"],["手","て"],["を"],["引かず","ひかず"],["、"],["早く","はやく"],["上って","のぼって"],["来て","きて"],["、"],["わたしたち"],["を"],["救い","すくい"],["、"],["助けて","たすけて"],["ください"],["。"],["山地","さんち"],["に"],["住む","すむ"],["アモリ人","あもりにん"],["の"],["すべて"],["の"],["王","おう"],["たち"],["が"],["わたしたち"],["に"],["向かって","むかって"],["集結","しゅうけつ"],["して"],["います"],["。"],["」"]]},{"verse":7,"text":"ヨシュアは兵士全員、すべての勇士を率いてギルガルから出陣した。","tok":[["ヨシュア"],["は"],["兵士","へいし"],["全員","ぜんいん"],["、"],["すべて"],["の"],["勇士","ゆうし"],["を"],["率いて","ひきいて"],["ギルガル"],["から"],["出陣","しゅつじん"],["した"],["。"]]},{"verse":8,"text":"主はヨシュアに言われた。「彼らを恐れてはならない。わたしは既に彼らをあなたの手に渡した。あなたの行く手に立ちはだかる者は一人もいない。」","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["言われた","いわれた"],["。"],["「"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["既に","すでに"],["彼","かれ"],["ら"],["を"],["あなた"],["の"],["手","て"],["に"],["渡した","わたした"],["。"],["あなた"],["の"],["行く手","ゆくて"],["に"],["立ちはだかる","たちはだかる"],["者","もの"],["は"],["一人","ひとり"],["も"],["いない"],["。"],["」"]]},{"verse":9,"text":"ヨシュアはギルガルから夜通し軍を進め、彼らを急襲した。","tok":[["ヨシュア"],["は"],["ギルガル"],["から"],["夜通し","よどおし"],["軍","ぐん"],["を"],["進め","すすめ"],["、"],["彼","かれ"],["ら"],["を"],["急襲","きゅうしゅう"],["した"],["。"]]},{"verse":10,"text":"主はイスラエルの前で彼らを混乱に陥れられたので、ヨシュアはギブオンで敵に大打撃を与え、更に彼らを追ってベト‧ホロンの坂道を登り、アゼカ、マケダまで彼らを追撃した。","tok":[["主","ぬし"],["は"],["イスラエル"],["の"],["前","まえ"],["で"],["彼","かれ"],["ら"],["を"],["混乱","こんらん"],["に"],["陥れられた","おとしいれられた"],["ので"],["、"],["ヨシュア"],["は"],["ギブオン"],["で"],["敵","てき"],["に"],["大","だい"],["打撃","だげき"],["を"],["与え","あたえ"],["、"],["更に","さらに"],["彼","かれ"],["ら"],["を"],["追って","おって"],["ベト"],["‧"],["ホロン"],["の"],["坂道","さかみち"],["を"],["登り","のぼり"],["、"],["アゼカ"],["、"],["マケダ"],["まで"],["彼","かれ"],["ら"],["を"],["追撃","ついげき"],["した"],["。"]]},{"verse":11,"text":"彼らがイスラエルの前から敗走し、ベト‧ホロンの下り坂にさしかかったとき、主は天から大石を降らせた。それはアゼカまで続いたので、雹に打たれて死んだ者はイスラエルの人々が剣で殺した者よりも多かった。","tok":[["彼","かれ"],["ら"],["が"],["イスラエル"],["の"],["前","まえ"],["から"],["敗走","はいそう"],["し"],["、"],["ベト"],["‧"],["ホロン"],["の"],["下り坂","くだりざか"],["に"],["さしかかった"],["とき"],["、"],["主","ぬし"],["は"],["天","てん"],["から"],["大石","おおいし"],["を"],["降らせた","ふらせた"],["。"],["それ"],["は"],["アゼカ"],["まで"],["続いた","つづいた"],["ので"],["、"],["雹","ひょう"],["に"],["打たれて","うたれて"],["死んだ","しんだ"],["者","もの"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["剣","けん"],["で"],["殺した","ころした"],["者","もの"],["より"],["も"],["多かった","おおかった"],["。"]]},{"verse":12,"text":"主がアモリ人をイスラエルの人々に渡された日、ヨシュアはイスラエルの人々の見ている前で主をたたえて言った。「日よとどまれギブオンの上に月よとどまれアヤロンの谷に。」","tok":[["主","ぬし"],["が"],["アモリ人","あもりにん"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["渡された","わたされた"],["日","ひ"],["、"],["ヨシュア"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["主","ぬし"],["を"],["たたえて"],["言った","いった"],["。"],["「"],["日","ひ"],["よ"],["とどまれ"],["ギブオン"],["の"],["上","うえ"],["に"],["月","つき"],["よ"],["とどまれ"],["アヤロン"],["の"],["谷","たに"],["に"],["。"],["」"]]},{"verse":13,"text":"日はとどまり月は動きをやめた民が敵を打ち破るまで。『ヤシャルの書』にこう記されているように、日はまる一日、中天にとどまり、急いで傾こうとしなかった。","tok":[["日","ひ"],["は"],["とどまり"],["月","つき"],["は"],["動き","うごき"],["を"],["やめた"],["民","たみ"],["が"],["敵","てき"],["を"],["打ち破る","うちやぶる"],["まで"],["。"],["『"],["ヤシャル"],["の"],["書","しょ"],["』"],["に"],["こう"],["記されて","しるされて"],["いる"],["よう"],["に"],["、"],["日","ひ"],["は"],["まる"],["一","いち"],["日","にち"],["、"],["中天","ちゅうてん"],["に"],["とどまり"],["、"],["急いで","いそいで"],["傾こう","かたむこう"],["と"],["しなかった"],["。"]]},{"verse":14,"text":"主がこの日のように人の訴えを聞き届けられたことは、後にも先にもなかった。主はイスラエルのために戦われたのである。","tok":[["主","ぬし"],["が"],["この"],["日","ひ"],["の"],["よう"],["に"],[
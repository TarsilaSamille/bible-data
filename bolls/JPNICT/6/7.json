[{"verse":1,"text":"イスラエルの人々は、滅ぼし尽くしてささげるべきことに対して不誠実であった。ユダ族に属し、彼の父はカルミ、祖父はザブディ、更にゼラへとさかのぼるアカンは、滅ぼし尽くしてささげるべきものの一部を盗み取った。主はそこで、イスラエルの人々に対して激しく憤られた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["滅ぼし","ほろぼし"],["尽くして","つくして"],["ささげるべき"],["こと"],["に対して","にたいして"],["不誠実","ふせいじつ"],["で"],["あった"],["。"],["ユダ族","ゆだぞく"],["に"],["属し","ぞくし"],["、"],["彼","かれ"],["の"],["父","ちち"],["は"],["カルミ"],["、"],["祖父","そふ"],["は"],["ザブディ"],["、"],["更に","さらに"],["ゼラ"],["へ"],["と"],["さかのぼる"],["アカン"],["は"],["、"],["滅ぼし","ほろぼし"],["尽くして","つくして"],["ささげるべき"],["もの"],["の"],["一部","いちぶ"],["を"],["盗み取った","ぬすみとった"],["。"],["主","ぬし"],["は"],["そこ"],["で"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に対して","にたいして"],["激しく","はげしく"],["憤られた","いきどおられた"],["。"]]},{"verse":2,"text":"ヨシュアはエリコからアイへ数人の人を遣わし、「上って行って、あの土地を探れ」と命じた。アイはベテルの東、ベト‧アベンの近くにあった。彼らは上って行ってアイを探り、","tok":[["ヨシュア"],["は"],["エリコ"],["から"],["アイ"],["へ"],["数人","すうにん"],["の"],["人","ひと"],["を"],["遣わし","つかわし"],["、"],["「"],["上って","のぼって"],["行って","いって"],["、"],["あの"],["土地","とち"],["を"],["探れ","さぐれ"],["」"],["と"],["命じた","めいじた"],["。"],["アイ"],["は"],["ベテル"],["の"],["東","ひがし"],["、"],["ベト"],["‧"],["アベン"],["の"],["近く","ちかく"],["に"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["上って","のぼって"],["行って","いって"],["アイ"],["を"],["探り","さぐり"],["、"]]},{"verse":3,"text":"ヨシュアのもとに帰って来て言った。「アイを撃つのに全軍が出撃するには及びません。二、三千人が行けばいいでしょう。取るに足りぬ相手ですから、全軍をつぎ込むことはありません。」","tok":[["ヨシュア"],["の"],["もと"],["に"],["帰って","かえって"],["来て","きて"],["言った","いった"],["。"],["「"],["アイ"],["を"],["撃つ","うつ"],["のに"],["全軍","ぜんぐん"],["が"],["出撃","しゅつげき"],["する"],["に"],["は"],["及びません","およびません"],["。"],["二","に"],["、"],["三千人","さんせんにん"],["が"],["行けば","いけば"],["いいでしょう"],["。"],["取る","とる"],["に"],["足りぬ","たりぬ"],["相手","あいて"],["です"],["から"],["、"],["全軍","ぜんぐん"],["を"],["つぎ込む","つぎこむ"],["こと"],["は"],["ありません"],["。"],["」"]]},{"verse":4,"text":"そこで、民のうちから約三千の兵がアイに攻め上ったが、彼らはアイの兵士の前に敗退した。","tok":[["そこ"],["で"],["、"],["民","みん"],["の"],["うち"],["から"],["約","やく"],["三千","さんせん"],["の"],["兵","へい"],["が"],["アイ"],["に"],["攻め上った","せめのぼった"],["が"],["、"],["彼","かれ"],["ら"],["は"],["アイ"],["の"],["兵士","へいし"],["の"],["前","まえ"],["に"],["敗退","はいたい"],["した"],["。"]]},{"verse":5,"text":"アイの兵士は、城門を出て石切り場まで追跡し、下り坂のところで彼らを撃ち、おおよそ三十六人を殺した。民の心は挫け、水のようになった。","tok":[["アイ"],["の"],["兵士","へいし"],["は"],["、"],["城門","じょうもん"],["を"],["出て","でて"],["石切り","いしきり"],["場","ば"],["まで"],["追跡","ついせき"],["し"],["、"],["下り坂","くだりざか"],["の"],["ところ"],["で"],["彼","かれ"],["ら"],["を"],["撃ち","うち"],["、"],["おおよそ"],["三十六人","さんじゅうろくにん"],["を"],["殺した","ころした"],["。"],["民","たみ"],["の"],["心","こころ"],["は"],["挫け","くじけ"],["、"],["水","みず"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":6,"text":"ヨシュアは衣服を引き裂き、イスラエルの長老たちと共に、主の箱の前で夕方まで地にひれ伏し、頭に塵をかぶった。","tok":[["ヨシュア"],["は"],["衣服","いふく"],["を"],["引き裂き","ひきさき"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["と"],["共","とも"],["に"],["、"],["主","ぬし"],["の"],["箱","ばこ"],["の"],["前","まえ"],["で"],["夕方","ゆうがた"],["まで"],["地","ち"],["に"],["ひれ伏し","ひれふし"],["、"],["頭","あたま"],["に"],["塵","ごみ"],["を"],["かぶった"],["。"]]},{"verse":7,"text":"ヨシュアは神に言った。「ああ、わが神、主よ。なぜ、あなたはこの民にヨルダン川を渡らせたのですか。わたしたちをアモリ人の手に渡して滅ぼすおつもりだったのですか。わたしたちはヨルダン川の向こうにとどまることで満足していたのです。","tok":[["ヨシュア"],["は"],["神","かみ"],["に"],["言った","いった"],["。"],["「"],["ああ"],["、"],["わが"],["神","かみ"],["、"],["主","ぬし"],["よ"],["。"],["なぜ"],["、"],["あなた"],["は"],["この"],["民","たみ"],["に"],["ヨルダン"],["川","かわ"],["を"],["渡らせた","わたらせた"],["の"],["です"],["か"],["。"],["わたしたち"],["を"],["アモリ人","あもりにん"],["の"],["手","て"],["に"],["渡して","わたして"],["滅ぼす","ほろぼす"],["おつもり"],["だった"],["の"],["です"],["か"],["。"],["わたしたち"],["は"],["ヨルダン"],["川","かわ"],["の"],["向こう","むこう"],["に"],["とどまる"],["こと"],["で"],["満足","まんぞく"],["して"],["いた"],["の"],["です"],["。"]]},{"verse":8,"text":"主よ、イスラエルが敵に背を向けて逃げ帰った今となって、わたしは何と言えばいいのでしょう。","tok":[["主","ぬし"],["よ"],["、"],["イスラエル"],["が"],["敵","てき"],["に"],["背","せ"],["を"],["向けて","むけて"],["逃げ帰った","にげかえった"],["今","いま"],["と"],["なって"],["、"],["わたし"],["は"],["何","なん"],["と"],["言えば","いえば"],["いい"],["の"],["でしょう"],["。"]]},{"verse":9,"text":"カナン人やこの土地の住民は、このことを聞いたなら、わたしたちを攻め囲んで皆殺しにし、わたしたちの名を地から断ってしまうでしょう。あなたは、御自分の偉大な御名のゆえに、何をしてくださるのですか。」","tok":[["カナン人","かなんにん"],["や"],["この"],["土地","とち"],["の"],["住民","じゅうみん"],["は"],["、"],["この"],["こと"],["を"],["聞いたなら","きいたなら"],["、"],["わたしたち"],["を"],["攻め囲んで","せめかこんで"],["皆殺し","みなごろし"],["に"],["し"],["、"],["わたしたち"],["の"],["名","な"],["を"],["地","ち"],["から"],["断って","ことわって"],["しまうでしょう"],["。"],["あなた"],["は"],["、"],["御自分","ごじぶん"],["の"],["偉大","いだい"],["な"],["御名","ぎょめい"],["の"],["ゆえ"],["に"],["、"],["何","なん"],["を"],["して"],["くださる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":10,"text":"主はヨシュアに言われた。「立ちなさい。なぜ、そのようにひれ伏しているのか。","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["言われた","いわれた"],["。"],["「"],["立ち","たち"],["なさい"],["。"],["なぜ"],["、"],["その"],["よう"],["に"],["ひれ伏して","ひれふして"],["いる"],["の"],["か"],["。"]]},{"verse":11,"text":"イスラエルは罪を犯し、わたしが命じた契約を破り、滅ぼし尽くしてささげるべきものの一部を盗み取り、ごまかして自分のものにした。","tok":[["イスラエル"],["は"],["罪","つみ"],["を"],["犯し","おかし"],["、"],["わたし"],["が"],["命じた","めいじた"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["滅ぼし","ほろぼし"],["尽くして","つくして"],["ささげるべき"],["もの"],["の"],["一部","いちぶ"],["を"],["盗み取り","ぬすみとり"],["、"],["ごまかして"],["自分","じぶん"],["の"],["もの"],["に"],["した"],["。"]]},{"verse":12,"text":"だから、イスラエルの人々は、敵に立ち向かうことができず、敵に背を向けて逃げ、滅ぼし尽くされるべきものとなってしまった。もし、あなたたちの間から滅ぼし尽くすべきものを一掃しないなら、わたしは、もはやあなたたちと共にいない。","tok":[["だ"],["から"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["敵","てき"],["に"],["立ち向かう","たちむかう"],["こと"],["が"],["できず"],["、"],["敵","てき"],["に"],["背","せ"],["を"],["向けて","むけて"],["逃げ","にげ"],["、"],["滅ぼし","ほろぼし"],["尽くされるべき","つくされるべき"],["もの"],["と"],["なって"],["しまった"],["。"],["もし"],["、"],["あなた"],["たち"],["の"],["間","あいだ"],["から"],["滅ぼし","ほろぼし"],["尽くすべき","つくすべき"],["もの"],["を"],["一掃","いっそう"],["しないなら"],["、"],["わたし"],["は"],["、"],["もはや"],["あなた"],["たち"],["と"],["共","とも"],["に"],["いない"],["。"]]},{"verse":13,"text":"立って民を清め、『明日に備えて自分を聖別せよ』と命じなさい。イスラエルの神、主が、『イスラエルよ、あなたたちの中に滅ぼし尽くすべきものが残っている。それを除き去るまでは敵に立ち向かうことはできない』と言われるからである。","tok":[["立って","たって"],["民","みん"],["を"],["清め","きよめ"],["、"],["『"],["明日","あす"],["に"],["備えて","そなえて"],["自分","じぶん"],["を"],["聖別","せいべつ"],["せよ"],["』"],["と"],["命じ","めいじ"],["なさい"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["、"],["『"],["イスラエル"],["よ"],["、"],["あなた"],["たち"],["の"],["中","なか"],["に"],["滅ぼし","ほろぼし"],["尽くすべき","つくすべき"],["もの"],["が"],["残って","のこって"],["いる"],["。"],["それ"],["を"],["除き去る","のぞきさる"],["まで"],["は"],["敵","てき"],["に"],["立ち向かう","たちむかう"],["こと"],["は"],["できない"],["』"],["と"],["言われる","いわれる"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"明日の朝、あなたたちは部族ごとに進み出なさい。主の指摘を受けた部族は、氏族ごとに進み出なさい。主の指摘を受けた氏族は、家族ごとに進み出なさい。主の指摘を受けた家族の男子は、一人ずつ進み出なさい。","tok":[["明日","あす"],["の"],["朝","あさ"],["、"],["あなた"],["たち"],["は"],["部族","ぶぞく"],["ごと"],["に"],["進み出","すすみで"],["なさい"],["。"],["主","ぬし"],["の"],["指摘","してき"],["を"],["受けた","うけた"],["部族","ぶぞく"],["は"],["、"],["氏族","しぞく"],["ごと"],["に"],["進み出","すすみで"],["なさい"],["。"],["主","ぬし"],["の"],["指摘","してき"],["を"],["受けた","うけた"],["氏族","しぞく"],["は"],["、"],["家族","かぞく"],["ごと"],["に"],["進み出","すすみで"],["なさい"],["。"],["主","ぬし"],["の"],["指摘","してき"],["を"],["受けた","うけた"],["家族","かぞく"],["の"],["男子","だんし"],["は"],["、"],["一人","ひとり"],["ずつ"],["進み出","すすみで"],["なさい"],["。"]]},{"verse":15,"text":"滅ぼし尽くすべきものを持つ者がこうして、指摘されたなら、その人は財産もろとも火で焼き尽くされねばならない。彼は主の契約を破り、イスラエルにおいては愚かなことをしたからである。」","tok":[["滅ぼし","ほろぼし"],["尽くすべき","つくすべき"],["もの"],["を"],["持つ","もつ"],["者","もの"],["が"],["こう"],["して"],["、"],["指摘","してき"],["されたなら"],["、"],["その"],["人","ひと"],["は"],["財産","ざいさん"],["もろとも"],["火","ひ"],["で"],["焼き","やき"],["尽くされねば","つくされねば"],["ならない"],["。"],["彼","かれ"],["は"],["主","ぬし"],["の"],["契約","けいやく"],["を"],["破り","やぶり"],["、"],["イスラエル"],["に"],["おいて"],["は"],["愚か","おろか"],["な"],["こと"],["を"],["した"],["から"],["で"],["ある"],["。"],["」"]]},{"verse":16,"text":"翌朝、ヨシュアは早く起き、イスラエルを部族ごとに進み出させると、ユダ族が指摘を受けた。","tok":[["翌朝","よくあさ"],["、"],["ヨシュア"],["は"],["早く","はやく"],["起き","おき"],["、"],["イスラエル"],["を"],["部族","ぶぞく"],["ごと"],["に"],["進み","すすみ"],["出させる","ださせる"],["と"],["、"],["ユダ族","ゆだぞく"],["が"],["指摘","してき"],["を"],["受けた","うけた"],["。"]]},{"verse":17,"text":"ユダの諸氏族を進み出させると、ゼラの氏族が指摘を受けた。ゼラの氏族の男子を一人ずつ進み出させると、ザブディ家が指摘を受けた。","tok":[["ユダ"],["の"],["諸","しょ"],["氏族","しぞく"],["を"],["進み","すすみ"],["出させる","ださせる"],["と"],["、"],["ゼラ"],["の"],["氏族","しぞく"],["が"],["指摘","してき"],["を"],["受けた","うけた"],["。"],["ゼラ"],["の"],["氏族","しぞく"],["の"],["男子","だんし"],["を"],["一人","ひとり"],["ずつ"],["進み","すすみ"],["出させる","ださせる"],["と"],["、"],["ザブディ"],["家","か"],["が"],["指摘","してき"],["を"],["受けた","うけた"],["。"]]},{"verse":18,"text":"ザブディ家の男子を一人ずつ進み出させると、ユダ族のゼラ氏族に属するザブディ家のカルミの子アカンが指摘を受けた。","tok":[["ザブディ"],["家","か"],["の"],["男子","だんし"],["を"],["一人","ひとり"],["ずつ"],["進み","すすみ"],["出させる","ださせる"],["と"],["、"],["ユダ族","ゆだぞく"],["の"],["ゼラ"],["氏族","しぞく"],["に"],["属する","ぞくする"],["ザブディ"],["家","か"],["の"],["カルミ"],["の"],["子","こ"],["アカン"],["が"],["指摘","してき"],["を"],["受けた","うけた"],["。"]]},{"verse":19,"text":"ヨシュアがアカンに、「わたしの子よ。イスラエルの神、主に栄光を帰し、主をほめたたえ、あなたが何をしたのか包み隠さずわたしに告げなさい」と言うと、","tok":[["ヨシュア"],["が"],["アカン"],["に"],["、"],["「"],["わたし"],["の"],["子","こ"],["よ"],["。"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["栄光","えいこう"],["を"],["帰し","かえし"],["、"],["主","ぬし"],["を"],["ほめたたえ"],["、"],["あなた"],["が"],["何","なん"],["を"],["した"],["の"],["か"],["包み隠さず","つつみかくさず"],["わたし"],["に"],["告げ","つげ"],["なさい"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":20,"text":"アカンはヨシュアに答えた。「わたしは、確かにイスラエルの神、主に罪を犯しました。わたしがしたことはこうです。","tok":[["アカン"],["は"],["ヨシュア"],["に"],["答えた","こたえた"],["。"],["「"],["わたし"],["は"],["、"],["確か","たしか"],["に"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["わたし"],["が"],["した"],["こと"],["は"],["こう"],["です"],["。"]]},{"verse":21,"text":"分捕り物の中に一枚の美しいシンアルの上着、銀二百シェケル、重さ五十シェケルの金の延べ板があるのを見て、欲しくなって取りました。今それらは、わたしの天幕の地下に銀を下に敷いて埋めてあります。」","tok":[["分捕り物","ぶんどりぶつ"],["の"],["中","なか"],["に"],["一枚","いちまい"],["の"],["美しい","うつくしい"],["シンアル"],["の"],["上着","うわぎ"],["、"],["銀","ぎん"],["二百","にひゃく"],["シェケル"],["、"],["重さ","おもさ"],["五十","ごじゅう"],["シェケル"],["の"],["金","かね"],["の"],["延べ板","のべいた"],["が"],["ある"],["の"],["を"],["見て","みて"],["、"],["欲しく","ほしく"],["なって"],["取りました","とりました"],["。"],["今","いま"],["それ"],["ら"],["は"],["、"],["わたし"],["の"],["天幕","てんまく"],["の"],["地下","ちか"],["に"],["銀","ぎん"],["を"],["下","した"],["に"],["敷いて","しいて"],["埋めて","うめて"],["あります"],["。"],["」"]]},{"verse":22,"text":"ヨシュアの出した使いたちがアカンの天幕に走って行って見ると、果たして彼の天幕の中に、銀を下に敷いて地下に埋めてあった。","tok":[["ヨシュア"],["の"],["出した","だした"],["使い","つかい"],["たち"],["が"],["アカン"],["の"],["天幕","てんまく"],["に"],["走って","はしって"],["行って","いって"],["見る","みる"],["と"],["、"],["果たして","はたして"],["彼","かれ"],["の"],["天幕","てんまく"],["の"],["中","なか"],["に"],["、"],["銀","ぎん"],["を"],["下","した"],["に"],["敷いて","しいて"],["地下","ちか"],["に"],["埋めて","うめて"],["あった"],["。"]]},{"verse":23,"text":"彼らはそれを天幕から取り出して、ヨシュアとイスラエルのすべての人々のもとに運び、主の前にひろげた。","tok":[["彼","かれ"],["ら"],["は"],["それ"],["を"],["天幕","てんまく"],["から"],["取り出して","とりだして"],["、"],["ヨシュア"],["と"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["の"],["もと"],["に"],["運び","はこび"],["、"],["主","ぬし"],["の"],["前","まえ"],["に"],["ひろげた"],["。"]]},{"verse":24,"text":"ヨシュアはゼラの子アカンはもとより、銀、上着、金の延べ板、更に息子、娘、牛、ろば、羊、天幕、彼の全財産を取り押さえ、全イスラエルを率いてアコルの谷にそれらを運び、","tok":[["ヨシュア"],["は"],["ゼラ"],["の"],["子","こ"],["アカン"],["は"],["もとより"],["、"],["銀","ぎん"],["、"],["上着","うわぎ"],["、"],["金","きん"],["の"],["延べ板","のべいた"],["、"],["更に","さらに"],["息子","むすこ"],["、"],["娘","むすめ"],["、"],["牛","うし"],["、"],["ろば"],["、"],["羊","ひつじ"],["、"],["天幕","てんまく"],["、"],["彼","かれ"],["の"],["全","ぜん"],["財産","ざいさん"],["を"],["取り押さえ","とりおさえ"],["、"],["全","ぜん"],["イスラエル"],["を"],["率いて","ひきいて"],["アコル"],["の"],["谷","たに"],["に"],["それ"],["ら"],["を"],["運び","はこび"],["、"]]},{"verse":25,"text":"こう宣言した。「お前は何という災いを我々にもたらしたことか。今日は、主がお前に災いをもたらされる（アカル）。」全イスラエルはアカンに石を激しく投げつけ、彼のものを火に焼き、家族を石で打ち殺した。","tok":[["こう"],["宣言","せんげん"],["した"],["。"],["「"],["お前","おまえ"],["は"],["何","なん"],["と"],["いう"],["災い","わざわい"],["を"],["我々","われわれ"],["に"],["もたらした"],["こと"],["か"],["。"],["今日","きょう"],["は"],["、"],["主","ぬし"],["が"],["お前","おまえ"],["に"],["災い","わざわい"],["を"],["もたらされる"],["（"],["アカル"],["）"],["。"],["」"],["全","ぜん"],["イスラエル"],["は"],["アカン"],["に"],["石","いし"],["を"],["激しく","はげしく"],["投げつけ","なげつけ"],["、"],["彼","かれ"],["の"],["もの"],["を"],["火","ひ"],["に"],["焼き","やき"],["、"],["家族","かぞく"],["を"],["石","いし"],["で"],["打ち殺した","うちころした"],["。"]]},{"verse":26,"text":"彼らは、アカンの上に大きな石塚を積み上げたが、それは今日まで残っている。主の激しい怒りはこうしてやんだ。このようなわけで、その場所の名はアコルの谷と呼ばれ、今日に至っている。","tok":[["彼","かれ"],["ら"],["は"],["、"],["アカン"],["の"],["上","うえ"],["に"],["大きな","おおきな"],["石塚","いしづか"],["を"],["積み上げた","つみあげた"],["が"],["、"],["それ"],["は"],["今日","きょう"],["まで"],["残って","のこって"],["いる"],
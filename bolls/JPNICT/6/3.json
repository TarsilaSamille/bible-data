[{"verse":1,"text":"ヨシュアは、朝早く起き、イスラエルの人々すべてと共にシティムを出発し、ヨルダン川の岸に着いたが、川を渡る前に、そこで野営した。","tok":[["ヨシュア"],["は"],["、"],["朝","あさ"],["早く","はやく"],["起き","おき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["すべて"],["と"],["共","とも"],["に"],["シティム"],["を"],["出発","しゅっぱつ"],["し"],["、"],["ヨルダン"],["川","かわ"],["の"],["岸","きし"],["に"],["着いた","ついた"],["が"],["、"],["川","かわ"],["を"],["渡る","わたる"],["前","まえ"],["に"],["、"],["そこ"],["で"],["野営","やえい"],["した"],["。"]]},{"verse":2,"text":"三日たってから、民の役人は宿営の中を巡り、","tok":[["三日","みっか"],["たって"],["から"],["、"],["民","みん"],["の"],["役人","やくにん"],["は"],["宿営","しゅくえい"],["の"],["中","なか"],["を"],["巡り","めぐり"],["、"]]},{"verse":3,"text":"民に命じた。「あなたたちは、あなたたちの神、主の契約の箱をレビ人の祭司たちが担ぐのを見たなら、今いる所をたって、その後に続け。","tok":[["民","みん"],["に"],["命じた","めいじた"],["。"],["「"],["あなた"],["たち"],["は"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["レビ人","れびにん"],["の"],["祭司","さいし"],["たち"],["が"],["担ぐ","かつぐ"],["の"],["を"],["見たなら","みたなら"],["、"],["今","いま"],["いる"],["所","ところ"],["を"],["たって"],["、"],["その後","そのあと"],["に"],["続け","つづけ"],["。"]]},{"verse":4,"text":"契約の箱との間には約二千アンマの距離をとり、それ以上近寄ってはならない。そうすれば、これまで一度も通ったことのない道であるが、あなたたちの行くべき道は分かる。」","tok":[["契約","けいやく"],["の"],["箱","ばこ"],["と"],["の"],["間","あいだ"],["に"],["は"],["約","やく"],["二千","にせん"],["アンマ"],["の"],["距離","きょり"],["を"],["とり"],["、"],["それ"],["以上","いじょう"],["近寄って","ちかよって"],["は"],["ならない"],["。"],["そう"],["すれば"],["、"],["これ"],["まで"],["一度","いちど"],["も"],["通った","かよった"],["こと"],["の"],["ない"],["道","みち"],["で"],["ある"],["が"],["、"],["あなた"],["たち"],["の"],["行くべき","いくべき"],["道","みち"],["は"],["分かる","わかる"],["。"],["」"]]},{"verse":5,"text":"ヨシュアは民に言った。「自分自身を聖別せよ。主は明日、あなたたちの中に驚くべきことを行われる。」","tok":[["ヨシュア"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["自分","じぶん"],["自身","じしん"],["を"],["聖別","せいべつ"],["せよ"],["。"],["主","ぬし"],["は"],["明日","あす"],["、"],["あなた"],["たち"],["の"],["中","なか"],["に"],["驚くべき","おどろくべき"],["こと"],["を"],["行われる","おこなわれる"],["。"],["」"]]},{"verse":6,"text":"ヨシュアが祭司たちに、「契約の箱を担ぎ、民の先に立って、川を渡れ」と命じると、彼らは契約の箱を担ぎ、民の先に立って進んだ。","tok":[["ヨシュア"],["が"],["祭司","さいし"],["たち"],["に"],["、"],["「"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担ぎ","かつぎ"],["、"],["民","みん"],["の"],["先","さき"],["に"],["立って","たって"],["、"],["川","かわ"],["を"],["渡れ","わたれ"],["」"],["と"],["命じる","めいじる"],["と"],["、"],["彼","かれ"],["ら"],["は"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担ぎ","かつぎ"],["、"],["民","みん"],["の"],["先","さき"],["に"],["立って","たって"],["進んだ","すすんだ"],["。"]]},{"verse":7,"text":"主はヨシュアに言われた。「今日から、全イスラエルの見ている前であなたを大いなる者にする。そして、わたしがモーセと共にいたように、あなたと共にいることを、すべての者に知らせる。","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["言われた","いわれた"],["。"],["「"],["今日","きょう"],["から"],["、"],["全","ぜん"],["イスラエル"],["の"],["見て","みて"],["いる"],["前","まえ"],["で"],["あなた"],["を"],["大いなる","おおいなる"],["者","もの"],["に"],["する"],["。"],["そして"],["、"],["わたし"],["が"],["モーセ"],["と"],["共","とも"],["に"],["いた"],["よう"],["に"],["、"],["あなた"],["と"],["共","とも"],["に"],["いる"],["こと"],["を"],["、"],["すべて"],["の"],["者","もの"],["に"],["知らせる","しらせる"],["。"]]},{"verse":8,"text":"あなたは、契約の箱を担ぐ祭司たちに、ヨルダン川の水際に着いたら、ヨルダン川の中に立ち止まれと命じなさい。」","tok":[["あなた"],["は"],["、"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担ぐ","かつぐ"],["祭司","さいし"],["たち"],["に"],["、"],["ヨルダン"],["川","かわ"],["の"],["水際","みずぎわ"],["に"],["着いたら","ついたら"],["、"],["ヨルダン"],["川","かわ"],["の"],["中","なか"],["に"],["立ち止まれ","たちどまれ"],["と"],["命じ","めいじ"],["なさい"],["。"],["」"]]},{"verse":9,"text":"ヨシュアはイスラエルの人々に、「ここに来て、あなたたちの神、主の言葉を聞け」と命じ、","tok":[["ヨシュア"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["、"],["「"],["ここ"],["に"],["来て","きて"],["、"],["あなた"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["」"],["と"],["命じ","めいじ"],["、"]]},{"verse":10,"text":"こう言った。「生ける神があなたたちの間におられて、カナン人、ヘト人、ヒビ人、ペリジ人、ギルガシ人、アモリ人、エブス人をあなたたちの前から完全に追い払ってくださることは、次のことで分かる。","tok":[["こう"],["言った","いった"],["。"],["「"],["生ける","いける"],["神","かみ"],["が"],["あなた"],["たち"],["の"],["間","あいだ"],["に"],["おられて"],["、"],["カナン人","かなんにん"],["、"],["ヘト人","へとにん"],["、"],["ヒビ人","ひびにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ギルガシ"],["人","にん"],["、"],["アモリ人","あもりにん"],["、"],["エブス"],["人","ひと"],["を"],["あなた"],["たち"],["の"],["前","まえ"],["から"],["完全","かんぜん"],["に"],["追い払って","おいはらって"],["くださる"],["こと"],["は"],["、"],["次","つぎ"],["の"],["こと"],["で"],["分かる","わかる"],["。"]]},{"verse":11,"text":"見よ、全地の主の契約の箱があなたたちの先に立ってヨルダン川を渡って行く。","tok":[["見よ","みよ"],["、"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["が"],["あなた"],["たち"],["の"],["先","さき"],["に"],["立って","たって"],["ヨルダン"],["川","かわ"],["を"],["渡って","わたって"],["行く","いく"],["。"]]},{"verse":12,"text":"今、イスラエルの各部族から一人ずつ、計十二人を選び出せ。","tok":[["今","いま"],["、"],["イスラエル"],["の"],["各","かく"],["部族","ぶぞく"],["から"],["一人","ひとり"],["ずつ"],["、"],["計","けい"],["十二人","じゅうににん"],["を"],["選び出せ","えらびだせ"],["。"]]},{"verse":13,"text":"全地の主である主の箱を担ぐ祭司たちの足がヨルダン川の水に入ると、川上から流れてくる水がせき止められ、ヨルダン川の水は、壁のように立つであろう。」","tok":[["全地","ぜんち"],["の"],["主","ぬし"],["で"],["ある"],["主","ぬし"],["の"],["箱","ばこ"],["を"],["担ぐ","かつぐ"],["祭司","さいし"],["たち"],["の"],["足","あし"],["が"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["に"],["入る","はいる"],["と"],["、"],["川上","かわかみ"],["から"],["流れて","ながれて"],["くる"],["水","みず"],["が"],["せき止められ","せきとめられ"],["、"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["は"],["、"],["壁","かべ"],["の"],["よう"],["に"],["立つで","たつで"],["あろう"],["。"],["」"]]},{"verse":14,"text":"ヨルダン川を渡るため、民が天幕を後にしたとき、契約の箱を担いだ祭司たちは、民の先頭に立ち、","tok":[["ヨルダン"],["川","かわ"],["を"],["渡る","わたる"],["ため"],["、"],["民","みん"],["が"],["天幕","てんまく"],["を"],["後","あと"],["に"],["した"],["とき"],["、"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担いだ","かついだ"],["祭司","さいし"],["たち"],["は"],["、"],["民","みん"],["の"],["先頭","せんとう"],["に"],["立ち","たち"],["、"]]},{"verse":15,"text":"ヨルダン川に達した。春の刈り入れの時期で、ヨルダン川の水は堤を越えんばかりに満ちていたが、箱を担ぐ祭司たちの足が水際に浸ると、","tok":[["ヨルダン"],["川","かわ"],["に"],["達した","たっした"],["。"],["春","はる"],["の"],["刈り入れ","かりいれ"],["の"],["時期","じき"],["で"],["、"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["は"],["堤","つつみ"],["を"],["越えん","こえん"],["ばかり"],["に"],["満ちて","みちて"],["いた"],["が"],["、"],["箱","ばこ"],["を"],["担ぐ","かつぐ"],["祭司","さいし"],["たち"],["の"],["足","あし"],["が"],["水際","みずぎわ"],["に"],["浸る","ひたる"],["と"],["、"]]},{"verse":16,"text":"川上から流れてくる水は、はるか遠くのツァレタンの隣町アダムで壁のように立った。そのため、アラバの海すなわち塩の海に流れ込む水は全く断たれ、民はエリコに向かって渡ることができた。","tok":[["川上","かわかみ"],["から"],["流れて","ながれて"],["くる"],["水","みず"],["は"],["、"],["はるか"],["遠く","とおく"],["の"],["ツァレタン"],["の"],["隣町","となりまち"],["アダム"],["で"],["壁","かべ"],["の"],["よう"],["に"],["立った","たった"],["。"],["その"],["ため"],["、"],["アラバ"],["の"],["海","うみ"],["すなわち"],["塩","しお"],["の"],["海","うみ"],["に"],["流れ込む","ながれこむ"],["水","みず"],["は"],["全く","まったく"],["断たれ","たたれ"],["、"],["民","みん"],["は"],["エリコ"],["に"],["向かって","むかって"],["渡る","わたる"],["こと"],["が"],["できた"],["。"]]},{"verse":17,"text":"主の契約の箱を担いだ祭司たちがヨルダン川の真ん中の干上がった川床に立ち止まっているうちに、全イスラエルは干上がった川床を渡り、民はすべてヨルダン川を渡り終わった。","tok":[["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担いだ","かついだ"],["祭司","さいし"],["たち"],["が"],["ヨルダン"],["川","かわ"],["の"],["真ん中","まんなか"],["の"],["干上がった","ひあがった"],["川床","かわどこ"],["に"],["立ち止まって","たちどまって"],["いる"],["うち"],["に"],["、"],["全","ぜん"],["イスラエル"],["は"],["干上がった","ひあがった"],["川床","かわどこ"],["を"],["渡り","わたり"],["、"],["民","みん"],["は"],["すべて"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["終わった","おわった"],["。"]]}]
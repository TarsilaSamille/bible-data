],["呼び集められ","よびあつめられ"],["、"],["ヨシュア"],["の"],["後","あと"],["を"],["追い","おい"],["、"],["彼","かれ"],["ら"],["は"],["こう"],["して"],["、"],["町","まち"],["から"],["おびき出された","おびきだされた"],["。"]]},{"verse":17,"text":"イスラエルを追わずに残った者は、アイにもベテルにも一人もいなかった。しかも、イスラエルの後を追ったとき、町の門は開けたままであった。","tok":[["イスラエル"],["を"],["追わず","おわず"],["に"],["残った","のこった"],["者","もの"],["は"],["、"],["アイ"],["に"],["も"],["ベテル"],["に"],["も"],["一人","ひとり"],["も"],["いなかった"],["。"],["しかも"],["、"],["イスラエル"],["の"],["後","あと"],["を"],["追った","おった"],["とき"],["、"],["町","まち"],["の"],["門","もん"],["は"],["開けた","あけた"],["まま"],["で"],["あった"],["。"]]},{"verse":18,"text":"主はヨシュアに言われた。「あなたが手にしている投げ槍をアイに向かって差し伸べなさい。わたしはアイをあなたの手に渡す。」ヨシュアが手にしていた投げ槍を町に向かって差し伸べると、","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["が"],["手","て"],["に"],["して"],["いる"],["投げ槍","なげやり"],["を"],["アイ"],["に"],["向かって","むかって"],["差し伸べ","さしのべ"],["なさい"],["。"],["わたし"],["は"],["アイ"],["を"],["あなた"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["」"],["ヨシュア"],["が"],["手","て"],["に"],["して"],["いた"],["投げ槍","なげやり"],["を"],["町","まち"],["に"],["向かって","むかって"],["差し伸べる","さしのべる"],["と"],["、"]]},{"verse":19,"text":"伏兵は一斉にその場所から立ち上がり、ヨシュアが手を伸ばしている間に町に攻め込んで占領し、直ちに町に火を放った。","tok":[["伏兵","ふくへい"],["は"],["一斉","いっせい"],["に"],["その"],["場所","ばしょ"],["から"],["立ち上がり","たちあがり"],["、"],["ヨシュア"],["が"],["手","て"],["を"],["伸ばして","のばして"],["いる"],["間","あいだ"],["に"],["町","まち"],["に"],["攻め込んで","せめこんで"],["占領","せんりょう"],["し"],["、"],["直ちに","ただちに"],["町","まち"],["に"],["火","ひ"],["を"],["放った","はなった"],["。"]]},{"verse":20,"text":"アイの兵士が振り返って見たときには、既に町の煙は天に達しており、荒れ野に逃げた軍勢も追っ手に対して向き直ったので、彼らはどこにも逃げることができなくなってしまった。","tok":[["アイ"],["の"],["兵士","へいし"],["が"],["振り返って","ふりかえって"],["見た","みた"],["とき"],["に"],["は"],["、"],["既に","すでに"],["町","まち"],["の"],["煙","けむり"],["は"],["天","てん"],["に"],["達して","たっして"],["おり"],["、"],["荒れ野","あれの"],["に"],["逃げた","にげた"],["軍勢","ぐんぜい"],["も"],["追っ手","おって"],["に対して","にたいして"],["向き直った","むきなおった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["どこ"],["に"],["も"],["逃げる","にげる"],["こと"],["が"],["できなく"],["なって"],["しまった"],["。"]]},{"verse":21,"text":"ヨシュアの率いる全イスラエルは、伏兵が町を占領し、町から煙が立ち昇るのを見ると、向きを変えてアイの兵士に打ちかかり、","tok":[["ヨシュア"],["の"],["率いる","ひきいる"],["全","ぜん"],["イスラエル"],["は"],["、"],["伏兵","ふくへい"],["が"],["町","まち"],["を"],["占領","せんりょう"],["し"],["、"],["町","まち"],["から"],["煙","けむり"],["が"],["立ち昇る","たちのぼる"],["の"],["を"],["見る","みる"],["と"],["、"],["向き","むき"],["を"],["変えて","かえて"],["アイ"],["の"],["兵士","へいし"],["に"],["打ち","うち"],["かかり"],["、"]]},{"verse":22,"text":"伏兵も町を出て彼らに向かったので、彼らはイスラエル軍の挟み撃ちに遭い、生き残った者も落ちのびた者も一人もいなくなるまで打ちのめされた。","tok":[["伏兵","ふくへい"],["も"],["町","まち"],["を"],["出て","でて"],["彼","かれ"],["ら"],["に"],["向かった","むかった"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["イスラエル"],["軍","ぐん"],["の"],["挟み撃ち","はさみうち"],["に"],["遭い","あい"],["、"],["生き残った","いきのこった"],["者","もの"],["も"],["落ちのびた","おちのびた"],["者","もの"],["も"],["一人","ひとり"],["も"],["いなく"],["なる"],["まで"],["打ちのめされた","うちのめされた"],["。"]]},{"verse":23,"text":"アイの王は生け捕りにされ、ヨシュアのもとに引き出された。","tok":[["アイ"],["の"],["王","おう"],["は"],["生け捕り","いけどり"],["に"],["され"],["、"],["ヨシュア"],["の"],["もと"],["に"],["引き出された","ひきだされた"],["。"]]},{"verse":24,"text":"イスラエルは、追って来たアイの全住民を野原や荒れ野で殺し、一人残らず剣にかけて倒した。全イスラエルはアイにとって返し、その町を剣にかけて撃った。","tok":[["イスラエル"],["は"],["、"],["追って","おって"],["来た","きた"],["アイ"],["の"],["全住民","ぜんじゅうみん"],["を"],["野原","のはら"],["や"],["荒れ野","あれの"],["で"],["殺し","ころし"],["、"],["一人","ひとり"],["残らず","のこらず"],["剣","けん"],["に"],["かけて"],["倒した","たおした"],["。"],["全","ぜん"],["イスラエル"],["は"],["アイ"],["にとって"],["返し","かえし"],["、"],["その"],["町","まち"],["を"],["剣","けん"],["に"],["かけて"],["撃った","うった"],["。"]]},{"verse":25,"text":"その日の敵の死者は男女合わせて一万二千人、アイの全住民であった。","tok":[["その"],["日","ひ"],["の"],["敵","てき"],["の"],["死者","ししゃ"],["は"],["男女","だんじょ"],["合わせて","あわせて"],["一万二千","いちまんにせん"],["人","にん"],["、"],["アイ"],["の"],["全住民","ぜんじゅうみん"],["で"],["あった"],["。"]]},{"verse":26,"text":"ヨシュアはアイの住民をことごとく滅ぼし尽くすまで投げ槍を差し伸べた手を引っ込めなかった。","tok":[["ヨシュア"],["は"],["アイ"],["の"],["住民","じゅうみん"],["を"],["ことごとく"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["まで"],["投げ槍","なげやり"],["を"],["差し伸べた","さしのべた"],["手","て"],["を"],["引っ込めなかった","ひっこめなかった"],["。"]]},{"verse":27,"text":"ただし、この町の家畜と分捕り品は、主がヨシュアに命じた言葉どおり、イスラエルが自分たちのために奪い取った。","tok":[["ただし"],["、"],["この"],["町","まち"],["の"],["家畜","かちく"],["と"],["分捕り品","ぶんどりひん"],["は"],["、"],["主","ぬし"],["が"],["ヨシュア"],["に"],["命じた","めいじた"],["言葉","ことば"],["どおり"],["、"],["イスラエル"],["が"],["自分","じぶん"],["たち"],["の"],["ため"],["に"],["奪い取った","うばいとった"],["。"]]},{"verse":28,"text":"ヨシュアはこうしてアイを焼き払い、とこしえの廃虚の丘として打ち捨てた。それは今日まで残っている。","tok":[["ヨシュア"],["は"],["こう"],["して"],["アイ"],["を"],["焼き払い","やきはらい"],["、"],["とこしえ"],["の"],["廃虚","はいきょ"],["の"],["丘","おか"],["として"],["打ち捨てた","うちすてた"],["。"],["それ"],["は"],["今日","きょう"],["まで"],["残って","のこって"],["いる"],["。"]]},{"verse":29,"text":"ヨシュアはまた、アイの王を木にかけて夕方までさらし、太陽の沈むころ、命じてその死体を木から下ろさせ、町の門の入り口に投げ捨て、それを覆う大きな石塚を築かせた。それは今日まで残っている。","tok":[["ヨシュア"],["は"],["また"],["、"],["アイ"],["の"],["王","おう"],["を"],["木","き"],["に"],["かけて"],["夕方","ゆうがた"],["まで"],["さらし"],["、"],["太陽","たいよう"],["の"],["沈む","しずむ"],["ころ"],["、"],["命じて","めいじて"],["その"],["死体","したい"],["を"],["木","き"],["から"],["下ろさせ","おろさせ"],["、"],["町","まち"],["の"],["門","もん"],["の"],["入り口","いりぐち"],["に"],["投げ捨て","なげすて"],["、"],["それ"],["を"],["覆う","おおう"],["大きな","おおきな"],["石塚","いしづか"],["を"],["築かせた","きずかせた"],["。"],["それ"],["は"],["今日","きょう"],["まで"],["残って","のこって"],["いる"],["。"]]},{"verse":30,"text":"そのころ、ヨシュアはエバル山にイスラエルの神、主のための祭壇を築いた。","tok":[["その"],["ころ"],["、"],["ヨシュア"],["は"],["エバル"],["山","やま"],["に"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["ため"],["の"],["祭壇","さいだん"],["を"],["築いた","きずいた"],["。"]]},{"verse":31,"text":"この祭壇は、主の僕モーセがイスラエルの人々に命じ、モーセの教えの書に記されたとおり、鉄の道具を使わない自然のままの石で造られた。彼らはその上で、主に焼き尽くす献げ物と和解の献げ物をささげた。","tok":[["この"],["祭壇","さいだん"],["は"],["、"],["主","ぬし"],["の"],["僕","ぼく"],["モーセ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じ","めいじ"],["、"],["モーセ"],["の"],["教え","おしえ"],["の"],["書","しょ"],["に"],["記された","しるされた"],["とおり"],["、"],["鉄","てつ"],["の"],["道具","どうぐ"],["を"],["使わない","つかわない"],["自然","しぜん"],["の"],["まま"],["の"],["石","いし"],["で"],["造られた","つくられた"],["。"],["彼","かれ"],["ら"],["は"],["その"],["上","うえ"],["で"],["、"],["主","ぬし"],["に"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["と"],["和解","わかい"],["の"],["献げ物","ささげもの"],["を"],["ささげた"],["。"]]},{"verse":32,"text":"ヨシュアはこの祭壇の石に、モーセがイスラエルの人々のために記した教えの写しを刻んだ。","tok":[["ヨシュア"],["は"],["この"],["祭壇","さいだん"],["の"],["石","いし"],["に"],["、"],["モーセ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["記した","しるした"],["教え","おしえ"],["の"],["写し","うつし"],["を"],["刻んだ","きざんだ"],["。"]]},{"verse":33,"text":"全イスラエルは、長老、役人、裁判人をはじめ、寄留者もその土地に生まれた者も、主の契約の箱を担ぐレビ人である祭司たちの前で、箱のこちら側とあちら側に、半分はゲリジム山の前に、他の半分はエバル山の前に立った。それは主の僕モーセがかつて命じたように、イスラエルの民を祝福するためであった。","tok":[["全","ぜん"],["イスラエル"],["は"],["、"],["長老","ちょうろう"],["、"],["役人","やくにん"],["、"],["裁判人","さいばんにん"],["を"],["はじめ"],["、"],["寄留者","きりゅうしゃ"],["も"],["その"],["土地","とち"],["に"],["生まれた","うまれた"],["者","もの"],["も"],["、"],["主","ぬし"],["の"],["契約","けいやく"],["の"],["箱","ばこ"],["を"],["担ぐ","かつぐ"],["レビ人","れびにん"],["で"],["ある"],["祭司","さいし"],["たち"],["の"],["前","まえ"],["で"],["、"],["箱","ばこ"],["の"],["こちら側","こちらがわ"],["と"],["あちら側","あちらがわ"],["に"],["、"],["半分","はんぶん"],["は"],["ゲリジム"],["山","さん"],["の"],["前","まえ"],["に"],["、"],["他","た"],["の"],["半分","はんぶん"],["は"],["エバル"],["山","やま"],["の"],["前","まえ"],["に"],["立った","たった"],["。"],["それ"],["は"],["主","ぬし"],["の"],["僕","ぼく"],["モーセ"],["が"],["かつて"],["命じた","めいじた"],["よう"],["に"],["、"],["イスラエル"],["の"],["民","たみ"],["を"],["祝福","しゅくふく"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":34,"text":"その後ヨシュアは、律法の言葉すなわち祝福と呪いをことごとく、すべて律法の書に記されているとおりに読み上げた。","tok":[["その後","そのあと"],["ヨシュア"],["は"],["、"],["律法","りっぽう"],["の"],["言葉","ことば"],["すなわち"],["祝福","しゅくふく"],["と"],["呪い","のろい"],["を"],["ことごとく"],["、"],["すべて"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["記されて","しるされて"],["いる"],["とおり"],["に"],["読み上げた","よみあげた"],["。"]]},{"verse":35,"text":"ヨシュアは、モーセが命じたことをひと言残さず、イスラエルの全会衆、女、子供、彼らの間で生活する寄留者の前で読み上げた。","tok":[["ヨシュア"],["は"],["、"],["モーセ"],["が"],["命じた","めいじた"],["こと"],["を"],["ひと"],["言残さず","いいのこさず"],["、"],["イスラエル"],["の"],["全","ぜん"],["会衆","かいしゅう"],["、"],["女","おんな"],["、"],["子供","こども"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["生活","せいかつ"],["する"],["寄留者","きりゅうしゃ"],["の"],["前","まえ"],["で"],["読み上げた","よみあげた"],["。"]]}]
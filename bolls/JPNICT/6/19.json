[{"verse":1,"text":"二番目のくじで割り当てを受けたのはシメオンで、シメオンの人々の部族が氏族ごとに割り当てを受けた。その嗣業の土地はユダの人々の嗣業の土地の間にあった。","tok":[["二番目","にばんめ"],["の"],["くじ"],["で"],["割り当て","わりあて"],["を"],["受けた","うけた"],["の"],["は"],["シメオン"],["で"],["、"],["シメオン"],["の"],["人々","ひとびと"],["の"],["部族","ぶぞく"],["が"],["氏族","しぞく"],["ごと"],["に"],["割り当て","わりあて"],["を"],["受けた","うけた"],["。"],["その"],["嗣業","しぎょう"],["の"],["土地","とち"],["は"],["ユダ"],["の"],["人々","ひとびと"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["の"],["間","あいだ"],["に"],["あった"],["。"]]},{"verse":2,"text":"彼らの嗣業の土地は、ベエル‧シェバ、シェマ、モラダ、","tok":[["彼","かれ"],["ら"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["は"],["、"],["ベエル"],["‧"],["シェバ"],["、"],["シェマ"],["、"],["モラダ"],["、"]]},{"verse":3,"text":"ハツァル‧シュアル、バラ、エツェム、","tok":[["ハツァル"],["‧"],["シュアル"],["、"],["バラ"],["、"],["エツェム"],["、"]]},{"verse":4,"text":"エルトラド、ベトル、ホルマ、","tok":[["エルトラド"],["、"],["ベトル"],["、"],["ホルマ"],["、"]]},{"verse":5,"text":"ツィクラグ、ベト‧マルカボト、ハツァル‧スサ、","tok":[["ツィクラグ"],["、"],["ベト"],["‧"],["マルカボト"],["、"],["ハツァル"],["‧"],["スサ"],["、"]]},{"verse":6,"text":"ベト‧レバオト、シャルヘン、以上十三の町とそれに属する村、","tok":[["ベト"],["‧"],["レバオト"],["、"],["シャルヘン"],["、"],["以上","いじょう"],["十三","じゅうさん"],["の"],["町","まち"],["と"],["それ"],["に"],["属する","ぞくする"],["村","むら"],["、"]]},{"verse":7,"text":"エン‧リモン、タカン、エテル、アシャン、以上四つの町とそれに属する村、","tok":[["エン"],["‧"],["リモン"],["、"],["タカン"],["、"],["エテル"],["、"],["アシャン"],["、"],["以上","いじょう"],["四","よん"],["つ"],["の"],["町","まち"],["と"],["それ"],["に"],["属する","ぞくする"],["村","むら"],["、"]]},{"verse":8,"text":"および、これらの町の周囲にあって、バアラト‧ベエル、ラマト‧ネゲブに至るまでのすべての村々。以上がシメオンの人々が氏族ごとに受け継いだ嗣業の土地である。","tok":[["および"],["、"],["これ"],["ら"],["の"],["町","まち"],["の"],["周囲","しゅうい"],["に"],["あって"],["、"],["バアラト"],["‧"],["ベエル"],["、"],["ラマト"],["‧"],["ネゲブ"],["に"],["至る","いたる"],["まで"],["の"],["すべて"],["の"],["村々","むらむら"],["。"],["以上","いじょう"],["が"],["シメオン"],["の"],["人々","ひとびと"],["が"],["氏族","しぞく"],["ごと"],["に"],["受け継いだ","うけついだ"],["嗣業","しぎょう"],["の"],["土地","とち"],["で"],["ある"],["。"]]},{"verse":9,"text":"シメオンの人々の嗣業の土地はユダの人々の領土の一部であった。ユダの人々への割り当て地が多すぎたため、ユダの嗣業の土地の中にシメオンの人々は嗣業の土地を受け継いだのである。","tok":[["シメオン"],["の"],["人々
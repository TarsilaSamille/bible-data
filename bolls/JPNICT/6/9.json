[{"verse":1,"text":"ヨルダン川の西側の山地、シェフェラ、レバノン山のふもとに至る大海の沿岸地方に住むヘト人、アモリ人、カナン人、ペリジ人、ヒビ人、エブス人の王たちは皆、このことを伝え聞くと、","tok":[["ヨルダン"],["川","かわ"],["の"],["西側","にしがわ"],["の"],["山地","さんち"],["、"],["シェフェラ"],["、"],["レバノン"],["山","さん"],["の"],["ふもと"],["に"],["至る","いたる"],["大海","たいかい"],["の"],["沿岸","えんがん"],["地方","ちほう"],["に"],["住む","すむ"],["ヘト人","へとにん"],["、"],["アモリ人","あもりにん"],["、"],["カナン人","かなんにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス人","えぶすにん"],["の"],["王","おう"],["たち"],["は"],["皆","みな"],["、"],["この"],["こと"],["を"],["伝え聞く","つたえきく"],["と"],["、"]]},{"verse":2,"text":"集結してヨシュアの率いるイスラエルと一致して戦おうとした。","tok":[["集結","しゅうけつ"],["して"],["ヨシュア"],["の"],["率いる","ひきいる"],["イスラエル"],["と"],["一致","いっち"],["して"],["戦おう","たたかおう"],["と"],["した"],["。"]]},{"verse":3,"text":"ところがギブオンの住民は、ヨシュアがエリコとアイに対してしたことを聞き、","tok":[["ところ"],["が"],["ギブオン"],["の"],["住民","じゅうみん"],["は"],["、"],["ヨシュア"],["が"],["エリコ"],["と"],["アイ"],["に対して","にたいして"],["した"],["こと"],["を"],["聞き","きき"],["、"]]},{"verse":4,"text":"賢く立ちまわった。彼らは使者を装い、古びた袋、使い古して繕ってあるぶどう酒の革袋をろばに負わせ、","tok":[["賢く","かしこく"],["立ちまわった","たちまわった"],["。"],["彼","かれ"],["ら"],["は"],["使者","ししゃ"],["を"],["装い","よそおい"],["、"],["古びた","ふるびた"],["袋","ふくろ"],["、"],["使い古して","つかいふるして"],["繕って","つくろって"],["ある"],["ぶどう酒","ぶどうしゅ"],["の"],["革袋","かわぶくろ"],["を"],["ろば"],["に"],["負わせ","おわせ"],["、"]]},{"verse":5,"text":"継ぎの当たった古靴を履き、着古した外套をまとい、食糧として干からびたぼろぼろのパンを携えた。","tok":[["継ぎ","つぎ"],["の"],["当たった","あたった"],["古靴","ふるぐつ"],["を"],["履き","はき"],["、"],["着古した","きふるした"],["外套","がいとう"],["を"],["まとい"],["、"],["食糧","しょくりょう"],["として"],["干からびた","ひからびた"],["ぼろぼろ"],["の"],["パン"],["を"],["携えた","たずさえた"],["。"]]},{"verse":6,"text":"彼らはギルガルの陣営に来てヨシュアとイスラエル人に、「わたしたちは遠い国から参りました。どうか今、わたしたちと協定を結んでください」と言うと、","tok":[["彼","かれ"],["ら"],["は"],["ギルガル"],["の"],["陣営","じんえい"],["に"],["来て","きて"],["ヨシュア"],["と"],["イスラエル"],["人","にん"],["に"],["、"],["「"],["わたしたち"],["は"],["遠い","とおい"],["国","くに"],["から"],["参りました","まいりました"],["。"],["どう"],["か"],["今","いま"],["、"],["わたしたち"],["と"],["協定","きょうてい"],["を"],["結んで","むすんで"],["ください"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":7,"text":"イスラエル人はそのヒビ人に言った。「お前たちは、我々と共にここに住んでいるのだろう。どうして協定を結べようか。」","tok":[["イスラエル"],["人","にん"],["は"],["その"],["ヒビ人","ひびにん"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["たち"],["は"],["、"],["我々","われわれ"],["と"],["共","とも"],["に"],["ここ"],["に"],["住んで","すんで"],["いる"],["の"],["だろう"],["。"],["どう"],["して"],["協定","きょうてい"],["を"],["結べよう","むすべよう"],["か"],["。"],["」"]]},{"verse":8,"text":"彼らはヨシュアに、「わたしたちはあなたの僕でございます」と言うと、ヨシュアは尋ねた。「あなたたちは何者か、どこから来たのか。」","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["に"],["、"],["「"],["わたしたち"],["は"],["あなた"],["の"],["僕","ぼく"],["で"],["ございます"],["」"],["と"],["言う","ゆう"],["と"],["、"],["ヨシュア"],["は"],["尋ねた","たずねた"],["。"],["「"],["あなた"],["たち"],["は"],["何者","なにもの"],["か"],["、"],["どこ"],["から"],["来た","きた"],["の"],["か"],["。"],["」"]]},{"verse":9,"text":"彼らは言った。「僕どもはあなたの神、主の御名を慕ってはるかな遠い国から参りました。主がエジプトでなさった一切のことも、","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["僕","ぼく"],["ども"],["は"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["慕って","したって"],["はるか"],["な"],["遠い","とおい"],["国","くに"],["から"],["参りました","まいりました"],["。"],["主","ぬし"],["が"],["エジプト"],["で"],["なさった"],["一切","いっさい"],["の"],["こと"],["も"],["、"]]},{"verse":10,"text":"ヨルダン川の東側のアモリ人の二人の王、すなわちヘシュボンの王シホンとアシュタロトにいたバシャンの王オグになさったことも、ことごとく伝え聞きました。","tok":[["ヨルダン"],["川","かわ"],["の"],["東側","ひがしがわ"],["の"],["アモリ人","あもりにん"],["の"],["二人","ふたり"],["の"],["王","おう"],["、"],["すなわち"],["ヘシュボン"],["の"],["王","おう"],["シホン"],["と"],["アシュタロト"],["に"],["いた"],["バシャン"],["の"],["王","おう"],["オグ"],["に"],["なさった"],["こと"],["も"],["、"],["ことごとく"],["伝え聞きました","つたえききました"],["。"]]},{"verse":11,"text":"わたしたちの長老はじめ国の住民は皆、わたしたちに、『旅の食糧を手に携え、彼らに会って、わたしたちはあなたたちの僕です、どうか今、わたしたちと協定を結んでくださいと言いなさい』と申しました。","tok":[["わたしたち"],["の"],["長老","ちょうろう"],["はじめ"],["国","くに"],["の"],["住民","じゅうみん"],["は"],["皆","みな"],["、"],["わたしたち"],["に"],["、"],["『"],["旅","たび"],["の"],["食糧","しょくりょう"],["を"],["手","て"],["に"],["携え","たずさえ"],["、"],["彼","かれ"],["ら"],["に"],["会って","あって"],["、"],["わたしたち"],["は"],["あなた"],["たち"],["の"],["僕","ぼく"],["です"],["、"],["どう"],["か"],["今","いま"],["、"],["わたしたち"],["と"],["協定","きょうてい"],["を"],["結んで","むすんで"],["ください"],["と"],["言い","いい"],["なさい"],["』"],["と"],["申しました","もうしました"],["。"]]},{"verse":12,"text":"御覧ください。これがわたしたちのパンです。ここに来ようと出発した日に、食糧として家から携え出たときにはまだ温かかったのが、今はすっかり干からびてぼろぼろです。","tok":[["御覧","ごらん"],["ください"],["。"],["これ"],["が"],["わたしたち"],["の"],["パン"],["です"],["。"],["ここ"],["に"],["来よう","こよう"],["と"],["出発","しゅっぱつ"],["した"],["日","ひ"],["に"],["、"],["食糧","しょくりょう"],["として"],["家","いえ"],["から"],["携え","たずさえ"],["出た","でた"],["とき"],["に"],["は"],["まだ"],["温かかった","あたたかかった"],["の"],["が"],["、"],["今","いま"],["は"],["すっかり"],["干からびて","ひからびて"],["ぼろぼろ"],["です"],["。"]]},{"verse":13,"text":"このぶどう酒の革袋も酒を詰めたときは真新しかったのですが、御覧ください、破れてしまいました。わたしたちの外套も靴も、はるかな長旅のため、古びてしまいました。」","tok":[["この"],["ぶどう酒","ぶどうしゅ"],["の"],["革袋","かわぶくろ"],["も"],["酒","さけ"],["を"],["詰めた","つめた"],["とき"],["は"],["真新しかった","まあたらしかった"],["の"],["です"],["が"],["、"],["御覧","ごらん"],["ください"],["、"],["破れて","やぶれて"],["しまいました"],["。"],["わたしたち"],["の"],["外套","がいとう"],["も"],["靴","くつ"],["も"],["、"],["はるか"],["な"],["長旅","ながたび"],["の"],["ため"],["、"],["古びて","ふるびて"],["しまいました"],["。"],["」"]]},{"verse":14,"text":"男たちは彼らの食糧を受け取ったが、主の指示を求めなかった。","tok":[["男","おとこ"],["たち"],["は"],["彼","かれ"],["ら"],["の"],["食糧","しょくりょう"],["を"],["受け取った","うけとった"],["が"],["、"],["主","ぬし"],["の"],["指示","しじ"],["を"],["求めなかった","もとめなかった"],["。"]]},{"verse":15,"text":"ヨシュアは彼らと和を講じ、命を保障する協定を結び、共同体の指導者たちもその誓いに加わった。","tok":[["ヨシュア"],["は"],["彼","かれ"],["ら"],["と"],["和","わ"],["を"],["講じ","こうじ"],["、"],["命","いのち"],["を"],["保障","ほしょう"],["する"],["協定","きょうてい"],["を"],["結び","むすび"],["、"],["共同体","きょうどうたい"],["の"],["指導者","しどうしゃ"],["たち"],["も"],["その"],["誓い","ちかい"],["に"],["加わった","くわわった"],["。"]]},{"verse":16,"text":"協定を結んでから三日後、彼らが近くの者で、自分たちのうちに住んでいることを聞くと、","tok":[["協定","きょうてい"],["を"],["結んで","むすんで"],["から"],["三日後","みっかご"],["、"],["彼","かれ"],["ら"],["が"],["近く","ちかく"],["の"],["者","もの"],["で"],["、"],["自分","じぶん"],["たち"],["の"],["うち"],["に"],["住んで","すんで"],["いる"],["こと"],["を"],["聞く","きく"],["と"],["、"]]},{"verse":17,"text":"イスラエルの人々はそこをたって、三日目に彼らの町ギブオン、ケフィラ、ベエロト、キルヤト‧エアリムに着いた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["そこ"],["を"],["たって"],["、"],["三日目","みっかめ"],["に"],["彼","かれ"],["ら"],["の"],["町","まち"],["ギブオン"],["、"],["ケフィラ"],["、"],["ベエロト"],["、"],["キルヤト"],["‧"],["エアリム"],["に"],["着いた","ついた"],["。"]]},{"verse":18,"text":"イスラエルの人々は、共同体の指導者たちがイスラエルの神、主にかけて誓いを立てていたので、彼らを攻撃はしなかったが、共同体全体は指導者たちに不平を鳴らした。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["共同体","きょうどうたい"],["の"],["指導者","しどうしゃ"],["たち"],["が"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["に"],["かけて"],["誓い","ちかい"],["を"],["立てて","たてて"],["いた"],["ので"],["、"],["彼","かれ"],["ら"],["を"],["攻撃","こうげき"],["は"],["しなかった"],["が"],["、"],["共同体","きょうどうたい"],["全体","ぜんたい"],["は"],["指導者","しどうしゃ"],["たち"],["に"],["不平","ふへい"],["を"],["鳴らした","ならした"],["。"]]},{"verse":19,"text":"指導者たちは皆、共同体全体に言った。「我々はイスラエルの神、主にかけて彼らに誓った。今、彼らに手をつけることはできない。","tok":[["指導者","しどうしゃ"],["たち"],["は"],["皆","みな"],["、"],["共同体","きょうどうたい"],["全体","ぜんたい"],["に"],["言った","いった"],["。"],["「"],["我々","われわれ"],["は"],["イスラエル"],["の"],["神","かみ"],["、"],["主","ぬし"],["に"],["かけて"],["彼","かれ"],["ら"],["に"],["誓った","ちかった"],["。"],["今","いま"],["、"],["彼","かれ"],["ら"],["に"],["手","て"],["を"],["つける"],["こと"],["は"],["できない"],["。"]]},{"verse":20,"text":"我々のなすべきことはこうである。彼らを生かしておこう。彼らに誓った誓いのゆえに、御怒りが我々に下ることはないだろう。」","tok":[["我々","われわれ"],["の"],["なすべき"],["こと"],["は"],["こう"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["を"],["生かして","いかして"],["おこう"],["。"],["彼","かれ"],["ら"],["に"],["誓った","ちかった"],["誓い","ちかい"],["の"],["ゆえ"],["に"],["、"],["御怒り","おいかり"],["が"],["我々","われわれ"],["に"],["下る","くだる"],["こと"],["は"],["ないだろう"],["。"],["」"]]},{"verse":21,"text":"指導者たちは続けた。「彼らを生かしておき、共同体全体のために柴刈りと水くみをさせよう。」彼らはこうして、指導者たちの告げたとおりになった。","tok":[["指導者","しどうしゃ"],["たち"],["は"],["続けた","つづけた"],["。"],["「"],["彼","かれ"],["ら"],["を"],["生かして","いかして"],["おき"],["、"],["共同体","きょうどうたい"],["全体","ぜんたい"],["の"],["ため"],["に"],["柴刈り","しばかり"],["と"],["水くみ","みずくみ"],["を"],["させよう"],["。"],["」"],["彼","かれ"],["ら"],["は"],["こう"],["して"],["、"],["指導者","しどうしゃ"],["たち"],["の"],["告げた","つげた"],["とおり"],["に"],["なった"],["。"]]},{"verse":22,"text":"ヨシュアはギブオンの住民を呼び集めて、彼らに言った。「お前たちはなぜ、我々を欺いて、はるかな遠い国から来たと言ったのか。お前たちは我々のうちに住んでいるではないか。","tok":[["ヨシュア"],["は"],["ギブオン"],["の"],["住民","じゅうみん"],["を"],["呼び集めて","よびあつめて"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["「"],["お前","おまえ"],["たち"],["は"],["なぜ"],["、"],["我々","われわれ"],["を"],["欺いて","あざむいて"],["、"],["はるか"],["な"],["遠い","とおい"],["国","くに"],["から"],["来た","きた"],["と"],["言った","いった"],["の"],["か"],["。"],["お前","おまえ"],["たち"],["は"],["我々","われわれ"],["の"],["うち"],["に"],["住んで","すんで"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":23,"text":"お前たちは今、呪われて、奴隷となり、お前たちの間からわが神の宮の柴刈り、水くみが断えることはないだろう。」","tok":[["お前","おまえ"],["たち"],["は"],["今","いま"],["、"],["呪われて","のろわれて"],["、"],["奴隷","どれい"],["と"],["なり"],["、"],["お前","おまえ"],["たち"],["の"],["間","あいだ"],["から"],["わが"],["神","かみ"],["の"],["宮","みや"],["の"],["柴刈り","しばかり"],["、"],["水くみ","みずくみ"],["が"],["断","だん"],["える"],["こと"],["は"],["ないだろう"],["。"],["」"]]},{"verse":24,"text":"彼らはヨシュアに答えた。「あなたの神、主がその僕モーセに、『この地方はすべてあなたたちに与える。土地の住民をすべて滅ぼせ』とお命じになったことが僕どもにはっきり伝わって来たので、あなたたちのゆえに命を失うのを非常に恐れ、このことをいたしました。","tok":[["彼","かれ"],["ら"],["は"],["ヨシュア"],["に"],["答えた","こたえた"],["。"],["「"],["あなた"],["の"],["神","かみ"],["、"],["主","ぬし"],["が"],["その"],["僕","ぼく"],["モーセ"],["に"],["、"],["『"],["この"],["地方","ちほう"],["は"],["すべて"],["あなた"],["たち"],["に"],["与える","あたえる"],["。"],["土地","とち"],["の"],["住民","じゅうみん"],["を"],["すべて"],["滅ぼせ","ほろぼせ"],["』"],["と"],["お命じ","おめいじ"],["に"],["なった"],["こと"],["が"],["僕","ぼく"],["ども"],["に"],["はっきり"],["伝わって","つたわって"],["来た","きた"],["ので"],["、"],["あなた"],["たち"],["の"],["ゆえ"],["に"],["命","いのち"],["を"],["失う","うしなう"],["の"],["を"],["非常","ひじょう"],["に"],["恐れ","おそれ"],["、"],["この"],["こと"],["を"],["いたしました"],["。"]]},{"verse":25,"text":"御覧ください。わたしたちは今はあなたの手の中にあります。あなたが良いと見なし、正しいと見なされることをなさってください。」","tok":[["御覧","ごらん"],["ください"],["。"],["わたしたち"],["は"],["今","いま"],["は"],["あなた"],["の"],["手","て"],["の"],["中","なか"],["に"],["あります"],["。"],["あなた"],["が"],["良い","よい"],["と"],["見なし","みなし"],["、"],["正しい","ただしい"],["と"],["見なされる","みなされる"],["こと"],["を"],["なさって"],["ください"],["。"],["」"]]},{"verse":26,"text":"ヨシュアは彼らにそのようにし、イスラエルの人々の手から彼らを助け、殺すことを許さなかった。","tok":[["ヨシュア"],["は"],["彼","かれ"],["ら"],["に"],["その"],["よう"],["に"],["し"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["
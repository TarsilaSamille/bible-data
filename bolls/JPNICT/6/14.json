[{"verse":1,"text":"イスラエルの人々が、カナンの土地で嗣業の土地として受け継いだのは、次のとおりである。これは、祭司エルアザルとヌンの子ヨシュアが、イスラエルの人々の諸部族の家長と共に、彼らに嗣業の土地として与えたものである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["カナン"],["の"],["土地","とち"],["で"],["嗣業","しぎょう"],["の"],["土地","とち"],["として"],["受け継いだ","うけついだ"],["の"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["これ"],["は"],["、"],["祭司","さいし"],["エルアザル"],["と"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["が"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["諸","しょ"],["部族","ぶぞく"],["の"],["家長","かちょう"],["と"],["共","とも"],["に"],["、"],["彼","かれ"],["ら"],["に"],["嗣業","しぎょう"],["の"],["土地","とち"],["として"],["与えた","あたえた"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"すなわち主がモーセを通して命じられたように、くじで九つ半の部族に嗣業の土地を割り当てた。","tok":[["すなわち"],["主","ぬし"],["が"],["モーセ"],["を"],["通して","とおして"],["命じられた","めいじられた"],["よう"],["に"],["、"],["くじ"],["で"],["九","ここの"],["つ"],["半","はん"],["の"],["部族","ぶぞく"],["に"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["割り当てた","わりあてた"],["。"]]},{"verse":3,"text":"モーセは既に他の二つ半の部族にはヨルダン川の東側に嗣業の土地を与えていた。彼はレビ人には嗣業の土地を彼らの間に与えなかったが、","tok":[["モーセ"],["は"],["既に","すでに"],["他","ほか"],["の"],["二","ふた"],["つ"],["半","はん"],["の"],["部族","ぶぞく"],["に"],["は"],["ヨルダン"],["川","かわ"],["の"],["東側","ひがしがわ"],["に"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["与えて","あたえて"],["いた"],["。"],["彼","かれ"],["は"],["レビ人","れびにん"],["に"],["は"],["嗣業","しぎょう"],["の"],["土地","とち"],["を"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["与えなかった","あたえなかった"],["が"],["、"]]},{"verse":4,"text":"ヨセフの子孫がマナセとエフライムの二つの部族になっていた。レビ人は、カナンの土地の中には住むべき町と財産である家畜の放牧地のほか、何の割り当て地も与えられなかった。","tok":[["ヨセフ"],["の"],["子孫","しそん"],["が"],["マナセ"],["と"],["エフライム"],["の"],["二","ふた"],["つ"],["の"],["部族","ぶぞく"],["に"],["なって"],["いた"],["。"],["レビ人","れびにん"],["は"],["、"],["カナン"],["の"],["土地","とち"],["の"],["中","なか"],["に"],["は"],["住むべき","すむべき"],["町","まち"],["と"],["財産","ざいさん"],["で"],["ある"],["家畜","かちく"],["の"],["放牧","ほうぼく"],["地","ち"],["の"],["ほか"],["、"],["何","なん"],["の"],["割り当て","わりあて"],["地","ち"],["も"],["与えられなかった","あたえられなかった"],["。"]]},{"verse":5,"text":"イスラエルの人々は、土地を割り当てるにあたって、主がモーセに命じられたとおりにした。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["土地","とち"],["を"],["割り当てる","わりあてる"],["に"],["あたって"],["、"],["主","ぬし"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["した"],["。"]]},{"verse":6,"text":"そのころ、ギルガルのヨシュアのもとにユダの人々が来た。その一人ケナズ人エフネの子カレブがこう言った。「主がカデシュ‧バルネアでわたしとあなたのことについて神の人モーセに告げられた言葉を、あなたはご存じのはずです。","tok":[["その"],["ころ"],["、"],["ギルガル"],["の"],["ヨシュア"],["の"],["もと"],["に"],["ユダ"],["の"],["人々","ひとびと"],["が"],["来た","きた"],["。"],["その"],["一人","ひとり"],["ケナズ人","けなずにん"],["エフネ"],["の"],["子","こ"],["カレブ"],["が"],["こう"],["言った","いった"],["。"],["「"],["主","ぬし"],["が"],["カデシュ"],["‧"],["バルネア"],["で"],["わたし"],["と"],["あなた"],["の"],["こと"],["について"],["神","かみ"],["の"],["人","ひと"],["モーセ"],["に"],["告げられた","つげられた"],["言葉","ことば"],["を"],["、"],["あなた"],["は"],["ご存じ","ごぞんじ"],["の"],["はず"],["です"],["。"]]},{"verse":7,"text":"主の僕モーセがわたしをカデシュ‧バルネアから遣わし、この地方一帯を偵察させたのは、わたしが四十歳のときでした。わたしは思ったとおりに報告しました。","tok":[["主","ぬし"],["の"],["僕","ぼく"],["モーセ"],["が"],["わたし"],["を"],["カデシュ"],["‧"],["バルネア"],["から"],["遣わし","つかわし"],["、"],["この"],["地方","ちほう"],["一帯","いったい"],["を"],["偵察","ていさつ"],["させた"],["の"],["は"],["、"],["わたし"],["が"],["四十歳","よんじゅうさい"],["の"],["とき"],["でした"],["。"],["わたし"],["は"],["思った","おもった"],["とおり"],["に"],["報告","ほうこく"],["しました"],["。"]]},{"verse":8,"text":"一緒に行った者たちは民の心を挫きましたが、わたしはわたしの神、主に従いとおしました。","tok":[["一緒","いっしょ"],["に"],["行った","いった"],["者","もの"],["たち"],["は"],["民","みん"],["の"],["心","こころ"],["を"],["挫きました","くじきました"],["が"],["、"],["わたし"],["は"],["わたし"],["の"],["神","かみ"],["、"],["主に","おもに"],["従い","したがい"],["とおしました"],["。"]]},{"verse":9,"text":"その日、モーセは誓って、『あなたがわたしの神、主に従いとおしたから、あなたが足を踏み入れた土地は永久にあなたと、あなたの子孫の嗣業の土地になる』と約束しました。","tok":[["その"],["日","ひ"],["、"],["モーセ"],["は"],["誓って","ちかって"],["、"],["『"],["あなた"],["が"],["わたし"],["の"],["神","かみ"],["、"],["主に","おもに"],["従い","したがい"],["とおした"],["から"],["、"],["あなた"],["が"],["足","あし"],["を"],["踏み入れた","ふみいれた"],["土地","とち"],["は"],["永久","えいきゅう"],["に"],["あなた"],["と"],["、"],["あなた"],["の"],["子孫","しそん"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["に"],["なる"],["』"],["と"],["約束","やくそく"],["しました"],["。"]]},{"verse":10,"text":"御覧ください。主がモーセにこの約束をなさって以来四十五年、イスラエルがなお荒れ野を旅した間、主は約束どおりわたしを生き永らえさせてくださいました。今日わたしは八十五歳ですが、","tok":[["御覧","ごらん"],["ください"],["。"],["主","ぬし"],["が"],["モーセ"],["に"],["この"],["約束","やくそく"],["を"],["なさって"],["以来","いらい"],["四十五","よんじゅうご"],["年","ねん"],["、"],["イスラエル"],["が"],["なお"],["荒れ野","あれの"],["を"],["旅","たび"],["した"],["間","あいだ"],["、"],["主","ぬし"],["は"],["約束","やくそく"],["どおり"],["わたし"],["を"],["生き永らえさせて","いきながらえさせて"],["くださいました"],["。"],["今日","きょう"],["わたし"],["は"],["八十五歳","はちじゅうごさい"],["です"],["が"],["、"]]},{"verse":11,"text":"今なお健やかです。モーセの使いをしたあのころも今も変わりなく、戦争でも、日常の務めでもする力があります。","tok":[["今","いま"],["なお"],["健やか","すこやか"],["です"],["。"],["モーセ"],["の"],["使い","つかい"],["を"],["した"],["あの"],["ころ"],["も"],["今","いま"],["も"],["変わり","かわり"],["なく"],["、"],["戦争","せんそう"],["で"],["も"],["、"],["日常","にちじょう"],["の"],["務め","つとめ"],["で"],["も"],["する"],["力","ちから"],["が"],["あります"],["。"]]},{"verse":12,"text":"どうか主があの時約束してくださったこの山地をわたしにください。あの時、あなたも聞いたように、そこにはアナク人がおり、城壁のある大きな町々がありますが、主がわたしと共にいてくださるなら、約束どおり、彼らを追い払えます。」","tok":[["どう"],["か"],["主","ぬし"],["が"],["あの"],["時","とき"],["約束","やくそく"],["して"],["くださった"],["この"],["山地","さんち"],["を"],["わたし"],["に"],["ください"],["。"],["あの"],["時","とき"],["、"],["あなた"],["も"],["聞いた","きいた"],["よう"],["に"],["、"],["そこ"],["に"],["は"],["アナク人","あなくにん"],["が"],["おり"],["、"],["城壁","じょうへき"],["の"],["ある"],["大きな","おおきな"],["町々","まちまち"],["が"],["あります"],["が"],["、"],["主","ぬし"],["が"],["わたし"],["と"],["共","とも"],["に"],["いて"],["くださるなら"],["、"],["約束","やくそく"],["どおり"],["、"],["彼","かれ"],["ら"],["を"],["追い払えます","おいはらえます"],["。"],["」"]]},{"verse":13,"text":"ヨシュアはエフネの子カレブを祝福し、ヘブロンを嗣業の土地として彼に与えた。","tok":[["ヨシュア"],["は"],["エフネ"],["の"],["子","こ"],["カレブ"],["を"],["祝福","しゅくふく"],["し"],["、"],["ヘブロン"],["を"],["嗣業","しぎょう"],["の"],["土地","とち"],["として"],["彼","かれ"],["に"],["与えた","あたえた"],["。"]]},{"verse":14,"text":"ヘブロンはケナズ人エフネの子カレブの嗣業の土地となって、今日に至っている。彼がイスラエルの神、主に従いとおしたからである。","tok":[["ヘブロン"],["は"],["ケナズ人","けなずにん"],["エフネ"],["の"],["子","こ"],["カレブ"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["と"],["なって"],["、"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"],["彼","かれ"],["が"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["従い","したがい"],["とおした"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"ヘブロンはかつてキルヤト‧アルバと呼ばれていたが、それはアナク人の中で最も偉大な人物アルバの名によるものであった。この地方の戦いはこうして収まった。","tok":[["ヘブロン"],["は"],["かつて"],["キルヤト"],["‧"],["アルバ"],["と"],["呼ばれて","よばれて"],["いた"],["が"],["、"],["それ"],["は"],["アナク人","あなくにん"],["の"],["中","なか"],["で"],["最も","もっとも"],["偉大","いだい"],["な"],["人物","じんぶつ"],["アルバ"],["の"],["名","な"],["に"],["よる"],["もの"],["で"],["あった"],["。"],["この"],["地方","ちほう"],["の"],["戦い","たたかい"],["は"],["こう"],["して"],["収まった","おさまった"],["。"]]}]
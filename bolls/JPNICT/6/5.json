[{"verse":1,"text":"ヨルダン川の西側にいるアモリ人の王たちと、沿岸地方にいるカナン人の王たちは皆、主がイスラエルの人々のためにヨルダン川の水を涸らして、彼らを渡らせたと聞いて、心が挫け、もはやイスラエルの人々に立ち向かおうとする者はいなかった。","tok":[["ヨルダン"],["川","かわ"],["の"],["西側","にしがわ"],["に"],["いる"],["アモリ人","あもりにん"],["の"],["王","おう"],["たち"],["と"],["、"],["沿岸","えんがん"],["地方","ちほう"],["に"],["いる"],["カナン人","かなんにん"],["の"],["王","おう"],["たち"],["は"],["皆","みな"],["、"],["主","ぬし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["ヨルダン"],["川","かわ"],["の"],["水","みず"],["を"],["涸らして","からして"],["、"],["彼","かれ"],["ら"],["を"],["渡らせた","わたらせた"],["と"],["聞いて","きいて"],["、"],["心","こころ"],["が"],["挫け","くじけ"],["、"],["もはや"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["立ち向かおう","たちむかおう"],["と"],["する"],["者","もの"],["は"],["いなかった"],["。"]]},{"verse":2,"text":"そのとき、主はヨシュアに、火打ち石の刃物を作り、もう一度イスラエルの人々に割礼を施せ、とお命じになった。","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["ヨシュア"],["に"],["、"],["火打ち石","ひうちいし"],["の"],["刃物","はもの"],["を"],["作り","つくり"],["、"],["もう"],["一度","いちど"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["割礼","かつれい"],["を"],["施せ","ほどこせ"],["、"],["と"],["お命じ","おめいじ"],["に"],["なった"],["。"]]},{"verse":3,"text":"ヨシュアは、自ら火打ち石の刃物を作り、ギブアト‧アラロトでイスラエルの人々に割礼を施した。","tok":[["ヨシュア"],["は"],["、"],["自ら","みずから"],["火打ち石","ひうちいし"],["の"],["刃物","はもの"],["を"],["作り","つくり"],["、"],["ギブアト"],["‧"],["アラロト"],["で"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["割礼","かつれい"],["を"],["施した","ほどこした"],["。"]]},{"verse":4,"text":"ヨシュアが割礼を施した理由はこうである。すなわちエジプトを出て来たすべての民、戦士である成人男子は皆、エジプトを出た後、途中の荒れ野で死んだ。","tok":[["ヨシュア"],["が"],["割礼","かつれい"],["を"],["施した","ほどこした"],["理由","りゆう"],["は"],["こう"],["で"],["ある"],["。"],["すなわち"],["エジプト"],["を"],["出て","でて"],["来た","きた"],["すべて"],["の"],["民","たみ"],["、"],["戦士","せんし"],["で"],["ある"],["成人","せいじん"],["男子","だんし"],["は"],["皆","みな"],["、"],["エジプト"],["を"],["出た","でた"],["後","あと"],["、"],["途中","とちゅう"],["の"],["荒れ野","あれの"],["で"],["死んだ","しんだ"],["。"]]},{"verse":5,"text":"出て来た民は皆、割礼を受けていたが、エジプトを出た後、途中の荒れ野で生まれた者は一人も割礼を受けていなかったからである。","tok":[["出て","でて"],["来た","きた"],["民","たみ"],["は"],["皆","みな"],["、"],["割礼","かつれい"],["を"],["受けて","うけて"],["いた"],["が"],["、"],["エジプト"],["を"],["出た","でた"],["後","あと"],["、"],["途中","とちゅう"],["の"],["荒れ野","あれの"],["で"],["生まれた","うまれた"],["者","もの"],["は"],["一人","ひとり"],["も"],["割礼","かつれい"],["を"],["受けて","うけて"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"イスラエルの人々は荒れ野を四十年さまよい歩き、その間にエジプトを出て来た民、戦士たちはすべて死に絶えた。彼らが主の御声に聞き従わなかったため、我々に与えると先祖たちにお誓いになった土地、すなわち乳と蜜の流れる土地を、彼らには見せない、と主は誓われたのである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["荒れ野","あれの"],["を"],["四十","よんじゅう"],["年","ねん"],["さまよい"],["歩き","あるき"],["、"],["その"],["間","あいだ"],["に"],["エジプト"],["を"],["出て","でて"],["来た","きた"],["民","たみ"],["、"],["戦士","せんし"],["たち"],["は"],["すべて"],["死に絶えた","しにたえた"],["。"],["彼","かれ"],["ら"],["が"],["主","ぬし"],["の"],["御声","おこえ"],["に"],["聞き従わなかった","ききしたがわなかった"],["ため"],["、"],["我々","われわれ"],["に"],["与える","あたえる"],["と"],["先祖","せんぞ"],["たち"],["に"],["お誓い","おちかい"],["に"],["なった"],["土地","とち"],["、"],["すなわち"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["土地","とち"],["を"],["、"],["彼","かれ"],["ら"],["に"],["は"],["見せない","みせない"],["、"],["と"],["主","ぬし"],["は"],["誓われた","ちかわれた"],["ので"],["ある"],["。"]]},{"verse":7,"text":"ヨシュアが割礼を施したのは、神がその代わりにお立てになった彼らの息子たちであって、途中で割礼を受ける折がなく、無割礼だったからである。","tok":[["ヨシュア"],["が"],["割礼","かつれい"],["を"],["施した","ほどこした"],["の"],["は"],["、"],["神","かみ"],["が"],["その"],["代わり","かわり"],["に"],["お立て","おたて"],["に"],["なった"],["彼","かれ"],["ら"],["の"],["息子","むすこ"],["たち"],["で"],["あって"],["、"],["途中","とちゅう"],["で"],["割礼","かつれい"],["を"],["受ける","うける"],["折","おり"],["が"],["なく"],["、"],["無","む"],["割礼","かつれい"],["だった"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"民は全員割礼を受けた後、その傷がいえるまで、宿営内の自分の場所にとどまった。","tok":[["民","みん"],["は"],["全員","ぜんいん"],["割礼","かつれい"],["を"],["受けた","うけた"],["後","あと"],["、"],["その"],["傷","きず"],["が"],["いえる"],["まで"],["、"],["宿営内","しゅくえいない"],["の"],["自分","じぶん"],["の"],["場所","ばしょ"],["に"],["とどまった"],["。"]]},{"verse":9,"text":"主はヨシュアに言われた。「今日、わたしはあなたたちから、エジプトでの恥辱を取り除いた（ガラ）。」そのために、その場所の名はギルガルと呼ばれ、今日に至っている。","tok":[["主","ぬし"],["は"],["ヨシュア"],["に"],["言われた","いわれた"],["。"],["「"],["今日","きょう"],["、"],["わたし"],["は"],["あなた"],["たち"],["から"],["、"],["エジプト"],["で"],["の"],["恥辱","ちじょく"],["を"],["取り除いた","とりのぞいた"],["（"],["ガラ"],["）"],["。"],["」"],["その"],["ため"],["に"],["、"],["その"],["場所","ばしょ"],["の"],["名","な"],["は"],["ギルガル"],["と"],["呼ばれ","よばれ"],["、"],["今日","きょう"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":10,"text":"イスラエルの人々はギルガルに宿営していたが、その月の十四日の夕刻、エリコの平野で過越祭を祝った。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["ギルガル"],["に"],["宿営","しゅくえい"],["して"],["いた"],["が"],["、"],["その"],["月","つき"],["の"],["十四日","じゅうよんか"],["の"],["夕刻","ゆうこく"],["、"],["エリコ"],["の"],["平野","へいや"],["で"],["過越","すぎこし"],["祭","まつり"],["を"],["祝った","いわった"],["。"]]},{"verse":11,"text":"過越祭の翌日、その日のうちに彼らは土地の産物を、酵母を入れないパンや炒り麦にして食べた。","tok":[["過越","すぎこし"],["祭","まつり"],["の"],["翌日","よくじつ"],["、"],["その"],["日","ひ"],["の"],["うち"],["に"],["彼","かれ"],["ら"],["は"],["土地","とち"],["の"],["産物","さんぶつ"],["を"],["、"],["酵母","こうぼ"],["を"],["入れない","いれない"],["パン"],["や"],["炒り","いり"],["麦","むぎ"],["に"],["して"],["食べた","たべた"],["。"]]},{"verse":12,"text":"彼らが土地の産物を食べ始めたその日以来、マナは絶え、イスラエルの人々に、もはやマナはなくなった。彼らは、その年にカナンの土地で取れた収穫物を食べた。","tok":[["彼","かれ"],["ら"],["が"],["土地","とち"],["の"],["産物","さんぶつ"],["を"],["食べ","たべ"],["始めた","はじめた"],["その"],["日","ひ"],["以来","いらい"],["、"],["マナ"],["は"],["絶え","たえ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["、"],["もはや"],["マナ"],["は"],["なくなった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["その"],["年","とし"],["に"],["カナン"],["の"],["土地","とち"],["で"],["取れた","とれた"],["収穫物","しゅうかくぶつ"],["を"],["食べた","たべた"],["。"]]},{"verse":13,"text":"ヨシュアがエリコのそばにいたときのことである。彼が目を上げて、見ると、前方に抜き身の剣を手にした一人の男がこちらに向かって立っていた。ヨシュアが歩み寄って、「あなたは味方か、それとも敵か」と問いかけると、","tok":[["ヨシュア"],["が"],["エリコ"],["の"],["そば"],["に"],["いた"],["とき"],["の"],["こと"],["で"],["ある"],["。"],["彼","かれ"],["が"],["目","め"],["を"],["上げて","あげて"],["、"],["見る","みる"],["と"],["、"],["前方","ぜんぽう"],["に"],["抜き身","ぬきみ"],["の"],["剣","けん"],["を"],["手","て"],["に"],["した"],["一人","ひとり"],["の"],["男","おとこ"],["が"],["こちら"],["に"],["向かって","むかって"],["立って","たって"],["いた"],["。"],["ヨシュア"],["が"],["歩み寄って","あゆみよって"],["、"],["「"],["あなた"],["は"],["味方","みかた"],["か"],["、"],["それ"],["と"],["も"],["敵","てき"],["か"],["」"],["と"],["問いかける","といかける"],["と"],["、"]]},{"verse":14,"text":"彼は答えた。「いや。わたしは主の軍の将軍である。今、着いたところだ。」ヨシュアは地にひれ伏して拝し、彼に、「わが主は、この僕に何をお言いつけになるのですか」と言うと、","tok":[["彼","かれ"],["は"],["答えた","こたえた"],["。"],["「"],["いや"],["。"],["わたし"],["は"],["主","ぬし"],["の"],["軍","ぐん"],["の"],["将軍","しょうぐん"],["で"],["ある"],["。"],["今","いま"],["、"],["着いた","ついた"],["ところ"],["だ"],["。"],["」"],["ヨシュア"],["は"],["地","ち"],["に"],["ひれ伏して","ひれふして"],["拝し","はいし"],["、"],["彼","かれ"],["に"],["、"],["「"],["わが"],["主","ぬし"],["は"],["、"],["この"],["僕","ぼく"],["に"],["何","なん"],["を"],["お言いつけ","おいいつけ"],["に"],["なる"],["の"],["です"],["か"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":15,"text":"主の軍の将軍はヨシュアに言った。「あなたの足から履物を脱げ。あなたの立っている場所は聖なる所である。」ヨシュアはそのとおりにした。","tok":[["主","ぬし"],["の"],["軍","ぐん"],["の"],["将軍","しょうぐん"],["は"],["ヨシュア"],["に"],["言った","いった"],["。"],["「"],["あなた"],["の"],["足","あし"],["から"],["履物","はきもの"],["を"],["脱げ","ぬげ"],["。"],["あなた"],["の"],["立って","たって"],["いる"],["場所","ばしょ"],["は"],["聖","せい"],["なる"],["所","ところ"],["で"],["ある"],["。"],["」"],["ヨシュア"],["は"],["その"],["とおり"],["に"],["した"],["。"]]}]
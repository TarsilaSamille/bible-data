],["立ち上がり","たちあがり"],["イスラエル"],["に"],["戦い","たたかい"],["を"],["挑んだ","いどんだ"],["。"],["彼","かれ"],["は"],["使い","つかい"],["を"],["送って","おくって"],["、"],["ベオル"],["の"],["子","こ"],["バラム"],["を"],["呼び寄せ","よびよせ"],["、"],["あなた"],["たち"],["に"],["呪い","のろい"],["を"],["かけよう"],["と"],["した"],["が"],["、"]]},{"verse":10,"text":"わたしがバラムに聞こうとしなかったので、彼はあなたたちを祝福することとなった。わたしはこうして、あなたたちを彼の手から救い出した。","tok":[["わたし"],["が"],["バラム"],["に"],["聞こう","きこう"],["と"],["しなかった"],["ので"],["、"],["彼","かれ"],["は"],["あなた"],["たち"],["を"],["祝福","しゅくふく"],["する"],["こと"],["と"],["なった"],["。"],["わたし"],["は"],["こう"],["して"],["、"],["あなた"],["たち"],["を"],["彼","かれ"],["の"],["手","て"],["から"],["救い出した","すくいだした"],["。"]]},{"verse":11,"text":"あなたたちがヨルダン川を渡り、エリコに達したとき、エリコの人々をはじめ、アモリ人、ペリジ人、カナン人、ヘト人、ギルガシ人、ヒビ人、エブス人があなたたちに戦いを挑んだが、わたしは彼らをあなたたちの手に渡した。","tok":[["あなた"],["たち"],["が"],["ヨルダン"],["川","かわ"],["を"],["渡り","わたり"],["、"],["エリコ"],["に"],["達した","たっした"],["とき"],["、"],["エリコ"],["の"],["人々","ひとびと"],["を"],["はじめ"],["、"],["アモリ人","あもりにん"],["、"],["ペリジ人","ぺりじにん"],["、"],["カナン人","かなんにん"],["、"],["ヘト人","へとにん"],["、"],["ギルガシ"],["人","にん"],["、"],["ヒビ人","ひびにん"],["、"],["エブス"],["人","ひと"],["が"],["あなた"],["たち"],["に"],["戦い","たたかい"],["を"],["挑んだ","いどんだ"],["が"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["あなた"],["たち"],["の"],["手","て"],["に"],["渡した","わたした"],["。"]]},{"verse":12,"text":"わたしは、恐怖をあなたたちに先立たせ、剣にもよらず、弓にもよらず、彼らと二人のアモリ人の王をあなたたちのために追い払った。","tok":[["わたし"],["は"],["、"],["恐怖","きょうふ"],["を"],["あなた"],["たち"],["に"],["先立たせ","さきだたせ"],["、"],["剣","けん"],["に"],["も"],["よらず"],["、"],["弓","ゆみ"],["に"],["も"],["よらず"],["、"],["彼","かれ"],["ら"],["と"],["二人","ふたり"],["の"],["アモリ人","あもりにん"],["の"],["王","おう"],["を"],["あなた"],["たち"],["の"],["ため"],["に"],["追い払った","おいはらった"],["。"]]},{"verse":13,"text":"わたしは更に、あなたたちが自分で労せずして得た土地、自分で建てたのではない町を与えた。あなたたちはそこに住み、自分で植えたのではないぶどう畑とオリーブ畑の果実を食べている。』","tok":[["わたし"],["は"],["更に","さらに"],["、"],["あなた"],["たち"],["が"],["自分","じぶん"],["で"],["労せず","ろうせず"],["して"],["得た","えた"],["土地","とち"],["、"],["自分","じぶん"],["で"],["建てた","たてた"],["ので"],["は"],["ない"],["町","まち"],["を"],["与えた","あたえた"],["。"],["あなた"],["たち"],["は"],["そこ"],["に"],["住み","すみ"],["、"],["自分","じぶん"],["で"],["植えた","うえた"],["ので"],["は"],["ない"],["ぶどう"],["畑","はたけ"],["と"],["オリーブ"],["畑","はたけ"],["の"],["果実","かじつ"],["を"],["食べて","たべて"],["いる"],["。"],["』"]]},{"verse":14,"text":"あなたたちはだから、主を畏れ、真心を込め真実をもって彼に仕え、あなたたちの先祖が川の向こう側やエジプトで仕えていた神々を除き去って、主に仕えなさい。","tok":[["あなた"],["たち"],["は"],["だ"],["から"],["、"],["主","ぬし"],["を"],["畏れ","おそれ"],["、"],["真心","まごころ"],["を"],["込め","こめ"],["真実","しんじつ"],["を"],["もって"],["彼","かれ"],["に"],["仕え","つかえ"],["、"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["が"],["川","かわ"],["の"],["向こう側","むこうがわ"],["や"],["エジプト"],["で"],["仕えて","つかえて"],["いた"],["神々","かみがみ"],["を"],["除き去って","のぞきさって"],["、"],["主に","おもに"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":15,"text":"もし主に仕えたくないというならば、川の向こう側にいたあなたたちの先祖が仕えていた神々でも、あるいは今、あなたたちが住んでいる土地のアモリ人の神々でも、仕えたいと思うものを、今日、自分で選びなさい。ただし、わたしとわたしの家は主に仕えます。」","tok":[["もし"],["主に","おもに"],["仕えたく","つかえたく"],["ない"],["と"],["いうならば"],["、"],["川","かわ"],["の"],["向こう側","むこうがわ"],["に"],["いた"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["が"],["仕えて","つかえて"],["いた"],["神々","かみがみ"],["で"],["も"],["、"],["あるいは"],["今","いま"],["、"],["あなた"],["たち"],["が"],["住んで","すんで"],["いる"],["土地","とち"],["の"],["アモリ人","あもりにん"],["の"],["神々","かみがみ"],["で"],["も"],["、"],["仕えたい","つかえたい"],["と"],["思う","おもう"],["もの"],["を"],["、"],["今日","きょう"],["、"],["自分","じぶん"],["で"],["選び","えらび"],["なさい"],["。"],["ただし"],["、"],["わたし"],["と"],["わたし"],["の"],["家","いえ"],["は"],["主に","おもに"],["仕えます","つかえます"],["。"],["」"]]},{"verse":16,"text":"民は答えた。「主を捨てて、ほかの神々に仕えることなど、するはずがありません。","tok":[["民","みん"],["は"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["を"],["捨てて","すてて"],["、"],["ほか"],["の"],["神々","かみがみ"],["に"],["仕える","つかえる"],["こと"],["など"],["、"],["する"],["はず"],["が"],["ありません"],["。"]]},{"verse":17,"text":"わたしたちの神、主は、わたしたちとわたしたちの先祖を、奴隷にされていたエジプトの国から導き上り、わたしたちの目の前で数々の大きな奇跡を行い、わたしたちの行く先々で、またわたしたちが通って来たすべての民の中で、わたしたちを守ってくださった方です。","tok":[["わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["わたしたち"],["と"],["わたしたち"],["の"],["先祖","せんぞ"],["を"],["、"],["奴隷","どれい"],["に"],["されて"],["いた"],["エジプト"],["の"],["国","くに"],["から"],["導き","みちびき"],["上り","のぼり"],["、"],["わたしたち"],["の"],["目","め"],["の"],["前","まえ"],["で"],["数々","かずかず"],["の"],["大きな","おおきな"],["奇跡","きせき"],["を"],["行い","おこない"],["、"],["わたしたち"],["の"],["行く","いく"],["先々","さきざき"],["で"],["、"],["また"],["わたしたち"],["が"],["通って","かよって"],["来た","きた"],["すべて"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["、"],["わたしたち"],["を"],["守って","まもって"],["くださった"],["方","ほう"],["です"],["。"]]},{"verse":18,"text":"主はまた、この土地に住んでいたアモリ人をはじめ、すべての民をわたしたちのために追い払ってくださいました。わたしたちも主に仕えます。この方こそ、わたしたちの神です。」","tok":[["主","ぬし"],["は"],["また"],["、"],["この"],["土地","とち"],["に"],["住んで","すんで"],["いた"],["アモリ人","あもりにん"],["を"],["はじめ"],["、"],["すべて"],["の"],["民","たみ"],["を"],["わたしたち"],["の"],["ため"],["に"],["追い払って","おいはらって"],["くださいました"],["。"],["わたしたち"],["も"],["主に","おもに"],["仕えます","つかえます"],["。"],["この"],["方","かた"],["こそ"],["、"],["わたしたち"],["の"],["神","かみ"],["です"],["。"],["」"]]},{"verse":19,"text":"ヨシュアはしかし、民に言った。「あなたたちは主に仕えることができないであろう。この方は聖なる神であり、熱情の神であって、あなたたちの背きと罪をお赦しにならないからである。","tok":[["ヨシュア"],["は"],["しかし"],["、"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["は"],["主に","おもに"],["仕える","つかえる"],["こと"],["が"],["できないで"],["あろう"],["。"],["この"],["方","かた"],["は"],["聖","せい"],["なる"],["神","かみ"],["で"],["あり"],["、"],["熱情","ねつじょう"],["の"],["神","かみ"],["で"],["あって"],["、"],["あなた"],["たち"],["の"],["背き","そむき"],["と"],["罪","つみ"],["を"],["お赦し","おゆるし"],["に"],["ならない"],["から"],["で"],["ある"],["。"]]},{"verse":20,"text":"もし、あなたたちが主を捨てて外国の神々に仕えるなら、あなたたちを幸せにした後でも、一転して災いをくだし、あなたたちを滅ぼし尽くされる。」","tok":[["もし"],["、"],["あなた"],["たち"],["が"],["主","ぬし"],["を"],["捨てて","すてて"],["外国","がいこく"],["の"],["神々","かみがみ"],["に"],["仕えるなら","つかえるなら"],["、"],["あなた"],["たち"],["を"],["幸せ","しあわせ"],["に"],["した"],["後","あと"],["で"],["も"],["、"],["一転","いってん"],["して"],["災い","わざわい"],["を"],["くだし"],["、"],["あなた"],["たち"],["を"],["滅ぼし","ほろぼし"],["尽くされる","つくされる"],["。"],["」"]]},{"verse":21,"text":"民がヨシュアに、「いいえ、わたしたちは主を礼拝します」と言うと、","tok":[["民","みん"],["が"],["ヨシュア"],["に"],["、"],["「"],["いいえ"],["、"],["わたしたち"],["は"],["主","ぬし"],["を"],["礼拝","れいはい"],["します"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":22,"text":"ヨシュアは民に言った。「あなたたちが主を選び、主に仕えるということの証人はあなたたち自身である。」彼らが、「そのとおり、わたしたちが証人です」と答えると、","tok":[["ヨシュア"],["は"],["民","みん"],["に"],["言った","いった"],["。"],["「"],["あなた"],["たち"],["が"],["主","ぬし"],["を"],["選び","えらび"],["、"],["主に","おもに"],["仕える","つかえる"],["と"],["いう"],["こと"],["の"],["証人","しょうにん"],["は"],["あなた"],["たち"],["自身","じしん"],["で"],["ある"],["。"],["」"],["彼","かれ"],["ら"],["が"],["、"],["「"],["その"],["とおり"],["、"],["わたしたち"],["が"],["証人","しょうにん"],["です"],["」"],["と"],["答える","こたえる"],["と"],["、"]]},{"verse":23,"text":"「それではあなたたちのもとにある外国の神々を取り除き、イスラエルの神、主に心を傾けなさい」と勧めた。","tok":[["「"],["それ"],["で"],["は"],["あなた"],["たち"],["の"],["もと"],["に"],["ある"],["外国","がいこく"],["の"],["神々","かみがみ"],["を"],["取り除き","とりのぞき"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主に","おもに"],["心","こころ"],["を"],["傾け","かたむけ"],["なさい"],["」"],["と"],["勧めた","すすめた"],["。"]]},{"verse":24,"text":"民はヨシュアに答えた。「わたしたちの神、主にわたしたちは仕え、その声に聞き従います。」","tok":[["民","みん"],["は"],["ヨシュア"],["に"],["答えた","こたえた"],["。"],["「"],["わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["わたしたち"],["は"],["仕え","つかえ"],["、"],["その"],["声","こえ"],["に"],["聞き従います","ききしたがいます"],["。"],["」"]]},{"verse":25,"text":"その日、ヨシュアはシケムで民と契約を結び、彼らのために掟と法とを定めた。","tok":[["その"],["日","ひ"],["、"],["ヨシュア"],["は"],["シケム"],["で"],["民","たみ"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["掟","おきて"],["と"],["法","ほう"],["と"],["を"],["定めた","さだめた"],["。"]]},{"verse":26,"text":"ヨシュアは、これらの言葉を神の教えの書に記し、次いで、大きな石を取り、主の聖所にあるテレビンの木のもとに立て、","tok":[["ヨシュア"],["は"],["、"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["神","かみ"],["の"],["教え","おしえ"],["の"],["書","しょ"],["に"],["記し","しるし"],["、"],["次いで","ついで"],["、"],["大きな","おおきな"],["石","いし"],["を"],["取り","とり"],["、"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["に"],["ある"],["テレビン"],["の"],["木","き"],["の"],["もと"],["に"],["立て","たて"],["、"]]},{"verse":27,"text":"民全員に告げた。「見よ、この石がわたしたちに対して証拠となる。この石は、わたしたちに語られた主の仰せをことごとく聞いているからである。この石は、あなたたちが神を欺くことのないように、あなたたちに対して証拠となる。」","tok":[["民","みん"],["全員","ぜんいん"],["に"],["告げた","つげた"],["。"],["「"],["見よ","みよ"],["、"],["この"],["石","いし"],["が"],["わたしたち"],["に対して","にたいして"],["証拠","しょうこ"],["と"],["なる"],["。"],["この"],["石","いし"],["は"],["、"],["わたしたち"],["に"],["語られた","かたられた"],["主","ぬし"],["の"],["仰せ","おおせ"],["を"],["ことごとく"],["聞いて","きいて"],["いる"],["から"],["で"],["ある"],["。"],["この"],["石","いし"],["は"],["、"],["あなた"],["たち"],["が"],["神","かみ"],["を"],["欺く","あざむく"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["あなた"],["たち"],["に対して","にたいして"],["証拠","しょうこ"],["と"],["なる"],["。"],["」"]]},{"verse":28,"text":"ヨシュアはこうして、民をそれぞれの嗣業の土地に送り出した。","tok":[["ヨシュア"],["は"],["こう"],["して"],["、"],["民","みん"],["を"],["それぞれ"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["に"],["送り出した","おくりだした"],["。"]]},{"verse":29,"text":"これらのことの後、主の僕、ヌンの子ヨシュアは百十歳の生涯を閉じ、","tok":[["これ"],["ら"],["の"],["こと"],["の"],["後","あと"],["、"],["主","ぬし"],["の"],["僕","ぼく"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["百十歳","ひゃくとうさい"],["の"],["生涯","しょうがい"],["を"],["閉じ","とじ"],["、"]]},{"verse":30,"text":"エフライムの山地にある彼の嗣業の土地ティムナト‧セラに葬られた。それはガアシュ山の北にある。","tok":[["エフライム"],["の"],["山地","さんち"],["に"],["ある"],["彼","かれ"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["ティムナト"],["‧"],["セラ"],["に"],["葬られた","ほうむられた"],["。"],["それ"],["は"],["ガアシュ"],["山","やま"],["の"],["北","きた"],["に"],["ある"],["。"]]},{"verse":31,"text":"ヨシュアの在世中はもとより、ヨシュアの死後も生き永らえて、主がイスラエルに行われた御業をことごとく体験した長老たちの存命中、イスラエルは主に仕えた。","tok":[["ヨシュア"],["の"],["在世中","ざいせちゅう"],["は"],["もとより"],["、"],["ヨシュア"],["の"],["死後","しご"],["も"],["生き永らえて","いきながらえて"],["、"],["主","ぬし"],["が"],["イスラエル"],["に"],["行われた","おこなわれた"],["御業","ごごう"],["を"],["ことごとく"],["体験","たいけん"],["した"],["長老","ちょうろう"],["たち"],["の"],["存命中","ぞんめいちゅう"],["、"],["イスラエル"],["は"],["主に","おもに"],["仕えた","つかえた"],["。"]]},{"verse":32,"text":"イスラエルの人々がエジプトから携えてきたヨセフの骨は、その昔、ヤコブが百ケシタで、シケムの父ハモルの息子たちから買い取ったシケムの野の一画に埋葬された。それは、ヨセフの子孫の嗣業の土地となった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["エジプト"],["から"],["携えて","たずさえて"],["きた"],["ヨセフ"],["の"],["骨","ほね"],["は"],["、"],["その"],["昔","むかし"],["、"],["ヤコブ"],["が"],["百","ひゃく"],["ケシタ"],["で"],["、"],["シケム"],["の"],["父","ちち"],["ハモル"],["の"],["息子","むすこ"],["たち"],["から"],["買い取った","かいとった"],["シケム"],["の"],["野","の"],["の"],["一画","いっかく"],["に"],["埋葬","まいそう"],["された"],["。"],["それ"],["は"],["、"],["ヨセフ"],["の"],["子孫","しそん"],["の"],["嗣業","しぎょう"],["の"],["土地","とち"],["と"],["なった"],["。"]]},{"verse":33,"text":"アロンの子エルアザルも死に、その息子ピネハスに与えられたエフライム山地のギブアに葬られた。","tok":[["アロン"],["の"],["子","こ"],["エルアザル"],["も"],["死に","しに"],["、"],["その"],["息子","むすこ"],["ピネハス"],["に"],["与えられた","あたえられた"],["エフライム"],["山地","さんち"],["の"],["ギブア"],["に"],["葬られた","ほうむられた"],["。"]]}]
[{"verse":1,"text":"焦って口を開き、心せいて神の前に言葉を出そうとするな。神は天にいまし、あなたは地上にいる。言葉数を少なくせよ。","tok":[["焦って","あせって"],["口","くち"],["を"],["開き","ひらき"],["、"],["心","こころ"],["せいて"],["神","かみ"],["の"],["前","まえ"],["に"],["言葉","ことば"],["を"],["出そう","だそう"],["と"],["する"],["な"],["。"],["神","かみ"],["は"],["天","てん"],["に"],["いまし"],["、"],["あなた"],["は"],["地上","ちじょう"],["に"],["いる"],["。"],["言葉数","ことばかず"],["を"],["少なく","すくなく"],["せよ"],["。"]]},{"verse":2,"text":"夢を見るのは悩みごとが多いから。愚者の声と知れるのは口数が多いから。","tok":[["夢","ゆめ"],["を"],["見る","みる"],["の"],["は"],["悩みごと","なやみごと"],["が"],["多い","おおい"],["から"],["。"],["愚者","ぐしゃ"],["の"],["声","こえ"],["と"],["知れる","しれる"],["の"],["は"],["口数","くちかず"],["が"],["多い","おおい"],["から"],["。"]]},{"verse":3,"text":"神に願をかけたら誓いを果たすのを遅らせてはならない。愚か者は神に喜ばれない。願をかけたら、誓いを果たせ。","tok":[["神","かみ"],["に"],["願","がん"],["を"],["かけたら"],["誓い","ちかい"],["を"],["果たす","はたす"],["の"],["を"],["遅らせて","おくらせて"],["は"],["ならない"],["。"],["愚か者","おろかもの"],["は"],["神","かみ"],["に"],["喜ばれない","よろこばれない"],["。"],["願","がん"],["を"],["かけたら"],["、"],["誓い","ちかい"],["を"],["果たせ","はたせ"],["。"]]},{"verse":4,"text":"願をかけておきながら誓いを果たさないなら願をかけないほうがよい。","tok":[["願","がん"],["を"],["かけて"],["おき"],["ながら"],["誓い","ちかい"],["を"],["果たさないなら","はたさないなら"],["願","がん"],["を"],["かけない"],["ほう"],["が"],["よい"],["。"]]},{"verse":5,"text":"口が身を滅ぼすことにならないように。使者に「あれは間違いでした」などと言うな。神はその声を聞いて怒りあなたの手の業を滅ぼされるであろう。","tok":[["口","くち"],["が"],["身","み"],["を"],["滅ぼす","ほろぼす"],["こと"],["に"],["ならない"],["よう"],["に"],["。"],["使者","ししゃ"],["に"],["「"],["あれ"],["は"],["間違い","まちがい"],["でした"],["」"],["など"],["と"],["言う","ゆう"],["な"],["。"],["神","かみ"],["は"],["その"],["声","こえ"],["を"],["聞いて","きいて"],["怒り","おこり"],["あなた"],["の"],["手","て"],["の"],["業","ごう"],["を"],["滅ぼされるで","ほろぼされるで"],["あろう"],["。"]]},{"verse":6,"text":"夢や空想が多いと饒舌になる。神を畏れ敬え。","tok":[["夢","ゆめ"],["や"],["空想","くうそう"],["が"],["多い","おおい"],["と"],["饒舌","じょうぜつ"],["に"],["なる"],["。"],["神","かみ"],["を"],["畏れ","おそれ"],["敬え","うやまえ"],["。"]]},{"verse":7,"text":"貧しい人が虐げられていることや、不正な裁き、正義の欠如などがこの国にあるのを見ても、驚くな。なぜなら身分の高い者が、身分の高い者をかばい更に身分の高い者が両者をかばうのだから。","tok":[["貧しい","まずしい"],["人","ひと"],["が"],["虐げられて","しいたげられて"],["いる"],["こと"],["や"],["、"],["不正","ふせい"],["な"],["裁き","さばき"],["、"],["正義","せいぎ"],["の"],["欠如","けつじょ"],["など"],["が"],["この"],["国","くに"],["に"],["ある"],["の"],["を"],["見て","みて"],["も"],["、"],["驚く","おどろく"],["な"],["。"],["なぜ"],["なら"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["が"],["、"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["を"],["かばい"],["更に","さらに"],["身分","みぶん"],["の"],["高い","たかい"],["者","もの"],["が"],["両者","りょうしゃ"],["を"],["かばう"],["の"],["だ"],["から"],["。"]]},{"verse":8,"text":"何にもまして国にとって益となるのは王が耕地を大切にすること。","tok":[["何に","なんに"],["も"],["まして"],["国","くに"],["にとって"],["益","えき"],["と"],["なる"],["の"],["は"],["王","おう"],["が"],["耕地","こうち"],["を"],["大切","たいせつ"],["に"],["する"],["こと"],["。"]]},{"verse":9,"text":"銀を愛する者は銀に飽くことなく富を愛する者は収益に満足しない。これまた空しいことだ。","tok":[["銀","ぎん"],["を"],["愛する","あいする"],["者","もの"],["は"],["銀","ぎん"],["に"],["飽く","あく"],["こと"],["なく"],["富","とみ"],["を"],["愛する","あいする"],["者","もの"],["は"],["収益","しゅうえき"],["に"],["満足","まんぞく"],["しない"],["。"],["これ"],["また"],["空しい","むなしい"],["こと"],["だ"],["。"]]},{"verse":10,"text":"財産が増せば、それを食らう者も増す。持ち主は眺めているばかりで、何の得もない。","tok":[["財産","ざいさん"],["が"],["増せば","ませば"],["、"],["それ"],["を"],["食らう","くらう"],["者","もの"],["も"],["増す","ます"],["。"],["持ち主","もちぬし"],["は"],["眺めて","ながめて"],["いる"],["ばかり"],["で"],["、"],["何","なん"],["の"],["得","とく"],["も"],["ない"],["。"]]},{"verse":11,"text":"働く者の眠りは快い満腹していても、飢えていても。金持ちは食べ飽きていて眠れない。","tok":[["働く","はたらく"],["者","もの"],["の"],["眠り","ねむり"],["は"],["快い","こころよい"],["満腹","まんぷく"],["して"],["いて"],["も"],["、"],["飢えて","うえて"],["いて"],["も"],["。"],["金持ち","かねもち"],["は"],["食べ飽きて","たべあきて"],["いて"],["眠れない","ねむれない"],["。"]]},{"verse":12,"text":"太陽の下に、大きな不幸があるのを見た。富の管理が悪くて持ち主が損をしている。","tok":[["太陽","たいよう"],["の"],["下","した"],["に"],["、"],["大きな","おおきな"],["不幸","ふこう"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"],["富","とみ"],["の"],["管理","かんり"],["が"],["悪くて","わるくて"],["持ち主","もちぬし"],["が"],["損","そん"],["を"],["して"],["いる"],["。"]]},{"verse":13,"text":"下手に使ってその富を失い息子が生まれても、彼の手には何もない。","tok":[["下手","へた"],["に"],["使って","つかって"],["その"],["富","とみ"],["を"],["失い","うしない"],["息子","むすこ"],["が"],["生まれて","うまれて"],["も"],["、"],["彼","かれ"],["の"],["手","て"],["に"],["は"],["何","なん"],["も"],["ない"],["。"]]},{"verse":14,"text":"人は、裸で母の胎を出たように、裸で帰る。来た時の姿で、行くのだ。労苦の結果を何ひとつ持って行くわけではない。","tok":[["人","ひと"],["は"],["、"],["裸","はだか"],["で"],["母","はは"],["の"],["胎","はら"],["を"],["出た","でた"],["よう"],["に"],["、"],["裸","はだか"],["で"],["帰る","かえる"],["。"],["来た","きた"],["時","とき"],["の"],["姿","すがた"],["で"],["、"],["行く","いく"],["の"],["だ"],["。"],["労苦","ろうく"],["の"],["結果","けっか"],["を"],["何","なん"],["ひと"],["つ"],["持って","もって"],["行く","いく"],["わけ"],["で"],["は"],["ない"],["。"]]},{"verse":15,"text":"これまた、大いに不幸なことだ。来た時と同じように、行かざるをえない。風を追って労苦して、何になろうか。","tok":[["これ"],["また"],["、"],["大いに","おおいに"],["不幸","ふこう"],["な"],["こと"],["だ"],["。"],["来た","きた"],["時","とき"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["行かざる","いかざる"],["を"],["えない"],["。"],["風","かぜ"],["を"],["追って","おって"],["労苦","ろうく"],["して"],["、"],["何","なん"],["に"],["なろう"],["か"],["。"]]},{"verse":16,"text":"その一生の間、食べることさえ闇の中。悩み、患い、怒りは尽きない。","tok":[["その"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["食べる","たべる"],["こと"],["さえ"],["闇","やみ"],["の"],["中","なか"],["。"],["悩み","なやみ"],["、"],["患い","わずらい"],["、"],["怒り","いかり"],["は"],["尽きない","つきない"],["。"]]},{"verse":17,"text":"見よ、わたしの見たことはこうだ。神に与えられた短い人生の日々に、飲み食いし、太陽の下で労苦した結果のすべてに満足することこそ、幸福で良いことだ。それが人の受けるべき分だ。","tok":[["見よ","みよ"],["、"],["わたし"],["の"],["見た","みた"],["こと"],["は"],["こう"],["だ"],["。"],["神","かみ"],["に"],["与えられた","あたえられた"],["短い","みじかい"],["人生","じんせい"],["の"],["日々","ひび"],["に"],["、"],["飲み食い","のみくい"],["し"],["、"],["太陽","たいよう"],["の"],["下","もと"],["で"],["労苦","ろうく"],["した"],["結果","けっか"],["の"],["すべて"],["に"],["満足","まんぞく"],["する"],["こと"],["こそ"],["、"],["幸福","こうふく"],["で"],["良い","よい"],["こと"],["だ"],["。"],["それ"],["が"],["人","ひと"],["の"],["受けるべき","うけるべき"],["分","ぶん"],["だ"],["。"]]},{"verse":18,"text":"神から富や財宝をいただいた人は皆、それを享受し、自らの分をわきまえ、その労苦の結果を楽しむように定められている。これは神の賜物なのだ。","tok":[["神","かみ"],["から"],["富","とみ"],["や"],["財宝","ざいほう"],["を"],["いただいた"],["人","ひと"],["は"],["皆","みな"],["、"],["それ"],["を"],["享受","きょうじゅ"],["し"],["、"],["自ら","みずから"],["の"],["分","ぶん"],["を"],["わきまえ"],["、"],["その"],["労苦","ろうく"],["の"],["結果","けっか"],["を"],["楽しむ","たのしむ"],["よう"],["に"],["定められて","さだめられて"],["いる"],["。"],["これ"],["は"],["神","かみ"],["の"],["賜物","たまもの"],["な"],["の"],["だ"],["。"]]},{"verse":19,"text":"彼はその人生の日々をあまり思い返すこともない。神がその心に喜びを与えられるのだから。","tok":[["彼","かれ"],["は"],["その"],["人生","じんせい"],["の"],["日々","ひび"],["を"],["あまり"],["思い返す","おもいかえす"],["こと"],["も"],["ない"],["。"],["神","かみ"],["が"],["その"],["心","こころ"],["に"],["喜び","よろこび"],["を"],["与えられる","あたえられる"],["の"],["だ"],["から"],["。"]]}]
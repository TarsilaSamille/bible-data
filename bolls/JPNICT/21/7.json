[{"verse":1,"text":"名声は香油にまさる。死ぬ日は生まれる日にまさる。","tok":[["名声","めいせい"],["は"],["香油","こうゆ"],["に"],["まさる"],["。"],["死ぬ","しぬ"],["日","ひ"],["は"],["生まれる","うまれる"],["日","ひ"],["に"],["まさる"],["。"]]},{"verse":2,"text":"弔いの家に行くのは酒宴の家に行くのにまさる。そこには人皆の終りがある。命あるものよ、心せよ。","tok":[["弔い","とむらい"],["の"],["家","いえ"],["に"],["行く","いく"],["の"],["は"],["酒宴","しゅえん"],["の"],["家","いえ"],["に"],["行く","いく"],["のに"],["まさる"],["。"],["そこ"],["に"],["は"],["人","ひと"],["皆","みな"],["の"],["終り","おわり"],["が"],["ある"],["。"],["命","いのち"],["ある"],["もの"],["よ"],["、"],["心","こころ"],["せよ"],["。"]]},{"verse":3,"text":"悩みは笑いにまさる。顔が曇るにつれて心は安らぐ。","tok":[["悩み","なやみ"],["は"],["笑い","わらい"],["に"],["まさる"],["。"],["顔","かお"],["が"],["曇る","くもる"],["に"],["つれて"],["心","こころ"],["は"],["安らぐ","やすらぐ"],["。"]]},{"verse":4,"text":"賢者の心は弔いの家に愚者の心は快楽の家に。","tok":[["賢者","けんじゃ"],["の"],["心","こころ"],["は"],["弔い","とむらい"],["の"],["家","いえ"],["に"],["愚者","ぐしゃ"],["の"],["心","こころ"],["は"],["快楽","かいらく"],["の"],["家","いえ"],["に"],["。"]]},{"verse":5,"text":"賢者の叱責を聞くのは愚者の賛美を聞くのにまさる。","tok":[["賢者","けんじゃ"],["の"],["叱責","しっせき"],["を"],["聞く","きく"],["の"],["は"],["愚者","ぐしゃ"],["の"],["賛美","さんび"],["を"],["聞く","きく"],["のに"],["まさる"],["。"]]},{"verse":6,"text":"愚者の笑いは鍋の下にはぜる柴の音。これまた空しい。","tok":[["愚者","ぐしゃ"],["の"],["笑い","わらい"],["は"],["鍋","なべ"],["の"],["下","した"],["に"],["はぜる"],["柴","しば"],["の"],["音","おと"],["。"],["これ"],["また"],["空しい","むなしい"],["。"]]},{"verse":7,"text":"賢者さえも、虐げられれば狂い賄賂をもらえば理性を失う。","tok":[["賢者","けんじゃ"],["さえ"],["も"],["、"],["虐げられれば","しいたげられれば"],["狂い","くるい"],["賄賂","わいろ"],["を"],["もらえば"],["理性","りせい"],["を"],["失う","うしなう"],["。"]]},{"verse":8,"text":"事の終りは始めにまさる。気位が高いよりも気が長いのがよい。","tok":[["事","こと"],["の"],["終り","おわり"],["は"],["始め","はじめ"],["に"],["まさる"],["。"],["気位","きぐらい"],["が"],["高い","たかい"],["より"],["も"],["気","き"],["が"],["長い","ながい"],["の"],["が"],["よい"],["。"]]},{"verse":9,"text":"気短に怒るな。怒りは愚者の胸に宿るもの。","tok":[["気短","きみじか"],["に"],["怒る","おこる"],["な"],["。"],["怒り","いかり"],["は"],["愚者","ぐしゃ"],["の"],["胸","むね"],["に"],["宿る","やどる"],["もの"],["。"]]},{"verse":10,"text":"昔の方がよかったのはなぜだろうかと言うな。それは賢い問いではない。","tok":[["昔","むかし"],["の"],["方","ほう"],["が"],["よかった"],["の"],["は"],["なぜ"],["だろう"],["か"],["と"],["言う","ゆう"],["な"],["。"],["それ"],["は"],["賢い","かしこい"],["問い","とい"],["で"],["は"],["ない"],["。"]]},{"verse":11,"text":"知恵は遺産に劣らず良いもの。日の光を見る者の役に立つ。","tok":[["知恵","ちえ"],["は"],["遺産","いさん"],["に"],["劣らず","おとらず"],["良い","よい"],["もの"],["。"],["日","ひ"],["の"],["光","ひかり"],["を"],["見る","みる"],["者","もの"],["の"],["役","やく"],["に"],["立つ","たつ"],["。"]]},{"verse":12,"text":"知恵の陰に宿れば銀の陰に宿る、というが知っておくがよい知恵はその持ち主に命を与える、と。","tok":[["知恵","ちえ"],["の"],["陰","かげ"],["に"],["宿れば","やどれば"],["銀","ぎん"],["の"],["陰","かげ"],["に"],["宿る","やどる"],["、"],["と"],["いう"],["が"],["知って","しって"],["おく"],["が"],["よい"],["知恵","ちえ"],["は"],["その"],["持ち主","もちぬし"],["に"],["命","いのち"],["を"],["与える","あたえる"],["、"],["と"],["。"]]},{"verse":13,"text":"神の御業を見よ。神が曲げたものを、誰が直しえようか。","tok":[["神","かみ"],["の"],["御業","ごごう"],["を"],["見よ","みよ"],["。"],["神","かみ"],["が"],["曲げた","まげた"],["もの"],["を"],["、"],["誰","だれ"],["が"],["直し","なおし"],["えよう"],["か"],["。"]]},{"verse":14,"text":"順境には楽しめ、逆境にはこう考えよ人が未来について無知であるようにと神はこの両者を併せ造られた、と。","tok":[["順境","じゅんきょう"],["に"],["は"],["楽しめ","たのしめ"],["、"],["逆境","ぎゃっきょう"],["に"],["は"],["こう"],["考えよ","かんがえよ"],["人","ひと"],["が"],["未来","みらい"],["について"],["無知","むち"],["で"],["ある"],["よう"],["に"],["と"],["神","かみ"],["は"],["この"],["両者","りょうしゃ"],["を"],["併せ","あわせ"],["造られた","つくられた"],["、"],["と"],["。"]]},{"verse":15,"text":"この空しい人生の日々にわたしはすべてを見極めた。善人がその善のゆえに滅びることもあり悪人がその悪のゆえに長らえることもある。","tok":[["この"],["空しい","むなしい"],["人生","じんせい"],["の"],["日々","ひび"],["に"],["わたし"],["は"],["すべて"],["を"],["見極めた","みきわめた"],["。"],["善人","ぜんにん"],["が"],["その"],["善","ぜん"],["の"],["ゆえ"],["に"],["滅びる","ほろびる"],["こと"],["も"],["あり"],["悪人","あくにん"],["が"],["その"],["悪","あく"],["の"],["ゆえ"],["に"],["長らえる","ながらえる"],["こと"],["も"],["ある"],["。"]]},{"verse":16,"text":"善人すぎるな、賢すぎるなどうして滅びてよかろう。","tok":[["善人","ぜんにん"],["すぎる"],["な"],["、"],["賢","かしこ"],["すぎる"],["な"],["どう"],["して"],["滅びて","ほろびて"],["よかろう"],["。"]]},{"verse":17,"text":"悪事をすごすな、愚かすぎるなどうして時も来ないのに死んでよかろう。","tok":[["悪事","あくじ"],["を"],["すごす"],["な"],["、"],["愚か","おろか"],["すぎる"],["な"],["どう"],["して"],["時","とき"],["も"],["来ない","こない"],["のに"],["死んで","しんで"],["よかろう"],["。"]]},{"verse":18,"text":"一つのことをつかむのはよいがほかのことからも手を放してはいけない。神を畏れ敬えばどちらをも成し遂げることができる。","tok":[["一","ひと"],["つ"],["の"],["こと"],["を"],["つかむ"],["の"],["は"],["よい"],["が"],["ほか"],["の"],["こと"],["から"],["も"],["手","て"],["を"],["放して","はなして"],["は"],["いけない"],["。"],["神","かみ"],["を"],["畏れ","おそれ"],["敬えば","うやまえば"],["どちら"],["を"],["も"],["成し遂げる","なしとげる"],["こと"],["が"],["できる"],["。"]]},{"verse":19,"text":"知恵は賢者を力づけて町にいる十人の権力者よりも強くする。","tok":[["知恵","ちえ"],["は"],["賢者","けんじゃ"],["を"],["力づけて","ちからづけて"],["町","まち"],["に"],["いる"],["十人","じゅうにん"],["の"],["権力者","けんりょくしゃ"],["より"],["も"],["強く","つよく"],["する"],["。"]]},{"verse":20,"text":"善のみ行って罪を犯さないような人間はこの地上にはいない。","tok":[["善","ぜん"],["のみ"],["行って","いって"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["な"],["人間","にんげん"],["は"],["この"],["地上","ちじょう"],["に"],["は"],["いない"],["。"]]},{"verse":21,"text":"人の言うことをいちいち気にするな。そうすれば、僕があなたを呪っても聞き流していられる。","tok":[["人","ひと"],["の"],["言う","いう"],["こと"],["を"],["いちいち"],["気","き"],["に"],["する"],["な"],["。"],["そう"],["すれば"],["、"],["僕","ぼく"],["が"],["あなた"],["を"],["呪って","のろって"],["も"],["聞き流して","ききながして"],["いられる"],["。"]]},{"verse":22,"text":"あなた自身も何度となく他人を呪ったことをあなたの心はよく知っているはずだ。","tok":[["あなた"],["自身","じしん"],["も"],["何度","なんど"],["と"],["なく"],["他人","たにん"],["を"],["呪った","のろった"],["こと"],["を"],["あなた"],["の"],["心","こころ"],["は"],["よく"],["知って","しって"],["いる"],["はず"],["だ"],["。"]]},{"verse":23,"text":"わたしはこういうことをすべて知恵を尽くして試してみた。賢者でありたいと思ったがそれはわたしから遠いことであった。","tok":[["わたし"],["は"],["こう"],["いう"],["こと"],["を"],["すべて"],["知恵","ちえ"],["を"],["尽くして","つくして"],["試して","ためして"],["みた"],["。"],["賢者","けんじゃ"],["で"],["ありたい"],["と"],["思った","おもった"],["が"],["それ"],["は"],["わたし"],["から"],["遠い","とおい"],["こと"],["で"],["あった"],["。"]]},{"verse":24,"text":"存在したことは、はるかに遠くその深い深いところを誰が見いだせようか。","tok":[["存在","そんざい"],["した"],["こと"],["は"],["、"],["はるか"],["に"],["遠く","とおく"],["その"],["深い","ふかい"],["深い","ふかい"],["ところ"],["を"],["誰","だれ"],["が"],["見いだせよう","みいだせよう"],["か"],["。"]]},{"verse":25,"text":"わたしは熱心に知識を求め知恵と結論を追求し悪は愚行、愚行は狂気であることを悟ろうとした。","tok":[["わたし"],["は"],["熱心","ねっしん"],["に"],["知識","ちし
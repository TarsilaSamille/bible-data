[{"verse":1,"text":"太陽の下に、次のような不幸があって、人間を大きく支配しているのをわたしは見た。","tok":[["太陽","たいよう"],["の"],["下","した"],["に"],["、"],["次","つぎ"],["の"],["よう"],["な"],["不幸","ふこう"],["が"],["あって"],["、"],["人間","にんげん"],["を"],["大きく","おおきく"],["支配","しはい"],["して"],["いる"],["の"],["を"],["わたし"],["は"],["見た","みた"],["。"]]},{"verse":2,"text":"ある人に神は富、財宝、名誉を与え、この人の望むところは何ひとつ欠けていなかった。しかし神は、彼がそれを自ら享受することを許されなかったので、他人がそれを得ることになった。これまた空しく、大いに不幸なことだ。","tok":[["ある"],["人","ひと"],["に"],["神","かみ"],["は"],["富","とみ"],["、"],["財宝","ざいほう"],["、"],["名誉","めいよ"],["を"],["与え","あたえ"],["、"],["この"],["人","ひと"],["の"],["望む","のぞむ"],["ところ"],["は"],["何","なん"],["ひと"],["つ"],["欠けて","かけて"],["いなかった"],["。"],["しかし"],["神","かみ"],["は"],["、"],["彼","かれ"],["が"],["それ"],["を"],["自ら","みずから"],["享受","きょうじゅ"],["する"],["こと"],["を"],["許されなかった","ゆるされなかった"],["ので"],["、"],["他人","たにん"],["が"],["それ"],["を"],["得る","える"],["こと"],["に"],["なった"],["。"],["これ"],["また"],["空しく","むなしく"],["、"],["大いに","おおいに"],["不幸","ふこう"],["な"],["こと"],["だ"],["。"]]},{"verse":3,"text":"人が百人の子を持ち、長寿を全うしたとする。しかし、長生きしながら、財産に満足もせず死んで葬儀もしてもらえなかったなら流産の子の方が好運だとわたしは言おう。","tok":[["人","ひと"],["が"],["百人","ひゃくにん"],["の"],["子","こ"],["を"],["持ち","もち"],["、"],["長寿","ちょうじゅ"],["を"],["全う","まっとう"],["した"],["と"],["する"],["。"],["しかし"],["、"],["長生き","ながいき"],["し"],["ながら"],["、"],["財産","ざいさん"],["に"],["満足","まんぞく"],["も"],["せず"],["死んで","しんで"],["葬儀","そうぎ"],["も"],["して"],["もらえなかったなら"],["流産","りゅうざん"],["の"],["子","こ"],["の"],["方","ほう"],["が"],["好運","こううん"],["だ"],["と"],["わたし"],["は"],["言おう","いおう"],["。"]]},{"verse":4,"text":"その子は空しく生まれ、闇の中に去りその名は闇に隠される。","tok":[["その"],["子","こ"],["は"],["空しく","むなしく"],["生まれ","うまれ"],["、"],["闇","やみ"],["の"],["中","なか"],["に"],["去り","さり"],["その"],["名","な"],["は"],["闇","やみ"],["に"],["隠される","かくされる"],["。"]]},{"verse":5,"text":"太陽の光を見ることも知ることもない。しかし、その子の方が安らかだ。","tok":[["太陽","たいよう"],["の"],["光","ひかり"],["を"],["見る","みる"],["こと"],["も"],["知る","しる"],["こと"],["も"],["ない"],["。"],["しかし"],["、"],["その"],["子","こ"],["の"],["方","ほう"],["が"],["安らか","やすらか"],["だ"],["。"]]},{"verse":6,"text":"たとえ、千年の長寿を二度繰り返したとしても、幸福でなかったなら、何になろう。すべてのものは同じひとつの所に行くのだから。","tok":[["たとえ"],["、"],["千","せん"],["年","ねん"],["の"],["長寿","ちょうじゅ"],["を"],["二","に"],["度","ど"],["繰り返した","くりかえした"],["として"],["も"],["、"],["幸福","こうふく"],["で"],["なかったなら"],["、"],["何","なん"],["に"],["なろう"],["。"],["すべて"],["の"],["もの"],["は"],["同じ","おなじ"],["ひと"],["つ"],["の"],["所","ところ"],["に"],["行く","いく"],["の"],["だ"],["から"],["。"]]},{"verse":7,"text":"人の労苦はすべて口のためだがそれでも食欲は満たされない。","tok":[["人","ひと"],["の"],["労苦","ろうく"],["は"],["すべて"],["口","くち"],["の"],["ため"],["だ"],["が"],["それ"],["で"],["も"],["食欲","しょくよく"],["は"],["満たされない","みたされない"],["。"]]},{"verse":8,"text":"賢者は愚者にまさる益を得ようか。人生の歩き方を知っていることが貧しい人に何かの益となろうか。","tok":[["賢者","けんじゃ"],["は"],["愚者","ぐしゃ"],["に"],["まさる"],["益","えき"],["を"],["得よう","えよう"],["か"],["。"],["人生","じんせい"],["の"],["歩き","あるき"],["方","かた"],["を"],["知って","しって"],["いる"],["こと"],["が"],["貧しい","まずしい"],["人","ひと"],["に"],["何","なん"],["か"],["の"],["益","えき"],["と"],["なろう"],["か"],["。"]]},{"verse":9,"text":"欲望が行きすぎるよりも目の前に見えているものが良い。これまた空しく、風を追うようなことだ。","tok":[["欲望","よくぼう"],["が"],["行き","いき"],["すぎる"],["より"],["も"],["目","め"],["の"],["前","まえ"],["に"],["見えて","みえて"],["いる"],["もの"],["が"],["良い","よい"],["。"],["これ"],["また"],["空しく","むなしく"],["、"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["こと"],["だ"],["。"]]},{"verse":10,"text":"これまでに存在したものはすべて、名前を与えられている。人間とは何ものなのかも知られている。自分より強いものを訴えることはできない。","tok":[["これ"],["まで"],["に"],["存在","そんざい"],["した"],["もの"],["は"],["すべて"],["、"],["名前","なまえ"],["を"],["与えられて","あたえられて"],["いる"],["。"],["人間","にんげん"],["と"],["は"],["何もの","なにもの"],["な"],["の"],["か"],["も"],["知られて","しられて"],["いる"],["。"],["自分","じぶん"],["より"],["強い","つよい"],["もの"],["を"],["訴える","うったえる"],["こと"],["は"],["できない"],["。"]]},{"verse":11,"text":"言葉が多ければ空しさも増すものだ。人間にとって、それが何になろう。","tok":[["言葉","ことば"],["が"],["多ければ","おおければ"],["空し","むなし"],["さ"],["も"],["増す","ます"],["もの"],["だ"],["。"],["人間","にんげん"],["にとって"],["、"],["それ"],["が"],["何","なん"],["に"],["なろう"],["。"]]},{"verse":12,"text":"短く空しい人生の日々を、影のように過ごす人間にとって、幸福とは何かを誰が知ろう。人間、その一生の後はどうなるのかを教えてくれるものは、太陽の下にはいない。","tok":[["短く","みじかく"],["空しい","むなしい"],["人生","じんせい"],["の"],["日々","ひび"],["を"],["、"],["影","かげ"],["の"],["よう"],["に"],["過ごす","すごす"],["人間","にんげん"],["にとって"],["、"],["幸福","こうふく"],["と"],["は"],["何","なん"],["か"],["を"],["誰","だれ"],["が"],["知ろう","しろう"],["。"],["人間","にんげん"],["、"],["その"],["一生","いっしょう"],["の"],["後","あと"],["は"],["どう"],["なる"],["の"],["か"],["を"],["教えて","おしえて"],["くれる"],["もの"],["は"],["、"],["太陽","たいよう"],["の"],["下","した"],["に"],["は"],["いない"],["。"]]}]
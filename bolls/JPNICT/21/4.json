[{"verse":1,"text":"わたしは改めて、太陽の下に行われる虐げのすべてを見た。見よ、虐げられる人の涙を。彼らを慰める者はない。見よ、虐げる者の手にある力を。彼らを慰める者はない。","tok":[["わたし"],["は"],["改めて","あらためて"],["、"],["太陽","たいよう"],["の"],["下","した"],["に"],["行われる","おこなわれる"],["虐げ","しいたげ"],["の"],["すべて"],["を"],["見た","みた"],["。"],["見よ","みよ"],["、"],["虐げられる","しいたげられる"],["人","ひと"],["の"],["涙","なみだ"],["を"],["。"],["彼","かれ"],["ら"],["を"],["慰める","なぐさめる"],["者","もの"],["は"],["ない"],["。"],["見よ","みよ"],["、"],["虐げる","しいたげる"],["者","もの"],["の"],["手","て"],["に"],["ある"],["力","ちから"],["を"],["。"],["彼","かれ"],["ら"],["を"],["慰める","なぐさめる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":2,"text":"既に死んだ人を、幸いだと言おう。更に生きて行かなければならない人よりは幸いだ。","tok":[["既に","すでに"],["死んだ","しんだ"],["人","ひと"],["を"],["、"],["幸い","さいわい"],["だ"],["と"],["言おう","いおう"],["。"],["更に","さらに"],["生きて","いきて"],["行かなければ","いかなければ"],["ならない"],["人","ひと"],["より"],["は"],["幸い","さいわい"],["だ"],["。"]]},{"verse":3,"text":"いや、その両者よりも幸福なのは、生まれて来なかった者だ。太陽の下に起こる悪い業を見ていないのだから。","tok":[["いや"],["、"],["その"],["両者","りょうしゃ"],["より"],["も"],["幸福","こうふく"],["な"],["の"],["は"],["、"],["生まれて","うまれて"],["来なかった","こなかった"],["者","もの"],["だ"],["。"],["太陽","たいよう"],["の"],["下","した"],["に"],["起こる","おこる"],["悪い","わるい"],["業","ごう"],["を"],["見て","みて"],["いない"],["の"],["だ"],["から"],["。"]]},{"verse":4,"text":"人間が才知を尽くして労苦するのは、仲間に対して競争心を燃やしているからだということも分かった。これまた空しく、風を追うようなことだ。","tok":[["人間","にんげん"],["が"],["才知","さいち"],["を"],["尽くして","つくして"],["労苦","ろうく"],["する"],["の"],["は"],["、"],["仲間","なかま"],["に対して","にたいして"],["競争心","きょうそうしん"],["を"],["燃やして","もやして"],["いる"],["から"],["だ"],["と"],["いう"],["こと"],["も"],["分かった","わかった"],["。"],["これ"],["また"],["空しく","むなしく"],["、"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["こと"],["だ"],["。"]]},{"verse":5,"text":"愚か者は手をつかねてその身を食いつぶす。","tok":[["愚か者","おろかもの"],["は"],["手","て"],["を"],["つかねて"],["その"],["身","み"],["を"],["食いつぶす","くいつぶす"],["。"]]},{"verse":6,"text":"片手を満たして、憩いを得るのは両手を満たして、なお労苦するよりも良い。それは風を追うようなことだ。","tok":[["片手","かたて"],["を"],["満たして","みたして"],["、"],["憩い","いこい"],["を"],["得る","える"],["の"],["は"],["両手","りょうて"],["を"],["満たして","みたして"],["、"],["なお"],["労苦","ろうく"],["する"],["より"],["も"],["良い","よい"],["。"],["それ"],["は"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["こと"],["だ"],["。"]]},{"verse":7,"text":"わたしは改めて太陽の下に空しいことがあるのを見た。","tok":[["わたし"],["は"],["改めて","あらためて"],["太陽","たいよう"],["の"],["下","した"],["に"],["空しい","むなしい"],["こと"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse":8,"text":"ひとりの男があった。友も息子も兄弟もない。際限もなく労苦し、彼の目は富に飽くことがない。「自分の魂に快いものを欠いてまで誰のために労苦するのか」と思いもしない。これまた空しく、不幸なことだ。","tok":[["ひとり"],["の"],["男","おとこ"],["が"],["あった"],["。"],["友","とも"],["も"],["息子","むすこ"],["も"],["兄弟","きょうだい"],["も"],["ない"],["。"],["際限","さいげん"],["も"],["なく"],["労苦","ろうく"],["し"],["、"],["彼","かれ"],["の"],["目","め"],["は"],["富","とみ"],["に"],["飽く","あく"],["こと"],["が"],["ない"],["。"],["「"],["自分","じぶん"],["の"],["魂","たましい"],["に"],["快い","こころよい"],["もの"],["を"],["欠いて","かいて"],["まで"],["誰","だれ"],["の"],["ため"],["に"],["労苦","ろうく"],["する"],["の"],["か"],["」"],["と"],["思い","おもい"],["も"],["しない"],["。"],["これ"],["また"],["空しく","むなしく"],["、"],["不幸","ふこう"],["な"],["こと"],["だ"],["。"]]},{"verse":9,"text":"ひとりよりもふたりが良い。共に労苦すれば、その報いは良い。","tok":[["ひとり"],["より"],["も"],["ふたり"],["が"],["良い","よい"],["。"],["共","とも"],["に"],["労苦","ろうく"],["すれば"],["、"],["その"],["報い","むくい"],["は"],["良い","よい"],["。"]]},{"verse":10,"text":"倒れれば、ひとりがその友を助け起こす。倒れても起こしてくれる友のない人は不幸だ。","tok":[["倒れれば","たおれれば"],["、"],["ひとり"],["が"],["その"],["友","とも"],["を"],["助け起こす","たすけおこす"],["。"],["倒れて","たおれて"],["も"],["起こして","おこして"],["くれる"],["友","とも"],["の"],["ない"],["人","ひと"],["は"],["不幸","ふこう"],["だ"],["。"]]},{"verse":11,"text":"更に、ふたりで寝れば暖かいがひとりでどうして暖まれようか。","tok":[["更に","さらに"],["、"],["ふたり"],["で"],["寝れば","ねれば"],["暖かい","あたたかい"],["が"],["ひとり"],["で"],["どう"],["して"],["暖まれよう","あたたまれよう"],["か"],["。"]]},{"verse":12,"text":"ひとりが攻められれば、ふたりでこれに対する。三つよりの糸は切れにくい。","tok":[["ひとり"],["が"],["攻められれば","せめられれば"],["、"],["ふたり"],["で"],["これ"],["に"],["対する","たいする"],["。"],["三","みっ"],["つ"],["より"],["の"],["糸","いと"],["は"],["切れ","きれ"],["にくい"],["。"]]},{"verse":13,"text":"貧しくても利口な少年の方が老いて愚かになり忠告を入れなくなった王よりも良い。","tok":[["貧しくて","まずしくて"],["も"],["利口","りこう"],["な"],["少年","しょうねん"],["の"],["方","ほう"],["が"],["老いて","おいて"],["愚か","おろか"],["に"],["なり"],["忠告","ちゅうこく"],["を"],["入れなく","いれなく"],["なった"],["王","おう"],["より"],["も"],["良い","よい"],["。"]]},{"verse":14,"text":"捕われの身分に生まれても王となる者があり王家に生まれながら、卑しくなる者がある。","tok":[["捕われ","とらわれ"],["の"],["身分","みぶん"],["に"],["生まれて","うまれて"],["も"],["王","おう"],["と"],["なる"],["者","もの"],["が"],["あり"],["王家","おうけ"],["に"],["生まれ","うまれ"],["ながら"],["、"],["卑しく","いやしく"],["なる"],["者","もの"],["が"],["ある"],["。"]]},{"verse":15,"text":"太陽の下、命あるもの皆が代わって立ったこの少年に味方するのをわたしは見た。","tok":[["太陽","たいよう"],["の"],["下","もと"],["、"],["命","いのち"],["ある"],["もの"],["皆","みな"],["が"],["代わって","かわって"],["立った","たった"],["この"],["少年","しょうねん"],["に"],["味方","みかた"],["する"],["の"],["を"],["わたし"],["は"],["見た","みた"],["。"]]},{"verse":16,"text":"民は限りなく続く。先立つ代にも、また後に来る代にもこの少年について喜び祝う者はない。これまた空しく、風を追うようなことだ。","tok":[["民","みん"],["は"],["限りなく","かぎりなく"],["続く","つづく"],["。"],["先立つ","さきだつ"],["代","だい"],["に"],["も"],["、"],["また"],["後","あと"],["に"],["来る","くる"],["代","だい"],["に"],["も"],["この"],["少年","しょうねん"],["について"],["喜び祝う","よろこびいわう"],["者","もの"],["は"],["ない"],["。"],["これ"],["また"],["空しく","むなしく"],["、"],["風","かぜ"],["を"],["追う","おう"],["よう"],["な"],["こと"],["だ"],["。"]]},{"verse":17,"text":"神殿に通う足を慎むがよい。悪いことをしても自覚しないような愚か者は供え物をするよりも、聞き従う方がよい。","tok":[["神殿","しんでん"],["に"],["通う","かよう"],["足","あし"],["を"],["慎む","つつしむ"],["が"],["よい"],["。"],["悪い","わるい"],["こと"],["を"],["して"],["も"],["自覚","じかく"],["しない"],["よう"],["な"],["愚か者","おろかもの"],["は"],["供え物","そなえもの"],["を"],["する"],["より"],["も"],["、"],["聞き従う","ききしたがう"],["方","かた"],["が"],["よい"],["。"]]}]
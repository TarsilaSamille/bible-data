[{"verse":1,"text":"青春の日々にこそ、お前の創造主に心を留めよ。苦しみの日々が来ないうちに。「年を重ねることに喜びはない」と言う年齢にならないうちに。","tok":[["青春","せいしゅん"],["の"],["日々","ひび"],["に"],["こそ"],["、"],["お前","おまえ"],["の"],["創造","そうぞう"],["主","しゅ"],["に"],["心","こころ"],["を"],["留めよ","とめよ"],["。"],["苦しみ","くるしみ"],["の"],["日々","ひび"],["が"],["来ない","こない"],["うち"],["に"],["。"],["「"],["年","ねん"],["を"],["重ねる","かさねる"],["こと"],["に"],["喜び","よろこび"],["は"],["ない"],["」"],["と"],["言う","いう"],["年齢","ねんれい"],["に"],["ならない"],["うち"],["に"],["。"]]},{"verse":2,"text":"太陽が闇に変わらないうちに。月や星の光がうせないうちに。雨の後にまた雲が戻って来ないうちに。","tok":[["太陽","たいよう"],["が"],["闇","やみ"],["に"],["変わらない","かわらない"],["うち"],["に"],["。"],["月","つき"],["や"],["星","ほし"],["の"],["光","ひかり"],["が"],["うせない"],["うち"],["に"],["。"],["雨","あめ"],["の"],["後","あと"],["に"],["また"],["雲","くも"],["が"],["戻って","もどって"],["来ない","こない"],["うち"],["に"],["。"]]},{"verse":3,"text":"その日には家を守る男も震え、力ある男も身を屈める。粉ひく女の数は減って行き、失われ窓から眺める女の目はかすむ。","tok":[["その"],["日","ひ"],["に"],["は"],["家","いえ"],["を"],["守る","まもる"],["男","おとこ"],["も"],["震え","ふるえ"],["、"],["力","ちから"],["ある"],["男","おとこ"],["も"],["身","み"],["を"],["屈める","かがめる"],["。"],["粉","こな"],["ひく"],["女","おんな"],["の"],["数","かず"],["は"],["減って","へって"],["行き","いき"],["、"],["失われ","うしなわれ"],["窓","まど"],["から"],["眺める","ながめる"],["女","おんな"],["の"],["目","め"],["は"],["かすむ"],["。"]]},{"verse":4,"text":"通りでは門が閉ざされ、粉ひく音はやむ。鳥の声に起き上がっても、歌の節は低くなる。","tok":[["通り","とおり"],["で"],["は"],["門","もん"],["が"],["閉ざされ","とざされ"],["、"],["粉","こな"],["ひく"],["音","おと"],["は"],["やむ"],["。"],["鳥","とり"],["の"],["声","こえ"],["に"],["起き上がって","おきあがって"],["も"],["、"],["歌","うた"],["の"],["節","ふし"],["は"],["低く","ひくく"],["なる"],["。"]]},{"verse":5,"text":"人は高いところを恐れ、道にはおののきがある。アーモンドの花は咲き、いなごは重荷を負いアビヨナは実をつける。人は永遠の家へ去り、泣き手は町を巡る。","tok":[["人","ひと"],["は"],["高い","たかい"],["ところ"],["を"],["恐れ","おそれ"],["、"],["道","みち"],["に"],["は"],["お"],["の"],["のき"],["が"],["ある"],["。"],["アーモンド"],["の"],["花","はな"],["は"],["咲き","さき"],["、"],["いなご"],["は"],["重荷","おもに"],["を"],["負い","おい"],["アビヨナ"],["は"],["実","じつ"],["を"],["つける"],["。"],["人","ひと"],["は"],["永遠","えいえん"],["の"],["家","いえ"],["へ"],["去り","さり"],["、"],["泣き","なき"],["手","て"],["は"],["町","まち"],["を"],["巡る","めぐる"],["。"]]},{"verse":6,"text":"白銀の糸は断たれ、黄金の鉢は砕ける。泉のほとりに壺は割れ、井戸車は砕けて落ちる。","tok":[["白銀","はくぎん"],["の"],["糸","いと"],["は"],["断たれ","たたれ"],["、"],["黄金","おうごん"],["の"],["鉢","ばち"],["は"],["砕ける","くだける"],["。"],["泉","いずみ"],["の"],["ほとり"],["に"],["壺","つぼ"],["は"],["割れ","われ"],["、"],["井戸車","いどぐるま"],["は"],["砕けて","くだけて"],["落ちる","おちる"],["。"]]},{"verse":7,"text":"塵は元の大地に帰り、霊は与え主である神に帰る。","tok":[["塵","ごみ"],["は"],["元","もと"],["の"],["大地","だいち"],["に"],["帰り","かえり"],["、"],["霊","れい"],["は"],["与え","あたえ"],["主","ぬし"],["で"],["ある"],["神","かみ"],["に"],["帰る","かえる"],["。"]]},{"verse":8,"text":"なんと空しいことか、とコヘレトは言う。すべては空しい、と。","tok":[["なん"],["と"],["空しい","むなしい"],["こと"],["か"],["、"],["と"],["コヘレト"],["は"],["言う","ゆう"],["。"],["すべて"],["は"],["空しい","むなしい"],["、"],["と"],["。"]]},{"verse":9,"text":"コヘレトは知恵を深めるにつれて、より良く民を教え、知識を与えた。多くの格言を吟味し、研究し、編集した。","tok":[["コヘレト"],["は"],["知恵","ちえ"],["を"],["深める","ふかめる"],["に"],["つれて"],["、"],["より"],["良く","よく"],["民","たみ"],["を"],["教え","おしえ"],["、"],["知識","ちしき"],["を"],["与えた","あたえた"],["。"],["多く","おおく"],["の"],["格言","かくげん"],["を"],["吟味","ぎんみ"],["し"],["、"],["研究","けんきゅう"],["し"],["、"],["編集","へんしゅう"],["した"],["。"]]},{"verse":10,"text":"コヘレトは望ましい語句を探し求め、真理の言葉を忠実に記録しようとした。","tok":[["コヘレト"],["は"],["望ましい","のぞましい"],["語句","ごく"],["を"],["探し求め","さがしもとめ"],["、"],["真理","しんり"],["の"],["言葉","ことば"],["を"],["忠実","ちゅうじつ"],["に"],["記録","きろく"],["しよう"],["と"],["した"],["。"]]},{"verse":11,"text":"賢者の言葉はすべて、突き棒や釘。ただひとりの牧者に由来し、収集家が編集した。","tok":[["賢者","けんじゃ"],["の"],["言葉","ことば"],["は"],["すべて"],["、"],["突き棒","つきぼう"],["や"],["釘","くぎ"],["。"],["ただ"],["ひとり"],["の"],["牧者","ぼくしゃ"],["に"],["由来","ゆらい"],["し"],["、"],["収集家","しゅうしゅうか"],["が"],["編集","へんしゅう"],["した"],["。"]]},{"verse":12,"text":"それらよりもなお、わが子よ、心せよ。書物はいくら記してもきりがない。学びすぎれば体が疲れる。","tok":[["それ"],["ら"],["より"],["も"],["なお"],["、"],["わが"],["子","こ"],["よ"],["、"],["心","こころ"],["せよ"],["。"],["書物","しょもつ"],["は"],["いくら"],["記して","しるして"],["も"],["きり"],["が"],["ない"],["。"],["学び","まなび"],["すぎれば"],["体","からだ"],["が"],["疲れる","つかれる"],["。"]]},{"verse":13,"text":"すべてに耳を傾けて得た結論。「神を畏れ、その戒めを守れ。」これこそ、人間のすべて。","tok":[["すべて"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["得た","えた"],["結論","けつろん"],["。"],["「"],["神","かみ"],["を"],["畏れ","おそれ"],["、"],["その"],["戒め","いましめ"],["を"],["守れ","まもれ"],["。"],["」"],["これ"],["こそ"],["、"],["人間","にんげん"],["の"],["すべて"],["。"]]},{"verse":14,"text":"神は、善をも悪をも一切の業を、隠れたこともすべて裁きの座に引き出されるであろう。","tok":[["神","かみ"],["は"],["、"],["善","ぜん"],["を"],["も"],["悪","あく"],["を"],["も"],["一切","いっさい"],["の"],["業","ごう"],["を"],["、"],["隠れた","かくれた"],["こと"],["も"],["すべて"],["裁き","さばき"],["の"],["座","ざ"],["に"],["引き出されるで","ひきだされるで"],["あろう"],["。"]]}]
,["に"],["僅か","わずか"],["の"],["住民","じゅうみん"],["が"],["いた"],["。"],["そこ"],["へ"],["強大","きょうだい"],["な"],["王","おう"],["が"],["攻めて","せめて"],["来て","きて"],["包囲","ほうい"],["し"],["、"],["大きな","おおきな"],["攻城","こうじょう"],["堡塁","ほうるい"],["を"],["築いた","きずいた"],["。"]]},{"verse":15,"text":"その町に一人の貧しい賢人がいて、知恵によって町を救った。しかし、貧しいこの人のことは、だれの口にものぼらなかった。","tok":[["その"],["町","まち"],["に"],["一人","ひとり"],["の"],["貧しい","まずしい"],["賢人","けんじん"],["が"],["いて"],["、"],["知恵","ちえ"],["によって"],["町","まち"],["を"],["救った","すくった"],["。"],["しかし"],["、"],["貧しい","まずしい"],["この"],["人","ひと"],["の"],["こと"],["は"],["、"],["だれ"],["の"],["口","くち"],["に"],["も"],["のぼらなかった"],["。"]]},{"verse":16,"text":"それで、わたしは言った。知恵は力にまさるというがこの貧しい人の知恵は侮られその言葉は聞かれない。","tok":[["それ"],["で"],["、"],["わたし"],["は"],["言った","いった"],["。"],["知恵","ちえ"],["は"],["力","ちから"],["に"],["まさる"],["と"],["いう"],["が"],["この"],["貧しい","まずしい"],["人","ひと"],["の"],["知恵","ちえ"],["は"],["侮られ","あなどられ"],["その"],["言葉","ことば"],["は"],["聞かれない","きかれない"],["。"]]},{"verse":17,"text":"支配者が愚か者の中で叫ぶよりは賢者の静かに説く言葉が聞かれるものだ。","tok":[["支配者","しはいしゃ"],["が"],["愚か者","おろかもの"],["の"],["中","なか"],["で"],["叫ぶ","さけぶ"],["より"],["は"],["賢者","けんじゃ"],["の"],["静か","しずか"],["に"],["説く","とく"],["言葉","ことば"],["が"],["聞かれる","きかれる"],["もの"],["だ"],["。"]]},{"verse":18,"text":"知恵は武器にまさる。一度の過ちは多くの善をそこなう。","tok":[["知恵","ちえ"],["は"],["武器","ぶき"],["に"],["まさる"],["。"],["一度","いちど"],["の"],["過ち","あやまち"],["は"],["多く","おおく"],["の"],["善","ぜん"],["を"],["そこなう"],["。"]]}]
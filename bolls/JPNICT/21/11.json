[{"verse":1,"text":"あなたのパンを水に浮かべて流すがよい。月日がたってから、それを見いだすだろう。","tok":[["あなた"],["の"],["パン"],["を"],["水","みず"],["に"],["浮かべて","うかべて"],["流す","ながす"],["が"],["よい"],["。"],["月日","つきひ"],["が"],["たって"],["から"],["、"],["それ"],["を"],["見いだすだろう","みいだすだろう"],["。"]]},{"verse":2,"text":"七人と、八人とすら、分かち合っておけ国にどのような災いが起こるか分かったものではない。","tok":[["七人","しちにん"],["と"],["、"],["八人","はちにん"],["と"],["すら"],["、"],["分かち合って","わかちあって"],["おけ"],["国","くに"],["に"],["どのような"],["災い","わざわい"],["が"],["起こる","おこる"],["か"],["分かった","わかった"],["もの"],["で"],["は"],["ない"],["。"]]},{"verse":3,"text":"雨が雲に満ちれば、それは地に滴る。南風に倒されても北風に倒されても木はその倒れたところに横たわる。","tok":[["雨","あめ"],["が"],["雲","くも"],["に"],["満ちれば","みちれば"],["、"],["それ"],["は"],["地","ち"],["に"],["滴る","したたる"],["。"],["南風","はえ"],["に"],["倒されて","たおされて"],["も"],["北風","きたかぜ"],["に"],["倒されて","たおされて"],["も"],["木","き"],["は"],["その"],["倒れた","たおれた"],["ところ"],["に"],["横たわる","よこたわる"],["。"]]},{"verse":4,"text":"風向きを気にすれば種は蒔けない。雲行きを気にすれば刈り入れはできない。","tok":[["風向き","かざむき"],["を"],["気","き"],["に"],["すれば"],["種","たね"],["は"],["蒔けない","まけない"],["。"],["雲行き","くもゆき"],["を"],["気","き"],["に"],["すれば"],["刈り入れ","かりいれ"],["は"],["できない"],["。"]]},{"verse":5,"text":"妊婦の胎内で霊や骨組がどの様になるのかも分からないのに、すべてのことを成し遂げられる神の業が分かるわけはない。","tok":[["妊婦","にんぷ"],["の"],["胎内","たいない"],["で"],["霊","れい"],["や"],["骨組","ほねぐみ"],["が"],["どの"],["様","よう"],["に"],["なる"],["の"],["か"],["も"],["分からない","わからない"],["のに"],["、"],["すべて"],["の"],["こと"],["を"],["成し遂げられる","なしとげられる"],["神","かみ"],["の"],["業","ごう"],["が"],["分かる","わかる"],["わけ"],["は"],["ない"],["。"]]},{"verse":6,"text":"朝、種を蒔け、夜にも手を休めるな。実を結ぶのはあれかこれかそれとも両方なのか、分からないのだから。","tok":[["朝","あさ"],["、"],["種","しゅ"],["を"],["蒔け","まけ"],["、"],["夜","よる"],["に"],["も"],["手","て"],["を"],["休める","やすめる"],["な"],["。"],["実","じつ"],["を"],["結ぶ","むすぶ"],["の"],["は"],["あれ"],["か"],["これ"],["か"],["それ"],["と"],["も"],["両方","りょうほう"],["な"],["の"],["か"],["、"],["分からない","わからない"],["の"],["だ"],["から"],["。"]]},{"verse":7,"text":"光は快く、太陽を見るのは楽しい。","tok":[["光","ひかり"],["は"],["快く","こころよく"],["、"],["太陽","たいよう"],["を"],["見る","みる"],["の"],["は"],["楽しい","たのしい"],["。"]]},{"verse":8,"text":"長生きし、喜びに満ちているときにも暗い日々も多くあろうことを忘れないように。何が来ようとすべて空しい。","tok":[["長生き","ながいき"],["し"],["、"],["喜び","よろこび"],["に"],["満ちて","みちて"],["いる"],["とき"],["に"],["も"],["暗い","くらい"],["日々","ひび"],["も"],["多く","おおく"],["あろう"],["こと"],["を"],["忘れない","わすれない"],["よう"],["に"],["。"],["何","なん"],["が"],["来よう","こよう"],["と"],["すべて"],["空しい","むなしい"],["。"]]},{"verse":9,"text":"若者よ、お前の若さを喜ぶがよい。青年時代を楽しく過ごせ。心にかなう道を、目に映るところに従って行け。知っておくがよい神はそれらすべてについてお前を裁きの座に連れて行かれると。","tok":[["若者","わかもの"],["よ"],["、"],["お前","おまえ"],["の"],["若","わか"],["さ"],["を"],["喜ぶ","よろこぶ"],["が"],["よい"],["。"],["青年","せいねん"],["時代","じだい"],["を"],["楽しく","たのしく"],["過ごせ","すごせ"],["。"],["心","こころ"],["に"],["かなう"],["道","みち"],["を"],["、"],["目","め"],["に"],["映る","うつる"],["ところ"],["に"],["従って","したがって"],["行け","いけ"],["。"],["知って","しって"],["おく"],["が"],["よい"],["神","かみ"],["は"],["それ"],["ら"],["すべて"],["について"],["お前","おまえ"],["を"],["裁き","さばき"],["の"],["座","ざ"],["に"],["連れて","つれて"],["行かれる","いかれる"],["と"],["。"]]},{"verse":10,"text":"心から悩みを去り、肉体から苦しみを除け。若さも青春も空しい。","tok":[["心","こころ"],["から"],["悩み","なやみ"],["を"],["去り","さり"],["、"],["肉体","にくたい"],["から"],["苦しみ","くるしみ"],["を"],["除け","よけ"],["。"],["若","わか"],["さ"],["も"],["青春","せいしゅん"],["も"],["空しい","むなしい"],["。"]]}]
[{"verse":1,"text":"エルサレムの王、ダビデの子、コヘレトの言葉。","tok":[["エルサレム"],["の"],["王","おう"],["、"],["ダビデ"],["の"],["子","こ"],["、"],["コヘレト"],["の"],["言葉","ことば"],["。"]]},{"verse":2,"text":"コヘレトは言う。なんという空しさなんという空しさ、すべては空しい。","tok":[["コヘレト"],["は"],["言う","ゆう"],["。"],["なん"],["と"],["いう"],["空し","むなし"],["さ"],["なん"],["と"],["いう"],["空し","むなし"],["さ"],["、"],["すべて"],["は"],["空しい","むなしい"],["。"]]},{"verse":3,"text":"太陽の下、人は労苦するがすべての労苦も何になろう。","tok":[["太陽","たいよう"],["の"],["下","もと"],["、"],["人","ひと"],["は"],["労苦","ろうく"],["する"],["が"],["すべて"],["の"],["労苦","ろうく"],["も"],["何","なん"],["に"],["なろう"],["。"]]},{"verse":4,"text":"一代過ぎればまた一代が起こり永遠に耐えるのは大地。","tok":[["一","いち"],["代","だい"],["過ぎれば","すぎれば"],["また"],["一","いち"],["代","だい"],["が"],["起こり","おこり"],["永遠","えいえん"],["に"],["耐える","たえる"],["の"],["は"],["大地","だいち"],["。"]]},{"verse":5,"text":"日は昇り、日は沈みあえぎ戻り、また昇る。","tok":[["日","ひ"],["は"],["昇り","のぼり"],["、"],["日","ひ"],["は"],["沈み","しずみ"],["あえぎ"],["戻り","もどり"],["、"],["また"],["昇る","のぼる"],["。"]]},{"verse":6,"text":"風は南に向かい北へ巡り、めぐり巡って吹き風はただ巡りつつ、吹き続ける。","tok":[["風","かぜ"],["は"],["南","みなみ"],["に"],["向かい","むかい"],["北","きた"],["へ"],["巡り","めぐり"],["、"],["めぐり巡って","めぐりめぐって"],["吹き","ふき"],["風","ふう"],["は"],["ただ"],["巡り","めぐり"],["つつ"],["、"],["吹き","ふき"],["続ける","つづける"],["。"]]},{"verse":7,"text":"川はみな海に注ぐが海は満ちることなくどの川も、繰り返しその道程を流れる。","tok":[["川","かわ"],["は"],["みな"],["海","うみ"],["に"],["注ぐ","そそぐ"],["が"],["海","うみ"],["は"],["満ちる","みちる"],["こと"],["なく"],["どの"],["川","かわ"],["も"],["、"],["繰り返し","くりかえし"],["その"],["道程","どうてい"],["を"],["流れる","ながれる"],["。"]]},{"verse":8,"text":"何もかも、もの憂い。語り尽くすこともできず目は見飽きることなく耳は聞いても満たされない。","tok":[["何","なん"],["も"],["か"],["も"],["、"],["もの憂い","ものうい"],["。"],["語り","かたり"],["尽くす","つくす"],["こと"],["も"],["できず"],["目","め"],["は"],["見飽きる","みあきる"],["こと"],["なく"],["耳","みみ"],["は"],["聞いて","きいて"],["も"],["満たされない","みたされない"],["。"]]},{"verse":9,"text":"かつてあったことは、これからもありかつて起こったことは、これからも起こる。太陽の下、新しいものは何ひとつない。","tok":[["かつて"],["あった"],["こと"],["は"],["、"],["これ"],["から"],["も"],["あり"],["かつて"],["起こった","おこった"],["こと"],["は"],["、"],["これ"],["から"],["も"],["起こる","おこる"],["。"],["太陽","たいよう"],
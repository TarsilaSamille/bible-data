[{"verse":1,"text":"御父がどれほどわたしたちを愛してくださるか、考えなさい。それは、わたしたちが神の子と呼ばれるほどで、事実また、そのとおりです。世がわたしたちを知らないのは、御父を知らなかったからです。","tok":[["御父","おちち"],["が"],["どれ"],["ほど"],["わたしたち"],["を"],["愛して","あいして"],["くださる"],["か"],["、"],["考え","かんがえ"],["なさい"],["。"],["それ"],["は"],["、"],["わたしたち"],["が"],["神","かみ"],["の"],["子","こ"],["と"],["呼ばれる","よばれる"],["ほど"],["で"],["、"],["事実","じじつ"],["また"],["、"],["その"],["とおり"],["です"],["。"],["世","よ"],["が"],["わたしたち"],["を"],["知らない","しらない"],["の"],["は"],["、"],["御父","おちち"],["を"],["知らなかった","しらなかった"],["から"],["です"],["。"]]},{"verse":2,"text":"愛する者たち、わたしたちは、今既に神の子ですが、自分がどのようになるかは、まだ示されていません。しかし、御子が現れるとき、御子に似た者となるということを知っています。なぜなら、そのとき御子をありのままに見るからです。","tok":[["愛する","あいする"],["者","もの"],["たち"],["、"],["わたしたち"],["は"],["、"],["今","いま"],["既に","すでに"],["神","かみ"],["の"],["子","こ"],["です"],["が"],["、"],["自分","じぶん"],["が"],["どの"],["よう"],["に"],["なる"],["か"],["は"],["、"],["まだ"],["示されて","しめされて"],["いません"],["。"],["しかし"],["、"],["御子","みこ"],["が"],["現れる","あらわれる"],["とき"],["、"],["御子","みこ"],["に"],["似た","にた"],["者","もの"],["と"],["なる"],["と"],["いう"],["こと"],["を"],["知って","しって"],["います"],["。"],["なぜ"],["なら"],["、"],["その"],["とき"],["御子","みこ"],["を"],["ありのまま"],["に"],["見る","みる"],["から"],["です"],["。"]]},{"verse":3,"text":"御子にこの望みをかけている人は皆、御子が清いように、自分を清めます。","tok":[["御子","みこ"],["に"],["この"],["望み","のぞみ"],["を"],["かけて"],["いる"],["人","ひと"],["は"],["皆","みな"],["、"],["御子","みこ"],["が"],["清い","きよい"],["よう"],["に"],["、"],["自分","じぶん"],["を"],["清めます","きよめます"],["。"]]},{"verse":4,"text":"罪を犯す者は皆、法にも背くのです。罪とは、法に背くことです。","tok":[["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["は"],["皆","みな"],["、"],["法","ほう"],["に"],["も"],["背く","そむく"],["の"],["です"],["。"],["罪","つみ"],["と"],["は"],["、"],["法","ほう"],["に"],["背く","そむく"],["こと"],["です"],["。"]]},{"verse":5,"text":"あなたがたも知っているように、御子は罪を除くために現れました。御子には罪がありません。","tok":[["あなた"],["がた"],["も"],["知って","しって"],["いる"],["よう"],["に"],["、"],["御子","みこ"],["は"],["罪","つみ"],["を"],["除く","のぞく"],["ため"],["に"],["現れました","あらわれました"],["。"],["御子","みこ"],["に"],["は"],["罪","つみ"],["が"],["ありません"],["。"]]},{"verse":6,"text":"御子の内にいつもいる人は皆、罪を犯しません。罪を犯す者は皆、御子を見たこともなく、知ってもいません。","tok":[["御子","みこ"],["の"],["内","うち"],["に"],["いつも"],["いる"],["人","ひと"],["は"],["皆","みな"],["、"],["罪","つみ"],["を"],["犯しません","おかしません"],["。"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["は"],["皆","みな"],["、"],["御子","みこ"],["を"],["見た","みた"],["こと"],["も"],["なく"],["、"],["知って","しって"],["も"],["いません"],["。"]]},{"verse":7,"text":"子たちよ、だれにも惑わされないようにしなさい。義を行う者は、御子と同じように、正しい人です。","tok":[["子","こ"],["たち"],["よ"],["、"],["だれ"],["に"],["も"],["惑わされない","まどわされない"],["よう"],["に"],["し"],["なさい"],["。"],["義","ぎ"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["御子","みこ"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["正しい","ただしい"],["人","ひと"],["です"],["。"]]},{"verse":8,"text":"罪を犯す者は悪魔に属します。悪魔は初めから罪を犯しているからです。悪魔の働きを滅ぼすためにこそ、神の子が現れたのです。","tok":[["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["は"],["悪魔","あくま"],["に"],["属します","ぞくします"],["。"],["悪魔","あくま"],["は"],["初め","はじめ"],["から"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["から"],["です"],["。"],["悪魔","あくま"],["の"],["働き","はたらき"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["こそ"],["、"],["神","かみ"],["の"],["子","こ"],["が"],["現れた","あらわれた"],["の"],["です"],["。"]]},{"verse":9,"text":"神から生まれた人は皆、罪を犯しません。神の種がこの人の内にいつもあるからです。この人は神から生まれたので、罪を犯すことができません。","tok":[["神","かみ"],["から"],["生まれた","うまれた"],["人","ひと"],["は"],["皆","みな"],["、"],["罪","つみ"],["を"],["犯しません","おかしません"],["。"],["神","かみ"],["の"],["種","たね"],["が"],["この"],["人","ひと"],["の"],["内","うち"],["に"],["いつも"],["ある"],["から"],["です"],["。"],["この"],["人","ひと"],["は"],["神","かみ"],["から"],["生まれた","うまれた"],["ので"],["、"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["が"],["できません"],["。"]]},{"verse":10,"text":"神の子たちと悪魔の子たちの区別は明らかです。正しい生活をしない者は皆、神に属していません。自分の兄弟を愛さない者も同様です。","tok":[["神","かみ"],["の"],["子","こ"],["たち"],["と"],["悪魔","あくま"],["の"],["子","こ"],["たち"],["の"],["区別","くべつ"],["は"],["明らか","あきらか"],["です"],["。"],["正しい","ただしい"],["生活","せいかつ"],["を"],["しない"],["者","もの"],["は"],["皆","みな"],["、"],["神","かみ"],["に"],["属して","ぞくして"],["いません"],["。"],["自分","じぶん"],["の"],["兄弟","きょうだい"],["を"],["愛さない","あいさない"],["者","もの"],["も"],["同様","どうよう"],["です"],["。"]]},{"verse":11,"text":"なぜなら、互いに愛し合うこと、これがあなたがたの初めから聞いている教えだから
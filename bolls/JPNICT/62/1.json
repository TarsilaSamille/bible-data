[{"verse":1,"text":"初めからあったもの、わたしたちが聞いたもの、目で見たもの、よく見て、手で触れたものを伝えます。すなわち、命の言について。――","tok":[["初め","はじめ"],["から"],["あった"],["もの"],["、"],["わたしたち"],["が"],["聞いた","きいた"],["もの"],["、"],["目","め"],["で"],["見た","みた"],["もの"],["、"],["よく"],["見て","みて"],["、"],["手","て"],["で"],["触れた","ふれた"],["もの"],["を"],["伝えます","つたえます"],["。"],["すなわち"],["、"],["命","いのち"],["の"],["言","げん"],["について"],["。"],["―"],["―"]]},{"verse":2,"text":"この命は現れました。御父と共にあったが、わたしたちに現れたこの永遠の命を、わたしたちは見て、あなたがたに証しし、伝えるのです。――","tok":[["この"],["命","いのち"],["は"],["現れました","あらわれました"],["。"],["御父","おちち"],["と"],["共","とも"],["に"],["あった"],["が"],["、"],["わたしたち"],["に"],["現れた","あらわれた"],["この"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["、"],["わたしたち"],["は"],["見て","みて"],["、"],["あなた"],["がた"],["に"],["証し","しょうし"],["し"],["、"],["伝える","つたえる"],["の"],["です"],["。"],["―"],["―"]]},{"verse":3,"text":"わたしたちが見、また聞いたことを、あなたがたにも伝えるのは、あなたがたもわたしたちとの交わりを持つようになるためです。わたしたちの交わりは、御父と御子イエス‧キリストとの交わりです。","tok":[["わたしたち"],["が"],["見","み"],["、"],["また"],["聞いた","きいた"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["も"],["伝える","つたえる"],["の"],["は"],["、"],["あなた"],["がた"],["も"],["わたしたち"],["と"],["の"],["交わり","まじわり"],["を"],["持つ","もつ"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["わたしたち"],["の"],["交わり","まじわり"],["は"],["、"],["御父","おちち"],["と"],["御子","みこ"],["イエス"],["‧"],["キリスト"],["と"],["の"],["交わり","まじわり"],["です"],["。"]]},{"verse":4,"text":"わたしたちがこれらのことを書くのは、わたしたちの喜びが満ちあふれるようになるためです。","tok":[["わたしたち"],["が"],["これ"],["ら"],["の"],["こと"],["を"],["書く","かく"],["の"],["は"],["、"],["わたしたち"],["の"],["喜び","よろこび"],["が"],["満ちあふれる","みちあふれる"],["よう"],["に"],["なる"],["ため"],["です"],["。"]]},{"verse":5,"text":"わたしたちがイエスから既に聞いていて、あなたがたに伝える知らせとは、神は光であり、神には闇が全くないということです。","tok":[["わたしたち"],["が"],["イエス"],["から"],["既に","すでに"],["聞いて","きいて"],["いて"],["、"],["あなた"],["がた"],["に"],["伝える","つたえる"],["知らせ","しらせ"],["と"],["は"],["、"],["神","かみ"],["は"],["光","ひかり"],["で"],["あり"],["、"],["神","かみ"],["に"],["は"],["闇","やみ"],["が"],["全く","まったく"],["ない"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":6,"text":"わたしたちが、神との交わりを持っていると言いながら、闇の中を歩むなら、それはうそをついているのであり、真理を行ってはいません。","tok":[["わたしたち"],["が"],["、"],["神","かみ"],["と"],["の"],["交わり","まじわり"],["を"],["持って","もって"],["いる"],["と"],["言い","いい"],["ながら"],["、"],["闇","やみ"],["の"],["中","なか"],["を"],["歩むなら","あゆむなら"],["、"],["それ"],["は"],["うそ"],["を"],["ついて"],["いる"],["ので"],["あり"],["、"],["真理","しんり"],["を"],["行って","おこなって"],["は"],["いません"],["。"]]},{"verse":7,"text":"しかし、神が光の中におられるように、わたしたちが光の中を歩むなら、互いに交わりを持ち、御子イエスの血によってあらゆる罪から清められます。","tok":[["しかし"],["、"],["神","かみ"],["が"],["光","ひかり"],["の"],["中","なか"],["に"],["おられる"],["よう"],["に"],["、"],["わたしたち"],["が"],["光","ひかり"],["の"],["中","なか"],["を"],["歩むなら","あゆむなら"],["、"],["互い","たがい"],["に"],["交わり","まじわり"],["を"],["持ち","もち"],["、"],["御子","みこ"],["イエス"],["の"],["血","ち"],["によって"],["あらゆる"],["罪","つみ"],["から"],["清められます","きよめられます"],["。"]]},{"verse":8,"text":"自分に罪がないと言うなら、自らを欺いており、真理はわたしたちの内にありません。","tok":[["自分","じぶん"],["に"],["罪","つみ"],["が"],["ない"],["と"],["言うなら","ゆうなら"],["、"],["自ら","みずから"],["を"],["欺いて","あざむいて"],["おり"],["、"],["真理","しんり"],["は"],["わたしたち"],["の"],["内","うち"],["に"],["ありません"],["。"]]},{"verse":9,"text":"自分の罪を公に言い表すなら、神は真実で正しい方ですから、罪を赦し、あらゆる不義からわたしたちを清めてくださいます。","tok":[["自分","じぶん"],["の"],["罪","つみ"],["を"],["公","おおやけ"],["に"],["言い表すなら","いいあらわすなら"],["、"],["神","かみ"],["は"],["真実","しんじつ"],["で"],["正しい","ただしい"],["方","ほう"],["です"],["から"],["、"],["罪","つみ"],["を"],["赦し","ゆるし"],["、"],["あらゆる"],["不義","ふぎ"],["から"],["わたしたち"],["を"],["清めて","きよめて"],["くださいます"],["。"]]},{"verse":10,"text":"罪を犯したことがないと言うなら、それは神を偽り者とすることであり、神の言葉はわたしたちの内にありません。","tok":[["罪","つみ"],["を"],["犯した","おかした"],["こと"],["が"],["ない"],["と"],["言うなら","ゆうなら"],["、"],["それ"],["は"],["神","かみ"],["を"],["偽り","いつわり"],["者","もの"],["と"],["する"],["こと"],["で"],["あり"],["、"],["神","かみ"],["の"],["言葉","ことば"],["は"],["わたしたち"],["の"],["内","うち"],["に"],["ありません"],["。"]]}]
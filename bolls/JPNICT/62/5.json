[{"verse":1,"text":"イエスがメシアであると信じる人は皆、神から生まれた者です。そして、生んでくださった方を愛する人は皆、その方から生まれた者をも愛します。","tok":[["イエス"],["が"],["メシア"],["で"],["ある"],["と"],["信じる","しんじる"],["人","ひと"],["は"],["皆","みな"],["、"],["神","かみ"],["から"],["生まれた","うまれた"],["者","もの"],["です"],["。"],["そして"],["、"],["生んで","うんで"],["くださった"],["方","ほう"],["を"],["愛する","あいする"],["人","ひと"],["は"],["皆","みな"],["、"],["その"],["方","かた"],["から"],["生まれた","うまれた"],["者","もの"],["を"],["も"],["愛します","あいします"],["。"]]},{"verse":2,"text":"このことから明らかなように、わたしたちが神を愛し、その掟を守るときはいつも、神の子供たちを愛します。","tok":[["この"],["こと"],["から"],["明らか","あきらか"],["な"],["よう"],["に"],["、"],["わたしたち"],["が"],["神","かみ"],["を"],["愛し","あいし"],["、"],["その"],["掟","おきて"],["を"],["守る","まもる"],["とき"],["は"],["いつも"],["、"],["神","かみ"],["の"],["子供","こども"],["たち"],["を"],["愛します","あいします"],["。"]]},{"verse":3,"text":"神を愛するとは、神の掟を守ることです。神の掟は難しいものではありません。","tok":[["神","かみ"],["を"],["愛する","あいする"],["と"],["は"],["、"],["神","かみ"],["の"],["掟","おきて"],["を"],["守る","まもる"],["こと"],["です"],["。"],["神","かみ"],["の"],["掟","おきて"],["は"],["難しい","むずかしい"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":4,"text":"神から生まれた人は皆、世に打ち勝つからです。世に打ち勝つ勝利、それはわたしたちの信仰です。","tok":[["神","かみ"],["から"],["生まれた","うまれた"],["人","ひと"],["は"],["皆","みな"],["、"],["世","よ"],["に"],["打ち勝つ","うちかつ"],["から"],["です"],["。"],["世","よ"],["に"],["打ち勝つ","うちかつ"],["勝利","しょうり"],["、"],["それ"],["は"],["わたしたち"],["の"],["信仰","しんこう"],["です"],["。"]]},{"verse":5,"text":"だれが世に打ち勝つか。イエスが神の子であると信じる者ではありませんか。","tok":[["だれ"],["が"],["世","よ"],["に"],["打ち勝つ","うちかつ"],["か"],["。"],["イエス"],["が"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["と"],["信じる","しんじる"],["者","もの"],["で"],["は"],["ありません"],["か"],["。"]]},{"verse":6,"text":"この方は、水と血を通って来られた方、イエス‧キリストです。水だけではなく、水と血とによって来られたのです。そして、“霊”はこのことを証しする方です。“霊”は真理だからです。","tok":[["この"],["方","かた"],["は"],["、"],["水","みず"],["と"],["血","ち"],["を"],["通って","とおって"],["来られた","こられた"],["方","かた"],["、"],["イエス"],["‧"],["キリスト"],["です"],["。"],["水","みず"],["だけ"],["で"],["は"],["なく"],["、"],["水","みず"],["と"],["血","ち"],["と"],["によって"],["来られた","こられた"],["の"],["です"],["。"],["そして"],["、"],["“"],["霊","れい"],["”"],["は"],["この"],["こと"],["を"],["証し","あかし"],["する"],["方","ほう"],["です"],["。"],["“"],["霊","れい"],["”"],["は"],["真理","しんり"],["だ"],["から"],["です"],["。"]]},{"verse":7,"text":"証しするのは三者で、","tok":[["証し","あかし"],["する"],["の"],["は"],["三者","さんしゃ"],["で"],["、"]]},{"verse":8,"text":"“霊”と水と血です。この三者は一致しています。","tok":[["“"],["霊","れい"],["”"],["と"],["水","みず"],["と"],["血","ち"],["です"],["。"],["この"],["三者","さんしゃ"],["は"],["一致","いっち"],["して"],["います"],["。"]]},{"verse":9,"text":"わたしたちが人の証しを受け入れるのであれば、神の証しは更にまさっています。神が御子についてなさった証し、これが神の証しだからです。","tok":[["わたしたち"],["が"],["人","ひと"],["の"],["証し","あかし"],["を"],["受け入れる","うけいれる"],["ので"],["あれば"],["、"],["神","かみ"],["の"],["証し","あかし"],["は"],["更に","さらに"],["まさって"],["います"],["。"],["神","かみ"],["が"],["御子","みこ"],["について"],["なさった"],["証し","あかし"],["、"],["これ"],["が"],["神","かみ"],["の"],["証し","あかし"],["だ"],["から"],["です"],["。"]]},{"verse":10,"text":"神の子を信じる人は、自分の内にこの証しがあり、神を信じない人は、神が御子についてなさった証しを信じていないため、神を偽り者にしてしまっています。","tok":[["神","かみ"],["の"],["子","こ"],["を"],["信じる","しんじる"],["人","ひと"],["は"],["、"],["自分","じぶん"],["の"],["内","うち"],["に"],["この"],["証し","あかし"],["が"],["あり"],["、"],["神","かみ"],["を"],["信じない","しんじない"],["人","ひと"],["は"],["、"],["神","かみ"],["が"],["御子","みこ"],["について"],["なさった"],["証し","あかし"],["を"],["信じて","しんじて"],["いない"],["ため"],["、"],["神","かみ"],["を"],["偽り者","いつわりしゃ"],["に"],["して"],["しまって"],["います"],["。"]]},{"verse":11,"text":"その証しとは、神が永遠の命をわたしたちに与えられたこと、そして、この命が御子の内にあるということです。","tok":[["その"],["証し","あかし"],["と"],["は"],["、"],["神","かみ"],["が"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["わたしたち"],["に"],["与えられた","あたえられた"],["こと"],["、"],["そして"],["、"],["この"],["命","いのち"],["が"],["御子","みこ"],["の"],["内","うち"],["に"],["ある"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":12,"text":"御子と結ばれている人にはこの命があり、神の子と結ばれていない人にはこの命がありません。","tok":[["御子","みこ"],["と"],["結ばれて","むすばれて"],["いる"],["人","ひと"],["に"],["は"],["この"],["命","いのち"],["が"],["あり"],["、"],["神","かみ"],["の"],["子","こ"],["と"],["結ばれて","むすばれて"],["いない"],["人","ひと"],["に"],["は"],["この"],["命","いのち"],["が"],["ありません"],["。"]]},{"verse":13,"text":"神の子の名を信じているあなたがたに、これらのことを書き送るのは、永遠の命を得ていることを悟らせたいからです。","tok":[["神","かみ"],["の"],["子","こ"],["の"],["名","な"],["を"],["信じて","しんじて"],["いる"],["あなた"],["がた"],["に"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["書き送る","かきおくる"],["の"],["は"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得て","えて"],["いる"],["こと"],["を"],["悟らせたい","さとらせたい"],["から"],["です"],["。"]]},{"verse":14,"text":"何事でも神の御心に適うことをわたしたちが願うなら、神は聞き入れてくださる。これが神に対するわたしたちの確信です。","tok":[["何事","なにごと"],["で"],["も"],["神","かみ"],["の"],["御心","おこころ"],["に"],["適う","かなう"],["こと"],["を"],["わたしたち"],["が"],["願うなら","ねがうなら"],["、"],["神","かみ"],["は"],["聞き入れて","ききいれて"],["くださる"],["。"],["これ"],["が"],["神","かみ"],["に"],["対する","たいする"],["わたしたち"],["の"],["確信","かくしん"],["です"],["。"]]},{"verse":15,"text":"わたしたちは、願い事は何でも聞き入れてくださるということが分かるなら、神に願ったことは既にかなえられていることも分かります。","tok":[["わたしたち"],["は"],["、"],["願い事","ねがいごと"],["は"],["何","なん"],["で"],["も"],["聞き入れて","ききいれて"],["くださる"],["と"],["いう"],["こと"],["が"],["分かるなら","わかるなら"],["、"],["神","かみ"],["に"],["願った","ねがった"],["こと"],["は"],["既に","すでに"],["かなえられて"],["いる"],["こと"],["も"],["分かります","わかります"],["。"]]},{"verse":16,"text":"死に至らない罪を犯している兄弟を見たら、その人のために神に願いなさい。そうすれば、神はその人に命をお与えになります。これは、死に至らない罪を犯している人々の場合です。死に至る罪があります。これについては、神に願うようにとは言いません。","tok":[["死","し"],["に"],["至らない","いたらない"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["兄弟","きょうだい"],["を"],["見たら","みたら"],["、"],["その"],["人","ひと"],["の"],["ため"],["に"],["神","かみ"],["に"],["願い","ねがい"],["なさい"],["。"],["そう"],["すれば"],["、"],["神","かみ"],["は"],["その"],["人","ひと"],["に"],["命","いのち"],["を"],["お与え","おあたえ"],["に"],["なります"],["。"],["これ"],["は"],["、"],["死","し"],["に"],["至らない","いたらない"],["罪","つみ"],["を"],["犯して","おかして"],["いる"],["人々","ひとびと"],["の"],["場合","ばあい"],["です"],["。"],["死","し"],["に"],["至る","いたる"],["罪","つみ"],["が"],["あります"],["。"],["これ"],["について"],["は"],["、"],["神","かみ"],["に"],["願う","ねがう"],["よう"],["に"],["と"],["は"],["言いません","いいません"],["。"]]},{"verse":17,"text":"不義はすべて罪です。しかし、死に至らない罪もあります。","tok":[["不義","ふぎ"],["は"],["すべて"],["罪","つみ"],["です"],["。"],["しかし"],["、"],["死","し"],["に"],["至らない","いたらない"],["罪","つみ"],["も"],["あります"],["。"]]},{"verse":18,"text":"わたしたちは知っています。すべて神から生まれた者は罪を犯しません。神からお生まれになった方が、その人を守ってくださり、悪い者は手を触れることができません。","tok":[["わたしたち"],["は"],["知って","しって"],["います"],["。"],["すべて"],["神","かみ"],["から"],["生まれた","うまれた"],["者","もの"],["は"],["罪","つみ"],["を"],["犯しません","おかしません"],["。"],["神","かみ"],["から"],["お生まれ","おうまれ"],["に"],["なった"],["方","ほう"],["が"],["、"],["その"],["人","ひと"],["を"],["守って","まもって"],["くださり"],["、"],["悪い","わるい"],["者","もの"],["は"],["手","て"],["を"],["触れる","ふれる"],["こと"],["が"],["できません"],["。"]]},{"verse":19,"text":"わたしたちは知っています。わたしたちは神に属する者ですが、この世全体が悪い者の支配下にあるのです。","tok":[["わたしたち"],["は"],["知って","しって"],["います"],["。"],["わたしたち"],["は"],["神","かみ"],["に"],["属する","ぞくする"],["者","もの"],["です"],["が"],["、"],["この世","このよ"],["全体","ぜんたい"],["が"],["悪い","わるい"],["者","もの"],["の"],["支配下","しはいか"],["に"],["ある"],["の"],["です"],["。"]]},{"verse":20,"text":"わたしたちは知っています。神の子が来て、真実な方を知る力を与えてくださいました。わたしたちは真実な方の内に、その御子イエス‧キリストの内にいるのです。この方こそ、真実の神、永遠の命です。","tok":[["わたしたち"],["は"],["知って","しって"],["います"],["。"],["神","かみ"],["の"],["子","こ"],["が"],["来て","きて"],["、"],["真実","しんじつ"],["な"],["方","ほう"],["を"],["知る","しる"],["力","ちから"],["を"],["与えて","あたえて"],["くださいました"],["。"],["わたしたち"],["は"],["真実","しんじつ"],["な"],["方","ほう"],["の"],["内","うち"],["に"],["、"],["その"],["御子","みこ"],["イエス"],["‧"],["キリスト"],["の"],["内","うち"],["に"],["いる"],["の"],["です"],["。"],["この"],["方","かた"],["こそ"],["、"],["真実","しんじつ"],["の"],["神","かみ"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["です"],["。"]]},{"verse":21,"text":"子たちよ、偶像を避けなさい。","tok":[["子","こ"],["たち"],["よ"],["、"],["偶像","ぐうぞう"],["を"],["避け","さけ"],["なさい"],["。"]]}]
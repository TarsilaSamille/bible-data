[{"verse":1,"text":"わたしの子たちよ、これらのことを書くのは、あなたがたが罪を犯さないようになるためです。たとえ罪を犯しても、御父のもとに弁護者、正しい方、イエス‧キリストがおられます。","tok":[["わたし"],["の"],["子","こ"],["たち"],["よ"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["書く","かく"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["罪","つみ"],["を"],["犯さない","おかさない"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["たとえ"],["罪","つみ"],["を"],["犯して","おかして"],["も"],["、"],["御父","おちち"],["の"],["もと"],["に"],["弁護者","べんごしゃ"],["、"],["正しい","ただしい"],["方","ほう"],["、"],["イエス"],["‧"],["キリスト"],["が"],["おられます"],["。"]]},{"verse":2,"text":"この方こそ、わたしたちの罪、いや、わたしたちの罪ばかりでなく、全世界の罪を償ういけにえです。","tok":[["この"],["方","かた"],["こそ"],["、"],["わたしたち"],["の"],["罪","つみ"],["、"],["いや"],["、"],["わたしたち"],["の"],["罪","つみ"],["ばかり"],["で"],["なく"],["、"],["全","ぜん"],["世界","せかい"],["の"],["罪","つみ"],["を"],["償う","つぐなう"],["いけにえ"],["です"],["。"]]},{"verse":3,"text":"わたしたちは、神の掟を守るなら、それによって、神を知っていることが分かります。","tok":[["わたしたち"],["は"],["、"],["神","かみ"],["の"],["掟","おきて"],["を"],["守るなら","まもるなら"],["、"],["それ"],["によって"],["、"],["神","かみ"],["を"],["知って","しって"],["いる"],["こと"],["が"],["分かります","わかります"],["。"]]},{"verse":4,"text":"「神を知っている」と言いながら、神の掟を守らない者は、偽り者で、その人の内には真理はありません。","tok":[["「"],["神","かみ"],["を"],["知って","しって"],["いる"],["」"],["と"],["言い","いい"],["ながら"],["、"],["神","かみ"],["の"],["掟","おきて"],["を"],["守らない","まもらない"],["者","もの"],["は"],["、"],["偽り者","いつわりしゃ"],["で"],["、"],["その"],["人","ひと"],["の"],["内","うち"],["に"],["は"],["真理","しんり"],["は"],["ありません"],["。"]]},{"verse":5,"text":"しかし、神の言葉を守るなら、まことにその人の内には神の愛が実現しています。これによって、わたしたちが神の内にいることが分かります。","tok":[["しかし"],["、"],["神","かみ"],["の"],["言葉","ことば"],["を"],["守るなら","まもるなら"],["、"],["まこと"],["に"],["その"],["人","ひと"],["の"],["内","うち"],["に"],["は"],["神","かみ"],["の"],["愛","あい"],["が"],["実現","じつげん"],["して"],["います"],["。"],["これ"],["によって"],["、"],["わたしたち"],["が"],["神","かみ"],["の"],["内","うち"],["に"],["いる"],["こと"],["が"],["分かります","わかります"],["。"]]},{"verse":6,"text":"神の内にいつもいると言う人は、イエスが歩まれたように自らも歩まなければなりません。","tok":[["神","かみ"],["の"],["内","うち"],["に"],["いつも"],["いる"],["と"],["言う","いう"],["人","ひと"],["は"],["、"],["イエス"],["が"],["歩まれた","あゆまれた"],["よう"],["に"],["自ら
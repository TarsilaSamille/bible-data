書いているのは、イエスの名によってあなたがたの罪が赦されているからである。","tok":[["子","こ"],["たち"],["よ"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["の"],["は"],["、"],["イエス"],["の"],["名","な"],["によって"],["あなた"],["がた"],["の"],["罪","つみ"],["が"],["赦されて","ゆるされて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":13,"text":"父たちよ、わたしがあなたがたに書いているのは、あなたがたが、初めから存在なさる方を知っているからである。若者たちよ、わたしがあなたがたに書いているのは、あなたがたが悪い者に打ち勝ったからである。","tok":[["父","ちち"],["たち"],["よ"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["の"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["初め","はじめ"],["から"],["存在","そんざい"],["なさる"],["方","かた"],["を"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"],["若者","わかもの"],["たち"],["よ"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["悪い","わるい"],["者","もの"],["に"],["打ち勝った","うちかった"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"子供たちよ、わたしがあなたがたに書いているのは、あなたがたが御父を知っているからである。父たちよ、わたしがあなたがたに書いているのは、あなたがたが、初めから存在なさる方を知っているからである。若者たちよ、わたしがあなたがたに書いているのは、あなたがたが強く、神の言葉があなたがたの内にいつもあり、あなたがたが悪い者に打ち勝ったからである。","tok":[["子供","こども"],["たち"],["よ"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["御父","おちち"],["を"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"],["父","ちち"],["たち"],["よ"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["の"],["は"],["、"],["あなた"],["が"],["た"],["が"],["、"],["初め","はじめ"],["から"],["存在","そんざい"],["なさる"],["方","かた"],["を"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"],["若者","わかもの"],["たち"],["よ"],["、"],["わたし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["強く","つよく"],["、"],["神","かみ"],["の"],["言葉","ことば"],["が"],["あなた"],["がた"],["の"],["内","うち"],["に"],["いつも"],["あり"],["、"],["あなた"],["がた"],["が"],["悪い","わるい"],["者","もの"],["に"],["打ち勝った","うちかった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"世も世にあるものも、愛してはいけません。世を愛する人がいれば、御父への愛はその人の内にありません。","tok":[["世","よ"],["も"],["世","よ"],["に"],["ある"],["もの"],["も"],["、"],["愛して","あいして"],["は"],["いけません"],["。"],["世","よ"],["を"],["愛する","あいする"],["人","ひと"],["が"],["いれば"],["、"],["御父","おちち"],["へ"],["の"],["愛","あい"],["は"],["その"],["人","ひと"],["の"],["内","うち"],["に"],["ありません"],["。"]]},{"verse":16,"text":"なぜなら、すべて世にあるもの、肉の欲、目の欲、生活のおごりは、御父から出ないで、世から出るからです。","tok":[["なぜ"],["なら"],["、"],["すべて"],["世","よ"],["に"],["ある"],["もの"],["、"],["肉","にく"],["の"],["欲","よく"],["、"],["目","め"],["の"],["欲","よく"],["、"],["生活","せいかつ"],["の"],["おごり"],["は"],["、"],["御父","おちち"],["から"],["出ないで","でないで"],["、"],["世","よ"],["から"],["出る","でる"],["から"],["です"],["。"]]},{"verse":17,"text":"世も世にある欲も、過ぎ去って行きます。しかし、神の御心を行う人は永遠に生き続けます。","tok":[["世","よ"],["も"],["世","よ"],["に"],["ある"],["欲","よく"],["も"],["、"],["過ぎ去って","すぎさって"],["行きます","いきます"],["。"],["しかし"],["、"],["神","かみ"],["の"],["御心","おこころ"],["を"],["行う","おこなう"],["人","ひと"],["は"],["永遠","えいえん"],["に"],["生き","いき"],["続けます","つづけます"],["。"]]},{"verse":18,"text":"子供たちよ、終わりの時が来ています。反キリストが来ると、あなたがたがかねて聞いていたとおり、今や多くの反キリストが現れています。これによって、終わりの時が来ていると分かります。","tok":[["子供","こども"],["たち"],["よ"],["、"],["終わり","おわり"],["の"],["時","とき"],["が"],["来て","きて"],["います"],["。"],["反","はん"],["キリスト"],["が"],["来る","くる"],["と"],["、"],["あなた"],["がた"],["が"],["かねて"],["聞いて","きいて"],["いた"],["とおり"],["、"],["今","いま"],["や"],["多く","おおく"],["の"],["反","はん"],["キリスト"],["が"],["現れて","あらわれて"],["います"],["。"],["これ"],["によって"],["、"],["終わり","おわり"],["の"],["時","とき"],["が"],["来て","きて"],["いる"],["と"],["分かります","わかります"],["。"]]},{"verse":19,"text":"彼らはわたしたちから去って行きましたが、もともと仲間ではなかったのです。仲間なら、わたしたちのもとにとどまっていたでしょう。しかし去って行き、だれもわたしたちの仲間ではないことが明らかになりました。","tok":[["彼","かれ"],["ら"],["は"],["わたしたち"],["から"],["去って","さって"],["行きました","いきました"],["が"],["、"],["もともと"],["仲間","なかま"],["で"],["は"],["なかった"],["の"],["です"],["。"],["仲間","なかま"],["なら"],["、"],["わたしたち"],["の"],["もと"],["に"],["とどまって"],["いたでしょう"],["。"],["しかし"],["去って","さって"],["行き","いき"],["、"],["だれ"],["も"],["わたしたち"],["の"],["仲間","なかま"],["で"],["は"],["ない"],["こと"],["が"],["明らか","あきらか"],["に"],["なりました"],["。"]]},{"verse":20,"text":"しかし、あなたがたは聖なる方から油を注がれているので、皆、真理を知っています。","tok":[["しかし"],["、"],["あなた"],["がた"],["は"],["聖","せい"],["なる"],["方","かた"],["から"],["油","あぶら"],["を"],["注がれて","そそがれて"],["いる"],["ので"],["、"],["皆","みな"],["、"],["真理","しんり"],["を"],["知って","しって"],["います"],["。"]]},{"verse":21,"text":"わたしがあなたがたに書いているのは、あなたがたが真理を知らないからではなく、真理を知り、また、すべて偽りは真理から生じないことを知っているからです。","tok":[["わたし"],["が"],["あなた"],["がた"],["に"],["書いて","かいて"],["いる"],["の"],["は"],["、"],["あなた"],["がた"],["が"],["真理","しんり"],["を"],["知らない","しらない"],["から"],["で"],["は"],["なく"],["、"],["真理","しんり"],["を"],["知り","しり"],["、"],["また"],["、"],["すべて"],["偽り","いつわり"],["は"],["真理","しんり"],["から"],["生じない","しょうじない"],["こと"],["を"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":22,"text":"偽り者とは、イエスがメシアであることを否定する者でなくて、だれでありましょう。御父と御子を認めない者、これこそ反キリストです。","tok":[["偽り者","いつわりしゃ"],["と"],["は"],["、"],["イエス"],["が"],["メシア"],["で"],["ある"],["こと"],["を"],["否定","ひてい"],["する"],["者","もの"],["で"],["なくて"],["、"],["だれ"],["で"],["ありましょう"],["。"],["御父","おちち"],["と"],["御子","みこ"],["を"],["認めない","みとめない"],["者","もの"],["、"],["これ"],["こそ"],["反","はん"],["キリスト"],["です"],["。"]]},{"verse":23,"text":"御子を認めない者はだれも、御父に結ばれていません。御子を公に言い表す者は、御父にも結ばれています。","tok":[["御子","みこ"],["を"],["認めない","みとめない"],["者","もの"],["は"],["だれ"],["も"],["、"],["御父","おちち"],["に"],["結ばれて","むすばれて"],["いません"],["。"],["御子","みこ"],["を"],["公","おおやけ"],["に"],["言い表す","いいあらわす"],["者","もの"],["は"],["、"],["御父","おちち"],["に"],["も"],["結ばれて","むすばれて"],["います"],["。"]]},{"verse":24,"text":"初めから聞いていたことを、心にとどめなさい。初めから聞いていたことが、あなたがたの内にいつもあるならば、あなたがたも御子の内に、また御父の内にいつもいるでしょう。","tok":[["初め","はじめ"],["から"],["聞いて","きいて"],["いた"],["こと"],["を"],["、"],["心","こころ"],["に"],["とどめ"],["なさい"],["。"],["初め","はじめ"],["から"],["聞いて","きいて"],["いた"],["こと"],["が"],["、"],["あなた"],["がた"],["の"],["内","うち"],["に"],["いつも"],["あるならば"],["、"],["あなた"],["がた"],["も"],["御子","みこ"],["の"],["内","うち"],["に"],["、"],["また"],["御父","おちち"],["の"],["内","うち"],["に"],["いつも"],["いるでしょう"],["。"]]},{"verse":25,"text":"これこそ、御子がわたしたちに約束された約束、永遠の命です。","tok":[["これ"],["こそ"],["、"],["御子","みこ"],["が"],["わたしたち"],["に"],["約束","やくそく"],["された"],["約束","やくそく"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["です"],["。"]]},{"verse":26,"text":"以上、あなたがたを惑わせようとしている者たちについて書いてきました。","tok":[["以上","いじょう"],["、"],["あなた"],["がた"],["を"],["惑わせよう","まどわせよう"],["として"],["いる"],["者","もの"],["たち"],["について"],["書いて","かいて"],["きました"],["。"]]},{"verse":27,"text":"しかし、いつもあなたがたの内には、御子から注がれた油がありますから、だれからも教えを受ける必要がありません。この油が万事について教えます。それは真実であって、偽りではありません。だから、教えられたとおり、御子の内にとどまりなさい。","tok":[["しかし"],["、"],["いつも"],["あなた"],["がた"],["の"],["内","うち"],["に"],["は"],["、"],["御子","みこ"],["から"],["注がれた","そそがれた"],["油","あぶら"],["が"],["あります"],["から"],["、"],["だれ"],["から"],["も"],["教え","おしえ"],["を"],["受ける","うける"],["必要","ひつよう"],["が"],["ありません"],["。"],["この"],["油","あぶら"],["が"],["万事","ばんじ"],["について"],["教えます","おしえます"],["。"],["それ"],["は"],["真実","しんじつ"],["で"],["あって"],["、"],["偽り","いつわり"],["で"],["は"],["ありません"],["。"],["だ"],["から"],["、"],["教えられた","おしえられた"],["とおり"],["、"],["御子","みこ"],["の"],["内","うち"],["に"],["とどまり"],["なさい"],["。"]]},{"verse":28,"text":"さて、子たちよ、御子の内にいつもとどまりなさい。そうすれば、御子の現れるとき、確信を持つことができ、御子が来られるとき、御前で恥じ入るようなことがありません。","tok":[["さて"],["、"],["子","こ"],["たち"],["よ"],["、"],["御子","みこ"],["の"],["内","うち"],["に"],["いつも"],["とどまり"],["なさい"],["。"],["そう"],["すれば"],["、"],["御子","みこ"],["の"],["現れる","あらわれる"],["とき"],["、"],["確信","かくしん"],["を"],["持つ","もつ"],["こと"],["が"],["でき"],["、"],["御子","みこ"],["が"],["来られる","こられる"],["とき"],["、"],["御前","ごぜん"],["で"],["恥じ入る","はじいる"],["よう"],["な"],["こと"],["が"],["ありません"],["。"]]},{"verse":29,"text":"あなたがたは、御子が正しい方だと知っているなら、義を行う者も皆、神から生まれていることが分かるはずです。","tok":[["あなた"],["がた"],["は"],["、"],["御子","みこ"],["が"],["正しい","ただしい"],["方","ほう"],["だ"],["と"],["知って","しって"],["いるなら"],["、"],["義","ぎ"],["を"],["行う","おこなう"],["者","もの"],["も"],["皆","みな"],["、"],["神","かみ"],["から"],["生まれて","うまれて"],["いる"],["こと"],["が"],["分かる","わかる"],["はず"],["です"],["。"]]}]
[{"verse":1,"text":"愛する者たち、どの霊も信じるのではなく、神から出た霊かどうかを確かめなさい。偽預言者が大勢世に出て来ているからです。","tok":[["愛する","あいする"],["者","もの"],["たち"],["、"],["どの"],["霊","れい"],["も"],["信じる","しんじる"],["ので"],["は"],["なく"],["、"],["神","かみ"],["から"],["出た","でた"],["霊","れい"],["か"],["どう"],["か"],["を"],["確かめ","たしかめ"],["なさい"],["。"],["偽","にせ"],["預言者","よげんしゃ"],["が"],["大勢世","たいせいせい"],["に"],["出て","でて"],["来て","きて"],["いる"],["から"],["です"],["。"]]},{"verse":2,"text":"イエス‧キリストが肉となって来られたということを公に言い表す霊は、すべて神から出たものです。このことによって、あなたがたは神の霊が分かります。","tok":[["イエス"],["‧"],["キリスト"],["が"],["肉","にく"],["と"],["なって"],["来られた","こられた"],["と"],["いう"],["こと"],["を"],["公","おおやけ"],["に"],["言い表す","いいあらわす"],["霊","れい"],["は"],["、"],["すべて"],["神","かみ"],["から"],["出た","でた"],["もの"],["です"],["。"],["この"],["こと"],["によって"],["、"],["あなた"],["がた"],["は"],["神","かみ"],["の"],["霊","れい"],["が"],["分かります","わかります"],["。"]]},{"verse":3,"text":"イエスのことを公に言い表さない霊はすべて、神から出ていません。これは、反キリストの霊です。かねてあなたがたは、その霊がやって来ると聞いていましたが、今や既に世に来ています。","tok":[["イエス"],["の"],["こと"],["を"],["公","おおやけ"],["に"],["言い表さない","いいあらわさない"],["霊","れい"],["は"],["すべて"],["、"],["神","かみ"],["から"],["出て","でて"],["いません"],["。"],["これ"],["は"],["、"],["反","はん"],["キリスト"],["の"],["霊","れい"],["です"],["。"],["かねて"],["あなた"],["がた"],["は"],["、"],["その"],["霊","れい"],["が"],["やって"],["来る","くる"],["と"],["聞いて","きいて"],["いました"],["が"],["、"],["今","いま"],["や"],["既に","すでに"],["世","よ"],["に"],["来て","きて"],["います"],["。"]]},{"verse":4,"text":"子たちよ、あなたがたは神に属しており、偽預言者たちに打ち勝ちました。なぜなら、あなたがたの内におられる方は、世にいる者よりも強いからです。","tok":[["子","こ"],["たち"],["よ"],["、"],["あなた"],["がた"],["は"],["神","かみ"],["に"],["属して","ぞくして"],["おり"],["、"],["偽","にせ"],["預言者","よげんしゃ"],["たち"],["に"],["打ち勝ちました","うちかちました"],["。"],["なぜ"],["なら"],["、"],["あなた"],["がた"],["の"],["内","うち"],["に"],["おられる"],["方","かた"],["は"],["、"],["世","よ"],["に"],["いる"],["者","もの"],["より"],["も"],["強い","つよい"],["から"],["です"],["。"]]},{"verse":5,"text":"偽預言者たちは世に属しており、そのため、世のことを話し、世は彼らに耳を傾けます。","tok":[["偽","にせ"],["預言者","よげんしゃ"],["たち"],["は"],["世","よ"],["に"],["属して","ぞくして"],["おり"],["、"],["その"],["ため"],["、"],["世","よ"],["の"],["こと"],["を"],["話し","はなし"],["、"],["世","よ"],["は"],["彼","かれ"],["ら"],["に"],["耳","みみ"],["を"],["傾けます","かたむけます"],["。"]]},{"verse":6,"text":"わたしたちは神に属する者です。神を知る人は、わたしたちに耳を傾けますが、神に属していない者は、わたしたちに耳を傾けません。これによって、真理の霊と人を惑わす霊とを見分けることができます。","tok":[["わたしたち"],["は"],["神","かみ"],["に"],["属する","ぞくする"],["者","もの"],["です"],["。"],["神","かみ"],["を"],["知る","しる"],["人","ひと"],["は"],["、"],["わたしたち"],["に"],["耳","みみ"],["を"],["傾けます","かたむけます"],["が"],["、"],["神","かみ"],["に"],["属して","ぞくして"],["いない"],["者","もの"],["は"],["、"],["わたしたち"],["に"],["耳","みみ"],["を"],["傾けません","かたむけません"],["。"],["これ"],["によって"],["、"],["真理","しんり"],["の"],["霊","れい"],["と"],["人","ひと"],["を"],["惑わす","まどわす"],["霊","れい"],["と"],["を"],["見分ける","みわける"],["こと"],["が"],["できます"],["。"]]},{"verse":7,"text":"愛する者たち、互いに愛し合いましょう。愛は神から出るもので、愛する者は皆、神から生まれ、神を知っているからです。","tok":[["愛する","あいする"],["者","もの"],["たち"],["、"],["互い","たがい"],["に"],["愛し合いましょう","あいしあいましょう"],["。"],["愛","あい"],["は"],["神","かみ"],["から"],["出る","でる"],["もの"],["で"],["、"],["愛する","あいする"],["者","もの"],["は"],["皆","みな"],["、"],["神","かみ"],["から"],["生まれ","うまれ"],["、"],["神","かみ"],["を"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":8,"text":"愛することのない者は神を知りません。神は愛だからです。","tok":[["愛する","あいする"],["こと"],["の"],["ない"],["者","もの"],["は"],["神","かみ"],["を"],["知りません","しりません"],["。"],["神","かみ"],["は"],["愛","あい"],["だ"],["から"],["です"],["。"]]},{"verse":9,"text":"神は、独り子を世にお遣わしになりました。その方によって、わたしたちが生きるようになるためです。ここに、神の愛がわたしたちの内に示されました。","tok":[["神","かみ"],["は"],["、"],["独り子","ひとりご"],["を"],["世","よ"],["に"],["お遣わし","おつかわし"],["に"],["なりました"],["。"],["その"],["方","かた"],["によって"],["、"],["わたしたち"],["が"],["生きる","いきる"],["よう"],["に"],["なる"],["ため"],["です"],["。"],["ここ"],["に"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["わたしたち"],["の"],["内","うち"],["に"],["示されました","しめされました"],["。"]]},{"verse":10,"text":"わたしたちが神を愛したのではなく、神がわたしたちを愛して、わたしたちの罪を償ういけにえとして、御子をお遣わしになりました。ここに愛があります。","tok":[["わたしたち"],["が"],["神","かみ"],["を"],["愛した","あいした"],["ので"],["は"],["なく"],["、"],["神","かみ"],["が"],["わたしたち"],["を"],["愛して","あいして"],["、"],["わたしたち"],["の"],["罪","つみ"],["を"],["償う","つぐなう"],["いけにえ"],["として"],["、"],["御子","みこ"],["を"],["お遣わし","おつかわし"],["に"],["なりました"],["。"],["ここ"],["に"],["愛","あい"],["が"],["あります"],["。"]]},{"verse":11,"text":"愛する者たち、神がこのようにわたしたちを愛されたのですから、わたしたちも互いに愛し合うべきです。","tok":[["愛する","あいする"],["者","もの"],["たち"],["、"],["神","かみ"],["が"],["この"],["よう"],["に"],["わたしたち"],["を"],["愛された","あいされた"],["の"],["です"],["から"],["、"],["わたしたち"],["も"],["互い","たがい"],["に"],["愛し合うべきです","あいしあうべきです"],["。"]]},{"verse":12,"text":"いまだかつて神を見た者はいません。わたしたちが互いに愛し合うならば、神はわたしたちの内にとどまってくださり、神の愛がわたしたちの内で全うされているのです。","tok":[["いまだ"],["かつて"],["神","かみ"],["を"],["見た","みた"],["者","もの"],["は"],["いません"],["。"],["わたしたち"],["が"],["互い","たがい"],["に"],["愛し合うならば","あいしあうならば"],["、"],["神","かみ"],["は"],["わたしたち"],["の"],["内","うち"],["に"],["とどまって"],["くださり"],["、"],["神","かみ"],["の"],["愛","あい"],["が"],["わたしたち"],["の"],["内","うち"],["で"],["全う","まっとう"],["されて"],["いる"],["の"],["です"],["。"]]},{"verse":13,"text":"神はわたしたちに、御自分の霊を分け与えてくださいました。このことから、わたしたちが神の内にとどまり、神もわたしたちの内にとどまってくださることが分かります。","tok":[["神","かみ"],["は"],["わたしたち"],["に"],["、"],["御自分","ごじぶん"],["の"],["霊","れい"],["を"],["分け与えて","わけあたえて"],["くださいました"],["。"],["この"],["こと"],["から"],["、"],["わたしたち"],["が"],["神","かみ"],["の"],["内","うち"],["に"],["とどまり"],["、"],["神","かみ"],["も"],["わたしたち"],["の"],["内","うち"],["に"],["とどまって"],["くださる"],["こと"],["が"],["分かります","わかります"],["。"]]},{"verse":14,"text":"わたしたちはまた、御父が御子を世の救い主として遣わされたことを見、またそのことを証ししています。","tok":[["わたしたち"],["は"],["また"],["、"],["御父","おちち"],["が"],["御子","みこ"],["を"],["世","よ"],["の"],["救い主","すくいぬし"],["として"],["遣わされた","つかわされた"],["こと"],["を"],["見","み"],["、"],["また"],["その"],["こと"],["を"],["証し","あかし"],["して"],["います"],["。"]]},{"verse":15,"text":"イエスが神の子であることを公に言い表す人はだれでも、神がその人の内にとどまってくださり、その人も神の内にとどまります。","tok":[["イエス"],["が"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["こと"],["を"],["公","おおやけ"],["に"],["言い表す","いいあらわす"],["人","ひと"],["は"],["だれ"],["で"],["も"],["、"],["神","かみ"],["が"],["その"],["人","ひと"],["の"],["内","うち"],["に"],["とどまって"],["くださり"],["、"],["その"],["人","ひと"],["も"],["神","かみ"],["の"],["内","うち"],["に"],["とどまります"],["。"]]},{"verse":16,"text":"わたしたちは、わたしたちに対する神の愛を知り、また信じています。神は愛です。愛にとどまる人は、神の内にとどまり、神もその人の内にとどまってくださいます。","tok":[["わたしたち"],["は"],["、"],["わたしたち"],["に"],["対する","たいする"],["神","かみ"],["の"],["愛","あい"],["を"],["知り","しり"],["、"],["また"],["信じて","しんじて"],["います"],["。"],["神","かみ"],["は"],["愛","あい"],["です"],["。"],["愛","あい"],["に"],["とどまる"],["人","ひと"],["は"],["、"],["神","かみ"],["の"],["内","うち"],["に"],["とどまり"],["、"],["神","かみ"],["も"],["その"],["人","ひと"],["の"],["内","うち"],["に"],["とどまって"],["くださいます"],["。"]]},{"verse":17,"text":"こうして、愛がわたしたちの内に全うされているので、裁きの日に確信を持つことができます。この世でわたしたちも、イエスのようであるからです。","tok":[["こう"],["して"],["、"],["愛","あい"],["が"],["わたしたち"],["の"],["内","うち"],["に"],["全う","まっとう"],["されて"],["いる"],["ので"],["、"],["裁き","さばき"],["の"],["日","ひ"],["に"],["確信","かくしん"],["を"],["持つ","もつ"],["こと"],["が"],["できます"],["。"],["この世","このよ"],["で"],["わたしたち"],["も"],["、"],["イエス"],["の"],["よう"],["で"],["ある"],["から"],["です"],["。"]]},{"verse":18,"text":"愛には恐れがない。完全な愛は恐れを締め出します。なぜなら、恐れは罰を伴い、恐れる者には愛が全うされていないからです。","tok":[["愛","あい"],["に"],["は"],["恐れ","おそれ"],["が"],["ない"],["。"],["完全","かんぜん"],["な"],["愛","あい"],["は"],["恐れ","おそれ"],["を"],["締め出します","しめだします"],["。"],["なぜ"],["なら"],["、"],["恐れ","おそれ"],["は"],["罰","ばつ"],["を"],["伴い","ともない"],["、"],["恐れる","おそれる"],["者","もの"],["に"],["は"],["愛","あい"],["が"],["全う","まっとう"],["されて"],["いない"],["から"],["です"],["。"]]},{"verse":19,"text":"わたしたちが愛するのは、神がまずわたしたちを愛してくださったからです。","tok":[["わたしたち"],["が"],["愛する","あいする"],["の"],["は"],["、"],["神","かみ"],["が"],["まず"],["わたしたち"],["を"],["愛して","あいして"],["くださった"],["から"],["です"],["。"]]},{"verse":20,"text":"「神を愛している」と言いながら兄弟を憎む者がいれば、それは偽り者です。目に見える兄弟を愛さない者は、目に見えない神を愛することができません。","tok":[["「"],["神","かみ"],["を"],["愛して","あいして"],["いる"],["」"],["と"],["言い","いい"],["ながら"],["兄弟","きょうだい"],["を"],["憎む","にくむ"],["者","もの"],["が"],["いれば"],["、"],["それ"],["は"],["偽り者","いつわりしゃ"],["です"],["。"],["目","め"],["に"],["見える","みえる"],["兄弟","きょうだい"],["を"],["愛さない","あいさない"],["者","もの"],["は"],["、"],["目","め"],["に"],["見えない","みえない"],["神","かみ"],["を"],["愛する","あいする"],["こと"],["が"],["できません"],["。"]]},{"verse":21,"text":"神を愛する人は、兄弟をも愛すべきです。これが、神から受けた掟です。","tok":[["神","かみ"],["を"],["愛する","あいする"],["人","ひと"],["は"],["、"],["兄弟","きょうだい"],["を"],["も"],["愛すべきです","あいすべきです"],["。"],["これ"],["が"],["、"],["神","かみ"],["から"],["受けた","うけた"],["掟","おきて"],["です"],["。"]]}]
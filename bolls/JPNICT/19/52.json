[{"verse":1,"text":"【指揮者によって。マスキール。ダビデの詩。","tok":[["【"],["指揮者","しきしゃ"],["によって"],["。"],["マスキール"],["。"],["ダビデ"],["の"],["詩","し"],["。"]]},{"verse":2,"text":"エドム人ドエグがサウルのもとに来て、「ダビデがアヒメレクの家に来た」と告げたとき。】","tok":[["エドム人","えどむにん"],["ドエグ"],["が"],["サウル"],["の"],["もと"],["に"],["来て","きて"],["、"],["「"],["ダビデ"],["が"],["アヒメレク"],["の"],["家","いえ"],["に"],["来た","きた"],["」"],["と"],["告げた","つげた"],["とき"],["。"],["】"]]},{"verse":3,"text":"力ある者よ、なぜ悪事を誇るのか。神の慈しみの絶えることはないが","tok":[["力","ちから"],["ある"],["者","もの"],["よ"],["、"],["なぜ"],["悪事","あくじ"],["を"],["誇る","ほこる"],["の"],["か"],["。"],["神","かみ"],["の"],["慈しみ","いつくしみ"],["の"],["絶える","たえる"],["こと"],["は"],["ない"],["が"]]},{"verse":4,"text":"お前の考えることは破滅をもたらす。舌は刃物のように鋭く、人を欺く。","tok":[["お前","おまえ"],["の"],["考える","かんがえる"],["こと"],["は"],["破滅","はめつ"],["を"],["もたらす"],["。"],["舌","した"],["は"],["刃物","はもの"],["の"],["よう"],["に"],["鋭く","するどく"],["、"],["人","ひと"],["を"],["欺く","あざむく"],["。"]]},{"verse":5,"text":"お前は善よりも悪を正しい言葉よりもうそを好み〔セラ","tok":[["お前","おまえ"],["は"],["善","ぜん"],["より"],["も"],["悪","あく"],["を"],["正しい","ただしい"],["言葉","ことば"],["より"],["も"],["うそ"],["を"],["好み","このみ"],["〔"],["セラ"]]},{"verse":6,"text":"人を破滅に落とす言葉、欺く舌を好む。","tok":[["人","ひと"],["を"],["破滅","はめつ"],["に"],["落とす","おとす"],["言葉","ことば"],["、"],["欺く","あざむく"],["舌","した"],["を"],["好む","このむ"],["。"]]},{"verse":7,"text":"神はお前を打ち倒し、永久に滅ぼされる。お前を天幕から引き抜き命ある者の地から根こそぎにされる。〔セラ","tok":[["神","かみ"],["は"],["お前","おまえ"],["を"],["打ち倒し","うちたおし"],["、"],["永久","えいきゅう"],["に"],["滅ぼされる","ほろぼされる"],["。"],["お前","おまえ"],["を"],["天幕","てんまく"],["から"],["引き抜き","ひきぬき"],["命","いのち"],["ある"],["者","もの"],["の"],["地","ち"],["から"],["根こそぎ","ねこそぎ"],["に"],["される"],["。"],["〔"],["セラ"]]},{"verse":8,"text":"これを見て、神に従う人は神を畏れる。彼らはこの男を笑って言う。","tok":[["これ"],["を"],["見て","みて"],["、"],["神","かみ"],["に"],["従う","したがう"],["人","ひと"],["は"],["神","かみ"],["を"],["畏れる","おそれる"],["。"],["彼","かれ"],["ら"],["は"],["この"],["男","おとこ"],["を"],["笑って","わらって"],["言う","ゆう"],["。"]]},{"verse":9,"text":"「見よ、この男は神を力と頼まず自分の莫大な富に依り頼み自分を滅ぼすものを力と頼んでいた。」","tok":[["「"],["見よ","みよ"],["、"],["この"],["男","おとこ"],["は"],["神","かみ"],["を"],["力","ちから"],["と"],["頼まず","たのまず"],["自分","じぶん"],["の"],["莫大","ばくだい"],["な"],["富","とみ"],["に"],["依り頼み","よりたのみ"],["自分","じぶん"],["を"],["滅ぼす","ほろぼす"],["もの"],["を"],["力","ちから"],["と"],["頼んで","たのんで"],["いた"],["。"],["」"]]},{"verse":10,"text":"わたしは生い茂るオリーブの木。神の家にとどまります。世々限りなく、神の慈しみに依り頼みます。","tok":[["わたし"],["は"],["生い茂る","おいしげる"],["オリーブ"],["の"],["木","き"],["。"],["神","かみ"],["の"],["家","いえ"],["に"],["とどまります"],["。"],["世々","せいせい"],["限りなく","かぎりなく"],["、"],["神","かみ"],["の"],["慈しみ","いつくしみ"],["に"],["依り頼みます","よりたのみます"],["。"]]},{"verse":11,"text":"あなたが計らってくださいますからとこしえに、感謝をささげます。御名に望みをおきますあなたの慈しみに生きる人に対して恵み深いあなたの御名に。","tok":[["あなた"],["が"],["計らって","はからって"],["くださいます"],["から"],["とこしえ"],["に"],["、"],["感謝","かんしゃ"],["を"],["ささげます"],["。"],["御名","ぎょめい"],["に"],["望み","のぞみ"],["を"],["おきます"],["あなた"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["に対して","にたいして"],["恵み","めぐみ"],["深い","ふかい"],["あなた"],["の"],["御名","ぎょめい"],["に"],["。"]]}]
[{"verse":1,"text":"［指揮者によって。伴奏付き。第八調。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["伴奏付き","ばんそうつき"],["。"],["第","だい"],["八","はち"],["調","ちょう"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"主よ、怒ってわたしを責めないでください憤って懲らしめないでください。","tok":[["主","ぬし"],["よ"],["、"],["怒って","おこって"],["わたし"],["を"],["責めないで","せめないで"],["ください"],["憤って","いきどおって"],["懲らしめないで","こらしめないで"],["ください"],["。"]]},{"verse":3,"text":"主よ、憐れんでくださいわたしは嘆き悲しんでいます。主よ、癒してください、わたしの骨は恐れ","tok":[["主","ぬし"],["よ"],["、"],["憐れんで","あわれんで"],["ください"],["わたし"],["は"],["嘆き悲しんで","なげきかなしんで"],["います"],["。"],["主","ぬし"],["よ"],["、"],["癒して","いやして"],["ください"],["、"],["わたし"],["の"],["骨","ほね"],["は"],["恐れ","おそれ"]]},{"verse":4,"text":"わたしの魂は恐れおののいています。主よ、いつまでなのでしょう。","tok":[["わたし"],["の"],["魂","たましい"],["は"],["恐れおののいて","おそれおののいて"],["います"],["。"],["主","ぬし"],["よ"],["、"],["いつ"],["まで"],["な"],["の"],["でしょう"],["。"]]},{"verse":5,"text":"主よ、立ち帰りわたしの魂を助け出してください。あなたの慈しみにふさわしくわたしを救ってください。","tok":[["主","ぬし"],["よ"],["、"],["立ち帰り","たちかえり"],["わたし"],["の"],["魂","たましい"],["を"],["助け出して","たすけだして"],["ください"],["。"],["あなた"],["の"],["慈しみ","いつくしみ"],["に"],["ふさわしく"],["わたし"],["を"],["救って","すくって"],["ください"],["。"]]},{"verse":6,"text":"死の国へ行けば、だれもあなたの名を唱えず陰府に入ればだれもあなたに感謝をささげません。","tok":[["死","し"],["の"],["国","くに"],["へ"],["行けば","いけば"],["、"],["だれ"],["も"],["あなた"],["の"],["名","な"],["を"],["唱えず","となえず"],["陰府","よみ"],["に"],["入れば","はいれば"],["だれ"],["も"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげません"],["。"]]},{"verse":7,"text":"わたしは嘆き疲れました。夜ごと涙は床に溢れ、寝床は漂うほどです。","tok":[["わたし"],["は"],["嘆き","なげき"],["疲れました","つかれました"],["。"],["夜","よる"],["ごと"],["涙","なみだ"],["は"],["床","ゆか"],["に"],["溢れ","あふれ"],["、"],["寝床","ねどこ"],["は"],["漂う","ただよう"],["ほど"],["です"],["。"]]},{"verse":8,"text":"苦悩にわたしの目は衰えて行きわたしを苦しめる者のゆえに老いてしまいました。","tok":[["苦悩","くのう"],["に"],["わたし"],["の"],["目","め"],["は"],["衰えて","おとろえて"],["行き","いき"],["わたし"],["を"],["苦しめる","くるしめる"],["者","もの"],["の"],["ゆえ"],["に"],["老いて","おいて"],["しまいました"],["。"]]},{"verse":9,"text":"悪を行う者よ、皆わたしを離れよ。主はわたしの泣く声を聞き","tok":[["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["よ"],["、"],["皆","みな"],["わたし"],["を"],["離れよ","はなれよ"],["。"],["主","ぬし"],["は"],["わたし"],["の"],["泣く","なく"],["声","こえ"],["を"],["聞き","きき"]]},{"verse":10,"text":"主はわたしの嘆きを聞き主はわたしの祈りを受け入れてくださる。","tok":[["主","ぬし"],["は"],["わたし"],["の"],["嘆き","なげき"],["を"],["聞き","きき"],["主","ぬし"],["は"],["わたし"],["の"],["祈り","いのり"],["を"],["受け入れて","うけいれて"],["くださる"],["。"]]},{"verse":11,"text":"敵は皆、恥に落とされて恐れおののきたちまち退いて、恥に落とされる。","tok":[["敵","てき"],["は"],["皆","みな"],["、"],["恥","はじ"],["に"],["落とされて","おとされて"],["恐れおののき","おそれおののき"],["たちまち"],["退いて","しりぞいて"],["、"],["恥","はじ"],["に"],["落とされる","おとされる"],["。"]]}]
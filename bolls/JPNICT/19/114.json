[{"verse":1,"text":"イスラエルはエジプトをヤコブの家は異なる言葉の民のもとを去り","tok":[["イスラエル"],["は"],["エジプト"],["を"],["ヤコブ"],["の"],["家","いえ"],["は"],["異なる","ことなる"],["言葉","ことば"],["の"],["民","たみ"],["の"],["もと"],["を"],["去り","さり"]]},{"verse":2,"text":"ユダは神の聖なるものイスラエルは神が治められるものとなった。","tok":[["ユダ"],["は"],["神","かみ"],["の"],["聖","せい"],["なる"],["もの"],["イスラエル"],["は"],["神","かみ"],["が"],["治められる","おさめられる"],["もの"],["と"],["なった"],["。"]]},{"verse":3,"text":"海は見て、逃げ去った。ヨルダンの流れは退いた。","tok":[["海","うみ"],["は"],["見て","みて"],["、"],["逃げ去った","にげさった"],["。"],["ヨルダン"],["の"],["流れ","ながれ"],["は"],["退いた","しりぞいた"],["。"]]},{"verse":4,"text":"山々は雄羊のように丘は群れの羊のように踊った。","tok":[["山々","やまやま"],["は"],["雄羊","おひつじ"],["の"],["よう"],["に"],["丘","おか"],["は"],["群れ","むれ"],["の"],["羊","ひつじ"],["の"],["よう"],["に"],["踊った","おどった"],["。"]]},{"verse":5,"text":"どうしたのか、海よ、逃げ去るとはヨルダンの流れよ、退くとは","tok":[["どう"],["した"],["の"],["か"],["、"],["海","うみ"],["よ"],["、"],["逃げ去る","にげさる"],["と"],["は"],["ヨルダン"],["の"],["流れ","ながれ"],["よ"],["、"],["退く","しりぞく"],["と"],["は"]]},{"verse":6,"text":"山々よ、雄羊のように丘よ、群れの羊のように踊るとは。","tok":[["山々","やまやま"],["よ"],["、"],["雄羊","おひつじ"],["の"],["よう"],["に"],["丘","おか"],["よ"],["、"],["群れ","むれ"],["の"],["羊","ひつじ"],["の"],["よう"],["に"],["踊る","おどる"],["と"],["は"],["。"]]},{"verse":7,"text":"地よ、身もだえせよ、主なる方の御前にヤコブの神の御前に","tok":[["地","ち"],["よ"],["、"],["身もだえ","みもだえ"],["せよ"],["、"],["主","おも"],["なる"],["方","かた"],["の"],["御前","ごぜん"],["に"],["ヤコブ"],["の"],["神","かみ"],["の"],["御前","ごぜん"],["に"]]},{"verse":8,"text":"岩を水のみなぎるところとし硬い岩を水の溢れる泉とする方の御前に。","tok":[["岩","いわ"],["を"],["水","みず"],["の"],["みなぎる"],["ところ"],["と"],["し"],["硬い","かたい"],["岩","いわ"],["を"],["水","みず"],["の"],["溢れる","あふれる"],["泉","いずみ"],["と"],["する"],["方","ほう"],["の"],["御前","ごぜん"],["に"],["。"]]}]
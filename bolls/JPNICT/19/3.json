[{"verse":1,"text":"［賛歌。ダビデの詩。ダビデがその子 アブサロムを逃れたとき。］","tok":[["［"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["ダビデ"],["が"],["その"],["子","こ"],[" "],["アブサロム"],["を"],["逃れた","のがれた"],["とき"],["。"],["］"]]},{"verse":2,"text":"主よ、わたしを苦しめる者はどこまで増えるのでしょうか。多くの者がわたしに立ち向かい","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["を"],["苦しめる","くるしめる"],["者","もの"],["は"],["どこ"],["まで"],["増える","ふえる"],["の"],["でしょう"],["か"],["。"],["多く","おおく"],["の"],["者","もの"],["が"],["わたし"],["に"],["立ち向かい","たちむかい"]]},{"verse":3,"text":"多くの者がわたしに言います「彼に神の救いなどあるものか」と。〔セラ","tok":[["多く","おおく"],["の"],["者","もの"],["が"],["わたし"],["に"],["言います","いいます"],["「"],["彼","かれ"],["に"],["神","かみ"],["の"],["救い","すくい"],["など"],["ある"],["もの"],["か"],["」"],["と"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"主よ、それでもあなたはわたしの盾、わたしの栄えわたしの頭を高くあげてくださる方。","tok":[["主","ぬし"],["よ"],["、"],["それ"],["で"],["も"],["あなた"],["は"],["わたし"],["の"],["盾","たて"],["、"],["わたし"],["の"],["栄え","はえ"],["わたし"],["の"],["頭","あたま"],["を"],["高く","たかく"],["あげて"],["くださる"],["方","かた"],["。"]]},{"verse":5,"text":"主に向かって声をあげれば聖なる山から答えてくださいます。〔セラ","tok":[["主に","おもに"],["向かって","むかって"],["声","こえ"],["を"],["あげれば"],["聖","せい"],["なる"],["山","やま"],["から"],["答えて","こたえて"],["くださいます"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"身を横たえて眠りわたしはまた、目覚めます。主が支えていてくださいます。","tok":[["身","み"],["を"],["横たえて","よこたえて"],["眠り","ねむり"],["わたし"],["は"],["また"],["、"],["目覚めます","めざめます"],["。"],["主","ぬし"],["が"],["支えて","ささえて"],["いて"],["くださいます"],["。"]]},{"verse":7,"text":"いかに多くの民に包囲されても決して恐れません。","tok":[["いかに"],["多く","おおく"],["の"],["民","たみ"],["に"],["包囲","ほうい"],["されて"],["も"],["決して","けっして"],["恐れません","おそれません"],["。"]]},{"verse":8,"text":"主よ、立ち上がってください。わたしの神よ、お救いください。すべての敵の顎を打ち神に逆らう者の歯を砕いてください。","tok":[["主","ぬし"],["よ"],["、"],["立ち上がって","たちあがって"],["ください"],["。"],["わたし"],["の"],["神","かみ"],["よ"],["、"],["お救い","おすくい"],["ください"],["。"],["すべて"],["の"],["敵","てき"],["の"],["顎","あご"],["を"],["打ち","うち"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["の"],["歯","は"],["を"],["砕いて","くだいて"],["ください"],["。"]]},{"verse":9,"text":"救いは主のもとにあります。あなたの祝福があなたの民の上にありますように。〔セラ","tok":[["救い","すくい"],["は"],["主","ぬし"],["の"],["もと"],["に"],["あります"],["。"],["あなた"],["の"],["祝福","しゅくふく"],["が"],["あなた"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["あります"],["よう"],["に"],["。"],["〔"],["セラ"]]}]
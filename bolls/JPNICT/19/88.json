[{"verse":1,"text":"［歌。賛歌。コラの子の詩。指揮者によって。マハラトに合わせて。レアノト。マスキール。エズラ人ヘマンの詩。］","tok":[["［"],["歌","うた"],["。"],["賛歌","さんか"],["。"],["コラ"],["の"],["子","こ"],["の"],["詩","し"],["。"],["指揮者","しきしゃ"],["によって"],["。"],["マハラト"],["に"],["合わせて","あわせて"],["。"],["レアノト"],["。"],["マスキール"],["。"],["エズラ人","えずらにん"],["ヘマン"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"主よ、わたしを救ってくださる神よ昼は、助けを求めて叫び夜も、御前におります。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["を"],["救って","すくって"],["くださる"],["神","かみ"],["よ"],["昼","ひる"],["は"],["、"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫び","さけび"],["夜","や"],["も"],["、"],["御前","ごぜん"],["に"],["おります"],["。"]]},{"verse":3,"text":"わたしの祈りが御もとに届きますように。わたしの声に耳を傾けてください。","tok":[["わたし"],["の"],["祈り","いのり"],["が"],["御もと","おもと"],["に"],["届きます","とどきます"],["よう"],["に"],["。"],["わたし"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"]]},{"verse":4,"text":"わたしの魂は苦難を味わい尽くし命は陰府にのぞんでいます。","tok":[["わたし"],["の"],["魂","たましい"],["は"],["苦難","くなん"],["を"],["味わい","あじわい"],["尽くし","つくし"],["命","いのち"],["は"],["陰府","よみ"],["に"],["のぞんで"],["います"],["。"]]},{"verse":5,"text":"穴に下る者のうちに数えられ力を失った者とされ","tok":[["穴","あな"],["に"],["下る","くだる"],["者","もの"],["の"],["うち"],["に"],["数えられ","かぞえられ"],["力","ちから"],["を"],["失った","うしなった"],["者","もの"],["と"],["され"]]},{"verse":6,"text":"汚れた者と見なされ死人のうちに放たれて墓に横たわる者となりました。あなたはこのような者に心を留められません。彼らは御手から切り離されています。","tok":[["汚れた","よごれた"],["者","もの"],["と"],["見なされ","みなされ"],["死人","しにん"],["の"],["うち"],["に"],["放たれて","はなたれて"],["墓","はか"],["に"],["横たわる","よこたわる"],["者","もの"],["と"],["なりました"],["。"],["あなた"],["は"],["この"],["よう"],["な"],["者","もの"],["に"],["心","こころ"],["を"],["留められません","とめられません"],["。"],["彼","かれ"],["ら"],["は"],["御手","おて"],["から"],["切り離されて","きりはなされて"],["います"],["。"]]},{"verse":7,"text":"あなたは地の底の穴にわたしを置かれます影に閉ざされた所、暗闇の地に。","tok":[["あなた"],["は"],["地","ち"],["の"],["底","そこ"],["の"],["穴","あな"],["に"],["わたし"],["を"],["置かれます","おかれます"],["影","かげ"],["に"],["閉ざされた","とざされた"],["所","ところ"],["、"],["暗闇","くらやみ"],["の"],["地","ち"],["に"],["。"]]},{"verse":8,"text":"あなたの憤りがわたしを押さえつけあなたの起こす波がわたしを苦しめます。〔セラ","tok":[["あなた"],["の"],["憤り","いきどおり"],["が"],["わたし"],["を"],["押さえつけ","おさえつけ"],["あなた"],["の"],["起こす","おこす"],["波","なみ"],["が"],["わたし"],["を"],["苦しめます","くるしめます"],["。"],["〔"],["セラ"]]},{"verse":9,"text":"あなたはわたしから親しい者を遠ざけられました。彼らにとってわたしは忌むべき者となりました。わたしは閉じ込められて、出られません。","tok":[["あなた"],["は"],["わたし"],["から"],["親しい","したしい"],["者","もの"],["を"],["遠ざけられました","とおざけられました"],["。"],["彼","かれ"],["ら"],["にとって"],["わたし"],["は"],["忌むべき","いむべき"],["者","もの"],["と"],["なりました"],["。"],["わたし"],["は"],["閉じ込められて","とじこめられて"],["、"],["出られません","でられません"],["。"]]},{"verse":10,"text":"苦悩に目は衰え来る日も来る日も、主よ、あなたを呼びあなたに向かって手を広げています。","tok":[["苦悩","くのう"],["に"],["目","め"],["は"],["衰え","おとろえ"],["来る","くる"],["日","ひ"],["も"],["来る","くる"],["日","ひ"],["も"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["を"],["呼び","よび"],["あなた"],["に"],["向かって","むかって"],["手","て"],["を"],["広げて","ひろげて"],["います"],["。"]]},{"verse":11,"text":"あなたが死者に対して驚くべき御業をなさったり死霊が起き上がってあなたに感謝したりすることがあるでしょうか。〔セラ","tok":[["あなた"],["が"],["死者","ししゃ"],["に対して","にたいして"],["驚くべき","おどろくべき"],["御業","ごごう"],["を"],["なさっ"],["たり"],["死霊","しりょう"],["が"],["起き上がって","おきあがって"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["たり"],["する"],["こと"],["が"],["あるでしょう"],["か"],["。"],["〔"],["セラ"]]},{"verse":12,"text":"墓の中であなたの慈しみが滅びの国であなたのまことが語られたりするでしょうか。","tok":[["墓","はか"],["の"],["中","なか"],["で"],["あなた"],["の"],["慈しみ","いつくしみ"],["が"],["滅び","ほろび"],["の"],["国","くに"],["で"],["あなた"],["の"],["まこと"],["が"],["語られ","かたられ"],["たり"],["するでしょう"],["か"],["。"]]},{"verse":13,"text":"闇の中で驚くべき御業が忘却の地で恵みの御業が告げ知らされたりするでしょうか。","tok":[["闇","やみ"],["の"],["中","なか"],["で"],["驚くべき","おどろくべき"],["御業","ごごう"],["が"],["忘却","ぼうきゃく"],["の"],["地","ち"],["で"],["恵み","めぐみ"],["の"],["御業","ごごう"],["が"],["告げ知らされ","つげしらされ"],["たり"],["するでしょう"],["か"],["。"]]},{"verse":14,"text":"主よ、わたしはあなたに叫びます。朝ごとに祈りは御前に向かいます。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["は"],["あなた"],["に"],["叫びます","さけびます"],["。"],["朝","あさ"],["ごと"],["に"],["祈り","いのり"],["は"],["御前","ごぜん"],["に"],["向かいます","むかいます"],["。"]]},{"verse":15,"text":"主よ、なぜわたしの魂を突き放しなぜ御顔をわたしに隠しておられるのですか。","tok":[["主","ぬし"],["よ"],["、"],["なぜ"],["わたし"],["の"],["魂","たましい"],["を"],["突き放し","つきはなし"],["なぜ"],["御
[{"verse":1,"text":"［都に上る歌。ダビデの詩。］主の家に行こう、と人々が言ったときわたしはうれしかった。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["の"],["家","いえ"],["に"],["行こう","いこう"],["、"],["と"],["人々","ひとびと"],["が"],["言った","いった"],["とき"],["わたし"],["は"],["うれしかった"],["。"]]},{"verse":2,"text":"エルサレムよ、あなたの城門の中にわたしたちの足は立っている。","tok":[["エルサレム"],["よ"],["、"],["あなた"],["の"],["城門","じょうもん"],["の"],["中","なか"],["に"],["わたしたち"],["の"],["足","あし"],["は"],["立って","たって"],["いる"],["。"]]},{"verse":3,"text":"エルサレム、都として建てられた町。そこに、すべては結び合い","tok":[["エルサレム"],["、"],["都","と"],["として"],["建てられた","たてられた"],["町","まち"],["。"],["そこ"],["に"],["、"],["すべて"],["は"],["結び合い","むすびあい"]]},{"verse":4,"text":"そこに、すべての部族、主の部族は上って来る。主の御名に感謝をささげるのはイスラエルの定め。","tok":[["そこ"],["に"],["、"],["すべて"],["の"],["部族","ぶぞく"],["、"],["主","ぬし"],["の"],["部族","ぶぞく"],["は"],["上って","のぼって"],["来る","くる"],["。"],["主","ぬし"],["の"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["を"],["ささげる"],["の"],["は"],["イスラエル"],["の"],["定め","さだめ"],["。"]]},{"verse":5,"text":"そこにこそ、裁きの王座がダビデの家の王座が据えられている。","tok":[["そこ"],["に"],["こそ"],["、"],["裁き","さばき"],["の"],["王座","おうざ"],["が"],["ダビデ"],["の"],["家","いえ"],["の"],["王座","おうざ"],["が"],["据えられて","すえられて"],["いる"],["。"]]},{"verse":6,"text":"エルサレムの平和を求めよう。「あなたを愛する人々に平安があるように。","tok":[["エルサレム"],["の"],["平和","へいわ"],["を"],["求めよう","もとめよう"],["。"],["「"],["あなた"],["を"],["愛する","あいする"],["人々","ひとびと"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":7,"text":"あなたの城壁のうちに平和があるように。あなたの城郭のうちに平安があるように。」","tok":[["あなた"],["の"],["城壁","じょうへき"],["の"],["うち"],["に"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"],["あなた"],["の"],["城郭","じょうかく"],["の"],["うち"],["に"],["平安","へいあん"],["が"],["ある"],["よう"],["に"],["。"],["」"]]},{"verse":8,"text":"わたしは言おう、わたしの兄弟、友のために。「あなたのうちに平和があるように。」","tok":[["わたし"],["は"],["言おう","いおう"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["、"],["友","とも"],["の"],["ため"],["に"],["。"],["「"],["あなた"],["の"],["うち"],["に"],["平和","へいわ"],["が"],["ある"],["よう"],["に"],["。"],["」"]]},{"verse":9,"text":"わたしは願おうわたしたちの神、主の家のために。「あなたに幸いがあるように。」","tok":[["わたし"],["は"],["願おう","ねがおう"],["わたしたち"],["の"],["神","かみ"],["、"],["主","ぬし"],["の"],["家","いえ"],["の"],["ため"],["に"],["。"],["「"],["あなた"],["に"],["幸い","さいわい"],["が"],["ある"],["よう"],["に"],["。"],["」"]]}]
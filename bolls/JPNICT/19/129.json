[{"verse":1,"text":"［都に上る歌。］イスラエルは言うがよい。「わたしが若いときから彼らはわたしを苦しめ続けたが","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["イスラエル"],["は"],["言う","ゆう"],["が"],["よい"],["。"],["「"],["わたし"],["が"],["若い","わかい"],["とき"],["から"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["苦しめ","くるしめ"],["続けた","つづけた"],["が"]]},{"verse":2,"text":"わたしが若いときから彼らはわたしを苦しめ続けたが彼らはわたしを圧倒できなかった。","tok":[["わたし"],["が"],["若い","わかい"],["とき"],["から"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["苦しめ","くるしめ"],["続けた","つづけた"],["が"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["圧倒","あっとう"],["できなかった"],["。"]]},{"verse":3,"text":"耕す者はわたしの背を耕し畝を長く作った。」","tok":[["耕す","たがやす"],["者","もの"],["は"],["わたし"],["の"],["背","せ"],["を"],["耕し","たがやし"],["畝","うね"],["を"],["長く","ながく"],["作った","つくった"],["。"],["」"]]},{"verse":4,"text":"主は正しい。主に逆らう者の束縛を断ち切ってくださる。","tok":[["主","ぬし"],["は"],["正しい","ただしい"],["。"],["主に","おもに"],["逆らう","さからう"],["者","もの"],["の"],["束縛","そくばく"],["を"],["断ち切って","たちきって"],["くださる"],["。"]]},{"verse":5,"text":"シオンを憎む者よ、皆恥を受けて退け。","tok":[["シオン"],["を"],["憎む","にくむ"],["者","もの"],["よ"],["、"],["皆","みな"],["恥","はじ"],["を"],["受けて","うけて"],["退け","しりぞけ"],["。"]]},{"verse":6,"text":"抜かれる前に枯れる屋根の草のようになれ。","tok":[["抜かれる","ぬかれる"],["前","まえ"],["に"],["枯れる","かれる"],["屋根","やね"],["の"],["草","くさ"],["の"],["よう"],["に"],["なれ"],["。"]]},{"verse":7,"text":"刈り入れても手を満たすことはないように。穂を束ねてもふところを満たすことはないように。","tok":[["刈り入れて","かりいれて"],["も"],["手","て"],["を"],["満たす","みたす"],["こと"],["は"],["ない"],["よう"],["に"],["。"],["穂","ほ"],["を"],["束ねて","たばねて"],["も"],["ふところ"],["を"],["満たす","みたす"],["こと"],["は"],["ない"],["よう"],["に"],["。"]]},{"verse":8,"text":"傍らを通る者が「主はあなたがたを祝福される。わたしたちも主の御名によってあなたがたを祝福する」と言わないように。","tok":[["傍ら","かたわら"],["を"],["通る","とおる"],["者","もの"],["が"],["「"],["主","ぬし"],["は"],["あなた"],["がた"],["を"],["祝福","しゅくふく"],["される"],["。"],["わたしたち"],["も"],["主","ぬし"],["の"],["御名","ぎょめい"],["によって"],["あなた"],["がた"],["を"],["祝福","しゅくふく"],["する"],["」"],["と"],["言わない","いわない"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"【指揮者によって。伴奏付き。マスキール。ダビデの詩。","tok":[["【"],["指揮者","しきしゃ"],["によって"],["。"],["伴奏付き","ばんそうつき"],["。"],["マスキール"],["。"],["ダビデ"],["の"],["詩","し"],["。"]]},{"verse":2,"text":"ジフ人が来て、サウルに「ダビデがわたしたちのもとに隠れている」と話したとき。】","tok":[["ジフ人","じふにん"],["が"],["来て","きて"],["、"],["サウル"],["に"],["「"],["ダビデ"],["が"],["わたしたち"],["の"],["もと"],["に"],["隠れて","かくれて"],["いる"],["」"],["と"],["話した","はなした"],["とき"],["。"],["】"]]},{"verse":3,"text":"神よ、御名によってわたしを救い力強い御業によって、わたしを裁いてください。","tok":[["神","かみ"],["よ"],["、"],["御名","ぎょめい"],["によって"],["わたし"],["を"],["救い","すくい"],["力強い","ちからづよい"],["御業","ごごう"],["によって"],["、"],["わたし"],["を"],["裁いて","さばいて"],["ください"],["。"]]},{"verse":4,"text":"神よ、わたしの祈りを聞きこの口にのぼる願いに耳を傾けてください。","tok":[["神","かみ"],["よ"],["、"],["わたし"],["の"],["祈り","いのり"],["を"],["聞き","きき"],["この"],["口","くち"],["に"],["のぼる"],["願い","ねがい"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"]]},{"verse":5,"text":"異邦の者がわたしに逆らって立ち暴虐な者がわたしの命をねらっています。彼らは自分の前に神を置こうとしないのです。〔セラ","tok":[["異邦","いほう"],["の"],["者","もの"],["が"],["わたし"],["に"],["逆らって","さからって"],["立ち","たち"],["暴虐","ぼうぎゃく"],["な"],["者","もの"],["が"],["わたし"],["の"],["命","いのち"],["を"],["ねらって"],["います"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["前","まえ"],["に"],["神","かみ"],["を"],["置こう","おこう"],["と"],["しない"],["の"],["です"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"見よ、神はわたしを助けてくださる。主はわたしの魂を支えてくださる。","tok":[["見よ","みよ"],["、"],["神","かみ"],["は"],["わたし"],["を"],["助けて","たすけて"],["くださる"],["。"],["主","ぬし"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["支えて","ささえて"],["くださる"],["。"]]},{"verse":7,"text":"わたしを陥れようとする者に災いを報いあなたのまことに従って彼らを絶やしてください。","tok":[["わたし"],["を"],["陥れよう","おとしいれよう"],["と"],["する"],["者","もの"],["に"],["災い","わざわい"],["を"],["報い","むくい"],["あなた"],["の"],["まこと"],["に"],["従って","したがって"],["彼","かれ"],["ら"],["を"],["絶やして","たやして"],["ください"],["。"]]},{"verse":8,"text":"主よ、わたしは自ら進んでいけにえをささげ恵み深いあなたの御名に感謝します。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["は"],["自ら","みずから"],["進んで","すすんで"],["いけにえ"],["を"],["ささげ"],["恵み","めぐみ"],["深い","ふかい"],["あなた"],["の"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["します"],["。"]]},{"verse":9,"text":"主は苦難から常に救い出してくださいます。わたしの目が敵を支配しますように。","tok":[["主","ぬし"],["は"],["苦難","くなん"],["から"],["常","つね"],["に"],["救い出して","すくいだして"],["くださいます"],["。"],["わたし"],["の"],["目","め"],["が"],["敵","てき"],["を"],["支配","しはい"],["します"],["よう"],["に"],["。"]]}]
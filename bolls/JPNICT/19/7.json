[{"verse":1,"text":"［シガヨン。ダビデの詩。ベニヤミン人クシュのことについてダビデが主に向かって歌ったもの。］","tok":[["［"],["シガヨン"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["ベニヤミン"],["人","にん"],["クシュ"],["の"],["こと"],["について"],["ダビデ"],["が"],["主に","おもに"],["向かって","むかって"],["歌った","うたった"],["もの"],["。"],["］"]]},{"verse":2,"text":"わたしの神、主よ、あなたを避けどころとします。わたしを助け、追い迫る者から救ってください。","tok":[["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["を"],["避け","さけ"],["どころ"],["と"],["します"],["。"],["わたし"],["を"],["助け","たすけ"],["、"],["追い迫る","おいせまる"],["者","もの"],["から"],["救って","すくって"],["ください"],["。"]]},{"verse":3,"text":"獅子のようにわたしの魂を餌食とする者からだれも奪い返し、助けてくれないのです。","tok":[["獅子","しし"],["の"],["よう"],["に"],["わたし"],["の"],["魂","たましい"],["を"],["餌食","えじき"],["と"],["する"],["者","もの"],["から"],["だれ"],["も"],["奪い返し","うばいかえし"],["、"],["助けて","たすけて"],["くれない"],["の"],["です"],["。"]]},{"verse":4,"text":"わたしの神、主よもしわたしがこのようなことをしたのならわたしの手に不正があり","tok":[["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["もし"],["わたし"],["が"],["この"],["よう"],["な"],["こと"],["を"],["した"],["の"],["なら"],["わたし"],["の"],["手","て"],["に"],["不正","ふせい"],["が"],["あり"]]},{"verse":5,"text":"仲間に災いをこうむらせ敵をいたずらに見逃したなら","tok":[["仲間","なかま"],["に"],["災い","わざわい"],["を"],["こうむらせ"],["敵","てき"],["を"],["いたずら"],["に"],["見逃したなら","みのがしたなら"]]},{"verse":6,"text":"敵がわたしの魂に追い迫り、追いつきわたしの命を地に踏みにじりわたしの誉れを塵に伏せさせても当然です。〔セラ","tok":[["敵","てき"],["が"],["わたし"],["の"],["魂","たましい"],["に"],["追い迫り","おいせまり"],["、"],["追いつき","おいつき"],["わたし"],["の"],["命","いのち"],["を"],["地","ち"],["に"],["踏みにじり","ふみにじり"],["わたし"],["の"],["誉れ","ほまれ"],["を"],["塵","ごみ"],["に"],["伏せさせて","ふせさせて"],["も"],["当然","とうぜん"],["です"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"主よ、敵に対して怒りをもって立ち上がり憤りをもって身を起こしわたしに味方して奮い立ち裁きを命じてください。","tok":[["主","ぬし"],["よ"],["、"],["敵","てき"],["に対して","にたいして"],["怒り","いかり"],["を"],["もって"],["立ち上がり","たちあがり"],["憤り","いきどおり"],["を"],["もって"],["身","み"],["を"],["起こし","おこし"],["わたし"],["に"],["味方","みかた"],["して"],["奮い立ち","ふるいたち"],["裁き","さばき"],["を"],["命じて","めいじて"],["ください"],["。"]]},{"verse":8,"text":"諸国をあなたの周りに集わせ彼らを超えて高い御座に再び就いてください。","tok":[["諸国","しょこく"],["を"],["あなた"],["の"],["周り","まわり"],["に"],
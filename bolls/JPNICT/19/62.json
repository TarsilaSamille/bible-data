[{"verse":1,"text":"［指揮者によって。エドトンに合わせて。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["エドトン"],["に"],["合わせて","あわせて"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"わたしの魂は沈黙して、ただ神に向かう。神にわたしの救いはある。","tok":[["わたし"],["の"],["魂","たましい"],["は"],["沈黙","ちんもく"],["して"],["、"],["ただ"],["神","かみ"],["に"],["向かう","むかう"],["。"],["神","かみ"],["に"],["わたし"],["の"],["救い","すくい"],["は"],["ある"],["。"]]},{"verse":3,"text":"神こそ、わたしの岩、わたしの救い、砦の塔。わたしは決して動揺しない。","tok":[["神","かみ"],["こそ"],["、"],["わたし"],["の"],["岩","いわ"],["、"],["わたし"],["の"],["救い","すくい"],["、"],["砦","とりで"],["の"],["塔","とう"],["。"],["わたし"],["は"],["決して","けっして"],["動揺","どうよう"],["しない"],["。"]]},{"verse":4,"text":"お前たちはいつまで人に襲いかかるのか。亡きものにしようとして一団となり人を倒れる壁、崩れる石垣とし","tok":[["お前","おまえ"],["たち"],["は"],["いつ"],["まで"],["人","ひと"],["に"],["襲いかかる","おそいかかる"],["の"],["か"],["。"],["亡き","なき"],["もの"],["に"],["しよう"],["として"],["一団","いちだん"],["と"],["なり"],["人","ひと"],["を"],["倒れる","たおれる"],["壁","かべ"],["、"],["崩れる","くずれる"],["石垣","いしがき"],["と"],["し"]]},{"verse":5,"text":"人が身を起こせば、押し倒そうと謀る。常に欺こうとして口先で祝福し、腹の底で呪う。〔セラ","tok":[["人","ひと"],["が"],["身","み"],["を"],["起こせば","おこせば"],["、"],["押し倒そう","おしたおそう"],["と"],["謀る","はかる"],["。"],["常","つね"],["に"],["欺こう","あざむこう"],["として"],["口先","くちさき"],["で"],["祝福","しゅくふく"],["し"],["、"],["腹","はら"],["の"],["底","そこ"],["で"],["呪う","のろう"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"わたしの魂よ、沈黙して、ただ神に向かえ。神にのみ、わたしは希望をおいている。","tok":[["わたし"],["の"],["魂","たましい"],["よ"],["、"],["沈黙","ちんもく"],["して"],["、"],["ただ"],["神","かみ"],["に"],["向かえ","むかえ"],["。"],["神","かみ"],["に"],["のみ"],["、"],["わたし"],["は"],["希望","きぼう"],["を"],["おいて"],["いる"],["。"]]},{"verse":7,"text":"神はわたしの岩、わたしの救い、砦の塔。わたしは動揺しない。","tok":[["神","かみ"],["は"],["わたし"],["の"],["岩","いわ"],["、"],["わたし"],["の"],["救い","すくい"],["、"],["砦","とりで"],["の"],["塔","とう"],["。"],["わたし"],["は"],["動揺","どうよう"],["しない"],["。"]]},{"verse":8,"text":"わたしの救いと栄えは神にかかっている。力と頼み、避けどころとする岩は神のもとにある。","tok":[["わたし"],["の"],["救い","すくい"],["と"],["栄え","はえ"],["は"],["神","かみ"],["に"],["かかって"],["いる"],["。"],["力","ちから"],["と"],["頼み","たのみ"],["、"],["避け","さけ"],["どころ"],["と"],["する"],["岩","いわ"],["は"],["神","かみ"],["の"],["もと"],["に"],["ある"],["。"]]},{"verse":9,"text":"民よ、どのような時にも神に信頼し御前に心を注ぎ出せ。神はわたしたちの避けどころ。〔セラ","tok":[["民","たみ"],["よ"],["、"],["どのような"],["時","とき"],["に"],["も"],["神","かみ"],["に"],["信頼","しんらい"],["し"],["御前","ごぜん"],["に"],["心","こころ"],["を"],["注ぎ","そそぎ"],["出せ","だせ"],["。"],["神","かみ"],["は"],["わたしたち"],["の"],["避け","よけ"],["どころ"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"人の子らは空しいもの。人の子らは欺くもの。共に秤にかけても、息よりも軽い。","tok":[["人","ひと"],["の"],["子","こ"],["ら"],["は"],["空しい","むなしい"],["もの"],["。"],["人","ひと"],["の"],["子","こ"],["ら"],["は"],["欺く","あざむく"],["もの"],["。"],["共","とも"],["に"],["秤","はかり"],["に"],["かけて"],["も"],["、"],["息","いき"],["より"],["も"],["軽い","かるい"],["。"]]},{"verse":11,"text":"暴力に依存するな。搾取を空しく誇るな。力が力を生むことに心を奪われるな。","tok":[["暴力","ぼうりょく"],["に"],["依存","いぞん"],["する"],["な"],["。"],["搾取","さくしゅ"],["を"],["空しく","むなしく"],["誇る","ほこる"],["な"],["。"],["力","ちから"],["が"],["力","ちから"],["を"],["生む","うむ"],["こと"],["に"],["心","こころ"],["を"],["奪われる","うばわれる"],["な"],["。"]]},{"verse":12,"text":"ひとつのことを神は語りふたつのことをわたしは聞いた力は神のものであり","tok":[["ひと"],["つ"],["の"],["こと"],["を"],["神","かみ"],["は"],["語り","かたり"],["ふた"],["つ"],["の"],["こと"],["を"],["わたし"],["は"],["聞いた","きいた"],["力","ちから"],["は"],["神","かみ"],["の"],["もの"],["で"],["あり"]]},{"verse":13,"text":"慈しみは、わたしの主よ、あなたのものである、とひとりひとりに、その業に従ってあなたは人間に報いをお与えになる、と。","tok":[["慈しみ","いつくしみ"],["は"],["、"],["わたし"],["の"],["主","ぬし"],["よ"],["、"],["あなた"],["の"],["もの"],["で"],["ある"],["、"],["と"],["ひとりひとり"],["に"],["、"],["その"],["業","ごう"],["に"],["従って","したがって"],["あなた"],["は"],["人間","にんげん"],["に"],["報い","むくい"],["を"],["お与え","おあたえ"],["に"],["なる"],["、"],["と"],["。"]]}]
[{"verse":1,"text":"［賛歌。］新しい歌を主に向かって歌え。主は驚くべき御業を成し遂げられた。右の御手、聖なる御腕によって主は救いの御業を果たされた。","tok":[["［"],["賛歌","さんか"],["。"],["］"],["新しい","あたらしい"],["歌","うた"],["を"],["主に","おもに"],["向かって","むかって"],["歌え","うたえ"],["。"],["主","ぬし"],["は"],["驚くべき","おどろくべき"],["御業","ごごう"],["を"],["成し遂げられた","なしとげられた"],["。"],["右","みぎ"],["の"],["御手","おて"],["、"],["聖","せい"],["なる"],["御腕","おうで"],["によって"],["主","ぬし"],["は"],["救い","すくい"],["の"],["御業","ごごう"],["を"],["果たされた","はたされた"],["。"]]},{"verse":2,"text":"主は救いを示し恵みの御業を諸国の民の目に現し","tok":[["主","ぬし"],["は"],["救い","すくい"],["を"],["示し","しめし"],["恵み","めぐみ"],["の"],["御業","ごごう"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["目","め"],["に"],["現し","あらわし"]]},{"verse":3,"text":"イスラエルの家に対する慈しみとまことを御心に留められた。地の果てまですべての人はわたしたちの神の救いの御業を見た。","tok":[["イスラエル"],["の"],["家","いえ"],["に"],["対する","たいする"],["慈しみ","いつくしみ"],["と"],["まこと"],["を"],["御心","おこころ"],["に"],["留められた","とめられた"],["。"],["地","ち"],["の"],["果て","はて"],["まで"],["すべて"],["の"],["人","ひと"],["は"],["わたしたち"],["の"],["神","かみ"],["の"],["救い","すくい"],["の"],["御業","ごごう"],["を"],["見た","みた"],["。"]]},{"verse":4,"text":"全地よ、主に向かって喜びの叫びをあげよ。歓声をあげ、喜び歌い、ほめ歌え。","tok":[["全地","ぜんち"],["よ"],["、"],["主に","おもに"],["向かって","むかって"],["喜び","よろこび"],["の"],["叫び","さけび"],["を"],["あげ"],["よ"],["。"],["歓声","かんせい"],["を"],["あげ"],["、"],["喜び歌い","よろこびうたい"],["、"],["ほめ歌","ほめうた"],["え"],["。"]]},{"verse":5,"text":"琴に合わせてほめ歌え琴に合わせ、楽の音に合わせて。","tok":[["琴","こと"],["に"],["合わせて","あわせて"],["ほめ歌","ほめうた"],["え"],["琴","こと"],["に"],["合わせ","あわせ"],["、"],["楽","らく"],["の"],["音","おと"],["に"],["合わせて","あわせて"],["。"]]},{"verse":6,"text":"ラッパを吹き、角笛を響かせて王なる主の御前に喜びの叫びをあげよ。","tok":[["ラッパ"],["を"],["吹き","ふき"],["、"],["角笛","つのぶえ"],["を"],["響かせて","ひびかせて"],["王","おう"],["なる"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["喜び","よろこび"],["の"],["叫び","さけび"],["を"],["あげ"],["よ"],["。"]]},{"verse":7,"text":"とどろけ、海とそこに満ちるもの世界とそこに住むものよ。","tok":[["とどろけ"],["、"],["海","うみ"],["と"],["そこ"],["に"],["満ちる","みちる"],["もの"],["世界","せかい"],["と"],["そこ"],["に"],["住む","すむ"],["もの"],["よ"],["。"]]},{"verse":8,"text":"潮よ、手を打ち鳴らし山々よ、共に喜び歌え","tok":[["潮","しお"],["よ"],["、"],["手","て"],["を"],["打ち鳴らし","うちならし"],["山々","やまやま"],["よ"],["、"],["共","とも"],["に"],["喜び歌え","よろこびうたえ"]]},{"verse":9,"text":"主を迎えて。主は来られる、地を裁くために。主は世界を正しく裁き諸国の民を公平に裁かれる。","tok":[["主","ぬし"],["を"],["迎えて","むかえて"],["。"],["主","ぬし"],["は"],["来られる","こられる"],["、"],["地","ち"],["を"],["裁く","さばく"],["ため"],["に"],["。"],["主","ぬし"],["は"],["世界","せかい"],["を"],["正しく","ただしく"],["裁き","さばき"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["公平","こうへい"],["に"],["裁かれる","さばかれる"],["。"]]}]
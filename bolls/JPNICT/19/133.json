[{"verse":1,"text":"［都に上る歌。ダビデの詩。］見よ、兄弟が共に座っている。なんという恵み、なんという喜び。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["見よ","みよ"],["、"],["兄弟","きょうだい"],["が"],["共","とも"],["に"],["座って","すわって"],["いる"],["。"],["なん"],["と"],["いう"],["恵み","めぐみ"],["、"],["なん"],["と"],["いう"],["喜び","よろこび"],["。"]]},{"verse":2,"text":"かぐわしい油が頭に注がれ、ひげに滴り衣の襟に垂れるアロンのひげに滴り","tok":[["かぐわしい"],["油","あぶら"],["が"],["頭","あたま"],["に"],["注がれ","そそがれ"],["、"],["ひげ"],["に"],["滴り","したたり"],["衣","ころも"],["の"],["襟","えり"],["に"],["垂れる","たれる"],["アロン"],["の"],["ひげ"],["に"],["滴り","したたり"]]},{"verse":3,"text":"ヘルモンにおく露のようにシオンの山々に滴り落ちる。シオンで、主は布告された祝福と、とこしえの命を。","tok":[["ヘルモン"],["に"],["おく"],["露","ろ"],["の"],["よう"],["に"],["シオン"],["の"],["山々","やまやま"],["に"],["滴り落ちる","したたりおちる"],["。"],["シオン"],["で"],["、"],["主","ぬし"],["は"],["布告","ふこく"],["された"],["祝福","しゅくふく"],["と"],["、"],["とこしえ"],["の"],["命","いのち"],["を"],["。"]]}]
[{"verse":1,"text":"ハレルヤ。天において主を賛美せよ 。高い天で主を賛美せよ 。","tok":[["ハレルヤ"],["。"],["天","てん"],["に"],["おいて"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],[" "],["。"],["高い","たかい"],["天","てん"],["で"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],[" "],["。"]]},{"verse":2,"text":"御使いらよ、こぞって主を賛美せよ 。主の万軍よ、こぞって主を賛美せよ 。","tok":[["御使い","おつかい"],["ら"],["よ"],["、"],["こぞって"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],[" "],["。"],["主","ぬし"],["の"],["万","まん"],["軍","ぐん"],["よ"],["、"],["こぞって"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],[" "],["。"]]},{"verse":3,"text":"日よ、月よ主を賛美せよ 。輝く星よ主を賛美せよ 。","tok":[["日","ひ"],["よ"],["、"],["月","つき"],["よ"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],[" "],["。"],["輝く","かがやく"],["星","ほし"],["よ"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],[" "],["。"]]},{"verse":4,"text":"天の天よ天の上にある水よ主を賛美せよ 。","tok":[["天","てん"],["の"],["天","てん"],["よ"],["天","てん"],["の"],["上","うえ"],["に"],["ある"],["水","みず"],["よ"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],[" "],["。"]]},{"verse":5,"text":"主の御名を賛美せよ。主は命じられ、すべてのものは創造された。","tok":[["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["賛美","さんび"],["せよ"],["。"],["主","ぬし"],["は"],["命じられ","めいじられ"],["、"],["すべて"],["の"],["もの"],["は"],["創造","そうぞう"],["された"],["。"]]},{"verse":6,"text":"主はそれらを世々限りなく立て越ええない掟を与えられた。","tok":[["主","ぬし"],["は"],["それ"],["ら"],["を"],["世々","せいせい"],["限りなく","かぎりなく"],["立て","たて"],["越え","こえ"],["えない"],["掟","おきて"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":7,"text":"地において主を賛美せよ 。海に住む竜よ、深淵よ","tok":[["地","ち"],["に"],["おいて"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],[" "],["。"],["海","うみ"],["に"],["住む","すむ"],["竜","りゅう"],["よ"],["、"],["深淵","しんえん"],["よ"]]},{"verse":8,"text":"火よ、雹よ、雪よ、霧よ御言葉を成し遂げる嵐よ","tok":[["火","ひ"],["よ"],["、"],["雹","ひょう"],["よ"],["、"],["雪","ゆき"],["よ"],["、"],["霧","きり"],["よ"],["御言葉","おことば"],["を"],["成し遂げる","なしとげる"],["嵐","あらし"],["よ"]]},{"verse":9,"text":"山々よ、すべての丘よ実を結ぶ木よ、杉の林よ","tok":[["山々","やまやま"],["よ"],["、"],["すべて"],["の"],["丘","おか"],["よ"],["実","じつ"],["を"],["結ぶ","むすぶ"],["木","き"],["よ"],["、"],["杉","すぎ"],["の"],["林","はやし"],["よ"]]},{"verse":10,"text":"野の獣よ、すべての家畜よ地を這うものよ、翼ある鳥よ","tok":[["野","の"],["の"],["獣","けもの"],["よ
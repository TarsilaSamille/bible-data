[{"verse":1,"text":"［賛歌。アサフの詩。］神は神聖な会議の中に立ち神々の間で裁きを行われる。","tok":[["［"],["賛歌","さんか"],["。"],["アサフ"],["の"],["詩","し"],["。"],["］"],["神","かみ"],["は"],["神聖","しんせい"],["な"],["会議","かいぎ"],["の"],["中","なか"],["に"],["立ち","たち"],["神々","かみがみ"],["の"],["間","あいだ"],["で"],["裁き","さばき"],["を"],["行われる","おこなわれる"],["。"]]},{"verse":2,"text":"「いつまであなたたちは不正に裁き神に逆らう者の味方をするのか。〔セラ","tok":[["「"],["いつ"],["まで"],["あなた"],["たち"],["は"],["不正","ふせい"],["に"],["裁き","さばき"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["の"],["味方","みかた"],["を"],["する"],["の"],["か"],["。"],["〔"],["セラ"]]},{"verse":3,"text":"弱者や孤児のために裁きを行い苦しむ人、乏しい人の正しさを認めよ。","tok":[["弱者","じゃくしゃ"],["や"],["孤児","こじ"],["の"],["ため"],["に"],["裁き","さばき"],["を"],["行い","おこない"],["苦しむ","くるしむ"],["人","ひと"],["、"],["乏しい","とぼしい"],["人","ひと"],["の"],["正し","ただし"],["さ"],["を"],["認めよ","みとめよ"],["。"]]},{"verse":4,"text":"弱い人、貧しい人を救い神に逆らう者の手から助け出せ。」","tok":[["弱い","よわい"],["人","ひと"],["、"],["貧しい","まずしい"],["人","ひと"],["を"],["救い神","すくいがみ"],["に"],["逆らう","さからう"],["者","もの"],["の"],["手","て"],["から"],["助け出せ","たすけだせ"],["。"],["」"]]},{"verse":5,"text":"彼らは知ろうとせず、理解せず闇の中を行き来する。地の基はことごとく揺らぐ。","tok":[["彼","かれ"],["ら"],["は"],["知ろう","しろう"],["と"],["せず"],["、"],["理解","りかい"],["せず"],["闇","やみ"],["の"],["中","なか"],["を"],["行き来","いきき"],["する"],["。"],["地","ち"],["の"],["基","もと"],["は"],["ことごとく"],["揺らぐ","ゆらぐ"],["。"]]},{"verse":6,"text":"わたしは言った「あなたたちは神々なのか皆、いと高き方の子らなのか」と。","tok":[["わたし"],["は"],["言った","いった"],["「"],["あなた"],["たち"],["は"],["神々","かみがみ"],["な"],["の"],["か"],["皆","みな"],["、"],["いと"],["高き","たかき"],["方","ほう"],["の"],["子","こ"],["ら"],["な"],["の"],["か"],["」"],["と"],["。"]]},{"verse":7,"text":"しかし、あなたたちも人間として死ぬ。君侯のように、いっせいに没落する。","tok":[["しかし"],["、"],["あなた"],["たち"],["も"],["人間","にんげん"],["として"],["死ぬ","しぬ"],["。"],["君侯","くんこう"],["の"],["よう"],["に"],["、"],["いっせい"],["に"],["没落","ぼつらく"],["する"],["。"]]},{"verse":8,"text":"神よ、立ち上がり、地を裁いてください。あなたはすべての民を嗣業とされるでしょう。","tok":[["神","かみ"],["よ"],["、"],["立ち上がり","たちあがり"],["、"],["地","ち"],["を"],["裁いて","さばいて"],["ください"],["。"],["あなた"],["は"],["すべて"],["の"],["民","たみ"],["を"],["嗣業","しぎょう"],["と"],["されるでしょう"],["。"]]}]
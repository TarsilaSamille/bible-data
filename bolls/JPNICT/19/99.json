[{"verse":1,"text":"主こそ王。諸国の民よ、おののけ。主はケルビムの上に御座を置かれる。地よ、震えよ。","tok":[["主","ぬし"],["こそ"],["王","おう"],["。"],["諸国","しょこく"],["の"],["民","たみ"],["よ"],["、"],["おののけ"],["。"],["主","ぬし"],["は"],["ケルビム"],["の"],["上","うえ"],["に"],["御座","ぎょざ"],["を"],["置かれる","おかれる"],["。"],["地","ち"],["よ"],["、"],["震え","ふるえ"],["よ"],["。"]]},{"verse":2,"text":"主はシオンにいまし、大いなる方。すべての民の上に高くいます。","tok":[["主","ぬし"],["は"],["シオン"],["に"],["いまし"],["、"],["大いなる","おおいなる"],["方","かた"],["。"],["すべて"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["高く","たかく"],["います"],["。"]]},{"verse":3,"text":"御名の大いなること、畏るべきことを告白せよ。主は聖なる方。","tok":[["御名","ぎょめい"],["の"],["大いなる","おおいなる"],["こと"],["、"],["畏るべき","かしこまるべき"],["こと"],["を"],["告白","こくはく"],["せよ"],["。"],["主","ぬし"],["は"],["聖","せい"],["なる"],["方","かた"],["。"]]},{"verse":4,"text":"力強い王、裁きを愛し、公平を固く定めヤコブに対する裁きと恵みの御業を御自ら、成し遂げられる。","tok":[["力強い","ちからづよい"],["王","おう"],["、"],["裁き","さばき"],["を"],["愛し","あいし"],["、"],["公平","こうへい"],["を"],["固く","かたく"],["定め","さだめ"],["ヤコブ"],["に"],["対する","たいする"],["裁き","さばき"],["と"],["恵み","めぐみ"],["の"],["御業","ごごう"],["を"],["御自ら","おみずから"],["、"],["成し遂げられる","なしとげられる"],["。"]]},{"verse":5,"text":"我らの神、主をあがめよ。その足台に向かってひれ伏せ。主は聖なる方。","tok":[["我","われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["あがめよ"],["。"],["その"],["足台","あしだい"],["に"],["向かって","むかって"],["ひれ伏せ","ひれふせ"],["。"],["主","ぬし"],["は"],["聖","せい"],["なる"],["方","かた"],["。"]]},{"verse":6,"text":"主の祭司からはモーセとアロンが御名を呼ぶ者からはサムエルが、主を呼ぶと主は彼らに答えられた。","tok":[["主","ぬし"],["の"],["祭司","さいし"],["から"],["は"],["モーセ"],["と"],["アロン"],["が"],["御名","ぎょめい"],["を"],["呼ぶ","よぶ"],["者","もの"],["から"],["は"],["サムエル"],["が"],["、"],["主","ぬし"],["を"],["呼ぶ","よぶ"],["と"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["に"],["答えられた","こたえられた"],["。"]]},{"verse":7,"text":"神は雲の柱から語りかけ彼らに掟と定めを賜り彼らはそれを守った。","tok":[["神","かみ"],["は"],["雲","くも"],["の"],["柱","はしら"],["から"],["語りかけ","かたりかけ"],["彼","かれ"],["ら"],["に"],["掟","おきて"],["と"],["定め","さだめ"],["を"],["賜り","たまわり"],["彼","かれ"],["ら"],["は"],["それ"],["を"],["守った","まもった"],["。"]]},{"verse":8,"text":"我らの神、主よ、あなたは彼らに答えられた。あなたは彼らを赦す神彼らの咎には報いる神であった。","tok":[["我","われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["に"],["答えられた","こたえられた"],["。"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["赦す","ゆるす"],["神","かみ"],["彼","かれ"],["ら"],["の"],["咎","とが"],["に"],["は"],["報いる","むくいる"],["神","かみ"],["で"],["あった"],["。"]]},{"verse":9,"text":"我らの神、主をあがめよ。その聖なる山に向かってひれ伏せ。我らの神、主は聖なる方。","tok":[["我","われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["を"],["あがめよ"],["。"],["その"],["聖","せい"],["なる"],["山","やま"],["に"],["向かって","むかって"],["ひれ伏せ","ひれふせ"],["。"],["我","われ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["聖","せい"],["なる"],["方","かた"],["。"]]}]
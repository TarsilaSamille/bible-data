[{"verse":1,"text":"バビロンの流れのほとりに座りシオンを思って、わたしたちは泣いた。","tok":[["バビロン"],["の"],["流れ","ながれ"],["の"],["ほとり"],["に"],["座り","すわり"],["シオン"],["を"],["思って","おもって"],["、"],["わたしたち"],["は"],["泣いた","ないた"],["。"]]},{"verse":2,"text":"竪琴は、ほとりの柳の木々に掛けた。","tok":[["竪琴","たてごと"],["は"],["、"],["ほとり"],["の"],["柳","やなぎ"],["の"],["木々","きぎ"],["に"],["掛けた","かけた"],["。"]]},{"verse":3,"text":"わたしたちを捕囚にした民が歌をうたえと言うからわたしたちを嘲る民が、楽しもうとして「歌って聞かせよ、シオンの歌を」と言うから。","tok":[["わたしたち"],["を"],["捕囚","ほしゅう"],["に"],["した"],["民","たみ"],["が"],["歌","うた"],["を"],["うたえ"],["と"],["言う","ゆう"],["から"],["わたしたち"],["を"],["嘲る","あざける"],["民","たみ"],["が"],["、"],["楽しもう","たのしもう"],["として"],["「"],["歌って","うたって"],["聞かせ","きかせ"],["よ"],["、"],["シオン"],["の"],["歌","うた"],["を"],["」"],["と"],["言う","ゆう"],["から"],["。"]]},{"verse":4,"text":"どうして歌うことができようか主のための歌を、異教の地で。","tok":[["どう"],["して"],["歌う","うたう"],["こと"],["が"],["できよう"],["か"],["主","ぬし"],["の"],["ため"],["の"],["歌","うた"],["を"],["、"],["異教","いきょう"],["の"],["地","ち"],["で"],["。"]]},{"verse":5,"text":"エルサレムよもしも、わたしがあなたを忘れるならわたしの右手はなえるがよい。","tok":[["エルサレム"],["よも"],["しも"],["、"],["わたし"],["が"],["あなた"],["を"],["忘れるなら","わすれるなら"],["わたし"],["の"],["右手","みぎて"],["は"],["なえる"],["が"],["よい"],["。"]]},{"verse":6,"text":"わたしの舌は上顎にはり付くがよいもしも、あなたを思わぬときがあるならもしも、エルサレムをわたしの最大の喜びとしないなら。","tok":[["わたし"],["の"],["舌","した"],["は"],["上顎","うわあご"],["に"],["はり"],["付く","つく"],["が"],["よい"],["もし"],["も"],["、"],["あなた"],["を"],["思わぬ","おもわぬ"],["とき"],["が"],["あるなら"],["もし"],["も"],["、"],["エルサレム"],["を"],["わたし"],["の"],["最大","さいだい"],["の"],["喜び","よろこび"],["と"],["しないなら"],["。"]]},{"verse":7,"text":"主よ、覚えていてくださいエドムの子らをエルサレムのあの日を彼らがこう言ったのを「裸にせよ、裸にせよ、この都の基まで。」","tok":[["主","ぬし"],["よ"],["、"],["覚えて","おぼえて"],["いて"],["ください"],["エドム"],["の"],["子","こ"],["ら"],["を"],["エルサレム"],["の"],["あの"],["日","ひ"],["を"],["彼","かれ"],["ら"],["が"],["こう"],["言った","いった"],["の"],["を"],["「"],["裸","はだか"],["に"],["せよ"],["、"],["裸","はだか"],["に"],["せよ"],["、"],["この"],["都","と"],["の"],["基","もと"],["まで"],["。"],["」"]]},{"verse":8,"text":"娘バビロンよ、破壊者よいかに幸いなことかお前がわたしたちにした仕打ちをお前に仕返す者","tok":[["娘","むすめ"],["バビロン"],["よ"],["、"],["破壊者","はかいしゃ"],["よ"],["いかに"],["幸い","さいわい"],["な"],["こと"],["か"],["お前","おまえ"],["が"],["わたしたち"],["に"],["した"],["仕打ち","しうち"],["を"],["お前","おまえ"],["に"],["仕返す","しかえす"],["者","もの"]]},{"verse":9,"text":"お前の幼子を捕えて岩にたたきつける者は。","tok":[["お前","おまえ"],["の"],["幼子","おさなご"],["を"],["捕えて","とらえて"],["岩","いわ"],["に"],["たたきつける"],["者","もの"],["は"],["。"]]}]
[{"verse":1,"text":"［ダビデの詩。賛歌。］わが主に賜った主の御言葉。「わたしの右の座に就くがよい。わたしはあなたの敵をあなたの足台としよう。」","tok":[["［"],["ダビデ"],["の"],["詩","し"],["。"],["賛歌","さんか"],["。"],["］"],["わが"],["主","ぬし"],["に"],["賜った","たまわった"],["主","ぬし"],["の"],["御言葉","おことば"],["。"],["「"],["わたし"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["就く","づく"],["が"],["よい"],["。"],["わたし"],["は"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["足台","あしだい"],["と"],["しよう"],["。"],["」"]]},{"verse":2,"text":"主はあなたの力ある杖をシオンから伸ばされる。敵のただ中で支配せよ。","tok":[["主","ぬし"],["は"],["あなた"],["の"],["力","ちから"],["ある"],["杖","つえ"],["を"],["シオン"],["から"],["伸ばされる","のばされる"],["。"],["敵","てき"],["の"],["ただ中","ただなか"],["で"],["支配","しはい"],["せよ"],["。"]]},{"verse":3,"text":"あなたの民は進んであなたを迎える聖なる方の輝きを帯びてあなたの力が現れ曙の胎から若さの露があなたに降るとき。","tok":[["あなた"],["の"],["民","たみ"],["は"],["進んで","すすんで"],["あなた"],["を"],["迎える","むかえる"],["聖","せい"],["なる"],["方","かた"],["の"],["輝き","かがやき"],["を"],["帯びて","おびて"],["あなた"],["の"],["力","ちから"],["が"],["現れ","あらわれ"],["曙","あけぼの"],["の"],["胎","はら"],["から"],["若","わか"],["さ"],["の"],["露","ろ"],["が"],["あなた"],["に"],["降る","ふる"],["とき"],["。"]]},{"verse":4,"text":"主は誓い、思い返されることはない。「わたしの言葉に従ってあなたはとこしえの祭司メルキゼデク（わたしの正しい王）。」","tok":[["主","ぬし"],["は"],["誓い","ちかい"],["、"],["思い返される","おもいかえされる"],["こと"],["は"],["ない"],["。"],["「"],["わたし"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["あなた"],["は"],["とこしえ"],["の"],["祭司","さいし"],["メルキゼデク"],["（"],["わたし"],["の"],["正しい","ただしい"],["王","おう"],["）"],["。"],["」"]]},{"verse":5,"text":"主はあなたの右に立ち怒りの日に諸王を撃たれる。","tok":[["主","ぬし"],["は"],["あなた"],["の"],["右","みぎ"],["に"],["立ち","たち"],["怒り","いかり"],["の"],["日","ひ"],["に"],["諸王","しょおう"],["を"],["撃たれる","うたれる"],["。"]]},{"verse":6,"text":"主は諸国を裁き、頭となる者を撃ち広大な地をしかばねで覆われる。","tok":[["主","ぬし"],["は"],["諸国","しょこく"],["を"],["裁き","さばき"],["、"],["頭","あたま"],["と"],["なる"],["者","もの"],["を"],["撃ち","うち"],["広大","こうだい"],["な"],["地","ち"],["を"],["しかばね"],["で"],["覆われる","おおわれる"],["。"]]},{"verse":7,"text":"彼はその道にあって、大河から水を飲み頭を高く上げる。","tok":[["彼","かれ"],["は"],["その"],["道","みち"],["に"],["あって"],["、"],["大河","たいが"],["から"],["水","みず"],["を"],["飲み","のみ"],["頭","あたま"],["を"],["高く","たかく"],["上げる","あげる"],["。"]]}]
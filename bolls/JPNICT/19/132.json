[{"verse":1,"text":"［都に上る歌。］主よ、御心に留めてくださいダビデがいかに謙虚にふるまったかを。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["主","ぬし"],["よ"],["、"],["御心","おこころ"],["に"],["留めて","とめて"],["ください"],["ダビデ"],["が"],["いかに"],["謙虚","けんきょ"],["に"],["ふるまった"],["か"],["を"],["。"]]},{"verse":2,"text":"彼は主に誓いヤコブの勇者である神に願をかけました。","tok":[["彼","かれ"],["は"],["主に","おもに"],["誓い","ちかい"],["ヤコブ"],["の"],["勇者","ゆうしゃ"],["で"],["ある"],["神","かみ"],["に"],["願","がん"],["を"],["かけました"],["。"]]},{"verse":3,"text":"「わたしは決してわたしの家に、天幕に入らずわたしの寝室に、寝床に上らず","tok":[["「"],["わたし"],["は"],["決して","けっして"],["わたし"],["の"],["家","いえ"],["に"],["、"],["天幕","てんまく"],["に"],["入らず","はいらず"],["わたし"],["の"],["寝室","しんしつ"],["に"],["、"],["寝床","ねどこ"],["に"],["上らず","のぼらず"]]},{"verse":4,"text":"わたしの目に眠りを与えずまぶたにまどろむことを許すまい","tok":[["わたし"],["の"],["目","め"],["に"],["眠り","ねむり"],["を"],["与えず","あたえず"],["まぶた"],["に"],["まどろむ"],["こと"],["を"],["許すまい","ゆるすまい"]]},{"verse":5,"text":"主のために一つの場所を見いだしヤコブの勇者である神のために神のいますところを定めるまでは。」","tok":[["主","ぬし"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["場所","ばしょ"],["を"],["見いだし","みいだし"],["ヤコブ"],["の"],["勇者","ゆうしゃ"],["で"],["ある"],["神","かみ"],["の"],["ため"],["に"],["神","かみ"],["の"],["います"],["ところ"],["を"],["定める","さだめる"],["まで"],["は"],["。"],["」"]]},{"verse":6,"text":"見よ、わたしたちは聞いたそれがエフラタにとどまっていると。ヤアルの野でわたしたちはそれを見いだした。","tok":[["見よ","みよ"],["、"],["わたしたち"],["は"],["聞いた","きいた"],["それ"],["が"],["エフラタ"],["に"],["とどまって"],["いる"],["と"],["。"],["ヤアル"],["の"],["野","の"],["で"],["わたしたち"],["は"],["それ"],["を"],["見いだした","みいだした"],["。"]]},{"verse":7,"text":"わたしたちは主のいます所に行き御足を置かれる所に向かって伏し拝もう。","tok":[["わたしたち"],["は"],["主","ぬし"],["の"],["います"],["所","ところ"],["に"],["行き","いき"],["御足","おあし"],["を"],["置かれる","おかれる"],["所","ところ"],["に"],["向かって","むかって"],["伏し拝もう","ふしおがもう"],["。"]]},{"verse":8,"text":"主よ、立ち上がりあなたの憩いの地にお進みくださいあなた御自身も、そして御力を示す神の箱も。","tok":[["主","ぬし"],["よ"],["、"],["立ち上がり","たちあがり"],["あなた"],["の"],["憩い","いこい"],["の"],["地","ち"],["に"],["お進み","おすすみ"],["ください"],["あなた"],["御自身","ごじしん"],["も"],["、"],["そして"],["御力","おちから"],["を"],["示す","しめす"],["神","かみ"],["の"],["箱","ばこ"],["も"],["。"]]},{"verse":9,"text":"あなたに仕える祭司らは正義を衣としてまといあなたの慈しみに生きる人々は喜びの叫びをあげるでしょう。","tok":[["あなた"],["に"],["仕える","つかえる"],["祭司","さいし"],["ら"],["は"],["正義","せいぎ"],["を"],["衣","ころも"],["として"],["まとい"],["あなた"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人々","ひとびと"],["は"],["喜び","よろこび"],["の"],["叫び","さけび"],["を"],["あげるでしょう"],["。"]]},{"verse":10,"text":"ダビデはあなたの僕あなたが油注がれたこの人を決してお見捨てになりませんように。","tok":[["ダビデ"],["は"],["あなた"],["の"],["僕","ぼく"],["あなた"],["が"],["油","あぶら"],["注がれた","そそがれた"],["この"],["人","ひと"],["を"],["決して","けっして"],["お見捨て","おみすて"],["に"],["なりません"],["よう"],["に"],["。"]]},{"verse":11,"text":"主はダビデに誓われました。それはまこと。思い返されることはありません。「あなたのもうけた子らの中から王座を継ぐ者を定める。","tok":[["主","ぬし"],["は"],["ダビデ"],["に"],["誓われました","ちかわれました"],["。"],["それ"],["は"],["まこと"],["。"],["思い返される","おもいかえされる"],["こと"],["は"],["ありません"],["。"],["「"],["あなた"],["の"],["もうけた"],["子","こ"],["ら"],["の"],["中","なか"],["から"],["王座","おうざ"],["を"],["継ぐ","つぐ"],["者","もの"],["を"],["定める","さだめる"],["。"]]},{"verse":12,"text":"あなたの子らがわたしの契約とわたしが教える定めを守るなら彼らの子らも、永遠にあなたの王座につく者となる。」","tok":[["あなた"],["の"],["子","こ"],["ら"],["が"],["わたし"],["の"],["契約","けいやく"],["と"],["わたし"],["が"],["教える","おしえる"],["定め","さだめ"],["を"],["守るなら","まもるなら"],["彼","かれ"],["ら"],["の"],["子","こ"],["ら"],["も"],["、"],["永遠","えいえん"],["に"],["あなた"],["の"],["王座","おうざ"],["に"],["つく"],["者","もの"],["と"],["なる"],["。"],["」"]]},{"verse":13,"text":"主はシオンを選びそこに住むことを定められました。","tok":[["主","ぬし"],["は"],["シオン"],["を"],["選び","えらび"],["そこ"],["に"],["住む","すむ"],["こと"],["を"],["定められました","さだめられました"],["。"]]},{"verse":14,"text":"「これは永遠にわたしの憩いの地。ここに住むことをわたしは定める。","tok":[["「"],["これ"],["は"],["永遠","えいえん"],["に"],["わたし"],["の"],["憩い","いこい"],["の"],["地","ち"],["。"],["ここ"],["に"],["住む","すむ"],["こと"],["を"],["わたし"],["は"],["定める","さだめる"],["。"]]},{"verse":15,"text":"シオンの食糧を豊かに祝福し乏しい者に飽きるほどのパンを与えよう。","tok":[["シオン"],["の"],["食糧","しょくりょう"],["を"],["豊か","ゆたか"],["に"],["祝福","しゅくふく"],["し"],["乏しい","とぼしい"],["者","もの"],["に"],["飽きる","あきる"],["ほど"],["の"],["パン"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":16,"text":"祭司らには、救いを衣としてまとわせる。わたしの慈しみに生きる人は喜びの叫びを高くあげるであろう。","tok":[["祭司","さいし"],["ら"],["に"],["は"],["、"],["救い","すくい"],["を"],["衣","ころも"],["として"],["まとわせる"],["。"],["わたし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["は"],["喜び","よろこび"],["の"],["叫び","さけび"],["を"],["高く","たかく"],["あげるで"],["あろう"],["。"]]},{"verse":17,"text":"ダビデのために一つの角をそこに芽生えさせる。わたしが油を注いだ者のために一つの灯を備える。","tok":[["ダビデ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["角","かど"],["を"],["そこ"],["に"],["芽生えさせる","めばえさせる"],["。"],["わたし"],["が"],["油","あぶら"],["を"],["注いだ","そそいだ"],["者","もの"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["灯","あかり"],["を"],["備える","そなえる"],["。"]]},{"verse":18,"text":"彼の敵には、恥を衣としてまとわせる。王冠はダビデの上に花開くであろう。」","tok":[["彼","かれ"],["の"],["敵","てき"],["に"],["は"],["、"],["恥","はじ"],["を"],["衣","ころも"],["として"],["まとわせる"],["。"],["王冠","おうかん"],["は"],["ダビデ"],["の"],["上","うえ"],["に"],["花","はな"],["開くで","ひらくで"],["あろう"],["。"],["」"]]}]
[{"verse":1,"text":"［指揮者によって。ダビデの詩。記念。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["記念","きねん"],["。"],["］"]]},{"verse":2,"text":"神よ、速やかにわたしを救い出し主よ、わたしを助けてください。","tok":[["神","かみ"],["よ"],["、"],["速やか","すみやか"],["に"],["わたし"],["を"],["救い出し","すくいだし"],["主","ぬし"],["よ"],["、"],["わたし"],["を"],["助けて","たすけて"],["ください"],["。"]]},{"verse":3,"text":"わたしの命をねらう者が恥を受け、嘲られわたしを災いに遭わせようと望む者が侮られて退き","tok":[["わたし"],["の"],["命","いのち"],["を"],["ねらう"],["者","もの"],["が"],["恥","はじ"],["を"],["受け","うけ"],["、"],["嘲られ","あざけられ"],["わたし"],["を"],["災い","わざわい"],["に"],["遭わせよう","あわせよう"],["と"],["望む","のぞむ"],["者","もの"],["が"],["侮られて","あなどられて"],["退き","しりぞき"]]},{"verse":4,"text":"はやし立てる者が恥を受けて逃げ去りますように。","tok":[["はやし立てる","はやしたてる"],["者","もの"],["が"],["恥","はじ"],["を"],["受けて","うけて"],["逃げ去ります","にげさります"],["よう"],["に"],["。"]]},{"verse":5,"text":"あなたを尋ね求める人があなたによって喜び祝い、楽しみ御救いを愛する人が神をあがめよといつも歌いますように。","tok":[["あなた"],["を"],["尋ね求める","たずねもとめる"],["人","ひと"],["が"],["あなた"],["によって"],["喜び祝い","よろこびいわい"],["、"],["楽しみ","たのしみ"],["御救い","おすくい"],["を"],["愛する","あいする"],["人","ひと"],["が"],["神","かみ"],["を"],["あがめよ"],["と"],["いつも"],["歌います","うたいます"],["よう"],["に"],["。"]]},{"verse":6,"text":"神よ、わたしは貧しく、身を屈めています。速やかにわたしを訪れてください。あなたはわたしの助け、わたしの逃れ場。主よ、遅れないでください。","tok":[["神","かみ"],["よ"],["、"],["わたし"],["は"],["貧しく","まずしく"],["、"],["身","み"],["を"],["屈めて","かがめて"],["います"],["。"],["速やか","すみやか"],["に"],["わたし"],["を"],["訪れて","おとずれて"],["ください"],["。"],["あなた"],["は"],["わたし"],["の"],["助け","たすけ"],["、"],["わたし"],["の"],["逃れ","のがれ"],["場","ば"],["。"],["主","ぬし"],["よ"],["、"],["遅れないで","おくれないで"],["ください"],["。"]]}]
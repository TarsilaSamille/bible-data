[{"verse":1,"text":"主よ、なぜ遠く離れて立ち苦難の時に隠れておられるのか。","tok":[["主","ぬし"],["よ"],["、"],["なぜ"],["遠く","とおく"],["離れて","はなれて"],["立ち","たち"],["苦難","くなん"],["の"],["時","とき"],["に"],["隠れて","かくれて"],["おられる"],["の"],["か"],["。"]]},{"verse":2,"text":"貧しい人が神に逆らう傲慢な者に責め立てられてその策略に陥ろうとしているのに。","tok":[["貧しい","まずしい"],["人","ひと"],["が"],["神","かみ"],["に"],["逆らう","さからう"],["傲慢","ごうまん"],["な"],["者","もの"],["に"],["責め立てられて","せめたてられて"],["その"],["策略","さくりゃく"],["に"],["陥ろう","おちいろう"],["として"],["いる"],["のに"],["。"]]},{"verse":3,"text":"神に逆らう者は自分の欲望を誇る。貪欲であり、主をたたえながら、侮っている。","tok":[["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["は"],["自分","じぶん"],["の"],["欲望","よくぼう"],["を"],["誇る","ほこる"],["。"],["貪欲","どんよく"],["で"],["あり"],["、"],["主","ぬし"],["を"],["たたえ"],["ながら"],["、"],["侮って","あなどって"],["いる"],["。"]]},{"verse":4,"text":"神に逆らう者は高慢で神を求めず何事も神を無視してたくらむ。","tok":[["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["は"],["高慢","こうまん"],["で"],["神","かみ"],["を"],["求めず","もとめず"],["何事","なにごと"],["も"],["神","かみ"],["を"],["無視","むし"],["して"],["たくらむ"],["。"]]},{"verse":5,"text":"あなたの裁きは彼にとってはあまりにも高い。彼の道はどのようなときにも力をもち自分に反対する者に自分を誇示し","tok":[["あなた"],["の"],["裁き","さばき"],["は"],["彼","かれ"],["にとって"],["は"],["あまり"],["に"],["も"],["高い","たかい"],["。"],["彼","かれ"],["の"],["道","みち"],["は"],["どのような"],["とき"],["に"],["も"],["力","ちから"],["を"],["もち"],["自分","じぶん"],["に"],["反対","はんたい"],["する"],["者","もの"],["に"],["自分","じぶん"],["を"],["誇示","こじ"],["し"]]},{"verse":6,"text":"「わたしは揺らぐことなく、代々に幸せで災いに遭うことはない」と心に思う。","tok":[["「"],["わたし"],["は"],["揺らぐ","ゆらぐ"],["こと"],["なく"],["、"],["代々","だいだい"],["に"],["幸せ","しあわせ"],["で"],["災い","わざわい"],["に"],["遭う","あう"],["こと"],["は"],["ない"],["」"],["と"],["心","こころ"],["に"],["思う","おもう"],["。"]]},{"verse":7,"text":"口に呪い、詐欺、搾取を満たし舌に災いと悪を隠す。","tok":[["口","くち"],["に"],["呪い","のろい"],["、"],["詐欺","さぎ"],["、"],["搾取","さくしゅ"],["を"],["満たし","みたし"],["舌","した"],["に"],["災い","わざわい"],["と"],["悪","あく"],["を"],["隠す","かくす"],["。"]]},{"verse":8,"text":"村はずれの物陰に待ち伏せし不運な人に目を付け、罪もない人をひそかに殺す。","tok":[["村はずれ","むらはずれ"],["の"],["物陰","ものかげ"],["に"],["待ち伏せ","まちぶせ"],["し"],["不運","ふうん"],["な"],["人","ひと"],["に"],["目","め"],["を"],["付け","つけ"],["、"],["罪","つみ"],["も"],["ない"],["人","ひと"],["を"],["ひそか"],["に"],["殺す","ころす"],["。"]]},{"verse":9,"text":"茂みの陰の獅子のように隠れ、待ち伏せ貧しい人を捕えようと待ち伏せ貧しい人を網に捕えて引いて行く。","tok":[["茂み","しげみ"],["の"],["陰","かげ"],["の"],["獅子","しし"],["の"],["よう"],["に"],["隠れ","かくれ"],["、"],["待ち伏せ","まちぶせ"],["貧しい","まずしい"],["人","ひと"],["を"],["捕えよう","とらえよう"],["と"],["待ち伏せ","まちぶせ"],["貧しい","まずしい"],["人","ひと"],["を"],["網","あみ"],["に"],["捕えて","とらえて"],["引いて","ひいて"],["行く","いく"],["。"]]},{"verse":10,"text":"不運な人はその手に陥り倒れ、うずくまり","tok":[["不運","ふうん"],["な"],["人","ひと"],["は"],["その"],["手","て"],["に"],["陥り","おちいり"],["倒れ","たおれ"],["、"],["うずくまり"]]},{"verse":11,"text":"心に思う「神はわたしをお忘れになった。御顔を隠し、永久に顧みてくださらない」と。","tok":[["心","こころ"],["に"],["思う","おもう"],["「"],["神","かみ"],["は"],["わたし"],["を"],["お忘れ","おわすれ"],["に"],["なった"],["。"],["御顔","おかお"],["を"],["隠し","かくし"],["、"],["永久","えいきゅう"],["に"],["顧みて","かえりみて"],["くださらない"],["」"],["と"],["。"]]},{"verse":12,"text":"立ち上がってください、主よ。神よ、御手を上げてください。貧しい人を忘れないでください。","tok":[["立ち上がって","たちあがって"],["ください"],["、"],["主","ぬし"],["よ"],["。"],["神","かみ"],["よ"],["、"],["御手","おて"],["を"],["上げて","あげて"],["ください"],["。"],["貧しい","まずしい"],["人","ひと"],["を"],["忘れないで","わすれないで"],["ください"],["。"]]},{"verse":13,"text":"なぜ、逆らう者は神を侮り罰などはない、と心に思うのでしょう。","tok":[["なぜ"],["、"],["逆らう","さからう"],["者","もの"],["は"],["神","かみ"],["を"],["侮り","あなどり"],["罰","ばつ"],["など"],["は"],["ない"],["、"],["と"],["心","こころ"],["に"],["思う","おもう"],["の"],["でしょう"],["。"]]},{"verse":14,"text":"あなたは必ず御覧になって御手に労苦と悩みをゆだねる人を顧みてくださいます。不運な人はあなたにすべてをおまかせします。あなたはみなしごをお助けになります。","tok":[["あなた"],["は"],["必ず","かならず"],["御覧","ごらん"],["に"],["なって"],["御手","おて"],["に"],["労苦","ろうく"],["と"],["悩み","なやみ"],["を"],["ゆだねる"],["人","ひと"],["を"],["顧みて","かえりみて"],["くださいます"],["。"],["不運","ふうん"],["な"],["人","ひと"],["は"],["あなた"],["に"],["すべて"],["を"],["おまかせ"],["します"],["。"],["あなた"],["は"],["みなしご"],["を"],["お助け","おたすけ"],["に"],["なります"],["。"]]},{"verse":15,"text":"逆らう者、悪事を働く者の腕を挫き彼の反逆を余すところなく罰してください。","tok":[["逆らう","さからう"],["者","もの"],["、"],["悪事","あくじ"],["を"],["働く","はたらく"],["者","もの"],["の"],["腕","うで"],["を"],["挫き","くじき"],["彼","かれ"],["の"],["反逆","はんぎゃ
[{"verse":1,"text":"［指揮者によって。「ゆり」に合わせて。定め。ミクタム。ダビデの詩。教え。","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["「"],["ゆり"],["」"],["に"],["合わせて","あわせて"],["。"],["定め","さだめ"],["。"],["ミクタム"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["教え","おしえ"],["。"]]},{"verse":2,"text":"ダビデがアラム‧ナハライムおよびツォバのアラムと戦い、ヨアブが帰って来て塩の谷で一万二千人のエドム人を討ち取ったとき。］","tok":[["ダビデ"],["が"],["アラム"],["‧"],["ナハライム"],["および"],["ツォバ"],["の"],["アラム"],["と"],["戦い","たたかい"],["、"],["ヨアブ"],["が"],["帰って","かえって"],["来て","きて"],["塩","しお"],["の"],["谷","たに"],["で"],["一万二千","いちまんにせん"],["人","にん"],["の"],["エドム人","えどむにん"],["を"],["討ち取った","うちとった"],["とき"],["。"],["］"]]},{"verse":3,"text":"神よ、あなたは我らを突き放し怒って我らを散らされた。どうか我らを立ち帰らせてください。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["は"],["我","われ"],["ら"],["を"],["突き放し","つきはなし"],["怒って","おこって"],["我","われ"],["ら"],["を"],["散らされた","ちらされた"],["。"],["どう"],["か"],["我","われ"],["ら"],["を"],["立ち帰らせて","たちかえらせて"],["ください"],["。"]]},{"verse":4,"text":"あなたは大地を揺るがせ、打ち砕かれた。どうか砕かれたところを癒してください大地は動揺しています。","tok":[["あなた"],["は"],["大地","だいち"],["を"],["揺るがせ","ゆるがせ"],["、"],["打ち砕かれた","うちくだかれた"],["。"],["どう"],["か"],["砕かれた","くだかれた"],["ところ"],["を"],["癒して","いやして"],["ください"],["大地","だいち"],["は"],["動揺","どうよう"],["して"],["います"],["。"]]},{"verse":5,"text":"あなたは御自分の民に辛苦を思い知らせよろめき倒れるほど、辛苦の酒を飲ませられた。","tok":[["あなた"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["に"],["辛苦","しんく"],["を"],["思い知らせ","おもいしらせ"],["よろめき"],["倒れる","たおれる"],["ほど"],["、"],["辛苦","しんく"],["の"],["酒","さけ"],["を"],["飲ませられた","のませられた"],["。"]]},{"verse":6,"text":"あなたを畏れる人に対してそれを警告とし真理を前にしてその警告を受け入れるようにされた。〔セラ","tok":[["あなた"],["を"],["畏れる","おそれる"],["人","ひと"],["に対して","にたいして"],["それ"],["を"],["警告","けいこく"],["と"],["し"],["真理","しんり"],["を"],["前","まえ"],["に"],["して"],["その"],["警告","けいこく"],["を"],["受け入れる","うけいれる"],["よう"],["に"],["された"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"あなたの愛する人々が助け出されるように右の御手でお救いください。それを我らへの答えとしてください。","tok":[["あなた"],["の"],["愛する","あいする"],["人々","ひとびと"],["が"],["助け出される","たすけだされる"],["よう"],["に"],["右","みぎ"],["の"],["御手","おて"],["で"],["お救い","おすくい"],["ください"],["。"],["それ"],["を"],["我","われ"],["ら"],["へ"],["の"],["答え","こたえ"],["として"],["ください"],["。"]]},{"verse":8,"text":"神は聖所から宣言された。「わたしは喜び勇んでシケムを分配しよう。スコトの野を測量しよう。","tok":[["神","かみ"],["は"],["聖","せい"],["所","しょ"],["から"],["宣言","せんげん"],["された"],["。"],["「"],["わたし"],["は"],["喜び勇んで","よろこびいさんで"],["シケム"],["を"],["分配","ぶんぱい"],["しよう"],["。"],["スコト"],["の"],["野","の"],["を"],["測量","そくりょう"],["しよう"],["。"]]},{"verse":9,"text":"ギレアドはわたしのものマナセもわたしのものエフライムはわたしの頭の兜ユダはわたしの采配","tok":[["ギレアド"],["は"],["わたし"],["の"],["もの"],["マナセ"],["も"],["わたし"],["の"],["もの"],["エフライム"],["は"],["わたし"],["の"],["頭","あたま"],["の"],["兜","かぶと"],["ユダ"],["は"],["わたし"],["の"],["采配","さいはい"]]},{"verse":10,"text":"モアブはわたしのたらい。エドムにわたしの履物を投げペリシテにわたしの叫びを響かせよう。」","tok":[["モアブ"],["は"],["わたし"],["の"],["たらい"],["。"],["エドム"],["に"],["わたし"],["の"],["履物","はきもの"],["を"],["投げ","なげ"],["ペリシテ"],["に"],["わたし"],["の"],["叫び","さけび"],["を"],["響かせよう","ひびかせよう"],["。"],["」"]]},{"verse":11,"text":"包囲された町に誰がわたしを導いてくれるのか。エドムに、誰がわたしを先導してくれるのか。","tok":[["包囲","ほうい"],["された"],["町","まち"],["に"],["誰","だれ"],["が"],["わたし"],["を"],["導いて","みちびいて"],["くれる"],["の"],["か"],["。"],["エドム"],["に"],["、"],["誰","だれ"],["が"],["わたし"],["を"],["先導","せんどう"],["して"],["くれる"],["の"],["か"],["。"]]},{"verse":12,"text":"神よ、あなたは我らを突き放されたのか。神よ、あなたは我らと共に出陣してくださらないのか。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["は"],["我","われ"],["ら"],["を"],["突き放された","つきはなされた"],["の"],["か"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["我","われ"],["ら"],["と"],["共","とも"],["に"],["出陣","しゅつじん"],["して"],["くださらない"],["の"],["か"],["。"]]},{"verse":13,"text":"どうか我らを助け、敵からお救いください。人間の与える救いはむなしいものです。","tok":[["どう"],["か"],["我","われ"],["ら"],["を"],["助け","たすけ"],["、"],["敵","てき"],["から"],["お救い","おすくい"],["ください"],["。"],["人間","にんげん"],["の"],["与える","あたえる"],["救い","すくい"],["は"],["むなしい"],["もの"],["です"],["。"]]},{"verse":14,"text":"神と共に我らは力を振るいます。神が敵を踏みにじってくださいます。","tok":[["神","かみ"],["と"],["共","とも"],["に"],["我","われ"],["ら"],["は"],["力","ちから"],["を"],["振るいます","ふるいます"],["。"],["神","かみ"],["が"],["敵","てき"],["を"],["踏みにじって","ふみにじって"],["くださいます"],["。"]]}]
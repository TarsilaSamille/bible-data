[{"verse":1,"text":"［指揮者に合わせて。コラの子の詩。アラモト調。歌。］","tok":[["［"],["指揮者","しきしゃ"],["に"],["合わせて","あわせて"],["。"],["コラ"],["の"],["子","こ"],["の"],["詩","し"],["。"],["アラモト"],["調","ちょう"],["。"],["歌","うた"],["。"],["］"]]},{"verse":2,"text":"神はわたしたちの避けどころ、わたしたちの砦。苦難のとき、必ずそこにいまして助けてくださる。","tok":[["神","かみ"],["は"],["わたしたち"],["の"],["避け","よけ"],["どころ"],["、"],["わたしたち"],["の"],["砦","とりで"],["。"],["苦難","くなん"],["の"],["とき"],["、"],["必ず","かならず"],["そこ"],["に"],["いまして"],["助けて","たすけて"],["くださる"],["。"]]},{"verse":3,"text":"わたしたちは決して恐れない地が姿を変え山々が揺らいで海の中に移るとも","tok":[["わたしたち"],["は"],["決して","けっして"],["恐れない","おそれない"],["地","ち"],["が"],["姿","すがた"],["を"],["変え","かえ"],["山々","やまやま"],["が"],["揺らいで","ゆらいで"],["海","うみ"],["の"],["中","なか"],["に"],["移る","うつる"],["と"],["も"]]},{"verse":4,"text":"海の水が騒ぎ、沸き返りその高ぶるさまに山々が震えるとも。〔セラ","tok":[["海","うみ"],["の"],["水","みず"],["が"],["騒ぎ","さわぎ"],["、"],["沸き返り","わきかえり"],["その"],["高ぶる","たかぶる"],["さま"],["に"],["山々","やまやま"],["が"],["震える","ふるえる"],["とも"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"大河とその流れは、神の都に喜びを与えるいと高き神のいます聖所に。","tok":[["大河","たいが"],["と"],["その"],["流れ","ながれ"],["は"],["、"],["神","かみ"],["の"],["都","と"],["に"],["喜び","よろこび"],["を"],["与える","あたえる"],["い"],["と"],["高き","たかき"],["神","かみ"],["の"],["います"],["聖","せい"],["所","しょ"],["に"],["。"]]},{"verse":6,"text":"神はその中にいまし、都は揺らぐことがない。夜明けとともに、神は助けをお与えになる。","tok":[["神","かみ"],["は"],["その"],["中","なか"],["に"],["いまし"],["、"],["都","と"],["は"],["揺らぐ","ゆらぐ"],["こと"],["が"],["ない"],["。"],["夜明け","よあけ"],["と"],["とも"],["に"],["、"],["神","かみ"],["は"],["助け","たすけ"],["を"],["お与え","おあたえ"],["に"],["なる"],["。"]]},{"verse":7,"text":"すべての民は騒ぎ、国々は揺らぐ。神が御声を出されると、地は溶け去る。","tok":[["すべて"],["の"],["民","たみ"],["は"],["騒ぎ","さわぎ"],["、"],["国々","くにぐに"],["は"],["揺らぐ","ゆらぐ"],["。"],["神","かみ"],["が"],["御声","おこえ"],["を"],["出される","だされる"],["と"],["、"],["地","ち"],["は"],["溶け去る","とけさる"],["。"]]},{"verse":8,"text":"万軍の主はわたしたちと共にいます。ヤコブの神はわたしたちの砦の塔。〔セラ","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["わたしたち"],["と"],["共","とも"],["に"],["います"],["。"],["ヤコブ"],["の"],["神","かみ"],["は"],["わたしたち"],["の"],["砦","とりで"],["の"],["塔","とう"],["。"],["〔"],["セラ"]]},{"verse":9,"text":"主の成し遂げられることを仰ぎ見よう。主はこの地を圧倒される。","tok":[["主","ぬし"],["の"],["成し遂げられる","なしとげられる"],["こと"],["を"],["仰ぎ見よう","あおぎみよう"],["。"],["主","ぬし"],["は"],["この"],["地","ち"],["を"],["圧倒","あっとう"],["される"],["。"]]},{"verse":10,"text":"地の果てまで、戦いを断ち弓を砕き槍を折り、盾を焼き払われる。","tok":[["地","ち"],["の"],["果て","はて"],["まで"],["、"],["戦い","たたかい"],["を"],["断ち","たち"],["弓","ゆみ"],["を"],["砕き","くだき"],["槍","やり"],["を"],["折り","おり"],["、"],["盾","たて"],["を"],["焼き払われる","やきはらわれる"],["。"]]},{"verse":11,"text":"「力を捨てよ、知れわたしは神。国々にあがめられ、この地であがめられる。」","tok":[["「"],["力","ちから"],["を"],["捨てよ","すてよ"],["、"],["知れ","しれ"],["わたし"],["は"],["神","かみ"],["。"],["国々","くにぐに"],["に"],["あがめられ"],["、"],["この"],["地","ち"],["で"],["あがめられる"],["。"],["」"]]},{"verse":12,"text":"万軍の主はわたしたちと共にいます。ヤコブの神はわたしたちの砦の塔。〔セラ","tok":[["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["わたしたち"],["と"],["共","とも"],["に"],["います"],["。"],["ヤコブ"],["の"],["神","かみ"],["は"],["わたしたち"],["の"],["砦","とりで"],["の"],["塔","とう"],["。"],["〔"],["セラ"]]}]
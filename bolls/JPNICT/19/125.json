[{"verse":1,"text":"［都に上る歌。］主に依り頼む人は、シオンの山。揺らぐことなく、とこしえに座る。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["主","ぬし"],["に"],["依り頼む","よりたのむ"],["人","ひと"],["は"],["、"],["シオン"],["の"],["山","やま"],["。"],["揺らぐ","ゆらぐ"],["こと"],["なく"],["、"],["とこしえ"],["に"],["座る","すわる"],["。"]]},{"verse":2,"text":"山々はエルサレムを囲み主は御自分の民を囲んでいてくださる今も、そしてとこしえに。","tok":[["山々","やまやま"],["は"],["エルサレム"],["を"],["囲み","かこみ"],["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["を"],["囲んで","かこんで"],["いて"],["くださる"],["今","いま"],["も"],["、"],["そして"],["とこしえ"],["に"],["。"]]},{"verse":3,"text":"主に従う人に割り当てられた地に主に逆らう者の笏が置かれることのないように。主に従う人が悪に手を伸ばすことのないように。","tok":[["主に","おもに"],["従う","したがう"],["人","ひと"],["に"],["割り当てられた","わりあてられた"],["地","ち"],["に"],["主に","おもに"],["逆らう","さからう"],["者","もの"],["の"],["笏","しゃく"],["が"],["置かれる","おかれる"],["こと"],["の"],["ない"],["よう"],["に"],["。"],["主に","おもに"],["従う","したがう"],["人","ひと"],["が"],["悪","わる"],["に"],["手","て"],["を"],["伸ばす","のばす"],["こと"],["の"],["ない"],["よう"],["に"],["。"]]},{"verse":4,"text":"主よ、良い人、心のまっすぐな人を幸せにしてください。","tok":[["主","ぬし"],["よ"],["、"],["良い","よい"],["人","ひと"],["、"],["心","こころ"],["の"],["まっすぐ"],["な"],["人","ひと"],["を"],["幸せ","しあわせ"],["に"],["して"],["ください"],["。"]]},{"verse":5,"text":"よこしまな自分の道にそれて行く者を主よ、悪を行う者と共に追い払ってください。イスラエルの上に平和がありますように。","tok":[["よこしま"],["な"],["自分","じぶん"],["の"],["道","みち"],["に"],["それ"],["て"],["行く","いく"],["者","もの"],["を"],["主","ぬし"],["よ"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["と"],["共","とも"],["に"],["追い払って","おいはらって"],["ください"],["。"],["イスラエル"],["の"],["上","うえ"],["に"],["平和","へいわ"],["が"],["あります"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"［賛歌。ダビデの詩。ダビデがユダの荒れ野にいたとき。］","tok":[["［"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["ダビデ"],["が"],["ユダ"],["の"],["荒れ野","あれの"],["に"],["いた"],["とき"],["。"],["］"]]},{"verse":2,"text":"神よ、あなたはわたしの神。わたしはあなたを捜し求めわたしの魂はあなたを渇き求めます。あなたを待って、わたしのからだは乾ききった大地のように衰え水のない地のように渇き果てています。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["。"],["わたし"],["は"],["あなた"],["を"],["捜し求め","さがしもとめ"],["わたし"],["の"],["魂","たましい"],["は"],["あなた"],["を"],["渇き","かわき"],["求めます","もとめます"],["。"],["あなた"],["を"],["待って","まって"],["、"],["わたし"],["の"],["からだ"],["は"],["乾き","かわき"],["きった"],["大地","だいち"],["の"],["よう"],["に"],["衰え","おとろえ"],["水","みず"],["の"],["ない"],["地","ち"],["の"],["よう"],["に"],["渇き","かわき"],["果てて","はてて"],["います"],["。"]]},{"verse":3,"text":"今、わたしは聖所であなたを仰ぎ望みあなたの力と栄えを見ています。","tok":[["今","いま"],["、"],["わたし"],["は"],["聖","せい"],["所","しょ"],["で"],["あなた"],["を"],["仰ぎ","あおぎ"],["望み","のぞみ"],["あなた"],["の"],["力","ちから"],["と"],["栄え","はえ"],["を"],["見て","みて"],["います"],["。"]]},{"verse":4,"text":"あなたの慈しみは命にもまさる恵み。わたしの唇はあなたをほめたたえます。","tok":[["あなた"],["の"],["慈しみ","いつくしみ"],["は"],["命","いのち"],["に"],["も"],["まさる"],["恵み","めぐみ"],["。"],["わたし"],["の"],["唇","くちびる"],["は"],["あなた"],["を"],["ほめたたえます"],["。"]]},{"verse":5,"text":"命のある限り、あなたをたたえ手を高く上げ、御名によって祈ります。","tok":[["命","いのち"],["の"],["ある"],["限り","かぎり"],["、"],["あなた"],["を"],["たたえ"],["手","て"],["を"],["高く","たかく"],["上げ","あげ"],["、"],["御名","ぎょめい"],["によって"],["祈ります","いのります"],["。"]]},{"verse":6,"text":"わたしの魂は満ち足りました乳と髄のもてなしを受けたように。わたしの唇は喜びの歌をうたいわたしの口は賛美の声をあげます。","tok":[["わたし"],["の"],["魂","たましい"],["は"],["満ち足りました","みちたりました"],["乳","ちち"],["と"],["髄","ずい"],["の"],["もてなし"],["を"],["受けた","うけた"],["よう"],["に"],["。"],["わたし"],["の"],["唇","くちびる"],["は"],["喜び","よろこび"],["の"],["歌","うた"],["を"],["うたい"],["わたし"],["の"],["口","くち"],["は"],["賛美","さんび"],["の"],["声","こえ"],["を"],["あげます"],["。"]]},{"verse":7,"text":"床に就くときにも御名を唱えあなたへの祈りを口ずさんで夜を過ごします。","tok":[["床","ゆか"],["に"],["就く","つく"],["とき"],["に"],["も"],["御名","ぎょめい"],["を"],["唱え","となえ"],["あなた"],["へ"],["の"],["祈り","いのり"],["を"],["口ずさんで","くちずさんで"],["夜","よる"],["を"],["過ごします","すごします"],["。"]]},{"verse":8,"text":"あなたは必ずわたしを助けてくださいます。あなたの翼の陰でわたしは喜び歌います。","tok":[["あなた"],["は"],["必ず","かならず"],["わたし"],["を"],["助けて","たすけて"],["くださいます"],["。"],["あなた"],["の"],["翼","つばさ"],["の"],["陰","かげ"],["で"],["わたし"],["は"],["喜び歌います","よろこびうたいます"],["。"]]},{"verse":9,"text":"わたしの魂はあなたに付き従いあなたは右の御手でわたしを支えてくださいます。","tok":[["わたし"],["の"],["魂","たましい"],["は"],["あなた"],["に"],["付き従い","つきしたがい"],["あなた"],["は"],["右","みぎ"],["の"],["御手","おて"],["で"],["わたし"],["を"],["支えて","ささえて"],["くださいます"],["。"]]},{"verse":10,"text":"わたしの命を奪おうとする者は必ず滅ぼされ陰府の深みに追いやられますように。","tok":[["わたし"],["の"],["命","いのち"],["を"],["奪おう","うばおう"],["と"],["する"],["者","もの"],["は"],["必ず","かならず"],["滅ぼされ","ほろぼされ"],["陰府","よみ"],["の"],["深み","ふかみ"],["に"],["追いやられます","おいやられます"],["よう"],["に"],["。"]]},{"verse":11,"text":"剣にかかり、山犬の餌食となりますように。","tok":[["剣","けん"],["に"],["かかり"],["、"],["山犬","やまいぬ"],["の"],["餌食","えじき"],["と"],["なります"],["よう"],["に"],["。"]]},{"verse":12,"text":"神によって、王は喜び祝い誓いを立てた者は誇りますように。偽って語る口は、必ず閉ざされますように。","tok":[["神","かみ"],["によって"],["、"],["王","おう"],["は"],["喜び祝い","よろこびいわい"],["誓い","ちかい"],["を"],["立てた","たてた"],["者","もの"],["は"],["誇ります","ほこります"],["よう"],["に"],["。"],["偽って","いつわって"],["語る","かたる"],["口","くち"],["は"],["、"],["必ず","かならず"],["閉ざされます","とざされます"],["よう"],["に"],["。"]]}]
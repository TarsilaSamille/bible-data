[{"verse":1,"text":"［都に上る歌。］主の僕らよ、こぞって主をたたえよ。夜ごと、主の家にとどまる人々よ","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["主","ぬし"],["の"],["僕","ぼく"],["ら"],["よ"],["、"],["こぞって"],["主","ぬし"],["を"],["たたえ"],["よ"],["。"],["夜","よる"],["ごと"],["、"],["主","ぬし"],["の"],["家","いえ"],["に"],["とどまる"],["人々","ひとびと"],["よ"]]},{"verse":2,"text":"聖所に向かって手を上げ、主をたたえよ。","tok":[["聖","せい"],["所","しょ"],["に"],["向かって","むかって"],["手","て"],["を"],["上げ","あげ"],["、"],["主","ぬし"],["を"],["たたえ"],["よ"],["。"]]},{"verse":3,"text":"天地を造られた主がシオンからあなたを祝福してくださるように。","tok":[["天地","てんち"],["を"],["造られた","つくられた"],["主","ぬし"],["が"],["シオン"],["から"],["あなた"],["を"],["祝福","しゅくふく"],["して"],["くださる"],["よう"],["に"],["。"]]}]
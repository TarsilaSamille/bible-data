[{"verse":1,"text":"［ダビデの詩。賛歌。］慈しみと裁きをわたしは歌い主よ、あなたに向かって、ほめ歌います。","tok":[["［"],["ダビデ"],["の"],["詩","し"],["。"],["賛歌","さんか"],["。"],["］"],["慈しみ","いつくしみ"],["と"],["裁き","さばき"],["を"],["わたし"],["は"],["歌い","うたい"],["主","ぬし"],["よ"],["、"],["あなた"],["に"],["向かって","むかって"],["、"],["ほめ歌","ほめうた"],["います"],["。"]]},{"verse":2,"text":"完全な道について解き明かします。いつ、あなたはわたしを訪れてくださるのでしょうか。わたしは家にあって無垢な心をもって行き来します。","tok":[["完全","かんぜん"],["な"],["道","みち"],["について"],["解き明かします","ときあかします"],["。"],["いつ"],["、"],["あなた"],["は"],["わたし"],["を"],["訪れて","おとずれて"],["くださる"],["の"],["でしょう"],["か"],["。"],["わたし"],["は"],["家","いえ"],["に"],["あって"],["無垢","むく"],["な"],["心","こころ"],["を"],["もって"],["行き来","いきき"],["します"],["。"]]},{"verse":3,"text":"卑しいことを目の前に置かず背く者の行いを憎みまつわりつくことを許さず","tok":[["卑しい","いやしい"],["こと"],["を"],["目","め"],["の"],["前","まえ"],["に"],["置かず","おかず"],["背く","そむく"],["者","もの"],["の"],["行い","おこない"],["を"],["憎み","にくみ"],["まつわりつく"],["こと"],["を"],["許さず","ゆるさず"]]},{"verse":4,"text":"曲がった心を退け悪を知ることはありません。","tok":[["曲がった","まがった"],["心","こころ"],["を"],["退け","しりぞけ"],["悪","あく"],["を"],["知る","しる"],["こと"],["は"],["ありません"],["。"]]},{"verse":5,"text":"隠れて友をそしる者を滅ぼし傲慢な目、驕る心を持つ者を許しません。","tok":[["隠れて","かくれて"],["友","とも"],["を"],["そしる"],["者","もの"],["を"],["滅ぼし","ほろぼし"],["傲慢","ごうまん"],["な"],["目","め"],["、"],["驕る","おごる"],["心","こころ"],["を"],["持つ","もつ"],["者","もの"],["を"],["許しません","ゆるしません"],["。"]]},{"verse":6,"text":"わたしはこの地の信頼のおける人々に目を留めわたしと共に座に着かせ完全な道を歩く人を、わたしに仕えさせます。","tok":[["わたし"],["は"],["この"],["地","ち"],["の"],["信頼","しんらい"],["の"],["おける"],["人々","ひとびと"],["に"],["目","め"],["を"],["留め","とめ"],["わたし"],["と"],["共","とも"],["に"],["座","ざ"],["に"],["着かせ","つかせ"],["完全","かんぜん"],["な"],["道","みち"],["を"],["歩く","あるく"],["人","ひと"],["を"],["、"],["わたし"],["に"],["仕えさせます","つかえさせます"],["。"]]},{"verse":7,"text":"わたしの家においては人を欺く者を座に着かせず偽って語る者をわたしの目の前に立たせません。","tok":[["わたし"],["の"],["家","いえ"],["に"],["おいて"],["は"],["人","ひと"],["を"],["欺く","あざむく"],["者","もの"],["を"],["座","ざ"],["に"],["着かせず","つかせず"],["偽って","いつわって"],["語る","かたる"],["者","もの"],["を"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["立たせません","たたせません"],["。"]]},{"verse":8,"text":"朝ごとに、わたしはこの地の逆らう者を滅ぼし悪を行う者をことごとく、主の都から断ちます。","tok":[["朝","あさ"],["ごと"],["に"],["、"],["わたし"],["は"],["この"],["地","ち"],["の"],["逆らう","さからう"],["者","もの"],["を"],["滅ぼし","ほろぼし"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["を"],["ことごとく"],["、"],["主","ぬし"],["の"],["都","と"],["から"],["断ちます","たちます"],["。"]]}]
[{"verse":1,"text":"［ダビデの詩。］主はわたしの光、わたしの救いわたしは誰を恐れよう。主はわたしの命の砦わたしは誰の前におののくことがあろう。","tok":[["［"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["は"],["わたし"],["の"],["光","ひかり"],["、"],["わたし"],["の"],["救い","すくい"],["わたし"],["は"],["誰","だれ"],["を"],["恐れよう","おそれよう"],["。"],["主","ぬし"],["は"],["わたし"],["の"],["命","いのち"],["の"],["砦","とりで"],["わたし"],["は"],["誰","だれ"],["の"],["前","まえ"],["に"],["おののく"],["こと"],["が"],["あろう"],["。"]]},{"verse":2,"text":"さいなむ者が迫りわたしの肉を食い尽くそうとするがわたしを苦しめるその敵こそ、かえってよろめき倒れるであろう。","tok":[["さいなむ"],["者","もの"],["が"],["迫り","せまり"],["わたし"],["の"],["肉","にく"],["を"],["食い","くい"],["尽くそう","つくそう"],["と"],["する"],["が"],["わたし"],["を"],["苦しめる","くるしめる"],["その"],["敵","てき"],["こそ"],["、"],["かえって"],["よろめき"],["倒れるで","たおれるで"],["あろう"],["。"]]},{"verse":3,"text":"彼らがわたしに対して陣を敷いてもわたしの心は恐れない。わたしに向かって戦いを挑んで来てもわたしには確信がある。","tok":[["彼","かれ"],["ら"],["が"],["わたし"],["に対して","にたいして"],["陣","じん"],["を"],["敷いて","しいて"],["も"],["わたし"],["の"],["心","こころ"],["は"],["恐れない","おそれない"],["。"],["わたし"],["に"],["向かって","むかって"],["戦い","たたかい"],["を"],["挑んで","いどんで"],["来て","きて"],["も"],["わたし"],["に"],["は"],["確信","かくしん"],["が"],["ある"],["。"]]},{"verse":4,"text":"ひとつのことを主に願い、それだけを求めよう。命のある限り、主の家に宿り主を仰ぎ望んで喜びを得その宮で朝を迎えることを。","tok":[["ひと"],["つ"],["の"],["こと"],["を"],["主に","おもに"],["願い","ねがい"],["、"],["それ"],["だけ"],["を"],["求めよう","もとめよう"],["。"],["命","いのち"],["の"],["ある"],["限り","かぎり"],["、"],["主","ぬし"],["の"],["家","いえ"],["に"],["宿り主","やどりぬし"],["を"],["仰ぎ","あおぎ"],["望んで","のぞんで"],["喜び","よろこび"],["を"],["得","え"],["その"],["宮","みや"],["で"],["朝","あさ"],["を"],["迎える","むかえる"],["こと"],["を"],["。"]]},{"verse":5,"text":"災いの日には必ず、主はわたしを仮庵にひそませ幕屋の奥深くに隠してくださる。岩の上に立たせ","tok":[["災い","わざわい"],["の"],["日","ひ"],["に"],["は"],["必ず","かならず"],["、"],["主","ぬし"],["は"],["わたし"],["を"],["仮庵","かりあん"],["に"],["ひそませ"],["幕屋","まくや"],["の"],["奥深く","おくふかく"],["に"],["隠して","かくして"],["くださる"],["。"],["岩","いわ"],["の"],["上","うえ"],["に"],["立たせ","たたせ"]]},{"verse":6,"text":"群がる敵の上に頭を高く上げさせてくださる。わたしは主の幕屋でいけにえをささげ、歓声をあげ主に向かって賛美の歌をうたう。","tok":[["群がる","むらがる"],["敵","てき"],["の"],["上","うえ"],["に"],["頭","あたま"],["を"],["高く","たかく"],["上げさせて","あげさせて"],["くださる"],["。"],["わたし"],["は"],["主","ぬし"],["の"],["幕屋","まくや"],["で"],["いけにえ"],["を"],["ささげ"],["、"],["歓声","かんせい"],["を"],["あげ"],["主","ぬし"],["に"],["向かって","むかって"],["賛美","さんび"],["の"],["歌","うた"],["を"],["うたう"],["。"]]},{"verse":7,"text":"主よ、呼び求めるわたしの声を聞き憐れんで、わたしに答えてください。","tok":[["主","ぬし"],["よ"],["、"],["呼び求める","よびもとめる"],["わたし"],["の"],["声","こえ"],["を"],["聞き","きき"],["憐れんで","あわれんで"],["、"],["わたし"],["に"],["答えて","こたえて"],["ください"],["。"]]},{"verse":8,"text":"心よ、主はお前に言われる「わたしの顔を尋ね求めよ」と。主よ、わたしは御顔を尋ね求めます。","tok":[["心","こころ"],["よ"],["、"],["主","ぬし"],["は"],["お前","おまえ"],["に"],["言われる","いわれる"],["「"],["わたし"],["の"],["顔","かお"],["を"],["尋ね求めよ","たずねもとめよ"],["」"],["と"],["。"],["主","ぬし"],["よ"],["、"],["わたし"],["は"],["御顔","おかお"],["を"],["尋ね求めます","たずねもとめます"],["。"]]},{"verse":9,"text":"御顔を隠すことなく、怒ることなくあなたの僕を退けないでください。あなたはわたしの助け。救いの神よ、わたしを離れないでください見捨てないでください。","tok":[["御顔","おかお"],["を"],["隠す","かくす"],["こと"],["なく"],["、"],["怒る","おこる"],["こと"],["なく"],["あなた"],["の"],["僕","ぼく"],["を"],["退けないで","しりぞけないで"],["ください"],["。"],["あなた"],["は"],["わたし"],["の"],["助け","たすけ"],["。"],["救い","すくい"],["の"],["神","かみ"],["よ"],["、"],["わたし"],["を"],["離れないで","はなれないで"],["ください"],["見捨てないで","みすてないで"],["ください"],["。"]]},{"verse":10,"text":"父母はわたしを見捨てようとも主は必ず、わたしを引き寄せてくださいます。","tok":[["父母","ふぼ"],["は"],["わたし"],["を"],["見捨てよう","みすてよう"],["とも"],["主","ぬし"],["は"],["必ず","かならず"],["、"],["わたし"],["を"],["引き寄せて","ひきよせて"],["くださいます"],["。"]]},{"verse":11,"text":"主よ、あなたの道を示し平らな道に導いてください。わたしを陥れようとする者がいるのです。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["の"],["道","みち"],["を"],["示し","しめし"],["平ら","たいら"],["な"],["道","みち"],["に"],["導いて","みちびいて"],["ください"],["。"],["わたし"],["を"],["陥れよう","おとしいれよう"],["と"],["する"],["者","もの"],["が"],["いる"],["の"],["です"],["。"]]},{"verse":12,"text":"貪欲な敵にわたしを渡さないでください。偽りの証人、不法を言い広める者がわたしに逆らって立ちました。","tok":[["貪欲","どんよく"],["な"],["敵","てき"],["に"],["わたし"],["を"],["渡さないで","わたさないで"],["ください"],["。"],["偽り","いつわり"],["の"],["証人","しょうにん"],["、"],["不法","ふほう"],["を"],["言い広める","いいひろめる"],["者","もの"],["が"],["わたし"],["に"],["逆らって","さからって"],["立ちました","たちました"],["。"]]},{"verse":13,"text":"わたしは信じます命あるものの地で主の恵みを見ることを。","tok":[["わたし"],["は"],["信じます","しんじます"],["命","いのち"],["ある"],["もの"],["の"],["地","ち"],["で"],["主","ぬし"],["の"],["恵み","めぐみ"],["を"],["見る","みる"],["こと"],["を"],["。"]]},{"verse":14,"text":"主を待ち望め雄々しくあれ、心を強くせよ。主を待ち望め。","tok":[["主","ぬし"],["を"],["待ち望め","まちのぞめ"],["雄々しく","おおしく"],["あれ"],["、"],["心","こころ"],["を"],["強く","つよく"],["せよ"],["。"],["主","ぬし"],["を"],["待ち望め","まちのぞめ"],["。"]]}]
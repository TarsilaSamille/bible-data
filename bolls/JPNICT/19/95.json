[{"verse":1,"text":"主に向かって喜び歌おう。救いの岩に向かって喜びの叫びをあげよう。","tok":[["主に","おもに"],["向かって","むかって"],["喜び歌おう","よろこびうたおう"],["。"],["救い","すくい"],["の"],["岩","いわ"],["に"],["向かって","むかって"],["喜び","よろこび"],["の"],["叫び","さけび"],["を"],["あげよう"],["。"]]},{"verse":2,"text":"御前に進み、感謝をささげ楽の音に合わせて喜びの叫びをあげよう。","tok":[["御前","ごぜん"],["に"],["進み","すすみ"],["、"],["感謝","かんしゃ"],["を"],["ささげ"],["楽","らく"],["の"],["音","おと"],["に"],["合わせて","あわせて"],["喜び","よろこび"],["の"],["叫び","さけび"],["を"],["あげよう"],["。"]]},{"verse":3,"text":"主は大いなる神すべての神を超えて大いなる王。","tok":[["主","ぬし"],["は"],["大いなる","おおいなる"],["神","かみ"],["すべて"],["の"],["神","かみ"],["を"],["超えて","こえて"],["大いなる","おおいなる"],["王","おう"],["。"]]},{"verse":4,"text":"深い地の底も御手の内にあり山々の頂も主のもの。","tok":[["深い","ふかい"],["地","ち"],["の"],["底","そこ"],["も"],["御手の内","おてのうち"],["に"],["あり"],["山々","やまやま"],["の"],["頂","いただき"],["も"],["主","ぬし"],["の"],["もの"],["。"]]},{"verse":5,"text":"海も主のもの、それを造られたのは主。陸もまた、御手によって形づくられた。","tok":[["海","うみ"],["も"],["主","ぬし"],["の"],["もの"],["、"],["それ"],["を"],["造られた","つくられた"],["の"],["は"],["主","ぬし"],["。"],["陸","りく"],["も"],["また"],["、"],["御手","おて"],["によって"],["形づくられた","かたちづくられた"],["。"]]},{"verse":6,"text":"わたしたちを造られた方主の御前にひざまずこう。共にひれ伏し、伏し拝もう。","tok":[["わたしたち"],["を"],["造られた","つくられた"],["方","ほう"],["主","しゅ"],["の"],["御前","ごぜん"],["に"],["ひざまずこう"],["。"],["共","とも"],["に"],["ひれ伏し","ひれふし"],["、"],["伏し拝もう","ふしおがもう"],["。"]]},{"verse":7,"text":"主はわたしたちの神、わたしたちは主の民主に養われる群れ、御手の内にある羊。今日こそ、主の声に聞き従わなければならない。","tok":[["主","ぬし"],["は"],["わたしたち"],["の"],["神","かみ"],["、"],["わたしたち"],["は"],["主","ぬし"],["の"],["民主","みんしゅ"],["に"],["養われる","やしなわれる"],["群れ","むれ"],["、"],["御手の内","おてのうち"],["に"],["ある"],["羊","ひつじ"],["。"],["今日","きょう"],["こそ"],["、"],["主","ぬし"],["の"],["声","こえ"],["に"],["聞き従わなければ","ききしたがわなければ"],["ならない"],["。"]]},{"verse":8,"text":"「あの日、荒れ野のメリバやマサでしたように心を頑にしてはならない。","tok":[["「"],["あの"],["日","ひ"],["、"],["荒れ野","あれの"],["の"],["メリバ"],["や"],["マサ"],["でした"],["よう"],["に"],["心","こころ"],["を"],["頑","がん"],["に"],["して"],["は"],["ならない"],["。"]]},{"verse":9,"text":"あのとき、あなたたちの先祖はわたしを試みた。わたしの業を見ながら、なおわたしを試した。","tok":[["あの"],["とき"],["、"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["は"],["わたし"],["を"],["試みた","こころみた"],["。"],["わたし"],["の"],["業","ごう"],["を"],["見","み"],["ながら"],["、"],["なお"],["わたし"],["を"],["試した","ためした"],["。"]]},{"verse":10,"text":"四十年の間、わたしはその世代をいとい心の迷う民と呼んだ。彼らはわたしの道を知ろうとしなかった。","tok":[["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["わたし"],["は"],["その"],["世代","せだい"],["を"],["いとい"],["心","こころ"],["の"],["迷う","まよう"],["民","たみ"],["と"],["呼んだ","よんだ"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["道","みち"],["を"],["知ろう","しろう"],["と"],["しなかった"],["。"]]},{"verse":11,"text":"わたしは怒り彼らをわたしの憩いの地に入れないと誓った。」","tok":[["わたし"],["は"],["怒り","いかり"],["彼","かれ"],["ら"],["を"],["わたし"],["の"],["憩い","いこい"],["の"],["地","ち"],["に"],["入れない","いれない"],["と"],["誓った","ちかった"],["。"],["」"]]}]
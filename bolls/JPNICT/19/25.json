[{"verse":1,"text":"［ダビデの詩。］主よ、わたしの魂はあなたを仰ぎ望み","tok":[["［"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["わたし"],["の"],["魂","たましい"],["は"],["あなた"],["を"],["仰ぎ","あおぎ"],["望み","のぞみ"]]},{"verse":2,"text":"わたしの神よ、あなたに依り頼みます。どうか、わたしが恥を受けることのないように敵が誇ることのないようにしてください。","tok":[["わたし"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["に"],["依り頼みます","よりたのみます"],["。"],["どう"],["か"],["、"],["わたし"],["が"],["恥","はじ"],["を"],["受ける","うける"],["こと"],["の"],["ない"],["よう"],["に"],["敵","てき"],["が"],["誇る","ほこる"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":3,"text":"あなたに望みをおく者はだれも決して恥を受けることはありません。いたずらに人を欺く者が恥を受けるのです。","tok":[["あなた"],["に"],["望み","のぞみ"],["を"],["おく"],["者","もの"],["は"],["だれ"],["も"],["決して","けっして"],["恥","はじ"],["を"],["受ける","うける"],["こと"],["は"],["ありません"],["。"],["いたずら"],["に"],["人","ひと"],["を"],["欺く","あざむく"],["者","もの"],["が"],["恥","はじ"],["を"],["受ける","うける"],["の"],["です"],["。"]]},{"verse":4,"text":"主よ、あなたの道をわたしに示しあなたに従う道を教えてください。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["の"],["道","みち"],["を"],["わたし"],["に"],["示し","しめし"],["あなた"],["に"],["従う","したがう"],["道","みち"],["を"],["教えて","おしえて"],["ください"],["。"]]},{"verse":5,"text":"あなたのまことにわたしを導いてください。教えてくださいあなたはわたしを救ってくださる神。絶えることなくあなたに望みをおいています。","tok":[["あなた"],["の"],["まこと"],["に"],["わたし"],["を"],["導いて","みちびいて"],["ください"],["。"],["教えて","おしえて"],["ください"],["あなた"],["は"],["わたし"],["を"],["救って","すくって"],["くださる"],["神","かみ"],["。"],["絶える","たえる"],["こと"],["なく"],["あなた"],["に"],["望み","のぞみ"],["を"],["おいて"],["います"],["。"]]},{"verse":6,"text":"主よ思い起こしてくださいあなたのとこしえの憐れみと慈しみを。","tok":[["主","ぬし"],["よ"],["思い起こして","おもいおこして"],["ください"],["あなた"],["の"],["とこしえ"],["の"],["憐れみ","あわれみ"],["と"],["慈しみ","いつくしみ"],["を"],["。"]]},{"verse":7,"text":"わたしの若いときの罪と背きは思い起こさず慈しみ深く、御恵みのために主よ、わたしを御心に留めてください。","tok":[["わたし"],["の"],["若い","わかい"],["とき"],["の"],["罪","つみ"],["と"],["背き","そむき"],["は"],["思い起こさず","おもいおこさず"],["慈しみ深く","いつくしみぶかく"],["、"],["御恵み","おめぐみ"],["の"],["ため"],["に"],["主","ぬし"],["よ"],["、"],["わたし"],["を"],["御心","おこころ"],["に"],["留めて","とめて"],["ください"],["。"]]},{"verse":8,"text":"主は恵み深く正しくいまし罪人に道を示してくださいます。","tok":[["主","ぬし"],["は"],["恵み","めぐみ"],["深く","ふかく"],["正しく","ただしく"],["いまし"],["罪人","ざいにん"],["に"],["道","みち"],["を"],["示して","しめして"],["くださいます"],["。"]]},{"verse":9,"text":"裁きをして貧しい人を導き主の道を貧しい人に教えてくださいます。","tok":[["裁き","さばき"],["を"],["して"],["貧しい","まずしい"],["人","ひと"],["を"],["導き","みちびき"],["主","ぬし"],["の"],["道","みち"],["を"],["貧しい","まずしい"],["人","ひと"],["に"],["教えて","おしえて"],["くださいます"],["。"]]},{"verse":10,"text":"その契約と定めを守る人にとって主の道はすべて、慈しみとまこと。","tok":[["その"],["契約","けいやく"],["と"],["定め","さだめ"],["を"],["守る","まもる"],["人","ひと"],["にとって"],["主","ぬし"],["の"],["道","みち"],["は"],["すべて"],["、"],["慈しみ","いつくしみ"],["と"],["まこと"],["。"]]},{"verse":11,"text":"主よ、あなたの御名のために罪深いわたしをお赦しください。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["の"],["御名","ぎょめい"],["の"],["ため"],["に"],["罪深い","つみぶかい"],["わたし"],["を"],["お赦し","おゆるし"],["ください"],["。"]]},{"verse":12,"text":"主を畏れる人は誰か。主はその人に選ぶべき道を示されるであろう。","tok":[["主","ぬし"],["を"],["畏れる","おそれる"],["人","ひと"],["は"],["誰","だれ"],["か"],["。"],["主","ぬし"],["は"],["その"],["人","ひと"],["に"],["選ぶべき","えらぶべき"],["道","みち"],["を"],["示されるで","しめされるで"],["あろう"],["。"]]},{"verse":13,"text":"その人は恵みに満たされて宿り子孫は地を継ぐであろう。","tok":[["その"],["人","ひと"],["は"],["恵み","めぐみ"],["に"],["満たされて","みたされて"],["宿り","やどり"],["子孫","しそん"],["は"],["地","ち"],["を"],["継ぐで","つぐで"],["あろう"],["。"]]},{"verse":14,"text":"主を畏れる人に主は契約の奥義を悟らせてくださる。","tok":[["主","ぬし"],["を"],["畏れる","おそれる"],["人","ひと"],["に"],["主","ぬし"],["は"],["契約","けいやく"],["の"],["奥義","おうぎ"],["を"],["悟らせて","さとらせて"],["くださる"],["。"]]},{"verse":15,"text":"わたしはいつも主に目を注いでいます。わたしの足を網から引き出してくださる方に。","tok":[["わたし"],["は"],["いつも"],["主に","おもに"],["目","め"],["を"],["注いで","そそいで"],["います"],["。"],["わたし"],["の"],["足","あし"],["を"],["網","あみ"],["から"],["引き出して","ひきだして"],["くださる"],["方","かた"],["に"],["。"]]},{"verse":16,"text":"御顔を向けて、わたしを憐れんでください。わたしは貧しく、孤独です。","tok":[["御顔","おかお"],["を"],["向けて","むけて"],["、"],["わたし"],["を"],["憐れんで","あわれんで"],["ください"],["。"],["わたし"],["は"],["貧しく","まずしく"],["、"],["孤独","こどく"],["です"],["。"]]},{"verse":17,"text":"悩む心を解き放ち痛みからわたしを引き出してください。","tok":[["悩む","なやむ"],["心","こころ"],["を"],["解き放ち","ときはなち"],["痛み","いたみ"],["から"],[
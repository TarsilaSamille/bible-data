[{"verse":1,"text":"神よ、あなたの裁きを望みます。わたしに代わって争ってください。あなたの慈しみを知らぬ民、欺く者よこしまな者から救ってください。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["の"],["裁き","さばき"],["を"],["望みます","のぞみます"],["。"],["わたし"],["に"],["代わって","かわって"],["争って","あらそって"],["ください"],["。"],["あなた"],["の"],["慈しみ","いつくしみ"],["を"],["知らぬ","しらぬ"],["民","たみ"],["、"],["欺く","あざむく"],["者","もの"],["よこしま"],["な"],["者","もの"],["から"],["救って","すくって"],["ください"],["。"]]},{"verse":2,"text":"あなたはわたしの神、わたしの砦。なぜ、わたしを見放されたのか。なぜ、わたしは敵に虐げられ嘆きつつ行き来するのか。","tok":[["あなた"],["は"],["わたし"],["の"],["神","かみ"],["、"],["わたし"],["の"],["砦","とりで"],["。"],["なぜ"],["、"],["わたし"],["を"],["見放された","みはなされた"],["の"],["か"],["。"],["なぜ"],["、"],["わたし"],["は"],["敵","てき"],["に"],["虐げられ","しいたげられ"],["嘆き","なげき"],["つつ"],["行き来","いきき"],["する"],["の"],["か"],["。"]]},{"verse":3,"text":"あなたの光とまことを遣わしてください。彼らはわたしを導き聖なる山、あなたのいますところにわたしを伴ってくれるでしょう。","tok":[["あなた"],["の"],["光","ひかり"],["と"],["まこと"],["を"],["遣わして","つかわして"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["を"],["導き","みちびき"],["聖","せい"],["なる"],["山","やま"],["、"],["あなた"],["の"],["います"],["ところ"],["に"],["わたし"],["を"],["伴って","ともなって"],["くれるでしょう"],["。"]]},{"verse":4,"text":"神の祭壇にわたしは近づきわたしの神を喜び祝い琴を奏でて感謝の歌をうたいます。神よ、わたしの神よ。","tok":[["神","かみ"],["の"],["祭壇","さいだん"],["に"],["わたし"],["は"],["近づき","ちかづき"],["わたし"],["の"],["神","かみ"],["を"],["喜び祝い","よろこびいわい"],["琴","こと"],["を"],["奏でて","かなでて"],["感謝","かんしゃ"],["の"],["歌","うた"],["を"],["うたいます"],["。"],["神","かみ"],["よ"],["、"],["わたし"],["の"],["神","かみ"],["よ"],["。"]]},{"verse":5,"text":"なぜうなだれるのか、わたしの魂よなぜ呻くのか。神を待ち望め。わたしはなお、告白しよう「御顔こそ、わたしの救い」と。わたしの神よ。","tok":[["なぜ"],["うなだれる"],["の"],["か"],["、"],["わたし"],["の"],["魂","たましい"],["よ"],["なぜ"],["呻く","うめく"],["の"],["か"],["。"],["神","かみ"],["を"],["待ち望め","まちのぞめ"],["。"],["わたし"],["は"],["なお"],["、"],["告白","こくはく"],["しよう"],["「"],["御顔","おかお"],["こそ"],["、"],["わたし"],["の"],["救い","すくい"],["」"],["と"],["。"],["わたし"],["の"],["神","かみ"],["よ"],["。"]]}]
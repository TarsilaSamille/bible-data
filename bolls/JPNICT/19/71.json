[{"verse":1,"text":"主よ、御もとに身を寄せます。とこしえに恥に落とすことなく","tok":[["主","ぬし"],["よ"],["、"],["御もと","おもと"],["に"],["身","み"],["を"],["寄せます","よせます"],["。"],["とこしえ"],["に"],["恥","はじ"],["に"],["落とす","おとす"],["こと"],["なく"]]},{"verse":2,"text":"恵みの御業によって助け、逃れさせてください。あなたの耳をわたしに傾け、お救いください。","tok":[["恵み","めぐみ"],["の"],["御業","ごごう"],["によって"],["助け","たすけ"],["、"],["逃れさせて","のがれさせて"],["ください"],["。"],["あなた"],["の"],["耳","みみ"],["を"],["わたし"],["に"],["傾け","かたむけ"],["、"],["お救い","おすくい"],["ください"],["。"]]},{"verse":3,"text":"常に身を避けるための住まい、岩となりわたしを救おうと定めてください。あなたはわたしの大岩、わたしの砦。","tok":[["常","つね"],["に"],["身","み"],["を"],["避ける","さける"],["ため"],["の"],["住まい","すまい"],["、"],["岩","いわ"],["と"],["なり"],["わたし"],["を"],["救おう","すくおう"],["と"],["定めて","さだめて"],["ください"],["。"],["あなた"],["は"],["わたし"],["の"],["大岩","おおいわ"],["、"],["わたし"],["の"],["砦","とりで"],["。"]]},{"verse":4,"text":"わたしの神よ、あなたに逆らう者の手から悪事を働く者、不法を働く者の手からわたしを逃れさせてください。","tok":[["わたし"],["の"],["神","かみ"],["よ"],["、"],["あなた"],["に"],["逆らう","さからう"],["者","もの"],["の"],["手","て"],["から"],["悪事","あくじ"],["を"],["働く","はたらく"],["者","もの"],["、"],["不法","ふほう"],["を"],["働く","はたらく"],["者","もの"],["の"],["手","て"],["から"],["わたし"],["を"],["逃れさせて","のがれさせて"],["ください"],["。"]]},{"verse":5,"text":"主よ、あなたはわたしの希望。主よ、わたしは若いときからあなたに依り頼み","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["希望","きぼう"],["。"],["主","ぬし"],["よ"],["、"],["わたし"],["は"],["若い","わかい"],["とき"],["から"],["あなた"],["に"],["依り頼み","よりたのみ"]]},{"verse":6,"text":"母の胎にあるときからあなたに依りすがって来ました。あなたは母の腹からわたしを取り上げてくださいました。わたしは常にあなたを賛美します。","tok":[["母","はは"],["の"],["胎","はら"],["に"],["ある"],["とき"],["から"],["あなた"],["に"],["依り","より"],["すがって"],["来ました","きました"],["。"],["あなた"],["は"],["母","はは"],["の"],["腹","はら"],["から"],["わたし"],["を"],["取り上げて","とりあげて"],["くださいました"],["。"],["わたし"],["は"],["常","つね"],["に"],["あなた"],["を"],["賛美","さんび"],["します"],["。"]]},{"verse":7,"text":"多くの人はわたしに驚きます。あなたはわたしの避けどころ、わたしの砦。","tok":[["多く","おおく"],["の"],["人","ひと"],["は"],["わたし"],["に"],["驚きます","おどろきます"],["。"],["あなた"],["は"],["わたし"],["の"],["避け","よけ"],["どころ"],["、"],["わたし"],["の"],["砦","とりで"],["。"]]},{"verse":8,"text":"わたしの口は賛美に満
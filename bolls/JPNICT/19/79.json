[{"verse":1,"text":"［賛歌。アサフの詩。］神よ、異国の民があなたの嗣業を襲いあなたの聖なる神殿を汚しエルサレムを瓦礫の山としました。","tok":[["［"],["賛歌","さんか"],["。"],["アサフ"],["の"],["詩","し"],["。"],["］"],["神","かみ"],["よ"],["、"],["異国","いこく"],["の"],["民","たみ"],["が"],["あなた"],["の"],["嗣業","しぎょう"],["を"],["襲い","おそい"],["あなた"],["の"],["聖","せい"],["なる"],["神殿","しんでん"],["を"],["汚し","よごし"],["エルサレム"],["を"],["瓦礫","がれき"],["の"],["山","やま"],["と"],["しました"],["。"]]},{"verse":2,"text":"あなたの僕らの死体を空の鳥の餌としあなたの慈しみに生きた人々の肉を地の獣らの餌としました。","tok":[["あなた"],["の"],["僕","ぼく"],["ら"],["の"],["死体","したい"],["を"],["空","そら"],["の"],["鳥","とり"],["の"],["餌","えさ"],["と"],["し"],["あなた"],["の"],["慈しみ","いつくしみ"],["に"],["生きた","いきた"],["人々","ひとびと"],["の"],["肉","にく"],["を"],["地","ち"],["の"],["獣","けもの"],["ら"],["の"],["餌","えさ"],["と"],["しました"],["。"]]},{"verse":3,"text":"彼らは、エルサレムの周囲にこの人々の血を水のように流します。葬る者もありません。","tok":[["彼","かれ"],["ら"],["は"],["、"],["エルサレム"],["の"],["周囲","しゅうい"],["に"],["この"],["人々","ひとびと"],["の"],["血","ち"],["を"],["水","みず"],["の"],["よう"],["に"],["流します","ながします"],["。"],["葬る","ほうむる"],["者","もの"],["も"],["ありません"],["。"]]},{"verse":4,"text":"わたしたちは近隣の民に辱められ周囲の民に嘲られ、そしられています。","tok":[["わたしたち"],["は"],["近隣","きんりん"],["の"],["民","たみ"],["に"],["辱められ","はずかしめられ"],["周囲","しゅうい"],["の"],["民","たみ"],["に"],["嘲られ","あざけられ"],["、"],["そしられて"],["います"],["。"]]},{"verse":5,"text":"主よ、いつまで続くのでしょう。あなたは永久に憤っておられるのでしょうか。あなたの激情は火と燃え続けるのでしょうか。","tok":[["主","ぬし"],["よ"],["、"],["いつ"],["まで"],["続く","つづく"],["の"],["でしょう"],["。"],["あなた"],["は"],["永久","えいきゅう"],["に"],["憤って","いきどおって"],["おられる"],["の"],["でしょう"],["か"],["。"],["あなた"],["の"],["激情","げきじょう"],["は"],["火","ひ"],["と"],["燃え","もえ"],["続ける","つづける"],["の"],["でしょう"],["か"],["。"]]},{"verse":6,"text":"御怒りを注いでくださいあなたを知ろうとしない異国の民の上にあなたの御名を呼び求めない国々の上に。","tok":[["御怒り","おいかり"],["を"],["注いで","そそいで"],["ください"],["あなた"],["を"],["知ろう","しろう"],["と"],["しない"],["異国","いこく"],["の"],["民","たみ"],["の"],["上","うえ"],["に"],["あなた"],["の"],["御名","ぎょめい"],["を"],["呼び求めない","よびもとめない"],["国々","くにぐに"],["の"],["上","うえ"],["に"],["。"]]},{"verse":7,"text":"彼らはヤコブを食いものにしその住みかを荒廃させました。","tok":[["彼","かれ"],["ら"],["は"],["ヤコブ"],["を"],["食いもの","くいもの"],["に"],["し"],["その"],["住みか","すみか"],["を"],["荒廃","こうはい"],["させました"],["。"]]},{"verse":8,"text":"どうか、わたしたちの昔の悪に御心を留めず御憐れみを速やかに差し向けてください。わたしたちは弱り果てました。","tok":[["どう"],["か"],["、"],["わたしたち"],["の"],["昔","むかし"],["の"],["悪","わる"],["に"],["御心","おこころ"],["を"],["留めず","とめず"],["御憐れみ","おあわれみ"],["を"],["速やか","すみやか"],["に"],["差し向けて","さしむけて"],["ください"],["。"],["わたしたち"],["は"],["弱り","よわり"],["果てました","はてました"],["。"]]},{"verse":9,"text":"わたしたちの救いの神よ、わたしたちを助けてあなたの御名の栄光を輝かせてください。御名のために、わたしたちを救い出しわたしたちの罪をお赦しください。","tok":[["わたしたち"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["、"],["わたしたち"],["を"],["助けて","たすけて"],["あなた"],["の"],["御名","ぎょめい"],["の"],["栄光","えいこう"],["を"],["輝かせて","かがやかせて"],["ください"],["。"],["御名","ぎょめい"],["の"],["ため"],["に"],["、"],["わたしたち"],["を"],["救い出し","すくいだし"],["わたしたち"],["の"],["罪","つみ"],["を"],["お赦し","おゆるし"],["ください"],["。"]]},{"verse":10,"text":"どうして異国の民に言わせてよいでしょうか「彼らの神はどこにいる」と。あなたの僕らの注ぎ出された血に対する報復を異国の民の中で、わたしたちが目の前に見ることができますように。","tok":[["どう"],["して"],["異国","いこく"],["の"],["民","たみ"],["に"],["言わせて","いわせて"],["よいでしょう"],["か"],["「"],["彼","かれ"],["ら"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["」"],["と"],["。"],["あなた"],["の"],["僕","ぼく"],["ら"],["の"],["注ぎ","そそぎ"],["出された","だされた"],["血","ち"],["に"],["対する","たいする"],["報復","ほうふく"],["を"],["異国","いこく"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["、"],["わたしたち"],["が"],["目","め"],["の"],["前","まえ"],["に"],["見る","みる"],["こと"],["が"],["できます"],["よう"],["に"],["。"]]},{"verse":11,"text":"捕われ人の嘆きが御前に届きますように。御腕の力にふさわしく死に定められている人々を生き長らえさせてください。","tok":[["捕われ人","とらわれにん"],["の"],["嘆き","なげき"],["が"],["御前","ごぜん"],["に"],["届きます","とどきます"],["よう"],["に"],["。"],["御腕","おうで"],["の"],["力","ちから"],["に"],["ふさわしく"],["死に","しに"],["定められて","さだめられて"],["いる"],["人々","ひとびと"],["を"],["生き長らえさせて","いきながらえさせて"],["ください"],["。"]]},{"verse":12,"text":"主よ、近隣の民のふところにあなたを辱めた彼らの辱めを七倍にして返してください。","tok":[["主","ぬし"],["よ"],["、"],["近隣","きんりん"],["の"],["民","たみ"],["の"],["ふところ"],["に"],["あなた"],["を"],["辱めた","はずかしめた"],["彼","かれ"],["ら"],["の"],["辱め","はずかしめ"],["を"],["七","しち"],["倍","ばい"],["に"],["して"],["返して","かえして"],["ください"],["。"]]},{"verse":13,"text":"わたしたちはあなたの民あなたに養われる羊の群れ。とこしえに、あなたに感謝をささげ代々に、あなたの栄誉を語り伝えます。","tok":[["わたしたち"],["は"],["あなた"],["の"],["民","たみ"],["あなた"],["に"],["養われる","やしなわれる"],["羊","ひつじ"],["の"],["群れ","むれ"],["。"],["とこしえ"],["に"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげ"],["代々","だいだい"],["に"],["、"],["あなた"],["の"],["栄誉","えいよ"],["を"],["語り伝えます","かたりつたえます"],["。"]]}]
[{"verse":1,"text":"［賛歌。ダビデの詩。］主よ、わたしはあなたを呼びます。速やかにわたしに向かいあなたを呼ぶ声に耳を傾けてください。","tok":[["［"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["呼びます","よびます"],["。"],["速やか","すみやか"],["に"],["わたし"],["に"],["向かい","むかい"],["あなた"],["を"],["呼ぶ","よぶ"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"]]},{"verse":2,"text":"わたしの祈りを御前に立ち昇る香りとし高く上げた手を夕べの供え物としてお受けください。","tok":[["わたし"],["の"],["祈り","いのり"],["を"],["御前","ごぜん"],["に"],["立ち昇る","たちのぼる"],["香り","かおり"],["と"],["し"],["高く","たかく"],["上げた","あげた"],["手","て"],["を"],["夕べ","ゆうべ"],["の"],["供え物","そなえもの"],["として"],["お受け","おうけ"],["ください"],["。"]]},{"verse":3,"text":"主よ、わたしの口に見張りを置き唇の戸を守ってください。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["の"],["口","くち"],["に"],["見張り","みはり"],["を"],["置き","おき"],["唇","くちびる"],["の"],["戸","と"],["を"],["守って","まもって"],["ください"],["。"]]},{"verse":4,"text":"わたしの心が悪に傾くのを許さないでください。悪を行う者らと共にあなたに逆らって悪事を重ねることのありませんように。彼らの与える好餌にいざなわれませんように。","tok":[["わたし"],["の"],["心","こころ"],["が"],["悪","わる"],["に"],["傾く","かたむく"],["の"],["を"],["許さないで","ゆるさないで"],["ください"],["。"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["ら"],["と"],["共","とも"],["に"],["あなた"],["に"],["逆らって","さからって"],["悪事","あくじ"],["を"],["重ねる","かさねる"],["こと"],["の"],["ありません"],["よう"],["に"],["。"],["彼","かれ"],["ら"],["の"],["与える","あたえる"],["好餌","こうじ"],["に"],["いざなわれません"],["よう"],["に"],["。"]]},{"verse":5,"text":"主に従う人がわたしを打ち慈しみをもって戒めてくれますように。わたしは油で頭を整えることもしません彼らの悪のゆえに祈りをささげている間は。","tok":[["主に","おもに"],["従う","したがう"],["人","ひと"],["が"],["わたし"],["を"],["打ち","うち"],["慈しみ","いつくしみ"],["を"],["もって"],["戒めて","いましめて"],["くれます"],["よう"],["に"],["。"],["わたし"],["は"],["油","あぶら"],["で"],["頭","あたま"],["を"],["整える","ととのえる"],["こと"],["も"],["しません"],["彼","かれ"],["ら"],["の"],["悪","あく"],["の"],["ゆえ"],["に"],["祈り","いのり"],["を"],["ささげて"],["いる"],["間","あいだ"],["は"],["。"]]},{"verse":6,"text":"彼らの支配者がことごとく岩の傍らに投げ落とされますように。彼らはわたしの言葉を聞いて喜んだのです。","tok":[["彼","かれ"],["ら"],["の"],["支配者","しはいしゃ"],["が"],["ことごとく"],["岩","いわ"],["の"],["傍ら","かたわら"],["に"],["投げ落とされます","なげおとされます"],["よう"],["に"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["喜んだ","よろこんだ"],["の"],["です"],["。"]]},{"verse":7,"text":"「あたかも地を裂き、地を割ったかのようにわたしたちの骨は陰府の口に散らされている。」","tok":[["「"],["あたかも"],["地","ち"],["を"],["裂き","さき"],["、"],["地","ち"],["を"],["割った","わった"],["か"],["の"],["よう"],["に"],["わたしたち"],["の"],["骨","ほね"],["は"],["陰府","よみ"],["の"],["口","くち"],["に"],["散らされて","ちらされて"],["いる"],["。"],["」"]]},{"verse":8,"text":"主よ、わたしの神よ、わたしの目をあなたに向けあなたを避けどころとします。わたしの魂をうつろにしないでください。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["の"],["神","かみ"],["よ"],["、"],["わたし"],["の"],["目","め"],["を"],["あなた"],["に"],["向け","むけ"],["あなた"],["を"],["避け","さけ"],["どころ"],["と"],["します"],["。"],["わたし"],["の"],["魂","たましい"],["を"],["うつろ"],["に"],["しないで"],["ください"],["。"]]},{"verse":9,"text":"どうか、わたしをお守りください。わたしに対して仕掛けられた罠に悪を行う者が掘った落とし穴に陥りませんように。","tok":[["どう"],["か"],["、"],["わたし"],["を"],["お守り","おまもり"],["ください"],["。"],["わたし"],["に対して","にたいして"],["仕掛けられた","しかけられた"],["罠","わな"],["に"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["が"],["掘った","ほった"],["落とし穴","おとしあな"],["に"],["陥りません","おちいりません"],["よう"],["に"],["。"]]},{"verse":10,"text":"主に逆らう者が皆、主の網にかかりわたしは免れることができますように。","tok":[["主に","おもに"],["逆らう","さからう"],["者","もの"],["が"],["皆","みな"],["、"],["主","ぬし"],["の"],["網","あみ"],["に"],["かかり"],["わたし"],["は"],["免れる","まぬがれる"],["こと"],["が"],["できます"],["よう"],["に"],["。"]]}]
[{"verse":1,"text":"わたしたちではなく、主よわたしたちではなくあなたの御名こそ、栄え輝きますようにあなたの慈しみとまことによって。","tok":[["わたしたち"],["で"],["は"],["なく"],["、"],["主","ぬし"],["よ"],["わたしたち"],["で"],["は"],["なく"],["あなた"],["の"],["御名","ぎょめい"],["こそ"],["、"],["栄え","はえ"],["輝きます","かがやきます"],["よう"],["に"],["あなた"],["の"],["慈しみ","いつくしみ"],["と"],["まこと"],["によって"],["。"]]},{"verse":2,"text":"なぜ国々は言うのか「彼らの神はどこにいる」と。","tok":[["なぜ"],["国々","くにぐに"],["は"],["言う","いう"],["の"],["か"],["「"],["彼","かれ"],["ら"],["の"],["神","かみ"],["は"],["どこ"],["に"],["いる"],["」"],["と"],["。"]]},{"verse":3,"text":"わたしたちの神は天にいまし御旨のままにすべてを行われる。","tok":[["わたしたち"],["の"],["神","かみ"],["は"],["天","てん"],["に"],["いまし"],["御旨","おむね"],["の"],["まま"],["に"],["すべて"],["を"],["行われる","おこなわれる"],["。"]]},{"verse":4,"text":"国々の偶像は金銀にすぎず人間の手が造ったもの。","tok":[["国々","くにぐに"],["の"],["偶像","ぐうぞう"],["は"],["金銀","きんぎん"],["に"],["すぎず"],["人間","にんげん"],["の"],["手","て"],["が"],["造った","つくった"],["もの"],["。"]]},{"verse":5,"text":"口があっても話せず目があっても見えない。","tok":[["口","くち"],["が"],["あって"],["も"],["話せず","はなせず"],["目","め"],["が"],["あって"],["も"],["見えない","みえない"],["。"]]},{"verse":6,"text":"耳があっても聞こえず鼻があってもかぐことができない。","tok":[["耳","みみ"],["が"],["あって"],["も"],["聞こえず","きこえず"],["鼻","はな"],["が"],["あって"],["も"],["かぐ"],["こと"],["が"],["できない"],["。"]]},{"verse":7,"text":"手があってもつかめず足があっても歩けず喉があっても声を出せない。","tok":[["手","て"],["が"],["あって"],["も"],["つかめず"],["足","あし"],["が"],["あって"],["も"],["歩けず","あるけず"],["喉","のど"],["が"],["あって"],["も"],["声","こえ"],["を"],["出せない","だせない"],["。"]]},{"verse":8,"text":"偶像を造り、それに依り頼む者は皆、偶像と同じようになる。","tok":[["偶像","ぐうぞう"],["を"],["造り","つくり"],["、"],["それ"],["に"],["依り頼む","よりたのむ"],["者","もの"],["は"],["皆","みな"],["、"],["偶像","ぐうぞう"],["と"],["同じ","おなじ"],["よう"],["に"],["なる"],["。"]]},{"verse":9,"text":"イスラエルよ、主に依り頼め。主は助け、主は盾。","tok":[["イスラエル"],["よ"],["、"],["主に","おもに"],["依り頼め","よりたのめ"],["。"],["主","ぬし"],["は"],["助け","たすけ"],["、"],["主","ぬし"],["は"],["盾","たて"],["。"]]},{"verse":10,"text":"アロンの家よ、主に依り頼め。主は助け、主は盾。","tok":[["アロン"],["の"],["家","いえ"],["よ"],["、"],["主に","おもに"],["依り頼め","よりたのめ"],["。"],["主","ぬし"],["は"],["助け","たすけ"],["、"],["主","ぬし"],["は"],["盾","たて"],["。"]]},{"verse":11,"text":"主を畏れる人よ、主に依り頼め。主は助け、主は盾。","tok":[["主","ぬし"],["を"],["畏れる","おそれる"],["人","ひと"],["よ"],["、"],["主に","おもに"],["依り頼め","よりたのめ"],["。"],["主","ぬし"],["は"],["助け","たすけ"],["、"],["主","ぬし"],["は"],["盾","たて"],["。"]]},{"verse":12,"text":"主よ、わたしたちを御心に留め祝福してください。イスラエルの家を祝福しアロンの家を祝福してください。","tok":[["主","ぬし"],["よ"],["、"],["わたしたち"],["を"],["御心","おこころ"],["に"],["留め","とめ"],["祝福","しゅくふく"],["して"],["ください"],["。"],["イスラエル"],["の"],["家","いえ"],["を"],["祝福","しゅくふく"],["し"],["アロン"],["の"],["家","いえ"],["を"],["祝福","しゅくふく"],["して"],["ください"],["。"]]},{"verse":13,"text":"主を畏れる人を祝福し大きな人も小さな人も祝福してください。","tok":[["主","ぬし"],["を"],["畏れる","おそれる"],["人","ひと"],["を"],["祝福","しゅくふく"],["し"],["大きな","おおきな"],["人","ひと"],["も"],["小さな","ちいさな"],["人","ひと"],["も"],["祝福","しゅくふく"],["して"],["ください"],["。"]]},{"verse":14,"text":"主があなたたちの数を増してくださるようにあなたたちの数を、そして子らの数を。","tok":[["主","ぬし"],["が"],["あなた"],["たち"],["の"],["数","かず"],["を"],["増して","まして"],["くださる"],["よう"],["に"],["あなた"],["たち"],["の"],["数","かず"],["を"],["、"],["そして"],["子","こ"],["ら"],["の"],["数","かず"],["を"],["。"]]},{"verse":15,"text":"天地の造り主、主があなたたちを祝福してくださるように。","tok":[["天地","てんち"],["の"],["造り主","つくりぬし"],["、"],["主","ぬし"],["が"],["あなた"],["たち"],["を"],["祝福","しゅくふく"],["して"],["くださる"],["よう"],["に"],["。"]]},{"verse":16,"text":"天は主のもの、地は人への賜物。","tok":[["天","てん"],["は"],["主","ぬし"],["の"],["もの"],["、"],["地","ち"],["は"],["人","ひと"],["へ"],["の"],["賜物","たまもの"],["。"]]},{"verse":17,"text":"主を賛美するのは死者ではない沈黙の国へ去った人々ではない。","tok":[["主","ぬし"],["を"],["賛美","さんび"],["する"],["の"],["は"],["死者","ししゃ"],["で"],["は"],["ない"],["沈黙","ちんもく"],["の"],["国","くに"],["へ"],["去った","さった"],["人々","ひとびと"],["で"],["は"],["ない"],["。"]]},{"verse":18,"text":"わたしたちこそ、主をたたえよう今も、そしてとこしえに。ハレルヤ。","tok":[["わたしたち"],["こそ"],["、"],["主","ぬし"],["を"],["たたえよう"],["今","いま"],["も"],["、"],["そして"],["とこしえ"],["に"],["。"],["ハレルヤ"],["。"]]}]
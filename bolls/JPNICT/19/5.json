[{"verse":1,"text":"［指揮者によって。笛に合わせて。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["笛","ふえ"],["に"],["合わせて","あわせて"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"主よ、わたしの言葉に耳を傾けつぶやきを聞き分けてください。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["の"],["言葉","ことば"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["つぶやき"],["を"],["聞き分けて","ききわけて"],["ください"],["。"]]},{"verse":3,"text":"わたしの王、わたしの神よ助けを求めて叫ぶ声を聞いてください。あなたに向かって祈ります。","tok":[["わたし"],["の"],["王","おう"],["、"],["わたし"],["の"],["神","かみ"],["よ"],["助け","たすけ"],["を"],["求めて","もとめて"],["叫ぶ","さけぶ"],["声","こえ"],["を"],["聞いて","きいて"],["ください"],["。"],["あなた"],["に"],["向かって","むかって"],["祈ります","いのります"],["。"]]},{"verse":4,"text":"主よ、朝ごとに、わたしの声を聞いてください。朝ごとに、わたしは御前に訴え出てあなたを仰ぎ望みます。","tok":[["主","ぬし"],["よ"],["、"],["朝","あさ"],["ごと"],["に"],["、"],["わたし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["ください"],["。"],["朝","あさ"],["ごと"],["に"],["、"],["わたし"],["は"],["御前","ごぜん"],["に"],["訴え出て","うったえでて"],["あなた"],["を"],["仰ぎ","あおぎ"],["望みます","のぞみます"],["。"]]},{"verse":5,"text":"あなたは、決して逆らう者を喜ぶ神ではありません。悪人は御もとに宿ることを許されず","tok":[["あなた"],["は"],["、"],["決して","けっして"],["逆らう","さからう"],["者","もの"],["を"],["喜ぶ","よろこぶ"],["神","かみ"],["で"],["は"],["ありません"],["。"],["悪人","あくにん"],["は"],["御もと","おもと"],["に"],["宿る","やどる"],["こと"],["を"],["許されず","ゆるされず"]]},{"verse":6,"text":"誇り高い者は御目に向かって立つことができず悪を行う者はすべて憎まれます。","tok":[["誇り","ほこり"],["高い","たかい"],["者","もの"],["は"],["御目","おめ"],["に"],["向かって","むかって"],["立つ","たつ"],["こと"],["が"],["できず"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["は"],["すべて"],["憎まれます","にくまれます"],["。"]]},{"verse":7,"text":"主よ、あなたは偽って語る者を滅ぼし流血の罪を犯す者、欺く者をいとわれます。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["偽って","いつわって"],["語る","かたる"],["者","もの"],["を"],["滅ぼし","ほろぼし"],["流血","りゅうけつ"],["の"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["、"],["欺く","あざむく"],["者","もの"],["を"],["いとわれます"],["。"]]},{"verse":8,"text":"しかしわたしは、深い慈しみをいただいてあなたの家に入り、聖なる宮に向かってひれ伏しあなたを畏れ敬います。","tok":[["しかし"],["わたし"],["は"],["、"],["深い","ふかい"],["慈しみ","いつくしみ"],["を"],["いただいて"],["あなた"],["の"],["家","いえ"],["に"],["入り","はいり"],["、"],[
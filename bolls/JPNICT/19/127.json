[{"verse":1,"text":"［都に上る歌。ソロモンの詩。］主御自身が建ててくださるのでなければ家を建てる人の労苦はむなしい。主御自身が守ってくださるのでなければ町を守る人が目覚めているのもむなしい。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["ソロモン"],["の"],["詩","し"],["。"],["］"],["主","しゅ"],["御自身","ごじしん"],["が"],["建てて","たてて"],["くださる"],["ので"],["なければ"],["家","いえ"],["を"],["建てる","たてる"],["人","ひと"],["の"],["労苦","ろうく"],["は"],["むなしい"],["。"],["主","しゅ"],["御自身","ごじしん"],["が"],["守って","まもって"],["くださる"],["ので"],["なければ"],["町","まち"],["を"],["守る","まもる"],["人","ひと"],["が"],["目覚めて","めざめて"],["いる"],["の"],["も"],["むなしい"],["。"]]},{"verse":2,"text":"朝早く起き、夜おそく休み焦慮してパンを食べる人よそれは、むなしいことではないか主は愛する者に眠りをお与えになるのだから。","tok":[["朝","あさ"],["早く","はやく"],["起き","おき"],["、"],["夜","よる"],["おそく"],["休み","やすみ"],["焦慮","しょうりょ"],["して"],["パン"],["を"],["食べる","たべる"],["人","ひと"],["よ"],["それ"],["は"],["、"],["むなしい"],["こと"],["で"],["は"],["ない"],["か"],["主","ぬし"],["は"],["愛する","あいする"],["者","もの"],["に"],["眠り","ねむり"],["を"],["お与え","おあたえ"],["に"],["なる"],["の"],["だ"],["から"],["。"]]},{"verse":3,"text":"見よ、子らは主からいただく嗣業。胎の実りは報い。","tok":[["見よ","みよ"],["、"],["子","こ"],["ら"],["は"],["主","ぬし"],["から"],["いただく"],["嗣業","しぎょう"],["。"],["胎","はら"],["の"],["実り","みのり"],["は"],["報い","むくい"],["。"]]},{"verse":4,"text":"若くて生んだ子らは、勇士の手の中の矢。","tok":[["若くて","わかくて"],["生んだ","うんだ"],["子","こ"],["ら"],["は"],["、"],["勇士","ゆうし"],["の"],["手","て"],["の"],["中","なか"],["の"],["矢","や"],["。"]]},{"verse":5,"text":"いかに幸いなことか矢筒をこの矢で満たす人は。町の門で敵と論争するときも恥をこうむることはない。","tok":[["いかに"],["幸い","さいわい"],["な"],["こと"],["か"],["矢筒","やづつ"],["を"],["この"],["矢","や"],["で"],["満たす","みたす"],["人","ひと"],["は"],["。"],["町","まち"],["の"],["門","もん"],["で"],["敵","てき"],["と"],["論争","ろんそう"],["する"],["とき"],["も"],["恥","はじ"],["を"],["こうむる"],["こと"],["は"],["ない"],["。"]]}]
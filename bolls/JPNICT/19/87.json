[{"verse":1,"text":"［コラの子の詩。賛歌。歌。］聖なる山に基を置き","tok":[["［"],["コラ"],["の"],["子","こ"],["の"],["詩","し"],["。"],["賛歌","さんか"],["。"],["歌","うた"],["。"],["］"],["聖","せい"],["なる"],["山","やま"],["に"],["基","もと"],["を"],["置き","おき"]]},{"verse":2,"text":"主がヤコブのすべての住まいにまさって愛されるシオンの城門よ。","tok":[["主","ぬし"],["が"],["ヤコブ"],["の"],["すべて"],["の"],["住まい","すまい"],["に"],["まさって"],["愛される","あいされる"],["シオン"],["の"],["城門","じょうもん"],["よ"],["。"]]},{"verse":3,"text":"神の都よあなたの栄光について人々は語る。〔セラ","tok":[["神","かみ"],["の"],["都","みやこ"],["よ"],["あなた"],["の"],["栄光","えいこう"],["について"],["人々","ひとびと"],["は"],["語る","かたる"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"「わたしはラハブとバビロンの名をわたしを知る者の名と共に挙げよう。見よ、ペリシテ、ティルス、クシュをもこの都で生まれた、と書こう。","tok":[["「"],["わたし"],["は"],["ラハブ"],["と"],["バビロン"],["の"],["名","な"],["を"],["わたし"],["を"],["知る","しる"],["者","もの"],["の"],["名","な"],["と"],["共","とも"],["に"],["挙げよう","あげよう"],["。"],["見よ","みよ"],["、"],["ペリシテ"],["、"],["ティルス"],["、"],["クシュ"],["を"],["も"],["この"],["都","と"],["で"],["生まれた","うまれた"],["、"],["と"],["書こう","かこう"],["。"]]},{"verse":5,"text":"シオンについて、人々は言うであろうこの人もかの人もこの都で生まれた、と。」いと高き神御自身がこれを固く定められる。","tok":[["シオン"],["について"],["、"],["人々","ひとびと"],["は"],["言うで","ゆうで"],["あろう"],["この"],["人","ひと"],["も"],["かの"],["人","ひと"],["も"],["この"],["都","と"],["で"],["生まれた","うまれた"],["、"],["と"],["。"],["」"],["いと"],["高き","たかき"],["神","かみ"],["御自身","ごじしん"],["が"],["これ"],["を"],["固く","かたく"],["定められる","さだめられる"],["。"]]},{"verse":6,"text":"主は諸国の民を数え、書き記されるこの都で生まれた者、と。〔セラ","tok":[["主","ぬし"],["は"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["数え","かぞえ"],["、"],["書き記される","かきしるされる"],["この"],["都","と"],["で"],["生まれた","うまれた"],["者","もの"],["、"],["と"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"歌う者も踊る者も共に言う「わたしの源はすべてあなたの中にある」と。","tok":[["歌う","うたう"],["者","もの"],["も"],["踊る","おどる"],["者","もの"],["も"],["共","とも"],["に"],["言う","いう"],["「"],["わたし"],["の"],["源","みなもと"],["は"],["すべて"],["あなた"],["の"],["中","なか"],["に"],["ある"],["」"],["と"],["。"]]}]
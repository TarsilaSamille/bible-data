[{"verse":1,"text":"［指揮者によって。第八調。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["第","だい"],["八","はち"],["調","ちょう"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"主よ、お救いください。主の慈しみに生きる人は絶え人の子らの中から信仰のある人は消え去りました。","tok":[["主","ぬし"],["よ"],["、"],["お救い","おすくい"],["ください"],["。"],["主","ぬし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["は"],["絶え","たえ"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["から"],["信仰","しんこう"],["の"],["ある"],["人","ひと"],["は"],["消え去りました","きえさりました"],["。"]]},{"verse":3,"text":"人は友に向かって偽りを言い滑らかな唇、二心をもって話します。","tok":[["人","ひと"],["は"],["友","とも"],["に"],["向かって","むかって"],["偽り","いつわり"],["を"],["言い","いい"],["滑らか","なめらか"],["な"],["唇","くちびる"],["、"],["二心","にしん"],["を"],["もって"],["話します","はなします"],["。"]]},{"verse":4,"text":"主よ、すべて滅ぼしてください滑らかな唇と威張って語る舌を。","tok":[["主","ぬし"],["よ"],["、"],["すべて"],["滅ぼして","ほろぼして"],["ください"],["滑らか","なめらか"],["な"],["唇","くちびる"],["と"],["威張って","いばって"],["語る","かたる"],["舌","した"],["を"],["。"]]},{"verse":5,"text":"彼らは言います。「舌によって力を振るおう。自分の唇は自分のためだ。わたしたちに主人などはない。」","tok":[["彼","かれ"],["ら"],["は"],["言います","いいます"],["。"],["「"],["舌","した"],["によって"],["力","ちから"],["を"],["振るおう","ふるおう"],["。"],["自分","じぶん"],["の"],["唇","くちびる"],["は"],["自分","じぶん"],["の"],["ため"],["だ"],["。"],["わたしたち"],["に"],["主人","しゅじん"],["など"],["は"],["ない"],["。"],["」"]]},{"verse":6,"text":"主は言われます。「虐げに苦しむ者と呻いている貧しい者のために今、わたしは立ち上がり彼らがあえぎ望む救いを与えよう。」","tok":[["主","ぬし"],["は"],["言われます","いわれます"],["。"],["「"],["虐げ","しいたげ"],["に"],["苦しむ","くるしむ"],["者","もの"],["と"],["呻いて","うめいて"],["いる"],["貧しい","まずしい"],["者","もの"],["の"],["ため"],["に"],["今","いま"],["、"],["わたし"],["は"],["立ち上がり","たちあがり"],["彼","かれ"],["ら"],["が"],["あえぎ"],["望む","のぞむ"],["救い","すくい"],["を"],["与えよう","あたえよう"],["。"],["」"]]},{"verse":7,"text":"主の仰せは清い。土の炉で七たび練り清めた銀。","tok":[["主","ぬし"],["の"],["仰せ","おおせ"],["は"],["清い","きよい"],["。"],["土","つち"],["の"],["炉","ろ"],["で"],["七","なな"],["たび"],["練り","ねり"],["清めた","きよめた"],["銀","ぎん"],["。"]]},{"verse":8,"text":"主よ、あなたはその仰せを守りこの代からとこしえに至るまでわたしたちを見守ってくださいます。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["その"],["仰せ","おおせ"],["を"],["守り","まもり"],["この"],["代","だい"],["から"],["とこしえ"],["に"],["至る","いたる"],["まで"],["わたしたち"],["を"],["見守って","みまもって"],["くださいます"],["。"]]},{"verse":9,"text":"主に逆らう者は勝手にふるまいます人の子らの中に卑しむべきことがもてはやされるこのとき。","tok":[["主に","おもに"],["逆らう","さからう"],["者","もの"],["は"],["勝手に","かってに"],["ふるまいます"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["に"],["卑しむべき","いやしむべき"],["こと"],["が"],["もてはやされる"],["この"],["とき"],["。"]]}]
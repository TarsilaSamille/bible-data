[{"verse":1,"text":"［都に上る歌。］目を上げて、わたしはあなたを仰ぎます天にいます方よ。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["目","め"],["を"],["上げて","あげて"],["、"],["わたし"],["は"],["あなた"],["を"],["仰ぎます","あおぎます"],["天","てん"],["に"],["います"],["方","かた"],["よ"],["。"]]},{"verse":2,"text":"御覧ください、僕が主人の手に目を注ぎはしためが女主人の手に目を注ぐようにわたしたちは、神に、わたしたちの主に目を注ぎ憐れみを待ちます。","tok":[["御覧","ごらん"],["ください"],["、"],["僕","ぼく"],["が"],["主人","しゅじん"],["の"],["手","て"],["に"],["目","め"],["を"],["注ぎ","そそぎ"],["は"],["し"],["ため"],["が"],["女","じょ"],["主人","しゅじん"],["の"],["手","て"],["に"],["目","め"],["を"],["注ぐ","そそぐ"],["よう"],["に"],["わたしたち"],["は"],["、"],["神","かみ"],["に"],["、"],["わたしたち"],["の"],["主に","おもに"],["目","め"],["を"],["注ぎ","そそぎ"],["憐れみ","あわれみ"],["を"],["待ちます","まちます"],["。"]]},{"verse":3,"text":"わたしたちを憐れんでください。主よ、わたしたちを憐れんでください。わたしたちはあまりにも恥に飽かされています。","tok":[["わたしたち"],["を"],["憐れんで","あわれんで"],["ください"],["。"],["主","ぬし"],["よ"],["、"],["わたしたち"],["を"],["憐れんで","あわれんで"],["ください"],["。"],["わたしたち"],["は"],["あまり"],["に"],["も"],["恥","はじ"],["に"],["飽かされて","あかされて"],["います"],["。"]]},{"verse":4,"text":"平然と生きる者らの嘲笑に傲然と生きる者らの侮りにわたしたちの魂はあまりにも飽かされています。","tok":[["平然","へいぜん"],["と"],["生きる","いきる"],["者","もの"],["ら"],["の"],["嘲笑","ちょうしょう"],["に"],["傲然","ごうぜん"],["と"],["生きる","いきる"],["者","もの"],["ら"],["の"],["侮り","あなどり"],["に"],["わたしたち"],["の"],["魂","たましい"],["は"],["あまり"],["に"],["も"],["飽かされて","あかされて"],["います"],["。"]]}]
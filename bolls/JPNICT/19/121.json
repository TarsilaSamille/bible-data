[{"verse":1,"text":"［都に上る歌。］目を上げて、わたしは山々を仰ぐ。わたしの助けはどこから来るのか。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["目","め"],["を"],["上げて","あげて"],["、"],["わたし"],["は"],["山々","やまやま"],["を"],["仰ぐ","あおぐ"],["。"],["わたし"],["の"],["助け","たすけ"],["は"],["どこ"],["から"],["来る","くる"],["の"],["か"],["。"]]},{"verse":2,"text":"わたしの助けは来る天地を造られた主のもとから。","tok":[["わたし"],["の"],["助け","たすけ"],["は"],["来る","くる"],["天地","てんち"],["を"],["造られた","つくられた"],["主","ぬし"],["の"],["もと"],["から"],["。"]]},{"verse":3,"text":"どうか、主があなたを助けて足がよろめかないようにしまどろむことなく見守ってくださるように。","tok":[["どう"],["か"],["、"],["主","ぬし"],["が"],["あなた"],["を"],["助けて","たすけて"],["足","あし"],["が"],["よろめかない"],["よう"],["に"],["し"],["まどろむ"],["こと"],["なく"],["見守って","みまもって"],["くださる"],["よう"],["に"],["。"]]},{"verse":4,"text":"見よ、イスラエルを見守る方はまどろむことなく、眠ることもない。","tok":[["見よ","みよ"],["、"],["イスラエル"],["を"],["見守る","みまもる"],["方","かた"],["は"],["まどろむ"],["こと"],["なく"],["、"],["眠る","ねむる"],["こと"],["も"],["ない"],["。"]]},{"verse":5,"text":"主はあなたを見守る方あなたを覆う陰、あなたの右にいます方。","tok":[["主","ぬし"],["は"],["あなた"],["を"],["見守る","みまもる"],["方","かた"],["あなた"],["を"],["覆う","おおう"],["陰","かげ"],["、"],["あなた"],["の"],["右","みぎ"],["に"],["います"],["方","かた"],["。"]]},{"verse":6,"text":"昼、太陽はあなたを撃つことがなく夜、月もあなたを撃つことがない。","tok":[["昼","ひる"],["、"],["太陽","たいよう"],["は"],["あなた"],["を"],["撃つ","うつ"],["こと"],["が"],["なく"],["夜","よる"],["、"],["月","つき"],["も"],["あなた"],["を"],["撃つ","うつ"],["こと"],["が"],["ない"],["。"]]},{"verse":7,"text":"主がすべての災いを遠ざけてあなたを見守りあなたの魂を見守ってくださるように。","tok":[["主","ぬし"],["が"],["すべて"],["の"],["災い","わざわい"],["を"],["遠ざけて","とおざけて"],["あなた"],["を"],["見守り","みまもり"],["あなた"],["の"],["魂","たましい"],["を"],["見守って","みまもって"],["くださる"],["よう"],["に"],["。"]]},{"verse":8,"text":"あなたの出で立つのも帰るのも主が見守ってくださるように。今も、そしてとこしえに。","tok":[["あなた"],["の"],["出で立つ","いでたつ"],["の"],["も"],["帰る","かえる"],["の"],["も"],["主","ぬし"],["が"],["見守って","みまもって"],["くださる"],["よう"],["に"],["。"],["今","いま"],["も"],["、"],["そして"],["とこしえ"],["に"],["。"]]}]
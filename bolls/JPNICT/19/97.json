[{"verse":1,"text":"主こそ王。全地よ、喜び躍れ。多くの島々よ、喜び祝え。","tok":[["主","ぬし"],["こそ"],["王","おう"],["。"],["全地","ぜんち"],["よ"],["、"],["喜び","よろこび"],["躍れ","おどれ"],["。"],["多く","おおく"],["の"],["島々","しまじま"],["よ"],["、"],["喜び祝え","よろこびいわえ"],["。"]]},{"verse":2,"text":"密雲と濃霧が主の周りに立ちこめ正しい裁きが王座の基をなす。","tok":[["密雲","みつうん"],["と"],["濃霧","のうむ"],["が"],["主","ぬし"],["の"],["周り","まわり"],["に"],["立ちこめ","たちこめ"],["正しい","ただしい"],["裁き","さばき"],["が"],["王座","おうざ"],["の"],["基","もと"],["を"],["なす"],["。"]]},{"verse":3,"text":"火は御前を進み周りの敵を焼き滅ぼす。","tok":[["火","ひ"],["は"],["御前","ごぜん"],["を"],["進み","すすみ"],["周り","まわり"],["の"],["敵","てき"],["を"],["焼き滅ぼす","やきほろぼす"],["。"]]},{"verse":4,"text":"稲妻は世界を照らし出し地はそれを見て、身もだえし","tok":[["稲妻","いなずま"],["は"],["世界","せかい"],["を"],["照らし出し","てらしだし"],["地","ち"],["は"],["それ"],["を"],["見て","みて"],["、"],["身もだえ","みもだえ"],["し"]]},{"verse":5,"text":"山々は蝋のように溶ける主の御前に、全地の主の御前に。","tok":[["山々","やまやま"],["は"],["蝋","ろう"],["の"],["よう"],["に"],["溶ける","とける"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["、"],["全地","ぜんち"],["の"],["主","ぬし"],["の"],["御前","ごぜん"],["に"],["。"]]},{"verse":6,"text":"天は主の正しさを告げ知らせすべての民はその栄光を仰ぎ見る。","tok":[["天","てん"],["は"],["主","ぬし"],["の"],["正し","ただし"],["さ"],["を"],["告げ知らせ","つげしらせ"],["すべて"],["の"],["民","たみ"],["は"],["その"],["栄光","えいこう"],["を"],["仰ぎ見る","あおぎみる"],["。"]]},{"verse":7,"text":"すべて、偶像に仕える者むなしい神々を誇りとする者は恥を受ける。神々はすべて、主に向かってひれ伏す。","tok":[["すべて"],["、"],["偶像","ぐうぞう"],["に"],["仕える","つかえる"],["者","もの"],["むなしい"],["神々","かみがみ"],["を"],["誇り","ほこり"],["と"],["する"],["者","もの"],["は"],["恥","はじ"],["を"],["受ける","うける"],["。"],["神々","かみがみ"],["は"],["すべて"],["、"],["主に","おもに"],["向かって","むかって"],["ひれ伏す","ひれふす"],["。"]]},{"verse":8,"text":"シオンは聞いて喜び祝いユダのおとめらは喜び躍る主よ、あなたの裁きのゆえに。","tok":[["シオン"],["は"],["聞いて","きいて"],["喜び祝い","よろこびいわい"],["ユダ"],["の"],["おとめ"],["ら"],["は"],["喜び","よろこび"],["躍る","おどる"],["主","ぬし"],["よ"],["、"],["あなた"],["の"],["裁き","さばき"],["の"],["ゆえ"],["に"],["。"]]},{"verse":9,"text":"あなたは主、全地に君臨されるいと高き神。神々のすべてを超え、あがめられる神。","tok":[["あなた"],["は"],["主","ぬし"],["、"],["全地","ぜんち"],["に"],["君臨","くんりん"],["される"],["い"],["と"],["高き","たかき"],["神","かみ"],["。"],["神々","かみがみ"],["の"],["すべて"],["を"],["超え","こえ"],["、"],["あがめられる"],["神","かみ"],["。"]]},{"verse":10,"text":"主を愛する人は悪を憎む。主の慈しみに生きる人の魂を主は守り神に逆らう者の手から助け出してくださる。","tok":[["主","ぬし"],["を"],["愛する","あいする"],["人","ひと"],["は"],["悪","あく"],["を"],["憎む","にくむ"],["。"],["主","ぬし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["の"],["魂","たましい"],["を"],["主","ぬし"],["は"],["守り神","まもりがみ"],["に"],["逆らう","さからう"],["者","もの"],["の"],["手","て"],["から"],["助け出して","たすけだして"],["くださる"],["。"]]},{"verse":11,"text":"神に従う人のためには光を心のまっすぐな人のためには喜びを種蒔いてくださる。","tok":[["神","かみ"],["に"],["従う","したがう"],["人","ひと"],["の"],["ため"],["に"],["は"],["光","ひかり"],["を"],["心","こころ"],["の"],["まっすぐ"],["な"],["人","ひと"],["の"],["ため"],["に"],["は"],["喜び","よろこび"],["を"],["種蒔","たねまき"],["いて"],["くださる"],["。"]]},{"verse":12,"text":"神に従う人よ、主にあって喜び祝え。聖なる御名に感謝をささげよ。","tok":[["神","かみ"],["に"],["従う","したがう"],["人","ひと"],["よ"],["、"],["主に","おもに"],["あって"],["喜び祝え","よろこびいわえ"],["。"],["聖","せい"],["なる"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["を"],["ささげ"],["よ"],["。"]]}]
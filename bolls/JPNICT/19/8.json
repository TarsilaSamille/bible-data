[{"verse":1,"text":"［指揮者によって。ギティトに合わせて。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["ギティト"],["に"],["合わせて","あわせて"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"主よ、わたしたちの主よあなたの御名は、いかに力強く全地に満ちていることでしょう。天に輝くあなたの威光をたたえます","tok":[["主","ぬし"],["よ"],["、"],["わたしたち"],["の"],["主","ぬし"],["よ"],["あなた"],["の"],["御名","ぎょめい"],["は"],["、"],["いかに"],["力強く","ちからづよく"],["全地","ぜんち"],["に"],["満ちて","みちて"],["いる"],["こと"],["でしょう"],["。"],["天","てん"],["に"],["輝く","かがやく"],["あなた"],["の"],["威光","いこう"],["を"],["たたえます"]]},{"verse":3,"text":"幼子、乳飲み子の口によって。あなたは刃向かう者に向かって砦を築き報復する敵を絶ち滅ぼされます。","tok":[["幼子","おさなご"],["、"],["乳飲み子","ちのみご"],["の"],["口","くち"],["によって"],["。"],["あなた"],["は"],["刃向かう","はむかう"],["者","もの"],["に"],["向かって","むかって"],["砦","とりで"],["を"],["築き","きずき"],["報復","ほうふく"],["する"],["敵","てき"],["を"],["絶ち","たち"],["滅ぼされます","ほろぼされます"],["。"]]},{"verse":4,"text":"あなたの天を、あなたの指の業をわたしは仰ぎます。月も、星も、あなたが配置なさったもの。","tok":[["あなた"],["の"],["天","てん"],["を"],["、"],["あなた"],["の"],["指","ゆび"],["の"],["業","ごう"],["を"],["わたし"],["は"],["仰ぎます","あおぎます"],["。"],["月","つき"],["も"],["、"],["星","ほし"],["も"],["、"],["あなた"],["が"],["配置","はいち"],["なさった"],["もの"],["。"]]},{"verse":5,"text":"そのあなたが御心に留めてくださるとは人間は何ものなのでしょう。人の子は何ものなのでしょうあなたが顧みてくださるとは。","tok":[["その"],["あなた"],["が"],["御心","おこころ"],["に"],["留めて","とめて"],["くださる"],["と"],["は"],["人間","にんげん"],["は"],["何もの","なにもの"],["な"],["の"],["でしょう"],["。"],["人","ひと"],["の"],["子","こ"],["は"],["何もの","なにもの"],["な"],["の"],["でしょう"],["あなた"],["が"],["顧みて","かえりみて"],["くださる"],["と"],["は"],["。"]]},{"verse":6,"text":"神に僅かに劣るものとして人を造りなお、栄光と威光を冠としていただかせ","tok":[["神","かみ"],["に"],["僅か","わずか"],["に"],["劣る","おとる"],["もの"],["として"],["人","ひと"],["を"],["造り","つくり"],["なお"],["、"],["栄光","えいこう"],["と"],["威光","いこう"],["を"],["冠","かんむり"],["として"],["いただかせ"]]},{"verse":7,"text":"御手によって造られたものをすべて治めるようにその足もとに置かれました。","tok":[["御手","おて"],["によって"],["造られた","つくられた"],["もの"],["を"],["すべて"],["治める","おさめる"],["よう"],["に"],["その"],["足もと","あしもと"],["に"],["置かれました","おかれました"],["。"]]},{"verse":8,"text":"羊も牛も、野の獣も","tok":[["羊","ひつじ"],["も"],["牛","うし"],["も"],["、"],["野","の"],["の"],["獣","けもの"],["も"]]},{"verse":9,"text":"空の鳥、海の魚、海路を渡るものも。","tok":[["空","そら"],["の"],["鳥","とり"],["、"],["海","うみ"],["の"],["魚","さかな"],["、"],["海路","かいろ"],["を"],["渡る","わたる"],["もの"],["も"],["。"]]},{"verse":10,"text":"主よ、わたしたちの主よあなたの御名は、いかに力強く全地に満ちていることでしょう。","tok":[["主","ぬし"],["よ"],["、"],["わたしたち"],["の"],["主","ぬし"],["よ"],["あなた"],["の"],["御名","ぎょめい"],["は"],["、"],["いかに"],["力強く","ちからづよく"],["全地","ぜんち"],["に"],["満ちて","みちて"],["いる"],["こと"],["でしょう"],["。"]]}]
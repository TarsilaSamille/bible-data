[{"verse":1,"text":"［賛歌。ダビデの詩。］神の子らよ、主に帰せよ栄光と力を主に帰せよ","tok":[["［"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["神","かみ"],["の"],["子","こ"],["ら"],["よ"],["、"],["主に","おもに"],["帰せよ","きせよ"],["栄光","えいこう"],["と"],["力","ちから"],["を"],["主に","おもに"],["帰せよ","かえせよ"]]},{"verse":2,"text":"御名の栄光を主に帰せよ。聖なる輝きに満ちる主にひれ伏せ。","tok":[["御名","ぎょめい"],["の"],["栄光","えいこう"],["を"],["主に","おもに"],["帰せ","かえせ"],["よ"],["。"],["聖","せい"],["なる"],["輝き","かがやき"],["に"],["満ちる","みちる"],["主に","おもに"],["ひれ伏せ","ひれふせ"],["。"]]},{"verse":3,"text":"主の御声は水の上に響く。栄光の神の雷鳴はとどろく。主は大水の上にいます。","tok":[["主","ぬし"],["の"],["御声","おこえ"],["は"],["水","みず"],["の"],["上","うえ"],["に"],["響く","ひびく"],["。"],["栄光","えいこう"],["の"],["神","かみ"],["の"],["雷鳴","らいめい"],["は"],["とどろく"],["。"],["主","ぬし"],["は"],["大水","おおみず"],["の"],["上","うえ"],["に"],["います"],["。"]]},{"verse":4,"text":"主の御声は力をもって響き主の御声は輝きをもって響く。","tok":[["主","ぬし"],["の"],["御声","おこえ"],["は"],["力","ちから"],["を"],["もって"],["響き","ひびき"],["主","ぬし"],["の"],["御声","おこえ"],["は"],["輝き","かがやき"],["を"],["もって"],["響く","ひびく"],["。"]]},{"verse":5,"text":"主の御声は杉の木を砕き主はレバノンの杉の木を砕き","tok":[["主","ぬし"],["の"],["御声","おこえ"],["は"],["杉","すぎ"],["の"],["木","き"],["を"],["砕き","くだき"],["主","ぬし"],["は"],["レバノン"],["の"],["杉","すぎ"],["の"],["木","き"],["を"],["砕き","くだき"]]},{"verse":6,"text":"レバノンを子牛のようにシルヨンを野牛の子のように躍らせる。","tok":[["レバノン"],["を"],["子牛","こうし"],["の"],["よう"],["に"],["シルヨン"],["を"],["野牛","やぎゅう"],["の"],["子","こ"],["の"],["よう"],["に"],["躍らせる","おどらせる"],["。"]]},{"verse":7,"text":"主の御声は炎を裂いて走らせる。","tok":[["主","ぬし"],["の"],["御声","おこえ"],["は"],["炎","ほのお"],["を"],["裂いて","さいて"],["走らせる","はしらせる"],["。"]]},{"verse":8,"text":"主の御声は荒れ野をもだえさせ主はカデシュの荒れ野をもだえさせる。","tok":[["主","ぬし"],["の"],["御声","おこえ"],["は"],["荒れ野","あれの"],["を"],["もだえさせ"],["主","ぬし"],["は"],["カデシュ"],["の"],["荒れ野","あれの"],["を"],["もだえさせる"],["。"]]},{"verse":9,"text":"主の御声は雌鹿をもだえさせ月満ちぬうちに子を産ませる。神殿のものみなは唱える「栄光あれ」と。","tok":[["主","ぬし"],["の"],["御声","おこえ"],["は"],["雌鹿","めじか"],["を"],["もだえさせ"],["月","つき"],["満ちぬ","みちぬ"],["うち"],["に"],["子","こ"],["を"],["産ませる","うませる"],["。"],["神殿","しんでん"],["の"],["もの"],["みな"],["は"],["唱える","となえ
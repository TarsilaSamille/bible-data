[{"verse":1,"text":"なにゆえ、国々は騒ぎ立ち人々はむなしく声をあげるのか。","tok":[["なにゆえ"],["、"],["国々","くにぐに"],["は"],["騒ぎ立ち","さわぎたち"],["人々","ひとびと"],["は"],["むなしく"],["声","こえ"],["を"],["あげる"],["の"],["か"],["。"]]},{"verse":2,"text":"なにゆえ、地上の王は構え、支配者は結束して主に逆らい、主の油注がれた方に逆らうのか","tok":[["なにゆえ"],["、"],["地上","ちじょう"],["の"],["王","おう"],["は"],["構え","かまえ"],["、"],["支配者","しはいしゃ"],["は"],["結束","けっそく"],["して"],["主に","おもに"],["逆らい","さからい"],["、"],["主","ぬし"],["の"],["油","あぶら"],["注がれた","そそがれた"],["方","ほう"],["に"],["逆らう","さからう"],["の"],["か"]]},{"verse":3,"text":"「我らは、枷をはずし縄を切って投げ捨てよう」と。","tok":[["「"],["我","われ"],["ら"],["は"],["、"],["枷","かせ"],["を"],["はずし"],["縄","なわ"],["を"],["切って","きって"],["投げ捨てよう","なげすてよう"],["」"],["と"],["。"]]},{"verse":4,"text":"天を王座とする方は笑い主は彼らを嘲り","tok":[["天","てん"],["を"],["王座","おうざ"],["と"],["する"],["方","ほう"],["は"],["笑い","わらい"],["主","ぬし"],["は"],["彼","かれ"],["ら"],["を"],["嘲り","あざけり"]]},{"verse":5,"text":"憤って、恐怖に落とし怒って、彼らに宣言される。","tok":[["憤って","いきどおって"],["、"],["恐怖","きょうふ"],["に"],["落とし","おとし"],["怒って","おこって"],["、"],["彼","かれ"],["ら"],["に"],["宣言","せんげん"],["される"],["。"]]},{"verse":6,"text":"「聖なる山シオンでわたしは自ら、王を即位させた。」","tok":[["「"],["聖","せい"],["なる"],["山","やま"],["シオン"],["で"],["わたし"],["は"],["自ら","みずから"],["、"],["王","おう"],["を"],["即位","そくい"],["させた"],["。"],["」"]]},{"verse":7,"text":"主の定められたところに従ってわたしは述べよう。主はわたしに告げられた。「お前はわたしの子今日、わたしはお前を生んだ。","tok":[["主","ぬし"],["の"],["定められた","さだめられた"],["ところ"],["に"],["従って","したがって"],["わたし"],["は"],["述べよう","のべよう"],["。"],["主","ぬし"],["は"],["わたし"],["に"],["告げられた","つげられた"],["。"],["「"],["お前","おまえ"],["は"],["わたし"],["の"],["子","こ"],["今日","きょう"],["、"],["わたし"],["は"],["お前","おまえ"],["を"],["生んだ","うんだ"],["。"]]},{"verse":8,"text":"求めよ。わたしは国々をお前の嗣業とし地の果てまで、お前の領土とする。","tok":[["求め","もとめ"],["よ"],["。"],["わたし"],["は"],["国々","くにぐに"],["を"],["お前","おまえ"],["の"],["嗣業","しぎょう"],["と"],["し"],["地","ち"],["の"],["果て","はて"],["まで"],["、"],["お前","おまえ"],["の"],["領土","りょうど"],["と"],["する"],["。"]]},{"verse":9,"text":"お前は鉄の杖で彼らを打ち陶工が器を砕くように砕く。」","tok":[["お前","おまえ"],["は"],["鉄","てつ"],["の"],["杖","つえ"],["で"],["彼","かれ"],["ら"],["を"],["打ち","うち"],["陶工","とうこう"],["が"],["器","うつわ"],["を"],["砕く","くだく"],["よう"],["に"],["砕く","くだく"],["。"],["」"]]},{"verse":10,"text":"すべての王よ、今や目覚めよ。地を治める者よ、諭しを受けよ。","tok":[["すべて"],["の"],["王","おう"],["よ"],["、"],["今","いま"],["や"],["目覚め","めざめ"],["よ"],["。"],["地","ち"],["を"],["治める","おさめる"],["者","もの"],["よ"],["、"],["諭し","さとし"],["を"],["受けよ","うけよ"],["。"]]},{"verse":11,"text":"畏れ敬って、主に仕えおののきつつ、喜び躍れ。","tok":[["畏れ","おそれ"],["敬って","うやまって"],["、"],["主に","おもに"],["仕え","つかえ"],["おののき"],["つつ"],["、"],["喜び","よろこび"],["躍れ","おどれ"],["。"]]},{"verse":12,"text":"子に口づけせよ主の憤りを招き、道を失うことのないように。主の怒りはまたたくまに燃え上がる。いかに幸いなことか主を避けどころとする人はすべて。","tok":[["子","こ"],["に"],["口づけ","くちづけ"],["せよ"],["主","ぬし"],["の"],["憤り","いきどおり"],["を"],["招き","まねき"],["、"],["道","みち"],["を"],["失う","うしなう"],["こと"],["の"],["ない"],["よう"],["に"],["。"],["主","ぬし"],["の"],["怒り","いかり"],["は"],["またたく"],["ま"],["に"],["燃え上がる","もえあがる"],["。"],["いかに"],["幸い","さいわい"],["な"],["こと"],["か"],["主","ぬし"],["を"],["避け","さけ"],["どころ"],["と"],["する"],["人","ひと"],["は"],["すべて"],["。"]]}]
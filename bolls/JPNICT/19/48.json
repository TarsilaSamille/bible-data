[{"verse":1,"text":"［歌。賛歌。コラの子の詩。］","tok":[["［"],["歌","うた"],["。"],["賛歌","さんか"],["。"],["コラ"],["の"],["子","こ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"大いなる主、限りなく賛美される主。わたしたちの神の都にある聖なる山は","tok":[["大いなる","おおいなる"],["主","ぬし"],["、"],["限りなく","かぎりなく"],["賛美","さんび"],["される"],["主","ぬし"],["。"],["わたしたち"],["の"],["神","かみ"],["の"],["都","と"],["に"],["ある"],["聖","せい"],["なる"],["山","やま"],["は"]]},{"verse":3,"text":"高く美しく、全地の喜び。北の果ての山、それはシオンの山、力ある王の都。","tok":[["高く","たかく"],["美しく","うつくしく"],["、"],["全地","ぜんち"],["の"],["喜び","よろこび"],["。"],["北","きた"],["の"],["果て","はて"],["の"],["山","やま"],["、"],["それ"],["は"],["シオン"],["の"],["山","やま"],["、"],["力","ちから"],["ある"],["王","おう"],["の"],["都","と"],["。"]]},{"verse":4,"text":"その城郭に、砦の塔に、神は御自らを示される。","tok":[["その"],["城郭","じょうかく"],["に"],["、"],["砦","とりで"],["の"],["塔","とう"],["に"],["、"],["神","かみ"],["は"],["御自ら","おみずから"],["を"],["示される","しめされる"],["。"]]},{"verse":5,"text":"見よ、王たちは時を定め、共に進んで来た。","tok":[["見よ","みよ"],["、"],["王","おう"],["たち"],["は"],["時","とき"],["を"],["定め","さだめ"],["、"],["共","とも"],["に"],["進んで","すすんで"],["来た","きた"],["。"]]},{"verse":6,"text":"彼らは見て、ひるみ、恐怖に陥って逃げ去った。","tok":[["彼","かれ"],["ら"],["は"],["見て","みて"],["、"],["ひるみ"],["、"],["恐怖","きょうふ"],["に"],["陥って","おちいって"],["逃げ去った","にげさった"],["。"]]},{"verse":7,"text":"そのとき彼らを捕えたおののきは産みの苦しみをする女のもだえ","tok":[["その"],["とき"],["彼","かれ"],["ら"],["を"],["捕えた","とらえた"],["お"],["の"],["のき"],["は"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["を"],["する"],["女","おんな"],["の"],["もだえ"]]},{"verse":8,"text":"東風に砕かれるタルシシュの船。","tok":[["東風","とうふう"],["に"],["砕かれる","くだかれる"],["タルシシュ"],["の"],["船","ふね"],["。"]]},{"verse":9,"text":"聞いていたことをそのまま、わたしたちは見た万軍の主の都、わたしたちの神の都で。神はこの都をとこしえに固く立てられる。〔セラ","tok":[["聞いて","きいて"],["いた"],["こと"],["を"],["そのまま"],["、"],["わたしたち"],["は"],["見た","みた"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["の"],["都","と"],["、"],["わたしたち"],["の"],["神","かみ"],["の"],["都","と"],["で"],["。"],["神","かみ"],["は"],["この"],["都","と"],["を"],["とこしえ"],["に"],["固く","かたく"],["立てられる","たてられる"],["。"],["〔"],["セラ"]]},{"verse":10,"text":"神よ、神殿にあってわたしたちはあなたの慈しみを思い描く。","tok":[["神","かみ"],["よ"],["、"],["神殿","しんでん"],["に"],["あって"],["わたしたち"],["は"],["あなた"],["の"],["慈しみ","いつくしみ"],["を"],["思い描く","おもいえがく"],["。"]]},{"verse":11,"text":"神よ、賛美は御名と共に地の果てに及ぶ。右の御手には正しさが溢れている。","tok":[["神","かみ"],["よ"],["、"],["賛美","さんび"],["は"],["御名","ぎょめい"],["と"],["共","とも"],["に"],["地","ち"],["の"],["果て","はて"],["に"],["及ぶ","およぶ"],["。"],["右","みぎ"],["の"],["御手","おて"],["に"],["は"],["正し","ただし"],["さ"],["が"],["溢れて","あふれて"],["いる"],["。"]]},{"verse":12,"text":"あなたの裁きのゆえにシオンの山は喜び祝いユダのおとめらは喜び躍る。","tok":[["あなた"],["の"],["裁き","さばき"],["の"],["ゆえ"],["に"],["シオン"],["の"],["山","やま"],["は"],["喜び祝い","よろこびいわい"],["ユダ"],["の"],["おとめ"],["ら"],["は"],["喜び","よろこび"],["躍る","おどる"],["。"]]},{"verse":13,"text":"シオンの周りをひと巡りして見よ。塔の数をかぞえ","tok":[["シオン"],["の"],["周り","まわり"],["を"],["ひと"],["巡り","めぐり"],["して"],["見","み"],["よ"],["。"],["塔","とう"],["の"],["数","かず"],["を"],["かぞえ"]]},{"verse":14,"text":"城壁に心を向け、城郭に分け入って見よ。後の代に語り伝えよ","tok":[["城壁","じょうへき"],["に"],["心","こころ"],["を"],["向け","むけ"],["、"],["城郭","じょうかく"],["に"],["分け入って","わけいって"],["見","み"],["よ"],["。"],["後","あと"],["の"],["代","だい"],["に"],["語り伝えよ","かたりつたえよ"]]},{"verse":15,"text":"この神は世々限りなくわたしたちの神死を越えて、わたしたちを導いて行かれる、と。","tok":[["この"],["神","かみ"],["は"],["世々","せいせい"],["限りなく","かぎりなく"],["わたしたち"],["の"],["神","かみ"],["死","し"],["を"],["越えて","こえて"],["、"],["わたしたち"],["を"],["導いて","みちびいて"],["行かれる","いかれる"],["、"],["と"],["。"]]}]
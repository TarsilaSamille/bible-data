[{"verse":1,"text":"［ダビデの詩。マスキール。］いかに幸いなことでしょう背きを赦され、罪を覆っていただいた者は。","tok":[["［"],["ダビデ"],["の"],["詩","し"],["。"],["マスキール"],["。"],["］"],["いかに"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["背き","そむき"],["を"],["赦され","ゆるされ"],["、"],["罪","つみ"],["を"],["覆って","おおって"],["いただいた"],["者","もの"],["は"],["。"]]},{"verse":2,"text":"いかに幸いなことでしょう主に咎を数えられず、心に欺きのない人は。","tok":[["いかに"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["主に","おもに"],["咎","とが"],["を"],["数えられず","かぞえられず"],["、"],["心","こころ"],["に"],["欺き","あざむき"],["の"],["ない"],["人","ひと"],["は"],["。"]]},{"verse":3,"text":"わたしは黙し続けて絶え間ない呻きに骨まで朽ち果てました。","tok":[["わたし"],["は"],["黙し","もくし"],["続けて","つづけて"],["絶え間","たえま"],["ない"],["呻き","うめき"],["に"],["骨","ほね"],["まで"],["朽ち","くち"],["果てました","はてました"],["。"]]},{"verse":4,"text":"御手は昼も夜もわたしの上に重くわたしの力は夏の日照りにあって衰え果てました。〔セラ","tok":[["御手","おて"],["は"],["昼","ひる"],["も"],["夜","よる"],["も"],["わたし"],["の"],["上","うえ"],["に"],["重く","おもく"],["わたし"],["の"],["力","ちから"],["は"],["夏","なつ"],["の"],["日照り","ひでり"],["に"],["あって"],["衰え","おとろえ"],["果てました","はてました"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"わたしは罪をあなたに示し咎を隠しませんでした。わたしは言いました「主にわたしの背きを告白しよう」と。そのとき、あなたはわたしの罪と過ちを赦してくださいました。〔セラ","tok":[["わたし"],["は"],["罪","つみ"],["を"],["あなた"],["に"],["示し","しめし"],["咎","とが"],["を"],["隠しませんでした","かくしませんでした"],["。"],["わたし"],["は"],["言いました","いいました"],["「"],["主に","おもに"],["わたし"],["の"],["背き","そむき"],["を"],["告白","こくはく"],["しよう"],["」"],["と"],["。"],["その"],["とき"],["、"],["あなた"],["は"],["わたし"],["の"],["罪","つみ"],["と"],["過ち","あやまち"],["を"],["赦して","ゆるして"],["くださいました"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"あなたの慈しみに生きる人は皆あなたを見いだしうる間にあなたに祈ります。大水が溢れ流れるときにもその人に及ぶことは決してありません。","tok":[["あなた"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["は"],["皆","みな"],["あなた"],["を"],["見いだし","みいだし"],["うる"],["間","あいだ"],["に"],["あなた"],["に"],["祈ります","いのります"],["。"],["大水","おおみず"],["が"],["溢れ流れる","あふれながれる"],["とき"],["に"],["も"],["その"],["人","ひと"],["に"],["及ぶ","およぶ"],["こと"],["は"],["決して","けっして"],["ありません"],["。"]]},{"verse":7,"text":"あなたはわたしの隠れが。苦難から守ってくださる方。救いの喜びをもってわたしを囲んでくださる方。〔セラ","tok":[["あなた"],["は"],["わたし"],["の"],["隠れ","かくれ"],["が"],["。"],["苦難","くなん"],["から"],["守って","まもって"],["くださる"],["方","かた"],["。"],["救い","すくい"],["の"],["喜び","よろこび"],["を"],["もって"],["わたし"],["を"],["囲んで","かこんで"],["くださる"],["方","かた"],["。"],["〔"],["セラ"]]},{"verse":8,"text":"わたしはあなたを目覚めさせ行くべき道を教えよう。あなたの上に目を注ぎ、勧めを与えよう。","tok":[["わたし"],["は"],["あなた"],["を"],["目覚めさせ","めざめさせ"],["行くべき","いくべき"],["道","みち"],["を"],["教えよう","おしえよう"],["。"],["あなた"],["の"],["上","うえ"],["に"],["目","め"],["を"],["注ぎ","そそぎ"],["、"],["勧め","すすめ"],["を"],["与えよう","あたえよう"],["。"]]},{"verse":9,"text":"分別のない馬やらばのようにふるまうな。それはくつわと手綱で動きを抑えねばならない。そのようなものをあなたに近づけるな。","tok":[["分別","ぶんべつ"],["の"],["ない"],["馬","うま"],["や"],["らば"],["の"],["よう"],["に"],["ふるまう"],["な"],["。"],["それ"],["は"],["くつわ"],["と"],["手綱","たづな"],["で"],["動き","うごき"],["を"],["抑えねば","おさえねば"],["ならない"],["。"],["その"],["よう"],["な"],["もの"],["を"],["あなた"],["に"],["近づける","ちかづける"],["な"],["。"]]},{"verse":10,"text":"神に逆らう者は悩みが多く主に信頼する者は慈しみに囲まれる。","tok":[["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["は"],["悩み","なやみ"],["が"],["多く","おおく"],["主に","おもに"],["信頼","しんらい"],["する"],["者","もの"],["は"],["慈しみ","いつくしみ"],["に"],["囲まれる","かこまれる"],["。"]]},{"verse":11,"text":"神に従う人よ、主によって喜び躍れ。すべて心の正しい人よ、喜びの声をあげよ。","tok":[["神","かみ"],["に"],["従う","したがう"],["人","ひと"],["よ"],["、"],["主に","おもに"],["よって"],["喜び","よろこび"],["躍れ","おどれ"],["。"],["すべて"],["心","こころ"],["の"],["正しい","ただしい"],["人","ひと"],["よ"],["、"],["喜び","よろこび"],["の"],["声","こえ"],["を"],["あげ"],["よ"],["。"]]}]
[{"verse":1,"text":"［都に上る歌。ダビデの詩。］イスラエルよ、言え。「主がわたしたちの味方でなかったなら","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["イスラエル"],["よ"],["、"],["言え","いえ"],["。"],["「"],["主","ぬし"],["が"],["わたしたち"],["の"],["味方","みかた"],["で"],["なかったなら"]]},{"verse":2,"text":"主がわたしたちの味方でなかったならわたしたちに逆らう者が立ったとき","tok":[["主","ぬし"],["が"],["わたしたち"],["の"],["味方","みかた"],["で"],["なかったなら"],["わたしたち"],["に"],["逆らう","さからう"],["者","もの"],["が"],["立った","たった"],["とき"]]},{"verse":3,"text":"そのとき、わたしたちは生きながら敵意の炎に呑み込まれていたであろう。","tok":[["その"],["とき"],["、"],["わたしたち"],["は"],["生き","いき"],["ながら"],["敵意","てきい"],["の"],["炎","ほのお"],["に"],["呑み込まれて","のみこまれて"],["いたで"],["あろう"],["。"]]},{"verse":4,"text":"そのとき、大水がわたしたちを押し流し激流がわたしたちを越えて行ったであろう。","tok":[["その"],["とき"],["、"],["大水","おおみず"],["が"],["わたしたち"],["を"],["押し流し","おしながし"],["激流","げきりゅう"],["が"],["わたしたち"],["を"],["越えて","こえて"],["行ったで","いったで"],["あろう"],["。"]]},{"verse":5,"text":"そのとき、わたしたちを越えて行ったであろう驕り高ぶる大水が。」","tok":[["その"],["とき"],["、"],["わたしたち"],["を"],["越えて","こえて"],["行ったで","いったで"],["あろう"],["驕り高ぶる","おごりたかぶる"],["大水","おおみず"],["が"],["。"],["」"]]},{"verse":6,"text":"主をたたえよ。主はわたしたちを敵の餌食になさらなかった。","tok":[["主","ぬし"],["を"],["たたえ"],["よ"],["。"],["主","ぬし"],["は"],["わたしたち"],["を"],["敵","てき"],["の"],["餌食","えじき"],["に"],["なさらなかった"],["。"]]},{"verse":7,"text":"仕掛けられた網から逃れる鳥のようにわたしたちの魂は逃れ出た。網は破られ、わたしたちは逃れ出た。","tok":[["仕掛けられた","しかけられた"],["網","あみ"],["から"],["逃れる","のがれる"],["鳥","とり"],["の"],["よう"],["に"],["わたしたち"],["の"],["魂","たましい"],["は"],["逃れ出た","のがれでた"],["。"],["網","あみ"],["は"],["破られ","やぶられ"],["、"],["わたしたち"],["は"],["逃れ出た","のがれでた"],["。"]]},{"verse":8,"text":"わたしたちの助けは天地を造られた主の御名にある。","tok":[["わたしたち"],["の"],["助け","たすけ"],["は"],["天地","てんち"],["を"],["造られた","つくられた"],["主","ぬし"],["の"],["御名","ぎょめい"],["に"],["ある"],["。"]]}]
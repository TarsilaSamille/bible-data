[{"verse":1,"text":"［指揮者によって。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"いかに幸いなことでしょう弱いものに思いやりのある人は。災いのふりかかるとき主はその人を逃れさせてくださいます。","tok":[["いかに"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["弱い","よわい"],["もの"],["に"],["思いやり","おもいやり"],["の"],["ある"],["人","ひと"],["は"],["。"],["災い","わざわい"],["の"],["ふりかかる"],["とき"],["主","ぬし"],["は"],["その"],["人","ひと"],["を"],["逃れさせて","のがれさせて"],["くださいます"],["。"]]},{"verse":3,"text":"主よ、その人を守って命を得させこの地で幸せにしてください。貪欲な敵に引き渡さないでください。","tok":[["主","ぬし"],["よ"],["、"],["その"],["人","ひと"],["を"],["守って","まもって"],["命","いのち"],["を"],["得させ","えさせ"],["この"],["地","ち"],["で"],["幸せ","しあわせ"],["に"],["して"],["ください"],["。"],["貪欲","どんよく"],["な"],["敵","てき"],["に"],["引き渡さないで","ひきわたさないで"],["ください"],["。"]]},{"verse":4,"text":"主よ、その人が病の床にあるとき、支え力を失って伏すとき、立ち直らせてください。","tok":[["主","ぬし"],["よ"],["、"],["その"],["人","ひと"],["が"],["病","やまい"],["の"],["床","ゆか"],["に"],["ある"],["とき"],["、"],["支え力","ささえりょく"],["を"],["失って","うしなって"],["伏す","ふす"],["とき"],["、"],["立ち直らせて","たちなおらせて"],["ください"],["。"]]},{"verse":5,"text":"わたしは申します。「主よ、憐れんでください。あなたに罪を犯したわたしを癒してください。」","tok":[["わたし"],["は"],["申します","もうします"],["。"],["「"],["主","ぬし"],["よ"],["、"],["憐れんで","あわれんで"],["ください"],["。"],["あなた"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["わたし"],["を"],["癒して","いやして"],["ください"],["。"],["」"]]},{"verse":6,"text":"敵はわたしを苦しめようとして言います。「早く死んでその名も消えうせるがよい。」","tok":[["敵","てき"],["は"],["わたし"],["を"],["苦しめよう","くるしめよう"],["として"],["言います","いいます"],["。"],["「"],["早く","はやく"],["死んで","しんで"],["その"],["名","な"],["も"],["消えうせる","きえうせる"],["が"],["よい"],["。"],["」"]]},{"verse":7,"text":"見舞いに来れば、むなしいことを言いますが心に悪意を満たし、外に出ればそれを口にします。","tok":[["見舞い","みまい"],["に"],["来れば","くれば"],["、"],["むなしい"],["こと"],["を"],["言います","いいます"],["が"],["心","こころ"],["に"],["悪意","あくい"],["を"],["満たし","みたし"],["、"],["外","そと"],["に"],["出れば","でれば"],["それ"],["を"],["口","くち"],["に"],["します"],["。"]]},{"verse":8,"text":"わたしを憎む者は皆、集まってささやきわたしに災いを謀っています。","tok":[["わたし"],["を"],["憎む","にくむ"],["者","もの"],["は"],["皆","みな"],["、"],["集まって","あつまって"],["ささやき"],["わたし"],["に"],["災い","わざわい"],["を"],["謀って","はかって"],["います"],["。"]]},{"verse":9,"text":"「呪いに取りつかれて床に就いた。二度と起き上がれまい。」","tok":[["「"],["呪い","のろい"],["に"],["取りつかれて","とりつかれて"],["床","ゆか"],["に"],["就いた","ついた"],["。"],["二","に"],["度","ど"],["と"],["起き上がれまい","おきあがれまい"],["。"],["」"]]},{"verse":10,"text":"わたしの信頼していた仲間わたしのパンを食べる者が威張ってわたしを足げにします。","tok":[["わたし"],["の"],["信頼","しんらい"],["して"],["いた"],["仲間","なかま"],["わたし"],["の"],["パン"],["を"],["食べる","たべる"],["者","もの"],["が"],["威張って","いばって"],["わたし"],["を"],["足げ","あしげ"],["に"],["します"],["。"]]},{"verse":11,"text":"主よ、どうかわたしを憐れみ再びわたしを起き上がらせてください。そうしてくだされば彼らを見返すことができます。","tok":[["主","ぬし"],["よ"],["、"],["どう"],["か"],["わたし"],["を"],["憐れみ","あわれみ"],["再び","ふたたび"],["わたし"],["を"],["起き上がらせて","おきあがらせて"],["ください"],["。"],["そう"],["して"],["くだされば"],["彼","かれ"],["ら"],["を"],["見返す","みかえす"],["こと"],["が"],["できます"],["。"]]},{"verse":12,"text":"そしてわたしは知るでしょうわたしはあなたの御旨にかなうのだと敵がわたしに対して勝ち誇ることはないと。","tok":[["そして"],["わたし"],["は"],["知るでしょう","しるでしょう"],["わたし"],["は"],["あなた"],["の"],["御旨","おむね"],["に"],["かなう"],["の"],["だ"],["と"],["敵","てき"],["が"],["わたし"],["に対して","にたいして"],["勝ち誇る","かちほこる"],["こと"],["は"],["ない"],["と"],["。"]]},{"verse":13,"text":"どうか、無垢なわたしを支えとこしえに、御前に立たせてください。","tok":[["どう"],["か"],["、"],["無垢","むく"],["な"],["わたし"],["を"],["支え","ささえ"],["とこしえ"],["に"],["、"],["御前","ごぜん"],["に"],["立たせて","たたせて"],["ください"],["。"]]},{"verse":14,"text":"主をたたえよ、イスラエルの神を世々とこしえに。アーメン、アーメン。","tok":[["主","ぬし"],["を"],["たたえよ"],["、"],["イスラエル"],["の"],["神","かみ"],["を"],["世々","せいせい"],["とこしえ"],["に"],["。"],["アーメン"],["、"],["アーメン"],["。"]]}]
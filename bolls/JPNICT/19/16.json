[{"verse":1,"text":"［ミクタム。ダビデの詩。］神よ、守ってくださいあなたを避けどころとするわたしを。","tok":[["［"],["ミクタム"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["神","かみ"],["よ"],["、"],["守って","まもって"],["ください"],["あなた"],["を"],["避け","さけ"],["どころ"],["と"],["する"],["わたし"],["を"],["。"]]},{"verse":2,"text":"主に申します。「あなたはわたしの主。あなたのほかにわたしの幸いはありません。」","tok":[["主に","おもに"],["申します","もうします"],["。"],["「"],["あなた"],["は"],["わたし"],["の"],["主","ぬし"],["。"],["あなた"],["の"],["ほか"],["に"],["わたし"],["の"],["幸い","さいわい"],["は"],["ありません"],["。"],["」"]]},{"verse":3,"text":"この地の聖なる人々わたしの愛する尊い人々に申します。","tok":[["この"],["地","ち"],["の"],["聖","せい"],["なる"],["人々","ひとびと"],["わたし"],["の"],["愛する","あいする"],["尊い","とうとい"],["人々","ひとびと"],["に"],["申します","もうします"],["。"]]},{"verse":4,"text":"「ほかの神の後を追う者には苦しみが加わる。わたしは血を注ぐ彼らの祭りを行わず彼らの神の名を唇に上らせません。」","tok":[["「"],["ほか"],["の"],["神","かみ"],["の"],["後","あと"],["を"],["追う","おう"],["者","もの"],["に"],["は"],["苦しみ","くるしみ"],["が"],["加わる","くわわる"],["。"],["わたし"],["は"],["血","ち"],["を"],["注ぐ","そそぐ"],["彼","かれ"],["ら"],["の"],["祭り","まつり"],["を"],["行わず","おこなわず"],["彼","かれ"],["ら"],["の"],["神","かみ"],["の"],["名","な"],["を"],["唇","くちびる"],["に"],["上らせません","のぼらせません"],["。"],["」"]]},{"verse":5,"text":"主はわたしに与えられた分、わたしの杯。主はわたしの運命を支える方。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["与えられた","あたえられた"],["分","ぶん"],["、"],["わたし"],["の"],["杯","さかずき"],["。"],["主","ぬし"],["は"],["わたし"],["の"],["運命","うんめい"],["を"],["支える","ささえる"],["方","かた"],["。"]]},{"verse":6,"text":"測り縄は麗しい地を示しわたしは輝かしい嗣業を受けました。","tok":[["測り","はかり"],["縄","なわ"],["は"],["麗しい","うるわしい"],["地","ち"],["を"],["示し","しめし"],["わたし"],["は"],["輝かしい","かがやかしい"],["嗣業","しぎょう"],["を"],["受けました","うけました"],["。"]]},{"verse":7,"text":"わたしは主をたたえます。主はわたしの思いを励ましわたしの心を夜ごと諭してくださいます。","tok":[["わたし"],["は"],["主","ぬし"],["を"],["たたえます"],["。"],["主","ぬし"],["は"],["わたし"],["の"],["思い","おもい"],["を"],["励まし","はげまし"],["わたし"],["の"],["心","こころ"],["を"],["夜","よる"],["ごと"],["諭して","さとして"],["くださいます"],["。"]]},{"verse":8,"text":"わたしは絶えず主に相対しています。主は右にいましわたしは揺らぐことがありません。","tok":[["わたし"],["は"],["絶えず","たえず"],["主に","おもに"],["相対","そうたい"],["して"],["います"],["。"],["主","ぬし"],["は"],["右","みぎ"],["に"],["いまし"],["わたし"],["は"],["揺らぐ","ゆらぐ"],["こと"],["が"],["ありません"],["。"]]},{"verse":9,"text":"わたしの心は喜び、魂は躍ります。からだは安心して憩います。","tok":[["わたし"],["の"],["心","こころ"],["は"],["喜び","よろこび"],["、"],["魂","たましい"],["は"],["躍ります","おどります"],["。"],["から"],["だ"],["は"],["安心","あんしん"],["して"],["憩います","いこいます"],["。"]]},{"verse":10,"text":"あなたはわたしの魂を陰府に渡すことなくあなたの慈しみに生きる者に墓穴を見させず","tok":[["あなた"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["陰府","よみ"],["に"],["渡す","わたす"],["こと"],["なく"],["あなた"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["者","もの"],["に"],["墓穴","ぼけつ"],["を"],["見させず","みさせず"]]},{"verse":11,"text":"命の道を教えてくださいます。わたしは御顔を仰いで満ち足り、喜び祝い右の御手から永遠の喜びをいただきます。","tok":[["命","いのち"],["の"],["道","みち"],["を"],["教えて","おしえて"],["くださいます"],["。"],["わたし"],["は"],["御顔","おかお"],["を"],["仰いで","あおいで"],["満ち足り","みちたり"],["、"],["喜び祝い","よろこびいわい"],["右","みぎ"],["の"],["御手","おて"],["から"],["永遠","えいえん"],["の"],["喜び","よろこび"],["を"],["いただきます"],["。"]]}]
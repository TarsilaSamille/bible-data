[{"verse":1,"text":"［賛歌。感謝のために。］全地よ、主に向かって喜びの叫びをあげよ。","tok":[["［"],["賛歌","さんか"],["。"],["感謝","かんしゃ"],["の"],["ため"],["に"],["。"],["］"],["全地","ぜんち"],["よ"],["、"],["主に","おもに"],["向かって","むかって"],["喜び","よろこび"],["の"],["叫び","さけび"],["を"],["あげ"],["よ"],["。"]]},{"verse":2,"text":"喜び祝い、主に仕え喜び歌って御前に進み出よ。","tok":[["喜び祝い","よろこびいわい"],["、"],["主に","おもに"],["仕え","つかえ"],["喜び歌って","よろこびうたって"],["御前","ごぜん"],["に"],["進み出よ","すすみでよ"],["。"]]},{"verse":3,"text":"知れ、主こそ神であると。主はわたしたちを造られた。わたしたちは主のもの、その民主に養われる羊の群れ。","tok":[["知れ","しれ"],["、"],["主","ぬし"],["こそ"],["神","かみ"],["で"],["ある"],["と"],["。"],["主","ぬし"],["は"],["わたしたち"],["を"],["造られた","つくられた"],["。"],["わたしたち"],["は"],["主","ぬし"],["の"],["もの"],["、"],["その"],["民主","みんしゅ"],["に"],["養われる","やしなわれる"],["羊","ひつじ"],["の"],["群れ","むれ"],["。"]]},{"verse":4,"text":"感謝の歌をうたって主の門に進み賛美の歌をうたって主の庭に入れ。感謝をささげ、御名をたたえよ。","tok":[["感謝","かんしゃ"],["の"],["歌","うた"],["を"],["うたって"],["主","ぬし"],["の"],["門","もん"],["に"],["進み","すすみ"],["賛美","さんび"],["の"],["歌","うた"],["を"],["うたって"],["主","ぬし"],["の"],["庭","にわ"],["に"],["入れ","いれ"],["。"],["感謝","かんしゃ"],["を"],["ささげ"],["、"],["御名","ぎょめい"],["を"],["たたえ"],["よ"],["。"]]},{"verse":5,"text":"主は恵み深く、慈しみはとこしえに主の真実は代々に及ぶ。","tok":[["主","ぬし"],["は"],["恵み","めぐみ"],["深く","ふかく"],["、"],["慈しみ","いつくしみ"],["は"],["とこしえ"],["に"],["主","ぬし"],["の"],["真実","しんじつ"],["は"],["代々","だいだい"],["に"],["及ぶ","およぶ"],["。"]]}]
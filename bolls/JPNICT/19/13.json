[{"verse":1,"text":"［指揮者によって。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"いつまで、主よわたしを忘れておられるのか。いつまで、御顔をわたしから隠しておられるのか。","tok":[["いつ"],["まで"],["、"],["主","ぬし"],["よ"],["わたし"],["を"],["忘れて","わすれて"],["おられる"],["の"],["か"],["。"],["いつ"],["まで"],["、"],["御顔","おかお"],["を"],["わたし"],["から"],["隠して","かくして"],["おられる"],["の"],["か"],["。"]]},{"verse":3,"text":"いつまで、わたしの魂は思い煩い日々の嘆きが心を去らないのか。いつまで、敵はわたしに向かって誇るのか。","tok":[["いつ"],["まで"],["、"],["わたし"],["の"],["魂","たましい"],["は"],["思い煩い","おもいわずらい"],["日々","ひび"],["の"],["嘆き","なげき"],["が"],["心","こころ"],["を"],["去らない","さらない"],["の"],["か"],["。"],["いつ"],["まで"],["、"],["敵","てき"],["は"],["わたし"],["に"],["向かって","むかって"],["誇る","ほこる"],["の"],["か"],["。"]]},{"verse":4,"text":"わたしの神、主よ、顧みてわたしに答えわたしの目に光を与えてください死の眠りに就くことのないように","tok":[["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["顧みて","かえりみて"],["わたし"],["に"],["答え","こたえ"],["わたし"],["の"],["目","め"],["に"],["光","ひかり"],["を"],["与えて","あたえて"],["ください"],["死","し"],["の"],["眠り","ねむり"],["に"],["就く","つく"],["こと"],["の"],["ない"],["よう"],["に"]]},{"verse":5,"text":"敵が勝ったと思うことのないようにわたしを苦しめる者が動揺するわたしを見て喜ぶことのないように。","tok":[["敵","てき"],["が"],["勝った","かった"],["と"],["思う","おもう"],["こと"],["の"],["ない"],["よう"],["に"],["わたし"],["を"],["苦しめる","くるしめる"],["者","もの"],["が"],["動揺","どうよう"],["する"],["わたし"],["を"],["見て","みて"],["喜ぶ","よろこぶ"],["こと"],["の"],["ない"],["よう"],["に"],["。"]]},{"verse":6,"text":"あなたの慈しみに依り頼みます。わたしの心は御救いに喜び躍り主に向かって歌います「主はわたしに報いてくださった」と。","tok":[["あなた"],["の"],["慈しみ","いつくしみ"],["に"],["依り頼みます","よりたのみます"],["。"],["わたし"],["の"],["心","こころ"],["は"],["御救い","おすくい"],["に"],["喜び","よろこび"],["躍り","おどり"],["主","ぬし"],["に"],["向かって","むかって"],["歌います","うたいます"],["「"],["主","ぬし"],["は"],["わたし"],["に"],["報いて","むくいて"],["くださった"],["」"],["と"],["。"]]}]
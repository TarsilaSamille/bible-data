[{"verse":1,"text":"［祈り。神の人モーセの詩。］主よ、あなたは代々にわたしたちの宿るところ。","tok":[["［"],["祈り","いのり"],["。"],["神","かみ"],["の"],["人","ひと"],["モーセ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["あなた"],["は"],["代々","だいだい"],["に"],["わたしたち"],["の"],["宿る","やどる"],["ところ"],["。"]]},{"verse":2,"text":"山々が生まれる前から大地が、人の世が、生み出される前から世々とこしえに、あなたは神。","tok":[["山々","やまやま"],["が"],["生まれる","うまれる"],["前","まえ"],["から"],["大地","だいち"],["が"],["、"],["人","ひと"],["の"],["世","よ"],["が"],["、"],["生み出される","うみだされる"],["前","まえ"],["から"],["世々","せいせい"],["とこしえ"],["に"],["、"],["あなた"],["は"],["神","かみ"],["。"]]},{"verse":3,"text":"あなたは人を塵に返し「人の子よ、帰れ」と仰せになります。","tok":[["あなた"],["は"],["人","ひと"],["を"],["塵","ごみ"],["に"],["返し","かえし"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["帰れ","かえれ"],["」"],["と"],["仰せ","おおせ"],["に"],["なります"],["。"]]},{"verse":4,"text":"千年といえども御目には昨日が今日へと移る夜の一時にすぎません。","tok":[["千","せん"],["年","ねん"],["と"],["いえ"],["ど"],["も"],["御目","おめ"],["に"],["は"],["昨日","きのう"],["が"],["今日","きょう"],["へ"],["と"],["移る","うつる"],["夜","よる"],["の"],["一時","いちじ"],["に"],["すぎません"],["。"]]},{"verse":5,"text":"あなたは眠りの中に人を漂わせ朝が来れば、人は草のように移ろいます。","tok":[["あなた"],["は"],["眠り","ねむり"],["の"],["中","なか"],["に"],["人","ひと"],["を"],["漂わせ","ただよわせ"],["朝","あさ"],["が"],["来れば","くれば"],["、"],["人","ひと"],["は"],["草","くさ"],["の"],["よう"],["に"],["移ろいます","うつろいます"],["。"]]},{"verse":6,"text":"朝が来れば花を咲かせ、やがて移ろい夕べにはしおれ、枯れて行きます。","tok":[["朝","あさ"],["が"],["来れば","くれば"],["花","はな"],["を"],["咲かせ","さかせ"],["、"],["やがて"],["移ろい","うつろい"],["夕べ","ゆうべ"],["に"],["は"],["しおれ"],["、"],["枯れて","かれて"],["行きます","いきます"],["。"]]},{"verse":7,"text":"あなたの怒りにわたしたちは絶え入りあなたの憤りに恐れます。","tok":[["あなた"],["の"],["怒り","いかり"],["に"],["わたしたち"],["は"],["絶え入り","たえいり"],["あなた"],["の"],["憤り","いきどおり"],["に"],["恐れます","おそれます"],["。"]]},{"verse":8,"text":"あなたはわたしたちの罪を御前に隠れた罪を御顔の光の中に置かれます。","tok":[["あなた"],["は"],["わたしたち"],["の"],["罪","つみ"],["を"],["御前","ごぜん"],["に"],["隠れた","かくれた"],["罪","つみ"],["を"],["御顔","おかお"],["の"],["光","ひかり"],["の"],["中","なか"],["に"],["置かれます","おかれます"],["。"]]},{"verse":9,"text":"わたしたちの生涯は御怒りに消え去り人生はため息のように消えうせます。","tok":[["わたしたち"],["の"],["生涯","しょうがい"],["は"],["御怒り","おいかり"],["に"],["消え去り","きえさり"],["人生","じんせい"],["は"],["ため息","ためいき"],["の"],["よう"],["に"],["消えうせます","きえうせます"],["。"]]},{"verse":10,"text":"人生の年月は七十年程のものです。健やかな人が八十年を数えても得るところは労苦と災いにすぎません。瞬く間に時は過ぎ、わたしたちは飛び去ります。","tok":[["人生","じんせい"],["の"],["年月","としつき"],["は"],["七十","ななじゅう"],["年","ねん"],["程","ほど"],["の"],["もの"],["です"],["。"],["健やか","すこやか"],["な"],["人","ひと"],["が"],["八十","はちじゅう"],["年","ねん"],["を"],["数えて","かぞえて"],["も"],["得る","える"],["ところ"],["は"],["労苦","ろうく"],["と"],["災い","わざわい"],["に"],["すぎません"],["。"],["瞬く","しばたたく"],["間","あいだ"],["に"],["時","とき"],["は"],["過ぎ","すぎ"],["、"],["わたしたち"],["は"],["飛び去ります","とびさります"],["。"]]},{"verse":11,"text":"御怒りの力を誰が知りえましょうか。あなたを畏れ敬うにつれてあなたの憤りをも知ることでしょう。","tok":[["御怒り","おいかり"],["の"],["力","ちから"],["を"],["誰","だれ"],["が"],["知り","しり"],["えましょう"],["か"],["。"],["あなた"],["を"],["畏れ","おそれ"],["敬う","うやまう"],["に"],["つれて"],["あなた"],["の"],["憤り","いきどおり"],["を"],["も"],["知る","しる"],["こと"],["でしょう"],["。"]]},{"verse":12,"text":"生涯の日を正しく数えるように教えてください。知恵ある心を得ることができますように。","tok":[["生涯","しょうがい"],["の"],["日","ひ"],["を"],["正しく","まさしく"],["数える","かぞえる"],["よう"],["に"],["教えて","おしえて"],["ください"],["。"],["知恵","ちえ"],["ある"],["心","こころ"],["を"],["得る","える"],["こと"],["が"],["できます"],["よう"],["に"],["。"]]},{"verse":13,"text":"主よ、帰って来てください。いつまで捨てておかれるのですか。あなたの僕らを力づけてください。","tok":[["主","ぬし"],["よ"],["、"],["帰って","かえって"],["来て","きて"],["ください"],["。"],["いつ"],["まで"],["捨てて","すてて"],["おかれる"],["の"],["です"],["か"],["。"],["あなた"],["の"],["僕","ぼく"],["ら"],["を"],["力づけて","ちからづけて"],["ください"],["。"]]},{"verse":14,"text":"朝にはあなたの慈しみに満ち足らせ生涯、喜び歌い、喜び祝わせてください。","tok":[["朝","あさ"],["に"],["は"],["あなた"],["の"],["慈しみ","いつくしみ"],["に"],["満ち","みち"],["足らせ","たらせ"],["生涯","しょうがい"],["、"],["喜び歌い","よろこびうたい"],["、"],["喜び祝わせて","よろこびいわわせて"],["ください"],["。"]]},{"verse":15,"text":"あなたがわたしたちを苦しめられた日々と苦難に遭わされた年月を思ってわたしたちに喜びを返してください。","tok":[["あなた"],["が"],["わたしたち"],["を"],["苦しめられた","くるしめられた"],["日々","ひび"],["と"],["苦難","くなん"],["に"],["遭わされた","あわされた"],["年月","としつき"],["を"],["思って","おもって"],["わたしたち"],["に"],["喜び","よろこび"],["を"],["返して","かえして"],["ください"],["。"]]},{"verse":16,
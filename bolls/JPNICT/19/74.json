[{"verse":1,"text":"［マスキール。アサフの詩。］神よ、なぜあなたは養っておられた羊の群れに怒りの煙をはき永遠に突き放してしまわれたのですか。","tok":[["［"],["マスキール"],["。"],["アサフ"],["の"],["詩","し"],["。"],["］"],["神","かみ"],["よ"],["、"],["なぜ"],["あなた"],["は"],["養って","やしなって"],["おられた"],["羊","ひつじ"],["の"],["群れ","むれ"],["に"],["怒り","いかり"],["の"],["煙","けむり"],["を"],["はき"],["永遠","えいえん"],["に"],["突き放して","つきはなして"],["しまわれた"],["の"],["です"],["か"],["。"]]},{"verse":2,"text":"どうか、御心に留めてくださいすでにいにしえから御自分のものとし御自分の嗣業の部族として贖われた会衆をあなたのいます所であったこのシオンの山を。","tok":[["どう"],["か"],["、"],["御心","おこころ"],["に"],["留めて","とめて"],["ください"],["すでに"],["いにしえ"],["から"],["御自分","ごじぶん"],["の"],["もの"],["と"],["し"],["御自分","ごじぶん"],["の"],["嗣業","しぎょう"],["の"],["部族","ぶぞく"],["として"],["贖われた","あがなわれた"],["会衆","かいしゅう"],["を"],["あなた"],["の"],["います"],["所","ところ"],["で"],["あった"],["この"],["シオン"],["の"],["山","やま"],["を"],["。"]]},{"verse":3,"text":"永遠の廃虚となったところに足を向けてください。敵は聖所のすべてに災いをもたらしました。","tok":[["永遠","えいえん"],["の"],["廃虚","はいきょ"],["と"],["なった"],["ところ"],["に"],["足","あし"],["を"],["向けて","むけて"],["ください"],["。"],["敵","てき"],["は"],["聖","せい"],["所","しょ"],["の"],["すべて"],["に"],["災い","わざわい"],["を"],["もたらしました"],["。"]]},{"verse":4,"text":"あなたに刃向かう者は、至聖所の中でほえ猛り自分たちのしるしをしるしとして立てました。","tok":[["あなた"],["に"],["刃向かう","はむかう"],["者","もの"],["は"],["、"],["至聖所","しせいしょ"],["の"],["中","なか"],["で"],["ほえ"],["猛り","たけり"],["自分","じぶん"],["たち"],["の"],["しるし"],["を"],["しるし"],["として"],["立てました","たてました"],["。"]]},{"verse":5,"text":"彼らが木の茂みの中を斧を携えて上るのが見えると","tok":[["彼","かれ"],["ら"],["が"],["木","き"],["の"],["茂み","しげみ"],["の"],["中","なか"],["を"],["斧","おの"],["を"],["携えて","たずさえて"],["上る","のぼる"],["の"],["が"],["見える","みえる"],["と"]]},{"verse":6,"text":"ただちに手斧、まさかりを振るって彫り物の飾りをすべて打ち壊し","tok":[["ただちに"],["手斧","ちょうな"],["、"],["まさかり"],["を"],["振るって","ふるって"],["彫り物","ほりもの"],["の"],["飾り","かざり"],["を"],["すべて"],["打ち壊し","うちこわし"]]},{"verse":7,"text":"あなたの聖所に火をかけ御名の置かれた所を地に引き倒して汚しました。","tok":[["あなた"],["の"],["聖","せい"],["所","しょ"],["に"],["火","ひ"],["を"],["かけ"],["御名","ぎょめい"],["の"],["置かれた","おかれた"],["所","ところ"],["を"],["地","ち"],["に"],["引き倒して","ひきたおして"],["汚しました","よごしました"],["。"]]},{"verse":8,"text":"「すべて弾圧せねばならない」と心に言ってこの地にある神の会堂をすべて焼き払いました。","tok":[["「"],["すべて"],["弾圧","だんあつ"],["せねば"],["ならない"],["」"],["と"],["心","こころ"],["に"],["言って","いって"],["この"],["地","ち"],["に"],["ある"],["神","かみ"],["の"],["会堂","かいどう"],["を"],["すべて"],["焼き払いました","やきはらいました"],["。"]]},{"verse":9,"text":"わたしたちのためのしるしは見えません。今は預言者もいません。いつまで続くのかを知る者もありません。","tok":[["わたしたち"],["の"],["ため"],["の"],["しるし"],["は"],["見えません","みえません"],["。"],["今","いま"],["は"],["預言者","よげんしゃ"],["も"],["いません"],["。"],["いつ"],["まで"],["続く","つづく"],["の"],["か"],["を"],["知る","しる"],["者","もの"],["も"],["ありません"],["。"]]},{"verse":10,"text":"神よ、刃向かう者はいつまで嘲るのでしょうか。敵は永久にあなたの御名を侮るのでしょうか。","tok":[["神","かみ"],["よ"],["、"],["刃向かう","はむかう"],["者","もの"],["は"],["いつ"],["まで"],["嘲る","あざける"],["の"],["でしょう"],["か"],["。"],["敵","てき"],["は"],["永久","えいきゅう"],["に"],["あなた"],["の"],["御名","ぎょめい"],["を"],["侮る","あなどる"],["の"],["でしょう"],["か"],["。"]]},{"verse":11,"text":"なぜ、手を引いてしまわれたのですか右の御手は、ふところに入れられたまま。","tok":[["なぜ"],["、"],["手","て"],["を"],["引いて","ひいて"],["しまわれた"],["の"],["です"],["か"],["右","みぎ"],["の"],["御手","おて"],["は"],["、"],["ふところ"],["に"],["入れられた","いれられた"],["まま"],["。"]]},{"verse":12,"text":"しかし神よ、いにしえよりのわたしの王よこの地に救いの御業を果たされる方よ。","tok":[["しかし"],["神","かみ"],["よ"],["、"],["いにしえ"],["より"],["の"],["わたし"],["の"],["王","おう"],["よ"],["この"],["地","ち"],["に"],["救い","すくい"],["の"],["御業","ごごう"],["を"],["果たされる","はたされる"],["方","かた"],["よ"],["。"]]},{"verse":13,"text":"あなたは、御力をもって海を分け大水の上で竜の頭を砕かれました。","tok":[["あなた"],["は"],["、"],["御力","おちから"],["を"],["もって"],["海","うみ"],["を"],["分け","わけ"],["大水","おおみず"],["の"],["上","うえ"],["で"],["竜","りゅう"],["の"],["頭","あたま"],["を"],["砕かれました","くだかれました"],["。"]]},{"verse":14,"text":"レビヤタンの頭を打ち砕きそれを砂漠の民の食糧とされたのもあなたです。","tok":[["レビヤタン"],["の"],["頭","あたま"],["を"],["打ち砕き","うちくだき"],["それ"],["を"],["砂漠","さばく"],["の"],["民","たみ"],["の"],["食糧","しょくりょう"],["と"],["された"],["の"],["も"],["あなた"],["です"],["。"]]},{"verse":15,"text":"あなたは、泉や川を開かれましたが絶えることのない大河の水を涸らされました。","tok":[["あなた"],["は"],["、"],["泉","いずみ"],["や"],["川","かわ"],["を"],["開かれました","ひらかれました"],["が"],["絶える","たえる"],["こと"],["の"],["ない"],["大河","たいが"],["の"],["水","みず"],["を"],["涸らされました","からされました"],["。"]]},{"verse":16,"text":"あなたは、太陽と光を放つ物を備えられました。昼はあなたのもの、そして夜もあなたのものです。","tok":[["あなた"],["は"],["、"],["太陽","たいよう"],["と"],["光","ひかり"],["を"],["放つ","はなつ"],["物","もの"],["を"],["備えられました","そなえられました"],["。"],["昼","ひる"],["は"],["あなた"],["の"],["もの"],["、"],["そして"],["夜","よる"],["も"],["あなた"],["の"],["もの"],["です"],["。"]]},{"verse":17,"text":"あなたは、地の境をことごとく定められました。夏と冬を造られたのもあなたです。","tok":[["あなた"],["は"],["、"],["地","ち"],["の"],["境","さかい"],["を"],["ことごとく"],["定められました","さだめられました"],["。"],["夏","なつ"],["と"],["冬","ふゆ"],["を"],["造られた","つくられた"],["の"],["も"],["あなた"],["です"],["。"]]},{"verse":18,"text":"主よ、御心に留めてください、敵が嘲るのを神を知らぬ民があなたの御名を侮るのを。","tok":[["主","ぬし"],["よ"],["、"],["御心","おこころ"],["に"],["留めて","とめて"],["ください"],["、"],["敵","てき"],["が"],["嘲る","あざける"],["の"],["を"],["神","かみ"],["を"],["知らぬ","しらぬ"],["民","たみ"],["が"],["あなた"],["の"],["御名","ぎょめい"],["を"],["侮る","あなどる"],["の"],["を"],["。"]]},{"verse":19,"text":"あなたの鳩の魂を獣に渡さないでください。あなたの貧しい人々の命を永遠に忘れ去らないでください。","tok":[["あなた"],["の"],["鳩","はと"],["の"],["魂","たましい"],["を"],["獣","けもの"],["に"],["渡さないで","わたさないで"],["ください"],["。"],["あなた"],["の"],["貧しい","まずしい"],["人々","ひとびと"],["の"],["命","いのち"],["を"],["永遠","えいえん"],["に"],["忘れ去らないで","わすれさらないで"],["ください"],["。"]]},{"verse":20,"text":"契約を顧みてください。地の暗い隅々には不法の住みかがひしめいています。","tok":[["契約","けいやく"],["を"],["顧みて","かえりみて"],["ください"],["。"],["地","ち"],["の"],["暗い","くらい"],["隅々","すみずみ"],["に"],["は"],["不法","ふほう"],["の"],["住みか","すみか"],["が"],["ひしめいて"],["います"],["。"]]},{"verse":21,"text":"どうか、虐げられた人が再び辱められることなく貧しい人、乏しい人が御名を賛美することができますように。","tok":[["どう"],["か"],["、"],["虐げられた","しいたげられた"],["人","ひと"],["が"],["再び","ふたたび"],["辱められる","はずかしめられる"],["こと"],["なく"],["貧しい","まずしい"],["人","ひと"],["、"],["乏しい","とぼしい"],["人","ひと"],["が"],["御名","ぎょめい"],["を"],["賛美","さんび"],["する"],["こと"],["が"],["できます"],["よう"],["に"],["。"]]},{"verse":22,"text":"神よ、立ち上がり御自分のために争ってください。神を知らぬ者が絶えずあなたを嘲っているのを御心に留めてください。","tok":[["神","かみ"],["よ"],["、"],["立ち上がり","たちあがり"],["御自分","ごじぶん"],["の"],["ため"],["に"],["争って","あらそって"],["ください"],["。"],["神","かみ"],["を"],["知らぬ","しらぬ"],["者","もの"],["が"],["絶えず","たえず"],["あなた"],["を"],["嘲って",
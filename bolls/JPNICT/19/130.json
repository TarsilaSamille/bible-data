[{"verse":1,"text":"［都に上る歌。］深い淵の底から、主よ、あなたを呼びます。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["深い","ふかい"],["淵","ふち"],["の"],["底","そこ"],["から"],["、"],["主","ぬし"],["よ"],["、"],["あなた"],["を"],["呼びます","よびます"],["。"]]},{"verse":2,"text":"主よ、この声を聞き取ってください。嘆き祈るわたしの声に耳を傾けてください。","tok":[["主","ぬし"],["よ"],["、"],["この"],["声","こえ"],["を"],["聞き取って","ききとって"],["ください"],["。"],["嘆き","なげき"],["祈る","いのる"],["わたし"],["の"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"]]},{"verse":3,"text":"主よ、あなたが罪をすべて心に留められるなら主よ、誰が耐ええましょう。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["が"],["罪","つみ"],["を"],["すべて"],["心","こころ"],["に"],["留められるなら","とめられるなら"],["主","ぬし"],["よ"],["、"],["誰","だれ"],["が"],["耐え","たえ"],["えましょう"],["。"]]},{"verse":4,"text":"しかし、赦しはあなたのもとにあり人はあなたを畏れ敬うのです。","tok":[["しかし"],["、"],["赦し","ゆるし"],["は"],["あなた"],["の"],["もと"],["に"],["あり"],["人","ひと"],["は"],["あなた"],["を"],["畏れ","おそれ"],["敬う","うやまう"],["の"],["です"],["。"]]},{"verse":5,"text":"わたしは主に望みをおきわたしの魂は望みをおき御言葉を待ち望みます。","tok":[["わたし"],["は"],["主に","おもに"],["望み","のぞみ"],["を"],["おき"],["わたし"],["の"],["魂","たましい"],["は"],["望み","のぞみ"],["を"],["おき"],["御言葉","おことば"],["を"],["待ち望みます","まちのぞみます"],["。"]]},{"verse":6,"text":"わたしの魂は主を待ち望みます見張りが朝を待つにもまして見張りが朝を待つにもまして。","tok":[["わたし"],["の"],["魂","たましい"],["は"],["主","ぬし"],["を"],["待ち望みます","まちのぞみます"],["見張り","みはり"],["が"],["朝","あさ"],["を"],["待つ","まつ"],["に"],["も"],["まして"],["見張り","みはり"],["が"],["朝","あさ"],["を"],["待つ","まつ"],["に"],["も"],["まして"],["。"]]},{"verse":7,"text":"イスラエルよ、主を待ち望め。慈しみは主のもとに豊かな贖いも主のもとに。","tok":[["イスラエル"],["よ"],["、"],["主","ぬし"],["を"],["待ち望め","まちのぞめ"],["。"],["慈しみ","いつくしみ"],["は"],["主","ぬし"],["の"],["もと"],["に"],["豊か","ゆたか"],["な"],["贖い","あがない"],["も"],["主","ぬし"],["の"],["もと"],["に"],["。"]]},{"verse":8,"text":"主は、イスラエルをすべての罪から贖ってくださる。","tok":[["主","ぬし"],["は"],["、"],["イスラエル"],["を"],["すべて"],["の"],["罪","つみ"],["から"],["贖って","あがなって"],["くださる"],["。"]]}]
[{"verse":1,"text":"［祈り。ダビデの詩。］主よ、正しい訴えを聞きわたしの叫びに耳を傾け祈りに耳を向けてください。わたしの唇に欺きはありません。","tok":[["［"],["祈り","いのり"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["正しい","ただしい"],["訴え","うったえ"],["を"],["聞き","きき"],["わたし"],["の"],["叫び","さけび"],["に"],["耳","みみ"],["を"],["傾け","かたむけ"],["祈り","いのり"],["に"],["耳","みみ"],["を"],["向けて","むけて"],["ください"],["。"],["わたし"],["の"],["唇","くちびる"],["に"],["欺き","あざむき"],["は"],["ありません"],["。"]]},{"verse":2,"text":"御前からわたしのために裁きを送り出しあなた御自身の目をもって公平に御覧ください。","tok":[["御前","ごぜん"],["から"],["わたし"],["の"],["ため"],["に"],["裁き","さばき"],["を"],["送り出し","おくりだし"],["あなた"],["御自身","ごじしん"],["の"],["目","め"],["を"],["もって"],["公平","こうへい"],["に"],["御覧","ごらん"],["ください"],["。"]]},{"verse":3,"text":"あなたはわたしの心を調べ、夜なお尋ね","tok":[["あなた"],["は"],["わたし"],["の"],["心","こころ"],["を"],["調べ","しらべ"],["、"],["夜","よる"],["なお"],["尋ね","たずね"]]},{"verse":4,"text":"火をもってわたしを試されますが汚れた思いは何ひとつ御覧にならないでしょう。わたしの口は人の習いに従うことなくあなたの唇の言葉を守ります。暴力の道を避けて","tok":[["火","ひ"],["を"],["もって"],["わたし"],["を"],["試されます","ためされます"],["が"],["汚れた","よごれた"],["思い","おもい"],["は"],["何","なん"],["ひと"],["つ"],["御覧","ごらん"],["に"],["ならないでしょう"],["。"],["わたし"],["の"],["口","くち"],["は"],["人","ひと"],["の"],["習い","ならい"],["に"],["従う","したがう"],["こと"],["なく"],["あなた"],["の"],["唇","くちびる"],["の"],["言葉","ことば"],["を"],["守ります","まもります"],["。"],["暴力","ぼうりょく"],["の"],["道","みち"],["を"],["避けて","さけて"]]},{"verse":5,"text":"あなたの道をたどり一歩一歩、揺らぐことなく進みます。","tok":[["あなた"],["の"],["道","みち"],["を"],["たどり"],["一歩","いっぽ"],["一歩","いっぽ"],["、"],["揺らぐ","ゆらぐ"],["こと"],["なく"],["進みます","すすみます"],["。"]]},{"verse":6,"text":"あなたを呼び求めます神よ、わたしに答えてください。わたしに耳を向け、この訴えを聞いてください。","tok":[["あなた"],["を"],["呼び求めます","よびもとめます"],["神","かみ"],["よ"],["、"],["わたし"],["に"],["答えて","こたえて"],["ください"],["。"],["わたし"],["に"],["耳","みみ"],["を"],["向け","むけ"],["、"],["この"],["訴え","うったえ"],["を"],["聞いて","きいて"],["ください"],["。"]]},{"verse":7,"text":"慈しみの御業を示してください。あなたを避けどころとする人を立ち向かう者から右の御手をもって救ってください。","tok":[["慈しみ","いつくしみ"],["の"],["御業","ごごう"],["を"],["示して","しめして"],["ください"],["。"],["あなた"],["を"],["避け","さけ"],["どころ"],["と"],["する"],["人","ひと"],["を"],["立ち向かう","たちむかう"
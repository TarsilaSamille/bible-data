[{"verse":1,"text":"［賛歌。歌。安息日に。］","tok":[["［"],["賛歌","さんか"],["。"],["歌","うた"],["。"],["安息日","あんそくび"],["に"],["。"],["］"]]},{"verse":2,"text":"いかに楽しいことでしょう主に感謝をささげることはいと高き神よ、御名をほめ歌い","tok":[["いかに"],["楽しい","たのしい"],["こと"],["でしょう"],["主に","おもに"],["感謝","かんしゃ"],["を"],["ささげる"],["こと"],["は"],["いと"],["高き","たかき"],["神","かみ"],["よ"],["、"],["御名","ぎょめい"],["を"],["ほめ"],["歌い","うたい"]]},{"verse":3,"text":"朝ごとに、あなたの慈しみを夜ごとに、あなたのまことを述べ伝えることは","tok":[["朝","あさ"],["ごと"],["に"],["、"],["あなた"],["の"],["慈しみ","いつくしみ"],["を"],["夜","よる"],["ごと"],["に"],["、"],["あなた"],["の"],["まこと"],["を"],["述べ伝える","のべつたえる"],["こと"],["は"]]},{"verse":4,"text":"十弦の琴に合わせ、竪琴に合わせ琴の調べに合わせて。","tok":[["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["に"],["合わせ","あわせ"],["、"],["竪琴","たてごと"],["に"],["合わせ","あわせ"],["琴","こと"],["の"],["調べ","しらべ"],["に"],["合わせて","あわせて"],["。"]]},{"verse":5,"text":"主よ、あなたは御業を喜び祝わせてくださいます。わたしは御手の業を喜び歌います。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["御業","ごぎょう"],["を"],["喜び祝わせて","よろこびいわわせて"],["くださいます"],["。"],["わたし"],["は"],["御手","おて"],["の"],["業","ごう"],["を"],["喜び歌います","よろこびうたいます"],["。"]]},{"verse":6,"text":"主よ、御業はいかに大きく御計らいはいかに深いことでしょう。","tok":[["主","ぬし"],["よ"],["、"],["御業","ごぎょう"],["は"],["いかに"],["大きく","おおきく"],["御計らい","おはからい"],["は"],["いかに"],["深い","ふかい"],["こと"],["でしょう"],["。"]]},{"verse":7,"text":"愚かな者はそれを知ることなく無知な者はそれを悟ろうとしません。","tok":[["愚か","おろか"],["な"],["者","もの"],["は"],["それ"],["を"],["知る","しる"],["こと"],["なく"],["無知","むち"],["な"],["者","もの"],["は"],["それ"],["を"],["悟ろう","さとろう"],["と"],["しません"],["。"]]},{"verse":8,"text":"神に逆らう者が野の草のように茂り悪を行う者が皆、花を咲かせるように見えても永遠に滅ぼされてしまいます。","tok":[["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["が"],["野","の"],["の"],["草","くさ"],["の"],["よう"],["に"],["茂り","しげり"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["が"],["皆","みな"],["、"],["花","はな"],["を"],["咲かせる","さかせる"],["よう"],["に"],["見えて","みえて"],["も"],["永遠","えいえん"],["に"],["滅ぼされて","ほろぼされて"],["しまいます"],["。"]]},{"verse":9,"text":"主よ、あなたこそ、永遠に高くいます方。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["こそ"],["、"],["永遠","えいえん"],["に"],["高く","たかく"],["います"],["方","かた"],["。"]]},{"verse":10,"text":"主よ
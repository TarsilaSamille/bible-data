[{"verse":1,"text":"ハレルヤ。わたしは心を尽くして主に感謝をささげる正しい人々の集い、会衆の中で。","tok":[["ハレルヤ"],["。"],["わたし"],["は"],["心","こころ"],["を"],["尽くして","つくして"],["主に","おもに"],["感謝","かんしゃ"],["を"],["ささげる"],["正しい","ただしい"],["人々","ひとびと"],["の"],["集い","つどい"],["、"],["会衆","かいしゅう"],["の"],["中","なか"],["で"],["。"]]},{"verse":2,"text":"主の御業は大きくそれを愛する人は皆、それを尋ね求める。","tok":[["主","ぬし"],["の"],["御業","ごごう"],["は"],["大きく","おおきく"],["それ"],["を"],["愛する","あいする"],["人","ひと"],["は"],["皆","みな"],["、"],["それ"],["を"],["尋ね求める","たずねもとめる"],["。"]]},{"verse":3,"text":"主の成し遂げられることは栄え輝き恵みの御業は永遠に続く。","tok":[["主","ぬし"],["の"],["成し遂げられる","なしとげられる"],["こと"],["は"],["栄え","さかえ"],["輝き","かがやき"],["恵み","めぐみ"],["の"],["御業","ごごう"],["は"],["永遠","えいえん"],["に"],["続く","つづく"],["。"]]},{"verse":4,"text":"主は驚くべき御業を記念するよう定められた。主は恵み深く憐れみに富み","tok":[["主","ぬし"],["は"],["驚くべき","おどろくべき"],["御業","ごごう"],["を"],["記念","きねん"],["する"],["よう"],["定められた","さだめられた"],["。"],["主","ぬし"],["は"],["恵み","めぐみ"],["深く","ふかく"],["憐れみ","あわれみ"],["に"],["富み","とみ"]]},{"verse":5,"text":"主を畏れる人に糧を与え契約をとこしえに御心に留め","tok":[["主","ぬし"],["を"],["畏れる","おそれる"],["人","ひと"],["に"],["糧","かて"],["を"],["与え","あたえ"],["契約","けいやく"],["を"],["とこしえ"],["に"],["御心","おこころ"],["に"],["留め","とめ"]]},{"verse":6,"text":"御業の力を御自分の民に示し諸国の嗣業を御自分の民にお与えになる。","tok":[["御業","ごぎょう"],["の"],["力","ちから"],["を"],["御自分","ごじぶん"],["の"],["民","たみ"],["に"],["示し","しめし"],["諸国","しょこく"],["の"],["嗣業","しぎょう"],["を"],["御自分","ごじぶん"],["の"],["民","たみ"],["に"],["お与え","おあたえ"],["に"],["なる"],["。"]]},{"verse":7,"text":"御手の業はまことの裁き主の命令はすべて真実","tok":[["御手","おて"],["の"],["業","ごう"],["は"],["まこと"],["の"],["裁き","さばき"],["主","ぬし"],["の"],["命令","めいれい"],["は"],["すべて"],["真実","しんじつ"]]},{"verse":8,"text":"世々限りなく堅固にまことをもって、まっすぐに行われる。","tok":[["世々","せいせい"],["限りなく","かぎりなく"],["堅固","けんご"],["に"],["まこと"],["を"],["もって"],["、"],["まっすぐ"],["に"],["行われる","おこなわれる"],["。"]]},{"verse":9,"text":"主は御自分の民に贖いを送り契約をとこしえのものと定められた。御名は畏れ敬うべき聖なる御名。","tok":[["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["に"],["贖い","あがない"],["を"],["送り","おくり"],["契約","けいやく"],["を"],["とこしえ"],["の"],["もの"],["と"],["定められた","さだめられた"],["。"],["御名","ぎょめい"],["
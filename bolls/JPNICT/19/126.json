[{"verse":1,"text":"［都に上る歌。］主がシオンの捕われ人を連れ帰られると聞いてわたしたちは夢を見ている人のようになった。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["主","ぬし"],["が"],["シオン"],["の"],["捕われ人","とらわれにん"],["を"],["連れ帰られる","つれかえられる"],["と"],["聞いて","きいて"],["わたしたち"],["は"],["夢","ゆめ"],["を"],["見て","みて"],["いる"],["人","ひと"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":2,"text":"そのときには、わたしたちの口に笑いが舌に喜びの歌が満ちるであろう。そのときには、国々も言うであろう「主はこの人々に、大きな業を成し遂げられた」と。","tok":[["その"],["とき"],["に"],["は"],["、"],["わたしたち"],["の"],["口","くち"],["に"],["笑い","わらい"],["が"],["舌","した"],["に"],["喜び","よろこび"],["の"],["歌","うた"],["が"],["満ちるで","みちるで"],["あろう"],["。"],["その"],["とき"],["に"],["は"],["、"],["国々","くにぐに"],["も"],["言うで","ゆうで"],["あろう"],["「"],["主","ぬし"],["は"],["この"],["人々","ひとびと"],["に"],["、"],["大きな","おおきな"],["業","ごう"],["を"],["成し遂げられた","なしとげられた"],["」"],["と"],["。"]]},{"verse":3,"text":"主よ、わたしたちのために大きな業を成し遂げてください。わたしたちは喜び祝うでしょう。","tok":[["主","ぬし"],["よ"],["、"],["わたしたち"],["の"],["ため"],["に"],["大きな","おおきな"],["業","ごう"],["を"],["成し遂げて","なしとげて"],["ください"],["。"],["わたしたち"],["は"],["喜び祝うでしょう","よろこびいわうでしょう"],["。"]]},{"verse":4,"text":"主よ、ネゲブに川の流れを導くかのようにわたしたちの捕われ人を連れ帰ってください。","tok":[["主","ぬし"],["よ"],["、"],["ネゲブ"],["に"],["川","かわ"],["の"],["流れ","ながれ"],["を"],["導く","みちびく"],["か"],["の"],["よう"],["に"],["わたしたち"],["の"],["捕われ人","とらわれにん"],["を"],["連れ帰って","つれかえって"],["ください"],["。"]]},{"verse":5,"text":"涙と共に種を蒔く人は喜びの歌と共に刈り入れる。","tok":[["涙","なみだ"],["と"],["共","とも"],["に"],["種","しゅ"],["を"],["蒔く","まく"],["人","ひと"],["は"],["喜び","よろこび"],["の"],["歌","うた"],["と"],["共","とも"],["に"],["刈り入れる","かりいれる"],["。"]]},{"verse":6,"text":"種の袋を背負い、泣きながら出て行った人は束ねた穂を背負い喜びの歌をうたいながら帰ってくる。","tok":[["種","しゅ"],["の"],["袋","ふくろ"],["を"],["背負い","せおい"],["、"],["泣き","なき"],["ながら"],["出て","でて"],["行った","いった"],["人","ひと"],["は"],["束ねた","たばねた"],["穂","ほ"],["を"],["背負い","せおい"],["喜び","よろこび"],["の"],["歌","うた"],["を"],["うたい"],["ながら"],["帰って","かえって"],["くる"],["。"]]}]
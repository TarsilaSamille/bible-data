[{"verse":1,"text":"［賛歌。ダビデの詩。］主よ、どのような人が、あなたの幕屋に宿り聖なる山に住むことができるのでしょうか。","tok":[["［"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["どのような"],["人","ひと"],["が"],["、"],["あなた"],["の"],["幕屋","まくや"],["に"],["宿り","やどり"],["聖","せい"],["なる"],["山","やま"],["に"],["住む","すむ"],["こと"],["が"],["できる"],["の"],["でしょう"],["か"],["。"]]},{"verse":2,"text":"それは、完全な道を歩き、正しいことを行う人。心には真実の言葉があり","tok":[["それ"],["は"],["、"],["完全","かんぜん"],["な"],["道","みち"],["を"],["歩き","あるき"],["、"],["正しい","ただしい"],["こと"],["を"],["行う","おこなう"],["人","ひと"],["。"],["心","こころ"],["に"],["は"],["真実","しんじつ"],["の"],["言葉","ことば"],["が"],["あり"]]},{"verse":3,"text":"舌には中傷をもたない人。友に災いをもたらさず、親しい人を嘲らない人。","tok":[["舌","した"],["に"],["は"],["中傷","ちゅうしょう"],["を"],["もたない"],["人","ひと"],["。"],["友","とも"],["に"],["災い","わざわい"],["を"],["もたらさず"],["、"],["親しい","したしい"],["人","ひと"],["を"],["嘲らない","あざけらない"],["人","ひと"],["。"]]},{"verse":4,"text":"主の目にかなわないものは退け主を畏れる人を尊び悪事をしないとの誓いを守る人。","tok":[["主","ぬし"],["の"],["目","め"],["に"],["かなわない"],["もの"],["は"],["退け","しりぞけ"],["主","ぬし"],["を"],["畏れる","おそれる"],["人","ひと"],["を"],["尊び","とうとび"],["悪事","あくじ"],["を"],["しない"],["と"],["の"],["誓い","ちかい"],["を"],["守る","まもる"],["人","ひと"],["。"]]},{"verse":5,"text":"金を貸しても利息を取らず賄賂を受けて無実の人を陥れたりしない人。これらのことを守る人はとこしえに揺らぐことがないでしょう。","tok":[["金","きん"],["を"],["貸して","かして"],["も"],["利息","りそく"],["を"],["取らず","とらず"],["賄賂","わいろ"],["を"],["受けて","うけて"],["無実","むじつ"],["の"],["人","ひと"],["を"],["陥れ","おとしいれ"],["たり"],["しない"],["人","ひと"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["守る","まもる"],["人","ひと"],["は"],["とこしえ"],["に"],["揺らぐ","ゆらぐ"],["こと"],["が"],["ないでしょう"],["。"]]}]
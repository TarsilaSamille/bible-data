[{"verse":1,"text":"［賛歌。ダビデの詩。］主よ、わたしの祈りをお聞きください。嘆き祈る声に耳を傾けてください。あなたのまこと、恵みの御業によってわたしに答えてください。","tok":[["［"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["わたし"],["の"],["祈り","いのり"],["を"],["お聞き","おきき"],["ください"],["。"],["嘆き","なげき"],["祈る","いのる"],["声","こえ"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"],["あなた"],["の"],["まこと"],["、"],["恵み","めぐみ"],["の"],["御業","ごごう"],["によって"],["わたし"],["に"],["答えて","こたえて"],["ください"],["。"]]},{"verse":2,"text":"あなたの僕を裁きにかけないでください。御前に正しいと認められる者は命あるものの中にはいません。","tok":[["あなた"],["の"],["僕","ぼく"],["を"],["裁き","さばき"],["に"],["かけないで"],["ください"],["。"],["御前","ごぜん"],["に"],["正しい","ただしい"],["と"],["認められる","みとめられる"],["者","もの"],["は"],["命","いのち"],["ある"],["もの"],["の"],["中","なか"],["に"],["は"],["いません"],["。"]]},{"verse":3,"text":"敵はわたしの魂に追い迫りわたしの命を地に踏みにじりとこしえの死者と共に闇に閉ざされた国に住まわせようとします。","tok":[["敵","てき"],["は"],["わたし"],["の"],["魂","たましい"],["に"],["追い迫り","おいせまり"],["わたし"],["の"],["命","いのち"],["を"],["地","ち"],["に"],["踏みにじり","ふみにじり"],["とこしえ"],["の"],["死者","ししゃ"],["と"],["共","とも"],["に"],["闇","やみ"],["に"],["閉ざされた","とざされた"],["国","くに"],["に"],["住まわせよう","すまわせよう"],["と"],["します"],["。"]]},{"verse":4,"text":"わたしの霊はなえ果て心は胸の中で挫けます。","tok":[["わたし"],["の"],["霊","れい"],["は"],["なえ"],["果て","はて"],["心","こころ"],["は"],["胸","むね"],["の"],["中","なか"],["で"],["挫けます","くじけます"],["。"]]},{"verse":5,"text":"わたしはいにしえの日々を思い起こしあなたのなさったことをひとつひとつ思い返し御手の業を思いめぐらします。","tok":[["わたし"],["は"],["いにしえ"],["の"],["日々","ひび"],["を"],["思い起こし","おもいおこし"],["あなた"],["の"],["なさった"],["こと"],["を"],["ひと"],["つ"],["ひと"],["つ"],["思い返し","おもいかえし"],["御手","おて"],["の"],["業","ごう"],["を"],["思いめぐらします","おもいめぐらします"],["。"]]},{"verse":6,"text":"あなたに向かって両手を広げ渇いた大地のようなわたしの魂をあなたに向けます。〔セラ","tok":[["あなた"],["に"],["向かって","むかって"],["両手","りょうて"],["を"],["広げ","ひろげ"],["渇いた","かわいた"],["大地","だいち"],["の"],["よう"],["な"],["わたし"],["の"],["魂","たましい"],["を"],["あなた"],["に"],["向けます","むけます"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"主よ、早く答えてくださいわたしの霊は絶え入りそうです。御顔をわたしに隠さないでください。わたしはさながら墓穴に下る者です。","tok":[["主","ぬし"],["よ"],["、"],["早く","はやく"],["答えて","こたえて"],["ください"],["わたし"],["の"],["霊","れい"],["は"],["絶え入り","たえいり"],["そう"],["です"],["。"],["御顔","おかお"],["を"],["わたし"],["に"],["隠さないで","かくさないで"],["ください"],["。"],["わたし"],["は"],["さながら"],["墓穴","ぼけつ"],["に"],["下る","くだる"],["者","もの"],["です"],["。"]]},{"verse":8,"text":"朝にはどうか、聞かせてくださいあなたの慈しみについて。あなたにわたしは依り頼みます。行くべき道を教えてくださいあなたに、わたしの魂は憧れているのです。","tok":[["朝","あさ"],["に"],["は"],["どう"],["か"],["、"],["聞かせて","きかせて"],["ください"],["あなた"],["の"],["慈しみ","いつくしみ"],["について"],["。"],["あなた"],["に"],["わたし"],["は"],["依り頼みます","よりたのみます"],["。"],["行くべき","いくべき"],["道","みち"],["を"],["教えて","おしえて"],["ください"],["あなた"],["に"],["、"],["わたし"],["の"],["魂","たましい"],["は"],["憧れて","あこがれて"],["いる"],["の"],["です"],["。"]]},{"verse":9,"text":"主よ、敵からわたしを助け出してください。御もとにわたしは隠れます。","tok":[["主","ぬし"],["よ"],["、"],["敵","てき"],["から"],["わたし"],["を"],["助け出して","たすけだして"],["ください"],["。"],["御もと","おもと"],["に"],["わたし"],["は"],["隠れます","かくれます"],["。"]]},{"verse":10,"text":"御旨を行うすべを教えてください。あなたはわたしの神。恵み深いあなたの霊によって安らかな地に導いてください。","tok":[["御旨","おむね"],["を"],["行う","おこなう"],["すべ"],["を"],["教えて","おしえて"],["ください"],["。"],["あなた"],["は"],["わたし"],["の"],["神","かみ"],["。"],["恵み","めぐみ"],["深い","ふかい"],["あなた"],["の"],["霊","れい"],["によって"],["安らか","やすらか"],["な"],["地","ち"],["に"],["導いて","みちびいて"],["ください"],["。"]]},{"verse":11,"text":"主よ、御名のゆえに、わたしに命を得させ恵みの御業によってわたしの魂を災いから引き出してください。","tok":[["主","ぬし"],["よ"],["、"],["御名","ぎょめい"],["の"],["ゆえ"],["に"],["、"],["わたし"],["に"],["命","いのち"],["を"],["得させ","えさせ"],["恵み","めぐみ"],["の"],["御業","ごごう"],["によって"],["わたし"],["の"],["魂","たましい"],["を"],["災い","わざわい"],["から"],["引き出して","ひきだして"],["ください"],["。"]]},{"verse":12,"text":"あなたの慈しみのゆえに、敵を絶やしてください。わたしの魂を苦しめる者をことごとく滅ぼしてください。わたしはあなたの僕なのですから。","tok":[["あなた"],["の"],["慈しみ","いつくしみ"],["の"],["ゆえ"],["に"],["、"],["敵","てき"],["を"],["絶やして","たやして"],["ください"],["。"],["わたし"],["の"],["魂","たましい"],["を"],["苦しめる","くるしめる"],["者","もの"],["を"],["ことごとく"],["滅ぼして","ほろぼして"],["ください"],["。"],["わたし"],["は"],["あなた"],["の"],["僕","ぼく"],["な"],["の"],["です"],["から"],["。"]]}]
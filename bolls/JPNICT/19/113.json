[{"verse":1,"text":"ハレルヤ。主の僕らよ、主を賛美せよ主の御名を賛美せよ。","tok":[["ハレルヤ"],["。"],["主","ぬし"],["の"],["僕","ぼく"],["ら"],["よ"],["、"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],["主","ぬし"],["の"],["御名","ぎょめい"],["を"],["賛美","さんび"],["せよ"],["。"]]},{"verse":2,"text":"今よりとこしえに主の御名がたたえられるように。","tok":[["今","いま"],["より"],["とこしえ"],["に"],["主","ぬし"],["の"],["御名","ぎょめい"],["が"],["たたえられる"],["よう"],["に"],["。"]]},{"verse":3,"text":"日の昇るところから日の沈むところまで主の御名が賛美されるように。","tok":[["日","ひ"],["の"],["昇る","のぼる"],["ところ"],["から"],["日","ひ"],["の"],["沈む","しずむ"],["ところ"],["まで"],["主","ぬし"],["の"],["御名","ぎょめい"],["が"],["賛美","さんび"],["される"],["よう"],["に"],["。"]]},{"verse":4,"text":"主はすべての国を超えて高くいまし主の栄光は天を超えて輝く。","tok":[["主","ぬし"],["は"],["すべて"],["の"],["国","くに"],["を"],["超えて","こえて"],["高く","たかく"],["いまし"],["主","ぬし"],["の"],["栄光","えいこう"],["は"],["天","てん"],["を"],["超えて","こえて"],["輝く","かがやく"],["。"]]},{"verse":5,"text":"わたしたちの神、主に並ぶものがあろうか。主は御座を高く置き","tok":[["わたしたち"],["の"],["神","かみ"],["、"],["主に","おもに"],["並ぶ","ならぶ"],["もの"],["が"],["あろう"],["か"],["。"],["主","ぬし"],["は"],["御座","ぎょざ"],["を"],["高く","たかく"],["置き","おき"]]},{"verse":6,"text":"なお、低く下って天と地を御覧になる。","tok":[["なお"],["、"],["低く","ひくく"],["下って","くだって"],["天","てん"],["と"],["地","ち"],["を"],["御覧","ごらん"],["に"],["なる"],["。"]]},{"verse":7,"text":"弱い者を塵の中から起こし乏しい者を芥の中から高く上げ","tok":[["弱い","よわい"],["者","もの"],["を"],["塵","ごみ"],["の"],["中","なか"],["から"],["起こし","おこし"],["乏しい","とぼしい"],["者","もの"],["を"],["芥","あくた"],["の"],["中","なか"],["から"],["高く","たかく"],["上げ","あげ"]]},{"verse":8,"text":"自由な人々の列に民の自由な人々の列に返してくださる。","tok":[["自由","じゆう"],["な"],["人々","ひとびと"],["の"],["列","れつ"],["に"],["民","たみ"],["の"],["自由","じゆう"],["な"],["人々","ひとびと"],["の"],["列","れつ"],["に"],["返して","かえして"],["くださる"],["。"]]},{"verse":9,"text":"子のない女を家に返し子を持つ母の喜びを与えてくださる。ハレルヤ。","tok":[["子","こ"],["の"],["ない"],["女","おんな"],["を"],["家","いえ"],["に"],["返し","かえし"],["子","こ"],["を"],["持つ","もつ"],["母","はは"],["の"],["喜び","よろこび"],["を"],["与えて","あたえて"],["くださる"],["。"],["ハレルヤ"],["。"]]}]
[{"verse":1,"text":"［指揮者によって。伴奏付き。賛歌。歌。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["伴奏付き","ばんそうつき"],["。"],["賛歌","さんか"],["。"],["歌","うた"],["。"],["］"]]},{"verse":2,"text":"神がわたしたちを憐れみ、祝福し御顔の輝きをわたしたちに向けてくださいますように〔セラ","tok":[["神","かみ"],["が"],["わたしたち"],["を"],["憐れみ","あわれみ"],["、"],["祝福","しゅくふく"],["し"],["御顔","おかお"],["の"],["輝き","かがやき"],["を"],["わたしたち"],["に"],["向けて","むけて"],["くださいます"],["よう"],["に"],["〔"],["セラ"]]},{"verse":3,"text":"あなたの道をこの地が知り御救いをすべての民が知るために。","tok":[["あなた"],["の"],["道","みち"],["を"],["この"],["地","ち"],["が"],["知り","しり"],["御救い","おすくい"],["を"],["すべて"],["の"],["民","たみ"],["が"],["知る","しる"],["ため"],["に"],["。"]]},{"verse":4,"text":"神よ、すべての民があなたに感謝をささげますように。すべての民が、こぞってあなたに感謝をささげますように。","tok":[["神","かみ"],["よ"],["、"],["すべて"],["の"],["民","たみ"],["が"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげます"],["よう"],["に"],["。"],["すべて"],["の"],["民","たみ"],["が"],["、"],["こぞって"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげます"],["よう"],["に"],["。"]]},{"verse":5,"text":"諸国の民が喜び祝い、喜び歌いますようにあなたがすべての民を公平に裁きこの地において諸国の民を導かれることを。〔セラ","tok":[["諸国","しょこく"],["の"],["民","たみ"],["が"],["喜び祝い","よろこびいわい"],["、"],["喜び歌います","よろこびうたいます"],["よう"],["に"],["あなた"],["が"],["すべて"],["の"],["民","たみ"],["を"],["公平","こうへい"],["に"],["裁き","さばき"],["この"],["地","ち"],["に"],["おいて"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["導かれる","みちびかれる"],["こと"],["を"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"神よ、すべての民があなたに感謝をささげますように。すべての民が、こぞってあなたに感謝をささげますように。","tok":[["神","かみ"],["よ"],["、"],["すべて"],["の"],["民","たみ"],["が"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげます"],["よう"],["に"],["。"],["すべて"],["の"],["民","たみ"],["が"],["、"],["こぞって"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげます"],["よう"],["に"],["。"]]},{"verse":7,"text":"大地は作物を実らせました。神、わたしたちの神がわたしたちを祝福してくださいますように。","tok":[["大地","だいち"],["は"],["作物","さくもつ"],["を"],["実らせました","みのらせました"],["。"],["神","かみ"],["、"],["わたしたち"],["の"],["神","かみ"],["が"],["わたしたち"],["を"],["祝福","しゅくふく"],["して"],["くださいます"],["よう"],["に"],["。"]]},{"verse":8,"text":"神がわたしたちを祝福してくださいますように。地の果てに至るまですべてのものが神を畏れ敬いますように。","tok":[["神","かみ"],["が"],["わたしたち"],["を"],["祝福","しゅくふく"],["して"],["くださいます"],["よう"],["に"],["。"],["地","ち"],["の"],["果て","はて"],["に"],["至る","いたる"],["まで"],["すべて"],["の"],["もの"],["が"],["神","かみ"],["を"],["畏れ","おそれ"],["敬います","うやまいます"],["よう"],["に"],["。"]]}]
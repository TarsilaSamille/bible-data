[{"verse":1,"text":"［指揮者によって。コラの子の詩。賛歌。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["コラ"],["の"],["子","こ"],["の"],["詩","し"],["。"],["賛歌","さんか"],["。"],["］"]]},{"verse":2,"text":"主よ、あなたは御自分の地をお望みになりヤコブの捕われ人を連れ帰ってくださいました。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["御自分","ごじぶん"],["の"],["地","ち"],["を"],["お望み","おのぞみ"],["に"],["なり"],["ヤコブ"],["の"],["捕われ人","とらわれにん"],["を"],["連れ帰って","つれかえって"],["くださいました"],["。"]]},{"verse":3,"text":"御自分の民の罪を赦し彼らの咎をすべて覆ってくださいました。〔セラ","tok":[["御自分","ごじぶん"],["の"],["民","たみ"],["の"],["罪","つみ"],["を"],["赦し","ゆるし"],["彼","かれ"],["ら"],["の"],["咎","とが"],["を"],["すべて"],["覆って","おおって"],["くださいました"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"怒りをことごとく取り去り激しい憤りを静められました。","tok":[["怒り","いかり"],["を"],["ことごとく"],["取り去り","とりさり"],["激しい","はげしい"],["憤り","いきどおり"],["を"],["静められました","しずめられました"],["。"]]},{"verse":5,"text":"わたしたちの救いの神よわたしたちのもとにお帰りください。わたしたちのための苦悩を静めてください。","tok":[["わたしたち"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["わたしたち"],["の"],["もと"],["に"],["お帰り","おかえり"],["ください"],["。"],["わたしたち"],["の"],["ため"],["の"],["苦悩","くのう"],["を"],["静めて","しずめて"],["ください"],["。"]]},{"verse":6,"text":"あなたはとこしえにわたしたちを怒りその怒りを代々に及ぼされるのですか。","tok":[["あなた"],["は"],["とこしえ"],["に"],["わたしたち"],["を"],["怒り","おこり"],["その"],["怒り","いかり"],["を"],["代々","だいだい"],["に"],["及ぼされる","およぼされる"],["の"],["です"],["か"],["。"]]},{"verse":7,"text":"再びわたしたちに命を得させあなたの民があなたによって喜び祝うようにしてくださらないのですか。","tok":[["再び","ふたたび"],["わたしたち"],["に"],["命","いのち"],["を"],["得させ","えさせ"],["あなた"],["の"],["民","たみ"],["が"],["あなた"],["によって"],["喜び祝う","よろこびいわう"],["よう"],["に"],["して"],["くださらない"],["の"],["です"],["か"],["。"]]},{"verse":8,"text":"主よ、慈しみをわたしたちに示しわたしたちをお救いください。","tok":[["主","ぬし"],["よ"],["、"],["慈しみ","いつくしみ"],["を"],["わたしたち"],["に"],["示し","しめし"],["わたしたち"],["を"],["お救い","おすくい"],["ください"],["。"]]},{"verse":9,"text":"わたしは神が宣言なさるのを聞きます。主は平和を宣言されます御自分の民に、主の慈しみに生きる人々に彼らが愚かなふるまいに戻らないように。","tok":[["わたし"],["は"],["神","かみ"],["が"],["宣言","せんげん"],["なさる"],["の"],["を"],["聞きます","ききます"],["。"],["主","ぬし"],["は"],["平和","へいわ"],["を"],["宣言","せんげん"],["されます"],["御自分","ごじぶん"],["の"],["民","たみ"],["に"],["、"],
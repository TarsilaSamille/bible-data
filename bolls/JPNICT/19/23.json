[{"verse":1,"text":"［賛歌。ダビデの詩。］主は羊飼い、わたしには何も欠けることがない。","tok":[["［"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["は"],["羊飼い","ひつじかい"],["、"],["わたし"],["に"],["は"],["何","なん"],["も"],["欠ける","かける"],["こと"],["が"],["ない"],["。"]]},{"verse":2,"text":"主はわたしを青草の原に休ませ憩いの水のほとりに伴い","tok":[["主","ぬし"],["は"],["わたし"],["を"],["青草","あおくさ"],["の"],["原","はら"],["に"],["休ませ","やすませ"],["憩い","いこい"],["の"],["水","みず"],["の"],["ほとり"],["に"],["伴い","ともない"]]},{"verse":3,"text":"魂を生き返らせてくださる。主は御名にふさわしくわたしを正しい道に導かれる。","tok":[["魂","たましい"],["を"],["生き返らせて","いきかえらせて"],["くださる"],["。"],["主","ぬし"],["は"],["御名","ぎょめい"],["に"],["ふさわしく"],["わたし"],["を"],["正しい","ただしい"],["道","みち"],["に"],["導かれる","みちびかれる"],["。"]]},{"verse":4,"text":"死の陰の谷を行くときもわたしは災いを恐れない。あなたがわたしと共にいてくださる。あなたの鞭、あなたの杖それがわたしを力づける。","tok":[["死","し"],["の"],["陰","かげ"],["の"],["谷","たに"],["を"],["行く","いく"],["とき"],["も"],["わたし"],["は"],["災い","わざわい"],["を"],["恐れない","おそれない"],["。"],["あなた"],["が"],["わたし"],["と"],["共","とも"],["に"],["いて"],["くださる"],["。"],["あなた"],["の"],["鞭","むち"],["、"],["あなた"],["の"],["杖","つえ"],["それ"],["が"],["わたし"],["を"],["力づける","ちからづける"],["。"]]},{"verse":5,"text":"わたしを苦しめる者を前にしてもあなたはわたしに食卓を整えてくださる。わたしの頭に香油を注ぎわたしの杯を溢れさせてくださる。","tok":[["わたし"],["を"],["苦しめる","くるしめる"],["者","もの"],["を"],["前","まえ"],["に"],["して"],["も"],["あなた"],["は"],["わたし"],["に"],["食卓","しょくたく"],["を"],["整えて","ととのえて"],["くださる"],["。"],["わたし"],["の"],["頭","あたま"],["に"],["香油","こうゆ"],["を"],["注ぎ","そそぎ"],["わたし"],["の"],["杯","さかずき"],["を"],["溢れさせて","あふれさせて"],["くださる"],["。"]]},{"verse":6,"text":"命のある限り恵みと慈しみはいつもわたしを追う。主の家にわたしは帰り生涯、そこにとどまるであろう。","tok":[["命","いのち"],["の"],["ある"],["限り","かぎり"],["恵み","めぐみ"],["と"],["慈しみ","いつくしみ"],["は"],["いつも"],["わたし"],["を"],["追う","おう"],["。"],["主","ぬし"],["の"],["家","いえ"],["に"],["わたし"],["は"],["帰り","かえり"],["生涯","しょうがい"],["、"],["そこ"],["に"],["とどまるで"],["あろう"],["。"]]}]
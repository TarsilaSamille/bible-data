[{"verse":1,"text":"［歌。賛歌。ダビデの詩。］","tok":[["［"],["歌","うた"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"神よ、わたしの心は確かです。わたしは賛美の歌をうたいます。「わたしの誉れよ","tok":[["神","かみ"],["よ"],["、"],["わたし"],["の"],["心","こころ"],["は"],["確か","たしか"],["です"],["。"],["わたし"],["は"],["賛美","さんび"],["の"],["歌","うた"],["を"],["うたいます"],["。"],["「"],["わたし"],["の"],["誉れ","ほまれ"],["よ"]]},{"verse":3,"text":"目覚めよ、竪琴よ、琴よ。わたしは曙を呼び覚まそう。」","tok":[["目覚めよ","めざめよ"],["、"],["竪琴","たてごと"],["よ"],["、"],["琴","こと"],["よ"],["。"],["わたし"],["は"],["曙","あけぼの"],["を"],["呼び覚まそう","よびさまそう"],["。"],["」"]]},{"verse":4,"text":"主よ、諸国の民の中でわたしはあなたに感謝し国々の中でほめ歌をうたいます。","tok":[["主","ぬし"],["よ"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["わたし"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["国々","くにぐに"],["の"],["中","なか"],["で"],["ほめ歌","ほめうた"],["を"],["うたいます"],["。"]]},{"verse":5,"text":"あなたの慈しみは大きく、天に満ちあなたのまことは大きく、雲を覆います。","tok":[["あなた"],["の"],["慈しみ","いつくしみ"],["は"],["大きく","おおきく"],["、"],["天","てん"],["に"],["満ち","みち"],["あなた"],["の"],["まこと"],["は"],["大きく","おおきく"],["、"],["雲","くも"],["を"],["覆います","おおいます"],["。"]]},{"verse":6,"text":"神よ、天の上に高くいまし栄光を全地に輝かせてください。","tok":[["神","かみ"],["よ"],["、"],["天","てん"],["の"],["上","うえ"],["に"],["高く","たかく"],["いまし"],["栄光","えいこう"],["を"],["全地","ぜんち"],["に"],["輝かせて","かがやかせて"],["ください"],["。"]]},{"verse":7,"text":"あなたの愛する人々が助け出されるように右の御手でお救いください。それを我らへの答えとしてください。","tok":[["あなた"],["の"],["愛する","あいする"],["人々","ひとびと"],["が"],["助け出される","たすけだされる"],["よう"],["に"],["右","みぎ"],["の"],["御手","おて"],["で"],["お救い","おすくい"],["ください"],["。"],["それ"],["を"],["我","われ"],["ら"],["へ"],["の"],["答え","こたえ"],["として"],["ください"],["。"]]},{"verse":8,"text":"神は聖所から宣言された。「わたしは喜び勇んでシケムを分配しよう。スコトの野を測量しよう。","tok":[["神","かみ"],["は"],["聖","せい"],["所","しょ"],["から"],["宣言","せんげん"],["された"],["。"],["「"],["わたし"],["は"],["喜び勇んで","よろこびいさんで"],["シケム"],["を"],["分配","ぶんぱい"],["しよう"],["。"],["スコト"],["の"],["野","の"],["を"],["測量","そくりょう"],["しよう"],["。"]]},{"verse":9,"text":"ギレアドはわたしのものマナセもわたしのものエフライムはわたしの頭の兜ユダはわたしの采配","tok":[["ギレアド"],["は"],["わたし"],["の"],["もの"],["マナセ"],["も"],["わたし"],["の"],["もの"],["エフライム"],["は"],["わたし"],["の"],["頭","あたま"],["の"],["兜","かぶと"],["ユダ"],["は"],["わたし"],["の"],["采配","さいはい"]]},{"verse":10,"text":"モアブはわたしのたらい。エドムにわたしの履物を投げペリシテにわたしの叫びを響かせよう。」","tok":[["モアブ"],["は"],["わたし"],["の"],["たらい"],["。"],["エドム"],["に"],["わたし"],["の"],["履物","はきもの"],["を"],["投げ","なげ"],["ペリシテ"],["に"],["わたし"],["の"],["叫び","さけび"],["を"],["響かせよう","ひびかせよう"],["。"],["」"]]},{"verse":11,"text":"包囲された町に誰がわたしを導いてくれるのか。エドムに、誰がわたしを先導してくれるのか。","tok":[["包囲","ほうい"],["された"],["町","まち"],["に"],["誰","だれ"],["が"],["わたし"],["を"],["導いて","みちびいて"],["くれる"],["の"],["か"],["。"],["エドム"],["に"],["、"],["誰","だれ"],["が"],["わたし"],["を"],["先導","せんどう"],["して"],["くれる"],["の"],["か"],["。"]]},{"verse":12,"text":"神よ、あなたは我らを突き放されたのか。神よ、あなたは我らと共に出陣してくださらないのか。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["は"],["我","われ"],["ら"],["を"],["突き放された","つきはなされた"],["の"],["か"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["我","われ"],["ら"],["と"],["共","とも"],["に"],["出陣","しゅつじん"],["して"],["くださらない"],["の"],["か"],["。"]]},{"verse":13,"text":"どうか我らを助け、敵からお救いください。人間の与える救いはむなしいものです。","tok":[["どう"],["か"],["我","われ"],["ら"],["を"],["助け","たすけ"],["、"],["敵","てき"],["から"],["お救い","おすくい"],["ください"],["。"],["人間","にんげん"],["の"],["与える","あたえる"],["救い","すくい"],["は"],["むなしい"],["もの"],["です"],["。"]]},{"verse":14,"text":"神と共に我らは力を振るいます。神が敵を踏みにじってくださいます。","tok":[["神","かみ"],["と"],["共","とも"],["に"],["我","われ"],["ら"],["は"],["力","ちから"],["を"],["振るいます","ふるいます"],["。"],["神","かみ"],["が"],["敵","てき"],["を"],["踏みにじって","ふみにじって"],["くださいます"],["。"]]}]
[{"verse":1,"text":"［都に上る歌。ダビデの詩。］主よ、わたしの心は驕っていません。わたしの目は高くを見ていません。大き過ぎることをわたしの及ばぬ驚くべきことを、追い求めません。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["わたし"],["の"],["心","こころ"],["は"],["驕って","おごって"],["いません"],["。"],["わたし"],["の"],["目","め"],["は"],["高く","たかく"],["を"],["見て","みて"],["いません"],["。"],["大き","おおき"],["過ぎる","すぎる"],["こと"],["を"],["わたし"],["の"],["及ばぬ","およばぬ"],["驚くべき","おどろくべき"],["こと"],["を"],["、"],["追い求めません","おいもとめません"],["。"]]},{"verse":2,"text":"わたしは魂を沈黙させます。わたしの魂を、幼子のように母の胸にいる幼子のようにします。","tok":[["わたし"],["は"],["魂","たましい"],["を"],["沈黙","ちんもく"],["させます"],["。"],["わたし"],["の"],["魂","たましい"],["を"],["、"],["幼子","おさなご"],["の"],["よう"],["に"],["母","はは"],["の"],["胸","むね"],["に"],["いる"],["幼子","おさなご"],["の"],["よう"],["に"],["します"],["。"]]},{"verse":3,"text":"イスラエルよ、主を待ち望め。今も、そしてとこしえに。","tok":[["イスラエル"],["よ"],["、"],["主","ぬし"],["を"],["待ち望め","まちのぞめ"],["。"],["今","いま"],["も"],["、"],["そして"],["とこしえ"],["に"],["。"]]}]
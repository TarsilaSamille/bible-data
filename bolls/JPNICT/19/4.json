[{"verse":1,"text":"［指揮者によって。伴奏付き。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["伴奏付き","ばんそうつき"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"呼び求めるわたしに答えてくださいわたしの正しさを認めてくださる神よ。苦難から解き放ってください憐れんで、祈りを聞いてください。","tok":[["呼び求める","よびもとめる"],["わたし"],["に"],["答えて","こたえて"],["ください"],["わたし"],["の"],["正し","ただし"],["さ"],["を"],["認めて","みとめて"],["くださる"],["神","かみ"],["よ"],["。"],["苦難","くなん"],["から"],["解き放って","ときはなって"],["ください"],["憐れんで","あわれんで"],["、"],["祈り","いのり"],["を"],["聞いて","きいて"],["ください"],["。"]]},{"verse":3,"text":"人の子らよいつまでわたしの名誉を辱めにさらすのかむなしさを愛し、偽りを求めるのか。〔セラ","tok":[["人","ひと"],["の"],["子","こ"],["ら"],["よ"],["いつ"],["まで"],["わたし"],["の"],["名誉","めいよ"],["を"],["辱め","はずかしめ"],["に"],["さらす"],["の"],["か"],["むなし"],["さ"],["を"],["愛し","あいし"],["、"],["偽り","いつわり"],["を"],["求める","もとめる"],["の"],["か"],["。"],["〔"],["セラ"]]},{"verse":4,"text":"主の慈しみに生きる人を主は見分けて呼び求める声を聞いてくださると知れ。","tok":[["主","ぬし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["を"],["主","ぬし"],["は"],["見分けて","みわけて"],["呼び求める","よびもとめる"],["声","こえ"],["を"],["聞いて","きいて"],["くださる"],["と"],["知れ","しれ"],["。"]]},{"verse":5,"text":"おののいて罪を離れよ。横たわるときも自らの心と語りそして沈黙に入れ。〔セラ","tok":[["おののいて"],["罪","つみ"],["を"],["離れよ","はなれよ"],["。"],["横たわる","よこたわる"],["とき"],["も"],["自ら","みずから"],["の"],["心","こころ"],["と"],["語り","かたり"],["そして"],["沈黙","ちんもく"],["に"],["入れ","いれ"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"ふさわしい献げ物をささげて、主に依り頼め。","tok":[["ふさわしい"],["献げ物","ささげもの"],["を"],["ささげて"],["、"],["主に","おもに"],["依り頼め","よりたのめ"],["。"]]},{"verse":7,"text":"恵みを示す者があろうかと、多くの人は問います。主よ、わたしたちに御顔の光を向けてください。","tok":[["恵み","めぐみ"],["を"],["示す","しめす"],["者","もの"],["が"],["あろう"],["か"],["と"],["、"],["多く","おおく"],["の"],["人","ひと"],["は"],["問います","といます"],["。"],["主","ぬし"],["よ"],["、"],["わたしたち"],["に"],["御顔","おかお"],["の"],["光","ひかり"],["を"],["向けて","むけて"],["ください"],["。"]]},{"verse":8,"text":"人々は麦とぶどうを豊かに取り入れて喜びます。それにもまさる喜びをわたしの心にお与えください。","tok":[["人々","ひとびと"],["は"],["麦","むぎ"],["と"],["ぶどう"],["を"],["豊か","ゆたか"],["に"],["取り入れて","とりいれて"],["喜びます","よろこびます"],["。"],["それ"],["に"],["も"],["まさる"],["喜び","よろこび"],["を"],["わたし"],["の"],["心","こころ"],["に"],["お与え","おあたえ"],["ください"],["。"]]},{"verse":9,"text":"平和のうちに身を横たえ、わたしは眠ります。主よ、あなただけが、確かにわたしをここに住まわせてくださるのです。","tok":[["平和","へいわ"],["の"],["うち"],["に"],["身","み"],["を"],["横たえ","よこたえ"],["、"],["わたし"],["は"],["眠ります","ねむります"],["。"],["主","ぬし"],["よ"],["、"],["あなた"],["だけ"],["が"],["、"],["確か","たしか"],["に"],["わたし"],["を"],["ここ"],["に"],["住まわせて","すまわせて"],["くださる"],["の"],["です"],["。"]]}]
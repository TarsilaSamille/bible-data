[{"verse":1,"text":"［ダビデの詩。］主よ、あなたを呼び求めます。わたしの岩よわたしに対して沈黙しないでください。あなたが黙しておられるならわたしは墓に下る者とされてしまいます。","tok":[["［"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["あなた"],["を"],["呼び求めます","よびもとめます"],["。"],["わたし"],["の"],["岩","いわ"],["よ"],["わたし"],["に対して","にたいして"],["沈黙","ちんもく"],["しないで"],["ください"],["。"],["あなた"],["が"],["黙して","もくして"],["おられるなら"],["わたし"],["は"],["墓","はか"],["に"],["下る","くだる"],["者","もの"],["と"],["されて"],["しまいます"],["。"]]},{"verse":2,"text":"嘆き祈るわたしの声を聞いてください。至聖所に向かって手を上げあなたに救いを求めて叫びます。","tok":[["嘆き","なげき"],["祈る","いのる"],["わたし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["ください"],["。"],["至聖所","しせいしょ"],["に"],["向かって","むかって"],["手","て"],["を"],["上げ","あげ"],["あなた"],["に"],["救い","すくい"],["を"],["求めて","もとめて"],["叫びます","さけびます"],["。"]]},{"verse":3,"text":"神に逆らう者、悪を行う者と共にわたしを引いて行かないでください。彼らは仲間に向かって平和を口にしますが心には悪意を抱いています。","tok":[["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["と"],["共","とも"],["に"],["わたし"],["を"],["引いて","ひいて"],["行かないで","いかないで"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["仲間","なかま"],["に"],["向かって","むかって"],["平和","へいわ"],["を"],["口","くち"],["に"],["します"],["が"],["心","こころ"],["に"],["は"],["悪意","あくい"],["を"],["抱いて","いだいて"],["います"],["。"]]},{"verse":4,"text":"その仕業、悪事に応じて彼らに報いてください。その手のなすところに応じて彼らに報い、罰してください。","tok":[["その"],["仕業","しわざ"],["、"],["悪事","あくじ"],["に"],["応じて","おうじて"],["彼","かれ"],["ら"],["に"],["報いて","むくいて"],["ください"],["。"],["その"],["手","て"],["の"],["なす"],["ところ"],["に"],["応じて","おうじて"],["彼","かれ"],["ら"],["に"],["報い","むくい"],["、"],["罰して","ばっして"],["ください"],["。"]]},{"verse":5,"text":"主の御業、御手の業を彼らは悟ろうとしません。彼らを滅ぼし、再び興さないでください。","tok":[["主","ぬし"],["の"],["御業","ごぎょう"],["、"],["御手","おて"],["の"],["業","ごう"],["を"],["彼","かれ"],["ら"],["は"],["悟ろう","さとろう"],["と"],["しません"],["。"],["彼","かれ"],["ら"],["を"],["滅ぼし","ほろぼし"],["、"],["再び","ふたたび"],["興さないで","おこさないで"],["ください"],["。"]]},{"verse":6,"text":"主をたたえよ。嘆き祈るわたしの声を聞いてくださいました。","tok":[["主","ぬし"],["を"],["たたえ"],["よ"],["。"],["嘆き","なげき"],["祈る","いのる"],["わたし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["くださいました"],["。"]]},{"verse":7,"text":"主はわたしの力、わたしの盾わたしの心は主に依り頼みます。主の助けを得てわたしの心は喜び躍ります。歌をささげて感謝いたします。","tok":[["主","ぬし"],["は"],["わたし"],["の"],["力","ちから"],["、"],["わたし"],["の"],["盾","たて"],["わたし"],["の"],["心","こころ"],["は"],["主に","おもに"],["依り頼みます","よりたのみます"],["。"],["主","ぬし"],["の"],["助け","たすけ"],["を"],["得て","えて"],["わたし"],["の"],["心","こころ"],["は"],["喜び","よろこび"],["躍ります","おどります"],["。"],["歌","うた"],["を"],["ささげて"],["感謝","かんしゃ"],["いたします"],["。"]]},{"verse":8,"text":"主は油注がれた者の力、その砦、救い。","tok":[["主","ぬし"],["は"],["油","あぶら"],["注がれた","そそがれた"],["者","もの"],["の"],["力","ちから"],["、"],["その"],["砦","とりで"],["、"],["救い","すくい"],["。"]]},{"verse":9,"text":"お救いください、あなたの民を。祝福してください、あなたの嗣業の民を。とこしえに彼らを導き養ってください。","tok":[["お救い","おすくい"],["ください"],["、"],["あなた"],["の"],["民","たみ"],["を"],["。"],["祝福","しゅくふく"],["して"],["ください"],["、"],["あなた"],["の"],["嗣業","しぎょう"],["の"],["民","たみ"],["を"],["。"],["とこしえ"],["に"],["彼","かれ"],["ら"],["を"],["導き","みちびき"],["養って","やしなって"],["ください"],["。"]]}]
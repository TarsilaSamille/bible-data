[{"verse":1,"text":"［指揮者によって。賛歌。ダビデの詩。歌。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["歌","うた"],["。"],["］"]]},{"verse":2,"text":"沈黙してあなたに向かい、賛美をささげます。シオンにいます神よ。あなたに満願の献げ物をささげます。","tok":[["沈黙","ちんもく"],["して"],["あなた"],["に"],["向かい","むかい"],["、"],["賛美","さんび"],["を"],["ささげます"],["。"],["シオン"],["に"],["います"],["神","かみ"],["よ"],["。"],["あなた"],["に"],["満願","まんがん"],["の"],["献げ物","ささげもの"],["を"],["ささげます"],["。"]]},{"verse":3,"text":"祈りを聞いてくださる神よすべて肉なるものはあなたのもとに来ます。","tok":[["祈り","いのり"],["を"],["聞いて","きいて"],["くださる"],["神","かみ"],["よ"],["すべて"],["肉","にく"],["なる"],["もの"],["は"],["あなた"],["の"],["もと"],["に"],["来ます","きます"],["。"]]},{"verse":4,"text":"罪の数々がわたしを圧倒します。背いたわたしたちをあなたは贖ってくださいます。","tok":[["罪","つみ"],["の"],["数々","かずかず"],["が"],["わたし"],["を"],["圧倒","あっとう"],["します"],["。"],["背いた","そむいた"],["わたしたち"],["を"],["あなた"],["は"],["贖って","あがなって"],["くださいます"],["。"]]},{"verse":5,"text":"いかに幸いなことでしょうあなたに選ばれ、近づけられあなたの庭に宿る人は。恵みの溢れるあなたの家、聖なる神殿によってわたしたちが満ち足りますように。","tok":[["いかに"],["幸い","さいわい"],["な"],["こと"],["でしょう"],["あなた"],["に"],["選ばれ","えらばれ"],["、"],["近づけられ","ちかづけられ"],["あなた"],["の"],["庭","にわ"],["に"],["宿る","やどる"],["人","ひと"],["は"],["。"],["恵み","めぐみ"],["の"],["溢れる","あふれる"],["あなた"],["の"],["家","いえ"],["、"],["聖","せい"],["なる"],["神殿","しんでん"],["によって"],["わたしたち"],["が"],["満ち足ります","みちたります"],["よう"],["に"],["。"]]},{"verse":6,"text":"わたしたちの救いの神よあなたの恐るべき御業がわたしたちへのふさわしい答えでありますように。遠い海、地の果てに至るまですべてのものがあなたに依り頼みます。","tok":[["わたしたち"],["の"],["救い","すくい"],["の"],["神","かみ"],["よ"],["あなた"],["の"],["恐るべき","おそるべき"],["御業","ごごう"],["が"],["わたしたち"],["へ"],["の"],["ふさわしい"],["答え","こたえ"],["で"],["あります"],["よう"],["に"],["。"],["遠い","とおい"],["海","うみ"],["、"],["地","ち"],["の"],["果て","はて"],["に"],["至る","いたる"],["まで"],["すべて"],["の"],["もの"],["が"],["あなた"],["に"],["依り頼みます","よりたのみます"],["。"]]},{"verse":7,"text":"御力をもって山々を固く据え雄々しさを身に帯びておられる方。","tok":[["御力","おちから"],["を"],["もって"],["山々","やまやま"],["を"],["固く","かたく"],["据え","すえ"],["雄々し","おおし"],["さ"],["を"],["身","み"],["に"],["帯びて","おびて"],["おられる"],["方","かた"],["。"]]},{"verse":8,"text":"大海のどよめき、波のどよめき諸国の民の騒ぎを
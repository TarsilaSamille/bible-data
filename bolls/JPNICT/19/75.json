[{"verse":1,"text":"［指揮者によって。「滅ぼさないでください」に合わせて。賛歌。アサフの詩。歌。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["「"],["滅ぼさないで","ほろぼさないで"],["ください"],["」"],["に"],["合わせて","あわせて"],["。"],["賛歌","さんか"],["。"],["アサフ"],["の"],["詩","し"],["。"],["歌","うた"],["。"],["］"]]},{"verse":2,"text":"あなたに感謝をささげます。神よ、あなたに感謝をささげます。御名はわたしたちの近くにいまし人々は驚くべき御業を物語ります。","tok":[["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげます"],["。"],["神","かみ"],["よ"],["、"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげます"],["。"],["御名","ぎょめい"],["は"],["わたしたち"],["の"],["近く","ちかく"],["に"],["いまし"],["人々","ひとびと"],["は"],["驚くべき","おどろくべき"],["御業","ごごう"],["を"],["物語ります","ものがたります"],["。"]]},{"verse":3,"text":"「わたしは必ず時を選び、公平な裁きを行う。","tok":[["「"],["わたし"],["は"],["必ず","かならず"],["時","とき"],["を"],["選び","えらび"],["、"],["公平","こうへい"],["な"],["裁き","さばき"],["を"],["行う","おこなう"],["。"]]},{"verse":4,"text":"地はそこに住むすべてのものと共に溶け去ろうとしている。しかし、わたしは自ら地の柱を固める。〔セラ","tok":[["地","ち"],["は"],["そこ"],["に"],["住む","すむ"],["すべて"],["の"],["もの"],["と"],["共","とも"],["に"],["溶け去ろう","とけさろう"],["として"],["いる"],["。"],["しかし"],["、"],["わたし"],["は"],["自ら","みずから"],["地","ち"],["の"],["柱","はしら"],["を"],["固める","かためる"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"わたしは驕る者たちに、驕るなと言おう。逆らう者に言おう、角をそびやかすなと。","tok":[["わたし"],["は"],["驕る","おごる"],["者","もの"],["たち"],["に"],["、"],["驕る","おごる"],["な"],["と"],["言おう","いおう"],["。"],["逆らう","さからう"],["者","もの"],["に"],["言おう","いおう"],["、"],["角","かど"],["を"],["そびやかす"],["な"],["と"],["。"]]},{"verse":6,"text":"お前たちの角を高くそびやかすな。胸を張って断言するな。」","tok":[["お前","おまえ"],["たち"],["の"],["角","かど"],["を"],["高く","たかく"],["そびやかす"],["な"],["。"],["胸","むね"],["を"],["張って","はって"],["断言","だんげん"],["する"],["な"],["。"],["」"]]},{"verse":7,"text":"そうです、人を高く上げるものは東からも西からも、荒れ野からも来ません。","tok":[["そう"],["です"],["、"],["人","ひと"],["を"],["高く","たかく"],["上げる","あげる"],["もの"],["は"],["東","ひがし"],["から"],["も"],["西","にし"],["から"],["も"],["、"],["荒れ野","あれの"],["から"],["も"],["来ません","きません"],["。"]]},{"verse":8,"text":"神が必ず裁きを行いある者を低く、ある者を高くなさるでしょう。","tok":[["神","かみ"],["が"],["必ず","かならず"],["裁き","さばき"],["を"],["行い","おこない"],["ある"],["者","もの"],["を"],["低く","ひくく"],["、"],["ある"],["者","もの"],["を"],["高く","たかく"],["なさるでしょう"],["。"]]},{"verse":9,"text":"すでに杯は主の御手にあり調合された酒が泡立っています。主はこれを注がれます。この地の逆らう者は皆、それを飲みおりまで飲み干すでしょう。","tok":[["すでに"],["杯","さかずき"],["は"],["主","ぬし"],["の"],["御手","おて"],["に"],["あり"],["調合","ちょうごう"],["された"],["酒","さけ"],["が"],["泡立って","あわだって"],["います"],["。"],["主","ぬし"],["は"],["これ"],["を"],["注がれます","そそがれます"],["。"],["この"],["地","ち"],["の"],["逆らう","さからう"],["者","もの"],["は"],["皆","みな"],["、"],["それ"],["を"],["飲み","のみ"],["おり"],["まで"],["飲み干すでしょう","のみほすでしょう"],["。"]]},{"verse":10,"text":"わたしはとこしえにこのことを語り継ぎヤコブの神にほめ歌をささげます。","tok":[["わたし"],["は"],["とこしえ"],["に"],["この"],["こと"],["を"],["語り継ぎ","かたりつぎ"],["ヤコブ"],["の"],["神","かみ"],["に"],["ほめ歌","ほめうた"],["を"],["ささげます"],["。"]]},{"verse":11,"text":"「わたしは逆らう者の角をことごとく折り従う者の角を高く上げる。」","tok":[["「"],["わたし"],["は"],["逆らう","さからう"],["者","もの"],["の"],["角","かど"],["を"],["ことごとく"],["折り","おり"],["従う","したがう"],["者","もの"],["の"],["角","かど"],["を"],["高く","たかく"],["上げる","あげる"],["。"],["」"]]}]
[{"verse":1,"text":"［都に上る歌。］苦難の中から主を呼ぶと主はわたしに答えてくださった。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["苦難","くなん"],["の"],["中","なか"],["から"],["主","ぬし"],["を"],["呼ぶ","よぶ"],["と"],["主","ぬし"],["は"],["わたし"],["に"],["答えて","こたえて"],["くださった"],["。"]]},{"verse":2,"text":"「主よ、わたしの魂を助け出してください偽って語る唇から、欺いて語る舌から。」","tok":[["「"],["主","ぬし"],["よ"],["、"],["わたし"],["の"],["魂","たましい"],["を"],["助け出して","たすけだして"],["ください"],["偽って","いつわって"],["語る","かたる"],["唇","くちびる"],["から"],["、"],["欺いて","あざむいて"],["語る","かたる"],["舌","した"],["から"],["。"],["」"]]},{"verse":3,"text":"主はお前に何を与えお前に何を加えられるであろうか欺いて語る舌よ","tok":[["主","ぬし"],["は"],["お前","おまえ"],["に"],["何","なん"],["を"],["与え","あたえ"],["お前","おまえ"],["に"],["何","なん"],["を"],["加えられるで","くわえられるで"],["あろう"],["か"],["欺いて","あざむいて"],["語る","かたる"],["舌","した"],["よ"]]},{"verse":4,"text":"勇士の放つ鋭い矢よえにしだの炭火を付けた矢よ。","tok":[["勇士","ゆうし"],["の"],["放つ","はなつ"],["鋭い","するどい"],["矢","や"],["よ"],["えにし"],["だ"],["の"],["炭火","すみび"],["を"],["付けた","つけた"],["矢","や"],["よ"],["。"]]},{"verse":5,"text":"わたしは不幸なことだメシェクに宿り、ケダルの天幕の傍らに住むとは","tok":[["わたし"],["は"],["不幸","ふこう"],["な"],["こと"],["だ"],["メシェク"],["に"],["宿り","やどり"],["、"],["ケダル"],["の"],["天幕","てんまく"],["の"],["傍ら","かたわら"],["に"],["住む","すむ"],["と"],["は"]]},{"verse":6,"text":"平和を憎む者と共にわたしの魂が久しくそこに住むとは。","tok":[["平和","へいわ"],["を"],["憎む","にくむ"],["者","もの"],["と"],["共","とも"],["に"],["わたし"],["の"],["魂","たましい"],["が"],["久しく","ひさしく"],["そこ"],["に"],["住む","すむ"],["と"],["は"],["。"]]},{"verse":7,"text":"平和をこそ、わたしは語るのに彼らはただ、戦いを語る。","tok":[["平和","へいわ"],["を"],["こそ"],["、"],["わたし"],["は"],["語る","かたる"],["のに"],["彼","かれ"],["ら"],["は"],["ただ"],["、"],["戦い","たたかい"],["を"],["語る","かたる"],["。"]]}]
[{"verse":1,"text":"［指揮者によって。コラの子の詩。賛歌。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["コラ"],["の"],["子","こ"],["の"],["詩","し"],["。"],["賛歌","さんか"],["。"],["］"]]},{"verse":2,"text":"すべての民よ、手を打ち鳴らせ。神に向かって喜び歌い、叫びをあげよ。","tok":[["すべて"],["の"],["民","たみ"],["よ"],["、"],["手","て"],["を"],["打ち鳴らせ","うちならせ"],["。"],["神","かみ"],["に"],["向かって","むかって"],["喜び歌い","よろこびうたい"],["、"],["叫び","さけび"],["を"],["あげ"],["よ"],["。"]]},{"verse":3,"text":"主はいと高き神、畏るべき方全地に君臨される偉大な王。","tok":[["主","ぬし"],["は"],["いと"],["高き","たかき"],["神","かみ"],["、"],["畏るべき","かしこまるべき"],["方","ほう"],["全地","ぜんち"],["に"],["君臨","くんりん"],["される"],["偉大","いだい"],["な"],["王","おう"],["。"]]},{"verse":4,"text":"諸国の民を我らに従わせると宣言し国々を我らの足もとに置かれた。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["を"],["我","われ"],["ら"],["に"],["従わせる","したがわせる"],["と"],["宣言","せんげん"],["し"],["国々","くにぐに"],["を"],["我","われ"],["ら"],["の"],["足もと","あしもと"],["に"],["置かれた","おかれた"],["。"]]},{"verse":5,"text":"我らのために嗣業を選び愛するヤコブの誇りとされた。〔セラ","tok":[["我","われ"],["ら"],["の"],["ため"],["に"],["嗣業","しぎょう"],["を"],["選び","えらび"],["愛する","あいする"],["ヤコブ"],["の"],["誇り","ほこり"],["と"],["された"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"神は歓呼の中を上られる。主は角笛の響きと共に上られる。","tok":[["神","かみ"],["は"],["歓呼","かんこ"],["の"],["中","なか"],["を"],["上られる","のぼられる"],["。"],["主","ぬし"],["は"],["角笛","つのぶえ"],["の"],["響き","ひびき"],["と"],["共","とも"],["に"],["上られる","のぼられる"],["。"]]},{"verse":7,"text":"歌え、神に向かって歌え。歌え、我らの王に向かって歌え。","tok":[["歌え","うたえ"],["、"],["神","かみ"],["に"],["向かって","むかって"],["歌え","うたえ"],["。"],["歌え","うたえ"],["、"],["我","われ"],["ら"],["の"],["王","おう"],["に"],["向かって","むかって"],["歌え","うたえ"],["。"]]},{"verse":8,"text":"神は、全地の王ほめ歌をうたって、告げ知らせよ。","tok":[["神","かみ"],["は"],["、"],["全地","ぜんち"],["の"],["王","おう"],["ほめ歌","ほめうた"],["を"],["うたって"],["、"],["告げ知らせ","つげしらせ"],["よ"],["。"]]},{"verse":9,"text":"神は諸国の上に王として君臨される。神は聖なる王座に着いておられる。","tok":[["神","かみ"],["は"],["諸国","しょこく"],["の"],["上","うえ"],["に"],["王","おう"],["として"],["君臨","くんりん"],["される"],["。"],["神","かみ"],["は"],["聖","せい"],["なる"],["王座","おうざ"],["に"],["着いて","ついて"],["おられる"],["。"]]},{"verse":10,"text":"諸国の民から自由な人々が集められアブラハムの神の民となる。地の盾となる人々は神のもの。神は大いにあがめられる。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["から"],["自由","じゆう"],["な"],["人々","ひとびと"],["が"],["集められ","あつめられ"],["アブラハム"],["の"],["神","かみ"],["の"],["民","たみ"],["と"],["なる"],["。"],["地","ち"],["の"],["盾","たて"],["と"],["なる"],["人々","ひとびと"],["は"],["神","かみ"],["の"],["もの"],["。"],["神","かみ"],["は"],["大いに","おおいに"],["あがめられる"],["。"]]}]
[{"verse":1,"text":"［賛歌。神殿奉献の歌。ダビデの詩。］","tok":[["［"],["賛歌","さんか"],["。"],["神殿","しんでん"],["奉献","ほうけん"],["の"],["歌","うた"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"主よ、あなたをあがめます。あなたは敵を喜ばせることなくわたしを引き上げてくださいました。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["を"],["あがめます"],["。"],["あなた"],["は"],["敵","てき"],["を"],["喜ばせる","よろこばせる"],["こと"],["なく"],["わたし"],["を"],["引き上げて","ひきあげて"],["くださいました"],["。"]]},{"verse":3,"text":"わたしの神、主よ、叫び求めるわたしをあなたは癒してくださいました。","tok":[["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["、"],["叫び","さけび"],["求める","もとめる"],["わたし"],["を"],["あなた"],["は"],["癒して","いやして"],["くださいました"],["。"]]},{"verse":4,"text":"主よ、あなたはわたしの魂を陰府から引き上げ墓穴に下ることを免れさせわたしに命を得させてくださいました。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["魂","たましい"],["を"],["陰府","よみ"],["から"],["引き上げ","ひきあげ"],["墓穴","ぼけつ"],["に"],["下る","くだる"],["こと"],["を"],["免れさせ","まぬがれさせ"],["わたし"],["に"],["命","いのち"],["を"],["得させて","えさせて"],["くださいました"],["。"]]},{"verse":5,"text":"主の慈しみに生きる人々よ主に賛美の歌をうたい聖なる御名を唱え、感謝をささげよ。","tok":[["主","ぬし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人々","ひとびと"],["よ"],["主に","おもに"],["賛美","さんび"],["の"],["歌","うた"],["を"],["うたい"],["聖","せい"],["なる"],["御名","ぎょめい"],["を"],["唱え","となえ"],["、"],["感謝","かんしゃ"],["を"],["ささげ"],["よ"],["。"]]},{"verse":6,"text":"ひととき、お怒りになっても命を得させることを御旨としてくださる。泣きながら夜を過ごす人にも喜びの歌と共に朝を迎えさせてくださる。","tok":[["ひととき"],["、"],["お怒り","おいかり"],["に"],["なって"],["も"],["命","いのち"],["を"],["得させる","えさせる"],["こと"],["を"],["御旨","おむね"],["として"],["くださる"],["。"],["泣き","なき"],["ながら"],["夜","よる"],["を"],["過ごす","すごす"],["人","ひと"],["に"],["も"],["喜び","よろこび"],["の"],["歌","うた"],["と"],["共","とも"],["に"],["朝","あさ"],["を"],["迎えさせて","むかえさせて"],["くださる"],["。"]]},{"verse":7,"text":"平穏なときには、申しました「わたしはとこしえに揺らぐことがない」と。","tok":[["平穏","へいおん"],["な"],["とき"],["に"],["は"],["、"],["申しました","もうしました"],["「"],["わたし"],["は"],["とこしえ"],["に"],["揺らぐ","ゆらぐ"],["こと"],["が"],["ない"],["」"],["と"],["。"]]},{"verse":8,"text":"主よ、あなたが御旨によって砦の山に立たせてくださったからです。しかし、御顔を隠されるとわたしはたちまち恐怖に陥りました。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["が"],["御旨","おむね"],["によって"],["砦","とりで"],["の"],["山","やま"],["に"],["立たせて","たたせて"],["くださった"],["から"],["です"],["。"],["しかし"],["、"],["御顔","おかお"],["を"],["隠される","かくされる"],["と"],["わたし"],["は"],["たちまち"],["恐怖","きょうふ"],["に"],["陥りました","おちいりました"],["。"]]},{"verse":9,"text":"主よ、わたしはあなたを呼びます。主に憐れみを乞います。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["呼びます","よびます"],["。"],["主に","おもに"],["憐れみ","あわれみ"],["を"],["乞います","こいます"],["。"]]},{"verse":10,"text":"わたしが死んで墓に下ることに何の益があるでしょう。塵があなたに感謝をささげあなたのまことを告げ知らせるでしょうか。","tok":[["わたし"],["が"],["死んで","しんで"],["墓","はか"],["に"],["下る","くだる"],["こと"],["に"],["何","なん"],["の"],["益","えき"],["が"],["あるでしょう"],["。"],["塵","ごみ"],["が"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげ"],["あなた"],["の"],["まこと"],["を"],["告げ知らせるでしょう","つげしらせるでしょう"],["か"],["。"]]},{"verse":11,"text":"主よ、耳を傾け、憐れんでください。主よ、わたしの助けとなってください。","tok":[["主","ぬし"],["よ"],["、"],["耳","みみ"],["を"],["傾け","かたむけ"],["、"],["憐れんで","あわれんで"],["ください"],["。"],["主","ぬし"],["よ"],["、"],["わたし"],["の"],["助け","たすけ"],["と"],["なって"],["ください"],["。"]]},{"verse":12,"text":"あなたはわたしの嘆きを踊りに変え粗布を脱がせ、喜びを帯としてくださいました。","tok":[["あなた"],["は"],["わたし"],["の"],["嘆き","なげき"],["を"],["踊り","おどり"],["に"],["変え","かえ"],["粗布","あらぬの"],["を"],["脱がせ","ぬがせ"],["、"],["喜び","よろこび"],["を"],["帯","おび"],["として"],["くださいました"],["。"]]},{"verse":13,"text":"わたしの魂があなたをほめ歌い沈黙することのないようにしてくださいました。わたしの神、主よとこしえにあなたに感謝をささげます。","tok":[["わたし"],["の"],["魂","たましい"],["が"],["あなた"],["を"],["ほめ"],["歌い","うたい"],["沈黙","ちんもく"],["する"],["こと"],["の"],["ない"],["よう"],["に"],["して"],["くださいました"],["。"],["わたし"],["の"],["神","かみ"],["、"],["主","ぬし"],["よ"],["とこしえ"],["に"],["あなた"],["に"],["感謝","かんしゃ"],["を"],["ささげます"],["。"]]}]
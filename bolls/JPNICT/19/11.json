[{"verse":1,"text":"［指揮者によって。ダビデの詩。］主を、わたしは避けどころとしている。どうしてあなたたちはわたしの魂に言うのか「鳥のように山へ逃れよ。","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["を"],["、"],["わたし"],["は"],["避け","さけ"],["どころ"],["として"],["いる"],["。"],["どう"],["して"],["あなた"],["たち"],["は"],["わたし"],["の"],["魂","たましい"],["に"],["言う","いう"],["の"],["か"],["「"],["鳥","とり"],["の"],["よう"],["に"],["山","やま"],["へ"],["逃れ","のがれ"],["よ"],["。"]]},{"verse":2,"text":"見よ、主に逆らう者が弓を張り、弦に矢をつがえ闇の中から心のまっすぐな人を射ようとしている。","tok":[["見よ","みよ"],["、"],["主に","おもに"],["逆らう","さからう"],["者","もの"],["が"],["弓","ゆみ"],["を"],["張り","はり"],["、"],["弦","げん"],["に"],["矢","や"],["を"],["つがえ"],["闇","やみ"],["の"],["中","なか"],["から"],["心","こころ"],["の"],["まっすぐ"],["な"],["人","ひと"],["を"],["射よう","いよう"],["として"],["いる"],["。"]]},{"verse":3,"text":"世の秩序が覆っているのに主に従う人に何ができようか」と。","tok":[["世","よ"],["の"],["秩序","ちつじょ"],["が"],["覆って","おおって"],["いる"],["のに"],["主に","おもに"],["従う","したがう"],["人","ひと"],["に"],["何","なん"],["が"],["できよう"],["か"],["」"],["と"],["。"]]},{"verse":4,"text":"主は聖なる宮にいます。主は天に御座を置かれる。御目は人の子らを見渡しそのまぶたは人の子らを調べる。","tok":[["主","ぬし"],["は"],["聖","せい"],["なる"],["宮","みや"],["に"],["います"],["。"],["主","ぬし"],["は"],["天","てん"],["に"],["御座","ぎょざ"],["を"],["置かれる","おかれる"],["。"],["御目","おめ"],["は"],["人","ひと"],["の"],["子","こ"],["ら"],["を"],["見渡し","みわたし"],["その"],["まぶた"],["は"],["人","ひと"],["の"],["子","こ"],["ら"],["を"],["調べる","しらべる"],["。"]]},{"verse":5,"text":"主は、主に従う人と逆らう者を調べ不法を愛する者を憎み","tok":[["主","ぬし"],["は"],["、"],["主に","おもに"],["従う","したがう"],["人","ひと"],["と"],["逆らう","さからう"],["者","もの"],["を"],["調べ","しらべ"],["不法","ふほう"],["を"],["愛する","あいする"],["者","もの"],["を"],["憎み","にくみ"]]},{"verse":6,"text":"逆らう者に災いの火を降らせ、熱風を送り燃える硫黄をその杯に注がれる。","tok":[["逆らう","さからう"],["者","もの"],["に"],["災い","わざわい"],["の"],["火","ひ"],["を"],["降らせ","ふらせ"],["、"],["熱風","ねっぷう"],["を"],["送り","おくり"],["燃える","もえる"],["硫黄","いおう"],["を"],["その"],["杯","さかずき"],["に"],["注がれる","そそがれる"],["。"]]},{"verse":7,"text":"主は正しくいまし、恵みの業を愛し御顔を心のまっすぐな人に向けてくださる。","tok":[["主","ぬし"],["は"],["正しく","ただしく"],["いまし"],["、"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["愛し","あいし"],["御顔","おかお"],["を"],["心","こころ"],["の"],["まっすぐ"],["な"],["人","ひと"],["に"],["向けて","むけて"],["くださる"],["。"]]}]
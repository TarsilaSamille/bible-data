[{"verse":1,"text":"［指揮者によって。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"神よ、悩み訴えるわたしの声をお聞きください。敵の脅威からわたしの命をお守りください。","tok":[["神","かみ"],["よ"],["、"],["悩み","なやみ"],["訴える","うったえる"],["わたし"],["の"],["声","こえ"],["を"],["お聞き","おきき"],["ください"],["。"],["敵","てき"],["の"],["脅威","きょうい"],["から"],["わたし"],["の"],["命","いのち"],["を"],["お守り","おまもり"],["ください"],["。"]]},{"verse":3,"text":"わたしを隠してくださいさいなむ者の集いから、悪を行う者の騒ぎから。","tok":[["わたし"],["を"],["隠して","かくして"],["ください"],["さいなむ"],["者","もの"],["の"],["集い","つどい"],["から"],["、"],["悪","あく"],["を"],["行う","おこなう"],["者","もの"],["の"],["騒ぎ","さわぎ"],["から"],["。"]]},{"verse":4,"text":"彼らは舌を鋭い剣とし毒を含む言葉を矢としてつがえ","tok":[["彼","かれ"],["ら"],["は"],["舌","した"],["を"],["鋭い","するどい"],["剣","けん"],["と"],["し"],["毒","どく"],["を"],["含む","ふくむ"],["言葉","ことば"],["を"],["矢","や"],["として"],["つがえ"]]},{"verse":5,"text":"隠れた所から無垢な人を射ようと構え突然射かけて、恐れもしません。","tok":[["隠れた","かくれた"],["所","ところ"],["から"],["無垢","むく"],["な"],["人","ひと"],["を"],["射よう","いよう"],["と"],["構え","かまえ"],["突然","とつぜん"],["射かけて","いかけて"],["、"],["恐れ","おそれ"],["も"],["しません"],["。"]]},{"verse":6,"text":"彼らは悪事にたけ、共謀して罠を仕掛け「見抜かれることはない」と言います。","tok":[["彼","かれ"],["ら"],["は"],["悪事","あくじ"],["に"],["たけ"],["、"],["共謀","きょうぼう"],["して"],["罠","わな"],["を"],["仕掛け","しかけ"],["「"],["見抜かれる","みぬかれる"],["こと"],["は"],["ない"],["」"],["と"],["言います","いいます"],["。"]]},{"verse":7,"text":"巧妙に悪を謀り「我らの謀は巧妙で完全だ。人は胸に深慮を隠す」と言います。","tok":[["巧妙","こうみょう"],["に"],["悪","あく"],["を"],["謀り","はかり"],["「"],["我","われ"],["ら"],["の"],["謀","はかりごと"],["は"],["巧妙","こうみょう"],["で"],["完全","かんぜん"],["だ"],["。"],["人","ひと"],["は"],["胸","むね"],["に"],["深慮","しんりょ"],["を"],["隠す","かくす"],["」"],["と"],["言います","いいます"],["。"]]},{"verse":8,"text":"神は彼らに矢を射かけ突然、彼らは討たれるでしょう。","tok":[["神","かみ"],["は"],["彼","かれ"],["ら"],["に"],["矢","や"],["を"],["射かけ","いかけ"],["突然","とつぜん"],["、"],["彼","かれ"],["ら"],["は"],["討たれるでしょう","うたれるでしょう"],["。"]]},{"verse":9,"text":"自分の舌がつまずきのもとになり見る人は皆、頭を振って侮るでしょう。","tok":[["自分","じぶん"],["の"],["舌","した"],["が"],["つまずき"],["の"],["もと"],["に"],["なり"],["見る","みる"],
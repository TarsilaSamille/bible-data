[{"verse":1,"text":"［指揮者によって。エドトンの詩。賛歌。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["エドトン"],["の"],["詩","し"],["。"],["賛歌","さんか"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"わたしは言いました。「わたしの道を守ろう、舌で過ちを犯さぬように。神に逆らう者が目の前にいる。わたしの口にくつわをはめておこう。」","tok":[["わたし"],["は"],["言いました","いいました"],["。"],["「"],["わたし"],["の"],["道","みち"],["を"],["守ろう","まもろう"],["、"],["舌","した"],["で"],["過ち","あやまち"],["を"],["犯さぬ","おかさぬ"],["よう"],["に"],["。"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["が"],["目","め"],["の"],["前","まえ"],["に"],["いる"],["。"],["わたし"],["の"],["口","くち"],["に"],["くつわ"],["を"],["はめて"],["おこう"],["。"],["」"]]},{"verse":3,"text":"わたしは口を閉ざして沈黙しあまりに黙していたので苦しみがつのり","tok":[["わたし"],["は"],["口","くち"],["を"],["閉ざして","とざして"],["沈黙","ちんもく"],["し"],["あまり"],["に"],["黙して","もくして"],["いた"],["ので"],["苦しみ","くるしみ"],["が"],["つのり"]]},{"verse":4,"text":"心は内に熱し、呻いて火と燃えた。わたしは舌を動かして話し始めた。","tok":[["心","こころ"],["は"],["内","うち"],["に"],["熱し","ねっし"],["、"],["呻いて","うめいて"],["火","ひ"],["と"],["燃えた","もえた"],["。"],["わたし"],["は"],["舌","した"],["を"],["動かして","うごかして"],["話し","はなし"],["始めた","はじめた"],["。"]]},{"verse":5,"text":"「教えてください、主よ、わたしの行く末をわたしの生涯はどれ程のものかいかにわたしがはかないものか、悟るように。」","tok":[["「"],["教えて","おしえて"],["ください"],["、"],["主","ぬし"],["よ"],["、"],["わたし"],["の"],["行く末","ゆくすえ"],["を"],["わたし"],["の"],["生涯","しょうがい"],["は"],["どれ"],["程","ほど"],["の"],["もの"],["か"],["いかに"],["わたし"],["が"],["はかない"],["もの"],["か"],["、"],["悟る","さとる"],["よう"],["に"],["。"],["」"]]},{"verse":6,"text":"御覧ください、与えられたこの生涯は僅か、手の幅ほどのもの。御前には、この人生も無に等しいのです。ああ、人は確かに立っているようでもすべて空しいもの。〔セラ","tok":[["御覧","ごらん"],["ください"],["、"],["与えられた","あたえられた"],["この"],["生涯","しょうがい"],["は"],["僅か","わずか"],["、"],["手","て"],["の"],["幅","はば"],["ほど"],["の"],["もの"],["。"],["御前","ごぜん"],["に"],["は"],["、"],["この"],["人生","じんせい"],["も"],["無","む"],["に"],["等しい","ひとしい"],["の"],["です"],["。"],["ああ"],["、"],["人","ひと"],["は"],["確か","たしか"],["に"],["立って","たって"],["いる"],["よう"],["で"],["も"],["すべて"],["空しい","むなしい"],["もの"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"ああ、人はただ影のように移ろうもの。ああ、人は空しくあくせくしだれの手に渡るとも知らずに積み上げる。","tok":[["ああ"],["、"],["人","ひと"],["は"],["ただ"],["影","かげ"],["の"],["よう"],["に"],["移ろう","うつろう"],["もの"],["。"],["ああ"],["、"],["人","ひと"],["は"],["空しく","むなしく"],["あくせく"],["しだれ"],["の"],["手","て"],["に"],["渡る","わたる"],["と"],["も"],["知らず","しらず"],["に"],["積み上げる","つみあげる"],["。"]]},{"verse":8,"text":"主よ、それなら何に望みをかけたらよいのでしょう。わたしはあなたを待ち望みます。","tok":[["主","ぬし"],["よ"],["、"],["それ"],["なら"],["何","なん"],["に"],["望み","のぞみ"],["を"],["かけたら"],["よい"],["の"],["でしょう"],["。"],["わたし"],["は"],["あなた"],["を"],["待ち望みます","まちのぞみます"],["。"]]},{"verse":9,"text":"あなたに背いたすべての罪からわたしを救い神を知らぬ者というそしりを受けないようにしてください。","tok":[["あなた"],["に"],["背いた","そむいた"],["すべて"],["の"],["罪","つみ"],["から"],["わたし"],["を"],["救い神","すくいがみ"],["を"],["知らぬ","しらぬ"],["者","もの"],["と"],["いう"],["そ"],["しり"],["を"],["受けない","うけない"],["よう"],["に"],["して"],["ください"],["。"]]},{"verse":10,"text":"わたしは黙し、口を開きません。あなたが計らってくださるでしょう。","tok":[["わたし"],["は"],["黙し","もくし"],["、"],["口","くち"],["を"],["開きません","ひらきません"],["。"],["あなた"],["が"],["計らって","はからって"],["くださるでしょう"],["。"]]},{"verse":11,"text":"わたしをさいなむその御手を放してください。御手に撃たれてわたしは衰え果てました。","tok":[["わたし"],["を"],["さいなむ"],["その"],["御手","おて"],["を"],["放して","はなして"],["ください"],["。"],["御手","おて"],["に"],["撃たれて","うたれて"],["わたし"],["は"],["衰え","おとろえ"],["果てました","はてました"],["。"]]},{"verse":12,"text":"あなたに罪を責められ、懲らしめられて人の欲望など虫けらのようについえます。ああ、人は皆、空しい。〔セラ","tok":[["あなた"],["に"],["罪","つみ"],["を"],["責められ","せめられ"],["、"],["懲らしめられて","こらしめられて"],["人","ひと"],["の"],["欲望","よくぼう"],["など"],["虫けら","むしけら"],["の"],["よう"],["に"],["ついえます"],["。"],["ああ"],["、"],["人","ひと"],["は"],["皆","みな"],["、"],["空しい","むなしい"],["。"],["〔"],["セラ"]]},{"verse":13,"text":"主よ、わたしの祈りを聞き助けを求める叫びに耳を傾けてください。わたしの涙に沈黙していないでください。わたしは御もとに身を寄せる者先祖と同じ宿り人。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["の"],["祈り","いのり"],["を"],["聞き","きき"],["助け","たすけ"],["を"],["求める","もとめる"],["叫び","さけび"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"],["わたし"],["の"],["涙","なみだ"],["に"],["沈黙","ちんもく"],["して"],["いないで"],["ください"],["。"],["わたし"],["は"],["御もと","おもと"],["に"],["身","み"],["を"],["寄せる","よせる"],["者","もの"],["先祖","せんぞ"],["と"],["同じ","おなじ"],["宿り人","やどりにん"],["。"]]},{"verse":14,"text":"あなたの目をわたしからそらせ立ち直らせてくださいわたしが去り、失われる前に。","tok":[["あなた"],["の"],["目","め"],["を"],["わたし"],["から"],["そらせ"],["立ち直らせて","たちなおらせて"],["ください"],["わたし"],["が"],["去り","さり"],["、"],["失われる","うしなわれる"],["前","まえ"],["に"],["。"]]}]
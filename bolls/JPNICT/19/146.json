[{"verse":1,"text":"ハレルヤ。わたしの魂よ、主を賛美せよ。","tok":[["ハレルヤ"],["。"],["わたし"],["の"],["魂","たましい"],["よ"],["、"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],["。"]]},{"verse":2,"text":"命のある限り、わたしは主を賛美し長らえる限りわたしの神にほめ歌をうたおう。","tok":[["命","いのち"],["の"],["ある"],["限り","かぎり"],["、"],["わたし"],["は"],["主","ぬし"],["を"],["賛美","さんび"],["し"],["長らえる","ながらえる"],["限り","かぎり"],["わたし"],["の"],["神","かみ"],["に"],["ほめ歌","ほめうた"],["を"],["うたおう"],["。"]]},{"verse":3,"text":"君侯に依り頼んではならない。人間には救う力はない。","tok":[["君侯","くんこう"],["に"],["依り頼んで","よりたのんで"],["は"],["ならない"],["。"],["人間","にんげん"],["に"],["は"],["救う","すくう"],["力","ちから"],["は"],["ない"],["。"]]},{"verse":4,"text":"霊が人間を去れば人間は自分の属する土に帰りその日、彼の思いも滅びる。","tok":[["霊","れい"],["が"],["人間","にんげん"],["を"],["去れば","されば"],["人間","にんげん"],["は"],["自分","じぶん"],["の"],["属する","ぞくする"],["土","つち"],["に"],["帰り","かえり"],["その"],["日","ひ"],["、"],["彼","かれ"],["の"],["思い","おもい"],["も"],["滅びる","ほろびる"],["。"]]},{"verse":5,"text":"いかに幸いなことかヤコブの神を助けと頼み主なるその神を待ち望む人","tok":[["いかに"],["幸い","さいわい"],["な"],["こと"],["か"],["ヤコブ"],["の"],["神","かみ"],["を"],["助け","たすけ"],["と"],["頼み","たのみ"],["主","ぬし"],["なる"],["その"],["神","かみ"],["を"],["待ち望む","まちのぞむ"],["人","ひと"]]},{"verse":6,"text":"天地を造り海とその中にあるすべてのものを造られた神を。とこしえにまことを守られる主は","tok":[["天地","てんち"],["を"],["造り","つくり"],["海","かい"],["と"],["その"],["中","なか"],["に"],["ある"],["すべて"],["の"],["もの"],["を"],["造られた","つくられた"],["神","かみ"],["を"],["。"],["とこしえ"],["に"],["まこと"],["を"],["守られる","まもられる"],["主","ぬし"],["は"]]},{"verse":7,"text":"虐げられている人のために裁きをし飢えている人にパンをお与えになる。主は捕われ人を解き放ち","tok":[["虐げられて","しいたげられて"],["いる"],["人","ひと"],["の"],["ため"],["に"],["裁き","さばき"],["を"],["し"],["飢えて","うえて"],["いる"],["人","ひと"],["に"],["パン"],["を"],["お与え","おあたえ"],["に"],["なる"],["。"],["主","ぬし"],["は"],["捕われ","とらわれ"],["人","ひと"],["を"],["解き放ち","ときはなち"]]},{"verse":8,"text":"主は見えない人の目を開き主はうずくまっている人を起こされる。主は従う人を愛し","tok":[["主","ぬし"],["は"],["見えない","みえない"],["人","ひと"],["の"],["目","め"],["を"],["開き","ひらき"],["主","ぬし"],["は"],["うずくまって"],["いる"],["人","ひと"],["を"],["起こされる","おこされる"],["。"],["主","ぬし"],["は"],["従う","したがう"],["人","ひと"],["を"],["愛し","あいし"]]},{"verse":9,"text":"主は寄留の民を守りみなしごとやもめを励まされる。しかし主は、逆らう者の道をくつがえされる。","tok":[["主","ぬし"],["は"],["寄留","きりゅう"],["の"],["民","たみ"],["を"],["守り","まもり"],["みなしご"],["と"],["やもめ"],["を"],["励まされる","はげまされる"],["。"],["しかし"],["主","ぬし"],["は"],["、"],["逆らう","さからう"],["者","もの"],["の"],["道","みち"],["を"],["くつがえされる"],["。"]]},{"verse":10,"text":"主はとこしえに王。シオンよ、あなたの神は代々に王。ハレルヤ。","tok":[["主","ぬし"],["は"],["とこしえ"],["に"],["王","おう"],["。"],["シオン"],["よ"],["、"],["あなた"],["の"],["神","かみ"],["は"],["代々","だいだい"],["に"],["王","おう"],["。"],["ハレルヤ"],["。"]]}]
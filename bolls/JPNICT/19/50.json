[{"verse":1,"text":"［賛歌。アサフの詩。］神々の神、主は、御言葉を発し日の出るところから日の入るところまで地を呼び集められる。","tok":[["［"],["賛歌","さんか"],["。"],["アサフ"],["の"],["詩","し"],["。"],["］"],["神々","かみがみ"],["の"],["神","かみ"],["、"],["主","ぬし"],["は"],["、"],["御言葉","おことば"],["を"],["発し","はっし"],["日","ひ"],["の"],["出る","でる"],["ところ"],["から"],["日","ひ"],["の"],["入る","はいる"],["ところ"],["まで"],["地","ち"],["を"],["呼び集められる","よびあつめられる"],["。"]]},{"verse":2,"text":"麗しさの極みシオンから、神は顕現される。","tok":[["麗し","うるわし"],["さ"],["の"],["極み","きわみ"],["シオン"],["から"],["、"],["神","かみ"],["は"],["顕現","けんげん"],["される"],["。"]]},{"verse":3,"text":"わたしたちの神は来られる黙してはおられない。御前を火が焼き尽くして行き御もとには嵐が吹き荒れている。","tok":[["わたしたち"],["の"],["神","かみ"],["は"],["来られる","こられる"],["黙して","もくして"],["は"],["おられない"],["。"],["御前","ごぜん"],["を"],["火","ひ"],["が"],["焼き","やき"],["尽くして","つくして"],["行き","いき"],["御もと","おもと"],["に"],["は"],["嵐","あらし"],["が"],["吹き荒れて","ふきあれて"],["いる"],["。"]]},{"verse":4,"text":"神は御自分の民を裁くために上から天に呼びかけ、また、地に呼びかけられる。","tok":[["神","かみ"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["を"],["裁く","さばく"],["ため"],["に"],["上","うえ"],["から"],["天","てん"],["に"],["呼びかけ","よびかけ"],["、"],["また"],["、"],["地","ち"],["に"],["呼びかけられる","よびかけられる"],["。"]]},{"verse":5,"text":"「わたしの前に集めよわたしの慈しみに生きる者をいけにえを供えてわたしと契約を結んだ者を。」","tok":[["「"],["わたし"],["の"],["前","まえ"],["に"],["集めよ","あつめよ"],["わたし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["者","もの"],["を"],["いけにえ"],["を"],["供えて","そなえて"],["わたし"],["と"],["契約","けいやく"],["を"],["結んだ","むすんだ"],["者","もの"],["を"],["。"],["」"]]},{"verse":6,"text":"天は神の正しいことを告げ知らせる。神は御自ら裁きを行われる。〔セラ","tok":[["天","てん"],["は"],["神","かみ"],["の"],["正しい","ただしい"],["こと"],["を"],["告げ知らせる","つげしらせる"],["。"],["神","かみ"],["は"],["御自ら","おみずから"],["裁き","さばき"],["を"],["行われる","おこなわれる"],["。"],["〔"],["セラ"]]},{"verse":7,"text":"「わたしの民よ、聞け、わたしは語る。イスラエルよ、わたしはお前を告発する。わたしは神、わたしはお前の神。","tok":[["「"],["わたし"],["の"],["民","たみ"],["よ"],["、"],["聞け","きけ"],["、"],["わたし"],["は"],["語る","かたる"],["。"],["イスラエル"],["よ"],["、"],["わたし"],["は"],["お前","おまえ"],["を"],["告発","こくはつ"],["する"],["。"],["わたし"],["は"],["神","かみ"],["、"],["わたし"],["は"],["お前","おまえ"],["の"],["神","かみ"],["。"]]},{"verse":8,"text
[{"verse":1,"text":"ハレルヤ。新しい歌を主に向かって歌え。主の慈しみに生きる人の集いで賛美の歌をうたえ。","tok":[["ハレルヤ"],["。"],["新しい","あたらしい"],["歌","うた"],["を"],["主に","おもに"],["向かって","むかって"],["歌え","うたえ"],["。"],["主","ぬし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["の"],["集い","つどい"],["で"],["賛美","さんび"],["の"],["歌","うた"],["を"],["うたえ"],["。"]]},{"verse":2,"text":"イスラエルはその造り主によって喜び祝いシオンの子らはその王によって喜び躍れ。","tok":[["イスラエル"],["は"],["その"],["造り主","つくりぬし"],["によって"],["喜び祝い","よろこびいわい"],["シオン"],["の"],["子","こ"],["ら"],["は"],["その"],["王","おう"],["によって"],["喜び","よろこび"],["躍れ","おどれ"],["。"]]},{"verse":3,"text":"踊りをささげて御名を賛美し太鼓や竪琴を奏でてほめ歌をうたえ。","tok":[["踊り","おどり"],["を"],["ささげて"],["御名","ぎょめい"],["を"],["賛美","さんび"],["し"],["太鼓","たいこ"],["や"],["竪琴","たてごと"],["を"],["奏でて","かなでて"],["ほめ歌","ほめうた"],["を"],["うたえ"],["。"]]},{"verse":4,"text":"主は御自分の民を喜び貧しい人を救いの輝きで装われる。","tok":[["主","ぬし"],["は"],["御自分","ごじぶん"],["の"],["民","たみ"],["を"],["喜び","よろこび"],["貧しい","まずしい"],["人","ひと"],["を"],["救い","すくい"],["の"],["輝き","かがやき"],["で"],["装われる","よそおわれる"],["。"]]},{"verse":5,"text":"主の慈しみに生きる人は栄光に輝き、喜び勇み伏していても喜びの声をあげる。","tok":[["主","ぬし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["は"],["栄光","えいこう"],["に"],["輝き","かがやき"],["、"],["喜び勇み","よろこびいさみ"],["伏して","ふして"],["いて"],["も"],["喜び","よろこび"],["の"],["声","こえ"],["を"],["あげる"],["。"]]},{"verse":6,"text":"口には神をあがめる歌があり手には両刃の剣を持つ。","tok":[["口","くち"],["に"],["は"],["神","かみ"],["を"],["あがめる"],["歌","うた"],["が"],["あり"],["手","しゅ"],["に"],["は"],["両刃","りょうば"],["の"],["剣","けん"],["を"],["持つ","もつ"],["。"]]},{"verse":7,"text":"国々に報復し諸国の民を懲らしめ","tok":[["国々","くにぐに"],["に"],["報復","ほうふく"],["し"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["懲らしめ","こらしめ"]]},{"verse":8,"text":"王たちを鎖につなぎ君侯に鉄の枷をはめ","tok":[["王","おう"],["たち"],["を"],["鎖","くさり"],["に"],["つなぎ"],["君侯","くんこう"],["に"],["鉄","てつ"],["の"],["枷","かせ"],["を"],["はめ"]]},{"verse":9,"text":"定められた裁きをする。これは、主の慈しみに生きる人の光栄。ハレルヤ。","tok":[["定められた","さだめられた"],["裁き","さばき"],["を"],["する"],["。"],["これ"],["は"],["、"],["主","ぬし"],["の"],["慈しみ","いつくしみ"],["に"],["生きる","いきる"],["人","ひと"],["の"],["光栄","こうえい"],["。"],["ハレルヤ"],["。"]]}]
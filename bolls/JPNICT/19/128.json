[{"verse":1,"text":"［都に上る歌。］いかに幸いなことか主を畏れ、主の道に歩む人よ。","tok":[["［"],["都","と"],["に"],["上る","のぼる"],["歌","うた"],["。"],["］"],["いかに"],["幸い","さいわい"],["な"],["こと"],["か"],["主","ぬし"],["を"],["畏れ","おそれ"],["、"],["主","ぬし"],["の"],["道","みち"],["に"],["歩む","あゆむ"],["人","ひと"],["よ"],["。"]]},{"verse":2,"text":"あなたの手が労して得たものはすべてあなたの食べ物となる。あなたはいかに幸いなことかいかに恵まれていることか。","tok":[["あなた"],["の"],["手","て"],["が"],["労して","ろうして"],["得た","えた"],["もの"],["は"],["すべて"],["あなた"],["の"],["食べ物","たべもの"],["と"],["なる"],["。"],["あなた"],["は"],["いかに"],["幸い","さいわい"],["な"],["こと"],["か"],["いかに"],["恵まれて","めぐまれて"],["いる"],["こと"],["か"],["。"]]},{"verse":3,"text":"妻は家の奥にいて、豊かな房をつけるぶどうの木。食卓を囲む子らは、オリーブの若木。","tok":[["妻","つま"],["は"],["家","いえ"],["の"],["奥","おく"],["に"],["いて"],["、"],["豊か","ゆたか"],["な"],["房","ふさ"],["を"],["つける"],["ぶどう"],["の"],["木","き"],["。"],["食卓","しょくたく"],["を"],["囲む","かこむ"],["子","こ"],["ら"],["は"],["、"],["オリーブ"],["の"],["若木","わかぎ"],["。"]]},{"verse":4,"text":"見よ、主を畏れる人はこのように祝福される。","tok":[["見よ","みよ"],["、"],["主","ぬし"],["を"],["畏れる","おそれる"],["人","ひと"],["は"],["この"],["よう"],["に"],["祝福","しゅくふく"],["される"],["。"]]},{"verse":5,"text":"シオンから主があなたを祝福してくださるように。命のある限りエルサレムの繁栄を見","tok":[["シオン"],["から"],["主","ぬし"],["が"],["あなた"],["を"],["祝福","しゅくふく"],["して"],["くださる"],["よう"],["に"],["。"],["命","いのち"],["の"],["ある"],["限り","かぎり"],["エルサレム"],["の"],["繁栄","はんえい"],["を"],["見","み"]]},{"verse":6,"text":"多くの子や孫を見るように。イスラエルに平和。","tok":[["多く","おおく"],["の"],["子","こ"],["や"],["孫","まご"],["を"],["見る","みる"],["よう"],["に"],["。"],["イスラエル"],["に"],["平和","へいわ"],["。"]]}]
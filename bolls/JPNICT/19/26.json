[{"verse":1,"text":"［ダビデの詩。］主よ、あなたの裁きを望みます。わたしは完全な道を歩いてきました。主に信頼して、よろめいたことはありません。","tok":[["［"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["よ"],["、"],["あなた"],["の"],["裁き","さばき"],["を"],["望みます","のぞみます"],["。"],["わたし"],["は"],["完全","かんぜん"],["な"],["道","みち"],["を"],["歩いて","あるいて"],["きました"],["。"],["主に","おもに"],["信頼","しんらい"],["して"],["、"],["よろめいた"],["こと"],["は"],["ありません"],["。"]]},{"verse":2,"text":"主よ、わたしを調べ、試みはらわたと心を火をもって試してください。","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["を"],["調べ","しらべ"],["、"],["試み","こころみ"],["はらわた"],["と"],["心","こころ"],["を"],["火","ひ"],["を"],["もって"],["試して","ためして"],["ください"],["。"]]},{"verse":3,"text":"あなたの慈しみはわたしの目の前にありあなたのまことに従って歩き続けています。","tok":[["あなた"],["の"],["慈しみ","いつくしみ"],["は"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["に"],["あり"],["あなた"],["の"],["まこと"],["に"],["従って","したがって"],["歩き","あるき"],["続けて","つづけて"],["います"],["。"]]},{"verse":4,"text":"偽る者と共に座らず欺く者の仲間に入らず","tok":[["偽る","いつわる"],["者","もの"],["と"],["共","とも"],["に"],["座らず","すわらず"],["欺く","あざむく"],["者","もの"],["の"],["仲間","なかま"],["に"],["入らず","はいらず"]]},{"verse":5,"text":"悪事を謀る者の集いを憎み主に逆らう者と共に座ることをしません。","tok":[["悪事","あくじ"],["を"],["謀る","はかる"],["者","もの"],["の"],["集い","つどい"],["を"],["憎み","にくみ"],["主","ぬし"],["に"],["逆らう","さからう"],["者","もの"],["と"],["共","とも"],["に"],["座る","すわる"],["こと"],["を"],["しません"],["。"]]},{"verse":6,"text":"主よ、わたしは手を洗って潔白を示しあなたの祭壇を廻り","tok":[["主","ぬし"],["よ"],["、"],["わたし"],["は"],["手","て"],["を"],["洗って","あらって"],["潔白","けっぱく"],["を"],["示し","しめし"],["あなた"],["の"],["祭壇","さいだん"],["を"],["廻り","まわり"]]},{"verse":7,"text":"感謝の歌声を響かせ驚くべき御業をことごとく語り伝えます。","tok":[["感謝","かんしゃ"],["の"],["歌声","うたごえ"],["を"],["響かせ","ひびかせ"],["驚くべき","おどろくべき"],["御業","ごごう"],["を"],["ことごとく"],["語り伝えます","かたりつたえます"],["。"]]},{"verse":8,"text":"主よ、あなたのいます家あなたの栄光の宿るところをわたしは慕います。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["の"],["います"],["家","いえ"],["あなた"],["の"],["栄光","えいこう"],["の"],["宿る","やどる"],["ところ"],["を"],["わたし"],["は"],["慕います","したいます"],["。"]]},{"verse":9,"text":"わたしの魂を罪ある者の魂と共にわたしの命を流血を犯す者の命と共に取り上げないでください。","tok":[["わたし"],["の"],["魂","たましい"],["を"],["罪","つみ"],["ある"],["者","もの"],["の"],["魂","たましい"],["と"],["共","とも"],["に"],["わたし"],["の"],["命","いのち"],["を"],["流血","りゅうけつ"],["を"],["犯す","おかす"],["者","もの"],["の"],["命","いのち"],["と"],["共","とも"],["に"],["取り上げないで","とりあげないで"],["ください"],["。"]]},{"verse":10,"text":"彼らの手は汚れた行いに馴れその右の手には奪った物が満ちています。","tok":[["彼","かれ"],["ら"],["の"],["手","て"],["は"],["汚れた","よごれた"],["行い","おこない"],["に"],["馴れ","なれ"],["その"],["右","みぎ"],["の"],["手","て"],["に"],["は"],["奪った","うばった"],["物","もの"],["が"],["満ちて","みちて"],["います"],["。"]]},{"verse":11,"text":"わたしは完全な道を歩きます。わたしを憐れみ、贖ってください。","tok":[["わたし"],["は"],["完全","かんぜん"],["な"],["道","みち"],["を"],["歩きます","あるきます"],["。"],["わたし"],["を"],["憐れみ","あわれみ"],["、"],["贖って","あがなって"],["ください"],["。"]]},{"verse":12,"text":"わたしの足はまっすぐな道に立っています。聖歌隊と共にわたしは主をたたえます。","tok":[["わたし"],["の"],["足","あし"],["は"],["まっすぐ"],["な"],["道","みち"],["に"],["立って","たって"],["います"],["。"],["聖歌隊","せいかたい"],["と"],["共","とも"],["に"],["わたし"],["は"],["主","ぬし"],["を"],["たたえます"],["。"]]}]
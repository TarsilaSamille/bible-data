[{"verse":1,"text":"［ダビデの詩。］主をたたえよ、わたしの岩をわたしの手に闘うすべを指に戦するすべを教えてくださる方を","tok":[["［"],["ダビデ"],["の"],["詩","し"],["。"],["］"],["主","ぬし"],["を"],["たたえよ"],["、"],["わたし"],["の"],["岩","いわ"],["を"],["わたし"],["の"],["手","て"],["に"],["闘う","たたかう"],["すべ"],["を"],["指","ゆび"],["に"],["戦","いくさ"],["する"],["すべ"],["を"],["教えて","おしえて"],["くださる"],["方","かた"],["を"]]},{"verse":2,"text":"わたしの支え、わたしの砦、砦の塔わたしの逃れ場、わたしの盾、避けどころ諸国の民をわたしに服従させてくださる方を。","tok":[["わたし"],["の"],["支え","ささえ"],["、"],["わたし"],["の"],["砦","とりで"],["、"],["砦","とりで"],["の"],["塔","とう"],["わたし"],["の"],["逃れ","のがれ"],["場","ば"],["、"],["わたし"],["の"],["盾","たて"],["、"],["避け","さけ"],["どころ"],["諸国","しょこく"],["の"],["民","たみ"],["を"],["わたし"],["に"],["服従","ふくじゅう"],["させて"],["くださる"],["方","かた"],["を"],["。"]]},{"verse":3,"text":"主よ、人間とは何ものなのでしょうあなたがこれに親しまれるとは。人の子とは何ものなのでしょうあなたが思いやってくださるとは。","tok":[["主","ぬし"],["よ"],["、"],["人間","にんげん"],["と"],["は"],["何もの","なにもの"],["な"],["の"],["でしょう"],["あなた"],["が"],["これ"],["に"],["親しまれる","したしまれる"],["と"],["は"],["。"],["人","ひと"],["の"],["子","こ"],["と"],["は"],["何もの","なにもの"],["な"],["の"],["でしょう"],["あなた"],["が"],["思いやって","おもいやって"],["くださる"],["と"],["は"],["。"]]},{"verse":4,"text":"人間は息にも似たもの彼の日々は消え去る影。","tok":[["人間","にんげん"],["は"],["息","いき"],["に"],["も"],["似た","にた"],["もの"],["彼","かれ"],["の"],["日々","ひび"],["は"],["消え去る","きえさる"],["影","かげ"],["。"]]},{"verse":5,"text":"主よ、天を傾けて降り山々に触れ、これに煙を上げさせてください。","tok":[["主","ぬし"],["よ"],["、"],["天","てん"],["を"],["傾けて","かたむけて"],["降り","ふり"],["山々","やまやま"],["に"],["触れ","ふれ"],["、"],["これ"],["に"],["煙","けむり"],["を"],["上げさせて","あげさせて"],["ください"],["。"]]},{"verse":6,"text":"飛び交う稲妻うなりを上げる矢を放ってください。","tok":[["飛び交う","とびかう"],["稲妻","いなずま"],["うなり"],["を"],["上げる","あげる"],["矢","や"],["を"],["放って","はなって"],["ください"],["。"]]},{"verse":7,"text":"高い天から御手を遣わしてわたしを解き放ち大水から、異邦人の手から助け出してください。","tok":[["高い","たかい"],["天","てん"],["から"],["御手","おて"],["を"],["遣わして","つかわして"],["わたし"],["を"],["解き放ち","ときはなち"],["大水","おおみず"],["から"],["、"],["異邦人","いほうじん"],["の"],["手","て"],["から"],["助け出して","たすけだして"],["ください"],["。"]]},{"verse":8,"text":"彼らの口はむなしいことを語り彼らの右の手は欺きを行う右の手です。","tok":[["彼","かれ"],["ら"],["の"],["口","くち"],["は"],["むなしい"],["こと"],["を"],["語り","かたり"],["彼","かれ"],["ら"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["欺き","あざむき"],["を"],["行う","おこなう"],["右","みぎ"],["の"],["手","て"],["です"],["。"]]},{"verse":9,"text":"神よ、あなたに向かって新しい歌をうたい十弦の琴をもってほめ歌をうたいます。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["に"],["向かって","むかって"],["新しい","あたらしい"],["歌","うた"],["を"],["うたい"],["十","じゅう"],["弦","げん"],["の"],["琴","こと"],["を"],["もって"],["ほめ歌","ほめうた"],["を"],["うたいます"],["。"]]},{"verse":10,"text":"あなたは王たちを救い僕ダビデを災いの剣から解き放ってくださいます。","tok":[["あなた"],["は"],["王","おう"],["たち"],["を"],["救い","すくい"],["僕","ぼく"],["ダビデ"],["を"],["災い","わざわい"],["の"],["剣","けん"],["から"],["解き放って","ときはなって"],["くださいます"],["。"]]},{"verse":11,"text":"わたしを解き放ち異邦人の手から助け出してください。彼らの口はむなしいことを語り彼らの右の手は欺きを行う右の手です。","tok":[["わたし"],["を"],["解き放ち","ときはなち"],["異邦人","いほうじん"],["の"],["手","て"],["から"],["助け出して","たすけだして"],["ください"],["。"],["彼","かれ"],["ら"],["の"],["口","くち"],["は"],["むなしい"],["こと"],["を"],["語り","かたり"],["彼","かれ"],["ら"],["の"],["右","みぎ"],["の"],["手","て"],["は"],["欺き","あざむき"],["を"],["行う","おこなう"],["右","みぎ"],["の"],["手","て"],["です"],["。"]]},{"verse":12,"text":"わたしたちの息子は皆幼いときから大事に育てられた苗木。娘は皆、宮殿の飾りにも似た色とりどりの彫り物。","tok":[["わたしたち"],["の"],["息子","むすこ"],["は"],["皆","みな"],["幼い","おさない"],["とき"],["から"],["大事","だいじ"],["に"],["育てられた","そだてられた"],["苗木","なえぎ"],["。"],["娘","むすめ"],["は"],["皆","みな"],["、"],["宮殿","きゅうでん"],["の"],["飾り","かざり"],["に"],["も"],["似た","にた"],["色","いろ"],["とりどり"],["の"],["彫り物","ほりもの"],["。"]]},{"verse":13,"text":"わたしたちの倉はさまざまな穀物で満たされている。羊の群れは野に、幾千幾万を数え","tok":[["わたしたち"],["の"],["倉","くら"],["は"],["さまざま"],["な"],["穀物","こくもつ"],["で"],["満たされて","みたされて"],["いる"],["。"],["羊","ひつじ"],["の"],["群れ","むれ"],["は"],["野","の"],["に"],["、"],["幾","いく"],["千","せん"],["幾","いく"],["万","まん"],["を"],["数え","かぞえ"]]},{"verse":14,"text":"牛はすべて、肥えている。わたしたちの都の広場には破れも捕囚も叫び声もない。","tok":[["牛","うし"],["は"],["すべて"],["、"],["肥えて","こえて"],["いる"],["。"],["わたしたち"],["の"],["都","と"],["の"],["広場","ひろば"],["に"],["は"],["破れ","やぶれ"],["も"],["捕囚","ほしゅう"],["も"],["叫び声","さけびごえ"],["も"],["ない"],["。"]]},{"verse":15,"text":"いかに幸いなことか、このような民は。いかに幸いなこと
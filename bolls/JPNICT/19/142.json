[{"verse":1,"text":"［マスキール。ダビデの詩。ダビデが洞穴にいたとき。祈り。］","tok":[["［"],["マスキール"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["ダビデ"],["が"],["洞穴","ほらあな"],["に"],["いた"],["とき"],["。"],["祈り","いのり"],["。"],["］"]]},{"verse":2,"text":"声をあげ、主に向かって叫び声をあげ、主に向かって憐れみを求めよう。","tok":[["声","こえ"],["を"],["あげ"],["、"],["主に","おもに"],["向かって","むかって"],["叫び声","さけびごえ"],["を"],["あげ"],["、"],["主に","おもに"],["向かって","むかって"],["憐れみ","あわれみ"],["を"],["求めよう","もとめよう"],["。"]]},{"verse":3,"text":"御前にわたしの悩みを注ぎ出し御前に苦しみを訴えよう。","tok":[["御前","ごぜん"],["に"],["わたし"],["の"],["悩み","なやみ"],["を"],["注ぎ","そそぎ"],["出し","だし"],["御前","ごぜん"],["に"],["苦しみ","くるしみ"],["を"],["訴えよう","うったえよう"],["。"]]},{"verse":4,"text":"わたしの霊がなえ果てているときわたしがどのような道に行こうとするかあなたはご存じです。その道を行けばそこには罠が仕掛けられています。","tok":[["わたし"],["の"],["霊","れい"],["が"],["なえ"],["果てて","はてて"],["いる"],["とき"],["わたし"],["が"],["どのような"],["道","みち"],["に"],["行こう","いこう"],["と"],["する"],["か"],["あなた"],["は"],["ご存じ","ごぞんじ"],["です"],["。"],["その"],["道","みち"],["を"],["行けば","いけば"],["そこ"],["に"],["は"],["罠","わな"],["が"],["仕掛けられて","しかけられて"],["います"],["。"]]},{"verse":5,"text":"目を注いで御覧ください。右に立ってくれる友もなく逃れ場は失われ命を助けようとしてくれる人もありません。","tok":[["目","め"],["を"],["注いで","そそいで"],["御覧","ごらん"],["ください"],["。"],["右","みぎ"],["に"],["立って","たって"],["くれる"],["友","とも"],["も"],["なく"],["逃れ","のがれ"],["場","ば"],["は"],["失われ","うしなわれ"],["命","いのち"],["を"],["助けよう","たすけよう"],["として"],["くれる"],["人","ひと"],["も"],["ありません"],["。"]]},{"verse":6,"text":"主よ、あなたに向かって叫び、申します「あなたはわたしの避けどころ命あるものの地でわたしの分となってくださる方」と。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["に"],["向かって","むかって"],["叫び","さけび"],["、"],["申します","もうします"],["「"],["あなた"],["は"],["わたし"],["の"],["避け","よけ"],["どころ"],["命","いのち"],["ある"],["もの"],["の"],["地","ち"],["で"],["わたし"],["の"],["分","ぶん"],["と"],["なって"],["くださる"],["方","かた"],["」"],["と"],["。"]]},{"verse":7,"text":"わたしの叫びに耳を傾けてください。わたしは甚だしく卑しめられています。迫害する者から助け出してください。彼らはわたしよりも強いのです。","tok":[["わたし"],["の"],["叫び","さけび"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"],["わたし"],["は"],["甚だしく","はなはだしく"],["卑しめられて","いやしめられて"],["います"],["。"],["迫害","はくがい"],["する"],["者","もの"],["から"],["助け出して","たすけだして"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["より"],["も"],["強い","つよい"],["の"],["です"],["。"]]},{"verse":8,"text":"わたしの魂を枷から引き出してください。あなたの御名に感謝することができますように。主に従う人々がわたしを冠としますように。あなたがわたしに報いてくださいますように。","tok":[["わたし"],["の"],["魂","たましい"],["を"],["枷","かせ"],["から"],["引き出して","ひきだして"],["ください"],["。"],["あなた"],["の"],["御名","ぎょめい"],["に"],["感謝","かんしゃ"],["する"],["こと"],["が"],["できます"],["よう"],["に"],["。"],["主に","おもに"],["従う","したがう"],["人々","ひとびと"],["が"],["わたし"],["を"],["冠","かんむり"],["と"],["します"],["よう"],["に"],["。"],["あなた"],["が"],["わたし"],["に"],["報いて","むくいて"],["くださいます"],["よう"],["に"],["。"]]}]
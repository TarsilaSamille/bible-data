[{"verse":1,"text":"すべての国よ、主を賛美せよ。すべての民よ、主をほめたたえよ。","tok":[["すべて"],["の"],["国","くに"],["よ"],["、"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],["。"],["すべて"],["の"],["民","たみ"],["よ"],["、"],["主","ぬし"],["を"],["ほめたたえ"],["よ"],["。"]]},{"verse":2,"text":"主の慈しみとまことはとこしえにわたしたちを超えて力強い。ハレルヤ。","tok":[["主","ぬし"],["の"],["慈しみ","いつくしみ"],["と"],["まこと"],["は"],["とこしえ"],["に"],["わたしたち"],["を"],["超えて","こえて"],["力強い","ちからづよい"],["。"],["ハレルヤ"],["。"]]}]
[{"verse":1,"text":"主こそ王。威厳を衣とし力を衣とし、身に帯びられる。世界は固く据えられ、決して揺らぐことはない。","tok":[["主","ぬし"],["こそ"],["王","おう"],["。"],["威厳","いげん"],["を"],["衣","ころも"],["と"],["し"],["力","ちから"],["を"],["衣","ころも"],["と"],["し"],["、"],["身","み"],["に"],["帯びられる","おびられる"],["。"],["世界","せかい"],["は"],["固く","かたく"],["据えられ","すえられ"],["、"],["決して","けっして"],["揺らぐ","ゆらぐ"],["こと"],["は"],["ない"],["。"]]},{"verse":2,"text":"御座はいにしえより固く据えられあなたはとこしえの昔からいます。","tok":[["御座","ぎょざ"],["は"],["いにしえ"],["より"],["固く","かたく"],["据えられ","すえられ"],["あなた"],["は"],["とこしえ"],["の"],["昔","むかし"],["から"],["います"],["。"]]},{"verse":3,"text":"主よ、潮はあげる、潮は声をあげる。潮は打ち寄せる響きをあげる。","tok":[["主","ぬし"],["よ"],["、"],["潮","しお"],["は"],["あげる"],["、"],["潮","しお"],["は"],["声","こえ"],["を"],["あげる"],["。"],["潮","しお"],["は"],["打ち寄せる","うちよせる"],["響き","ひびき"],["を"],["あげる"],["。"]]},{"verse":4,"text":"大水のとどろく声よりも力強く海に砕け散る波。さらに力強く、高くいます主。","tok":[["大水","おおみず"],["の"],["とどろく"],["声","こえ"],["より"],["も"],["力強く","ちからづよく"],["海","うみ"],["に"],["砕け散る","くだけちる"],["波","なみ"],["。"],["さらに"],["力強く","ちからづよく"],["、"],["高く","たかく"],["います"],["主","ぬし"],["。"]]},{"verse":5,"text":"主よ、あなたの定めは確かでありあなたの神殿に尊厳はふさわしい。日の続く限り。","tok":[["主","ぬし"],["よ"],["、"],["あなた"],["の"],["定め","さだめ"],["は"],["確か","たしか"],["で"],["あり"],["あなた"],["の"],["神殿","しんでん"],["に"],["尊厳","そんげん"],["は"],["ふさわしい"],["。"],["日","ひ"],["の"],["続く","つづく"],["限り","かぎり"],["。"]]}]
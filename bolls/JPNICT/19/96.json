[{"verse":1,"text":"新しい歌を主に向かって歌え。全地よ、主に向かって歌え。","tok":[["新しい","あたらしい"],["歌","うた"],["を"],["主に","おもに"],["向かって","むかって"],["歌え","うたえ"],["。"],["全地","ぜんち"],["よ"],["、"],["主に","おもに"],["向かって","むかって"],["歌え","うたえ"],["。"]]},{"verse":2,"text":"主に向かって歌い、御名をたたえよ。日から日へ、御救いの良い知らせを告げよ。","tok":[["主に","おもに"],["向かって","むかって"],["歌い","うたい"],["、"],["御名","ぎょめい"],["を"],["たたえ"],["よ"],["。"],["日","ひ"],["から"],["日","ひ"],["へ"],["、"],["御救い","おすくい"],["の"],["良い","よい"],["知らせ","しらせ"],["を"],["告げ","つげ"],["よ"],["。"]]},{"verse":3,"text":"国々に主の栄光を語り伝えよ諸国の民にその驚くべき御業を。","tok":[["国々","くにぐに"],["に"],["主","ぬし"],["の"],["栄光","えいこう"],["を"],["語り伝えよ","かたりつたえよ"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["その"],["驚くべき","おどろくべき"],["御業","ごごう"],["を"],["。"]]},{"verse":4,"text":"大いなる主、大いに賛美される主神々を超えて、最も畏るべき方。","tok":[["大いなる","おおいなる"],["主","ぬし"],["、"],["大いに","おおいに"],["賛美","さんび"],["される"],["主","ぬし"],["神々","かみがみ"],["を"],["超えて","こえて"],["、"],["最も","もっとも"],["畏るべき","かしこまるべき"],["方","かた"],["。"]]},{"verse":5,"text":"諸国の民の神々はすべてむなしい。主は天を造られ","tok":[["諸国","しょこく"],["の"],["民","たみ"],["の"],["神々","かみがみ"],["は"],["すべて"],["むなしい"],["。"],["主","ぬし"],["は"],["天","てん"],["を"],["造られ","つくられ"]]},{"verse":6,"text":"御前には栄光と輝きがあり聖所には力と光輝がある。","tok":[["御前","ごぜん"],["に"],["は"],["栄光","えいこう"],["と"],["輝き","かがやき"],["が"],["あり"],["聖","せい"],["所","しょ"],["に"],["は"],["力","ちから"],["と"],["光輝","こうき"],["が"],["ある"],["。"]]},{"verse":7,"text":"諸国の民よ、こぞって主に帰せよ栄光と力を主に帰せよ。","tok":[["諸国","しょこく"],["の"],["民","たみ"],["よ"],["、"],["こぞって"],["主に","おもに"],["帰せよ","きせよ"],["栄光","えいこう"],["と"],["力","ちから"],["を"],["主に","おもに"],["帰せ","かえせ"],["よ"],["。"]]},{"verse":8,"text":"御名の栄光を主に帰せよ。供え物を携えて神の庭に入り","tok":[["御名","ぎょめい"],["の"],["栄光","えいこう"],["を"],["主に","おもに"],["帰せ","かえせ"],["よ"],["。"],["供え物","そなえもの"],["を"],["携えて","たずさえて"],["神","かみ"],["の"],["庭","にわ"],["に"],["入り","はいり"]]},{"verse":9,"text":"聖なる輝きに満ちる主にひれ伏せ。全地よ、御前におののけ。","tok":[["聖","せい"],["なる"],["輝き","かがやき"],["に"],["満ちる","みちる"],["主に","おもに"],["ひれ伏せ","ひれふせ"],["。"],["全地","ぜんち"],["よ"],["、"],["御前","ごぜん"],["に"],["おののけ"],["。"]]},{"verse":10,"text":"国々にふれて言え、主こそ王と。世界は固
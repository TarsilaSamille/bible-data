[{"verse":1,"text":"［指揮者によって。「滅ぼさないでください」に合わせて。ダビデの詩。ミクタム。ダビデがサウルを逃れて洞窟にいたとき。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["「"],["滅ぼさないで","ほろぼさないで"],["ください"],["」"],["に"],["合わせて","あわせて"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["ミクタム"],["。"],["ダビデ"],["が"],["サウル"],["を"],["逃れて","のがれて"],["洞窟","どうくつ"],["に"],["いた"],["とき"],["。"],["］"]]},{"verse":2,"text":"憐れんでください神よ、わたしを憐れんでください。わたしの魂はあなたを避けどころとし災いの過ぎ去るまであなたの翼の陰を避けどころとします。","tok":[["憐れんで","あわれんで"],["ください"],["神","かみ"],["よ"],["、"],["わたし"],["を"],["憐れんで","あわれんで"],["ください"],["。"],["わたし"],["の"],["魂","たましい"],["は"],["あなた"],["を"],["避け","さけ"],["どころ"],["と"],["し"],["災い","わざわい"],["の"],["過ぎ去る","すぎさる"],["まで"],["あなた"],["の"],["翼","つばさ"],["の"],["陰","かげ"],["を"],["避け","さけ"],["どころ"],["と"],["します"],["。"]]},{"verse":3,"text":"いと高き神を呼びますわたしのために何事も成し遂げてくださる神を。","tok":[["いと"],["高き","たかき"],["神","かみ"],["を"],["呼びます","よびます"],["わたし"],["の"],["ため"],["に"],["何事","なにごと"],["も"],["成し遂げて","なしとげて"],["くださる"],["神","かみ"],["を"],["。"]]},{"verse":4,"text":"天から遣わしてください神よ、遣わしてください、慈しみとまことを。わたしを踏みにじる者の嘲りからわたしを救ってください。〔セラ","tok":[["天","てん"],["から"],["遣わして","つかわして"],["ください"],["神","かみ"],["よ"],["、"],["遣わして","つかわして"],["ください"],["、"],["慈しみ","いつくしみ"],["と"],["まこと"],["を"],["。"],["わたし"],["を"],["踏みにじる","ふみにじる"],["者","もの"],["の"],["嘲り","あざけり"],["から"],["わたし"],["を"],["救って","すくって"],["ください"],["。"],["〔"],["セラ"]]},{"verse":5,"text":"わたしの魂は獅子の中に火を吐く人の子らの中に伏しています。彼らの歯は槍のように、矢のように舌は剣のように、鋭いのです。","tok":[["わたし"],["の"],["魂","たましい"],["は"],["獅子","しし"],["の"],["中","なか"],["に"],["火","ひ"],["を"],["吐く","はく"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["に"],["伏して","ふして"],["います"],["。"],["彼","かれ"],["ら"],["の"],["歯","は"],["は"],["槍","やり"],["の"],["よう"],["に"],["、"],["矢","や"],["の"],["よう"],["に"],["舌","した"],["は"],["剣","けん"],["の"],["よう"],["に"],["、"],["鋭い","するどい"],["の"],["です"],["。"]]},{"verse":6,"text":"神よ、天の上に高くいまし栄光を全地に輝かせてください。","tok":[["神","かみ"],["よ"],["、"],["天","てん"],["の"],["上","うえ"],["に"],["高く","たかく"],["いまし"],["栄光","えいこう"],["を"],["全地","ぜんち"],["に"],["輝かせて","かがやかせて"],["ください"],["。"]]},{"verse":7,"text":"わたしの魂は屈み込んでいました。彼らはわたしの足もとに網を仕掛けわたしの前に落とし穴を掘りましたがその中に落ち込んだのは彼ら自身でした。〔セラ","tok":[["わたし"],["の"],["魂","たましい"],["は"],["屈み込んで","かがみこんで"],["いました"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["足もと","あしもと"],["に"],["網","あみ"],["を"],["仕掛け","しかけ"],["わたし"],["の"],["前","まえ"],["に"],["落とし穴","おとしあな"],["を"],["掘りました","ほりました"],["が"],["その"],["中","なか"],["に"],["落ち込んだ","おちこんだ"],["の"],["は"],["彼","かれ"],["ら"],["自身","じしん"],["でした"],["。"],["〔"],["セラ"]]},{"verse":8,"text":"わたしは心を確かにします。神よ、わたしは心を確かにしてあなたに賛美の歌をうたいます。","tok":[["わたし"],["は"],["心","こころ"],["を"],["確か","たしか"],["に"],["します"],["。"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["心","こころ"],["を"],["確か","たしか"],["に"],["して"],["あなた"],["に"],["賛美","さんび"],["の"],["歌","うた"],["を"],["うたいます"],["。"]]},{"verse":9,"text":"目覚めよ、わたしの誉れよ目覚めよ、竪琴よ、琴よ。わたしは曙を呼び覚まそう。","tok":[["目覚めよ","めざめよ"],["、"],["わたし"],["の"],["誉れ","ほまれ"],["よ"],["目覚めよ","めざめよ"],["、"],["竪琴","たてごと"],["よ"],["、"],["琴","こと"],["よ"],["。"],["わたし"],["は"],["曙","あけぼの"],["を"],["呼び覚まそう","よびさまそう"],["。"]]},{"verse":10,"text":"主よ、諸国の民の中でわたしはあなたに感謝し国々の中でほめ歌をうたいます。","tok":[["主","ぬし"],["よ"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["中","なか"],["で"],["わたし"],["は"],["あなた"],["に"],["感謝","かんしゃ"],["し"],["国々","くにぐに"],["の"],["中","なか"],["で"],["ほめ歌","ほめうた"],["を"],["うたいます"],["。"]]},{"verse":11,"text":"あなたの慈しみは大きく、天に満ちあなたのまことは大きく、雲を覆います。","tok":[["あなた"],["の"],["慈しみ","いつくしみ"],["は"],["大きく","おおきく"],["、"],["天","てん"],["に"],["満ち","みち"],["あなた"],["の"],["まこと"],["は"],["大きく","おおきく"],["、"],["雲","くも"],["を"],["覆います","おおいます"],["。"]]},{"verse":12,"text":"神よ、天の上に高くいまし栄光を全地に輝かせてください。","tok":[["神","かみ"],["よ"],["、"],["天","てん"],["の"],["上","うえ"],["に"],["高く","たかく"],["いまし"],["栄光","えいこう"],["を"],["全地","ぜんち"],["に"],["輝かせて","かがやかせて"],["ください"],["。"]]}]
[{"verse":1,"text":"ハレルヤ。聖所で神を賛美せよ。大空の砦で神を賛美せよ。","tok":[["ハレルヤ"],["。"],["聖","せい"],["所","しょ"],["で"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"],["大空","おおぞら"],["の"],["砦","とりで"],["で"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"]]},{"verse":2,"text":"力強い御業のゆえに神を賛美せよ。大きな御力のゆえに神を賛美せよ。","tok":[["力強い","ちからづよい"],["御業","ごぎょう"],["の"],["ゆえ"],["に"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"],["大きな","おおきな"],["御力","おちから"],["の"],["ゆえ"],["に"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"]]},{"verse":3,"text":"角笛を吹いて神を賛美せよ。琴と竪琴を奏でて神を賛美せよ。","tok":[["角笛","つのぶえ"],["を"],["吹いて","ふいて"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"],["琴","こと"],["と"],["竪琴","たてごと"],["を"],["奏でて","かなでて"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"]]},{"verse":4,"text":"太鼓に合わせて踊りながら神を賛美せよ。弦をかき鳴らし笛を吹いて神を賛美せよ。","tok":[["太鼓","たいこ"],["に"],["合わせて","あわせて"],["踊り","おどり"],["ながら"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"],["弦","げん"],["を"],["かき鳴らし","かきならし"],["笛","ふえ"],["を"],["吹いて","ふいて"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"]]},{"verse":5,"text":"シンバルを鳴らし神を賛美せよ。シンバルを響かせて神を賛美せよ。","tok":[["シンバル"],["を"],["鳴らし","ならし"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"],["シンバル"],["を"],["響かせて","ひびかせて"],["神","かみ"],["を"],["賛美","さんび"],["せよ"],["。"]]},{"verse":6,"text":"息あるものはこぞって主を賛美せよ。ハレルヤ。","tok":[["息","いき"],["ある"],["もの"],["は"],["こぞって"],["主","ぬし"],["を"],["賛美","さんび"],["せよ"],["。"],["ハレルヤ"],["。"]]}]
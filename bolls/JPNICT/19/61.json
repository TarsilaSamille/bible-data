[{"verse":1,"text":"［指揮者によって。伴奏付き。ダビデの詩。］","tok":[["［"],["指揮者","しきしゃ"],["によって"],["。"],["伴奏付き","ばんそうつき"],["。"],["ダビデ"],["の"],["詩","し"],["。"],["］"]]},{"verse":2,"text":"神よ、わたしの叫びを聞きわたしの祈りに耳を傾けてください。","tok":[["神","かみ"],["よ"],["、"],["わたし"],["の"],["叫び","さけび"],["を"],["聞き","きき"],["わたし"],["の"],["祈り","いのり"],["に"],["耳","みみ"],["を"],["傾けて","かたむけて"],["ください"],["。"]]},{"verse":3,"text":"心が挫けるとき地の果てからあなたを呼びます。高くそびえる岩山の上にわたしを導いてください。","tok":[["心","こころ"],["が"],["挫ける","くじける"],["とき"],["地","ち"],["の"],["果て","はて"],["から"],["あなた"],["を"],["呼びます","よびます"],["。"],["高く","たかく"],["そびえる"],["岩山","いわやま"],["の"],["上","うえ"],["に"],["わたし"],["を"],["導いて","みちびいて"],["ください"],["。"]]},{"verse":4,"text":"あなたは常にわたしの避けどころ敵に対する力強い塔となってくださいます。","tok":[["あなた"],["は"],["常","つね"],["に"],["わたし"],["の"],["避け","よけ"],["どころ"],["敵","てき"],["に"],["対する","たいする"],["力強い","ちからづよい"],["塔","とう"],["と"],["なって"],["くださいます"],["。"]]},{"verse":5,"text":"あなたの幕屋にわたしはとこしえに宿りあなたの翼を避けどころとして隠れます。〔セラ","tok":[["あなた"],["の"],["幕屋","まくや"],["に"],["わたし"],["は"],["とこしえ"],["に"],["宿り","やどり"],["あなた"],["の"],["翼","つばさ"],["を"],["避け","さけ"],["どころ"],["として"],["隠れます","かくれます"],["。"],["〔"],["セラ"]]},{"verse":6,"text":"神よ、あなたは必ずわたしの誓願を聞き取り御名を畏れる人に継ぐべきものをお与えになります。","tok":[["神","かみ"],["よ"],["、"],["あなた"],["は"],["必ず","かならず"],["わたし"],["の"],["誓願","せいがん"],["を"],["聞き取り","ききとり"],["御名","ぎょめい"],["を"],["畏れる","おそれる"],["人","ひと"],["に"],["継ぐべき","つぐべき"],["もの"],["を"],["お与え","おあたえ"],["に"],["なります"],["。"]]},{"verse":7,"text":"王の日々になお日々を加えその年月を代々に永らえさせてください。","tok":[["王","おう"],["の"],["日々","ひび"],["に"],["なお"],["日々","ひび"],["を"],["加え","くわえ"],["その"],["年月","としつき"],["を"],["代々","だいだい"],["に"],["永らえさせて","ながらえさせて"],["ください"],["。"]]},{"verse":8,"text":"王が神の前にあってとこしえの王座につき慈しみとまことに守られますように。","tok":[["王","おう"],["が"],["神","かみ"],["の"],["前","まえ"],["に"],["あって"],["とこしえ"],["の"],["王座","おうざ"],["に"],["つき"],["慈しみ","いつくしみ"],["と"],["まこと"],["に"],["守られます","まもられます"],["よう"],["に"],["。"]]},{"verse":9,"text":"わたしは永遠にあなたの御名をほめ歌い日ごとに満願の献げ物をささげます。","tok":[["わたし"],["は"],["永遠","えいえん"],["に"],["あなた"],["の"],["御名","ぎょめい"],["を"],["ほめ"],["歌い","うたい"],["日ごと","ひごと"],["に"],["満願","まんがん"],["の"],["献げ物","ささげもの"],["を"],["ささげます"],["。"]]}]
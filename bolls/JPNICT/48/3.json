[{"verse":1,"text":"ああ、物分かりの悪いガラテヤの人たち、だれがあなたがたを惑わしたのか。目の前に、イエス‧キリストが十字架につけられた姿ではっきり示されたではないか。","tok":[["ああ"],["、"],["物分かり","ものわかり"],["の"],["悪い","わるい"],["ガラテヤ"],["の"],["人","ひと"],["たち"],["、"],["だれ"],["が"],["あなた"],["がた"],["を"],["惑わした","まどわした"],["の"],["か"],["。"],["目","め"],["の"],["前","まえ"],["に"],["、"],["イエス"],["‧"],["キリスト"],["が"],["十字架","じゅうじか"],["に"],["つけられた"],["姿","すがた"],["で"],["はっきり"],["示されたで","しめされたで"],["は"],["ない"],["か"],["。"]]},{"verse":2,"text":"あなたがたに一つだけ確かめたい。あなたがたが“霊”を受けたのは、律法を行ったからですか。それとも、福音を聞いて信じたからですか。","tok":[["あなた"],["がた"],["に"],["一","ひと"],["つ"],["だけ"],["確かめたい","たしかめたい"],["。"],["あなた"],["がた"],["が"],["“"],["霊","れい"],["”"],["を"],["受けた","うけた"],["の"],["は"],["、"],["律法","りっぽう"],["を"],["行った","おこなった"],["から"],["です"],["か"],["。"],["それ"],["と"],["も"],["、"],["福音","ふくいん"],["を"],["聞いて","きいて"],["信じた","しんじた"],["から"],["です"],["か"],["。"]]},{"verse":3,"text":"あなたがたは、それほど物分かりが悪く、“霊”によって始めたのに、肉によって仕上げようとするのですか。","tok":[["あなた"],["がた"],["は"],["、"],["それ"],["ほど"],["物分かり","ものわかり"],["が"],["悪く","わるく"],["、"],["“"],["霊","れい"],["”"],["によって"],["始めた","はじめた"],["のに"],["、"],["肉","にく"],["によって"],["仕上げよう","しあげよう"],["と"],["する"],["の"],["です"],["か"],["。"]]},{"verse":4,"text":"あれほどのことを体験したのは、無駄だったのですか。無駄であったはずはないでしょうに……。","tok":[["あれ"],["ほど"],["の"],["こと"],["を"],["体験","たいけん"],["した"],["の"],["は"],["、"],["無駄","むだ"],["だった"],["の"],["です"],["か"],["。"],["無駄","むだ"],["で"],["あった"],["はず"],["は"],["ないでしょう"],["に"],["…"],["…"],["。"]]},{"verse":5,"text":"あなたがたに“霊”を授け、また、あなたがたの間で奇跡を行われる方は、あなたがたが律法を行ったから、そうなさるのでしょうか。それとも、あなたがたが福音を聞いて信じたからですか。","tok":[["あなた"],["がた"],["に"],["“"],["霊","れい"],["”"],["を"],["授け","さずけ"],["、"],["また"],["、"],["あなた"],["がた"],["の"],["間","あいだ"],["で"],["奇跡","きせき"],["を"],["行われる","おこなわれる"],["方","かた"],["は"],["、"],["あなた"],["がた"],["が"],["律法","りっぽう"],["を"],["行った","おこなった"],["から"],["、"],["そう"],["なさる"],["の"],["でしょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["あなた"],["がた"],["が"],["福音","ふくいん"],["を"],["聞いて","きいて"],["信じた","しんじた"],["から"],["です"],["か"],["。"]]},{"verse":6,"text":"それは、「アブラハムは神を信じた。それは彼の義と認められた」と言われているとおりです。","tok":[["それ"],["は"],["、"],["「"],["アブラハム"],["は"],["神","かみ"],["を"],["信じた","しんじた"],["。"],["それ"],["は"],["彼","かれ"],["の"],["義","ぎ"],["と"],["認められた","みとめられた"],["」"],["と"],["言われて","いわれて"],["いる"],["とおり"],["です"],["。"]]},{"verse":7,"text":"だから、信仰によって生きる人々こそ、アブラハムの子であるとわきまえなさい。","tok":[["だ"],["から"],["、"],["信仰","しんこう"],["によって"],["生きる","いきる"],["人々","ひとびと"],["こそ"],["、"],["アブラハム"],["の"],["子","こ"],["で"],["ある"],["と"],["わきまえ"],["なさい"],["。"]]},{"verse":8,"text":"聖書は、神が異邦人を信仰によって義となさることを見越して、「あなたのゆえに異邦人は皆祝福される」という福音をアブラハムに予告しました。","tok":[["聖書","せいしょ"],["は"],["、"],["神","かみ"],["が"],["異邦人","いほうじん"],["を"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["なさる"],["こと"],["を"],["見越して","みこして"],["、"],["「"],["あなた"],["の"],["ゆえ"],["に"],["異邦人","いほうじん"],["は"],["皆","みな"],["祝福","しゅくふく"],["される"],["」"],["と"],["いう"],["福音","ふくいん"],["を"],["アブラハム"],["に"],["予告","よこく"],["しました"],["。"]]},{"verse":9,"text":"それで、信仰によって生きる人々は、信仰の人アブラハムと共に祝福されています。","tok":[["それ"],["で"],["、"],["信仰","しんこう"],["によって"],["生きる","いきる"],["人々","ひとびと"],["は"],["、"],["信仰","しんこう"],["の"],["人","ひと"],["アブラハム"],["と"],["共","とも"],["に"],["祝福","しゅくふく"],["されて"],["います"],["。"]]},{"verse":10,"text":"律法の実行に頼る者はだれでも、呪われています。「律法の書に書かれているすべての事を絶えず守らない者は皆、呪われている」と書いてあるからです。","tok":[["律法","りっぽう"],["の"],["実行","じっこう"],["に"],["頼る","たよる"],["者","もの"],["は"],["だれ"],["で"],["も"],["、"],["呪われて","のろわれて"],["います"],["。"],["「"],["律法","りっぽう"],["の"],["書","しょ"],["に"],["書かれて","かかれて"],["いる"],["すべて"],["の"],["事","こと"],["を"],["絶えず","たえず"],["守らない","まもらない"],["者","もの"],["は"],["皆","みな"],["、"],["呪われて","のろわれて"],["いる"],["」"],["と"],["書いて","かいて"],["ある"],["から"],["です"],["。"]]},{"verse":11,"text":"律法によってはだれも神の御前で義とされないことは、明らかです。なぜなら、「正しい者は信仰によって生きる」からです。","tok":[["律法","りっぽう"],["によって"],["は"],["だれ"],["も"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["義","ぎ"],["と"],["されない"],["こと"],["は"],["、"],["明らか","あきらか"],["です"],["。"],["なぜ"],["なら"],["、"],["「"],["正しい","ただしい"],["者","もの"],["は"],["信仰","しんこう"],["によって"],["生きる","いきる"],["」"],["から"],["です"],["。"]]},{"verse":12,"text":"律法は、信仰をよりどころとしていません。「律法の定めを果たす者は、その定めによって生きる」のです。","tok":[["律法","りっぽう"],["は"],["、"],["信仰","しんこう"],["を"],["よりどころ"],["として"],["いません"],["。"],["「"],["律法","りっぽう"],["の"],["定め","さだめ"],["を"],["果たす","はたす"],["者","もの"],["は"],["、"],["その"],["定め","さだめ"],["によって"],["生きる","いきる"],["」"],["の"],["です"],["。"]]},{"verse":13,"text":"キリストは、わたしたちのために呪いとなって、わたしたちを律法の呪いから贖い出してくださいました。「木にかけられた者は皆呪われている」と書いてあるからです。","tok":[["キリスト"],["は"],["、"],["わたしたち"],["の"],["ため"],["に"],["呪い","のろい"],["と"],["なって"],["、"],["わたしたち"],["を"],["律法","りっぽう"],["の"],["呪い","のろい"],["から"],["贖い","あがない"],["出して","だして"],["くださいました"],["。"],["「"],["木","き"],["に"],["かけられた"],["者","もの"],["は"],["皆","みな"],["呪われて","のろわれて"],["いる"],["」"],["と"],["書いて","かいて"],["ある"],["から"],["です"],["。"]]},{"verse":14,"text":"それは、アブラハムに与えられた祝福が、キリスト‧イエスにおいて異邦人に及ぶためであり、また、わたしたちが、約束された“霊”を信仰によって受けるためでした。","tok":[["それ"],["は"],["、"],["アブラハム"],["に"],["与えられた","あたえられた"],["祝福","しゅくふく"],["が"],["、"],["キリスト"],["‧"],["イエス"],["に"],["おいて"],["異邦人","いほうじん"],["に"],["及ぶ","およぶ"],["ため"],["で"],["あり"],["、"],["また"],["、"],["わたしたち"],["が"],["、"],["約束","やくそく"],["された"],["“"],["霊","れい"],["”"],["を"],["信仰","しんこう"],["によって"],["受ける","うける"],["ため"],["でした"],["。"]]},{"verse":15,"text":"兄弟たち、分かりやすく説明しましょう。人の作った遺言でさえ、法律的に有効となったら、だれも無効にしたり、それに追加したりはできません。","tok":[["兄弟","きょうだい"],["たち"],["、"],["分かり","わかり"],["やすく"],["説明","せつめい"],["しましょう"],["。"],["人","ひと"],["の"],["作った","つくった"],["遺言","ゆいごん"],["で"],["さえ"],["、"],["法律的","ほうりつてき"],["に"],["有効","ゆうこう"],["と"],["なったら"],["、"],["だれ"],["も"],["無効","むこう"],["に"],["し"],["たり"],["、"],["それ"],["に"],["追加","ついか"],["し"],["たり"],["は"],["できません"],["。"]]},{"verse":16,"text":"ところで、アブラハムとその子孫に対して約束が告げられましたが、その際、多くの人を指して「子孫たちとに」とは言われず、一人の人を指して「あなたの子孫とに」と言われています。この「子孫」とは、キリストのことです。","tok":[["ところ"],["で"],["、"],["アブラハム"],["と"],["その"],["子孫","しそん"],["に対して","にたいして"],["約束","やくそく"],["が"],["告げられました","つげられました"],["が"],["、"],["その"],["際","さい"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["指して","さして"],["「"],["子孫","しそん"],["たち"],["と"],["に"],["」"],["と"],["は"],["言われず","いわれず"],["、"],["一人","ひとり"],["の"],["人","ひと"],["を"],["指して","さして"],["「"],["あなた"],["の"],["子孫","しそん"],["と"],["に"],["」"],["と"],["言われて","いわれて"],["います"],["。"],["この"],["「"],["子孫","しそん"],["」"],["と"],["は"],["、"],["キリスト"],["の"],["こと"],["です"],["。"]]},{"verse":17,"text":"わたしが言いたいのは、こうです。神によってあらかじめ有効なものと定められた契約を、それから四百三十年後にできた律法が無効にして、その約束を反故にすることはないということです。","tok":[["わたし"],["が"],["言いたい","いいたい"],["の"],["は"],["、"],["こう"],["です"],["。"],["神","かみ"],["によって"],["あらかじめ"],["有効","ゆうこう"],["な"],["もの"],["と"],["定められた","さだめられた"],["契約","けいやく"],["を"],["、"],["それ"],["から"],["四百三十","よんひゃくさんじゅう"],["年後","ねんご"],["に"],["できた"],["律法","りっぽう"],["が"],["無効","むこう"],["に"],["して"],["、"],["その"],["約束","やくそく"],["を"],["反故","ほご"],["に"],["する"],["こと"],["は"],["ない"],["と"],["いう"],["こと"],["です"],["。"]]},{"verse":18,"text":"相続が律法に由来するものなら、もはや、それは約束に由来するものではありません。しかし神は、約束によってアブラハムにその恵みをお与えになったのです。","tok":[["相続","そうぞく"],["が"],["律法","りっぽう"],["に"],["由来","ゆらい"],["する"],["もの"],["なら"],["、"],["もはや"],["、"],["それ"],["は"],["約束","やくそく"],["に"],["由来","ゆらい"],["する"],["もの"],["で"],["は"],["ありません"],["。"],["しかし"],["神","かみ"],["は"],["、"],["約束","やくそく"],["によって"],["アブラハム"],["に"],["その"],["恵み","めぐみ"],["を"],["お与え","おあたえ"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":19,"text":"では、律法とはいったい何か。律法は、約束を与えられたあの子孫が来られるときまで、違犯を明らかにするために付け加えられたもので、天使たちを通し、仲介者の手を経て制定されたものです。","tok":[["で"],["は"],["、"],["律法","りっぽう"],["と"],["は"],["いったい"],["何","なん"],["か"],["。"],["律法","りっぽう"],["は"],["、"],["約束","やくそく"],["を"],["与えられた","あたえられた"],["あの"],["子孫","しそん"],["が"],["来られる","こられる"],["とき"],["まで"],["、"],["違犯","いはん"],["を"],["明らか","あきらか"],["に"],["する"],["ため"],["に"],["付け加えられた","つけくわえられた"],["もの"],["で"],["、"],["天使","てんし"],["たち"],["を"],["通し","とおし"],["、"],["仲介者","ちゅうかいしゃ"],["の"],["手","て"],["を"],["経て","へて"],["制定","せいてい"],["された"],["もの"],["です"],["。"]]},{"verse":20,"text":"仲介者というものは、一人で事を行う場合には要りません。約束の場合、神はひとりで事を運ばれたのです。","tok":[["仲介者","ちゅうかいしゃ"],["と"],["いう"],["もの"],["は"],["、"],["一人","ひとり"],["で"],["事","こと"],["を"],["行う","おこなう"],["場合","ばあい"],["に"],["は"],["要りません","いりません"],["。"],["約束","やくそく"],["の"],["場合","ばあい"],["、"],["神","かみ"],["は"],["ひとり"],["で"],["事","こと"],["を"],["運ばれた","はこばれた"],["の"],["です"],["。"]]},{"verse":21,"text":"それでは、律法は神の約束に反するものなのでしょうか。決してそうではない。万一、人を生かすことができる律法が与えられたとするなら、確かに人は律法によって義とされたでしょう。","tok":[["それ"],["で"],["は"],["、"],["律法","りっぽう"],["は"],["神","かみ"],["の"],["約束","やくそく"],["に"],["反する","はんする"],["もの"],["な"],["の"],["でしょう"],["か"],["。"],["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"],["万一","まんいち"],["、"],["人","ひと"],["を"],["生かす","いかす"],["こと"],["が"],["できる"],["律法","りっぽう"],["が"],["与えられた","あたえられた"],["と"],["するなら"],["、"],["確か","たしか"],["に"],["人","ひと"],["は"],["律法","りっぽう"],["によって"],["義","ぎ"],["と"],["されたでしょう"],["。"]]},{"verse":22,"text":"しかし、聖書はすべてのものを罪の支配下に閉じ込めたのです。それは、神の約束が、イエス‧キリストへの信仰によって、信じる人々に与えられるようになるためでした。","tok":[["しかし"],["、"],["聖書","せいしょ"],["は"],["すべて"],["の"],["もの"],["を"],["罪","つみ"],["の"],["支配下","しはいか"],["に"],["閉じ込めた","とじこめた"],["の"],["です"],["。"],["それ"],["は"],["、"],["神","かみ"],["の"],["約束","やくそく"],["が"],["、"],["イエス"],["‧"],["キリスト"],["へ"],["の"],["信仰","しんこう"],["によって"],["、"],["信じる","しんじる"],["人々","ひとびと"],["に"],["与えられる","あたえられる"],["よう"],["に"],["なる"],["ため"],["でした"],["。"]]},{"verse":23,"text":"信仰が現れる前には、わたしたちは律法の下で監視され、この信仰が啓示されるようになるまで閉じ込められていました。","tok":[["信仰","しんこう"],["が"],["現れる","あらわれる"],["前","まえ"],["に"],["は"],["、"],["わたしたち"],["は"],["律法","りっぽう"],["の"],["下","もと"],["で"],["監視","かんし"],["され"],["、"],["この"],["信仰","しんこう"],["が"],["啓示","けいじ"],["される"],["よう"],["に"],["なる"],["まで"],["閉じ込められて","とじこめられて"],["いました"],["。"]]},{"verse":24,"text":"こうして律法は、わたしたちをキリストのもとへ導く養育係となったのです。わたしたちが信仰によって義とされるためです。","tok":[["こう"],["して"],["律法","りっぽう"],["は"],["、"],["わたしたち"],["を"],["キリスト"],["の"],["もと"],["へ"],["導く","みちびく"],["養育","よういく"],["係","かかり"],["と"],["なった"],["の"],["です"],["。"],["わたしたち"],["が"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["される"],["ため"],["です"],["。"]]},{"verse":25,"text":"しかし、信仰が現れたので、もはや、わたしたちはこのような養育係の下にはいません。","tok":[["しかし"],["、"],["信仰","しんこう"],["が"],["現れた","あらわれた"],["ので"],["、"],["もはや"],["、"],["わたしたち"],["は"],["この"],["よう"],["な"],["養育","よういく"],["係","かかり"],["の"],["下","した"],["に"],["は"],["いません"],["。"]]},{"verse":26,"text":"あなたがたは皆、信仰により、キリスト‧イエスに結ばれて神の子なのです。","tok":[["あなた"],["がた"],["は"],["皆","みな"],["、"],["信仰","しんこう"],["に"],["より"],["、"],["キリスト"],["‧"],["イエス"],["に"],["結ばれて","むすばれて"],["神","かみ"],["の"],["子","こ"],["な"],["の"],["です"],["。"]]},{"verse":27,"text":"洗礼を受けてキリストに結ばれたあなたがたは皆、キリストを着ているからです。","tok":[["洗礼","せんれい"],["を"],["受けて","うけて"],["キリスト"],["に"],["結ばれた","むすばれた"],["あなた"],["がた"],["は"],["皆","みな"],["、"],["キリスト"],["を"],["着て","きて"],["いる"],["から"],["です"],["。"]]},{"verse":28,"text":"そこではもはや、ユダヤ人もギリシア人もなく、奴隷も自由な身分の者もなく、男も女もありません。あなたがたは皆、キリスト‧イエスにおいて一つだからです。","tok":[["そこ"],["で"],["は"],["もはや"],["、"],["ユダヤ人","ゆだやじん"],["も"],["ギリシア"],["人","にん"],["も"],["なく"],["、"],["奴隷","どれい"],["も"],["自由","じゆう"],["な"],["身分","みぶん"],["の"],["者","もの"],["も"],["なく"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["ありません"],["。"],["あなた"],["がた"],["は"],["皆","みな"],["、"],["キリスト"],["‧"],["イエス"],["に"],["おいて"],["一","ひと"],["つ"],["だ"],["から"],["です"],["。"]]},{"verse":29,"text":"あなたがたは、もしキリストのものだとするなら、とりもなおさず、アブラハムの子孫であり、約束による相続人です。","tok":[["あなた"],["がた"],["は"],["、"],["もし"],["キリスト"],["の"],["もの"],["だ"],["と"],["するなら"],["、"],["とり"],["も"],["なおさず"],["、"],["アブラハム"],["の"],["子孫","しそん"],["で"],["あり"],["、"],["約束","やくそく"],["に"],["よる"],["相続人","そうぞくにん"],["です"],["。"]]}]
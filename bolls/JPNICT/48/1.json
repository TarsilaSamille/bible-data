[{"verse":1,"text":"人々からでもなく、人を通してでもなく、イエス‧キリストと、キリストを死者の中から復活させた父である神とによって使徒とされたパウロ、","tok":[["人々","ひとびと"],["から"],["で"],["も"],["なく"],["、"],["人","ひと"],["を"],["通して","とおして"],["で"],["も"],["なく"],["、"],["イエス"],["‧"],["キリスト"],["と"],["、"],["キリスト"],["を"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["させた"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["によって"],["使徒","しと"],["と"],["された"],["パウロ"],["、"]]},{"verse":2,"text":"ならびに、わたしと一緒にいる兄弟一同から、ガラテヤ地方の諸教会へ。","tok":[["ならびに"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["いる"],["兄弟","きょうだい"],["一同","いちどう"],["から"],["、"],["ガラテヤ"],["地方","ちほう"],["の"],["諸教","しょきょう"],["会","かい"],["へ"],["。"]]},{"verse":3,"text":"わたしたちの父である神と、主イエス‧キリストの恵みと平和が、あなたがたにあるように。","tok":[["わたしたち"],["の"],["父","ちち"],["で"],["ある"],["神","かみ"],["と"],["、"],["主","しゅ"],["イエス"],["‧"],["キリスト"],["の"],["恵み","めぐみ"],["と"],["平和","へいわ"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"]]},{"verse":4,"text":"キリストは、わたしたちの神であり父である方の御心に従い、この悪の世からわたしたちを救い出そうとして、御自身をわたしたちの罪のために献げてくださったのです。","tok":[["キリスト"],["は"],["、"],["わたしたち"],["の"],["神","かみ"],["で"],["あり"],["父","ちち"],["で"],["ある"],["方","かた"],["の"],["御心","おこころ"],["に"],["従い","したがい"],["、"],["この"],["悪","あく"],["の"],["世","よ"],["から"],["わたしたち"],["を"],["救い出そう","すくいだそう"],["として"],["、"],["御自身","ごじしん"],["を"],["わたしたち"],["の"],["罪","つみ"],["の"],["ため"],["に"],["献げて","ささげて"],["くださった"],["の"],["です"],["。"]]},{"verse":5,"text":"わたしたちの神であり父である方に世々限りなく栄光がありますように、アーメン。","tok":[["わたしたち"],["の"],["神","かみ"],["で"],["あり"],["父","ちち"],["で"],["ある"],["方","かた"],["に"],["世々","せいせい"],["限りなく","かぎりなく"],["栄光","えいこう"],["が"],["あります"],["よう"],["に"],["、"],["アーメン"],["。"]]},{"verse":6,"text":"キリストの恵みへ招いてくださった方から、あなたがたがこんなにも早く離れて、ほかの福音に乗り換えようとしていることに、わたしはあきれ果てています。","tok":[["キリスト"],["の"],["恵み","めぐみ"],["へ"],["招いて","まねいて"],["くださった"],["方","ほう"],["から"],["、"],["あなた"],["がた"],["が"],["こんな"],["に"],["も"],["早く","はやく"],["離れて","はなれて"],["、"],["ほか"],["の"],["福音","ふくいん"],["に"],["乗り換えよう","のりかえよう"],["として"],["いる"],["こと"],["に"],["、"],["わたし"],["は"],["あきれ"],["果てて","はてて"],["います"],["。"]]},{"verse":7,"text":"ほかの福音といっても、もう一つ別の福音があるわけではなく、ある人々があなたがたを惑わし、キリストの福音を覆そうとしているにすぎないのです。","tok":[["ほか"],["の"],["福音","ふくいん"],["と"],["いって"],["も"],["、"],["もう"],["一","ひと"],["つ"],["別","べつ"],["の"],["福音","ふくいん"],["が"],["ある"],["わけ"],["で"],["は"],["なく"],["、"],["ある"],["人々","ひとびと"],["が"],["あなた"],["がた"],["を"],["惑わし","まどわし"],["、"],["キリスト"],["の"],["福音","ふくいん"],["を"],["覆そう","くつがえそう"],["として"],["いる"],["に"],["すぎない"],["の"],["です"],["。"]]},{"verse":8,"text":"しかし、たとえわたしたち自身であれ、天使であれ、わたしたちがあなたがたに告げ知らせたものに反する福音を告げ知らせようとするならば、呪われるがよい。","tok":[["しかし"],["、"],["たとえ"],["わたしたち"],["自身","じしん"],["で"],["あれ"],["、"],["天使","てんし"],["で"],["あれ"],["、"],["わたしたち"],["が"],["あなた"],["がた"],["に"],["告げ知らせた","つげしらせた"],["もの"],["に"],["反する","はんする"],["福音","ふくいん"],["を"],["告げ知らせよう","つげしらせよう"],["と"],["するならば"],["、"],["呪われる","のろわれる"],["が"],["よい"],["。"]]},{"verse":9,"text":"わたしたちが前にも言っておいたように、今また、わたしは繰り返して言います。あなたがたが受けたものに反する福音を告げ知らせる者がいれば、呪われるがよい。","tok":[["わたしたち"],["が"],["前","まえ"],["に"],["も"],["言って","いって"],["おいた"],["よう"],["に"],["、"],["今","いま"],["また"],["、"],["わたし"],["は"],["繰り返して","くりかえして"],["言います","いいます"],["。"],["あなた"],["がた"],["が"],["受けた","うけた"],["もの"],["に"],["反する","はんする"],["福音","ふくいん"],["を"],["告げ知らせる","つげしらせる"],["者","もの"],["が"],["いれば"],["、"],["呪われる","のろわれる"],["が"],["よい"],["。"]]},{"verse":10,"text":"こんなことを言って、今わたしは人に取り入ろうとしているのでしょうか。それとも、神に取り入ろうとしているのでしょうか。あるいは、何とかして人の気に入ろうとあくせくしているのでしょうか。もし、今なお人の気に入ろうとしているなら、わたしはキリストの僕ではありません。","tok":[["こんな"],["こと"],["を"],["言って","いって"],["、"],["今","いま"],["わたし"],["は"],["人","ひと"],["に"],["取り入ろう","とりいろう"],["として"],["いる"],["の"],["でしょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["神","かみ"],["に"],["取り入ろう","とりいろう"],["として"],["いる"],["の"],["でしょう"],["か"],["。"],["あるいは"],["、"],["何","なん"],["と"],["か"],["して"],["人","ひと"],["の"],["気","き"],["に"],["入ろう","いろう"],["と"],["あくせく"],["して"],["いる"],["の"],["でしょう"],["か"],["。"],["もし"],["、"],["今","いま"],["な"],["お人","おひと"],["の"],["気","き"],["に"],["入ろう","いろう"],["として"],["いるなら"],["、"],["わたし"],["は"],["キリスト"],["の"],["僕","ぼく"],["で"],["は"],["ありません"],["。"]]},{"verse":11,"text":"兄弟たち、あなたがたにはっきり言います。わたしが告げ知らせた福音は、人によるものではありません。","tok":[["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["に"],["はっきり"],["言います","いいます"],["。"],["わたし"],["が"],["告げ知らせた","つげしらせた"],["福音","ふくいん"],["は"],["、"],["人","ひと"],["に"],["よる"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":12,"text":"わたしはこの福音を人から受けたのでも教えられたのでもなく、イエス‧キリストの啓示によって知らされたのです。","tok":[["わたし"],["は"],["この"],["福音","ふくいん"],["を"],["人","ひと"],["から"],["受けた","うけた"],["ので"],["も"],["教えられた","おしえられた"],["ので"],["も"],["なく"],["、"],["イエス"],["‧"],["キリスト"],["の"],["啓示","けいじ"],["によって"],["知らされた","しらされた"],["の"],["です"],["。"]]},{"verse":13,"text":"あなたがたは、わたしがかつてユダヤ教徒としてどのようにふるまっていたかを聞いています。わたしは、徹底的に神の教会を迫害し、滅ぼそうとしていました。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["かつて"],["ユダヤ教","ゆだやきょう"],["徒","と"],["として"],["どの"],["よう"],["に"],["ふるまって"],["いた"],["か"],["を"],["聞いて","きいて"],["います"],["。"],["わたし"],["は"],["、"],["徹底的","てっていてき"],["に"],["神","かみ"],["の"],["教会","きょうかい"],["を"],["迫害","はくがい"],["し"],["、"],["滅ぼそう","ほろぼそう"],["として"],["いました"],["。"]]},{"verse":14,"text":"また、先祖からの伝承を守るのに人一倍熱心で、同胞の間では同じ年ごろの多くの者よりもユダヤ教に徹しようとしていました。","tok":[["また"],["、"],["先祖","せんぞ"],["から"],["の"],["伝承","でんしょう"],["を"],["守る","まもる"],["のに"],["人一倍","ひといちばい"],["熱心","ねっしん"],["で"],["、"],["同胞","どうほう"],["の"],["間","あいだ"],["で"],["は"],["同じ","おなじ"],["年ごろ","としごろ"],["の"],["多く","おおく"],["の"],["者","もの"],["より"],["も"],["ユダヤ教","ゆだやきょう"],["に"],["徹しよう","てっしよう"],["として"],["いました"],["。"]]},{"verse":15,"text":"しかし、わたしを母の胎内にあるときから選び分け、恵みによって召し出してくださった神が、御心のままに、","tok":[["しかし"],["、"],["わたし"],["を"],["母","はは"],["の"],["胎内","たいない"],["に"],["ある"],["とき"],["から"],["選び分け","えらびわけ"],["、"],["恵み","めぐみ"],["によって"],["召し出して","めしだして"],["くださった"],["神","かみ"],["が"],["、"],["御心","おこころ"],["の"],["まま"],["に"],["、"]]},{"verse":16,"text":"御子をわたしに示して、その福音を異邦人に告げ知らせるようにされたとき、わたしは、すぐ血肉に相談するようなことはせず、","tok":[["御子","みこ"],["を"],["わたし"],["に"],["示して","しめして"],["、"],["その"],["福音","ふくいん"],["を"],["異邦人","いほうじん"],["に"],["告げ知らせる","つげしらせる"],["よう"],["に"],["された"],["とき"],["、"],["わたし"],["は"],["、"],["すぐ"],["血肉","けつにく"],["に"],["相談","そうだん"],["する"],["よう"],["な"],["こと"],["は"],["せず"],["、"]]},{"verse":17,"text":"また、エルサレムに上って、わたしより先に使徒として召された人たちのもとに行くこともせず、アラビアに退いて、そこから再びダマスコに戻ったのでした。","tok":[["また"],["、"],["エルサレム"],["に"],["上って","のぼって"],["、"],["わたし"],["より"],["先","さき"],["に"],["使徒","しと"],["として"],["召された","めされた"],["人","ひと"],["たち"],["の"],["もと"],["に"],["行く","いく"],["こと"],["も"],["せず"],["、"],["アラビア"],["に"],["退いて","しりぞいて"],["、"],["そこ"],["から"],["再び","ふたたび"],["ダマスコ"],["に"],["戻った","もどった"],["の"],["でした"],["。"]]},{"verse":18,"text":"それから三年後、ケファと知り合いになろうとしてエルサレムに上り、十五日間彼のもとに滞在しましたが、","tok":[["それ"],["から"],["三","さん"],["年後","ねんご"],["、"],["ケファ"],["と"],["知り合い","しりあい"],["に"],["なろう"],["として"],["エルサレム"],["に"],["上り","のぼり"],["、"],["十五","じゅうご"],["日間","かかん"],["彼","かれ"],["の"],["もと"],["に"],["滞在","たいざい"],["しました"],["が"],["、"]]},{"verse":19,"text":"ほかの使徒にはだれにも会わず、ただ主の兄弟ヤコブにだけ会いました。","tok":[["ほか"],["の"],["使徒","しと"],["に"],["は"],["だれ"],["に"],["も"],["会わず","あわず"],["、"],["ただ"],["主","ぬし"],["の"],["兄弟","きょうだい"],["ヤコブ"],["に"],["だけ"],["会いました","あいました"],["。"]]},{"verse":20,"text":"わたしがこのように書いていることは、神の御前で断言しますが、うそをついているのではありません。","tok":[["わたし"],["が"],["この"],["よう"],["に"],["書いて","かいて"],["いる"],["こと"],["は"],["、"],["神","かみ"],["の"],["御前","ごぜん"],["で"],["断言","だんげん"],["します"],["が"],["、"],["うそ"],["を"],["ついて"],["いる"],["ので"],["は"],["ありません"],["。"]]},{"verse":21,"text":"その後、わたしはシリアおよびキリキアの地方へ行きました。","tok":[["その"],["後","ご"],["、"],["わたし"],["は"],["シリア"],["および"],["キリキア"],["の"],["地方","ちほう"],["へ"],["行きました","いきました"],["。"]]},{"verse":22,"text":"キリストに結ばれているユダヤの諸教会の人々とは、顔見知りではありませんでした。","tok":[["キリスト"],["に"],["結ばれて","むすばれて"],["いる"],["ユダヤ"],["の"],["諸教","しょきょう"],["会","かい"],["の"],["人々","ひとびと"],["と"],["は"],["、"],["顔","かお"],["見知り","みしり"],["で"],["は"],["ありませんでした"],["。"]]},{"verse":23,"text":"ただ彼らは、「かつて我々を迫害した者が、あの当時滅ぼそうとしていた信仰を、今は福音として告げ知らせている」と聞いて、","tok":[["ただ"],["彼","かれ"],["ら"],["は"],["、"],["「"],["かつて"],["我々","われわれ"],["を"],["迫害","はくがい"],["した"],["者","もの"],["が"],["、"],["あの"],["当時","とうじ"],["滅ぼそう","ほろぼそう"],["として"],["いた"],["信仰","しんこう"],["を"],["、"],["今","いま"],["は"],["福音","ふくいん"],["として"],["告げ知らせて","つげしらせて"],["いる"],["」"],["と"],["聞いて","きいて"],["、"]]},{"verse":24,"text":"わたしのことで神をほめたたえておりました。","tok":[["わたし"],["の"],["こと"],["で"],["神","かみ"],["を"],["ほめたたえて"],["おりました"],["。"]]}]
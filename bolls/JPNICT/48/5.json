[{"verse":1,"text":"この自由を得させるために、キリストはわたしたちを自由の身にしてくださったのです。だから、しっかりしなさい。奴隷の軛に二度とつながれてはなりません。","tok":[["この"],["自由","じゆう"],["を"],["得させる","えさせる"],["ため"],["に"],["、"],["キリスト"],["は"],["わたしたち"],["を"],["自由","じゆう"],["の"],["身","み"],["に"],["して"],["くださった"],["の"],["です"],["。"],["だ"],["から"],["、"],["しっかり"],["し"],["なさい"],["。"],["奴隷","どれい"],["の"],["軛","くびき"],["に"],["二","に"],["度","ど"],["と"],["つながれて"],["は"],["なりません"],["。"]]},{"verse":2,"text":"ここで、わたしパウロはあなたがたに断言します。もし割礼を受けるなら、あなたがたにとってキリストは何の役にも立たない方になります。","tok":[["ここ"],["で"],["、"],["わたし"],["パウロ"],["は"],["あなた"],["がた"],["に"],["断言","だんげん"],["します"],["。"],["もし"],["割礼","かつれい"],["を"],["受けるなら","うけるなら"],["、"],["あなた"],["がた"],["にとって"],["キリスト"],["は"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立たない","たたない"],["方","かた"],["に"],["なります"],["。"]]},{"verse":3,"text":"割礼を受ける人すべてに、もう一度はっきり言います。そういう人は律法全体を行う義務があるのです。","tok":[["割礼","かつれい"],["を"],["受ける","うける"],["人","ひと"],["すべて"],["に"],["、"],["もう"],["一度","いちど"],["はっきり"],["言います","いいます"],["。"],["そう"],["いう"],["人","ひと"],["は"],["律法","りっぽう"],["全体","ぜんたい"],["を"],["行う","おこなう"],["義務","ぎむ"],["が"],["ある"],["の"],["です"],["。"]]},{"verse":4,"text":"律法によって義とされようとするなら、あなたがたはだれであろうと、キリストとは縁もゆかりもない者とされ、いただいた恵みも失います。","tok":[["律法","りっぽう"],["によって"],["義","ぎ"],["と"],["されよう"],["と"],["するなら"],["、"],["あなた"],["がた"],["は"],["だれ"],["で"],["あろう"],["と"],["、"],["キリスト"],["と"],["は"],["縁","えん"],["も"],["ゆかり"],["も"],["ない"],["者","もの"],["と"],["され"],["、"],["いただいた"],["恵み","めぐみ"],["も"],["失います","うしないます"],["。"]]},{"verse":5,"text":"わたしたちは、義とされた者の希望が実現することを、“霊”により、信仰に基づいて切に待ち望んでいるのです。","tok":[["わたしたち"],["は"],["、"],["義","ぎ"],["と"],["された"],["者","もの"],["の"],["希望","きぼう"],["が"],["実現","じつげん"],["する"],["こと"],["を"],["、"],["“"],["霊","れい"],["”"],["に"],["より"],["、"],["信仰","しんこう"],["に"],["基づいて","もとづいて"],["切に","せつに"],["待ち望んで","まちのぞんで"],["いる"],["の"],["です"],["。"]]},{"verse":6,"text":"キリスト‧イエスに結ばれていれば、割礼の有無は問題ではなく、愛の実践を伴う信仰こそ大切です。","tok":[["キリスト"],["‧"],["イエス"],["に"],["結ばれて","むすばれて"],["いれば"],["、"],["割礼","かつれい"],["の"],["有無","うむ"],["は"],["問題","もんだい"],["で"],["は"],["なく"],["、"],["愛","あい"],["の"],["実践","じっせん"],["を"],["伴う","ともなう"],["信仰","しんこう"],["こそ"],["大切","たいせつ"],["です"],["。"]]},{"verse":7,"text":"あなたがたは、よく走っていました。それなのに、いったいだれが邪魔をして真理に従わないようにさせたのですか。","tok":[["あなた"],["がた"],["は"],["、"],["よく"],["走って","はしって"],["いました"],["。"],["それ"],["な"],["のに"],["、"],["いったい"],["だれ"],["が"],["邪魔","じゃま"],["を"],["して"],["真理","しんり"],["に"],["従わない","したがわない"],["よう"],["に"],["させた"],["の"],["です"],["か"],["。"]]},{"verse":8,"text":"このような誘いは、あなたがたを召し出しておられる方からのものではありません。","tok":[["この"],["よう"],["な"],["誘い","さそい"],["は"],["、"],["あなた"],["がた"],["を"],["召し出して","めしだして"],["おられる"],["方","かた"],["から"],["の"],["もの"],["で"],["は"],["ありません"],["。"]]},{"verse":9,"text":"わずかなパン種が練り粉全体を膨らませるのです。","tok":[["わずか"],["な"],["パン種","ぱんだね"],["が"],["練り粉","ねりこ"],["全体","ぜんたい"],["を"],["膨らませる","ふくらませる"],["の"],["です"],["。"]]},{"verse":10,"text":"あなたがたが決して別な考えを持つことはないと、わたしは主をよりどころとしてあなたがたを信頼しています。あなたがたを惑わす者は、だれであろうと、裁きを受けます。","tok":[["あなた"],["がた"],["が"],["決して","けっして"],["別","べつ"],["な"],["考え","かんがえ"],["を"],["持つ","もつ"],["こと"],["は"],["ない"],["と"],["、"],["わたし"],["は"],["主","ぬし"],["を"],["よりどころ"],["として"],["あなた"],["がた"],["を"],["信頼","しんらい"],["して"],["います"],["。"],["あなた"],["がた"],["を"],["惑わす","まどわす"],["者","もの"],["は"],["、"],["だれ"],["で"],["あろう"],["と"],["、"],["裁き","さばき"],["を"],["受けます","うけます"],["。"]]},{"verse":11,"text":"兄弟たち、このわたしが、今なお割礼を宣べ伝えているとするならば、今なお迫害を受けているのは、なぜですか。そのようなことを宣べ伝えれば、十字架のつまずきもなくなっていたことでしょう。","tok":[["兄弟","きょうだい"],["たち"],["、"],["この"],["わたし"],["が"],["、"],["今","いま"],["なお"],["割礼","かつれい"],["を"],["宣べ伝えて","のべつたえて"],["いる"],["と"],["するならば"],["、"],["今","いま"],["なお"],["迫害","はくがい"],["を"],["受けて","うけて"],["いる"],["の"],["は"],["、"],["なぜ"],["です"],["か"],["。"],["その"],["よう"],["な"],["こと"],["を"],["宣べ伝えれば","のべつたえれば"],["、"],["十字架","じゅうじか"],["の"],["つまずき"],["も"],["なくなって"],["いた"],["こと"],["でしょう"],["。"]]},{"verse":12,"text":"あなたがたをかき乱す者たちは、いっそのこと自ら去勢してしまえばよい。","tok":[["あなた"],["がた"],["を"],["かき乱す","かきみだす"],["者","もの"],["たち"],["は"],["、"],["いっそ"],["の"],["こと"],["自ら","みずから"],["去勢","きょせい"],["して"],["しまえば"],["よい"],["。"]]},{"verse":13,"text":"兄弟たち、あなたがたは、自由を得るために召し出されたのです。ただ、この自由を、肉に罪を犯させる機会とせずに、愛によって互いに仕えなさい。","tok":[["兄弟","きょうだい"],["たち"],["、"],["あなた"],["がた"],["は"],["、"],["自由","じゆう"],["を"],["得る","える"],["ため"],["に"],["召し出された","めしだされた"],["の"],["です"],["。"],["ただ"],["、"],["この"],["自由","じゆう"],["を"],["、"],["肉","にく"],["に"],["罪","つみ"],["を"],["犯させる","おかさせる"],["機会","きかい"],["と"],["せず"],["に"],["、"],["愛","あい"],["によって"],["互い","たがい"],["に"],["仕え","つかえ"],["なさい"],["。"]]},{"verse":14,"text":"律法全体は、「隣人を自分のように愛しなさい」という一句によって全うされるからです。","tok":[["律法","りっぽう"],["全体","ぜんたい"],["は"],["、"],["「"],["隣人","りんじん"],["を"],["自分","じぶん"],["の"],["よう"],["に"],["愛し","あいし"],["なさい"],["」"],["と"],["いう"],["一句","いっく"],["によって"],["全う","まっとう"],["される"],["から"],["です"],["。"]]},{"verse":15,"text":"だが、互いにかみ合い、共食いしているのなら、互いに滅ぼされないように注意しなさい。","tok":[["だ"],["が"],["、"],["互い","たがい"],["に"],["かみ合い","かみあい"],["、"],["共食い","ともぐい"],["して"],["いる"],["の"],["なら"],["、"],["互い","たがい"],["に"],["滅ぼされない","ほろぼされない"],["よう"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"]]},{"verse":16,"text":"わたしが言いたいのは、こういうことです。霊の導きに従って歩みなさい。そうすれば、決して肉の欲望を満足させるようなことはありません。","tok":[["わたし"],["が"],["言いたい","いいたい"],["の"],["は"],["、"],["こう"],["いう"],["こと"],["です"],["。"],["霊","れい"],["の"],["導き","みちびき"],["に"],["従って","したがって"],["歩み","あゆみ"],["なさい"],["。"],["そう"],["すれば"],["、"],["決して","けっして"],["肉","にく"],["の"],["欲望","よくぼう"],["を"],["満足","まんぞく"],["させる"],["よう"],["な"],["こと"],["は"],["ありません"],["。"]]},{"verse":17,"text":"肉の望むところは、霊に反し、霊の望むところは、肉に反するからです。肉と霊とが対立し合っているので、あなたがたは、自分のしたいと思うことができないのです。","tok":[["肉","にく"],["の"],["望む","のぞむ"],["ところ"],["は"],["、"],["霊","れい"],["に"],["反し","はんし"],["、"],["霊","れい"],["の"],["望む","のぞむ"],["ところ"],["は"],["、"],["肉","にく"],["に"],["反する","はんする"],["から"],["です"],["。"],["肉","にく"],["と"],["霊","れい"],["と"],["が"],["対立","たいりつ"],["し"],["合って","あって"],["いる"],["ので"],["、"],["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["の"],["したい"],["と"],["思う","おもう"],["こと"],["が"],["できない"],["の"],["です"],["。"]]},{"verse":18,"text":"しかし、霊に導かれているなら、あなたがたは、律法の下にはいません。","tok":[["しかし"],["、"],["霊","れい"],["に"],["導かれて","みちびかれて"],["いるなら"],["、"],["あなた"],["がた"],["は"],["、"],["律法","りっぽう"],["の"],["下","した"],["に"],["は"],["いません"],["。"]]},{"verse":19,"text":"肉の業は明らかです。それは、姦淫、わいせつ、好色、","tok":[["肉","にく"],["の"],["業","ごう"],["は"],["明らか","あきらか"],["です"],["。"],["それ"],["は"],["、"],["姦淫","かんいん"],["、"],["わいせつ"],["、"],["好色","こうしょく"],["、"]]},{"verse":20,"text":"偶像礼拝、魔術、敵意、争い、そねみ、怒り、利己心、不和、仲間争い、","tok":[["偶像","ぐうぞう"],["礼拝","れいはい"],["、"],["魔術","まじゅつ"],["、"],["敵意","てきい"],["、"],["争い","あらそい"],["、"],["そねみ"],["、"],["怒り","いかり"],["、"],["利己心","りこしん"],["、"],["不和","ふわ"],["、"],["仲間","なかま"],["争い","あらそい"],["、"]]},{"verse":21,"text":"ねたみ、泥酔、酒宴、その他このたぐいのものです。以前言っておいたように、ここでも前もって言いますが、このようなことを行う者は、神の国を受け継ぐことはできません。","tok":[["ねたみ"],["、"],["泥酔","でいすい"],["、"],["酒宴","しゅえん"],["、"],["その"],["他","た"],["この"],["たぐい"],["の"],["もの"],["です"],["。"],["以前","いぜん"],["言って","いって"],["おいた"],["よう"],["に"],["、"],["ここ"],["で"],["も"],["前もって","まえもって"],["言います","いいます"],["が"],["、"],["この"],["よう"],["な"],["こと"],["を"],["行う","おこなう"],["者","もの"],["は"],["、"],["神","かみ"],["の"],["国","くに"],["を"],["受け継ぐ","うけつぐ"],["こと"],["は"],["できません"],["。"]]},{"verse":22,"text":"これに対して、霊の結ぶ実は愛であり、喜び、平和、寛容、親切、善意、誠実、","tok":[["これ"],["に対して","にたいして"],["、"],["霊","れい"],["の"],["結ぶ","むすぶ"],["実","じつ"],["は"],["愛","あい"],["で"],["あり"],["、"],["喜び","よろこび"],["、"],["平和","へいわ"],["、"],["寛容","かんよう"],["、"],["親切","しんせつ"],["、"],["善意","ぜんい"],["、"],["誠実","せいじつ"],["、"]]},{"verse":23,"text":"柔和、節制です。これらを禁じる掟はありません。","tok":[["柔和","にゅうわ"],["、"],["節制","せっせい"],["です"],["。"],["これ"],["ら"],["を"],["禁じる","きんじる"],["掟","おきて"],["は"],["ありません"],["。"]]},{"verse":24,"text":"キリスト‧イエスのものとなった人たちは、肉を欲情や欲望もろとも十字架につけてしまったのです。","tok":[["キリスト"],["‧"],["イエス"],["の"],["もの"],["と"],["なった"],["人","ひと"],["たち"],["は"],["、"],["肉","にく"],["を"],["欲情","よくじょう"],["や"],["欲望","よくぼう"],["もろとも"],["十字架","じゅうじか"],["に"],["つけて"],["しまった"],["の"],["です"],["。"]]},{"verse":25,"text":"わたしたちは、霊の導きに従って生きているなら、霊の導きに従ってまた前進しましょう。","tok":[["わたしたち"],["は"],["、"],["霊","れい"],["の"],["導き","みちびき"],["に"],["従って","したがって"],["生きて","いきて"],["いるなら"],["、"],["霊","れい"],["の"],["導き","みちびき"],["に"],["従って","したがって"],["また"],["前進","ぜんしん"],["しましょう"],["。"]]},{"v
[{"verse":1,"text":"その後十四年たってから、わたしはバルナバと一緒にエルサレムに再び上りました。その際、テトスも連れて行きました。","tok":[["その"],["後","ご"],["十四","じゅうよん"],["年","ねん"],["たって"],["から"],["、"],["わたし"],["は"],["バルナバ"],["と"],["一緒","いっしょ"],["に"],["エルサレム"],["に"],["再び","ふたたび"],["上りました","のぼりました"],["。"],["その"],["際","さい"],["、"],["テトス"],["も"],["連れて","つれて"],["行きました","いきました"],["。"]]},{"verse":2,"text":"エルサレムに上ったのは、啓示によるものでした。わたしは、自分が異邦人に宣べ伝えている福音について、人々に、とりわけ、おもだった人たちには個人的に話して、自分は無駄に走っているのではないか、あるいは走ったのではないかと意見を求めました。","tok":[["エルサレム"],["に"],["上った","のぼった"],["の"],["は"],["、"],["啓示","けいじ"],["に"],["よる"],["もの"],["でした"],["。"],["わたし"],["は"],["、"],["自分","じぶん"],["が"],["異邦人","いほうじん"],["に"],["宣べ伝えて","のべつたえて"],["いる"],["福音","ふくいん"],["について"],["、"],["人々","ひとびと"],["に"],["、"],["とりわけ"],["、"],["おも"],["だった"],["人","ひと"],["たち"],["に"],["は"],["個人的","こじんてき"],["に"],["話して","はなして"],["、"],["自分","じぶん"],["は"],["無駄","むだ"],["に"],["走って","はしって"],["いる"],["ので"],["は"],["ない"],["か"],["、"],["あるいは"],["走った","はしった"],["ので"],["は"],["ない"],["か"],["と"],["意見","いけん"],["を"],["求めました","もとめました"],["。"]]},{"verse":3,"text":"しかし、わたしと同行したテトスでさえ、ギリシア人であったのに、割礼を受けることを強制されませんでした。","tok":[["しかし"],["、"],["わたし"],["と"],["同行","どうこう"],["した"],["テトス"],["で"],["さえ"],["、"],["ギリシア"],["人","にん"],["で"],["あった"],["のに"],["、"],["割礼","かつれい"],["を"],["受ける","うける"],["こと"],["を"],["強制","きょうせい"],["されませんでした"],["。"]]},{"verse":4,"text":"潜り込んで来た偽の兄弟たちがいたのに、強制されなかったのです。彼らは、わたしたちを奴隷にしようとして、わたしたちがキリスト‧イエスによって得ている自由を付けねらい、こっそり入り込んで来たのでした。","tok":[["潜り込んで","もぐりこんで"],["来た","きた"],["偽","にせ"],["の"],["兄弟","きょうだい"],["たち"],["が"],["いた"],["のに"],["、"],["強制","きょうせい"],["されなかった"],["の"],["です"],["。"],["彼","かれ"],["ら"],["は"],["、"],["わたしたち"],["を"],["奴隷","どれい"],["に"],["しよう"],["として"],["、"],["わたしたち"],["が"],["キリスト"],["‧"],["イエス"],["によって"],["得て","えて"],["いる"],["自由","じゆう"],["を"],["付けねらい","つけねらい"],["、"],["こっそり"],["入り込んで","はいりこんで"],["来た","きた"],["の"],["でした"],["。"]]},{"verse":5,"text":"福音の真理が、あなたがたのもとにいつもとどまっているように、わたしたちは、片ときもそのような者たちに屈服して譲歩するようなことはしませんでした。","tok":[["福音","ふくいん"],["の"],["真理","しんり"],["が"],["、"],["あなた"],["がた"],["の"],["もと"],["に"],["いつも"],["とどまって"],["いる"],["よう"],["に"],["、"],["わたしたち"],["は"],["、"],["片とき","かたとき"],["も"],["その"],["よう"],["な"],["者","もの"],["たち"],["に"],["屈服","くっぷく"],["して"],["譲歩","じょうほ"],["する"],["よう"],["な"],["こと"],["は"],["しませんでした"],["。"]]},{"verse":6,"text":"おもだった人たちからも強制されませんでした。――この人たちがそもそもどんな人であったにせよ、それは、わたしにはどうでもよいことです。神は人を分け隔てなさいません。――実際、そのおもだった人たちは、わたしにどんな義務も負わせませんでした。","tok":[["おも"],["だった"],["人","ひと"],["たち"],["から"],["も"],["強制","きょうせい"],["されませんでした"],["。"],["―"],["―"],["この"],["人","ひと"],["たち"],["が"],["そもそも"],["どんな"],["人","ひと"],["で"],["あった"],["に"],["せよ"],["、"],["それ"],["は"],["、"],["わたし"],["に"],["は"],["どう"],["で"],["も"],["よい"],["こと"],["です"],["。"],["神","かみ"],["は"],["人","ひと"],["を"],["分け隔て","わけへだて"],["なさいません"],["。"],["―"],["―"],["実際","じっさい"],["、"],["その"],["おも"],["だった"],["人","ひと"],["たち"],["は"],["、"],["わたし"],["に"],["どんな"],["義務","ぎむ"],["も"],["負わせませんでした","おわせませんでした"],["。"]]},{"verse":7,"text":"それどころか、彼らは、ペトロには割礼を受けた人々に対する福音が任されたように、わたしには割礼を受けていない人々に対する福音が任されていることを知りました。","tok":[["それ"],["どころ"],["か"],["、"],["彼","かれ"],["ら"],["は"],["、"],["ペトロ"],["に"],["は"],["割礼","かつれい"],["を"],["受けた","うけた"],["人々","ひとびと"],["に"],["対する","たいする"],["福音","ふくいん"],["が"],["任された","まかされた"],["よう"],["に"],["、"],["わたし"],["に"],["は"],["割礼","かつれい"],["を"],["受けて","うけて"],["いない"],["人々","ひとびと"],["に"],["対する","たいする"],["福音","ふくいん"],["が"],["任されて","まかされて"],["いる"],["こと"],["を"],["知りました","しりました"],["。"]]},{"verse":8,"text":"割礼を受けた人々に対する使徒としての任務のためにペトロに働きかけた方は、異邦人に対する使徒としての任務のためにわたしにも働きかけられたのです。","tok":[["割礼","かつれい"],["を"],["受けた","うけた"],["人々","ひとびと"],["に"],["対する","たいする"],["使徒","しと"],["として"],["の"],["任務","にんむ"],["の"],["ため"],["に"],["ペトロ"],["に"],["働きかけた","はたらきかけた"],["方","ほう"],["は"],["、"],["異邦人","いほうじん"],["に"],["対する","たいする"],["使徒","しと"],["として"],["の"],["任務","にんむ"],["の"],["ため"],["に"],["わたし"],["に"],["も"],["働きかけられた","はたらきかけられた"],["の"],["です"],["。"]]},{"verse":9,"text":"また、彼らはわたしに与えられた恵みを認め、ヤコブとケファとヨハネ、つまり柱と目されるおもだった人たちは、わたしとバルナバに一致のしるしとして右手を差し出しました。それで、わたしたちは異邦人へ、彼らは割礼を受けた人々のところに行くことになったのです。","tok":[["また"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["与えられた","あたえられた"],["恵み","めぐみ"],["を"],["認め","みとめ"],["、"],["ヤコブ"],["と"],["ケファ"],["と"],["ヨハネ"],["、"],["つまり"],["柱","はしら"],["と"],["目される","もくされる"],["おも"],["だった"],["人","ひと"],["たち"],["は"],["、"],["わたし"],["と"],["バルナバ"],["に"],["一致","いっち"],["の"],["しるし"],["として"],["右手","みぎて"],["を"],["差し出しました","さしだしました"],["。"],["それ"],["で"],["、"],["わたしたち"],["は"],["異邦人","いほうじん"],["へ"],["、"],["彼","かれ"],["ら"],["は"],["割礼","かつれい"],["を"],["受けた","うけた"],["人々","ひとびと"],["の"],["ところ"],["に"],["行く","いく"],["こと"],["に"],["なった"],["の"],["です"],["。"]]},{"verse":10,"text":"ただ、わたしたちが貧しい人たちのことを忘れないようにとのことでしたが、これは、ちょうどわたしも心がけてきた点です。","tok":[["ただ"],["、"],["わたしたち"],["が"],["貧しい","まずしい"],["人","ひと"],["たち"],["の"],["こと"],["を"],["忘れない","わすれない"],["よう"],["に"],["と"],["の"],["こと"],["でした"],["が"],["、"],["これ"],["は"],["、"],["ちょうど"],["わたし"],["も"],["心がけて","こころがけて"],["きた"],["点","てん"],["です"],["。"]]},{"verse":11,"text":"さて、ケファがアンティオキアに来たとき、非難すべきところがあったので、わたしは面と向かって反対しました。","tok":[["さて"],["、"],["ケファ"],["が"],["アンティオキア"],["に"],["来た","きた"],["とき"],["、"],["非難","ひなん"],["すべき"],["ところ"],["が"],["あった"],["ので"],["、"],["わたし"],["は"],["面","めん"],["と"],["向かって","むかって"],["反対","はんたい"],["しました"],["。"]]},{"verse":12,"text":"なぜなら、ケファは、ヤコブのもとからある人々が来るまでは、異邦人と一緒に食事をしていたのに、彼らがやって来ると、割礼を受けている者たちを恐れてしり込みし、身を引こうとしだしたからです。","tok":[["なぜ"],["なら"],["、"],["ケファ"],["は"],["、"],["ヤコブ"],["の"],["もと"],["から"],["ある"],["人々","ひとびと"],["が"],["来る","くる"],["まで"],["は"],["、"],["異邦人","いほうじん"],["と"],["一緒","いっしょ"],["に"],["食事","しょくじ"],["を"],["して"],["いた"],["のに"],["、"],["彼","かれ"],["ら"],["が"],["やって"],["来る","くる"],["と"],["、"],["割礼","かつれい"],["を"],["受けて","うけて"],["いる"],["者","もの"],["たち"],["を"],["恐れて","おそれて"],["しり込み","しりごみ"],["し"],["、"],["身","み"],["を"],["引こう","ひこう"],["と"],["し"],["だした"],["から"],["です"],["。"]]},{"verse":13,"text":"そして、ほかのユダヤ人も、ケファと一緒にこのような心にもないことを行い、バルナバさえも彼らの見せかけの行いに引きずり込まれてしまいました。","tok":[["そして"],["、"],["ほか"],["の"],["ユダヤ人","ゆだやじん"],["も"],["、"],["ケファ"],["と"],["一緒","いっしょ"],["に"],["この"],["よう"],["な"],["心","こころ"],["に"],["も"],["ない"],["こと"],["を"],["行い","おこない"],["、"],["バルナバ"],["さえ"],["も"],["彼","かれ"],["ら"],["の"],["見せかけ","みせかけ"],["の"],["行い","おこない"],["に"],["引きずり","ひきずり"],["込まれて","こまれて"],["しまいました"],["。"]]},{"verse":14,"text":"しかし、わたしは、彼らが福音の真理にのっとってまっすぐ歩いていないのを見たとき、皆の前でケファに向かってこう言いました。「あなたはユダヤ人でありながら、ユダヤ人らしい生き方をしないで、異邦人のように生活しているのに、どうして異邦人にユダヤ人のように生活することを強要するのですか。」","tok":[["しかし"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["福音","ふくいん"],["の"],["真理","しんり"],["に"],["のっとって"],["まっすぐ"],["歩いて","あるいて"],["いない"],["の"],["を"],["見た","みた"],["とき"],["、"],["皆","みな"],["の"],["前","まえ"],["で"],["ケファ"],["に"],["向かって","むかって"],["こう"],["言いました","いいました"],["。"],["「"],["あなた"],["は"],["ユダヤ人","ゆだやじん"],["で"],["あり"],["ながら"],["、"],["ユダヤ人","ゆだやじん"],["らしい"],["生き方","いきかた"],["を"],["しないで"],["、"],["異邦人","いほうじん"],["の"],["よう"],["に"],["生活","せいかつ"],["して"],["いる"],["のに"],["、"],["どう"],["して"],["異邦人","いほうじん"],["に"],["ユダヤ人","ゆだやじん"],["の"],["よう"],["に"],["生活","せいかつ"],["する"],["こと"],["を"],["強要","きょうよう"],["する"],["の"],["です"],["か"],["。"],["」"]]},{"verse":15,"text":"わたしたちは生まれながらのユダヤ人であって、異邦人のような罪人ではありません。","tok":[["わたしたち"],["は"],["生まれ","うまれ"],["ながら"],["の"],["ユダヤ人","ゆだやじん"],["で"],["あって"],["、"],["異邦人","いほうじん"],["の"],["よう"],["な"],["罪人","ざいにん"],["で"],["は"],["ありません"],["。"]]},{"verse":16,"text":"けれども、人は律法の実行ではなく、ただイエス‧キリストへの信仰によって義とされると知って、わたしたちもキリスト‧イエスを信じました。これは、律法の実行ではなく、キリストへの信仰によって義としていただくためでした。なぜなら、律法の実行によっては、だれ一人として義とされないからです。","tok":[["けれど"],["も"],["、"],["人","ひと"],["は"],["律法","りっぽう"],["の"],["実行","じっこう"],["で"],["は"],["なく"],["、"],["ただ"],["イエス"],["‧"],["キリスト"],["へ"],["の"],["信仰","しんこう"],["によって"],["義","ぎ"],["と"],["される"],["と"],["知って","しって"],["、"],["わたしたち"],["も"],["キリスト"],["‧"],["イエス"],["を"],["信じました","しんじました"],["。"],["これ"],["は"],["、"],["律法","りっぽう"],["の"],["実行","じっこう"],["で"],["は"],["なく"],["、"],["キリスト"],["へ"],["の"],["信仰","しんこう"],["によって"],["義","ぎ"],["として"],["いただく"],["ため"],["でした"],["。"],["なぜ"],["なら"],["、"],["律法","りっぽう"],["の"],["実行","じっこう"],["によって"],["は"],["、"],["だれ"],["一人","ひとり"],["として"],["義","ぎ"],["と"],["されない"],["から"],["です"],["。"]]},{"verse":17,"text":"もしわたしたちが、キリストによって義とされるように努めながら、自分自身も罪人であるなら、キリストは罪に仕える者ということになるのでしょうか。決してそうではない。","tok":[["もし"],["わたしたち"],["が"],["、"],["キリスト"],["によって"],["義","ぎ"],["と"],["される"],["よう"],["に"],["努め","つとめ"],["ながら"],["、"],["自分","じぶん"],["自身","じしん"],["も"],["罪人","ざいにん"],["で"],["あるなら"],["、"],["キリスト"],["は"],["罪","つみ"],["に"],["仕える","つかえる"],["者","もの"],["と"],["いう"],["こと"],["に"],["なる"],["の"],["でしょう"],["か"],["。"],["決して","けっして"],["そう"],["で"],["は"],["ない"],["。"]]},{"verse":18,"text":"もし自分で打ち壊したものを再び建てるとすれば、わたしは自分が違犯者であると証明することになります。","tok":[["もし"],["自分","じぶん"],["で"],["打ち壊した","ぶちこわした"],["もの"],["を"],["再び","ふたたび"],["建てる","たてる"],["と"],["すれば"],["、"],["わたし"],["は"],["自分","じぶん"],["が"],["違犯者","いはんしゃ"],["で"],["ある"],["と"],["証明","しょうめい"],["する"],["こと"],["に"],["なります"],["。"]]},{"verse":19,"text":"わたしは神に対して生きるために、律法に対しては律法によって死んだのです。わたしは、キリストと共に十字架につけられています。","tok":[["わたし"],["は"],["神","かみ"],["に対して","にたいして"],["生きる","いきる"],["ため"],["に"],["、"],["律法","りっぽう"],["に対して","にたいして"],["は"],["律法","りっぽう"],["によって"],["死んだ","しんだ"],["の"],["です"],["。"],["わたし"],["は"],["、"],["キリスト"],["と"],["共","とも"],["に"],["十字架","じゅうじか"],["に"],["つけられて"],["います"],["。"]]},{"verse":20,"text":"生きているのは、もはやわたしではありません。キリストがわたしの内に生きておられるのです。わたしが今、肉において生きているのは、わたしを愛し、わたしのために身を献げられた神の子に対する信仰によるものです。","tok":[["生きて","いきて"],["いる"],["の"],["は"],["、"],["もはや"],["わたし"],["で"],["は"],["ありません"],["。"],["キリスト"],["が"],["わたし"],["の"],["内","うち"],["に"],["生きて","いきて"],["おられる"],["の"],["です"],["。"],["わたし"],["が"],["今","いま"],["、"],["肉","にく"],["に"],["おいて"],["生きて","いきて"],["いる"],["の"],["は"],["、"],["わたし"],["を"],["愛し","あいし"],["、"],["わたし"],["の"],["ため"],["に"],["身","み"],["を"],["献げられた","ささげられた"],["神","かみ"],["の"],["子","こ"],["に"],["対する","たいする"],["信仰","しんこう"],["に"],["よる"],["もの"],["です"],["。"]]},{"verse":21,"text":"わたしは、神の恵みを無にはしません。もし、人が律法のお陰で義とされるとすれば、それこそ、キリストの死は無意味になってしまいます。","tok":[["わたし"],["は"],["、"],["神","かみ"],["の"],["恵み","めぐみ"],["を"],["無","む"],["に"],["は"],["しません"],["。"],["もし"],["、"],["人","ひと"],["が"],["律法","りっぽう"],["の"],["お陰","おかげ"],["で"],["義","ぎ"],["と"],["される"],["と"],["すれば"],["、"],["それ"],["こそ"],["、"],["キリスト"],["の"],["死","し"],["は"],["無意味","むいみ"],["に"],["なって"],["しまいます"],["。"]]}]
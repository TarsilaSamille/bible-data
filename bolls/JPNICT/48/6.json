[{"verse":1,"text":"兄弟たち、万一だれかが不注意にも何かの罪に陥ったなら、“霊”に導かれて生きているあなたがたは、そういう人を柔和な心で正しい道に立ち帰らせなさい。あなた自身も誘惑されないように、自分に気をつけなさい。","tok":[["兄弟","きょうだい"],["たち"],["、"],["万一","まんいち"],["だれ"],["か"],["が"],["不注意","ふちゅうい"],["に"],["も"],["何","なん"],["か"],["の"],["罪","つみ"],["に"],["陥ったなら","おちいったなら"],["、"],["“"],["霊","れい"],["”"],["に"],["導かれて","みちびかれて"],["生きて","いきて"],["いる"],["あなた"],["がた"],["は"],["、"],["そう"],["いう"],["人","ひと"],["を"],["柔和","にゅうわ"],["な"],["心","こころ"],["で"],["正しい","ただしい"],["道","みち"],["に"],["立ち帰らせ","たちかえらせ"],["なさい"],["。"],["あなた"],["自身","じしん"],["も"],["誘惑","ゆうわく"],["されない"],["よう"],["に"],["、"],["自分","じぶん"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":2,"text":"互いに重荷を担いなさい。そのようにしてこそ、キリストの律法を全うすることになるのです。","tok":[["互い","たがい"],["に"],["重荷","おもに"],["を"],["担い","にない"],["なさい"],["。"],["その"],["よう"],["に"],["して"],["こそ"],["、"],["キリスト"],["の"],["律法","りっぽう"],["を"],["全う","まっとう"],["する"],["こと"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":3,"text":"実際には何者でもないのに、自分をひとかどの者だと思う人がいるなら、その人は自分自身を欺いています。","tok":[["実際","じっさい"],["に"],["は"],["何者","なにもの"],["で"],["も"],["ない"],["のに"],["、"],["自分","じぶん"],["を"],["ひとかど"],["の"],["者","もの"],["だ"],["と"],["思う","おもう"],["人","ひと"],["が"],["いるなら"],["、"],["その"],["人","ひと"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["欺いて","あざむいて"],["います"],["。"]]},{"verse":4,"text":"各自で、自分の行いを吟味してみなさい。そうすれば、自分に対してだけは誇れるとしても、他人に対しては誇ることができないでしょう。","tok":[["各自","かくじ"],["で"],["、"],["自分","じぶん"],["の"],["行い","おこない"],["を"],["吟味","ぎんみ"],["して"],["み"],["なさい"],["。"],["そう"],["すれば"],["、"],["自分","じぶん"],["に対して","にたいして"],["だけ"],["は"],["誇れる","ほこれる"],["として"],["も"],["、"],["他人","たにん"],["に"],["対し","たいし"],["ては"],["誇る","ほこる"],["こと"],["が"],["できないでしょう"],["。"]]},{"verse":5,"text":"めいめいが、自分の重荷を担うべきです。","tok":[["めいめい"],["が"],["、"],["自分","じぶん"],["の"],["重荷","おもに"],["を"],["担うべきです","になうべきです"],["。"]]},{"verse":6,"text":"御言葉を教えてもらう人は、教えてくれる人と持ち物をすべて分かち合いなさい。","tok":[["御言葉","おことば"],["を"],["教えて","おしえて"],["もらう"],["人","ひと"],["は"],["、"],["教えて","おしえて"],["くれる"],["人","ひと"],["と"],["持ち物","もちもの"],["を"],["すべて"],["分かち合い","わかちあい"],["なさい"],["。"]]},{"verse":7,"text":"思い違いをしてはいけません。神は、人から侮られることはありません。人は、自分の蒔いたものを、また刈り取ることになるのです。","tok":[["思い違い","おもいちがい"],["を"],["して"],["は"],["いけません"],["。"],["神","かみ"],["は"],["、"],["人","ひと"],["から"],["侮られる","あなどられる"],["こと"],["は"],["ありません"],["。"],["人","ひと"],["は"],["、"],["自分","じぶん"],["の"],["蒔いた","まいた"],["もの"],["を"],["、"],["また"],["刈り取る","かりとる"],["こと"],["に"],["なる"],["の"],["です"],["。"]]},{"verse":8,"text":"自分の肉に蒔く者は、肉から滅びを刈り取り、霊に蒔く者は、霊から永遠の命を刈り取ります。","tok":[["自分","じぶん"],["の"],["肉","にく"],["に"],["蒔く","まく"],["者","もの"],["は"],["、"],["肉","にく"],["から"],["滅び","ほろび"],["を"],["刈り取り","かりとり"],["、"],["霊","れい"],["に"],["蒔く","まく"],["者","もの"],["は"],["、"],["霊","れい"],["から"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["刈り取ります","かりとります"],["。"]]},{"verse":9,"text":"たゆまず善を行いましょう。飽きずに励んでいれば、時が来て、実を刈り取ることになります。","tok":[["たゆまず"],["善","ぜん"],["を"],["行いましょう","おこないましょう"],["。"],["飽きず","あきず"],["に"],["励んで","はげんで"],["いれば"],["、"],["時","とき"],["が"],["来て","きて"],["、"],["実","じつ"],["を"],["刈り取る","かりとる"],["こと"],["に"],["なります"],["。"]]},{"verse":10,"text":"ですから、今、時のある間に、すべての人に対して、特に信仰によって家族になった人々に対して、善を行いましょう。","tok":[["です"],["から"],["、"],["今","いま"],["、"],["時","とき"],["の"],["ある"],["間","あいだ"],["に"],["、"],["すべて"],["の"],["人","ひと"],["に対して","にたいして"],["、"],["特に","とくに"],["信仰","しんこう"],["によって"],["家族","かぞく"],["に"],["なった"],["人々","ひとびと"],["に対して","にたいして"],["、"],["善","ぜん"],["を"],["行いましょう","おこないましょう"],["。"]]},{"verse":11,"text":"このとおり、わたしは今こんなに大きな字で、自分の手であなたがたに書いています。","tok":[["この"],["とおり"],["、"],["わたし"],["は"],["今","いま"],["こんな"],["に"],["大きな","おおきな"],["字","じ"],["で"],["、"],["自分","じぶん"],["の"],["手","て"],["で"],["あなた"],["がた"],["に"],["書いて","かいて"],["います"],["。"]]},{"verse":12,"text":"肉において人からよく思われたがっている者たちが、ただキリストの十字架のゆえに迫害されたくないばかりに、あなたがたに無理やり割礼を受けさせようとしています。","tok":[["肉","にく"],["に"],["おいて"],["人","ひと"],["から"],["よく"],["思われたがって","おもわれたがって"],["いる"],["者","もの"],["たち"],["が"],["、"],["ただ"],["キリスト"],["の"],["十字架","じゅうじか"],["の"],["ゆえ"],["に"],["迫害","はくがい"],["されたく"],["ない"],["ばかり"],["に"],["、"],["あなた"],["がた"],["に"],["無理やり","むりやり"],["割礼","かつれい"],["を"],["受けさせよう","うけさせよう"],["として"],["います"],["。"]]},{"verse":13,"text":"割礼を受けている者自身、実は律法を守っていませんが、あなたがたの肉について誇りたいために、あなたがたにも割礼を望んでいます。","tok":[["割礼","かつれい"],["を"],["受けて","うけて"],["いる"],["者","もの"],["自身","じしん"],["、"],["実","じつ"],["は"],["律法","りっぽう"],["を"],["守って","まもって"],["いません"],["が"],["、"],["あなた"],["がた"],["の"],["肉","にく"],["について"],["誇りたい","ほこりたい"],["ため"],["に"],["、"],["あなた"],["がた"],["に"],["も"],["割礼","かつれい"],["を"],["望んで","のぞんで"],["います"],["。"]]},{"verse":14,"text":"しかし、このわたしには、わたしたちの主イエス‧キリストの十字架のほかに、誇るものが決してあってはなりません。この十字架によって、世はわたしに対し、わたしは世に対してはりつけにされているのです。","tok":[["しかし"],["、"],["この"],["わたし"],["に"],["は"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["十字架","じゅうじか"],["の"],["ほか"],["に"],["、"],["誇る","ほこる"],["もの"],["が"],["決して","けっして"],["あって"],["は"],["なりません"],["。"],["この"],["十字架","じゅうじか"],["によって"],["、"],["世","よ"],["は"],["わたし"],["に"],["対し","たいし"],["、"],["わたし"],["は"],["世","よ"],["に対して","にたいして"],["はりつけ"],["に"],["されて"],["いる"],["の"],["です"],["。"]]},{"verse":15,"text":"割礼の有無は問題ではなく、大切なのは、新しく創造されることです。","tok":[["割礼","かつれい"],["の"],["有無","うむ"],["は"],["問題","もんだい"],["で"],["は"],["なく"],["、"],["大切","たいせつ"],["な"],["の"],["は"],["、"],["新しく","あたらしく"],["創造","そうぞう"],["される"],["こと"],["です"],["。"]]},{"verse":16,"text":"このような原理に従って生きていく人の上に、つまり、神のイスラエルの上に平和と憐れみがあるように。","tok":[["この"],["よう"],["な"],["原理","げんり"],["に"],["従って","したがって"],["生きて","いきて"],["いく"],["人","ひと"],["の"],["上","うえ"],["に"],["、"],["つまり"],["、"],["神","かみ"],["の"],["イスラエル"],["の"],["上","うえ"],["に"],["平和","へいわ"],["と"],["憐れみ","あわれみ"],["が"],["ある"],["よう"],["に"],["。"]]},{"verse":17,"text":"これからは、だれもわたしを煩わさないでほしい。わたしは、イエスの焼き印を身に受けているのです。","tok":[["これ"],["から"],["は"],["、"],["だれ"],["も"],["わたし"],["を"],["煩わさないで","わずらわさないで"],["ほしい"],["。"],["わたし"],["は"],["、"],["イエス"],["の"],["焼き印","やきいん"],["を"],["身","み"],["に"],["受けて","うけて"],["いる"],["の"],["です"],["。"]]},{"verse":18,"text":"兄弟たち、わたしたちの主イエス‧キリストの恵みが、あなたがたの霊と共にあるように、アーメン。","tok":[["兄弟","きょうだい"],["たち"],["、"],["わたしたち"],["の"],["主","ぬし"],["イエス"],["‧"],["キリスト"],["の"],["恵み","めぐみ"],["が"],["、"],["あなた"],["がた"],["の"],["霊","れい"],["と"],["共","とも"],["に"],["ある"],["よう"],["に"],["、"],["アーメン"],["。"]]}]
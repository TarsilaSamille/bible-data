[{"verse":1,"text":"災いだ、流血の町は。町のすべては偽りに覆われ、略奪に満ち人を餌食にすることをやめない。","tok":[["災い","わざわい"],["だ"],["、"],["流血","りゅうけつ"],["の"],["町","まち"],["は"],["。"],["町","まち"],["の"],["すべて"],["は"],["偽り","いつわり"],["に"],["覆われ","おおわれ"],["、"],["略奪","りゃくだつ"],["に"],["満ち","みち"],["人","ひと"],["を"],["餌食","えじき"],["に"],["する"],["こと"],["を"],["やめない"],["。"]]},{"verse":2,"text":"鞭の音、車輪の響く音突進する馬、跳び駆ける戦車。","tok":[["鞭","むち"],["の"],["音","おと"],["、"],["車輪","しゃりん"],["の"],["響く","ひびく"],["音","おと"],["突進","とっしん"],["する"],["馬","うま"],["、"],["跳び","とび"],["駆ける","かける"],["戦車","せんしゃ"],["。"]]},{"verse":3,"text":"騎兵は突撃し剣はきらめき、槍はひらめく。倒れる者はおびただしくしかばねは山をなし、死体は数えきれない。人々は味方の死体につまずく。","tok":[["騎兵","きへい"],["は"],["突撃","とつげき"],["し"],["剣","けん"],["は"],["きらめき"],["、"],["槍","やり"],["は"],["ひらめく"],["。"],["倒れる","たおれる"],["者","もの"],["は"],["おびただしく"],["しかばね"],["は"],["山","やま"],["を"],["なし"],["、"],["死体","したい"],["は"],["数え","かぞえ"],["きれない"],["。"],["人々","ひとびと"],["は"],["味方","みかた"],["の"],["死体","したい"],["に"],["つまずく"],["。"]]},{"verse":4,"text":"呪文を唱えるあでやかな遊女の果てしない淫行のゆえに彼女がその呪文によって諸民族を淫行によって国々をとりこにしたゆえに","tok":[["呪文","じゅもん"],["を"],["唱える","となえる"],["あでやか"],["な"],["遊女","ゆうじょ"],["の"],["果てし","はてし"],["ない"],["淫行","いんこう"],["の"],["ゆえ"],["に"],["彼女","かのじょ"],["が"],["その"],["呪文","じゅもん"],["によって"],["諸","しょ"],["民族","みんぞく"],["を"],["淫行","いんこう"],["によって"],["国々","くにぐに"],["を"],["とりこ"],["に"],["した"],["ゆえ"],["に"]]},{"verse":5,"text":"見よ、わたしはお前に立ち向かうと万軍の主は言われる。わたしは、お前の裾を顔の上まで上げ諸国の民にお前の裸をもろもろの王国にお前の恥を見せる。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["に"],["立ち向かう","たちむかう"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["お前","おまえ"],["の"],["裾","すそ"],["を"],["顔","かお"],["の"],["上","うえ"],["まで"],["上げ","あげ"],["諸国","しょこく"],["の"],["民","たみ"],["に"],["お前","おまえ"],["の"],["裸","はだか"],["を"],["もろもろ"],["の"],["王国","おうこく"],["に"],["お前","おまえ"],["の"],["恥","はじ"],["を"],["見せる","みせる"],["。"]]},{"verse":6,"text":"わたしは、お前に憎むべきものを投げつけお前を辱め、見せ物にする。","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["に"],["憎むべき","にくむべき"],["もの"],["を"],["投げつけ","なげつけ"],["お前","おまえ"],["を"],["辱め","はずかしめ"],["、"],["見せ物","みせもの"],["に"],["する"],["。"]]},{"verse":7,"text":"お前を見る者は皆、お前から逃げて言う。「ニネベは破壊された誰が彼女のために嘆くだろうか。」お前を慰める者はどこを探してもいない。","tok":[["お前","おまえ"],["を"],["見る","みる"],["者","もの"],["は"],["皆","みな"],["、"],["お前","おまえ"],["から"],["逃げて","にげて"],["言う","ゆう"],["。"],["「"],["ニネベ"],["は"],["破壊","はかい"],["された"],["誰","だれ"],["が"],["彼女","かのじょ"],["の"],["ため"],["に"],["嘆くだろう","なげくだろう"],["か"],["。"],["」"],["お前","おまえ"],["を"],["慰める","なぐさめる"],["者","もの"],["は"],["どこ"],["を"],["探して","さがして"],["も"],["いない"],["。"]]},{"verse":8,"text":"お前はテーベにまさっているか。ナイルのほとりに座し、水に囲まれ海を砦とし、水を城壁としていたあの町に。","tok":[["お前","おまえ"],["は"],["テーベ"],["に"],["まさって"],["いる"],["か"],["。"],["ナイル"],["の"],["ほとり"],["に"],["座し","ざし"],["、"],["水","みず"],["に"],["囲まれ","かこまれ"],["海","うみ"],["を"],["砦","とりで"],["と"],["し"],["、"],["水","みず"],["を"],["城壁","じょうへき"],["として"],["いた"],["あの"],["町","まち"],["に"],["。"]]},{"verse":9,"text":"クシュはその力エジプトには限りない力がありプト人とリビア人もテーベを助けていた。","tok":[["クシュ"],["は"],["その"],["力","ちから"],["エジプト"],["に"],["は"],["限りない","かぎりない"],["力","ちから"],["が"],["あり"],["プト人","ぷとにん"],["と"],["リビア人","りびあにん"],["も"],["テーベ"],["を"],["助けて","たすけて"],["いた"],["。"]]},{"verse":10,"text":"彼女もまた捕らえられ捕囚として連れ去られた。乳飲み子すら、すべての街角で投げ捨てられ貴族たちはくじで分けられ大いなる者も皆、鎖につながれた。","tok":[["彼女","かのじょ"],["も"],["また"],["捕らえられ","とらえられ"],["捕囚","ほしゅう"],["として"],["連れ去られた","つれさられた"],["。"],["乳飲み子","ちのみご"],["すら"],["、"],["すべて"],["の"],["街角","まちかど"],["で"],["投げ捨てられ","なげすてられ"],["貴族","きぞく"],["たち"],["は"],["くじ"],["で"],["分けられ","わけられ"],["大いなる","おおいなる"],["者","もの"],["も"],["皆","みな"],["、"],["鎖","くさり"],["に"],["つながれた"],["。"]]},{"verse":11,"text":"お前もまた、酔いつぶれて我を失う。お前もまた、敵を避けて逃げ場を求める。","tok":[["お前","おまえ"],["も"],["また"],["、"],["酔いつぶれて","よいつぶれて"],["我","われ"],["を"],["失う","うしなう"],["。"],["お前","おまえ"],["も"],["また"],["、"],["敵","てき"],["を"],["避けて","さけて"],["逃げ場","にげば"],["を"],["求める","もとめる"],["。"]]},{"verse":12,"text":"お前の要塞はどれも初なりの実をつけたいちじくの木だ。揺さぶれば、実が食べる者の口に落ちる。","tok":[["お前","おまえ"],["の"],["要塞","ようさい"],["は"],["どれ"],["も"],["初なり","はつなり"],["の"],["実","じつ"],["を"],["つけた"],["いちじく"],["の"],["木","き"],["だ"],["。"],["揺さぶれば","ゆさぶれば"],["、"],["実","じつ"],[
[{"verse":1,"text":"見よ、良い知らせを伝え平和を告げる者の足は山の上を行く。ユダよ、お前の祭りを祝い、誓願を果たせ。二度と、よこしまな者がお前の土地を侵すことはない。彼らはすべて滅ぼされた。","tok":[["見よ","みよ"],["、"],["良い","よい"],["知らせ","しらせ"],["を"],["伝え","つたえ"],["平和","へいわ"],["を"],["告げる","つげる"],["者","もの"],["の"],["足","あし"],["は"],["山","やま"],["の"],["上","うえ"],["を"],["行く","いく"],["。"],["ユダ"],["よ"],["、"],["お前","おまえ"],["の"],["祭り","まつり"],["を"],["祝い","いわい"],["、"],["誓願","せいがん"],["を"],["果たせ","はたせ"],["。"],["二","に"],["度","ど"],["と"],["、"],["よこしま"],["な"],["者","もの"],["が"],["お前","おまえ"],["の"],["土地","とち"],["を"],["侵す","おかす"],["こと"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["すべて"],["滅ぼされた","ほろぼされた"],["。"]]},{"verse":2,"text":"襲いかかる敵がお前に向かって上ってくる。砦を守り、道を見張れ。腰の帯を締め、力を尽くせ。","tok":[["襲いかかる","おそいかかる"],["敵","てき"],["が"],["お前","おまえ"],["に"],["向かって","むかって"],["上って","のぼって"],["くる"],["。"],["砦","とりで"],["を"],["守り","まもり"],["、"],["道","みち"],["を"],["見張れ","みはれ"],["。"],["腰","こし"],["の"],["帯","おび"],["を"],["締め","しめ"],["、"],["力","ちから"],["を"],["尽くせ","つくせ"],["。"]]},{"verse":3,"text":"主はヤコブの誇りを回復されるイスラエルの誇りも同じように。略奪する者が彼らを略奪しその枝を荒らしはしたが。","tok":[["主","ぬし"],["は"],["ヤコブ"],["の"],["誇り","ほこり"],["を"],["回復","かいふく"],["される"],["イスラエル"],["の"],["誇り","ほこり"],["も"],["同じ","おなじ"],["よう"],["に"],["。"],["略奪","りゃくだつ"],["する"],["者","もの"],["が"],["彼","かれ"],["ら"],["を"],["略奪","りゃくだつ"],["し"],["その"],["枝","えだ"],["を"],["荒らし","あらし"],["は"],["した"],["が"],["。"]]},{"verse":4,"text":"勇士の盾は赤く戦士は緋色の服をまとう。戦の備えをする日に戦車の鋼鉄は火のように輝き槍は揺れる。","tok":[["勇士","ゆうし"],["の"],["盾","たて"],["は"],["赤く","あかく"],["戦士","せんし"],["は"],["緋色","ひいろ"],["の"],["服","ふく"],["を"],["まとう"],["。"],["戦","いくさ"],["の"],["備え","そなえ"],["を"],["する"],["日","ひ"],["に"],["戦車","せんしゃ"],["の"],["鋼鉄","こうてつ"],["は"],["火","ひ"],["の"],["よう"],["に"],["輝き","かがやき"],["槍","やり"],["は"],["揺れる","ゆれる"],["。"]]},{"verse":5,"text":"戦車は通りを狂い走り、広場を突き進む。その様は松明のように輝き稲妻のように走る。","tok":[["戦車","せんしゃ"],["は"],["通り","とおり"],["を"],["狂い","くるい"],["走り","はしり"],["、"],["広場","ひろば"],["を"],["突き進む","つきすすむ"],["。"],["その"],["様","さま"],["は"],["松明","たいまつ"],["の"],["よう"],["に"],["輝き","かがやき"],["稲妻","いなずま"],["の"],["よう"],["に"],["走る","はしる"],["。"]]},{"verse":6,"text":"将軍たちは召集されるが、途上でつまずく。人々は城壁へと急ぎ、防御車を据える。","tok":[["将軍","しょうぐん"],["たち"],["は"],["召集","しょうしゅう"],["される"],["が"],["、"],["途上","とじょう"],["で"],["つまずく"],["。"],["人々","ひとびと"],["は"],["城壁","じょうへき"],["へ"],["と"],["急ぎ","いそぎ"],["、"],["防御車","ぼうぎょしゃ"],["を"],["据える","すえる"],["。"]]},{"verse":7,"text":"流れに面した門は開かれ、宮殿は揺れ動く。","tok":[["流れ","ながれ"],["に"],["面した","めんした"],["門","もん"],["は"],["開かれ","ひらかれ"],["、"],["宮殿","きゅうでん"],["は"],["揺れ動く","ゆれうごく"],["。"]]},{"verse":8,"text":"王妃は引き出され、衣をはがれて連れ去られた。侍女たちは鳩のような声で嘆き、胸を打つ。","tok":[["王妃","おうひ"],["は"],["引き出され","ひきだされ"],["、"],["衣","ころも"],["を"],["はがれて"],["連れ去られた","つれさられた"],["。"],["侍女","じじょ"],["たち"],["は"],["鳩","はと"],["の"],["よう"],["な"],["声","こえ"],["で"],["嘆き","なげき"],["、"],["胸","むね"],["を"],["打つ","うつ"],["。"]]},{"verse":9,"text":"ニネベは、建てられたときから水を集める池のようであった。しかし、水は流れ出して「止まれ、止まれ」と言ってもだれも振り返らない。","tok":[["ニネベ"],["は"],["、"],["建てられた","たてられた"],["とき"],["から"],["水","みず"],["を"],["集める","あつめる"],["池","いけ"],["の"],["よう"],["で"],["あった"],["。"],["しかし"],["、"],["水","みず"],["は"],["流れ出して","ながれだして"],["「"],["止まれ","とまれ"],["、"],["止まれ","とまれ"],["」"],["と"],["言って","いって"],["も"],["だれ"],["も"],["振り返らない","ふりかえらない"],["。"]]},{"verse":10,"text":"「銀を奪え、金を奪え。」その財宝は限りなくあらゆる宝物が溢れている。","tok":[["「"],["銀","ぎん"],["を"],["奪え","うばえ"],["、"],["金","きん"],["を"],["奪え","うばえ"],["。"],["」"],["その"],["財宝","ざいほう"],["は"],["限りなく","かぎりなく"],["あらゆる"],["宝物","たからもの"],["が"],["溢れて","あふれて"],["いる"],["。"]]},{"verse":11,"text":"破壊と荒廃と滅亡が臨み心は挫け、膝は震えすべての人の腰はわななきすべての人の顔はおののきを示した。","tok":[["破壊","はかい"],["と"],["荒廃","こうはい"],["と"],["滅亡","めつぼう"],["が"],["臨み","のぞみ"],["心","しん"],["は"],["挫け","くじけ"],["、"],["膝","ひざ"],["は"],["震え","ふるえ"],["すべて"],["の"],["人","ひと"],["の"],["腰","こし"],["は"],["わななき"],["すべて"],["の"],["人","ひと"],["の"],["顔","かお"],["は"],["おののき"],["を"],["示した","しめした"],["。"]]},{"verse":12,"text":"獅子の住みかはどこにいったのか。それは若獅子の牧場だった。獅子がそこを去り雌獅子と子獅子が残っていても脅かすものは何もなかった。","tok":[["獅子","しし"],["の"],["住みか","すみか"],["は"],["どこ"],["に"],["いった"],["の"],["か"],["。"],["それ"],["は"],["若","わか"],["獅子","しし"],["の"],["牧場","ぼくじょう"],["だった"],["。"],["獅子","しし"],["が"],["そこ"],["を"],["去り","さり"],["雌","めす"],["獅子","しし"],["と"],["子","こ"],["獅子","しし"],["が"],["残って","のこって"],["いて"],["も"],["脅かす","おびやかす"],["もの"],["は"],["何","なん"],["も"],["なかった"],["。"]]},{"verse":13,"text":"獅子は子獅子のために獲物を引き裂き雌獅子のために絞め殺し洞穴を獲物で住みかを引き裂いた肉で満たした。","tok":[["獅子","しし"],["は"],["子","こ"],["獅子","しし"],["の"],["ため"],["に"],["獲物","えもの"],["を"],["引き裂き","ひきさき"],["雌","めす"],["獅子","しし"],["の"],["ため"],["に"],["絞め殺し","しめころし"],["洞穴","ほらあな"],["を"],["獲物","えもの"],["で"],["住みか","すみか"],["を"],["引き裂いた","ひきさいた"],["肉","にく"],["で"],["満たした","みたした"],["。"]]},{"verse":14,"text":"見よ、わたしはお前に立ち向かうと万軍の主は言われる。わたしはお前の戦車を焼いて煙とし剣はお前の若獅子を餌食とする。わたしはお前の獲物をこの地から断つ。お前の使者たちの声はもう聞かれない。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["に"],["立ち向かう","たちむかう"],["と"],["万","まん"],["軍","ぐん"],["の"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["お前","おまえ"],["の"],["戦車","せんしゃ"],["を"],["焼いて","やいて"],["煙","けむり"],["と"],["し"],["剣","けん"],["は"],["お前","おまえ"],["の"],["若","わか"],["獅子","しし"],["を"],["餌食","えじき"],["と"],["する"],["。"],["わたし"],["は"],["お前","おまえ"],["の"],["獲物","えもの"],["を"],["この"],["地","ち"],["から"],["断つ","たつ"],["。"],["お前","おまえ"],["の"],["使者","ししゃ"],["たち"],["の"],["声","こえ"],["は"],["もう"],["聞かれない","きかれない"],["。"]]}]
[{"verse":1,"text":"「人の子よ、あなたはイスラエルの山々に預言して言いなさい。イスラエルの山々よ、主の言葉を聞け。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["イスラエル"],["の"],["山々","やまやま"],["に"],["預言","よげん"],["して"],["言い","いい"],["なさい"],["。"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":2,"text":"主なる神はこう言われる。敵がお前たちに向かって、『ああ、永遠の丘が今や我々の所有となった』と言っている。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["敵","てき"],["が"],["お前","おまえ"],["たち"],["に"],["向かって","むかって"],["、"],["『"],["ああ"],["、"],["永遠","えいえん"],["の"],["丘","おか"],["が"],["今","いま"],["や"],["我々","われわれ"],["の"],["所有","しょゆう"],["と"],["なった"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":3,"text":"それゆえ預言して言いなさい。主なる神はこう言われる。お前たちは周囲の者に荒らされ、踏みにじられ、他の国々の所有となったので、人々の口にのぼり、うわさされるものとなった。","tok":[["それ"],["ゆえ"],["預言","よげん"],["して"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["周囲","しゅうい"],["の"],["者","もの"],["に"],["荒らされ","あらされ"],["、"],["踏みにじられ","ふみにじられ"],["、"],["他","た"],["の"],["国々","くにぐに"],["の"],["所有","しょゆう"],["と"],["なった"],["ので"],["、"],["人々","ひとびと"],["の"],["口","くち"],["に"],["のぼり"],["、"],["うわさ"],["される"],["もの"],["と"],["なった"],["。"]]},{"verse":4,"text":"それゆえ、イスラエルの山々よ、主なる神の言葉を聞け。主なる神は、山と丘、谷と低地、荒れ果てた廃虚、また周囲の他の国々から略奪され侮られ、捨てられた町々に向かってこう言われる。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["、"],["主","おも"],["なる"],["神","かみ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["、"],["山","やま"],["と"],["丘","おか"],["、"],["谷","たに"],["と"],["低地","ていち"],["、"],["荒れ果てた","あれはてた"],["廃虚","はいきょ"],["、"],["また"],["周囲","しゅうい"],["の"],["他","ほか"],["の"],["国々","くにぐに"],["から"],["略奪","りゃくだつ"],["され"],["侮られ","あなどられ"],["、"],["捨てられた","すてられた"],["町々","まちまち"],["に"],["向かって","むかって"],["こう"],["言われる","いわれる"],["。"]]},{"verse":5,"text":"それゆえ、主なる神はこう言われる。わたしは燃える熱情をもって、他の国々とエドムに対して語る。彼らはみな、心底からはしゃぎ、嘲って、わたしの土地を取り、自分の所有とし、牧草地を略奪した者だ。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["燃える","もえる"],["熱情","ねつじょう"],["を"],["もって"],["、"],["他","た"],["の"],["国々","くにぐに"],["と"],["エドム"],["に対して","にたいして"],["語る","かたる"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["心底","しんそこ"],["から"],["はしゃぎ"],["、"],["嘲って","あざけって"],["、"],["わたし"],["の"],["土地","とち"],["を"],["取り","とり"],["、"],["自分","じぶん"],["の"],["所有","しょゆう"],["と"],["し"],["、"],["牧草地","ぼくそうち"],["を"],["略奪","りゃくだつ"],["した"],["者","もの"],["だ"],["。"]]},{"verse":6,"text":"それゆえ、イスラエルの地に向かって預言し、その山々と丘、谷と低地に語りなさい。主なる神はこう言われる。わたしは熱情と憤りをもって語った。それはお前たちが国々から辱めを受けたからである。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["向かって","むかって"],["預言","よげん"],["し"],["、"],["その"],["山々","やまやま"],["と"],["丘","おか"],["、"],["谷","たに"],["と"],["低地","ていち"],["に"],["語り","かたり"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["熱情","ねつじょう"],["と"],["憤り","いきどおり"],["を"],["もって"],["語った","かたった"],["。"],["それ"],["は"],["お前","おまえ"],["たち"],["が"],["国々","くにぐに"],["から"],["辱め","はずかしめ"],["を"],["受けた","うけた"],["から"],["で"],["ある"],["。"]]},{"verse":7,"text":"それゆえ、主なる神はこう言われる。わたしは手を上げて誓う。必ず、お前の周囲の国々は自分の恥を負う。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["手","て"],["を"],["上げて","あげて"],["誓う","ちかう"],["。"],["必ず","かならず"],["、"],["お前","おまえ"],["の"],["周囲","しゅうい"],["の"],["国々","くにぐに"],["は"],["自分","じぶん"],["の"],["恥","はじ"],["を"],["負う","おう"],["。"]]},{"verse":8,"text":"しかし、お前たちイスラエルの山々よ、お前たちは枝を出し、わが民イスラエルのために実を結ぶ。彼らが戻って来るのは間近である。","tok":[["しかし"],["、"],["お前","おまえ"],["たち"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["、"],["お前","おまえ"],["たち"],["は"],["枝","えだ"],["を"],["出し","だし"],["、"],["わが"],["民","みん"],["イスラエル"],["の"],["ため"],["に"],["実","じつ"],["を"],["結ぶ","むすぶ"],["。"],["彼","かれ"],["ら"],["が"],["戻って","もどって"],["来る","くる"],["の"],["は"],["間近","まじか"],["で"],["ある"],["。"]]},{"verse":9,"text":"わたしはお前たちのために、お前たちのもとへと向かう。お前たちは耕され、種を蒔かれる。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["ため"],["に"],["、"],["お前","おまえ"],["たち"],["の"],["もと"],["へ"],["と"],["向かう","むかう"],["。"],["お前","おまえ"],["たち"],["は"],["耕され","たがやされ"],["、"],["種","しゅ"],["を"],["蒔かれる","まかれる"],["。"]]},{"verse":10,"text":"わたしはお前たちの上に、イスラエル全家の人口をことごとく増やす。町々には人が住むようになり、廃虚は建て直される。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["、"],["イスラエル"],["全","ぜん"],["家","いえ"],["の"],["人口","じんこう"],["を"],["ことごとく"],["増やす","ふやす"],["。"],["町々","まちまち"],["に"],["は"],["人","ひと"],["が"],["住む","すむ"],["よう"],["に"],["なり"],["、"],["廃虚","はいきょ"],["は"],["建て直される","たてなおされる"],["。"]]},{"verse":11,"text":"わたしはお前たちの上に人と家畜を増やす。彼らは子を産んで増える。わたしはお前たちを昔のように人の住むところとし、初めのときよりも更に栄えさせる。そのとき、お前たちはわたしが主であることを知るようになる。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["人","ひと"],["と"],["家畜","かちく"],["を"],["増やす","ふやす"],["。"],["彼","かれ"],["ら"],["は"],["子","こ"],["を"],["産んで","うんで"],["増える","ふえる"],["。"],["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["昔","むかし"],["の"],["よう"],["に"],["人","ひと"],["の"],["住む","すむ"],["ところ"],["と"],["し"],["、"],["初め","はじめ"],["の"],["とき"],["より"],["も"],["更に","さらに"],["栄えさせる","さかえさせる"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":12,"text":"わたしはお前たちの上に人々を、すなわちわが民イスラエルを歩ませる。彼らがお前を所有し、お前は彼らの嗣業となる。二度と彼らの子たちを失わせることはない。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["人々","ひとびと"],["を"],["、"],["すなわち"],["わが"],["民","みん"],["イスラエル"],["を"],["歩ませる","あゆませる"],["。"],["彼","かれ"],["ら"],["が"],["お前","おまえ"],["を"],["所有","しょゆう"],["し"],["、"],["お前","おまえ"],["は"],["彼","かれ"],["ら"],["の"],["嗣業","しぎょう"],["と"],["なる"],["。"],["二","に"],["度","ど"],["と"],["彼","かれ"],["ら"],["の"],["子","こ"],["たち"],["を"],["失わせる","うしなわせる"],["こと"],["は"],["ない"],["。"]]},{"verse":13,"text":"主なる神はこう言われる。人々はお前たちについて、『お前は人間を食らう地、自分の民の子を失わせる地だ』と言っている。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["人々","ひとびと"],["は"],["お前","おまえ"],["たち"],["について"],["、"],["『"],["お前","おまえ"],["は"],["人間","にんげん"],["を"],["食らう","くらう"],["地","ち"],["、"],["自分","じぶん"],["の"],["民","たみ"],["の"],["子","こ"],["を"],["失わせる","うしなわせる"],["地","ち"],["だ"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":14,"text":"それゆえ、お前は二度と人間を食らうことはなく、二度と自分の民の子を失わせることはない、と主なる神は言われる。","tok":[["それ"],["ゆえ"],["、"],["お前","おまえ"],["は"],["二","に"],["度","ど"],["と"],["人間","にんげん"],["を"],["食らう","くらう"],["こと"],["は"],["なく"],["、"],["二","に"],["度","ど"],["と"],["自分","じぶん"],["の"],["民","たみ"],["の"],["子","こ"],["を"],["失わせる","うしなわせる"],["こと"],["は"],["ない"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"わたしは二度と国々の辱めの声をお前に聞こえさせず、諸国の民の侮りを二度と受けさせない。お前も自分の民を二度とつまずかせることはない」と主なる神は言われる。","tok":[["わたし"],["は"],["二","に"],["度","ど"],["と"],["国々","くにぐに"],["の"],["辱め","はずかしめ"],["の"],["声","こえ"],["を"],["お前","おまえ"],["に"],["聞こえさせず","きこえさせず"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["侮り","あなどり"],["を"],["二","に"],["度","ど"],["と"],["受けさせない","うけさせない"],["。"],["お前","おまえ"],["も"],["自分","じぶん"],["の"],["民","たみ"],["を"],["二","に"],["度","ど"],["と"],["つまずかせる"],["こと"],["は"],["ない"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":16,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":17,"text":"「人の子よ、イスラエルの家は自分の土地に住んでいたとき、それを自分の歩みと行いによって汚した。その歩みは、わたしの前で生理中の女の汚れのようであった。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["自分","じぶん"],["の"],["土地","とち"],["に"],["住んで","すんで"],["いた"],["とき"],["、"],["それ"],["を"],["自分","じぶん"],["の"],["歩み","あゆみ"],["と"],["行い","おこない"],["によって"],["汚した","よごした"],["。"],["その"],["歩み","あゆみ"],["は"],["、"],["わたし"],["の"],["前","まえ"],["で"],["生理中","せいりちゅう"],["の"],["女","おんな"],["の"],["汚れ","よごれ"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":18,"text":"それゆえ、わたしは憤りを彼らの上に注いだ。彼らが地の上に血を流し、偶像によってそれを汚したからである。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["注いだ","そそいだ"],["。"],["彼","かれ"],["ら"],["が"],["地","ち"],["の"],["上","うえ"],["に"],["血","ち"],["を"],["流し","ながし"],["、"],["偶像","ぐうぞう"],["によって"],["それ"],["を"],["汚した","よごした"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"わたしは彼らを国々の中に散らし、諸国に追いやり、その歩みと行いに応じて裁いた。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["国々","くにぐに"],["の"],["中","なか"],["に"],["散らし","ちらし"],["、"],["諸国","しょこく"],["に"],["追いやり","おいやり"],["、"],["その"],["歩み","あゆみ"],["と"],["行い","おこない"],["に"],["応じて","おうじて"],["裁いた","さばいた"],["。"]]},{"verse":20,"text":"彼らはその行く先の国々に行って、わが聖なる名を汚した。事実、人々は彼らについて、『これは主の民だ、彼らは自分の土地から追われて来たのだ』と言った。","tok":[["彼","かれ"],["ら"],["は"],["その"],["行く先","ゆくさき"],["の"],["国々","くにぐに"],["に"],["行って","いって"],["、"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["汚した","よごした"],["。"],["事実","じじつ"],["、"],["人々","ひとびと"],["は"],["彼","かれ"],["ら"],["について"],["、"],["『"],["これ"],["は"],["主","ぬし"],["の"],["民","たみ"],["だ"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["土地","とち"],["から"],["追われて","おわれて"],["来た","きた"],["の"],["だ"],["』"],["と"],["言った","いった"],["。"]]},{"verse":21,"text":"そこでわたしは、イスラエルの家がその行った先の国々で汚したわが聖なる名を惜しんだ。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["が"],["その"],["行った","いった"],["先","さき"],["の"],["国々","くにぐに"],["で"],["汚した","よごした"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["惜しんだ","おしんだ"],["。"]]},{"verse":22,"text":"それゆえ、イスラエルの家に言いなさい。主なる神はこう言われる。イスラエルの家よ、わたしはお前たちのためではなく、お前たちが行った先の国々で汚したわが聖なる名のために行う。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["ため"],["で"],["は"],["なく"],["、"],["お前","おまえ"],["たち"],["が"],["行った","おこなった"],["先","さき"],["の"],["国々","くにぐに"],["で"],["汚した","よごした"],["わが"],["聖","せい"],["なる"],["名","な"],["の"],["ため"],["に"],["行う","おこなう"],["。"]]},{"verse":23,"text":"わたしは、お前たちが国々で汚したため、彼らの間で汚されたわが大いなる名を聖なるものとする。わたしが彼らの目の前で、お前たちを通して聖なるものとされるとき、諸国民は、わたしが主であることを知るようになる、と主なる神は言われる。","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["が"],["国々","くにぐに"],["で"],["汚した","よごした"],["ため"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["汚された","よごされた"],["わが"],["大いなる","おおいなる"],["名","な"],["を"],["聖","せい"],["なる"],["もの"],["と"],["する"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["お前","おまえ"],["たち"],["を"],["通して","とおして"],["聖","せい"],["なる"],["もの"],["と"],["される"],["とき"],["、"],["諸","しょ"],["国民","こくみん"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":24,"text":"わたしはお前たちを国々の間から取り、すべての地から集め、お前たちの土地に導き入れる。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["国々","くにぐに"],["の"],["間","あいだ"],["から"],["取り","とり"],["、"],["すべて"],["の"],["地","ち"],["から"],["集め","あつめ"],["、"],["お前","おまえ"],["たち"],["の"],["土地","とち"],["に"],["導き入れる","みちびきいれる"],["。"]]},{"verse":25,"text":"わたしが清い水をお前たちの上に振りかけるとき、お前たちは清められる。わたしはお前たちを、すべての汚れとすべての偶像から清める。","tok":[["わたし"],["が"],["清い","きよい"],["水","みず"],["を"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["振りかける","ふりかける"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["清められる","きよめられる"],["。"],["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["、"],["すべて"],["の"],["汚れ","よごれ"],["と"],["すべて"],["の"],["偶像","ぐうぞう"],["から"],["清める","きよめる"],["。"]]},{"verse":26,"text":"わたしはお前たちに新しい心を与え、お前たちの中に新しい霊を置く。わたしはお前たちの体から石の心を取り除き、肉の心を与える。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["に"],["新しい","あたらしい"],["心","こころ"],["を"],["与え","あたえ"],["、"],["お前","おまえ"],["たち"],["の"],["中","なか"],["に"],["新しい","あたらしい"],["霊","れい"],["を"],["置く","おく"],["。"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["体","からだ"],["から"],["石","いし"],["の"],["心","こころ"],["を"],["取り除き","とりのぞき"],["、"],["肉","にく"],["の"],["心","こころ"],["を"],["与える","あたえる"],["。"]]},{"verse":27,"text":"また、わたしの霊をお前たちの中に置き、わたしの掟に従って歩ませ、わたしの裁きを守り行わせる。","tok":[["また"],["、"],["わたし"],["の"],["霊","れい"],["を"],["お前","おまえ"],["たち"],["の"],["中","なか"],["に"],["置き","おき"],["、"],["わたし"],["の"],["掟","おきて"],["に"],["従って","したがって"],["歩ませ","あゆませ"],["、"],["わたし"],["の"],["裁き","さばき"],["を"],["守り","まもり"],["行わせる","おこなわせる"],["。"]]},{"verse":28,"text":"お前たちは、わたしが先祖に与えた地に住むようになる。お前たちはわたしの民となりわたしはお前たちの神となる。","tok":[["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["先祖","せんぞ"],["に"],["与えた","あたえた"],["地","ち"],["に"],["住む","すむ"],["よう"],["に"],["なる"],["。"],["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":29,"text":"わたしはお前たちを、すべての汚れから救う。わたしは穀物に呼びかけ、それを増やし、お前たちに飢えを送ることはしない。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["、"],["すべて"],["の"],["汚れ","よごれ"],["から"],["救う","すくう"],["。"],["わたし"],["は"],["穀物","こくもつ"],["に"],["呼びかけ","よびかけ"],["、"],["それ"],["を"],["増やし","ふやし"],["、"],["お前","おまえ"],["たち"],["に"],["飢え","うえ"],["を"],["送る","おくる"],["こと"],["は"],["しない"],["。"]]},{"verse":30,"text":"わたしが木の実と畑の作物を豊かにするので、二度と飢饉のために、国々の間で恥をこうむることはない。","tok":[["わたし"],["が"],["木の実","このみ"],["と"],["畑","はたけ"],["の"],["作物","さくもつ"],["を"],["豊か","ゆたか"],["に"],["する"],["ので"],["、"],["二","に"],["度","ど"],["と"],["飢饉","ききん"],["の"],["ため"],["に"],["、"],["国々","くにぐに"],["の"],["間","あいだ"],["で"],["恥","はじ"],["を"],["こうむる"],["こと"],["は"],["ない"],["。"]]},{"verse":31,"text":"そのとき、お前たちは自分の悪い歩み、善くない行いを思い起こし、罪と忌まわしいことのゆえに、自分自身を嫌悪する。","tok":[["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["自分","じぶん"],["の"],["悪い","わるい"],["歩み","あゆみ"],["、"],["善く","よく"],["ない"],["行い","おこない"],["を"],["思い起こし","おもいおこし"],["、"],["罪","つみ"],["と"],["忌まわしい","いまわしい"],["こと"],["の"],["ゆえ"],["に"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["嫌悪","けんお"],["する"],["。"]]},{"verse":32,"text":"わたしがこれを行うのは、お前たちのためではないことを知れ、と主なる神は言われる。イスラエルの家よ、恥じるがよい。自分の歩みを恥ずかしく思え。","tok":[["わたし"],["が"],["これ"],["を"],["行う","おこなう"],["の"],["は"],["、"],["お前","おまえ"],["たち"],["の"],["ため"],["で"],["は"],["ない"],["こと"],["を"],["知れ","しれ"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["恥じる","はじる"],["が"],["よい"],["。"],["自分","じぶん"],["の"],["歩み","あゆみ"],["を"],["恥ずかしく","はずかしく"],["思え","おもえ"],["。"]]},{"verse":33,"text":"主なる神はこう言われる。わたしがお前たちをすべての罪から清める日に、わたしは町々に人を住まわせ、廃虚を建て直す。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["が"],["お前","おまえ"],["たち"],["を"],["すべて"],["の"],["罪","つみ"],["から"],["清める","きよめる"],["日","ひ"],["に"],["、"],["わたし"],["は"],["町々","まちまち"],["に"],["人","ひと"],["を"],["住まわせ","すまわせ"],["、"],["廃虚","はいきょ"],["を"],["建て直す","たてなおす"],["。"]]},{"verse":34,"text":"荒れ果てた地、そこを通るすべての人に荒れ地と見えていた土地が耕されるようになる。","tok":[["荒れ果てた","あれはてた"],["地","ち"],["、"],["そこ"],["を"],["通る","とおる"],["すべて"],["の"],["人","ひと"],["に"],["荒れ地","あれち"],["と"],["見えて","みえて"],["いた"],["土地","とち"],["が"],["耕される","たがやされる"],["よう"],["に"],["なる"],["。"]]},{"verse":35,"text":"そのとき人々は、『荒れ果てていたこの土地がエデンの園のようになった。荒れ果て破壊されて廃虚となった町々が、城壁のある人の住む町になった』と言う。","tok":[["その"],["とき"],["人々","ひとびと"],["は"],["、"],["『"],["荒れ果てて","あれはてて"],["いた"],["この"],["土地","とち"],["が"],["エデン"],["の"],["園","その"],["の"],["よう"],["に"],["なった"],["。"],["荒れ果て","あれはて"],["破壊","はかい"],["されて"],["廃虚","はいきょ"],["と"],["なった"],["町々","まちまち"],["が"],["、"],["城壁","じょうへき"],["の"],["ある"],["人","ひと"],["の"],["住む","すむ"],["町","まち"],["に"],["なった"],["』"],["と"],["言う","ゆう"],["。"]]},{"verse":36,"text":"お前たちの周囲に残された国々も、主であるわたしがこの破壊された所を建て直し、荒れ果てていたところに植物を植えたことを知るようになる。主であるわたしが、これを語り、これを行う。","tok":[["お前","おまえ"],["たち"],["の"],["周囲","しゅうい"],["に"],["残された","のこされた"],["国々","くにぐに"],["も"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["この"],["破壊","はかい"],["された"],["所","ところ"],["を"],["建て直し","たてなおし"],["、"],["荒れ果てて","あれはてて"],["いた"],["ところ"],["に"],["植物","しょくぶつ"],["を"],["植えた","うえた"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["、"],["これ"],["を"],["語り","かたり"],["、"],["これ"],["を"],["行う","おこなう"],["。"]]},{"verse":37,"text":"主なる神はこう言われる。わたしは、再びイスラエルの家の願いを受け入れ、彼らのために行う。わたしは彼らの人口を羊の群れのように増やす。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["再び","ふたたび"],["イスラエル"],["の"],["家","いえ"],["の"],["願い","ねがい"],["を"],["受け入れ","うけいれ"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["行う","おこなう"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["人口","じんこう"],["を"],["羊","ひつじ"],["の"],["群れ","むれ"],["の"],["よう"],["に"],["増やす","ふやす"],["。"]]},{"verse":38,"text":"祭りの時に、エルサレムが聖別された羊で満ち溢れるように、廃虚であった町々は人の群れで満たされる。そのとき、彼らはわたしが主なる神であることを知るようになる。」","tok":[["祭り","まつり"],["の"],["時","とき"],["に"],["、"],["エルサレム"],["が"],["聖別","せいべつ"],["された"],["羊","ひつじ"],["で"],["満ち溢れる","みちあふれる"],["よう"],["に"],["、"],["廃虚","はいきょ"],["で"],["あった"],["町々","まちまち"],["は"]
[{"verse":1,"text":"彼はわたしを神殿の入り口に連れ戻した。すると見よ、水が神殿の敷居の下から湧き上がって、東の方へ流れていた。神殿の正面は東に向いていた。水は祭壇の南側から出て神殿の南壁の下を流れていた。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["神殿","しんでん"],["の"],["入り口","いりぐち"],["に"],["連れ戻した","つれもどした"],["。"],["する"],["と"],["見よ","みよ"],["、"],["水","みず"],["が"],["神殿","しんでん"],["の"],["敷居","しきい"],["の"],["下","した"],["から"],["湧き上がって","わきあがって"],["、"],["東","ひがし"],["の"],["方","ほう"],["へ"],["流れて","ながれて"],["いた"],["。"],["神殿","しんでん"],["の"],["正面","しょうめん"],["は"],["東","ひがし"],["に"],["向いて","むいて"],["いた"],["。"],["水","みず"],["は"],["祭壇","さいだん"],["の"],["南側","みなみがわ"],["から"],["出て","でて"],["神殿","しんでん"],["の"],["南壁","なんぺき"],["の"],["下","した"],["を"],["流れて","ながれて"],["いた"],["。"]]},{"verse":2,"text":"彼はわたしを北の門から外へ回らせ、東に向かう外の門に導いた。見よ、水は南壁から流れていた。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["北","きた"],["の"],["門","もん"],["から"],["外","そと"],["へ"],["回らせ","まわらせ"],["、"],["東","ひがし"],["に"],["向かう","むかう"],["外","そと"],["の"],["門","もん"],["に"],["導いた","みちびいた"],["。"],["見よ","みよ"],["、"],["水","みず"],["は"],["南壁","なんぺき"],["から"],["流れて","ながれて"],["いた"],["。"]]},{"verse":3,"text":"その人は、手に測り縄を持って東の方に出て行き、一千アンマを測り、わたしに水の中を渡らせると、水はくるぶしまであった。","tok":[["その"],["人","ひと"],["は"],["、"],["手","て"],["に"],["測り","はかり"],["縄","なわ"],["を"],["持って","もって"],["東","ひがし"],["の"],["方","ほう"],["に"],["出て","でて"],["行き","いき"],["、"],["一千","いちせん"],["アンマ"],["を"],["測り","はかり"],["、"],["わたし"],["に"],["水","みず"],["の"],["中","なか"],["を"],["渡らせる","わたらせる"],["と"],["、"],["水","みず"],["は"],["くるぶし"],["まで"],["あった"],["。"]]},{"verse":4,"text":"更に一千アンマを測って、わたしに水を渡らせると、水は膝に達した。更に、一千アンマを測って、わたしに水を渡らせると、水は腰に達した。","tok":[["更に","さらに"],["一千","いちせん"],["アンマ"],["を"],["測って","はかって"],["、"],["わたし"],["に"],["水","みず"],["を"],["渡らせる","わたらせる"],["と"],["、"],["水","みず"],["は"],["膝","ひざ"],["に"],["達した","たっした"],["。"],["更に","さらに"],["、"],["一千","いちせん"],["アンマ"],["を"],["測って","はかって"],["、"],["わたし"],["に"],["水","みず"],["を"],["渡らせる","わたらせる"],["と"],["、"],["水","みず"],["は"],["腰","こし"],["に"],["達した","たっした"],["。"]]},{"verse":5,"text":"更に彼が一千アンマを測ると、もはや渡ることのできない川になり、水は増えて、泳がなければ渡ることのできない川になった。","tok":[["更に","さらに"],["彼","かれ"],["が"],["一千","いちせん"],["アンマ"],["を"],["測る","はかる"],["と"],["、"],["もはや"],["渡る","わたる"],["こと"],["の"],["できない"],["川","かわ"],["に"],["なり"],["、"],["水","みず"],["は"],["増えて","ふえて"],["、"],["泳がなければ","およがなければ"],["渡る","わたる"],["こと"],["の"],["できない"],["川","かわ"],["に"],["なった"],["。"]]},{"verse":6,"text":"彼はわたしに、「人の子よ、見ましたか」と言って、わたしを川岸へ連れ戻した。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["見ました","みました"],["か"],["」"],["と"],["言って","いって"],["、"],["わたし"],["を"],["川岸","かわぎし"],["へ"],["連れ戻した","つれもどした"],["。"]]},{"verse":7,"text":"わたしが戻って来ると、川岸には、こちら側にもあちら側にも、非常に多くの木が生えていた。","tok":[["わたし"],["が"],["戻って","もどって"],["来る","くる"],["と"],["、"],["川岸","かわぎし"],["に"],["は"],["、"],["こちら側","こちらがわ"],["に"],["も"],["あちら側","あちらがわ"],["に"],["も"],["、"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["木","き"],["が"],["生えて","はえて"],["いた"],["。"]]},{"verse":8,"text":"彼はわたしに言った。「これらの水は東の地域へ流れ、アラバに下り、海、すなわち汚れた海に入って行く。すると、その水はきれいになる。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["これ"],["ら"],["の"],["水","みず"],["は"],["東","ひがし"],["の"],["地域","ちいき"],["へ"],["流れ","ながれ"],["、"],["アラバ"],["に"],["下り","くだり"],["、"],["海","うみ"],["、"],["すなわち"],["汚れた","よごれた"],["海","うみ"],["に"],["入って","はいって"],["行く","いく"],["。"],["する"],["と"],["、"],["その"],["水","みず"],["は"],["きれい"],["に"],["なる"],["。"]]},{"verse":9,"text":"川が流れて行く所ではどこでも、群がるすべての生き物は生き返り、魚も非常に多くなる。この水が流れる所では、水がきれいになるからである。この川が流れる所では、すべてのものが生き返る。","tok":[["川","かわ"],["が"],["流れて","ながれて"],["行く","いく"],["所","ところ"],["で"],["は"],["どこ"],["で"],["も"],["、"],["群がる","むらがる"],["すべて"],["の"],["生き物","いきもの"],["は"],["生き返り","いきかえり"],["、"],["魚","さかな"],["も"],["非常","ひじょう"],["に"],["多く","おおく"],["なる"],["。"],["この"],["水","みず"],["が"],["流れる","ながれる"],["所","ところ"],["で"],["は"],["、"],["水","みず"],["が"],["きれい"],["に"],["なる"],["から"],["で"],["ある"],["。"],["この"],["川","かわ"],["が"],["流れる","ながれる"],["所","ところ"],["で"],["は"],["、"],["すべて"],["の"],["もの"],["が"],["生き返る","いきかえる"],["。"]]},{"verse":10,"text":"漁師たちは岸辺に立ち、エン‧ゲディからエン‧エグライムに至るまで、網を広げて干す所とする。そこの魚は、いろいろな種類に増え、大海の魚のように非常に多くなる。","tok":[["漁師","りょうし"],["たち"],["は"],["岸辺","きしべ"],["に"],["立ち","たち"],["、"],["エン"],["‧"],["ゲディ"],["から"],["エン"],["‧"],["エグライム"],["に"],["至る","いたる"],["まで"],["、"],["網","あみ"],["を"],["広げて","ひろげて"],["干す","ほす"],["所","ところ"],["と"],["する"],["。"],["そこ"],["の"],["魚","さかな"],["は"],["、"],["いろいろ"],["な"],["種類","しゅるい"],["に"],["増え","ふえ"],["、"],["大海","たいかい"],["の"],["魚","さかな"],["の"],["よう"],["に"],["非常","ひじょう"],["に"],["多く","おおく"],["なる"],["。"]]},{"verse":11,"text":"しかし、その沢と沼はきれいにならず、塩を取ることができる。","tok":[["しかし"],["、"],["その"],["沢","さわ"],["と"],["沼","ぬま"],["は"],["きれい"],["に"],["ならず"],["、"],["塩","しお"],["を"],["取る","とる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"川のほとり、その岸には、こちら側にもあちら側にも、あらゆる果樹が大きくなり、葉は枯れず、果実は絶えることなく、月ごとに実をつける。水が聖所から流れ出るからである。その果実は食用となり、葉は薬用となる。」","tok":[["川","かわ"],["の"],["ほとり"],["、"],["その"],["岸","きし"],["に"],["は"],["、"],["こちら側","こちらがわ"],["に"],["も"],["あちら側","あちらがわ"],["に"],["も"],["、"],["あらゆる"],["果樹","かじゅ"],["が"],["大きく","おおきく"],["なり"],["、"],["葉","は"],["は"],["枯れず","かれず"],["、"],["果実","かじつ"],["は"],["絶える","たえる"],["こと"],["なく"],["、"],["月","つき"],["ごと"],["に"],["実","じつ"],["を"],["つける"],["。"],["水","みず"],["が"],["聖","せい"],["所","しょ"],["から"],["流れ出る","ながれでる"],["から"],["で"],["ある"],["。"],["その"],["果実","かじつ"],["は"],["食用","しょくよう"],["と"],["なり"],["、"],["葉","は"],["は"],["薬用","やくよう"],["と"],["なる"],["。"],["」"]]},{"verse":13,"text":"主なる神はこう言われる。「あなたたちが、イスラエルの十二部族に土地を嗣業として割り当てるときの境界線は、次のとおりである。ヨセフの割り当て地は二倍である。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["あなた"],["たち"],["が"],["、"],["イスラエル"],["の"],["十二","じゅうに"],["部族","ぶぞく"],["に"],["土地","とち"],["を"],["嗣業","しぎょう"],["として"],["割り当てる","わりあてる"],["とき"],["の"],["境界線","きょうかいせん"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ヨセフ"],["の"],["割り当て","わりあて"],["地","ち"],["は"],["二","に"],["倍","ばい"],["で"],["ある"],["。"]]},{"verse":14,"text":"あなたたちは、土地を平等に割り当てねばならない。この土地は、わたしがあなたたちの先祖に与える、と手を上げて誓ったものである。この土地は、あなたたちに嗣業として割り当てられる。","tok":[["あなた"],["たち"],["は"],["、"],["土地","とち"],["を"],["平等","びょうどう"],["に"],["割り当てねば","わりあてねば"],["ならない"],["。"],["この"],["土地","とち"],["は"],["、"],["わたし"],["が"],["あなた"],["たち"],["の"],["先祖","せんぞ"],["に"],["与える","あたえる"],["、"],["と"],["手","て"],["を"],["上げて","あげて"],["誓った","ちかった"],["もの"],["で"],["ある"],["。"],["この"],["土地","とち"],["は"],["、"],["あなた"],["たち"],["に"],["嗣業","しぎょう"],["として"],["割り当てられる","わりあてられる"],["。"]]},{"verse":15,"text":"以下が土地の境界線である。北の端は大海からヘトロンの方へ、レボ‧ハマト、ツェダド、","tok":[["以下","いか"],["が"],["土地","とち"],["の"],["境界線","きょうかいせん"],["で"],["ある"],["。"],["北","きた"],["の"],["端","はし"],["は"],["大海","たいかい"],["から"],["ヘトロン"],["の"],["方","ほう"],["へ"],["、"],["レボ"],["‧"],["ハマト"],["、"],["ツェダド"],["、"]]},{"verse":16,"text":"ベロタ、シブライム――それはダマスコの国境とハマトの国境の間にある――を経て、ハウランの境界線に臨むハツァル‧ティコンに及ぶ。","tok":[["ベロタ"],["、"],["シブライム"],["―"],["―"],["それ"],["は"],["ダマスコ"],["の"],["国境","こっきょう"],["と"],["ハマト"],["の"],["国境","こっきょう"],["の"],["間","あいだ"],["に"],["ある"],["―"],["―"],["を"],["経て","へて"],["、"],["ハウラン"],["の"],["境界線","きょうかいせん"],["に"],["臨む","のぞむ"],["ハツァル"],["‧"],["ティコン"],["に"],["及ぶ","およぶ"],["。"]]},{"verse":17,"text":"こうして、境界線は海から始まり、ダマスコの国境の北にあるハツァル‧エノンに至る。ハマトの国境は更に北にある。これが北の端である。","tok":[["こう"],["して"],["、"],["境界線","きょうかいせん"],["は"],["海","うみ"],["から"],["始まり","はじまり"],["、"],["ダマスコ"],["の"],["国境","こっきょう"],["の"],["北","きた"],["に"],["ある"],["ハツァル"],["‧"],["エノン"],["に"],["至る","いたる"],["。"],["ハマト"],["の"],["国境","こっきょう"],["は"],["更に","さらに"],["北","きた"],["に"],["ある"],["。"],["これ"],["が"],["北","きた"],["の"],["端","はし"],["で"],["ある"],["。"]]},{"verse":18,"text":"東の端はハウランとダマスコの間を通り、更にギレアドとイスラエルの土地の間、つまりヨルダンを経て東の海に接する地域からタマルに及ぶ。これが東の端である。","tok":[["東","ひがし"],["の"],["端","はし"],["は"],["ハウラン"],["と"],["ダマスコ"],["の"],["間","あいだ"],["を"],["通り","とおり"],["、"],["更に","さらに"],["ギレアド"],["と"],["イスラエル"],["の"],["土地","とち"],["の"],["間","あいだ"],["、"],["つまり"],["ヨルダン"],["を"],["経て","へて"],["東","ひがし"],["の"],["海","うみ"],["に"],["接する","せっする"],["地域","ちいき"],["から"],["タマル"],["に"],["及ぶ","およぶ"],["。"],["これ"],["が"],["東","ひがし"],["の"],["端","はし"],["で"],["ある"],["。"]]},{"verse":19,"text":"南の端は、南の方に向かってタマルからカデシュのメリバの泉に至り、大海に注ぐ川に及ぶ。これが南方、南の端である。","tok":[["南","みなみ"],["の"],["端","はし"],["は"],["、"],["南","みなみ"],["の"],["方","ほう"],["に"],["向かって","むかって"],["タマル"],["から"],["カデシュ"],["の"],["メリバ"],["の"],["泉","いずみ"],["に"],["至り","いたり"],["、"],["大海","たいかい"],["に"],["注ぐ","そそぐ"],["川","かわ"],["に"],["及ぶ","およぶ"],["。"],["これ"],["が"],["南方","なんぽう"],["、"],["南","みなみ"],["の"],["端","はし"],["で"],["ある"],["。"]]},{"verse":20,"text":"西の端は大海で、レボ‧ハマトに向かい合った地域に及んでいる。これが西の端である。","tok":[["西","にし"],["の"],["端","はし"],["は"],["大海","たいかい"],["で"],["、"],["レボ"],["‧"],["ハマト"],["に"],["向かい合った","むかいあった"],["地域","ちいき"],["に"],["及んで","およんで"],["いる"],["。"],["これ"],["が"],["西","にし"],["の"],["端","はし"],["で"],["ある"],["。"]]},{"verse":21,"text":"あなたたちは、この土地を自分たちイスラエルの各部族に分けねばならない。","tok":[["あなた"],["たち"],["は"],["、"],["この"],["土地","とち"],["を"],["自分","じぶん"],["たち"],["イスラエル"],["の"],["各","かく"],["部族","ぶぞく"],["に"],["分けねば","わけねば"],["ならない"],["。"]]},{"verse":22,"text":"この土地を、あなたたち自身とあなたたちの間に滞在し、あなたたちの間で子をもうけるにいたった外国人に、くじで嗣業として割り当てねばならない。彼らをイスラエルの子らの中で同じ資格のある者として扱わねばならない。あなたたちと共に彼らにも嗣業をくじでイスラエルの部族の間に割り当てねばならない。","tok":[["この"],["土地","とち"],["を"],["、"],["あなた"],["たち"],["自身","じしん"],["と"],["あなた"],["たち"],["の"],["間","あいだ"],["に"],["滞在","たいざい"],["し"],["、"],["あなた"],["たち"],["の"],["間","あいだ"],["で"],["子","こ"],["を"],["もうける"],["に"],["いたった"],["外国人","がいこくじん"],["に"],["、"],["くじ"],["で"],["嗣業","しぎょう"],["として"],["割り当てねば","わりあてねば"],["ならない"],["。"],["彼","かれ"],["ら"],["を"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["中","なか"],["で"],["同じ","おなじ"],["資格","しかく"],["の"],["ある"],["者","もの"],["として"],["扱わねば","あつかわねば"],["ならない"],["。"],["あなた"],["たち"],["と"],["共","とも"],["に"],["彼","かれ"],["ら"],["に"],["も"],["嗣業","しぎょう"],["を"],["くじ"],["で"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["間","あいだ"],["に"],["割り当てねば","わりあてねば"],["ならない"],["。"]]},{"verse":23,"text":"外国人には、その滞在している部族の中で嗣業を与えねばならない」と主なる神は言われる。","tok":[["外国人","がいこくじん"],["に"],["は"],["、"],["その"],["滞在","たいざい"],["して"],["いる"],["部族","ぶぞく"],["の"],["中","なか"],["で"],["嗣業","しぎょう"],["を"],["与えねば","あたえねば"],["ならない"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]}]
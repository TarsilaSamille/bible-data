[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、イスラエルの家に向かって謎をかけ、たとえを語りなさい。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["向かって","むかって"],["謎","なぞ"],["を"],["かけ"],["、"],["たとえ"],["を"],["語り","かたり"],["なさい"],["。"]]},{"verse":3,"text":"あなたは言わねばならない。主なる神はこう言われる。大きな翼と長い羽をもち彩り豊かな羽毛に覆われた大鷲がレバノンに飛来する。その鷲はレバノン杉の梢を切り取り","tok":[["あなた"],["は"],["言わねば","いわねば"],["ならない"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["大きな","おおきな"],["翼","つばさ"],["と"],["長い","ながい"],["羽","はね"],["を"],["もち"],["彩り","いろどり"],["豊か","ゆたか"],["な"],["羽毛","うもう"],["に"],["覆われた","おおわれた"],["大鷲","おおわし"],["が"],["レバノン"],["に"],["飛来","ひらい"],["する"],["。"],["その"],["鷲","わし"],["は"],["レバノン"],["杉","すぎ"],["の"],["梢","こずえ"],["を"],["切り取り","きりとり"]]},{"verse":4,"text":"その頂の若い枝を折って商業の地に運び、商人の町に置いた。","tok":[["その"],["頂","いただき"],["の"],["若い","わかい"],["枝","えだ"],["を"],["折って","おって"],["商業","しょうぎょう"],["の"],["地","ち"],["に"],["運び","はこび"],["、"],["商人","しょうにん"],["の"],["町","まち"],["に"],["置いた","おいた"],["。"]]},{"verse":5,"text":"また、その地の種を取って苗床に蒔き苗を豊かな水のほとりに柳のように植えた。","tok":[["また"],["、"],["その"],["地","ち"],["の"],["種","たね"],["を"],["取って","とって"],["苗床","なえどこ"],["に"],["蒔き","まき"],["苗","なえ"],["を"],["豊か","ゆたか"],["な"],["水","みず"],["の"],["ほとり"],["に"],["柳","やなぎ"],["の"],["よう"],["に"],["植えた","うえた"],["。"]]},{"verse":6,"text":"やがてそれは育ち低く生い茂るぶどうの木となった。その枝は鷲の方に向かって伸び根はその鷲の下に張り若枝を広げ、つるの伸びたぶどうの木となった。","tok":[["やがて"],["それ"],["は"],["育ち","そだち"],["低く","ひくく"],["生い茂る","おいしげる"],["ぶどう"],["の"],["木","き"],["と"],["なった"],["。"],["その"],["枝","えだ"],["は"],["鷲","わし"],["の"],["方","ほう"],["に"],["向かって","むかって"],["伸び","のび"],["根","ね"],["は"],["その"],["鷲","わし"],["の"],["下","した"],["に"],["張り","はり"],["若枝","わかえだ"],["を"],["広げ","ひろげ"],["、"],["つる"],["の"],["伸びた","のびた"],["ぶどう"],["の"],["木","き"],["と"],["なった"],["。"]]},{"verse":7,"text":"また、もう一羽の大鷲がいた。これも大きな翼と多くの羽毛を持っていた。このぶどうの木はその植えられていた場所から根をこの鷲の方に向け若枝をこの鷲の方に伸ばして水を得ようとした。","tok":[["また"],["、"],["もう"],["一羽","ひとわ"],["の"],["大鷲","おおわし"],["が"],["いた"],["。"],["これ"],["も"],["大きな","おおきな"],["翼","つばさ"],["と"],["多く","おおく"],["の"],["羽毛","うもう"],["を"],["持って","もって"],["いた"],["。"],["この"],["ぶどう"],["の"],["木","き"],["は"],["その"],["植えられて","うえられて"],["いた"],["場所","ばしょ"],["から"],["根","ね"],["を"],["この"],["鷲","わし"],["の"],["方","ほう"],["に"],["向け","むけ"],["若枝","わかえだ"],["を"],["この"],["鷲","わし"],["の"],["方","ほう"],["に"],["伸ばして","のばして"],["水","みず"],["を"],["得よう","えよう"],["と"],["した"],["。"]]},{"verse":8,"text":"このぶどうの木は枝を伸ばし、実を結ぶ立派なぶどうの木となるように水の豊かなよい地に植えられていた。","tok":[["この"],["ぶどう"],["の"],["木","き"],["は"],["枝","えだ"],["を"],["伸ばし","のばし"],["、"],["実","じつ"],["を"],["結ぶ","むすぶ"],["立派","りっぱ"],["な"],["ぶどう"],["の"],["木","き"],["と"],["なる"],["よう"],["に"],["水","みず"],["の"],["豊か","ゆたか"],["な"],["よい"],["地","ち"],["に"],["植えられて","うえられて"],["いた"],["。"]]},{"verse":9,"text":"語れ。主なる神はこう言われる。このぶどうの木は成長するだろうか。その根は引き抜かれ実はもぎ取られないだろうか。芽生えた葉はすべてしおれてしまわないだろうか。それはしおれてしまう。それを根から引き抜くのに大きな力も、多くの人も必要としない。","tok":[["語れ","かたれ"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["この"],["ぶどう"],["の"],["木","き"],["は"],["成長","せいちょう"],["するだろう"],["か"],["。"],["その"],["根","ね"],["は"],["引き抜かれ","ひきぬかれ"],["実","じつ"],["は"],["もぎ取られないだろう","もぎとられないだろう"],["か"],["。"],["芽生えた","めばえた"],["葉","は"],["は"],["すべて"],["しおれて"],["しまわないだろう"],["か"],["。"],["それ"],["は"],["しおれて"],["しまう"],["。"],["それ"],["を"],["根","ね"],["から"],["引き抜く","ひきぬく"],["のに"],["大きな","おおきな"],["力","ちから"],["も"],["、"],["多く","おおく"],["の"],["人","ひと"],["も"],["必要","ひつよう"],["と"],["しない"],["。"]]},{"verse":10,"text":"それは植えられはしたが果たして成長するだろうか。東風が吹きつけたならしおれてしまわないだろうか。その芽を出した場所で、しおれるであろう。","tok":[["それ"],["は"],["植えられ","うえられ"],["は"],["した"],["が"],["果たして","はたして"],["成長","せいちょう"],["するだろう"],["か"],["。"],["東風","とうふう"],["が"],["吹きつけたなら","ふきつけたなら"],["しおれて"],["しまわないだろう"],["か"],["。"],["その"],["芽","め"],["を"],["出した","だした"],["場所","ばしょ"],["で"],["、"],["しおれるで"],["あろう"],["。"]]},{"verse":11,"text":"主なる神の言葉がわたしに臨んだ。","tok":[["主","おも"],["なる"],["神","かみ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":12,"text":"さあ、この反逆の家に語りなさい。このたとえが何を意味するか、お前たちには分からないのか。バビロンの王がエルサレムに来て、王とその家来たちを捕らえ、彼らをバビロンへ連れて行った。","tok":[["さあ"],["、"],["この"],["反逆","はんぎゃく"],["の"],["家","いえ"],["に"],["語り","かたり"],["なさい"],["。"],["この"],["たとえ"],["が"],["何","なん"],["を"],["意味","いみ"],["する"],["か"],["、"],["お前","おまえ"],["たち"],["に"],["は"],["分からない","わからない"],["の"],["か"],["。"],["バビロン"],["の"],["王","おう"],["が"],["エルサレム"],["に"],["来て","きて"],["、"],["王","おう"],["と"],["その"],["家来","けらい"],["たち"],["を"],["捕らえ","とらえ"],["、"],["彼","かれ"],["ら"],["を"],["バビロン"],["へ"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":13,"text":"そして、王の子らの一人を選び、これと契約を結び、誓いを立てさせ、更に、この国の有力者をも連れて行った。","tok":[["そして"],["、"],["王","おう"],["の"],["子","こ"],["ら"],["の"],["一人","ひとり"],["を"],["選び","えらび"],["、"],["これ"],["と"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["誓い","ちかい"],["を"],["立てさせ","たてさせ"],["、"],["更に","さらに"],["、"],["この"],["国","くに"],["の"],["有力","ゆうりょく"],["者","しゃ"],["を"],["も"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":14,"text":"それは、この王国が高ぶることなく従順になり、契約を守り続けるようにさせるためであった。","tok":[["それ"],["は"],["、"],["この"],["王国","おうこく"],["が"],["高ぶる","たかぶる"],["こと"],["なく"],["従順","じゅうじゅん"],["に"],["なり"],["、"],["契約","けいやく"],["を"],["守り","まもり"],["続ける","つづける"],["よう"],["に"],["させる"],["ため"],["で"],["あった"],["。"]]},{"verse":15,"text":"しかし、彼は王に背き、エジプトに使者を送って馬と軍勢を得ようとした。果たして、それでうまくいくだろうか。こんなことをして助かるだろうか。契約を破っておきながら、助かるだろうか。","tok":[["しかし"],["、"],["彼","かれ"],["は"],["王","おう"],["に"],["背き","そむき"],["、"],["エジプト"],["に"],["使者","ししゃ"],["を"],["送って","おくって"],["馬","うま"],["と"],["軍勢","ぐんぜい"],["を"],["得よう","えよう"],["と"],["した"],["。"],["果たして","はたして"],["、"],["それ"],["で"],["うまく"],["いくだろう"],["か"],["。"],["こんな"],["こと"],["を"],["して"],["助かるだろう","たすかるだろう"],["か"],["。"],["契約","けいやく"],["を"],["破って","やぶって"],["おき"],["ながら"],["、"],["助かるだろう","たすかるだろう"],["か"],["。"]]},{"verse":16,"text":"わたしは生きている、と主なる神は言われる。彼は、自分を王位につけた大王に対する誓いを軽んじ、彼との契約を破ったので、大王の国バビロンで必ず死ぬ。","tok":[["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["彼","かれ"],["は"],["、"],["自分","じぶん"],["を"],["王位","おうい"],["に"],["つけた"],["大王","だいおう"],["に"],["対する","たいする"],["誓い","ちかい"],["を"
[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、あなたは反逆の家の中に住んでいる。彼らは見る目を持っていながら見ず、聞く耳を持っていながら聞かない。まことに彼らは反逆の家である。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["の"],["中","なか"],["に"],["住んで","すんで"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["見る","みる"],["目","め"],["を"],["持って","もって"],["い"],["ながら"],["見ず","みず"],["、"],["聞く","きく"],["耳","みみ"],["を"],["持って","もって"],["い"],["ながら"],["聞かない","きかない"],["。"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["で"],["ある"],["。"]]},{"verse":3,"text":"それゆえ、人の子よ、あなたは捕囚の荷物を造り、白昼彼らの目の前で捕らわれの身となって行きなさい。あなたのいる所から他の場所へ、彼らの目の前で捕らわれの身となって行きなさい。彼らは反逆の家であるが、あるいは、それに目を留めるかもしれない。","tok":[["それ"],["ゆえ"],["、"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["捕囚","ほしゅう"],["の"],["荷物","にもつ"],["を"],["造り","つくり"],["、"],["白昼","はくちゅう"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["捕らわれ","とらわれ"],["の"],["身","み"],["と"],["なって"],["行き","いき"],["なさい"],["。"],["あなた"],["の"],["いる"],["所","ところ"],["から"],["他","ほか"],["の"],["場所","ばしょ"],["へ"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["捕らわれ","とらわれ"],["の"],["身","み"],["と"],["なって"],["行き","いき"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["で"],["ある"],["が"],["、"],["あるいは"],["、"],["それ"],["に"],["目","め"],["を"],["留める","とめる"],["か"],["も"],["しれない"],["。"]]},{"verse":4,"text":"あなたは、白昼彼らの目の前で、自分の荷物を、捕囚の荷物として持ち出しなさい。また、夕方彼らの目の前で捕囚の民が出て行くように、出て行きなさい。","tok":[["あなた"],["は"],["、"],["白昼","はくちゅう"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["自分","じぶん"],["の"],["荷物","にもつ"],["を"],["、"],["捕囚","ほしゅう"],["の"],["荷物","にもつ"],["として"],["持ち出し","もちだし"],["なさい"],["。"],["また"],["、"],["夕方","ゆうがた"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["捕囚","ほしゅう"],["の"],["民","たみ"],["が"],["出て","でて"],["行く","いく"],["よう"],["に"],["、"],["出て","でて"],["行き","いき"],["なさい"],["。"]]},{"verse":5,"text":"彼らの目の前で、壁に穴をうがち、そこから荷物を運び出しなさい。","tok":[["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["壁","かべ"],["に"],["穴","あな"],["を"],["うがち"],["、"],["そこ"],["から"],["荷物","にもつ"],["を"],["運び出し","はこびだし"],["なさい"],["。"]]},{"verse":6,"text":"彼らの目の前で、荷物を肩に担ぎ、暗闇の中で運び出しなさい。顔を覆ってこの土地を見ないようにしなさい。わたしはあなたを、イスラエルの家に対するしるしとする。」","tok":[["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["荷物","にもつ"],["を"],["肩","かた"],["に"],["担ぎ","かつぎ"],["、"],["暗闇","くらやみ"],["の"],["中","なか"],["で"],["運び出し","はこびだし"],["なさい"],["。"],["顔","かお"],["を"],["覆って","おおって"],["この"],["土地","とち"],["を"],["見ない","みない"],["よう"],["に"],["し"],["なさい"],["。"],["わたし"],["は"],["あなた"],["を"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["対する","たいする"],["しるし"],["と"],["する"],["。"],["」"]]},{"verse":7,"text":"わたしは命じられたとおりに行った。わたしは、白昼彼らの目の前で、自分の荷物を捕囚の荷物として運び出し、夕方、手で壁に穴をうがち、暗闇の中で肩に担いで運び出した。","tok":[["わたし"],["は"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"],["わたし"],["は"],["、"],["白昼","はくちゅう"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["自分","じぶん"],["の"],["荷物","にもつ"],["を"],["捕囚","ほしゅう"],["の"],["荷物","にもつ"],["として"],["運び出し","はこびだし"],["、"],["夕方","ゆうがた"],["、"],["手","て"],["で"],["壁","かべ"],["に"],["穴","あな"],["を"],["うがち"],["、"],["暗闇","くらやみ"],["の"],["中","なか"],["で"],["肩","かた"],["に"],["担いで","かついで"],["運び出した","はこびだした"],["。"]]},{"verse":8,"text":"朝になって、主の言葉がわたしに臨んだ。","tok":[["朝","あさ"],["に"],["なって"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":9,"text":"「人の子よ、反逆の家、イスラエルの家は、あなたに向かって、『何をしているのか』と尋ねなかったか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["反逆","はんぎゃく"],["の"],["家","いえ"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["あなた"],["に"],["向かって","むかって"],["、"],["『"],["何","なん"],["を"],["して"],["いる"],["の"],["か"],["』"],["と"],["尋ねなかった","たずねなかった"],["か"],["。"]]},{"verse":10,"text":"あなたは、彼らに言わねばならない。主なる神はこう言われる。この託宣は、エルサレムの首長と、そこにいるイスラエルの家すべてにかかわる。","tok":[["あなた"],["は"],["、"],["彼","かれ"],["ら"],["に"],["言わねば","いわねば"],["ならない"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["この"],["託宣","たくせん"],["は"],["、"],["エルサレム"],["の"],["首長
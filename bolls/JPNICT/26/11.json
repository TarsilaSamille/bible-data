[{"verse":1,"text":"霊はまた、わたしを引き上げ、主の神殿の東に面する東の門へ運んで行った。門の入り口に二十五人の男がおり、その中に民の指導者であるアズルの子ヤアザンヤとベナヤの子ペラトヤがいるのをわたしは見た。","tok":[["霊","れい"],["は"],["また"],["、"],["わたし"],["を"],["引き上げ","ひきあげ"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["東","ひがし"],["に"],["面する","めんする"],["東","ひがし"],["の"],["門","もん"],["へ"],["運んで","はこんで"],["行った","いった"],["。"],["門","もん"],["の"],["入り口","いりぐち"],["に"],["二十五人","にじゅうごにん"],["の"],["男","おとこ"],["が"],["おり"],["、"],["その"],["中","なか"],["に"],["民","たみ"],["の"],["指導者","しどうしゃ"],["で"],["ある"],["アズル"],["の"],["子","こ"],["ヤアザンヤ"],["と"],["ベナヤ"],["の"],["子","こ"],["ペラトヤ"],["が"],["いる"],["の"],["を"],["わたし"],["は"],["見た","みた"],["。"]]},{"verse":2,"text":"主はわたしに言われた。「人の子よ、この人々はこの都の中で悪をたくらみ、悪い計画を立てている。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["この"],["人々","ひとびと"],["は"],["この"],["都","と"],["の"],["中","なか"],["で"],["悪","あく"],["を"],["たくらみ"],["、"],["悪い","わるい"],["計画","けいかく"],["を"],["立てて","たてて"],["いる"],["。"]]},{"verse":3,"text":"彼らは、『家をすぐに建てる必要はない。この都は鍋で、我々は肉だ』と言っている。","tok":[["彼","かれ"],["ら"],["は"],["、"],["『"],["家","いえ"],["を"],["すぐ"],["に"],["建てる","たてる"],["必要","ひつよう"],["は"],["ない"],["。"],["この"],["都","と"],["は"],["鍋","なべ"],["で"],["、"],["我々","われわれ"],["は"],["肉","にく"],["だ"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":4,"text":"それゆえ、彼らに向かって預言せよ。人の子よ、預言せよ。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["預言","よげん"],["せよ"],["。"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["預言","よげん"],["せよ"],["。"]]},{"verse":5,"text":"また、主の霊がわたしに降り、主は言われた。あなたは言わねばならない。主はこう言われる。イスラエルの家よ、お前たちはそのように言い張っている。わたしはお前たちが心に抱いていることを知っている。","tok":[["また"],["、"],["主","ぬし"],["の"],["霊","れい"],["が"],["わたし"],["に"],["降り","ふり"],["、"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["あなた"],["は"],["言わねば","いわねば"],["ならない"],["。"],["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["お前","おまえ"],["たち"],["は"],["その"],["よう"],["に"],["言い張って","いいはって"],["いる"],["。"],["わたし"],["は"],["お前","おまえ"],["たち"],["が"],["心","こころ"],["に"],["抱いて","いだいて"],["いる"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":6,"text":"しかし、お前たちはこの都の中で殺される者を数多く出し、路上は殺された者で満たされる。","tok":[["しかし"],["、"],["お前","おまえ"],["たち"],["は"],["この"],["都","と"],["の"],["中","なか"],["で"],["殺される","ころされる"],["者","もの"],["を"],["数多く","かずおおく"],["出し","だし"],["、"],["路上","ろじょう"],["は"],["殺された","ころされた"],["者","もの"],["で"],["満たされる","みたされる"],["。"]]},{"verse":7,"text":"それゆえ、主なる神はこう言われる。お前たちがこの都の中に積み上げる殺された者こそ、その肉にほかならず、都は鍋である。しかしわたしは、お前たちをそこから引き出す。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["が"],["この"],["都","と"],["の"],["中","なか"],["に"],["積み上げる","つみあげる"],["殺された","ころされた"],["者","もの"],["こそ"],["、"],["その"],["肉","にく"],["に"],["ほか"],["ならず"],["、"],["都","と"],["は"],["鍋","なべ"],["で"],["ある"],["。"],["しかし"],["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["を"],["そこ"],["から"],["引き出す","ひきだす"],["。"]]},{"verse":8,"text":"お前たちは剣を恐れているが、わたしはお前たちの上に剣を臨ませる、と主なる神は言われる。","tok":[["お前","おまえ"],["たち"],["は"],["剣","けん"],["を"],["恐れて","おそれて"],["いる"],["が"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["剣","けん"],["を"],["臨ませる","のぞませる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"わたしは、お前たちをそこから引き出して、異国人の手に渡し、お前たちに対する裁きを行う。","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["を"],["そこ"],["から"],["引き出して","ひきだして"],["、"],["異国人","いこくにん"],["の"],["手","て"],["に"],["渡し","わたし"],["、"],["お前","おまえ"],["たち"],["に"],["対する","たいする"],["裁き","さばき"],["を"],["行う","おこなう"],["。"]]},{"verse":10,"text":"お前たちは剣に撃たれて倒れる。わたしはイスラエルの国境でお前たちを裁く。そのとき、お前たちは、わたしが主であることを知るようになる。","tok":[["お前","おまえ"],["たち"],["は"],["剣","けん"],["に"],["撃たれて","うたれて"],["倒れる","たおれる"],["。"],["わたし"],["は"],["イスラエル"],["の"],["国境","こっきょう"],["で"],["お前","おまえ"],["たち"],["を"],["裁く","さばく"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":11,"text":"この都が、お前たちにとって鍋となることはない。お前たちがその中で肉となることもない。わたしは、イスラエルの国境でお前たちを裁く。","tok":[["この"],["都","と"],["が"],["、"],["お前","おまえ"],["たち"],["にとって"],["鍋","なべ"],["と"],["なる"],["こと"],["は"],["ない"],["。"],["お前","おまえ"],["たち"],["が"],["その"],["中","なか"],["で"],["肉","にく"],["と"],["なる"],["こと"],["も"],["ない"],["。"],["わたし"],["は"],["、"],["イスラエル"],["の"],["国境","こっきょう"],["で"],["お前","おまえ"],["たち"],["を"],["裁く","さばく"],["。"]]},{"verse":12,"text":"そのとき、お前たちは、わたしが主であることを知るようになる。お前たちはわたしの掟に従って歩まず、わたしの法を行わず、かえって周囲の国々のならわしに従ってきた。」","tok":[["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["掟","おきて"],["に"],["従って","したがって"],["歩まず","あゆまず"],["、"],["わたし"],["の"],["法","ほう"],["を"],["行わず","おこなわず"],["、"],["かえって"],["周囲","しゅうい"],["の"],["国々","くにぐに"],["の"],["ならわし"],["に"],["従って","したがって"],["きた"],["。"],["」"]]},{"verse":13,"text":"わたしが預言していると、ベナヤの子ペラトヤは死んだ。わたしは倒れ伏し、大声で叫んで言った。「ああ、主なる神よ。イスラエルの残りの者を滅ぼし尽くされるのですか」と。","tok":[["わたし"],["が"],["預言","よげん"],["して"],["いる"],["と"],["、"],["ベナヤ"],["の"],["子","こ"],["ペラトヤ"],["は"],["死んだ","しんだ"],["。"],["わたし"],["は"],["倒れ伏し","たおれふし"],["、"],["大声","おおごえ"],["で"],["叫んで","さけんで"],["言った","いった"],["。"],["「"],["ああ"],["、"],["主","おも"],["なる"],["神","かみ"],["よ"],["。"],["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["滅ぼし","ほろぼし"],["尽くされる","つくされる"],["の"],["です"],["か"],["」"],["と"],["。"]]},{"verse":14,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":15,"text":"「人の子よ、エルサレムの住民は、あなたの兄弟たち、すなわちあなたの親族である兄弟たち、およびイスラエルの家のすべての者に対して言っている。『主から遠く離れておれ。この土地は我々の所有地として与えられている。』","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["エルサレム"],["の"],["住民","じゅうみん"],["は"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["たち"],["、"],["すなわち"],["あなた"],["の"],["親族","しんぞく"],["で"],["ある"],["兄弟","きょうだい"],["たち"],["、"],["および"],["イスラエル"],["の"],["家","いえ"],["の"],["すべて"],["の"],["者","もの"],["に対して","にたいして"],["言って","いって"],["いる"],["。"],["『"],["主","ぬし"],["から"],["遠く","とおく"],["離れて","はなれて"],["おれ"],["。"],["この"],["土地","とち"],["は"],["我々","われわれ"],["の"],["所有地","しょゆうち"],["として"],["与えられて","あたえられて"],["いる"],["。"],["』"]]},{"verse":16,"text":"それゆえ、あなたは言わねばならない。主なる神はこう言われる。『確かに、わたしは彼らを遠くの国々に追いやり、諸国に散らした。しかしわたしは、彼らが行った国々において、彼らのためにささやかな聖所となった。』","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["言わねば","いわねば"],["ならない"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["確か","たしか"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["遠く","とおく"],["の"],["国々","くにぐに"],["に"],["追いやり","おいやり"],["、"],["諸国","しょこく"],["に"],["散らした","ちらした"],["。"],["しかし"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["が"],["行った","おこなった"],["国々","くにぐに"],["に"],["おいて"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["ささやか"],["な"],["聖","せい"],["所","しょ"],["と"],["なった"],["。"],["』"]]},{"verse":17,"text":"それゆえ、あなたは言わねばならない。主なる神はこう言われる。『わたしはお前たちを諸国の民の間から集め、散らされていた諸国から呼び集め、イスラエルの土地を与える。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["言わねば","いわねば"],["ならない"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["『"],["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["間","あいだ"],["から"],["集め","あつめ"],["、"],["散らされて","ちらされて"],["いた"],["諸国","しょこく"],["から"],["呼び集め","よびあつめ"],["、"],["イスラエル"],["の"],["土地","とち"],["を"],["与える","あたえる"],["。"]]},{"verse":18,"text":"彼らは帰って来て、あらゆる憎むべきものと、あらゆる忌まわしいものをその地から取り除く。","tok":[["彼","かれ"],["ら"],["は"],["帰って","かえって"],["来て","きて"],["、"],["あらゆる"],["憎むべき","にくむべき"],["もの"],["と"],["、"],["あらゆる"],["忌まわしい","いまわしい"],["もの"],["を"],["その"],["地","ち"],["から"],["取り除く","とりのぞく"],["。"]]},{"verse":19,"text":"わたしは彼らに一つの心を与え、彼らの中に新しい霊を授ける。わたしは彼らの肉から石の心を除き、肉の心を与える。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["一","ひと"],["つ"],["の"],["心","こころ"],["を"],["与え","あたえ"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["新しい","あたらしい"],["霊","れい"],["を"],["授ける","さずける"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["肉","にく"],["から"],["石","いし"],["の"],["心","こころ"],["を"],["除き","のぞき"],["、"],["肉","にく"],["の"],["心","こころ"],["を"],["与える","あたえる"],["。"]]},{"verse":20,"text":"彼らがわたしの掟に従って歩み、わたしの法を守り行うためである。こうして、彼らはわたしの民となり、わたしは彼らの神となる。","tok":[["彼","かれ"],["ら"],["が"],["わたし"],["の"],["掟","おきて"],["に"],["従って","したがって"],["歩み","あゆみ"],["、"],["わたし"],["の"],["法","ほう"],["を"],["守り","まもり"],["行う","おこなう"],["ため"],["で"],["ある"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":21,"text":"しかし、憎むべきもの、忌まわしいものに心を寄せている者には、彼らの行ってきたことが頭上にふりかかるようにする』」と主なる神は言われる。","tok":[["しかし"],["、"],["憎むべき","にくむべき"],["もの"],["、"],["忌まわしい","いまわしい"],["もの"],["に"],["心","こころ"],["を"],["寄せて","よせて"],["いる"],["者","もの"],["に"],["は"],["、"],["彼","かれ"],["ら"],["の"],["行って","おこなって"],["きた"],["こと"],["が"],["頭上","ずじょう"],["に"],["ふりかかる"],["よう"],["に"],["する"],["』"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":22,"text":"そのとき、ケルビムは翼を広げ、車輪もまた共に行った。イスラエルの神の栄光は高くその上にあった。","tok":[["その"],["とき"],["、"],["ケルビム"],["は"],["翼","つばさ"],["を"],["広げ","ひろげ"],["、"],["車輪","しゃりん"],["も"],["また"],["共","とも"],["に"],["行った","いった"],["。"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["は"],["高く","たかく"],["その"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":23,"text":"主の栄光は都の中から昇り、都の東にある山の上にとどまった。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["は"],["都","と"],["の"],["中","なか"],["から"],["昇り","のぼり"],["、"],["都","と"],["の"],["東","ひがし"],["に"],["ある"],["山","やま"],["の"],["上","うえ"],["に"],["とどまった"],["。"]]},{"verse":24,"text":"霊はわたしを引き上げ、カルデアの方に運び、わたしを幻のうちに、神の霊によって、捕囚の民のもとに連れて行った。こうして、わたしの見た幻は、わたしを離れて上って行った。","tok":[["霊","れい"],["は"],["わたし"],["を"],["引き上げ","ひきあげ"],["、"],["カルデア"],["の"],["方","ほう"],["に"],["運び","はこび"],["、"],["わたし"],["を"],["幻","まぼろし"],["の"],["うち"],["に"],["、"],["神","かみ"],["の"],["霊","れい"],["によって"],["、"],["捕囚","ほしゅう"],["の"],["民","たみ"],["の"],["もと"],["に"],["連れて","つれて"],["行った","いった"],["。"],["こう"],["して"],["、"],["わたし"],["の"],["見た","みた"],["幻","まぼろし"],["は"],["、"],["わたし"],["を"],["離れて","はなれて"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":25,"text":"わたしは、主が示されたすべてのことを、捕囚の民に語り聞かせた。","tok":[["わたし"],["は"],["、"],["主","ぬし"],["が"],["示された","しめされた"],["すべて"],["の"],["こと"],["を"],["、"],["捕囚","ほしゅう"],["の"],["民","たみ"],["に"],["語り聞かせた","かたりきかせた"],["。"]]}]
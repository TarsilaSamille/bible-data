[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、エルサレムにその忌まわしいことを知らせなさい。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["エルサレム"],["に"],["その"],["忌まわしい","いまわしい"],["こと"],["を"],["知らせ","しらせ"],["なさい"],["。"]]},{"verse":3,"text":"あなたは言わねばならない。主なる神は、エルサレムに対してこう言われる。お前の出身、お前の生まれはカナン人の地。父はアモリ人、母はヘト人である。","tok":[["あなた"],["は"],["言わねば","いわねば"],["ならない"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["、"],["エルサレム"],["に対して","にたいして"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["の"],["出身","しゅっしん"],["、"],["お前","おまえ"],["の"],["生まれ","うまれ"],["は"],["カナン人","かなんにん"],["の"],["地","ち"],["。"],["父","ちち"],["は"],["アモリ人","あもりにん"],["、"],["母","はは"],["は"],["ヘト人","へとにん"],["で"],["ある"],["。"]]},{"verse":4,"text":"誕生について言えば、お前の生まれた日に、お前のへその緒を切ってくれる者も、水で洗い、油を塗ってくれる者も、塩でこすり、布にくるんでくれる者もいなかった。","tok":[["誕生","たんじょう"],["について"],["言えば","いえば"],["、"],["お前","おまえ"],["の"],["生まれた","うまれた"],["日","ひ"],["に"],["、"],["お前","おまえ"],["の"],["へその緒","へそのお"],["を"],["切って","きって"],["くれる"],["者","もの"],["も"],["、"],["水","みず"],["で"],["洗い","あらい"],["、"],["油","あぶら"],["を"],["塗って","ぬって"],["くれる"],["者","もの"],["も"],["、"],["塩","しお"],["で"],["こすり"],["、"],["布","ぬの"],["に"],["くるんで"],["くれる"],["者","もの"],["も"],["いなかった"],["。"]]},{"verse":5,"text":"だれもお前に目をかけず、これらのことの一つでも行って、憐れみをかける者はいなかった。お前が生まれた日、お前は嫌われて野に捨てられた。","tok":[["だれ"],["も"],["お前","おまえ"],["に"],["目","め"],["を"],["かけず"],["、"],["これ"],["ら"],["の"],["こと"],["の"],["一","ひと"],["つ"],["で"],["も"],["行って","いって"],["、"],["憐れみ","あわれみ"],["を"],["かける"],["者","もの"],["は"],["いなかった"],["。"],["お前","おまえ"],["が"],["生まれた","うまれた"],["日","ひ"],["、"],["お前","おまえ"],["は"],["嫌われて","きらわれて"],["野","の"],["に"],["捨てられた","すてられた"],["。"]]},{"verse":6,"text":"しかし、わたしがお前の傍らを通って、お前が自分の血の中でもがいているのを見たとき、わたしは血まみれのお前に向かって、『生きよ』と言った。血まみれのお前に向かって、『生きよ』と言ったのだ。","tok":[["しかし"],["、"],["わたし"],["が"],["お前","おまえ"],["の"],["傍ら","かたわら"],["を"],["通って","とおって"],["、"],["お前","おまえ"],["が"],["自分","じぶん"],["の"],["血","ち"],["の"],["中","なか"],["で"],["もがいて"],["いる"],["の"],["を"],["見た","みた"],["とき"],["、"],["わたし"],["は"],["血まみれ","ちまみれ"],["の"],["お前","おまえ"],["に"],["向かって","むかって"],["、"],["『"],["生き","いき"],["よ"],["』"],["と"],["言った","いった"],["。"],["血まみれ","ちまみれ"],["の"],["お前","おまえ"],["に"],["向かって","むかって"],["、"],["『"],["生き","いき"],["よ"],["』"],["と"],["言った","いった"],["の"],["だ"],["。"]]},{"verse":7,"text":"わたしは、野の若草のようにお前を栄えさせた。それでお前は、健やかに育ち、成熟して美しくなり、胸の形も整い、髪も伸びた。だが、お前は裸のままであった。","tok":[["わたし"],["は"],["、"],["野","の"],["の"],["若草","わかくさ"],["の"],["よう"],["に"],["お前","おまえ"],["を"],["栄えさせた","さかえさせた"],["。"],["それ"],["で"],["お前","おまえ"],["は"],["、"],["健やか","すこやか"],["に"],["育ち","そだち"],["、"],["成熟","せいじゅく"],["して"],["美しく","うつくしく"],["なり"],["、"],["胸","むね"],["の"],["形","かたち"],["も"],["整い","ととのい"],["、"],["髪","かみ"],["も"],["伸びた","のびた"],["。"],["だ"],["が"],["、"],["お前","おまえ"],["は"],["裸","はだか"],["の"],["まま"],["で"],["あった"],["。"]]},{"verse":8,"text":"その後、わたしがお前の傍らを通ってお前を見たときには、お前は愛される年ごろになっていた。そこでわたしは、衣の裾を広げてお前に掛け、裸を覆った。わたしはお前に誓いを立てて、契約を結び、お前は、わたしのものになった、と主なる神は言われる。","tok":[["その"],["後","ご"],["、"],["わたし"],["が"],["お前","おまえ"],["の"],["傍ら","かたわら"],["を"],["通って","とおって"],["お前","おまえ"],["を"],["見た","みた"],["とき"],["に"],["は"],["、"],["お前","おまえ"],["は"],["愛される","あいされる"],["年ごろ","としごろ"],["に"],["なって"],["いた"],["。"],["そこ"],["で"],["わたし"],["は"],["、"],["衣","ころも"],["の"],["裾","すそ"],["を"],["広げて","ひろげて"],["お前","おまえ"],["に"],["掛け","かけ"],["、"],["裸","はだか"],["を"],["覆った","おおった"],["。"],["わたし"],["は"],["お前","おまえ"],["に"],["誓い","ちかい"],["を"],["立てて","たてて"],["、"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["お前","おまえ"],["は"],["、"],["わたし"],["の"],["もの"],["に"],["なった"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"わたしはお前を水で洗い、血を洗い落とし、油を塗った。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["水","みず"],["で"],["洗い","あらい"],["、"],["血","ち"],["を"],["洗い落とし","あらいおとし"],["、"],["油","あぶら"],["を"],["塗った","ぬった"],["。"]]},{"verse":10,"text":"そして、美しく織った服を着せ、上質の革靴を履かせ、亜麻布を頭にかぶらせ、絹の衣を掛けてやった。","tok":[["そして"],["、"],["美しく","うつくしく"],["織った","おった"],["服","ふく"],["を"],["着せ","きせ"],["、"],["上質","じょうしつ"],["の"],["革靴","かわぐつ"],["を"],["履かせ","はかせ"],["、"],["亜","あ"],["麻布","まふ
[{"verse":1,"text":"人の子よ、れんがを一つ取って目の前に置き、その上に都であるエルサレムを刻みなさい。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["れんが"],["を"],["一","ひと"],["つ"],["取って","とって"],["目","め"],["の"],["前","まえ"],["に"],["置き","おき"],["、"],["その"],["上","うえ"],["に"],["都","みやこ"],["で"],["ある"],["エルサレム"],["を"],["刻み","きざみ"],["なさい"],["。"]]},{"verse":2,"text":"そして、これを包囲し、これに向かって堡塁を建て、塁を築き、陣営を敷き、破城槌を周囲に配備しなさい。","tok":[["そして"],["、"],["これ"],["を"],["包囲","ほうい"],["し"],["、"],["これ"],["に"],["向かって","むかって"],["堡塁","ほうるい"],["を"],["建て","たて"],["、"],["塁","るい"],["を"],["築き","きずき"],["、"],["陣営","じんえい"],["を"],["敷き","しき"],["、"],["破城","はじょう"],["槌","つち"],["を"],["周囲","しゅうい"],["に"],["配備","はいび"],["し"],["なさい"],["。"]]},{"verse":3,"text":"自ら鉄の板を取り、それを自分と都との間に鉄の壁とし、あなたの顔を都に向けなさい。こうして都は包囲される。あなたがそれを包囲するのだ。これはイスラエルの家に対するしるしである。","tok":[["自ら鉄","みずからてつ"],["の"],["板","いた"],["を"],["取り","とり"],["、"],["それ"],["を"],["自分","じぶん"],["と"],["都","と"],["と"],["の"],["間","あいだ"],["に"],["鉄","てつ"],["の"],["壁","かべ"],["と"],["し"],["、"],["あなた"],["の"],["顔","かお"],["を"],["都","と"],["に"],["向け","むけ"],["なさい"],["。"],["こう"],["して"],["都","と"],["は"],["包囲","ほうい"],["される"],["。"],["あなた"],["が"],["それ"],["を"],["包囲","ほうい"],["する"],["の"],["だ"],["。"],["これ"],["は"],["イスラエル"],["の"],["家","いえ"],["に"],["対する","たいする"],["しるし"],["で"],["ある"],["。"]]},{"verse":4,"text":"左脇を下にして横たわり、イスラエルの家の罪を負いなさい。あなたは横たわっている日の数だけ、彼らの罪を負わなければならない。","tok":[["左脇","ひだりわき"],["を"],["下","した"],["に"],["して"],["横たわり","よこたわり"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["罪","つみ"],["を"],["負い","おい"],["なさい"],["。"],["あなた"],["は"],["横たわって","よこたわって"],["いる"],["日","ひ"],["の"],["数","かず"],["だけ"],["、"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":5,"text":"わたしは彼らの罪の年数を、日の数にして、三百九十日と定める。こうして、あなたはイスラエルの家の罪を負わねばならない。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["罪","つみ"],["の"],["年数","ねんすう"],["を"],["、"],["日","ひ"],["の"],["数","かず"],["に"],["して"],["、"],["三百九十","さんひゃくきゅうとう"],["日","か"],["と"],["定める","さだめる"],["。"],["こう"],["して"],["、"],["あなた"],["は"],["イスラエル"],["の"],["家","いえ"],["の"],["罪","つみ"],["を"],["負わねば","おわねば"],["ならない"],["。"]]},{"verse":6,"text":"その期間が終わったら、次に右脇を下にして横たわり、ユダの家の罪を四十日間負わねばならない。各一年を一日として、それをあなたに課す。","tok":[["その"],["期間","きかん"],["が"],["終わったら","おわったら"],["、"],["次","つぎ"],["に"],["右脇","みぎわき"],["を"],["下","した"],["に"],["して"],["横たわり","よこたわり"],["、"],["ユダ"],["の"],["家","いえ"],["の"],["罪","つみ"],["を"],["四十","よんとう"],["日間","かかん"],["負わねば","おわねば"],["ならない"],["。"],["各","かく"],["一","いち"],["年","ねん"],["を"],["一","いち"],["日","にち"],["として"],["、"],["それ"],["を"],["あなた"],["に"],["課す","かす"],["。"]]},{"verse":7,"text":"あなたは包囲されたエルサレムに顔を向け、腕をまくり上げて、これに向かって預言しなさい。","tok":[["あなた"],["は"],["包囲","ほうい"],["された"],["エルサレム"],["に"],["顔","かお"],["を"],["向け","むけ"],["、"],["腕","うで"],["を"],["まくり上げて","まくりあげて"],["、"],["これ"],["に"],["向かって","むかって"],["預言","よげん"],["し"],["なさい"],["。"]]},{"verse":8,"text":"わたしがあなたに縄をかけるので、あなたはその包囲の日が終わるまで、一方の脇から他の脇へと寝返りを打つことができなくなる。","tok":[["わたし"],["が"],["あなた"],["に"],["縄","なわ"],["を"],["かける"],["ので"],["、"],["あなた"],["は"],["その"],["包囲","ほうい"],["の"],["日","ひ"],["が"],["終わる","おわる"],["まで"],["、"],["一方","いっぽう"],["の"],["脇","わき"],["から"],["他","ほか"],["の"],["脇","わき"],["へ"],["と"],["寝返り","ねがえり"],["を"],["打つ","うつ"],["こと"],["が"],["できなく"],["なる"],["。"]]},{"verse":9,"text":"あなたは小麦、大麦、そら豆、ひら豆、きび、裸麦を取って、一つの器に入れ、パンを作りなさい。あなたが脇を下にして横たわっている日数、つまり三百九十日間、それを食べなさい。","tok":[["あなた"],["は"],["小麦","こむぎ"],["、"],["大麦","おおむぎ"],["、"],["そら豆","そらまめ"],["、"],["ひら豆","ひらまめ"],["、"],["きび"],["、"],["裸麦","はだかむぎ"],["を"],["取って","とって"],["、"],["一","ひと"],["つ"],["の"],["器","うつわ"],["に"],["入れ","いれ"],["、"],["パン"],["を"],["作り","つくり"],["なさい"],["。"],["あなた"],["が"],["脇","わき"],["を"],["下","した"],["に"],["して"],["横たわって","よこたわって"],["いる"],["日数","にっすう"],["、"],["つまり"],["三百九十","さんひゃくきゅうじゅう"],["日間","にちかん"],["、"],["それ"],["を"],["食べ","たべ"],["なさい"],["。"]]},{"verse":10,"text":"あなたの食べる食物の分量は一日につき二十シェケルで、それを一定の間隔をおいて食べなければならない。","tok":[["あなた"],["の"],["食べる","たべる"],["食物","しょくもつ"],["の"],["分量","ぶんりょう"],["は"],["一","いち"],["日","にち"],["に"],["つき"],["二十","にじゅう"],["シェケル"],["で"],["、"],["それ"],["を"],["一定","いってい"],["の"],["間隔","かんかく"],["を"],["おいて"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":11,"text":"あなたの飲む水の分量は六分の一ヒンで、それを一定の間隔をおいて飲まなければならない。","tok":[["あなた"],["の"],["飲む","のむ"],["水","みず"],["の"],["分量","ぶんりょう"],["は"],["六分","ろくぶん"],["の"],["一","いち"],["ヒン"],["で"],["、"],["それ"],["を"],["一定","いってい"],["の"],["間隔","かんかく"],["を"],["おいて"],["飲まなければ","のまなければ"],["ならない"],["。"]]},{"verse":12,"text":"大麦のパン菓子のようにそれを食べなければならない。それを人々の目の前で人糞で焼きなさい。","tok":[["大麦","おおむぎ"],["の"],["パン"],["菓子","かし"],["の"],["よう"],["に"],["それ"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["それ"],["を"],["人々","ひとびと"],["の"],["目","め"],["の"],["前","まえ"],["で"],["人糞","じんぷん"],["で"],["焼き","やき"],["なさい"],["。"]]},{"verse":13,"text":"更に主は言われた。「このようにイスラエルの人々はわたしが追いやる先の国々で、汚れたパンを食べる。」","tok":[["更に","さらに"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["この"],["よう"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["わたし"],["が"],["追いやる","おいやる"],["先","さき"],["の"],["国々","くにぐに"],["で"],["、"],["汚れた","よごれた"],["パン"],["を"],["食べる","たべる"],["。"],["」"]]},{"verse":14,"text":"そこで、わたしは言った。「ああ、主なる神よ、わたしはわが身を汚したことがありません。若いころから今に至るまで、死んだ動物や、野獣が引き裂いた動物の肉を食べたことはなく、定められた日数を過ぎたいけにえの肉を口に入れたこともありません。」","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["言った","いった"],["。"],["「"],["ああ"],["、"],["主","おも"],["なる"],["神","かみ"],["よ"],["、"],["わたし"],["は"],["わが"],["身","み"],["を"],["汚した","よごした"],["こと"],["が"],["ありません"],["。"],["若い","わかい"],["ころ"],["から"],["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["死んだ","しんだ"],["動物","どうぶつ"],["や"],["、"],["野獣","やじゅう"],["が"],["引き裂いた","ひきさいた"],["動物","どうぶつ"],["の"],["肉","にく"],["を"],["食べた","たべた"],["こと"],["は"],["なく"],["、"],["定められた","さだめられた"],["日数","にっすう"],["を"],["過ぎた","すぎた"],["いけにえ"],["の"],["肉","にく"],["を"],["口","くち"],["に"],["入れた","いれた"],["こと"],["も"],["ありません"],["。"],["」"]]},{"verse":15,"text":"主はわたしに言われた。「あなたが人糞の代わりに牛糞を用いることをわたしは許す。あなたはその上でパンを焼くがよい。」","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["あなた"],["が"],["人糞","じんぷん"],["の"],["代わり","かわり"],["に"],["牛糞","ぎゅうふん"],["を"],["用いる","もちいる"],["こと"],["を"],["わたし"],["は"],["許す","ゆるす"],["。"],["あなた"],["は"],["その"],["上","うえ"],["で"],["パン"],["を"],["焼く","やく"],["が"],["よい"],["。"],["」"]]},{"verse":16,"text":"また、主はわたしに言われた。「人の子よ、わたしはエルサレムのパンをつるして蓄える棒を折る。彼らはおびえながらパンの目方を量って食べ、硬直した様で水を升で量って飲むようになる。","tok":[["また"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["は"],["エルサレム"],["の"],["パン"],["を"],["つるして"],["蓄える","たくわえる"],["棒","ぼう"],["を"],["折る","おる"],["。"],["彼","かれ"],["ら"],["は"],["おびえ"],["ながら"],["パン"],["の"],["目方","めかた"],["を"],["量って","はかって"],["食べ","たべ"],["、"],["硬直","こうちょく"],["した"],["様","よう"],["で"],["水","みず"],["を"],["升","ます"],["で"],["量って","はかって"],["飲む","のむ"],["よう"],["に"],["なる"],["。"]]},{"verse":17,"text":"彼らは罪のゆえにパンにも水にも事欠き、やせ衰えて、互いに恐れに取りつかれる。」","tok":[["彼","かれ"],["ら"],["は"],["罪","つみ"],["の"],["ゆえ"],["に"],["パン"],["に"],["も"],["水","みず"],["に"],["も"],["事欠き","ことかき"],["、"],["やせ衰えて","やせおとろえて"],["、"],["互い","たがい"],["に"],["恐れ","おそれ"],["に"],["取りつかれる","とりつかれる"],["。"],["」"]]}]
[{"verse":1,"text":"それから、彼はわたしを東の方に向いている門に導いた。","tok":[["それ"],["から"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["東","ひがし"],["の"],["方","ほう"],["に"],["向いて","むいて"],["いる"],["門","もん"],["に"],["導いた","みちびいた"],["。"]]},{"verse":2,"text":"見よ、イスラエルの神の栄光が、東の方から到来しつつあった。その音は大水のとどろきのようであり、大地はその栄光で輝いた。","tok":[["見よ","みよ"],["、"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["、"],["東","ひがし"],["の"],["方","ほう"],["から"],["到来","とうらい"],["し"],["つつ"],["あった"],["。"],["その"],["音","おと"],["は"],["大水","おおみず"],["の"],["とどろき"],["の"],["よう"],["で"],["あり"],["、"],["大地","だいち"],["は"],["その"],["栄光","えいこう"],["で"],["輝いた","かがやいた"],["。"]]},{"verse":3,"text":"わたしが見た幻は、このような幻であった。それは彼が町を滅ぼすために来たとき、わたしが見た幻と同じであった。その幻は、わたしがケバル川の河畔で見た幻と同じであった。わたしはひれ伏した。","tok":[["わたし"],["が"],["見た","みた"],["幻","まぼろし"],["は"],["、"],["この"],["よう"],["な"],["幻","まぼろし"],["で"],["あった"],["。"],["それ"],["は"],["彼","かれ"],["が"],["町","まち"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["来た","きた"],["とき"],["、"],["わたし"],["が"],["見た","みた"],["幻","まぼろし"],["と"],["同じ","おなじ"],["で"],["あった"],["。"],["その"],["幻","まぼろし"],["は"],["、"],["わたし"],["が"],["ケバル"],["川","かわ"],["の"],["河畔","かはん"],["で"],["見た","みた"],["幻","まぼろし"],["と"],["同じ","おなじ"],["で"],["あった"],["。"],["わたし"],["は"],["ひれ伏した","ひれふした"],["。"]]},{"verse":4,"text":"主の栄光は、東の方に向いている門から神殿の中に入った。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["は"],["、"],["東","ひがし"],["の"],["方","ほう"],["に"],["向いて","むいて"],["いる"],["門","もん"],["から"],["神殿","しんでん"],["の"],["中","なか"],["に"],["入った","はいった"],["。"]]},{"verse":5,"text":"霊はわたしを引き上げ、内庭に導いた。見よ、主の栄光が神殿を満たしていた。","tok":[["霊","れい"],["は"],["わたし"],["を"],["引き上げ","ひきあげ"],["、"],["内庭","うちにわ"],["に"],["導いた","みちびいた"],["。"],["見よ","みよ"],["、"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["神殿","しんでん"],["を"],["満たして","みたして"],["いた"],["。"]]},{"verse":6,"text":"わたしは神殿の中から語りかける声を聞いた。そのとき、かの人がわたしの傍らに立っていた。","tok":[["わたし"],["は"],["神殿","しんでん"],["の"],["中","なか"],["から"],["語りかける","かたりかける"],["声","こえ"],["を"],["聞いた","きいた"],["。"],["その"],["とき"],["、"],["かの"],["人","ひと"],["が"],["わたし"],["の"],["傍ら","かたわら"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":7,"text":"彼はわたしに言った。「人の子よ、ここはわたしの王座のあるべき場所、わたしの足の裏を置くべき場所である。わたしは、ここで、イスラエルの子らの間にとこしえに住む。二度とイスラエルの家は、民も王たちも、淫行によって、あるいは王たちが死ぬとき、その死体によって、わが聖なる名を汚すことはない。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ここ"],["は"],["わたし"],["の"],["王座","おうざ"],["の"],["あるべき"],["場所","ばしょ"],["、"],["わたし"],["の"],["足","あし"],["の"],["裏","うら"],["を"],["置くべき","おくべき"],["場所","ばしょ"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["ここ"],["で"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["間","あいだ"],["に"],["とこしえ"],["に"],["住む","すむ"],["。"],["二","に"],["度","ど"],["と"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["民","みん"],["も"],["王","おう"],["たち"],["も"],["、"],["淫行","いんこう"],["によって"],["、"],["あるいは"],["王","おう"],["たち"],["が"],["死ぬ","しぬ"],["とき"],["、"],["その"],["死体","したい"],["によって"],["、"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["汚す","けがす"],["こと"],["は"],["ない"],["。"]]},{"verse":8,"text":"彼らがその敷居をわたしの敷居の脇に据え、彼らの門柱をわたしの門柱の傍らに立てたので、わたしと彼らとの間は、壁一つの隔りとなった。彼らは忌まわしいものを造って、わが聖なる名を汚したので、わたしは怒りをもって彼らを滅ぼした。","tok":[["彼","かれ"],["ら"],["が"],["その"],["敷居","しきい"],["を"],["わたし"],["の"],["敷居","しきい"],["の"],["脇","わき"],["に"],["据え","すえ"],["、"],["彼","かれ"],["ら"],["の"],["門柱","もんちゅう"],["を"],["わたし"],["の"],["門柱","もんちゅう"],["の"],["傍ら","かたわら"],["に"],["立てた","たてた"],["ので"],["、"],["わたし"],["と"],["彼","かれ"],["ら"],["と"],["の"],["間","あいだ"],["は"],["、"],["壁","かべ"],["一","ひと"],["つ"],["の"],["隔り","へだたり"],["と"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["忌まわしい","いまわしい"],["もの"],["を"],["造って","つくって"],["、"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["汚した","よごした"],["ので"],["、"],["わたし"],["は"],["怒り","いかり"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["滅ぼした","ほろぼした"],["。"]]},{"verse":9,"text":"今、わたしのもとから、淫行と王たちの死体を遠ざけよ。そうすれば、わたしは彼らの間にとこしえに住む。","tok":[["今","いま"],["、"],["わたし"],["の"],["もと"],["から"],["、"],["淫行","いんこう"],["と"],["王","おう"],["たち"],["の"],["死体","したい"],["を"],["遠ざけよ","とおざけよ"],["。"],["そう"],["すれば"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["とこしえ"],["に"],["住む","すむ"],["。"]]},{"verse":10,"text":"人の子よ、あなたはイスラエルの家にこの神殿を示しなさい。それは彼らが自分の罪を恥じ、神殿のあるべき姿を測るためである。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["イスラエル"],["の"],["家","いえ"],["に"],["この"],["神殿","しんでん"],["を"],["示し","しめし"],["なさい"],["。"],["それ"],["は"],["彼","かれ"],["ら"],["が"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["恥じ","はじ"],["、"],["神殿","しんでん"],["の"],["あるべき"],["姿","すがた"],["を"],["測る","はかる"],["ため"],["で"],["ある"],["。"]]},{"verse":11,"text":"もし彼らが行ってきたすべてのことを恥じたならば、神殿の計画と施設と出入り口、そのすべての計画とすべての掟、計画と律法をすべて彼らに知らせなさい。それを彼らの目の前で書き記し、そのすべての計画と掟に従って施工させなさい。","tok":[["もし"],["彼","かれ"],["ら"],["が"],["行って","いって"],["きた"],["すべて"],["の"],["こと"],["を"],["恥じたならば","はじたならば"],["、"],["神殿","しんでん"],["の"],["計画","けいかく"],["と"],["施設","しせつ"],["と"],["出入り","でいり"],["口","くち"],["、"],["その"],["すべて"],["の"],["計画","けいかく"],["と"],["すべて"],["の"],["掟","おきて"],["、"],["計画","けいかく"],["と"],["律法","りっぽう"],["を"],["すべて"],["彼","かれ"],["ら"],["に"],["知らせ","しらせ"],["なさい"],["。"],["それ"],["を"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["書き記し","かきしるし"],["、"],["その"],["すべて"],["の"],["計画","けいかく"],["と"],["掟","おきて"],["に"],["従って","したがって"],["施工","しこう"],["させ"],["なさい"],["。"]]},{"verse":12,"text":"以下は山の頂の神殿に関する律法である。周囲を区切られたこの領域はすべて最も神聖である。見よ、これが神殿に関する律法である。","tok":[["以下","いか"],["は"],["山","やま"],["の"],["頂","いただき"],["の"],["神殿","しんでん"],["に"],["関する","かんする"],["律法","りっぽう"],["で"],["ある"],["。"],["周囲","しゅうい"],["を"],["区切られた","くぎられた"],["この"],["領域","りょういき"],["は"],["すべて"],["最も","もっとも"],["神聖","しんせい"],["で"],["ある"],["。"],["見よ","みよ"],["、"],["これ"],["が"],["神殿","しんでん"],["に"],["関する","かんする"],["律法","りっぽう"],["で"],["ある"],["。"]]},{"verse":13,"text":"祭壇の大きさをアンマで示すと、次のとおりである。ただし、これは普通のアンマに一トファを加えたものである。祭壇の土台の周囲の溝は深さ一アンマ、幅一アンマで、溝の周囲の縁取りの高さは一ゼレトである。祭壇の台座は、次のようである。","tok":[["祭壇","さいだん"],["の"],["大きさ","おおきさ"],["を"],["アンマ"],["で"],["示す","しめす"],["と"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ただし"],["、"],["これ"],["は"],["普通","ふつう"],["の"],["アンマ"],["に"],["一","いち"],["トファ"],["を"],["加えた","くわえた"],["もの"],["で"],["ある"],["。"],["祭壇","さいだん"],["の"],["土台","どだい"],["の"],["周囲","しゅうい"],["の"],["溝","みぞ"],["は"],["深さ","ふかさ"],["一","いち"],["アンマ"],["、"],["幅","はば"],["一","いち"],["アンマ"],["で"],["、"],["溝","みぞ"],["の"],["周囲","しゅうい"],["の"],["縁取り","ふちどり"],["の"],["高さ","たかさ"],["は"],["一","いち"],["ゼレト"],["で"],["ある"],["。"],["祭壇","さいだん"],["の"],["台座","だいざ"],["は"],["、"],["次","つぎ"],["の"],["よう"],["で"],["ある"],["。"]]},{"verse":14,"text":"地下の溝から下の段までの高さは二アンマ、その幅は一アンマで、中段から上段までの高さは四アンマ、その幅は一アンマである。","tok":[["地下","ちか"],["の"],["溝","みぞ"],["から"],["下","した"],["の"],["段","だん"],["まで"],["の"],["高さ","たかさ"],["は"],["二","に"],["アンマ"],["、"],["その"],["幅","はば"],["は"],["一","いち"],["アンマ"],["で"],["、"],["中段","ちゅうだん"],["から"],["上段","じょうだん"],["まで"],["の"],["高さ","たかさ"],["は"],["四","よん"],["アンマ"],["、"],["その"],["幅","はば"],["は"],["一","いち"],["アンマ"],["で"],["ある"],["。"]]},{"verse":15,"text":"祭壇の炉の高さは四アンマで、炉の四隅には四つの角が出ている。","tok":[["祭壇","さいだん"],["の"],["炉","ろ"],["の"],["高さ","たかさ"],["は"],["四","よん"],["アンマ"],["で"],["、"],["炉","ろ"],["の"],["四隅","よすみ"],["に"],["は"],["四","よん"],["つ"],["の"],["角","かど"],["が"],["出て","でて"],["いる"],["。"]]},{"verse":16,"text":"この炉は長さ十二アンマ、幅十二アンマの正方形である。","tok":[["この"],["炉","ろ"],["は"],["長さ","ながさ"],["十二","じゅうに"],["アンマ"],["、"],["幅","はば"],["十二","じゅうに"],["アンマ"],["の"],["正方形","せいほうけい"],["で"],["ある"],["。"]]},{"verse":17,"text":"これを支える中段の四辺は長さ十四アンマ、幅十四アンマである。その周囲の縁は高さ二分の一アンマ、周りの溝の幅は一アンマである。祭壇の階段は東に向いている。」","tok":[["これ"],["を"],["支える","ささえる"],["中段","ちゅうだん"],["の"],["四辺","しへん"],["は"],["長さ","ながさ"],["十四","じゅうよん"],["アンマ"],["、"],["幅","はば"],["十四","じゅうよん"],["アンマ"],["で"],["ある"],["。"],["その"],["周囲","しゅうい"],["の"],["縁","えん"],["は"],["高さ","たかさ"],["二分","にぶん"],["の"],["一","いち"],["アンマ"],["、"],["周り","まわり"],["の"],["溝","みぞ"],["の"],["幅","はば"],["は"],["一","いち"],["アンマ"],["で"],["ある"],["。"],["祭壇","さいだん"],["の"],["階段","かいだん"],["は"],["東","ひがし"],["に"],["向いて","むいて"],["いる"],["。"],["」"]]},{"verse":18,"text":"彼はわたしに言った。「人の子よ、主なる神はこう言われる。以下は焼き尽くす献げ物をささげ、血を注ぐ祭壇を造る時の掟である。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["以下","いか"],["は"],["焼き","やき"],["尽くす","つくす"],["献げ物","ささげもの"],["を"],["ささげ"],["、"],["血","ち"],["を"],[
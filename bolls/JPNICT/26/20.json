[{"verse":1,"text":"第七年の五月のことであった。その月の十日に、イスラエルの長老たち数人が、主の御心を問うために来て、わたしの前に座った。","tok":[["第","だい"],["七","なな"],["年","ねん"],["の"],["五","ご"],["月","がつ"],["の"],["こと"],["で"],["あった"],["。"],["その"],["月","つき"],["の"],["十日","とうか"],["に"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["数人","かずひと"],["が"],["、"],["主","ぬし"],["の"],["御心","おこころ"],["を"],["問う","とう"],["ため"],["に"],["来て","きて"],["、"],["わたし"],["の"],["前","まえ"],["に"],["座った","すわった"],["。"]]},{"verse":2,"text":"そのとき、主の言葉がわたしに臨んだ。","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":3,"text":"「人の子よ、イスラエルの長老たちに語り、彼らに言いなさい。主なる神はこう言われる。お前たちはわたしの意志を問うために来たのか。わたしは生きている。お前たちが尋ねても、わたしは答えない、と主なる神は言われる。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["に"],["語り","かたり"],["、"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["意志","いし"],["を"],["問う","とう"],["ため"],["に"],["来た","きた"],["の"],["か"],["。"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["お前","おまえ"],["たち"],["が"],["尋ねて","たずねて"],["も"],["、"],["わたし"],["は"],["答えない","こたえない"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":4,"text":"あなたは彼らを裁くのか。人の子よ。彼らを裁くのなら、彼らの先祖たちの行った忌まわしいことを彼らに告げなさい。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["を"],["裁く","さばく"],["の"],["か"],["。"],["人","ひと"],["の"],["子","こ"],["よ"],["。"],["彼","かれ"],["ら"],["を"],["裁く","さばく"],["の"],["なら"],["、"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["の"],["行った","おこなった"],["忌まわしい","いまわしい"],["こと"],["を"],["彼","かれ"],["ら"],["に"],["告げ","つげ"],["なさい"],["。"]]},{"verse":5,"text":"彼らに言いなさい、と主なる神はこう言われる。わたしがイスラエルを選んだ日に、わたしはヤコブの家の子孫に誓い、エジプトの地で彼らにわたしを知らせたとき、彼らに誓って、わたしはお前たちの神、主であると言った。","tok":[["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["が"],["イスラエル"],["を"],["選んだ","えらんだ"],["日","ひ"],["に"],["、"],["わたし"],["は"],["ヤコブ"],["の"],["家","いえ"],["の"],["子孫","しそん"],["に"],["誓い","ちかい"],["、"],["エジプト"],["の"],["地","ち"],["で"],["彼","かれ"],["ら"],["に"],["わたし"],["を"],["知らせた","しらせた"],["とき"],["、"],["彼","かれ"],["ら"],["に"],["誓って","ちかって"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["と"],["言った","いった"],["。"]]},{"verse":6,"text":"その日、わたしは彼らに誓い、わたしは彼らをエジプトの地から連れ出して、彼らのために探し求めた土地、乳と蜜の流れる地、すべての国々の中で最も美しい土地に導く、と言った。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["誓い","ちかい"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ出して","つれだして"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["探し求めた","さがしもとめた"],["土地","とち"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["中","なか"],["で"],["最も","もっとも"],["美しい","うつくしい"],["土地","とち"],["に"],["導く","みちびく"],["、"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"わたしはまた、彼らに言った。『おのおの、目の前にある憎むべきものを投げ捨てよ。エジプトの偶像によって自分を汚してはならない。わたしはお前たちの神、主である』と。","tok":[["わたし"],["は"],["また"],["、"],["彼","かれ"],["ら"],["に"],["言った","いった"],["。"],["『"],["おのおの"],["、"],["目","め"],["の"],["前","まえ"],["に"],["ある"],["憎むべき","にくむべき"],["もの"],["を"],["投げ捨てよ","なげすてよ"],["。"],["エジプト"],["の"],["偶像","ぐうぞう"],["によって"],["自分","じぶん"],["を"],["汚して","よごして"],["は"],["ならない"],["。"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":8,"text":"しかし、彼らはわたしに逆らい、わたしに聞き従おうとはしなかった。おのおの、目の前の憎むべきものを投げ捨てず、エジプトの偶像を捨てようとはしなかった。そこで、わたしは言った。『わたしは憤りを彼らの上に注ぎ、エジプトの地でわたしの怒りを浴びせる』と。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["逆らい","さからい"],["、"],["わたし"],["に"],["聞き従おう","ききしたがおう"],["と"],["は"],["しなかった"],["。"],["おのおの"],["、"],["目","め"],["の"],["前","まえ"],["の"],["憎むべき","にくむべき"],["もの"],["を"],["投げ捨てず","なげすてず"],["、"],["エジプト"],["の"],["偶像","ぐうぞう"],["を"],["捨てよう","すてよう"],["と"],["は"],["しなかった"],["。"],["そこ"],["で"],["、"],["わたし"],["は"],["言った","いった"],["。"],["『"],["わたし"],["は"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["注ぎ","そそぎ"],["、"],["エジプト"],["の"],["地","ち"],["で"],["わたし"],["の"],["怒り","いかり"],["を"],["浴びせる","あびせる"],["』"],["と"],["。"]]},{"verse":9,"text":"しかし、わたしはわが名のために、彼らがその中に住んでいる諸国民の目の前では、わが名を汚すことがないようにした。その諸国民の目の前で、わたしはイスラエルをエジプトの地から導き出して、わたしを示したのである。","tok":[["しかし"],["、"],["わたし"],["は"],["わが"],["名","な"],["の"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["が"],["その"],["中","なか"],["に"],["住んで","すんで"],["いる"],["諸","しょ"],["国民","こくみん"],["の"],["目","め"],["の"],["前","まえ"],["で"],["は"],["、"],["わが"],["名","な"],["を"],["汚す","けがす"],["こと"],["が"],["ない"],["よう"],["に"],["した"],["。"],["その"],["諸国民","しょこくみん"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["わたし"],["は"],["イスラエル"],["を"],["エジプト"],["の"],["地","ち"],["から"],["導き出して","みちびきだして"],["、"],["わたし"],["を"],["示した","しめした"],["ので"],["ある"],["。"]]},{"verse":10,"text":"わたしは、彼らをエジプトの地から連れ出し、荒れ野に導いた。","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["エジプト"],["の"],["地","ち"],["から"],["連れ出し","つれだし"],["、"],["荒れ野","あれの"],["に"],["導いた","みちびいた"],["。"]]},{"verse":11,"text":"そして、彼らにわたしの掟を与え、わたしの裁きを示した。人がそれを行えば、それによって生きることができる。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["掟","おきて"],["を"],["与え","あたえ"],["、"],["わたし"],["の"],["裁き","さばき"],["を"],["示した","しめした"],["。"],["人","ひと"],["が"],["それ"],["を"],["行えば","おこなえば"],["、"],["それ"],["によって"],["生きる","いきる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"また、わたしは、彼らにわたしの安息日を与えた。これは、わたしと彼らとの間のしるしとなり、わたしが彼らを聖別する主であることを、彼らが知るためであった。","tok":[["また"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["安息日","あんそくび"],["を"],["与えた","あたえた"],["。"],["これ"],["は"],["、"],["わたし"],["と"],["彼","かれ"],["ら"],["と"],["の"],["間","あいだ"],["の"],["しるし"],["と"],["なり"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["する"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["が"],["知る","しる"],["ため"],["で"],["あった"],["。"]]},{"verse":13,"text":"しかし、イスラエルの家は荒れ野でわたしに背き、人がそれを行えば生きることができるわたしの掟に歩まず、わたしの裁きを退け、更に、わたしの安息日を甚だしく汚した。それゆえ、わたしは荒れ野で、憤りを彼らの上に注ぎ、彼らを滅ぼし尽くそうとした。","tok":[["しかし"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["荒れ野","あれの"],["で"],["わたし"],["に"],["背き","そむき"],["、"],["人","ひと"],["が"],["それ"],["を"],["行えば","おこなえば"],["生きる","
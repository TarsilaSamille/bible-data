[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、顔をアンモン人に向けて、彼らに預言せよ。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["顔","かお"],["を"],["アンモン"],["人","にん"],["に"],["向けて","むけて"],["、"],["彼","かれ"],["ら"],["に"],["預言","よげん"],["せよ"],["。"]]},{"verse":3,"text":"アンモン人に言いなさい。主なる神の言葉を聞け、主なる神はこう言われる。お前はわたしの聖所が汚され、イスラエルの地が荒らされ、ユダの家が捕囚となって行ったことを、あはは、と言って嘲った。","tok":[["アンモン"],["人","にん"],["に"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["は"],["わたし"],["の"],["聖","せい"],["所","しょ"],["が"],["汚され","よごされ"],["、"],["イスラエル"],["の"],["地","ち"],["が"],["荒らされ","あらされ"],["、"],["ユダ"],["の"],["家","いえ"],["が"],["捕囚","ほしゅう"],["と"],["なって"],["行った","いった"],["こと"],["を"],["、"],["あはは"],["、"],["と"],["言って","いって"],["嘲った","あざけった"],["。"]]},{"verse":4,"text":"それゆえ、わたしはお前を東の人々に渡して彼らに所有させる。彼らはお前の中に陣営を張り、住まいを定める。彼らはお前の果実を食べ、お前の乳を飲む。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["お前","おまえ"],["を"],["東","ひがし"],["の"],["人々","ひとびと"],["に"],["渡して","わたして"],["彼","かれ"],["ら"],["に"],["所有","しょゆう"],["させる"],["。"],["彼","かれ"],["ら"],["は"],["お前","おまえ"],["の"],["中","なか"],["に"],["陣営","じんえい"],["を"],["張り","はり"],["、"],["住まい","すまい"],["を"],["定める","さだめる"],["。"],["彼","かれ"],["ら"],["は"],["お前","おまえ"],["の"],["果実","かじつ"],["を"],["食べ","たべ"],["、"],["お前","おまえ"],["の"],["乳","ちち"],["を"],["飲む","のむ"],["。"]]},{"verse":5,"text":"わたしは都ラバを、らくだが草をはむ所とし、アンモンの地を羊の憩う所とする。そのとき、お前たちはわたしが主であることを知るようになる。","tok":[["わたし"],["は"],["都","と"],["ラバ"],["を"],["、"],["らくだ"],["が"],["草","くさ"],["を"],["はむ所","はむしょ"],["と"],["し"],["、"],["アンモン"],["の"],["地","ち"],["を"],["羊","ひつじ"],["の"],["憩う","いこう"],["所","ところ"],["と"],["する"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":6,"text":"主なる神はこう言われる。お前は手を打ち、足を踏み鳴らし、イスラエルの地に対する嘲りの思いに満ちて喜んだ。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["は"],["手","て"],["を"],["打ち","うち"],["、"],["足","あし"],["を"],["踏み鳴らし","ふみならし"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["対する","たいする"],["嘲り","あざけり"],["の"],["思い","おもい"],["に"],["満ちて","みちて"],["喜んだ","よろこんだ"],["。"]]},{"verse":7,"text":"それゆえ、わたしはお前に向かって手を伸ばし、お前を国々の略奪にゆだね、諸国民の中から断ち、諸国から一掃して滅ぼし尽くす。そのとき、お前はわたしが主であることを知るようになる。」","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["お前","おまえ"],["に"],["向かって","むかって"],["手","て"],["を"],["伸ばし","のばし"],["、"],["お前","おまえ"],["を"],["国々","くにぐに"],["の"],["略奪","りゃくだつ"],["に"],["ゆだね"],["、"],["諸","しょ"],["国民","こくみん"],["の"],["中","なか"],["から"],["断ち","たち"],["、"],["諸国","しょこく"],["から"],["一掃","いっそう"],["して"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":8,"text":"主なる神はこう言われる。「モアブとセイルは、『ユダの家も他のすべての国のようになった』と言った。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["モアブ"],["と"],["セイル"],["は"],["、"],["『"],["ユダ"],["の"],["家","いえ"],["も"],["他","た"],["の"],["すべて"],["の"],["国","くに"],["の"],["よう"],["に"],["なった"],["』"],["と"],["言った","いった"],["。"]]},{"verse":9,"text":"それゆえ、わたしはモアブの脇腹を引き裂き、この国の町々をすべて、その誇りであるベト‧エシモト、バアル‧メオン、キルヤタイムをはじめひとつ残らず滅ぼし尽くす。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["モアブ"],["の"],["脇腹","わきばら"],["を"],["引き裂き","ひきさき"],["、"],["この"],["国","くに"],["の"],["町々","まちまち"],["を"],["すべて"],["、"],["その"],["誇り","ほこり"],["で"],["ある"],["ベト"],["‧"],["エシモト"],["、"],["バアル"],["‧"],["メオン"],["、"],["キルヤタイム"],["を"],["はじめ"],["ひと"],["つ"],["残らず","のこらず"],["滅ぼし","ほろぼし"],["尽くす","つくす"],["。"]]},{"verse":10,"text":"わたしは、アンモン人と共にモアブを東の人々に渡して所有させる。アンモン人が諸国民の間で思い起こされることはない。","tok":[["わたし"],["は"],["、"],["アンモン"],["人","にん"],["と"],["共","とも"],["に"],["モアブ"],["を"],["東","ひがし"],["の"],["人々","ひとびと"],["に"],["渡して","わたして"],["所有","しょゆう"],["させる"],["。"],["アンモン"],["人","にん"],["が"],["諸","しょ"],["国民","こくみん"],["の"],["間","あいだ"],["で"],["思い起こされる","おもいおこされる"],["こと"],["は"],["ない"],["。"]]},{"verse":11,"text":"わたしはモアブに裁きを行う。そのとき、彼らはわたしが主であることを知るようになる。」","tok":[["わたし"],["は"],["モアブ"],["に"],["裁き","さばき"],["を"],["行う","おこなう"],["。"],["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":12,"text":"主なる神はこう言われる。「エドムはユダの家に復讐をした。彼らはその復讐によって、大いに罪を犯した。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["エドム"],["は"],["ユダ"],["の"],["家","いえ"],["に"],["復讐","ふくしゅう"],["を"],["した"],["。"],["彼","かれ"],["ら"],["は"],["その"],["復讐","ふくしゅう"],["によって"],["、"],["大いに","おおいに"],["罪","つみ"],["を"],["犯した","おかした"],["。"]]},{"verse":13,"text":"それゆえ、主なる神はこう言われる。わたしはエドムに向かって手を伸ばし、その中から人と獣を断って荒れ地とする。彼らはテマンからデダンにいたるまで剣で倒れる。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["エドム"],["に"],["向かって","むかって"],["手","て"],["を"],["伸ばし","のばし"],["、"],["その"],["中","なか"],["から"],["人","ひと"],["と"],["獣","けもの"],["を"],["断って","ことわって"],["荒れ地","あれち"],["と"],["する"],["。"],["彼","かれ"],["ら"],["は"],["テマン"],["から"],["デダン"],["に"],["いたる"],["まで"],["剣","けん"],["で"],["倒れる","たおれる"],["。"]]},{"verse":14,"text":"わたしは、わが民イスラエルによってエドムに復讐する。彼らは、わたしの怒りと憤りのままにエドムに対して行う。そのとき、彼らはわたしの復讐を知るようになる」と主なる神は言われる。","tok":[["わたし"],["は"],["、"],["わが"],["民","みん"],["イスラエル"],["によって"],["エドム"],["に"],["復讐","ふくしゅう"],["する"],["。"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["の"],["怒り","いかり"],["と"],["憤り","いきどおり"],["の"],["まま"],["に"],["エドム"],["に対して","にたいして"],["行う","おこなう"],["。"],["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["復讐","ふくしゅう"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"主なる神はこう言われる。「ペリシテ人は復讐し、嘲りの思いをもって大いに仇を報い、昔からの憎しみにかられて滅ぼそうとした。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["ペリシテ"],["人","にん"],["は"],["復讐","ふくしゅう"],["し"],["、"],["嘲り","あざけり"],["の"],["思い","おもい"],["を"],["もって"],["大いに","おおいに"],["仇","あだ"],["を"],["報い","むくい"],["、"],["昔","むかし"],["から"],["の"],["憎しみ","にくしみ"],["に"],["かられて"],["滅ぼそう","ほろぼそう"],["と"],["した"],["。"]]},{"verse":16,"text":"それゆえ、主なる神はこう言われる。わたしは手をペリシテ人に向かって伸ばし、クレタ人を断ち、海辺に残っている者を一掃する。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["手","て"],["を"],["ペリシテ"],["人","にん"],["に"],["向かって","むかって"],["伸ばし","のばし"],["、"],["クレタ人","くれたにん"],["を"],["断ち","たち"],["、"],["海辺","うみべ"],["に"],["残って","のこって"],["いる"],["者","もの"],["を"],["一掃","いっそう"],["する"],["。"]]},{"verse":17,"text":"わたしは、彼らを憤りをもって懲らしめ、大いに復讐する。わたしが彼らに仇を報いるとき、彼らはわたしが主であることを知るようになる。」","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["を"],["憤り","いきどおり"],["を"],["もって"],["懲らしめ","こらしめ"],["、"],["大いに","おおいに"],["復讐","ふくしゅう"],["する"],["。"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["仇","あだ"],["を"],["報いる","むくいる"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]}]
[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、顔をセイル山に向け、それに向かって預言し、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["顔","かお"],["を"],["セイル山","せいるさん"],["に"],["向け","むけ"],["、"],["それ"],["に"],["向かって","むかって"],["預言","よげん"],["し"],["、"]]},{"verse":3,"text":"彼に語りなさい。主なる神はこう言われる。セイル山よ、わたしはお前に立ち向かう。わたしはお前に向かって手を伸ばしお前を荒れ果てた廃虚とする。","tok":[["彼","かれ"],["に"],["語り","かたり"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["セイル"],["山","やま"],["よ"],["、"],["わたし"],["は"],["お前","おまえ"],["に"],["立ち向かう","たちむかう"],["。"],["わたし"],["は"],["お前","おまえ"],["に"],["向かって","むかって"],["手","て"],["を"],["伸ばし","のばし"],["お前","おまえ"],["を"],["荒れ果てた","あれはてた"],["廃虚","はいきょ"],["と"],["する"],["。"]]},{"verse":4,"text":"わたしはお前の町々を荒れ地とする。お前が廃虚になったときお前はわたしが主であることを知るようになる。","tok":[["わたし"],["は"],["お前","おまえ"],["の"],["町々","まちまち"],["を"],["荒れ地","あれち"],["と"],["する"],["。"],["お前","おまえ"],["が"],["廃虚","はいきょ"],["に"],["なった"],["とき"],["お前","おまえ"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":5,"text":"お前は果てしない敵意を抱き、イスラエルの子らが災いに遭い、最後の刑罰を受けたとき、彼らを剣に渡したからである。","tok":[["お前","おまえ"],["は"],["果てし","はてし"],["ない"],["敵意","てきい"],["を"],["抱き","いだき"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["が"],["災い","わざわい"],["に"],["遭い","あい"],["、"],["最後","さいご"],["の"],["刑罰","けいばつ"],["を"],["受けた","うけた"],["とき"],["、"],["彼","かれ"],["ら"],["を"],["剣","けん"],["に"],["渡した","わたした"],["から"],["で"],["ある"],["。"]]},{"verse":6,"text":"それゆえ、わたしは生きている、と主なる神は言われる。わたしはお前の血を流させ、血がお前につきまとう。血に飢えた憎しみのゆえに、血がお前につきまとう。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["お前","おまえ"],["の"],["血","ち"],["を"],["流させ","ながさせ"],["、"],["血","ち"],["が"],["お前","おまえ"],["に"],["つきまとう"],["。"],["血","ち"],["に"],["飢えた","うえた"],["憎しみ","にくしみ"],["の"],["ゆえ"],["に"],["、"],["血","ち"],["が"],["お前","おまえ"],["に"],["つきまとう"],["。"]]},{"verse":7,"text":"わたしはセイル山を荒れ果てた廃虚とし、行き来する者がないようにする。","tok":[["わたし"],["は"],["セイル山","せいるさん"],["を"],["荒れ果てた","あれはてた"],["廃虚","はいきょ"],["と"],["し"],["、"],["行き来","いきき"],["する"],["者","もの"],["が"],["ない"],["よう"],["に"],["する"],["。"]]},{"verse":8,"text":"わたしは山々を殺された者で満たす。お前の丘にも谷にも、あらゆる谷間にも、剣で殺された者が倒れる。","tok":[["わたし"],["は"],["山々","やまやま"],["を"],["殺された","ころされた"],["者","もの"],["で"],["満たす","みたす"],["。"],["お前","おまえ"],["の"],["丘","おか"],["に"],["も"],["谷","たに"],["に"],["も"],["、"],["あらゆる"],["谷間","たにま"],["に"],["も"],["、"],["剣","けん"],["で"],["殺された","ころされた"],["者","もの"],["が"],["倒れる","たおれる"],["。"]]},{"verse":9,"text":"わたしはお前を永久に荒れ果てた地とする。お前の町々には住む者がなくなる。そのとき、お前たちはわたしが主であることを知るようになる。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["永久","えいきゅう"],["に"],["荒れ果てた","あれはてた"],["地","ち"],["と"],["する"],["。"],["お前","おまえ"],["の"],["町々","まちまち"],["に"],["は"],["住む","すむ"],["者","もの"],["が"],["なくなる"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":10,"text":"それはお前が、『この二つの国、二つの土地はわたしのものとなる。我々はそれを占領する』と言ったからである。しかしそこに、主がおられた。","tok":[["それ"],["は"],["お前","おまえ"],["が"],["、"],["『"],["この"],["二","ふた"],["つ"],["の"],["国","くに"],["、"],["二","ふた"],["つ"],["の"],["土地","とち"],["は"],["わたし"],["の"],["もの"],["と"],["なる"],["。"],["我々","われわれ"],["は"],["それ"],["を"],["占領","せんりょう"],["する"],["』"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"],["しかし"],["そこ"],["に"],["、"],["主","ぬし"],["が"],["おられた"],["。"]]},{"verse":11,"text":"それゆえ、わたしは生きている、と主なる神は言われる。お前が彼らを憎んで行った怒りとねたみに応じて、わたしもお前に行う。わたしがお前を裁くとき、わたしは彼らに知られるようになる。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["お前","おまえ"],["が"],["彼","かれ"],["ら"],["を"],["憎んで","にくんで"],["行った","いった"],["怒り","いかり"],["と"],["ねたみ"],["に"],["応じて","おうじて"],["、"],["わたし"],["も"],["お前","おまえ"],["に"],["行う","おこなう"],["。"],["わたし"],["が"],["お前","おまえ"],["を"],["裁く","さばく"],["とき"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["知られる","しられる"],["よう"],["に"],["なる"],["。"]]},{"verse":12,"text":"そしてお前は、主であるわたしがお前のもろもろの嘲りを聞いたことを知るようにな
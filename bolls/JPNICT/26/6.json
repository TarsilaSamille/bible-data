[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、顔をイスラエルの山々に向け、それに向かって預言して、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["顔","かお"],["を"],["イスラエル"],["の"],["山々","やまやま"],["に"],["向け","むけ"],["、"],["それ"],["に"],["向かって","むかって"],["預言","よげん"],["して"],["、"]]},{"verse":3,"text":"言え。イスラエルの山々よ、主なる神の言葉を聞け。主なる神は、山と丘、川と谷に向かって、こう言われる。わたしは剣をお前たちに臨ませ、聖なる高台を破壊する。","tok":[["言え","いえ"],["。"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["、"],["主","おも"],["なる"],["神","かみ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["、"],["山","やま"],["と"],["丘","おか"],["、"],["川","かわ"],["と"],["谷","たに"],["に"],["向かって","むかって"],["、"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["剣","けん"],["を"],["お前","おまえ"],["たち"],["に"],["臨ませ","のぞませ"],["、"],["聖","せい"],["なる"],["高台","たかだい"],["を"],["破壊","はかい"],["する"],["。"]]},{"verse":4,"text":"祭壇は荒れ果て、香炉台は砕かれる。また、わたしは、お前たちの中の殺された者を、偶像の前に投げ捨てる。","tok":[["祭壇","さいだん"],["は"],["荒れ果て","あれはて"],["、"],["香炉","こうろ"],["台","だい"],["は"],["砕かれる","くだかれる"],["。"],["また"],["、"],["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["の"],["中","なか"],["の"],["殺された","ころされた"],["者","もの"],["を"],["、"],["偶像","ぐうぞう"],["の"],["前","まえ"],["に"],["投げ捨てる","なげすてる"],["。"]]},{"verse":5,"text":"わたしはイスラエルの人々の死体をその偶像の前に置き、お前たちの骨を祭壇の周りにまき散らす。","tok":[["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["死体","したい"],["を"],["その"],["偶像","ぐうぞう"],["の"],["前","まえ"],["に"],["置き","おき"],["、"],["お前","おまえ"],["たち"],["の"],["骨","ほね"],["を"],["祭壇","さいだん"],["の"],["周り","まわり"],["に"],["まき散らす","まきちらす"],["。"]]},{"verse":6,"text":"お前たちの住む所はどこにおいても、町は廃虚とされ、聖なる高台は荒らされる。祭壇も廃虚とされて荒らされ、偶像は粉々に砕かれ、香炉台は打ち壊され、こうしてお前たちの作ったものは一掃される。","tok":[["お前","おまえ"],["たち"],["の"],["住む","すむ"],["所","ところ"],["は"],["どこ"],["に"],["おいて"],["も"],["、"],["町","まち"],["は"],["廃虚","はいきょ"],["と"],["され"],["、"],["聖","せい"],["なる"],["高台","たかだい"],["は"],["荒らされる","あらされる"],["。"],["祭壇","さいだん"],["も"],["廃虚","はいきょ"],["と"],["されて"],["荒らされ","あらされ"],["、"],["偶像","ぐうぞう"],["は"],["粉々","こなごな"],["に"],["砕かれ","くだかれ"],["、"],["香炉","こうろ"],["台","だい"],["は"],["打ち壊され","ぶちこわされ"],["、"],["こう"],["して"],["お前","おまえ"],["たち"],["の"],["作った","つくった"],["もの"],["は"],["一掃","いっそう"],["される"],["。"]]},{"verse":7,"text":"また、殺された者がお前たちの真ん中に倒れる。そのとき、お前たちはわたしが主であることを知るようになる。","tok":[["また"],["、"],["殺された","ころされた"],["者","もの"],["が"],["お前","おまえ"],["たち"],["の"],["真ん中","まんなか"],["に"],["倒れる","たおれる"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"しかし、お前たちが諸国に散らされるとき、わたしはお前たちのために、剣を逃れた者を諸国民の間に残しておく。","tok":[["しかし"],["、"],["お前","おまえ"],["たち"],["が"],["諸国","しょこく"],["に"],["散らされる","ちらされる"],["とき"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["ため"],["に"],["、"],["剣","けん"],["を"],["逃れた","のがれた"],["者","もの"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["間","あいだ"],["に"],["残して","のこして"],["おく"],["。"]]},{"verse":9,"text":"お前たちのうちで逃れた者は、捕囚として連れ去られる先の国々でわたしを思い起こす。わたしを離れ去る姦淫の心と、偶像にひかれる姦淫の目をわたしが打ち砕くからだ。そして彼らは自ら行った悪のゆえに、その忌まわしいすべてのことのゆえに、自分を嫌悪するようになる。","tok":[["お前","おまえ"],["たち"],["の"],["うち"],["で"],["逃れた","のがれた"],["者","もの"],["は"],["、"],["捕囚","ほしゅう"],["として"],["連れ去られる","つれさられる"],["先","さき"],["の"],["国々","くにぐに"],["で"],["わたし"],["を"],["思い起こす","おもいおこす"],["。"],["わたし"],["を"],["離れ去る","はなれさる"],["姦淫","かんいん"],["の"],["心","こころ"],["と"],["、"],["偶像","ぐうぞう"],["に"],["ひかれる"],["姦淫","かんいん"],["の"],["目","め"],["を"],["わたし"],["が"],["打ち砕く","うちくだく"],["から"],["だ"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["自ら","みずから"],["行った","いった"],["悪","あく"],["の"],["ゆえ"],["に"],["、"],["その"],["忌まわしい","いまわしい"],["すべて"],["の"],["こと"],["の"],["ゆえ"],["に"],["、"],["自分","じぶん"],["を"],["嫌悪","けんお"],["する"],["よう"],["に"],["なる"],["。"]]},{"verse":10,"text":"そして彼らは、わたしが主であり、理由もなくこの災いを彼らにくだすと告げたのではなかったことを知るようになる。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["あり"],["、"],["理由","りゆう"],["も"],["なく"],["この"],["災い","わざわい"],["を"],["彼","かれ"],["ら"],["に"],["くだす"],["と"],["告げた","つげた"],["ので"],["は"],["なかった"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":11,"text":"主なる神はこう言われる。手をたたき、足を踏み鳴らして、イスラエルの家の忌まわしいすべての悪事を嘆け。彼らは剣と、飢饉と、疫病によって倒れるからだ。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["手","て"],["を"],["たたき"],["、"],["足","あし"],["を"],["踏み鳴らして","ふみならして"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["忌まわしい","いまわしい"],["すべて"],["の"],["悪事","あくじ"],["を"],["嘆け","なげけ"],["。"],["彼","かれ"],["ら"],["は"],["剣","けん"],["と"],["、"],["飢饉","ききん"],["と"],["、"],["疫病","やくびょう"],["によって"],["倒れる","たおれる"],["から"],["だ"],["。"]]},{"verse":12,"text":"遠くにいる者は疫病で死に、近くにいる者は剣で倒れる。それを免れ、生き残る者も飢饉で死ぬ。こうしてわたしは彼らに対して怒りを注ぎ尽くす。","tok":[["遠く","とおく"],["に"],["いる"],["者","もの"],["は"],["疫病","やくびょう"],["で"],["死に","しに"],["、"],["近く","ちかく"],["に"],["いる"],["者","もの"],["は"],["剣","けん"],["で"],["倒れる","たおれる"],["。"],["それ"],["を"],["免れ","まぬがれ"],["、"],["生き残る","いきのこる"],["者","もの"],["も"],["飢饉","ききん"],["で"],["死ぬ","しぬ"],["。"],["こう"],["して"],["わたし"],["は"],["彼","かれ"],["ら"],["に対して","にたいして"],["怒り","いかり"],["を"],["注ぎ","そそぎ"],["尽くす","つくす"],["。"]]},{"verse":13,"text":"殺された者たちが、祭壇の周りの偶像の間や、高い丘の上、山々の頂で、またすべての緑豊かな木、すべての茂った樫の木の下、あるいはかつて、あらゆる偶像に宥めの香りをささげた場所で倒れるとき、お前たちは、わたしが主であることを知るようになる。","tok":[["殺された","ころされた"],["者","もの"],["たち"],["が"],["、"],["祭壇","さいだん"],["の"],["周り","まわり"],["の"],["偶像","ぐうぞう"],["の"],["間","あいだ"],["や"],["、"],["高い","たかい"],["丘","おか"],["の"],["上","うえ"],["、"],["山々","やまやま"],["の"],["頂","いただき"],["で"],["、"],["また"],["すべて"],["の"],["緑","みどり"],["豊か","ゆたか"],["な"],["木","き"],["、"],["すべて"],["の"],["茂った","しげった"],["樫","かし"],["の"],["木","き"],["の"],["下","もと"],["、"],["あるいは"],["かつて"],["、"],["あらゆる"],["偶像","ぐうぞう"],["に"],["宥め","なだめ"],["の"],["香り","かおり"],["を"],["ささげた"],["場所","ばしょ"],["で"],["倒れる","たおれる"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":14,"text":"わたしは彼らに向かって手を伸ばし、この地を荒廃させ、荒れ野からリブラに至るまで、彼らが住むすべての地を荒れ果てたところとする。そのとき、彼らは、わたしが主であることを知るようになる。」","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["手","て"],["を"],["伸ばし","のばし"],["、"],["この"],["地","ち"],["を"],["荒廃","こうはい"],["させ"],["、"],["荒れ野","あれの"],["から"],["リブラ"],["に"],["至る","いたる"],["まで"],["、"],["彼","かれ"],["ら"],["が"],["住む","すむ"],["すべて"],["の"],["地","ち"],["を"],["荒れ果てた","あれはてた"],["ところ"],["と"],["する"],["。"],["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]}]
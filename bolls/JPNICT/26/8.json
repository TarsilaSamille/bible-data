[{"verse":1,"text":"第六年の六月五日のことである。わたしは自分の家に座っており、ユダの長老たちがわたしの前に座っていた。そのとき、主なる神の御手がわたしの上に下った。","tok":[["第","だい"],["六","ろく"],["年","ねん"],["の"],["六","ろく"],["月","がつ"],["五日","いつか"],["の"],["こと"],["で"],["ある"],["。"],["わたし"],["は"],["自分","じぶん"],["の"],["家","いえ"],["に"],["座って","すわって"],["おり"],["、"],["ユダ"],["の"],["長老","ちょうろう"],["たち"],["が"],["わたし"],["の"],["前","まえ"],["に"],["座って","すわって"],["いた"],["。"],["その"],["とき"],["、"],["主","おも"],["なる"],["神","かみ"],["の"],["御手","おて"],["が"],["わたし"],["の"],["上","うえ"],["に"],["下った","くだった"],["。"]]},{"verse":2,"text":"わたしが見ていると、人の有様のような姿があるではないか。その腰のように見えるところから下は火であり、腰から上は琥珀金の輝きのように光輝に満ちた有様をしていた。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["人","ひと"],["の"],["有様","ありさま"],["の"],["よう"],["な"],["姿","すがた"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"],["その"],["腰","こし"],["の"],["よう"],["に"],["見える","みえる"],["ところ"],["から"],["下","した"],["は"],["火","ひ"],["で"],["あり"],["、"],["腰","こし"],["から"],["上","うえ"],["は"],["琥珀金","こはくきん"],["の"],["輝き","かがやき"],["の"],["よう"],["に"],["光輝","こうき"],["に"],["満ちた","みちた"],["有様","ありさま"],["を"],["して"],["いた"],["。"]]},{"verse":3,"text":"彼が手の形をしたものを差し伸べて、わたしの髪の毛の房をつかむと、霊はわたしを地と天の間に引き上げ、神の幻のうちにわたしをエルサレムへと運び、北に面する内側の門の入り口に連れて行った。そこには、激怒を起こさせる像が収められていた。","tok":[["彼","かれ"],["が"],["手","て"],["の"],["形","かたち"],["を"],["した"],["もの"],["を"],["差し伸べて","さしのべて"],["、"],["わたし"],["の"],["髪の毛","かみのけ"],["の"],["房","ふさ"],["を"],["つかむ"],["と"],["、"],["霊","れい"],["は"],["わたし"],["を"],["地","ち"],["と"],["天","てん"],["の"],["間","あいだ"],["に"],["引き上げ","ひきあげ"],["、"],["神","かみ"],["の"],["幻","まぼろし"],["の"],["うち"],["に"],["わたし"],["を"],["エルサレム"],["へ"],["と"],["運び","はこび"],["、"],["北","きた"],["に"],["面する","めんする"],["内側","うちがわ"],["の"],["門","もん"],["の"],["入り口","いりぐち"],["に"],["連れて","つれて"],["行った","いった"],["。"],["そこ"],["に"],["は"],["、"],["激怒","げきど"],["を"],["起こさせる","おこさせる"],["像","ぞう"],["が"],["収められて","おさめられて"],["いた"],["。"]]},{"verse":4,"text":"そこには、かつてわたしが平野で見た有様と同じような、イスラエルの神の栄光があった。","tok":[["そこ"],["に"],["は"],["、"],["かつて"],["わたし"],["が"],["平野","へいや"],["で"],["見た","みた"],["有様","ありさま"],["と"],["同じ","おなじ"],["よう"],["な"],["、"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["あった"],["。"]]},{"verse":5,"text":"彼がわたしに、「人の子よ、目を上げて北の方を見なさい」と言ったので、北の方に目を上げると、門の北側に祭壇があり、入り口にはまさにその激怒を招く像があるではないか。","tok":[["彼","かれ"],["が"],["わたし"],["に"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["目","め"],["を"],["上げて","あげて"],["北","きた"],["の"],["方","ほう"],["を"],["見","み"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["北","きた"],["の"],["方","ほう"],["に"],["目","め"],["を"],["上げる","あげる"],["と"],["、"],["門","もん"],["の"],["北側","きたがわ"],["に"],["祭壇","さいだん"],["が"],["あり"],["、"],["入り口","いりぐち"],["に"],["は"],["まさに"],["その"],["激怒","げきど"],["を"],["招く","まねく"],["像","ぞう"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"彼はわたしに言った。「人の子よ、イスラエルの人々がわたしを聖所から遠ざけるために行っている甚だ忌まわしいことを見るか。しかし、あなたは更に甚だしく忌まわしいことを見る。」","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["わたし"],["を"],["聖","せい"],["所","しょ"],["から"],["遠ざける","とおざける"],["ため"],["に"],["行って","いって"],["いる"],["甚だ","はなはだ"],["忌まわしい","いまわしい"],["こと"],["を"],["見る","みる"],["か"],["。"],["しかし"],["、"],["あなた"],["は"],["更に","さらに"],["甚だしく","はなはだしく"],["忌まわしい","いまわしい"],["こと"],["を"],["見る","みる"],["。"],["」"]]},{"verse":7,"text":"彼はわたしを庭の入り口に連れて行った。見ると、壁に一つの穴があるではないか。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["庭","にわ"],["の"],["入り口","いりぐち"],["に"],["連れて","つれて"],["行った","いった"],["。"],["見る","みる"],["と"],["、"],["壁","かべ"],["に"],["一","ひと"],["つ"],["の"],["穴","あな"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":8,"text":"彼がわたしに、「人の子よ、壁に穴をうがちなさい」と言ったので、壁に穴をうがつと、そこに一つの入り口があるではないか。","tok":[["彼","かれ"],["が"],["わたし"],["に"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["壁","かべ"],["に"],["穴","あな"],["を"],["うがち"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"],["壁","かべ"],["に"],["穴","あな"],["を"],["うがつ"],["と"],["、"],["そこ"],["に"],["一","ひと"],["つ"],["の"],["入り口","いりぐち"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":9,"text":"彼は、「入って、彼らがここで行っている邪悪で忌まわしいことを見なさい」と言った。","tok":[["彼","かれ"],["は"],["、"],["「"],["入って","はいって"],["、"],["彼","かれ"],["ら"],["が"],["ここ"],["で"],["行って","いって"],["いる"],["邪悪","じゃあく"],["で"],["忌まわしい","いまわしい"],["こと"],["を"],["見","み"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"入って見ていると、周りの壁一面に、あらゆる地を這うものと獣の憎むべき像、およびイスラエルの家のあらゆる偶像が彫り込まれているではないか。","tok":[["入って","はいって"],["見て","みて"],["いる"],["と"],["、"],["周り","まわり"],["の"],["壁","かべ"],["一面","いちめん"],["に"],["、"],["あらゆる"],["地","ち"],["を"],["這う","はう"],["もの"],["と"],["獣","けもの"],["の"],["憎むべき","にくむべき"],["像","ぞう"],["、"],["および"],["イスラエル"],["の"],["家","いえ"],["の"],["あらゆる"],["偶像","ぐうぞう"],["が"],["彫り込まれて","ほりこまれて"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":11,"text":"その前に、イスラエルの長老七十人が、シャファンの子ヤアザンヤを中心にして立っていた。彼らは、それぞれ香炉を手にしており、かぐわしい煙が立ち昇っていた。","tok":[["その"],["前","まえ"],["に"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["七","なな"],["十人","じゅうにん"],["が"],["、"],["シャファン"],["の"],["子","こ"],["ヤアザンヤ"],["を"],["中心","ちゅうしん"],["に"],["して"],["立って","たって"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["、"],["それぞれ"],["香炉","こうろ"],["を"],["手","て"],["に"],["して"],["おり"],["、"],["かぐわしい"],["煙","けむり"],["が"],["立ち昇って","たちのぼって"],["いた"],["。"]]},{"verse":12,"text":"彼はわたしに言った。「人の子よ、イスラエルの家の長老たちが、闇の中でおのおの、自分の偶像の部屋で行っていることを見たか。彼らは、主は我々を御覧にならない。主はこの地を捨てられたと言っている。」","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["長老","ちょうろう"],["たち"],["が"],["、"],["闇","やみ"],["の"],["中","なか"],["で"],["おのおの"],["、"],["自分","じぶん"],["の"],["偶像","ぐうぞう"],["の"],["部屋","へや"],["で"],["行って","いって"],["いる"],["こと"],["を"],["見た","みた"],["か"],["。"],["彼","かれ"],["ら"],["は"],["、"],["主","ぬし"],["は"],["我々","われわれ"],["を"],["御覧","ごらん"],["に"],["ならない"],["。"],["主","ぬし"],["は"],["この"],["地","ち"],["を"],["捨てられた","すてられた"],["と"],["言って","いって"],["いる"],["。"],["」"]]},{"verse":13,"text":"彼はまた、わたしに言った。「あなたは、彼らが行っている更に甚だしく忌まわしいことを見る」と。","tok":[["彼","かれ"],["は"],["また"],["、"],["わたし"],["に"],["言った","いった"],["。"],["「"],["あなた"],["は"],["、"],["彼","かれ"],["ら"],["が"],["行って","いって"],["いる"],["更に","さらに"],["甚だしく","はなはだしく"],["忌まわしい","いまわしい"],["こと"],["を"],["見る","みる"],["」"],["と"],["。"]]},{"verse":14,"text":"彼はわたしを、主の神殿の北に面した門の入り口に連れて行った。そこには、女たちがタンムズ神のために泣きながら座っているではないか。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["北","きた"],["に"],["面した","めんした"],["門","もん"],["の"],["入り口","いりぐち"],["に"],["連れて","つれて"],["行った","いった"],["。"],["そこ"],["に"],["は"],["、"],["女","おんな"],["たち"],["が"],["タンムズ"],["神","かみ"],["の"],["ため"],["に"],["泣き","なき"],["ながら"],["座って","すわって"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":15,"text":"そこで彼はわたしに言った。「人の子よ、見たか。あなたは、これより更に甚だしく忌まわしいことを見る」と。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["見た","みた"],["か"],["。"],["あなた"],["は"],["、"],["これ"],["より"],["更に","さらに"],["甚だしく","はなはだしく"],["忌まわしい","いまわしい"],["こと"],["を"],["見る","みる"],["」"],["と"],["。"]]},{"verse":16,"text":"彼はわたしを主の神殿の中庭に連れて行った。すると、主の聖所の入り口で、廊と祭壇の間に、二十五人ほどの人がいて、主の聖所を背にし、顔を東に向けていた。彼らは東に向かって太陽を拝んでいるではないか。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["中庭","なかにわ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["する"],["と"],["、"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["の"],["入り口","いりぐち"],["で"],["、"],["廊","ろう"],["と"],["祭壇","さいだん"],["の"],["間","あいだ"],["に"],["、"],["二十五人","にじゅうごにん"],["ほど"],["の"],["人","ひと"],["が"],["いて"],["、"],["主","ぬし"],["の"],["聖","せい"],["所","しょ"],["を"],["背","せ"],["に"],["し"],["、"],["顔","かお"],["を"],["東","ひがし"],["に"],["向けて","むけて"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["東","ひがし"],["に"],["向かって","むかって"],["太陽","たいよう"],["を"],["拝んで","おがんで"],["いるで"],["は"],["ない"],["か"],["。"]]},{"verse":17,"text":"彼はわたしに言った。「人の子よ、見たか。ユダの家がここで数々の忌まわしいことを行っているのは些細なことであろうか。彼らはこの地を不法で満たした。また、わたしの鼻に木の枝を突きつけて、わたしを更に怒らせようとしている。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["見た","みた"],["か"],["。"],["ユダ"],["の"],["家","いえ"],["が"],["ここ"],["で"],["数々","かずかず"],["の"],["忌まわしい","いまわしい"],["こと"],["を"],["行って","おこなって"],["いる"],["の"],["は"],["些細","ささい"],["な"],["こと"],["で"],["あろう"],["か"],["。"],["彼","かれ"],["ら"],["は"],["この"],["地","ち"],["を"],["不法","ふほう"],["で"],["満たした","みたした"],["。"],["また"],["、"],["わたし"],["の"],["鼻","はな"],["に"],["木","き"],["の"],["枝","えだ"],["を"],["突きつけて","つきつけて"],["、"],["わたし"],["を"],["更に","さらに"],["怒らせよう","おこらせよう"],["として"],["いる"],["。"]]},{"verse":18,"text":"わたしも憤って行い、慈しみの目を注ぐことも、憐れみをかけることもしない。彼らがわたしの耳に向かって大声をあげても、わたしは彼らに聞きはしない。」","tok":[["わたし"],["も"],["憤って","いきどおって"],["行い","おこない"],["、"],["慈しみ","いつくしみ"],["の"],["目","め"],["を"],["注ぐ","そそぐ"],["こと"],["も"],["、"],["憐れみ","あわれみ"],["を"],["かける"],["こと"],["も"],["しない"],["。"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["耳","みみ"],["に"],["向かって","むかって"],["大声","おおごえ"],["を"],["あげて"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["聞き","きき"],["は"],["しない"],["。"],["」"]]}]
エジプト"],["の"],["土地","とち"],["を"],["与える","あたえる"],["。"],["彼","かれ"],["は"],["その"],["富","とみ"],["を"],["運び去り","はこびさり"],["、"],["戦利品","せんりひん"],["を"],["分捕り","ぶんどり"],["、"],["略奪","りゃくだつ"],["を"],["ほしいまま"],["に"],["する"],["。"],["こう"],["して"],["、"],["エジプト"],["は"],["彼","かれ"],["の"],["軍隊","ぐんたい"],["の"],["報酬","ほうしゅう"],["と"],["なる"],["。"]]},{"verse":20,"text":"ティルスに対して費やした王の働きの報いとして、わたしは王にエジプトの土地を与える。彼らが、わたしに代わって、このことをしたからである、と主なる神は言われる。","tok":[["ティルス"],["に対して","にたいして"],["費やした","ついやした"],["王","おう"],["の"],["働き","はたらき"],["の"],["報い","むくい"],["として"],["、"],["わたし"],["は"],["王","おう"],["に"],["エジプト"],["の"],["土地","とち"],["を"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["が"],["、"],["わたし"],["に"],["代わって","かわって"],["、"],["この"],["こと"],["を"],["した"],["から"],["で"],["ある"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":21,"text":"その日、わたしはイスラエルの家のために一つの角を生えさせ、彼らの間にあってその口を開かせる。そのとき、彼らはわたしが主であることを知るようになる。」","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["イスラエル"],["の"],["家","いえ"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["角","かど"],["を"],["生えさせ","はえさせ"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["あって"],["その"],["口","くち"],["を"],["開かせる","ひらかせる"],["。"],["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]}]
[{"verse":1,"text":"第十年の十月十二日に主の言葉がわたしに臨んだ。","tok":[["第","だい"],["十","じゅう"],["年","ねん"],["の"],["十","じゅう"],["月","がつ"],["十二","じゅうに"],["日","にち"],["に"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、あなたの顔をエジプトの王ファラオに向けて、王とエジプトの全土に対して預言し、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["顔","かお"],["を"],["エジプト"],["の"],["王","おう"],["ファラオ"],["に"],["向けて","むけて"],["、"],["王","おう"],["と"],["エジプト"],["の"],["全土","ぜんど"],["に対して","にたいして"],["預言","よげん"],["し"],["、"]]},{"verse":3,"text":"語って言いなさい。主なる神はこう言われる。エジプトの王、ファラオよわたしはお前に立ち向かう。ナイル川の真ん中に横たわる巨大なわによお前は言う。『ナイル川はわたしのものわたしが自分のために造ったものだ』と。","tok":[["語","ご"],["って"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["エジプト"],["の"],["王","おう"],["、"],["ファラオ"],["よ"],["わたし"],["は"],["お前","おまえ"],["に"],["立ち向かう","たちむかう"],["。"],["ナイル"],["川","かわ"],["の"],["真ん中","まんなか"],["に"],["横たわる","よこたわる"],["巨大","きょだい"],["な"],["わに"],["よ"],["お前","おまえ"],["は"],["言う","ゆう"],["。"],["『"],["ナイル"],["川","かわ"],["は"],["わたし"],["の"],["もの"],["わたし"],["が"],["自分","じぶん"],["の"],["ため"],["に"],["造った","つくった"],["もの"],["だ"],["』"],["と"],["。"]]},{"verse":4,"text":"わたしはお前の顎に鉤をかけうろこにナイル川の魚をつけさせナイル川の真ん中から引き上げるお前のうろこについた川のすべての魚と共に。","tok":[["わたし"],["は"],["お前","おまえ"],["の"],["顎","あご"],["に"],["鉤","はり"],["を"],["かけ"],["うろこ"],["に"],["ナイル"],["川","かわ"],["の"],["魚","さかな"],["を"],["つけさせ"],["ナイル"],["川","かわ"],["の"],["真ん中","まんなか"],["から"],["引き上げる","ひきあげる"],["お前","おまえ"],["の"],["うろこ"],["に"],["ついた"],["川","かわ"],["の"],["すべて"],["の"],["魚","さかな"],["と"],["共","とも"],["に"],["。"]]},{"verse":5,"text":"わたしはお前を荒れ野に捨てるナイル川のすべての魚と共に。お前は地面に倒れたままで引き取る者も、葬る者もない。わたしは野の獣、空の鳥にお前を食物として与える。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["荒れ野","あれの"],["に"],["捨てる","すてる"],["ナイル"],["川","かわ"],["の"],["すべて"],["の"],["魚","さかな"],["と"],["共","とも"],["に"],["。"],["お前","おまえ"],["は"],["地面","じめん"],["に"],["倒れた","たおれた"],["まま"],["で"],["引き取る","ひきとる"],["者","もの"],["も"],["、"],["葬る","ほうむる"],["者","もの"],["も"],["ない"],["。"],["わたし"],["は"],["野","の"],["の"],["獣","けもの"],["、"],["空","そら"],["の"],["鳥","とり"],["に"],["お前","おまえ"],["を"],["食物","しょくもつ"],["として"],["与える","あたえる"],["。"]]},{"verse":6,"text":"エジプトのすべての住民はわたしが主であることを知るようになる。お前は、イスラエルの家にとって葦の杖にすぎない。","tok":[["エジプト"],["の"],["すべて"],["の"],["住民","じゅうみん"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["お前","おまえ"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["にとって"],["葦","あし"],["の"],["杖","つえ"],["に"],["すぎない"],["。"]]},{"verse":7,"text":"彼らがお前の手をつかむとお前は折れ、彼らの肩は砕けた。彼らが寄りかかると、お前は裂け彼らの腰はすべてふらついた。","tok":[["彼","かれ"],["ら"],["が"],["お前","おまえ"],["の"],["手","て"],["を"],["つかむ"],["と"],["お前","おまえ"],["は"],["折れ","おれ"],["、"],["彼","かれ"],["ら"],["の"],["肩","かた"],["は"],["砕けた","くだけた"],["。"],["彼","かれ"],["ら"],["が"],["寄りかかる","よりかかる"],["と"],["、"],["お前","おまえ"],["は"],["裂け","さけ"],["彼","かれ"],["ら"],["の"],["腰","こし"],["は"],["すべて"],["ふらついた"],["。"]]},{"verse":8,"text":"それゆえ、主なる神はこう言われる。わたしはお前に剣を臨ませ、お前の中から人も獣も絶ち滅ぼす。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["お前","おまえ"],["に"],["剣","けん"],["を"],["臨ませ","のぞませ"],["、"],["お前","おまえ"],["の"],["中","なか"],["から"],["人","ひと"],["も"],["獣","けもの"],["も"],["絶ち","たち"],["滅ぼす","ほろぼす"],["。"]]},{"verse":9,"text":"エジプトの地は荒野に変わり、廃虚となる。そのとき、彼らはわたしが主であることを知るようになる。お前が、『ナイル川はわたしのもの、わたしが造ったものだ』と言ったからだ。","tok":[["エジプト"],["の"],["地","ち"],["は"],["荒野","こうや"],["に"],["変わり","かわり"],["、"],["廃虚","はいきょ"],["と"],["なる"],["。"],["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["お前","おまえ"],["が"],["、"],["『"],["ナイル"],["川","かわ"],["は"],["わたし"],["の"],["もの"],["、"],["わたし"],["が"],["造った","つくった"],["もの"],["だ"],["』"],["と"],["言った","いった"],["から"],["だ"],["。"]]},{"verse":10,"text":"それゆえ、わたしはお前とお前のナイル川に立ち向かい、エジプトの地を廃虚とし、ミグドルからセベネを経て、クシュの境に至るまで荒野にする。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["お前","おまえ"],["と"],["お前","おまえ"],["の"],["ナイル"],["川","かわ"],["に"],["立ち向かい","たちむかい"],["、"],["エジプト"],["の"],["地","ち"],["を"],["廃虚","はいきょ"],["と"],["し"],["、"],["ミグドル"],["から"],["セベネ"],["を"],["経て","へて"],["、"],["クシュ"],["の"],["境","さかい"],["に"],["至る","いたる"],["まで"],["荒野","こうや"],["に"],["する"],["。"]]},{"verse":11,"text":"もはや人の足はそこを通らず、動物の足すら通ることなく、こうして四十年の間住む人はない。","tok":[["もはや"],["人","ひと"],["の"],["足","あし"],["は"],["そこ"],["を"],["通らず","とおらず"],["、"],["動物","どうぶつ"],["の"],["足","あし"],["すら"],["通る","とおる"],["こと"],["なく"],["、"],["こう"],["して"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["住む","すむ"],["人","ひと"],["は"],["ない"],["。"]]},{"verse":12,"text":"わたしはエジプト人の地を、荒れ果てた国々の中で、最も荒れ果てた地とする。その町々は荒れ廃れた町々の中で、四十年の間最も荒れ果てたものとなる。わたしはエジプト人を諸国民の中に散らし、国々の間に追いやる。","tok":[["わたし"],["は"],["エジプト"],["人","にん"],["の"],["地","ち"],["を"],["、"],["荒れ果てた","あれはてた"],["国々","くにぐに"],["の"],["中","なか"],["で"],["、"],["最も","もっとも"],["荒れ果てた","あれはてた"],["地","ち"],["と"],["する"],["。"],["その"],["町々","まちまち"],["は"],["荒れ","あれ"],["廃れた","すたれた"],["町々","まちまち"],["の"],["中","なか"],["で"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["最も","もっとも"],["荒れ果てた","あれはてた"],["もの"],["と"],["なる"],["。"],["わたし"],["は"],["エジプト"],["人","にん"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["中","なか"],["に"],["散らし","ちらし"],["、"],["国々","くにぐに"],["の"],["間","あいだ"],["に"],["追いやる","おいやる"],["。"]]},{"verse":13,"text":"まことに主なる神はこう言われる。四十年が終わると、わたしは散らされていた諸国民の間からエジプト人を集める。","tok":[["まこと"],["に"],["主","ぬし"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["四十","よんじゅう"],["年","ねん"],["が"],["終わる","おわる"],["と"],["、"],["わたし"],["は"],["散らされて","ちらされて"],["いた"],["諸","しょ"],["国民","こくみん"],["の"],["間","あいだ"],["から"],["エジプト"],["人","にん"],["を"],["集める","あつめる"],["。"]]},{"verse":14,"text":"わたしはエジプトの繁栄を回復する。わたしは彼らを出身地である上エジプト人の地に帰らせる。そこで彼らはささやかな王国を造る。","tok":[["わたし"],["は"],["エジプト"],["の"],["繁栄","はんえい"],["を"],["回復","かいふく"],["する"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["出身地","しゅっしんち"],["で"],["ある"],["上","うえ"],["エジプト"],["人","にん"],["の"],["地","ち"],["に"],["帰らせる","かえらせる"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["ささやか"],["な"],["王国","おうこく"],["を"],["造る","つくる"],["。"]]},{"verse":15,"text":"それは他の王国よりも低く、もはや彼らが他の国々の上に立つことはない。彼らが他の国々を踏みつけることがないように、わたしは彼らを小さくする。","tok":[["それ"],["は"],["他","た"],["の"],["王国","おう
[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、イスラエルの牧者たちに対して預言し、牧者である彼らに語りなさい。主なる神はこう言われる。災いだ、自分自身を養うイスラエルの牧者たちは。牧者は群れを養うべきではないか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["牧者","ぼくしゃ"],["たち"],["に対して","にたいして"],["預言","よげん"],["し"],["、"],["牧者","ぼくしゃ"],["で"],["ある"],["彼","かれ"],["ら"],["に"],["語り","かたり"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["災い","わざわい"],["だ"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["養う","やしなう"],["イスラエル"],["の"],["牧者","ぼくしゃ"],["たち"],["は"],["。"],["牧者","ぼくしゃ"],["は"],["群れ","むれ"],["を"],["養うべきで","やしなうべきで"],["は"],["ない"],["か"],["。"]]},{"verse":3,"text":"お前たちは乳を飲み、羊毛を身にまとい、肥えた動物を屠るが、群れを養おうとはしない。","tok":[["お前","おまえ"],["たち"],["は"],["乳","ちち"],["を"],["飲み","のみ"],["、"],["羊毛","ようもう"],["を"],["身","み"],["に"],["まとい"],["、"],["肥えた","こえた"],["動物","どうぶつ"],["を"],["屠る","ほふる"],["が"],["、"],["群れ","むれ"],["を"],["養おう","やしなおう"],["と"],["は"],["しない"],["。"]]},{"verse":4,"text":"お前たちは弱いものを強めず、病めるものをいやさず、傷ついたものを包んでやらなかった。また、追われたものを連れ戻さず、失われたものを探し求めず、かえって力ずくで、苛酷に群れを支配した。","tok":[["お前","おまえ"],["たち"],["は"],["弱い","よわい"],["もの"],["を"],["強めず","つよめず"],["、"],["病める","やめる"],["もの"],["を"],["いやさず"],["、"],["傷ついた","きずついた"],["もの"],["を"],["包んで","つつんで"],["やらなかった"],["。"],["また"],["、"],["追われた","おわれた"],["もの"],["を"],["連れ戻さず","つれもどさず"],["、"],["失われた","うしなわれた"],["もの"],["を"],["探し求めず","さがしもとめず"],["、"],["かえって"],["力","ちから"],["ずく"],["で"],["、"],["苛酷","かこく"],["に"],["群れ","むれ"],["を"],["支配","しはい"],["した"],["。"]]},{"verse":5,"text":"彼らは飼う者がいないので散らされ、あらゆる野の獣の餌食となり、ちりぢりになった。","tok":[["彼","かれ"],["ら"],["は"],["飼う","かう"],["者","もの"],["が"],["いない"],["ので"],["散らされ","ちらされ"],["、"],["あらゆる"],["野","の"],["の"],["獣","けもの"],["の"],["餌食","えじき"],["と"],["なり"],["、"],["ちりぢり"],["に"],["なった"],["。"]]},{"verse":6,"text":"わたしの群れは、すべての山、すべての高い丘の上で迷う。また、わたしの群れは地の全面に散らされ、だれひとり、探す者もなく、尋ね求める者もない。","tok":[["わたし"],["の"],["群れ","むれ"],["は"],["、"],["すべて"],["の"],["山","やま"],["、"],["すべて"],["の"],["高い","たかい"],["丘","おか"],["の
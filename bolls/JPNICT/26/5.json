[{"verse":1,"text":"人の子よ、あなたは鋭い剣を取って理髪師のかみそりのようにそれを手に持ち、あなたの髪の毛とひげをそり、その毛を秤にかけて分けなさい。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["鋭い","するどい"],["剣","けん"],["を"],["取って","とって"],["理髪師","りはつし"],["の"],["かみそり"],["の"],["よう"],["に"],["それ"],["を"],["手","て"],["に"],["持ち","もち"],["、"],["あなた"],["の"],["髪の毛","かみのけ"],["と"],["ひげ"],["を"],["そり"],["、"],["その"],["毛","け"],["を"],["秤","はかり"],["に"],["かけて"],["分け","わけ"],["なさい"],["。"]]},{"verse":2,"text":"その三分の一は包囲の期間が終わったときに都の中で火で燃やし、ほかの三分の一は都の周りで剣で打ち、残り三分の一は風に乗せて散らしなさい。わたしは剣を抜いてその後を追う。","tok":[["その"],["三分","さんぶん"],["の"],["一","いち"],["は"],["包囲","ほうい"],["の"],["期間","きかん"],["が"],["終わった","おわった"],["とき"],["に"],["都","と"],["の"],["中","なか"],["で"],["火","ひ"],["で"],["燃やし","もやし"],["、"],["ほか"],["の"],["三分","さんぶん"],["の"],["一","いち"],["は"],["都","と"],["の"],["周り","まわり"],["で"],["剣","けん"],["で"],["打ち","うち"],["、"],["残り","のこり"],["三分","さんぶん"],["の"],["一","いち"],["は"],["風","ふう"],["に"],["乗せて","のせて"],["散らし","ちらし"],["なさい"],["。"],["わたし"],["は"],["剣","けん"],["を"],["抜いて","ぬいて"],["その後","そのあと"],["を"],["追う","おう"],["。"]]},{"verse":3,"text":"あなたはその中から毛を少し取って着物の裾に包み、","tok":[["あなた"],["は"],["その"],["中","なか"],["から"],["毛","け"],["を"],["少し","すこし"],["取って","とって"],["着物","きもの"],["の"],["裾","すそ"],["に"],["包み","つつみ"],["、"]]},{"verse":4,"text":"更にその幾らかを取って火に投げ入れ、火で燃やしなさい。そこからまた火が出て、イスラエルの全家に及ぶであろう。","tok":[["更に","さらに"],["その"],["幾ら","いくら"],["か"],["を"],["取って","とって"],["火","ひ"],["に"],["投げ入れ","なげいれ"],["、"],["火","ひ"],["で"],["燃やし","もやし"],["なさい"],["。"],["そこ"],["から"],["また"],["火","ひ"],["が"],["出て","でて"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["に"],["及ぶで","およぶで"],["あろう"],["。"]]},{"verse":5,"text":"主なる神はこう言われる。「これはエルサレムのことである。わたしはこの都を国々の中に置き、その周りを諸国が取り巻くようにした。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["これ"],["は"],["エルサレム"],["の"],["こと"],["で"],["ある"],["。"],["わたし"],["は"],["この"],["都","と"],["を"],["国々","くにぐに"],["の"],["中","なか"],["に"],["置き","おき"],["、"],["その"],["周り","まわり"],["を"],["諸国","しょこく"],["が"],["取り巻く","とりまく"],["よう"],["に"],["した"],["。"]]},{"verse":6,"text":"しかし、この都はそれらの国々よりも、いっそうわたしの裁きに逆らい、周りの諸国より激しくわたしの掟に逆らった。まことに彼らはわたしの裁きを拒み、わたしの掟に従って歩もうとしなかった。」","tok":[["しかし"],["、"],["この"],["都","と"],["は"],["それ"],["ら"],["の"],["国々","くにぐに"],["より"],["も"],["、"],["いっそう"],["わたし"],["の"],["裁き","さばき"],["に"],["逆らい","さからい"],["、"],["周り","まわり"],["の"],["諸国","しょこく"],["より"],["激しく","はげしく"],["わたし"],["の"],["掟","おきて"],["に"],["逆らった","さからった"],["。"],["まこと"],["に"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["裁き","さばき"],["を"],["拒み","こばみ"],["、"],["わたし"],["の"],["掟","おきて"],["に"],["従って","したがって"],["歩もう","あゆもう"],["と"],["しなかった"],["。"],["」"]]},{"verse":7,"text":"それゆえ、主なる神はこう言われる。「お前たちが周りの国々よりもいっそうかたくなで、わたしの掟に従って歩まず、わたしの裁きを行わず、周りの国々で定められている裁きほどにも行わなかったので、","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["「"],["お前","おまえ"],["たち"],["が"],["周り","まわり"],["の"],["国々","くにぐに"],["より"],["も"],["いっそう"],["かたくな"],["で"],["、"],["わたし"],["の"],["掟","おきて"],["に"],["従って","したがって"],["歩まず","あゆまず"],["、"],["わたし"],["の"],["裁き","さばき"],["を"],["行わず","おこなわず"],["、"],["周り","まわり"],["の"],["国々","くにぐに"],["で"],["定められて","さだめられて"],["いる"],["裁き","さばき"],["ほど"],["に"],["も"],["行わなかった","おこなわなかった"],["ので"],["、"]]},{"verse":8,"text":"主なる神はこう言われる。わたしもお前に立ち向かい、国々の目の前でお前の中で裁きを行う。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["も"],["お前","おまえ"],["に"],["立ち向かい","たちむかい"],["、"],["国々","くにぐに"],["の"],["目","め"],["の"],["前","まえ"],["で"],["お前","おまえ"],["の"],["中","なか"],["で"],["裁き","さばき"],["を"],["行う","おこなう"],["。"]]},{"verse":9,"text":"わたしがお前に対して行うことは、わたしが今まで行ったこともなければ、またこれから再び行うこともないようなことである。それはお前が行ったあらゆる忌まわしいことのゆえである。","tok":[["わたし"],["が"],["お前","おまえ"],["に対して","にたいして"],["行う","おこなう"],["こと"],["は"],["、"],["わたし"],["が"],["今まで","いままで"],["行った","いった"],["こと"],["も"],["なければ"],["、"],["また"],["これ"],["から"],["再び","ふたたび"],["行う","おこなう"],["こと"],["も"],["ない"],["よう"],["な"],["こと"],["で"],["ある"],["。"],["それ"],["は"],["お前","おまえ"],["が"],["行った","おこなった"],["あらゆる"],["忌まわしい","いまわしい"],["こと"],["の"],["ゆえ"],["で"],["ある"],["。"]]},{"verse":10,"text":"それゆえ、お前の中で親がその子を食べ、子がその親を食べるようなことが起こる。わたしはお前に対して裁きを行い、残っている者をすべてあらゆる方向に散らせてしまう。","tok":[["それ"],["ゆえ"],["、"],["お前","おまえ"],["の"],["中","なか"],["で"],["親","おや"],["が"],["その"],["子","こ"],["を"],["食べ","たべ"],["、"],["子","こ"],["が"],["その"],["親","おや"],["を"],["食べる","たべる"],["よう"],["な"],["こと"],["が"],["起こる","おこる"],["。"],["わたし"],["は"],["お前","おまえ"],["に対して","にたいして"],["裁き","さばき"],["を"],["行い","おこない"],["、"],["残って","のこって"],["いる"],["者","もの"],["を"],["すべて"],["あらゆる"],["方向","ほうこう"],["に"],["散らせて","ちらせて"],["しまう"],["。"]]},{"verse":11,"text":"それゆえ――わたしは生きている、と主なる神は言われる――お前はあらゆる憎むべきものと忌まわしいものをもってわたしの聖所を汚したので、わたしもまた必ずお前をそり落とす。わたしは憐れみの目をかけず、同情もしない。","tok":[["それ"],["ゆえ"],["―"],["―"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["―"],["―"],["お前","おまえ"],["は"],["あらゆる"],["憎むべき","にくむべき"],["もの"],["と"],["忌まわしい","いまわしい"],["もの"],["を"],["もって"],["わたし"],["の"],["聖","せい"],["所","しょ"],["を"],["汚した","よごした"],["ので"],["、"],["わたし"],["も"],["また"],["必ず","かならず"],["お前","おまえ"],["を"],["そり落とす","そりおとす"],["。"],["わたし"],["は"],["憐れみ","あわれみ"],["の"],["目","め"],["を"],["かけず"],["、"],["同情","どうじょう"],["も"],["しない"],["。"]]},{"verse":12,"text":"お前の中で三分の一は疫病で死んだり、飢えで息絶えたりし、三分の一は都の周りで剣にかけられて倒れ、残る三分の一は、わたしがあらゆる方向に散らし、剣を抜いてその後を追う。","tok":[["お前","おまえ"],["の"],["中","なか"],["で"],["三分","さんぶん"],["の"],["一","いち"],["は"],["疫病","やくびょう"],["で"],["死ん","しん"],["だり"],["、"],["飢え","うえ"],["で"],["息","いき"],["絶え","たえ"],["たり"],["し"],["、"],["三分","さんぶん"],["の"],["一","いち"],["は"],["都","と"],["の"],["周り","まわり"],["で"],["剣","けん"],["に"],["かけられて"],["倒れ","たおれ"],["、"],["残る","のこる"],["三分","さんぶん"],["の"],["一","いち"],["は"],["、"],["わたし"],["が"],["あらゆる"],["方向","ほうこう"],["に"],["散らし","ちらし"],["、"],["剣","けん"],["を"],["抜いて","ぬいて"],["その後","そのあと"],["を"],["追う","おう"],["。"]]},{"verse":13,"text":"わたしは彼らに向かって怒れるだけ怒り、憤りに身をまかせて、恨みを晴らす。そのとき、主であるわたしが憤れるだけ憤り、熱情をもって語ったということを彼らは知るようになる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["向かって","むかって"],["怒れる","おこれる"],["だけ"],["怒り","おこり"],["、"],["憤り","いきどおり"],["に"],["身","み"],["を"],["まかせて"],["、"],["恨み","うらみ"],["を"],["晴らす","はらす"],["。"],["その"],["とき"],["、"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["憤れる","いきどおれる"],["だけ"],["憤り","いきどおり"],["、"],["熱情","ねつじょう"],["を"],["もって"],["語った","かたった"],["と"],["いう"],["こと"],["を"],["彼","かれ"],["ら"],["は"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":14,"text":"わたしはお前を廃虚とし、すべての旅人の目にも、周りの国々にも、嘲りの的とする。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["廃虚","はいきょ"],["と"],["し"],["、"],["すべて"],["の"],["旅人","たびびと"],["の"],["目","め"],["に"],["も"],["、"],["周り","まわり"],["の"],["国々","くにぐに"],["に"],["も"],["、"],["嘲り","あざけり"],["の"],["的","まと"],["と"],["する"],["。"]]},{"verse":15,"text":"わたしが怒りと憤りと激しい懲らしめをもってお前を裁くとき、お前は周りの国々の嘲りとそしりの的となり、教訓となり脅威となる。主なるわたしがこれを告げる。","tok":[["わたし"],["が"],["怒り","いかり"],["と"],["憤り","いきどおり"],["と"],["激しい","はげしい"],["懲らしめ","こらしめ"],["を"],["もって"],["お前","おまえ"],["を"],["裁く","さばく"],["とき"],["、"],["お前","おまえ"],["は"],["周り","まわり"],["の"],["国々","くにぐに"],["の"],["嘲り","あざけり"],["と"],["そしり"],["の"],["的","まと"],["と"],["なり"],["、"],["教訓","きょうくん"],["と"],["なり"],["脅威","きょうい"],["と"],["なる"],["。"],["主","おも"],["なる"],["わたし"],["が"],["これ"],["を"],["告げる","つげる"],["。"]]},{"verse":16,"text":"わたしは滅びに定められた者に対して悲惨な飢えの矢を放つ。お前たちを滅ぼすためにそれを放つとき、わたしは飢えをますますひどくし、パンをつるして蓄える棒を折る。","tok":[["わたし"],["は"],["滅び","ほろび"],["に"],["定められた","さだめられた"],["者","もの"],["に対して","にたいして"],["悲惨","ひさん"],["な"],["飢え","うえ"],["の"],["矢","や"],["を"],["放つ","はなつ"],["。"],["お前","おまえ"],["たち"],["を"],["滅ぼす","ほろぼす"],["ため"],["に"],["それ"],["を"],["放つ","はなつ"],["とき"],["、"],["わたし"],["は"],["飢え","うえ"],["を"],["ますます"],["ひどく"],["し"],["、"],["パン"],["を"],["つるして"],["蓄える","たくわえる"],["棒","ぼう"],["を"],["折る","おる"],["。"]]},{"verse":17,"text":"わたしは飢えと狂暴な獣をお前たちに送り込み、子供たちを奪わせる。疫病と流血はお前の中を通り抜ける。またわたしは剣をお前に臨ませる。主なるわたしがこれを告げる。」","tok":[["わたし"],["は"],["飢え","うえ"],["と"],["狂暴","きょうぼう"],["な"],["獣","けもの"],["を"],["お前","おまえ"],["たち"],["に"],["送り込み","おくりこみ"],["、"],["子供","こども"],["たち"],["を"],["奪わせる","うばわせる"],["。"],["疫病","やくびょう"],["と"],["流血","りゅうけつ"],["は"],["お前","おまえ"],["の"],["中","なか"],["を"],["通り抜ける","とおりぬける"],["。"],["また"],["わたし"],["は"],["剣","けん"],["を"],["お前","おまえ"],["に"],["臨ませる","のぞませる"],["。"],["主","おも"],["なる"],["わたし"],["が"],["これ"],["を"],["告げる","つげる"],["。"],["」"]]}]
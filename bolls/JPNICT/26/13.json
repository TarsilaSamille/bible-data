[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、イスラエルの預言者たちに向かって、預言しなさい。自分の心のままに預言する者たちに向かって預言し、言いなさい。主の言葉を聞け。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["預言者","よげんしゃ"],["たち"],["に"],["向かって","むかって"],["、"],["預言","よげん"],["し"],["なさい"],["。"],["自分","じぶん"],["の"],["心","こころ"],["の"],["まま"],["に"],["預言","よげん"],["する"],["者","もの"],["たち"],["に"],["向かって","むかって"],["預言","よげん"],["し"],["、"],["言い","いい"],["なさい"],["。"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":3,"text":"主なる神はこう言われる。災いだ、何も示されることなく、自分の霊の赴くままに歩む愚かな預言者たちは。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["災い","わざわい"],["だ"],["、"],["何","なん"],["も"],["示される","しめされる"],["こと"],["なく"],["、"],["自分","じぶん"],["の"],["霊","れい"],["の"],["赴く","おもむく"],["まま"],["に"],["歩む","あゆむ"],["愚か","おろか"],["な"],["預言者","よげんしゃ"],["たち"],["は"],["。"]]},{"verse":4,"text":"イスラエルよ、お前の預言者たちは廃虚にいる山犬のようだ。","tok":[["イスラエル"],["よ"],["、"],["お前","おまえ"],["の"],["預言者","よげんしゃ"],["たち"],["は"],["廃虚","はいきょ"],["に"],["いる"],["山犬","やまいぬ"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"お前たちは、主の日の戦いに耐えるために、城壁の破れ口に上ろうとせず、イスラエルの家を守る石垣を築こうともしない。","tok":[["お前","おまえ"],["たち"],["は"],["、"],["主","ぬし"],["の"],["日","ひ"],["の"],["戦い","たたかい"],["に"],["耐える","たえる"],["ため"],["に"],["、"],["城壁","じょうへき"],["の"],["破れ","やぶれ"],["口","くち"],["に"],["上ろう","のぼろう"],["と"],["せず"],["、"],["イスラエル"],["の"],["家","いえ"],["を"],["守る","まもる"],["石垣","いしがき"],["を"],["築こう","きずこう"],["と"],["も"],["しない"],["。"]]},{"verse":6,"text":"彼らはむなしい幻を見、欺きの占いを行い、主から遣わされてもいないのに、『主は言われる』と言って、その言葉が成就するのを待っている。","tok":[["彼","かれ"],["ら"],["は"],["むなしい"],["幻","まぼろし"],["を"],["見","み"],["、"],["欺き","あざむき"],["の"],["占い","うらない"],["を"],["行い","おこない"],["、"],["主","ぬし"],["から"],["遣わされて","つかわされて"],["も"],["いない"],["のに"],["、"],["『"],["主","ぬし"],["は"],["言われる","いわれる"],["』"],["と"],["言って","いって"],["、"],["その"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["する"],["の"],["を"],["待って","まって"],["いる"],["。"]]},{"verse":7,"text":"お前たちが見ているのはむなしい幻、お前たちが口にしているのは欺きの占いではないか。わたしが語ってもいないのに、『主は言われる』と言っている。","tok":[["お前","おまえ"],["たち"],["が"],["見て","みて"],["いる"],["の"],["は"],["むなしい"],["幻","まぼろし"],["、"],["お前","おまえ"],["たち"],["が"],["口","くち"],["に"],["して"],["いる"],["の"],["は"],["欺き","あざむき"],["の"],["占い","うらない"],["で"],["は"],["ない"],["か"],["。"],["わたし"],["が"],["語って","かたって"],["も"],["いない"],["のに"],["、"],["『"],["主","ぬし"],["は"],["言われる","いわれる"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":8,"text":"それゆえ、主なる神はこう言われる。お前たちはむなしいことを語り、欺きの幻を見ているので、わたしはお前たちに立ち向かう、と主なる神は言われる。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["むなしい"],["こと"],["を"],["語り","かたり"],["、"],["欺き","あざむき"],["の"],["幻","まぼろし"],["を"],["見て","みて"],["いる"],["ので"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["に"],["立ち向かう","たちむかう"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"わたしの手は、むなしい幻を見る預言者たちと、欺きを占う占い師たちに向けられる。彼らはわたしの民の集いに加えられず、イスラエルの家の記録にも記されず、イスラエルの土地に入ることもできない。そのとき、お前たちはわたしが主なる神であることを知るようになる。","tok":[["わたし"],["の"],["手","て"],["は"],["、"],["むなしい"],["幻","まぼろし"],["を"],["見る","みる"],["預言者","よげんしゃ"],["たち"],["と"],["、"],["欺き","あざむき"],["を"],["占う","うらなう"],["占い師","うらないし"],["たち"],["に"],["向けられる","むけられる"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["の"],["集い","つどい"],["に"],["加えられず","くわえられず"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["記録","きろく"],["に"],["も"],["記されず","しるされず"],["、"],["イスラエル"],["の"],["土地","とち"],["に"],["入る","はいる"],["こと"],["も"],["できない"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["が"],["主","おも"],["なる"],["神","かみ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":10,"text":"平和がないのに、彼らが『平和だ』と言ってわたしの民を惑わすのは、壁を築くときに漆喰を上塗りするようなものだ。","tok":[["平和","へいわ"],["が"],["ない"],["のに"],["、"],["彼","かれ"],["ら"],["が"],["『"],["平和","へいわ"],["だ"],["』"],["と"],["言って","いって"],["わたし"],["の"],["民","たみ"],["を"],["惑わす","まどわす"],["の"],["は"],["、"],["壁","かべ"],["を"],["築く","きずく"],["とき"],["に"],["漆喰","しっくい"],["を"],["上塗り","うわぬり"],["する"],["よう"],["な"],["もの"],["だ"],["。"]]},{"verse":11,"text":"漆喰を上塗りする者に言いなさい。『それは、はがれ落ちる』と。豪雨が襲えば、雹よ、お前たちも石のように落ちてくるし、暴風も突如として起こる。","tok":[["漆喰","しっくい"],["を"],["上塗り","うわぬり"],["する"],["者","もの"],["に"],["言い","いい"],["なさい"],["。"],["『"],["それ"],["は"],["、"],["はがれ落ちる","はがれおちる"],["』"],["と"],["。"],["豪雨","ごうう"],["が"],["襲えば","おそえば"],["、"],["雹","ひょう"],["よ"],["、"],["お前","おまえ"],["たち"],["も"],["石","いし"],["の"],["よう"],["に"],["落ちて","おちて"],["くる"],["し"],["、"],["暴風","ぼうふう"],["も"],["突如","とつじょ"],["として"],["起こる","おこる"],["。"]]},{"verse":12,"text":"壁が崩れ落ちれば、『先に施した上塗りはどこに行ったのか』とお前たちは言われるに違いない。","tok":[["壁","かべ"],["が"],["崩れ落ちれば","くずれおちれば"],["、"],["『"],["先","さき"],["に"],["施した","ほどこした"],["上塗り","うわぬり"],["は"],["どこ"],["に"],["行った","いった"],["の"],["か"],["』"],["と"],["お前","おまえ"],["たち"],["は"],["言われる","いわれる"],["に"],["違い","ちがい"],["ない"],["。"]]},{"verse":13,"text":"それゆえ、主なる神はこう言われる。わたしは憤りをもって、暴風を起こし、怒りをもって豪雨を降らせ、怒り狂って雹を石のように降らせ、すべてを破壊する。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["憤り","いきどおり"],["を"],["もって"],["、"],["暴風","ぼうふう"],["を"],["起こし","おこし"],["、"],["怒り","いかり"],["を"],["もって"],["豪雨","ごうう"],["を"],["降らせ","ふらせ"],["、"],["怒り狂って","いかりくるって"],["雹","ひょう"],["を"],["石","いし"],["の"],["よう"],["に"],["降らせ","ふらせ"],["、"],["すべて"],["を"],["破壊","はかい"],["する"],["。"]]},{"verse":14,"text":"お前たちが漆喰を塗った壁をわたしは破壊し、地面に打ちつけて、その基礎をむき出しにする。それが崩れ落ちるとき、お前たちもその中で滅びる。そのとき、お前たちは、わたしが主であることを知るようになる。","tok":[["お前","おまえ"],["たち"],["が"],["漆喰","しっくい"],["を"],["塗った","ぬった"],["壁","かべ"],["を"],["わたし"],["は"],["破壊","はかい"],["し"],["、"],["地面","じめん"],["に"],["打ちつけて","うちつけて"],["、"],["その"],["基礎","きそ"],["を"],["むき出し","むきだし"],["に"],["する"],["。"],["それ"],["が"],["崩れ落ちる","くずれおちる"],["とき"],["、"],["お前","おまえ"],["たち"],["も"],["その"],["中","なか"],["で"],["滅びる","ほろびる"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":15,"text":"わたしは、壁とそれに漆喰を塗った者たちに対し怒りを注ぎ尽くし、『壁もなくなり、それに上塗りをした者たちもいなくなった』とお前たちに言う。","tok":[["わたし"],["は"],["、"],["壁","かべ"],["と"],["それ"],["に"],["漆喰","しっくい"],["を"],["塗った","ぬった"],["者","もの"],["たち"],["に"],["対し","たいし"],["怒り","いかり"],["を"],["注ぎ","そそぎ"],["尽くし","つくし"],["、"],["『"],["壁","かべ"],["も"],["なくなり"],["、"],["それ"],["に"],["上塗り","うわぬり"],["を"],["した"],["者","もの"],["たち"],["も"],["いなく"],["なった"],["』"],["と"],["お前","おまえ"],["たち"],["に"],["言う","ゆう"],["。"]]},{"verse":16,"text":"エルサレムに預言するイスラエルの預言者たちよ。平和がないのに、都のために平和の幻を見る者たちよ、と主なる神は言われる。","tok":[["エルサレム"],["に"],["預言","よげん"],["する"],["イスラエル"],["の"],["預言者","よげんしゃ"],["たち"],["よ"],["。"],["平和","へいわ"],["が"],["ない"],["のに"],["、"],["都","と"],["の"],["ため"],["に"],["平和","へいわ"],["の"],["幻","まぼろし"],["を"],["見る","みる"],["者","もの"],["たち"],["よ"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":17,"text":"人の子よ、自分の心のままに預言するあなたの民の娘たちに顔を向け、彼女らに預言しなさい。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["自分","じぶん"],["の"],["心","こころ"],["の"],["まま"],["に"],["預言","よげん"],["する"],["あなた"],["の"],["民","たみ"],["の"],["娘","むすめ"],["たち"],["に"],["顔","かお"],["を"],["向け","むけ"],["、"],["彼女","かのじょ"],["ら"],["に"],["預言","よげん"],["し"],["なさい"],["。"]]},{"verse":18,"text":"あなたは言わねばならない。主なる神はこう言われる。災いだ、人々の魂を捕らえようとして、どの手首にも呪術のひもを縫い付け、どんな大きさの頭にも合わせて呪術の頭巾を作る女たちよ。お前たちはわたしの民の魂を捕らえ、自分たちの仲間の魂を生かしておこうとする。","tok":[["あなた"],["は"],["言わねば","いわねば"],["ならない"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["災い","わざわい"],["だ"],["、"],["人々","ひとびと"],["の"],["魂","たましい"],["を"],["捕らえよう","とらえよう"],["として"],["、"],["どの"],["手首","てくび"],["に"],["も"],["呪術","じゅじゅつ"],["の"],["ひも"],["を"],["縫い付け","ぬいつけ"],["、"],["どんな"],["大きさ","おおきさ"],["の"],["頭","あたま"],["に"],["も"],["合わせて","あわせて"],["呪術","じゅじゅつ"],["の"],["頭巾","ずきん"],["を"],["作る","つくる"],["女","おんな"],["たち"],["よ"],["。"],["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["民","たみ"],["の"],["魂","たましい"],["を"],["捕らえ","とらえ"],["、"],["自分","じぶん"],["たち"],["の"],["仲間","なかま"],["の"],["魂","たましい"],["を"],["生かして","いかして"],["おこう"],["と"],["する"],["。"]]},{"verse":19,"text":"お前たちは、ひと握りの大麦とひとかけらのパンのゆえに、わが民の前でわたしを汚し、欺きの言葉に聞き入るわが民を欺くことによって、死ぬべきではない者を殺し、生きるべきではない者を生かしている。","tok":[["お前","おまえ"],["たち"],["は"],["、"],["ひと握り","ひとにぎり"],["の"],["大麦","おおむぎ"],["と"],["ひとかけら"],["の"],["パン"],["の"],["ゆえ"],["に"],["、"],["わが"],["民","たみ"],["の"],["前","まえ"],["で"],["わたし"],["を"],["汚し","よごし"],["、"],["欺き","あざむき"],["の"],["言葉","ことば"],["に"],["聞き入る","ききいる"],["わが"],["民","たみ"],["を"],["欺く","あざむく"],["こと"],["によって"],["、"],["死ぬべきで","しぬべきで"],["は"],["ない"],["者","もの"],["を"],["殺し","ころし"],["、"],["生きるべきで","いきるべきで"],["は"],["ない"],["者","もの"],["を"],["生かして","いかして"],["いる"],["。"]]},{"verse":20,"text":"それゆえ、主なる神はこう言われる。わたしは、お前たちが、人々の魂を鳥を捕らえるように捕らえるために使っている呪術のひもに立ち向かい、それをお前たちの腕から引きちぎり、お前たちが鳥を捕らえるように捕らえた魂を解き放つ。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["が"],["、"],["人々","ひとびと"],["の"],["魂","たましい"],["を"],["鳥","とり"],["を"],["捕らえる","とらえる"],["よう"],["に"],["捕らえる","とらえる"],["ため"],["に"],["使って","つかって"],["いる"],["呪術","じゅじゅつ"],["の"],["ひも"],["に"],["立ち向かい","たちむかい"],["、"],["それ"],["を"],["お前","おまえ"],["たち"],["の"],["腕","うで"],["から"],["引きちぎり","ひきちぎり"],["、"],["お前","おまえ"],["たち"],["が"],["鳥","とり"],["を"],["捕らえる","とらえる"],["よう"],["に"],["捕らえた","とらえた"],["魂","たましい"],["を"],["解き放つ","ときはなつ"],["。"]]},{"verse":21,"text":"また、わたしはお前たちの頭巾を引き裂き、わが民をお前たちの手から救い出す。二度と、彼らがお前たちの手に捕らえられることはない。そのときお前たちは、わたしが主であることを知るようになる。","tok":[["また"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["頭巾","ずきん"],["を"],["引き裂き","ひきさき"],["、"],["わが"],["民","たみ"],["を"],["お前","おまえ"],["たち"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["。"],["二","に"],["度","ど"],["と"],["、"],["彼","かれ"],["ら"],["が"],["お前","おまえ"],["たち"],["の"],["手","て"],["に"],["捕らえられる","とらえられる"],["こと"],["は"],["ない"],["。"],["その"],["とき"],["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":22,"text":"お前たちは、わたしが苦しめようとはしていないのに、神に従う者の心を偽りをもって苦しめ、神に逆らう者の手を強め、彼らが悪の道から立ち帰って、命を得ることができないようにしている。","tok":[["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["苦しめよう","くるしめよう"],["と"],["は"],["して"],["いない"],["のに"],["、"],["神","かみ"],["に"],["従う","したがう"],["者","もの"],["の"],["心","こころ"],["を"],["偽り","いつわり"],["を"],["もって"],["苦しめ","くるしめ"],["、"],["神","かみ"],["に"],["逆らう","さからう"],["者","もの"],["の"],["手","て"],["を"],["強め","つよめ"],["、"],["彼","かれ"],["ら"],["が"],["悪","あく"],["の"],["道","みち"],["から"],["立ち帰って","たちかえって"],["、"],["命","いのち"],["を"],["得る","える"],["こと"],["が"],["できない"],["よう"],["に"],["して"],["いる"],["。"]]},{"verse":23,"text":"それゆえ、もはやお前たちがむなしい幻を見ることも占いをすることもなくなる。わたしは、お前たちの手からわが民を救い出す。そのときお前たちは、わたしが主であることを知るようになる。」","tok":[["それ"],["ゆえ"],["、"],["もはや"],["お前","おまえ"],["たち"],["が"],["むなしい"],["幻","まぼろし"],["を"],["見る","みる"],["こと"],["も"],["占い","うらない"],["を"],["する"],["こと"],["も"],["なくなる"],["。"],["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["の"],["手","て"],["から"],["わが"],["民","たみ"],["を"],["救い出す","すくいだす"],["。"],["その"],["とき"],["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]}]
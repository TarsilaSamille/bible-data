[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、あなたの同胞に語りかけ、彼らに言いなさい。わたしがある国に向かって剣を送るとき、その国の民は彼らの中から一人の人を選んで見張りとする。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["同胞","どうほう"],["に"],["語りかけ","かたりかけ"],["、"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["わたし"],["が"],["ある"],["国","くに"],["に"],["向かって","むかって"],["剣","けん"],["を"],["送る","おくる"],["とき"],["、"],["その"],["国","くに"],["の"],["民","たみ"],["は"],["彼","かれ"],["ら"],["の"],["中","なか"],["から"],["一人","ひとり"],["の"],["人","ひと"],["を"],["選んで","えらんで"],["見張り","みはり"],["と"],["する"],["。"]]},{"verse":3,"text":"彼は剣が国に向かって臨むのを見ると、角笛を吹き鳴らして民に警告する。","tok":[["彼","かれ"],["は"],["剣","けん"],["が"],["国","くに"],["に"],["向かって","むかって"],["臨む","のぞむ"],["の"],["を"],["見る","みる"],["と"],["、"],["角笛","つのぶえ"],["を"],["吹き鳴らして","ふきならして"],["民","みん"],["に"],["警告","けいこく"],["する"],["。"]]},{"verse":4,"text":"角笛の音を聞いた者が、聞いていながら警告を受け入れず、剣が彼に臨んで彼を殺したなら、血の責任は彼自身にある。","tok":[["角笛","つのぶえ"],["の"],["音","おと"],["を"],["聞いた","きいた"],["者","もの"],["が"],["、"],["聞いて","きいて"],["い"],["ながら"],["警告","けいこく"],["を"],["受け入れず","うけいれず"],["、"],["剣","けん"],["が"],["彼","かれ"],["に"],["臨んで","のぞんで"],["彼","かれ"],["を"],["殺したなら","ころしたなら"],["、"],["血","ち"],["の"],["責任","せきにん"],["は"],["彼","かれ"],["自身","じしん"],["に"],["ある"],["。"]]},{"verse":5,"text":"彼は角笛の音を聞いても警告を受け入れなかったのだから、血の責任は彼にある。彼が警告を受け入れていれば、自分の命を救いえたはずである。","tok":[["彼","かれ"],["は"],["角笛","つのぶえ"],["の"],["音","おと"],["を"],["聞いて","きいて"],["も"],["警告","けいこく"],["を"],["受け入れなかった","うけいれなかった"],["の"],["だ"],["から"],["、"],["血","ち"],["の"],["責任","せきにん"],["は"],["彼","かれ"],["に"],["ある"],["。"],["彼","かれ"],["が"],["警告","けいこく"],["を"],["受け入れて","うけいれて"],["いれば"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救い","すくい"],["えた"],["はず"],["で"],["ある"],["。"]]},{"verse":6,"text":"しかし、見張りが、剣の臨むのを見ながら、角笛を吹かず、民が警告を受けぬままに剣が臨み、彼らのうちから一人の命でも奪われるなら、たとえその人は自分の罪のゆえに死んだとしても、血の責任をわたしは見張りの手に求める。","tok":[["しかし"],["、"],["見張り","みはり"],["が"],["、"],["剣","けん"],["の"],["臨む","のぞむ"],["の"],["を"],["見","み"],["ながら"],["、"],["角笛","つのぶえ"],["を"],["吹かず","ふかず"],["、"],["民","みん"],["が"],["警告","けいこく"],["を"],["受けぬ","うけぬ"],["まま"],["に"],["剣","けん"],["が"],["臨み","のぞみ"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["から"],["一人","ひとり"],["の"],["命","いのち"],["で"],["も"],["奪われるなら","うばわれるなら"],["、"],["たとえ"],["その"],["人","ひと"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死んだ","しんだ"],["として"],["も"],["、"],["血","ち"],["の"],["責任","せきにん"],["を"],["わたし"],["は"],["見張り","みはり"],["の"],["手","て"],["に"],["求める","もとめる"],["。"]]},{"verse":7,"text":"人の子よ、わたしはあなたをイスラエルの家の見張りとした。あなたが、わたしの口から言葉を聞いたなら、わたしの警告を彼らに伝えねばならない。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["イスラエル"],["の"],["家","いえ"],["の"],["見張り","みはり"],["と"],["した"],["。"],["あなた"],["が"],["、"],["わたし"],["の"],["口","くち"],["から"],["言葉","ことば"],["を"],["聞いたなら","きいたなら"],["、"],["わたし"],["の"],["警告","けいこく"],["を"],["彼","かれ"],["ら"],["に"],["伝えねば","つたえねば"],["ならない"],["。"]]},{"verse":8,"text":"わたしが悪人に向かって、『悪人よ、お前は必ず死なねばならない』と言うとき、あなたが悪人に警告し、彼がその道から離れるように語らないなら、悪人は自分の罪のゆえに死んでも、血の責任をわたしはお前の手に求める。","tok":[["わたし"],["が"],["悪人","あくにん"],["に"],["向かって","むかって"],["、"],["『"],["悪人","あくにん"],["よ"],["、"],["お前","おまえ"],["は"],["必ず","かならず"],["死なねば","しなねば"],["ならない"],["』"],["と"],["言う","いう"],["とき"],["、"],["あなた"],["が"],["悪人","あくにん"],["に"],["警告","けいこく"],["し"],["、"],["彼","かれ"],["が"],["その"],["道","みち"],["から"],["離れる","はなれる"],["よう"],["に"],["語らないなら","かたらないなら"],["、"],["悪人","あくにん"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死んで","しんで"],["も"],["、"],["血","ち"],["の"],["責任","せきにん"],["を"],["わたし"],["は"],["お前","おまえ"],["の"],["手","て"],["に"],["求める","もとめる"],["。"]]},{"verse":9,"text":"しかし、もしあなたが悪人に対してその道から立ち帰るよう警告したのに、彼がその道から立ち帰らなかったのなら、彼は自分の罪のゆえに死に、あなたは自分の命を救う。","tok":[["しかし"],["、"],["もし"],["あなた"],["が"],["悪人","あくにん"],["に対して","にたいして"],["その"],["道","みち"],["から"],["立ち帰る","たちかえる"],["よう"],["警告","けいこく"],["した"],["のに"],["、"],["彼","かれ"],["が"],["その"],["道","みち"],["から"],["立ち帰らなかった","たちかえらなかった"],["の"],["なら"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死に","しに"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救う","すくう"],["。"]]},{"verse":10,"text":"人の子よ、イスラエルの家に言いなさい。お前たちはこう言っている。『我々の背きと過ちは我々の上にあり、我々はやせ衰える。どうして生きることができようか』と。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["言い","いい"],["なさい"],["。"],["お前","おまえ"],["たち"],["は"],["こう"],["言って","いって"],["いる"],["。"],["『"],["我々","われわれ"],["の"],["背き","そむき"],["と"],["過ち","あやまち"],["は"],["我々","われわれ"],["の"],["上","うえ"],["に"],["あり"],["、"],["我々","われわれ"],["は"],["やせ衰える","やせおとろえる"],["。"],["どう"],["して"],["生きる","いきる"],["こと"],["が"],["できよう"],["か"],["』"],["と"],["。"]]},{"verse":11,"text":"彼らに言いなさい。わたしは生きている、と主なる神は言われる。わたしは悪人が死ぬのを喜ばない。むしろ、悪人がその道から立ち帰って生きることを喜ぶ。立ち帰れ、立ち帰れ、お前たちの悪しき道から。イスラエルの家よ、どうしてお前たちは死んでよいだろうか。","tok":[["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["悪人","あくにん"],["が"],["死ぬ","しぬ"],["の"],["を"],["喜ばない","よろこばない"],["。"],["むしろ"],["、"],["悪人","あくにん"],["が"],["その"],["道","みち"],["から"],["立ち帰って","たちかえって"],["生きる","いきる"],["こと"],["を"],["喜ぶ","よろこぶ"],["。"],["立ち帰れ","たちかえれ"],["、"],["立ち帰れ","たちかえれ"],["、"],["お前","おまえ"],["たち"],["の"],["悪しき","あしき"],["道","みち"],["から"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["どう"],["して"],["お前","おまえ"],["たち"],["は"],["死んで","しんで"],["よいだろう"],["か"],["。"]]},{"verse":12,"text":"人の子よ、あなたの同胞に言いなさい。正しい人の正しさも、彼が背くときには、自分を救うことができない。また、悪人の悪も、彼がその悪から立ち帰るときには、自分をつまずかせることはない。正しい人でも、過ちを犯すときには、その正しさによって生きることはできない。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["同胞","どうほう"],["に"],["言い","いい"],["なさい"],["。"],["正しい","ただしい"],["人","ひと"],["の"],["正し","ただし"],["さ"],["も"],["、"],["彼","かれ"],["が"],["背く","そむく"],["とき"],["に"],["は"],["、"],["自分","じぶん"],["を"],["救う","すくう"],["こと"],["が"],["できない"],["。"],["また"],["、"],["悪人","あくにん"],["の"],["悪","あく"],["も"],["、"],["彼","かれ"],["が"],["その"],["悪","あく"],["から"],["立ち帰る","たちかえる"],["とき"],["に"],["は"],["、"],["自分","じぶん"],["を"],["つまずかせる"],["こと"],["は"],["ない"],["。"],["正しい","ただしい"],["人","ひと"],["で"],["も"],["、"],["過ち","あやまち"],["を"],["犯す","おかす"],["とき"],["に"],["は"],["、"],["その"],["正し","ただし"],["さ"],["によって"],["生きる","いきる"],["こと"],["は"],["できない"],["。"]]},{"verse":13,"text":"正しい人に向かって、わたしが、『お前は必ず生きる』と言ったとしても、もし彼が自分自身の正しさに頼って不正を行うなら、彼のすべての正しさは思い起こされることがなく、彼の行う不正のゆえに彼は死ぬ。","tok":[["正しい","ただしい"],["人","ひと"],["に"],["向かって","むかって"],["、"],["わたし"],["が"],["、"],["『"],["お前","おまえ"],["は"],["必ず","かならず"],["生きる","いきる"],["』"],["と"],["言った","いった"],["として"],["も"],["、"],["もし"],["彼","かれ"],["が"],["自分","じぶん"],["自身","じしん"],["の"],["正し","ただし"],["さ"],["に"],["頼って","たよって"],["不正","ふせい"],["を"],["行うなら","おこなうなら"],["、"],["彼","かれ"],["の"],["すべて"],["の"],["正し","ただし"],["さ"],["は"],["思い起こされる","おもいおこされる"],["こと"],["が"],["なく"],["、"],["彼","かれ"],["の"],["行う","おこなう"],["不正","ふせい"],["の"],["ゆえ"],["に"],["彼","かれ"],["は"],["死ぬ","しぬ"],["。"]]},{"verse":14,"text":"また、悪人に向かって、わたしが、『お前は必ず死ぬ』と言ったとしても、もし彼がその過ちから立ち帰って正義と恵みの業を行うなら、","tok":[["また"],["、"],["悪人","あくにん"],["に"],["向かって","むかって"],["、"],["わたし"],["が"],["、"],["『"],["お前","おまえ"],["は"],["必ず","かならず"],["死ぬ","しぬ"],["』"],["と"],["言った","いった"],["として"],["も"],["、"],["もし"],["彼","かれ"],["が"],["その"],["過ち","あやまち"],["から"],["立ち帰って","たちかえって"],["正義","まさよし"],["と"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["行うなら","おこなうなら"],["、"]]},{"verse":15,"text":"すなわち、その悪人が質物を返し、奪ったものを償い、命の掟に従って歩き、不正を行わないなら、彼は必ず生きる。死ぬことはない。","tok":[["すなわち"],["、"],["その"],["悪人","あくにん"],["が"],["質物","しちもつ"],["を"],["返し","かえし"],["、"],["奪った","うばった"],["もの"],["を"],["償い","つぐない"],["、"],["命","いのち"],["の"],["掟","おきて"],["に"],["従って","したがって"],["歩き","あるき"],["、"],["不正","ふせい"],["を"],["行わないなら","おこなわないなら"],["、"],["彼","かれ"],["は"],["必ず","かならず"],["生きる","いきる"],["。"],["死ぬ","しぬ"],["こと"],["は"],["ない"],["。"]]},{"verse":16,"text":"彼の犯したすべての過ちは思い起こされず、正義と恵みの業を行った者は必ず生きる。","tok":[["彼","かれ"],["の"],["犯した","おかした"],["すべて"],["の"],["過ち","あやまち"],["は"],["思い起こされず","おもいおこされず"],["、"],["正義","まさよし"],["と"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["行った","おこなった"],["者","もの"],["は"],["必ず","かならず"],["生きる","いきる"],["。"]]},{"verse":17,"text":"それなのに、あなたの同胞は言っている。『主の道は正しくない』と。しかし正しくないのは彼らの道である。","tok":[["それ"],["な"],["のに"],["、"],["あなた"],["の"],["同胞","どうほう"],["は"],["言って","いって"],["いる"],["。"],["『"],["主","ぬし"],["の"],["道","みち"],["は"],["正しく","ただしく"],["ない"],["』"],["と"],["。"],["しかし"],["正しく","ただしく"],["ない"],["の"],["は"],["彼","かれ"],["ら"],["の"],["道","みち"],["で"],["ある"],["。"]]},{"verse":18,"text":"正しい人でも、正しさから離れて不正を行うなら、その不正のゆえに彼は死ぬ。","tok":[["正しい","ただしい"],["人","ひと"],["で"],["も"],["、"],["正し","ただし"],["さ"],["から"],["離れて","はなれて"],["不正","ふせい"],["を"],["行うなら","おこなうなら"],["、"],["その"],["不正","ふせい"],["の"],["ゆえ"],["に"],["彼","かれ"],["は"],["死ぬ","しぬ"],["。"]]},{"verse":19,"text":"また、悪人でも、悪から離れて正義と恵みの業を行うなら、それゆえに彼は生きる。","tok":[["また"],["、"],["悪人","あくにん"],["で"],["も"],["、"],["悪","わる"],["から"],["離れて","はなれて"],["正義","まさよし"],["と"],["恵み","めぐみ"],["の"],["業","ごう"],["を"],["行うなら","おこなうなら"],["、"],["それ"],["ゆえ"],["に"],["彼","かれ"],["は"],["生きる","いきる"],["。"]]},{"verse":20,"text":"それなのに、お前たちは言っている。『主の道は正しくない』と。イスラエルの家よ、わたしは人をそれぞれの道に従って裁く。」","tok":[["それ"],["な"],["のに"],["、"],["お前","おまえ"],["たち"],["は"],["言って","いって"],["いる"],["。"],["『"],["主","ぬし"],["の"],["道","みち"],["は"],["正しく","ただしく"],["ない"],["』"],["と"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["わたし"],["は"],["人","ひと"],["を"],["それぞれ"],["の"],["道","みち"],["に"],["従って","したがって"],["裁く","さばく"],["。"],["」"]]},{"verse":21,"text":"我々の捕囚の第十二年十月五日に、エルサレムから逃れた者がわたしのもとに来て言った。「都は陥落した」と。","tok":[["我々","われわれ"],["の"],["捕囚","ほしゅう"],["の"],["第","だい"],["十二","じゅうに"],["年","ねん"],["十","じゅう"],["月","がつ"],["五日","いつか"],["に"],["、"],["エルサレム"],["から"],["逃れた","のがれた"],["者","もの"],["が"],["わたし"],["の"],["もと"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["都","と"],["は"],["陥落","かんらく"],["した"],["」"],["と"],["。"]]},{"verse":22,"text":"その逃れた者が来る前の晩、主の手がわたしの上に置かれ、翌朝、彼がわたしのもとに来る前に、主はわたしの口を開かれた。口が開かれて、わたしはもはや黙していなかった。","tok":[["その"],["逃れた","のがれた"],["者","もの"],["が"],["来る","くる"],["前","まえ"],["の"],["晩","ばん"],["、"],["主","ぬし"],["の"],["手","て"],["が"],["わたし"],["の"],["上","うえ"],["に"],["置かれ","おかれ"],["、"],["翌朝","よくあさ"],["、"],["彼","かれ"],["が"],["わたし"],["の"],["もと"],["に"],["来る","くる"],["前","まえ"],["に"],["、"],["主","ぬし"],["は"],["わたし"],["の"],["口","くち"],["を"],["開かれた","ひらかれた"],["。"],["口","くち"],["が"],["開かれて","ひらかれて"],["、"],["わたし"],["は"],["もはや"],["黙して","もくして"],["いなかった"],["。"]]},{"verse":23,"text":"主の言葉がわたしに臨んで言った。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んで","のぞんで"],["言った","いった"],["。"]]},{"verse":24,"text":"「人の子よ、イスラエルの土地のこれらの廃虚に住む者は言っている。『アブラハムはただひとりのとき、この土地を所有していた。我々の数は多い。我々にこの土地は所有として与えられている』と。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["土地","とち"],["の"],["これ"],["ら"],["の"],["廃虚","はいきょ"],["に"],["住む","すむ"],["者","もの"],["は"],["言って","いって"],["いる"],["。"],["『"],["アブラハム"],["は"],["ただ"],["ひとり"],["の"],["とき"],["、"],["この"],["土地","とち"],["を"],["所有","しょゆう"],["して"],["いた"],["。"],["我々","われわれ"],["の"],["数","かず"],["は"],["多い","おおい"],["。"],["我々","われわれ"],["に"],["この"],["土地","とち"],["は"],["所有","しょゆう"],["として"],["与えられて","あたえられて"],["いる"],["』"],["と"],["。"]]},{"verse":25,"text":"それゆえ、彼らに言いなさい。主なる神はこう言われる。お前たちは血のついたまま肉を食べ、偶像に向かって目を上げ、人の血を流している。それでも、お前たちはこの土地を所有できるのか。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["は"],["血","ち"],["の"],["ついた"],["まま"],["肉","にく"],["を"],["食べ","たべ"],["、"],["偶像","ぐうぞう"],["に"],["向かって","むかって"],["目","め"],["を"],["上げ","あげ"],["、"],["人","ひと"],["の"],["血","ち"],["を"],["流して","ながして"],["いる"],["。"],["それ"],["で"],["も"],["、"],["お前","おまえ"],["たち"],["は"],["この"],["土地","とち"],["を"],["所有","しょゆう"],["できる"],["の"],["か"],["。"]]},{"verse":26,"text":"お前たちは剣を頼みとし、忌まわしいことを行い、おのおの隣人の妻を犯している。それでも、お前たちはこの土地を所有できるのか。","tok":[["お前","おまえ"],["たち"],["は"],["剣","けん"],["を"],["頼み","たのみ"],["と"],["し"],["、"],["忌まわしい","いまわしい"],["こと"],["を"],["行い","おこない"],["、"],["おのおの"],["隣人","りんじん"],["の"],["妻","つま"],["を"],["犯して","おかして"],["いる"],["。"],["それ"],["で"],["も"],["、"],["お前","おまえ"],["たち"],["は"],["この"],["土地","とち"],["を"],["所有","しょゆう"],["できる"],["の"],["か"],["。"]]},{"verse":27,"text":"それゆえ、彼らにこう言いなさい。主なる神はこう言われる。わたしは生きている。廃虚にいる者たちは必ず剣に倒れる。野にいる者はすべて、獣に餌食として与え、砦と洞穴にいる者たちは疫病によって死ぬ。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["廃虚","はいきょ"],["に"],["いる"],["者","もの"],["たち"],["は"],["必ず","かならず"],["剣","けん"],["に"],["倒れる","たおれる"],["。"],["野","の"],["に"],["いる"],["者","もの"],["は"],["すべて"],["、"],["獣","けもの"],["に"],["餌食","えじき"],["として"],["与え","あたえ"],["、"],["砦","とりで"],["と"],["洞穴","ほらあな"],["に"],["いる"],["者","もの"],["たち"],["は"],["疫病","やくびょう"],["によって"],["死ぬ","しぬ"],["。"]]},{"verse":28,"text":"わたしはこの土地を荒れ地とし、荒廃した土地とする。この土地が誇った力はうせ、イスラエルの山々は荒れ果て、そこを通る者はなくなる。","tok":[["わたし"],["は"],["この"],["土地","とち"],["を"],["荒れ地","あれち"],["と"],["し"],["、"],["荒廃","こうはい"],["した"],["土地","とち"],["と"],["する"],["。"],["この"],["土地","とち"],["が"],["誇った","ほこった"],["力","ちから"],["は"],["うせ"],["、"],["イスラエル"],["の"],["山々","やまやま"],["は"],["荒れ果て","あれはて"],["、"],["そこ"],["を"],["通る","とおる"],["者","もの"],["は"],["なくなる"],["。"]]},{"verse":29,"text":"彼らが行ったすべての忌まわしいことのゆえに、わたしがこの土地を荒れ地とし、荒廃した地にするとき、彼らはわたしが主であることを知るようになる。","tok":[["彼","かれ"],["ら"],["が"],["行った","おこなった"],["すべて"],["の"],["忌まわしい","いまわしい"],["こと"],["の"],["ゆえ"],["に"],["、"],["わたし"],["が"],["この"],["土地","とち"],["を"],["荒れ地","あれち"],["と"],["し"],["、"],["荒廃","こうはい"],["した"],["地","ち"],["に"],["する"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":30,"text":"人の子よ、あなたの同胞は城壁の傍らや家の戸口に立ってあなたのことを語り、互いに語り合っている。『さあ、行って、どんな言葉が主から出るのか、聞こうではないか』と。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["同胞","どうほう"],["は"],["城壁","じょうへき"],["の"],["傍ら","かたわら"],["や"],["家","いえ"],["の"],["戸口","とぐち"],["に"],["立って","たって"],["あなた"],["の"],["こと"],["を"],["語り","かたり"],["、"],["互い","たがい"],["に"],["語り合って","かたりあって"],["いる"],["。"],["『"],["さあ"],["、"],["行って","いって"],["、"],["どんな"],["言葉","ことば"],["が"],["主","ぬし"],["から"],["出る","でる"],["の"],["か"],["、"],["聞こうで","きこうで"],["は"],["ない"],["か"],["』"],["と"],["。"]]},{"verse":31,"text":"そして、彼らはあなたのもとに来る。民は来て、あなたの前に座り、あなたの言葉を聞きはするが、それを行いはしない。彼らは口では好意を示すが、心は利益に向かっている。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["もと"],["に"],["来る","くる"],["。"],["民","たみ"],["は"],["来て","きて"],["、"],["あなた"],["の"],["前","まえ"],["に"],["座り","すわり"],["、"],["あなた"],["の"],["言葉","ことば"],["を"],["聞き","きき"],["は"],["する"],["が"],["、"],["それ"],["を"],["行い","おこない"],["は"],["しない"],["。"],["彼","かれ"],["ら"],["は"],["口","くち"],["で"],["は"],["好意","こうい"],["を"],["示す","しめす"],["が"],["、"],["心","こころ"],["は"],["利益","りえき"],["に"],["向かって","むかって"],["いる"],["。"]]},{"verse":32,"text":"見よ、あなたは彼らにとって、楽器にあわせて美しい声でうたうみだらな歌の歌い手のようだ。彼らはあなたの語ることを聞くが、それを行いはしない。","tok":[["見よ","みよ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["にとって"],["、"],["楽器","がっき"],["に"],["あわせて"],["美しい","うつくしい"],["声","こえ"],["で"],["うたう"],["みだら"],["な"],["歌","うた"],["の"],["歌い手","うたいて"],["の"],["よう"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["語る","かたる"],["こと"],["を"],["聞く","きく"],["が"],["、"],["それ"],["を"],["行い","おこない"],["は"],["しない"],["。"]]},{"verse":33,"text":"しかし、そのことが起こるとき――見よ、それは近づいている――彼らは自分たちの中に預言者がいたことを知るようになる。」","tok":[["しかし"],["、"],["その"],["こと"],["が"],["起こる","おこる"],["とき"],["―"],["―"],["見よ","みよ"],["、"],["それ"],["は"],["近づいて","ちかづいて"],["いる"],["―"],["―"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["中","なか"],["に"],["預言者","よげんしゃ"],["が"],["いた"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]}]
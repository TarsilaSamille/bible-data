[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、ティルスの君主に向かって言いなさい。主なる神はこう言われる。お前の心は高慢になり、そして言った。『わたしは神だ。わたしは海の真ん中にある神々の住みかに住まう』と。しかし、お前は人であって神ではない。ただ、自分の心が神の心のようだ、と思い込んでいるだけだ。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ティルス"],["の"],["君主","くんしゅ"],["に"],["向かって","むかって"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["の"],["心","こころ"],["は"],["高慢","こうまん"],["に"],["なり"],["、"],["そして"],["言った","いった"],["。"],["『"],["わたし"],["は"],["神","かみ"],["だ"],["。"],["わたし"],["は"],["海","うみ"],["の"],["真ん中","まんなか"],["に"],["ある"],["神々","かみがみ"],["の"],["住みか","すみか"],["に"],["住まう","すまう"],["』"],["と"],["。"],["しかし"],["、"],["お前","おまえ"],["は"],["人","ひと"],["で"],["あって"],["神","かみ"],["で"],["は"],["ない"],["。"],["ただ"],["、"],["自分","じぶん"],["の"],["心","こころ"],["が"],["神","かみ"],["の"],["心","こころ"],["の"],["よう"],["だ"],["、"],["と"],["思い込んで","おもいこんで"],["いる"],["だけ"],["だ"],["。"]]},{"verse":3,"text":"お前はダニエルよりも賢く、いかなる奥義もお前には隠されていない。","tok":[["お前","おまえ"],["は"],["ダニエル"],["より"],["も"],["賢く","かしこく"],["、"],["いかなる"],["奥義","おうぎ"],["も"],["お前","おまえ"],["に"],["は"],["隠されて","かくされて"],["いない"],["。"]]},{"verse":4,"text":"お前は知恵と悟りによって富を積み、金銀を宝庫に蓄えた。","tok":[["お前","おまえ"],["は"],["知恵","ちえ"],["と"],["悟り","さとり"],["によって"],["富","とみ"],["を"],["積み","つみ"],["、"],["金銀","きんぎん"],["を"],["宝庫","ほうこ"],["に"],["蓄えた","たくわえた"],["。"]]},{"verse":5,"text":"お前は取り引きに知恵を大いに働かせて富を増し加え、お前の心は富のゆえに高慢になった。","tok":[["お前","おまえ"],["は"],["取り引き","とりひき"],["に"],["知恵","ちえ"],["を"],["大いに","おおいに"],["働かせて","はたらかせて"],["富","とみ"],["を"],["増し加え","ましくわえ"],["、"],["お前","おまえ"],["の"],["心","こころ"],["は"],["富","とみ"],["の"],["ゆえ"],["に"],["高慢","こうまん"],["に"],["なった"],["。"]]},{"verse":6,"text":"それゆえ、主なる神はこう言われる。お前は自分の心が神の心のようだと思い込んでいる。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["は"],["自分","じぶん"],["の"],["心","こころ"],["が"],["神","かみ"],["の"],["心","こころ"],["の"],["よう"],["だ"],["と"],["思い込んで","おもいこんで"],["いる"],["。"]]},{"verse":7,"text":"それゆえ、わたしはお前に対して諸国の中でも最も暴虐な外国人を立ち向かわせる。彼らはお前の知恵の誇りに向かって剣を抜き、お前の栄華を汚し、","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["お前","おまえ"],["に対して","にたいして"],["諸国","しょこく"],["の"],["中","なか"],["で"],["も"],["最も","もっとも"],["暴虐","ぼうぎゃく"],["な"],["外国人","がいこくじん"],["を"],["立ち向かわせる","たちむかわせる"],["。"],["彼","かれ"],["ら"],["は"],["お前","おまえ"],["の"],["知恵","ちえ"],["の"],["誇り","ほこり"],["に"],["向かって","むかって"],["剣","けん"],["を"],["抜き","ぬき"],["、"],["お前","おまえ"],["の"],["栄華","えいが"],["を"],["汚し","よごし"],["、"]]},{"verse":8,"text":"お前を陰府に突き落とす。お前は海の真ん中で切り倒されて死ぬ。","tok":[["お前","おまえ"],["を"],["陰府","よみ"],["に"],["突き落とす","つきおとす"],["。"],["お前","おまえ"],["は"],["海","うみ"],["の"],["真ん中","まんなか"],["で"],["切り倒されて","きりたおされて"],["死ぬ","しぬ"],["。"]]},{"verse":9,"text":"お前は自分を殺す者の前でもなお、『わたしは神だ』と言い張るのか。お前は人であって、神ではなく、切り倒す者の手にある。","tok":[["お前","おまえ"],["は"],["自分","じぶん"],["を"],["殺す","ころす"],["者","もの"],["の"],["前","まえ"],["で"],["も"],["なお"],["、"],["『"],["わたし"],["は"],["神","かみ"],["だ"],["』"],["と"],["言い張る","いいはる"],["の"],["か"],["。"],["お前","おまえ"],["は"],["人","ひと"],["で"],["あって"],["、"],["神","かみ"],["で"],["は"],["なく"],["、"],["切り倒す","きりたおす"],["者","もの"],["の"],["手","て"],["に"],["ある"],["。"]]},{"verse":10,"text":"お前は割礼のない者として、外国人の手にかかって死ぬ。まことにわたしがこのことを語った」と主なる神は言われる。","tok":[["お前","おまえ"],["は"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["として"],["、"],["外国人","がいこくじん"],["の"],["手","て"],["に"],["かかって"],["死ぬ","しぬ"],["。"],["まこと"],["に"],["わたし"],["が"],["この"],["こと"],["を"],["語った","かたった"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":11,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":12,"text":"「人の子よ、ティルスの王に対して嘆きの歌をうたい、彼に言いなさい。主なる神はこう言われる。お前はあるべき姿を印章としたものであり知恵に満ち、美しさの極みである。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ティルス"],["の"],["王","おう"],["に対して","にたいして"],["嘆き","なげき"],["の"],["歌","うた"],["を"],["うたい"],["、"],["彼","かれ"],["に"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["は"],["あるべき"],["姿","すがた"],["を"],["印章",
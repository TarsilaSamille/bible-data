[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、マゴグの地のゴグ、すなわちメシェクとトバルの総首長に対して顔を向け、彼に預言して、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["マゴグ"],["の"],["地","ち"],["の"],["ゴグ"],["、"],["すなわち"],["メシェク"],["と"],["トバル"],["の"],["総","そう"],["首長","しゅちょう"],["に対して","にたいして"],["顔","かお"],["を"],["向け","むけ"],["、"],["彼","かれ"],["に"],["預言","よげん"],["して"],["、"]]},{"verse":3,"text":"言いなさい。主なる神はこう言われる。メシェクとトバルの総首長ゴグよ、わたしはお前に立ち向かう。","tok":[["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["メシェク"],["と"],["トバル"],["の"],["総","そう"],["首長","しゅちょう"],["ゴグ"],["よ"],["、"],["わたし"],["は"],["お前","おまえ"],["に"],["立ち向かう","たちむかう"],["。"]]},{"verse":4,"text":"わたしはお前を立ち帰らせ、お前の顎に鉤をかけて、お前とその全軍、馬と騎兵を連れ出す。彼らは皆完全に武装した大集団で、大盾と小盾を持ち、皆剣を持っている。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["立ち帰らせ","たちかえらせ"],["、"],["お前","おまえ"],["の"],["顎","あご"],["に"],["鉤","はり"],["を"],["かけて"],["、"],["お前","おまえ"],["と"],["その"],["全軍","ぜんぐん"],["、"],["馬","うま"],["と"],["騎兵","きへい"],["を"],["連れ出す","つれだす"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["完全","かんぜん"],["に"],["武装","ぶそう"],["した"],["大","だい"],["集団","しゅうだん"],["で"],["、"],["大","だい"],["盾","たて"],["と"],["小","こ"],["盾","たて"],["を"],["持ち","もち"],["、"],["皆","かい"],["剣","けん"],["を"],["持って","もって"],["いる"],["。"]]},{"verse":5,"text":"ペルシア、クシュ、プトが彼らと共におり、皆、盾を持ち、兜をかぶっている。","tok":[["ペルシア"],["、"],["クシュ"],["、"],["プト"],["が"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["おり"],["、"],["皆","みな"],["、"],["盾","たて"],["を"],["持ち","もち"],["、"],["兜","かぶと"],["を"],["かぶって"],["いる"],["。"]]},{"verse":6,"text":"ゴメルとそのすべての軍隊、北の果てのベト‧トガルマとそのすべての軍隊、それに多くの国民がお前と共にいる。","tok":[["ゴメル"],["と"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["、"],["北","きた"],["の"],["果て","はて"],["の"],["ベト"],["‧"],["トガルマ"],["と"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["、"],["それ"],["に"],["多く","おおく"],["の"],["国民","こくみん"],["が"],["お前","おまえ"],["と"],["共","とも"],["に"],["いる"],["。"]]},{"verse":7,"text":"備えをせよ。お前も、お前のもとに召集されるすべての集団も備えをせよ。お前は彼らの監督となれ。","tok":[["備え","そなえ"],["を"],["せよ"],["。"],["お前","おまえ"],["も"],["、"],["お前","おまえ"],["の"],["もと"],["に"],["召集","しょうしゅう"],["される"],["すべて"],["の"],["集団","しゅうだん"],["も"],["備え","そなえ"],["を"],["せよ"],["。"],["お前","おまえ"],["は"],["彼","かれ"],["ら"],["の"],["監督","かんとく"],["と"],["なれ"],["。"]]},{"verse":8,"text":"多くの日の後、お前は呼び出され、また、多くの年を経た後、一つの国を襲う。それは長く荒れ廃れていたイスラエルの山々で、そこには、剣の恐れから解放され、多くの民の中から集められた民がいる。彼らは多くの民の中から連れ出されて、今は皆、安らかに暮らしている。","tok":[["多く","おおく"],["の"],["日","ひ"],["の"],["後","あと"],["、"],["お前","おまえ"],["は"],["呼び出され","よびだされ"],["、"],["また"],["、"],["多く","おおく"],["の"],["年","とし"],["を"],["経た","へた"],["後","あと"],["、"],["一","ひと"],["つ"],["の"],["国","くに"],["を"],["襲う","おそう"],["。"],["それ"],["は"],["長く","ながく"],["荒れ","あれ"],["廃れて","すたれて"],["いた"],["イスラエル"],["の"],["山々","やまやま"],["で"],["、"],["そこ"],["に"],["は"],["、"],["剣","けん"],["の"],["恐れ","おそれ"],["から"],["解放","かいほう"],["され"],["、"],["多く","おおく"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["集められた","あつめられた"],["民","たみ"],["が"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["多く","おおく"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["連れ出されて","つれだされて"],["、"],["今","いま"],["は"],["皆","みな"],["、"],["安らか","やすらか"],["に"],["暮らして","くらして"],["いる"],["。"]]},{"verse":9,"text":"お前は嵐のように上って来て、地を覆う雲のように襲いかかる。お前とお前の全軍、お前と共にいる多くの民は。","tok":[["お前","おまえ"],["は"],["嵐","あらし"],["の"],["よう"],["に"],["上って","のぼって"],["来て","きて"],["、"],["地","ち"],["を"],["覆う","おおう"],["雲","くも"],["の"],["よう"],["に"],["襲いかかる","おそいかかる"],["。"],["お前","おまえ"],["と"],["お前","おまえ"],["の"],["全軍","ぜんぐん"],["、"],["お前","おまえ"],["と"],["共","とも"],["に"],["いる"],["多く","おおく"],["の"],["民","たみ"],["は"],["。"]]},{"verse":10,"text":"主なる神はこう言われる。その日、お前の心に言葉が浮かぶ。お前は悪い計画を立て、","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["その"],["日","ひ"],["、"],["お前","おまえ"],["の"],["心","こころ"],["に"],["言葉","ことば"],["が"],["浮かぶ","うかぶ"],["。"],["お前","おまえ"],["は"],["悪い","わるい"],["計画","けいかく"],["を"],["立て","たて"],["、"]]},{"verse":11,"text":"そして言う。『わたしは囲いのない国へ攻め上る。城壁もかんぬきも門もなく安らかに生活している静かな国を襲う』と。","tok":[["そして"],["言う","ゆう"],["。"],["『"],["わたし"],["は"],["囲い","かこい"],["の"],["ない"],["国","くに"],["へ"],["攻め上る","せめのぼる"],["。"],["城壁
[{"verse":1,"text":"第十一年、その月の第一日に、主の言葉がわたしに臨んだ。","tok":[["第","だい"],["十一","じゅういち"],["年","ねん"],["、"],["その"],["月","つき"],["の"],["第","だい"],["一","いち"],["日","にち"],["に"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、ティルスがエルサレムを嘲る。『ああ、諸国民の門であったお前は打ち破られ、わたしのものになった。わたしは富み、お前は廃れる。』","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ティルス"],["が"],["エルサレム"],["を"],["嘲る","あざける"],["。"],["『"],["ああ"],["、"],["諸","しょ"],["国民","こくみん"],["の"],["門","もん"],["で"],["あった"],["お前","おまえ"],["は"],["打ち破られ","うちやぶられ"],["、"],["わたし"],["の"],["もの"],["に"],["なった"],["。"],["わたし"],["は"],["富み","とみ"],["、"],["お前","おまえ"],["は"],["廃れる","すたれる"],["。"],["』"]]},{"verse":3,"text":"それゆえ、主なる神はこう言われる。ティルスよ、わたしがお前に立ち向かう。わたしは、海が波を巻き起こすように多くの国々をお前に立ち向かわせる。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["ティルス"],["よ"],["、"],["わたし"],["が"],["お前","おまえ"],["に"],["立ち向かう","たちむかう"],["。"],["わたし"],["は"],["、"],["海","うみ"],["が"],["波","なみ"],["を"],["巻き起こす","まきおこす"],["よう"],["に"],["多く","おおく"],["の"],["国々","くにぐに"],["を"],["お前","おまえ"],["に"],["立ち向かわせる","たちむかわせる"],["。"]]},{"verse":4,"text":"彼らはティルスの城壁を倒し、塔を破壊する。わたしはその土くれまでぬぐい去りティルスを裸の岩にする。","tok":[["彼","かれ"],["ら"],["は"],["ティルス"],["の"],["城壁","じょうへき"],["を"],["倒し","たおし"],["、"],["塔","とう"],["を"],["破壊","はかい"],["する"],["。"],["わたし"],["は"],["その"],["土くれ","つちくれ"],["まで"],["ぬぐい去り","ぬぐいさり"],["ティルス"],["を"],["裸","はだか"],["の"],["岩","いわ"],["に"],["する"],["。"]]},{"verse":5,"text":"ティルスは海の中にある網干し場となる。これはわたし自身が語ったことだと主なる神は言われる。ティルスは諸国民に略奪され","tok":[["ティルス"],["は"],["海","うみ"],["の"],["中","なか"],["に"],["ある"],["網","あみ"],["干し場","ほしば"],["と"],["なる"],["。"],["これ"],["は"],["わたし"],["自身","じしん"],["が"],["語った","かたった"],["こと"],["だ"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["ティルス"],["は"],["諸","しょ"],["国民","こくみん"],["に"],["略奪","りゃくだつ"],["され"]]},{"verse":6,"text":"陸にある周囲の町々も剣で滅ぼされる。そのとき彼らはわたしが主であることを知るようになる。","tok":[["陸","りく"],["に"],["ある"],["周囲","しゅうい"],["の"],["町々","まちまち"],["も"],["剣","けん"],["で"],["滅ぼされる","ほろぼされる"],["。"],["その"],["とき"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":7,"text":"主なる神はこう言われる。わたしは、王の王であるバビロンの王、ネブカドレツァルを北からティルスに来させる。彼は馬と戦車と騎兵と多くの軍勢を引き連れてくる。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["王","おう"],["の"],["王","おう"],["で"],["ある"],["バビロン"],["の"],["王","おう"],["、"],["ネブカドレツァル"],["を"],["北","きた"],["から"],["ティルス"],["に"],["来させる","きさせる"],["。"],["彼","かれ"],["は"],["馬","うま"],["と"],["戦車","せんしゃ"],["と"],["騎兵","きへい"],["と"],["多く","おおく"],["の"],["軍勢","ぐんぜい"],["を"],["引き連れて","ひきつれて"],["くる"],["。"]]},{"verse":8,"text":"彼は陸にある周囲の町々を剣で滅ぼしお前に向かって堡塁を築き塁を積み、大盾を立てる。","tok":[["彼","かれ"],["は"],["陸","りく"],["に"],["ある"],["周囲","しゅうい"],["の"],["町々","まちまち"],["を"],["剣","けん"],["で"],["滅ぼし","ほろぼし"],["お前","おまえ"],["に"],["向かって","むかって"],["堡塁","ほうるい"],["を"],["築き","きずき"],["塁","るい"],["を"],["積み","つみ"],["、"],["大","だい"],["盾","たて"],["を"],["立てる","たてる"],["。"]]},{"verse":9,"text":"彼は破城槌で城壁を突き崩し鉄の棒で塔を打ち壊す。","tok":[["彼","かれ"],["は"],["破城","はじょう"],["槌","つち"],["で"],["城壁","じょうへき"],["を"],["突き崩し","つきくずし"],["鉄","てつ"],["の"],["棒","ぼう"],["で"],["塔","とう"],["を"],["打ち壊す","ぶちこわす"],["。"]]},{"verse":10,"text":"軍馬が怒濤のように襲い土煙がお前を覆う。打ち破られた町に敵が突入するように彼らがお前の城門に攻め入るとき騎兵と戦車の車輪の音で城壁は揺れ動く。","tok":[["軍馬","ぐんば"],["が"],["怒濤","どとう"],["の"],["よう"],["に"],["襲い","おそい"],["土煙","つちけむり"],["が"],["お前","おまえ"],["を"],["覆う","おおう"],["。"],["打ち破られた","うちやぶられた"],["町","まち"],["に"],["敵","てき"],["が"],["突入","とつにゅう"],["する"],["よう"],["に"],["彼","かれ"],["ら"],["が"],["お前","おまえ"],["の"],["城門","じょうもん"],["に"],["攻め入る","せめいる"],["とき"],["騎兵","きへい"],["と"],["戦車","せんしゃ"],["の"],["車輪","しゃりん"],["の"],["音","おと"],["で"],["城壁","じょうへき"],["は"],["揺れ動く","ゆれうごく"],["。"]]},{"verse":11,"text":"軍馬のひづめで、町並みはすべて踏みにじられ民は剣で殺され、巨大な柱は地に倒れる。","tok":[["軍馬","ぐんば"],["の"],["ひづめ"],["で"],["、"],["町並み","まちなみ"],["は"],["すべて"],["踏みにじられ","ふみにじられ"],["民","みん"],["は"],["剣","けん"],["で"],["殺され","ころされ"],["、"],["巨大","きょだい"],["な"],["柱","はしら"],["は"],["地","ち"],["に"],["倒れる","たおれる"],["。"]]},{"verse":12,"text":"彼らは財宝を奪い、商品を略奪し城壁を破壊し、華やかな宮殿を壊し石や木や土くれまで海に投げ込む。","tok":[["彼","かれ"],["ら"],["は"],["財宝","ざいほう"],["を"],["奪い","うばい"],["、"],["商品","しょうひん"],["を"],["略奪","りゃくだつ"],["し"],["城壁","じょうへき"],["を"],["破壊","はかい"],["し"],["、"],["華やか","はなやか"],["な"],["宮殿","きゅうでん"],["を"],["壊し","こわし"],["石","いし"],["や"],["木","き"],["や"],["土くれ","つちくれ"],["まで"],["海","うみ"],["に"],["投げ込む","なげこむ"],["。"]]},{"verse":13,"text":"わたしはお前の騒がしい歌声をやめさせ竪琴の音が再び聞かれることはない。","tok":[["わたし"],["は"],["お前","おまえ"],["の"],["騒がしい","さわがしい"],["歌声","うたごえ"],["を"],["やめさせ"],["竪琴","たてごと"],["の"],["音","おと"],["が"],["再び","ふたたび"],["聞かれる","きかれる"],["こと"],["は"],["ない"],["。"]]},{"verse":14,"text":"わたしはお前を裸の岩にする。お前は網干し場となり再び建て直されることはない。これは主なるわたしが語ったことだと主なる神は言われる。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["裸","はだか"],["の"],["岩","いわ"],["に"],["する"],["。"],["お前","おまえ"],["は"],["網","あみ"],["干し場","ほしば"],["と"],["なり"],["再び","ふたたび"],["建て直される","たてなおされる"],["こと"],["は"],["ない"],["。"],["これ"],["は"],["主","おも"],["なる"],["わたし"],["が"],["語った","かたった"],["こと"],["だ"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"主なる神は、ティルスに向かってこう言われる。お前の中で、倒れた者が呻き、虐殺が行われるとき、町の倒れ落ちる響きで、島々は揺れ動かないだろうか。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["、"],["ティルス"],["に"],["向かって","むかって"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["の"],["中","なか"],["で"],["、"],["倒れた","たおれた"],["者","もの"],["が"],["呻き","うめき"],["、"],["虐殺","ぎゃくさつ"],["が"],["行われる","おこなわれる"],["とき"],["、"],["町","まち"],["の"],["倒れ落ちる","たおれおちる"],["響き","ひびき"],["で"],["、"],["島々","しまじま"],["は"],["揺れ動かないだろう","ゆれうごかないだろう"],["か"],["。"]]},{"verse":16,"text":"海の支配者たちは、皆その座から降り、礼服を取り去り、美しく織った衣服を脱ぐ。彼らは恐怖を身にまとい、地に座り、絶え間なく震えながらお前を見て驚きあきれる。","tok":[["海","うみ"],["の"],["支配者","しはいしゃ"],["たち"],["は"],["、"],["皆","みな"],["その"],["座","ざ"],["から"],["降り","ふり"],["、"],["礼服","れいふく"],["を"],["取り去り","とりさり"],["、"],["美しく","うつくしく"],["織った","おった"],["衣服","いふく"],["を"],["脱ぐ","ぬぐ"],["。"],["彼","かれ"],["ら"],["は"],["恐怖","きょうふ"],["を"],["身","み"],["に"],["まとい"],["、"],["地","ち"],["に"],["座り","すわり"],["、"],["絶え間","たえま"],["なく"],["震え","ふるえ"],["ながら"],["お前","おまえ"],["を"],["見て","みて"],["驚きあきれる","おどろきあきれる"],["。"]]},{"verse":17,"text":"彼らはお前に向かって嘆きの歌をうたって言う。ああ、あなたは滅びてしまった。海のかなたから来て住み着き誉れある町となったのに。この町とそこに住む民は海のつわものとなり海に住むすべての者を震え上がらせたのに。","tok":[["彼","かれ"],["ら"],["は"],["お前","おまえ"],["に"],["向かって","むかって"],["嘆き","なげき"],["の"],["歌","うた"],["を"],["うたって"],["言う","ゆう"],["。"],["ああ"],["、"],["あなた"],["は"],["滅びて","ほろびて"],["しまった"],["。"],["海","うみ"],["の"],["かなた"],["から"],["来て","きて"],["住み着き","すみつき"],["誉れ","ほまれ"],["ある"],["町","まち"],["と"],["なった"],["のに"],["。"],["この"],["町","まち"],["と"],["そこ"],["に"],["住む","すむ"],["民","たみ"],["は"],["海","うみ"],["の"],["つわもの"],["と"],["なり"],["海","うみ"],["に"],["住む","すむ"],["すべて"],["の"],["者","もの"],["を"],["震え上がらせた","ふるえあがらせた"],["のに"],["。"]]},{"verse":18,"text":"今や、その島々はあなたの倒れた日におののき海の島々は、あなたの終わりを見て恐れる。","tok":[["今","いま"],["や"],["、"],["その"],["島々","しまじま"],["は"],["あなた"],["の"],["倒れた","たおれた"],["日","ひ"],["に"],["おののき"],["海","かい"],["の"],["島々","しまじま"],["は"],["、"],["あなた"],["の"],["終わり","おわり"],["を"],["見て","みて"],["恐れる","おそれる"],["。"]]},{"verse":19,"text":"まことに、主なる神はこう言われる。わたしは、お前を住む者のない町のように荒れ果てた町とし、淵から水を湧き上がらせ、大水で覆う。","tok":[["まこと"],["に"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["は"],["、"],["お前","おまえ"],["を"],["住む","すむ"],["者","もの"],["の"],["ない"],["町","まち"],["の"],["よう"],["に"],["荒れ果てた","あれはてた"],["町","まち"],["と"],["し"],["、"],["淵","ふち"],["から"],["水","みず"],["を"],["湧き上がらせ","わきあがらせ"],["、"],["大水","おおみず"],["で"],["覆う","おおう"],["。"]]},{"verse":20,"text":"こうしてわたしは、穴に下る者たちと共に、お前をいにしえの民の中に落とす。また、お前を穴に下る者たちと共に、永遠の昔からの廃虚のような深い地に住まわせ、お前が生ける者の地で栄誉をもって住むことができないようにする。","tok":[["こう"],["して"],["わたし"],["は"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["共","とも"],["に"],["、"],["お前","おまえ"],["を"],["いにしえ"],["の"],["民","たみ"],["の"],["中","なか"],["に"],["落とす","おとす"],["。"],["また"],["、"],["お前","おまえ"],["を"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["たち"],["と"],["共","とも"],["に"],["、"],["永遠","えいえん"],["の"],["昔","むかし"],["から"],["の"],["廃虚","はいきょ"],["の"],["よう"],["な"],["深い","ふかい"],["地","ち"],["に"],["住まわせ","すまわせ"],["、"],["お前","おまえ"],["が"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["栄誉","えいよ"],["を"],["もって"],["住む","すむ"],["こと"],["が"],["できない"],["よう"],["に"],["する"],["。"]]},{"verse":21,"text":"わたしはお前を恐怖に落とす。それゆえ、お前は無に帰する。人が探し求めても、お前は永久に見いだされることはない」と主なる神は言われる。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["恐怖","きょうふ"],["に"],["落とす","おとす"],["。"],["それ"],["ゆえ"],["、"],["お前","おまえ"],["は"],["無","む"],["に"],["帰する","きする"],["。"],["人","ひと"],["が"],["探し求めて","さがしもとめて"],["も"],["、"],["お前","おまえ"],["は"],["永久","えいきゅう"],["に"],["見いだされる","みいだされる"],["こと"],["は"],["ない"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]}]
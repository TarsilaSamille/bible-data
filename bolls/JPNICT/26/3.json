[{"verse":1,"text":"彼はわたしに言われた。「人の子よ、目の前にあるものを食べなさい。この巻物を食べ、行ってイスラエルの家に語りなさい。」","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["目","め"],["の"],["前","まえ"],["に"],["ある"],["もの"],["を"],["食べ","たべ"],["なさい"],["。"],["この"],["巻物","まきもの"],["を"],["食べ","たべ"],["、"],["行って","いって"],["イスラエル"],["の"],["家","いえ"],["に"],["語り","かたり"],["なさい"],["。"],["」"]]},{"verse":2,"text":"わたしが口を開くと、主はこの巻物をわたしに食べさせて、","tok":[["わたし"],["が"],["口","くち"],["を"],["開く","ひらく"],["と"],["、"],["主","ぬし"],["は"],["この"],["巻物","まきもの"],["を"],["わたし"],["に"],["食べさせて","たべさせて"],["、"]]},{"verse":3,"text":"言われた。「人の子よ、わたしが与えるこの巻物を胃袋に入れ、腹を満たせ。」わたしがそれを食べると、それは蜜のように口に甘かった。","tok":[["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["が"],["与える","あたえる"],["この"],["巻物","まきもの"],["を"],["胃袋","いぶくろ"],["に"],["入れ","いれ"],["、"],["腹","はら"],["を"],["満たせ","みたせ"],["。"],["」"],["わたし"],["が"],["それ"],["を"],["食べる","たべる"],["と"],["、"],["それ"],["は"],["蜜","みつ"],["の"],["よう"],["に"],["口","くち"],["に"],["甘かった","あまかった"],["。"]]},{"verse":4,"text":"主はわたしに言われた。「人の子よ、イスラエルの家に行き、わたしの言葉を彼らに語りなさい。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["彼","かれ"],["ら"],["に"],["語り","かたり"],["なさい"],["。"]]},{"verse":5,"text":"まことに、あなたは、不可解な言語や難しい言葉を語る民にではなく、イスラエルの家に遣わされる。","tok":[["まこと"],["に"],["、"],["あなた"],["は"],["、"],["不可解","ふかかい"],["な"],["言語","げんご"],["や"],["難しい","むずかしい"],["言葉","ことば"],["を"],["語る","かたる"],["民","たみ"],["に"],["で"],["は"],["なく"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["遣わされる","つかわされる"],["。"]]},{"verse":6,"text":"あなたは聞き取ることができない不可解な言語や難しい言葉を語る多くの民に遣わされるのではない。もしわたしがあなたをそれらの民に遣わすのなら、彼らはあなたに聞き従うであろう。","tok":[["あなた"],["は"],["聞き取る","ききとる"],["こと"],["が"],["できない"],["不可解","ふかかい"],["な"],["言語","げんご"],["や"],["難しい","むずかしい"],["言葉","ことば"],["を"],["語る","かたる"],["多く","おおく"],["の"],["民","たみ"],["に"],["遣わされる","つかわされる"],["ので"],["は"],["ない"],["。"],["もし"],["わたし"],["が"],["あなた"],["を"],["それ"],["ら"],["の"],["民","たみ"],["に"],["遣わす","つかわす"],["の"],["なら"],["、"],["彼","かれ"],["ら"],["は"],["あなた"],["に"],["聞き従うで","ききしたがうで"],["あろう"],["。"]]},{"verse":7,"text":"しかし、イスラエルの家は、あなたに聞こうとはしない。まことに、彼らはわたしに聞こうとしない者だ。まことにイスラエルの家はすべて、額も硬く心も硬い。","tok":[["しかし"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["、"],["あなた"],["に"],["聞こう","きこう"],["と"],["は"],["しない"],["。"],["まこと"],["に"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["聞こう","きこう"],["と"],["しない"],["者","もの"],["だ"],["。"],["まこと"],["に"],["イスラエル"],["の"],["家","いえ"],["は"],["すべて"],["、"],["額","がく"],["も"],["硬く","かたく"],["心","こころ"],["も"],["硬い","かたい"],["。"]]},{"verse":8,"text":"今やわたしは、あなたの顔を彼らの顔のように硬くし、あなたの額を彼らの額のように硬くする。","tok":[["今","いま"],["や"],["わたし"],["は"],["、"],["あなた"],["の"],["顔","かお"],["を"],["彼","かれ"],["ら"],["の"],["顔","かお"],["の"],["よう"],["に"],["硬く","かたく"],["し"],["、"],["あなた"],["の"],["額","がく"],["を"],["彼","かれ"],["ら"],["の"],["額","がく"],["の"],["よう"],["に"],["硬く","かたく"],["する"],["。"]]},{"verse":9,"text":"あなたの額を岩よりも硬いダイヤモンドのようにする。彼らが反逆の家だからといって、彼らを恐れ、彼らの前にたじろいではならない。」","tok":[["あなた"],["の"],["額","がく"],["を"],["岩","いわ"],["より"],["も"],["硬い","かたい"],["ダイヤモンド"],["の"],["よう"],["に"],["する"],["。"],["彼","かれ"],["ら"],["が"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["と"],["いって"],["、"],["彼","かれ"],["ら"],["を"],["恐れ","おそれ"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["たじろいで"],["は"],["ならない"],["。"],["」"]]},{"verse":10,"text":"更に主は言われた。「人の子よ、わたしがあなたに語るすべての言葉を心におさめ、耳に入れておきなさい。","tok":[["更に","さらに"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["すべて"],["の"],["言葉","ことば"],["を"],["心","こころ"],["に"],["おさめ"],["、"],["耳","みみ"],["に"],["入れて","いれて"],["おき"],["なさい"],["。"]]},{"verse":11,"text":"そして捕囚となっている同胞のもとに行き、たとえ彼らが聞き入れようと拒もうと、『主なる神はこう言われる』と言いなさい。」","tok":[["そして"],["捕囚","ほしゅう"],["と"],["なって"],["いる"],["同胞","どうほう"],["の"],["もと"],["に"],["行き","いき"],["、"],["たとえ"],["彼","かれ"],["ら"],["が"],["聞き入れよう","ききいれよう"],["と"],["拒もう","こばもう"],["と"],["、"],["『"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["』"],["と"],["言い","いい"],["なさい"],["。"],["」"]]},{"verse":12,"text":"そのとき、霊がわたしを引き上げた。わたしは背後に、大きなとどろく音を聞いた。主の栄光が、その御座から上るときの音である。","tok":[["その"],["とき"],["、"],["霊","れい"],["が"],["わたし"],["を"],["引き上げた","ひきあげた"],["。"],["わたし"],["は"],["背後","はいご"],["に"],["、"],["大きな","おおきな"],["とどろく"],["音","おと"],["を"],["聞いた","きいた"],["。"],["主","ぬし"],["の"],["栄光","えいこう"],["が"],["、"],["その"],["御座","ぎょざ"],["から"],["上る","のぼる"],["とき"],["の"],["音","おと"],["で"],["ある"],["。"]]},{"verse":13,"text":"あの生き物の翼が互いに触れ合う音、生き物の傍らの車輪の音、かの大きなとどろく音を聞いた。","tok":[["あの"],["生き物","いきもの"],["の"],["翼","つばさ"],["が"],["互い","たがい"],["に"],["触れ合う","ふれあう"],["音","おと"],["、"],["生き物","いきもの"],["の"],["傍ら","かたわら"],["の"],["車輪","しゃりん"],["の"],["音","おと"],["、"],["かの"],["大きな","おおきな"],["とどろく"],["音","おと"],["を"],["聞いた","きいた"],["。"]]},{"verse":14,"text":"霊はわたしを引き上げて連れ去った。わたしは苦々しく、怒りに燃える心をもって出て行ったが、主の御手がわたしを強く捕らえていた。","tok":[["霊","れい"],["は"],["わたし"],["を"],["引き上げて","ひきあげて"],["連れ去った","つれさった"],["。"],["わたし"],["は"],["苦々しく","にがにがしく"],["、"],["怒り","いかり"],["に"],["燃える","もえる"],["心","こころ"],["を"],["もって"],["出て","でて"],["行った","いった"],["が"],["、"],["主","ぬし"],["の"],["御手","おて"],["が"],["わたし"],["を"],["強く","つよく"],["捕らえて","とらえて"],["いた"],["。"]]},{"verse":15,"text":"こうしてわたしは、ケバル川の河畔のテル‧アビブに住む捕囚民のもとに来たが、彼らの住んでいるそのところに座り、ぼう然として七日間、彼らの間にとどまっていた。","tok":[["こう"],["して"],["わたし"],["は"],["、"],["ケバル"],["川","かわ"],["の"],["河畔","かはん"],["の"],["テル"],["‧"],["アビブ"],["に"],["住む","すむ"],["捕囚民","ほしゅうみん"],["の"],["もと"],["に"],["来た","きた"],["が"],["、"],["彼","かれ"],["ら"],["の"],["住んで","すんで"],["いる"],["その"],["ところ"],["に"],["座り","すわり"],["、"],["ぼう然","ぼうぜん"],["として"],["七","なな"],["日間","かかん"],["、"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["に"],["とどまって"],["いた"],["。"]]},{"verse":16,"text":"七日の後、主の言葉がわたしに臨んだ。","tok":[["七日","ななか"],["の"],["後","あと"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":17,"text":"「人の子よ、わたしはあなたを、イスラエルの家の見張りとする。わたしの口から言葉を聞くなら、あなたはわたしに代わって彼らに警告せねばならない。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["見張り","みはり"],["と"],["する"],["。"],["わたし"],["の"],["口","くち"],["から"],["言葉","ことば"],["を"],["聞くなら","きくなら"],["、"],["あなた"],["は"],["わたし"],["に"],["代わって","かわって"],["彼","かれ"],["ら"],["に"],["警告","けいこく"],["せねば"],["ならない"],["。"]]},{"verse":18,"text":"わたしが悪人に向かって、『お前は必ず死ぬ』と言うとき、もしあなたがその悪人に警告して、悪人が悪の道から離れて命を得るように諭さないなら、悪人は自分の罪のゆえに死ぬが、彼の死の責任をあなたに問う。","tok":[["わたし"],["が"],["悪人","あくにん"],["に"],["向かって","むかって"],["、"],["『"],["お前","おまえ"],["は"],["必ず","かならず"],["死ぬ","しぬ"],["』"],["と"],["言う","いう"],["とき"],["、"],["もし"],["あなた"],["が"],["その"],["悪人","あくにん"],["に"],["警告","けいこく"],["して"],["、"],["悪人","あくにん"],["が"],["悪","あく"],["の"],["道","みち"],["から"],["離れて","はなれて"],["命","いのち"],["を"],["得る","える"],["よう"],["に"],["諭さないなら","さとさないなら"],["、"],["悪人","あくにん"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死ぬ","しぬ"],["が"],["、"],["彼","かれ"],["の"],["死","し"],["の"],["責任","せきにん"],["を"],["あなた"],["に"],["問う","とう"],["。"]]},{"verse":19,"text":"しかし、あなたが悪人に警告したのに、悪人が自分の悪と悪の道から立ち帰らなかった場合には、彼は自分の罪のゆえに死に、あなたは自分の命を救う。","tok":[["しかし"],["、"],["あなた"],["が"],["悪人","あくにん"],["に"],["警告","けいこく"],["した"],["のに"],["、"],["悪人","あくにん"],["が"],["自分","じぶん"],["の"],["悪","あく"],["と"],["悪","あく"],["の"],["道","みち"],["から"],["立ち帰らなかった","たちかえらなかった"],["場合","ばあい"],["に"],["は"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["死に","しに"],["、"],["あなた"],["は"],["自分","じぶん"],["の"],["命","いのち"],["を"],["救う","すくう"],["。"]]},{"verse":20,"text":"また、正しい人が自分の正しい生き方を離れて不正を行うなら、わたしは彼をつまずかせ、彼は死ぬ。あなたが彼に警告しなかったので、彼は自分の過ちのゆえに死ぬ。彼がなしてきた正しい生き方は覚えられない。また彼の死の責任をわたしはあなたに問う。","tok":[["また"],["、"],["正しい","ただしい"],["人","ひと"],["が"],["自分","じぶん"],["の"],["正しい","ただしい"],["生き方","いきかた"],["を"],["離れて","はなれて"],["不正","ふせい"],["を"],["行うなら","おこなうなら"],["、"],["わたし"],["は"],["彼","かれ"],["を"],["つまずかせ"],["、"],["彼","かれ"],["は"],["死ぬ","しぬ"],["。"],["あなた"],["が"],["彼","かれ"],["に"],["警告","けいこく"],["しなかった"],["ので"],["、"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["過ち","あやまち"],["の"],["ゆえ"],["に"],["死ぬ","しぬ"],["。"],["彼","かれ"],["が"],["なして"],["きた"],["正しい","ただしい"],["生き方","いきかた"],["は"],["覚えられない","おぼえられない"],["。"],["また"],["
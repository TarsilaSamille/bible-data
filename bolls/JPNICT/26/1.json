[{"verse":1,"text":"第三十年の四月五日のことである。わたしはケバル川の河畔に住んでいた捕囚の人々の間にいたが、そのとき天が開かれ、わたしは神の顕現に接した。","tok":[["第","だい"],["三十","さんじゅう"],["年","ねん"],["の"],["四","よん"],["月","がつ"],["五日","いつか"],["の"],["こと"],["で"],["ある"],["。"],["わたし"],["は"],["ケバル"],["川","かわ"],["の"],["河畔","かはん"],["に"],["住んで","すんで"],["いた"],["捕囚","ほしゅう"],["の"],["人々","ひとびと"],["の"],["間","あいだ"],["に"],["いた"],["が"],["、"],["その"],["とき"],["天","てん"],["が"],["開かれ","ひらかれ"],["、"],["わたし"],["は"],["神","かみ"],["の"],["顕現","けんげん"],["に"],["接した","せっした"],["。"]]},{"verse":2,"text":"それは、ヨヤキン王が捕囚となって第五年の、その月の五日のことであった。","tok":[["それ"],["は"],["、"],["ヨヤキン"],["王","おう"],["が"],["捕囚","ほしゅう"],["と"],["なって"],["第","だい"],["五","ご"],["年","ねん"],["の"],["、"],["その"],["月","つき"],["の"],["五日","いつか"],["の"],["こと"],["で"],["あった"],["。"]]},{"verse":3,"text":"カルデアの地ケバル川の河畔で、主の言葉が祭司ブジの子エゼキエルに臨み、また、主の御手が彼の上に臨んだ。","tok":[["カルデア"],["の"],["地","ち"],["ケバル"],["川","かわ"],["の"],["河畔","かはん"],["で"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["祭司","さいし"],["ブジ"],["の"],["子","こ"],["エゼキエル"],["に"],["臨み","のぞみ"],["、"],["また"],["、"],["主","ぬし"],["の"],["御手","おて"],["が"],["彼","かれ"],["の"],["上","うえ"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":4,"text":"わたしが見ていると、北の方から激しい風が大いなる雲を巻き起こし、火を発し、周囲に光を放ちながら吹いてくるではないか。その中、つまりその火の中には、琥珀金の輝きのようなものがあった。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["北","きた"],["の"],["方","ほう"],["から"],["激しい","はげしい"],["風","かぜ"],["が"],["大いなる","おおいなる"],["雲","くも"],["を"],["巻き起こし","まきおこし"],["、"],["火","ひ"],["を"],["発し","はっし"],["、"],["周囲","しゅうい"],["に"],["光","ひかり"],["を"],["放ち","はなち"],["ながら"],["吹いて","ふいて"],["くるで"],["は"],["ない"],["か"],["。"],["その"],["中","なか"],["、"],["つまり"],["その"],["火","ひ"],["の"],["中","なか"],["に"],["は"],["、"],["琥珀金","こはくきん"],["の"],["輝き","かがやき"],["の"],["よう"],["な"],["もの"],["が"],["あった"],["。"]]},{"verse":5,"text":"またその中には、四つの生き物の姿があった。その有様はこうであった。彼らは人間のようなものであった。","tok":[["また"],["その"],["中","なか"],["に"],["は"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["の"],["姿","すがた"],["が"],["あった"],["。"],["その"],["有様","ありさま"],["は"],["こう"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["人間","にんげん"],["の"],["よう"],["な"],["もの"],["で"],["あった"],["。"]]},{"verse":6,"text":"それぞれが四つの顔を持ち、四つの翼を持っていた。","tok":[["それぞれ"],["が"],["四","よん"],["つ"],["の"],["顔","かお"],["を"],["持ち","もち"],["、"],["四","よん"],["つ"],["の"],["翼","つばさ"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":7,"text":"脚はまっすぐで、足の裏は子牛の足の裏に似ており、磨いた青銅が輝くように光を放っていた。","tok":[["脚","あし"],["は"],["まっすぐ"],["で"],["、"],["足","あし"],["の"],["裏","うら"],["は"],["子牛","こうし"],["の"],["足","あし"],["の"],["裏","うら"],["に"],["似て","にて"],["おり"],["、"],["磨いた","みがいた"],["青銅","せいどう"],["が"],["輝く","かがやく"],["よう"],["に"],["光","ひかり"],["を"],["放って","はなって"],["いた"],["。"]]},{"verse":8,"text":"また、翼の下には四つの方向に人間の手があった。四つとも、それぞれの顔と翼を持っていた。","tok":[["また"],["、"],["翼","つばさ"],["の"],["下","した"],["に"],["は"],["四","よん"],["つ"],["の"],["方向","ほうこう"],["に"],["人間","にんげん"],["の"],["手","て"],["が"],["あった"],["。"],["四","よん"],["つ"],["と"],["も"],["、"],["それぞれ"],["の"],["顔","かお"],["と"],["翼","つばさ"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":9,"text":"翼は互いに触れ合っていた。それらは移動するとき向きを変えず、それぞれ顔の向いている方向に進んだ。","tok":[["翼","つばさ"],["は"],["互い","たがい"],["に"],["触れ合って","ふれあって"],["いた"],["。"],["それ"],["ら"],["は"],["移動","いどう"],["する"],["とき向き","ときむき"],["を"],["変えず","かえず"],["、"],["それぞれ"],["顔","かお"],["の"],["向いて","むいて"],["いる"],["方向","ほうこう"],["に"],["進んだ","すすんだ"],["。"]]},{"verse":10,"text":"その顔は人間の顔のようであり、四つとも右に獅子の顔、左に牛の顔、そして四つとも後ろには鷲の顔を持っていた。","tok":[["その"],["顔","かお"],["は"],["人間","にんげん"],["の"],["顔","かお"],["の"],["よう"],["で"],["あり"],["、"],["四","よん"],["つ"],["とも"],["右","みぎ"],["に"],["獅子","しし"],["の"],["顔","かお"],["、"],["左","ひだり"],["に"],["牛","うし"],["の"],["顔","かお"],["、"],["そして"],["四","よん"],["つ"],["とも"],["後ろ","うしろ"],["に"],["は"],["鷲","わし"],["の"],["顔","かお"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":11,"text":"顔はそのようになっていた。翼は上に向かって広げられ、二つは互いに触れ合い、ほかの二つは体を覆っていた。","tok":[["顔","かお"],["は"],["その"],["よう"],["に"],["なって"],["いた"],["。"],["翼","つばさ"],["は"],["上","うえ"],["に"],["向かって","むかって"],["広げられ","ひろげられ"],["、"],["二","ふた"],["つ"],["は"],["互い","たがい"],["に"],["触れ合い","ふれあい"],["、"],["ほか"],["の"],["二","ふた"],["つ"],["は"],["体","からだ"],["を"],["覆って","おおって"],["いた"],["。"]]},{"verse":12,"text":"それらはそれぞれの顔の向いている方向に進み、霊の行かせる所へ進んで、移動するときに向きを変えることはなかった。","tok":[["それ"],["ら"],["は"],["それぞれ"],["の"],["顔","かお"],["の"],["向いて","むいて"],["いる"],["方向","ほうこう"],["に"],["進み","すすみ"],["、"],["霊","れい"],["の"],["行かせる","いかせる"],["所","ところ"],["へ"],["進んで","すすんで"],["、"],["移動","いどう"],["する"],["とき"],["に"],["向き","むき"],["を"],["変える","かえる"],["こと"],["は"],["なかった"],["。"]]},{"verse":13,"text":"生き物の姿、彼らの有様は燃える炭火の輝くようであり、松明の輝くように生き物の間を行き巡っていた。火は光り輝き、火から稲妻が出ていた。","tok":[["生き物","いきもの"],["の"],["姿","すがた"],["、"],["彼","かれ"],["ら"],["の"],["有様","ありさま"],["は"],["燃える","もえる"],["炭火","すみび"],["の"],["輝く","かがやく"],["よう"],["で"],["あり"],["、"],["松明","たいまつ"],["の"],["輝く","かがやく"],["よう"],["に"],["生き物","いきもの"],["の"],["間","あいだ"],["を"],["行き","いき"],["巡って","めぐって"],["いた"],["。"],["火","ひ"],["は"],["光り輝き","ひかりかがやき"],["、"],["火","ひ"],["から"],["稲妻","いなずま"],["が"],["出て","でて"],["いた"],["。"]]},{"verse":14,"text":"そして生き物もまた、稲妻の光るように出たり戻ったりしていた。","tok":[["そして"],["生き物","いきもの"],["も"],["また"],["、"],["稲妻","いなずま"],["の"],["光る","ひかる"],["よう"],["に"],["出","で"],["たり"],["戻っ","もどっ"],["たり"],["して"],["いた"],["。"]]},{"verse":15,"text":"わたしが生き物を見ていると、四つの顔を持つ生き物の傍らの地に一つの車輪が見えた。","tok":[["わたし"],["が"],["生き物","いきもの"],["を"],["見て","みて"],["いる"],["と"],["、"],["四","よん"],["つ"],["の"],["顔","かお"],["を"],["持つ","もつ"],["生き物","いきもの"],["の"],["傍ら","かたわら"],["の"],["地","ち"],["に"],["一","ひと"],["つ"],["の"],["車輪","しゃりん"],["が"],["見えた","みえた"],["。"]]},{"verse":16,"text":"それらの車輪の有様と構造は、緑柱石のように輝いていて、四つとも同じような姿をしていた。その有様と構造は車輪の中にもう一つの車輪があるかのようであった。","tok":[["それ"],["ら"],["の"],["車輪","しゃりん"],["の"],["有様","ありさま"],["と"],["構造","こうぞう"],["は"],["、"],["緑柱石","りょくちゅうせき"],["の"],["よう"],["に"],["輝いて","かがやいて"],["いて"],["、"],["四","よん"],["つ"],["とも"],["同じ","おなじ"],["よう"],["な"],["姿","すがた"],["を"],["して"],["いた"],["。"],["その"],["有様","ありさま"],["と"],["構造","こうぞう"],["は"],["車輪","しゃりん"],["の"],["中","なか"],["に"],["もう"],["一","ひと"],["つ"],["の"],["車輪","しゃりん"],["が"],["ある"],["か"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":17,"text":"それらが移動するとき、四つの方向のどちらにも進むことができ、移動するとき向きを変えることはなかった。","tok":[["それ"],["ら"],["が"],["移動","いどう"],["する"],["とき"],["、"],["四","よん"],["つ"],["の"],["方向","ほうこう"],["の"],["どちら"],["に"],["も"],["進む","すすむ"],["こと"],["が"],["でき"],["、"],["移動","いどう"],["する"],["とき向き","ときむき"],["を"],["変える","かえる"],["こと"],["は"],["なかった"],["。"]]},{"verse":18,"text":"車輪の外枠は高く、恐ろしかった。車輪の外枠には、四つとも周囲一面に目がつけられていた。","tok":[["車輪","しゃりん"],["の"],["外枠","そとわく"],["は"],["高く","たかく"],["、"],["恐ろしかった","おそろしかった"],["。"],["車輪","しゃりん"],["の"],["外枠","そとわく"],["に"],["は"],["、"],["四","よん"],["つ"],["とも"],["周囲","しゅうい"],["一面","いちめん"],["に"],["目","め"],["が"],["つけられて"],["いた"],["。"]]},{"verse":19,"text":"生き物が移動するとき、傍らの車輪も進み、生き物が地上から引き上げられるとき、車輪も引き上げられた。","tok":[["生き物","いきもの"],["が"],["移動","いどう"],["する"],["とき"],["、"],["傍ら","かたわら"],["の"],["車輪","しゃりん"],["も"],["進み","すすみ"],["、"],["生き物","いきもの"],["が"],["地上","ちじょう"],["から"],["引き上げられる","ひきあげられる"],["とき"],["、"],["車輪","しゃりん"],["も"],["引き上げられた","ひきあげられた"],["。"]]},{"verse":20,"text":"それらは霊が行かせる方向に、霊が行かせる所にはどこにでも進み、車輪もまた、共に引き上げられた。生き物の霊が、車輪の中にあったからである。","tok":[["それ"],["ら"],["は"],["霊","れい"],["が"],["行かせる","いかせる"],["方向","ほうこう"],["に"],["、"],["霊","れい"],["が"],["行かせる","いかせる"],["所","ところ"],["に"],["は"],["どこ"],["に"],["で"],["も"],["進み","すすみ"],["、"],["車輪","しゃりん"],["も"],["また"],["、"],["共","とも"],["に"],["引き上げられた","ひきあげられた"],["。"],["生き物","いきもの"],["の"],["霊","れい"],["が"],["、"],["車輪","しゃりん"],["の"],["中","なか"],["に"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"生き物が進むときには車輪も進み、生き物が止まるときには車輪も止まった。また、生き物が地上から引き上げられるとき、車輪も共に引き上げられた。生き物の霊が、車輪の中にあったからである。","tok":[["生き物","いきもの"],["が"],["進む","すすむ"],["とき"],["に"],["は"],["車輪","しゃりん"],["も"],["進み","すすみ"],["、"],["生き物","いきもの"],["が"],["止まる","とまる"],["とき"],["に"],["は"],["車輪","しゃりん"],["も"],["止まった","とまった"],["。"],["また"],["、"],["生き物","いきもの"],["が"],["地上","ちじょう"],["から"],["引き上げられる","ひきあげられる"],["とき"],["、"],["車輪","しゃりん"],["も"],["共","とも"],["に"],["引き上げられた","ひきあげられた"],["。"],["生き物","いきもの"],["の"],["霊","れい"],["が"],["、"],["車輪","しゃりん"],["の"],["中","なか"],["に"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"生き物の頭上には、恐れを呼び起こす、水晶のように輝く大空のようなものがあった。それは生き物の頭上に高く広がっていた。","tok":[["生き物","いきもの"],["の"],["頭上","ずじょう"],["に"],["は"],["、"],["恐れ","おそれ"],["を"],["呼び起こす","よびおこす"],["、"],["水晶","すいしょう"],["の"],["よう"],["に"],["輝く","かがやく"],["大空","おおぞら"],["の"],["よう"],["な"],["もの"],["が"],["あった"],["。"],["それ"],["は"],["生き物","いきもの"],["の"],["頭上","ずじょう"],["に"],["高く","たかく"],["広がって","ひろがって"],["いた"],["。"]]},{"verse":23,"text":"大空の下では、生き物の一対の翼がまっすぐに伸びて互いに触れ合い、他の一対の翼が体を覆っていた。すなわち、それぞれの一対の翼が彼らの体を覆っていた。","tok":[["大空","おおぞら"],["の"],["下","もと"],["で"],["は"],["、"],["生き物","いきもの"],["の"],["一","いち"],["対","たい"],["の"],["翼","つばさ"],["が"],["まっすぐ"],["に"],["伸びて","のびて"],["互い","たがい"],["に"],["触れ合い","ふれあい"],["、"],["他","た"],["の"],["一","いち"],["対","たい"],["の"],["翼","つばさ"],["が"],["体","からだ"],["を"],["覆って","おおって"],["いた"],["。"],["すなわち"],["、"],["それぞれ"],["の"],["一","いち"],["対","たい"],["の"],["翼","つばさ"],["が"],["彼","かれ"],["ら"],["の"],["体","からだ"],["を"],["覆って","おおって"],["いた"],["。"]]},{"verse":24,"text":"それらが移動するとき、翼の羽ばたく音をわたしは聞いたが、それは大水の音のように、全能なる神の御声のように聞こえ、また、陣営のどよめきのようにも聞こえた。それらが止まっているとき、翼は垂れていた。","tok":[["それ"],["ら"],["が"],["移動","いどう"],["する"],["とき"],["、"],["翼","つばさ"],["の"],["羽ばたく","はばたく"],["音","おと"],["を"],["わたし"],["は"],["聞いた","きいた"],["が"],["、"],["それ"],["は"],["大水","おおみず"],["の"],["音","おと"],["の"],["よう"],["に"],["、"],["全能","ぜんのう"],["なる"],["神","かみ"],["の"],["御声","おこえ"],["の"],["よう"],["に"],["聞こえ","きこえ"],["、"],["また"],["、"],["陣営","じんえい"],["の"],["どよめき"],["の"],["よう"],["に"],["も"],["聞こえた","きこえた"],["。"],["それ"],["ら"],["が"],["止まって","とまって"],["いる"],["とき"],["、"],["翼","つばさ"],["は"],["垂れて","たれて"],["いた"],["。"]]},{"verse":25,"text":"生き物の頭上にある大空から音が響いた。それらが止まっているとき、翼は垂れていた。","tok":[["生き物","いきもの"],["の"],["頭上","ずじょう"],["に"],["ある"],["大空","おおぞら"],["から"],["音","おと"],["が"],["響いた","ひびいた"],["。"],["それ"],["ら"],["が"],["止まって","とまって"],["いる"],["とき"],["、"],["翼","つばさ"],["は"],["垂れて","たれて"],["いた"],["。"]]},{"verse":26,"text":"生き物の頭上にある大空の上に、サファイアのように見える王座の形をしたものがあり、王座のようなものの上には高く人間のように見える姿をしたものがあった。","tok":[["生き物","いきもの"],["の"],["頭上","ずじょう"],["に"],["ある"],["大空","おおぞら"],["の"],["上","うえ"],["に"],["、"],["サファイア"],["の"],["よう"],["に"],["見える","みえる"],["王座","おうざ"],["の"],["形","かたち"],["を"],["した"],["もの"],["が"],["あり"],["、"],["王座","おうざ"],["の"],["よう"],["な"],["もの"],["の"],["上","うえ"],["に"],["は"],["高く","たかく"],["人間","にんげん"],["の"],["よう"],["に"],["見える","みえる"],["姿","すがた"],["を"],["した"],["もの"],["が"],["あった"],["。"]]},{"verse":27,"text":"腰のように見えるところから上は、琥珀金が輝いているようにわたしには見えた。それは周りに燃えひろがる火のように見えた。腰のように見えるところから下は、火のように見え、周囲に光を放っていた。","tok":[["腰","こし"],["の"],["よう"],["に"],["見える","みえる"],["ところ"],["から"],["上","うえ"],["は"],["、"],["琥珀金","こはくきん"],["が"],["輝いて","かがやいて"],["いる"],["よう"],["に"],["わたし"],["に"],["は"],["見えた","みえた"],["。"],["それ"],["は"],["周り","まわり"],["に"],["燃えひろがる","もえひろがる"],["火","ひ"],["の"],["よう"],["に"],["見えた","みえた"],["。"],["腰","こし"],["の"],["よう"],["に"],["見える","みえる"],["ところ"],["から"],["下","した"],["は"],["、"],["火","ひ"],["の"],["よう"],["に"],["見え","みえ"],["、"],["周囲","しゅうい"],["に"],["光","ひかり"],["を"],["放って","はなって"],["いた"],["。"]]},{"verse":28,"text":"周囲に光を放つ様は、雨の日の雲に現れる虹のように見えた。これが主の栄光の姿の有様であった。わたしはこれを見てひれ伏した。そのとき、語りかける者があって、わたしはその声を聞いた。","tok":[["周囲","しゅうい"],["に"],["光","ひかり"],["を"],["放つ","はなつ"],["様","さま"],["は"],["、"],["雨","あめ"],["の"],["日","ひ"],["の"],["雲","くも"],["に"],["現れる","あらわれる"],["虹","にじ"],["の"],["よう"],["に"],["見えた","みえた"],["。"],["これ"],["が"],["主","ぬし"],["の"],["栄光","えいこう"],["の"],["姿","すがた"],["の"],["有様","ありさま"],["で"],["あった"],["。"],["わたし"],["は"],["これ"],["を"],["見て","みて"],["ひれ伏した","ひれふした"],["。"],["その"],["とき"],["、"],["語りかける","かたりかける"],["者","もの"],["が"],["あって"],["、"],["わたし"],["は"],["その"],["声","こえ"],["を"],["聞いた","きいた"],["。"]]}]
["と"],["。"]]},{"verse":22,"text":"そこには、アシュルとその仲間がすべており彼らの墓はその周りにある。彼らは皆、剣で殺され、倒れた者である。","tok":[["そこ"],["に"],["は"],["、"],["アシュル"],["と"],["その"],["仲間","なかま"],["が"],["すべて"],["おり"],["彼","かれ"],["ら"],["の"],["墓","はか"],["は"],["その"],["周り","まわり"],["に"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["剣","けん"],["で"],["殺され","ころされ"],["、"],["倒れた","たおれた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":23,"text":"アッシリアの墓は穴の最も深い所にありその周りには仲間たちの墓がある。彼らは皆、剣で殺され、倒れた者かつて、生ける者の地で恐れられていた。","tok":[["アッシリア"],["の"],["墓","はか"],["は"],["穴","あな"],["の"],["最も","もっとも"],["深い","ふかい"],["所","ところ"],["に"],["あり"],["その"],["周り","まわり"],["に"],["は"],["仲間","なかま"],["たち"],["の"],["墓","はか"],["が"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["剣","けん"],["で"],["殺され","ころされ"],["、"],["倒れた","たおれた"],["者","もの"],["かつて"],["、"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["恐れられて","おそれられて"],["いた"],["。"]]},{"verse":24,"text":"そこには、エラムとそのすべての軍勢がいる。彼らの墓はその周りにある。彼らは皆、剣で殺され、倒れた者割礼のない者で、地の最も低い所に下って行く。生ける者の地で恐れられていたが穴に下る者と共に恥を負う。","tok":[["そこ"],["に"],["は"],["、"],["エラム"],["と"],["その"],["すべて"],["の"],["軍勢","ぐんぜい"],["が"],["いる"],["。"],["彼","かれ"],["ら"],["の"],["墓","はか"],["は"],["その"],["周り","まわり"],["に"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["剣","けん"],["で"],["殺され","ころされ"],["、"],["倒れた","たおれた"],["者","もの"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["で"],["、"],["地","ち"],["の"],["最も","もっとも"],["低い","ひくい"],["所","ところ"],["に"],["下って","くだって"],["行く","いく"],["。"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["恐れられて","おそれられて"],["いた"],["が"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["共","とも"],["に"],["恥","はじ"],["を"],["負う","おう"],["。"]]},{"verse":25,"text":"殺された者たちの間に、床が設けられたエラムとそのすべての軍勢のために。彼らの墓はその周りにある。彼らは皆、割礼のない者、剣で殺された者。生ける者の地で恐れられていたが穴に下る者と共に恥を負い殺された者の間に置かれる。","tok":[["殺された","ころされた"],["者","もの"],["たち"],["の"],["間","あいだ"],["に"],["、"],["床","ゆか"],["が"],["設けられた","もうけられた"],["エラム"],["と"],["その"],["すべて"],["の"],["軍勢","ぐんぜい"],["の"],["ため"],["に"],["。"],["彼","かれ"],["ら"],["の"],["墓","はか"],["は"],["その"],["周り","まわり"],["に"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["、"],["剣","けん"],["で"],["殺された","ころされた"],["者","もの"],["。"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["恐れられて","おそれられて"],["いた"],["が"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["共","とも"],["に"],["恥","はじ"],["を"],["負い","おい"],["殺された","ころされた"],["者","もの"],["の"],["間","あいだ"],["に"],["置かれる","おかれる"],["。"]]},{"verse":26,"text":"そこには、メシェクとトバルとそのすべての軍勢がいる。彼らの墓はその周囲にある。皆、割礼のない者、剣で殺された者。生ける者の地で恐れられていた。","tok":[["そこ"],["に"],["は"],["、"],["メシェク"],["と"],["トバル"],["と"],["その"],["すべて"],["の"],["軍勢","ぐんぜい"],["が"],["いる"],["。"],["彼","かれ"],["ら"],["の"],["墓","はか"],["は"],["その"],["周囲","しゅうい"],["に"],["ある"],["。"],["皆","みな"],["、"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["、"],["剣","けん"],["で"],["殺された","ころされた"],["者","もの"],["。"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["恐れられて","おそれられて"],["いた"],["。"]]},{"verse":27,"text":"彼らは、遠い昔に倒れた勇士たちと共に横たわることはない。この人々は、武器をもって陰府に下り剣を頭の下に、盾を骨の上に置いていた。これらの勇士は生ける者の地で恐れられていた。","tok":[["彼","かれ"],["ら"],["は"],["、"],["遠い","とおい"],["昔","むかし"],["に"],["倒れた","たおれた"],["勇士","ゆうし"],["たち"],["と"],["共","とも"],["に"],["横たわる","よこたわる"],["こと"],["は"],["ない"],["。"],["この"],["人々","ひとびと"],["は"],["、"],["武器","ぶき"],["を"],["もって"],["陰府","よみ"],["に"],["下り","くだり"],["剣","けん"],["を"],["頭","あたま"],["の"],["下","した"],["に"],["、"],["盾","たて"],["を"],["骨","ほね"],["の"],["上","うえ"],["に"],["置いて","おいて"],["いた"],["。"],["これ"],["ら"],["の"],["勇士","ゆうし"],["は"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["で"],["恐れられて","おそれられて"],["いた"],["。"]]},{"verse":28,"text":"お前は割礼のない者の間に剣で殺された者と共に打ち砕かれて横たわる。","tok":[["お前","おまえ"],["は"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["の"],["間","あいだ"],["に"],["剣","けん"],["で"],["殺された","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["打ち砕かれて","うちくだかれて"],["横たわる","よこたわる"],["。"]]},{"verse":29,"text":"そこには、エドムがその王たちとすべての君侯たちと共にいる。彼らは力をもっていたが剣で殺された者と共に置かれ割礼のない者、穴に下る者と共に横たわる。","tok":[["そこ"],["に"],["は"],["、"],["エドム"],["が"],["その"],["王","おう"],["たち"],["と"],["すべて"],["の"],["君侯","くんこう"],["たち"],["と"],["共","とも"],["に"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["力","ちから"],["を"],["もって"],["いた"],["が"],["剣","けん"],["で"],["殺された","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["置かれ","おかれ"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["共","とも"],["に"],["横たわる","よこたわる"],["。"]]},{"verse":30,"text":"そこには、北のすべての君主たちシドンのすべての人々がいる。彼らは殺された者と共に下る。彼らはその力のゆえに恐れられていたが辱められ、割礼のない者、剣で殺された者と共に横たわる。彼らは、穴に下る者と共に恥を負う。","tok":[["そこ"],["に"],["は"],["、"],["北","きた"],["の"],["すべて"],["の"],["君主","くんしゅ"],["たち"],["シドン"],["の"],["すべて"],["の"],["人々","ひとびと"],["が"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["殺された","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["下る","くだる"],["。"],["彼","かれ"],["ら"],["は"],["その"],["力","ちから"],["の"],["ゆえ"],["に"],["恐れられて","おそれられて"],["いた"],["が"],["辱められ","はずかしめられ"],["、"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["、"],["剣","けん"],["で"],["殺された","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["横たわる","よこたわる"],["。"],["彼","かれ"],["ら"],["は"],["、"],["穴","あな"],["に"],["下る","くだる"],["者","もの"],["と"],["共","とも"],["に"],["恥","はじ"],["を"],["負う","おう"],["。"]]},{"verse":31,"text":"ファラオは彼らを見て失ったすべての軍勢について慰められる。ファラオも、そのすべての軍隊も剣で殺されたと主なる神は言われる。","tok":[["ファラオ"],["は"],["彼","かれ"],["ら"],["を"],["見て","みて"],["失った","うしなった"],["すべて"],["の"],["軍勢","ぐんぜい"],["について"],["慰められる","なぐさめられる"],["。"],["ファラオ"],["も"],["、"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["も"],["剣","けん"],["で"],["殺された","ころされた"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":32,"text":"まことに、わたしは生ける者の地に恐れを置いた。ファラオとそのすべての軍勢は割礼のない者の間に剣で殺された者と共に横たわる」と主なる神は言われる。","tok":[["まこと"],["に"],["、"],["わたし"],["は"],["生ける","いける"],["者","もの"],["の"],["地","ち"],["に"],["恐れ","おそれ"],["を"],["置いた","おいた"],["。"],["ファラオ"],["と"],["その"],["すべて"],["の"],["軍勢","ぐんぜい"],["は"],["割礼","かつれい"],["の"],["ない"],["者","もの"],["の"],["間","あいだ"],["に"],["剣","けん"],["で"],["殺された","ころされた"],["者","もの"],["と"],["共","とも"],["に"],["横たわる","よこたわる"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]}]
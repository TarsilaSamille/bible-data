[{"verse":1,"text":"彼は大声でわたしの耳に語った。「この都を罰する者たちよ、おのおの破壊する道具を手にして近寄れ。」","tok":[["彼","かれ"],["は"],["大声","おおごえ"],["で"],["わたし"],["の"],["耳","みみ"],["に"],["語った","かたった"],["。"],["「"],["この"],["都","と"],["を"],["罰する","ばっする"],["者","もの"],["たち"],["よ"],["、"],["おのおの"],["破壊","はかい"],["する"],["道具","どうぐ"],["を"],["手","て"],["に"],["して"],["近寄れ","ちかよれ"],["。"],["」"]]},{"verse":2,"text":"すると、北に面する上の門に通ずる道から、六人の男がそれぞれ突き崩す道具を手にしてやって来るではないか。そのうちの一人は亜麻布をまとい、腰に書記の筆入れを着けていた。彼らはやって来ると、青銅の祭壇の傍らに立った。","tok":[["する"],["と"],["、"],["北","きた"],["に"],["面する","めんする"],["上","うえ"],["の"],["門","もん"],["に"],["通ずる","つうずる"],["道","みち"],["から"],["、"],["六人","ろくにん"],["の"],["男","おとこ"],["が"],["それぞれ"],["突き崩す","つきくずす"],["道具","どうぐ"],["を"],["手","て"],["に"],["して"],["やって"],["来るで","くるで"],["は"],["ない"],["か"],["。"],["その"],["うち"],["の"],["一人","ひとり"],["は"],["亜","あ"],["麻布","まふ"],["を"],["まとい"],["、"],["腰","こし"],["に"],["書記","しょき"],["の"],["筆入れ","ふでいれ"],["を"],["着けて","つけて"],["いた"],["。"],["彼","かれ"],["ら"],["は"],["やって"],["来る","くる"],["と"],["、"],["青銅","せいどう"],["の"],["祭壇","さいだん"],["の"],["傍ら","かたわら"],["に"],["立った","たった"],["。"]]},{"verse":3,"text":"すると、ケルビムの上にとどまっていたイスラエルの神の栄光はそこから昇って、神殿の敷居の方に向かい、亜麻布をまとい、腰に書記の筆入れを着けた者に呼びかけた。","tok":[["する"],["と"],["、"],["ケルビム"],["の"],["上","うえ"],["に"],["とどまって"],["いた"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["は"],["そこ"],["から"],["昇って","のぼって"],["、"],["神殿","しんでん"],["の"],["敷居","しきい"],["の"],["方","ほう"],["に"],["向かい","むかい"],["、"],["亜","あ"],["麻布","まふ"],["を"],["まとい"],["、"],["腰","こし"],["に"],["書記","しょき"],["の"],["筆入れ","ふでいれ"],["を"],["着けた","つけた"],["者","もの"],["に"],["呼びかけた","よびかけた"],["。"]]},{"verse":4,"text":"主は彼に言われた。「都の中、エルサレムの中を巡り、その中で行われているあらゆる忌まわしいことのゆえに、嘆き悲しんでいる者の額に印を付けよ。」","tok":[["主","ぬし"],["は"],["彼","かれ"],["に"],["言われた","いわれた"],["。"],["「"],["都","と"],["の"],["中","なか"],["、"],["エルサレム"],["の"],["中","なか"],["を"],["巡り","めぐり"],["、"],["その"],["中","なか"],["で"],["行われて","おこなわれて"],["いる"],["あらゆる"],["忌まわしい","いまわしい"],["こと"],["の"],["ゆえ"],["に"],["、"],["嘆き悲しんで","なげきかなしんで"],["いる"],["者","もの"],["の"],["額","がく"],["に"],["印","しるし"],["を"],["付けよ","つけよ"],["。"],["」"]]},{"verse":5,"text":"また、他の者たちに言っておられるのが、わたしの耳に入った。「彼の後ろについて都の中を巡れ。打て。慈しみの目を注いではならない。憐れみをかけてはならない。","tok":[["また"],["、"],["他","た"],["の"],["者","もの"],["たち"],["に"],["言って","いって"],["おられる"],["の"],["が"],["、"],["わたし"],["の"],["耳","みみ"],["に"],["入った","はいった"],["。"],["「"],["彼","かれ"],["の"],["後ろ","うしろ"],["について"],["都","と"],["の"],["中","なか"],["を"],["巡れ","めぐれ"],["。"],["打て","うて"],["。"],["慈しみ","いつくしみ"],["の"],["目","め"],["を"],["注いで","そそいで"],["は"],["ならない"],["。"],["憐れみ","あわれみ"],["を"],["かけて"],["は"],["ならない"],["。"]]},{"verse":6,"text":"老人も若者も、おとめも子供も人妻も殺して、滅ぼし尽くさなければならない。しかし、あの印のある者に近づいてはならない。さあ、わたしの神殿から始めよ。」彼らは、神殿の前にいた長老たちから始めた。","tok":[["老人","ろうじん"],["も"],["若者","わかもの"],["も"],["、"],["おとめ"],["も"],["子供","こども"],["も"],["人妻","ひとづま"],["も"],["殺して","ころして"],["、"],["滅ぼし","ほろぼし"],["尽くさなければ","つくさなければ"],["ならない"],["。"],["しかし"],["、"],["あの"],["印","しるし"],["の"],["ある"],["者","もの"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["さあ"],["、"],["わたし"],["の"],["神殿","しんでん"],["から"],["始め","はじめ"],["よ"],["。"],["」"],["彼","かれ"],["ら"],["は"],["、"],["神殿","しんでん"],["の"],["前","まえ"],["に"],["いた"],["長老","ちょうろう"],["たち"],["から"],["始めた","はじめた"],["。"]]},{"verse":7,"text":"主はまた彼らに言われた。「神殿を汚し、その庭を、殺された者で満たせ。さあ、出て行くのだ。」彼らは出て行き、都の人々を打った。","tok":[["主","ぬし"],["は"],["また"],["彼","かれ"],["ら"],["に"],["言われた","いわれた"],["。"],["「"],["神殿","しんでん"],["を"],["汚し","よごし"],["、"],["その"],["庭","にわ"],["を"],["、"],["殺された","ころされた"],["者","もの"],["で"],["満たせ","みたせ"],["。"],["さあ"],["、"],["出て","でて"],["行く","いく"],["の"],["だ"],["。"],["」"],["彼","かれ"],["ら"],["は"],["出て","でて"],["行き","いき"],["、"],["都","と"],["の"],["人々","ひとびと"],["を"],["打った","うった"],["。"]]},{"verse":8,"text":"彼らが打っているとき、わたしはひとり残され、顔を伏せ、助けを求めて言った。「ああ、主なる神よ、エルサレムの上に憤りを注いで、イスラエルの残りの者をすべて滅ぼし尽くされるのですか。」","tok":[["彼","かれ"],["ら"],["が"],["打って","うって"],["いる"],["とき"],["、"],["わたし"],["は"],["ひとり"],["残され","のこされ"],["、"],["顔","かお"],["を"],["伏せ","ふせ"],["、"],["助け","たすけ"],["を"],["求めて","もとめて"],["言った","いった"],["。"],["「"],["ああ"],["、"],["主","おも"],["なる"],["神","かみ"],["よ"],["、"],["エルサレム"],["の"],["上","うえ"],["に"],["憤り","いきどおり"],["を"],["注いで","そそいで"],["、"],["イスラエル"],["の"],["残り","のこり"],["の"],["者","もの"],["を"],["すべて"],["滅ぼし","ほろぼし"],["尽くされる","つくされる"],["の"],["です"],["か"],["。"],["」"]]},{"verse":9,"text":"主はわたしに言われた。「イスラエルとユダの家の罪はあまりにも大きい。この地は流血に満ち、この都は不正に満ちている。彼らは、『主はこの地を見捨てられた。主は顧みられない』と言っている。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["イスラエル"],["と"],["ユダ"],["の"],["家","いえ"],["の"],["罪","つみ"],["は"],["あまり"],["に"],["も"],["大きい","おおきい"],["。"],["この"],["地","ち"],["は"],["流血","りゅうけつ"],["に"],["満ち","みち"],["、"],["この"],["都","と"],["は"],["不正","ふせい"],["に"],["満ちて","みちて"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["、"],["『"],["主","ぬし"],["は"],["この"],["地","ち"],["を"],["見捨てられた","みすてられた"],["。"],["主","ぬし"],["は"],["顧みられない","かえりみられない"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":10,"text":"それゆえ、わたしも彼らに慈しみの目を注がず、憐れみをかけることもしない。彼らの行いの報いを、わたしは彼らの頭上に帰する。」","tok":[["それ"],["ゆえ"],["、"],["わたし"],["も"],["彼","かれ"],["ら"],["に"],["慈しみ","いつくしみ"],["の"],["目","め"],["を"],["注がず","そそがず"],["、"],["憐れみ","あわれみ"],["を"],["かける"],["こと"],["も"],["しない"],["。"],["彼","かれ"],["ら"],["の"],["行い","おこない"],["の"],["報い","むくい"],["を"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["頭上","ずじょう"],["に"],["帰する","きする"],["。"],["」"]]},{"verse":11,"text":"そのとき、亜麻布をまとい腰に筆入れを着けている者が報告して言った。「わたしは、あなたが命じられたとおりにいたしました。」","tok":[["その"],["とき"],["、"],["亜","あ"],["麻布","まふ"],["を"],["まとい"],["腰","こし"],["に"],["筆入れ","ふでいれ"],["を"],["着けて","つけて"],["いる"],["者","もの"],["が"],["報告","ほうこく"],["して"],["言った","いった"],["。"],["「"],["わたし"],["は"],["、"],["あなた"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["いたしました"],["。"],["」"]]}]
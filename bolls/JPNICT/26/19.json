[{"verse":1,"text":"イスラエルの君侯たちのために、あなたは悲しみの歌をうたって、","tok":[["イスラエル"],["の"],["君侯","くんこう"],["たち"],["の"],["ため"],["に"],["、"],["あなた"],["は"],["悲しみ","かなしみ"],["の"],["歌","うた"],["を"],["うたって"],["、"]]},{"verse":2,"text":"言いなさい。お前の母は獅子たちの中にあってどんな雌獅子だったろうか。お前の母は子獅子の間に伏し若獅子たちを育てた。","tok":[["言い","いい"],["なさい"],["。"],["お前","おまえ"],["の"],["母","はは"],["は"],["獅子","しし"],["たち"],["の"],["中","なか"],["に"],["あって"],["どんな"],["雌","めす"],["獅子","しし"],["だったろう"],["か"],["。"],["お前","おまえ"],["の"],["母","はは"],["は"],["子","こ"],["獅子","しし"],["の"],["間","あいだ"],["に"],["伏し","ふくし"],["若","わか"],["獅子","しし"],["たち"],["を"],["育てた","そだてた"],["。"]]},{"verse":3,"text":"お前の母は子獅子の中から一頭を取り上げた。その子獅子は若獅子に成長し獲物を取ることを覚え人々を餌食とした。","tok":[["お前","おまえ"],["の"],["母","はは"],["は"],["子","こ"],["獅子","しし"],["の"],["中","なか"],["から"],["一頭","いちとう"],["を"],["取り上げた","とりあげた"],["。"],["その"],["子","こ"],["獅子","しし"],["は"],["若","わか"],["獅子","しし"],["に"],["成長","せいちょう"],["し"],["獲物","えもの"],["を"],["取る","とる"],["こと"],["を"],["覚え","おぼえ"],["人々","ひとびと"],["を"],["餌食","えじき"],["と"],["した"],["。"]]},{"verse":4,"text":"しかし、諸国の民は子獅子について聞いた。罠に捕らえられ、鉤にかけられてエジプトの地へ連れて行かれたと。","tok":[["しかし"],["、"],["諸国","しょこく"],["の"],["民","たみ"],["は"],["子","こ"],["獅子","しし"],["について"],["聞いた","きいた"],["。"],["罠","わな"],["に"],["捕らえられ","とらえられ"],["、"],["鉤","はり"],["に"],["かけられて"],["エジプト"],["の"],["地","ち"],["へ"],["連れて","つれて"],["行かれた","いかれた"],["と"],["。"]]},{"verse":5,"text":"お前の母は期待が破れ、望みがうせたのを見て別の子獅子を取り、若獅子に育てた。","tok":[["お前","おまえ"],["の"],["母","はは"],["は"],["期待","きたい"],["が"],["破れ","やぶれ"],["、"],["望み","のぞみ"],["が"],["うせた"],["の"],["を"],["見て","みて"],["別","べつ"],["の"],["子","こ"],["獅子","しし"],["を"],["取り","とり"],["、"],["若","わか"],["獅子","しし"],["に"],["育てた","そだてた"],["。"]]},{"verse":6,"text":"この子獅子は獅子たちの間を歩き回り若獅子に成長し獲物を取ることを覚え人々を餌食とした。","tok":[["この"],["子","こ"],["獅子","しし"],["は"],["獅子","しし"],["たち"],["の"],["間","あいだ"],["を"],["歩き回り","あるきまわり"],["若","わか"],["獅子","しし"],["に"],["成長","せいちょう"],["し"],["獲物","えもの"],["を"],["取る","とる"],["こと"],["を"],["覚え","おぼえ"],["人々","ひとびと"],["を"],["餌食","えじき"],["と"],["した"],["。"]]},{"verse":7,"text":"彼は彼らの城郭を破壊し、町々を荒廃させた。そのほえた
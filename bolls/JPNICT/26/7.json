[{"verse":1,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、言いなさい。主なる神がイスラエルの地に向かってこう言われる。終わりが来る。地の四隅に終わりが来る。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["が"],["イスラエル"],["の"],["地","ち"],["に"],["向かって","むかって"],["こう"],["言われる","いわれる"],["。"],["終わり","おわり"],["が"],["来る","くる"],["。"],["地","ち"],["の"],["四隅","よすみ"],["に"],["終わり","おわり"],["が"],["来る","くる"],["。"]]},{"verse":3,"text":"今こそ終わりがお前の上に来る。わたしは怒りを送りお前の行いに従って裁き忌まわしいすべてのことをお前に報いる。","tok":[["今","いま"],["こそ"],["終わり","おわり"],["が"],["お前","おまえ"],["の"],["上","うえ"],["に"],["来る","くる"],["。"],["わたし"],["は"],["怒り","いかり"],["を"],["送り","おくり"],["お前","おまえ"],["の"],["行い","おこない"],["に"],["従って","したがって"],["裁き","さばき"],["忌まわしい","いまわしい"],["すべて"],["の"],["こと"],["を"],["お前","おまえ"],["に"],["報いる","むくいる"],["。"]]},{"verse":4,"text":"わたしは、お前に慈しみの目を注がず憐れみをかけることもしない。お前の行いをわたしは報いる。お前の忌まわしいことはお前の中にとどまる。そのとき、お前たちはわたしが主であることを知るようになる。","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["に"],["慈しみ","いつくしみ"],["の"],["目","め"],["を"],["注がず","そそがず"],["憐れみ","あわれみ"],["を"],["かける"],["こと"],["も"],["しない"],["。"],["お前","おまえ"],["の"],["行い","おこない"],["を"],["わたし"],["は"],["報いる","むくいる"],["。"],["お前","おまえ"],["の"],["忌まわしい","いまわしい"],["こと"],["は"],["お前","おまえ"],["の"],["中","なか"],["に"],["とどまる"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":5,"text":"主なる神はこう言われる。災いに続く災いが来る。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["災い","わざわい"],["に"],["続く","つづく"],["災い","わざわい"],["が"],["来る","くる"],["。"]]},{"verse":6,"text":"終わりが来る。終わりが来る。終わりの時がお前のために熟す。今や見よ、その時が来る。","tok":[["終わり","おわり"],["が"],["来る","くる"],["。"],["終わり","おわり"],["が"],["来る","くる"],["。"],["終わり","おわり"],["の"],["時","とき"],["が"],["お前","おまえ"],["の"],["ため"],["に"],["熟す","じゅくす"],["。"],["今","いま"],["や"],["見よ","みよ"],["、"],["その"],["時","とき"],["が"],["来る","くる"],["。"]]},{"verse":7,"text":"この地に住む者よ、お前の順番が来た。時は来た。その日は近
[{"verse":1,"text":"人の子よ、あなたはゴグに向かい預言して言いなさい。主なる神はこう言われる。メシェクとトバルの総首長ゴグよ。わたしはお前に立ち向かう。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["ゴグ"],["に"],["向かい","むかい"],["預言","よげん"],["して"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["メシェク"],["と"],["トバル"],["の"],["総","そう"],["首長","しゅちょう"],["ゴグ"],["よ"],["。"],["わたし"],["は"],["お前","おまえ"],["に"],["立ち向かう","たちむかう"],["。"]]},{"verse":2,"text":"わたしはお前を立ち帰らせ、お前を導いて北の果てから連れ上り、イスラエルの山々に来させる。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["立ち帰らせ","たちかえらせ"],["、"],["お前","おまえ"],["を"],["導いて","みちびいて"],["北","きた"],["の"],["果て","はて"],["から"],["連れ上り","つれのぼり"],["、"],["イスラエル"],["の"],["山々","やまやま"],["に"],["来させる","きさせる"],["。"]]},{"verse":3,"text":"そして、お前の左手から弓を叩き落とし、右手から矢を落とさせる。","tok":[["そして"],["、"],["お前","おまえ"],["の"],["左手","ひだりて"],["から"],["弓","ゆみ"],["を"],["叩き落とし","たたきおとし"],["、"],["右手","みぎて"],["から"],["矢","や"],["を"],["落とさせる","おとさせる"],["。"]]},{"verse":4,"text":"お前とそのすべての軍隊も、共にいる民も、イスラエルの山の上で倒れる。わたしはお前をあらゆる種類の猛禽と野の獣の餌食として与える。","tok":[["お前","おまえ"],["と"],["その"],["すべて"],["の"],["軍隊","ぐんたい"],["も"],["、"],["共","とも"],["に"],["いる"],["民","たみ"],["も"],["、"],["イスラエル"],["の"],["山","やま"],["の"],["上","うえ"],["で"],["倒れる","たおれる"],["。"],["わたし"],["は"],["お前","おまえ"],["を"],["あらゆる"],["種類","しゅるい"],["の"],["猛禽","もうきん"],["と"],["野","の"],["の"],["獣","けもの"],["の"],["餌食","えじき"],["として"],["与える","あたえる"],["。"]]},{"verse":5,"text":"お前は野の上に倒れる。まことにわたしがこれを語った、と主なる神は言われる。","tok":[["お前","おまえ"],["は"],["野","の"],["の"],["上","うえ"],["に"],["倒れる","たおれる"],["。"],["まこと"],["に"],["わたし"],["が"],["これ"],["を"],["語った","かたった"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"わたしは、火をマゴグと海岸地方に安らかに住む者たちに送る。そのとき、彼らはわたしが主であることを知るようになる。","tok":[["わたし"],["は"],["、"],["火","ひ"],["を"],["マゴグ"],["と"],["海岸","かいがん"],["地方","ちほう"],["に"],["安らか","やすらか"],["に"],["住む","すむ"],["者","もの"],["たち"],["に"],["送る","おくる"],["。"],["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":7,"text":"わたしは、わが民イスラエルの中にわが聖なる名を知らせる。わたしはわが聖なる名を二度と汚させない。そのとき、諸国民はわたしが主であり、イスラエルの中の聖なる者であることを知るようになる。","tok":[["わたし"],["は"],["、"],["わが"],["民","みん"],["イスラエル"],["の"],["中","なか"],["に"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["知らせる","しらせる"],["。"],["わたし"],["は"],["わが"],["聖","せい"],["なる"],["名","な"],["を"],["二","に"],["度","ど"],["と"],["汚させない","よごさせない"],["。"],["その"],["とき"],["、"],["諸","しょ"],["国民","こくみん"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["あり"],["、"],["イスラエル"],["の"],["中","なか"],["の"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"このことは到来し、実現する、と主なる神は言われる。それは、わたしが語った日である。","tok":[["この"],["こと"],["は"],["到来","とうらい"],["し"],["、"],["実現","じつげん"],["する"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"],["それ"],["は"],["、"],["わたし"],["が"],["語った","かたった"],["日","ひ"],["で"],["ある"],["。"]]},{"verse":9,"text":"イスラエルの町々に住む者は出て来て、もろもろの武器、すなわち盾と大盾、弓矢、棍棒、槍を火で燃やす。彼らはそれで七年間火を燃やし続ける。","tok":[["イスラエル"],["の"],["町々","まちまち"],["に"],["住む","すむ"],["者","もの"],["は"],["出て","でて"],["来て","きて"],["、"],["もろもろ"],["の"],["武器","ぶき"],["、"],["すなわち"],["盾","たて"],["と"],["大","だい"],["盾","たて"],["、"],["弓矢","ゆみや"],["、"],["棍棒","こんぼう"],["、"],["槍","やり"],["を"],["火","ひ"],["で"],["燃やす","もやす"],["。"],["彼","かれ"],["ら"],["は"],["それ"],["で"],["七","なな"],["年間","ねんかん"],["火","か"],["を"],["燃やし","もやし"],["続ける","つづける"],["。"]]},{"verse":10,"text":"彼らは、野から木を取ってくることも、森から薪を集めることもない。彼らは武器で火を燃やすからである。彼らは戦利品を取り返し、略奪されたものを奪い返す、と主なる神は言われる。","tok":[["彼","かれ"],["ら"],["は"],["、"],["野","の"],["から"],["木","き"],["を"],["取って","とって"],["くる"],["こと"],["も"],["、"],["森","もり"],["から"],["薪","たきぎ"],["を"],["集める","あつめる"],["こと"],["も"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["武器","ぶき"],["で"],["火","ひ"],["を"],["燃やす","もやす"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["戦利品","せんりひん"],["を"],["取り返し","とりかえし"],["、"],["略奪","りゃくだつ"],["された"],["もの"],["を"],["奪い返す","うばいかえす"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":11,"text":"その日、わたしはゴグのために、イスラエルの中のよく知られている場所を墓地として与える。それは海の東の旅人の谷である。その墓は旅人の道をふさいでしまう。人々はそこにゴグとすべての軍勢を埋め、そこをゴグの軍勢の谷と呼ぶようになる。","tok":[["その"],["日","ひ"],["、"],["わたし"],["は"],["ゴグ"],["の"],["ため"],["に"],["、"],["イスラエル"],["の"],["中","なか"],["の"],["よく"],["知られて","しられて"],["いる"],["場所","ばしょ"],["を"],["墓地","ぼち"],["として"],["与える","あたえる"],["。"],["それ"],["は"],["海","うみ"],["の"],["東","ひがし"],["の"],["旅人","たびびと"],["の"],["谷","たに"],["で"],["ある"],["。"],["その"],["墓","はか"],["は"],["旅人","たびびと"],["の"],["道","みち"],["を"],["ふさいで"],["しまう"],["。"],["人々","ひとびと"],["は"],["そこ"],["に"],["ゴグ"],["と"],["すべて"],["の"],["軍勢","ぐんぜい"],["を"],["埋め","うめ"],["、"],["そこ"],["を"],["ゴグ"],["の"],["軍勢","ぐんぜい"],["の"],["谷","たに"],["と"],["呼ぶ","よぶ"],["よう"],["に"],["なる"],["。"]]},{"verse":12,"text":"イスラエルの家はその地を清めるため、七か月の間彼らを埋める。","tok":[["イスラエル"],["の"],["家","いえ"],["は"],["その"],["地","ち"],["を"],["清める","きよめる"],["ため"],["、"],["七","なな"],["か月","かげつ"],["の"],["間","あいだ"],["彼","かれ"],["ら"],["を"],["埋める","うめる"],["。"]]},{"verse":13,"text":"その地のすべての民は彼らを埋め、わたしが栄光を受ける日に民はその名を知られるようになる、と主なる神は言われる。","tok":[["その"],["地","ち"],["の"],["すべて"],["の"],["民","たみ"],["は"],["彼","かれ"],["ら"],["を"],["埋め","うめ"],["、"],["わたし"],["が"],["栄光","えいこう"],["を"],["受ける","うける"],["日","ひ"],["に"],["民","たみ"],["は"],["その"],["名","な"],["を"],["知られる","しられる"],["よう"],["に"],["なる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":14,"text":"民は、常に国中を行き巡る人々を選び、彼らにその土地に残っている侵入者たちを埋めさせ、その地を清めさせる。彼らは七か月の終わりまで、残っている者を探すであろう。","tok":[["民","みん"],["は"],["、"],["常","つね"],["に"],["国中","くにちゅう"],["を"],["行き","いき"],["巡る","めぐる"],["人々","ひとびと"],["を"],["選び","えらび"],["、"],["彼","かれ"],["ら"],["に"],["その"],["土地","とち"],["に"],["残って","のこって"],["いる"],["侵入者","しんにゅうしゃ"],["たち"],["を"],["埋めさせ","うめさせ"],["、"],["その"],["地","ち"],["を"],["清めさせる","きよめさせる"],["。"],["彼","かれ"],["ら"],["は"],["七","なな"],["か月","かげつ"],["の"],["終わり","おわり"],["まで"],["、"],["残って","のこって"],["いる"],["者","もの"],["を"],["探すで","さがすで"],["あろう"],["。"]]},{"verse":15,"text":"国中を行き巡る者たちが行き巡り、人間の骨を見付けると、埋める者がそれをゴグの軍勢の谷に埋め終わるまで、その傍らに標識を立てておく。","tok":[["国中","くにちゅう"],["を"],["行き","いき"],["巡る","めぐる"],["者","もの"],["たち"],["が"],["行き","いき"],["巡り","めぐり"],["、"],["人間","にんげん"],["の"],["骨","ほね"],["を"],["見付ける","みつける"],["と"],["、"],["埋める","うめる"],["者","もの"],["が"],["それ"],["を"],["ゴグ"],["の"],["軍勢","ぐんぜい"],["の"],["谷","たに"],["に"],["埋め","うめ"],["終わる","おわる"],["まで"],["、"],["その"],["傍ら","かたわら"],["に"],["標識","ひょうしき"],["を"],["立てて","たてて"],["おく"],["。"]]},{"verse":16,"text":"そこで、ハモナ（軍勢）という名の町ができる。こうして、彼らはその土地を清める。","tok":[["そこ"],["で"],["、"],["ハモナ"],["（"],["軍勢","ぐんぜい"],["）"],["と"],["いう"],["名","な"],["の"],["町","まち"],["が"],["できる"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["その"],["土地","とち"],["を"],["清める","きよめる"],["。"]]},{"verse":17,"text":"人の子よ、主なる神はこう言われる。あらゆる種類の猛禽と、あらゆる種類の野の獣に語りなさい。お前たちは集まれ。来て、わたしがお前たちのために屠ったわたしの犠牲に向かい周囲から集まれ。それはイスラエルの山々の上での大いなる犠牲である。お前たちはその肉を食らい、その血を飲め。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["あらゆる"],["種類","しゅるい"],["の"],["猛禽","もうきん"],["と"],["、"],["あらゆる"],["種類","しゅるい"],["の"],["野","の"],["の"],["獣","けもの"],["に"],["語り","かたり"],["なさい"],["。"],["お前","おまえ"],["たち"],["は"],["集まれ","あつまれ"],["。"],["来て","きて"],["、"],["わたし"],["が"],["お前","おまえ"],["たち"],["の"],["ため"],["に"],["屠った","ほふった"],["わたし"],["の"],["犠牲","ぎせい"],["に"],["向かい","むかい"],["周囲","しゅうい"],["から"],["集まれ","あつまれ"],["。"],["それ"],["は"],["イスラエル"],["の"],["山々","やまやま"],["の"],["上","うえ"],["で"],["の"],["大いなる","おおいなる"],["犠牲","ぎせい"],["で"],["ある"],["。"],["お前","おまえ"],["たち"],["は"],["その"],["肉","にく"],["を"],["食らい","くらい"],["、"],["その"],["血","ち"],["を"],["飲め","のめ"],["。"]]},{"verse":18,"text":"勇士たちの肉を食らい、国の支配者たちの血を飲め。それは雄羊、小羊、雄山羊、雄牛であり、みなバシャンの肥えた動物たちである。","tok":[["勇士","ゆうし"],["たち"],["の"],["肉","にく"],["を"],["食らい","くらい"],["、"],["国","くに"],["の"],["支配者","しはいしゃ"],["たち"],["の"],["血","ち"],["を"],["飲め","のめ"],["。"],["それ"],["は"],["雄羊","おひつじ"],["、"],["小羊","こひつじ"],["、"],["雄山羊","おすやぎ"],["、"],["雄牛","おうし"],["で"],["あり"],["、"],["みな"],["バシャン"],["の"],["肥えた","こえた"],["動物","どうぶつ"],["たち"],["で"],["ある"],["。"]]},{"verse":19,"text":"お前たちは、わたしがお前たちのために屠った犠牲から、飽きるまで脂肪を食べ、酔うまで血を飲むがよい。","tok":[["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["お前","おまえ"],["たち"],["の"],["ため"],["に"],["屠った","ほふった"],["犠牲","ぎせい"],["から"],["、"],["飽きる","あきる"],["まで"],["脂肪","しぼう"],["を"],["食べ","たべ"],["、"],["酔う","よう"],["まで"],["血","ち"],["を"],["飲む","のむ"],["が"],["よい"],["。"]]},{"verse":20,"text":"お前たちはわたしの食卓で、馬や騎兵、勇士やすべての兵士たちの肉を飽きるまで食べる、と主なる神は言われる。","tok":[["お前","おまえ"],["たち"],["は"],["わたし"],["の"],["食卓","しょくたく"],["で"],["、"],["馬","うま"],["や"],["騎兵","きへい"],["、"],["勇士","ゆうし"],["や"],["すべて"],["の"],["兵士","へいし"],["たち"],["の"],["肉","にく"],["を"],["飽きる","あきる"],["まで"],["食べる","たべる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":21,"text":"わたしは国々の間にわが栄光を現し、国々はすべてわたしの行う裁きと、彼らの上に置くわたしの手を見る。","tok":[["わたし"],["は"],["国々","くにぐに"],["の"],["間","あいだ"],["に"],["わが"],["栄光","えいこう"],["を"],["現し","あらわし"],["、"],["国々","くにぐに"],["は"],["すべて"],["わたし"],["の"],["行う","おこなう"],["裁き","さばき"],["と"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["置く","おく"],["わたし"],["の"],["手","て"],["を"],["見る","みる"],["。"]]},{"verse":22,"text":"その日から後、イスラエルの家はわたしが彼らの神、主であることを知るようになる。","tok":[["その"],["日","ひ"],["から"],["後","あと"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":23,"text":"国々は、イスラエルの家がわたしに不信の行為を行ったために捕囚となったこと、また、わたしが顔を隠し、彼らを敵の手に渡したため、彼らは皆、剣に倒れたことを知るようになる。","tok":[["国々","くにぐに"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["が"],["わたし"],["に"],["不信","ふしん"],["の"],["行為","こうい"],["を"],["行った","おこなった"],["ため"],["に"],["捕囚","ほしゅう"],["と"],["なった"],["こと"],["、"],["また"],["、"],["わたし"],["が"],["顔","かお"],["を"],["隠し","かくし"],["、"],["彼","かれ"],["ら"],["を"],["敵","てき"],["の"],["手","て"],["に"],["渡した","わたした"],["ため"],["、"],["彼","かれ"],["ら"],["は"],["皆","みな"],["、"],["剣","けん"],["に"],["倒れた","たおれた"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":24,"text":"わたしは、彼らの汚れと罪に応じて行い、わたしの顔を隠した。","tok":[["わたし"],["は"],["、"],["彼","かれ"],["ら"],["の"],["汚れ","よごれ"],["と"],["罪","つみ"],["に"],["応じて","おうじて"],["行い","おこない"],["、"],["わたし"],["の"],["顔","かお"],["を"],["隠した","かくした"],["。"]]},{"verse":25,"text":"それゆえ、主なる神はこう言われる。今やわたしはヤコブの繁栄を回復し、イスラエルの全家をわが聖なる名のゆえに熱い思いをもって憐れむ。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["今","いま"],["や"],["わたし"],["は"],["ヤコブ"],["の"],["繁栄","はんえい"],["を"],["回復","かいふく"],["し"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["を"],["わが"],["聖","せい"],["なる"],["名","な"],["の"],["ゆえ"],["に"],["熱い","あつい"],["思い","おもい"],["を"],["もって"],["憐れむ","あわれむ"],["。"]]},{"verse":26,"text":"彼らは自分の土地に安らかに住み、脅かす者がいなくなるとき、わたしに背いた恥とすべての不信の罪の責めを担う。","tok":[["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["土地","とち"],["に"],["安らか","やすらか"],["に"],["住み","すみ"],["、"],["脅かす","おびやかす"],["者","もの"],["が"],["いなく"],["なる"],["とき"],["、"],["わたし"],["に"],["背いた","そむいた"],["恥","はじ"],["と"],["すべて"],["の"],["不信","ふしん"],["の"],["罪","つみ"],["の"],["責め","せめ"],["を"],["担う","になう"],["。"]]},{"verse":27,"text":"わたしが彼らを諸国の民の中から帰らせ、敵の地から集めるとき、わたしは国々の前で、彼らを通して自分の聖なることを示す。","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["帰らせ","かえらせ"],["、"],["敵","てき"],["の"],["地","ち"],["から"],["集める","あつめる"],["とき"],["、"],["わたし"],["は"],["国々","くにぐに"],["の"],["前","まえ"],["で"],["、"],["彼","かれ"],["ら"],["を"],["通して","とおして"],["自分","じぶん"],["の"],["聖","せい"],["なる"],["こと"],["を"],["示す","しめす"],["。"]]},{"verse":28,"text":"わたしは彼らを国々に捕囚として送ったが、自分の土地に集めて、もはや、かの地には残さない。そのとき、彼らはわたしが彼らの神、主であることを知るようになる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["国々","くにぐに"],["に"],["捕囚","ほしゅう"],["として"],["送った","おくった"],["が"],["、"],["自分","じぶん"],["の"],["土地","とち"],["に"],["集めて","あつめて"],["、"],["もはや"],["、"],["かの"],["地","ち"],["に"],["は"],["残さない","のこさない"],["。"],["その"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":29,"text":"わたしは二度とわが顔を彼らに隠すことなく、わが霊をイスラエルの家に注ぐ」と主なる神は言われる。","tok":[["わたし"],["は"],["二","に"],["度","ど"],["と"],["わが"],["顔","かお"],["を"],["彼","かれ"],["ら"],["に"],["隠す","かくす"],["こと"],["なく"],["、"],["わが"],["霊","れい"],["を"],["イスラエル"],["の"],["家","いえ"],["に"],["注ぐ","そそぐ"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]}]
[{"verse":1,"text":"主なる神の言葉がわたしに臨んだ。","tok":[["主","おも"],["なる"],["神","かみ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、ぶどうの木は森の木々の中で、枝のあるどの木よりもすぐれているであろうか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ぶどう"],["の"],["木","き"],["は"],["森","もり"],["の"],["木々","きぎ"],["の"],["中","なか"],["で"],["、"],["枝","えだ"],["の"],["ある"],["どの"],["木","き"],["より"],["も"],["すぐれて"],["いるで"],["あろう"],["か"],["。"]]},{"verse":3,"text":"ぶどうの木から、何か役に立つものを作るための木材がとれるだろうか。それで、何かの器物を掛ける釘を作ることができるだろうか。","tok":[["ぶどう"],["の"],["木","き"],["から"],["、"],["何","なん"],["か"],["役","やく"],["に"],["立つ","たつ"],["もの"],["を"],["作る","つくる"],["ため"],["の"],["木材","もくざい"],["が"],["とれるだろう"],["か"],["。"],["それ"],["で"],["、"],["何","なん"],["か"],["の"],["器物","きぶつ"],["を"],["掛ける","かける"],["釘","くぎ"],["を"],["作る","つくる"],["こと"],["が"],["できるだろう"],["か"],["。"]]},{"verse":4,"text":"それが火に投げ込まれると、火はその両端を焼き、真ん中も焦がされてしまう。それでも何かの役に立つだろうか。","tok":[["それ"],["が"],["火","ひ"],["に"],["投げ込まれる","なげこまれる"],["と"],["、"],["火","ひ"],["は"],["その"],["両端","りょうたん"],["を"],["焼き","やき"],["、"],["真ん中","まんなか"],["も"],["焦がされて","こがされて"],["しまう"],["。"],["それ"],["で"],["も"],["何","なん"],["か"],["の"],["役","やく"],["に"],["立つだろう","たつだろう"],["か"],["。"]]},{"verse":5,"text":"完全なときでさえ何も作れないのに、まして火に焼かれて焦げてしまったら、もはや何の役にも立たないではないか。","tok":[["完全","かんぜん"],["な"],["とき"],["で"],["さえ"],["何","なん"],["も"],["作れない","つくれない"],["のに"],["、"],["まして"],["火","ひ"],["に"],["焼かれて","やかれて"],["焦げて","こげて"],["しまったら"],["、"],["もはや"],["何","なん"],["の"],["役","やく"],["に"],["も"],["立たないで","たたないで"],["は"],["ない"],["か"],["。"]]},{"verse":6,"text":"それゆえ、主なる神はこう言われる。わたしが薪として火に投げ込んだ、森の木の中のぶどうの木のように、わたしはエルサレムの住民を火に投げ入れる。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["が"],["薪","たきぎ"],["として"],["火","ひ"],["に"],["投げ込んだ","なげこんだ"],["、"],["森","もり"],["の"],["木","き"],["の"],["中","なか"],["の"],["ぶどう"],["の"],["木","き"],["の"],["よう"],["に"],["、"],["わたし"],["は"],["エルサレム"],["の"],["住民","じゅうみん"],["を"],["火","ひ"],["に"],["投げ入れる","なげいれる"],["。"]]},{"verse":7,"text":"わたしは顔を彼らに向ける。彼らが火から逃れても、火は彼らを食い尽くす。わたしが顔を彼らに向けるとき、彼らはわたしが主なる神であることを知るようになる。","tok":[["わたし"],["は"],["顔","かお"],["を"],["彼","かれ"],["ら"],["に"],["向ける","むける"],["。"],["彼","かれ"],["ら"],["が"],["火","ひ"],["から"],["逃れて","のがれて"],["も"],["、"],["火","ひ"],["は"],["彼","かれ"],["ら"],["を"],["食い","くい"],["尽くす","つくす"],["。"],["わたし"],["が"],["顔","かお"],["を"],["彼","かれ"],["ら"],["に"],["向ける","むける"],["とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","おも"],["なる"],["神","かみ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"わたしはこの地を荒廃させる。彼らがわたしに不信を重ねたからである」と主なる神は言われる。","tok":[["わたし"],["は"],["この"],["地","ち"],["を"],["荒廃","こうはい"],["させる"],["。"],["彼","かれ"],["ら"],["が"],["わたし"],["に"],["不信","ふしん"],["を"],["重ねた","かさねた"],["から"],["で"],["ある"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]}]
["を"],["犯す","おかす"],["者","もの"],["、"],["利息","りそく"],["を"],["天引き","てんびき"],["して"],["金","きん"],["を"],["貸し","かし"],["たり"],["、"],["高利","こうり"],["を"],["取って","とって"],["隣人","りんじん"],["を"],["抑圧","よくあつ"],["する"],["者","もの"],["が"],["いる"],["。"],["お前","おまえ"],["は"],["わたし"],["を"],["忘れた","わすれた"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":13,"text":"わたしは、お前が得た不正の利益に対し、またお前の中で流された血に対して、わたしの手を打ち鳴らす。","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["が"],["得た","えた"],["不正","ふせい"],["の"],["利益","りえき"],["に"],["対し","たいし"],["、"],["また"],["お前","おまえ"],["の"],["中","なか"],["で"],["流された","ながされた"],["血","ち"],["に対して","にたいして"],["、"],["わたし"],["の"],["手","て"],["を"],["打ち鳴らす","うちならす"],["。"]]},{"verse":14,"text":"わたしが裁きを行う日に、お前の心は耐えられようか。お前の手の力はうせないだろうか。主であるわたしが、これを語りこれを行う。","tok":[["わたし"],["が"],["裁き","さばき"],["を"],["行う","おこなう"],["日","ひ"],["に"],["、"],["お前","おまえ"],["の"],["心","こころ"],["は"],["耐えられよう","たえられよう"],["か"],["。"],["お前","おまえ"],["の"],["手","て"],["の"],["力","ちから"],["は"],["うせないだろう"],["か"],["。"],["主","ぬし"],["で"],["ある"],["わたし"],["が"],["、"],["これ"],["を"],["語り","かたり"],["これ"],["を"],["行う","おこなう"],["。"]]},{"verse":15,"text":"わたしはお前を諸国民の間に散らし、国々にまき散らす。わたしはお前の汚れを取り除く。","tok":[["わたし"],["は"],["お前","おまえ"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["間","あいだ"],["に"],["散らし","ちらし"],["、"],["国々","くにぐに"],["に"],["まき散らす","まきちらす"],["。"],["わたし"],["は"],["お前","おまえ"],["の"],["汚れ","よごれ"],["を"],["取り除く","とりのぞく"],["。"]]},{"verse":16,"text":"お前は諸国民の前で自分の罪によって汚される。こうして、お前はわたしが主であることを知るようになる。」","tok":[["お前","おまえ"],["は"],["諸","しょ"],["国民","こくみん"],["の"],["前","まえ"],["で"],["自分","じぶん"],["の"],["罪","つみ"],["によって"],["汚される","よごされる"],["。"],["こう"],["して"],["、"],["お前","おまえ"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":17,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":18,"text":"「人の子よ、イスラエルの家はわたしにとって金滓のようになった。彼らは炉の中で、みな銀、銅、錫、鉄、鉛などであった。ところが彼らは金滓となってしまった。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["は"],["わたし"],["にとって"],["金","きん"],["滓","かす"],["の"],["よう"],["に"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["炉","ろ"],["の"],["中","なか"],["で"],["、"],["みな"],["銀","ぎん"],["、"],["銅","どう"],["、"],["錫","すず"],["、"],["鉄","てつ"],["、"],["鉛","なまり"],["など"],["で"],["あった"],["。"],["ところ"],["が"],["彼","かれ"],["ら"],["は"],["金","きん"],["滓","かす"],["と"],["なって"],["しまった"],["。"]]},{"verse":19,"text":"それゆえ、主なる神はこう言われる。お前たちがみな金滓となったので、わたしはお前たちをエルサレムの真ん中に集める。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["お前","おまえ"],["たち"],["が"],["みな"],["金","かね"],["滓","かす"],["と"],["なった"],["ので"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["を"],["エルサレム"],["の"],["真ん中","まんなか"],["に"],["集める","あつめる"],["。"]]},{"verse":20,"text":"銀、銅、鉄、鉛、錫が炉の中に集められ、火を吹きつけて溶かされるように、わたしも怒りと憤りをもってお前たちを集め、火を吹きつけて溶かす。","tok":[["銀","ぎん"],["、"],["銅","どう"],["、"],["鉄","てつ"],["、"],["鉛","なまり"],["、"],["錫","すず"],["が"],["炉","ろ"],["の"],["中","なか"],["に"],["集められ","あつめられ"],["、"],["火","ひ"],["を"],["吹きつけて","ふきつけて"],["溶かされる","とかされる"],["よう"],["に"],["、"],["わたし"],["も"],["怒り","いかり"],["と"],["憤り","いきどおり"],["を"],["もって"],["お前","おまえ"],["たち"],["を"],["集め","あつめ"],["、"],["火","ひ"],["を"],["吹きつけて","ふきつけて"],["溶かす","とかす"],["。"]]},{"verse":21,"text":"わたしがお前たちを集め、わたしの怒りの火を吹きつけると、お前たちはその中で溶ける。","tok":[["わたし"],["が"],["お前","おまえ"],["たち"],["を"],["集め","あつめ"],["、"],["わたし"],["の"],["怒り","いかり"],["の"],["火","ひ"],["を"],["吹きつける","ふきつける"],["と"],["、"],["お前","おまえ"],["たち"],["は"],["その"],["中","なか"],["で"],["溶ける","とける"],["。"]]},{"verse":22,"text":"銀が炉の中で溶けるように、お前たちもその中で溶ける。そのとき、お前たちは主なるわたしが、憤りをお前たちの上に注いだことを知るようになる。」","tok":[["銀","ぎん"],["が"],["炉","ろ"],["の"],["中","なか"],["で"],["溶ける","とける"],["よう"],["に"],["、"],["お前","おまえ"],["たち"],["も"],["その"],["中","なか"],["で"],["溶ける","とける"],["。"],["その"],["とき"],["、"],["お前","おまえ"],["たち"],["は"],["主","おも"],["なる"],["わたし"],["が"],["、"],["憤り","いきどおり"],["を"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["注いだ","そそいだ"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":23,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":24,"text":"「人の子よ、エルサレムに語りなさい。お前は憤りの日に、雨も降らず清められることもない土地だ。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["エルサレム"],["に"],["語り","かたり"],["なさい"],["。"],["お前","おまえ"],["は"],["憤り","いきどおり"],["の"],["日","ひ"],["に"],["、"],["雨","あめ"],["も"],["降らず","ふらず"],["清められる","きよめられる"],["こと"],["も"],["ない"],["土地","とち"],["だ"],["。"]]},{"verse":25,"text":"都の中に預言者たちの陰謀がある。獅子がほえ、獲物を引き裂くように、都の中で人々は食われ、富や財宝が奪われ、やもめの数は増した。","tok":[["都","と"],["の"],["中","なか"],["に"],["預言者","よげんしゃ"],["たち"],["の"],["陰謀","いんぼう"],["が"],["ある"],["。"],["獅子","しし"],["が"],["ほえ"],["、"],["獲物","えもの"],["を"],["引き裂く","ひきさく"],["よう"],["に"],["、"],["都","と"],["の"],["中","なか"],["で"],["人々","ひとびと"],["は"],["食われ","くわれ"],["、"],["富","とみ"],["や"],["財宝","ざいほう"],["が"],["奪われ","うばわれ"],["、"],["やもめ"],["の"],["数","かず"],["は"],["増した","ました"],["。"]]},{"verse":26,"text":"祭司たちはわたしの律法を犯し、わたしの聖なるものを汚した。彼らは聖と俗とを区別せず、浄と汚れの区別を教えず、わたしの安息日に目を覆った。こうして、わたしは彼らの間で汚されている。","tok":[["祭司","さいし"],["たち"],["は"],["わたし"],["の"],["律法","りっぽう"],["を"],["犯し","おかし"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["もの"],["を"],["汚した","よごした"],["。"],["彼","かれ"],["ら"],["は"],["聖","せい"],["と"],["俗","ぞく"],["と"],["を"],["区別","くべつ"],["せず"],["、"],["浄","きよし"],["と"],["汚れ","よごれ"],["の"],["区別","くべつ"],["を"],["教えず","おしえず"],["、"],["わたし"],["の"],["安息日","あんそくび"],["に"],["目","め"],["を"],["覆った","おおった"],["。"],["こう"],["して"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["間","あいだ"],["で"],["汚されて","よごされて"],["いる"],["。"]]},{"verse":27,"text":"また、高官たちは都の中で獲物を引き裂く狼のようだ。彼らは不正の利を得るために、血を流し、人々を殺す。","tok":[["また"],["、"],["高官","こうかん"],["たち"],["は"],["都","と"],["の"],["中","なか"],["で"],["獲物","えもの"],["を"],["引き裂く","ひきさく"],["狼","おおかみ"],["の"],["よう"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["不正","ふせい"],["の"],["利","り"],["を"],["得る","える"],["ため"],["に"],["、"],["血","ち"],["を"],["流し","ながし"],["、"],["人々","ひとびと"],["を"],["殺す","ころす"],["。"]]},{"verse":28,"text":"また、預言者たちは、城壁に漆喰で上塗りをした。彼らは空しい幻を見、欺きの占いをし、主が語られないのに、『主なる神はこう言われる』と言う。","tok":[["また"],["、"],["預言者","よげんしゃ"],["たち"],["は"],["、"],["城壁","じょうへき"],["に"],["漆喰","しっ
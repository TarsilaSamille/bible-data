[{"verse":1,"text":"イスラエルの長老数名がわたしのもとに来て、わたしの前に座った。","tok":[["イスラエル"],["の"],["長老","ちょうろう"],["数","すう"],["名","めい"],["が"],["わたし"],["の"],["もと"],["に"],["来て","きて"],["、"],["わたし"],["の"],["前","まえ"],["に"],["座った","すわった"],["。"]]},{"verse":2,"text":"そのとき、主の言葉がわたしに臨んだ。","tok":[["その"],["とき"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":3,"text":"「人の子よ、この人々は偶像を心に抱き、彼らをつまずかせる罪を目の前に置いている。それなのに、わたしは彼らの求めに応じられようか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["この"],["人々","ひとびと"],["は"],["偶像","ぐうぞう"],["を"],["心","こころ"],["に"],["抱き","いだき"],["、"],["彼","かれ"],["ら"],["を"],["つまずかせる"],["罪","つみ"],["を"],["目","め"],["の"],["前","まえ"],["に"],["置いて","おいて"],["いる"],["。"],["それ"],["な"],["のに"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["求め","もとめ"],["に"],["応じられよう","おうじられよう"],["か"],["。"]]},{"verse":4,"text":"それゆえ、彼らと語り、彼らに告げなさい。主なる神はこう言われる。イスラエルの家の者で、偶像を心に抱き、つまずかせる罪を目の前に置いていながら、預言者のもとに来る者には、だれに対しても、主なるわたし自身が、彼の多くの偶像のゆえに答えよう。","tok":[["それ"],["ゆえ"],["、"],["彼","かれ"],["ら"],["と"],["語り","かたり"],["、"],["彼","かれ"],["ら"],["に"],["告げ","つげ"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["で"],["、"],["偶像","ぐうぞう"],["を"],["心","こころ"],["に"],["抱き","いだき"],["、"],["つまずかせる"],["罪","つみ"],["を"],["目","め"],["の"],["前","まえ"],["に"],["置いて","おいて"],["い"],["ながら"],["、"],["預言者","よげんしゃ"],["の"],["もと"],["に"],["来る","くる"],["者","もの"],["に"],["は"],["、"],["だれ"],["に対して","にたいして"],["も"],["、"],["主","おも"],["なる"],["わたし"],["自身","じしん"],["が"],["、"],["彼","かれ"],["の"],["多く","おおく"],["の"],["偶像","ぐうぞう"],["の"],["ゆえ"],["に"],["答えよう","こたえよう"],["。"]]},{"verse":5,"text":"それは、偶像のゆえにわたしから離れ去ったイスラエルの家の心をすべて、わたしが捕らえるためである。","tok":[["それ"],["は"],["、"],["偶像","ぐうぞう"],["の"],["ゆえ"],["に"],["わたし"],["から"],["離れ去った","はなれさった"],["イスラエル"],["の"],["家","いえ"],["の"],["心","こころ"],["を"],["すべて"],["、"],["わたし"],["が"],["捕らえる","とらえる"],["ため"],["で"],["ある"],["。"]]},{"verse":6,"text":"それゆえ、あなたはイスラエルの家に言いなさい。主なる神はこう言われる。悔い改めて、お前たちの偶像から離れ、すべての忌まわしいものから顔を背けよ。","tok":[["それ"],["ゆえ"],["、"],["あなた"],["は"],["イスラエル"],["の"],["家","いえ"],["に"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["悔い改めて","くいあらためて"],["、"],["お前","おまえ"],["たち"],["の"],["偶像","ぐうぞう"],["から"],["離れ","はなれ"],["、"],["すべて"],["の"],["忌まわしい","いまわしい"],["もの"],["から"],["顔","かお"],["を"],["背けよ","そむけよ"],["。"]]},{"verse":7,"text":"イスラエルの家の者と、イスラエルの中に寄留している外国人のうち、わたしから離れて偶像を心に抱き、つまずかせる罪を目の前に置いていながら、わたしに尋ねようと預言者のもとに来る者には、だれに対しても、主なるわたし自身が答えよう。","tok":[["イスラエル"],["の"],["家","いえ"],["の"],["者","もの"],["と"],["、"],["イスラエル"],["の"],["中","なか"],["に"],["寄留","きりゅう"],["して"],["いる"],["外国人","がいこくじん"],["の"],["うち"],["、"],["わたし"],["から"],["離れて","はなれて"],["偶像","ぐうぞう"],["を"],["心","こころ"],["に"],["抱き","いだき"],["、"],["つまずかせる"],["罪","つみ"],["を"],["目","め"],["の"],["前","まえ"],["に"],["置いて","おいて"],["い"],["ながら"],["、"],["わたし"],["に"],["尋ねよう","たずねよう"],["と"],["預言者","よげんしゃ"],["の"],["もと"],["に"],["来る","くる"],["者","もの"],["に"],["は"],["、"],["だれ"],["に対して","にたいして"],["も"],["、"],["主","おも"],["なる"],["わたし"],["自身","じしん"],["が"],["答えよう","こたえよう"],["。"]]},{"verse":8,"text":"わたしはその者に向かって顔を向け、彼をしるしとし、ことわざとして、わが民の中から断つ。そのときお前たちは、わたしが主であることを知るようになる。","tok":[["わたし"],["は"],["その"],["者","もの"],["に"],["向かって","むかって"],["顔","かお"],["を"],["向け","むけ"],["、"],["彼","かれ"],["を"],["しるし"],["と"],["し"],["、"],["ことわざ"],["として"],["、"],["わが"],["民","たみ"],["の"],["中","なか"],["から"],["断つ","たつ"],["。"],["その"],["とき"],["お前","おまえ"],["たち"],["は"],["、"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":9,"text":"もし、預言者が惑わされて言葉を語ることがあるなら、主なるわたし自身がその預言者を惑わしたのである。わたしは彼の上に手を伸べ、わが民イスラエルの中から絶ち滅ぼす。","tok":[["もし"],["、"],["預言者","よげんしゃ"],["が"],["惑わされて","まどわされて"],["言葉","ことば"],["を"],["語る","かたる"],["こと"],["が"],["あるなら"],["、"],["主","おも"],["なる"],["わたし"],["自身","じしん"],["が"],["その"],["預言者","よげんしゃ"],["を"],["惑わした","まどわした"],["ので"],["ある"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["上","うえ"],["に"],["手","て"],["を"],["伸べ","のべ"],["、"],["わが"],["民","みん"],["イスラエル"],["の"],["中","なか"],["から"],["絶ち","たち"],["滅ぼす","ほろぼす"],["。"]]},{"verse":10,"text":"彼らは共に自分の罪を負う。尋ねる者の罪は、預言者の罪と同じである。","tok":[["彼","かれ"],["ら"],["は"],["共","とも"],["に"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["負う","おう"],["。"],["尋ねる","たずねる"],["者","もの"],["の"],["罪","つみ"],["は"],["、"],["預言者","よげんしゃ"],["の"],["罪","つみ"],["と"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":11,"text":"それは、イスラエルの家がもはやわたしから迷い出ず、あらゆる背きによって二度と自分を汚さないためである。こうして、彼らはわたしの民となり、わたしは彼らの神となる」と主なる神は言われる。","tok":[["それ"],["は"],["、"],["イスラエル"],["の"],["家","いえ"],["が"],["もはや"],["わたし"],["から"],["迷い出ず","まよいでず"],["、"],["あらゆる"],["背き","そむき"],["によって"],["二","に"],["度","ど"],["と"],["自分","じぶん"],["を"],["汚さない","よごさない"],["ため"],["で"],["ある"],["。"],["こう"],["して"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["」"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"主の言葉がわたしに臨んだ。","tok":[["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":13,"text":"「人の子よ、もし、ある国がわたしに対して不信を重ね、罪を犯すなら、わたしは手をその上に伸ばし、パンをつるして蓄える棒を折り、その地に飢饉を送って、そこから人も家畜も絶ち滅ぼす。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["もし"],["、"],["ある"],["国","くに"],["が"],["わたし"],["に対して","にたいして"],["不信","ふしん"],["を"],["重ね","かさね"],["、"],["罪","つみ"],["を"],["犯すなら","おかすなら"],["、"],["わたし"],["は"],["手","て"],["を"],["その"],["上","うえ"],["に"],["伸ばし","のばし"],["、"],["パン"],["を"],["つるして"],["蓄える","たくわえる"],["棒","ぼう"],["を"],["折り","おり"],["、"],["その"],["地","ち"],["に"],["飢饉","ききん"],["を"],["送って","おくって"],["、"],["そこ"],["から"],["人","ひと"],["も"],["家畜","かちく"],["も"],["絶ち","たち"],["滅ぼす","ほろぼす"],["。"]]},{"verse":14,"text":"たとえ、その中に、かの三人の人物、ノア、ダニエル、ヨブがいたとしても、彼らはその正しさによって自分自身の命を救いうるだけだ、と主なる神は言われる。","tok":[["たとえ"],["、"],["その"],["中","なか"],["に"],["、"],["かの"],["三人","さんにん"],["の"],["人物","じんぶつ"],["、"],["ノア"],["、"],["ダニエル"],["、"],["ヨブ"],["が"],["いた"],["として"],["も"],["、"],["彼","かれ"],["ら"],["は"],["その"],["正し","ただし"],["さ"],["によって"],["自分","じぶん"],["自身","じしん"],["の"],["命","いのち"],["を"],["救い","すくい"],["うる"],["だけ"],["だ"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"もし、わたしが悪い獣をその国に横行させ、それによって住む人がいなくなり、獣を恐れて通る人がないために国が荒れ廃れるなら、","tok":[["もし"],["、"],["わたし"],["が"],["悪い","わるい"],["獣","けもの"],["を"],["その"],["国","くに"],["に"],["横行","おうこう"],["させ"],["、"],["それ"],["によって"],["住む","すむ"],["人","ひと"],["が"],["いなく"],["なり"],["、"],["獣","けもの"],["を"],["恐れて","おそれて"],["通る","とおる"],["人","ひと"],["が"],["ない"],["ため"],["に"],["国","くに"],["が"],["荒れ","あれ"],["廃れるなら","すたれるなら"],["、"]]},{"verse":16,"text":"その中に、かの三人の人物がいたとしても――わたしは生きている、と主なる神は言われる――彼らは自分の息子、娘たちすら救うことができない。彼らは自分自身を救いうるだけであり、その国は荒廃に帰するであろう。","tok":[["その"],["中","なか"],["に"],["、"],["かの"],["三人","さんにん"],["の"],["人物","じんぶつ"],["が"],["いた"],["として"],["も"],["―"],["―"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["―"],["―"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["すら"],["救う","すくう"],["こと"],["が"],["できない"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["救い","すくい"],["うる"],["だけ"],["で"],["あり"],["、"],["その"],["国","くに"],["は"],["荒廃","こうはい"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":17,"text":"また、もしわたしが剣をその国に送って、『剣よ、この国を行き巡れ』と言って、その国から人も家畜も絶ち滅ぼすなら、","tok":[["また"],["、"],["もし"],["わたし"],["が"],["剣","けん"],["を"],["その"],["国","くに"],["に"],["送って","おくって"],["、"],["『"],["剣","けん"],["よ"],["、"],["この"],["国","くに"],["を"],["行き","いき"],["巡れ","めぐれ"],["』"],["と"],["言って","いって"],["、"],["その"],["国","くに"],["から"],["人","ひと"],["も"],["家畜","かちく"],["も"],["絶ち","たち"],["滅ぼすなら","ほろぼすなら"],["、"]]},{"verse":18,"text":"たとえ、その中にかの三人の人物がいたとしても――わたしは生きている、と主なる神は言われる――彼らは自分の息子、娘たちすら救うことができない。彼らは自分自身を救いうるだけである。","tok":[["たとえ"],["、"],["その"],["中","なか"],["に"],["か"],["の"],["三人","さんにん"],["の"],["人物","じんぶつ"],["が"],["いた"],["として"],["も"],["―"],["―"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["―"],["―"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["すら"],["救う","すくう"],["こと"],["が"],["できない"],["。"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["自身","じしん"],["を"],["救い","すくい"],["うる"],["だけ"],["で"],["ある"],["。"]]},{"verse":19,"text":"また、もしわたしがその国に疫病を送り、わたしの怒りをその上に血と共に注ぎ、そこから人も家畜も絶ち滅ぼすなら、","tok":[["また"],["、"],["もし"],["わたし"],["が"],["その"],["国","くに"],["に"],["疫病","やくびょう"],["を"],["送り","おくり"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["その"],["上","うえ"],["に"],["血","ち"],["と"],["共","とも"],["に"],["注ぎ","そそぎ"],["、"],["そこ"],["から"],["人","ひと"],["も"],["家畜","かちく"],["も"],["絶ち","たち"],["滅ぼすなら","ほろぼすなら"],["、"]]},{"verse":20,"text":"たとえ、その中にノア、ダニエル、ヨブがいたとしても――わたしは生きている、と主なる神は言われる――彼らは自分の息子、娘たちすら救うことができない。彼らはその正しさによって、自分自身の命を救いうるだけである。","tok":[["たとえ"],["、"],["その"],["中","なか"],["に"],["ノア"],["、"],["ダニエル"],["、"],["ヨブ"],["が"],["いた"],["として"],["も"],["―"],["―"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["と"],["主","ぬし"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["―"],["―"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["の"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["すら"],["救う","すくう"],["こと"],["が"],["できない"],["。"],["彼","かれ"],["ら"],["は"],["その"],["正し","ただし"],["さ"],["によって"],["、"],["自分","じぶん"],["自身","じしん"],["の"],["命","いのち"],["を"],["救い","すくい"],["うる"],["だけ"],["で"],["ある"],["。"]]},{"verse":21,"text":"まことに、主なる神はこう言われる。わたしがこの四つの厳しい裁き、すなわち、剣、飢饉、悪い獣、疫病をエルサレムに送り、そこから人も家畜も絶ち滅ぼすとき、","tok":[["まこと"],["に"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["わたし"],["が"],["この"],["四","よん"],["つ"],["の"],["厳しい","きびしい"],["裁き","さばき"],["、"],["すなわち"],["、"],["剣","けん"],["、"],["飢饉","ききん"],["、"],["悪い","わるい"],["獣","けもの"],["、"],["疫病","やくびょう"],["を"],["エルサレム"],["に"],["送り","おくり"],["、"],["そこ"],["から"],["人","ひと"],["も"],["家畜","かちく"],["も"],["絶ち","たち"],["滅ぼす","ほろぼす"],["とき"],["、"]]},{"verse":22,"text":"そこに、わずかの者が残されるであろう。息子、娘たちは逃れて救い出され、お前たちの所に出て来る。お前たちは彼らの歩みと行いを見るとき、わたしがエルサレムにくだした災い、わたしがそこに臨ませたすべてのことについて慰められる。","tok":[["そこ"],["に"],["、"],["わずか"],["の"],["者","もの"],["が"],["残されるで","のこされるで"],["あろう"],["。"],["息子","むすこ"],["、"],["娘","むすめ"],["たち"],["は"],["逃れて","のがれて"],["救い出され","すくいだされ"],["、"],["お前","おまえ"],["たち"],["の"],["所","ところ"],["に"],["出て","でて"],["来る","くる"],["。"],["お前","おまえ"],["たち"],["は"],["彼","かれ"],["ら"],["の"],["歩み","あゆみ"],["と"],["行い","おこない"],["を"],
[{"verse":1,"text":"第十一年の三月一日に、主の言葉がわたしに臨んだ。","tok":[["第","だい"],["十一","じゅういち"],["年","ねん"],["の"],["三","さん"],["月","がつ"],["一","いち"],["日","にち"],["に"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["。"]]},{"verse":2,"text":"「人の子よ、エジプトの王ファラオとその軍勢に向かって言いなさい。お前の偉大さは誰と比べられよう。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["エジプト"],["の"],["王","おう"],["ファラオ"],["と"],["その"],["軍勢","ぐんぜい"],["に"],["向かって","むかって"],["言い","いい"],["なさい"],["。"],["お前","おまえ"],["の"],["偉大","いだい"],["さ"],["は"],["誰","だれ"],["と"],["比べられよう","くらべられよう"],["。"]]},{"verse":3,"text":"見よ、あなたは糸杉、レバノンの杉だ。その枝は美しく、豊かな陰をつくり丈は高く、梢は雲間にとどいた。","tok":[["見よ","みよ"],["、"],["あなた"],["は"],["糸杉","いとすぎ"],["、"],["レバノン"],["の"],["杉","すぎ"],["だ"],["。"],["その"],["枝","えだ"],["は"],["美しく","うつくしく"],["、"],["豊か","ゆたか"],["な"],["陰","かげ"],["を"],["つくり"],["丈","たけ"],["は"],["高く","たかく"],["、"],["梢","こずえ"],["は"],["雲間","くもま"],["に"],["とどいた"],["。"]]},{"verse":4,"text":"水がそれを育て、淵がそれを大きくした。淵から流れる川は杉の周りを潤し水路は野のすべての木に水を送った。","tok":[["水","みず"],["が"],["それ"],["を"],["育て","そだて"],["、"],["淵","ふち"],["が"],["それ"],["を"],["大きく","おおきく"],["した"],["。"],["淵","ふち"],["から"],["流れる","ながれる"],["川","かわ"],["は"],["杉","すぎ"],["の"],["周り","まわり"],["を"],["潤し","うるおし"],["水路","すいろ"],["は"],["野","の"],["の"],["すべて"],["の"],["木","き"],["に"],["水","みず"],["を"],["送った","おくった"],["。"]]},{"verse":5,"text":"その丈は野のすべての木より高くなり豊かに注ぐ水のゆえに大枝は茂り、若枝は伸びた。","tok":[["その"],["丈","たけ"],["は"],["野","の"],["の"],["すべて"],["の"],["木","き"],["より"],["高く","たかく"],["なり"],["豊か","ゆたか"],["に"],["注ぐ","そそぐ"],["水","みず"],["の"],["ゆえ"],["に"],["大枝","おおえだ"],["は"],["茂り","しげり"],["、"],["若枝","わかえだ"],["は"],["伸びた","のびた"],["。"]]},{"verse":6,"text":"大枝には空のすべての鳥が巣を作り若枝の下では野のすべての獣が子を産み多くの国民が皆、その木陰に住んだ。","tok":[["大枝","おおえだ"],["に"],["は"],["空","そら"],["の"],["すべて"],["の"],["鳥","とり"],["が"],["巣","す"],["を"],["作り","つくり"],["若枝","わかえだ"],["の"],["下","もと"],["で"],["は"],["野","の"],["の"],["すべて"],["の"],["獣","けもの"],["が"],["子","こ"],["を"],["産み","うみ"],["多く","おおく"],["の"],["国民","こくみん"],["が"],["皆","みな"],["、"],["その"],["木陰","こかげ"],["に"],["住んだ","すんだ"],["。"]]},{"verse":7,"text":"丈は高く、枝は長く伸びて美しかった。豊かな水に根をおろしていたからだ。","tok":[["丈","たけ"],["は"],["高く","たかく"],["、"],["枝","えだ"],["は"],["長く","ながく"],["伸びて","のびて"],["美しかった","うつくしかった"],["。"],["豊か","ゆたか"],["な"],["水","みず"],["に"],["根","ね"],["を"],["おろして"],["いた"],["から"],["だ"],["。"]]},{"verse":8,"text":"神の園の杉もこれに及ばず樅の木も、その大枝に比べえずすずかけの木もその若枝と競いえず神の園のどの木も美しさを比べえなかった。","tok":[["神","かみ"],["の"],["園","その"],["の"],["杉","すぎ"],["も"],["これ"],["に"],["及ばず","およばず"],["樅","もみ"],["の"],["木","き"],["も"],["、"],["その"],["大枝","おおえだ"],["に"],["比べ","くらべ"],["えず"],["すずかけ"],["の"],["木","き"],["も"],["その"],["若枝","わかえだ"],["と"],["競い","きそい"],["えず"],["神","かみ"],["の"],["園","その"],["の"],["どの"],["木","き"],["も"],["美し","うつくし"],["さ"],["を"],["比べ","くらべ"],["えなかった"],["。"]]},{"verse":9,"text":"わたしが、多くの枝で美しく飾ったので神の園エデンのすべての木もうらやんだ。","tok":[["わたし"],["が"],["、"],["多く","おおく"],["の"],["枝","えだ"],["で"],["美しく","うつくしく"],["飾った","かざった"],["ので"],["神","かみ"],["の"],["園","その"],["エデン"],["の"],["すべて"],["の"],["木","き"],["も"],["うらやんだ"],["。"]]},{"verse":10,"text":"それゆえ、主なる神はこう言われる。彼の丈は高くされ、その梢を雲の間に伸ばしたので、心は驕り高ぶった。","tok":[["それ"],["ゆえ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["彼","かれ"],["の"],["丈","たけ"],["は"],["高く","たかく"],["され"],["、"],["その"],["梢","こずえ"],["を"],["雲","くも"],["の"],["間","あいだ"],["に"],["伸ばした","のばした"],["ので"],["、"],["心","こころ"],["は"],["驕り高ぶった","おごりたかぶった"],["。"]]},{"verse":11,"text":"わたしは彼を諸国の民の最も強い者の手に渡す。その者は彼を悪行に応じて扱う。わたしは彼を追放する。","tok":[["わたし"],["は"],["彼","かれ"],["を"],["諸国","しょこく"],["の"],["民","たみ"],["の"],["最も","もっとも"],["強い","つよい"],["者","もの"],["の"],["手","て"],["に"],["渡す","わたす"],["。"],["その"],["者","もの"],["は"],["彼","かれ"],["を"],["悪行","あくぎょう"],["に"],["応じて","おうじて"],["扱う","あつかう"],["。"],["わたし"],["は"],["彼","かれ"],["を"],["追放","ついほう"],["する"],["。"]]},{"verse":12,"text":"諸国の最も凶暴な民である異国人が彼を切り倒し、山々の上に捨てる。その枝はすべての谷間に落ち、若枝は切られて地のすべての谷を埋める。地上のすべての民は、その木陰から逃げ去り、彼を捨てる。","tok":[["諸国","しょこく"],["の"],["最も","もっとも"],["凶暴","きょうぼう"],["な"],["民","たみ"],["で"],["ある"],["異国人","いこくにん"],["が"],["彼","かれ"],["を"],["切り倒し","きりたおし"],["、"],["山々","やまやま"],["の"],["上","うえ"],["に"],["捨てる","すてる"],["。"],["その"],["枝","えだ"],["は"],["すべて"],["の"],["谷間","たにま"],["に"],["落ち","おち"],["、"],["若枝","わかえだ"],["は"],["切られて","きられて"],["地","ち"],["の"],["すべて"],["の"],["谷","たに"],["を"],["埋める","うめる"],["。"],["地上","ちじょう"],["の"],["すべて"],["の"],["民","たみ"],["は"],["、"],["その"],["木陰","こかげ"],["から"],["逃げ去り","にげさり"],["、"],["彼","かれ"],["を"],["捨てる","すてる"],["。"]]},{"verse":13,"text":"彼の倒された幹には、空のすべての鳥が住み若枝のもとには、野のすべての獣がやどる。","tok":[["彼","かれ"],["の"],["倒された","たおされた"],["幹","みき"],["に"],["は"],["、"],["空","そら"],["の"],["すべて"],["の"],["鳥","とり"],["が"],["住み","すみ"],["若枝","わかえだ"],["の"],["もと"],["に"],["は"],["、"],["野","の"],["の"],["すべて"],["の"],["獣","けもの"],["が"],["やどる"],["。"]]},{"verse":14,"text":"もはや、水のほとりの木もすべて丈を高くしえず、梢を雲の間に伸ばしえず、水に潤う木も、高ぶってそびえ立つことはできない。彼らはすべて死に渡され、穴に下る人の子らと共に地の深き所へ行く。","tok":[["もはや"],["、"],["水","みず"],["の"],["ほとり"],["の"],["木","き"],["も"],["すべて"],["丈","たけ"],["を"],["高く","たかく"],["し"],["えず"],["、"],["梢","こずえ"],["を"],["雲","くも"],["の"],["間","あいだ"],["に"],["伸ばし","のばし"],["えず"],["、"],["水","みず"],["に"],["潤う","うるおう"],["木","き"],["も"],["、"],["高ぶって","たかぶって"],["そびえ立つ","そびえたつ"],["こと"],["は"],["できない"],["。"],["彼","かれ"],["ら"],["は"],["すべて"],["死","し"],["に"],["渡され","わたされ"],["、"],["穴","あな"],["に"],["下る","くだる"],["人","ひと"],["の"],["子","こ"],["ら"],["と"],["共","とも"],["に"],["地","ち"],["の"],["深き","ふかき"],["所","ところ"],["へ"],["行く","いく"],["。"]]},{"verse":15,"text":"主なる神はこう言われる。彼が陰府に下る日に、わたしは彼のゆえに淵を喪に服させ、彼を覆う。わたしが川をせき止めるので、豊かな水も干上がる。またレバノンに彼の弔いをさせるので、野のすべての木も、彼のゆえにしおれる。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["彼","かれ"],["が"],["陰府","よみ"],["に"],["下る","くだる"],["日","ひ"],["に"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["ゆえ"],["に"],["淵","ふち"],["を"],["喪","も"],["に"],["服させ","ふくさせ"],["、"],["彼","かれ"],["を"],["覆う","おおう"],["。"],["わたし"],["が"],["川","かわ"],["を"],["せき止める","せきとめる"],["ので"],["、"],["豊か","ゆたか"],["な"],["水","みず"],["も"],["干上がる","ひあがる"],["。"],["また"],["レバノン"],["に"],["彼","かれ"],["の"],["弔い","とむらい"],["を"],["させる"],["ので"],["、"],["野","の"],["の"],["すべて"],["の"],["木","き"],["も"],["、"],["彼","かれ"],["の"],["ゆえ"],["に"],["しおれる"],["。"]]},{"verse":16,"te
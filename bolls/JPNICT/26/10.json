[{"verse":1,"text":"わたしが見ていると、ケルビムの頭上の大空の上に、サファイアの石のようで、形は王座のように見えるものがあるではないか。それはケルビムの上に見えた。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["ケルビム"],["の"],["頭上","ずじょう"],["の"],["大空","おおぞら"],["の"],["上","うえ"],["に"],["、"],["サファイア"],["の"],["石","いし"],["の"],["よう"],["で"],["、"],["形","かたち"],["は"],["王座","おうざ"],["の"],["よう"],["に"],["見える","みえる"],["もの"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"],["それ"],["は"],["ケルビム"],["の"],["上","うえ"],["に"],["見えた","みえた"],["。"]]},{"verse":2,"text":"主は亜麻布をまとった者に向かって言われた。「ケルビムの下の回転するものの間に入れ。そして、ケルビムの間にある燃える炭火を両手に満たし、それを都の上にまき散らせ」と。彼は、わたしの目の前で入って行った。","tok":[["主","ぬし"],["は"],["亜","あ"],["麻布","まふ"],["を"],["まとった"],["者","もの"],["に"],["向かって","むかって"],["言われた","いわれた"],["。"],["「"],["ケルビム"],["の"],["下","した"],["の"],["回転","かいてん"],["する"],["もの"],["の"],["間","あいだ"],["に"],["入れ","いれ"],["。"],["そして"],["、"],["ケルビム"],["の"],["間","あいだ"],["に"],["ある"],["燃える","もえる"],["炭火","すみび"],["を"],["両手","りょうて"],["に"],["満たし","みたし"],["、"],["それ"],["を"],["都","と"],["の"],["上","うえ"],["に"],["まき散らせ","まきちらせ"],["」"],["と"],["。"],["彼","かれ"],["は"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["で"],["入って","はいって"],["行った","いった"],["。"]]},{"verse":3,"text":"その人が入って行ったとき、ケルビムは神殿の南側に止まっており、雲が中庭を満たしていた。","tok":[["その"],["人","ひと"],["が"],["入って","はいって"],["行った","いった"],["とき"],["、"],["ケルビム"],["は"],["神殿","しんでん"],["の"],["南側","みなみがわ"],["に"],["止まって","とまって"],["おり"],["、"],["雲","くも"],["が"],["中庭","なかにわ"],["を"],["満たして","みたして"],["いた"],["。"]]},{"verse":4,"text":"主の栄光はケルビムの上から立ち上がり、神殿の敷居に向かった。神殿は雲で満たされ、庭は主の栄光の輝きで満たされた。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["は"],["ケルビム"],["の"],["上","うえ"],["から"],["立ち上がり","たちあがり"],["、"],["神殿","しんでん"],["の"],["敷居","しきい"],["に"],["向かった","むかった"],["。"],["神殿","しんでん"],["は"],["雲","くも"],["で"],["満たされ","みたされ"],["、"],["庭","にわ"],["は"],["主","ぬし"],["の"],["栄光","えいこう"],["の"],["輝き","かがやき"],["で"],["満たされた","みたされた"],["。"]]},{"verse":5,"text":"ケルビムの翼の羽ばたく音は外庭にまで聞こえ、全能の神が語られる御声のようであった。","tok":[["ケルビム"],["の"],["翼","つばさ"],["の"],["羽ばたく","はばたく"],["音","おと"],["は"],["外庭","そとにわ"],["に"],["まで"],["聞こえ","きこえ"],["、"],["全能","ぜんのう"],["の"],["神","かみ"],["が"],["語られる","かたられる"],["御声","おこえ"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":6,"text":"主が亜麻布をまとった人に命じて、「火を、回転するものの間、ケルビムの間から取れ」と言われたので、彼は来て、車輪の傍らに立った。","tok":[["主","ぬし"],["が"],["亜","あ"],["麻布","まふ"],["を"],["まとった"],["人","ひと"],["に"],["命じて","めいじて"],["、"],["「"],["火","ひ"],["を"],["、"],["回転","かいてん"],["する"],["もの"],["の"],["間","あいだ"],["、"],["ケルビム"],["の"],["間","あいだ"],["から"],["取れ","とれ"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["彼","かれ"],["は"],["来て","きて"],["、"],["車輪","しゃりん"],["の"],["傍ら","かたわら"],["に"],["立った","たった"],["。"]]},{"verse":7,"text":"すると、ケルビムのひとりが、手をケルビムの間から、ケルビムの間にある火に向かって伸ばして火を取り上げ、亜麻布をまとった者の両手に置いた。その人は火を受け取って、出て行った。","tok":[["する"],["と"],["、"],["ケルビム"],["の"],["ひとり"],["が"],["、"],["手","て"],["を"],["ケルビム"],["の"],["間","あいだ"],["から"],["、"],["ケルビム"],["の"],["間","あいだ"],["に"],["ある"],["火","ひ"],["に"],["向かって","むかって"],["伸ばして","のばして"],["火","ひ"],["を"],["取り上げ","とりあげ"],["、"],["亜","あ"],["麻布","まふ"],["を"],["まとった"],["者","もの"],["の"],["両手","りょうて"],["に"],["置いた","おいた"],["。"],["その"],["人","ひと"],["は"],["火","ひ"],["を"],["受け取って","うけとって"],["、"],["出て","でて"],["行った","いった"],["。"]]},{"verse":8,"text":"ケルビムには、その翼の下に、人間の手の形が見えていた。","tok":[["ケルビム"],["に"],["は"],["、"],["その"],["翼","つばさ"],["の"],["下","した"],["に"],["、"],["人間","にんげん"],["の"],["手","て"],["の"],["形","かたち"],["が"],["見えて","みえて"],["いた"],["。"]]},{"verse":9,"text":"わたしが見ていると、四つの車輪が、ケルビムの傍らにあるではないか。一つの車輪が、ひとりのケルビムの傍らに、また一つの車輪が、ひとりのケルビムの傍らにというように、それぞれの傍らにあって、それらの車輪の有様は緑柱石のように輝いていた。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["四","よん"],["つ"],["の"],["車輪","しゃりん"],["が"],["、"],["ケルビム"],["の"],["傍ら","かたわら"],["に"],["ある"],["で"],["は"],["ない"],["か"],["。"],["一","ひと"],["つ"],["の"],["車輪","しゃりん"],["が"],["、"],["ひとり"],["の"],["ケルビム"],["の"],["傍ら","かたわら"],["に"],["、"],["また"],["一","ひと"],["つ"],["の"],["車輪","しゃりん"],["が"],["、"],["ひとり"],["の"],["ケルビム"],["の"],["傍ら","かたわら"],["に"],["と"],["いう"],["よう"],["に"],["、"],["それぞれ"],["の"],["傍ら","かたわら"],["に"],["あって"],["、"],["それ"],["ら"],["の"],["車輪","しゃりん"],["の"],["有様","ありさま"],["は"],["緑柱石","りょくちゅうせき"],["の"],["よう"],["に"],["輝いて","かがやいて"],["いた"],["。"]]},{"verse":10,"text":"それぞれの形の有様は、四つとも同じで、一つの車輪がもう一つの車輪の中にあるかのようであった。","tok":[["それぞれ"],["の"],["形","かたち"],["の"],["有様","ありさま"],["は"],["、"],["四","よん"],["つ"],["とも"],["同じ","おなじ"],["で"],["、"],["一","ひと"],["つ"],["の"],["車輪","しゃりん"],["が"],["もう"],["一","ひと"],["つ"],["の"],["車輪","しゃりん"],["の"],["中","なか"],["に"],["ある"],["か"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":11,"text":"それらが移動するときは、四つの方向に進み、移動するときに、向きを変えることはなかった。先頭のケルビムが向かうところに他のものも従って進み、向きを変えなかったからである。","tok":[["それ"],["ら"],["が"],["移動","いどう"],["する"],["とき"],["は"],["、"],["四","よん"],["つ"],["の"],["方向","ほうこう"],["に"],["進み","すすみ"],["、"],["移動","いどう"],["する"],["とき"],["に"],["、"],["向き","むき"],["を"],["変える","かえる"],["こと"],["は"],["なかった"],["。"],["先頭","せんとう"],["の"],["ケルビム"],["が"],["向かう","むかう"],["ところ"],["に"],["他","ほか"],["の"],["もの"],["も"],["従って","したがって"],["進み","すすみ"],["、"],["向き","むき"],["を"],["変えなかった","かえなかった"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"ケルビムの全身、すなわち、背中、両手、翼と、車輪にはその周囲一面に目がつけられていた。ケルビムの車輪は四つともそうであった。","tok":[["ケルビム"],["の"],["全身","ぜんしん"],["、"],["すなわち"],["、"],["背中","せなか"],["、"],["両手","りょうて"],["、"],["翼","つばさ"],["と"],["、"],["車輪","しゃりん"],["に"],["は"],["その"],["周囲","しゅうい"],["一面","いちめん"],["に"],["目","め"],["が"],["つけられて"],["いた"],["。"],["ケルビム"],["の"],["車輪","しゃりん"],["は"],["四","よん"],["つ"],["と"],["も"],["そう"],["で"],["あった"],["。"]]},{"verse":13,"text":"それらの車輪は「回転するもの」と呼ばれているのが、わたしの耳に聞こえた。","tok":[["それ"],["ら"],["の"],["車輪","しゃりん"],["は"],["「"],["回転","かいてん"],["する"],["もの"],["」"],["と"],["呼ばれて","よばれて"],["いる"],["の"],["が"],["、"],["わたし"],["の"],["耳","みみ"],["に"],["聞こえた","きこえた"],["。"]]},{"verse":14,"text":"ケルビムにはそれぞれ四つの顔があり、第一の顔はケルビムの顔、第二の顔は人間の顔、第三の顔は獅子の顔、そして第四の顔は鷲の顔であった。","tok":[["ケルビム"],["に"],["は"],["それぞれ"],["四","よん"],["つ"],["の"],["顔","かお"],["が"],["あり"],["、"],["第","だい"],["一","いち"],["の"],["顔","かお"],["は"],["ケルビム"],["の"],["顔","かお"],["、"],["第","だい"],["二","に"],["の"],["顔","かお"],["は"],["人間","にんげん"],["の"],["顔","かお"],["、"],["第","だい"],["三","さん"],["の"],["顔","かお"],["は"],["獅子","しし"],["の"],["顔","かお"],["、"],["そして"],["第","だい"],["四","よん"],["の"],["顔","かお"],["は"],["鷲","わし"],["の"],["顔","かお"],["で"],["あった"],["。"]]},{"verse":15,"text":"ケルビムは上った。これがケバル川のほとりでわたしが見たあの生き物である。","tok":[["ケルビム"],["は"],["上った","のぼった"],["。"],["これ"],["が"],["ケバル"],["川","かわ"],["の"],["ほとり"],["で"],["わたし"],["が"],["見た","みた"],["あの"],["生き物","いきもの"],["で"],["ある"],["。"]]},{"verse":16,"text":"ケルビムが移動するとき、車輪もその傍らを進み、ケルビムが翼を広げて地上から上るとき、車輪もその傍らを離れて回ることはなかった。","tok":[["ケルビム"],["が"],["移動","いどう"],["する"],["とき"],["、"],["車輪","しゃりん"],["も"],["その"],["傍ら","かたわら"],["を"],["進み","すすみ"],["、"],["ケルビム"],["が"],["翼","つばさ"],["を"],["広げて","ひろげて"],["地上","ちじょう"],["から"],["上る","のぼる"],["とき"],["、"],["車輪","しゃりん"],["も"],["その"],["傍ら","かたわら"],["を"],["離れて","はなれて"],["回る","まわる"],["こと"],["は"],["なかった"],["。"]]},{"verse":17,"text":"ケルビムが止まると、車輪も止まり、ケルビムが上ると、車輪も共に上った。生き物の霊がその中にあったからである。","tok":[["ケルビム"],["が"],["止まる","とまる"],["と"],["、"],["車輪","しゃりん"],["も"],["止まり","とまり"],["、"],["ケルビム"],["が"],["上る","のぼる"],["と"],["、"],["車輪","しゃりん"],["も"],["共","とも"],["に"],["上った","のぼった"],["。"],["生き物","いきもの"],["の"],["霊","れい"],["が"],["その"],["中","なか"],["に"],["あった"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"主の栄光は神殿の敷居の上から出て、ケルビムの上にとどまった。","tok":[["主","ぬし"],["の"],["栄光","えいこう"],["は"],["神殿","しんでん"],["の"],["敷居","しきい"],["の"],["上","うえ"],["から"],["出て","でて"],["、"],["ケルビム"],["の"],["上","うえ"],["に"],["とどまった"],["。"]]},{"verse":19,"text":"ケルビムは翼を広げ、傍らの車輪と共に出て行くとき、わたしの目の前で地から上って行き、主の神殿の東の門の入り口で止まった。イスラエルの神の栄光は高くその上にあった。","tok":[["ケルビム"],["は"],["翼","つばさ"],["を"],["広げ","ひろげ"],["、"],["傍ら","かたわら"],["の"],["車輪","しゃりん"],["と"],["共","とも"],["に"],["出て","でて"],["行く","いく"],["とき"],["、"],["わたし"],["の"],["目","め"],["の"],["前","まえ"],["で"],["地","ち"],["から"],["上って","のぼって"],["行き","いき"],["、"],["主","ぬし"],["の"],["神殿","しんでん"],["の"],["東","ひがし"],["の"],["門","もん"],["の"],["入り口","いりぐち"],["で"],["止まった","とまった"],["。"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["は"],["高く","たかく"],["その"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":20,"text":"これがケバル川の河畔で、わたしがイスラエルの神のもとにいるのを見たあの生き物である。わたしは、それがケルビムであることを知った。","tok":[["これ"],["が"],["ケバル"],["川","かわ"],["の"],["河畔","かはん"],["で"],["、"],["わた
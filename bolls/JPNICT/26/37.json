[{"verse":1,"text":"主の手がわたしの上に臨んだ。わたしは主の霊によって連れ出され、ある谷の真ん中に降ろされた。そこは骨でいっぱいであった。","tok":[["主","ぬし"],["の"],["手","て"],["が"],["わたし"],["の"],["上","うえ"],["に"],["臨んだ","のぞんだ"],["。"],["わたし"],["は"],["主","ぬし"],["の"],["霊","れい"],["によって"],["連れ出され","つれだされ"],["、"],["ある"],["谷","たに"],["の"],["真ん中","まんなか"],["に"],["降ろされた","おろされた"],["。"],["そこ"],["は"],["骨","ほね"],["で"],["いっぱい"],["で"],["あった"],["。"]]},{"verse":2,"text":"主はわたしに、その周囲を行き巡らせた。見ると、谷の上には非常に多くの骨があり、また見ると、それらは甚だしく枯れていた。","tok":[["主","ぬし"],["は"],["わたし"],["に"],["、"],["その"],["周囲","しゅうい"],["を"],["行き","いき"],["巡らせた","めぐらせた"],["。"],["見る","みる"],["と"],["、"],["谷","たに"],["の"],["上","うえ"],["に"],["は"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["骨","ほね"],["が"],["あり"],["、"],["また"],["見る","みる"],["と"],["、"],["それ"],["ら"],["は"],["甚だしく","はなはだしく"],["枯れて","かれて"],["いた"],["。"]]},{"verse":3,"text":"そのとき、主はわたしに言われた。「人の子よ、これらの骨は生き返ることができるか。」わたしは答えた。「主なる神よ、あなたのみがご存じです。」","tok":[["その"],["とき"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["これ"],["ら"],["の"],["骨","ほね"],["は"],["生き返る","いきかえる"],["こと"],["が"],["できる"],["か"],["。"],["」"],["わたし"],["は"],["答えた","こたえた"],["。"],["「"],["主","おも"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["のみ"],["が"],["ご存じ","ごぞんじ"],["です"],["。"],["」"]]},{"verse":4,"text":"そこで、主はわたしに言われた。「これらの骨に向かって預言し、彼らに言いなさい。枯れた骨よ、主の言葉を聞け。","tok":[["そこ"],["で"],["、"],["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["これ"],["ら"],["の"],["骨","ほね"],["に"],["向かって","むかって"],["預言","よげん"],["し"],["、"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["。"],["枯れた","かれた"],["骨","ほね"],["よ"],["、"],["主","ぬし"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":5,"text":"これらの骨に向かって、主なる神はこう言われる。見よ、わたしはお前たちの中に霊を吹き込む。すると、お前たちは生き返る。","tok":[["これ"],["ら"],["の"],["骨","ほね"],["に"],["向かって","むかって"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["中","なか"],["に"],["霊","れい"],["を"],["吹き込む","ふきこむ"],["。"],["する"],["と"],["、"],["お前","おまえ"],["たち"],["は"],["生き返る","いきかえる"],["。"]]},{"verse":6,"text":"わたしは、お前たちの上に筋をおき、肉を付け、皮膚で覆い、霊を吹き込む。すると、お前たちは生き返る。そして、お前たちはわたしが主であることを知るようになる。」","tok":[["わたし"],["は"],["、"],["お前","おまえ"],["たち"],["の"],["上","うえ"],["に"],["筋","すじ"],["を"],["おき"],["、"],["肉","にく"],["を"],["付け","つけ"],["、"],["皮膚","ひふ"],["で"],["覆い","おおい"],["、"],["霊","れい"],["を"],["吹き込む","ふきこむ"],["。"],["する"],["と"],["、"],["お前","おまえ"],["たち"],["は"],["生き返る","いきかえる"],["。"],["そして"],["、"],["お前","おまえ"],["たち"],["は"],["わたし"],["が"],["主","ぬし"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"],["」"]]},{"verse":7,"text":"わたしは命じられたように預言した。わたしが預言していると、音がした。見よ、カタカタと音を立てて、骨と骨とが近づいた。","tok":[["わたし"],["は"],["命じられた","めいじられた"],["よう"],["に"],["預言","よげん"],["した"],["。"],["わたし"],["が"],["預言","よげん"],["して"],["いる"],["と"],["、"],["音","おと"],["が"],["した"],["。"],["見よ","みよ"],["、"],["カタカタ"],["と"],["音","おと"],["を"],["立てて","たてて"],["、"],["骨","ほね"],["と"],["骨","ほね"],["と"],["が"],["近づいた","ちかづいた"],["。"]]},{"verse":8,"text":"わたしが見ていると、見よ、それらの骨の上に筋と肉が生じ、皮膚がその上をすっかり覆った。しかし、その中に霊はなかった。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["それ"],["ら"],["の"],["骨","ほね"],["の"],["上","うえ"],["に"],["筋","すじ"],["と"],["肉","にく"],["が"],["生じ","しょうじ"],["、"],["皮膚","ひふ"],["が"],["その"],["上","うえ"],["を"],["すっかり"],["覆った","おおった"],["。"],["しかし"],["、"],["その"],["中","なか"],["に"],["霊","れい"],["は"],["なかった"],["。"]]},{"verse":9,"text":"主はわたしに言われた。「霊に預言せよ。人の子よ、預言して霊に言いなさい。主なる神はこう言われる。霊よ、四方から吹き来れ。霊よ、これらの殺されたものの上に吹きつけよ。そうすれば彼らは生き返る。」","tok":[["主","ぬし"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["霊","れい"],["に"],["預言","よげん"],["せよ"],["。"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["預言","よげん"],["して"],["霊","れい"],["に"],["言い","いい"],["なさい"],["。"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["。"],["霊","れい"],["よ"],["、"],["四方","しほう"],["から"],["吹き来れ","ふきくれ"],["。"],["霊","れい"],["よ"],["、"],["これ"],["ら"],["の"],["殺された","ころされた"],["もの"],["の"],["上","うえ"],["に"],["吹きつけよ","ふきつけよ"],["。"],["そう"],["すれば"],["彼","かれ"],["ら"],["は"],["生き返る","いきかえる"],["。"],["」"]]},{"verse":10,"text":"わたしは命じられたように預言した。すると、霊が彼らの中に入り、彼らは生き返って自
[{"verse":1,"text":"彼はわたしに言われた。「人の子よ、自分の足で立て。わたしはあなたに命じる。」","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["自分","じぶん"],["の"],["足","あし"],["で"],["立て","たて"],["。"],["わたし"],["は"],["あなた"],["に"],["命じる","めいじる"],["。"],["」"]]},{"verse":2,"text":"彼がわたしに語り始めたとき、霊がわたしの中に入り、わたしを自分の足で立たせた。わたしは語りかける者に耳を傾けた。","tok":[["彼","かれ"],["が"],["わたし"],["に"],["語り","かたり"],["始めた","はじめた"],["とき"],["、"],["霊","れい"],["が"],["わたし"],["の"],["中","なか"],["に"],["入り","はいり"],["、"],["わたし"],["を"],["自分","じぶん"],["の"],["足","あし"],["で"],["立たせた","たたせた"],["。"],["わたし"],["は"],["語りかける","かたりかける"],["者","もの"],["に"],["耳","みみ"],["を"],["傾けた","かたむけた"],["。"]]},{"verse":3,"text":"主は言われた。「人の子よ、わたしはあなたを、イスラエルの人々、わたしに逆らった反逆の民に遣わす。彼らは、その先祖たちと同様わたしに背いて、今日この日に至っている。","tok":[["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["、"],["わたし"],["に"],["逆らった","さからった"],["反逆","はんぎゃく"],["の"],["民","たみ"],["に"],["遣わす","つかわす"],["。"],["彼","かれ"],["ら"],["は"],["、"],["その"],["先祖","せんぞ"],["たち"],["と"],["同様","どうよう"],["わたし"],["に"],["背いて","そむいて"],["、"],["今日","きょう"],["この"],["日","ひ"],["に"],["至って","いたって"],["いる"],["。"]]},{"verse":4,"text":"恥知らずで、強情な人々のもとに、わたしはあなたを遣わす。彼らに言いなさい、主なる神はこう言われる、と。","tok":[["恥","はじ"],["知らずで","しらずで"],["、"],["強情","ごうじょう"],["な"],["人々","ひとびと"],["の"],["もと"],["に"],["、"],["わたし"],["は"],["あなた"],["を"],["遣わす","つかわす"],["。"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["と"],["。"]]},{"verse":5,"text":"彼らが聞き入れようと、また、反逆の家なのだから拒もうとも、彼らは自分たちの間に預言者がいたことを知るであろう。","tok":[["彼","かれ"],["ら"],["が"],["聞き入れよう","ききいれよう"],["と"],["、"],["また"],["、"],["反逆","はんぎゃく"],["の"],["家","いえ"],["な"],["の"],["だ"],["から"],["拒もう","こばもう"],["とも"],["、"],["彼","かれ"],["ら"],["は"],["自分","じぶん"],["たち"],["の"],["間","あいだ"],["に"],["預言者","よげんしゃ"],["が"],["いた"],["こと"],["を"],["知るで","しるで"],["あろう"],["。"]]},{"verse":6,"text":"人の子よ、あなたはあざみと茨に押しつけられ、蠍の上に座らされても、彼らを恐れてはならない。またその言葉を恐れてはならない。彼らが反逆の家だからといって、彼らの言葉を恐れ、彼らの前にたじろいではならない。","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["あざみ"],["と"],["茨","うばら"],["に"],["押しつけられ","おしつけられ"],["、"],["蠍","さそり"],["の"],["上","うえ"],["に"],["座らされて","すわらされて"],["も"],["、"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["また"],["その"],["言葉","ことば"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["反逆","はんぎゃく"],["の"],["家","いえ"],["だ"],["から"],["と"],["いって"],["、"],["彼","かれ"],["ら"],["の"],["言葉","ことば"],["を"],["恐れ","おそれ"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["たじろいで"],["は"],["ならない"],["。"]]},{"verse":7,"text":"たとえ彼らが聞き入れようと拒もうと、あなたはわたしの言葉を語らなければならない。彼らは反逆の家なのだ。","tok":[["たとえ"],["彼","かれ"],["ら"],["が"],["聞き入れよう","ききいれよう"],["と"],["拒もう","こばもう"],["と"],["、"],["あなた"],["は"],["わたし"],["の"],["言葉","ことば"],["を"],["語らなければ","かたらなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["な"],["の"],["だ"],["。"]]},{"verse":8,"text":"人の子よ、わたしがあなたに語ることを聞きなさい。あなたは反逆の家のように背いてはならない。口を開いて、わたしが与えるものを食べなさい。」","tok":[["人","ひと"],["の"],["子","こ"],["よ"],["、"],["わたし"],["が"],["あなた"],["に"],["語る","かたる"],["こと"],["を"],["聞き","きき"],["なさい"],["。"],["あなた"],["は"],["反逆","はんぎゃく"],["の"],["家","いえ"],["の"],["よう"],["に"],["背いて","そむいて"],["は"],["ならない"],["。"],["口","くち"],["を"],["開いて","ひらいて"],["、"],["わたし"],["が"],["与える","あたえる"],["もの"],["を"],["食べ","たべ"],["なさい"],["。"],["」"]]},{"verse":9,"text":"わたしが見ていると、手がわたしに差し伸べられており、その手に巻物があるではないか。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["手","て"],["が"],["わたし"],["に"],["差し伸べられて","さしのべられて"],["おり"],["、"],["その"],["手","て"],["に"],["巻物","まきもの"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":10,"text":"彼がそれをわたしの前に開くと、表にも裏にも文字が記されていた。それは哀歌と、呻きと、嘆きの言葉であった。","tok":[["彼","かれ"],["が"],["それ"],["を"],["わたし"],["の"],["前","まえ"],["に"],["開く","ひらく"],["と"],["、"],["表","ひょう"],["に"],["も"],["裏","うら"],["に"],["も"],["文字","もじ"],["が"],["記されて","しるされて"],["いた"],["。"],["それ"],["は"],["哀歌","あいか"],["と"],["、"],["呻き","うめき"],["と"],["、"],["嘆き","なげき"],["の"],["言葉","ことば"],["で"],["あった"],["。"]]}]
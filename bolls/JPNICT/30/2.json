[{"verse":1,"text":"主はこう言われる。モアブの三つの罪、四つの罪のゆえにわたしは決して赦さない。彼らがエドムの王の骨を焼き、灰にしたからだ。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["モアブ"],["の"],["三","みっ"],["つ"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["決して","けっして"],["赦さない","ゆるさない"],["。"],["彼","かれ"],["ら"],["が"],["エドム"],["の"],["王","おう"],["の"],["骨","ほね"],["を"],["焼き","やき"],["、"],["灰","はい"],["に"],["した"],["から"],["だ"],["。"]]},{"verse":2,"text":"わたしはモアブに火を放つ。火はケリヨトの城郭をなめ尽くす。鬨の声があがり、角笛が鳴り響く中で混乱のうちにモアブは死ぬ。","tok":[["わたし"],["は"],["モアブ"],["に"],["火","ひ"],["を"],["放つ","はなつ"],["。"],["火","ひ"],["は"],["ケリヨト"],["の"],["城郭","じょうかく"],["を"],["なめ"],["尽くす","つくす"],["。"],["鬨の声","ときのこえ"],["が"],["あがり"],["、"],["角笛","つのぶえ"],["が"],["鳴り響く","なりひびく"],["中","なか"],["で"],["混乱","こんらん"],["の"],["うち"],["に"],["モアブ"],["は"],["死ぬ","しぬ"],["。"]]},{"verse":3,"text":"わたしは治める者をそこから絶ちその高官たちも皆殺しにすると主は言われる。","tok":[["わたし"],["は"],["治める","おさめる"],["者","もの"],["を"],["そこ"],["から"],["絶ち","たち"],["その"],["高官","こうかん"],["たち"],["も"],["皆殺し","みなごろし"],["に"],["する"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":4,"text":"主はこう言われる。ユダの三つの罪、四つの罪のゆえにわたしは決して赦さない。彼らが主の教えを拒みその掟を守らず先祖も後を追った偽りの神によって惑わされたからだ。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["ユダ"],["の"],["三","みっ"],["つ"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["決して","けっして"],["赦さない","ゆるさない"],["。"],["彼","かれ"],["ら"],["が"],["主","ぬし"],["の"],["教え","おしえ"],["を"],["拒み","こばみ"],["その"],["掟","おきて"],["を"],["守らず","まもらず"],["先祖","せんぞ"],["も"],["後","あと"],["を"],["追った","おった"],["偽り","いつわり"],["の"],["神","かみ"],["によって"],["惑わされた","まどわされた"],["から"],["だ"],["。"]]},{"verse":5,"text":"わたしはユダに火を放つ。火はエルサレムの城郭をなめ尽くす。","tok":[["わたし"],["は"],["ユダ"],["に"],["火","ひ"],["を"],["放つ","はなつ"],["。"],["火","ひ"],["は"],["エルサレム"],["の"],["城郭","じょうかく"],["を"],["なめ"],["尽くす","つくす"],["。"]]},{"verse":6,"text":"主はこう言われる。イスラエルの三つの罪、四つの罪のゆえにわたしは決して赦さない。彼らが正しい者を金で貧しい者を靴一足の値で売ったからだ。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["イスラエル"],["の"],["三","みっ"],["つ"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["決して","けっして"],["赦さない","ゆるさない"],["。"],["彼","かれ"],["ら"],["が"],["正しい","ただしい"],["者","もの"],["を"],["金","かね"],["で"],["貧しい","まずしい"],["者","もの"],["を"],["靴","くつ"],["一足","ひとあし"],["の"],["値","あたい"],["で"],["売った","うった"],["から"],["だ"],["。"]]},{"verse":7,"text":"彼らは弱い者の頭を地の塵に踏みつけ悩む者の道を曲げている。父も子も同じ女のもとに通いわたしの聖なる名を汚している。","tok":[["彼","かれ"],["ら"],["は"],["弱い","よわい"],["者","もの"],["の"],["頭","あたま"],["を"],["地","ち"],["の"],["塵","ごみ"],["に"],["踏みつけ","ふみつけ"],["悩む","なやむ"],["者","もの"],["の"],["道","みち"],["を"],["曲げて","まげて"],["いる"],["。"],["父","ちち"],["も"],["子","こ"],["も"],["同じ","おなじ"],["女","おんな"],["の"],["もと"],["に"],["通い","かよい"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚して","よごして"],["いる"],["。"]]},{"verse":8,"text":"祭壇のあるところではどこでもその傍らに質にとった衣を広げ科料として取り立てたぶどう酒を神殿の中で飲んでいる。","tok":[["祭壇","さいだん"],["の"],["ある"],["ところ"],["で"],["は"],["どこ"],["で"],["も"],["その"],["傍ら","かたわら"],["に"],["質","しつ"],["に"],["とった"],["衣","ころも"],["を"],["広げ","ひろげ"],["科料","かりょう"],["として"],["取り立てた","とりたてた"],["ぶどう酒","ぶどうしゅ"],["を"],["神殿","しんでん"],["の"],["中","なか"],["で"],["飲んで","のんで"],["いる"],["。"]]},{"verse":9,"text":"その行く手からアモリ人を滅ぼしたのはわたしだ。彼らはレバノン杉の木のように高く樫の木のように強かったがわたしは、上は梢の実から下はその根に至るまで滅ぼした。","tok":[["その"],["行く手","ゆくて"],["から"],["アモリ人","あもりにん"],["を"],["滅ぼした","ほろぼした"],["の"],["は"],["わたし"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["レバノン"],["杉","すぎ"],["の"],["木","き"],["の"],["よう"],["に"],["高く","たかく"],["樫","かし"],["の"],["木","き"],["の"],["よう"],["に"],["強かった","つよかった"],["が"],["わたし"],["は"],["、"],["上","うえ"],["は"],["梢","こずえ"],["の"],["実","じつ"],["から"],["下","した"],["は"],["その"],["根","ね"],["に"],["至る","いたる"],["まで"],["滅ぼした","ほろぼした"],["。"]]},{"verse":10,"text":"お前たちをエジプトの地から上らせ四十年の間、導いて荒れ野を行かせアモリ人の地を得させたのはわたしだ。","tok":[["お前","おまえ"],["たち"],["を"],["エジプト"],["の"],["地","ち"],["から"],["上らせ","のぼらせ"],["四十","よんじゅう"],["年","ねん"],["の"],["間","あいだ"],["、"],["導いて","みちびいて"],["荒れ野","あれの"],["を"],["行かせ","いかせ"],["アモリ人","あもりにん"],["の"],["地","ち"],["を"],["得させた","えさせた"],["の"],["は"],["わたし"],["だ"],["。"]]},{"verse":11,"text":"わたしはお前たちの中から預言者を若者の中からナジル人を起こした。イスラエルの人々よ、そうではないかと主は言われる。","tok":[["わたし"],["は"],["お前","おまえ"],["たち"],["の"],["中","なか"],["から"],["預言者","よげんしゃ"],["を"],["若者","わかもの"],["の"],["中","なか"],["から"],["ナジル人","なじるにん"],["を"],["起こした","おこした"],["。"],["イスラエル"],["の"],["人々","ひとびと"],["よ"],["、"],["そう"],["で"],["は"],["ない"],["か"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":12,"text":"しかし、お前たちはナジル人に酒を飲ませ預言者に、預言するなと命じた。","tok":[["しかし"],["、"],["お前","おまえ"],["たち"],["は"],["ナジル人","なじるにん"],["に"],["酒","さけ"],["を"],["飲ませ","のませ"],["預言者","よげんしゃ"],["に"],["、"],["預言","よげん"],["する"],["な"],["と"],["命じた","めいじた"],["。"]]},{"verse":13,"text":"見よ、わたしは麦束を満載した車がわだちで地を裂くようにお前たちの足もとの地を裂く。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["麦","むぎ"],["束","たば"],["を"],["満載","まんさい"],["した"],["車","くるま"],["が"],["わだち"],["で"],["地","ち"],["を"],["裂く","さく"],["よう"],["に"],["お前","おまえ"],["たち"],["の"],["足もと","あしもと"],["の"],["地","ち"],["を"],["裂く","さく"],["。"]]},{"verse":14,"text":"そのときは、素早い者も逃げ遅れ強い者もその力を振るいえず勇者も自分を救いえない。","tok":[["その"],["とき"],["は"],["、"],["素早い","すばやい"],["者","もの"],["も"],["逃げ","にげ"],["遅れ","おくれ"],["強い","つよい"],["者","もの"],["も"],["その"],["力","ちから"],["を"],["振るい","ふるい"],["えず"],["勇者","ゆうしゃ"],["も"],["自分","じぶん"],["を"],["救い","すくい"],["えない"],["。"]]},{"verse":15,"text":"弓を引く者も立っていられず足の速い者も逃げおおせず馬に乗る者も自分を救いえない。","tok":[["弓","ゆみ"],["を"],["引く","ひく"],["者","もの"],["も"],["立って","たって"],["いられず"],["足","あし"],["の"],["速い","はやい"],["者","もの"],["も"],["逃げ","にげ"],["おおせず"],["馬","うま"],["に"],["乗る","のる"],["者","もの"],["も"],["自分","じぶん"],["を"],["救い","すくい"],["えない"],["。"]]},{"verse":16,"text":"勇者の中の雄々しい者もその日には裸で逃げる、と主は言われる。","tok":[["勇者","ゆうしゃ"],["の"],["中","なか"],["の"],["雄々しい","おおしい"],["者","もの"],["も"],["その"],["日","ひ"],["に"],["は"],["裸","はだか"],["で"],["逃げる","にげる"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
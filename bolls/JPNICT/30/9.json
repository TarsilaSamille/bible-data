[{"verse":1,"text":"わたしは祭壇の傍らに立っておられる主を見た。主は言われた。「柱頭を打ち、敷石を揺り動かせ。すべての者の頭上で砕け。生き残った者は、わたしが剣で殺す。彼らのうちに逃れうる者はない。逃れて、生き延びる者はひとりもない。","tok":[["わたし"],["は"],["祭壇","さいだん"],["の"],["傍ら","かたわら"],["に"],["立って","たって"],["おられる"],["主","ぬし"],["を"],["見た","みた"],["。"],["主","ぬし"],["は"],["言われた","いわれた"],["。"],["「"],["柱頭","ちゅうとう"],["を"],["打ち","うち"],["、"],["敷石","しきいし"],["を"],["揺り動かせ","ゆりうごかせ"],["。"],["すべて"],["の"],["者","もの"],["の"],["頭上","ずじょう"],["で"],["砕け","くだけ"],["。"],["生き残った","いきのこった"],["者","もの"],["は"],["、"],["わたし"],["が"],["剣","けん"],["で"],["殺す","ころす"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["逃れ","のがれ"],["うる"],["者","もの"],["は"],["ない"],["。"],["逃れて","のがれて"],["、"],["生き延びる","いきのびる"],["者","もの"],["は"],["ひとり"],["も"],["ない"],["。"]]},{"verse":2,"text":"たとえ、彼らが陰府に潜り込んでもわたしは、そこからこの手で引き出す。たとえ天に上ってもわたしは、そこから引き下ろす。","tok":[["たとえ"],["、"],["彼","かれ"],["ら"],["が"],["陰府","よみ"],["に"],["潜り込んで","もぐりこんで"],["も"],["わたし"],["は"],["、"],["そこ"],["から"],["この"],["手","て"],["で"],["引き出す","ひきだす"],["。"],["たとえ"],["天","てん"],["に"],["上って","のぼって"],["も"],["わたし"],["は"],["、"],["そこ"],["から"],["引き下ろす","ひきおろす"],["。"]]},{"verse":3,"text":"たとえ、カルメルの頂に身を隠してもわたしは、そこから探し出して連れ出す。たとえ、わたしの目を逃れて、海の底に隠れてもそこで、蛇に命じてかませる。","tok":[["たとえ"],["、"],["カルメル"],["の"],["頂","いただき"],["に"],["身","み"],["を"],["隠して","かくして"],["も"],["わたし"],["は"],["、"],["そこ"],["から"],["探し出して","さがしだして"],["連れ出す","つれだす"],["。"],["たとえ"],["、"],["わたし"],["の"],["目","め"],["を"],["逃れて","のがれて"],["、"],["海","うみ"],["の"],["底","そこ"],["に"],["隠れて","かくれて"],["も"],["そこ"],["で"],["、"],["蛇","へび"],["に"],["命じて","めいじて"],["かませる"],["。"]]},{"verse":4,"text":"たとえ捕らわれ、敵の前に連れて行かれてもそこで、剣に命じて殺させる。わたしは彼らの上に目を注ぐ。それは災いのためであって幸いのためではない。」","tok":[["たとえ"],["捕らわれ","とらわれ"],["、"],["敵","てき"],["の"],["前","まえ"],["に"],["連れて","つれて"],["行かれて","いかれて"],["も"],["そこ"],["で"],["、"],["剣","けん"],["に"],["命じて","めいじて"],["殺させる","ころさせる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["目","め"],["を"],["注ぐ","そそぐ"],["。"],["それ"],["は"],["災い","わざわい"],["の"],["ため"],["で"],["あって"],["幸い","さいわい"],["の"],["ため"],["で"],["は"],["ない"],["。"],["」"]]},{"verse":5,"text":"万軍の神なる主。主が大地に触れられると、地は揺れ動きそこに住む者は皆、嘆き悲しむ。大地はことごとくナイル川のように盛り上がりエジプトの大河のように沈む。","tok":[["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["なる"],["主","ぬし"],["。"],["主","ぬし"],["が"],["大地","だいち"],["に"],["触れられる","ふれられる"],["と"],["、"],["地","ち"],["は"],["揺れ動き","ゆれうごき"],["そこ"],["に"],["住む","すむ"],["者","もの"],["は"],["皆","みな"],["、"],["嘆き悲しむ","なげきかなしむ"],["。"],["大地","だいち"],["は"],["ことごとく"],["ナイル"],["川","かわ"],["の"],["よう"],["に"],["盛り上がり","もりあがり"],["エジプト"],["の"],["大河","たいが"],["の"],["よう"],["に"],["沈む","しずむ"],["。"]]},{"verse":6,"text":"天に高殿を設け地の上に大空を据え海の水を呼び集め地の面に注がれる方。その御名は主。","tok":[["天","てん"],["に"],["高殿","たかどの"],["を"],["設け","もうけ"],["地","ち"],["の"],["上","うえ"],["に"],["大空","おおぞら"],["を"],["据え","すえ"],["海","うみ"],["の"],["水","みず"],["を"],["呼び集め","よびあつめ"],["地","ち"],["の"],["面","めん"],["に"],["注がれる","そそがれる"],["方","かた"],["。"],["その"],["御名","ぎょめい"],["は"],["主","ぬし"],["。"]]},{"verse":7,"text":"イスラエルの人々よ。わたしにとってお前たちはクシュの人々と変わりがないではないかと主は言われる。わたしはイスラエルをエジプトの地からペリシテ人をカフトルからアラム人をキルから、導き上ったではないか。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["よ"],["。"],["わたし"],["にとって"],["お前","おまえ"],["たち"],["は"],["クシュ"],["の"],["人々","ひとびと"],["と"],["変わり","かわり"],["が"],["ないで"],["は"],["ない"],["か"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["イスラエル"],["を"],["エジプト"],["の"],["地","ち"],["から"],["ペリシテ"],["人","にん"],["を"],["カフトル"],["から"],["アラム人","あらむにん"],["を"],["キル"],["から"],["、"],["導き","みちびき"],["上ったで","のぼったで"],["は"],["ない"],["か"],["。"]]},{"verse":8,"text":"見よ、主なる神は罪に染まった王国に目を向けこれを地の面から絶たれる。ただし、わたしはヤコブの家を全滅させはしないと主は言われる。","tok":[["見よ","みよ"],["、"],["主","おも"],["なる"],["神","かみ"],["は"],["罪","つみ"],["に"],["染まった","そまった"],["王国","おうこく"],["に"],["目","め"],["を"],["向け","むけ"],["これ"],["を"],["地","ち"],["の"],["面","めん"],["から"],["絶たれる","たたれる"],["。"],["ただし"],["、"],["わたし"],["は"],["ヤコブ"],["の"],["家","いえ"],["を"],["全滅","ぜんめつ"],["させ"],["は"],["しない"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"見よ、わたしは命令を下しイスラエルの家を諸国民の間でふるいにかける。ふるいにかけても小石ひとつ地に落ちないように。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["命令","めいれい"],["を"],["下し","くだし"],["イスラエル"],["の"],["家","いえ"],["を"],["諸","しょ"],["国民","こくみん"],["の"],["間","あいだ"],["で"],["ふるい"],["に"],["かける"],["。"],["ふるい"],["に"],["かけて"],["も"],["小石","こいし"],["ひと"],["つ"],["地","ち"],["に"],["落ちない","おちない"],["よう"],["に"],["。"]]},{"verse":10,"text":"わが民の中で罪ある者は皆、剣で死ぬ。彼らは、災いは我々に及ばず近づくこともない、と言っている。","tok":[["わが"],["民","たみ"],["の"],["中","なか"],["で"],["罪","つみ"],["ある"],["者","もの"],["は"],["皆","みな"],["、"],["剣","けん"],["で"],["死ぬ","しぬ"],["。"],["彼","かれ"],["ら"],["は"],["、"],["災い","わざわい"],["は"],["我々","われわれ"],["に"],["及ばず","およばず"],["近づく","ちかづく"],["こと"],["も"],["ない"],["、"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":11,"text":"その日にはわたしはダビデの倒れた仮庵を復興しその破れを修復し、廃虚を復興して昔の日のように建て直す。","tok":[["その"],["日","ひ"],["に"],["は"],["わたし"],["は"],["ダビデ"],["の"],["倒れた","たおれた"],["仮庵","かりあん"],["を"],["復興","ふっこう"],["し"],["その"],["破れ","やぶれ"],["を"],["修復","しゅうふく"],["し"],["、"],["廃虚","はいきょ"],["を"],["復興","ふっこう"],["して"],["昔","むかし"],["の"],["日","ひ"],["の"],["よう"],["に"],["建て直す","たてなおす"],["。"]]},{"verse":12,"text":"こうして、エドムの生き残りの者とわが名をもって呼ばれるすべての国を彼らに所有させよう、と主は言われる。主はこのことを行われる。","tok":[["こう"],["して"],["、"],["エドム"],["の"],["生き残り","いきのこり"],["の"],["者","もの"],["と"],["わが"],["名","な"],["を"],["もって"],["呼ばれる","よばれる"],["すべて"],["の"],["国","くに"],["を"],["彼","かれ"],["ら"],["に"],["所有","しょゆう"],["させよう"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["主","ぬし"],["は"],["この"],["こと"],["を"],["行われる","おこなわれる"],["。"]]},{"verse":13,"text":"見よ、その日が来れば、と主は言われる。耕す者は、刈り入れる者に続きぶどうを踏む者は、種蒔く者に続く。山々はぶどうの汁を滴らせすべての丘は溶けて流れる。","tok":[["見よ","みよ"],["、"],["その"],["日","ひ"],["が"],["来れば","くれば"],["、"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["耕す","たがやす"],["者","もの"],["は"],["、"],["刈り入れる","かりいれる"],["者","もの"],["に"],["続き","つづき"],["ぶどう"],["を"],["踏む","ふむ"],["者","もの"],["は"],["、"],["種蒔","たねまき"],["く者","くしゃ"],["に"],["続く","つづく"],["。"],["山々","やまやま"],["は"],["ぶどう"],["の"],["汁","しる"],["を"],["滴らせ","したたらせ"],["すべて"],["の"],["丘","おか"],["は"],["溶けて","とけて"],["流れる","ながれる"],["。"]]},{"verse":14,"text":"わたしは、わが民イスラエルの繁栄を回復する。彼らは荒された町を建て直して住みぶどう畑を作って、ぶどう酒を飲み園を造って、実りを食べる。","tok":[["わたし"],["は"],["、"],["わが"],["民","みん"],["イスラエル"],["の"],["繁栄","はんえい"],["を"],["回復","かいふく"],["する"],["。"],["彼","かれ"],["ら"],["は"],["荒された","あらされた"],["町","まち"],["を"],["建て直して","たてなおして"],["住み","すみ"],["ぶどう"],["畑","はたけ"],["を"],["作って","つくって"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["飲み","のみ"],["園","えん"],["を"],["造って","つくって"],["、"],["実り","みのり"],["を"],["食べる","たべる"],["。"]]},{"verse":15,"text":"わたしは彼らをその土地に植え付ける。わたしが与えた地から再び彼らが引き抜かれることは決してないとあなたの神なる主は言われる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["その"],["土地","とち"],["に"],["植え付ける","うえつける"],["。"],["わたし"],["が"],["与えた","あたえた"],["地","ち"],["から"],["再び","ふたたび"],["彼","かれ"],["ら"],["が"],["引き抜かれる","ひきぬかれる"],["こと"],["は"],["決して","けっして"],["ない"],["と"],["あなた"],["の"],["神","かみ"],["なる"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
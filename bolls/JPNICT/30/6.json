[{"verse":1,"text":"災いだ、シオンに安住しサマリアの山で安逸をむさぼる者らは。諸国民の頭である国に君臨しイスラエルの家は彼らに従っている。","tok":[["災い","わざわい"],["だ"],["、"],["シオン"],["に"],["安住","あんじゅう"],["し"],["サマリア"],["の"],["山","やま"],["で"],["安逸","あんいつ"],["を"],["むさぼる"],["者","もの"],["ら"],["は"],["。"],["諸","しょ"],["国民","こくみん"],["の"],["頭","あたま"],["で"],["ある"],["国","くに"],["に"],["君臨","くんりん"],["し"],["イスラエル"],["の"],["家","いえ"],["は"],["彼","かれ"],["ら"],["に"],["従って","したがって"],["いる"],["。"]]},{"verse":2,"text":"カルネに赴いて、よく見よ。そこから、ハマト‧ラバに行きペリシテ人のガトに下れ。お前たちはこれらの王国にまさっているか。彼らの領土はお前たちの領土より大きいか。","tok":[["カルネ"],["に"],["赴いて","おもむいて"],["、"],["よく"],["見よ","みよ"],["。"],["そこ"],["から"],["、"],["ハマト"],["‧"],["ラバ"],["に"],["行き","いき"],["ペリシテ"],["人","にん"],["の"],["ガト"],["に"],["下れ","くだれ"],["。"],["お前","おまえ"],["たち"],["は"],["これ"],["ら"],["の"],["王国","おうこく"],["に"],["まさって"],["いる"],["か"],["。"],["彼","かれ"],["ら"],["の"],["領土","りょうど"],["は"],["お前","おまえ"],["たち"],["の"],["領土","りょうど"],["より"],["大きい","おおきい"],["か"],["。"]]},{"verse":3,"text":"お前たちは災いの日を遠ざけようとして不法による支配を引き寄せている。","tok":[["お前","おまえ"],["たち"],["は"],["災い","わざわい"],["の"],["日","ひ"],["を"],["遠ざけよう","とおざけよう"],["として"],["不法","ふほう"],["に"],["よる"],["支配","しはい"],["を"],["引き寄せて","ひきよせて"],["いる"],["。"]]},{"verse":4,"text":"お前たちは象牙の寝台に横たわり長いすに寝そべり羊の群れから小羊を取り牛舎から子牛を取って宴を開き","tok":[["お前","おまえ"],["たち"],["は"],["象牙","ぞうげ"],["の"],["寝台","しんだい"],["に"],["横たわり","よこたわり"],["長いす","ながいす"],["に"],["寝そべり","ねそべり"],["羊","ひつじ"],["の"],["群れ","むれ"],["から"],["小羊","こひつじ"],["を"],["取り","とり"],["牛舎","ぎゅうしゃ"],["から"],["子牛","こうし"],["を"],["取って","とって"],["宴","えん"],["を"],["開き","ひらき"]]},{"verse":5,"text":"竪琴の音に合わせて歌に興じダビデのように楽器を考え出す。","tok":[["竪琴","たてごと"],["の"],["音","おと"],["に"],["合わせて","あわせて"],["歌","うた"],["に"],["興じ","きょうじ"],["ダビデ"],["の"],["よう"],["に"],["楽器","がっき"],["を"],["考え出す","かんがえだす"],["。"]]},{"verse":6,"text":"大杯でぶどう酒を飲み最高の香油を身に注ぐ。しかし、ヨセフの破滅に心を痛めることがない。","tok":[["大杯","たいはい"],["で"],["ぶどう酒","ぶどうしゅ"],["を"],["飲み","のみ"],["最高","さいこう"],["の"],["香油","こうゆ"],["を"],["身","み"],["に"],["注ぐ","そそぐ"],["。"],["しかし"],["、"],["ヨセフ"],["の"],["破滅","はめつ"],["に"],["心","こころ"],["を"],["痛める","いためる"],["こと"],["が"],["ない"],["。"]]},{"verse":7,"text":"それゆえ、今や彼らは捕囚の列の先頭を行き寝そべって酒宴を楽しむことはなくなる。","tok":[["それ"],["ゆえ"],["、"],["今","いま"],["や"],["彼","かれ"],["ら"],["は"],["捕囚","ほしゅう"],["の"],["列","れつ"],["の"],["先頭","せんとう"],["を"],["行き","いき"],["寝そべって","ねそべって"],["酒宴","しゅえん"],["を"],["楽しむ","たのしむ"],["こと"],["は"],["なくなる"],["。"]]},{"verse":8,"text":"主なる神は御自分を指して誓われる。万軍の神なる主は言われる。わたしはヤコブの誇る神殿を忌み嫌いその城郭を憎む。わたしは都とその中のすべてのものを敵に渡す。","tok":[["主","おも"],["なる"],["神","かみ"],["は"],["御自分","ごじぶん"],["を"],["指して","さして"],["誓われる","ちかわれる"],["。"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["なる"],["主","ぬし"],["は"],["言われる","いわれる"],["。"],["わたし"],["は"],["ヤコブ"],["の"],["誇る","ほこる"],["神殿","しんでん"],["を"],["忌み嫌い","いみきらい"],["その"],["城郭","じょうかく"],["を"],["憎む","にくむ"],["。"],["わたし"],["は"],["都","と"],["と"],["その"],["中","なか"],["の"],["すべて"],["の"],["もの"],["を"],["敵","てき"],["に"],["渡す","わたす"],["。"]]},{"verse":9,"text":"もし、一軒の家に男が十人残っているなら、彼らも死ぬ。","tok":[["もし"],["、"],["一軒","いちけん"],["の"],["家","いえ"],["に"],["男","おとこ"],["が"],["十人","じゅうにん"],["残って","のこって"],["いるなら"],["、"],["彼","かれ"],["ら"],["も"],["死ぬ","しぬ"],["。"]]},{"verse":10,"text":"親族と死体を焼く者が、彼らを家の中から運び出す。そのとき、一人が家の奥にいる者に、「まだ、あなたと共にいる者がいるのか」と尋ねると、「いない」と答え、「声を出すな、主の名を唱えるな」と言う。","tok":[["親族","しんぞく"],["と"],["死体","したい"],["を"],["焼く","やく"],["者","もの"],["が"],["、"],["彼","かれ"],["ら"],["を"],["家","いえ"],["の"],["中","なか"],["から"],["運び出す","はこびだす"],["。"],["その"],["とき"],["、"],["一人","ひとり"],["が"],["家","いえ"],["の"],["奥","おく"],["に"],["いる"],["者","もの"],["に"],["、"],["「"],["まだ"],["、"],["あなた"],["と"],["共","とも"],["に"],["いる"],["者","もの"],["が"],["いる"],["の"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["「"],["いない"],["」"],["と"],["答え","こたえ"],["、"],["「"],["声","こえ"],["を"],["出す","だす"],["な"],["、"],["主","ぬし"],["の"],["名","な"],["を"],["唱える","となえる"],["な"],["」"],["と"],["言う","ゆう"],["。"]]},{"verse":11,"text":"見よ、主が命じられる。「大きな家を打って粉々にし小さな家をみじんにせよ。」","tok":[["見よ","みよ"],["、"],["主","ぬし"],["が"],["命じられる","めいじられる"],["。"],["「"],["大きな","おおきな"],["家","いえ"],["を"],["打って","うって"],["粉々","こなごな"],["に"],["し"],["小さな","ちいさな"],["家","いえ"],["を"],["みじん"],["に"],["せよ"],["。"],["」"]]},{"verse":12,"text":"馬が岩の上を駆けるだろうか牛が海を耕すだろうか。お前たちは裁きを毒草に恵みの業の実を苦よもぎに変えた。","tok":[["馬","うま"],["が"],["岩","いわ"],["の"],["上","うえ"],["を"],["駆けるだろう","かけるだろう"],["か"],["牛","うし"],["が"],["海","うみ"],["を"],["耕すだろう","たがやすだろう"],["か"],["。"],["お前","おまえ"],["たち"],["は"],["裁き","さばき"],["を"],["毒草","どくそう"],["に"],["恵み","めぐみ"],["の"],["業","ごう"],["の"],["実","じつ"],["を"],["苦","く"],["よもぎ"],["に"],["変えた","かえた"],["。"]]},{"verse":13,"text":"お前たちはロ‧ダバル（空虚）を喜び「我々は自分の力でカルナイムを手に入れたではないか」と言う。","tok":[["お前","おまえ"],["たち"],["は"],["ロ"],["‧"],["ダバル"],["（"],["空虚","くうきょ"],["）"],["を"],["喜び","よろこび"],["「"],["我々","われわれ"],["は"],["自分","じぶん"],["の"],["力","ちから"],["で"],["カルナイム"],["を"],["手","て"],["に"],["入れたで","いれたで"],["は"],["ない"],["か"],["」"],["と"],["言う","ゆう"],["。"]]},{"verse":14,"text":"しかし、イスラエルの家よわたしはお前たちに対して一つの国を興す。彼らはレボ‧ハマトからアラバの谷に至るまでお前たちを圧迫すると万軍の神なる主は言われる。","tok":[["しかし"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["わたし"],["は"],["お前","おまえ"],["たち"],["に対して","にたいして"],["一","ひと"],["つ"],["の"],["国","くに"],["を"],["興す","おこす"],["。"],["彼","かれ"],["ら"],["は"],["レボ"],["‧"],["ハマト"],["から"],["アラバ"],["の"],["谷","たに"],["に"],["至る","いたる"],["まで"],["お前","おまえ"],["たち"],["を"],["圧迫","あっぱく"],["する"],["と"],["万","まん"],["軍","ぐん"],["の"],["神","かみ"],["なる"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
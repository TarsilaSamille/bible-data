[{"verse":1,"text":"テコアの牧者の一人であったアモスの言葉。それは、ユダの王ウジヤとイスラエルの王ヨアシュの子ヤロブアムの時代、あの地震の二年前に、イスラエルについて示されたものである。","tok":[["テコア"],["の"],["牧者","ぼくしゃ"],["の"],["一人","ひとり"],["で"],["あった"],["アモス"],["の"],["言葉","ことば"],["。"],["それ"],["は"],["、"],["ユダ"],["の"],["王","おう"],["ウジヤ"],["と"],["イスラエル"],["の"],["王","おう"],["ヨアシュ"],["の"],["子","こ"],["ヤロブアム"],["の"],["時代","じだい"],["、"],["あの"],["地震","じしん"],["の"],["二","に"],["年","ねん"],["前","まえ"],["に"],["、"],["イスラエル"],["について"],["示された","しめされた"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"彼は言った。主はシオンからほえたけりエルサレムから声をとどろかされる。羊飼いの牧草地は乾きカルメルの頂は枯れる。","tok":[["彼","かれ"],["は"],["言った","いった"],["。"],["主","ぬし"],["は"],["シオン"],["から"],["ほえた"],["けり"],["エルサレム"],["から"],["声","こえ"],["を"],["とどろかされる"],["。"],["羊飼い","ひつじかい"],["の"],["牧草地","ぼくそうち"],["は"],["乾き","かわき"],["カルメル"],["の"],["頂","いただき"],["は"],["枯れる","かれる"],["。"]]},{"verse":3,"text":"主はこう言われる。ダマスコの三つの罪、四つの罪のゆえにわたしは決して赦さない。彼らが鉄の打穀板を用いギレアドを踏みにじったからだ。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["ダマスコ"],["の"],["三","みっ"],["つ"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["決して","けっして"],["赦さない","ゆるさない"],["。"],["彼","かれ"],["ら"],["が"],["鉄","てつ"],["の"],["打","だ"],["穀","こく"],["板","いた"],["を"],["用い","もちい"],["ギレアド"],["を"],["踏みにじった","ふみにじった"],["から"],["だ"],["。"]]},{"verse":4,"text":"わたしはハザエルの宮殿に火を放つ。火はベン‧ハダドの城郭をなめ尽くす。","tok":[["わたし"],["は"],["ハザエル"],["の"],["宮殿","きゅうでん"],["に"],["火","ひ"],["を"],["放つ","はなつ"],["。"],["火","ひ"],["は"],["ベン"],["‧"],["ハダド"],["の"],["城郭","じょうかく"],["を"],["なめ"],["尽くす","つくす"],["。"]]},{"verse":5,"text":"わたしはダマスコ城門のかんぬきを砕きビクアト‧アベン（悪の谷）から支配者をベト‧エデン（快楽の家）から王笏を持つ者を断つ。アラムの民はキルの地に捕らえられて行くと主は言われる。","tok":[["わたし"],["は"],["ダマスコ"],["城門","じょうもん"],["の"],["かんぬき"],["を"],["砕き","くだき"],["ビクアト"],["‧"],["アベン"],["（"],["悪","あく"],["の"],["谷","たに"],["）"],["から"],["支配者","しはいしゃ"],["を"],["ベト"],["‧"],["エデン"],["（"],["快楽","かいらく"],["の"],["家","いえ"],["）"],["から"],["王笏","おうしゃく"],["を"],["持つ","もつ"],["者","もの"],["を"],["断つ","たつ"],["。"],["アラム"],["の"],["民","たみ"],["は"],["キル"],["の"],["地","ち"],["に"],["捕らえられて","とらえられて"],["行く","いく"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]},{"verse":6,"text":"主はこう言われる。ガザの三つの罪、四つの罪のゆえにわたしは決して赦さない。彼らがとりこにした者をすべてエドムに引き渡したからだ。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["ガザ"],["の"],["三","みっ"],["つ"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["決して","けっして"],["赦さない","ゆるさない"],["。"],["彼","かれ"],["ら"],["が"],["とりこ"],["に"],["した"],["者","もの"],["を"],["すべて"],["エドム"],["に"],["引き渡した","ひきわたした"],["から"],["だ"],["。"]]},{"verse":7,"text":"わたしはガザの城壁に火を放つ。火はその城郭をなめ尽くす。","tok":[["わたし"],["は"],["ガザ"],["の"],["城壁","じょうへき"],["に"],["火","ひ"],["を"],["放つ","はなつ"],["。"],["火","ひ"],["は"],["その"],["城郭","じょうかく"],["を"],["なめ"],["尽くす","つくす"],["。"]]},{"verse":8,"text":"わたしはアシュドドから支配者をアシュケロンから王笏を持つ者を断つ。また、手を返してエクロンを撃つ。ペリシテの残りの者も滅びると主なる神は言われる。","tok":[["わたし"],["は"],["アシュドド"],["から"],["支配者","しはいしゃ"],["を"],["アシュケロン"],["から"],["王笏","おうしゃく"],["を"],["持つ","もつ"],["者","もの"],["を"],["断つ","たつ"],["。"],["また"],["、"],["手","て"],["を"],["返して","かえして"],["エクロン"],["を"],["撃つ","うつ"],["。"],["ペリシテ"],["の"],["残り","のこり"],["の"],["者","もの"],["も"],["滅びる","ほろびる"],["と"],["主","おも"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":9,"text":"主はこう言われる。ティルスの三つの罪、四つの罪のゆえにわたしは決して赦さない。彼らがとりこをすべてエドムに引き渡し兄弟の契りを心に留めなかったからだ。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["ティルス"],["の"],["三","みっ"],["つ"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["決して","けっして"],["赦さない","ゆるさない"],["。"],["彼","かれ"],["ら"],["が"],["とりこ"],["を"],["すべて"],["エドム"],["に"],["引き渡し","ひきわたし"],["兄弟","きょうだい"],["の"],["契り","ちぎり"],["を"],["心","こころ"],["に"],["留めなかった","とめなかった"],["から"],["だ"],["。"]]},{"verse":10,"text":"わたしはティルスの城壁に火を放つ。火はその城郭をなめ尽くす。","tok":[["わたし"],["は"],["ティルス"],["の"],["城壁","じょうへき"],["に"],["火","ひ"],["を"],["放つ","はなつ"],["。"],["火","ひ"],["は"],["その"],["城郭","じょうかく"],["を"],["なめ"],["尽くす","つくす"],["。"]]},{"verse":11,"text":"主はこう言われる。エドムの三つの罪、四つの罪のゆえにわたしは決して赦さない。彼らが剣で兄弟を追い憐れみの情を捨ていつまでも怒りを燃やし長く憤りを抱き続けたからだ。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["エドム"],["の"],["三","みっ"],["つ"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["決して","けっして"],["赦さない","ゆるさない"],["。"],["彼","かれ"],["ら"],["が"],["剣","けん"],["で"],["兄弟","きょうだい"],["を"],["追い","おい"],["憐れみ","あわれみ"],["の"],["情","じょう"],["を"],["捨て","すて"],["いつ"],["まで"],["も"],["怒り","いかり"],["を"],["燃やし","もやし"],["長く","ながく"],["憤り","いきどおり"],["を"],["抱き","いだき"],["続けた","つづけた"],["から"],["だ"],["。"]]},{"verse":12,"text":"わたしはテマンに火を放つ。火はボツラの城郭をなめ尽くす。","tok":[["わたし"],["は"],["テマン"],["に"],["火","ひ"],["を"],["放つ","はなつ"],["。"],["火","ひ"],["は"],["ボツラ"],["の"],["城郭","じょうかく"],["を"],["なめ"],["尽くす","つくす"],["。"]]},{"verse":13,"text":"主はこう言われる。アンモンの人々の三つの罪、四つの罪のゆえにわたしは決して赦さない。彼らはギレアドの妊婦を引き裂き領土を広げようとしたからだ。","tok":[["主","ぬし"],["は"],["こう"],["言われる","いわれる"],["。"],["アンモン"],["の"],["人々","ひとびと"],["の"],["三","みっ"],["つ"],["の"],["罪","つみ"],["、"],["四","よん"],["つ"],["の"],["罪","つみ"],["の"],["ゆえ"],["に"],["わたし"],["は"],["決して","けっして"],["赦さない","ゆるさない"],["。"],["彼","かれ"],["ら"],["は"],["ギレアド"],["の"],["妊婦","にんぷ"],["を"],["引き裂き","ひきさき"],["領土","りょうど"],["を"],["広げよう","ひろげよう"],["と"],["した"],["から"],["だ"],["。"]]},{"verse":14,"text":"わたしはラバの城壁に火をつける。火はその城郭をなめ尽くす。戦いの日に鬨の声があがる嵐の日に烈風が吹く中で。","tok":[["わたし"],["は"],["ラバ"],["の"],["城壁","じょうへき"],["に"],["火","ひ"],["を"],["つける"],["。"],["火","ひ"],["は"],["その"],["城郭","じょうかく"],["を"],["なめ"],["尽くす","つくす"],["。"],["戦い","たたかい"],["の"],["日","ひ"],["に"],["鬨の声","ときのこえ"],["が"],["あがる"],["嵐","あらし"],["の"],["日","ひ"],["に"],["烈風","れっぷう"],["が"],["吹く","ふく"],["中","なか"],["で"],["。"]]},{"verse":15,"text":"彼らの王は高官たちと共に捕囚となって連れ去られると主は言われる。","tok":[["彼","かれ"],["ら"],["の"],["王","おう"],["は"],["高官","こうかん"],["たち"],["と"],["共","とも"],["に"],["捕囚","ほしゅう"],["と"],["なって"],["連れ去られる","つれさられる"],["と"],["主","ぬし"],["は"],["言われる","いわれる"],["。"]]}]
[{"verse":1,"text":"ファリサイ派とサドカイ派の人々が来て、イエスを試そうとして、天からのしるしを見せてほしいと願った。","tok":[["ファリサイ"],["派","は"],["と"],["サドカイ"],["派","は"],["の"],["人々","ひとびと"],["が"],["来て","きて"],["、"],["イエス"],["を"],["試そう","ためそう"],["として"],["、"],["天","てん"],["から"],["の"],["しるし"],["を"],["見せて","みせて"],["ほしい"],["と"],["願った","ねがった"],["。"]]},{"verse":2,"text":"イエスはお答えになった。「あなたたちは、夕方には『夕焼けだから、晴れだ』と言い、","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["あなた"],["たち"],["は"],["、"],["夕方","ゆうがた"],["に"],["は"],["『"],["夕焼け","ゆうやけ"],["だ"],["から"],["、"],["晴れ","はれ"],["だ"],["』"],["と"],["言い","いい"],["、"]]},{"verse":3,"text":"朝には『朝焼けで雲が低いから、今日は嵐だ』と言う。このように空模様を見分けることは知っているのに、時代のしるしは見ることができないのか。","tok":[["朝","あさ"],["に"],["は"],["『"],["朝焼け","あさやけ"],["で"],["雲","くも"],["が"],["低い","ひくい"],["から"],["、"],["今日","きょう"],["は"],["嵐","あらし"],["だ"],["』"],["と"],["言う","ゆう"],["。"],["この"],["よう"],["に"],["空模様","そらもよう"],["を"],["見分ける","みわける"],["こと"],["は"],["知って","しって"],["いる"],["のに"],["、"],["時代","じだい"],["の"],["しるし"],["は"],["見る","みる"],["こと"],["が"],["できない"],["の"],["か"],["。"]]},{"verse":4,"text":"よこしまで神に背いた時代の者たちはしるしを欲しがるが、ヨナのしるしのほかには、しるしは与えられない。」そして、イエスは彼らを後に残して立ち去られた。","tok":[["よこしま"],["で"],["神","かみ"],["に"],["背いた","そむいた"],["時代","じだい"],["の"],["者","もの"],["たち"],["は"],["しるし"],["を"],["欲し","ほっし"],["がる"],["が"],["、"],["ヨナ"],["の"],["しるし"],["の"],["ほか"],["に"],["は"],["、"],["しるし"],["は"],["与えられない","あたえられない"],["。"],["」"],["そして"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["を"],["後","あと"],["に"],["残して","のこして"],["立ち去られた","たちさられた"],["。"]]},{"verse":5,"text":"弟子たちは向こう岸に行ったが、パンを持って来るのを忘れていた。","tok":[["弟子","でし"],["たち"],["は"],["向こう岸","むこうぎし"],["に"],["行った","いった"],["が"],["、"],["パン"],["を"],["持って","もって"],["来る","くる"],["の"],["を"],["忘れて","わすれて"],["いた"],["。"]]},{"verse":6,"text":"イエスは彼らに、「ファリサイ派とサドカイ派の人々のパン種によく注意しなさい」と言われた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["に"],["、"],["「"],["ファリサイ"],["派","は"],["と"],["サドカイ"],["派","は"],["の"],["人々","ひとびと"],["の"],["パン種","ぱんだね"],["に"],["よく"],["注意","ちゅうい"],["し"],["なさい"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":7,"text":"弟子たちは、「これは、パンを持って来なかったからだ」と論じ合っていた。","tok":[["弟子","でし"],["たち"],["は"],["、"],["「"],["これ"],["は"],["、"],["パン"],["を"],["持って","もって"],["来なかった","こなかった"],["から"],["だ"],["」"],["と"],["論じ合って","ろんじあって"],["いた"],["。"]]},{"verse":8,"text":"イエスはそれに気づいて言われた。「信仰の薄い者たちよ、なぜ、パンを持っていないことで論じ合っているのか。","tok":[["イエス"],["は"],["それ"],["に"],["気づいて","きづいて"],["言われた","いわれた"],["。"],["「"],["信仰","しんこう"],["の"],["薄い","うすい"],["者","もの"],["たち"],["よ"],["、"],["なぜ"],["、"],["パン"],["を"],["持って","もって"],["いない"],["こと"],["で"],["論じ合って","ろんじあって"],["いる"],["の"],["か"],["。"]]},{"verse":9,"text":"まだ、分からないのか。覚えていないのか。パン五つを五千人に分けたとき、残りを幾籠に集めたか。","tok":[["まだ"],["、"],["分からない","わからない"],["の"],["か"],["。"],["覚えて","おぼえて"],["いない"],["の"],["か"],["。"],["パン"],["五","いつ"],["つ"],["を"],["五千人","ごせんにん"],["に"],["分けた","わけた"],["とき"],["、"],["残り","のこり"],["を"],["幾","いく"],["籠","かご"],["に"],["集めた","あつめた"],["か"],["。"]]},{"verse":10,"text":"また、パン七つを四千人に分けたときは、残りを幾籠に集めたか。","tok":[["また"],["、"],["パン"],["七","なな"],["つ"],["を"],["四千人","よんせんにん"],["に"],["分けた","わけた"],["とき"],["は"],["、"],["残り","のこり"],["を"],["幾","いく"],["籠","かご"],["に"],["集めた","あつめた"],["か"],["。"]]},{"verse":11,"text":"パンについて言ったのではないことが、どうして分からないのか。ファリサイ派とサドカイ派の人々のパン種に注意しなさい。」","tok":[["パン"],["について"],["言った","いった"],["ので"],["は"],["ない"],["こと"],["が"],["、"],["どう"],["して"],["分からない","わからない"],["の"],["か"],["。"],["ファリサイ"],["派","は"],["と"],["サドカイ"],["派","は"],["の"],["人々","ひとびと"],["の"],["パン種","ぱんだね"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"],["」"]]},{"verse":12,"text":"そのときようやく、弟子たちは、イエスが注意を促されたのは、パン種のことではなく、ファリサイ派とサドカイ派の人々の教えのことだと悟った。","tok":[["その"],["とき"],["ようやく"],["、"],["弟子","でし"],["たち"],["は"],["、"],["イエス"],["が"],["注意","ちゅうい"],["を"],["促された","うながされた"],["の"],["は"],["、"],["パン種","ぱんだね"],["の"],["こと"],["で"],["は"],["なく"],["、"],["ファリサイ"],["派","は"],["と"],["サドカイ"],["派","は"],["の"],["人々","ひとびと"],["の"],["教え","おしえ"],["の"],["こと"],["だ"],["と"],["悟った","さとった"],["。"]]},{"verse":13,"text":"イエスは、フィリポ‧カイサリア地方に行ったとき、弟子たちに、「人々は、人の子のことを何者だと言っているか」とお尋ねになった。","tok":[["イエス"],["は"],["、"],["フィリポ"],["‧"],["カイサリア"],["地方","ちほう"],["に"],["行った","いった"],["とき"],["、"],["弟子","でし"],["たち"],["に"],["、"],["「"],["人々","ひとびと"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["の"],["こと"],["を"],["何者","なにもの"],["だ"],["と"],["言って","いって"],["いる"],["か"],["」"],["と"],["お尋ね","おたずね"],["に"],["なった"],["。"]]},{"verse":14,"text":"弟子たちは言った。「『洗礼者ヨハネだ』と言う人も、『エリヤだ』と言う人もいます。ほかに、『エレミヤだ』とか、『預言者の一人だ』と言う人もいます。」","tok":[["弟子","でし"],["たち"],["は"],["言った","いった"],["。"],["「"],["『"],["洗礼者","せんれいしゃ"],["ヨハネ"],["だ"],["』"],["と"],["言う","いう"],["人","ひと"],["も"],["、"],["『"],["エリヤ"],["だ"],["』"],["と"],["言う","いう"],["人","ひと"],["も"],["います"],["。"],["ほか"],["に"],["、"],["『"],["エレミヤ"],["だ"],["』"],["と"],["か"],["、"],["『"],["預言者","よげんしゃ"],["の"],["一人","ひとり"],["だ"],["』"],["と"],["言う","いう"],["人","ひと"],["も"],["います"],["。"],["」"]]},{"verse":15,"text":"イエスが言われた。「それでは、あなたがたはわたしを何者だと言うのか。」","tok":[["イエス"],["が"],["言われた","いわれた"],["。"],["「"],["それ"],["で"],["は"],["、"],["あなた"],["がた"],["は"],["わたし"],["を"],["何者","なにもの"],["だ"],["と"],["言う","いう"],["の"],["か"],["。"],["」"]]},{"verse":16,"text":"シモン‧ペトロが、「あなたはメシア、生ける神の子です」と答えた。","tok":[["シモン"],["‧"],["ペトロ"],["が"],["、"],["「"],["あなた"],["は"],["メシア"],["、"],["生ける","いける"],["神","かみ"],["の"],["子","こ"],["です"],["」"],["と"],["答えた","こたえた"],["。"]]},{"verse":17,"text":"すると、イエスはお答えになった。「シモン‧バルヨナ、あなたは幸いだ。あなたにこのことを現したのは、人間ではなく、わたしの天の父なのだ。","tok":[["する"],["と"],["、"],["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["シモン"],["‧"],["バルヨナ"],["、"],["あなた"],["は"],["幸い","さいわい"],["だ"],["。"],["あなた"],["に"],["この"],["こと"],["を"],["現した","あらわした"],["の"],["は"],["、"],["人間","にんげん"],["で"],["は"],["なく"],["、"],["わたし"],["の"],["天","てん"],["の"],["父","ちち"],["な"],["の"],["だ"],["。"]]},{"verse":18,"text":"わたしも言っておく。あなたはペトロ。わたしはこの岩の上にわたしの教会を建てる。陰府の力もこれに対抗できない。","tok":[["わたし"],["も"],["言って","いって"],["おく"],["。"],["あなた"],["は"],["ペトロ"],["。"],["わたし"],["は"],["この"],["岩","いわ"],["の"],["上","うえ"],["に"],["わたし"],["の"],["教会","きょうかい"],["を"],["建てる","たてる"],["。"],["陰府","よみ"],["の"],["力","ちから"],["も"],["これ"],["に"],["対抗","たいこう"],["できない"],["。"]]},{"verse":19,"text":"わたしはあなたに天の国の鍵を授ける。あなたが地上でつなぐことは、天上でもつながれる。あなたが地上で解くことは、天上でも解かれる。」","tok":[["わたし"],["は"],["あなた"],["に"],["天","てん"],["の"],["国","くに"],["の"],["鍵","かぎ"],["を"],["授ける","さずける"],["。"],["あなた"],["が"],["地上","ちじょう"],["で"],["つなぐ"],["こと"],["は"],["、"],["天上","てんじょう"],["で"],["も"],["つながれる"],["。"],["あなた"],["が"],["地上","ちじょう"],["で"],["解く","とく"],["こと"],["は"],["、"],["天上","てんじょう"],["で"],["も"],["解かれる","とかれる"],["。"],["」"]]},{"verse":20,"text":"それから、イエスは、御自分がメシアであることをだれにも話さないように、と弟子たちに命じられた。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["、"],["御自分","ごじぶん"],["が"],["メシア"],["で"],["ある"],["こと"],["を"],["だれ"],["に"],["も"],["話さない","はなさない"],["よう"],["に"],["、"],["と"],["弟子","でし"],["たち"],["に"],["命じられた","めいじられた"],["。"]]},{"verse":21,"text":"このときから、イエスは、御自分が必ずエルサレムに行って、長老、祭司長、律法学者たちから多くの苦しみを受けて殺され、三日目に復活することになっている、と弟子たちに打ち明け始められた。","tok":[["この"],["とき"],["から"],["、"],["イエス"],["は"],["、"],["御自分","ごじぶん"],["が"],["必ず","かならず"],["エルサレム"],["に"],["行って","いって"],["、"],["長老","ちょうろう"],["、"],["祭司長","さいしちょう"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["から"],["多く","おおく"],["の"],["苦しみ","くるしみ"],["を"],["受けて","うけて"],["殺され","ころされ"],["、"],["三日目","みっかめ"],["に"],["復活","ふっかつ"],["する"],["こと"],["に"],["なって"],["いる"],["、"],["と"],["弟子","でし"],["たち"],["に"],["打ち明け","うちあけ"],["始められた","はじめられた"],["。"]]},{"verse":22,"text":"すると、ペトロはイエスをわきへお連れして、いさめ始めた。「主よ、とんでもないことです。そんなことがあってはなりません。」","tok":[["する"],["と"],["、"],["ペトロ"],["は"],["イエス"],["を"],["わき"],["へ"],["お連れ","おつれ"],["して"],["、"],["いさめ"],["始めた","はじめた"],["。"],["「"],["主","ぬし"],["よ"],["、"],["とんでも"],["ない"],["こと"],["です"],["。"],["そんな"],["こと"],["が"],["あって"],["は"],["なりません"],["。"],["」"]]},{"verse":23,"text":"イエスは振り向いてペトロに言われた。「サタン、引き下がれ。あなたはわたしの邪魔をする者。神のことを思わず、人間のことを思っている。」","tok":[["イエス"],["は"],["振り向いて","ふりむいて"],["ペトロ"],["に"],["言われた","いわれた"],["。"],["「"],["サタン"],["、"],["引き下がれ","ひきさがれ"],["。"],["あなた"],["は"],["わたし"],["の"],["邪魔","じゃま"],["を"],["する"],["者","もの"],["。"],["神","かみ"],["の"],["こと"],["を"],["思わず","おもわず"],["、"],["人間","にんげん"],["の"],["こと"],["を"],["思って","おもって"],["いる"],["。"],["」"]]},{"verse":24,"text":"それから、弟子たちに言われた。「わたしについて来たい者は、自分を捨て、自分の十字架を背負って、わたしに従いなさい。","tok":[["それ"],["から"],["、"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["わたし"],["について"],["来たい","きたい"],["者","もの"],["は"],["、"],["自分","じぶん"],["を"],["捨て","すて"],["、"],["自分","じぶん"],["の"],["十字架","じゅうじか"],["を"],["背負って","せおって"],["、"],["わたし"],["に"],["従い","したがい"],["なさい"],["。"]]},{"verse":25,"text":"自分の命を救いたいと思う者は、それを失うが、わたしのために命を失う者は、それを得る。","tok":[["自分","じぶん"],["の"],["命","いのち"],["を"],["救いたい","すくいたい"],["と"],["思う","おもう"],["者","もの"],["は"],["、"],["それ"],["を"],["失う","うしなう"],["が"],["、"],["わたし"],["の"],["ため"],["に"],["命","いのち"],["を"],["失う","うしなう"],["者","もの"],["は"],["、"],["それ"],["を"],["得る","うる"],["。"]]},{"verse":26,"text":"人は、たとえ全世界を手に入れても、自分の命を失ったら、何の得があろうか。自分の命を買い戻すのに、どんな代価を支払えようか。","tok":[["人","ひと"],["は"],["、"],["たとえ"],["全","ぜん"],["世界","せかい"],["を"],["手","て"],["に"],["入れて","いれて"],["も"],["、"],["自分","じぶん"],["の"],["命","いのち"],["を"],["失ったら","うしなったら"],["、"],["何","なん"],["の"],["得","とく"],["が"],["あろう"],["か"],["。"],["自分","じぶん"],["の"],["命","いのち"],["を"],["買い戻す","かいもどす"],["のに"],["、"],["どんな"],["代価","だいか"],["を"],["支払えよう","しはらえよう"],["か"],["。"]]},{"verse":27,"text":"人の子は、父の栄光に輝いて天使たちと共に来るが、そのとき、それぞれの行いに応じて報いるのである。","tok":[["人","ひと"],["の"],["子","こ"],["は"],["、"],["父","ちち"],["の"],["栄光","えいこう"],["に"],["輝いて","かがやいて"],["天使","てんし"],["たち"],["と"],["共","とも"],["に"],["来る","くる"],["が"],["、"],["その"],["とき"],["、"],["それぞれ"],["の"],["行い","おこない"],["に"],["応じて","おうじて"],["報いる","むくいる"],["ので"],["ある"],["。"]]},{"verse":28,"text":"はっきり言っておく。ここに一緒にいる人々の中には、人の子がその国と共に来るのを見るまでは、決して死なない者がいる。」","tok":[["はっきり"],["言って","いって"],["おく"],["。"],["ここ"],["に"],["一緒","いっしょ"],["に"],["いる"],["人々","ひとびと"],["の"],["中","なか"],["に"],["は"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["その"],["国","くに"],["と"],["共","とも"],["に"],["来る","くる"],["の"],["を"],["見る","みる"],["まで"],["は"],["、"],["決して","けっして"],["死なない","しなない"],["者","もの"],["が"],["いる"],["。"],["」"]]}]
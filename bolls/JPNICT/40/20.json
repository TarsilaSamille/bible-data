,["な"],["こと"],["は"],["して"],["いない"],["。"],["あなた"],["は"],["わたし"],["と"],["一","いち"],["デナリオン"],["の"],["約束","やくそく"],["を"],["した"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":14,"text":"自分の分を受け取って帰りなさい。わたしはこの最後の者にも、あなたと同じように支払ってやりたいのだ。","tok":[["自分","じぶん"],["の"],["分","ぶん"],["を"],["受け取って","うけとって"],["帰り","かえり"],["なさい"],["。"],["わたし"],["は"],["この"],["最後","さいご"],["の"],["者","もの"],["に"],["も"],["、"],["あなた"],["と"],["同じ","おなじ"],["よう"],["に"],["支払って","しはらって"],["やりたい"],["の"],["だ"],["。"]]},{"verse":15,"text":"自分のものを自分のしたいようにしては、いけないか。それとも、わたしの気前のよさをねたむのか。』","tok":[["自分","じぶん"],["の"],["もの"],["を"],["自分","じぶん"],["の"],["したい"],["よう"],["に"],["して"],["は"],["、"],["いけない"],["か"],["。"],["それ"],["と"],["も"],["、"],["わたし"],["の"],["気前","きまえ"],["の"],["よ"],["さ"],["を"],["ねたむ"],["の"],["か"],["。"],["』"]]},{"verse":16,"text":"このように、後にいる者が先になり、先にいる者が後になる。」","tok":[["この"],["よう"],["に"],["、"],["後","あと"],["に"],["いる"],["者","もの"],["が"],["先","さき"],["に"],["なり"],["、"],["先","さき"],["に"],["いる"],["者","もの"],["が"],["後","あと"],["に"],["なる"],["。"],["」"]]},{"verse":17,"text":"イエスはエルサレムへ上って行く途中、十二人の弟子だけを呼び寄せて言われた。","tok":[["イエス"],["は"],["エルサレム"],["へ"],["上って","のぼって"],["行く","いく"],["途中","とちゅう"],["、"],["十二人","じゅうににん"],["の"],["弟子","でし"],["だけ"],["を"],["呼び寄せて","よびよせて"],["言われた","いわれた"],["。"]]},{"verse":18,"text":"「今、わたしたちはエルサレムへ上って行く。人の子は、祭司長たちや律法学者たちに引き渡される。彼らは死刑を宣告して、","tok":[["「"],["今","いま"],["、"],["わたしたち"],["は"],["エルサレム"],["へ"],["上って","のぼって"],["行く","いく"],["。"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["祭司長","さいしちょう"],["たち"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["に"],["引き渡される","ひきわたされる"],["。"],["彼","かれ"],["ら"],["は"],["死刑","しけい"],["を"],["宣告","せんこく"],["して"],["、"]]},{"verse":19,"text":"異邦人に引き渡す。人の子を侮辱し、鞭打ち、十字架につけるためである。そして、人の子は三日目に復活する。」","tok":[["異邦人","いほうじん"],["に"],["引き渡す","ひきわたす"],["。"],["人","ひと"],["の"],["子","こ"],["を"],["侮辱","ぶじょく"],["し"],["、"],["鞭打ち","むちうち"],["、"],["十字架","じゅうじか"],["に"],["つける"],["ため"],["で"],["ある"],["。"],["そして"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["三日目","みっかめ"],["に"],["復活","ふっかつ"],["する"],["。"],["」"]]},{"verse":20,"text":"そのとき、ゼ
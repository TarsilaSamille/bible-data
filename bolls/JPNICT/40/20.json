[{"verse":1,"text":"「天の国は次のようにたとえられる。ある家の主人が、ぶどう園で働く労働者を雇うために、夜明けに出かけて行った。","tok":[["「"],["天","てん"],["の"],["国","くに"],["は"],["次","つぎ"],["の"],["よう"],["に"],["たとえられる"],["。"],["ある"],["家","いえ"],["の"],["主人","しゅじん"],["が"],["、"],["ぶどう園","ぶどうえん"],["で"],["働く","はたらく"],["労働者","ろうどうしゃ"],["を"],["雇う","やとう"],["ため"],["に"],["、"],["夜明け","よあけ"],["に"],["出かけて","でかけて"],["行った","いった"],["。"]]},{"verse":2,"text":"主人は、一日につき一デナリオンの約束で、労働者をぶどう園に送った。","tok":[["主人","しゅじん"],["は"],["、"],["一","いち"],["日","にち"],["に"],["つき"],["一","いち"],["デナリオン"],["の"],["約束","やくそく"],["で"],["、"],["労働者","ろうどうしゃ"],["を"],["ぶどう園","ぶどうえん"],["に"],["送った","おくった"],["。"]]},{"verse":3,"text":"また、九時ごろ行ってみると、何もしないで広場に立っている人々がいたので、","tok":[["また"],["、"],["九","きゅう"],["時","じ"],["ごろ"],["行って","いって"],["みる"],["と"],["、"],["何","なん"],["も"],["しないで"],["広場","ひろば"],["に"],["立って","たって"],["いる"],["人々","ひとびと"],["が"],["いた"],["ので"],["、"]]},{"verse":4,"text":"『あなたたちもぶどう園に行きなさい。ふさわしい賃金を払ってやろう』と言った。","tok":[["『"],["あなた"],["たち"],["も"],["ぶどう園","ぶどうえん"],["に"],["行き","いき"],["なさい"],["。"],["ふさわしい"],["賃金","ちんぎん"],["を"],["払って","はらって"],["やろう"],["』"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"それで、その人たちは出かけて行った。主人は、十二時ごろと三時ごろにまた出て行き、同じようにした。","tok":[["それ"],["で"],["、"],["その"],["人","ひと"],["たち"],["は"],["出かけて","でかけて"],["行った","いった"],["。"],["主人","しゅじん"],["は"],["、"],["十二","じゅうに"],["時","じ"],["ごろ"],["と"],["三","さん"],["時","じ"],["ごろ"],["に"],["また"],["出て","でて"],["行き","いき"],["、"],["同じ","おなじ"],["よう"],["に"],["した"],["。"]]},{"verse":6,"text":"五時ごろにも行ってみると、ほかの人々が立っていたので、『なぜ、何もしないで一日中ここに立っているのか』と尋ねると、","tok":[["五","ご"],["時","じ"],["ごろ"],["に"],["も"],["行って","いって"],["みる"],["と"],["、"],["ほか"],["の"],["人々","ひとびと"],["が"],["立って","たって"],["いた"],["ので"],["、"],["『"],["なぜ"],["、"],["何","なん"],["も"],["しないで"],["一","いち"],["日中","にちちゅう"],["ここ"],["に"],["立って","たって"],["いる"],["の"],["か"],["』"],["と"],["尋ねる","たずねる"],["と"],["、"]]},{"verse":7,"text":"彼らは、『だれも雇ってくれないのです』と言った。主人は彼らに、『あなたたちもぶどう園に行きなさい』と言った。","tok":[["彼","かれ"],["ら"],["は"],["、"],["『"],["だれ"],["も"],["雇って","やとって"],["くれない"],["の"],["です"],["』"],["と"],["言った","いった"
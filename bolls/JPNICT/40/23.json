,["時代","じだい"],["の"],["者","もの"],["たち"],["に"],["ふりかかって"],["くる"],["。"],["」"]]},{"verse":37,"text":"「エルサレム、エルサレム、預言者たちを殺し、自分に遣わされた人々を石で打ち殺す者よ、めん鳥が雛を羽の下に集めるように、わたしはお前の子らを何度集めようとしたことか。だが、お前たちは応じようとしなかった。","tok":[["「"],["エルサレム"],["、"],["エルサレム"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["殺し","ころし"],["、"],["自分","じぶん"],["に"],["遣わされた","つかわされた"],["人々","ひとびと"],["を"],["石","いし"],["で"],["打ち殺す","うちころす"],["者","もの"],["よ"],["、"],["めん鳥","めんちょう"],["が"],["雛","ひな"],["を"],["羽","はね"],["の"],["下","した"],["に"],["集める","あつめる"],["よう"],["に"],["、"],["わたし"],["は"],["お前","おまえ"],["の"],["子","こ"],["ら"],["を"],["何度","なんど"],["集めよう","あつめよう"],["と"],["した"],["こと"],["か"],["。"],["だ"],["が"],["、"],["お前","おまえ"],["たち"],["は"],["応じよう","おうじよう"],["と"],["しなかった"],["。"]]},{"verse":38,"text":"見よ、お前たちの家は見捨てられて荒れ果てる。","tok":[["見よ","みよ"],["、"],["お前","おまえ"],["たち"],["の"],["家","いえ"],["は"],["見捨てられて","みすてられて"],["荒れ果てる","あれはてる"],["。"]]},{"verse":39,"text":"言っておくが、お前たちは、『主の名によって来られる方に、祝福があるように』と言うときまで、今から後、決してわたしを見ることがない。」","tok":[["言って","いって"],["おく"],["が"],["、"],["お前","おまえ"],["たち"],["は"],["、"],["『"],["主","ぬし"],["の"],["名","な"],["によって"],["来られる","こられる"],["方","かた"],["に"],["、"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["』"],["と"],["言う","いう"],["とき"],["まで"],["、"],["今","いま"],["から"],["後","あと"],["、"],["決して","けっして"],["わたし"],["を"],["見る","みる"],["こと"],["が"],["ない"],["。"],["」"]]}]
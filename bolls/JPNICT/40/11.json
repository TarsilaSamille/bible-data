[{"verse":1,"text":"イエスは十二人の弟子に指図を与え終わると、そこを去り、方々の町で教え、宣教された。","tok":[["イエス"],["は"],["十二人","じゅうににん"],["の"],["弟子","でし"],["に"],["指図","さしず"],["を"],["与え","あたえ"],["終わる","おわる"],["と"],["、"],["そこ"],["を"],["去り","さり"],["、"],["方々","かたがた"],["の"],["町","まち"],["で"],["教え","おしえ"],["、"],["宣教","せんきょう"],["された"],["。"]]},{"verse":2,"text":"ヨハネは牢の中で、キリストのなさったことを聞いた。そこで、自分の弟子たちを送って、","tok":[["ヨハネ"],["は"],["牢","ろう"],["の"],["中","なか"],["で"],["、"],["キリスト"],["の"],["なさった"],["こと"],["を"],["聞いた","きいた"],["。"],["そこ"],["で"],["、"],["自分","じぶん"],["の"],["弟子","でし"],["たち"],["を"],["送って","おくって"],["、"]]},{"verse":3,"text":"尋ねさせた。「来るべき方は、あなたでしょうか。それとも、ほかの方を待たなければなりませんか。」","tok":[["尋ねさせた","たずねさせた"],["。"],["「"],["来るべき","きたるべき"],["方","かた"],["は"],["、"],["あなた"],["でしょう"],["か"],["。"],["それ"],["と"],["も"],["、"],["ほか"],["の"],["方","ほう"],["を"],["待たなければ","またなければ"],["なりません"],["か"],["。"],["」"]]},{"verse":4,"text":"イエスはお答えになった。「行って、見聞きしていることをヨハネに伝えなさい。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["行って","いって"],["、"],["見聞き","みきき"],["して"],["いる"],["こと"],["を"],["ヨハネ"],["に"],["伝え","つたえ"],["なさい"],["。"]]},{"verse":5,"text":"目の見えない人は見え、足の不自由な人は歩き、重い皮膚病を患っている人は清くなり、耳の聞こえない人は聞こえ、死者は生き返り、貧しい人は福音を告げ知らされている。","tok":[["目","め"],["の"],["見えない","みえない"],["人","ひと"],["は"],["見え","みえ"],["、"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["は"],["歩き","あるき"],["、"],["重い","おもい"],["皮膚病","ひふびょう"],["を"],["患って","わずらって"],["いる"],["人","ひと"],["は"],["清く","きよく"],["なり"],["、"],["耳","みみ"],["の"],["聞こえない","きこえない"],["人","ひと"],["は"],["聞こえ","きこえ"],["、"],["死者","ししゃ"],["は"],["生き返り","いきかえり"],["、"],["貧しい","まずしい"],["人","ひと"],["は"],["福音","ふくいん"],["を"],["告げ知らされて","つげしらされて"],["いる"],["。"]]},{"verse":6,"text":"わたしにつまずかない人は幸いである。」","tok":[["わたし"],["に"],["つまずかない"],["人","ひと"],["は"],["幸い","さいわい"],["で"],["ある"],["。"],["」"]]},{"verse":7,"text":"ヨハネの弟子たちが帰ると、イエスは群衆にヨハネについて話し始められた。「あなたがたは、何を見に荒れ野へ行ったのか。風にそよぐ葦か。","tok":[["ヨハネ"],["の"],["弟子","でし"],["たち"],["が"],["帰る","かえる"],["と"],["、"],["イエス"],["は"],["群衆","ぐんしゅう"],["に"],["ヨハネ"],["について"],["話し","はなし"],["始められた","はじめられた"],["。"],["「"],["あなた"],["がた"],["は"],["、"],["何","なん"],["を"],["見","み"],["に"],["荒れ野","あれの"],["へ"],["行った","いった"],["の"],["か"],["。"],["風","かぜ"],["に"],["そよぐ"],["葦","あし"],["か"],["。"]]},{"verse":8,"text":"では、何を見に行ったのか。しなやかな服を着た人か。しなやかな服を着た人なら王宮にいる。","tok":[["で"],["は"],["、"],["何","なん"],["を"],["見","み"],["に"],["行った","いった"],["の"],["か"],["。"],["しなやか"],["な"],["服","ふく"],["を"],["着た","きた"],["人","ひと"],["か"],["。"],["しなやか"],["な"],["服","ふく"],["を"],["着た","きた"],["人","ひと"],["なら"],["王宮","おうきゅう"],["に"],["いる"],["。"]]},{"verse":9,"text":"では、何を見に行ったのか。預言者か。そうだ。言っておく。預言者以上の者である。","tok":[["で"],["は"],["、"],["何","なん"],["を"],["見","み"],["に"],["行った","いった"],["の"],["か"],["。"],["預言者","よげんしゃ"],["か"],["。"],["そう"],["だ"],["。"],["言って","いって"],["おく"],["。"],["預言者","よげんしゃ"],["以上","いじょう"],["の"],["者","もの"],["で"],["ある"],["。"]]},{"verse":10,"text":"『見よ、わたしはあなたより先に使者を遣わし、あなたの前に道を準備させよう』と書いてあるのは、この人のことだ。","tok":[["『"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["より"],["先","さき"],["に"],["使者","ししゃ"],["を"],["遣わし","つかわし"],["、"],["あなた"],["の"],["前","まえ"],["に"],["道","みち"],["を"],["準備","じゅんび"],["させよう"],["』"],["と"],["書いて","かいて"],["ある"],["の"],["は"],["、"],["この"],["人","ひと"],["の"],["こと"],["だ"],["。"]]},{"verse":11,"text":"はっきり言っておく。およそ女から生まれた者のうち、洗礼者ヨハネより偉大な者は現れなかった。しかし、天の国で最も小さな者でも、彼よりは偉大である。","tok":[["はっきり"],["言って","いって"],["おく"],["。"],["およそ"],["女","おんな"],["から"],["生まれた","うまれた"],["者","もの"],["の"],["うち"],["、"],["洗礼者","せんれいしゃ"],["ヨハネ"],["より"],["偉大","いだい"],["な"],["者","もの"],["は"],["現れなかった","あらわれなかった"],["。"],["しかし"],["、"],["天","てん"],["の"],["国","くに"],["で"],["最も","もっとも"],["小さな","ちいさな"],["者","もの"],["で"],["も"],["、"],["彼","かれ"],["より"],["は"],["偉大","いだい"],["で"],["ある"],["。"]]},{"verse":12,"text":"彼が活動し始めたときから今に至るまで、天の国は力ずくで襲われており、激しく襲う者がそれを奪い取ろうとしている。","tok":[["彼","かれ"],["が"],["活動","かつどう"],["し"],["始めた","はじめた"],["とき"],["から"],["今","いま"],["に"],["至る","いたる"],["まで"],["、"],["天","てん"],["の"],["国","くに"],["は"],["力","ちから"],["ずく"],["で"],["襲われて","おそわれて"],["おり"],["、"],["激しく","はげしく"],["襲う","おそう"],["者","もの"],["が"],["それ"],["を"],["奪い取ろう","うばいとろう"],["として"],["いる"],["。"]]},{"verse":13,"text":"すべての預言者と律法が預言したのは、ヨハネの時までである。","tok":[["すべて"],["の"],["預言者","よげんしゃ"],["と"],["律法","りっぽう"],["が"],["預言","よげん"],["した"],["の"],["は"],["、"],["ヨハネ"],["の"],["時","とき"],["まで"],["で"],["ある"],["。"]]},{"verse":14,"text":"あなたがたが認めようとすれば分かることだが、実は、彼は現れるはずのエリヤである。","tok":[["あなた"],["がた"],["が"],["認めよう","みとめよう"],["と"],["すれば"],["分かる","わかる"],["こと"],["だ"],["が"],["、"],["実","じつ"],["は"],["、"],["彼","かれ"],["は"],["現れる","あらわれる"],["はず"],["の"],["エリヤ"],["で"],["ある"],["。"]]},{"verse":15,"text":"耳のある者は聞きなさい。","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["聞き","きき"],["なさい"],["。"]]},{"verse":16,"text":"今の時代を何にたとえたらよいか。広場に座って、ほかの者にこう呼びかけている子供たちに似ている。","tok":[["今","いま"],["の"],["時代","じだい"],["を"],["何","なん"],["に"],["たとえたら"],["よい"],["か"],["。"],["広場","ひろば"],["に"],["座って","すわって"],["、"],["ほか"],["の"],["者","もの"],["に"],["こう"],["呼びかけて","よびかけて"],["いる"],["子供","こども"],["たち"],["に"],["似て","にて"],["いる"],["。"]]},{"verse":17,"text":"『笛を吹いたのに、踊ってくれなかった。葬式の歌をうたったのに、悲しんでくれなかった。』","tok":[["『"],["笛","ふえ"],["を"],["吹いた","ふいた"],["のに"],["、"],["踊って","おどって"],["くれなかった"],["。"],["葬式","そうしき"],["の"],["歌","うた"],["を"],["うたった"],["のに"],["、"],["悲しんで","かなしんで"],["くれなかった"],["。"],["』"]]},{"verse":18,"text":"ヨハネが来て、食べも飲みもしないでいると、『あれは悪霊に取りつかれている』と言い、","tok":[["ヨハネ"],["が"],["来て","きて"],["、"],["食べ","たべ"],["も"],["飲み","のみ"],["も"],["しないで"],["いる"],["と"],["、"],["『"],["あれ"],["は"],["悪霊","あくりょう"],["に"],["取りつかれて","とりつかれて"],["いる"],["』"],["と"],["言い","いい"],["、"]]},{"verse":19,"text":"人の子が来て、飲み食いすると、『見ろ、大食漢で大酒飲みだ。徴税人や罪人の仲間だ』と言う。しかし、知恵の正しさは、その働きによって証明される。」","tok":[["人","ひと"],["の"],["子","こ"],["が"],["来て","きて"],["、"],["飲み食い","のみくい"],["する"],["と"],["、"],["『"],["見ろ","みろ"],["、"],["大食漢","たいしょくかん"],["で"],["大","だい"],["酒飲み","さけのみ"],["だ"],["。"],["徴税人","ちょうぜいにん"],["や"],["罪人","ざいにん"],["の"],["仲間","なかま"],["だ"],["』"],["と"],["言う","ゆう"],["。"],["しかし"],["、"],["知恵","ちえ"],["の"],["正し","ただし"],["さ"],["は"],["、"],["その"],["働き","はたらき"],["によって"],["証明","しょうめい"],["される"],["。"],["」"]]},{"verse":20,"text":"それからイエスは、数多くの奇跡の行われた町々が悔い改めなかったので、叱り始められた。","tok":[["それ"],["から"],["イエス"],["は"],["、"],["数多く","かずおおく"],["の"],["奇跡","きせき"],["の"],["行われた","おこなわれた"],["町々","まちまち"],["が"],["悔い改めなかった","くいあらためなかった"],["ので"],["、"],["叱り","しかり"],["始められた","はじめられた"],["。"]]},{"verse":21,"text":"「コラジン、お前は不幸だ。ベトサイダ、お前は不幸だ。お前たちのところで行われた奇跡が、ティルスやシドンで行われていれば、これらの町はとうの昔に粗布をまとい、灰をかぶって悔い改めたにちがいない。","tok":[["「"],["コラジン"],["、"],["お前","おまえ"],["は"],["不幸","ふこう"],["だ"],["。"],["ベトサイダ"],["、"],["お前","おまえ"],["は"],["不幸","ふこう"],["だ"],["。"],["お前","おまえ"],["たち"],["の"],["ところ"],["で"],["行われた","おこなわれた"],["奇跡","きせき"],["が"],["、"],["ティルス"],["や"],["シドン"],["で"],["行われて","おこなわれて"],["いれば"],["、"],["これ"],["ら"],["の"],["町","まち"],["は"],["とう"],["の"],["昔","むかし"],["に"],["粗布","あらぬの"],["を"],["まとい"],["、"],["灰","はい"],["を"],["かぶって"],["悔い改めた","くいあらためた"],["に"],["ちがい"],["ない"],["。"]]},{"verse":22,"text":"しかし、言っておく。裁きの日にはティルスやシドンの方が、お前たちよりまだ軽い罰で済む。","tok":[["しかし"],["、"],["言って","いって"],["おく"],["。"],["裁き","さばき"],["の"],["日","ひ"],["に"],["は"],["ティルス"],["や"],["シドン"],["の"],["方","ほう"],["が"],["、"],["お前","おまえ"],["たち"],["より"],["まだ"],["軽い","かるい"],["罰","ばつ"],["で"],["済む","すむ"],["。"]]},{"verse":23,"text":"また、カファルナウム、お前は、天にまで上げられるとでも思っているのか。陰府にまで落とされるのだ。お前のところでなされた奇跡が、ソドムで行われていれば、あの町は今日まで無事だったにちがいない。","tok":[["また"],["、"],["カファルナウム"],["、"],["お前","おまえ"],["は"],["、"],["天","てん"],["に"],["まで"],["上げられる","あげられる"],["と"],["で"],["も"],["思って","おもって"],["いる"],["の"],["か"],["。"],["陰府","よみ"],["に"],["まで"],["落とされる","おとされる"],["の"],["だ"],["。"],["お前","おまえ"],["の"],["ところ"],["で"],["なされた"],["奇跡","きせき"],["が"],["、"],["ソドム"],["で"],["行われて","おこなわれて"],["いれば"],["、"],["あの"],["町","まち"],["は"],["今日","きょう"],["まで"],["無事","ぶじ"],["だった"],["に"],["ちがい"],["ない"],["。"]]},{"verse":24,"text":"しかし、言っておく。裁きの日にはソドムの地の方が、お前よりまだ軽い罰で済むのである。」","tok":[["しかし"],["、"],["言って","いって"],["おく"],["。"],["裁き","さばき"],["の"],["日","ひ"],["に"],["は"],["ソドム"],["の"],["地","ち"],["の"],["方","ほう"],["が"],["、"],["お前","おまえ"],["より"],["まだ"],["軽い","かるい"],["罰","ばつ"],["で"],["済む","すむ"],["ので"],["ある"],["。"],["」"]]},{"verse":25,"text":"そのとき、イエスはこう言われた。「天地の主である父よ、あなたをほめたたえます。これらのことを知恵ある者や賢い者には隠して、幼子のような者にお示しになりました。","tok":[["その"],["とき"],["、"],["イエス"],["は"],["こう"],["言われた","いわれた"],["。"],["「"],["天地","てんち"],["の"],["主","ぬし"],["で"],["ある"],["父","ちち"],["よ"],["、"],["あなた"],["を"],["ほめたたえます"],["。"],["これ"],["ら"],["の"],["こと"],["を"],["知恵","ちえ"],["ある"],["者","もの"],["や"],["賢い","かしこい"],["者","もの"],["に"],["は"],["隠して","かくして"],["、"],["幼子","おさなご"],["の"],["よう"],["な"],["者","もの"],["に"],["お示し","おしめし"],["に"],["なりました"],["。"]]},{"verse":26,"text":"そうです、父よ、これは御心に適うことでした。","tok":[["そう"],["です"],["、"],["父","ちち"],["よ"],["、"],["これ"],["は"],["御心","おこころ"],["に"],["適う","かなう"],["こと"],["でした"],["。"]]},{"verse":27,"text":"すべてのことは、父からわたしに任せられています。父のほかに子を知る者はなく、子と、子が示そうと思う者のほかには、父を知る者はいません。","tok":[["すべて"],["の"],["こと"],["は"],["、"],["父","ちち"],["から"],["わたし"],["に"],["任せられて","まかせられて"],["います"],["。"],["父","ちち"],["の"],["ほか"],["に"],["子","こ"],["を"],["知る","しる"],["者","もの"],["は"],["なく"],["、"],["子","こ"],["と"],["、"],["子","こ"],["が"],["示そう","しめそう"],["と"],["思う","おもう"],["者","もの"],["の"],["ほか"],["に"],["は"],["、"],["父","ちち"],["を"],["知る","しる"],["者","もの"],["は"],["いません"],["。"]]},{"verse":28,"text":"疲れた者、重荷を負う者は、だれでもわたしのもとに来なさい。休ませてあげよう。","tok":[["疲れた","つかれた"],["者","もの"],["、"],["重荷","おもに"],["を"],["負う","おう"],["者","もの"],["は"],["、"],["だれ"],["で"],["も"],["わたし"],["の"],["もと"],["に"],["来","き"],["なさい"],["。"],["休ませて","やすませて"],["あげよう"],["。"]]},{"verse":29,"text":"わたしは柔和で謙遜な者だから、わたしの軛を負い、わたしに学びなさい。そうすれば、あなたがたは安らぎを得られる。","tok":[["わたし"],["は"],["柔和","にゅうわ"],["で"],["謙遜","けんそん"],["な"],["者","もの"],["だ"],["から"],["、"],["わたし"],["の"],["軛","くびき"],["を"],["負い","おい"],["、"],["わたし"],["に"],["学び","まなび"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["安らぎ","やすらぎ"],["を"],["得られる","えられる"],["。"]]},{"verse":30,"text":"わたしの軛は負いやすく、わたしの荷は軽いからである。」","tok":[["わたし"],["の"],["軛","くびき"],["は"],["負い","おい"],["やすく"],["、"],["わたし"],["の"],["荷","に"],["は"],["軽い","かるい"],["から"],["で"],["ある"],["。"],["」"]]}]
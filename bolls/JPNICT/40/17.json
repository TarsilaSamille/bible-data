[{"verse":1,"text":"六日の後、イエスは、ペトロ、それにヤコブとその兄弟ヨハネだけを連れて、高い山に登られた。","tok":[["六日","むいか"],["の"],["後","あと"],["、"],["イエス"],["は"],["、"],["ペトロ"],["、"],["それ"],["に"],["ヤコブ"],["と"],["その"],["兄弟","きょうだい"],["ヨハネ"],["だけ"],["を"],["連れて","つれて"],["、"],["高い","たかい"],["山","やま"],["に"],["登られた","のぼられた"],["。"]]},{"verse":2,"text":"イエスの姿が彼らの目の前で変わり、顔は太陽のように輝き、服は光のように白くなった。","tok":[["イエス"],["の"],["姿","すがた"],["が"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["変わり","かわり"],["、"],["顔","かお"],["は"],["太陽","たいよう"],["の"],["よう"],["に"],["輝き","かがやき"],["、"],["服","ふく"],["は"],["光","ひかり"],["の"],["よう"],["に"],["白く","しろく"],["なった"],["。"]]},{"verse":3,"text":"見ると、モーセとエリヤが現れ、イエスと語り合っていた。","tok":[["見る","みる"],["と"],["、"],["モーセ"],["と"],["エリヤ"],["が"],["現れ","あらわれ"],["、"],["イエス"],["と"],["語り合って","かたりあって"],["いた"],["。"]]},{"verse":4,"text":"ペトロが口をはさんでイエスに言った。「主よ、わたしたちがここにいるのは、すばらしいことです。お望みでしたら、わたしがここに仮小屋を三つ建てましょう。一つはあなたのため、一つはモーセのため、もう一つはエリヤのためです。」","tok":[["ペトロ"],["が"],["口","くち"],["を"],["はさんで"],["イエス"],["に"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["わたしたち"],["が"],["ここ"],["に"],["いる"],["の"],["は"],["、"],["すばらしい"],["こと"],["です"],["。"],["お望み","おのぞみ"],["でしたら"],["、"],["わたし"],["が"],["ここ"],["に"],["仮","かり"],["小屋","こや"],["を"],["三","みっ"],["つ"],["建てましょう","たてましょう"],["。"],["一","ひと"],["つ"],["は"],["あなた"],["の"],["ため"],["、"],["一","ひと"],["つ"],["は"],["モーセ"],["の"],["ため"],["、"],["もう"],["一","ひと"],["つ"],["は"],["エリヤ"],["の"],["ため"],["です"],["。"],["」"]]},{"verse":5,"text":"ペトロがこう話しているうちに、光り輝く雲が彼らを覆った。すると、「これはわたしの愛する子、わたしの心に適う者。これに聞け」という声が雲の中から聞こえた。","tok":[["ペトロ"],["が"],["こう"],["話して","はなして"],["いる"],["うち"],["に"],["、"],["光り輝く","ひかりかがやく"],["雲","くも"],["が"],["彼","かれ"],["ら"],["を"],["覆った","おおった"],["。"],["する"],["と"],["、"],["「"],["これ"],["は"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["、"],["わたし"],["の"],["心","こころ"],["に"],["適う","かなう"],["者","もの"],["。"],["これ"],["に"],["聞け","きけ"],["」"],["と"],["いう"],["声","こえ"],["が"],["雲","くも"],["の"],["中","なか"],["から"],["聞こえた","きこえた"],["。"]]},{"verse":6,"text":"弟子たちはこれを聞いてひれ伏し、非常に恐れた。","tok":[["弟子","でし"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["ひれ伏し","ひれふし"],["、"],["非常","ひじょう"],["に"],["恐れた","おそれた"],["。"]]},{"verse":7,"text":"イエスは近づき、彼らに手を触れて言われた。「起きなさい。恐れることはない。」","tok":[["イエス"],["は"],["近づき","ちかづき"],["、"],["彼","かれ"],["ら"],["に"],["手","て"],["を"],["触れて","ふれて"],["言われた","いわれた"],["。"],["「"],["起き","おき"],["なさい"],["。"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":8,"text":"彼らが顔を上げて見ると、イエスのほかにはだれもいなかった。","tok":[["彼","かれ"],["ら"],["が"],["顔","かお"],["を"],["上げて","あげて"],["見る","みる"],["と"],["、"],["イエス"],["の"],["ほか"],["に"],["は"],["だれ"],["も"],["いなかった"],["。"]]},{"verse":9,"text":"一同が山を下りるとき、イエスは、「人の子が死者の中から復活するまで、今見たことをだれにも話してはならない」と弟子たちに命じられた。","tok":[["一同","いちどう"],["が"],["山","やま"],["を"],["下りる","おりる"],["とき"],["、"],["イエス"],["は"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["が"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["する"],["まで"],["、"],["今","いま"],["見た","みた"],["こと"],["を"],["だれ"],["に"],["も"],["話して","はなして"],["は"],["ならない"],["」"],["と"],["弟子","でし"],["たち"],["に"],["命じられた","めいじられた"],["。"]]},{"verse":10,"text":"彼らはイエスに、「なぜ、律法学者は、まずエリヤが来るはずだと言っているのでしょうか」と尋ねた。","tok":[["彼","かれ"],["ら"],["は"],["イエス"],["に"],["、"],["「"],["なぜ"],["、"],["律法学者","りっぽうがくしゃ"],["は"],["、"],["まず"],["エリヤ"],["が"],["来る","くる"],["はず"],["だ"],["と"],["言って","いって"],["いる"],["の"],["でしょう"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":11,"text":"イエスはお答えになった。「確かにエリヤが来て、すべてを元どおりにする。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["確か","たしか"],["に"],["エリヤ"],["が"],["来て","きて"],["、"],["すべて"],["を"],["元どおり","もとどおり"],["に"],["する"],["。"]]},{"verse":12,"text":"言っておくが、エリヤは既に来たのだ。人々は彼を認めず、好きなようにあしらったのである。人の子も、そのように人々から苦しめられることになる。」","tok":[["言って","いって"],["おく"],["が"],["、"],["エリヤ"],["は"],["既に","すでに"],["来た","きた"],["の"],["だ"],["。"],["人々","ひとびと"],["は"],["彼","かれ"],["を"],["認めず","みとめず"],["、"],["好き","すき"],["な"],["よう"],["に"],["あしらった"],["ので"],["ある"],["。"],["人","ひと"],["の"],["子","こ"],["も"],["、"],["その"],["よう"],["に"],["人々","ひとびと"],["から"],["苦しめられる","くるしめられる"],["こと"],["に"],["なる"],["。"],["」"]]},{"verse":13,"text":"そのとき、弟子たちは、イエスが洗礼者ヨハネのことを言われたのだと悟った。","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["は"],["、"],["イエス"],["が"],["洗礼者","せんれいしゃ"],["ヨハネ"],["の"],["こと"],["を"],["言われた","いわれた"],["の"],["だ"],["と"],["悟った","さとった"],["。"]]},{"verse":14,"text":"一同が群衆のところへ行くと、ある人がイエスに近寄り、ひざまずいて、","tok":[["一同","いちどう"],["が"],["群衆","ぐんしゅう"],["の"],["ところ"],["へ"],["行く","いく"],["と"],["、"],["ある"],["人","ひと"],["が"],["イエス"],["に"],["近寄り","ちかより"],["、"],["ひざまずいて"],["、"]]},{"verse":15,"text":"言った。「主よ、息子を憐れんでください。てんかんでひどく苦しんでいます。度々火の中や水の中に倒れるのです。","tok":[["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["息子","むすこ"],["を"],["憐れんで","あわれんで"],["ください"],["。"],["てんかん"],["で"],["ひどく"],["苦しんで","くるしんで"],["います"],["。"],["度々","たびたび"],["火","ひ"],["の"],["中","なか"],["や"],["水","みず"],["の"],["中","なか"],["に"],["倒れる","たおれる"],["の"],["です"],["。"]]},{"verse":16,"text":"お弟子たちのところに連れて来ましたが、治すことができませんでした。」","tok":[["お弟子","おでし"],["たち"],["の"],["ところ"],["に"],["連れて","つれて"],["来ました","きました"],["が"],["、"],["治す","なおす"],["こと"],["が"],["できませんでした"],["。"],["」"]]},{"verse":17,"text":"イエスはお答えになった。「なんと信仰のない、よこしまな時代なのか。いつまでわたしはあなたがたと共にいられようか。いつまで、あなたがたに我慢しなければならないのか。その子をここに、わたしのところに連れて来なさい。」","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["なん"],["と"],["信仰","しんこう"],["の"],["ない"],["、"],["よこしま"],["な"],["時代","じだい"],["な"],["の"],["か"],["。"],["いつ"],["まで"],["わたし"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["いられよう"],["か"],["。"],["いつ"],["まで"],["、"],["あなた"],["がた"],["に"],["我慢","がまん"],["しなければ"],["ならない"],["の"],["か"],["。"],["その"],["子","こ"],["を"],["ここ"],["に"],["、"],["わたし"],["の"],["ところ"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"],["」"]]},{"verse":18,"text":"そして、イエスがお叱りになると、悪霊は出て行き、そのとき子供はいやされた。","tok":[["そして"],["、"],["イエス"],["が"],["お叱り","おしかり"],["に"],["なる"],["と"],["、"],["悪霊","あくりょう"],["は"],["出て","でて"],["行き","いき"],["、"],["その"],["とき"],["子供","こども"],["は"],["いやされた"],["。"]]},{"verse":19,"text":"弟子たちはひそかにイエスのところに来て、「なぜ、わたしたちは悪霊を追い出せなかったのでしょうか」と言った。","tok":[["弟子","でし"],["たち"],["は"],["ひそか"],["に"],["イエス"],["の"],["ところ"],["に"],["来て","きて"],["、"],["「"],["なぜ"],["、"],["わたしたち"],["は"],["悪霊","あくりょう"],["を"],["追い出せなかった","おいだせなかった"],["の"],["でしょう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"イエスは言われた。「信仰が薄いからだ。はっきり言っておく。もし、からし種一粒ほどの信仰があれば、この山に向かって、『ここから、あそこに移れ』と命じても、そのとおりになる。あなたがたにできないことは何もない。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["信仰","しんこう"],["が"],["薄い","うすい"],["から"],["だ"],["。"],["はっきり"],["言って","いって"],["おく"],["。"],["もし"],["、"],["からし"],["種一","たねいち"],["粒","つぶ"],["ほど"],["の"],["信仰","しんこう"],["が"],["あれば"],["、"],["この"],["山","やま"],["に"],["向かって","むかって"],["、"],["『"],["ここ"],["から"],["、"],["あそこ"],["に"],["移れ","うつれ"],["』"],["と"],["命じて","めいじて"],["も"],["、"],["その"],["とおり"],["に"],["なる"],["。"],["あなた"],["がた"],["に"],["できない"],["こと"],["は"],["何","なん"],["も"],["ない"],["。"],["」"]]},{"verse":21,"text":"†〔しかし、この種のものは、祈りと断食によらなければ出て行かない。〕","tok":[["†"],["〔"],["しかし"],["、"],["この"],["種","しゅ"],["の"],["もの"],["は"],["、"],["祈り","いのり"],["と"],["断食","だんじき"],["に"],["よらなければ"],["出て","でて"],["行かない","いかない"],["。"],["〕"]]},{"verse":22,"text":"一行がガリラヤに集まったとき、イエスは言われた。「人の子は人々の手に引き渡されようとしている。","tok":[["一行","いっこう"],["が"],["ガリラヤ"],["に"],["集まった","あつまった"],["とき"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["人","ひと"],["の"],["子","こ"],["は"],["人々","ひとびと"],["の"],["手","て"],["に"],["引き渡されよう","ひきわたされよう"],["として"],["いる"],["。"]]},{"verse":23,"text":"そして殺されるが、三日目に復活する。」弟子たちは非常に悲しんだ。","tok":[["そして"],["殺される","ころされる"],["が"],["、"],["三日目","みっかめ"],["に"],["復活","ふっかつ"],["する"],["。"],["」"],["弟子","でし"],["たち"],["は"],["非常","ひじょう"],["に"],["悲しんだ","かなしんだ"],["。"]]},{"verse":24,"text":"一行がカファルナウムに来たとき、神殿税を集める者たちがペトロのところに来て、「あなたたちの先生は神殿税を納めないのか」と言った。","tok":[["一行","いっこう"],["が"],["カファルナウム"],["に"],["来た","きた"],["とき"],["、"],["神殿","しんでん"],["税","ぜい"],["を"],["集める","あつめる"],["者","もの"],["たち"],["が"],["ペトロ"],["の"],["ところ"],["に"],["来て","きて"],["、"],["「"],["あなた"],["たち"],["の"],["先生","せんせい"],["は"],["神殿","しんでん"],["税","ぜい"],["を"],["納めない","おさめない"],["の"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":25,"text":"ペトロは、「納めます」と言った。そして家に入ると、イエスの方から言いだされた。「シモン、あなたはどう思うか。地上の王は、税や貢ぎ物をだれから取り立てるのか。自分の子供たちからか、それともほかの人々からか。」","tok":[["ペトロ"],["は"],["、"],["「"],["納めます","おさめます"],["」"],["と"],["言った","いった"],["。"],["そして"],["家","いえ"],["に"],["入る","はいる"],["と"],["、"],["イエス"],["の"],["方","ほう"],["から"],["言い","いい"],["だされた"],["。"],["「"],["シモン"],["、"],["あなた"],["は"],["どう"],["思う","おもう"],["か"],["。"],["地上","ちじょう"],["の"],["王","おう"],["は"],["、"],["税","ぜい"],["や"],["貢ぎ物","みつぎもの"],["を"],["だれ"],["から"],["取り立てる","とりたてる"],["の"],["か"],["。"],["自分","じぶん"],["の"],["子供","こども"],["たち"],["から"],["か"],["、"],["それ"],["と"],["も"],["ほか"],["の"],["人々","ひとびと"],["から"],["か"],["。"],["」"]]},{"verse":26,"text":"ペトロが「ほかの人々からです」と答えると、イエスは言われた。「では、子供たちは納めなくてよいわけだ。","tok":[["ペトロ"],["が"],["「"],["ほか"],["の"],["人々","ひとびと"],["から"],["です"],["」"],["と"],["答える","こたえる"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["で"],["は"],["、"],["子供","こども"],["たち"],["は"],["納めなくて","おさめなくて"],["よい"],["わけ"],["だ"],["。"]]},{"verse":27,"text":"しかし、彼らをつまずかせないようにしよう。湖に行って釣りをしなさい。最初に釣れた魚を取って口を開けると、銀貨が一枚見つかるはずだ。それを取って、わたしとあなたの分として納めなさい。」","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["を"],["つまずかせない"],["よう"],["に"],["しよう"],["。"],["湖","みずうみ"],["に"],["行って","いって"],["釣り","つり"],["を"],["し"],["なさい"],["。"],["最初","さいしょ"],["に"],["釣れた","つれた"],["魚","さかな"],["を"],["取って","とって"],["口","くち"],["を"],["開ける","あける"],["と"],["、"],["銀貨","ぎんか"],["が"],["一枚","いちまい"],["見つかる","みつかる"],["はず"],["だ"],["。"],["それ"],["を"],["取って","とって"],["、"],["わたし"],["と"],["あなた"],["の"],["分","ぶん"],["として"],["納め","おさめ"],["なさい"],["。"],["」"]]}]
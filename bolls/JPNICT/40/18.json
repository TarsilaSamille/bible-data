[{"verse":1,"text":"そのとき、弟子たちがイエスのところに来て、「いったいだれが、天の国でいちばん偉いのでしょうか」と言った。","tok":[["その"],["とき"],["、"],["弟子","でし"],["たち"],["が"],["イエス"],["の"],["ところ"],["に"],["来て","きて"],["、"],["「"],["いったい"],["だれ"],["が"],["、"],["天","てん"],["の"],["国","くに"],["で"],["いちばん"],["偉い","えらい"],["の"],["でしょう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"そこで、イエスは一人の子供を呼び寄せ、彼らの中に立たせて、","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["一人","ひとり"],["の"],["子供","こども"],["を"],["呼び寄せ","よびよせ"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["立たせて","たたせて"],["、"]]},{"verse":3,"text":"言われた。「はっきり言っておく。心を入れ替えて子供のようにならなければ、決して天の国に入ることはできない。","tok":[["言われた","いわれた"],["。"],["「"],["はっきり"],["言って","いって"],["おく"],["。"],["心","こころ"],["を"],["入れ替えて","いれかえて"],["子供","こども"],["の"],["よう"],["に"],["ならなければ"],["、"],["決して","けっして"],["天","てん"],["の"],["国","くに"],["に"],["入る","はいる"],["こと"],["は"],["できない"],["。"]]},{"verse":4,"text":"自分を低くして、この子供のようになる人が、天の国でいちばん偉いのだ。","tok":[["自分","じぶん"],["を"],["低く","ひくく"],["して"],["、"],["この"],["子供","こども"],["の"],["よう"],["に"],["なる"],["人","ひと"],["が"],["、"],["天","てん"],["の"],["国","くに"],["で"],["いちばん"],["偉い","えらい"],["の"],["だ"],["。"]]},{"verse":5,"text":"わたしの名のためにこのような一人の子供を受け入れる者は、わたしを受け入れるのである。」","tok":[["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["この"],["よう"],["な"],["一人","ひとり"],["の"],["子供","こども"],["を"],["受け入れる","うけいれる"],["者","もの"],["は"],["、"],["わたし"],["を"],["受け入れる","うけいれる"],["ので"],["ある"],["。"],["」"]]},{"verse":6,"text":"「しかし、わたしを信じるこれらの小さな者の一人をつまずかせる者は、大きな石臼を首に懸けられて、深い海に沈められる方がましである。","tok":[["「"],["しかし"],["、"],["わたし"],["を"],["信じる","しんじる"],["これ"],["ら"],["の"],["小さな","ちいさな"],["者","もの"],["の"],["一人","ひとり"],["を"],["つまずかせる"],["者","もの"],["は"],["、"],["大きな","おおきな"],["石臼","いしうす"],["を"],["首","くび"],["に"],["懸けられて","かけられて"],["、"],["深い","ふかい"],["海","うみ"],["に"],["沈められる","しずめられる"],["方","かた"],["が"],["まし"],["で"],["ある"],["。"]]},{"verse":7,"text":"世は人をつまずかせるから不幸だ。つまずきは避けられない。だが、つまずきをもたらす者は不幸である。","tok":[["世","よ"],["は"],["人","ひと"],["を"],["つまずかせる"],["から"],["不幸","ふこう"],["だ"],["。"],["つまずき"],["は"],["避けられない","さけられない"],["。"],["だ"],["が"],["、"],["つまずき"],["を"],["もたらす"],["者","もの"],["は"],["不幸","ふこう"],["で"],["ある"],["。"]]},{"verse":8,"text":"もし片方の手か足があなたをつまずかせるなら、それを切って捨ててしまいなさい。両手両足がそろったまま永遠の火に投げ込まれるよりは、片手片足になっても命にあずかる方がよい。","tok":[["もし"],["片方","かたほう"],["の"],["手","て"],["か"],["足","あし"],["が"],["あなた"],["を"],["つまずかせるなら"],["、"],["それ"],["を"],["切って","きって"],["捨てて","すてて"],["しまい"],["なさい"],["。"],["両手","りょうて"],["両足","りょうあし"],["が"],["そろった"],["まま"],["永遠","えいえん"],["の"],["火","ひ"],["に"],["投げ込まれる","なげこまれる"],["より"],["は"],["、"],["片手","かたて"],["片足","かたあし"],["に"],["なって"],["も"],["命","いのち"],["に"],["あずかる"],["方","ほう"],["が"],["よい"],["。"]]},{"verse":9,"text":"もし片方の目があなたをつまずかせるなら、えぐり出して捨ててしまいなさい。両方の目がそろったまま火の地獄に投げ込まれるよりは、一つの目になっても命にあずかる方がよい。」","tok":[["もし"],["片方","かたほう"],["の"],["目","め"],["が"],["あなた"],["を"],["つまずかせるなら"],["、"],["えぐり出して","えぐりだして"],["捨てて","すてて"],["しまい"],["なさい"],["。"],["両方","りょうほう"],["の"],["目","め"],["が"],["そろった"],["まま"],["火","ひ"],["の"],["地獄","じごく"],["に"],["投げ込まれる","なげこまれる"],["より"],["は"],["、"],["一","ひと"],["つ"],["の"],["目","め"],["に"],["なって"],["も"],["命","いのち"],["に"],["あずかる"],["方","ほう"],["が"],["よい"],["。"],["」"]]},{"verse":10,"text":"「これらの小さな者を一人でも軽んじないように気をつけなさい。言っておくが、彼らの天使たちは天でいつもわたしの天の父の御顔を仰いでいるのである。","tok":[["「"],["これ"],["ら"],["の"],["小さな","ちいさな"],["者","もの"],["を"],["一人","ひとり"],["で"],["も"],["軽んじない","かろんじない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["言って","いって"],["おく"],["が"],["、"],["彼","かれ"],["ら"],["の"],["天使","てんし"],["たち"],["は"],["天","てん"],["で"],["いつも"],["わたし"],["の"],["天","てん"],["の"],["父","ちち"],["の"],["御顔","おかお"],["を"],["仰いで","あおいで"],["いる"],["ので"],["ある"],["。"]]},{"verse":11,"text":"†〔人の子は、失われたものを救うために来た。〕","tok":[["†"],["〔"],["人","ひと"],["の"],["子","こ"],["は"],["、"],["失われた","うしなわれた"],["もの"],["を"],["救う","すくう"],["ため"],["に"],["来た","きた"],["。"],["〕"]]},{"verse":12,"text":"あなたがたはどう思うか。ある人が羊を百匹持っていて、その一匹が迷い出たとすれば、九十九匹を山に残しておいて、迷い出た一匹を捜しに行かないだろうか。","tok":[["あなた"],["がた"],["は"],["どう"],["思う","おもう"],["か"],["。"],["ある"],["人","ひと"],["が"],["羊","ひつじ"],["を"],["百匹","ひゃくひき"],["持って","もって"],["いて"],["、"],["その"],["一匹","いちひき"],["が"],["迷い出た","まよいでた"],["と"],["すれば"],["、"],["九十九匹","きゅうじゅうきゅうひき"],["を"],["山","やま"],["に"],["残して","のこして"],["おいて"],["、"],["迷い出た","まよいでた"],["一匹","いちひき"],["を"],["捜し","さがし"],["に"],["行かないだろう","いかないだろう"],["か"],["。"]]},{"verse":13,"text":"はっきり言っておくが、もし、それを見つけたら、迷わずにいた九十九匹より、その一匹のことを喜ぶだろう。","tok":[["はっきり"],["言って","いって"],["おく"],["が"],["、"],["もし"],["、"],["それ"],["を"],["見つけたら","みつけたら"],["、"],["迷わず","まよわず"],["に"],["いた"],["九十九匹","きゅうじゅうきゅうひき"],["より"],["、"],["その"],["一匹","いちひき"],["の"],["こと"],["を"],["喜ぶだろう","よろこぶだろう"],["。"]]},{"verse":14,"text":"そのように、これらの小さな者が一人でも滅びることは、あなたがたの天の父の御心ではない。」","tok":[["その"],["よう"],["に"],["、"],["これ"],["ら"],["の"],["小さな","ちいさな"],["者","もの"],["が"],["一人","ひとり"],["で"],["も"],["滅びる","ほろびる"],["こと"],["は"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["の"],["御心","おこころ"],["で"],["は"],["ない"],["。"],["」"]]},{"verse":15,"text":"「兄弟があなたに対して罪を犯したなら、行って二人だけのところで忠告しなさい。言うことを聞き入れたら、兄弟を得たことになる。","tok":[["「"],["兄弟","きょうだい"],["が"],["あなた"],["に対して","にたいして"],["罪","つみ"],["を"],["犯したなら","おかしたなら"],["、"],["行って","いって"],["二人","ふたり"],["だけ"],["の"],["ところ"],["で"],["忠告","ちゅうこく"],["し"],["なさい"],["。"],["言う","いう"],["こと"],["を"],["聞き入れたら","ききいれたら"],["、"],["兄弟","きょうだい"],["を"],["得た","えた"],["こと"],["に"],["なる"],["。"]]},{"verse":16,"text":"聞き入れなければ、ほかに一人か二人、一緒に連れて行きなさい。すべてのことが、二人または三人の証人の口によって確定されるようになるためである。","tok":[["聞き入れなければ","ききいれなければ"],["、"],["ほか"],["に"],["一人","ひとり"],["か"],["二人","ふたり"],["、"],["一緒","いっしょ"],["に"],["連れて","つれて"],["行き","いき"],["なさい"],["。"],["すべて"],["の"],["こと"],["が"],["、"],["二人","ふたり"],["また"],["は"],["三人","さんにん"],["の"],["証人","しょうにん"],["の"],["口","くち"],["によって"],["確定","かくてい"],["される"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":17,"text":"それでも聞き入れなければ、教会に申し出なさい。教会の言うことも聞き入れないなら、その人を異邦人か徴税人と同様に見なしなさい。","tok":[["それ"],["で"],["も"],["聞き入れなければ","ききいれなければ"],["、"],["教会","きょうかい"],["に"],["申し出","もうしで"],["なさい"],["。"],["教会","きょうかい"],["の"],["言う","いう"],["こと"],["も"],["聞き入れないなら","ききいれないなら"],["、"],["その"],["人","ひと"],["を"],["異邦人","いほうじん"],["か"],["徴税人","ちょうぜいにん"],["と"],["同様","どうよう"],["に"],["見なし","みなし"],["なさい"],["。"]]},{"verse":18,"text":"はっきり言っておく。あなたがたが地上でつなぐことは、天上でもつながれ、あなたがたが地上で解くことは、天上でも解かれる。","tok":[["はっきり"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["が"],["地上","ちじょう"],["で"],["つなぐ"],["こと"],["は"],["、"],["天上","てんじょう"],["で"],["も"],["つながれ"],["、"],["あなた"],["がた"],["が"],["地上","ちじょう"],["で"],["解く","とく"],["こと"],["は"],["、"],["天上","てんじょう"],["で"],["も"],["解かれる","とかれる"],["。"]]},{"verse":19,"text":"また、はっきり言っておくが、どんな願い事であれ、あなたがたのうち二人が地上で心を一つにして求めるなら、わたしの天の父はそれをかなえてくださる。","tok":[["また"],["、"],["はっきり"],["言って","いって"],["おく"],["が"],["、"],["どんな"],["願い事","ねがいごと"],["で"],["あれ"],["、"],["あなた"],["がた"],["の"],["うち"],["二人","ふたり"],["が"],["地上","ちじょう"],["で"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["して"],["求めるなら","もとめるなら"],["、"],["わたし"],["の"],["天","てん"],["の"],["父","ちち"],["は"],["それ"],["を"],["かなえて"],["くださる"],["。"]]},{"verse":20,"text":"二人または三人がわたしの名によって集まるところには、わたしもその中にいるのである。」","tok":[["二人","ふたり"],["また"],["は"],["三人","さんにん"],["が"],["わたし"],["の"],["名","な"],["によって"],["集まる","あつまる"],["ところ"],["に"],["は"],["、"],["わたし"],["も"],["その"],["中","なか"],["に"],["いる"],["ので"],["ある"],["。"],["」"]]},{"verse":21,"text":"そのとき、ペトロがイエスのところに来て言った。「主よ、兄弟がわたしに対して罪を犯したなら、何回赦すべきでしょうか。七回までですか。」","tok":[["その"],["とき"],["、"],["ペトロ"],["が"],["イエス"],["の"],["ところ"],["に"],["来て","きて"],["言った","いった"],["。"],["「"],["主","ぬし"],["よ"],["、"],["兄弟","きょうだい"],["が"],["わたし"],["に対して","にたいして"],["罪","つみ"],["を"],["犯したなら","おかしたなら"],["、"],["何回","なんかい"],["赦すべきでしょう","ゆるすべきでしょう"],["か"],["。"],["七","なな"],["回","かい"],["まで"],["です"],["か"],["。"],["」"]]},{"verse":22,"text":"イエスは言われた。「あなたに言っておく。七回どころか七の七十倍までも赦しなさい。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["に"],["言って","いって"],["おく"],["。"],["七","なな"],["回","かい"],["どころ"],["か"],["七","なな"],["の"],["七十","ななじゅう"],["倍","ばい"],["まで"],["も"],["赦し","ゆるし"],["なさい"],["。"]]},{"verse":23,"text":"そこで、天の国は次のようにたとえられる。ある王が、家来たちに貸した金の決済をしようとした。","tok":[["そこ"],["で"],["、"],["天","てん"],["の"],["国","くに"],["は"],["次","つぎ"],["の"],["よう"],["に"],["たとえられる"],["。"],["ある"],["王","おう"],["が"],["、"],["家来","けらい"],["たち"],["に"],["貸した","かした"],["金","かね"],["の"],["決済","けっさい"],["を"],["しよう"],["と"],["した"],["。"]]},{"verse":24,"text":"決済し始めたところ、一万タラントン借金している家来が、王の前に連れて来られた。","tok":[["決済","けっさい"],["し"],["始めた","はじめた"],["ところ"],["、"],["一万","いちまん"],["タラントン"],["借金","しゃっきん"],["して"],["いる"],["家来","けらい"],["が"],["、"],["王","おう"],["の"],["前","まえ"],["に"],["連れて","つれて"],["来られた","こられた"],["。"]]},{"verse":25,"text":"しかし、返済できなかったので、主君はこの家来に、自分も妻も子も、また持ち物も全部売って返済するように命じた。","tok":[["しかし"],["、"],["返済","へんさい"],["できなかった"],["ので"],["、"],["主君","しゅくん"],["は"],["この"],["家来","けらい"],["に"],["、"],["自分","じぶん"],["も"],["妻","つま"],["も"],["子","こ"],["も"],["、"],["また"],["持ち物","もちもの"],["も"],["全部","ぜんぶ"],["売って","うって"],["返済","へんさい"],["する"],["よう"],["に"],["命じた","めいじた"],["。"]]},{"verse":26,"text":"家来はひれ伏し、『どうか待ってください。きっと全部お返しします』としきりに願った。","tok":[["家来","けらい"],["は"],["ひれ伏し","ひれふし"],["、"],["『"],["どう"],["か"],["待って","まって"],["ください"],["。"],["きっと"],["全部","ぜんぶ"],["お返し","おかえし"],["します"],["』"],["と"],["しきり"],["に"],["願った","ねがった"],["。"]]},{"verse":27,"text":"その家来の主君は憐れに思って、彼を赦し、その借金を帳消しにしてやった。","tok":[["その"],["家来","けらい"],["の"],["主君","しゅくん"],["は"],["憐れ","あわれ"],["に"],["思って","おもって"],["、"],["彼","かれ"],["を"],["赦し","ゆるし"],["、"],["その"],["借金","しゃっきん"],["を"],["帳消し","ちょうけし"],["に"],["して"],["やった"],["。"]]},{"verse":28,"text":"ところが、この家来は外に出て、自分に百デナリオンの借金をしている仲間に出会うと、捕まえて首を絞め、『借金を返せ』と言った。","tok":[["ところ"],["が"],["、"],["この"],["家来","けらい"],["は"],["外","そと"],["に"],["出て","でて"],["、"],["自分","じぶん"],["に"],["百","ひゃく"],["デナリオン"],["の"],["借金","しゃっきん"],["を"],["して"],["いる"],["仲間","なかま"],["に"],["出会う","であう"],["と"],["、"],["捕まえて","つかまえて"],["首","くび"],["を"],["絞め","しめ"],["、"],["『"],["借金","しゃっきん"],["を"],["返せ","かえせ"],["』"],["と"],["言った","いった"],["。"]]},{"verse":29,"text":"仲間はひれ伏して、『どうか待ってくれ。返すから』としきりに頼んだ。","tok":[["仲間","なかま"],["は"],["ひれ伏して","ひれふして"],["、"],["『"],["どう"],["か"],["待って","まって"],["くれ"],["。"],["返す","かえす"],["から"],["』"],["と"],["しきり"],["に"],["頼んだ","たのんだ"],["。"]]},{"verse":30,"text":"しかし、承知せず、その仲間を引っぱって行き、借金を返すまでと牢に入れた。","tok":[["しかし"],["、"],["承知","しょうち"],["せず"],["、"],["その"],["仲間","なかま"],["を"],["引っぱって","ひっぱって"],["行き","いき"],["、"],["借金","しゃっきん"],["を"],["返す","かえす"],["まで"],["と"],["牢","ろう"],["に"],["入れた","いれた"],["。"]]},{"verse":31,"text":"仲間たちは、事の次第を見て非常に心を痛め、主君の前に出て事件を残らず告げた。","tok":[["仲間","なかま"],["たち"],["は"],["、"],["事","こと"],["の"],["次第","しだい"],["を"],["見て","みて"],["非常","ひじょう"],["に"],["心","こころ"],["を"],["痛め","いため"],["、"],["主君","しゅくん"],["の"],["前","まえ"],["に"],["出て","でて"],["事件","じけん"],["を"],["残らず","のこらず"],["告げた","つげた"],["。"]]},{"verse":32,"text":"そこで、主君はその家来を呼びつけて言った。『不届きな家来だ。お前が頼んだから、借金を全部帳消しにしてやったのだ。","tok":[["そこ"],["で"],["、"],["主君","しゅくん"],["は"],["その"],["家来","けらい"],["を"],["呼びつけて","よびつけて"],["言った","いった"],["。"],["『"],["不届き","ふとどき"],["な"],["家来","けらい"],["だ"],["。"],["お前","おまえ"],["が"],["頼んだ","たのんだ"],["から"],["、"],["借金","しゃっきん"],["を"],["全部","ぜんぶ"],["帳消し","ちょうけし"],["に"],["して"],["やった"],["の"],["だ"],["。"]]},{"verse":33,"text":"わたしがお前を憐れんでやったように、お前も自分の仲間を憐れんでやるべきではなかったか。』","tok":[["わたし"],["が"],["お前","おまえ"],["を"],["憐れんで","あわれんで"],["やった"],["よう"],["に"],["、"],["お前","おまえ"],["も"],["自分","じぶん"],["の"],["仲間","なかま"],["を"],["憐れんで","あわれんで"],["やるべきで"],["は"],["なかった"],["か"],["。"],["』"]]},{"verse":34,"text":"そして、主君は怒って、借金をすっかり返済するまでと、家来を牢役人に引き渡した。","tok":[["そして"],["、"],["主君","しゅくん"],["は"],["怒って","おこって"],["、"],["借金","しゃっきん"],["を"],["すっかり"],["返済","へんさい"],["する"],["まで"],["と"],["、"],["家来","けらい"],["を"],["牢役人","ろうやくにん"],["に"],["引き渡した","ひきわたした"],["。"]]},{"verse":35,"text":"あなたがたの一人一人が、心から兄弟を赦さないなら、わたしの天の父もあなたがたに同じようになさるであろう。」","tok":[["あなた"],["がた"],["の"],["一人一人","ひとりひとり"],["が"],["、"],["心","こころ"],["から"],["兄弟","きょうだい"],["を"],["赦さないなら","ゆるさないなら"],["、"],["わたし"],["の"],["天","てん"],["の"],["父","ちち"],["も"],["あなた"],["がた"],["に"],["同じ","おなじ"],["よう"],["に"],["なさるで"],["あろう"],["。"],["」"]]}]
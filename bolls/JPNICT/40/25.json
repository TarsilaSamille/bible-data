[{"verse":1,"text":"「そこで、天の国は次のようにたとえられる。十人のおとめがそれぞれともし火を持って、花婿を迎えに出て行く。","tok":[["「"],["そこ"],["で"],["、"],["天","てん"],["の"],["国","くに"],["は"],["次","つぎ"],["の"],["よう"],["に"],["たとえられる"],["。"],["十人","じゅうにん"],["の"],["おとめ"],["が"],["それぞれ"],["ともし火","ともしび"],["を"],["持って","もって"],["、"],["花婿","はなむこ"],["を"],["迎え","むかえ"],["に"],["出て","でて"],["行く","いく"],["。"]]},{"verse":2,"text":"そのうちの五人は愚かで、五人は賢かった。","tok":[["その"],["うち"],["の"],["五人","ごにん"],["は"],["愚か","おろか"],["で"],["、"],["五人","ごにん"],["は"],["賢かった","かしこかった"],["。"]]},{"verse":3,"text":"愚かなおとめたちは、ともし火は持っていたが、油の用意をしていなかった。","tok":[["愚か","おろか"],["な"],["おとめ"],["たち"],["は"],["、"],["ともし火","ともしび"],["は"],["持って","もって"],["いた"],["が"],["、"],["油","あぶら"],["の"],["用意","ようい"],["を"],["して"],["いなかった"],["。"]]},{"verse":4,"text":"賢いおとめたちは、それぞれのともし火と一緒に、壺に油を入れて持っていた。","tok":[["賢い","かしこい"],["おとめ"],["たち"],["は"],["、"],["それぞれ"],["の"],["ともし火","ともしび"],["と"],["一緒","いっしょ"],["に"],["、"],["壺","つぼ"],["に"],["油","あぶら"],["を"],["入れて","いれて"],["持って","もって"],["いた"],["。"]]},{"verse":5,"text":"ところが、花婿の来るのが遅れたので、皆眠気がさして眠り込んでしまった。","tok":[["ところ"],["が"],["、"],["花婿","はなむこ"],["の"],["来る","くる"],["の"],["が"],["遅れた","おくれた"],["ので"],["、"],["皆","みな"],["眠気","ねむけ"],["が"],["さして"],["眠り込んで","ねむりこんで"],["しまった"],["。"]]},{"verse":6,"text":"真夜中に『花婿だ。迎えに出なさい』と叫ぶ声がした。","tok":[["真夜中","まよなか"],["に"],["『"],["花婿","はなむこ"],["だ"],["。"],["迎え","むかえ"],["に"],["出","で"],["なさい"],["』"],["と"],["叫ぶ","さけぶ"],["声","こえ"],["が"],["した"],["。"]]},{"verse":7,"text":"そこで、おとめたちは皆起きて、それぞれのともし火を整えた。","tok":[["そこ"],["で"],["、"],["おとめ"],["たち"],["は"],["皆","みな"],["起きて","おきて"],["、"],["それぞれ"],["の"],["ともし火","ともしび"],["を"],["整えた","ととのえた"],["。"]]},{"verse":8,"text":"愚かなおとめたちは、賢いおとめたちに言った。『油を分けてください。わたしたちのともし火は消えそうです。』","tok":[["愚か","おろか"],["な"],["おとめ"],["たち"],["は"],["、"],["賢い","かしこい"],["おとめ"],["たち"],["に"],["言った","いった"],["。"],["『"],["油","あぶら"],["を"],["分けて","わけて"],["ください"],["。"],["わたしたち"],["の"],["ともし火","ともしび"],["は"],["消え","きえ"],["そう"],["です"],["。"],["』"]]},{"verse":9,"text":"賢いおとめたちは答えた。『分けてあげるほどはありません。それより、店に行って、自分の分を買って来なさい。』","tok":[["賢い","かしこい"],["
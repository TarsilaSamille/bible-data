[{"verse":1,"text":"イエスはこの群衆を見て、山に登られた。腰を下ろされると、弟子たちが近くに寄って来た。","tok":[["イエス"],["は"],["この"],["群衆","ぐんしゅう"],["を"],["見て","みて"],["、"],["山","やま"],["に"],["登られた","のぼられた"],["。"],["腰","こし"],["を"],["下ろされる","おろされる"],["と"],["、"],["弟子","でし"],["たち"],["が"],["近く","ちかく"],["に"],["寄って","よって"],["来た","きた"],["。"]]},{"verse":2,"text":"そこで、イエスは口を開き、教えられた。","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["口","くち"],["を"],["開き","ひらき"],["、"],["教えられた","おしえられた"],["。"]]},{"verse":3,"text":"「心の貧しい人々は、幸いである、天の国はその人たちのものである。","tok":[["「"],["心","こころ"],["の"],["貧しい","まずしい"],["人々","ひとびと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["、"],["天","てん"],["の"],["国","くに"],["は"],["その"],["人","ひと"],["たち"],["の"],["もの"],["で"],["ある"],["。"]]},{"verse":4,"text":"悲しむ人々は、幸いである、その人たちは慰められる。","tok":[["悲しむ","かなしむ"],["人々","ひとびと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["、"],["その"],["人","ひと"],["たち"],["は"],["慰められる","なぐさめられる"],["。"]]},{"verse":5,"text":"柔和な人々は、幸いである、その人たちは地を受け継ぐ。","tok":[["柔和","にゅうわ"],["な"],["人々","ひとびと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["、"],["その"],["人","ひと"],["たち"],["は"],["地","ち"],["を"],["受け継ぐ","うけつぐ"],["。"]]},{"verse":6,"text":"義に飢え渇く人々は、幸いである、その人たちは満たされる。","tok":[["義","ぎ"],["に"],["飢え渇く","うえかわく"],["人々","ひとびと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["、"],["その"],["人","ひと"],["たち"],["は"],["満たされる","みたされる"],["。"]]},{"verse":7,"text":"憐れみ深い人々は、幸いである、その人たちは憐れみを受ける。","tok":[["憐れみ","あわれみ"],["深い","ふかい"],["人々","ひとびと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["、"],["その"],["人","ひと"],["たち"],["は"],["憐れみ","あわれみ"],["を"],["受ける","うける"],["。"]]},{"verse":8,"text":"心の清い人々は、幸いである、その人たちは神を見る。","tok":[["心","こころ"],["の"],["清い","きよい"],["人々","ひとびと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["、"],["その"],["人","ひと"],["たち"],["は"],["神","かみ"],["を"],["見る","みる"],["。"]]},{"verse":9,"text":"平和を実現する人々は、幸いである、その人たちは神の子と呼ばれる。","tok":[["平和","へいわ"],["を"],["実現","じつげん"],["する"],["人々","ひとびと"],["は"],["、"],["幸い","さいわい"],["で"],["ある"],["、"],["その"],["人","ひと"],["たち"],["は"],["神","かみ"],["の"],["子","こ"],["と"],["呼ばれる","よばれる"],["。"]]},{"verse":10,"text":"義のために迫害される人々は、幸いである
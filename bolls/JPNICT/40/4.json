[{"verse":1,"text":"さて、イエスは悪魔から誘惑を受けるため、“霊”に導かれて荒れ野に行かれた。","tok":[["さて"],["、"],["イエス"],["は"],["悪魔","あくま"],["から"],["誘惑","ゆうわく"],["を"],["受ける","うける"],["ため"],["、"],["“"],["霊","れい"],["”"],["に"],["導かれて","みちびかれて"],["荒れ野","あれの"],["に"],["行かれた","いかれた"],["。"]]},{"verse":2,"text":"そして四十日間、昼も夜も断食した後、空腹を覚えられた。","tok":[["そして"],["四十日間","しとかかん"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["断食","だんじき"],["した"],["後","あと"],["、"],["空腹","くうふく"],["を"],["覚えられた","おぼえられた"],["。"]]},{"verse":3,"text":"すると、誘惑する者が来て、イエスに言った。「神の子なら、これらの石がパンになるように命じたらどうだ。」","tok":[["する"],["と"],["、"],["誘惑","ゆうわく"],["する"],["者","もの"],["が"],["来て","きて"],["、"],["イエス"],["に"],["言った","いった"],["。"],["「"],["神","かみ"],["の"],["子","こ"],["なら"],["、"],["これ"],["ら"],["の"],["石","いし"],["が"],["パン"],["に"],["なる"],["よう"],["に"],["命じたら","めいじたら"],["どう"],["だ"],["。"],["」"]]},{"verse":4,"text":"イエスはお答えになった。「『人はパンだけで生きるものではない。神の口から出る一つ一つの言葉で生きる』と書いてある。」","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["『"],["人","ひと"],["は"],["パン"],["だけ"],["で"],["生きる","いきる"],["もの"],["で"],["は"],["ない"],["。"],["神","かみ"],["の"],["口","くち"],["から"],["出る","でる"],["一","ひと"],["つ"],["一","ひと"],["つ"],["の"],["言葉","ことば"],["で"],["生きる","いきる"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["」"]]},{"verse":5,"text":"次に、悪魔はイエスを聖なる都に連れて行き、神殿の屋根の端に立たせて、","tok":[["次","つぎ"],["に"],["、"],["悪魔","あくま"],["は"],["イエス"],["を"],["聖","せい"],["なる"],["都","と"],["に"],["連れて","つれて"],["行き","いき"],["、"],["神殿","しんでん"],["の"],["屋根","やね"],["の"],["端","はし"],["に"],["立たせて","たたせて"],["、"]]},{"verse":6,"text":"言った。「神の子なら、飛び降りたらどうだ。『神があなたのために天使たちに命じると、あなたの足が石に打ち当たることのないように、天使たちは手であなたを支える』と書いてある。」","tok":[["言った","いった"],["。"],["「"],["神","かみ"],["の"],["子","こ"],["なら"],["、"],["飛び降りたら","とびおりたら"],["どう"],["だ"],["。"],["『"],["神","かみ"],["が"],["あなた"],["の"],["ため"],["に"],["天使","てんし"],["たち"],["に"],["命じる","めいじる"],["と"],["、"],["あなた"],["の"],["足","あし"],["が"],["石","いし"],["に"],["打ち当たる","うちあたる"],["こと"],["の"],["ない"],["よう"],["に"],["、"],["天使","てんし"],["たち"],["は"],["手","て"],["で"],["あなた"],["を"],["支える","ささえる"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["」"]]},{"verse":7,"text":"イエスは、「『あなたの神である主を試してはならない』とも書いてある」と言われた。","tok":[["イエス"],["は"],["、"],["「"],["『"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["を"],["試して","ためして"],["は"],["ならない"],["』"],["と"],["も"],["書いて","かいて"],["ある"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"更に、悪魔はイエスを非常に高い山に連れて行き、世のすべての国々とその繁栄ぶりを見せて、","tok":[["更に","さらに"],["、"],["悪魔","あくま"],["は"],["イエス"],["を"],["非常","ひじょう"],["に"],["高い","たかい"],["山","やま"],["に"],["連れて","つれて"],["行き","いき"],["、"],["世","よ"],["の"],["すべて"],["の"],["国々","くにぐに"],["と"],["その"],["繁栄","はんえい"],["ぶり"],["を"],["見せて","みせて"],["、"]]},{"verse":9,"text":"「もし、ひれ伏してわたしを拝むなら、これをみんな与えよう」と言った。","tok":[["「"],["もし"],["、"],["ひれ伏して","ひれふして"],["わたし"],["を"],["拝むなら","おがむなら"],["、"],["これ"],["を"],["みんな"],["与えよう","あたえよう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":10,"text":"すると、イエスは言われた。「退け、サタン。『あなたの神である主を拝み、ただ主に仕えよ』と書いてある。」","tok":[["する"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["退け","しりぞけ"],["、"],["サタン"],["。"],["『"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["を"],["拝み","おがみ"],["、"],["ただ"],["主に","おもに"],["仕え","つかえ"],["よ"],["』"],["と"],["書いて","かいて"],["ある"],["。"],["」"]]},{"verse":11,"text":"そこで、悪魔は離れ去った。すると、天使たちが来てイエスに仕えた。","tok":[["そこ"],["で"],["、"],["悪魔","あくま"],["は"],["離れ去った","はなれさった"],["。"],["する"],["と"],["、"],["天使","てんし"],["たち"],["が"],["来て","きて"],["イエス"],["に"],["仕えた","つかえた"],["。"]]},{"verse":12,"text":"イエスは、ヨハネが捕らえられたと聞き、ガリラヤに退かれた。","tok":[["イエス"],["は"],["、"],["ヨハネ"],["が"],["捕らえられた","とらえられた"],["と"],["聞き","きき"],["、"],["ガリラヤ"],["に"],["退かれた","しりぞかれた"],["。"]]},{"verse":13,"text":"そして、ナザレを離れ、ゼブルンとナフタリの地方にある湖畔の町カファルナウムに来て住まわれた。","tok":[["そして"],["、"],["ナザレ"],["を"],["離れ","はなれ"],["、"],["ゼブルン"],["と"],["ナフタリ"],["の"],["地方","ちほう"],["に"],["ある"],["湖畔","こはん"],["の"],["町","まち"],["カファルナウム"],["に"],["来て","きて"],["住まわれた","すまわれた"],["。"]]},{"verse":14,"text":"それは、預言者イザヤを通して言われていたことが実現するためであった。","tok":[["それ"],["は"],["、"],["預言者","よげんしゃ"],["イザヤ"],["を"],["通して","とおして"],["言われて","いわれて"],["いた"],["こと"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":15,"text":"「ゼブルンの地とナフタリの地、湖沿いの道、ヨルダン川のかなたの地、異邦人のガリラヤ、","tok":[["「"],["ゼブルン"],["の"],["地","ち"],["と"],["ナフタリ"],["の"],["地","ち"],["、"],["湖沿い","みずうみそい"],["の"],["道","みち"],["、"],["ヨルダン"],["川","かわ"],["の"],["かなた"],["の"],["地","ち"],["、"],["異邦人","いほうじん"],["の"],["ガリラヤ"],["、"]]},{"verse":16,"text":"暗闇に住む民は大きな光を見、死の陰の地に住む者に光が射し込んだ。」","tok":[["暗闇","くらやみ"],["に"],["住む","すむ"],["民","たみ"],["は"],["大きな","おおきな"],["光","ひかり"],["を"],["見","み"],["、"],["死","し"],["の"],["陰","かげ"],["の"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["に"],["光","ひかり"],["が"],["射し込んだ","さしこんだ"],["。"],["」"]]},{"verse":17,"text":"そのときから、イエスは、「悔い改めよ。天の国は近づいた」と言って、宣べ伝え始められた。","tok":[["その"],["とき"],["から"],["、"],["イエス"],["は"],["、"],["「"],["悔い改め","くいあらため"],["よ"],["。"],["天","てん"],["の"],["国","くに"],["は"],["近づいた","ちかづいた"],["」"],["と"],["言って","いって"],["、"],["宣べ伝え","のべつたえ"],["始められた","はじめられた"],["。"]]},{"verse":18,"text":"イエスは、ガリラヤ湖のほとりを歩いておられたとき、二人の兄弟、ペトロと呼ばれるシモンとその兄弟アンデレが、湖で網を打っているのを御覧になった。彼らは漁師だった。","tok":[["イエス"],["は"],["、"],["ガリラヤ"],["湖","こ"],["の"],["ほとり"],["を"],["歩いて","あるいて"],["おられた"],["とき"],["、"],["二人","ふたり"],["の"],["兄弟","きょうだい"],["、"],["ペトロ"],["と"],["呼ばれる","よばれる"],["シモン"],["と"],["その"],["兄弟","きょうだい"],["アンデレ"],["が"],["、"],["湖","みずうみ"],["で"],["網","あみ"],["を"],["打って","うって"],["いる"],["の"],["を"],["御覧","ごらん"],["に"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["漁師","りょうし"],["だった"],["。"]]},{"verse":19,"text":"イエスは、「わたしについて来なさい。人間をとる漁師にしよう」と言われた。","tok":[["イエス"],["は"],["、"],["「"],["わたし"],["について"],["来","き"],["なさい"],["。"],["人間","にんげん"],["を"],["とる"],["漁師","りょうし"],["に"],["しよう"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":20,"text":"二人はすぐに網を捨てて従った。","tok":[["二人","ふたり"],["は"],["すぐ"],["に"],["網","あみ"],["を"],["捨てて","すてて"],["従った","したがった"],["。"]]},{"verse":21,"text":"そこから進んで、別の二人の兄弟、ゼベダイの子ヤコブとその兄弟ヨハネが、父親のゼベダイと一緒に、舟の中で網の手入れをしているのを御覧になると、彼らをお呼びになった。","tok":[["そこ"],["から"],["進んで","すすんで"],["、"],["別","べつ"],["の"],["二人","ふたり"],["の"],["兄弟","きょうだい"],["、"],["ゼベダイ"],["の"],["子","こ"],["ヤコブ"],["と"],["その"],["兄弟","きょうだい"],["ヨハネ"],["が"],["、"],["父親","ちちおや"],["の"],["ゼベダイ"],["と"],["一緒","いっしょ"],["に"],["、"],["舟","ふね"],["の"],["中","なか"],["で"],["網","あみ"],["の"],["手入れ","ていれ"],["を"],["して"],["いる"],["の"],["を"],["御覧","ごらん"],["に"],["なる"],["と"],["、"],["彼","かれ"],["ら"],["を"],["お"],["呼び","よび"],["に"],["なった"],["。"]]},{"verse":22,"text":"この二人もすぐに、舟と父親とを残してイエスに従った。","tok":[["この"],["二人","ふたり"],["も"],["すぐ"],["に"],["、"],["舟","ふね"],["と"],["父親","ちちおや"],["と"],["を"],["残して","のこして"],["イエス"],["に"],["従った","したがった"],["。"]]},{"verse":23,"text":"イエスはガリラヤ中を回って、諸会堂で教え、御国の福音を宣べ伝え、また、民衆のありとあらゆる病気や患いをいやされた。","tok":[["イエス"],["は"],["ガリラヤ"],["中","ちゅう"],["を"],["回って","まわって"],["、"],["諸","しょ"],["会堂","かいどう"],["で"],["教え","おしえ"],["、"],["御国","みくに"],["の"],["福音","ふくいん"],["を"],["宣べ伝え","のべつたえ"],["、"],["また"],["、"],["民衆","みんしゅう"],["の"],["あり"],["と"],["あらゆる"],["病気","びょうき"],["や"],["患い","わずらい"],["を"],["いやされた"],["。"]]},{"verse":24,"text":"そこで、イエスの評判がシリア中に広まった。人々がイエスのところへ、いろいろな病気や苦しみに悩む者、悪霊に取りつかれた者、てんかんの者、中風の者など、あらゆる病人を連れて来たので、これらの人々をいやされた。","tok":[["そこ"],["で"],["、"],["イエス"],["の"],["評判","ひょうばん"],["が"],["シリア中","しりあちゅう"],["に"],["広まった","ひろまった"],["。"],["人々","ひとびと"],["が"],["イエス"],["の"],["ところ"],["へ"],["、"],["いろいろ"],["な"],["病気","びょうき"],["や"],["苦しみ","くるしみ"],["に"],["悩む","なやむ"],["者","もの"],["、"],["悪霊","あくりょう"],["に"],["取りつかれた","とりつかれた"],["者","もの"],["、"],["てんかん"],["の"],["者","もの"],["、"],["中風","ちゅうぶ"],["の"],["者","もの"],["など"],["、"],["あらゆる"],["病人","びょうにん"],["を"],["連れて","つれて"],["来た","きた"],["ので"],["、"],["これ"],["ら"],["の"],["人々","ひとびと"],["を"],["いやされた"],["。"]]},{"verse":25,"text":"こうして、ガリラヤ、デカポリス、エルサレム、ユダヤ、ヨルダン川の向こう側から、大勢の群衆が来てイエスに従った。","tok":[["こう"],["して"],["、"],["ガリラヤ"],["、"],["デカポリス"],["、"],["エルサレム"],["、"],["ユダヤ"],["、"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["から"],["、"],["大勢","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["来て","きて"],["イエス"],["に"],["従った","したがった"],["。"]]}]
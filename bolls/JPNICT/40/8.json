[{"verse":1,"text":"イエスが山を下りられると、大勢の群衆が従った。","tok":[["イエス"],["が"],["山","やま"],["を"],["下りられる","おりられる"],["と"],["、"],["大勢","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["従った","したがった"],["。"]]},{"verse":2,"text":"すると、一人の重い皮膚病を患っている人がイエスに近寄り、ひれ伏して、「主よ、御心ならば、わたしを清くすることがおできになります」と言った。","tok":[["する"],["と"],["、"],["一人","ひとり"],["の"],["重い","おもい"],["皮膚病","ひふびょう"],["を"],["患って","わずらって"],["いる"],["人","ひと"],["が"],["イエス"],["に"],["近寄り","ちかより"],["、"],["ひれ伏して","ひれふして"],["、"],["「"],["主","ぬし"],["よ"],["、"],["御心","おこころ"],["ならば"],["、"],["わたし"],["を"],["清く","きよく"],["する"],["こと"],["が"],["おでき"],["に"],["なります"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"イエスが手を差し伸べてその人に触れ、「よろしい。清くなれ」と言われると、たちまち、重い皮膚病は清くなった。","tok":[["イエス"],["が"],["手","て"],["を"],["差し伸べて","さしのべて"],["その"],["人","ひと"],["に"],["触れ","ふれ"],["、"],["「"],["よろしい"],["。"],["清く","きよく"],["なれ"],["」"],["と"],["言われる","いわれる"],["と"],["、"],["たちまち"],["、"],["重い","おもい"],["皮膚病","ひふびょう"],["は"],["清く","きよく"],["なった"],["。"]]},{"verse":4,"text":"イエスはその人に言われた。「だれにも話さないように気をつけなさい。ただ、行って祭司に体を見せ、モーセが定めた供え物を献げて、人々に証明しなさい。」","tok":[["イエス"],["は"],["その"],["人","ひと"],["に"],["言われた","いわれた"],["。"],["「"],["だれ"],["に"],["も"],["話さない","はなさない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["ただ"],["、"],["行って","いって"],["祭司","さいし"],["に"],["体","からだ"],["を"],["見せ","みせ"],["、"],["モーセ"],["が"],["定めた","さだめた"],["供え物","そなえもの"],["を"],["献げて","ささげて"],["、"],["人々","ひとびと"],["に"],["証明","しょうめい"],["し"],["なさい"],["。"],["」"]]},{"verse":5,"text":"さて、イエスがカファルナウムに入られると、一人の百人隊長が近づいて来て懇願し、","tok":[["さて"],["、"],["イエス"],["が"],["カファルナウム"],["に"],["入られる","はいられる"],["と"],["、"],["一人","ひとり"],["の"],["百人","ひゃくにん"],["隊長","たいちょう"],["が"],["近づいて","ちかづいて"],["来て","きて"],["懇願","こんがん"],["し"],["、"]]},{"verse":6,"text":"「主よ、わたしの僕が中風で家に寝込んで、ひどく苦しんでいます」と言った。","tok":[["「"],["主","ぬし"],["よ"],["、"],["わたし"],["の"],["僕","ぼく"],["が"],["中風","ちゅうぶ"],["で"],["家","いえ"],["に"],["寝込んで","ねこんで"],["、"],["ひどく"],["苦しんで","くるしんで"],["います"],["」"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"そこでイエスは、「わたしが行って、いやしてあげよう」と言われた。","tok":[["そこ"],["で"],["イエス"],["は"],["、"],["「"],["わたし"],["が"],["行って","いって"],["、"],["いやして"],["あげよう"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":8,"text":"すると、百人隊長は答えた。「主よ、わたしはあなたを自分の屋根の下にお迎えできるような者ではありません。ただ、ひと言おっしゃってください。そうすれば、わたしの僕はいやされます。","tok":[["する"],["と"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["は"],["答えた","こたえた"],["。"],["「"],["主","ぬし"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["自分","じぶん"],["の"],["屋根","やね"],["の"],["下","した"],["に"],["お迎え","おむかえ"],["できる"],["よう"],["な"],["者","もの"],["で"],["は"],["ありません"],["。"],["ただ"],["、"],["ひと言","ひとこと"],["おっしゃって"],["ください"],["。"],["そう"],["すれば"],["、"],["わたし"],["の"],["僕","ぼく"],["は"],["いやされます"],["。"]]},{"verse":9,"text":"わたしも権威の下にある者ですが、わたしの下には兵隊がおり、一人に『行け』と言えば行きますし、他の一人に『来い』と言えば来ます。また、部下に『これをしろ』と言えば、そのとおりにします。」","tok":[["わたし"],["も"],["権威","けんい"],["の"],["下","した"],["に"],["ある"],["者","もの"],["です"],["が"],["、"],["わたし"],["の"],["下","した"],["に"],["は"],["兵隊","へいたい"],["が"],["おり"],["、"],["一人","ひとり"],["に"],["『"],["行け","いけ"],["』"],["と"],["言えば","いえば"],["行きます","いきます"],["し"],["、"],["他","た"],["の"],["一人","ひとり"],["に"],["『"],["来い","こい"],["』"],["と"],["言えば","いえば"],["来ます","きます"],["。"],["また"],["、"],["部下","ぶか"],["に"],["『"],["これ"],["を"],["しろ"],["』"],["と"],["言えば","いえば"],["、"],["その"],["とおり"],["に"],["します"],["。"],["」"]]},{"verse":10,"text":"イエスはこれを聞いて感心し、従っていた人々に言われた。「はっきり言っておく。イスラエルの中でさえ、わたしはこれほどの信仰を見たことがない。","tok":[["イエス"],["は"],["これ"],["を"],["聞いて","きいて"],["感心","かんしん"],["し"],["、"],["従って","したがって"],["いた"],["人々","ひとびと"],["に"],["言われた","いわれた"],["。"],["「"],["はっきり"],["言って","いって"],["おく"],["。"],["イスラエル"],["の"],["中","なか"],["で"],["さえ"],["、"],["わたし"],["は"],["これ"],["ほど"],["の"],["信仰","しんこう"],["を"],["見た","みた"],["こと"],["が"],["ない"],["。"]]},{"verse":11,"text":"言っておくが、いつか、東や西から大勢の人が来て、天の国でアブラハム、イサク、ヤコブと共に宴会の席に着く。","tok":[["言って","いって"],["おく"],["が"],["、"],["いつ"],["か"],["、"],["東","ひがし"],["や"],["西","にし"],["から"],["大勢","おおぜい"],["の"],["人","ひと"],["が"],["来て","きて"],["、"],["天","てん"],["の"],["国","くに"],["で"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["と"],["共","とも"],["に"],["宴会","えんかい"],["の"],["席","せき"],["に"],["着く","つく"],["。"]]},{"verse":12,"text":"だが、御国の子らは、外の暗闇に追い出される。そこで泣きわめいて歯ぎしりするだろう。」","tok":[["だ"],["が"],["、"],["御国","みくに"],["の"],["子","こ"],["ら"],["は"],["、"],["外","そと"],["の"],["暗闇","くらやみ"],["に"],["追い出される","おいだされる"],["。"],["そこ"],["で"],["泣きわめいて","なきわめいて"],["歯ぎしり","はぎしり"],["するだろう"],["。"],["」"]]},{"verse":13,"text":"そして、百人隊長に言われた。「帰りなさい。あなたが信じたとおりになるように。」ちょうどそのとき、僕の病気はいやされた。","tok":[["そして"],["、"],["百人","ひゃくにん"],["隊長","たいちょう"],["に"],["言われた","いわれた"],["。"],["「"],["帰り","かえり"],["なさい"],["。"],["あなた"],["が"],["信じた","しんじた"],["とおり"],["に"],["なる"],["よう"],["に"],["。"],["」"],["ちょうど"],["その"],["とき"],["、"],["僕","ぼく"],["の"],["病気","びょうき"],["は"],["いやされた"],["。"]]},{"verse":14,"text":"イエスはペトロの家に行き、そのしゅうとめが熱を出して寝込んでいるのを御覧になった。","tok":[["イエス"],["は"],["ペトロ"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["その"],["しゅうとめ"],["が"],["熱","ねつ"],["を"],["出して","だして"],["寝込んで","ねこんで"],["いる"],["の"],["を"],["御覧","ごらん"],["に"],["なった"],["。"]]},{"verse":15,"text":"イエスがその手に触れられると、熱は去り、しゅうとめは起き上がってイエスをもてなした。","tok":[["イエス"],["が"],["その"],["手","て"],["に"],["触れられる","ふれられる"],["と"],["、"],["熱","ねつ"],["は"],["去り","さり"],["、"],["しゅうとめ"],["は"],["起き上がって","おきあがって"],["イエス"],["を"],["もてなした"],["。"]]},{"verse":16,"text":"夕方になると、人々は悪霊に取りつかれた者を大勢連れて来た。イエスは言葉で悪霊を追い出し、病人を皆いやされた。","tok":[["夕方","ゆうがた"],["に"],["なる"],["と"],["、"],["人々","ひとびと"],["は"],["悪霊","あくりょう"],["に"],["取りつかれた","とりつかれた"],["者","もの"],["を"],["大勢","おおぜい"],["連れて","つれて"],["来た","きた"],["。"],["イエス"],["は"],["言葉","ことば"],["で"],["悪霊","あくりょう"],["を"],["追い出し","おいだし"],["、"],["病人","びょうにん"],["を"],["皆","みな"],["いやされた"],["。"]]},{"verse":17,"text":"それは、預言者イザヤを通して言われていたことが実現するためであった。「彼はわたしたちの患いを負い、わたしたちの病を担った。」","tok":[["それ"],["は"],["、"],["預言者","よげんしゃ"],["イザヤ"],["を"],["通して","とおして"],["言われて","いわれて"],["いた"],["こと"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"],["「"],["彼","かれ"],["は"],["わたしたち"],["の"],["患い","わずらい"],["を"],["負い","おい"],["、"],["わたしたち"],["の"],["病","やまい"],["を"],["担った","になった"],["。"],["」"]]},{"verse":18,"text":"イエスは、自分を取り囲んでいる群衆を見て、弟子たちに向こう岸に行くように命じられた。","tok":[["イエス"],["は"],["、"],["自分","じぶん"],["を"],["取り囲んで","とりかこんで"],["いる"],["群衆","ぐんしゅう"],["を"],["見て","みて"],["、"],["弟子","でし"],["たち"],["に"],["向こう岸","むこうぎし"],["に"],["行く","いく"],["よう"],["に"],["命じられた","めいじられた"],["。"]]},{"verse":19,"text":"そのとき、ある律法学者が近づいて、「先生、あなたがおいでになる所なら、どこへでも従って参ります」と言った。","tok":[["その"],["とき"],["、"],["ある"],["律法学者","りっぽうがくしゃ"],["が"],["近づいて","ちかづいて"],["、"],["「"],["先生","せんせい"],["、"],["あなた"],["が"],["おいで"],["に"],["なる"],["所","ところ"],["なら"],["、"],["どこ"],["へ"],["で"],["も"],["従って","したがって"],["参ります","まいります"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"イエスは言われた。「狐には穴があり、空の鳥には巣がある。だが、人の子には枕する所もない。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["狐","きつね"],["に"],["は"],["穴","あな"],["が"],["あり"],["、"],["空","そら"],["の"],["鳥","とり"],["に"],["は"],["巣","す"],["が"],["ある"],["。"],["だ"],["が"],["、"],["人","ひと"],["の"],["子","こ"],["に"],["は"],["枕","まくら"],["する"],["所","ところ"],["も"],["ない"],["。"],["」"]]},{"verse":21,"text":"ほかに、弟子の一人がイエスに、「主よ、まず、父を葬りに行かせてください」と言った。","tok":[["ほか"],["に"],["、"],["弟子","でし"],["の"],["一人","ひとり"],["が"],["イエス"],["に"],["、"],["「"],["主","ぬし"],["よ"],["、"],["まず"],["、"],["父","ちち"],["を"],["葬り","ほうむり"],["に"],["行かせて","いかせて"],["ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":22,"text":"イエスは言われた。「わたしに従いなさい。死んでいる者たちに、自分たちの死者を葬らせなさい。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["わたし"],["に"],["従い","したがい"],["なさい"],["。"],["死んで","しんで"],["いる"],["者","もの"],["たち"],["に"],["、"],["自分","じぶん"],["たち"],["の"],["死者","ししゃ"],["を"],["葬らせ","ほうむらせ"],["なさい"],["。"],["」"]]},{"verse":23,"text":"イエスが舟に乗り込まれると、弟子たちも従った。","tok":[["イエス"],["が"],["舟","ふね"],["に"],["乗り込まれる","のりこまれる"],["と"],["、"],["弟子","でし"],["たち"],["も"],["従った","したがった"],["。"]]},{"verse":24,"text":"そのとき、湖に激しい嵐が起こり、舟は波にのまれそうになった。イエスは眠っておられた。","tok":[["その"],["とき"],["、"],["湖","みずうみ"],["に"],["激しい","はげしい"],["嵐","あらし"],["が"],["起こり","おこり"],["、"],["舟","ふね"],["は"],["波","なみ"],["に"],["のまれ"],["そう"],["に"],["なった"],["。"],["イエス"],["は"],["眠って","ねむって"],["おられた"],["。"]]},{"verse":25,"text":"弟子たちは近寄って起こし、「主よ、助けてください。おぼれそうです」と言った。","tok":[["弟子","でし"],["たち"],["は"],["近寄って","ちかよって"],["起こし","おこし"],["、"],["「"],["主","ぬし"],["よ"],["、"],["助けて","たすけて"],["ください"],["。"],["おぼれ"],["そう"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"イエスは言われた。「なぜ怖がるのか。信仰の薄い者たちよ。」そして、起き上がって風と湖とをお叱りになると、すっかり凪になった。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["なぜ"],["怖","こわ"],["がる"],["の"],["か"],["。"],["信仰","しんこう"],["の"],["薄い","うすい"],["者","もの"],["たち"],["よ"],["。"],["」"],["そして"],["、"],["起き上がって","おきあがって"],["風","かぜ"],["と"],["湖","みずうみ"],["と"],["を"],["お叱り","おしかり"],["に"],["なる"],["と"],["、"],["すっかり"],["凪","なぎ"],["に"],["なった"],["。"]]},{"verse":27,"text":"人々は驚いて、「いったい、この方はどういう方なのだろう。風や湖さえも従うではないか」と言った。","tok":[["人々","ひとびと"],["は"],["驚いて","おどろいて"],["、"],["「"],["いったい"],["、"],["この"],["方","かた"],["は"],["どういう"],["方","ほう"],["な"],["の"],["だろう"],["。"],["風","かぜ"],["や"],["湖","みずうみ"],["さえ"],["も"],["従うで","したがうで"],["は"],["ない"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":28,"text":"イエスが向こう岸のガダラ人の地方に着かれると、悪霊に取りつかれた者が二人、墓場から出てイエスのところにやって来た。二人は非常に狂暴で、だれもその辺りの道を通れないほどであった。","tok":[["イエス"],["が"],["向こう岸","むこうぎし"],["の"],["ガダラ人","がだらにん"],["の"],["地方","ちほう"],["に"],["着かれる","つかれる"],["と"],["、"],["悪霊","あくりょう"],["に"],["取りつかれた","とりつかれた"],["者","もの"],["が"],["二人","ふたり"],["、"],["墓場","はかば"],["から"],["出て","でて"],["イエス"],["の"],["ところ"],["に"],["やって"],["来た","きた"],["。"],["二人","ふたり"],["は"],["非常","ひじょう"],["に"],["狂暴","きょうぼう"],["で"],["、"],["だれ"],["も"],["その"],["辺り","あたり"],["の"],["道","みち"],["を"],["通れない","とおれない"],["ほど"],["で"],["あった"],["。"]]},{"verse":29,"text":"突然、彼らは叫んだ。「神の子、かまわないでくれ。まだ、その時ではないのにここに来て、我々を苦しめるのか。」","tok":[["突然","とつぜん"],["、"],["彼","かれ"],["ら"],["は"],["叫んだ","さけんだ"],["。"],["「"],["神","かみ"],["の"],["子","こ"],["、"],["かまわないで"],["くれ"],["。"],["まだ"],["、"],["その"],["時","とき"],["で"],["は"],["ない"],["のに"],["ここ"],["に"],["来て","きて"],["、"],["我々","われわれ"],["を"],["苦しめる","くるしめる"],["の"],["か"],["。"],["」"]]},{"verse":30,"text":"はるかかなたで多くの豚の群れがえさをあさっていた。","tok":[["はるか"],["かなた"],["で"],["多く","おおく"],["の"],["豚","ぶた"],["の"],["群れ","むれ"],["が"],["えさ"],["を"],["あさって"],["いた"],["。"]]},{"verse":31,"text":"そこで、悪霊どもはイエスに、「我々を追い出すのなら、あの豚の中にやってくれ」と願った。","tok":[["そこ"],["で"],["、"],["悪霊","あくりょう"],["ども"],["は"],["イエス"],["に"],["、"],["「"],["我々","われわれ"],["を"],["追い出す","おいだす"],["の"],["なら"],["、"],["あの"],["豚","ぶた"],["の"],["中","なか"],["に"],["やって"],["くれ"],["」"],["と"],["願った","ねがった"],["。"]]},{"verse":32,"text":"イエスが、「行け」と言われると、悪霊どもは二人から出て、豚の中に入った。すると、豚の群れはみな崖を下って湖になだれ込み、水の中で死んだ。","tok":[["イエス"],["が"],["、"],["「"],["行け","いけ"],["」"],["と"],["言われる","いわれる"],["と"],["、"],["悪霊","あくりょう"],["ども"],["は"],["二人","ふたり"],["から"],["出て","でて"],["、"],["豚","ぶた"],["の"],["中","なか"],["に"],["入った","はいった"],["。"],["する"],["と"],["、"],["豚","ぶた"],["の"],["群れ","むれ"],["は"],["みな"],["崖","がけ"],["を"],["下って","くだって"],["湖","みずうみ"],["に"],["なだれ込み","なだれこみ"],["、"],["水","みず"],["の"],["中","なか"],["で"],["死んだ","しんだ"],["。"]]},{"verse":33,"text":"豚飼いたちは逃げ出し、町に行って、悪霊に取りつかれた者のことなど一切を知らせた。","tok":[["豚飼い","ぶたかい"],["たち"],["は"],["逃げ出し","にげだし"],["、"],["町","まち"],["に"],["行って","いって"],["、"],["悪霊","あくりょう"],["に"],["取りつかれた","とりつかれた"],["者","もの"],["の"],["こと"],["など"],["一切","いっさい"],["を"],["知らせた","しらせた"],["。"]]},{"verse":34,"text":"すると、町中の者がイエスに会おうとしてやって来た。そして、イエスを見ると、その地方から出て行ってもらいたいと言った。","tok":[["する"],["と"],["、"],["町中","まちなか"],["の"],["者","もの"],["が"],["イエス"],["に"],["会おう","あおう"],["として"],["やって"],["来た","きた"],["。"],["そして"],["、"],["イエス"],["を"],["見る","みる"],["と"],["、"],["その"],["地方","ちほう"],["から"],["出て","でて"],["行って","いって"],["もらいたい"],["と"],["言った","いった"],["。"]]}]
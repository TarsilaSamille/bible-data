[{"verse":1,"text":"イエスは舟に乗って湖を渡り、自分の町に帰って来られた。","tok":[["イエス"],["は"],["舟","ふね"],["に"],["乗って","のって"],["湖","みずうみ"],["を"],["渡り","わたり"],["、"],["自分","じぶん"],["の"],["町","まち"],["に"],["帰って","かえって"],["来られた","こられた"],["。"]]},{"verse":2,"text":"すると、人々が中風の人を床に寝かせたまま、イエスのところへ連れて来た。イエスはその人たちの信仰を見て、中風の人に、「子よ、元気を出しなさい。あなたの罪は赦される」と言われた。","tok":[["する"],["と"],["、"],["人々","ひとびと"],["が"],["中風","ちゅうぶ"],["の"],["人","ひと"],["を"],["床","ゆか"],["に"],["寝かせた","ねかせた"],["まま"],["、"],["イエス"],["の"],["ところ"],["へ"],["連れて","つれて"],["来た","きた"],["。"],["イエス"],["は"],["その"],["人","ひと"],["たち"],["の"],["信仰","しんこう"],["を"],["見て","みて"],["、"],["中風","ちゅうぶ"],["の"],["人","ひと"],["に"],["、"],["「"],["子","こ"],["よ"],["、"],["元気","げんき"],["を"],["出し","だし"],["なさい"],["。"],["あなた"],["の"],["罪","つみ"],["は"],["赦される","ゆるされる"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":3,"text":"ところが、律法学者の中に、「この男は神を冒瀆している」と思う者がいた。","tok":[["ところ"],["が"],["、"],["律法学者","りっぽうがくしゃ"],["の"],["中","なか"],["に"],["、"],["「"],["この"],["男","おとこ"],["は"],["神","かみ"],["を"],["冒瀆","ぼうとく"],["して"],["いる"],["」"],["と"],["思う","おもう"],["者","もの"],["が"],["いた"],["。"]]},{"verse":4,"text":"イエスは、彼らの考えを見抜いて言われた。「なぜ、心の中で悪いことを考えているのか。","tok":[["イエス"],["は"],["、"],["彼","かれ"],["ら"],["の"],["考え","かんがえ"],["を"],["見抜いて","みぬいて"],["言われた","いわれた"],["。"],["「"],["なぜ"],["、"],["心","こころ"],["の"],["中","なか"],["で"],["悪い","わるい"],["こと"],["を"],["考えて","かんがえて"],["いる"],["の"],["か"],["。"]]},{"verse":5,"text":"『あなたの罪は赦される』と言うのと、『起きて歩け』と言うのと、どちらが易しいか。","tok":[["『"],["あなた"],["の"],["罪","つみ"],["は"],["赦される","ゆるされる"],["』"],["と"],["言う","いう"],["の"],["と"],["、"],["『"],["起きて","おきて"],["歩け","あるけ"],["』"],["と"],["言う","いう"],["の"],["と"],["、"],["どちら"],["が"],["易しい","やさしい"],["か"],["。"]]},{"verse":6,"text":"人の子が地上で罪を赦す権威を持っていることを知らせよう。」そして、中風の人に、「起き上がって床を担ぎ、家に帰りなさい」と言われた。","tok":[["人","ひと"],["の"],["子","こ"],["が"],["地上","ちじょう"],["で"],["罪","つみ"],["を"],["赦す","ゆるす"],["権威","けんい"],["を"],["持って","もって"],["いる"],["こと"],["を"],["知らせよう","しらせよう"],["。"],["」"],["そして"],["、"],["中風","ちゅうぶ"],["の"],["人","ひと"],["に"],["、"],["「"],["起き上がって","おきあがって"],["床","ゆか"],["を"],["担ぎ","
[{"verse":1,"text":"イエスは、ヘロデ王の時代にユダヤのベツレヘムでお生まれになった。そのとき、占星術の学者たちが東の方からエルサレムに来て、","tok":[["イエス"],["は"],["、"],["ヘロデ"],["王","おう"],["の"],["時代","じだい"],["に"],["ユダヤ"],["の"],["ベツレヘム"],["で"],["お生まれ","おうまれ"],["に"],["なった"],["。"],["その"],["とき"],["、"],["占星術","せんせいじゅつ"],["の"],["学者","がくしゃ"],["たち"],["が"],["東","ひがし"],["の"],["方","ほう"],["から"],["エルサレム"],["に"],["来て","きて"],["、"]]},{"verse":2,"text":"言った。「ユダヤ人の王としてお生まれになった方は、どこにおられますか。わたしたちは東方でその方の星を見たので、拝みに来たのです。」","tok":[["言った","いった"],["。"],["「"],["ユダヤ人","ゆだやじん"],["の"],["王","おう"],["として"],["お生まれ","おうまれ"],["に"],["なった"],["方","ほう"],["は"],["、"],["どこ"],["に"],["おられます"],["か"],["。"],["わたしたち"],["は"],["東方","とうほう"],["で"],["その"],["方","かた"],["の"],["星","ほし"],["を"],["見た","みた"],["ので"],["、"],["拝み","おがみ"],["に"],["来た","きた"],["の"],["です"],["。"],["」"]]},{"verse":3,"text":"これを聞いて、ヘロデ王は不安を抱いた。エルサレムの人々も皆、同様であった。","tok":[["これ"],["を"],["聞いて","きいて"],["、"],["ヘロデ"],["王","おう"],["は"],["不安","ふあん"],["を"],["抱いた","いだいた"],["。"],["エルサレム"],["の"],["人々","ひとびと"],["も"],["皆","みな"],["、"],["同様","どうよう"],["で"],["あった"],["。"]]},{"verse":4,"text":"王は民の祭司長たちや律法学者たちを皆集めて、メシアはどこに生まれることになっているのかと問いただした。","tok":[["王","おう"],["は"],["民","みん"],["の"],["祭司長","さいしちょう"],["たち"],["や"],["律法学者","りっぽうがくしゃ"],["たち"],["を"],["皆","みな"],["集めて","あつめて"],["、"],["メシア"],["は"],["どこ"],["に"],["生まれる","うまれる"],["こと"],["に"],["なって"],["いる"],["の"],["か"],["と"],["問いただした","といただした"],["。"]]},{"verse":5,"text":"彼らは言った。「ユダヤのベツレヘムです。預言者がこう書いています。","tok":[["彼","かれ"],["ら"],["は"],["言った","いった"],["。"],["「"],["ユダヤ"],["の"],["ベツレヘム"],["です"],["。"],["預言者","よげんしゃ"],["が"],["こう"],["書いて","かいて"],["います"],["。"]]},{"verse":6,"text":"『ユダの地、ベツレヘムよ、お前はユダの指導者たちの中で決していちばん小さいものではない。お前から指導者が現れ、わたしの民イスラエルの牧者となるからである。』」","tok":[["『"],["ユダ"],["の"],["地","ち"],["、"],["ベツレヘム"],["よ"],["、"],["お前","おまえ"],["は"],["ユダ"],["の"],["指導者","しどうしゃ"],["たち"],["の"],["中","なか"],["で"],["決して","けっして"],["いちばん"],["小さい","ちいさい"],["もの"],["で"],["は"],["ない"],["。"],["お前","おまえ"],["から"],["指導者","しどうしゃ"],["が"],["現れ","あらわれ"],["、"],["わたし"],["の"],["民","みん"],["イスラエル"],["の"],["牧者","ぼくしゃ"],["と"],["なる"],["から"],["で"],["ある"],["。"],["』"],["」"]]},{"verse":7,"text":"そこで、ヘロデは占星術の学者たちをひそかに呼び寄せ、星の現れた時期を確かめた。","tok":[["そこ"],["で"],["、"],["ヘロデ"],["は"],["占星術","せんせいじゅつ"],["の"],["学者","がくしゃ"],["たち"],["を"],["ひそか"],["に"],["呼び寄せ","よびよせ"],["、"],["星","ほし"],["の"],["現れた","あらわれた"],["時期","じき"],["を"],["確かめた","たしかめた"],["。"]]},{"verse":8,"text":"そして、「行って、その子のことを詳しく調べ、見つかったら知らせてくれ。わたしも行って拝もう」と言ってベツレヘムへ送り出した。","tok":[["そして"],["、"],["「"],["行って","いって"],["、"],["その"],["子","こ"],["の"],["こと"],["を"],["詳しく","くわしく"],["調べ","しらべ"],["、"],["見つかったら","みつかったら"],["知らせて","しらせて"],["くれ"],["。"],["わたし"],["も"],["行って","いって"],["拝もう","おがもう"],["」"],["と"],["言って","いって"],["ベツレヘム"],["へ"],["送り出した","おくりだした"],["。"]]},{"verse":9,"text":"彼らが王の言葉を聞いて出かけると、東方で見た星が先立って進み、ついに幼子のいる場所の上に止まった。","tok":[["彼","かれ"],["ら"],["が"],["王","おう"],["の"],["言葉","ことば"],["を"],["聞いて","きいて"],["出かける","でかける"],["と"],["、"],["東方","とうほう"],["で"],["見た","みた"],["星","ほし"],["が"],["先立って","さきだって"],["進み","すすみ"],["、"],["ついに"],["幼子","おさなご"],["の"],["いる"],["場所","ばしょ"],["の"],["上","うえ"],["に"],["止まった","とまった"],["。"]]},{"verse":10,"text":"学者たちはその星を見て喜びにあふれた。","tok":[["学者","がくしゃ"],["たち"],["は"],["その"],["星","ほし"],["を"],["見て","みて"],["喜び","よろこび"],["に"],["あふれた"],["。"]]},{"verse":11,"text":"家に入ってみると、幼子は母マリアと共におられた。彼らはひれ伏して幼子を拝み、宝の箱を開けて、黄金、乳香、没薬を贈り物として献げた。","tok":[["家","いえ"],["に"],["入って","はいって"],["みる"],["と"],["、"],["幼子","おさなご"],["は"],["母","はは"],["マリア"],["と"],["共","とも"],["に"],["おられた"],["。"],["彼","かれ"],["ら"],["は"],["ひれ伏して","ひれふして"],["幼子","おさなご"],["を"],["拝み","おがみ"],["、"],["宝","たから"],["の"],["箱","ばこ"],["を"],["開けて","あけて"],["、"],["黄金","おうごん"],["、"],["乳香","にゅうこう"],["、"],["没薬","もつやく"],["を"],["贈り物","おくりもの"],["として"],["献げた","ささげた"],["。"]]},{"verse":12,"text":"ところが、「ヘロデのところへ帰るな」と夢でお告げがあったので、別の道を通って自分たちの国へ帰って行った。","tok":[["ところ"],["が"],["、"],["「"],["ヘロデ"],["の"],["ところ"],["へ"],["帰る","かえる"],["な"],["」"],["と"],["夢","ゆめ"],["で"],["お告げ","おつげ"],["が"],["あった"],["ので"],["、"],["別","べつ"],["の"],["道","みち"],["を"],["通って","とおって"],["自分","じぶん"],["たち"],["の"],["国","くに"],["へ"],["帰って","かえって"],["行った","いった"],["。"]]},{"verse":13,"text":"占星術の学者たちが帰って行くと、主の天使が夢でヨセフに現れて言った。「起きて、子供とその母親を連れて、エジプトに逃げ、わたしが告げるまで、そこにとどまっていなさい。ヘロデが、この子を探し出して殺そうとしている。」","tok":[["占星術","せんせいじゅつ"],["の"],["学者","がくしゃ"],["たち"],["が"],["帰って","かえって"],["行く","いく"],["と"],["、"],["主","ぬし"],["の"],["天使","てんし"],["が"],["夢","ゆめ"],["で"],["ヨセフ"],["に"],["現れて","あらわれて"],["言った","いった"],["。"],["「"],["起きて","おきて"],["、"],["子供","こども"],["と"],["その"],["母親","ははおや"],["を"],["連れて","つれて"],["、"],["エジプト"],["に"],["逃げ","にげ"],["、"],["わたし"],["が"],["告げる","つげる"],["まで"],["、"],["そこ"],["に"],["とどまって"],["い"],["なさい"],["。"],["ヘロデ"],["が"],["、"],["この"],["子","こ"],["を"],["探し出して","さがしだして"],["殺そう","ころそう"],["として"],["いる"],["。"],["」"]]},{"verse":14,"text":"ヨセフは起きて、夜のうちに幼子とその母を連れてエジプトへ去り、","tok":[["ヨセフ"],["は"],["起きて","おきて"],["、"],["夜","よる"],["の"],["うち"],["に"],["幼子","おさなご"],["と"],["その"],["母","はは"],["を"],["連れて","つれて"],["エジプト"],["へ"],["去り","さり"],["、"]]},{"verse":15,"text":"ヘロデが死ぬまでそこにいた。それは、「わたしは、エジプトからわたしの子を呼び出した」と、主が預言者を通して言われていたことが実現するためであった。","tok":[["ヘロデ"],["が"],["死ぬ","しぬ"],["まで"],["そこ"],["に"],["いた"],["。"],["それ"],["は"],["、"],["「"],["わたし"],["は"],["、"],["エジプト"],["から"],["わたし"],["の"],["子","こ"],["を"],["呼び出した","よびだした"],["」"],["と"],["、"],["主","ぬし"],["が"],["預言者","よげんしゃ"],["を"],["通して","とおして"],["言われて","いわれて"],["いた"],["こと"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":16,"text":"さて、ヘロデは占星術の学者たちにだまされたと知って、大いに怒った。そして、人を送り、学者たちに確かめておいた時期に基づいて、ベツレヘムとその周辺一帯にいた二歳以下の男の子を、一人残らず殺させた。","tok":[["さて"],["、"],["ヘロデ"],["は"],["占星術","せんせいじゅつ"],["の"],["学者","がくしゃ"],["たち"],["に"],["だまされた"],["と"],["知って","しって"],["、"],["大いに","おおいに"],["怒った","おこった"],["。"],["そして"],["、"],["人","ひと"],["を"],["送り","おくり"],["、"],["学者","がくしゃ"],["たち"],["に"],["確かめて","たしかめて"],["おいた"],["時期","じき"],["に"],["基づいて","もとづいて"],["、"],["ベツレヘム"],["と"],["その"],["周辺","しゅうへん"],["一帯","いったい"],["に"],["いた"],["二歳","にさい"],["以下","いか"],["の"],["男の子","おとこのこ"],["を"],["、"],["一人","ひとり"],["残らず","のこらず"],["殺させた","ころさせた"],["。"]]},{"verse":17,"text":"こうして、預言者エレミヤを通して言われていたことが実現した。","tok":[["こう"],["して"],["、"],["預言者","よげんしゃ"],["エレミヤ"],["を"],["通して","とおして"],["言われて","いわれて"],["いた"],["こと"],["が"],["実現","じつげん"],["した"],["。"]]},{"verse":18,"text":"「ラマで声が聞こえた。激しく嘆き悲しむ声だ。ラケルは子供たちのことで泣き、慰めてもらおうともしない、子供たちがもういないから。」","tok":[["「"],["ラマ"],["で"],["声","こえ"],["が"],["聞こえた","きこえた"],["。"],["激しく","はげしく"],["嘆き悲しむ","なげきかなしむ"],["声","こえ"],["だ"],["。"],["ラケル"],["は"],["子供","こども"],["たち"],["の"],["こと"],["で"],["泣き","なき"],["、"],["慰めて","なぐさめて"],["もらおう"],["と"],["も"],["しない"],["、"],["子供","こども"],["たち"],["が"],["もう"],["いない"],["から"],["。"],["」"]]},{"verse":19,"text":"ヘロデが死ぬと、主の天使がエジプトにいるヨセフに夢で現れて、","tok":[["ヘロデ"],["が"],["死ぬ","しぬ"],["と"],["、"],["主","ぬし"],["の"],["天使","てんし"],["が"],["エジプト"],["に"],["いる"],["ヨセフ"],["に"],["夢","ゆめ"],["で"],["現れて","あらわれて"],["、"]]},{"verse":20,"text":"言った。「起きて、子供とその母親を連れ、イスラエルの地に行きなさい。この子の命をねらっていた者どもは、死んでしまった。」","tok":[["言った","いった"],["。"],["「"],["起きて","おきて"],["、"],["子供","こども"],["と"],["その"],["母親","ははおや"],["を"],["連れ","つれ"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["行き","いき"],["なさい"],["。"],["この"],["子","こ"],["の"],["命","いのち"],["を"],["ねらって"],["いた"],["者","もの"],["ども"],["は"],["、"],["死んで","しんで"],["しまった"],["。"],["」"]]},{"verse":21,"text":"そこで、ヨセフは起きて、幼子とその母を連れて、イスラエルの地へ帰って来た。","tok":[["そこ"],["で"],["、"],["ヨセフ"],["は"],["起きて","おきて"],["、"],["幼子","おさなご"],["と"],["その"],["母","はは"],["を"],["連れて","つれて"],["、"],["イスラエル"],["の"],["地","ち"],["へ"],["帰って","かえって"],["来た","きた"],["。"]]},{"verse":22,"text":"しかし、アルケラオが父ヘロデの跡を継いでユダヤを支配していると聞き、そこに行くことを恐れた。ところが、夢でお告げがあったので、ガリラヤ地方に引きこもり、","tok":[["しかし"],["、"],["アルケラオ"],["が"],["父","ちち"],["ヘロデ"],["の"],["跡","あと"],["を"],["継いで","ついで"],["ユダヤ"],["を"],["支配","しはい"],["して"],["いる"],["と"],["聞き","きき"],["、"],["そこ"],["に"],["行く","いく"],["こと"],["を"],["恐れた","おそれた"],["。"],["ところ"],["が"],["、"],["夢","ゆめ"],["で"],["お告げ","おつげ"],["が"],["あった"],["ので"],["、"],["ガリラヤ"],["地方","ちほう"],["に"],["引きこもり","ひきこもり"],["、"]]},{"verse":23,"text":"ナザレという町に行って住んだ。「彼はナザレの人と呼ばれる」と、預言者たちを通して言われていたことが実現するためであった。","tok":[["ナザレ"],["と"],["いう"],["町","まち"],["に"],["行って","いって"],["住んだ","すんだ"],["。"],["「"],["彼","かれ"],["は"],["ナザレ"],["の"],["人","ひと"],["と"],["呼ばれる","よばれる"],["」"],["と"],["、"],["預言者","よげんしゃ"],["たち"],["を"],["通して","とおして"],["言われて","いわれて"],["いた"],["こと"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"]]}]
[{"verse":1,"text":"さて、安息日が終わって、週の初めの日の明け方に、マグダラのマリアともう一人のマリアが、墓を見に行った。","tok":[["さて"],["、"],["安息日","あんそくび"],["が"],["終わって","おわって"],["、"],["週","しゅう"],["の"],["初め","はじめ"],["の"],["日","ひ"],["の"],["明け方","あけがた"],["に"],["、"],["マグダラ"],["の"],["マリア"],["と"],["もう"],["一人","ひとり"],["の"],["マリア"],["が"],["、"],["墓","はか"],["を"],["見","み"],["に"],["行った","いった"],["。"]]},{"verse":2,"text":"すると、大きな地震が起こった。主の天使が天から降って近寄り、石をわきへ転がし、その上に座ったのである。","tok":[["する"],["と"],["、"],["大きな","おおきな"],["地震","じしん"],["が"],["起こった","おこった"],["。"],["主","ぬし"],["の"],["天使","てんし"],["が"],["天","てん"],["から"],["降って","ふって"],["近寄り","ちかより"],["、"],["石","いし"],["を"],["わき"],["へ"],["転がし","ころがし"],["、"],["その"],["上","うえ"],["に"],["座った","すわった"],["ので"],["ある"],["。"]]},{"verse":3,"text":"その姿は稲妻のように輝き、衣は雪のように白かった。","tok":[["その"],["姿","すがた"],["は"],["稲妻","いなずま"],["の"],["よう"],["に"],["輝き","かがやき"],["、"],["衣","ころも"],["は"],["雪","ゆき"],["の"],["よう"],["に"],["白かった","しろかった"],["。"]]},{"verse":4,"text":"番兵たちは、恐ろしさのあまり震え上がり、死人のようになった。","tok":[["番兵","ばんぺい"],["たち"],["は"],["、"],["恐ろし","おそろし"],["さ"],["の"],["あまり"],["震え上がり","ふるえあがり"],["、"],["死人","しにん"],["の"],["よう"],["に"],["なった"],["。"]]},{"verse":5,"text":"天使は婦人たちに言った。「恐れることはない。十字架につけられたイエスを捜しているのだろうが、","tok":[["天使","てんし"],["は"],["婦人","ふじん"],["たち"],["に"],["言った","いった"],["。"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["十字架","じゅうじか"],["に"],["つけられた"],["イエス"],["を"],["捜して","さがして"],["いる"],["の"],["だろう"],["が"],["、"]]},{"verse":6,"text":"あの方は、ここにはおられない。かねて言われていたとおり、復活なさったのだ。さあ、遺体の置いてあった場所を見なさい。","tok":[["あの"],["方","かた"],["は"],["、"],["ここ"],["に"],["は"],["おられない"],["。"],["かねて"],["言われて","いわれて"],["いた"],["とおり"],["、"],["復活","ふっかつ"],["なさった"],["の"],["だ"],["。"],["さあ"],["、"],["遺体","いたい"],["の"],["置いて","おいて"],["あった"],["場所","ばしょ"],["を"],["見","み"],["なさい"],["。"]]},{"verse":7,"text":"それから、急いで行って弟子たちにこう告げなさい。『あの方は死者の中から復活された。そして、あなたがたより先にガリラヤに行かれる。そこでお目にかかれる。』確かに、あなたがたに伝えました。」","tok":[["それ"],["から"],["、"],["急いで","いそいで"],["行って","いって"],["弟子","でし"],["たち"],["に"],["こう"],["告げ","つげ"],["なさい"],["。"],["『"],["あの"],["方","かた"],["は"],["死者","ししゃ"],["の"],["中","なか"],["から"],["復活","ふっかつ"],["された"],["。"],["そして"],["、"],["あなた"],["が"],["たより"],["先","さき"],["に"],["ガリラヤ"],["に"],["行かれる","いかれる"],["。"],["そこ"],["で"],["お目","おめ"],["に"],["かかれる"],["。"],["』"],["確か","たしか"],["に"],["、"],["あなた"],["がた"],["に"],["伝えました","つたえました"],["。"],["」"]]},{"verse":8,"text":"婦人たちは、恐れながらも大いに喜び、急いで墓を立ち去り、弟子たちに知らせるために走って行った。","tok":[["婦人","ふじん"],["たち"],["は"],["、"],["恐れ","おそれ"],["ながら"],["も"],["大いに","おおいに"],["喜び","よろこび"],["、"],["急いで","いそいで"],["墓","はか"],["を"],["立ち去り","たちさり"],["、"],["弟子","でし"],["たち"],["に"],["知らせる","しらせる"],["ため"],["に"],["走って","はしって"],["行った","いった"],["。"]]},{"verse":9,"text":"すると、イエスが行く手に立っていて、「おはよう」と言われたので、婦人たちは近寄り、イエスの足を抱き、その前にひれ伏した。","tok":[["する"],["と"],["、"],["イエス"],["が"],["行く手","ゆくて"],["に"],["立って","たって"],["いて"],["、"],["「"],["おはよう"],["」"],["と"],["言われた","いわれた"],["ので"],["、"],["婦人","ふじん"],["たち"],["は"],["近寄り","ちかより"],["、"],["イエス"],["の"],["足","あし"],["を"],["抱き","いだき"],["、"],["その"],["前","まえ"],["に"],["ひれ伏した","ひれふした"],["。"]]},{"verse":10,"text":"イエスは言われた。「恐れることはない。行って、わたしの兄弟たちにガリラヤへ行くように言いなさい。そこでわたしに会うことになる。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["恐れる","おそれる"],["こと"],["は"],["ない"],["。"],["行って","いって"],["、"],["わたし"],["の"],["兄弟","きょうだい"],["たち"],["に"],["ガリラヤ"],["へ"],["行く","いく"],["よう"],["に"],["言い","いい"],["なさい"],["。"],["そこ"],["で"],["わたし"],["に"],["会う","あう"],["こと"],["に"],["なる"],["。"],["」"]]},{"verse":11,"text":"婦人たちが行き着かないうちに、数人の番兵は都に帰り、この出来事をすべて祭司長たちに報告した。","tok":[["婦人","ふじん"],["たち"],["が"],["行き着かない","いきつかない"],["うち"],["に"],["、"],["数人","すうにん"],["の"],["番兵","ばんぺい"],["は"],["都","と"],["に"],["帰り","かえり"],["、"],["この"],["出来事","できごと"],["を"],["すべて"],["祭","まつり"],["司長","しちょう"],["たち"],["に"],["報告","ほうこく"],["した"],["。"]]},{"verse":12,"text":"そこで、祭司長たちは長老たちと集まって相談し、兵士たちに多額の金を与えて、","tok":[["そこ"],["で"],["、"],["祭司長","さいしちょう"],["たち"],["は"],["長老","ちょうろう"],["たち"],["と"],["集まって","あつまって"],["相談","そうだん"],["し"],["、"],["兵士","へいし"],["たち"],["に"],["多額","たがく"],["の"],["金","かね"],["を"],["与えて","あたえて"],["、"]]},{"verse":13,"text":"言った。「『弟子たちが夜中にやって来て、我々の寝ている間に死体を盗んで行った』と言いなさい。","tok":[["言った","いった"],["。"],["「"],["『"],["弟子","でし"],["たち"],["が"],["夜中","よなか"],["に"],["やって"],["来て","きて"],["、"],["我々","われわれ"],["の"],["寝て","ねて"],["いる"],["間","あいだ"],["に"],["死体","したい"],["を"],["盗んで","ぬすんで"],["行った","いった"],["』"],["と"],["言い","いい"],["なさい"],["。"]]},{"verse":14,"text":"もしこのことが総督の耳に入っても、うまく総督を説得して、あなたがたには心配をかけないようにしよう。」","tok":[["もし"],["この"],["こと"],["が"],["総督","そうとく"],["の"],["耳","みみ"],["に"],["入って","はいって"],["も"],["、"],["うまく"],["総督","そうとく"],["を"],["説得","せっとく"],["して"],["、"],["あなた"],["がた"],["に"],["は"],["心配","しんぱい"],["を"],["かけない"],["よう"],["に"],["しよう"],["。"],["」"]]},{"verse":15,"text":"兵士たちは金を受け取って、教えられたとおりにした。この話は、今日に至るまでユダヤ人の間に広まっている。","tok":[["兵士","へいし"],["たち"],["は"],["金","きん"],["を"],["受け取って","うけとって"],["、"],["教えられた","おしえられた"],["とおり"],["に"],["した"],["。"],["この"],["話","はなし"],["は"],["、"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["ユダヤ人","ゆだやじん"],["の"],["間","あいだ"],["に"],["広まって","ひろまって"],["いる"],["。"]]},{"verse":16,"text":"さて、十一人の弟子たちはガリラヤに行き、イエスが指示しておかれた山に登った。","tok":[["さて"],["、"],["十一人","じゅういちにん"],["の"],["弟子","でし"],["たち"],["は"],["ガリラヤ"],["に"],["行き","いき"],["、"],["イエス"],["が"],["指示","しじ"],["して"],["おかれた"],["山","やま"],["に"],["登った","のぼった"],["。"]]},{"verse":17,"text":"そして、イエスに会い、ひれ伏した。しかし、疑う者もいた。","tok":[["そして"],["、"],["イエス"],["に"],["会い","あい"],["、"],["ひれ伏した","ひれふした"],["。"],["しかし"],["、"],["疑う","うたがう"],["者","もの"],["も"],["いた"],["。"]]},{"verse":18,"text":"イエスは、近寄って来て言われた。「わたしは天と地の一切の権能を授かっている。","tok":[["イエス"],["は"],["、"],["近寄って","ちかよって"],["来て","きて"],["言われた","いわれた"],["。"],["「"],["わたし"],["は"],["天","てん"],["と"],["地","ち"],["の"],["一切","いっさい"],["の"],["権能","けんのう"],["を"],["授かって","さずかって"],["いる"],["。"]]},{"verse":19,"text":"だから、あなたがたは行って、すべての民をわたしの弟子にしなさい。彼らに父と子と聖霊の名によって洗礼を授け、","tok":[["だ"],["から"],["、"],["あなた"],["がた"],["は"],["行って","いって"],["、"],["すべて"],["の"],["民","たみ"],["を"],["わたし"],["の"],["弟子","でし"],["に"],["し"],["なさい"],["。"],["彼","かれ"],["ら"],["に"],["父","ちち"],["と"],["子","こ"],["と"],["聖霊","せいれい"],["の"],["名","な"],["によって"],["洗礼","せんれい"],["を"],["授け","さずけ"],["、"]]},{"verse":20,"text":"あなたがたに命じておいたことをすべて守るように教えなさい。わたしは
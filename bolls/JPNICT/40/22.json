],["、"],["一緒","いっしょ"],["に"],["集まった","あつまった"],["。"]]},{"verse":35,"text":"そのうちの一人、律法の専門家が、イエスを試そうとして尋ねた。","tok":[["その"],["うち"],["の"],["一人","ひとり"],["、"],["律法","りっぽう"],["の"],["専門家","せんもんか"],["が"],["、"],["イエス"],["を"],["試そう","ためそう"],["として"],["尋ねた","たずねた"],["。"]]},{"verse":36,"text":"「先生、律法の中で、どの掟が最も重要でしょうか。」","tok":[["「"],["先生","せんせい"],["、"],["律法","りっぽう"],["の"],["中","なか"],["で"],["、"],["どの"],["掟","おきて"],["が"],["最も","もっとも"],["重要","じゅうよう"],["でしょう"],["か"],["。"],["」"]]},{"verse":37,"text":"イエスは言われた。「『心を尽くし、精神を尽くし、思いを尽くして、あなたの神である主を愛しなさい。』","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["『"],["心","こころ"],["を"],["尽くし","つくし"],["、"],["精神","せいしん"],["を"],["尽くし","つくし"],["、"],["思い","おもい"],["を"],["尽くして","つくして"],["、"],["あなた"],["の"],["神","かみ"],["で"],["ある"],["主","ぬし"],["を"],["愛し","あいし"],["なさい"],["。"],["』"]]},{"verse":38,"text":"これが最も重要な第一の掟である。","tok":[["これ"],["が"],["最も","もっとも"],["重要","じゅうよう"],["な"],["第","だい"],["一","いち"],["の"],["掟","おきて"],["で"],["ある"],["。"]]},{"verse":39,"text":"第二も、これと同じように重要である。『隣人を自分のように愛しなさい。』","tok":[["第","だい"],["二","に"],["も"],["、"],["これ"],["と"],["同じ","おなじ"],["よう"],["に"],["重要","じゅうよう"],["で"],["ある"],["。"],["『"],["隣人","りんじん"],["を"],["自分","じぶん"],["の"],["よう"],["に"],["愛し","あいし"],["なさい"],["。"],["』"]]},{"verse":40,"text":"律法全体と預言者は、この二つの掟に基づいている。」","tok":[["律法","りっぽう"],["全体","ぜんたい"],["と"],["預言者","よげんしゃ"],["は"],["、"],["この"],["二","ふた"],["つ"],["の"],["掟","おきて"],["に"],["基づいて","もとづいて"],["いる"],["。"],["」"]]},{"verse":41,"text":"ファリサイ派の人々が集まっていたとき、イエスはお尋ねになった。","tok":[["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["が"],["集まって","あつまって"],["いた"],["とき"],["、"],["イエス"],["は"],["お尋ね","おたずね"],["に"],["なった"],["。"]]},{"verse":42,"text":"「あなたたちはメシアのことをどう思うか。だれの子だろうか。」彼らが、「ダビデの子です」と言うと、","tok":[["「"],["あなた"],["たち"],["は"],["メシア"],["の"],["こと"],["を"],["どう"],["思う","おもう"],["か"],["。"],["だれ"],["の"],["子","こ"],["だろう"],["か"],["。"],["」"],["彼","かれ"],["ら"],["が"],["、"],["「"],["ダビデ"],["の"],["子","こ"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"]]},{"verse":43,"text":"イエスは言われた。「では、どうしてダビデは、霊を受けて、メシアを主と呼んでいるのだろうか。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["で"],["は"],["、"],["どう"],["して"],["ダビデ"],["は"],["、"],["霊","れい"],["を"],["受けて","うけて"],["、"],["メシア"],["を"],["主","ぬし"],["と"],["呼んで","よんで"],["いる"],["の"],["だろう"],["か"],["。"]]},{"verse":44,"text":"『主は、わたしの主にお告げになった。「わたしの右の座に着きなさい、わたしがあなたの敵をあなたの足もとに屈服させるときまで」と。』","tok":[["『"],["主","ぬし"],["は"],["、"],["わたし"],["の"],["主に","おもに"],["お告げ","おつげ"],["に"],["なった"],["。"],["「"],["わたし"],["の"],["右","みぎ"],["の"],["座","ざ"],["に"],["着き","つき"],["なさい"],["、"],["わたし"],["が"],["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["足もと","あしもと"],["に"],["屈服","くっぷく"],["させる"],["とき"],["まで"],["」"],["と"],["。"],["』"]]},{"verse":45,"text":"このようにダビデがメシアを主と呼んでいるのであれば、どうしてメシアがダビデの子なのか。」","tok":[["この"],["よう"],["に"],["ダビデ"],["が"],["メシア"],["を"],["主","ぬし"],["と"],["呼んで","よんで"],["いる"],["ので"],["あれば"],["、"],["どう"],["して"],["メシア"],["が"],["ダビデ"],["の"],["子","こ"],["な"],["の"],["か"],["。"],["」"]]},{"verse":46,"text":"これにはだれ一人、ひと言も言い返すことができず、その日からは、もはやあえて質問する者はなかった。","tok":[["これ"],["に"],["は"],["だれ"],["一人","ひとり"],["、"],["ひと言","ひとこと"],["も"],["言い返す","いいかえす"],["こと"],["が"],["できず"],["、"],["その"],["日","ひ"],["から"],["は"],["、"],["もはや"],["あえて"],["質問","しつもん"],["する"],["者","もの"],["は"],["なかった"],["。"]]}]
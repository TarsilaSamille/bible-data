[{"verse":1,"text":"イエスは、また、たとえを用いて語られた。","tok":[["イエス"],["は"],["、"],["また"],["、"],["たとえ"],["を"],["用いて","もちいて"],["語られた","かたられた"],["。"]]},{"verse":2,"text":"「天の国は、ある王が王子のために婚宴を催したのに似ている。","tok":[["「"],["天","てん"],["の"],["国","くに"],["は"],["、"],["ある"],["王","おう"],["が"],["王子","おうじ"],["の"],["ため"],["に"],["婚","こん"],["宴","えん"],["を"],["催した","もよおした"],["のに"],["似て","にて"],["いる"],["。"]]},{"verse":3,"text":"王は家来たちを送り、婚宴に招いておいた人々を呼ばせたが、来ようとしなかった。","tok":[["王","おう"],["は"],["家来","けらい"],["たち"],["を"],["送り","おくり"],["、"],["婚","こん"],["宴","えん"],["に"],["招いて","まねいて"],["おいた"],["人々","ひとびと"],["を"],["呼ばせた","よばせた"],["が"],["、"],["来よう","こよう"],["と"],["しなかった"],["。"]]},{"verse":4,"text":"そこでまた、次のように言って、別の家来たちを使いに出した。『招いておいた人々にこう言いなさい。「食事の用意が整いました。牛や肥えた家畜を屠って、すっかり用意ができています。さあ、婚宴においでください。」』","tok":[["そこ"],["で"],["また"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言って","いって"],["、"],["別","べつ"],["の"],["家来","けらい"],["たち"],["を"],["使い","つかい"],["に"],["出した","だした"],["。"],["『"],["招いて","まねいて"],["おいた"],["人々","ひとびと"],["に"],["こう"],["言い","いい"],["なさい"],["。"],["「"],["食事","しょくじ"],["の"],["用意","ようい"],["が"],["整いました","ととのいました"],["。"],["牛","うし"],["や"],["肥えた","こえた"],["家畜","かちく"],["を"],["屠って","ほふって"],["、"],["すっかり"],["用意","ようい"],["が"],["できて"],["います"],["。"],["さあ"],["、"],["婚","こん"],["宴","えん"],["に"],["おいで"],["ください"],["。"],["」"],["』"]]},{"verse":5,"text":"しかし、人々はそれを無視し、一人は畑に、一人は商売に出かけ、","tok":[["しかし"],["、"],["人々","ひとびと"],["は"],["それ"],["を"],["無視","むし"],["し"],["、"],["一人","ひとり"],["は"],["畑","はたけ"],["に"],["、"],["一人","ひとり"],["は"],["商売","しょうばい"],["に"],["出かけ","でかけ"],["、"]]},{"verse":6,"text":"また、他の人々は王の家来たちを捕まえて乱暴し、殺してしまった。","tok":[["また"],["、"],["他","た"],["の"],["人々","ひとびと"],["は"],["王","おう"],["の"],["家来","けらい"],["たち"],["を"],["捕まえて","つかまえて"],["乱暴","らんぼう"],["し"],["、"],["殺して","ころして"],["しまった"],["。"]]},{"verse":7,"text":"そこで、王は怒り、軍隊を送って、この人殺しどもを滅ぼし、その町を焼き払った。","tok":[["そこ"],["で"],["、"],["王","おう"],["は"],["怒り","おこり"],["、"],["軍隊","ぐんたい"],["を"],["送って","おくって"],["、"],["この"],["人殺し","ひとごろし"],["ども"],["を"],["滅ぼし","ほろぼし"],["、"],["その"],["町","まち"],["を"],["焼き払った","やきはらった"],["。"]]},{"verse":8,"text":"そして、家来たちに言った。『婚宴の用意はできているが、招いておいた人々は、ふさわしくなかった。","tok":[["そして"],["、"],["家来","けらい"],["たち"],["に"],["言った","いった"],["。"],["『"],["婚","こん"],["宴","えん"],["の"],["用意","ようい"],["は"],["できて"],["いる"],["が"],["、"],["招いて","まねいて"],["おいた"],["人々","ひとびと"],["は"],["、"],["ふさわしく"],["なかった"],["。"]]},{"verse":9,"text":"だから、町の大通りに出て、見かけた者はだれでも婚宴に連れて来なさい。』","tok":[["だ"],["から"],["、"],["町","まち"],["の"],["大通り","おおどおり"],["に"],["出て","でて"],["、"],["見かけた","みかけた"],["者","もの"],["は"],["だれ"],["で"],["も"],["婚","こん"],["宴","えん"],["に"],["連れて","つれて"],["来","き"],["なさい"],["。"],["』"]]},{"verse":10,"text":"そこで、家来たちは通りに出て行き、見かけた人は善人も悪人も皆集めて来たので、婚宴は客でいっぱいになった。","tok":[["そこ"],["で"],["、"],["家来","けらい"],["たち"],["は"],["通り","とおり"],["に"],["出て","でて"],["行き","いき"],["、"],["見かけた","みかけた"],["人","ひと"],["は"],["善人","ぜんにん"],["も"],["悪人","あくにん"],["も"],["皆","みな"],["集めて","あつめて"],["来た","きた"],["ので"],["、"],["婚","こん"],["宴","えん"],["は"],["客","きゃく"],["で"],["いっぱい"],["に"],["なった"],["。"]]},{"verse":11,"text":"王が客を見ようと入って来ると、婚礼の礼服を着ていない者が一人いた。","tok":[["王","おう"],["が"],["客","きゃく"],["を"],["見よう","みよう"],["と"],["入って","はいって"],["来る","くる"],["と"],["、"],["婚礼","こんれい"],["の"],["礼服","れいふく"],["を"],["着て","きて"],["いない"],["者","もの"],["が"],["一人","ひとり"],["いた"],["。"]]},{"verse":12,"text":"王は、『友よ、どうして礼服を着ないでここに入って来たのか』と言った。この者が黙っていると、","tok":[["王","おう"],["は"],["、"],["『"],["友","とも"],["よ"],["、"],["どう"],["して"],["礼服","れいふく"],["を"],["着ないで","きないで"],["ここ"],["に"],["入って","はいって"],["来た","きた"],["の"],["か"],["』"],["と"],["言った","いった"],["。"],["この"],["者","もの"],["が"],["黙って","だまって"],["いる"],["と"],["、"]]},{"verse":13,"text":"王は側近の者たちに言った。『この男の手足を縛って、外の暗闇にほうり出せ。そこで泣きわめいて歯ぎしりするだろう。』","tok":[["王","おう"],["は"],["側近","そっきん"],["の"],["者","もの"],["たち"],["に"],["言った","いった"],["。"],["『"],["この"],["男","おとこ"],["の"],["手足","てあし"],["を"],["縛って","しばって"],["、"],["外","そと"],["の"],["暗闇","くらやみ"],["に"],["ほうり出せ","ほうりだせ"],["。"],["そこ"],["で"],["泣きわめいて","なきわめいて"],["歯ぎしり","はぎしり"],["するだろう"],["。"],["』"]]},{"verse":14,"text":"招かれる人は多いが、選ばれる人は少ない。」","tok":[["招かれる","まねかれる"],["人","ひと"],["は"],["多い","おおい"],["が"],["、"]
,["を"],["軽んじる","かろんじる"],["か"],["、"],["どちら"],["か"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["、"],["神","かみ"],["と"],["富","とみ"],["と"],["に"],["仕える","つかえる"],["こと"],["は"],["できない"],["。"],["」"]]},{"verse":25,"text":"「だから、言っておく。自分の命のことで何を食べようか何を飲もうかと、また自分の体のことで何を着ようかと思い悩むな。命は食べ物よりも大切であり、体は衣服よりも大切ではないか。","tok":[["「"],["だ"],["から"],["、"],["言って","いって"],["おく"],["。"],["自分","じぶん"],["の"],["命","いのち"],["の"],["こと"],["で"],["何","なん"],["を"],["食べよう","たべよう"],["か"],["何","なん"],["を"],["飲もう","のもう"],["か"],["と"],["、"],["また"],["自分","じぶん"],["の"],["体","からだ"],["の"],["こと"],["で"],["何","なん"],["を"],["着よう","きよう"],["か"],["と"],["思い悩む","おもいなやむ"],["な"],["。"],["命","いのち"],["は"],["食べ物","たべもの"],["より"],["も"],["大切","たいせつ"],["で"],["あり"],["、"],["体","からだ"],["は"],["衣服","いふく"],["より"],["も"],["大切","たいせつ"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":26,"text":"空の鳥をよく見なさい。種も蒔かず、刈り入れもせず、倉に納めもしない。だが、あなたがたの天の父は鳥を養ってくださる。あなたがたは、鳥よりも価値あるものではないか。","tok":[["空","そら"],["の"],["鳥","とり"],["を"],["よく"],["見","み"],["なさい"],["。"],["種","しゅ"],["も"],["蒔かず","まかず"],["、"],["刈り入れ","かりいれ"],["も"],["せず"],["、"],["倉","くら"],["に"],["納め","おさめ"],["も"],["しない"],["。"],["だ"],["が"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["は"],["鳥","とり"],["を"],["養って","やしなって"],["くださる"],["。"],["あなた"],["がた"],["は"],["、"],["鳥","とり"],["より"],["も"],["価値","かち"],["ある"],["もの"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":27,"text":"あなたがたのうちだれが、思い悩んだからといって、寿命をわずかでも延ばすことができようか。","tok":[["あなた"],["がた"],["の"],["うち"],["だれ"],["が"],["、"],["思い悩んだ","おもいなやんだ"],["から"],["と"],["いって"],["、"],["寿命","じゅみょう"],["を"],["わずか"],["で"],["も"],["延ばす","のばす"],["こと"],["が"],["できよう"],["か"],["。"]]},{"verse":28,"text":"なぜ、衣服のことで思い悩むのか。野の花がどのように育つのか、注意して見なさい。働きもせず、紡ぎもしない。","tok":[["なぜ"],["、"],["衣服","いふく"],["の"],["こと"],["で"],["思い悩む","おもいなやむ"],["の"],["か"],["。"],["野","の"],["の"],["花","はな"],["が"],["どの"],["よう"],["に"],["育つ","そだつ"],["の"],["か"],["、"],["注意","ちゅうい"],["して"],["見","み"],["なさい"],["。"],["働き","はたらき"],["も"],["せず"],["、"],["紡ぎ","つむぎ"],["も"],["しない"],["。"]]},{"verse":29,"text":"しかし、言っておく。栄華を極めたソロモンでさえ、この花の一つほどにも着飾ってはいなかった。","tok":[["しかし"],["、"],["言って","いって"],["おく"],["。"],["栄華","えいが"],["を"],["極めた","きわめた"],["ソロモン"],["で"],["さえ"],["、"],["この"],["花","はな"],["の"],["一","ひと"],["つ"],["ほど"],["に"],["も"],["着飾って","きかざって"],["は"],["いなかった"],["。"]]},{"verse":30,"text":"今日は生えていて、明日は炉に投げ込まれる野の草でさえ、神はこのように装ってくださる。まして、あなたがたにはなおさらのことではないか、信仰の薄い者たちよ。","tok":[["今日","きょう"],["は"],["生えて","はえて"],["いて"],["、"],["明日","あす"],["は"],["炉","ろ"],["に"],["投げ込まれる","なげこまれる"],["野","の"],["の"],["草","くさ"],["で"],["さえ"],["、"],["神","かみ"],["は"],["この"],["よう"],["に"],["装って","よそおって"],["くださる"],["。"],["まして"],["、"],["あなた"],["がた"],["に"],["は"],["なおさら"],["の"],["こと"],["で"],["は"],["ない"],["か"],["、"],["信仰","しんこう"],["の"],["薄い","うすい"],["者","もの"],["たち"],["よ"],["。"]]},{"verse":31,"text":"だから、『何を食べようか』『何を飲もうか』『何を着ようか』と言って、思い悩むな。","tok":[["だ"],["から"],["、"],["『"],["何","なん"],["を"],["食べよう","たべよう"],["か"],["』"],["『"],["何","なん"],["を"],["飲もう","のもう"],["か"],["』"],["『"],["何","なん"],["を"],["着よう","きよう"],["か"],["』"],["と"],["言って","いって"],["、"],["思い悩む","おもいなやむ"],["な"],["。"]]},{"verse":32,"text":"それはみな、異邦人が切に求めているものだ。あなたがたの天の父は、これらのものがみなあなたがたに必要なことをご存じである。","tok":[["それ"],["は"],["みな"],["、"],["異邦人","いほうじん"],["が"],["切に","せつに"],["求めて","もとめて"],["いる"],["もの"],["だ"],["。"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["は"],["、"],["これ"],["ら"],["の"],["もの"],["が"],["みな"],["あなた"],["がた"],["に"],["必要","ひつよう"],["な"],["こと"],["を"],["ご存じ","ごぞんじ"],["で"],["ある"],["。"]]},{"verse":33,"text":"何よりもまず、神の国と神の義を求めなさい。そうすれば、これらのものはみな加えて与えられる。","tok":[["何","なん"],["より"],["も"],["まず"],["、"],["神","かみ"],["の"],["国","くに"],["と"],["神","かみ"],["の"],["義","ぎ"],["を"],["求め","もとめ"],["なさい"],["。"],["そう"],["すれば"],["、"],["これ"],["ら"],["の"],["もの"],["は"],["みな"],["加えて","くわえて"],["与えられる","あたえられる"],["。"]]},{"verse":34,"text":"だから、明日のことまで思い悩むな。明日のことは明日自らが思い悩む。その日の苦労は、その日だけで十分である。」","tok":[["だ"],["から"],["、"],["明日","あす"],["の"],["こと"],["まで"],["思い悩む","おもいなやむ"],["な"],["。"],["明日","あす"],["の"],["こと"],["は"],["明日","あす"],["自ら","みずから"],["が"],["思い悩む","おもいなやむ"],["。"],["その"],["日","ひ"],["の"],["苦労","くろう"],["は"],["、"],["その"],["日","ひ"],["だけ"],["
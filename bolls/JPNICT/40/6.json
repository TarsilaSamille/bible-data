[{"verse":1,"text":"「見てもらおうとして、人の前で善行をしないように注意しなさい。さもないと、あなたがたの天の父のもとで報いをいただけないことになる。","tok":[["「"],["見て","みて"],["もらおう"],["として"],["、"],["人","ひと"],["の"],["前","まえ"],["で"],["善行","ぜんこう"],["を"],["しない"],["よう"],["に"],["注意","ちゅうい"],["し"],["なさい"],["。"],["さも"],["ない"],["と"],["、"],["あなた"],["がた"],["の"],["天","てん"],["の"],["父","ちち"],["の"],["もと"],["で"],["報い","むくい"],["を"],["いただけない"],["こと"],["に"],["なる"],["。"]]},{"verse":2,"text":"だから、あなたは施しをするときには、偽善者たちが人からほめられようと会堂や街角でするように、自分の前でラッパを吹き鳴らしてはならない。はっきりあなたがたに言っておく。彼らは既に報いを受けている。","tok":[["だ"],["から"],["、"],["あなた"],["は"],["施し","ほどこし"],["を"],["する"],["とき"],["に"],["は"],["、"],["偽善者","ぎぜんしゃ"],["たち"],["が"],["人","ひと"],["から"],["ほめられよう"],["と"],["会堂","かいどう"],["や"],["街角","まちかど"],["で"],["する"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["前","まえ"],["で"],["ラッパ"],["を"],["吹き鳴らして","ふきならして"],["は"],["ならない"],["。"],["はっきり"],["あなた"],["がた"],["に"],["言って","いって"],["おく"],["。"],["彼","かれ"],["ら"],["は"],["既に","すでに"],["報い","むくい"],["を"],["受けて","うけて"],["いる"],["。"]]},{"verse":3,"text":"施しをするときは、右の手のすることを左の手に知らせてはならない。","tok":[["施し","ほどこし"],["を"],["する"],["とき"],["は"],["、"],["右","みぎ"],["の"],["手","て"],["の"],["する"],["こと"],["を"],["左","ひだり"],["の"],["手","て"],["に"],["知らせて","しらせて"],["は"],["ならない"],["。"]]},{"verse":4,"text":"あなたの施しを人目につかせないためである。そうすれば、隠れたことを見ておられる父が、あなたに報いてくださる。」","tok":[["あなた"],["の"],["施し","ほどこし"],["を"],["人目","ひとめ"],["に"],["つかせない"],["ため"],["で"],["ある"],["。"],["そう"],["すれば"],["、"],["隠れた","かくれた"],["こと"],["を"],["見て","みて"],["おられる"],["父","ちち"],["が"],["、"],["あなた"],["に"],["報いて","むくいて"],["くださる"],["。"],["」"]]},{"verse":5,"text":"「祈るときにも、あなたがたは偽善者のようであってはならない。偽善者たちは、人に見てもらおうと、会堂や大通りの角に立って祈りたがる。はっきり言っておく。彼らは既に報いを受けている。","tok":[["「"],["祈る","いのる"],["とき"],["に"],["も"],["、"],["あなた"],["がた"],["は"],["偽善者","ぎぜんしゃ"],["の"],["よう"],["で"],["あって"],["は"],["ならない"],["。"],["偽善者","ぎぜんしゃ"],["たち"],["は"],["、"],["人","ひと"],["に"],["見て","みて"],["もらおう"],["と"],["、"],["会堂","かいどう"],["や"],["大通り","おおどおり"],["の"],["角","かど"],["に"],["立って","たって"],["祈りたがる","いのりたがる"],["。"],["はっきり"],["言って","いって"],["おく"],["。"],["彼","かれ"],["ら"],["は"],["既に","すでに"],["報い","むくい"],["を"],["受けて","うけて"],["いる"],["。"]]},{"verse":6,"text":"だから、あなたが祈るときは、奥まった自分の部屋に入って戸を閉め、隠れたところにおられるあなたの父に祈りなさい。そうすれば、隠れたことを見ておられるあなたの父が報いてくださる。","tok":[["だ"],["から"],["、"],["あなた"],["が"],["祈る","いのる"],["とき"],["は"],["、"],["奥まった","おくまった"],["自分","じぶん"],["の"],["部屋","へや"],["に"],["入って","はいって"],["戸","と"],["を"],["閉め","しめ"],["、"],["隠れた","かくれた"],["ところ"],["に"],["おられる"],["あなた"],["の"],["父","ちち"],["に"],["祈り","いのり"],["なさい"],["。"],["そう"],["すれば"],["、"],["隠れた","かくれた"],["こと"],["を"],["見て","みて"],["おられる"],["あなた"],["の"],["父","ちち"],["が"],["報いて","むくいて"],["くださる"],["。"]]},{"verse":7,"text":"また、あなたがたが祈るときは、異邦人のようにくどくどと述べてはならない。異邦人は、言葉数が多ければ、聞き入れられると思い込んでいる。","tok":[["また"],["、"],["あなた"],["がた"],["が"],["祈る","いのる"],["とき"],["は"],["、"],["異邦人","いほうじん"],["の"],["よう"],["に"],["くどくど"],["と"],["述べて","のべて"],["は"],["ならない"],["。"],["異邦人","いほうじん"],["は"],["、"],["言葉数","ことばかず"],["が"],["多ければ","おおければ"],["、"],["聞き入れられる","ききいれられる"],["と"],["思い込んで","おもいこんで"],["いる"],["。"]]},{"verse":8,"text":"彼らのまねをしてはならない。あなたがたの父は、願う前から、あなたがたに必要なものをご存じなのだ。","tok":[["彼","かれ"],["ら"],["の"],["まね"],["を"],["して"],["は"],["ならない"],["。"],["あなた"],["がた"],["の"],["父","ちち"],["は"],["、"],["願う","ねがう"],["前","まえ"],["から"],["、"],["あなた"],["がた"],["に"],["必要","ひつよう"],["な"],["もの"],["を"],["ご存じ","ごぞんじ"],["な"],["の"],["だ"],["。"]]},{"verse":9,"text":"だから、こう祈りなさい。『天におられるわたしたちの父よ、御名が崇められますように。","tok":[["だ"],["から"],["、"],["こう"],["祈り","いのり"],["なさい"],["。"],["『"],["天","てん"],["に"],["おられる"],["わたしたち"],["の"],["父","ちち"],["よ"],["、"],["御名","ぎょめい"],["が"],["崇められます","あがめられます"],["よう"],["に"],["。"]]},{"verse":10,"text":"御国が来ますように。御心が行われますように、天におけるように地の上にも。","tok":[["御国","みくに"],["が"],["来ます","きます"],["よう"],["に"],["。"],["御心","おこころ"],["が"],["行われます","おこなわれます"],["よう"],["に"],["、"],["天","てん"],["に"],["おける"],["よう"],["に"],["地","ち"],["の"],["上","うえ"],["に"],["も"],["。"]]},{"verse":11,"text":"わたしたちに必要な糧を今日与えてください。","tok":[["わたしたち"],["に"],["必要","ひつよう"],["な"],["糧","かて"],["を"],["今日","きょう"],["与えて","あたえて"],["ください"],["。"]]},{"verse":12,"text":"わたしたちの負い目を赦してください、わたしたちも自分に負い目のある人を赦しましたよう
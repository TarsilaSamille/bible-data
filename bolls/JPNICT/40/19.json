[{"verse":1,"text":"イエスはこれらの言葉を語り終えると、ガリラヤを去り、ヨルダン川の向こう側のユダヤ地方に行かれた。","tok":[["イエス"],["は"],["これ"],["ら"],["の"],["言葉","ことば"],["を"],["語り","かたり"],["終える","おえる"],["と"],["、"],["ガリラヤ"],["を"],["去り","さり"],["、"],["ヨルダン"],["川","かわ"],["の"],["向こう側","むこうがわ"],["の"],["ユダヤ"],["地方","ちほう"],["に"],["行かれた","いかれた"],["。"]]},{"verse":2,"text":"大勢の群衆が従った。イエスはそこで人々の病気をいやされた。","tok":[["大勢","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["従った","したがった"],["。"],["イエス"],["は"],["そこ"],["で"],["人々","ひとびと"],["の"],["病気","びょうき"],["を"],["いやされた"],["。"]]},{"verse":3,"text":"ファリサイ派の人々が近寄り、イエスを試そうとして、「何か理由があれば、夫が妻を離縁することは、律法に適っているでしょうか」と言った。","tok":[["ファリサイ"],["派","は"],["の"],["人々","ひとびと"],["が"],["近寄り","ちかより"],["、"],["イエス"],["を"],["試そう","ためそう"],["として"],["、"],["「"],["何","なん"],["か"],["理由","りゆう"],["が"],["あれば"],["、"],["夫","おっと"],["が"],["妻","つま"],["を"],["離縁","りえん"],["する"],["こと"],["は"],["、"],["律法","りっぽう"],["に"],["適って","かなって"],["いるでしょう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"イエスはお答えになった。「あなたたちは読んだことがないのか。創造主は初めから人を男と女とにお造りになった。」","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["あなた"],["たち"],["は"],["読んだ","よんだ"],["こと"],["が"],["ない"],["の"],["か"],["。"],["創造","そうぞう"],["主","しゅ"],["は"],["初め","はじめ"],["から"],["人","ひと"],["を"],["男","おとこ"],["と"],["女","おんな"],["と"],["に"],["お造り","おつくり"],["に"],["なった"],["。"],["」"]]},{"verse":5,"text":"そして、こうも言われた。「それゆえ、人は父母を離れてその妻と結ばれ、二人は一体となる。","tok":[["そして"],["、"],["こう"],["も"],["言われた","いわれた"],["。"],["「"],["それ"],["ゆえ"],["、"],["人","ひと"],["は"],["父母","ふぼ"],["を"],["離れて","はなれて"],["その"],["妻","つま"],["と"],["結ばれ","むすばれ"],["、"],["二人","ふたり"],["は"],["一体","いったい"],["と"],["なる"],["。"]]},{"verse":6,"text":"だから、二人はもはや別々ではなく、一体である。従って、神が結び合わせてくださったものを、人は離してはならない。」","tok":[["だ"],["から"],["、"],["二人","ふたり"],["は"],["もはや"],["別々","べつべつ"],["で"],["は"],["なく"],["、"],["一体","いったい"],["で"],["ある"],["。"],["従って","したがって"],["、"],["神","かみ"],["が"],["結び合わせて","むすびあわせて"],["くださった"],["もの"],["を"],["、"],["人","ひと"],["は"],["離して","はなして"],["は"],["ならない"],["。"],["」"]]},{"verse":7,"text":"すると、彼らはイエスに言った。「では、なぜモーセは、離縁状を渡して離縁するように命じたのですか。」","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["言った","いった"],["。"],["「"],["で"],["は"],["、"],["なぜ"],["モーセ"],["は"],["、"],["離縁状","りえんじょう"],["を"],["渡して","わたして"],["離縁","りえん"],["する"],["よう"],["に"],["命じた","めいじた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":8,"text":"イエスは言われた。「あなたたちの心が頑固なので、モーセは妻を離縁することを許したのであって、初めからそうだったわけではない。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["あなた"],["たち"],["の"],["心","こころ"],["が"],["頑固","がんこ"],["な"],["ので"],["、"],["モーセ"],["は"],["妻","つま"],["を"],["離縁","りえん"],["する"],["こと"],["を"],["許した","ゆるした"],["ので"],["あって"],["、"],["初め","はじめ"],["から"],["そう"],["だった"],["わけ"],["で"],["は"],["ない"],["。"]]},{"verse":9,"text":"言っておくが、不法な結婚でもないのに妻を離縁して、他の女を妻にする者は、姦通の罪を犯すことになる。」","tok":[["言って","いって"],["おく"],["が"],["、"],["不法","ふほう"],["な"],["結婚","けっこん"],["で"],["も"],["ない"],["のに"],["妻","つま"],["を"],["離縁","りえん"],["して"],["、"],["他","た"],["の"],["女","おんな"],["を"],["妻","つま"],["に"],["する"],["者","もの"],["は"],["、"],["姦通","かんつう"],["の"],["罪","つみ"],["を"],["犯す","おかす"],["こと"],["に"],["なる"],["。"],["」"]]},{"verse":10,"text":"弟子たちは、「夫婦の間柄がそんなものなら、妻を迎えない方がましです」と言った。","tok":[["弟子","でし"],["たち"],["は"],["、"],["「"],["夫婦","ふうふ"],["の"],["間柄","あいだがら"],["が"],["そんな"],["もの"],["なら"],["、"],["妻","つま"],["を"],["迎えない","むかえない"],["方","ほう"],["が"],["まし"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":11,"text":"イエスは言われた。「だれもがこの言葉を受け入れるのではなく、恵まれた者だけである。","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["だれ"],["も"],["が"],["この"],["言葉","ことば"],["を"],["受け入れる","うけいれる"],["ので"],["は"],["なく"],["、"],["恵まれた","めぐまれた"],["者","もの"],["だけ"],["で"],["ある"],["。"]]},{"verse":12,"text":"結婚できないように生まれついた者、人から結婚できないようにされた者もいるが、天の国のために結婚しない者もいる。これを受け入れることのできる人は受け入れなさい。」","tok":[["結婚","けっこん"],["できない"],["よう"],["に"],["生まれついた","うまれついた"],["者","もの"],["、"],["人","ひと"],["から"],["結婚","けっこん"],["できない"],["よう"],["に"],["された"],["者","もの"],["も"],["いる"],["が"],["、"],["天","てん"],["の"],["国","くに"],["の"],["ため"],["に"],["結婚","けっこん"],["しない"],["者","もの"],["も"],["いる"],["。"],["これ"],["を"],["受け入れる","うけいれる"],["こと"],["の"],["できる"],["人","ひと"],["は"],["受け入れ","うけいれ"],["なさい"],["。"],["」"]]},{"verse":13,"text":"そのとき、イエスに手を置いて祈っていただくために、人々が子供たちを連れて来た。弟子たちはこの人々を叱った。","tok":[["その"],["とき"],["、"],["イエス"],["に"],["手","て"],["を"],["置いて","おいて"],["祈って","いのって"],["いただく"],["ため"],["に"],["、"],["人々","ひとびと"],["が"],["子供","こども"],["たち"],["を"],["連れて","つれて"],["来た","きた"],["。"],["弟子","でし"],["たち"],["は"],["この"],["人々","ひとびと"],["を"],["叱った","しかった"],["。"]]},{"verse":14,"text":"しかし、イエスは言われた。「子供たちを来させなさい。わたしのところに来るのを妨げてはならない。天の国はこのような者たちのものである。」","tok":[["しかし"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["子供","こども"],["たち"],["を"],["来させ","きたさせ"],["なさい"],["。"],["わたし"],["の"],["ところ"],["に"],["来る","くる"],["の"],["を"],["妨げて","さまたげて"],["は"],["ならない"],["。"],["天","てん"],["の"],["国","くに"],["は"],["この"],["よう"],["な"],["者","もの"],["たち"],["の"],["もの"],["で"],["ある"],["。"],["」"]]},{"verse":15,"text":"そして、子供たちに手を置いてから、そこを立ち去られた。","tok":[["そして"],["、"],["子供","こども"],["たち"],["に"],["手","て"],["を"],["置いて","おいて"],["から"],["、"],["そこ"],["を"],["立ち去られた","たちさられた"],["。"]]},{"verse":16,"text":"さて、一人の男がイエスに近寄って来て言った。「先生、永遠の命を得るには、どんな善いことをすればよいのでしょうか。」","tok":[["さて"],["、"],["一人","ひとり"],["の"],["男","おとこ"],["が"],["イエス"],["に"],["近寄って","ちかよって"],["来て","きて"],["言った","いった"],["。"],["「"],["先生","せんせい"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["得る","うる"],["に"],["は"],["、"],["どんな"],["善い","よい"],["こと"],["を"],["すれば"],["よい"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":17,"text":"イエスは言われた。「なぜ、善いことについて、わたしに尋ねるのか。善い方はおひとりである。もし命を得たいのなら、掟を守りなさい。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["なぜ"],["、"],["善い","よい"],["こと"],["について"],["、"],["わたし"],["に"],["尋ねる","たずねる"],["の"],["か"],["。"],["善い","よい"],["方","かた"],["は"],["おひとり"],["で"],["ある"],["。"],["もし"],["命","いのち"],["を"],["得たい","えたい"],["の"],["なら"],["、"],["掟","おきて"],["を"],["守り","まもり"],["なさい"],["。"],["」"]]},{"verse":18,"text":"男が「どの掟ですか」と尋ねると、イエスは言われた。「『殺すな、姦淫するな、盗むな、偽証するな、","tok":[["男","おとこ"],["が"],["「"],["どの"],["掟","おきて"],["です"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["『"],["殺す","ころす"],["な"],["、"],["姦淫","かんいん"],["する"],["な"],["、"],["盗む","ぬすむ"],["な"],["、"],["偽証","ぎしょう"],["する"],["な"],["、"]]},{"verse":19,"text":"父母を敬え、また、隣人を自分のように愛しなさい。』」","tok":[["父母","ふぼ"],["を"],["敬え","うやまえ"],["、"],["また"],["、"],["隣人","りんじん"],["を"],["自分","じぶん"],["の"],["よう"],["に"],["愛し","あいし"],["なさい"],["。"],["』"],["」"]]},{"verse":20,"text":"そこで、この青年は言った。「そういうことはみな守ってきました。まだ何か欠けているでしょうか。」","tok":[["そこ"],["で"],["、"],["この"],["青年","せいねん"],["は"],["言った","いった"],["。"],["「"],["そう"],["いう"],["こと"],["は"],["みな"],["守って","まもって"],["きました"],["。"],["まだ"],["何","なん"],["か"],["欠けて","かけて"],["いるでしょう"],["か"],["。"],["」"]]},{"verse":21,"text":"イエスは言われた。「もし完全になりたいのなら、行って持ち物を売り払い、貧しい人々に施しなさい。そうすれば、天に富を積むことになる。それから、わたしに従いなさい。」","tok":[["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["もし"],["完全","かんぜん"],["に"],["なりたい"],["の"],["なら"],["、"],["行って","いって"],["持ち物","もちもの"],["を"],["売り払い","うりはらい"],["、"],["貧しい","まずしい"],["人々","ひとびと"],["に"],["施し","ほどこし"],["なさい"],["。"],["そう"],["すれば"],["、"],["天","てん"],["に"],["富","とみ"],["を"],["積む","つむ"],["こと"],["に"],["なる"],["。"],["それ"],["から"],["、"],["わたし"],["に"],["従い","したがい"],["なさい"],["。"],["」"]]},{"verse":22,"text":"青年はこの言葉を聞き、悲しみながら立ち去った。たくさんの財産を持っていたからである。","tok":[["青年","せいねん"],["は"],["この"],["言葉","ことば"],["を"],["聞き","きき"],["、"],["悲しみ","かなしみ"],["ながら"],["立ち去った","たちさった"],["。"],["たくさん"],["の"],["財産","ざいさん"],["を"],["持って","もって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"イエスは弟子たちに言われた。「はっきり言っておく。金持ちが天の国に入るのは難しい。","tok":[["イエス"],["は"],["弟子","でし"],["たち"],["に"],["言われた","いわれた"],["。"],["「"],["はっきり"],["言って","いって"],["おく"],["。"],["金持ち","かねもち"],["が"],["天","てん"],["の"],["国","くに"],["に"],["入る","はいる"],["の"],["は"],["難しい","むずかしい"],["。"]]},{"verse":24,"text":"重ねて言うが、金持ちが神の国に入るよりも、らくだが針の穴を通る方がまだ易しい。」","tok":[["重ねて","かさねて"],["言う","ゆう"],["が"],["、"],["金持ち","かねもち"],["が"],["神","かみ"],["の"],["国","くに"],["に"],["入る","はいる"],["より"],["も"],["、"],["らくだ"],["が"],["針","はり"],["の"],["穴","あな"],["を"],["通る","とおる"],["方","ほう"],["が"],["まだ"],["易しい","やさしい"],["。"],["」"]]},{"verse":25,"text":"弟子たちはこれを聞いて非常に驚き、「それでは、だれが救われるのだろうか」と言った。","tok":[["弟子","でし"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["非常","ひじょう"],["に"],["驚き","おどろき"],["、"],["「"],["それ"],["で"],["は"],["、"],["だれ"],["が"],["救われる","すくわれる"],["の"],["だろう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":26,"text":"イエスは彼らを見つめて、「それは人間にできることではないが、神は何でもできる」と言われた。","tok":[["イエス"],["は"],["彼","かれ"],["ら"],["を"],["見つめて","みつめて"],["、"],["「"],["それ"],["は"],["人間","にんげん"],["に"],["できる"],["こと"],["で"],["は"],["ない"],["が"],["、"],["神","かみ"],["は"],["何","なん"],["で"],["も"],["できる"],["」"],["と"],["言われた","いわれた"],["。"]]},{"verse":27,"text":"すると、ペトロがイエスに言った。「このとおり、わたしたちは何もかも捨ててあなたに従って参りました。では、わたしたちは何をいただけるのでしょうか。」","tok":[["する"],["と"],["、"],["ペトロ"],["が"],["イエス"],["に"],["言った","いった"],["。"],["「"],["この"],["とおり"],["、"],["わたしたち"],["は"],["何","なん"],["も"],["か"],["も"],["捨てて","すてて"],["あなた"],["に"],["従って","したがって"],["参りました","まいりました"],["。"],["で"],["は"],["、"],["わたしたち"],["は"],["何","なん"],["を"],["いただける"],["の"],["でしょう"],["か"],["。"],["」"]]},{"verse":28,"text":"イエスは一同に言われた。「はっきり言っておく。新しい世界になり、人の子が栄光の座に座るとき、あなたがたも、わたしに従って来たのだから、十二の座に座ってイスラエルの十二部族を治めることになる。","tok":[["イエス"],["は"],["一同","いちどう"],["に"],["言われた","いわれた"],["。"],["「"],["はっきり"],["言って","いって"],["おく"],["。"],["新しい","あたらしい"],["世界","せかい"],["に"],["なり"],["、"],["人","ひと"],["の"],["子","こ"],["が"],["栄光","えいこう"],["の"],["座","ざ"],["に"],["座る","すわる"],["とき"],["、"],["あなた"],["がた"],["も"],["、"],["わたし"],["に"],["従って","したがって"],["来た","きた"],["の"],["だ"],["から"],["、"],["十二","じゅうに"],["の"],["座","ざ"],["に"],["座って","すわって"],["イスラエル"],["の"],["十二","じゅうに"],["部族","ぶぞく"],["を"],["治める","おさめる"],["こと"],["に"],["なる"],["。"]]},{"verse":29,"text":"わたしの名のために、家、兄弟、姉妹、父、母、子供、畑を捨てた者は皆、その百倍もの報いを受け、永遠の命を受け継ぐ。","tok":[["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["家","いえ"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["、"],["父","ちち"],["、"],["母","はは"],["、"],["子供","こども"],["、"],["畑","はたけ"],["を"],["捨てた","すてた"],["者","もの"],["は"],["皆","みな"],["、"],["その"],["百","ひゃく"],["倍","ばい"],["も"],["の"],["報い","むくい"],["を"],["受け","うけ"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["を"],["受け継ぐ","うけつぐ"],["。"]]},{"verse":30,"text":"しかし、先にいる多くの者が後になり、後にいる多くの者が先になる。」","tok":[["しかし"],["、"],["先","さき"],["に"],["いる"],["多く","おおく"],["の"],["者","もの"],["が"],["後","あと"],["に"],["なり"],["、"],["後","あと"],["に"],["いる"],["多く","おおく"],["の"],["者","もの"],["が"],["先","さき"],["に"],["なる"],["。"],["」"]]}]
[{"verse":1,"text":"一行がエルサレムに近づいて、オリーブ山沿いのベトファゲに来たとき、イエスは二人の弟子を使いに出そうとして、","tok":[["一行","いっこう"],["が"],["エルサレム"],["に"],["近づいて","ちかづいて"],["、"],["オリーブ"],["山沿い","やまぞい"],["の"],["ベトファゲ"],["に"],["来た","きた"],["とき"],["、"],["イエス"],["は"],["二人","ふたり"],["の"],["弟子","でし"],["を"],["使い","つかい"],["に"],["出そう","だそう"],["として"],["、"]]},{"verse":2,"text":"言われた。「向こうの村へ行きなさい。するとすぐ、ろばがつないであり、一緒に子ろばのいるのが見つかる。それをほどいて、わたしのところに引いて来なさい。","tok":[["言われた","いわれた"],["。"],["「"],["向こう","むこう"],["の"],["村","むら"],["へ"],["行き","いき"],["なさい"],["。"],["する"],["と"],["すぐ"],["、"],["ろば"],["が"],["つないで"],["あり"],["、"],["一緒","いっしょ"],["に"],["子","こ"],["ろば"],["の"],["いる"],["の"],["が"],["見つかる","みつかる"],["。"],["それ"],["を"],["ほどいて"],["、"],["わたし"],["の"],["ところ"],["に"],["引いて","ひいて"],["来","き"],["なさい"],["。"]]},{"verse":3,"text":"もし、だれかが何か言ったら、『主がお入り用なのです』と言いなさい。すぐ渡してくれる。」","tok":[["もし"],["、"],["だれ"],["か"],["が"],["何","なん"],["か"],["言ったら","いったら"],["、"],["『"],["主","ぬし"],["が"],["お入り","おはいり"],["用","よう"],["な"],["の"],["です"],["』"],["と"],["言い","いい"],["なさい"],["。"],["すぐ"],["渡して","わたして"],["くれる"],["。"],["」"]]},{"verse":4,"text":"それは、預言者を通して言われていたことが実現するためであった。","tok":[["それ"],["は"],["、"],["預言者","よげんしゃ"],["を"],["通して","とおして"],["言われて","いわれて"],["いた"],["こと"],["が"],["実現","じつげん"],["する"],["ため"],["で"],["あった"],["。"]]},{"verse":5,"text":"「シオンの娘に告げよ。『見よ、お前の王がお前のところにおいでになる、柔和な方で、ろばに乗り、荷を負うろばの子、子ろばに乗って。』」","tok":[["「"],["シオン"],["の"],["娘","むすめ"],["に"],["告げ","つげ"],["よ"],["。"],["『"],["見よ","みよ"],["、"],["お前","おまえ"],["の"],["王","おう"],["が"],["お前","おまえ"],["の"],["ところ"],["に"],["おいで"],["に"],["なる"],["、"],["柔和","にゅうわ"],["な"],["方","かた"],["で"],["、"],["ろば"],["に"],["乗り","のり"],["、"],["荷","に"],["を"],["負う","おう"],["ろば"],["の"],["子","こ"],["、"],["子","こ"],["ろば"],["に"],["乗って","のって"],["。"],["』"],["」"]]},{"verse":6,"text":"弟子たちは行って、イエスが命じられたとおりにし、","tok":[["弟子","でし"],["たち"],["は"],["行って","いって"],["、"],["イエス"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["し"],["、"]]},{"verse":7,"text":"ろばと子ろばを引いて来て、その上に服をかけると、イエスはそれにお乗りになった。","tok":[["ろば"],["と"],["子","こ"],["ろば"],["を"],["引いて","ひいて"],["来て","きて"],["、"],["その"],["上","うえ"],["に"],["服","ふく"],["を"],["かける"],["と"],["、"],["イエス"],["は"],["それ"],["に"],["お乗り","おのり"],["に"],["なった"],["。"]]},{"verse":8,"text":"大勢の群衆が自分の服を道に敷き、また、ほかの人々は木の枝を切って道に敷いた。","tok":[["大勢","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["自分","じぶん"],["の"],["服","ふく"],["を"],["道","みち"],["に"],["敷き","しき"],["、"],["また"],["、"],["ほか"],["の"],["人々","ひとびと"],["は"],["木","き"],["の"],["枝","えだ"],["を"],["切って","きって"],["道","みち"],["に"],["敷いた","しいた"],["。"]]},{"verse":9,"text":"そして群衆は、イエスの前を行く者も後に従う者も叫んだ。「ダビデの子にホサナ。主の名によって来られる方に、祝福があるように。いと高きところにホサナ。」","tok":[["そして"],["群衆","ぐんしゅう"],["は"],["、"],["イエス"],["の"],["前","まえ"],["を"],["行く","いく"],["者","もの"],["も"],["後","あと"],["に"],["従う","したがう"],["者","もの"],["も"],["叫んだ","さけんだ"],["。"],["「"],["ダビデ"],["の"],["子","こ"],["に"],["ホサナ"],["。"],["主","ぬし"],["の"],["名","な"],["によって"],["来られる","こられる"],["方","かた"],["に"],["、"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["。"],["いと"],["高き","たかき"],["ところ"],["に"],["ホサナ"],["。"],["」"]]},{"verse":10,"text":"イエスがエルサレムに入られると、都中の者が、「いったい、これはどういう人だ」と言って騒いだ。","tok":[["イエス"],["が"],["エルサレム"],["に"],["入られる","はいられる"],["と"],["、"],["都中","とちゅう"],["の"],["者","もの"],["が"],["、"],["「"],["いったい"],["、"],["これ"],["は"],["どういう"],["人","ひと"],["だ"],["」"],["と"],["言って","いって"],["騒いだ","さわいだ"],["。"]]},{"verse":11,"text":"そこで群衆は、「この方は、ガリラヤのナザレから出た預言者イエスだ」と言った。","tok":[["そこ"],["で"],["群衆","ぐんしゅう"],["は"],["、"],["「"],["この"],["方","かた"],["は"],["、"],["ガリラヤ"],["の"],["ナザレ"],["から"],["出た","でた"],["預言者","よげんしゃ"],["イエス"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":12,"text":"それから、イエスは神殿の境内に入り、そこで売り買いをしていた人々を皆追い出し、両替人の台や鳩を売る者の腰掛けを倒された。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["神殿","しんでん"],["の"],["境内","けいだい"],["に"],["入り","はいり"],["、"],["そこ"],["で"],["売り買い","うりかい"],["を"],["して"],["いた"],["人々","ひとびと"],["を"],["皆","みな"],["追い出し","おいだし"],["、"],["両替人","りょうがえにん"],["の"],["台","だい"],["や"],["鳩","はと"],["を"],["売る","うる"],["者","もの"],["の"],["腰掛け","こしかけ"],["を"],["倒された","たおされた"],["。"]]},{"verse":13,"text":"そして言われた。「こう書いてある。『わたしの家は、祈りの家と呼ばれるべきである。』ところが、あなたたちはそれを強盗の巣にしている。」","tok":[["そして"],["言われた","いわれた"],["。"],["「"],["こう"],["書いて","かいて"],["ある"],["。"],["『"],["わたし"],["の"],["家","いえ"],["は"],["、"],["祈り","いのり"],["の"],["家","いえ"],["と"],["呼ばれるべきで","よばれるべきで"],["ある"],["。"],["』"],["ところ"],["が"],["、"],["あなた"],["たち"],["は"],["それ"],["を"],["強盗","ごうとう"],["の"],["巣","す"],["に"],["して"],["いる"],["。"],["」"]]},{"verse":14,"text":"境内では目の見えない人や足の不自由な人たちがそばに寄って来たので、イエスはこれらの人々をいやされた。","tok":[["境内","けいだい"],["で"],["は"],["目","め"],["の"],["見えない","みえない"],["人","ひと"],["や"],["足","あし"],["の"],["不自由","ふじゆう"],["な"],["人","ひと"],["たち"],["が"],["そば"],["に"],["寄って","よって"],["来た","きた"],["ので"],["、"],["イエス"],["は"],["これ"],["ら"],["の"],["人々","ひとびと"],["を"],["いやされた"],["。"]]},{"verse":15,"text":"他方、祭司長たちや、律法学者たちは、イエスがなさった不思議な業を見、境内で子供たちまで叫んで、「ダビデの子にホサナ」と言うのを聞いて腹を立て、","tok":[["他方","たほう"],["、"],["祭司長","さいしちょう"],["たち"],["や"],["、"],["律法学者","りっぽうがくしゃ"],["たち"],["は"],["、"],["イエス"],["が"],["なさった"],["不思議","ふしぎ"],["な"],["業","ごう"],["を"],["見","み"],["、"],["境内","けいだい"],["で"],["子供","こども"],["たち"],["まで"],["叫んで","さけんで"],["、"],["「"],["ダビデ"],["の"],["子","こ"],["に"],["ホサナ"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いて","きいて"],["腹","はら"],["を"],["立て","たて"],["、"]]},{"verse":16,"text":"イエスに言った。「子供たちが何と言っているか、聞こえるか。」イエスは言われた。「聞こえる。あなたたちこそ、『幼子や乳飲み子の口に、あなたは賛美を歌わせた』という言葉をまだ読んだことがないのか。」","tok":[["イエス"],["に"],["言った","いった"],["。"],["「"],["子供","こども"],["たち"],["が"],["何","なん"],["と"],["言って","いって"],["いる"],["か"],["、"],["聞こえる","きこえる"],["か"],["。"],["」"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["聞こえる","きこえる"],["。"],["あなた"],["たち"],["こそ"],["、"],["『"],["幼子","おさなご"],["や"],["乳飲み子","ちのみご"],["の"],["口","くち"],["に"],["、"],["あなた"],["は"],["賛美","さんび"],["を"],["歌わせた","うたわせた"],["』"],["と"],["いう"],["言葉","ことば"],["を"],["まだ"],["読んだ","よんだ"],["こと"],["が"],["ない"],["の"],["か"],["。"],["」"]]},{"verse":17,"text":"それから、イエスは彼らと別れ、都を出てベタニアに行き、そこにお泊まりになった。","tok":[["それ"],["から"],["、"],["イエス"],["は"],["彼","かれ"],["ら"],["と"],["別れ","わかれ"],["、"],["都","と"],["を"],["出て","でて"],["ベタニア"],["に"],["行き","いき"],["、"],["そこ"],["に"],["お泊まり","おとまり"],["に"],["なった"],["。"]]},{"verse":18,"text":"朝早く、都に帰る途中、イエスは空腹を覚えられた。","tok":[["朝","あさ"],["早く","はやく"],["、"],["都","と"],["に"],["帰る","かえる"],["途中","とちゅう"],["、"],["イエス"],["は"],["空腹","くうふく"],["を"],["覚えられた","おぼえられた"],["。"]]},{"verse":19,"text":"道端にいちじくの木があるのを見て、近寄られたが、葉のほかは何もなかった。そこで、「今から後いつまでも、お前には実がならないように」と言われると、いちじくの木はたちまち枯れてしまった。","tok":[["道端","みちばた"],["に"],["いちじく"],["の"],["木","き"],["が"],["ある"],["の"],["を"],["見て","みて"],["、"],["近寄られた","ちかよられた"],["が"],["、"],["葉","は"],["の"],["ほか"],["は"],["何","なん"],["も"],["なかった"],["。"],["そこ"],["で"],["、"],["「"],["今","いま"],["から"],["後","あと"],["いつ"],["まで"],["も"],["、"],["お前","おまえ"],["に"],["は"],["実","じつ"],["が"],["ならない"],["よう"],["に"],["」"],["と"],["言われる","いわれる"],["と"],["、"],["いちじく"],["の"],["木","き"],["は"],["たちまち"],["枯れて","かれて"],["しまった"],["。"]]},{"verse":20,"text":"弟子たちはこれを見て驚き、「なぜ、たちまち枯れてしまったのですか」と言った。","tok":[["弟子","でし"],["たち"],["は"],["これ"],["を"],["見て","みて"],["驚き","おどろき"],["、"],["「"],["なぜ"],["、"],["たちまち"],["枯れて","かれて"],["しまった"],["の"],["です"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":21,"text":"イエスはお答えになった。「はっきり言っておく。あなたがたも信仰を持ち、疑わないならば、いちじくの木に起こったようなことができるばかりでなく、この山に向かい、『立ち上がって、海に飛び込め』と言っても、そのとおりになる。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["はっきり"],["言って","いって"],["おく"],["。"],["あなた"],["がた"],["も"],["信仰","しんこう"],["を"],["持ち","もち"],["、"],["疑わないならば","うたがわないならば"],["、"],["いちじく"],["の"],["木","き"],["に"],["起こった","おこった"],["よう"],["な"],["こと"],["が"],["できる"],["ばかり"],["で"],["なく"],["、"],["この"],["山","やま"],["に"],["向かい","むかい"],["、"],["『"],["立ち上がって","たちあがって"],["、"],["海","うみ"],["に"],["飛び込め","とびこめ"],["』"],["と"],["言って","いって"],["も"],["、"],["その"],["とおり"],["に"],["なる"],["。"]]},{"verse":22,"text":"信じて祈るならば、求めるものは何でも得られる。」","tok":[["信じて","しんじて"],["祈るならば","いのるならば"],["、"],["求める","もとめる"],["もの"],["は"],["何","なん"],["で"],["も"],["得られる","えられる"],["。"],["」"]]},{"verse":23,"text":"イエスが神殿の境内に入って教えておられると、祭司長や民の長老たちが近寄って来て言った。「何の権威でこのようなことをしているのか。だれがその権威を与えたのか。」","tok":[["イエス"],["が"],["神殿","しんでん"],["の"],["境内","けいだい"],["に"],["入って","はいって"],["教えて","おしえて"],["おられる"],["と"],["、"],["祭司長","さいしちょう"],["や"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["が"],["近寄って","ちかよって"],["来て","きて"],["言った","いった"],["。"],["「"],["何","なん"],["の"],["権威","けんい"],["で"],["この"],["よう"],["な"],["こと"],["を"],["して"],["いる"],["の"],["か"],["。"],["だれ"],["が"],["その"],["権威","けんい"],["を"],["与えた","あたえた"],["の"],["か"],["。"],["」"]]},{"verse":24,"text":"イエスはお答えになった。「では、わたしも一つ尋ねる。それに答えるなら、わたしも、何の権威でこのようなことをするのか、あなたたちに言おう。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["で"],["は"],["、"],["わたし"],["も"],["一","ひと"],["つ"],["尋ねる","たずねる"],["。"],["それ"],["に"],["答えるなら","こたえるなら"],["、"],["わたし"],["も"],["、"],["何","なん"],["の"],["権威","けんい"],["で"],["この"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["、"],["あなた"],["たち"],["に"],["言おう","いおう"],["。"]]},{"verse":25,"text":"ヨハネの洗礼はどこからのものだったか。天からのものか、それとも、人からのものか。」彼らは論じ合った。「『天からのものだ』と言えば、『では、なぜヨハネを信じなかったのか』と我々に言うだろう。","tok":[["ヨハネ"],["の"],["洗礼","せんれい"],["は"],["どこ"],["から"],["の"],["もの"],["だった"],["か"],["。"],["天","てん"],["から"],["の"],["もの"],["か"],["、"],["それ"],["と"],["も"],["、"],["人","ひと"],["から"],["の"],["もの"],["か"],["。"],["」"],["彼","かれ"],["ら"],["は"],["論じ合った","ろんじあった"],["。"],["「"],["『"],["天","てん"],["から"],["の"],["もの"],["だ"],["』"],["と"],["言えば","いえば"],["、"],["『"],["で"],["は"],["、"],["なぜ"],["ヨハネ"],["を"],["信じなかった","しんじなかった"],["の"],["か"],["』"],["と"],["我々","われわれ"],["に"],["言うだろう","ゆうだろう"],["。"]]},{"verse":26,"text":"『人からのものだ』と言えば、群衆が怖い。皆がヨハネを預言者と思っているから。」","tok":[["『"],["人","ひと"],["から"],["の"],["もの"],["だ"],["』"],["と"],["言えば","いえば"],["、"],["群衆","ぐんしゅう"],["が"],["怖い","こわい"],["。"],["皆","みな"],["が"],["ヨハネ"],["を"],["預言者","よげんしゃ"],["と"],["思って","おもって"],["いる"],["から"],["。"],["」"]]},{"verse":27,"text":"そこで、彼らはイエスに、「分からない」と答えた。すると、イエスも言われた。「それなら、何の権威でこのようなことをするのか、わたしも言うまい。」","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["イエス"],["に"],["、"],["「"],["分からない","わからない"],["」"],["と"],["答えた","こたえた"],["。"],["する"],["と"],["、"],["イエス"],["も"],["言われた","いわれた"],["。"],["「"],["それ"],["なら"],["、"],["何","なん"],["の"],["権威","けんい"],["で"],["この"],["よう"],["な"],["こと"],["を"],["する"],["の"],["か"],["、"],["わたし"],["も"],["言うまい","ゆうまい"],["。"],["」"]]},{"verse":28,"text":"「ところで、あなたたちはどう思うか。ある人に息子が二人いたが、彼は兄のところへ行き、『子よ、今日、ぶどう園へ行って働きなさい』と言った。","tok":[["「"],["ところ"],["で"],["、"],["あなた"],["たち"],["は"],["どう"],["思う","おもう"],["か"],["。"],["ある"],["人","ひと"],["に"],["息子","むすこ"],["が"],["二人","ふたり"],["いた"],["が"],["、"],["彼","かれ"],["は"],["兄","あに"],["の"],["ところ"],["へ"],["行き","いき"],["、"],["『"],["子","こ"],["よ"],["、"],["今日","きょう"],["、"],["ぶどう園","ぶどうえん"],["へ"],["行って","いって"],["働き","はたらき"],["なさい"],["』"],["と"],["言った","いった"],["。"]]},{"verse":29,"text":"兄は『いやです』と答えたが、後で考え直して出かけた。","tok":[["兄","あに"],["は"],["『"],["いや"],["です"],["』"],["と"],["答えた","こたえた"],["が"],["、"],["後","あと"],["で"],["考え直して","かんがえなおして"],["出かけた","でかけた"],["。"]]},{"verse":30,"text":"弟のところへも行って、同じことを言うと、弟は『お父さん、承知しました』と答えたが、出かけなかった。","tok":[["弟","おとうと"],["の"],["ところ"],["へ"],["も"],["行って","いって"],["、"],["同じ","おなじ"],["こと"],["を"],["言う","ゆう"],["と"],["、"],["弟","おとうと"],["は"],["『"],["お父さん","おとうさん"],["、"],["承知","しょうち"],["しました"],["』"],["と"],["答えた","こたえた"],["が"],["、"],["出かけなかった","でかけなかった"],["。"]]},{"verse":31,"text":"この二人のうち、どちらが父親の望みどおりにしたか。」彼らが「兄の方です」と言うと、イエスは言われた。「はっきり言っておく。徴税人や娼婦たちの方が、あなたたちより先に神の国に入るだろう。","tok":[["この"],["二人","ふたり"],["の"],["うち"],["、"],["どちら"],["が"],["父親","ちちおや"],["の"],["望み","のぞみ"],["どおり"],["に"],["した"],["か"],["。"],["」"],["彼","かれ"],["ら"],["が"],["「"],["兄","あに"],["の"],["方","ほう"],["です"],["」"],["と"],["言う","ゆう"],["と"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["はっきり"],["言って","いって"],["おく"],["。"],["徴税人","ちょうぜいにん"],["や"],["娼婦","しょうふ"],["たち"],["の"],["方","ほう"],["が"],["、"],["あなた"],["たち"],["より"],["先","さき"],["に"],["神","かみ"],["の"],["国","くに"],["に"],["入るだろう","はいるだろう"],["。"]]},{"verse":32,"text":"なぜなら、ヨハネが来て義の道を示したのに、あなたたちは彼を信ぜず、徴税人や娼婦たちは信じたからだ。あなたたちはそれを見ても、後で考え直して彼を信じようとしなかった。」","tok":[["なぜ"],["なら"],["、"],["ヨハネ"],["が"],["来て","きて"],["義","ぎ"],["の"],["道","みち"],["を"],["示した","しめした"],["のに"],["、"],["あなた"],["たち"],["は"],["彼","かれ"],["を"],["信ぜず","しんぜず"],["、"],["徴税人","ちょうぜいにん"],["や"],["娼婦","しょうふ"],["たち"],["は"],["信じた","しんじた"],["から"],["だ"],["。"],["あなた"],["たち"],["は"],["それ"],["を"],["見て","みて"],["も"],["、"],["後","あと"],["で"],["考え直して","かんがえなおして"],["彼","かれ"],["を"],["信じよう","しんじよう"],["と"],["しなかった"],["。"],["」"]]},{"verse":33,"text":"「もう一つのたとえを聞きなさい。ある家の主人がぶどう園を作り、垣を巡らし、その中に搾り場を掘り、見張りのやぐらを立て、これを農夫たちに貸して旅に出た。","tok":[["「"],["もう"],["一","ひと"],["つ"],["の"],["たとえ"],["を"],["聞き","きき"],["なさい"],["。"],["ある"],["家","いえ"],["の"],["主人","しゅじん"],["が"],["ぶどう園","ぶどうえん"],["を"],["作り","つくり"],["、"],["垣","かき"],["を"],["巡らし","めぐらし"],["、"],["その"],["中","なか"],["に"],["搾り","しぼり"],["場","ば"],["を"],["掘り","ほり"],["、"],["見張り","みはり"],["の"],["やぐら"],["を"],["立て","たて"],["、"],["これ"],["を"],["農夫","のうふ"],["たち"],["に"],["貸して","かして"],["旅","たび"],["に"],["出た","でた"],["。"]]},{"verse":34,"text":"さて、収穫の時が近づいたとき、収穫を受け取るために、僕たちを農夫たちのところへ送った。","tok":[["さて"],["、"],["収穫","しゅうかく"],["の"],["時","とき"],["が"],["近づいた","ちかづいた"],["とき"],["、"],["収穫","しゅうかく"],["を"],["受け取る","うけとる"],["ため"],["に"],["、"],["僕たち","ぼくたち"],["を"],["農夫","のうふ"],["たち"],["の"],["ところ"],["へ"],["送った","おくった"],["。"]]},{"verse":35,"text":"だが、農夫たちはこの僕たちを捕まえ、一人を袋だたきにし、一人を殺し、一人を石で打ち殺した。","tok":[["だ"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["この"],["僕たち","ぼくたち"],["を"],["捕まえ","つかまえ"],["、"],["一人","ひとり"],["を"],["袋だたき","ふくろだたき"],["に"],["し"],["、"],["一人","ひとり"],["を"],["殺し","ころし"],["、"],["一人","ひとり"],["を"],["石","いし"],["で"],["打ち殺した","うちころした"],["。"]]},{"verse":36,"text":"また、他の僕たちを前よりも多く送ったが、農夫たちは同じ目に遭わせた。","tok":[["また"],["、"],["他","た"],["の"],["僕たち","ぼくたち"],["を"],["前","まえ"],["より"],["も"],["多く","おおく"],["送った","おくった"],["が"],["、"],["農夫","のうふ"],["たち"],["は"],["同じ","おなじ"],["目","め"],["に"],["遭わせた","あわせた"],["。"]]},{"verse":37,"text":"そこで最後に、『わたしの息子なら敬ってくれるだろう』と言って、主人は自分の息子を送った。","tok":[["そこ"],["で"],["最後","さいご"],["に"],["、"],["『"],["わたし"],["の"],["息子","むすこ"],["なら"],["敬って","うやまって"],["くれるだろう"],["』"],["と"],["言って","いって"],["、"],["主人","しゅじん"],["は"],["自分","じぶん"],["の"],["息子","むすこ"],["を"],["送った","おくった"],["。"]]},{"verse":38,"text":"農夫たちは、その息子を見て話し合った。『これは跡取りだ。さあ、殺して、彼の相続財産を我々のものにしよう。』","tok":[["農夫","のうふ"],["たち"],["は"],["、"],["その"],["息子","むすこ"],["を"],["見て","みて"],["話し合った","はなしあった"],["。"],["『"],["これ"],["は"],["跡取り","あととり"],["だ"],["。"],["さあ"],["、"],["殺して","ころして"],["、"],["彼","かれ"],["の"],["相続
[{"verse":1,"text":"「人を裁くな。あなたがたも裁かれないようにするためである。","tok":[["「"],["人","ひと"],["を"],["裁く","さばく"],["な"],["。"],["あなた"],["がた"],["も"],["裁かれない","さばかれない"],["よう"],["に"],["する"],["ため"],["で"],["ある"],["。"]]},{"verse":2,"text":"あなたがたは、自分の裁く裁きで裁かれ、自分の量る秤で量り与えられる。","tok":[["あなた"],["がた"],["は"],["、"],["自分","じぶん"],["の"],["裁く","さばく"],["裁き","さばき"],["で"],["裁かれ","さばかれ"],["、"],["自分","じぶん"],["の"],["量る","はかる"],["秤","はかり"],["で"],["量り","はかり"],["与えられる","あたえられる"],["。"]]},{"verse":3,"text":"あなたは、兄弟の目にあるおが屑は見えるのに、なぜ自分の目の中の丸太に気づかないのか。","tok":[["あなた"],["は"],["、"],["兄弟","きょうだい"],["の"],["目","め"],["に"],["ある"],["おが屑","おがくず"],["は"],["見える","みえる"],["のに"],["、"],["なぜ"],["自分","じぶん"],["の"],["目","め"],["の"],["中","なか"],["の"],["丸太","まるた"],["に"],["気づかない","きづかない"],["の"],["か"],["。"]]},{"verse":4,"text":"兄弟に向かって、『あなたの目からおが屑を取らせてください』と、どうして言えようか。自分の目に丸太があるではないか。","tok":[["兄弟","きょうだい"],["に"],["向かって","むかって"],["、"],["『"],["あなた"],["の"],["目","め"],["から"],["おが屑","おがくず"],["を"],["取らせて","とらせて"],["ください"],["』"],["と"],["、"],["どう"],["して"],["言えよう","いえよう"],["か"],["。"],["自分","じぶん"],["の"],["目","め"],["に"],["丸太","まるた"],["が"],["ある"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":5,"text":"偽善者よ、まず自分の目から丸太を取り除け。そうすれば、はっきり見えるようになって、兄弟の目からおが屑を取り除くことができる。","tok":[["偽善者","ぎぜんしゃ"],["よ"],["、"],["まず"],["自分","じぶん"],["の"],["目","め"],["から"],["丸太","まるた"],["を"],["取り除け","とりのぞけ"],["。"],["そう"],["すれば"],["、"],["はっきり"],["見える","みえる"],["よう"],["に"],["なって"],["、"],["兄弟","きょうだい"],["の"],["目","め"],["から"],["おが屑","おがくず"],["を"],["取り除く","とりのぞく"],["こと"],["が"],["できる"],["。"]]},{"verse":6,"text":"神聖なものを犬に与えてはならず、また、真珠を豚に投げてはならない。それを足で踏みにじり、向き直ってあなたがたにかみついてくるだろう。」","tok":[["神聖","しんせい"],["な"],["もの"],["を"],["犬","いぬ"],["に"],["与えて","あたえて"],["は"],["ならず"],["、"],["また"],["、"],["真珠","しんじゅ"],["を"],["豚","ぶた"],["に"],["投げて","なげて"],["は"],["ならない"],["。"],["それ"],["を"],["足","あし"],["で"],["踏みにじり","ふみにじり"],["、"],["向き直って","むきなおって"],["あなた"],["がた"],["に"],["かみついて"],["くるだろう"],["。"],["」"]]},{"verse":7,"text":"「求めなさい。そうすれば、与えられる。探しなさい。そうすれば、見つかる。門をたたきなさい。そうすれば、開かれる。","tok":[["「"],["求め","もとめ"],["なさい"],["。"],["そ
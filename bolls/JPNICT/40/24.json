[{"verse":1,"text":"イエスが神殿の境内を出て行かれると、弟子たちが近寄って来て、イエスに神殿の建物を指さした。","tok":[["イエス"],["が"],["神殿","しんでん"],["の"],["境内","けいだい"],["を"],["出て","でて"],["行かれる","いかれる"],["と"],["、"],["弟子","でし"],["たち"],["が"],["近寄って","ちかよって"],["来て","きて"],["、"],["イエス"],["に"],["神殿","しんでん"],["の"],["建物","たてもの"],["を"],["指さした","ゆびさした"],["。"]]},{"verse":2,"text":"そこで、イエスは言われた。「これらすべての物を見ないのか。はっきり言っておく。一つの石もここで崩されずに他の石の上に残ることはない。」","tok":[["そこ"],["で"],["、"],["イエス"],["は"],["言われた","いわれた"],["。"],["「"],["これ"],["ら"],["すべて"],["の"],["物","もの"],["を"],["見ない","みない"],["の"],["か"],["。"],["はっきり"],["言って","いって"],["おく"],["。"],["一","ひと"],["つ"],["の"],["石","いし"],["も"],["ここ"],["で"],["崩されず","くずされず"],["に"],["他","ほか"],["の"],["石","いし"],["の"],["上","うえ"],["に"],["残る","のこる"],["こと"],["は"],["ない"],["。"],["」"]]},{"verse":3,"text":"イエスがオリーブ山で座っておられると、弟子たちがやって来て、ひそかに言った。「おっしゃってください。そのことはいつ起こるのですか。また、あなたが来られて世の終わるときには、どんな徴があるのですか。」","tok":[["イエス"],["が"],["オリーブ"],["山","さん"],["で"],["座って","すわって"],["おられる"],["と"],["、"],["弟子","でし"],["たち"],["が"],["やって"],["来て","きて"],["、"],["ひそか"],["に"],["言った","いった"],["。"],["「"],["おっしゃって"],["ください"],["。"],["その"],["こと"],["は"],["いつ"],["起こる","おこる"],["の"],["です"],["か"],["。"],["また"],["、"],["あなた"],["が"],["来られて","こられて"],["世","よ"],["の"],["終わる","おわる"],["とき"],["に"],["は"],["、"],["どんな"],["徴","しるし"],["が"],["ある"],["の"],["です"],["か"],["。"],["」"]]},{"verse":4,"text":"イエスはお答えになった。「人に惑わされないように気をつけなさい。","tok":[["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["人","ひと"],["に"],["惑わされない","まどわされない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":5,"text":"わたしの名を名乗る者が大勢現れ、『わたしがメシアだ』と言って、多くの人を惑わすだろう。","tok":[["わたし"],["の"],["名","な"],["を"],["名乗る","なのる"],["者","もの"],["が"],["大勢","おおぜい"],["現れ","あらわれ"],["、"],["『"],["わたし"],["が"],["メシア"],["だ"],["』"],["と"],["言って","いって"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["惑わすだろう","まどわすだろう"],["。"]]},{"verse":6,"text":"戦争の騒ぎや戦争のうわさを聞くだろうが、慌てないように気をつけなさい。そういうことは起こるに決まっているが、まだ世の終わりではない。","tok":[["戦争","せんそう"],["の"],["騒ぎ","さわぎ"],["や"],["戦争","せんそう"],["の"],["うわさ"],["を"],["聞くだろう","きくだろう"],["が"],["、"],["慌てない","あわてない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"],["そう"],["いう"],["こと"],["は"],["起こる","おこる"],["に"],["決まって","きまって"],["いる"],["が"],["、"],["まだ"],["世","よ"],["の"],["終わり","おわり"],["で"],["は"],["ない"],["。"]]},{"verse":7,"text":"民は民に、国は国に敵対して立ち上がり、方々に飢饉や地震が起こる。","tok":[["民","みん"],["は"],["民","みん"],["に"],["、"],["国","くに"],["は"],["国","くに"],["に"],["敵対","てきたい"],["して"],["立ち上がり","たちあがり"],["、"],["方々","かたがた"],["に"],["飢饉","ききん"],["や"],["地震","じしん"],["が"],["起こる","おこる"],["。"]]},{"verse":8,"text":"しかし、これらはすべて産みの苦しみの始まりである。","tok":[["しかし"],["、"],["これ"],["ら"],["は"],["すべて"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["の"],["始まり","はじまり"],["で"],["ある"],["。"]]},{"verse":9,"text":"そのとき、あなたがたは苦しみを受け、殺される。また、わたしの名のために、あなたがたはあらゆる民に憎まれる。","tok":[["その"],["とき"],["、"],["あなた"],["がた"],["は"],["苦しみ","くるしみ"],["を"],["受け","うけ"],["、"],["殺される","ころされる"],["。"],["また"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["は"],["あらゆる"],["民","たみ"],["に"],["憎まれる","にくまれる"],["。"]]},{"verse":10,"text":"そのとき、多くの人がつまずき、互いに裏切り、憎み合うようになる。","tok":[["その"],["とき"],["、"],["多く","おおく"],["の"],["人","ひと"],["が"],["つまずき"],["、"],["互い","たがい"],["に"],["裏切り","うらぎり"],["、"],["憎み合う","にくみあう"],["よう"],["に"],["なる"],["。"]]},{"verse":11,"text":"偽預言者も大勢現れ、多くの人を惑わす。","tok":[["偽","にせ"],["預言者","よげんしゃ"],["も"],["大勢","おおぜい"],["現れ","あらわれ"],["、"],["多く","おおく"],["の"],["人","ひと"],["を"],["惑わす","まどわす"],["。"]]},{"verse":12,"text":"不法がはびこるので、多くの人の愛が冷える。","tok":[["不法","ふほう"],["が"],["はびこる"],["ので"],["、"],["多く","おおく"],["の"],["人","ひと"],["の"],["愛","あい"],["が"],["冷える","ひえる"],["。"]]},{"verse":13,"text":"しかし、最後まで耐え忍ぶ者は救われる。","tok":[["しかし"],["、"],["最後","さいご"],["まで"],["耐え忍ぶ","たえしのぶ"],["者","もの"],["は"],["救われる","すくわれる"],["。"]]},{"verse":14,"text":"そして、御国のこの福音はあらゆる民への証しとして、全世界に宣べ伝えられる。それから、終わりが来る。」","tok":[["そして"],["、"],["御国","みくに"],["の"],["この"],["福音","ふくいん"],["は"],["あらゆる"],["民","たみ"],["へ"],["の"],["証し","あかし"],["として"],["、"],["全","ぜん"],["世界","せかい"],["に"],["宣べ伝えられる","のべつたえられる"],["。"],["それ"],["から"],["、"],["終わり","おわり"],["が"],["来る","くる"],["。"],["」"]]},{"verse":15,"text":"「預言者ダニエルの言った憎むべき破壊者が、聖なる場所に立つのを見たら――読者は悟れ――、","tok":[["「"],["預言者","よげんしゃ"],["ダニエル"],["の"],["言った","いった"],["憎むべき","にくむべき"],["破壊者","はかいしゃ"],["が"],["、"],["聖","せい"],["なる"],["場所","ばしょ"],["に"],["立つ","たつ"],["の"],["を"],["見たら","みたら"],["―"],["―"],["読者","どくしゃ"],["は"],["悟れ","さとれ"],["―"],["―"],["、"]]},{"verse":16,"text":"そのとき、ユダヤにいる人々は山に逃げなさい。","tok":[["その"],["とき"],["、"],["ユダヤ"],["に"],["いる"],["人々","ひとびと"],["は"],["山","やま"],["に"],["逃げ","にげ"],["なさい"],["。"]]},{"verse":17,"text":"屋上にいる者は、家にある物を取り出そうとして下に降りてはならない。","tok":[["屋上","おくじょう"],["に"],["いる"],["者","もの"],["は"],["、"],["家","いえ"],["に"],["ある"],["物","もの"],["を"],["取り出そう","とりだそう"],["として"],["下","した"],["に"],["降りて","おりて"],["は"],["ならない"],["。"]]},{"verse":18,"text":"畑にいる者は、上着を取りに帰ってはならない。","tok":[["畑","はたけ"],["に"],["いる"],["者","もの"],["は"],["、"],["上着","うわぎ"],["を"],["取り","とり"],["に"],["帰って","かえって"],["は"],["ならない"],["。"]]},{"verse":19,"text":"それらの日には、身重の女と乳飲み子を持つ女は不幸だ。","tok":[["それ"],["ら"],["の"],["日","ひ"],["に"],["は"],["、"],["身重","みおも"],["の"],["女","おんな"],["と"],["乳飲み子","ちのみご"],["を"],["持つ","もつ"],["女","おんな"],["は"],["不幸","ふこう"],["だ"],["。"]]},{"verse":20,"text":"逃げるのが冬や安息日にならないように、祈りなさい。","tok":[["逃げる","にげる"],["の"],["が"],["冬","ふゆ"],["や"],["安息日","あんそくび"],["に"],["ならない"],["よう"],["に"],["、"],["祈り","いのり"],["なさい"],["。"]]},{"verse":21,"text":"そのときには、世界の初めから今までなく、今後も決してないほどの大きな苦難が来るからである。","tok":[["その"],["とき"],["に"],["は"],["、"],["世界","せかい"],["の"],["初め","はじめ"],["から"],["今まで","いままで"],["なく"],["、"],["今後","こんご"],["も"],["決して","けっして"],["ない"],["ほど"],["の"],["大きな","おおきな"],["苦難","くなん"],["が"],["来る","くる"],["から"],["で"],["ある"],["。"]]},{"verse":22,"text":"神がその期間を縮めてくださらなければ、だれ一人救われない。しかし、神は選ばれた人たちのために、その期間を縮めてくださるであろう。","tok":[["神","かみ"],["が"],["その"],["期間","きかん"],["を"],["縮めて","ちぢめて"],["くださらなければ"],["、"],["だれ"],["一人","ひとり"],["救われない","すくわれない"],["。"],["しかし"],["、"],["神","かみ"],["は"],["選ばれた","えらばれた"],["人","ひと"],["たち"],["の"],["ため"],["に"],["、"],["その"],["期間","きかん"],["を"],["縮めて","ちぢめて"],["くださるで"],["あろう"],["。"]]},{"verse":23,"text":"そのとき、『見よ、ここにメシアがいる』『いや、ここだ』と言う者がいても、信じてはならない。","tok":[["その"],["とき"],["、"],["『"],["見よ","みよ"],["、"],["ここ"],["に"],["メシア"],["が"],["いる"],["』"],["『"],["いや"],["、"],["ここ"],["だ"],["』"],["と"],["言う","いう"],["者","もの"],["が"],["いて"],["も"],["、"],["信じて","しんじて"],["は"],["ならない"],["。"]]},{"verse":24,"text":"偽メシアや偽預言者が現れて、大きなしるしや不思議な業を行い、できれば、選ばれた人たちをも惑わそうとするからである。","tok":[["偽","にせ"],["メシア"],["や"],["偽","にせ"],["預言者","よげんしゃ"],["が"],["現れて","あらわれて"],["、"],["大きな","おおきな"],["しるし"],["や"],["不思議","ふしぎ"],["な"],["業","ごう"],["を"],["行い","おこない"],["、"],["できれば"],["、"],["選ばれた","えらばれた"],["人","ひと"],["たち"],["を"],["も"],["惑わそう","まどわそう"],["と"],["する"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"あなたがたには前もって言っておく。","tok":[["あなた"],["がた"],["に"],["は"],["前もって","まえもって"],["言って","いって"],["おく"],["。"]]},{"verse":26,"text":"だから、人が『見よ、メシアは荒れ野にいる』と言っても、行ってはならない。また、『見よ、奥の部屋にいる』と言っても、信じてはならない。","tok":[["だ"],["から"],["、"],["人","ひと"],["が"],["『"],["見よ","みよ"],["、"],["メシア"],["は"],["荒れ野","あれの"],["に"],["いる"],["』"],["と"],["言って","いって"],["も"],["、"],["行って","いって"],["は"],["ならない"],["。"],["また"],["、"],["『"],["見よ","みよ"],["、"],["奥","おく"],["の"],["部屋","へや"],["に"],["いる"],["』"],["と"],["言って","いって"],["も"],["、"],["信じて","しんじて"],["は"],["ならない"],["。"]]},{"verse":27,"text":"稲妻が東から西へひらめき渡るように、人の子も来るからである。","tok":[["稲妻","いなずま"],["が"],["東","ひがし"],["から"],["西","にし"],["へ"],["ひらめき"],["渡る","わたる"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["も"],["来る","くる"],["から"],["で"],["ある"],["。"]]},{"verse":28,"text":"死体のある所には、はげ鷹が集まるものだ。」","tok":[["死体","したい"],["の"],["ある"],["所","ところ"],["に"],["は"],["、"],["はげ鷹","はげたか"],["が"],["集まる","あつまる"],["もの"],["だ"],["。"],["」"]]},{"verse":29,"text":"「その苦難の日々の後、たちまち太陽は暗くなり、月は光を放たず、星は空から落ち、天体は揺り動かされる。","tok":[["「"],["その"],["苦難","くなん"],["の"],["日々","ひび"],["の"],["後","あと"],["、"],["たちまち"],["太陽","たいよう"],["は"],["暗く","くらく"],["なり"],["、"],["月","つき"],["は"],["光","ひかり"],["を"],["放たず","はなたず"],["、"],["星","ほし"],["は"],["空","そら"],["から"],["落ち","おち"],["、"],["天体","てんたい"],["は"],["揺り動かされる","ゆりうごかされる"],["。"]]},{"verse":30,"text":"そのとき、人の子の徴が天に現れる。そして、そのとき、地上のすべての民族は悲しみ、人の子が大いなる力と栄光を帯びて天の雲に乗って来るのを見る。","tok":[["その"],["とき"],["、"]
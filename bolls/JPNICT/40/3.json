[{"verse":1,"text":"そのころ、洗礼者ヨハネが現れて、ユダヤの荒れ野で宣べ伝え、","tok":[["その"],["ころ"],["、"],["洗礼者","せんれいしゃ"],["ヨハネ"],["が"],["現れて","あらわれて"],["、"],["ユダヤ"],["の"],["荒れ野","あれの"],["で"],["宣べ伝え","のべつたえ"],["、"]]},{"verse":2,"text":"「悔い改めよ。天の国は近づいた」と言った。","tok":[["「"],["悔い改め","くいあらため"],["よ"],["。"],["天","てん"],["の"],["国","くに"],["は"],["近づいた","ちかづいた"],["」"],["と"],["言った","いった"],["。"]]},{"verse":3,"text":"これは預言者イザヤによってこう言われている人である。「荒れ野で叫ぶ者の声がする。『主の道を整え、その道筋をまっすぐにせよ。』」","tok":[["これ"],["は"],["預言者","よげんしゃ"],["イザヤ"],["によって"],["こう"],["言われて","いわれて"],["いる"],["人","ひと"],["で"],["ある"],["。"],["「"],["荒れ野","あれの"],["で"],["叫ぶ","さけぶ"],["者","もの"],["の"],["声","こえ"],["が"],["する"],["。"],["『"],["主","ぬし"],["の"],["道","みち"],["を"],["整え","ととのえ"],["、"],["その"],["道筋","みちすじ"],["を"],["まっすぐ"],["に"],["せよ"],["。"],["』"],["」"]]},{"verse":4,"text":"ヨハネは、らくだの毛衣を着、腰に革の帯を締め、いなごと野蜜を食べ物としていた。","tok":[["ヨハネ"],["は"],["、"],["らくだ"],["の"],["毛衣","けごろも"],["を"],["着","き"],["、"],["腰","こし"],["に"],["革","かわ"],["の"],["帯","おび"],["を"],["締め","しめ"],["、"],["いなご"],["と"],["野","の"],["蜜","みつ"],["を"],["食べ物","たべもの"],["として"],["いた"],["。"]]},{"verse":5,"text":"そこで、エルサレムとユダヤ全土から、また、ヨルダン川沿いの地方一帯から、人々がヨハネのもとに来て、","tok":[["そこ"],["で"],["、"],["エルサレム"],["と"],["ユダヤ"],["全土","ぜんど"],["から"],["、"],["また"],["、"],["ヨルダン"],["川沿い","かわぞい"],["の"],["地方","ちほう"],["一帯","いったい"],["から"],["、"],["人々","ひとびと"],["が"],["ヨハネ"],["の"],["もと"],["に"],["来て","きて"],["、"]]},{"verse":6,"text":"罪を告白し、ヨルダン川で彼から洗礼を受けた。","tok":[["罪","つみ"],["を"],["告白","こくはく"],["し"],["、"],["ヨルダン"],["川","かわ"],["で"],["彼","かれ"],["から"],["洗礼","せんれい"],["を"],["受けた","うけた"],["。"]]},{"verse":7,"text":"ヨハネは、ファリサイ派やサドカイ派の人々が大勢、洗礼を受けに来たのを見て、こう言った。「蝮の子らよ、差し迫った神の怒りを免れると、だれが教えたのか。","tok":[["ヨハネ"],["は"],["、"],["ファリサイ"],["派","は"],["や"],["サドカイ"],["派","は"],["の"],["人々","ひとびと"],["が"],["大勢","おおぜい"],["、"],["洗礼","せんれい"],["を"],["受け","うけ"],["に"],["来た","きた"],["の"],["を"],["見て","みて"],["、"],["こう"],["言った","いった"],["。"],["「"],["蝮","まむし"],["の"],["子","こ"],["ら"],["よ"],["、"],["差し迫った","さしせまった"],["神","かみ"],["の"],["怒り","いかり"],["を"],["免れる","まぬがれる"],["と"],["、"],["だれ"],["が"],["教えた","おしえた"],["の"],["か"],["。"]]},{"verse":8,"text":"悔い改めにふさわしい実を結べ。","tok":[["悔い改め","くいあらため"],["に"],["ふさわしい"],["実","じつ"],["を"],["結べ","むすべ"],["。"]]},{"verse":9,"text":"『我々の父はアブラハムだ』などと思ってもみるな。言っておくが、神はこんな石からでも、アブラハムの子たちを造り出すことがおできになる。","tok":[["『"],["我々","われわれ"],["の"],["父","ちち"],["は"],["アブラハム"],["だ"],["』"],["など"],["と"],["思って","おもって"],["も"],["みる"],["な"],["。"],["言って","いって"],["おく"],["が"],["、"],["神","かみ"],["は"],["こんな"],["石","いし"],["から"],["で"],["も"],["、"],["アブラハム"],["の"],["子","こ"],["たち"],["を"],["造り出す","つくりだす"],["こと"],["が"],["おでき"],["に"],["なる"],["。"]]},{"verse":10,"text":"斧は既に木の根元に置かれている。良い実を結ばない木はみな、切り倒されて火に投げ込まれる。","tok":[["斧","おの"],["は"],["既に","すでに"],["木","き"],["の"],["根元","ねもと"],["に"],["置かれて","おかれて"],["いる"],["。"],["良い","よい"],["実","じつ"],["を"],["結ばない","むすばない"],["木","き"],["は"],["みな"],["、"],["切り倒されて","きりたおされて"],["火","ひ"],["に"],["投げ込まれる","なげこまれる"],["。"]]},{"verse":11,"text":"わたしは、悔い改めに導くために、あなたたちに水で洗礼を授けているが、わたしの後から来る方は、わたしよりも優れておられる。わたしは、その履物をお脱がせする値打ちもない。その方は、聖霊と火であなたたちに洗礼をお授けになる。","tok":[["わたし"],["は"],["、"],["悔い改め","くいあらため"],["に"],["導く","みちびく"],["ため"],["に"],["、"],["あなた"],["たち"],["に"],["水","みず"],["で"],["洗礼","せんれい"],["を"],["授けて","さずけて"],["いる"],["が"],["、"],["わたし"],["の"],["後","あと"],["から"],["来る","くる"],["方","かた"],["は"],["、"],["わたし"],["より"],["も"],["優れて","すぐれて"],["おられる"],["。"],["わたし"],["は"],["、"],["その"],["履物","はきもの"],["を"],["お脱がせ","おぬがせ"],["する"],["値打ち","ねうち"],["も"],["ない"],["。"],["その"],["方","かた"],["は"],["、"],["聖霊","せいれい"],["と"],["火","ひ"],["で"],["あなた"],["たち"],["に"],["洗礼","せんれい"],["を"],["お授け","おさずけ"],["に"],["なる"],["。"]]},{"verse":12,"text":"そして、手に箕を持って、脱穀場を隅々まできれいにし、麦を集めて倉に入れ、殻を消えることのない火で焼き払われる。」","tok":[["そして"],["、"],["手","て"],["に"],["箕","み"],["を"],["持って","もって"],["、"],["脱穀場","だっこくじょう"],["を"],["隅々","すみずみ"],["まで"],["きれい"],["に"],["し"],["、"],["麦","むぎ"],["を"],["集めて","あつめて"],["倉","くら"],["に"],["入れ","いれ"],["、"],["殻","から"],["を"],["消える","きえる"],["こと"],["の"],["ない"],["火","ひ"],["で"],["焼き払われる","やきはらわれる"],["。"],["」"]]},{"verse":13,"text":"そのとき、イエスが、ガリラヤからヨルダン川のヨハネのところへ来られた。彼から洗礼を受けるためである。","tok":[["その"],["とき"],["、"],["イエス"],["が"],["、"],["ガリラヤ"],["から"],["ヨルダン"],["川","かわ"],["の"],["ヨハネ"],["の"],["ところ"],["へ"],["来られた","こられた"],["。"],["彼","かれ"],["から"],["洗礼","せんれい"],["を"],["受ける","うける"],["ため"],["で"],["ある"],["。"]]},{"verse":14,"text":"ところが、ヨハネは、それを思いとどまらせようとして言った。「わたしこそ、あなたから洗礼を受けるべきなのに、あなたが、わたしのところへ来られたのですか。」","tok":[["ところ"],["が"],["、"],["ヨハネ"],["は"],["、"],["それ"],["を"],["思いとどまらせよう","おもいとどまらせよう"],["として"],["言った","いった"],["。"],["「"],["わたし"],["こそ"],["、"],["あなた"],["から"],["洗礼","せんれい"],["を"],["受けるべきな","うけるべきな"],["のに"],["、"],["あなた"],["が"],["、"],["わたし"],["の"],["ところ"],["へ"],["来られた","こられた"],["の"],["です"],["か"],["。"],["」"]]},{"verse":15,"text":"しかし、イエスはお答えになった。「今は、止めないでほしい。正しいことをすべて行うのは、我々にふさわしいことです。」そこで、ヨハネはイエスの言われるとおりにした。","tok":[["しかし"],["、"],["イエス"],["は"],["お答え","おこたえ"],["に"],["なった"],["。"],["「"],["今","いま"],["は"],["、"],["止めないで","とめないで"],["ほしい"],["。"],["正しい","ただしい"],["こと"],["を"],["すべて"],["行う","おこなう"],["の"],["は"],["、"],["我々","われわれ"],["に"],["ふさわしい"],["こと"],["です"],["。"],["」"],["そこ"],["で"],["、"],["ヨハネ"],["は"],["イエス"],["の"],["言われる","いわれる"],["とおり"],["に"],["した"],["。"]]},{"verse":16,"text":"イエスは洗礼を受けると、すぐ水の中から上がられた。そのとき、天がイエスに向かって開いた。イエスは、神の霊が鳩のように御自分の上に降って来るのを御覧になった。","tok":[["イエス"],["は"],["洗礼","せんれい"],["を"],["受ける","うける"],["と"],["、"],["すぐ"],["水","みず"],["の"],["中","なか"],["から"],["上がられた","あがられた"],["。"],["その"],["とき"],["、"],["天","てん"],["が"],["イエス"],["に"],["向かって","むかって"],["開いた","ひらいた"],["。"],["イエス"],["は"],["、"],["神","かみ"],["の"],["霊","れい"],["が"],["鳩","はと"],["の"],["よう"],["に"],["御自分","ごじぶん"],["の"],["上","うえ"],["に"],["降って","ふって"],["来る","くる"],["の"],["を"],["御覧","ごらん"],["に"],["なった"],["。"]]},{"verse":17,"text":"そのとき、「これはわたしの愛する子、わたしの心に適う者」と言う声が、天から聞こえた。","tok":[["その"],["とき"],["、"],["「"],["これ"],["は"],["わたし"],["の"],["愛する","あいする"],["子","こ"],["、"],["わたし"],["の"],["心","こころ"],["に"],["適う","かなう"],["者","もの"],["」"],["と"],["言う","いう"],["声","こえ"],["が"],["、"],["天","てん"],["から"],["聞こえた","きこえた"],["。"]]}]
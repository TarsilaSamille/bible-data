[{"verse":1,"text":"わが愛,あいする者,ものよ、見,みよ、あなたは美,うつくしい、見,みよ、あなたは美,うつくしい。あなたの目,めは、顔,かおおおいのうしろにあって、はとのようだ。あなたの髪,かみはギレアデの山,やまを下,くだるやぎの群,むれのようだ。","tok":[["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["見よ","みよ"],["、"],["あなた"],["は"],["美しい","うつくしい"],["、"],["見よ","みよ"],["、"],["あなた"],["は"],["美しい","うつくしい"],["。"],["あなた"],["の"],["目","め"],["は"],["、"],["顔","かお"],["おおい"],["の"],["うしろ"],["に"],["あって"],["、"],["はと"],["の"],["よう"],["だ"],["。"],["あなた"],["の"],["髪","かみ"],["は"],["ギレアデ"],["の"],["山","やま"],["を"],["下る","くだる"],["やぎ"],["の"],["群れ","むれ"],["の"],["よう"],["だ"],["。"]]},{"verse":2,"text":"あなたの歯,はは洗,あらい場,ばから上,のぼってきた毛,けを切,きられた雌,め羊,ひつじの群,むれのようだ。みな二子,ふたごを産,うんで、一匹,ぴきも子,このないものはない。","tok":[["あなた"],["の"],["歯","は"],["は"],["洗場","あらいば"],["から"],["上って","のぼって"],["きた"],["毛","け"],["を"],["切られた","きられた"],["雌羊","めひつじ"],["の"],["群れ","むれ"],["の"],["よう"],["だ"],["。"],["みな"],["二子","ふたご"],["を"],["産んで","うんで"],["、"],["一匹","ぴき"],["も"],["子","こ"],["の"],["ない"],["もの"],["は"],["ない"],["。"]]},{"verse":3,"text":"あなたのくちびるは紅,べにの糸,いとのようで、その口,くちは愛,あいらしい。あなたのほおは顔,かおおおいのうしろにあって、ざくろの片,かたわれのようだ。","tok":[["あなた"],["の"],["くちびる"],["は"],["紅","べに"],["の"],["糸","いと"],["の"],["よう"],["で"],["、"],["その"],["口","くち"],["は"],["愛らしい","あいらしい"],["。"],["あなた"],["の"],["ほお"],["は"],["顔","かお"],["おおい"],["の"],["うしろ"],["に"],["あって"],["、"],["ざくろ"],["の"],["片われ","かたわれ"],["の"],["よう"],["だ"],["。"]]},{"verse":4,"text":"あなたの首,くびは武器,ぶき倉,くらのために建,たてたダビデのやぐらのようだ。その上,うえには一千の盾,たてを掛,かけつらね、みな勇士,ゆうしの大盾,おおだてである。","tok":[["あなた"],["の"],["首","くび"],["は"],["武器倉","ぶきくら"],["の"],["ため"],["に"],["建てた","たてた"],["ダビデ"],["の"],["やぐら"],["の"],["よう"],["だ"],["。"],["その"],["上","うえ"],["に"],["は"],["一千","いちせん"],["の"],["盾","たて"],["を"],["掛","かけ"],["つらね"],["、"],["みな"],["勇士","ゆうし"],["の"],["大","だい"],["盾","たて"],["おだて"],["で"],["ある"],["。"]]},{"verse":5,"text":"あなたの両,りょう乳,ちぶさは、かもしかの二子,ふたごである二匹,ひきの子,こじかが、ゆりの花,はなの中,なかに草,くさを食,たべているようだ。","tok":[["あなた"],["の"],["両","りょう"],["乳ぶさ","ちぶさ"],["は"],["、"],["かもしか"],["の"],["二子","ふ"],["たご"],["で"],["ある"],["二匹","ひき"],["の"],["子","こ"],["じか"],["が"],["、"],["ゆり"],["の"],["花","はな"],["の"],["中","なか"],["に"],["草","くさ"],["を"],["食べて","たべて"],["いる"],["よう"],["だ"],["。"]]},{"verse":6,"text":"日,ひの涼,すずしくなるまで、影,かげの消,きえるまで、わたしは没薬,もつやくの山,やまおよび乳香,にゅうこうの丘,おかへ急,いそぎ行,いこう。","tok":[["日","ひ"],["の"],["涼しく","すずしく"],["なる"],["まで"],["、"],["影","かげ"],["の"],["消える","きえる"],["まで"],["、"],["わたし"],["は"],["没薬","もつやく"],["の"],["山","やま"],["および"],["乳香","にゅうこう"],["の"],["丘","おか"],["へ"],["急ぎ","いそぎ"],["行こう","いこう"],["。"]]},{"verse":7,"text":"わが愛,あいする者,ものよ、あなたはことごとく美,うつくしく、少,すこしのきずもない。","tok":[["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["あなた"],["は"],["ことごとく"],["美しく","うつくしく"],["、"],["少し","すこし"],["の"],["きず"],["も"],["ない"],["。"]]},{"verse":8,"text":"わが花嫁,はなよめよ、レバノンからわたしと一緒,いっしょにきなさい、レバノンからわたしと一緒,いっしょにきなさい。アマナの頂,いただきを去,さり、セニルおよびヘルモンの頂,いただきを去,さり、ししの穴,あな、ひょうの山,やまを去,さりなさい。","tok":[["わが"],["花嫁","はなよめ"],["よ"],["、"],["レバノン"],["から"],["わたし"],["と"],["一緒","いっしょ"],["に"],["き"],["なさい"],["、"],["レバノン"],["から"],["わたし"],["と"],["一緒","いっしょ"],["に"],["き"],["なさい"],["。"],["アマナ"],["の"],["頂","いただき"],["を"],["去り","さり"],["、"],["セニル"],["および"],["ヘルモン"],["の"],["頂","いただき"],["を"],["去り","さり"],["、"],["しし"],["の"],["穴","あな"],["、"],["ひょう"],["の"],["山","やま"],["を"],["去り","さり"],["なさい"],["。"]]},{"verse":9,"text":"わが妹,いもうと、わが花嫁,はなよめよ、あなたはわたしの心,こころを奪,うばった。あなたはただひと目,めで、あなたの首,くび飾,かざりのひと玉,たまで、わたしの心,こころを奪,うばった。","tok":[["わが"],["妹","いもうと"],["、"],["わが"],["花嫁","はなよめ"],["よ"],["、"],["あなた"],["は"],["わたし"],["の"],["心","こころ"],["を"],["奪った","うばった"],["。"],["あなた"],["は"],["ただ"],["ひと目","ひとめ"],["で"],["、"],["あなた"],["の"],["首","くび"],["飾","かざり"],["の"],["ひと"],["玉","たま"],["で"],["、"],["わたし"],["の"],["心","こころ"],["を"],["奪った","うばった"],["。"]]},{"verse":10,"text":"わが妹,いもうと、わが花嫁,はなよめよ、あなたの愛,あいは、なんと麗,うるわしいことであろう。あなたの愛,あいはぶどう酒,しゅよりも、あなたの香油,こうゆのかおりはすべての香料,こうりょうよりも、いかにすぐれていることであろう。","tok":[["わが"],["妹","いもうと"],["、"],["わが"],["花嫁","はなよめ"],["よ"],["、"],["あなた"],["の"],["愛","あい"],["は"],["、"],["なん"],["と"],["麗わしい","うるわしい"],["こと"],["で"],["あろう"],["。"],["あなた"],["の"],["愛","あい"],["は"],["ぶどう酒","ぶどうしゅ"],["より"],["も"],["、"],["あなた"],["の"],["香油","こうゆ"],["の"],["かおり"],["は"],["すべて"],["の"],["香料","こうりょう"],["より"],["も"],["、"],["いかに"],["すぐれて"],["いる"],["こと"],["で"],["あろう"],["。"]]},{"verse":11,"text":"わが花嫁,はなよめよ、あなたのくちびるは甘露,かんろをしたたらせ、あなたの舌,したの下,したには、蜜,みつと乳,ちちとがある。あなたの衣,ころものかおりはレバノンのかおりのようだ。","tok":[["わが"],["花嫁","はなよめ"],["よ"],["、"],["あなた"],["の"],["くちびる"],["は"],["甘露","かんろ"],["を"],["したたらせ"],["、"],["あなた"],["の"],["舌","した"],["の"],["下","した"],["に"],["は"],["、"],["蜜","みつ"],["と"],["乳","ちち"],["と"],["が"],["ある"],["。"],["あなた"],["の"],["衣","ころも"],["の"],["かおり"],["は"],["レバノン"],["の"],["かおり"],["の"],["よう"],["だ"],["。"]]},{"verse":12,"text":"わが妹,いもうと、わが花嫁,はなよめは閉,とじた園,その、閉,とじた園,その、封,ふうじた泉,いずみのようだ。","tok":[["わが"],["妹","いもうと"],["、"],["わが"],["花嫁","はなよめ"],["は"],["閉じた","とじた"],["園","その"],["、"],["閉じた","とじた"],["園","その"],["、"],["封じた","ふうじた"],["泉","いずみ"],["の"],["よう"],["だ"],["。"]]},{"verse":13,"text":"あなたの産,うみ出,だす物,ものは、もろもろの良,よき実,みをもつざくろの園,その、ヘンナおよびナルド、","tok":[["あなた"],["の"],["産み出す","うみだす"],["物","もの"],["は"],["、"],["もろもろ"],["の"],["良き","よき"],["実","み"],["を"],["もつ"],["ざくろ"],["の"],["園","その"],["、"],["ヘンナ"],["および"],["ナルド"],["、"]]},{"verse":14,"text":"ナルド、さふらん、しょうぶ、肉桂,にっけい、さまざまの乳香,にゅうこうの木,き、没薬,もつやく、ろかい、およびすべての尊,たっとい香料,こうりょうである。","tok":[["ナルド"],["、"],["さ"],["ふらん"],["、"],["しょうぶ"],["、"],["肉桂","に"],["っけ"],["い"],["、"],["さまざま"],["の"],["乳香","にゅうこう"],["の"],["木","き"],["、"],["没薬","もつやく"],["、"],["ろか"],["い"],["、"],["および"],["すべて"],["の"],["尊","た"],["っと"],["い"],["香料","こうりょう"],["で"],["ある"],["。"]]},{"verse":15,"text":"あなたは園,そのの泉,いずみ、生,いける水,みずの井,い、またレバノンから流,ながれ出,でる川,かわである。","tok":[["あなた"],["は"],["園","その"],["の"],["泉","いずみ"],["、"],["生ける","いける"],["水","みず"],["の"],["井","い"],["、"],["また"],["レバノン"],["から"],["流れ出る","ながれでる"],["川","かわ"],["で"],["ある"],["。"]]},{"verse":16,"text":"北風,きたかぜよ、起,おこれ、南風,みなみかぜよ、きたれ。わが園,そのを吹,ふいて、そのかおりを広,ひろく散,ちらせ。わが愛,あいする者,ものがその園,そのにはいってきて、その良,よい実,みを食,たべるように。","tok":[["北風","きたかぜ"],["よ"],["、"],["起これ","おこれ"],["、"],["南風","み"],["なみ"],["か"],["ぜ"],["よ"],["、"],["きたれ"],["。"],["わが"],["園","その"],["を"],["吹いて","ふいて"],["、"],["その"],["かおり"],["を"],["広く","ひろく"],["散らせ","ちらせ"],["。"],["わが"],["愛する","あいする"],["者","もの"],["が"],["その"],["園","その"],["に"],["はいって"],["きて"],["、"],["その"],["良い","よい"],["実","み"],["を"],["食べる","たべる"],["よう"],["に"],["。"]]}]
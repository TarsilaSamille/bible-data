[{"verse":1,"text":"[6:13]帰,かえれ、帰,かえれ、シュラムの女,おんなよ、帰,かえれ、帰,かえれ、わたしたちはあなたを見,みたいものだ。あなたがたはどうしてマハナイムの踊,おどりを見,みるようにシュラムの女,おんなを見,みたいのか。","tok":[["["],["6"],[":"],["13"],["]"],["帰えれ","かえれ"],["、"],["帰えれ","かえれ"],["、"],["シュラム"],["の"],["女","おんな"],["よ"],["、"],["帰えれ","かえれ"],["、"],["帰えれ","かえれ"],["、"],["わたしたち"],["は"],["あなた"],["を"],["見たい","みたい"],["もの"],["だ"],["。"],["あなた"],["がた"],["は"],["どう"],["して"],["マハナイム"],["の"],["踊","おどり"],["を"],["見る","みる"],["よう"],["に"],["シュラム"],["の"],["女","おんな"],["を"],["見たい","みたい"],["の"],["か"],["。"]]},{"verse":2,"text":"[1]女王,じょおうのような娘,むすめよ、あなたの足,あしは、くつの中,なかにあって、なんと麗,うるわしいことであろう。あなたのももは、まろやかで、玉,たまのごとく、名人,めいじんの手,てのわざのようだ。","tok":[["["],["1"],["]"],["女王","じょおう"],["の"],["よう"],["な"],["娘","むすめ"],["よ"],["、"],["あなた"],["の"],["足","あし"],["は"],["、"],["くつ"],["の"],["中","なか"],["に"],["あって"],["、"],["なん"],["と"],["麗わしい","うるわしい"],["こと"],["で"],["あろう"],["。"],["あなた"],["の"],["もも"],["は"],["、"],["まろやか"],["で"],["、"],["玉","たま"],["の"],["ごとく"],["、"],["名人","めいじん"],["の"],["手","て"],["の"],["わざ"],["の"],["よう"],["だ"],["。"]]},{"verse":3,"text":"[2]あなたのほぞは、混,まぜたぶどう酒,しゅを欠,かくことのない丸,まるい杯,はいのごとく、あなたの腹,はらは、ゆりの花,はなで囲,かこまれた山盛,やまもりの麦,むぎのようだ。","tok":[["["],["2"],["]"],["あなた"],["の"],["ほぞ"],["は"],["、"],["混ぜた","まぜた"],["ぶどう酒","ぶどうしゅ"],["を"],["欠く","かく"],["こと"],["の"],["ない"],["丸い","まるい"],["杯","はい"],["の"],["ごとく"],["、"],["あなた"],["の"],["腹","はら"],["は"],["、"],["ゆり"],["の"],["花","はな"],["で"],["囲まれた","かこまれた"],["山盛","やまもり"],["の"],["麦","むぎ"],["の"],["よう"],["だ"],["。"]]},{"verse":4,"text":"[3]あなたの両,りょう乳,ちぶさは、かもしかの二子,ふたごである二,に匹,ひきの子,こじかのようだ。","tok":[["["],["3"],["]"],["あなた"],["の"],["両","りょう"],["乳ぶさ","ちぶさ"],["は"],["、"],["かもしか"],["の"],["二子","ふ"],["たご"],["で"],["ある"],["二匹","にひき"],["の"],["子","こ"],["じか"],["の"],["よう"],["だ"],["。"]]},{"verse":5,"text":"[4]あなたの首,くびは象牙,ぞうげのやぐらのごとく、あなたの目,めは、バテラビムの門,もんのほとりにあるヘシボンの池,いけのごとく、あなたの鼻,はなは、ダマスコを見,みおろすレバノンのやぐらのようだ。","tok":[["["],["4"],["]"],["あなた"],["の"],["首","くび"],["は"],["象牙","ぞうげ"],["の"],["やぐら"],["の"],["ごとく"],["、"],["あなた"],["の"],["目","め"],["は"],["、"],["バテラビム"],["の"],["門","もん"],["の"],["ほとり"],["に"],["ある"],["ヘシボン"],["の"],["池","いけ"],["の"],["ごとく"],["、"],["あなた"],["の"],["鼻","はな"],["は"],["、"],["ダマスコ"],["を"],["見おろす","みおろす"],["レバノン"],["の"],["やぐら"],["の"],["よう"],["だ"],["。"]]},{"verse":6,"text":"[5]あなたの頭,あたまは、カルメルのようにあなたを飾,かざり、髪,かみの毛,けは紫色,むらさきいろのようで、王,おうはそのたれ髪,かみに捕,とらわれた。","tok":[["["],["5"],["]"],["あなた"],["の"],["頭","あたま"],["は"],["、"],["カルメル"],["の"],["よう"],["に"],["あなた"],["を"],["飾","かざり"],["、"],["髪の毛","かみのけ"],["は"],["紫色","むらさきいろ"],["の"],["よう"],["で"],["、"],["王","おう"],["は"],["その"],["たれ"],["髪","かみ"],["に"],["捕らわれた","とらわれた"],["。"]]},{"verse":7,"text":"[6]愛,あいする者,ものよ、快活,かいかつなおとめよ、あなたはなんと美,うつくしく愛,あいすべき者,ものであろう。","tok":[["["],["6"],["]"],["愛する","あいする"],["者","もの"],["よ"],["、"],["快活","かいかつ"],["な"],["おとめよ"],["、"],["あなた"],["は"],["なん"],["と"],["美しく","うつくしく"],["愛すべき","あいすべき"],["者","もの"],["で"],["あろう"],["。"]]},{"verse":8,"text":"[7]あなたはなつめやしの木,きのように威厳,いげんがあり、あなたの乳,ちぶさはそのふさのようだ。","tok":[["["],["7"],["]"],["あなた"],["は"],["なつめやし"],["の"],["木","き"],["の"],["よう"],["に"],["威厳","いげん"],["が"],["あり"],["、"],["あなた"],["の"],["乳ぶさ","ちぶさ"],["は"],["その"],["ふさ"],["の"],["よう"],["だ"],["。"]]},{"verse":9,"text":"[8]わたしは言,いう、「このなつめやしの木,きにのぼり、その枝,えだに取,とりつこう。どうか、あなたの乳,ちぶさが、ぶどうのふさのごとく、あなたの息,いきのにおいがりんごのごとく、","tok":[["["],["8"],["]"],["わたし"],["は"],["言う","いう"],["、"],["「"],["この"],["なつめやし"],["の"],["木","き"],["に"],["のぼり"],["、"],["その"],["枝","えだ"],["に"],["取","とり"],["つ"],["こう"],["。"],["どう"],["か"],["、"],["あなた"],["の"],["乳ぶさ","ちぶさ"],["が"],["、"],["ぶどう"],["の"],["ふさ"],["の"],["ごとく"],["、"],["あなた"],["の"],["息","いき"],["の"],["におい"],["が"],["りんご"],["の"],["ごとく"],["、"]]},{"verse":10,"text":"[9]あなたの口,くちづけが、なめらかに流,ながれ下,くだる良,よきぶどう酒,しゅのごとく、くちびると歯,はの上,うえをすべるように」と。","tok":[["["],["9"],["]"],["あなた"],["の"],["口づけ","くちづけ"],["が"],["、"],["なめらか"],["に"],["流れ下る","ながれくだる"],["良き","よき"],["ぶどう酒","ぶどうしゅ"],["の"],["ごとく"],["、"],["くちびる"],["と"],["歯","は"],["の"],["上","うえ"],["を"],["すべる"],["よう"],["に"],["」"],["と"],["。"]]},{"verse":11,"text":"[10]わたしはわが愛,あいする人,ひとのもの、彼,かれはわたしを恋,こいい慕,したう。","tok":[["["],["10"],["]"],["わたし"],["は"],["わが"],["愛する","あいする"],["人","ひと"],["の"],["もの"],["、"],["彼","かれ"],["は"],["わたし"],["を"],["恋","こ"],["いい"],["慕う","したう"],["。"]]},{"verse":12,"text":"[11]わが愛,あいする者,ものよ、さあ、わたしたちはいなかへ出,でていって、村里,むらざとに宿,やどりましょう。","tok":[["["],["11"],["]"],["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["さあ"],["、"],["わたしたち"],["は"],["いなか"],["へ"],["出て","でて"],["いって"],["、"],["村里","むらざと"],["に"],["宿りましょう","やどりましょう"],["。"]]},{"verse":13,"text":"[12]わたしたちは早,はやく起,おき、ぶどう園,えんへ行,いって、ぶどうの木,きが芽,めざしたか、ぶどうの花,はなが咲,さいたか、ざくろが花,はな咲,さいたかを見,みましょう。その所,ところで、わたしはわが愛,あいをあなたに与,あたえます。","tok":[["["],["12"],["]"],["わたしたち"],["は"],["早く","はやく"],["起き","おき"],["、"],["ぶどう園","ぶどうえん"],["へ"],["行って","いって"],["、"],["ぶどう"],["の"],["木","き"],["が"],["芽","め"],["ざ"],["した"],["か"],["、"],["ぶどう"],["の"],["花","はな"],["が"],["咲いた","さいた"],["か"],["、"],["ざくろ"],["が"],["花","はな"],["咲いた","さいた"],["か"],["を"],["見ましょう","みましょう"],["。"],["その"],["所","ところ"],["で"],["、"],["わたし"],["は"],["わが"],["愛","あい"],["を"],["あなた"],["に"],["与えます","あたえます"],["。"]]},{"verse":14,"text":"[13]恋,こいなすは、かおりを放,はなち、もろもろの良,よきくだものは、新,あたらしいのも古,ふるいのも共,ともにわたしたちの戸,との上,うえにある。わが愛,あいする者,ものよ、わたしはこれをあなたのためにたくわえました。","tok":[["["],["13"],["]"],["恋","こい"],["なす"],["は"],["、"],["かおり"],["を"],["放ち","はなち"],["、"],["もろもろ"],["の"],["良き","よき"],["くだもの"],["は"],["、"],["新らしい","あたらしい"],["の"],["も"],["古い","ふるい"],["の"],["も"],["共","とも"],["に"],["わたしたち"],["の"],["戸","と"],["の"],["上","うえ"],["に"],["ある"],["。"],["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["わたし"],["は"],["これ"],["を"],["あなた"],["の"],["ため"],["に"],["たくわえました"],["。"]]}]
[{"verse":1,"text":"わが妹,いもうと、わが花嫁,はなよめよ、わたしはわが園,そのにはいって、わが没薬,もつやくと香料,こうりょうとを集,あつめ、わが蜜,みつ蜂,はちの巣,すと、蜜,みつとを食,たべ、わがぶどう酒,しゅと乳,ちちとを飲,のむ。友,ともらよ、食,くらえ、飲,のめ、愛,あいする人々,ひとびとよ、大,おおいに飲,のめ。","tok":[["わが"],["妹","いもうと"],["、"],["わが"],["花嫁","はなよめ"],["よ"],["、"],["わたし"],["は"],["わが"],["園","その"],["に"],["はいって"],["、"],["わが"],["没薬","もつやく"],["と"],["香料","こうりょう"],["と"],["を"],["集め","あつめ"],["、"],["わが"],["蜜蜂","みつはち"],["の"],["巣","す"],["と"],["、"],["蜜","みつ"],["と"],["を"],["食べ","たべ"],["、"],["わが"],["ぶどう酒","ぶどうしゅ"],["と"],["乳","ちち"],["と"],["を"],["飲む","のむ"],["。"],["友","とも"],["ら"],["よ"],["、"],["食らえ","くらえ"],["、"],["飲め","のめ"],["、"],["愛する","あいする"],["人々","ひとびと"],["よ"],["、"],["大いに","おおいに"],["飲め","のめ"],["。"]]},{"verse":2,"text":"わたしは眠,ねむっていたが、心,こころはさめていた。聞,ききなさい、わが愛,あいする者,ものが戸,とをたたいている。「わが妹,いもうと、わが愛,あいする者,もの、わがはと、わが全,まったき者,ものよ、あけてください。わたしの頭,あたまは露,つゆでぬれ、わたしの髪,かみの毛,けは夜露,よつゆでぬれている」と言,いう。","tok":[["わたし"],["は"],["眠って","ねむって"],["いた"],["が"],["、"],["心","こころ"],["は"],["さめて"],["いた"],["。"],["聞","きき"],["なさい"],["、"],["わが"],["愛する","あいする"],["者","もの"],["が"],["戸","と"],["を"],["たたいて"],["いる"],["。"],["「"],["わが"],["妹","いもうと"],["、"],["わが"],["愛する","あいする"],["者","もの"],["、"],["わが"],["はと"],["、"],["わが"],["全","ま"],["っ"],["たき"],["者","もの"],["よ"],["、"],["あけて"],["ください"],["。"],["わたし"],["の"],["頭","あたま"],["は"],["露","つ"],["ゆでぬれ"],["、"],["わたし"],["の"],["髪の毛","かみのけ"],["は"],["夜露","よつゆ"],["で"],["ぬれて"],["いる"],["」"],["と"],["言う","いう"],["。"]]},{"verse":3,"text":"わたしはすでに着物,きものを脱,ぬいだ、どうしてまた着,きられようか。すでに足,あしを洗,あらった、どうしてまた、よごせようか。","tok":[["わたし"],["は"],["すでに"],["着物","きもの"],["を"],["脱いだ","ぬいだ"],["、"],["どう"],["して"],["また"],["着られよう","きられよう"],["か"],["。"],["すでに"],["足","あし"],["を"],["洗った","あらった"],["、"],["どう"],["して"],["また"],["、"],["よごせ"],["よう"],["か"],["。"]]},{"verse":4,"text":"わが愛,あいする者,ものが掛,かけがねに手,てをかけたので、わが心,こころは内,うちにおどった。","tok":[["わが"],["愛する","あいする"],["者","もの"],["が"],["掛","かけ"],["がね"],["に"],["手","て"],["を"],["かけた"],["ので"],["、"],["わが"],["心","こころ"],["は"],["内","うち"],["に"],["おどった"],["。"]]},{"verse":5,"text":"わたしが起,おきて、わが愛,あいする者,もののためにあけようとしたとき、わたしの手,てから没薬,もつやくがしたたり、わたしの指,ゆびから没薬,もつやくの液,えきが流,ながれて、貫,かんの木,きの取手,とっての上,うえに落,おちた。","tok":[["わたし"],["が"],["起きて","おきて"],["、"],["わが"],["愛する","あいする"],["者","もの"],["の"],["ため"],["に"],["あけよう"],["と"],["した"],["とき"],["、"],["わたし"],["の"],["手","て"],["から"],["没薬","もつやく"],["が"],["したたり"],["、"],["わたし"],["の"],["指","ゆび"],["から"],["没薬","もつやく"],["の"],["液","えき"],["が"],["流れて","ながれて"],["、"],["貫の木","かんのき"],["の"],["取手","とって"],["の"],["上","うえ"],["に"],["落","おち"],["た"],["。"]]},{"verse":6,"text":"わたしはわが愛,あいする者,もののために開,ひらいたが、わが愛,あいする者,ものはすでに帰,かえり去,さった。彼,かれが帰,かえり去,さったとき、わが心,こころは力,ちからを失,うしなった。わたしは尋,たずねたけれども見,みつからず、呼,よんだけれども答,こたえがなかった。","tok":[["わたし"],["は"],["わが"],["愛する","あいする"],["者","もの"],["の"],["ため"],["に"],["開らいた","ひらいた"],["が"],["、"],["わが"],["愛する","あいする"],["者","もの"],["は"],["すでに"],["帰えり","かえり"],["去た","さった"],["。"],["彼","かれ"],["が"],["帰えり","かえり"],["去た","さった"],["とき"],["、"],["わが"],["心","こころ"],["は"],["力","ちから"],["を"],["失なった","うしなった"],["。"],["わたし"],["は"],["尋ねた","たずねた"],["けれど"],["も"],["見つからず","みつからず"],["、"],["呼","よん"],["だ"],["けれど"],["も"],["答","こたえ"],["が"],["なかった"],["。"]]},{"verse":7,"text":"町,まちをまわり歩,あるく夜回,よまわりらはわたしを見,みると、撃,うって傷,きずつけ、城壁,じょうへきを守,まもる者,ものらは、わたしの上着,うわぎをはぎ取,とった。","tok":[["町","まち"],["を"],["まわり"],["歩く","あるく"],["夜回り","よまわり"],["ら"],["は"],["わたし"],["を"],["見る","みる"],["と"],["、"],["撃って","うって"],["傷つけ","きずつけ"],["、"],["城壁","じょうへき"],["を"],["守者","まもるもの"],["ら"],["は"],["、"],["わたし"],["の"],["上着","うわぎ"],["を"],["はぎ取った","はぎとった"],["。"]]},{"verse":8,"text":"エルサレムの娘,むすめたちよ、わたしはあなたがたに誓,ちかって、お願,ねがいする。もしわが愛,あいする者,ものを見,みたなら、わたしが愛,あいのために病,やみわずらっていると、彼,かれに告,つげてください。","tok":[["エルサレム"],["の"],["娘","むすめ"],["たち"],["よ"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["誓って","ちかって"],["、"],["お願い","おねがい"],["する"],["。"],["もし"],["わが"],["愛する","あいする"],["者","もの"],["を"],["見たなら","みたなら"],["、"],["わたし"],["が"],["愛","あい"],["の"],["ため"],["に"],["病み","やみ"],["わずらって"],["いる"],["と"],["、"],["彼","かれ"],["に"],["告","つげ"],["て"],["ください"],["。"]]},{"verse":9,"text":"女,おんなのうちの最,もっとも美,うつくしい者,ものよ、あなたの愛,あいする者,ものは、ほかの人,ひとの愛,あいする者,ものに、なんのまさるところがあるか。あなたの愛,あいする者,ものは、ほかの人,ひとの愛,あいする者,ものに、なんのまさるところがあって、そのように、わたしたちに誓,ちかい、願,ねがうのか。","tok":[["女","おんな"],["の"],["うち"],["の"],["最も","もっとも"],["美しい","うつくしい"],["者","もの"],["よ"],["、"],["あなた"],["の"],["愛する","あいする"],["者","もの"],["は"],["、"],["ほか"],["の"],["人","ひと"],["の"],["愛する","あいする"],["者","もの"],["に"],["、"],["なん"],["の"],["まさる"],["ところ"],["が"],["ある"],["か"],["。"],["あなた"],["の"],["愛する","あいする"],["者","もの"],["は"],["、"],["ほか"],["の"],["人","ひと"],["の"],["愛する","あいする"],["者","もの"],["に"],["、"],["なん"],["の"],["まさる"],["ところ"],["が"],["あって"],["、"],["その"],["よう"],["に"],["、"],["わたしたち"],["に"],["誓い","ちかい"],["、"],["願う","ねがう"],["の"],["か"],["。"]]},{"verse":10,"text":"わが愛,あいする者,ものは白,しろく輝,かがやき、かつ赤,あかく、万,ばん人,にんにぬきんで、","tok":[["わが"],["愛する","あいする"],["者","もの"],["は"],["白く","しろく"],["輝やき","かがやき"],["、"],["かつ"],["赤く","あかく"],["、"],["万人","ばんにん"],["に"],["ぬき"],["ん"],["で"],["、"]]},{"verse":11,"text":"その頭,あたまは純金,じゅんきんのように、その髪,かみの毛,けはうねっていて、からすのように黒,くろい。","tok":[["その"],["頭","あたま"],["は"],["純金","じゅんきん"],["の"],["よう"],["に"],["、"],["その"],["髪の毛","かみのけ"],["は"],["うねって"],["いて"],["、"],["からす"],["の"],["よう"],["に"],["黒い","くろい"],["。"]]},{"verse":12,"text":"その目,めは泉,いずみのほとりのはとのように、乳,ちちで洗,あらわれて、良,よく落,おち着,ついている。","tok":[["その"],["目","め"],["は"],["泉","いずみ"],["の"],["ほとり"],["の"],["はと"],["の"],["よう"],["に"],["、"],["乳","ちち"],["で"],["洗われて","あらわれて"],["、"],["良く","よく"],["落着いて","おちついて"],["いる"],["。"]]},{"verse":13,"text":"そのほおは、かんばしい花,はなの床,とこのように、かおりを放,はなち、そのくちびるは、ゆりの花,はなのようで、没薬,もつやくの液,えきをしたたらす。","tok":[["その"],["ほお"],["は"],["、"],["かんばしい"],["花","はな"],["の"],["床","とこ"],["の"],["よう"],["に"],["、"],["かおり"],["を"],["放ち","はなち"],["、"],["その"],["くちびる"],["は"],["、"],["ゆり"],["の"],["花","はな"],["の"],["よう"],["で"],["、"],["没薬","もつやく"],["の"],["液","えき"],["を"],["したたらす"],["。"]]},{"verse":14,"text":"その手,ては宝石,ほうせきをはめた金,きんの円筒,えんとうのごとく、そのからだはサファイヤをもっておおった象牙,ぞうげの細工,さいくのごとく、","tok":[["その"],["手","て"],["は"],["宝石","ほうせき"],["を"],["はめた"],["金","きん"],["の"],["円筒","えんとう"],["の"],["ごとく"],["、"],["その"],["からだ"],["は"],["サファイヤ"],["を"],["もって"],["おおった"],["象牙","ぞうげ"],["の"],["細工","さいく"],["の"],["ごとく"],["、"]]},{"verse":15,"text":"その足,あしのすねは金,きんの台,だいの上,うえにすえた大理石,だいりせきの柱,はしらのごとく、その姿,すがたはレバノンのごとく、香柏,こうはくのようで、美,うつくしい。","tok":[["その"],["足","あし"],["の"],["すね"],["は"],["金","きん"],["の"],["台","だい"],["の"],["上","うえ"],["に"],["すえた"],["大理石","だいりせき"],["の"],["柱","はしら"],["の"],["ごとく"],["、"],["その"],["姿","すがた"],["は"],["レバノン"],["の"],["ごとく"],["、"],["香","こう"],["柏","かしわ"],["の"],["よう"],["で"],["、"],["美しい","うつくしい"],["。"]]},{"verse":16,"text":"その言葉,ことばは、はなはだ美,うつくしく、彼,かれはことごとく麗,うるわしい。エルサレムの娘,むすめたちよ、これがわが愛,あいする者,もの、これがわが友,ともなのです。","tok":[["その"],["言葉","ことば"],["は"],["、"],["はなはだ"],["美しく","うつくしく"],["、"],["彼","かれ"],["は"],["ことごとく"],["麗わしい","うるわしい"],["。"],["エルサレム"],["の"],["娘","むすめ"],["たち"],["よ"],["、"],["これ"],["が"],["わが"],["愛する","あいする"],["者","もの"],["、"],["これ"],["が"],["わが"],["友","とも"],["な"],["の"],["です"],["。"]]}]
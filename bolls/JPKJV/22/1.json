[{"verse":1,"text":"ソロモンの雅歌,がか","tok":[["ソロモン"],["の"],["雅歌","が"],["か"]]},{"verse":2,"text":"どうか、あなたの口,くちの口,くちづけをもって、わたしに口,くちづけしてください。あなたの愛,あいはぶどう酒,しゅにまさり、","tok":[["どう"],["か"],["、"],["あなた"],["の"],["口","くち"],["の"],["口づけ","くちづけ"],["を"],["もって"],["、"],["わたし"],["に"],["口づけ","くちづけ"],["して"],["ください"],["。"],["あなた"],["の"],["愛","あい"],["は"],["ぶどう酒","ぶどうしゅ"],["に"],["まさり"],["、"]]},{"verse":3,"text":"あなたのにおい油,あぶらはかんばしく、あなたの名,なは注,そそがれたにおい油,あぶらのようです。それゆえ、おとめたちはあなたを愛,あいするのです。","tok":[["あなた"],["の"],["におい"],["油","あぶら"],["は"],["かんばしく"],["、"],["あなた"],["の"],["名","な"],["は"],["注がれた","そそがれた"],["におい"],["油","あぶら"],["の"],["よう"],["です"],["。"],["それ"],["ゆえ"],["、"],["おとめ"],["たち"],["は"],["あなた"],["を"],["愛する","あいする"],["の"],["です"],["。"]]},{"verse":4,"text":"あなたのあとについて、行,いかせてください。わたしたちは急,いそいでまいりましょう。王,おうはわたしをそのへやに連,つれて行,いかれた。わたしたちは、あなたによって喜,よろこび楽,たのしみ、ぶどう酒,しゅにまさって、あなたの愛,あいをほめたたえます。おとめたちは真心,まごころをもってあなたを愛,あいします。","tok":[["あなた"],["の"],["あと"],["について"],["、"],["行かせて","いかせて"],["ください"],["。"],["わたしたち"],["は"],["急いで","いそいで"],["まいりましょう"],["。"],["王","おう"],["は"],["わたし"],["を"],["その"],["へや"],["に"],["連れて","つれて"],["行かれた","いかれた"],["。"],["わたしたち"],["は"],["、"],["あなた"],["によって"],["喜こび","よろこび"],["楽み","たのしみ"],["、"],["ぶどう酒","ぶどうしゅ"],["に"],["まさって"],["、"],["あなた"],["の"],["愛","あい"],["を"],["ほめたたえます"],["。"],["おとめ"],["たち"],["は"],["真心","まごころ"],["を"],["もって"],["あなた"],["を"],["愛します","あいします"],["。"]]},{"verse":5,"text":"エルサレムの娘,むすめたちよ、わたしは黒,くろいけれども美,うつくしい。ケダルの天幕,てんまくのように、ソロモンのとばりのように。","tok":[["エルサレム"],["の"],["娘","むすめ"],["たち"],["よ"],["、"],["わたし"],["は"],["黒い","くろい"],["けれど"],["も"],["美しい","うつくしい"],["。"],["ケダル"],["の"],["天幕","てんまく"],["の"],["よう"],["に"],["、"],["ソロモン"],["の"],["とばり"],["の"],["よう"],["に"],["。"]]},{"verse":6,"text":"わたしが日,ひに焼,やけているがために、日,ひがわたしを焼,やいたがために、わたしを見,みつめてはならない。わが母,ははの子,こらは怒,いかって、わたしにぶどう園,えんを守,まもらせた。しかし、わたしは自分,じぶんのぶどう園,えんを守,まもらなかった。","tok":[["わたし"],["が"],["日","ひ"],["に"],["焼","やけ"],["て"],["いる"],["が"],["ため"],["に"],["、"],["日","ひ"],["が"],["わたし"],["を"],["焼いた","やいた"],["が"],["ため"],["に"],["、"],["わたし"],["を"],["見つめて","みつめて"],["は"],["ならない"],["。"],["わが"],["母","はは"],["の"],["子","こ"],["ら"],["は"],["怒","い"],["か"],["って"],["、"],["わたし"],["に"],["ぶどう園","ぶどうえん"],["を"],["守らせた","まもらせた"],["。"],["しかし"],["、"],["わたし"],["は"],["自分","じぶん"],["の"],["ぶどう園","ぶどうえん"],["を"],["守らなかった","まもらなかった"],["。"]]},{"verse":7,"text":"わが魂,たましいの愛,あいする者,ものよ、あなたはどこで、あなたの群,むれを養,やしない、昼,ひるの時,ときにどこで、それを休,やすませるのか、わたしに告,つげてください。どうして、わたしはさまよう者,もののように、あなたの仲間,なかまの群,むれのかたわらに、いなければならないのですか。","tok":[["わが"],["魂","たましい"],["の"],["愛する","あいする"],["者","もの"],["よ"],["、"],["あなた"],["は"],["どこ"],["で"],["、"],["あなた"],["の"],["群れ","むれ"],["を"],["養い","やしない"],["、"],["昼","ひる"],["の"],["時","とき"],["に"],["どこ"],["で"],["、"],["それ"],["を"],["休ませる","やすませる"],["の"],["か"],["、"],["わたし"],["に"],["告","つげ"],["て"],["ください"],["。"],["どう"],["して"],["、"],["わたし"],["は"],["さまよう"],["者","もの"],["の"],["よう"],["に"],["、"],["あなた"],["の"],["仲間","なかま"],["の"],["群れ","むれ"],["の"],["かたわら"],["に"],["、"],["いなければ"],["ならない"],["の"],["です"],["か"],["。"]]},{"verse":8,"text":"女,おんなのうちの最,もっとも美,うつくしい者,ものよ、あなたが知,しらないなら、群,むれの足跡,あしあとに従,したがっていって、羊飼,ひつじかいたちの天幕,てんまくのかたわらで、あなたの子,こやぎを飼,かいなさい。","tok":[["女","おんな"],["の"],["うち"],["の"],["最も","もっとも"],["美しい","うつくしい"],["者","もの"],["よ"],["、"],["あなた"],["が"],["知らないなら","しらないなら"],["、"],["群れ","むれ"],["の"],["足跡","あしあと"],["に"],["従って","したがって"],["いって"],["、"],["羊飼","ひつじかい"],["たち"],["の"],["天幕","てんまく"],["の"],["かたわら"],["で"],["、"],["あなた"],["の"],["子やぎ","こやぎ"],["を"],["飼","かい"],["なさい"],["。"]]},{"verse":9,"text":"わが愛,あいする者,ものよ、わたしはあなたをパロの車,くるまの雌,め馬,うまになぞらえる。","tok":[["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["わたし"],["は"],["あなた"],["を"],["パロ"],["の"],["車","くるま"],["の"],["雌馬","めうま"],["に"],["なぞらえる"],["。"]]},{"verse":10,"text":"あなたのほおは美,うつくしく飾,かざられ、あなたの首,くびは宝石,ほうせきをつらねた首,くび飾,かざりで美,うつくしい。","tok":[["あなた"],["の"],["ほお"],["は"],["美しく","うつくしく"],["飾られ","かざられ"],["、"],["あなた"],["の"],["首","くび"],["は"],["宝石","ほうせき"],["を"],["つらねた"],["首飾","くびかざり"],["で"],["美しい","うつくしい"],["。"]]},{"verse":11,"text":"われわれは銀,ぎんを散,ちらした金,きんの飾,かざり物,ものを、あなたのために造,つくろう。","tok":[["われわれ"],["は"],["銀","ぎん"],["を"],["散らした","ちらした"],["金","きん"],["の"],["飾","かざり"],["物","もの"],["を"],["、"],["あなた"],["の"],["ため"],["に"],["造ろう","つくろう"],["。"]]},{"verse":12,"text":"王,おうがその席,せきに着,つかれたとき、わたしのナルドはそのかおりを放,はなった。","tok":[["王","おう"],["が"],["その"],["席","せき"],["に"],["着かれた","つかれた"],["とき"],["、"],["わたし"],["の"],["ナルド"],["は"],["その"],["かおり"],["を"],["放った","はなった"],["。"]]},{"verse":13,"text":"わが愛,あいする者,ものは、わたしにとっては、わたしの乳,ちぶさの間,あいだにある没薬,もつやくの袋,ふくろのようです。","tok":[["わが"],["愛する","あいする"],["者","もの"],["は"],["、"],["わたし"],["にとって"],["は"],["、"],["わたし"],["の"],["乳ぶさ","ちぶさ"],["の"],["間","あいだ"],["に"],["ある"],["没薬","もつやく"],["の"],["袋","ふくろ"],["の"],["よう"],["です"],["。"]]},{"verse":14,"text":"わが愛,あいする者,ものは、わたしにとっては、エンゲデのぶどう園,えんにあるヘンナ樹,じゅの花,はなぶさのようです。","tok":[["わが"],["愛する","あいする"],["者","もの"],["は"],["、"],["わたし"],["にとって"],["は"],["、"],["エンゲデ"],["の"],["ぶどう園","ぶどうえん"],["に"],["ある"],["ヘンナ樹","へんなじゅ"],["の"],["花ぶさ","はなぶさ"],["の"],["よう"],["です"],["。"]]},{"verse":15,"text":"わが愛,あいする者,ものよ、見,みよ、あなたは美,うつくしい、見,みよ、あなたは美,うつくしい、あなたの目,めははとのようだ。","tok":[["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["見よ","みよ"],["、"],["あなた"],["は"],["美しい","うつくしい"],["、"],["見よ","みよ"],["、"],["あなた"],["は"],["美しい","うつくしい"],["、"],["あなた"],["の"],["目","め"],["は"],["はと"],["の"],["よう"],["だ"],["。"]]},{"verse":16,"text":"わが愛,あいする者,ものよ、見,みよ、あなたは美,うつくしく、まことにりっぱです。わたしたちの床,とこは緑,みどり、","tok":[["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["見よ","みよ"],["、"],["あなた"],["は"],["美しく","うつくしく"],["、"],["まこと"],["に"],["りっぱ"],["です"],["。"],["わたしたち"],["の"],["床","とこ"],["は"],["緑","みどり"],["、"]]},{"verse":17,"text":"わたしたちの家,いえの梁,はりは香柏,こうはく、そのたるきはいとすぎです。","tok":[["わたしたち"],["の"],["家","いえ"],["の"],["梁","はり"],["は"],["香","こう"],["柏","かしわ"],["う"],["はく"],["、"],["その"],["たるき"],["はい"],["と"],["すぎです"],["。"]]}]
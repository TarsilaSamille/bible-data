[{"verse":1,"text":"わたしはシャロンのばら、谷,たにのゆりです。","tok":[["わたし"],["は"],["シャロン"],["の"],["ばら"],["、"],["谷","たに"],["の"],["ゆり"],["です"],["。"]]},{"verse":2,"text":"おとめたちのうちにわが愛,あいする者,もののあるのは、いばらの中,なかにゆりの花,はながあるようだ。","tok":[["おとめ"],["たち"],["の"],["うち"],["に"],["わが"],["愛する","あいする"],["者","もの"],["の"],["ある"],["の"],["は"],["、"],["いばら"],["の"],["中","なか"],["に"],["ゆり"],["の"],["花","はな"],["が"],["ある"],["よう"],["だ"],["。"]]},{"verse":3,"text":"わが愛,あいする者,ものの若人,わこうどたちの中,なかにあるのは、林,はやしの木,きの中,なかにりんごの木,きがあるようです。わたしは大,おおきな喜,よろこびをもって、彼,かれの陰,かげにすわった。彼,かれの与,あたえる実,みはわたしの口,くちに甘,あまかった。","tok":[["わが"],["愛する","あいする"],["者","もの"],["の"],["若人","わこうど"],["たち"],["の"],["中","なか"],["に"],["ある"],["の"],["は"],["、"],["林","はやし"],["の"],["木","き"],["の"],["中","なか"],["に"],["りんご"],["の"],["木","き"],["が"],["ある"],["よう"],["です"],["。"],["わたし"],["は"],["大きな","おおきな"],["喜こび","よろこび"],["を"],["もって"],["、"],["彼","かれ"],["の"],["陰","かげ"],["に"],["すわった"],["。"],["彼","かれ"],["の"],["与える","あたえる"],["実","み"],["は"],["わたし"],["の"],["口","くち"],["に"],["甘かった","あまかった"],["。"]]},{"verse":4,"text":"彼,かれはわたしを酒宴,しゅえんの家,いえに連,つれて行,いった。わたしの上,うえにひるがえる彼,かれの旗,はたは愛,あいであった。","tok":[["彼","かれ"],["は"],["わたし"],["を"],["酒宴","しゅえん"],["の"],["家","いえ"],["に"],["連れて","つれて"],["行った","いった"],["。"],["わたし"],["の"],["上","うえ"],["に"],["ひるがえる"],["彼","かれ"],["の"],["旗","はた"],["は"],["愛","あい"],["で"],["あった"],["。"]]},{"verse":5,"text":"干,ほしぶどうをもって、わたしに力,ちからをつけ、りんごをもって、わたしに元気,げんきをつけてください。わたしは愛,あいのために病,やみわずらっているのです。","tok":[["干し","ほし"],["ぶどう"],["を"],["もって"],["、"],["わたし"],["に"],["力","ちから"],["を"],["つけ"],["、"],["りんご"],["を"],["もって"],["、"],["わたし"],["に"],["元気","げんき"],["を"],["つけて"],["ください"],["。"],["わたし"],["は"],["愛","あい"],["の"],["ため"],["に"],["病み","やみ"],["わずらって"],["いる"],["の"],["です"],["。"]]},{"verse":6,"text":"どうか、彼,かれの左,ひだりの手,てがわたしの頭,あたまの下,したにあり、右,みぎの手,てがわたしを抱,だいてくれるように。","tok":[["どう"],["か"],["、"],["彼","かれ"],["の"],["左","ひだり"],["の"],["手","て"],["が"],["わたし"],["の"],["頭","あたま"],["の"],["下","した"],["に"],["あり"],["、"],["右","みぎ"],["の"],["手","て"],["が"],["わたし"],["を"],["抱いて","だいて"],["くれる"],["よう"],["に"],["。"]]},{"verse":7,"text":"エルサレムの娘,むすめたちよ、わたしは、かもしかと野,のの雌,めじかをさして、あなたがたに誓,ちかい、お願,ねがいする、愛,あいのおのずから起,おこるときまでは、ことさらに呼,よび起,おこすことも、さますこともしないように。","tok":[["エルサレム"],["の"],["娘","むすめ"],["たち"],["よ"],["、"],["わたし"],["は"],["、"],["かもしか"],["と"],["野","の"],["の"],["雌","めじか"],["を"],["さして"],["、"],["あなた"],["がた"],["に"],["誓い","ちかい"],["、"],["お願い","おねがい"],["する"],["、"],["愛","あい"],["の"],["おのずから"],["起こる","おこる"],["とき"],["まで"],["は"],["、"],["ことさら"],["に"],["呼び起こす","よびおこす"],["こと"],["も"],["、"],["さます"],["こと"],["も"],["しない"],["よう"],["に"],["。"]]},{"verse":8,"text":"わが愛,あいする者,ものの声,こえが聞,きこえる。見,みよ、彼,かれは山,やまをとび、丘,おかをおどり越,こえて来,くる。","tok":[["わが"],["愛する","あいする"],["者","もの"],["の"],["声","こえ"],["が"],["聞こえる","きこえる"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["山","やま"],["を"],["とび"],["、"],["丘","おか"],["を"],["おどり"],["越えて","こえて"],["来る","くる"],["。"]]},{"verse":9,"text":"わが愛,あいする者,ものはかもしかのごとく、若,わかい雄,おじかのようです。見,みよ、彼,かれはわたしたちの壁,かべのうしろに立,たち、窓,まどからのぞき、格子,こうしからうかがっている。","tok":[["わが"],["愛する","あいする"],["者","もの"],["は"],["かもしか"],["の"],["ごとく"],["、"],["若い","わかい"],["雄","おじか"],["の"],["よう"],["です"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["は"],["わたしたち"],["の"],["壁","かべ"],["の"],["うしろ"],["に"],["立ち","たち"],["、"],["窓","まど"],["から"],["のぞき"],["、"],["格子","こうし"],["から"],["うかがって"],["いる"],["。"]]},{"verse":10,"text":"わが愛,あいする者,ものはわたしに語,かたって言,いう、「わが愛,あいする者,ものよ、わが麗,うるわしき者,ものよ、立,たって、出,でてきなさい。","tok":[["わが"],["愛する","あいする"],["者","もの"],["は"],["わたし"],["に"],["語って","かたって"],["言う","いう"],["、"],["「"],["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["わが"],["麗わしき","うるわしき"],["者","もの"],["よ"],["、"],["立って","たって"],["、"],["出て","でて"],["き"],["なさい"],["。"]]},{"verse":11,"text":"見,みよ、冬,ふゆは過,すぎ、雨,あめもやんで、すでに去,さり、","tok":[["見よ","みよ"],["、"],["冬","ふゆ"],["は"],["過","すぎ"],["、"],["雨","あめ"],["も"],["やんで"],["、"],["すでに"],["去り","さり"],["、"]]},{"verse":12,"text":"もろもろの花,はなは地,ちにあらわれ、鳥,とりのさえずる時,ときがきた。山,やまばとの声,こえがわれわれの地,ちに聞,きこえる。","tok":[["もろもろ"],["の"],["花","はな"],["は"],["地","ち"],["に"],["あらわれ"],["、"],["鳥","とり"],["の"],["さえずる"],["時","とき"],["が"],["きた"],["。"],["山ばと","やまばと"],["の"],["声","こえ"],["が"],["われわれ"],["の"],["地","ち"],["に"],["聞こえる","きこえる"],["。"]]},{"verse":13,"text":"いちじくの木,きはその実,みを結,むすび、ぶどうの木,きは花,はな咲,さいて、かんばしいにおいを放,はなつ。わが愛,あいする者,ものよ、わが麗,うるわしき者,ものよ、立,たって、出,でてきなさい。","tok":[["いちじく"],["の"],["木","き"],["は"],["その"],["実","み"],["を"],["結び","むすび"],["、"],["ぶどう"],["の"],["木","き"],["は"],["花","はな"],["咲いて","さいて"],["、"],["かんばしい"],["におい"],["を"],["放つ","はなつ"],["。"],["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["わが"],["麗わしき","うるわしき"],["者","もの"],["よ"],["、"],["立って","たって"],["、"],["出て","でて"],["き"],["なさい"],["。"]]},{"verse":14,"text":"岩,いわの裂,さけ目,め、がけの隠,かくれ場,ばにおるわがはとよ、あなたの顔,かおを見,みせなさい。あなたの声,こえを聞,きかせなさい。あなたの声,こえは愛,あいらしく、あなたの顔,かおは美,うつくしい。","tok":[["岩","いわ"],["の"],["裂け目","さけめ"],["、"],["がけ"],["の"],["隠れ場","かくれば"],["に"],["おる"],["わが"],["はと"],["よ"],["、"],["あなた"],["の"],["顔","かお"],["を"],["見せ","みせ"],["なさい"],["。"],["あなた"],["の"],["声","こえ"],["を"],["聞かせ","きかせ"],["なさい"],["。"],["あなた"],["の"],["声","こえ"],["は"],["愛らしく","あいらしく"],["、"],["あなた"],["の"],["顔","かお"],["は"],["美しい","うつくしい"],["。"]]},{"verse":15,"text":"われわれのためにきつねを捕,とらえよ、ぶどう園,えんを荒,あらす小,こぎつねを捕,とらえよ、われわれのぶどう園,えんは花盛,はなざかりだから」と。","tok":[["われわれ"],["の"],["ため"],["に"],["きつね"],["を"],["捕らえよ","とらえよ"],["、"],["ぶどう園","ぶどうえん"],["を"],["荒す","あらす"],["小ぎつね","こぎつね"],["を"],["捕らえよ","とらえよ"],["、"],["われわれ"],["の"],["ぶどう園","ぶどうえん"],["は"],["花盛り","はなざかり"],["だ"],["から"],["」"],["と"],["。"]]},{"verse":16,"text":"わが愛,あいする者,ものはわたしのもの、わたしは彼,かれのもの。彼,かれはゆりの花,はなの中,なかで、その群,むれを養,やしなっている。","tok":[["わが"],["愛する","あいする"],["者","もの"],["は"],["わたし"],["の"],["もの"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["もの"],["。"],["彼","かれ"],["は"],["ゆり"],["の"],["花","はな"],["の"],["中","なか"],["で"],["、"],["その"],["群れ","むれ"],["を"],["養って","やしなって"],["いる"],["。"]]},{"verse":17,"text":"わが愛,あいする者,ものよ、日,ひの涼,すずしくなるまで、影,かげの消,きえるまで、身,みをかえして出,でていって、険,けわしい山々,やまやまの上,うえで、かもしかのように、若,わかい雄,おじかのようになってください。","tok":[["わが"],["愛する","あいする"],["者","もの"],["よ"],["、"],["日","ひ"],["の"],["涼しく","すずしく"],["なる"],["まで"],["、"],["影","かげ"],["の"],["消える","きえる"],["まで"],["、"],["身","み"],["を"],["かえして"],["出て","でて"],["いって"],["、"],["険しい","けわしい"],["山々","やまやま"],["の"],["上","うえ"],["で"],["、"],["かもしか"],["の"],["よう"],["に"],["、"],["若い","わかい"],["雄","おじか"],["の"],["よう"],["に"],["なって"],["ください"],["。"]]}]
[{"verse":1,"text":"わたしはまた、新,あたらしい天,てんと新,あたらしい地,ちとを見,みた。先,さきの天,てんと地,ちとは消,きえ去,さり、海,うみもなくなってしまった。","tok":[["わたし"],["は"],["また"],["、"],["新らしい","あたらしい"],["天","てん"],["と"],["新らしい","あたらしい"],["地","ち"],["と"],["を"],["見た","みた"],["。"],["先","さき"],["の"],["天","てん"],["と"],["地","ち"],["と"],["は"],["消え去り","きえさり"],["、"],["海","うみ"],["も"],["なくなって"],["しまった"],["。"]]},{"verse":2,"text":"また、聖,せいなる都,みやこ、新,あたらしいエルサレムが、夫,おっとのために着飾,きかざった花嫁,はなよめのように用意,よういをととのえて、神,かみのもとを出,でて、天,てんから下,くだって来,くるのを見,みた。","tok":[["また"],["、"],["聖","せい"],["なる"],["都","み"],["やこ"],["、"],["新らしい","あたらしい"],["エルサレム"],["が"],["、"],["夫","おっと"],["の"],["ため"],["に"],["着飾った","きかざった"],["花嫁","はなよめ"],["の"],["よう"],["に"],["用意","ようい"],["を"],["ととのえて"],["、"],["神","かみ"],["の"],["もと"],["を"],["出て","でて"],["、"],["天","てん"],["から"],["下って","くだって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":3,"text":"また、御座,みざから大,おおきな声,こえが叫,さけぶのを聞,きいた、「見,みよ、神,かみの幕屋,まくやが人,ひとと共,ともにあり、神,かみが人,ひとと共,ともに住,すみ、人,ひとは神,かみの民,たみとなり、神,かみ自,みずから人,ひとと共,ともにいまして、","tok":[["また"],["、"],["御座ら","みざから"],["大きな","おおきな"],["声","こえ"],["が"],["叫けぶ","さけぶ"],["の"],["を"],["聞いた","きいた"],["、"],["「"],["見よ","みよ"],["、"],["神","かみ"],["の"],["幕屋","まくや"],["が"],["人","ひと"],["と"],["共","とも"],["に"],["あり"],["、"],["神","かみ"],["が"],["人","ひと"],["と"],["共","とも"],["に"],["住み","すみ"],["、"],["人","ひと"],["は"],["神","かみ"],["の"],["民","たみ"],["と"],["なり"],["、"],["神","かみ"],["自から","みずから"],["人","ひと"],["と"],["共","とも"],["に"],["いまして"],["、"]]},{"verse":4,"text":"人,ひとの目,めから涙,なみだを全,まったくぬぐいとって下,くださる。もはや、死,しもなく、悲,かなしみも、叫,さけびも、痛,いたみもない。先,さきのものが、すでに過,すぎ去,さったからである」。","tok":[["人","ひと"],["の"],["目","め"],["から"],["涙","なみだ"],["を"],["全く","まったく"],["ぬぐいとって"],["下さる","くださる"],["。"],["もはや"],["、"],["死","し"],["も"],["なく"],["、"],["悲しみ","かなしみ"],["も"],["、"],["叫","さけび"],["も"],["、"],["痛み","いたみ"],["も"],["ない"],["。"],["先","さき"],["の"],["もの"],["が"],["、"],["すでに"],["過去","すぎさっ"],["たから"],["で"],["ある"],["」"],["。"]]},{"verse":5,"text":"すると、御座,みざにいますかたが言,いわれた、「見,みよ、わたしはすべてのものを新,あらたにする」。また言,いわれた、「書,かきしるせ。これらの言葉,ことばは、信,しんずべきであり、まことである」。","tok":[["する"],["と"],["、"],["御座","みざ"],["に"],["います"],["かた"],["が"],["言われた","いわれた"],["、"],["「"],["見よ","みよ"],["、"],["わたし"],["は"],["すべて"],["の"],["もの"],["を"],["新らた","あらた"],["に"],["する"],["」"],["。"],["また"],["言われた","いわれた"],["、"],["「"],["書きしるせ","かきしるせ"],["。"],["これ"],["ら"],["の"],["言葉","ことば"],["は"],["、"],["信","しん"],["ずべきで"],["あり"],["、"],["まこと"],["で"],["ある"],["」"],["。"]]},{"verse":6,"text":"そして、わたしに仰,おおせられた、「事,ことはすでに成,なった。わたしは、アルパでありオメガである。初,はじめであり終,おわりである。かわいている者,ものには、いのちの水,みずの泉,いずみから価,あたいなしに飲,のませよう。","tok":[["そして"],["、"],["わたし"],["に"],["仰せられた","おおせられた"],["、"],["「"],["事","こと"],["は"],["すでに"],["成った","なった"],["。"],["わたし"],["は"],["、"],["アルパ"],["で"],["あり"],["オメガ"],["で"],["ある"],["。"],["初め","はじめ"],["で"],["あり"],["終","おわり"],["で"],["ある"],["。"],["かわいて"],["いる"],["者","もの"],["に"],["は"],["、"],["いのち"],["の"],["水","みず"],["の"],["泉","いずみ"],["から"],["価","あたい"],["なし"],["に"],["飲ませよう","のませよう"],["。"]]},{"verse":7,"text":"勝利,しょうりを得,える者,ものは、これらのものを受,うけ継,つぐであろう。わたしは彼,かれの神,かみとなり、彼,かれはわたしの子,ことなる。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["は"],["、"],["これ"],["ら"],["の"],["もの"],["を"],["受け継ぐで","うけつぐで"],["あろう"],["。"],["わたし"],["は"],["彼","かれ"],["の"],["神","かみ"],["と"],["なり"],["、"],["彼","かれ"],["は"],["わたし"],["の"],["子","こ"],["と"],["なる"],["。"]]},{"verse":8,"text":"しかし、おくびょうな者,もの、信,しんじない者,もの、忌,いむべき者,もの、人殺,ひとごろし、姦淫,かんいんを行,おこなう者,もの、まじないをする者,もの、偶像,ぐうぞうを拝,おがむ者,もの、すべて偽,いつわりを言,いう者,ものには、火,ひと硫黄,いおうの燃,もえている池,いけが、彼,かれらの受,うくべき報,むくいである。これが第,だい二の死,しである」。","tok":[["しかし"],["、"],["おくびょう"],["な"],["者","もの"],["、"],["信じない","しんじない"],["者","もの"],["、"],["忌むべき","いむべき"],["者","もの"],["、"],["人殺し","ひとごろし"],["、"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["者","もの"],["、"],["まじない"],["を"],["する"],["者","もの"],["、"],["偶像","ぐうぞう"],["を"],["拝む","おがむ"],["者","もの"],["、"],["すべて"],["偽り","いつわり"],["を"],["言う","いう"],["者","もの"],["に"],["は"],["、"],["火","ひ"],["と"],["硫黄","いおう"],["の"],["燃えて","もえて"],["いる"],["池","いけ"],["が"],["、"],["彼","かれ"],["ら"],["の"],["受","う"],["くべき"],["報い","むくい"],["で"],["ある"],["。"],["これ"],["が"],["第","だい"],["二","に"],["の"],["死","し"],["で"],["ある"],["」"],["。"]]},{"verse":9,"text":"最後,さいごの七つの災害,さいがいが満,みちている七つの鉢,はちを持,もっていた七人,にんの御使,みつかいのひとりがきて、わたしに語,かたって言,いった、「さあ、きなさい。小羊,こひつじの妻,つまなる花嫁,はなよめを見,みせよう」。","tok":[["最後","さいご"],["の"],["七","なな"],["つ"],["の"],["災害","さいがい"],["が"],["満ちて","みちて"],["いる"],["七","なな"],["つ"],["の"],["鉢","はち"],["を"],["持って","もって"],["いた"],["七人","にん"],["の"],["御使","みつかい"],["の"],["ひとり"],["が"],["きて"],["、"],["わたし"],["に"],["語って","かたって"],["言った","いった"],["、"],["「"],["さあ"],["、"],["き"],["なさい"],["。"],["小羊","こひつじ"],["の"],["妻","つま"],["なる"],["花嫁","はなよめ"],["を"],["見せよう","みせよう"],["」"],["。"]]},{"verse":10,"text":"この御使,みつかいは、わたしを御霊,みたまに感,かんじたまま、大,おおきな高,たかい山,やまに連,つれて行,いき、聖,せい都,みやこエルサレムが、神,かみの栄光,えいこうのうちに、神,かみのみもとを出,でて天,てんから下,くだって来,くるのを見,みせてくれた。","tok":[["この"],["御使","みつかい"],["は"],["、"],["わたし"],["を"],["御霊","みたま"],["に"],["感じた","かんじた"],["まま"],["、"],["大きな","おおきな"],["高い","たかい"],["山","やま"],["に"],["連れて","つれて"],["行き","いき"],["、"],["聖い","せい"],["都","み"],["や"],["こ"],["エルサレム"],["が"],["、"],["神","かみ"],["の"],["栄光","えいこう"],["の"],["うち"],["に"],["、"],["神","かみ"],["のみ"],["もと"],["を"],["出て","でて"],["天","てん"],["から"],["下って","くだって"],["来る","くる"],["の"],["を"],["見せて","みせて"],["くれた"],["。"]]},{"verse":11,"text":"その都,みやこの輝,かがやきは、高価,こうかな宝石,ほうせきのようであり、透明,とうめいな碧玉,へきぎょくのようであった。","tok":[["その"],["都","みやこ"],["の"],["輝やき","かがやき"],["は"],["、"],["高価","こうか"],["な"],["宝石","ほうせき"],["の"],["よう"],["で"],["あり"],["、"],["透明","とうめい"],["な"],["碧玉","へきぎょく"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":12,"text":"それには大,おおきな、高,たかい城壁,じょうへきがあって、十二の門,もんがあり、それらの門,もんには、十二の御使,みつかいがおり、イスラエルの子,こらの十二部族,ぶぞくの名,なが、それに書,かいてあった。","tok":[["それ"],["に"],["は"],["大きな","おおきな"],["、"],["高かい","たかい"],["城壁","じょうへき"],["が"],["あって"],["、"],["十二","じゅうに"],["の"],["門","もん"],["が"],["あり"],["、"],["それ"],["ら"],["の"],["門","もん"],["に"],["は"],["、"],["十二","じゅうに"],["の"],["御使","みつかい"],["が"],["おり"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["十二","じゅうに"],["部族","ぶぞく"],["の"],["名","な"],["が"],["、"],["それ"],["に"],["書いて","かいて"],["あった"],["。"]]},{"verse":13,"text":"東,ひがしに三つの門,もん、北,きたに三つの門,もん、南,みなみに三つの門,もん、西,にしに三つの門,もんがあった。","tok":[["東","ひがし"],["に"],["三","みっ"],["つ"],["の"],["門","もん"],["、"],["北","きた"],["に"],["三","みっ"],["つ"],["の"],["門","もん"],["、"],["南","みなみ"],["に"],["三","みっ"],["つ"],["の"],["門","もん"],["、"],["西","にし"],["に"],["三","みっ"],["つ"],["の"],["門","もん"],["が"],["あった"],["。"]]},{"verse":14,"text":"また都,みやこの城壁,じょうへきには十二の土台,どだいがあり、それには小羊,こひつじの十二使徒,しとの十二の名,なが書,かいてあった。","tok":[["また"],["都","みやこ"],["の"],["城壁","じょうへき"],["に"],["は"],["十二","じゅうに"],["の"],["土台","どだい"],["が"],["あり"],["、"],["それ"],["に"],["は"],["小羊","こひつじ"],["の"],["十二","じゅうに"],["使徒","しと"],["の"],["十二","じゅうに"],["の"],["名","な"],["が"],["書いて","かいて"],["あった"],["。"]]},{"verse":15,"text":"わたしに語,かたっていた者,ものは、都,みやことその門,もんと城壁,じょうへきとを測,はかるために、金,きんの測,はかりざおを持,もっていた。","tok":[["わたし"],["に"],["語って","かたって"],["いた"],["者","もの"],["は"],["、"],["都","みやこ"],["と"],["その"],["門","もん"],["と"],["城壁","じょうへき"],["と"],["を"],["測る","はかる"],["ため"],["に"],["、"],["金","きん"],["の"],["測り","はかり"],["ざお"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":16,"text":"都,みやこは方形,ほうけいであって、その長,ながさと幅,はばとは同,おなじである。彼,かれがその測,はかりざおで都,みやこを測,はかると、一万二千丁,ちょうであった。長,ながさと幅,はばと高,たかさとは、いずれも同,おなじである。","tok":[["都","みやこ"],["は"],["方形","ほうけい"],["で"],["あって"],["、"],["その"],["長さ","ながさ"],["と"],["幅","はば"],["と"],["は"],["同じ","おなじ"],["で"],["ある"],["。"],["彼","かれ"],["が"],["その"],["測り","はかり"],["ざお"],["で"],["都","みやこ"],["を"],["測る","はかる"],["と"],["、"],["一万二","いちまんに"],["千丁","せんちょう"],["うで"],["あった"],["。"],["長さ","ながさ"],["と"],["幅","はば"],["と"],["高か","たか"],["さ"],["と"],["は"],["、"],["いずれ"],["も"],["同じ","おなじ"],["で"],["ある"],["。"]]},{"verse":17,"text":"また城壁,じょうへきを測,はかると、百四十四キュビトであった。これは人間,にんげんの、すなわち、御使,みつかいの尺度,しゃくどによるのである。","tok":[["また"],["城壁","じょうへき"],["を"],["測る","はかる"],["と"],["、"],["百四十四","ひゃくよんじゅうよん"],["キュビト"],["で"],["あった"],["。"],["これ"],["は"],["人間","にんげん"],["の"],["、"],["すなわち"],["、"],["御使","みつかい"],["の"],["尺度","しゃくど"],["に"],["よる"],["ので"],["ある"],["。"]]},{"verse":18,"text":"城壁,じょうへきは碧玉,へきぎょくで築,きずかれ、都,みやこはすきとおったガラスのような純金,じゅんきんで造,つくられていた。","tok":[["城壁","じょうへき"],["は"],["碧玉","へきぎょく"],["で"],["築かれ","きずかれ"],["、"],["都","みやこ"],["は"],["すきとおった"],["ガラス"],["の"],["よう"],["な"],["純金","じゅんきん"],["で"],["造られて","つくられて"],["いた"],["。"]]},{"verse":19,"text":"都,みやこの城壁,じょうへきの土台,どだいは、さまざまな宝石,ほうせきで飾,かざられていた。第,だい一の土台,どだいは碧玉,へきぎょく、第,だい二はサファイヤ、第,だい三はめのう、第,だい四は緑玉,りょくぎょく、","tok":[["都","みやこ"],["の"],["城壁","じょうへき"],["の"],["土台","どだい"],["は"],["、"],["さまざま"],["な"],["宝石","ほうせき"],["で"],["飾られて","かざられて"],["いた"],["。"],["第","だい"],["一","いち"],["の"],["土台","どだい"],["は"],["碧玉","へきぎょく"],["、"],["第","だい"],["二","に"],["は"],["サファイヤ"],["、"],["第","だい"],["三","さん"],["は"],["めのう"],["、"],["第","だい"],["四","よん"],["は"],["緑玉","りょくぎょく"],["、"]]},{"verse":20,"text":"第,だい五は縞,しまめのう、第,だい六は赤,あかめのう、第,だい七はかんらん石,せき、第,だい八は緑柱石,りょくちゅうせき、第,だい九は黄玉石,おうぎょくせき、第,だい十はひすい、第,だい十一は青玉,せいぎょく、第,だい十二は紫水晶,むらさきずいしょうであった。","tok":[["第","だい"],["五","ご"],["は"],["縞","しま"],["めのう"],["、"],["第","だい"],["六","ろく"],["は"],["赤め","あかめ"],["のう"],["、"],["第","だい"],["七","なな"],["は"],["かんらん"],["石","せき"],["、"],["第","だい"],["八","はち"],["は"],["緑柱石","りょくちゅうせき"],["、"],["第","だい"],["九","きゅう"],["は"],["黄玉石","おうぎょくせき"],["、"],["第","だい"],["十","じゅう"],["は"],["ひすい"],["、"],["第","だい"],["十一","じゅういち"],["は"],["青玉","せいぎょく"],["、"],["第","だい"],["十二","じゅうに"],["は"],["紫水晶","む"],["ら"],["さ"],["きずい"],["しょう"],["で"],["あった"],["。"]]},{"verse":21,"text":"十二の門,もんは十二の真珠,しんじゅであり、門,もんはそれぞれ一つの真珠,しんじゅで造,つくられ、都,みやこの大通,おおどおりは、すきとおったガラスのような純金,じゅんきんであった。","tok":[["十二","じゅうに"],["の"],["門","もん"],["は"],["十二","じゅうに"],["の"],["真珠","しんじゅ"],["で"],["あり"],["、"],["門","もん"],["は"],["それぞれ"],["一","ひと"],["つ"],["の"],["真珠","しんじゅ"],["で"],["造られ","つくられ"],["、"],["都","みやこ"],["の"],["大通り","おおどおり"],["は"],["、"],["すきとおった"],["ガラス"],["の"],["よう"],["な"],["純金","じゅんきん"],["で"],["あった"],["。"]]},{"verse":22,"text":"わたしは、この都,みやこの中,なかには聖所,せいじょを見,みなかった。全能者,ぜんのうしゃにして主,しゅなる神,かみと小羊,こひつじとが、その聖所,せいじょなのである。","tok":[["わたし"],["は"],["、"],["この"],["都","みやこ"],["の"],["中","なか"],["に"],["は"],["聖","せい"],["所","しょ"],["を"],["見なかった","みなかった"],["。"],["全能者","ぜんのうしゃ"],["に"],["して"],["主","しゅ"],["なる"],["神","かみ"],["と"],["小羊","こひつじ"],["と"],["が"],["、"],["その"],["聖","せい"],["所","しょ"],["ので"],["ある"],["。"]]},{"verse":23,"text":"都,みやこは、日,ひや月,つきがそれを照,てらす必要,ひつようがない。神,かみの栄光,えいこうが都,みやこを明,あかるくし、小羊,こひつじが都,みやこのあかりだからである。","tok":[["都","みやこ"],["は"],["、"],["日","ひ"],["や"],["月","つき"],["が"],["それ"],["を"],["照らす","てらす"],["必要","ひつよう"],["が"],["ない"],["。"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["都","みやこ"],["を"],["明かるく","あかるく"],["し"],["、"],["小羊","こひつじ"],["が"],["都","みやこ"],["の"],["あかり"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":24,"text":"諸,しょ国民,こくみんは都,みやこの光,ひかりの中,なかを歩,あるき、地,ちの王,おうたちは、自分,じぶんたちの光栄,こうえいをそこに携,たずさえて来,くる。","tok":[["諸","しょ"],["国民","こくみん"],["は"],["都","みやこ"],["の"],["光","ひかり"],["の"],["中","なか"],["を"],["歩き","あるき"],["、"],["地","ち"],["の"],["王","おう"],["たち"],["は"],["、"],["自分","じぶん"],["たち"],["の"],["光栄","こうえい"],["を"],["そこ"],["に"],["携えて","たずさえて"],["来る","くる"],["。"]]},{"verse":25,"text":"都,みやこの門,もんは、終日,しゅうじつ、閉,とざされることはない。そこには夜,よるがないからである。","tok":[["都","みやこ"],["の"],["門","もん"],["は"],["、"],["終日","しゅうじつ"],["、"],["閉ざされる","とざされる"],["こと"],["は"],["ない"],["。"],["そこ"],["に"],["は"],["夜","よる"],["が"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"人々,ひとびとは、諸,しょ国民,こくみんの光栄,こうえいとほまれとをそこに携,たずさえて来,くる。","tok":[["人々","ひとびと"],["は"],["、"],["諸","しょ"],["国民","こくみん"],["の"],["光栄","こうえい"],["と"],["ほまれ"],["と"],["を"],["そこ"],["に"],["携えて","たずさえて"],["来る","くる"],["。"]]},{"verse":27,"text":"しかし、汚,けがれた者,ものや、忌,いむべきこと及,および偽,いつわりを行,おこなう者,ものは、その中,なかに決,けっしてはいれない。はいれる者,ものは、小羊,こひつじのいのちの書,しょに名,なをしるされている者,ものだけである。","tok":[["しかし"],["、"],["汚","け"],["がれ"],["た"],["者","もの"],["や"],["、"],["忌むべき","いむべき"],["こと"],["及","および"],["偽り","いつわり"],["を"],["行なう","おこなう"],["者","もの"],["は"],["、"],["その"],["中","なか"],["に"],["決っして","けっして"],["はいれない"],["。"],["はいれる"],["者","もの"],["は"],["、"],["小羊","こひつじ"],["の"],["いのち"],["の"],["書","しょ"],["に"],["名","な"],["を"],["しるされて"],["いる"],["者","もの"],["だけ"],["で"],["ある"],["。"]]}]
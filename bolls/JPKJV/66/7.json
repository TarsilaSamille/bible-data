[{"verse":1,"text":"この後,のち、わたしは四人,にんの御使,みつかいが地,ちの四すみに立,たっているのを見,みた。彼,かれらは地,ちの四方,しほうの風,かぜをひき止,とめて、地,ちにも海,うみにもすべての木,きにも、吹,ふきつけないようにしていた。","tok":[["この"],["後","の"],["ち"],["、"],["わたし"],["は"],["四人","にん"],["の"],["御使","み"],["つかい"],["が"],["地","ち"],["の"],["四","よん"],["すみ"],["に"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["ら"],["は"],["地","ち"],["の"],["四方","しほう"],["の"],["風","かぜ"],["を"],["ひき"],["止","とめ"],["て"],["、"],["地","ち"],["に"],["も"],["海","うみ"],["に"],["も"],["すべて"],["の"],["木","き"],["に"],["も"],["、"],["吹つけない","ふきつけない"],["よう"],["に"],["して"],["いた"],["。"]]},{"verse":2,"text":"また、もうひとりの御使,みつかいが、生,いける神,かみの印,いんを持,もって、日,ひの出,でる方,ほうから上,のぼって来,くるのを見,みた。彼,かれは地,ちと海,うみとをそこなう権威,けんいを授,さずかっている四人,にんの御使,みつかいにむかって、大声,おおごえで叫,さけんで言,いった、","tok":[["また"],["、"],["もう"],["ひとり"],["の"],["御使","み"],["つかい"],["が"],["、"],["生ける","いける"],["神","かみ"],["の"],["印","いん"],["を"],["持って","もって"],["、"],["日","ひ"],["の"],["出る","でる"],["方","ほう"],["から"],["上って","のぼって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["は"],["地","ち"],["と"],["海","うみ"],["と"],["を"],["そこなう"],["権威","けんい"],["を"],["授かって","さずかって"],["いる"],["四人","にん"],["の"],["御使","みつかい"],["に"],["むかって"],["、"],["大声","おおごえ"],["で"],["叫けんで","さけんで"],["言った","いった"],["、"]]},{"verse":3,"text":"「わたしたちの神,かみの僕,しもべらの額,ひたいに、わたしたちが印,いんをおしてしまうまでは、地,ちと海,うみと木,きとをそこなってはならない」。","tok":[["「"],["わたしたち"],["の"],["神","かみ"],["の"],["僕","し"],["も"],["べら"],["の"],["額","ひたい"],["に"],["、"],["わたしたち"],["が"],["印","いん"],["を"],["おして"],["しまう"],["まで"],["は"],["、"],["地","ち"],["と"],["海","うみ"],["と"],["木","き"],["と"],["を"],["そこなって"],["は"],["ならない"],["」"],["。"]]},{"verse":4,"text":"わたしは印,いんをおされた者,ものの数,かずを聞,きいたが、イスラエルの子,こらのすべての部族,ぶぞくのうち、印,いんをおされた者,ものは十四万四千人,にんであった。","tok":[["わたし"],["は"],["印","いん"],["を"],["おされた"],["者","もの"],["の"],["数","かず"],["を"],["聞いた","きいた"],["が"],["、"],["イスラエル"],["の"],["子","こ"],["ら"],["の"],["すべて"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["印","いん"],["を"],["おされた"],["者","もの"],["は"],["十四万四千","じゅうよんまんよんせん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":5,"text":"ユダの部族,ぶぞくのうち、一万二千人,にんが印,いんをおされ、ルベンの部族,ぶぞくのうち、一万二千人,にん、ガドの部族,ぶぞくのうち、一万二千人,にん、","tok":[["ユダ"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["が"],["印","いん"],["を"],["おされ"],["、"],["ルベン"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ガド"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":6,"text":"アセルの部族,ぶぞくのうち、一万二千人,にん、ナフタリの部族,ぶぞくのうち、一万二千人,にん、マナセの部族,ぶぞくのうち、一万二千人,にん、","tok":[["アセル"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ナフタリ"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"],["マナセ"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":7,"text":"シメオンの部族,ぶぞくのうち、一万二千人,にん、レビの部族,ぶぞくのうち、一万二千人,にん、イサカルの部族,ぶぞくのうち、一万二千人,にん、","tok":[["シメオン"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"],["レビ"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"],["イサカル"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"]]},{"verse":8,"text":"ゼブルンの部族,ぶぞくのうち、一万二千人,にん、ヨセフの部族,ぶぞくのうち、一万二千人,にん、ベニヤミンの部族,ぶぞくのうち、一万二千人,にんが印,いんをおされた。","tok":[["ゼブルン"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ヨセフ"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["、"],["ベニヤミン"],["の"],["部族","ぶぞく"],["の"],["うち"],["、"],["一万二千","いちまんにせん"],["人","にん"],["が"],["印","いん"],["を"],["おされた"],["。"]]},{"verse":9,"text":"その後,のち、わたしが見,みていると、見,みよ、あらゆる国民,こくみん、部族,ぶぞく、民族,みんぞく、国語,こくごのうちから、数,かぞえきれないほどの大,おおぜいの群衆,ぐんしゅうが、白,しろい衣,ころもを身,みにまとい、しゅろの枝,えだを手,てに持,もって、御座,みざと小羊,こひつじとの前,まえに立,たち、","tok":[["その後","そのの"],["ち"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["あらゆる"],["国民","こくみん"],["、"],["部族","ぶぞく"],["、"],["民族","みんぞく"],["、"],["国語","こくご"],["の"],["うち"],["から"],["、"],["数え","かぞえ"],["きれない"],["ほど"],["の"],["大ぜい","おおぜい"],["の"],["群衆","ぐんしゅう"],["が"],["、"],["白い","しろい"],["衣","ころも"],["を"],["身","み"],["に"],["まとい"],["、"],["しゅろ"],["の"],["枝","えだ"],["を"],["手","て"],["に"],["持って","もって"],["、"],["御座","みざ"],["と"],["小羊","こひつじ"],["と"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"]]},{"verse":10,"text":"大声,おおごえで叫,さけんで言,いった、「救,すくいは、御座,みざにいますわれらの神,かみと小羊,こひつじからきたる」。","tok":[["大声","おおごえ"],["で"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["救い","すくい"],["は"],["、"],["御座","みざ"],["に"],["います"],["われ"],["ら"],["の"],["神","かみ"],["と"],["小羊","こひつじ"],["から"],["きたる"],["」"],["。"]]},{"verse":11,"text":"御使,みつかいたちはみな、御座,みざと長老,ちょうろうたちと四つの生,いき物,ものとのまわりに立,たっていたが、御座,みざの前,まえにひれ伏,ふし、神,かみを拝,はいして言,いった、","tok":[["御使","みつかいたち"],["は"],["みな"],["、"],["御座","みざ"],["と"],["長老","ちょうろう"],["たち"],["と"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["の"],["まわり"],["に"],["立って","たって"],["いた"],["が"],["、"],["御座","みざ"],["の"],["前","まえ"],["に"],["ひれ伏し","ひれふし"],["、"],["神","かみ"],["を"],["拝して","はいして"],["言った","いった"],["、"]]},{"verse":12,"text":"「アァメン、さんび、栄光,えいこう、知恵,ちえ、感謝,かんしゃ、ほまれ、力,ちから、勢,いきおいが、世々,よよ限,かぎりなく、われらの神,かみにあるように、アァメン」。","tok":[["「"],["アァメン"],["、"],["さん"],["び"],["、"],["栄光","えいこう"],["、"],["知恵","ちえ"],["、"],["感謝","かんしゃ"],["、"],["ほまれ"],["、"],["力","ちから"],["、"],["勢い","いきおい"],["が"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["、"],["われ"],["ら"],["の"],["神","かみ"],["に"],["ある"],["よう"],["に"],["、"],["アァメン"],["」"],["。"]]},{"verse":13,"text":"長老,ちょうろうたちのひとりが、わたしにむかって言,いった、「この白,しろい衣,ころもを身,みにまとっている人々,ひとびとは、だれか。また、どこからきたのか」。","tok":[["長老","ちょうろう"],["たち"],["の"],["ひとり"],["が"],["、"],["わたし"],["に"],["むかって"],["言った","いった"],["、"],["「"],["この"],["白い","しろい"],["衣","ころも"],["を"],["身","み"],["に"],["まとって"],["いる"],["人々","ひとびと"],["は"],["、"],["だれ"],["か"],["。"],["また"],["、"],["どこ"],["から"],["きた"],["の"],["か"],["」"],["。"]]},{"verse":14,"text":"わたしは彼,かれに答,こたえた、「わたしの主,しゅよ、それはあなたがご存,ぞんじです」。すると、彼,かれはわたしに言,いった、「彼,かれらは大,おおきな患難,かんなんをとおってきた人,ひとたちであって、その衣,ころもを小羊,こひつじの血,ちで洗,あらい、それを白,しろくしたのである。","tok":[["わたし"],["は"],["彼","かれ"],["に"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["の"],["主","しゅ"],["よ"],["、"],["それ"],["は"],["あなた"],["が"],["ご存じ","ごぞんじ"],["です"],["」"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["、"],["「"],["彼","かれ"],["ら"],["は"],["大きな","おおきな"],["患難","かんなん"],["を"],["とおって"],["きた"],["人","ひと"],["たち"],["で"],["あって"],["、"],["その"],["衣","ころも"],["を"],["小羊","こひつじ"],["の"],["血","ち"],["で"],["洗","あらい"],["、"],["それ"],["を"],["白く","しろく"],["した"],["ので"],["ある"],["。"]]},{"verse":15,"text":"それだから彼,かれらは、神,かみの御座,みざの前,まえにおり、昼,ひるも夜,よるもその聖所,せいじょで神,かみに仕,つかえているのである。御座,みざにいますかたは、彼,かれらの上,うえに幕屋,まくやを張,はって共,ともに住,すまわれるであろう。","tok":[["それ"],["だ"],["から"],["彼","かれ"],["ら"],["は"],["、"],["神","かみ"],["の"],["御座","みざ"],["の"],["前","まえ"],["に"],["おり"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["その"],["聖","せい"],["所","しょ"],["い"],["じょ"],["で"],["神","かみ"],["に"],["仕えて","つかえて"],["いる"],["ので"],["ある"],["。"],["御座","みざ"],["に"],["います"],["かた"],["は"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["幕屋","まくや"],["を"],["張って","はって"],["共","とも"],["に"],["住まわれるで","すまわれるで"],["あろう"],["。"]]},{"verse":16,"text":"彼,かれらは、もはや飢,うえることがなく、かわくこともない。太陽,たいようも炎暑,えんしょも、彼,かれらを侵,おかすことはない。","tok":[["彼","かれ"],["ら"],["は"],["、"],["もはや"],["飢","うえ"],["る"],["こと"],["が"],["なく"],["、"],["かわく"],["こと"],["も"],["ない"],["。"],["太陽","たいよう"],["も"],["炎暑","えんしょ"],["も"],["、"],["彼","かれ"],["ら"],["を"],["侵す","おかす"],["こと"],["は"],["ない"],["。"]]},{"verse":17,"text":"御座,みざの正面,しょうめんにいます小羊,こひつじは彼,かれらの牧者,ぼくしゃとなって、いのちの水,みずの泉,いずみに導,みちびいて下,くださるであろう。また神,かみは、彼,かれらの目,めから涙,なみだをことごとくぬぐいとって下,くださるであろう」。","tok":[["御座","みざ"],["の"],["正面","しょうめん"],["に"],["います"],["小羊","こひつじ"],["は"],["彼","かれ"],["ら"],["の"],["牧者","ぼくしゃ"],["と"],["なって"],["、"],["いのち"],["の"],["水","みず"],["の"],["泉","いずみ"],["に"],["導いて","みちびいて"],["下さるで","くださるで"],["あろう"],["。"],["また"],["神","かみ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["から"],["涙","なみだ"],["を"],["ことごとく"],["ぬぐいとって"],["下さるで","くださるで"],["あろう"],["」"],["。"]]}]
[{"verse":1,"text":"また、大,おおいなるしるしが天,てんに現,あらわれた。ひとりの女,おんなが太陽,たいようを着,きて、足,あしの下,したに月,つきを踏,ふみ、その頭,あたまに十二の星,ほしの冠,かんむりをかぶっていた。","tok":[["また"],["、"],["大いなる","おおいなる"],["しるし"],["が"],["天","てん"],["に"],["現われた","あらわれた"],["。"],["ひとり"],["の"],["女","おんな"],["が"],["太陽","たいよう"],["を"],["着て","きて"],["、"],["足","あし"],["の"],["下","した"],["に"],["月","つき"],["を"],["踏み","ふみ"],["、"],["その"],["頭","あたま"],["に"],["十二","じゅうに"],["の"],["星","ほし"],["の"],["冠","かんむり"],["を"],["かぶって"],["いた"],["。"]]},{"verse":2,"text":"この女,おんなは子,こを宿,やどしており、産,うみの苦,くるしみと悩,なやみとのために、泣,なき叫,さけんでいた。","tok":[["この"],["女","おんな"],["は"],["子","こ"],["を"],["宿して","やどして"],["おり"],["、"],["産み","うみ"],["の"],["苦しみ","くるしみ"],["と"],["悩み","なやみ"],["と"],["の"],["ため"],["に"],["、"],["泣","なき"],["叫けんで","さけんで"],["いた"],["。"]]},{"verse":3,"text":"また、もう一つのしるしが天,てんに現,あらわれた。見,みよ、大,おおきな、赤,あかい龍,りゅうがいた。それに七つの頭,あたまと十の角,つのとがあり、その頭,あたまに七つの冠,かんむりをかぶっていた。","tok":[["また"],["、"],["もう"],["一","ひと"],["つ"],["の"],["しるし"],["が"],["天","てん"],["に"],["現われた","あらわれた"],["。"],["見よ","みよ"],["、"],["大きな","おおきな"],["、"],["赤い","あかい"],["龍","りゅう"],["が"],["いた"],["。"],["それ"],["に"],["七","なな"],["つ"],["の"],["頭","あたま"],["と"],["十","じゅう"],["の"],["角","つのと"],["が"],["あり"],["、"],["その"],["頭","あたま"],["に"],["七","なな"],["つ"],["の"],["冠","かんむり"],["を"],["かぶって"],["いた"],["。"]]},{"verse":4,"text":"その尾,おは天,てんの星,ほしの三分,ぶんの一を掃,はき寄,よせ、それらを地,ちに投,なげ落,おとした。龍,りゅうは子,こを産,うもうとしている女,おんなの前,まえに立,たち、生,うまれたなら、その子,こを食,くい尽,つくそうとかまえていた。","tok":[["その"],["尾","お"],["は"],["天","てん"],["の"],["星","ほし"],["の"],["三分","ぶん"],["の"],["一","いち"],["を"],["掃き寄せ","はきよせ"],["、"],["それ"],["ら"],["を"],["地","ち"],["に"],["投","なげ"],["落とした","おとした"],["。"],["龍","りゅう"],["は"],["子","こ"],["を"],["産もう","うもう"],["として"],["いる"],["女","おんな"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["生まれたなら","うまれたなら"],["、"],["その"],["子","こ"],["を"],["食い","くい"],["尽くそう","つくそう"],["と"],["かまえて"],["いた"],["。"]]},{"verse":5,"text":"女,おんなは男,おとこの子,こを産,うんだが、彼,かれは鉄,てつのつえをもってすべての国民,こくみんを治,おさめるべき者,ものである。この子,こは、神,かみのみもとに、その御座,みざのところに、引,ひき上,あげられた。","tok":[["女","おんな"],["は"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["が"],["、"],["彼","かれ"],["は"],["鉄","てつ"],["の"],["つえ"],["を"],["もって"],["すべて"],["の"],["国民","こくみん"],["を"],["治めるべき","おさめるべき"],["者","もの"],["で"],["ある"],["。"],["この"],["子","こ"],["は"],["、"],["神","かみ"],["のみ"],["もと"],["に"],["、"],["その"],["御座","みざ"],["の"],["ところ"],["に"],["、"],["引上げられた","ひきあげられた"],["。"]]},{"verse":6,"text":"女,おんなは荒野,あらのへ逃,にげて行,いった。そこには、彼女,かのじょが千二百六十日,にちのあいだ養,やしなわれるように、神,かみの用意,よういされた場所,ばしょがあった。","tok":[["女","おんな"],["は"],["荒野","あら"],["の"],["へ"],["逃て","にげて"],["行った","いった"],["。"],["そこ"],["に"],["は"],["、"],["彼女","かのじょ"],["が"],["千二百六十","せんにひゃくろくとう"],["日","か"],["の"],["あいだ"],["養われる","やしなわれる"],["よう"],["に"],["、"],["神","かみ"],["の"],["用意","ようい"],["された"],["場所","ばしょ"],["が"],["あった"],["。"]]},{"verse":7,"text":"さて、天,てんでは戦,たたかいが起,おこった。ミカエルとその御使,みつかいたちとが、龍,りゅうと戦,たたかったのである。龍,りゅうもその使,つかいたちも応戦,おうせんしたが、","tok":[["さて"],["、"],["天","てん"],["で"],["は"],["戦い","たたかい"],["が"],["起こった","おこった"],["。"],["ミカエル"],["と"],["その"],["御使","みつかい"],["たち"],["と"],["が"],["、"],["龍","りゅう"],["と"],["戦った","たたかった"],["ので"],["ある"],["。"],["龍","りゅう"],["も"],["その"],["使","つかい"],["たち"],["も"],["応戦","おうせん"],["した"],["が"],["、"]]},{"verse":8,"text":"勝,かてなかった。そして、もはや天,てんには彼,かれらのおる所,ところがなくなった。","tok":[["勝てなかった","かてなかった"],["。"],["そして"],["、"],["もはや"],["天","てん"],["に"],["は"],["彼","かれ"],["ら"],["の"],["おる"],["所","ところ"],["が"],["なくなった"],["。"]]},{"verse":9,"text":"この巨大,きょだいな龍,りゅう、すなわち、悪魔,あくまとか、サタンとか呼,よばれ、全,ぜん世界,せかいを惑,まどわす年,としを経,へたへびは、地,ちに投,なげ落,おとされ、その使,つかいたちも、もろともに投,なげ落,おとされた。","tok":[["この"],["巨大","きょだい"],["な"],["龍","りゅう"],["、"],["すなわち"],["、"],["悪魔","あくま"],["と"],["か"],["、"],["サタン"],["と"],["か"],["呼ばれ","よばれ"],["、"],["全","ぜん"],["世界","せかい"],["を"],["惑わす","まどわす"],["年","とし"],["を"],["経た","へた"],["へび"],["は"],["、"],["地","ち"],["に"],["投","なげ"],["落とされ","おとされ"],["、"],["その"],["使","つかい"],["たち"],["も"],["、"],["もろとも"],["に"],["投","なげ"],["落とされた","おとされた"],["。"]]},{"verse":10,"text":"その時,ときわたしは、大,おおきな声,こえが天,てんでこう言,いうのを聞,きいた、「今,いまや、われらの神,かみの救,すくいと力,ちからと国,くにと、神,かみのキリストの権威,けんいとは、現,あらわれた。われらの兄弟,きょうだいらを訴,うったえる者,もの、夜昼,よるひるわれらの神,かみのみまえで彼,かれらを訴,うったえる者,ものは、投,なげ落,おとされた。","tok":[["その"],["時","とき"],["わたし"],["は"],["、"],["大きな","おおきな"],["声","こえ"],["が"],["天","てん"],["で"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["、"],["「"],["今","いま"],["や"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["救い","すくい"],["と"],["力","ちから"],["と"],["国","くに"],["と"],["、"],["神","かみ"],["の"],["キリスト"],["の"],["権威","けんい"],["と"],["は"],["、"],["現われた","あらわれた"],["。"],["われ"],["ら"],["の"],["兄弟","きょうだい"],["ら"],["を"],["訴る","うったえる"],["者","もの"],["、"],["夜","よる"],["昼","ひる"],["われ"],["ら"],["の"],["神","かみ"],["のみ"],["ま"],["え"],["で"],["彼","かれ"],["ら"],["を"],["訴る","うったえる"],["者","もの"],["は"],["、"],["投","なげ"],["落とされた","おとされた"],["。"]]},{"verse":11,"text":"兄弟,きょうだいたちは、小羊,こひつじの血,ちと彼,かれらのあかしの言葉,ことばとによって、彼,かれにうち勝,かち、死,しに至,いたるまでもそのいのちを惜,おしまなかった。","tok":[["兄弟","きょうだい"],["たち"],["は"],["、"],["小羊","こひつじ"],["の"],["血","ち"],["と"],["彼","かれ"],["ら"],["の"],["あかし"],["の"],["言葉","ことば"],["と"],["によって"],["、"],["彼","かれ"],["に"],["うち"],["勝","かち"],["、"],["死","し"],["に"],["至る","いたる"],["まで"],["も"],["その"],["いのち"],["を"],["惜まなかった","おしまなかった"],["。"]]},{"verse":12,"text":"それゆえに、天,てんとその中,なかに住,すむ者,ものたちよ、大,おおいに喜,よろこべ。しかし、地,ちと海,うみよ、おまえたちはわざわいである。悪魔,あくまが、自分,じぶんの時,ときが短,みじかいのを知,しり、激,はげしい怒,いかりをもって、おまえたちのところに下,くだってきたからである」。","tok":[["それ"],["ゆえ"],["に"],["、"],["天","てん"],["と"],["その"],["中","なか"],["に"],["住む","すむ"],["者","もの"],["たち"],["よ"],["、"],["大いに","おおいに"],["喜こべ","よろこべ"],["。"],["しかし"],["、"],["地","ち"],["と"],["海","うみ"],["よ"],["、"],["おまえ"],["たち"],["は"],["わざわい"],["で"],["ある"],["。"],["悪魔","あくま"],["が"],["、"],["自分","じぶん"],["の"],["時","とき"],["が"],["短かい","みじかい"],["の"],["を"],["知り","しり"],["、"],["激しい","はげしい"],["怒り","いかり"],["を"],["もって"],["、"],["おまえ"],["たち"],["の"],["ところ"],["に"],["下って","くだって"],["きた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"龍,りゅうは、自分,じぶんが地上,ちじょうに投,なげ落,おとされたと知,しると、男子,だんしを産,うんだ女,おんなを追,おいかけた。","tok":[["龍","りゅう"],["は"],["、"],["自分","じぶん"],["が"],["地上","ちじょう"],["に"],["投","なげ"],["落とされた","おとされた"],["と"],["知る","しる"],["と"],["、"],["男子","だんし"],["を"],["産んだ","うんだ"],["女","おんな"],["を"],["追いかけた","おいかけた"],["。"]]},{"verse":14,"text":"しかし、女,おんなは自分,じぶんの場所,ばしょである荒野,あらのに飛,とんで行,いくために、大,おおきなわしの二つの翼,つばさを与,あたえられた。そしてそこでへびからのがれて、一年,ねん、二年,ねん、また、半年,はんとしの間,あいだ、養,やしなわれることになっていた。","tok":[["しかし"],["、"],["女","おんな"],["は"],["自分","じぶん"],["の"],["場所","ばしょ"],["で"],["ある"],["荒野","あらの"],["に"],["飛んで","とんで"],["行く","いく"],["ため"],["に"],["、"],["大きな","おおきな"],["わし"],["の"],["二","ふた"],["つ"],["の"],["翼","つばさ"],["を"],["与えられた","あたえられた"],["。"],["そして"],["そこ"],["で"],["へび"],["から"],["のがれて"],["、"],["一","いち"],["年","ねん"],["、"],["二","に"],["年","ねん"],["、"],["また"],["、"],["半年","はんとし"],["の"],["間","あいだ"],["、"],["養われる","やしなわれる"],["こと"],["に"],["なって"],["いた"],["。"]]},{"verse":15,"text":"へびは女,おんなの後,うしろに水,みずを川,かわのように、口,くちから吐,はき出,だして、女,おんなをおし流,ながそうとした。","tok":[["へび"],["は"],["女","おんな"],["の"],["後ろ","うしろ"],["に"],["水","みず"],["を"],["川","かわ"],["の"],["よう"],["に"],["、"],["口","くち"],["から"],["吐出","はきだ"],["して"],["、"],["女","おんな"],["を"],["おし流そう","おしながそう"],["と"],["した"],["。"]]},{"verse":16,"text":"しかし、地,ちは女,おんなを助,たすけた。すなわち、地,ちはその口,くちを開,ひらいて、龍,りゅうが口,くちから吐,はき出,だした川,かわを飲,のみほした。","tok":[["しかし"],["、"],["地","ち"],["は"],["女","おんな"],["を"],["助けた","たすけた"],["。"],["すなわち"],["、"],["地","ち"],["は"],["その"],["口","くち"],["を"],["開らいて","ひらいて"],["、"],["龍","りゅう"],["が"],["口","くち"],["から"],["吐出","はきだ"],["した"],["川","かわ"],["を"],["飲みほした","のみほした"],["。"]]},{"verse":17,"text":"龍,りゅうは、女,おんなに対,たいして怒,いかりを発,はっし、女,おんなの残,のこりの子,こら、すなわち、神,かみの戒,いましめを守,まもり、イエスのあかしを持,もっている者,ものたちに対,たいして、戦,たたかいをいどむために、出,でて行,いった。","tok":[["龍","りゅう"],["は"],["、"],["女","おんな"],["に対して","にたいして"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["女","おんな"],["の"],["残り","のこり"],["の"],["子","こ"],["ら"],["、"],["すなわち"],["、"],["神","かみ"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["イエス"],["の"],["あかし"],["を"],["持って","もって"],["いる"],["者","もの"],["たち"],["に対して","にたいして"],["、"],["戦い","たたかい"],["を"],["いどむ"],["ため"],["に"],["、"],["出て","でて"],["行った","いった"],["。"]]},{"verse":18,"text":"そして、海,うみの砂,すなの上,うえに立,たった。","tok":[["そして"],["、"],["海","うみ"],["の"],["砂","すな"],["の"],["上","うえ"],["に"],["立った","たった"],["。"]]}]
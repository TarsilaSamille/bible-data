[{"verse":1,"text":"わたしはまた、一匹,ぴきの獣,けものが海,うみから上,のぼって来,くるのを見,みた。それには角,つのが十本,ぽん、頭,あたまが七つあり、それらの角,つのには十の冠,かんむりがあって、頭,あたまには神,かみを汚,けがす名,ながついていた。","tok":[["わたし"],["は"],["また"],["、"],["一匹","ぴき"],["の"],["獣","けもの"],["が"],["海","うみ"],["から"],["上って","のぼって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["それ"],["に"],["は"],["角","つ"],["の"],["が"],["十本","ぽん"],["、"],["頭","あたま"],["が"],["七","なな"],["つ"],["あり"],["、"],["それ"],["ら"],["の"],["角","つ"],["のに"],["は"],["十","じゅう"],["の"],["冠","かんむり"],["が"],["あって"],["、"],["頭","あたま"],["に"],["は"],["神","かみ"],["を"],["汚","け"],["がす"],["名","な"],["が"],["ついて"],["いた"],["。"]]},{"verse":2,"text":"わたしの見,みたこの獣,けものはひょうに似,にており、その足,あしはくまの足,あしのようで、その口,くちはししの口,くちのようであった。龍,りゅうは自分,じぶんの力,ちからと位,くらいと大,おおいなる権威,けんいとを、この獣,けものに与,あたえた。","tok":[["わたし"],["の"],["見た","みた"],["この"],["獣","けもの"],["は"],["ひょう"],["に"],["似て","にて"],["おり"],["、"],["その"],["足","あし"],["は"],["くま"],["の"],["足","あし"],["の"],["よう"],["で"],["、"],["その"],["口","くち"],["は"],["しし"],["の"],["口","くち"],["の"],["よう"],["で"],["あった"],["。"],["龍","りゅう"],["は"],["自分","じぶん"],["の"],["力","ちから"],["と"],["位","くらい"],["と"],["大いなる","おおいなる"],["権威","けんい"],["と"],["を"],["、"],["この"],["獣","けもの"],["に"],["与","あたえ"],["た"],["。"]]},{"verse":3,"text":"その頭,あたまの一つが、死,しぬほどの傷,きずを受,うけたが、その致命,ちめい的,てきな傷,きずもなおってしまった。そこで、全,ぜん地,ちの人々,ひとびとは驚,おどろきおそれて、その獣,けものに従,したがい、","tok":[["その"],["頭","あたま"],["の"],["一","ひと"],["つ"],["が"],["、"],["死ぬ","しぬ"],["ほど"],["の"],["傷","きず"],["を"],["受た","うけた"],["が"],["、"],["その"],["致命的","ちめいてき"],["な"],["傷","きず"],["も"],["なおって"],["しまった"],["。"],["そこ"],["で"],["、"],["全地","ぜんち"],["の"],["人々","ひとびと"],["は"],["驚","おどろき"],["おそれて"],["、"],["その"],["獣","けもの"],["に"],["従い","したがい"],["、"]]},{"verse":4,"text":"また、龍,りゅうがその権威,けんいを獣,けものに与,あたえたので、人々,ひとびとは龍,りゅうを拝,おがみ、さらに、その獣,けものを拝,おがんで言,いった、「だれが、この獣,けものに匹敵,ひってきし得,えようか。だれが、これと戦,たたかうことができようか」。","tok":[["また"],["、"],["龍","りゅう"],["が"],["その"],["権威","けんい"],["を"],["獣","けもの"],["に"],["与","あたえ"],["た"],["ので"],["、"],["人々","ひとびと"],["は"],["龍","りゅう"],["を"],["拝み","おがみ"],["、"],["さらに"],["、"],["その"],["獣","けもの"],["を"],["拝んで","おがんで"],["言った","いった"],["、"],["「"],["だれ"],["が"],["、"],["この"],["獣","けもの"],["に"],["匹敵","ひってき"],["し"],["得よう","えよう"],["か"],["。"],["だれ"],["が"],["、"],["これ"],["と"],["戦う","たたかう"],["こと"],["が"],["できよう"],["か"],["」"],["。"]]},{"verse":5,"text":"この獣,けものには、また、大言,たいげんを吐,はき汚,けがしごとを語,かたる口,くちが与,あたえられ、四十二か月,げつのあいだ活動,かつどうする権威,けんいが与,あたえられた。","tok":[["この"],["獣","けもの"],["に"],["は"],["、"],["また"],["、"],["大言","たいげん"],["を"],["吐","はき"],["汚","け"],["がし"],["ごと"],["を"],["語る","かたる"],["口","くち"],["が"],["与えられ","あたえられ"],["、"],["四十二","よんじゅうに"],["か月","かげつ"],["の"],["あいだ"],["活動","かつどう"],["する"],["権威","けんい"],["が"],["与えられた","あたえられた"],["。"]]},{"verse":6,"text":"そこで、彼,かれは口,くちを開,ひらいて神,かみを汚,けがし、神,かみの御名,みなと、その幕屋,まくや、すなわち、天,てんに住,すむ者,ものたちとを汚,けがした。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["口","くち"],["を"],["開らいて","ひらいて"],["神","かみ"],["を"],["汚","け"],["がし"],["、"],["神","かみ"],["の"],["御名","みな"],["と"],["、"],["その"],["幕屋","まくや"],["、"],["すなわち"],["、"],["天","てん"],["に"],["住む","すむ"],["者","もの"],["たち"],["と"],["を"],["汚","け"],["がした"],["。"]]},{"verse":7,"text":"そして彼,かれは、聖徒,せいとに戦,たたかいをいどんでこれに勝,かつことを許,ゆるされ、さらに、すべての部族,ぶぞく、民族,みんぞく、国語,こくご、国民,こくみんを支配,しはいする権威,けんいを与,あたえられた。","tok":[["そして"],["彼","かれ"],["は"],["、"],["聖徒","せいと"],["に"],["戦い","たたかい"],["を"],["いどんで"],["これ"],["に"],["勝つ","かつ"],["こと"],["を"],["許され","ゆるされ"],["、"],["さらに"],["、"],["すべて"],["の"],["部族","ぶぞく"],["、"],["民族","みんぞく"],["、"],["国語","こくご"],["、"],["国民","こくみん"],["を"],["支配","しはい"],["する"],["権威","けんい"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":8,"text":"地,ちに住,すむ者,もので、ほふられた小羊,こひつじのいのちの書,しょに、その名,なを世,よの初,はじめからしるされていない者,ものはみな、この獣,けものを拝,おがむであろう。","tok":[["地","ち"],["に"],["住む","すむ"],["者","もの"],["で"],["、"],["ほふられた"],["小羊","こひつじ"],["の"],["いのち"],["の"],["書","しょ"],["に"],["、"],["その"],["名","な"],["を"],["世","よ"],["の"],["初め","はじめ"],["から"],["しるされて"],["いない"],["者","もの"],["は"],["みな"],["、"],["この"],["獣","けもの"],["を"],["拝むで","おがむで"],["あろう"],["。"]]},{"verse":9,"text":"耳,みみのある者,ものは、聞,きくがよい。","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["、"],["聞く","きく"],["が"],["よい"],["。"]]},{"verse":10,"text":"とりこになるべき者,ものは、とりこになっていく。つるぎで殺,ころす者,ものは、自,みずからもつるぎで殺,ころされねばならない。ここに、聖徒,せいとたちの忍耐,にんたいと信仰,しんこうとがある。","tok":[["とりこ"],["に"],["なるべき"],["者","もの"],["は"],["、"],["とりこ"],["に"],["なって"],["いく"],["。"],["つるぎ"],["で"],["殺ろす","ころす"],["者","もの"],["は"],["、"],["自から","みずから"],["も"],["つるぎ"],["で"],["殺ろされねば","ころされねば"],["ならない"],["。"],["ここ"],["に"],["、"],["聖徒","せいと"],["たち"],["の"],["忍耐","にんたい"],["と"],["信仰","しんこう"],["と"],["が"],["ある"],["。"]]},{"verse":11,"text":"わたしはまた、ほかの獣,けものが地,ちから上,のぼって来,くるのを見,みた。それには小羊,こひつじのような角,つのが二つあって、龍,りゅうのように物,ものを言,いった。","tok":[["わたし"],["は"],["また"],["、"],["ほか"],["の"],["獣","けもの"],["が"],["地","ち"],["から"],["上って","のぼって"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["それ"],["に"],["は"],["小羊","こひつじ"],["の"],["よう"],["な"],["角","つ"],["の"],["が"],["二","ふた"],["つ"],["あって"],["、"],["龍","りゅう"],["の"],["よう"],["に"],["物","もの"],["を"],["言った","いった"],["。"]]},{"verse":12,"text":"そして、先,さきの獣,けものの持,もつすべての権力,けんりょくをその前,まえで働,はたらかせた。また、地,ちと地,ちに住,すむ人々,ひとびとに、致命,ちめい的,てきな傷,きずがいやされた先,さきの獣,けものを拝,おがませた。","tok":[["そして"],["、"],["先","さき"],["の"],["獣","けもの"],["の"],["持つ","もつ"],["すべて"],["の"],["権力","けんりょく"],["を"],["その"],["前","まえ"],["で"],["働かせた","はたらかせた"],["。"],["また"],["、"],["地","ち"],["と"],["地","ち"],["に"],["住む","すむ"],["人々","ひとびと"],["に"],["、"],["致命的","ちめいてき"],["な"],["傷","きず"],["が"],["いやされた"],["先","さき"],["の"],["獣","けもの"],["を"],["拝ませた","おがませた"],["。"]]},{"verse":13,"text":"また、大,おおいなるしるしを行,おこなって、人々,ひとびとの前,まえで火,ひを天,てんから地,ちに降,ふらせることさえした。","tok":[["また"],["、"],["大いなる","おおいなる"],["しるし"],["を"],["行なって","おこなって"],["、"],["人々","ひとびと"],["の"],["前","まえ"],["で"],["火","ひ"],["を"],["天","てん"],["から"],["地","ち"],["に"],["降らせる","ふらせる"],["こと"],["さえ"],["した"],["。"]]},{"verse":14,"text":"さらに、先,さきの獣,けものの前,まえで行,おこなうのを許,ゆるされたしるしで、地,ちに住,すむ人々,ひとびとを惑,まどわし、かつ、つるぎの傷,きずを受,うけてもなお生,いきている先,さきの獣,けものの像,ぞうを造,つくることを、地,ちに住,すむ人々,ひとびとに命,めいじた。","tok":[["さらに"],["、"],["先","さき"],["の"],["獣","けもの"],["の"],["前","まえ"],["で"],["行なう","おこなう"],["の"],["を"],["許された","ゆるされた"],["しるし"],["で"],["、"],["地","ち"],["に"],["住む","すむ"],["人々","ひとびと"],["を"],["惑わし","まどわし"],["、"],["かつ"],["、"],["つるぎ"],["の"],["傷","きず"],["を"],["受て","うけて"],["も"],["なお"],["生きて","いきて"],["いる"],["先","さき"],["の"],["獣","けもの"],["の"],["像","ぞう"],["を"],["造る","つくる"],["こと"],["を"],["、"],["地","ち"],["に"],["住む","すむ"],["人々","ひとびと"],["に"],["命じた","めいじた"],["。"]]},{"verse":15,"text":"それから、その獣,けものの像,ぞうに息,いきを吹,ふき込,こんで、その獣,けものの像,ぞうが物,ものを言,いうことさえできるようにし、また、その獣,けものの像,ぞうを拝,おがまない者,ものをみな殺,ころさせた。","tok":[["それ"],["から"],["、"],["その"],["獣","けもの"],["の"],["像","ぞう"],["に"],["息","いき"],["を"],["吹込んで","ふきこんで"],["、"],["その"],["獣","けもの"],["の"],["像","ぞう"],["が"],["物","もの"],["を"],["言う","いう"],["こと"],["さえ"],["できる"],["よう"],["に"],["し"],["、"],["また"],["、"],["その"],["獣","けもの"],["の"],["像","ぞう"],["を"],["拝まない","おがまない"],["者","もの"],["を"],["みな"],["殺させた","ころさせた"],["。"]]},{"verse":16,"text":"また、小,ちいさき者,ものにも、大,おおいなる者,ものにも、富,とめる者,ものにも、貧,まずしき者,ものにも、自由人,じゆうじんにも、奴隷,どれいにも、すべての人々,ひとびとに、その右,みぎの手,てあるいは額,ひたいに刻印,こくいんを押,おさせ、","tok":[["また"],["、"],["小い","ちい"],["さき"],["者","もの"],["に"],["も"],["、"],["大いなる","おおいなる"],["者","もの"],["に"],["も"],["、"],["富める","とめる"],["者","もの"],["に"],["も"],["、"],["貧しき","まずしき"],["者","もの"],["に"],["も"],["、"],["自由人","じゆうじん"],["に"],["も"],["、"],["奴隷","どれい"],["に"],["も"],["、"],["すべて"],["の"],["人々","ひとびと"],["に"],["、"],["その"],["右","みぎ"],["の"],["手","て"],["あるいは"],["額","ひたい"],["に"],["刻印","こくいん"],["を"],["押させ","おさせ"],["、"]]},{"verse":17,"text":"この刻印,こくいんのない者,ものはみな、物,ものを買,かうことも売,うることもできないようにした。この刻印,こくいんは、その獣,けものの名,な、または、その名,なの数字,すうじのことである。","tok":[["この"],["刻印","こくいん"],["の"],["ない"],["者","もの"],["は"],["みな"],["、"],["物","もの"],["を"],["買う","かう"],["こと"],["も"],["売る","うる"],["こと"],["も"],["できない"],["よう"],["に"],["した"],["。"],["この"],["刻印","こくいん"],["は"],["、"],["その"],["獣","けもの"],["の"],["名","な"],["、"],["また"],["は"],["、"],["その"],["名","な"],["の"],["数字","すうじ"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":18,"text":"ここに、知恵,ちえが必要,ひつようである。思慮,しりょのある者,ものは、獣,けものの数字,すうじを解,とくがよい。その数字,すうじとは、人間,にんげんをさすものである。そして、その数字,すうじは六百六十六である。","tok":[["ここ"],["に"],["、"],["知恵","ちえ"],["が"],["必要","ひつよう"],["で"],["ある"],["。"],["思慮","しりょ"],["の"],["ある"],["者","もの"],["は"],["、"],["獣","けもの"],["の"],["数字","すうじ"],["を"],["解く","とく"],["が"],["よい"],["。"],["その"],["数字","すうじ"],["と"],["は"],["、"],["人間","にんげん"],["を"],["さす"],["もの"],["で"],["ある"],["。"],["そして"],["、"],["その"],["数字","すうじ"],["は"],["六百六十六","ろくひゃくろくじゅうろく"],["で"],["ある"],["。"]]}]
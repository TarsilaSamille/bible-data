[{"verse":1,"text":"わたしは、もうひとりの強,つよい御使,みつかいが、雲,くもに包,つつまれて、天,てんから降,おりて来,くるのを見,みた。その頭,あたまに、にじをいただき、その顔,かおは太陽,たいようのようで、その足,あしは火,ひの柱,はしらのようであった。","tok":[["わたし"],["は"],["、"],["もう"],["ひとり"],["の"],["強い","つよい"],["御使","み"],["つかい"],["が"],["、"],["雲","くも"],["に"],["包まれて","つつまれて"],["、"],["天","てん"],["から"],["降りて","おりて"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["その"],["頭","あたま"],["に"],["、"],["にじ"],["を"],["いただき"],["、"],["その"],["顔","かお"],["は"],["太陽","たいよう"],["の"],["よう"],["で"],["、"],["その"],["足","あし"],["は"],["火","ひ"],["の"],["柱","はしら"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":2,"text":"彼,かれは、開,ひらかれた小,ちいさな巻物,まきものを手,てに持,もっていた。そして、右足,みぎあしを海,うみの上,うえに、左足,ひだりあしを地,ちの上,うえに踏,ふみおろして、","tok":[["彼","かれ"],["は"],["、"],["開らかれた","ひらかれた"],["小さな","ちいさな"],["巻物","まきもの"],["を"],["手","て"],["に"],["持って","もって"],["いた"],["。"],["そして"],["、"],["右足","みぎあし"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["、"],["左足","ひだりあし"],["を"],["地","ち"],["の"],["上","うえ"],["に"],["踏みおろして","ふみおろして"],["、"]]},{"verse":3,"text":"ししがほえるように大声,おおごえで叫,さけんだ。彼,かれが叫,さけぶと、七つの雷,かみなりがおのおのその声,こえを発,はっした。","tok":[["しし"],["が"],["ほえる"],["よう"],["に"],["大声","おおごえ"],["で"],["叫けんだ","さけんだ"],["。"],["彼","かれ"],["が"],["叫けぶ","さけぶ"],["と"],["、"],["七","なな"],["つ"],["の"],["雷","かみなり"],["が"],["おのおの"],["その"],["声","こえ"],["を"],["発した","はっした"],["。"]]},{"verse":4,"text":"七つの雷,かみなりが声,こえを発,はっした時,とき、わたしはそれを書,かきとめようとした。すると、天,てんから声,こえがあって、「七つの雷,かみなりの語,かたったことを封印,ふういんせよ。それを書,かきとめるな」と言,いうのを聞,きいた。","tok":[["七","なな"],["つ"],["の"],["雷","かみなり"],["が"],["声","こえ"],["を"],["発した","はっした"],["時","とき"],["、"],["わたし"],["は"],["それ"],["を"],["書きとめよう","かきとめよう"],["と"],["した"],["。"],["する"],["と"],["、"],["天","てん"],["から"],["声","こえ"],["が"],["あって"],["、"],["「"],["七","なな"],["つ"],["の"],["雷","かみなり"],["の"],["語った","かたった"],["こと"],["を"],["封印","ふういん"],["せよ"],["。"],["それ"],["を"],["書きとめる","かきとめる"],["な"],["」"],["と"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":5,"text":"それから、海,うみと地,ちの上,うえに立,たっているのをわたしが見,みたあの御使,みつかいは、天,てんにむけて右手,みぎてを上,あげ、","tok":[["それ"],["から"],["、"],["海","うみ"],["と"],["地","ち"],["の"],["上","うえ"],["に"],["立って","たって"],["いる"],["の"],["を"],["わたし"],["が"],["見た","みた"],["あの"],["御使","みつかい"],["は"],["、"],["天","てん"],["に"],["むけて"],["右手","みぎて"],["を"],["上げ","あげ"],["、"]]},{"verse":6,"text":"天,てんとその中,なかにあるもの、地,ちとその中,なかにあるもの、海,うみとその中,なかにあるものを造,つくり、世々,よよ限,かぎりなく生,いきておられるかたをさして誓,ちかった、「もう時,ときがない。","tok":[["天","てん"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["、"],["地","ち"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["、"],["海","うみ"],["と"],["その"],["中","なか"],["に"],["ある"],["もの"],["を"],["造","つくり"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["生きて","いきて"],["おられる"],["かた"],["を"],["さして"],["誓った","ちかった"],["、"],["「"],["もう"],["時","とき"],["が"],["ない"],["。"]]},{"verse":7,"text":"第,だい七の御使,みつかいが吹,ふき鳴,ならすラッパの音,おとがする時,ときには、神,かみがその僕,しもべ、預言者,よげんしゃたちにお告,つげになったとおり、神,かみの奥義,おくぎは成就,じょうじゅされる」。","tok":[["第","だい"],["七","なな"],["の"],["御使","み"],["つかい"],["が"],["吹","ふき"],["鳴らす","ならす"],["ラッパ"],["の"],["音","おと"],["が"],["する"],["時","とき"],["に"],["は"],["、"],["神","かみ"],["が"],["その"],["僕","し"],["も"],["べ"],["、"],["預言者","よげんしゃ"],["たち"],["に"],["お告","おつげ"],["に"],["なった"],["とおり"],["、"],["神","かみ"],["の"],["奥義","おくぎ"],["は"],["成就","じょうじゅ"],["される"],["」"],["。"]]},{"verse":8,"text":"すると、前,まえに天,てんから聞,きこえてきた声,こえが、またわたしに語,かたって言,いった、「さあ行,いって、海,うみと地,ちとの上,うえに立,たっている御使,みつかいの手,てに開,ひらかれている巻物,まきものを、受,うけ取,とりなさい」。","tok":[["する"],["と"],["、"],["前","まえ"],["に"],["天","てん"],["から"],["聞こえて","きこえて"],["きた"],["声","こえ"],["が"],["、"],["また"],["わたし"],["に"],["語って","かたって"],["言った","いった"],["、"],["「"],["さあ"],["行って","いって"],["、"],["海","うみ"],["と"],["地","ち"],["と"],["の"],["上","うえ"],["に"],["立って","たって"],["いる"],["御使","みつかい"],["の"],["手","て"],["に"],["開らかれて","ひらかれて"],["いる"],["巻物","まきもの"],["を"],["、"],["受け","うけ"],["取","とり"],["なさい"],["」"],["。"]]},{"verse":9,"text":"そこで、わたしはその御使,みつかいのもとに行,いって、「その小,ちいさな巻物,まきものを下,ください」と言,いった。すると、彼,かれは言,いった、「取,とって、それを食,たべてしまいなさい。あなたの腹,はらには苦,にがいが、口,くちには蜜,みつのように甘,あまい」。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["その"],["御使","みつかい"],["の"],["もと"],["に"],["行って","いって"],["、"],["「"],["その"],["小さな","ちいさな"],["巻物","まきもの"],["を"],["下さい","ください"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["取って","とって"],["、"],["それ"],["を"],["食べて","たべて"],["しまい"],["なさい"],["。"],["あなた"],["の"],["腹","はら"],["に"],["は"],["苦い","にがい"],["が"],["、"],["口","くち"],["に"],["は"],["蜜","みつ"],["の"],["よう"],["に"],["甘い","あまい"],["」"],["。"]]},{"verse":10,"text":"わたしは御使,みつかいの手,てからその小,ちいさな巻物,まきものを受,うけ取,とって食,たべてしまった。すると、わたしの口,くちには蜜,みつのように甘,あまかったが、それを食,たべたら、腹,はらが苦,にがくなった。","tok":[["わたし"],["は"],["御使","みつかい"],["の"],["手","て"],["から"],["その"],["小さな","ちいさな"],["巻物","まきもの"],["を"],["受け取って","うけとって"],["食べて","たべて"],["しまった"],["。"],["する"],["と"],["、"],["わたし"],["の"],["口","くち"],["に"],["は"],["蜜","みつ"],["の"],["よう"],["に"],["甘かった","あまかった"],["が"],["、"],["それ"],["を"],["食べたら","たべたら"],["、"],["腹","はら"],["が"],["苦く","にがく"],["なった"],["。"]]},{"verse":11,"text":"その時,とき、「あなたは、もう一度,いちど、多,おおくの民族,みんぞく、国民,こくみん、国語,こくご、王,おうたちについて、預言,よげんせねばならない」と言,いう声,こえがした。","tok":[["その"],["時","とき"],["、"],["「"],["あなた"],["は"],["、"],["もう"],["一度","いちど"],["、"],["多く","おおく"],["の"],["民族","みんぞく"],["、"],["国民","こくみん"],["、"],["国語","こくご"],["、"],["王","おう"],["たち"],["について"],["、"],["預言","よげん"],["せねば"],["ならない"],["」"],["と"],["言う","いう"],["声","こえ"],["が"],["した"],["。"]]}]
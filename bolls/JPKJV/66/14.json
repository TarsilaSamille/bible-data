[{"verse":1,"text":"なお、わたしが見,みていると、見,みよ、小羊,こひつじがシオンの山,やまに立,たっていた。また、十四万四千の人々,ひとびとが小羊,こひつじと共,ともにおり、その額,ひたいに小羊,こひつじの名,なとその父,ちちの名,なとが書,かかれていた。","tok":[["なお"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["小羊","こひつじ"],["が"],["シオン"],["の"],["山","やま"],["に"],["立って","たって"],["いた"],["。"],["また"],["、"],["十四万四千","じゅうよんまんよんせん"],["の"],["人々","ひとびと"],["が"],["小羊","こひつじ"],["と"],["共","とも"],["に"],["おり"],["、"],["その"],["額","ひたい"],["に"],["小羊","こひつじ"],["の"],["名","な"],["と"],["その"],["父","ちち"],["の"],["名","な"],["と"],["が"],["書かれて","かかれて"],["いた"],["。"]]},{"verse":2,"text":"またわたしは、大水,おおみずのとどろきのような、激,はげしい雷鳴,らいめいのような声,こえが、天,てんから出,でるのを聞,きいた。わたしの聞,きいたその声,こえは、琴,ことをひく人,ひとが立琴,たてごとをひく音,おとのようでもあった。","tok":[["また"],["わたし"],["は"],["、"],["大水","おおみず"],["の"],["とどろき"],["の"],["よう"],["な"],["、"],["激しい","はげしい"],["雷鳴","らいめい"],["の"],["よう"],["な"],["声","こえ"],["が"],["、"],["天","てん"],["から"],["出る","でる"],["の"],["を"],["聞いた","きいた"],["。"],["わたし"],["の"],["聞いた","きいた"],["その"],["声","こえ"],["は"],["、"],["琴","こと"],["を"],["ひく"],["人","ひと"],["が"],["立琴","たてごと"],["を"],["ひく"],["音","おと"],["の"],["よう"],["で"],["も"],["あった"],["。"]]},{"verse":3,"text":"彼,かれらは、御座,みざの前,まえ、四つの生,いき物,ものと長老,ちょうろうたちとの前,まえで、新,あたらしい歌,うたを歌,うたった。この歌,うたは、地,ちからあがなわれた十四万四千人,にんのほかは、だれも学,まなぶことができなかった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["御座","みざ"],["の"],["前","まえ"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["長老","ちょうろう"],["たち"],["と"],["の"],["前","まえ"],["で"],["、"],["新らしい","あたらしい"],["歌","うた"],["を"],["歌った","うたった"],["。"],["この"],["歌","うた"],["は"],["、"],["地","ち"],["から"],["あがなわれた"],["十四万四千","じゅうよんまんよんせん"],["人","にん"],["の"],["ほか"],["は"],["、"],["だれ"],["も"],["学ぶ","まなぶ"],["こと"],["が"],["できなかった"],["。"]]},{"verse":4,"text":"彼,かれらは、女,おんなにふれたことのない者,ものである。彼,かれらは、純潔,じゅんけつな者,ものである。そして、小羊,こひつじの行,いく所,ところへは、どこへでもついて行,いく。彼,かれらは、神,かみと小羊,こひつじとにささげられる初穂,はつほとして、人間,にんげんの中,なかからあがなわれた者,ものである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["女","おんな"],["に"],["ふれた"],["こと"],["の"],["ない"],["者","もの"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["、"],["純潔","じゅんけつ"],["な"],["者","もの"],["で"],["ある"],["。"],["そして"],["、"],["小羊","こひつじ"],["の"],["行く","いく"],["所","ところ"],["へ"],["は"],["、"],["どこ"],["へ"],["で"],["も"],["ついて"],["行く","いく"],["。"],["彼","かれ"],["ら"],["は"],["、"],["神","かみ"],["と"],["小羊","こひつじ"],["と"],["に"],["ささげられる"],["初穂","はつほ"],["として"],["、"],["人間","にんげん"],["の"],["中","なか"],["から"],["あがなわれた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":5,"text":"彼,かれらの口,くちには偽,いつわりがなく、彼,かれらは傷,きずのない者,ものであった。","tok":[["彼","かれ"],["ら"],["の"],["口","くち"],["に"],["は"],["偽り","いつわり"],["が"],["なく"],["、"],["彼","かれ"],["ら"],["は"],["傷","きず"],["の"],["ない"],["者","もの"],["で"],["あった"],["。"]]},{"verse":6,"text":"わたしは、もうひとりの御使,みつかいが中空,なかぞらを飛,とぶのを見,みた。彼,かれは地,ちに住,すむ者,もの、すなわち、あらゆる国民,こくみん、部族,ぶぞく、国語,こくご、民族,みんぞくに宣,のべ伝,つたえるために、永遠,えいえんの福音,ふくいんをたずさえてきて、","tok":[["わたし"],["は"],["、"],["もう"],["ひとり"],["の"],["御使","み"],["つかい"],["が"],["中空","なかぞら"],["を"],["飛ぶ","とぶ"],["の"],["を"],["見た","みた"],["。"],["彼","かれ"],["は"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["、"],["すなわち"],["、"],["あらゆる"],["国民","こくみん"],["、"],["部族","ぶぞく"],["、"],["国語","こくご"],["、"],["民族","みんぞく"],["に"],["宣べ伝える","のべつたえる"],["ため"],["に"],["、"],["永遠","えいえん"],["の"],["福音","ふくいん"],["を"],["たずさえて"],["きて"],["、"]]},{"verse":7,"text":"大声,おおごえで言,いった、「神,かみをおそれ、神,かみに栄光,えいこうを帰,きせよ。神,かみのさばきの時,ときがきたからである。天,てんと地,ちと海,うみと水,みずの源,みなもととを造,つくられたかたを、伏,ふし拝,おがめ」。","tok":[["大声","おおごえ"],["で"],["言った","いった"],["、"],["「"],["神","かみ"],["を"],["おそれ"],["、"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰せ","きせ"],["よ"],["。"],["神","かみ"],["の"],["さばき"],["の"],["時","とき"],["が"],["きた"],["から"],["で"],["ある"],["。"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["と"],["水","みず"],["の"],["源","みなもと"],["と"],["を"],["造られた","つくられた"],["かた"],["を"],["、"],["伏し拝め","ふしおがめ"],["」"],["。"]]},{"verse":8,"text":"また、ほかの第,だい二の御使,みつかいが、続,つづいてきて言,いった、「倒,たおれた、大,おおいなるバビロンは倒,たおれた。その不品行,ふひんこうに対,たいする激,はげしい怒,いかりのぶどう酒,しゅを、あらゆる国民,こくみんに飲,のませた者,もの」。","tok":[["また"],["、"],["ほか"],["の"],["第","だい"],["二","に"],["の"],["御使","み"],["つかい"],["が"],["、"],["続いて","つづいて"],["きて"],["言った","いった"],["、"],["「"],["倒れた","たおれた"],["、"],["大いなる","おおいなる"],["バビロン"],["は"],["倒れた","たおれた"],["。"],["その"],["不品行","ふひんこう"],["に"],["対する","たいする"],["激しい","はげしい"],["怒り","いかり"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["、"],["あらゆる"],["国民","こくみん"],["に"],["飲ませた","のませた"],["者","もの"],["」"],["。"]]},{"verse":9,"text":"ほかの第,だい三の御使,みつかいが彼,かれらに続,つづいてきて、大声,おおごえで言,いった、「おおよそ、獣,けものとその像,ぞうとを拝,おがみ、額,ひたいや手,てに刻印,こくいんを受,うける者,ものは、","tok":[["ほか"],["の"],["第","だい"],["三","さん"],["の"],["御使","み"],["つかい"],["が"],["彼","かれ"],["ら"],["に"],["続いて","つづいて"],["きて"],["、"],["大声","おおごえ"],["で"],["言った","いった"],["、"],["「"],["おおよそ"],["、"],["獣","けもの"],["と"],["その"],["像","ぞう"],["と"],["を"],["拝み","おがみ"],["、"],["額","ひ"],["たいや手","たいやて"],["に"],["刻印","こくいん"],["を"],["受る","うける"],["者","もの"],["は"],["、"]]},{"verse":10,"text":"神,かみの怒,いかりの杯,さかずきに混,まぜものなしに盛,もられた、神,かみの激,はげしい怒,いかりのぶどう酒,しゅを飲,のみ、聖,せいなる御使,みつかいたちと小羊,こひつじとの前,まえで、火,ひと硫黄,いおうとで苦,くるしめられる。","tok":[["神","かみ"],["の"],["怒り","いかり"],["の"],["杯","さかずき"],["に"],["混ぜもの","まぜもの"],["なし"],["に"],["盛られた","もられた"],["、"],["神","かみ"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["飲み","のみ"],["、"],["聖","せい"],["なる"],["御使","みつかい"],["たち"],["と"],["小羊","こひつじ"],["と"],["の"],["前","まえ"],["で"],["、"],["火","ひ"],["と"],["硫黄","いおう"],["と"],["で"],["苦しめられる","くるしめられる"],["。"]]},{"verse":11,"text":"その苦,くるしみの煙,けむりは世々,よよ限,かぎりなく立,たちのぼり、そして、獣,けものとその像,ぞうとを拝,おがむ者,もの、また、だれでもその名,なの刻印,こくいんを受,うけている者,ものは、昼,ひるも夜,よるも休,やすみが得,えられない。","tok":[["その"],["苦しみ","くるしみ"],["の"],["煙","けむり"],["は"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["立ちのぼり","たちのぼり"],["、"],["そして"],["、"],["獣","けもの"],["と"],["その"],["像","ぞう"],["と"],["を"],["拝む","おがむ"],["者","もの"],["、"],["また"],["、"],["だれ"],["で"],["も"],["その"],["名","な"],["の"],["刻印","こくいん"],["を"],["受て","うけて"],["いる"],["者","もの"],["は"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["休み","やすみ"],["が"],["得られない","えられない"],["。"]]},{"verse":12,"text":"ここに、神,かみの戒,いましめを守,まもり、イエスを信,しんじる信仰,しんこうを持,もちつづける聖徒,せいとの忍耐,にんたいがある」。","tok":[["ここ"],["に"],["、"],["神","かみ"],["の"],["戒しめ","いましめ"],["を"],["守り","まもり"],["、"],["イエス"],["を"],["信じる","しんじる"],["信仰","しんこう"],["を"],["持ち","もち"],["つづける"],["聖徒","せいと"],["の"],["忍耐","にんたい"],["が"],["ある"],["」"],["。"]]},{"verse":13,"text":"またわたしは、天,てんからの声,こえがこう言,いうのを聞,きいた、「書,かきしるせ、『今,いまから後,のち、主,しゅにあって死,しぬ死人,しにんはさいわいである』」。御霊,みたまも言,いう、「しかり、彼,かれらはその労苦,ろうくを解,とかれて休,やすみ、そのわざは彼,かれらについていく」。","tok":[["また"],["わたし"],["は"],["、"],["天","てん"],["から"],["の"],["声","こえ"],["が"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["、"],["「"],["書きしるせ","かきしるせ"],["、"],["『"],["今","いま"],["から"],["後","の"],["ち"],["、"],["主に","しゅに"],["あって"],["死ぬ","しぬ"],["死人","しにん"],["は"],["さいわい"],["で"],["ある"],["』"],["」"],["。"],["御霊","みたま"],["も"],["言う","いう"],["、"],["「"],["しかり"],["、"],["彼","かれ"],["ら"],["は"],["その"],["労苦","ろうく"],["を"],["解かれて","とかれて"],["休み","やすみ"],["、"],["その"],["わざ"],["は"],["彼","かれ"],["ら"],["について"],["いく"],["」"],["。"]]},{"verse":14,"text":"また見,みていると、見,みよ、白,しろい雲,くもがあって、その雲,くもの上,うえに人,ひとの子,このような者,ものが座,ざしており、頭,あたまには金,きんの冠,かんむりをいただき、手,てには鋭,するどいかまを持,もっていた。","tok":[["また"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["白い","しろい"],["雲","くも"],["が"],["あって"],["、"],["その"],["雲","くも"],["の"],["上","うえ"],["に"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["な"],["者","もの"],["が"],["座して","ざして"],["おり"],["、"],["頭","あたま"],["に"],["は"],["金","きん"],["の"],["冠","かんむり"],["を"],["いただき"],["、"],["手","て"],["に"],["は"],["鋭い","するどい"],["かま"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":15,"text":"すると、もうひとりの御使,みつかいが聖所,せいじょから出,でてきて、雲,くもの上,うえに座,ざしている者,ものにむかって大声,おおごえで叫,さけんだ、「かまを入,いれて刈,かり取,とりなさい。地,ちの穀物,こくもつは全,まったく実,みのり、刈,かり取,とるべき時,ときがきた」。","tok":[["する"],["と"],["、"],["もう"],["ひとり"],["の"],["御使","み"],["つかい"],["が"],["聖","せい"],["所","しょ"],["ら"],["出て","でて"],["きて"],["、"],["雲","くも"],["の"],["上","うえ"],["に"],["座して","ざして"],["いる"],["者","もの"],["に"],["むかって"],["大声","おおごえ"],["で"],["叫けんだ","さけんだ"],["、"],["「"],["かま"],["を"],["入れて","いれて"],["刈取","かりとり"],["なさい"],["。"],["地","ち"],["の"],["穀物","こくもつ"],["は"],["全く","まったく"],["実り","みのり"],["、"],["刈取るべき","かりとるべき"],["時","とき"],["が"],["きた"],["」"],["。"]]},{"verse":16,"text":"雲,くもの上,うえに座,ざしている者,ものは、そのかまを地,ちに投,なげ入,いれた。すると、地,ちのものが刈,かり取,とられた。","tok":[["雲","くも"],["の"],["上","うえ"],["に"],["座して","ざして"],["いる"],["者","もの"],["は"],["、"],["その"],["かま"],["を"],["地","ち"],["に"],["投入れた","なげいれた"],["。"],["する"],["と"],["、"],["地","ち"],["の"],["もの"],["が"],["刈取られた","かりとられた"],["。"]]},{"verse":17,"text":"また、もうひとりの御使,みつかいが、天,てんの聖所,せいじょから出,でてきたが、彼,かれもまた鋭,するどいかまを持,もっていた。","tok":[["また"],["、"],["もう"],["ひとり"],["の"],["御使","み"],["つかい"],["が"],["、"],["天","てん"],["の"],["聖","せい"],["所","しょ"],["ら"],["出て","でて"],["きた"],["が"],["、"],["彼","かれ"],["も"],["また"],["鋭い","するどい"],["かま"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":18,"text":"さらに、もうひとりの御使,みつかいで、火,ひを支配,しはいする権威,けんいを持,もっている者,ものが、祭壇,さいだんから出,でてきて、鋭,するどいかまを持,もつ御使,みつかいにむかい、大声,おおごえで言,いった、「その鋭,するどいかまを地,ちに入,いれて、地,ちのぶどうのふさを刈,かり集,あつめなさい。ぶどうの実,みがすでに熟,じゅくしているから」。","tok":[["さらに"],["、"],["もう"],["ひとり"],["の"],["御使","み"],["つかい"],["で"],["、"],["火","ひ"],["を"],["支配","しはい"],["する"],["権威","けんい"],["を"],["持って","もって"],["いる"],["者","もの"],["が"],["、"],["祭壇","さいだん"],["から"],["出て","でて"],["きて"],["、"],["鋭い","するどい"],["かま"],["を"],["持つ","もつ"],["御使","みつかい"],["に"],["むかい"],["、"],["大声","おおごえ"],["で"],["言った","いった"],["、"],["「"],["その"],["鋭い","するどい"],["かま"],["を"],["地","ち"],["に"],["入れて","いれて"],["、"],["地","ち"],["の"],["ぶどう"],["の"],["ふさ"],["を"],["刈","かり"],["集め","あつめ"],["なさい"],["。"],["ぶどう"],["の"],["実","み"],["が"],["すでに"],["熟して","じゅくして"],["いる"],["から"],["」"],["。"]]},{"verse":19,"text":"そこで、御使,みつかいはそのかまを地,ちに投,なげ入,いれて、地,ちのぶどうを刈,かり集,あつめ、神,かみの激,はげしい怒,いかりの大,おおきな酒,さかぶねに投,なげ込,こんだ。","tok":[["そこ"],["で"],["、"],["御使","みつかい"],["は"],["その"],["かま"],["を"],["地","ち"],["に"],["投入れて","なげいれて"],["、"],["地","ち"],["の"],["ぶどう"],["を"],["刈","かり"],["集め","あつめ"],["、"],["神","かみ"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["大きな","おおきな"],["酒","さかぶね"],["に"],["投込んだ","なげこんだ"],["。"]]},{"verse":20,"text":"そして、その酒,さかぶねが都,みやこの外,そとで踏,ふまれた。すると、血,ちが酒,さかぶねから流,ながれ出,でて、馬,うまのくつわにとどくほどになり、一千六百丁,ちょうにわたってひろがった。","tok":[["そして"],["、"],["その"],["酒","さ"],["か"],["ぶね"],["が"],["都","みやこ"],["の"],["外","そと"],["で"],["踏まれた","ふまれた"],["。"],["する"],["と"],["、"],["血","ち"],["が"],["酒","さかぶねか"],["ら"],["流れ出て","ながれでて"],["、"],["馬","うま"],["の"],["くつわ"],["に"],["とどく"],["ほど"],["に"],["なり"],["、"],["一千六百","いちせんろくひゃく"],["丁","ちょう"],["に"],["わたって"],["ひろがった"],["。"]]}]
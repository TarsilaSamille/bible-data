[{"verse":1,"text":"それから、わたしはつえのような測,はかりざおを与,あたえられて、こう命,めいじられた、「さあ立,たって、神,かみの聖所,せいじょと祭壇,さいだんと、そこで礼拝,れいはいしている人々,ひとびととを、測,はかりなさい。","tok":[["それ"],["から"],["、"],["わたし"],["は"],["つえ"],["の"],["よう"],["な"],["測り","はかり"],["ざお"],["を"],["与えられて","あたえられて"],["、"],["こう"],["命じられた","めいじられた"],["、"],["「"],["さあ"],["立って","たって"],["、"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["と"],["祭壇","さいだん"],["と"],["、"],["そこ"],["で"],["礼拝","れいはい"],["して"],["いる"],["人々","ひとびと"],["と"],["を"],["、"],["測り","はかり"],["なさい"],["。"]]},{"verse":2,"text":"聖所,せいじょの外,そとの庭,にわはそのままにしておきなさい。それを測,はかってはならない。そこは異邦人,いほうじんに与,あたえられた所,ところだから。彼,かれらは、四十二か月,げつの間,あいだこの聖,せいなる都,みやこを踏,ふみにじるであろう。","tok":[["聖","せい"],["所","しょ"],["の"],["外","そと"],["の"],["庭","にわ"],["は"],["そのまま"],["に"],["して"],["おき"],["なさい"],["。"],["それ"],["を"],["測って","はかって"],["は"],["ならない"],["。"],["そこ"],["は"],["異邦人","いほうじん"],["に"],["与えられた","あたえられた"],["所","ところ"],["だ"],["から"],["。"],["彼","かれ"],["ら"],["は"],["、"],["四十二","よんじゅうに"],["か月","かげつ"],["の"],["間","あいだ"],["この"],["聖","せい"],["なる"],["都","みやこ"],["を"],["踏みにじるで","ふみにじるで"],["あろう"],["。"]]},{"verse":3,"text":"そしてわたしは、わたしのふたりの証人,しょうにんに、荒布,あらぬのを着,きて、千二百六十日,にちのあいだ預言,よげんすることを許,ゆるそう」。","tok":[["そして"],["わたし"],["は"],["、"],["わたし"],["の"],["ふたり"],["の"],["証人","しょうにん"],["に"],["、"],["荒布","あらぬ"],["の"],["を"],["着て","きて"],["、"],["千二百六十","せんにひゃくろくとう"],["日","か"],["の"],["あいだ"],["預言","よげん"],["する"],["こと"],["を"],["許そう","ゆるそう"],["」"],["。"]]},{"verse":4,"text":"彼,かれらは、全,ぜん地,ちの主,しゅのみまえに立,たっている二本,ほんのオリブの木,き、また、二つの燭台,しょくだいである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["全地","ぜんち"],["の"],["主","しゅ"],["のみ"],["まえ"],["に"],["立って","たって"],["いる"],["二本","ほん"],["の"],["オリブ"],["の"],["木","き"],["、"],["また"],["、"],["二","ふた"],["つ"],["の"],["燭台","しょくだい"],["で"],["ある"],["。"]]},{"verse":5,"text":"もし彼,かれらに害,がいを加,くわえようとする者,ものがあれば、彼,かれらの口,くちから火,ひが出,でて、その敵,てきを滅,ほろぼすであろう。もし彼,かれらに害,がいを加,くわえようとする者,ものがあれば、その者,ものはこのように殺,ころされねばならない。","tok":[["もし"],["彼","かれ"],["ら"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["する"],["者","もの"],["が"],["あれば"],["、"],["彼","かれ"],["ら"],["の"],["口","くち"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["その"],["敵","てき"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["。"],["もし"],["彼","かれ"],["ら"],["に"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["する"],["者","もの"],["が"],["あれば"],["、"],["その"],["者","もの"],["は"],["この"],["よう"],["に"],["殺ろされねば","ころされねば"],["ならない"],["。"]]},{"verse":6,"text":"預言,よげんをしている期間,きかん、彼,かれらは、天,てんを閉,とじて雨,あめを降,ふらせないようにする力,ちからを持,もっている。さらにまた、水,みずを血,ちに変,かえ、何,なに度,どでも思,おもうままに、あらゆる災害,さいがいで地,ちを打,うつ力,ちからを持,もっている。","tok":[["預言","よげん"],["を"],["して"],["いる"],["期間","きかん"],["、"],["彼","かれ"],["ら"],["は"],["、"],["天","てん"],["を"],["閉じて","とじて"],["雨","あめ"],["を"],["降らせない","ふらせない"],["よう"],["に"],["する"],["力","ちから"],["を"],["持って","もって"],["いる"],["。"],["さらに"],["また"],["、"],["水","みず"],["を"],["血","ち"],["に"],["変え","かえ"],["、"],["何","な"],["に"],["度","ど"],["で"],["も"],["思う","おもう"],["まま"],["に"],["、"],["あらゆる"],["災害","さいがい"],["で"],["地","ち"],["を"],["打つ","うつ"],["力","ちから"],["を"],["持って","もって"],["いる"],["。"]]},{"verse":7,"text":"そして、彼,かれらがそのあかしを終,おえると、底,そこ知,しれぬ所,ところからのぼって来,くる獣,けものが、彼,かれらと戦,たたかって打,うち勝,かち、彼,かれらを殺,ころす。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["が"],["その"],["あかし"],["を"],["終える","おえる"],["と"],["、"],["底","そこ"],["知れぬ","しれぬ"],["所","ところ"],["から"],["のぼって"],["来る","くる"],["獣","けもの"],["が"],["、"],["彼","かれ"],["ら"],["と"],["戦って","たたかって"],["打ち","うち"],["勝","かち"],["、"],["彼","かれ"],["ら"],["を"],["殺ろす","ころす"],["。"]]},{"verse":8,"text":"彼,かれらの死体,したいはソドムや、エジプトにたとえられている大,おおいなる都,みやこの大通,おおどおりにさらされる。彼,かれらの主,しゅも、この都,みやこで十字架,じゅうじかにつけられたのである。","tok":[["彼","かれ"],["ら"],["の"],["死体","したい"],["は"],["ソドム"],["や"],["、"],["エジプト"],["に"],["たとえられて"],["いる"],["大いなる","おおいなる"],["都","みやこ"],["の"],["大通り","おおどおり"],["に"],["さらされる"],["。"],["彼","かれ"],["ら"],["の"],["主","しゅ"],["も"],["、"],["この"],["都","みやこ"],["で"],["十字架","じゅうじか"],["に"],["つけられた"],["ので"],["ある"],["。"]]},{"verse":9,"text":"いろいろな民族,みんぞく、部族,ぶぞく、国語,こくご、国民,こくみんに属,ぞくする人々,ひとびとが、三日,か半,はんの間,あいだ、彼,かれらの死体,したいをながめるが、その死体,したいを墓,はかに納,おさめることは許,ゆるさない。","tok":[["いろいろ"],["な"],["民族","みんぞく"],["、"],["部族","ぶぞく"],["、"],["国語","こくご"],["、"],["国民","こくみん"],["に"],["属する","ぞくする"],["人々","ひとびと"],["が"],["、"],["三日","か"],["半","はん"],["の"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["の"],["死体","したい"],["を"],["ながめる"],["が"],["、"],["その"],["死体","したい"],["を"],["墓","はか"],["に"],["納める","おさめる"],["こと"],["は"],["許さない","ゆるさない"],["。"]]},{"verse":10,"text":"地,ちに住,すむ人々,ひとびとは、彼,かれらのことで喜,よろこび楽,たのしみ、互,たがいに贈,おくり物,ものをしあう。このふたりの預言者,よげんしゃは、地,ちに住,すむ者,ものたちを悩,なやましたからである。","tok":[["地","ち"],["に"],["住む","すむ"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["ら"],["の"],["こと"],["で"],["喜こび","よろこび"],["楽み","たのしみ"],["、"],["互","たがい"],["に"],["贈り物","おくりもの"],["を"],["しあう"],["。"],["この"],["ふたり"],["の"],["預言者","よげんしゃ"],["は"],["、"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["たち"],["を"],["悩した","なやました"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"三日,か半,はんの後,のち、いのちの息,いきが、神,かみから出,でて彼,かれらの中,なかにはいり、そして、彼,かれらが立,たち上,あがったので、それを見,みた人々,ひとびとは非常,ひじょうな恐怖,きょうふに襲,おそわれた。","tok":[["三日","か"],["半","はん"],["の"],["後","の"],["ち"],["、"],["いのち"],["の"],["息","いき"],["が"],["、"],["神","かみ"],["から"],["出て","でて"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["はいり"],["、"],["そして"],["、"],["彼","かれ"],["ら"],["が"],["立ち上がった","たちあがった"],["ので"],["、"],["それ"],["を"],["見た","みた"],["人々","ひとびと"],["は"],["非常","ひじょう"],["な"],["恐怖","きょうふ"],["に"],["襲れた","おそわれた"],["。"]]},{"verse":12,"text":"その時,とき、天,てんから大,おおきな声,こえがして、「ここに上,のぼってきなさい」と言,いうのを、彼,かれらは聞,きいた。そして、彼,かれらは雲,くもに乗,のって天,てんに上,のぼった。彼,かれらの敵,てきはそれを見,みた。","tok":[["その"],["時","とき"],["、"],["天","てん"],["から"],["大きな","おおきな"],["声","こえ"],["が"],["して"],["、"],["「"],["ここ"],["に"],["上って","のぼって"],["き"],["なさい"],["」"],["と"],["言う","いう"],["の"],["を"],["、"],["彼","かれ"],["ら"],["は"],["聞いた","きいた"],["。"],["そして"],["、"],["彼","かれ"],["ら"],["は"],["雲","くも"],["に"],["乗って","のって"],["天","てん"],["に"],["上った","のぼった"],["。"],["彼","かれ"],["ら"],["の"],["敵","てき"],["は"],["それ"],["を"],["見た","みた"],["。"]]},{"verse":13,"text":"この時,とき、大,だい地震,じしんが起,おこって、都,みやこの十分,じゅうぶんの一は倒,たおれ、その地震,じしんで七千人,にんが死,しに、生,いき残,のこった人々,ひとびとは驚,おどろき恐,おそれて、天,てんの神,かみに栄光,えいこうを帰,きした。","tok":[["この"],["時","とき"],["、"],["大地震","だいじしん"],["が"],["起こって","おこって"],["、"],["都","みやこ"],["の"],["十分","じゅうぶん"],["の"],["一","いち"],["は"],["倒れ","たおれ"],["、"],["その"],["地震","じしん"],["で"],["七千人","にん"],["が"],["死に","しに"],["、"],["生き残った","いきのこった"],["人々","ひとびと"],["は"],["驚","おどろき"],["恐れて","おそれて"],["、"],["天","てん"],["の"],["神","かみ"],["に"],["栄光","えいこう"],["を"],["帰した","きした"],["。"]]},{"verse":14,"text":"第,だい二のわざわいは、過,すぎ去,さった。見,みよ、第,だい三のわざわいがすぐに来,くる。","tok":[["第","だい"],["二","に"],["の"],["わざわい"],["は"],["、"],["過去","すぎさっ"],["た"],["。"],["見よ","みよ"],["、"],["第","だい"],["三","さん"],["の"],["わざわい"],["が"],["すぐ"],["に"],["来る","くる"],["。"]]},{"verse":15,"text":"第,だい七の御使,みつかいが、ラッパを吹,ふき鳴,ならした。すると、大,おおきな声々,こえごえが天,てんに起,おこって言,いった、「この世,よの国,くには、われらの主,しゅとそのキリストとの国,くにとなった。主,しゅは世々,よよ限,かぎりなく支配,しはいなさるであろう」。","tok":[["第","だい"],["七","なな"],["の"],["御使","み"],["つかい"],["が"],["、"],["ラッパ"],["を"],["吹鳴","ふきな"],["らした"],["。"],["する"],["と"],["、"],["大きな","おおきな"],["声々","こえごえ"],["が"],["天","てん"],["に"],["起こって","おこって"],["言った","いった"],["、"],["「"],["この世","このよ"],["の"],["国","くに"],["は"],["、"],["われ"],["ら"],["の"],["主","しゅとそ"],["の"],["キリスト"],["と"],["の"],["国","くに"],["と"],["なった"],["。"],["主","しゅ"],["は"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["支配","しはい"],["なさるで"],["あろう"],["」"],["。"]]},{"verse":16,"text":"そして、神,かみのみまえで座,ざについている二十四人,にんの長老,ちょうろうは、ひれ伏,ふし、神,かみを拝,はいして言,いった、","tok":[["そして"],["、"],["神","かみ"],["のみ"],["まえ"],["で"],["座","ざ"],["について"],["いる"],["二十四人","にん"],["の"],["長老","ちょうろう"],["は"],["、"],["ひれ伏し","ひれふし"],["、"],["神","かみ"],["を"],["拝して","はいして"],["言った","いった"],["、"]]},{"verse":17,"text":"「今,いまいまし、昔,むかしいませる、全能者,ぜんのうしゃにして主,しゅなる神,かみよ。大,おおいなる御,み力,ちからをふるって支配,しはいなさったことを、感謝,かんしゃします。","tok":[["「"],["今","いま"],["いまし"],["、"],["昔","むかし"],["いませる"],["、"],["全能者","ぜんのうしゃ"],["に"],["して"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["。"],["大いなる","おおいなる"],["御力","みちから"],["を"],["ふるって"],["支配","しはい"],["なさった"],["こと"],["を"],["、"],["感謝","かんしゃ"],["します"],["。"]]},{"verse":18,"text":"諸,しょ国民,こくみんは怒,いかり狂,くるいましたが、あなたも怒,いかりをあらわされました。そして、死人,しにんをさばき、あなたの僕,しもべなる預言者,よげんしゃ、聖徒,せいと、小,ちいさき者,ものも、大,おおいなる者,ものも、すべて御名,みなをおそれる者,ものたちに報,むくいを与,あたえ、また、地,ちを滅,ほろぼす者,ものどもを滅,ほろぼして下,くださる時,ときがきました」。","tok":[["諸","しょ"],["国民","こくみん"],["は"],["怒り狂いました","いかりくるいました"],["が"],["、"],["あなた"],["も"],["怒り","いかり"],["を"],["あらわされました"],["。"],["そして"],["、"],["死人","しにん"],["を"],["さばき"],["、"],["あなた"],["の"],["僕","し"],["も"],["べ"],["なる"],["預言者","よげんしゃ"],["、"],["聖徒","せいと"],["、"],["小い","ちい"],["さき"],["者","もの"],["も"],["、"],["大いなる","おおいなる"],["者","もの"],["も"],["、"],["すべて"],["御名","みな"],["を"],["おそれる"],["者","もの"],["たち"],["に"],["報い","むくい"],["を"],["与","あたえ"],["、"],["また"],["、"],["地","ち"],["を"],["滅ぼす","ほろぼす"],["者","もの"],["ども"],["を"],["滅ぼして","ほろぼして"],["下さる","くださる"],["時","とき"],["が"],["きました"],["」"],["。"]]},{"verse":19,"text":"そして、天,てんにある神,かみの聖所,せいじょが開,ひらけて、聖所,せいじょの中,なかに契約,けいやくの箱,はこが見,みえた。また、いなずまと、もろもろの声,こえと、雷鳴,らいめいと、地震,じしんとが起,おこり、大粒,おおつぶの雹,ひょうが降,ふった。","tok":[["そして"],["、"],["天","てん"],["に"],["ある"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["い"],["じょ"],["が"],["開て","ひらけて"],["、"],["聖","せい"],["所","しょ"],["の"],["中","なか"],["に"],["契約","けいやく"],["の"],["箱","は"],["こ"],["が"],["見えた","みえた"],["。"],["また"],["、"],["いなずま"],["と"],["、"],["もろもろ"],["の"],["声","こえ"],["と"],["、"],["雷鳴","らいめい"],["と"],["、"],["地震","じしん"],["と"],["が"],["起こり","おこり"],["、"],["大粒","おおつぶ"],["の"],["雹","ひょう"],["が"],["降った","ふった"],["。"]]}]
[{"verse":1,"text":"イエス・キリストの黙示,もくし。この黙示,もくしは、神,かみが、すぐにも起,おこるべきことをその僕,しもべたちに示,しめすためキリストに与,あたえ、そして、キリストが、御使,みつかいをつかわして、僕,しもべヨハネに伝,つたえられたものである。","tok":[["イエス"],["・"],["キリスト"],["の"],["黙示","もくし"],["。"],["この"],["黙示","もくし"],["は"],["、"],["神","かみ"],["が"],["、"],["すぐ"],["に"],["も"],["起こるべき","おこるべき"],["こと"],["を"],["その"],["僕","し"],["も"],["べ"],["たち"],["に"],["示めす","しめす"],["ため"],["キリスト"],["に"],["与","あたえ"],["、"],["そして"],["、"],["キリスト"],["が"],["、"],["御使","みつかい"],["を"],["つかわして"],["、"],["僕","し"],["も"],["べ"],["ヨハネ"],["に"],["伝えられた","つたえられた"],["もの"],["で"],["ある"],["。"]]},{"verse":2,"text":"ヨハネは、神,かみの言,ことばとイエス・キリストのあかしと、すなわち、自分,じぶんが見,みたすべてのことをあかしした。","tok":[["ヨハネ"],["は"],["、"],["神","かみ"],["の"],["言","こ"],["と"],["ば"],["と"],["イエス"],["・"],["キリスト"],["の"],["あかし"],["と"],["、"],["すなわち"],["、"],["自分","じぶん"],["が"],["見た","みた"],["すべて"],["の"],["こと"],["を"],["あかし"],["した"],["。"]]},{"verse":3,"text":"この預言,よげんの言葉,ことばを朗読,ろうどくする者,ものと、これを聞,きいて、その中,なかに書,かかれていることを守,まもる者,ものたちとは、さいわいである。時,ときが近,ちかづいているからである。","tok":[["この"],["預言","よげん"],["の"],["言葉","ことば"],["を"],["朗読","ろうどく"],["する"],["者","もの"],["と"],["、"],["これ"],["を"],["聞いて","きいて"],["、"],["その"],["中","なか"],["に"],["書かれて","かかれて"],["いる"],["こと"],["を"],["守者","まもるもの"],["たち"],["と"],["は"],["、"],["さいわい"],["で"],["ある"],["。"],["時","とき"],["が"],["近づいて","ちかづいて"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"ヨハネからアジヤにある七つの教会,きょうかいへ。今,いまいまし、昔,むかしいまし、やがてきたるべきかたから、また、その御座,みざの前,まえにある七つの霊,れいから、","tok":[["ヨハネ"],["から"],["アジヤ"],["に"],["ある"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["へ"],["。"],["今","いま"],["いまし"],["、"],["昔","むかし"],["いまし"],["、"],["やがて"],["きたるべき"],["かた"],["から"],["、"],["また"],["、"],["その"],["御座","みざ"],["の"],["前","まえ"],["に"],["ある"],["七","なな"],["つ"],["の"],["霊","れい"],["から"],["、"]]},{"verse":5,"text":"また、忠実,ちゅうじつな証人,しょうにん、死人,しにんの中,なかから最初,さいしょに生,うまれた者,もの、地上,ちじょうの諸王,しょおうの支配者,しはいしゃであるイエス・キリストから、恵,めぐみと平安,へいあんとが、あなたがたにあるように。わたしたちを愛,あいし、その血,ちによってわたしたちを罪,つみから解放,かいほうし、","tok":[["また"],["、"],["忠実","ちゅうじつ"],["な"],["証人","しょうにん"],["、"],["死人","しにん"],["の"],["中","なか"],["から"],["最初","さいしょ"],["に"],["生まれた","うまれた"],["者","もの"],["、"],["地上","ちじょう"],["の"],["諸王","しょおう"],["の"],["支配者","しはいしゃ"],["で"],["ある"],["イエス"],["・"],["キリスト"],["から"],["、"],["恵","めぐみ"],["と"],["平安","へいあん"],["と"],["が"],["、"],["あなた"],["がた"],["に"],["ある"],["よう"],["に"],["。"],["わたしたち"],["を"],["愛し","あいし"],["、"],["その"],["血","ち"],["によって"],["わたしたち"],["を"],["罪","つみ"],["から"],["解放","かいほう"],["し"],["、"]]},{"verse":6,"text":"わたしたちを、その父,ちちなる神,かみのために、御国,みくにの民,たみとし、祭司,さいしとして下,くださったかたに、世々,よよ限,かぎりなく栄光,えいこうと権力,けんりょくとがあるように、アァメン。","tok":[["わたしたち"],["を"],["、"],["その"],["父","ちち"],["なる"],["神","かみ"],["の"],["ため"],["に"],["、"],["御国","みくに"],["の"],["民","たみ"],["と"],["し"],["、"],["祭司","さいし"],["として"],["下さった","くださった"],["かた"],["に"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["栄光","えいこう"],["と"],["権力","けんりょく"],["と"],["が"],["ある"],["よう"],["に"],["、"],["アァメン"],["。"]]},{"verse":7,"text":"見,みよ、彼,かれは、雲,くもに乗,のってこられる。すべての人,ひとの目,め、ことに、彼,かれを刺,さしとおした者,ものたちは、彼,かれを仰,あおぎ見,みるであろう。また地上,ちじょうの諸,しょ族,ぞくはみな、彼,かれのゆえに胸,むねを打,うって嘆,なげくであろう。しかり、アァメン。","tok":[["見よ","みよ"],["、"],["彼","かれ"],["は"],["、"],["雲","くも"],["に"],["乗って","のって"],["こられる"],["。"],["すべて"],["の"],["人","ひと"],["の"],["目","め"],["、"],["こと"],["に"],["、"],["彼","かれ"],["を"],["刺","さし"],["と"],["おした"],["者","もの"],["たち"],["は"],["、"],["彼","かれ"],["を"],["仰ぎ見るで","あおぎみるで"],["あろう"],["。"],["また"],["地上","ちじょう"],["の"],["諸族","しょぞく"],["は"],["みな"],["、"],["彼","かれ"],["の"],["ゆえ"],["に"],["胸","むね"],["を"],["打って","うって"],["嘆くで","なげくで"],["あろう"],["。"],["しかり"],["、"],["アァメン"],["。"]]},{"verse":8,"text":"今,いまいまし、昔,むかしいまし、やがてきたるべき者,もの、全能者,ぜんのうしゃにして主,しゅなる神,かみが仰,おおせになる、「わたしはアルパであり、オメガである」。","tok":[["今","いま"],["いまし"],["、"],["昔","むかし"],["いまし"],["、"],["やがて"],["きたるべき"],["者","もの"],["、"],["全能者","ぜんのうしゃ"],["に"],["して"],["主","しゅ"],["なる"],["神","かみ"],["が"],["仰せ","おおせ"],["に"],["なる"],["、"],["「"],["わたし"],["は"],["アルパ"],["で"],["あり"],["、"],["オメガ"],["で"],["ある"],["」"],["。"]]},{"verse":9,"text":"あなたがたの兄弟,きょうだいであり、共,ともにイエスの苦難,くなんと御国,みくにと忍耐,にんたいとにあずかっている、わたしヨハネは、神,かみの言,ことばとイエスのあかしとのゆえに、パトモスという島,しまにいた。","tok":[["あなた"],["がた"],["の"],["兄弟","きょうだい"],["で"],["あり"],["、"],["共","とも"],["に"],["イエス"],["の"],["苦難","くなん"],["と"],["御国","みくに"],["と"],["忍耐","にんたい"],["と"],["に"],["あずかって"],["いる"],["、"],["わたし"],["ヨハネ"],["は"],["、"],["神","かみ"],["の"],["言","こ"],["と"],["ば"],["と"],["イエス"],["の"],["あかし"],["と"],["の"],["ゆえ"],["に"],["、"],["パトモス"],["と"],["いう"],["島","しま"],["に"],["いた"],["。"]]},{"verse":10,"text":"ところが、わたしは、主,しゅの日,ひに御霊,みたまに感,かんじた。そして、わたしのうしろの方,ほうで、ラッパのような大,おおきな声,こえがするのを聞,きいた。","tok":[["ところ"],["が"],["、"],["わたし"],["は"],["、"],["主","しゅ"],["の"],["日","ひ"],["に"],["御霊","みたま"],["に"],["感じた","かんじた"],["。"],["そして"],["、"],["わたし"],["の"],["うしろ"],["の"],["方","ほう"],["で"],["、"],["ラッパ"],["の"],["よう"],["な"],["大きな","おおきな"],["声","こえ"],["が"],["する"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":11,"text":"その声,こえはこう言,いった、「あなたが見,みていることを書,かきものにして、それをエペソ、スミルナ、ペルガモ、テアテラ、サルデス、ヒラデルヒヤ、ラオデキヤにある七つの教会,きょうかいに送,おくりなさい」。","tok":[["その"],["声","こえ"],["は"],["こう"],["言った","いった"],["、"],["「"],["あなた"],["が"],["見て","みて"],["いる"],["こと"],["を"],["書きもの","かきもの"],["に"],["して"],["、"],["それ"],["を"],["エペソ"],["、"],["スミルナ"],["、"],["ペルガモ"],["、"],["テアテラ"],["、"],["サルデス"],["、"],["ヒラデルヒヤ"],["、"],["ラオデキヤ"],["に"],["ある"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["に"],["送り","おくり"],["なさい"],["」"],["。"]]},{"verse":12,"text":"そこでわたしは、わたしに呼,よびかけたその声,こえを見,みようとしてふりむいた。ふりむくと、七つの金,きんの燭台,しょくだいが目,めについた。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["わたし"],["に"],["呼びかけた","よびかけた"],["その"],["声","こえ"],["を"],["見よう","みよう"],["として"],["ふりむいた"],["。"],["ふりむく"],["と"],["、"],["七","なな"],["つ"],["の"],["金","きん"],["の"],["燭台","しょくだい"],["が"],["目","め"],["に"],["ついた"],["。"]]},{"verse":13,"text":"それらの燭台,しょくだいの間,あいだに、足,あしまでたれた上着,うわぎを着,き、胸,むねに金,きんの帯,おびをしめている人,ひとの子,このような者,ものがいた。","tok":[["それ"],["ら"],["の"],["燭台","しょくだい"],["の"],["間","あいだ"],["に"],["、"],["足","あし"],["まで"],["たれた"],["上着","うわぎ"],["を"],["着","き"],["、"],["胸","むね"],["に"],["金","きん"],["の"],["帯","おび"],["を"],["しめて"],["いる"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["な"],["者","もの"],["が"],["いた"],["。"]]},{"verse":14,"text":"そのかしらと髪,かみの毛,けとは、雪,ゆきのように白,しろい羊毛,ようもうに似,にて真白,まっしろであり、目,めは燃,もえる炎,ほのおのようであった。","tok":[["その"],["かしら"],["と"],["髪の毛","かみのけ"],["と"],["は"],["、"],["雪","ゆき"],["の"],["よう"],["に"],["白い","しろい"],["羊毛","ようもう"],["に"],["似て","にて"],["真白","まっしろ"],["で"],["あり"],["、"],["目","め"],["は"],["燃える","もえる"],["炎","ほのお"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":15,"text":"その足,あしは、炉,ろで精錬,せいれんされて光,ひかり輝,かがやくしんちゅうのようであり、声,こえは大水,おおみずのとどろきのようであった。","tok":[["その"],["足","あし"],["は"],["、"],["炉","ろ"],["で"],["精錬","せいれん"],["されて"],["光","ひかり"],["輝やく","かがやく"],["しんちゅう"],["の"],["よう"],["で"],["あり"],["、"],["声","こえ"],["は"],["大水","おおみず"],["の"],["とどろき"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":16,"text":"その右手,みぎてに七つの星,ほしを持,もち、口,くちからは、鋭,するどいもろ刃,はのつるぎがつき出,でており、顔,かおは、強,つよく照,てり輝,かがやく太陽,たいようのようであった。","tok":[["その"],["右手","みぎて"],["に"],["七","なな"],["つ"],["の"],["星","ほし"],["を"],["持","もち"],["、"],["口","くち"],["から"],["は"],["、"],["鋭い","するどい"],["もろ刃","もろは"],["の"],["つるぎ"],["が"],["つき出て","つきでて"],["おり"],["、"],["顔","かお"],["は"],["、"],["強く","つよく"],["照り","てり"],["輝やく","かがやく"],["太陽","たいよう"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":17,"text":"わたしは彼,かれを見,みたとき、その足,あしもとに倒,たおれて死人,しにんのようになった。すると、彼,かれは右手,みぎてをわたしの上,うえにおいて言,いった、「恐,おそれるな。わたしは初,はじめであり、終,おわりであり、","tok":[["わたし"],["は"],["彼","かれ"],["を"],["見た","みた"],["とき"],["、"],["その"],["足もと","あしもと"],["に"],["倒れて","たおれて"],["死人","しにん"],["の"],["よう"],["に"],["なった"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["右手","みぎて"],["を"],["わたし"],["の"],["上","うえ"],["に"],["おいて"],["言った","いった"],["、"],["「"],["恐れる","おそれる"],["な"],["。"],["わたし"],["は"],["初め","はじめ"],["で"],["あり"],["、"],["終","おわり"],["で"],["あり"],["、"]]},{"verse":18,"text":"また、生,いきている者,ものである。わたしは死,しんだことはあるが、見,みよ、世々,よよ限,かぎりなく生,いきている者,ものである。そして、死,しと黄泉,よみとのかぎを持,もっている。","tok":[["また"],["、"],["生きて","いきて"],["いる"],["者","もの"],["で"],["ある"],["。"],["わたし"],["は"],["死んだ","しんだ"],["こと"],["は"],["ある"],["が"],["、"],["見よ","みよ"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["生きて","いきて"],["いる"],["者","もの"],["で"],["ある"],["。"],["そして"],["、"],["死","し"],["と"],["黄泉","よみ"],["と"],["の"],["かぎ"],["を"],["持って","もって"],["いる"],["。"]]},{"verse":19,"text":"そこで、あなたの見,みたこと、現在,げんざいのこと、今後,こんご起,おころうとすることを、書,かきとめなさい。","tok":[["そこ"],["で"],["、"],["あなた"],["の"],["見た","みた"],["こと"],["、"],["現在","げんざい"],["の"],["こと"],["、"],["今後","こんご"],["起ころう","おころう"],["と"],["する"],["こと"],["を"],["、"],["書きとめ","かきとめ"],["なさい"],["。"]]},{"verse":20,"text":"あなたがわたしの右手,みぎてに見,みた七つの星,ほしと、七つの金,きんの燭台,しょくだいとの奥義,おくぎは、こうである。すなわち、七つの星,ほしは七つの教会,きょうかいの御使,みつかいであり、七つの燭台,しょくだいは七つの教会,きょうかいである。","tok":[["あなた"],["が"],["わたし"],["の"],["右手","みぎて"],["に"],["見た","みた"],["七","なな"],["つ"],["の"],["星","ほし"],["と"],["、"],["七","なな"],["つ"],["の"],["金","きん"],["の"],["燭台","しょくだい"],["と"],["の"],["奥義","おくぎ"],["は"],["、"],["こう"],["で"],["ある"],["。"],["すなわち"],["、"],["七","なな"],["つ"],["の"],["星","ほし"],["は"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["の"],["御使","み"],["つかい"],["で"],["あり"],["、"],["七","なな"],["つ"],["の"],["燭台","しょくだい"],["は"],["七","なな"],["つ"],["の"],["教会","きょうかい"],["で"],["ある"],["。"]]}]
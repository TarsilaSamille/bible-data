[{"verse":1,"text":"サルデスにある教会,きょうかいの御使,みつかいに、こう書,かきおくりなさい。『神,かみの七つの霊,れいと七つの星,ほしとを持,もつかたが、次,つぎのように言,いわれる。わたしはあなたのわざを知,しっている。すなわち、あなたは、生,いきているというのは名,なだけで、実,じつは死,しんでいる。","tok":[["サルデス"],["に"],["ある"],["教会","きょうかい"],["の"],["御使","みつかい"],["に"],["、"],["こう"],["書きおくり","かきおくり"],["なさい"],["。"],["『"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["と"],["七","なな"],["つ"],["の"],["星","ほし"],["と"],["を"],["持つ","もつ"],["かた"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"],["わたし"],["は"],["あなた"],["の"],["わざ"],["を"],["知って","しって"],["いる"],["。"],["すなわち"],["、"],["あなた"],["は"],["、"],["生きて","いきて"],["いる"],["と"],["いう"],["の"],["は"],["名","な"],["だけ"],["で"],["、"],["実","じつ"],["は"],["死んで","しんで"],["いる"],["。"]]},{"verse":2,"text":"目,めをさましていて、死,しにかけている残,のこりの者,ものたちを力,ちからづけなさい。わたしは、あなたのわざが、わたしの神,かみのみまえに完全,かんぜんであるとは見,みていない。","tok":[["目","め"],["を"],["さまして"],["いて"],["、"],["死","し"],["に"],["かけて"],["いる"],["残り","のこり"],["の"],["者","もの"],["たち"],["を"],["力づけ","ちからづけ"],["なさい"],["。"],["わたし"],["は"],["、"],["あなた"],["の"],["わざ"],["が"],["、"],["わたし"],["の"],["神","かみ"],["のみ"],["まえ"],["に"],["完全","かんぜん"],["で"],["ある"],["と"],["は"],["見て","みて"],["いない"],["。"]]},{"verse":3,"text":"だから、あなたが、どのようにして受,うけたか、また聞,きいたかを思,おもい起,おこして、それを守,まもりとおし、かつ悔,くい改,あらためなさい。もし目,めをさましていないなら、わたしは盗人,ぬすびとのように来,くるであろう。どんな時,ときにあなたのところに来,くるか、あなたには決,けっしてわからない。","tok":[["だ"],["から"],["、"],["あなた"],["が"],["、"],["どの"],["よう"],["に"],["して"],["受た","うけた"],["か"],["、"],["また"],["聞いた","きいた"],["か"],["を"],["思い起こして","おもいおこして"],["、"],["それ"],["を"],["守り","まもり"],["とおし"],["、"],["かつ"],["悔い改め","くいあらため"],["なさい"],["。"],["もし"],["目","め"],["を"],["さまして"],["いないなら"],["、"],["わたし"],["は"],["盗人","ぬすびと"],["の"],["よう"],["に"],["来るで","くるで"],["あろう"],["。"],["どんな"],["時","とき"],["に"],["あなた"],["の"],["ところ"],["に"],["来る","くる"],["か"],["、"],["あなた"],["に"],["は"],["決っして","けっして"],["わからない"],["。"]]},{"verse":4,"text":"しかし、サルデスにはその衣,ころもを汚,けがさない人,ひとが、数人,すうにんいる。彼,かれらは白,しろい衣,ころもを着,きて、わたしと共,ともに歩,あゆみを続,つづけるであろう。彼,かれらは、それにふさわしい者,ものである。","tok":[["しかし"],["、"],["サルデス"],["に"],["は"],["その"],["衣","ころも"],["を"],["汚","け"],["がさ"],["ない"],["人","ひと"],["が"],["、"],["数人","すうにん"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["白い","しろい"],["衣","ころも"],["を"],["着て","きて"],["、"],["わたし"],["と"],["共","とも"],["に"],["歩み","あゆみ"],["を"],["続けるで","つづけるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["、"],["それ"],["に"],["ふさわしい"],["者","もの"],["で"],["ある"],["。"]]},{"verse":5,"text":"勝利,しょうりを得,える者,ものは、このように白,しろい衣,ころもを着,きせられるのである。わたしは、その名,なをいのちの書,かから消,けすようなことを、決,けっしてしない。また、わたしの父,ちちと御使,みつかいたちの前,まえで、その名,なを言,いいあらわそう。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["は"],["、"],["この"],["よう"],["に"],["白い","しろい"],["衣","ころも"],["を"],["着せられる","きせられる"],["ので"],["ある"],["。"],["わたし"],["は"],["、"],["その"],["名","な"],["を"],["いのち"],["の"],["書","かか"],["ら"],["消す","けす"],["よう"],["な"],["こと"],["を"],["、"],["決っして","けっして"],["しない"],["。"],["また"],["、"],["わたし"],["の"],["父","ちち"],["と"],["御使","みつかいたち"],["の"],["前","まえ"],["で"],["、"],["その"],["名","な"],["を"],["言いあらわそう","いいあらわそう"],["。"]]},{"verse":6,"text":"耳,みみのある者,ものは、御霊,みたまが諸,しょ教会,きょうかいに言,いうことを聞,きくがよい』。","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["、"],["御霊","み"],["たま"],["が"],["諸教","しょ教"],["会","かい"],["に"],["言う","いう"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["』"],["。"]]},{"verse":7,"text":"ヒラデルヒヤにある教会,きょうかいの御使,みつかいに、こう書,かきおくりなさい。『聖,せいなる者,もの、まことなる者,もの、ダビデのかぎを持,もつ者,もの、開,ひらけばだれにも閉,とじられることがなく、閉,とじればだれにも開,ひらかれることのない者,ものが、次,つぎのように言,いわれる。","tok":[["ヒラデルヒヤ"],["に"],["ある"],["教会","きょうかい"],["の"],["御使","みつかい"],["に"],["、"],["こう"],["書きおくり","かきおくり"],["なさい"],["。"],["『"],["聖","せい"],["なる"],["者","もの"],["、"],["まこと"],["なる"],["者","もの"],["、"],["ダビデ"],["の"],["かぎ"],["を"],["持つ","もつ"],["者","もの"],["、"],["開ば","ひらけば"],["だれ"],["に"],["も"],["閉じられる","とじられる"],["こと"],["が"],["なく"],["、"],["閉じれば","とじれば"],["だれ"],["に"],["も"],["開らかれる","ひらかれる"],["こと"],["の"],["ない"],["者","もの"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"]]},{"verse":8,"text":"わたしは、あなたのわざを知,しっている。見,みよ、わたしは、あなたの前,まえに、だれも閉,とじることのできない門,もんを開,ひらいておいた。なぜなら、あなたには少,すこししか力,ちからがなかったにもかかわらず、わたしの言葉,ことばを守,まもり、わたしの名,なを否,いなまなかったからである。","tok":[["わたし"],["は"],["、"],["あなた"],["の"],["わざ"],["を"],["知って","しって"],["いる"],["。"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["あなた"],["の"],["前","まえ"],["に"],["、"],["だれ"],["も"],["閉じる","とじる"],["こと"],["の"],["できない"],["門","もん"],["を"],["開らいて","ひらいて"],["おいた"],["。"],["なぜ"],["なら"],["、"],["あなた"],["に"],["は"],["少し","すこし"],["しか"],["力","ちから"],["が"],["なかった"],["に"],["も"],["かかわらず"],["、"],["わたし"],["の"],["言葉","ことば"],["を"],["守り","まもり"],["、"],["わたし"],["の"],["名","な"],["を"],["否まなかった","いなまなかった"],["から"],["で"],["ある"],["。"]]},{"verse":9,"text":"見,みよ、サタンの会堂,かいどうに属,ぞくする者,もの、すなわち、ユダヤ人,じんと自,じ称,しょうしてはいるが、その実,じつユダヤ人,じんでなくて、偽,いつわる者,ものたちに、こうしよう。見,みよ、彼,かれらがあなたの足,あしもとにきて平伏,へいふくするようにし、そして、わたしがあなたを愛,あいしていることを、彼,かれらに知,しらせよう。","tok":[["見よ","みよ"],["、"],["サタン"],["の"],["会堂","かいどう"],["に"],["属する","ぞくする"],["者","もの"],["、"],["すなわち"],["、"],["ユダヤ人","ゆだやじん"],["と"],["自称","じしょう"],["し"],["ては"],["いる"],["が"],["、"],["その"],["実","じつ"],["ユダヤ人","ゆだやじん"],["で"],["なくて"],["、"],["偽わる","いつわる"],["者","もの"],["たち"],["に"],["、"],["こう"],["しよう"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["が"],["あなた"],["の"],["足もと","あしもと"],["に"],["きて"],["平伏","へいふく"],["する"],["よう"],["に"],["し"],["、"],["そして"],["、"],["わたし"],["が"],["あなた"],["を"],["愛して","あいして"],["いる"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["に"],["知らせよう","しらせよう"],["。"]]},{"verse":10,"text":"忍耐,にんたいについてのわたしの言葉,ことばをあなたが守,まもったから、わたしも、地上,ちじょうに住,すむ者,ものたちをためすために、全,ぜん世界,せかいに臨,のぞもうとしている試錬,しれんの時,ときに、あなたを防,ふせぎ守,まもろう。","tok":[["忍耐","にんたい"],["について"],["の"],["わたし"],["の"],["言葉","ことば"],["を"],["あなた"],["が"],["守った","まもった"],["から"],["、"],["わたし"],["も"],["、"],["地上","ちじょう"],["に"],["住む","すむ"],["者","もの"],["たち"],["を"],["ためす"],["ため"],["に"],["、"],["全","ぜん"],["世界","せかい"],["に"],["臨もう","のぞもう"],["として"],["いる"],["試錬","しれん"],["の"],["時","とき"],["に"],["、"],["あなた"],["を"],["防ぎ守ろう","ふせぎまもろう"],["。"]]},{"verse":11,"text":"わたしは、すぐに来,くる。あなたの冠,かんむりがだれにも奪,うばわれないように、自分,じぶんの持,もっているものを堅,かたく守,まもっていなさい。","tok":[["わたし"],["は"],["、"],["すぐ"],["に"],["来る","くる"],["。"],["あなた"],["の"],["冠","かんむり"],["が"],["だれ"],["に"],["も"],["奪われない","うばわれない"],["よう"],["に"],["、"],["自分","じぶん"],["の"],["持って","もって"],["いる"],["もの"],["を"],["堅く","かたく"],["守って","まもって"],["い"],["なさい"],["。"]]},{"verse":12,"text":"勝利,しょうりを得,える者,ものを、わたしの神,かみの聖所,せいじょにおける柱,はしらにしよう。彼,かれは決,けっして二度,どと外,そとへ出,でることはない。そして彼,かれの上,うえに、わたしの神,かみの御名,みなと、わたしの神,かみの都,みやこ、すなわち、天,てんとわたしの神,かみのみもとから下,くだってくる新,あたらしいエルサレムの名,なと、わたしの新,あたらしい名,なとを、書,かきつけよう。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["を"],["、"],["わたし"],["の"],["神","かみ"],["の"],["聖","せい"],["所","しょ"],["に"],["おける"],["柱","はしら"],["に"],["しよう"],["。"],["彼","かれ"],["は"],["決っして","けっして"],["二","に"],["度","ど"],["と"],["外","そと"],["へ"],["出る","でる"],["こと"],["は"],["ない"],["。"],["そして"],["彼","かれ"],["の"],["上","うえ"],["に"],["、"],["わたし"],["の"],["神","かみ"],["の"],["御名","みな"],["と"],["、"],["わたし"],["の"],["神","かみ"],["の"],["都","み"],["やこ"],["、"],["すなわち"],["、"],["天","てん"],["と"],["わたし"],["の"],["神","かみ"],["のみ"],["もと"],["から"],["下って","くだって"],["くる"],["新らしい","あたらしい"],["エルサレム"],["の"],["名","な"],["と"],["、"],["わたし"],["の"],["新らしい","あたらしい"],["名","な"],["と"],["を"],["、"],["書きつけよう","かきつけよう"],["。"]]},{"verse":13,"text":"耳,みみのある者,ものは、御霊,みたまが諸,しょ教会,きょうかいに言,いうことを聞,きくがよい』。","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["、"],["御霊","み"],["たま"],["が"],["諸教","しょ教"],["会","かい"],["に"],["言う","いう"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["』"],["。"]]},{"verse":14,"text":"ラオデキヤにある教会,きょうかいの御使,みつかいに、こう書,かきおくりなさい。『アァメンたる者,もの、忠実,ちゅうじつな、まことの証人,しょうにん、神,かみに造,つくられたものの根源,こんげんであるかたが、次,つぎのように言,いわれる。","tok":[["ラオデキヤ"],["に"],["ある"],["教会","きょうかい"],["の"],["御使","みつかい"],["に"],["、"],["こう"],["書きおくり","かきおくり"],["なさい"],["。"],["『"],["アァメン"],["たる"],["者","もの"],["、"],["忠実","ちゅうじつ"],["な"],["、"],["まこと"],["の"],["証人","しょうにん"],["、"],["神","かみ"],["に"],["造られた","つくられた"],["もの"],["の"],["根源","こんげん"],["で"],["ある"],["かた"],["が"],["、"],["次","つぎ"],["の"],["よう"],["に"],["言われる","いわれる"],["。"]]},{"verse":15,"text":"わたしはあなたのわざを知,しっている。あなたは冷,つめたくもなく、熱,あつくもない。むしろ、冷,つめたいか熱,あついかであってほしい。","tok":[["わたし"],["は"],["あなた"],["の"],["わざ"],["を"],["知って","しって"],["いる"],["。"],["あなた"],["は"],["冷たく","つめたく"],["も"],["なく"],["、"],["熱く","あつく"],["も"],["ない"],["。"],["むしろ"],["、"],["冷たい","つめたい"],["か"],["熱い","あつい"],["か"],["で"],["あって"],["ほしい"],["。"]]},{"verse":16,"text":"このように、熱,あつくもなく、冷,つめたくもなく、なまぬるいので、あなたを口,くちから吐,はき出,だそう。","tok":[["この"],["よう"],["に"],["、"],["熱く","あつく"],["も"],["なく"],["、"],["冷たく","つめたく"],["も"],["なく"],["、"],["なまぬるい"],["ので"],["、"],["あなた"],["を"],["口","くち"],["から"],["吐出そう","はきだそう"],["。"]]},{"verse":17,"text":"あなたは、自分,じぶんは富,とんでいる、豊,ゆたかになった、なんの不自由,ふじゆうもないと言,いっているが、実,じつは、あなた自身,じしんがみじめな者,もの、あわれむべき者,もの、貧,まずしい者,もの、目,めの見,みえない者,もの、裸,はだかな者,ものであることに気,きがついていない。","tok":[["あなた"],["は"],["、"],["自分","じぶん"],["は"],["富んで","とんで"],["いる"],["、"],["豊","ゆたか"],["に"],["なった"],["、"],["なん"],["の"],["不自由","ふじゆう"],["も"],["ない"],["と"],["言って","いって"],["いる"],["が"],["、"],["実","じつ"],["は"],["、"],["あなた"],["自身","じしん"],["が"],["みじめ"],["な"],["者","もの"],["、"],["あわれむべき"],["者","もの"],["、"],["貧しい","まずしい"],["者","もの"],["、"],["目","め"],["の"],["見えない","みえない"],["者","もの"],["、"],["裸","はだか"],["な"],["者","もの"],["で"],["ある"],["こと"],["に"],["気","き"],["が"],["ついて"],["いない"],["。"]]},{"verse":18,"text":"そこで、あなたに勧,すすめる。富,とむ者,ものとなるために、わたしから火,ひで精錬,せいれんされた金,きんを買,かい、また、あなたの裸,はだかの恥,はじをさらさないため身,みに着,つけるように、白,しろい衣,ころもを買,かいなさい。また、見,みえるようになるため、目,めにぬる目薬,めぐすりを買,かいなさい。","tok":[["そこ"],["で"],["、"],["あなた"],["に"],["勧める","すすめる"],["。"],["富む","とむ"],["者","もの"],["と"],["なる"],["ため"],["に"],["、"],["わたし"],["から"],["火","ひ"],["で"],["精錬","せいれん"],["された"],["金","きん"],["を"],["買","かい"],["、"],["また"],["、"],["あなた"],["の"],["裸","はだか"],["の"],["恥","はじ"],["を"],["さらさない"],["ため"],["身","み"],["に"],["着ける","つける"],["よう"],["に"],["、"],["白い","しろい"],["衣","ころも"],["を"],["買","かい"],["なさい"],["。"],["また"],["、"],["見える","みえる"],["よう"],["に"],["なる"],["ため"],["、"],["目","め"],["に"],["ぬる"],["目薬","めぐすり"],["を"],["買","かい"],["なさい"],["。"]]},{"verse":19,"text":"すべてわたしの愛,あいしている者,ものを、わたしはしかったり、懲,こらしめたりする。だから、熱心,ねっしんになって悔,くい改,あらためなさい。","tok":[["すべて"],["わたし"],["の"],["愛して","あいして"],["いる"],["者","もの"],["を"],["、"],["わたし"],["は"],["しかっ"],["たり"],["、"],["懲らしめ","こらしめ"],["たり"],["する"],["。"],["だ"],["から"],["、"],["熱心","ねっしん"],["に"],["なって"],["悔い改め","くいあらため"],["なさい"],["。"]]},{"verse":20,"text":"見,みよ、わたしは戸,との外,そとに立,たって、たたいている。だれでもわたしの声,こえを聞,きいて戸,とをあけるなら、わたしはその中,なかにはいって彼,かれと食,しょくを共,ともにし、彼,かれもまたわたしと食,しょくを共,ともにするであろう。","tok":[["見よ","みよ"],["、"],["わたし"],["は"],["戸","と"],["の"],["外","そと"],["に"],["立って","たって"],["、"],["たたいて"],["いる"],["。"],["だれ"],["で"],["も"],["わたし"],["の"],["声","こえ"],["を"],["聞いて","きいて"],["戸","と"],["を"],["あけるなら"],["、"],["わたし"],["は"],["その"],["中","なか"],["に"],["はいって"],["彼","かれ"],["と"],["食","しょく"],["を"],["共","とも"],["に"],["し"],["、"],["彼","かれ"],["も"],["また"],["わたし"],["と"],["食","しょく"],["を"],["共","とも"],["に"],["するで"],["あろう"],["。"]]},{"verse":21,"text":"勝利,しょうりを得,える者,ものには、わたしと共,ともにわたしの座,ざにつかせよう。それはちょうど、わたしが勝利,しょうりを得,えてわたしの父,ちちと共,ともにその御座,みざについたのと同様,どうようである。","tok":[["勝利","しょうり"],["を"],["得る","える"],["者","もの"],["に"],["は"],["、"],["わたし"],["と"],["共","とも"],["に"],["わたし"],["の"],["座","ざ"],["に"],["つかせよう"],["。"],["それ"],["は"],["ちょうど"],["、"],["わたし"],["が"],["勝利","しょうり"],["を"],["得て","えて"],["わたし"],["の"],["父","ちち"],["と"],["共","とも"],["に"],["その"],["御座","みざ"],["に"],["ついた"],["の"],["と"],["同様","どうよう"],["で"],["ある"],["。"]]},{"verse":22,"text":"耳,みみのある者,ものは、御霊,みたまが諸,しょ教会,きょうかいに言,いうことを聞,きくがよい』」。","tok":[["耳","みみ"],["の"],["ある"],["者","もの"],["は"],["、"],["御霊","み"],["たま"],["が"],["諸教","しょ教"],["会","かい"],["に"],["言う","いう"],["こと"],["を"],["聞く","きく"],["が"],["よい"],["』"],["」"],["。"]]}]
[{"verse":1,"text":"この後,のち、わたしは天,てんの大群,たいぐん衆が大声,おおごえで唱,となえるような声,こえを聞,きいた、「ハレルヤ、救,すくいと栄光,えいこうと力,ちからとは、われらの神,かみのものであり、","tok":[["この"],["後","の"],["ち"],["、"],["わたし"],["は"],["天","てん"],["の"],["大","だい"],["群衆","ぐんしゅう"],["が"],["大声","おおごえ"],["で"],["唱える","となえる"],["よう"],["な"],["声","こえ"],["を"],["聞いた","きいた"],["、"],["「"],["ハレルヤ"],["、"],["救い","すくい"],["と"],["栄光","えいこう"],["と"],["力","ちから"],["と"],["は"],["、"],["われ"],["ら"],["の"],["神","かみ"],["の"],["もの"],["で"],["あり"],["、"]]},{"verse":2,"text":"そのさばきは、真実,しんじつで正,ただしい。神,かみは、姦淫,かんいんで地,ちを汚,けがした大,おお淫婦,いんぷをさばき、神,かみの僕,しもべたちの血,ちの報復,ほうふくを彼女,かのじょになさったからである」。","tok":[["その"],["さばき"],["は"],["、"],["真実","しんじつ"],["で"],["正い","ただしい"],["。"],["神","かみ"],["は"],["、"],["姦淫","かんいん"],["で"],["地","ち"],["を"],["汚","け"],["がした"],["大","お"],["お淫婦","おいんぷ"],["を"],["さばき"],["、"],["神","かみ"],["の"],["僕","し"],["も"],["べ"],["たち"],["の"],["血","ち"],["の"],["報復","ほうふく"],["を"],["彼女","かのじょ"],["に"],["なさった"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":3,"text":"再,ふたたび声,こえがあって、「ハレルヤ、彼女,かのじょが焼,やかれる火,ひの煙,けむりは、世々,よよ限,かぎりなく立,たちのぼる」と言,いった。","tok":[["再び","ふたたび"],["声","こえ"],["が"],["あって"],["、"],["「"],["ハレルヤ"],["、"],["彼女","かのじょ"],["が"],["焼かれる","やかれる"],["火","ひ"],["の"],["煙","けむり"],["は"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["立ちのぼる","たちのぼる"],["」"],["と"],["言った","いった"],["。"]]},{"verse":4,"text":"すると、二十四人,にんの長老,ちょうろうと四つの生,いき物,ものとがひれ伏,ふし、御座,みざにいます神,かみを拝,はいして言,いった、「アァメン、ハレルヤ」。","tok":[["する"],["と"],["、"],["二十四人","にん"],["の"],["長老","ちょうろう"],["と"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["が"],["ひれ伏し","ひれふし"],["、"],["御座","みざ"],["に"],["います"],["神","かみ"],["を"],["拝して","はいして"],["言った","いった"],["、"],["「"],["アァメン"],["、"],["ハレルヤ"],["」"],["。"]]},{"verse":5,"text":"その時,とき、御座,みざから声,こえが出,でて言,いった、「すべての神,かみの僕,しもべたちよ、神,かみをおそれる者,ものたちよ。小,ちいさき者,ものも大,おおいなる者,ものも、共,ともに、われらの神,かみをさんびせよ」。","tok":[["その"],["時","とき"],["、"],["御座ら","みざから"],["声","こえ"],["が"],["出て","でて"],["言った","いった"],["、"],["「"],["すべて"],["の"],["神","かみ"],["の"],["僕","し"],["も"],["べた"],["ちよ"],["、"],["神","かみ"],["を"],["おそれる"],["者","もの"],["たち"],["よ"],["。"],["小い","ちい"],["さき"],["者","もの"],["も"],["大いなる","おおいなる"],["者","もの"],["も"],["、"],["共","とも"],["に"],["、"],["われ"],["ら"],["の"],["神","かみ"],["を"],["さん"],["び"],["せよ"],["」"],["。"]]},{"verse":6,"text":"わたしはまた、大,だい群衆,ぐんしゅうの声,こえ、多,おおくの水,みずの音,おと、また激,はげしい雷鳴,らいめいのようなものを聞,きいた。それはこう言,いった、「ハレルヤ、全能者,ぜんのうしゃにして主,しゅなるわれらの神,かみは、王,おうなる支配者,しはいしゃであられる。","tok":[["わたし"],["は"],["また"],["、"],["大","だい"],["群衆","ぐんしゅう"],["の"],["声","こえ"],["、"],["多く","おおく"],["の"],["水","みず"],["の"],["音","おと"],["、"],["また"],["激しい","はげしい"],["雷鳴","らいめい"],["の"],["よう"],["な"],["もの"],["を"],["聞いた","きいた"],["。"],["それ"],["は"],["こう"],["言った","いった"],["、"],["「"],["ハレルヤ"],["、"],["全能者","ぜんのうしゃ"],["に"],["して"],["主","しゅ"],["なる"],["われ"],["ら"],["の"],["神","かみ"],["は"],["、"],["王","おう"],["なる"],["支配者","しはいしゃ"],["で"],["あられる"],["。"]]},{"verse":7,"text":"わたしたちは喜,よろこび楽,たのしみ、神,かみをあがめまつろう。小羊,こひつじの婚姻,こんいんの時,ときがきて、花嫁,はなよめはその用意,よういをしたからである。","tok":[["わたしたち"],["は"],["喜こび","よろこび"],["楽み","たのしみ"],["、"],["神","かみ"],["を"],["あがめ"],["まつろう"],["。"],["小羊","こひつじ"],["の"],["婚姻","こんいん"],["の"],["時","とき"],["が"],["きて"],["、"],["花嫁","はなよめ"],["は"],["その"],["用意","ようい"],["を"],["した"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"彼女,かのじょは、光,ひかり輝,かがやく、汚,けがれのない麻布,あさぬのの衣,ころもを着,きることを許,ゆるされた。この麻布,あさぬのの衣,ころもは、聖徒,せいとたちの正,ただしい行,おこないである」。","tok":[["彼女","かのじょ"],["は"],["、"],["光","ひかり"],["輝やく","かがやく"],["、"],["汚","けがれ"],["の"],["ない"],["麻布","あさぬ"],["の"],["の"],["衣","ころも"],["を"],["着る","きる"],["こと"],["を"],["許された","ゆるされた"],["。"],["この"],["麻布","あさぬ"],["の"],["の"],["衣","ころも"],["は"],["、"],["聖徒","せいと"],["たち"],["の"],["正い","ただしい"],["行ない","おこない"],["で"],["ある"],["」"],["。"]]},{"verse":9,"text":"それから、御使,みつかいはわたしに言,いった、「書,かきしるせ。小羊,こひつじの婚,こん宴,えんに招,まねかれた者,ものは、さいわいである」。またわたしに言,いった、「これらは、神,かみの真実,しんじつの言葉,ことばである」。","tok":[["それ"],["から"],["、"],["御使","みつかい"],["は"],["わたし"],["に"],["言った","いった"],["、"],["「"],["書きしるせ","かきしるせ"],["。"],["小羊","こひつじ"],["の"],["婚","こん"],["宴","えん"],["に"],["招かれた","まねかれた"],["者","もの"],["は"],["、"],["さいわい"],["で"],["ある"],["」"],["。"],["また"],["わたし"],["に"],["言った","いった"],["、"],["「"],["これ"],["ら"],["は"],["、"],["神","かみ"],["の"],["真実","しんじつ"],["の"],["言葉","ことば"],["で"],["ある"],["」"],["。"]]},{"verse":10,"text":"そこで、わたしは彼,かれの足,あしもとにひれ伏,ふして、彼,かれを拝,はいそうとした。すると、彼,かれは言,いった、「そのようなことをしてはいけない。わたしは、あなたと同,おなじ僕,しもべ仲間,なかまであり、またイエスのあかしびとであるあなたの兄弟,きょうだいたちと同,おなじ僕,しもべ仲間,なかまである。ただ神,かみだけを拝,はいしなさい。イエスのあかしは、すなわち預言,よげんの霊,れいである」。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["彼","かれ"],["の"],["足もと","あしもと"],["に"],["ひれ伏して","ひれふして"],["、"],["彼","かれ"],["を"],["拝そう","はいそう"],["と"],["した"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["その"],["よう"],["な"],["こと"],["を"],["して"],["は"],["いけない"],["。"],["わたし"],["は"],["、"],["あなた"],["と"],["同じ","おなじ"],["僕","し"],["も"],["べ"],["仲間","なかま"],["で"],["あり"],["、"],["また"],["イエス"],["の"],["あかし"],["びと"],["で"],["ある"],["あなた"],["の"],["兄弟","きょうだい"],["たち"],["と"],["同じ","おなじ"],["僕","し"],["も"],["べ"],["仲間","なかま"],["で"],["ある"],["。"],["ただ"],["神","かみ"],["だけ"],["を"],["拝し","はいし"],["なさい"],["。"],["イエス"],["の"],["あかし"],["は"],["、"],["すなわち"],["預言","よげん"],["の"],["霊","れい"],["で"],["ある"],["」"],["。"]]},{"verse":11,"text":"またわたしが見,みていると、天,てんが開,ひらかれ、見,みよ、そこに白,しろい馬,うまがいた。それに乗,のっているかたは、「忠実,ちゅうじつで真実,しんじつな者,もの」と呼,よばれ、義,ぎによってさばき、また、戦,たたかうかたである。","tok":[["また"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["天","てん"],["が"],["開らかれ","ひらかれ"],["、"],["見よ","みよ"],["、"],["そこ"],["に"],["白い","しろい"],["馬","うま"],["が"],["いた"],["。"],["それ"],["に"],["乗って","のって"],["いる"],["かた"],["は"],["、"],["「"],["忠実","ちゅうじつ"],["で"],["真実","しんじつ"],["な"],["者","もの"],["」"],["と"],["呼ばれ","よばれ"],["、"],["義","ぎ"],["によって"],["さばき"],["、"],["また"],["、"],["戦う","たたかう"],["かた"],["で"],["ある"],["。"]]},{"verse":12,"text":"その目,めは燃,もえる炎,ほのおであり、その頭,あたまには多,おおくの冠,かんむりがあった。また、彼,かれ以外,いがいにはだれも知,しらない名,ながその身,みにしるされていた。","tok":[["その"],["目","め"],["は"],["燃える","もえる"],["炎","ほのお"],["で"],["あり"],["、"],["その"],["頭","あたま"],["に"],["は"],["多く","おおく"],["の"],["冠","かんむり"],["が"],["あった"],["。"],["また"],["、"],["彼","かれ"],["以外","いがい"],["に"],["は"],["だれ"],["も"],["知らない","しらない"],["名","な"],["が"],["その"],["身","み"],["に"],["しるされて"],["いた"],["。"]]},{"verse":13,"text":"彼,かれは血染,ちぞめの衣,ころもをまとい、その名,なは「神,かみの言,ことば」と呼,よばれた。","tok":[["彼","かれ"],["は"],["血染め","ちぞめ"],["の"],["衣","ころも"],["を"],["まとい"],["、"],["その"],["名","な"],["は"],["「"],["神","かみ"],["の"],["言","こ"],["と"],["ば"],["」"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":14,"text":"そして、天,てんの軍勢,ぐんぜいが、純白,じゅんぱくで、汚,けがれのない麻布,あさぬのの衣,ころもを着,きて、白,しろい馬,うまに乗,のり、彼,かれに従,したがった。","tok":[["そして"],["、"],["天","てん"],["の"],["軍勢","ぐんぜい"],["が"],["、"],["純白","じゅんぱく"],["で"],["、"],["汚","けがれ"],["の"],["ない"],["麻布","あさぬ"],["の"],["の"],["衣","ころも"],["を"],["着て","きて"],["、"],["白い","しろい"],["馬","うま"],["に"],["乗","のり"],["、"],["彼","かれ"],["に"],["従った","したがった"],["。"]]},{"verse":15,"text":"その口,くちからは、諸,しょ国民,こくみんを打,うつために、鋭,するどいつるぎが出,でていた。彼,かれは、鉄,てつのつえをもって諸,しょ国民,こくみんを治め,おさめ、また、全能者,ぜんのうしゃなる神,かみの激,はげしい怒,いかりの酒,さかぶねを踏,ふむ。","tok":[["その"],["口","くち"],["から"],["は"],["、"],["諸","しょ"],["国民","こくみん"],["を"],["打つ","うつ"],["ため"],["に"],["、"],["鋭い","するどい"],["つるぎ"],["が"],["出て","でて"],["いた"],["。"],["彼","かれ"],["は"],["、"],["鉄","てつ"],["の"],["つえ"],["を"],["もって"],["諸","しょ"],["国民","こくみん"],["を"],["治め","おさめ"],[","],["おさめ"],["、"],["また"],["、"],["全能者","ぜんのうしゃ"],["なる"],["神","かみ"],["の"],["激しい","はげしい"],["怒り","いかり"],["の"],["酒","さかぶね"],["を"],["踏む","ふむ"],["。"]]},{"verse":16,"text":"その着物,きものにも、そのももにも、「王,おうの王,おう、主,しゅの主,しゅ」という名,ながしるされていた。","tok":[["その"],["着物","きもの"],["に"],["も"],["、"],["その"],["もも"],["に"],["も"],["、"],["「"],["王","おう"],["の"],["王","おう"],["、"],["主","しゅ"],["の"],["主","しゅ"],["」"],["と"],["いう"],["名","な"],["が"],["しるされて"],["いた"],["。"]]},{"verse":17,"text":"また見,みていると、ひとりの御使,みつかいが太陽,たいようの中,なかに立,たっていた。彼,かれは、中空,なかぞらを飛,とんでいるすべての鳥,とりにむかって、大声,おおごえで叫,さけんだ、「さあ、神,かみの大,だい宴会,えんかいに集,あつまってこい。","tok":[["また"],["見て","みて"],["いる"],["と"],["、"],["ひとり"],["の"],["御使","み"],["つかい"],["が"],["太陽","たいよう"],["の"],["中","なか"],["に"],["立って","たって"],["いた"],["。"],["彼","かれ"],["は"],["、"],["中空","なかぞら"],["を"],["飛んで","とんで"],["いる"],["すべて"],["の"],["鳥","とり"],["に"],["むかって"],["、"],["大声","おおごえ"],["で"],["叫けんだ","さけんだ"],["、"],["「"],["さあ"],["、"],["神","かみ"],["の"],["大","だい"],["宴会","えんかい"],["に"],["集まって","あつまって"],["こい"],["。"]]},{"verse":18,"text":"そして、王,おうたちの肉,にく、将軍,しょうぐんの肉,にく、勇者,ゆうしゃの肉,にく、馬,うまの肉,にく、馬,うまに乗,のっている者,ものの肉,にく、また、すべての自由人,じゆうじんと奴隷,どれいとの肉,にく、小,ちいさき者,ものと大,おおいなる者,ものとの肉,にくをくらえ」。","tok":[["そして"],["、"],["王","おう"],["たち"],["の"],["肉","にく"],["、"],["将軍","しょうぐん"],["の"],["肉","にく"],["、"],["勇者","ゆうしゃ"],["の"],["肉","にく"],["、"],["馬","うま"],["の"],["肉","にく"],["、"],["馬","うま"],["に"],["乗って","のって"],["いる"],["者","もの"],["の"],["肉","にく"],["、"],["また"],["、"],["すべて"],["の"],["自由人","じゆうじん"],["と"],["奴隷","どれい"],["と"],["の"],["肉","にく"],["、"],["小い","ちい"],["さき"],["者","もの"],["と"],["大いなる","おおいなる"],["者","もの"],["と"],["の"],["肉","にく"],["を"],["くらえ"],["」"],["。"]]},{"verse":19,"text":"なお見,みていると、獣,けものと地,ちの王,おうたちと彼,かれらの軍勢,ぐんぜいとが集,あつまり、馬,うまに乗,のっているかたとその軍勢,ぐんぜいとに対,たいして、戦,たたかいをいどんだ。","tok":[["なお"],["見て","みて"],["いる"],["と"],["、"],["獣","けもの"],["と"],["地","ち"],["の"],["王","おう"],["たち"],["と"],["彼","かれ"],["ら"],["の"],["軍勢","ぐんぜい"],["と"],["が"],["集まり","あつまり"],["、"],["馬","うま"],["に"],["乗って","のって"],["いる"],["かた"],["と"],["その"],["軍勢","ぐんぜい"],["と"],["に対して","にたいして"],["、"],["戦い","たたかい"],["を"],["いどんだ"],["。"]]},{"verse":20,"text":"しかし、獣,けものは捕,とらえられ、また、この獣,けものの前,まえでしるしを行,おこなって、獣,けものの刻印,こくいんを受,うけた者,ものとその像,ぞうを拝,おがむ者,ものとを惑,まどわしたにせ預言者,よげんしゃも、獣,けものと共,ともに捕,とらえられた。そして、この両者,りょうしゃとも、生,いきながら、硫黄,いおうの燃,もえている火,ひの池,いけに投,なげ込,こまれた。","tok":[["しかし"],["、"],["獣","けもの"],["は"],["捕らえられ","とらえられ"],["、"],["また"],["、"],["この"],["獣","けもの"],["の"],["前","まえ"],["で"],["しるし"],["を"],["行なって","おこなって"],["、"],["獣","けもの"],["の"],["刻印","こくいん"],["を"],["受た","うけた"],["者","もの"],["と"],["その"],["像","ぞう"],["を"],["拝む","おがむ"],["者","もの"],["と"],["を"],["惑わした","まどわした"],["にせ"],["預言者","よげんしゃ"],["も"],["、"],["獣","けもの"],["と"],["共","とも"],["に"],["捕らえられた","とらえられた"],["。"],["そして"],["、"],["この"],["両者","りょうしゃ"],["とも"],["、"],["生き","いき"],["ながら"],["、"],["硫黄","いおう"],["の"],["燃えて","もえて"],["いる"],["火","ひ"],["の"],["池","いけ"],["に"],["投込まれた","なげこまれた"],["。"]]},{"verse":21,"text":"それ以外,いがいの者,ものたちは、馬,うまに乗,のっておられるかたの口,くちから出,でるつるぎで切,きり殺,ころされ、その肉,にくを、すべての鳥,とりが飽,あきるまで食,たべた。","tok":[["それ"],["以外","いがい"],["の"],["者","もの"],["たち"],["は"],["、"],["馬","うま"],["に"],["乗って","のって"],["おられる"],["かた"],["の"],["口","くち"],["から"],["出る","でる"],["つるぎ"],["で"],["切り殺され","きりころされ"],["、"],["その"],["肉","にく"],["を"],["、"],["すべて"],["の"],["鳥","とり"],["が"],["飽きる","あきる"],["まで"],["食べた","たべた"],["。"]]}]
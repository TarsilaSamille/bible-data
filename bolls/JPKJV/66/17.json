[{"verse":1,"text":"それから、七つの鉢,はちを持,もつ七人,にんの御使,みつかいのひとりがきて、わたしに語,かたって言,いった、「さあ、きなさい。多,おおくの水,みずの上,うえにすわっている大,おお淫婦,いんぷに対,たいするさばきを、見,みせよう。","tok":[["それ"],["から"],["、"],["七","なな"],["つ"],["の"],["鉢","はち"],["を"],["持つ","もつ"],["七人","にん"],["の"],["御使","みつかい"],["の"],["ひとり"],["が"],["きて"],["、"],["わたし"],["に"],["語って","かたって"],["言った","いった"],["、"],["「"],["さあ"],["、"],["き"],["なさい"],["。"],["多く","おおく"],["の"],["水","みず"],["の"],["上","うえ"],["に"],["すわって"],["いる"],["大","お"],["お淫婦","おいんぷ"],["に"],["対する","たいする"],["さばき"],["を"],["、"],["見せよう","みせよう"],["。"]]},{"verse":2,"text":"地,ちの王,おうたちはこの女,おんなと姦淫,かんいんを行,おこない、地,ちに住,すむ人々,ひとびとはこの女,おんなの姦淫,かんいんのぶどう酒,しゅに酔,よいしれている」。","tok":[["地","ち"],["の"],["王","おう"],["たち"],["は"],["この"],["女","おんな"],["と"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["地","ち"],["に"],["住む","すむ"],["人々","ひとびと"],["は"],["この"],["女","おんな"],["の"],["姦淫","かんいん"],["の"],["ぶどう酒","ぶどうしゅ"],["に"],["酔","よい"],["しれて"],["いる"],["」"],["。"]]},{"verse":3,"text":"御使,みつかいは、わたしを御霊,みたまに感,かんじたまま、荒野,あらのへ連,つれて行,いった。わたしは、そこでひとりの女,おんなが赤,あかい獣,けものに乗,のっているのを見,みた。その獣,けものは神,かみを汚,けがすかずかずの名,なでおおわれ、また、それに七つの頭,あたまと十の角,つのとがあった。","tok":[["御使","みつかい"],["は"],["、"],["わたし"],["を"],["御霊","みたま"],["に"],["感じた","かんじた"],["まま"],["、"],["荒野","あら"],["の"],["へ"],["連れて","つれて"],["行った","いった"],["。"],["わたし"],["は"],["、"],["そこ"],["で"],["ひとり"],["の"],["女","おんな"],["が"],["赤い","あかい"],["獣","けもの"],["に"],["乗って","のって"],["いる"],["の"],["を"],["見た","みた"],["。"],["その"],["獣","けもの"],["は"],["神","かみ"],["を"],["汚す","けがす"],["かずかず"],["の"],["名","な"],["で"],["おおわれ"],["、"],["また"],["、"],["それ"],["に"],["七","なな"],["つ"],["の"],["頭","あたま"],["と"],["十","じゅう"],["の"],["角","つのと"],["が"],["あった"],["。"]]},{"verse":4,"text":"この女,おんなは紫,むらさきと赤,あかの衣,ころもをまとい、金,きんと宝石,ほうせきと真珠,しんじゅとで身,みを飾,かざり、憎,にくむべきものと自分,じぶんの姦淫,かんいんの汚,けがれとで満,みちている金,きんの杯,さかずきを手,てに持,もち、","tok":[["この"],["女","おんな"],["は"],["紫","むらさき"],["と"],["赤","あか"],["の"],["衣","ころも"],["を"],["まとい"],["、"],["金","きん"],["と"],["宝石","ほうせき"],["と"],["真珠","しんじゅ"],["と"],["で"],["身","み"],["を"],["飾","かざり"],["、"],["憎むべき","にくむべき"],["もの"],["と"],["自分","じぶん"],["の"],["姦淫","かんいん"],["の"],["汚","け"],["がれ"],["と"],["で"],["満ちて","みちて"],["いる"],["金","きん"],["の"],["杯","さかずき"],["を"],["手","て"],["に"],["持","もち"],["、"]]},{"verse":5,"text":"その額,ひたいには、一つの名,ながしるされていた。それは奥義,おくぎであって、「大,おおいなるバビロン、淫婦,いんぷどもと地,ちの憎,にくむべきものらとの母,はは」というのであった。","tok":[["その"],["額","ひたい"],["に"],["は"],["、"],["一","ひと"],["つ"],["の"],["名","な"],["が"],["しるされて"],["いた"],["。"],["それ"],["は"],["奥義","お"],["くぎ"],["で"],["あって"],["、"],["「"],["大いなる","おおいなる"],["バビロン"],["、"],["淫婦","いんぷ"],["ども"],["と"],["地","ち"],["の"],["憎むべき","にくむべき"],["もの"],["ら"],["と"],["の"],["母","はは"],["」"],["と"],["いう"],["ので"],["あった"],["。"]]},{"verse":6,"text":"わたしは、この女,おんなが聖徒,せいとの血,ちとイエスの証人,しょうにんの血,ちに酔,よいしれているのを見,みた。この女,おんなを見,みた時,とき、わたしは非常,ひじょうに驚,おどろきあやしんだ。","tok":[["わたし"],["は"],["、"],["この"],["女","おんな"],["が"],["聖徒","せいと"],["の"],["血","ち"],["と"],["イエス"],["の"],["証人","しょうにん"],["の"],["血","ち"],["に"],["酔","よい"],["しれて"],["いる"],["の"],["を"],["見た","みた"],["。"],["この"],["女","おんな"],["を"],["見た","みた"],["時","とき"],["、"],["わたし"],["は"],["非常","ひじょう"],["に"],["驚","おどろき"],["あやしんだ"],["。"]]},{"verse":7,"text":"すると、御使,みつかいはわたしに言,いった、「なぜそんなに驚,おどろくのか。この女,おんなの奥義,おくぎと、女,おんなを乗,のせている七つの頭,あたまと十の角,つののある獣,けものの奥義,おくぎとを、話,はなしてあげよう。","tok":[["する"],["と"],["、"],["御使","みつかい"],["は"],["わたし"],["に"],["言った","いった"],["、"],["「"],["なぜ"],["そんな"],["に"],["驚ろく","おどろく"],["の"],["か"],["。"],["この"],["女","おんな"],["の"],["奥義","おくぎ"],["と"],["、"],["女","おんな"],["を"],["乗せて","のせて"],["いる"],["七","なな"],["つ"],["の"],["頭","あたま"],["と"],["十","じゅう"],["の"],["角","つ"],["の"],["の"],["ある"],["獣","けもの"],["の"],["奥義","おくぎと"],["を"],["、"],["話","はなし"],["て"],["あげよう"],["。"]]},{"verse":8,"text":"あなたの見,みた獣,けものは、昔,むかしはいたが、今,いまはおらず、そして、やがて底,そこ知,しれぬ所,ところから上,のぼってきて、ついには滅,ほろびに至,いたるものである。地,ちに住,すむ者,もののうち、世,よの初,はじめからいのちの書,しょに名,なをしるされていない者,ものたちは、この獣,けものが、昔,むかしはいたが今,いまはおらず、やがて来,くるのを見,みて、驚,おどろきあやしむであろう。","tok":[["あなた"],["の"],["見た","みた"],["獣","けもの"],["は"],["、"],["昔","むかし"],["は"],["いた"],["が"],["、"],["今","いま"],["は"],["おらず"],["、"],["そして"],["、"],["やがて"],["底","そこ"],["知れぬ","しれぬ"],["所","ところ"],["から"],["上って","のぼって"],["きて"],["、"],["ついに"],["は"],["滅び","ほろび"],["に"],["至る","いたる"],["もの"],["で"],["ある"],["。"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["の"],["うち"],["、"],["世","よ"],["の"],["初め","はじめ"],["から"],["いのち"],["の"],["書","しょ"],["に"],["名","な"],["を"],["しるされて"],["いない"],["者","もの"],["たち"],["は"],["、"],["この"],["獣","けもの"],["が"],["、"],["昔","むかし"],["は"],["いた"],["が"],["今","いま"],["は"],["おらず"],["、"],["やがて"],["来る","くる"],["の"],["を"],["見て","みて"],["、"],["驚","おどろき"],["あやしむで"],["あろう"],["。"]]},{"verse":9,"text":"ここに、知恵,ちえのある心,こころが必要,ひつようである。七つの頭,あたまは、この女,おんなのすわっている七つの山,やまであり、また、七人,にんの王,おうのことである。","tok":[["ここ"],["に"],["、"],["知恵","ちえ"],["の"],["ある"],["心","こころ"],["が"],["必要","ひつよう"],["で"],["ある"],["。"],["七","なな"],["つ"],["の"],["頭","あたま"],["は"],["、"],["この"],["女","おんな"],["の"],["すわって"],["いる"],["七","なな"],["つ"],["の"],["山","やま"],["で"],["あり"],["、"],["また"],["、"],["七人","にん"],["の"],["王","おう"],["の"],["こと"],["で"],["ある"],["。"]]},{"verse":10,"text":"そのうちの五人,にんはすでに倒,たおれ、ひとりは今,いまおり、もうひとりは、まだきていない。それが来,くれば、しばらくの間,あいだだけおることになっている。","tok":[["その"],["うち"],["の"],["五人","にん"],["は"],["すでに"],["倒れ","たおれ"],["、"],["ひとり"],["は"],["今","いま"],["おり"],["、"],["もう"],["ひとり"],["は"],["、"],["まだ"],["きて"],["いない"],["。"],["それ"],["が"],["来れば","くれば"],["、"],["しばらく"],["の"],["間","あいだ"],["だけ"],["おる"],["こと"],["に"],["なって"],["いる"],["。"]]},{"verse":11,"text":"昔,むかしはいたが今,いまはいないという獣,けものは、すなわち第,だい八のものであるが、またそれは、かの七人,にんの中,なかのひとりであって、ついには滅,ほろびに至,いたるものである。","tok":[["昔","むかし"],["は"],["いた"],["が"],["今","いま"],["は"],["いない"],["と"],["いう"],["獣","けもの"],["は"],["、"],["すなわち"],["第","だい"],["八","はち"],["の"],["もの"],["で"],["ある"],["が"],["、"],["また"],["それ"],["は"],["、"],["かの"],["七人","にん"],["の"],["中","なか"],["の"],["ひとり"],["で"],["あって"],["、"],["ついに"],["は"],["滅び","ほろび"],["に"],["至る","いたる"],["もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"あなたの見,みた十の角,つのは、十人,にんの王,おうのことであって、彼,かれらはまだ国,くにを受,うけてはいないが、獣,けものと共,ともに、一時,ひとときだけ王,おうとしての権威,けんいを受,うける。","tok":[["あなた"],["の"],["見た","みた"],["十","じゅう"],["の"],["角","つ"],["の"],["は"],["、"],["十人","にん"],["の"],["王","おう"],["の"],["こと"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["は"],["まだ"],["国","くに"],["を"],["受て","うけて"],["は"],["いない"],["が"],["、"],["獣","けもの"],["と"],["共","とも"],["に"],["、"],["一時","ひ"],["と"],["とき"],["だけ"],["王","おう"],["として"],["の"],["権威","けんい"],["を"],["受る","うける"],["。"]]},{"verse":13,"text":"彼,かれらは心,こころをひとつにしている。そして、自分,じぶんたちの力,ちからと権威,けんいとを獣,けものに与,あたえる。","tok":[["彼","かれ"],["ら"],["は"],["心","こころ"],["を"],["ひと"],["つ"],["に"],["して"],["いる"],["。"],["そして"],["、"],["自分","じぶん"],["たち"],["の"],["力","ちから"],["と"],["権威","けんい"],["と"],["を"],["獣","けもの"],["に"],["与える","あたえる"],["。"]]},{"verse":14,"text":"彼,かれらは小羊,こひつじに戦,たたかいをいどんでくるが、小羊,こひつじは、主,しゅの主,しゅ、王,おうの王,おうであるから、彼,かれらにうち勝,かつ。また、小羊,こひつじと共,ともにいる召,めされた、選,えらばれた、忠実,ちゅうじつな者,ものたちも、勝利,しょうりを得,える」。","tok":[["彼","かれ"],["ら"],["は"],["小羊","こひつじ"],["に"],["戦い","たたかい"],["を"],["いどんで"],["くる"],["が"],["、"],["小羊","こひつじ"],["は"],["、"],["主","しゅ"],["の"],["主","しゅ"],["、"],["王","おう"],["の"],["王","おう"],["で"],["ある"],["から"],["、"],["彼","かれ"],["ら"],["に"],["うち勝つ","うちかつ"],["。"],["また"],["、"],["小羊","こひつじ"],["と"],["共","とも"],["に"],["いる"],["召された","めされた"],["、"],["選ら","えら"],["ばれた"],["、"],["忠実","ちゅうじつ"],["な"],["者","もの"],["たち"],["も"],["、"],["勝利","しょうり"],["を"],["得る","える"],["」"],["。"]]},{"verse":15,"text":"御使,みつかいはまた、わたしに言,いった、「あなたの見,みた水,みず、すなわち、淫婦,いんぷのすわっている所,ところは、あらゆる民族,みんぞく、群衆,ぐんしゅう、国民,こくみん、国語,こくごである。","tok":[["御使","みつかい"],["は"],["また"],["、"],["わたし"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["見た","みた"],["水","みず"],["、"],["すなわち"],["、"],["淫婦","いんぷ"],["の"],["すわって"],["いる"],["所","ところ"],["は"],["、"],["あらゆる"],["民族","みんぞく"],["、"],["群衆","ぐんしゅう"],["、"],["国民","こくみん"],["、"],["国語","こくご"],["で"],["ある"],["。"]]},{"verse":16,"text":"あなたの見,みた十の角,つのと獣,けものとは、この淫婦,いんぷを憎,にくみ、みじめな者,ものにし、裸,はだかにし、彼女,かのじょの肉,にくを食,くい、火,ひで焼,やき尽,つくすであろう。","tok":[["あなた"],["の"],["見た","みた"],["十","じゅう"],["の"],["角","つ"],["の"],["と"],["獣","けもの"],["と"],["は"],["、"],["この"],["淫婦","いんぷ"],["を"],["憎み","にくみ"],["、"],["みじめ"],["な"],["者","もの"],["に"],["し"],["、"],["裸","はだか"],["に"],["し"],["、"],["彼女","かのじょ"],["の"],["肉","にく"],["を"],["食い","くい"],["、"],["火","ひ"],["で"],["焼き","やき"],["尽くすで","つくすで"],["あろう"],["。"]]},{"verse":17,"text":"神,かみは、御言,みことばが成就,じょうじゅする時,ときまで、彼,かれらの心,こころの中,なかに、御旨,みむねを行,おこない、思,おもいをひとつにし、彼,かれらの支配,しはい権,けんを獣,けものに与,あたえる思,おもいを持,もつようにされたからである。","tok":[["神","かみ"],["は"],["、"],["御言","みこと"],["ば"],["が"],["成就","じょうじゅ"],["する"],["時","とき"],["まで"],["、"],["彼","かれ"],["ら"],["の"],["心","こころ"],["の"],["中","なか"],["に"],["、"],["御旨","みむね"],["を"],["行ない","おこない"],["、"],["思い","おもい"],["を"],["ひと"],["つ"],["に"],["し"],["、"],["彼","かれ"],["ら"],["の"],["支配権","しはいけん"],["を"],["獣","けもの"],["に"],["与える","あたえる"],["思い","おもい"],["を"],["持つ","もつ"],["よう"],["に"],["された"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"あなたの見,みたかの女,おんなは、地,ちの王,おうたちを支配,しはいする大,おおいなる都,みやこのことである」。","tok":[["あなた"],["の"],["見た","みた"],["か"],["の"],["女","おんな"],["は"],["、"],["地","ち"],["の"],["王","おう"],["たち"],["を"],["支配","しはい"],["する"],["大いなる","おおいなる"],["都","みやこ"],["の"],["こと"],["で"],["ある"],["」"],["。"]]}]
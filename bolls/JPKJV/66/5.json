[{"verse":1,"text":"わたしはまた、御座,みざにいますかたの右,みぎの手,てに、巻物,まきものがあるのを見,みた。その内側,うちがわにも外側,そとがわにも字,じが書,かいてあって、七つの封印,ふういんで封,ふうじてあった。","tok":[["わたし"],["は"],["また"],["、"],["御座","みざ"],["に"],["います"],["かた"],["の"],["右","みぎ"],["の"],["手","て"],["に"],["、"],["巻物","まきもの"],["が"],["ある"],["の"],["を"],["見た","みた"],["。"],["その"],["内側","うちがわ"],["に"],["も"],["外側","そとがわ"],["に"],["も"],["字","じ"],["が"],["書いて","かいて"],["あって"],["、"],["七","なな"],["つ"],["の"],["封印","ふういん"],["で"],["封じて","ふうじて"],["あった"],["。"]]},{"verse":2,"text":"また、ひとりの強,つよい御使,みつかいが、大声,おおごえで、「その巻物,まきものを開,ひらき、封印,ふういんをとくのにふさわしい者,ものは、だれか」と呼,よばわっているのを見,みた。","tok":[["また"],["、"],["ひとり"],["の"],["強い","つよい"],["御使","み"],["つかい"],["が"],["、"],["大声","おおごえ"],["で"],["、"],["「"],["その"],["巻物","まきもの"],["を"],["開らき","ひらき"],["、"],["封印","ふういん"],["を"],["とく"],["のに"],["ふさわしい"],["者","もの"],["は"],["、"],["だれ"],["か"],["」"],["と"],["呼ばわって","よばわって"],["いる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":3,"text":"しかし、天,てんにも地,ちにも地,ちの下,したにも、この巻物,まきものを開,ひらいて、それを見,みることのできる者,ものは、ひとりもいなかった。","tok":[["しかし"],["、"],["天","てん"],["に"],["も"],["地","ち"],["に"],["も"],["地","ち"],["の"],["下","した"],["に"],["も"],["、"],["この"],["巻物","まきもの"],["を"],["開らいて","ひらいて"],["、"],["それ"],["を"],["見る","みる"],["こと"],["の"],["できる"],["者","もの"],["は"],["、"],["ひとり"],["も"],["いなかった"],["。"]]},{"verse":4,"text":"巻物,まきものを開,ひらいてそれを見,みるのにふさわしい者,ものが見当,みあたらないので、わたしは激,はげしく泣,ないていた。","tok":[["巻物","まきもの"],["を"],["開らいて","ひらいて"],["それ"],["を"],["見る","みる"],["のに"],["ふさわしい"],["者","もの"],["が"],["見当たらない","みあたらない"],["ので"],["、"],["わたし"],["は"],["激しく","はげしく"],["泣いて","ないて"],["いた"],["。"]]},{"verse":5,"text":"すると、長老,ちょうろうのひとりがわたしに言,いった、「泣,なくな。見,みよ、ユダ族,ぞくのしし、ダビデの若,わか枝,えだであるかたが、勝利,しょうりを得,えたので、その巻物,まきものを開,ひらき七つの封印,ふういんを解,とくことができる」。","tok":[["する"],["と"],["、"],["長老","ちょうろう"],["の"],["ひとり"],["が"],["わたし"],["に"],["言った","いった"],["、"],["「"],["泣く","なく"],["な"],["。"],["見よ","みよ"],["、"],["ユダ族","ゆだぞく"],["の"],["しし"],["、"],["ダビデ"],["の"],["若枝","わかえだ"],["で"],["ある"],["かた"],["が"],["、"],["勝利","しょうり"],["を"],["得た","えた"],["ので"],["、"],["その"],["巻物","まきもの"],["を"],["開らき","ひらき"],["七","なな"],["つ"],["の"],["封印","ふういん"],["を"],["解く","とく"],["こと"],["が"],["できる"],["」"],["。"]]},{"verse":6,"text":"わたしはまた、御座,みざと四つの生,いき物,ものとの間,あいだ、長老,ちょうろうたちの間,あいだに、ほふられたとみえる小羊,こひつじが立,たっているのを見,みた。それに七つの角,つのと七つの目,めとがあった。これらの目,めは、全,ぜん世界,せかいにつかわされた、神,かみの七つの霊,れいである。","tok":[["わたし"],["は"],["また"],["、"],["御座","みざ"],["と"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["の"],["間","あいだ"],["、"],["長老","ちょうろう"],["たち"],["の"],["間","あいだ"],["に"],["、"],["ほふられた"],["と"],["みえる"],["小羊","こひつじ"],["が"],["立って","たって"],["いる"],["の"],["を"],["見た","みた"],["。"],["それ"],["に"],["七","なな"],["つ"],["の"],["角","つ"],["の"],["と"],["七","なな"],["つ"],["の"],["目","め"],["と"],["が"],["あった"],["。"],["これ"],["ら"],["の"],["目","め"],["は"],["、"],["全","ぜん"],["世界","せかい"],["に"],["つかわされた"],["、"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["で"],["ある"],["。"]]},{"verse":7,"text":"小羊,こひつじは進,すすみ出,でて、御座,みざにいますかたの右,みぎの手,てから、巻物,まきものを受,うけとった。","tok":[["小羊","こひつじ"],["は"],["進み出て","すすみでて"],["、"],["御座","みざ"],["に"],["います"],["かた"],["の"],["右","みぎ"],["の"],["手","て"],["から"],["、"],["巻物","まきもの"],["を"],["受とった","うけとった"],["。"]]},{"verse":8,"text":"巻物,まきものを受,うけとった時,とき、四つの生,いき物,ものと二十四人,にんの長老,ちょうろうとは、おのおの、立琴,たてごとと、香,こうの満,みちている金,きんの鉢,はちとを手,てに持,もって、小羊,こひつじの前,まえにひれ伏,ふした。この香,こうは聖徒,せいとの祈,いのりである。","tok":[["巻物","まきもの"],["を"],["受とった","うけとった"],["時","とき"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["と"],["二十四人","にん"],["の"],["長老","ちょうろう"],["と"],["は"],["、"],["おのおの"],["、"],["立琴","たてごと"],["と"],["、"],["香","こう"],["の"],["満ちて","みちて"],["いる"],["金","きん"],["の"],["鉢","はちと"],["を"],["手","て"],["に"],["持って","もって"],["、"],["小羊","こひつじ"],["の"],["前","まえ"],["に"],["ひれ伏した","ひれふした"],["。"],["この"],["香","こう"],["は"],["聖徒","せいと"],["の"],["祈","いのり"],["で"],["ある"],["。"]]},{"verse":9,"text":"彼,かれらは新,あたらしい歌,うたを歌,うたって言,いった、「あなたこそは、その巻物,まきものを受,うけとり、封印,ふういんを解,とくにふさわしいかたであります。あなたはほふられ、その血,ちによって、神,かみのために、あらゆる部族,ぶぞく、国語,こくご、民族,みんぞく、国民,こくみんの中,なかから人々,ひとびとをあがない、","tok":[["彼","かれ"],["ら"],["は"],["新らしい","あたらしい"],["歌","うた"],["を"],["歌って","うたって"],["言った","いった"],["、"],["「"],["あなた"],["こそ"],["は"],["、"],["その"],["巻物","まきもの"],["を"],["受","うけ"],["とり"],["、"],["封印","ふういん"],["を"],["解く","とく"],["に"],["ふさわしい"],["かた"],["で"],["あります"],["。"],["あなた"],["は"],["ほふられ"],["、"],["その"],["血","ち"],["によって"],["、"],["神","かみ"],["の"],["ため"],["に"],["、"],["あらゆる"],["部族","ぶぞく"],["、"],["国語","こくご"],["、"],["民族","みんぞく"],["、"],["国民","こくみん"],["の"],["中","なか"],["から"],["人々","ひとびと"],["を"],["あがない"],["、"]]},{"verse":10,"text":"わたしたちの神,かみのために、彼,かれらを御国,みくにの民,たみとし、祭司,さいしとなさいました。彼,かれらは地上,ちじょうを支配,しはいするに至,いたるでしょう」。","tok":[["わたしたち"],["の"],["神","かみ"],["の"],["ため"],["に"],["、"],["彼","かれ"],["ら"],["を"],["御国","みくに"],["の"],["民","たみ"],["と"],["し"],["、"],["祭司","さいし"],["と"],["なさいました"],["。"],["彼","かれ"],["ら"],["は"],["地上","ちじょう"],["を"],["支配","しはい"],["する"],["に"],["至るでしょう","いたるでしょう"],["」"],["。"]]},{"verse":11,"text":"さらに見,みていると、御座,みざと生,いき物,ものと長老,ちょうろうたちとのまわりに、多,おおくの御使,みつかいたちの声,こえが上,あがるのを聞,きいた。その数,かずは万の幾,いく万倍,ばい、千の幾,いく千倍,ばいもあって、","tok":[["さらに"],["見て","みて"],["いる"],["と"],["、"],["御座","みざ"],["と"],["生き物","いきもの"],["と"],["長老","ちょうろう"],["たち"],["と"],["の"],["まわり"],["に"],["、"],["多く","おおく"],["の"],["御使","みつかいたち"],["の"],["声","こえ"],["が"],["上がる","あがる"],["の"],["を"],["聞いた","きいた"],["。"],["その"],["数","かず"],["は"],["万","まん"],["の"],["幾","いく"],["万","まん"],["倍","ばい"],["い"],["、"],["千","せん"],["の"],["幾","いく"],["千","せん"],["倍","ばい"],["も"],["あって"],["、"]]},{"verse":12,"text":"大声,おおごえで叫,さけんでいた、「ほふられた小羊,こひつじこそは、力,ちからと、富,とみと、知恵,ちえと、勢,いきおいと、ほまれと、栄光,えいこうと、さんびとを受,うけるにふさわしい」。","tok":[["大声","おおごえ"],["で"],["叫けんで","さけんで"],["いた"],["、"],["「"],["ほふられた"],["小羊","こひつじ"],["こそ"],["は"],["、"],["力","ちから"],["と"],["、"],["富","とみ"],["と"],["、"],["知恵","ちえ"],["と"],["、"],["勢","いきおい"],["と"],["、"],["ほまれ"],["と"],["、"],["栄光","えいこう"],["と"],["、"],["さん"],["びと"],["を"],["受る","うける"],["に"],["ふさわしい"],["」"],["。"]]},{"verse":13,"text":"またわたしは、天,てんと地,ち、地,ちの下,したと海,うみの中,なかにあるすべての造,つくられたもの、そして、それらの中,なかにあるすべてのものの言,いう声,こえを聞,きいた、「御座,みざにいますかたと小羊,こひつじとに、さんびと、ほまれと、栄光,えいこうと、権力,けんりょくとが、世々,よよ限,かぎりなくあるように」。","tok":[["また"],["わたし"],["は"],["、"],["天","てん"],["と"],["地","ち"],["、"],["地","ち"],["の"],["下","した"],["と"],["海","うみ"],["の"],["中","なか"],["に"],["ある"],["すべて"],["の"],["造られた","つくられた"],["もの"],["、"],["そして"],["、"],["それ"],["ら"],["の"],["中","なか"],["に"],["ある"],["すべて"],["の"],["もの"],["の"],["言う","いう"],["声","こえ"],["を"],["聞いた","きいた"],["、"],["「"],["御座","みざ"],["に"],["います"],["かた"],["と"],["小羊","こひつじ"],["と"],["に"],["、"],["さん"],["び"],["と"],["、"],["ほまれ"],["と"],["、"],["栄光","えいこう"],["と"],["、"],["権力","けんりょく"],["と"],["が"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["ある"],["よう"],["に"],["」"],["。"]]},{"verse":14,"text":"四つの生,いき物,ものはアァメンと唱,となえ、長老,ちょうろうたちはひれ伏,ふして礼拝,れいはいした。","tok":[["四","よん"],["つ"],["の"],["生き物","いきもの"],["は"],["アァメン"],["と"],["唱え","となえ"],["、"],["長老","ちょうろう"],["たち"],["は"],["ひれ伏して","ひれふして"],["礼拝","れいはい"],["した"],["。"]]}]
[{"verse":1,"text":"その後,のち、わたしが見,みていると、見,みよ、開,ひらいた門,もんが天,てんにあった。そして、さきにラッパのような声,こえでわたしに呼,よびかけるのを聞,きいた初,はじめの声,こえが、「ここに上,のぼってきなさい。そうしたら、これから後,のちに起,おこるべきことを、見,みせてあげよう」と言,いった。","tok":[["その後","そのの"],["ち"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["開らいた","ひらいた"],["門","もん"],["が"],["天","てん"],["に"],["あった"],["。"],["そして"],["、"],["さき"],["に"],["ラッパ"],["の"],["よう"],["な"],["声","こえ"],["で"],["わたし"],["に"],["呼びかける","よびかける"],["の"],["を"],["聞いた","きいた"],["初め","はじめ"],["の"],["声","こえ"],["が"],["、"],["「"],["ここ"],["に"],["上って","のぼって"],["き"],["なさい"],["。"],["そう"],["したら"],["、"],["これ"],["から"],["後","のち"],["に"],["起こるべき","おこるべき"],["こと"],["を"],["、"],["見せて","みせて"],["あげよう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":2,"text":"すると、たちまち、わたしは御霊,みたまに感,かんじた。見,みよ、御座,みざが天,てんに設,もうけられており、その御座,みざにいますかたがあった。","tok":[["する"],["と"],["、"],["たちまち"],["、"],["わたし"],["は"],["御霊","みたま"],["に"],["感じた","かんじた"],["。"],["見よ","みよ"],["、"],["御座","み"],["ざ"],["が"],["天","てん"],["に"],["設けられて","もうけられて"],["おり"],["、"],["その"],["御座","みざ"],["に"],["います"],["かた"],["が"],["あった"],["。"]]},{"verse":3,"text":"その座,ざにいますかたは、碧玉,へきぎょくや赤,あかめのうのように見,みえ、また、御座,みざのまわりには、緑玉,りょくぎょくのように見,みえるにじが現,あらわれていた。","tok":[["その"],["座","ざ"],["に"],["います"],["かた"],["は"],["、"],["碧玉","へきぎょく"],["や"],["赤","あか"],["めのう"],["の"],["よう"],["に"],["見え","みえ"],["、"],["また"],["、"],["御座","みざ"],["の"],["まわり"],["に"],["は"],["、"],["緑玉","りょくぎょく"],["の"],["よう"],["に"],["見える","みえる"],["にじ"],["が"],["現われて","あらわれて"],["いた"],["。"]]},{"verse":4,"text":"また、御座,みざのまわりには二十四の座,ざがあって、二十四人,にんの長老,ちょうろうが白,しろい衣,ころもを身,みにまとい、頭,あたまに金,きんの冠,かんむりをかぶって、それらの座,ざについていた。","tok":[["また"],["、"],["御座","みざ"],["の"],["まわり"],["に"],["は"],["二十四","にじゅうよん"],["の"],["座","ざ"],["が"],["あって"],["、"],["二十四人","にん"],["の"],["長老","ちょうろう"],["が"],["白い","しろい"],["衣","ころも"],["を"],["身","み"],["に"],["まとい"],["、"],["頭","あたま"],["に"],["金","きん"],["の"],["冠","かんむり"],["を"],["かぶって"],["、"],["それ"],["ら"],["の"],["座","ざ"],["について"],["いた"],["。"]]},{"verse":5,"text":"御座,みざからは、いなずまと、もろもろの声,こえと、雷鳴,らいめいとが、発,はっしていた。また、七つのともし火,ひが、御座,みざの前,まえで燃,もえていた。これらは、神,かみの七つの霊,れいである。","tok":[["御座","みざから"],["は"],["、"],["いなずま"],["と"],["、"],["もろもろ"],["の"],["声","こえ"],["と"],["、"],["雷鳴","らいめい"],["と"],["が"],["、"],["発して","はっして"],["いた"],["。"],["また"],["、"],["七","なな"],["つ"],["の"],["ともし火","ともしひ"],["が"],["、"],["御座","みざ"],["の"],["前","まえ"],["で"],["燃えて","もえて"],["いた"],["。"],["これ"],["ら"],["は"],["、"],["神","かみ"],["の"],["七","なな"],["つ"],["の"],["霊","れい"],["で"],["ある"],["。"]]},{"verse":6,"text":"御座,みざの前,まえは、水晶,すいしょうに似,にたガラスの海,うみのようであった。御座,みざのそば近,ちかくそのまわりには、四つの生,いき物,ものがいたが、その前,まえにも後,のちにも、一面,めんに目,めがついていた。","tok":[["御座","みざ"],["の"],["前","まえ"],["は"],["、"],["水晶","すいしょう"],["に"],["似た","にた"],["ガラス"],["の"],["海","うみ"],["の"],["よう"],["で"],["あった"],["。"],["御座","みざ"],["の"],["そば"],["近く","ちかく"],["その"],["まわり"],["に"],["は"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["が"],["いた"],["が"],["、"],["その"],["前","まえ"],["に"],["も"],["後","のち"],["に"],["も"],["、"],["一面","めん"],["に"],["目","め"],["が"],["ついて"],["いた"],["。"]]},{"verse":7,"text":"第,だい一の生,いき物,ものはししのようであり、第,だい二の生,いき物,ものは雄,お牛,うしのようであり、第,だい三の生,いき物,ものは人,ひとのような顔,かおをしており、第,だい四の生,いき物,ものは飛,とぶわしのようであった。","tok":[["第","だい"],["一","いち"],["の"],["生き物","いきもの"],["は"],["しし"],["の"],["よう"],["で"],["あり"],["、"],["第","だい"],["二","に"],["の"],["生き物","いきもの"],["は"],["雄牛","おうし"],["の"],["よう"],["で"],["あり"],["、"],["第","だい"],["三","さん"],["の"],["生き物","いきもの"],["は"],["人","ひと"],["の"],["よう"],["な"],["顔","かお"],["を"],["して"],["おり"],["、"],["第","だい"],["四","よん"],["の"],["生き物","いきもの"],["は"],["飛ぶ","とぶ"],["わし"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":8,"text":"この四つの生,いき物,ものには、それぞれ六つの翼,つばさがあり、その翼,つばさのまわりも内側,うちがわも目,めで満,みちていた。そして、昼,ひるも夜,よるも、絶,たえ間,まなくこう叫,さけびつづけていた、「聖,せいなるかな、聖,せいなるかな、聖,せいなるかな、全能者,ぜんのうしゃにして主,しゅなる神,かみ。昔,むかしいまし、今,いまいまし、やがてきたるべき者,もの」。","tok":[["この"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["に"],["は"],["、"],["それぞれ"],["六","むい"],["つ"],["の"],["翼","つばさ"],["が"],["あり"],["、"],["その"],["翼","つばさ"],["の"],["まわり"],["も"],["内側","うちがわ"],["も"],["目","め"],["で"],["満ちて","みちて"],["いた"],["。"],["そして"],["、"],["昼","ひる"],["も"],["夜","よる"],["も"],["、"],["絶え間","たえま"],["なく"],["こう"],["叫","さけび"],["つづけて"],["いた"],["、"],["「"],["聖","せい"],["なる"],["か"],["な"],["、"],["聖","せい"],["なる"],["か"],["な"],["、"],["聖","せい"],["なる"],["か"],["な"],["、"],["全能者","ぜんのうしゃ"],["に"],["して"],["主","しゅ"],["なる"],["神","かみ"],["。"],["昔","むかし"],["いまし"],["、"],["今","いま"],["いまし"],["、"],["やがて"],["きたるべき"],["者","もの"],["」"],["。"]]},{"verse":9,"text":"これらの生,いき物,ものが、御座,みざにいまし、かつ、世々,よよ限,かぎりなく生,いきておられるかたに、栄光,えいこうとほまれとを帰,きし、また、感謝,かんしゃをささげている時,とき、","tok":[["これ"],["ら"],["の"],["生き物","いきもの"],["が"],["、"],["御座","みざ"],["に"],["いまし"],["、"],["かつ"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["生きて","いきて"],["おられる"],["かた"],["に"],["、"],["栄光","えいこう"],["と"],["ほまれ"],["と"],["を"],["帰し","きし"],["、"],["また"],["、"],["感謝","かんしゃ"],["を"],["ささげて"],["いる"],["時","とき"],["、"]]},{"verse":10,"text":"二十四人,にんの長老,ちょうろうは、御座,みざにいますかたのみまえにひれ伏,ふし、世々,よよ限,かぎりなく生,いきておられるかたを拝,おがみ、彼,かれらの冠,かんむりを御座,みざのまえに、投,なげ出,だして言,いった、","tok":[["二十四人","にん"],["の"],["長老","ちょうろう"],["は"],["、"],["御座","みざ"],["に"],["います"],["かた"],["のみ"],["まえ"],["に"],["ひれ伏し","ひれふし"],["、"],["世々","よ"],["よ"],["限","かぎり"],["なく"],["生きて","いきて"],["おられる"],["かた"],["を"],["拝み","おがみ"],["、"],["彼","かれ"],["ら"],["の"],["冠","かんむり"],["を"],["御座","みざ"],["の"],["まえ"],["に"],["、"],["投出","なげだ"],["して"],["言った","いった"],["、"]]},{"verse":11,"text":"「われらの主,しゅなる神,かみよ、あなたこそは、栄光,えいこうとほまれと力,ちからとを受,うけるにふさわしいかた。あなたは万物,ばんぶつを造,つくられました。御旨,みむねによって、万物,ばんぶつは存在,そんざいし、また造,つくられたのであります」。","tok":[["「"],["われ"],["ら"],["の"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["こそ"],["は"],["、"],["栄光","えいこう"],["と"],["ほまれ"],["と"],["力","ちから"],["と"],["を"],["受る","うける"],["に"],["ふさわしい"],["か"],["た"],["。"],["あなた"],["は"],["万物","ばんぶつ"],["を"],["造られました","つくられました"],["。"],["御旨","みむね"],["によって"],["、"],["万物","ばんぶつ"],["は"],["存在","そんざい"],["し"],["、"],["また"],["造られた","つくられた"],["ので"],["あります"],["」"],["。"]]}]
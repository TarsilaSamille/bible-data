[{"verse":1,"text":"この後,のち、わたしは、もうひとりの御使,みつかいが、大,おおいなる権威,けんいを持,もって、天,てんから降,おりて来,くるのを見,みた。地,ちは彼,かれの栄光,えいこうによって明,あかるくされた。","tok":[["この"],["後","の"],["ち"],["、"],["わたし"],["は"],["、"],["もう"],["ひとり"],["の"],["御使","み"],["つかい"],["が"],["、"],["大いなる","おおいなる"],["権威","けんい"],["を"],["持って","もって"],["、"],["天","てん"],["から"],["降りて","おりて"],["来る","くる"],["の"],["を"],["見た","みた"],["。"],["地","ち"],["は"],["彼","かれ"],["の"],["栄光","えいこう"],["によって"],["明かるく","あかるく"],["された"],["。"]]},{"verse":2,"text":"彼,かれは力強,ちからづよい声,こえで叫,さけんで言,いった、「倒,たおれた、大,おおいなるバビロンは倒,たおれた。そして、それは悪魔,あくまの住,すむ所,ところ、あらゆる汚,けがれた霊,れいの巣,そうくつ、また、あらゆる汚,けがれた憎,にくむべき鳥,とりの巣,そうくつとなった。","tok":[["彼","かれ"],["は"],["力強い","ちからづよい"],["声","こえ"],["で"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["倒れた","たおれた"],["、"],["大いなる","おおいなる"],["バビロン"],["は"],["倒れた","たおれた"],["。"],["そして"],["、"],["それ"],["は"],["悪魔","あくま"],["の"],["住む","すむ"],["所","ところ"],["、"],["あらゆる"],["汚","け"],["がれ"],["た"],["霊","れい"],["の"],["巣","そ"],["う"],["くつ"],["、"],["また"],["、"],["あらゆる"],["汚","け"],["がれ"],["た"],["憎むべき","にくむべき"],["鳥","とり"],["の"],["巣","そうくつ"],["と"],["なった"],["。"]]},{"verse":3,"text":"すべての国民,こくみんは、彼女,かのじょの姦淫,かんいんに対,たいする激,はげしい怒,いかりのぶどう酒,しゅを飲,のみ、地,ちの王,おうたちは彼女,かのじょと姦淫,かんいんを行,おこない、地上,ちじょうの商人,しょうにんたちは、彼女,かのじょの極度,きょくどのぜいたくによって富,とみを得,えたからである」。","tok":[["すべて"],["の"],["国民","こくみん"],["は"],["、"],["彼女","かのじょ"],["の"],["姦淫","かんいん"],["に"],["対する","たいする"],["激しい","はげしい"],["怒り","いかり"],["の"],["ぶどう酒","ぶどうしゅ"],["を"],["飲み","のみ"],["、"],["地","ち"],["の"],["王","おう"],["たち"],["は"],["彼女","かのじょ"],["と"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["地上","ちじょう"],["の"],["商人","しょうにん"],["たち"],["は"],["、"],["彼女","かのじょ"],["の"],["極度","きょくど"],["の"],["ぜいたく"],["によって"],["富","とみ"],["を"],["得た","えた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":4,"text":"わたしはまた、もうひとつの声,こえが天,てんから出,でるのを聞,きいた、「わたしの民,たみよ。彼女,かのじょから離,はなれ去,さって、その罪,つみにあずからないようにし、その災害,さいがいに巻,まき込,こまれないようにせよ。","tok":[["わたし"],["は"],["また"],["、"],["もう"],["ひと"],["つ"],["の"],["声","こえ"],["が"],["天","てん"],["から"],["出る","でる"],["の"],["を"],["聞いた","きいた"],["、"],["「"],["わたし"],["の"],["民","たみ"],["よ"],["。"],["彼女","かのじょ"],["から"],["離れ","はなれ"],["去て","さって"],["、"],["その"],["罪","つみ"],["に"],["あずからない"],["よう"],["に"],["し"],["、"],["その"],["災害","さいがい"],["に"],["巻込まれない","まきこまれない"],["よう"],["に"],["せよ"],["。"]]},{"verse":5,"text":"彼女,かのじょの罪,つみは積,つもり積,つって天,てんに達,たっしており、神,かみはその不義,ふぎの行,おこないを覚,おぼえておられる。","tok":[["彼女","かのじょ"],["の"],["罪","つみ"],["は"],["積もり","つもり"],["積って","つって"],["天","てん"],["に"],["達して","たっして"],["おり"],["、"],["神","かみ"],["は"],["その"],["不義","ふぎ"],["の"],["行ない","おこない"],["を"],["覚えて","おぼえて"],["おられる"],["。"]]},{"verse":6,"text":"彼女,かのじょがしたとおりに彼女,かのじょにし返,かえし、そのしわざに応,おうじて二倍,ばいに報復,ほうふくをし、彼女,かのじょが混,まぜて入,いれた杯,さかずきの中,なかに、その倍,ばいの量,りょうを、入,いれてやれ。","tok":[["彼女","かのじょ"],["が"],["した"],["とおり"],["に"],["彼女","かのじょ"],["に"],["し"],["返","かえし"],["、"],["その"],["しわざ"],["に"],["応じて","おうじて"],["二","に"],["倍","ばい"],["に"],["報復","ほうふく"],["を"],["し"],["、"],["彼女","かのじょ"],["が"],["混ぜて","まぜて"],["入れた","いれた"],["杯","さかずき"],["の"],["中","なか"],["に"],["、"],["その"],["倍","ばい"],["の"],["量","りょう"],["を"],["、"],["入れて","いれて"],["やれ"],["。"]]},{"verse":7,"text":"彼女,かのじょが自,みずから高,たかぶり、ぜいたくをほしいままにしたので、それに対,たいして、同,おなじほどの苦,くるしみと悲,かなしみとを味,あじわわせてやれ。彼女,かのじょは心,こころの中,なかで『わたしは女王,じょおうの位,くらいについている者,ものであって、やもめではないのだから、悲,かなしみを知,しらない』と言,いっている。","tok":[["彼女","かのじょ"],["が"],["自から","みずから"],["高か","たか"],["ぶり"],["、"],["ぜいたく"],["を"],["ほしいまま"],["に"],["した"],["ので"],["、"],["それ"],["に対して","にたいして"],["、"],["同じ","おなじ"],["ほど"],["の"],["苦しみ","くるしみ"],["と"],["悲しみ","かなしみ"],["と"],["を"],["味わわせて","あじわわせて"],["やれ"],["。"],["彼女","かのじょ"],["は"],["心","こころ"],["の"],["中","なか"],["で"],["『"],["わたし"],["は"],["女王","じょおう"],["の"],["位","くらい"],["について"],["いる"],["者","もの"],["で"],["あって"],["、"],["やもめ"],["で"],["は"],["ない"],["の"],["だ"],["から"],["、"],["悲しみ","かなしみ"],["を"],["知らない","しらない"],["』"],["と"],["言って","いって"],["いる"],["。"]]},{"verse":8,"text":"それゆえ、さまざまの災害,さいがいが、死,しと悲,かなしみとききんとが、一日,にちのうちに彼女,かのじょを襲,おそい、そして、彼女,かのじょは火,ひで焼,やかれてしまう。彼女,かのじょをさばく主,しゅなる神,かみは、力強,ちからづよいかたなのである。","tok":[["それ"],["ゆえ"],["、"],["さまざま"],["の"],["災害","さいがい"],["が"],["、"],["死","し"],["と"],["悲しみ","かなしみ"],["と"],["ききん"],["と"],["が"],["、"],["一","いち"],["日","にち"],["の"],["うち"],["に"],["彼女","かのじょ"],["を"],["襲い","おそい"],["、"],["そして"],["、"],["彼女","かのじょ"],["は"],["火","ひ"],["で"],["焼かれて","やかれて"],["しまう"],["。"],["彼女","かのじょ"],["を"],["さばく"],["主","しゅ"],["なる"],["神","かみ"],["は"],["、"],["力強い","ちからづよい"],["かた"],["な"],["ので"],["ある"],["。"]]},{"verse":9,"text":"彼女,かのじょと姦淫,かんいんを行,おこない、ぜいたくをほしいままにしていた地,ちの王,おうたちは、彼女,かのじょが焼,やかれる火,ひの煙,けむりを見,みて、彼女,かのじょのために胸,むねを打,うって泣,なき悲,かなしみ、","tok":[["彼女","かのじょ"],["と"],["姦淫","かんいん"],["を"],["行ない","おこない"],["、"],["ぜいたく"],["を"],["ほしいまま"],["に"],["して"],["いた"],["地","ち"],["の"],["王","おう"],["たち"],["は"],["、"],["彼女","かのじょ"],["が"],["焼かれる","やかれる"],["火","ひ"],["の"],["煙","けむり"],["を"],["見て","みて"],["、"],["彼女","かのじょ"],["の"],["ため"],["に"],["胸","むね"],["を"],["打って","うって"],["泣","なき"],["悲しみ","かなしみ"],["、"]]},{"verse":10,"text":"彼女,かのじょの苦,くるしみに恐,おそれをいだき、遠,とおくに立,たって言,いうであろう、『ああ、わざわいだ、大,おおいなる都,みやこ、不,ふ落,おの都,みやこ、バビロンは、わざわいだ。おまえに対,たいするさばきは、一瞬,いっしゅんにしてきた』。","tok":[["彼女","かのじょ"],["の"],["苦しみ","くるしみ"],["に"],["恐","おそれ"],["を"],["いだき"],["、"],["遠く","とおく"],["に"],["立って","たって"],["言うで","いうで"],["あろう"],["、"],["『"],["ああ"],["、"],["わざわい"],["だ"],["、"],["大いなる","おおいなる"],["都","み"],["やこ"],["、"],["不落","ふお"],["の"],["都","み"],["やこ"],["、"],["バビロン"],["は"],["、"],["わざわい"],["だ"],["。"],["おまえ"],["に"],["対する","たいする"],["さばき"],["は"],["、"],["一瞬","いっしゅん"],["に"],["して"],["きた"],["』"],["。"]]},{"verse":11,"text":"また、地,ちの商人,しょうにんたちも彼女,かのじょのために泣,なき悲,かなしむ。もはや、彼,かれらの商品,しょうひんを買,かう者,ものが、ひとりもないからである。","tok":[["また"],["、"],["地","ち"],["の"],["商人","しょうにん"],["たち"],["も"],["彼女","かのじょ"],["の"],["ため"],["に"],["泣","なき"],["悲しむ","かなしむ"],["。"],["もはや"],["、"],["彼","かれ"],["ら"],["の"],["商品","しょうひん"],["を"],["買う","かう"],["者","もの"],["が"],["、"],["ひとり"],["も"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"その商品,しょうひんは、金,きん、銀,ぎん、宝石,ほうせき、真珠,しんじゅ、麻布,あさぬの、紫,むらさき布,ぬの、絹,きぬ、緋,ひ布,ぬの、各種,かくしゅの香木,こうぼく、各種,かくしゅの象牙,ぞうげ細工,ざいく、高価,こうかな木材,もくざい、銅,どう、鉄,てつ、大理石,だいりせきなどの器,うつわ、","tok":[["その"],["商品","しょうひん"],["は"],["、"],["金","きん"],["、"],["銀","ぎん"],["、"],["宝石","ほうせき"],["、"],["真珠","しんじゅ"],["、"],["麻布","あさぬ"],["の"],["、"],["紫布","むらさきぬの"],["、"],["絹","きぬ"],["、"],["緋布","ひぬの"],["、"],["各種","かくしゅ"],["の"],["香木","こうぼく"],["、"],["各種","かくしゅ"],["の"],["象牙","ぞうげ"],["細工","ざ"],["いく"],["、"],["高価","こうか"],["な"],["木材","もくざい"],["、"],["銅","どう"],["、"],["鉄","てつ"],["、"],["大理石","だいりせき"],["など"],["の"],["器","うつわ"],["、"]]},{"verse":13,"text":"肉桂,にっけい、香料,こうりょう、香,こう、におい油,あぶら、乳香,にゅうこう、ぶどう酒,しゅ、オリブ油,ゆ、麦粉,むぎこ、麦,むぎ、牛,うし、羊,ひつじ、馬,うま、車,くるま、奴隷,どれい、そして人身,じんしんなどである。","tok":[["肉桂","に"],["っけ"],["い"],["、"],["香料","こうりょう"],["、"],["香","こう"],["、"],["におい"],["油","あぶら"],["、"],["乳香","にゅうこう"],["、"],["ぶどう酒","ぶどうしゅ"],["、"],["オリブ"],["油","ゆ"],["、"],["麦粉","むぎこ"],["、"],["麦","むぎ"],["、"],["牛","うし"],["、"],["羊","ひつじ"],["、"],["馬","うま"],["、"],["車","くるま"],["、"],["奴隷","どれい"],["、"],["そして"],["人身","じんしん"],["など"],["で"],["ある"],["。"]]},{"verse":14,"text":"おまえの心,こころの喜,よろこびであったくだものはなくなり、あらゆるはでな、はなやかな物,ものはおまえから消,きえ去,さった。それらのものはもはや見,みられない。","tok":[["おまえ"],["の"],["心","こころ"],["の"],["喜こびで","よろこびで"],["あった"],["くだもの"],["は"],["なくなり"],["、"],["あらゆる"],["はで"],["な"],["、"],["はなやか"],["な"],["物","もの"],["は"],["おまえ"],["から"],["消え","きえ"],["去た","さった"],["。"],["それ"],["ら"],["の"],["もの"],["は"],["もはや"],["見られない","みられない"],["。"]]},{"verse":15,"text":"これらの品々,しなじなを売,うって、彼女,かのじょから富,とみを得,えた商人,しょうにんは、彼女,かのじょの苦,くるしみに恐,おそれをいだいて遠,とおくに立,たち、泣,なき悲,かなしんで言,いう、","tok":[["これ"],["ら"],["の"],["品々","しなじな"],["を"],["売って","うって"],["、"],["彼女","かのじょ"],["から"],["富","とみ"],["を"],["得た","えた"],["商人","しょうにん"],["は"],["、"],["彼女","かのじょ"],["の"],["苦しみ","くるしみ"],["に"],["恐","おそれ"],["を"],["いだいて"],["遠く","とおく"],["に"],["立ち","たち"],["、"],["泣","なき"],["悲しんで","かなしんで"],["言う","いう"],["、"]]},{"verse":16,"text":"『ああ、わざわいだ、麻布,あさぬのと紫,むらさき布,ぬのと緋,ひ布,ぬのをまとい、金,きんや宝石,ほうせきや真珠,しんじゅで身,みを飾,かざっていた大,おおいなる都,みやこは、わざわいだ。","tok":[["『"],["ああ"],["、"],["わざわい"],["だ"],["、"],["麻布","あさぬ"],["の"],["と"],["紫布","むらさきぬの"],["と"],["緋布","ひぬの"],["を"],["まとい"],["、"],["金","きん"],["や"],["宝石","ほうせき"],["や"],["真珠","しんじゅ"],["で"],["身","み"],["を"],["飾って","かざって"],["いた"],["大いなる","おおいなる"],["都","みやこ"],["は"],["、"],["わざわい"],["だ"],["。"]]},{"verse":17,"text":"これほどの富,とみが、一瞬,いっしゅんにして無,むに帰,きしてしまうとは』。また、すべての船長,せんちょう、航海者,こうかいしゃ、水夫,すいふ、すべて海,うみで働,はたらいている人,ひとたちは、遠,とおくに立,たち、","tok":[["これ"],["ほど"],["の"],["富","とみ"],["が"],["、"],["一瞬","いっしゅん"],["に"],["して"],["無","む"],["に"],["帰して","きして"],["しまう"],["と"],["は"],["』"],["。"],["また"],["、"],["すべて"],["の"],["船長","せんちょう"],["、"],["航海者","こうかいしゃ"],["、"],["水夫","すいふ"],["、"],["すべて"],["海","うみ"],["で"],["働いて","はたらいて"],["いる"],["人","ひと"],["たち"],["は"],["、"],["遠く","とおく"],["に"],["立ち","たち"],["、"]]},{"verse":18,"text":"彼女,かのじょが焼,やかれる火,ひの煙,けむりを見,みて、叫,さけんで言,いう、『これほどの大,おおいなる都,みやこは、どこにあろう』。","tok":[["彼女","かのじょ"],["が"],["焼かれる","やかれる"],["火","ひ"],["の"],["煙","けむり"],["を"],["見て","みて"],["、"],["叫けんで","さけんで"],["言う","いう"],["、"],["『"],["これ"],["ほど"],["の"],["大いなる","おおいなる"],["都","みやこ"],["は"],["、"],["どこ"],["に"],["あろう"],["』"],["。"]]},{"verse":19,"text":"彼,かれらは頭,あたまにちりをかぶり、泣,なき悲,かなしんで叫,さけぶ、『ああ、わざわいだ、この大,おおいなる都,みやこは、わざわいだ。そのおごりによって、海,うみに舟,ふねを持,もつすべての人,ひとが富,とみを得,えていたのに、この都,みやこも一瞬,いっしゅんにして無,むに帰,きしてしまった』。","tok":[["彼","かれ"],["ら"],["は"],["頭","あたま"],["に"],["ちり"],["を"],["かぶり"],["、"],["泣","なき"],["悲しんで","かなしんで"],["叫けぶ","さけぶ"],["、"],["『"],["ああ"],["、"],["わざわい"],["だ"],["、"],["この"],["大いなる","おおいなる"],["都","みやこ"],["は"],["、"],["わざわい"],["だ"],["。"],["その"],["おごり"],["によって"],["、"],["海","うみ"],["に"],["舟","ふね"],["を"],["持つ","もつ"],["すべて"],["の"],["人","ひと"],["が"],["富","とみ"],["を"],["得て","えて"],["いた"],["のに"],["、"],["この"],["都","みやこ"],["も"],["一瞬","いっしゅん"],["に"],["して"],["無","む"],["に"],["帰して","きして"],["しまった"],["』"],["。"]]},{"verse":20,"text":"天,てんよ、聖徒,せいとたちよ、使徒,しとたちよ、預言者,よげんしゃたちよ。この都,みやこについて大,おおいに喜,よろこべ。神,かみは、あなたがたのために、この都,みやこをさばかれたのである」。","tok":[["天","てん"],["よ"],["、"],["聖徒","せいと"],["たち"],["よ"],["、"],["使徒","しと"],["たち"],["よ"],["、"],["預言者","よげんしゃ"],["たち"],["よ"],["。"],["この"],["都","みやこ"],["について"],["大いに","おおいに"],["喜こべ","よろこべ"],["。"],["神","かみ"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["この"],["都","みやこ"],["を"],["さばかれた"],["ので"],["ある"],["」"],["。"]]},{"verse":21,"text":"すると、ひとりの力強,ちからづよい御使,みつかいが、大,おおきなひきうすのような石,いしを持,もちあげ、それを海,うみに投,なげ込,こんで言,いった、「大,おおいなる都,みやこバビロンは、このように激,はげしく打,うち倒,たおされ、そして、全,まったく姿,すがたを消,けしてしまう。","tok":[["する"],["と"],["、"],["ひとり"],["の"],["力強い","ちからづよい"],["御使","み"],["つかい"],["が"],["、"],["大きな","おおきな"],["ひきうす"],["の"],["よう"],["な"],["石","いし"],["を"],["持","もち"],["あげ"],["、"],["それ"],["を"],["海","うみ"],["に"],["投込んで","なげこんで"],["言った","いった"],["、"],["「"],["大いなる","おおいなる"],["都","み"],["や"],["こ"],["バビロン"],["は"],["、"],["この"],["よう"],["に"],["激しく","はげしく"],["打ち倒され","うちたおされ"],["、"],["そして"],["、"],["全く","まったく"],["姿","すがた"],["を"],["消して","けして"],["しまう"],["。"]]},{"verse":22,"text":"また、おまえの中,なかでは、立琴,たてごとをひく者,もの、歌,うたを歌,うたう者,もの、笛,ふえを吹,ふく者,もの、ラッパを吹,ふき鳴,ならす者,ものの楽,がくの音,ねは全,まったく聞,きかれず、あらゆる仕事,しごとの職人,しょくにんたちも全,まったく姿,すがたを消,けし、また、ひきうすの音,おとも、全,まったく聞,きかれない。","tok":[["また"],["、"],["おまえ"],["の"],["中","なか"],["で"],["は"],["、"],["立琴","たてごと"],["を"],["ひく"],["者","もの"],["、"],["歌","うた"],["を"],["歌う","うたう"],["者","もの"],["、"],["笛","ふえ"],["を"],["吹く","ふく"],["者","もの"],["、"],["ラッパ"],["を"],["吹","ふき"],["鳴らす","ならす"],["者","もの"],["の"],["楽","がく"],["の"],["音","ね"],["は"],["全く","まったく"],["聞かれず","きかれず"],["、"],["あらゆる"],["仕事","しごと"],["の"],["職人","しょくにん"],["たち"],["も"],["全く","まったく"],["姿","すがた"],["を"],["消し","けし"],["、"],["また"],["、"],["ひきうす"],["の"],["音","おと"],["も"],["、"],["全く","まったく"],["聞かれない","きかれない"],["。"]]},{"verse":23,"text":"また、おまえの中,なかでは、あかりもともされず、花婿,はなむこ、花嫁,はなよめの声,こえも聞,きかれない。というのは、おまえの商人,しょうにんたちは地上,ちじょうで勢力,せいりょくを張,はる者,ものとなり、すべての国民,こくみんはおまえのまじないでだまされ、","tok":[["また"],["、"],["おまえ"],["の"],["中","なか"],["で"],["は"],["、"],["あかり"],["も"],["ともされず"],["、"],["花婿","はなむこ"],["、"],["花嫁","はなよめ"],["の"],["声","こえ"],["も"],["聞かれない","きかれない"],["。"],["と"],["いう"],["の"],["は"],["、"],["おまえ"],["の"],["商人","しょうにん"],["たち"],["は"],["地上","ちじょう"],["で"],["勢力","せいりょく"],["を"],["張る","はる"],["者","もの"],["と"],["なり"],["、"],["すべて"],["の"],["国民","こくみん"],["は"],["おまえ"],["の"],["まじない"],["で"],["だまされ"],["、"]]},{"verse":24,"text":"また、預言者,よげんしゃや聖徒,せいとの血,ち、さらに、地上,ちじょうで殺,ころされたすべての者,ものの血,ちが、この都,みやこで流,ながされたからである」。","tok":[["また"],["、"],["預言者","よげんしゃ"],["や"],["聖徒","せいと"],["の"],["血","ち"],["、"],["さらに"],["、"],["地上","ちじょう"],["で"],["殺ろされた","ころされた"],["すべて"],["の"],["者","もの"],["の"],["血","ち"],["が"],["、"],["この"],["都","みやこ"],["で"],["流された","ながされた"],["から"],["で"],["ある"],["」"],["。"]]}]
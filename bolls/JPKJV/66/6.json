[{"verse":1,"text":"小羊,こひつじがその七つの封印,ふういんの一つを解,といた時,とき、わたしが見,みていると、四つの生,いき物,ものの一つが、雷,かみなりのような声,こえで「きたれ」と呼,よぶのを聞,きいた。","tok":[["小羊","こひつじ"],["が"],["その"],["七","なな"],["つ"],["の"],["封印","ふういん"],["の"],["一","ひと"],["つ"],["を"],["解いた","といた"],["時","とき"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["の"],["一","ひと"],["つ"],["が"],["、"],["雷","かみなり"],["の"],["よう"],["な"],["声","こえ"],["で"],["「"],["きたれ"],["」"],["と"],["呼ぶ","よぶ"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":2,"text":"そして見,みていると、見,みよ、白,しろい馬,うまが出,でてきた。そして、それに乗,のっている者,ものは、弓,ゆみを手,てに持,もっており、また冠,かんむりを与,あたえられて、勝利,しょうりの上,うえにもなお勝利,しょうりを得,えようとして出,でかけた。","tok":[["そして"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["白い","しろい"],["馬","うま"],["が"],["出て","でて"],["きた"],["。"],["そして"],["、"],["それ"],["に"],["乗って","のって"],["いる"],["者","もの"],["は"],["、"],["弓","ゆみ"],["を"],["手","て"],["に"],["持って","もって"],["おり"],["、"],["また"],["冠","かんむり"],["を"],["与えられて","あたえられて"],["、"],["勝利","しょうり"],["の"],["上","うえ"],["に"],["も"],["なお"],["勝利","しょうり"],["を"],["得よう","えよう"],["として"],["出かけた","でかけた"],["。"]]},{"verse":3,"text":"小羊,こひつじが第,だい二の封印,ふういんを解,といた時,とき、第,だい二の生,いき物,ものが「きたれ」と言,いうのを、わたしは聞,きいた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["二","に"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["時","とき"],["、"],["第","だい"],["二","に"],["の"],["生き物","いきもの"],["が"],["「"],["きたれ"],["」"],["と"],["言う","いう"],["の"],["を"],["、"],["わたし"],["は"],["聞いた","きいた"],["。"]]},{"verse":4,"text":"すると今度,こんどは、赤,あかい馬,うまが出,でてきた。そして、それに乗,のっている者,ものは、人々,ひとびとが互,たがいに殺,ころし合,あうようになるために、地上,ちじょうから平和,へいわを奪,うばい取,とることを許,ゆるされ、また、大,おおきなつるぎを与,あたえられた。","tok":[["する"],["と"],["今度","こんど"],["は"],["、"],["赤い","あかい"],["馬","うま"],["が"],["出て","でて"],["きた"],["。"],["そして"],["、"],["それ"],["に"],["乗って","のって"],["いる"],["者","もの"],["は"],["、"],["人々","ひとびと"],["が"],["互","たがい"],["に"],["殺ろし","ころし"],["合う","あう"],["よう"],["に"],["なる"],["ため"],["に"],["、"],["地上","ちじょう"],["から"],["平和","へいわ"],["を"],["奪い取る","うばいとる"],["こと"],["を"],["許され","ゆるされ"],["、"],["また"],["、"],["大きな","おおきな"],["つるぎ"],["を"],["与えられた","あたえられた"],["。"]]},{"verse":5,"text":"また、第,だい三の封印,ふういんを解,といた時,とき、第,だい三の生,いき物,ものが「きたれ」と言,いうのを、わたしは聞,きいた。そこで見,みていると、見,みよ、黒,くろい馬,うまが出,でてきた。そして、それに乗,のっている者,ものは、はかりを手,てに持,もっていた。","tok":[["また"],["、"],["第","だい"],["三","さん"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["時","とき"],["、"],["第","だい"],["三","さん"],["の"],["生き物","いきもの"],["が"],["「"],["きたれ"],["」"],["と"],["言う","いう"],["の"],["を"],["、"],["わたし"],["は"],["聞いた","きいた"],["。"],["そこ"],["で"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["黒い","くろい"],["馬","うま"],["が"],["出て","でて"],["きた"],["。"],["そして"],["、"],["それ"],["に"],["乗って","のって"],["いる"],["者","もの"],["は"],["、"],["はかり"],["を"],["手","て"],["に"],["持って","もって"],["いた"],["。"]]},{"verse":6,"text":"すると、わたしは四つの生,いき物,ものの間,あいだから出,でて来,くると思,おもわれる声,こえが、こう言,いうのを聞,きいた、「小麦,こむぎ一ますは一デナリ。大麦,おおむぎ三ますも一デナリ。オリブ油,ゆとぶどう酒,しゅとを、そこなうな」。","tok":[["する"],["と"],["、"],["わたし"],["は"],["四","よん"],["つ"],["の"],["生き物","いきもの"],["の"],["間","あいだ"],["から"],["出て","でて"],["来る","くる"],["と"],["思われる","おもわれる"],["声","こえ"],["が"],["、"],["こう"],["言う","いう"],["の"],["を"],["聞いた","きいた"],["、"],["「"],["小麦","こむぎ"],["一","ひと"],["ます"],["は"],["一","いち"],["デナリ"],["。"],["大麦","おおむぎ"],["三","さん"],["ます"],["も"],["一","いち"],["デナリ"],["。"],["オリブ"],["油","ゆ"],["と"],["ぶどう酒","ぶどうしゅ"],["と"],["を"],["、"],["そこなう"],["な"],["」"],["。"]]},{"verse":7,"text":"小羊,こひつじが第,だい四の封印,ふういんを解,といた時,とき、第,だい四の生,いき物,ものが「きたれ」と言,いう声,こえを、わたしは聞,きいた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["四","よん"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["時","とき"],["、"],["第","だい"],["四","よん"],["の"],["生き物","いきもの"],["が"],["「"],["きたれ"],["」"],["と"],["言う","いう"],["声","こえ"],["を"],["、"],["わたし"],["は"],["聞いた","きいた"],["。"]]},{"verse":8,"text":"そこで見,みていると、見,みよ、青白,あおじろい馬,うまが出,でてきた。そして、それに乗,のっている者,ものの名,なは「死,し」と言,いい、それに黄泉,よみが従,したがっていた。彼,かれらには、地,ちの四分,ぶんの一を支配,しはいする権威,けんい、および、つるぎと、ききんと、死,しと、地,ちの獣,けものらとによって人,ひとを殺,ころす権威,けんいとが、与,あたえられた。","tok":[["そこ"],["で"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["青白い","あおじろい"],["馬","うま"],["が"],["出て","でて"],["きた"],["。"],["そして"],["、"],["それ"],["に"],["乗って","のって"],["いる"],["者","もの"],["の"],["名","な"],["は"],["「"],["死","し"],["」"],["と"],["言い","いい"],["、"],["それ"],["に"],["黄泉","よみ"],["が"],["従って","したがって"],["いた"],["。"],["彼","かれ"],["ら"],["に"],["は"],["、"],["地","ち"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["支配","しはい"],["する"],["権威","けんい"],["、"],["および"],["、"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["死","し"],["と"],["、"],["地","ち"],["の"],["獣","けもの"],["ら"],["と"],["によって"],["人","ひと"],["を"],["殺ろす","ころす"],["権威","けんい"],["と"],["が"],["、"],["与えられた","あたえられた"],["。"]]},{"verse":9,"text":"小羊,こひつじが第,だい五の封印,ふういんを解,といた時,とき、神,かみの言,ことばのゆえに、また、そのあかしを立,たてたために、殺,ころされた人々,ひとびとの霊魂,れいこんが、祭壇,さいだんの下,したにいるのを、わたしは見,みた。","tok":[["小羊","こひつじ"],["が"],["第","だい"],["五","ご"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["時","とき"],["、"],["神","かみ"],["の"],["言","ことば"],["の"],["ゆえ"],["に"],["、"],["また"],["、"],["その"],["あかし"],["を"],["立てた","たてた"],["ため"],["に"],["、"],["殺ろされた","ころされた"],["人々","ひとびと"],["の"],["霊魂","れいこん"],["が"],["、"],["祭壇","さいだん"],["の"],["下","した"],["に"],["いる"],["の"],["を"],["、"],["わたし"],["は"],["見た","みた"],["。"]]},{"verse":10,"text":"彼,かれらは大声,おおごえで叫,さけんで言,いった、「聖,せいなる、まことなる主,しゅよ。いつまであなたは、さばくことをなさらず、また地,ちに住,すむ者,ものに対,たいして、わたしたちの血,ちの報復,ほうふくをなさらないのですか」。","tok":[["彼","かれ"],["ら"],["は"],["大声","おおごえ"],["で"],["叫けんで","さけんで"],["言った","いった"],["、"],["「"],["聖","せい"],["なる"],["、"],["まこと"],["なる"],["主","しゅ"],["よ"],["。"],["いつ"],["まで"],["あなた"],["は"],["、"],["さばく"],["こと"],["を"],["なさらず"],["、"],["また"],["地","ち"],["に"],["住む","すむ"],["者","もの"],["に対して","にたいして"],["、"],["わたしたち"],["の"],["血","ち"],["の"],["報復","ほうふく"],["を"],["なさらない"],["の"],["です"],["か"],["」"],["。"]]},{"verse":11,"text":"すると、彼,かれらのひとりびとりに白,しろい衣,ころもが与,あたえられ、それから、「彼,かれらと同,おなじく殺,ころされようとする僕,しもべ仲間,なかまや兄弟,きょうだいたちの数,かずが満,みちるまで、もうしばらくの間,あいだ、休,やすんでいるように」と言,いい渡,わたされた。","tok":[["する"],["と"],["、"],["彼","かれ"],["ら"],["の"],["ひとりびとり"],["に"],["白い","しろい"],["衣","ころも"],["が"],["与えられ","あたえられ"],["、"],["それ"],["から"],["、"],["「"],["彼","かれ"],["ら"],["と"],["同じく","おなじく"],["殺ろされよう","ころされよう"],["と"],["する"],["僕","し"],["も"],["べ"],["仲間","なかま"],["や"],["兄弟","きょうだい"],["たち"],["の"],["数","かず"],["が"],["満ちる","みちる"],["まで"],["、"],["もう"],["しばらく"],["の"],["間","あいだ"],["、"],["休す","やす"],["ん"],["で"],["いる"],["よう"],["に"],["」"],["と"],["言い渡された","いいわたされた"],["。"]]},{"verse":12,"text":"小羊,こひつじが第,だい六の封印,ふういんを解,といた時,とき、わたしが見,みていると、大,だい地震,じしんが起,おこって、太陽,たいようは毛織,けおりの荒布,あらぬののように黒,くろくなり、月,つきは全面,ぜんめん、血,ちのようになり、","tok":[["小羊","こひつじ"],["が"],["第","だい"],["六","ろく"],["の"],["封印","ふういん"],["を"],["解いた","といた"],["時","とき"],["、"],["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["大地震","だいじしん"],["が"],["起こって","おこって"],["、"],["太陽","たいよう"],["は"],["毛織","けおり"],["の"],["荒布","あらぬ"],["の"],["の"],["よう"],["に"],["黒く","くろく"],["なり"],["、"],["月","つき"],["は"],["全面","ぜんめん"],["、"],["血","ち"],["の"],["よう"],["に"],["なり"],["、"]]},{"verse":13,"text":"天,てんの星,ほしは、いちじくのまだ青,あおい実,みが大風,おおふうに揺,ゆられて振,ふり落,おとされるように、地,ちに落,おちた。","tok":[["天","てん"],["の"],["星","ほし"],["は"],["、"],["いちじく"],["の"],["まだ"],["青い","あおい"],["実","み"],["が"],["大風","おおふう"],["に"],["揺られて","ゆられて"],["振り落とされる","ふりおとされる"],["よう"],["に"],["、"],["地","ち"],["に"],["落","おち"],["た"],["。"]]},{"verse":14,"text":"天,てんは巻物,まきものが巻,まかれるように消,きえていき、すべての山,やまと島,しまとはその場所,ばしょから移,うつされてしまった。","tok":[["天","てん"],["は"],["巻物","まきもの"],["が"],["巻かれる","まかれる"],["よう"],["に"],["消えて","きえて"],["いき"],["、"],["すべて"],["の"],["山","やま"],["と"],["島","しま"],["と"],["は"],["その"],["場所","ばしょ"],["から"],["移されて","うつされて"],["しまった"],["。"]]},{"verse":15,"text":"地,ちの王,おうたち、高官,こうかん、千卒長,せんそつちょう、富,とめる者,もの、勇者,ゆうしゃ、奴隷,どれい、自由人,じゆうじんらはみな、ほら穴,あなや山,やまの岩,いわかげに、身,みをかくした。","tok":[["地","ち"],["の"],["王","おう"],["たち"],["、"],["高官","こうかん"],["、"],["千卒長","せんそつちょう"],["、"],["富める","とめる"],["者","もの"],["、"],["勇者","ゆうしゃ"],["、"],["奴隷","どれい"],["、"],["自由人","じゆうじんら"],["は"],["みな"],["、"],["ほら穴","ほらあな"],["や"],["山","やま"],["の"],["岩かげ","いわかげ"],["に"],["、"],["身","み"],["を"],["かくした"],["。"]]},{"verse":16,"text":"そして、山,やまと岩,いわとにむかって言,いった、「さあ、われわれをおおって、御座,みざにいますかたの御顔,みかおと小羊,こひつじの怒,いかりとから、かくまってくれ。","tok":[["そして"],["、"],["山","やま"],["と"],["岩","いわ"],["と"],["に"],["むかって"],["言った","いった"],["、"],["「"],["さあ"],["、"],["われわれ"],["を"],["おおって"],["、"],["御座","みざ"],["に"],["います"],["かた"],["の"],["御顔","みかお"],["と"],["小羊","こひつじ"],["の"],["怒り","いかり"],["と"],["から"],["、"],["かくまって"],["くれ"],["。"]]},{"verse":17,"text":"御,み怒,いかりの大,おおいなる日,ひが、すでにきたのだ。だれが、その前,まえに立,たつことができようか」。","tok":[["御怒り","みいかり"],["の"],["大いなる","おおいなる"],["日","ひ"],["が"],["、"],["すでに"],["きた"],["の"],["だ"],["。"],["だれ"],["が"],["、"],["その"],["前","まえ"],["に"],["立つ","たつ"],["こと"],["が"],["できよう"],["か"],["」"],["。"]]}]
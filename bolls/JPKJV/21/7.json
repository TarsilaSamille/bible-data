[{"verse":1,"text":"良,よき名,なは良,よき油,あぶらにまさり、死,しぬる日,ひは生,うまるる日,ひにまさる。","tok":[["良き","よき"],["名","な"],["は"],["良き","よき"],["油","あぶら"],["に"],["まさり"],["、"],["死ぬる","しぬる"],["日","ひ"],["は"],["生まるる","うまるる"],["日","ひ"],["に"],["まさる"],["。"]]},{"verse":2,"text":"悲,かなしみの家,いえにはいるのは、宴会,えんかいの家,いえにはいるのにまさる。死,しはすべての人,ひとの終,おわりだからである。生,いきている者,ものは、これを心,こころにとめる。","tok":[["悲しみ","かなしみ"],["の"],["家","いえ"],["に"],["は"],["いる"],["の"],["は"],["、"],["宴会","えんかい"],["の"],["家","いえ"],["に"],["は"],["いる"],["のに"],["まさる"],["。"],["死","し"],["は"],["すべて"],["の"],["人","ひと"],["の"],["終","おわり"],["だ"],["から"],["で"],["ある"],["。"],["生きて","いきて"],["いる"],["者","もの"],["は"],["、"],["これ"],["を"],["心","こころ"],["に"],["とめる"],["。"]]},{"verse":3,"text":"悲,かなしみは笑,わらいにまさる。顔,かおに憂,うれいをもつことによって、心,こころは良,よくなるからである。","tok":[["悲しみ","かなしみ"],["は"],["笑","わらい"],["に"],["まさる"],["。"],["顔","かお"],["に"],["憂","うれい"],["を"],["もつ"],["こと"],["によって"],["、"],["心","こころ"],["は"],["良く","よく"],["なる"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"賢,かしこい者,ものの心,こころは悲,かなしみの家,いえにあり、愚,おろかな者,ものの心,こころは楽,たのしみの家,いえにある。","tok":[["賢しこい","かしこい"],["者","もの"],["の"],["心","こころ"],["は"],["悲しみ","かなしみ"],["の"],["家","いえ"],["に"],["あり"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["心","こころ"],["は"],["楽み","たのしみ"],["の"],["家","いえ"],["に"],["ある"],["。"]]},{"verse":5,"text":"賢,かしこい者,ものの戒,いましめを聞,きくのは、愚,おろかな者,ものの歌,うたを聞,きくのにまさる。","tok":[["賢しこい","かしこい"],["者","もの"],["の"],["戒しめ","いましめ"],["を"],["聞く","きく"],["の"],["は"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["歌","うた"],["を"],["聞く","きく"],["のに"],["まさる"],["。"]]},{"verse":6,"text":"愚,おろかな者,ものの笑,わらいはかまの下,したに燃,もえるいばらの音,おとのようである。これもまた空,くうである。","tok":[["愚か","おろか"],["な"],["者","もの"],["の"],["笑","わらい"],["はかま"],["の"],["下","した"],["に"],["燃える","もえる"],["いばら"],["の"],["音","おと"],["の"],["よう"],["で"],["ある"],["。"],["これ"],["も"],["また"],["空","く"],["うで"],["ある"],["。"]]},{"verse":7,"text":"たしかに、しえたげは賢,かしこい人,ひとを愚,おろかにし、まいないは人,ひとの心,こころをそこなう。","tok":[["たしか"],["に"],["、"],["し"],["えたげ"],["は"],["賢しこい","かしこい"],["人","ひと"],["を"],["愚か","おろか"],["に"],["し"],["、"],["まいない"],["は"],["人","ひと"],["の"],["心","こころ"],["を"],["そこなう"],["。"]]},{"verse":8,"text":"事,ことの終,おわりはその初,はじめよりも良,よい。耐,たえ忍,しのぶ心,こころは、おごり高,たかぶる心,こころにまさる。","tok":[["事","こと"],["の"],["終","おわり"],["は"],["その"],["初め","はじめ"],["より"],["も"],["良い","よい"],["。"],["耐え","たえ"],["忍心","しのぶこころ"],["は"],["、"],["おごり高ぶる","おごりたかぶる"],["心","こころ"],["に"],["まさる"],["。"]]},{"verse":9,"text":"気,きをせきたてて怒,いかるな。怒,いかりは愚,おろかな者,ものの胸,むねに宿,やどるからである。","tok":[["気","き"],["を"],["せきたてて"],["怒","い"],["かる"],["な"],["。"],["怒り","いかり"],["は"],["愚か","おろか"],["な"],["者","もの"],["の"],["胸","むね"],["に"],["宿る","やどる"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"「昔,むかしが今,いまよりもよかったのはなぜか」と言,いうな。あなたがこれを問,とうのは知恵,ちえから出,でるのではない。","tok":[["「"],["昔","むかし"],["が"],["今","いま"],["より"],["も"],["よかった"],["の"],["は"],["なぜ"],["か"],["」"],["と"],["言う","いう"],["な"],["。"],["あなた"],["が"],["これ"],["を"],["問う","とう"],["の"],["は"],["知恵","ちえ"],["から"],["出る","でる"],["ので"],["は"],["ない"],["。"]]},{"verse":11,"text":"知恵,ちえに財産,ざいさんが伴,ともなうのは良,よい。それは日,ひを見,みる者,ものどもに益,えきがある。","tok":[["知恵","ちえ"],["に"],["財産","ざいさん"],["が"],["伴なう","ともなう"],["の"],["は"],["良い","よい"],["。"],["それ"],["は"],["日","ひ"],["を"],["見る","みる"],["者","もの"],["ども"],["に"],["益","えき"],["が"],["ある"],["。"]]},{"verse":12,"text":"知恵,ちえが身,みを守,まもるのは、金銭,きんせんが身,みを守,まもるようである。しかし、知恵,ちえはこれを持,もつ者,ものに生命,せいめいを保,たもたせる。これが知識,ちしきのすぐれた所,ところである。","tok":[["知恵","ちえ"],["が"],["身","み"],["を"],["守","まもる"],["の"],["は"],["、"],["金銭","きんせん"],["が"],["身","み"],["を"],["守","まもる"],["よう"],["で"],["ある"],["。"],["しかし"],["、"],["知恵","ちえ"],["は"],["これ"],["を"],["持つ","もつ"],["者","もの"],["に"],["生命","せいめい"],["を"],["保たせる","たもたせる"],["。"],["これ"],["が"],["知識","ちしき"],["の"],["すぐれた"],["所","ところ"],["で"],["ある"],["。"]]},{"verse":13,"text":"神,かみのみわざを考,かんがえみよ。神,かみの曲,まげられたものを、だれがまっすぐにすることができるか。","tok":[["神","かみ"],["のみ"],["わざ"],["を"],["考","かんがえ"],["み"],["よ"],["。"],["神","かみ"],["の"],["曲げられた","まげられた"],["もの"],["を"],["、"],["だれ"],["が"],["まっすぐ"],["に"],["する"],["こと"],["が"],["できる"],["か"],["。"]]},{"verse":14,"text":"順境,じゅんきょうの日,ひには楽,たのしめ、逆境,ぎゃっきょうの日,ひには考,かんがえよ。神,かみは人,ひとに将来,しょうらいどういう事,ことがあるかを、知,しらせないために、彼,かれとこれとを等,ひとしく造,つくられたのである。","tok":[["順境","じゅんきょう"],["の"],["日","ひ"],["に"],["は"],["楽め","たのしめ"],["、"],["逆境","ぎゃっきょう"],["の"],["日","ひ"],["に"],["は"],["考","かんがえ"],["よ"],["。"],["神","かみ"],["は"],["人","ひと"],["に"],["将来","しょうらい"],["どういう"],["事","こと"],["が"],["ある"],["か"],["を"],["、"],["知らせない","しらせない"],["ため"],["に"],["、"],["彼","かれ"],["と"],["これ"],["と"],["を"],["等く","ひとしく"],["造られた","つくられた"],["ので"],["ある"],["。"]]},{"verse":15,"text":"わたしはこのむなしい人生,じんせいにおいて、もろもろの事,ことを見,みた。そこには義人,ぎじんがその義,ぎによって滅,ほろびることがあり、悪人,あくにんがその悪,あくによって長生,ながいきすることがある。","tok":[["わたし"],["は"],["この"],["むなしい"],["人生","じんせい"],["に"],["おいて"],["、"],["もろもろ"],["の"],["事","こと"],["を"],["見た","みた"],["。"],["そこ"],["に"],["は"],["義人","ぎじん"],["が"],["その"],["義","ぎ"],["によって"],["滅びる","ほろびる"],["こと"],["が"],["あり"],["、"],["悪人","あくにん"],["が"],["その"],["悪","あく"],["によって"],["長生き","ながいき"],["する"],["こと"],["が"],["ある"],["。"]]},{"verse":16,"text":"あなたは義,ぎに過,すぎてはならない。また賢,かしこきに過,すぎてはならない。あなたはどうして自分,じぶんを滅,ほろぼしてよかろうか。","tok":[["あなた"],["は"],["義","ぎ"],["に"],["過て","すぎて"],["は"],["ならない"],["。"],["また"],["賢しこき","かしこき"],["に"],["過て","すぎて"],["は"],["ならない"],["。"],["あなた"],["は"],["どう"],["して"],["自分","じぶん"],["を"],["滅ぼして","ほろぼして"],["よかろう"],["か"],["。"]]},{"verse":17,"text":"悪,あくに過,すぎてはならない。また愚,おろかであってはならない。あなたはどうして、自分,じぶんの時,ときのこないのに、死,しんでよかろうか。","tok":[["悪","あく"],["に"],["過て","すぎて"],["は"],["ならない"],["。"],["また"],["愚か","おろか"],["で"],["あって"],["は"],["ならない"],["。"],["あなた"],["は"],["どう"],["して"],["、"],["自分","じぶん"],["の"],["時","とき"],["の"],["こない"],["のに"],["、"],["死んで","しんで"],["よかろう"],["か"],["。"]]},{"verse":18,"text":"あなたがこれを執,とるのはよい、また彼,かれから手,てを引,ひいてはならない。神,かみをかしこむ者,ものは、このすべてからのがれ出,でるのである。","tok":[["あなた"],["が"],["これ"],["を"],["執る","とる"],["の"],["は"],["よい"],["、"],["また"],["彼","かれ"],["から"],["手","て"],["を"],["引いて","ひいて"],["は"],["ならない"],["。"],["神","かみ"],["を"],["かしこむ"],["者","もの"],["は"],["、"],["この"],["すべて"],["から"],["のがれ出る","のがれでる"],["ので"],["ある"],["。"]]},{"verse":19,"text":"知恵,ちえが知者,ちしゃを強,つよくするのは、十人,にんのつかさが町,まちにおるのにまさる。","tok":[["知恵","ちえ"],["が"],["知者","ちしゃ"],["を"],["強く","つよく"],["する"],["の"],["は"],["、"],["十人","にん"],["の"],["つかさ"],["が"],["町","まち"],["に"],["おる"],["のに"],["まさる"],["。"]]},{"verse":20,"text":"善,ぜんを行,おこない、罪,つみを犯,おかさない正,ただしい人,ひとは世,よにいない。","tok":[["善","ぜん"],["を"],["行ない","おこない"],["、"],["罪","つみ"],["を"],["犯さない","おかさない"],["正い","ただしい"],["人","ひと"],["は"],["世","よ"],["に"],["いない"],["。"]]},{"verse":21,"text":"人,ひとの語,かたるすべての事,ことに心,こころをとめてはならない。これはあなたが、自分,じぶんのしもべのあなたをのろう言葉,ことばを聞,きかないためである。","tok":[["人","ひと"],["の"],["語る","かたる"],["すべて"],["の"],["事","こと"],["に"],["心","こころ"],["を"],["とめて"],["は"],["ならない"],["。"],["これ"],["は"],["あなた"],["が"],["、"],["自分","じぶん"],["の"],["しもべ"],["の"],["あなた"],["を"],["のろう"],["言葉","ことば"],["を"],["聞かない","きかない"],["ため"],["で"],["ある"],["。"]]},{"verse":22,"text":"あなたもまた、しばしば他人,たにんをのろったのを自分,じぶんの心,こころに知,しっているからである。","tok":[["あなた"],["も"],["また"],["、"],["しばしば"],["他人","たにん"],["を"],["のろった"],["の"],["を"],["自分","じぶん"],["の"],["心","こころ"],["に"],["知って","しって"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":23,"text":"わたしは知恵,ちえをもってこのすべての事,ことを試,こころみて、「わたしは知者,ちしゃとなろう」と言,いったが、遠,とおく及,およばなかった。","tok":[["わたし"],["は"],["知恵","ちえ"],["を"],["もって"],["この"],["すべて"],["の"],["事","こと"],["を"],["試みて","こころみて"],["、"],["「"],["わたし"],["は"],["知者","ちしゃ"],["と"],["なろう"],["」"],["と"],["言った","いった"],["が"],["、"],["遠く","とおく"],["及ばなかった","およばなかった"],["。"]]},{"verse":24,"text":"物事,ものごとの理,りは遠,とおく、また、はなはだ深,ふかい。だれがこれを見,みいだすことができよう。","tok":[["物事","ものごと"],["の"],["理","り"],["は"],["遠く","とおく"],["、"],["また"],["、"],["はなはだ"],["深い","ふかい"],["。"],["だれ"],["が"],["これ"],["を"],["見いだす","みいだす"],["こと"],["が"],["できよう"],["。"]]},{"verse":25,"text":"わたしは、心,こころを転,てんじて、物,ものを知,しり、事,ことを探,さぐり、知恵,ちえと道理,どうりを求,もとめようとし、また悪,あくの愚,おろかなこと、愚痴,ぐちの狂気,きょうきであることを知,しろうとした。","tok":[["わたし"],["は"],["、"],["心","こころ"],["を"],["転じて","てんじて"],["、"],["物","もの"],["を"],["知り","しり"],["、"],["事","こと"],["を"],["探ぐり","さぐり"],["、"],["知恵","ちえ"],["と"],["道理","どうり"],["を"],["求めよう","もとめよう"],["と"],["し"],["、"],["また"],["悪","あく"],["の"],["愚か","おろか"],["な"],["こと"],["、"],["愚痴","ぐち"],["の"],["狂気","きょうき"],["で"],["ある"],["こと"],["を"],["知ろう","しろう"],["と"],["した"],["。"]]},{"verse":26,"text":"わたしは、その心,こころが、わなと網,あみのような女,おんな、その手,てが、かせのような女,おんなは、死,しよりも苦,にがい者,ものであることを見,みいだした。神,かみを喜,よろこばす者,ものは彼女,かのじょからのがれる。しかし罪,つみびとは彼女,かのじょに捕,とらえられる。","tok":[["わたし"],["は"],["、"],["その"],["心","こころ"],["が"],["、"],["わな"],["と"],["網","あみ"],["の"],["よう"],["な"],["女","おんな"],["、"],["その"],["手","て"],["が"],["、"],["かせ"],["の"],["よう"],["な"],["女","おんな"],["は"],["、"],["死","し"],["より"],["も"],["苦い","にがい"],["者","もの"],["で"],["ある"],["こと"],["を"],["見いだした","みいだした"],["。"],["神","かみ"],["を"],["喜こばす","よろこばす"],["者","もの"],["は"],["彼女","かのじょ"],["から"],["のがれる"],["。"],["しかし"],["罪びと","つみびと"],["は"],["彼女","かのじょ"],["に"],["捕らえられる","とらえられる"],["。"]]},{"verse":27,"text":"伝道者,でんどうしゃは言,いう、見,みよ、その数,かずを知,しろうとして、いちいち数,かぞえて、わたしが得,えたものはこれである。","tok":[["伝道者","でんどうしゃ"],["は"],["言う","いう"],["、"],["見よ","みよ"],["、"],["その"],["数","かず"],["を"],["知ろう","しろう"],["として"],["、"],["いちいち"],["数えて","かぞえて"],["、"],["わたし"],["が"],["得た","えた"],["もの"],["は"],["これ"],["で"],["ある"],["。"]]},{"verse":28,"text":"わたしはなおこれを求,もとめたけれども、得,えなかった。わたしは千人,にんのうちにひとりの男子,だんしを得,えたけれども、そのすべてのうちに、ひとりの女子,じょしをも得,えなかった。","tok":[["わたし"],["は"],["なお"],["これ"],["を"],["求めた","もとめた"],["けれど"],["も"],["、"],["得なかった","えなかった"],["。"],["わたし"],["は"],["千人","にん"],["の"],["うち"],["に"],["ひとり"],["の"],["男子","だんし"],["を"],["得た","えた"],["けれど"],["も"],["、"],["その"],["すべて"],["の"],["うち"],["に"],["、"],["ひとり"],["の"],["女子","じょし"],["を"],["も"],["得なかった","えなかった"],["。"]]},{"verse":29,"text":"見,みよ、わたしが得,えた事,ことは、ただこれだけである。すなわち、神,かみは人,ひとを正,ただしい者,ものに造,つくられたけれども、人,ひとは多,おおくの計略,けいりゃくを考,かんがえ出,だした事,ことである。","tok":[["見よ","みよ"],["、"],["わたし"],["が"],["得た","えた"],["事","こと"],["は"],["、"],["ただ"],["これ"],["だけ"],["で"],["ある"],["。"],["すなわち"],["、"],["神","かみ"],["は"],["人","ひと"],["を"],["正い","ただしい"],["者","もの"],["に"],["造られた","つくられた"],["けれど"],["も"],["、"],["人","ひと"],["は"],["多く","おおく"],["の"],["計略","けいりゃく"],["を"],["考","かんがえ"],["出した","だした"],["事","こと"],["で"],["ある"],["。"]]}]
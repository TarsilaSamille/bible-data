[{"verse":1,"text":"ダビデの子,こ、エルサレムの王,おうである伝道者,でんどうしゃの言葉,ことば。","tok":[["ダビデ"],["の"],["子","こ"],["、"],["エルサレム"],["の"],["王","おう"],["で"],["ある"],["伝道者","でんどうしゃ"],["の"],["言葉","ことば"],["。"]]},{"verse":2,"text":"伝道者,でんどうしゃは言,いう、空,くうの空,くう、空,くうの空,くう、いっさいは空,くうである。","tok":[["伝道者","でんどうしゃ"],["は"],["言う","いう"],["、"],["空","くう"],["の"],["空","く"],["う"],["、"],["空","くう"],["の"],["空","く"],["う"],["、"],["いっさい"],["は"],["空","く"],["うで"],["ある"],["。"]]},{"verse":3,"text":"日,ひの下,したで人,ひとが労,ろうするすべての労苦,ろうくは、その身,みになんの益,えきがあるか。","tok":[["日","ひ"],["の"],["下","した"],["で"],["人","ひと"],["が"],["労する","ろうする"],["すべて"],["の"],["労苦","ろうく"],["は"],["、"],["その"],["身","み"],["に"],["なん"],["の"],["益","えき"],["が"],["ある"],["か"],["。"]]},{"verse":4,"text":"世,よは去,さり、世,よはきたる。しかし地,ちは永遠,えいえんに変,かわらない。","tok":[["世","よ"],["は"],["去り","さり"],["、"],["世","よ"],["は"],["きたる"],["。"],["しかし"],["地","ち"],["は"],["永遠","えいえん"],["に"],["変わらない","かわらない"],["。"]]},{"verse":5,"text":"日,ひはいで、日,ひは没,ぼっし、その出,でた所,ところに急,いそぎ行,いく。","tok":[["日","ひ"],["はい"],["で"],["、"],["日","ひ"],["は"],["没し","ぼっし"],["、"],["その"],["出た","でた"],["所","ところ"],["に"],["急ぎ","いそぎ"],["行く","いく"],["。"]]},{"verse":6,"text":"風,かぜは南,みなみに吹,ふき、また転,てんじて、北,きたに向,むかい、めぐりにめぐって、またそのめぐる所,ところに帰,かえる。","tok":[["風","かぜ"],["は"],["南","みなみ"],["に"],["吹","ふき"],["、"],["また"],["転じて","てんじて"],["、"],["北","きた"],["に"],["向","むかい"],["、"],["めぐり"],["に"],["めぐって"],["、"],["また"],["その"],["めぐる"],["所","ところ"],["に"],["帰える","かえる"],["。"]]},{"verse":7,"text":"川,かわはみな、海,うみに流,ながれ入,いる、しかし海,うみは満,みちることがない。川,かわはその出,でてきた所,ところにまた帰,かえって行,いく。","tok":[["川","かわ"],["は"],["みな"],["、"],["海","うみ"],["に"],["流れ入る","ながれいる"],["、"],["しかし"],["海","うみ"],["は"],["満ちる","みちる"],["こと"],["が"],["ない"],["。"],["川","かわ"],["は"],["その"],["出て","でて"],["きた"],["所","ところ"],["に"],["また"],["帰えって","かえって"],["行く","いく"],["。"]]},{"verse":8,"text":"すべての事,ことは人,ひとをうみ疲,つかれさせる、人,ひとはこれを言,いいつくすことができない。目,めは見,みることに飽,あきることがなく、耳,みみは聞,きくことに満足,まんぞくすることがない。","tok":[["すべて"],["の"],["事","こと"],["は"],["人","ひと"],["を"],["うみ疲れさせる","うみつかれさせる"],["、"],["人","ひと"],["は"],["これ"],["を"],["言い","いい"],["つくす"],["こと"],["が"],["できない"],["。"],["目","め"],["は"],["見る","みる"],["こと"],["に"],["飽きる","あきる"],["こと"],["が"],["なく"],["、"],["耳","みみ"],["は"],["聞く","きく"],["こと"],["に"],["満足","まんぞく"],["する"],["こと"],["が"],["ない"],["。"]]},{"verse":9,"text":"先,さきにあったことは、また後,のちにもある、先,さきになされた事,ことは、また後,のちにもなされる。日,ひの下,したには新,あたらしいものはない。","tok":[["先","さき"],["に"],["あった"],["こと"],["は"],["、"],["また"],["後","のち"],["に"],["も"],["ある"],["、"],["先","さき"],["に"],["なされた"],["事","こと"],["は"],["、"],["また"],["後","のち"],["に"],["も"],["なされる"],["。"],["日","ひ"],["の"],["下","した"],["に"],["は"],["新らしい","あたらしい"],["もの"],["は"],["ない"],["。"]]},{"verse":10,"text":"「見,みよ、これは新,あたらしいものだ」と言,いわれるものがあるか、それはわれわれの前,まえにあった世々,よよに、すでにあったものである。","tok":[["「"],["見よ","みよ"],["、"],["これ"],["は"],["新らしい","あたらしい"],["もの"],["だ"],["」"],["と"],["言われる","いわれる"],["もの"],["が"],["ある"],["か"],["、"],["それ"],["は"],["われわれ"],["の"],["前","まえ"],["に"],["あった"],["世々","よよ"],["に"],["、"],["すでに"],["あった"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"前,まえの者,もののことは覚,おぼえられることがない、また、きたるべき後,のちの者,もののことも、後,のちに起,おこる者,ものはこれを覚,おぼえることがない。","tok":[["前","まえ"],["の"],["者","もの"],["の"],["こと"],["は"],["覚えられる","おぼえられる"],["こと"],["が"],["ない"],["、"],["また"],["、"],["きたるべき"],["後","のち"],["の"],["者","もの"],["の"],["こと"],["も"],["、"],["後","のち"],["に"],["起こる","おこる"],["者","もの"],["は"],["これ"],["を"],["覚える","おぼえる"],["こと"],["が"],["ない"],["。"]]},{"verse":12,"text":"伝道者,でんどうしゃであるわたしはエルサレムで、イスラエルの王,おうであった。","tok":[["伝道者","でんどうしゃ"],["で"],["ある"],["わたし"],["は"],["エルサレム"],["で"],["、"],["イスラエル"],["の"],["王","おう"],["で"],["あった"],["。"]]},{"verse":13,"text":"わたしは心,こころをつくし、知恵,ちえを用,もちいて、天,あめが下,したに行,おこなわれるすべてのことを尋,たずね、また調,しらべた。これは神,かみが、人,ひとの子,こらに与,あたえて、ほねおらせられる苦,くるしい仕事,しごとである。","tok":[["わたし"],["は"],["心","こころ"],["を"],["つくし"],["、"],["知恵","ちえ"],["を"],["用いて","もちいて"],["、"],["天","あ"],["め"],["が"],["下","した"],["に"],["行なわれる","おこなわれる"],["すべて"],["の"],["こと"],["を"],["尋ね","たずね"],["、"],["また"],["調べた","しらべた"],["。"],["これ"],["は"],["神","かみ"],["が"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["与","あたえ"],["て"],["、"],["ほねおらせられる"],["苦しい","くるしい"],["仕事","しごと"],["で"],["ある"],["。"]]},{"verse":14,"text":"わたしは日,ひの下,したで人,ひとが行,おこなうすべてのわざを見,みたが、みな空,くうであって風,かぜを捕,とらえるようである。","tok":[["わたし"],["は"],["日","ひ"],["の"],["下","した"],["で"],["人","ひと"],["が"],["行なう","おこなう"],["すべて"],["の"],["わざ"],["を"],["見た","みた"],["が"],["、"],["みな"],["空","く"],["うで"],["あって"],["風","かぜ"],["を"],["捕らえる","とらえる"],["よう"],["で"],["ある"],["。"]]},{"verse":15,"text":"曲,まがったものは、まっすぐにすることができない、欠,かけたものは数,かぞえることができない。","tok":[["曲がった","まがった"],["もの"],["は"],["、"],["まっすぐ"],["に"],["する"],["こと"],["が"],["できない"],["、"],["欠けた","かけた"],["もの"],["は"],["数える","かぞえる"],["こと"],["が"],["できない"],["。"]]},{"verse":16,"text":"わたしは心,こころの中,なかに語,かたって言,いった、「わたしは、わたしより先,さきにエルサレムを治,おさめたすべての者,ものにまさって、多,おおくの知恵,ちえを得,えた。わたしの心,こころは知恵,ちえと知識,ちしきを多,おおく得,えた」。","tok":[["わたし"],["は"],["心","こころ"],["の"],["中","なか"],["に"],["語って","かたって"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["わたし"],["より"],["先","さき"],["に"],["エルサレム"],["を"],["治めた","おさめた"],["すべて"],["の"],["者","もの"],["に"],["まさって"],["、"],["多く","おおく"],["の"],["知恵","ちえ"],["を"],["得た","えた"],["。"],["わたし"],["の"],["心","こころ"],["は"],["知恵","ちえ"],["と"],["知識","ちしき"],["を"],["多く","おおく"],["得た","えた"],["」"],["。"]]},{"verse":17,"text":"わたしは心,こころをつくして知恵,ちえを知,しり、また狂気,きょうきと愚痴,ぐちとを知,しろうとしたが、これもまた風,かぜを捕,とらえるようなものであると悟,さとった。","tok":[["わたし"],["は"],["心","こころ"],["を"],["つくして"],["知恵","ちえ"],["を"],["知り","しり"],["、"],["また"],["狂気","きょうき"],["と"],["愚痴","ぐち"],["と"],["を"],["知ろう","しろう"],["と"],["した"],["が"],["、"],["これ"],["も"],["また"],["風","かぜ"],["を"],["捕らえる","とらえる"],["よう"],["な"],["もの"],["で"],["ある"],["と"],["悟った","さとった"],["。"]]},{"verse":18,"text":"それは知恵,ちえが多,おおければ悩,なやみが多,おおく、知識,ちしきを増,ます者,ものは憂,うれいを増,ますからである。","tok":[["それ"],["は"],["知恵","ちえ"],["が"],["多ければ","おおければ"],["悩み","なやみ"],["が"],["多く","おおく"],["、"],["知識","ちしき"],["を"],["増す","ます"],["者","もの"],["は"],["憂","うれい"],["を"],["増す","ます"],["から"],["で"],["ある"],["。"]]}]
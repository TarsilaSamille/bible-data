[{"verse":1,"text":"[2]神,かみの前,まえで軽々,かるがるしく口,くちをひらき、また言葉,ことばを出,だそうと、心,こころにあせってはならない。神,かみは天,てんにいまし、あなたは地,ちにおるからである。それゆえ、あなたは言葉,ことばを少,すくなくせよ。","tok":[["["],["2"],["]"],["神","かみ"],["の"],["前","まえ"],["で"],["軽々しく","かるがるしく"],["口","くち"],["を"],["ひらき"],["、"],["また"],["言葉","ことば"],["を"],["出そう","だそう"],["と"],["、"],["心","こころ"],["に"],["あせって"],["は"],["ならない"],["。"],["神","かみ"],["は"],["天","てん"],["に"],["いまし"],["、"],["あなた"],["は"],["地","ち"],["に"],["おる"],["から"],["で"],["ある"],["。"],["それ"],["ゆえ"],["、"],["あなた"],["は"],["言葉","ことば"],["を"],["少く","すくなく"],["せよ"],["。"]]},{"verse":2,"text":"[3]夢,ゆめは仕事,しごとの多,おおいことによってきたり、愚,おろかなる者,ものの声,こえは言葉,ことばの多,おおいことによって知,しられる。","tok":[["["],["3"],["]"],["夢","ゆめ"],["は"],["仕事","しごと"],["の"],["多い","おおい"],["こと"],["によって"],["き"],["たり"],["、"],["愚か","おろか"],["なる"],["者","もの"],["の"],["声","こえ"],["は"],["言葉","ことば"],["の"],["多い","おおい"],["こと"],["によって"],["知られる","しられる"],["。"]]},{"verse":3,"text":"[4]あなたは神,かみに誓,ちかいをなすとき、それを果,はたすことを延,のばしてはならない。神,かみは愚,おろかな者,ものを喜,よろこばれないからである。あなたの誓,ちかったことを必,かならず果,はたせ。","tok":[["["],["4"],["]"],["あなた"],["は"],["神","かみ"],["に"],["誓い","ちかい"],["を"],["なす"],["とき"],["、"],["それ"],["を"],["果たす","はたす"],["こと"],["を"],["延ばして","のばして"],["は"],["ならない"],["。"],["神","かみ"],["は"],["愚か","おろか"],["な"],["者","もの"],["を"],["喜こばれない","よろこばれない"],["から"],["で"],["ある"],["。"],["あなた"],["の"],["誓った","ちかった"],["こと"],["を"],["必","かならず"],["果たせ","はたせ"],["。"]]},{"verse":4,"text":"[5]あなたが誓,ちかいをして、それを果,はたさないよりは、むしろ誓,ちかいをしないほうがよい。","tok":[["["],["5"],["]"],["あなた"],["が"],["誓い","ちかい"],["を"],["して"],["、"],["それ"],["を"],["果たさない","はたさない"],["より"],["は"],["、"],["むしろ"],["誓い","ちかい"],["を"],["しない"],["ほう"],["が"],["よい"],["。"]]},{"verse":5,"text":"[6]あなたの口,くちが、あなたに罪,つみを犯,おかさせないようにせよ。また使者,ししゃの前,まえにそれは誤,あやまりであったと言,いってはならない。どうして、神,かみがあなたの言葉,ことばを怒,いかり、あなたの手,てのわざを滅,ほろぼしてよかろうか。","tok":[["["],["6"],["]"],["あなた"],["の"],["口","くち"],["が"],["、"],["あなた"],["に"],["罪","つみ"],["を"],["犯させない","おかさせない"],["よう"],["に"],["せよ"],["。"],["また"],["使者","ししゃ"],["の"],["前","まえ"],["に"],["それ"],["は"],["誤り","あやまり"],["で"],["あった"],["と"],["言って","いって"],["は"],["ならない"],["。"],["どう"],["して"],["、"],["神","かみ"],["が"],["あなた"],["の"],["言葉","ことば"],["を"],["怒り","いかり"],["、"],["あなた"],["の"],["手","て"],["の"],["わざ"],["を"],["滅ぼして","ほろぼして"],["よかろう"],["か"],["。"]]},{"verse":6,"text":"[7]夢,ゆめが多,おおければ空,くうなる言葉,ことばも多,おおい。しかし、あなたは神,かみを恐,おそれよ。","tok":[["["],["7"],["]"],["夢","ゆめ"],["が"],["多ければ","おおければ"],["空","く"],["うなる"],["言葉","ことば"],["も"],["多い","おおい"],["。"],["しかし"],["、"],["あなた"],["は"],["神","かみ"],["を"],["恐れよ","おそれよ"],["。"]]},{"verse":7,"text":"[8]あなたは国,くにのうちに貧,まずしい者,ものをしえたげ、公道,こうどうと正義,せいぎを曲,まげることのあるのを見,みても、その事,ことを怪,あやしんではならない。それは位,くらいの高,たかい人,ひとよりも、さらに高,たかい者,ものがあって、その人,ひとをうかがうからである。そしてそれらよりもなお高,たかい者,ものがある。","tok":[["["],["8"],["]"],["あなた"],["は"],["国","くに"],["の"],["うち"],["に"],["貧しい","まずしい"],["者","もの"],["を"],["し"],["えたげ"],["、"],["公道","こうどう"],["と"],["正義","せいぎ"],["を"],["曲げる","まげる"],["こと"],["の"],["ある"],["の"],["を"],["見て","みて"],["も"],["、"],["その"],["事","こと"],["を"],["怪しんで","あやしんで"],["は"],["ならない"],["。"],["それ"],["は"],["位","くらい"],["の"],["高い","たかい"],["人","ひと"],["より"],["も"],["、"],["さらに"],["高い","たかい"],["者","もの"],["が"],["あって"],["、"],["その"],["人","ひと"],["を"],["うかがう"],["から"],["で"],["ある"],["。"],["そして"],["それ"],["ら"],["より"],["も"],["なお"],["高かい","たかい"],["者","もの"],["が"],["ある"],["。"]]},{"verse":8,"text":"[9]しかし、要,ようするに耕作,こうさくした田畑,たはたをもつ国,くにには王,おうは利益,りえきである。","tok":[["["],["9"],["]"],["しかし"],["、"],["要する","ようする"],["に"],["耕作","こうさく"],["した"],["田畑","たはた"],["を"],["もつ"],["国","くに"],["に"],["は"],["王","おう"],["は"],["利益","りえき"],["で"],["ある"],["。"]]},{"verse":9,"text":"[10]金銭,きんせんを好,このむ者,ものは金銭,きんせんをもって満足,まんぞくしない。富,とみを好,このむ者,ものは富,とみを得,えて満足,まんぞくしない。これもまた空,くうである。","tok":[["["],["10"],["]"],["金銭","きんせん"],["を"],["好む","このむ"],["者","もの"],["は"],["金銭","きんせん"],["を"],["もって"],["満足","まんぞく"],["しない"],["。"],["富","とみ"],["を"],["好む","このむ"],["者","もの"],["は"],["富","とみ"],["を"],["得て","えて"],["満足","まんぞく"],["しない"],["。"],["これ"],["も"],["また"],["空","く"],["うで"],["ある"],["。"]]},{"verse":10,"text":"[11]財産,ざいさんが増,ませば、これを食,くう者,ものも増,ます。その持,もち主,ぬしは目,めにそれを見,みるだけで、なんの益,えきがあるか。","tok":[["["],["11"],["]"],["財産","ざいさん"],["が"],["増せば","ませば"],["、"],["これ"],["を"],["食う","くう"],["者","もの"],["も"],["増す","ます"],["。"],["その"],["持主","もちぬし"],["は"],["目","め"],["に"],["それ"],["を"],["見る","みる"],["だけ"],["で"],["、"],["なん"],["の"],["益","えき"],["が"],["ある"],["か"],["。"]]},{"verse":11,"text":"[12]働,はたらく者,ものは食,たべることが少,すくなくても多,おおくても、快,こころよく眠,ねむる。しかし飽,あき足,たりるほどの富,とみは、彼,かれに眠,ねむることをゆるさない。","tok":[["["],["12"],["]"],["働く","はたらく"],["者","もの"],["は"],["食べる","たべる"],["こと"],["が"],["少くて","すくなくて"],["も"],["多くて","おおくて"],["も"],["、"],["快よく","こころよく"],["眠る","ねむる"],["。"],["しかし"],["飽き足りる","あきたりる"],["ほど"],["の"],["富","とみ"],["は"],["、"],["彼","かれ"],["に"],["眠る","ねむる"],["こと"],["を"],["ゆるさない"],["。"]]},{"verse":12,"text":"[13]わたしは日,ひの下,したに悲,かなしむべき悪,あくのあるのを見,みた。すなわち、富,とみはこれをたくわえるその持,もち主,ぬしに害,がいを及,およぼすことである。","tok":[["["],["13"],["]"],["わたし"],["は"],["日","ひ"],["の"],["下","した"],["に"],["悲しむべき","かなしむべき"],["悪","あく"],["の"],["ある"],["の"],["を"],["見た","みた"],["。"],["すなわち"],["、"],["富","とみ"],["は"],["これ"],["を"],["たくわえる"],["その"],["持主","もちぬし"],["に"],["害","がい"],["を"],["及ぼす","およぼす"],["こと"],["で"],["ある"],["。"]]},{"verse":13,"text":"[14]またその富,とみは不幸,ふこうな出来事,できごとによってうせ行,いくことである。それで、その人,ひとが子,こをもうけても、彼,かれの手,てには何,なにも残,のこらない。","tok":[["["],["14"],["]"],["また"],["その"],["富","とみ"],["は"],["不幸","ふこう"],["な"],["出来事","できごと"],["によって"],["うせ"],["行く","いく"],["こと"],["で"],["ある"],["。"],["それ"],["で"],["、"],["その"],["人","ひと"],["が"],["子","こ"],["を"],["もうけて"],["も"],["、"],["彼","かれ"],["の"],["手","て"],["に"],["は"],["何に","なに"],["も"],["残らない","のこらない"],["。"]]},{"verse":14,"text":"[15]彼,かれは母,ははの胎,たいから出,でてきたように、すなわち裸,はだかで出,でてきたように帰,かえって行,いく。彼,かれはその労苦,ろうくによって得,えた何,なに物,ものをもその手,てに携,たずさえ行,いくことができない。","tok":[["["],["15"],["]"],["彼","かれ"],["は"],["母","はは"],["の"],["胎","たいか"],["ら"],["出て","でて"],["きた"],["よう"],["に"],["、"],["すなわち"],["裸","はだか"],["で"],["出て","でて"],["きた"],["よう"],["に"],["帰えって","かえって"],["行く","いく"],["。"],["彼","かれ"],["は"],["その"],["労苦","ろうく"],["によって"],["得た","えた"],["何","な"],["に"],["物","もの"],["を"],["も"],["その"],["手","て"],["に"],["携え","たずさえ"],["行く","いく"],["こと"],["が"],["できない"],["。"]]},{"verse":15,"text":"[16]人,ひとは全,まったくその来,きたように、また去,さって行,いかなければならない。これもまた悲,かなしむべき悪,あくである。風,かぜのために労,ろうする者,ものになんの益,えきがあるか。","tok":[["["],["16"],["]"],["人","ひと"],["は"],["全く","まったく"],["その"],["来た","きた"],["よう"],["に"],["、"],["また"],["去て","さって"],["行かなければ","いかなければ"],["ならない"],["。"],["これ"],["も"],["また"],["悲しむべき","かなしむべき"],["悪くで","あくで"],["ある"],["。"],["風","かぜ"],["の"],["ため"],["に"],["労する","ろうする"],["者","もの"],["に"],["なん"],["の"],["益","えき"],["が"],["ある"],["か"],["。"]]},{"verse":16,"text":"[17]人,ひとは一生,いっしょう、暗,くらやみと、悲,かなしみと、多,おおくの悩,なやみと、病,やまいと、憤,いきどおりの中,なかにある。","tok":[["["],["17"],["]"],["人","ひと"],["は"],["一生","いっしょう"],["、"],["暗やみ","くらやみ"],["と"],["、"],["悲しみ","かなしみ"],["と"],["、"],["多く","おおく"],["の"],["悩み","なやみ"],["と"],["、"],["病","やまい"],["と"],["、"],["憤り","いきどおり"],["の"],["中","なか"],["に"],["ある"],["。"]]},{"verse":17,"text":"[18]見,みよ、わたしが見,みたところの善,ぜんかつ美,びなる事,ことは、神,かみから賜,たまわった短,みじかい一生,いっしょうの間,あいだ、食,くい、飲,のみ、かつ日,ひの下,したで労,ろうするすべての労苦,ろうくによって、楽,たのしみを得,える事,ことである。これがその分,ぶんだからである。","tok":[["["],["18"],["]"],["見よ","みよ"],["、"],["わたし"],["が"],["見た","みた"],["ところ"],["の"],["善","ぜん"],["かつ"],["美","び"],["なる"],["事","こと"],["は"],["、"],["神","かみ"],["から"],["賜わった","たまわった"],["短かい","みじかい"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["食い","くい"],["、"],["飲み","のみ"],["、"],["かつ"],["日","ひ"],["の"],["下","した"],["で"],["労する","ろうする"],["すべて"],["の"],["労苦","ろうく"],["によって"],["、"],["楽み","たのしみ"],["を"],["得る","える"],["事","こと"],["で"],["ある"],["。"],["これ"],["が"],["その"],["分","ぶん"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":18,"text":"[19]また神,かみはすべての人,ひとに富,とみと宝,たからと、それを楽,たのしむ力,ちからを与,あたえ、またその分,ぶんを取,とらせ、その労苦,ろうくによって楽,たのしみを得,えさせられる。これが神,かみの賜物,たまものである。","tok":[["["],["19"],["]"],["また"],["神","かみ"],["は"],["すべて"],["の"],["人","ひと"],["に"],["富","とみ"],["と"],["宝","たから"],["と"],["、"],["それ"],["を"],["楽しむ","たのしむ"],["力","ちから"],["を"],["与","あたえ"],["、"],["また"],["その"],["分","ぶん"],["を"],["取らせ","とらせ"],["、"],["その"],["労苦","ろうく"],["によって"],["楽み","たのしみ"],["を"],["得させられる","えさせられる"],["。"],["これ"],["が"],["神","かみ"],["の"],["賜物","たまもの"],["で"],["ある"],["。"]]},{"verse":19,"text":"[20]このような人,ひとは自分,じぶんの生,いきる日,ひのことを多,おおく思,おもわない。神,かみは喜,よろこびをもって彼,かれの心,こころを満,みたされるからである。","tok":[["["],["20"],["]"],["この"],["よう"],["な"],["人","ひと"],["は"],["自分","じぶん"],["の"],["生きる","いきる"],["日","ひ"],["の"],["こと"],["を"],["多く","おおく"],["思わない","おもわない"],["。"],["神","かみ"],["は"],["喜こび","よろこび"],["を"],["もって"],["彼","かれ"],["の"],["心","こころ"],["を"],["満たされる","みたされる"],["から"],["で"],["ある"],["。"]]}]
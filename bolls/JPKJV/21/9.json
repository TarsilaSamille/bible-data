[{"verse":1,"text":"わたしはこのすべての事,ことに心,こころを用,もちいて、このすべての事,ことを明,あきらかにしようとした。すなわち正,ただしい者,ものと賢,かしこい者,もの、および彼,かれらのわざが、神,かみの手,てにあることを明,あきらかにしようとした。愛,あいするか憎,にくむかは人,ひとにはわからない。彼,かれらの前,まえにあるすべてのことは空,くうである。","tok":[["わたし"],["は"],["この"],["すべて"],["の"],["事","こと"],["に"],["心","こころ"],["を"],["用いて","もちいて"],["、"],["この"],["すべて"],["の"],["事","こと"],["を"],["明か","あきらか"],["に"],["しよう"],["と"],["した"],["。"],["すなわち"],["正い","ただしい"],["者","もの"],["と"],["賢しこい","かしこい"],["者","もの"],["、"],["および"],["彼","かれ"],["ら"],["の"],["わざ"],["が"],["、"],["神","かみ"],["の"],["手","て"],["に"],["ある"],["こと"],["を"],["明か","あきらか"],["に"],["しよう"],["と"],["した"],["。"],["愛する","あいする"],["か"],["憎む","にくむ"],["か"],["は"],["人","ひと"],["に"],["は"],["わからない"],["。"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["ある"],["すべて"],["の"],["こと"],["は"],["空","く"],["うで"],["ある"],["。"]]},{"verse":2,"text":"すべての人,ひとに臨,のぞむところは、みな同様,どうようである。正,ただしい者,ものにも正,ただしくない者,ものにも、善良,ぜんりょうな者,ものにも悪,わるい者,ものにも、清,きよい者,ものにも汚,けがれた者,ものにも、犠牲,ぎせいをささげる者,ものにも、犠牲,ぎせいをささげない者,ものにも、その臨,のぞむところは同様,どうようである。善良,ぜんりょうな人,ひとも罪,つみびとも異,ことなることはない。誓,ちかいをなす者,ものも、誓,ちかいをなすことを恐,おそれる者,ものも異,ことなることはない。","tok":[["すべて"],["の"],["人","ひと"],["に"],["臨む","のぞむ"],["ところ"],["は"],["、"],["みな"],["同様","どうよう"],["で"],["ある"],["。"],["正い","ただしい"],["者","もの"],["に"],["も"],["正く","ただしく"],["ない"],["者","もの"],["に"],["も"],["、"],["善良","ぜんりょう"],["な"],["者","もの"],["に"],["も"],["悪い","わるい"],["者","もの"],["に"],["も"],["、"],["清い","きよい"],["者","もの"],["に"],["も"],["汚","け"],["がれ"],["た"],["者","もの"],["に"],["も"],["、"],["犠牲","ぎせい"],["を"],["ささげる"],["者","もの"],["に"],["も"],["、"],["犠牲","ぎせい"],["を"],["ささげない"],["者","もの"],["に"],["も"],["、"],["その"],["臨む","のぞむ"],["ところ"],["は"],["同様","どうよう"],["で"],["ある"],["。"],["善良","ぜんりょう"],["な"],["人","ひと"],["も"],["罪びと","つみびと"],["も"],["異なる","ことなる"],["こと"],["は"],["ない"],["。"],["誓い","ちかい"],["を"],["なす"],["者","もの"],["も"],["、"],["誓い","ちかい"],["を"],["なす"],["こと"],["を"],["恐れる","おそれる"],["者","もの"],["も"],["異なる","ことなる"],["こと"],["は"],["ない"],["。"]]},{"verse":3,"text":"すべての人,ひとに同一,どういつに臨,のぞむのは、日,ひの下,したに行,おこなわれるすべての事,ことのうちの悪事,あくじである。また人,ひとの心,こころは悪,あくに満,みち、その生,いきている間,あいだは、狂気,きょうきがその心,こころのうちにあり、その後,のちは死者,ししゃのもとに行,いくのである。","tok":[["すべて"],["の"],["人","ひと"],["に"],["同一","どういつ"],["に"],["臨む","のぞむ"],["の"],["は"],["、"],["日","ひ"],["の"],["下","した"],["に"],["行なわれる","おこなわれる"],["すべて"],["の"],["事","こと"],["の"],["うち"],["の"],["悪事","あくじ"],["で"],["ある"],["。"],["また"],["人","ひと"],["の"],["心","こころ"],["は"],["悪","あく"],["に"],["満ち","みち"],["、"],["その"],["生きて","いきて"],["いる"],["間","あいだ"],["は"],["、"],["狂気","きょうき"],["が"],["その"],["心","こころ"],["の"],["うち"],["に"],["あり"],["、"],["その後","そののち"],["は"],["死者","ししゃ"],["の"],["もと"],["に"],["行く","いく"],["ので"],["ある"],["。"]]},{"verse":4,"text":"すべて生,いける者,ものに連,つらなる者,ものには望,のぞみがある。生,いける犬,いぬは、死,しせるししにまさるからである。","tok":[["すべて"],["生ける","いける"],["者","もの"],["に"],["連なる","つらなる"],["者","もの"],["に"],["は"],["望み","のぞみ"],["が"],["ある"],["。"],["生ける","いける"],["犬","いぬ"],["は"],["、"],["死","し"],["せる"],["しし"],["に"],["まさる"],["から"],["で"],["ある"],["。"]]},{"verse":5,"text":"生,いきている者,ものは死,しぬべき事,ことを知,しっている。しかし死者,ししゃは何事,なにごとをも知,しらない、また、もはや報,むくいを受,うけることもない。その記憶,きおくに残,のこる事,ことがらさえも、ついに忘,わすれられる。","tok":[["生きて","いきて"],["いる"],["者","もの"],["は"],["死ぬべき","しぬべき"],["事","こと"],["を"],["知って","しって"],["いる"],["。"],["しかし"],["死者","ししゃ"],["は"],["何事","なにごと"],["を"],["も"],["知らない","しらない"],["、"],["また"],["、"],["もはや"],["報い","むくい"],["を"],["受る","うける"],["こと"],["も"],["ない"],["。"],["その"],["記憶","きおく"],["に"],["残る","のこる"],["事がら","ことがら"],["さえ"],["も"],["、"],["ついに"],["忘られる","わすれられる"],["。"]]},{"verse":6,"text":"その愛,あいも、憎,にくしみも、ねたみも、すでに消,きえうせて、彼,かれらはもはや日,ひの下,したに行,おこなわれるすべての事,ことに、永久,えいきゅうにかかわることがない。","tok":[["その"],["愛","あい"],["も"],["、"],["憎しみ","にくしみ"],["も"],["、"],["ねたみ"],["も"],["、"],["すでに"],["消えうせて","きえうせて"],["、"],["彼","かれ"],["ら"],["は"],["もはや"],["日","ひ"],["の"],["下","した"],["に"],["行なわれる","おこなわれる"],["すべて"],["の"],["事","こと"],["に"],["、"],["永久","えいきゅう"],["に"],["かかわる"],["こと"],["が"],["ない"],["。"]]},{"verse":7,"text":"あなたは行,いって、喜,よろこびをもってあなたのパンを食,たべ、楽,たのしい心,こころをもってあなたの酒,さけを飲,のむがよい。神,かみはすでに、あなたのわざをよみせられたからである。","tok":[["あなた"],["は"],["行って","いって"],["、"],["喜こび","よろこび"],["を"],["もって"],["あなた"],["の"],["パン"],["を"],["食べ","たべ"],["、"],["楽い","たのしい"],["心","こころ"],["を"],["もって"],["あなた"],["の"],["酒","さけ"],["を"],["飲む","のむ"],["が"],["よい"],["。"],["神","かみ"],["は"],["すでに"],["、"],["あなた"],["の"],["わざ"],["を"],["よみせられた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたの衣,ころもを常,つねに白,しろくせよ。あなたの頭,あたまに油,あぶらを絶,たやすな。","tok":[["あなた"],["の"],["衣","ころも"],["を"],["常","つね"],["に"],["白く","しろく"],["せよ"],["。"],["あなた"],["の"],["頭","あたま"],["に"],["油","あぶら"],["を"],["絶やす","たやす"],["な"],["。"]]},{"verse":9,"text":"日,ひの下,したで神,かみから賜,たまわったあなたの空,くうなる命,いのちの日,ひの間,あいだ、あなたはその愛,あいする妻,つまと共,ともに楽,たのしく暮,くらすがよい。これはあなたが世,よにあってうける分,ぶん、あなたが日,ひの下,したで労,ろうする労苦,ろうくによって得,えるものだからである。","tok":[["日","ひ"],["の"],["下","した"],["で"],["神","かみ"],["から"],["賜わった","たまわった"],["あなた"],["の"],["空","く"],["うなる"],["命","いのち"],["の"],["日","ひ"],["の"],["間","あいだ"],["、"],["あなた"],["は"],["その"],["愛する","あいする"],["妻","つま"],["と"],["共","とも"],["に"],["楽く","たのしく"],["暮らす","くらす"],["が"],["よい"],["。"],["これ"],["は"],["あなた"],["が"],["世","よ"],["に"],["あって"],["うける"],["分","ぶん"],["、"],["あなた"],["が"],["日","ひ"],["の"],["下","した"],["で"],["労する","ろうする"],["労苦","ろうく"],["によって"],["得る","える"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"すべてあなたの手,てのなしうる事,ことは、力,ちからをつくしてなせ。あなたの行,いく陰府,よみには、わざも、計略,けいりゃくも、知識,ちしきも、知恵,ちえもないからである。","tok":[["すべて"],["あなた"],["の"],["手","て"],["の"],["なし"],["うる"],["事","こと"],["は"],["、"],["力","ちから"],["を"],["つくして"],["なせ"],["。"],["あなた"],["の"],["行く","いく"],["陰府","よみ"],["に"],["は"],["、"],["わざ"],["も"],["、"],["計略","けいりゃく"],["も"],["、"],["知識","ちしき"],["も"],["、"],["知恵","ちえ"],["も"],["ない"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"わたしはまた日,ひの下,したを見,みたが、必,かならずしも速,はやい者,ものが競走,きょうそうに勝,かつのではなく、強,つよい者,ものが戦,たたかいに勝,かつのでもない。また賢,かしこい者,ものがパンを得,えるのでもなく、さとき者,ものが富,とみを得,えるのでもない。また知識,ちしきある者,ものが恵,めぐみを得,えるのでもない。しかし時,ときと災難,さいなんはすべての人,ひとに臨,のぞむ。","tok":[["わたし"],["は"],["また"],["日","ひ"],["の"],["下","した"],["を"],["見た","みた"],["が"],["、"],["必らず","かならず"],["しも"],["速い","はやい"],["者","もの"],["が"],["競走","きょうそう"],["に"],["勝つ","かつ"],["ので"],["は"],["なく"],["、"],["強い","つよい"],["者","もの"],["が"],["戦い","たたかい"],["に"],["勝つ","かつ"],["ので"],["も"],["ない"],["。"],["また"],["賢しこい","かしこい"],["者","もの"],["が"],["パン"],["を"],["得る","える"],["ので"],["も"],["なく"],["、"],["さ"],["とき"],["者","もの"],["が"],["富","とみ"],["を"],["得る","える"],["ので"],["も"],["ない"],["。"],["また"],["知識","ちしき"],["ある"],["者","もの"],["が"],["恵","めぐみ"],["を"],["得る","える"],["ので"],["も"],["ない"],["。"],["しかし"],["時","とき"],["と"],["災難","さいなん"],["は"],["すべて"],["の"],["人","ひと"],["に"],["臨む","のぞむ"],["。"]]},{"verse":12,"text":"人,ひとはその時,ときを知,しらない。魚,うおがわざわいの網,あみにかかり、鳥,とりがわなにかかるように、人,ひとの子,こらもわざわいの時,ときが突然,とつぜん彼,かれらに臨,のぞむ時,とき、それにかかるのである。","tok":[["人","ひと"],["は"],["その"],["時","とき"],["を"],["知らない","しらない"],["。"],["魚","うお"],["が"],["わざわい"],["の"],["網","あみ"],["に"],["かかり"],["、"],["鳥","とり"],["が"],["わな"],["に"],["かかる"],["よう"],["に"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["も"],["わざわい"],["の"],["時","とき"],["が"],["突然","とつぜん"],["彼","かれ"],["ら"],["に"],["臨む","のぞむ"],["時","とき"],["、"],["それ"],["に"],["かかる"],["ので"],["ある"],["。"]]},{"verse":13,"text":"またわたしは日,ひの下,したにこのような知恵,ちえの例,れいを見,みた。これはわたしにとって大,おおきな事,ことである。","tok":[["また"],["わたし"],["は"],["日","ひ"],["の"],["下","した"],["に"],["この"],["よう"],["な"],["知恵","ちえ"],["の"],["例","れい"],["を"],["見た","みた"],["。"],["これ"],["は"],["わたし"],["にとって"],["大きな","おおきな"],["事","こと"],["で"],["ある"],["。"]]},{"verse":14,"text":"ここに一つの小,ちいさい町,まちがあって、そこに住,すむ人,ひとは少,すくなかったが、大,おおいなる王,おうが攻,せめて来,きて、これを囲,かこみ、これに向,むかって大,おおきな雲梯,うんていを建,たてた。","tok":[["ここ"],["に"],["一","ひと"],["つ"],["の"],["小さい","ちいさい"],["町","まち"],["が"],["あって"],["、"],["そこ"],["に"],["住む","すむ"],["人","ひと"],["は"],["少かった","すくなかった"],["が"],["、"],["大いなる","おおいなる"],["王","おう"],["が"],["攻めて","せめて"],["来て","きて"],["、"],["これ"],["を"],["囲み","かこみ"],["、"],["これ"],["に"],["向かって","むかって"],["大きな","おおきな"],["雲梯","うんてい"],["を"],["建てた","たてた"],["。"]]},{"verse":15,"text":"しかし、町,まちのうちにひとりの貧,まずしい知恵,ちえのある人,ひとがいて、その知恵,ちえをもって町,まちを救,すくった。ところがだれひとり、その貧,まずしい人,ひとを記憶,きおくする者,ものがなかった。","tok":[["しかし"],["、"],["町","まち"],["の"],["うち"],["に"],["ひとり"],["の"],["貧しい","まずしい"],["知恵","ちえ"],["の"],["ある"],["人","ひと"],["が"],["いて"],["、"],["その"],["知恵","ちえ"],["を"],["もって"],["町","まち"],["を"],["救った","すくった"],["。"],["ところ"],["が"],["だれ"],["ひとり"],["、"],["その"],["貧しい","まずしい"],["人","ひと"],["を"],["記憶","きおく"],["する"],["者","もの"],["が"],["なかった"],["。"]]},{"verse":16,"text":"そこでわたしは言,いう、「知恵,ちえは力,ちからにまさる。しかしかの貧,まずしい人,ひとの知恵,ちえは軽,かろんぜられ、その言葉,ことばは聞,きかれなかった」。","tok":[["そこ"],["で"],["わたし"],["は"],["言う","いう"],["、"],["「"],["知恵","ちえ"],["は"],["力","ちから"],["に"],["まさる"],["。"],["しかしか"],["の"],["貧しい","まずしい"],["人","ひと"],["の"],["知恵","ちえ"],["は"],["軽んぜられ","かろんぜられ"],["、"],["その"],["言葉","ことば"],["は"],["聞かれなかった","きかれなかった"],["」"],["。"]]},{"verse":17,"text":"静,しずかに聞,きかれる知者,ちしゃの言葉,ことばは、愚,おろかな者,ものの中,なかのつかさたる者,ものの叫,さけびにまさる。","tok":[["静","しずか"],["に"],["聞かれる","きかれる"],["知者","ちしゃ"],["の"],["言葉","ことば"],["は"],["、"],["愚か","おろか"],["な"],["者","もの"],["の"],["中","なか"],["の"],["つかさ"],["たる"],["者","もの"],["の"],["叫","さけび"],["に"],["まさる"],["。"]]},{"verse":18,"text":"知恵,ちえは戦,たたかいの武器,ぶきにまさる。しかし、ひとりの罪,つみびとは多,おおくの良,よきわざを滅,ほろぼす。","tok":[["知恵","ちえ"],["は"],["戦い","たたかい"],["の"],["武器","ぶき"],["に"],["まさる"],["。"],["しかし"],["、"],["ひとり"],["の"],["罪びと","つみびと"],["は"],["多く","おおく"],["の"],["良き","よき"],["わざ"],["を"],["滅ぼす","ほろぼす"],["。"]]}]
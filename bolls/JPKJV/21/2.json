[{"verse":1,"text":"わたしは自分,じぶんの心,こころに言,いった、「さあ、快楽,かいらくをもって、おまえを試,こころみよう。おまえは愉快,ゆかいに過,すごすがよい」と。しかし、これもまた空,くうであった。","tok":[["わたし"],["は"],["自分","じぶん"],["の"],["心","こころ"],["に"],["言った","いった"],["、"],["「"],["さあ"],["、"],["快楽","かいらく"],["を"],["もって"],["、"],["おまえ"],["を"],["試みよう","こころみよう"],["。"],["おまえ"],["は"],["愉快","ゆかい"],["に"],["過ごす","すごす"],["が"],["よい"],["」"],["と"],["。"],["しかし"],["、"],["これ"],["も"],["また"],["空","く"],["うで"],["あった"],["。"]]},{"verse":2,"text":"わたしは笑,わらいについて言,いった、「これは狂気,きょうきである」と。また快楽,かいらくについて言,いった、「これは何,なにをするのか」と。","tok":[["わたし"],["は"],["笑","わらい"],["について"],["言った","いった"],["、"],["「"],["これ"],["は"],["狂気","きょうき"],["で"],["ある"],["」"],["と"],["。"],["また"],["快楽","かいらく"],["について"],["言った","いった"],["、"],["「"],["これ"],["は"],["何に","なに"],["を"],["する"],["の"],["か"],["」"],["と"],["。"]]},{"verse":3,"text":"わたしの心,こころは知恵,ちえをもってわたしを導,みちびいているが、わたしは酒,さけをもって自分,じぶんの肉体,にくたいを元気,げんきづけようと試,こころみた。また、人,ひとの子,こは天,あめが下,したでその短,みじかい一生,いっしょうの間,あいだ、どんな事,ことをしたら良,よいかを、見,みきわめるまでは、愚,おろかな事,ことをしようと試,こころみた。","tok":[["わたし"],["の"],["心","こころ"],["は"],["知恵","ちえ"],["を"],["もって"],["わたし"],["を"],["導いて","みちびいて"],["いる"],["が"],["、"],["わたし"],["は"],["酒","さけ"],["を"],["もって"],["自分","じぶん"],["の"],["肉体","にくたい"],["を"],["元気","げんき"],["づけよう"],["と"],["試みた","こころみた"],["。"],["また"],["、"],["人","ひと"],["の"],["子","こ"],["は"],["天","あ"],["め"],["が"],["下","した"],["で"],["その"],["短かい","みじかい"],["一生","いっしょう"],["の"],["間","あいだ"],["、"],["どんな"],["事","こと"],["を"],["したら"],["良い","よい"],["か"],["を"],["、"],["見きわめる","みきわめる"],["まで"],["は"],["、"],["愚か","おろか"],["な"],["事","こと"],["を"],["しよう"],["と"],["試みた","こころみた"],["。"]]},{"verse":4,"text":"わたしは大,おおきな事業,じぎょうをした。わたしは自分,じぶんのために家,いえを建,たて、ぶどう畑,ばたけを設,もうけ、","tok":[["わたし"],["は"],["大きな","おおきな"],["事業","じぎょう"],["を"],["した"],["。"],["わたし"],["は"],["自分","じぶん"],["の"],["ため"],["に"],["家","いえ"],["を"],["建て","たて"],["、"],["ぶどう"],["畑","ばたけ"],["を"],["設け","もうけ"],["、"]]},{"verse":5,"text":"園,そのと庭,にわをつくり、またすべて実,みのなる木,きをそこに植,うえ、","tok":[["園","その"],["と"],["庭","にわ"],["を"],["つくり"],["、"],["また"],["すべて"],["実","み"],["の"],["なる"],["木","き"],["を"],["そこ"],["に"],["植え","うえ"],["、"]]},{"verse":6,"text":"池,いけをつくって、木,きのおい茂,しげる林,はやしに、そこから水,みずを注,そそがせた。","tok":[["池","いけ"],["を"],["つくって"],["、"],["木","き"],["の"],["おい"],["茂林","しげるはやし"],["に"],["、"],["そこ"],["から"],["水","みず"],["を"],["注がせた","そそがせた"],["。"]]},{"verse":7,"text":"わたしは男女,だんじょの奴隷,どれいを買,かった。またわたしの家,いえで生,うまれた奴隷,どれいを持,もっていた。わたしはまた、わたしより先,さきにエルサレムにいただれよりも多,おおくの牛,うしや羊,ひつじの財産,ざいさんを持,もっていた。","tok":[["わたし"],["は"],["男女","だんじょ"],["の"],["奴隷","どれい"],["を"],["買った","かった"],["。"],["また"],["わたし"],["の"],["家","いえ"],["で"],["生まれた","うまれた"],["奴隷","どれい"],["を"],["持って","もって"],["いた"],["。"],["わたし"],["は"],["また"],["、"],["わたし"],["より"],["先","さき"],["に"],["エルサレム"],["に"],["いた"],["だれ"],["より"],["も"],["多く","おおく"],["の"],["牛","うし"],["や"],["羊","ひつじ"],["の"],["財産","ざいさん"],["を"],["持って","もって"],["いた"],["。"]]},{"verse":8,"text":"わたしはまた銀,ぎんと金,きんを集,あつめ、王,おうたちと国々,くにぐにの財宝,ざいほうを集,あつめた。またわたしは歌,うたうたう男,おとこ、歌,うたうたう女,おんなを得,えた。また人,ひとの子,この楽,たのしみとするそばめを多,おおく得,えた。","tok":[["わたし"],["は"],["また"],["銀","ぎん"],["と"],["金","きん"],["を"],["集め","あつめ"],["、"],["王","おう"],["たち"],["と"],["国々","くにぐに"],["の"],["財宝","ざいほう"],["を"],["集めた","あつめた"],["。"],["また"],["わたし"],["は"],["歌","うた"],["うたう"],["男","おとこ"],["、"],["歌","うた"],["うたう"],["女","おんな"],["を"],["得た","えた"],["。"],["また"],["人","ひと"],["の"],["子","こ"],["の"],["楽み","たのしみ"],["と"],["する"],["そばめ"],["を"],["多く","おおく"],["得た","えた"],["。"]]},{"verse":9,"text":"こうして、わたしは大,おおいなる者,ものとなり、わたしより先,さきにエルサレムにいたすべての者,ものよりも、大,おおいなる者,ものとなった。わたしの知恵,ちえもまた、わたしを離,はなれなかった。","tok":[["こう"],["して"],["、"],["わたし"],["は"],["大いなる","おおいなる"],["者","もの"],["と"],["なり"],["、"],["わたし"],["より"],["先","さき"],["に"],["エルサレム"],["に"],["いた"],["すべて"],["の"],["者","もの"],["より"],["も"],["、"],["大いなる","おおいなる"],["者","もの"],["と"],["なった"],["。"],["わたし"],["の"],["知恵","ちえ"],["も"],["また"],["、"],["わたし"],["を"],["離れなかった","はなれなかった"],["。"]]},{"verse":10,"text":"なんでもわたしの目,めの好,このむものは遠慮,えんりょせず、わたしの心,こころの喜,よろこぶものは拒,こばまなかった。わたしの心,こころがわたしのすべての労苦,ろうくによって、快楽,かいらくを得,えたからである。そしてこれはわたしのすべての労苦,ろうくによって得,えた報,むくいであった。","tok":[["なん"],["で"],["も"],["わたし"],["の"],["目","め"],["の"],["好む","このむ"],["もの"],["は"],["遠慮","えんりょ"],["せず"],["、"],["わたし"],["の"],["心","こころ"],["の"],["喜こぶ","よろこぶ"],["もの"],["は"],["拒まなかった","こばまなかった"],["。"],["わたし"],["の"],["心","こころ"],["が"],["わたし"],["の"],["すべて"],["の"],["労苦","ろうく"],["によって"],["、"],["快楽","かいらく"],["を"],["得た","えた"],["から"],["で"],["ある"],["。"],["そして"],["これ"],["は"],["わたし"],["の"],["すべて"],["の"],["労苦","ろうく"],["によって"],["得た","えた"],["報い","むくい"],["で"],["あった"],["。"]]},{"verse":11,"text":"そこで、わたしはわが手,てのなしたすべての事,こと、およびそれをなすに要,ようした労苦,ろうくを顧,かえりみたとき、見,みよ、皆,みな、空,くうであって、風,かぜを捕,とらえるようなものであった。日,ひの下,したには益,えきとなるものはないのである。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["わが"],["手","て"],["の"],["なした"],["すべて"],["の"],["事","こと"],["、"],["および"],["それ"],["を"],["なす"],["に"],["要した","ようした"],["労苦","ろうく"],["を"],["顧た","かえりみた"],["とき"],["、"],["見よ","みよ"],["、"],["皆","みな"],["、"],["空","く"],["うで"],["あって"],["、"],["風","かぜ"],["を"],["捕らえる","とらえる"],["よう"],["な"],["もの"],["で"],["あった"],["。"],["日","ひ"],["の"],["下","した"],["に"],["は"],["益","えき"],["と"],["なる"],["もの"],["は"],["ない"],["ので"],["ある"],["。"]]},{"verse":12,"text":"わたしはまた、身,みをめぐらして、知恵,ちえと、狂気,きょうきと、愚痴,ぐちとを見,みた。そもそも、王,おうの後,のちに来,くる人,ひとは何,なにをなし得,えようか。すでに彼,かれがなした事,ことにすぎないのだ。","tok":[["わたし"],["は"],["また"],["、"],["身","み"],["を"],["めぐらして"],["、"],["知恵","ちえ"],["と"],["、"],["狂気","きょうき"],["と"],["、"],["愚痴","ぐち"],["と"],["を"],["見た","みた"],["。"],["そもそも"],["、"],["王","おう"],["の"],["後","のち"],["に"],["来る","くる"],["人","ひと"],["は"],["何に","なに"],["を"],["なし"],["得よう","えよう"],["か"],["。"],["すでに"],["彼","かれ"],["が"],["なした"],["事","こと"],["に"],["すぎない"],["の"],["だ"],["。"]]},{"verse":13,"text":"光,ひかりが暗,くらきにまさるように、知恵,ちえが愚痴,ぐちにまさるのを、わたしは見,みた。","tok":[["光","ひかり"],["が"],["暗き","くらき"],["に"],["まさる"],["よう"],["に"],["、"],["知恵","ちえ"],["が"],["愚痴","ぐち"],["に"],["まさる"],["の"],["を"],["、"],["わたし"],["は"],["見た","みた"],["。"]]},{"verse":14,"text":"知者,ちしゃの目,めは、その頭,あたまにある。しかし愚者,ぐしゃは暗,くらやみを歩,あゆむ。けれどもわたしはなお同一,どういつの運命,うんめいが彼,かれらのすべてに臨,のぞむことを知,しっている。","tok":[["知者","ちしゃ"],["の"],["目","め"],["は"],["、"],["その"],["頭","あたま"],["に"],["ある"],["。"],["しかし"],["愚者","ぐしゃ"],["は"],["暗やみ","くらやみ"],["を"],["歩む","あゆむ"],["。"],["けれど"],["も"],["わたし"],["は"],["なお"],["同一","どういつ"],["の"],["運命","うんめい"],["が"],["彼","かれ"],["ら"],["の"],["すべて"],["に"],["臨む","のぞむ"],["こと"],["を"],["知って","しって"],["いる"],["。"]]},{"verse":15,"text":"わたしは心,こころに言,いった、「愚者,ぐしゃに臨,のぞむ事,ことはわたしにも臨,のぞむのだ。それでどうしてわたしは賢,かしこいことがあろう」。わたしはまた心,こころに言,いった、「これもまた空,くうである」と。","tok":[["わたし"],["は"],["心","こころ"],["に"],["言った","いった"],["、"],["「"],["愚者","ぐしゃ"],["に"],["臨む","のぞむ"],["事","こと"],["は"],["わたし"],["に"],["も"],["臨む","のぞむ"],["の"],["だ"],["。"],["それ"],["で"],["どう"],["して"],["わたし"],["は"],["賢しこい","かしこい"],["こと"],["が"],["あろう"],["」"],["。"],["わたし"],["は"],["また"],["心","こころ"],["に"],["言った","いった"],["、"],["「"],["これ"],["も"],["また"],["空","く"],["うで"],["ある"],["」"],["と"],["。"]]},{"verse":16,"text":"そもそも、知者,ちしゃも愚者,ぐしゃも同様,どうように長,ながく覚,おぼえられるものではない。きたるべき日,ひには皆,みな忘,わすれられてしまうのである。知者,ちしゃが愚者,ぐしゃと同,おなじように死,しぬのは、どうしたことであろう。","tok":[["そもそも"],["、"],["知者","ちしゃ"],["も"],["愚者","ぐしゃ"],["も"],["同様","どうよう"],["に"],["長く","ながく"],["覚えられる","おぼえられる"],["もの"],["で"],["は"],["ない"],["。"],["きたるべき"],["日","ひ"],["に"],["は"],["皆","みな"],["忘られて","わすれられて"],["しまう"],["ので"],["ある"],["。"],["知者","ちしゃ"],["が"],["愚者","ぐしゃ"],["と"],["同じ","おなじ"],["よう"],["に"],["死ぬ","しぬ"],["の"],["は"],["、"],["どう"],["した"],["こと"],["で"],["あろう"],["。"]]},{"verse":17,"text":"そこで、わたしは生,いきることをいとった。日,ひの下,したに行,おこなわれるわざは、わたしに悪,あしく見,みえたからである。皆,みな空,くうであって、風,かぜを捕,とらえるようである。","tok":[["そこ"],["で"],["、"],["わたし"],["は"],["生きる","いきる"],["こと"],["を"],["いとった"],["。"],["日","ひ"],["の"],["下","した"],["に"],["行なわれる","おこなわれる"],["わざ"],["は"],["、"],["わたし"],["に"],["悪しく","あしく"],["見えた","みえた"],["から"],["で"],["ある"],["。"],["皆空","みなく"],["うで"],["あって"],["、"],["風","かぜ"],["を"],["捕らえる","とらえる"],["よう"],["で"],["ある"],["。"]]},{"verse":18,"text":"わたしは日,ひの下,したで労,ろうしたすべての労苦,ろうくを憎,にくんだ。わたしの後,のちに来,くる人,ひとにこれを残,のこさなければならないからである。","tok":[["わたし"],["は"],["日","ひ"],["の"],["下","した"],["で"],["労した","ろうした"],["すべて"],["の"],["労苦","ろうく"],["を"],["憎んだ","にくんだ"],["。"],["わたし"],["の"],["後","のち"],["に"],["来る","くる"],["人","ひと"],["に"],["これ"],["を"],["残さなければ","のこさなければ"],["ならない"],["から"],["で"],["ある"],["。"]]},{"verse":19,"text":"そして、その人,ひとが知者,ちしゃであるか、または愚者,ぐしゃであるかは、だれが知,しり得,えよう。そうであるのに、その人,ひとが、日,ひの下,したでわたしが労,ろうし、かつ知恵,ちえを働,はたらかしてなしたすべての労苦,ろうくをつかさどることになるのだ。これもまた空,くうである。","tok":[["そして"],["、"],["その"],["人","ひと"],["が"],["知者","ちしゃ"],["で"],["ある"],["か"],["、"],["また"],["は"],["愚者","ぐしゃ"],["で"],["ある"],["か"],["は"],["、"],["だれ"],["が"],["知り","しり"],["得よう","えよう"],["。"],["そう"],["で"],["ある"],["のに"],["、"],["その"],["人","ひと"],["が"],["、"],["日","ひ"],["の"],["下","した"],["で"],["わたし"],["が"],["労し","ろうし"],["、"],["かつ"],["知恵","ちえ"],["を"],["働かして","はたらかして"],["なした"],["すべて"],["の"],["労苦","ろうく"],["を"],["つかさどる"],["こと"],["に"],["なる"],["の"],["だ"],["。"],["これ"],["も"],["また"],["空","く"],["うで"],["ある"],["。"]]},{"verse":20,"text":"それでわたしはふり返,かえってみて、日,ひの下,したでわたしが労,ろうしたすべての労苦,ろうくについて、望,のぞみを失,うしなった。","tok":[["それ"],["で"],["わたし"],["は"],["ふり返って","ふりかえって"],["みて"],["、"],["日","ひ"],["の"],["下","した"],["で"],["わたし"],["が"],["労した","ろうした"],["すべて"],["の"],["労苦","ろうく"],["について"],["、"],["望み","のぞみ"],["を"],["失なった","うしなった"],["。"]]},{"verse":21,"text":"今,いまここに人,ひとがあって、知恵,ちえと知識,ちしきと才能,さいのうをもって労,ろうしても、これがために労,ろうしない人,ひとに、すべてを残,のこして、その所有,しょゆうとさせなければならないのだ。これもまた空,くうであって、大,おおいに悪,わるい。","tok":[["今","いま"],["ここ"],["に"],["人","ひと"],["が"],["あって"],["、"],["知恵","ちえ"],["と"],["知識","ちしき"],["と"],["才能","さいのう"],["を"],["もって"],["労して","ろうして"],["も"],["、"],["これ"],["が"],["ため"],["に"],["労しない","ろうしない"],["人","ひと"],["に"],["、"],["すべて"],["を"],["残して","のこして"],["、"],["その"],["所有","しょゆう"],["と"],["させなければ"],["ならない"],["の"],["だ"],["。"],["これ"],["も"],["また"],["空","く"],["うで"],["あって"],["、"],["大いに","おおいに"],["悪い","わるい"],["。"]]},{"verse":22,"text":"そもそも、人,ひとは日,ひの下,したで労,ろうするすべての労苦,ろうくと、その心,こころづかいによってなんの得,えるところがあるか。","tok":[["そもそも"],["、"],["人","ひと"],["は"],["日","ひ"],["の"],["下","した"],["で"],["労する","ろうする"],["すべて"],["の"],["労苦","ろうく"],["と"],["、"],["その"],["心づかい","こころづかい"],["によって"],["なん"],["の"],["得る","える"],["ところ"],["が"],["ある"],["か"],["。"]]},{"verse":23,"text":"そのすべての日,ひはただ憂,うれいのみであって、そのわざは苦,くるしく、その心,こころは夜,よの間,まも休,やすまることがない。これもまた空,くうである。","tok":[["その"],["すべて"],["の"],["日","ひ"],["は"],["ただ"],["憂","うれい"],["のみ"],["で"],["あって"],["、"],["その"],["わざ"],["は"],["苦しく","くるしく"],["、"],["その"],["心","こころ"],["は"],["夜","よ"],["の"],["間","ま"],["も"],["休まる","やすまる"],["こと"],["が"],["ない"],["。"],["これ"],["も"],["また"],["空","く"],["うで"],["ある"],["。"]]},{"verse":24,"text":"人,ひとは食,くい飲,のみし、その労苦,ろうくによって得,えたもので心,こころを楽,たのしませるより良,よい事,ことはない。これもまた神,かみの手,てから出,でることを、わたしは見,みた。","tok":[["人","ひと"],["は"],["食い","くい"],["飲み","のみ"],["し"],["、"],["その"],["労苦","ろうく"],["によって"],["得た","えた"],["もの"],["で"],["心","こころ"],["を"],["楽しませる","たのしませる"],["より"],["良い","よい"],["事","こと"],["は"],["ない"],["。"],["これ"],["も"],["また"],["神","かみ"],["の"],["手","て"],["から"],["出る","でる"],["こと"],["を"],["、"],["わたし"],["は"],["見た","みた"],["。"]]},{"verse":25,"text":"だれが神,かみを離,はなれて、食,くい、かつ楽,たのしむことのできる者,ものがあろう。","tok":[["だれ"],["が"],["神","かみ"],["を"],["離れて","はなれて"],["、"],["食い","くい"],["、"],["かつ"],["楽しむ","たのしむ"],["こと"],["の"],["できる"],["者","もの"],["が"],["あろう"],["。"]]},{"verse":26,"text":"神,かみは、その心,こころにかなう人,ひとに、知恵,ちえと知識,ちしきと喜,よろこびとをくださる。しかし罪,つみびとには仕事,しごとを与,あたえて集,あつめることと、積,つむことをさせられる。これは神,かみの心,こころにかなう者,ものにそれを賜,たまわるためである。これもまた空,くうであって、風,かぜを捕,とらえるようである。","tok":[["神","かみ"],["は"],["、"],["その"],["心","こころ"],["に"],["かなう"],["人","ひと"],["に"],["、"],["知恵","ちえ"],["と"],["知識","ちしき"],["と"],["喜こび","よろこび"],["と"],["を"],["くださる"],["。"],["しかし"],["罪びと","つみびと"],["に"],["は"],["仕事","しごと"],["を"],["与","あたえ"],["て"],["集める","あつめる"],["こと"],["と"],["、"],["積む","つむ"],["こと"],["を"],["させられる"],["。"],["これ"],["は"],["神","かみ"],["の"],["心","こころ"],["に"],["かなう"],["者","もの"],["に"],["それ"],["を"],["賜わる","たまわる"],["ため"],["で"],["ある"],["。"],["これ"],["も"],["また"],["空","く"],["うで"],["あって"],["、"],["風","かぜ"],["を"],["捕らえる","とらえる"],["よう"],["で"],["ある"],["。"]]}]
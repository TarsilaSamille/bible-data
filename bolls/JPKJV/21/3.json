[{"verse":1,"text":"天,あめが下,したのすべての事,ことには季節,きせつがあり、すべてのわざには時,ときがある。","tok":[["天","あ"],["め"],["が"],["下","した"],["の"],["すべて"],["の"],["事","こと"],["に"],["は"],["季節","きせつ"],["が"],["あり"],["、"],["すべて"],["の"],["わざ"],["に"],["は"],["時","とき"],["が"],["ある"],["。"]]},{"verse":2,"text":"生,うまるるに時,ときがあり、死,しぬるに時,ときがあり、植,うえるに時,ときがあり、植,うえたものを抜,ぬくに時,ときがあり、","tok":[["生まるる","うまるる"],["に"],["時","とき"],["が"],["あり"],["、"],["死ぬるに","しぬるに"],["時","とき"],["が"],["あり"],["、"],["植える","うえる"],["に"],["時","とき"],["が"],["あり"],["、"],["植えた","うえた"],["もの"],["を"],["抜く","ぬく"],["に"],["時","とき"],["が"],["あり"],["、"]]},{"verse":3,"text":"殺,ころすに時,ときがあり、いやすに時,ときがあり、こわすに時,ときがあり、建,たてるに時,ときがあり、","tok":[["殺ろす","ころす"],["に"],["時","とき"],["が"],["あり"],["、"],["いやす"],["に"],["時","とき"],["が"],["あり"],["、"],["こわす"],["に"],["時","とき"],["が"],["あり"],["、"],["建てる","たてる"],["に"],["時","とき"],["が"],["あり"],["、"]]},{"verse":4,"text":"泣,なくに時,ときがあり、笑,わらうに時,ときがあり、悲,かなしむに時,ときがあり、踊,おどるに時,ときがあり、","tok":[["泣く","なく"],["に"],["時","とき"],["が"],["あり"],["、"],["笑う","わらう"],["に"],["時","とき"],["が"],["あり"],["、"],["悲しむ","かなしむ"],["に"],["時","とき"],["が"],["あり"],["、"],["踊る","おどる"],["に"],["時","とき"],["が"],["あり"],["、"]]},{"verse":5,"text":"石,いしを投,なげるに時,ときがあり、石,いしを集,あつめるに時,ときがあり、抱,だくに時,ときがあり、抱,だくことをやめるに時,ときがあり、","tok":[["石","いし"],["を"],["投る","なげる"],["に"],["時","とき"],["が"],["あり"],["、"],["石","いし"],["を"],["集める","あつめる"],["に"],["時","とき"],["が"],["あり"],["、"],["抱","だく"],["に"],["時","とき"],["が"],["あり"],["、"],["抱","だくこと"],["を"],["やめる"],["に"],["時","とき"],["が"],["あり"],["、"]]},{"verse":6,"text":"捜,さがすに時,ときがあり、失,うしなうに時,ときがあり、保,たもつに時,ときがあり、捨,すてるに時,ときがあり、","tok":[["捜す","さがす"],["に"],["時","とき"],["が"],["あり"],["、"],["失なう","うしなう"],["に"],["時","とき"],["が"],["あり"],["、"],["保つ","たもつ"],["に"],["時","とき"],["が"],["あり"],["、"],["捨てる","すてる"],["に"],["時","とき"],["が"],["あり"],["、"]]},{"verse":7,"text":"裂,さくに時,ときがあり、縫,ぬうに時,ときがあり、黙,だまるに時,ときがあり、語,かたるに時,ときがあり、","tok":[["裂く","さく"],["に"],["時","とき"],["が"],["あり"],["、"],["縫う","ぬう"],["に"],["時","とき"],["が"],["あり"],["、"],["黙る","だまる"],["に"],["時","とき"],["が"],["あり"],["、"],["語る","かたる"],["に"],["時","とき"],["が"],["あり"],["、"]]},{"verse":8,"text":"愛,あいするに時,ときがあり、憎,にくむに時,ときがあり、戦,たたかうに時,ときがあり、和,やわらぐに時,ときがある。","tok":[["愛する","あいする"],["に"],["時","とき"],["が"],["あり"],["、"],["憎む","にくむ"],["に"],["時","とき"],["が"],["あり"],["、"],["戦う","たたかう"],["に"],["時","とき"],["が"],["あり"],["、"],["和らぐ","やわらぐ"],["に"],["時","とき"],["が"],["ある"],["。"]]},{"verse":9,"text":"働,はたらく者,ものはその労,ろうすることにより、なんの益,えきを得,えるか。","tok":[["働く","はたらく"],["者","もの"],["は"],["その"],["労","ろう"],["する"],["こと"],["に"],["より"],["、"],["なん"],["の"],["益","えき"],["を"],["得る","える"],["か"],["。"]]},{"verse":10,"text":"わたしは神,かみが人,ひとの子,こらに与,あたえて、ほねおらせられる仕事,しごとを見,みた。","tok":[["わたし"],["は"],["神","かみ"],["が"],["人","ひと"],["の"],["子","こ"],["ら"],["に"],["与","あたえ"],["て"],["、"],["ほねおらせられる"],["仕事","しごと"],["を"],["見た","みた"],["。"]]},{"verse":11,"text":"神,かみのなされることは皆,みなその時,ときにかなって美,うつくしい。神,かみはまた人,ひとの心,こころに永遠,えいえんを思,おもう思,おもいを授,さづけられた。それでもなお、人,ひとは神,かみのなされるわざを初,はじめから終,おわりまで見,みきわめることはできない。","tok":[["神","かみ"],["の"],["なされる"],["こと"],["は"],["皆","みな"],["その"],["時","とき"],["に"],["かなって"],["美しい","うつくしい"],["。"],["神","かみ"],["は"],["また"],["人","ひと"],["の"],["心","こころ"],["に"],["永遠","えいえん"],["を"],["思う","おもう"],["思い","おもい"],["を"],["授","さ"],["づけられた"],["。"],["それ"],["で"],["も"],["なお"],["、"],["人","ひと"],["は"],["神","かみ"],["の"],["なされる"],["わざ"],["を"],["初め","はじめ"],["から"],["終","おわり"],["まで"],["見きわめる","みきわめる"],["こと"],["は"],["できない"],["。"]]},{"verse":12,"text":"わたしは知,しっている。人,ひとにはその生,いきながらえている間,あいだ、楽,たのしく愉快,ゆかいに過,すごすよりほかに良,よい事,ことはない。","tok":[["わたし"],["は"],["知って","しって"],["いる"],["。"],["人","ひと"],["に"],["は"],["その"],["生きながらえて","いきながらえて"],["いる"],["間","あいだ"],["、"],["楽く","たのしく"],["愉快","ゆかい"],["に"],["過ごす","すごす"],["より"],["ほか"],["に"],["良い","よい"],["事","こと"],["は"],["ない"],["。"]]},{"verse":13,"text":"またすべての人,ひとが食,くい飲,のみし、そのすべての労苦,ろうくによって楽,たのしみを得,えることは神,かみの賜物,たまものである。","tok":[["また"],["すべて"],["の"],["人","ひと"],["が"],["食い","くい"],["飲み","のみ"],["し"],["、"],["その"],["すべて"],["の"],["労苦","ろうく"],["によって"],["楽み","たのしみ"],["を"],["得る","える"],["こと"],["は"],["神","かみ"],["の"],["賜物","たまもの"],["で"],["ある"],["。"]]},{"verse":14,"text":"わたしは知,しっている。すべて神,かみがなさる事,ことは永遠,えいえんに変,かわることがなく、これに加,くわえることも、これから取,とることもできない。神,かみがこのようにされるのは、人々,ひとびとが神,かみの前,まえに恐,おそれをもつようになるためである。","tok":[["わたし"],["は"],["知って","しって"],["いる"],["。"],["すべて"],["神","かみ"],["が"],["なさる"],["事","こと"],["は"],["永遠","えいえん"],["に"],["変わる","かわる"],["こと"],["が"],["なく"],["、"],["これ"],["に"],["加える","くわえる"],["こと"],["も"],["、"],["これ"],["から"],["取る","とる"],["こと"],["も"],["できない"],["。"],["神","かみ"],["が"],["この"],["よう"],["に"],["される"],["の"],["は"],["、"],["人々","ひとびと"],["が"],["神","かみ"],["の"],["前","まえ"],["に"],["恐","おそれ"],["を"],["もつ"],["よう"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"今,いまあるものは、すでにあったものである。後,のちにあるものも、すでにあったものである。神,かみは追,おいやられたものを尋,たずね求,もとめられる。","tok":[["今","いま"],["ある"],["もの"],["は"],["、"],["すでに"],["あった"],["もの"],["で"],["ある"],["。"],["後","のち"],["に"],["ある"],["もの"],["も"],["、"],["すでに"],["あった"],["もの"],["で"],["ある"],["。"],["神","かみ"],["は"],["追いやられた","おいやられた"],["もの"],["を"],["尋ね求められる","たずねもとめられる"],["。"]]},{"verse":16,"text":"わたしはまた、日,ひの下,したを見,みたが、さばきを行,おこなう所,ところにも不正,ふせいがあり、公義,こうぎを行,おこなう所,ところにも不正,ふせいがある。","tok":[["わたし"],["は"],["また"],["、"],["日","ひ"],["の"],["下","した"],["を"],["見た","みた"],["が"],["、"],["さばき"],["を"],["行なう","おこなう"],["所","ところ"],["に"],["も"],["不正","ふせい"],["が"],["あり"],["、"],["公義","こうぎ"],["を"],["行なう","おこなう"],["所","ところ"],["に"],["も"],["不正","ふせい"],["が"],["ある"],["。"]]},{"verse":17,"text":"わたしは心,こころに言,いった、「神,かみは正,ただしい者,ものと悪,わるい者,ものとをさばかれる。神,かみはすべての事,ことと、すべてのわざに、時,ときを定,さだめられたからである」と。","tok":[["わたし"],["は"],["心","こころ"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["は"],["正い","ただしい"],["者","もの"],["と"],["悪い","わるい"],["者","もの"],["と"],["を"],["さばかれる"],["。"],["神","かみ"],["は"],["すべて"],["の"],["事","こと"],["と"],["、"],["すべて"],["の"],["わざ"],["に"],["、"],["時","とき"],["を"],["定められた","さだめられた"],["から"],["で"],["ある"],["」"],["と"],["。"]]},{"verse":18,"text":"わたしはまた、人,ひとの子,こらについて心,こころに言,いった、「神,かみは彼,かれらをためして、彼,かれらに自分,じぶんたちが獣,けものにすぎないことを悟,さとらせられるのである」と。","tok":[["わたし"],["は"],["また"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["について"],["心","こころ"],["に"],["言った","いった"],["、"],["「"],["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["ためして"],["、"],["彼","かれ"],["ら"],["に"],["自分","じぶん"],["たち"],["が"],["獣","けもの"],["に"],["すぎない"],["こと"],["を"],["悟らせられる","さとらせられる"],["ので"],["ある"],["」"],["と"],["。"]]},{"verse":19,"text":"人,ひとの子,こらに臨,のぞむところは獣,けものにも臨,のぞむからである。すなわち一様,いちように彼,かれらに臨,のぞみ、これの死,しぬように、彼,かれも死,しぬのである。彼,かれらはみな同様,どうようの息,いきをもっている。人,ひとは獣,けものにまさるところがない。すべてのものは空,くうだからである。","tok":[["人","ひと"],["の"],["子","こ"],["ら"],["に"],["臨む","のぞむ"],["ところ"],["は"],["獣","けもの"],["に"],["も"],["臨む","のぞむ"],["から"],["で"],["ある"],["。"],["すなわち"],["一様","いちよう"],["に"],["彼","かれ"],["ら"],["に"],["臨み","のぞみ"],["、"],["これ"],["の"],["死ぬ","しぬ"],["よう"],["に"],["、"],["彼","かれ"],["も"],["死ぬ","しぬ"],["ので"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["同様","どうよう"],["の"],["息","いき"],["を"],["もって"],["いる"],["。"],["人","ひと"],["は"],["獣","けもの"],["に"],["まさる"],["ところ"],["が"],["ない"],["。"],["すべて"],["の"],["もの"],["は"],["空らで","くうだからで"],["ある"],["。"]]},{"verse":20,"text":"みな一,ひとつ所,ところに行,いく。皆,みなちりから出,でて、皆,みなちりに帰,かえる。","tok":[["みな"],["一","ひと"],["つ"],["所","ところ"],["に"],["行く","いく"],["。"],["皆","みな"],["ちり"],["から"],["出て","でて"],["、"],["皆","みな"],["ちり"],["に"],["帰える","かえる"],["。"]]},{"verse":21,"text":"だれが知,しるか、人,ひとの子,こらの霊,れいは上,うえにのぼり、獣,けものの霊,れいは地,ちにくだるかを。","tok":[["だれ"],["が"],["知る","しる"],["か"],["、"],["人","ひと"],["の"],["子","こ"],["ら"],["の"],["霊","れい"],["は"],["上","うえ"],["に"],["のぼり"],["、"],["獣","けもの"],["の"],["霊","れい"],["は"],["地","ち"],["に"],["くだる"],["か"],["を"],["。"]]},{"verse":22,"text":"それで、わたしは見,みた、人,ひとはその働,はたらきによって楽,たのしむにこした事,ことはない。これが彼,かれの分,ぶんだからである。だれが彼,かれをつれていって、その後,のちの、どうなるかを見,みさせることができようか。","tok":[["それ"],["で"],["、"],["わたし"],["は"],["見た","みた"],["、"],["人","ひと"],["は"],["その"],["働らき","はたらき"],["によって"],["楽しむ","たのしむ"],["に"],["こした"],["事","こと"],["は"],["ない"],["。"],["これ"],["が"],["彼","かれ"],["の"],["分","ぶん"],["だ"],["から"],["で"],["ある"],["。"],["だれ"],["が"],["彼","かれ"],["を"],["つれて"],["いって"],["、"],["その後","そののち"],["の"],["、"],["どう"],["なる"],["か"],["を"],["見させる","みさせる"],["こと"],["が"],["できよう"],["か"],["。"]]}]
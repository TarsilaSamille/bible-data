[{"verse":1,"text":"わたしはまた、日,ひの下,したに行,おこなわれるすべてのしえたげを見,みた。見,みよ、しえたげられる者,ものの涙,なみだを。彼,かれらを慰,なぐさめる者,ものはない。しえたげる者,ものの手,てには権力,けんりょくがある。しかし彼,かれらを慰,なぐさめる者,ものはいない。","tok":[["わたし"],["は"],["また"],["、"],["日","ひ"],["の"],["下","した"],["に"],["行なわれる","おこなわれる"],["すべて"],["の"],["し"],["えたげ"],["を"],["見た","みた"],["。"],["見よ","みよ"],["、"],["し"],["えたげられる"],["者","もの"],["の"],["涙","なみだ"],["を"],["。"],["彼","かれ"],["ら"],["を"],["慰さめる","なぐさめる"],["者","もの"],["は"],["ない"],["。"],["し"],["えたげる"],["者","もの"],["の"],["手","て"],["に"],["は"],["権力","けんりょく"],["が"],["ある"],["。"],["しかし"],["彼","かれ"],["ら"],["を"],["慰さめる","なぐさめる"],["者","もの"],["は"],["いない"],["。"]]},{"verse":2,"text":"それで、わたしはなお生,いきている生存者,せいぞんしゃよりも、すでに死,しんだ死者,ししゃを、さいわいな者,ものと思,おもった。","tok":[["それ"],["で"],["、"],["わたし"],["は"],["なお"],["生きて","いきて"],["いる"],["生存者","せいぞんしゃ"],["より"],["も"],["、"],["すでに"],["死んだ","しんだ"],["死者","ししゃ"],["を"],["、"],["さいわい"],["な"],["者","もの"],["と"],["思った","おもった"],["。"]]},{"verse":3,"text":"しかし、この両者,りょうしゃよりもさいわいなのは、まだ生,うまれない者,もので、日,ひの下,したに行,おこなわれる悪,あしきわざを見,みない者,ものである。","tok":[["しかし"],["、"],["この"],["両者","りょうしゃ"],["より"],["も"],["さいわい"],["な"],["の"],["は"],["、"],["まだ"],["生まれない","うまれない"],["者","もの"],["で"],["、"],["日","ひ"],["の"],["下","した"],["に"],["行なわれる","おこなわれる"],["悪しき","あしき"],["わざ"],["を"],["見ない","みない"],["者","もの"],["で"],["ある"],["。"]]},{"verse":4,"text":"また、わたしはすべての労苦,ろうくと、すべての巧,たくみなわざを見,みたが、これは人,ひとが互,たがいにねたみあってなすものである。これもまた空,くうであって、風,かぜを捕,とらえるようである。","tok":[["また"],["、"],["わたし"],["は"],["すべて"],["の"],["労苦","ろうく"],["と"],["、"],["すべて"],["の"],["巧","たくみ"],["な"],["わざ"],["を"],["見た","みた"],["が"],["、"],["これ"],["は"],["人","ひと"],["が"],["互","たがい"],["に"],["ねたみ"],["あって"],["なす"],["もの"],["で"],["ある"],["。"],["これ"],["も"],["また"],["空","く"],["うで"],["あって"],["、"],["風","かぜ"],["を"],["捕らえる","とらえる"],["よう"],["で"],["ある"],["。"]]},{"verse":5,"text":"愚,おろかなる者,ものは手,てをつかねて、自分,じぶんの肉,にくを食,くう。","tok":[["愚か","おろか"],["なる"],["者","もの"],["は"],["手","て"],["を"],["つかねて"],["、"],["自分","じぶん"],["の"],["肉","にく"],["を"],["食う","くう"],["。"]]},{"verse":6,"text":"片手,かたてに物,ものを満,みたして平穏,へいおんであるのは、両手,りょうてに物,ものを満,みたして労苦,ろうくし、風,かぜを捕,とらえるのにまさる。","tok":[["片手","かたて"],["に"],["物","もの"],["を"],["満たして","みたして"],["平穏","へいおん"],["で"],["ある"],["の"],["は"],["、"],["両手","りょうて"],["に"],["物","もの"],["を"],["満たして","みたして"],["労苦","ろうく"],["し"],["、"],["風","かぜ"],["を"],["捕らえる","とらえる"],["のに"],["まさる"],["。"]]},{"verse":7,"text":"わたしはまた、日,ひの下,したに空,くうなる事,ことのあるのを見,みた。","tok":[["わたし"],["は"],["また"],["、"],["日","ひ"],["の"],["下","した"],["に"],["空","く"],["うなる"],["事","こと"],["の"],["ある"],["の"],["を"],["見た","みた"],["。"]]},{"verse":8,"text":"ここに人,ひとがある。ひとりであって、仲,なか間,まもなく、子,こもなく、兄弟,きょうだいもない。それでも彼,かれの労苦,ろうくは窮,きわまりなく、その目,めは富,とみに飽,あくことがない。また彼,かれは言,いわない、「わたしはだれのために労,ろうするのか、どうして自分,じぶんを楽,たのしませないのか」と。これもまた空,くうであって、苦,くるしいわざである。","tok":[["ここ"],["に"],["人","ひと"],["が"],["ある"],["。"],["ひとり"],["で"],["あって"],["、"],["仲間","なかま"],["も"],["なく"],["、"],["子","こ"],["も"],["なく"],["、"],["兄弟","きょうだい"],["も"],["ない"],["。"],["それ"],["で"],["も"],["彼","かれ"],["の"],["労苦","ろうく"],["は"],["窮まりなく","きわまりなく"],["、"],["その"],["目","め"],["は"],["富","とみ"],["に"],["飽く","あく"],["こと"],["が"],["ない"],["。"],["また"],["彼","かれ"],["は"],["言わない","いわない"],["、"],["「"],["わたし"],["は"],["だれ"],["の"],["ため"],["に"],["労する","ろうする"],["の"],["か"],["、"],["どう"],["して"],["自分","じぶん"],["を"],["楽しませない","たのしませない"],["の"],["か"],["」"],["と"],["。"],["これ"],["も"],["また"],["空","く"],["うで"],["あって"],["、"],["苦しい","くるしい"],["わざ"],["で"],["ある"],["。"]]},{"verse":9,"text":"ふたりはひとりにまさる。彼,かれらはその労苦,ろうくによって良,よい報,むくいを得,えるからである。","tok":[["ふたり"],["は"],["ひとり"],["に"],["まさる"],["。"],["彼","かれ"],["ら"],["は"],["その"],["労苦","ろうく"],["によって"],["良い","よい"],["報い","むくい"],["を"],["得る","える"],["から"],["で"],["ある"],["。"]]},{"verse":10,"text":"すなわち彼,かれらが倒,たおれる時,ときには、そのひとりがその友,ともを助,たすけ起,おこす。しかしひとりであって、その倒,たおれる時,とき、これを助,たすけ起,おこす者,もののない者,ものはわざわいである。","tok":[["すなわち"],["彼","かれ"],["ら"],["が"],["倒れる","たおれる"],["時","とき"],["に"],["は"],["、"],["その"],["ひとり"],["が"],["その"],["友","とも"],["を"],["助け起こす","たすけおこす"],["。"],["しかし"],["ひとり"],["で"],["あって"],["、"],["その"],["倒れる","たおれる"],["時","とき"],["、"],["これ"],["を"],["助け起こす","たすけおこす"],["者","もの"],["の"],["ない"],["者","もの"],["は"],["わざわい"],["で"],["ある"],["。"]]},{"verse":11,"text":"またふたりが一緒,いっしょに寝,ねれば暖,あたたかである。ひとりだけで、どうして暖,あたたかになり得,えようか。","tok":[["また"],["ふたり"],["が"],["一緒","いっしょ"],["に"],["寝れば","ねれば"],["暖か","あたたか"],["で"],["ある"],["。"],["ひとり"],["だけ"],["で"],["、"],["どう"],["して"],["暖か","あたたか"],["に"],["なり"],["得よう","えよう"],["か"],["。"]]},{"verse":12,"text":"人,ひとがもし、そのひとりを攻,せめ撃,うったなら、ふたりで、それに当,あたるであろう。三つよりの綱,つなはたやすくは切,きれない。","tok":[["人","ひと"],["が"],["もし"],["、"],["その"],["ひとり"],["を"],["攻め","せめ"],["撃ったなら","うったなら"],["、"],["ふたり"],["で"],["、"],["それ"],["に"],["当たるで","あたるで"],["あろう"],["。"],["三","みっ"],["つ"],["より"],["の"],["綱","つな"],["は"],["たやすく"],["は"],["切れない","きれない"],["。"]]},{"verse":13,"text":"貧,まずしくて賢,かしこいわらべは、老,おいて愚,おろかで、もはや、いさめをいれることを知,しらない王,おうにまさる。","tok":[["貧しくて","まずしくて"],["賢しこい","かしこい"],["わらべ"],["は"],["、"],["老","おい"],["て"],["愚か","おろか"],["で"],["、"],["もはや"],["、"],["いさめ"],["を"],["いれる"],["こと"],["を"],["知らない","しらない"],["王","おう"],["に"],["まさる"],["。"]]},{"verse":14,"text":"たとい、その王,おうが獄屋,ごくやから出,でて、王位,おういについた者,ものであっても、また自分,じぶんの国,くにに貧,まずしく生,うまれて王位,おういについた者,ものであっても、そうである。","tok":[["たとい"],["、"],["その"],["王","おう"],["が"],["獄屋","ごくや"],["から"],["出て","でて"],["、"],["王位","おうい"],["に"],["ついた"],["者","もの"],["で"],["あって"],["も"],["、"],["また"],["自分","じぶん"],["の"],["国","くに"],["に"],["貧しく","まずしく"],["生まれて","うまれて"],["王位","おうい"],["に"],["ついた"],["者","もの"],["で"],["あって"],["も"],["、"],["そう"],["で"],["ある"],["。"]]},{"verse":15,"text":"わたしは日,ひの下,したに歩,あゆむすべての民,たみが、かのわらべのように王,おうに代,かわって立,たつのを見,みた。","tok":[["わたし"],["は"],["日","ひ"],["の"],["下","した"],["に"],["歩む","あゆむ"],["すべて"],["の"],["民","たみ"],["が"],["、"],["かの"],["わらべ"],["の"],["よう"],["に"],["王","おう"],["に"],["代わって","かわって"],["立つ","たつ"],["の"],["を"],["見た","みた"],["。"]]},{"verse":16,"text":"すべての民,たみは果,はてしがない。彼,かれはそのすべての民,たみを導,みちびいた。しかし後,のちに来,くる者,ものは彼,かれを喜,よろこばない。たしかに、これもまた空,くうであって、風,かぜを捕,とらえるようである。","tok":[["すべて"],["の"],["民","たみ"],["は"],["果てし","はてし"],["が"],["ない"],["。"],["彼","かれ"],["は"],["その"],["すべて"],["の"],["民","たみ"],["を"],["導いた","みちびいた"],["。"],["しかし"],["後","のち"],["に"],["来る","くる"],["者","もの"],["は"],["彼","かれ"],["を"],["喜こばない","よろこばない"],["。"],["たしか"],["に"],["、"],["これ"],["も"],["また"],["空","く"],["うで"],["あって"],["、"],["風","かぜ"],["を"],["捕らえる","とらえる"],["よう"],["で"],["ある"],["。"]]},{"verse":17,"text":"[5:1]神,かみの宮,みやに行,ゆく時,ときには、その足,あしを慎,つつしむがよい。近,ちかよって聞,きくのは愚,おろかな者,ものの犠牲,ぎせいをささげるのにまさる。彼,かれらは悪,あくを行,おこなっていることを知,しらないからである。","tok":[["["],["5"],[":"],["1"],["]"],["神","かみ"],["の"],["宮","みや"],["に"],["行く","ゆく"],["時","とき"],["に"],["は"],["、"],["その"],["足","あし"],["を"],["慎しむ","つつしむ"],["が"],["よい"],["。"],["近よって","ちかよって"],["聞く","きく"],["の"],["は"],["愚か","おろか"],["な"],["者","もの"],["の"],["犠牲","ぎせい"],["を"],["ささげる"],["のに"],["まさる"],["。"],["彼","かれ"],["ら"],["は"],["悪","あく"],["を"],["行なって","おこなって"],["いる"],["こと"],["を"],["知らない","しらない"],["から"],["で"],["ある"],["。"]]}]
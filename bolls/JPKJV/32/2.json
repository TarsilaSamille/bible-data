[{"verse":1,"text":"[1:17]主,しゅは大,おおいなる魚,うおを備,そなえて、ヨナをのませられた。ヨナは三日,か三夜,よその魚,うおの腹,はらの中,うちにいた。","tok":[["["],["1"],[":"],["17"],["]"],["主","しゅ"],["は"],["大いなる","おおいなる"],["魚","うお"],["を"],["備","そなえ"],["て"],["、"],["ヨナ"],["を"],["のませられた"],["。"],["ヨナ"],["は"],["三日","か"],["三夜","よそ"],["の"],["魚","うお"],["の"],["腹","はら"],["の"],["中","うち"],["に"],["いた"],["。"]]},{"verse":2,"text":"[1]ヨナは魚,うおの腹,はらの中,うちからその神,かみ、主,しゅに祈,いのって、","tok":[["["],["1"],["]"],["ヨナ"],["は"],["魚","うお"],["の"],["腹","はら"],["の"],["中ら","うちから"],["その"],["神","かみ"],["、"],["主に","しゅに"],["祈って","いのって"],["、"]]},{"verse":3,"text":"[2]言,いった、「わたしは悩,なやみのうちから主,しゅに呼,よばわると、主,しゅはわたしに答,こたえられた。わたしが陰府,よみの腹,はらの中,うちから叫,さけぶと、あなたはわたしの声,こえを聞,きかれた。","tok":[["["],["2"],["]"],["言った","いった"],["、"],["「"],["わたし"],["は"],["悩み","なやみ"],["の"],["うち"],["から"],["主に","しゅに"],["呼ばわる","よばわる"],["と"],["、"],["主","しゅ"],["は"],["わたし"],["に"],["答","こたえ"],["られた"],["。"],["わたし"],["が"],["陰府","よみ"],["の"],["腹","はら"],["の"],["中ら","うちから"],["叫けぶ","さけぶ"],["と"],["、"],["あなた"],["は"],["わたし"],["の"],["声","こえ"],["を"],["聞かれた","きかれた"],["。"]]},{"verse":4,"text":"[3]あなたはわたしを淵,ふちの中,なか、海,うみのまん中,なかに投,なげ入,いれられた。大水,おおみずはわたしをめぐり、あなたの波,なみと大波,おおなみは皆,みな、わたしの上,うえを越,こえて行,いった。","tok":[["["],["3"],["]"],["あなた"],["は"],["わたし"],["を"],["淵","ふち"],["の"],["中","なか"],["、"],["海","うみ"],["の"],["まん中","まんなか"],["に"],["投入れられた","なげいれられた"],["。"],["大水","おおみず"],["は"],["わたし"],["を"],["めぐり"],["、"],["あなた"],["の"],["波","なみ"],["と"],["大波","おおなみ"],["は"],["皆","みな"],["、"],["わたし"],["の"],["上","うえ"],["を"],["越えて","こえて"],["行った","いった"],["。"]]},{"verse":5,"text":"[4]わたしは言,いった、『わたしはあなたの前,まえから追,おわれてしまった、どうして再,ふたたびあなたの聖,せいなる宮,みやを望,のぞみえようか』。","tok":[["["],["4"],["]"],["わたし"],["は"],["言った","いった"],["、"],["『"],["わたし"],["は"],["あなた"],["の"],["前","まえ"],["から"],["追われて","おわれて"],["しまった"],["、"],["どう"],["して"],["再び","ふたたび"],["あなた"],["の"],["聖","せい"],["なる"],["宮","みや"],["を"],["望み","のぞみ"],["えよう"],["か"],["』"],["。"]]},{"verse":6,"text":"[5]水,みずがわたしをめぐって魂,たましいにまでおよび、淵,ふちはわたしを取,とり囲,かこみ、海草,かいそうは山,やまの根元,ねもとでわたしの頭,あたまにまといついた。","tok":[["["],["5"],["]"],["水","みず"],["が"],["わたし"],["を"],["めぐって"],["魂","たましい"],["に"],["まで"],["および"],["、"],["淵","ふち"],["は"],["わたし"],["を"],["取囲み","とりかこみ"],["、"],["海草","かいそう"],["は"],["山","やま"],["の"],["根元","ねもと"],["で"],["わたし"],["の"],["頭","あたま"],["に"],["まといついた"],["。"]]},{"verse":7,"text":"[6]わたしは地,ちに下,くだり、地,ちの貫,かんの木,きはいつもわたしの上,うえにあった。しかしわが神,かみ、主,しゅよ、あなたはわが命,いのちを穴,あなから救,すくいあげられた。","tok":[["["],["6"],["]"],["わたし"],["は"],["地","ち"],["に"],["下り","くだり"],["、"],["地","ち"],["の"],["貫の木","かんのき"],["は"],["いつも"],["わたし"],["の"],["上","うえ"],["に"],["あった"],["。"],["しかし"],["わが"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["わが"],["命","いのち"],["を"],["穴","あな"],["から"],["救いあげられた","すくいあげられた"],["。"]]},{"verse":8,"text":"[7]わが魂,たましいがわたしのうちに弱,よわっているとき、わたしは主,しゅをおぼえ、わたしの祈,いのりはあなたに至,いたり、あなたの聖,せいなる宮,みやに達,たっした。","tok":[["["],["7"],["]"],["わが"],["魂","たましい"],["が"],["わたし"],["の"],["うち"],["に"],["弱って","よわって"],["いる"],["とき"],["、"],["わたし"],["は"],["主","しゅ"],["を"],["おぼえ"],["、"],["わたし"],["の"],["祈","いのり"],["は"],["あなた"],["に"],["至","いたり"],["、"],["あなた"],["の"],["聖","せい"],["なる"],["宮","みや"],["に"],["達した","たっした"],["。"]]},{"verse":9,"text":"[8]むなしい偶像,ぐうぞうに心,こころを寄,よせる者,ものは、そのまことの忠節,ちゅうせつを捨,すてる。","tok":[["["],["8"],["]"],["むなしい"],["偶像","ぐうぞう"],["に"],["心","こころ"],["を"],["寄せる","よせる"],["者","もの"],["は"],["、"],["その"],["まこと"],["の"],["忠節","ちゅうせつ"],["を"],["捨てる","すてる"],["。"]]},{"verse":10,"text":"[9]しかしわたしは感謝,かんしゃの声,こえをもって、あなたに犠牲,ぎせいをささげ、わたしの誓,ちかいをはたす。救,すくいは主,しゅにある」。","tok":[["["],["9"],["]"],["しかし"],["わたし"],["は"],["感謝","かんしゃ"],["の"],["声","こえ"],["を"],["もって"],["、"],["あなた"],["に"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["わたし"],["の"],["誓い","ちかい"],["を"],["はたす"],["。"],["救い","すくい"],["は"],["主に","しゅに"],["ある"],["」"],["。"]]},{"verse":11,"text":"[10]主,しゅは魚,うおにお命,めいじになったので、魚,うおはヨナを陸,りくに吐,はき出,だした。","tok":[["["],["10"],["]"],["主","しゅ"],["は"],["魚","うお"],["に"],["お命じ","おめいじ"],["に"],["なった"],["ので"],["、"],["魚","うお"],["は"],["ヨナ"],["を"],["陸","りく"],["に"],["吐出した","はきだした"],["。"]]}]
[{"verse":1,"text":"主,しゅの言葉,ことばがアミッタイの子,こヨナに臨,のぞんで言,いった、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["アミッタイ"],["の"],["子","こ"],["ヨナ"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":2,"text":"「立,たって、あの大,おおきな町,まちニネベに行,いき、これに向,むかって呼,よばわれ。彼,かれらの悪,あくがわたしの前,まえに上,のぼってきたからである」。","tok":[["「"],["立って","たって"],["、"],["あの"],["大きな","おおきな"],["町","まち"],["ニネベ"],["に"],["行き","いき"],["、"],["これ"],["に"],["向かって","むかって"],["呼ばわれ","よばわれ"],["。"],["彼","かれ"],["ら"],["の"],["悪","あく"],["が"],["わたし"],["の"],["前","まえ"],["に"],["上って","のぼって"],["きた"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":3,"text":"しかしヨナは主,しゅの前,まえを離,はなれてタルシシへのがれようと、立,たってヨッパに下,くだって行,いった。ところがちょうど、タルシシへ行,いく船,ふねがあったので、船賃,ふなちんを払,はらい、主,しゅの前,まえを離,はなれて、人々,ひとびとと共,ともにタルシシへ行,いこうと船,ふねに乗,のった。","tok":[["しかし"],["ヨナ"],["は"],["主","しゅ"],["の"],["前","まえ"],["を"],["離れて","はなれて"],["タルシシ"],["へ"],["のがれよう"],["と"],["、"],["立って","たって"],["ヨッパ"],["に"],["下って","くだって"],["行った","いった"],["。"],["ところ"],["が"],["ちょうど"],["、"],["タルシシ"],["へ"],["行く","いく"],["船","ふね"],["が"],["あった"],["ので"],["、"],["船賃","ふなちん"],["を"],["払","はらい"],["、"],["主","しゅ"],["の"],["前","まえ"],["を"],["離れて","はなれて"],["、"],["人々","ひとびと"],["と"],["共","とも"],["に"],["タルシシ"],["へ"],["行こう","いこう"],["と"],["船","ふね"],["に"],["乗った","のった"],["。"]]},{"verse":4,"text":"時,ときに、主,しゅは大風,おおかぜを海,うみの上,うえに起,おこされたので、船,ふねが破,やぶれるほどの激,はげしい暴風,ぼうふうが海,うみの上,うえにあった。","tok":[["時","とき"],["に"],["、"],["主","しゅ"],["は"],["大風","おおかぜ"],["を"],["海","うみ"],["の"],["上","うえ"],["に"],["起こされた","おこされた"],["ので"],["、"],["船","ふね"],["が"],["破れる","やぶれる"],["ほど"],["の"],["激しい","はげしい"],["暴風","ぼうふう"],["が"],["海","うみ"],["の"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":5,"text":"それで水夫,すいふたちは恐,おそれて、めいめい自分,じぶんの神,かみを呼,よび求,もとめ、また船,ふねを軽,かるくするため、その中,なかの積,つみ荷,にを海,うみに投,なげ捨,すてた。しかし、ヨナは船,ふねの奥,おくに下,くだり、伏,ふして熟睡,じゅくすいしていた。","tok":[["それ"],["で"],["水夫","すいふ"],["たち"],["は"],["恐れて","おそれて"],["、"],["めいめい"],["自分","じぶん"],["の"],["神","かみ"],["を"],["呼び求め","よびもとめ"],["、"],["また"],["船","ふね"],["を"],["軽く","かるく"],["する"],["ため"],["、"],["その"],["中","なか"],["の"],["積み荷","つみに"],["を"],["海","うみ"],["に"],["投捨てた","なげすてた"],["。"],["しかし"],["、"],["ヨナ"],["は"],["船","ふね"],["の"],["奥","おく"],["に"],["下り","くだり"],["、"],["伏して","ふして"],["熟睡","じゅくすい"],["して"],["いた"],["。"]]},{"verse":6,"text":"そこで船長,せんちょうは来,きて、彼,かれに言,いった、「あなたはどうして眠,ねむっているのか。起,おきて、あなたの神,かみに呼,よばわりなさい。神,かみがあるいは、われわれを顧,かえりみて、助,たすけてくださるだろう」。","tok":[["そこ"],["で"],["船長","せんちょう"],["は"],["来て","きて"],["、"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["どう"],["して"],["眠って","ねむって"],["いる"],["の"],["か"],["。"],["起きて","おきて"],["、"],["あなた"],["の"],["神","かみ"],["に"],["呼ばわり","よばわり"],["なさい"],["。"],["神","かみ"],["が"],["あるいは"],["、"],["われわれ"],["を"],["顧て","かえりみて"],["、"],["助けて","たすけて"],["くださるだろう"],["」"],["。"]]},{"verse":7,"text":"やがて人々,ひとびとは互,たがいに言,いった、「この災,わざわいがわれわれに臨,のぞんだのは、だれのせいか知,しるために、さあ、くじを引,ひいてみよう」。そして彼,かれらが、くじを引,ひいたところ、くじはヨナに当,あたった。","tok":[["やがて"],["人々","ひとびと"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["この"],["災","わざわい"],["が"],["われわれ"],["に"],["臨","のぞんだ"],["の"],["は"],["、"],["だれ"],["の"],["せい"],["か"],["知る","しる"],["ため"],["に"],["、"],["さあ"],["、"],["くじ"],["を"],["引いて","ひいて"],["みよう"],["」"],["。"],["そして"],["彼","かれ"],["ら"],["が"],["、"],["くじ"],["を"],["引いた","ひいた"],["ところ"],["、"],["くじ"],["は"],["ヨナ"],["に"],["当たった","あたった"],["。"]]},{"verse":8,"text":"そこで人々,ひとびとはヨナに言,いった、「この災,わざわいがだれのせいで、われわれに臨,のぞんだのか、われわれに告,つげなさい。あなたの職業,しょくぎょうは何,なにか。あなたはどこから来,きたのか。あなたの国,くにはどこか。あなたはどこの民,たみか」。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["ヨナ"],["に"],["言った","いった"],["、"],["「"],["この"],["災","わざわい"],["が"],["だれ"],["の"],["せい"],["で"],["、"],["われわれ"],["に"],["臨","のぞんだ"],["の"],["か"],["、"],["われわれ"],["に"],["告","つげ"],["なさい"],["。"],["あなた"],["の"],["職業","しょくぎょう"],["は"],["何に","なに"],["か"],["。"],["あなた"],["は"],["どこ"],["から"],["来た","きた"],["の"],["か"],["。"],["あなた"],["の"],["国","くに"],["は"],["どこ"],["か"],["。"],["あなた"],["は"],["どこ"],["の"],["民","たみ"],["か"],["」"],["。"]]},{"verse":9,"text":"ヨナは彼,かれらに言,いった、「わたしはヘブルびとです。わたしは海,うみと陸,りくとをお造,つくりになった天,てんの神,かみ、主,しゅを恐,おそれる者,ものです」。","tok":[["ヨナ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["ヘブル"],["びと"],["です"],["。"],["わたし"],["は"],["海","うみ"],["と"],["陸","りく"],["と"],["を"],["お造","おつくり"],["に"],["なった"],["天","てん"],["の"],["神","かみ"],["、"],["主","しゅ"],["を"],["恐れる","おそれる"],["者","もの"],["です"],["」"],["。"]]},{"verse":10,"text":"そこで人々,ひとびとははなはだしく恐,おそれて、彼,かれに言,いった、「あなたはなんたる事,ことをしてくれたのか」。人々,ひとびとは彼,かれがさきに彼,かれらに告,つげた事,ことによって、彼,かれが主,しゅの前,まえを離,はなれて、のがれようとしていた事,ことを知,しっていたからである。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["はなはだしく"],["恐れて","おそれて"],["、"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["なんたる"],["事","こと"],["を"],["して"],["くれた"],["の"],["か"],["」"],["。"],["人々","ひとびと"],["は"],["彼","かれ"],["が"],["さき"],["に"],["彼","かれ"],["ら"],["に"],["告","つげ"],["た"],["事","こと"],["によって"],["、"],["彼","かれ"],["が"],["主","しゅ"],["の"],["前","まえ"],["を"],["離れて","はなれて"],["、"],["のがれよう"],["として"],["いた"],["事","こと"],["を"],["知って","しって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":11,"text":"人々,ひとびとは彼,かれに言,いった、「われわれのために海,うみが静,しずまるには、あなたをどうしたらよかろうか」。それは海,うみがますます荒,あれてきたからである。","tok":[["人々","ひとびと"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["われわれ"],["の"],["ため"],["に"],["海","うみ"],["が"],["静まる","しずまる"],["に"],["は"],["、"],["あなた"],["を"],["どう"],["したら"],["よかろう"],["か"],["」"],["。"],["それ"],["は"],["海","うみ"],["が"],["ますます"],["荒れて","あれて"],["きた"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"ヨナは彼,かれらに言,いった、「わたしを取,とって海,うみに投,なげ入,いれなさい。そうしたら海,うみは、あなたがたのために静,しずまるでしょう。わたしにはよくわかっています。この激,はげしい暴風,ぼうふうがあなたがたに臨,のぞんだのは、わたしのせいです」。","tok":[["ヨナ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["を"],["取って","とって"],["海","うみ"],["に"],["投入れ","なげいれ"],["なさい"],["。"],["そう"],["したら"],["海","うみ"],["は"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["静まるでしょう","しずまるでしょう"],["。"],["わたし"],["に"],["は"],["よく"],["わかって"],["います"],["。"],["この"],["激しい","はげしい"],["暴風","ぼうふう"],["が"],["あなた"],["がた"],["に"],["臨","のぞんだ"],["の"],["は"],["、"],["わたし"],["の"],["せい"],["です"],["」"],["。"]]},{"verse":13,"text":"しかし人々,ひとびとは船,ふねを陸,りくにこぎもどそうとつとめたが、成功,せいこうしなかった。それは海,うみが彼,かれらに逆,さからって、いよいよ荒,あれたからである。","tok":[["しかし"],["人々","ひとびと"],["は"],["船","ふね"],["を"],["陸","りく"],["に"],["こぎ"],["もどそう"],["と"],["つとめた"],["が"],["、"],["成功","せいこう"],["しなかった"],["。"],["それ"],["は"],["海","うみ"],["が"],["彼","かれ"],["ら"],["に"],["逆らって","さからって"],["、"],["いよいよ"],["荒れた","あれた"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"そこで人々,ひとびとは主,しゅに呼,よばわって言,いった、「主,しゅよ、どうぞ、この人,ひとの生命,せいめいのために、われわれを滅,ほろぼさないでください。また罪,つみなき血,ちを、われわれに帰,きしないでください。主,しゅよ、これはみ心,こころに従,したがって、なされた事,ことだからです」。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["主に","しゅに"],["呼ばわって","よばわって"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["どうぞ"],["、"],["この"],["人","ひと"],["の"],["生命","せいめい"],["の"],["ため"],["に"],["、"],["われわれ"],["を"],["滅ぼさないで","ほろぼさないで"],["ください"],["。"],["また"],["罪","つみ"],["なき"],["血","ち"],["を"],["、"],["われわれ"],["に"],["帰しないで","きしないで"],["ください"],["。"],["主","しゅ"],["よ"],["、"],["これ"],["は"],["み心","みこころ"],["に"],["従って","したがって"],["、"],["なされた"],["事","こと"],["だ"],["から"],["です"],["」"],["。"]]},{"verse":15,"text":"そして彼,かれらはヨナを取,とって海,うみに投,なげ入,いれた。すると海,うみの荒,あれるのがやんだ。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["ヨナ"],["を"],["取って","とって"],["海","うみ"],["に"],["投入れた","なげいれた"],["。"],["する"],["と"],["海","うみ"],["の"],["荒れる","あれる"],["の"],["が"],["やんだ"],["。"]]},{"verse":16,"text":"そこで人々,ひとびとは大,おおいに主,しゅを恐,おそれ、犠牲,ぎせいを主,しゅにささげて、誓願,せいがんを立,たてた。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["大いに","おおいに"],["主","しゅ"],["を"],["恐","おそれ"],["、"],["犠牲","ぎせい"],["を"],["主に","しゅに"],["ささげて"],["、"],["誓願","せいがん"],["を"],["立てた","たてた"],["。"]]}]
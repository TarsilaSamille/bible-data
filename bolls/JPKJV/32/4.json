[{"verse":1,"text":"ところがヨナはこれを非常,ひじょうに不快,ふかいとして、激,はげしく怒,いかり、","tok":[["ところ"],["が"],["ヨナ"],["は"],["これ"],["を"],["非常","ひじょう"],["に"],["不快","ふかい"],["として"],["、"],["激しく","はげしく"],["怒り","いかり"],["、"]]},{"verse":2,"text":"主,しゅに祈,いのって言,いった、「主,しゅよ、わたしがなお国,くににおりました時,とき、この事,ことを申,もうしたではありませんか。それでこそわたしは、急,いそいでタルシシにのがれようとしたのです。なぜなら、わたしはあなたが恵,めぐみ深,ふかい神,かみ、あわれみあり、怒,いかることおそく、いつくしみ豊,ゆたかで、災,わざわいを思,おもいかえされることを、知,しっていたからです。","tok":[["主に","しゅに"],["祈って","いのって"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["が"],["なお"],["国","くに"],["に"],["おりました"],["時","とき"],["、"],["この"],["事","こと"],["を"],["申したで","もうしたで"],["は"],["ありません"],["か"],["。"],["それ"],["で"],["こそ"],["わたし"],["は"],["、"],["急いで","いそいで"],["タルシシ"],["に"],["のがれよう"],["と"],["した"],["の"],["です"],["。"],["なぜ"],["なら"],["、"],["わたし"],["は"],["あなた"],["が"],["恵深","めぐみふ"],["か"],["い"],["神","かみ"],["、"],["あわれみ"],["あり"],["、"],["怒","いかるこ"],["と"],["おそく"],["、"],["いつくしみ"],["豊","ゆたか"],["で"],["、"],["災","わざわい"],["を"],["思いかえされる","おもいかえされる"],["こと"],["を"],["、"],["知って","しって"],["いた"],["から"],["です"],["。"]]},{"verse":3,"text":"それで主,しゅよ、どうぞ今,いまわたしの命,いのちをとってください。わたしにとっては、生,いきるよりも死,しぬ方,ほうがましだからです」。","tok":[["それ"],["で"],["主","しゅ"],["よ"],["、"],["どうぞ"],["今","いま"],["わたし"],["の"],["命","いのち"],["を"],["とって"],["ください"],["。"],["わたし"],["にとって"],["は"],["、"],["生きる","いきる"],["より"],["も"],["死ぬ","しぬ"],["方","ほう"],["が"],["まし"],["だ"],["から"],["です"],["」"],["。"]]},{"verse":4,"text":"主,しゅは言,いわれた、「あなたの怒,いかるのは、よいことであろうか」。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["怒","いかる"],["の"],["は"],["、"],["よい"],["こと"],["で"],["あろう"],["か"],["」"],["。"]]},{"verse":5,"text":"そこでヨナは町,まちから出,でて、町,まちの東,ひがしの方,ほうに座,ざし、そこに自分,じぶんのために一,ひとつの小屋,こやを造,つくり、町,まちのなりゆきを見,みきわめようと、その下,したの日,ひ陰,かげにすわっていた。","tok":[["そこ"],["で"],["ヨナ"],["は"],["町","まち"],["から"],["出て","でて"],["、"],["町","まち"],["の"],["東","ひがし"],["の"],["方","ほう"],["に"],["座し","ざし"],["、"],["そこ"],["に"],["自分","じぶん"],["の"],["ため"],["に"],["一","ひと"],["つ"],["の"],["小屋","こや"],["を"],["造","つくり"],["、"],["町","まち"],["の"],["なりゆき"],["を"],["見きわめよう","みきわめよう"],["と"],["、"],["その"],["下","した"],["の"],["日陰","ひかげ"],["に"],["すわって"],["いた"],["。"]]},{"verse":6,"text":"時,ときに主,しゅなる神,かみは、ヨナを暑,あつさの苦痛,くつうから救,すくうために、とうごまを備,そなえて、それを育,そだて、ヨナの頭,あたまの上,うえに日陰,ひかげを設,もうけた。ヨナはこのとうごまを非常,ひじょうに喜,よろこんだ。","tok":[["時","とき"],["に"],["主","しゅ"],["なる"],["神","かみ"],["は"],["、"],["ヨナ"],["を"],["暑さ","あつさ"],["の"],["苦痛","くつう"],["から"],["救う","すくう"],["ため"],["に"],["、"],["と"],["う"],["ごま"],["を"],["備","そなえ"],["て"],["、"],["それ"],["を"],["育て","そだて"],["、"],["ヨナ"],["の"],["頭","あたま"],["の"],["上","うえ"],["に"],["日陰","ひかげ"],["を"],["設けた","もうけた"],["。"],["ヨナ"],["は"],["この"],["とう"],["ごま"],["を"],["非常","ひじょう"],["に"],["喜こんだ","よろこんだ"],["。"]]},{"verse":7,"text":"ところが神,かみは翌日,よくじつの夜明,よあけに虫,むしを備,そなえて、そのとうごまをかませられたので、それは枯,かれた。","tok":[["ところ"],["が"],["神","かみ"],["は"],["翌日","よくじつ"],["の"],["夜明","よあけ"],["に"],["虫","むし"],["を"],["備","そなえ"],["て"],["、"],["その"],["とう"],["ごま"],["を"],["かませられた"],["ので"],["、"],["それ"],["は"],["枯た","かれた"],["。"]]},{"verse":8,"text":"やがて太陽,たいようが出,でたとき、神,かみが暑,あつい東風,ひがしかぜを備,そなえ、また太陽,たいようがヨナの頭,あたまを照,てらしたので、ヨナは弱,よわりはて、死,しぬことを願,ねがって言,いった、「生,いきるよりも死,しぬ方,ほうがわたしにはましだ」。","tok":[["やがて"],["太陽","たいよう"],["が"],["出た","でた"],["とき"],["、"],["神","かみ"],["が"],["暑い","あつい"],["東風","ひ"],["が"],["し"],["かぜ"],["を"],["備","そなえ"],["、"],["また"],["太陽","たいよう"],["が"],["ヨナ"],["の"],["頭","あたま"],["を"],["照","てらし"],["た"],["ので"],["、"],["ヨナ"],["は"],["弱り","よわり"],["はて"],["、"],["死ぬ","しぬ"],["こと"],["を"],["願って","ねがって"],["言った","いった"],["、"],["「"],["生きる","いきる"],["より"],["も"],["死ぬ","しぬ"],["方","ほう"],["が"],["わたし"],["に"],["は"],["まし"],["だ"],["」"],["。"]]},{"verse":9,"text":"しかし神,かみはヨナに言,いわれた、「とうごまのためにあなたの怒,いかるのはよくない」。ヨナは言,いった、「わたしは怒,いかりのあまり狂,くるい死,しにそうです」。","tok":[["しかし"],["神","かみ"],["は"],["ヨナ"],["に"],["言われた","いわれた"],["、"],["「"],["とう"],["ごま"],["の"],["ため"],["に"],["あなた"],["の"],["怒","いかる"],["の"],["は"],["よく"],["ない"],["」"],["。"],["ヨナ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["怒り","いかり"],["の"],["あまり"],["狂い死に","くるいしに"],["そう"],["です"],["」"],["。"]]},{"verse":10,"text":"主,しゅは言,いわれた、「あなたは労,ろうせず、育,そだてず、一夜,やに生,しょうじて、一夜,やに滅,ほろびたこのとうごまをさえ、惜,おしんでいる。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["労せず","ろうせず"],["、"],["育てず","そだてず"],["、"],["一夜","や"],["に"],["生じて","しょうじて"],["、"],["一夜","や"],["に"],["滅びた","ほろびた"],["この"],["とう"],["ごま"],["を"],["さえ"],["、"],["惜しんで","おしんで"],["いる"],["。"]]},{"verse":11,"text":"ましてわたしは十二万,まんあまりの、右左,みぎひだりをわきまえない人々,ひとびとと、あまたの家畜,かちくとのいるこの大,おおきな町,まちニネベを、惜,おしまないでいられようか」。","tok":[["まして"],["わたし"],["は"],["十二万","まんあまり"],["の"],["、"],["右左","みぎひだり"],["を"],["わきまえない"],["人々","ひとびと"],["と"],["、"],["あまた"],["の"],["家畜","かちく"],["と"],["の"],["いる"],["この"],["大きな","おおきな"],["町","まち"],["ニネベ"],["を"],["、"],["惜まないで","おしまないで"],["いられよう"],["か"],["」"],["。"]]}]
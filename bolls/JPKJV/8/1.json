[{"verse":1,"text":"さばきづかさが世,よを治,おさめているころ、国,くにに飢,ききんがあったので、ひとりの人,ひとがその妻,つまとふたりの男,おとこの子,こを連,つれてユダのベツレヘムを去,さり、モアブの地,ちへ行,いってそこに滞在,たいざいした。","tok":[["さばき"],["づかさ"],["が"],["世","よ"],["を"],["治めて","おさめて"],["いる"],["ころ"],["、"],["国","くに"],["に"],["飢きん","ききん"],["が"],["あった"],["ので"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["その"],["妻","つま"],["と"],["ふたり"],["の"],["男の子","おとこのこ"],["を"],["連れて","つれて"],["ユダ"],["の"],["ベツレヘム"],["を"],["去り","さり"],["、"],["モアブ"],["の"],["地","ち"],["へ"],["行って","いって"],["そこ"],["に"],["滞在","たいざい"],["した"],["。"]]},{"verse":2,"text":"その人,ひとの名,なはエリメレク、妻,つまの名,なはナオミ、ふたりの男,おとこの子,この名,なはマロンとキリオンといい、ユダのベツレヘムのエフラタびとであった。彼,かれらはモアブの地,ちへ行,いって、そこにおったが、","tok":[["その"],["人","ひと"],["の"],["名","な"],["は"],["エリメレク"],["、"],["妻","つま"],["の"],["名","な"],["は"],["ナオミ"],["、"],["ふたり"],["の"],["男の子","おとこのこ"],["の"],["名","な"],["は"],["マロン"],["と"],["キリオン"],["と"],["いい"],["、"],["ユダ"],["の"],["ベツレヘム"],["の"],["エフラタ"],["びと"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["モアブ"],["の"],["地","ち"],["へ"],["行って","いって"],["、"],["そこ"],["に"],["おった"],["が"],["、"]]},{"verse":3,"text":"ナオミの夫,おっとエリメレクは死,しんで、ナオミとふたりの男,おとこの子,こが残,のこされた。","tok":[["ナオミ"],["の"],["夫","おっと"],["エリメレク"],["は"],["死んで","しんで"],["、"],["ナオミ"],["と"],["ふたり"],["の"],["男の子","おとこのこ"],["が"],["残された","のこされた"],["。"]]},{"verse":4,"text":"ふたりの男,おとこの子,こはそれぞれモアブの女,おんなを妻,つまに迎,むかえた。そのひとりの名,なはオルパといい、ひとりの名,なはルツといった。彼,かれらはそこに十年,ねんほど住,すんでいたが、","tok":[["ふたり"],["の"],["男の子","おとこのこ"],["は"],["それぞれ"],["モアブ"],["の"],["女","おんな"],["を"],["妻","つま"],["に"],["迎","むかえ"],["た"],["。"],["その"],["ひとり"],["の"],["名","な"],["は"],["オルパ"],["と"],["いい"],["、"],["ひとり"],["の"],["名","な"],["は"],["ルツ"],["と"],["いった"],["。"],["彼","かれ"],["ら"],["は"],["そこ"],["に"],["十","じゅう"],["年","ねん"],["ほど"],["住んで","すんで"],["いた"],["が"],["、"]]},{"verse":5,"text":"マロンとキリオンのふたりもまた死,しんだ。こうしてナオミはふたりの子,こと夫,おっととに先,さきだたれた。","tok":[["マロン"],["と"],["キリオン"],["の"],["ふたり"],["も"],["また"],["死んだ","しんだ"],["。"],["こう"],["して"],["ナオミ"],["は"],["ふたり"],["の"],["子","こ"],["と"],["夫","おっと"],["と"],["に"],["先だたれた","さきだたれた"],["。"]]},{"verse":6,"text":"その時,とき、ナオミはモアブの地,ちで、主,しゅがその民,たみを顧,かえりみて、すでに食物,しょくもつをお与,あたえになっていることを聞,きいたので、その嫁,よめと共,ともに立,たって、モアブの地,ちからふるさとへ帰,かえろうとした。","tok":[["その"],["時","とき"],["、"],["ナオミ"],["は"],["モアブ"],["の"],["地","ち"],["で"],["、"],["主","しゅがそ"],["の"],["民","たみ"],["を"],["顧て","かえりみて"],["、"],["すでに"],["食物","しょくもつ"],["を"],["お"],["与","あたえ"],["に"],["なって"],["いる"],["こと"],["を"],["聞いた","きいた"],["ので"],["、"],["その"],["嫁","よめ"],["と"],["共","とも"],["に"],["立って","たって"],["、"],["モアブ"],["の"],["地","ち"],["から"],["ふるさと"],["へ"],["帰えろう","かえろう"],["と"],["した"],["。"]]},{"verse":7,"text":"そこで彼女,かのじょは今,いまいる所,ところを出立,しゅったつし、ユダの地,ちへ帰,かえろうと、ふたりの嫁,よめを連,つれて道,みちに進,すすんだ。","tok":[["そこ"],["で"],["彼女","かのじょ"],["は"],["今","いま"],["いる"],["所","ところ"],["を"],["出立","しゅったつ"],["し"],["、"],["ユダ"],["の"],["地","ち"],["へ"],["帰えろう","かえろう"],["と"],["、"],["ふたり"],["の"],["嫁","よめ"],["を"],["連れて","つれて"],["道","みち"],["に"],["進んだ","すすんだ"],["。"]]},{"verse":8,"text":"しかしナオミはふたりの嫁,よめに言,いった、「あなたがたは、それぞれ自分,じぶんの母,ははの家,いえに帰,かえって行,いきなさい。あなたがたが、死,しんだふたりの子,ことわたしに親切,しんせつをつくしたように、どうぞ、主,しゅがあなたがたに、いつくしみを賜,たまわりますよう。","tok":[["しかし"],["ナオミ"],["は"],["ふたり"],["の"],["嫁","よめ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["それぞれ"],["自分","じぶん"],["の"],["母","はは"],["の"],["家","いえ"],["に"],["帰えって","かえって"],["行き","いき"],["なさい"],["。"],["あなた"],["が"],["た"],["が"],["、"],["死んだ","しんだ"],["ふたり"],["の"],["子","こ"],["と"],["わたし"],["に"],["親切","しんせつ"],["を"],["つくした"],["よう"],["に"],["、"],["どうぞ"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["に"],["、"],["いつくしみ"],["を"],["賜わります","たまわります"],["よう"],["。"]]},{"verse":9,"text":"どうぞ、主,しゅがあなたがたに夫,おっとを与,あたえ、夫,おっとの家,いえで、それぞれ身,みの落,おち着,つき所,ところを得,えさせられるように」。こう言,いって、ふたりの嫁,よめに口,くちづけしたので、彼,かれらは声,こえをあげて泣,なき、","tok":[["どうぞ"],["、"],["主","しゅ"],["が"],["あなた"],["がた"],["に"],["夫","おっと"],["を"],["与","あたえ"],["、"],["夫","おっと"],["の"],["家","いえ"],["で"],["、"],["それぞれ"],["身","み"],["の"],["落着き所","おちつきところ"],["を"],["得させられる","えさせられる"],["よう"],["に"],["」"],["。"],["こう"],["言って","いって"],["、"],["ふたり"],["の"],["嫁","よめ"],["に"],["口づけ","くちづけ"],["した"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["声","こえ"],["を"],["あげて"],["泣","なき"],["、"]]},{"verse":10,"text":"ナオミに言,いった、「いいえ、わたしたちは一緒,いっしょにあなたの民,たみのところへ帰,かえります」。","tok":[["ナオミ"],["に"],["言った","いった"],["、"],["「"],["いいえ"],["、"],["わたしたち"],["は"],["一緒","いっしょ"],["に"],["あなた"],["の"],["民","たみ"],["の"],["ところ"],["へ"],["帰えります","かえります"],["」"],["。"]]},{"verse":11,"text":"しかしナオミは言,いった、「娘,むすめたちよ、帰,かえって行,いきなさい。どうして、わたしと一緒,いっしょに行,いこうというのですか。あなたがたの夫,おっととなる子,こがまだわたしの胎内,たいないにいると思,おもうのですか。","tok":[["しかし"],["ナオミ"],["は"],["言った","いった"],["、"],["「"],["娘","むすめ"],["たち"],["よ"],["、"],["帰えって","かえって"],["行き","いき"],["なさい"],["。"],["どう"],["して"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["行こう","いこう"],["と"],["いう"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["の"],["夫","おっと"],["と"],["なる"],["子","こ"],["が"],["まだ"],["わたし"],["の"],["胎内","たいない"],["に"],["いる"],["と"],["思","おもう"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"娘,むすめたちよ、帰,かえって行,いきなさい。わたしは年,としをとっているので、夫,おっとをもつことはできません。たとい、わたしが今夜,こんや、夫,おっとをもち、また子,こを産,うむ望,のぞみがあるとしても、","tok":[["娘","むすめ"],["たち"],["よ"],["、"],["帰えって","かえって"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["年","とし"],["を"],["とって"],["いる"],["ので"],["、"],["夫","おっと"],["を"],["もつ"],["こと"],["は"],["できません"],["。"],["たとい"],["、"],["わたし"],["が"],["今夜","こんや"],["、"],["夫","おっと"],["を"],["もち"],["、"],["また子","またこ"],["を"],["産む","うむ"],["望み","のぞみ"],["が"],["ある"],["として"],["も"],["、"]]},{"verse":13,"text":"そのためにあなたがたは、子,こどもの成長,せいちょうするまで待,まっているつもりなのですか。あなたがたは、そのために夫,おっとをもたずにいるつもりなのですか。娘,むすめたちよ、それはいけません。主,しゅの手,てがわたしに臨,のぞみ、わたしを責,せめられたことで、あなたがたのために、わたしは非常,ひじょうに心,こころを痛,いためているのです」。","tok":[["その"],["ため"],["に"],["あなた"],["がた"],["は"],["、"],["子ども","こども"],["の"],["成長","せいちょう"],["する"],["まで"],["待って","まって"],["いる"],["つもり"],["な"],["の"],["です"],["か"],["。"],["あなた"],["がた"],["は"],["、"],["その"],["ため"],["に"],["夫","おっと"],["を"],["もたず"],["に"],["いる"],["つもり"],["な"],["の"],["です"],["か"],["。"],["娘","むすめ"],["たち"],["よ"],["、"],["それ"],["は"],["いけません"],["。"],["主","しゅ"],["の"],["手","て"],["が"],["わたし"],["に"],["臨み","のぞみ"],["、"],["わたし"],["を"],["責","せめ"],["られた"],["こと"],["で"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["非常","ひじょう"],["に"],["心","こころ"],["を"],["痛めて","いためて"],["いる"],["の"],["です"],["」"],["。"]]},{"verse":14,"text":"彼,かれらはまた声,こえをあげて泣,ないた。そしてオルパはそのしゅうとめに口,くちづけしたが、ルツはしゅうとめを離,はなれなかった。","tok":[["彼","かれ"],["ら"],["は"],["また"],["声","こえ"],["を"],["あげて"],["泣いた","ないた"],["。"],["そして"],["オルパ"],["は"],["その"],["しゅうとめ"],["に"],["口づけ","くちづけ"],["した"],["が"],["、"],["ルツ"],["は"],["しゅうとめ"],["を"],["離れなかった","はなれなかった"],["。"]]},{"verse":15,"text":"そこでナオミは言,いった、「ごらんなさい。あなたの相嫁,あいよめは自分,じぶんの民,たみと自分,じぶんの神々,かみがみのもとへ帰,かえって行,いきました。あなたも相嫁,あいよめのあとについて帰,かえりなさい」。","tok":[["そこ"],["で"],["ナオミ"],["は"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["。"],["あなた"],["の"],["相嫁","あいよめ"],["は"],["自分","じぶん"],["の"],["民","たみ"],["と"],["自分","じぶん"],["の"],["神々","かみがみ"],["の"],["もと"],["へ"],["帰えって","かえって"],["行きました","いきました"],["。"],["あなた"],["も"],["相嫁","あいよめ"],["の"],["あと"],["について"],["帰えり","かえり"],["なさい"],["」"],["。"]]},{"verse":16,"text":"しかしルツは言,いった、「あなたを捨,すて、あなたを離,はなれて帰,かえることをわたしに勧,すすめないでください。わたしはあなたの行,いかれる所,ところへ行,いき、またあなたの宿,やどられる所,ところに宿,やどります。あなたの民,たみはわたしの民,たみ、あなたの神,かみはわたしの神,かみです。","tok":[["しかし"],["ルツ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["を"],["捨て","すて"],["、"],["あなた"],["を"],["離れて","はなれて"],["帰える","かえる"],["こと"],["を"],["わたし"],["に"],["勧めないで","すすめないで"],["ください"],["。"],["わたし"],["は"],["あなた"],["の"],["行かれる","いかれる"],["所","ところ"],["へ"],["行き","いき"],["、"],["また"],["あなた"],["の"],["宿られる","やどられる"],["所","ところ"],["に"],["宿ります","やどります"],["。"],["あなた"],["の"],["民","たみ"],["は"],["わたし"],["の"],["民","たみ"],["、"],["あなた"],["の"],["神","かみ"],["は"],["わたし"],["の"],["神","かみ"],["です"],["。"]]},{"verse":17,"text":"あなたの死,しなれる所,ところでわたしも死,しんで、そのかたわらに葬,ほうむられます。もし死,しに別,わかれでなく、わたしがあなたと別,わかれるならば、主,しゅよ、どうぞわたしをいくえにも罰,ばっしてください」。","tok":[["あなた"],["の"],["死なれる","しなれる"],["所","ところ"],["で"],["わたし"],["も"],["死んで","しんで"],["、"],["その"],["かたわら"],["に"],["葬むられます","ほうむられます"],["。"],["もし"],["死","し"],["に"],["別かれで","わかれで"],["なく"],["、"],["わたし"],["が"],["あなた"],["と"],["別かれるならば","わかれるならば"],["、"],["主","しゅ"],["よ"],["、"],["どうぞ"],["わたし"],["を"],["いく"],["え"],["に"],["も"],["罰して","ばっして"],["ください"],["」"],["。"]]},{"verse":18,"text":"ナオミはルツが自分,じぶんと一緒,いっしょに行,いこうと、固,かたく決心,けっしんしているのを見,みたので、そのうえ言,いうことをやめた。","tok":[["ナオミ"],["は"],["ルツ"],["が"],["自分","じぶん"],["と"],["一緒","いっしょ"],["に"],["行こう","いこう"],["と"],["、"],["固く","かたく"],["決心","けっしん"],["して"],["いる"],["の"],["を"],["見た","みた"],["ので"],["、"],["その"],["うえ"],["言う","いう"],["こと"],["を"],["やめた"],["。"]]},{"verse":19,"text":"そしてふたりは旅,たびをつづけて、ついにベツレヘムに着,ついた。彼,かれらがベツレヘムに着,ついたとき、町,まちはこぞって彼,かれらのために騒,さわぎたち、女,おんなたちは言,いった、「これはナオミですか」。","tok":[["そして"],["ふたり"],["は"],["旅","たび"],["を"],["つづけて"],["、"],["ついに"],["ベツレヘム"],["に"],["着いた","ついた"],["。"],["彼","かれ"],["ら"],["が"],["ベツレヘム"],["に"],["着いた","ついた"],["とき"],["、"],["町","まち"],["は"],["こぞって"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["騒","さわぎ"],["たち"],["、"],["女","おんな"],["たち"],["は"],["言った","いった"],["、"],["「"],["これ"],["は"],["ナオミ"],["です"],["か"],["」"],["。"]]},{"verse":20,"text":"ナオミは彼,かれらに言,いった、「わたしをナオミ（楽,たのしみ）と呼,よばずに、マラ（苦,くるしみ）と呼,よんでください。なぜなら全能者,ぜんのうしゃがわたしをひどく苦,くるしめられたからです。","tok":[["ナオミ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["わたし"],["を"],["ナオミ"],["（"],["楽み","たのしみ"],["）"],["と"],["呼ばず","よばず"],["に"],["、"],["マラ"],["（"],["苦しみ","くるしみ"],["）"],["と"],["呼んで","よんで"],["ください"],["。"],["なぜ"],["なら"],["全能者","ぜんのうしゃ"],["が"],["わたし"],["を"],["ひどく"],["苦しめられた","くるしめられた"],["から"],["です"],["。"]]},{"verse":21,"text":"わたしは出,でて行,いくときは豊,ゆたかでありましたが、主,しゅはわたしをから手,てで帰,かえされました。主,しゅがわたしを悩,なやまし、全能者,ぜんのうしゃがわたしに災,わざわいをくだされたのに、どうしてわたしをナオミと呼,よぶのですか」。","tok":[["わたし"],["は"],["出て","でて"],["行く","いく"],["とき"],["は"],["豊","ゆたか"],["で"],["ありました"],["が"],["、"],["主","しゅ"],["は"],["わたし"],["を"],["から"],["手","て"],["で"],["帰されました","かえされました"],["。"],["主","しゅ"],["が"],["わたし"],["を"],["悩し","なやまし"],["、"],["全能者","ぜんのうしゃ"],["が"],["わたし"],["に"],["災","わざわい"],["を"],["くだされた"],["のに"],["、"],["どう"],["して"],["わたし"],["を"],["ナオミ"],["と"],["呼ぶ","よぶ"],["の"],["です"],["か"],["」"],["。"]]},{"verse":22,"text":"こうしてナオミは、モアブの地,ちから帰,かえった嫁,よめ、モアブの女,おんなルツと一緒,いっしょに帰,かえってきて、大麦,おおむぎ刈,かりの初,はじめにベツレヘムに着,ついた。","tok":[["こう"],["して"],["ナオミ"],["は"],["、"],["モアブ"],["の"],["地","ち"],["から"],["帰えった","かえった"],["嫁","よめ"],["、"],["モアブ"],["の"],["女","おんな"],["ルツ"],["と"],["一緒","いっしょ"],["に"],["帰えって","かえって"],["きて"],["、"],["大麦刈","おおむぎかり"],["の"],["初め","はじめ"],["に"],["ベツレヘム"],["に"],["着いた","ついた"],["。"]]}]
[{"verse":1,"text":"さてナオミには、夫,おっとエリメレクの一族,いちぞくで、非常,ひじょうに裕福,ゆうふくなひとりの親戚,しんせきがあって、その名,なをボアズといった。","tok":[["さて"],["ナオミ"],["に"],["は"],["、"],["夫","おっと"],["エリメレク"],["の"],["一族","いちぞく"],["で"],["、"],["非常","ひじょう"],["に"],["裕福","ゆうふく"],["な"],["ひとり"],["の"],["親戚","しんせき"],["が"],["あって"],["、"],["その"],["名","な"],["を"],["ボアズ"],["と"],["いった"],["。"]]},{"verse":2,"text":"モアブの女,おんなルツはナオミに言,いった、「どうぞ、わたしを畑,はたけに行,いかせてください。だれか親切,しんせつな人,ひとが見当,みあたるならば、わたしはその方,かたのあとについて落,おち穂,ぼを拾,ひろいます」。ナオミが彼女,かのじょに「娘,むすめよ、行,いきなさい」と言,いったので、","tok":[["モアブ"],["の"],["女","おんな"],["ルツ"],["は"],["ナオミ"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["わたし"],["を"],["畑","はたけ"],["に"],["行かせて","いかせて"],["ください"],["。"],["だれ"],["か"],["親切","しんせつ"],["な"],["人","ひと"],["が"],["見当たるならば","みあたるならば"],["、"],["わたし"],["は"],["その"],["方","かた"],["の"],["あと"],["について"],["落穂","おちぼ"],["を"],["拾います","ひろいます"],["」"],["。"],["ナオミ"],["が"],["彼女","かのじょ"],["に"],["「"],["娘","むすめ"],["よ"],["、"],["行き","いき"],["なさい"],["」"],["と"],["言った","いった"],["ので"],["、"]]},{"verse":3,"text":"ルツは行,いって、刈,かる人,ひとたちのあとに従,したがい、畑,はたけで落,おち穂,ぼを拾,ひろったが、彼女,かのじょははからずもエリメレクの一族,いちぞくであるボアズの畑,はたけの部分,ぶぶんにきた。","tok":[["ルツ"],["は"],["行って","いって"],["、"],["刈る","かる"],["人","ひと"],["たち"],["の"],["あと"],["に"],["従い","したがい"],["、"],["畑","はたけ"],["で"],["落穂","おちぼ"],["を"],["拾った","ひろった"],["が"],["、"],["彼女","かのじょ"],["は"],["はからず"],["も"],["エリメレク"],["の"],["一族","いちぞく"],["で"],["ある"],["ボアズ"],["の"],["畑","はたけ"],["の"],["部分","ぶぶん"],["に"],["きた"],["。"]]},{"verse":4,"text":"その時,ときボアズは、ベツレヘムからきて、刈,かる者,ものどもに言,いった、「主,しゅがあなたがたと共,ともにおられますように」。彼,かれらは答,こたえた、「主,しゅがあなたを祝福,しゅくふくされますように」。","tok":[["その"],["時","とき"],["ボアズ"],["は"],["、"],["ベツレヘム"],["から"],["きて"],["、"],["刈る","かる"],["者","もの"],["ども"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["が"],["あなた"],["がた"],["と"],["共","とも"],["に"],["おられます"],["よう"],["に"],["」"],["。"],["彼","かれ"],["ら"],["は"],["答","こたえ"],["た"],["、"],["「"],["主","しゅ"],["が"],["あなた"],["を"],["祝福","しゅくふく"],["されます"],["よう"],["に"],["」"],["。"]]},{"verse":5,"text":"ボアズは刈,かる人,ひとたちを監督,かんとくしているしもべに言,いった、「これはだれの娘,むすめですか」。","tok":[["ボアズ"],["は"],["刈る","かる"],["人","ひと"],["たち"],["を"],["監督","かんとく"],["して"],["いる"],["しもべ"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["だれ"],["の"],["娘","むすめ"],["です"],["か"],["」"],["。"]]},{"verse":6,"text":"刈,かる人,ひとたちを監督,かんとくしているしもべは答,こたえた、「あれはモアブの女,おんなで、モアブの地,ちからナオミと一緒,いっしょに帰,かえってきたのですが、","tok":[["刈る","かる"],["人","ひと"],["たち"],["を"],["監督","かんとく"],["して"],["いる"],["しもべ"],["は"],["答","こたえ"],["た"],["、"],["「"],["あれ"],["は"],["モアブ"],["の"],["女","おんな"],["で"],["、"],["モアブ"],["の"],["地","ち"],["から"],["ナオミ"],["と"],["一緒","いっしょ"],["に"],["帰えって","かえって"],["きた"],["の"],["です"],["が"],["、"]]},{"verse":7,"text":"彼女,かのじょは『どうぞ、わたしに、刈,かる人,ひとたちのあとについて、束,たばのあいだで、落,おち穂,ぼを拾,ひろい集,あつめさせてください』と言,いいました。そして彼女,かのじょは朝,あさ早,はやくきて、今,いままで働,はたらいて、少,すこしのあいだも休,やすみませんでした」。","tok":[["彼女","かのじょ"],["は"],["『"],["どうぞ"],["、"],["わたし"],["に"],["、"],["刈る","かる"],["人","ひと"],["たち"],["の"],["あと"],["について"],["、"],["束","たば"],["の"],["あいだ"],["で"],["、"],["落穂","おちぼ"],["を"],["拾い集めさせて","ひろいあつめさせて"],["ください"],["』"],["と"],["言いました","いいました"],["。"],["そして"],["彼女","かのじょ"],["は"],["朝","あさ"],["早く","はやく"],["きて"],["、"],["今まで","いままで"],["働いて","はたらいて"],["、"],["少し","すこし"],["の"],["あいだ"],["も"],["休みませんでした","やすみませんでした"],["」"],["。"]]},{"verse":8,"text":"ボアズはルツに言,いった、「娘,むすめよ、お聞,ききなさい。ほかの畑,はたけに穂,ほを拾,ひろいに行,いってはいけません。またここを去,さってはなりません。わたしのところで働,はたらく女,おんなたちを離,はなれないで、ここにいなさい。","tok":[["ボアズ"],["は"],["ルツ"],["に"],["言った","いった"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["お聞","おきき"],["なさい"],["。"],["ほか"],["の"],["畑","はたけ"],["に"],["穂","ほ"],["を"],["拾い","ひろい"],["に"],["行って","いって"],["は"],["いけません"],["。"],["また"],["ここ"],["を"],["去","さっ"],["ては"],["なりません"],["。"],["わたし"],["の"],["ところ"],["で"],["働く","はたらく"],["女","おんな"],["たち"],["を"],["離れないで","はなれないで"],["、"],["ここ"],["に"],["い"],["なさい"],["。"]]},{"verse":9,"text":"人々,ひとびとが刈,かりとっている畑,はたけに目,めをとめて、そのあとについて行,いきなさい。わたしは若者,わかものたちに命,めいじて、あなたのじゃまをしないようにと、言,いっておいたではありませんか。あなたがかわく時,ときには水,みずがめのところへ行,いって、若者,わかものたちのくんだのを飲,のみなさい」。","tok":[["人々","ひとびと"],["が"],["刈","かり"],["とって"],["いる"],["畑","はたけ"],["に"],["目","め"],["を"],["とめて"],["、"],["その"],["あと"],["について"],["行き","いき"],["なさい"],["。"],["わたし"],["は"],["若者","わかもの"],["たち"],["に"],["命じて","めいじて"],["、"],["あなた"],["の"],["じゃま"],["を"],["しない"],["よう"],["に"],["と"],["、"],["言って","いって"],["おいたで"],["は"],["ありません"],["か"],["。"],["あなた"],["が"],["かわく"],["時","とき"],["に"],["は"],["水がめ","みずがめ"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["若者","わかもの"],["たち"],["の"],["くんだ"],["の"],["を"],["飲み","のみ"],["なさい"],["」"],["。"]]},{"verse":10,"text":"彼女,かのじょは地,ちに伏,ふして拝,はいし、彼,かれに言,いった、「どうしてあなたは、わたしのような外国,がいこく人,じんを顧,かえりみて、親切,しんせつにしてくださるのですか」。","tok":[["彼女","かのじょ"],["は"],["地","ち"],["に"],["伏して","ふして"],["拝し","はいし"],["、"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["どう"],["して"],["あなた"],["は"],["、"],["わたし"],["の"],["よう"],["な"],["外国人","がいこくじん"],["を"],["顧て","かえりみて"],["、"],["親切","しんせつ"],["に"],["して"],["くださる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":11,"text":"ボアズは答,こたえて彼女,かのじょに言,いった、「あなたの夫,おっとが死,しんでこのかた、あなたがしゅうとめにつくしたこと、また自分,じぶんの父母,ふぼと生,うまれた国,くにを離,はなれて、かつて知,しらなかった民,たみのところにきたことは皆,みなわたしに聞,きこえました。","tok":[["ボアズ"],["は"],["答","こたえ"],["て"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["夫","おっと"],["が"],["死んで","しんで"],["このかた"],["、"],["あなた"],["が"],["しゅうとめ"],["に"],["つくした"],["こと"],["、"],["また"],["自分","じぶん"],["の"],["父母","ふぼ"],["と"],["生まれた","うまれた"],["国","くに"],["を"],["離れて","はなれて"],["、"],["かつて"],["知らなかった","しらなかった"],["民","たみ"],["の"],["ところ"],["に"],["きた"],["こと"],["は"],["皆","みな"],["わたし"],["に"],["聞こえました","きこえました"],["。"]]},{"verse":12,"text":"どうぞ、主,しゅがあなたのしたことに報,むくいられるように。どうぞ、イスラエルの神,かみ、主,しゅ、すなわちあなたがその翼,つばさの下,したに身,みを寄,よせようとしてきた主,しゅからじゅうぶんの報,むくいを得,えられるように」。","tok":[["どうぞ"],["、"],["主","しゅ"],["が"],["あなた"],["の"],["した"],["こと"],["に"],["報いられる","むくいられる"],["よう"],["に"],["。"],["どうぞ"],["、"],["イスラエル"],["の"],["神","かみ"],["、"],["主","しゅ"],["、"],["すなわち"],["あなた"],["が"],["その"],["翼","つばさ"],["の"],["下","した"],["に"],["身","み"],["を"],["寄せよう","よせよう"],["として"],["きた"],["主ら","しゅから"],["じゅうぶん"],["の"],["報い","むくい"],["を"],["得られる","えられる"],["よう"],["に"],["」"],["。"]]},{"verse":13,"text":"彼女,かのじょは言,いった、「わが主,しゅよ、まことにありがとうございます。わたしはあなたのはしためのひとりにも及,およばないのに、あなたはこんなにわたしを慰,なぐさめ、はしためにねんごろに語,かたられました」。","tok":[["彼女","かのじょ"],["は"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["よ"],["、"],["まこと"],["に"],["ありがとう"],["ございます"],["。"],["わたし"],["は"],["あなた"],["の"],["はし"],["ため"],["の"],["ひとり"],["に"],["も"],["及ばない","およばない"],["のに"],["、"],["あなた"],["は"],["こんな"],["に"],["わたし"],["を"],["慰さめ","なぐさめ"],["、"],["はし"],["ため"],["に"],["ねんごろ"],["に"],["語られました","かたられました"],["」"],["。"]]},{"verse":14,"text":"食事,しょくじの時,とき、ボアズは彼女,かのじょに言,いった、「ここへきて、パンを食,たべ、あなたの食,たべる物,ものを酢,すに浸,ひたしなさい」。彼女,かのじょが刈,かる人々,ひとびとのかたわらにすわったので、ボアズは焼麦,やきむぎを彼女,かのじょに与,あたえた。彼女,かのじょは飽,あきるほど食,たべて残,のこした。","tok":[["食事","しょくじ"],["の"],["時","とき"],["、"],["ボアズ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["ここ"],["へ"],["きて"],["、"],["パン"],["を"],["食べ","たべ"],["、"],["あなた"],["の"],["食べる","たべる"],["物","もの"],["を"],["酢","す"],["に"],["浸し","ひたし"],["なさい"],["」"],["。"],["彼女","かのじょ"],["が"],["刈る","かる"],["人々","ひとびと"],["の"],["かたわら"],["に"],["すわった"],["ので"],["、"],["ボアズ"],["は"],["焼","しょう"],["麦","むぎ"],["を"],["彼女","かのじょ"],["に"],["与","あたえ"],["た"],["。"],["彼女","かのじょ"],["は"],["飽きる","あきる"],["ほど"],["食べて","たべて"],["残した","のこした"],["。"]]},{"verse":15,"text":"そして彼女,かのじょがまた穂,ほを拾,ひろおうと立,たちあがったとき、ボアズは若者,わかものたちに命,めいじて言,いった、「彼女,かのじょには束,つかの間,までも穂,ほを拾,ひろわせなさい。とがめてはならない。","tok":[["そして"],["彼女","かのじょ"],["が"],["また"],["穂","ほ"],["を"],["拾おう","ひろおう"],["と"],["立ちあがった","たちあがった"],["とき"],["、"],["ボアズ"],["は"],["若者","わかもの"],["たち"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["彼女","かのじょ"],["に"],["は"],["束の間","つかのま"],["で"],["も"],["穂","ほ"],["を"],["拾わせ","ひろわせ"],["なさい"],["。"],["とがめて"],["は"],["ならない"],["。"]]},{"verse":16,"text":"また彼女,かのじょのために束,たばからわざと抜,ぬき落,おとしておいて拾,ひろわせなさい。しかってはならない」。","tok":[["また"],["彼女","かのじょ"],["の"],["ため"],["に"],["束","たば"],["から"],["わざと"],["抜き","ぬき"],["落として","おとして"],["おいて"],["拾わせ","ひろわせ"],["なさい"],["。"],["しかって"],["は"],["ならない"],["」"],["。"]]},{"verse":17,"text":"こうして彼女,かのじょは夕暮,ゆうぐれまで畑,はたけで落,おち穂,ぼを拾,ひろった。そして拾,ひろった穂,ほを打,うつと、大麦,おおむぎは一エパほどあった。","tok":[["こう"],["して"],["彼女","かのじょ"],["は"],["夕暮","ゆうぐれ"],["まで"],["畑","はたけ"],["で"],["落穂","おちぼ"],["を"],["拾った","ひろった"],["。"],["そして"],["拾った","ひろった"],["穂","ほ"],["を"],["打つ","うつ"],["と"],["、"],["大麦","おおむぎ"],["は"],["一","いち"],["エパ"],["ほど"],["あった"],["。"]]},{"verse":18,"text":"彼女,かのじょはそれを携,たずさえて町,まちにはいり、しゅうとめにその拾,ひろったものを見,みせ、かつ食,たべ飽,あきて、残,のこして持,もちかえったものを取,とり出,だして与,あたえた。","tok":[["彼女","かのじょ"],["は"],["それ"],["を"],["携えて","たずさえて"],["町","まち"],["に"],["はいり"],["、"],["しゅうとめ"],["に"],["その"],["拾った","ひろった"],["もの"],["を"],["見せ","みせ"],["、"],["かつ"],["食べ飽きて","たべあきて"],["、"],["残して","のこして"],["持","もち"],["かえった"],["もの"],["を"],["取出して","とりだして"],["与","あたえ"],["た"],["。"]]},{"verse":19,"text":"しゅうとめは彼女,かのじょに言,いった、「あなたは、きょう、どこで穂,ほを拾,ひろいましたか。どこで働,はたらきましたか。あなたをそのように顧,かえりみてくださったかたに、どうか祝福,しゅくふくがあるように」。そこで彼女,かのじょは自分,じぶんがだれの所,ところで働,はたらいたかを、しゅうとめに告,つげて、「わたしが、きょう働,はたらいたのはボアズという名,なの人,ひとの所,ところです」と言,いった。","tok":[["しゅうとめ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["きょう"],["、"],["どこ"],["で"],["穂","ほ"],["を"],["拾いました","ひろいました"],["か"],["。"],["どこ"],["で"],["働らき","はたらき"],["ました"],["か"],["。"],["あなた"],["を"],["その"],["よう"],["に"],["顧て","かえりみて"],["くださった"],["かた"],["に"],["、"],["どう"],["か"],["祝福","しゅくふく"],["が"],["ある"],["よう"],["に"],["」"],["。"],["そこ"],["で"],["彼女","かのじょ"],["は"],["自分","じぶん"],["が"],["だれ"],["の"],["所","ところ"],["で"],["働いた","はたらいた"],["か"],["を"],["、"],["しゅうとめ"],["に"],["告","つげ"],["て"],["、"],["「"],["わたし"],["が"],["、"],["きょう"],["働いた","はたらいた"],["の"],["は"],["ボアズ"],["と"],["いう"],["名","な"],["の"],["人","ひと"],["の"],["所","ところ"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"ナオミは嫁,よめに言,いった、「生,いきている者,ものをも、死,しんだ者,ものをも、顧,かえりみて、いつくしみを賜,たまわる主,しゅが、どうぞその人,ひとを祝福,しゅくふくされますように」。ナオミはまた彼女,かのじょに言,いった、「その人,ひとはわたしたちの縁者,えんじゃで、最,もっとも近,ちかい親戚,しんせきのひとりです」。","tok":[["ナオミ"],["は"],["嫁","よめ"],["に"],["言った","いった"],["、"],["「"],["生きて","いきて"],["いる"],["者","もの"],["を"],["も"],["、"],["死んだ","しんだ"],["者","もの"],["を"],["も"],["、"],["顧て","かえりみて"],["、"],["いつくしみ"],["を"],["賜わる","たまわる"],["主","しゅ"],["が"],["、"],["どうぞ"],["その"],["人","ひと"],["を"],["祝福","しゅくふく"],["されます"],["よう"],["に"],["」"],["。"],["ナオミ"],["は"],["また"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["その"],["人","ひと"],["は"],["わたしたち"],["の"],["縁者","えんじゃ"],["で"],["、"],["最も","もっとも"],["近い","ちかい"],["親戚","しんせき"],["の"],["ひとり"],["です"],["」"],["。"]]},{"verse":21,"text":"モアブの女,おんなルツは言,いった、「その人,ひとはまたわたしに『あなたはわたしのところの刈入,かりいれが全部,ぜんぶ終,おわるまで、わたしのしもべたちのそばについていなさい』と言,いいました」。","tok":[["モアブ"],["の"],["女","おんな"],["ルツ"],["は"],["言った","いった"],["、"],["「"],["その"],["人","ひと"],["は"],["また"],["わたし"],["に"],["『"],["あなた"],["は"],["わたし"],["の"],["ところ"],["の"],["刈入れ","かりいれ"],["が"],["全部","ぜんぶ"],["終わる","おわる"],["まで"],["、"],["わたし"],["の"],["しもべ"],["たち"],["の"],["そば"],["について"],["い"],["なさい"],["』"],["と"],["言いました","いいました"],["」"],["。"]]},{"verse":22,"text":"ナオミは嫁,よめルツに言,いった、「娘,むすめよ、その人,ひとのところで働,はたらく女,おんなたちと一緒,いっしょに出,でかけるのはけっこうです。そうすればほかの畑,はたけで人,ひとにいじめられるのを免,まぬかれるでしょう」。","tok":[["ナオミ"],["は"],["嫁","よめ"],["ルツ"],["に"],["言った","いった"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["その"],["人","ひと"],["の"],["ところ"],["で"],["働く","はたらく"],["女","おんな"],["たち"],["と"],["一緒","いっしょ"],["に"],["出かける","でかける"],["の"],["は"],["けっこう"],["です"],["。"],["そう"],["すれば"],["ほか"],["の"],["畑","はたけ"],["で"],["人","ひと"],["に"],["いじめられる"],["の"],["を"],["免かれるでしょう","まぬかれるでしょう"],["」"],["。"]]},{"verse":23,"text":"それで彼女,かのじょはボアズのところで働,はたらく女,おんなたちのそばについていて穂,ほを拾,ひろい、大麦,おおむぎ刈,かりと小麦,こむぎ刈,かりの終,おわるまでそうした。こうして彼女,かのじょはしゅうとめと一緒,いっしょに暮,くらした。","tok":[["それ"],["で"],["彼女","かのじょ"],["は"],["ボアズ"],["の"],["ところ"],["で"],["働く","はたらく"],["女","おんな"],["たち"],["の"],["そば"],["について"],["いて"],["穂","ほ"],["を"],["拾い","ひろい"],["、"],["大麦刈","おおむぎかり"],["と"],["小麦刈","こむぎかり"],["の"],["終わる","おわる"],["まで"],["そう"],["した"],["。"],["こう"],["して"],["彼女","かのじょ"],["は"],["しゅうとめ"],["と"],["一緒","いっしょ"],["に"],["暮らした","くらした"],["。"]]}]
[{"verse":1,"text":"ボアズは町,まちの門,もんのところへ上,のぼっていって、そこにすわった。すると、さきにボアズが言,いった親戚,しんせきの人,ひとが通,とおり過,すぎようとしたので、ボアズはその人,ひとに言,いった、「友,ともよ、こちらへきて、ここにおすわりください」。彼,かれはきてすわった。","tok":[["ボアズ"],["は"],["町","まち"],["の"],["門","もん"],["の"],["ところ"],["へ"],["上って","のぼって"],["いって"],["、"],["そこ"],["に"],["すわった"],["。"],["する"],["と"],["、"],["さき"],["に"],["ボアズ"],["が"],["言った","いった"],["親戚","しんせき"],["の"],["人","ひと"],["が"],["通り","とおり"],["過よう","すぎよう"],["と"],["した"],["ので"],["、"],["ボアズ"],["は"],["その"],["人","ひと"],["に"],["言った","いった"],["、"],["「"],["友","とも"],["よ"],["、"],["こちら"],["へ"],["きて"],["、"],["ここ"],["に"],["おすわり"],["ください"],["」"],["。"],["彼","かれ"],["は"],["きて"],["すわった"],["。"]]},{"verse":2,"text":"ボアズはまた町,まちの長老,ちょうろう十人,にんを招,まねいて言,いった、「ここにおすわりください」。彼,かれらがすわった時,とき、","tok":[["ボアズ"],["は"],["また"],["町","まち"],["の"],["長老","ちょうろう"],["十人","にん"],["を"],["招いて","まねいて"],["言った","いった"],["、"],["「"],["ここ"],["に"],["おすわり"],["ください"],["」"],["。"],["彼","かれ"],["ら"],["が"],["すわった"],["時","とき"],["、"]]},{"verse":3,"text":"ボアズは親戚,しんせきの人,ひとに言,いった、「モアブの地,ちから帰,かえってきたナオミは、われわれの親族,しんぞくエリメレクの地所,じしょを売,うろうとしています。","tok":[["ボアズ"],["は"],["親戚","しんせき"],["の"],["人","ひと"],["に"],["言った","いった"],["、"],["「"],["モアブ"],["の"],["地","ち"],["から"],["帰えって","かえって"],["きた"],["ナオミ"],["は"],["、"],["われわれ"],["の"],["親族","しんぞく"],["エリメレク"],["の"],["地所","じしょ"],["を"],["売ろう","うろう"],["として"],["います"],["。"]]},{"verse":4,"text":"それでわたしはそのことをあなたに知,しらせて、ここにすわっている人々,ひとびとと、民,たみの長老,ちょうろうたちの前,まえで、それを買,かいなさいと、あなたに言,いおうと思,おもいました。もし、あなたが、それをあがなおうと思,おもわれるならば、あがなってください。しかし、あなたがそれをあがなわないならば、わたしにそう言,いって知,しらせてください。それをあがなう人,ひとは、あなたのほかにはなく、わたしはあなたの次,つぎですから」。彼,かれは言,いった、「わたしがあがないましょう」。","tok":[["それ"],["で"],["わたし"],["は"],["その"],["こと"],["を"],["あなた"],["に"],["知らせて","しらせて"],["、"],["ここ"],["に"],["すわって"],["いる"],["人々","ひとびと"],["と"],["、"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["の"],["前","まえ"],["で"],["、"],["それ"],["を"],["買","かい"],["なさい"],["と"],["、"],["あなた"],["に"],["言おう","いおう"],["と"],["思いました","おもいました"],["。"],["もし"],["、"],["あなた"],["が"],["、"],["それ"],["を"],["あがなおう"],["と"],["思われるならば","おもわれるならば"],["、"],["あがなって"],["ください"],["。"],["しかし"],["、"],["あなた"],["が"],["それ"],["を"],["あがなわないならば"],["、"],["わたし"],["に"],["そう"],["言って","いって"],["知らせて","しらせて"],["ください"],["。"],["それ"],["を"],["あがなう"],["人","ひと"],["は"],["、"],["あなた"],["の"],["ほか"],["に"],["は"],["なく"],["、"],["わたし"],["は"],["あなた"],["の"],["次","つぎ"],["です"],["から"],["」"],["。"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["が"],["あがないましょう"],["」"],["。"]]},{"verse":5,"text":"そこでボアズは言,いった、「あなたがナオミの手,てからその地所,じしょを買,かう時,ときには、死,しんだ者,ものの妻,つまであったモアブの女,おんなルツをも買,かって、死,しんだ者,ものの名,なを起,おこしてその嗣,し業,ぎょうを伝,つたえなければなりません」。","tok":[["そこ"],["で"],["ボアズ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["が"],["ナオミ"],["の"],["手","て"],["から"],["その"],["地所","じしょ"],["を"],["買う","かう"],["時","とき"],["に"],["は"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["妻","つま"],["で"],["あった"],["モアブ"],["の"],["女","おんな"],["ルツ"],["を"],["も"],["買って","かって"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["名","な"],["を"],["起こして","おこして"],["その"],["嗣業","しぎょう"],["を"],["伝えなければ","つたえなければ"],["なりません"],["」"],["。"]]},{"verse":6,"text":"その親戚,しんせきの人,ひとは言,いった、「それでは、わたしにはあがなうことができません。そんなことをすれば自分,じぶんの嗣,し業,ぎょうをそこないます。あなたがわたしに代,かわって、自分,じぶんであがなってください。わたしはあがなうことができませんから」。","tok":[["その"],["親戚","しんせき"],["の"],["人","ひと"],["は"],["言った","いった"],["、"],["「"],["それ"],["で"],["は"],["、"],["わたし"],["に"],["は"],["あがなう"],["こと"],["が"],["できません"],["。"],["そんな"],["こと"],["を"],["すれば"],["自分","じぶん"],["の"],["嗣業","しぎょう"],["を"],["そこないます"],["。"],["あなた"],["が"],["わたし"],["に"],["代わって","かわって"],["、"],["自分","じぶん"],["で"],["あがなって"],["ください"],["。"],["わたし"],["は"],["あがなう"],["こと"],["が"],["できません"],["から"],["」"],["。"]]},{"verse":7,"text":"むかしイスラエルでは、物,ものをあがなう事,ことと、権利,けんりの譲渡,じょうとについて、万事,ばんじを決定,けっていする時,ときのならわしはこうであった。すなわち、その人,ひとは、自分,じぶんのくつを脱,ぬいで、相手,あいての人,ひとに渡,わたした。これがイスラエルでの証明,しょうめいの方法,ほうほうであった。","tok":[["むかし"],["イスラエル"],["で"],["は"],["、"],["物","もの"],["を"],["あがなう"],["事","こと"],["と"],["、"],["権利","けんり"],["の"],["譲渡","じょうと"],["について"],["、"],["万事","ばんじ"],["を"],["決定","けってい"],["する"],["時","とき"],["の"],["ならわし"],["は"],["こう"],["で"],["あった"],["。"],["すなわち"],["、"],["その"],["人","ひと"],["は"],["、"],["自分","じぶん"],["の"],["くつ"],["を"],["脱いで","ぬいで"],["、"],["相手","あいて"],["の"],["人","ひと"],["に"],["渡","わたし"],["た"],["。"],["これ"],["が"],["イスラエル"],["で"],["の"],["証明","しょうめい"],["の"],["方法","ほうほう"],["で"],["あった"],["。"]]},{"verse":8,"text":"そこで親戚,しんせきの人,ひとがボアズにむかい「あなたが自分,じぶんであがないなさい」と言,いって、そのくつを脱,ぬいだので、","tok":[["そこ"],["で"],["親戚","しんせき"],["の"],["人","ひと"],["が"],["ボアズ"],["に"],["むかい"],["「"],["あなた"],["が"],["自分","じぶん"],["で"],["あがない"],["なさい"],["」"],["と"],["言って","いって"],["、"],["その"],["くつ"],["を"],["脱いだ","ぬいだ"],["ので"],["、"]]},{"verse":9,"text":"ボアズは長老,ちょうろうたちとすべての民,たみに言,いった、「あなたがたは、きょう、わたしがエリメレクのすべての物,ものおよびキリオンとマロンのすべての物,ものをナオミの手,てから買,かいとった事,ことの証人,しょうにんです。","tok":[["ボアズ"],["は"],["長老","ちょうろう"],["たち"],["と"],["すべて"],["の"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["きょう"],["、"],["わたし"],["が"],["エリメレク"],["の"],["すべて"],["の"],["物","もの"],["および"],["キリオン"],["と"],["マロン"],["の"],["すべて"],["の"],["物","もの"],["を"],["ナオミ"],["の"],["手","て"],["から"],["買","かい"],["とった"],["事","こと"],["の"],["証人","しょうにん"],["です"],["。"]]},{"verse":10,"text":"またわたしはマロンの妻,つまであったモアブの女,おんなルツをも買,かって、わたしの妻,つまとしました。これはあの死,しんだ者,ものの名,なを起,おこしてその嗣,し業,ぎょうを伝,つたえ、死,しんだ者,ものの名,ながその一族,いちぞくから、またその郷里,きょうりの門,もんから断絶,だんぜつしないようにするためです。きょうあなたがたは、その証人,しょうにんです」。","tok":[["また"],["わたし"],["は"],["マロン"],["の"],["妻","つま"],["で"],["あった"],["モアブ"],["の"],["女","おんな"],["ルツ"],["を"],["も"],["買って","かって"],["、"],["わたし"],["の"],["妻","つま"],["と"],["しました"],["。"],["これ"],["は"],["あの"],["死んだ","しんだ"],["者","もの"],["の"],["名","な"],["を"],["起こして","おこして"],["その"],["嗣業","しぎょう"],["を"],["伝え","つたえ"],["、"],["死んだ","しんだ"],["者","もの"],["の"],["名","な"],["が"],["その"],["一族","いちぞく"],["から"],["、"],["また"],["その"],["郷里","きょうり"],["の"],["門","もん"],["から"],["断絶","だんぜつ"],["しない"],["よう"],["に"],["する"],["ため"],["です"],["。"],["きょう"],["あなた"],["がた"],["は"],["、"],["その"],["証人","しょうにん"],["です"],["」"],["。"]]},{"verse":11,"text":"すると門,もんにいたすべての民,たみと長老,ちょうろうたちは言,いった、「わたしたちは証人,しょうにんです。どうぞ、主,しゅがあなたの家,いえにはいる女,おんなを、イスラエルの家,いえをたてたラケルとレアのふたりのようにされますよう。どうぞ、あなたがエフラタで富,とみを得,え、ベツレヘムで名,なを揚,あげられますように。","tok":[["する"],["と"],["門","もん"],["に"],["いた"],["すべて"],["の"],["民","たみ"],["と"],["長老","ちょうろう"],["たち"],["は"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["証人","しょうにん"],["です"],["。"],["どうぞ"],["、"],["主","しゅ"],["が"],["あなた"],["の"],["家","いえ"],["に"],["はいる"],["女","おんな"],["を"],["、"],["イスラエル"],["の"],["家","いえ"],["を"],["たてた"],["ラケル"],["と"],["レア"],["の"],["ふたり"],["の"],["よう"],["に"],["されます"],["よう"],["。"],["どうぞ"],["、"],["あなた"],["が"],["エフラタ"],["で"],["富","とみ"],["を"],["得","え"],["、"],["ベツレヘム"],["で"],["名","な"],["を"],["揚げられます","あげられます"],["よう"],["に"],["。"]]},{"verse":12,"text":"どうぞ、主,しゅがこの若,わかい女,おんなによってあなたに賜,たまわる子供,こどもにより、あなたの家,いえが、かのタマルがユダに産,うんだペレヅの家,いえのようになりますように」。","tok":[["どうぞ"],["、"],["主","しゅがこ"],["の"],["若い","わかい"],["女","おんな"],["によって"],["あなた"],["に"],["賜わる","たまわる"],["子供","こども"],["に"],["より"],["、"],["あなた"],["の"],["家","いえ"],["が"],["、"],["かの"],["タマル"],["が"],["ユダ"],["に"],["産んだ","うんだ"],["ペレヅ"],["の"],["家","いえ"],["の"],["よう"],["に"],["なります"],["よう"],["に"],["」"],["。"]]},{"verse":13,"text":"こうしてボアズはルツをめとって妻,つまとし、彼女,かのじょのところにはいった。主,しゅは彼女,かのじょをみごもらせられたので、彼女,かのじょはひとりの男,おとこの子,こを産,うんだ。","tok":[["こう"],["して"],["ボアズ"],["は"],["ルツ"],["を"],["めとって"],["妻","つま"],["と"],["し"],["、"],["彼女","かのじょ"],["の"],["ところ"],["に"],["はいった"],["。"],["主","しゅ"],["は"],["彼女","かのじょ"],["を"],["みごもらせられた"],["ので"],["、"],["彼女","かのじょ"],["は"],["ひとり"],["の"],["男の子","おとこのこ"],["を"],["産んだ","うんだ"],["。"]]},{"verse":14,"text":"そのとき、女,おんなたちはナオミに言,いった、「主,しゅはほむべきかな、主,しゅはあなたを見捨,みすてずに、きょう、あなたにひとりの近親,きんしんをお授,さづけになりました。どうぞ、その子,この名,ながイスラエルのうちに高,たかく揚,あげられますように。","tok":[["その"],["とき"],["、"],["女","おんな"],["たち"],["は"],["ナオミ"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["ほ"],["むべき"],["か"],["な"],["、"],["主","しゅ"],["は"],["あなた"],["を"],["見捨てず","みすてず"],["に"],["、"],["きょう"],["、"],["あなた"],["に"],["ひとり"],["の"],["近親","きんしん"],["を"],["お"],["授","さづけ"],["に"],["なりました"],["。"],["どうぞ"],["、"],["その"],["子","こ"],["の"],["名","な"],["が"],["イスラエル"],["の"],["うち"],["に"],["高かく","たかく"],["揚げられます","あげられます"],["よう"],["に"],["。"]]},{"verse":15,"text":"彼,かれはあなたのいのちを新,あらたにし、あなたの老年,ろうねんを養,やしなう者,ものとなるでしょう。あなたを愛,あいするあなたの嫁,よめ、七人,にんのむすこにもまさる彼女,かのじょが彼,かれを産,うんだのですから」。","tok":[["彼","かれ"],["は"],["あなた"],["の"],["いのち"],["を"],["新らた","あらた"],["に"],["し"],["、"],["あなた"],["の"],["老年","ろうねん"],["を"],["養う","やしなう"],["者","もの"],["と"],["なるでしょう"],["。"],["あなた"],["を"],["愛する","あいする"],["あなた"],["の"],["嫁","よめ"],["、"],["七人","にん"],["の"],["むすこ"],["に"],["も"],["まさる"],["彼女","かのじょ"],["が"],["彼","かれ"],["を"],["産","うんだ"],["の"],["です"],["から"],["」"],["。"]]},{"verse":16,"text":"そこでナオミはその子,こをとり、ふところに置,おいて、養,やしない育,そだてた。","tok":[["そこ"],["で"],["ナオミ"],["は"],["その"],["子","こ"],["を"],["とり"],["、"],["ふところ"],["に"],["置いて","おいて"],["、"],["養い育てた","やしないそだてた"],["。"]]},{"verse":17,"text":"近所,きんじょの女,おんなたちは「ナオミに男,おとこの子,こが生,うまれた」と言,いって、彼,かれに名,なをつけ、その名,なをオベデと呼,よんだ。彼,かれはダビデの父,ちちであるエッサイの父,ちちとなった。","tok":[["近所","きんじょ"],["の"],["女","おんな"],["たち"],["は"],["「"],["ナオミ"],["に"],["男の子","おとこのこ"],["が"],["生まれた","うまれた"],["」"],["と"],["言って","いって"],["、"],["彼","かれ"],["に"],["名","な"],["を"],["つけ"],["、"],["その"],["名","な"],["を"],["オベデ"],["と"],["呼んだ","よんだ"],["。"],["彼","かれ"],["は"],["ダビデ"],["の"],["父","ちち"],["で"],["ある"],["エッサイ"],["の"],["父","ちち"],["と"],["なった"],["。"]]},{"verse":18,"text":"さてペレヅの子孫,しそんは次,つぎのとおりである。ペレヅからヘヅロンが生,うまれ、","tok":[["さて"],["ペレヅ"],["の"],["子孫","しそん"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ペレヅ"],["から"],["ヘヅロン"],["が"],["生まれ","うまれ"],["、"]]},{"verse":19,"text":"ヘヅロンからラムが生,うまれ、ラムからアミナダブが生,うまれ、","tok":[["ヘヅロン"],["から"],["ラム"],["が"],["生まれ","うまれ"],["、"],["ラム"],["から"],["アミナダブ"],["が"],["生まれ","うまれ"],["、"]]},{"verse":20,"text":"アミナダブからナションが生,うまれ、ナションからサルモンが生,うまれ、","tok":[["アミナダブ"],["から"],["ナション"],["が"],["生まれ","うまれ"],["、"],["ナション"],["から"],["サルモン"],["が"],["生まれ","うまれ"],["、"]]},{"verse":21,"text":"サルモンからボアズが生,うまれ、ボアズからオベデが生,うまれ、","tok":[["サルモン"],["から"],["ボアズ"],["が"],["生まれ","うまれ"],["、"],["ボアズ"],["から"],["オベデ"],["が"],["生まれ","うまれ"],["、"]]},{"verse":22,"text":"オベデからエッサイが生,うまれ、エッサイからダビデが生,うまれた。","tok":[["オベデ"],["から"],["エッサイ"],["が"],["生まれ","うまれ"],["、"],["エッサイ"],["から"],["ダビデ"],["が"],["生まれた","うまれた"],["。"]]}]
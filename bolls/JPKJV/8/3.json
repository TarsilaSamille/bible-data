[{"verse":1,"text":"時,ときにしゅうとめナオミは彼女,かのじょに言,いった、「娘,むすめよ、わたしはあなたの落,おち着,つき所,ところを求,もとめて、あなたをしあわせにすべきではないでしょうか。","tok":[["時","とき"],["に"],["しゅうとめ"],["ナオミ"],["は"],["彼女","かのじょ"],["に"],["言った","いった"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["わたし"],["は"],["あなた"],["の"],["落着き所","おちつきところ"],["を"],["求めて","もとめて"],["、"],["あなた"],["を"],["しあわせ"],["に"],["すべきで"],["は"],["ないでしょう"],["か"],["。"]]},{"verse":2,"text":"あなたが一緒,いっしょに働,はたらいた女,おんなたちの主人,しゅじんボアズはわたしたちの親戚,しんせきではありませんか。彼,かれは今夜,こんや、打,うち場,ばで大麦,おおむぎをあおぎ分,わけます。","tok":[["あなた"],["が"],["一緒","いっしょ"],["に"],["働いた","はたらいた"],["女","おんな"],["たち"],["の"],["主人","しゅじん"],["ボアズ"],["は"],["わたしたち"],["の"],["親戚","しんせき"],["で"],["は"],["ありません"],["か"],["。"],["彼","かれ"],["は"],["今夜","こんや"],["、"],["打ち","うち"],["場","ば"],["で"],["大麦","おおむぎ"],["を"],["あおぎ"],["分けます","わけます"],["。"]]},{"verse":3,"text":"それであなたは身,みを洗,あらって油,あぶらをぬり、晴,はれ着,ぎをまとって打,うち場,ばに下,くだって行,いきなさい。ただ、あなたはその人,ひとが飲,のみ食,くいを終,おわるまで、その人,ひとに知,しられてはなりません。","tok":[["それ"],["で"],["あなた"],["は"],["身","み"],["を"],["洗って","あらって"],["油","あぶら"],["を"],["ぬり"],["、"],["晴着","はれぎ"],["を"],["まとって"],["打ち","うち"],["場","ば"],["に"],["下って","くだって"],["行き","いき"],["なさい"],["。"],["ただ"],["、"],["あなた"],["は"],["その"],["人","ひと"],["が"],["飲み食い","のみくい"],["を"],["終わる","おわる"],["まで"],["、"],["その"],["人","ひと"],["に"],["知られて","しられて"],["は"],["なりません"],["。"]]},{"verse":4,"text":"そしてその人,ひとが寝,ねる時,とき、その寝,ねる場所,ばしょを見定,みさだめ、はいって行,いって、その足,あしの所,ところをまくって、そこに寝,ねなさい。彼,かれはあなたのすべきことを知,しらせるでしょう」。","tok":[["そして"],["その"],["人","ひと"],["が"],["寝る","ねる"],["時","とき"],["、"],["その"],["寝る","ねる"],["場所","ばしょ"],["を"],["見定","みさだめ"],["、"],["はい"],["って"],["行って","いって"],["、"],["その"],["足","あし"],["の"],["所","ところ"],["を"],["まくって"],["、"],["そこ"],["に"],["寝","ね"],["なさい"],["。"],["彼","かれ"],["は"],["あなた"],["の"],["すべき"],["こと"],["を"],["知らせるでしょう","しらせるでしょう"],["」"],["。"]]},{"verse":5,"text":"ルツはしゅうとめに言,いった、「あなたのおっしゃることを皆,みないたしましょう」。","tok":[["ルツ"],["は"],["しゅうとめ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["の"],["おっしゃる"],["こと"],["を"],["皆","みな"],["いたしましょう"],["」"],["。"]]},{"verse":6,"text":"こうして彼女,かのじょは打,うち場,ばに下,くだり、すべてしゅうとめが命,めいじたとおりにした。","tok":[["こう"],["して"],["彼女","かのじょ"],["は"],["打ち","うち"],["場","ば"],["に"],["下り","くだり"],["、"],["すべて"],["しゅうとめ"],["が"],["命じた","めいじた"],["とおり"],["に"],["した"],["。"]]},{"verse":7,"text":"ボアズは飲,のみ食,くいして、心,こころをたのしませたあとで、麦,むぎを積,つんである場所,ばしょのかたわらへ行,いって寝,ねた。そこで彼女,かのじょはひそかに行,いき、ボアズの足,あしの所,ところをまくって、そこに寝,ねた。","tok":[["ボアズ"],["は"],["飲み食い","のみくい"],["して"],["、"],["心","こころ"],["を"],["たのしませた"],["あと"],["で"],["、"],["麦","むぎ"],["を"],["積んで","つんで"],["ある"],["場所","ばしょ"],["の"],["かたわら"],["へ"],["行って","いって"],["寝た","ねた"],["。"],["そこ"],["で"],["彼女","かのじょ"],["は"],["ひそか"],["に"],["行き","いき"],["、"],["ボアズ"],["の"],["足","あし"],["の"],["所","ところ"],["を"],["まくって"],["、"],["そこ"],["に"],["寝た","ねた"],["。"]]},{"verse":8,"text":"夜中,よなかになって、その人,ひとは驚,おどろき、起,おきかえって見,みると、ひとりの女,おんなが足,あしのところに寝,ねていたので、","tok":[["夜中","よなか"],["に"],["なって"],["、"],["その"],["人","ひと"],["は"],["驚","おどろき"],["、"],["起き","おき"],["かえって"],["見る","みる"],["と"],["、"],["ひとり"],["の"],["女","おんな"],["が"],["足","あし"],["の"],["ところ"],["に"],["寝て","ねて"],["いた"],["ので"],["、"]]},{"verse":9,"text":"「あなたはだれですか」と言,いうと、彼女,かのじょは答,こたえた、「わたしはあなたのはしためルツです。あなたのすそで、はしためをおおってください。あなたは最,もっとも近,ちかい親戚,しんせきです」。","tok":[["「"],["あなた"],["は"],["だれ"],["です"],["か"],["」"],["と"],["言","いう"],["と"],["、"],["彼女","かのじょ"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["はし"],["ため"],["ルツ"],["です"],["。"],["あなた"],["の"],["すそ"],["で"],["、"],["はし"],["ため"],["を"],["おおって"],["ください"],["。"],["あなた"],["は"],["最も","もっとも"],["近い","ちかい"],["親戚","しんせき"],["です"],["」"],["。"]]},{"verse":10,"text":"ボアズは言,いった、「娘,むすめよ、どうぞ、主,しゅがあなたを祝福,しゅくふくされるように。あなたは貧富,ひんぷにかかわらず若,わかい人,ひとに従,したがい行,ゆくことはせず、あなたが最後,さいごに示,しめしたこの親切,しんせつは、さきに示,しめした親切,しんせつにまさっています。","tok":[["ボアズ"],["は"],["言った","いった"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["どうぞ"],["、"],["主","しゅ"],["が"],["あなた"],["を"],["祝福","しゅくふく"],["される"],["よう"],["に"],["。"],["あなた"],["は"],["貧富","ひんぷ"],["に"],["かかわらず"],["若い","わかい"],["人","ひと"],["に"],["従い","したがい"],["行","ゆくこと"],["は"],["せず"],["、"],["あなた"],["が"],["最後","さいご"],["に"],["示めした","しめした"],["この"],["親切","しんせつ"],["は"],["、"],["さき"],["に"],["示めした","しめした"],["親切","しんせつ"],["に"],["まさって"],["います"],["。"]]},{"verse":11,"text":"それで、娘,むすめよ、あなたは恐,おそれるにおよびません。あなたが求,もとめることは皆,みな、あなたのためにいたしましょう。わたしの町,まちの人々,ひとびとは皆,みな、あなたがりっぱな女,おんなであることを知,しっているからです。","tok":[["それ"],["で"],["、"],["娘","むすめ"],["よ"],["、"],["あなた"],["は"],["恐れる","おそれる"],["に"],["およびません"],["。"],["あなた"],["が"],["求める","もとめる"],["こと"],["は"],["皆","みな"],["、"],["あなた"],["の"],["ため"],["に"],["いたしましょう"],["。"],["わたし"],["の"],["町","まち"],["の"],["人々","ひとびと"],["は"],["皆","みな"],["、"],["あなた"],["が"],["りっぱ"],["な"],["女","おんな"],["で"],["ある"],["こと"],["を"],["知って","しって"],["いる"],["から"],["です"],["。"]]},{"verse":12,"text":"たしかにわたしは近,ちかい親戚,しんせきではありますが、わたしよりも、もっと近,ちかい親戚,しんせきがあります。","tok":[["たしか"],["に"],["わたし"],["は"],["近い","ちかい"],["親戚","しんせき"],["で"],["は"],["あります"],["が"],["、"],["わたし"],["より"],["も"],["、"],["もっと"],["近い","ちかい"],["親戚","しんせき"],["が"],["あります"],["。"]]},{"verse":13,"text":"今夜,こんやはここにとどまりなさい。朝,あさになって、もしその人,ひとが、あなたのために親戚,しんせきの義務,ぎむをつくすならば、よろしい、その人,ひとにさせなさい。しかし主,しゅは生,いきておられます。その人,ひとが、あなたのために親戚,しんせきの義務,ぎむをつくすことを好,このまないならば、わたしはあなたのために親戚,しんせきの義務,ぎむをつくしましょう。朝,あさまでここにおやすみなさい」。","tok":[["今夜","こんや"],["は"],["ここ"],["に"],["とどまり"],["なさい"],["。"],["朝","あさ"],["に"],["なって"],["、"],["もし"],["その"],["人","ひと"],["が"],["、"],["あなた"],["の"],["ため"],["に"],["親戚","しんせき"],["の"],["義務","ぎむ"],["を"],["つくすならば"],["、"],["よろしい"],["、"],["その"],["人","ひと"],["に"],["させ"],["なさい"],["。"],["しかし"],["主","しゅ"],["は"],["生きて","いきて"],["おられます"],["。"],["その"],["人","ひと"],["が"],["、"],["あなた"],["の"],["ため"],["に"],["親戚","しんせき"],["の"],["義務","ぎむ"],["を"],["つくす"],["こと"],["を"],["好まないならば","このまないならば"],["、"],["わたし"],["は"],["あなた"],["の"],["ため"],["に"],["親戚","しんせき"],["の"],["義務","ぎむ"],["を"],["つくしましょう"],["。"],["朝","あさ"],["まで"],["ここ"],["に"],["おやすみなさい"],["」"],["。"]]},{"verse":14,"text":"ルツは朝,あさまで彼,かれの足,あしのところに寝,ねたが、だれかれの見分,みわけ難,がたいころに起,おきあがった。それはボアズが「この女,おんなの打,うち場,ばにきたことが人,ひとに知,しられてはならない」と言,いったからである。","tok":[["ルツ"],["は"],["朝","あさ"],["まで"],["彼","かれ"],["の"],["足","あし"],["の"],["ところ"],["に"],["寝た","ねた"],["が"],["、"],["だれかれ"],["の"],["見分け","みわけ"],["難い","がたい"],["ころ"],["に"],["起きあがった","おきあがった"],["。"],["それ"],["は"],["ボアズ"],["が"],["「"],["この"],["女","おんな"],["の"],["打ち","うち"],["場","ば"],["に"],["きた"],["こと"],["が"],["人","ひと"],["に"],["知られて","しられて"],["は"],["ならない"],["」"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"そしてボアズは言,いった、「あなたの着,きる外套,がいとうを持,もってきて、それを広,ひろげなさい」。彼女,かのじょがそれを広,ひろげると、ボアズは大麦,おおむぎ六オメルをはかって彼女,かのじょに負,おわせた。彼女,かのじょは町,まちに帰,かえり、","tok":[["そして"],["ボアズ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["の"],["着る","きる"],["外套","がいとう"],["を"],["持って","もって"],["きて"],["、"],["それ"],["を"],["広げ","ひろげ"],["なさい"],["」"],["。"],["彼女","かのじょ"],["が"],["それ"],["を"],["広げる","ひろげる"],["と"],["、"],["ボアズ"],["は"],["大麦","おおむぎ"],["六","ろく"],["オメル"],["を"],["はかって"],["彼女","かのじょ"],["に"],["負わせた","おわせた"],["。"],["彼女","かのじょ"],["は"],["町","まち"],["に"],["帰えり","かえり"],["、"]]},{"verse":16,"text":"しゅうとめのところへ行,いくと、しゅうとめは言,いった、「娘,むすめよ、どうでしたか」。そこでルツはその人,ひとが彼女,かのじょにしたことをことごとく告,つげて、","tok":[["しゅうとめ"],["の"],["ところ"],["へ"],["行く","いく"],["と"],["、"],["しゅうとめ"],["は"],["言った","いった"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["どう"],["でした"],["か"],["」"],["。"],["そこ"],["で"],["ルツ"],["は"],["その"],["人","ひと"],["が"],["彼女","かのじょ"],["に"],["した"],["こと"],["を"],["ことごとく"],["告","つげ"],["て"],["、"]]},{"verse":17,"text":"言,いった、「あのかたはわたしに向,むかって、から手,てで、しゅうとめのところへ帰,かえってはならないと言,いって、この大麦,おおむぎ六オメルをわたしにくださいました」。","tok":[["言った","いった"],["、"],["「"],["あの"],["かた"],["は"],["わたし"],["に"],["向かって","むかって"],["、"],["から"],["手","て"],["で"],["、"],["しゅうとめ"],["の"],["ところ"],["へ"],["帰えって","かえって"],["は"],["ならない"],["と"],["言って","いって"],["、"],["この"],["大麦","おおむぎ"],["六","ろく"],["オメル"],["を"],["わたし"],["に"],["くださいました"],["」"],["。"]]},{"verse":18,"text":"しゅうとめは言,いった、「娘,むすめよ、この事,ことがどうなるかわかるまでお待,まちなさい。あの人,ひとは、きょう、その事,ことを決定,けっていしなければ落,おち着,つかないでしょう」。","tok":[["しゅうとめ"],["は"],["言った","いった"],["、"],["「"],["娘","むすめ"],["よ"],["、"],["この"],["事","こと"],["が"],["どう"],["なる"],["か"],["わかる"],["まで"],["お待ち","おまち"],["なさい"],["。"],["あの"],["人","ひと"],["は"],["、"],["きょう"],["、"],["その"],["事","こと"],["を"],["決定","けってい"],["しなければ"],["落着かないでしょう","おちつかないでしょう"],["」"],["。"]]}]
[{"verse":1,"text":"ところが、アナニヤという人,ひととその妻,つまサッピラとは共,ともに資産,しさんを売,うったが、","tok":[["ところ"],["が"],["、"],["アナニヤ"],["と"],["いう"],["人","ひと"],["と"],["その"],["妻","つま"],["サッピラ"],["と"],["は"],["共","とも"],["に"],["資産","しさん"],["を"],["売った","うった"],["が"],["、"]]},{"verse":2,"text":"共謀,きょうぼうして、その代金,だいきんをごまかし、一部,いちぶだけを持,もってきて、使徒,しとたちの足,あしもとに置,おいた。","tok":[["共謀","きょうぼう"],["して"],["、"],["その"],["代金","だいきん"],["を"],["ごまかし"],["、"],["一部","いちぶ"],["だけ"],["を"],["持って","もって"],["きて"],["、"],["使徒","しと"],["たち"],["の"],["足もと","あしもと"],["に"],["置いた","おいた"],["。"]]},{"verse":3,"text":"そこで、ペテロが言,いった、「アナニヤよ、どうしてあなたは、自分,じぶんの心,こころをサタンに奪,うばわれて、聖霊,せいれいを欺,あざむき、地所,じしょの代金,だいきんをごまかしたのか。","tok":[["そこ"],["で"],["、"],["ペテロ"],["が"],["言った","いった"],["、"],["「"],["アナニヤ"],["よ"],["、"],["どう"],["して"],["あなた"],["は"],["、"],["自分","じぶん"],["の"],["心","こころ"],["を"],["サタン"],["に"],["奪われて","うばわれて"],["、"],["聖霊","せいれい"],["を"],["欺き","あざむき"],["、"],["地所","じしょ"],["の"],["代金","だいきん"],["を"],["ごまかした"],["の"],["か"],["。"]]},{"verse":4,"text":"売,うらずに残,のこしておけば、あなたのものであり、売,うってしまっても、あなたの自由,じゆうになったはずではないか。どうして、こんなことをする気,きになったのか。あなたは人,ひとを欺,あざむいたのではなくて、神,かみを欺,あざむいたのだ」。","tok":[["売らず","うらず"],["に"],["残して","のこして"],["おけば"],["、"],["あなた"],["の"],["もの"],["で"],["あり"],["、"],["売って","うって"],["しまって"],["も"],["、"],["あなた"],["の"],["自由","じゆう"],["に"],["なった"],["はず"],["で"],["は"],["ない"],["か"],["。"],["どう"],["して"],["、"],["こんな"],["こと"],["を"],["する"],["気","き"],["に"],["なった"],["の"],["か"],["。"],["あなた"],["は"],["人","ひと"],["を"],["欺いた","あざむいた"],["ので"],["は"],["なくて"],["、"],["神","かみ"],["を"],["欺いた","あざむいた"],["の"],["だ"],["」"],["。"]]},{"verse":5,"text":"アナニヤはこの言葉,ことばを聞,きいているうちに、倒,たおれて息,いきが絶,たえた。このことを伝,つたえ聞,きいた人々,ひとびとは、みな非常,ひじょうなおそれを感,かんじた。","tok":[["アナニヤ"],["は"],["この"],["言葉","ことば"],["を"],["聞いて","きいて"],["いる"],["うち"],["に"],["、"],["倒れて","たおれて"],["息","いき"],["が"],["絶えた","たえた"],["。"],["この"],["こと"],["を"],["伝え聞いた","つたえきいた"],["人々","ひとびと"],["は"],["、"],["みな"],["非常","ひじょう"],["な"],["おそれ"],["を"],["感じた","かんじた"],["。"]]},{"verse":6,"text":"それから、若者,わかものたちが立,たって、その死体,したいを包,つつみ、運,はこび出,だして葬,ほうむった。","tok":[["それ"],["から"],["、"],["若者","わかもの"],["たち"],["が"],["立って","たって"],["、"],["その"],["死体","したい"],["を"],["包","つつみ"],["、"],["運こび","はこび"],["出して","だして"],["葬むった","ほうむった"],["。"]]},{"verse":7,"text":"三時間,じかんばかりたってから、たまたま彼,かれの妻,つまが、この出来事,できごとを知,しらずに、はいってきた。","tok":[["三","さん"],["時間","じかん"],["ら"],["、"],["たまたま"],["彼","かれ"],["の"],["妻","つま"],["が"],["、"],["この"],["出来事","できごと"],["を"],["知らず","しらず"],["に"],["、"],["はいって"],["きた"],["。"]]},{"verse":8,"text":"そこで、ペテロが彼女,かのじょにむかって言,いった、「あの地所,じしょは、これこれの値段,ねだんで売,うったのか。そのとおりか」。彼女,かのじょは「そうです、その値段,ねだんです」と答,こたえた。","tok":[["そこ"],["で"],["、"],["ペテロ"],["が"],["彼女","かのじょ"],["に"],["むかって"],["言った","いった"],["、"],["「"],["あの"],["地所","じしょ"],["は"],["、"],["これ"],["これ"],["の"],["値段","ねだん"],["で"],["売った","うった"],["の"],["か"],["。"],["その"],["とおり"],["か"],["」"],["。"],["彼女","かのじょ"],["は"],["「"],["そう"],["です"],["、"],["その"],["値段","ねだん"],["です"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":9,"text":"ペテロは言,いった、「あなたがたふたりが、心,こころを合,あわせて主,しゅの御霊,みたまを試,こころみるとは、何事,なにごとであるか。見,みよ、あなたの夫,おっとを葬,ほうむった人,ひとたちの足,あしが、そこの門口,かどぐちにきている。あなたも運,はこび出,だされるであろう」。","tok":[["ペテロ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["ふたり"],["が"],["、"],["心","こころ"],["を"],["合","あわせ"],["て"],["主","しゅ"],["の"],["御霊","みたま"],["を"],["試みる","こころみる"],["と"],["は"],["、"],["何事","なにごと"],["で"],["ある"],["か"],["。"],["見よ","みよ"],["、"],["あなた"],["の"],["夫","おっと"],["を"],["葬むった","ほうむった"],["人","ひと"],["たち"],["の"],["足","あし"],["が"],["、"],["そこ"],["の"],["門口","かどぐち"],["に"],["きて"],["いる"],["。"],["あなた"],["も"],["運こび","はこび"],["出されるで","だされるで"],["あろう"],["」"],["。"]]},{"verse":10,"text":"すると女,おんなは、たちまち彼,かれの足,あしもとに倒,たおれて、息,いきが絶,たえた。そこに若者,わかものたちがはいってきて、女,おんなが死,しんでしまっているのを見,み、それを運,はこび出,だしてその夫,おっとのそばに葬,ほうむった。","tok":[["する"],["と"],["女","おんな"],["は"],["、"],["たちまち"],["彼","かれ"],["の"],["足もと","あしもと"],["に"],["倒れて","たおれて"],["、"],["息","いき"],["が"],["絶えた","たえた"],["。"],["そこ"],["に"],["若者","わかもの"],["たち"],["が"],["はいって"],["きて"],["、"],["女","おんな"],["が"],["死んで","しんで"],["しまって"],["いる"],["の"],["を"],["見","み"],["、"],["それ"],["を"],["運こび","はこび"],["出して","だして"],["その"],["夫","おっと"],["の"],["そば"],["に"],["葬むった","ほうむった"],["。"]]},{"verse":11,"text":"教会,きょうかい全体,ぜんたいならびにこれを伝,つたえ聞,きいた人,ひとたちは、みな非常,ひじょうなおそれを感,かんじた。","tok":[["教会","きょうかい"],["全体","ぜんたい"],["ならび"],["に"],["これ"],["を"],["伝え聞いた","つたえきいた"],["人","ひと"],["たち"],["は"],["、"],["みな"],["非常","ひじょう"],["な"],["おそれ"],["を"],["感じた","かんじた"],["。"]]},{"verse":12,"text":"そのころ、多,おおくのしるしと奇跡,きせきとが、次々,つぎつぎに使徒,しとたちの手,てにより人々,ひとびとの中,なかで行,おこなわれた。そして、一同,いちどうは心,こころを一つにして、ソロモンの廊,ろうに集,あつまっていた。","tok":[["その"],["ころ"],["、"],["多く","おおく"],["の"],["しるし"],["と"],["奇跡","きせき"],["と"],["が"],["、"],["次々","つぎつぎ"],["に"],["使徒","しと"],["たち"],["の"],["手","て"],["に"],["より"],["人々","ひとびと"],["の"],["中","なか"],["で"],["行なわれた","おこなわれた"],["。"],["そして"],["、"],["一同","いちどう"],["は"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["して"],["、"],["ソロモン"],["の"],["廊","ろう"],["に"],["集まって","あつまって"],["いた"],["。"]]},{"verse":13,"text":"ほかの者,ものたちは、だれひとり、その交,まじわりに入,いろうとはしなかったが、民衆,みんしゅうは彼,かれらを尊敬,そんけいしていた。","tok":[["ほか"],["の"],["者","もの"],["たち"],["は"],["、"],["だれ"],["ひとり"],["、"],["その"],["交じわり","まじわり"],["に"],["入","いろうと"],["は"],["しなかった"],["が"],["、"],["民衆","みんしゅう"],["は"],["彼","かれ"],["ら"],["を"],["尊敬","そんけい"],["して"],["いた"],["。"]]},{"verse":14,"text":"しかし、主,しゅを信,しんじて仲間,なかまに加,くわわる者,ものが、男女,だんじょとも、ますます多,おおくなってきた。","tok":[["しかし"],["、"],["主","しゅ"],["を"],["信じて","しんじて"],["仲間","なかま"],["に"],["加わわる","くわわる"],["者","もの"],["が"],["、"],["男女","だんじょ"],["とも"],["、"],["ますます"],["多く","おおく"],["なって"],["きた"],["。"]]},{"verse":15,"text":"ついには、病人,びょうにんを大通,おおどおりに運,はこび出,だし、寝台,しんだいや寝床,ねどこの上,うえに置,おいて、ペテロが通,とおるとき、彼,かれの影,かげなりと、そのうちのだれかにかかるようにしたほどであった。","tok":[["ついに"],["は"],["、"],["病人","びょうにん"],["を"],["大通り","おおどおり"],["に"],["運こび","はこび"],["出し","だし"],["、"],["寝台","しんだい"],["や"],["寝床","ねどこ"],["の"],["上","うえ"],["に"],["置いて","おいて"],["、"],["ペテロ"],["が"],["通る","とおる"],["とき"],["、"],["彼","かれ"],["の"],["影","かげ"],["なり"],["と"],["、"],["その"],["うち"],["の"],["だれ"],["か"],["に"],["かかる"],["よう"],["に"],["した"],["ほど"],["で"],["あった"],["。"]]},{"verse":16,"text":"またエルサレム附近,ふきんの町々,まちまちからも、大,おおぜいの人,ひとが、病人,びょうにんや汚,けがれた霊,れいに苦,くるしめられている人,ひとたちを引,ひき連,つれて、集,あつまってきたが、その全部,ぜんぶの者,ものが、ひとり残,のこらずいやされた。","tok":[["また"],["エルサレム"],["附近","ふきん"],["の"],["町々","まちまち"],["から"],["も"],["、"],["大ぜい","おおぜい"],["の"],["人","ひと"],["が"],["、"],["病人","びょうにん"],["や"],["汚","け"],["がれ"],["た"],["霊","れい"],["に"],["苦しめられて","くるしめられて"],["いる"],["人","ひと"],["たち"],["を"],["引連れて","ひきつれて"],["、"],["集まって","あつまって"],["きた"],["が"],["、"],["その"],["全部","ぜんぶ"],["の"],["者","もの"],["が"],["、"],["ひとり"],["残らず","のこらず"],["いやされた"],["。"]]},{"verse":17,"text":"そこで、大祭司,だいさいしとその仲間,なかまの者,もの、すなわち、サドカイ派,はの人,ひとたちが、みな嫉妬,しっとの念,ねんに満,みたされて立,たちあがり、","tok":[["そこ"],["で"],["、"],["大","だい"],["祭司","さいし"],["と"],["その"],["仲間","なかま"],["の"],["者","もの"],["、"],["すなわち"],["、"],["サドカイ"],["派","は"],["の"],["人","ひと"],["たち"],["が"],["、"],["みな"],["嫉妬","しっと"],["の"],["念","ねん"],["に"],["満たされて","みたされて"],["立ちあがり","たちあがり"],["、"]]},{"verse":18,"text":"使徒,しとたちに手,てをかけて捕,とらえ、公共,こうきょうの留置場,りゅうちじょうに入,いれた。","tok":[["使徒","しと"],["たち"],["に"],["手","て"],["を"],["かけて"],["捕らえ","とらえ"],["、"],["公共","こうきょう"],["の"],["留置場","りゅうちじょう"],["に"],["入れた","いれた"],["。"]]},{"verse":19,"text":"ところが夜,よる、主,しゅの使,つかいが獄,ごくの戸,とを開,ひらき、彼,かれらを連,つれ出,だして言,いった、","tok":[["ところ"],["が"],["夜","よる"],["、"],["主","しゅ"],["の"],["使","つかい"],["が"],["獄","ごく"],["の"],["戸","と"],["を"],["開らき","ひらき"],["、"],["彼","かれ"],["ら"],["を"],["連れ出して","つれだして"],["言った","いった"],["、"]]},{"verse":20,"text":"「さあ行,いきなさい。そして、宮,みやの庭,にわに立,たち、この命,いのちの言葉,ことばを漏,もれなく、人々,ひとびとに語,かたりなさい」。","tok":[["「"],["さあ"],["行き","いき"],["なさい"],["。"],["そして"],["、"],["宮","みや"],["の"],["庭","にわ"],["に"],["立ち","たち"],["、"],["この"],["命","いのち"],["の"],["言葉","ことば"],["を"],["漏れなく","もれなく"],["、"],["人々","ひとびと"],["に"],["語り","かたり"],["なさい"],["」"],["。"]]},{"verse":21,"text":"彼,かれらはこれを聞,きき、夜明,よあけごろ宮,みやにはいって教,おしえはじめた。一方,いっぽうでは、大祭司,だいさいしとその仲間,なかまの者,ものとが、集,あつまってきて、議会,ぎかいとイスラエル人,びとの長老,ちょうろう一同,いちどうとを召集,しょうしゅうし、使徒,しとたちを引,ひき出,だしてこさせるために、人,ひとを獄,ごくにつかわした。","tok":[["彼","かれ"],["ら"],["は"],["これ"],["を"],["聞","きき"],["、"],["夜明","よあけ"],["ごろ"],["宮","みや"],["に"],["はいって"],["教え","おしえ"],["はじめた"],["。"],["一方","いっぽう"],["で"],["は"],["、"],["大","だい"],["祭司","さいし"],["と"],["その"],["仲間","なかま"],["の"],["者","もの"],["と"],["が"],["、"],["集まって","あつまって"],["きて"],["、"],["議会","ぎかい"],["と"],["イスラエル"],["人","びと"],["の"],["長老","ちょうろう"],["一同","いちどう"],["と"],["を"],["召集","しょうしゅう"],["し"],["、"],["使徒","しと"],["たち"],["を"],["引出","ひきだし"],["てこ"],["させる"],["ため"],["に"],["、"],["人","ひと"],["を"],["獄","ごく"],["に"],["つかわした"],["。"]]},{"verse":22,"text":"そこで、下役,したやくどもが行,いって見,みると、使徒,しとたちが獄,ごくにいないので、引,ひき返,かえして報告,ほうこくした、","tok":[["そこ"],["で"],["、"],["下役","したやく"],["ども"],["が"],["行って","いって"],["見る","みる"],["と"],["、"],["使徒","しと"],["たち"],["が"],["獄","ごく"],["に"],["いない"],["ので"],["、"],["引","ひき"],["返","かえし"],["て"],["報告","ほうこく"],["した"],["、"]]},{"verse":23,"text":"「獄,ごくには、しっかりと錠,じょうがかけてあり、戸口,とぐちには、番人,ばんにんが立,たっていました。ところが、あけて見,みたら、中,なかにはだれもいませんでした」。","tok":[["「"],["獄","ごく"],["に"],["は"],["、"],["しっかり"],["と"],["錠","じょう"],["が"],["かけて"],["あり"],["、"],["戸口","とぐち"],["に"],["は"],["、"],["番人","ばんにん"],["が"],["立って","たって"],["いました"],["。"],["ところ"],["が"],["、"],["あけて"],["見たら","みたら"],["、"],["中","なか"],["に"],["は"],["だれ"],["も"],["いませんでした"],["」"],["。"]]},{"verse":24,"text":"宮守,みやもりがしらと祭司長,さいしちょうたちとは、この報告,ほうこくを聞,きいて、これは、いったい、どんな事,ことになるのだろうと、あわて惑,まどっていた。","tok":[["宮守","みやもり"],["がしら"],["と"],["祭司長","さいしちょう"],["たち"],["と"],["は"],["、"],["この"],["報告","ほうこく"],["を"],["聞いて","きいて"],["、"],["これ"],["は"],["、"],["いったい"],["、"],["どんな"],["事","こと"],["に"],["なる"],["の"],["だろう"],["と"],["、"],["あわて惑って","あわてまどって"],["いた"],["。"]]},{"verse":25,"text":"そこへ、ある人,ひとがきて知,しらせた、「行,いってごらんなさい。あなたがたが獄,ごくに入,いれたあの人,ひとたちが、宮,みやの庭,にわに立,たって、民衆,みんしゅうを教,おしえています」。","tok":[["そこ"],["へ"],["、"],["ある"],["人","ひと"],["が"],["きて"],["知らせた","しらせた"],["、"],["「"],["行って","いって"],["ごらん"],["なさい"],["。"],["あなた"],["がた"],["が"],["獄","ごく"],["に"],["入れた","いれた"],["あの"],["人","ひと"],["たち"],["が"],["、"],["宮","みや"],["の"],["庭","にわ"],["に"],["立って","たって"],["、"],["民衆","みんしゅう"],["を"],["教えて","おしえて"],["います"],["」"],["。"]]},{"verse":26,"text":"そこで宮守,みやもりがしらが、下役,したやくどもと一緒,いっしょに出,でかけて行,いって、使徒,しとたちを連,つれてきた。しかし、人々,ひとびとに石,いしで打,うち殺,ころされるのを恐,おそれて、手荒,てあらなことはせず、","tok":[["そこ"],["で"],["宮守","みやもり"],["が"],["しらが"],["、"],["下役","したやく"],["ども"],["と"],["一緒","いっしょ"],["に"],["出かけて","でかけて"],["行って","いって"],["、"],["使徒","しと"],["たち"],["を"],["連れて","つれて"],["きた"],["。"],["しかし"],["、"],["人々","ひとびと"],["に"],["石","いし"],["で"],["打ち","うち"],["殺ろ","ころ"],["される"],["の"],["を"],["恐れて","おそれて"],["、"],["手荒","てあら"],["な"],["こと"],["は"],["せず"],["、"]]},{"verse":27,"text":"彼,かれらを連,つれてきて、議会,ぎかいの中,なかに立,たたせた。すると、大祭司,だいさいしが問,とうて","tok":[["彼","かれ"],["ら"],["を"],["連れて","つれて"],["きて"],["、"],["議会","ぎかい"],["の"],["中","なか"],["に"],["立たせた","たたせた"],["。"],["する"],["と"],["、"],["大","だい"],["祭司","さいし"],["が"],["問うて","とうて"]]},{"verse":28,"text":"言,いった、「あの名,なを使,つかって教,おしえてはならないと、きびしく命,めいじておいたではないか。それだのに、なんという事,ことだ。エルサレム中,なかにあなたがたの教,おしえを、はんらんさせている。あなたがたは確,たしかに、あの人,ひとの血,ちの責任,せきにんをわたしたちに負,おわせようと、たくらんでいるのだ」。","tok":[["言った","いった"],["、"],["「"],["あの"],["名","な"],["を"],["使って","つかって"],["教えて","おしえて"],["は"],["ならない"],["と"],["、"],["きびしく"],["命じて","めいじて"],["おいたで"],["は"],["ない"],["か"],["。"],["それ"],["だ"],["のに"],["、"],["なん"],["と"],["いう"],["事","こと"],["だ"],["。"],["エルサレム"],["中","なか"],["に"],["あなた"],["がた"],["の"],["教え","おしえ"],["を"],["、"],["はんらん"],["させて"],["いる"],["。"],["あなた"],["がた"],["は"],["確か","たしか"],["に"],["、"],["あの"],["人","ひと"],["の"],["血","ち"],["の"],["責任","せきにん"],["を"],["わたしたち"],["に"],["負わせよう","おわせよう"],["と"],["、"],["たくらんで"],["いる"],["の"],["だ"],["」"],["。"]]},{"verse":29,"text":"これに対,たいして、ペテロをはじめ使徒,しとたちは言,いった、「人間,にんげんに従,したがうよりは、神,かみに従,したがうべきである。","tok":[["これ"],["に対して","にたいして"],["、"],["ペテロ"],["を"],["はじめ"],["使徒","しと"],["たち"],["は"],["言った","いった"],["、"],["「"],["人間","にんげん"],["に"],["従う","したがう"],["より"],["は"],["、"],["神","かみ"],["に"],["従うべきで","したがうべきで"],["ある"],["。"]]},{"verse":30,"text":"わたしたちの先祖,せんぞの神,かみは、あなたがたが木,きにかけて殺,ころしたイエスをよみがえらせ、","tok":[["わたしたち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["は"],["、"],["あなた"],["がた"],["が"],["木","き"],["に"],["かけて"],["殺ろした","ころした"],["イエス"],["を"],["よみがえらせ"],["、"]]},{"verse":31,"text":"そして、イスラエルを悔,くい改,あらためさせてこれに罪,つみのゆるしを与,あたえるために、このイエスを導,みちびき手,てとし救主,すくいぬしとして、ご自身,じしんの右,みぎに上,あげられたのである。","tok":[["そして"],["、"],["イスラエル"],["を"],["悔い","くい"],["改","あらため"],["させて"],["これ"],["に"],["罪","つみ"],["の"],["ゆるし"],["を"],["与える","あたえる"],["ため"],["に"],["、"],["この"],["イエス"],["を"],["導き手","みちびきて"],["と"],["し"],["救主","すくいぬし"],["として"],["、"],["ご自身","ごじしん"],["の"],["右","みぎ"],["に"],["上げられた","あげられた"],["ので"],["ある"],["。"]]},{"verse":32,"text":"わたしたちはこれらの事,ことの証人,しょうにんである。神,かみがご自身,じしんに従,したがう者,ものに賜,たまわった聖霊,せいれいもまた、その証人,しょうにんである」。","tok":[["わたしたち"],["は"],["これ"],["ら"],["の"],["事","こと"],["の"],["証人","しょうにん"],["で"],["ある"],["。"],["神","かみ"],["が"],["ご自身","ごじしん"],["に"],["従う","したがう"],["者","もの"],["に"],["賜わった","たまわった"],["聖霊","せいれい"],["も"],["また"],["、"],["その"],["証人","しょうにん"],["で"],["ある"],["」"],["。"]]},{"verse":33,"text":"これを聞,きいた者,ものたちは、激,はげしい怒,いかりのあまり、使徒,しとたちを殺,ころそうと思,おもった。","tok":[["これ"],["を"],["聞いた","きいた"],["者","もの"],["たち"],["は"],["、"],["激しい","はげしい"],["怒り","いかり"],["の"],["あまり"],["、"],["使徒","しと"],["たち"],["を"],["殺そう","ころそう"],["と"],["思った","おもった"],["。"]]},{"verse":34,"text":"ところが、国民,こくみん全体,ぜんたいに尊敬,そんけいされていた律法,りっぽう学者,がくしゃガマリエルというパリサイ人,びとが、議会,ぎかいで立,たって、使徒,しとたちをしばらくのあいだ外,そとに出,だすように要求,ようきゅうしてから、","tok":[["ところ"],["が"],["、"],["国民","こくみん"],["全体","ぜんたい"],["に"],["尊敬","そんけい"],["されて"],["いた"],["律法学者","りっぽうがくしゃ"],["ガマリエル"],["と"],["いう"],["パリサイ"],["人","び"],["と"],["が"],["、"],["議会","ぎかい"],["で"],["立って","たって"],["、"],["使徒","しと"],["たち"],["を"],["しばらく"],["の"],["あいだ"],["外","そと"],["に"],["出す","だす"],["よう"],["に"],["要求","ようきゅう"],["して"],["から"],["、"]]},{"verse":35,"text":"一同,いちどうにむかって言,いった、「イスラエルの諸君,しょくん、あの人,ひとたちをどう扱,あつかうか、よく気,きをつけるがよい。","tok":[["一同","いちどう"],["に"],["むかって"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["諸君","しょくん"],["、"],["あの"],["人","ひと"],["たち"],["を"],["どう"],["扱う","あつかう"],["か"],["、"],["よく"],["気","き"],["を"],["つける"],["が"],["よい"],["。"]]},{"verse":36,"text":"先,さきごろ、チゥダが起,おこって、自分,じぶんを何,なにか偉,えらい者,もののように言,いいふらしたため、彼,かれに従,したがった男,おとこの数,かずが、四百人,にんほどもあったが、結局,けっきょく、彼,かれは殺,ころされてしまい、従,したがった者,ものもみな四散,しさんして、全,まったく跡,あと方,ほうもなくなっている。","tok":[["先ごろ","さきごろ"],["、"],["チゥダ"],["が"],["起こって","おこって"],["、"],["自分","じぶん"],["を"],["何に","なに"],["か"],["偉い","えらい"],["者","もの"],["の"],["よう"],["に"],["言いふらした","いいふらした"],["ため"],["、"],["彼","かれ"],["に"],["従った","したがった"],["男","おとこ"],["の"],["数","かず"],["が"],["、"],["四百人","にんほど"],["も"],["あった"],["が"],["、"],["結局","けっきょく"],["、"],["彼","かれ"],["は"],["殺ろされて","ころされて"],["しまい"],["、"],["従った","したがった"],["者","もの"],["も"],["みな"],["四散","しさん"],["して"],["、"],["全く","まったく"],["跡方","あとほう"],["も"],["なくなって"],["いる"],["。"]]},{"verse":37,"text":"そののち、人口,じんこう調査,ちょうさの時,ときに、ガリラヤ人,ひとユダが民衆,みんしゅうを率,ひきいて反乱,はんらんを起,おこしたが、この人,ひとも滅,ほろび、従,したがった者,ものもみな散,ちらされてしまった。","tok":[["その"],["のち"],["、"],["人口","じんこう"],["調査","ちょうさ"],["の"],["時","とき"],["に"],["、"],["ガリラヤ"],["人","ひと"],["ユダ"],["が"],["民衆","みんしゅう"],["を"],["率いて","ひきいて"],["反乱","はんらん"],["を"],["起こした","おこした"],["が"],["、"],["この"],["人","ひと"],["も"],["滅び","ほろび"],["、"],["従った","したがった"],["者","もの"],["も"],["みな"],["散らされて","ちらされて"],["しまった"],["。"]]},{"verse":38,"text":"そこで、この際,さい、諸君,しょくんに申,もうし上,あげる。あの人,ひとたちから手,てを引,ひいて、そのなすままにしておきなさい。その企,くわだてや、しわざが、人間,にんげんから出,でたものなら、自滅,じめつするだろう。","tok":[["そこ"],["で"],["、"],["この"],["際","さい"],["、"],["諸君","しょくん"],["に"],["申し上げる","もうしあげる"],["。"],["あの"],["人","ひと"],["たち"],["から"],["手","て"],["を"],["引いて","ひいて"],["、"],["その"],["なす"],["まま"],["に"],["して"],["おき"],["なさい"],["。"],["その"],["企だて","くわだて"],["や"],["、"],["しわざ"],["が"],["、"],["人間","にんげん"],["から"],["出た","でた"],["もの"],["なら"],["、"],["自滅","じめつ"],["するだろう"],["。"]]},{"verse":39,"text":"しかし、もし神,かみから出,でたものなら、あの人,ひとたちを滅,ほろぼすことはできまい。まかり違,ちがえば、諸君,しょくんは神,かみを敵,てきにまわすことになるかも知,しれない」。そこで彼,かれらはその勧告,かんこくにしたがい、","tok":[["しかし"],["、"],["もし"],["神","かみ"],["から"],["出た","でた"],["もの"],["なら"],["、"],["あの"],["人","ひと"],["たち"],["を"],["滅ぼす","ほろぼす"],["こと"],["は"],["できまい"],["。"],["まかり"],["違えば","ちがえば"],["、"],["諸君","しょくん"],["は"],["神","かみ"],["を"],["敵","てき"],["に"],["まわす"],["こと"],["に"],["なる"],["か"],["も"],["知れない","しれない"],["」"],["。"],["そこ"],["で"],["彼","かれ"],["ら"],["は"],["その"],["勧告","かんこく"],["に"],["したがい"],["、"]]},{"verse":40,"text":"使徒,しとたちを呼,よび入,いれて、むち打,うったのち、今後,こんごイエスの名,なによって語,かたることは相成,あいならぬと言,いいわたして、ゆるしてやった。","tok":[["使徒","しと"],["たち"],["を"],["呼び入れて","よびいれて"],["、"],["むち打った","むちうった"],["のち"],["、"],["今後","こんご"],["イエス"],["の"],["名","な"],["によって"],["語る","かたる"],["こと"],["は"],["相","あい"],["成らぬ","ならぬ"],["と"],["言いわたして","いいわたして"],["、"],["ゆるして"],["やった"],["。"]]},{"verse":41,"text":"使徒,しとたちは、御名,みなのために恥,はじを加,くわえられるに足,たる者,ものとされたことを喜,よろこびながら、議会,ぎかいから出,でてきた。","tok":[["使徒","しと"],["たち"],["は"],["、"],["御名","みな"],["の"],["ため"],["に"],["恥","はじ"],["を"],["加えられる","くわえられる"],["に"],["足る","たる"],["者","もの"],["と"],["された"],["こと"],["を"],["喜こび","よろこび"],["ながら"],["、"],["議会","ぎかい"],["から"],["出て","でて"],["きた"],["。"]]},{"verse":42,"text":"そして、毎日,まいにち、宮,みやや家,いえで、イエスがキリストであることを、引,ひきつづき教,おしえたり宣,のべ伝,つたえたりした。","tok":[["そして"],["、"],["毎日","まいにち"],["、"],["宮","みや"],["や"],["家","いえ"],["で"],["、"],["イエス"],["が"],["キリスト"],["で"],["ある"],["こと"],["を"],["、"],["引","ひき"],["つづき"],["教え","おしえ"],["たり"],["宣べ伝え","のべつたえ"],["たり"],["した"],["。"]]}]
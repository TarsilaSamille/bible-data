[{"verse":1,"text":"サウロは、ステパノを殺,ころすことに賛成,さんせいしていた。その日,ひ、エルサレムの教会,きょうかいに対,たいして大,おお迫害,はくがいが起,おこり、使徒,しと以外,いがいの者,ものはことごとく、ユダヤとサマリヤとの地方,ちほうに散,ちらされて行,いった。","tok":[["サウロ"],["は"],["、"],["ステパノ"],["を"],["殺ろす","ころす"],["こと"],["に"],["賛成","さんせい"],["して"],["いた"],["。"],["その"],["日","ひ"],["、"],["エルサレム"],["の"],["教会","きょうかい"],["に対して","にたいして"],["大","お"],["お迫害","おはくがい"],["が"],["起こり","おこり"],["、"],["使徒","しと"],["以外","いがい"],["の"],["者","もの"],["は"],["ことごとく"],["、"],["ユダヤ"],["と"],["サマリヤ"],["と"],["の"],["地方","ちほう"],["に"],["散らされて","ちらされて"],["行った","いった"],["。"]]},{"verse":2,"text":"信仰,しんこう深,ぶかい人,ひとたちはステパノを葬,ほうむり、彼,かれのために胸,むねを打,うって、非常,ひじょうに悲,かなしんだ。","tok":[["信仰","しんこう"],["深い","ぶかい"],["人","ひと"],["たち"],["は"],["ステパノ"],["を"],["葬むり","ほうむり"],["、"],["彼","かれ"],["の"],["ため"],["に"],["胸","むね"],["を"],["打って","うって"],["、"],["非常","ひじょう"],["に"],["悲しんだ","かなしんだ"],["。"]]},{"verse":3,"text":"ところが、サウロは家々,いえいえに押,おし入,いって、男,おとこや女,おんなを引,ひきずり出,だし、次々,つぎつぎに獄,ごくに渡,わたして、教会,きょうかいを荒,あらし回,まわった。","tok":[["ところ"],["が"],["、"],["サウロ"],["は"],["家々","いえいえ"],["に"],["押入って","おしいって"],["、"],["男","おとこ"],["や"],["女","おんな"],["を"],["引","ひき"],["ずり出し","ずりだし"],["、"],["次々","つぎつぎ"],["に"],["獄","ごく"],["に"],["渡","わたし"],["て"],["、"],["教会","きょうかい"],["を"],["荒し","あらし"],["回わった","まわった"],["。"]]},{"verse":4,"text":"さて、散,ちらされて行,いった人,ひとたちは、御言,みことばを宣,のべ伝,つたえながら、めぐり歩,あるいた。","tok":[["さて"],["、"],["散らされて","ちらされて"],["行った","いった"],["人","ひと"],["たち"],["は"],["、"],["御言","みこと"],["ば"],["を"],["宣べ伝え","のべつたえ"],["ながら"],["、"],["めぐり歩いた","めぐりあるいた"],["。"]]},{"verse":5,"text":"ピリポはサマリヤの町,まちに下,くだって行,いき、人々,ひとびとにキリストを宣,のべはじめた。","tok":[["ピリポ"],["は"],["サマリヤ"],["の"],["町","まち"],["に"],["下って","くだって"],["行き","いき"],["、"],["人々","ひとびと"],["に"],["キリスト"],["を"],["宣べ","のべ"],["はじめた"],["。"]]},{"verse":6,"text":"群衆,ぐんしゅうはピリポの話,はなしを聞,きき、その行,おこなっていたしるしを見,みて、こぞって彼,かれの語,かたることに耳,みみを傾,かたむけた。","tok":[["群衆","ぐんしゅう"],["は"],["ピリポ"],["の"],["話","はなし"],["を"],["聞","きき"],["、"],["その"],["行なって","おこなって"],["いた"],["しるし"],["を"],["見て","みて"],["、"],["こぞって"],["彼","かれ"],["の"],["語る","かたる"],["こと"],["に"],["耳","みみ"],["を"],["傾むけた","かたむけた"],["。"]]},{"verse":7,"text":"汚,けがれた霊,れいにつかれた多,おおくの人々,ひとびとからは、その霊,れいが大声,おおごえでわめきながら出,でて行,いくし、また、多,おおくの中風,ちゅうぶをわずらっている者,ものや、足,あしのきかない者,ものがいやされたからである。","tok":[["汚","け"],["がれ"],["た"],["霊","れい"],["に"],["つかれた"],["多く","おおく"],["の"],["人々","ひとびと"],["から"],["は"],["、"],["その"],["霊","れい"],["が"],["大声","おおごえ"],["で"],["わめき"],["ながら"],["出て","でて"],["行く","いく"],["し"],["、"],["また"],["、"],["多く","おおく"],["の"],["中風","ちゅうぶ"],["を"],["わずらって"],["いる"],["者","もの"],["や"],["、"],["足","あし"],["の"],["きかない"],["者","もの"],["が"],["いやされた"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"それで、この町,まちでは人々,ひとびとが、大変,たいへんなよろこびかたであった。","tok":[["それ"],["で"],["、"],["この"],["町","まち"],["で"],["は"],["人々","ひとびと"],["が"],["、"],["大変","たいへん"],["な"],["よろこび"],["かた"],["で"],["あった"],["。"]]},{"verse":9,"text":"さて、この町,まちに以前,いぜんからシモンという人,ひとがいた。彼,かれは魔術,まじゅつを行,おこなってサマリヤの人,ひとたちを驚,おどろかし、自分,じぶんをさも偉,えらい者,もののように言,いいふらしていた。","tok":[["さて"],["、"],["この"],["町","まち"],["に"],["以前","いぜん"],["から"],["シモン"],["と"],["いう"],["人","ひと"],["が"],["いた"],["。"],["彼","かれ"],["は"],["魔術","まじゅつ"],["を"],["行なって","おこなって"],["サマリヤ"],["の"],["人","ひと"],["たち"],["を"],["驚ろかし","おどろかし"],["、"],["自分","じぶん"],["を"],["さも"],["偉い","えらい"],["者","もの"],["の"],["よう"],["に"],["言いふらして","いいふらして"],["いた"],["。"]]},{"verse":10,"text":"それで、小,ちいさい者,ものから大,おおきい者,ものにいたるまで皆,みな、彼,かれについて行,いき、「この人,ひとこそは『大能,たいのう』と呼,よばれる神,かみの力,ちからである」と言,いっていた。","tok":[["それ"],["で"],["、"],["小さい","ちいさい"],["者","もの"],["から"],["大きい","おおきい"],["者","もの"],["に"],["いたる"],["まで"],["皆","みな"],["、"],["彼","かれ"],["について"],["行き","いき"],["、"],["「"],["この"],["人","ひと"],["こそ"],["は"],["『"],["大能","た"],["い"],["のう"],["』"],["と"],["呼ばれる","よばれる"],["神","かみ"],["の"],["力","ちから"],["で"],["ある"],["」"],["と"],["言って","いって"],["いた"],["。"]]},{"verse":11,"text":"彼,かれらがこの人,ひとについて行,いったのは、ながい間,あいだその魔術,まじゅつに驚,おどろかされていたためであった。","tok":[["彼","かれ"],["ら"],["が"],["この"],["人","ひと"],["について"],["行った","いった"],["の"],["は"],["、"],["ながい"],["間","あいだ"],["その"],["魔術","まじゅつ"],["に"],["驚ろかされて","おどろかされて"],["いた"],["ため"],["で"],["あった"],["。"]]},{"verse":12,"text":"ところが、ピリポが神,かみの国,くにとイエス・キリストの名,なについて宣,のべ伝,つたえるに及,およんで、男,おとこも女,おんなも信,しんじて、ぞくぞくとバプテスマを受,うけた。","tok":[["ところ"],["が"],["、"],["ピリポ"],["が"],["神","かみ"],["の"],["国","くに"],["と"],["イエス"],["・"],["キリスト"],["の"],["名","な"],["について"],["宣べ伝える","のべつたえる"],["に"],["及んで","およんで"],["、"],["男","おとこ"],["も"],["女","おんな"],["も"],["信じて","しんじて"],["、"],["ぞくぞく"],["と"],["バプテスマ"],["を"],["受た","うけた"],["。"]]},{"verse":13,"text":"シモン自身,じしんも信,しんじて、バプテスマを受,うけ、それから、引,ひきつづきピリポについて行,いった。そして、数々,かずかずのしるしやめざましい奇跡,きせきが行,おこなわれるのを見,みて、驚,おどろいていた。","tok":[["シモン"],["自身","じしん"],["も"],["信じて","しんじて"],["、"],["バプテスマ"],["を"],["受け","うけ"],["、"],["それ"],["から"],["、"],["引","ひき"],["つづき"],["ピリポ"],["について"],["行った","いった"],["。"],["そして"],["、"],["数々","かずかず"],["の"],["しるし"],["や"],["めざましい"],["奇跡","きせき"],["が"],["行なわれる","おこなわれる"],["の"],["を"],["見て","みて"],["、"],["驚ろいて","おどろいて"],["いた"],["。"]]},{"verse":14,"text":"エルサレムにいる使徒,しとたちは、サマリヤの人々,ひとびとが、神,かみの言,ことばを受,うけ入,いれたと聞,きいて、ペテロとヨハネとを、そこにつかわした。","tok":[["エルサレム"],["に"],["いる"],["使徒","しと"],["たち"],["は"],["、"],["サマリヤ"],["の"],["人々","ひとびと"],["が"],["、"],["神","かみ"],["の"],["言","ことば"],["を"],["受け入れた","うけいれた"],["と"],["聞いて","きいて"],["、"],["ペテロ"],["と"],["ヨハネ"],["と"],["を"],["、"],["そこ"],["に"],["つかわした"],["。"]]},{"verse":15,"text":"ふたりはサマリヤに下,くだって行,いって、みんなが聖霊,せいれいを受,うけるようにと、彼,かれらのために祈,いのった。","tok":[["ふたり"],["は"],["サマリヤ"],["に"],["下って","くだって"],["行って","いって"],["、"],["みんな"],["が"],["聖霊","せいれい"],["を"],["受る","うける"],["よう"],["に"],["と"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["祈った","いのった"],["。"]]},{"verse":16,"text":"それは、彼,かれらはただ主,しゅイエスの名,なによってバプテスマを受,うけていただけで、聖霊,せいれいはまだだれにも下,くだっていなかったからである。","tok":[["それ"],["は"],["、"],["彼","かれ"],["ら"],["は"],["ただ"],["主","しゅ"],["イエス"],["の"],["名","な"],["によって"],["バプテスマ"],["を"],["受て","うけて"],["いた"],["だけ"],["で"],["、"],["聖霊","せいれい"],["は"],["まだ"],["だれ"],["に"],["も"],["下って","くだって"],["いなかった"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"そこで、ふたりが手,てを彼,かれらの上,うえにおいたところ、彼,かれらは聖霊,せいれいを受,うけた。","tok":[["そこ"],["で"],["、"],["ふたり"],["が"],["手","て"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["おいた"],["ところ"],["、"],["彼","かれ"],["ら"],["は"],["聖霊","せいれい"],["を"],["受た","うけた"],["。"]]},{"verse":18,"text":"シモンは、使徒,しとたちが手,てをおいたために、御霊,みたまが人々,ひとびとに授,さづけられたのを見,みて、金,かねをさし出,だし、","tok":[["シモン"],["は"],["、"],["使徒","しと"],["たち"],["が"],["手","て"],["を"],["おいた"],["ため"],["に"],["、"],["御霊","み"],["たま"],["が"],["人々","ひとびと"],["に"],["授","さ"],["づけられた"],["の"],["を"],["見て","みて"],["、"],["金","かね"],["を"],["さし出し","さしだし"],["、"]]},{"verse":19,"text":"「わたしが手,てをおけばだれにでも聖霊,せいれいが授,さづけられるように、その力,ちからをわたしにも下,ください」と言,いった。","tok":[["「"],["わたし"],["が"],["手","て"],["を"],["おけば"],["だれ"],["に"],["で"],["も"],["聖霊","せいれい"],["が"],["授","さ"],["づけられる"],["よう"],["に"],["、"],["その"],["力","ちから"],["を"],["わたし"],["に"],["も"],["下さい","ください"],["」"],["と"],["言った","いった"],["。"]]},{"verse":20,"text":"そこで、ペテロが彼,かれに言,いった、「おまえの金,かねは、おまえもろとも、うせてしまえ。神,かみの賜物,たまものが、金,かねで得,えられるなどと思,おもっているのか。","tok":[["そこ"],["で"],["、"],["ペテロ"],["が"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["おまえ"],["の"],["金","かね"],["は"],["、"],["おまえ"],["もろとも"],["、"],["うせて"],["しまえ"],["。"],["神","かみ"],["の"],["賜物","たまもの"],["が"],["、"],["金","かね"],["で"],["得られる","えられる"],["など"],["と"],["思って","おもって"],["いる"],["の"],["か"],["。"]]},{"verse":21,"text":"おまえの心,こころが神,かみの前,まえに正,ただしくないから、おまえは、とうてい、この事,ことにあずかることができない。","tok":[["おまえ"],["の"],["心","こころ"],["が"],["神","かみ"],["の"],["前","まえ"],["に"],["正く","ただしく"],["ない"],["から"],["、"],["おまえ"],["は"],["、"],["とうてい"],["、"],["この"],["事","こと"],["に"],["あずかる"],["こと"],["が"],["できない"],["。"]]},{"verse":22,"text":"だから、この悪事,あくじを悔,くいて、主,しゅに祈,いのれ。そうすればあるいはそんな思,おもいを心,こころにいだいたことが、ゆるされるかも知,しれない。","tok":[["だ"],["から"],["、"],["この"],["悪事","あくじ"],["を"],["悔いて","くいて"],["、"],["主に","しゅに"],["祈れ","いのれ"],["。"],["そう"],["すれば"],["あるいは"],["そんな"],["思い","おもい"],["を"],["心","こころ"],["に"],["いだいた"],["こと"],["が"],["、"],["ゆるされる"],["か"],["も"],["知れない","しれない"],["。"]]},{"verse":23,"text":"おまえには、まだ苦,にがい胆汁,たんじゅうがあり、不義,ふぎのなわ目,めがからみついている。それが、わたしにわかっている」。","tok":[["おまえ"],["に"],["は"],["、"],["まだ"],["苦い","にがい"],["胆汁","たんじゅう"],["が"],["あり"],["、"],["不義","ふぎ"],["の"],["なわ目","なわめ"],["が"],["からみついて"],["いる"],["。"],["それ"],["が"],["、"],["わたし"],["に"],["わかって"],["いる"],["」"],["。"]]},{"verse":24,"text":"シモンはこれを聞,きいて言,いった、「仰,おおせのような事,ことが、わたしの身,みに起,おこらないように、どうぞ、わたしのために主,しゅに祈,いのって下,ください」。","tok":[["シモン"],["は"],["これ"],["を"],["聞いて","きいて"],["言った","いった"],["、"],["「"],["仰せ","おおせ"],["の"],["よう"],["な"],["事","こと"],["が"],["、"],["わたし"],["の"],["身","み"],["に"],["起こらない","おこらない"],["よう"],["に"],["、"],["どうぞ"],["、"],["わたし"],["の"],["ため"],["に"],["主","しゅ"],["に"],["祈って","いのって"],["下さい","ください"],["」"],["。"]]},{"verse":25,"text":"使徒,しとたちは力強,ちからづよくあかしをなし、また主,しゅの言,ことばを語,かたった後,のち、サマリヤ人,ひとの多,おおくの村々,むらむらに福音,ふくいんを宣,のべ伝,つたえて、エルサレムに帰,かえった。","tok":[["使徒","しと"],["たち"],["は"],["力強く","ちからづよく"],["あかし"],["を"],["なし"],["、"],["また"],["主","しゅ"],["の"],["言","ことば"],["を"],["語った","かたった"],["後","の"],["ち"],["、"],["サマリヤ"],["人","ひと"],["の"],["多く","おおく"],["の"],["村々","むらむら"],["に"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["、"],["エルサレム"],["に"],["帰えった","かえった"],["。"]]},{"verse":26,"text":"しかし、主,しゅの使,つかいがピリポにむかって言,いった、「立,たって南方,なんぽうに行,いき、エルサレムからガザへ下,くだる道,みちに出,でなさい」（このガザは、今,いまは荒,あれはてている）。","tok":[["しかし"],["、"],["主","しゅ"],["の"],["使","つかい"],["が"],["ピリポ"],["に"],["むかって"],["言った","いった"],["、"],["「"],["立って","たって"],["南方","なんぽう"],["に"],["行き","いき"],["、"],["エルサレム"],["から"],["ガザ"],["へ"],["下る","くだる"],["道","みち"],["に"],["出","で"],["なさい"],["」"],["（"],["この"],["ガザ"],["は"],["、"],["今","いま"],["は"],["荒れはてて","あれはてて"],["いる"],["）"],["。"]]},{"verse":27,"text":"そこで、彼,かれは立,たって出,でかけた。すると、ちょうど、エチオピヤ人,じんの女王,じょおうカンダケの高官,こうかんで、女王,じょおうの財宝,ざいほう全部,ぜんぶを管理,かんりしていた宦官,かんがんであるエチオピヤ人,じんが、礼拝,れいはいのためエルサレムに上,のぼり、","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["立って","たって"],["出かけた","でかけた"],["。"],["する"],["と"],["、"],["ちょうど"],["、"],["エチオピヤ"],["人","じん"],["の"],["女王","じょおう"],["カンダケ"],["の"],["高官","こうかん"],["で"],["、"],["女王","じょおう"],["の"],["財宝","ざいほう"],["全部","ぜんぶ"],["を"],["管理","かんり"],["して"],["いた"],["宦官","かんがん"],["で"],["ある"],["エチオピヤ"],["人","じん"],["が"],["、"],["礼拝","れいはい"],["の"],["ため"],["エルサレム"],["に"],["上り","のぼり"],["、"]]},{"verse":28,"text":"その帰途,きとについていたところであった。彼,かれは自分,じぶんの馬車,ばしゃに乗,のって、預言者,よげんしゃイザヤの書,しょを読,よんでいた。","tok":[["その"],["帰途","きと"],["について"],["いた"],["ところ"],["で"],["あった"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["馬車","ばしゃ"],["に"],["乗って","のって"],["、"],["預言者","よげんしゃ"],["イザヤ"],["の"],["書","しょ"],["を"],["読んで","よんで"],["いた"],["。"]]},{"verse":29,"text":"御霊,みたまがピリポに「進,すすみ寄,よって、あの馬車,ばしゃに並,ならんで行,いきなさい」と言,いった。","tok":[["御霊","み"],["たま"],["が"],["ピリポ"],["に"],["「"],["進み寄って","すすみよって"],["、"],["あの"],["馬車","ばしゃ"],["に"],["並んで","ならんで"],["行き","いき"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":30,"text":"そこでピリポが駆,かけて行,いくと、預言者,よげんしゃイザヤの書,しょを読,よんでいるその人,ひとの声,こえが聞,きこえたので、「あなたは、読,よんでいることが、おわかりですか」と尋,たずねた。","tok":[["そこ"],["で"],["ピリポ"],["が"],["駆けて","かけて"],["行く","いく"],["と"],["、"],["預言者","よげんしゃ"],["イザヤ"],["の"],["書","しょ"],["を"],["読んで","よんで"],["いる"],["その"],["人","ひと"],["の"],["声","こえ"],["が"],["聞こえた","きこえた"],["ので"],["、"],["「"],["あなた"],["は"],["、"],["読","よん"],["で"],["いる"],["こと"],["が"],["、"],["おわかりです"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":31,"text":"彼,かれは「だれかが、手,てびきをしてくれなければ、どうしてわかりましょう」と答,こたえた。そして、馬車,ばしゃに乗,のって一緒,いっしょにすわるようにと、ピリポにすすめた。","tok":[["彼","かれ"],["は"],["「"],["だれ"],["か"],["が"],["、"],["手びき","てびき"],["を"],["して"],["くれなければ"],["、"],["どう"],["して"],["わかりましょう"],["」"],["と"],["答","こたえ"],["た"],["。"],["そして"],["、"],["馬車","ばしゃ"],["に"],["乗って","のって"],["一緒","いっしょ"],["に"],["すわる"],["よう"],["に"],["と"],["、"],["ピリポ"],["に"],["すすめた"],["。"]]},{"verse":32,"text":"彼,かれが読,よんでいた聖書,せいしょの箇所,かしょは、これであった、「彼,かれは、ほふり場,ばに引,ひかれて行,いく羊,ひつじのように、また、黙々,もくもくとして、毛,けを刈,かる者,ものの前,まえに立,たつ小羊,こひつじのように、口,くちを開,ひらかない。","tok":[["彼","かれ"],["が"],["読んで","よんで"],["いた"],["聖書","せいしょ"],["の"],["箇所","かしょ"],["は"],["、"],["これ"],["で"],["あった"],["、"],["「"],["彼","かれ"],["は"],["、"],["ほふり場","ほふりば"],["に"],["引かれて","ひかれて"],["行く","いく"],["羊","ひつじ"],["の"],["よう"],["に"],["、"],["また"],["、"],["黙々","もくもく"],["として"],["、"],["毛","け"],["を"],["刈る","かる"],["者","もの"],["の"],["前","まえ"],["に"],["立つ","たつ"],["小羊","こひつじ"],["の"],["よう"],["に"],["、"],["口","くち"],["を"],["開らかない","ひらかない"],["。"]]},{"verse":33,"text":"彼,かれは、いやしめられて、そのさばきも行,おこなわれなかった。だれが、彼,かれの子孫,しそんのことを語,かたることができようか、彼,かれの命,いのちが地上,ちじょうから取,とり去,さられているからには」。","tok":[["彼","かれ"],["は"],["、"],["いやしめられて"],["、"],["その"],["さばき"],["も"],["行なわれなかった","おこなわれなかった"],["。"],["だれ"],["が"],["、"],["彼","かれ"],["の"],["子孫","しそん"],["の"],["こと"],["を"],["語る","かたる"],["こと"],["が"],["できよう"],["か"],["、"],["彼","かれ"],["の"],["命","いのち"],["が"],["地上","ちじょう"],["から"],["取去られて","とりさられて"],["いる"],["から"],["に"],["は"],["」"],["。"]]},{"verse":34,"text":"宦官,かんがんはピリポにむかって言,いった、「お尋,たずねしますが、ここで預言者,よげんしゃはだれのことを言,いっているのですか。自分,じぶんのことですか、それとも、だれかほかの人,ひとのことですか」。","tok":[["宦官","かんがん"],["は"],["ピリポ"],["に"],["むかって"],["言った","いった"],["、"],["「"],["お尋ね","おたずね"],["します"],["が"],["、"],["ここ"],["で"],["預言者","よげんしゃ"],["は"],["だれ"],["の"],["こと"],["を"],["言って","いって"],["いる"],["の"],["です"],["か"],["。"],["自分","じぶん"],["の"],["こと"],["です"],["か"],["、"],["それ"],["と"],["も"],["、"],["だれ"],["か"],["ほか"],["の"],["人","ひと"],["の"],["こと"],["です"],["か"],["」"],["。"]]},{"verse":35,"text":"そこでピリポは口,くちを開,ひらき、この聖,せい句,くから説,とき起,おこして、イエスのことを宣,のべ伝,つたえた。","tok":[["そこ"],["で"],["ピリポ"],["は"],["口","くち"],["を"],["開らき","ひらき"],["、"],["この"],["聖句","せいく"],["から"],["説き起こして","ときおこして"],["、"],["イエス"],["の"],["こと"],["を"],["宣べ伝えた","のべつたえた"],["。"]]},{"verse":36,"text":"道,みちを進,すすんで行,いくうちに、水,みずのある所,ところにきたので、宦官,かんがんが言,いった、「ここに水,みずがあります。わたしがバプテスマを受,うけるのに、なんのさしつかえがありますか」。〔","tok":[["道","みち"],["を"],["進んで","すすんで"],["行く","いく"],["うち"],["に"],["、"],["水","みず"],["の"],["ある"],["所","ところ"],["に"],["きた"],["ので"],["、"],["宦官","かんがん"],["が"],["言った","いった"],["、"],["「"],["ここ"],["に"],["水","みず"],["が"],["あります"],["。"],["わたし"],["が"],["バプテスマ"],["を"],["受る","うける"],["のに"],["、"],["なん"],["の"],["さしつかえ"],["が"],["あります"],["か"],["」"],["。"],["〔"]]},{"verse":37,"text":"これに対,たいして、ピリポは、「あなたがまごころから信,しんじるなら、受,うけてさしつかえはありません」と言,いった。すると、彼,かれは「わたしは、イエス・キリストを神,かみの子,こと信,しんじます」と答,こたえた。〕","tok":[["これ"],["に対して","にたいして"],["、"],["ピリポ"],["は"],["、"],["「"],["あなた"],["が"],["まごころ"],["から"],["信じるなら","しんじるなら"],["、"],["受て","うけて"],["さしつかえ"],["は"],["ありません"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["「"],["わたし"],["は"],["、"],["イエス"],["・"],["キリスト"],["を"],["神","かみ"],["の"],["子","こ"],["と"],["信じます","しんじます"],["」"],["と"],["答","こたえ"],["た"],["。"],["〕"]]},{"verse":38,"text":"そこで車,くるまをとめさせ、ピリポと宦官,かんがんと、ふたりとも、水,みずの中,なかに降,おりて行,いき、ピリポが宦官,かんがんにバプテスマを授,さづけた。","tok":[["そこ"],["で"],["車","くるま"],["を"],["とめさせ"],["、"],["ピリポ"],["と"],["宦官","かんがん"],["と"],["、"],["ふたり"],["とも"],["、"],["水","みず"],["の"],["中","なか"],["に"],["降りて","おりて"],["行き","いき"],["、"],["ピリポ"],["が"],["宦官","かんがん"],["に"],["バプテスマ"],["を"],["授","さ"],["づけた"],["。"]]},{"verse":39,"text":"ふたりが水,みずから上,あがると、主,しゅの霊,れいがピリポをさらって行,いったので、宦官,かんがんはもう彼,かれを見,みることができなかった。宦官,かんがんはよろこびながら旅,たびをつづけた。","tok":[["ふたり"],["が"],["水","みず"],["から"],["上がる","あがる"],["と"],["、"],["主","しゅ"],["の"],["霊","れい"],["が"],["ピリポ"],["を"],["さらって"],["行った","いった"],["ので"],["、"],["宦官","かんがん"],["は"],["もう"],["彼","かれ"],["を"],["見る","みる"],["こと"],["が"],["できなかった"],["。"],["宦官","かんがん"],["は"],["よろこび"],["ながら"],["旅","たび"],["を"],["つづけた"],["。"]]},{"verse":40,"text":"その後,のち、ピリポはアゾトに姿,すがたをあらわして、町々,まちまちをめぐり歩,あるき、いたるところで福音,ふくいんを宣,のべ伝,つたえて、ついにカイザリヤに着,ついた。","tok":[["その後","そのの"],["ち"],["、"],["ピリポ"],["は"],["アゾト"],["に"],["姿","すがた"],["を"],["あらわして"],["、"],["町々","まちまち"],["を"],["めぐり歩き","めぐりあるき"],["、"],["いたる"],["ところ"],["で"],["福音","ふくいん"],["を"],["宣べ伝えて","のべつたえて"],["、"],["ついに"],["カイザリヤ"],["に"],["着いた","ついた"],["。"]]}]
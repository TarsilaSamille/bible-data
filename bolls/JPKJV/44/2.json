[{"verse":1,"text":"五旬節,ごじゅんせつの日,ひがきて、みんなの者,ものが一緒,いっしょに集,あつまっていると、","tok":[["五","ご"],["旬","しゅん"],["節","せつ"],["の"],["日","ひ"],["が"],["きて"],["、"],["みんな"],["の"],["者","もの"],["が"],["一緒","いっしょ"],["に"],["集まって","あつまって"],["いる"],["と"],["、"]]},{"verse":2,"text":"突然,とつぜん、激,はげしい風,かぜが吹,ふいてきたような音,おとが天,てんから起,おこってきて、一同,いちどうがすわっていた家,いえいっぱいに響,ひびきわたった。","tok":[["突然","とつぜん"],["、"],["激しい","はげしい"],["風","かぜ"],["が"],["吹いて","ふいて"],["きた"],["よう"],["な"],["音","おと"],["が"],["天","てん"],["から"],["起こって","おこって"],["きて"],["、"],["一同","いちどう"],["が"],["すわって"],["いた"],["家","いえ"],["いっぱい"],["に"],["響","ひびき"],["わたった"],["。"]]},{"verse":3,"text":"また、舌,したのようなものが、炎,ほのおのように分,わかれて現,あらわれ、ひとりびとりの上,うえにとどまった。","tok":[["また"],["、"],["舌","した"],["の"],["よう"],["な"],["もの"],["が"],["、"],["炎","ほのお"],["の"],["よう"],["に"],["分かれて","わかれて"],["現われ","あらわれ"],["、"],["ひとりびとり"],["の"],["上","うえ"],["に"],["とどまった"],["。"]]},{"verse":4,"text":"すると、一同,いちどうは聖霊,せいれいに満,みたされ、御霊,みたまが語,かたらせるままに、いろいろの他国,たこくの言葉,ことばで語,かたり出,だした。","tok":[["する"],["と"],["、"],["一同","いちどう"],["は"],["聖霊","せいれい"],["に"],["満たされ","みたされ"],["、"],["御霊","み"],["たま"],["が"],["語らせる","かたらせる"],["まま"],["に"],["、"],["いろいろ"],["の"],["他国","たこく"],["の"],["言葉","ことば"],["で"],["語り","かたり"],["出した","だした"],["。"]]},{"verse":5,"text":"さて、エルサレムには、天下,てんかのあらゆる国々,くにぐにから、信仰,しんこう深,ぶかいユダヤ人,じんたちがきて住,すんでいたが、","tok":[["さて"],["、"],["エルサレム"],["に"],["は"],["、"],["天下","てんか"],["の"],["あらゆる"],["国々","くにぐに"],["から"],["、"],["信仰","しんこう"],["深い","ぶかい"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["きて"],["住んで","すんで"],["いた"],["が"],["、"]]},{"verse":6,"text":"この物音,ものおとに大,おおぜいの人,ひとが集,あつまってきて、彼,かれらの生,うまれ故郷,こきょうの国語,こくごで、使徒,しとたちが話,はなしているのを、だれもかれも聞,きいてあっけに取,とられた。","tok":[["この"],["物音","ものおと"],["に"],["大ぜい","おおぜい"],["の"],["人","ひと"],["が"],["集まって","あつまって"],["きて"],["、"],["彼","かれ"],["ら"],["の"],["生まれ","うまれ"],["故郷","こきょう"],["の"],["国語","こくご"],["で"],["、"],["使徒","しと"],["たち"],["が"],["話","はなし"],["て"],["いる"],["の"],["を"],["、"],["だれ"],["も"],["かれ"],["も"],["聞いて","きいて"],["あっけ"],["に"],["取られた","とられた"],["。"]]},{"verse":7,"text":"そして驚,おどろき怪,あやしんで言,いった、「見,みよ、いま話,はなしているこの人,ひとたちは、皆,みなガリラヤ人,びとではないか。","tok":[["そして"],["驚","おどろき"],["怪しんで","あやしんで"],["言った","いった"],["、"],["「"],["見よ","みよ"],["、"],["いま"],["話","はなし"],["て"],["いる"],["この"],["人","ひと"],["たち"],["は"],["、"],["皆","みな"],["ガリラヤ"],["人","びと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":8,"text":"それだのに、わたしたちがそれぞれ、生,うまれ故郷,こきょうの国語,こくごを彼,かれらから聞,きかされるとは、いったい、どうしたことか。","tok":[["それ"],["だ"],["のに"],["、"],["わたしたち"],["が"],["それぞれ"],["、"],["生まれ","うまれ"],["故郷","こきょう"],["の"],["国語","こくご"],["を"],["彼","かれ"],["ら"],["から"],["聞かされる","きかされる"],["と"],["は"],["、"],["いったい"],["、"],["どう"],["した"],["こと"],["か"],["。"]]},{"verse":9,"text":"わたしたちの中,なかには、パルテヤ人,びと、メジヤ人,びと、エラム人,びともおれば、メソポタミヤ、ユダヤ、カパドキヤ、ポントとアジヤ、","tok":[["わたしたち"],["の"],["中","なか"],["に"],["は"],["、"],["パルテヤ"],["人","び"],["と"],["、"],["メジヤ人","めじやび"],["と"],["、"],["エラム人","えらむびと"],["も"],["おれば"],["、"],["メソポタミヤ"],["、"],["ユダヤ"],["、"],["カパドキヤ"],["、"],["ポント"],["と"],["アジヤ"],["、"]]},{"verse":10,"text":"フルギヤとパンフリヤ、エジプトとクレネに近,ちかいリビヤ地方,ちほうなどに住,すむ者,ものもいるし、またローマ人,じんで旅,たびにきている者,もの、","tok":[["フルギヤ"],["と"],["パンフリヤ"],["、"],["エジプト"],["と"],["クレネ"],["に"],["近い","ちかい"],["リビヤ"],["地方","ちほう"],["など"],["に"],["住む","すむ"],["者","もの"],["も"],["いる"],["し"],["、"],["また"],["ローマ人","ろーまじん"],["で"],["旅","たび"],["に"],["きて"],["いる"],["者","もの"],["、"]]},{"verse":11,"text":"ユダヤ人,じんと改宗者,かいしゅうしゃ、クレテ人,びととアラビヤ人,じんもいるのだが、あの人々,ひとびとがわたしたちの国語,こくごで、神,かみの大,おおきな働,はたらきを述,のべるのを聞,きくとは、どうしたことか」。","tok":[["ユダヤ人","ゆだやじん"],["と"],["改宗者","かいしゅうしゃ"],["、"],["クレテ人","くれてび"],["と"],["と"],["アラビヤ"],["人","じん"],["も"],["いる"],["の"],["だ"],["が"],["、"],["あの"],["人々","ひとびと"],["が"],["わたしたち"],["の"],["国語","こくご"],["で"],["、"],["神","かみ"],["の"],["大きな","おおきな"],["働らき","はたらき"],["を"],["述べる","のべる"],["の"],["を"],["聞く","きく"],["と"],["は"],["、"],["どう"],["した"],["こと"],["か"],["」"],["。"]]},{"verse":12,"text":"みんなの者,ものは驚,おどろき惑,まどって、互,たがいに言,いい合,あった、「これは、いったい、どういうわけなのだろう」。","tok":[["みんな"],["の"],["者","もの"],["は"],["驚","おどろき"],["惑って","まどって"],["、"],["互","たがい"],["に"],["言い合った","いいあった"],["、"],["「"],["これ"],["は"],["、"],["いったい"],["、"],["どういう"],["わけ"],["な"],["の"],["だろう"],["」"],["。"]]},{"verse":13,"text":"しかし、ほかの人,ひとたちはあざ笑,わらって、「あの人,ひとたちは新,あたらしい酒,さけで酔,よっているのだ」と言,いった。","tok":[["しかし"],["、"],["ほか"],["の"],["人","ひと"],["たち"],["は"],["あざ笑って","あざわらって"],["、"],["「"],["あの"],["人","ひと"],["たち"],["は"],["新らしい","あたらしい"],["酒","さけ"],["で"],["酔って","よって"],["いる"],["の"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":14,"text":"そこで、ペテロが十一人,にんの者,ものと共,ともに立,たちあがり、声,こえをあげて人々,ひとびとに語,かたりかけた。「ユダヤの人,ひとたち、ならびにエルサレムに住,すむすべてのかたがた、どうか、この事,ことを知,しっていただきたい。わたしの言,いうことに耳,みみを傾,かたむけていただきたい。","tok":[["そこ"],["で"],["、"],["ペテロ"],["が"],["十一人","にん"],["の"],["者","もの"],["と"],["共","とも"],["に"],["立ちあがり","たちあがり"],["、"],["声","こえ"],["を"],["あげて"],["人々","ひとびと"],["に"],["語りかけた","かたりかけた"],["。"],["「"],["ユダヤ"],["の"],["人","ひと"],["たち"],["、"],["ならびに"],["エルサレム"],["に"],["住む","すむ"],["すべて"],["の"],["かたがた"],["、"],["どう"],["か"],["、"],["この"],["事","こと"],["を"],["知って","しって"],["いただきたい"],["。"],["わたし"],["の"],["言う","いう"],["こと"],["に"],["耳","みみ"],["を"],["傾むけて","かたむけて"],["いただきたい"],["。"]]},{"verse":15,"text":"今,いまは朝,あさの九時,じであるから、この人,ひとたちは、あなたがたが思,おもっているように、酒,さけに酔,よっているのではない。","tok":[["今","いま"],["は"],["朝","あさ"],["の"],["九","きゅう"],["時","じ"],["ら"],["、"],["この"],["人","ひと"],["たち"],["は"],["、"],["あなた"],["がた"],["が"],["思って","おもって"],["いる"],["よう"],["に"],["、"],["酒","さけ"],["に"],["酔って","よって"],["いる"],["ので"],["は"],["ない"],["。"]]},{"verse":16,"text":"そうではなく、これは預言者,よげんしゃヨエルが預言,よげんしていたことに外,ほかならないのである。すなわち、","tok":[["そう"],["で"],["は"],["なく"],["、"],["これ"],["は"],["預言者","よげんしゃ"],["ヨエル"],["が"],["預言","よげん"],["して"],["いた"],["こと"],["に"],["外","ほかな"],["ら"],["ない"],["ので"],["ある"],["。"],["すなわち"],["、"]]},{"verse":17,"text":"『神,かみがこう仰,おおせになる。終,おわりの時,ときには、わたしの霊,れいをすべての人,ひとに注,そそごう。そして、あなたがたのむすこ娘,むすめは預言,よげんをし、若者,わかものたちは幻,まぼろしを見,み、老人,ろうじんたちは夢,ゆめを見,みるであろう。","tok":[["『"],["神","かみ"],["が"],["こう"],["仰せ","おおせ"],["に"],["なる"],["。"],["終","おわり"],["の"],["時","とき"],["に"],["は"],["、"],["わたし"],["の"],["霊","れい"],["を"],["すべて"],["の"],["人","ひと"],["に"],["注ごう","そそごう"],["。"],["そして"],["、"],["あなた"],["がた"],["の"],["むすこ"],["娘","むすめ"],["は"],["預言","よげん"],["を"],["し"],["、"],["若者","わかもの"],["たち"],["は"],["幻","まぼろし"],["を"],["見","み"],["、"],["老人","ろうじん"],["たち"],["は"],["夢","ゆめ"],["を"],["見るで","みるで"],["あろう"],["。"]]},{"verse":18,"text":"その時,ときには、わたしの男女,だんじょの僕,しもべたちにもわたしの霊,れいを注,そそごう。そして彼,かれらも預言,よげんをするであろう。","tok":[["その"],["時","とき"],["に"],["は"],["、"],["わたし"],["の"],["男女","だんじょ"],["の"],["僕","し"],["も"],["べ"],["たち"],["に"],["も"],["わたし"],["の"],["霊","れい"],["を"],["注ごう","そそごう"],["。"],["そして"],["彼","かれ"],["ら"],["も"],["預言","よげん"],["を"],["するで"],["あろう"],["。"]]},{"verse":19,"text":"また、上,うえでは、天,てんに奇跡,きせきを見,みせ、下,したでは、地,ちにしるしを、すなわち、血,ちと火,ひと立,たちこめる煙,けむりとを、見,みせるであろう。","tok":[["また"],["、"],["上","うえ"],["で"],["は"],["、"],["天","てん"],["に"],["奇跡","きせき"],["を"],["見せ","みせ"],["、"],["下","した"],["で"],["は"],["、"],["地","ち"],["に"],["しるし"],["を"],["、"],["すなわち"],["、"],["血","ち"],["と"],["火","ひ"],["と"],["立ちこめる","たちこめる"],["煙","けむり"],["と"],["を"],["、"],["見せるで","みせるで"],["あろう"],["。"]]},{"verse":20,"text":"主,しゅの大,おおいなる輝,かがやかしい日,ひが来,くる前,まえに、日,ひはやみに月,つきは血,ちに変,かわるであろう。","tok":[["主","しゅ"],["の"],["大いなる","おおいなる"],["輝やかしい","かがやかしい"],["日","ひ"],["が"],["来る","くる"],["前","まえ"],["に"],["、"],["日","ひ"],["は"],["やみ"],["に"],["月","つき"],["は"],["血","ち"],["に"],["変わるで","かわるで"],["あろう"],["。"]]},{"verse":21,"text":"そのとき、主,しゅの名,なを呼,よび求,もとめる者,ものは、みな救,すくわれるであろう』。","tok":[["その"],["とき"],["、"],["主","しゅ"],["の"],["名","な"],["を"],["呼び求める","よびもとめる"],["者","もの"],["は"],["、"],["みな"],["救われるで","すくわれるで"],["あろう"],["』"],["。"]]},{"verse":22,"text":"イスラエルの人,ひとたちよ、今,いまわたしの語,かたることを聞,ききなさい。あなたがたがよく知,しっているとおり、ナザレ人,びとイエスは、神,かみが彼,かれをとおして、あなたがたの中,なかで行,おこなわれた数々,かずかずの力,ちからあるわざと奇跡,きせきとしるしとにより、神,かみからつかわされた者,ものであることを、あなたがたに示,しめされたかたであった。","tok":[["イスラエル"],["の"],["人","ひと"],["たち"],["よ"],["、"],["今","いま"],["わたし"],["の"],["語る","かたる"],["こと"],["を"],["聞","きき"],["なさい"],["。"],["あなた"],["がた"],["が"],["よく"],["知って","しって"],["いる"],["とおり"],["、"],["ナザレ人","なざれび"],["と"],["イエス"],["は"],["、"],["神","かみ"],["が"],["彼","かれ"],["を"],["とおして"],["、"],["あなた"],["がた"],["の"],["中","なか"],["で"],["行なわれた","おこなわれた"],["数々","かずかず"],["の"],["力","ちから"],["ある"],["わざと"],["奇跡","きせき"],["と"],["しるし"],["と"],["に"],["より"],["、"],["神","かみ"],["から"],["つかわされた"],["者","もの"],["で"],["ある"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["示めされた","しめされた"],["かた"],["で"],["あった"],["。"]]},{"verse":23,"text":"このイエスが渡,わたされたのは神,かみの定,さだめた計画,けいかくと予知,よちとによるのであるが、あなたがたは彼,かれを不法,ふほうの人々,ひとびとの手,てで十字架,じゅうじかにつけて殺,ころした。","tok":[["この"],["イエス"],["が"],["渡された","わたされた"],["の"],["は"],["神","かみ"],["の"],["定めた","さだめた"],["計画","けいかく"],["と"],["予知","よち"],["と"],["に"],["よる"],["ので"],["ある"],["が"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["を"],["不法","ふほう"],["の"],["人々","ひとびと"],["の"],["手","て"],["で"],["十字架","じゅうじか"],["に"],["つけて"],["殺ろした","ころした"],["。"]]},{"verse":24,"text":"神,かみはこのイエスを死,しの苦,くるしみから解,とき放,はなって、よみがえらせたのである。イエスが死,しに支配,しはいされているはずはなかったからである。","tok":[["神","かみ"],["は"],["この"],["イエス"],["を"],["死","し"],["の"],["苦しみ","くるしみ"],["から"],["解き","とき"],["放","は"],["なって"],["、"],["よみがえらせた"],["ので"],["ある"],["。"],["イエス"],["が"],["死に","しに"],["支配","しはい"],["されて"],["いる"],["はず"],["は"],["なかった"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"ダビデはイエスについてこう言,いっている、『わたしは常,つねに目,めの前,まえに主,しゅを見,みた。主,しゅは、わたしが動,うごかされないため、わたしの右,みぎにいて下,くださるからである。","tok":[["ダビデ"],["は"],["イエス"],["について"],["こう"],["言って","いって"],["いる"],["、"],["『"],["わたし"],["は"],["常","つね"],["に"],["目","め"],["の"],["前","まえ"],["に"],["主","しゅ"],["を"],["見た","みた"],["。"],["主","しゅ"],["は"],["、"],["わたし"],["が"],["動かされない","うごかされない"],["ため"],["、"],["わたし"],["の"],["右","みぎ"],["に"],["いて"],["下さる","くださる"],["から"],["で"],["ある"],["。"]]},{"verse":26,"text":"それゆえ、わたしの心,こころは楽,たのしみ、わたしの舌,したはよろこび歌,うたった。わたしの肉体,にくたいもまた、望,のぞみに生,いきるであろう。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["の"],["心","こころ"],["は"],["楽み","たのしみ"],["、"],["わたし"],["の"],["舌","した"],["は"],["よろこび"],["歌った","うたった"],["。"],["わたし"],["の"],["肉体","にくたい"],["も"],["また"],["、"],["望み","のぞみ"],["に"],["生きるで","いきるで"],["あろう"],["。"]]},{"verse":27,"text":"あなたは、わたしの魂,たましいを黄泉,よみに捨,すておくことをせず、あなたの聖者,せいじゃが朽,くち果,はてるのを、お許,ゆるしにならないであろう。","tok":[["あなた"],["は"],["、"],["わたし"],["の"],["魂","たましい"],["を"],["黄泉","よみ"],["に"],["捨ておく","すておく"],["こと"],["を"],["せず"],["、"],["あなた"],["の"],["聖者","せいじゃ"],["が"],["朽ち","くち"],["果てる","はてる"],["の"],["を"],["、"],["お許し","おゆるし"],["に"],["ならないで"],["あろう"],["。"]]},{"verse":28,"text":"あなたは、いのちの道,みちをわたしに示,しめし、み前,まえにあって、わたしを喜,よろこびで満,みたして下,くださるであろう』。","tok":[["あなた"],["は"],["、"],["いのち"],["の"],["道","みち"],["を"],["わたし"],["に"],["示めし","しめし"],["、"],["み前","みまえ"],["に"],["あって"],["、"],["わたし"],["を"],["喜こび","よろこび"],["で"],["満たして","みたして"],["下さるで","くださるで"],["あろう"],["』"],["。"]]},{"verse":29,"text":"兄弟,きょうだいたちよ、族長,ぞくちょうダビデについては、わたしはあなたがたにむかって大胆,だいたんに言,いうことができる。彼,かれは死,しんで葬,ほうむられ、現,げんにその墓,はかが今日,きょうに至,いたるまで、わたしたちの間,あいだに残,のこっている。","tok":[["兄弟","きょうだい"],["たち"],["よ"],["、"],["族長","ぞくちょう"],["ダビデ"],["について"],["は"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["むかって"],["大胆","だいたん"],["に"],["言う","いう"],["こと"],["が"],["できる"],["。"],["彼","かれ"],["は"],["死んで","しんで"],["葬むられ","ほうむられ"],["、"],["現に","げんに"],["その"],["墓","はか"],["が"],["今日","きょう"],["に"],["至る","いたる"],["まで"],["、"],["わたしたち"],["の"],["間","あいだ"],["に"],["残って","のこって"],["いる"],["。"]]},{"verse":30,"text":"彼,かれは預言者,よげんしゃであって、『その子孫,しそんのひとりを王位,おういにつかせよう』と、神,かみが堅,かたく彼,かれに誓,ちかわれたことを認,みとめていたので、","tok":[["彼","かれ"],["は"],["預言者","よげんしゃ"],["で"],["あって"],["、"],["『"],["その"],["子孫","しそん"],["の"],["ひとり"],["を"],["王位","おうい"],["に"],["つかせよう"],["』"],["と"],["、"],["神","かみ"],["が"],["堅く","かたく"],["彼","かれ"],["に"],["誓われた","ちかわれた"],["こと"],["を"],["認めて","みとめて"],["いた"],["ので"],["、"]]},{"verse":31,"text":"キリストの復活,ふっかつをあらかじめ知,しって、『彼,かれは黄泉,よみに捨,すておかれることがなく、またその肉体,にくたいが朽,くち果,はてることもない』と語,かたったのである。","tok":[["キリスト"],["の"],["復活","ふっかつ"],["を"],["あらかじめ"],["知って","しって"],["、"],["『"],["彼","かれ"],["は"],["黄泉","よみ"],["に"],["捨ておかれる","すておかれる"],["こと"],["が"],["なく"],["、"],["また"],["その"],["肉体","にくたい"],["が"],["朽ち","くち"],["果てる","はてる"],["こと"],["も"],["ない"],["』"],["と"],["語った","かたった"],["ので"],["ある"],["。"]]},{"verse":32,"text":"このイエスを、神,かみはよみがえらせた。そして、わたしたちは皆,みなその証人,しょうにんなのである。","tok":[["この"],["イエス"],["を"],["、"],["神","かみ"],["は"],["よみがえらせた"],["。"],["そして"],["、"],["わたしたち"],["は"],["皆","みな"],["その"],["証人","しょうにん"],["な"],["ので"],["ある"],["。"]]},{"verse":33,"text":"それで、イエスは神,かみの右,みぎに上,あげられ、父,ちちから約束,やくそくの聖霊,せいれいを受,うけて、それをわたしたちに注,そそがれたのである。このことは、あなたがたが現,げんに見聞,みききしているとおりである。","tok":[["それ"],["で"],["、"],["イエス"],["は"],["神","かみ"],["の"],["右","みぎ"],["に"],["上げられ","あげられ"],["、"],["父","ちち"],["から"],["約束","やくそく"],["の"],["聖霊","せいれい"],["を"],["受て","うけて"],["、"],["それ"],["を"],["わたしたち"],["に"],["注がれた","そそがれた"],["ので"],["ある"],["。"],["この"],["こと"],["は"],["、"],["あなた"],["がた"],["が"],["現に","げんに"],["見聞き","みきき"],["して"],["いる"],["とおり"],["で"],["ある"],["。"]]},{"verse":34,"text":"ダビデが天,てんに上,のぼったのではない。彼,かれ自身,じしんこう言,いっている、『主,しゅはわが主,しゅに仰,おおせになった、","tok":[["ダビデ"],["が"],["天","てん"],["に"],["上った","のぼった"],["ので"],["は"],["ない"],["。"],["彼","かれ"],["自身","じしん"],["こう"],["言って","いって"],["いる"],["、"],["『"],["主","しゅ"],["は"],["わが"],["主に","しゅに"],["仰せ","おおせ"],["に"],["なった"],["、"]]},{"verse":35,"text":"あなたの敵,てきをあなたの足,あし台,だいにするまでは、わたしの右,みぎに座,ざしていなさい』。","tok":[["あなた"],["の"],["敵","てき"],["を"],["あなた"],["の"],["足台","あしだい"],["に"],["する"],["まで"],["は"],["、"],["わたし"],["の"],["右","みぎ"],["に"],["座して","ざして"],["い"],["なさい"],["』"],["。"]]},{"verse":36,"text":"だから、イスラエルの全,ぜん家,かは、この事,ことをしかと知,しっておくがよい。あなたがたが十字架,じゅうじかにつけたこのイエスを、神,かみは、主,しゅまたキリストとしてお立,たてになったのである」。","tok":[["だ"],["から"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","か"],["は"],["、"],["この"],["事","こと"],["を"],["しかと"],["知って","しって"],["おく"],["が"],["よい"],["。"],["あなた"],["がた"],["が"],["十字架","じゅうじか"],["に"],["つけた"],["この"],["イエス"],["を"],["、"],["神","かみ"],["は"],["、"],["主","しゅ"],["また"],["キリスト"],["として"],["お立","おたて"],["に"],["なった"],["ので"],["ある"],["」"],["。"]]},{"verse":37,"text":"人々,ひとびとはこれを聞,きいて、強,つよく心,こころを刺,さされ、ペテロやほかの使徒,しとたちに、「兄弟,きょうだいたちよ、わたしたちは、どうしたらよいのでしょうか」と言,いった。","tok":[["人々","ひとびと"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["強く","つよく"],["心","こころ"],["を"],["刺され","さされ"],["、"],["ペテロ"],["や"],["ほか"],["の"],["使徒","しと"],["たち"],["に"],["、"],["「"],["兄弟","きょうだい"],["たち"],["よ"],["、"],["わたしたち"],["は"],["、"],["どう"],["したら"],["よい"],["の"],["でしょう"],["か"],["」"],["と"],["言った","いった"],["。"]]},{"verse":38,"text":"すると、ペテロが答,こたえた、「悔,くい改,あらためなさい。そして、あなたがたひとりびとりが罪,つみのゆるしを得,えるために、イエス・キリストの名,なによって、バプテスマを受,うけなさい。そうすれば、あなたがたは聖霊,せいれいの賜物,たまものを受,うけるであろう。","tok":[["する"],["と"],["、"],["ペテロ"],["が"],["答","こたえ"],["た"],["、"],["「"],["悔い改め","くいあらため"],["なさい"],["。"],["そして"],["、"],["あなた"],["がた"],["ひとりびとり"],["が"],["罪","つみ"],["の"],["ゆるし"],["を"],["得る","える"],["ため"],["に"],["、"],["イエス"],["・"],["キリスト"],["の"],["名","な"],["によって"],["、"],["バプテスマ"],["を"],["受","うけ"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["がた"],["は"],["聖霊","せいれい"],["の"],["賜物","たまもの"],["を"],["受るで","うけるで"],["あろう"],["。"]]},{"verse":39,"text":"この約束,やくそくは、われらの主,しゅなる神,かみの召,めしにあずかるすべての者,もの、すなわちあなたがたと、あなたがたの子,こらと、遠,とおくの者,もの一同,いちどうとに、与,あたえられているものである」。","tok":[["この"],["約束","やくそく"],["は"],["、"],["われ"],["ら"],["の"],["主","しゅ"],["なる"],["神","かみ"],["の"],["召","めし"],["に"],["あずかる"],["すべて"],["の"],["者","もの"],["、"],["すなわち"],["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["子","こ"],["ら"],["と"],["、"],["遠く","とおく"],["の"],["者","もの"],["一同","いちどう"],["と"],["に"],["、"],["与えられて","あたえられて"],["いる"],["もの"],["で"],["ある"],["」"],["。"]]},{"verse":40,"text":"ペテロは、ほかになお多,おおくの言葉,ことばであかしをなし、人々,ひとびとに「この曲,まがった時代,じだいから救,すくわれよ」と言,いって勧,すすめた。","tok":[["ペテロ"],["は"],["、"],["ほか"],["に"],["なお"],["多く","おおく"],["の"],["言葉","ことば"],["で"],["あかし"],["を"],["なし"],["、"],["人々","ひとびと"],["に"],["「"],["この"],["曲がった","まがった"],["時代","じだい"],["から"],["救われよ","すくわれよ"],["」"],["と"],["言って","いって"],["勧めた","すすめた"],["。"]]},{"verse":41,"text":"そこで、彼,かれの勧,すすめの言葉,ことばを受,うけいれた者,ものたちは、バプテスマを受,うけたが、その日,ひ、仲間,なかまに加,くわわったものが三千人,にんほどあった。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["の"],["勧め","すすめ"],["の"],["言葉","ことば"],["を"],["受","うけ"],["いれた"],["者","もの"],["たち"],["は"],["、"],["バプテスマ"],["を"],["受た","うけた"],["が"],["、"],["その"],["日","ひ"],["、"],["仲間","なかま"],["に"],["加わわった","くわわった"],["もの"],["が"],["三千人","にん"],["ほど"],["あった"],["。"]]},{"verse":42,"text":"そして一同,いちどうはひたすら、使徒,しとたちの教,おしえを守,まもり、信徒,しんとの交,まじわりをなし、共,ともにパンをさき、祈,いのりをしていた。","tok":[["そして"],["一同","いちどう"],["は"],["ひたすら"],["、"],["使徒","しと"],["たち"],["の"],["教え","おしえ"],["を"],["守り","まもり"],["、"],["信徒","しんと"],["の"],["交じわり","まじわり"],["を"],["なし"],["、"],["共","とも"],["に"],["パン"],["を"],["さき"],["、"],["祈","いのり"],["を"],["して"],["いた"],["。"]]},{"verse":43,"text":"みんなの者,ものにおそれの念,ねんが生,しょうじ、多,おおくの奇跡,きせきとしるしとが、使徒,しとたちによって、次々,つぎつぎに行,おこなわれた。","tok":[["みんな"],["の"],["者","もの"],["に"],["おそれ"],["の"],["念","ねん"],["が"],["生じ","しょうじ"],["、"],["多く","おおく"],["の"],["奇跡","きせき"],["と"],["しるし"],["と"],["が"],["、"],["使徒","しと"],["たち"],["によって"],["、"],["次々","つぎつぎ"],["に"],["行なわれた","おこなわれた"],["。"]]},{"verse":44,"text":"信者,しんじゃたちはみな一緒,いっしょにいて、いっさいの物,ものを共有,きょうゆうにし、","tok":[["信者","しんじゃ"],["たち"],["は"],["みな"],["一緒","いっしょ"],["に"],["いて"],["、"],["いっさい"],["の"],["物","もの"],["を"],["共有","きょうゆう"],["に"],["し"],["、"]]},{"verse":45,"text":"資産,しさんや持,もち物,ものを売,うっては、必要,ひつように応,おうじてみんなの者,ものに分,わけ与,あたえた。","tok":[["資産","しさん"],["や"],["持物","もちもの"],["を"],["売って","うって"],["は"],["、"],["必要","ひつよう"],["に"],["応じて","おうじて"],["みんな"],["の"],["者","もの"],["に"],["分け","わけ"],["与","あたえ"],["た"],["。"]]},{"verse":46,"text":"そして日々,ひび心,こころを一つにして、絶,たえず宮,みやもうでをなし、家,いえではパンをさき、よろこびと、まごころとをもって、食事,しょくじを共,ともにし、","tok":[["そして"],["日々","ひび"],["心","こころ"],["を"],["一","ひと"],["つ"],["に"],["して"],["、"],["絶えず","たえず"],["宮","みや"],["も"],["うで"],["を"],["なし"],["、"],["家","いえ"],["で"],["は"],["パン"],["を"],["さき"],["、"],["よろこび"],["と"],["、"],["まごころ"],["と"],["を"],["もって"],["、"],["食事","しょくじ"],["を"],["共","とも"],["に"],["し"],["、"]]},{"verse":47,"text":"神,かみをさんびし、すべての人,ひとに好意,こういを持,もたれていた。そして主,しゅは、救,すくわれる者,ものを日々,ひび仲間,なかまに加,くわえて下,くださったのである。","tok":[["神","かみ"],["を"],["さん"],["びし"],["、"],["すべて"],["の"],["人","ひと"],["に"],["好意","こうい"],["を"],["持たれて","もたれて"],["いた"],["。"],["そして"],["主","しゅ"],["は"],["、"],["救われる","すくわれる"],["者","もの"],["を"],["日々","ひび"],["仲間","なかま"],["に"],["加えて","くわえて"],["下さった","くださった"],["ので"],["ある"],["。"]]}]
[{"verse":1,"text":"さて、フェストは、任地,にんちに着,ついてから三日,かの後,のち、カイザリヤからエルサレムに上,のぼったところ、","tok":[["さて"],["、"],["フェスト"],["は"],["、"],["任地","にんち"],["に"],["着いて","ついて"],["から"],["三日","か"],["の"],["後","の"],["ち"],["、"],["カイザリヤ"],["から"],["エルサレム"],["に"],["上った","のぼった"],["ところ"],["、"]]},{"verse":2,"text":"祭司長,さいしちょうたちやユダヤ人,じんの重立,おもだった者,ものたちが、パウロを訴,うったえ出,でて、","tok":[["祭司長","さいしちょう"],["たち"],["や"],["ユダヤ人","ゆだやじん"],["の"],["重立った","おもだった"],["者","もの"],["たち"],["が"],["、"],["パウロ"],["を"],["訴","うったえ"],["出て","でて"],["、"]]},{"verse":3,"text":"彼,かれをエルサレムに呼,よび出,だすよう取,とり計,はからっていただきたいと、しきりに願,ねがった。彼,かれらは途中,とちゅうで待,まち伏,ぶせして、彼,かれを殺,ころす考,かんがえであった。","tok":[["彼","かれ"],["を"],["エルサレム"],["に"],["呼び出す","よびだす"],["よう"],["取計らって","とりはからって"],["いただきたい"],["と"],["、"],["しきり"],["に"],["願った","ねがった"],["。"],["彼","かれ"],["ら"],["は"],["途中","とちゅう"],["で"],["待伏せ","まちぶせ"],["して"],["、"],["彼","かれ"],["を"],["殺ろす","ころす"],["考","かんがえ"],["で"],["あった"],["。"]]},{"verse":4,"text":"ところがフェストは、パウロがカイザリヤに監禁,かんきんしてあり、自分,じぶんもすぐそこへ帰,かえることになっていると答,こたえ、","tok":[["ところ"],["が"],["フェスト"],["は"],["、"],["パウロ"],["が"],["カイザリヤ"],["に"],["監禁","かんきん"],["して"],["あり"],["、"],["自分","じぶん"],["も"],["すぐ"],["そこ"],["へ"],["帰える","かえる"],["こと"],["に"],["なって"],["いる"],["と"],["答","こたえ"],["、"]]},{"verse":5,"text":"そして言,いった、「では、もしあの男,おとこに何,なにか不都合,ふつごうなことがあるなら、おまえたちのうちの有力,ゆうりょく者,しゃらが、わたしと一緒,いっしょに下,くだって行,いって、訴,うったえるがよかろう」。","tok":[["そして"],["言った","いった"],["、"],["「"],["で"],["は"],["、"],["もし"],["あの"],["男","おとこ"],["に"],["何に","なに"],["か"],["不都合","ふつごう"],["な"],["こと"],["が"],["あるなら"],["、"],["おまえ"],["たち"],["の"],["うち"],["の"],["有力","ゆうりょく"],["者","しゃ"],["ら"],["が"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["下って","くだって"],["行って","いって"],["、"],["訴る","うったえる"],["が"],["よかろう"],["」"],["。"]]},{"verse":6,"text":"フェストは、彼,かれらのあいだに八日,かか十日,かほど滞在,たいざいした後,のち、カイザリヤに下,くだって行,いき、その翌日,よくじつ、裁判,さいばんの席,せきについて、パウロを引,ひき出,だすように命,めいじた。","tok":[["フェスト"],["は"],["、"],["彼","かれ"],["ら"],["の"],["あいだ"],["に"],["八日","か"],["か"],["十日","か"],["ほど"],["滞在","たいざい"],["した"],["後","の"],["ち"],["、"],["カイザリヤ"],["に"],["下って","くだって"],["行き","いき"],["、"],["その"],["翌日","よくじつ"],["、"],["裁判","さいばん"],["の"],["席","せき"],["について"],["、"],["パウロ"],["を"],["引出す","ひきだす"],["よう"],["に"],["命じた","めいじた"],["。"]]},{"verse":7,"text":"パウロが姿,すがたをあらわすと、エルサレムから下,くだってきたユダヤ人,じんたちが、彼,かれを取,とりかこみ、彼,かれに対,たいしてさまざまの重,おもい罪状,ざいじょうを申,もうし立,たてたが、いずれもその証拠,しょうこをあげることはできなかった。","tok":[["パウロ"],["が"],["姿","すがた"],["を"],["あらわす"],["と"],["、"],["エルサレム"],["から"],["下って","くだって"],["きた"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["、"],["彼","かれ"],["を"],["取","とり"],["かこみ"],["、"],["彼","かれ"],["に対して","にたいして"],["さまざま"],["の"],["重い","おもい"],["罪状","ざいじょう"],["を"],["申し立てた","もうしたてた"],["が"],["、"],["いずれ"],["も"],["その"],["証拠","しょうこ"],["を"],["あげる"],["こと"],["は"],["できなかった"],["。"]]},{"verse":8,"text":"パウロは「わたしは、ユダヤ人,じんの律法,りっぽうに対,たいしても、宮,みやに対,たいしても、またカイザルに対,たいしても、なんら罪,つみを犯,おかしたことはない」と弁明,べんめいした。","tok":[["パウロ"],["は"],["「"],["わたし"],["は"],["、"],["ユダヤ人","ゆだやじん"],["の"],["律法","りっぽう"],["に対して","にたいして"],["も"],["、"],["宮","みや"],["に対して","にたいして"],["も"],["、"],["また"],["カイザル"],["に対して","にたいして"],["も"],["、"],["なん"],["ら"],["罪","つみ"],["を"],["犯した","おかした"],["こと"],["は"],["ない"],["」"],["と"],["弁明","べんめい"],["した"],["。"]]},{"verse":9,"text":"ところが、フェストはユダヤ人,じんの歓心,かんしんを買,かおうと思,おもって、パウロにむかって言,いった、「おまえはエルサレムに上,のぼり、この事件,じけんに関,かんし、わたしからそこで裁判,さいばんを受,うけることを承知,しょうちするか」。","tok":[["ところ"],["が"],["、"],["フェスト"],["は"],["ユダヤ人","ゆだやじん"],["の"],["歓心","かんしん"],["を"],["買おう","かおう"],["と"],["思って","おもって"],["、"],["パウロ"],["に"],["むかって"],["言った","いった"],["、"],["「"],["おまえ"],["は"],["エルサレム"],["に"],["上り","のぼり"],["、"],["この"],["事件","じけん"],["に"],["関し","かんし"],["、"],["わたし"],["から"],["そこ"],["で"],["裁判","さいばん"],["を"],["受る","うける"],["こと"],["を"],["承知","しょうち"],["する"],["か"],["」"],["。"]]},{"verse":10,"text":"パウロは言,いった、「わたしは今,いま、カイザルの法廷,ほうていに立,たっています。わたしはこの法廷,ほうていで裁判,さいばんされるべきです。よくご承知,しょうちのとおり、わたしはユダヤ人,じんたちに、何,なにも悪,わるいことをしてはいません。","tok":[["パウロ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["今","いま"],["、"],["カイザル"],["の"],["法廷","ほうてい"],["に"],["立って","たって"],["います"],["。"],["わたし"],["は"],["この"],["法廷","ほうてい"],["で"],["裁判","さいばん"],["されるべきです"],["。"],["よく"],["ご承知","ごしょうち"],["の"],["とおり"],["、"],["わたし"],["は"],["ユダヤ人","ゆだやじん"],["たち"],["に"],["、"],["何に","なに"],["も"],["悪い","わるい"],["こと"],["を"],["して"],["は"],["いません"],["。"]]},{"verse":11,"text":"もしわたしが悪,わるいことをし、死,しに当,あたるようなことをしているのなら、死,しを免,まぬかれようとはしません。しかし、もし彼,かれらの訴,うったえることに、なんの根拠,こんきょもないとすれば、だれもわたしを彼,かれらに引,ひき渡,わたす権利,けんりはありません。わたしはカイザルに上訴,じょうそします」。","tok":[["もし"],["わたし"],["が"],["悪い","わるい"],["こと"],["を"],["し"],["、"],["死","し"],["に"],["当たる","あたる"],["よう"],["な"],["こと"],["を"],["して"],["いる"],["の"],["なら"],["、"],["死","し"],["を"],["免かれよう","まぬかれよう"],["と"],["は"],["しません"],["。"],["しかし"],["、"],["もし"],["彼","かれ"],["ら"],["の"],["訴る","うったえる"],["こと"],["に"],["、"],["なん"],["の"],["根拠","こんきょ"],["も"],["ない"],["と"],["すれば"],["、"],["だれ"],["も"],["わたし"],["を"],["彼","かれ"],["ら"],["に"],["引渡す","ひきわたす"],["権利","けんり"],["は"],["ありません"],["。"],["わたし"],["は"],["カイザル"],["に"],["上訴","じょうそ"],["します"],["」"],["。"]]},{"verse":12,"text":"そこでフェストは、陪席,ばいせきの者,ものたちと協議,きょうぎしたうえ答,こたえた、「おまえはカイザルに上訴,じょうそを申,もうし出,でた。カイザルのところに行,いくがよい」。","tok":[["そこ"],["で"],["フェスト"],["は"],["、"],["陪席","ばいせき"],["の"],["者","もの"],["たち"],["と"],["協議","きょうぎ"],["した"],["うえ"],["答","こたえ"],["た"],["、"],["「"],["おまえ"],["は"],["カイザル"],["に"],["上訴","じょうそ"],["を"],["申し出た","もうしでた"],["。"],["カイザル"],["の"],["ところ"],["に"],["行く","いく"],["が"],["よい"],["」"],["。"]]},{"verse":13,"text":"数日,すうじつたった後,のち、アグリッパ王,おうとベルニケとが、フェストに敬意,けいいを表,ひょうするため、カイザリヤにきた。","tok":[["数日","すうじつ"],["たった"],["後","の"],["ち"],["、"],["アグリッパ"],["王","おう"],["と"],["ベルニケ"],["と"],["が"],["、"],["フェスト"],["に"],["敬意","けいい"],["を"],["表する","ひょうする"],["ため"],["、"],["カイザリヤ"],["に"],["きた"],["。"]]},{"verse":14,"text":"ふたりは、そこに何,なに日間,にちかんも滞在,たいざいしていたので、フェストは、パウロのことを王,おうに話,はなして言,いった、「ここに、ペリクスが囚人,しゅうじんとして残,のこして行,いったひとりの男,おとこがいる。","tok":[["ふたり"],["は"],["、"],["そこ"],["に"],["何","な"],["に"],["日間","にちかん"],["も"],["滞在","たいざい"],["して"],["いた"],["ので"],["、"],["フェスト"],["は"],["、"],["パウロ"],["の"],["こと"],["を"],["王","おう"],["に"],["話","はなし"],["て"],["言った","いった"],["、"],["「"],["ここ"],["に"],["、"],["ペリクス"],["が"],["囚人","しゅうじん"],["として"],["残して","のこして"],["行った","いった"],["ひとり"],["の"],["男","おとこ"],["が"],["いる"],["。"]]},{"verse":15,"text":"わたしがエルサレムに行,いった時,とき、この男,おとこのことを、祭司長,さいしちょうたちやユダヤ人,じんの長老,ちょうろうたちが、わたしに報告,ほうこくし、彼,かれを罪,つみに定,さだめるようにと要求,ようきゅうした。","tok":[["わたし"],["が"],["エルサレム"],["に"],["行った","いった"],["時","とき"],["、"],["この"],["男","おとこ"],["の"],["こと"],["を"],["、"],["祭司長","さいしちょう"],["たち"],["や"],["ユダヤ人","ゆだやじん"],["の"],["長老","ちょうろう"],["たち"],["が"],["、"],["わたし"],["に"],["報告","ほうこく"],["し"],["、"],["彼","かれ"],["を"],["罪","つみ"],["に"],["定める","さだめる"],["よう"],["に"],["と"],["要求","ようきゅう"],["した"],["。"]]},{"verse":16,"text":"そこでわたしは、彼,かれらに答,こたえた、『訴,うったえられた者,ものが、訴,うったえた者,ものの前,まえに立,たって、告訴,こくそに対,たいし弁明,べんめいする機会,きかいを与,あたえられない前,まえに、その人,ひとを見放,みはなしてしまうのは、ローマ人,じんの慣例,かんれいにはないことである』。","tok":[["そこ"],["で"],["わたし"],["は"],["、"],["彼","かれ"],["ら"],["に"],["答","こたえ"],["た"],["、"],["『"],["訴られた","うったえられた"],["者","もの"],["が"],["、"],["訴た","うったえた"],["者","もの"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["告訴","こくそ"],["に"],["対し","たいし"],["弁明","べんめい"],["する"],["機会","きかい"],["を"],["与えられない","あたえられない"],["前","まえ"],["に"],["、"],["その"],["人","ひと"],["を"],["見放して","みはなして"],["しまう"],["の"],["は"],["、"],["ローマ人","ろーまじん"],["の"],["慣例","かんれい"],["に"],["は"],["ない"],["こと"],["で"],["ある"],["』"],["。"]]},{"verse":17,"text":"それで、彼,かれらがここに集,あつまってきた時,とき、わたしは時,ときをうつさず、次,つぎの日,ひに裁判,さいばんの席,せきについて、その男,おとこを引,ひき出,ださせた。","tok":[["それ"],["で"],["、"],["彼","かれ"],["ら"],["が"],["ここ"],["に"],["集まって","あつまって"],["きた"],["時","とき"],["、"],["わたし"],["は"],["時","とき"],["を"],["うつさず"],["、"],["次","つぎ"],["の"],["日","ひ"],["に"],["裁判","さいばん"],["の"],["席","せき"],["について"],["、"],["その"],["男","おとこ"],["を"],["引出させた","ひきださせた"],["。"]]},{"verse":18,"text":"訴,うったえた者,ものたちは立,たち上,あがったが、わたしが推測,すいそくしていたような悪事,あくじは、彼,かれについて何一,なにひとつ申,もうし立,たてはしなかった。","tok":[["訴た","うったえた"],["者","もの"],["たち"],["は"],["立ち上がった","たちあがった"],["が"],["、"],["わたし"],["が"],["推測","すいそく"],["して"],["いた"],["よう"],["な"],["悪事","あくじ"],["は"],["、"],["彼","かれ"],["について"],["何","なん"],["一","いち"],["に"],["ひと"],["つ"],["申し","もうし"],["立","たて"],["は"],["しなかった"],["。"]]},{"verse":19,"text":"ただ、彼,かれと争,あらそい合,あっているのは、彼,かれら自身,じしんの宗教,しゅうきょうに関,かんし、また、死,しんでしまったのに生,いきているとパウロが主張,しゅちょうしているイエスなる者,ものに関,かんする問題,もんだいに過,すぎない。","tok":[["ただ"],["、"],["彼","かれ"],["と"],["争い合って","あらそいあって"],["いる"],["の"],["は"],["、"],["彼","かれ"],["ら"],["自身","じしん"],["の"],["宗教","しゅうきょう"],["に"],["関し","かんし"],["、"],["また"],["、"],["死んで","しんで"],["しまった"],["のに"],["生きて","いきて"],["いる"],["と"],["パウロ"],["が"],["主張","しゅちょう"],["して"],["いる"],["イエス"],["なる"],["者","もの"],["に"],["関する","かんする"],["問題","もんだい"],["に"],["過ない","すぎない"],["。"]]},{"verse":20,"text":"これらの問題,もんだいを、どう取,とり扱,あつかってよいかわからなかったので、わたしは彼,かれに、『エルサレムに行,いって、これらの問題,もんだいについて、そこでさばいてもらいたくはないか』と尋,たずねてみた。","tok":[["これ"],["ら"],["の"],["問題","もんだい"],["を"],["、"],["どう"],["取扱って","とりあつかって"],["よい"],["か"],["わからなかった"],["ので"],["、"],["わたし"],["は"],["彼","かれ"],["に"],["、"],["『"],["エルサレム"],["に"],["行って","いって"],["、"],["これ"],["ら"],["の"],["問題","もんだい"],["について"],["、"],["そこ"],["で"],["さばいて"],["もらいたく"],["は"],["ない"],["か"],["』"],["と"],["尋ねて","たずねて"],["みた"],["。"]]},{"verse":21,"text":"ところがパウロは、皇帝,こうていの判決,はんけつを受,うける時,ときまで、このまま自分,じぶんをとどめておいてほしいと言,いうので、カイザルに彼,かれを送,おくりとどける時,ときまでとどめておくようにと、命,めいじておいた」。","tok":[["ところ"],["が"],["パウロ"],["は"],["、"],["皇帝","こうてい"],["の"],["判決","はんけつ"],["を"],["受る","うける"],["時","とき"],["まで"],["、"],["この"],["まま"],["自分","じぶん"],["を"],["とどめて"],["おいて"],["ほしい"],["と"],["言う","いう"],["ので"],["、"],["カイザル"],["に"],["彼","かれ"],["を"],["送りとどける","おくりとどける"],["時","とき"],["まで"],["とどめて"],["おく"],["よう"],["に"],["と"],["、"],["命じて","めいじて"],["おいた"],["」"],["。"]]},{"verse":22,"text":"そこで、アグリッパがフェストに「わたしも、その人,ひとの言,いい分,ぶんを聞,きいて見,みたい」と言,いったので、フェストは、「では、あす彼,かれから聞,ききとるようにしてあげよう」と答,こたえた。","tok":[["そこ"],["で"],["、"],["アグリッパ"],["が"],["フェスト"],["に"],["「"],["わたし"],["も"],["、"],["その"],["人","ひと"],["の"],["言い分","いいぶん"],["を"],["聞いて","きいて"],["見たい","みたい"],["」"],["と"],["言った","いった"],["ので"],["、"],["フェスト"],["は"],["、"],["「"],["で"],["は"],["、"],["あす"],["彼","かれ"],["から"],["聞","きき"],["とる"],["よう"],["に"],["して"],["あげよう"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":23,"text":"翌日,よくじつ、アグリッパとベルニケとは、大,おおいに威儀,いぎをととのえて、千卒長,せんそつちょうたちや市,しの重立,おもだった人,ひとたちと共,ともに、引見所,いんけんじょにはいってきた。すると、フェストの命,めいによって、パウロがそこに引,ひき出,だされた。","tok":[["翌日","よくじつ"],["、"],["アグリッパ"],["と"],["ベルニケ"],["と"],["は"],["、"],["大いに","おおいに"],["威儀","いぎ"],["を"],["ととのえて"],["、"],["千卒長","せんそつちょう"],["たち"],["や"],["市","し"],["の"],["重立った","おもだった"],["人","ひと"],["たち"],["と"],["共","とも"],["に"],["、"],["引見所","いんけんじょ"],["に"],["はいって"],["きた"],["。"],["する"],["と"],["、"],["フェスト"],["の"],["命","めい"],["によって"],["、"],["パウロ"],["が"],["そこ"],["に"],["引出された","ひきだされた"],["。"]]},{"verse":24,"text":"そこで、フェストが言,いった、「アグリッパ王,おう、ならびにご臨席,りんせきの諸君,しょくん。ごらんになっているこの人物,じんぶつは、ユダヤ人,じんたちがこぞって、エルサレムにおいても、また、この地,ちにおいても、これ以上,いじょう、生,いかしておくべきでないと叫,さけんで、わたしに訴,うったえ出,でている者,ものである。","tok":[["そこ"],["で"],["、"],["フェスト"],["が"],["言った","いった"],["、"],["「"],["アグリッパ"],["王","おう"],["、"],["ならび"],["に"],["ご臨席","ごりんせき"],["の"],["諸君","しょくん"],["。"],["ごらん"],["に"],["なって"],["いる"],["この"],["人物","じんぶつ"],["は"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["こぞって"],["、"],["エルサレム"],["に"],["おいて"],["も"],["、"],["また"],["、"],["この"],["地","ち"],["に"],["おいて"],["も"],["、"],["これ"],["以上","いじょう"],["、"],["生かして","いかして"],["おくべきで"],["ない"],["と"],["叫けんで","さけんで"],["、"],["わたし"],["に"],["訴","うったえ"],["出て","でて"],["いる"],["者","もの"],["で"],["ある"],["。"]]},{"verse":25,"text":"しかし、彼,かれは死,しに当,あたることは何,なにもしていないと、わたしは見,みているのだが、彼,かれ自身,じしんが皇帝,こうていに上訴,じょうそすると言,いい出,だしたので、彼,かれをそちらへ送,おくることに決,きめた。","tok":[["しかし"],["、"],["彼","かれ"],["は"],["死","し"],["に"],["当たる","あたる"],["こと"],["は"],["何に","なに"],["も"],["して"],["いない"],["と"],["、"],["わたし"],["は"],["見て","みて"],["いる"],["の"],["だ"],["が"],["、"],["彼","かれ"],["自身","じしん"],["が"],["皇帝","こうてい"],["に"],["上訴","じょうそ"],["する"],["と"],["言い","いい"],["出した","だした"],["ので"],["、"],["彼","かれ"],["を"],["そちら"],["へ"],["送る","おくる"],["こと"],["に"],["決めた","きめた"],["。"]]},{"verse":26,"text":"ところが、彼,かれについて、主君,しゅくんに書,かきおくる確,たしかなものが何,なにもないので、わたしは、彼,かれを諸君,しょくんの前,まえに、特,とくに、アグリッパ王,おうよ、あなたの前,まえに引,ひき出,だして、取調,とりしらべをしたのち、上書,じょうしょすべき材料,ざいりょうを得,えようと思,おもう。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["について"],["、"],["主君","しゅくん"],["に"],["書きおくる","かきおくる"],["確か","たしか"],["な"],["もの"],["が"],["何に","なに"],["も"],["ない"],["ので"],["、"],["わたし"],["は"],["、"],["彼","かれ"],["を"],["諸君","しょくん"],["の"],["前","まえ"],["に"],["、"],["特に","とくに"],["、"],["アグリッパ"],["王","おう"],["よ"],["、"],["あなた"],["の"],["前","まえ"],["に"],["引出して","ひきだして"],["、"],["取調","とりしらべ"],["を"],["した"],["のち"],["、"],["上書","じょうしょ"],["すべき"],["材料","ざいりょう"],["を"],["得よう","えよう"],["と"],["思う","おもう"],["。"]]},{"verse":27,"text":"囚人,しゅうじんを送,おくるのに、その告訴,こくその理由,りゆうを示,しめさないということは、不合理,ふごうりだと思,おもえるからである」。","tok":[["囚人","しゅうじん"],["を"],["送る","おくる"],["のに"],["、"],["その"],["告訴","こくそ"],["の"],["理由","りゆう"],["を"],["示めさない","しめさない"],["と"],["いう"],["こと"],["は"],["、"],["不合理","ふごうり"],["だ"],["と"],["思る","おもえる"],["から"],["で"],["ある"],["」"],["。"]]}]
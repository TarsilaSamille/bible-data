[{"verse":1,"text":"さて、わたしたちは人々,ひとびとと別,わかれて船出,ふなでしてから、コスに直航,ちょっこうし、次,つぎの日,ひはロドスに、そこからパタラに着,ついた。","tok":[["さて"],["、"],["わたしたち"],["は"],["人々","ひとびと"],["と"],["別かれて","わかれて"],["船出","ふなで"],["して"],["から"],["、"],["コス"],["に"],["直航","ちょっこう"],["し"],["、"],["次","つぎ"],["の"],["日","ひ"],["は"],["ロドス"],["に"],["、"],["そこ"],["から"],["パタラ"],["に"],["着いた","ついた"],["。"]]},{"verse":2,"text":"ここでピニケ行,いきの舟,ふねを見,みつけたので、それに乗,のり込,こんで出帆,しゅっぱんした。","tok":[["ここ"],["で"],["ピニケ"],["行き","いき"],["の"],["舟","ふね"],["を"],["見つけた","みつけた"],["ので"],["、"],["それ"],["に"],["乗込んで","のりこんで"],["出帆","しゅっぱん"],["した"],["。"]]},{"verse":3,"text":"やがてクプロが見,みえてきたが、それを左手,ひだりてにして通,とおりすぎ、シリヤへ航行,こうこうをつづけ、ツロに入港,にゅうこうした。ここで積荷,つみにが陸上,りくあげされることになっていたからである。","tok":[["やがて"],["クプロ"],["が"],["見えて","みえて"],["きた"],["が"],["、"],["それ"],["を"],["左手","ひだりて"],["に"],["して"],["通","とおり"],["すぎ"],["、"],["シリヤ"],["へ"],["航行","こうこう"],["を"],["つづけ"],["、"],["ツロ"],["に"],["入港","にゅうこう"],["した"],["。"],["ここ"],["で"],["積荷","つみに"],["が"],["陸上げ","りくあげ"],["される"],["こと"],["に"],["なって"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":4,"text":"わたしたちは、弟子,でしたちを捜,さがし出,だして、そこに七日間,なぬかかん泊,とまった。ところが彼,かれらは、御霊,みたまの示,しめしを受,うけて、エルサレムには上,のぼって行,いかないようにと、しきりにパウロに注意,ちゅういした。","tok":[["わたしたち"],["は"],["、"],["弟子","でし"],["たち"],["を"],["捜し出して","さがしだして"],["、"],["そこ"],["に"],["七","なな"],["日間","かかん"],["ぬか"],["かん"],["泊まった","とまった"],["。"],["ところ"],["が"],["彼","かれ"],["ら"],["は"],["、"],["御霊","みたま"],["の"],["示めし","しめし"],["を"],["受て","うけて"],["、"],["エルサレム"],["に"],["は"],["上って","のぼって"],["行かない","いかない"],["よう"],["に"],["と"],["、"],["しきり"],["に"],["パウロ"],["に"],["注意","ちゅうい"],["した"],["。"]]},{"verse":5,"text":"しかし、滞在,たいざい期間,きかんが終,おわった時,とき、わたしたちはまた旅立,たびだつことにしたので、みんなの者,ものは、妻,つまや子供,こどもを引,ひき連,つれて、町,まちはずれまで、わたしたちを見送,みおくりにきてくれた。そこで、共,ともに海岸,かいがんにひざまずいて祈,いのり、","tok":[["しかし"],["、"],["滞在","たいざい"],["期間","きかん"],["が"],["終わった","おわった"],["時","とき"],["、"],["わたしたち"],["は"],["また"],["旅立つ","たびだつ"],["こと"],["に"],["した"],["ので"],["、"],["みんな"],["の"],["者","もの"],["は"],["、"],["妻","つま"],["や"],["子供","こども"],["を"],["引連れて","ひきつれて"],["、"],["町はずれ","まちはずれ"],["まで"],["、"],["わたしたち"],["を"],["見送り","みおくり"],["に"],["きて"],["くれた"],["。"],["そこ"],["で"],["、"],["共","とも"],["に"],["海岸","かいがん"],["に"],["ひざまずいて"],["祈","いのり"],["、"]]},{"verse":6,"text":"互,たがいに別,わかれを告,つげた。それから、わたしたちは舟,ふねに乗,のり込,こみ、彼,かれらはそれぞれ自分,じぶんの家,いえに帰,かえった。","tok":[["互","たがい"],["に"],["別れ","わかれ"],["を"],["告","つげ"],["た"],["。"],["それ"],["から"],["、"],["わたしたち"],["は"],["舟","ふね"],["に"],["乗込","のりこみ"],["、"],["彼","かれ"],["ら"],["は"],["それぞれ"],["自分","じぶん"],["の"],["家","いえ"],["に"],["帰えった","かえった"],["。"]]},{"verse":7,"text":"わたしたちは、ツロからの航行,こうこうを終,おわってトレマイに着,つき、そこの兄弟,きょうだいたちにあいさつをし、彼,かれらのところに一日,にち滞在,たいざいした。","tok":[["わたしたち"],["は"],["、"],["ツロ"],["から"],["の"],["航行","こうこう"],["を"],["終わって","おわって"],["トレマイ"],["に"],["着き","つき"],["、"],["そこ"],["の"],["兄弟","きょうだい"],["たち"],["に"],["あいさつ"],["を"],["し"],["、"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["一","いち"],["日","にち"],["ち"],["滞在","たいざい"],["した"],["。"]]},{"verse":8,"text":"翌日,よくじつそこをたって、カイザリヤに着,つき、かの七人,にんのひとりである伝道者,でんどうしゃピリポの家,いえに行,いき、そこに泊,とまった。","tok":[["翌日","よくじつ"],["そこ"],["を"],["たって"],["、"],["カイザリヤ"],["に"],["着き","つき"],["、"],["かの"],["七人","にん"],["の"],["ひとり"],["で"],["ある"],["伝道者","でんどうしゃ"],["ピリポ"],["の"],["家","いえ"],["に"],["行き","いき"],["、"],["そこ"],["に"],["泊まった","とまった"],["。"]]},{"verse":9,"text":"この人,ひとに四人,にんの娘,むすめがあったが、いずれも処女,しょじょであって、預言,よげんをしていた。","tok":[["この"],["人","ひと"],["に"],["四人","にん"],["の"],["娘","むすめ"],["が"],["あった"],["が"],["、"],["いずれ"],["も"],["処女","しょじょ"],["で"],["あって"],["、"],["預言","よげん"],["を"],["して"],["いた"],["。"]]},{"verse":10,"text":"幾日,いくにちか滞在,たいざいしている間,あいだに、アガボという預言者,よげんしゃがユダヤから下,くだってきた。","tok":[["幾日","い"],["く"],["にち"],["か"],["滞在","たいざい"],["して"],["いる"],["間","あいだ"],["に"],["、"],["アガボ"],["と"],["いう"],["預言者","よげんしゃ"],["が"],["ユダヤ"],["から"],["下って","くだって"],["きた"],["。"]]},{"verse":11,"text":"そして、わたしたちのところにきて、パウロの帯,おびを取,とり、それで自分,じぶんの手足,てあしを縛,しばって言,いった、「聖霊,せいれいがこうお告,つげになっている、『この帯,おびの持,もち主,ぬしを、ユダヤ人,じんたちがエルサレムでこのように縛,しばって、異邦人,いほうじんの手,てに渡,わたすであろう』」。","tok":[["そして"],["、"],["わたしたち"],["の"],["ところ"],["に"],["きて"],["、"],["パウロ"],["の"],["帯","おび"],["を"],["取","とり"],["、"],["それ"],["で"],["自分","じぶん"],["の"],["手足","てあし"],["を"],["縛って","しばって"],["言った","いった"],["、"],["「"],["聖霊","せいれい"],["が"],["こう"],["お告","おつげ"],["に"],["なって"],["いる"],["、"],["『"],["この"],["帯","おび"],["の"],["持主","もちぬし"],["を"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["エルサレム"],["で"],["この"],["よう"],["に"],["縛って","しばって"],["、"],["異邦人","いほうじん"],["の"],["手","て"],["に"],["渡すで","わたすで"],["あろう"],["』"],["」"],["。"]]},{"verse":12,"text":"わたしたちはこれを聞,きいて、土地,とちの人,ひとたちと一緒,いっしょになって、エルサレムには上,のぼって行,いかないようにと、パウロに願,ねがい続,つづけた。","tok":[["わたしたち"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["土地","とち"],["の"],["人","ひと"],["たち"],["と"],["一緒","いっしょ"],["に"],["なって"],["、"],["エルサレム"],["に"],["は"],["上って","のぼって"],["行かない","いかない"],["よう"],["に"],["と"],["、"],["パウロ"],["に"],["願い","ねがい"],["続けた","つづけた"],["。"]]},{"verse":13,"text":"その時,ときパウロは答,こたえた、「あなたがたは、泣,ないたり、わたしの心,こころをくじいたりして、いったい、どうしようとするのか。わたしは、主,しゅイエスの名,なのためなら、エルサレムで縛,しばられるだけでなく、死,しぬことをも覚悟,かくごしているのだ」。","tok":[["その"],["時","とき"],["パウロ"],["は"],["答","こたえ"],["た"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["泣い","ない"],["たり"],["、"],["わたし"],["の"],["心","こころ"],["を"],["くじい"],["たり"],["して"],["、"],["いったい"],["、"],["どう"],["しよう"],["と"],["する"],["の"],["か"],["。"],["わたし"],["は"],["、"],["主","しゅ"],["イエス"],["の"],["名","な"],["の"],["ため"],["なら"],["、"],["エルサレム"],["で"],["縛られる","しばられる"],["だけ"],["で"],["なく"],["、"],["死ぬ","しぬ"],["こと"],["を"],["も"],["覚悟","かくご"],["して"],["いる"],["の"],["だ"],["」"],["。"]]},{"verse":14,"text":"こうして、パウロが勧告,かんこくを聞,ききいれてくれないので、わたしたちは「主,しゅのみこころが行,おこなわれますように」と言,いっただけで、それ以上,いじょう、何,なにも言,いわなかった。","tok":[["こう"],["して"],["、"],["パウロ"],["が"],["勧告","かんこく"],["を"],["聞きいれて","ききいれて"],["くれない"],["ので"],["、"],["わたしたち"],["は"],["「"],["主","しゅ"],["のみ"],["こころ"],["が"],["行なわれます","おこなわれます"],["よう"],["に"],["」"],["と"],["言った","いった"],["だけ"],["で"],["、"],["それ"],["以上","いじょう"],["、"],["何に","なに"],["も"],["言わなかった","いわなかった"],["。"]]},{"verse":15,"text":"数日後,すうじつご、わたしたちは旅装,りょそうを整,ととのえてエルサレムへ上,のぼって行,いった。","tok":[["数日後","すうじつご"],["、"],["わたしたち"],["は"],["旅装","りょそう"],["を"],["整えて","ととのえて"],["エルサレム"],["へ"],["上って","のぼって"],["行った","いった"],["。"]]},{"verse":16,"text":"カイザリヤの弟子,でしたちも数人,すうにん、わたしたちと同行,どうこうして、古,ふるくからの弟子,でしであるクプロ人,びとマナソンの家,いえに案内,あんないしてくれた。わたしたちはその家,いえに泊,とまることになっていたのである。","tok":[["カイザリヤ"],["の"],["弟子","でし"],["たち"],["も"],["数人","す"],["うに"],["ん"],["、"],["わたしたち"],["と"],["同行","どうこう"],["して"],["、"],["古く","ふるく"],["から"],["の"],["弟子","でし"],["で"],["ある"],["クプロ人","くぷろび"],["と"],["マナソン"],["の"],["家","いえ"],["に"],["案内","あんない"],["して"],["くれた"],["。"],["わたしたち"],["は"],["その"],["家","いえ"],["に"],["泊まる","とまる"],["こと"],["に"],["なって"],["いた"],["ので"],["ある"],["。"]]},{"verse":17,"text":"わたしたちがエルサレムに到着,とうちゃくすると、兄弟,きょうだいたちは喜,よろこんで迎,むかえてくれた。","tok":[["わたしたち"],["が"],["エルサレム"],["に"],["到着","とうちゃく"],["する"],["と"],["、"],["兄弟","きょうだい"],["たち"],["は"],["喜こんで","よろこんで"],["迎","むかえ"],["て"],["くれた"],["。"]]},{"verse":18,"text":"翌日,よくじつパウロはわたしたちを連,つれて、ヤコブを訪問,ほうもんしに行,いった。そこに長老,ちょうろうたちがみな集,あつまっていた。","tok":[["翌日","よくじつ"],["パウロ"],["は"],["わたしたち"],["を"],["連れて","つれて"],["、"],["ヤコブ"],["を"],["訪問","ほうもん"],["し"],["に"],["行った","いった"],["。"],["そこ"],["に"],["長老","ちょうろう"],["たち"],["が"],["みな"],["集まって","あつまって"],["いた"],["。"]]},{"verse":19,"text":"パウロは彼,かれらにあいさつをした後,のち、神,かみが自分,じぶんの働,はたらきをとおして、異邦人,いほうじんの間,あいだになさった事,ことどもを一々,いちいち説明,せつめいした。","tok":[["パウロ"],["は"],["彼","かれ"],["ら"],["に"],["あいさつ"],["を"],["した"],["後","の"],["ち"],["、"],["神","かみ"],["が"],["自分","じぶん"],["の"],["働らき","はたらき"],["を"],["とおして"],["、"],["異邦人","いほうじん"],["の"],["間","あいだ"],["に"],["なさった"],["事","こと"],["ども"],["を"],["一々","いちいち"],["説明","せつめい"],["した"],["。"]]},{"verse":20,"text":"一同,いちどうはこれを聞,きいて神,かみをほめたたえ、そして彼,かれに言,いった、「兄弟,きょうだいよ、ご承知,しょうちのように、ユダヤ人,じんの中,なかで信者,しんじゃになった者,ものが、数万,すうまんにものぼっているが、みんな律法,りっぽうに熱心,ねっしんな人,ひとたちである。","tok":[["一同","いちどう"],["は"],["これ"],["を"],["聞いて","きいて"],["神","かみ"],["を"],["ほめたたえ"],["、"],["そして"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["兄弟","きょうだい"],["よ"],["、"],["ご承知","ごしょうち"],["の"],["よう"],["に"],["、"],["ユダヤ人","ゆだやじん"],["の"],["中","なか"],["で"],["信者","しんじゃ"],["に"],["なった"],["者","もの"],["が"],["、"],["数","すう"],["万","まん"],["に"],["も"],["のぼって"],["いる"],["が"],["、"],["みんな"],["律法","りっぽう"],["に"],["熱心","ねっしん"],["な"],["人","ひと"],["たち"],["で"],["ある"],["。"]]},{"verse":21,"text":"ところが、彼,かれらが伝,つたえ聞,きいているところによれば、あなたは異邦人,いほうじんの中,なかにいるユダヤ人,じん一同,いちどうに対,たいして、子供,こどもに割礼,かつれいを施,ほどこすな、またユダヤの慣例,かんれいにしたがうなと言,いって、モーセにそむくことを教,おしえている、ということである。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["ら"],["が"],["伝え聞いて","つたえきいて"],["いる"],["ところ"],["に"],["よれば"],["、"],["あなた"],["は"],["異邦人","いほうじん"],["の"],["中","なか"],["に"],["いる"],["ユダヤ人","ゆだやじん"],["一同","いちどう"],["に対して","にたいして"],["、"],["子供","こども"],["に"],["割礼","かつれい"],["を"],["施す","ほどこす"],["な"],["、"],["また"],["ユダヤ"],["の"],["慣例","かんれい"],["に"],["したがう"],["な"],["と"],["言って","いって"],["、"],["モーセ"],["に"],["そむく"],["こと"],["を"],["教えて","おしえて"],["いる"],["、"],["と"],["いう"],["こと"],["で"],["ある"],["。"]]},{"verse":22,"text":"どうしたらよいか。あなたがここにきていることは、彼,かれらもきっと聞,きき込,こむに違,ちがいない。","tok":[["どう"],["したら"],["よい"],["か"],["。"],["あなた"],["が"],["ここ"],["に"],["きて"],["いる"],["こと"],["は"],["、"],["彼","かれ"],["ら"],["も"],["きっと"],["聞込む","ききこむ"],["に"],["違い","ちがい"],["ない"],["。"]]},{"verse":23,"text":"ついては、今,いまわたしたちが言,いうとおりのことをしなさい。わたしたちの中,なかに、誓願,せいがんを立,たてている者,ものが四人,にんいる。","tok":[["ついて"],["は"],["、"],["今","いま"],["わたしたち"],["が"],["言う","いう"],["とおり"],["の"],["こと"],["を"],["し"],["なさい"],["。"],["わたしたち"],["の"],["中","なか"],["に"],["、"],["誓願","せいがん"],["を"],["立て","たてて"],["いる"],["者","もの"],["が"],["四人","にん"],["いる"],["。"]]},{"verse":24,"text":"この人,ひとたちを連,つれて行,いって、彼,かれらと共,ともにきよめを行,おこない、また彼,かれらの頭,あたまをそる費用,ひようを引,ひき受,うけてやりなさい。そうすれば、あなたについて、うわさされていることは、根,ねも葉,はもないことで、あなたは律法,りっぽうを守,まもって、正,ただしい生活,せいかつをしていることが、みんなにわかるであろう。","tok":[["この"],["人","ひと"],["たち"],["を"],["連れて","つれて"],["行って","いって"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["きよめ"],["を"],["行ない","おこない"],["、"],["また"],["彼","かれ"],["ら"],["の"],["頭","あたま"],["を"],["そる"],["費用","ひよう"],["を"],["引受","ひきうけ"],["て"],["やり"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["について"],["、"],["うわさ"],["されて"],["いる"],["こと"],["は"],["、"],["根","ね"],["も"],["葉","は"],["も"],["ない"],["こと"],["で"],["、"],["あなた"],["は"],["律法","りっぽう"],["を"],["守って","まもって"],["、"],["正い","ただしい"],["生活","せいかつ"],["を"],["して"],["いる"],["こと"],["が"],["、"],["みんな"],["に"],["わかるで"],["あろう"],["。"]]},{"verse":25,"text":"異邦人,いほうじんで信者,しんじゃになった人,ひとたちには、すでに手紙,てがみで、偶像,ぐうぞうに供,そなえたものと、血,ちと、絞,しめ殺,ころしたものと、不品行,ふひんこうとを、慎,つつしむようにとの決議,けつぎが、わたしたちから知,しらせてある」。","tok":[["異邦人","いほうじん"],["で"],["信者","しんじゃ"],["に"],["なった"],["人","ひと"],["たち"],["に"],["は"],["、"],["すでに"],["手紙","てがみ"],["で"],["、"],["偶像","ぐうぞう"],["に"],["供えた","そなえた"],["もの"],["と"],["、"],["血","ち"],["と"],["、"],["絞め殺した","しめころした"],["もの"],["と"],["、"],["不品行","ふひんこう"],["と"],["を"],["、"],["慎しむ","つつしむ"],["よう"],["に"],["と"],["の"],["決議","けつぎ"],["が"],["、"],["わたしたち"],["から"],["知らせて","しらせて"],["ある"],["」"],["。"]]},{"verse":26,"text":"そこでパウロは、その次,つぎの日,ひに四人,にんの者,ものを連,つれて、彼,かれらと共,ともにきよめを受,うけてから宮,みやにはいった。そしてきよめの期間,きかんが終,おわって、ひとりびとりのために供,そなえ物,ものをささげる時,ときを報告,ほうこくしておいた。","tok":[["そこ"],["で"],["パウロ"],["は"],["、"],["その"],["次","つぎ"],["の"],["日","ひ"],["に"],["四人","にん"],["の"],["者","もの"],["を"],["連れて","つれて"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["きよめ"],["を"],["受て","うけて"],["から"],["宮","みや"],["に"],["はいった"],["。"],["そして"],["きよめ"],["の"],["期間","きかん"],["が"],["終わって","おわって"],["、"],["ひとりびとり"],["の"],["ため"],["に"],["供え物","そなえもの"],["を"],["ささげる"],["時","とき"],["を"],["報告","ほうこく"],["して"],["おいた"],["。"]]},{"verse":27,"text":"七日,なぬかの期間,きかんが終,おわろうとしていた時,とき、アジヤからきたユダヤ人,じんたちが、宮,みやの内,うちでパウロを見,みかけて、群衆,ぐんしゅう全体,ぜんたいを煽動,せんどうしはじめ、パウロに手,てをかけて叫,さけび立,たてた、","tok":[["七日","なぬか"],["の"],["期間","きかん"],["が"],["終わろう","おわろう"],["として"],["いた"],["時","とき"],["、"],["アジヤ"],["から"],["きた"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["、"],["宮","みや"],["の"],["内","うち"],["で"],["パウロ"],["を"],["見かけて","みかけて"],["、"],["群衆","ぐんしゅう"],["全体","ぜんたい"],["を"],["煽動","せんどう"],["し"],["はじめ"],["、"],["パウロ"],["に"],["手","て"],["を"],["かけて"],["叫","さけび"],["立てた","たてた"],["、"]]},{"verse":28,"text":"「イスラエルの人々,ひとびとよ、加勢,かせいにきてくれ。この人,ひとは、いたるところで民,たみと律法,りっぽうとこの場所,ばしょにそむくことを、みんなに教,おしえている。その上,うえに、ギリシヤ人,じんを宮,みやの内,うちに連,つれ込,こんで、この神聖,しんせいな場所,ばしょを汚,けがしたのだ」。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["よ"],["、"],["加勢","かせい"],["に"],["きて"],["くれ"],["。"],["この"],["人","ひと"],["は"],["、"],["いたる"],["ところ"],["で"],["民","たみ"],["と"],["律法","りっぽう"],["と"],["この"],["場所","ばしょ"],["に"],["そむく"],["こと"],["を"],["、"],["みんな"],["に"],["教えて","おしえて"],["いる"],["。"],["その"],["上","うえ"],["に"],["、"],["ギリシヤ"],["人","じん"],["を"],["宮","みや"],["の"],["内","うち"],["に"],["連れ込んで","つれこんで"],["、"],["この"],["神聖","しんせい"],["な"],["場所","ばしょ"],["を"],["汚","け"],["がした"],["の"],["だ"],["」"],["。"]]},{"verse":29,"text":"彼,かれらは、前,まえにエペソ人,びとトロピモが、パウロと一緒,いっしょに町,まちを歩,あるいていたのを見,みかけて、その人,ひとをパウロが宮,みやの内,うちに連,つれ込,こんだのだと思,おもったのである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["前","まえ"],["に"],["エペソ人","えぺそび"],["と"],["トロピモ"],["が"],["、"],["パウロ"],["と"],["一緒","いっしょ"],["に"],["町","まち"],["を"],["歩いて","あるいて"],["いた"],["の"],["を"],["見かけて","みかけて"],["、"],["その"],["人","ひと"],["を"],["パウロ"],["が"],["宮","みや"],["の"],["内","うち"],["に"],["連れ","つれ"],["込","こんだ"],["の"],["だ"],["と"],["思った","おもった"],["ので"],["ある"],["。"]]},{"verse":30,"text":"そこで、市,し全体,ぜんたいが騒,さわぎ出,だし、民衆,みんしゅうが駆,かけ集,あつまってきて、パウロを捕,とらえ、宮,みやの外,そとに引,ひきずり出,だした。そして、すぐそのあとに宮,みやの門,もんが閉,とざされた。","tok":[["そこ"],["で"],["、"],["市","し"],["全体","ぜんたい"],["が"],["騒出し","さわぎだし"],["、"],["民衆","みんしゅう"],["が"],["駆け集まって","かけあつまって"],["きて"],["、"],["パウロ"],["を"],["捕らえ","とらえ"],["、"],["宮","みや"],["の"],["外","そと"],["に"],["引","ひき"],["ずり出した","ずりだした"],["。"],["そして"],["、"],["すぐ"],["その"],["あと"],["に"],["宮","みや"],["の"],["門","もん"],["が"],["閉ざされた","とざされた"],["。"]]},{"verse":31,"text":"彼,かれらがパウロを殺,ころそうとしていた時,ときに、エルサレム全体,ぜんたいが混乱,こんらん状態,じょうたいに陥,おちいっているとの情報,じょうほうが、守備,しゅび隊,たいの千卒長,せんそつちょうにとどいた。","tok":[["彼","かれ"],["ら"],["が"],["パウロ"],["を"],["殺そう","ころそう"],["として"],["いた"],["時","とき"],["に"],["、"],["エルサレム"],["全体","ぜんたい"],["が"],["混乱","こんらん"],["状態","じょうたい"],["に"],["陥て","おちいって"],["いる"],["と"],["の"],["情報","じょうほう"],["が"],["、"],["守備隊","しゅびたい"],["の"],["千卒長","せんそつちょう"],["に"],["とどいた"],["。"]]},{"verse":32,"text":"そこで、彼,かれはさっそく、兵卒,へいそつや百卒長,ひゃくそつちょうたちを率,ひきいて、その場,ばに駆,かけつけた。人々,ひとびとは千卒長,せんそつちょうや兵卒,へいそつたちを見,みて、パウロを打,うちたたくのをやめた。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["は"],["さっそく"],["、"],["兵卒","へいそつ"],["や"],["百卒長","ひゃくそつちょう"],["たち"],["を"],["率いて","ひきいて"],["、"],["その"],["場","ば"],["に"],["駆けつけた","かけつけた"],["。"],["人々","ひとびと"],["は"],["千卒長","せんそつちょう"],["や"],["兵卒","へいそつ"],["たち"],["を"],["見て","みて"],["、"],["パウロ"],["を"],["打ちたたく","うちたたく"],["の"],["を"],["やめた"],["。"]]},{"verse":33,"text":"千卒長,せんそつちょうは近寄,ちかよってきてパウロを捕,とらえ、彼,かれを二重,にじゅうの鎖,くさりで縛,しばっておくように命,めいじた上,うえ、パウロは何者,なにものか、また何,なにをしたのか、と尋,たずねた。","tok":[["千卒長","せんそつちょう"],["は"],["近寄って","ちかよって"],["きて"],["パウロ"],["を"],["捕らえ","とらえ"],["、"],["彼","かれ"],["を"],["二","に"],["重","じゅう"],["の"],["鎖","くさり"],["で"],["縛って","しばって"],["おく"],["よう"],["に"],["命じた","めいじた"],["上","うえ"],["、"],["パウロ"],["は"],["何者","なにもの"],["か"],["、"],["また"],["何に","なに"],["を"],["した"],["の"],["か"],["、"],["と"],["尋ねた","たずねた"],["。"]]},{"verse":34,"text":"しかし、群衆,ぐんしゅうがそれぞれ違,ちがったことを叫,さけびつづけるため、騒,さわがしくて、確,たしかなことがわからないので、彼,かれはパウロを兵営,へいえいに連,つれて行,いくように命,めいじた。","tok":[["しかし"],["、"],["群衆","ぐんしゅう"],["が"],["それぞれ"],["違った","ちがった"],["こと"],["を"],["叫","さけび"],["つづける"],["ため"],["、"],["騒がしくて","さわがしくて"],["、"],["確か","たしか"],["な"],["こと"],["が"],["わからない"],["ので"],["、"],["彼","かれ"],["は"],["パウロ"],["を"],["兵営","へいえい"],["に"],["連れて","つれて"],["行く","いく"],["よう"],["に"],["命じた","めいじた"],["。"]]},{"verse":35,"text":"パウロが階段,かいだんにさしかかった時,ときには、群衆,ぐんしゅうの暴行,ぼうこうを避,さけるため、兵卒,へいそつたちにかつがれて行,いくという始末,しまつであった。","tok":[["パウロ"],["が"],["階段","かいだん"],["に"],["さしかかった"],["時","とき"],["に"],["は"],["、"],["群衆","ぐんしゅう"],["の"],["暴行","ぼうこう"],["を"],["避ける","さける"],["ため"],["、"],["兵卒","へいそつ"],["たち"],["に"],["かつがれて"],["行く","いく"],["と"],["いう"],["始末","しまつ"],["で"],["あった"],["。"]]},{"verse":36,"text":"大,おおぜいの民衆,みんしゅうが「あれをやっつけてしまえ」と叫,さけびながら、ついてきたからである。","tok":[["大ぜい","おおぜい"],["の"],["民衆","みんしゅう"],["が"],["「"],["あれ"],["を"],["やっつけて"],["しまえ"],["」"],["と"],["叫","さけび"],["ながら"],["、"],["ついて"],["きた"],["から"],["で"],["ある"],["。"]]},{"verse":37,"text":"パウロが兵営,へいえいの中,なかに連,つれて行,いかれようとした時,とき、千卒長,せんそつちょうに、「ひと言,ことあなたにお話,はなしてもよろしいですか」と尋,たずねると、千卒長,せんそつちょうが言,いった、「おまえはギリシヤ語,ごが話,はなせるのか。","tok":[["パウロ"],["が"],["兵営","へいえい"],["の"],["中","なか"],["に"],["連れて","つれて"],["行かれよう","いかれよう"],["と"],["した"],["時","とき"],["、"],["千卒長","せんそつちょう"],["に"],["、"],["「"],["ひと言","ひとこと"],["あなた"],["に"],["お話","おはなし"],["て"],["も"],["よろしいです"],["か"],["」"],["と"],["尋ねる","たずねる"],["と"],["、"],["千卒長","せんそつちょう"],["が"],["言った","いった"],["、"],["「"],["おまえ"],["は"],["ギリシヤ"],["語","ご"],["が"],["話せる","はなせる"],["の"],["か"],["。"]]},{"verse":38,"text":"では、もしかおまえは、先,さきごろ反乱,はんらんを起,おこした後,のち、四千人,にんの刺客,しかくを引,ひき連,つれて荒野,あらのへ逃,にげて行,いったあのエジプト人,じんではないのか」。","tok":[["で"],["は"],["、"],["もし"],["か"],["おまえ"],["は"],["、"],["先ごろ","さきごろ"],["反乱","はんらん"],["を"],["起こした","おこした"],["後","の"],["ち"],["、"],["四千人","にん"],["の"],["刺客","しかく"],["を"],["引連れて","ひきつれて"],["荒野","あら"],["の"],["へ"],["逃て","にげて"],["行った","いった"],["あの"],["エジプト"],["人","じん"],["で"],["は"],["ない"],["の"],["か"],["」"],["。"]]},{"verse":39,"text":"パウロは答,こたえた、「わたしはタルソ生,うまれのユダヤ人,じんで、キリキヤのれっきとした都市,としの市民,しみんです。お願,ねがいですが、民衆,みんしゅうに話,はなしをさせて下,ください」。","tok":[["パウロ"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["は"],["タルソ"],["生まれ","うまれ"],["の"],["ユダヤ人","ゆだやじん"],["で"],["、"],["キリキヤ"],["の"],["れっき"],["と"],["した"],["都市","とし"],["の"],["市民","しみん"],["です"],["。"],["お願い","おねがい"],["です"],["が"],["、"],["民衆","みんしゅう"],["に"],["話","はなし"],["を"],["させて"],["下さい","ください"],["」"],["。"]]},{"verse":40,"text":"千卒長,せんそつちょうが許,ゆるしてくれたので、パウロは階段,かいだんの上,うえに立,たち、民衆,みんしゅうにむかって手,てを振,ふった。すると、一同,いちどうがすっかり静粛,せいしゅくになったので、パウロはヘブル語,ごで話,はなし出,だした。","tok":[["千卒長","せんそつちょう"],["が"],["許して","ゆるして"],["くれた"],["ので"],["、"],["パウロ"],["は"],["階段","かいだん"],["の"],["上","うえ"],["に"],["立ち","たち"],["、"],["民衆","みんしゅう"],["に"],["むかって"],["手","て"],["を"],["振った","ふった"],["。"],["する"],["と"],["、"],["一同","いちどう"],["が"],["すっかり"],["静粛","せいしゅく"],["に"],["なった"],["ので"],["、"],["パウロ"],["は"],["ヘブル"],["語","ご"],["で"],["話","はなし"],["出した","だした"],["。"]]}]
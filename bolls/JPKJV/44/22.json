[{"verse":1,"text":"「兄弟,きょうだいたち、父,ちちたちよ、いま申,もうし上,あげるわたしの弁明,べんめいを聞,きいていただきたい」。","tok":[["「"],["兄弟","きょうだい"],["たち"],["、"],["父","ちち"],["たち"],["よ"],["、"],["いま"],["申し上げる","もうしあげる"],["わたし"],["の"],["弁明","べんめい"],["を"],["聞いて","きいて"],["いただきたい"],["」"],["。"]]},{"verse":2,"text":"パウロが、ヘブル語,ごでこう語,かたりかけるのを聞,きいて、人々,ひとびとはますます静粛,せいしゅくになった。","tok":[["パウロ"],["が"],["、"],["ヘブル"],["語","ご"],["で"],["こう"],["語りかける","かたりかける"],["の"],["を"],["聞いて","きいて"],["、"],["人々","ひとびと"],["は"],["ますます"],["静粛","せいしゅく"],["に"],["なった"],["。"]]},{"verse":3,"text":"そこで彼,かれは言葉,ことばをついで言,いった、「わたしはキリキヤのタルソで生,うまれたユダヤ人,じんであるが、この都,みやこで育,そだてられ、ガマリエルのひざもとで先祖,せんぞ伝来,でんらいの律法,りっぽうについて、きびしい薫陶,くんとうを受,うけ、今日,きょうの皆,みなさんと同,おなじく神,かみに対,たいして熱心,ねっしんな者,ものであった。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["言葉","ことば"],["を"],["ついで"],["言った","いった"],["、"],["「"],["わたし"],["は"],["キリキヤ"],["の"],["タルソ"],["で"],["生まれた","うまれた"],["ユダヤ人","ゆだやじん"],["で"],["ある"],["が"],["、"],["この"],["都","みやこ"],["で"],["育てられ","そだてられ"],["、"],["ガマリエル"],["の"],["ひざもと"],["で"],["先祖","せんぞ"],["伝来","でんらい"],["の"],["律法","りっぽう"],["について"],["、"],["きびしい"],["薫陶","くんとう"],["を"],["受け","うけ"],["、"],["今日","きょう"],["の"],["皆","みな"],["さん"],["と"],["同じく","おなじく"],["神","かみ"],["に対して","にたいして"],["熱心","ねっしん"],["な"],["者","もの"],["で"],["あった"],["。"]]},{"verse":4,"text":"そして、この道,みちを迫害,はくがいし、男,おとこであれ女,おんなであれ、縛,しばりあげて獄,ごくに投,とうじ、彼,かれらを死,しに至,いたらせた。","tok":[["そして"],["、"],["この"],["道","みち"],["を"],["迫害","はくがい"],["し"],["、"],["男","おとこ"],["で"],["あれ"],["女","おんな"],["で"],["あれ"],["、"],["縛りあげて","しばりあげて"],["獄","ごく"],["に"],["投じ","とうじ"],["、"],["彼","かれ"],["ら"],["を"],["死","し"],["に"],["至らせた","いたらせた"],["。"]]},{"verse":5,"text":"このことは、大祭司,だいさいしも長老,ちょうろうたち一同,いちどうも、証明,しょうめいするところである。さらにわたしは、この人,ひとたちからダマスコの同志,どうしたちへあてた手紙,てがみをもらって、その地,ちにいる者,ものたちを縛,しばりあげ、エルサレムにひっぱってきて、処罰,しょばつするため、出,でかけて行,いった。","tok":[["この"],["こと"],["は"],["、"],["大","だい"],["祭司","さいし"],["も"],["長老","ちょうろう"],["たち"],["一同","いちどう"],["も"],["、"],["証明","しょうめい"],["する"],["ところ"],["で"],["ある"],["。"],["さらに"],["わたし"],["は"],["、"],["この"],["人","ひと"],["たち"],["から"],["ダマスコ"],["の"],["同志","どうし"],["たち"],["へ"],["あてた"],["手紙","てがみ"],["を"],["もらって"],["、"],["その"],["地","ち"],["に"],["いる"],["者","もの"],["たち"],["を"],["縛りあげ","しばりあげ"],["、"],["エルサレム"],["に"],["ひっぱって"],["きて"],["、"],["処罰","しょばつ"],["する"],["ため"],["、"],["出かけて","でかけて"],["行った","いった"],["。"]]},{"verse":6,"text":"旅,たびをつづけてダマスコの近,ちかくにきた時,ときに、真昼,まひるごろ、突然,とつぜん、つよい光,ひかりが天,てんからわたしをめぐり照,てらした。","tok":[["旅","たび"],["を"],["つづけて"],["ダマスコ"],["の"],["近く","ちかく"],["に"],["きた"],["時","とき"],["に"],["、"],["真","ま"],["昼ごろ","ひるごろ"],["、"],["突然","とつぜん"],["、"],["つよい"],["光","ひかり"],["が"],["天","てん"],["から"],["わたし"],["を"],["めぐり"],["照","てらし"],["た"],["。"]]},{"verse":7,"text":"わたしは地,ちに倒,たおれた。そして、『サウロ、サウロ、なぜわたしを迫害,はくがいするのか』と、呼,よびかける声,こえを聞,きいた。","tok":[["わたし"],["は"],["地","ち"],["に"],["倒れた","たおれた"],["。"],["そして"],["、"],["『"],["サウロ"],["、"],["サウロ"],["、"],["なぜ"],["わたし"],["を"],["迫害","はくがい"],["する"],["の"],["か"],["』"],["と"],["、"],["呼びかける","よびかける"],["声","こえ"],["を"],["聞いた","きいた"],["。"]]},{"verse":8,"text":"これに対,たいしてわたしは、『主,しゅよ、あなたはどなたですか』と言,いった。すると、その声,こえが、『わたしは、あなたが迫害,はくがいしているナザレ人,びとイエスである』と答,こたえた。","tok":[["これ"],["に対して","にたいして"],["わたし"],["は"],["、"],["『"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["どなた"],["です"],["か"],["』"],["と"],["言った","いった"],["。"],["する"],["と"],["、"],["その"],["声","こえ"],["が"],["、"],["『"],["わたし"],["は"],["、"],["あなた"],["が"],["迫害","はくがい"],["して"],["いる"],["ナザレ人","なざれび"],["と"],["イエス"],["で"],["ある"],["』"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":9,"text":"わたしと一緒,いっしょにいた者,ものたちは、その光,ひかりは見,みたが、わたしに語,かたりかけたかたの声,こえは聞,きかなかった。","tok":[["わたし"],["と"],["一緒","いっしょ"],["に"],["いた"],["者","もの"],["たち"],["は"],["、"],["その"],["光","ひかり"],["は"],["見た","みた"],["が"],["、"],["わたし"],["に"],["語りかけた","かたりかけた"],["かた"],["の"],["声","こえ"],["は"],["聞かなかった","きかなかった"],["。"]]},{"verse":10,"text":"わたしが『主,しゅよ、わたしは何,なにをしたらよいでしょうか』と尋,たずねたところ、主,しゅは言,いわれた、『起,おきあがってダマスコに行,いきなさい。そうすれば、あなたがするように決,きめてある事,ことが、すべてそこで告,つげられるであろう』。","tok":[["わたし"],["が"],["『"],["主","しゅ"],["よ"],["、"],["わたし"],["は"],["何に","なに"],["を"],["したら"],["よいでしょう"],["か"],["』"],["と"],["尋ねた","たずねた"],["ところ"],["、"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["『"],["起きあがって","おきあがって"],["ダマスコ"],["に"],["行き","いき"],["なさい"],["。"],["そう"],["すれば"],["、"],["あなた"],["が"],["する"],["よう"],["に"],["決めて","きめて"],["ある"],["事","こと"],["が"],["、"],["すべて"],["そこ"],["で"],["告げられるで","つげられるで"],["あろう"],["』"],["。"]]},{"verse":11,"text":"わたしは、光,ひかりの輝,かがやきで目,めがくらみ、何,なにも見,みえなくなっていたので、連,つれの者,ものたちに手,てを引,ひかれながら、ダマスコに行,いった。","tok":[["わたし"],["は"],["、"],["光","ひかり"],["の"],["輝やき","かがやき"],["で"],["目","め"],["が"],["くらみ"],["、"],["何に","なに"],["も"],["見えなく","みえなく"],["なって"],["いた"],["ので"],["、"],["連れ","つれ"],["の"],["者","もの"],["たち"],["に"],["手","て"],["を"],["引かれ","ひかれ"],["ながら"],["、"],["ダマスコ"],["に"],["行った","いった"],["。"]]},{"verse":12,"text":"すると、律法,りっぽうに忠実,ちゅうじつで、ダマスコ在住,ざいじゅうのユダヤ人,じん全体,ぜんたいに評判,ひょうばんのよいアナニヤという人,ひとが、","tok":[["する"],["と"],["、"],["律法","りっぽう"],["に"],["忠実","ちゅうじつ"],["で"],["、"],["ダマスコ"],["在住","ざいじゅう"],["の"],["ユダヤ人","ゆだやじん"],["全体","ぜんたい"],["に"],["評判","ひょうばん"],["の"],["よい"],["アナニヤ"],["と"],["いう"],["人","ひと"],["が"],["、"]]},{"verse":13,"text":"わたしのところにきて、そばに立,たち、『兄弟,きょうだいサウロよ、見,みえるようになりなさい』と言,いった。するとその瞬間,しゅんかんに、わたしの目,めが開,ひらいて、彼,かれの姿,すがたが見,みえた。","tok":[["わたし"],["の"],["ところ"],["に"],["きて"],["、"],["そば"],["に"],["立ち","たち"],["、"],["『"],["兄弟","きょうだい"],["サウロ"],["よ"],["、"],["見える","みえる"],["よう"],["に"],["なり"],["なさい"],["』"],["と"],["言った","いった"],["。"],["する"],["と"],["その"],["瞬間","しゅんかん"],["に"],["、"],["わたし"],["の"],["目","め"],["が"],["開らいて","ひらいて"],["、"],["彼","かれ"],["の"],["姿","すがた"],["が"],["見えた","みえた"],["。"]]},{"verse":14,"text":"彼,かれは言,いった、『わたしたちの先祖,せんぞの神,かみが、あなたを選,えらんでみ旨,むねを知,しらせ、かの義人,ぎじんを見,みさせ、その口,くちから声,こえをお聞,きかせになった。","tok":[["彼","かれ"],["は"],["言った","いった"],["、"],["『"],["わたしたち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["が"],["、"],["あなた"],["を"],["選らんで","えらんで"],["み旨","みむね"],["を"],["知らせ","しらせ"],["、"],["かの"],["義人","ぎじん"],["を"],["見させ","みさせ"],["、"],["その"],["口","くち"],["から"],["声","こえ"],["を"],["お聞かせ","おきかせ"],["に"],["なった"],["。"]]},{"verse":15,"text":"それはあなたが、その見聞,みききした事,ことにつき、すべての人,ひとに対,たいして、彼,かれの証人,しょうにんになるためである。","tok":[["それ"],["は"],["あなた"],["が"],["、"],["その"],["見聞き","みきき"],["した"],["事","こと"],["に"],["つき"],["、"],["すべて"],["の"],["人","ひと"],["に対して","にたいして"],["、"],["彼","かれ"],["の"],["証人","しょうにん"],["に"],["なる"],["ため"],["で"],["ある"],["。"]]},{"verse":16,"text":"そこで今,いま、なんのためらうことがあろうか。すぐ立,たって、み名,なをとなえてバプテスマを受,うけ、あなたの罪,つみを洗,あらい落,おとしなさい』。","tok":[["そこ"],["で"],["今","いま"],["、"],["なん"],["の"],["ためらう"],["こと"],["が"],["あろう"],["か"],["。"],["すぐ"],["立って","たって"],["、"],["み名","みな"],["を"],["となえて"],["バプテスマ"],["を"],["受け","うけ"],["、"],["あなた"],["の"],["罪","つみ"],["を"],["洗","あらい"],["落とし","おとし"],["なさい"],["』"],["。"]]},{"verse":17,"text":"それからわたしは、エルサレムに帰,かえって宮,みやで祈,いのっているうちに、夢,ゆめうつつになり、","tok":[["それ"],["から"],["わたし"],["は"],["、"],["エルサレム"],["に"],["帰えって","かえって"],["宮","みや"],["で"],["祈って","いのって"],["いる"],["うち"],["に"],["、"],["夢うつつ","ゆめうつつ"],["に"],["なり"],["、"]]},{"verse":18,"text":"主,しゅにまみえたが、主,しゅは言,いわれた、『急,いそいで、すぐにエルサレムを出,でて行,いきなさい。わたしについてのあなたのあかしを、人々,ひとびとが受,うけいれないから』。","tok":[["主に","しゅに"],["まみえた"],["が"],["、"],["主","しゅ"],["は"],["言われた","いわれた"],["、"],["『"],["急いで","いそいで"],["、"],["すぐ"],["に"],["エルサレム"],["を"],["出て","でて"],["行き","いき"],["なさい"],["。"],["わたし"],["について"],["の"],["あなた"],["の"],["あかし"],["を"],["、"],["人々","ひとびと"],["が"],["受","うけ"],["いれない"],["から"],["』"],["。"]]},{"verse":19,"text":"そこで、わたしが言,いった、『主,しゅよ、彼,かれらは、わたしがいたるところの会堂,かいどうで、あなたを信,しんじる人々,ひとびとを獄,ごくに投,とうじたり、むち打,うったりしていたことを、知,しっています。","tok":[["そこ"],["で"],["、"],["わたし"],["が"],["言った","いった"],["、"],["『"],["主","しゅ"],["よ"],["、"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["いたる"],["ところ"],["の"],["会堂","かいどう"],["で"],["、"],["あなた"],["を"],["信じる","しんじる"],["人々","ひとびと"],["を"],["獄","ごく"],["に"],["投じ","とうじ"],["たり"],["、"],["むち打っ","むちうっ"],["たり"],["して"],["いた"],["こと"],["を"],["、"],["知って","しって"],["います"],["。"]]},{"verse":20,"text":"また、あなたの証人,しょうにんステパノの血,ちが流,ながされた時,ときも、わたしは立,たち合,あっていてそれに賛成,さんせいし、また彼,かれを殺,ころした人,ひとたちの上着,うわぎの番,ばんをしていたのです』。","tok":[["また"],["、"],["あなた"],["の"],["証人","しょうにん"],["ステパノ"],["の"],["血","ち"],["が"],["流された","ながされた"],["時","とき"],["も"],["、"],["わたし"],["は"],["立ち合って","たちあって"],["いて"],["それ"],["に"],["賛成","さんせい"],["し"],["、"],["また"],["彼","かれ"],["を"],["殺ろした","ころした"],["人","ひと"],["たち"],["の"],["上着","うわぎ"],["の"],["番","ばん"],["を"],["して"],["いた"],["の"],["です"],["』"],["。"]]},{"verse":21,"text":"すると、主,しゅがわたしに言,いわれた、『行,いきなさい。わたしが、あなたを遠,とおく異邦,いほうの民,たみへつかわすのだ』」。","tok":[["する"],["と"],["、"],["主","しゅ"],["が"],["わたし"],["に"],["言われた","いわれた"],["、"],["『"],["行き","いき"],["なさい"],["。"],["わたし"],["が"],["、"],["あなた"],["を"],["遠く","とおく"],["異邦","いほう"],["の"],["民","たみ"],["へ"],["つかわす"],["の"],["だ"],["』"],["」"],["。"]]},{"verse":22,"text":"彼,かれの言葉,ことばをここまで聞,きいていた人々,ひとびとは、このとき、声,こえを張,はりあげて言,いった、「こんな男,おとこは地上,ちじょうから取,とり除,のぞいてしまえ。生,いかしおくべきではない」。","tok":[["彼","かれ"],["の"],["言葉","ことば"],["を"],["ここ"],["まで"],["聞いて","きいて"],["いた"],["人々","ひとびと"],["は"],["、"],["この"],["とき"],["、"],["声","こえ"],["を"],["張りあげて","はりあげて"],["言った","いった"],["、"],["「"],["こんな"],["男","おとこ"],["は"],["地上","ちじょう"],["から"],["取除いて","とりのぞいて"],["しまえ"],["。"],["生かし","いかし"],["おくべきで"],["は"],["ない"],["」"],["。"]]},{"verse":23,"text":"人々,ひとびとがこうわめき立,たてて、空中,くうちゅうに上着,うわぎを投,なげ、ちりをまき散,ちらす始末,しまつであったので、","tok":[["人々","ひとびと"],["が"],["こう"],["わめき立てて","わめきたてて"],["、"],["空中","くうちゅう"],["に"],["上着","うわぎ"],["を"],["投","なげ"],["、"],["ちり"],["を"],["まき散らす","まきちらす"],["始末","しまつ"],["で"],["あった"],["ので"],["、"]]},{"verse":24,"text":"千卒長,せんそつちょうはパウロを兵営,へいえいに引,ひき入,いれるように命,めいじ、どういうわけで、彼,かれに対,たいしてこんなにわめき立,たてているのかを確,たしかめるため、彼,かれをむちの拷問,ごうもんにかけて、取,とり調,しらべるように言,いいわたした。","tok":[["千卒長","せんそつちょう"],["は"],["パウロ"],["を"],["兵営","へいえい"],["に"],["引入れる","ひきいれる"],["よう"],["に"],["命じ","めいじ"],["、"],["どういう"],["わけ"],["で"],["、"],["彼","かれ"],["に対して","にたいして"],["こんな"],["に"],["わめき立て","わめきたてて"],["いる"],["の"],["か"],["を"],["確かめる","たしかめる"],["ため"],["、"],["彼","かれ"],["を"],["むち"],["の"],["拷問","ごうもん"],["に"],["かけて"],["、"],["取調","とりしらべ"],["る"],["よう"],["に"],["言いわたした","いいわたした"],["。"]]},{"verse":25,"text":"彼,かれらがむちを当,あてるため、彼,かれを縛,しばりつけていた時,とき、パウロはそばに立,たっている百卒長,ひゃくそつちょうに言,いった、「ローマの市民,しみんたる者,ものを、裁判,さいばんにかけもしないで、むち打,うってよいのか」。","tok":[["彼","かれ"],["ら"],["が"],["むち"],["を"],["当てる","あてる"],["ため"],["、"],["彼","かれ"],["を"],["縛りつけて","しばりつけて"],["いた"],["時","とき"],["、"],["パウロ"],["は"],["そば"],["に"],["立って","たって"],["いる"],["百卒長","ひゃくそつちょう"],["に"],["言った","いった"],["、"],["「"],["ローマ"],["の"],["市民","しみん"],["たる"],["者","もの"],["を"],["、"],["裁判","さいばん"],["に"],["かけ"],["も"],["しないで"],["、"],["むち打って","むちうって"],["よい"],["の"],["か"],["」"],["。"]]},{"verse":26,"text":"百卒長,ひゃくそつちょうはこれを聞,きき、千卒長,せんそつちょうのところに行,いって報告,ほうこくし、そして言,いった、「どうなさいますか。あの人,ひとはローマの市民,しみんなのです」。","tok":[["百卒長","ひゃくそつちょう"],["は"],["これ"],["を"],["聞","きき"],["、"],["千卒長","せんそつちょう"],["の"],["ところ"],["に"],["行って","いって"],["報告","ほうこく"],["し"],["、"],["そして"],["言った","いった"],["、"],["「"],["どう"],["なさいます"],["か"],["。"],["あの"],["人","ひと"],["は"],["ローマ"],["の"],["市民","しみん"],["な"],["の"],["です"],["」"],["。"]]},{"verse":27,"text":"そこで、千卒長,せんそつちょうがパウロのところにきて言,いった、「わたしに言,いってくれ。あなたはローマの市民,しみんなのか」。パウロは「そうです」と言,いった。","tok":[["そこ"],["で"],["、"],["千卒長","せんそつちょう"],["が"],["パウロ"],["の"],["ところ"],["に"],["きて"],["言った","いった"],["、"],["「"],["わたし"],["に"],["言って","いって"],["くれ"],["。"],["あなた"],["は"],["ローマ"],["の"],["市民","しみん"],["な"],["の"],["か"],["」"],["。"],["パウロ"],["は"],["「"],["そう"],["です"],["」"],["と"],["言った","いった"],["。"]]},{"verse":28,"text":"これに対,たいして千卒長,せんそつちょうが言,いった、「わたしはこの市民,しみん権,けんを、多額,たがくの金,かねで買,かい取,とったのだ」。するとパウロは言,いった、「わたしは生,うまれながらの市民,しみんです」。","tok":[["これ"],["に対して","にたいして"],["千卒長","せんそつちょう"],["が"],["言った","いった"],["、"],["「"],["わたし"],["は"],["この"],["市民権","しみんけん"],["を"],["、"],["多額","たがく"],["の"],["金","かね"],["で"],["買取った","かいとった"],["の"],["だ"],["」"],["。"],["する"],["と"],["パウロ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["は"],["生まれ","うまれ"],["ながら"],["の"],["市民","しみん"],["です"],["」"],["。"]]},{"verse":29,"text":"そこで、パウロを取,とり調,しらべようとしていた人,ひとたちは、ただちに彼,かれから身,みを引,ひいた。千卒長,せんそつちょうも、パウロがローマの市民,しみんであること、また、そういう人,ひとを縛,しばっていたことがわかって、恐,おそれた。","tok":[["そこ"],["で"],["、"],["パウロ"],["を"],["取調","とりしらべ"],["よう"],["として"],["いた"],["人","ひと"],["たち"],["は"],["、"],["ただちに"],["彼","かれ"],["から"],["身","み"],["を"],["引いた","ひいた"],["。"],["千卒長","せんそつちょう"],["も"],["、"],["パウロ"],["が"],["ローマ"],["の"],["市民","しみん"],["で"],["ある"],["こと"],["、"],["また"],["、"],["そう"],["いう"],["人","ひと"],["を"],["縛って","しばって"],["いた"],["こと"],["が"],["わかって"],["、"],["恐れた","おそれた"],["。"]]},{"verse":30,"text":"翌日,よくじつ、彼,かれは、ユダヤ人,じんがなぜパウロを訴,うったえ出,でたのか、その真相,しんそうを知,しろうと思,おもって彼,かれを解,といてやり、同時,どうじに祭司長,さいしちょうたちと全,ぜん議会,ぎかいとを召集,しょうしゅうさせ、そこに彼,かれを引,ひき出,だして、彼,かれらの前,まえに立,たたせた。","tok":[["翌日","よくじつ"],["、"],["彼","かれ"],["は"],["、"],["ユダヤ人","ゆだやじん"],["が"],["なぜ"],["パウロ"],["を"],["訴","うったえ"],["出た","でた"],["の"],["か"],["、"],["その"],["真相","しんそう"],["を"],["知ろう","しろう"],["と"],["思って","おもって"],["彼","かれ"],["を"],["解いて","といて"],["やり"],["、"],["同時","どうじ"],["に"],["祭司長","さいしちょう"],["たち"],["と"],["全","ぜん"],["議会","ぎかい"],["と"],["を"],["召集","しょうしゅう"],["させ"],["、"],["そこ"],["に"],["彼","かれ"],["を"],["引出して","ひきだして"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["立たせた","たたせた"],["。"]]}]
[{"verse":1,"text":"さてサウロは、なおも主,しゅの弟子,でしたちに対,たいする脅迫,きょうはく、殺害,さつがいの息,いきをはずませながら、大祭司,だいさいしのところに行,いって、","tok":[["さて"],["サウロ"],["は"],["、"],["なお"],["も"],["主","しゅ"],["の"],["弟子","でし"],["たち"],["に"],["対する","たいする"],["脅迫","きょうはく"],["、"],["殺害","さつがい"],["の"],["息","いき"],["を"],["はずませ"],["ながら"],["、"],["大","だい"],["祭司","さいし"],["の"],["ところ"],["に"],["行って","いって"],["、"]]},{"verse":2,"text":"ダマスコの諸,しょ会堂,かいどうあての添書,てんしょを求,もとめた。それは、この道,みちの者,ものを見,みつけ次第,しだい、男女,だんじょの別,べつなく縛,しばりあげて、エルサレムにひっぱって来,くるためであった。","tok":[["ダマスコ"],["の"],["諸","しょ"],["会堂","かいどう"],["あて"],["の"],["添書","てんしょ"],["を"],["求めた","もとめた"],["。"],["それ"],["は"],["、"],["この"],["道","みち"],["の"],["者","もの"],["を"],["見つけ","みつけ"],["次第","しだい"],["、"],["男女","だんじょ"],["の"],["別","べつ"],["なく"],["縛りあげて","しばりあげて"],["、"],["エルサレム"],["に"],["ひっぱって"],["来る","くる"],["ため"],["で"],["あった"],["。"]]},{"verse":3,"text":"ところが、道,みちを急,いそいでダマスコの近,ちかくにきたとき、突然,とつぜん、天,てんから光,ひかりがさして、彼,かれをめぐり照,てらした。","tok":[["ところ"],["が"],["、"],["道","みち"],["を"],["急いで","いそいで"],["ダマスコ"],["の"],["近く","ちかく"],["に"],["きた"],["とき"],["、"],["突然","とつぜん"],["、"],["天","てん"],["から"],["光","ひかり"],["が"],["さして"],["、"],["彼","かれ"],["を"],["めぐり"],["照","てらし"],["た"],["。"]]},{"verse":4,"text":"彼,かれは地,ちに倒,たおれたが、その時,とき「サウロ、サウロ、なぜわたしを迫害,はくがいするのか」と呼,よびかける声,こえを聞,きいた。","tok":[["彼","かれ"],["は"],["地","ち"],["に"],["倒れた","たおれた"],["が"],["、"],["その"],["時","とき"],["「"],["サウロ"],["、"],["サウロ"],["、"],["なぜ"],["わたし"],["を"],["迫害","はくがい"],["する"],["の"],["か"],["」"],["と"],["呼びかける","よびかける"],["声","こえ"],["を"],["聞いた","きいた"],["。"]]},{"verse":5,"text":"そこで彼,かれは「主,しゅよ、あなたは、どなたですか」と尋,たずねた。すると答,こたえがあった、「わたしは、あなたが迫害,はくがいしているイエスである。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["「"],["主","しゅ"],["よ"],["、"],["あなた"],["は"],["、"],["どなた"],["です"],["か"],["」"],["と"],["尋ねた","たずねた"],["。"],["する"],["と"],["答","こたえ"],["が"],["あった"],["、"],["「"],["わたし"],["は"],["、"],["あなた"],["が"],["迫害","はくがい"],["して"],["いる"],["イエス"],["で"],["ある"],["。"]]},{"verse":6,"text":"さあ立,たって、町,まちにはいって行,いきなさい。そうすれば、そこであなたのなすべき事,ことが告,つげられるであろう」。","tok":[["さあ"],["立って","たって"],["、"],["町","まち"],["に"],["はいって"],["行き","いき"],["なさい"],["。"],["そう"],["すれば"],["、"],["そこ"],["で"],["あなた"],["の"],["なすべき"],["事","こと"],["が"],["告げられるで","つげられるで"],["あろう"],["」"],["。"]]},{"verse":7,"text":"サウロの同行者,どうこうしゃたちは物,ものも言,いえずに立,たっていて、声,こえだけは聞,きこえたが、だれも見,みえなかった。","tok":[["サウロ"],["の"],["同行者","どうこうしゃ"],["たち"],["は"],["物","もの"],["も"],["言えず","いえず"],["に"],["立って","たって"],["いて"],["、"],["声","こえ"],["だけ"],["は"],["聞こえた","きこえた"],["が"],["、"],["だれ"],["も"],["見えなかった","みえなかった"],["。"]]},{"verse":8,"text":"サウロは地,ちから起,おき上,あがって目,めを開,ひらいてみたが、何,なにも見,みえなかった。そこで人々,ひとびとは、彼,かれの手,てを引,ひいてダマスコへ連,つれて行,いった。","tok":[["サウロ"],["は"],["地","ち"],["から"],["起き上がって","おきあがって"],["目","め"],["を"],["開らいて","ひらいて"],["みた"],["が"],["、"],["何に","なに"],["も"],["見えなかった","みえなかった"],["。"],["そこ"],["で"],["人々","ひとびと"],["は"],["、"],["彼","かれ"],["の"],["手","て"],["を"],["引いて","ひいて"],["ダマスコ"],["へ"],["連れて","つれて"],["行った","いった"],["。"]]},{"verse":9,"text":"彼,かれは三日間,かかん、目,めが見,みえず、また食,たべることも飲,のむこともしなかった。","tok":[["彼","かれ"],["は"],["三","みっ"],["日間","かかん"],["かん"],["、"],["目","め"],["が"],["見えず","みえず"],["、"],["また"],["食べる","たべる"],["こと"],["も"],["飲む","のむ"],["こと"],["も"],["しなかった"],["。"]]},{"verse":10,"text":"さて、ダマスコにアナニヤというひとりの弟子,でしがいた。この人,ひとに主,しゅが幻,まぼろしの中,なかに現,あらわれて、「アナニヤよ」とお呼,よびになった。彼,かれは「主,しゅよ、わたしでございます」と答,こたえた。","tok":[["さて"],["、"],["ダマスコ"],["に"],["アナニヤ"],["と"],["いう"],["ひとり"],["の"],["弟子","でし"],["が"],["いた"],["。"],["この"],["人","ひと"],["に"],["主","しゅ"],["が"],["幻","まぼろし"],["の"],["中","なか"],["に"],["現われて","あらわれて"],["、"],["「"],["アナニヤ"],["よ"],["」"],["と"],["お呼び","および"],["に"],["なった"],["。"],["彼","かれ"],["は"],["「"],["主","しゅ"],["よ"],["、"],["わたし"],["で"],["ございます"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":11,"text":"そこで主,しゅが彼,かれに言,いわれた、「立,たって、『真,ますぐ』という名,なの路地,ろじに行,いき、ユダの家,いえでサウロというタルソ人,びとを尋,たずねなさい。彼,かれはいま祈,いのっている。","tok":[["そこ"],["で"],["主","しゅ"],["が"],["彼","かれ"],["に"],["言われた","いわれた"],["、"],["「"],["立って","たって"],["、"],["『"],["真","ま"],["すぐ"],["』"],["と"],["いう"],["名","な"],["の"],["路地","ろじ"],["に"],["行き","いき"],["、"],["ユダ"],["の"],["家","いえ"],["で"],["サウロ"],["と"],["いう"],["タルソ人","たるそびと"],["を"],["尋ね","たずね"],["なさい"],["。"],["彼","かれ"],["は"],["いま"],["祈って","いのって"],["いる"],["。"]]},{"verse":12,"text":"彼,かれはアナニヤという人,ひとがはいってきて、手,てを自分,じぶんの上,うえにおいて再,ふたたび見,みえるようにしてくれるのを、幻,まぼろしで見,みたのである」。","tok":[["彼","かれ"],["は"],["アナニヤ"],["と"],["いう"],["人","ひと"],["が"],["はいって"],["きて"],["、"],["手","て"],["を"],["自分","じぶん"],["の"],["上","うえ"],["に"],["おいて"],["再び","ふたたび"],["見える","みえる"],["よう"],["に"],["して"],["くれる"],["の"],["を"],["、"],["幻","まぼろし"],["で"],["見た","みた"],["ので"],["ある"],["」"],["。"]]},{"verse":13,"text":"アナニヤは答,こたえた、「主,しゅよ、あの人,ひとがエルサレムで、どんなにひどい事,ことをあなたの聖徒,せいとたちにしたかについては、多,おおくの人,ひとたちから聞,きいています。","tok":[["アナニヤ"],["は"],["答","こたえ"],["た"],["、"],["「"],["主","しゅ"],["よ"],["、"],["あの"],["人","ひと"],["が"],["エルサレム"],["で"],["、"],["どんな"],["に"],["ひどい"],["事","こと"],["を"],["あなた"],["の"],["聖徒","せいと"],["たち"],["に"],["した"],["か"],["について"],["は"],["、"],["多く","おおく"],["の"],["人","ひと"],["たち"],["から"],["聞いて","きいて"],["います"],["。"]]},{"verse":14,"text":"そして彼,かれはここでも、御名,みなをとなえる者,ものたちをみな捕縛,ほばくする権,けんを、祭司長,さいしちょうたちから得,えてきているのです」。","tok":[["そして"],["彼","かれ"],["は"],["ここ"],["で"],["も"],["、"],["御名","みな"],["を"],["となえる"],["者","もの"],["たち"],["を"],["みな"],["捕縛","ほばく"],["する"],["権","けん"],["を"],["、"],["祭司長","さいしちょう"],["たち"],["から"],["得て","えて"],["きて"],["いる"],["の"],["です"],["」"],["。"]]},{"verse":15,"text":"しかし、主,しゅは仰,おおせになった、「さあ、行,いきなさい。あの人,ひとは、異邦人,いほうじんたち、王,おうたち、またイスラエルの子,こらにも、わたしの名,なを伝,つたえる器,うつわとして、わたしが選,えらんだ者,ものである。","tok":[["しかし"],["、"],["主","しゅ"],["は"],["仰せ","おおせ"],["に"],["なった"],["、"],["「"],["さあ"],["、"],["行き","いき"],["なさい"],["。"],["あの"],["人","ひと"],["は"],["、"],["異邦人","いほうじん"],["たち"],["、"],["王","おう"],["たち"],["、"],["また"],["イスラエル"],["の"],["子","こ"],["ら"],["に"],["も"],["、"],["わたし"],["の"],["名","な"],["を"],["伝える","つたえる"],["器","うつわ"],["として"],["、"],["わたし"],["が"],["選らんだ","えらんだ"],["者","もの"],["で"],["ある"],["。"]]},{"verse":16,"text":"わたしの名,なのために彼,かれがどんなに苦,くるしまなければならないかを、彼,かれに知,しらせよう」。","tok":[["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["彼","かれ"],["が"],["どんな"],["に"],["苦しまなければ","くるしまなければ"],["ならない"],["か"],["を"],["、"],["彼","かれ"],["に"],["知らせよう","しらせよう"],["」"],["。"]]},{"verse":17,"text":"そこでアナニヤは、出,でかけて行,いってその家,いえにはいり、手,てをサウロの上,うえにおいて言,いった、「兄弟,きょうだいサウロよ、あなたが来,くる途中,とちゅうで現,あらわれた主,しゅイエスは、あなたが再,ふたたび見,みえるようになるため、そして聖霊,せいれいに満,みたされるために、わたしをここにおつかわしになったのです」。","tok":[["そこ"],["で"],["アナニヤ"],["は"],["、"],["出かけて","でかけて"],["行って","いって"],["その"],["家","いえ"],["に"],["はいり"],["、"],["手","て"],["を"],["サウロ"],["の"],["上","うえ"],["に"],["おいて"],["言った","いった"],["、"],["「"],["兄弟","きょうだい"],["サウロ"],["よ"],["、"],["あなた"],["が"],["来る","くる"],["途中","とちゅう"],["で"],["現われた","あらわれた"],["主","しゅ"],["イエス"],["は"],["、"],["あなた"],["が"],["再び","ふたたび"],["見える","みえる"],["よう"],["に"],["なる"],["ため"],["、"],["そして"],["聖霊","せいれい"],["に"],["満たされる","みたされる"],["ため"],["に"],["、"],["わたし"],["を"],["ここ"],["に"],["おつかわし"],["に"],["なった"],["の"],["です"],["」"],["。"]]},{"verse":18,"text":"するとたちどころに、サウロの目,めから、うろこのようなものが落,おちて、元,もとどおり見,みえるようになった。そこで彼,かれは立,たってバプテスマを受,うけ、","tok":[["する"],["と"],["たちどころ"],["に"],["、"],["サウロ"],["の"],["目","め"],["から"],["、"],["うろこ"],["の"],["よう"],["な"],["もの"],["が"],["落","おち"],["て"],["、"],["元どおり","もとどおり"],["見える","みえる"],["よう"],["に"],["なった"],["。"],["そこ"],["で"],["彼","かれ"],["は"],["立って","たって"],["バプテスマ"],["を"],["受け","うけ"],["、"]]},{"verse":19,"text":"また食事,しょくじをとって元気,げんきを取,とりもどした。サウロは、ダマスコにいる弟子,でしたちと共,ともに数日間,すうじつかんを過,すごしてから、","tok":[["また"],["食事","しょくじ"],["を"],["とって"],["元気","げんき"],["を"],["取","とり"],["もどした"],["。"],["サウロ"],["は"],["、"],["ダマスコ"],["に"],["いる"],["弟子","でし"],["たち"],["と"],["共","とも"],["に"],["数日間","すうじつかん"],["を"],["過ごして","すごして"],["から"],["、"]]},{"verse":20,"text":"ただちに諸,しょ会堂,かいどうでイエスのことを宣,のべ伝,つたえ、このイエスこそ神,かみの子,こであると説,ときはじめた。","tok":[["ただちに"],["諸","しょ"],["会堂","かいどう"],["で"],["イエス"],["の"],["こと"],["を"],["宣べ伝え","のべつたえ"],["、"],["この"],["イエス"],["こそ"],["神","かみ"],["の"],["子","こ"],["で"],["ある"],["と"],["説き","とき"],["はじめた"],["。"]]},{"verse":21,"text":"これを聞,きいた人,ひとたちはみな非常,ひじょうに驚,おどろいて言,いった、「あれは、エルサレムでこの名,なをとなえる者,ものたちを苦,くるしめた男,おとこではないか。その上,うえここにやってきたのも、彼,かれらを縛,しばりあげて、祭司長,さいしちょうたちのところへひっぱって行,いくためではなかったか」。","tok":[["これ"],["を"],["聞いた","きいた"],["人","ひと"],["たち"],["は"],["みな"],["非常","ひじょう"],["に"],["驚ろいて","おどろいて"],["言った","いった"],["、"],["「"],["あれ"],["は"],["、"],["エルサレム"],["で"],["この"],["名","な"],["を"],["となえる"],["者","もの"],["たち"],["を"],["苦しめた","くるしめた"],["男","おとこ"],["で"],["は"],["ない"],["か"],["。"],["その"],["上","うえ"],["ここ"],["に"],["やって"],["きた"],["の"],["も"],["、"],["彼","かれ"],["ら"],["を"],["縛りあげて","しばりあげて"],["、"],["祭司長","さいしちょう"],["たち"],["の"],["ところ"],["へ"],["ひっぱって"],["行く","いく"],["ため"],["で"],["は"],["なかった"],["か"],["」"],["。"]]},{"verse":22,"text":"しかし、サウロはますます力,ちからが加,くわわり、このイエスがキリストであることを論証,ろんしょうして、ダマスコに住,すむユダヤ人,じんたちを言,いい伏,ふせた。","tok":[["しかし"],["、"],["サウロ"],["は"],["ますます"],["力","ちから"],["が"],["加わわり","くわわり"],["、"],["この"],["イエス"],["が"],["キリスト"],["で"],["ある"],["こと"],["を"],["論証","ろんしょう"],["して"],["、"],["ダマスコ"],["に"],["住む","すむ"],["ユダヤ人","ゆだやじん"],["たち"],["を"],["言い伏せた","いいふせた"],["。"]]},{"verse":23,"text":"相当,そうとうの日数,にっすうがたったころ、ユダヤ人,じんたちはサウロを殺,ころす相談,そうだんをした。","tok":[["相当","そうとう"],["の"],["日数","にっすう"],["が"],["たった"],["ころ"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["サウロ"],["を"],["殺ろす","ころす"],["相談","そうだん"],["を"],["した"],["。"]]},{"verse":24,"text":"ところが、その陰謀,いんぼうが彼,かれの知,しるところとなった。彼,かれらはサウロを殺,ころそうとして、夜昼,よるひる、町,まちの門,もんを見守,みまもっていたのである。","tok":[["ところ"],["が"],["、"],["その"],["陰謀","いんぼう"],["が"],["彼","かれ"],["の"],["知る","しる"],["ところ"],["と"],["なった"],["。"],["彼","かれ"],["ら"],["は"],["サウロ"],["を"],["殺そう","ころそう"],["として"],["、"],["夜","よる"],["昼","ひる"],["、"],["町","まち"],["の"],["門","もん"],["を"],["見守って","みまもって"],["いた"],["ので"],["ある"],["。"]]},{"verse":25,"text":"そこで彼,かれの弟子,でしたちが、夜,よるの間,あいだに彼,かれをかごに乗,のせて、町,まちの城壁,じょうへきづたいにつりおろした。","tok":[["そこ"],["で"],["彼","かれ"],["の"],["弟子","でし"],["たち"],["が"],["、"],["夜","よる"],["の"],["間","あいだ"],["に"],["彼","かれ"],["を"],["かご"],["に"],["乗せて","のせて"],["、"],["町","まち"],["の"],["城壁","じょうへき"],["づたい"],["に"],["つりおろした"],["。"]]},{"verse":26,"text":"サウロはエルサレムに着,ついて、弟子,でしたちの仲間,なかまに加,くわわろうと努,つとめたが、みんなの者,ものは彼,かれを弟子,でしだとは信,しんじないで、恐,おそれていた。","tok":[["サウロ"],["は"],["エルサレム"],["に"],["着いて","ついて"],["、"],["弟子","でし"],["たち"],["の"],["仲間","なかま"],["に"],["加わわろう","くわわろう"],["と"],["努めた","つとめた"],["が"],["、"],["みんな"],["の"],["者","もの"],["は"],["彼","かれ"],["を"],["弟子","でし"],["だ"],["と"],["は"],["信じないで","しんじないで"],["、"],["恐れて","おそれて"],["いた"],["。"]]},{"verse":27,"text":"ところが、バルナバは彼,かれの世話,せわをして使徒,しとたちのところへ連,つれて行,いき、途中,とちゅうで主,しゅが彼,かれに現,あらわれて語,かたりかけたことや、彼,かれがダマスコでイエスの名,なで大胆,だいたんに宣,のべ伝,つたえた次第,しだいを、彼,かれらに説明,せつめいして聞,きかせた。","tok":[["ところ"],["が"],["、"],["バルナバ"],["は"],["彼","かれ"],["の"],["世話","せわ"],["を"],["して"],["使徒","しと"],["たち"],["の"],["ところ"],["へ"],["連れて","つれて"],["行き","いき"],["、"],["途中","とちゅう"],["で"],["主","しゅ"],["が"],["彼","かれ"],["に"],["現われて","あらわれて"],["語りかけた","かたりかけた"],["こと"],["や"],["、"],["彼","かれ"],["が"],["ダマスコ"],["で"],["イエス"],["の"],["名","な"],["で"],["大胆","だいたん"],["に"],["宣べ伝えた","のべつたえた"],["次第","しだい"],["を"],["、"],["彼","かれ"],["ら"],["に"],["説明","せつめい"],["して"],["聞かせた","きかせた"],["。"]]},{"verse":28,"text":"それ以来,いらい、彼,かれは使徒,しとたちの仲間,なかまに加,くわわり、エルサレムに出入,でいりし、主,しゅの名,なによって大胆,だいたんに語,かたり、","tok":[["それ"],["以来","いらい"],["、"],["彼","かれ"],["は"],["使徒","しと"],["たち"],["の"],["仲間","なかま"],["に"],["加わわり","くわわり"],["、"],["エルサレム"],["に"],["出入","でいり"],["し"],["、"],["主","しゅ"],["の"],["名","な"],["によって"],["大胆","だいたん"],["に"],["語り","かたり"],["、"]]},{"verse":29,"text":"ギリシヤ語,ごを使,つかうユダヤ人,じんたちとしばしば語,かたり合,あい、また論,ろんじ合,あった。しかし、彼,かれらは彼,かれを殺,ころそうとねらっていた。","tok":[["ギリシヤ"],["語","ご"],["を"],["使う","つかう"],["ユダヤ人","ゆだやじん"],["たち"],["と"],["しばしば"],["語り合い","かたりあい"],["、"],["また"],["論じ合った","ろんじあった"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["彼","かれ"],["を"],["殺そう","ころそう"],["と"],["ねらって"],["いた"],["。"]]},{"verse":30,"text":"兄弟,きょうだいたちはそれと知,しって、彼,かれをカイザリヤに連,つれてくだり、タルソへ送,おくり出,だした。","tok":[["兄弟","きょうだい"],["たち"],["は"],["それ"],["と"],["知って","しって"],["、"],["彼","かれ"],["を"],["カイザリヤ"],["に"],["連れて","つれて"],["くだり"],["、"],["タルソ"],["へ"],["送り出した","おくりだした"],["。"]]},{"verse":31,"text":"こうして教会,きょうかいは、ユダヤ、ガリラヤ、サマリヤ全,ぜん地方,ちほうにわたって平安,へいあんを保,たもち、基礎,きそがかたまり、主,しゅをおそれ聖霊,せいれいにはげまされて歩,あゆみ、次第,しだいに信徒,しんとの数,かずを増,まして行,いった。","tok":[["こう"],["して"],["教会","きょうかい"],["は"],["、"],["ユダヤ"],["、"],["ガリラヤ"],["、"],["サマリヤ"],["全","ぜん"],["地方","ちほう"],["に"],["わたって"],["平安","へいあん"],["を"],["保ち","たもち"],["、"],["基礎","きそ"],["が"],["かたまり"],["、"],["主","しゅ"],["を"],["おそれ"],["聖霊","せいれい"],["に"],["はげまされて"],["歩","あゆみ"],["、"],["次第","しだい"],["に"],["信徒","しんと"],["の"],["数","かず"],["を"],["増して","まして"],["行った","いった"],["。"]]},{"verse":32,"text":"ペテロは方々,ほうぼうをめぐり歩,あるいたが、ルダに住,すむ聖徒,せいとたちのところへも下,くだって行,いった。","tok":[["ペテロ"],["は"],["方々","ほうぼう"],["を"],["めぐり歩いた","めぐりあるいた"],["が"],["、"],["ルダ"],["に"],["住む","すむ"],["聖徒","せいと"],["たち"],["の"],["ところ"],["へ"],["も"],["下って","くだって"],["行った","いった"],["。"]]},{"verse":33,"text":"そして、そこで、八年間,ねんかんも床,とこについているアイネヤという人,ひとに会,あった。この人,ひとは中風,ちゅうぶであった。","tok":[["そして"],["、"],["そこ"],["で"],["、"],["八","はち"],["年間","ねんかん"],["も"],["床","とこ"],["について"],["いる"],["アイネヤ"],["と"],["いう"],["人","ひと"],["に"],["会った","あった"],["。"],["この"],["人","ひと"],["は"],["中風","ちゅうぶ"],["で"],["あった"],["。"]]},{"verse":34,"text":"ペテロが彼,かれに言,いった、「アイネヤよ、イエス・キリストがあなたをいやして下,くださるのだ。起,おきなさい。そして床,とこを取,とりあげなさい」。すると、彼,かれはただちに起,おきあがった。","tok":[["ペテロ"],["が"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["アイネヤ"],["よ"],["、"],["イエス"],["・"],["キリスト"],["が"],["あなた"],["を"],["いやして"],["下さる","くださる"],["の"],["だ"],["。"],["起き","おき"],["なさい"],["。"],["そして"],["床","とこ"],["を"],["取","とり"],["あげ"],["なさい"],["」"],["。"],["する"],["と"],["、"],["彼","かれ"],["は"],["ただちに"],["起きあがった","おきあがった"],["。"]]},{"verse":35,"text":"ルダとサロンに住,すむ人,ひとたちは、みなそれを見,みて、主,しゅに帰依,きえした。","tok":[["ルダ"],["と"],["サロン"],["に"],["住む","すむ"],["人","ひと"],["たち"],["は"],["、"],["みな"],["それ"],["を"],["見て","みて"],["、"],["主に","しゅに"],["帰依","きえ"],["した"],["。"]]},{"verse":36,"text":"ヨッパにタビタ（これを訳,やくすと、ドルカス、すなわち、かもしか）という女,おんな弟子,でしがいた。数々,かずかずのよい働,はたらきや施,ほどこしをしていた婦人,ふじんであった。","tok":[["ヨッパ"],["に"],["タビタ"],["（"],["これ"],["を"],["訳す","やくす"],["と"],["、"],["ドルカス"],["、"],["すなわち"],["、"],["かもしか"],["）"],["と"],["いう"],["女","おんな"],["弟子","でし"],["が"],["いた"],["。"],["数々","かずかず"],["の"],["よい"],["働らき","はたらき"],["や"],["施し","ほどこし"],["を"],["して"],["いた"],["婦人","ふじん"],["で"],["あった"],["。"]]},{"verse":37,"text":"ところが、そのころ病気,びょうきになって死,しんだので、人々,ひとびとはそのからだを洗,あらって、屋上,おくじょうの間,まに安置,あんちした。","tok":[["ところ"],["が"],["、"],["その"],["ころ"],["病気","びょうき"],["に"],["なって"],["死んだ","しんだ"],["ので"],["、"],["人々","ひとびと"],["は"],["その"],["からだ"],["を"],["洗って","あらって"],["、"],["屋上","おくじょう"],["の"],["間","ま"],["に"],["安置","あんち"],["した"],["。"]]},{"verse":38,"text":"ルダはヨッパに近,ちかかったので、弟子,でしたちはペテロがルダにきていると聞,きき、ふたりの者,ものを彼,かれのもとにやって、「どうぞ、早,はやくこちらにおいで下,ください」と頼,たのんだ。","tok":[["ルダ"],["は"],["ヨッパ"],["に"],["近かった","ちかかった"],["ので"],["、"],["弟子","でし"],["たち"],["は"],["ペテロ"],["が"],["ルダ"],["に"],["きて"],["いる"],["と"],["聞","きき"],["、"],["ふたり"],["の"],["者","もの"],["を"],["彼","かれ"],["の"],["もと"],["に"],["やって"],["、"],["「"],["どうぞ"],["、"],["早く","はやく"],["こちら"],["に"],["おいで"],["下さい","ください"],["」"],["と"],["頼んだ","たのんだ"],["。"]]},{"verse":39,"text":"そこでペテロは立,たって、ふたりの者,ものに連,つれられてきた。彼,かれが着,つくとすぐ、屋上,おくじょうの間,まに案内,あんないされた。すると、やもめたちがみんな彼,かれのそばに寄,よってきて、ドルカスが生前,せいぜんつくった下着,したぎや上着,うわぎの数々,かずかずを、泣,なきながら見,みせるのであった。","tok":[["そこ"],["で"],["ペテロ"],["は"],["立って","たって"],["、"],["ふたり"],["の"],["者","もの"],["に"],["連れられて","つれられて"],["きた"],["。"],["彼","かれ"],["が"],["着く","つく"],["と"],["すぐ"],["、"],["屋上","おくじょう"],["の"],["間","ま"],["に"],["案内","あんない"],["された"],["。"],["する"],["と"],["、"],["やもめ"],["たち"],["が"],["みんな"],["彼","かれ"],["の"],["そば"],["に"],["寄って","よって"],["きて"],["、"],["ドルカス"],["が"],["生前","せいぜん"],["つくった"],["下着","したぎ"],["や"],["上着","うわぎ"],["の"],["数々","かずかず"],["を"],["、"],["泣","なき"],["ながら"],["見せる","みせる"],["ので"],["あった"],["。"]]},{"verse":40,"text":"ペテロはみんなの者,ものを外,そとに出,だし、ひざまずいて祈,いのった。それから死体,したいの方,ほうに向,むいて、「タビタよ、起,おきなさい」と言,いった。すると彼女,かのじょは目,めをあけ、ペテロを見,みて起,おきなおった。","tok":[["ペテロ"],["は"],["みんな"],["の"],["者","もの"],["を"],["外","そと"],["に"],["出し","だし"],["、"],["ひざまずいて"],["祈った","いのった"],["。"],["それ"],["から"],["死体","したい"],["の"],["方","ほう"],["に"],["向いて","むいて"],["、"],["「"],["タビタ"],["よ"],["、"],["起き","おき"],["なさい"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["彼女","かのじょ"],["は"],["目","め"],["を"],["あけ"],["、"],["ペテロ"],["を"],["見て","みて"],["起きなおった","おきなおった"],["。"]]},{"verse":41,"text":"ペテロは彼女,かのじょに手,てをかして立,たたせた。それから、聖徒,せいとたちや、やもめたちを呼,よび入,いれて、彼女,かのじょが生,いきかえっているのを見,みせた。","tok":[["ペテロ"],["は"],["彼女","かのじょ"],["に"],["手","て"],["を"],["かして"],["立たせた","たたせた"],["。"],["それ"],["から"],["、"],["聖徒","せいと"],["たち"],["や"],["、"],["やもめ"],["たち"],["を"],["呼び入れて","よびいれて"],["、"],["彼女","かのじょ"],["が"],["生きかえって","いきかえって"],["いる"],["の"],["を"],["見せた","みせた"],["。"]]},{"verse":42,"text":"このことがヨッパ中,ちゅうに知,しれわたり、多,おおくの人々,ひとびとが主,しゅを信,しんじた。","tok":[["この"],["こと"],["が"],["ヨッパ中","よっぱちゅう"],["に"],["知れわたり","しれわたり"],["、"],["多く","おおく"],["の"],["人々","ひとびと"],["が"],["主","しゅ"],["を"],["信じた","しんじた"],["。"]]},{"verse":43,"text":"ペテロは、皮,かわなめしシモンという人,ひとの家,いえに泊,とまり、しばらくの間,あいだヨッパに滞在,たいざいした。","tok":[["ペテロ"],["は"],["、"],["皮","かわ"],["なめし"],["シモン"],["と"],["いう"],["人","ひと"],["の"],["家","いえ"],["に"],["泊まり","とまり"],["、"],["しばらく"],["の"],["間","あいだ"],["ヨッパ"],["に"],["滞在","たいざい"],["した"],["。"]]}]
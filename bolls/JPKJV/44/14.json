[{"verse":1,"text":"ふたりは、イコニオムでも同,おなじようにユダヤ人,じんの会堂,かいどうにはいって語,かたった結果,けっか、ユダヤ人,じんやギリシヤ人,じんが大,おおぜい信,しんじた。","tok":[["ふたり"],["は"],["、"],["イコニオム"],["で"],["も"],["同じ","おなじ"],["よう"],["に"],["ユダヤ人","ゆだやじん"],["の"],["会堂","かいどう"],["に"],["はいって"],["語った","かたった"],["結果","けっか"],["、"],["ユダヤ人","ゆだやじん"],["や"],["ギリシヤ"],["人","じん"],["が"],["大ぜい","おおぜい"],["信じた","しんじた"],["。"]]},{"verse":2,"text":"ところが、信,しんじなかったユダヤ人,じんたちは異邦人,いほうじんたちをそそのかして、兄弟,きょうだいたちに対,たいして悪意,あくいをいだかせた。","tok":[["ところ"],["が"],["、"],["信じなかった","しんじなかった"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["異邦人","いほうじん"],["たち"],["を"],["そそのかして"],["、"],["兄弟","きょうだい"],["たち"],["に対して","にたいして"],["悪意","あくい"],["を"],["いだかせた"],["。"]]},{"verse":3,"text":"それにもかかわらず、ふたりは長,ながい期間,きかんをそこで過,すごして、大胆,だいたんに主,しゅのことを語,かたった。主,しゅは、彼,かれらの手,てによってしるしと奇跡,きせきとを行,おこなわせ、そのめぐみの言葉,ことばをあかしされた。","tok":[["それ"],["に"],["も"],["かかわらず"],["、"],["ふたり"],["は"],["長い","ながい"],["期間","きかん"],["を"],["そこ"],["で"],["過ごして","すごして"],["、"],["大胆","だいたん"],["に"],["主","しゅ"],["の"],["こと"],["を"],["語った","かたった"],["。"],["主","しゅ"],["は"],["、"],["彼","かれ"],["ら"],["の"],["手","て"],["によって"],["しるし"],["と"],["奇跡","きせき"],["と"],["を"],["行なわせ","おこなわせ"],["、"],["その"],["めぐみ"],["の"],["言葉","ことば"],["を"],["あかし"],["された"],["。"]]},{"verse":4,"text":"そこで町,まちの人々,ひとびとが二派,はに分,わかれ、ある人,ひとたちはユダヤ人,じんの側,がわにつき、ある人,ひとたちは使徒,しとの側,がわについた。","tok":[["そこ"],["で"],["町","まち"],["の"],["人々","ひとびと"],["が"],["二派","は"],["に"],["分かれ","わかれ"],["、"],["ある"],["人","ひと"],["たち"],["は"],["ユダヤ人","ゆだやじん"],["の"],["側","がわ"],["に"],["つき"],["、"],["ある"],["人","ひと"],["たち"],["は"],["使徒","しと"],["の"],["側","がわ"],["に"],["ついた"],["。"]]},{"verse":5,"text":"その時,とき、異邦人,いほうじんやユダヤ人,じんが役人,やくにんたちと一緒,いっしょになって反対,はんたい運動,うんどうを起,おこし、使徒,しとたちをはずかしめ、石,いしで打,うとうとしたので、","tok":[["その"],["時","とき"],["、"],["異邦人","いほうじん"],["や"],["ユダヤ人","ゆだやじん"],["が"],["役人","やくにん"],["たち"],["と"],["一緒","いっしょ"],["に"],["なって"],["反対","はんたい"],["運動","うんどう"],["を"],["起こし","おこし"],["、"],["使徒","しと"],["たち"],["を"],["はずかしめ"],["、"],["石","いし"],["で"],["打とう","うとう"],["と"],["した"],["ので"],["、"]]},{"verse":6,"text":"ふたりはそれと気,きづいて、ルカオニヤの町々,まちまち、ルステラ、デルベおよびその附近,ふきんの地,ちへのがれ、","tok":[["ふたり"],["は"],["それ"],["と"],["気づいて","きづいて"],["、"],["ルカオニヤ"],["の"],["町々","まちまち"],["、"],["ルステラ"],["、"],["デルベ"],["および"],["その"],["附近","ふきん"],["の"],["地","ち"],["へ"],["のがれ"],["、"]]},{"verse":7,"text":"そこで引,ひきつづき福音,ふくいんを伝,つたえた。","tok":[["そこ"],["で"],["引","ひき"],["つづき"],["福音","ふくいん"],["を"],["伝えた","つたえた"],["。"]]},{"verse":8,"text":"ところが、ルステラに足,あしのきかない人,ひとが、すわっていた。彼,かれは生,うまれながらの足,あしなえで、歩,あるいた経験,けいけんが全,まったくなかった。","tok":[["ところ"],["が"],["、"],["ルステラ"],["に"],["足","あし"],["の"],["きかない"],["人","ひと"],["が"],["、"],["すわって"],["いた"],["。"],["彼","かれ"],["は"],["生まれ","うまれ"],["ながら"],["の"],["足","あし"],["な"],["え"],["で"],["、"],["歩いた","あるいた"],["経験","けいけん"],["が"],["全く","まったく"],["なかった"],["。"]]},{"verse":9,"text":"この人,ひとがパウロの語,かたるのを聞,きいていたが、パウロは彼,かれをじっと見,みて、いやされるほどの信仰,しんこうが彼,かれにあるのを認,みとめ、","tok":[["この"],["人","ひと"],["が"],["パウロ"],["の"],["語る","かたる"],["の"],["を"],["聞いて","きいて"],["いた"],["が"],["、"],["パウロ"],["は"],["彼","かれ"],["を"],["じっと"],["見て","みて"],["、"],["いや"],["される"],["ほど"],["の"],["信仰","しんこう"],["が"],["彼","かれ"],["に"],["ある"],["の"],["を"],["認め","みとめ"],["、"]]},{"verse":10,"text":"大声,おおごえで「自分,じぶんの足,あしで、まっすぐに立,たちなさい」と言,いった。すると彼,かれは踊,おどり上,あがって歩,あるき出,だした。","tok":[["大声","おおごえ"],["で"],["「"],["自分","じぶん"],["の"],["足","あし"],["で"],["、"],["まっすぐ"],["に"],["立","たち"],["なさい"],["」"],["と"],["言った","いった"],["。"],["する"],["と"],["彼","かれ"],["は"],["踊","おどり"],["上がって","あがって"],["歩き","あるき"],["出した","だした"],["。"]]},{"verse":11,"text":"群衆,ぐんしゅうはパウロのしたことを見,みて、声,こえを張,はりあげ、ルカオニヤの地方,ちほう語,ごで、「神々,かみがみが人間,にんげんの姿,すがたをとって、わたしたちのところにお下,くだりになったのだ」と叫,さけんだ。","tok":[["群衆","ぐんしゅう"],["は"],["パウロ"],["の"],["した"],["こと"],["を"],["見て","みて"],["、"],["声","こえ"],["を"],["張りあげ","はりあげ"],["、"],["ルカオニヤ"],["の"],["地方","ちほう"],["語","ご"],["で"],["、"],["「"],["神々","かみがみ"],["が"],["人間","にんげん"],["の"],["姿","すがた"],["を"],["とって"],["、"],["わたしたち"],["の"],["ところ"],["に"],["お下り","おくだり"],["に"],["なった"],["の"],["だ"],["」"],["と"],["叫けんだ","さけんだ"],["。"]]},{"verse":12,"text":"彼,かれらはバルナバをゼウスと呼,よび、パウロはおもに語,かたる人,ひとなので、彼,かれをヘルメスと呼,よんだ。","tok":[["彼","かれ"],["ら"],["は"],["バルナバ"],["を"],["ゼウス"],["と"],["呼び","よび"],["、"],["パウロ"],["は"],["おもに"],["語る","かたる"],["人","ひと"],["な"],["ので"],["、"],["彼","かれ"],["を"],["ヘルメス"],["と"],["呼んだ","よんだ"],["。"]]},{"verse":13,"text":"そして、郊外,こうがいにあるゼウス神殿,しんでんの祭司,さいしが、群衆,ぐんしゅうと共,ともに、ふたりに犠牲,ぎせいをささげようと思,おもって、雄,お牛,うし数頭,すうとうと花輪,はなわとを門前,もんぜんに持,もってきた。","tok":[["そして"],["、"],["郊外","こうがい"],["に"],["ある"],["ゼウス"],["神殿","しんでん"],["の"],["祭司","さいし"],["が"],["、"],["群衆","ぐんしゅう"],["と"],["共","とも"],["に"],["、"],["ふたり"],["に"],["犠牲","ぎせい"],["を"],["ささげよう"],["と"],["思って","おもって"],["、"],["雄牛","おうし"],["数頭","すうとう"],["と"],["花輪","はなわ"],["と"],["を"],["門前","もんぜん"],["に"],["持って","もって"],["きた"],["。"]]},{"verse":14,"text":"ふたりの使徒,しとバルナバとパウロとは、これを聞,きいて自分,じぶんの上着,うわぎを引,ひき裂,さき、群衆,ぐんしゅうの中,なかに飛,とび込,こんで行,いき、叫,さけんで","tok":[["ふたり"],["の"],["使徒","しと"],["バルナバ"],["と"],["パウロ"],["と"],["は"],["、"],["これ"],["を"],["聞いて","きいて"],["自分","じぶん"],["の"],["上着","うわぎ"],["を"],["引裂き","ひきさき"],["、"],["群衆","ぐんしゅう"],["の"],["中","なか"],["に"],["飛び込んで","とびこんで"],["行き","いき"],["、"],["叫けんで","さけんで"]]},{"verse":15,"text":"言,いった、「皆,みなさん、なぜこんな事,ことをするのか。わたしたちとても、あなたがたと同,おなじような人間,にんげんである。そして、あなたがたがこのような愚,ぐにもつかぬものを捨,すてて、天,てんと地,ちと海,うみと、その中,なかのすべてのものをお造,つくりになった生,いける神,かみに立,たち帰,かえるようにと、福音,ふくいんを説,といているものである。","tok":[["言った","いった"],["、"],["「"],["皆","みな"],["さん"],["、"],["なぜ"],["こんな"],["事","こと"],["を"],["する"],["の"],["か"],["。"],["わたしたち"],["とても"],["、"],["あなた"],["がた"],["と"],["同じ","おなじ"],["よう"],["な"],["人間","にんげん"],["で"],["ある"],["。"],["そして"],["、"],["あなた"],["がた"],["が"],["この"],["よう"],["な"],["愚","ぐ"],["に"],["も"],["つかぬ"],["もの"],["を"],["捨てて","すてて"],["、"],["天","てん"],["と"],["地","ち"],["と"],["海","うみ"],["と"],["、"],["その"],["中","なか"],["の"],["すべて"],["の"],["もの"],["を"],["お造","おつくり"],["に"],["なった"],["生ける","いける"],["神","かみ"],["に"],["立ち","たち"],["帰える","かえる"],["よう"],["に"],["と"],["、"],["福音","ふくいん"],["を"],["説いて","といて"],["いる"],["もの"],["で"],["ある"],["。"]]},{"verse":16,"text":"神,かみは過,すぎ去,さった時代,じだいには、すべての国々,くにぐにの人,ひとが、それぞれの道,みちを行,いくままにしておかれたが、","tok":[["神","かみ"],["は"],["過去","すぎさっ"],["た"],["時代","じだい"],["に"],["は"],["、"],["すべて"],["の"],["国々","くにぐに"],["の"],["人","ひと"],["が"],["、"],["それぞれ"],["の"],["道","みち"],["を"],["行く","いく"],["まま"],["に"],["して"],["おかれた"],["が"],["、"]]},{"verse":17,"text":"それでも、ご自分,じぶんのことをあかししないでおられたわけではない。すなわち、あなたがたのために天,てんから雨,あめを降,ふらせ、実,みのりの季節,きせつを与,あたえ、食物,しょくもつと喜,よろこびとで、あなたがたの心,こころを満,みたすなど、いろいろのめぐみをお与,あたえになっているのである」。","tok":[["それ"],["で"],["も"],["、"],["ご自分","ごじぶん"],["の"],["こと"],["を"],["あかし"],["しないで"],["おられた"],["わけ"],["で"],["は"],["ない"],["。"],["すなわち"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["天","てん"],["から"],["雨","あめ"],["を"],["降らせ","ふらせ"],["、"],["実り","みのり"],["の"],["季節","きせつ"],["を"],["与","あたえ"],["、"],["食物","しょくもつ"],["と"],["喜こび","よろこび"],["と"],["で"],["、"],["あなた"],["がた"],["の"],["心","こころ"],["を"],["満たす","みたす"],["など"],["、"],["いろいろ"],["の"],["めぐみ"],["を"],["お"],["与","あたえ"],["に"],["なって"],["いる"],["ので"],["ある"],["」"],["。"]]},{"verse":18,"text":"こう言,いって、ふたりは、やっとのことで、群衆,ぐんしゅうが自分,じぶんたちに犠牲,ぎせいをささげるのを、思,おもい止,とどまらせた。","tok":[["こう"],["言って","いって"],["、"],["ふたり"],["は"],["、"],["やっと"],["の"],["こと"],["で"],["、"],["群衆","ぐんしゅう"],["が"],["自分","じぶん"],["たち"],["に"],["犠牲","ぎせい"],["を"],["ささげる"],["の"],["を"],["、"],["思い止どまらせた","おもいとどまらせた"],["。"]]},{"verse":19,"text":"ところが、あるユダヤ人,じんたちはアンテオケやイコニオムから押,おしかけてきて、群衆,ぐんしゅうを仲間,なかまに引,ひき入,いれたうえ、パウロを石,いしで打,うち、死,しんでしまったと思,おもって、彼,かれを町,まちの外,そとに引,ひきずり出,だした。","tok":[["ところ"],["が"],["、"],["ある"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["アンテオケ"],["や"],["イコニオム"],["から"],["押","おし"],["かけて"],["きて"],["、"],["群衆","ぐんしゅう"],["を"],["仲間","なかま"],["に"],["引入れた","ひきいれた"],["うえ"],["、"],["パウロ"],["を"],["石","いし"],["で"],["打ち","うち"],["、"],["死んで","しんで"],["しまった"],["と"],["思って","おもって"],["、"],["彼","かれ"],["を"],["町","まち"],["の"],["外","そと"],["に"],["引","ひき"],["ずり出した","ずりだした"],["。"]]},{"verse":20,"text":"しかし、弟子,でしたちがパウロを取,とり囲,かこんでいる間,あいだに、彼,かれは起,おきあがって町,まちにはいって行,いった。そして翌日,よくじつには、バルナバと一緒,いっしょにデルベにむかって出,でかけた。","tok":[["しかし"],["、"],["弟子","でし"],["たち"],["が"],["パウロ"],["を"],["取囲んで","とりかこんで"],["いる"],["間","あいだ"],["に"],["、"],["彼","かれ"],["は"],["起きあがって","おきあがって"],["町","まち"],["に"],["はいって"],["行った","いった"],["。"],["そして"],["翌日","よくじつ"],["に"],["は"],["、"],["バルナバ"],["と"],["一緒","いっしょ"],["に"],["デルベ"],["に"],["むかって"],["出かけた","でかけた"],["。"]]},{"verse":21,"text":"その町,まちで福音,ふくいんを伝,つたえて、大,おおぜいの人,ひとを弟子,でしとした後,のち、ルステラ、イコニオム、アンテオケの町々,まちまちに帰,かえって行,いき、","tok":[["その"],["町","まち"],["で"],["福音","ふくいん"],["を"],["伝えて","つたえて"],["、"],["大ぜい","おおぜい"],["の"],["人","ひと"],["を"],["弟子","でし"],["と"],["した"],["後","の"],["ち"],["、"],["ルステラ"],["、"],["イコニオム"],["、"],["アンテオケ"],["の"],["町々","まちまち"],["に"],["帰えって","かえって"],["行き","いき"],["、"]]},{"verse":22,"text":"弟子,でしたちを力,ちからづけ、信仰,しんこうを持,もちつづけるようにと奨励,しょうれいし、「わたしたちが神,かみの国,くににはいるのには、多,おおくの苦難,くなんを経,へなければならない」と語,かたった。","tok":[["弟子","でし"],["たち"],["を"],["力づけ","ちからづけ"],["、"],["信仰","しんこう"],["を"],["持ち","もち"],["つづける"],["よう"],["に"],["と"],["奨励","しょうれい"],["し"],["、"],["「"],["わたしたち"],["が"],["神","かみ"],["の"],["国","くに"],["に"],["は"],["いる"],["のに"],["は"],["、"],["多く","おおく"],["の"],["苦難","くなん"],["を"],["経なければ","へなければ"],["ならない"],["」"],["と"],["語った","かたった"],["。"]]},{"verse":23,"text":"また教会,きょうかいごとに彼,かれらのために長老,ちょうろうたちを任命,にんめいし、断食,だんじきをして祈,いのり、彼,かれらをその信,しんじている主,しゅにゆだねた。","tok":[["また"],["教会","きょうかい"],["ごと"],["に"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["長老","ちょうろう"],["たち"],["を"],["任命","にんめい"],["し"],["、"],["断食","だんじき"],["を"],["して"],["祈","いのり"],["、"],["彼","かれ"],["ら"],["を"],["その"],["信じて","しんじて"],["いる"],["主に","しゅに"],["ゆだねた"],["。"]]},{"verse":24,"text":"それから、ふたりはピシデヤを通過,つうかしてパンフリヤにきたが、","tok":[["それ"],["から"],["、"],["ふたり"],["は"],["ピシデヤ"],["を"],["通過","つうか"],["して"],["パンフリヤ"],["に"],["きた"],["が"],["、"]]},{"verse":25,"text":"ペルガで御言,みことばを語,かたった後,のち、アタリヤにくだり、","tok":[["ペルガ"],["で"],["御言","みこと"],["ば"],["を"],["語った","かたった"],["後","の"],["ち"],["、"],["アタリヤ"],["に"],["くだり"],["、"]]},{"verse":26,"text":"そこから舟,ふねでアンテオケに帰,かえった。彼,かれらが今,いまなし終,おわった働,はたらきのために、神,かみの祝福,しゅくふくを受,うけて送,おくり出,だされたのは、このアンテオケからであった。","tok":[["そこ"],["から"],["舟","ふね"],["で"],["アンテオケ"],["に"],["帰えった","かえった"],["。"],["彼","かれ"],["ら"],["が"],["今","いま"],["なし"],["終わった","おわった"],["働らき","はたらき"],["の"],["ため"],["に"],["、"],["神","かみ"],["の"],["祝福","しゅくふく"],["を"],["受て","うけて"],["送り出された","おくりだされた"],["の"],["は"],["、"],["この"],["アンテオケ"],["から"],["で"],["あった"],["。"]]},{"verse":27,"text":"彼,かれらは到着,とうちゃく早々,そうそう、教会,きょうかいの人々,ひとびとを呼,よび集,あつめて、神,かみが彼,かれらと共,ともにいてして下,くださった数々,かずかずのこと、また信仰,しんこうの門,もんを異邦人,いほうじんに開,ひらいて下,くださったことなどを、報告,ほうこくした。","tok":[["彼","かれ"],["ら"],["は"],["到着","とうちゃく"],["早々","そうそう"],["、"],["教会","きょうかい"],["の"],["人々","ひとびと"],["を"],["呼び集めて","よびあつめて"],["、"],["神","かみ"],["が"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["いて"],["して"],["下さった","くださった"],["数々","かずかず"],["の"],["こと"],["、"],["また"],["信仰","しんこう"],["の"],["門","もん"],["を"],["異邦人","いほうじん"],["に"],["開らいて","ひらいて"],["下さった","くださった"],["こと"],["など"],["を"],["、"],["報告","ほうこく"],["した"],["。"]]},{"verse":28,"text":"そして、ふたりはしばらくの間,あいだ、弟子,でしたちと一緒,いっしょに過,すごした。","tok":[["そして"],["、"],["ふたり"],["は"],["しばらく"],["の"],["間","あいだ"],["、"],["弟子","でし"],["たち"],["と"],["一緒","いっしょ"],["に"],["過ごした","すごした"],["。"]]}]
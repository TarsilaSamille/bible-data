[{"verse":1,"text":"さて、異邦人,いほうじんたちも神,かみの言,ことばを受,うけいれたということが、使徒,しとたちやユダヤにいる兄弟,きょうだいたちに聞,きこえてきた。","tok":[["さて"],["、"],["異邦人","いほうじん"],["たち"],["も"],["神","かみ"],["の"],["言","ことば"],["を"],["受","うけ"],["いれた"],["と"],["いう"],["こと"],["が"],["、"],["使徒","しと"],["たち"],["や"],["ユダヤ"],["に"],["いる"],["兄弟","きょうだい"],["たち"],["に"],["聞こえて","きこえて"],["きた"],["。"]]},{"verse":2,"text":"そこでペテロがエルサレムに上,のぼったとき、割礼,かつれいを重,おもんじる者,ものたちが彼,かれをとがめて言,いった、","tok":[["そこ"],["で"],["ペテロ"],["が"],["エルサレム"],["に"],["上った","のぼった"],["とき"],["、"],["割礼","かつれい"],["を"],["重じる","おもんじる"],["者","もの"],["たち"],["が"],["彼","かれ"],["を"],["とがめて"],["言った","いった"],["、"]]},{"verse":3,"text":"「あなたは、割礼,かつれいのない人,ひとたちのところに行,いって、食事,しょくじを共,ともにしたということだが」。","tok":[["「"],["あなた"],["は"],["、"],["割礼","かつれい"],["の"],["ない"],["人","ひと"],["たち"],["の"],["ところ"],["に"],["行って","いって"],["、"],["食事","しょくじ"],["を"],["共","とも"],["に"],["した"],["と"],["いう"],["こと"],["だ"],["が"],["」"],["。"]]},{"verse":4,"text":"そこでペテロは口,くちを開,ひらいて、順序,じゅんじょ正,ただしく説明,せつめいして言,いった、","tok":[["そこ"],["で"],["ペテロ"],["は"],["口","くち"],["を"],["開らいて","ひらいて"],["、"],["順序","じゅんじょ"],["正く","ただしく"],["説明","せつめい"],["して"],["言った","いった"],["、"]]},{"verse":5,"text":"「わたしがヨッパの町,まちで祈,いのっていると、夢心地,ゆめごこちになって幻,まぼろしを見,みた。大,おおきな布,ぬののような入,いれ物,ものが、四,よすみをつるされて、天,てんから降,おりてきて、わたしのところにとどいた。","tok":[["「"],["わたし"],["が"],["ヨッパ"],["の"],["町","まち"],["で"],["祈って","いのって"],["いる"],["と"],["、"],["夢心地","ゆめごこち"],["に"],["なって"],["幻","まぼろし"],["を"],["見た","みた"],["。"],["大きな","おおきな"],["布","ぬの"],["の"],["よう"],["な"],["入れ物","いれもの"],["が"],["、"],["四","よすみ"],["を"],["つるされて"],["、"],["天","てん"],["から"],["降りて","おりて"],["きて"],["、"],["わたし"],["の"],["ところ"],["に"],["とどいた"],["。"]]},{"verse":6,"text":"注意,ちゅういして見,みつめていると、地上,ちじょうの四つ足,あし、野,のの獣,けもの、這,はうもの、空,そらの鳥,とりなどが、はいっていた。","tok":[["注意","ちゅうい"],["して"],["見つめて","みつめて"],["いる"],["と"],["、"],["地上","ちじょう"],["の"],["四つ足","四つあし"],["、"],["野","の"],["の"],["獣","けもの"],["、"],["這う","はう"],["もの"],["、"],["空","そら"],["の"],["鳥","とり"],["など"],["が"],["、"],["はいって"],["いた"],["。"]]},{"verse":7,"text":"それから声,こえがして、『ペテロよ、立,たって、それらをほふって食,たべなさい』と、わたしに言,いうのが聞,きこえた。","tok":[["それ"],["から"],["声","こえ"],["が"],["して"],["、"],["『"],["ペテロ"],["よ"],["、"],["立って","たって"],["、"],["それ"],["ら"],["を"],["ほふって"],["食べ","たべ"],["なさい"],["』"],["と"],["、"],["わたし"],["に"],["言う","いう"],["の"],["が"],["聞こえた","きこえた"],["。"]]},{"verse":8,"text":"わたしは言,いった、『主,しゅよ、それはできません。わたしは今,いままでに、清,きよくないものや汚,けがれたものを口,くちに入,いれたことが一度,いちどもございません』。","tok":[["わたし"],["は"],["言った","いった"],["、"],["『"],["主","しゅ"],["よ"],["、"],["それ"],["は"],["できません"],["。"],["わたし"],["は"],["今まで","いままで"],["に"],["、"],["清く","きよく"],["ない"],["もの"],["や"],["汚","けがれたも"],["の"],["を"],["口","くち"],["に"],["入れた","いれた"],["こと"],["が"],["一度","いちど"],["も"],["ございません"],["』"],["。"]]},{"verse":9,"text":"すると、二度目,どめに天,てんから声,こえがかかってきた、『神,かみがきよめたものを、清,きよくないなどと言,いってはならない』。","tok":[["する"],["と"],["、"],["二度目","どめ"],["に"],["天","てん"],["から"],["声","こえ"],["が"],["かかって"],["きた"],["、"],["『"],["神","かみ"],["が"],["きよめた"],["もの"],["を"],["、"],["清く","きよく"],["ない"],["など"],["と"],["言って","いって"],["は"],["ならない"],["』"],["。"]]},{"verse":10,"text":"こんなことが三度,どもあってから、全部,ぜんぶのものがまた天,てんに引,ひき上,あげられてしまった。","tok":[["こんな"],["こと"],["が"],["三","さん"],["度","ど"],["も"],["あって"],["から"],["、"],["全部","ぜんぶ"],["の"],["もの"],["が"],["また"],["天","てん"],["に"],["引上げられて","ひきあげられて"],["しまった"],["。"]]},{"verse":11,"text":"ちょうどその時,とき、カイザリヤからつかわされてきた三人,にんの人,ひとが、わたしたちの泊,とまっていた家,いえに着,ついた。","tok":[["ちょうど"],["その"],["時","とき"],["、"],["カイザリヤ"],["から"],["つかわされて"],["きた"],["三人","にん"],["の"],["人","ひと"],["が"],["、"],["わたしたち"],["の"],["泊まって","とまって"],["いた"],["家","いえ"],["に"],["着いた","ついた"],["。"]]},{"verse":12,"text":"御霊,みたまがわたしに、ためらわずに彼,かれらと共,ともに行,いけと言,いったので、ここにいる六人,にんの兄弟,きょうだいたちも、わたしと一緒,いっしょに出,でかけて行,いき、一同,いちどうがその人,ひとの家,いえにはいった。","tok":[["御霊","みたまがわたし"],["に"],["、"],["ためらわず"],["に"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["行け","いけ"],["と"],["言った","いった"],["ので"],["、"],["ここ"],["に"],["いる"],["六人","にん"],["の"],["兄弟","きょうだい"],["たち"],["も"],["、"],["わたし"],["と"],["一緒","いっしょ"],["に"],["出かけて","でかけて"],["行き","いき"],["、"],["一同","いちどう"],["が"],["その"],["人","ひと"],["の"],["家","いえ"],["に"],["はいった"],["。"]]},{"verse":13,"text":"すると彼,かれはわたしたちに、御使,みつかいが彼,かれの家,いえに現,あらわれて、『ヨッパに人,ひとをやって、ペテロと呼,よばれるシモンを招,まねきなさい。","tok":[["する"],["と"],["彼","かれ"],["は"],["わたしたち"],["に"],["、"],["御使","み"],["つかい"],["が"],["彼","かれ"],["の"],["家","いえ"],["に"],["現われて","あらわれて"],["、"],["『"],["ヨッパ"],["に"],["人","ひと"],["を"],["やって"],["、"],["ペテロ"],["と"],["呼ばれる","よばれる"],["シモン"],["を"],["招き","まねき"],["なさい"],["。"]]},{"verse":14,"text":"この人,ひとは、あなたとあなたの全,ぜん家族,かぞくとが救,すくわれる言葉,ことばを語,かたって下,くださるであろう』と告,つげた次第,しだいを、話,はなしてくれた。","tok":[["この"],["人","ひと"],["は"],["、"],["あなた"],["と"],["あなた"],["の"],["全","ぜん"],["家族","かぞく"],["と"],["が"],["救われる","すくわれる"],["言葉","ことば"],["を"],["語って","かたって"],["下さるで","くださるで"],["あろう"],["』"],["と"],["告","つげ"],["た"],["次第","しだい"],["を"],["、"],["話","はなし"],["て"],["くれた"],["。"]]},{"verse":15,"text":"そこでわたしが語,かたり出,だしたところ、聖霊,せいれいが、ちょうど最初,さいしょわたしたちの上,うえにくだったと同,おなじように、彼,かれらの上,うえにくだった。","tok":[["そこ"],["で"],["わたし"],["が"],["語り","かたり"],["出した","だした"],["ところ"],["、"],["聖霊","せいれい"],["が"],["、"],["ちょうど"],["最初","さいしょ"],["わたしたち"],["の"],["上","うえ"],["に"],["くだった"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["くだった"],["。"]]},{"verse":16,"text":"その時,ときわたしは、主,しゅが『ヨハネは水,みずでバプテスマを授,さづけたが、あなたがたは聖霊,せいれいによってバプテスマを受,うけるであろう』と仰,おおせになった言葉,ことばを思,おもい出,だした。","tok":[["その"],["時","とき"],["わたし"],["は"],["、"],["主","しゅ"],["が"],["『"],["ヨハネ"],["は"],["水","みず"],["で"],["バプテスマ"],["を"],["授","さ"],["づけた"],["が"],["、"],["あなた"],["がた"],["は"],["聖霊","せいれい"],["によって"],["バプテスマ"],["を"],["受るで","うけるで"],["あろう"],["』"],["と"],["仰せ","おおせ"],["に"],["なった"],["言葉","ことば"],["を"],["思い出した","おもいだした"],["。"]]},{"verse":17,"text":"このように、わたしたちが主,しゅイエス・キリストを信,しんじた時,ときに下,くださったのと同,おなじ賜物,たまものを、神,かみが彼,かれらにもお与,あたえになったとすれば、わたしのような者,ものが、どうして神,かみを妨,さまたげることができようか」。","tok":[["この"],["よう"],["に"],["、"],["わたしたち"],["が"],["主","しゅ"],["イエス"],["・"],["キリスト"],["を"],["信じた","しんじた"],["時","とき"],["に"],["下さった","くださった"],["の"],["と"],["同じ","おなじ"],["賜物","たまもの"],["を"],["、"],["神","かみ"],["が"],["彼","かれ"],["ら"],["に"],["も"],["お"],["与","あたえ"],["に"],["なった"],["と"],["すれば"],["、"],["わたし"],["の"],["よう"],["な"],["者","もの"],["が"],["、"],["どう"],["して"],["神","かみ"],["を"],["妨げる","さまたげる"],["こと"],["が"],["できよう"],["か"],["」"],["。"]]},{"verse":18,"text":"人々,ひとびとはこれを聞,きいて黙,だまってしまった。それから神,かみをさんびして、「それでは神,かみは、異邦人,いほうじんにも命,いのちにいたる悔改,くいあらためをお与,あたえになったのだ」と言,いった。","tok":[["人々","ひとびと"],["は"],["これ"],["を"],["聞いて","きいて"],["黙って","だまって"],["しまった"],["。"],["それ"],["から"],["神","かみ"],["を"],["さん"],["び"],["して"],["、"],["「"],["それ"],["で"],["は"],["神","かみ"],["は"],["、"],["異邦人","いほうじん"],["に"],["も"],["命","いのち"],["に"],["いたる"],["悔改","くいあらた"],["め"],["を"],["お"],["与","あたえ"],["に"],["なった"],["の"],["だ"],["」"],["と"],["言った","いった"],["。"]]},{"verse":19,"text":"さて、ステパノのことで起,おこった迫害,はくがいのために散,ちらされた人々,ひとびとは、ピニケ、クプロ、アンテオケまでも進,すすんで行,いったが、ユダヤ人,じん以外,いがいの者,ものには、だれにも御言,みことばを語,かたっていなかった。","tok":[["さて"],["、"],["ステパノ"],["の"],["こと"],["で"],["起こった","おこった"],["迫害","はくがい"],["の"],["ため"],["に"],["散らされた","ちらされた"],["人々","ひとびと"],["は"],["、"],["ピニケ"],["、"],["クプロ"],["、"],["アンテオケ"],["まで"],["も"],["進んで","すすんで"],["行った","いった"],["が"],["、"],["ユダヤ人","ゆだやじん"],["以外","いがい"],["の"],["者","もの"],["に"],["は"],["、"],["だれ"],["に"],["も"],["御言","みこと"],["ば"],["を"],["語って","かたって"],["いなかった"],["。"]]},{"verse":20,"text":"ところが、その中,なかに数人,すうにんのクプロ人,びととクレネ人,びとがいて、アンテオケに行,いってからギリシヤ人,じんにも呼,よびかけ、主,しゅイエスを宣,のべ伝,つたえていた。","tok":[["ところ"],["が"],["、"],["その"],["中","なか"],["に"],["数人","すうにん"],["の"],["クプロ人","くぷろび"],["と"],["と"],["クレネ人","くれねびと"],["が"],["いて"],["、"],["アンテオケ"],["に"],["行って","いって"],["から"],["ギリシヤ"],["人","じん"],["に"],["も"],["呼びかけ","よびかけ"],["、"],["主","しゅ"],["イエス"],["を"],["宣べ伝えて","のべつたえて"],["いた"],["。"]]},{"verse":21,"text":"そして、主,しゅのみ手,てが彼,かれらと共,ともにあったため、信,しんじて主,しゅに帰依,きえするものの数,かずが多,おおかった。","tok":[["そして"],["、"],["主","しゅ"],["のみ"],["手","て"],["が"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["あった"],["ため"],["、"],["信じて","しんじて"],["主に","しゅに"],["帰依","きえ"],["する"],["もの"],["の"],["数","かず"],["が"],["多かった","おおかった"],["。"]]},{"verse":22,"text":"このうわさがエルサレムにある教会,きょうかいに伝,つたわってきたので、教会,きょうかいはバルナバをアンテオケにつかわした。","tok":[["この"],["うわさ"],["が"],["エルサレム"],["に"],["ある"],["教会","きょうかい"],["に"],["伝わって","つたわって"],["きた"],["ので"],["、"],["教会","きょうかい"],["は"],["バルナバ"],["を"],["アンテオケ"],["に"],["つかわした"],["。"]]},{"verse":23,"text":"彼,かれは、そこに着,ついて、神,かみのめぐみを見,みてよろこび、主,しゅに対,たいする信仰,しんこうを揺,ゆるがない心,こころで持,もちつづけるようにと、みんなの者,ものを励,はげました。","tok":[["彼","かれ"],["は"],["、"],["そこ"],["に"],["着いて","ついて"],["、"],["神","かみ"],["の"],["めぐみ"],["を"],["見て","みて"],["よろこび"],["、"],["主","しゅ"],["に"],["対する","たいする"],["信仰","しんこう"],["を"],["揺るがない","ゆるがない"],["心","こころ"],["で"],["持ち","もち"],["つづける"],["よう"],["に"],["と"],["、"],["みんな"],["の"],["者","もの"],["を"],["励ました","はげました"],["。"]]},{"verse":24,"text":"彼,かれは聖霊,せいれいと信仰,しんこうとに満,みちた立派,りっぱな人,ひとであったからである。こうして主,しゅに加,くわわる人々,ひとびとが、大,おおぜいになった。","tok":[["彼","かれ"],["は"],["聖霊","せいれい"],["と"],["信仰","しんこう"],["と"],["に"],["満ちた","みちた"],["立派","りっぱ"],["な"],["人","ひと"],["で"],["あった"],["から"],["で"],["ある"],["。"],["こう"],["して"],["主に","しゅに"],["加わわる","くわわる"],["人々","ひとびと"],["が"],["、"],["大ぜい","おおぜい"],["に"],["なった"],["。"]]},{"verse":25,"text":"そこでバルナバはサウロを捜,さがしにタルソへ出,でかけて行,いき、","tok":[["そこ"],["で"],["バルナバ"],["は"],["サウロ"],["を"],["捜し","さがし"],["に"],["タルソ"],["へ"],["出かけて","でかけて"],["行き","いき"],["、"]]},{"verse":26,"text":"彼,かれを見,みつけたうえ、アンテオケに連,つれて帰,かえった。ふたりは、まる一年,ねん、ともどもに教会,きょうかいで集,あつまりをし、大,おおぜいの人々,ひとびとを教,おしえた。このアンテオケで初,はじめて、弟子,でしたちがクリスチャンと呼,よばれるようになった。","tok":[["彼","かれ"],["を"],["見つけた","みつけた"],["うえ"],["、"],["アンテオケ"],["に"],["連れて","つれて"],["帰えった","かえった"],["。"],["ふたり"],["は"],["、"],["まる"],["一","いち"],["年","ねん"],["、"],["ともども"],["に"],["教会","きょうかい"],["で"],["集まり","あつまり"],["を"],["し"],["、"],["大ぜい","おおぜい"],["の"],["人々","ひとびと"],["を"],["教えた","おしえた"],["。"],["この"],["アンテオケ"],["で"],["初めて","はじめて"],["、"],["弟子","でし"],["たち"],["が"],["クリスチャン"],["と"],["呼ばれる","よばれる"],["よう"],["に"],["なった"],["。"]]},{"verse":27,"text":"そのころ、預言者,よげんしゃたちがエルサレムからアンテオケにくだってきた。","tok":[["その"],["ころ"],["、"],["預言者","よげんしゃ"],["たち"],["が"],["エルサレム"],["から"],["アンテオケ"],["に"],["くだって"],["きた"],["。"]]},{"verse":28,"text":"その中,なかのひとりであるアガボという者,ものが立,たって、世界中,せかいじゅうに大,だいききんが起,おこるだろうと、御霊,みたまによって預言,よげんしたところ、果,はたしてそれがクラウデオ帝,ていの時,ときに起,おこった。","tok":[["その"],["中","なか"],["の"],["ひとり"],["で"],["ある"],["アガボ"],["と"],["いう"],["者","もの"],["が"],["立って","たって"],["、"],["世界中","せかいじゅう"],["に"],["大","だい"],["ききん"],["が"],["起こるだろう","おこるだろう"],["と"],["、"],["御霊","みたま"],["によって"],["預言","よげん"],["した"],["ところ"],["、"],["果たして","はたして"],["それ"],["が"],["クラウデオ"],["帝","てい"],["の"],["時","とき"],["に"],["起こった","おこった"],["。"]]},{"verse":29,"text":"そこで弟子,でしたちは、それぞれの力,ちからに応,おうじて、ユダヤに住,すんでいる兄弟,きょうだいたちに援助,えんじょを送,おくることに決,きめた。","tok":[["そこ"],["で"],["弟子","でし"],["たち"],["は"],["、"],["それぞれ"],["の"],["力","ちから"],["に"],["応じて","おうじて"],["、"],["ユダヤ"],["に"],["住んで","すんで"],["いる"],["兄弟","きょうだい"],["たち"],["に"],["援助","えんじょ"],["を"],["送る","おくる"],["こと"],["に"],["決めた","きめた"],["。"]]},{"verse":30,"text":"そして、それをバルナバとサウロとの手,てに託,たくして、長老,ちょうろうたちに送,おくりとどけた。","tok":[["そして"],["、"],["それ"],["を"],["バルナバ"],["と"],["サウロ"],["と"],["の"],["手","て"],["に"],["託して","たくして"],["、"],["長老","ちょうろう"],["たち"],["に"],["送りとどけた","おくりとどけた"],["。"]]}]
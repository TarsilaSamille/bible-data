[{"verse":1,"text":"さて、ペテロとヨハネとが、午後,ごご三時,じの祈,いのりのときに宮,みやに上,のぼろうとしていると、","tok":[["さて"],["、"],["ペテロ"],["と"],["ヨハネ"],["と"],["が"],["、"],["午後","ごご"],["三","さん"],["時","じ"],["の"],["祈","いのり"],["の"],["とき"],["に"],["宮","みや"],["に"],["上ろう","のぼろう"],["として"],["いる"],["と"],["、"]]},{"verse":2,"text":"生,うまれながら足,あしのきかない男,おとこが、かかえられてきた。この男,おとこは、宮,みやもうでに来,くる人々,ひとびとに施,ほどこしをこうため、毎日,まいにち、「美,うつくしの門,もん」と呼,よばれる宮,みやの門,もんのところに、置,おかれていた者,ものである。","tok":[["生まれ","うまれ"],["ながら"],["足","あし"],["の"],["きかない"],["男","おとこ"],["が"],["、"],["かかえられて"],["きた"],["。"],["この"],["男","おとこ"],["は"],["、"],["宮","みや"],["も"],["うで"],["に"],["来る","くる"],["人々","ひとびと"],["に"],["施し","ほどこし"],["を"],["こう"],["ため"],["、"],["毎日","まいにち"],["、"],["「"],["美し","うつくし"],["の"],["門","もん"],["」"],["と"],["呼ばれる","よばれる"],["宮","みや"],["の"],["門","もん"],["の"],["ところ"],["に"],["、"],["置かれて","おかれて"],["いた"],["者","もの"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼,かれは、ペテロとヨハネとが、宮,みやにはいって行,いこうとしているのを見,みて、施,ほどこしをこうた。","tok":[["彼","かれ"],["は"],["、"],["ペテロ"],["と"],["ヨハネ"],["と"],["が"],["、"],["宮","みや"],["に"],["はいって"],["行こう","いこう"],["として"],["いる"],["の"],["を"],["見て","みて"],["、"],["施し","ほどこし"],["を"],["こうた"],["。"]]},{"verse":4,"text":"ペテロとヨハネとは彼,かれをじっと見,みて、「わたしたちを見,みなさい」と言,いった。","tok":[["ペテロ"],["と"],["ヨハネ"],["と"],["は"],["彼","かれ"],["を"],["じっと"],["見て","みて"],["、"],["「"],["わたしたち"],["を"],["見","み"],["なさい"],["」"],["と"],["言った","いった"],["。"]]},{"verse":5,"text":"彼,かれは何,なにかもらえるのだろうと期待,きたいして、ふたりに注目,ちゅうもくしていると、","tok":[["彼","かれ"],["は"],["何に","なに"],["か"],["もらえる"],["の"],["だろう"],["と"],["期待","きたい"],["して"],["、"],["ふたり"],["に"],["注目","ちゅうもく"],["して"],["いる"],["と"],["、"]]},{"verse":6,"text":"ペテロが言,いった、「金銀,きんぎんはわたしには無,ない。しかし、わたしにあるものをあげよう。ナザレ人,びとイエス・キリストの名,なによって歩,あるきなさい」。","tok":[["ペテロ"],["が"],["言った","いった"],["、"],["「"],["金銀","きんぎん"],["は"],["わたし"],["に"],["は"],["無い","ない"],["。"],["しかし"],["、"],["わたし"],["に"],["ある"],["もの"],["を"],["あげよう"],["。"],["ナザレ人","なざれび"],["と"],["イエス"],["・"],["キリスト"],["の"],["名","な"],["によって"],["歩き","あるき"],["なさい"],["」"],["。"]]},{"verse":7,"text":"こう言,いって彼,かれの右手,みぎてを取,とって起,おこしてやると、足,あしと、くるぶしとが、立,たちどころに強,つよくなって、","tok":[["こう"],["言って","いって"],["彼","かれ"],["の"],["右手","みぎて"],["を"],["取って","とって"],["起こして","おこして"],["やる"],["と"],["、"],["足","あし"],["と"],["、"],["くるぶし"],["と"],["が"],["、"],["立ち","たち"],["どころ"],["に"],["強く","つよく"],["なって"],["、"]]},{"verse":8,"text":"踊,おどりあがって立,たち、歩,あるき出,だした。そして、歩,あるき回,まわったり踊,おどったりして神,かみをさんびしながら、彼,かれらと共,ともに宮,みやにはいって行,いった。","tok":[["踊","おどり"],["あがって"],["立ち","たち"],["、"],["歩き","あるき"],["出した","だした"],["。"],["そして"],["、"],["歩き","あるき"],["回わっ","まわっ"],["たり"],["踊っ","おどっ"],["たり"],["して"],["神","かみ"],["を"],["さん"],["び"],["し"],["ながら"],["、"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["宮","みや"],["に"],["はいって"],["行った","いった"],["。"]]},{"verse":9,"text":"民衆,みんしゅうはみな、彼,かれが歩,あるき回,まわり、また神,かみをさんびしているのを見,み、","tok":[["民衆","みんしゅう"],["は"],["みな"],["、"],["彼","かれ"],["が"],["歩き","あるき"],["回わり","まわり"],["、"],["また"],["神","かみ"],["を"],["さん"],["び"],["して"],["いる"],["の"],["を"],["見","み"],["、"]]},{"verse":10,"text":"これが宮,みやの「美,うつくしの門,もん」のそばにすわって、施,ほどこしをこうていた者,ものであると知,しり、彼,かれの身,みに起,おこったことについて、驚,おどろき怪,あやしんだ。","tok":[["これ"],["が"],["宮","みや"],["の"],["「"],["美し","うつくし"],["の"],["門","もん"],["」"],["の"],["そば"],["に"],["すわって"],["、"],["施し","ほどこし"],["を"],["こうて"],["いた"],["者","もの"],["で"],["ある"],["と"],["知り","しり"],["、"],["彼","かれ"],["の"],["身","み"],["に"],["起こった","おこった"],["こと"],["について"],["、"],["驚","おどろき"],["怪しんだ","あやしんだ"],["。"]]},{"verse":11,"text":"彼,かれがなおもペテロとヨハネとにつきまとっているとき、人々,ひとびとは皆,みなひどく驚,おどろいて、「ソロモンの廊,ろう」と呼,よばれる柱廊,ちゅうろうにいた彼,かれらのところに駆,かけ集,あつまってきた。","tok":[["彼","かれ"],["が"],["なお"],["も"],["ペテロ"],["と"],["ヨハネ"],["と"],["に"],["つきまとって"],["いる"],["とき"],["、"],["人々","ひとびと"],["は"],["皆","みな"],["ひどく"],["驚ろいて","おどろいて"],["、"],["「"],["ソロモン"],["の"],["廊","ろう"],["」"],["と"],["呼ばれる","よばれる"],["柱廊","ちゅうろう"],["に"],["いた"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["駆け集まって","かけあつまって"],["きた"],["。"]]},{"verse":12,"text":"ペテロはこれを見,みて、人々,ひとびとにむかって言,いった、「イスラエルの人,ひとたちよ、なぜこの事,ことを不思議,ふしぎに思,おもうのか。また、わたしたちが自分,じぶんの力,ちからや信心,しんじんで、あの人,ひとを歩,あるかせたかのように、なぜわたしたちを見,みつめているのか。","tok":[["ペテロ"],["は"],["これ"],["を"],["見て","みて"],["、"],["人々","ひとびと"],["に"],["むかって"],["言った","いった"],["、"],["「"],["イスラエル"],["の"],["人","ひと"],["たち"],["よ"],["、"],["なぜ"],["この"],["事","こと"],["を"],["不思議","ふしぎ"],["に"],["思","おもう"],["の"],["か"],["。"],["また"],["、"],["わたしたち"],["が"],["自分","じぶん"],["の"],["力","ちから"],["や"],["信心","しんじん"],["で"],["、"],["あの"],["人","ひと"],["を"],["歩かせた","あるかせた"],["か"],["の"],["よう"],["に"],["、"],["なぜ"],["わたしたち"],["を"],["見つめて","みつめて"],["いる"],["の"],["か"],["。"]]},{"verse":13,"text":"アブラハム、イサク、ヤコブの神,かみ、わたしたちの先祖,せんぞの神,かみは、その僕,しもべイエスに栄光,えいこうを賜,たまわったのであるが、あなたがたは、このイエスを引,ひき渡,わたし、ピラトがゆるすことに決,きめていたのに、それを彼,かれの面前,めんぜんで拒,こばんだ。","tok":[["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["の"],["神","かみ"],["、"],["わたしたち"],["の"],["先祖","せんぞ"],["の"],["神","かみ"],["は"],["、"],["その"],["僕","し"],["も"],["べ"],["イエス"],["に"],["栄光","えいこう"],["を"],["賜わった","たまわった"],["ので"],["ある"],["が"],["、"],["あなた"],["がた"],["は"],["、"],["この"],["イエス"],["を"],["引渡","ひきわたし"],["、"],["ピラト"],["が"],["ゆるす"],["こと"],["に"],["決めて","きめて"],["いた"],["のに"],["、"],["それ"],["を"],["彼","かれ"],["の"],["面前","めんぜん"],["で"],["拒んだ","こばんだ"],["。"]]},{"verse":14,"text":"あなたがたは、この聖,せいなる正,ただしいかたを拒,こばんで、人殺,ひとごろしの男,おとこをゆるすように要求,ようきゅうし、","tok":[["あなた"],["がた"],["は"],["、"],["この"],["聖","せい"],["なる"],["正い","ただしい"],["かた"],["を"],["拒んで","こばんで"],["、"],["人殺し","ひとごろし"],["の"],["男","おとこ"],["を"],["ゆるす"],["よう"],["に"],["要求","ようきゅう"],["し"],["、"]]},{"verse":15,"text":"いのちの君,きみを殺,ころしてしまった。しかし、神,かみはこのイエスを死人,しにんの中,なかから、よみがえらせた。わたしたちは、その事,ことの証人,しょうにんである。","tok":[["いのち"],["の"],["君","きみ"],["を"],["殺ろして","ころして"],["しまった"],["。"],["しかし"],["、"],["神","かみ"],["は"],["この"],["イエス"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["、"],["よみがえらせた"],["。"],["わたしたち"],["は"],["、"],["その"],["事","こと"],["の"],["証人","しょうにん"],["で"],["ある"],["。"]]},{"verse":16,"text":"そして、イエスの名,なが、それを信,しんじる信仰,しんこうのゆえに、あなたがたのいま見,みて知,しっているこの人,ひとを、強,つよくしたのであり、イエスによる信仰,しんこうが、彼,かれをあなたがた一同,いちどうの前,まえで、このとおり完全,かんぜんにいやしたのである。","tok":[["そして"],["、"],["イエス"],["の"],["名","な"],["が"],["、"],["それ"],["を"],["信じる","しんじる"],["信仰","しんこう"],["の"],["ゆえ"],["に"],["、"],["あなた"],["がた"],["の"],["いま"],["見て","みて"],["知って","しって"],["いる"],["この"],["人","ひと"],["を"],["、"],["強く","つよく"],["した"],["ので"],["あり"],["、"],["イエス"],["に"],["よる"],["信仰","しんこう"],["が"],["、"],["彼","かれ"],["を"],["あなた"],["がた"],["一同","いちどう"],["の"],["前","まえ"],["で"],["、"],["この"],["とおり"],["完全","かんぜん"],["に"],["いやした"],["ので"],["ある"],["。"]]},{"verse":17,"text":"さて、兄弟,きょうだいたちよ、あなたがたは知,しらずにあのような事,ことをしたのであり、あなたがたの指導者,しどうしゃたちとても同様,どうようであったことは、わたしにわかっている。","tok":[["さて"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["、"],["あなた"],["がた"],["は"],["知らず","しらず"],["に"],["あの"],["よう"],["な"],["事","こと"],["を"],["した"],["ので"],["あり"],["、"],["あなた"],["がた"],["の"],["指導者","しどうしゃ"],["たち"],["とても"],["同様","どうよう"],["で"],["あった"],["こと"],["は"],["、"],["わたし"],["に"],["わかって"],["いる"],["。"]]},{"verse":18,"text":"神,かみはあらゆる預言者,よげんしゃの口,くちをとおして、キリストの受難,じゅなんを予告,よこくしておられたが、それをこのように成就,じょうじゅなさったのである。","tok":[["神","かみ"],["は"],["あらゆる"],["預言者","よげんしゃ"],["の"],["口","くち"],["を"],["とおして"],["、"],["キリスト"],["の"],["受難","じゅなん"],["を"],["予告","よこく"],["して"],["おられた"],["が"],["、"],["それ"],["を"],["この"],["よう"],["に"],["成就","じょうじゅ"],["なさった"],["ので"],["ある"],["。"]]},{"verse":19,"text":"だから、自分,じぶんの罪,つみをぬぐい去,さっていただくために、悔,くい改,あらためて本心,ほんしんに立,たちかえりなさい。","tok":[["だ"],["から"],["、"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["ぬぐい"],["去て","さって"],["いただく"],["ため"],["に"],["、"],["悔い","くい"],["改","あらため"],["て"],["本心","ほんしん"],["に"],["立ちかえり","たちかえり"],["なさい"],["。"]]},{"verse":20,"text":"それは、主,しゅのみ前,まえから慰,なぐさめの時,ときがきて、あなたがたのためにあらかじめ定,さだめてあったキリストなるイエスを、神,かみがつかわして下,くださるためである。","tok":[["それ"],["は"],["、"],["主","しゅ"],["のみ"],["前","まえ"],["から"],["慰さめ","なぐさめ"],["の"],["時","とき"],["が"],["きて"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["あらかじめ"],["定めて","さだめて"],["あった"],["キリスト"],["なる"],["イエス"],["を"],["、"],["神","かみ"],["が"],["つかわして"],["下さる","くださる"],["ため"],["で"],["ある"],["。"]]},{"verse":21,"text":"このイエスは、神,かみが聖,せいなる預言者,よげんしゃたちの口,くちをとおして、昔,むかしから預言,よげんしておられた万物,ばんぶつ更新,こうしんの時,ときまで、天,てんにとどめておかれねばならなかった。","tok":[["この"],["イエス"],["は"],["、"],["神","かみ"],["が"],["聖","せい"],["なる"],["預言者","よげんしゃ"],["たち"],["の"],["口","くち"],["を"],["とおして"],["、"],["昔","むかし"],["から"],["預言","よげん"],["して"],["おられた"],["万物","ばんぶつ"],["更新","こうしん"],["の"],["時","とき"],["まで"],["、"],["天","てん"],["に"],["とどめて"],["おかれねば"],["ならなかった"],["。"]]},{"verse":22,"text":"モーセは言,いった、『主,しゅなる神,かみは、わたしをお立,たてになったように、あなたがたの兄弟,きょうだいの中,なかから、ひとりの預言者,よげんしゃをお立,たてになるであろう。その預言者,よげんしゃがあなたがたに語,かたることには、ことごとく聞,ききしたがいなさい。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["『"],["主","しゅ"],["なる"],["神","かみ"],["は"],["、"],["わたし"],["を"],["お立","おたて"],["に"],["なった"],["よう"],["に"],["、"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["の"],["中","なか"],["から"],["、"],["ひとり"],["の"],["預言者","よげんしゃ"],["を"],["お立","おたて"],["に"],["なるで"],["あろう"],["。"],["その"],["預言者","よげんしゃ"],["が"],["あなた"],["がた"],["に"],["語る","かたる"],["こと"],["に"],["は"],["、"],["ことごとく"],["聞した","ききした"],["が"],["い"],["なさい"],["。"]]},{"verse":23,"text":"彼,かれに聞,ききしたがわない者,ものは、みな民,たみの中,なかから滅,ほろぼし去,さられるであろう』。","tok":[["彼","かれ"],["に"],["聞した","ききした"],["がわ"],["ない"],["者","もの"],["は"],["、"],["みな民","みなたみ"],["の"],["中","なか"],["から"],["滅ぼし去られるで","ほろぼしさられるで"],["あろう"],["』"],["。"]]},{"verse":24,"text":"サムエルをはじめ、その後,のちつづいて語,かたったほどの預言者,よげんしゃはみな、この時,ときのことを予告,よこくした。","tok":[["サムエル"],["を"],["はじめ"],["、"],["その後","そのの"],["ち"],["つづいて"],["語った","かたった"],["ほど"],["の"],["預言者","よげんしゃ"],["は"],["みな"],["、"],["この"],["時","とき"],["の"],["こと"],["を"],["予告","よこく"],["した"],["。"]]},{"verse":25,"text":"あなたがたは預言者,よげんしゃの子,こであり、神,かみがあなたがたの先祖,せんぞたちと結,むすばれた契約,けいやくの子,こである。神,かみはアブラハムに対,たいして、『地上,ちじょうの諸,しょ民族,みんぞくは、あなたの子孫,しそんによって祝福,しゅくふくを受,うけるであろう』と仰,おおせられた。","tok":[["あなた"],["がた"],["は"],["預言者","よげんしゃ"],["の"],["子","こ"],["で"],["あり"],["、"],["神","かみ"],["が"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["と"],["結ばれた","むすばれた"],["契約","けいやく"],["の"],["子","こ"],["で"],["ある"],["。"],["神","かみ"],["は"],["アブラハム"],["に対して","にたいして"],["、"],["『"],["地上","ちじょう"],["の"],["諸","しょ"],["民族","みんぞく"],["は"],["、"],["あなた"],["の"],["子孫","しそん"],["によって"],["祝福","しゅくふく"],["を"],["受るで","うけるで"],["あろう"],["』"],["と"],["仰せられた","おおせられた"],["。"]]},{"verse":26,"text":"神,かみがまずあなたがたのために、その僕,しもべを立,たてて、おつかわしになったのは、あなたがたひとりびとりを、悪,あくから立,たちかえらせて、祝福,しゅくふくにあずからせるためなのである」。","tok":[["神","かみ"],["が"],["まず"],["あなた"],["がた"],["の"],["ため"],["に"],["、"],["その"],["僕","し"],["も"],["べ"],["を"],["立てて","たてて"],["、"],["おつかわし"],["に"],["なった"],["の"],["は"],["、"],["あなた"],["がた"],["ひとりびとり"],["を"],["、"],["悪","あく"],["から"],["立ちかえらせて","たちかえらせて"],["、"],["祝福","しゅくふく"],["に"],["あずからせる"],["ため"],["な"],["ので"],["ある"],["」"],["。"]]}]
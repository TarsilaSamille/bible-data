[{"verse":1,"text":"さて、アンテオケにある教会,きょうかいには、バルナバ、ニゲルと呼,よばれるシメオン、クレネ人,びとルキオ、領主,りょうしゅヘロデの乳兄弟,ちきょうだいマナエン、およびサウロなどの預言者,よげんしゃや教師,きょうしがいた。","tok":[["さて"],["、"],["アンテオケ"],["に"],["ある"],["教会","きょうかい"],["に"],["は"],["、"],["バルナバ"],["、"],["ニゲル"],["と"],["呼ばれる","よばれる"],["シメオン"],["、"],["クレネ人","くれねび"],["と"],["ルキオ"],["、"],["領主","りょうしゅ"],["ヘロデ"],["の"],["乳","にゅう"],["兄弟","きょうだい"],["きょうだい"],["マナエン"],["、"],["および"],["サウロ"],["など"],["の"],["預言者","よげんしゃ"],["や"],["教師","きょうし"],["が"],["いた"],["。"]]},{"verse":2,"text":"一同,いちどうが主,しゅに礼拝,れいはいをささげ、断食,だんじきをしていると、聖霊,せいれいが「さあ、バルナバとサウロとを、わたしのために聖,せい別,べつして、彼,かれらに授,さづけておいた仕事,しごとに当,あたらせなさい」と告,つげた。","tok":[["一同","いちどう"],["が"],["主に","しゅに"],["礼拝","れいはい"],["を"],["ささげ"],["、"],["断食","だんじき"],["を"],["して"],["いる"],["と"],["、"],["聖霊","せいれい"],["が"],["「"],["さあ"],["、"],["バルナバ"],["と"],["サウロ"],["と"],["を"],["、"],["わたし"],["の"],["ため"],["に"],["聖別","せいべつ"],["して"],["、"],["彼","かれ"],["ら"],["に"],["授","さ"],["づけて"],["おいた"],["仕事","しごと"],["に"],["当たらせ","あたらせ"],["なさい"],["」"],["と"],["告","つげ"],["た"],["。"]]},{"verse":3,"text":"そこで一同,いちどうは、断食,だんじきと祈,いのりとをして、手,てをふたりの上,うえにおいた後,のち、出発,しゅっぱつさせた。","tok":[["そこ"],["で"],["一同","いちどう"],["は"],["、"],["断食","だんじき"],["と"],["祈","いのり"],["と"],["を"],["して"],["、"],["手","て"],["を"],["ふたり"],["の"],["上","うえ"],["に"],["おいた"],["後","の"],["ち"],["、"],["出発","しゅっぱつ"],["させた"],["。"]]},{"verse":4,"text":"ふたりは聖霊,せいれいに送,おくり出,だされて、セルキヤにくだり、そこから舟,ふねでクプロに渡,わたった。","tok":[["ふたり"],["は"],["聖霊","せいれい"],["に"],["送り出されて","おくりだされて"],["、"],["セルキヤ"],["に"],["くだり"],["、"],["そこ"],["から"],["舟","ふね"],["で"],["クプロ"],["に"],["渡った","わたった"],["。"]]},{"verse":5,"text":"そしてサラミスに着,つくと、ユダヤ人,じんの諸,しょ会堂,かいどうで神,かみの言,ことばを宣,のべはじめた。彼,かれらはヨハネを助,たすけ手,てとして連,つれていた。","tok":[["そして"],["サラミス"],["に"],["着く","つく"],["と"],["、"],["ユダヤ人","ゆだやじん"],["の"],["諸","しょ"],["会堂","かいどう"],["で"],["神","かみ"],["の"],["言","ことば"],["を"],["宣べ","のべ"],["はじめた"],["。"],["彼","かれ"],["ら"],["は"],["ヨハネ"],["を"],["助け手","たすけて"],["として"],["連れて","つれて"],["いた"],["。"]]},{"verse":6,"text":"島,しま全体,ぜんたいを巡回,じゅんかいして、パポスまで行,いったところ、そこでユダヤ人,じんの魔術,まじゅつ師,し、バルイエスというにせ預言者,よげんしゃに出会,であった。","tok":[["島","しま"],["全体","ぜんたい"],["を"],["巡回","じゅんかい"],["して"],["、"],["パポス"],["まで"],["行った","いった"],["ところ"],["、"],["そこ"],["で"],["ユダヤ人","ゆだやじん"],["の"],["魔術師","まじゅつし"],["、"],["バルイエス"],["と"],["いう"],["にせ"],["預言者","よげんしゃ"],["に"],["出会った","であった"],["。"]]},{"verse":7,"text":"彼,かれは地方,ちほう総督,そうとくセルギオ・パウロのところに出入,でいりをしていた。この総督,そうとくは賢明,けんめいな人,ひとであって、バルナバとサウロとを招,まねいて、神,かみの言,ことばを聞,きこうとした。","tok":[["彼","かれ"],["は"],["地方","ちほう"],["総督","そうとく"],["セルギオ"],["・"],["パウロ"],["の"],["ところ"],["に"],["出入","でいり"],["を"],["して"],["いた"],["。"],["この"],["総督","そうとく"],["は"],["賢明","けんめい"],["な"],["人","ひと"],["で"],["あって"],["、"],["バルナバ"],["と"],["サウロ"],["と"],["を"],["招いて","まねいて"],["、"],["神","かみ"],["の"],["言","ことば"],["を"],["聞こう","きこう"],["と"],["した"],["。"]]},{"verse":8,"text":"ところが魔術,まじゅつ師,しエルマ（彼,かれの名,なは「魔術,まじゅつ師,し」との意,い）は、総督,そうとくを信仰,しんこうからそらそうとして、しきりにふたりの邪魔,じゃまをした。","tok":[["ところ"],["が"],["魔術師","まじゅつし"],["エルマ"],["（"],["彼","かれ"],["の"],["名","な"],["は"],["「"],["魔術師","まじゅつし"],["」"],["と"],["の"],["意","い"],["）"],["は"],["、"],["総督","そうとく"],["を"],["信仰","しんこう"],["から"],["そらそう"],["として"],["、"],["しきり"],["に"],["ふたり"],["の"],["邪魔","じゃま"],["を"],["した"],["。"]]},{"verse":9,"text":"サウロ、またの名,なはパウロ、は聖霊,せいれいに満,みたされ、彼,かれをにらみつけて","tok":[["サウロ"],["、"],["また"],["の"],["名","な"],["は"],["パウロ"],["、"],["は"],["聖霊","せいれい"],["に"],["満たされ","みたされ"],["、"],["彼","かれ"],["を"],["にらみつけて"]]},{"verse":10,"text":"言,いった、「ああ、あらゆる偽,いつわりと邪悪,じゃあくとでかたまっている悪魔,あくまの子,こよ、すべて正,ただしいものの敵,てきよ。主,しゅのまっすぐな道,みちを曲,まげることを止,やめないのか。","tok":[["言った","いった"],["、"],["「"],["ああ"],["、"],["あらゆる"],["偽り","いつわり"],["と"],["邪悪","じゃあく"],["と"],["で"],["かたまって"],["いる"],["悪魔","あくま"],["の"],["子","こ"],["よ"],["、"],["すべて"],["正い","ただしい"],["もの"],["の"],["敵","てき"],["よ"],["。"],["主","しゅ"],["の"],["まっすぐ"],["な"],["道","みち"],["を"],["曲げる","まげる"],["こと"],["を"],["止","やめない"],["の"],["か"],["。"]]},{"verse":11,"text":"見,みよ、主,しゅのみ手,てがおまえの上,うえに及,およんでいる。おまえは盲,めくらになって、当分,とうぶん、日,ひの光,ひかりが見,みえなくなるのだ」。たちまち、かすみとやみとが彼,かれにかかったため、彼,かれは手,てさぐりしながら、手,てを引,ひいてくれる人,ひとを捜,さがしまわった。","tok":[["見よ","みよ"],["、"],["主","しゅ"],["のみ"],["手","て"],["が"],["おまえ"],["の"],["上","うえ"],["に"],["及んで","およんで"],["いる"],["。"],["おまえ"],["は"],["盲","めくら"],["に"],["なって"],["、"],["当分","とうぶん"],["、"],["日","ひ"],["の"],["光","ひかり"],["が"],["見えなく","みえなく"],["なる"],["の"],["だ"],["」"],["。"],["たちまち"],["、"],["かすみ"],["と"],["やみ"],["と"],["が"],["彼","かれ"],["に"],["かかった"],["ため"],["、"],["彼","かれ"],["は"],["手さぐり","てさぐり"],["し"],["ながら"],["、"],["手","て"],["を"],["引いて","ひいて"],["くれる"],["人","ひと"],["を"],["捜しまわった","さがしまわった"],["。"]]},{"verse":12,"text":"総督,そうとくはこの出来事,できごとを見,みて、主,しゅの教,おしえにすっかり驚,おどろき、そして信,しんじた。","tok":[["総督","そうとく"],["は"],["この"],["出来事","できごと"],["を"],["見て","みて"],["、"],["主","しゅ"],["の"],["教え","おしえ"],["に"],["すっかり"],["驚","おどろき"],["、"],["そして"],["信じた","しんじた"],["。"]]},{"verse":13,"text":"パウロとその一行,いっこうは、パポスから船出,ふなでして、パンフリヤのペルガに渡,わたった。ここでヨハネは一行,いっこうから身,みを引,ひいて、エルサレムに帰,かえってしまった。","tok":[["パウロ"],["と"],["その"],["一行","いっこう"],["は"],["、"],["パポス"],["から"],["船出","ふなで"],["して"],["、"],["パンフリヤ"],["の"],["ペルガ"],["に"],["渡った","わたった"],["。"],["ここ"],["で"],["ヨハネ"],["は"],["一行","いっこう"],["から"],["身","み"],["を"],["引いて","ひいて"],["、"],["エルサレム"],["に"],["帰えって","かえって"],["しまった"],["。"]]},{"verse":14,"text":"しかしふたりは、ペルガからさらに進,すすんで、ピシデヤのアンテオケに行,いき、安息日,あんそくにちに会堂,かいどうにはいって席,せきに着,ついた。","tok":[["しかし"],["ふたり"],["は"],["、"],["ペルガ"],["から"],["さらに"],["進んで","すすんで"],["、"],["ピシデヤ"],["の"],["アンテオケ"],["に"],["行き","いき"],["、"],["安息日","あんそくにち"],["に"],["会堂","かいどう"],["に"],["はいって"],["席","せき"],["に"],["着いた","ついた"],["。"]]},{"verse":15,"text":"律法,りっぽうと預言,よげん書,しょの朗読,ろうどくがあったのち、会堂司,かいどうづかさたちが彼,かれらのところに人,ひとをつかわして、「兄弟,きょうだいたちよ、もしあなたがたのうち、どなたか、この人々,ひとびとに何,なにか奨励,しょうれいの言葉,ことばがありましたら、どうぞお話,はなし下,ください」と言,いわせた。","tok":[["律法","りっぽう"],["と"],["預言書","よげんしょ"],["の"],["朗読","ろうどく"],["が"],["あった"],["のち"],["、"],["会堂司","かいどうづかさ"],["たち"],["が"],["彼","かれ"],["ら"],["の"],["ところ"],["に"],["人","ひと"],["を"],["つかわして"],["、"],["「"],["兄弟","きょうだい"],["たち"],["よ"],["、"],["もし"],["あなた"],["がた"],["の"],["うち"],["、"],["どなた"],["か"],["、"],["この"],["人々","ひとびと"],["に"],["何に","なに"],["か"],["奨励","しょうれい"],["の"],["言葉","ことば"],["が"],["ありましたら"],["、"],["どうぞ"],["お話","おはなし"],["下さい","ください"],["」"],["と"],["言わせた","いわせた"],["。"]]},{"verse":16,"text":"そこでパウロが立,たちあがり、手,てを振,ふりながら言,いった。「イスラエルの人,ひとたち、ならびに神,かみを敬,うやまうかたがたよ、お聞,きき下,ください。","tok":[["そこ"],["で"],["パウロ"],["が"],["立ちあがり","たちあがり"],["、"],["手","て"],["を"],["振り","ふり"],["ながら"],["言った","いった"],["。"],["「"],["イスラエル"],["の"],["人","ひと"],["たち"],["、"],["ならびに"],["神","かみ"],["を"],["敬う","うやまう"],["かたがた"],["よ"],["、"],["お聞","おきき"],["下さい","ください"],["。"]]},{"verse":17,"text":"この民,たみイスラエルの神,かみは、わたしたちの先祖,せんぞを選,えらび、エジプトの地,ちに滞在,たいざい中,ちゅう、この民,たみを大,おおいなるものとし、み腕,うでを高,たかくさし上,あげて、彼,かれらをその地,ちから導,みちびき出,だされた。","tok":[["この"],["民","た"],["みイスラエル"],["の"],["神","かみ"],["は"],["、"],["わたしたち"],["の"],["先祖","せんぞ"],["を"],["選ら","えら"],["び"],["、"],["エジプト"],["の"],["地","ち"],["に"],["滞在中","たいざいちゅう"],["、"],["この"],["民","たみ"],["を"],["大いなる","おおいなる"],["もの"],["と"],["し"],["、"],["み腕","みうで"],["を"],["高かく","たかく"],["さし上げて","さしあげて"],["、"],["彼","かれ"],["ら"],["を"],["その"],["地","ち"],["から"],["導き出された","みちびきだされた"],["。"]]},{"verse":18,"text":"そして約,やく四十年,ねんにわたって、荒野,あらので彼,かれらをはぐくみ、","tok":[["そして"],["約","やく"],["四十","よんじゅう"],["年","ねん"],["に"],["わたって"],["、"],["荒野","あらの"],["で"],["彼","かれ"],["ら"],["を"],["はぐくみ"],["、"]]},{"verse":19,"text":"カナンの地,ちでは七つの異,い民族,みんぞくを打,うち滅,ほろぼし、その地,ちを彼,かれらに譲,ゆずり与,あたえられた。","tok":[["カナン"],["の"],["地","ち"],["で"],["は"],["七","なな"],["つ"],["の"],["異民族","いみんぞく"],["を"],["打ち滅ぼし","うちほろぼし"],["、"],["その"],["地","ち"],["を"],["彼","かれ"],["ら"],["に"],["譲り与えられた","ゆずりあたえられた"],["。"]]},{"verse":20,"text":"それらのことが約,やく四百五十年,ねんの年月,ねんげつにわたった。その後,のち、神,かみはさばき人,ひとたちをおつかわしになり、預言者,よげんしゃサムエルの時,ときに及,およんだ。","tok":[["それ"],["ら"],["の"],["こと"],["が"],["約","やく"],["四百五十","よんひゃくごじゅう"],["年","ねん"],["の"],["年月","ねんげつ"],["に"],["わたった"],["。"],["その後","そのの"],["ち"],["、"],["神","かみ"],["は"],["さばき"],["人","ひと"],["たち"],["を"],["おつかわし"],["に"],["なり"],["、"],["預言者","よげんしゃ"],["サムエル"],["の"],["時","とき"],["に"],["及んだ","およんだ"],["。"]]},{"verse":21,"text":"その時,とき、人々,ひとびとが王,おうを要求,ようきゅうしたので、神,かみはベニヤミン族,ぞくの人,ひと、キスの子,こサウロを四十年間,ねんかん、彼,かれらにおつかわしになった。","tok":[["その"],["時","とき"],["、"],["人々","ひとびと"],["が"],["王","おう"],["を"],["要求","ようきゅう"],["した"],["ので"],["、"],["神","かみ"],["は"],["ベニヤミン"],["族","ぞく"],["の"],["人","ひと"],["、"],["キス"],["の"],["子","こ"],["サウロ"],["を"],["四十","よんじゅう"],["年間","ねんかん"],["かん"],["、"],["彼","かれ"],["ら"],["に"],["おつかわし"],["に"],["なった"],["。"]]},{"verse":22,"text":"それから神,かみはサウロを退,しりぞけ、ダビデを立,たてて王,おうとされたが、彼,かれについてあかしをして、『わたしはエッサイの子,こダビデを見,みつけた。彼,かれはわたしの心,こころにかなった人,ひとで、わたしの思,おもうところを、ことごとく実行,じっこうしてくれるであろう』と言,いわれた。","tok":[["それ"],["から"],["神","かみ"],["は"],["サウロ"],["を"],["退ぞけ","しりぞけ"],["、"],["ダビデ"],["を"],["立てて","たてて"],["王","おう"],["と"],["された"],["が"],["、"],["彼","かれ"],["について"],["あかし"],["を"],["して"],["、"],["『"],["わたし"],["は"],["エッサイ"],["の"],["子","こ"],["ダビデ"],["を"],["見つけた","みつけた"],["。"],["彼","かれ"],["は"],["わたし"],["の"],["心","こころ"],["に"],["かなった"],["人","ひと"],["で"],["、"],["わたし"],["の"],["思う","おもう"],["ところ"],["を"],["、"],["ことごとく"],["実行","じっこう"],["して"],["くれるで"],["あろう"],["』"],["と"],["言われた","いわれた"],["。"]]},{"verse":23,"text":"神,かみは約束,やくそくにしたがって、このダビデの子孫,しそんの中,なかから救主,すくいぬしイエスをイスラエルに送,おくられたが、","tok":[["神","かみ"],["は"],["約束","やくそく"],["に"],["したがって"],["、"],["この"],["ダビデ"],["の"],["子孫","しそん"],["の"],["中","なか"],["から"],["救主","す"],["くい"],["ぬし"],["イエス"],["を"],["イスラエル"],["に"],["送られた","おくられた"],["が"],["、"]]},{"verse":24,"text":"そのこられる前,まえに、ヨハネがイスラエルのすべての民,たみに悔改,くいあらためのバプテスマを、あらかじめ宣,のべ伝,つたえていた。","tok":[["その"],["こられる"],["前","まえ"],["に"],["、"],["ヨハネ"],["が"],["イスラエル"],["の"],["すべて"],["の"],["民","たみ"],["に"],["悔改め","くいあらため"],["の"],["バプテスマ"],["を"],["、"],["あらかじめ"],["宣べ伝えて","のべつたえて"],["いた"],["。"]]},{"verse":25,"text":"ヨハネはその一生,いっしょうの行程,こうていを終,おわろうとするに当,あたって言,いった、『わたしは、あなたがたが考,かんがえているような者,ものではない。しかし、わたしのあとから来,くるかたがいる。わたしはそのくつを脱,ぬがせてあげる値,ねうちもない』。","tok":[["ヨハネ"],["は"],["その"],["一生","いっしょう"],["の"],["行程","こうてい"],["を"],["終わろう","おわろう"],["と"],["する"],["に"],["当たって","あたって"],["言った","いった"],["、"],["『"],["わたし"],["は"],["、"],["あなた"],["がた"],["が"],["考","かんがえ"],["て"],["いる"],["よう"],["な"],["者","もの"],["で"],["は"],["ない"],["。"],["しかし"],["、"],["わたし"],["の"],["あと"],["から"],["来る","くる"],["かた"],["が"],["いる"],["。"],["わたし"],["は"],["その"],["くつ"],["を"],["脱がせて","ぬがせて"],["あげる"],["値うち","ねうち"],["も"],["ない"],["』"],["。"]]},{"verse":26,"text":"兄弟,きょうだいたち、アブラハムの子孫,しそんのかたがた、ならびに皆,みなさんの中,なかの神,かみを敬,うやまう人,ひとたちよ。この救,すくいの言葉,ことばはわたしたちに送,おくられたのである。","tok":[["兄弟","きょうだい"],["たち"],["、"],["アブラハム"],["の"],["子孫","しそん"],["の"],["かたがた"],["、"],["ならびに"],["皆","みな"],["さん"],["の"],["中","なか"],["の"],["神","かみ"],["を"],["敬う","うやまう"],["人","ひと"],["たち"],["よ"],["。"],["この"],["救い","すくい"],["の"],["言葉","ことば"],["は"],["わたしたち"],["に"],["送られた","おくられた"],["ので"],["ある"],["。"]]},{"verse":27,"text":"エルサレムに住,すむ人々,ひとびとやその指導者,しどうしゃたちは、イエスを認,みとめずに刑,けいに処,しょし、それによって、安息日,あんそくにちごとに読,よむ預言者,よげんしゃの言葉,ことばが成就,じょうじゅした。","tok":[["エルサレム"],["に"],["住む","すむ"],["人々","ひとびと"],["や"],["その"],["指導者","しどうしゃ"],["たち"],["は"],["、"],["イエス"],["を"],["認めず","みとめず"],["に"],["刑","けい"],["に"],["処し","しょし"],["、"],["それ"],["によって"],["、"],["安息日","あんそくにちごと"],["に"],["読む","よむ"],["預言者","よげんしゃ"],["の"],["言葉","ことば"],["が"],["成就","じょうじゅ"],["した"],["。"]]},{"verse":28,"text":"また、なんら死,しに当,あたる理由,りゆうが見,みいだせなかったのに、ピラトに強要,きょうようしてイエスを殺,ころしてしまった。","tok":[["また"],["、"],["なん"],["ら"],["死","し"],["に"],["当たる","あたる"],["理由","りゆう"],["が"],["見いだせなかった","みいだせなかった"],["のに"],["、"],["ピラト"],["に"],["強要","きょうよう"],["して"],["イエス"],["を"],["殺ろして","ころして"],["しまった"],["。"]]},{"verse":29,"text":"そして、イエスについて書,かいてあることを、皆,みななし遂,とげてから、人々,ひとびとはイエスを木,きから取,とりおろして墓,はかに葬,ほうむった。","tok":[["そして"],["、"],["イエス"],["について"],["書いて","かいて"],["ある"],["こと"],["を"],["、"],["皆","みな"],["なし遂げて","なしとげて"],["から"],["、"],["人々","ひとびと"],["は"],["イエス"],["を"],["木","き"],["から"],["取","とり"],["おろして"],["墓","はか"],["に"],["葬むった","ほうむった"],["。"]]},{"verse":30,"text":"しかし、神,かみはイエスを死人,しにんの中,なかから、よみがえらせたのである。","tok":[["しかし"],["、"],["神","かみ"],["は"],["イエス"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["、"],["よみがえらせた"],["ので"],["ある"],["。"]]},{"verse":31,"text":"イエスは、ガリラヤからエルサレムへ一緒,いっしょに上,のぼった人,ひとたちに、幾日,いくにちものあいだ現,あらわれ、そして、彼,かれらは今,いまや、人々,ひとびとに対,たいしてイエスの証人,しょうにんとなっている。","tok":[["イエス"],["は"],["、"],["ガリラヤ"],["から"],["エルサレム"],["へ"],["一緒","いっしょ"],["に"],["上った","のぼった"],["人","ひと"],["たち"],["に"],["、"],["幾日","いくにちも"],["の"],["あいだ"],["現われ","あらわれ"],["、"],["そして"],["、"],["彼","かれ"],["ら"],["は"],["今","いま"],["や"],["、"],["人々","ひとびと"],["に対して","にたいして"],["イエス"],["の"],["証人","しょうにん"],["と"],["なって"],["いる"],["。"]]},{"verse":32,"text":"わたしたちは、神,かみが先祖,せんぞたちに対,たいしてなされた約束,やくそくを、ここに宣,のべ伝,つたえているのである。","tok":[["わたしたち"],["は"],["、"],["神","かみ"],["が"],["先祖","せんぞ"],["たち"],["に対して","にたいして"],["なされた"],["約束","やくそく"],["を"],["、"],["ここ"],["に"],["宣べ伝えて","のべつたえて"],["いる"],["ので"],["ある"],["。"]]},{"verse":33,"text":"神,かみは、イエスをよみがえらせて、わたしたち子孫,しそんにこの約束,やくそくを、お果,はたしになった。それは詩篇,しへんの第,だい二篇,へんにも、『あなたこそは、わたしの子,こ。きょう、わたしはあなたを生,うんだ』と書,かいてあるとおりである。","tok":[["神","かみ"],["は"],["、"],["イエス"],["を"],["よみがえらせて"],["、"],["わたしたち"],["子孫","しそん"],["に"],["この"],["約束","やくそく"],["を"],["、"],["お果たし","おはたし"],["に"],["なった"],["。"],["それ"],["は"],["詩篇","しへん"],["の"],["第","だい"],["二","に"],["篇","へん"],["に"],["も"],["、"],["『"],["あなた"],["こそ"],["は"],["、"],["わたし"],["の"],["子","こ"],["。"],["きょう"],["、"],["わたし"],["は"],["あなた"],["を"],["生んだ","うんだ"],["』"],["と"],["書いて","かいて"],["ある"],["とおり"],["で"],["ある"],["。"]]},{"verse":34,"text":"また、神,かみがイエスを死人,しにんの中,なかからよみがえらせて、いつまでも朽,くち果,はてることのないものとされたことについては、『わたしは、ダビデに約束,やくそくした確,たしかな聖,せいなる祝福,しゅくふくを、あなたがたに授,さづけよう』と言,いわれた。","tok":[["また"],["、"],["神","かみ"],["が"],["イエス"],["を"],["死人","しにん"],["の"],["中","なか"],["から"],["よみがえらせて"],["、"],["いつ"],["まで"],["も"],["朽ち","くち"],["果てる","はてる"],["こと"],["の"],["ない"],["もの"],["と"],["された"],["こと"],["について"],["は"],["、"],["『"],["わたし"],["は"],["、"],["ダビデ"],["に"],["約束","やくそく"],["した"],["確か","たしか"],["な"],["聖","せい"],["なる"],["祝福","しゅくふく"],["を"],["、"],["あなた"],["がた"],["に"],["授","さ"],["づけよう"],["』"],["と"],["言われた","いわれた"],["。"]]},{"verse":35,"text":"だから、ほかの箇所,かしょでもこう言,いっておられる、『あなたの聖者,せいじゃが朽,くち果,はてるようなことは、お許,ゆるしにならないであろう』。","tok":[["だ"],["から"],["、"],["ほか"],["の"],["箇所","かしょ"],["で"],["も"],["こう"],["言って","いって"],["おられる"],["、"],["『"],["あなた"],["の"],["聖者","せいじゃ"],["が"],["朽ち","くち"],["果てる","はてる"],["よう"],["な"],["こと"],["は"],["、"],["お許し","おゆるし"],["に"],["ならないで"],["あろう"],["』"],["。"]]},{"verse":36,"text":"事実,じじつ、ダビデは、その時代,じだいの人々,ひとびとに神,かみのみ旨,むねにしたがって仕,つかえたが、やがて眠,ねむりにつき、先祖,せんぞたちの中,なかに加,くわえられて、ついに朽,くち果,はててしまった。","tok":[["事実","じじつ"],["、"],["ダビデ"],["は"],["、"],["その"],["時代","じだい"],["の"],["人々","ひとびと"],["に"],["神","かみ"],["のみ"],["旨","むね"],["に"],["したがって"],["仕えた","つかえた"],["が"],["、"],["やがて"],["眠","ねむり"],["に"],["つき"],["、"],["先祖","せんぞ"],["たち"],["の"],["中","なか"],["に"],["加えられて","くわえられて"],["、"],["ついに"],["朽ち","くち"],["果てて","はてて"],["しまった"],["。"]]},{"verse":37,"text":"しかし、神,かみがよみがえらせたかたは、朽,くち果,はてることがなかったのである。","tok":[["しかし"],["、"],["神","かみ"],["が"],["よみがえらせた"],["かた"],["は"],["、"],["朽ち","くち"],["果てる","はてる"],["こと"],["が"],["なかった"],["ので"],["ある"],["。"]]},{"verse":38,"text":"だから、兄弟,きょうだいたちよ、この事,ことを承知,しょうちしておくがよい。すなわち、このイエスによる罪,つみのゆるしの福音,ふくいんが、今,いまやあなたがたに宣,のべ伝,つたえられている。そして、モーセの律法,りっぽうでは義,ぎとされることができなかったすべての事,ことについても、","tok":[["だ"],["から"],["、"],["兄弟","きょうだい"],["たち"],["よ"],["、"],["この"],["事","こと"],["を"],["承知","しょうち"],["して"],["おく"],["が"],["よい"],["。"],["すなわち"],["、"],["この"],["イエス"],["に"],["よる"],["罪","つみ"],["の"],["ゆるし"],["の"],["福音","ふくいん"],["が"],["、"],["今","いま"],["や"],["あなた"],["がた"],["に"],["宣べ伝えられて","のべつたえられて"],["いる"],["。"],["そして"],["、"],["モーセ"],["の"],["律法","りっぽう"],["で"],["は"],["義","ぎ"],["と"],["される"],["こと"],["が"],["できなかった"],["すべて"],["の"],["事","こと"],["について"],["も"],["、"]]},{"verse":39,"text":"信,しんじる者,ものはもれなく、イエスによって義,ぎとされるのである。","tok":[["信じる","しんじる"],["者","もの"],["は"],["もれなく"],["、"],["イエス"],["によって"],["義","ぎ"],["と"],["される"],["ので"],["ある"],["。"]]},{"verse":40,"text":"だから預言者,よげんしゃたちの書,しょにかいてある次,つぎのようなことが、あなたがたの身,みに起,おこらないように気,きをつけなさい。","tok":[["だ"],["から"],["預言者","よげんしゃ"],["たち"],["の"],["書","しょ"],["に"],["かいて"],["ある"],["次","つぎ"],["の"],["よう"],["な"],["こと"],["が"],["、"],["あなた"],["がた"],["の"],["身","み"],["に"],["起こらない","おこらない"],["よう"],["に"],["気","き"],["を"],["つけ"],["なさい"],["。"]]},{"verse":41,"text":"『見,みよ、侮,あなどる者,ものたちよ。驚,おどろけ、そして滅,ほろび去,され。わたしは、あなたがたの時代,じだいに一つの事,ことをする。それは、人,ひとがどんなに説明,せつめいして聞,きかせても、あなたがたのとうてい信,しんじないような事,ことなのである』」。","tok":[["『"],["見よ","みよ"],["、"],["侮る","あなどる"],["者","もの"],["たち"],["よ"],["。"],["驚ろけ","おどろけ"],["、"],["そして"],["滅び去れ","ほろびされ"],["。"],["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["時代","じだい"],["に"],["一","ひと"],["つ"],["の"],["事","こと"],["を"],["する"],["。"],["それ"],["は"],["、"],["人","ひと"],["が"],["どんな"],["に"],["説明","せつめい"],["して"],["聞かせて","きかせて"],["も"],["、"],["あなた"],["がた"],["の"],["とうてい"],["信じない","しんじない"],["よう"],["な"],["事","こと"],["な"],["ので"],["ある"],["』"],["」"],["。"]]},{"verse":42,"text":"ふたりが会堂,かいどうを出,でる時,とき、人々,ひとびとは次,つぎの安息日,あんそくにちにも、これと同,おなじ話,はなしをしてくれるようにと、しきりに願,ねがった。","tok":[["ふたり"],["が"],["会堂","かいどう"],["を"],["出る","でる"],["時","とき"],["、"],["人々","ひとびと"],["は"],["次","つぎ"],["の"],["安息日","あんそくにち"],["に"],["も"],["、"],["これ"],["と"],["同じ","おなじ"],["話","はなし"],["を"],["して"],["くれる"],["よう"],["に"],["と"],["、"],["しきり"],["に"],["願った","ねがった"],["。"]]},{"verse":43,"text":"そして集会,しゅうかいが終,おわってからも、大,おおぜいのユダヤ人,じんや信心,しんじん深,ぶかい改宗者,かいしゅうしゃたちが、パウロとバルナバとについてきたので、ふたりは、彼,かれらが引,ひきつづき神,かみのめぐみにとどまっているようにと、説,ときすすめた。","tok":[["そして"],["集会","しゅうかい"],["が"],["終わって","おわって"],["から"],["も"],["、"],["大ぜい","おおぜい"],["の"],["ユダヤ人","ゆだやじん"],["や"],["信心","しんじん"],["深い","ぶかい"],["改宗者","かいしゅうしゃ"],["たち"],["が"],["、"],["パウロ"],["と"],["バルナバ"],["と"],["について"],["きた"],["ので"],["、"],["ふたり"],["は"],["、"],["彼","かれ"],["ら"],["が"],["引","ひき"],["つづき"],["神","かみ"],["の"],["めぐみ"],["に"],["とどまって"],["いる"],["よう"],["に"],["と"],["、"],["説きすすめた","ときすすめた"],["。"]]},{"verse":44,"text":"次,つぎの安息日,あんそくにちには、ほとんど全市,ぜんしをあげて、神,かみの言,ことばを聞,ききに集,あつまってきた。","tok":[["次","つぎ"],["の"],["安息日","あんそくにち"],["に"],["は"],["、"],["ほとんど"],["全","ぜん"],["市","し"],["を"],["あげて"],["、"],["神","かみ"],["の"],["言","ことば"],["を"],["聞","きき"],["に"],["集まって","あつまって"],["きた"],["。"]]},{"verse":45,"text":"するとユダヤ人,じんたちは、その群衆,ぐんしゅうを見,みてねたましく思,おもい、パウロの語,かたることに口,くちぎたなく反対,はんたいした。","tok":[["する"],["と"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["その"],["群衆","ぐんしゅう"],["を"],["見て","みて"],["ねたましく"],["思い","おもい"],["、"],["パウロ"],["の"],["語る","かたる"],["こと"],["に"],["口ぎたなく","くちぎたなく"],["反対","はんたい"],["した"],["。"]]},{"verse":46,"text":"パウロとバルナバとは大胆,だいたんに語,かたった、「神,かみの言,ことばは、まず、あなたがたに語,かたり伝,つたえられなければならなかった。しかし、あなたがたはそれを退,しりぞけ、自分,じぶん自身,じしんを永遠,えいえんの命,いのちにふさわしからぬ者,ものにしてしまったから、さあ、わたしたちはこれから方向,ほうこうをかえて、異邦人,いほうじんたちの方,ほうに行,いくのだ。","tok":[["パウロ"],["と"],["バルナバ"],["と"],["は"],["大胆","だいたん"],["に"],["語った","かたった"],["、"],["「"],["神","かみ"],["の"],["言","ことば"],["は"],["、"],["まず"],["、"],["あなた"],["がた"],["に"],["語り伝えられなければ","かたりつたえられなければ"],["ならなかった"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["それ"],["を"],["退ぞけ","しりぞけ"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["永遠","えいえん"],["の"],["命","いのち"],["に"],["ふさわし"],["からぬ"],["者","もの"],["に"],["して"],["しまった"],["から"],["、"],["さあ"],["、"],["わたしたち"],["は"],["これ"],["から"],["方向","ほうこう"],["を"],["かえて"],["、"],["異邦人","いほうじん"],["たち"],["の"],["方","ほう"],["に"],["行く","いく"],["の"],["だ"],["。"]]},{"verse":47,"text":"主,しゅはわたしたちに、こう命,めいじておられる、『わたしは、あなたを立,たてて異邦人,いほうじんの光,ひかりとした。あなたが地,ちの果,はてまでも救,すくいをもたらすためである』」。","tok":[["主","しゅ"],["は"],["わたしたち"],["に"],["、"],["こう"],["命じて","めいじて"],["おられる"],["、"],["『"],["わたし"],["は"],["、"],["あなた"],["を"],["立てて","たてて"],["異邦人","いほうじん"],["の"],["光","ひかり"],["と"],["した"],["。"],["あなた"],["が"],["地","ち"],["の"],["果て","はて"],["まで"],["も"],["救い","すくい"],["を"],["もたらす"],["ため"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":48,"text":"異邦人,いほうじんたちはこれを聞,きいてよろこび、主,しゅの御言,みことばをほめたたえてやまなかった。そして、永遠,えいえんの命,いのちにあずかるように定,さだめられていた者,ものは、みな信,しんじた。","tok":[["異邦人","いほうじん"],["たち"],["は"],["これ"],["を"],["聞いて","きいて"],["よろこび"],["、"],["主","しゅ"],["の"],["御言","みこと"],["ば"],["を"],["ほめたたえて"],["やまなかった"],["。"],["そして"],["、"],["永遠","えいえん"],["の"],["命","いのち"],["に"],["あずかる"],["よう"],["に"],["定められて","さだめられて"],["いた"],["者","もの"],["は"],["、"],["みな"],["信じた","しんじた"],["。"]]},{"verse":49,"text":"こうして、主,しゅの御言,みことばはこの地方,ちほう全体,ぜんたいにひろまって行,いった。","tok":[["こう"],["して"],["、"],["主","しゅ"],["の"],["御言","みこと"],["ば"],["は"],["この"],["地方","ちほう"],["全体","ぜんたい"],["に"],["ひろまって"],["行った","いった"],["。"]]},{"verse":50,"text":"ところが、ユダヤ人,じんたちは、信心,しんじん深,ぶかい貴婦人,きふじんたちや町,まちの有力,ゆうりょく者,しゃたちを煽動,せんどうして、パウロとバルナバを迫害,はくがいさせ、ふたりをその地方,ちほうから追,おい出,ださせた。","tok":[["ところ"],["が"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["は"],["、"],["信心","しんじん"],["深い","ぶかい"],["貴婦人","きふじん"],["たち"],["や"],["町","まち"],["の"],["有力","ゆうりょく"],["者","しゃ"],["たち"],["を"],["煽動","せんどう"],["して"],["、"],["パウロ"],["と"],["バルナバ"],["を"],["迫害","はくがい"],["させ"],["、"],["ふたり"],["を"],["その"],["地方","ちほう"],["から"],["追い出させた","おいださせた"],["。"]]},{"verse":51,"text":"ふたりは、彼,かれらに向,むけて足,あしのちりを払,はらい落,おとして、イコニオムへ行,いった。","tok":[["ふたり"],["は"],["、"],["彼","かれ"],["ら"],["に"],["向けて","むけて"],["足","あし"],["の"],["ちり"],["を"],["払","はらい"],["落として","おとして"],["、"],["イコニオム"],["へ"],["行った","いった"],["。"]]},{"verse":52,"text":"弟子,でしたちは、ますます喜,よろこびと聖霊,せいれいとに満,みたされていた。","tok":[["弟子","でし"],["たち"],["は"],["、"],["ますます"],["喜こび","よろこび"],["と"],["聖霊","せいれい"],["と"],["に"],["満たされて","みたされて"],["いた"],["。"]]}]
[{"verse":1,"text":"アポロがコリントにいた時,とき、パウロは奥地,おくちをとおってエペソにきた。そして、ある弟子,でしたちに出会,であって、","tok":[["アポロ"],["が"],["コリント"],["に"],["いた"],["時","とき"],["、"],["パウロ"],["は"],["奥地","おくち"],["を"],["とおって"],["エペソ"],["に"],["きた"],["。"],["そして"],["、"],["ある"],["弟子","でし"],["たち"],["に"],["出会って","であって"],["、"]]},{"verse":2,"text":"彼,かれらに「あなたがたは、信仰,しんこうにはいった時,ときに、聖霊,せいれいを受,うけたのか」と尋,たずねたところ、「いいえ、聖霊,せいれいなるものがあることさえ、聞,きいたことがありません」と答,こたえた。","tok":[["彼","かれ"],["ら"],["に"],["「"],["あなた"],["がた"],["は"],["、"],["信仰","しんこう"],["に"],["はいった"],["時","とき"],["に"],["、"],["聖霊","せいれい"],["を"],["受た","うけた"],["の"],["か"],["」"],["と"],["尋ねた","たずねた"],["ところ"],["、"],["「"],["いいえ"],["、"],["聖霊","せいれい"],["なる"],["もの"],["が"],["ある"],["こと"],["さえ"],["、"],["聞いた","きいた"],["こと"],["が"],["ありません"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":3,"text":"「では、だれの名,なによってバプテスマを受,うけたのか」と彼,かれがきくと、彼,かれらは「ヨハネの名,なによるバプテスマを受,うけました」と答,こたえた。","tok":[["「"],["で"],["は"],["、"],["だれ"],["の"],["名","な"],["によって"],["バプテスマ"],["を"],["受た","うけた"],["の"],["か"],["」"],["と"],["彼","かれ"],["が"],["きく"],["と"],["、"],["彼","かれ"],["ら"],["は"],["「"],["ヨハネ"],["の"],["名","な"],["に"],["よる"],["バプテスマ"],["を"],["受ました","うけました"],["」"],["と"],["答","こたえ"],["た"],["。"]]},{"verse":4,"text":"そこで、パウロが言,いった、「ヨハネは悔改,くいあらためのバプテスマを授,さづけたが、それによって、自分,じぶんのあとに来,くるかた、すなわち、イエスを信,しんじるように、人々,ひとびとに勧,すすめたのである」。","tok":[["そこ"],["で"],["、"],["パウロ"],["が"],["言った","いった"],["、"],["「"],["ヨハネ"],["は"],["悔改め","くいあらため"],["の"],["バプテスマ"],["を"],["授","さ"],["づけた"],["が"],["、"],["それ"],["によって"],["、"],["自分","じぶん"],["の"],["あと"],["に"],["来る","くる"],["かた"],["、"],["すなわち"],["、"],["イエス"],["を"],["信じる","しんじる"],["よう"],["に"],["、"],["人々","ひとびと"],["に"],["勧めた","すすめた"],["ので"],["ある"],["」"],["。"]]},{"verse":5,"text":"人々,ひとびとはこれを聞,きいて、主,しゅイエスの名,なによるバプテスマを受,うけた。","tok":[["人々","ひとびと"],["は"],["これ"],["を"],["聞いて","きいて"],["、"],["主","しゅ"],["イエス"],["の"],["名","な"],["に"],["よる"],["バプテスマ"],["を"],["受た","うけた"],["。"]]},{"verse":6,"text":"そして、パウロが彼,かれらの上,うえに手,てをおくと、聖霊,せいれいが彼,かれらにくだり、それから彼,かれらは異言,いげんを語,かたったり、預言,よげんをしたりし出,だした。","tok":[["そして"],["、"],["パウロ"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["手","て"],["を"],["おく"],["と"],["、"],["聖霊","せいれい"],["が"],["彼","かれ"],["ら"],["に"],["くだり"],["、"],["それ"],["から"],["彼","かれ"],["ら"],["は"],["異言","いげん"],["を"],["語っ","かたっ"],["たり"],["、"],["預言","よげん"],["を"],["し"],["たり"],["し"],["出した","だした"],["。"]]},{"verse":7,"text":"その人,ひとたちはみんなで十二人,にんほどであった。","tok":[["その"],["人","ひと"],["たち"],["は"],["みんな"],["で"],["十二人","にん"],["ほど"],["で"],["あった"],["。"]]},{"verse":8,"text":"それから、パウロは会堂,かいどうにはいって、三か月,げつのあいだ、大胆,だいたんに神,かみの国,くにについて論,ろんじ、また勧,すすめをした。","tok":[["それ"],["から"],["、"],["パウロ"],["は"],["会堂","かいどう"],["に"],["はいって"],["、"],["三","さん"],["か月","かげつ"],["の"],["あいだ"],["、"],["大胆","だいたん"],["に"],["神","かみ"],["の"],["国","くに"],["について"],["論じ","ろんじ"],["、"],["また"],["勧め","すすめ"],["を"],["した"],["。"]]},{"verse":9,"text":"ところが、ある人,ひとたちは心,こころをかたくなにして、信,しんじようとせず、会衆,かいしゅうの前,まえでこの道,みちをあしざまに言,いったので、彼,かれは弟子,でしたちを引,ひき連,つれて、その人,ひとたちから離,はなれ、ツラノの講堂,こうどうで毎日,まいにち論,ろんじた。","tok":[["ところ"],["が"],["、"],["ある"],["人","ひと"],["たち"],["は"],["心","こころ"],["を"],["かたくな"],["に"],["して"],["、"],["信じよう","しんじよう"],["と"],["せず"],["、"],["会衆","かいしゅう"],["の"],["前","まえ"],["で"],["この"],["道","みち"],["を"],["あしざま"],["に"],["言った","いった"],["ので"],["、"],["彼","かれ"],["は"],["弟子","でし"],["たち"],["を"],["引連れて","ひきつれて"],["、"],["その"],["人","ひと"],["たち"],["から"],["離れ","はなれ"],["、"],["ツラノ"],["の"],["講堂","こうどう"],["で"],["毎日","まいにち"],["論じた","ろんじた"],["。"]]},{"verse":10,"text":"それが二年間,ねんかんも続,つづいたので、アジヤに住,すんでいる者,ものは、ユダヤ人,じんもギリシヤ人,じんも皆,みな、主,しゅの言,ことばを聞,きいた。","tok":[["それ"],["が"],["二","に"],["年間","ねんかん"],["も"],["続いた","つづいた"],["ので"],["、"],["アジヤ"],["に"],["住んで","すんで"],["いる"],["者","もの"],["は"],["、"],["ユダヤ人","ゆだやじん"],["も"],["ギリシヤ"],["人","じん"],["も"],["皆","みな"],["、"],["主","しゅ"],["の"],["言","ことば"],["を"],["聞いた","きいた"],["。"]]},{"verse":11,"text":"神,かみは、パウロの手,てによって、異常,いじょうな力,ちからあるわざを次々,つぎつぎになされた。","tok":[["神","かみ"],["は"],["、"],["パウロ"],["の"],["手","て"],["によって"],["、"],["異常","いじょう"],["な"],["力","ちから"],["ある"],["わざ"],["を"],["次々","つぎつぎ"],["に"],["なされた"],["。"]]},{"verse":12,"text":"たとえば、人々,ひとびとが、彼,かれの身,みにつけている手,てぬぐいや前掛,まえかけを取,とって病人,びょうにんにあてると、その病気,びょうきが除,のぞかれ、悪霊,あくれいが出,でて行,いくのであった。","tok":[["たとえば"],["、"],["人々","ひとびと"],["が"],["、"],["彼","かれ"],["の"],["身","み"],["に"],["つけて"],["いる"],["手ぬぐい","てぬぐい"],["や"],["前掛","まえかけ"],["を"],["取って","とって"],["病人","びょうにん"],["に"],["あてる"],["と"],["、"],["その"],["病気","びょうき"],["が"],["除かれ","のぞかれ"],["、"],["悪霊","あ"],["く"],["れい"],["が"],["出て","でて"],["行く","いく"],["ので"],["あった"],["。"]]},{"verse":13,"text":"そこで、ユダヤ人,じんのまじない師,しで、遍歴,へんれきしている者,ものたちが、悪霊,あくれいにつかれている者,ものにむかって、主,しゅイエスの名,なをとなえ、「パウロの宣,のべ伝,つたえているイエスによって命,めいじる。出,でて行,いけ」と、ためしに言,いってみた。","tok":[["そこ"],["で"],["、"],["ユダヤ人","ゆだやじん"],["の"],["まじない"],["師","し"],["で"],["、"],["遍歴","へんれき"],["して"],["いる"],["者","もの"],["たち"],["が"],["、"],["悪霊","あくれい"],["に"],["つかれて"],["いる"],["者","もの"],["に"],["むかって"],["、"],["主","しゅ"],["イエス"],["の"],["名","な"],["を"],["となえ"],["、"],["「"],["パウロ"],["の"],["宣べ伝えて","のべつたえて"],["いる"],["イエス"],["によって"],["命じる","めいじる"],["。"],["出て","でて"],["行け","いけ"],["」"],["と"],["、"],["ためし"],["に"],["言って","いって"],["みた"],["。"]]},{"verse":14,"text":"ユダヤの祭司長,さいしちょうスケワという者,ものの七人,にんのむすこたちも、そんなことをしていた。","tok":[["ユダヤ"],["の"],["祭","まつり"],["司長","しちょう"],["スケワ"],["と"],["いう"],["者","もの"],["の"],["七人","にん"],["の"],["むすこ"],["たち"],["も"],["、"],["そんな"],["こと"],["を"],["して"],["いた"],["。"]]},{"verse":15,"text":"すると悪霊,あくれいがこれに対,たいして言,いった、「イエスなら自分,じぶんは知,しっている。パウロもわかっている。だが、おまえたちは、いったい何者,なにものだ」。","tok":[["する"],["と"],["悪霊","あくれいがこれ"],["に対して","にたいして"],["言った","いった"],["、"],["「"],["イエス"],["なら"],["自分","じぶん"],["は"],["知って","しって"],["いる"],["。"],["パウロ"],["も"],["わかって"],["いる"],["。"],["だ"],["が"],["、"],["おまえ"],["たち"],["は"],["、"],["いったい"],["何者","なにもの"],["だ"],["」"],["。"]]},{"verse":16,"text":"そして、悪霊,あくれいにつかれている人,ひとが、彼,かれらに飛,とびかかり、みんなを押,おさえつけて負,まかしたので、彼,かれらは傷,きずを負,おったまま裸,はだかになって、その家,いえを逃,にげ出,だした。","tok":[["そして"],["、"],["悪霊","あくれい"],["に"],["つかれて"],["いる"],["人","ひと"],["が"],["、"],["彼","かれ"],["ら"],["に"],["飛びかかり","とびかかり"],["、"],["みんな"],["を"],["押さえつけて","おさえつけて"],["負かした","まかした"],["ので"],["、"],["彼","かれ"],["ら"],["は"],["傷","きず"],["を"],["負った","おった"],["まま"],["裸","はだか"],["に"],["なって"],["、"],["その"],["家","いえ"],["を"],["逃出した","にげだした"],["。"]]},{"verse":17,"text":"このことがエペソに住,すむすべてのユダヤ人,じんやギリシヤ人,じんに知,しれわたって、みんな恐怖,きょうふに襲,おそわれ、そして、主,しゅイエスの名,ながあがめられた。","tok":[["この"],["こと"],["が"],["エペソ"],["に"],["住む","すむ"],["すべて"],["の"],["ユダヤ人","ゆだやじん"],["や"],["ギリシヤ"],["人","じん"],["に"],["知れわたって","しれわたって"],["、"],["みんな"],["恐怖","きょうふ"],["に"],["襲れ","おそわれ"],["、"],["そして"],["、"],["主","しゅ"],["イエス"],["の"],["名","な"],["が"],["あがめられた"],["。"]]},{"verse":18,"text":"また信者,しんじゃになった者,ものが大,おおぜいきて、自分,じぶんの行為,こういを打,うちあけて告白,こくはくした。","tok":[["また"],["信者","しんじゃ"],["に"],["なった"],["者","もの"],["が"],["大ぜい","おおぜい"],["きて"],["、"],["自分","じぶん"],["の"],["行為","こうい"],["を"],["打ちあけて","うちあけて"],["告白","こくはく"],["した"],["。"]]},{"verse":19,"text":"それから、魔術,まじゅつを行,おこなっていた多,おおくの者,ものが、魔術,まじゅつの本,ほんを持,もち出,だしてきては、みんなの前,まえで焼,やき捨,すてた。その値段,ねだんを総計,そうけいしたところ、銀,ぎん五万にも上,のぼることがわかった。","tok":[["それ"],["から"],["、"],["魔術","まじゅつ"],["を"],["行なって","おこなって"],["いた"],["多く","おおく"],["の"],["者","もの"],["が"],["、"],["魔術","まじゅつ"],["の"],["本","ほん"],["を"],["持出して","もちだして"],["き"],["ては"],["、"],["みんな"],["の"],["前","まえ"],["で"],["焼き捨てた","やきすてた"],["。"],["その"],["値段","ねだん"],["を"],["総計","そうけい"],["した"],["ところ"],["、"],["銀","ぎん"],["五万","ごまん"],["に"],["も"],["上る","のぼる"],["こと"],["が"],["わかった"],["。"]]},{"verse":20,"text":"このようにして、主,しゅの言,ことばはますます盛,さかんにひろまり、また力,ちからを増,まし加,くわえていった。","tok":[["この"],["よう"],["に"],["して"],["、"],["主","しゅ"],["の"],["言","ことば"],["は"],["ますます"],["盛","さかん"],["に"],["ひろまり"],["、"],["また"],["力","ちから"],["を"],["増し加えて","ましくわえて"],["いった"],["。"]]},{"verse":21,"text":"これらの事,ことがあった後,のち、パウロは御霊,みたまに感,かんじて、マケドニヤ、アカヤをとおって、エルサレムへ行,いく決心,けっしんをした。そして言,いった、「わたしは、そこに行,いったのち、ぜひローマをも見,みなければならない」。","tok":[["これ"],["ら"],["の"],["事","こと"],["が"],["あった"],["後","の"],["ち"],["、"],["パウロ"],["は"],["御霊","みたま"],["に"],["感じて","かんじて"],["、"],["マケドニヤ"],["、"],["アカヤ"],["を"],["とおって"],["、"],["エルサレム"],["へ"],["行く","いく"],["決心","けっしん"],["を"],["した"],["。"],["そして"],["言った","いった"],["、"],["「"],["わたし"],["は"],["、"],["そこ"],["に"],["行った","いった"],["のち"],["、"],["ぜひ"],["ローマ"],["を"],["も"],["見なければ","みなければ"],["ならない"],["」"],["。"]]},{"verse":22,"text":"そこで、自分,じぶんに仕,つかえている者,ものの中,なかから、テモテとエラストとのふたりを、まずマケドニヤに送,おくり出,だし、パウロ自身,じしんは、なおしばらくアジヤにとどまった。","tok":[["そこ"],["で"],["、"],["自分","じぶん"],["に"],["仕えて","つかえて"],["いる"],["者","もの"],["の"],["中","なか"],["から"],["、"],["テモテ"],["と"],["エラスト"],["と"],["の"],["ふたり"],["を"],["、"],["まず"],["マケドニヤ"],["に"],["送り出し","おくりだし"],["、"],["パウロ"],["自身","じしん"],["は"],["、"],["なお"],["しばらく"],["アジヤ"],["に"],["とどまった"],["。"]]},{"verse":23,"text":"そのころ、この道,みちについて容易,よういならぬ騒動,そうどうが起,おこった。","tok":[["その"],["ころ"],["、"],["この"],["道","みち"],["について"],["容易","ようい"],["ならぬ"],["騒動","そうどう"],["が"],["起こった","おこった"],["。"]]},{"verse":24,"text":"そのいきさつは、こうである。デメテリオという銀細工人,ぎんざいくにんが、銀,ぎんでアルテミス神殿,しんでんの模型,もけいを造,つくって、職人,しょくにんたちに少,すくなからぬ利益,りえきを得,えさせていた。","tok":[["その"],["いきさつ"],["は"],["、"],["こう"],["で"],["ある"],["。"],["デメテリオ"],["と"],["いう"],["銀","ぎん"],["細工人","さいくにん"],["ざいく"],["に"],["ん"],["が"],["、"],["銀","ぎん"],["で"],["アルテミス"],["神殿","しんでん"],["の"],["模型","もけい"],["を"],["造って","つくって"],["、"],["職人","しょくにん"],["たち"],["に"],["少なからぬ","すくなからぬ"],["利益","りえき"],["を"],["得させて","えさせて"],["いた"],["。"]]},{"verse":25,"text":"この男,おとこがその職人,しょくにんたちや、同類,どうるいの仕事,しごとをしていた者,ものたちを集,あつめて言,いった、「諸君,しょくん、われわれがこの仕事,しごとで、金,かねもうけをしていることは、ご承知,しょうちのとおりだ。","tok":[["この"],["男","おとこ"],["が"],["その"],["職人","しょくにん"],["たち"],["や"],["、"],["同類","どうるい"],["の"],["仕事","しごと"],["を"],["して"],["いた"],["者","もの"],["たち"],["を"],["集めて","あつめて"],["言った","いった"],["、"],["「"],["諸君","しょくん"],["、"],["われわれ"],["が"],["この"],["仕事","しごと"],["で"],["、"],["金もうけ","かねもうけ"],["を"],["して"],["いる"],["こと"],["は"],["、"],["ご承知","ごしょうち"],["の"],["とおり"],["だ"],["。"]]},{"verse":26,"text":"しかるに、諸君,しょくんの見聞,みききしているように、あのパウロが、手,てで造,つくられたものは神様,かみさまではないなどと言,いって、エペソばかりか、ほとんどアジヤ全体,ぜんたいにわたって、大,おおぜいの人々,ひとびとを説,ときつけて誤,あやまらせた。","tok":[["しかる"],["に"],["、"],["諸君","しょくん"],["の"],["見聞き","みきき"],["して"],["いる"],["よう"],["に"],["、"],["あの"],["パウロ"],["が"],["、"],["手","て"],["で"],["造られた","つくられた"],["もの"],["は"],["神様","かみさま"],["で"],["は"],["ない"],["など"],["と"],["言って","いって"],["、"],["エペソ"],["ばかり"],["か"],["、"],["ほとんど"],["アジヤ"],["全体","ぜんたい"],["に"],["わたって"],["、"],["大ぜい","おおぜい"],["の"],["人々","ひとびと"],["を"],["説きつけて","ときつけて"],["誤らせた","あやまらせた"],["。"]]},{"verse":27,"text":"これでは、お互,たがいの仕事,しごとに悪評,あくひょうが立,たつおそれがあるばかりか、大,おお女神,めがみアルテミスの宮,みやも軽,かろんじられ、ひいては全,ぜんアジヤ、いや全,ぜん世界,せかいが拝,おがんでいるこの大,おお女神,めがみのご威光,いこうさえも、消,きえてしまいそうである」。","tok":[["これ"],["で"],["は"],["、"],["お互","おたがい"],["の"],["仕事","しごと"],["に"],["悪評","あくひょう"],["が"],["立つ","たつ"],["おそれ"],["が"],["ある"],["ばかり"],["か"],["、"],["大","お"],["お女神","おめがみ"],["アルテミス"],["の"],["宮","みや"],["も"],["軽んじられ","かろんじられ"],["、"],["ひいては"],["全","ぜん"],["アジヤ"],["、"],["いや"],["全","ぜん"],["世界","せかい"],["が"],["拝んで","おがんで"],["いる"],["この"],["大","お"],["お女神","おめがみ"],["の"],["ご威光","ごいこう"],["さえ"],["も"],["、"],["消えて","きえて"],["しまい"],["そう"],["で"],["ある"],["」"],["。"]]},{"verse":28,"text":"これを聞,きくと、人々,ひとびとは怒,いかりに燃,もえ、大声,おおごえで「大,おおいなるかな、エペソ人,びとのアルテミス」と叫,さけびつづけた。","tok":[["これ"],["を"],["聞く","きく"],["と"],["、"],["人々","ひとびと"],["は"],["怒り","いかり"],["に"],["燃え","もえ"],["、"],["大声","おおごえ"],["で"],["「"],["大いなる","おおいなる"],["か"],["な"],["、"],["エペソ人","えぺそびと"],["の"],["アルテミス"],["」"],["と"],["叫","さけび"],["つづけた"],["。"]]},{"verse":29,"text":"そして、町中,まちじゅうが大,だい混乱,こんらんに陥,おちいり、人々,ひとびとはパウロの道連,みちづれであるマケドニヤ人,びとガイオとアリスタルコとを捕,とらえて、いっせいに劇場,げきじょうへなだれ込,こんだ。","tok":[["そして"],["、"],["町中","ま"],["ち"],["じゅう"],["が"],["大","だい"],["混乱","こんらん"],["に"],["陥ち","おち"],["いり"],["、"],["人々","ひとびと"],["は"],["パウロ"],["の"],["道連れ","みちづれ"],["で"],["ある"],["マケドニヤ"],["人","び"],["と"],["ガイオ"],["と"],["アリスタルコ"],["と"],["を"],["捕らえて","とらえて"],["、"],["いっせい"],["に"],["劇場","げきじょう"],["へ"],["なだれ込んだ","なだれこんだ"],["。"]]},{"verse":30,"text":"パウロは群衆,ぐんしゅうの中,なかにはいって行,いこうとしたが、弟子,でしたちがそれをさせなかった。","tok":[["パウロ"],["は"],["群衆","ぐんしゅう"],["の"],["中","なか"],["に"],["はいって"],["行こう","いこう"],["と"],["した"],["が"],["、"],["弟子","でし"],["たち"],["が"],["それ"],["を"],["させなかった"],["。"]]},{"verse":31,"text":"アジヤ州,しゅうの議員,ぎいんで、パウロの友人,ゆうじんであった人,ひとたちも、彼,かれに使,つかいをよこして、劇場,げきじょうにはいって行,いかないようにと、しきりに頼,たのんだ。","tok":[["アジヤ"],["州","しゅう"],["の"],["議員","ぎいん"],["で"],["、"],["パウロ"],["の"],["友人","ゆうじん"],["で"],["あった"],["人","ひと"],["たち"],["も"],["、"],["彼","かれ"],["に"],["使","つかい"],["を"],["よこして"],["、"],["劇場","げきじょう"],["に"],["はいって"],["行かない","いかない"],["よう"],["に"],["と"],["、"],["しきり"],["に"],["頼んだ","たのんだ"],["。"]]},{"verse":32,"text":"中,なかでは、集会,しゅうかいが混乱,こんらんに陥,おちいってしまって、ある者,ものはこのことを、ほかの者,ものはあのことを、どなりつづけていたので、大多数,だいたすうの者,ものは、なんのために集,あつまったのかも、わからないでいた。","tok":[["中","なか"],["で"],["は"],["、"],["集会","しゅうかい"],["が"],["混乱","こんらん"],["に"],["陥て","おちいって"],["しまって"],["、"],["ある"],["者","もの"],["は"],["この"],["こと"],["を"],["、"],["ほか"],["の"],["者","もの"],["は"],["あの"],["こと"],["を"],["、"],["どなり"],["つづけて"],["いた"],["ので"],["、"],["大多数","だいたすう"],["の"],["者","もの"],["は"],["、"],["なん"],["の"],["ため"],["に"],["集まった","あつまった"],["の"],["か"],["も"],["、"],["わからないで"],["いた"],["。"]]},{"verse":33,"text":"そこで、ユダヤ人,じんたちが、前,まえに押,おし出,だしたアレキサンデルなる者,ものを、群衆,ぐんしゅうの中,なかのある人,ひとたちが促,うながしたため、彼,かれは手,てを振,ふって、人々,ひとびとに弁明,べんめいを試,こころみようとした。","tok":[["そこ"],["で"],["、"],["ユダヤ人","ゆだやじん"],["たち"],["が"],["、"],["前","まえ"],["に"],["押出した","おしだした"],["アレキサンデル"],["なる"],["者","もの"],["を"],["、"],["群衆","ぐんしゅう"],["の"],["中","なか"],["の"],["ある"],["人","ひと"],["たち"],["が"],["促がした","うながした"],["ため"],["、"],["彼","かれ"],["は"],["手","て"],["を"],["振って","ふって"],["、"],["人々","ひとびと"],["に"],["弁明","べんめい"],["を"],["試みよう","こころみよう"],["と"],["した"],["。"]]},{"verse":34,"text":"ところが、彼,かれがユダヤ人,じんだとわかると、みんなの者,ものがいっせいに「大,おおいなるかな、エペソ人,びとのアルテミス」と二時間,じかんばかりも叫,さけびつづけた。","tok":[["ところ"],["が"],["、"],["彼","かれ"],["が"],["ユダヤ人","ゆだやじん"],["だ"],["と"],["わかる"],["と"],["、"],["みんな"],["の"],["者","もの"],["が"],["いっせい"],["に"],["「"],["大いなる","おおいなる"],["か"],["な"],["、"],["エペソ人","えぺそびと"],["の"],["アルテミス"],["」"],["と"],["二","に"],["時間","じかん"],["も"],["叫","さけび"],["つづけた"],["。"]]},{"verse":35,"text":"ついに、市,しの書記,しょき役,やくが群衆,ぐんしゅうを押,おし静,しずめて言,いった、「エペソの諸君,しょくん、エペソ市,しが大,おお女神,めがみアルテミスと、天,あまくだったご神体,しんたいとの守護,しゅご役,やくであることを知,しらない者,ものが、ひとりでもいるだろうか。","tok":[["ついに"],["、"],["市","し"],["の"],["書記","しょき"],["役","やく"],["が"],["群衆","ぐんしゅう"],["を"],["押","おし"],["静めて","しずめて"],["言った","いった"],["、"],["「"],["エペソ"],["の"],["諸君","しょくん"],["、"],["エペソ"],["市","し"],["が"],["大","お"],["お女神","おめがみ"],["アルテミス"],["と"],["、"],["天","あ"],["まく"],["だった"],["ご神体","ごしんたい"],["と"],["の"],["守護","しゅご"],["役","やく"],["で"],["ある"],["こと"],["を"],["知らない","しらない"],["者","もの"],["が"],["、"],["ひとり"],["で"],["も"],["いるだろう"],["か"],["。"]]},{"verse":36,"text":"これは否定,ひていのできない事実,じじつであるから、諸君,しょくんはよろしく静,しずかにしているべきで、乱暴,らんぼうな行動,こうどうは、いっさいしてはならない。","tok":[["これ"],["は"],["否定","ひてい"],["の"],["できない"],["事実","じじつ"],["で"],["ある"],["から"],["、"],["諸君","しょくん"],["は"],["よろしく"],["静","しずか"],["に"],["して"],["いるべきで"],["、"],["乱暴","らんぼう"],["な"],["行動","こうどう"],["は"],["、"],["いっさい"],["して"],["は"],["ならない"],["。"]]},{"verse":37,"text":"諸君,しょくんはこの人,ひとたちをここにひっぱってきたが、彼,かれらは宮,みやを荒,あらす者,ものでも、われわれの女神,めがみをそしる者,ものでもない。","tok":[["諸君","しょくん"],["は"],["この"],["人","ひと"],["たち"],["を"],["ここ"],["に"],["ひっぱって"],["きた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["宮","みや"],["を"],["荒す","あらす"],["者","もの"],["で"],["も"],["、"],["われわれ"],["の"],["女神","めがみ"],["を"],["そしる"],["者","もの"],["で"],["も"],["ない"],["。"]]},{"verse":38,"text":"だから、もしデメテリオなりその職人,しょくにん仲間,なかまなりが、だれかに対,たいして訴,うったえ事,ことがあるなら、裁判,さいばんの日,ひはあるし、総督,そうとくもいるのだから、それぞれ訴,うったえ出,でるがよい。","tok":[["だ"],["から"],["、"],["もし"],["デメテリオ"],["なり"],["その"],["職人","しょくにん"],["仲間","なかま"],["なり"],["が"],["、"],["だれ"],["か"],["に対して","にたいして"],["訴","うったえ"],["事","こと"],["が"],["あるなら"],["、"],["裁判","さいばん"],["の"],["日","ひ"],["は"],["ある"],["し"],["、"],["総督","そうとく"],["も"],["いる"],["の"],["だ"],["から"],["、"],["それぞれ"],["訴","うったえ"],["出る","でる"],["が"],["よい"],["。"]]},{"verse":39,"text":"しかし、何,なにかもっと要求,ようきゅうしたい事,ことがあれば、それは正式,せいしきの議会,ぎかいで解決,かいけつしてもらうべきだ。","tok":[["しかし"],["、"],["何に","なに"],["か"],["もっと"],["要求","ようきゅう"],["したい"],["事","こと"],["が"],["あれば"],["、"],["それ"],["は"],["正式","せいしき"],["の"],["議会","ぎかい"],["で"],["解決","かいけつ"],["して"],["もらうべきだ"],["。"]]},{"verse":40,"text":"きょうの事件,じけんについては、この騒,さわぎを弁護,べんごできるような理由,りゆうが全,まったくないのだから、われわれは治安,ちあんをみだす罪,つみに問,とわれるおそれがある」。[41]こう言,いって、彼,かれはこの集会,しゅうかいを解散,かいさんさせた。","tok":[["きょう"],["の"],["事件","じけん"],["について"],["は"],["、"],["この"],["騒","さわぎ"],["を"],["弁護","べんご"],["できる"],["よう"],["な"],["理由","りゆう"],["が"],["全く","まったく"],["ない"],["の"],["だ"],["から"],["、"],["われわれ"],["は"],["治安","ちあん"],["を"],["みだす"],["罪","つみ"],["に"],["問われる","とわれる"],["おそれ"],["が"],["ある"],["」"],["。"],["["],["41"],["]"],["こう"],["言って","いって"],["、"],["彼","かれ"],["は"],["この"],["集会","しゅうかい"],["を"],["解散","かいさん"],["させた"],["。"]]}]
[{"verse":1,"text":"ルベンの子孫,しそんとガドの子孫,しそんとは非常,ひじょうに多,おおくの家畜,かちくの群,むれを持,もっていた。彼,かれらがヤゼルの地,ちと、ギレアデの地,ちとを見,みると、そこは家畜,かちくを飼,かうのに適,てきしていたので、","tok":[["ルベン"],["の"],["子孫","しそん"],["と"],["ガド"],["の"],["子孫","しそん"],["と"],["は"],["非常","ひじょう"],["に"],["多く","おおく"],["の"],["家畜","かちく"],["の"],["群れ","むれ"],["を"],["持って","もって"],["いた"],["。"],["彼","かれ"],["ら"],["が"],["ヤゼル"],["の"],["地","ち"],["と"],["、"],["ギレアデ"],["の"],["地","ち"],["と"],["を"],["見る","みる"],["と"],["、"],["そこ"],["は"],["家畜","かちく"],["を"],["飼う","かう"],["のに"],["適して","てきして"],["いた"],["ので"],["、"]]},{"verse":2,"text":"ガドの子孫,しそんとルベンの子孫,しそんとがきて、モーセと、祭司,さいしエレアザルと、会衆,かいしゅうのつかさたちとに言,いった、","tok":[["ガド"],["の"],["子孫","しそん"],["と"],["ルベン"],["の"],["子孫","しそん"],["と"],["が"],["きて"],["、"],["モーセ"],["と"],["、"],["祭司","さいし"],["エレアザル"],["と"],["、"],["会衆","かいしゅう"],["の"],["つかさ"],["たち"],["と"],["に"],["言った","いった"],["、"]]},{"verse":3,"text":"「アタロテ、デボン、ヤゼル、ニムラ、ヘシボン、エレアレ、シバム、ネボ、ベオン、","tok":[["「"],["アタロテ"],["、"],["デボン"],["、"],["ヤゼル"],["、"],["ニムラ"],["、"],["ヘシボン"],["、"],["エレアレ"],["、"],["シバム"],["、"],["ネボ"],["、"],["ベオン"],["、"]]},{"verse":4,"text":"すなわち主,しゅがイスラエルの会衆,かいしゅうの前,まえに撃,うち滅,ほろぼされた国,くには、家畜,かちくを飼,かうのに適,てきした地,ちですが、しもべらは家畜,かちくを持,もっています」。","tok":[["すなわち"],["主","しゅ"],["が"],["イスラエル"],["の"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["撃ち","うち"],["滅ぼされた","ほろぼされた"],["国","くに"],["は"],["、"],["家畜","かちく"],["を"],["飼う","かう"],["のに"],["適した","てきした"],["地","ち"],["です"],["が"],["、"],["しもべ"],["ら"],["は"],["家畜","かちく"],["を"],["持って","もって"],["います"],["」"],["。"]]},{"verse":5,"text":"彼,かれらはまた言,いった、「それでもし、あなたの恵,めぐみを得,えられますなら、どうぞこの地,ちをしもべらの領地,りょうちにして、われわれにヨルダンを渡,わたらせないでください」。","tok":[["彼","かれ"],["ら"],["は"],["また"],["言った","いった"],["、"],["「"],["それ"],["で"],["も"],["し"],["、"],["あなた"],["の"],["恵","めぐみ"],["を"],["得られますなら","えられますなら"],["、"],["どうぞ"],["この"],["地","ち"],["を"],["しもべ"],["ら"],["の"],["領地","りょうち"],["に"],["して"],["、"],["われわれ"],["に"],["ヨルダン"],["を"],["渡らせないで","わたらせないで"],["ください"],["」"],["。"]]},{"verse":6,"text":"モーセはガドの子孫,しそんとルベンの子孫,しそんとに言,いった、「あなたがたは兄弟,きょうだいが戦,たたかいに行,いくのに、ここにすわっていようというのか。","tok":[["モーセ"],["は"],["ガド"],["の"],["子孫","しそん"],["と"],["ルベン"],["の"],["子孫","しそん"],["と"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["兄弟","きょうだい"],["が"],["戦い","たたかい"],["に"],["行く","いく"],["のに"],["、"],["ここ"],["に"],["すわって"],["いよう"],["と"],["いう"],["の"],["か"],["。"]]},{"verse":7,"text":"どうしてあなたがたはイスラエルの人々,ひとびとの心,こころをくじいて、主,しゅが彼,かれらに与,あたえられる地,ちに渡,わたることができないようにするのか。","tok":[["どう"],["して"],["あなた"],["がた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["心","こころ"],["を"],["くじいて"],["、"],["主","しゅ"],["が"],["彼","かれ"],["ら"],["に"],["与えられる","あたえられる"],["地","ち"],["に"],["渡る","わたる"],["こと"],["が"],["できない"],["よう"],["に"],["する"],["の"],["か"],["。"]]},{"verse":8,"text":"あなたがたの先祖,せんぞも、わたしがカデシ・バルネアから、その地,ちを見,みるためにつかわした時,ときに、同,おなじようなことをした。","tok":[["あなた"],["がた"],["の"],["先祖","せんぞ"],["も"],["、"],["わたし"],["が"],["カデシ"],["・"],["バルネア"],["から"],["、"],["その"],["地","ち"],["を"],["見る","みる"],["ため"],["に"],["つかわした"],["時","とき"],["に"],["、"],["同じ","おなじ"],["よう"],["な"],["こと"],["を"],["した"],["。"]]},{"verse":9,"text":"すなわち彼,かれらはエシコルの谷,たにに行,いって、その地,ちを見,みたとき、イスラエルの人々,ひとびとの心,こころをくじいて、主,しゅが与,あたえられる地,ちに行,いくことができないようにした。","tok":[["すなわち"],["彼","かれ"],["ら"],["は"],["エシコル"],["の"],["谷","たに"],["に"],["行って","いって"],["、"],["その"],["地","ち"],["を"],["見た","みた"],["とき"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["心","こころ"],["を"],["くじいて"],["、"],["主","しゅ"],["が"],["与えられる","あたえられる"],["地","ち"],["に"],["行く","いく"],["こと"],["が"],["できない"],["よう"],["に"],["した"],["。"]]},{"verse":10,"text":"そこでその時,とき、主,しゅは怒,いかりを発,はっし、誓,ちかって言,いわれた、","tok":[["そこ"],["で"],["その"],["時","とき"],["、"],["主","しゅ"],["は"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["誓って","ちかって"],["言われた","いわれた"],["、"]]},{"verse":11,"text":"『エジプトから出,でてきた人々,ひとびとで二十歳,さい以上,いじょうの者,ものはひとりもわたしがアブラハム、イサク、ヤコブに誓,ちかった地,ちを見,みることはできない。彼,かれらはわたしに従,したがわなかったからである。","tok":[["『"],["エジプト"],["から"],["出て","でて"],["きた"],["人々","ひとびと"],["で"],["二十歳","さ"],["い"],["以上","いじょう"],["の"],["者","もの"],["は"],["ひとり"],["も"],["わたし"],["が"],["アブラハム"],["、"],["イサク"],["、"],["ヤコブ"],["に"],["誓った","ちかった"],["地","ち"],["を"],["見る","みる"],["こと"],["は"],["できない"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["従わなかった","したがわなかった"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"ただケニズびとエフンネの子,こカレブとヌンの子,こヨシュアとはそうではない。このふたりは全,まったく主,しゅに従,したがったからである』。","tok":[["ただ"],["ケニズ"],["びと"],["エフンネ"],["の"],["子","こ"],["カレブ"],["と"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["は"],["そう"],["で"],["は"],["ない"],["。"],["この"],["ふたり"],["は"],["全く","まったく"],["主に","しゅに"],["従った","したがった"],["から"],["で"],["ある"],["』"],["。"]]},{"verse":13,"text":"主,しゅはこのようにイスラエルにむかって怒,いかりを発,はっし、彼,かれらを四十年,ねんのあいだ荒野,あらのにさまよわされたので、主,しゅの前,まえに悪,あくを行,おこなったその世代,せだいの人々,ひとびとは、ついにみな滅,ほろびた。","tok":[["主","しゅ"],["は"],["この"],["よう"],["に"],["イスラエル"],["に"],["むかって"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["彼","かれ"],["ら"],["を"],["四十","よんじゅう"],["年","ねん"],["の"],["あいだ"],["荒野","あらの"],["に"],["さまよわ"],["された"],["ので"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["悪","あく"],["を"],["行なった","おこなった"],["その"],["世代","せだい"],["の"],["人々","ひとびと"],["は"],["、"],["ついに"],["みな"],["滅びた","ほろびた"],["。"]]},{"verse":14,"text":"あなたがたはその父,ちちに代,かわって立,たった罪,つみびとのやからであって、主,しゅのイスラエルに対,たいする激,はげしい怒,いかりをさらに増,まそうとしている。","tok":[["あなた"],["がた"],["は"],["その"],["父","ちち"],["に"],["代わって","かわって"],["立った","たった"],["罪びと","つみびと"],["の"],["やから"],["で"],["あって"],["、"],["主","しゅ"],["の"],["イスラエル"],["に"],["対する","たいする"],["激しい","はげしい"],["怒り","いかり"],["を"],["さらに"],["増そう","まそう"],["として"],["いる"],["。"]]},{"verse":15,"text":"あなたがたがもしそむいて主,しゅに従,したがわないならば、主,しゅはまたこの民,たみを荒野,あらのにすておかれるであろう。そうすればあなたがたはこの民,たみをことごとく滅,ほろぼすに至,いたるであろう」。","tok":[["あなた"],["がた"],["が"],["もし"],["そむいて"],["主に","しゅに"],["従わないならば","したがわないならば"],["、"],["主","しゅ"],["は"],["また"],["この"],["民","たみ"],["を"],["荒野","あらの"],["に"],["すておかれるで"],["あろう"],["。"],["そう"],["すれば"],["あなた"],["がた"],["は"],["この"],["民","たみ"],["を"],["ことごとく"],["滅ぼす","ほろぼす"],["に"],["至るで","いたるで"],["あろう"],["」"],["。"]]},{"verse":16,"text":"彼,かれらはモーセのところへ進,すすみ寄,よって言,いった、「われわれはこの所,ところに、群,むれのために羊,ひつじのおりを建,たて、また子供,こどもたちのために町々,まちまちを建,たてようと思,おもいます。","tok":[["彼","かれ"],["ら"],["は"],["モーセ"],["の"],["ところ"],["へ"],["進み寄って","すすみよって"],["言った","いった"],["、"],["「"],["われわれ"],["は"],["この"],["所","ところ"],["に"],["、"],["群れ","むれ"],["の"],["ため"],["に"],["羊","ひつじ"],["の"],["おり"],["を"],["建て","たて"],["、"],["また"],["子供","こども"],["たち"],["の"],["ため"],["に"],["町々","まちまち"],["を"],["建てよう","たてよう"],["と"],["思います","おもいます"],["。"]]},{"verse":17,"text":"しかし、われわれは武装,ぶそうしてイスラエルの人々,ひとびとの前,まえに進,すすみ、彼,かれらをその所,ところへ導,みちびいて行,いきましょう。ただわれわれの子供,こどもたちは、この地,ちの住民,じゅうみんの害,がいをのがれるため、堅固,けんごな町々,まちまちに住,すませておかなければなりません。","tok":[["しかし"],["、"],["われわれ"],["は"],["武装","ぶそう"],["して"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["進み","すすみ"],["、"],["彼","かれ"],["ら"],["を"],["その"],["所","ところ"],["へ"],["導いて","みちびいて"],["行きましょう","いきましょう"],["。"],["ただ"],["われわれ"],["の"],["子供","こども"],["たち"],["は"],["、"],["この"],["地","ち"],["の"],["住民","じゅうみん"],["の"],["害","がい"],["を"],["のがれる"],["ため"],["、"],["堅固","けんご"],["な"],["町々","まちまち"],["に"],["住ませて","すませて"],["おかなければ"],["なりません"],["。"]]},{"verse":18,"text":"われわれはイスラエルの人々,ひとびとが、おのおのその嗣,し業,ぎょうを受,うけるまでは、家,いえに帰,かえりません。","tok":[["われわれ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["おのおの"],["その"],["嗣業","しぎょう"],["を"],["受る","うける"],["まで"],["は"],["、"],["家","いえ"],["に"],["帰えりません","かえりません"],["。"]]},{"verse":19,"text":"またわれわれはヨルダンのかなたで彼,かれらとともには嗣,し業,ぎょうを受,うけません。われわれはヨルダンのこなた、すなわち東,ひがしの方,ほうで嗣,し業,ぎょうを受,うけるからです」。","tok":[["また"],["われわれ"],["は"],["ヨルダン"],["の"],["かなた"],["で"],["彼","かれ"],["ら"],["と"],["とも"],["に"],["は"],["嗣業","しぎょう"],["を"],["受ません","うけません"],["。"],["われわれ"],["は"],["ヨルダン"],["の"],["こなた"],["、"],["すなわち"],["東","ひがし"],["の"],["方","ほう"],["で"],["嗣業","しぎょう"],["を"],["受る","うける"],["から"],["です"],["」"],["。"]]},{"verse":20,"text":"モーセは彼,かれらに言,いった、「もし、あなたがたがそのようにし、みな武装,ぶそうして主,しゅの前,まえに行,いって戦,たたかい、","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["もし"],["、"],["あなた"],["がた"],["が"],["その"],["よう"],["に"],["し"],["、"],["みな"],["武装","ぶそう"],["して"],["主","しゅ"],["の"],["前","まえ"],["に"],["行って","いって"],["戦い","たたかい"],["、"]]},{"verse":21,"text":"みな武装,ぶそうして主,しゅの前,まえに行,いってヨルダン川,がわを渡,わたり、主,しゅがその敵,てきを自分,じぶんの前,まえから追,おい払,はらわれて、","tok":[["みな"],["武装","ぶそう"],["して"],["主","しゅ"],["の"],["前","まえ"],["に"],["行って","いって"],["ヨルダン"],["川","がわ"],["を"],["渡り","わたり"],["、"],["主","しゅがそ"],["の"],["敵","てき"],["を"],["自分","じぶん"],["の"],["前","まえ"],["から"],["追い払われて","おいはらわれて"],["、"]]},{"verse":22,"text":"この国,くにが主,しゅの前,まえに征服,せいふくされて後,のち、帰,かえってくるならば、あなたがたは主,しゅの前,まえにも、イスラエルの前,まえにも、とがめはないであろう。そしてこの地,ちは主,しゅの前,まえにあなたがたの所有,しょゆうとなるであろう。","tok":[["この"],["国","くに"],["が"],["主","しゅ"],["の"],["前","まえ"],["に"],["征服","せいふく"],["されて"],["後","の"],["ち"],["、"],["帰えって","かえって"],["くるならば"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["も"],["、"],["イスラエル"],["の"],["前","まえ"],["に"],["も"],["、"],["とがめ"],["は"],["ないで"],["あろう"],["。"],["そして"],["この"],["地","ち"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["あなた"],["がた"],["の"],["所有","しょゆう"],["と"],["なるで"],["あろう"],["。"]]},{"verse":23,"text":"しかし、そうしないならば、あなたがたは主,しゅにむかって罪,つみを犯,おかした者,ものとなり、その罪,つみは必,かならず身,みに及,およぶことを知,しらなければならない。","tok":[["しかし"],["、"],["そう"],["しないならば"],["、"],["あなた"],["がた"],["は"],["主に","しゅに"],["むかって"],["罪","つみ"],["を"],["犯した","おかした"],["者","もの"],["と"],["なり"],["、"],["その"],["罪","つみ"],["は"],["必","かならず"],["身","み"],["に"],["及ぶ","およぶ"],["こと"],["を"],["知らなければ","しらなければ"],["ならない"],["。"]]},{"verse":24,"text":"あなたがたは子供,こどもたちのために町々,まちまちを建,たて、羊,ひつじのために、おりを建,たてなさい。しかし、あなたがたは約束,やくそくしたことは行,おこなわなければならない」。","tok":[["あなた"],["がた"],["は"],["子供","こども"],["たち"],["の"],["ため"],["に"],["町々","まちまち"],["を"],["建て","たて"],["、"],["羊","ひつじ"],["の"],["ため"],["に"],["、"],["おり"],["を"],["建て","たて"],["なさい"],["。"],["しかし"],["、"],["あなた"],["がた"],["は"],["約束","やくそく"],["した"],["こと"],["は"],["行なわなければ","おこなわなければ"],["ならない"],["」"],["。"]]},{"verse":25,"text":"ガドの子孫,しそんとルベンの子孫,しそんとは、モーセに言,いった、「しもべらはあなたの命,めいじられたとおりにいたします。","tok":[["ガド"],["の"],["子孫","しそん"],["と"],["ルベン"],["の"],["子孫","しそん"],["と"],["は"],["、"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["しもべ"],["ら"],["は"],["あなた"],["の"],["命じられた","めいじられた"],["とおり"],["に"],["いたします"],["。"]]},{"verse":26,"text":"われわれの子供,こどもたちと妻,つまと羊,ひつじと、すべての家畜,かちくとは、このギレアデの町々,まちまちに残,のこします。","tok":[["われわれ"],["の"],["子供","こども"],["たち"],["と"],["妻","つま"],["と"],["羊","ひつじ"],["と"],["、"],["すべて"],["の"],["家畜","かちく"],["と"],["は"],["、"],["この"],["ギレアデ"],["の"],["町々","まちまち"],["に"],["残します","のこします"],["。"]]},{"verse":27,"text":"しかし、しもべらはみな武装,ぶそうして、あなたの言,いわれるとおり、主,しゅの前,まえに渡,わたって行,いって戦,たたかいます」。","tok":[["しかし"],["、"],["しもべ"],["ら"],["は"],["みな"],["武装","ぶそう"],["して"],["、"],["あなた"],["の"],["言われる","いわれる"],["とおり"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["渡って","わたって"],["行って","いって"],["戦います","たたかいます"],["」"],["。"]]},{"verse":28,"text":"モーセは彼,かれらのことについて、祭司,さいしエレアザルと、ヌンの子,こヨシュアと、イスラエルの人々,ひとびとの部族,ぶぞくのうちの氏族,しぞくのかしらたちとに命,めいじた。","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["の"],["こと"],["について"],["、"],["祭司","さいし"],["エレアザル"],["と"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["部族","ぶぞく"],["の"],["うち"],["の"],["氏族","しぞく"],["の"],["かしら"],["たち"],["と"],["に"],["命じた","めいじた"],["。"]]},{"verse":29,"text":"そしてモーセは彼,かれらに言,いった、「ガドの子孫,しそんと、ルベンの子孫,しそんとが、おのおの武装,ぶそうしてあなたがたと一緒,いっしょにヨルダンを渡,わたり、主,しゅの前,まえに戦,たたかって、その地,ちをあなたがたが征服,せいふくするならば、あなたがたは彼,かれらにギレアデの地,ちを領地,りょうちとして与,あたえなければならない。","tok":[["そして"],["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["ガド"],["の"],["子孫","しそん"],["と"],["、"],["ルベン"],["の"],["子孫","しそん"],["と"],["が"],["、"],["おのおの"],["武装","ぶそう"],["して"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["ヨルダン"],["を"],["渡り","わたり"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["戦って","たたかって"],["、"],["その"],["地","ち"],["を"],["あなた"],["がた"],["が"],["征服","せいふく"],["するならば"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["に"],["ギレアデ"],["の"],["地","ち"],["を"],["領地","りょうち"],["として"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":30,"text":"しかし、もし彼,かれらが武装,ぶそうしてあなたがたと一緒,いっしょに渡,わたって行,いかないならば、彼,かれらはカナンの地,ちであなたがたのうちに領地,りょうちを獲,えなければならない」。","tok":[["しかし"],["、"],["もし"],["彼","かれ"],["ら"],["が"],["武装","ぶそう"],["して"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["渡って","わたって"],["行かないならば","いかないならば"],["、"],["彼","かれ"],["ら"],["は"],["カナン"],["の"],["地","ち"],["で"],["あなた"],["がた"],["の"],["うち"],["に"],["領地","りょうち"],["を"],["獲なければ","えなければ"],["ならない"],["」"],["。"]]},{"verse":31,"text":"ガドの子孫,しそんと、ルベンの子孫,しそんとは答,こたえて言,いった、「しもべらは主,しゅが言,いわれたとおりにいたします。","tok":[["ガド"],["の"],["子孫","しそん"],["と"],["、"],["ルベン"],["の"],["子孫","しそん"],["と"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["しもべ"],["ら"],["は"],["主","しゅ"],["が"],["言われた","いわれた"],["とおり"],["に"],["いたします"],["。"]]},{"verse":32,"text":"われわれは武装,ぶそうして、主,しゅの前,まえにカナンの地,ちへ渡,わたって行,いきますが、ヨルダンのこなたで、われわれの嗣,し業,ぎょうをもつことにします」。","tok":[["われわれ"],["は"],["武装","ぶそう"],["して"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["カナン"],["の"],["地","ち"],["へ"],["渡って","わたって"],["行きます","いきます"],["が"],["、"],["ヨルダン"],["の"],["こなた"],["で"],["、"],["われわれ"],["の"],["嗣業","しぎょう"],["を"],["もつ"],["こと"],["に"],["します"],["」"],["。"]]},{"verse":33,"text":"そこでモーセはガドの子孫,しそんと、ルベンの子孫,しそんと、ヨセフの子,こマナセの部族,ぶぞくの半,なかばとに、アモリびとの王,おうシホンの国,くにと、バシャンの王,おうオグの国,くにとを与,あたえた。すなわち、その国,くにおよびその領内,りょうないの町々,まちまちとその町々,まちまちの周囲,しゅういの地,ちとを与,あたえた。","tok":[["そこ"],["で"],["モーセ"],["は"],["ガド"],["の"],["子孫","しそん"],["と"],["、"],["ルベン"],["の"],["子孫","しそん"],["と"],["、"],["ヨセフ"],["の"],["子","こ"],["マナセ"],["の"],["部族","ぶぞく"],["の"],["半ば","なかば"],["と"],["に"],["、"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["の"],["国","くに"],["と"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["の"],["国","くに"],["と"],["を"],["与","あたえ"],["た"],["。"],["すなわち"],["、"],["その"],["国","くに"],["および"],["その"],["領内","りょうない"],["の"],["町々","まちまち"],["と"],["その"],["町々","まちまち"],["の"],["周囲","しゅうい"],["の"],["地","ち"],["と"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":34,"text":"こうしてガドの子孫,しそんは、デボン、アタロテ、アロエル、","tok":[["こう"],["して"],["ガド"],["の"],["子孫","しそん"],["は"],["、"],["デボン"],["、"],["アタロテ"],["、"],["アロエル"],["、"]]},{"verse":35,"text":"アテロテ・ショパン、ヤゼル、ヨグベハ、","tok":[["アテロテ"],["・"],["ショパン"],["、"],["ヤゼル"],["、"],["ヨグベハ"],["、"]]},{"verse":36,"text":"ベテニムラ、ベテハランなどの堅固,けんごな町々,まちまちを建,たて、羊,ひつじのおりを建,たてた。","tok":[["ベテニムラ"],["、"],["ベテハラン"],["など"],["の"],["堅固","けんご"],["な"],["町々","まちまち"],["を"],["建て","たて"],["、"],["羊","ひつじ"],["の"],["おり"],["を"],["建てた","たてた"],["。"]]},{"verse":37,"text":"またルベンの子孫,しそんは、ヘシボン、エレアレ、キリヤタイム、","tok":[["また"],["ルベン"],["の"],["子孫","しそん"],["は"],["、"],["ヘシボン"],["、"],["エレアレ"],["、"],["キリヤタイム"],["、"]]},{"verse":38,"text":"および後,のちに名,なを改,あらためたネボと、バアル・メオンの町,まちを建,たて、またシブマの町,まちを建,たてた。彼,かれらは建,たてた町々,まちまちに新,あたらしい名,なを与,あたえた。","tok":[["および"],["後","のち"],["に"],["名","な"],["を"],["改","あらため"],["た"],["ネボ"],["と"],["、"],["バアル"],["・"],["メオン"],["の"],["町","まち"],["を"],["建て","たて"],["、"],["また"],["シブマ"],["の"],["町","まち"],["を"],["建てた","たてた"],["。"],["彼","かれ"],["ら"],["は"],["建てた","たてた"],["町々","まちまち"],["に"],["新らしい","あたらしい"],["名","な"],["を"],["与","あたえ"],["た"],["。"]]},{"verse":39,"text":"またマナセの子,こマキルの子孫,しそんはギレアデに行,いって、そこを取,とり、その住民,じゅうみんアモリびとを追,おい払,はらったので、","tok":[["また"],["マナセ"],["の"],["子","こ"],["マキル"],["の"],["子孫","しそん"],["は"],["ギレアデ"],["に"],["行って","いって"],["、"],["そこ"],["を"],["取","とり"],["、"],["その"],["住民","じゅうみん"],["アモリ"],["びと"],["を"],["追い払った","おいはらった"],["ので"],["、"]]},{"verse":40,"text":"モーセはギレアデをマナセの子,こマキルに与,あたえてそこに住,すまわせた。","tok":[["モーセ"],["は"],["ギレアデ"],["を"],["マナセ"],["の"],["子","こ"],["マキル"],["に"],["与","あたえ"],["て"],["そこ"],["に"],["住まわせた","すまわせた"],["。"]]},{"verse":41,"text":"またマナセの子,こヤイルは行,いって村々,むらむらを取,とり、それをハオテヤイルと名,なづけた。","tok":[["また"],["マナセ"],["の"],["子","こ"],["ヤイル"],["は"],["行って","いって"],["村々","むらむら"],["を"],["取","とり"],["、"],["それ"],["を"],["ハオテヤイル"],["と"],["名づけた","なづけた"],["。"]]},{"verse":42,"text":"またノバは行,いってケナテとその村々,むらむらを取,とり、自分,じぶんの名,なにしたがって、それをノバと名,なづけた。","tok":[["また"],["ノバ"],["は"],["行って","いって"],["ケナテ"],["と"],["その"],["村々","むらむら"],["を"],["取","とり"],["、"],["自分","じぶん"],["の"],["名","な"],["に"],["したがって"],["、"],["それ"],["を"],["ノバ"],["と"],["名づけた","なづけた"],["。"]]}]
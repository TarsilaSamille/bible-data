[{"verse":1,"text":"ここに、レビの子,こコハテの子,こなるイヅハルの子,こコラと、ルベンの子,こなるエリアブの子,こダタンおよびアビラムと、ルベンの子,こなるペレテの子,こオンとが相,あい結,むすび、","tok":[["ここ"],["に"],["、"],["レビ"],["の"],["子","こ"],["コハテ"],["の"],["子","こ"],["なる"],["イヅハル"],["の"],["子","こ"],["コラ"],["と"],["、"],["ルベン"],["の"],["子","こ"],["なる"],["エリアブ"],["の"],["子","こ"],["ダタン"],["および"],["アビラム"],["と"],["、"],["ルベン"],["の"],["子","こ"],["なる"],["ペレテ"],["の"],["子","こ"],["オン"],["と"],["が"],["相","あい"],["結び","むすび"],["、"]]},{"verse":2,"text":"イスラエルの人々,ひとびとのうち、会衆,かいしゅうのうちから選,えらばれて、つかさとなった名,なのある人々,ひとびと二百五十人,にんと共,ともに立,たって、モーセに逆,さからった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["、"],["会衆","かいしゅう"],["の"],["うち"],["から"],["選ら","えら"],["ばれて"],["、"],["つかさ"],["と"],["なった"],["名","な"],["の"],["ある"],["人々","ひとびと"],["二百五","にひゃくご"],["十人","じゅうにん"],["と"],["共","とも"],["に"],["立って","たって"],["、"],["モーセ"],["に"],["逆らった","さからった"],["。"]]},{"verse":3,"text":"彼,かれらは集,あつまって、モーセとアロンとに逆,さからって言,いった、「あなたがたは、分,ぶんを越,こえています。全,ぜん会衆,かいしゅうは、ことごとく聖,せいなるものであって、主,しゅがそのうちにおられるのに、どうしてあなたがたは、主,しゅの会衆,かいしゅうの上,うえに立,たつのですか」。","tok":[["彼","かれ"],["ら"],["は"],["集まって","あつまって"],["、"],["モーセ"],["と"],["アロン"],["と"],["に"],["逆らって","さからって"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["分","ぶん"],["を"],["越えて","こえて"],["います"],["。"],["全","ぜん"],["会衆","かいしゅう"],["は"],["、"],["ことごとく"],["聖","せい"],["なる"],["もの"],["で"],["あって"],["、"],["主","しゅがそ"],["の"],["うち"],["に"],["おられる"],["のに"],["、"],["どう"],["して"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["の"],["会衆","かいしゅう"],["の"],["上","うえ"],["に"],["立つ","たつ"],["の"],["です"],["か"],["」"],["。"]]},{"verse":4,"text":"モーセはこれを聞,きいてひれ伏,ふした。","tok":[["モーセ"],["は"],["これ"],["を"],["聞いて","きいて"],["ひれ伏した","ひれふした"],["。"]]},{"verse":5,"text":"やがて彼,かれはコラと、そのすべての仲間,なかまとに言,いった、「あす、主,しゅは、主,しゅにつくものはだれ、聖,せいなる者,ものはだれであるかを示,しめして、その人,ひとをみもとに近,ちかづけられるであろう。すなわち、その選,えらんだ人,ひとを、みもとに近,ちかづけられるであろう。","tok":[["やがて"],["彼","かれ"],["は"],["コラ"],["と"],["、"],["その"],["すべて"],["の"],["仲間","なかま"],["と"],["に"],["言った","いった"],["、"],["「"],["あす"],["、"],["主","しゅ"],["は"],["、"],["主に","しゅに"],["つく"],["もの"],["は"],["だれ"],["、"],["聖","せい"],["なる"],["者","もの"],["は"],["だれ"],["で"],["ある"],["か"],["を"],["示めして","しめして"],["、"],["その"],["人","ひと"],["を"],["みもと"],["に"],["近づけられるで","ちかづけられるで"],["あろう"],["。"],["すなわち"],["、"],["その"],["選","え"],["らんだ"],["人","ひと"],["を"],["、"],["みもと"],["に"],["近づけられるで","ちかづけられるで"],["あろう"],["。"]]},{"verse":6,"text":"それで、次,つぎのようにしなさい。コラとそのすべての仲間,なかまとは、火,ひざらを取,とり、","tok":[["それ"],["で"],["、"],["次","つぎ"],["の"],["よう"],["に"],["し"],["なさい"],["。"],["コラ"],["と"],["その"],["すべて"],["の"],["仲間","なかま"],["と"],["は"],["、"],["火","ひ"],["ざら"],["を"],["取","とり"],["、"]]},{"verse":7,"text":"その中,なかに火,ひを入,いれ、それに薫香,くんこうを盛,もって、あす、主,しゅの前,まえに出,でなさい。その時,とき、主,しゅが選,えらばれる人,ひとは聖,せいなる者,ものである。レビの子,こたちよ、あなたがたこそ、分,ぶんを越,こえている」。","tok":[["その"],["中","なか"],["に"],["火","ひ"],["を"],["入れ","いれ"],["、"],["それ"],["に"],["薫香","くんこう"],["を"],["盛って","もって"],["、"],["あす"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["出","で"],["なさい"],["。"],["その"],["時","とき"],["、"],["主","しゅ"],["が"],["選ら","えら"],["ばれる"],["人","ひと"],["は"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["。"],["レビ"],["の"],["子","こ"],["たち"],["よ"],["、"],["あなた"],["がた"],["こそ"],["、"],["分","ぶん"],["を"],["越えて","こえて"],["いる"],["」"],["。"]]},{"verse":8,"text":"モーセはまたコラに言,いった、「レビの子,こたちよ、聞,ききなさい。","tok":[["モーセ"],["は"],["また"],["コラ"],["に"],["言った","いった"],["、"],["「"],["レビ"],["の"],["子","こ"],["たち"],["よ"],["、"],["聞","きき"],["なさい"],["。"]]},{"verse":9,"text":"イスラエルの神,かみはあなたがたをイスラエルの会衆,かいしゅうのうちから分,わかち、主,しゅに近,ちかづかせて、主,しゅの幕屋,まくやの務,つとめをさせ、かつ会衆,かいしゅうの前,まえに立,たって仕,つかえさせられる。これはあなたがたにとって、小,ちいさいことであろうか。","tok":[["イスラエル"],["の"],["神","かみ"],["は"],["あなた"],["がた"],["を"],["イスラエル"],["の"],["会衆","かいしゅう"],["の"],["うち"],["から"],["分かち","わかち"],["、"],["主に","しゅに"],["近づかせて","ちかづかせて"],["、"],["主","しゅ"],["の"],["幕屋","まくや"],["の"],["務め","つとめ"],["を"],["させ"],["、"],["かつ"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立って","たって"],["仕えさせられる","つかえさせられる"],["。"],["これ"],["は"],["あなた"],["がた"],["にとって"],["、"],["小さい","ちいさい"],["こと"],["で"],["あろう"],["か"],["。"]]},{"verse":10,"text":"神,かみはあなたとあなたの兄弟,きょうだいなるレビの子,こたちをみな近,ちかづけられた。あなたがたはなお、その上,うえに祭司,さいしとなることを求,もとめるのか。","tok":[["神","かみ"],["は"],["あなた"],["と"],["あなた"],["の"],["兄弟","きょうだい"],["なる"],["レビ"],["の"],["子","こ"],["たち"],["を"],["みな"],["近づけられた","ちかづけられた"],["。"],["あなた"],["がた"],["は"],["なお"],["、"],["その"],["上","うえ"],["に"],["祭司","さいし"],["と"],["なる"],["こと"],["を"],["求める","もとめる"],["の"],["か"],["。"]]},{"verse":11,"text":"あなたとあなたの仲間,なかまは、みなそのために集,あつまって主,しゅに敵,てきしている。あなたがたはアロンをなんと思,おもって、彼,かれに対,たいしてつぶやくのか」。","tok":[["あなた"],["と"],["あなた"],["の"],["仲間","なかま"],["は"],["、"],["みな"],["その"],["ため"],["に"],["集まって","あつまって"],["主に","しゅに"],["敵して","てきして"],["いる"],["。"],["あなた"],["がた"],["は"],["アロン"],["を"],["なん"],["と"],["思って","おもって"],["、"],["彼","かれ"],["に対して","にたいして"],["つぶやく"],["の"],["か"],["」"],["。"]]},{"verse":12,"text":"モーセは人,ひとをやって、エリアブの子,こダタンとアビラムとを呼,よばせたが、彼,かれらは言,いった、「わたしたちは参,まいりません。","tok":[["モーセ"],["は"],["人","ひと"],["を"],["やって"],["、"],["エリアブ"],["の"],["子","こ"],["ダタン"],["と"],["アビラム"],["と"],["を"],["呼ばせた","よばせた"],["が"],["、"],["彼","かれ"],["ら"],["は"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["参りません","まいりません"],["。"]]},{"verse":13,"text":"あなたは乳,ちちと蜜,みつの流,ながれる地,ちから、わたしたちを導,みちびき出,だして、荒野,あらのでわたしたちを殺,ころそうとしている。これは小,ちいさいことでしょうか。その上,うえ、あなたはわたしたちに君臨,くんりんしようとしている。","tok":[["あなた"],["は"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["から"],["、"],["わたしたち"],["を"],["導き出して","みちびきだして"],["、"],["荒野","あら"],["ので"],["わたしたち"],["を"],["殺そう","ころそう"],["として"],["いる"],["。"],["これ"],["は"],["小さい","ちいさい"],["こと"],["でしょう"],["か"],["。"],["その"],["上","うえ"],["、"],["あなた"],["は"],["わたしたち"],["に"],["君臨","くんりん"],["しよう"],["として"],["いる"],["。"]]},{"verse":14,"text":"かつまた、あなたはわたしたちを、乳,ちちと蜜,みつの流,ながれる地,ちに導,みちびいて行,いかず、畑,はたけと、ぶどう畑,はたけとを嗣,し業,ぎょうとして与,あたえもしない。これらの人々,ひとびとの目,めをくらまそうとするのですか。わたしたちは参,まいりません」。","tok":[["かつ"],["また"],["、"],["あなた"],["は"],["わたしたち"],["を"],["、"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れる","ながれる"],["地","ち"],["に"],["導いて","みちびいて"],["行かず","いかず"],["、"],["畑","はたけ"],["と"],["、"],["ぶどう"],["畑","はたけ"],["と"],["を"],["嗣業","しぎょう"],["として"],["与","あたえ"],["も"],["しない"],["。"],["これ"],["ら"],["の"],["人々","ひとびと"],["の"],["目","め"],["を"],["くらまそう"],["と"],["する"],["の"],["です"],["か"],["。"],["わたしたち"],["は"],["参りません","まいりません"],["」"],["。"]]},{"verse":15,"text":"モーセは大,おおいに怒,いかって、主,しゅに言,いった、「彼,かれらの供,そなえ物,ものを顧,かえりみないでください。わたしは彼,かれらから、ろば一頭,とうをも取,とったことなく、また彼,かれらのひとりをも害,がいしたことはありません」。","tok":[["モーセ"],["は"],["大いに","おおいに"],["怒","い"],["か"],["って"],["、"],["主に","しゅに"],["言った","いった"],["、"],["「"],["彼","かれ"],["ら"],["の"],["供え物","そなえもの"],["を"],["顧ないで","かえりみないで"],["ください"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["から"],["、"],["ろば"],["一頭","とう"],["を"],["も"],["取った","とった"],["こと"],["なく"],["、"],["また"],["彼","かれ"],["ら"],["の"],["ひとり"],["を"],["も"],["害した","がいした"],["こと"],["は"],["ありません"],["」"],["。"]]},{"verse":16,"text":"そしてモーセはコラに言,いった、「あなたとあなたの仲間,なかまはみなアロンと一緒,いっしょに、あす、主,しゅの前,まえに出,でなさい。","tok":[["そして"],["モーセ"],["は"],["コラ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["と"],["あなた"],["の"],["仲間","なかま"],["は"],["みな"],["アロン"],["と"],["一緒","いっしょ"],["に"],["、"],["あす"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["出","で"],["なさい"],["。"]]},{"verse":17,"text":"あなたがたは、おのおの火,ひざらを取,とって、それに薫香,くんこうを盛,もり、おのおのその火,ひざらを主,しゅの前,まえに携,たずさえて行,いきなさい。その火,ひざらは会,あわせて二百五十。あなたとアロンも、おのおの火,ひざらを携,たずさえて行,いきなさい」。","tok":[["あなた"],["がた"],["は"],["、"],["おのおの"],["火","ひ"],["ざら"],["を"],["取って","とって"],["、"],["それ"],["に"],["薫香","くんこう"],["を"],["盛り","もり"],["、"],["おのおの"],["その"],["火","ひ"],["ざら"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["携えて","たずさえて"],["行き","いき"],["なさい"],["。"],["その"],["火","ひ"],["ざら"],["は"],["会わせて","あわせて"],["二百五十","にひゃくごじゅう"],["。"],["あなた"],["と"],["アロン"],["も"],["、"],["おのおの"],["火","ひ"],["ざら"],["を"],["携えて","たずさえて"],["行き","いき"],["なさい"],["」"],["。"]]},{"verse":18,"text":"彼,かれらは、おのおの火,ひざらを取,とり、火,ひをその中,なかに入,いれ、それに薫香,くんこうを盛,もり、モーセとアロンも共,ともに、会見,かいけんの幕屋,まくやの入口,いりぐちに立,たった。","tok":[["彼","かれ"],["ら"],["は"],["、"],["おのおの"],["火","ひ"],["ざら"],["を"],["取","とり"],["、"],["火","ひ"],["を"],["その"],["中","なか"],["に"],["入れ","いれ"],["、"],["それ"],["に"],["薫香","くんこう"],["を"],["盛り","もり"],["、"],["モーセ"],["と"],["アロン"],["も"],["共","とも"],["に"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["立った","たった"],["。"]]},{"verse":19,"text":"そのとき、コラは会衆,かいしゅうを、ことごとく会見,かいけんの幕屋,まくやの入口,いりぐちに集,あつめて、彼,かれらふたりに逆,さからわせようとしたが、主,しゅの栄光,えいこうは全,ぜん会衆,かいしゅうに現,あらわれた。","tok":[["その"],["とき"],["、"],["コラ"],["は"],["会衆","かいしゅう"],["を"],["、"],["ことごとく"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["集めて","あつめて"],["、"],["彼","かれ"],["ら"],["ふたり"],["に"],["逆らわせよう","さからわせよう"],["と"],["した"],["が"],["、"],["主","しゅ"],["の"],["栄光","えいこう"],["は"],["全","ぜん"],["会衆","かいしゅう"],["に"],["現われた","あらわれた"],["。"]]},{"verse":20,"text":"主,しゅはモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":21,"text":"「あなたがたはこの会衆,かいしゅうを離,はなれなさい。わたしはただちに彼,かれらを滅,ほろぼすであろう」。","tok":[["「"],["あなた"],["がた"],["は"],["この"],["会衆","かいしゅう"],["を"],["離れ","はなれ"],["なさい"],["。"],["わたし"],["は"],["ただちに"],["彼","かれ"],["ら"],["を"],["滅ぼすで","ほろぼすで"],["あろう"],["」"],["。"]]},{"verse":22,"text":"彼,かれらふたりは、ひれ伏,ふして言,いった、「神,かみよ、すべての肉,にくなる者,ものの命,いのちの神,かみよ、このひとりの人,ひとが、罪,つみを犯,おかしたからといって、あなたは全,ぜん会衆,かいしゅうに対,たいして怒,いかられるのですか」。","tok":[["彼","かれ"],["ら"],["ふたり"],["は"],["、"],["ひれ伏して","ひれふして"],["言った","いった"],["、"],["「"],["神","かみ"],["よ"],["、"],["すべて"],["の"],["肉","にく"],["なる"],["者","もの"],["の"],["命","いのち"],["の"],["神","かみ"],["よ"],["、"],["この"],["ひとり"],["の"],["人","ひと"],["が"],["、"],["罪","つみ"],["を"],["犯した","おかした"],["から"],["と"],["いって"],["、"],["あなた"],["は"],["全","ぜん"],["会衆","かいしゅう"],["に対して","にたいして"],["怒","いかられる"],["の"],["です"],["か"],["」"],["。"]]},{"verse":23,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":24,"text":"「あなたは会衆,かいしゅうに告,つげて、コラとダタンとアビラムのすまいの周囲,しゅういを去,されと言,いいなさい」。","tok":[["「"],["あなた"],["は"],["会衆","かいしゅう"],["に"],["告","つげ"],["て"],["、"],["コラ"],["と"],["ダタン"],["と"],["アビラム"],["の"],["すまい"],["の"],["周囲","しゅうい"],["を"],["去れ","され"],["と"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":25,"text":"モーセは立,たってダタンとアビラムのもとに行,いったが、イスラエルの長老,ちょうろうたちも、彼,かれに従,したがって行,いった。","tok":[["モーセ"],["は"],["立って","たって"],["ダタン"],["と"],["アビラム"],["の"],["もと"],["に"],["行った","いった"],["が"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["も"],["、"],["彼","かれ"],["に"],["従って","したがって"],["行った","いった"],["。"]]},{"verse":26,"text":"モーセは会衆,かいしゅうに言,いった、「どうぞ、あなたがたはこれらの悪,わるい人々,ひとびとの天幕,てんまくを離,はなれてください。彼,かれらのものには何,なににも触,ふれてはならない。彼,かれらのもろもろの罪,つみによって、あなたがたも滅,ほろぼされてはいけないから」。","tok":[["モーセ"],["は"],["会衆","かいしゅう"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["あなた"],["がた"],["は"],["これ"],["ら"],["の"],["悪い","わるい"],["人々","ひとびと"],["の"],["天幕","てんまく"],["を"],["離れて","はなれて"],["ください"],["。"],["彼","かれ"],["ら"],["の"],["もの"],["に"],["は"],["何に","なに"],["に"],["も"],["触","ふれ"],["ては"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["もろもろ"],["の"],["罪","つみ"],["によって"],["、"],["あなた"],["がた"],["も"],["滅ぼされて","ほろぼされて"],["は"],["いけない"],["から"],["」"],["。"]]},{"verse":27,"text":"そこで人々,ひとびとはコラとダタンとアビラムのすまいの周囲,しゅういを離,はなれ去,さった。そして、ダタンとアビラムとは、妻,つま、子,こ、および幼児,ようじと一緒,いっしょに出,でて、天幕,てんまくの入口,いりぐちに立,たった。","tok":[["そこ"],["で"],["人々","ひとびと"],["は"],["コラ"],["と"],["ダタン"],["と"],["アビラム"],["の"],["すまい"],["の"],["周囲","しゅうい"],["を"],["離れ","はなれ"],["去た","さった"],["。"],["そして"],["、"],["ダタン"],["と"],["アビラム"],["と"],["は"],["、"],["妻","つま"],["、"],["子","こ"],["、"],["および"],["幼児","ようじ"],["と"],["一緒","いっしょ"],["に"],["出て","でて"],["、"],["天幕","てんまく"],["の"],["入口","いりぐち"],["に"],["立った","たった"],["。"]]},{"verse":28,"text":"モーセは言,いった、「あなたがたは主,しゅがこれらのすべての事,ことをさせるために、わたしをつかわされたこと、またわたしが、これを自分,じぶんの心,こころにしたがって行,おこなうものでないことを、次,つぎのことによって知,しるであろう。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["主ら","しゅがこれら"],["の"],["すべて"],["の"],["事","こと"],["を"],["させる"],["ため"],["に"],["、"],["わたし"],["を"],["つかわされた"],["こと"],["、"],["また"],["わたし"],["が"],["、"],["これ"],["を"],["自分","じぶん"],["の"],["心","こころ"],["に"],["したがって"],["行なう","おこなう"],["もの"],["で"],["ない"],["こと"],["を"],["、"],["次","つぎ"],["の"],["こと"],["によって"],["知るで","しるで"],["あろう"],["。"]]},{"verse":29,"text":"すなわち、もしこれらの人々,ひとびとが、普通,ふつうの死,しに方,かたで死,しに、普通,ふつうの運命,うんめいに会,あうのであれば、主,しゅがわたしをつかわされたのではない。","tok":[["すなわち"],["、"],["もし"],["これ"],["ら"],["の"],["人々","ひとびと"],["が"],["、"],["普通","ふつう"],["の"],["死に","しに"],["方","かた"],["で"],["死に","しに"],["、"],["普通","ふつう"],["の"],["運命","うんめい"],["に"],["会う","あう"],["ので"],["あれば"],["、"],["主","しゅ"],["が"],["わたし"],["を"],["つかわされた"],["ので"],["は"],["ない"],["。"]]},{"verse":30,"text":"しかし、主,しゅが新,あたらしい事,ことをされ、地,ちが口,くちを開,ひらいて、これらの人々,ひとびとと、それに属,ぞくする者,ものとを、ことごとくのみつくして、生,いきながら陰府,よみに下,くだらせられるならば、あなたがたはこれらの人々,ひとびとが、主,しゅを侮,あなどったのであることを知,しらなければならない」。","tok":[["しかし"],["、"],["主","しゅ"],["が"],["新らしい","あたらしい"],["事","こと"],["を"],["され"],["、"],["地","ち"],["が"],["口","くち"],["を"],["開らいて","ひらいて"],["、"],["これ"],["ら"],["の"],["人々","ひとびと"],["と"],["、"],["それ"],["に"],["属する","ぞくする"],["者","もの"],["と"],["を"],["、"],["ことごとく"],["のみ"],["つくして"],["、"],["生き","いき"],["ながら"],["陰府","よみ"],["に"],["下らせられるならば","くだらせられるならば"],["、"],["あなた"],["がた"],["は"],["これ"],["ら"],["の"],["人々","ひとびと"],["が"],["、"],["主","しゅ"],["を"],["侮った","あなどった"],["ので"],["ある"],["こと"],["を"],["知らなければ","しらなければ"],["ならない"],["」"],["。"]]},{"verse":31,"text":"モーセが、これらのすべての言葉,ことばを述,のべ終,おわったとき、彼,かれらの下,したの土地,とちが裂,さけ、","tok":[["モーセ"],["が"],["、"],["これ"],["ら"],["の"],["すべて"],["の"],["言葉","ことば"],["を"],["述べ","のべ"],["終わった","おわった"],["とき"],["、"],["彼","かれ"],["ら"],["の"],["下","した"],["の"],["土地","とち"],["が"],["裂け","さけ"],["、"]]},{"verse":32,"text":"地,ちは口,くちを開,ひらいて、彼,かれらとその家族,かぞく、ならびにコラに属,ぞくするすべての人々,ひとびとと、すべての所有物,しょゆうぶつをのみつくした。","tok":[["地","ち"],["は"],["口","くち"],["を"],["開らいて","ひらいて"],["、"],["彼","かれ"],["ら"],["と"],["その"],["家族","かぞく"],["、"],["ならびに"],["コラ"],["に"],["属する","ぞくする"],["すべて"],["の"],["人々","ひとびと"],["と"],["、"],["すべて"],["の"],["所有物","しょゆうぶつ"],["を"],["のみ"],["つくした"],["。"]]},{"verse":33,"text":"すなわち、彼,かれらと、彼,かれらに属,ぞくするものは、皆,みな生,いきながら陰府,よみに下,くだり、地,ちはその上,うえを閉,とじふさいで、彼,かれらは会衆,かいしゅうのうちから、断,たち滅,ほろぼされた。","tok":[["すなわち"],["、"],["彼","かれ"],["ら"],["と"],["、"],["彼","かれ"],["ら"],["に"],["属する","ぞくする"],["もの"],["は"],["、"],["皆","みな"],["生き","いき"],["ながら"],["陰府","よみ"],["に"],["下り","くだり"],["、"],["地","ち"],["は"],["その"],["上","うえ"],["を"],["閉じふさいで","とじふさいで"],["、"],["彼","かれ"],["ら"],["は"],["会衆","かいしゅう"],["の"],["うち"],["から"],["、"],["断ち","たち"],["滅ぼされた","ほろぼされた"],["。"]]},{"verse":34,"text":"この時,とき、その周囲,しゅういにいたイスラエルの人々,ひとびとは、みな彼,かれらの叫,さけびを聞,きいて逃,にげ去,さり、「恐,おそらく地,ちはわたしたちをも、のみつくすであろう」と言,いった。","tok":[["この"],["時","とき"],["、"],["その"],["周囲","しゅうい"],["に"],["いた"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["みな"],["彼","かれ"],["ら"],["の"],["叫","さけび"],["を"],["聞いて","きいて"],["逃","にげ"],["去り","さり"],["、"],["「"],["恐らく","おそらく"],["地","ち"],["は"],["わたしたち"],["を"],["も"],["、"],["のみ"],["つくすで"],["あろう"],["」"],["と"],["言った","いった"],["。"]]},{"verse":35,"text":"また主,しゅのもとから火,ひが出,でて、薫香,くんこうを供,そなえる二百五十人,にんをも焼,やきつくした。","tok":[["また"],["主","しゅ"],["の"],["もと"],["から"],["火","ひ"],["が"],["出て","でて"],["、"],["薫香","くんこう"],["を"],["供える","そなえる"],["二百五","にひゃくご"],["十人","じゅうにん"],["を"],["も"],["焼き","やき"],["つくした"],["。"]]}]
[{"verse":1,"text":"主,しゅはモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとは、おのおのその部隊,ぶたいの旗,はたのもとに、その父祖,ふその家,いえの旗印,はたじるしにしたがって宿営,しゅくえいしなければならない。また会見,かいけんの幕屋,まくやのまわりに、それに向,むかって宿営,しゅくえいしなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["おのおの"],["その"],["部隊","ぶたい"],["の"],["旗","はた"],["の"],["もと"],["に"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["旗印","はたじるし"],["に"],["したがって"],["宿営","しゅくえい"],["しなければ"],["ならない"],["。"],["また"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["まわり"],["に"],["、"],["それ"],["に"],["向かって","むかって"],["宿営","しゅくえい"],["しなければ"],["ならない"],["。"]]},{"verse":3,"text":"すなわち、日,ひの出,でる方,ほう、東,ひがしに宿営,しゅくえいするものは、ユダの宿営,しゅくえいの旗,はたにつく者,ものであって、その部隊,ぶたいにしたがって宿営,しゅくえいし、アミナダブの子,こナションが、ユダの子,こたちのつかさとなるであろう。","tok":[["すなわち"],["、"],["日","ひ"],["の"],["出る","でる"],["方","ほう"],["、"],["東","ひがし"],["に"],["宿営","しゅくえい"],["する"],["もの"],["は"],["、"],["ユダ"],["の"],["宿営","しゅくえい"],["の"],["旗","はた"],["に"],["つく"],["者","もの"],["で"],["あって"],["、"],["その"],["部隊","ぶたい"],["に"],["したがって"],["宿営","しゅくえい"],["し"],["、"],["アミナダブ"],["の"],["子","こ"],["ナション"],["が"],["、"],["ユダ"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":4,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは七万四千六百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["七万四千六百","ななまんよんせんろくひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":5,"text":"そのかたわらに宿営,しゅくえいする者,ものはイッサカルの部族,ぶぞくで、ツアルの子,こネタニエルが、イッサカルの子,こたちのつかさとなるであろう。","tok":[["その"],["かたわら"],["に"],["宿営","しゅくえい"],["する"],["者","もの"],["は"],["イッサカル"],["の"],["部族","ぶぞく"],["で"],["、"],["ツアル"],["の"],["子","こ"],["ネタニエル"],["が"],["、"],["イッサカル"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":6,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは五万四千四百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["五万四千四百","ごまんよんせんよんひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":7,"text":"次,つぎはゼブルンの部族,ぶぞくで、ヘロンの子,こエリアブが、ゼブルンの子,こたちのつかさとなるであろう。","tok":[["次","つぎ"],["は"],["ゼブルン"],["の"],["部族","ぶぞく"],["で"],["、"],["ヘロン"],["の"],["子","こ"],["エリアブ"],["が"],["、"],["ゼブルン"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":8,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは五万七千四百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["五万七千四百","ごまんななせんよんひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":9,"text":"ユダの宿営,しゅくえいの、その部隊,ぶたいにしたがって数,かぞえられた者,ものは、合,あわせて十八万六千四百人,にんである。これらの者,ものは、まっ先,さきに進,すすまなければならない。","tok":[["ユダ"],["の"],["宿営","しゅくえい"],["の"],["、"],["その"],["部隊","ぶたい"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["、"],["合","あわせ"],["て"],["十八万六千四百","じゅうはちまんろくせんよんひゃく"],["人","にん"],["で"],["ある"],["。"],["これ"],["ら"],["の"],["者","もの"],["は"],["、"],["まっ先","まっさき"],["に"],["進まなければ","すすまなければ"],["ならない"],["。"]]},{"verse":10,"text":"南,みなみの方,ほうでは、ルベンの宿営,しゅくえいの旗,はたにつく者,ものが、その部隊,ぶたいにしたがっており、シデウルの子,こエリヅルが、ルベンの子,こたちのつかさとなるであろう。","tok":[["南","みなみ"],["の"],["方","ほう"],["で"],["は"],["、"],["ルベン"],["の"],["宿営","しゅくえい"],["の"],["旗","はた"],["に"],["つく"],["者","もの"],["が"],["、"],["その"],["部隊","ぶたい"],["に"],["したがって"],["おり"],["、"],["シデウル"],["の"],["子","こ"],["エリヅル"],["が"],["、"],["ルベン"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":11,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは四万六千五百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["四万六千五百","よんまんろくせんごひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":12,"text":"そのかたわらに宿営,しゅくえいする者,ものはシメオンの部族,ぶぞくで、ツリシャダイの子,こシルミエルが、シメオンの子,こたちのつかさとなるであろう。","tok":[["その"],["かたわら"],["に"],["宿営","しゅくえい"],["する"],["者","もの"],["は"],["シメオン"],["の"],["部族","ぶぞく"],["で"],["、"],["ツリシャダイ"],["の"],["子","こ"],["シルミエル"],["が"],["、"],["シメオン"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":13,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは五万九千三百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["五万九千三百","ごまんきゅうせんさんひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":14,"text":"次,つぎはガドの部族,ぶぞくで、デウエルの子,こエリアサフが、ガドの子,こたちのつかさとなるであろう。","tok":[["次","つぎ"],["は"],["ガド"],["の"],["部族","ぶぞく"],["で"],["、"],["デウエル"],["の"],["子","こ"],["エリアサフ"],["が"],["、"],["ガド"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":15,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは四万五千六百五十人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["四万五千六百五","よんまんごせんろくひゃくご"],["十人","じゅうにん"],["で"],["ある"],["。"]]},{"verse":16,"text":"ルベンの宿営,しゅくえいの、その部隊,ぶたいにしたがって数,かぞえられた者,ものは、合,あわせて十五万一千四百五十人,にんである。これらの者,ものは二番目,ばんめに進,すすまなければならない。","tok":[["ルベン"],["の"],["宿営","しゅくえい"],["の"],["、"],["その"],["部隊","ぶたい"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["、"],["合","あわせ"],["て"],["十五万一千四百五","じゅうごまんいちせんよんひゃくご"],["十人","じゅうにん"],["で"],["ある"],["。"],["これ"],["ら"],["の"],["者","もの"],["は"],["二番目","ばんめ"],["に"],["進まなければ","すすまなければ"],["ならない"],["。"]]},{"verse":17,"text":"その次,つぎに会見,かいけんの幕屋,まくやを、レビびとの宿営,しゅくえいとともに、もろもろの宿営,しゅくえいの中央,ちゅうおうにして進,すすまなければならない。彼,かれらは宿営,しゅくえいするのと同,おなじように、おのおのその位置,いちで、その旗,はたにしたがって進,すすまなければならない。","tok":[["その"],["次","つぎ"],["に"],["会見","かいけん"],["の"],["幕屋","まくや"],["を"],["、"],["レビ"],["びと"],["の"],["宿営","しゅくえい"],["と"],["とも"],["に"],["、"],["もろもろ"],["の"],["宿営","しゅくえい"],["の"],["中央","ちゅうおう"],["に"],["して"],["進まなければ","すすまなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["宿営","しゅくえい"],["する"],["の"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["おのおの"],["その"],["位置","いち"],["で"],["、"],["その"],["旗","はた"],["に"],["したがって"],["進まなければ","すすまなければ"],["ならない"],["。"]]},{"verse":18,"text":"西,にしの方,ほうでは、エフライムの宿営,しゅくえいの旗,はたにつく者,ものが、その部隊,ぶたいにしたがっており、アミホデの子,こエリシャマが、エフライムの子,こたちのつかさとなるであろう。","tok":[["西","にし"],["の"],["方","ほう"],["で"],["は"],["、"],["エフライム"],["の"],["宿営","しゅくえい"],["の"],["旗","はた"],["に"],["つく"],["者","もの"],["が"],["、"],["その"],["部隊","ぶたい"],["に"],["したがって"],["おり"],["、"],["アミホデ"],["の"],["子","こ"],["エリシャマ"],["が"],["、"],["エフライム"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":19,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは四万五百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["四万五百","よんまんごひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":20,"text":"そのかたわらにマナセの部族,ぶぞくがおって、パダヅルの子,こガマリエルが、マナセの子,こたちのつかさとなるであろう。","tok":[["その"],["かたわら"],["に"],["マナセ"],["の"],["部族","ぶぞく"],["が"],["おって"],["、"],["パダヅル"],["の"],["子","こ"],["ガマリエル"],["が"],["、"],["マナセ"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":21,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは三万二千二百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["三万二千二百","さんまんにせんにひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":22,"text":"次,つぎにベニヤミンの部族,ぶぞくがおって、ギデオニの子,こアビダンが、ベニヤミンの子,こたちのつかさとなるであろう。","tok":[["次","つぎ"],["に"],["ベニヤミン"],["の"],["部族","ぶぞく"],["が"],["おって"],["、"],["ギデオニ"],["の"],["子","こ"],["アビダン"],["が"],["、"],["ベニヤミン"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":23,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは三万五千四百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["三万五千四百","さんまんごせんよんひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":24,"text":"エフライムの宿営,しゅくえいの、その部隊,ぶたいにしたがって数,かぞえられた者,ものは、合,あわせて十万八千百人,にんである。これらの者,ものは三番目,ばんめに進,すすまなければならない。","tok":[["エフライム"],["の"],["宿営","しゅくえい"],["の"],["、"],["その"],["部隊","ぶたい"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["、"],["合","あわせ"],["て"],["十万八千百","じゅうまんはちせんひゃく"],["人","にん"],["で"],["ある"],["。"],["これ"],["ら"],["の"],["者","もの"],["は"],["三番目","ばんめ"],["に"],["進まなければ","すすまなければ"],["ならない"],["。"]]},{"verse":25,"text":"北,きたの方,ほうでは、ダンの宿営,しゅくえいの旗,はたにつく者,ものが、その部隊,ぶたいにしたがっており、アミシャダイの子,こアヒエゼルが、ダンの子,こたちのつかさとなるであろう。","tok":[["北","きた"],["の"],["方","ほう"],["で"],["は"],["、"],["ダン"],["の"],["宿営","しゅくえい"],["の"],["旗","はた"],["に"],["つく"],["者","もの"],["が"],["、"],["その"],["部隊","ぶたい"],["に"],["したがって"],["おり"],["、"],["アミシャダイ"],["の"],["子","こ"],["アヒエゼル"],["が"],["、"],["ダン"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":26,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは六万二千七百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["六万二千七百","ろくまんにせんななひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":27,"text":"そのかたわらに宿営,しゅくえいする者,ものは、アセルの部族,ぶぞくであって、オクランの子,こパギエルが、アセルの子,こたちのつかさとなるであろう。","tok":[["その"],["かたわら"],["に"],["宿営","しゅくえい"],["する"],["者","もの"],["は"],["、"],["アセル"],["の"],["部族","ぶぞく"],["で"],["あって"],["、"],["オクラン"],["の"],["子","こ"],["パギエル"],["が"],["、"],["アセル"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":28,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは四万一千五百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["四万一千五百","よんまんいちせんごひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":29,"text":"次,つぎにナフタリの部族,ぶぞくがおって、エナンの子,こアヒラが、ナフタリの子,こたちのつかさとなるであろう。","tok":[["次","つぎ"],["に"],["ナフタリ"],["の"],["部族","ぶぞく"],["が"],["おって"],["、"],["エナン"],["の"],["子","こ"],["アヒラ"],["が"],["、"],["ナフタリ"],["の"],["子","こ"],["たち"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":30,"text":"その部隊,ぶたい、すなわち、数,かぞえられた者,ものは五万三千四百人,にんである。","tok":[["その"],["部隊","ぶたい"],["、"],["すなわち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["五万三千四百","ごまんさんせんよんひゃく"],["人","にん"],["で"],["ある"],["。"]]},{"verse":31,"text":"ダンの宿営,しゅくえいの、数,かぞえられた者,ものは合,あわせて十五万七千六百人,にんである。これらの者,ものはその旗,はたにしたがって、最後,さいごに進,すすまなければならない」。","tok":[["ダン"],["の"],["宿営","しゅくえい"],["の"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["合","あわせ"],["て"],["十五万七千六百","じゅうごまんななせんろくひゃく"],["人","にん"],["で"],["ある"],["。"],["これ"],["ら"],["の"],["者","もの"],["は"],["その"],["旗","はた"],["に"],["したがって"],["、"],["最後","さいご"],["に"],["進まなければ","すすまなければ"],["ならない"],["」"],["。"]]},{"verse":32,"text":"これがイスラエルの人々,ひとびとの、その父祖,ふその家,いえにしたがって数,かぞえられた人々,ひとびとである。もろもろの宿営,しゅくえいの、その部隊,ぶたいにしたがって数,かぞえられた者,ものは合,あわせて六十万三千五百五十人,にんであった。","tok":[["これ"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["数えられた","かぞえられた"],["人々","ひとびと"],["で"],["ある"],["。"],["もろもろ"],["の"],["宿営","しゅくえい"],["の"],["、"],["その"],["部隊","ぶたい"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["合","あわせ"],["て"],["六十万三千五百五","ろくじゅうまんさんせんごひゃくご"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":33,"text":"しかし、レビびとはイスラエルの人々,ひとびとのうちに数,かぞえられなかった。主,しゅがモーセに命,めいじられたとおりである。","tok":[["しかし"],["、"],["レビ"],["び"],["と"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["数えられなかった","かぞえられなかった"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":34,"text":"イスラエルの人々,ひとびとは、すべて主,しゅがモーセに命,めいじられたとおりに行,おこない、その旗,はたにしたがって宿営,しゅくえいし、おのおのその氏族,しぞくに従,したがい、その父祖,ふその家,いえに従,したがって進,すすんだ。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["すべて"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["行ない","おこない"],["、"],["その"],["旗","はた"],["に"],["したがって"],["宿営","しゅくえい"],["し"],["、"],["おのおの"],["その"],["氏族","しぞく"],["に"],["従い","したがい"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["従って","したがって"],["進んだ","すすんだ"],["。"]]}]
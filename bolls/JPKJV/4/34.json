[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに命,めいじて言,いいなさい。あなたがたがカナンの地,ちにはいるとき、あなたがたの嗣,し業,ぎょうとなるべき地,ちはカナンの地,ちで、その全域,ぜんいきは次,つぎのとおりである。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じて","めいじて"],["言い","いい"],["なさい"],["。"],["あなた"],["がた"],["が"],["カナン"],["の"],["地","ち"],["に"],["は"],["いる"],["とき"],["、"],["あなた"],["がた"],["の"],["嗣業","しぎょう"],["と"],["なるべき"],["地","ち"],["は"],["カナン"],["の"],["地","ち"],["で"],["、"],["その"],["全域","ぜんいき"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":3,"text":"南,みなみの方,ほうはエドムに接,せっするチンの荒野,あらのに始,はじまり、南,みなみの境,さかいは、東,ひがしは塩,しおの海,うみの端,はしに始,はじまる。","tok":[["南","みなみ"],["の"],["方","ほう"],["は"],["エドム"],["に"],["接する","せっする"],["チン"],["の"],["荒野","あらの"],["に"],["始まり","はじまり"],["、"],["南","みなみ"],["の"],["境","さかい"],["は"],["、"],["東","ひがし"],["は"],["塩","しお"],["の"],["海","うみ"],["の"],["端","はし"],["に"],["始まる","はじまる"],["。"]]},{"verse":4,"text":"その境,さかいはアクラビムの坂,さかの南,みなみを巡,めぐってチンに向,むかい、カデシ・バルネアの南,みなみに至,いたり、ハザル・アダルに進,すすみ、アズモンに及,およぶ。","tok":[["その"],["境","さかい"],["は"],["アクラビム"],["の"],["坂","さか"],["の"],["南","みなみ"],["を"],["巡って","めぐって"],["チン"],["に"],["向","むかい"],["、"],["カデシ"],["・"],["バルネア"],["の"],["南","みなみ"],["に"],["至","いたり"],["、"],["ハザル"],["・"],["アダル"],["に"],["進み","すすみ"],["、"],["アズモン"],["に"],["及ぶ","およぶ"],["。"]]},{"verse":5,"text":"その境,さかいはまたアズモンから転,てんじてエジプトの川,かわに至,いたり、海,うみに及,およんで尽,つきる。","tok":[["その"],["境","さかい"],["は"],["また"],["アズモン"],["から"],["転じて","てんじて"],["エジプト"],["の"],["川","かわ"],["に"],["至","いたり"],["、"],["海","うみ"],["に"],["及んで","およんで"],["尽る","つきる"],["。"]]},{"verse":6,"text":"西,にしの境,さかいはおおうみとその沿岸,えんがんで、これがあなたがたの西,にしの境,さかいである。","tok":[["西","にし"],["の"],["境","さかい"],["は"],["お"],["おうみ"],["と"],["その"],["沿岸","えんがん"],["で"],["、"],["これ"],["が"],["あなた"],["がた"],["の"],["西","にし"],["の"],["境","さかい"],["で"],["ある"],["。"]]},{"verse":7,"text":"あなたがたの北,きたの境,さかいは次,つぎのとおりである。すなわちおおうみからホル山,やままで線,せんを引,ひき、","tok":[["あなた"],["がた"],["の"],["北","きた"],["の"],["境","さかい"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["お"],["おうみ"],["から"],["ホル"],["山","やま"],["まで"],["線","せん"],["を"],["引","ひき"],["、"]]},{"verse":8,"text":"ホル山,やまからハマテの入口,いりぐちまで線,せんを引,ひき、その境,さかいをゼダデに至,いたらせ、","tok":[["ホル"],["山","やま"],["から"],["ハマテ"],["の"],["入口","いりぐち"],["まで"],["線","せん"],["を"],["引","ひき"],["、"],["その"],["境","さかい"],["を"],["ゼダデ"],["に"],["至らせ","いたらせ"],["、"]]},{"verse":9,"text":"またその境,さかいはジフロンに進,すすみ、ハザル・エノンに至,いたって尽,つきる。これがあなたがたの北,きたの境,さかいである。","tok":[["また"],["その"],["境","さかい"],["は"],["ジフロン"],["に"],["進み","すすみ"],["、"],["ハザル"],["・"],["エノン"],["に"],["至って","いたって"],["尽る","つきる"],["。"],["これ"],["が"],["あなた"],["がた"],["の"],["北","きた"],["の"],["境","さかい"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたがたの東,ひがしの境,さかいは、ハザル・エノンからシパムまで線,せんを引,ひき、","tok":[["あなた"],["がた"],["の"],["東","ひがし"],["の"],["境","さかい"],["は"],["、"],["ハザル"],["・"],["エノン"],["から"],["シパム"],["まで"],["線","せん"],["を"],["引","ひき"],["、"]]},{"verse":11,"text":"またその境,さかいはアインの東,ひがしの方,ほうで、シパムからリブラに下,くだり、またその境,さかいは下,くだってキンネレテの海,うみの東,ひがしの斜面,しゃめんに至,いたり、","tok":[["また"],["その"],["境","さかい"],["は"],["アイン"],["の"],["東","ひがし"],["の"],["方","ほう"],["で"],["、"],["シパム"],["から"],["リブラ"],["に"],["下り","くだり"],["、"],["また"],["その"],["境","さかい"],["は"],["下って","くだって"],["キンネレテ"],["の"],["海","うみ"],["の"],["東","ひがし"],["の"],["斜面","しゃめん"],["に"],["至","いたり"],["、"]]},{"verse":12,"text":"またその境,さかいはヨルダンに下,くだり、塩,しおの海,うみに至,いたって尽,つきる。あなたがたの国,くにの周囲,しゅういの境,さかいは以上,いじょうのとおりである」。","tok":[["また"],["その"],["境","さかい"],["は"],["ヨルダン"],["に"],["下り","くだり"],["、"],["塩","しお"],["の"],["海","うみ"],["に"],["至って","いたって"],["尽る","つきる"],["。"],["あなた"],["がた"],["の"],["国","くに"],["の"],["周囲","しゅうい"],["の"],["境","さかい"],["は"],["以上","いじょう"],["の"],["とおり"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"モーセはイスラエルの人々,ひとびとに命,めいじて言,いった、「これはあなたがたが、くじによって継,つぐべき地,ちである。主,しゅはこれを九つの部族,ぶぞくと半,はん部族,ぶぞくとに与,あたえよと命,めいじられた。","tok":[["モーセ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じて","めいじて"],["言った","いった"],["、"],["「"],["これ"],["は"],["あなた"],["が"],["た"],["が"],["、"],["くじ"],["によって"],["継ぐべき","つぐべき"],["地","ち"],["で"],["ある"],["。"],["主","しゅ"],["は"],["これ"],["を"],["九","ここの"],["つ"],["の"],["部族","ぶぞく"],["と"],["半","はん"],["部族","ぶぞく"],["と"],["に"],["与","あたえ"],["よ"],["と"],["命じられた","めいじられた"],["。"]]},{"verse":14,"text":"それはルベンの子孫,しそんの部族,ぶぞくとガドの子孫,しそんの部族,ぶぞくとが共,ともに父祖,ふその家,いえにしたがって、すでにその嗣,し業,ぎょうを受,うけ、またマナセの半,はん部族,ぶぞくもその嗣,し業,ぎょうを受,うけていたからである。","tok":[["それ"],["は"],["ルベン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["と"],["ガド"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["と"],["が"],["共","とも"],["に"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["、"],["すでに"],["その"],["嗣業","しぎょう"],["を"],["受け","うけ"],["、"],["また"],["マナセ"],["の"],["半","はん"],["部族","ぶぞく"],["も"],["その"],["嗣業","しぎょう"],["を"],["受て","うけて"],["いた"],["から"],["で"],["ある"],["。"]]},{"verse":15,"text":"この二つの部族,ぶぞくと半,はん部族,ぶぞくとはエリコに近,ちかいヨルダンのかなた、すなわち東,ひがしの方,ほう、日,ひの出,でる方,ほうで、その嗣,し業,ぎょうを受,うけた」。","tok":[["この"],["二","ふた"],["つ"],["の"],["部族","ぶぞく"],["と"],["半","はん"],["部族","ぶぞく"],["と"],["は"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["の"],["かなた"],["、"],["すなわち"],["東","ひがし"],["の"],["方","ほう"],["、"],["日","ひ"],["の"],["出る","でる"],["方","ほう"],["で"],["、"],["その"],["嗣業","しぎょう"],["を"],["受た","うけた"],["」"],["。"]]},{"verse":16,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":17,"text":"「あなたがたに、嗣,し業,ぎょうとして地,ちを分,わけ与,あたえる人々,ひとびとの名,なは次,つぎのとおりである。すなわち祭司,さいしエレアザルと、ヌンの子,こヨシュアとである。","tok":[["「"],["あなた"],["がた"],["に"],["、"],["嗣業","しぎょう"],["として"],["地","ち"],["を"],["分け与える","わけあたえる"],["人々","ひとびと"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["祭司","さいし"],["エレアザル"],["と"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["で"],["ある"],["。"]]},{"verse":18,"text":"あなたがたはまた、おのおの部族,ぶぞくから、つかさひとりずつを選,えらんで、地,ちを分,わけ与,あたえさせなければならない。","tok":[["あなた"],["がた"],["は"],["また"],["、"],["おのおの"],["部族","ぶぞく"],["から"],["、"],["つかさ"],["ひとり"],["ずつ"],["を"],["選らんで","えらんで"],["、"],["地","ち"],["を"],["分け与えさせなければ","わけあたえさせなければ"],["ならない"],["。"]]},{"verse":19,"text":"その人々,ひとびとの名,なは次,つぎのとおりである。すなわちユダの部族,ぶぞくではエフンネの子,こカレブ、","tok":[["その"],["人々","ひとびと"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["ユダ"],["の"],["部族","ぶぞく"],["で"],["は"],["エフンネ"],["の"],["子","こ"],["カレブ"],["、"]]},{"verse":20,"text":"シメオンの子孫,しそんの部族,ぶぞくではアミホデの子,こサムエル、","tok":[["シメオン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["で"],["は"],["アミホデ"],["の"],["子","こ"],["サムエル"],["、"]]},{"verse":21,"text":"ベニヤミンの部族,ぶぞくではキスロンの子,こエリダデ、","tok":[["ベニヤミン"],["の"],["部族","ぶぞく"],["で"],["は"],["キスロン"],["の"],["子","こ"],["エリダデ"],["、"]]},{"verse":22,"text":"ダンの子孫,しそんの部族,ぶぞくではヨグリの子,こつかさブッキ、","tok":[["ダン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["で"],["は"],["ヨグリ"],["の"],["子","こ"],["つ"],["か"],["さ"],["ブッキ"],["、"]]},{"verse":23,"text":"ヨセフの子孫,しそん、すなわちマナセの部族,ぶぞくではエポデの子,こつかさハニエル、","tok":[["ヨセフ"],["の"],["子孫","しそん"],["、"],["すなわち"],["マナセ"],["の"],["部族","ぶぞく"],["で"],["は"],["エポデ"],["の"],["子","こ"],["つかさ"],["ハニエル"],["、"]]},{"verse":24,"text":"エフライムの子孫,しそんの部族,ぶぞくではシフタンの子,こつかさケムエル、","tok":[["エフライム"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["で"],["は"],["シフタン"],["の"],["子","こ"],["つかさ"],["ケムエル"],["、"]]},{"verse":25,"text":"ゼブルンの子孫,しそんの部族,ぶぞくではパルナクの子,こつかさエリザパン、","tok":[["ゼブルン"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["で"],["は"],["パルナク"],["の"],["子","こ"],["つかさ"],["エリザパン"],["、"]]},{"verse":26,"text":"イッサカルの子孫,しそんの部族,ぶぞくではアザンの子,こつかさパルテエル、","tok":[["イッサカル"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["で"],["は"],["アザン"],["の"],["子","こ"],["つかさ"],["パルテエル"],["、"]]},{"verse":27,"text":"アセルの子孫,しそんの部族,ぶぞくではシロミの子,こつかさアヒウデ、","tok":[["アセル"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["で"],["は"],["シロミ"],["の"],["子","こ"],["つかさ"],["アヒウデ"],["、"]]},{"verse":28,"text":"ナフタリの子孫,しそんの部族,ぶぞくでは、アミホデの子,こつかさパダヘル。","tok":[["ナフタリ"],["の"],["子孫","しそん"],["の"],["部族","ぶぞく"],["で"],["は"],["、"],["アミホデ"],["の"],["子","こ"],["つかさ"],["パダヘル"],["。"]]},{"verse":29,"text":"カナンの地,ちでイスラエルの人々,ひとびとに嗣,し業,ぎょうを分,わけ与,あたえることを主,しゅが命,めいじられた人々,ひとびとは以上,いじょうのとおりである」。","tok":[["カナン"],["の"],["地","ち"],["で"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["嗣業","しぎょう"],["を"],["分け与える","わけあたえる"],["こと"],["を"],["主","しゅ"],["が"],["命じられた","めいじられた"],["人々","ひとびと"],["は"],["以上","いじょう"],["の"],["とおり"],["で"],["ある"],["」"],["。"]]}]
[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに命,めいじて言,いいなさい、『あなたがたは香,こうばしいかおりとしてわたしにささげる火祭,かさい、すなわち、わたしの供,そなえ物,もの、わたしの食物,しょくもつを定,さだめの時,ときにわたしにささげることを怠,おこたってはならない』。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じて","めいじて"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["香ばしい","こうばしい"],["かおり"],["として"],["わたし"],["に"],["ささげる"],["火祭","か"],["さい"],["、"],["すなわち"],["、"],["わたし"],["の"],["供え物","そなえもの"],["、"],["わたし"],["の"],["食物","しょくもつ"],["を"],["定め","さだめ"],["の"],["時","とき"],["に"],["わたし"],["に"],["ささげる"],["こと"],["を"],["怠たって","おこたって"],["は"],["ならない"],["』"],["。"]]},{"verse":3,"text":"また彼,かれらに言,いいなさい、『あなたがたが主,しゅにささぐべき火祭,かさいはこれである。すなわち一歳,さいの雄,おすの全,まったき小羊,こひつじ二頭,とうを毎日,まいにちささげて常燔祭,じょうはんさいとしなければならない。","tok":[["また"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["が"],["主に","しゅに"],["ささぐべき"],["火祭","かさい"],["は"],["これ"],["で"],["ある"],["。"],["すなわち"],["一歳","さい"],["の"],["雄","おす"],["の"],["全","ま"],["っ"],["たき"],["小羊","こひつじ"],["二頭","とう"],["を"],["毎日","まいにち"],["ささげて"],["常","つね"],["燔祭","はんさい"],["は"],["んさい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":4,"text":"すなわち一頭,とうの小羊,こひつじを朝,あさにささげ、一頭,とうの小羊,こひつじを夕,ゆうにささげなければならない。","tok":[["すなわち"],["一頭","とう"],["の"],["小羊","こひつじ"],["を"],["朝","あさ"],["に"],["ささげ"],["、"],["一頭","とう"],["の"],["小羊","こひつじ"],["を"],["夕","ゆう"],["に"],["ささげなければ"],["ならない"],["。"]]},{"verse":5,"text":"また麦粉,むぎこ一エパの十分,ぶんの一に、砕,くだいて取,とった油,あぶら一ヒンの四分,ぶんの一を混,まぜて素祭,そさいとしなければならない。","tok":[["また"],["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["一","いち"],["に"],["、"],["砕いて","くだいて"],["取った","とった"],["油","あぶら"],["一","いち"],["ヒン"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["混ぜて","まぜて"],["素","す"],["祭","まつり"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":6,"text":"これはシナイ山,さんで定,さだめられた常燔祭,じょうはんさいであって、主,しゅに香,こうばしいかおりとしてささげる火祭,かさいである。","tok":[["これ"],["は"],["シナイ"],["山","さん"],["で"],["定められた","さだめられた"],["常","つね"],["燔祭","はんさい"],["う"],["は"],["んさいで"],["あって"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["として"],["ささげる"],["火祭","か"],["さい"],["で"],["ある"],["。"]]},{"verse":7,"text":"またその灌祭,かんさいは小羊,こひつじ一頭,とうについて一ヒンの四分,ぶんの一をささげなければならない。すなわち聖所,せいじょにおいて主,しゅのために濃,こい酒,さけをそそいで灌祭,かんさいとしなければならない。","tok":[["また"],["その"],["灌祭","かんさい"],["は"],["小羊","こひつじ"],["一頭","とう"],["について"],["一","いち"],["ヒン"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["ささげなければ"],["ならない"],["。"],["すなわち"],["聖","せい"],["所","しょ"],["に"],["おいて"],["主","しゅ"],["の"],["ため"],["に"],["濃い","こい"],["酒","さけ"],["を"],["そそいで"],["灌祭","かんさい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":8,"text":"夕,ゆうには他,たの一頭,とうの小羊,こひつじをささげなければならない。その素祭,そさいと灌祭,かんさいとは朝,あさのものと同,おなじようにし、その小羊,こひつじを火祭,かさいとしてささげ、主,しゅに香,こうばしいかおりとしなければならない。","tok":[["夕","ゆう"],["に"],["は"],["他","た"],["の"],["一頭","とう"],["の"],["小羊","こひつじ"],["を"],["ささげなければ"],["ならない"],["。"],["その"],["素","す"],["祭","まつり"],["と"],["灌祭","かんさい"],["と"],["は"],["朝","あさ"],["の"],["もの"],["と"],["同じ","おなじ"],["よう"],["に"],["し"],["、"],["その"],["小羊","こひつじ"],["を"],["火祭","かさい"],["として"],["ささげ"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":9,"text":"また安息日,あんそくにちには一歳,さいの雄,おすの全,まったき小羊,こひつじ二頭,とうと、麦粉,むぎこ一エパの十分,んの二に油,あぶらを混,まぜた素祭,そさいと、その灌祭,かんさいとをささげなければならない。","tok":[["また"],["安息日","あんそくにち"],["に"],["は"],["一歳","さい"],["の"],["雄","おす"],["の"],["全","ま"],["っ"],["たき"],["小羊","こひつじ"],["二頭","とう"],["と"],["、"],["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ん"],["の"],["二","に"],["に"],["油","あぶら"],["を"],["混ぜた","まぜた"],["素","す"],["祭","まつり"],["と"],["、"],["その"],["灌祭","かんさい"],["と"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":10,"text":"これは安息日,あんそくにちごとの燔祭,はんさいであって、常燔祭,じょうはんさいとその灌祭,かんさいとに加,くわえらるべきものである。","tok":[["これ"],["は"],["安息日","あんそくにちごと"],["の"],["燔祭","はんさい"],["で"],["あって"],["、"],["常","つね"],["燔祭","はんさい"],["は"],["んさい"],["と"],["その"],["灌祭","かんさい"],["と"],["に"],["加えらるべき","くわえらるべき"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"またあなたがたは月々,つきづきの第,だい一日,にちに燔祭,はんさいを主,しゅにささげなければならない。すなわち若,わかい雄牛,おうし二頭,とう、雄羊,おひつじ一頭,とう、一歳,さいの雄,おすの全,まったき小羊,こひつじ七頭,とうをささげ、","tok":[["また"],["あなた"],["がた"],["は"],["月々","つきづき"],["の"],["第","だい"],["一","いち"],["日","にち"],["に"],["燔祭","はんさい"],["を"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"],["すなわち"],["若い","わかい"],["雄牛","おうし"],["二頭","と"],["う"],["、"],["雄羊","おひつじ"],["一頭","と"],["う"],["、"],["一歳","さい"],["の"],["雄","おす"],["の"],["全","ま"],["っ"],["たき"],["小羊","こひつじ"],["七頭","とう"],["を"],["ささげ"],["、"]]},{"verse":12,"text":"雄牛,おうし一頭,とうには麦粉,むぎこ一エパの十分,ぶんの三に油,あぶらを混,まぜたものを素祭,そさいとし、雄羊,おひつじ一頭,とうには麦粉,むぎこ一エパの十分,ぶんの二に油,あぶらを混,まぜたものを素祭,そさいとし、","tok":[["雄牛","おうし"],["一頭","とう"],["に"],["は"],["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["三","さん"],["に"],["油","あぶら"],["を"],["混ぜた","まぜた"],["もの"],["を"],["素","す"],["祭","まつり"],["さい"],["と"],["し"],["、"],["雄羊","おひつじ"],["一頭","とう"],["に"],["は"],["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["二","に"],["に"],["油","あぶら"],["を"],["混ぜた","まぜた"],["もの"],["を"],["素","す"],["祭","まつり"],["さい"],["と"],["し"],["、"]]},{"verse":13,"text":"小羊,こひつじ一頭,とうには麦粉,むぎこ十分,ぶんの一に油,あぶらを混,まぜたものを素祭,そさいとし、これを香,こうばしいかおりの燔祭,はんさいとして主,しゅのために火祭,かさいとしなければならない。","tok":[["小羊","こひつじ"],["一頭","とう"],["に"],["は"],["麦粉","むぎこ"],["十分","ぶん"],["の"],["一","いち"],["に"],["油","あぶら"],["を"],["混ぜた","まぜた"],["もの"],["を"],["素","す"],["祭","まつり"],["さい"],["と"],["し"],["、"],["これ"],["を"],["香ばしい","こうばしい"],["かおり"],["の"],["燔祭","はんさい"],["として"],["主","しゅ"],["の"],["ため"],["に"],["火祭","かさい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":14,"text":"またその灌祭,かんさいは雄牛,おうし一頭,とうについてぶどう酒,しゅ一ヒンの二分,ぶんの一、雄羊,おひつじ一頭,とうについて一ヒンの三分,ぶんの一、小羊,こひつじ一頭,とうについて一ヒンの四分,ぶんの一をささげなければならない。これは年,ねんの月々,つきづきを通,つうじて、新月,しんげつごとにささぐべき燔祭,はんさいである。","tok":[["また"],["その"],["灌祭","かんさい"],["は"],["雄牛","おうし"],["一頭","とう"],["について"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["ヒン"],["の"],["二分","ぶん"],["の"],["一","いち"],["、"],["雄羊","おひつじ"],["一頭","とう"],["について"],["一","いち"],["ヒン"],["の"],["三分","ぶん"],["の"],["一","いち"],["、"],["小羊","こひつじ"],["一頭","とう"],["について"],["一","いち"],["ヒン"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["ささげなければ"],["ならない"],["。"],["これ"],["は"],["年","ねん"],["の"],["月々","つきづき"],["を"],["通じて","つうじて"],["、"],["新月","しんげつ"],["ごと"],["に"],["ささぐべき"],["燔祭","はんさい"],["で"],["ある"],["。"]]},{"verse":15,"text":"また常燔祭,じょうはんさいとその灌祭,かんさいとのほかに、雄,おやぎ一頭,とうを罪祭,ざいさいとして主,しゅにささげなければならない。","tok":[["また"],["常","つね"],["燔祭","はんさい"],["は"],["んさい"],["と"],["その"],["灌祭","かんさい"],["と"],["の"],["ほか"],["に"],["、"],["雄","お"],["やぎ"],["一頭","とう"],["を"],["罪","つみ"],["祭","まつり"],["として"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":16,"text":"正月,しょうがつの十四日,かは主,しゅの過越,すぎこしの祭,まつりである。","tok":[["正月","しょうがつ"],["の"],["十四日","か"],["は"],["主","しゅ"],["の"],["過越","すぎこし"],["の"],["祭","まつり"],["で"],["ある"],["。"]]},{"verse":17,"text":"またその月,つきの十五日,にちは祭日,さいじつとしなければならない。七日,なぬかのあいだ種,たね入,いれぬパンを食,たべなければならない。","tok":[["また"],["その"],["月","つき"],["の"],["十五","じゅうご"],["日","にち"],["は"],["祭日","さいじつ"],["と"],["しなければ"],["ならない"],["。"],["七日","なぬか"],["の"],["あいだ"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["を"],["食べなければ","たべなければ"],["ならない"],["。"]]},{"verse":18,"text":"その初,はじめの日,ひには聖,せい会,かいを開,ひらかなければならない。なんの労役,ろうえきをもしてはならない。","tok":[["その"],["初め","はじめ"],["の"],["日","ひ"],["に"],["は"],["聖会","せいかい"],["を"],["開らかなければ","ひらかなければ"],["ならない"],["。"],["なん"],["の"],["労役","ろうえき"],["を"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":19,"text":"あなたがたは火祭,かさいとして主,しゅに燔祭,はんさいをささげなければならない。すなわち若,わかい雄牛,おうし二頭,とう、雄羊,おひつじ一頭,とう、一歳,さいの雄,おすの小羊,こひつじ七頭,とうをささげなければならない。これらはみな全,まったきものでなければならない。","tok":[["あなた"],["がた"],["は"],["火祭","かさい"],["として"],["主に","しゅに"],["燔祭","はんさい"],["を"],["ささげなければ"],["ならない"],["。"],["すなわち"],["若い","わかい"],["雄牛","おうし"],["二頭","と"],["う"],["、"],["雄羊","おひつじ"],["一頭","と"],["う"],["、"],["一歳","さい"],["の"],["雄","おす"],["の"],["小羊","こひつじ"],["七頭","とう"],["を"],["ささげなければ"],["ならない"],["。"],["これ"],["ら"],["は"],["みな"],["全","まったきも"],["ので"],["なければ"],["ならない"],["。"]]},{"verse":20,"text":"その素祭,そさいには油,あぶらを混,まぜた麦粉,むぎこをささげなければならない。すなわち雄牛,おうし一頭,とうにつき麦粉,むぎこ一エパの十分,ぶんの三、雄羊,おひつじ一頭,とうにつき十分,ぶんの二をささげ、","tok":[["その"],["素","す"],["祭","まつり"],["に"],["は"],["油","あぶら"],["を"],["混ぜた","まぜた"],["麦粉","むぎこ"],["を"],["ささげなければ"],["ならない"],["。"],["すなわち"],["雄牛","おうし"],["一頭","とう"],["に"],["つき"],["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["三","さん"],["、"],["雄羊","おひつじ"],["一頭","とう"],["に"],["つき"],["十分","ぶん"],["の"],["二","に"],["を"],["ささげ"],["、"]]},{"verse":21,"text":"また七頭,とうの小羊,こひつじにはその一頭,とうごとに十分,ぶんの一をささげなければならない。","tok":[["また"],["七頭","とう"],["の"],["小羊","こひつじ"],["に"],["は"],["その"],["一頭","とうごと"],["に"],["十分","ぶん"],["の"],["一","いち"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":22,"text":"また雄,おやぎ一頭,とうを罪祭,ざいさいとしてささげ、あなたがたのために罪,つみのあがないをしなければならない。","tok":[["また"],["雄","お"],["やぎ"],["一頭","とう"],["を"],["罪","つみ"],["祭","まつり"],["として"],["ささげ"],["、"],["あなた"],["がた"],["の"],["ため"],["に"],["罪","つみ"],["の"],["あ"],["が"],["ない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":23,"text":"あなたがたは朝,あさにささげる常燔祭,じょうはんさいの燔祭,はんさいのほかに、これらをささげなければならない。","tok":[["あなた"],["がた"],["は"],["朝","あさ"],["に"],["ささげる"],["常","つね"],["燔祭","はんさい"],["は"],["んさい"],["の"],["燔祭","はんさい"],["の"],["ほか"],["に"],["、"],["これ"],["ら"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":24,"text":"このようにあなたがたは七日,なぬかのあいだ毎日,まいにち、火祭,かさいの食物,しょくもつをささげて、主,しゅに香,こうばしいかおりとしなければならない。これは常燔祭,じょうはんさいとその灌祭,かんさいとのほかにささぐべきものである。","tok":[["この"],["よう"],["に"],["あなた"],["がた"],["は"],["七日","なぬか"],["の"],["あいだ"],["毎日","まいにち"],["、"],["火祭","かさい"],["の"],["食物","しょくもつ"],["を"],["ささげて"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["しなければ"],["ならない"],["。"],["これ"],["は"],["常","つね"],["燔祭","はんさい"],["は"],["んさい"],["と"],["その"],["灌祭","かんさい"],["と"],["の"],["ほか"],["に"],["ささぐべき"],["もの"],["で"],["ある"],["。"]]},{"verse":25,"text":"そして第,だい七日,にちに、あなたがたは聖,せい会,かいを開,ひらかなければならない。なんの労役,ろうえきをもしてはならない。","tok":[["そして"],["第","だい"],["七","なな"],["日","にち"],["に"],["、"],["あなた"],["がた"],["は"],["聖会","せいかい"],["を"],["開らかなければ","ひらかなければ"],["ならない"],["。"],["なん"],["の"],["労役","ろうえき"],["を"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":26,"text":"あなたがたは七週,しゅうの祭,まつり、すなわち新,あたらしい素祭,そさいを主,しゅにささげる初穂,はつほの日,ひにも聖,せい会,かいを開,ひらかなければならない。なんの労役,ろうえきをもしてはならない。","tok":[["あなた"],["がた"],["は"],["七","なな"],["週","しゅう"],["の"],["祭","まつり"],["、"],["すなわち"],["新らしい","あたらしい"],["素","す"],["祭","まつり"],["を"],["主に","しゅに"],["ささげる"],["初穂","はつほ"],["の"],["日","ひ"],["に"],["も"],["聖い","せい"],["会","かい"],["を"],["開らかなければ","ひらかなければ"],["ならない"],["。"],["なん"],["の"],["労役","ろうえき"],["を"],["も"],["して"],["は"],["ならない"],["。"]]},{"verse":27,"text":"あなたがたは燔祭,はんさいをささげて、主,しゅに香,こうばしいかおりとしなければならない。すなわち若,わかい雄牛,おうし二頭,とう、雄羊,おひつじ一頭,とう、一歳,さいの雄,おすの小羊,こひつじ七頭,とうをささげなければならない。","tok":[["あなた"],["がた"],["は"],["燔祭","はんさい"],["を"],["ささげて"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["しなければ"],["ならない"],["。"],["すなわち"],["若い","わかい"],["雄牛","おうし"],["二頭","と"],["う"],["、"],["雄羊","おひつじ"],["一頭","と"],["う"],["、"],["一歳","さい"],["の"],["雄","おす"],["の"],["小羊","こひつじ"],["七頭","とう"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":28,"text":"その素祭,そさいには油,あぶらを混,まぜた麦粉,むぎこをささげなければならない。すなわち雄牛,おうし一頭,とうにつき一エパの十分,ぶんの三、雄羊,おひつじ一頭,とうにつき十分,ぶんの二をささげ、","tok":[["その"],["素","す"],["祭","まつり"],["に"],["は"],["油","あぶら"],["を"],["混ぜた","まぜた"],["麦粉","むぎこ"],["を"],["ささげなければ"],["ならない"],["。"],["すなわち"],["雄牛","おうし"],["一頭","とう"],["に"],["つき"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["三","さん"],["、"],["雄羊","おひつじ"],["一頭","とう"],["に"],["つき"],["十分","ぶん"],["の"],["二","に"],["を"],["ささげ"],["、"]]},{"verse":29,"text":"また七頭,とうの小羊,こひつじには一頭,とうごとに十分,ぶんの一をささげなければならない。","tok":[["また"],["七頭","とう"],["の"],["小羊","こひつじ"],["に"],["は"],["一頭","とうごと"],["に"],["十分","ぶん"],["の"],["一","いち"],["を"],["ささげなければ"],["ならない"],["。"]]},{"verse":30,"text":"また雄,おやぎ一頭,とうをささげてあなたがたのために罪,つみのあがないをしなければならない。","tok":[["また"],["雄","お"],["やぎ"],["一頭","とう"],["を"],["ささげて"],["あなた"],["がた"],["の"],["ため"],["に"],["罪","つみ"],["の"],["あ"],["が"],["ない"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":31,"text":"あなたがたは常燔祭,じょうはんさいとその素祭,そさいとその灌祭,かんさいとのほかに、これらをささげなければならない。これらはみな、全,まったきものでなければならない。","tok":[["あなた"],["がた"],["は"],["常","つね"],["燔祭","はんさい"],["は"],["んさい"],["と"],["その"],["素","す"],["祭","まつり"],["の"],["灌祭","かんさい"],["と"],["の"],["ほか"],["に"],["、"],["これ"],["ら"],["を"],["ささげなければ"],["ならない"],["。"],["これ"],["ら"],["は"],["みな"],["、"],["全","まったきも"],["ので"],["なければ"],["ならない"],["。"]]}]
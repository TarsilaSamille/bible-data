から"],["生まれた","うまれた"],["もの"],["を"],["、"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["によって"],["調べ","しらべ"],["、"],["すべて"],["戦争","せんそう"],["に"],["出る","でる"],["こと"],["の"],["できる"],["二十歳","さ"],["い"],["以上","いじょう"],["の"],["者","もの"],["の"],["名","な"],["の"],["数","かず"],["を"],["得た","えた"],["が"],["、"]]},{"verse":41,"text":"アセルの部族,ぶぞくのうちで、数,かぞえられたものは四万一千五百人,にんであった。","tok":[["アセル"],["の"],["部族","ぶぞく"],["の"],["うち"],["で"],["、"],["数えられた","かぞえられた"],["もの"],["は"],["四万一千五百","よんまんいちせんごひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":42,"text":"ナフタリの子,こたちから生,うまれたものを、その氏族,しぞくにより、その父祖,ふその家,いえによって調,しらべ、すべて戦争,せんそうに出,でることのできる二十歳,さい以上,いじょうの者,ものの名,なの数,かずを得,えたが、","tok":[["ナフタリ"],["の"],["子","こ"],["たち"],["から"],["生まれた","うまれた"],["もの"],["を"],["、"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["によって"],["調べ","しらべ"],["、"],["すべて"],["戦争","せんそう"],["に"],["出る","でる"],["こと"],["の"],["できる"],["二十歳","さ"],["い"],["以上","いじょう"],["の"],["者","もの"],["の"],["名","な"],["の"],["数","かず"],["を"],["得た","えた"],["が"],["、"]]},{"verse":43,"text":"ナフタリの部族,ぶぞくのうちで、数,かぞえられたものは、五万三千四百人,にんであった。","tok":[["ナフタリ"],["の"],["部族","ぶぞく"],["の"],["うち"],["で"],["、"],["数えられた","かぞえられた"],["もの"],["は"],["、"],["五万三千四百","ごまんさんせんよんひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":44,"text":"これらが数,かぞえられた人々,ひとびとであって、モーセとアロンとイスラエルのつかさたちとが数,かぞえた人々,ひとびとである。そのつかさたちは十二人,にんであって、おのおのその父祖,ふその家,いえのために出,でたものである。","tok":[["これ"],["ら"],["が"],["数えられた","かぞえられた"],["人々","ひとびと"],["で"],["あって"],["、"],["モーセ"],["と"],["アロン"],["と"],["イスラエル"],["の"],["つかさ"],["たち"],["と"],["が"],["数えた","かぞえた"],["人々","ひとびと"],["で"],["ある"],["。"],["その"],["つかさ"],["たち"],["は"],["十二人","にん"],["で"],["あって"],["、"],["おのおの"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["ため"],["に"],["出た","でた"],["もの"],["で"],["ある"],["。"]]},{"verse":45,"text":"そしてイスラエルの人々,ひとびとのうち、その父祖,ふその家,いえにしたがって数,かぞえられた者,ものは、すべてイスラエルのうち、戦争,せんそうに出,でることのできる二十歳,さい以上,いじょうの者,ものであって、","tok":[["そして"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["、"],["すべて"],["イスラエル"],["の"],["うち"],["、"],["戦争","せんそう"],["に"],["出る","でる"],["こと"],["の"],["できる"],["二十歳","さ"],["い"],["以上","いじょう"],["の"],["者","もの"],["で"],["あって"],["、"]]},{"verse":46,"text":"その数,かぞえられた者,ものは合,あわせて六十万三千五百五十人,にんであった。","tok":[["その"],["数えられた","かぞえられた"],["者","もの"],["は"],["合","あわせ"],["て"],["六十万三千五百五","ろくじゅうまんさんせんごひゃくご"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":47,"text":"しかし、レビびとは、その父祖,ふその部族,ぶぞくにしたがって、そのうちに数,かぞえられなかった。","tok":[["しかし"],["、"],["レビ"],["び"],["と"],["は"],["、"],["その"],["父祖","ふそ"],["の"],["部族","ぶぞく"],["に"],["したがって"],["、"],["その"],["うち"],["に"],["数えられなかった","かぞえられなかった"],["。"]]},{"verse":48,"text":"すなわち、主,しゅはモーセに言,いわれた、","tok":[["すなわち"],["、"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":49,"text":"「あなたはレビの部族,ぶぞくだけは数,かぞえてはならない。またその総数,そうすうをイスラエルの人々,ひとびとのうちに数,かぞえあげてはならない。","tok":[["「"],["あなた"],["は"],["レビ"],["の"],["部族","ぶぞく"],["だけ"],["は"],["数えて","かぞえて"],["は"],["ならない"],["。"],["また"],["その"],["総数","そうすう"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["数えあげて","かぞえあげて"],["は"],["ならない"],["。"]]},{"verse":50,"text":"あなたはレビびとに、あかしの幕屋,まくやと、そのもろもろの器,うつわと、それに附属,ふぞくするもろもろの物,ものを管理,かんりさせなさい。彼,かれらは幕屋,まくやと、そのもろもろの器,うつわとを持,もち運,はこび、またそこで務,つとめをし、幕屋,まくやのまわりに宿営,しゅくえいしなければならない。","tok":[["あなた"],["は"],["レビ"],["びと"],["に"],["、"],["あかし"],["の"],["幕屋","まくや"],["と"],["、"],["その"],["もろもろ"],["の"],["器","うつわ"],["と"],["、"],["それ"],["に"],["附属","ふぞく"],["する"],["もろもろ"],["の"],["物","もの"],["を"],["管理","かんり"],["させ"],["なさい"],["。"],["彼","かれ"],["ら"],["は"],["幕屋","まくや"],["と"],["、"],["その"],["もろもろ"],["の"],["器","うつわ"],["と"],["を"],["持","もち"],["運こび","はこび"],["、"],["また"],["そこ"],["で"],["務め","つとめ"],["を"],["し"],["、"],["幕屋","まくや"],["の"],["まわり"],["に"],["宿営","しゅくえい"],["しなければ"],["ならない"],["。"]]},{"verse":51,"text":"幕屋,まくやが進,すすむ時,ときは、レビびとがこれを取,とりくずし、幕屋,まくやを張,はる時,ときは、レビびとがこれを組,くみ立,たてなければならない。ほかの人,ひとがこれに近,ちかづく時,ときは殺,ころされるであろう。","tok":[["幕屋","まくや"],["が"],["進","すすむ"],["時","とき"],["は"],["、"],["レビ"],["びと"],["が"],["これ"],["を"],["取","とり"],["くずし"],["、"],["幕屋","まくや"],["を"],["張る","はる"],["時","とき"],["は"],["、"],["レビ"],["びと"],["が"],["これ"],["を"],["組立","くみたて"],["なければ"],["ならない"],["。"],["ほか"],["の"],["人","ひと"],["が"],["これ"],["に"],["近づく","ちかづく"],["時","とき"],["は"],["殺ろされるで","ころされるで"],["あろう"],["。"]]},{"verse":52,"text":"イスラエルの人々,ひとびとはその部隊,ぶたいにしたがって、おのおのその宿営,しゅくえいに、おのおのその旗,はたのもとにその天幕,てんまくを張,はらなければならない。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["その"],["部隊","ぶたい"],["に"],["したがって"],["、"],["おのおの"],["その"],["宿営","しゅくえい"],["に"],["、"],["おのおの"],["その"],["旗","はた"],["の"],["もと"],["に"],["その"],["天幕","てんまく"],["を"],["張らなければ","はらなければ"],["ならない"],["。"]]},{"verse":53,"text":"しかし、レビびとは、あかしの幕屋,まくやのまわりに宿営,しゅくえいしなければならない。そうすれば、主,しゅの怒,いかりはイスラエルの人々,ひとびとの会衆,かいしゅうの上,うえに臨,のぞむことがないであろう。レビびとは、あかしの幕屋,まくやの務,つとめを守,まもらなければならない」。","tok":[["しかし"],["、"],["レビ"],["び"],["と"],["は"],["、"],["あかし"],["の"],["幕屋","まくや"],["の"],["まわり"],["に"],["宿営","しゅくえい"],["しなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["主","しゅ"],["の"],["怒り","いかり"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["会衆","かいしゅう"],["の"],["上","うえ"],["に"],["臨む","のぞむ"],["こと"],["が"],["ないで"],["あろう"],["。"],["レビ"],["び"],["と"],["は"],["、"],["あかし"],["の"],["幕屋","まくや"],["の"],["務め","つとめ"],["を"],["守らなければ","まもらなければ"],["ならない"],["」"],["。"]]},{"verse":54,"text":"イスラエルの人々,ひとびとはこのようにして、すべて主,しゅがモーセに命,めいじられたように行,おこなった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["この"],["よう"],["に"],["して"],["、"],["すべて"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["行なった","おこなった"],["。"]]}]
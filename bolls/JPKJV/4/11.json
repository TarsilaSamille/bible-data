[{"verse":1,"text":"さて、民,たみは災難,さいなんに会,あっている人,ひとのように、主,しゅの耳,みみにつぶやいた。主,しゅはこれを聞,きいて怒,いかりを発,はっせられ、主,しゅの火,ひが彼,かれらのうちに燃,もえあがって、宿営,しゅくえいの端,はしを焼,やいた。","tok":[["さて"],["、"],["民","たみ"],["は"],["災難","さいなん"],["に"],["会って","あって"],["いる"],["人","ひと"],["の"],["よう"],["に"],["、"],["主","しゅ"],["の"],["耳","みみ"],["に"],["つぶやいた"],["。"],["主","しゅ"],["は"],["これ"],["を"],["聞いて","きいて"],["怒り","いかり"],["を"],["発せられ","はっせられ"],["、"],["主","しゅ"],["の"],["火","ひ"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["燃えあがって","もえあがって"],["、"],["宿営","しゅくえい"],["の"],["端","はし"],["を"],["焼いた","やいた"],["。"]]},{"verse":2,"text":"そこで民,たみはモーセにむかって叫,さけんだ。モーセが主,しゅに祈,いのったので、その火,ひはしずまった。","tok":[["そこ"],["で"],["民","たみ"],["は"],["モーセ"],["に"],["むかって"],["叫けんだ","さけんだ"],["。"],["モーセ"],["が"],["主に","しゅに"],["祈った","いのった"],["ので"],["、"],["その"],["火","ひ"],["は"],["しずまった"],["。"]]},{"verse":3,"text":"主,しゅの火,ひが彼,かれらのうちに燃,もえあがったことによって、その所,ところの名,なはタベラと呼,よばれた。","tok":[["主","しゅ"],["の"],["火","ひ"],["が"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["燃えあがった","もえあがった"],["こと"],["によって"],["、"],["その"],["所","ところ"],["の"],["名","な"],["は"],["タベラ"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":4,"text":"また彼,かれらのうちにいた多,おおくの寄,より集,あつまりびとは欲心,よくしんを起,おこし、イスラエルの人々,ひとびともまた再,ふたたび泣,ないて言,いった、「ああ、肉,にくが食,たべたい。","tok":[["また"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["いた"],["多く","おおく"],["の"],["寄り集まり","よりあつまり"],["び"],["と"],["は"],["欲心","よくしん"],["を"],["起こし","おこし"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["も"],["また"],["再び","ふたたび"],["泣いて","ないて"],["言った","いった"],["、"],["「"],["ああ"],["、"],["肉","にく"],["が"],["食べたい","たべたい"],["。"]]},{"verse":5,"text":"われわれは思,おもい起,おこすが、エジプトでは、ただで、魚,うおを食,たべた。きゅうりも、すいかも、にらも、たまねぎも、そして、にんにくも。","tok":[["われわれ"],["は"],["思い起こす","おもいおこす"],["が"],["、"],["エジプト"],["で"],["は"],["、"],["ただ"],["で"],["、"],["魚","うお"],["を"],["食べた","たべた"],["。"],["きゅうり"],["も"],["、"],["すいか"],["も"],["、"],["にら"],["も"],["、"],["たまねぎ"],["も"],["、"],["そして"],["、"],["にんにく"],["も"],["。"]]},{"verse":6,"text":"しかし、いま、われわれの精根,せいこんは尽,つきた。われわれの目,めの前,まえには、このマナのほか何,なにもない」。","tok":[["しかし"],["、"],["いま"],["、"],["われわれ"],["の"],["精根","せいこん"],["は"],["尽た","つきた"],["。"],["われわれ"],["の"],["目","め"],["の"],["前","まえ"],["に"],["は"],["、"],["この"],["マナ"],["の"],["ほか"],["何に","なに"],["も"],["ない"],["」"],["。"]]},{"verse":7,"text":"マナは、こえんどろの実,みのようで、色,いろはブドラクの色,いろのようであった。","tok":[["マナ"],["は"],["、"],["こえ"],["ん"],["どろ"],["の"],["実","み"],["の"],["よう"],["で"],["、"],["色","いろ"],["は"],["ブドラク"],["の"],["色","いろ"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":8,"text":"民,たみは歩,あるきまわって、これを集,あつめ、ひきうすでひき、または、うすでつき、かまで煮,にて、これをもちとした。その味,あじは油,あぶら菓子,かしの味,あじのようであった。","tok":[["民","たみ"],["は"],["歩き","あるき"],["まわって"],["、"],["これ"],["を"],["集め","あつめ"],["、"],["ひきうす"],["で"],["ひき"],["、"],["また"],["は"],["、"],["うす"],["で"],["つき"],["、"],["か"],["まで"],["煮て","にて"],["、"],["これ"],["を"],["もち"],["と"],["した"],["。"],["その"],["味","あじ"],["は"],["油","あぶら"],["菓子","かし"],["の"],["味","あじ"],["の"],["よう"],["で"],["あった"],["。"]]},{"verse":9,"text":"夜,よる、宿営,しゅくえいの露,つゆがおりるとき、マナはそれと共,ともに降,ふった。","tok":[["夜","よる"],["、"],["宿営","しゅくえい"],["の"],["露","つゆ"],["が"],["おりる"],["とき"],["、"],["マナ"],["は"],["それ"],["と"],["共","とも"],["に"],["降った","ふった"],["。"]]},{"verse":10,"text":"モーセは、民,たみが家,いえごとに、おのおのその天幕,てんまくの入口,いりぐちで泣,なくのを聞,きいた。そこで主,しゅは激,はげしく怒,いかられ、またモーセは不快,ふかいに思,おもった。","tok":[["モーセ"],["は"],["、"],["民","た"],["み"],["が"],["家","いえ"],["ごと"],["に"],["、"],["おのおの"],["その"],["天幕","てんまく"],["の"],["入口","いりぐち"],["で"],["泣く","なく"],["の"],["を"],["聞いた","きいた"],["。"],["そこ"],["で"],["主","しゅ"],["は"],["激しく","はげしく"],["怒","い"],["から"],["れ"],["、"],["また"],["モーセ"],["は"],["不快","ふかい"],["に"],["思った","おもった"],["。"]]},{"verse":11,"text":"そして、モーセは主,しゅに言,いった、「あなたはなぜ、しもべに悪,わるい仕打,しうちをされるのですか。どうしてわたしはあなたの前,まえに恵,めぐみを得,えないで、このすべての民,たみの重荷,おもにを負,おわされるのですか。","tok":[["そして"],["、"],["モーセ"],["は"],["主に","しゅに"],["言った","いった"],["、"],["「"],["あなた"],["は"],["なぜ"],["、"],["しもべ"],["に"],["悪い","わるい"],["仕打","しうち"],["を"],["される"],["の"],["です"],["か"],["。"],["どう"],["して"],["わたし"],["は"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得ないで","えないで"],["、"],["この"],["すべて"],["の"],["民","たみ"],["の"],["重荷","おもに"],["を"],["負わされる","おわされる"],["の"],["です"],["か"],["。"]]},{"verse":12,"text":"わたしがこのすべての民,たみを、はらんだのですか。わたしがこれを生,うんだのですか。そうではないのに、あなたはなぜわたしに『養,やしない親,おやが乳児,にゅうじを抱,だくように、彼,かれらをふところに抱,だいて、あなたが彼,かれらの先祖,せんぞたちに誓,ちかわれた地,ちに行,いけ』と言,いわれるのですか。","tok":[["わたし"],["が"],["この"],["すべて"],["の"],["民","たみ"],["を"],["、"],["はらんだ"],["の"],["です"],["か"],["。"],["わたし"],["が"],["これ"],["を"],["生","うんだ"],["の"],["です"],["か"],["。"],["そう"],["で"],["は"],["ない"],["のに"],["、"],["あなた"],["は"],["なぜ"],["わたし"],["に"],["『"],["養い親","やしないおや"],["が"],["乳児","にゅうじ"],["を"],["抱","だくよう"],["に"],["、"],["彼","かれ"],["ら"],["を"],["ふところ"],["に"],["抱いて","だいて"],["、"],["あなた"],["が"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["に"],["誓われた","ちかわれた"],["地","ち"],["に"],["行け","いけ"],["』"],["と"],["言われる","いわれる"],["の"],["です"],["か"],["。"]]},{"verse":13,"text":"わたしはどこから肉,にくを獲,えて、このすべての民,たみに与,あたえることができましょうか。彼,かれらは泣,ないて、『肉,にくを食,たべさせよ』とわたしに言,いっているのです。","tok":[["わたし"],["は"],["どこ"],["から"],["肉","にく"],["を"],["獲て","えて"],["、"],["この"],["すべて"],["の"],["民","たみ"],["に"],["与える","あたえる"],["こと"],["が"],["できましょう"],["か"],["。"],["彼","かれ"],["ら"],["は"],["泣いて","ないて"],["、"],["『"],["肉","にく"],["を"],["食べさせ","たべさせ"],["よ"],["』"],["と"],["わたし"],["に"],["言って","いって"],["いる"],["の"],["です"],["。"]]},{"verse":14,"text":"わたしひとりでは、このすべての民,たみを負,おうことができません。それはわたしには重,おも過,すぎます。","tok":[["わたし"],["ひとり"],["で"],["は"],["、"],["この"],["すべて"],["の"],["民","たみ"],["を"],["負う","おう"],["こと"],["が"],["できません"],["。"],["それ"],["は"],["わたし"],["に"],["は"],["重","お"],["も"],["過ます","すぎます"],["。"]]},{"verse":15,"text":"もしわたしがあなたの前,まえに恵,めぐみを得,えますならば、わたしにこのような仕打,しうちをされるよりは、むしろ、ひと思,おもいに殺,ころし、このうえ苦,くるしみに会,あわせないでください」。","tok":[["もし"],["わたし"],["が"],["あなた"],["の"],["前","まえ"],["に"],["恵","めぐみ"],["を"],["得ますならば","えますならば"],["、"],["わたし"],["に"],["この"],["よう"],["な"],["仕打","しうち"],["を"],["される"],["より"],["は"],["、"],["むしろ"],["、"],["ひと思い","ひとおもい"],["に"],["殺ろし","ころし"],["、"],["この"],["うえ"],["苦しみ","くるしみ"],["に"],["会わせないで","あわせないで"],["ください"],["」"],["。"]]},{"verse":16,"text":"主,しゅはモーセに言,いわれた、「イスラエルの長老,ちょうろうたちのうち、民,たみの長老,ちょうろうとなり、つかさとなるべきことを、あなたが知,しっている者,もの七十人,にんをわたしのもとに集,あつめ、会見,かいけんの幕屋,まくやに連,つれてきて、そこにあなたと共,ともに立,たたせなさい。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["の"],["うち"],["、"],["民","たみ"],["の"],["長老","ちょうろう"],["と"],["なり"],["、"],["つかさ"],["と"],["なるべき"],["こと"],["を"],["、"],["あなた"],["が"],["知って","しって"],["いる"],["者","もの"],["七","なな"],["十人","じゅうにん"],["を"],["わたし"],["の"],["もと"],["に"],["集め","あつめ"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["連れて","つれて"],["きて"],["、"],["そこ"],["に"],["あなた"],["と"],["共","とも"],["に"],["立たせ","たたせ"],["なさい"],["。"]]},{"verse":17,"text":"わたしは下,くだって、その所,ところで、あなたと語,かたり、またわたしはあなたの上,うえにある霊,れいを、彼,かれらにも分,わけ与,あたえるであろう。彼,かれらはあなたと共,ともに、民,たみの重荷,おもにを負,おい、あなたが、ただひとりで、それを負,おうことのないようにするであろう。","tok":[["わたし"],["は"],["下って","くだって"],["、"],["その"],["所","ところ"],["で"],["、"],["あなた"],["と"],["語り","かたり"],["、"],["また"],["わたし"],["は"],["あなた"],["の"],["上","うえ"],["に"],["ある"],["霊","れい"],["を"],["、"],["彼","かれ"],["ら"],["に"],["も"],["分け与えるで","わけあたえるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["と"],["共","とも"],["に"],["、"],["民","たみ"],["の"],["重荷","おもに"],["を"],["負い","おい"],["、"],["あなた"],["が"],["、"],["ただ"],["ひとり"],["で"],["、"],["それ"],["を"],["負う","おう"],["こと"],["の"],["ない"],["よう"],["に"],["するで"],["あろう"],["。"]]},{"verse":18,"text":"あなたはまた民,たみに言,いいなさい、『あなたがたは身,みを清,きよめて、あすを待,まちなさい。あなたがたは肉,にくを食,たべることができるであろう。あなたがたが泣,ないて主,しゅの耳,みみに、わたしたちは肉,にくが食,たべたい。エジプトにいた時,ときは良,よかったと言,いったからである。それゆえ、主,しゅはあなたがたに肉,にくを与,あたえて食,たべさせられるであろう。","tok":[["あなた"],["は"],["また"],["民","たみ"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["身","み"],["を"],["清めて","きよめて"],["、"],["あす"],["を"],["待ち","まち"],["なさい"],["。"],["あなた"],["がた"],["は"],["肉","にく"],["を"],["食べる","たべる"],["こと"],["が"],["できるで"],["あろう"],["。"],["あなた"],["がた"],["が"],["泣いて","ないて"],["主","しゅ"],["の"],["耳","みみ"],["に"],["、"],["わたしたち"],["は"],["肉","にく"],["が"],["食べたい","たべたい"],["。"],["エジプト"],["に"],["いた"],["時","とき"],["は"],["良かった","よかった"],["と"],["言った","いった"],["から"],["で"],["ある"],["。"],["それ"],["ゆえ"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["に"],["肉","にく"],["を"],["与","あたえ"],["て"],["食べさせられるで","たべさせられるで"],["あろう"],["。"]]},{"verse":19,"text":"あなたがたがそれを食,たべるのは、一日,にちや二日,ふつかや五日,かや十日,かや二十日,はつかではなく、","tok":[["あなた"],["がた"],["が"],["それ"],["を"],["食べる","たべる"],["の"],["は"],["、"],["一","いち"],["日","にち"],["ちや"],["二日","ふ"],["つ"],["か"],["や"],["五日","か"],["や"],["十日","か"],["や"],["二十日","はつか"],["で"],["は"],["なく"],["、"]]},{"verse":20,"text":"一か月,げつに及,および、ついにあなたがたの鼻,はなから出,でるようになり、あなたがたは、それに飽,あき果,はてるであろう。それはあなたがたのうちにおられる主,しゅを軽,かるんじて、その前,まえに泣,なき、なぜ、わたしたちはエジプトから出,でてきたのだろうと言,いったからである』」。","tok":[["一","いち"],["か月","かげつ"],["に"],["及","および"],["、"],["ついに"],["あなた"],["がた"],["の"],["鼻","はな"],["から"],["出る","でる"],["よう"],["に"],["なり"],["、"],["あなた"],["がた"],["は"],["、"],["それ"],["に"],["飽き","あき"],["果てるで","はてるで"],["あろう"],["。"],["それ"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["おられる"],["主","しゅ"],["を"],["軽","か"],["る"],["ん"],["じて"],["、"],["その"],["前","まえ"],["に"],["泣","なき"],["、"],["なぜ"],["、"],["わたしたち"],["は"],["エジプト"],["から"],["出て","でて"],["きた"],["の"],["だろう"],["と"],["言った","いった"],["から"],["で"],["ある"],["』"],["」"],["。"]]},{"verse":21,"text":"モーセは言,いった、「わたしと共,ともにおる民,たみは徒歩,とほの男子,だんしだけでも六十万です。ところがあなたは、『わたしは彼,かれらに肉,にくを与,あたえて一か月,げつのあいだ食,たべさせよう』と言,いわれます。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["「"],["わたし"],["と"],["共","とも"],["に"],["おる"],["民","たみ"],["は"],["徒歩","とほ"],["の"],["男子","だんし"],["だけ"],["で"],["も"],["六十万","ろくじゅうまん"],["です"],["。"],["ところ"],["が"],["あなた"],["は"],["、"],["『"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["肉","にく"],["を"],["与","あたえ"],["て"],["一","いち"],["か月","かげつ"],["の"],["あいだ"],["食べさせよう","たべさせよう"],["』"],["と"],["言われます","いわれます"],["。"]]},{"verse":22,"text":"羊,ひつじと牛,うしの群,むれを彼,かれらのためにほふって、彼,かれらを飽,あきさせるというのですか。海,うみのすべての魚,うおを彼,かれらのために集,あつめて、彼,かれらを飽,あきさせるというのですか」。","tok":[["羊","ひつじ"],["と"],["牛","うし"],["の"],["群れ","むれ"],["を"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["ほふって"],["、"],["彼","かれ"],["ら"],["を"],["飽きさせる","あきさせる"],["と"],["いう"],["の"],["です"],["か"],["。"],["海","うみ"],["の"],["すべて"],["の"],["魚","うお"],["を"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["集めて","あつめて"],["、"],["彼","かれ"],["ら"],["を"],["飽きさせる","あきさせる"],["と"],["いう"],["の"],["です"],["か"],["」"],["。"]]},{"verse":23,"text":"主,しゅはモーセに言,いわれた、「主,しゅの手,ては短,みじかかろうか。あなたは、いま、わたしの言葉,ことばの成,なるかどうかを見,みるであろう」。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["主","しゅ"],["の"],["手","て"],["は"],["短かかろう","みじかかろう"],["か"],["。"],["あなた"],["は"],["、"],["いま"],["、"],["わたし"],["の"],["言葉","ことば"],["の"],["成る","なる"],["か"],["どう"],["か"],["を"],["見るで","みるで"],["あろう"],["」"],["。"]]},{"verse":24,"text":"この時,ときモーセは出,でて、主,しゅの言葉,ことばを民,たみに告,つげ、民,たみの長老,ちょうろうたち七十人,にんを集,あつめて、幕屋,まくやの周囲,しゅういに立,たたせた。","tok":[["この"],["時","とき"],["モーセ"],["は"],["出て","でて"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["民","たみ"],["に"],["告","つげ"],["、"],["民","たみ"],["の"],["長老","ちょうろう"],["たち"],["七","なな"],["十人","じゅうにん"],["を"],["集めて","あつめて"],["、"],["幕屋","まくや"],["の"],["周囲","しゅうい"],["に"],["立たせた","たたせた"],["。"]]},{"verse":25,"text":"主,しゅは雲,くものうちにあって下,くだり、モーセと語,かたられ、モーセの上,うえにある霊,れいを、その七十人,にんの長老,ちょうろうたちにも分,わけ与,あたえられた。その霊,れいが彼,かれらの上,うえにとどまった時,とき、彼,かれらは預言,よげんした。ただし、その後,のちは重,かさねて預言,よげんしなかった。","tok":[["主","しゅ"],["は"],["雲","くも"],["の"],["うち"],["に"],["あって"],["下り","くだり"],["、"],["モーセ"],["と"],["語られ","かたられ"],["、"],["モーセ"],["の"],["上","うえ"],["に"],["ある"],["霊","れい"],["を"],["、"],["その"],["七","なな"],["十人","じゅうにん"],["の"],["長老","ちょうろう"],["たち"],["に"],["も"],["分け与えられた","わけあたえられた"],["。"],["その"],["霊","れい"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["とどまった"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["預言","よげん"],["した"],["。"],["ただし"],["、"],["その後","そののち"],["は"],["重ねて","かさねて"],["預言","よげん"],["しなかった"],["。"]]},{"verse":26,"text":"その時,ときふたりの者,ものが、宿営,しゅくえいにとどまっていたが、ひとりの名,なはエルダデと言,いい、ひとりの名,なはメダデといった。彼,かれらの上,うえにも霊,れいがとどまった。彼,かれらは名,なをしるされた者,ものであったが、幕屋,まくやに行,いかなかったので、宿営,しゅくえいのうちで預言,よげんした。","tok":[["その"],["時","とき"],["ふたり"],["の"],["者","もの"],["が"],["、"],["宿営","しゅくえい"],["に"],["とどまって"],["いた"],["が"],["、"],["ひとり"],["の"],["名","な"],["は"],["エルダデ"],["と"],["言い","いい"],["、"],["ひとり"],["の"],["名","な"],["は"],["メダデ"],["と"],["いった"],["。"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["も"],["霊","れい"],["が"],["とどまった"],["。"],["彼","かれ"],["ら"],["は"],["名","な"],["を"],["しるされた"],["者","もの"],["で"],["あった"],["が"],["、"],["幕屋","まくや"],["に"],["行かなかった","いかなかった"],["ので"],["、"],["宿営","しゅくえい"],["の"],["うち"],["で"],["預言","よげん"],["した"],["。"]]},{"verse":27,"text":"時,ときにひとりの若者,わかものが走,はしってきて、モーセに告,つげて言,いった、「エルダデとメダデとが宿営,しゅくえいのうちで預言,よげんしています」。","tok":[["時","とき"],["に"],["ひとり"],["の"],["若者","わかもの"],["が"],["走って","はしって"],["きて"],["、"],["モーセ"],["に"],["告","つげ"],["て"],["言った","いった"],["、"],["「"],["エルダデ"],["と"],["メダデ"],["と"],["が"],["宿営","しゅくえい"],["の"],["うち"],["で"],["預言","よげん"],["して"],["います"],["」"],["。"]]},{"verse":28,"text":"若,わかい時,ときからモーセの従者,じゅうしゃであったヌンの子,こヨシュアは答,こたえて言,いった、「わが主,しゅ、モーセよ、彼,かれらをさし止,とめてください」。","tok":[["若い","わかい"],["時","とき"],["から"],["モーセ"],["の"],["従者","じゅうしゃ"],["で"],["あった"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["は"],["答","こたえ"],["て"],["言った","いった"],["、"],["「"],["わが"],["主","しゅ"],["、"],["モーセ"],["よ"],["、"],["彼","かれ"],["ら"],["を"],["さし"],["止","とめ"],["て"],["ください"],["」"],["。"]]},{"verse":29,"text":"モーセは彼,かれに言,いった、「あなたは、わたしのためを思,おもって、ねたみを起,おこしているのか。主,しゅの民,たみがみな預言者,よげんしゃとなり、主,しゅがその霊,れいを彼,かれらに与,あたえられることは、願,ねがわしいことだ」。","tok":[["モーセ"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["、"],["わたし"],["の"],["ため"],["を"],["思って","おもって"],["、"],["ねたみ"],["を"],["起こして","おこして"],["いる"],["の"],["か"],["。"],["主","しゅ"],["の"],["民","たみ"],["が"],["みな"],["預言者","よげんしゃ"],["と"],["なり"],["、"],["主","しゅがそ"],["の"],["霊","れい"],["を"],["彼","かれ"],["ら"],["に"],["与えられる","あたえられる"],["こと"],["は"],["、"],["願しい","ねがわしい"],["こと"],["だ"],["」"],["。"]]},{"verse":30,"text":"こうしてモーセはイスラエルの長老,ちょうろうたちと共,ともに、宿営,しゅくえいに引,ひきあげた。","tok":[["こう"],["して"],["モーセ"],["は"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["と"],["共","とも"],["に"],["、"],["宿営","しゅくえい"],["に"],["引","ひき"],["あげた"],["。"]]},{"verse":31,"text":"さて、主,しゅのもとから風,かぜが起,おこり、海,うみの向,むこうから、うずらを運,はこんできて、これを宿営,しゅくえいの近,ちかくに落,おとした。その落,おちた範囲,はんいは、宿営,しゅくえいの周囲,しゅういで、こちら側,がわも、おおよそ一日,にちの行程,こうてい、あちら側,がわも、おおよそ一日,にちの行程,こうてい、地面,じめんから高,たかさおおよそ二キュビトであった。","tok":[["さて"],["、"],["主","しゅ"],["の"],["もと"],["から"],["風","かぜ"],["が"],["起こり","おこり"],["、"],["海","うみ"],["の"],["向こう","むこう"],["から"],["、"],["うずら"],["を"],["運こんで","はこんで"],["きて"],["、"],["これ"],["を"],["宿営","しゅくえい"],["の"],["近く","ちかく"],["に"],["落とした","おとした"],["。"],["その"],["落","おち"],["た"],["範囲","はんい"],["は"],["、"],["宿営","しゅくえい"],["の"],["周囲","しゅうい"],["で"],["、"],["こちら側","こちらがわ"],["も"],["、"],["おおよそ"],["一","いち"],["日","にち"],["の"],["行程","こうてい"],["、"],["あちら側","あちらがわ"],["も"],["、"],["おおよそ"],["一","いち"],["日","にち"],["の"],["行程","こうてい"],["、"],["地面","じめん"],["から"],["高か","たか"],["さ"],["おおよそ"],["二","に"],["キュビト"],["で"],["あった"],["。"]]},{"verse":32,"text":"そこで民,たみは立,たち上,あがってその日,ひは終日,しゅうじつ、その夜,よは終夜,しゅうや、またその次,つぎの日,ひも終日,しゅうじつ、うずらを集,あつめたが、集,あつめる事,ことの最,もっとも少,すくない者,ものも、十ホメルほど集,あつめた。彼,かれらはみな、それを宿営,しゅくえいの周囲,しゅういに広,ひろげておいた。","tok":[["そこ"],["で"],["民","たみ"],["は"],["立ち上がって","たちあがって"],["その"],["日","ひ"],["は"],["終日","しゅうじつ"],["、"],["その"],["夜","よ"],["は"],["終夜","しゅうや"],["、"],["また"],["その"],["次","つぎ"],["の"],["日","ひ"],["も"],["終日","しゅうじつ"],["、"],["うずら"],["を"],["集めた","あつめた"],["が"],["、"],["集める","あつめる"],["事","こと"],["の"],["最も","もっとも"],["少い","すくない"],["者","もの"],["も"],["、"],["十","じゅう"],["ホメル"],["ほど"],["集めた","あつめた"],["。"],["彼","かれ"],["ら"],["は"],["みな"],["、"],["それ"],["を"],["宿営","しゅくえい"],["の"],["周囲","しゅうい"],["に"],["広げて","ひろげて"],["おいた"],["。"]]},{"verse":33,"text":"その肉,にくがなお、彼,かれらの歯,はの間,あいだにあって食,たべつくさないうちに、主,しゅは民,たみにむかって怒,いかりを発,はっし、主,しゅは非常,ひじょうに激,はげしい疫病,えきびょうをもって民,たみを撃,うたれた。","tok":[["その"],["肉","にく"],["が"],["なお"],["、"],["彼","かれ"],["ら"],["の"],["歯","は"],["の"],["間","あいだ"],["に"],["あって"],["食べ","たべ"],["つくさない"],["うち"],["に"],["、"],["主","しゅ"],["は"],["民","たみ"],["に"],["むかって"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["主","しゅ"],["は"],["非常","ひじょう"],["に"],["激しい","はげしい"],["疫病","えきびょう"],["を"],["もって"],["民","たみ"],["を"],["撃たれた","うたれた"],["。"]]},{"verse":34,"text":"これによって、その所,ところの名,なはキブロテ・ハッタワと呼,よばれた。欲心,よくしんを起,おこした民,たみを、そこに埋,うめたからである。","tok":[["これ"],["によって"],["、"],["その"],["所","ところ"],["の"],["名","な"],["は"],["キブロテ"],["・"],["ハッタワ"],["と"],["呼ばれた","よばれた"],["。"],["欲心","よくしん"],["を"],["起こした","おこした"],["民","たみ"],["を"],["、"],["そこ"],["に"],["埋めた","うめた"],["から"],["で"],["ある"],["。"]]},{"verse":35,"text":"キブロテ・ハッタワから、民,たみはハゼロテに進,すすみ、ハゼロテにとどまった。","tok":[["キブロテ"],["・"],["ハッタワ"],["から"],["、"],["民","たみ"],["は"],["ハゼロテ"],["に"],["進み","すすみ"],["、"],["ハゼロテ"],["に"],["とどまった"],["。"]]}]
[{"verse":1,"text":"イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうは正月,しょうがつになってチンの荒野,あらのにはいった。そして民,たみはカデシにとどまったが、ミリアムがそこで死,しんだので、彼女,かのじょをそこに葬,ほうむった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["正月","しょうがつ"],["に"],["なって"],["チン"],["の"],["荒野","あらの"],["に"],["はいった"],["。"],["そして"],["民","たみ"],["は"],["カデシ"],["に"],["とどまった"],["が"],["、"],["ミリアム"],["が"],["そこ"],["で"],["死んだ","しんだ"],["ので"],["、"],["彼女","かのじょ"],["を"],["そこ"],["に"],["葬むった","ほうむった"],["。"]]},{"verse":2,"text":"そのころ会衆,かいしゅうは水,みずが得,えられなかったため、相,あい集,あつまってモーセとアロンに迫,せまった。","tok":[["その"],["ころ"],["会衆","かいしゅう"],["は"],["水","みず"],["が"],["得られなかった","えられなかった"],["ため"],["、"],["相","あ"],["い集","いあつ"],["まって"],["モーセ"],["と"],["アロン"],["に"],["迫まった","せまった"],["。"]]},{"verse":3,"text":"すなわち民,たみはモーセと争,あらそって言,いった、「さきにわれわれの兄弟,きょうだいたちが主,しゅの前,まえに死,しんだ時,とき、われわれも死,しんでいたらよかったものを。","tok":[["すなわち"],["民","たみ"],["は"],["モーセ"],["と"],["争って","あらそって"],["言った","いった"],["、"],["「"],["さき"],["に"],["われわれ"],["の"],["兄弟","きょうだい"],["たち"],["が"],["主","しゅ"],["の"],["前","まえ"],["に"],["死んだ","しんだ"],["時","とき"],["、"],["われわれ"],["も"],["死んで","しんで"],["いたら"],["よかった"],["もの"],["を"],["。"]]},{"verse":4,"text":"なぜ、あなたがたは主,しゅの会衆,かいしゅうをこの荒野,あらのに導,みちびいて、われわれと、われわれの家畜,かちくとを、ここで死,しなせようとするのですか。","tok":[["なぜ"],["、"],["あなた"],["がた"],["は"],["主","しゅ"],["の"],["会衆","かいしゅう"],["を"],["この"],["荒野","あら"],["のに"],["導いて","みちびいて"],["、"],["われわれ"],["と"],["、"],["われわれ"],["の"],["家畜","かちく"],["と"],["を"],["、"],["ここ"],["で"],["死なせよう","しなせよう"],["と"],["する"],["の"],["です"],["か"],["。"]]},{"verse":5,"text":"どうしてあなたがたはわれわれをエジプトから上,のぼらせて、この悪,わるい所,ところに導,みちびき入,いれたのですか。ここには種,たねをまく所,ところもなく、いちじくもなく、ぶどうもなく、ざくろもなく、また飲,のむ水,みずもありません」。","tok":[["どう"],["して"],["あなた"],["がた"],["は"],["われわれ"],["を"],["エジプト"],["から"],["上らせて","のぼらせて"],["、"],["この"],["悪い","わるい"],["所","ところ"],["に"],["導き入れた","みちびきいれた"],["の"],["です"],["か"],["。"],["ここ"],["に"],["は"],["種","たね"],["を"],["まく所","まくところ"],["も"],["なく"],["、"],["いちじく"],["も"],["なく"],["、"],["ぶどう"],["も"],["なく"],["、"],["ざくろ"],["も"],["なく"],["、"],["また"],["飲む","のむ"],["水","みず"],["も"],["ありません"],["」"],["。"]]},{"verse":6,"text":"そこでモーセとアロンは会衆,かいしゅうの前,まえを去,さり、会見,かいけんの幕屋,まくやの入口,いりぐちへ行,いってひれ伏,ふした。すると主,しゅの栄光,えいこうが彼,かれらに現,あらわれ、","tok":[["そこ"],["で"],["モーセ"],["と"],["アロン"],["は"],["会衆","かいしゅう"],["の"],["前","まえ"],["を"],["去り","さり"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["へ"],["行って","いって"],["ひれ伏した","ひれふした"],["。"],["する"],["と"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["彼","かれ"],["ら"],["に"],["現われ","あらわれ"],["、"]]},{"verse":7,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":8,"text":"「あなたは、つえをとり、あなたの兄弟,きょうだいアロンと共,ともに会衆,かいしゅうを集,あつめ、その目,めの前,まえで岩,いわに命,めいじて水,みずを出,ださせなさい。こうしてあなたは彼,かれらのために岩,いわから水,みずを出,だして、会衆,かいしゅうとその家畜,かちくに飲,のませなさい」。","tok":[["「"],["あなた"],["は"],["、"],["つえ"],["を"],["とり"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["アロン"],["と"],["共","とも"],["に"],["会衆","かいしゅう"],["を"],["集め","あつめ"],["、"],["その"],["目","め"],["の"],["前","まえ"],["で"],["岩","いわ"],["に"],["命じて","めいじて"],["水","みず"],["を"],["出させ","ださせ"],["なさい"],["。"],["こう"],["して"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["岩","いわ"],["から"],["水","みず"],["を"],["出して","だして"],["、"],["会衆","かいしゅう"],["と"],["その"],["家畜","かちく"],["に"],["飲ませ","のませ"],["なさい"],["」"],["。"]]},{"verse":9,"text":"モーセは命,めいじられたように主,しゅの前,まえにあるつえを取,とった。","tok":[["モーセ"],["は"],["命じられた","めいじられた"],["よう"],["に"],["主","しゅ"],["の"],["前","まえ"],["に"],["ある"],["つえ"],["を"],["取った","とった"],["。"]]},{"verse":10,"text":"モーセはアロンと共,ともに会衆,かいしゅうを岩,いわの前,まえに集,あつめて彼,かれらに言,いった、「そむく人,ひとたちよ、聞,ききなさい。われわれがあなたがたのためにこの岩,いわから水,みずを出,ださなければならないのであろうか」。","tok":[["モーセ"],["は"],["アロン"],["と"],["共","とも"],["に"],["会衆","かいしゅう"],["を"],["岩","いわ"],["の"],["前","まえ"],["に"],["集めて","あつめて"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["そむく"],["人","ひと"],["たち"],["よ"],["、"],["聞","きき"],["なさい"],["。"],["われわれ"],["が"],["あなた"],["がた"],["の"],["ため"],["に"],["この"],["岩","いわ"],["から"],["水","みず"],["を"],["出さなければ","ださなければ"],["ならない"],["ので"],["あろう"],["か"],["」"],["。"]]},{"verse":11,"text":"モーセは手,てをあげ、つえで岩,いわを二度,ど打,うつと、水,みずがたくさんわき出,でたので、会衆,かいしゅうとその家畜,かちくはともに飲,のんだ。","tok":[["モーセ"],["は"],["手","て"],["を"],["あげ"],["、"],["つえ"],["で"],["岩","いわ"],["を"],["二","に"],["度","ど"],["打つ","うつ"],["と"],["、"],["水","みず"],["が"],["たくさん"],["わき出た","わきでた"],["ので"],["、"],["会衆","かいしゅう"],["と"],["その"],["家畜","かちく"],["は"],["とも"],["に"],["飲んだ","のんだ"],["。"]]},{"verse":12,"text":"そのとき主,しゅはモーセとアロンに言,いわれた、「あなたがたはわたしを信,しんじないで、イスラエルの人々,ひとびとの前,まえにわたしの聖,せいなることを現,あらわさなかったから、この会衆,かいしゅうをわたしが彼,かれらに与,あたえた地,ちに導,みちびき入,いれることができないであろう」。","tok":[["その"],["とき"],["主","しゅ"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["がた"],["は"],["わたし"],["を"],["信じないで","しんじないで"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["前","まえ"],["に"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["現わさなかった","あらわさなかった"],["から"],["、"],["この"],["会衆","かいしゅう"],["を"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["た"],["地","ち"],["に"],["導き入れる","みちびきいれる"],["こと"],["が"],["できないで"],["あろう"],["」"],["。"]]},{"verse":13,"text":"これがメリバの水,みずであって、イスラエルの人々,ひとびとはここで主,しゅと争,あらそったが、主,しゅは自分,じぶんの聖,せいなることを彼,かれらのうちに現,あらわされた。","tok":[["これ"],["が"],["メリバ"],["の"],["水","みず"],["で"],["あって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["ここ"],["で"],["主","しゅ"],["と"],["争った","あらそった"],["が"],["、"],["主","しゅ"],["は"],["自分","じぶん"],["の"],["聖","せい"],["なる"],["こと"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["現わされた","あらわされた"],["。"]]},{"verse":14,"text":"さて、モーセはカデシからエドムの王,おうに使者,ししゃをつかわして言,いった、「あなたの兄弟,きょうだい、イスラエルはこう申,もうします、『あなたはわたしたちが遭遇,そうぐうしたすべての患難,かんなんをご存,ぞんじです。","tok":[["さて"],["、"],["モーセ"],["は"],["カデシ"],["から"],["エドム"],["の"],["王","おう"],["に"],["使者","ししゃ"],["を"],["つかわして"],["言った","いった"],["、"],["「"],["あなた"],["の"],["兄弟","きょうだい"],["、"],["イスラエル"],["は"],["こう"],["申します","もうします"],["、"],["『"],["あなた"],["は"],["わたしたち"],["が"],["遭遇","そうぐう"],["した"],["すべて"],["の"],["患難","かんなん"],["を"],["ご存じ","ごぞんじ"],["です"],["。"]]},{"verse":15,"text":"わたしたちの先祖,せんぞはエジプトに下,くだって行,いって、わたしたちは年,とし久,ひさしくエジプトに住,すんでいましたが、エジプトびとがわたしたちと、わたしたちの先祖,せんぞを悩,なやましたので、","tok":[["わたしたち"],["の"],["先祖","せんぞ"],["は"],["エジプト"],["に"],["下って","くだって"],["行って","いって"],["、"],["わたしたち"],["は"],["年","と"],["し"],["久く","ひさしく"],["エジプト"],["に"],["住んで","すんで"],["いました"],["が"],["、"],["エジプト"],["びと"],["が"],["わたしたち"],["と"],["、"],["わたしたち"],["の"],["先祖","せんぞ"],["を"],["悩した","なやました"],["ので"],["、"]]},{"verse":16,"text":"わたしたちが主,しゅに呼,よばわったとき、主,しゅはわたしたちの声,こえを聞,きき、ひとりの天,てんの使,つかいをつかわして、わたしたちをエジプトから導,みちびき出,だされました。わたしたちは今,いまあなたの領地,りょうちの端,はしにあるカデシの町,まちにおります。","tok":[["わたしたち"],["が"],["主に","しゅに"],["呼ばわった","よばわった"],["とき"],["、"],["主","しゅ"],["は"],["わたしたち"],["の"],["声","こえ"],["を"],["聞","きき"],["、"],["ひとり"],["の"],["天","てん"],["の"],["使","つかい"],["を"],["つかわして"],["、"],["わたしたち"],["を"],["エジプト"],["から"],["導き出されました","みちびきだされました"],["。"],["わたしたち"],["は"],["今","いま"],["あなた"],["の"],["領地","りょうち"],["の"],["端","はし"],["に"],["ある"],["カデシ"],["の"],["町","まち"],["に"],["おります"],["。"]]},{"verse":17,"text":"どうぞ、わたしたちにあなたの国,くにを通,とおらせてください。わたしたちは畑,はたけもぶどう畑,はたけも通,とおりません。また井戸,いどの水,みずも飲,のみません。ただ王,おうの大路,おおじを通,とおり、あなたの領地,りょうちを過,すぎるまでは右,みぎにも左,ひだりにも曲,まがりません』」。","tok":[["どうぞ"],["、"],["わたしたち"],["に"],["あなた"],["の"],["国","くに"],["を"],["通らせて","とおらせて"],["ください"],["。"],["わたしたち"],["は"],["畑","はたけ"],["も"],["ぶどう"],["畑","はたけ"],["も"],["通りません","とおりません"],["。"],["また"],["井戸","いど"],["の"],["水","みず"],["も"],["飲みません","のみません"],["。"],["ただ"],["王","おう"],["の"],["大路","おおじ"],["を"],["通り","とおり"],["、"],["あなた"],["の"],["領地","りょうち"],["を"],["過ぎる","すぎる"],["まで"],["は"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["曲がりません","まがりません"],["』"],["」"],["。"]]},{"verse":18,"text":"しかし、エドムはモーセに言,いった、「あなたはわたしの領地,りょうちをとおってはなりません。さもないと、わたしはつるぎをもって出,でて、あなたに立,たちむかうでしょう」。","tok":[["しかし"],["、"],["エドム"],["は"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["わたし"],["の"],["領地","りょうち"],["を"],["とおって"],["は"],["なりません"],["。"],["さも"],["ない"],["と"],["、"],["わたし"],["は"],["つるぎ"],["を"],["もって"],["出て","でて"],["、"],["あなた"],["に"],["立ちむかうでしょう","たちむかうでしょう"],["」"],["。"]]},{"verse":19,"text":"イスラエルの人々,ひとびとはエドムに言,いった、「わたしたちは大路,おおじを通,とおります。もしわたしたちとわたしたちの家畜,かちくとが、あなたの水,みずを飲,のむことがあれば、その価,あたいを払,はらいます。わたしは徒歩,とほで通,とおるだけですから何事,なにごともないでしょう」。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["エドム"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["大路","おおじ"],["を"],["通ります","とおります"],["。"],["もし"],["わたしたち"],["と"],["わたしたち"],["の"],["家畜","かちく"],["と"],["が"],["、"],["あなた"],["の"],["水","みず"],["を"],["飲む","のむ"],["こと"],["が"],["あれば"],["、"],["その"],["価","あたい"],["を"],["払います","はらいます"],["。"],["わたし"],["は"],["徒歩","とほ"],["で"],["通る","とおる"],["だけ"],["です"],["から"],["何事","なにごと"],["も"],["ないでしょう"],["」"],["。"]]},{"verse":20,"text":"しかし、エドムは「あなたは通,とおることはなりません」と言,いって、多,おおくの民,たみと強,つよい軍勢,ぐんぜいとを率,ひきい、出,でて、これに立,たちむかってきた。","tok":[["しかし"],["、"],["エドム"],["は"],["「"],["あなた"],["は"],["通る","とおる"],["こと"],["は"],["なりません"],["」"],["と"],["言って","いって"],["、"],["多く","おおく"],["の"],["民","たみ"],["と"],["強い","つよい"],["軍勢","ぐんぜい"],["と"],["を"],["率い","ひきい"],["、"],["出て","でて"],["、"],["これ"],["に"],["立ちむかって","たちむかって"],["きた"],["。"]]},{"verse":21,"text":"このようにエドムはイスラエルに、その領地,りょうちを通,とおることを拒,こばんだので、イスラエルはエドムからほかに向,むかった。","tok":[["この"],["よう"],["に"],["エドム"],["は"],["イスラエル"],["に"],["、"],["その"],["領地","りょうち"],["を"],["通る","とおる"],["こと"],["を"],["拒","こばんだ"],["ので"],["、"],["イスラエル"],["は"],["エドム"],["から"],["ほか"],["に"],["向かった","むかった"],["。"]]},{"verse":22,"text":"こうしてイスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうはカデシから進,すすんでホル山,やまに着,ついた。","tok":[["こう"],["して"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["カデシ"],["から"],["進んで","すすんで"],["ホル"],["山","やま"],["に"],["着いた","ついた"],["。"]]},{"verse":23,"text":"主,しゅはエドムの国境,こっきょうに近,ちかいホル山,やまで、モーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["エドム"],["の"],["国境","こっきょう"],["に"],["近い","ちかい"],["ホル"],["山","やま"],["で"],["、"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":24,"text":"「アロンはその民,たみに連,つらならなければならない。彼,かれはわたしがイスラエルの人々,ひとびとに与,あたえた地,ちに、はいることができない。これはメリバの水,みずで、あなたがたがわたしの言葉,ことばにそむいたからである。","tok":[["「"],["アロン"],["は"],["その"],["民","たみ"],["に"],["連ならなければ","つらならなければ"],["ならない"],["。"],["彼","かれ"],["は"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与","あたえ"],["た"],["地","ち"],["に"],["、"],["はいる"],["こと"],["が"],["できない"],["。"],["これ"],["は"],["メリバ"],["の"],["水","みず"],["で"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["言葉","ことば"],["に"],["そむいた"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"あなたはアロンとその子,こエレアザルを連,つれてホル山,やまに登,のぼり、","tok":[["あなた"],["は"],["アロン"],["と"],["その"],["子","こ"],["エレアザル"],["を"],["連れて","つれて"],["ホル"],["山","やま"],["に"],["登り","のぼり"],["、"]]},{"verse":26,"text":"アロンに衣服,いふくを脱,ぬがせて、それをその子,こエレアザルに着,きせなさい。アロンはそのところで死,しんで、その民,たみに連,つらなるであろう」。","tok":[["アロン"],["に"],["衣服","いふく"],["を"],["脱がせて","ぬがせて"],["、"],["それ"],["を"],["その"],["子","こ"],["エレアザル"],["に"],["着せ","きせ"],["なさい"],["。"],["アロン"],["は"],["その"],["ところ"],["で"],["死んで","しんで"],["、"],["その"],["民","たみ"],["に"],["連なるで","つらなるで"],["あろう"],["」"],["。"]]},{"verse":27,"text":"モーセは主,しゅが命,めいじられたとおりにし、連,つれだって全,ぜん会衆,かいしゅうの目,めの前,まえでホル山,やまに登,のぼった。","tok":[["モーセ"],["は"],["主","しゅ"],["が"],["命じられた","めいじられた"],["とおり"],["に"],["し"],["、"],["連れだって","つれだって"],["全","ぜん"],["会衆","かいしゅう"],["の"],["目","め"],["の"],["前","まえ"],["で"],["ホル"],["山","やま"],["に"],["登った","のぼった"],["。"]]},{"verse":28,"text":"そしてモーセはアロンに衣服,いふくを脱,ぬがせ、それをその子,こエレアザルに着,きせた。アロンはその山,やまの頂,いただきで死,しんだ。そしてモーセとエレアザルは山,やまから下,くだったが、","tok":[["そして"],["モーセ"],["は"],["アロン"],["に"],["衣服","いふく"],["を"],["脱がせ","ぬがせ"],["、"],["それ"],["を"],["その"],["子","こ"],["エレアザル"],["に"],["着せた","きせた"],["。"],["アロン"],["は"],["その"],["山","やま"],["の"],["頂","いただき"],["で"],["死んだ","しんだ"],["。"],["そして"],["モーセ"],["と"],["エレアザル"],["は"],["山","やま"],["から"],["下った","くだった"],["が"],["、"]]},{"verse":29,"text":"全,ぜん会衆,かいしゅうがアロンの死,しんだのを見,みたとき、イスラエルの全家,ぜんかは三十日,にちの間,あいだアロンのために泣,ないた。","tok":[["全","ぜん"],["会衆","かいしゅう"],["が"],["アロン"],["の"],["死んだ","しんだ"],["の"],["を"],["見た","みた"],["とき"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["は"],["三十日","にち"],["の"],["間","あいだ"],["アロン"],["の"],["ため"],["に"],["泣いた","ないた"],["。"]]}]
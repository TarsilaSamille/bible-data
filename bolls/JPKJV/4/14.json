[{"verse":1,"text":"そこで、会衆,かいしゅうはみな声,こえをあげて叫,さけび、民,たみはその夜,よ、泣,なき明,あかした。","tok":[["そこ"],["で"],["、"],["会衆","かいしゅう"],["は"],["みな"],["声","こえ"],["を"],["あげて"],["叫","さけび"],["、"],["民","たみ"],["は"],["その"],["夜","よ"],["、"],["泣明かした","なきあかした"],["。"]]},{"verse":2,"text":"またイスラエルの人々,ひとびとはみなモーセとアロンにむかってつぶやき、全,ぜん会衆,かいしゅうは彼,かれらに言,いった、「ああ、わたしたちはエジプトの国,くにで死,しんでいたらよかったのに。この荒野,あらので死,しんでいたらよかったのに。","tok":[["また"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["みな"],["モーセ"],["と"],["アロン"],["に"],["むかって"],["つぶやき"],["、"],["全","ぜん"],["会衆","かいしゅう"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["ああ"],["、"],["わたしたち"],["は"],["エジプト"],["の"],["国","くに"],["で"],["死んで","しんで"],["いたら"],["よかった"],["のに"],["。"],["この"],["荒野","あらの"],["で"],["死んで","しんで"],["いたら"],["よかった"],["のに"],["。"]]},{"verse":3,"text":"なにゆえ、主,しゅはわたしたちをこの地,ちに連,つれてきて、つるぎに倒,たおれさせ、またわたしたちの妻子,さいしをえじきとされるのであろうか。エジプトに帰,かえる方,ほうが、むしろ良,よいではないか」。","tok":[["なにゆえ"],["、"],["主","しゅ"],["は"],["わたしたち"],["を"],["この"],["地","ち"],["に"],["連れて","つれて"],["きて"],["、"],["つるぎ"],["に"],["倒れさせ","たおれさせ"],["、"],["また"],["わたしたち"],["の"],["妻子","さいし"],["を"],["えじき"],["と"],["される"],["ので"],["あろう"],["か"],["。"],["エジプト"],["に"],["帰える","かえる"],["方","ほう"],["が"],["、"],["むしろ"],["良いで","よいで"],["は"],["ない"],["か"],["」"],["。"]]},{"verse":4,"text":"彼,かれらは互,たがいに言,いった、「わたしたちはひとりのかしらを立,たてて、エジプトに帰,かえろう」。","tok":[["彼","かれ"],["ら"],["は"],["互","たがい"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["ひとり"],["の"],["かしら"],["を"],["立てて","たてて"],["、"],["エジプト"],["に"],["帰えろう","かえろう"],["」"],["。"]]},{"verse":5,"text":"そこで、モーセとアロンはイスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうの前,まえでひれふした。","tok":[["そこ"],["で"],["、"],["モーセ"],["と"],["アロン"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["で"],["ひれふした"],["。"]]},{"verse":6,"text":"このとき、その地,ちを探,さぐった者,もののうちのヌンの子,こヨシュアとエフンネの子,こカレブは、その衣服,いふくを裂,さき、","tok":[["この"],["とき"],["、"],["その"],["地","ち"],["を"],["探った","さぐった"],["者","もの"],["の"],["うち"],["の"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["エフンネ"],["の"],["子","こ"],["カレブ"],["は"],["、"],["その"],["衣服","いふく"],["を"],["裂き","さき"],["、"]]},{"verse":7,"text":"イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうに言,いった、「わたしたちが行,いき巡,めぐって探,さぐった地,ちは非常,ひじょうに良,よい地,ちです。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["が"],["行き","いき"],["巡って","めぐって"],["探った","さぐった"],["地","ち"],["は"],["非常","ひじょう"],["に"],["良い","よい"],["地","ち"],["です"],["。"]]},{"verse":8,"text":"もし、主,しゅが良,よしとされるならば、わたしたちをその地,ちに導,みちびいて行,いって、それをわたしたちにくださるでしょう。それは乳,ちちと蜜,みつの流,ながれている地,ちです。","tok":[["もし"],["、"],["主","しゅ"],["が"],["良し","よし"],["と"],["されるならば"],["、"],["わたしたち"],["を"],["その"],["地","ち"],["に"],["導いて","みちびいて"],["行って","いって"],["、"],["それ"],["を"],["わたしたち"],["に"],["くださるでしょう"],["。"],["それ"],["は"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れて","ながれて"],["いる"],["地","ち"],["です"],["。"]]},{"verse":9,"text":"ただ、主,しゅにそむいてはなりません。またその地,ちの民,たみを恐,おそれてはなりません。彼,かれらはわたしたちの食,くい物,ものにすぎません。彼,かれらを守,まもる者,ものは取,すり除,のぞかれます。主,しゅがわたしたちと共,ともにおられますから、彼,かれらを恐,おそれてはなりません」。","tok":[["ただ"],["、"],["主に","しゅに"],["そむいて"],["は"],["なりません"],["。"],["また"],["その"],["地","ち"],["の"],["民","たみ"],["を"],["恐れて","おそれて"],["は"],["なりません"],["。"],["彼","かれ"],["ら"],["は"],["わたしたち"],["の"],["食い物","くいもの"],["に"],["すぎません"],["。"],["彼","かれ"],["ら"],["を"],["守者","まもるもの"],["は"],["取り除かれます","すりのぞかれます"],["。"],["主","しゅ"],["が"],["わたしたち"],["と"],["共","とも"],["に"],["おられます"],["から"],["、"],["彼","かれ"],["ら"],["を"],["恐れて","おそれて"],["は"],["なりません"],["」"],["。"]]},{"verse":10,"text":"ところが会衆,かいしゅうはみな石,いしで彼,かれらを撃,うち殺,ころそうとした。そのとき、主,しゅの栄光,えいこうが、会見,かいけんの幕屋,まくやからイスラエルのすべての人,ひとに現,あらわれた。","tok":[["ところ"],["が"],["会衆","かいしゅう"],["は"],["みな"],["石","いし"],["で"],["彼","かれ"],["ら"],["を"],["撃ち殺そう","うちころそう"],["と"],["した"],["。"],["その"],["とき"],["、"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["から"],["イスラエル"],["の"],["すべて"],["の"],["人","ひと"],["に"],["現われた","あらわれた"],["。"]]},{"verse":11,"text":"主,しゅはモーセに言,いわれた、「この民,たみはいつまでわたしを侮,あなどるのか。わたしがもろもろのしるしを彼,かれらのうちに行,いったのに、彼,かれらはいつまでわたしを信,しんじないのか。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["この"],["民","たみ"],["は"],["いつ"],["まで"],["わたし"],["を"],["侮る","あなどる"],["の"],["か"],["。"],["わたし"],["が"],["もろもろ"],["の"],["しるし"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["行った","いった"],["のに"],["、"],["彼","かれ"],["ら"],["は"],["いつ"],["まで"],["わたし"],["を"],["信じない","しんじない"],["の"],["か"],["。"]]},{"verse":12,"text":"わたしは疫病,えきびょうをもって彼,かれらを撃,うち滅,ほろぼし、あなたを彼,かれらよりも大,おおいなる強,つよい国民,こくみんとしよう」。","tok":[["わたし"],["は"],["疫病","えきびょう"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["撃ち","うち"],["滅ぼし","ほろぼし"],["、"],["あなた"],["を"],["彼","かれ"],["ら"],["より"],["も"],["大いなる","おおいなる"],["強い","つよい"],["国民","こくみん"],["と"],["しよう"],["」"],["。"]]},{"verse":13,"text":"モーセは主,しゅに言,いった、「エジプトびとは、あなたが力,ちからをもって、この民,たみを彼,かれらのうちから導,みちびき出,だされたことを聞,きいて、","tok":[["モーセ"],["は"],["主に","しゅに"],["言った","いった"],["、"],["「"],["エジプト"],["び"],["と"],["は"],["、"],["あなた"],["が"],["力","ちから"],["を"],["もって"],["、"],["この"],["民","たみ"],["を"],["彼","かれ"],["ら"],["の"],["うち"],["から"],["導き出された","みちびきだされた"],["こと"],["を"],["聞いて","きいて"],["、"]]},{"verse":14,"text":"この地,ちの住民,じゅうみんに告,つげるでしょう。彼,かれらは、主,しゅなるあなたが、この民,たみのうちにおられ、主,しゅなるあなたが、まのあたり現,あらわれ、あなたの雲,くもが、彼,かれらの上,うえにとどまり、昼,ひるは雲,くもの柱,はしらのうちに、夜,よるは火,ひの柱,はしらのうちにあって、彼,かれらの前,まえに行,いかれるのを聞,きいたのです。","tok":[["この"],["地","ち"],["の"],["住民","じゅうみん"],["に"],["告げるでしょう","つげるでしょう"],["。"],["彼","かれ"],["ら"],["は"],["、"],["主","しゅ"],["なる"],["あなた"],["が"],["、"],["この"],["民","たみ"],["の"],["うち"],["に"],["おられ"],["、"],["主","しゅ"],["なる"],["あなた"],["が"],["、"],["まのあたり"],["現われ","あらわれ"],["、"],["あなた"],["の"],["雲","くも"],["が"],["、"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["とどまり"],["、"],["昼","ひる"],["は"],["雲","くも"],["の"],["柱","はしら"],["の"],["うち"],["に"],["、"],["夜","よる"],["は"],["火","ひ"],["の"],["柱","はしら"],["の"],["うち"],["に"],["あって"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["行かれる","いかれる"],["の"],["を"],["聞いた","きいた"],["の"],["です"],["。"]]},{"verse":15,"text":"いま、もし、あなたがこの民,たみをひとり残,のこらず殺,ころされるならば、あなたのことを聞,きいた国民,こくみんは語,かたって、","tok":[["いま"],["、"],["もし"],["、"],["あなた"],["が"],["この"],["民","たみ"],["を"],["ひとり"],["残らず","のこらず"],["殺ろされるならば","ころされるならば"],["、"],["あなた"],["の"],["こと"],["を"],["聞いた","きいた"],["国民","こくみん"],["は"],["語って","かたって"],["、"]]},{"verse":16,"text":"『主,しゅは与,あたえると誓,ちかった地,ちに、この民,たみを導,みちびき入,いれることができなかったため、彼,かれらを荒野,あらので殺,ころしたのだ』と言,いうでしょう。","tok":[["『"],["主","しゅ"],["は"],["与える","あたえる"],["と"],["誓った","ちかった"],["地","ち"],["に"],["、"],["この"],["民","たみ"],["を"],["導き入れる","みちびきいれる"],["こと"],["が"],["できなかった"],["ため"],["、"],["彼","かれ"],["ら"],["を"],["荒野","あらの"],["で"],["殺ろした","ころした"],["の"],["だ"],["』"],["と"],["言うでしょう","いうでしょう"],["。"]]},{"verse":17,"text":"どうぞ、あなたが約束,やくそくされたように、いま主,しゅの大,おおいなる力,ちからを現,あらわしてください。","tok":[["どうぞ"],["、"],["あなた"],["が"],["約束","やくそく"],["された"],["よう"],["に"],["、"],["いま"],["主","しゅ"],["の"],["大いなる","おおいなる"],["力","ちから"],["を"],["現わして","あらわして"],["ください"],["。"]]},{"verse":18,"text":"あなたはかつて、『主,しゅは怒,いかることおそく、いつくしみに富,とみ、罪,つみととがをゆるす者,もの、しかし、罰,ばつすべき者,ものは、決,けっしてゆるさず、父,ちちの罪,つみを子,こに報,むくいて、三、四代,だいに及,およぼす者,ものである』と言,いわれました。","tok":[["あなた"],["は"],["かつて"],["、"],["『"],["主","しゅ"],["は"],["怒","いかるこ"],["と"],["おそく"],["、"],["いつくしみ"],["に"],["富","とみ"],["、"],["罪","つみ"],["と"],["とが"],["を"],["ゆるす"],["者","もの"],["、"],["しかし"],["、"],["罰すべき","ばつすべき"],["者","もの"],["は"],["、"],["決っして","けっして"],["ゆるさず"],["、"],["父","ちち"],["の"],["罪","つみ"],["を"],["子","こ"],["に"],["報いて","むくいて"],["、"],["三","さん"],["、"],["四","よん"],["代","だい"],["に"],["及ぼす","およぼす"],["者","もの"],["で"],["ある"],["』"],["と"],["言われました","いわれました"],["。"]]},{"verse":19,"text":"どうぞ、あなたの大,おおいなるいつくしみによって、エジプトからこのかた、今,いまにいたるまで、この民,たみをゆるされたように、この民,たみの罪,つみをおゆるしください」。","tok":[["どうぞ"],["、"],["あなた"],["の"],["大いなる","おおいなる"],["いつくしみ"],["によって"],["、"],["エジプト"],["から"],["このかた"],["、"],["今","いま"],["に"],["いたる"],["まで"],["、"],["この"],["民","たみ"],["を"],["ゆるされた"],["よう"],["に"],["、"],["この"],["民","たみ"],["の"],["罪","つみ"],["を"],["おゆるし"],["ください"],["」"],["。"]]},{"verse":20,"text":"主,しゅは言,いわれた、「わたしはあなたの言葉,ことばのとおりにゆるそう。","tok":[["主","しゅ"],["は"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["あなた"],["の"],["言葉","ことば"],["の"],["とおり"],["に"],["ゆるそう"],["。"]]},{"verse":21,"text":"しかし、わたしは生,いきている。また主,しゅの栄光,えいこうが、全,ぜん世界,せかいに満,みちている。","tok":[["しかし"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["また"],["主","しゅ"],["の"],["栄光","えいこう"],["が"],["、"],["全","ぜん"],["世界","せかい"],["に"],["満ちて","みちて"],["いる"],["。"]]},{"verse":22,"text":"わたしの栄光,えいこうと、わたしがエジプトと荒野,あらので行,いったしるしを見,みながら、このように十度,どもわたしを試,こころみて、わたしの声,こえに聞,ききしたがわなかった人々,ひとびとはひとりも、","tok":[["わたし"],["の"],["栄光","えいこう"],["と"],["、"],["わたし"],["が"],["エジプト"],["と"],["荒野","あらの"],["で"],["行った","いった"],["しるし"],["を"],["見","み"],["ながら"],["、"],["この"],["よう"],["に"],["十","じゅう"],["度","ど"],["も"],["わたし"],["を"],["試みて","こころみて"],["、"],["わたし"],["の"],["声","こえ"],["に"],["聞した","ききした"],["がわ"],["なかった"],["人々","ひとびと"],["は"],["ひとり"],["も"],["、"]]},{"verse":23,"text":"わたしがかつて彼,かれらの先祖,せんぞたちに与,あたえると誓,ちかった地,ちを見,みないであろう。またわたしを侮,あなどった人々,ひとびとも、それを見,みないであろう。","tok":[["わたし"],["が"],["かつて"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["に"],["与える","あたえる"],["と"],["誓った","ちかった"],["地","ち"],["を"],["見ないで","みないで"],["あろう"],["。"],["また"],["わたし"],["を"],["侮った","あなどった"],["人々","ひとびと"],["も"],["、"],["それ"],["を"],["見ないで","みないで"],["あろう"],["。"]]},{"verse":24,"text":"ただし、わたしのしもべカレブは違,ちがった心,こころをもっていて、わたしに完全,かんぜんに従,したがったので、わたしは彼,かれが行,いってきた地,ちに彼,かれを導,みちびき入,いれるであろう。彼,かれの子孫,しそんはそれを所有,しょゆうするにいたるであろう。","tok":[["ただし"],["、"],["わたし"],["の"],["しもべ"],["カレブ"],["は"],["違った","ちがった"],["心","こころ"],["を"],["もって"],["いて"],["、"],["わたし"],["に"],["完全","かんぜん"],["に"],["従った","したがった"],["ので"],["、"],["わたし"],["は"],["彼","かれ"],["が"],["行って","いって"],["きた"],["地","ち"],["に"],["彼","かれ"],["を"],["導き入れるで","みちびきいれるで"],["あろう"],["。"],["彼","かれ"],["の"],["子孫","しそん"],["は"],["それ"],["を"],["所有","しょゆう"],["する"],["に"],["いたるで"],["あろう"],["。"]]},{"verse":25,"text":"谷,たににはアマレクびととカナンびとが住,すんでいるから、あなたがたは、あす、身,みをめぐらして紅海,こうかいの道,みちを荒野,あらのへ進,すすみなさい」。","tok":[["谷","たに"],["に"],["は"],["アマレク"],["びと"],["と"],["カナン"],["びと"],["が"],["住んで","すんで"],["いる"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["あす"],["、"],["身","み"],["を"],["めぐらして"],["紅海","こうかい"],["の"],["道","みち"],["を"],["荒野","あらの"],["へ"],["進み","すすみ"],["なさい"],["」"],["。"]]},{"verse":26,"text":"主,しゅはモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":27,"text":"「わたしにむかってつぶやくこの悪,わるい会衆,かいしゅうをいつまで忍,しのぶことができようか。わたしはイスラエルの人々,ひとびとが、わたしにむかってつぶやくのを聞,きいた。","tok":[["「"],["わたし"],["に"],["むかって"],["つぶやく"],["この"],["悪い","わるい"],["会衆","かいしゅう"],["を"],["いつ"],["まで"],["忍ぶ","しのぶ"],["こと"],["が"],["できよう"],["か"],["。"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["わたし"],["に"],["むかって"],["つぶやく"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":28,"text":"あなたは彼,かれらに言,いいなさい、『主,しゅは言,いわれる、「わたしは生,いきている。あなたがたが、わたしの耳,みみに語,かたったように、わたしはあなたがたにするであろう。","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["主","しゅ"],["は"],["言われる","いわれる"],["、"],["「"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["あなた"],["が"],["た"],["が"],["、"],["わたし"],["の"],["耳","みみ"],["に"],["語った","かたった"],["よう"],["に"],["、"],["わたし"],["は"],["あなた"],["がた"],["に"],["するで"],["あろう"],["。"]]},{"verse":29,"text":"あなたがたは死体,したいとなって、この荒野,あらのに倒,たおれるであろう。あなたがたのうち、わたしにむかってつぶやいた者,もの、すなわち、すべて数,かぞえられた二十歳,さい以上,いじょうの者,ものはみな倒,たおれるであろう。","tok":[["あなた"],["がた"],["は"],["死体","したい"],["と"],["なって"],["、"],["この"],["荒野","あら"],["のに"],["倒れるで","たおれるで"],["あろう"],["。"],["あなた"],["がた"],["の"],["うち"],["、"],["わたし"],["に"],["むかって"],["つぶやいた"],["者","もの"],["、"],["すなわち"],["、"],["すべて"],["数えられた","かぞえられた"],["二十歳","さ"],["い"],["以上","いじょう"],["の"],["者","もの"],["は"],["みな"],["倒れるで","たおれるで"],["あろう"],["。"]]},{"verse":30,"text":"エフンネの子,こカレブと、ヌンの子,こヨシュアのほかは、わたしがかつて、あなたがたを住,すまわせようと、手,てをあげて誓,ちかった地,ちに、はいることができないであろう。","tok":[["エフンネ"],["の"],["子","こ"],["カレブ"],["と"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["の"],["ほか"],["は"],["、"],["わたし"],["が"],["かつて"],["、"],["あなた"],["がた"],["を"],["住まわせよう","すまわせよう"],["と"],["、"],["手","て"],["を"],["あげて"],["誓った","ちかった"],["地","ち"],["に"],["、"],["はいる"],["こと"],["が"],["できないで"],["あろう"],["。"]]},{"verse":31,"text":"しかし、あなたがたが、えじきになるであろうと言,いったあなたがたの子供,こどもは、わたしが導,みちびいて、はいるであろう。彼,かれらはあなたがたが、いやしめた地,ちを知,しるようになるであろう。","tok":[["しかし"],["、"],["あなた"],["が"],["た"],["が"],["、"],["えじき"],["に"],["なるで"],["あろう"],["と"],["言った","いった"],["あなた"],["がた"],["の"],["子供","こども"],["は"],["、"],["わたし"],["が"],["導いて","みちびいて"],["、"],["はいるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["が"],["た"],["が"],["、"],["いやしめた"],["地","ち"],["を"],["知る","しる"],["よう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":32,"text":"しかしあなたがたは死体,したいとなってこの荒野,あらのに倒,たおれるであろう。","tok":[["しかし"],["あなた"],["がた"],["は"],["死体","したい"],["と"],["なって"],["この"],["荒野","あら"],["のに"],["倒れるで","たおれるで"],["あろう"],["。"]]},{"verse":33,"text":"あなたがたの子,こたちは、あなたがたの死体,したいが荒野,あらのに朽,くち果,はてるまで四十年,ねんのあいだ、荒野,あらので羊飼,ひつじかいとなり、あなたがたの不信,ふしんの罪,つみを負,おうであろう。","tok":[["あなた"],["がた"],["の"],["子","こ"],["たち"],["は"],["、"],["あなた"],["がた"],["の"],["死体","したい"],["が"],["荒野","あらの"],["に"],["朽ち","くち"],["果てる","はてる"],["まで"],["四十","よんじゅう"],["年","ねん"],["の"],["あいだ"],["、"],["荒野","あらの"],["で"],["羊飼","ひつじかい"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["負うで","おうで"],["あろう"],["。"]]},{"verse":34,"text":"あなたがたは、かの地,ちを探,さぐった四十日,にちの日,ひ数,かずにしたがい、その一日,にちを一年,ねんとして、四十年,ねんのあいだ、自分,じぶんの罪,つみを負,おい、わたしがあなたがたを遠,とおざかったことを知,しるであろう」。","tok":[["あなた"],["がた"],["は"],["、"],["かの"],["地","ち"],["を"],["探った","さぐった"],["四十日","にち"],["の"],["日数","ひかず"],["に"],["したがい"],["、"],["その"],["一","いち"],["日","にち"],["を"],["一","いち"],["年","ねん"],["として"],["、"],["四十","よんじゅう"],["年","ねん"],["の"],["あいだ"],["、"],["自分","じぶん"],["の"],["罪","つみ"],["を"],["負い","おい"],["、"],["わたし"],["が"],["あなた"],["がた"],["を"],["遠ざかった","とおざかった"],["こと"],["を"],["知るで","しるで"],["あろう"],["」"],["。"]]},{"verse":35,"text":"主,しゅなるわたしがこれを言,いう。わたしは必,かならずわたしに逆,さからって集,あつまったこの悪,わるい会衆,かいしゅうに、これをことごとく行,おこなうであろう。彼,かれらはこの荒野,あらのに朽,くち、ここで死,しぬであろう』」。","tok":[["主","しゅ"],["なる"],["わたし"],["が"],["これ"],["を"],["言う","いう"],["。"],["わたし"],["は"],["必","かならず"],["わたし"],["に"],["逆らって","さからって"],["集まった","あつまった"],["この"],["悪い","わるい"],["会衆","かいしゅう"],["に"],["、"],["これ"],["を"],["ことごとく"],["行なうで","おこなうで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["この"],["荒野","あら"],["のに"],["朽ち","くち"],["、"],["ここ"],["で"],["死ぬで","しぬで"],["あろう"],["』"],["」"],["。"]]},{"verse":36,"text":"こうして、モーセにつかわされ、かの地,ちを探,さぐりに行,いき、帰,かえってきて、その地,ちを悪,わるく言,いい、全,ぜん会衆,かいしゅうを、モーセにむかって、つぶやかせた人々,ひとびと、","tok":[["こう"],["して"],["、"],["モーセ"],["に"],["つかわされ"],["、"],["かの"],["地","ち"],["を"],["探ぐり","さぐり"],["に"],["行き","いき"],["、"],["帰えって","かえって"],["きて"],["、"],["その"],["地","ち"],["を"],["悪く","わるく"],["言い","いい"],["、"],["全","ぜん"],["会衆","かいしゅう"],["を"],["、"],["モーセ"],["に"],["むかって"],["、"],["つぶやかせた"],["人々","ひとびと"],["、"]]},{"verse":37,"text":"すなわち、その地,ちを悪,わるく言,いいふらした人々,ひとびとは、疫病,えきびょうにかかって主,しゅの前,まえに死,しんだが、","tok":[["すなわち"],["、"],["その"],["地","ち"],["を"],["悪く","わるく"],["言いふらした","いいふらした"],["人々","ひとびと"],["は"],["、"],["疫病","えきびょう"],["に"],["かかって"],["主","しゅ"],["の"],["前","まえ"],["に"],["死んだ","しんだ"],["が"],["、"]]},{"verse":38,"text":"その地,ちを探,さぐりに行,いった人々,ひとびとのうち、ヌンの子,こヨシュアと、エフンネの子,こカレブとは生,いき残,のこった。","tok":[["その"],["地","ち"],["を"],["探ぐり","さぐり"],["に"],["行った","いった"],["人々","ひとびと"],["の"],["うち"],["、"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["と"],["、"],["エフンネ"],["の"],["子","こ"],["カレブ"],["と"],["は"],["生き残った","いきのこった"],["。"]]},{"verse":39,"text":"モーセが、これらのことを、イスラエルのすべての人々,ひとびとに告,つげたとき、民,たみは非常,ひじょうに悲,かなしみ、","tok":[["モーセ"],["が"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["、"],["イスラエル"],["の"],["すべて"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["た"],["とき"],["、"],["民","たみ"],["は"],["非常","ひじょう"],["に"],["悲しみ","かなしみ"],["、"]]},{"verse":40,"text":"朝,あさ早,はやく起,おきて山,やまの頂,いただきに登,のぼって言,いった、「わたしたちはここにいる。さあ、主,しゅが約束,やくそくされた所,ところへ上,のぼって行,いこう。わたしたちは罪,つみを犯,おかしたのだから」。","tok":[["朝","あさ"],["早く","はやく"],["起きて","おきて"],["山","やま"],["の"],["頂","いただき"],["に"],["登って","のぼって"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["ここ"],["に"],["いる"],["。"],["さあ"],["、"],["主","しゅ"],["が"],["約束","やくそく"],["された"],["所","ところ"],["へ"],["上って","のぼって"],["行こう","いこう"],["。"],["わたしたち"],["は"],["罪","つみ"],["を"],["犯した","おかした"],["の"],["だ"],["から"],["」"],["。"]]},{"verse":41,"text":"モーセは言,いった、「あなたがたは、それをなし遂,とげることもできないのに、どうして、そのように主,しゅの命,めいにそむくのか。","tok":[["モーセ"],["は"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["、"],["それ"],["を"],["なし遂げる","なしとげる"],["こと"],["も"],["できない"],["のに"],["、"],["どう"],["して"],["、"],["その"],["よう"],["に"],["主","しゅ"],["の"],["命","めい"],["に"],["そむく"],["の"],["か"],["。"]]},{"verse":42,"text":"あなたがたは上,のぼって行,いってはならない。主,しゅがあなたがたのうちにおられないから、あなたがたは敵,てきの前,まえに、撃,うち破,やぶられるであろう。","tok":[["あなた"],["がた"],["は"],["上って","のぼって"],["行って","いって"],["は"],["ならない"],["。"],["主","しゅ"],["が"],["あなた"],["がた"],["の"],["うち"],["に"],["おられない"],["から"],["、"],["あなた"],["がた"],["は"],["敵","てき"],["の"],["前","まえ"],["に"],["、"],["撃ち破られるで","うちやぶられるで"],["あろう"],["。"]]},{"verse":43,"text":"そこには、アマレクびとと、カナンびとがあなたがたの前,まえにいるから、あなたがたは、つるぎに倒,たおれるであろう。あなたがたがそむいて、主,しゅに従,したがわなかったゆえ、主,しゅはあなたがたと共,ともにおられないからである」。","tok":[["そこ"],["に"],["は"],["、"],["アマレク"],["びと"],["と"],["、"],["カナン"],["びと"],["が"],["あなた"],["がた"],["の"],["前","まえ"],["に"],["いる"],["から"],["、"],["あなた"],["がた"],["は"],["、"],["つるぎ"],["に"],["倒れるで","たおれるで"],["あろう"],["。"],["あなた"],["がた"],["が"],["そむいて"],["、"],["主に","しゅに"],["従わなかった","したがわなかった"],["ゆえ"],["、"],["主","しゅ"],["は"],["あなた"],["がた"],["と"],["共","とも"],["に"],["おられない"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":44,"text":"しかし、彼,かれらは、ほしいままに山,やまの頂,いただきに登,のぼった。ただし、主,しゅの契約,けいやくの箱,はこと、モーセとは、宿営,しゅくえいの中,なかから出,でなかった。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["、"],["ほしいまま"],["に"],["山","やま"],["の"],["頂","いただき"],["に"],["登った","のぼった"],["。"],["ただし"],["、"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["と"],["、"],["モーセ"],["と"],["は"],["、"],["宿営","しゅくえい"],["の"],["中","なか"],["から"],["出なかった","でなかった"],["。"]]},{"verse":45,"text":"そこで、その山,やまに住,すんでいたアマレクびとと、カナンびとが下,くだってきて、彼,かれらを撃,うち破,やぶり、ホルマまで追,おってきた。","tok":[["そこ"],["で"],["、"],["その"],["山","やま"],["に"],["住んで","すんで"],["いた"],["アマレク"],["びと"],["と"],["、"],["カナン"],["びと"],["が"],["下って","くだって"],["きて"],["、"],["彼","かれ"],["ら"],["を"],["撃ち破り","うちやぶり"],["、"],["ホルマ"],["まで"],["追って","おって"],["きた"],["。"]]}]
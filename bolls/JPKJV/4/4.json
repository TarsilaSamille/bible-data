[{"verse":1,"text":"主,しゅはまたモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「レビの子,こたちのうちから、コハテの子,こたちの総数,そうすうを、その氏族,しぞくにより、その父祖,ふその家,いえにしたがって調,しらべ、","tok":[["「"],["レビ"],["の"],["子","こ"],["たち"],["の"],["うち"],["から"],["、"],["コハテ"],["の"],["子","こ"],["たち"],["の"],["総数","そうすう"],["を"],["、"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["調べ","しらべ"],["、"]]},{"verse":3,"text":"三十歳,さい以上,いじょう五十歳,さい以下,いかで、務,つとめにつき、会見,かいけんの幕屋,まくやで働,はたらくことのできる者,ものを、ことごとく数,かぞえなさい。","tok":[["三十歳","さ"],["い"],["以上","いじょう"],["五十歳","さ"],["い"],["以下","いか"],["で"],["、"],["務め","つとめ"],["に"],["つき"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["働く","はたらく"],["こと"],["の"],["できる"],["者","もの"],["を"],["、"],["ことごとく"],["数え","かぞえ"],["なさい"],["。"]]},{"verse":4,"text":"コハテの子,こたちの、会見,かいけんの幕屋,まくやの務,つとめは、いと聖,せいなる物,ものにかかわるものであって、次,つぎのとおりである。","tok":[["コハテ"],["の"],["子","こ"],["たち"],["の"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["務め","つとめ"],["は"],["、"],["いと"],["聖","せい"],["なる"],["物","もの"],["に"],["かかわる"],["もの"],["で"],["あって"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":5,"text":"すなわち、宿営,しゅくえいの進,すすむ時,ときに、アロンとその子,こたちとは、まず、はいって、隔,へだての垂幕,たれまくを取,とりおろし、それをもって、あかしの箱,はこをおおい、","tok":[["すなわち"],["、"],["宿営","しゅくえい"],["の"],["進","すすむ"],["時","とき"],["に"],["、"],["アロン"],["と"],["その"],["子","こ"],["たち"],["と"],["は"],["、"],["まず"],["、"],["はい"],["って"],["、"],["隔て","へだて"],["の"],["垂幕","たれまく"],["を"],["取","とり"],["おろし"],["、"],["それ"],["を"],["もって"],["、"],["あかし"],["の"],["箱","はこ"],["を"],["おおい"],["、"]]},{"verse":6,"text":"その上,うえに、じゅごんの皮,かわのおおいを施,ほどこし、またその上,うえに総,そう青色,あおいろの布,ぬのをうちかけ、環,かんにさおをさし入,いれる。","tok":[["その"],["上","うえ"],["に"],["、"],["じゅごん"],["の"],["皮","かわ"],["の"],["おおい"],["を"],["施し","ほどこし"],["、"],["また"],["その"],["上","うえ"],["に"],["総","そう"],["青色","あおいろ"],["の"],["布","ぬの"],["を"],["うちかけ"],["、"],["環","かん"],["に"],["さお"],["を"],["さし入れる","さしいれる"],["。"]]},{"verse":7,"text":"また供,そなえのパンの机,つくえの上,うえには、青色,あおいろの布,ぬのをうちかけ、その上,うえに、さら、乳香,にゅうこうを盛,もる杯,さかずき、鉢,はち、および灌祭,かんさいの瓶,びんを並,ならべ、また絶,たやさず供,そなえるパンを置,おき、","tok":[["また"],["供え","そなえ"],["の"],["パン"],["の"],["机","つくえ"],["の"],["上","うえ"],["に"],["は"],["、"],["青色","あおいろ"],["の"],["布","ぬの"],["を"],["うちかけ"],["、"],["その"],["上","うえ"],["に"],["、"],["さら"],["、"],["乳香","にゅうこう"],["を"],["盛る","もる"],["杯","さかずき"],["、"],["鉢","は"],["ち"],["、"],["および"],["灌祭","かんさい"],["の"],["瓶","びん"],["を"],["並べ","ならべ"],["、"],["また"],["絶やさず","たやさず"],["供える","そなえる"],["パン"],["を"],["置き","おき"],["、"]]},{"verse":8,"text":"緋色,ひいろの布,ぬのをその上,うえにうちかけ、じゅごんの皮,かわのおおいをもって、これをおおい、さおをさし入,いれる。","tok":[["緋色","ひいろ"],["の"],["布","ぬの"],["を"],["その"],["上","うえ"],["に"],["うちかけ"],["、"],["じゅごん"],["の"],["皮","かわ"],["の"],["おおい"],["を"],["もって"],["、"],["これ"],["を"],["おおい"],["、"],["さお"],["を"],["さし入れる","さしいれる"],["。"]]},{"verse":9,"text":"また青色,あおいろの布,ぬのを取,とって、燭台,しょくだいとそのともし火,ひざら、芯,しん切,きりばさみ、芯,しん取,とりざら、およびそれに用,もちいるもろもろの油,あぶらの器,うつわをおおい、","tok":[["また"],["青色","あおいろ"],["の"],["布","ぬの"],["を"],["取って","とって"],["、"],["燭台","しょくだい"],["と"],["その"],["ともし火","ともしひ"],["ざら"],["、"],["芯切り","しんきり"],["ばさみ"],["、"],["芯取","しんとり"],["ざら"],["、"],["および"],["それ"],["に"],["用いる","もちいる"],["もろもろ"],["の"],["油","あぶら"],["の"],["器","うつわ"],["を"],["おおい"],["、"]]},{"verse":10,"text":"じゅごんの皮,かわのおおいのうちに、燭台,しょくだいとそのもろもろの器,うつわをいれて、担架,たんかに載,のせる。","tok":[["じゅごん"],["の"],["皮","かわ"],["の"],["おおい"],["の"],["うち"],["に"],["、"],["燭台","しょくだい"],["と"],["その"],["もろもろ"],["の"],["器","うつわ"],["を"],["いれて"],["、"],["担架","たんか"],["に"],["載せる","のせる"],["。"]]},{"verse":11,"text":"また、金,きんの祭壇,さいだんの上,うえに青色,あおいろの布,ぬのをうちかけ、じゅごんの皮,かわのおおいで、これをおおい、そのさおをさし入,いれる。","tok":[["また"],["、"],["金","きん"],["の"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["青色","あおいろ"],["の"],["布","ぬの"],["を"],["うちかけ"],["、"],["じゅごん"],["の"],["皮","かわ"],["の"],["おおい"],["で"],["、"],["これ"],["を"],["おおい"],["、"],["その"],["さお"],["を"],["さし入れる","さしいれる"],["。"]]},{"verse":12,"text":"また聖所,せいじょの務,つとめに用,もちいる務,つとめの器,うつわをみな取,とり、青色,あおいろの布,ぬのに包,つつみ、じゅごんの皮,かわのおおいで、これをおおって、担架,たんかに載,のせる。","tok":[["また"],["聖","せい"],["所","しょ"],["の"],["務め","つとめ"],["に"],["用いる","もちいる"],["務め","つとめ"],["の"],["器","うつわ"],["を"],["みな"],["取","とり"],["、"],["青色","あおいろ"],["の"],["布","ぬの"],["に"],["包","つつみ"],["、"],["じゅごん"],["の"],["皮","かわ"],["の"],["おおい"],["で"],["、"],["これ"],["を"],["おおって"],["、"],["担架","たんか"],["に"],["載せる","のせる"],["。"]]},{"verse":13,"text":"また祭壇,さいだんの灰,はいを取,とり去,さって、紫,むらさきの布,ぬのをその祭壇,さいだんの上,うえにうちかけ、","tok":[["また"],["祭壇","さいだん"],["の"],["灰","はい"],["を"],["取","とり"],["去て","さって"],["、"],["紫","むらさき"],["の"],["布","ぬの"],["を"],["その"],["祭壇","さいだん"],["の"],["上","うえ"],["に"],["うちかけ"],["、"]]},{"verse":14,"text":"その上,うえに、務,つとめをするのに用,もちいるもろもろの器,うつわ、すなわち、火,ひざら、肉,にくさし、十能,じゅうのう、鉢,はち、および祭壇,さいだんのすべての器,うつわを載,のせ、またその上,うえに、じゅごんの皮,かわのおおいをうちかけ、そしてさおをさし入,いれる。","tok":[["その"],["上","うえ"],["に"],["、"],["務め","つとめ"],["を"],["する"],["のに"],["用いる","もちいる"],["もろもろ"],["の"],["器","うつわ"],["、"],["すなわち"],["、"],["火","ひ"],["ざら"],["、"],["肉","にく"],["さし"],["、"],["十能","じゅうのう"],["、"],["鉢","は"],["ち"],["、"],["および"],["祭壇","さいだん"],["の"],["すべて"],["の"],["器","うつわ"],["を"],["載せ","のせ"],["、"],["また"],["その"],["上","うえ"],["に"],["、"],["じゅごん"],["の"],["皮","かわ"],["の"],["おおい"],["を"],["うちかけ"],["、"],["そして"],["さお"],["を"],["さし入れる","さしいれる"],["。"]]},{"verse":15,"text":"宿営,しゅくえいの進,すすむとき、アロンとその子,こたちとが、聖所,せいじょと聖所,せいじょのすべての器,うつわをおおうことを終,おわったならば、その後,のちコハテの子,こたちは、それを運,はこぶために、はいってこなければならない。しかし、彼,かれらは聖,せいなる物,ものに触,ふれてはならない。触,ふれると死,しぬであろう。会見,かいけんの幕屋,まくやのうちの、これらの物,ものは、コハテの子,こたちが運,はこぶものである。","tok":[["宿営","しゅくえい"],["の"],["進む","すすむ"],["とき"],["、"],["アロン"],["と"],["その"],["子","こ"],["たち"],["と"],["が"],["、"],["聖","せい"],["所","しょ"],["と"],["聖","せい"],["所","しょ"],["の"],["すべて"],["の"],["器","うつわ"],["を"],["おおう"],["こと"],["を"],["終わったならば","おわったならば"],["、"],["その後","そのの"],["ち"],["コハテ"],["の"],["子","こ"],["たち"],["は"],["、"],["それ"],["を"],["運こぶ","はこぶ"],["ため"],["に"],["、"],["はいって"],["こなければ"],["ならない"],["。"],["しかし"],["、"],["彼","かれ"],["ら"],["は"],["聖","せい"],["なる"],["物","もの"],["に"],["触","ふれ"],["ては"],["ならない"],["。"],["触れる","ふれる"],["と"],["死ぬで","しぬで"],["あろう"],["。"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["うち"],["の"],["、"],["これ"],["ら"],["の"],["物","もの"],["は"],["、"],["コハテ"],["の"],["子","こ"],["たち"],["が"],["運こぶ","はこぶ"],["もの"],["で"],["ある"],["。"]]},{"verse":16,"text":"祭司,さいしアロンの子,こエレアザルは、ともし油,あぶら、香,こうばしい薫香,くんこう、絶,たやさず供,そなえる素祭,そさいおよび注,そそぎ油,あぶらをつかさどり、また幕屋,まくやの全体,ぜんたいと、そのうちにあるすべての聖,せいなる物,もの、およびその所,ところのもろもろの器,うつわをつかさどらなければならない」。","tok":[["祭司","さいし"],["アロン"],["の"],["子","こ"],["エレアザル"],["は"],["、"],["ともし"],["油","あぶら"],["、"],["香ばしい","こうばしい"],["薫香","くんこう"],["、"],["絶やさず","たやさず"],["供える","そなえる"],["素","す"],["祭","まつり"],["さい"],["および"],["注ぎ","そそぎ"],["油","あぶら"],["を"],["つかさどり"],["、"],["また"],["幕屋","まくや"],["の"],["全体","ぜんたい"],["と"],["、"],["その"],["うち"],["に"],["ある"],["すべて"],["の"],["聖","せい"],["なる"],["物","もの"],["、"],["および"],["その"],["所","ところ"],["の"],["もろもろ"],["の"],["器","うつわ"],["を"],["つかさどらなければ"],["ならない"],["」"],["。"]]},{"verse":17,"text":"主,しゅはまた、モーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["、"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":18,"text":"「あなたがたはコハテびとの一族,いちぞくを、レビびとのうちから絶,たえさせてはならない。","tok":[["「"],["あなた"],["がた"],["は"],["コハテ"],["びと"],["の"],["一族","いちぞく"],["を"],["、"],["レビ"],["びと"],["の"],["うち"],["から"],["絶えさせて","たえさせて"],["は"],["ならない"],["。"]]},{"verse":19,"text":"彼,かれらがいと聖,せいなる物,ものに近,ちかづく時,とき、死,しなないで、命,いのちを保,たもつために、このようにしなさい、すなわち、アロンとその子,こたちが、まず、はいり、彼,かれらをおのおのその働,はたらきにつかせ、そのになうべきものを取,とらせなさい。","tok":[["彼","かれ"],["ら"],["が"],["いと"],["聖","せい"],["なる"],["物","もの"],["に"],["近づく","ちかづく"],["時","とき"],["、"],["死なないで","しなないで"],["、"],["命","いのち"],["を"],["保つ","たもつ"],["ため"],["に"],["、"],["この"],["よう"],["に"],["し"],["なさい"],["、"],["すなわち"],["、"],["アロン"],["と"],["その"],["子","こ"],["たち"],["が"],["、"],["まず"],["、"],["はいり"],["、"],["彼","かれ"],["ら"],["を"],["おのおの"],["その"],["働らき","はたらき"],["に"],["つかせ"],["、"],["その"],["になうべき"],["もの"],["を"],["取らせ","とらせ"],["なさい"],["。"]]},{"verse":20,"text":"しかし、彼,かれらは、はいって、ひと目,めでも聖,せいなる物,ものを見,みてはならない。見,みるならば死,しぬであろう」。","tok":[["しかし"],["、"],["彼","かれ"],["ら"],["は"],["、"],["はい"],["って"],["、"],["ひと目","ひとめ"],["で"],["も"],["聖","せい"],["なる"],["物","もの"],["を"],["見て","みて"],["は"],["ならない"],["。"],["見るならば","みるならば"],["死ぬで","しぬで"],["あろう"],["」"],["。"]]},{"verse":21,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":22,"text":"「あなたはまたゲルションの子,こたちの総数,そうすうを、その父祖,ふその家,いえにより、その氏族,しぞくにしたがって調,しらべ、","tok":[["「"],["あなた"],["は"],["また"],["ゲルション"],["の"],["子","こ"],["たち"],["の"],["総数","そうすう"],["を"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["より"],["、"],["その"],["氏族","しぞく"],["に"],["したがって"],["調べ","しらべ"],["、"]]},{"verse":23,"text":"三十歳,さい以上,いじょう五十歳,さい以下,いかで、務,つとめにつき、会見,かいけんの幕屋,まくやで働,はたらくことのできる者,ものを、ことごとく数,かぞえなさい。","tok":[["三十歳","さ"],["い"],["以上","いじょう"],["五十歳","さ"],["い"],["以下","いか"],["で"],["、"],["務め","つとめ"],["に"],["つき"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["働く","はたらく"],["こと"],["の"],["できる"],["者","もの"],["を"],["、"],["ことごとく"],["数え","かぞえ"],["なさい"],["。"]]},{"verse":24,"text":"ゲルションびとの氏族,しぞくの務,つとめとして働,はたらくことと、運,はこぶ物,ものとは次,つぎのとおりである。","tok":[["ゲルション"],["びと"],["の"],["氏族","しぞく"],["の"],["務め","つとめ"],["として"],["働く","はたらく"],["こと"],["と"],["、"],["運こぶ","はこぶ"],["物","もの"],["と"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":25,"text":"すなわち、彼,かれらは幕屋,まくやの幕,まく、会見,かいけんの幕屋,まくやおよびそのおおいと、その上,うえのじゅごんの皮,かわのおおい、ならびに会見,かいけんの幕屋,まくやの入口,いりぐちのとばりを運,はこび、","tok":[["すなわち"],["、"],["彼","かれ"],["ら"],["は"],["幕屋","まくや"],["の"],["幕","まく"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["および"],["その"],["おおい"],["と"],["、"],["その"],["上","うえ"],["の"],["じゅごん"],["の"],["皮","かわ"],["の"],["おおい"],["、"],["ならび"],["に"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["の"],["とばり"],["を"],["運こび","はこび"],["、"]]},{"verse":26,"text":"また庭,にわのあげばり、および幕屋,まくやと祭壇,さいだんのまわりの庭,にわの門,もんの入口,いりぐちのとばりと、そのひも、ならびにそれに用,もちいるすべての器,うつわを運,はこばなければならない。そして彼,かれらはすべてこれらのものについての働,はたらきをしなければならない。","tok":[["また"],["庭","にわ"],["の"],["あげ"],["ばり"],["、"],["および"],["幕屋","まくや"],["と"],["祭壇","さいだん"],["の"],["まわり"],["の"],["庭","にわ"],["の"],["門","もん"],["の"],["入口","いりぐち"],["の"],["とばり"],["と"],["、"],["その"],["ひも"],["、"],["ならびに"],["それ"],["に"],["用いる","もちいる"],["すべて"],["の"],["器","うつわ"],["を"],["運こばなければ","はこばなければ"],["ならない"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["すべて"],["これ"],["ら"],["の"],["もの"],["について"],["の"],["働らき","はたらき"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":27,"text":"ゲルションびとの子,こたちのすべての務,つとめ、すなわち、その運,はこぶことと、働,はたらくこととは、すべてアロンとその子,こたちの命,めいに従,したがわなければならない。あなたがたは彼,かれらにすべてその運,はこぶべき物,ものを定,さだめて、これを守,まもらせなければならない。","tok":[["ゲルション"],["びと"],["の"],["子","こ"],["たち"],["の"],["すべて"],["の"],["務め","つとめ"],["、"],["すなわち"],["、"],["その"],["運こぶ","はこぶ"],["こと"],["と"],["、"],["働く","はたらく"],["こと"],["と"],["は"],["、"],["すべて"],["アロン"],["と"],["その"],["子","こ"],["たち"],["の"],["命","めい"],["に"],["従わなければ","したがわなければ"],["ならない"],["。"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["に"],["すべて"],["その"],["運こぶべき","はこぶべき"],["物","もの"],["を"],["定めて","さだめて"],["、"],["これ"],["を"],["守らせなければ","まもらせなければ"],["ならない"],["。"]]},{"verse":28,"text":"これはすなわちゲルションびとの子,こたちの氏族,しぞくが、会見,かいけんの幕屋,まくやでする働,はたらきであって、彼,かれらの務,つとめは祭司,さいしアロンの子,こイタマルの指揮,しきのもとにおかなければならない。","tok":[["これ"],["は"],["すなわち"],["ゲルション"],["びと"],["の"],["子","こ"],["たち"],["の"],["氏族","しぞく"],["が"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["する"],["働らき","はたらき"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["の"],["務め","つとめ"],["は"],["祭司","さいし"],["アロン"],["の"],["子","こ"],["イタマル"],["の"],["指揮","しき"],["の"],["もと"],["に"],["おかなければ"],["ならない"],["。"]]},{"verse":29,"text":"メラリの子,こたちをもまたあなたはその氏族,しぞくにより、その祖父,そふの家,いえにしたがって調,しらべ、","tok":[["メラリ"],["の"],["子","こ"],["たち"],["を"],["も"],["また"],["あなた"],["は"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["祖父","そふ"],["の"],["家","いえ"],["に"],["したがって"],["調べ","しらべ"],["、"]]},{"verse":30,"text":"三十歳,さい以上,いじょう五十歳,さい以下,いかで、務,つとめにつき、会見,かいけんの幕屋,まくやの働,はたらきをすることのできる者,ものを、ことごとく数,かぞえなさい。","tok":[["三十歳","さ"],["い"],["以上","いじょう"],["五十歳","さ"],["い"],["以下","いか"],["で"],["、"],["務め","つとめ"],["に"],["つき"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["働らき","はたらき"],["を"],["する"],["こと"],["の"],["できる"],["者","もの"],["を"],["、"],["ことごとく"],["数え","かぞえ"],["なさい"],["。"]]},{"verse":31,"text":"彼,かれらが会見,かいけんの幕屋,まくやでするすべての務,つとめにしたがって、その運,はこぶ責任,せきにんのある物,ものは次,つぎのとおりである。すなわち、幕屋,まくやの枠,わく、その横木,よこぎ、その柱,はしら、その座,ざ、","tok":[["彼","かれ"],["ら"],["が"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["する"],["すべて"],["の"],["務め","つとめ"],["に"],["したがって"],["、"],["その"],["運こぶ","はこぶ"],["責任","せきにん"],["の"],["ある"],["物","もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["幕屋","まくや"],["の"],["枠","わく"],["、"],["その"],["横木","よ"],["こぎ"],["、"],["その"],["柱","はしら"],["、"],["その"],["座","ざ"],["、"]]},{"verse":32,"text":"庭,にわのまわりの柱,はしら、その座,ざ、その釘,くぎ、そのひも、またそのすべての器,うつわ、およびそれに用,もちいるすべてのものである。あなたがたは彼,かれらが運,はこぶ責任,せきにんのある器,うつわを、その名,なによって割,わり当,あてなければならない。","tok":[["庭","にわ"],["の"],["まわり"],["の"],["柱","はしら"],["、"],["その"],["座","ざ"],["、"],["その"],["釘","くぎ"],["、"],["その"],["ひも"],["、"],["また"],["その"],["すべて"],["の"],["器","うつわ"],["、"],["および"],["それ"],["に"],["用いる","もちいる"],["すべて"],["の"],["もの"],["で"],["ある"],["。"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["が"],["運こぶ","はこぶ"],["責任","せきにん"],["の"],["ある"],["器","うつわ"],["を"],["、"],["その"],["名","な"],["によって"],["割当なければ","わりあてなければ"],["ならない"],["。"]]},{"verse":33,"text":"これはすなわちメラリの子,こたちの氏族,しぞくの働,はたらきであって、彼,かれらは祭司,さいしアロンの子,こイタマルの指揮,しきのもとに、会見,かいけんの幕屋,まくやで、このすべての働,はたらきをしなければならない」。","tok":[["これ"],["は"],["すなわち"],["メラリ"],["の"],["子","こ"],["たち"],["の"],["氏族","しぞく"],["の"],["働らき","はたらき"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["は"],["祭司","さいし"],["アロン"],["の"],["子","こ"],["イタマル"],["の"],["指揮","しき"],["の"],["もと"],["に"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["、"],["この"],["すべて"],["の"],["働らき","はたらき"],["を"],["しなければ"],["ならない"],["」"],["。"]]},{"verse":34,"text":"そこでモーセとアロン、および会衆,かいしゅうのつかさたちは、コハテの子,こたちをその氏族,しぞくにより、その父祖,ふその家,いえにしたがって調,しらべ、","tok":[["そこ"],["で"],["モーセ"],["と"],["アロン"],["、"],["および"],["会衆","かいしゅう"],["の"],["つかさ"],["たち"],["は"],["、"],["コハテ"],["の"],["子","こ"],["たち"],["を"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["調べ","しらべ"],["、"]]},{"verse":35,"text":"三十歳,さい以上,いじょう五十歳,さい以下,いかで、務,つとめにつき、会見,かいけんの幕屋,まくやで働,はたらくことのできる者,ものを、ことごとく数,かぞえたが、","tok":[["三十歳","さ"],["い"],["以上","いじょう"],["五十歳","さ"],["い"],["以下","いか"],["で"],["、"],["務め","つとめ"],["に"],["つき"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["働く","はたらく"],["こと"],["の"],["できる"],["者","もの"],["を"],["、"],["ことごとく"],["数えた","かぞえた"],["が"],["、"]]},{"verse":36,"text":"その氏族,しぞくにしたがって数,かぞえられた者,ものは二千七百五十人,にんであった。","tok":[["その"],["氏族","しぞく"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["二千七百五","にせんななひゃくご"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":37,"text":"これはすなわち、コハテびとの氏族,しぞくの数,かぞえられた者,もので、すべて会見,かいけんの幕屋,まくやで働,はたらくことのできる者,ものであった。モーセとアロンが、主,しゅのモーセによって命,めいじられたところにしたがって数,かぞえたのである。","tok":[["これ"],["は"],["すなわち"],["、"],["コハテ"],["びと"],["の"],["氏族","しぞく"],["の"],["数えられた","かぞえられた"],["者","もの"],["で"],["、"],["すべて"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["働く","はたらく"],["こと"],["の"],["できる"],["者","もの"],["で"],["あった"],["。"],["モーセ"],["と"],["アロン"],["が"],["、"],["主","しゅ"],["の"],["モーセ"],["によって"],["命じられた","めいじられた"],["ところ"],["に"],["したがって"],["数えた","かぞえた"],["ので"],["ある"],["。"]]},{"verse":38,"text":"またゲルションの子,こたちを、その氏族,しぞくにより、その父祖,ふその家,いえにしたがって調,しらべ、","tok":[["また"],["ゲルション"],["の"],["子","こ"],["たち"],["を"],["、"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["調べ","しらべ"],["、"]]},{"verse":39,"text":"三十歳,さい以上,いじょう五十歳,さい以下,いかで、務,つとめにつき、会見,かいけんの幕屋,まくやで働,はたらくことのできる者,ものを、ことごとく数,かぞえたが、","tok":[["三十歳","さ"],["い"],["以上","いじょう"],["五十歳","さ"],["い"],["以下","いか"],["で"],["、"],["務め","つとめ"],["に"],["つき"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["働く","はたらく"],["こと"],["の"],["できる"],["者","もの"],["を"],["、"],["ことごとく"],["数えた","かぞえた"],["が"],["、"]]},{"verse":40,"text":"その氏族,しぞくにより、その父祖,ふその家,いえにしたがって数,かぞえられた者,ものは二千六百三十人,にんであった。","tok":[["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["二千六百三","にせんろくひゃくさん"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":41,"text":"これはすなわち、ゲルションの子,こたちの氏族,しぞくの数,かぞえられた者,もので、すべて会見,かいけんの幕屋,まくやで働,はたらくことのできる者,ものであった。モーセとアロンが、主,しゅの命,めいにしたがって数,かぞえたのである。","tok":[["これ"],["は"],["すなわち"],["、"],["ゲルション"],["の"],["子","こ"],["たち"],["の"],["氏族","しぞく"],["の"],["数えられた","かぞえられた"],["者","もの"],["で"],["、"],["すべて"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["働く","はたらく"],["こと"],["の"],["できる"],["者","もの"],["で"],["あった"],["。"],["モーセ"],["と"],["アロン"],["が"],["、"],["主","しゅ"],["の"],["命","めい"],["に"],["したがって"],["数えた","かぞえた"],["ので"],["ある"],["。"]]},{"verse":42,"text":"またメラリの子,こたちの氏族,しぞくを、その氏族,しぞくにより、その父祖,ふその家,いえにしたがって調,しらべ、","tok":[["また"],["メラリ"],["の"],["子","こ"],["たち"],["の"],["氏族","しぞく"],["を"],["、"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["調べ","しらべ"],["、"]]},{"verse":43,"text":"三十歳,さい以上,いじょう五十歳,さい以下,いかで、務,つとめにつき、会見,かいけんの幕屋,まくやで働,はたらくことのできる者,ものを、ことごとく数,かぞえたが、","tok":[["三十歳","さ"],["い"],["以上","いじょう"],["五十歳","さ"],["い"],["以下","いか"],["で"],["、"],["務め","つとめ"],["に"],["つき"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["働く","はたらく"],["こと"],["の"],["できる"],["者","もの"],["を"],["、"],["ことごとく"],["数えた","かぞえた"],["が"],["、"]]},{"verse":44,"text":"その氏族,しぞくにしたがって数,かぞえられた者,ものは三千二百人,にんであった。","tok":[["その"],["氏族","しぞく"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["三千二百","さんせんにひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":45,"text":"これはすなわち、メラリの子,こたちの氏族,しぞくの数,かぞえられた者,もので、モーセとアロンが、主,しゅのモーセによって命,めいじられたところにしたがって数,かぞえたのである。","tok":[["これ"],["は"],["すなわち"],["、"],["メラリ"],["の"],["子","こ"],["たち"],["の"],["氏族","しぞく"],["の"],["数えられた","かぞえられた"],["者","もの"],["で"],["、"],["モーセ"],["と"],["アロン"],["が"],["、"],["主","しゅ"],["の"],["モーセ"],["によって"],["命じられた","めいじられた"],["ところ"],["に"],["したがって"],["数えた","かぞえた"],["ので"],["ある"],["。"]]},{"verse":46,"text":"モーセとアロン、およびイスラエルのつかさたちは、レビびとを、その氏族,しぞくにより、その父祖,ふその家,いえにしたがって調,しらべ、","tok":[["モーセ"],["と"],["アロン"],["、"],["および"],["イスラエル"],["の"],["つかさ"],["たち"],["は"],["、"],["レビ"],["びと"],["を"],["、"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["したがって"],["調べ","しらべ"],["、"]]},{"verse":47,"text":"三十歳,さい以上,いじょう五十歳,さい以下,いかで、会見,かいけんの幕屋,まくやにはいって務,つとめの働,はたらきをし、また、運,はこぶ働,はたらきをする者,ものを、ことごとく数,かぞえたが、","tok":[["三十歳","さ"],["い"],["以上","いじょう"],["五十歳","さ"],["い"],["以下","いか"],["で"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["はいって"],["務め","つとめ"],["の"],["働らき","はたらき"],["を"],["し"],["、"],["また"],["、"],["運こぶ","はこぶ"],["働らき","はたらき"],["を"],["する"],["者","もの"],["を"],["、"],["ことごとく"],["数えた","かぞえた"],["が"],["、"]]},{"verse":48,"text":"その数,かぞえられた者,ものは八千五百八十人,にんであった。","tok":[["その"],["数えられた","かぞえられた"],["者","もの"],["は"],["八千五百八","はちせんごひゃくはち"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":49,"text":"彼,かれらは主,しゅの命,めいにより、モーセによって任,にんじられ、おのおのその働,はたらきにつき、かつその運,はこぶところを受,うけ持,もった。こうして彼,かれらは主,しゅのモーセに命,めいじられたように数,かぞえられたのである。","tok":[["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["命","めい"],["に"],["より"],["、"],["モーセ"],["によって"],["任じられ","にんじられ"],["、"],["おのおの"],["その"],["働らき","はたらき"],["に"],["つき"],["、"],["かつ"],["その"],["運こぶ","はこぶ"],["ところ"],["を"],["受け持った","うけもった"],["。"],["こう"],["して"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["モーセ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["数えられた","かぞえられた"],["ので"],["ある"],["。"]]}]
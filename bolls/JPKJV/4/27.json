[{"verse":1,"text":"さて、ヨセフの子,こマナセの氏族,しぞくのうちのヘペルの子,こ、ゼロペハデの娘,むすめたちが訴,うったえてきた。ヘペルはギレアデの子,こ、ギレアデはマキルの子,こ、マキルはマナセの子,こである。その娘,むすめたちは名,なをマアラ、ノア、ホグラ、ミルカ、テルザといったが、","tok":[["さて"],["、"],["ヨセフ"],["の"],["子","こ"],["マナセ"],["の"],["氏族","しぞく"],["の"],["うち"],["の"],["ヘペル"],["の"],["子","こ"],["、"],["ゼロペハデ"],["の"],["娘","むすめ"],["たち"],["が"],["訴て","うったえて"],["きた"],["。"],["ヘペル"],["は"],["ギレアデ"],["の"],["子","こ"],["、"],["ギレアデ"],["は"],["マキル"],["の"],["子","こ"],["、"],["マキル"],["は"],["マナセ"],["の"],["子","こ"],["で"],["ある"],["。"],["その"],["娘","むすめ"],["たち"],["は"],["名","な"],["を"],["マアラ"],["、"],["ノア"],["、"],["ホグラ"],["、"],["ミルカ"],["、"],["テルザ"],["と"],["いった"],["が"],["、"]]},{"verse":2,"text":"彼,かれらは会見,かいけんの幕屋,まくやの入口,いりぐちでモーセと、祭司,さいしエレアザルと、つかさたちと全,ぜん会衆,かいしゅうとの前,まえに立,たって言,いった、","tok":[["彼","かれ"],["ら"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["で"],["モーセ"],["と"],["、"],["祭司","さいし"],["エレアザル"],["と"],["、"],["つかさ"],["たち"],["と"],["全","ぜん"],["会衆","かいしゅう"],["と"],["の"],["前","まえ"],["に"],["立って","たって"],["言った","いった"],["、"]]},{"verse":3,"text":"「わたしたちの父,ちちは荒野,あらので死,しにました。彼,かれは、コラの仲間,なかまとなって主,しゅに逆,さからった者,ものどもの仲間,なかまのうちには加,くわわりませんでした。彼,かれは自分,じぶんの罪,つみによって死,しんだのですが、男,おとこの子,こがありませんでした。","tok":[["「"],["わたしたち"],["の"],["父","ちち"],["は"],["荒野","あらの"],["で"],["死にました","しにました"],["。"],["彼","かれ"],["は"],["、"],["コラ"],["の"],["仲間","なかま"],["と"],["なって"],["主に","しゅに"],["逆らった","さからった"],["者","もの"],["ども"],["の"],["仲間","なかま"],["の"],["うち"],["に"],["は"],["加わわりませんでした","くわわりませんでした"],["。"],["彼","かれ"],["は"],["自分","じぶん"],["の"],["罪","つみ"],["によって"],["死んだ","しんだ"],["の"],["です"],["が"],["、"],["男の子","おとこのこ"],["が"],["ありませんでした"],["。"]]},{"verse":4,"text":"男,おとこの子,こがないからといって、どうしてわたしたちの父,ちちの名,ながその氏族,しぞくのうちから削,けずられなければならないのでしょうか。わたしたちの父,ちちの兄弟,きょうだいと同,おなじように、わたしたちにも所有,しょゆう地,ちを与,あたえてください」。","tok":[["男の子","おとこのこ"],["が"],["ない"],["から"],["と"],["いって"],["、"],["どう"],["して"],["わたしたち"],["の"],["父","ちち"],["の"],["名","な"],["が"],["その"],["氏族","しぞく"],["の"],["うち"],["から"],["削られなければ","けずられなければ"],["ならない"],["の"],["でしょう"],["か"],["。"],["わたしたち"],["の"],["父","ちち"],["の"],["兄弟","きょうだい"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["わたしたち"],["に"],["も"],["所有地","しょゆうち"],["を"],["与","あたえ"],["て"],["ください"],["」"],["。"]]},{"verse":5,"text":"モーセがその事,ことを主,しゅの前,まえに述,のべると、","tok":[["モーセ"],["が"],["その"],["事","こと"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["述べる","のべる"],["と"],["、"]]},{"verse":6,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":7,"text":"「ゼロペハデの娘,むすめたちの言,いうことは正,ただしい。あなたは必,かならず彼,かれらの父,ちちの兄弟,きょうだいたちと同,おなじように、彼,かれらにも嗣,し業,ぎょうの所有,しょゆう地,ちを与,あたえなければならない。すなわち、その父,ちちの嗣,し業,ぎょうを彼,かれらに渡,わたさなければならない。","tok":[["「"],["ゼロペハデ"],["の"],["娘","むすめ"],["たち"],["の"],["言う","いう"],["こと"],["は"],["正い","ただしい"],["。"],["あなた"],["は"],["必","かならず"],["彼","かれ"],["ら"],["の"],["父","ちち"],["の"],["兄弟","きょうだい"],["たち"],["と"],["同じ","おなじ"],["よう"],["に"],["、"],["彼","かれ"],["ら"],["に"],["も"],["嗣業","しぎょう"],["の"],["所有地","しょゆうち"],["を"],["与えなければ","あたえなければ"],["ならない"],["。"],["すなわち"],["、"],["その"],["父","ちち"],["の"],["嗣業","しぎょう"],["を"],["彼","かれ"],["ら"],["に"],["渡さなければ","わたさなければ"],["ならない"],["。"]]},{"verse":8,"text":"あなたはイスラエルの人々,ひとびとに言,いいなさい、『もし人,ひとが死,しんで、男,おとこの子,こがない時,ときは、その嗣,し業,ぎょうを娘,むすめに渡,わたさなければならない。","tok":[["あなた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["もし"],["人","ひと"],["が"],["死んで","しんで"],["、"],["男の子","おとこのこ"],["が"],["ない"],["時","とき"],["は"],["、"],["その"],["嗣業","しぎょう"],["を"],["娘","むすめ"],["に"],["渡さなければ","わたさなければ"],["ならない"],["。"]]},{"verse":9,"text":"もしまた娘,むすめもない時,ときは、その嗣,し業,ぎょうを兄弟,きょうだいに与,あたえなければならない。","tok":[["もし"],["また"],["娘","むすめ"],["も"],["ない"],["時","とき"],["は"],["、"],["その"],["嗣業","しぎょう"],["を"],["兄弟","きょうだい"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":10,"text":"もし兄弟,きょうだいもない時,ときは、その嗣,し業,ぎょうを父,ちちの兄弟,きょうだいに与,あたえなければならない。","tok":[["もし"],["兄弟","きょうだい"],["も"],["ない"],["時","とき"],["は"],["、"],["その"],["嗣業","しぎょう"],["を"],["父","ちち"],["の"],["兄弟","きょうだい"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":11,"text":"もしまた父,ちちに兄弟,きょうだいがない時,ときは、その氏族,しぞくのうちで彼,かれに最,もっとも近,ちかい親族,しんぞくにその嗣,し業,ぎょうを与,あたえて所有,しょゆうさせなければならない』。主,しゅがモーセに命,めいじられたようにイスラエルの人々,ひとびとは、これをおきての定,さだめとしなければならない」。","tok":[["もし"],["また"],["父","ちち"],["に"],["兄弟","きょうだい"],["が"],["ない"],["時","とき"],["は"],["、"],["その"],["氏族","しぞく"],["の"],["うち"],["で"],["彼","かれ"],["に"],["最も","もっとも"],["近い","ちかい"],["親族","しんぞく"],["に"],["その"],["嗣業","しぎょう"],["を"],["与","あたえ"],["て"],["所有","しょゆう"],["させなければ"],["ならない"],["』"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["これ"],["を"],["おきて"],["の"],["定め","さだめ"],["と"],["しなければ"],["ならない"],["」"],["。"]]},{"verse":12,"text":"主,しゅはモーセに言,いわれた、「このアバリムの山,やまに登,のぼって、わたしがイスラエルの人々,ひとびとに与,あたえる地,ちを見,みなさい。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["この"],["アバリム"],["の"],["山","やま"],["に"],["登って","のぼって"],["、"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与える","あたえる"],["地","ち"],["を"],["見","み"],["なさい"],["。"]]},{"verse":13,"text":"あなたはそれを見,みてから、兄弟,きょうだいアロンのようにその民,たみに加,くわえられるであろう。","tok":[["あなた"],["は"],["それ"],["を"],["見て","みて"],["から"],["、"],["兄弟","きょうだい"],["アロン"],["の"],["よう"],["に"],["その"],["民","たみ"],["に"],["加えられるで","くわえられるで"],["あろう"],["。"]]},{"verse":14,"text":"これは会衆,かいしゅうがチンの荒野,あらので逆,さからい争,あらそった時,とき、あなたがたはわたしの命,めいにそむき、あの水,みずのかたわらで彼,かれらの目,めの前,まえにわたしの聖,せいなることを現,あらわさなかったからである」。これはチンの荒野,あらのにあるカデシのメリバの水,みずである。","tok":[["これ"],["は"],["会衆","かいしゅう"],["が"],["チン"],["の"],["荒野","あらの"],["で"],["逆らい","さからい"],["争った","あらそった"],["時","とき"],["、"],["あなた"],["がた"],["は"],["わたし"],["の"],["命","めい"],["に"],["そむき"],["、"],["あの"],["水","みず"],["の"],["かたわら"],["で"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["に"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["現わさなかった","あらわさなかった"],["から"],["で"],["ある"],["」"],["。"],["これ"],["は"],["チン"],["の"],["荒野","あらの"],["に"],["ある"],["カデシ"],["の"],["メリバ"],["の"],["水","みず"],["で"],["ある"],["。"]]},{"verse":15,"text":"モーセは主,しゅに言,いった、","tok":[["モーセ"],["は"],["主に","しゅに"],["言った","いった"],["、"]]},{"verse":16,"text":"「すべての肉,にくなるものの命,いのちの神,かみ、主,しゅよ、どうぞ、この会衆,かいしゅうの上,うえにひとりの人,ひとを立,たて、","tok":[["「"],["すべて"],["の"],["肉","にく"],["なる"],["もの"],["の"],["命","いのち"],["の"],["神","かみ"],["、"],["主","しゅ"],["よ"],["、"],["どうぞ"],["、"],["この"],["会衆","かいしゅう"],["の"],["上","うえ"],["に"],["ひとり"],["の"],["人","ひと"],["を"],["立て","たて"],["、"]]},{"verse":17,"text":"彼,かれらの前,まえに出入,でいりし、彼,かれらを導,みちびき出,だし、彼,かれらを導,みちびき入,いれる者,ものとし、主,しゅの会衆,かいしゅうを牧者,ぼくしゃのない羊,ひつじのようにしないでください」。","tok":[["彼","かれ"],["ら"],["の"],["前","まえ"],["に"],["出入","でいり"],["し"],["、"],["彼","かれ"],["ら"],["を"],["導き出し","みちびきだし"],["、"],["彼","かれ"],["ら"],["を"],["導き入れる","みちびきいれる"],["者","もの"],["と"],["し"],["、"],["主","しゅ"],["の"],["会衆","かいしゅう"],["を"],["牧者","ぼくしゃ"],["の"],["ない"],["羊","ひつじ"],["の"],["よう"],["に"],["しないで"],["ください"],["」"],["。"]]},{"verse":18,"text":"主,しゅはモーセに言,いわれた、「神,かみの霊,れいのやどっているヌンの子,こヨシュアを選,えらび、あなたの手,てをその上,うえにおき、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["神","かみ"],["の"],["霊","れい"],["の"],["やどって"],["いる"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["を"],["選ら","えら"],["び"],["、"],["あなた"],["の"],["手","て"],["を"],["その"],["上","うえ"],["に"],["おき"],["、"]]},{"verse":19,"text":"彼,かれを祭司,さいしエレアザルと全,ぜん会衆,かいしゅうの前,まえに立,たたせて、彼,かれらの前,まえで職,しょくに任,にんじなさい。","tok":[["彼","かれ"],["を"],["祭司","さいし"],["エレアザル"],["と"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立たせて","たたせて"],["、"],["彼","かれ"],["ら"],["の"],["前","まえ"],["で"],["職","しょく"],["に"],["任じ","にんじ"],["なさい"],["。"]]},{"verse":20,"text":"そして彼,かれにあなたの権威,けんいを分,わけ与,あたえ、イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうを彼,かれに従,したがわせなさい。","tok":[["そして"],["彼","かれ"],["に"],["あなた"],["の"],["権威","けんい"],["を"],["分け","わけ"],["与","あたえ"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["を"],["彼","かれ"],["に"],["従わせ","したがわせ"],["なさい"],["。"]]},{"verse":21,"text":"彼,かれは祭司,さいしエレアザルの前,まえに立,たち、エレアザルは彼,かれのためにウリムをもって、主,しゅの前,まえに判断,はんだんを求,もとめなければならない。ヨシュアとイスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうとはエレアザルの言葉,ことばに従,したがっていで、エレアザルの言葉,ことばに従,したがってはいらなければならない」。","tok":[["彼","かれ"],["は"],["祭司","さいし"],["エレアザル"],["の"],["前","まえ"],["に"],["立ち","たち"],["、"],["エレアザル"],["は"],["彼","かれ"],["の"],["ため"],["に"],["ウリム"],["を"],["もって"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["判断","はんだん"],["を"],["求めなければ","もとめなければ"],["ならない"],["。"],["ヨシュア"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["と"],["は"],["エレアザル"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["いで"],["、"],["エレアザル"],["の"],["言葉","ことば"],["に"],["従って","したがって"],["はいらなければ"],["ならない"],["」"],["。"]]},{"verse":22,"text":"そこでモーセは主,しゅが命,めいじられたようにし、ヨシュアを選,えらんで、祭司,さいしエレアザルと全,ぜん会衆,かいしゅうの前,まえに立,たたせ、","tok":[["そこ"],["で"],["モーセ"],["は"],["主","しゅ"],["が"],["命じられた","めいじられた"],["よう"],["に"],["し"],["、"],["ヨシュア"],["を"],["選らんで","えらんで"],["、"],["祭司","さいし"],["エレアザル"],["と"],["全","ぜん"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立たせ","たたせ"],["、"]]},{"verse":23,"text":"彼,かれの上,うえに手,てをおき、主,しゅがモーセによって語,かたられたとおりに彼,かれを任命,にんめいした。","tok":[["彼","かれ"],["の"],["上","うえ"],["に"],["手","て"],["を"],["おき"],["、"],["主","しゅ"],["が"],["モーセ"],["によって"],["語られた","かたられた"],["とおり"],["に"],["彼","かれ"],["を"],["任命","にんめい"],["した"],["。"]]}]
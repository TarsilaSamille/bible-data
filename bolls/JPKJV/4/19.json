[{"verse":1,"text":"主,しゅはモーセとアロンに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["と"],["アロン"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「主,しゅの命,めいじられた律法,りっぽうの定,さだめは次,つぎのとおりである。すなわち『イスラエルの人々,ひとびとに告,つげて、完全,かんぜんで、傷,きずがなく、まだくびきを負,おったことのない赤,あかい雌牛,めうしを、あなたのもとに引,ひいてこさせ、","tok":[["「"],["主","しゅ"],["の"],["命じられた","めいじられた"],["律法","りっぽう"],["の"],["定め","さだめ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["『"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["て"],["、"],["完全","かんぜん"],["で"],["、"],["傷","きず"],["が"],["なく"],["、"],["まだ"],["くびき"],["を"],["負った","おった"],["こと"],["の"],["ない"],["赤い","あかい"],["雌牛","めうし"],["を"],["、"],["あなた"],["の"],["もと"],["に"],["引いて","ひいて"],["こさせ"],["、"]]},{"verse":3,"text":"これを祭司,さいしエレアザルにわたして、宿営,しゅくえいの外,そとにひき出,ださせ、彼,かれの前,まえでこれをほふらせなければならない。","tok":[["これ"],["を"],["祭司","さいし"],["エレアザル"],["に"],["わたして"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["ひき出させ","ひきださせ"],["、"],["彼","かれ"],["の"],["前","まえ"],["で"],["これ"],["を"],["ほふらせなければ"],["ならない"],["。"]]},{"verse":4,"text":"そして祭司,さいしエレアザルは、指,ゆびをもってその血,ちを取,とり、会見,かいけんの幕屋,まくやの表,ひょうに向,むかって、その血,ちを七たびふりかけなければならない。","tok":[["そして"],["祭司","さいし"],["エレアザル"],["は"],["、"],["指","ゆび"],["を"],["もって"],["その"],["血","ち"],["を"],["取","とり"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["表","ひょう"],["に"],["向かって","むかって"],["、"],["その"],["血","ち"],["を"],["七","なな"],["たび"],["ふりかけなければ"],["ならない"],["。"]]},{"verse":5,"text":"ついでその雌牛,めうしを自分,じぶんの目,めの前,まえで焼,やかせ、その皮,かわと肉,にくと血,ちとは、その汚物,おぶつと共,ともに焼,やかなければならない。","tok":[["ついで"],["その"],["雌牛","めうし"],["を"],["自分","じぶん"],["の"],["目","め"],["の"],["前","まえ"],["で"],["焼かせ","やかせ"],["、"],["その"],["皮","かわ"],["と"],["肉","にく"],["と"],["血","ち"],["と"],["は"],["、"],["その"],["汚物","おぶつ"],["と"],["共","とも"],["に"],["焼かなければ","やかなければ"],["ならない"],["。"]]},{"verse":6,"text":"そして祭司,さいしは香柏,こうはくの木,きと、ヒソプと、緋,ひの糸,いととを取,とって雌牛,めうしの燃,もえているなかに投,なげ入,いれなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["香","こう"],["柏","かしわ"],["の"],["木","き"],["と"],["、"],["ヒソプ"],["と"],["、"],["緋","ひ"],["の"],["糸","いと"],["と"],["を"],["取って","とって"],["雌牛","めうし"],["の"],["燃えて","もえて"],["いる"],["なか"],["に"],["投入れなければ","なげいれなければ"],["ならない"],["。"]]},{"verse":7,"text":"そして祭司,さいしは衣服,いふくを洗,あらい、水,みずに身,みをすすいで後,のち、宿営,しゅくえいに、はいることができる。ただし祭司,さいしは夕,ゆうまで汚,けがれる。","tok":[["そして"],["祭司","さいし"],["は"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすいで"],["後","の"],["ち"],["、"],["宿営","しゅくえい"],["に"],["、"],["はいる"],["こと"],["が"],["できる"],["。"],["ただし"],["祭司","さいし"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"]]},{"verse":8,"text":"またその雌牛,めうしを焼,やいた者,ものも水,みずで衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。彼,かれも夕,ゆうまで汚,けがれる。","tok":[["また"],["その"],["雌牛","めうし"],["を"],["焼いた","やいた"],["者","もの"],["も"],["水","みず"],["で"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["彼","かれ"],["も"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"]]},{"verse":9,"text":"それから身,みの清,きよい者,ものがひとり、その雌牛,めうしの灰,はいを集,あつめ、宿営,しゅくえいの外,そとの清,きよい所,ところにたくわえておかなければならない。これはイスラエルの人々,ひとびとの会衆,かいしゅうのため、汚,けがれを清,きよめる水,みずをつくるために備,そなえるものであって、罪,つみを清,きよめるものである。","tok":[["それ"],["から"],["身","み"],["の"],["清い","きよい"],["者","もの"],["が"],["ひとり"],["、"],["その"],["雌牛","めうし"],["の"],["灰","はい"],["を"],["集め","あつめ"],["、"],["宿営","しゅくえい"],["の"],["外","そと"],["の"],["清い","きよい"],["所","ところ"],["に"],["たくわえて"],["おかなければ"],["ならない"],["。"],["これ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["会衆","かいしゅう"],["の"],["ため"],["、"],["汚","けがれ"],["を"],["清める","きよめる"],["水","みず"],["を"],["つくる"],["ため"],["に"],["備","そなえ"],["る"],["もの"],["で"],["あって"],["、"],["罪","つみ"],["を"],["清める","きよめる"],["もの"],["で"],["ある"],["。"]]},{"verse":10,"text":"その雌牛,めうしの灰,はいを集,あつめた者,ものは衣服,いふくを洗,あらわなければならない。その人,ひとは夕,ゆうまで汚,けがれる。これはイスラエルの人々,ひとびとと、そのうちに宿,やどっている他国,たこく人,じんとの、永久,えいきゅうに守,まもるべき定,さだめとしなければならない。","tok":[["その"],["雌牛","めうし"],["の"],["灰","はい"],["を"],["集めた","あつめた"],["者","もの"],["は"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["その"],["人","ひと"],["は"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["。"],["これ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["、"],["その"],["うち"],["に"],["宿って","やどって"],["いる"],["他国人","たこくじんと"],["の"],["、"],["永久","えいきゅう"],["に"],["守","まもる"],["べき"],["定め","さだめ"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":11,"text":"すべて人,ひとの死体,したいに触,ふれる者,ものは、七日,なぬかのあいだ汚,けがれる。","tok":[["すべて"],["人","ひと"],["の"],["死体","したい"],["に"],["触れる","ふれる"],["者","もの"],["は"],["、"],["七日","なぬか"],["の"],["あいだ"],["汚","け"],["がれる"],["。"]]},{"verse":12,"text":"その人,ひとは三日,か目,めと七日,なぬか目,めとに、この灰,はいの水,みずをもって身,みを清,きよめなければならない。そうすれば清,きよくなるであろう。しかし、もし三日,か目,めと七日,なぬか目,めとに、身,みを清,きよめないならば、清,きよくならないであろう。","tok":[["その"],["人","ひと"],["は"],["三日目","かめ"],["と"],["七日","な"],["ぬか目","ぬかめ"],["と"],["に"],["、"],["この"],["灰","はい"],["の"],["水","みず"],["を"],["もって"],["身","み"],["を"],["清めなければ","きよめなければ"],["ならない"],["。"],["そう"],["すれば"],["清く","きよく"],["なるで"],["あろう"],["。"],["しかし"],["、"],["もし"],["三日目","かめ"],["と"],["七日","な"],["ぬか目","ぬかめ"],["と"],["に"],["、"],["身","み"],["を"],["清めないならば","きよめないならば"],["、"],["清く","きよく"],["ならないで"],["あろう"],["。"]]},{"verse":13,"text":"すべて死人,しにんの死体,したいに触,ふれて、身,みを清,きよめない者,ものは主,しゅの幕屋,まくやを汚,けがす者,もので、その人,ひとはイスラエルから断,たたれなければならない。汚,けがれを清,きよめる水,みずがその身,みに注,そそぎかけられないゆえ、その人,ひとは清,きよくならず、その汚,けがれは、なお、その身,みにあるからである。","tok":[["すべて"],["死人","しにん"],["の"],["死体","したい"],["に"],["触","ふれ"],["て"],["、"],["身","み"],["を"],["清めない","きよめない"],["者","もの"],["は"],["主","しゅ"],["の"],["幕屋","まくや"],["を"],["汚","け"],["がす"],["者","もの"],["で"],["、"],["その"],["人","ひと"],["は"],["イスラエル"],["から"],["断たれなければ","たたれなければ"],["ならない"],["。"],["汚","けがれ"],["を"],["清める","きよめる"],["水","みず"],["が"],["その"],["身","み"],["に"],["注ぎ","そそぎ"],["かけられない"],["ゆえ"],["、"],["その"],["人","ひと"],["は"],["清く","きよく"],["ならず"],["、"],["その"],["汚","けがれ"],["は"],["、"],["なお"],["、"],["その"],["身","み"],["に"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":14,"text":"人,ひとが天幕,てんまくの中,なかで死,しんだ時,ときに用,もちいる律法,りっぽうは次,つぎのとおりである。すなわち、すべてその天幕,てんまくにはいった者,もの、およびすべてその天幕,てんまくにいた者,ものは七日,なぬかのあいだ汚,けがれる。","tok":[["人","ひと"],["が"],["天幕","てんまく"],["の"],["中","なか"],["で"],["死んだ","しんだ"],["時","とき"],["に"],["用いる","もちいる"],["律法","りっぽう"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["すべて"],["その"],["天幕","てんまく"],["に"],["はいった"],["者","もの"],["、"],["および"],["すべて"],["その"],["天幕","てんまく"],["に"],["いた"],["者","もの"],["は"],["七日","なぬか"],["の"],["あいだ"],["汚","け"],["がれる"],["。"]]},{"verse":15,"text":"ふたで上,うえをおおわない器,うつわはみな汚,けがれる。","tok":[["ふた"],["で"],["上","うえ"],["を"],["おおわない"],["器","うつわ"],["は"],["みな"],["汚","け"],["がれる"],["。"]]},{"verse":16,"text":"つるぎで殺,ころされた者,もの、または死,しんだ者,もの、または人,ひとの骨,ほね、または墓,はかなどに、野外,やがいで触,ふれる者,ものは皆,みな、七日,なぬかのあいだ汚,けがれる。","tok":[["つるぎ"],["で"],["殺ろされた","ころされた"],["者","もの"],["、"],["また"],["は"],["死んだ","しんだ"],["者","もの"],["、"],["また"],["は"],["人","ひと"],["の"],["骨","ほね"],["、"],["また"],["は"],["墓","はか"],["など"],["に"],["、"],["野外","やがい"],["で"],["触れる","ふれる"],["者","もの"],["は"],["皆","みな"],["、"],["七日","なぬか"],["の"],["あいだ"],["汚","け"],["がれる"],["。"]]},{"verse":17,"text":"汚,けがれた者,ものがあった時,ときには、罪,つみを清,きよめる焼,やいた雌牛,めうしの灰,はいを取,とって器,うつわに入,いれ、流,ながれの水,みずをこれに加,くわえ、","tok":[["汚","け"],["がれ"],["た"],["者","もの"],["が"],["あった"],["時","とき"],["に"],["は"],["、"],["罪","つみ"],["を"],["清める","きよめる"],["焼いた","やいた"],["雌牛","めうし"],["の"],["灰","はい"],["を"],["取って","とって"],["器","うつわ"],["に"],["入れ","いれ"],["、"],["流れ","ながれ"],["の"],["水","みず"],["を"],["これ"],["に"],["加え","くわえ"],["、"]]},{"verse":18,"text":"身,みの清,きよい者,ものがひとりヒソプを取,とって、その水,みずに浸,ひたし、これをその天幕,てんまくと、すべての器,うつわと、そこにいた人々,ひとびとと、骨,ほね、あるいは殺,ころされた者,もの、あるいは死,しんだ者,もの、あるいは墓,はかなどに触,ふれた者,ものとにふりかけなければならない。","tok":[["身","み"],["の"],["清い","きよい"],["者","もの"],["が"],["ひとり"],["ヒソプ"],["を"],["取って","とって"],["、"],["その"],["水","みず"],["に"],["浸し","ひたし"],["、"],["これ"],["を"],["その"],["天幕","てんまく"],["と"],["、"],["すべて"],["の"],["器","うつわ"],["と"],["、"],["そこ"],["に"],["いた"],["人々","ひとびと"],["と"],["、"],["骨","ほね"],["、"],["あるいは"],["殺ろされた","ころされた"],["者","もの"],["、"],["あるいは"],["死んだ","しんだ"],["者","もの"],["、"],["あるいは"],["墓","はか"],["など"],["に"],["触","ふれ"],["た"],["者","もの"],["と"],["に"],["ふりかけなければ"],["ならない"],["。"]]},{"verse":19,"text":"すなわちその身,みの清,きよい人,ひとは三日,か目,めと七日,なぬか目,めとにその汚,けがれたものに、それをふりかけなければならない。そして七日,なぬか目,めにその人,ひとは身,みを清,きよめ、衣服,いふくを洗,あらい、水,みずに身,みをすすがなければならない。そうすれば夕,ゆうになって清,きよくなるであろう。","tok":[["すなわち"],["その"],["身","み"],["の"],["清い","きよい"],["人","ひと"],["は"],["三日目","かめ"],["と"],["七日","な"],["ぬか目","ぬかめ"],["と"],["に"],["その"],["汚","けがれたも"],["のに"],["、"],["それ"],["を"],["ふりかけなければ"],["ならない"],["。"],["そして"],["七日","な"],["ぬか目","ぬかめ"],["に"],["その"],["人","ひと"],["は"],["身","み"],["を"],["清め","きよめ"],["、"],["衣服","いふく"],["を"],["洗","あらい"],["、"],["水","みず"],["に"],["身","み"],["を"],["すすがなければ"],["ならない"],["。"],["そう"],["すれば"],["夕","ゆう"],["に"],["なって"],["清く","きよく"],["なるで"],["あろう"],["。"]]},{"verse":20,"text":"しかし、汚,けがれて身,みを清,きよめない人,ひとは主,しゅの聖所,せいじょを汚,けがす者,もので、その人,ひとは会衆,かいしゅうのうちから断,たたれなければならない。汚,けがれを清,きよめる水,みずがその身,みに注,そそぎかけられないゆえ、その人,ひとは汚,けがれているからである。","tok":[["しかし"],["、"],["汚","け"],["がれ"],["て"],["身","み"],["を"],["清めない","きよめない"],["人","ひと"],["は"],["主","しゅ"],["の"],["聖","せい"],["所","しょ"],["を"],["汚","け"],["がす"],["者","もの"],["で"],["、"],["その"],["人","ひと"],["は"],["会衆","かいしゅう"],["の"],["うち"],["から"],["断たれなければ","たたれなければ"],["ならない"],["。"],["汚","けがれ"],["を"],["清める","きよめる"],["水","みず"],["が"],["その"],["身","み"],["に"],["注ぎ","そそぎ"],["かけられない"],["ゆえ"],["、"],["その"],["人","ひと"],["は"],["汚","け"],["がれ"],["て"],["いる"],["から"],["で"],["ある"],["。"]]},{"verse":21,"text":"これは彼,かれらの永久,えいきゅうに守,まもるべき定,さだめとしなければならない。すなわち汚,けがれを清,きよめる水,みずをふりかけた者,ものは衣服,いふくを洗,あらわなければならない。また汚,けがれを清,きよめる水,みずに触,ふれた者,ものも夕,ゆうまで汚,けがれるであろう。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["の"],["永久","えいきゅう"],["に"],["守","まもる"],["べき"],["定め","さだめ"],["と"],["しなければ"],["ならない"],["。"],["すなわち"],["汚","けがれ"],["を"],["清める","きよめる"],["水","みず"],["を"],["ふりかけた"],["者","もの"],["は"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["また"],["汚","けがれ"],["を"],["清める","きよめる"],["水","みず"],["に"],["触","ふれ"],["た"],["者","もの"],["も"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["。"]]},{"verse":22,"text":"すべて汚,けがれた人,ひとの触,ふれる物,ものは汚,けがれる。またそれに触,ふれる人,ひとも夕,ゆうまで汚,けがれるであろう』」。","tok":[["すべて"],["汚","け"],["がれ"],["た"],["人","ひと"],["の"],["触れる","ふれる"],["物","もの"],["は"],["汚","け"],["がれる"],["。"],["また"],["それ"],["に"],["触れる","ふれる"],["人","ひと"],["も"],["夕","ゆう"],["まで"],["汚","け"],["がれる"],["で"],["あろう"],["』"],["」"],["。"]]}]
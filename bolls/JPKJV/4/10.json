[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「銀,ぎんのラッパを二本,ほんつくりなさい。すなわち、打物,うちもの造,つくりとし、それで会衆,かいしゅうを呼,よび集,あつめ、また宿営,しゅくえいを進,すすませなさい。","tok":[["「"],["銀","ぎん"],["の"],["ラッパ"],["を"],["二本","ほん"],["つくり"],["なさい"],["。"],["すなわち"],["、"],["打物造","うちものつくり"],["と"],["し"],["、"],["それ"],["で"],["会衆","かいしゅう"],["を"],["呼び集め","よびあつめ"],["、"],["また"],["宿営","しゅくえい"],["を"],["進ませ","すすませ"],["なさい"],["。"]]},{"verse":3,"text":"この二つを吹,ふくときは、全,ぜん会衆,かいしゅうが会見,かいけんの幕屋,まくやの入口,いりぐちに、あなたの所,ところに集,あつまってこなければならない。","tok":[["この"],["二","ふた"],["つ"],["を"],["吹く","ふく"],["とき"],["は"],["、"],["全","ぜん"],["会衆","かいしゅう"],["が"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["、"],["あなた"],["の"],["所","ところ"],["に"],["集まって","あつまって"],["こなければ"],["ならない"],["。"]]},{"verse":4,"text":"もしその一つだけを吹,ふくときは、イスラエルの氏族,しぞくの長,ちょうであるつかさたちが、あなたの所,ところに集,あつまってこなければならない。","tok":[["もし"],["その"],["一","ひと"],["つ"],["だけ"],["を"],["吹く","ふく"],["とき"],["は"],["、"],["イスラエル"],["の"],["氏族","しぞく"],["の"],["長","ちょう"],["で"],["ある"],["つかさ"],["たち"],["が"],["、"],["あなた"],["の"],["所","ところ"],["に"],["集まって","あつまって"],["こなければ"],["ならない"],["。"]]},{"verse":5,"text":"またあなたがたが警報,けいほうを吹,ふき鳴,ならす時,ときは、東,ひがしの方,ほうの宿営,しゅくえいが、道,みちに進,すすまなければならない。","tok":[["また"],["あなた"],["がた"],["が"],["警報","けいほう"],["を"],["吹","ふき"],["鳴らす","ならす"],["時","とき"],["は"],["、"],["東","ひがし"],["の"],["方","ほう"],["の"],["宿営","しゅくえい"],["が"],["、"],["道","みち"],["に"],["進まなければ","すすまなければ"],["ならない"],["。"]]},{"verse":6,"text":"二度目,どめの警報,けいほうを吹,ふき鳴,ならす時,ときは、南,みなみの方,ほうの宿営,しゅくえいが、道,みちに進,すすまなければならない。すべて道,みちに進,すすむ時,ときは、警報,けいほうを吹,ふき鳴,ならさなければならない。","tok":[["二度目","どめ"],["の"],["警報","けいほう"],["を"],["吹","ふき"],["鳴らす","ならす"],["時","とき"],["は"],["、"],["南","みなみ"],["の"],["方","ほう"],["の"],["宿営","しゅくえい"],["が"],["、"],["道","みち"],["に"],["進まなければ","すすまなければ"],["ならない"],["。"],["すべて"],["道","みち"],["に"],["進","すすむ"],["時","とき"],["は"],["、"],["警報","けいほう"],["を"],["吹","ふき"],["鳴らさなければ","ならさなければ"],["ならない"],["。"]]},{"verse":7,"text":"また会衆,かいしゅうを集,あつめる時,ときにも、ラッパを吹,ふき鳴,ならすが、警報,けいほうは吹,ふき鳴,ならしてはならない。","tok":[["また"],["会衆","かいしゅう"],["を"],["集める","あつめる"],["時","とき"],["に"],["も"],["、"],["ラッパ"],["を"],["吹","ふき"],["鳴らす","ならす"],["が"],["、"],["警報","けいほう"],["は"],["吹鳴","ふきな"],["らし"],["ては"],["ならない"],["。"]]},{"verse":8,"text":"アロンの子,こである祭司,さいしたちが、ラッパを吹,ふかなければならない。これはあなたがたが、代々,よよながく守,まもるべき定,さだめとしなければならない。","tok":[["アロン"],["の"],["子","こ"],["で"],["ある"],["祭司","さいし"],["たち"],["が"],["、"],["ラッパ"],["を"],["吹かなければ","ふかなければ"],["ならない"],["。"],["これ"],["は"],["あなた"],["が"],["た"],["が"],["、"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定め","さだめ"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":9,"text":"また、あなたがたの国,くにで、あなたがたをしえたげるあだとの戦,たたかいに出,でる時,ときは、ラッパをもって、警報,けいほうを吹,ふき鳴,ならさなければならない。そうするならば、あなたがたは、あなたがたの神,かみ、主,しゅに覚,おぼえられて、あなたがたの敵,てきから救,すくわれるであろう。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["国","くに"],["で"],["、"],["あなた"],["がた"],["を"],["し"],["えたげる"],["あだ"],["と"],["の"],["戦い","たたかい"],["に"],["出る","でる"],["時","とき"],["は"],["、"],["ラッパ"],["を"],["もって"],["、"],["警報","けいほう"],["を"],["吹","ふき"],["鳴らさなければ","ならさなければ"],["ならない"],["。"],["そう"],["するならば"],["、"],["あなた"],["がた"],["は"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主に","しゅに"],["覚えられて","おぼえられて"],["、"],["あなた"],["がた"],["の"],["敵","てき"],["から"],["救われるで","すくわれるで"],["あろう"],["。"]]},{"verse":10,"text":"また、あなたがたの喜,よろこびの日,ひ、あなたがたの祝,いわいの時,とき、および月々,つきづきの第,だい一日,にちには、あなたがたの燔祭,はんさいと酬恩祭,しゅうおんさいの犠牲,ぎせいをささげるに当,あたって、ラッパを吹,ふき鳴,ならさなければならない。そうするならば、あなたがたの神,かみは、それによって、あなたがたを覚,おぼえられるであろう。わたしはあなたがたの神,かみ、主,しゅである」。","tok":[["また"],["、"],["あなた"],["がた"],["の"],["喜こび","よろこび"],["の"],["日","ひ"],["、"],["あなた"],["がた"],["の"],["祝い","いわい"],["の"],["時","とき"],["、"],["および"],["月々","つきづき"],["の"],["第","だい"],["一","いち"],["日","にち"],["に"],["は"],["、"],["あなた"],["がた"],["の"],["燔祭","はんさい"],["と"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["を"],["ささげる"],["に"],["当たって","あたって"],["、"],["ラッパ"],["を"],["吹","ふき"],["鳴らさなければ","ならさなければ"],["ならない"],["。"],["そう"],["するならば"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["は"],["、"],["それ"],["によって"],["、"],["あなた"],["がた"],["を"],["覚えられるで","おぼえられるで"],["あろう"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["」"],["。"]]},{"verse":11,"text":"第,だい二年,ねんの二月,にがつ二十日,はつかに、雲,くもがあかしの幕屋,まくやを離,はなれてのぼったので、","tok":[["第","だい"],["二","に"],["年","ねん"],["の"],["二","に"],["月","がつ"],["二十日","はつか"],["に"],["、"],["雲","くも"],["が"],["あかし"],["の"],["幕屋","まくや"],["を"],["離れて","はなれて"],["のぼった"],["ので"],["、"]]},{"verse":12,"text":"イスラエルの人々,ひとびとは、シナイの荒野,あらのを出,でて、その旅路,たびじに進,すすんだが、パランの荒野,あらのに至,いたって、雲,くもはとどまった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["シナイ"],["の"],["荒野","あらの"],["を"],["出て","でて"],["、"],["その"],["旅路","たびじ"],["に"],["進んだ","すすんだ"],["が"],["、"],["パラン"],["の"],["荒野","あらの"],["に"],["至って","いたって"],["、"],["雲","くも"],["は"],["とどまった"],["。"]]},{"verse":13,"text":"こうして彼,かれらは、主,しゅがモーセによって、命,めいじられたところにしたがって、道,みちに進,すすむことを始,はじめた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["、"],["主","しゅ"],["が"],["モーセ"],["によって"],["、"],["命じられた","めいじられた"],["ところ"],["に"],["したがって"],["、"],["道","みち"],["に"],["進","すすむ"],["こと"],["を"],["始めた","はじめた"],["。"]]},{"verse":14,"text":"先頭,せんとうには、ユダの子,こたちの宿営,しゅくえいの旗,はたが、その部隊,ぶたいを従,したがえて進,すすんだ。ユダの部隊,ぶたいの長,ちょうはアミナダブの子,こナション、","tok":[["先頭","せんとう"],["に"],["は"],["、"],["ユダ"],["の"],["子","こ"],["たち"],["の"],["宿営","しゅくえい"],["の"],["旗","はた"],["が"],["、"],["その"],["部隊","ぶたい"],["を"],["従えて","したがえて"],["進んだ","すすんだ"],["。"],["ユダ"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["アミナダブ"],["の"],["子","こ"],["ナション"],["、"]]},{"verse":15,"text":"イッサカルの子,こたちの部族,ぶぞくの部隊,ぶたいの長,ちょうはツアルの子,こネタニエル、","tok":[["イッサカル"],["の"],["子","こ"],["たち"],["の"],["部族","ぶぞく"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["ツアル"],["の"],["子","こ"],["ネタニエル"],["、"]]},{"verse":16,"text":"ゼブルンの子,こたちの部族,ぶぞくの部隊,ぶたいの長,ちょうはヘロンの子,こエリアブであった。","tok":[["ゼブルン"],["の"],["子","こ"],["たち"],["の"],["部族","ぶぞく"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["ヘロン"],["の"],["子","こ"],["エリアブ"],["で"],["あった"],["。"]]},{"verse":17,"text":"そして幕屋,まくやは取,とりくずされ、ゲルションの子,こたち、およびメラリの子,こたちは幕屋,まくやを運,はこび進,すすんだ。","tok":[["そして"],["幕屋","まくや"],["は"],["取","とり"],["くずされ"],["、"],["ゲルション"],["の"],["子","こ"],["たち"],["、"],["および"],["メラリ"],["の"],["子","こ"],["たち"],["は"],["幕屋","まくや"],["を"],["運こび","はこび"],["進んだ","すすんだ"],["。"]]},{"verse":18,"text":"次,つぎにルベンの宿営,しゅくえいの旗,はたが、その部隊,ぶたいを従,したがえて進,すすんだ。ルベンの部隊,ぶたいの長,ちょうはシデウルの子,こエリヅル、","tok":[["次","つぎ"],["に"],["ルベン"],["の"],["宿営","しゅくえい"],["の"],["旗","はた"],["が"],["、"],["その"],["部隊","ぶたい"],["を"],["従えて","したがえて"],["進んだ","すすんだ"],["。"],["ルベン"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["シデウル"],["の"],["子","こ"],["エリヅル"],["、"]]},{"verse":19,"text":"シメオンの子,こたちの部族,ぶぞくの部隊,ぶたいの長,ちょうはツリシャダイの子,こシルミエル、","tok":[["シメオン"],["の"],["子","こ"],["たち"],["の"],["部族","ぶぞく"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["ツリシャダイ"],["の"],["子","こ"],["シルミエル"],["、"]]},{"verse":20,"text":"ガドの子,こたちの部族,ぶぞくの部隊,ぶたいの長,ちょうはデウエルの子,こエリアサフであった。","tok":[["ガド"],["の"],["子","こ"],["たち"],["の"],["部族","ぶぞく"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["デウエル"],["の"],["子","こ"],["エリアサフ"],["で"],["あった"],["。"]]},{"verse":21,"text":"そしてコハテびとは聖,せいなる物,ものを運,はこび進,すすんだ。これが着,つくまでに、人々,ひとびとは幕屋,まくやを建,たて終,おわるのである。","tok":[["そして"],["コハテ"],["びと"],["は"],["聖","せい"],["なる"],["物","もの"],["を"],["運こび","はこび"],["進んだ","すすんだ"],["。"],["これ"],["が"],["着く","つく"],["まで"],["に"],["、"],["人々","ひとびと"],["は"],["幕屋","まくや"],["を"],["建て","たて"],["終わる","おわる"],["ので"],["ある"],["。"]]},{"verse":22,"text":"次,つぎにエフライムの子,こたちの宿営,しゅくえいの旗,はたが、その部隊,ぶたいを従,したがえて進,すすんだ。エフライムの部隊,ぶたいの長,ちょうはアミホデの子,こエリシャマ、","tok":[["次","つぎ"],["に"],["エフライム"],["の"],["子","こ"],["たち"],["の"],["宿営","しゅくえい"],["の"],["旗","はた"],["が"],["、"],["その"],["部隊","ぶたい"],["を"],["従えて","したがえて"],["進んだ","すすんだ"],["。"],["エフライム"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["アミホデ"],["の"],["子","こ"],["エリシャマ"],["、"]]},{"verse":23,"text":"マナセの子,こたちの部族,ぶぞくの部隊,ぶたいの長,ちょうはパダヅルの子,こガマリエル、","tok":[["マナセ"],["の"],["子","こ"],["たち"],["の"],["部族","ぶぞく"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["パダヅル"],["の"],["子","こ"],["ガマリエル"],["、"]]},{"verse":24,"text":"ベニヤミンの子,こたちの部族,ぶぞくの部隊,ぶたいの長,ちょうはギデオニの子,こアビダンであった。","tok":[["ベニヤミン"],["の"],["子","こ"],["たち"],["の"],["部族","ぶぞく"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["ギデオニ"],["の"],["子","こ"],["アビダン"],["で"],["あった"],["。"]]},{"verse":25,"text":"次,つぎにダンの子,こたちの宿営,しゅくえいの旗,はたが、その部隊,ぶたいを従,したがえて進,すすんだ。この部隊,ぶたいはすべての宿営,しゅくえいのしんがりであった。ダンの部隊,ぶたいの長,ちょうはアミシャダイの子,こアヒエゼル、","tok":[["次","つぎ"],["に"],["ダン"],["の"],["子","こ"],["たち"],["の"],["宿営","しゅくえい"],["の"],["旗","はた"],["が"],["、"],["その"],["部隊","ぶたい"],["を"],["従えて","したがえて"],["進んだ","すすんだ"],["。"],["この"],["部隊","ぶたい"],["は"],["すべて"],["の"],["宿営","しゅくえい"],["の"],["しんがり"],["で"],["あった"],["。"],["ダン"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["アミシャダイ"],["の"],["子","こ"],["アヒエゼル"],["、"]]},{"verse":26,"text":"アセルの子,こたちの部族,ぶぞくの部隊,ぶたいの長,ちょうはオクランの子,こパギエル、","tok":[["アセル"],["の"],["子","こ"],["たち"],["の"],["部族","ぶぞく"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["オクラン"],["の"],["子","こ"],["パギエル"],["、"]]},{"verse":27,"text":"ナフタリの子,こたちの部族,ぶぞくの部隊,ぶたいの長,ちょうはエナンの子,こアヒラであった。","tok":[["ナフタリ"],["の"],["子","こ"],["たち"],["の"],["部族","ぶぞく"],["の"],["部隊","ぶたい"],["の"],["長","ちょう"],["は"],["エナン"],["の"],["子","こ"],["アヒラ"],["で"],["あった"],["。"]]},{"verse":28,"text":"イスラエルの人々,ひとびとが、その道,みちに進,すすむ時,ときは、このように、その部隊,ぶたいに従,したがって進,すすんだ。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["その"],["道","みち"],["に"],["進","すすむ"],["時","とき"],["は"],["、"],["この"],["よう"],["に"],["、"],["その"],["部隊","ぶたい"],["に"],["従って","したがって"],["進んだ","すすんだ"],["。"]]},{"verse":29,"text":"さて、モーセは、妻,つまの父,ちち、ミデヤンびとリウエルの子,こホバブに言,いった、「わたしたちは、かつて主,しゅがおまえたちに与,あたえると約束,やくそくされた所,ところに向,むかって進,すすんでいます。あなたも一緒,いっしょにおいでください。あなたが幸福,こうふくになられるようにいたしましょう。主,しゅがイスラエルに幸福,こうふくを約束,やくそくされたのですから」。","tok":[["さて"],["、"],["モーセ"],["は"],["、"],["妻","つま"],["の"],["父","ちち"],["、"],["ミデヤン"],["びと"],["リウエル"],["の"],["子","こ"],["ホバブ"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["、"],["かつて"],["主","しゅ"],["が"],["おまえ"],["たち"],["に"],["与える","あたえる"],["と"],["約束","やくそく"],["された"],["所","ところ"],["に"],["向かって","むかって"],["進んで","すすんで"],["います"],["。"],["あなた"],["も"],["一緒","いっしょ"],["に"],["おいで"],["ください"],["。"],["あなた"],["が"],["幸福","こうふく"],["に"],["なられる"],["よう"],["に"],["いたしましょう"],["。"],["主","しゅ"],["が"],["イスラエル"],["に"],["幸福","こうふく"],["を"],["約束","やくそく"],["された"],["の"],["です"],["から"],["」"],["。"]]},{"verse":30,"text":"彼,かれはモーセに言,いった、「わたしは行,いきません。わたしは国,くにに帰,かえって、親族,しんぞくのもとに行,いきます」。","tok":[["彼","かれ"],["は"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["行きません","いきません"],["。"],["わたし"],["は"],["国","くに"],["に"],["帰えって","かえって"],["、"],["親族","しんぞく"],["の"],["もと"],["に"],["行きます","いきます"],["」"],["。"]]},{"verse":31,"text":"モーセはまた言,いった、「どうかわたしたちを見捨,みすてないでください。あなたは、わたしたちが荒野,あらののどこに宿営,しゅくえいすべきかを御存,ごぞんじですから、わたしたちの目,めとなってください。","tok":[["モーセ"],["は"],["また"],["言った","いった"],["、"],["「"],["どう"],["か"],["わたしたち"],["を"],["見捨てないで","みすてないで"],["ください"],["。"],["あなた"],["は"],["、"],["わたしたち"],["が"],["荒野","あらの"],["の"],["どこ"],["に"],["宿営","しゅくえい"],["すべき"],["か"],["を"],["御存じ","ごぞんじ"],["です"],["から"],["、"],["わたしたち"],["の"],["目","め"],["と"],["なって"],["ください"],["。"]]},{"verse":32,"text":"もしあなたが一緒,いっしょにおいでくださるなら、主,しゅがわたしたちに賜,たまわる幸福,こうふくをあなたにも及,およぼしましょう」。","tok":[["もし"],["あなた"],["が"],["一緒","いっしょ"],["に"],["おいで"],["くださるなら"],["、"],["主","しゅ"],["が"],["わたしたち"],["に"],["賜わる","たまわる"],["幸福","こうふく"],["を"],["あなた"],["に"],["も"],["及ぼしましょう","およぼしましょう"],["」"],["。"]]},{"verse":33,"text":"こうして彼,かれらは主,しゅの山,やまを去,さって、三日,かの行程,こうていを進,すすんだ。主,しゅの契約,けいやくの箱,はこは、その三日,かの行程,こうていの間,あいだ、彼,かれらに先立,さきだって行,いき、彼,かれらのために休,やすむ所,ところを尋,たずねもとめた。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["主","しゅ"],["の"],["山","やま"],["を"],["去て","さって"],["、"],["三日","か"],["の"],["行程","こうてい"],["を"],["進んだ","すすんだ"],["。"],["主","しゅ"],["の"],["契約","けいやく"],["の"],["箱","はこ"],["は"],["、"],["その"],["三日","か"],["の"],["行程","こうてい"],["の"],["間","あいだ"],["、"],["彼","かれ"],["ら"],["に"],["先立って","さきだって"],["行き","いき"],["、"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["休む","やすむ"],["所","ところ"],["を"],["尋ね","たずね"],["もとめた"],["。"]]},{"verse":34,"text":"彼,かれらが宿営,しゅくえいを出,でて、道,みちに進,すすむとき、昼,ひるは主,しゅの雲,くもが彼,かれらの上,うえにあった。","tok":[["彼","かれ"],["ら"],["が"],["宿営","しゅくえい"],["を"],["出て","でて"],["、"],["道","みち"],["に"],["進む","すすむ"],["とき"],["、"],["昼","ひる"],["は"],["主","しゅ"],["の"],["雲","くも"],["が"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["あった"],["。"]]},{"verse":35,"text":"契約,けいやくの箱,はこの進,すすむときモーセは言,いった、「主,しゅよ、立,たちあがってください。あなたの敵,てきは打,うち散,ちらされ、あなたを憎,にくむ者,ものどもは、あなたの前,まえから逃,にげ去,さりますように」。","tok":[["契約","けいやく"],["の"],["箱","はこ"],["の"],["進む","すすむ"],["とき"],["モーセ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["立ちあがって","たちあがって"],["ください"],["。"],["あなた"],["の"],["敵","てき"],["は"],["打ち散らされ","うちちらされ"],["、"],["あなた"],["を"],["憎む","にくむ"],["者","もの"],["ども"],["は"],["、"],["あなた"],["の"],["前","まえ"],["から"],["逃","にげ"],["去ります","さります"],["よう"],["に"],["」"],["。"]]},{"verse":36,"text":"またそのとどまるとき、彼,かれは言,いった、「主,しゅよ、帰,かえってきてください、イスラエルのちよろずの人,ひとに」。","tok":[["また"],["その"],["とどまる"],["とき"],["、"],["彼","かれ"],["は"],["言った","いった"],["、"],["「"],["主","しゅ"],["よ"],["、"],["帰えって","かえって"],["きて"],["ください"],["、"],["イスラエル"],["のち"],["よろず"],["の"],["人","ひと"],["に"],["」"],["。"]]}]
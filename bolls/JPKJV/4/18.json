[{"verse":1,"text":"そこで、主,しゅはアロンに言,いわれた、「あなたとあなたの子,こたち、およびあなたの父祖,ふその家,いえの者,ものは、聖所,せいじょに関,かんする罪,つみを負,おわなければならない。また、あなたとあなたの子,こたちとは、祭司,さいし職,しょくに関,かんする罪,つみを負,おわなければならない。","tok":[["そこ"],["で"],["、"],["主","しゅ"],["は"],["アロン"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["たち"],["、"],["および"],["あなた"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["者","もの"],["は"],["、"],["聖","せい"],["所","しょ"],["に"],["関する","かんする"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"],["また"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["たち"],["と"],["は"],["、"],["祭司","さいし"],["職","しょく"],["に"],["関する","かんする"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["。"]]},{"verse":2,"text":"あなたはまた、あなたの兄弟,きょうだいなるレビの部族,ぶぞくの者,もの、すなわち、あなたの父祖,ふその部族,ぶぞくの者,ものどもを、あなたに近,ちかづかせ、あなたに連,つらなり、あなたに仕,つかえさせなければならない。ただし、あなたとあなたの子,こたちとは、共,ともにあかしの幕屋,まくやの前,まえで仕,つかえなければならない。","tok":[["あなた"],["は"],["また"],["、"],["あなた"],["の"],["兄弟","きょうだい"],["なる"],["レビ"],["の"],["部族","ぶぞく"],["の"],["者","もの"],["、"],["すなわち"],["、"],["あなた"],["の"],["父祖","ふそ"],["の"],["部族","ぶぞく"],["の"],["者","もの"],["ども"],["を"],["、"],["あなた"],["に"],["近づかせ","ちかづかせ"],["、"],["あなた"],["に"],["連なり","つらなり"],["、"],["あなた"],["に"],["仕えさせなければ","つかえさせなければ"],["ならない"],["。"],["ただし"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["たち"],["と"],["は"],["、"],["共","とも"],["に"],["あかし"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["で"],["仕えなければ","つかえなければ"],["ならない"],["。"]]},{"verse":3,"text":"彼,かれらは、あなたの務,つとめと、すべての幕屋,まくやの務,つとめとを守,まもらなければならない。ただし、聖所,せいじょの器,うつわと、祭壇,さいだんとに近,ちかづいてはならない。彼,かれらもあなたがたも、死,しぬことのないためである。","tok":[["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["務め","つとめ"],["と"],["、"],["すべて"],["の"],["幕屋","まくや"],["の"],["務め","つとめ"],["と"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["ただし"],["、"],["聖","せい"],["所","しょ"],["の"],["器","うつわ"],["と"],["、"],["祭壇","さいだん"],["と"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["も"],["あなた"],["がた"],["も"],["、"],["死ぬ","しぬ"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"彼,かれらはあなたに連,つらなって、会見,かいけんの幕屋,まくやの務,つとめを守,まもり、幕屋,まくやのもろもろの働,はたらきをしなければならない。ほかの者,ものは、あなたがたに近,ちかづいてはならない。","tok":[["彼","かれ"],["ら"],["は"],["あなた"],["に"],["連なって","つらなって"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["務め","つとめ"],["を"],["守り","まもり"],["、"],["幕屋","まくや"],["の"],["もろもろ"],["の"],["働らき","はたらき"],["を"],["しなければ"],["ならない"],["。"],["ほか"],["の"],["者","もの"],["は"],["、"],["あなた"],["がた"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"このように、あなたがたは、聖所,せいじょの務,つとめと、祭壇,さいだんの務,つとめとを守,まもらなければならない。そうすれば、主,しゅの激,はげしい怒,いかりは、かさねてイスラエルの人々,ひとびとに臨,のぞまないであろう。","tok":[["この"],["よう"],["に"],["、"],["あなた"],["がた"],["は"],["、"],["聖","せい"],["所","しょ"],["の"],["務め","つとめ"],["と"],["、"],["祭壇","さいだん"],["の"],["務め","つとめ"],["と"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["主","しゅ"],["の"],["激しい","はげしい"],["怒り","いかり"],["は"],["、"],["かさねて"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["臨まないで","のぞまないで"],["あろう"],["。"]]},{"verse":6,"text":"わたしはあなたがたの兄弟,きょうだいたるレビびとを、イスラエルの人々,ひとびとのうちから取,とり、主,しゅのために、これを賜物,たまものとして、あなたがたに与,あたえ、会見,かいけんの幕屋,まくやの働,はたらきをさせる。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["兄弟","きょうだい"],["たる"],["レビ"],["びと"],["を"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["から"],["取","とり"],["、"],["主","しゅ"],["の"],["ため"],["に"],["、"],["これ"],["を"],["賜物","たまもの"],["として"],["、"],["あなた"],["がた"],["に"],["与","あたえ"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["働らき","はたらき"],["を"],["させる"],["。"]]},{"verse":7,"text":"あなたとあなたの子,こたちは共,ともに祭司,さいし職,しょくを守,まもって、祭壇,さいだんと、垂幕,たれまくのうちのすべての事,ことを執,とり行,おこない、共,ともに勤,つとめなければならない。わたしは祭司,さいしの職務,しょくむを賜物,たまものとして、あなたがたに与,あたえる。ほかの人,ひとで近,ちかづく者,ものは殺,ころされるであろう」。","tok":[["あなた"],["と"],["あなた"],["の"],["子","こ"],["たち"],["は"],["共","とも"],["に"],["祭司","さいし"],["職","しょく"],["を"],["守って","まもって"],["、"],["祭壇","さいだん"],["と"],["、"],["垂幕","たれまく"],["の"],["うち"],["の"],["すべて"],["の"],["事","こと"],["を"],["執り行ない","とりおこない"],["、"],["共","とも"],["に"],["勤めなければ","つとめなければ"],["ならない"],["。"],["わたし"],["は"],["祭司","さいし"],["の"],["職務","しょくむ"],["を"],["賜物","たまもの"],["として"],["、"],["あなた"],["がた"],["に"],["与える","あたえる"],["。"],["ほか"],["の"],["人","ひと"],["で"],["近づく","ちかづく"],["者","もの"],["は"],["殺ろされるで","ころされるで"],["あろう"],["」"],["。"]]},{"verse":8,"text":"主,しゅはまたアロンに言,いわれた、「わたしはイスラエルの人々,ひとびとの、すべての聖,せいなる供,そなえ物,もので、わたしにささげる物,ものの一部,いちぶをあなたに与,あたえる。すなわち、わたしはこれをあなたと、あなたの子,こたちに、その分,わけ前,まえとして与,あたえ、永久,えいきゅうに受,うくべき分,ぶんとする。","tok":[["主","しゅ"],["は"],["また"],["アロン"],["に"],["言われた","いわれた"],["、"],["「"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["、"],["すべて"],["の"],["聖","せい"],["なる"],["供え物","そなえもの"],["で"],["、"],["わたし"],["に"],["ささげる"],["物","もの"],["の"],["一部","いちぶ"],["を"],["あなた"],["に"],["与える","あたえる"],["。"],["すなわち"],["、"],["わたし"],["は"],["これ"],["を"],["あなた"],["と"],["、"],["あなた"],["の"],["子","こ"],["たち"],["に"],["、"],["その"],["分け前","わけまえ"],["として"],["与","あたえ"],["、"],["永久","えいきゅう"],["に"],["受","う"],["くべき"],["分","ぶん"],["と"],["する"],["。"]]},{"verse":9,"text":"いと聖,せいなる供,そなえ物,もののうち、火,ひで焼,やかずに、あなたに帰,きすべきものは次,つぎのとおりである。すなわち、わたしにささげるすべての供,そなえ物,もの、素祭,そさい、罪祭,ざいさい、愆祭,けんさいはみな、いと聖,せいなる物,ものであって、あなたとあなたの子,こたちに帰,きするであろう。","tok":[["いと"],["聖","せい"],["なる"],["供え物","そなえもの"],["の"],["うち"],["、"],["火","ひ"],["で"],["焼かず","やかず"],["に"],["、"],["あなた"],["に"],["帰","きすべきも"],["の"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["わたし"],["に"],["ささげる"],["すべて"],["の"],["供え物","そなえもの"],["、"],["素","す"],["祭","まつり"],["さい"],["、"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["、"],["愆祭","けんさい"],["は"],["みな"],["、"],["いと"],["聖","せい"],["なる"],["物","もの"],["で"],["あって"],["、"],["あなた"],["と"],["あなた"],["の"],["子","こ"],["たち"],["に"],["帰するで","きするで"],["あろう"],["。"]]},{"verse":10,"text":"いと聖,せいなる所,ところで、それを食,たべなければならない。男子,だんしはみな、それを食,たべることができる。それはあなたに帰,きすべき聖,せいなる物,ものである。","tok":[["いと"],["聖","せい"],["なる"],["所","ところ"],["で"],["、"],["それ"],["を"],["食べなければ","たべなければ"],["ならない"],["。"],["男子","だんし"],["は"],["みな"],["、"],["それ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"],["それ"],["は"],["あなた"],["に"],["帰すべき","きすべき"],["聖","せい"],["なる"],["物","もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"またあなたに帰,きすべきものはこれである。すなわち、イスラエルの人々,ひとびとのささげる供,そなえ物,もののうち、すべて揺祭,ようさいとするものであって、これをあなたとあなたのむすこ娘,むすめに与,あたえて、永久,えいきゅうに受,うくべき分,ぶんとする。あなたの家,いえの者,もののうち、清,きよい者,ものはみな、これを食,たべることができる。","tok":[["また"],["あなた"],["に"],["帰","きすべきも"],["の"],["は"],["これ"],["で"],["ある"],["。"],["すなわち"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ささげる"],["供え物","そなえもの"],["の"],["うち"],["、"],["すべて"],["揺祭","ようさい"],["と"],["する"],["もの"],["で"],["あって"],["、"],["これ"],["を"],["あなた"],["と"],["あなた"],["の"],["むすこ"],["娘","むすめ"],["に"],["与","あたえ"],["て"],["、"],["永久","えいきゅう"],["に"],["受","う"],["くべき"],["分","ぶん"],["と"],["する"],["。"],["あなた"],["の"],["家","いえ"],["の"],["者","もの"],["の"],["うち"],["、"],["清い","きよい"],["者","もの"],["は"],["みな"],["、"],["これ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":12,"text":"すべて油,あぶらの最,もっともよい物,もの、およびすべて新,あたらしいぶどう酒,しゅと、穀物,こくもつの最,もっとも良,よい物,ものなど、人々,ひとびとが主,しゅにささげる初穂,はつほをあなたに与,あたえる。","tok":[["すべて"],["油","あぶら"],["の"],["最も","もっとも"],["よい"],["物","もの"],["、"],["および"],["すべて"],["新らしい","あたらしい"],["ぶどう酒","ぶどうしゅ"],["と"],["、"],["穀物","こくもつ"],["の"],["最も","もっとも"],["良い","よい"],["物","もの"],["など"],["、"],["人々","ひとびと"],["が"],["主に","しゅに"],["ささげる"],["初穂","はつほ"],["を"],["あなた"],["に"],["与える","あたえる"],["。"]]},{"verse":13,"text":"国,くにのすべての産物,さんぶつの初物,はつもので、人々,ひとびとが主,しゅのもとに携,たずさえてきたものは、あなたに帰,きするであろう。あなたの家,いえの者,もののうち、清,きよい者,ものはみな、これを食,たべることができる。","tok":[["国","くに"],["の"],["すべて"],["の"],["産物","さんぶつ"],["の"],["初物","はつもの"],["で"],["、"],["人々","ひとびと"],["が"],["主","しゅ"],["の"],["もと"],["に"],["携えて","たずさえて"],["きた"],["もの"],["は"],["、"],["あなた"],["に"],["帰するで","きするで"],["あろう"],["。"],["あなた"],["の"],["家","いえ"],["の"],["者","もの"],["の"],["うち"],["、"],["清い","きよい"],["者","もの"],["は"],["みな"],["、"],["これ"],["を"],["食べる","たべる"],["こと"],["が"],["できる"],["。"]]},{"verse":14,"text":"イスラエルのうちの奉納物,ほうのうぶつはみな、あなたに帰,きする。","tok":[["イスラエル"],["の"],["うち"],["の"],["奉納物","ほうのうぶつ"],["は"],["みな"],["、"],["あなた"],["に"],["帰する","きする"],["。"]]},{"verse":15,"text":"すべて肉,にくなる者,もののういごであって、主,しゅにささげられる者,ものはみな、人,ひとでも獣,けものでも、あなたに帰,きする。ただし、人,ひとのういごは必,かならずあがなわなければならない。また汚,けがれた獣,けもののういごも、あがなわなければならない。","tok":[["すべて"],["肉","にく"],["なる"],["者","もの"],["の"],["うい"],["ご"],["で"],["あって"],["、"],["主に","しゅに"],["ささげられる"],["者","もの"],["は"],["みな"],["、"],["人","ひと"],["で"],["も"],["獣","けもの"],["で"],["も"],["、"],["あなた"],["に"],["帰する","きする"],["。"],["ただし"],["、"],["人","ひと"],["の"],["うい"],["ご"],["は"],["必","かならず"],["あがなわなければ"],["ならない"],["。"],["また"],["汚","け"],["がれ"],["た"],["獣","けもの"],["の"],["うい"],["ご"],["も"],["、"],["あがなわなければ"],["ならない"],["。"]]},{"verse":16,"text":"人,ひとのういごは生後,せいご一か月,げつで、あがなわなければならない。そのあがない金,きんはあなたの値,ね積,づもりにより、聖所,せいじょのシケルにしたがって、銀,ぎん五シケルでなければならない。一シケルは二十ゲラである。","tok":[["人","ひと"],["の"],["うい"],["ご"],["は"],["生後","せいご"],["一","いち"],["か月","かげつ"],["で"],["、"],["あがなわなければ"],["ならない"],["。"],["その"],["あがない"],["金","きん"],["は"],["あなた"],["の"],["値","ね"],["積","づもり"],["に"],["より"],["、"],["聖","せい"],["所","しょ"],["の"],["シケル"],["に"],["したがって"],["、"],["銀","ぎん"],["五","ご"],["シケル"],["で"],["なければ"],["ならない"],["。"],["一","いち"],["シケル"],["は"],["二十","にじゅう"],["ゲラ"],["で"],["ある"],["。"]]},{"verse":17,"text":"しかし、牛,うしのういご、羊,ひつじのういご、やぎのういごは、あがなってはならない。これらは聖,せいなるものである。その血,ちを祭壇,さいだんに注,そそぎかけ、その脂肪,しぼうを焼,やいて火祭,かさいとし、香,こうばしいかおりとして、主,しゅにささげなければならない。","tok":[["しかし"],["、"],["牛","うし"],["の"],["うい"],["ご"],["、"],["羊","ひつじ"],["の"],["うい"],["ご"],["、"],["やぎ"],["の"],["うい"],["ご"],["は"],["、"],["あがなって"],["は"],["ならない"],["。"],["これ"],["ら"],["は"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["。"],["その"],["血","ち"],["を"],["祭壇","さいだん"],["に"],["注ぎ","そそぎ"],["かけ"],["、"],["その"],["脂肪","しぼう"],["を"],["焼いて","やいて"],["火祭","か"],["さい"],["と"],["し"],["、"],["香ばしい","こうばしい"],["かおり"],["として"],["、"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":18,"text":"その肉,にくはあなたに帰,きする。それは揺祭,ようさいの胸,むねや右,みぎのももと同,おなじく、あなたに帰,きする。","tok":[["その"],["肉","にく"],["は"],["あなた"],["に"],["帰する","きする"],["。"],["それ"],["は"],["揺祭","ようさい"],["の"],["胸","むね"],["や"],["右","みぎ"],["の"],["もも"],["と"],["同じく","おなじく"],["、"],["あなた"],["に"],["帰する","きする"],["。"]]},{"verse":19,"text":"イスラエルの人々,ひとびとが、主,しゅにささげる聖,せいなる供,そなえ物,ものはみな、あなたとあなたのむすこ娘,むすめとに与,あたえて、永久,えいきゅうに受,うける分,ぶんとする。これは主,しゅの前,まえにあって、あなたとあなたの子孫,しそんとに対,たいし、永遠,えいえんに変,かわらぬ塩,しおの契約,けいやくである」。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["主に","しゅに"],["ささげる"],["聖","せい"],["なる"],["供え物","そなえもの"],["は"],["みな"],["、"],["あなた"],["と"],["あなた"],["の"],["むすこ"],["娘","むすめ"],["と"],["に"],["与","あたえ"],["て"],["、"],["永久","えいきゅう"],["に"],["受る","うける"],["分","ぶん"],["と"],["する"],["。"],["これ"],["は"],["主","しゅ"],["の"],["前","まえ"],["に"],["あって"],["、"],["あなた"],["と"],["あなた"],["の"],["子孫","しそん"],["と"],["に"],["対し","たいし"],["、"],["永遠","えいえん"],["に"],["変わらぬ","かわらぬ"],["塩","しお"],["の"],["契約","けいやく"],["で"],["ある"],["」"],["。"]]},{"verse":20,"text":"主,しゅはまたアロンに言,いわれた、「あなたはイスラエルの人々,ひとびとの地,ちのうちに、嗣,し業,ぎょうをもってはならない。また彼,かれらのうちに、何,なにの分,ぶんをも持,もってはならない。彼,かれらのうちにあって、わたしがあなたの分,ぶんであり、あなたの嗣,し業,ぎょうである。","tok":[["主","しゅ"],["は"],["また"],["アロン"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["地","ち"],["の"],["うち"],["に"],["、"],["嗣業","しぎょう"],["を"],["もって"],["は"],["ならない"],["。"],["また"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["、"],["何","なに"],["の"],["分","ぶん"],["を"],["も"],["持って","もって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["あって"],["、"],["わたし"],["が"],["あなた"],["の"],["分","ぶん"],["で"],["あり"],["、"],["あなた"],["の"],["嗣業","しぎょ"],["うで"],["ある"],["。"]]},{"verse":21,"text":"わたしはレビの子孫,しそんにはイスラエルにおいて、すべて十分,ぶんの一を嗣,し業,ぎょうとして与,あたえ、その働,はたらき、すなわち、会見,かいけんの幕屋,まくやの働,はたらきに報,むくいる。","tok":[["わたし"],["は"],["レビ"],["の"],["子孫","しそん"],["に"],["は"],["イスラエル"],["に"],["おいて"],["、"],["すべて"],["十分","ぶん"],["の"],["一","いち"],["を"],["嗣業","しぎょう"],["として"],["与","あたえ"],["、"],["その"],["働らき","はたらき"],["、"],["すなわち"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["働らき","はたらき"],["に"],["報いる","むくいる"],["。"]]},{"verse":22,"text":"イスラエルの人々,ひとびとは、かさねて会見,かいけんの幕屋,まくやに近,ちかづいてはならない。罪,つみを得,えて死,しなないためである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["かさねて"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"],["罪","つみ"],["を"],["得て","えて"],["死なない","しなない"],["ため"],["で"],["ある"],["。"]]},{"verse":23,"text":"レビびとだけが会見,かいけんの幕屋,まくやの働,はたらきをしなければならない。彼,かれらがその罪,つみを負,おうであろう。彼,かれらがイスラエルの人々,ひとびとのうちに、嗣,し業,ぎょうの地,ちを持,もたないことをもって、あなたがたの代々,よよながく守,まもるべき定,さだめとしなければならない。","tok":[["レビ"],["びと"],["だけ"],["が"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["働らき","はたらき"],["を"],["しなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["が"],["その"],["罪","つみ"],["を"],["負うで","おうで"],["あろう"],["。"],["彼","かれ"],["ら"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["、"],["嗣業","しぎょう"],["の"],["地","ち"],["を"],["持たない","もたない"],["こと"],["を"],["もって"],["、"],["あなた"],["がた"],["の"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定め","さだめ"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":24,"text":"わたしはイスラエルの人々,ひとびとが供,そなえ物,ものとして主,しゅにささげる十分,ぶんの一を、レビびとに嗣,し業,ぎょうとして与,あたえた。それで『彼,かれらはイスラエルの人々,ひとびとのうちに、嗣,し業,ぎょうの地,ちを持,もってはならない』と、わたしは彼,かれらに言,いったのである」。","tok":[["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["供え物","そなえもの"],["として"],["主に","しゅに"],["ささげる"],["十分","ぶん"],["の"],["一","いち"],["を"],["、"],["レビ"],["びと"],["に"],["嗣業","しぎょう"],["として"],["与","あたえ"],["た"],["。"],["それ"],["で"],["『"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["、"],["嗣業","しぎょう"],["の"],["地","ち"],["を"],["持って","もって"],["は"],["ならない"],["』"],["と"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["ので"],["ある"],["」"],["。"]]},{"verse":25,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":26,"text":"「レビびとに言,いいなさい、『わたしがイスラエルの人々,ひとびとから取,とって、嗣,し業,ぎょうとして与,あたえる十分,ぶんの一を受,うける時,とき、あなたがたはその十分,ぶんの一の十分,ぶんの一を、主,しゅにささげなければならない。","tok":[["「"],["レビ"],["びと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["から"],["取って","とって"],["、"],["嗣業","しぎょう"],["として"],["与える","あたえる"],["十分","ぶん"],["の"],["一","いち"],["を"],["受る","うける"],["時","とき"],["、"],["あなた"],["がた"],["は"],["その"],["十分","ぶん"],["の"],["一","いち"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["、"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":27,"text":"あなたがたのささげ物,ものは、打,うち場,ばからの穀物,こくもつや、酒,さかぶねからのぶどう酒,しゅと同,おなじように見,みなされるであろう。","tok":[["あなた"],["がた"],["の"],["ささげ物","ささげもの"],["は"],["、"],["打ち","うち"],["場","ば"],["から"],["の"],["穀物","こくもつ"],["や"],["、"],["酒","さかぶねか"],["ら"],["の"],["ぶどう酒","ぶどうしゅ"],["と"],["同じ","おなじ"],["よう"],["に"],["見なされるで","みなされるで"],["あろう"],["。"]]},{"verse":28,"text":"そのようにあなたがたもまた、イスラエルの人々,ひとびとから受,うけるすべての十分,ぶんの一の物,もののうちから、主,しゅに供,そなえ物,ものをささげ、主,しゅにささげたその供,そなえ物,ものを、祭司,さいしアロンに与,あたえなければならない。","tok":[["その"],["よう"],["に"],["あなた"],["がた"],["も"],["また"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["から"],["受ける","うける"],["すべて"],["の"],["十分","ぶん"],["の"],["一","いち"],["の"],["物","もの"],["の"],["うち"],["から"],["、"],["主に","しゅに"],["供え物","そなえもの"],["を"],["ささげ"],["、"],["主に","しゅに"],["ささげた"],["その"],["供え物","そなえもの"],["を"],["、"],["祭司","さいし"],["アロン"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":29,"text":"あなたがたの受,うけるすべての贈物,もののうちから、その良,よいところ、すなわち、聖,せいなる部分,ぶぶんを取,とって、ことごとく供,そなえ物,ものとして、主,しゅにささげなければならない』。","tok":[["あなた"],["がた"],["の"],["受ける","うける"],["すべて"],["の"],["贈物","も"],["の"],["の"],["うち"],["から"],["、"],["その"],["良い","よい"],["ところ"],["、"],["すなわち"],["、"],["聖","せい"],["なる"],["部分","ぶぶん"],["を"],["取って","とって"],["、"],["ことごとく"],["供え物","そなえもの"],["として"],["、"],["主に","しゅに"],["ささげなければ"],["ならない"],["』"],["。"]]},{"verse":30,"text":"あなたはまた彼,かれらに言,いいなさい、『あなたがたが、そのうちから良,よいところを取,とってささげる時,とき、その残,のこりの部分,ぶぶんはレビびとには、打,うち場,ばの産物,さんぶつや、酒,さかぶねの産物,さんぶつと同,おなじように見,みなされるであろう。","tok":[["あなた"],["は"],["また"],["彼","かれ"],["ら"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["が"],["た"],["が"],["、"],["その"],["うち"],["から"],["良い","よい"],["ところ"],["を"],["取って","とって"],["ささげる"],["時","とき"],["、"],["その"],["残り","のこり"],["の"],["部分","ぶぶん"],["は"],["レビ"],["びと"],["に"],["は"],["、"],["打ち","うち"],["場","ば"],["の"],["産物","さんぶつ"],["や"],["、"],["酒","さかぶね"],["の"],["産物","さんぶつ"],["と"],["同じ","おなじ"],["よう"],["に"],["見なされるで","みなされるで"],["あろう"],["。"]]},{"verse":31,"text":"あなたがたと、あなたがたの家族,かぞくとは、どこでそれを食,たべてもよい。これは会見,かいけんの幕屋,まくやであなたがたがする働,はたらきの報酬,ほうしゅうである。","tok":[["あなた"],["がた"],["と"],["、"],["あなた"],["がた"],["の"],["家族","かぞく"],["と"],["は"],["、"],["どこ"],["で"],["それ"],["を"],["食べて","たべて"],["も"],["よい"],["。"],["これ"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["で"],["あなた"],["がた"],["が"],["する"],["働らき","はたらき"],["の"],["報酬","ほうしゅう"],["で"],["ある"],["。"]]},{"verse":32,"text":"あなたがたが、その良,よいところをささげるときは、それによって、あなたがたは罪,つみを負,おわないであろう。あなたがたはイスラエルの人々,ひとびとの聖,せいなる供,そなえ物,ものを汚,けがしてはならない。死,しをまぬかれるためである』」。","tok":[["あなた"],["が"],["た"],["が"],["、"],["その"],["良い","よい"],["ところ"],["を"],["ささげる"],["とき"],["は"],["、"],["それ"],["によって"],["、"],["あなた"],["がた"],["は"],["罪","つみ"],["を"],["負わないで","おわないで"],["あろう"],["。"],["あなた"],["がた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["聖","せい"],["なる"],["供え物","そなえもの"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["死","し"],["を"],["まぬかれる"],["ため"],["で"],["ある"],["』"],["」"],["。"]]}]
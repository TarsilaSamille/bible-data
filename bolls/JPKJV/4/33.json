[{"verse":1,"text":"イスラエルの人々,ひとびとが、モーセとアロンとに導,みちびかれ、その部隊,ぶたいに従,したがって、エジプトの国,くにを出,でてから経,へた旅路,たびじは次,つぎのとおりである。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["モーセ"],["と"],["アロン"],["と"],["に"],["導かれ","みちびかれ"],["、"],["その"],["部隊","ぶたい"],["に"],["従って","したがって"],["、"],["エジプト"],["の"],["国","くに"],["を"],["出て","でて"],["から"],["経た","へた"],["旅路","たびじ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":2,"text":"モーセは主,しゅの命,めいにより、その旅路,たびじにしたがって宿駅,しゅくえきを書,かきとめた。その宿駅,しゅくえきにしたがえば旅路,たびじは次,つぎのとおりである。","tok":[["モーセ"],["は"],["主","しゅ"],["の"],["命","めい"],["に"],["より"],["、"],["その"],["旅路","たびじ"],["に"],["したがって"],["宿駅","しゅくえき"],["を"],["書きとめた","かきとめた"],["。"],["その"],["宿駅","しゅくえき"],["に"],["したがえば"],["旅路","たびじ"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"]]},{"verse":3,"text":"彼,かれらは正月,しょうがつの十五日,にちにラメセスを出立,しゅったつした。すなわち過越,すぎこしの翌日,よくじつイスラエルの人々,ひとびとは、すべてのエジプトびとの目,めの前,まえを意気揚々,いきようようと出立,しゅったつした。","tok":[["彼","かれ"],["ら"],["は"],["正月","しょうがつ"],["の"],["十五","じゅうご"],["日","にち"],["に"],["ラメセス"],["を"],["出立","しゅったつ"],["した"],["。"],["すなわち"],["過越","すぎこし"],["の"],["翌日","よくじつ"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["、"],["すべて"],["の"],["エジプト"],["びと"],["の"],["目","め"],["の"],["前","まえ"],["を"],["意気","いき"],["揚々","ようよう"],["と"],["出立","しゅったつ"],["した"],["。"]]},{"verse":4,"text":"その時,ときエジプトびとは、主,しゅに撃,うち殺,ころされたすべてのういごを葬,ほうむっていた。主,しゅはまた彼,かれらの神々,かみがみにも罰,ばつを加,くわえられた。","tok":[["その"],["時","とき"],["エジプト"],["び"],["と"],["は"],["、"],["主に","しゅに"],["撃ち","うち"],["殺ろ","ころ"],["された"],["すべて"],["の"],["うい"],["ご"],["を"],["葬むって","ほうむって"],["いた"],["。"],["主","しゅ"],["は"],["また"],["彼","かれ"],["ら"],["の"],["神々","かみがみ"],["に"],["も"],["罰","ばつ"],["を"],["加えられた","くわえられた"],["。"]]},{"verse":5,"text":"こうしてイスラエルの人々,ひとびとはラメセスを出立,しゅったつしてスコテに宿営,しゅくえいし、","tok":[["こう"],["して"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["ラメセス"],["を"],["出立","しゅったつ"],["して"],["スコテ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":6,"text":"スコテを出立,しゅったつして荒野,あらのの端,はしにあるエタムに宿営,しゅくえいし、","tok":[["スコテ"],["を"],["出立","しゅったつ"],["して"],["荒野","あら"],["の"],["の"],["端","はし"],["に"],["ある"],["エタム"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":7,"text":"エタムを出立,しゅったつしてバアル・ゼポンの前,まえにあるピハヒロテに引,ひき返,かえしてミグドルの前,まえに宿営,しゅくえいし、","tok":[["エタム"],["を"],["出立","しゅったつ"],["して"],["バアル"],["・"],["ゼポン"],["の"],["前","まえ"],["に"],["ある"],["ピハヒロテ"],["に"],["引","ひき"],["返","かえし"],["て"],["ミグドル"],["の"],["前","まえ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":8,"text":"ピハヒロテを出立,しゅったつして、海,うみのなかをとおって荒野,あらのに入,いり、エタムの荒野,あらのを三日,か路,じほど行,いって、メラに宿営,しゅくえいし、","tok":[["ピハヒロテ"],["を"],["出立","しゅったつ"],["して"],["、"],["海","うみ"],["の"],["なか"],["を"],["とおって"],["荒野","あら"],["のに"],["入","いり"],["、"],["エタム"],["の"],["荒野","あらの"],["を"],["三日路","かじ"],["ほど"],["行って","いって"],["、"],["メラ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":9,"text":"メラを出立,しゅったつし、エリムに行,いって宿営,しゅくえいした。エリムには水,みずの泉,いずみ十二と、なつめやし七十本,ほんとがあった。","tok":[["メラ"],["を"],["出立","しゅったつ"],["し"],["、"],["エリム"],["に"],["行って","いって"],["宿営","しゅくえい"],["した"],["。"],["エリム"],["に"],["は"],["水","みず"],["の"],["泉","いずみ"],["十二","じゅうに"],["と"],["、"],["なつめやし"],["七十本","ほんと"],["が"],["あった"],["。"]]},{"verse":10,"text":"エリムを出立,しゅったつして紅海,こうかいのほとりに宿営,しゅくえいし、","tok":[["エリム"],["を"],["出立","しゅったつ"],["して"],["紅海","こうかい"],["の"],["ほとり"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":11,"text":"紅海,こうかいを出立,しゅったつしてシンの荒野,あらのに宿営,しゅくえいし、","tok":[["紅海","こうかい"],["を"],["出立","しゅったつ"],["して"],["シン"],["の"],["荒野","あらの"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":12,"text":"シンの荒野,あらのを出立,しゅったつしてドフカに宿営,しゅくえいし、","tok":[["シン"],["の"],["荒野","あらの"],["を"],["出立","しゅったつ"],["して"],["ドフカ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":13,"text":"ドフカを出立,しゅったつしてアルシに宿営,しゅくえいし、","tok":[["ドフカ"],["を"],["出立","しゅったつ"],["して"],["アルシ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":14,"text":"アルシを出立,しゅったつしてレピデムに宿営,しゅくえいした。そこには民,たみの飲,のむ水,みずがなかった。","tok":[["アルシ"],["を"],["出立","しゅったつ"],["して"],["レピデム"],["に"],["宿営","しゅくえい"],["した"],["。"],["そこ"],["に"],["は"],["民","たみ"],["の"],["飲む","のむ"],["水","みず"],["が"],["なかった"],["。"]]},{"verse":15,"text":"レピデムを出立,しゅったつしてシナイの荒野,あらのに宿営,しゅくえいし、","tok":[["レピデム"],["を"],["出立","しゅったつ"],["して"],["シナイ"],["の"],["荒野","あらの"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":16,"text":"シナイの荒野,あらのを出立,しゅったつしてキブロテ・ハッタワに宿営,しゅくえいし、","tok":[["シナイ"],["の"],["荒野","あらの"],["を"],["出立","しゅったつ"],["して"],["キブロテ"],["・"],["ハッタワ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":17,"text":"キブロテ・ハッタワを出立,しゅったつしてハゼロテに宿営,しゅくえいし、","tok":[["キブロテ"],["・"],["ハッタワ"],["を"],["出立","しゅったつ"],["して"],["ハゼロテ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":18,"text":"ハゼロテを出立,しゅったつしてリテマに宿営,しゅくえいし、","tok":[["ハゼロテ"],["を"],["出立","しゅったつ"],["して"],["リテマ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":19,"text":"リテマを出立,しゅったつしてリンモン・パレツに宿営,しゅくえいし、","tok":[["リテマ"],["を"],["出立","しゅったつ"],["して"],["リンモン"],["・"],["パレツ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":20,"text":"リンモン・パレツを出立,しゅったつしてリブナに宿営,しゅくえいし、","tok":[["リンモン"],["・"],["パレツ"],["を"],["出立","しゅったつ"],["して"],["リブナ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":21,"text":"リブナを出立,しゅったつしてリッサに宿営,しゅくえいし、","tok":[["リブナ"],["を"],["出立","しゅったつ"],["して"],["リッサ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":22,"text":"リッサを出立,しゅったつしてケヘラタに宿営,しゅくえいし、","tok":[["リッサ"],["を"],["出立","しゅったつ"],["して"],["ケヘラタ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":23,"text":"ケヘラタを出立,しゅったつしてシャペル山,やまに宿営,しゅくえいし、","tok":[["ケヘラタ"],["を"],["出立","しゅったつ"],["して"],["シャペル"],["山","やま"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":24,"text":"シャペル山,やまを出立,しゅったつしてハラダに宿営,しゅくえいし、","tok":[["シャペル"],["山","やま"],["を"],["出立","しゅったつ"],["して"],["ハラダ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":25,"text":"ハラダを出立,しゅったつしてマケロテに宿営,しゅくえいし、","tok":[["ハラダ"],["を"],["出立","しゅったつ"],["して"],["マケロテ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":26,"text":"マケロテを出立,しゅったつしてタハテに宿営,しゅくえいし、","tok":[["マケロテ"],["を"],["出立","しゅったつ"],["して"],["タハテ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":27,"text":"タハテを出立,しゅったつしてテラに宿営,しゅくえいし、","tok":[["タハテ"],["を"],["出立","しゅったつ"],["して"],["テラ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":28,"text":"テラを出立,しゅったつしてミテカに宿営,しゅくえいし、","tok":[["テラ"],["を"],["出立","しゅったつ"],["して"],["ミテカ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":29,"text":"ミテカを出立,しゅったつしてハシモナに宿営,しゅくえいし、","tok":[["ミテカ"],["を"],["出立","しゅったつ"],["して"],["ハシモナ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":30,"text":"ハシモナを出立,しゅったつしてモセラに宿営,しゅくえいし、","tok":[["ハシモナ"],["を"],["出立","しゅったつ"],["して"],["モセラ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":31,"text":"モセラを出立,しゅったつしてベネヤカンに宿営,しゅくえいし、","tok":[["モセラ"],["を"],["出立","しゅったつ"],["して"],["ベネヤカン"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":32,"text":"ベネヤカンを出立,しゅったつしてホル・ハギデガデに宿営,しゅくえいし、","tok":[["ベネヤカン"],["を"],["出立","しゅったつ"],["して"],["ホル"],["・"],["ハギデガデ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":33,"text":"ホル・ハギデガデを出立,しゅったつしてヨテバタに宿営,しゅくえいし、","tok":[["ホル"],["・"],["ハギデガデ"],["を"],["出立","しゅったつ"],["して"],["ヨテバタ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":34,"text":"ヨテバタを出立,しゅったつしてアブロナに宿営,しゅくえいし、","tok":[["ヨテバタ"],["を"],["出立","しゅったつ"],["して"],["アブロナ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":35,"text":"アブロナを出立,しゅったつしてエジオン・ゲベルに宿営,しゅくえいし、","tok":[["アブロナ"],["を"],["出立","しゅったつ"],["して"],["エジオン"],["・"],["ゲベル"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":36,"text":"エジオン・ゲベルを出立,しゅったつしてチンの荒野,あらのすなわちカデシに宿営,しゅくえいし、","tok":[["エジオン"],["・"],["ゲベル"],["を"],["出立","しゅったつ"],["して"],["チン"],["の"],["荒野","あら"],["の"],["すなわち"],["カデシ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":37,"text":"カデシを出立,しゅったつしてエドムの国,くにの端,はしにあるホル山,やまに宿営,しゅくえいした。","tok":[["カデシ"],["を"],["出立","しゅったつ"],["して"],["エドム"],["の"],["国","くに"],["の"],["端","はし"],["に"],["ある"],["ホル"],["山","やま"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":38,"text":"イスラエルの人々,ひとびとがエジプトの国,くにを出,でて四十年,ねん目,めの五月,がつ一日,にちに、祭司,さいしアロンは主,しゅの命,めいによりホル山,やまに登,のぼって、その所,ところで死,しんだ。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["エジプト"],["の"],["国","くに"],["を"],["出て","でて"],["四十","よんじゅう"],["年目","年め"],["の"],["五","ご"],["月","がつ"],["つ"],["一","いち"],["日","にち"],["に"],["、"],["祭司","さいし"],["アロン"],["は"],["主","しゅ"],["の"],["命","めい"],["に"],["より"],["ホル"],["山","やま"],["に"],["登って","のぼって"],["、"],["その"],["所","ところ"],["で"],["死んだ","しんだ"],["。"]]},{"verse":39,"text":"アロンはホル山,やまで死,しんだとき百二十三歳,さいであった。","tok":[["アロン"],["は"],["ホル"],["山","やま"],["で"],["死んだ","しんだ"],["とき"],["百二十三","ひゃくにじゅうさん"],["歳","さい"],["いで"],["あった"],["。"]]},{"verse":40,"text":"カナンの地,ちのネゲブに住,すんでいたカナンびとアラデの王,おうは、イスラエルの人々,ひとびとの来,くるのを聞,きいた。","tok":[["カナン"],["の"],["地","ち"],["の"],["ネゲブ"],["に"],["住んで","すんで"],["いた"],["カナン"],["びと"],["アラデ"],["の"],["王","おう"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["来る","くる"],["の"],["を"],["聞いた","きいた"],["。"]]},{"verse":41,"text":"ついで、ホル山,やまを出立,しゅったつしてザルモナに宿営,しゅくえいし、","tok":[["つい"],["で"],["、"],["ホル"],["山","やま"],["を"],["出立","しゅったつ"],["して"],["ザルモナ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":42,"text":"ザルモナを出立,しゅったつしてプノンに宿営,しゅくえいし、","tok":[["ザルモナ"],["を"],["出立","しゅったつ"],["して"],["プノン"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":43,"text":"プノンを出立,しゅったつしてオボテに宿営,しゅくえいし、","tok":[["プノン"],["を"],["出立","しゅったつ"],["して"],["オボテ"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":44,"text":"オボテを出立,しゅったつしてモアブの境,さかいにあるイエ・アバリムに宿営,しゅくえいし、","tok":[["オボテ"],["を"],["出立","しゅったつ"],["して"],["モアブ"],["の"],["境","さかい"],["に"],["ある"],["イエ"],["・"],["アバリム"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":45,"text":"イエ・アバリムを出立,しゅったつしてデボン・ガドに宿営,しゅくえいし、","tok":[["イエ"],["・"],["アバリム"],["を"],["出立","しゅったつ"],["して"],["デボン"],["・"],["ガド"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":46,"text":"デボン・ガドを出立,しゅったつしてアルモン・デブラタイムに宿営,しゅくえいし、","tok":[["デボン"],["・"],["ガド"],["を"],["出立","しゅったつ"],["して"],["アルモン"],["・"],["デブラ"],["タイム"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":47,"text":"アルモン・デブラタイムを出立,しゅったつしてネボの前,まえにあるアバリムの山,やまに宿営,しゅくえいし、","tok":[["アルモン"],["・"],["デブラ"],["タイム"],["を"],["出立","しゅったつ"],["して"],["ネボ"],["の"],["前","まえ"],["に"],["ある"],["アバリム"],["の"],["山","やま"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":48,"text":"アバリムの山,やまを出立,しゅったつしてエリコに近,ちかいヨルダンのほとりのモアブの平野,へいやに宿営,しゅくえいした。","tok":[["アバリム"],["の"],["山","やま"],["を"],["出立","しゅったつ"],["して"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["の"],["ほとり"],["の"],["モアブ"],["の"],["平野","へいや"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":49,"text":"すなわちヨルダンのほとりのモアブの平野,へいやで、ベテエシモテとアベル・シッテムとの間,あいだに宿営,しゅくえいした。","tok":[["すなわち"],["ヨルダン"],["の"],["ほとり"],["の"],["モアブ"],["の"],["平野","へいや"],["で"],["、"],["ベテエシモテ"],["と"],["アベル"],["・"],["シッテム"],["と"],["の"],["間","あいだ"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":50,"text":"エリコに近,ちかいヨルダンのほとりのモアブの平野,へいやで、主,しゅはモーセに言,いわれた、","tok":[["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["の"],["ほとり"],["の"],["モアブ"],["の"],["平野","へいや"],["で"],["、"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":51,"text":"「イスラエルの人々,ひとびとに言,いいなさい。あなたがたがヨルダンを渡,わたってカナンの地,ちにはいるときは、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["。"],["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡って","わたって"],["カナン"],["の"],["地","ち"],["に"],["は"],["いる"],["とき"],["は"],["、"]]},{"verse":52,"text":"その地,ちの住民,じゅうみんをことごとくあなたがたの前,まえから追,おい払,はらい、すべての石像,せきぞうをこぼち、すべての鋳,い像,ぞうをこぼち、すべての高,たかき所,ところを破壊,はかいしなければならない。","tok":[["その"],["地","ち"],["の"],["住民","じゅうみん"],["を"],["ことごとく"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["追い払","おいはらい"],["、"],["すべて"],["の"],["石像","せきぞう"],["を"],["こ"],["ぼ"],["ち"],["、"],["すべて"],["の"],["鋳像","いぞう"],["を"],["こ"],["ぼ"],["ち"],["、"],["すべて"],["の"],["高き","たかき"],["所","ところ"],["を"],["破壊","はかい"],["しなければ"],["ならない"],["。"]]},{"verse":53,"text":"またあなたがたはその地,ちの民,たみを追,おい払,はらって、そこに住,すまなければならない。わたしがその地,ちをあなたがたの所有,しょゆうとして与,あたえたからである。","tok":[["また"],["あなた"],["がた"],["は"],["その"],["地","ち"],["の"],["民","たみ"],["を"],["追い払って","おいはらって"],["、"],["そこ"],["に"],["住まなければ","すまなければ"],["ならない"],["。"],["わたし"],["が"],["その"],["地","ち"],["を"],["あなた"],["がた"],["の"],["所有","しょゆう"],["として"],["与えた","あたえた"],["から"],["で"],["ある"],["。"]]},{"verse":54,"text":"あなたがたは、おのおの氏族,しぞくごとにくじを引,ひき、その地,ちを分,わけて嗣,し業,ぎょうとしなければならない。大,おおきい部族,ぶぞくには多,おおくの嗣,し業,ぎょうを与,あたえ、小,ちいさい部族,ぶぞくには少,すこしの嗣,し業,ぎょうを与,あたえなければならない。そのくじの当,あたった所,ところがその所有,しょゆうとなるであろう。あなたがたは父祖,ふその部族,ぶぞくにしたがって、それを継,つがなければならない。","tok":[["あなた"],["がた"],["は"],["、"],["おのおの"],["氏族","しぞく"],["ごと"],["に"],["くじ"],["を"],["引","ひき"],["、"],["その"],["地","ち"],["を"],["分けて","わけて"],["嗣業","しぎょう"],["と"],["しなければ"],["ならない"],["。"],["大きい","おおきい"],["部族","ぶぞく"],["に"],["は"],["多く","おおく"],["の"],["嗣業","しぎょう"],["を"],["与","あたえ"],["、"],["小さい","ちいさい"],["部族","ぶぞく"],["に"],["は"],["少し","すこし"],["の"],["嗣業","しぎょう"],["を"],["与えなければ","あたえなければ"],["ならない"],["。"],["その"],["くじ"],["の"],["当たった","あたった"],["所","ところ"],["が"],["その"],["所有","しょゆう"],["と"],["なるで"],["あろう"],["。"],["あなた"],["がた"],["は"],["父祖","ふそ"],["の"],["部族","ぶぞく"],["に"],["したがって"],["、"],["それ"],["を"],["継がなければ","つがなければ"],["ならない"],["。"]]},{"verse":55,"text":"しかし、その地,ちの住民,じゅうみんをあなたがたの前,まえから追,おい払,はらわないならば、その残,のこして置,おいた者,ものはあなたがたの目,めにとげとなり、あなたがたの脇,わきにいばらとなり、あなたがたの住,すむ国,くににおいて、あなたがたを悩,なやますであろう。","tok":[["しかし"],["、"],["その"],["地","ち"],["の"],["住民","じゅうみん"],["を"],["あなた"],["がた"],["の"],["前","まえ"],["から"],["追い払わないならば","おいはらわないならば"],["、"],["その"],["残して","のこして"],["置いた","おいた"],["者","もの"],["は"],["あなた"],["がた"],["の"],["目","め"],["に"],["とげ"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["脇","わき"],["に"],["いばら"],["と"],["なり"],["、"],["あなた"],["がた"],["の"],["住む","すむ"],["国","くに"],["に"],["おいて"],["、"],["あなた"],["がた"],["を"],["悩すで","なやますで"],["あろう"],["。"]]},{"verse":56,"text":"また、わたしは彼,かれらにしようと思,おもったとおりに、あなたがたにするであろう」。","tok":[["また"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["しよう"],["と"],["思った","おもった"],["とおり"],["に"],["、"],["あなた"],["がた"],["に"],["するで"],["あろう"],["」"],["。"]]}]
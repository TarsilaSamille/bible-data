"],["アルデ"],["から"],["アルデ"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"],["ナアマン"],["から"],["ナアマン"],["びと"],["の"],["氏族","しぞく"],["が"],["出た","でた"],["。"]]},{"verse":41,"text":"これらはベニヤミンの子孫,しそんであって、その氏族,しぞくによれば数,かぞえられた者,ものは四万五千六百人,にんであった。","tok":[["これ"],["ら"],["は"],["ベニヤミン"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["その"],["氏族","しぞく"],["に"],["よれば"],["数えられた","かぞえられた"],["者","もの"],["は"],["四万五千六百","よんまんごせんろくひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":42,"text":"ダンの子孫,しそんは、その氏族,しぞくによれば、次,つぎのとおりである。シュハムからシュハムびとの氏族,しぞくが出,でた。これらはダンの氏族,しぞくであって、その氏族,しぞくによるものである。","tok":[["ダン"],["の"],["子孫","しそん"],["は"],["、"],["その"],["氏族","しぞく"],["に"],["よれば"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["シュハム"],["から"],["シュハム"],["びと"],["の"],["氏族","しぞく"],["が"],["出た","でた"],["。"],["これ"],["ら"],["は"],["ダン"],["の"],["氏族","しぞく"],["で"],["あって"],["、"],["その"],["氏族","しぞく"],["に"],["よる"],["もの"],["で"],["ある"],["。"]]},{"verse":43,"text":"シュハムびとのすべての氏族,しぞくのうち、数,かぞえられた者,ものは六万四千四百人,にんであった。","tok":[["シュハム"],["びと"],["の"],["すべて"],["の"],["氏族","しぞく"],["の"],["うち"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["六万四千四百","ろくまんよんせんよんひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":44,"text":"アセルの子孫,しそんは、その氏族,しぞくによれば、エムナからエムナびとの氏族,しぞくが出,で、エスイからエスイびとの氏族,しぞくが出,で、ベリアからベリアびとの氏族,しぞくが出,でた。","tok":[["アセル"],["の"],["子孫","しそん"],["は"],["、"],["その"],["氏族","しぞく"],["に"],["よれば"],["、"],["エムナ"],["から"],["エムナ"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"],["エスイ"],["から"],["エスイ"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"],["ベリア"],["から"],["ベリア"],["びと"],["の"],["氏族","しぞく"],["が"],["出た","でた"],["。"]]},{"verse":45,"text":"ベリアの子孫,しそんのうちヘベルからヘベルびとの氏族,しぞくが出,で、マルキエルからマルキエルびとの氏族,しぞくが出,でた。","tok":[["ベリア"],["の"],["子孫","しそん"],["の"],["うち"],["ヘベル"],["から"],["ヘベル"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"],["マルキエル"],["から"],["マルキエル"],["びと"],["の"],["氏族","しぞく"],["が"],["出た","でた"],["。"]]},{"verse":46,"text":"アセルの娘,むすめの名,なはサラといった。","tok":[["アセル"],["の"],["娘","むすめ"],["の"],["名","な"],["は"],["サラ"],["と"],["いった"],["。"]]},{"verse":47,"text":"これらはアセルの子孫,しそんの氏族,しぞくであって、数,かぞえられた者,ものは五万三千四百人,にんであった。","tok":[["これ"],["ら"],["は"],["アセル"],["の"],["子孫","しそん"],["の"],["氏族","しぞく"],["で"],["あって"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["五万三千四百","ごまんさんせんよんひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":48,"text":"ナフタリの子孫,しそんは、その氏族,しぞくによれば、ヤジエルからヤジエルびとの氏族,しぞくが出,で、グニからグニびとの氏族,しぞくが出,で、","tok":[["ナフタリ"],["の"],["子孫","しそん"],["は"],["、"],["その"],["氏族","しぞく"],["に"],["よれば"],["、"],["ヤジエル"],["から"],["ヤジエル"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"],["グニ"],["から"],["グニ"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"]]},{"verse":49,"text":"エゼルからエゼルびとの氏族,しぞくが出,で、シレムからシレムびとの氏族,しぞくが出,でた。","tok":[["エゼル"],["から"],["エゼル"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"],["シレム"],["から"],["シレム"],["びと"],["の"],["氏族","しぞく"],["が"],["出た","でた"],["。"]]},{"verse":50,"text":"これらはナフタリの氏族,しぞくであって、その氏族,しぞくにより、数,かぞえられた者,ものは四万五千四百人,にんであった。","tok":[["これ"],["ら"],["は"],["ナフタリ"],["の"],["氏族","しぞく"],["で"],["あって"],["、"],["その"],["氏族","しぞく"],["に"],["より"],["、"],["数えられた","かぞえられた"],["者","もの"],["は"],["四万五千四百","よんまんごせんよんひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":51,"text":"これらはイスラエルの子孫,しそんの数,かぞえられた者,ものであって、六十万一千百三十人,にんであった。","tok":[["これ"],["ら"],["は"],["イスラエル"],["の"],["子孫","しそん"],["の"],["数えられた","かぞえられた"],["者","もの"],["で"],["あって"],["、"],["六十万一千百三","ろくじゅうまんいちせんひゃくさん"],["十人","じゅうにん"],["で"],["あった"],["。"]]},{"verse":52,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":53,"text":"「これらの人々,ひとびとに、その名,なの数,かずにしたがって地,ちを分,わけ与,あたえ、嗣,し業,ぎょうとさせなさい。","tok":[["「"],["これ"],["ら"],["の"],["人々","ひとびと"],["に"],["、"],["その"],["名","な"],["の"],["数","かず"],["に"],["したがって"],["地","ち"],["を"],["分け","わけ"],["与","あたえ"],["、"],["嗣業","しぎょう"],["と"],["させ"],["なさい"],["。"]]},{"verse":54,"text":"大,おおきい部族,ぶぞくには多,おおくの嗣,し業,ぎょうを与,あたえ、小,ちいさい部族,ぶぞくには少,すこしの嗣,し業,ぎょうを与,あたえなさい。すなわち数,かぞえられた数,かずにしたがって、おのおのの部族,ぶぞくにその嗣,し業,ぎょうを与,あたえなければならない。","tok":[["大きい","おおきい"],["部族","ぶぞく"],["に"],["は"],["多く","おおく"],["の"],["嗣業","しぎょう"],["を"],["与","あたえ"],["、"],["小さい","ちいさい"],["部族","ぶぞく"],["に"],["は"],["少し","すこし"],["の"],["嗣業","しぎょう"],["を"],["与え","あたえ"],["なさい"],["。"],["すなわち"],["数えられた","かぞえられた"],["数","かず"],["に"],["したがって"],["、"],["おのおの"],["の"],["部族","ぶぞく"],["に"],["その"],["嗣業","しぎょう"],["を"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":55,"text":"ただし地,ちは、くじをもって分,わけ、その父祖,ふその部族,ぶぞくの名,なにしたがって、それを継,つがなければならない。","tok":[["ただし"],["地","ち"],["は"],["、"],["くじ"],["を"],["もって"],["分け","わけ"],["、"],["その"],["父祖","ふそ"],["の"],["部族","ぶぞく"],["の"],["名","な"],["に"],["したがって"],["、"],["それ"],["を"],["継がなければ","つがなければ"],["ならない"],["。"]]},{"verse":56,"text":"すなわち、くじをもってその嗣,し業,ぎょうを大,おおきいものと、小,ちいさいものとに分,わけなければならない」。","tok":[["すなわち"],["、"],["くじ"],["を"],["もって"],["その"],["嗣業","しぎょう"],["を"],["大きい","おおきい"],["もの"],["と"],["、"],["小さい","ちいさい"],["もの"],["と"],["に"],["分けなければ","わけなければ"],["ならない"],["」"],["。"]]},{"verse":57,"text":"レビびとのその氏族,しぞくにしたがって数,かぞえられた者,ものは次,つぎのとおりである。ゲルションからゲルションびとの氏族,しぞくが出,で、コハテからコハテびとの氏族,しぞくが出,で、メラリからメラリびとの氏族,しぞくが出,でた。","tok":[["レビ"],["びと"],["の"],["その"],["氏族","しぞく"],["に"],["したがって"],["数えられた","かぞえられた"],["者","もの"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ゲルション"],["から"],["ゲルション"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"],["コハテ"],["から"],["コハテ"],["びと"],["の"],["氏族","しぞく"],["が"],["出","で"],["、"],["メラリ"],["から"],["メラリ"],["びと"],["の"],["氏族","しぞく"],["が"],["出た","でた"],["。"]]},{"verse":58,"text":"レビの氏族,しぞくは次,つぎのとおりである。すなわちリブニびとの氏族,しぞく、ヘブロンびとの氏族,しぞく、マヘリびとの氏族,しぞく、ムシびとの氏族,しぞく、コラびとの氏族,しぞくであって、コハテからアムラムが生,うまれた。","tok":[["レビ"],["の"],["氏族","しぞく"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["リブニ"],["びと"],["の"],["氏族","しぞく"],["、"],["ヘブロン"],["びと"],["の"],["氏族","しぞく"],["、"],["マヘリ"],["びと"],["の"],["氏族","しぞく"],["、"],["ムシ"],["びと"],["の"],["氏族","しぞく"],["、"],["コラ"],["びと"],["の"],["氏族","しぞく"],["で"],["あって"],["、"],["コハテ"],["から"],["アムラム"],["が"],["生まれた","うまれた"],["。"]]},{"verse":59,"text":"アムラムの妻,つまの名,なはヨケベデといって、レビの娘,むすめである。彼女,かのじょはエジプトでレビに生,うまれた者,ものであるが、アムラムにとついで、アロンとモーセおよびその姉妹,しまいミリアムを産,うんだ。","tok":[["アムラム"],["の"],["妻","つま"],["の"],["名","な"],["は"],["ヨケベデ"],["と"],["いって"],["、"],["レビ"],["の"],["娘","むすめ"],["で"],["ある"],["。"],["彼女","かのじょ"],["は"],["エジプト"],["で"],["レビ"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["ある"],["が"],["、"],["アムラム"],["に"],["とついで"],["、"],["アロン"],["と"],["モーセ"],["および"],["その"],["姉妹","しまい"],["ミリアム"],["を"],["産んだ","うんだ"],["。"]]},{"verse":60,"text":"アロンにはナダブ、アビウ、エレアザルおよびイタマルが生,うまれた。","tok":[["アロン"],["に"],["は"],["ナダブ"],["、"],["アビウ"],["、"],["エレアザル"],["および"],["イタマル"],["が"],["生まれた","うまれた"],["。"]]},{"verse":61,"text":"ナダブとアビウは異火,ことびを主,しゅの前,まえにささげた時,ときに死,しんだ。","tok":[["ナダブ"],["と"],["アビウ"],["は"],["異","い"],["火","か"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["ささげた"],["時","とき"],["に"],["死んだ","しんだ"],["。"]]},{"verse":62,"text":"その数,かぞえられた一か月,げつ以上,いじょうのすべての男子,だんしは二万三千人,にんであった。彼,かれらはイスラエルの人々,ひとびとのうちに嗣,し業,ぎょうを与,あたえられなかったため、イスラエルの人々,ひとびとのうちに数,かぞえられなかった者,ものである。","tok":[["その"],["数えられた","かぞえられた"],["一","いち"],["か月","かげつ"],["以上","いじょう"],["の"],["すべて"],["の"],["男子","だんし"],["は"],["二万三千","にまんさんせん"],["人","にん"],["で"],["あった"],["。"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["嗣業","しぎょう"],["を"],["与えられなかった","あたえられなかった"],["ため"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["数えられなかった","かぞえられなかった"],["者","もの"],["で"],["ある"],["。"]]},{"verse":63,"text":"これらはモーセと祭司,さいしエレアザルが、エリコに近,ちかいヨルダンのほとりにあるモアブの平野,へいやで数,かぞえたイスラエルの人々,ひとびとの数,かずである。","tok":[["これ"],["ら"],["は"],["モーセ"],["と"],["祭司","さいし"],["エレアザル"],["が"],["、"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["の"],["ほとり"],["に"],["ある"],["モアブ"],["の"],["平野","へいや"],["で"],["数えた","かぞえた"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["数","かず"],["で"],["ある"],["。"]]},{"verse":64,"text":"ただしそのうちには、モーセと祭司,さいしアロンがシナイの荒野,あらのでイスラエルの人々,ひとびとを数,かぞえた時,ときに数,かぞえられた者,ものはひとりもなかった。","tok":[["ただし"],["その"],["うち"],["に"],["は"],["、"],["モーセ"],["と"],["祭司","さいし"],["アロン"],["が"],["シナイ"],["の"],["荒野","あらの"],["で"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["数えた","かぞえた"],["時","とき"],["に"],["数えられた","かぞえられた"],["者","もの"],["は"],["ひとり"],["も"],["なかった"],["。"]]},{"verse":65,"text":"それは主,しゅがかつて彼,かれらについて「彼,かれらは必,かならず荒野,あらので死,しぬであろう」と言,いわれたからである。それで彼,かれらのうちエフンネの子,こカレブとヌンの子,こヨシュアのほか、ひとりも残,のこった者,ものはなかった。","tok":[["それ"],["は"],["主","しゅ"],["が"],["かつて"],["彼","かれ"],["ら"],["について"],["「"],["彼","かれ"],["ら"],["は"],["必","かならず"],["荒野","あらの"],["で"],["死ぬで","しぬで"],["あろう"],["」"],["と"],["言われた","いわれた"],["から"],["で"],["ある"],["。"],["それ"],["で"],["彼","かれ"],["ら"],["の"],["うち"],["エフンネ"],["の"],["子","こ"],["カレブ"],["と"],["ヌン"],["の"],["子","こ"],["ヨシュア"],["の"],["ほか"],["、"],["ひとり"],["も"],["残った","のこった"],["者","もの"],["は"],["なかった"],["。"]]}]
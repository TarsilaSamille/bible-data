[{"verse":1,"text":"さて主,しゅはモーセに言,いわれた、","tok":[["さて"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「ミデアンびとにイスラエルの人々,ひとびとのあだを報,むくいなさい。その後,のち、あなたはあなたの民,たみに加,くわえられるであろう」。","tok":[["「"],["ミデアン"],["びと"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["あだ"],["を"],["報い","むくい"],["なさい"],["。"],["その後","そのの"],["ち"],["、"],["あなた"],["は"],["あなた"],["の"],["民","たみ"],["に"],["加えられるで","くわえられるで"],["あろう"],["」"],["。"]]},{"verse":3,"text":"モーセは民,たみに言,いった、「あなたがたのうちから人,ひとを選,えらんで戦,たたかいのために武装,ぶそうさせ、ミデアンびとを攻,せめて、主,しゅのためミデアンびとに復讐,ふくしゅうしなさい。","tok":[["モーセ"],["は"],["民","たみ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["の"],["うち"],["から"],["人","ひと"],["を"],["選らんで","えらんで"],["戦い","たたかい"],["の"],["ため"],["に"],["武装","ぶそう"],["させ"],["、"],["ミデアン"],["びと"],["を"],["攻めて","せめて"],["、"],["主","しゅ"],["の"],["ため"],["ミデアン"],["びと"],["に"],["復讐","ふくしゅう"],["し"],["なさい"],["。"]]},{"verse":4,"text":"すなわちイスラエルのすべての部族,ぶぞくから、部族,ぶぞくごとに千人,にんずつを戦,たたかいに送,おくり出,ださなければならない」。","tok":[["すなわち"],["イスラエル"],["の"],["すべて"],["の"],["部族","ぶぞく"],["から"],["、"],["部族","ぶぞく"],["ごと"],["に"],["千人","にんずつ"],["を"],["戦い","たたかい"],["に"],["送り出さなければ","おくりださなければ"],["ならない"],["」"],["。"]]},{"verse":5,"text":"そこでイスラエルの部族,ぶぞくのうちから部族,ぶぞくごとに千人,にんずつを選,えらび、一万二千人,にんを得,えて、戦,たたかいのために武装,ぶそうさせた。","tok":[["そこ"],["で"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["うち"],["から"],["部族","ぶぞく"],["ごと"],["に"],["千人","にんずつ"],["を"],["選ら","えら"],["び"],["、"],["一万二千","いちまんにせん"],["人","にん"],["を"],["得て","えて"],["、"],["戦い","たたかい"],["の"],["ため"],["に"],["武装","ぶそう"],["させた"],["。"]]},{"verse":6,"text":"モーセは各,かく部族,ぶぞくから千人,にんずつを戦,たたかいにつかわし、また祭司,さいしエレアザルの子,こピネハスに、聖,せいなる器,うつわと吹,ふき鳴,ならすラッパとを執,とらせて、共,ともに戦,たたかいにつかわした。","tok":[["モーセ"],["は"],["各","かく"],["部族","ぶぞく"],["から"],["千人","にんずつ"],["を"],["戦い","たたかい"],["に"],["つかわし"],["、"],["また"],["祭司","さいし"],["エレアザル"],["の"],["子","こ"],["ピネハス"],["に"],["、"],["聖","せい"],["なる"],["器","うつわ"],["と"],["吹","ふき"],["鳴らす","ならす"],["ラッパ"],["と"],["を"],["執らせて","とらせて"],["、"],["共","とも"],["に"],["戦い","たたかい"],["に"],["つかわした"],["。"]]},{"verse":7,"text":"彼,かれらは主,しゅがモーセに命,めいじられたようにミデアンびとと戦,たたかって、その男子,だんしをみな殺,ころした。","tok":[["彼","かれ"],["ら"],["は"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["ミデアン"],["びと"],["と"],["戦って","たたかって"],["、"],["その"],["男子","だんし"],["を"],["みな"],["殺ろした","ころした"],["。"]]},{"verse":8,"text":"その殺,ころした者,もののほかにまたミデアンの王,おう五人,にんを殺,ころした。その名,なはエビ、レケム、ツル、フル、レバである。またベオルの子,こバラムをも、つるぎにかけて殺,ころした。","tok":[["その"],["殺ろした","ころした"],["者","もの"],["の"],["ほか"],["に"],["また"],["ミデアン"],["の"],["王","おう"],["五人","にん"],["を"],["殺ろした","ころした"],["。"],["その"],["名","な"],["は"],["エビ"],["、"],["レケム"],["、"],["ツル"],["、"],["フル"],["、"],["レバ"],["で"],["ある"],["。"],["また"],["ベオル"],["の"],["子","こ"],["バラム"],["を"],["も"],["、"],["つるぎ"],["に"],["かけて"],["殺ろした","ころした"],["。"]]},{"verse":9,"text":"またイスラエルの人々,ひとびとはミデアンの女,おんなたちとその子,こ供,ともたちを捕虜,ほりょにし、その家畜,かちくと、羊,ひつじの群,むれと、貨,か財,ざいとをことごとく奪,うばい取,とり、","tok":[["また"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["ミデアン"],["の"],["女","おんな"],["たち"],["と"],["その"],["子供","ことも"],["たち"],["を"],["捕虜","ほりょ"],["に"],["し"],["、"],["その"],["家畜","かちく"],["と"],["、"],["羊","ひつじ"],["の"],["群れ","むれ"],["と"],["、"],["貨財","かざい"],["と"],["を"],["ことごとく"],["奪い","うばい"],["取","とり"],["、"]]},{"verse":10,"text":"そのすまいのある町々,まちまちと、その部落,ぶらくとを、ことごとく火,ひで焼,やいた。","tok":[["その"],["すまい"],["の"],["ある"],["町々","まちまち"],["と"],["、"],["その"],["部落","ぶらく"],["と"],["を"],["、"],["ことごとく"],["火","ひ"],["で"],["焼いた","やいた"],["。"]]},{"verse":11,"text":"こうして彼,かれらはすべて奪,うばったものと、かすめたものとは人,ひとをも家畜,かちくをも取,とり、","tok":[["こう"],["して"],["彼","かれ"],["ら"],["は"],["すべて"],["奪った","うばった"],["もの"],["と"],["、"],["かすめた"],["もの"],["と"],["は"],["人","ひと"],["を"],["も"],["家畜","かちく"],["を"],["も"],["取","とり"],["、"]]},{"verse":12,"text":"その生,なまけどった者,ものと、かすめたものと、奪,うばったものとを携,たずさえて、エリコに近,ちかいヨルダンのほとりのモアブの平野,へいやの宿営,しゅくえいにおるモーセと祭司,さいしエレアザルとイスラエルの人々,ひとびとの会衆,かいしゅうのもとへもどってきた。","tok":[["その"],["生けどった","なまけどった"],["者","もの"],["と"],["、"],["かすめた"],["もの"],["と"],["、"],["奪った","うばった"],["もの"],["と"],["を"],["携えて","たずさえて"],["、"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["の"],["ほとり"],["の"],["モアブ"],["の"],["平野","へいや"],["の"],["宿営","しゅくえい"],["に"],["おる"],["モーセ"],["と"],["祭司","さいし"],["エレアザル"],["と"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["会衆","かいしゅう"],["の"],["もと"],["へ"],["もどって"],["きた"],["。"]]},{"verse":13,"text":"ときにモーセと祭司,さいしエレアザルと会衆,かいしゅうのつかさたちはみな宿営,しゅくえいの外,そとに出,でて迎,むかえたが、","tok":[["とき"],["に"],["モーセ"],["と"],["祭司","さいし"],["エレアザル"],["と"],["会衆","かいしゅう"],["の"],["つかさ"],["たち"],["は"],["みな"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["出て","でて"],["迎","むかえ"],["た"],["が"],["、"]]},{"verse":14,"text":"モーセは軍勢,ぐんぜいの将,しょうたち、すなわち戦場,せんじょうから帰,かえってきた千人,にんの長,ちょうたちと、百人,にんの長,ちょうたちに対,たいして怒,いかった。","tok":[["モーセ"],["は"],["軍勢","ぐんぜい"],["の"],["将","しょう"],["たち"],["、"],["すなわち"],["戦場","せんじょう"],["から"],["帰えって","かえって"],["きた"],["千人","にん"],["の"],["長","ちょう"],["たち"],["と"],["、"],["百人","にん"],["の"],["長","ちょう"],["たち"],["に対して","にたいして"],["怒","い"],["かった"],["。"]]},{"verse":15,"text":"モーセは彼,かれらに言,いった、「あなたがたは女,おんなたちをみな生,いかしておいたのか。","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["女","おんな"],["たち"],["を"],["みな"],["生かして","いかして"],["おいた"],["の"],["か"],["。"]]},{"verse":16,"text":"彼,かれらはバラムのはかりごとによって、イスラエルの人々,ひとびとに、ペオルのことで主,しゅに罪,つみを犯,おかさせ、ついに主,しゅの会衆,かいしゅうのうちに疫病,えきびょうを起,おこすに至,いたった。","tok":[["彼","かれ"],["ら"],["は"],["バラム"],["の"],["はかりごと"],["によって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["、"],["ペオル"],["の"],["こと"],["で"],["主に","しゅに"],["罪","つみ"],["を"],["犯させ","おかさせ"],["、"],["ついに"],["主","しゅ"],["の"],["会衆","かいしゅう"],["の"],["うち"],["に"],["疫病","えきびょう"],["を"],["起こす","おこす"],["に"],["至った","いたった"],["。"]]},{"verse":17,"text":"それで今,いま、この子供,こどもたちのうちの男,おとこの子,こをみな殺,ころし、また男,おとこと寝,ねて、男,おとこを知,しった女,おんなをみな殺,ころしなさい。","tok":[["それ"],["で"],["今","いま"],["、"],["この"],["子供","こども"],["たち"],["の"],["うち"],["の"],["男の子","おとこのこ"],["を"],["みな"],["殺ろし","ころし"],["、"],["また"],["男","おとこ"],["と"],["寝て","ねて"],["、"],["男","おとこ"],["を"],["知った","しった"],["女","おんな"],["を"],["みな"],["殺ろし","ころし"],["なさい"],["。"]]},{"verse":18,"text":"ただし、まだ男,おとこと寝,ねず、男,おとこを知,しらない娘,むすめはすべてあなたがたのために生,いかしておきなさい。","tok":[["ただし"],["、"],["まだ"],["男","おとこ"],["と"],["寝ず","ねず"],["、"],["男","おとこ"],["を"],["知らない","しらない"],["娘","むすめ"],["は"],["すべて"],["あなた"],["がた"],["の"],["ため"],["に"],["生かして","いかして"],["おき"],["なさい"],["。"]]},{"verse":19,"text":"そしてあなたがたは七日,なぬかのあいだ宿営,しゅくえいの外,そとにとどまりなさい。あなたがたのうちすべて人,ひとを殺,ころした者,もの、およびすべて殺,ころされた者,ものに触,ふれた者,ものは、あなたがた自身,じしんも、あなたがたの捕虜,ほりょも共,ともに、三日,か目,めと七日,なぬか目,めとに身,みを清,きよめなければならない。","tok":[["そして"],["あなた"],["がた"],["は"],["七日","なぬか"],["の"],["あいだ"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["とどまり"],["なさい"],["。"],["あなた"],["がた"],["の"],["うち"],["すべて"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["、"],["および"],["すべて"],["殺ろされた","ころされた"],["者","もの"],["に"],["触","ふれ"],["た"],["者","もの"],["は"],["、"],["あなた"],["がた"],["自身","じしん"],["も"],["、"],["あなた"],["がた"],["の"],["捕虜","ほりょ"],["も"],["共","とも"],["に"],["、"],["三日目","かめ"],["と"],["七日","な"],["ぬか目","ぬかめ"],["と"],["に"],["身","み"],["を"],["清めなければ","きよめなければ"],["ならない"],["。"]]},{"verse":20,"text":"またすべての衣服,いふくと、すべての皮,かわの器,うつわと、すべてやぎの毛,けで作,つくったものと、すべての木,きの器,うつわとを清,きよめなければならない」。","tok":[["また"],["すべて"],["の"],["衣服","いふく"],["と"],["、"],["すべて"],["の"],["皮","かわ"],["の"],["器","うつわ"],["と"],["、"],["すべて"],["やぎ"],["の"],["毛","け"],["で"],["作った","つくった"],["もの"],["と"],["、"],["すべて"],["の"],["木","き"],["の"],["器","うつわ"],["と"],["を"],["清めなければ","きよめなければ"],["ならない"],["」"],["。"]]},{"verse":21,"text":"祭司,さいしエレアザルは戦,たたかいに出,でたいくさびとたちに言,いった、「これは主,しゅがモーセに命,めいじられた律法,りっぽうの定,さだめである。","tok":[["祭司","さいし"],["エレアザル"],["は"],["戦い","たたかい"],["に"],["出たい","でたい"],["くさび"],["と"],["たち"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["律法","りっぽう"],["の"],["定め","さだめ"],["で"],["ある"],["。"]]},{"verse":22,"text":"金,きん、銀,ぎん、青銅,せいどう、鉄,てつ、すず、鉛,なまりなど、","tok":[["金","きん"],["、"],["銀","ぎん"],["、"],["青銅","せいどう"],["、"],["鉄","てつ"],["、"],["すず"],["、"],["鉛","なまり"],["など"],["、"]]},{"verse":23,"text":"すべて火,ひに耐,たえる物,ものは火,ひの中,なかを通,とおさなければならない。そうすれば清,きよくなるであろう。なおその上,うえ、汚,けがれを清,きよめる水,みずで、清,きよめなければならない。しかし、すべて火,ひに耐,たえないものは水,みずの中,なかを通,とおさなければならない。","tok":[["すべて"],["火","ひ"],["に"],["耐える","たえる"],["物","もの"],["は"],["火","ひ"],["の"],["中","なか"],["を"],["通さなければ","とおさなければ"],["ならない"],["。"],["そう"],["すれば"],["清く","きよく"],["なるで"],["あろう"],["。"],["なお"],["その"],["上","うえ"],["、"],["汚","けがれ"],["を"],["清める","きよめる"],["水","みず"],["で"],["、"],["清めなければ","きよめなければ"],["ならない"],["。"],["しかし"],["、"],["すべて"],["火","ひ"],["に"],["耐えない","たえない"],["もの"],["は"],["水","みず"],["の"],["中","なか"],["を"],["通さなければ","とおさなければ"],["ならない"],["。"]]},{"verse":24,"text":"あなたがたは七日,なぬか目,めに衣服,いふくを洗,あらわなければならない。そして清,きよくなり、その後,のち宿営,しゅくえいにはいることができる」。","tok":[["あなた"],["がた"],["は"],["七日","な"],["ぬか目","ぬかめ"],["に"],["衣服","いふく"],["を"],["洗わなければ","あらわなければ"],["ならない"],["。"],["そして"],["清く","きよく"],["なり"],["、"],["その後","そのの"],["ち"],["宿営","しゅくえい"],["に"],["はいる"],["こと"],["が"],["できる"],["」"],["。"]]},{"verse":25,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":26,"text":"「あなたと祭司,さいしエレアザルおよび会衆,かいしゅうの氏族,しぞくのかしらたちは、その生,なまけどった人,ひとと家畜,かちくの獲物,えものの総数,そうすうを調,しらべ、","tok":[["「"],["あなた"],["と"],["祭司","さいし"],["エレアザル"],["および"],["会衆","かいしゅう"],["の"],["氏族","しぞく"],["の"],["かしら"],["たち"],["は"],["、"],["その"],["生けどった","なまけどった"],["人","ひと"],["と"],["家畜","かちく"],["の"],["獲物","えもの"],["の"],["総数","そうすう"],["を"],["調べ","しらべ"],["、"]]},{"verse":27,"text":"その獲物,えものを戦,たたかいに出,でた勇士,ゆうしと、全,ぜん会衆,かいしゅうとに折半,せっぱんしなさい。","tok":[["その"],["獲物","えもの"],["を"],["戦い","たたかい"],["に"],["出た","でた"],["勇士","ゆうし"],["と"],["、"],["全","ぜん"],["会衆","かいしゅう"],["と"],["に"],["折半","せっぱん"],["し"],["なさい"],["。"]]},{"verse":28,"text":"そして戦,たたかいに出,でたいくさびとに、人,ひとまたは牛,うし、またはろば、または羊,ひつじを、おのおの五百ごとに一つを取,とり、みつぎとして主,しゅにささげさせなさい。","tok":[["そして"],["戦い","たたかい"],["に"],["出たい","でたい"],["くさび"],["と"],["に"],["、"],["人","ひと"],["また"],["は"],["牛","うし"],["、"],["また"],["はろば"],["、"],["また"],["は"],["羊","ひつじ"],["を"],["、"],["おのおの"],["五百","ごひゃく"],["ごと"],["に"],["一","ひと"],["つ"],["を"],["取","とり"],["、"],["みつぎ"],["として"],["主に","しゅに"],["ささげさせ"],["なさい"],["。"]]},{"verse":29,"text":"すなわち彼,かれらが受,うける半分,はんぶんのなかから、それを取,とり、主,しゅにささげる物,ものとして祭司,さいしエレアザルに渡,わたしなさい。","tok":[["すなわち"],["彼","かれ"],["ら"],["が"],["受る","うける"],["半分","はんぶん"],["の"],["なか"],["から"],["、"],["それ"],["を"],["取","とり"],["、"],["主に","しゅに"],["ささげる"],["物","もの"],["として"],["祭司","さいし"],["エレアザル"],["に"],["渡","わたし"],["なさい"],["。"]]},{"verse":30,"text":"またイスラエルの人々,ひとびとが受,うける半分,はんぶんのなかから、その獲,えた人,ひとまたは牛,うし、またはろば、または羊,ひつじなどの家畜,かちくを、おのおの五十ごとに一つを取,とり、主,しゅの幕屋,まくやの務,つとめをするレビびとに与,あたえなさい」。","tok":[["また"],["イスラエル"],["の"],["人々","ひとびと"],["が"],["受る","うける"],["半分","はんぶん"],["の"],["なか"],["から"],["、"],["その"],["獲た","えた"],["人","ひと"],["また"],["は"],["牛","うし"],["、"],["また"],["はろば"],["、"],["また"],["は"],["羊","ひつじ"],["など"],["の"],["家畜","かちく"],["を"],["、"],["おのおの"],["五十","ごじゅう"],["ごと"],["に"],["一","ひと"],["つ"],["を"],["取","とり"],["、"],["主","しゅ"],["の"],["幕屋","まくや"],["の"],["務め","つとめ"],["を"],["する"],["レビ"],["びと"],["に"],["与え","あたえ"],["なさい"],["」"],["。"]]},{"verse":31,"text":"モーセと祭司,さいしエレアザルとは主,しゅがモーセに命,めいじられたとおりに行,いった。","tok":[["モーセ"],["と"],["祭司","さいし"],["エレアザル"],["と"],["は"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["に"],["行った","いった"],["。"]]},{"verse":32,"text":"そこでその獲物,えもの、すなわち、いくさびとたちが奪,うばい取,とったものの残,のこりは羊,ひつじ六十七万五千、","tok":[["そこ"],["で"],["その"],["獲物","えもの"],["、"],["すなわち"],["、"],["いく"],["さび"],["と"],["たち"],["が"],["奪い取った","うばいとった"],["もの"],["の"],["残り","のこり"],["は"],["羊","ひつじ"],["六十七万五千","ろくじゅうななまんごせん"],["、"]]},{"verse":33,"text":"牛,うし七万二千、","tok":[["牛","うし"],["七万二千","ななまんにせん"],["、"]]},{"verse":34,"text":"ろば六万一千、","tok":[["ろば"],["六万一千","ろくまんいちせん"],["、"]]},{"verse":35,"text":"人,ひと三万二千、これはみな男,おとこと寝,ねず、男,おとこを知,しらない女,おんなであった。","tok":[["人","ひと"],["三万二千","さんまんにせん"],["、"],["これ"],["は"],["みな"],["男","おとこ"],["と"],["寝ず","ねず"],["、"],["男","おとこ"],["を"],["知らない","しらない"],["女","おんな"],["で"],["あった"],["。"]]},{"verse":36,"text":"そしてその半分,はんぶん、すなわち戦,たたかいに出,でた者,ものの分,ぶんは羊,ひつじ三十三万七千五百、","tok":[["そして"],["その"],["半分","はんぶん"],["、"],["すなわち"],["戦い","たたかい"],["に"],["出た","でた"],["者","もの"],["の"],["分","ぶん"],["は"],["羊","ひつじ"],["三十三万七千五百","さんじゅうさんまんななせんごひゃく"],["、"]]},{"verse":37,"text":"主,しゅにみつぎとした羊,ひつじは六百七十五。","tok":[["主に","しゅに"],["みつぎ"],["と"],["した"],["羊","ひつじ"],["は"],["六百七十五","ろくひゃくななじゅうご"],["。"]]},{"verse":38,"text":"牛,うしは三万六千、そのうちから主,しゅにみつぎとしたものは七十二。","tok":[["牛","うし"],["は"],["三万六千","さんまんろくせん"],["、"],["その"],["うち"],["から"],["主に","しゅに"],["みつぎ"],["と"],["した"],["もの"],["は"],["七十二","ななじゅうに"],["。"]]},{"verse":39,"text":"ろばは三万五百、そのうちから主,しゅにみつぎとしたものは六十一。","tok":[["ろば"],["は"],["三万五百","さんまんごひゃく"],["、"],["その"],["うち"],["から"],["主に","しゅに"],["みつぎ"],["と"],["した"],["もの"],["は"],["六十一","ろくじゅういち"],["。"]]},{"verse":40,"text":"人,ひとは一万六千、そのうちから主,しゅにみつぎとしたものは三十二人,にんであった。","tok":[["人","ひと"],["は"],["一万六千","いちまんろくせん"],["、"],["その"],["うち"],["から"],["主に","しゅに"],["みつぎ"],["と"],["した"],["もの"],["は"],["三十二人","にん"],["で"],["あった"],["。"]]},{"verse":41,"text":"モーセはそのみつぎを主,しゅにささげる物,ものとして祭司,さいしエレアザルに渡,わたした。主,しゅがモーセに命,めいじられたとおりである。","tok":[["モーセ"],["は"],["その"],["みつぎ"],["を"],["主に","しゅに"],["ささげる"],["物","もの"],["として"],["祭司","さいし"],["エレアザル"],["に"],["渡","わたし"],["た"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":42,"text":"モーセが戦,たたかいに出,でた人々,ひとびととは別,べつにイスラエルの人々,ひとびとに与,あたえた半分,はんぶん、","tok":[["モーセ"],["が"],["戦い","たたかい"],["に"],["出た","でた"],["人々","ひとびと"],["と"],["は"],["別","べつ"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与","あたえ"],["た"],["半分","はんぶん"],["、"]]},{"verse":43,"text":"すなわち会衆,かいしゅうの受,うけた半分,はんぶんは羊,ひつじ三十三万七千五百、","tok":[["すなわち"],["会衆","かいしゅう"],["の"],["受けた","うけた"],["半分","はんぶん"],["は"],["羊","ひつじ"],["三十三万七千五百","さんじゅうさんまんななせんごひゃく"],["、"]]},{"verse":44,"text":"牛,うし三万六千、","tok":[["牛","うし"],["三万六千","さんまんろくせん"],["、"]]},{"verse":45,"text":"ろば三万五百、","tok":[["ろば"],["三万五百","さんまんごひゃく"],["、"]]},{"verse":46,"text":"人,ひと一万六千であって、","tok":[["人","ひと"],["一万六千","いちまんろくせん"],["で"],["あって"],["、"]]},{"verse":47,"text":"モーセはイスラエルの人々,ひとびとの受,うけた半分,はんぶんのなかから、人,ひとおよび獣,けものをおのおの五十ごとに一つを取,とって、主,しゅの幕屋,まくやの務,つとめをするレビびとに与,あたえた。主,しゅがモーセに命,めいじられたとおりである。","tok":[["モーセ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["受けた","うけた"],["半分","はんぶん"],["の"],["なか"],["から"],["、"],["人","ひと"],["および"],["獣","けもの"],["を"],["おのおの"],["五十","ごじゅう"],["ごと"],["に"],["一","ひと"],["つ"],["を"],["取って","とって"],["、"],["主","しゅ"],["の"],["幕屋","まくや"],["の"],["務め","つとめ"],["を"],["する"],["レビ"],["びと"],["に"],["与","あたえ"],["た"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]},{"verse":48,"text":"時,ときに軍勢,ぐんぜいの将,しょうであったものども、すなわち千人,にんの長,ちょうたちと百人,にんの長,ちょうたちとがモーセのところにきて、","tok":[["時","とき"],["に"],["軍勢","ぐんぜい"],["の"],["将","しょう"],["で"],["あった"],["もの"],["ども"],["、"],["すなわち"],["千人","にん"],["の"],["長","ちょう"],["たち"],["と"],["百人","にん"],["の"],["長","ちょう"],["たち"],["と"],["が"],["モーセ"],["の"],["ところ"],["に"],["きて"],["、"]]},{"verse":49,"text":"モーセに言,いった、「しもべらは、指揮,しき下,かのいくさびとを数,かぞえましたが、われわれのうち、ひとりも欠,かけた者,ものはありませんでした。","tok":[["モーセ"],["に"],["言った","いった"],["、"],["「"],["しもべ"],["ら"],["は"],["、"],["指揮下","しきか"],["の"],["いく"],["さび"],["と"],["を"],["数えました","かぞえました"],["が"],["、"],["われわれ"],["の"],["うち"],["、"],["ひとり"],["も"],["欠けた","かけた"],["者","もの"],["は"],["ありませんでした"],["。"]]},{"verse":50,"text":"それで、われわれは、おのおの手,てに入,いれた金,きんの飾,かざり物,もの、すなわち腕,うで飾,かざり、腕輪,うでわ、指輪,ゆびわ、耳輪,みみわ、首飾,くびかざりなどを主,しゅに携,たずさえてきて供,そなえ物,ものとし、主,しゅの前,まえにわれわれの命,いのちのあがないをしようと思,おもいます」。","tok":[["それ"],["で"],["、"],["われわれ"],["は"],["、"],["おのおの"],["手","て"],["に"],["入れた","いれた"],["金","きん"],["の"],["飾","かざり"],["物","もの"],["、"],["すなわち"],["腕","うで"],["飾","かざり"],["、"],["腕輪","うでわ"],["、"],["指輪","ゆびわ"],["、"],["耳輪","みみわ"],["、"],["首","くび"],["飾","かざり"],["など"],["を"],["主に","しゅに"],["携えて","たずさえて"],["きて"],["供え物","そなえもの"],["と"],["し"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["われわれ"],["の"],["命","いのち"],["の"],["あ"],["が"],["ない"],["を"],["しよう"],["と"],["思います","おもいます"],["」"],["。"]]},{"verse":51,"text":"モーセと祭司,さいしエレアザルとは、彼,かれらから細工,さいくを施,ほどこした金,きんの飾,かざり物,ものを受,うけ取,とった。","tok":[["モーセ"],["と"],["祭司","さいし"],["エレアザル"],["と"],["は"],["、"],["彼","かれ"],["ら"],["から"],["細工","さいく"],["を"],["施した","ほどこした"],["金","きん"],["の"],["飾","かざり"],["物","もの"],["を"],["受け取った","うけとった"],["。"]]},{"verse":52,"text":"千人,にんの長,ちょうたちと百人,にんの長,ちょうたちとが、主,しゅにささげものとした金,きんは合,あわせて一万六千七百五十シケル。","tok":[["千人","にん"],["の"],["長","ちょう"],["たち"],["と"],["百人","にん"],["の"],["長","ちょう"],["たち"],["と"],["が"],["、"],["主に","しゅに"],["ささげ"],["もの"],["と"],["した"],["金","きん"],["は"],["合","あわせ"],["て"],["一万六千七百五十","いちまんろくせんななひゃくごじゅう"],["シケル"],["。"]]},{"verse":53,"text":"いくさびとは、おのおの自分,じぶんのぶんどり物,ものを獲,えた。","tok":[["いく"],["さび"],["と"],["は"],["、"],["おのおの"],["自分","じぶん"],["の"],["ぶんどり"],["物","もの"],["を"],["獲た","えた"],["。"]]},{"verse":54,"text":"モーセと祭司,さいしエレアザルとは、千人,にんの長,ちょうたちと百人,にんの長,ちょうたちとから、その金,きんを受,うけ取,とり、それを携,たずさえて会見,かいけんの幕屋,まくやに入,いり、主,しゅの前,まえに置,おいてイスラエルの人々,ひとびとのために記念,きねんとした。","tok":[["モーセ"],["と"],["祭司","さいし"],["エレアザル"],["と"],["は"],["、"],["千人","にん"],["の"],["長","ちょう"],["たち"],["と"],["百人","にん"],["の"],["長","ちょう"],["たち"],["と"],["から"],["、"],["その"],["金","きん"],["を"],["受け","うけ"],["取","とり"],["、"],["それ"],["を"],["携えて","たずさえて"],["会見","かいけん"],["の"],["幕屋","まくや"],["に"],["入","いり"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["置いて","おいて"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["記念","きねん"],["と"],["した"],["。"]]}]
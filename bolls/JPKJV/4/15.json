[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『あなたがたが、わたしの与,あたえて住,すませる地,ちに行,いって、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["が"],["た"],["が"],["、"],["わたし"],["の"],["与","あたえ"],["て"],["住ませる","すませる"],["地","ち"],["に"],["行って","いって"],["、"]]},{"verse":3,"text":"主,しゅに火祭,かさいをささげる時,とき、すなわち特別,とくべつの誓願,せいがんの供,そなえ物,もの、あるいは自発,じはつの供,そなえ物,もの、あるいは祝,しゅくのときの供,そなえ物,ものとして、牛,うしまたは羊,ひつじを燔祭,はんさいまたは犠牲,ぎせいとしてささげ、主,しゅに香,こうばしいかおりとするとき、","tok":[["主に","しゅに"],["火祭","かさい"],["を"],["ささげる"],["時","とき"],["、"],["すなわち"],["特別","とくべつ"],["の"],["誓願","せいがん"],["の"],["供え物","そなえもの"],["、"],["あるいは"],["自発","じはつ"],["の"],["供え物","そなえもの"],["、"],["あるいは"],["祝","しゅく"],["の"],["とき"],["の"],["供え物","そなえもの"],["として"],["、"],["牛","うし"],["また"],["は"],["羊","ひつじ"],["を"],["燔祭","はんさい"],["また"],["は"],["犠牲","ぎせい"],["として"],["ささげ"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["する"],["とき"],["、"]]},{"verse":4,"text":"[4-5]その供,そなえ物,ものを主,しゅにささげる者,ものは、燔祭,はんさいまたは犠牲,ぎせいと共,ともに、小羊,こひつじ一頭,とうごとに、麦粉,むぎこ一エパの十分,ぶんの一に、油,あぶら一ヒンの四分,ぶんの一を混,まぜたものを、素祭,そさいとしてささげ、ぶどう酒,しゅ一ヒンの四分,ぶんの一を、灌祭,かんさいとしてささげなければならない。","tok":[["["],["4"],["-"],["5"],["]"],["その"],["供え物","そなえもの"],["を"],["主に","しゅに"],["ささげる"],["者","もの"],["は"],["、"],["燔祭","はんさい"],["また"],["は"],["犠牲","ぎせい"],["と"],["共","とも"],["に"],["、"],["小羊","こひつじ"],["一頭","とうごと"],["に"],["、"],["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["一","いち"],["に"],["、"],["油","あぶら"],["一","いち"],["ヒン"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["混ぜた","まぜた"],["もの"],["を"],["、"],["素","す"],["祭","まつり"],["として"],["ささげ"],["、"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["ヒン"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["、"],["灌祭","かんさい"],["として"],["ささげなければ"],["ならない"],["。"]]},{"verse":5,"text":"*[4-5]その供,そなえ物,ものを主,しゅにささげる者,ものは、燔祭,はんさいまたは犠牲,ぎせいと共,ともに、小羊,こひつじ一頭,とうごとに、麦粉,むぎこ一エパの十分,ぶんの一に、油,あぶら一ヒンの四分,ぶんの一を混,まぜたものを、素祭,そさいとしてささげ、ぶどう酒,しゅ一ヒンの四分,ぶんの一を、灌祭,かんさいとしてささげなければならない。","tok":[["*"],["["],["4"],["-"],["5"],["]"],["その"],["供え物","そなえもの"],["を"],["主に","しゅに"],["ささげる"],["者","もの"],["は"],["、"],["燔祭","はんさい"],["また"],["は"],["犠牲","ぎせい"],["と"],["共","とも"],["に"],["、"],["小羊","こひつじ"],["一頭","とうごと"],["に"],["、"],["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["一","いち"],["に"],["、"],["油","あぶら"],["一","いち"],["ヒン"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["混ぜた","まぜた"],["もの"],["を"],["、"],["素","す"],["祭","まつり"],["として"],["ささげ"],["、"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["ヒン"],["の"],["四分","ぶん"],["の"],["一","いち"],["を"],["、"],["灌祭","かんさい"],["として"],["ささげなければ"],["ならない"],["。"]]},{"verse":6,"text":"もし、また雄羊,おひつじを用,もちいるときは、麦粉,むぎこ一エパの十分,ぶんの二に、油,あぶら一ヒンの三分,ぶんの一を混,まぜたものを、素祭,そさいとしてささげ、","tok":[["もし"],["、"],["また"],["雄羊","おひつじ"],["を"],["用いる","もちいる"],["とき"],["は"],["、"],["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["二","に"],["に"],["、"],["油","あぶら"],["一","いち"],["ヒン"],["の"],["三分","ぶん"],["の"],["一","いち"],["を"],["混ぜた","まぜた"],["もの"],["を"],["、"],["素","す"],["祭","まつり"],["として"],["ささげ"],["、"]]},{"verse":7,"text":"また、ぶどう酒,しゅ一ヒンの三分,ぶんの一を、灌祭,かんさいとしてささげて、主,しゅに香,こうばしいかおりとしなければならない。","tok":[["また"],["、"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["ヒン"],["の"],["三分","ぶん"],["の"],["一","いち"],["を"],["、"],["灌祭","かんさい"],["として"],["ささげて"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":8,"text":"またあなたが特別,とくべつの誓願,せいがんの供,そなえ物,もの、あるいは酬恩祭,しゅうおんさいを、主,しゅにささげる時,とき、若,わかい雄牛,おうしを、燔祭,はんさいまたは犠牲,ぎせいとするならば、","tok":[["また"],["あなた"],["が"],["特別","とくべつ"],["の"],["誓願","せいがん"],["の"],["供え物","そなえもの"],["、"],["あるいは"],["酬恩祭","しゅうおんさい"],["を"],["、"],["主に","しゅに"],["ささげる"],["時","とき"],["、"],["若い","わかい"],["雄牛","おうし"],["を"],["、"],["燔祭","はんさい"],["また"],["は"],["犠牲","ぎせい"],["と"],["するならば"],["、"]]},{"verse":9,"text":"麦粉,むぎこ一エパの十分,ぶんの三に、油,あぶら一ヒンの二分,ぶんの一を混,まぜたものを、素祭,そさいとして、若,わかい雄牛,おうしと共,ともにささげ、","tok":[["麦粉","むぎこ"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["三","さん"],["に"],["、"],["油","あぶら"],["一","いち"],["ヒン"],["の"],["二分","ぶん"],["の"],["一","いち"],["を"],["混ぜた","まぜた"],["もの"],["を"],["、"],["素","す"],["祭","まつり"],["として"],["、"],["若い","わかい"],["雄牛","おうし"],["と"],["共","とも"],["に"],["ささげ"],["、"]]},{"verse":10,"text":"また、ぶどう酒,しゅ一ヒンの二分,ぶんの一を、灌祭,かんさいとしてささげなければならない。これは火祭,かさいであって、主,しゅに香,こうばしいかおりとするものである。","tok":[["また"],["、"],["ぶどう酒","ぶどうしゅ"],["一","いち"],["ヒン"],["の"],["二分","ぶん"],["の"],["一","いち"],["を"],["、"],["灌祭","かんさい"],["として"],["ささげなければ"],["ならない"],["。"],["これ"],["は"],["火祭","か"],["さい"],["で"],["あって"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["する"],["もの"],["で"],["ある"],["。"]]},{"verse":11,"text":"雄牛,おうし、あるいは雄羊,おひつじ、あるいは小羊,こひつじ、あるいは子,こやぎは、一頭,とうごとに、このようにしなければならない。","tok":[["雄牛","おうし"],["、"],["あるいは"],["雄羊","おひつじ"],["、"],["あるいは"],["小羊","こひつじ"],["、"],["あるいは"],["子やぎ","こやぎ"],["は"],["、"],["一頭","とうごと"],["に"],["、"],["この"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":12,"text":"すなわち、あなたがたのささげる数,かずにてらし、その数,かずにしたがって、一頭,とうごとに、このようにしなければならない。","tok":[["すなわち"],["、"],["あなた"],["がた"],["の"],["ささげる"],["数","かず"],["に"],["てらし"],["、"],["その"],["数","かず"],["に"],["したがって"],["、"],["一頭","とうごと"],["に"],["、"],["この"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":13,"text":"すべて国,くにに生,うまれた者,ものが、火祭,かさいをささげて、主,しゅに香,こうばしいかおりとするときは、このように、これらのことを行,おこなわなければならない。","tok":[["すべて国","すべてくに"],["に"],["生まれた","うまれた"],["者","もの"],["が"],["、"],["火祭","かさい"],["を"],["ささげて"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["する"],["とき"],["は"],["、"],["この"],["よう"],["に"],["、"],["これ"],["ら"],["の"],["こと"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":14,"text":"またあなたがたのうちに寄留,きりゅうしている他国,たこく人,じん、またはあなたがたのうちに、代々,よよながく住,すむ者,ものが、火祭,かさいをささげて、主,しゅに香,こうばしいかおりとしようとする時,ときは、あなたがたがするように、その人,ひともしなければならない。","tok":[["また"],["あなた"],["がた"],["の"],["うち"],["に"],["寄留","きりゅう"],["して"],["いる"],["他国人","たこくじん"],["、"],["また"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["、"],["代々","よ"],["よ"],["ながく"],["住む","すむ"],["者","もの"],["が"],["、"],["火祭","かさい"],["を"],["ささげて"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["しよう"],["と"],["する"],["時","とき"],["は"],["、"],["あなた"],["がた"],["が"],["する"],["よう"],["に"],["、"],["その"],["人","ひと"],["も"],["しなければ"],["ならない"],["。"]]},{"verse":15,"text":"会衆,かいしゅうたる者,ものは、あなたがたも、あなたがたのうちに寄留,きりゅうしている他国,たこく人,じんも、同一,どういつの定,さだめに従,したがわなければならない。これは、あなたがたが代々,よよながく守,まもるべき定,さだめである。他国,たこくの人,ひとも、主,しゅの前,まえには、あなたがたと等,ひとしくなければならない。","tok":[["会衆","かいしゅう"],["たる"],["者","もの"],["は"],["、"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["寄留","きりゅう"],["して"],["いる"],["他国人","たこくじん"],["も"],["、"],["同一","どういつ"],["の"],["定め","さだめ"],["に"],["従わなければ","したがわなければ"],["ならない"],["。"],["これ"],["は"],["、"],["あなた"],["がた"],["が"],["代々","よ"],["よ"],["ながく"],["守","まもる"],["べき"],["定","さだめ"],["で"],["ある"],["。"],["他国","たこく"],["の"],["人","ひと"],["も"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["は"],["、"],["あなた"],["がた"],["と"],["等く","ひとしく"],["なければ"],["ならない"],["。"]]},{"verse":16,"text":"すなわち、あなたがたも、あなたがたのうちに寄留,きりゅうしている他国,たこく人,じんも、同一,どういつの律法,りっぽう、同一,どういつのおきてに従,したがわなければならない』」。","tok":[["すなわち"],["、"],["あなた"],["がた"],["も"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["寄留","きりゅう"],["して"],["いる"],["他国人","たこくじん"],["も"],["、"],["同一","どういつ"],["の"],["律法","りっぽう"],["、"],["同一","どういつ"],["の"],["おきて"],["に"],["従わなければ","したがわなければ"],["ならない"],["』"],["」"],["。"]]},{"verse":17,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":18,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『わたしが導,みちびいて行,いく地,ちに、あなたがたがはいって、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["わたし"],["が"],["導いて","みちびいて"],["行く","いく"],["地","ち"],["に"],["、"],["あなた"],["がた"],["が"],["はいって"],["、"]]},{"verse":19,"text":"その地,ちの食物,しょくもつを食,たべるとき、あなたがたは、ささげ物,ものを主,しゅにささげなければならない。","tok":[["その"],["地","ち"],["の"],["食物","しょくもつ"],["を"],["食べる","たべる"],["とき"],["、"],["あなた"],["がた"],["は"],["、"],["ささげ物","ささげもの"],["を"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"]]},{"verse":20,"text":"すなわち、麦粉,むぎこの初物,はつもので作,つくった菓子,かしを、ささげ物,ものとしなければならない。これを、打,うち場,ばからのささげ物,もののように、ささげなければならない。","tok":[["すなわち"],["、"],["麦粉","むぎこ"],["の"],["初物","はつもの"],["で"],["作った","つくった"],["菓子","かし"],["を"],["、"],["ささげ物","ささげもの"],["と"],["しなければ"],["ならない"],["。"],["これ"],["を"],["、"],["打ち","うち"],["場","ば"],["から"],["の"],["ささげ物","ささげもの"],["の"],["よう"],["に"],["、"],["ささげなければ"],["ならない"],["。"]]},{"verse":21,"text":"あなたがたは代々,よよその麦粉,むぎこの初物,はつもので、主,しゅにささげ物,ものをしなければならない。","tok":[["あなた"],["がた"],["は"],["代々","よよそ"],["の"],["麦粉","むぎこ"],["の"],["初物","はつもの"],["で"],["、"],["主に","しゅに"],["ささげ物","ささげもの"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":22,"text":"あなたがたが、もしあやまって、主,しゅがモーセに告,つげられたこのすべての戒,いましめを行,おこなわず、","tok":[["あなた"],["が"],["た"],["が"],["、"],["もし"],["あやまって"],["、"],["主","しゅ"],["が"],["モーセ"],["に"],["告げられた","つげられた"],["この"],["すべて"],["の"],["戒しめ","いましめ"],["を"],["行なわず","おこなわず"],["、"]]},{"verse":23,"text":"主,しゅがモーセによって戒,いましめを与,あたえられた日,ひからこのかた、代々,よよにわたり、あなたがたに命,めいじられたすべての事,ことを行,おこなわないとき、","tok":[["主","しゅ"],["が"],["モーセ"],["によって"],["戒しめ","いましめ"],["を"],["与えられた","あたえられた"],["日","ひ"],["から"],["このかた"],["、"],["代々","よよ"],["に"],["わたり"],["、"],["あなた"],["がた"],["に"],["命じられた","めいじられた"],["すべて"],["の"],["事","こと"],["を"],["行なわない","おこなわない"],["とき"],["、"]]},{"verse":24,"text":"すなわち、会衆,かいしゅうが知,しらずに、あやまって犯,おかした時,ときは、全,ぜん会衆,かいしゅうは若,わかい雄牛,おうし一頭,とうを、燔祭,はんさいとしてささげ、主,しゅに香,こうばしいかおりとし、これに素祭,そさいと灌祭,かんさいとを定,さだめのように加,くわえ、また雄,おやぎ一頭,とうを、罪祭,ざいさいとしてささげなければならない。","tok":[["すなわち"],["、"],["会衆","かいしゅう"],["が"],["知らず","しらず"],["に"],["、"],["あやまって"],["犯した","おかした"],["時","とき"],["は"],["、"],["全","ぜん"],["会衆","かいしゅう"],["は"],["若い","わかい"],["雄牛","おうし"],["一頭","とう"],["を"],["、"],["燔祭","はんさい"],["として"],["ささげ"],["、"],["主に","しゅに"],["香ばしい","こうばしい"],["かおり"],["と"],["し"],["、"],["これ"],["に"],["素","す"],["祭","まつり"],["と"],["灌祭","かんさい"],["と"],["を"],["定め","さだめ"],["の"],["よう"],["に"],["加え","くわえ"],["、"],["また"],["雄","お"],["やぎ"],["一頭","とう"],["を"],["、"],["罪","つみ"],["祭","まつり"],["として"],["ささげなければ"],["ならない"],["。"]]},{"verse":25,"text":"そして祭司,さいしは、イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうのために、罪,つみのあがないをしなければならない。そうすれば、彼,かれらはゆるされるであろう。それは過失,かしつだからである。彼,かれらはその過失,かしつのために、その供,そなえ物,ものとして、火祭,かさいを主,しゅにささげ、また罪祭,ざいさいを主,しゅの前,まえにささげなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["の"],["ため"],["に"],["、"],["罪","つみ"],["の"],["あ"],["が"],["ない"],["を"],["しなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["ら"],["は"],["ゆるされるで"],["あろう"],["。"],["それ"],["は"],["過失","かしつ"],["だ"],["から"],["で"],["ある"],["。"],["彼","かれ"],["ら"],["は"],["その"],["過失","かしつ"],["の"],["ため"],["に"],["、"],["その"],["供え物","そなえもの"],["として"],["、"],["火祭","かさい"],["を"],["主に","しゅに"],["ささげ"],["、"],["また"],["罪","つみ"],["祭","まつり"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["ささげなければ"],["ならない"],["。"]]},{"verse":26,"text":"そうすれば、イスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうはゆるされ、また彼,かれらのうちに寄留,きりゅうしている他国,たこく人,じんも、ゆるされるであろう。民,たみはみな過失,かしつを犯,おかしたからである。","tok":[["そう"],["すれば"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["は"],["ゆるされ"],["、"],["また"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["寄留","きりゅう"],["して"],["いる"],["他国人","たこくじん"],["も"],["、"],["ゆるされるで"],["あろう"],["。"],["民","たみ"],["は"],["みな"],["過失","かしつ"],["を"],["犯した","おかした"],["から"],["で"],["ある"],["。"]]},{"verse":27,"text":"もし人,ひとがあやまって罪,つみを犯,おかす時,ときは、一歳,さいの雌,めやぎ一頭,とうを罪祭,ざいさいとしてささげなければならない。","tok":[["もし"],["人","ひと"],["が"],["あやまって"],["罪","つみ"],["を"],["犯す","おかす"],["時","とき"],["は"],["、"],["一歳","さい"],["の"],["雌","め"],["やぎ"],["一頭","とう"],["を"],["罪","つみ"],["祭","まつり"],["として"],["ささげなければ"],["ならない"],["。"]]},{"verse":28,"text":"そして祭司,さいしは、人,ひとがあやまって罪,つみを犯,おかした時,とき、そのあやまって罪,つみを犯,おかした人,ひとのために、主,しゅの前,まえに罪,つみのあがないをして、その罪,つみをあがなわなければならない。そうすれば、彼,かれはゆるされるであろう。","tok":[["そして"],["祭司","さいし"],["は"],["、"],["人","ひと"],["が"],["あやまって"],["罪","つみ"],["を"],["犯した","おかした"],["時","とき"],["、"],["その"],["あやまって"],["罪","つみ"],["を"],["犯した","おかした"],["人","ひと"],["の"],["ため"],["に"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["罪","つみ"],["の"],["あ"],["が"],["ない"],["を"],["して"],["、"],["その"],["罪","つみ"],["を"],["あがなわなければ"],["ならない"],["。"],["そう"],["すれば"],["、"],["彼","かれ"],["は"],["ゆるされるで"],["あろう"],["。"]]},{"verse":29,"text":"イスラエルの人々,ひとびとのうちの、国,くにに生,うまれた者,ものでも、そのうちに寄留,きりゅうしている他国,たこく人,じんでも、あやまって罪,つみを犯,おかす者,ものには、あなたがたは同一,どういつの律法,りっぽうを用,もちいなければならない。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["の"],["、"],["国","くに"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["も"],["、"],["その"],["うち"],["に"],["寄留","きりゅう"],["して"],["いる"],["他国人","たこくじん"],["で"],["も"],["、"],["あやまって"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["に"],["は"],["、"],["あなた"],["がた"],["は"],["同一","どういつ"],["の"],["律法","りっぽう"],["を"],["用いなければ","もちいなければ"],["ならない"],["。"]]},{"verse":30,"text":"しかし、国,くにに生,うまれた者,ものでも、他国,たこくの人,ひとでも、故意,こいに罪,つみを犯,おかす者,ものは主,しゅを汚,けがすもので、その人,ひとは民,たみのうちから断,たたれなければならない。","tok":[["しかし"],["、"],["国","くに"],["に"],["生まれた","うまれた"],["者","もの"],["で"],["も"],["、"],["他国","たこく"],["の"],["人","ひと"],["で"],["も"],["、"],["故意","こい"],["に"],["罪","つみ"],["を"],["犯す","おかす"],["者","もの"],["は"],["主","しゅ"],["を"],["汚す","けがす"],["もの"],["で"],["、"],["その"],["人","ひと"],["は"],["民","たみ"],["の"],["うち"],["から"],["断たれなければ","たたれなければ"],["ならない"],["。"]]},{"verse":31,"text":"彼,かれは主,しゅの言葉,ことばを侮,あなどり、その戒,いましめを破,やぶったのであるから、必,かならず断,たたれ、その罪,つみを負,おわなければならない』」。","tok":[["彼","かれ"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["侮","あなどり"],["、"],["その"],["戒しめ","いましめ"],["を"],["破った","やぶった"],["ので"],["ある"],["から"],["、"],["必","かならず"],["断たれ","たたれ"],["、"],["その"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["』"],["」"],["。"]]},{"verse":32,"text":"イスラエルの人々,ひとびとが荒野,あらのにおるとき、安息日,あんそくにちにひとりの人,ひとが、たきぎを集,あつめるのを見,みた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["荒野","あらの"],["に"],["おる"],["とき"],["、"],["安息日","あんそくにち"],["に"],["ひとり"],["の"],["人","ひと"],["が"],["、"],["たきぎ"],["を"],["集める","あつめる"],["の"],["を"],["見た","みた"],["。"]]},{"verse":33,"text":"そのたきぎを集,あつめるのを見,みた人々,ひとびとは、その人,ひとをモーセとアロン、および全,ぜん会衆,かいしゅうのもとに連,つれてきたが、","tok":[["その"],["たきぎ"],["を"],["集める","あつめる"],["の"],["を"],["見た","みた"],["人々","ひとびと"],["は"],["、"],["その"],["人","ひと"],["を"],["モーセ"],["と"],["アロン"],["、"],["および"],["全","ぜん"],["会衆","かいしゅう"],["の"],["もと"],["に"],["連れて","つれて"],["きた"],["が"],["、"]]},{"verse":34,"text":"どう取,とり扱,あつかうべきか、まだ示,しめしを受,うけていなかったので、彼,かれを閉,とじ込,こめておいた。","tok":[["どう"],["取扱うべき","とりあつかうべき"],["か"],["、"],["まだ"],["示めし","しめし"],["を"],["受て","うけて"],["いなかった"],["ので"],["、"],["彼","かれ"],["を"],["閉じ込めて","とじこめて"],["おいた"],["。"]]},{"verse":35,"text":"そのとき、主,しゅはモーセに言,いわれた、「その人,ひとは必,かならず殺,ころされなければならない。全,ぜん会衆,かいしゅうは宿営,しゅくえいの外,そとで、彼,かれを石,いしで撃,うち殺,ころさなければならない」。","tok":[["その"],["とき"],["、"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["その"],["人","ひと"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["全","ぜん"],["会衆","かいしゅう"],["は"],["宿営","しゅくえい"],["の"],["外","そと"],["で"],["、"],["彼","かれ"],["を"],["石","いし"],["で"],["撃ち","うち"],["殺ろさなければ","ころさなければ"],["ならない"],["」"],["。"]]},{"verse":36,"text":"そこで、全,ぜん会衆,かいしゅうは彼,かれを宿営,しゅくえいの外,そとに連,つれ出,だし、彼,かれを石,いしで撃,うち殺,ころし、主,しゅがモーセに命,めいじられたようにした。","tok":[["そこ"],["で"],["、"],["全","ぜん"],["会衆","かいしゅう"],["は"],["彼","かれ"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["連れ出し","つれだし"],["、"],["彼","かれ"],["を"],["石","いし"],["で"],["撃ち殺し","うちころし"],["、"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["よう"],["に"],["した"],["。"]]},{"verse":37,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":38,"text":"「イスラエルの人々,ひとびとに命,めいじて、代々,よよその衣服,いふくのすその四すみにふさをつけ、そのふさを青,あおひもで、すその四すみにつけさせなさい。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じて","めいじて"],["、"],["代々","よよそ"],["の"],["衣服","いふく"],["の"],["すそ"],["の"],["四","よん"],["すみ"],["に"],["ふさ"],["を"],["つけ"],["、"],["その"],["ふさ"],["を"],["青","あお"],["ひも"],["で"],["、"],["すそ"],["の"],["四","よん"],["すみ"],["に"],["つけさせ"],["なさい"],["。"]]},{"verse":39,"text":"あなたがたが、そのふさを見,みて、主,しゅのもろもろの戒,いましめを思,おもい起,おこして、それを行,おこない、あなたがたが自分,じぶんの心,こころと、目,めの欲,よくに従,したがって、みだらな行,おこないをしないためである。","tok":[["あなた"],["が"],["た"],["が"],["、"],["その"],["ふさ"],["を"],["見て","みて"],["、"],["主","しゅ"],["の"],["もろもろ"],["の"],["戒しめ","いましめ"],["を"],["思い起こして","おもいおこして"],["、"],["それ"],["を"],["行ない","おこない"],["、"],["あなた"],["がた"],["が"],["自分","じぶん"],["の"],["心","こころ"],["と"],["、"],["目","め"],["の"],["欲","よく"],["に"],["従って","したがって"],["、"],["みだら"],["な"],["行ない","おこない"],["を"],["しない"],["ため"],["で"],["ある"],["。"]]},{"verse":40,"text":"こうして、あなたがたは、わたしのもろもろの戒,いましめを思,おもい起,おこして、それを行,おこない、あなたがたの神,かみに聖,せいなる者,ものとならなければならない。","tok":[["こう"],["して"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["の"],["もろもろ"],["の"],["戒しめ","いましめ"],["を"],["思い起こして","おもいおこして"],["、"],["それ"],["を"],["行ない","おこない"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["に"],["聖","せい"],["なる"],["者","もの"],["と"],["ならなければ"],["ならない"],["。"]]},{"verse":41,"text":"わたしはあなたがたの神,かみ、主,しゅであって、あなたがたの神,かみとなるために、あなたがたをエジプトの国,くにから導,みちびき出,だした者,ものである。わたしはあなたがたの神,かみ、主,しゅである」。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["あって"],["、"],["あなた"],["がた"],["の"],["神","かみ"],["と"],["なる"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["エジプト"],["の"],["国","くに"],["から"],["導き出した","みちびきだした"],["者","もの"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅ"],["で"],["ある"],["」"],["。"]]}]
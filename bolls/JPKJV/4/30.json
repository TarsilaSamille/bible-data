[{"verse":1,"text":"[29:40]モーセは主,しゅが命,めいじられた事,ことをことごとくイスラエルの人々,ひとびとに告,つげた。","tok":[["["],["29"],[":"],["40"],["]"],["モーセ"],["は"],["主","しゅ"],["が"],["命じられた","めいじられた"],["事","こと"],["を"],["ことごとく"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["た"],["。"]]},{"verse":2,"text":"[1]モーセはイスラエルの人々,ひとびとの部族,ぶぞくのかしらたちに言,いった、「これは主,しゅが命,めいじられた事,ことである。","tok":[["["],["1"],["]"],["モーセ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["部族","ぶぞく"],["の"],["かしら"],["たち"],["に"],["言った","いった"],["、"],["「"],["これ"],["は"],["主","しゅ"],["が"],["命じられた","めいじられた"],["事","こと"],["で"],["ある"],["。"]]},{"verse":3,"text":"[2]もし人,ひとが主,しゅに誓願,せいがんをかけ、またはその身,みに物,もの断,だちをしようと誓,ちかいをするならば、その言葉,ことばを破,やぶってはならない。口,くちで言,いったとおりにすべて行,おこなわなければならない。","tok":[["["],["2"],["]"],["もし"],["人","ひと"],["が"],["主に","しゅに"],["誓願","せいがん"],["を"],["かけ"],["、"],["また"],["は"],["その"],["身","み"],["に"],["物","もの"],["断","だち"],["を"],["しよう"],["と"],["誓い","ちかい"],["を"],["するならば"],["、"],["その"],["言葉","ことば"],["を"],["破って","やぶって"],["は"],["ならない"],["。"],["口","くち"],["で"],["言った","いった"],["とおり"],["に"],["すべて"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":4,"text":"[3]またもし女,おんながまだ若,わかく、父,ちちの家,いえにいて、主,しゅに誓願,せいがんをかけ、またはその身,みに物,もの断,だちをしようとする時,とき、","tok":[["["],["3"],["]"],["また"],["もし"],["女","おんな"],["が"],["まだ"],["若く","わかく"],["、"],["父","ちち"],["の"],["家","いえ"],["に"],["いて"],["、"],["主に","しゅに"],["誓願","せいがん"],["を"],["かけ"],["、"],["また"],["は"],["その"],["身","み"],["に"],["物","もの"],["断","だち"],["を"],["しよう"],["と"],["する"],["時","とき"],["、"]]},{"verse":5,"text":"[4]父,ちちが彼女,かのじょの誓願,せいがん、または彼女,かのじょの身,みに断,たった物,もの断,だちのことを聞,きいて、彼女,かのじょに何,なにも言,いわないならば、彼女,かのじょはすべて誓願,せいがんを行,おこない、またその身,みに断,たった物,もの断,だちをすべて守,まもらなければならない。","tok":[["["],["4"],["]"],["父","ちち"],["が"],["彼女","かのじょ"],["の"],["誓願","せいがん"],["、"],["また"],["は"],["彼女","かのじょ"],["の"],["身","み"],["に"],["断った","たった"],["物","もの"],["断","だち"],["の"],["こと"],["を"],["聞いて","きいて"],["、"],["彼女","かのじょ"],["に"],["何に","なに"],["も"],["言わないならば","いわないならば"],["、"],["彼女","かのじょ"],["は"],["すべて"],["誓願","せいがん"],["を"],["行ない","おこない"],["、"],["また"],["その"],["身","み"],["に"],["断った","たった"],["物","もの"],["断","だち"],["を"],["すべて"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":6,"text":"[5]しかし、彼女,かのじょの父,ちちがそれを聞,きいた日,ひに、それを承認,しょうにんしない時,ときは、彼女,かのじょはその誓願,せいがん、またはその身,みに断,たった物,もの断,だちをすべてやめることができる。父,ちちが承認,しょうにんしないのであるから、主,しゅは彼女,かのじょをゆるされるであろう。","tok":[["["],["5"],["]"],["しかし"],["、"],["彼女","かのじょ"],["の"],["父","ちち"],["が"],["それ"],["を"],["聞いた","きいた"],["日","ひ"],["に"],["、"],["それ"],["を"],["承認","しょうにん"],["しない"],["時","とき"],["は"],["、"],["彼女","かのじょ"],["は"],["その"],["誓願","せいがん"],["、"],["また"],["は"],["その"],["身","み"],["に"],["断った","たった"],["物","もの"],["断","だち"],["を"],["すべて"],["やめる"],["こと"],["が"],["できる"],["。"],["父","ちち"],["が"],["承認","しょうにん"],["しない"],["ので"],["ある"],["から"],["、"],["主","しゅ"],["は"],["彼女","かのじょ"],["を"],["ゆるされるで"],["あろう"],["。"]]},{"verse":7,"text":"[6]またもし夫,おっとのある身,みで、みずから誓願,せいがんをかけ、またはその身,みに物,もの断,だちをしようと、軽々,かるがるしく口,くちで言,いった場合,ばあい、","tok":[["["],["6"],["]"],["また"],["もし"],["夫","おっと"],["の"],["ある"],["身","み"],["で"],["、"],["みずから"],["誓願","せいがん"],["を"],["かけ"],["、"],["また"],["は"],["その"],["身","み"],["に"],["物","もの"],["断","だち"],["を"],["しよう"],["と"],["、"],["軽々しく","かるがるしく"],["口","くち"],["で"],["言った","いった"],["場合","ばあい"],["、"]]},{"verse":8,"text":"[7]夫,おっとがそれを聞,きき、それを聞,きいた日,ひに彼女,かのじょに何,なにも言,いわないならば、彼女,かのじょはその誓願,せいがんを行,おこない、その身,みに断,たった物,もの断,だちを守,まもらなければならない。","tok":[["["],["7"],["]"],["夫","おっと"],["が"],["それ"],["を"],["聞","きき"],["、"],["それ"],["を"],["聞いた","きいた"],["日","ひ"],["に"],["彼女","かのじょ"],["に"],["何に","なに"],["も"],["言わないならば","いわないならば"],["、"],["彼女","かのじょ"],["は"],["その"],["誓願","せいがん"],["を"],["行ない","おこない"],["、"],["その"],["身","み"],["に"],["断った","たった"],["物","もの"],["断","だち"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":9,"text":"[8]しかし、もし夫,おっとがそれを聞,きいた日,ひに、それを承認,しょうにんしないならば、夫,おっとはその女,おんながかけた誓願,せいがん、またはその身,みに物,もの断,だちをしようと、軽々,かるがるしく口,くちに言,いったことをやめさせることができる。主,しゅはその女,おんなをゆるされるであろう。","tok":[["["],["8"],["]"],["しかし"],["、"],["もし"],["夫","おっと"],["が"],["それ"],["を"],["聞いた","きいた"],["日","ひ"],["に"],["、"],["それ"],["を"],["承認","しょうにん"],["しないならば"],["、"],["夫","おっと"],["は"],["その"],["女","おんな"],["が"],["かけた"],["誓願","せいがん"],["、"],["また"],["は"],["その"],["身","み"],["に"],["物","もの"],["断","だち"],["を"],["しよう"],["と"],["、"],["軽々しく","かるがるしく"],["口","くち"],["に"],["言った","いった"],["こと"],["を"],["やめさせる"],["こと"],["が"],["できる"],["。"],["主","しゅ"],["は"],["その"],["女","おんな"],["を"],["ゆるされるで"],["あろう"],["。"]]},{"verse":10,"text":"[9]しかし、寡婦,かふあるいは離縁,りえんされた女,おんなの誓願,せいがん、すべてその身,みに断,たった物,もの断,だちは、それを守,まもらなければならない。","tok":[["["],["9"],["]"],["しかし"],["、"],["寡婦","かふ"],["あるいは"],["離縁","りえん"],["された"],["女","おんな"],["の"],["誓願","せいがん"],["、"],["すべて"],["その"],["身","み"],["に"],["断った","たった"],["物","もの"],["断","だち"],["は"],["、"],["それ"],["を"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":11,"text":"[10]もし女,おんなが夫,おっとの家,いえで誓願,せいがんをかけ、またはその身,みに物,もの断,だちをしようと誓,ちかった時,とき、","tok":[["["],["10"],["]"],["もし"],["女","おんな"],["が"],["夫","おっと"],["の"],["家","いえ"],["で"],["誓願","せいがん"],["を"],["かけ"],["、"],["また"],["は"],["その"],["身","み"],["に"],["物","もの"],["断","だち"],["を"],["しよう"],["と"],["誓った","ちかった"],["時","とき"],["、"]]},{"verse":12,"text":"[11]夫,おっとがそれを聞,きいて、彼女,かのじょに何,なにも言,いわず、またそれに反対,はんたいしないならば、その誓願,せいがんはすべて行,おこなわなければならない。またその身,みに断,たった物,もの断,だちはすべて守,まもらなければならない。","tok":[["["],["11"],["]"],["夫","おっと"],["が"],["それ"],["を"],["聞いて","きいて"],["、"],["彼女","かのじょ"],["に"],["何に","なに"],["も"],["言わず","いわず"],["、"],["また"],["それ"],["に"],["反対","はんたい"],["しないならば"],["、"],["その"],["誓願","せいがん"],["は"],["すべて"],["行なわなければ","おこなわなければ"],["ならない"],["。"],["また"],["その"],["身","み"],["に"],["断った","たった"],["物","もの"],["断","だち"],["は"],["すべて"],["守らなければ","まもらなければ"],["ならない"],["。"]]},{"verse":13,"text":"[12]しかし、もし夫,おっとがそれを聞,きいた日,ひにそれを認,みとめないならば、彼女,かのじょの誓願,せいがん、または身,みの物,もの断,だちについて、彼女,かのじょが口,くちで言,いった事,ことは、すべてやめることができる。夫,おっとがそれを認,みとめなかったのだから、主,しゅはその女,おんなをゆるされるであろう。","tok":[["["],["12"],["]"],["しかし"],["、"],["もし"],["夫","おっと"],["が"],["それ"],["を"],["聞いた","きいた"],["日","ひ"],["に"],["それ"],["を"],["認めないならば","みとめないならば"],["、"],["彼女","かのじょ"],["の"],["誓願","せいがん"],["、"],["また"],["は"],["身","み"],["の"],["物","もの"],["断","だち"],["について"],["、"],["彼女","かのじょ"],["が"],["口","くち"],["で"],["言った","いった"],["事","こと"],["は"],["、"],["すべて"],["やめる"],["こと"],["が"],["できる"],["。"],["夫","おっと"],["が"],["それ"],["を"],["認めなかった","みとめなかった"],["の"],["だ"],["から"],["、"],["主","しゅ"],["は"],["その"],["女","おんな"],["を"],["ゆるされるで"],["あろう"],["。"]]},{"verse":14,"text":"[13]すべての誓願,せいがんおよびすべてその身,みを悩,なやます物,もの断,だちの誓約,せいやくは、夫,おっとがそれを守,まもらせることができ、または夫,おっとがそれをやめさせることができる。","tok":[["["],["13"],["]"],["すべて"],["の"],["誓願","せいがん"],["および"],["すべて"],["その"],["身","み"],["を"],["悩す","なやます"],["物","もの"],["断","だち"],["の"],["誓約","せいやく"],["は"],["、"],["夫","おっと"],["が"],["それ"],["を"],["守らせる","まもらせる"],["こと"],["が"],["でき"],["、"],["また"],["は"],["夫","おっと"],["が"],["それ"],["を"],["やめさせる"],["こと"],["が"],["できる"],["。"]]},{"verse":15,"text":"[14]もし夫,おっとが彼女,かのじょに何,なにも言,いわずに日,ひを送,おくるならば、彼,かれは妻,つまがした誓願,せいがん、または物,もの断,だちをすべて認,みとめたのである。彼,かれはそれを聞,きいた日,ひに妻,つまに何,なにも言,いわなかったのだから、それを認,みとめたのである。","tok":[["["],["14"],["]"],["もし"],["夫","おっと"],["が"],["彼女","かのじょ"],["に"],["何に","なに"],["も"],["言わず","いわず"],["に"],["日","ひ"],["を"],["送るならば","おくるならば"],["、"],["彼","かれ"],["は"],["妻","つま"],["が"],["した"],["誓願","せいがん"],["、"],["また"],["は"],["物","もの"],["断","だち"],["を"],["すべて"],["認めた","みとめた"],["ので"],["ある"],["。"],["彼","かれ"],["は"],["それ"],["を"],["聞いた","きいた"],["日","ひ"],["に"],["妻","つま"],["に"],["何に","なに"],["も"],["言わなかった","いわなかった"],["の"],["だ"],["から"],["、"],["それ"],["を"],["認めた","みとめた"],["ので"],["ある"],["。"]]},{"verse":16,"text":"[15]しかし、もし夫,おっとがそれを聞,きき、あとになって、それを認,みとめないならば、彼,かれは妻,つまの罪,つみを負,おわなければならない」。","tok":[["["],["15"],["]"],["しかし"],["、"],["もし"],["夫","おっと"],["が"],["それ"],["を"],["聞","きき"],["、"],["あと"],["に"],["なって"],["、"],["それ"],["を"],["認めないならば","みとめないならば"],["、"],["彼","かれ"],["は"],["妻","つま"],["の"],["罪","つみ"],["を"],["負わなければ","おわなければ"],["ならない"],["」"],["。"]]},{"verse":17,"text":"[16]これらは主,しゅがモーセに命,めいじられた定,さだめであって、夫,おっとと妻,つまとの間,あいだ、および父,ちちとまだ若,わかくて父,ちちの家,いえにいる娘,むすめとの間,あいだに関,かんするものである。","tok":[["["],["16"],["]"],["これ"],["ら"],["は"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["定め","さだめ"],["で"],["あって"],["、"],["夫","おっと"],["と"],["妻","つま"],["と"],["の"],["間","あいだ"],["、"],["および"],["父","ちち"],["と"],["まだ"],["若くて","わかくて"],["父","ちち"],["の"],["家","いえ"],["に"],["いる"],["娘","むすめ"],["と"],["の"],["間","あいだ"],["に"],["関する","かんする"],["もの"],["で"],["ある"],["。"]]}]
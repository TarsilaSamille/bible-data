[{"verse":1,"text":"主,しゅがシナイ山,さんで、モーセと語,かたられた時,ときの、アロンとモーセの一族,いちぞくは、次,つぎのとおりであった。","tok":[["主","しゅ"],["が"],["シナイ"],["山","さん"],["で"],["、"],["モーセ"],["と"],["語られた","かたられた"],["時","とき"],["の"],["、"],["アロン"],["と"],["モーセ"],["の"],["一族","いちぞく"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["あった"],["。"]]},{"verse":2,"text":"アロンの子,こたちの名,なは、次,つぎのとおりである。長子,ちょうしはナダブ、次,つぎはアビウ、エレアザル、イタマル。","tok":[["アロン"],["の"],["子","こ"],["たち"],["の"],["名","な"],["は"],["、"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["長子","ちょうし"],["は"],["ナダブ"],["、"],["次","つぎ"],["は"],["アビウ"],["、"],["エレアザル"],["、"],["イタマル"],["。"]]},{"verse":3,"text":"これがアロンの子,こたちの名,なであって、彼,かれらはみな油,あぶらを注,そそがれ、祭司,さいしの職,しょくに任,にんじられて祭司,さいしとなった。","tok":[["これ"],["が"],["アロン"],["の"],["子","こ"],["たち"],["の"],["名","な"],["で"],["あって"],["、"],["彼","かれ"],["ら"],["は"],["みな"],["油","あぶら"],["を"],["注がれ","そそがれ"],["、"],["祭司","さいし"],["の"],["職","しょく"],["に"],["任じられて","にんじられて"],["祭司","さいし"],["と"],["なった"],["。"]]},{"verse":4,"text":"ナダブとアビウとは、シナイの荒野,あらのにおいて、異火,ことびを主,しゅの前,まえにささげたので、主,しゅの前,まえで死,しんだ。彼,かれらには子供,こどもがなかった。そしてエレアザルとイタマルとが、父,ちちアロンの前,まえで祭司,さいしの務,つとめをした。","tok":[["ナダブ"],["と"],["アビウ"],["と"],["は"],["、"],["シナイ"],["の"],["荒野","あらの"],["に"],["おいて"],["、"],["異","い"],["火","か"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["ささげた"],["ので"],["、"],["主","しゅ"],["の"],["前","まえ"],["で"],["死んだ","しんだ"],["。"],["彼","かれ"],["ら"],["に"],["は"],["子供","こども"],["が"],["なかった"],["。"],["そして"],["エレアザル"],["と"],["イタマル"],["と"],["が"],["、"],["父","ちち"],["アロン"],["の"],["前","まえ"],["で"],["祭司","さいし"],["の"],["務め","つとめ"],["を"],["した"],["。"]]},{"verse":5,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":6,"text":"「レビの部族,ぶぞくを召,めし寄,よせ、祭司,さいしアロンの前,まえに立,たって仕,つかえさせなさい。","tok":[["「"],["レビ"],["の"],["部族","ぶぞく"],["を"],["召寄せ","めしよせ"],["、"],["祭司","さいし"],["アロン"],["の"],["前","まえ"],["に"],["立って","たって"],["仕えさせ","つかえさせ"],["なさい"],["。"]]},{"verse":7,"text":"彼,かれらは会見,かいけんの幕屋,まくやの前,まえにあって、アロンと全,ぜん会衆,かいしゅうのために、その務,つとめをし、幕屋,まくやの働,はたらきをしなければならない。","tok":[["彼","かれ"],["ら"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["前","まえ"],["に"],["あって"],["、"],["アロン"],["と"],["全","ぜん"],["会衆","かいしゅう"],["の"],["ため"],["に"],["、"],["その"],["務め","つとめ"],["を"],["し"],["、"],["幕屋","まくや"],["の"],["働らき","はたらき"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":8,"text":"すなわち、彼,かれらは会見,かいけんの幕屋,まくやの、すべての器,うつわをまもり、イスラエルの人々,ひとびとのために務,つとめをし、幕屋,まくやの働,はたらきをしなければならない。","tok":[["すなわち"],["、"],["彼","かれ"],["ら"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["、"],["すべて"],["の"],["器","うつわ"],["を"],["まもり"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["務め","つとめ"],["を"],["し"],["、"],["幕屋","まくや"],["の"],["働らき","はたらき"],["を"],["しなければ"],["ならない"],["。"]]},{"verse":9,"text":"あなたはレビびとを、アロンとその子,こたちとに、与,あたえなければならない。彼,かれらはイスラエルの人々,ひとびとのうちから、全,まったくアロンに与,あたえられたものである。","tok":[["あなた"],["は"],["レビ"],["びと"],["を"],["、"],["アロン"],["と"],["その"],["子","こ"],["たち"],["と"],["に"],["、"],["与えなければ","あたえなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["から"],["、"],["全く","まったく"],["アロン"],["に"],["与えられた","あたえられた"],["もの"],["で"],["ある"],["。"]]},{"verse":10,"text":"あなたはアロンとその子,こたちとを立,たてて、祭司,さいしの職,しょくを守,まもらせなければならない。ほかの人,ひとで近,ちかづくものは殺,ころされるであろう」。","tok":[["あなた"],["は"],["アロン"],["と"],["その"],["子","こ"],["たち"],["と"],["を"],["立てて","たてて"],["、"],["祭司","さいし"],["の"],["職","しょく"],["を"],["守らせなければ","まもらせなければ"],["ならない"],["。"],["ほか"],["の"],["人","ひと"],["で"],["近づく","ちかづく"],["もの"],["は"],["殺ろされるで","ころされるで"],["あろう"],["」"],["。"]]},{"verse":11,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":12,"text":"「わたしは、イスラエルの人々,ひとびとのうちの初,はじめに生,うまれたすべてのういごの代,かわりに、レビびとをイスラエルの人々,ひとびとのうちから取,とるであろう。レビびとは、わたしのものとなるであろう。","tok":[["「"],["わたし"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["の"],["初め","はじめ"],["に"],["生まれた","うまれた"],["すべて"],["の"],["うい"],["ご"],["の"],["代わり","かわり"],["に"],["、"],["レビ"],["びと"],["を"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["から"],["取るで","とるで"],["あろう"],["。"],["レビ"],["び"],["と"],["は"],["、"],["わたし"],["の"],["もの"],["と"],["なるで"],["あろう"],["。"]]},{"verse":13,"text":"ういごはすべてわたしのものだからである。わたしは、エジプトの国,くににおいて、すべてのういごを撃,うち殺,ころした日,ひに、イスラエルのういごを、人,ひとも獣,けものも、ことごとく聖別,せいべつして、わたしに帰,きせしめた。彼,かれらはわたしのものとなるであろう。わたしは主,しゅである」。","tok":[["うい"],["ご"],["は"],["すべて"],["わたし"],["の"],["もの"],["だ"],["から"],["で"],["ある"],["。"],["わたし"],["は"],["、"],["エジプト"],["の"],["国","くに"],["に"],["おいて"],["、"],["すべて"],["の"],["うい"],["ご"],["を"],["撃ち殺した","うちころした"],["日","ひ"],["に"],["、"],["イスラエル"],["の"],["うい"],["ご"],["を"],["、"],["人","ひと"],["も"],["獣","けもの"],["も"],["、"],["ことごとく"],["聖別","せいべつ"],["して"],["、"],["わたし"],["に"],["帰せしめた","きせしめた"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["の"],["もの"],["と"],["なるで"],["あろう"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["」"],["。"]]},{"verse":14,"text":"主,しゅはまたシナイの荒野,あらのでモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["シナイ"],["の"],["荒野","あらの"],["で"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":15,"text":"「あなたはレビの子,こたちを、その父祖,ふその家,いえにより、その氏族,しぞくによって数,かぞえなさい。すなわち、一か月,げつ以上,いじょうの男子,だんしを数,かぞえなければならない」。","tok":[["「"],["あなた"],["は"],["レビ"],["の"],["子","こ"],["たち"],["を"],["、"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["より"],["、"],["その"],["氏族","しぞく"],["によって"],["数え","かぞえ"],["なさい"],["。"],["すなわち"],["、"],["一","いち"],["か月","かげつ"],["以上","いじょう"],["の"],["男子","だんし"],["を"],["数えなければ","かぞえなければ"],["ならない"],["」"],["。"]]},{"verse":16,"text":"それでモーセは主,しゅの言葉,ことばにしたがって、命,めいじられたとおりに、それを数,かぞえた。","tok":[["それ"],["で"],["モーセ"],["は"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["したがって"],["、"],["命じられた","めいじられた"],["とおり"],["に"],["、"],["それ"],["を"],["数えた","かぞえた"],["。"]]},{"verse":17,"text":"レビの子,こたちの名,なは次,つぎのとおりである。すなわち、ゲルション、コハテ、メラリ。","tok":[["レビ"],["の"],["子","こ"],["たち"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["ゲルション"],["、"],["コハテ"],["、"],["メラリ"],["。"]]},{"verse":18,"text":"ゲルションの子,こたちの名,なは、その氏族,しぞくによれば次,つぎのとおりである。すなわち、リブニ、シメイ。","tok":[["ゲルション"],["の"],["子","こ"],["たち"],["の"],["名","な"],["は"],["、"],["その"],["氏族","しぞく"],["に"],["よれば"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["すなわち"],["、"],["リブニ"],["、"],["シメイ"],["。"]]},{"verse":19,"text":"コハテの子,こたちは、その氏族,しぞくによれば、アムラム、イヅハル、ヘブロン、ウジエル。","tok":[["コハテ"],["の"],["子","こ"],["たち"],["は"],["、"],["その"],["氏族","しぞく"],["に"],["よれば"],["、"],["アムラム"],["、"],["イヅハル"],["、"],["ヘブロン"],["、"],["ウジエル"],["。"]]},{"verse":20,"text":"メラリの子,こたちは、その氏族,しぞくによれば、マヘリ、ムシ。これらはその父祖,ふその家,いえによるレビの氏族,しぞくである。","tok":[["メラリ"],["の"],["子","こ"],["たち"],["は"],["、"],["その"],["氏族","しぞく"],["に"],["よれば"],["、"],["マヘリ"],["、"],["ムシ"],["。"],["これ"],["ら"],["は"],["その"],["父祖","ふそ"],["の"],["家","いえ"],["に"],["よる"],["レビ"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":21,"text":"ゲルションからリブニびとの氏族,しぞくと、シメイびとの氏族,しぞくとが出,でた。これらはゲルションびとの氏族,しぞくである。","tok":[["ゲルション"],["から"],["リブニ"],["びと"],["の"],["氏族","しぞく"],["と"],["、"],["シメイ"],["びと"],["の"],["氏族","しぞく"],["と"],["が"],["出た","でた"],["。"],["これ"],["ら"],["は"],["ゲルション"],["びと"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":22,"text":"その数,かぞえられた者,もの、すなわち、一か月,げつ以上,いじょうの男子,だんしの数,かずは合,あわせて七千五百人,にんであった。","tok":[["その"],["数えられた","かぞえられた"],["者","もの"],["、"],["すなわち"],["、"],["一","いち"],["か月","かげつ"],["以上","いじょう"],["の"],["男子","だんし"],["の"],["数","かず"],["は"],["合","あわせ"],["て"],["七千五百","ななせんごひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":23,"text":"ゲルションびとの氏族,しぞくは幕屋,まくやの後方,こうほう、すなわち、西,にしの方,ほうに宿営,しゅくえいし、","tok":[["ゲルション"],["びと"],["の"],["氏族","しぞく"],["は"],["幕屋","まくや"],["の"],["後方","こうほう"],["、"],["すなわち"],["、"],["西","にし"],["の"],["方","ほう"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":24,"text":"ラエルの子,こエリアサフが、ゲルションびとの父祖,ふその家,いえのつかさとなるであろう。","tok":[["ラエル"],["の"],["子","こ"],["エリアサフ"],["が"],["、"],["ゲルション"],["びと"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":25,"text":"会見,かいけんの幕屋,まくやの、ゲルションの子,こたちの務,つとめは、幕屋,まくや、天幕,てんまくとそのおおい、会見,かいけんの幕屋,まくやの入口,いりぐちのとばり、","tok":[["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["、"],["ゲルション"],["の"],["子","こ"],["たち"],["の"],["務め","つとめ"],["は"],["、"],["幕屋","まくや"],["、"],["天幕","てんまく"],["と"],["その"],["おおい"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["の"],["とばり"],["、"]]},{"verse":26,"text":"庭,にわのあげばり、幕屋,まくやと祭壇,さいだんのまわりの庭,にわの入口,いりぐちのとばり、そのひも、およびすべてそれに用,もちいる物,ものを守,まもることである。","tok":[["庭","にわ"],["の"],["あげ"],["ばり"],["、"],["幕屋","まくや"],["と"],["祭壇","さいだん"],["の"],["まわり"],["の"],["庭","にわ"],["の"],["入口","いりぐち"],["の"],["とばり"],["、"],["その"],["ひも"],["、"],["および"],["すべて"],["それ"],["に"],["用いる","もちいる"],["物","もの"],["を"],["守","まもる"],["こと"],["で"],["ある"],["。"]]},{"verse":27,"text":"また、コハテからアムラムびとの氏族,しぞく、イヅハルびとの氏族,しぞく、ヘブロンびとの氏族,しぞく、ウジエルびとの氏族,しぞくが出,でた。これらはコハテびとの氏族,しぞくである。","tok":[["また"],["、"],["コハテ"],["から"],["アムラム"],["びと"],["の"],["氏族","しぞく"],["、"],["イヅハル"],["びと"],["の"],["氏族","しぞく"],["、"],["ヘブロン"],["びと"],["の"],["氏族","しぞく"],["、"],["ウジエル"],["びと"],["の"],["氏族","しぞく"],["が"],["出た","でた"],["。"],["これ"],["ら"],["は"],["コハテ"],["びと"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":28,"text":"一か月,げつ以上,いじょうの男子,だんしの数,かずは、合,あわせて八千六百人,にんであって、聖所,せいじょの務,つとめを守,まもる者,ものたちである。","tok":[["一","いち"],["か月","かげつ"],["以上","いじょう"],["の"],["男子","だんし"],["の"],["数","かず"],["は"],["、"],["合","あわせ"],["て"],["八千六百","はちせんろくひゃく"],["人","にん"],["で"],["あって"],["、"],["聖","せい"],["所","しょ"],["の"],["務め","つとめ"],["を"],["守者","まもるもの"],["たち"],["で"],["ある"],["。"]]},{"verse":29,"text":"コハテの子,こたちの氏族,しぞくは、幕屋,まくやの南,みなみの方,ほうに宿営,しゅくえいし、","tok":[["コハテ"],["の"],["子","こ"],["たち"],["の"],["氏族","しぞく"],["は"],["、"],["幕屋","まくや"],["の"],["南","みなみ"],["の"],["方","ほう"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":30,"text":"ウジエルの子,こエリザパンが、コハテびとの氏族,しぞくの父祖,ふその家,いえのつかさとなるであろう。","tok":[["ウジエル"],["の"],["子","こ"],["エリザパン"],["が"],["、"],["コハテ"],["びと"],["の"],["氏族","しぞく"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"]]},{"verse":31,"text":"彼,かれらの務,つとめは、契約,けいやくの箱,はこ、机,つくえ、燭台,しょくだい、二つの祭壇,さいだん、聖所,せいじょの務,つとめに用,もちいる器,うつわ、とばり、およびすべてそれに用,もちいる物,ものを守,まもることである。","tok":[["彼","かれ"],["ら"],["の"],["務め","つとめ"],["は"],["、"],["契約","けいやく"],["の"],["箱","は"],["こ"],["、"],["机","つくえ"],["、"],["燭台","しょくだい"],["、"],["二","ふた"],["つ"],["の"],["祭壇","さいだん"],["、"],["聖","せい"],["所","しょ"],["の"],["務め","つとめ"],["に"],["用いる","もちいる"],["器","うつわ"],["、"],["とばり"],["、"],["および"],["すべて"],["それ"],["に"],["用いる","もちいる"],["物","もの"],["を"],["守","まもる"],["こと"],["で"],["ある"],["。"]]},{"verse":32,"text":"祭司,さいしアロンの子,こエレアザルが、レビびとのつかさたちの長,ちょうとなり、聖所,せいじょの務,つとめを守,まもるものたちを監督,かんとくするであろう。","tok":[["祭司","さいし"],["アロン"],["の"],["子","こ"],["エレアザル"],["が"],["、"],["レビ"],["びと"],["の"],["つかさ"],["たち"],["の"],["長う","ちょう"],["と"],["なり"],["、"],["聖","せい"],["所","しょ"],["の"],["務め","つとめ"],["を"],["守","まもる"],["もの"],["たち"],["を"],["監督","かんとく"],["するで"],["あろう"],["。"]]},{"verse":33,"text":"メラリからマヘリびとの氏族,しぞくと、ムシびとの氏族,しぞくとが出,でた。これらはメラリの氏族,しぞくである。","tok":[["メラリ"],["から"],["マヘリ"],["びと"],["の"],["氏族","しぞく"],["と"],["、"],["ムシ"],["びと"],["の"],["氏族","しぞく"],["と"],["が"],["出た","でた"],["。"],["これ"],["ら"],["は"],["メラリ"],["の"],["氏族","しぞく"],["で"],["ある"],["。"]]},{"verse":34,"text":"その数,かぞえられた者,もの、すなわち、一か月,げつ以上,いじょうの男子,だんしの数,かずは、合,あわせて六千二百人,にんであった。","tok":[["その"],["数えられた","かぞえられた"],["者","もの"],["、"],["すなわち"],["、"],["一","いち"],["か月","かげつ"],["以上","いじょう"],["の"],["男子","だんし"],["の"],["数","かず"],["は"],["、"],["合","あわせ"],["て"],["六千二百","ろくせんにひゃく"],["人","にん"],["で"],["あった"],["。"]]},{"verse":35,"text":"アビハイルの子,こツリエルが、メラリの氏族,しぞくの父祖,ふその家,いえのつかさとなるであろう。彼,かれらは幕屋,まくやの北,きたの方,ほうに宿営,しゅくえいしなければならない。","tok":[["アビハイル"],["の"],["子","こ"],["ツリエル"],["が"],["、"],["メラリ"],["の"],["氏族","しぞく"],["の"],["父祖","ふそ"],["の"],["家","いえ"],["の"],["つかさ"],["と"],["なるで"],["あろう"],["。"],["彼","かれ"],["ら"],["は"],["幕屋","まくや"],["の"],["北","きた"],["の"],["方","ほう"],["に"],["宿営","しゅくえい"],["しなければ"],["ならない"],["。"]]},{"verse":36,"text":"メラリの子,こたちが、その務,つとめとして管理,かんりすべきものは、幕屋,まくやの枠,わく、その横木,よこぎ、その柱,はしら、その座,ざ、そのすべての器,うつわ、およびそれに用,もちいるすべての物,もの、","tok":[["メラリ"],["の"],["子","こ"],["たち"],["が"],["、"],["その"],["務め","つとめ"],["として"],["管理","かんり"],["すべき"],["もの"],["は"],["、"],["幕屋","まくや"],["の"],["枠","わく"],["、"],["その"],["横木","よ"],["こぎ"],["、"],["その"],["柱","はしら"],["、"],["その"],["座","ざ"],["、"],["その"],["すべて"],["の"],["器","うつわ"],["、"],["および"],["それ"],["に"],["用いる","もちいる"],["すべて"],["の"],["物","もの"],["、"]]},{"verse":37,"text":"ならびに庭,にわのまわりの柱,はしらとその座,ざ、その釘,くぎ、およびそのひもである。","tok":[["ならびに"],["庭","にわ"],["の"],["まわり"],["の"],["柱","はしら"],["と"],["その"],["座","ざ"],["、"],["その"],["釘","くぎ"],["、"],["および"],["その"],["ひも"],["で"],["ある"],["。"]]},{"verse":38,"text":"また幕屋,まくやの前,まえ、その東,ひがしの方,ほう、すなわち、会見,かいけんの幕屋,まくやの東,ひがしの方,ほうに宿営,しゅくえいする者,ものは、モーセとアロン、およびアロンの子,こたちであって、イスラエルの人々,ひとびとの務,つとめに代,かわって、聖所,せいじょの務,つとめを守,まもるものである。ほかの人,ひとで近,ちかづく者,ものは殺,ころされるであろう。","tok":[["また"],["幕屋","まくや"],["の"],["前","まえ"],["、"],["その"],["東","ひがし"],["の"],["方","ほう"],["、"],["すなわち"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["東","ひがし"],["の"],["方","ほう"],["に"],["宿営","しゅくえい"],["する"],["者","もの"],["は"],["、"],["モーセ"],["と"],["アロン"],["、"],["および"],["アロン"],["の"],["子","こ"],["たち"],["で"],["あって"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["務め","つとめ"],["に"],["代わって","かわって"],["、"],["聖","せい"],["所","しょ"],["の"],["務め","つとめ"],["を"],["守る","まもる"],["もの"],["で"],["ある"],["。"],["ほか"],["の"],["人","ひと"],["で"],["近づく","ちかづく"],["者","もの"],["は"],["殺ろされるで","ころされるで"],["あろう"],["。"]]},{"verse":39,"text":"モーセとアロンとが、主,しゅの言葉,ことばにしたがって数,かぞえたレビびとで、その氏族,しぞくによって数,かぞえられた者,もの、一か月,げつ以上,いじょうの男子,だんしは、合,あわせて二万二千人,にんであった。","tok":[["モーセ"],["と"],["アロン"],["と"],["が"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["したがって"],["数えた","かぞえた"],["レビ"],["びと"],["で"],["、"],["その"],["氏族","しぞく"],["によって"],["数えられた","かぞえられた"],["者","もの"],["、"],["一","いち"],["か月","かげつ"],["以上","いじょう"],["の"],["男子","だんし"],["は"],["、"],["合","あわせ"],["て"],["二万二千","にまんにせん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":40,"text":"主,しゅはまたモーセに言,いわれた、「あなたは、イスラエルの人々,ひとびとのうち、すべてういごである男子,だんしの一か月,げつ以上,いじょうのものを数,かぞえて、その名,なの数,かずを調,しらべなさい。","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["、"],["すべて"],["うい"],["ご"],["で"],["ある"],["男子","だんし"],["の"],["一","いち"],["か月","かげつ"],["以上","いじょう"],["の"],["もの"],["を"],["数えて","かぞえて"],["、"],["その"],["名","な"],["の"],["数","かず"],["を"],["調べ","しらべ"],["なさい"],["。"]]},{"verse":41,"text":"また主,しゅなるわたしのために、イスラエルの人々,ひとびとのうちの、すべてのういごの代,かわりにレビびとを取,とり、またイスラエルの人々,ひとびとの家畜,かちくのうちの、すべてのういごの代,かわりに、レビびとの家畜,かちくを取,とりなさい」。","tok":[["また"],["主","しゅ"],["なる"],["わたし"],["の"],["ため"],["に"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["の"],["、"],["すべて"],["の"],["うい"],["ご"],["の"],["代わり","かわり"],["に"],["レビ"],["びと"],["を"],["取","とり"],["、"],["また"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["家畜","かちく"],["の"],["うち"],["の"],["、"],["すべて"],["の"],["うい"],["ご"],["の"],["代わり","かわり"],["に"],["、"],["レビ"],["びと"],["の"],["家畜","かちく"],["を"],["取","とり"],["なさい"],["」"],["。"]]},{"verse":42,"text":"そこでモーセは主,しゅの命,めいじられたように、イスラエルの人々,ひとびとのうちの、すべてのういごを数,かぞえた。","tok":[["そこ"],["で"],["モーセ"],["は"],["主","しゅ"],["の"],["命じられた","めいじられた"],["よう"],["に"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["の"],["、"],["すべて"],["の"],["うい"],["ご"],["を"],["数えた","かぞえた"],["。"]]},{"verse":43,"text":"その数,かぞえられたういごの男子,だんし、すべて一か月,げつ以上,いじょうの者,ものは、その名,なの数,かずによると二万二千二百七十三人,にんであった。","tok":[["その"],["数えられた","かぞえられた"],["うい"],["ご"],["の"],["男子","だんし"],["、"],["すべて"],["一","いち"],["か月","かげつ"],["以上","いじょう"],["の"],["者","もの"],["は"],["、"],["その"],["名","な"],["の"],["数","かず"],["に"],["よる"],["と"],["二万二千二百七十三","にまんにせんにひゃくななじゅうさん"],["人","にん"],["で"],["あった"],["。"]]},{"verse":44,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":45,"text":"「あなたはイスラエルの人々,ひとびとのうちの、すべてのういごの代,かわりに、レビびとを取,とり、また彼,かれらの家畜,かちくの代,かわりに、レビびとの家畜,かちくを取,とりなさい。レビびとはわたしのものとなる。わたしは主,しゅである。","tok":[["「"],["あなた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["の"],["、"],["すべて"],["の"],["うい"],["ご"],["の"],["代わり","かわり"],["に"],["、"],["レビ"],["びと"],["を"],["取","とり"],["、"],["また"],["彼","かれ"],["ら"],["の"],["家畜","かちく"],["の"],["代わり","かわり"],["に"],["、"],["レビ"],["びと"],["の"],["家畜","かちく"],["を"],["取","とり"],["なさい"],["。"],["レビ"],["び"],["と"],["は"],["わたし"],["の"],["もの"],["と"],["なる"],["。"],["わたし"],["は"],["主","しゅ"],["で"],["ある"],["。"]]},{"verse":46,"text":"またイスラエルの人々,ひとびとのういごは、レビびとの数,かずを二百七十三人,にん超過,ちょうかしているから、そのあがないのために、","tok":[["また"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うい"],["ご"],["は"],["、"],["レビ"],["びと"],["の"],["数","かず"],["を"],["二百七十三","にひゃくななじゅうさん"],["人","にん"],["超過","ちょうか"],["して"],["いる"],["から"],["、"],["その"],["あ"],["が"],["ない"],["の"],["ため"],["に"],["、"]]},{"verse":47,"text":"そのあたまかずによって、ひとりごとに銀,ぎん五,ごシケルを取,とらなければならない。すなわち、聖所,せいじょのシケルにしたがって、それを取,とらなければならない。一シケルは二十ゲラである。","tok":[["その"],["あたま"],["かず"],["によって"],["、"],["ひとりごと"],["に"],["銀","ぎん"],["五","ご"],["シケル"],["を"],["取らなければ","とらなければ"],["ならない"],["。"],["すなわち"],["、"],["聖","せい"],["所","しょ"],["の"],["シケル"],["に"],["したがって"],["、"],["それ"],["を"],["取らなければ","とらなければ"],["ならない"],["。"],["一","いち"],["シケル"],["は"],["二十","にじゅう"],["ゲラ"],["で"],["ある"],["。"]]},{"verse":48,"text":"あなたは、その超過,ちょうかした者,ものをあがなう金,かねを、アロンと、その子,こたちに渡,わたさなければならない」。","tok":[["あなた"],["は"],["、"],["その"],["超過","ちょうか"],["した"],["者","もの"],["を"],["あがなう"],["金","かね"],["を"],["、"],["アロン"],["と"],["、"],["その"],["子","こ"],["たち"],["に"],["渡さなければ","わたさなければ"],["ならない"],["」"],["。"]]},{"verse":49,"text":"そこでモーセは、レビびとによってあがなわれた者,ものを超過,ちょうかした人々,ひとびとから、あがないの金,かねを取,とった。","tok":[["そこ"],["で"],["モーセ"],["は"],["、"],["レビ"],["びと"],["によって"],["あがなわれた"],["者","もの"],["を"],["超過","ちょうか"],["した"],["人々","ひとびと"],["から"],["、"],["あがない"],["の"],["金","かね"],["を"],["取った","とった"],["。"]]},{"verse":50,"text":"すなわち、モーセは、イスラエルの人々,ひとびとのういごから、聖所,せいじょのシケルにしたがって千三百六十五シケルの銀,ぎんを取,とり、","tok":[["すなわち"],["、"],["モーセ"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うい"],["ご"],["から"],["、"],["聖","せい"],["所","しょ"],["の"],["シケル"],["に"],["したがって"],["千三百六十五","せんさんひゃくろくじゅうご"],["シケル"],["の"],["銀","ぎん"],["を"],["取","とり"],["、"]]},{"verse":51,"text":"そのあがないの金,かねを、主,しゅの言葉,ことばにしたがって、アロンとその子,こたちに渡,わたした。主,しゅがモーセに命,めいじられたとおりである。","tok":[["その"],["あ"],["が"],["ない"],["の"],["金","かね"],["を"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["に"],["したがって"],["、"],["アロン"],["と"],["その"],["子","こ"],["たち"],["に"],["渡","わたし"],["た"],["。"],["主","しゅ"],["が"],["モーセ"],["に"],["命じられた","めいじられた"],["とおり"],["で"],["ある"],["。"]]}]
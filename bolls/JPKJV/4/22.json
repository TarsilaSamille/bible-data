[{"verse":1,"text":"さて、イスラエルの人々,ひとびとはまた道,みちを進,すすんで、エリコに近,ちかいヨルダンのかなたのモアブの平野,へいやに宿営,しゅくえいした。","tok":[["さて"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["また"],["道","みち"],["を"],["進んで","すすんで"],["、"],["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["の"],["かなた"],["の"],["モアブ"],["の"],["平野","へいや"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":2,"text":"チッポルの子,こバラクはイスラエルがアモリびとにしたすべての事,ことを見,みたので、","tok":[["チッポル"],["の"],["子","こ"],["バラク"],["は"],["イスラエル"],["が"],["アモリ"],["びと"],["に"],["した"],["すべて"],["の"],["事","こと"],["を"],["見た","みた"],["ので"],["、"]]},{"verse":3,"text":"モアブは大,おおいにイスラエルの民,たみを恐,おそれた。その数,かずが多,おおかったためである。モアブはイスラエルの人々,ひとびとをひじょうに恐,おそれたので、","tok":[["モアブ"],["は"],["大いに","おおいに"],["イスラエル"],["の"],["民","たみ"],["を"],["恐れた","おそれた"],["。"],["その"],["数","かず"],["が"],["多かった","おおかった"],["ため"],["で"],["ある"],["。"],["モアブ"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["ひじょう"],["に"],["恐れた","おそれた"],["ので"],["、"]]},{"verse":4,"text":"ミデアンの長老,ちょうろうたちに言,いった、「この群衆,ぐんしゅうは牛,うしが野,のの草,くさをなめつくすように、われわれの周囲,しゅういの物,ものをみな、なめつくそうとしている」。チッポルの子,こバラクはこの時,ときモアブの王,おうであった。","tok":[["ミデアン"],["の"],["長老","ちょうろう"],["たち"],["に"],["言った","いった"],["、"],["「"],["この"],["群衆","ぐんしゅう"],["は"],["牛","うし"],["が"],["野","の"],["の"],["草","くさ"],["を"],["なめ"],["つくす"],["よう"],["に"],["、"],["われわれ"],["の"],["周囲","しゅうい"],["の"],["物","もの"],["を"],["みな"],["、"],["なめ"],["つくそう"],["として"],["いる"],["」"],["。"],["チッポル"],["の"],["子","こ"],["バラク"],["は"],["この"],["時","とき"],["モアブ"],["の"],["王","おう"],["で"],["あった"],["。"]]},{"verse":5,"text":"彼,かれはアンモンびとの国,くにのユフラテ川,かわのほとりにあるペトルに使者,ししゃをつかわし、ベオルの子,こバラムを招,まねこうとして言,いわせた、「エジプトから出,でてきた民,たみがあり、地,ちのおもてをおおってわたしの前,まえにいます。","tok":[["彼","かれ"],["は"],["アンモン"],["びと"],["の"],["国","くに"],["の"],["ユフラテ"],["川","かわ"],["の"],["ほとり"],["に"],["ある"],["ペトル"],["に"],["使者","ししゃ"],["を"],["つかわし"],["、"],["ベオル"],["の"],["子","こ"],["バラム"],["を"],["招こう","まねこう"],["として"],["言わせた","いわせた"],["、"],["「"],["エジプト"],["から"],["出て","でて"],["きた"],["民","たみ"],["が"],["あり"],["、"],["地","ち"],["の"],["おもて"],["を"],["おおって"],["わたし"],["の"],["前","まえ"],["に"],["います"],["。"]]},{"verse":6,"text":"どうぞ今,いまきてわたしのためにこの民,たみをのろってください。彼,かれらはわたしよりも強,つよいのです。そうしてくだされば、われわれは彼,かれらを撃,うって、この国,くにから追,おい払,はらうことができるかもしれません。あなたが祝福,しゅくふくする者,ものは祝福,しゅくふくされ、あなたがのろう者,ものはのろわれることをわたしは知,しっています」。","tok":[["どうぞ"],["今","いま"],["きて"],["わたし"],["の"],["ため"],["に"],["この"],["民","たみ"],["を"],["のろって"],["ください"],["。"],["彼","かれ"],["ら"],["は"],["わたし"],["より"],["も"],["強い","つよい"],["の"],["です"],["。"],["そう"],["して"],["くだされば"],["、"],["われわれ"],["は"],["彼","かれ"],["ら"],["を"],["撃って","うって"],["、"],["この"],["国","くに"],["から"],["追い払う","おいはらう"],["こと"],["が"],["できる"],["か"],["も"],["しれません"],["。"],["あなた"],["が"],["祝福","しゅくふく"],["する"],["者","もの"],["は"],["祝福","しゅくふく"],["され"],["、"],["あなた"],["が"],["の"],["ろう者","ろうもの"],["は"],["のろわれる"],["こと"],["を"],["わたし"],["は"],["知って","しって"],["います"],["」"],["。"]]},{"verse":7,"text":"モアブの長老,ちょうろうたちとミデアンの長老,ちょうろうたちは占,うらないの礼物,れいもつを手,てにして出発,しゅっぱつし、バラムのもとへ行,いって、バラクの言葉,ことばを告,つげた。","tok":[["モアブ"],["の"],["長老","ちょうろう"],["たち"],["と"],["ミデアン"],["の"],["長老","ちょうろう"],["たち"],["は"],["占","うらない"],["の"],["礼物","れいもつ"],["を"],["手","て"],["に"],["して"],["出発","しゅっぱつ"],["し"],["、"],["バラム"],["の"],["もと"],["へ"],["行って","いって"],["、"],["バラク"],["の"],["言葉","ことば"],["を"],["告","つげ"],["た"],["。"]]},{"verse":8,"text":"バラムは彼,かれらに言,いった、「今夜,こんやここに泊,とまりなさい。主,しゅがわたしに告,つげられるとおりに、あなたがたに返答,へんとうしましょう」。それでモアブのつかさたちはバラムのもとにとどまった。","tok":[["バラム"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["「"],["今夜","こんや"],["ここ"],["に"],["泊まり","とまり"],["なさい"],["。"],["主","しゅ"],["が"],["わたし"],["に"],["告げられる","つげられる"],["とおり"],["に"],["、"],["あなた"],["がた"],["に"],["返答","へんとう"],["しましょう"],["」"],["。"],["それ"],["で"],["モアブ"],["の"],["つかさ"],["たち"],["は"],["バラム"],["の"],["もと"],["に"],["とどまった"],["。"]]},{"verse":9,"text":"ときに神,かみはバラムに臨,のぞんで言,いわれた、「あなたのところにいるこの人々,ひとびとはだれですか」。","tok":[["とき"],["に"],["神","かみ"],["は"],["バラム"],["に"],["臨んで","のぞんで"],["言われた","いわれた"],["、"],["「"],["あなた"],["の"],["ところ"],["に"],["いる"],["この"],["人々","ひとびと"],["は"],["だれ"],["です"],["か"],["」"],["。"]]},{"verse":10,"text":"バラムは神,かみに言,いった、「モアブの王,おうチッポルの子,こバラクが、わたしに人,ひとをよこして言,いいました。","tok":[["バラム"],["は"],["神","かみ"],["に"],["言った","いった"],["、"],["「"],["モアブ"],["の"],["王","おう"],["チッポル"],["の"],["子","こ"],["バラク"],["が"],["、"],["わたし"],["に"],["人","ひと"],["を"],["よこして"],["言いました","いいました"],["。"]]},{"verse":11,"text":"『エジプトから出,でてきた民,たみがあり、地,ちのおもてをおおっています。どうぞ今,いまきてわたしのために彼,かれらをのろってください。そうすればわたしは戦,たたかって、彼,かれらを追,おい払,はらうことができるかもしれません』」。","tok":[["『"],["エジプト"],["から"],["出て","でて"],["きた"],["民","たみ"],["が"],["あり"],["、"],["地","ち"],["の"],["おもて"],["を"],["おおって"],["います"],["。"],["どうぞ"],["今","いま"],["きて"],["わたし"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["のろって"],["ください"],["。"],["そう"],["すれば"],["わたし"],["は"],["戦って","たたかって"],["、"],["彼","かれ"],["ら"],["を"],["追い払う","おいはらう"],["こと"],["が"],["できる"],["か"],["も"],["しれません"],["』"],["」"],["。"]]},{"verse":12,"text":"神,かみはバラムに言,いわれた、「あなたは彼,かれらと一緒,いっしょに行,いってはならない。またその民,たみをのろってはならない。彼,かれらは祝福,しゅくふくされた者,ものだからである」。","tok":[["神","かみ"],["は"],["バラム"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["彼","かれ"],["ら"],["と"],["一緒","いっしょ"],["に"],["行って","いって"],["は"],["ならない"],["。"],["また"],["その"],["民","たみ"],["を"],["のろって"],["は"],["ならない"],["。"],["彼","かれ"],["ら"],["は"],["祝福","しゅくふく"],["された"],["者","もの"],["だ"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":13,"text":"明,あくる朝,あさ起,おきて、バラムはバラクのつかさたちに言,いった、「あなたがたは国,くににお帰,かえりなさい。主,しゅはわたしがあなたがたと一緒,いっしょに行,いくことを、お許,おゆるしになりません」。","tok":[["明くる","あくる"],["朝","あさ"],["起きて","おきて"],["、"],["バラム"],["は"],["バラク"],["の"],["つかさ"],["たち"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["国","くに"],["に"],["お帰えり","おかえり"],["なさい"],["。"],["主","しゅ"],["は"],["わたし"],["が"],["あなた"],["がた"],["と"],["一緒","いっしょ"],["に"],["行く","いく"],["こと"],["を"],["、"],["お許","おおゆるし"],["に"],["なりません"],["」"],["。"]]},{"verse":14,"text":"モアブのつかさたちは立,たってバラクのもとに行,いって言,いった、「バラムはわたしたちと一緒,いっしょに来,くることを承知,しょうちしません」。","tok":[["モアブ"],["の"],["つかさ"],["たち"],["は"],["立って","たって"],["バラク"],["の"],["もと"],["に"],["行って","いって"],["言った","いった"],["、"],["「"],["バラム"],["は"],["わたしたち"],["と"],["一緒","いっしょ"],["に"],["来る","くる"],["こと"],["を"],["承知","しょうち"],["しません"],["」"],["。"]]},{"verse":15,"text":"バラクはまた前,まえの者,ものよりも身分,みぶんの高,たかいつかさたちを前,まえよりも多,おおくつかわした。","tok":[["バラク"],["は"],["また"],["前","まえ"],["の"],["者","もの"],["より"],["も"],["身分","みぶん"],["の"],["高い","たかい"],["つかさ"],["たち"],["を"],["前","まえ"],["より"],["も"],["多く","おおく"],["つかわした"],["。"]]},{"verse":16,"text":"彼,かれらはバラムのところへ行,いって言,いった、「チッポルの子,こバラクはこう申,もうします、『どんな妨,さまたげをも顧,かえりみず、どうぞわたしのところへおいでください。","tok":[["彼","かれ"],["ら"],["は"],["バラム"],["の"],["ところ"],["へ"],["行って","いって"],["言った","いった"],["、"],["「"],["チッポル"],["の"],["子","こ"],["バラク"],["は"],["こう"],["申します","もうします"],["、"],["『"],["どんな"],["妨げ","さまたげ"],["を"],["も"],["顧ず","かえりみず"],["、"],["どうぞ"],["わたし"],["の"],["ところ"],["へ"],["おいで"],["ください"],["。"]]},{"verse":17,"text":"わたしはあなたを大,おおいに優遇,ゆうぐうします。そしてあなたがわたしに言,いわれる事,ことはなんでもいたします。どうぞきてわたしのためにこの民,たみをのろってください』」。","tok":[["わたし"],["は"],["あなた"],["を"],["大いに","おおいに"],["優遇","ゆうぐう"],["します"],["。"],["そして"],["あなた"],["が"],["わたし"],["に"],["言われる","いわれる"],["事","こと"],["は"],["なん"],["で"],["も"],["いたします"],["。"],["どうぞ"],["きて"],["わたし"],["の"],["ため"],["に"],["この"],["民","たみ"],["を"],["のろって"],["ください"],["』"],["」"],["。"]]},{"verse":18,"text":"しかし、バラムはバラクの家来,けらいたちに答,こたえた、「たといバラクがその家,いえに満,みちるほどの金銀,きんぎんをわたしに与,あたえようとも、事,ことの大小,だいしょうを問,とわず、わたしの神,かみ、主,しゅの言葉,ことばを越,こえては何,なにもすることができません。","tok":[["しかし"],["、"],["バラム"],["は"],["バラク"],["の"],["家来","けらい"],["たち"],["に"],["答","こたえ"],["た"],["、"],["「"],["たとい"],["バラク"],["が"],["その"],["家","いえ"],["に"],["満ちる","みちる"],["ほど"],["の"],["金銀","きんぎん"],["を"],["わたし"],["に"],["与","あたえ"],["よう"],["と"],["も"],["、"],["事","こと"],["の"],["大小","だいしょう"],["を"],["問わず","とわず"],["、"],["わたし"],["の"],["神","かみ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["越えて","こえて"],["は"],["何に","なに"],["も"],["する"],["こと"],["が"],["できません"],["。"]]},{"verse":19,"text":"それで、どうぞ、あなたがたも今夜,こんやここにとどまって、主,しゅがこの上,うえ、わたしになんと仰,おおせられるかを確,たしかめさせてください」。","tok":[["それ"],["で"],["、"],["どうぞ"],["、"],["あなた"],["がた"],["も"],["今夜","こんや"],["ここ"],["に"],["とどまって"],["、"],["主","しゅがこ"],["の"],["上","うえ"],["、"],["わたし"],["に"],["なん"],["と"],["仰せられる","おおせられる"],["か"],["を"],["確かめさせて","たしかめさせて"],["ください"],["」"],["。"]]},{"verse":20,"text":"夜,よるになり、神,かみはバラムに臨,のぞんで言,いわれた、「この人々,ひとびとはあなたを招,まねきにきたのだから、立,たってこの人々,ひとびとと一緒,いっしょに行,いきなさい。ただしわたしが告,つげることだけを行,おこなわなければならない」。","tok":[["夜","よる"],["に"],["なり"],["、"],["神","かみ"],["は"],["バラム"],["に"],["臨んで","のぞんで"],["言われた","いわれた"],["、"],["「"],["この"],["人々","ひとびと"],["は"],["あなた"],["を"],["招き","まねき"],["に"],["きた"],["の"],["だ"],["から"],["、"],["立って","たって"],["この"],["人々","ひとびと"],["と"],["一緒","いっしょ"],["に"],["行き","いき"],["なさい"],["。"],["ただし"],["わたし"],["が"],["告げる","つげる"],["こと"],["だけ"],["を"],["行なわなければ","おこなわなければ"],["ならない"],["」"],["。"]]},{"verse":21,"text":"明,あくる朝,あさ起,おきてバラムは、ろばにくらをおき、モアブのつかさたちと一緒,いっしょに行,いった。","tok":[["明くる","あくる"],["朝","あさ"],["起きて","おきて"],["バラム"],["は"],["、"],["ろば"],["に"],["くら"],["を"],["おき"],["、"],["モアブ"],["の"],["つかさ"],["たち"],["と"],["一緒","いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":22,"text":"しかるに神,かみは彼,かれが行,いったために怒,いかりを発,はっせられ、主,しゅの使,つかいは彼,かれを妨,さまたげようとして、道,みちに立,たちふさがっていた。バラムは、ろばに乗,のり、そのしもべふたりも彼,かれと共,ともにいたが、","tok":[["しかる"],["に"],["神","かみ"],["は"],["彼","かれ"],["が"],["行った","いった"],["ため"],["に"],["怒り","いかり"],["を"],["発せられ","はっせられ"],["、"],["主","しゅ"],["の"],["使い","つかい"],["は"],["彼","かれ"],["を"],["妨げよう","さまたげよう"],["として"],["、"],["道","みち"],["に"],["立ちふさがって","たちふさがって"],["いた"],["。"],["バラム"],["は"],["、"],["ろば"],["に"],["乗","のり"],["、"],["その"],["しもべ"],["ふたり"],["も"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["が"],["、"]]},{"verse":23,"text":"ろばは主,しゅの使,つかいが、手,てに抜,ぬき身,みのつるぎをもって、道,みちに立,たちふさがっているのを見,み、道,みちをそれて畑,はたけにはいったので、バラムは、ろばを打,うって道,みちに返,かえそうとした。","tok":[["ろば"],["は"],["主","しゅ"],["の"],["使","つかい"],["が"],["、"],["手","て"],["に"],["抜き身","ぬきみ"],["の"],["つるぎ"],["を"],["もって"],["、"],["道","みち"],["に"],["立ちふさがって","たちふさがって"],["いる"],["の"],["を"],["見","み"],["、"],["道","みち"],["を"],["それて"],["畑","はたけ"],["に"],["はいった"],["ので"],["、"],["バラム"],["は"],["、"],["ろば"],["を"],["打って","うって"],["道","みち"],["に"],["返えそう","かえそう"],["と"],["した"],["。"]]},{"verse":24,"text":"しかるに主,しゅの使,つかいはまたぶどう畑,はたけの間,あいだの狭,せまい道,みちに立,たちふさがっていた。道,みちの両側,りょうがわには石,いしがきがあった。","tok":[["しかる"],["に"],["主","しゅ"],["の"],["使い","つかい"],["は"],["また"],["ぶどう"],["畑","はたけ"],["の"],["間","あいだ"],["の"],["狭い","せまい"],["道","みち"],["に"],["立ちふさがって","たちふさがって"],["いた"],["。"],["道","みち"],["の"],["両側","りょうがわ"],["に"],["は"],["石がき","いしがき"],["が"],["あった"],["。"]]},{"verse":25,"text":"ろばは主,しゅの使,つかいを見,みて、石,いしがきにすり寄,より、バラムの足,あしを石,いしがきに押,おしつけたので、バラムは、また、ろばを打,うった。","tok":[["ろば"],["は"],["主","しゅ"],["の"],["使","つかい"],["を"],["見て","みて"],["、"],["石がき","いしがき"],["に"],["すり寄り","すりより"],["、"],["バラム"],["の"],["足","あし"],["を"],["石がき","いしがき"],["に"],["押","おし"],["つけた"],["ので"],["、"],["バラム"],["は"],["、"],["また"],["、"],["ろば"],["を"],["打った","うった"],["。"]]},{"verse":26,"text":"主,しゅの使,つかいはまた先,さきに進,すすんで、狭,せまい所,ところに立,たちふさがっていた。そこは右,みぎにも左,ひだりにも、曲,まがる道,みちがなかったので、","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["また"],["先","さき"],["に"],["進んで","すすんで"],["、"],["狭い","せまい"],["所","ところ"],["に"],["立ちふさがって","たちふさがって"],["いた"],["。"],["そこ"],["は"],["右","みぎ"],["に"],["も"],["左","ひだり"],["に"],["も"],["、"],["曲がる","まがる"],["道","みち"],["が"],["なかった"],["ので"],["、"]]},{"verse":27,"text":"ろばは主,しゅの使,つかいを見,みてバラムの下,したに伏,ふした。そこでバラムは怒,いかりを発,はっし、つえでろばを打,うった。","tok":[["ろば"],["は"],["主","しゅ"],["の"],["使","つかい"],["を"],["見て","みて"],["バラム"],["の"],["下","した"],["に"],["伏した","ふした"],["。"],["そこ"],["で"],["バラム"],["は"],["怒り","いかり"],["を"],["発し","はっし"],["、"],["つえ"],["で"],["ろば"],["を"],["打った","うった"],["。"]]},{"verse":28,"text":"すると、主,しゅが、ろばの口,くちを開,ひらかれたので、ろばはバラムにむかって言,いった、「わたしがあなたに何,なにをしたというのですか。あなたは三度,どもわたしを打,うったのです」。","tok":[["する"],["と"],["、"],["主","しゅ"],["が"],["、"],["ろば"],["の"],["口","くち"],["を"],["開らかれた","ひらかれた"],["ので"],["、"],["ろば"],["は"],["バラム"],["に"],["むかって"],["言った","いった"],["、"],["「"],["わたし"],["が"],["あなた"],["に"],["何に","なに"],["を"],["した"],["と"],["いう"],["の"],["です"],["か"],["。"],["あなた"],["は"],["三","さん"],["度","ど"],["も"],["わたし"],["を"],["打った","うった"],["の"],["です"],["」"],["。"]]},{"verse":29,"text":"バラムは、ろばに言,いった、「お前,まえがわたしを侮,あなどったからだ。わたしの手,てにつるぎがあれば、いま、お前,まえを殺,ころしてしまうのだが」。","tok":[["バラム"],["は"],["、"],["ろば"],["に"],["言った","いった"],["、"],["「"],["お前","おまえ"],["が"],["わたし"],["を"],["侮った","あなどった"],["から"],["だ"],["。"],["わたし"],["の"],["手","て"],["に"],["つるぎ"],["が"],["あれば"],["、"],["いま"],["、"],["お前","おまえ"],["を"],["殺ろして","ころして"],["しまう"],["の"],["だ"],["が"],["」"],["。"]]},{"verse":30,"text":"ろばはまたバラムに言,いった、「わたしはあなたが、きょうまで長,ながいあいだ乗,のられたろばではありませんか。わたしはいつでも、あなたにこのようにしたでしょうか」。バラムは言,いった、「いや、しなかった」。","tok":[["ろば"],["は"],["また"],["バラム"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["あなた"],["が"],["、"],["きょう"],["まで"],["長い","ながい"],["あいだ"],["乗られた","のられた"],["ろば"],["で"],["は"],["ありません"],["か"],["。"],["わたし"],["は"],["いつ"],["で"],["も"],["、"],["あなた"],["に"],["この"],["よう"],["に"],["したでしょう"],["か"],["」"],["。"],["バラム"],["は"],["言った","いった"],["、"],["「"],["いや"],["、"],["しなかった"],["」"],["。"]]},{"verse":31,"text":"このとき主,しゅがバラムの目,めを開,ひらかれたので、彼,かれは主,しゅの使,つかいが手,てに抜,ぬき身,みのつるぎをもって、道,みちに立,たちふさがっているのを見,みて、頭,とうを垂,たれてひれ伏,ふした。","tok":[["この"],["とき"],["主","しゅ"],["が"],["バラム"],["の"],["目","め"],["を"],["開らかれた","ひらかれた"],["ので"],["、"],["彼","かれ"],["は"],["主","しゅ"],["の"],["使","つかい"],["が"],["手","て"],["に"],["抜き身","ぬきみ"],["の"],["つるぎ"],["を"],["もって"],["、"],["道","みち"],["に"],["立ちふさがって","たちふさがって"],["いる"],["の"],["を"],["見て","みて"],["、"],["頭","とう"],["を"],["垂れて","たれて"],["ひれ伏した","ひれふした"],["。"]]},{"verse":32,"text":"主,しゅの使,つかいは彼,かれに言,いった、「なぜあなたは三度,どもろばを打,うったのか。あなたが誤,あやまって道,みちを行,いくので、わたしはあなたを妨,さまたげようとして出,でてきたのだ。","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["なぜ"],["あなた"],["は"],["三","さん"],["度","ど"],["も"],["ろば"],["を"],["打った","うった"],["の"],["か"],["。"],["あなた"],["が"],["誤って","あやまって"],["道","みち"],["を"],["行く","いく"],["ので"],["、"],["わたし"],["は"],["あなた"],["を"],["妨げよう","さまたげよう"],["として"],["出て","でて"],["きた"],["の"],["だ"],["。"]]},{"verse":33,"text":"ろばはわたしを見,みて三度,ども身,みを巡,めぐらしてわたしを避,さけた。もし、ろばが身,みを巡,めぐらしてわたしを避,さけなかったなら、わたしはきっと今,いまあなたを殺,ころして、ろばを生,いかしておいたであろう」。","tok":[["ろば"],["は"],["わたし"],["を"],["見て","みて"],["三","さん"],["度","ど"],["も"],["身","み"],["を"],["巡らして","めぐらして"],["わたし"],["を"],["避けた","さけた"],["。"],["もし"],["、"],["ろば"],["が"],["身","み"],["を"],["巡らして","めぐらして"],["わたし"],["を"],["避けなかったなら","さけなかったなら"],["、"],["わたし"],["は"],["きっと"],["今","いま"],["あなた"],["を"],["殺ろして","ころして"],["、"],["ろば"],["を"],["生かして","いかして"],["おいたで"],["あろう"],["」"],["。"]]},{"verse":34,"text":"バラムは主,しゅの使,つかいに言,いった、「わたしは罪,つみを犯,おかしました。あなたがわたしをとどめようとして、道,みちに立,たちふさがっておられるのを、わたしは知,しりませんでした。それで今,いま、もし、お気,おきに召,めさないのであれば、わたしは帰,かえりましょう」。","tok":[["バラム"],["は"],["主","しゅ"],["の"],["使","つかい"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["あなた"],["が"],["わたし"],["を"],["とどめよう"],["として"],["、"],["道","みち"],["に"],["立ちふさがって","たちふさがって"],["おられる"],["の"],["を"],["、"],["わたし"],["は"],["知りませんでした","しりませんでした"],["。"],["それ"],["で"],["今","いま"],["、"],["もし"],["、"],["お気","おおき"],["に"],["召さない","めさない"],["ので"],["あれば"],["、"],["わたし"],["は"],["帰えりましょう","かえりましょう"],["」"],["。"]]},{"verse":35,"text":"主,しゅの使,つかいはバラムに言,いった、「この人々,ひとびとと一緒,いっしょに行,いきなさい。ただし、わたしが告,つげることのみを述,のべなければならない」。こうしてバラムはバラクのつかさたちと一緒,いっしょに行,いった。","tok":[["主","しゅ"],["の"],["使い","つかい"],["は"],["バラム"],["に"],["言った","いった"],["、"],["「"],["この"],["人々","ひとびと"],["と"],["一緒","いっしょ"],["に"],["行き","いき"],["なさい"],["。"],["ただし"],["、"],["わたし"],["が"],["告げる","つげる"],["こと"],["のみ"],["を"],["述べなければ","のべなければ"],["ならない"],["」"],["。"],["こう"],["して"],["バラム"],["は"],["バラク"],["の"],["つかさ"],["たち"],["と"],["一緒","いっしょ"],["に"],["行った","いった"],["。"]]},{"verse":36,"text":"さて、バラクはバラムがきたと聞,きいて、国境,こっきょうのアルノン川,かわのほとり、国境,こっきょうの一端,いったんにあるモアブの町,まちまで出,でて行,いって迎,むかえた。","tok":[["さて"],["、"],["バラク"],["は"],["バラム"],["が"],["きた"],["と"],["聞いて","きいて"],["、"],["国境","こっきょう"],["の"],["アルノン"],["川","かわ"],["の"],["ほとり"],["、"],["国境","こっきょう"],["の"],["一端","いったん"],["に"],["ある"],["モアブ"],["の"],["町","まち"],["まで"],["出て","でて"],["行って","いって"],["迎","むかえ"],["た"],["。"]]},{"verse":37,"text":"そしてバラクはバラムに言,いった、「わたしは人,ひとをつかわしてあなたを招,まねいたではありませんか。あなたはなぜわたしのところへきませんでしたか。わたしは実際,じっさいあなたを優遇,ゆうぐうすることができないでしょうか」。","tok":[["そして"],["バラク"],["は"],["バラム"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["人","ひと"],["を"],["つかわして"],["あなた"],["を"],["招いたで","まねいたで"],["は"],["ありません"],["か"],["。"],["あなた"],["は"],["なぜ"],["わたし"],["の"],["ところ"],["へ"],["きませんでした"],["か"],["。"],["わたし"],["は"],["実際","じっさい"],["あなた"],["を"],["優遇","ゆうぐう"],["する"],["こと"],["が"],["できないでしょう"],["か"],["」"],["。"]]},{"verse":38,"text":"バラムはバラクに言,いった、「ごらんなさい。わたしはあなたのところにきています。しかし、今,いま、何事,なにごとかをみずから言,いうことができましょうか。わたしはただ神,かみがわたしの口,くちに授,さづけられることを述,のべなければなりません」。","tok":[["バラム"],["は"],["バラク"],["に"],["言った","いった"],["、"],["「"],["ごらん"],["なさい"],["。"],["わたし"],["は"],["あなた"],["の"],["ところ"],["に"],["きて"],["います"],["。"],["しかし"],["、"],["今","いま"],["、"],["何事","なにごと"],["か"],["を"],["みずから"],["言う","いう"],["こと"],["が"],["できましょう"],["か"],["。"],["わたし"],["は"],["ただ"],["神","かみ"],["が"],["わたし"],["の"],["口","くち"],["に"],["授","さ"],["づけられる"],["こと"],["を"],["述べなければ","のべなければ"],["なりません"],["」"],["。"]]},{"verse":39,"text":"こうしてバラムはバラクと一緒,いっしょに行,いき、キリアテ・ホゾテにきたとき、","tok":[["こう"],["して"],["バラム"],["は"],["バラク"],["と"],["一緒","いっしょ"],["に"],["行き","いき"],["、"],["キリアテ"],["・"],["ホゾテ"],["に"],["きた"],["とき"],["、"]]},{"verse":40,"text":"バラクは牛,うしと羊,ひつじとをほふって、バラムおよび彼,かれと共,ともにいたバラムを連,つれてきたつかさたちに贈,おくった。","tok":[["バラク"],["は"],["牛","うし"],["と"],["羊","ひつじ"],["と"],["を"],["ほふって"],["、"],["バラム"],["および"],["彼","かれ"],["と"],["共","とも"],["に"],["いた"],["バラム"],["を"],["連れて","つれて"],["きた"],["つかさ"],["たち"],["に"],["贈った","おくった"],["。"]]},{"verse":41,"text":"明,あくる朝,あさバラクはバラムを伴,ともなってバモテバアルにのぼり、そこからイスラエルの民,たみの宿営,しゅくえいの一端,いったんをながめさせた。","tok":[["明くる","あくる"],["朝","あさ"],["バラク"],["は"],["バラム"],["を"],["伴なって","ともなって"],["バモテバアル"],["に"],["のぼり"],["、"],["そこ"],["から"],["イスラエル"],["の"],["民","たみ"],["の"],["宿営","しゅくえい"],["の"],["一端","いったん"],["を"],["ながめさせた"],["。"]]}]
[{"verse":1,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「人,ひとをつかわして、わたしがイスラエルの人々,ひとびとに与,あたえるカナンの地,ちを探,さぐらせなさい。すなわち、その父祖,ふその部族,ぶぞくごとに、すべて彼,かれらのうちのつかさたる者,ものひとりずつをつかわしなさい」。","tok":[["「"],["人","ひと"],["を"],["つかわして"],["、"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["与える","あたえる"],["カナン"],["の"],["地","ち"],["を"],["探ぐらせ","さぐらせ"],["なさい"],["。"],["すなわち"],["、"],["その"],["父祖","ふそ"],["の"],["部族","ぶぞく"],["ごと"],["に"],["、"],["すべて"],["彼","かれ"],["ら"],["の"],["うち"],["の"],["つかさ"],["たる"],["者","もの"],["ひとり"],["ずつ"],["を"],["つかわし"],["なさい"],["」"],["。"]]},{"verse":3,"text":"モーセは主,しゅの命,めいにしたがって、パランの荒野,あらのから彼,かれらをつかわした。その人々,ひとびとはみなイスラエルの人々,ひとびとのかしらたちであった。","tok":[["モーセ"],["は"],["主","しゅ"],["の"],["命","めい"],["に"],["したがって"],["、"],["パラン"],["の"],["荒野","あらの"],["から"],["彼","かれ"],["ら"],["を"],["つかわした"],["。"],["その"],["人々","ひとびと"],["は"],["みな"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["かしら"],["たち"],["で"],["あった"],["。"]]},{"verse":4,"text":"彼,かれらの名,なは次,つぎのとおりである。ルベンの部族,ぶぞくではザックルの子,こシャンマ、","tok":[["彼","かれ"],["ら"],["の"],["名","な"],["は"],["次","つぎ"],["の"],["とおり"],["で"],["ある"],["。"],["ルベン"],["の"],["部族","ぶぞく"],["で"],["は"],["ザックル"],["の"],["子","こ"],["シャンマ"],["、"]]},{"verse":5,"text":"シメオンの部族,ぶぞくではホリの子,こシャパテ、","tok":[["シメオン"],["の"],["部族","ぶぞく"],["で"],["は"],["ホリ"],["の"],["子","こ"],["シャパテ"],["、"]]},{"verse":6,"text":"ユダの部族,ぶぞくではエフンネの子,こカレブ、","tok":[["ユダ"],["の"],["部族","ぶぞく"],["で"],["は"],["エフンネ"],["の"],["子","こ"],["カレブ"],["、"]]},{"verse":7,"text":"イッサカルの部族,ぶぞくではヨセフの子,こイガル、","tok":[["イッサカル"],["の"],["部族","ぶぞく"],["で"],["は"],["ヨセフ"],["の"],["子","こ"],["イガル"],["、"]]},{"verse":8,"text":"エフライムの部族,ぶぞくではヌンの子,こホセア、","tok":[["エフライム"],["の"],["部族","ぶぞく"],["で"],["は"],["ヌン"],["の"],["子","こ"],["ホセア"],["、"]]},{"verse":9,"text":"ベニヤミンの部族,ぶぞくではラフの子,こパルテ、","tok":[["ベニヤミン"],["の"],["部族","ぶぞく"],["で"],["は"],["ラフ"],["の"],["子","こ"],["パルテ"],["、"]]},{"verse":10,"text":"ゼブルンの部族,ぶぞくではソデの子,こガデエル、","tok":[["ゼブルン"],["の"],["部族","ぶぞく"],["で"],["は"],["ソデ"],["の"],["子","こ"],["ガデエル"],["、"]]},{"verse":11,"text":"ヨセフの部族,ぶぞくすなわち、マナセの部族,ぶぞくではスシの子,こガデ、","tok":[["ヨセフ"],["の"],["部族","ぶぞく"],["すなわち"],["、"],["マナセ"],["の"],["部族","ぶぞく"],["で"],["は"],["スシ"],["の"],["子","こ"],["ガデ"],["、"]]},{"verse":12,"text":"ダンの部族,ぶぞくではゲマリの子,こアンミエル、","tok":[["ダン"],["の"],["部族","ぶぞく"],["で"],["は"],["ゲマリ"],["の"],["子","こ"],["アンミエル"],["、"]]},{"verse":13,"text":"アセルの部族,ぶぞくではミカエルの子,こセトル、","tok":[["アセル"],["の"],["部族","ぶぞく"],["で"],["は"],["ミカエル"],["の"],["子","こ"],["セトル"],["、"]]},{"verse":14,"text":"ナフタリの部族,ぶぞくではワフシの子,こナヘビ、","tok":[["ナフタリ"],["の"],["部族","ぶぞく"],["で"],["は"],["ワフシ"],["の"],["子","こ"],["ナヘビ"],["、"]]},{"verse":15,"text":"ガドの部族,ぶぞくではマキの子,こギウエル。","tok":[["ガド"],["の"],["部族","ぶぞく"],["で"],["は"],["マキ"],["の"],["子","こ"],["ギウエル"],["。"]]},{"verse":16,"text":"以上,いじょうはモーセがその地,ちを探,さぐらせるためにつかわした人々,ひとびとの名,なである。そしてモーセはヌンの子,こホセアをヨシュアと名,なづけた。","tok":[["以上","いじょう"],["は"],["モーセ"],["が"],["その"],["地","ち"],["を"],["探ぐらせる","さぐらせる"],["ため"],["に"],["つかわした"],["人々","ひとびと"],["の"],["名","な"],["で"],["ある"],["。"],["そして"],["モーセ"],["は"],["ヌン"],["の"],["子","こ"],["ホセア"],["を"],["ヨシュア"],["と"],["名づけた","なづけた"],["。"]]},{"verse":17,"text":"モーセは彼,かれらをつかわし、カナンの地,ちを探,さぐらせようとして、これに言,いった、「あなたがたはネゲブに行,いって、山,やまに登,のぼり、","tok":[["モーセ"],["は"],["彼","かれ"],["ら"],["を"],["つかわし"],["、"],["カナン"],["の"],["地","ち"],["を"],["探ぐらせよう","さぐらせよう"],["として"],["、"],["これ"],["に"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["ネゲブ"],["に"],["行って","いって"],["、"],["山","やま"],["に"],["登り","のぼり"],["、"]]},{"verse":18,"text":"その地,ちの様子,ようすを見,み、そこに住,すむ民,たみは、強,つよいか弱,よわいか、少,すくないか多,おおいか、","tok":[["その"],["地","ち"],["の"],["様子","ようす"],["を"],["見","み"],["、"],["そこ"],["に"],["住む","すむ"],["民","たみ"],["は"],["、"],["強い","つよい"],["か弱い","かよわい"],["か"],["、"],["少い","すくない"],["か"],["多い","おおい"],["か"],["、"]]},{"verse":19,"text":"また彼,かれらの住,すんでいる地,ちは、良,よいか悪,わるいか。人々,ひとびとの住,すんでいる町々,まちまちは、天幕,てんまくか、城壁,じょうへきのある町,まちか、","tok":[["また"],["彼","かれ"],["ら"],["の"],["住んで","すんで"],["いる"],["地","ち"],["は"],["、"],["良い","よい"],["か"],["悪い","わるい"],["か"],["。"],["人々","ひとびと"],["の"],["住んで","すんで"],["いる"],["町々","まちまち"],["は"],["、"],["天幕","てんまく"],["か"],["、"],["城壁","じょうへき"],["の"],["ある"],["町","まち"],["か"],["、"]]},{"verse":20,"text":"その地,ちは、肥,こえているか、やせているか、そこには、木,きがあるかないかを見,みなさい。あなたがたは、勇,いさんで行,いって、その地,ちのくだものを取,とってきなさい」。時,ときは、ぶどうの熟,じゅくし始,はじめる季節,きせつであった。","tok":[["その"],["地","ち"],["は"],["、"],["肥","こえ"],["て"],["いる"],["か"],["、"],["やせて"],["いる"],["か"],["、"],["そこ"],["に"],["は"],["、"],["木","き"],["が"],["ある"],["か"],["ない"],["か"],["を"],["見","み"],["なさい"],["。"],["あなた"],["がた"],["は"],["、"],["勇","い"],["さん"],["で"],["行って","いって"],["、"],["その"],["地","ち"],["の"],["くだもの"],["を"],["取って","とって"],["き"],["なさい"],["」"],["。"],["時","とき"],["は"],["、"],["ぶどう"],["の"],["熟し","じゅくし"],["始める","はじめる"],["季節","きせつ"],["で"],["あった"],["。"]]},{"verse":21,"text":"そこで、彼,かれらはのぼっていって、その地,ちをチンの荒野,あらのからハマテの入口,いりぐちに近,ちかいレホブまで探,さぐった。","tok":[["そこ"],["で"],["、"],["彼","かれ"],["ら"],["は"],["のぼって"],["いって"],["、"],["その"],["地","ち"],["を"],["チン"],["の"],["荒野","あらの"],["から"],["ハマテ"],["の"],["入口","いりぐち"],["に"],["近い","ちかい"],["レホブ"],["まで"],["探った","さぐった"],["。"]]},{"verse":22,"text":"彼,かれらはネゲブにのぼって、ヘブロンまで行,いった。そこにはアナクの子孫,しそんであるアヒマン、セシャイ、およびタルマイがいた。ヘブロンはエジプトのゾアンよりも七年,ねん前,まえに建,たてられたものである。","tok":[["彼","かれ"],["ら"],["は"],["ネゲブ"],["に"],["のぼって"],["、"],["ヘブロン"],["まで"],["行った","いった"],["。"],["そこ"],["に"],["は"],["アナク"],["の"],["子孫","しそん"],["で"],["ある"],["アヒマン"],["、"],["セシャイ"],["、"],["および"],["タルマイ"],["が"],["いた"],["。"],["ヘブロン"],["は"],["エジプト"],["の"],["ゾアン"],["より"],["も"],["七","なな"],["年","ねん"],["前","まえ"],["に"],["建てられた","たてられた"],["もの"],["で"],["ある"],["。"]]},{"verse":23,"text":"ついに彼,かれらはエシコルの谷,たにに行,いって、そこで一ふさのぶどうの枝,えだを切,きり取,とり、これを棒,ぼうをもって、ふたりでかつぎ、また、ざくろといちじくをも取,とった。","tok":[["ついに"],["彼","かれ"],["ら"],["は"],["エシコル"],["の"],["谷","たに"],["に"],["行って","いって"],["、"],["そこ"],["で"],["一","いち"],["ふさ"],["の"],["ぶどう"],["の"],["枝","えだ"],["を"],["切り","きり"],["取","とり"],["、"],["これ"],["を"],["棒","ぼう"],["を"],["もって"],["、"],["ふたり"],["で"],["かつぎ"],["、"],["また"],["、"],["ざくろ"],["と"],["いちじく"],["を"],["も"],["取った","とった"],["。"]]},{"verse":24,"text":"イスラエルの人々,ひとびとが、そこで切,きり取,とったぶどうの一ふさにちなんで、その所,ところはエシコルの谷,たにと呼,よばれた。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["そこ"],["で"],["切り取った","きりとった"],["ぶどう"],["の"],["一","いち"],["ふさに"],["ちなんで"],["、"],["その"],["所","ところ"],["は"],["エシコル"],["の"],["谷","たに"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":25,"text":"四十日,にちの後,のち、彼,かれらはその地,ちを探,さぐり終,おわって帰,かえってきた。","tok":[["四十日","にち"],["の"],["後","の"],["ち"],["、"],["彼","かれ"],["ら"],["は"],["その"],["地","ち"],["を"],["探ぐり","さぐり"],["終わって","おわって"],["帰えって","かえって"],["きた"],["。"]]},{"verse":26,"text":"そして、パランの荒野,あらのにあるカデシにいたモーセとアロン、およびイスラエルの人々,ひとびとの全,ぜん会衆,かいしゅうのもとに行,いって、彼,かれらと全,ぜん会衆,かいしゅうとに復命,ふくめいし、その地,ちのくだものを彼,かれらに見,みせた。","tok":[["そして"],["、"],["パラン"],["の"],["荒野","あらの"],["に"],["ある"],["カデシ"],["に"],["いた"],["モーセ"],["と"],["アロン"],["、"],["および"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["全","ぜん"],["会衆","かいしゅう"],["の"],["もと"],["に"],["行って","いって"],["、"],["彼","かれ"],["ら"],["と"],["全","ぜん"],["会衆","かいしゅう"],["と"],["に"],["復命","ふくめい"],["し"],["、"],["その"],["地","ち"],["の"],["くだもの"],["を"],["彼","かれ"],["ら"],["に"],["見せた","みせた"],["。"]]},{"verse":27,"text":"彼,かれらはモーセに言,いった、「わたしたちはあなたが、つかわした地,ちへ行,いきました。そこはまことに乳,ちちと蜜,みつの流,ながれている地,ちです。これはそのくだものです。","tok":[["彼","かれ"],["ら"],["は"],["モーセ"],["に"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["あなた"],["が"],["、"],["つかわした"],["地","ち"],["へ"],["行きました","いきました"],["。"],["そこ"],["は"],["まこと"],["に"],["乳","ちち"],["と"],["蜜","みつ"],["の"],["流れて","ながれて"],["いる"],["地","ち"],["です"],["。"],["これ"],["は"],["その"],["くだもの"],["です"],["。"]]},{"verse":28,"text":"しかし、その地,ちに住,すむ民,たみは強,つよく、その町々,まちまちは堅固,けんごで非常,ひじょうに大,おおきく、わたしたちはそこにアナクの子孫,しそんがいるのを見,みました。","tok":[["しかし"],["、"],["その"],["地","ち"],["に"],["住む","すむ"],["民","たみ"],["は"],["強く","つよく"],["、"],["その"],["町々","まちまち"],["は"],["堅固","けんご"],["で"],["非常","ひじょう"],["に"],["大きく","おおきく"],["、"],["わたしたち"],["は"],["そこ"],["に"],["アナク"],["の"],["子孫","しそん"],["が"],["いる"],["の"],["を"],["見ました","みました"],["。"]]},{"verse":29,"text":"またネゲブの地,ちには、アマレクびとが住,すみ、山地,さんちにはヘテびと、エブスびと、アモリびとが住,すみ、海,うみべとヨルダンの岸,きしべには、カナンびとが住,すんでいます」。","tok":[["また"],["ネゲブ"],["の"],["地","ち"],["に"],["は"],["、"],["アマレク"],["びと"],["が"],["住み","すみ"],["、"],["山地","さんち"],["に"],["は"],["ヘテ"],["び"],["と"],["、"],["エブス"],["び"],["と"],["、"],["アモリ"],["びと"],["が"],["住み","すみ"],["、"],["海べ","うみべ"],["と"],["ヨルダン"],["の"],["岸べ","きしべ"],["に"],["は"],["、"],["カナン"],["びと"],["が"],["住んで","すんで"],["います"],["」"],["。"]]},{"verse":30,"text":"そのとき、カレブはモーセの前,まえで、民,たみをしずめて言,いった、「わたしたちはすぐにのぼって、攻,せめ取,とりましょう。わたしたちは必,かならず勝,かつことができます」。","tok":[["その"],["とき"],["、"],["カレブ"],["は"],["モーセ"],["の"],["前","まえ"],["で"],["、"],["民","たみ"],["を"],["しずめて"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["すぐ"],["に"],["のぼって"],["、"],["攻め","せめ"],["取","とり"],["ましょう"],["。"],["わたしたち"],["は"],["必","かならず"],["勝つ","かつ"],["こと"],["が"],["できます"],["」"],["。"]]},{"verse":31,"text":"しかし、彼,かれとともにのぼって行,いった人々,ひとびとは言,いった、「わたしたちはその民,たみのところへ攻,せめのぼることはできません。彼,かれらはわたしたちよりも強,つよいからです」。","tok":[["しかし"],["、"],["彼","かれ"],["と"],["とも"],["に"],["のぼって"],["行った","いった"],["人々","ひとびと"],["は"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["その"],["民","たみ"],["の"],["ところ"],["へ"],["攻めのぼる","せめのぼる"],["こと"],["は"],["できません"],["。"],["彼","かれ"],["ら"],["は"],["わたしたち"],["より"],["も"],["強い","つよい"],["から"],["です"],["」"],["。"]]},{"verse":32,"text":"そして彼,かれらはその探,さぐった地,ちのことを、イスラエルの人々,ひとびとに悪,わるく言,いいふらして言,いった、「わたしたちが行,いき巡,めぐって探,さぐった地,ちは、そこに住,すむ者,ものを滅,ほろぼす地,ちです。またその所,ところでわたしたちが見,みた民,たみはみな背,せの高,たかい人々,ひとびとです。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["その"],["探った","さぐった"],["地","ち"],["の"],["こと"],["を"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["悪く","わるく"],["言いふらして","いいふらして"],["言った","いった"],["、"],["「"],["わたしたち"],["が"],["行き","いき"],["巡って","めぐって"],["探った","さぐった"],["地","ち"],["は"],["、"],["そこ"],["に"],["住む","すむ"],["者","もの"],["を"],["滅ぼす","ほろぼす"],["地","ち"],["です"],["。"],["また"],["その"],["所","ところ"],["で"],["わたしたち"],["が"],["見た","みた"],["民","たみ"],["は"],["みな"],["背","せ"],["の"],["高い","たかい"],["人々","ひとびと"],["です"],["。"]]},{"verse":33,"text":"わたしたちはまたそこで、ネピリムから出,でたアナクの子孫,しそんネピリムを見,みました。わたしたちには自分,じぶんが、いなごのように思,おもわれ、また彼,かれらにも、そう見,みえたに違,ちがいありません」。","tok":[["わたしたち"],["は"],["また"],["そこ"],["で"],["、"],["ネピリム"],["から"],["出た","でた"],["アナク"],["の"],["子孫","しそん"],["ネピリム"],["を"],["見ました","みました"],["。"],["わたしたち"],["に"],["は"],["自分","じぶん"],["が"],["、"],["いなご"],["の"],["よう"],["に"],["思われ","おもわれ"],["、"],["また"],["彼","かれ"],["ら"],["に"],["も"],["、"],["そう"],["見えた","みえた"],["に"],["違い","ちがい"],["ありません"],["」"],["。"]]}]
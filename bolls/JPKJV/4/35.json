[{"verse":1,"text":"エリコに近,ちかいヨルダンのほとりのモアブの平野,へいやで、主,しゅはモーセに言,いわれた、","tok":[["エリコ"],["に"],["近い","ちかい"],["ヨルダン"],["の"],["ほとり"],["の"],["モアブ"],["の"],["平野","へいや"],["で"],["、"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに命,めいじて、その獲,えた嗣,し業,ぎょうのうちから、レビびとに住,すむべき町々,まちまちを与,あたえさせなさい。また、あなたがたは、その町々,まちまちの周囲,しゅういの放牧,ほうぼく地,ちをレビびとに与,あたえなければならない。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じて","めいじて"],["、"],["その"],["獲た","えた"],["嗣業","しぎょう"],["の"],["うち"],["から"],["、"],["レビ"],["びと"],["に"],["住むべき","すむべき"],["町々","まちまち"],["を"],["与えさせ","あたえさせ"],["なさい"],["。"],["また"],["、"],["あなた"],["がた"],["は"],["、"],["その"],["町々","まちまち"],["の"],["周囲","しゅうい"],["の"],["放牧","ほうぼく"],["地","ち"],["を"],["レビ"],["びと"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":3,"text":"その町々,まちまちは彼,かれらの住,すむ所,ところ、その放牧,ほうぼく地,ちは彼,かれらの家畜,かちくと群,むれ、およびすべての獣,けもののためである。","tok":[["その"],["町々","まちまち"],["は"],["彼","かれ"],["ら"],["の"],["住む","すむ"],["所","ところ"],["、"],["その"],["放牧","ほうぼく"],["地","ち"],["は"],["彼","かれ"],["ら"],["の"],["家畜","かちく"],["と"],["群れ","むれ"],["、"],["および"],["すべて"],["の"],["獣","けもの"],["の"],["ため"],["で"],["ある"],["。"]]},{"verse":4,"text":"あなたがたがレビびとに与,あたえる町々,まちまちの放牧,ほうぼく地,ちは、町,まちの石,いしがきから一千キュビトの周囲,しゅういとしなければならない。","tok":[["あなた"],["がた"],["が"],["レビ"],["びと"],["に"],["与える","あたえる"],["町々","まちまち"],["の"],["放牧","ほうぼく"],["地","ち"],["は"],["、"],["町","まち"],["の"],["石がき","いしがき"],["から"],["一千","いちせん"],["キュビト"],["の"],["周囲","しゅうい"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":5,"text":"あなたがたは町,まちの外,そとで東側,ひがしがわに二千キュビト、南側,みなみがわに二千キュビト、西側,にしがわに二千キュビト、北側,きたがわに二千キュビトを計,はかり、町,まちはその中央,ちゅうおうにしなければならない。彼,かれらの町,まちの放牧,ほうぼく地,ちはこのようにしなければならない。","tok":[["あなた"],["がた"],["は"],["町","まち"],["の"],["外","そと"],["で"],["東側","ひがしがわ"],["に"],["二千","にせん"],["キュビト"],["、"],["南側","みなみがわ"],["に"],["二千","にせん"],["キュビト"],["、"],["西側","にしがわ"],["に"],["二千","にせん"],["キュビト"],["、"],["北側","きたがわ"],["に"],["二千","にせん"],["キュビト"],["を"],["計り","はかり"],["、"],["町","まち"],["は"],["その"],["中央","ちゅうおう"],["に"],["しなければ"],["ならない"],["。"],["彼","かれ"],["ら"],["の"],["町","まち"],["の"],["放牧","ほうぼく"],["地","ち"],["は"],["この"],["よう"],["に"],["しなければ"],["ならない"],["。"]]},{"verse":6,"text":"あなたがたがレビびとに与,あたえる町々,まちまちは六つで、のがれの町,まちとし、人,ひとを殺,ころした者,ものがのがれる所,ところとしなければならない。なおこのほかに四十二の町,まちを与,あたえなければならない。","tok":[["あなた"],["がた"],["が"],["レビ"],["びと"],["に"],["与える","あたえる"],["町々","まちまち"],["は"],["六","むい"],["つ"],["で"],["、"],["のがれ"],["の"],["町","まち"],["と"],["し"],["、"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["が"],["のがれる"],["所","ところ"],["と"],["しなければ"],["ならない"],["。"],["なお"],["この"],["ほか"],["に"],["四十二","よんじゅうに"],["の"],["町","まち"],["を"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":7,"text":"すなわちあなたがたがレビびとに与,あたえる町,まちは合,あわせて四十八で、これをその放牧,ほうぼく地,ちと共,ともに与,あたえなければならない。","tok":[["すなわち"],["あなた"],["がた"],["が"],["レビ"],["びと"],["に"],["与える","あたえる"],["町","まち"],["は"],["合","あわせ"],["て"],["四十八","よんじゅうはち"],["で"],["、"],["これ"],["を"],["その"],["放牧","ほうぼく"],["地","ち"],["と"],["共","とも"],["に"],["与えなければ","あたえなければ"],["ならない"],["。"]]},{"verse":8,"text":"あなたがたがイスラエルの人々,ひとびとの所有,しょゆうのうちからレビびとに町々,まちまちを与,あたえるには、大,おおきい部族,ぶぞくからは多,おおく取,とり、小,ちいさい部族,ぶぞくからは少,すくなく取,とり、おのおの受,うける嗣,し業,ぎょうにしたがって、その町々,まちまちをレビびとに与,あたえなければならない」。","tok":[["あなた"],["がた"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["所有","しょゆう"],["の"],["うち"],["から"],["レビ"],["びと"],["に"],["町々","まちまち"],["を"],["与える","あたえる"],["に"],["は"],["、"],["大きい","おおきい"],["部族","ぶぞく"],["から"],["は"],["多く","おおく"],["取","とり"],["、"],["小さい","ちいさい"],["部族","ぶぞく"],["から"],["は"],["少く","すくなく"],["取","とり"],["、"],["おのおの"],["受る","うける"],["嗣業","しぎょう"],["に"],["したがって"],["、"],["その"],["町々","まちまち"],["を"],["レビ"],["びと"],["に"],["与えなければ","あたえなければ"],["ならない"],["」"],["。"]]},{"verse":9,"text":"主,しゅはモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":10,"text":"「イスラエルの人々,ひとびとに言,いいなさい。あなたがたがヨルダンを渡,わたってカナンの地,ちにはいるときは、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["。"],["あなた"],["がた"],["が"],["ヨルダン"],["を"],["渡って","わたって"],["カナン"],["の"],["地","ち"],["に"],["は"],["いる"],["とき"],["は"],["、"]]},{"verse":11,"text":"あなたがたのために町,まちを選,えらんで、のがれの町,まちとし、あやまって人,ひとを殺,ころした者,ものを、そこにのがれさせなければならない。","tok":[["あなた"],["がた"],["の"],["ため"],["に"],["町","まち"],["を"],["選らんで","えらんで"],["、"],["のがれ"],["の"],["町","まち"],["と"],["し"],["、"],["あやまって"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["を"],["、"],["そこ"],["に"],["のがれさせなければ"],["ならない"],["。"]]},{"verse":12,"text":"これはあなたがたが復讐,ふくしゅうする者,ものを避,さけてのがれる町,まちであって、人,ひとを殺,ころした者,ものが会衆,かいしゅうの前,まえに立,たって、さばきを受,うけないうちに、殺,ころされることのないためである。","tok":[["これ"],["は"],["あなた"],["がた"],["が"],["復讐","ふくしゅう"],["する"],["者","もの"],["を"],["避けて","さけて"],["のがれる"],["町","まち"],["で"],["あって"],["、"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["が"],["会衆","かいしゅう"],["の"],["前","まえ"],["に"],["立って","たって"],["、"],["さばき"],["を"],["受ない","うけない"],["うち"],["に"],["、"],["殺ろされる","ころされる"],["こと"],["の"],["ない"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"あなたがたが与,あたえる町々,まちまちのうち、六つをのがれの町,まちとしなければならない。","tok":[["あなた"],["がた"],["が"],["与える","あたえる"],["町々","まちまち"],["の"],["うち"],["、"],["六","むい"],["つ"],["を"],["のがれ"],["の"],["町","まち"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":14,"text":"すなわちヨルダンのかなたで三つの町,まちを与,あたえ、カナンの地,ちで三つの町,まちを与,あたえて、のがれの町,まちとしなければならない。","tok":[["すなわち"],["ヨルダン"],["の"],["かなた"],["で"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["与","あたえ"],["、"],["カナン"],["の"],["地","ち"],["で"],["三","みっ"],["つ"],["の"],["町","まち"],["を"],["与","あたえ"],["て"],["、"],["のがれ"],["の"],["町","まち"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":15,"text":"これらの六つの町,まちは、イスラエルの人々,ひとびとと、他国,たこくの人,ひとおよび寄留者,きりゅうしゃのために、のがれの場所,ばしょとしなければならない。すべてあやまって人,ひとを殺,ころした者,ものが、そこにのがれるためである。","tok":[["これ"],["ら"],["の"],["六","むい"],["つ"],["の"],["町","まち"],["は"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["と"],["、"],["他国","たこく"],["の"],["人","ひと"],["および"],["寄留者","きりゅうしゃ"],["の"],["ため"],["に"],["、"],["のがれ"],["の"],["場所","ばしょ"],["と"],["しなければ"],["ならない"],["。"],["すべて"],["あやまって"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["が"],["、"],["そこ"],["に"],["のがれる"],["ため"],["で"],["ある"],["。"]]},{"verse":16,"text":"もし人,ひとが鉄,てつの器,うつわで、人,ひとを打,うって死,しなせたならば、その人,ひとは故,こ殺人,さつじんである。故,こ殺人,さつじんは必,かならず殺,ころされなければならない。","tok":[["もし"],["人","ひと"],["が"],["鉄","てつ"],["の"],["器","うつわ"],["で"],["、"],["人","ひと"],["を"],["打って","うって"],["死なせたならば","しなせたならば"],["、"],["その"],["人","ひと"],["は"],["故殺人","こさつじん"],["で"],["ある"],["。"],["故","こ"],["殺人","さつじん"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":17,"text":"またもし人,ひとを殺,ころせるほどの石,いしを取,とって、人,ひとを打,うって死,しなせたならば、その人,ひとは故,こ殺人,さつじんである。故,こ殺人,さつじんは必,かならず殺,ころされなければならない。","tok":[["また"],["もし"],["人","ひと"],["を"],["殺せる","ころせる"],["ほど"],["の"],["石","いし"],["を"],["取って","とって"],["、"],["人","ひと"],["を"],["打って","うって"],["死なせたならば","しなせたならば"],["、"],["その"],["人","ひと"],["は"],["故殺人","こさつじん"],["で"],["ある"],["。"],["故","こ"],["殺人","さつじん"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":18,"text":"あるいは人,ひとを殺,ころせるほどの木,きの器,うつわを取,とって、人,ひとを打,うって死,しなせたならば、その人,ひとは故,こ殺人,さつじんである。故,こ殺人,さつじんは必,かならず殺,ころされなければならない。","tok":[["あるいは"],["人","ひと"],["を"],["殺せる","ころせる"],["ほど"],["の"],["木","き"],["の"],["器","うつわ"],["を"],["取って","とって"],["、"],["人","ひと"],["を"],["打って","うって"],["死なせたならば","しなせたならば"],["、"],["その"],["人","ひと"],["は"],["故殺人","こさつじん"],["で"],["ある"],["。"],["故","こ"],["殺人","さつじん"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":19,"text":"血,ちの復讐,ふくしゅうをする者,ものは、自分,じぶんでその故,こ殺人,さつじんを殺,ころすことができる。すなわち彼,かれに出会,であうとき、彼,かれを殺,ころすことができる。","tok":[["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["は"],["、"],["自分","じぶん"],["で"],["その"],["故","こ"],["殺人","さつじん"],["を"],["殺ろす","ころす"],["こと"],["が"],["できる"],["。"],["すなわち"],["彼","かれ"],["に"],["出会う","であう"],["とき"],["、"],["彼","かれ"],["を"],["殺ろす","ころす"],["こと"],["が"],["できる"],["。"]]},{"verse":20,"text":"またもし恨,うらみのために人,ひとを突,つき、あるいは故意,こいに人,ひとに物,ものを投,なげつけて死,しなせ、","tok":[["また"],["もし"],["恨み","うらみ"],["の"],["ため"],["に"],["人","ひと"],["を"],["突き","つき"],["、"],["あるいは"],["故意","こい"],["に"],["人","ひと"],["に"],["物","もの"],["を"],["投","なげ"],["つけて"],["死なせ","しなせ"],["、"]]},{"verse":21,"text":"あるいは恨,うらみによって手,てで人,ひとを打,うって死,しなせたならば、その打,うった者,ものは必,かならず殺,ころされなければならない。彼,かれは故,こ殺人,さつじんだからである。血,ちの復讐,ふくしゅうをする者,ものは、その故,こ殺人,さつじんに出会,であうとき殺,ころすことができる。","tok":[["あるいは"],["恨み","うらみ"],["によって"],["手","て"],["で"],["人","ひと"],["を"],["打って","うって"],["死なせたならば","しなせたならば"],["、"],["その"],["打った","うった"],["者","もの"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["彼","かれ"],["は"],["故","こ"],["殺人","さつじん"],["だ"],["から"],["で"],["ある"],["。"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["は"],["、"],["その"],["故","こ"],["殺人","さつじん"],["に"],["出会う","であう"],["とき"],["殺ろす","ころす"],["こと"],["が"],["できる"],["。"]]},{"verse":22,"text":"しかし、もし恨,うらみもないのに思,おもわず人,ひとを突,つき、または、なにごころなく人,ひとに物,ものを投,なげつけ、","tok":[["しかし"],["、"],["もし"],["恨み","うらみ"],["も"],["ない"],["のに"],["思わず","おもわず"],["人","ひと"],["を"],["突き","つき"],["、"],["また"],["は"],["、"],["なにごころ"],["なく"],["人","ひと"],["に"],["物","もの"],["を"],["投","なげ"],["つけ"],["、"]]},{"verse":23,"text":"あるいは人,ひとのいるのも見,みずに、人,ひとを殺,ころせるほどの石,いしを投,なげつけて死,しなせた場合,ばあい、その人,ひとがその敵,てきでもなく、また害,がいを加,くわえようとしたのでもない時,ときは、","tok":[["あるいは"],["人","ひと"],["の"],["いる"],["の"],["も"],["見ず","みず"],["に"],["、"],["人","ひと"],["を"],["殺せる","ころせる"],["ほど"],["の"],["石","いし"],["を"],["投","なげ"],["つけて"],["死なせた","しなせた"],["場合","ばあい"],["、"],["その"],["人","ひと"],["が"],["その"],["敵","てき"],["で"],["も"],["なく"],["、"],["また"],["害","がい"],["を"],["加えよう","くわえよう"],["と"],["した"],["ので"],["も"],["ない"],["時","とき"],["は"],["、"]]},{"verse":24,"text":"会衆,かいしゅうはこれらのおきてによって、その人,ひとを殺,ころした者,ものと、血,ちの復讐,ふくしゅうをする者,ものとの間,あいだをさばかなければならない。","tok":[["会衆","かいしゅう"],["は"],["これ"],["ら"],["の"],["おきて"],["によって"],["、"],["その"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["と"],["、"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["と"],["の"],["間","あいだ"],["を"],["さばかなければ"],["ならない"],["。"]]},{"verse":25,"text":"すなわち会衆,かいしゅうはその人,ひとを殺,ころした者,ものを血,ちの復讐,ふくしゅうをする者,ものの手,てから救,すくい出,だして、逃,にげて行,いったのがれの町,まちに返,かえさなければならない。その者,ものは聖,せいなる油,あぶらを注,そそがれた大,だい祭司,さいしの死,しぬまで、そこにいなければならない。","tok":[["すなわち"],["会衆","かいしゅう"],["は"],["その"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["を"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["の"],["手","て"],["から"],["救い出して","すくいだして"],["、"],["逃て","にげて"],["行った","いった"],["のがれ"],["の"],["町","まち"],["に"],["返えさなければ","かえさなければ"],["ならない"],["。"],["その"],["者","もの"],["は"],["聖","せい"],["なる"],["油","あぶら"],["を"],["注がれた","そそがれた"],["大","だい"],["祭司","さいし"],["の"],["死ぬ","しぬ"],["まで"],["、"],["そこ"],["に"],["いなければ"],["ならない"],["。"]]},{"verse":26,"text":"しかし、もし人,ひとを殺,ころした者,ものが、その逃,にげて行,いったのがれの町,まちの境,さかいを出,でた場合,ばあい、","tok":[["しかし"],["、"],["もし"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["が"],["、"],["その"],["逃て","にげて"],["行った","いった"],["のがれ"],["の"],["町","まち"],["の"],["境","さかい"],["を"],["出た","でた"],["場合","ばあい"],["、"]]},{"verse":27,"text":"血,ちの復讐,ふくしゅうをする者,ものは、のがれの町,まちの境,さかいの外,そとで、これに出会,であい、血,ちの復讐,ふくしゅうをする者,ものが、その人,ひとを殺,ころした者,ものを殺,ころしても、彼,かれには血,ちを流,ながした罪,つみはない。","tok":[["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["は"],["、"],["のがれ"],["の"],["町","まち"],["の"],["境","さかい"],["の"],["外","そと"],["で"],["、"],["これ"],["に"],["出会","であい"],["、"],["血","ち"],["の"],["復讐","ふくしゅう"],["を"],["する"],["者","もの"],["が"],["、"],["その"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["を"],["殺ろして","ころして"],["も"],["、"],["彼","かれ"],["に"],["は"],["血","ち"],["を"],["流した","ながした"],["罪","つみ"],["は"],["ない"],["。"]]},{"verse":28,"text":"彼,かれは大,だい祭司,さいしの死,しぬまで、そののがれの町,まちにおるべきものだからである。大,だい祭司,さいしの死,しんだ後,のちは、人,ひとを殺,ころした者,ものは自分,じぶんの所有,しょゆうの地,ちにかえることができる。","tok":[["彼","かれ"],["は"],["大","だい"],["祭司","さいし"],["の"],["死ぬ","しぬ"],["まで"],["、"],["その"],["のがれ"],["の"],["町","まち"],["に"],["おるべき"],["もの"],["だ"],["から"],["で"],["ある"],["。"],["大","だい"],["祭司","さいし"],["の"],["死んだ","しんだ"],["後","のち"],["は"],["、"],["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["は"],["自分","じぶん"],["の"],["所有","しょゆう"],["の"],["地","ち"],["に"],["かえる"],["こと"],["が"],["できる"],["。"]]},{"verse":29,"text":"これらのことはすべてあなたがたの住,すむ所,ところで、代々,よよあなたがたのためのおきての定,さだめとしなければならない。","tok":[["これ"],["ら"],["の"],["こと"],["は"],["すべて"],["あなた"],["がた"],["の"],["住む","すむ"],["所","ところ"],["で"],["、"],["代々","よよあなたがた"],["の"],["ため"],["の"],["おきて"],["の"],["定め","さだめ"],["と"],["しなければ"],["ならない"],["。"]]},{"verse":30,"text":"人,ひとを殺,ころした者,もの、すなわち故,こ殺人,さつじんはすべて証人,しょうにんの証言,しょうげんにしたがって殺,ころされなければならない。しかし、だれもただひとりの証言,しょうげんによって殺,ころされることはない。","tok":[["人","ひと"],["を"],["殺ろした","ころした"],["者","もの"],["、"],["すなわち"],["故","こ"],["殺人","さつじん"],["は"],["すべて"],["証人","しょうにん"],["の"],["証言","しょうげん"],["に"],["したがって"],["殺ろされなければ","ころされなければ"],["ならない"],["。"],["しかし"],["、"],["だれ"],["も"],["ただ"],["ひとり"],["の"],["証言","しょうげん"],["によって"],["殺ろされる","ころされる"],["こと"],["は"],["ない"],["。"]]},{"verse":31,"text":"あなたがたは死,しに当,あたる罪,つみを犯,おかした故,こ殺人,さつじんの命,いのちのあがないしろを取,とってはならない。彼,かれは必,かならず殺,ころされなければならない。","tok":[["あなた"],["がた"],["は"],["死","し"],["に"],["当たる","あたる"],["罪","つみ"],["を"],["犯した","おかした"],["故","こ"],["殺人","さつじん"],["の"],["命","いのち"],["の"],["あがない"],["しろ"],["を"],["取って","とって"],["は"],["ならない"],["。"],["彼","かれ"],["は"],["必","かならず"],["殺ろされなければ","ころされなければ"],["ならない"],["。"]]},{"verse":32,"text":"また、のがれの町,まちにのがれた者,もののために、あがないしろを取,とって大,だい祭司,さいしの死,しぬ前,まえに彼,かれを自分,じぶんの地,ちに帰,かえり住,すまわせてはならない。","tok":[["また"],["、"],["のがれ"],["の"],["町","まち"],["に"],["のがれた"],["者","もの"],["の"],["ため"],["に"],["、"],["あがない"],["しろ"],["を"],["取って","とって"],["大","だい"],["祭司","さいし"],["の"],["死ぬ","しぬ"],["前","まえ"],["に"],["彼","かれ"],["を"],["自分","じぶん"],["の"],["地","ち"],["に"],["帰えり","かえり"],["住まわせて","すまわせて"],["は"],["ならない"],["。"]]},{"verse":33,"text":"あなたがたはそのおる所,ところの地,ちを汚,けがしてはならない。流血,りゅうけつは地,ちを汚,けがすからである。地,ちの上,うえに流,ながされた血,ちは、それを流,ながした者,ものの血,ちによらなければあがなうことができない。","tok":[["あなた"],["がた"],["は"],["その"],["おる"],["所","ところ"],["の"],["地","ち"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["流血","りゅうけつ"],["は"],["地","ち"],["を"],["汚","けがすか"],["ら"],["で"],["ある"],["。"],["地","ち"],["の"],["上","うえ"],["に"],["流された","ながされた"],["血","ち"],["は"],["、"],["それ"],["を"],["流した","ながした"],["者","もの"],["の"],["血","ち"],["に"],["よらなければ"],["あがなう"],["こと"],["が"],["できない"],["。"]]},{"verse":34,"text":"あなたがたは、その住,すむ所,ところの地,ち、すなわちわたしのおる地,ちを汚,けがしてはならない。主,しゅなるわたしがイスラエルの人々,ひとびとのうちに住,すんでいるからである」。","tok":[["あなた"],["がた"],["は"],["、"],["その"],["住む","すむ"],["所","ところ"],["の"],["地","ち"],["、"],["すなわち"],["わたし"],["の"],["おる"],["地","ち"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["主","しゅ"],["なる"],["わたし"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["うち"],["に"],["住んで","すんで"],["いる"],["から"],["で"],["ある"],["」"],["。"]]}]
[{"verse":1,"text":"時,ときにネゲブに住,すんでいたカナンびとアラデの王,おうは、イスラエルがアタリムの道,みちをとおって来,くると聞,きいて、イスラエルを攻撃,こうげきし、そのうちの数人,すうにんを捕虜,ほりょにした。","tok":[["時","とき"],["に"],["ネゲブ"],["に"],["住んで","すんで"],["いた"],["カナン"],["びと"],["アラデ"],["の"],["王","おう"],["は"],["、"],["イスラエル"],["が"],["アタリム"],["の"],["道","みち"],["を"],["とおって"],["来る","くる"],["と"],["聞いて","きいて"],["、"],["イスラエル"],["を"],["攻撃","こうげき"],["し"],["、"],["その"],["うち"],["の"],["数人","すうにん"],["を"],["捕虜","ほりょ"],["に"],["した"],["。"]]},{"verse":2,"text":"そこでイスラエルは主,しゅに誓,ちかいを立,たてて言,いった、「もし、あなたがこの民,たみをわたしの手,てにわたしてくださるならば、わたしはその町々,まちまちをことごとく滅,ほろぼしましょう」。","tok":[["そこ"],["で"],["イスラエル"],["は"],["主に","しゅに"],["誓い","ちかい"],["を"],["立てて","たてて"],["言った","いった"],["、"],["「"],["もし"],["、"],["あなた"],["が"],["この"],["民","たみ"],["を"],["わたし"],["の"],["手","て"],["に"],["わたして"],["くださるならば"],["、"],["わたし"],["は"],["その"],["町々","まちまち"],["を"],["ことごとく"],["滅ぼしましょう","ほろぼしましょう"],["」"],["。"]]},{"verse":3,"text":"主,しゅはイスラエルの言葉,ことばを聞,ききいれ、カナンびとをわたされたので、イスラエルはそのカナンびとと、その町々,まちまちとをことごとく滅,ほろぼした。それでその所,ところの名,なはホルマと呼,よばれた。","tok":[["主","しゅ"],["は"],["イスラエル"],["の"],["言葉","ことば"],["を"],["聞きいれ","ききいれ"],["、"],["カナン"],["びと"],["を"],["わたされた"],["ので"],["、"],["イスラエル"],["は"],["その"],["カナン"],["びと"],["と"],["、"],["その"],["町々","まちまち"],["と"],["を"],["ことごとく"],["滅ぼした","ほろぼした"],["。"],["それ"],["で"],["その"],["所","ところ"],["の"],["名","な"],["は"],["ホルマ"],["と"],["呼ばれた","よばれた"],["。"]]},{"verse":4,"text":"民,たみはホル山,やまから進,すすみ、紅海,こうかいの道,みちをとおって、エドムの地,ちを回,まわろうとしたが、民,たみはその道,みちに堪,たえがたくなった。","tok":[["民","たみ"],["は"],["ホル"],["山","やま"],["から"],["進み","すすみ"],["、"],["紅海","こうかい"],["の"],["道","みち"],["を"],["とおって"],["、"],["エドム"],["の"],["地","ち"],["を"],["回わろう","まわろう"],["と"],["した"],["が"],["、"],["民","たみ"],["は"],["その"],["道","みち"],["に"],["堪え","たえ"],["がたく"],["なった"],["。"]]},{"verse":5,"text":"民,たみは神,かみとモーセとにむかい、つぶやいて言,いった、「あなたがたはなぜわたしたちをエジプトから導,みちびき上,のぼって、荒野,あらので死,しなせようとするのですか。ここには食物,しょくもつもなく、水,みずもありません。わたしたちはこの粗悪,そあくな食物,しょくもつはいやになりました」。","tok":[["民","たみ"],["は"],["神","かみ"],["と"],["モーセ"],["と"],["に"],["むかい"],["、"],["つぶやいて"],["言った","いった"],["、"],["「"],["あなた"],["がた"],["は"],["なぜ"],["わたしたち"],["を"],["エジプト"],["から"],["導き","みちびき"],["上って","のぼって"],["、"],["荒野","あらの"],["で"],["死なせよう","しなせよう"],["と"],["する"],["の"],["です"],["か"],["。"],["ここ"],["に"],["は"],["食物","しょくもつ"],["も"],["なく"],["、"],["水","みず"],["も"],["ありません"],["。"],["わたしたち"],["は"],["この"],["粗悪","そあく"],["な"],["食物","しょくもつ"],["は"],["いや"],["に"],["なりました"],["」"],["。"]]},{"verse":6,"text":"そこで主,しゅは、火,ひのへびを民,たみのうちに送,おくられた。へびは民,たみをかんだので、イスラエルの民,たみのうち、多,おおくのものが死,しんだ。","tok":[["そこ"],["で"],["主","しゅ"],["は"],["、"],["火","ひ"],["の"],["へび"],["を"],["民","たみ"],["の"],["うち"],["に"],["送られた","おくられた"],["。"],["へび"],["は"],["民","たみ"],["を"],["かんだ"],["ので"],["、"],["イスラエル"],["の"],["民","たみ"],["の"],["うち"],["、"],["多く","おおく"],["の"],["もの"],["が"],["死んだ","しんだ"],["。"]]},{"verse":7,"text":"民,たみはモーセのもとに行,いって言,いった、「わたしたちは主,しゅにむかい、またあなたにむかい、つぶやいて罪,つみを犯,おかしました。どうぞへびをわたしたちから取,とり去,さられるように主,しゅに祈,いのってください」。モーセは民,たみのために祈,いのった。","tok":[["民","たみ"],["は"],["モーセ"],["の"],["もと"],["に"],["行って","いって"],["言った","いった"],["、"],["「"],["わたしたち"],["は"],["主に","しゅに"],["むかい"],["、"],["また"],["あなた"],["に"],["むかい"],["、"],["つぶやいて"],["罪","つみ"],["を"],["犯しました","おかしました"],["。"],["どうぞ"],["へび"],["を"],["わたしたち"],["から"],["取去られる","とりさられる"],["よう"],["に"],["主に","しゅに"],["祈って","いのって"],["ください"],["」"],["。"],["モーセ"],["は"],["民","たみ"],["の"],["ため"],["に"],["祈った","いのった"],["。"]]},{"verse":8,"text":"そこで主,しゅはモーセに言,いわれた、「火,ひのへびを造,つくって、それをさおの上,うえに掛,かけなさい。すべてのかまれた者,ものが仰,あおいで、それを見,みるならば生,いきるであろう」。","tok":[["そこ"],["で"],["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["火","ひ"],["の"],["へび"],["を"],["造って","つくって"],["、"],["それ"],["を"],["さお"],["の"],["上","うえ"],["に"],["掛","かけ"],["なさい"],["。"],["すべて"],["の"],["かまれた"],["者","もの"],["が"],["仰いで","あおいで"],["、"],["それ"],["を"],["見るならば","みるならば"],["生きるで","いきるで"],["あろう"],["」"],["。"]]},{"verse":9,"text":"モーセは青銅,せいどうで一つのへびを造,つくり、それをさおの上,うえに掛,かけて置,おいた。すべてへびにかまれた者,ものはその青銅,せいどうのへびを仰,あおいで見,みて生,いきた。","tok":[["モーセ"],["は"],["青銅","せいどう"],["で"],["一","ひと"],["つ"],["の"],["へび"],["を"],["造","つくり"],["、"],["それ"],["を"],["さお"],["の"],["上","うえ"],["に"],["掛て","かけて"],["置いた","おいた"],["。"],["すべて"],["へび"],["に"],["かまれた"],["者","もの"],["は"],["その"],["青銅","せいどう"],["の"],["へび"],["を"],["仰いで","あおいで"],["見て","みて"],["生きた","いきた"],["。"]]},{"verse":10,"text":"イスラエルの人々,ひとびとは道,みちを進,すすんでオボテに宿営,しゅくえいした。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["道","みち"],["を"],["進んで","すすんで"],["オボテ"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":11,"text":"またオボテから進,すすんで東,ひがしの方,ほう、モアブの前,まえにある荒野,あらのにおいて、イエアバリムに宿営,しゅくえいした。","tok":[["また"],["オボテ"],["から"],["進んで","すすんで"],["東","ひがし"],["の"],["方","ほう"],["、"],["モアブ"],["の"],["前","まえ"],["に"],["ある"],["荒野","あらの"],["に"],["おいて"],["、"],["イエアバリム"],["に"],["宿営","しゅくえい"],["した"],["。"]]},{"verse":12,"text":"またそこから進,すすんでゼレデの谷,たにに宿営,しゅくえいし、","tok":[["また"],["そこ"],["から"],["進んで","すすんで"],["ゼレデ"],["の"],["谷","たに"],["に"],["宿営","しゅくえい"],["し"],["、"]]},{"verse":13,"text":"さらにそこから進,すすんでアルノン川,かわのかなたに宿営,しゅくえいした。アルノン川,かわはアモリびとの境,さかいから延,のび広,ひろがる荒野,あらのを流,ながれるもので、モアブとアモリびととの間,あいだにあって、モアブの境,さかいをなしていた。","tok":[["さらに"],["そこ"],["から"],["進んで","すすんで"],["アルノン"],["川","かわ"],["の"],["かなた"],["に"],["宿営","しゅくえい"],["した"],["。"],["アルノン"],["川","かわ"],["は"],["アモリ"],["びと"],["の"],["境","さかい"],["から"],["延び広がる","のびひろがる"],["荒野","あらの"],["を"],["流れる","ながれる"],["もの"],["で"],["、"],["モアブ"],["と"],["アモリ"],["びと"],["と"],["の"],["間","あいだ"],["に"],["あって"],["、"],["モアブ"],["の"],["境","さかい"],["を"],["なして"],["いた"],["。"]]},{"verse":14,"text":"それゆえに、「主,しゅの戦,たたかいの書,しょ」にこう言,いわれている。「スパのワヘブ、アルノンの谷,たに々、","tok":[["それ"],["ゆえ"],["に"],["、"],["「"],["主","しゅ"],["の"],["戦い","たたかい"],["の"],["書","しょ"],["」"],["に"],["こう"],["言われて","いわれて"],["いる"],["。"],["「"],["スパ"],["の"],["ワヘブ"],["、"],["アルノン"],["の"],["谷々","たに々"],["、"]]},{"verse":15,"text":"谷,たに々の斜面,しゃめん、アルの町,まちまで傾,かたむき、モアブの境,さかいに寄,よりかかる」。","tok":[["谷々","たに々"],["の"],["斜面","しゃめん"],["、"],["アル"],["の"],["町","まち"],["まで"],["傾き","かたむき"],["、"],["モアブ"],["の"],["境","さかい"],["に"],["寄りかかる","よりかかる"],["」"],["。"]]},{"verse":16,"text":"彼,かれらはそこからベエルへ進,すすんで行,いった。これは主,しゅがモーセにむかって、「民,たみを集,あつめよ。わたしはかれらに水,みずを与,あたえるであろう」と言,いわれた井戸,いどである。","tok":[["彼","かれ"],["ら"],["は"],["そこ"],["から"],["ベエル"],["へ"],["進んで","すすんで"],["行った","いった"],["。"],["これ"],["は"],["主","しゅ"],["が"],["モーセ"],["に"],["むかって"],["、"],["「"],["民","たみ"],["を"],["集めよ","あつめよ"],["。"],["わたし"],["は"],["かれ"],["ら"],["に"],["水","みず"],["を"],["与えるで","あたえるで"],["あろう"],["」"],["と"],["言われた","いわれた"],["井戸","いど"],["で"],["ある"],["。"]]},{"verse":17,"text":"その時,ときイスラエルはこの歌,うたをうたった。「井戸,いどの水,みずよ、わきあがれ、人々,ひとびとよ、この井戸,いどのために歌,うたえ、","tok":[["その"],["時","とき"],["イスラエル"],["は"],["この"],["歌","うた"],["を"],["うたった"],["。"],["「"],["井戸","いど"],["の"],["水","みず"],["よ"],["、"],["わきあがれ"],["、"],["人々","ひとびと"],["よ"],["、"],["この"],["井戸","いど"],["の"],["ため"],["に"],["歌え","うたえ"],["、"]]},{"verse":18,"text":"笏,しゃくとつえとをもってつかさたちがこの井戸,いどを掘,ほり、民,たみのおさたちがこれを掘,ほった」。そして彼,かれらは荒野,あらのからマッタナに進,すすみ、","tok":[["笏","しゃく"],["と"],["つえ"],["と"],["を"],["もって"],["つかさ"],["たち"],["が"],["この"],["井戸","いど"],["を"],["掘","ほり"],["、"],["民","たみ"],["の"],["おさ"],["たち"],["が"],["これ"],["を"],["掘った","ほった"],["」"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["荒野","あら"],["の"],["から"],["マッタナ"],["に"],["進み","すすみ"],["、"]]},{"verse":19,"text":"マッタナからナハリエルに、ナハリエルからバモテに、","tok":[["マッタナ"],["から"],["ナハリエル"],["に"],["、"],["ナハリエル"],["から"],["バモテ"],["に"],["、"]]},{"verse":20,"text":"バモテからモアブの野,のにある谷,たにに行,いき、荒野,あらのを見,みおろすピスガの頂,いただきに着,ついた。","tok":[["バモテ"],["から"],["モアブ"],["の"],["野","の"],["に"],["ある"],["谷","たに"],["に"],["行き","いき"],["、"],["荒野","あら"],["の"],["を"],["見おろす","みおろす"],["ピスガ"],["の"],["頂","いただき"],["に"],["着いた","ついた"],["。"]]},{"verse":21,"text":"ここでイスラエルはアモリびとの王,おうシホンに使者,ししゃをつかわして言,いわせた、","tok":[["ここ"],["で"],["イスラエル"],["は"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["に"],["使者","ししゃ"],["を"],["つかわして"],["言わせた","いわせた"],["、"]]},{"verse":22,"text":"「わたしにあなたの国,くにを通,とおらせてください。わたしたちは畑,はたけにもぶどう畑,はたけにも、はいりません。また井戸,いどの水,みずも飲,のみません。わたしたちはあなたの領地,りょうちを通,とおり過,すぎるまで、ただ王,おうの大路,おおじを通,とおります」。","tok":[["「"],["わたし"],["に"],["あなた"],["の"],["国","くに"],["を"],["通らせて","とおらせて"],["ください"],["。"],["わたしたち"],["は"],["畑","はたけ"],["に"],["も"],["ぶどう"],["畑","はたけ"],["に"],["も"],["、"],["はいりません"],["。"],["また"],["井戸","いど"],["の"],["水","みず"],["も"],["飲みません","のみません"],["。"],["わたしたち"],["は"],["あなた"],["の"],["領地","りょうち"],["を"],["通り","とおり"],["過る","すぎる"],["まで"],["、"],["ただ"],["王","おう"],["の"],["大路","おおじ"],["を"],["通ります","とおります"],["」"],["。"]]},{"verse":23,"text":"しかし、シホンはイスラエルに自分,じぶんの領地,りょうちを通,とおることを許,ゆるさなかった。そしてシホンは民,たみをことごとく集,あつめ、荒野,あらのに出,でて、イスラエルを攻,せめようとし、ヤハズにきてイスラエルと戦,たたかった。","tok":[["しかし"],["、"],["シホン"],["は"],["イスラエル"],["に"],["自分","じぶん"],["の"],["領地","りょうち"],["を"],["通る","とおる"],["こと"],["を"],["許さなかった","ゆるさなかった"],["。"],["そして"],["シホン"],["は"],["民","たみ"],["を"],["ことごとく"],["集め","あつめ"],["、"],["荒野","あら"],["のに"],["出て","でて"],["、"],["イスラエル"],["を"],["攻めよう","せめよう"],["と"],["し"],["、"],["ヤハズ"],["に"],["きて"],["イスラエル"],["と"],["戦った","たたかった"],["。"]]},{"verse":24,"text":"イスラエルは、やいばで彼,かれを撃,うちやぶり、アルノンからヤボクまで彼,かれの地,ちを占領,せんりょうし、アンモンびとの境,さかいに及,およんだ。ヤゼルはアンモンびとの境,さかいだからである。","tok":[["イスラエル"],["は"],["、"],["やい"],["ば"],["で"],["彼","かれ"],["を"],["撃ち","うち"],["やぶり"],["、"],["アルノン"],["から"],["ヤボク"],["まで"],["彼","かれ"],["の"],["地","ち"],["を"],["占領","せんりょう"],["し"],["、"],["アンモン"],["びと"],["の"],["境","さかい"],["に"],["及んだ","およんだ"],["。"],["ヤゼル"],["は"],["アンモン"],["びと"],["の"],["境","さかい"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"こうしてイスラエルはこれらの町々,まちまちをことごとく取,とった。そしてイスラエルはアモリびとのすべての町々,まちまちに住,すみ、ヘシボンとそれに附属,ふぞくするすべての村々,むらむらにいた。","tok":[["こう"],["して"],["イスラエル"],["は"],["これ"],["ら"],["の"],["町々","まちまち"],["を"],["ことごとく"],["取った","とった"],["。"],["そして"],["イスラエル"],["は"],["アモリ"],["びと"],["の"],["すべて"],["の"],["町々","まちまち"],["に"],["住み","すみ"],["、"],["ヘシボン"],["と"],["それ"],["に"],["附属","ふぞく"],["する"],["すべて"],["の"],["村々","むらむら"],["に"],["いた"],["。"]]},{"verse":26,"text":"ヘシボンはアモリびとの王,おうシホンの都,みやこであって、シホンはモアブの以前,いぜんの王,おうと戦,たたかって、彼,かれの地,ちをアルノンまで、ことごとくその手,てから奪,うばい取,とったのである。","tok":[["ヘシボン"],["は"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["の"],["都","みやこ"],["で"],["あって"],["、"],["シホン"],["は"],["モアブ"],["の"],["以前","いぜん"],["の"],["王","おう"],["と"],["戦って","たたかって"],["、"],["彼","かれ"],["の"],["地","ち"],["を"],["アルノン"],["まで"],["、"],["ことごとく"],["その"],["手","て"],["から"],["奪い取った","うばいとった"],["ので"],["ある"],["。"]]},{"verse":27,"text":"それゆえに歌,うたにうたわれている。「人々,ひとびとよ、ヘシボンにきたれ、シホンの町,まちを築,きずき建,たてよ。","tok":[["それ"],["ゆえ"],["に"],["歌","うた"],["に"],["うたわれて"],["いる"],["。"],["「"],["人々","ひとびと"],["よ"],["、"],["ヘシボン"],["に"],["きたれ"],["、"],["シホン"],["の"],["町","まち"],["を"],["築き","きずき"],["建て","たて"],["よ"],["。"]]},{"verse":28,"text":"ヘシボンから火,ひが燃,もえ出,だし、シホンの都,みやこから炎,ほのおが出,でて、モアブのアルを焼,やき尽,つくし、アルノンの高地,こうちの君,きみたちを滅,ほろぼしたからだ。","tok":[["ヘシボン"],["から"],["火","ひ"],["が"],["燃え","もえ"],["出し","だし"],["、"],["シホン"],["の"],["都","みやこか"],["ら"],["炎","ほのお"],["が"],["出て","でて"],["、"],["モアブ"],["の"],["アル"],["を"],["焼き","やき"],["尽くし","つくし"],["、"],["アルノン"],["の"],["高地","こうち"],["の"],["君","きみ"],["たち"],["を"],["滅ぼした","ほろぼした"],["から"],["だ"],["。"]]},{"verse":29,"text":"モアブよ、お前,まえはわざわいなるかな、ケモシの民,たみよ、お前,まえは滅,ほろぼされるであろう。彼,かれは、むすこらを逃,にげ去,さらせ、娘,むすめらをアモリびとの王,おうシホンの捕虜,ほりょとならせた。","tok":[["モアブ"],["よ"],["、"],["お前","おまえ"],["は"],["わざわい"],["なる"],["か"],["な"],["、"],["ケモシ"],["の"],["民","たみ"],["よ"],["、"],["お前","おまえ"],["は"],["滅ぼされるで","ほろぼされるで"],["あろう"],["。"],["彼","かれ"],["は"],["、"],["むすこ"],["ら"],["を"],["逃","にげ"],["去らせ","さらせ"],["、"],["娘","むすめ"],["ら"],["を"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["の"],["捕虜","ほりょ"],["と"],["ならせた"],["。"]]},{"verse":30,"text":"彼,かれらの子,こらは滅,ほろび去,さった、ヘシボンからデボンまで。われわれは荒,あらした、火,ひはついてメデバに及,およんだ」。","tok":[["彼","かれ"],["ら"],["の"],["子","こ"],["ら"],["は"],["滅び","ほろび"],["去た","さった"],["、"],["ヘシボン"],["から"],["デボン"],["まで"],["。"],["われわれ"],["は"],["荒した","あらした"],["、"],["火","ひ"],["は"],["ついて"],["メデバ"],["に"],["及んだ","およんだ"],["」"],["。"]]},{"verse":31,"text":"こうしてイスラエルはアモリびとの地,ちに住,すんだが、","tok":[["こう"],["して"],["イスラエル"],["は"],["アモリ"],["びと"],["の"],["地","ち"],["に"],["住んだ","すんだ"],["が"],["、"]]},{"verse":32,"text":"モーセはまた人,ひとをつかわしてヤゼルを探,さぐらせ、ついにその村々,むらむらを取,とって、そこにいたアモリびとを追,おい出,だし、","tok":[["モーセ"],["は"],["また"],["人","ひと"],["を"],["つかわして"],["ヤゼル"],["を"],["探ぐらせ","さぐらせ"],["、"],["ついに"],["その"],["村々","むらむら"],["を"],["取って","とって"],["、"],["そこ"],["に"],["いた"],["アモリ"],["びと"],["を"],["追い出し","おいだし"],["、"]]},{"verse":33,"text":"転,てんじてバシャンの道,みちに上,のぼって行,いったが、バシャンの王,おうオグは、その民,たみをことごとく率,ひきい、エデレイで戦,たたかおうとして出迎,でむかえた。","tok":[["転じて","てんじて"],["バシャン"],["の"],["道","みち"],["に"],["上って","のぼって"],["行った","いった"],["が"],["、"],["バシャン"],["の"],["王","おう"],["オグ"],["は"],["、"],["その"],["民","たみ"],["を"],["ことごとく"],["率い","ひきい"],["、"],["エデレイ"],["で"],["戦おう","たたかおう"],["として"],["出迎","でむかえ"],["た"],["。"]]},{"verse":34,"text":"主,しゅはモーセに言,いわれた、「彼,かれを恐,おそれてはならない。わたしは彼,かれとその民,たみとその地,ちとを、ことごとくあなたの手,てにわたす。あなたはヘシボンに住,すんでいたアモリびとの王,おうシホンにしたように彼,かれにもするであろう」。","tok":[["主","しゅ"],["は"],["モーセ"],["に"],["言われた","いわれた"],["、"],["「"],["彼","かれ"],["を"],["恐れて","おそれて"],["は"],["ならない"],["。"],["わたし"],["は"],["彼","かれ"],["と"],["その"],["民","たみ"],["と"],["その"],["地","ち"],["と"],["を"],["、"],["ことごとく"],["あなた"],["の"],["手","て"],["に"],["わたす"],["。"],["あなた"],["は"],["ヘシボン"],["に"],["住んで","すんで"],["いた"],["アモリ"],["びと"],["の"],["王","おう"],["シホン"],["に"],["した"],["よう"],["に"],["彼","かれ"],["に"],["も"],["するで"],["あろう"],["」"],["。"]]},{"verse":35,"text":"そこで彼,かれとその子,ことすべての民,たみとを、ひとり残,のこらず撃,うち殺,ころして、その地,ちを占領,せんりょうした。","tok":[["そこ"],["で"],["彼","かれ"],["と"],["その"],["子","こ"],["と"],["すべて"],["の"],["民","たみ"],["と"],["を"],["、"],["ひとり"],["残らず","のこらず"],["撃ち","うち"],["殺ろ","ころ"],["して"],["、"],["その"],["地","ち"],["を"],["占領","せんりょう"],["した"],["。"]]}]
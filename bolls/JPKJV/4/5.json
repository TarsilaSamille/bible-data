[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに命,めいじて、らい病人,びょうにん、流出,りゅうしゅつのある者,もの、死体,したいにふれて汚,けがれた者,ものを、ことごとく宿営,しゅくえいの外,そとに出,ださせなさい。","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["命じて","めいじて"],["、"],["らい病人","らいびょうにん"],["、"],["流出","りゅうしゅつ"],["の"],["ある"],["者","もの"],["、"],["死体","したい"],["に"],["ふれて"],["汚","け"],["がれ"],["た"],["者","もの"],["を"],["、"],["ことごとく"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["出させ","ださせ"],["なさい"],["。"]]},{"verse":3,"text":"男,おとこでも女,おんなでも、あなたがたは彼,かれらを宿営,しゅくえいの外,そとに出,だしてそこにおらせ、彼,かれらに宿営,しゅくえいを汚,けがさせてはならない。わたしがその中,なかに住,すんでいるからである」。","tok":[["男","おとこ"],["で"],["も"],["女","おんな"],["で"],["も"],["、"],["あなた"],["がた"],["は"],["彼","かれ"],["ら"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["出して","だして"],["そこ"],["に"],["おらせ"],["、"],["彼","かれ"],["ら"],["に"],["宿営","しゅくえい"],["を"],["汚","け"],["が"],["させて"],["は"],["ならない"],["。"],["わたし"],["が"],["その"],["中","なか"],["に"],["住んで","すんで"],["いる"],["から"],["で"],["ある"],["」"],["。"]]},{"verse":4,"text":"イスラエルの人々,ひとびとはそのようにして、彼,かれらを宿営,しゅくえいの外,そとに出,だした。すなわち、主,しゅがモーセに言,いわれたようにイスラエルの人々,ひとびとは行,いった。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["は"],["その"],["よう"],["に"],["して"],["、"],["彼","かれ"],["ら"],["を"],["宿営","しゅくえい"],["の"],["外","そと"],["に"],["出した","だした"],["。"],["すなわち"],["、"],["主","しゅ"],["が"],["モーセ"],["に"],["言われた","いわれた"],["よう"],["に"],["イスラエル"],["の"],["人々","ひとびと"],["は"],["行った","いった"],["。"]]},{"verse":5,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":6,"text":"「イスラエルの人々,ひとびとに告,つげなさい、『男,おとこまたは女,おんなが、もし人,ひとの犯,おかす罪,つみをおかして、主,しゅに罪,つみを得,え、その人,ひとがとがある者,ものとなる時,ときは、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["なさい"],["、"],["『"],["男","おとこ"],["また"],["は"],["女","おんな"],["が"],["、"],["もし"],["人","ひと"],["の"],["犯す","おかす"],["罪","つみ"],["を"],["おかして"],["、"],["主に","しゅに"],["罪","つみ"],["を"],["得","え"],["、"],["その"],["人","ひと"],["が"],["と"],["が"],["ある"],["者","もの"],["と"],["なる"],["時","とき"],["は"],["、"]]},{"verse":7,"text":"その犯,おかした罪,つみを告白,こくはくし、その物,ものの価,あたいにその五分,ぶんの一を加,くわえて、彼,かれがとがを犯,おかした相手方,あいてがたに渡,わたし、そのとがをことごとく償,つぐなわなければならない。","tok":[["その"],["犯した","おかした"],["罪","つみ"],["を"],["告白","こくはく"],["し"],["、"],["その"],["物","もの"],["の"],["価","あたい"],["に"],["その"],["五分","ぶん"],["の"],["一","いち"],["を"],["加えて","くわえて"],["、"],["彼","かれ"],["が"],["とが"],["を"],["犯した","おかした"],["相手方","あいてがた"],["に"],["渡","わたし"],["、"],["その"],["とが"],["を"],["ことごとく"],["償なわなければ","つぐなわなければ"],["ならない"],["。"]]},{"verse":8,"text":"しかし、もし、そのとがの償,つぐないを受,うけ取,とるべき親族,しんぞくも、その人,ひとにない時,ときは、主,しゅにそのとがの償,つぐないをして、これを祭司,さいしに帰,きせしめなければならない。なお、このほか、そのあがないをするために用,もちいた贖罪,しょくざいの雄羊,おひつじも、祭司,さいしに帰,きせしめなければならない。","tok":[["しかし"],["、"],["もし"],["、"],["その"],["とが"],["の"],["償ない","つぐない"],["を"],["受け取るべき","うけとるべき"],["親族","しんぞく"],["も"],["、"],["その"],["人","ひと"],["に"],["ない"],["時","とき"],["は"],["、"],["主に","しゅに"],["その"],["とが"],["の"],["償ない","つぐない"],["を"],["して"],["、"],["これ"],["を"],["祭司","さいし"],["に"],["帰せしめなければ","きせしめなければ"],["ならない"],["。"],["なお"],["、"],["この"],["ほか"],["、"],["その"],["あ"],["が"],["ない"],["を"],["する"],["ため"],["に"],["用いた","もちいた"],["贖罪","しょくざい"],["の"],["雄羊","おひつじ"],["も"],["、"],["祭司","さいし"],["に"],["帰せしめなければ","きせしめなければ"],["ならない"],["。"]]},{"verse":9,"text":"イスラエルの人々,ひとびとが、祭司,さいしのもとに携,たずさえて来,くるすべての聖,せいなるささげ物,ものは、みな祭司,さいしに帰,きせしめなければならない。","tok":[["イスラエル"],["の"],["人々","ひとびと"],["が"],["、"],["祭司","さいし"],["の"],["もと"],["に"],["携えて","たずさえて"],["来る","くる"],["すべて"],["の"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["は"],["、"],["みな"],["祭司","さいし"],["に"],["帰せしめなければ","きせしめなければ"],["ならない"],["。"]]},{"verse":10,"text":"すべて人,ひとの聖,せいなるささげ物,ものは祭司,さいしに帰,きし、すべて人,ひとが祭司,さいしに与,あたえる物,ものは祭司,さいしに帰,きするであろう』」。","tok":[["すべて"],["人","ひと"],["の"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["は"],["祭司","さいし"],["に"],["帰し","きし"],["、"],["すべて"],["人","ひと"],["が"],["祭司","さいし"],["に"],["与える","あたえる"],["物","もの"],["は"],["祭司","さいし"],["に"],["帰するで","きするで"],["あろう"],["』"],["」"],["。"]]},{"verse":11,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":12,"text":"「イスラエルの人々,ひとびとに告,つげなさい、『もし人,ひとの妻,つまたる者,ものが、道,みちならぬ事,ことをして、その夫,おっとに罪,つみを犯,おかし、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["告","つげ"],["なさい"],["、"],["『"],["もし"],["人","ひと"],["の"],["妻","つま"],["たる"],["者","もの"],["が"],["、"],["道","みち"],["ならぬ"],["事","こと"],["を"],["して"],["、"],["その"],["夫","おっと"],["に"],["罪","つみ"],["を"],["犯し","おかし"],["、"]]},{"verse":13,"text":"人,ひとが彼女,かのじょと寝,ねたのに、その事,ことが夫,おっとの目,めに隠,かくれて現,あらわれず、彼女,かのじょはその身,みを汚,けがしたけれども、それに対,たいする証人,しょうにんもなく、彼女,かのじょもまたその時,ときに捕,とらえられなかった場合,ばあい、","tok":[["人","ひと"],["が"],["彼女","かのじょ"],["と"],["寝た","ねた"],["のに"],["、"],["その"],["事","こと"],["が"],["夫","おっと"],["の"],["目","め"],["に"],["隠れて","かくれて"],["現われず","あらわれず"],["、"],["彼女","かのじょ"],["は"],["その"],["身","み"],["を"],["汚","け"],["がした"],["けれど"],["も"],["、"],["それ"],["に"],["対する","たいする"],["証人","しょうにん"],["も"],["なく"],["、"],["彼女","かのじょ"],["も"],["また"],["その"],["時","とき"],["に"],["捕らえられなかった","とらえられなかった"],["場合","ばあい"],["、"]]},{"verse":14,"text":"すなわち、妻,つまが身,みを汚,けがしたために、夫,おっとが疑,うたがいの心,こころを起,おこして妻,つまを疑,うたがうことがあり、または妻,つまが身,みを汚,けがした事,ことがないのに、夫,おっとが疑,うたがいの心,こころを起,おこして妻,つまを疑,うたがうことがあれば、","tok":[["すなわち"],["、"],["妻","つま"],["が"],["身","み"],["を"],["汚","け"],["がした"],["ため"],["に"],["、"],["夫","おっと"],["が"],["疑がい","うたがい"],["の"],["心","こころ"],["を"],["起こして","おこして"],["妻","つま"],["を"],["疑がう","うたがう"],["こと"],["が"],["あり"],["、"],["また"],["は"],["妻","つま"],["が"],["身","み"],["を"],["汚","け"],["がした"],["事","こと"],["が"],["ない"],["のに"],["、"],["夫","おっと"],["が"],["疑がい","うたがい"],["の"],["心","こころ"],["を"],["起こして","おこして"],["妻","つま"],["を"],["疑がう","うたがう"],["こと"],["が"],["あれば"],["、"]]},{"verse":15,"text":"夫,おっとは妻,つまを祭司,さいしのもとに伴,ともない、彼女,かのじょのために大麦,おおむぎの粉,こな一エパの十分,ぶんの一を供,そなえ物,ものとして携,たずさえてこなければならない。ただし、その上,うえに油,あぶらを注,そそいではならない。また乳香,にゅうこうを加,くわえてはならない。これは疑,うたがいの供,そなえ物,もの、覚,おぼえの供,そなえ物,ものであって罪,つみを覚,おぼえさせるものだからである。","tok":[["夫","おっと"],["は"],["妻","つま"],["を"],["祭司","さいし"],["の"],["もと"],["に"],["伴い","ともない"],["、"],["彼女","かのじょ"],["の"],["ため"],["に"],["大麦","おおむぎ"],["の"],["粉","こな"],["一","いち"],["エパ"],["の"],["十分","ぶん"],["の"],["一","いち"],["を"],["供え物","そなえもの"],["として"],["携えて","たずさえて"],["こなければ"],["ならない"],["。"],["ただし"],["、"],["その"],["上","うえ"],["に"],["油","あぶら"],["を"],["注いで","そそいで"],["は"],["ならない"],["。"],["また"],["乳香","にゅうこう"],["を"],["加えて","くわえて"],["は"],["ならない"],["。"],["これ"],["は"],["疑がい","うたがい"],["の"],["供え物","そなえもの"],["、"],["覚え","おぼえ"],["の"],["供え物","そなえもの"],["で"],["あって"],["罪","つみ"],["を"],["覚えさせる","おぼえさせる"],["もの"],["だ"],["から"],["で"],["ある"],["。"]]},{"verse":16,"text":"祭司,さいしはその女,おんなを近,ちかく進,すすませ、主,しゅの前,まえに立,たたせなければならない。","tok":[["祭司","さいし"],["は"],["その"],["女","おんな"],["を"],["近く","ちかく"],["進ませ","すすませ"],["、"],["主","しゅ"],["の"],["前","まえ"],["に"],["立たせなければ","たたせなければ"],["ならない"],["。"]]},{"verse":17,"text":"祭司,さいしはまた土,つちの器,うつわに聖,せいなる水,みずを入,いれ、幕屋,まくやのゆかのちりを取,とってその水,みずに入,いれ、","tok":[["祭司","さいし"],["は"],["また"],["土","つち"],["の"],["器","うつわ"],["に"],["聖","せい"],["なる"],["水","みず"],["を"],["入れ","いれ"],["、"],["幕屋","まくや"],["の"],["ゆか"],["の"],["ちり"],["を"],["取って","とって"],["その"],["水","みず"],["に"],["入れ","いれ"],["、"]]},{"verse":18,"text":"その女,おんなを主,しゅの前,まえに立,たたせ、女,おんなにその髪,かみの毛,けをほどかせ、覚,おぼえの供,そなえ物,ものすなわち、疑,うたがいの供,そなえ物,ものを、その手,てに持,もたせなければならない。そして祭司,さいしは、のろいの苦,にがい水,みずを手,てに取,とり、","tok":[["その"],["女","おんな"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["立たせ","たたせ"],["、"],["女","おんな"],["に"],["その"],["髪の毛","かみのけ"],["を"],["ほどかせ"],["、"],["覚え","おぼえ"],["の"],["供え物","そなえもの"],["すなわち"],["、"],["疑がい","うたがい"],["の"],["供え物","そなえもの"],["を"],["、"],["その"],["手","て"],["に"],["持たせなければ","もたせなければ"],["ならない"],["。"],["そして"],["祭司","さいし"],["は"],["、"],["のろい"],["の"],["苦い","にがい"],["水","みず"],["を"],["手","て"],["に"],["取","とり"],["、"]]},{"verse":19,"text":"女,おんなに誓,ちかわせて、これに言,いわなければならない、「もし人,ひとがあなたと寝,ねたことがなく、またあなたが、夫,おっとのもとにあって、道,みちならぬ事,ことをして汚,けがれたことがなければ、のろいの苦,にがい水,みずも、あなたに害,がいを与,あたえないであろう。","tok":[["女","おんな"],["に"],["誓わせて","ちかわせて"],["、"],["これ"],["に"],["言わなければ","いわなければ"],["ならない"],["、"],["「"],["もし"],["人","ひと"],["が"],["あなた"],["と"],["寝た","ねた"],["こと"],["が"],["なく"],["、"],["また"],["あなた"],["が"],["、"],["夫","おっと"],["の"],["もと"],["に"],["あって"],["、"],["道","みち"],["ならぬ"],["事","こと"],["を"],["して"],["汚","けがれたこ"],["と"],["が"],["なければ"],["、"],["のろい"],["の"],["苦い","にがい"],["水","みず"],["も"],["、"],["あなた"],["に"],["害","がい"],["を"],["与えないで","あたえないで"],["あろう"],["。"]]},{"verse":20,"text":"しかし、あなたが、もし夫,おっとのもとにあって、道,みちならぬことをして身,みを汚,けがし、あなたの夫,おっとでない人,ひとが、あなたと寝,ねたことがあるならば、――","tok":[["しかし"],["、"],["あなた"],["が"],["、"],["もし"],["夫","おっと"],["の"],["もと"],["に"],["あって"],["、"],["道","みち"],["ならぬ"],["こと"],["を"],["して"],["身","み"],["を"],["汚","け"],["がし"],["、"],["あなた"],["の"],["夫","おっと"],["で"],["ない"],["人","ひと"],["が"],["、"],["あなた"],["と"],["寝た","ねた"],["こと"],["が"],["あるならば"],["、"],["―"],["―"]]},{"verse":21,"text":"祭司,さいしはその女,おんなに、のろいの誓,ちかいをもって誓,ちかわせ、その女,おんなに言,いわなければならない。――主,しゅはあなたのももをやせさせ、あなたの腹,はらをふくれさせて、あなたを民,たみのうちの、のろいとし、また、ののしりとされるように。","tok":[["祭司","さいし"],["は"],["その"],["女","おんな"],["に"],["、"],["のろい"],["の"],["誓い","ちかい"],["を"],["もって"],["誓わせ","ちかわせ"],["、"],["その"],["女","おんな"],["に"],["言わなければ","いわなければ"],["ならない"],["。"],["―"],["―"],["主","しゅ"],["は"],["あなた"],["の"],["もも"],["を"],["やせさせ"],["、"],["あなた"],["の"],["腹","はら"],["を"],["ふくれさせて"],["、"],["あなた"],["を"],["民","たみ"],["の"],["うち"],["の"],["、"],["のろい"],["と"],["し"],["、"],["また"],["、"],["ののしり"],["と"],["される"],["よう"],["に"],["。"]]},{"verse":22,"text":"また、のろいの水,みずが、あなたの腹,はらにはいってあなたの腹,はらをふくれさせ、あなたのももをやせさせるように」。その時,とき、女,おんなは「アァメン、アァメン」と言,いわなければならない。","tok":[["また"],["、"],["のろい"],["の"],["水","みず"],["が"],["、"],["あなた"],["の"],["腹","はら"],["に"],["はいって"],["あなた"],["の"],["腹","はら"],["を"],["ふくれさせ"],["、"],["あなた"],["の"],["もも"],["を"],["やせさせる"],["よう"],["に"],["」"],["。"],["その"],["時","とき"],["、"],["女","おんな"],["は"],["「"],["アァメン"],["、"],["アァメン"],["」"],["と"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":23,"text":"祭司,さいしは、こののろいを書,かき物,ものに書,かきしるし、それを苦,にがい水,みずに洗,あらい落,おとし、","tok":[["祭司","さいし"],["は"],["、"],["この"],["のろい"],["を"],["書き物","かきもの"],["に"],["書きしるし","かきしるし"],["、"],["それ"],["を"],["苦い","にがい"],["水","みず"],["に"],["洗","あらい"],["落とし","おとし"],["、"]]},{"verse":24,"text":"女,おんなにそののろいの水,みずを飲,のませなければならない。そののろいの水,みずは彼女,かのじょのうちにはいって苦,にがくなるであろう。","tok":[["女","おんな"],["に"],["その"],["のろい"],["の"],["水","みず"],["を"],["飲ませなければ","のませなければ"],["ならない"],["。"],["その"],["のろい"],["の"],["水","みず"],["は"],["彼女","かのじょ"],["の"],["うち"],["に"],["はいって"],["苦く","にがく"],["なるで"],["あろう"],["。"]]},{"verse":25,"text":"そして祭司,さいしはその女,おんなの手,てから疑,うたがいの供,そなえ物,ものを取,とり、その供,そなえ物,ものを主,しゅの前,まえに揺,ゆり動,うごかして、それを祭壇,さいだんに持,もってこなければならない。","tok":[["そして"],["祭司","さいし"],["は"],["その"],["女","おんな"],["の"],["手","て"],["から"],["疑がい","うたがい"],["の"],["供え物","そなえもの"],["を"],["取","とり"],["、"],["その"],["供え物","そなえもの"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["揺り動かして","ゆりうごかして"],["、"],["それ"],["を"],["祭壇","さいだん"],["に"],["持って","もって"],["こなければ"],["ならない"],["。"]]},{"verse":26,"text":"祭司,さいしはその供,そなえ物,もののうちから、覚,おぼえの分,ぶん、一握,ひとにぎりを取,とって、それを祭壇,さいだんで焼,やき、その後,のち、女,おんなにその水,みずを飲,のませなければならない。","tok":[["祭司","さいし"],["は"],["その"],["供え物","そなえもの"],["の"],["うち"],["から"],["、"],["覚え","おぼえ"],["の"],["分","ぶん"],["、"],["一握り","ひとにぎり"],["を"],["取って","とって"],["、"],["それ"],["を"],["祭壇","さいだん"],["で"],["焼き","やき"],["、"],["その後","そのの"],["ち"],["、"],["女","おんな"],["に"],["その"],["水","みず"],["を"],["飲ませなければ","のませなければ"],["ならない"],["。"]]},{"verse":27,"text":"その水,みずを女,おんなに飲,のませる時,とき、もしその女,おんなが身,みを汚,けがし、夫,おっとに罪,つみを犯,おかした事,ことがあれば、そののろいの水,みずは女,おんなのうちにはいって苦,にがくなり、その腹,はらはふくれ、ももはやせて、その女,おんなは民,たみのうちののろいとなるであろう。","tok":[["その"],["水","みず"],["を"],["女","おんな"],["に"],["飲ませる","のませる"],["時","とき"],["、"],["もし"],["その"],["女","おんな"],["が"],["身","み"],["を"],["汚","け"],["がし"],["、"],["夫","おっと"],["に"],["罪","つみ"],["を"],["犯した","おかした"],["事","こと"],["が"],["あれば"],["、"],["その"],["のろい"],["の"],["水","みず"],["は"],["女","おんな"],["の"],["うち"],["に"],["はいって"],["苦く","にがく"],["なり"],["、"],["その"],["腹","はら"],["は"],["ふくれ"],["、"],["もも"],["は"],["やせて"],["、"],["その"],["女","おんな"],["は"],["民","たみ"],["の"],["うち"],["の"],["のろい"],["と"],["なるで"],["あろう"],["。"]]},{"verse":28,"text":"しかし、もし女,おんなが身,みを汚,けがした事,ことがなく、清,きよいならば、害,がいを受,うけないで、子,こを産,うむことができるであろう。","tok":[["しかし"],["、"],["もし"],["女","おんな"],["が"],["身","み"],["を"],["汚","け"],["がした"],["事","こと"],["が"],["なく"],["、"],["清いならば","きよいならば"],["、"],["害","がい"],["を"],["受ないで","うけないで"],["、"],["子","こ"],["を"],["産む","うむ"],["こと"],["が"],["できるで"],["あろう"],["。"]]},{"verse":29,"text":"これは疑,うたがいのある時,ときのおきてである。妻,つまたる者,ものが夫,おっとのもとにあって、道,みちならぬ事,ことをして身,みを汚,けがした時,とき、","tok":[["これ"],["は"],["疑がい","うたがい"],["の"],["ある"],["時","とき"],["の"],["おきて"],["で"],["ある"],["。"],["妻","つま"],["たる"],["者","もの"],["が"],["夫","おっと"],["の"],["もと"],["に"],["あって"],["、"],["道","みち"],["ならぬ"],["事","こと"],["を"],["して"],["身","み"],["を"],["汚","け"],["がした"],["時","とき"],["、"]]},{"verse":30,"text":"または夫,おっとたる者,ものが疑,うたがいの心,こころを起,おこして、妻,つまを疑,うたがう時,とき、彼,かれはその女,おんなを主,しゅの前,まえに立,たたせ、祭司,さいしはこのおきてを、ことごとく彼女,かのじょに行,おこなわなければならない。","tok":[["また"],["は"],["夫","おっと"],["たる"],["者","もの"],["が"],["疑がい","うたがい"],["の"],["心","こころ"],["を"],["起こして","おこして"],["、"],["妻","つま"],["を"],["疑がう","うたがう"],["時","とき"],["、"],["彼","かれ"],["は"],["その"],["女","おんな"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["立たせ","たたせ"],["、"],["祭司","さいし"],["は"],["この"],["おきて"],["を"],["、"],["ことごとく"],["彼女","かのじょ"],["に"],["行なわなければ","おこなわなければ"],["ならない"],["。"]]},{"verse":31,"text":"こうするならば、夫,おっとは罪,つみがなく、妻,つまは罪,つみを負,おうであろう』」。","tok":[["こう"],["するならば"],["、"],["夫","おっと"],["は"],["罪","つみ"],["が"],["なく"],["、"],["妻","つま"],["は"],["罪","つみ"],["を"],["負うで","おうで"],["あろう"],["』"],["」"],["。"]]}]
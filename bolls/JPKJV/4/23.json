[{"verse":1,"text":"バラムはバラクに言,いった、「わたしのために、ここに七つの祭壇,さいだんを築,きずき、七頭,とうの雄牛,おうしと七頭,とうの雄羊,おひつじとを整,ととのえなさい」。","tok":[["バラム"],["は"],["バラク"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["ため"],["に"],["、"],["ここ"],["に"],["七","なな"],["つ"],["の"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["七頭","とう"],["の"],["雄牛","おうし"],["と"],["七頭","とう"],["の"],["雄羊","おひつじ"],["と"],["を"],["整え","ととのえ"],["なさい"],["」"],["。"]]},{"verse":2,"text":"バラクはバラムの言,いったとおりにした。そしてバラクとバラムとは、その祭壇,さいだんごとに雄牛,おうし一頭,とうと雄羊,おひつじ一頭,とうとをささげた。","tok":[["バラク"],["は"],["バラム"],["の"],["言った","いった"],["とおり"],["に"],["した"],["。"],["そして"],["バラク"],["と"],["バラム"],["と"],["は"],["、"],["その"],["祭壇","さいだん"],["ごと"],["に"],["雄牛","おうし"],["一頭","とう"],["と"],["雄羊","おひつじ"],["一頭","とうと"],["を"],["ささげた"],["。"]]},{"verse":3,"text":"バラムはバラクに言,いった、「あなたは燔祭,はんさいのかたわらに立,たっていてください。その間,あいだにわたしは行,いってきます。主,しゅはたぶんわたしに会,あってくださるでしょう。そして、主,しゅがわたしに示,しめされる事,ことはなんでもあなたに告,つげましょう」。こうして彼,かれは一つのはげ山,やまに登,のぼった。","tok":[["バラム"],["は"],["バラク"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["燔祭","はんさい"],["の"],["かたわら"],["に"],["立って","たって"],["いて"],["ください"],["。"],["その"],["間","あいだ"],["に"],["わたし"],["は"],["行って","いって"],["きます"],["。"],["主","しゅ"],["は"],["たぶん"],["わたし"],["に"],["会って","あって"],["くださるでしょう"],["。"],["そして"],["、"],["主","しゅ"],["が"],["わたし"],["に"],["示めされる","しめされる"],["事","こと"],["は"],["なん"],["で"],["も"],["あなた"],["に"],["告","つげ"],["ましょう"],["」"],["。"],["こう"],["して"],["彼","かれ"],["は"],["一","ひと"],["つ"],["の"],["はげ山","はげやま"],["に"],["登った","のぼった"],["。"]]},{"verse":4,"text":"神,かみがバラムに会,あわれたので、バラムは神,かみに言,いった、「わたしは七つの祭壇,さいだんを設,もうけ、祭壇,さいだんごとに雄牛,おうし一頭,とうと雄羊,おひつじ一頭,とうとをささげました」。","tok":[["神","かみ"],["が"],["バラム"],["に"],["会われた","あわれた"],["ので"],["、"],["バラム"],["は"],["神","かみ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["は"],["七","なな"],["つ"],["の"],["祭壇","さいだん"],["を"],["設け","もうけ"],["、"],["祭壇","さいだん"],["ごと"],["に"],["雄牛","おうし"],["一頭","とう"],["と"],["雄羊","おひつじ"],["一頭","とうと"],["を"],["ささげました"],["」"],["。"]]},{"verse":5,"text":"主,しゅはバラムの口,くちに言葉,ことばを授,さづけて言,いわれた、「バラクのもとに帰,かえってこう言,いいなさい」。","tok":[["主","しゅ"],["は"],["バラム"],["の"],["口","くち"],["に"],["言葉","ことば"],["を"],["授","さ"],["づけて"],["言われた","いわれた"],["、"],["「"],["バラク"],["の"],["もと"],["に"],["帰えって","かえって"],["こう"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":6,"text":"彼,かれがバラクのもとに帰,かえってみると、バラクはモアブのすべてのつかさたちと共,ともに燔祭,はんさいのかたわらに立,たっていた。","tok":[["彼","かれ"],["が"],["バラク"],["の"],["もと"],["に"],["帰えって","かえって"],["みる"],["と"],["、"],["バラク"],["は"],["モアブ"],["の"],["すべて"],["の"],["つかさ"],["たち"],["と"],["共","とも"],["に"],["燔祭","はんさい"],["の"],["かたわら"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":7,"text":"バラムはこの託宣,たくせんを述,のべた。「バラクはわたしをアラムから招,まねき寄,よせ、モアブの王,おうはわたしを東,ひがしの山,やまから招,まねき寄,よせて言,いう、『きてわたしのためにヤコブをのろえ、きてイスラエルをのろえ』と。","tok":[["バラム"],["は"],["この"],["託宣","たくせん"],["を"],["述べた","のべた"],["。"],["「"],["バラク"],["は"],["わたし"],["を"],["アラム"],["から"],["招き寄せ","まねきよせ"],["、"],["モアブ"],["の"],["王","おう"],["は"],["わたし"],["を"],["東","ひがし"],["の"],["山","やま"],["から"],["招き寄せて","まねきよせて"],["言う","いう"],["、"],["『"],["きて"],["わたし"],["の"],["ため"],["に"],["ヤコブ"],["を"],["のろえ"],["、"],["きて"],["イスラエル"],["を"],["のろえ"],["』"],["と"],["。"]]},{"verse":8,"text":"神,かみののろわない者,ものを、わたしがどうしてのろえよう。主,しゅののろわない者,ものを、わたしがどうしてのろえよう。","tok":[["神","かみ"],["の"],["のろわない"],["者","もの"],["を"],["、"],["わたし"],["が"],["どう"],["して"],["のろえ"],["よう"],["。"],["主","しゅ"],["の"],["のろわない"],["者","もの"],["を"],["、"],["わたし"],["が"],["どう"],["して"],["のろえ"],["よう"],["。"]]},{"verse":9,"text":"岩,いわの頂,いただきからながめ、丘,おかの上,うえから見,みたが、これはひとり離,はなれて住,すむ民,たみ、もろもろの国民,こくみんのうちに並,ならぶものはない。","tok":[["岩","いわ"],["の"],["頂","いただき"],["から"],["ながめ"],["、"],["丘","おか"],["の"],["上","うえ"],["から"],["見た","みた"],["が"],["、"],["これ"],["は"],["ひとり"],["離れて","はなれて"],["住む","すむ"],["民","た"],["み"],["、"],["もろもろ"],["の"],["国民","こくみん"],["の"],["うち"],["に"],["並ぶ","ならぶ"],["もの"],["は"],["ない"],["。"]]},{"verse":10,"text":"だれがヤコブの群衆,ぐんしゅうを数,かぞえ、イスラエルの無数,むすうの民,たみを数,かぞえ得,えよう。わたしは義人,ぎじんのように死,しに、わたしの終,おわりは彼,かれらの終,おわりのようでありたい」。","tok":[["だれ"],["が"],["ヤコブ"],["の"],["群衆","ぐんしゅう"],["を"],["数え","かぞえ"],["、"],["イスラエル"],["の"],["無数","むすう"],["の"],["民","たみ"],["を"],["数え","かぞえ"],["得よう","えよう"],["。"],["わたし"],["は"],["義人","ぎじん"],["の"],["よう"],["に"],["死に","しに"],["、"],["わたし"],["の"],["終","おわり"],["は"],["彼","かれ"],["ら"],["の"],["終","おわり"],["の"],["よう"],["で"],["ありたい"],["」"],["。"]]},{"verse":11,"text":"そこでバラクはバラムに言,いった、「あなたはわたしに何,なにをするのですか。わたしは敵,てきをのろうために、あなたを招,まねいたのに、あなたはかえって敵,てきを祝福,しゅくふくするばかりです」。","tok":[["そこ"],["で"],["バラク"],["は"],["バラム"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["わたし"],["に"],["何に","なに"],["を"],["する"],["の"],["です"],["か"],["。"],["わたし"],["は"],["敵","てき"],["を"],["のろう"],["ため"],["に"],["、"],["あなた"],["を"],["招いた","まねいた"],["のに"],["、"],["あなた"],["は"],["かえって"],["敵","てき"],["を"],["祝福","しゅくふく"],["する"],["ばかり"],["です"],["」"],["。"]]},{"verse":12,"text":"バラムは答,こたえた、「わたしは、主,しゅがわたしの口,くちに授,さづけられる事,ことだけを語,かたるように注意,ちゅういすべきではないでしょうか」。","tok":[["バラム"],["は"],["答","こたえ"],["た"],["、"],["「"],["わたし"],["は"],["、"],["主","しゅ"],["が"],["わたし"],["の"],["口","くち"],["に"],["授","さ"],["づけられる"],["事","こと"],["だけ"],["を"],["語る","かたる"],["よう"],["に"],["注意","ちゅうい"],["すべきで"],["は"],["ないでしょう"],["か"],["」"],["。"]]},{"verse":13,"text":"バラクは彼,かれに言,いった、「わたしと一緒,いっしょにほかのところへ行,いって、そこから彼,かれらをごらんください。あなたはただ彼,かれらの一端,いったんを見,みるだけで、全体,ぜんたいを見,みることはできないでしょうが、そこからわたしのために彼,かれらをのろってください」。","tok":[["バラク"],["は"],["彼","かれ"],["に"],["言った","いった"],["、"],["「"],["わたし"],["と"],["一緒","いっしょ"],["に"],["ほか"],["の"],["ところ"],["へ"],["行って","いって"],["、"],["そこ"],["から"],["彼","かれ"],["ら"],["を"],["ごらん"],["ください"],["。"],["あなた"],["は"],["ただ"],["彼","かれ"],["ら"],["の"],["一端","いったん"],["を"],["見る","みる"],["だけ"],["で"],["、"],["全体","ぜんたい"],["を"],["見る","みる"],["こと"],["は"],["できないでしょう"],["が"],["、"],["そこ"],["から"],["わたし"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["のろって"],["ください"],["」"],["。"]]},{"verse":14,"text":"そして彼,かれはバラムを連,つれてゾピムの野,のに行,いき、ピスガの頂,いただきに登,のぼって、そこに七つの祭壇,さいだんを築,きずき、祭壇,さいだんごとに雄牛,おうし一頭,とうと雄羊,おひつじ一頭,とうとをささげた。","tok":[["そして"],["彼","かれ"],["は"],["バラム"],["を"],["連れて","つれて"],["ゾピム"],["の"],["野","の"],["に"],["行き","いき"],["、"],["ピスガ"],["の"],["頂","いただき"],["に"],["登って","のぼって"],["、"],["そこ"],["に"],["七","なな"],["つ"],["の"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["祭壇","さいだん"],["ごと"],["に"],["雄牛","おうし"],["一頭","とう"],["と"],["雄羊","おひつじ"],["一頭","とうと"],["を"],["ささげた"],["。"]]},{"verse":15,"text":"ときにはバラムはバラクに言,いった、「あなたはここで、燔祭,はんさいのかたわらに立,たっていてください。わたしは向,むこうへ行,いって、主,しゅに伺,うかがいますから」。","tok":[["とき"],["に"],["は"],["バラム"],["は"],["バラク"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["ここ"],["で"],["、"],["燔祭","はんさい"],["の"],["かたわら"],["に"],["立って","たって"],["いて"],["ください"],["。"],["わたし"],["は"],["向こう","むこう"],["へ"],["行って","いって"],["、"],["主に","しゅに"],["伺","うかがい"],["ます"],["から"],["」"],["。"]]},{"verse":16,"text":"主,しゅはバラムに臨,のぞみ、言葉,ことばを口,くちに授,さづけて言,いわれた、「バラクのもとに帰,かえってこう言,いいなさい」。","tok":[["主","しゅ"],["は"],["バラム"],["に"],["臨み","のぞみ"],["、"],["言葉","ことば"],["を"],["口","くち"],["に"],["授","さ"],["づけて"],["言われた","いわれた"],["、"],["「"],["バラク"],["の"],["もと"],["に"],["帰えって","かえって"],["こう"],["言い","いい"],["なさい"],["」"],["。"]]},{"verse":17,"text":"彼,かれがバラクのところへ行,いって見,みると、バラクは燔祭,はんさいのかたわらに立,たち、モアブのつかさたちも共,ともにいた。バラクはバラムに言,いった、「主,しゅはなんと言,いわれましたか」。","tok":[["彼","かれ"],["が"],["バラク"],["の"],["ところ"],["へ"],["行って","いって"],["見る","みる"],["と"],["、"],["バラク"],["は"],["燔祭","はんさい"],["の"],["かたわら"],["に"],["立ち","たち"],["、"],["モアブ"],["の"],["つかさ"],["たち"],["も"],["共","とも"],["に"],["いた"],["。"],["バラク"],["は"],["バラム"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["は"],["なん"],["と"],["言われました","いわれました"],["か"],["」"],["。"]]},{"verse":18,"text":"そこでバラムはまたこの託宣,たくせんを述,のべた。「バラクよ、立,たって聞,きけ、チッポルの子,こよ、わたしに耳,みみを傾,かたむけよ。","tok":[["そこ"],["で"],["バラム"],["は"],["また"],["この"],["託宣","たくせん"],["を"],["述べた","のべた"],["。"],["「"],["バラク"],["よ"],["、"],["立って","たって"],["聞け","きけ"],["、"],["チッポル"],["の"],["子","こ"],["よ"],["、"],["わたし"],["に"],["耳","みみ"],["を"],["傾むけよ","かたむけよ"],["。"]]},{"verse":19,"text":"神,かみは人,ひとのように偽,いつわることはなく、また人,ひとの子,このように悔,くいることもない。言,いったことで、行,おこなわないことがあろうか、語,かたったことで、しとげないことがあろうか。","tok":[["神","かみ"],["は"],["人","ひと"],["の"],["よう"],["に"],["偽わる","いつわる"],["こと"],["は"],["なく"],["、"],["また"],["人","ひと"],["の"],["子","こ"],["の"],["よう"],["に"],["悔いる","くいる"],["こと"],["も"],["ない"],["。"],["言った","いった"],["こと"],["で"],["、"],["行なわない","おこなわない"],["こと"],["が"],["あろう"],["か"],["、"],["語った","かたった"],["こと"],["で"],["、"],["しとげない"],["こと"],["が"],["あろう"],["か"],["。"]]},{"verse":20,"text":"祝福,しゅくふくせよとの命,めいをわたしはうけた、すでに神,かみが祝福,しゅくふくされたものを、わたしは変,かえることができない。","tok":[["祝福","しゅくふく"],["せよ"],["と"],["の"],["命","めい"],["を"],["わたし"],["は"],["うけた"],["、"],["すでに"],["神","かみ"],["が"],["祝福","しゅくふく"],["された"],["もの"],["を"],["、"],["わたし"],["は"],["変える","かえる"],["こと"],["が"],["できない"],["。"]]},{"verse":21,"text":"だれもヤコブのうちに災,わざわいのあるのを見,みない、またイスラエルのうちに悩,なやみのあるのを見,みない。彼,かれらの神,かみ、主,しゅが共,ともにいまし、王,おうをたたえる声,こえがその中,なかに聞,きこえる。","tok":[["だれ"],["も"],["ヤコブ"],["の"],["うち"],["に"],["災","わざわい"],["の"],["ある"],["の"],["を"],["見ない","みない"],["、"],["また"],["イスラエル"],["の"],["うち"],["に"],["悩み","なやみ"],["の"],["ある"],["の"],["を"],["見ない","みない"],["。"],["彼","かれ"],["ら"],["の"],["神","かみ"],["、"],["主","しゅ"],["が"],["共","とも"],["に"],["いまし"],["、"],["王","おう"],["を"],["たたえる"],["声","こえ"],["が"],["その"],["中","なか"],["に"],["聞こえる","きこえる"],["。"]]},{"verse":22,"text":"神,かみは彼,かれらをエジプトから導,みちびき出,だされた、彼,かれらは野牛,やぎゅうの角,つののようだ。","tok":[["神","かみ"],["は"],["彼","かれ"],["ら"],["を"],["エジプト"],["から"],["導き出された","みちびきだされた"],["、"],["彼","かれ"],["ら"],["は"],["野牛","やぎゅう"],["の"],["角","つ"],["の"],["の"],["よう"],["だ"],["。"]]},{"verse":23,"text":"ヤコブには魔術,まじゅつがなく、イスラエルには占,うらないがない。神,かみがそのなすところを時,ときに応,おうじてヤコブに告,つげ、イスラエルに示,しめされるからだ。","tok":[["ヤコブ"],["に"],["は"],["魔術","まじゅつ"],["が"],["なく"],["、"],["イスラエル"],["に"],["は"],["占","うらない"],["が"],["ない"],["。"],["神","かみ"],["が"],["その"],["なす"],["ところ"],["を"],["時","とき"],["に"],["応じて","おうじて"],["ヤコブ"],["に"],["告","つげ"],["、"],["イスラエル"],["に"],["示めされる","しめされる"],["から"],["だ"],["。"]]},{"verse":24,"text":"見,みよ、この民,たみは雌,めじしのように立,たち上,あがり、雄,おじしのように身,みを起,おこす。これはその獲物,えものを食,くらい、その殺,ころした者,ものの血,ちを飲,のむまでは身,みを横,よこたえない」。","tok":[["見よ","みよ"],["、"],["この"],["民","たみ"],["は"],["雌","めじし"],["の"],["よう"],["に"],["立ち上がり","たちあがり"],["、"],["雄","おじし"],["の"],["よう"],["に"],["身","み"],["を"],["起こす","おこす"],["。"],["これ"],["は"],["その"],["獲物","えもの"],["を"],["食らい","くらい"],["、"],["その"],["殺ろした","ころした"],["者","もの"],["の"],["血","ち"],["を"],["飲む","のむ"],["まで"],["は"],["身","み"],["を"],["横たえない","よこたえない"],["」"],["。"]]},{"verse":25,"text":"バラクはバラムに言,いった、「あなたは彼,かれらをのろうことも祝福,しゅくふくすることも、やめてください」。","tok":[["バラク"],["は"],["バラム"],["に"],["言った","いった"],["、"],["「"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["のろう"],["こと"],["も"],["祝福","しゅくふく"],["する"],["こと"],["も"],["、"],["やめて"],["ください"],["」"],["。"]]},{"verse":26,"text":"バラムは答,こたえてバラクに言,いった、「主,しゅの言,いわれることは、なんでもしなければならないと、わたしはあなたに告,つげませんでしたか」。","tok":[["バラム"],["は"],["答","こたえ"],["て"],["バラク"],["に"],["言った","いった"],["、"],["「"],["主","しゅ"],["の"],["言われる","いわれる"],["こと"],["は"],["、"],["なん"],["で"],["も"],["しなければ"],["ならない"],["と"],["、"],["わたし"],["は"],["あなた"],["に"],["告","つげ"],["ませんでした"],["か"],["」"],["。"]]},{"verse":27,"text":"バラクはバラムに言,いった、「どうぞ、おいでください。わたしはあなたをほかの所,ところへお連,つれしましょう。神,かみはあなたがそこからわたしのために彼,かれらをのろうことを許,ゆるされるかもしれません」。","tok":[["バラク"],["は"],["バラム"],["に"],["言った","いった"],["、"],["「"],["どうぞ"],["、"],["おいで"],["ください"],["。"],["わたし"],["は"],["あなた"],["を"],["ほか"],["の"],["所","ところ"],["へ"],["お連れ","おつれ"],["しましょう"],["。"],["神","かみ"],["は"],["あなた"],["が"],["そこ"],["から"],["わたし"],["の"],["ため"],["に"],["彼","かれ"],["ら"],["を"],["のろう"],["こと"],["を"],["許される","ゆるされる"],["か"],["も"],["しれません"],["」"],["。"]]},{"verse":28,"text":"そしてバラクはバラムを連,つれて、荒野,あらのを見,みおろすペオルの頂,いただきに行,いった。","tok":[["そして"],["バラク"],["は"],["バラム"],["を"],["連れて","つれて"],["、"],["荒野","あら"],["の"],["を"],["見おろす","みおろす"],["ペオル"],["の"],["頂","いただき"],["に"],["行った","いった"],["。"]]},{"verse":29,"text":"バラムはバラクに言,いった、「わたしのためにここに七つの祭壇,さいだんを築,きずき、雄牛,おうし七頭,とうと、雄羊,おひつじ七頭,とうとを整,ととのえなさい」。","tok":[["バラム"],["は"],["バラク"],["に"],["言った","いった"],["、"],["「"],["わたし"],["の"],["ため"],["に"],["ここ"],["に"],["七","なな"],["つ"],["の"],["祭壇","さいだん"],["を"],["築き","きずき"],["、"],["雄牛","おうし"],["七頭","とう"],["と"],["、"],["雄羊","おひつじ"],["七頭","とうと"],["を"],["整え","ととのえ"],["なさい"],["」"],["。"]]},{"verse":30,"text":"バラクはバラムの言,いったとおりにし、その祭壇,さいだんごとに雄牛,おうし一頭,とうと雄羊,おひつじ一頭,とうとをささげた。","tok":[["バラク"],["は"],["バラム"],["の"],["言った","いった"],["とおり"],["に"],["し"],["、"],["その"],["祭壇","さいだん"],["ごと"],["に"],["雄牛","おうし"],["一頭","とう"],["と"],["雄羊","おひつじ"],["一頭","とうと"],["を"],["ささげた"],["。"]]}]
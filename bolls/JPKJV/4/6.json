[{"verse":1,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":2,"text":"「イスラエルの人々,ひとびとに言,いいなさい、『男,おとこまたは女,おんなが、特,とくに誓,ちかいを立,たて、ナジルびととなる誓願,せいがんをして、身,みを主,しゅに聖別,せいべつする時,ときは、","tok":[["「"],["イスラエル"],["の"],["人々","ひとびと"],["に"],["言い","いい"],["なさい"],["、"],["『"],["男","おとこ"],["また"],["は"],["女","おんな"],["が"],["、"],["特に","とくに"],["誓い","ちかい"],["を"],["立て","たて"],["、"],["ナジル"],["びと"],["と"],["なる"],["誓願","せいがん"],["を"],["して"],["、"],["身","み"],["を"],["主に","しゅに"],["聖別","せいべつ"],["する"],["時","とき"],["は"],["、"]]},{"verse":3,"text":"ぶどう酒,しゅと濃,こい酒,さけを断,たち、ぶどう酒,しゅの酢,すとなったもの、濃,こい酒,さけの酢,すとなったものを飲,のまず、また、ぶどうの汁,しるを飲,のまず、また生,なまでも干,ほしたものでも、ぶどうを食,たべてはならない。","tok":[["ぶどう酒","ぶどうしゅ"],["と"],["濃い","こい"],["酒","さけ"],["を"],["断ち","たち"],["、"],["ぶどう酒","ぶどうしゅ"],["の"],["酢","す"],["と"],["なった"],["もの"],["、"],["濃い","こい"],["酒","さけ"],["の"],["酢","す"],["と"],["なった"],["もの"],["を"],["飲まず","のまず"],["、"],["また"],["、"],["ぶどう"],["の"],["汁","しる"],["を"],["飲まず","のまず"],["、"],["また"],["生","なま"],["で"],["も"],["干した","ほした"],["もの"],["で"],["も"],["、"],["ぶどう"],["を"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":4,"text":"ナジルびとである間,あいだは、すべて、ぶどうの木,きからできるものは、種,たねも皮,かわも食,たべてはならない。","tok":[["ナジル"],["びと"],["で"],["ある"],["間","あいだ"],["は"],["、"],["すべて"],["、"],["ぶどう"],["の"],["木","き"],["から"],["できる"],["もの"],["は"],["、"],["種","たね"],["も"],["皮","かわ"],["も"],["食べて","たべて"],["は"],["ならない"],["。"]]},{"verse":5,"text":"また、ナジルびとたる誓願,せいがんを立,たてている間,あいだは、すべて、かみそりを頭,あたまに当,あててはならない。身,みを主,しゅに聖別,せいべつした日数,ひかずの満,みちるまで、彼,かれは聖,せいなるものであるから、髪,かみの毛,けをのばしておかなければならない。","tok":[["また"],["、"],["ナジル"],["びと"],["たる"],["誓願","せいがん"],["を"],["立て","たてて"],["いる"],["間","あいだ"],["は"],["、"],["すべて"],["、"],["かみそり"],["を"],["頭","あたま"],["に"],["当てて","あてて"],["は"],["ならない"],["。"],["身","み"],["を"],["主に","しゅに"],["聖別","せいべつ"],["した"],["日数","ひかず"],["の"],["満ちる","みちる"],["まで"],["、"],["彼","かれ"],["は"],["聖","せい"],["なる"],["もの"],["で"],["ある"],["から"],["、"],["髪の毛","かみのけ"],["を"],["のばして"],["おかなければ"],["ならない"],["。"]]},{"verse":6,"text":"身,みを主,しゅに聖別,せいべつしている間,あいだは、すべて死体,したいに近,ちかづいてはならない。","tok":[["身","み"],["を"],["主に","しゅに"],["聖別","せいべつ"],["して"],["いる"],["間","あいだ"],["は"],["、"],["すべて"],["死体","したい"],["に"],["近づいて","ちかづいて"],["は"],["ならない"],["。"]]},{"verse":7,"text":"父母,ふぼ、兄弟,きょうだい、姉妹,しまいが死,しんだ時,ときでも、そのために身,みを汚,けがしてはならない。神,かみに聖別,せいべつしたしるしが、頭,あたまにあるからである。","tok":[["父母","ふぼ"],["、"],["兄弟","きょうだい"],["、"],["姉妹","しまい"],["が"],["死んだ","しんだ"],["時","とき"],["で"],["も"],["、"],["その"],["ため"],["に"],["身","み"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"],["神","かみ"],["に"],["聖別","せいべつ"],["した"],["しるし"],["が"],["、"],["頭","あたま"],["に"],["ある"],["から"],["で"],["ある"],["。"]]},{"verse":8,"text":"彼,かれはナジルびとである間,あいだは、すべて主,しゅの聖,せいなる者,ものである。","tok":[["彼","かれ"],["は"],["ナジル"],["びと"],["で"],["ある"],["間","あいだ"],["は"],["、"],["すべて"],["主","しゅ"],["の"],["聖","せい"],["なる"],["者","もの"],["で"],["ある"],["。"]]},{"verse":9,"text":"もし人,ひとがはからずも彼,かれのかたわらに死,しんで、彼,かれの聖別,せいべつした頭,あたまを汚,けがしたならば、彼,かれは身,みを清,きよめる日,ひに、頭,あたまをそらなければならない。すなわち、七日,なぬか目,めにそれをそらなければならない。","tok":[["もし"],["人","ひと"],["が"],["はからず"],["も"],["彼","かれ"],["の"],["かたわら"],["に"],["死んで","しんで"],["、"],["彼","かれ"],["の"],["聖別","せいべつ"],["した"],["頭","あたま"],["を"],["汚","け"],["がしたならば"],["、"],["彼","かれ"],["は"],["身","み"],["を"],["清める","きよめる"],["日","ひ"],["に"],["、"],["頭","あたま"],["を"],["そらなければ"],["ならない"],["。"],["すなわち"],["、"],["七日","な"],["ぬか目","ぬかめ"],["に"],["それ"],["を"],["そらなければ"],["ならない"],["。"]]},{"verse":10,"text":"そして八日,か目,めに山,やまばと二羽,わ、または家,いえばとのひな二羽,わを携,たずさえて、会見,かいけんの幕屋,まくやの入口,いりぐちにおる祭司,さいしの所,ところに行,いかなければならない。","tok":[["そして"],["八日目","かめ"],["に"],["山ばと","やまばと"],["二羽","わ"],["、"],["また"],["は"],["家ばと","いえばと"],["の"],["ひな"],["二羽","わ"],["を"],["携えて","たずさえて"],["、"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["おる"],["祭司","さいし"],["の"],["所","ところ"],["に"],["行かなければ","いかなければ"],["ならない"],["。"]]},{"verse":11,"text":"祭司,さいしはその一羽,いちわを罪祭,ざいさいに、一羽,いちわを燔祭,はんさいにささげて、彼,かれが死体,したいによって得,えた罪,つみを彼,かれのためにあがない、その日,ひに彼,かれの頭,あたまを聖別,せいべつしなければならない。","tok":[["祭司","さいし"],["は"],["その"],["一羽","いちわ"],["を"],["罪","つみ"],["祭","まつり"],["に"],["、"],["一羽","いちわ"],["を"],["燔祭","はんさい"],["に"],["ささげて"],["、"],["彼","かれ"],["が"],["死体","したい"],["によって"],["得た","えた"],["罪","つみ"],["を"],["彼","かれ"],["の"],["ため"],["に"],["あがない"],["、"],["その"],["日","ひ"],["に"],["彼","かれ"],["の"],["頭","あたま"],["を"],["聖別","せいべつ"],["しなければ"],["ならない"],["。"]]},{"verse":12,"text":"彼,かれはまたナジルびとたる日,ひの数,かずを、改,あらためて主,しゅに聖別,せいべつし、一歳,さいの雄,おすの小羊,こひつじを携,たずさえてきて、愆祭,けんさいとしなければならない。それ以前,いぜんの日,ひは、彼,かれがその聖別,せいべつを汚,けがしたので、無効,むこうになるであろう。","tok":[["彼","かれ"],["は"],["また"],["ナジル"],["びと"],["たる"],["日","ひ"],["の"],["数","かず"],["を"],["、"],["改","あらため"],["て"],["主に","しゅに"],["聖別","せいべつ"],["し"],["、"],["一歳","さい"],["の"],["雄","おす"],["の"],["小羊","こひつじ"],["を"],["携えて","たずさえて"],["きて"],["、"],["愆祭","けんさい"],["と"],["しなければ"],["ならない"],["。"],["それ"],["以前","いぜん"],["の"],["日","ひ"],["は"],["、"],["彼","かれ"],["が"],["その"],["聖別","せいべつ"],["を"],["汚","け"],["がした"],["ので"],["、"],["無効","むこう"],["に"],["なるで"],["あろう"],["。"]]},{"verse":13,"text":"これがナジルびとの律法,りっぽうである。聖別,せいべつの日,ひ数,かずが満,みちた時,ときは、その人,ひとを会見,かいけんの幕屋,まくやの入口,いりぐちに連,つれてこなければならない。","tok":[["これ"],["が"],["ナジル"],["びと"],["の"],["律法","りっぽう"],["で"],["ある"],["。"],["聖別","せいべつ"],["の"],["日数","ひか"],["ず"],["が"],["満ちた","みちた"],["時","とき"],["は"],["、"],["その"],["人","ひと"],["を"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["に"],["連れて","つれて"],["こなければ"],["ならない"],["。"]]},{"verse":14,"text":"そしてその人,ひとは供,そなえ物,ものを主,しゅにささげなければならない。すなわち、一歳,さいの雄,おすの小羊,こひつじの全,まったきもの一頭,とうを燔祭,はんさいとし、一歳,さいの雌,めすの小羊,こひつじの全,まったきもの一頭,とうを罪祭,ざいさいとし、雄羊,おひつじの全,まったきもの一頭,とうを酬恩祭,しゅうおんさいとし、","tok":[["そして"],["その"],["人","ひと"],["は"],["供え物","そなえもの"],["を"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"],["すなわち"],["、"],["一歳","さい"],["の"],["雄","おす"],["の"],["小羊","こひつじ"],["の"],["全","まったきも"],["の"],["一頭","とう"],["を"],["燔祭","はんさい"],["と"],["し"],["、"],["一歳","さい"],["の"],["雌","めす"],["の"],["小羊","こひつじ"],["の"],["全","まったきも"],["の"],["一頭","とう"],["を"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["と"],["し"],["、"],["雄羊","おひつじ"],["の"],["全","まったきも"],["の"],["一頭","とう"],["を"],["酬恩祭","しゅうおんさい"],["と"],["し"],["、"]]},{"verse":15,"text":"また種,たね入,いれぬパンの一かご、油,あぶらを混,まぜて作,つくった麦粉,むぎこの菓子,かし、油,あぶらを塗,ぬった種,たね入,いれぬ煎餅,せんべい、および素祭,そさいと灌祭,かんさいを携,たずさえてこなければならない。","tok":[["また"],["種","た"],["ね"],["入れぬ","いれぬ"],["パン"],["の"],["一","いち"],["かご"],["、"],["油","あぶら"],["を"],["混ぜて","まぜて"],["作った","つくった"],["麦粉","むぎこ"],["の"],["菓子","かし"],["、"],["油","あぶら"],["を"],["塗った","ぬった"],["種","たね"],["入れぬ","いれぬ"],["煎餅","せんべい"],["、"],["および"],["素","す"],["祭","まつり"],["と"],["灌祭","かんさい"],["を"],["携えて","たずさえて"],["こなければ"],["ならない"],["。"]]},{"verse":16,"text":"祭司,さいしはこれを主,しゅの前,まえに携,たずさえてきて、その罪祭,ざいさいと燔祭,はんさいとをささげ、","tok":[["祭司","さいし"],["は"],["これ"],["を"],["主","しゅ"],["の"],["前","まえ"],["に"],["携えて","たずさえて"],["きて"],["、"],["その"],["罪","つみ"],["祭","まつり"],["と"],["燔祭","はんさい"],["と"],["を"],["ささげ"],["、"]]},{"verse":17,"text":"また雄羊,おひつじを種,たね入,いれぬパンの一かごと共,ともに、酬恩祭,しゅうおんさいの犠牲,ぎせいとして、主,しゅにささげなければならない。祭司,さいしはまたその素祭,そさいと灌祭,かんさいをもささげなければならない。","tok":[["また"],["雄羊","おひつじ"],["を"],["種","たね"],["入れぬ","いれぬ"],["パン"],["の"],["一","いち"],["か"],["ごと"],["共","とも"],["に"],["、"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["として"],["、"],["主に","しゅに"],["ささげなければ"],["ならない"],["。"],["祭司","さいし"],["は"],["また"],["その"],["素","す"],["祭","まつり"],["と"],["灌祭","かんさい"],["を"],["も"],["ささげなければ"],["ならない"],["。"]]},{"verse":18,"text":"そのナジルびとは会見,かいけんの幕屋,まくやの入口,いりぐちで、聖別,せいべつした頭,あたまをそり、その聖別,せいべつした頭,あたまの髪,かみを取,とって、これを酬恩祭,しゅうおんさいの犠牲,ぎせいの下,したにある火,ひの上,うえに置,おかなければならない。","tok":[["その"],["ナジル"],["び"],["と"],["は"],["会見","かいけん"],["の"],["幕屋","まくや"],["の"],["入口","いりぐち"],["で"],["、"],["聖別","せいべつ"],["した"],["頭","あたま"],["を"],["そり"],["、"],["その"],["聖別","せいべつ"],["した"],["頭","あたま"],["の"],["髪","かみ"],["を"],["取って","とって"],["、"],["これ"],["を"],["酬恩祭","しゅうおんさい"],["の"],["犠牲","ぎせい"],["の"],["下","した"],["に"],["ある"],["火","ひ"],["の"],["上","うえ"],["に"],["置かなければ","おかなければ"],["ならない"],["。"]]},{"verse":19,"text":"祭司,さいしはその雄羊,おひつじの肩,かたの煮,にえたものと、かごから取,とった種,たね入,いれぬ菓子,かし一つと、種,たね入,いれぬ煎餅,せんべい一つを取,とって、これをナジルびとが、その聖別,せいべつした頭,あたまをそった後,のち、その手,てに授,さづけ、","tok":[["祭司","さいし"],["は"],["その"],["雄羊","おひつじ"],["の"],["肩","かた"],["の"],["煮えた","にえた"],["もの"],["と"],["、"],["かご"],["から"],["取った","とった"],["種","たね"],["入れぬ","いれぬ"],["菓子","かし"],["一","ひと"],["つ"],["と"],["、"],["種","た"],["ね"],["入れぬ","いれぬ"],["煎餅","せんべい"],["一","ひと"],["つ"],["を"],["取って","とって"],["、"],["これ"],["を"],["ナジル"],["びと"],["が"],["、"],["その"],["聖別","せいべつ"],["した"],["頭","あたま"],["を"],["そった"],["後","の"],["ち"],["、"],["その"],["手","て"],["に"],["授","さ"],["づけ"],["、"]]},{"verse":20,"text":"祭司,さいしは主,しゅの前,まえでこれを揺,ゆり動,うごかして揺祭,ようさいとしなければならない。これは聖,せいなる物,ものであって、その揺,ゆり動,うごかした胸,むねと、ささげたももと共,ともに、祭司,さいしに帰,きするであろう。こうして後,のち、そのナジルびとは、ぶどう酒,しゅを飲,のむことができる。","tok":[["祭司","さいし"],["は"],["主","しゅ"],["の"],["前","まえ"],["で"],["これ"],["を"],["揺り動かして","ゆりうごかして"],["揺祭","ようさい"],["と"],["しなければ"],["ならない"],["。"],["これ"],["は"],["聖","せい"],["なる"],["物","もの"],["で"],["あって"],["、"],["その"],["揺り動かした","ゆりうごかした"],["胸","むね"],["と"],["、"],["ささげた"],["もも"],["と"],["共","とも"],["に"],["、"],["祭司","さいし"],["に"],["帰するで","きするで"],["あろう"],["。"],["こう"],["して"],["後","の"],["ち"],["、"],["その"],["ナジル"],["び"],["と"],["は"],["、"],["ぶどう酒","ぶどうしゅ"],["を"],["飲む","のむ"],["こと"],["が"],["できる"],["。"]]},{"verse":21,"text":"これは誓願,せいがんをするナジルびとと、そのナジルびとたる事,ことのために、主,しゅにささげる彼,かれの供,そなえ物,ものについての律法,りっぽうである。このほかにその力,ちからの及,およぶ物,ものをささげることができる。すなわち、彼,かれはその誓,ちかう誓願,せいがんのように、ナジルびとの律法,りっぽうにしたがって行,おこなわなければならない』」。","tok":[["これ"],["は"],["誓願","せいがん"],["を"],["する"],["ナジル"],["びと"],["と"],["、"],["その"],["ナジル"],["びと"],["たる"],["事","こと"],["の"],["ため"],["に"],["、"],["主に","しゅに"],["ささげる"],["彼","かれ"],["の"],["供え物","そなえもの"],["について"],["の"],["律法","りっぽう"],["で"],["ある"],["。"],["この"],["ほか"],["に"],["その"],["力","ちから"],["の"],["及ぶ","およぶ"],["物","もの"],["を"],["ささげる"],["こと"],["が"],["できる"],["。"],["すなわち"],["、"],["彼","かれ"],["は"],["その"],["誓う","ちかう"],["誓願","せいがん"],["の"],["よう"],["に"],["、"],["ナジル"],["びと"],["の"],["律法","りっぽう"],["に"],["したがって"],["行なわなければ","おこなわなければ"],["ならない"],["』"],["」"],["。"]]},{"verse":22,"text":"主,しゅはまたモーセに言,いわれた、","tok":[["主","しゅ"],["は"],["また"],["モーセ"],["に"],["言われた","いわれた"],["、"]]},{"verse":23,"text":"「アロンとその子,こたちに言,いいなさい、『あなたがたはイスラエルの人々,ひとびとを祝福,しゅくふくしてこのように言,いわなければならない。","tok":[["「"],["アロン"],["と"],["その"],["子","こ"],["たち"],["に"],["言い","いい"],["なさい"],["、"],["『"],["あなた"],["がた"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["祝福","しゅくふく"],["して"],["この"],["よう"],["に"],["言わなければ","いわなければ"],["ならない"],["。"]]},{"verse":24,"text":"「願,ねがわくは主,しゅがあなたを祝福,しゅくふくし、あなたを守,まもられるように。","tok":[["「"],["願わく","ねがわく"],["は"],["主","しゅ"],["が"],["あなた"],["を"],["祝福","しゅくふく"],["し"],["、"],["あなた"],["を"],["守られる","まもられる"],["よう"],["に"],["。"]]},{"verse":25,"text":"願,ねがわくは主,しゅがみ顔,かおをもってあなたを照,てらし、あなたを恵,めぐまれるように。","tok":[["願わく","ねがわく"],["は"],["主","しゅ"],["が"],["み顔","みかお"],["を"],["もって"],["あなた"],["を"],["照","てらし"],["、"],["あなた"],["を"],["恵れる","めぐまれる"],["よう"],["に"],["。"]]},{"verse":26,"text":"願,ねがわくは主,しゅがみ顔,かおをあなたに向,むけ、あなたに平安,へいあんを賜,たまわるように」』。","tok":[["願わく","ねがわく"],["は"],["主","しゅ"],["が"],["み顔","みかお"],["を"],["あなた"],["に"],["向け","むけ"],["、"],["あなた"],["に"],["平安","へいあん"],["を"],["賜わる","たまわる"],["よう"],["に"],["」"],["』"],["。"]]},{"verse":27,"text":"こうして彼,かれらがイスラエルの人々,ひとびとのために、わたしの名,なを唱,となえるならば、わたしは彼,かれらを祝福,しゅくふくするであろう」。","tok":[["こう"],["して"],["彼","かれ"],["ら"],["が"],["イスラエル"],["の"],["人々","ひとびと"],["の"],["ため"],["に"],["、"],["わたし"],["の"],["名","な"],["を"],["唱えるならば","となえるならば"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["するで"],["あろう"],["」"],["。"]]}]
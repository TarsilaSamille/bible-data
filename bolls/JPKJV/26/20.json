[{"verse":1,"text":"第,だい七年,ねんの五月,がつ十日,かに、イスラエルの長老,ちょうろうたちのある人々,ひとびとが、主,しゅに尋,たずねるためにきて、わたしの前,まえに座,ざした。","tok":[["第","だい"],["七","なな"],["年","ねん"],["の"],["五","ご"],["月","がつ"],["つ"],["十日","か"],["に"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["の"],["ある"],["人々","ひとびと"],["が"],["、"],["主に","しゅに"],["尋ねる","たずねる"],["ため"],["に"],["きて"],["、"],["わたし"],["の"],["前","まえ"],["に"],["座した","ざした"],["。"]]},{"verse":2,"text":"時,ときに主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["時","とき"],["に"],["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":3,"text":"「人,ひとの子,こよ、イスラエルの長老,ちょうろうたちに告,つげて言,いえ。主,しゅなる神,かみはこう言,いわれる、あなたがたがわたしのもとに来,きたのは、わたしに何,なにか尋,たずねるためであるか。主,しゅなる神,かみは言,いわれる、わたしは生,いきている、わたしはあなたがたの尋,たずねに答,こたえない。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["長老","ちょうろう"],["たち"],["に"],["告","つげ"],["て"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["が"],["わたし"],["の"],["もと"],["に"],["来た","きた"],["の"],["は"],["、"],["わたし"],["に"],["何に","なに"],["か"],["尋ねる","たずねる"],["ため"],["で"],["ある"],["か"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["尋ね","たずね"],["に"],["答","こたえ"],["ない"],["。"]]},{"verse":4,"text":"あなたは彼,かれらをさばこうとするのか。人,ひとの子,こよ、あなたは彼,かれらをさばこうとするのか。それなら彼,かれらの先祖,せんぞたちのした憎,にくむべき事,ことを彼,かれらに知,しらせ、","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["を"],["さばこう"],["と"],["する"],["の"],["か"],["。"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["を"],["さばこう"],["と"],["する"],["の"],["か"],["。"],["それ"],["なら"],["彼","かれ"],["ら"],["の"],["先祖","せんぞ"],["たち"],["の"],["した"],["憎むべき","にくむべき"],["事","こと"],["を"],["彼","かれ"],["ら"],["に"],["知らせ","しらせ"],["、"]]},{"verse":5,"text":"かつ彼,かれらに言,いえ。主,しゅなる神,かみはこう言,いわれる、わたしがイスラエルを選,えらび、ヤコブの家,いえの子孫,しそんに誓,ちかい、エジプトの地,ちでわたし自身,じしんを彼,かれらに知,しらせ彼,かれらに誓,ちかって、わたしはあなたがたの神,かみ、主,しゅであると言,いった日,ひ、","tok":[["かつ"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わたし"],["が"],["イスラエル"],["を"],["選ら","えら"],["び"],["、"],["ヤコブ"],["の"],["家","いえ"],["の"],["子孫","しそん"],["に"],["誓い","ちかい"],["、"],["エジプト"],["の"],["地","ち"],["で"],["わたし"],["自身","じしん"],["を"],["彼","かれ"],["ら"],["に"],["知らせ","しらせ"],["彼","かれ"],["ら"],["に"],["誓って","ちかって"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅである"],["と"],["言った","いった"],["日","ひ"],["、"]]},{"verse":6,"text":"その日,ひにわたしは彼,かれらに誓,ちかって、エジプトの地,ちから彼,かれらを導,みちびき出,だし、わたしが彼,かれらのために探,さぐり求,もとめた乳,ちちと蜜,みつとの流,ながれる地,ち、全,ぜん地,ちの中,なかで最,もっともすばらしい所,ところへ行,いかせると言,いった。","tok":[["その"],["日","ひ"],["に"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["誓って","ちかって"],["、"],["エジプト"],["の"],["地","ち"],["から"],["彼","かれ"],["ら"],["を"],["導き出し","みちびきだし"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["探ぐり","さぐり"],["求めた","もとめた"],["乳","ちち"],["と"],["蜜","みつ"],["と"],["の"],["流れる","ながれる"],["地","ち"],["、"],["全地","ぜんち"],["の"],["中","なか"],["で"],["最も","もっとも"],["すばらしい"],["所","ところ"],["へ"],["行かせる","いかせる"],["と"],["言った","いった"],["。"]]},{"verse":7,"text":"わたしは彼,かれらに言,いった、あなたがたは、おのおのその目,めを楽,たのしませる憎,にくむべきものを捨,すてよ。エジプトの偶像,ぐうぞうをもって、その身,みを汚,けがすな。わたしはあなたがたの神,かみ、主,しゅであると。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["あなた"],["がた"],["は"],["、"],["おのおの"],["その"],["目","め"],["を"],["楽しませる","たのしませる"],["憎むべき","にくむべき"],["もの"],["を"],["捨てよ","すてよ"],["。"],["エジプト"],["の"],["偶像","ぐうぞう"],["を"],["もって"],["、"],["その"],["身","み"],["を"],["汚","け"],["がす"],["な"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["、"],["主","しゅである"],["と"],["。"]]},{"verse":8,"text":"ところが彼,かれらはわたしにそむき、わたしの言,いうことを聞,きこうともしなかった。彼,かれらは、おのおのその目,めを楽,たのしませた憎,にくむべきものを捨,すてず、またエジプトの偶像,ぐうぞうを捨,すてなかった。それで、わたしはエジプトの地,ちのうちで、わたしの憤,いきどおりを彼,かれらに注,そそぎ、わたしの怒,いかりを彼,かれらに漏,もらそうと思,おもった。","tok":[["ところ"],["が"],["彼","かれ"],["ら"],["は"],["わたし"],["に"],["そむき"],["、"],["わたし"],["の"],["言う","いう"],["こと"],["を"],["聞こう","きこう"],["と"],["も"],["しなかった"],["。"],["彼","かれ"],["ら"],["は"],["、"],["おのおの"],["その"],["目","め"],["を"],["楽しませた","たのしませた"],["憎むべき","にくむべき"],["もの"],["を"],["捨てず","すてず"],["、"],["また"],["エジプト"],["の"],["偶像","ぐうぞう"],["を"],["捨てなかった","すてなかった"],["。"],["それ"],["で"],["、"],["わたし"],["は"],["エジプト"],["の"],["地","ち"],["の"],["うち"],["で"],["、"],["わたし"],["の"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["に"],["注ぎ","そそぎ"],["、"],["わたし"],["の"],["怒り","いかり"],["を"],["彼","かれ"],["ら"],["に"],["漏らそう","もらそう"],["と"],["思った","おもった"],["。"]]},{"verse":9,"text":"しかしわたしはわたしの名,なのために行動,こうどうした。それはエジプトの地,ちから彼,かれらを導,みちびき出,だして、周囲,しゅういに住,すんでいた異邦人,いほうじんたちに、わたしのことを知,しらせ、わたしの名,なが彼,かれらの目,めの前,まえに、はずかしめられないためである。","tok":[["しかし"],["わたし"],["は"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["行動","こうどう"],["した"],["。"],["それ"],["は"],["エジプト"],["の"],["地","ち"],["から"],["彼","かれ"],["ら"],["を"],["導き出して","みちびきだして"],["、"],["周囲","しゅうい"],["に"],["住んで","すんで"],["いた"],["異邦人","いほうじん"],["たち"],["に"],["、"],["わたし"],["の"],["こと"],["を"],["知らせ","しらせ"],["、"],["わたし"],["の"],["名","な"],["が"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["に"],["、"],["はずかしめられない"],["ため"],["で"],["ある"],["。"]]},{"verse":10,"text":"すなわち、わたしはエジプトの地,ちから彼,かれらを導,みちびき出,だして、荒野,あらのに連,つれて行,いき、","tok":[["すなわち"],["、"],["わたし"],["は"],["エジプト"],["の"],["地","ち"],["から"],["彼","かれ"],["ら"],["を"],["導き出して","みちびきだして"],["、"],["荒野","あら"],["のに"],["連れて","つれて"],["行き","いき"],["、"]]},{"verse":11,"text":"わたしの定,さだめを彼,かれらに授,さづけ、わたしのおきてを彼,かれらに示,しめした。これは人,ひとがこれを行,おこなうことによって生,いきるものである。","tok":[["わたし"],["の"],["定め","さだめ"],["を"],["彼","かれ"],["ら"],["に"],["授","さ"],["づけ"],["、"],["わたし"],["の"],["おきて"],["を"],["彼","かれ"],["ら"],["に"],["示めした","しめした"],["。"],["これ"],["は"],["人","ひと"],["が"],["これ"],["を"],["行なう","おこなう"],["こと"],["によって"],["生きる","いきる"],["もの"],["で"],["ある"],["。"]]},{"verse":12,"text":"わたしはまた彼,かれらに安息日,あんそくにちを与,あたえて、わたしと彼,かれらとの間,あいだのしるしとした。これは主,しゅなるわたしが彼,かれらを聖別,せいべつしたことを、彼,かれらに知,しらせるためである。","tok":[["わたし"],["は"],["また"],["彼","かれ"],["ら"],["に"],["安息日","あんそくにち"],["を"],["与","あたえ"],["て"],["、"],["わたし"],["と"],["彼","かれ"],["ら"],["と"],["の"],["間","あいだ"],["の"],["しるし"],["と"],["した"],["。"],["これ"],["は"],["主","しゅ"],["なる"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["聖別","せいべつ"],["した"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["に"],["知らせる","しらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":13,"text":"しかしイスラエルの家,いえは荒野,あらのでわたしにそむき、わたしの定,さだめに歩,あゆまず、人,ひとがそれを行,おこなうことによって、生,いきることのできるわたしのおきてを捨,すて、大,おおいにわたしの安息日,あんそくにちを汚,けがした。そこでわたしは荒野,あらので、わたしの憤,いきどおりを彼,かれらの上,うえに注,そそぎ、これを滅,ほろぼそうと思,おもったが、","tok":[["しかし"],["イスラエル"],["の"],["家","いえ"],["は"],["荒野","あら"],["ので"],["わたし"],["に"],["そむき"],["、"],["わたし"],["の"],["定め","さだめ"],["に"],["歩まず","あゆまず"],["、"],["人","ひと"],["が"],["それ"],["を"],["行なう","おこなう"],["こと"],["によって"],["、"],["生きる","いきる"],["こと"],["の"],["できる"],["わたし"],["の"],["おきて"],["を"],["捨て","すて"],["、"],["大いに","おおいに"],["わたし"],["の"],["安息日","あんそくにち"],["を"],["汚","け"],["がした"],["。"],["そこ"],["で"],["わたし"],["は"],["荒野","あらの"],["で"],["、"],["わたし"],["の"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["注ぎ","そそぎ"],["、"],["これ"],["を"],["滅ぼそう","ほろぼそう"],["と"],["思った","おもった"],["が"],["、"]]},{"verse":14,"text":"わたしはわたしの名,なのために行動,こうどうした。それはわたしが彼,かれらを導,みちびき出,だして見,みせた異邦人,いほうじんの前,まえに、わたしの名,なが汚,けがされないためである。","tok":[["わたし"],["は"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["行動","こうどう"],["した"],["。"],["それ"],["は"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["導き出して","みちびきだして"],["見せた","みせた"],["異邦人","いほうじん"],["の"],["前","まえ"],["に"],["、"],["わたし"],["の"],["名","な"],["が"],["汚","け"],["が"],["されない"],["ため"],["で"],["ある"],["。"]]},{"verse":15,"text":"ただし、わたしは荒野,あらので彼,かれらに誓,ちかい、わたしが彼,かれらに与,あたえた乳,ちちと蜜,みつとの流,ながれる地,ち、全,ぜん地,ちの最,もっともすばらしい地,ちに、彼,かれらを導,みちびかないと言,いった。","tok":[["ただし"],["、"],["わたし"],["は"],["荒野","あらの"],["で"],["彼","かれ"],["ら"],["に"],["誓い","ちかい"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["た"],["乳","ちち"],["と"],["蜜","みつ"],["と"],["の"],["流れる","ながれる"],["地","ち"],["、"],["全地","ぜんち"],["の"],["最も","もっとも"],["すばらしい"],["地","ち"],["に"],["、"],["彼","かれ"],["ら"],["を"],["導かない","みちびかない"],["と"],["言った","いった"],["。"]]},{"verse":16,"text":"これは彼,かれらがその心,こころに偶像,ぐうぞうを慕,したって、わがおきてを捨,すて、わが定,さだめに歩,あゆまず、わが安息日,あんそくにちを汚,けがしたからである。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["その"],["心","こころ"],["に"],["偶像","ぐうぞう"],["を"],["慕って","したって"],["、"],["わが"],["おきて"],["を"],["捨て","すて"],["、"],["わが"],["定め","さだめ"],["に"],["歩まず","あゆまず"],["、"],["わが"],["安息日","あんそくにち"],["を"],["汚","け"],["がした"],["から"],["で"],["ある"],["。"]]},{"verse":17,"text":"けれどもわたしは彼,かれらを惜,おしみ見,みて、彼,かれらを滅,ほろぼさず、荒野,あらので彼,かれらを絶,たやさなかった。","tok":[["けれど"],["も"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["惜み","おしみ"],["見て","みて"],["、"],["彼","かれ"],["ら"],["を"],["滅ぼさず","ほろぼさず"],["、"],["荒野","あらの"],["で"],["彼","かれ"],["ら"],["を"],["絶やさなかった","たやさなかった"],["。"]]},{"verse":18,"text":"わたしはまた荒野,あらので彼,かれらの子,こどもたちに言,いった、あなたがたの先祖,せんぞの定,さだめに歩,あゆんではならない。そのおきてを守,まもってはならない。その偶像,ぐうぞうをもって、あなたがたの身,みを汚,けがしてはならない。","tok":[["わたし"],["は"],["また"],["荒野","あらの"],["で"],["彼","かれ"],["ら"],["の"],["子ども","こども"],["たち"],["に"],["言った","いった"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["定め","さだめ"],["に"],["歩","あゆん"],["で"],["は"],["ならない"],["。"],["その"],["おきて"],["を"],["守って","まもって"],["は"],["ならない"],["。"],["その"],["偶像","ぐうぞう"],["を"],["もって"],["、"],["あなた"],["がた"],["の"],["身","み"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"]]},{"verse":19,"text":"主,しゅなるわたしはあなたがたの神,かみである。わが定,さだめに歩,あゆみ、わがおきてを守,まもってこれを行,おこない、","tok":[["主","しゅ"],["なる"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["で"],["ある"],["。"],["わが"],["定め","さだめ"],["に"],["歩み","あゆみ"],["、"],["わが"],["おきて"],["を"],["守って","まもって"],["これ"],["を"],["行ない","おこない"],["、"]]},{"verse":20,"text":"わが安息日,あんそくにちを聖別,せいべつせよ。これはわたしとあなたがたとの間,あいだのしるしとなって、主,しゅなるわたしがあなたがたの神,かみであることを、あなたがたに知,しらせるためである。","tok":[["わが"],["安息日","あんそくにち"],["を"],["聖別","せいべつ"],["せよ"],["。"],["これ"],["は"],["わたし"],["と"],["あなた"],["がた"],["と"],["の"],["間","あいだ"],["の"],["しるし"],["と"],["なって"],["、"],["主","しゅ"],["なる"],["わたし"],["が"],["あなた"],["がた"],["の"],["神","かみ"],["で"],["ある"],["こと"],["を"],["、"],["あなた"],["がた"],["に"],["知らせる","しらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":21,"text":"しかしその子,こどもたちはわたしにそむき、わが定,さだめに歩,あゆまず、人,ひとがこれを行,おこなうことによって、生,いきることのできるわたしのおきてを守,まもり行,おこなわず、わが安息日,あんそくにちを汚,けがした。そこでわたしはわが憤,いきどおりを彼,かれらの上,うえに注,そそぎ、荒野,あらので彼,かれらに対,たいし、わが怒,いかりを漏,もらそうと思,おもった。","tok":[["しかし"],["その"],["子ども","こども"],["たち"],["は"],["わたし"],["に"],["そむき"],["、"],["わが"],["定め","さだめ"],["に"],["歩まず","あゆまず"],["、"],["人","ひと"],["が"],["これ"],["を"],["行なう","おこなう"],["こと"],["によって"],["、"],["生きる","いきる"],["こと"],["の"],["できる"],["わたし"],["の"],["おきて"],["を"],["守り","まもり"],["行なわず","おこなわず"],["、"],["わが"],["安息日","あんそくにち"],["を"],["汚","け"],["がした"],["。"],["そこ"],["で"],["わたし"],["は"],["わが"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["注ぎ","そそぎ"],["、"],["荒野","あらの"],["で"],["彼","かれ"],["ら"],["に"],["対し","たいし"],["、"],["わが"],["怒り","いかり"],["を"],["漏らそう","もらそう"],["と"],["思った","おもった"],["。"]]},{"verse":22,"text":"しかしわたしはわが手,てを翻,ひるがえして、わが名,なのために行動,こうどうした。それはわたしが彼,かれらを導,みちびき出,だして見,みせた異邦人,いほうじんの前,まえに、わたしの名,なが汚,けがされないためである。","tok":[["しかし"],["わたし"],["は"],["わが"],["手","て"],["を"],["翻がえして","ひるがえして"],["、"],["わが"],["名","な"],["の"],["ため"],["に"],["行動","こうどう"],["した"],["。"],["それ"],["は"],["わたし"],["が"],["彼","かれ"],["ら"],["を"],["導き出して","みちびきだして"],["見せた","みせた"],["異邦人","いほうじん"],["の"],["前","まえ"],["に"],["、"],["わたし"],["の"],["名","な"],["が"],["汚","け"],["が"],["されない"],["ため"],["で"],["ある"],["。"]]},{"verse":23,"text":"ただしわたしは荒野,あらので彼,かれらに誓,ちかい、わたしは異邦人,いほうじんの間,あいだに彼,かれらを散,ちらし、国々,くにぐにの中,なかに彼,かれらをふりまくと言,いった。","tok":[["ただし"],["わたし"],["は"],["荒野","あらの"],["で"],["彼","かれ"],["ら"],["に"],["誓い","ちかい"],["、"],["わたし"],["は"],["異邦人","いほうじん"],["の"],["間","あいだ"],["に"],["彼","かれ"],["ら"],["を"],["散らし","ちらし"],["、"],["国々","くにぐに"],["の"],["中","なか"],["に"],["彼","かれ"],["ら"],["を"],["ふりまく"],["と"],["言った","いった"],["。"]]},{"verse":24,"text":"これは彼,かれらがわがおきてを行,おこなわず、わが定,さだめを捨,すて、わが安息日,あんそくにちを汚,けがし、彼,かれらの目,めにその先祖,せんぞの偶像,ぐうぞうを慕,したったからである。","tok":[["これ"],["は"],["彼","かれ"],["ら"],["が"],["わが"],["おきて"],["を"],["行なわず","おこなわず"],["、"],["わが"],["定め","さだめ"],["を"],["捨て","すて"],["、"],["わが"],["安息日","あんそくにち"],["を"],["汚","け"],["がし"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["に"],["その"],["先祖","せんぞ"],["の"],["偶像","ぐうぞう"],["を"],["慕った","したった"],["から"],["で"],["ある"],["。"]]},{"verse":25,"text":"またわたしは彼,かれらに良,よくない定,さだめと、それによって生,いきることのできないおきてとを与,あたえ、","tok":[["また"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["良く","よく"],["ない"],["定め","さだめ"],["と"],["、"],["それ"],["によって"],["生きる","いきる"],["こと"],["の"],["できない"],["おきて"],["と"],["を"],["与","あたえ"],["、"]]},{"verse":26,"text":"そして、彼,かれらのういごに火,ひの中,なかを通,とおらせるその供,そなえ物,ものによって、彼,かれらを汚,けがし、彼,かれらを恐,おそれさせた。わたしがこれを行,おこなったのは、わたしが主,しゅであることを、彼,かれらに知,しらせるためである。","tok":[["そして"],["、"],["彼","かれ"],["ら"],["の"],["うい"],["ご"],["に"],["火","ひ"],["の"],["中","なか"],["を"],["通らせる","とおらせる"],["その"],["供え物","そなえもの"],["によって"],["、"],["彼","かれ"],["ら"],["を"],["汚","け"],["がし"],["、"],["彼","かれ"],["ら"],["を"],["恐れさせた","おそれさせた"],["。"],["わたし"],["が"],["これ"],["を"],["行なった","おこなった"],["の"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["、"],["彼","かれ"],["ら"],["に"],["知らせる","しらせる"],["ため"],["で"],["ある"],["。"]]},{"verse":27,"text":"それゆえ人,ひとの子,こよ、イスラエルの家,いえに告,つげて言,いえ。主,しゅなる神,かみはこう言,いわれる、あなたがたの先祖,せんぞはまた、不信,ふしんの罪,つみを犯,おかしてわたしを汚,けがした。","tok":[["それ"],["ゆえ"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["告","つげ"],["て"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["は"],["また"],["、"],["不信","ふしん"],["の"],["罪","つみ"],["を"],["犯して","おかして"],["わたし"],["を"],["汚","け"],["がした"],["。"]]},{"verse":28,"text":"わたしが彼,かれらに与,あたえようと誓,ちかった地,ちに、彼,かれらを導,みちびき入,いれた時,とき、彼,かれらはすべての高,たかい丘,おかと、すべての茂,しげった木,きとを見,みて、その所,ところで犠牲,ぎせいをささげ、忌,いむべき供,そなえ物,ものをささげ、またこうばしいかおりをその所,ところに上,のぼらせ、その所,ところに灌祭,かんさいを注,そそいだ。","tok":[["わたし"],["が"],["彼","かれ"],["ら"],["に"],["与","あたえ"],["よう"],["と"],["誓った","ちかった"],["地","ち"],["に"],["、"],["彼","かれ"],["ら"],["を"],["導き入れた","みちびきいれた"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["すべて"],["の"],["高い","たかい"],["丘","おか"],["と"],["、"],["すべて"],["の"],["茂った","しげった"],["木","き"],["と"],["を"],["見て","みて"],["、"],["その"],["所","ところ"],["で"],["犠牲","ぎせい"],["を"],["ささげ"],["、"],["忌むべき","いむべき"],["供え物","そなえもの"],["を"],["ささげ"],["、"],["また"],["こうばしい"],["かおり"],["を"],["その"],["所","ところ"],["に"],["上らせ","のぼらせ"],["、"],["その"],["所","ところ"],["に"],["灌祭","かんさい"],["を"],["注いだ","そそいだ"],["。"]]},{"verse":29,"text":"（わたしは彼,かれらに言,いった、あなたがたが通,かようその高,たかき所,ところはなんであるか。それでその名,なは今日,こんにちまでバマととなえられている。）","tok":[["（"],["わたし"],["は"],["彼","かれ"],["ら"],["に"],["言った","いった"],["、"],["あなた"],["がた"],["が"],["通う","かよう"],["その"],["高き","たかき"],["所","ところ"],["は"],["なん"],["で"],["ある"],["か"],["。"],["それ"],["で"],["その"],["名","な"],["は"],["今日","こん"],["に"],["ち"],["まで"],["バマ"],["と"],["となえられて"],["いる"],["。"],["）"]]},{"verse":30,"text":"それゆえ、イスラエルの家,いえに言,いえ。主,しゅなる神,かみはこう言,いわれる、あなたがたは、その先祖,せんぞのおこないに従,したがって、その身,みを汚,けがし、その憎,にくむべきものを慕,したうのか。","tok":[["それ"],["ゆえ"],["、"],["イスラエル"],["の"],["家","いえ"],["に"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["、"],["その"],["先祖","せんぞ"],["の"],["おこない"],["に"],["従って","したがって"],["、"],["その"],["身","み"],["を"],["汚","け"],["がし"],["、"],["その"],["憎むべき","にくむべき"],["もの"],["を"],["慕う","したう"],["の"],["か"],["。"]]},{"verse":31,"text":"あなたがたは、その供,そなえ物,ものをささげ、その子,こ供,ともに火,ひの中,なかを通,とおらせて、今日,こんにちまですべての偶像,ぐうぞうをもって、その身,みを汚,けがすのである。イスラエルの家,いえよ、わたしは、なおあなたがたに尋,たずねられるべきであろうか。わたしは生,いきている。わたしは決,けっしてあなたがたに尋,たずねられるはずはないと、主,しゅなる神,かみは言,いわれる。","tok":[["あなた"],["がた"],["は"],["、"],["その"],["供え物","そなえもの"],["を"],["ささげ"],["、"],["その"],["子供","ことも"],["に"],["火","ひ"],["の"],["中","なか"],["を"],["通らせて","とおらせて"],["、"],["今日","こん"],["に"],["ち"],["まで"],["すべて"],["の"],["偶像","ぐうぞう"],["を"],["もって"],["、"],["その"],["身","み"],["を"],["汚す","けがす"],["ので"],["ある"],["。"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["わたし"],["は"],["、"],["なお"],["あなた"],["がた"],["に"],["尋ねられるべきで","たずねられるべきで"],["あろう"],["か"],["。"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["わたし"],["は"],["決っして","けっして"],["あなた"],["がた"],["に"],["尋ねられる","たずねられる"],["はず"],["は"],["ない"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":32,"text":"あなたがたの心,こころにあること、すなわち『われわれは異邦人,いほうじんのようになり、国々,くにぐにのもろもろのやからのようになって、木,きや石,いしを拝,おがもう』との考,かんがえは決,けっして成就,じょうじゅしない。","tok":[["あなた"],["がた"],["の"],["心","こころ"],["に"],["ある"],["こと"],["、"],["すなわち"],["『"],["われわれ"],["は"],["異邦人","いほうじん"],["の"],["よう"],["に"],["なり"],["、"],["国々","くにぐに"],["の"],["もろもろ"],["の"],["やから"],["の"],["よう"],["に"],["なって"],["、"],["木","き"],["や"],["石","いし"],["を"],["拝もう","おがもう"],["』"],["と"],["の"],["考","かんがえ"],["は"],["決っして","けっして"],["成就","じょうじゅ"],["しない"],["。"]]},{"verse":33,"text":"主,しゅなる神,かみは言,いわれる、わたしは生,いきている、わたしは必,かならず強,つよい手,てと伸,のべた腕,うでと注,そそがれた憤,いきどおりとをもって、あなたがたを治,おさめる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["、"],["わたし"],["は"],["必","かならず"],["強い","つよい"],["手","て"],["と"],["伸べた","のべた"],["腕","うで"],["と"],["注がれた","そそがれた"],["憤り","いきどおり"],["と"],["を"],["もって"],["、"],["あなた"],["がた"],["を"],["治める","おさめる"],["。"]]},{"verse":34,"text":"わたしはわが強,つよい手,てと伸,のべた腕,うでと注,そそがれた憤,いきどおりとをもって、あなたがたをもろもろの民,たみの中,なかから導,みちびき出,だし、その散,ちらされた国々,くにぐにから集,あつめ、","tok":[["わたし"],["は"],["わが"],["強い","つよい"],["手","て"],["と"],["伸べた","のべた"],["腕","うで"],["と"],["注がれた","そそがれた"],["憤り","いきどおり"],["と"],["を"],["もって"],["、"],["あなた"],["がた"],["を"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["導き出し","みちびきだし"],["、"],["その"],["散らされた","ちらされた"],["国々","くにぐに"],["から"],["集め","あつめ"],["、"]]},{"verse":35,"text":"もろもろの民,たみの荒野,あらのに導,みちびき入,いれ、その所,ところで顔,かおと顔,かおとを合,あわせて、あなたがたをさばく。","tok":[["もろもろ"],["の"],["民","たみ"],["の"],["荒野","あらの"],["に"],["導き入れ","みちびきいれ"],["、"],["その"],["所","ところ"],["で"],["顔","かお"],["と"],["顔","かお"],["と"],["を"],["合","あわせ"],["て"],["、"],["あなた"],["がた"],["を"],["さばく"],["。"]]},{"verse":36,"text":"すなわち、エジプトの地,ちの荒野,あらので、あなたがたの先祖,せんぞをさばいたように、わたしはあなたがたをさばくと、主,しゅなる神,かみは言,いわれる。","tok":[["すなわち"],["、"],["エジプト"],["の"],["地","ち"],["の"],["荒野","あらの"],["で"],["、"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["を"],["さばいた"],["よう"],["に"],["、"],["わたし"],["は"],["あなた"],["がた"],["を"],["さばく"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":37,"text":"わたしはあなたがたに、むちの下,したを通,とおらせ、数,かぞえてはいらせ、","tok":[["わたし"],["は"],["あなた"],["がた"],["に"],["、"],["むち"],["の"],["下","した"],["を"],["通らせ","とおらせ"],["、"],["数えて","かぞえて"],["はいらせ"],["、"]]},{"verse":38,"text":"あなたがたのうちから、従,したがわぬ者,ものと、わたしにそむいた者,ものとを分,わかち、その寄留,きりゅうした地,ちから、彼,かれらを導,みちびき出,だす。しかし彼,かれらはイスラエルの地,ちに入,いることはできない。こうしてあなたがたはわたしが主,しゅであることを知,しるようになる。","tok":[["あなた"],["がた"],["の"],["うち"],["から"],["、"],["従わぬ","したがわぬ"],["者","もの"],["と"],["、"],["わたし"],["に"],["そむいた"],["者","もの"],["と"],["を"],["分かち","わかち"],["、"],["その"],["寄留","きりゅう"],["した"],["地","ち"],["から"],["、"],["彼","かれ"],["ら"],["を"],["導き出す","みちびきだす"],["。"],["しかし"],["彼","かれ"],["ら"],["は"],["イスラエル"],["の"],["地","ち"],["に"],["入","いる"],["こと"],["は"],["できない"],["。"],["こう"],["して"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":39,"text":"それで、イスラエルの家,いえよ、主,しゅなる神,かみはこう言,いわれる、あなたがたはわたしに聞,きかないなら、今,いまも後,のちも、おのおのその偶像,ぐうぞうに行,いって仕,つかえるがよい。しかし再,ふたたび供,そなえ物,ものと偶像,ぐうぞうとをもって、わたしの聖,せいなる名,なを汚,けがしてはならない。","tok":[["それ"],["で"],["、"],["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["は"],["わたし"],["に"],["聞かないなら","きかないなら"],["、"],["今","いま"],["も"],["後","のち"],["も"],["、"],["おのおの"],["その"],["偶像","ぐうぞう"],["に"],["行って","いって"],["仕える","つかえる"],["が"],["よい"],["。"],["しかし"],["再び","ふたたび"],["供え物","そなえもの"],["と"],["偶像","ぐうぞう"],["と"],["を"],["もって"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["名","な"],["を"],["汚","け"],["がして"],["は"],["ならない"],["。"]]},{"verse":40,"text":"主,しゅなる神,かみは言,いわれる、わたしの聖,せいなる山,やま、イスラエルの高,たかい山,やまの上,うえで、イスラエルの全家,ぜんかはその地,ちで、ことごとくわたしに仕,つかえる。その所,ところでわたしは喜,よろこんで彼,かれらを受,うけいれ、あなたがたのささげ物,ものと最上,さいじょうの供,そなえ物,ものとを、その聖,せいなるささげ物,ものと共,ともに求,もとめる。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["山","やま"],["、"],["イスラエル"],["の"],["高い","たかい"],["山","やま"],["の"],["上","うえ"],["で"],["、"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["は"],["その"],["地","ち"],["で"],["、"],["ことごとく"],["わたし"],["に"],["仕える","つかえる"],["。"],["その"],["所","ところ"],["で"],["わたし"],["は"],["喜こんで","よろこんで"],["彼","かれ"],["ら"],["を"],["受","うけ"],["いれ"],["、"],["あなた"],["がた"],["の"],["ささげ物","ささげもの"],["と"],["最上","さいじょう"],["の"],["供え物","そなえもの"],["と"],["を"],["、"],["その"],["聖","せい"],["なる"],["ささげ物","ささげもの"],["と"],["共","とも"],["に"],["求める","もとめる"],["。"]]},{"verse":41,"text":"わたしがあなたがたをもろもろの民,たみの中,なかから導,みちびき出,だし、かつてあなたがたを散,ちらした国々,くにぐにから集,あつめる時,とき、こうばしいかおりとして、あなたがたを喜,よろこんで受,うけいれる。そしてわたしは異邦人,いほうじんの前,まえで、あなたがたの中,なかに、わたしの聖,せいなることをあらわす。","tok":[["わたし"],["が"],["あなた"],["がた"],["を"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["導き出し","みちびきだし"],["、"],["かつて"],["あなた"],["がた"],["を"],["散らした","ちらした"],["国々","くにぐに"],["から"],["集める","あつめる"],["時","とき"],["、"],["こうばしい"],["かおり"],["として"],["、"],["あなた"],["がた"],["を"],["喜こんで","よろこんで"],["受けいれる","うけいれる"],["。"],["そして"],["わたし"],["は"],["異邦人","いほうじん"],["の"],["前","まえ"],["で"],["、"],["あなた"],["がた"],["の"],["中","なか"],["に"],["、"],["わたし"],["の"],["聖","せい"],["なる"],["こと"],["を"],["あらわす"],["。"]]},{"verse":42,"text":"こうしてわたしがあなたがたを、イスラエルの地,ち、すなわちあなたがたの先祖,せんぞたちに与,あたえると誓,ちかった地,ちに、はいらせる時,とき、あなたがたはわたしが主,しゅであることを知,しるようになる。","tok":[["こう"],["して"],["わたし"],["が"],["あなた"],["がた"],["を"],["、"],["イスラエル"],["の"],["地","ち"],["、"],["すなわち"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["たち"],["に"],["与える","あたえる"],["と"],["誓った","ちかった"],["地","ち"],["に"],["、"],["はいらせる"],["時","とき"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":43,"text":"またその所,ところであなたがたは、その身,みを汚,けがしたあなたがたのおこないと、すべてのわざとを思,おもい出,だし、みずから行,おこなったすべての悪事,あくじのために、自分,じぶんを忌,いみきらうようになる。","tok":[["また"],["その"],["所","ところ"],["で"],["あなた"],["がた"],["は"],["、"],["その"],["身","み"],["を"],["汚","け"],["がした"],["あなた"],["がた"],["の"],["おこない"],["と"],["、"],["すべて"],["の"],["わざと"],["を"],["思い出し","おもいだし"],["、"],["みずから"],["行なった","おこなった"],["すべて"],["の"],["悪事","あくじ"],["の"],["ため"],["に"],["、"],["自分","じぶん"],["を"],["忌","いみ"],["きらう"],["よう"],["に"],["なる"],["。"]]},{"verse":44,"text":"イスラエルの家,いえよ、わたしがあなたがたの悪,あしきおこないによらず、またその腐,くされたわざによらず、わたしの名,なのために、あなたがたを扱,あつかう時,とき、あなたがたはわたしが主,しゅであることを知,しるのであると、主,しゅなる神,かみは言,いわれる」。","tok":[["イスラエル"],["の"],["家","いえ"],["よ"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["悪しき","あしき"],["おこない"],["に"],["よらず"],["、"],["また"],["その"],["腐れた","くされた"],["わざ"],["に"],["よらず"],["、"],["わたし"],["の"],["名","な"],["の"],["ため"],["に"],["、"],["あなた"],["がた"],["を"],["扱う","あつかう"],["時","とき"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["ので"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]}]
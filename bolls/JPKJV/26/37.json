[{"verse":1,"text":"主,しゅの手,てがわたしに臨,のぞみ、主,しゅはわたしを主,しゅの霊,れいに満,みたして出,でて行,いかせ、谷,たにの中,なかにわたしを置,おかれた。そこには骨,ほねが満,みちていた。","tok":[["主","しゅ"],["の"],["手","て"],["が"],["わたし"],["に"],["臨み","のぞみ"],["、"],["主","しゅ"],["は"],["わたし"],["を"],["主","しゅ"],["の"],["霊","れい"],["に"],["満たして","みたして"],["出て","でて"],["行かせ","いかせ"],["、"],["谷","たに"],["の"],["中","なか"],["に"],["わたし"],["を"],["置かれた","おかれた"],["。"],["そこ"],["に"],["は"],["骨","ほね"],["が"],["満ちて","みちて"],["いた"],["。"]]},{"verse":2,"text":"彼,かれはわたしに谷,たにの周囲,しゅういを行,ゆきめぐらせた。見,みよ、谷,たにの面,めんには、はなはだ多,おおくの骨,ほねがあり、皆,みないたく枯,かれていた。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["谷","たに"],["の"],["周囲","しゅうい"],["を"],["行らせた","ゆきめぐらせた"],["。"],["見よ","みよ"],["、"],["谷","たに"],["の"],["面","めん"],["に"],["は"],["、"],["はなはだ"],["多く","おおく"],["の"],["骨","ほね"],["が"],["あり"],["、"],["皆","みな"],["いたく"],["枯て","かれて"],["いた"],["。"]]},{"verse":3,"text":"彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、これらの骨,ほねは、生,いき返,かえることができるのか」。わたしは答,こたえた、「主,しゅなる神,かみよ、あなたはご存,ぞんじです」。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["これ"],["ら"],["の"],["骨","ほね"],["は"],["、"],["生き返る","いきかえる"],["こと"],["が"],["できる"],["の"],["か"],["」"],["。"],["わたし"],["は"],["答","こたえ"],["た"],["、"],["「"],["主","しゅ"],["なる"],["神","かみ"],["よ"],["、"],["あなた"],["は"],["ご存じ","ごぞんじ"],["です"],["」"],["。"]]},{"verse":4,"text":"彼,かれはまたわたしに言,いわれた、「これらの骨,ほねに預言,よげんして、言,いえ。枯,かれた骨,ほねよ、主,しゅの言葉,ことばを聞,きけ。","tok":[["彼","かれ"],["は"],["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["これ"],["ら"],["の"],["骨","ほね"],["に"],["預言","よげん"],["して"],["、"],["言え","いえ"],["。"],["枯た","かれた"],["骨","ほね"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":5,"text":"主,しゅなる神,かみはこれらの骨,ほねにこう言,いわれる、見,みよ、わたしはあなたがたのうちに息,いきを入,いれて、あなたがたを生,いかす。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["これ"],["ら"],["の"],["骨","ほね"],["に"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["息","いき"],["を"],["入れて","いれて"],["、"],["あなた"],["がた"],["を"],["生かす","いかす"],["。"]]},{"verse":6,"text":"わたしはあなたがたの上,うえに筋,すじを与,あたえ、肉,にくを生,しょうじさせ、皮,かわでおおい、あなたがたのうちに息,いきを与,あたえて生,いかす。そこであなたがたはわたしが主,しゅであることを悟,さとる」。","tok":[["わたし"],["は"],["あなた"],["がた"],["の"],["上","うえ"],["に"],["筋","すじ"],["を"],["与","あたえ"],["、"],["肉","にく"],["を"],["生じさせ","しょうじさせ"],["、"],["皮","かわ"],["で"],["おおい"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["息","いき"],["を"],["与","あたえ"],["て"],["生かす","いかす"],["。"],["そこ"],["で"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["」"],["。"]]},{"verse":7,"text":"わたしは命,めいじられたように預言,よげんしたが、わたしが預言,よげんした時,とき、声,こえがあった。見,みよ、動,うごく音,おとがあり、骨,ほねと骨,ほねが集,あつまって相,あいつらなった。","tok":[["わたし"],["は"],["命じられた","めいじられた"],["よう"],["に"],["預言","よげん"],["した"],["が"],["、"],["わたし"],["が"],["預言","よげん"],["した"],["時","とき"],["、"],["声","こえ"],["が"],["あった"],["。"],["見よ","みよ"],["、"],["動く","うごく"],["音","おと"],["が"],["あり"],["、"],["骨","ほね"],["と"],["骨","ほね"],["が"],["集まって","あつまって"],["相","あい"],["つらなった"],["。"]]},{"verse":8,"text":"わたしが見,みていると、その上,うえに筋,すじができ、肉,にくが生,しょうじ、皮,かわがこれをおおったが、息,いきはその中,なかになかった。","tok":[["わたし"],["が"],["見て","みて"],["いる"],["と"],["、"],["その"],["上","うえ"],["に"],["筋","すじ"],["が"],["でき"],["、"],["肉","にく"],["が"],["生じ","しょうじ"],["、"],["皮","かわ"],["が"],["これ"],["を"],["おおった"],["が"],["、"],["息","いき"],["は"],["その"],["中","なか"],["に"],["なかった"],["。"]]},{"verse":9,"text":"時,ときに彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、息,いきに預言,よげんせよ、息,いきに預言,よげんして言,いえ。主,しゅなる神,かみはこう言,いわれる、息,いきよ、四方,しほうから吹,ふいて来,きて、この殺,ころされた者,ものたちの上,うえに吹,ふき、彼,かれらを生,いかせ」。","tok":[["時","とき"],["に"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["息","いき"],["に"],["預言","よげん"],["せよ"],["、"],["息","いき"],["に"],["預言","よげん"],["して"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["息","いき"],["よ"],["、"],["四方","しほう"],["から"],["吹いて","ふいて"],["来て","きて"],["、"],["この"],["殺ろされた","ころされた"],["者","もの"],["たち"],["の"],["上","うえ"],["に"],["吹","ふき"],["、"],["彼","かれ"],["ら"],["を"],["生かせ","いかせ"],["」"],["。"]]},{"verse":10,"text":"そこでわたしが命,めいじられたように預言,よげんすると、息,いきはこれにはいった。すると彼,かれらは生,いき、その足,あしで立,たち、はなはだ大,おおいなる群衆,ぐんしゅうとなった。","tok":[["そこ"],["で"],["わたし"],["が"],["命じられた","めいじられた"],["よう"],["に"],["預言","よげん"],["する"],["と"],["、"],["息","いき"],["は"],["これ"],["に"],["はいった"],["。"],["する"],["と"],["彼","かれ"],["ら"],["は"],["生き","いき"],["、"],["その"],["足","あし"],["で"],["立ち","たち"],["、"],["はなはだ"],["大いなる","おおいなる"],["群衆","ぐんしゅう"],["と"],["なった"],["。"]]},{"verse":11,"text":"そこで彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、これらの骨,ほねはイスラエルの全家,ぜんかである。見,みよ、彼,かれらは言,いう、『われわれの骨,ほねは枯,かれ、われわれの望,のぞみは尽,つき、われわれは絶,たえ果,はてる』と。","tok":[["そこ"],["で"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["これ"],["ら"],["の"],["骨","ほね"],["は"],["イスラエル"],["の"],["全家","ぜんか"],["で"],["ある"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["『"],["われわれ"],["の"],["骨","ほね"],["は"],["枯","かれ"],["、"],["われわれ"],["の"],["望み","のぞみ"],["は"],["尽き","つき"],["、"],["われわれ"],["は"],["絶え","たえ"],["果てる","はてる"],["』"],["と"],["。"]]},{"verse":12,"text":"それゆえ彼,かれらに預言,よげんして言,いえ。主,しゅなる神,かみはこう言,いわれる、わが民,たみよ、見,みよ、わたしはあなたがたの墓,はかを開,ひらき、あなたがたを墓,はかからとりあげて、イスラエルの地,ちにはいらせる。","tok":[["それ"],["ゆえ"],["彼","かれ"],["ら"],["に"],["預言","よげん"],["して"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わが"],["民","たみ"],["よ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["がた"],["の"],["墓","はか"],["を"],["開らき","ひらき"],["、"],["あなた"],["がた"],["を"],["墓","はか"],["から"],["とりあげて"],["、"],["イスラエル"],["の"],["地","ち"],["に"],["はいらせる"],["。"]]},{"verse":13,"text":"わが民,たみよ、わたしがあなたがたの墓,はかを開,ひらき、あなたがたをその墓,はかからとりあげる時,とき、あなたがたは、わたしが主,しゅであることを悟,さとる。","tok":[["わが"],["民","たみ"],["よ"],["、"],["わたし"],["が"],["あなた"],["がた"],["の"],["墓","はか"],["を"],["開らき","ひらき"],["、"],["あなた"],["がた"],["を"],["その"],["墓","はか"],["から"],["とりあげる"],["時","とき"],["、"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["。"]]},{"verse":14,"text":"わたしがわが霊,れいを、あなたがたのうちに置,おいて、あなたがたを生,いかし、あなたがたをその地,ちに安住,あんじゅうさせる時,とき、あなたがたは、主,しゅなるわたしがこれを言,いい、これをおこなったことを悟,さとると、主,しゅは言,いわれる」。","tok":[["わたし"],["が"],["わが"],["霊","れい"],["を"],["、"],["あなた"],["がた"],["の"],["うち"],["に"],["置いて","おいて"],["、"],["あなた"],["がた"],["を"],["生かし","いかし"],["、"],["あなた"],["がた"],["を"],["その"],["地","ち"],["に"],["安住","あんじゅう"],["させる"],["時","とき"],["、"],["あなた"],["がた"],["は"],["、"],["主","しゅ"],["なる"],["わたし"],["が"],["これ"],["を"],["言い","いい"],["、"],["これ"],["を"],["おこなった"],["こと"],["を"],["悟","さとる"],["と"],["、"],["主","しゅ"],["は"],["言われる","いわれる"],["」"],["。"]]},{"verse":15,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":16,"text":"「人,ひとの子,こよ、あなたは一本,ぽんの木,きを取,とり、その上,うえに『ユダおよびその友,ともであるイスラエルの子孫,しそんのために』と書,かき、また一本,ぽんの木,きを取,とって、その上,うえに『ヨセフおよびその友,ともであるイスラエルの全家,ぜんかのために』と書,かけ。これはエフライムの木,きである。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["一本","ぽん"],["の"],["木","き"],["を"],["取","とり"],["、"],["その"],["上","うえ"],["に"],["『"],["ユダ"],["および"],["その"],["友","とも"],["で"],["ある"],["イスラエル"],["の"],["子孫","しそん"],["の"],["ため"],["に"],["』"],["と"],["書き","かき"],["、"],["また"],["一本","ぽん"],["の"],["木","き"],["を"],["取って","とって"],["、"],["その"],["上","うえ"],["に"],["『"],["ヨセフ"],["および"],["その"],["友","とも"],["で"],["ある"],["イスラエル"],["の"],["全","ぜん"],["家","いえ"],["の"],["ため"],["に"],["』"],["と"],["書け","かけ"],["。"],["これ"],["は"],["エフライム"],["の"],["木","き"],["で"],["ある"],["。"]]},{"verse":17,"text":"あなたはこれらを合,あわせて、一つの木,きとなせ。これらはあなたの手,てで一つになる。","tok":[["あなた"],["は"],["これ"],["ら"],["を"],["合","あわせ"],["て"],["、"],["一","ひと"],["つ"],["の"],["木","き"],["と"],["なせ"],["。"],["これ"],["ら"],["は"],["あなた"],["の"],["手","て"],["で"],["一","ひと"],["つ"],["に"],["なる"],["。"]]},{"verse":18,"text":"あなたの民,たみの人々,ひとびとがあなたに向,むかって、『これはなんのことであるか、われわれに示,しめしてくれないか』と言,いう時,ときは、","tok":[["あなた"],["の"],["民","たみ"],["の"],["人々","ひとびと"],["が"],["あなた"],["に"],["向かって","むかって"],["、"],["『"],["これ"],["は"],["なん"],["の"],["こと"],["で"],["ある"],["か"],["、"],["われわれ"],["に"],["示めして","しめして"],["くれない"],["か"],["』"],["と"],["言う","いう"],["時","とき"],["は"],["、"]]},{"verse":19,"text":"これに言,いえ、主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしはエフライムの手,てにあるヨセフと、その友,ともであるイスラエルの部族,ぶぞくの木,きを取,とり、これをユダの木,きに合,あわせて、一つの木,きとなす。これらはわたしの手,てで一つとなる。","tok":[["これ"],["に"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["エフライム"],["の"],["手","て"],["に"],["ある"],["ヨセフ"],["と"],["、"],["その"],["友","とも"],["で"],["ある"],["イスラエル"],["の"],["部族","ぶぞく"],["の"],["木","き"],["を"],["取","とり"],["、"],["これ"],["を"],["ユダ"],["の"],["木","き"],["に"],["合","あわせ"],["て"],["、"],["一","ひと"],["つ"],["の"],["木","き"],["と"],["なす"],["。"],["これ"],["ら"],["は"],["わたし"],["の"],["手","て"],["で"],["一","ひと"],["つ"],["と"],["なる"],["。"]]},{"verse":20,"text":"あなたが文字,もじを書,かいた木,きが、彼,かれらの目,めの前,まえで、あなたの手,てにあるとき、","tok":[["あなた"],["が"],["文字","もじ"],["を"],["書いた","かいた"],["木","き"],["が"],["、"],["彼","かれ"],["ら"],["の"],["目","め"],["の"],["前","まえ"],["で"],["、"],["あなた"],["の"],["手","て"],["に"],["ある"],["とき"],["、"]]},{"verse":21,"text":"あなたは彼,かれらに言,いえ。主,しゅなる神,かみは、こう言,いわれる、見,みよ、わたしはイスラエルの人々,ひとびとを、その行,いった国々,くにぐにから取,とり出,だし、四方,しほうから彼,かれらを集,あつめて、その地,ちにみちびき、","tok":[["あなた"],["は"],["彼","かれ"],["ら"],["に"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["、"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["、"],["その"],["行った","いった"],["国々","くにぐに"],["から"],["取出し","とりだし"],["、"],["四方","しほう"],["から"],["彼","かれ"],["ら"],["を"],["集めて","あつめて"],["、"],["その"],["地","ち"],["に"],["みちびき"],["、"]]},{"verse":22,"text":"その地,ちで彼,かれらを一つの民,たみとなしてイスラエルの山々,やまやまにおらせ、ひとりの王,おうが彼,かれら全体,ぜんたいの王,おうとなり、彼,かれらは重,かさねて二つの国民,こくみんとならず、再,ふたたび二つの国,くにに分,わかれない。","tok":[["その"],["地","ち"],["で"],["彼","かれ"],["ら"],["を"],["一","ひと"],["つ"],["の"],["民","たみ"],["と"],["なして"],["イスラエル"],["の"],["山々","やまやま"],["に"],["おらせ"],["、"],["ひとり"],["の"],["王","おう"],["が"],["彼","かれ"],["ら"],["全体","ぜんたい"],["の"],["王","おう"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["重ねて","かさねて"],["二","ふた"],["つ"],["の"],["国民","こくみん"],["と"],["ならず"],["、"],["再び","ふたたび"],["二","ふた"],["つ"],["の"],["国","くに"],["に"],["分かれない","わかれない"],["。"]]},{"verse":23,"text":"彼,かれらはまた、その偶像,ぐうぞうと、その憎,にくむべきことどもと、もろもろのとがとをもって、身,みを汚,けがすことはない。わたしは彼,かれらを、その犯,おかしたすべての背信,はいしんから救,すくい出,だして、これを清,きよめる。そして彼,かれらはわが民,たみとなり、わたしは彼,かれらの神,かみとなる。","tok":[["彼","かれ"],["ら"],["は"],["また"],["、"],["その"],["偶像","ぐうぞう"],["と"],["、"],["その"],["憎むべき","にくむべき"],["こと"],["ども"],["と"],["、"],["もろもろ"],["の"],["とが"],["と"],["を"],["もって"],["、"],["身","み"],["を"],["汚す","けがす"],["こと"],["は"],["ない"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["、"],["その"],["犯した","おかした"],["すべて"],["の"],["背信","はいしん"],["から"],["救い出して","すくいだして"],["、"],["これ"],["を"],["清める","きよめる"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["わが"],["民","たみ"],["と"],["なり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なる"],["。"]]},{"verse":24,"text":"わがしもべダビデは彼,かれらの王,おうとなる。彼,かれらすべての者,もののために、ひとりの牧者,ぼくしゃが立,たつ。彼,かれらはわがおきてに歩,あゆみ、わが定,さだめを守,まもって行,おこなう。","tok":[["わが"],["しもべ"],["ダビデ"],["は"],["彼","かれ"],["ら"],["の"],["王","おう"],["と"],["なる"],["。"],["彼","かれ"],["ら"],["すべて"],["の"],["者","もの"],["の"],["ため"],["に"],["、"],["ひとり"],["の"],["牧者","ぼくしゃ"],["が"],["立つ","たつ"],["。"],["彼","かれ"],["ら"],["は"],["わが"],["おきて"],["に"],["歩み","あゆみ"],["、"],["わが"],["定め","さだめ"],["を"],["守って","まもって"],["行なう","おこなう"],["。"]]},{"verse":25,"text":"彼,かれらはわがしもべヤコブに、わたしが与,あたえた地,ちに住,すむ。これはあなたがたの先祖,せんぞの住,すんだ所,ところである。そこに彼,かれらと、その子,こらと、その子孫,しそんとが永遠,えいえんに住,すみ、わがしもべダビデが、永遠,えいえんに彼,かれらの君,きみとなる。","tok":[["彼","かれ"],["ら"],["は"],["わが"],["しもべ"],["ヤコブ"],["に"],["、"],["わたし"],["が"],["与","あたえ"],["た"],["地","ち"],["に"],["住む","すむ"],["。"],["これ"],["は"],["あなた"],["がた"],["の"],["先祖","せんぞ"],["の"],["住んだ","すんだ"],["所","ところ"],["で"],["ある"],["。"],["そこ"],["に"],["彼","かれ"],["ら"],["と"],["、"],["その"],["子","こ"],["ら"],["と"],["、"],["その"],["子孫","しそん"],["と"],["が"],["永遠","えいえん"],["に"],["住み","すみ"],["、"],["わが"],["しもべ"],["ダビデ"],["が"],["、"],["永遠","えいえん"],["に"],["彼","かれ"],["ら"],["の"],["君","きみ"],["と"],["なる"],["。"]]},{"verse":26,"text":"わたしは彼,かれらと平和,へいわの契約,けいやくを結,むすぶ。これは彼,かれらの永遠,えいえんの契約,けいやくとなる。わたしは彼,かれらを祝福,しゅくふくし、彼,かれらをふやし、わが聖所,せいじょを永遠,えいえんに彼,かれらの中,なかに置,おく。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["と"],["平和","へいわ"],["の"],["契約","けいやく"],["を"],["結ぶ","むすぶ"],["。"],["これ"],["は"],["彼","かれ"],["ら"],["の"],["永遠","えいえん"],["の"],["契約","けいやく"],["と"],["なる"],["。"],["わたし"],["は"],["彼","かれ"],["ら"],["を"],["祝福","しゅくふく"],["し"],["、"],["彼","かれ"],["ら"],["を"],["ふやし"],["、"],["わが"],["聖","せい"],["所","しょ"],["を"],["永遠","えいえん"],["に"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["置く","おく"],["。"]]},{"verse":27,"text":"わがすみかは彼,かれらと共,ともにあり、わたしは彼,かれらの神,かみとなり、彼,かれらはわが民,たみとなる。","tok":[["わが"],["すみか"],["は"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["あり"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なり"],["、"],["彼","かれ"],["ら"],["は"],["わが"],["民","たみ"],["と"],["なる"],["。"]]},{"verse":28,"text":"そしてわが聖所,せいじょが永遠,えいえんに、彼,かれらのうちにあるようになるとき、諸,しょ国民,こくみんは主,しゅなるわたしが、イスラエルを聖別,せいべつする者,ものであることを悟,さとる」。","tok":[["そして"],["わが"],["聖","せい"],["所","しょ"],["い"],["じょ"],["が"],["永遠","えいえん"],["に"],["、"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["ある"],["よう"],["に"],["なる"],["とき"],["、"],["諸","しょ"],["国民","こくみん"],["は"],["主","しゅ"],["なる"],["わたし"],["が"],["、"],["イスラエル"],["を"],["聖別","せいべつ"],["する"],["者","もの"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["」"],["。"]]}]
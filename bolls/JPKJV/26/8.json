[{"verse":1,"text":"第,だい六年,ねんの六月,がつ五日,かにわたしがわたしの家,いえに座,ざし、ユダの長老,ちょうろうたちがわたしの前,まえに座,ざしていたとき、主,しゅなる神,かみの手,てがわたしの上,うえに下,くだった。","tok":[["第","だい"],["六","ろく"],["年","ねん"],["の"],["六","ろく"],["月","がつ"],["つ"],["五日","か"],["に"],["わたし"],["が"],["わたし"],["の"],["家","いえ"],["に"],["座し","ざし"],["、"],["ユダ"],["の"],["長老","ちょうろう"],["たち"],["が"],["わたし"],["の"],["前","まえ"],["に"],["座して","ざして"],["いた"],["とき"],["、"],["主","しゅ"],["なる"],["神","かみ"],["の"],["手","て"],["が"],["わたし"],["の"],["上","うえ"],["に"],["下った","くだった"],["。"]]},{"verse":2,"text":"わたしは見,みていると、見,みよ、人,ひとのような形,かたちがあって、その腰,こしとみられる所,ところから下,したは火,ひのように見,みえ、腰,こしから上,うえは光,ひかる青銅,せいどうのように輝,かがやいて見,みえた。","tok":[["わたし"],["は"],["見て","みて"],["いる"],["と"],["、"],["見よ","みよ"],["、"],["人","ひと"],["の"],["よう"],["な"],["形","かたち"],["が"],["あって"],["、"],["その"],["腰","こし"],["と"],["みられる"],["所","ところ"],["から"],["下","した"],["は"],["火","ひ"],["の"],["よう"],["に"],["見え","みえ"],["、"],["腰","こし"],["から"],["上","うえ"],["は"],["光る","ひかる"],["青銅","せいどう"],["の"],["よう"],["に"],["輝やいて","かがやいて"],["見えた","みえた"],["。"]]},{"verse":3,"text":"彼,かれは手,てのようなものを伸,のべて、わたしの髪,かみの毛,けをつかんだ。そして霊,れいがわたしを天,てんと地,ちの間,あいだに引,ひきあげ、神,かみの幻,まぼろしのうちにわたしをエルサレムに携,たずさえて行,いき、北,きたに向,むかった内庭,うちにわの門,もんの入口,いりぐちに至,いたらせた。そこには、ねたみをひき起,おこすねたみの偶像,ぐうぞうがあった。","tok":[["彼","かれ"],["は"],["手","て"],["の"],["よう"],["な"],["もの"],["を"],["伸べて","のべて"],["、"],["わたし"],["の"],["髪の毛","かみのけ"],["を"],["つかんだ"],["。"],["そして"],["霊","れい"],["が"],["わたし"],["を"],["天","てん"],["と"],["地","ち"],["の"],["間","あいだ"],["に"],["引","ひき"],["あげ"],["、"],["神","かみ"],["の"],["幻","まぼろし"],["の"],["うち"],["に"],["わたし"],["を"],["エルサレム"],["に"],["携えて","たずさえて"],["行き","いき"],["、"],["北","きた"],["に"],["向かった","むかった"],["内庭","うちにわ"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["至らせた","いたらせた"],["。"],["そこ"],["に"],["は"],["、"],["ねたみ"],["を"],["ひき起こす","ひきおこす"],["ねたみ"],["の"],["偶像","ぐうぞう"],["が"],["あった"],["。"]]},{"verse":4,"text":"見,みよ、そこに、わたしがかの平野,へいやで見,みた幻,まぼろしのようなイスラエルの神,かみの栄光,えいこうがあらわれた。","tok":[["見よ","みよ"],["、"],["そこ"],["に"],["、"],["わたし"],["が"],["かの"],["平野","へいや"],["で"],["見た","みた"],["幻","まぼろし"],["の"],["よう"],["な"],["イスラエル"],["の"],["神","かみ"],["の"],["栄光","えいこう"],["が"],["あらわれた"],["。"]]},{"verse":5,"text":"時,ときに彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、目,めをあげて北,きたの方,ほうをのぞめ」。そこでわたしが目,めをあげて北,きたの方,ほうをのぞむと、見,みよ、祭壇,さいだんの門,もんの北,きたにあたって、その入口,いりぐちに、このねたみの偶像,ぐうぞうがあった。","tok":[["時","とき"],["に"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["目","め"],["を"],["あげて"],["北","きた"],["の"],["方","ほう"],["を"],["のぞめ"],["」"],["。"],["そこ"],["で"],["わたし"],["が"],["目","め"],["を"],["あげて"],["北","きた"],["の"],["方","ほう"],["を"],["のぞむ"],["と"],["、"],["見よ","みよ"],["、"],["祭壇","さいだん"],["の"],["門","もん"],["の"],["北","きた"],["に"],["あたって"],["、"],["その"],["入口","いりぐち"],["に"],["、"],["この"],["ねたみ"],["の"],["偶像","ぐうぞう"],["が"],["あった"],["。"]]},{"verse":6,"text":"彼,かれはまたわたしに言,いわれた、「人,ひとの子,こよ、あなたは彼,かれらのしていること、すなわちイスラエルの家,いえがここでしている大,おおいなる憎,にくむべきことを見,みるか。これはわたしを聖所,せいじょから遠,とおざけるものである。しかしあなたは、さらに大,おおいなる憎,にくむべきことを見,みるだろう」。","tok":[["彼","かれ"],["は"],["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["彼","かれ"],["ら"],["の"],["して"],["いる"],["こと"],["、"],["すなわち"],["イスラエル"],["の"],["家","いえ"],["が"],["ここ"],["でして"],["いる"],["大いなる","おおいなる"],["憎むべき","にくむべき"],["こと"],["を"],["見る","みる"],["か"],["。"],["これ"],["は"],["わたし"],["を"],["聖","せい"],["所","しょ"],["ら"],["遠ざける","とおざける"],["もの"],["で"],["ある"],["。"],["しかし"],["あなた"],["は"],["、"],["さらに"],["大いなる","おおいなる"],["憎むべき","にくむべき"],["こと"],["を"],["見るだろう","みるだろう"],["」"],["。"]]},{"verse":7,"text":"そして彼,かれはわたしを庭,にわの門,もんに行,いかせた。わたしが見,みると、見,みよ、壁,かべに一つの穴,あながあった。","tok":[["そして"],["彼","かれ"],["は"],["わたし"],["を"],["庭","にわ"],["の"],["門","もん"],["に"],["行かせた","いかせた"],["。"],["わたし"],["が"],["見る","みる"],["と"],["、"],["見よ","みよ"],["、"],["壁","かべ"],["に"],["一","ひと"],["つ"],["の"],["穴","あな"],["が"],["あった"],["。"]]},{"verse":8,"text":"彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、壁,かべに穴,あなをあけよ」。そこでわたしが壁,かべに穴,あなをあけると、見,みよ、一つの戸,とがあった。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["壁","かべ"],["に"],["穴","あな"],["を"],["あけよ"],["」"],["。"],["そこ"],["で"],["わたし"],["が"],["壁","かべ"],["に"],["穴","あな"],["を"],["あける"],["と"],["、"],["見よ","みよ"],["、"],["一","ひと"],["つ"],["の"],["戸","と"],["が"],["あった"],["。"]]},{"verse":9,"text":"彼,かれはわたしに言,いわれた、「はいって、彼,かれらがここでなす所,ところの悪,あしき憎,にくむべきことを見,みよ」。","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["はい"],["って"],["、"],["彼","かれ"],["ら"],["が"],["ここ"],["で"],["なす"],["所","ところ"],["の"],["悪しき","あしき"],["憎むべき","にくむべき"],["こと"],["を"],["見よ","みよ"],["」"],["。"]]},{"verse":10,"text":"そこでわたしがはいって見,みると、もろもろの這,はうものと、憎,にくむべき獣,けものの形,かたち、およびイスラエルの家,いえのもろもろの偶像,ぐうぞうが、まわりの壁,かべに描,えがいてあった。","tok":[["そこ"],["で"],["わたし"],["が"],["はいって"],["見る","みる"],["と"],["、"],["もろもろ"],["の"],["這う","はう"],["もの"],["と"],["、"],["憎むべき","にくむべき"],["獣","けもの"],["の"],["形","かたち"],["、"],["および"],["イスラエル"],["の"],["家","いえ"],["の"],["もろもろ"],["の"],["偶像","ぐうぞう"],["が"],["、"],["まわり"],["の"],["壁","かべ"],["に"],["描いて","えがいて"],["あった"],["。"]]},{"verse":11,"text":"またイスラエルの家,いえの長老,ちょうろう七十人,にんが、その前,まえに立,たっていた。シャパンの子,こヤザニヤも、彼,かれらの中,なかに立,たっていた。おのおの手,てに香炉,こうろを持,もち、そしてその香,こうの煙,けむりが雲,くものようにのぼった。","tok":[["また"],["イスラエル"],["の"],["家","いえ"],["の"],["長老","ちょうろう"],["七","なな"],["十人","じゅうにん"],["が"],["、"],["その"],["前","まえ"],["に"],["立って","たって"],["いた"],["。"],["シャパン"],["の"],["子","こ"],["ヤザニヤ"],["も"],["、"],["彼","かれ"],["ら"],["の"],["中","なか"],["に"],["立って","たって"],["いた"],["。"],["おのおの"],["手","て"],["に"],["香炉","こうろ"],["を"],["持","もち"],["、"],["そして"],["その"],["香","こう"],["の"],["煙","けむり"],["が"],["雲","くも"],["の"],["よう"],["に"],["のぼった"],["。"]]},{"verse":12,"text":"時,ときに彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、イスラエルの家,いえの長老,ちょうろうたちが暗,くらい所,ところで行,おこなう事,こと、すなわちおのおのその偶像,ぐうぞうの室,しつで行,おこなう事,ことを見,みるか。彼,かれらは言,いう、『主,しゅはわれわれを見,みられない。主,しゅはこの地,ちを捨,すてられた』と」。","tok":[["時","とき"],["に"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["長老","ちょうろう"],["たち"],["が"],["暗い","くらい"],["所","ところ"],["で"],["行なう","おこなう"],["事","こと"],["、"],["すなわち"],["おのおの"],["その"],["偶像","ぐうぞう"],["の"],["室","し"],["つ"],["で"],["行なう","おこなう"],["事","こと"],["を"],["見る","みる"],["か"],["。"],["彼","かれ"],["ら"],["は"],["言う","いう"],["、"],["『"],["主","しゅ"],["は"],["われわれ"],["を"],["見られない","みられない"],["。"],["主","しゅ"],["は"],["この"],["地","ち"],["を"],["捨てられた","すてられた"],["』"],["と"],["」"],["。"]]},{"verse":13,"text":"またわたしに言,いわれた、「あなたはさらに彼,かれらがなす大,おおいなる憎,にくむべきことを見,みる」。","tok":[["また"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["あなた"],["は"],["さらに"],["彼","かれ"],["ら"],["が"],["なす"],["大いなる","おおいなる"],["憎むべき","にくむべき"],["こと"],["を"],["見る","みる"],["」"],["。"]]},{"verse":14,"text":"そして彼,かれはわたしを連,つれて主,しゅの家,いえの北,きたの門,もんの入口,いりぐちに行,いった。見,みよ、そこに女,おんなたちがすわって、タンムズのために泣,ないていた。","tok":[["そして"],["彼","かれ"],["は"],["わたし"],["を"],["連れて","つれて"],["主","しゅ"],["の"],["家","いえ"],["の"],["北","きた"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["行った","いった"],["。"],["見よ","みよ"],["、"],["そこ"],["に"],["女","おんな"],["たち"],["が"],["すわって"],["、"],["タンムズ"],["の"],["ため"],["に"],["泣いて","ないて"],["いた"],["。"]]},{"verse":15,"text":"その時,とき、彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、あなたはこれを見,みたか。これよりもさらに大,おおいなる憎,にくむべきことを見,みるだろう」。","tok":[["その"],["時","とき"],["、"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["これ"],["を"],["見た","みた"],["か"],["。"],["これ"],["より"],["も"],["さらに"],["大いなる","おおいなる"],["憎むべき","にくむべき"],["こと"],["を"],["見るだろう","みるだろう"],["」"],["。"]]},{"verse":16,"text":"彼,かれはまたわたしを連,つれて、主,しゅの家,いえの内庭,うちにわにはいった。見,みよ、主,しゅの宮,みやの入口,いりぐちに、廊,ろうと祭壇,さいだんとの間,あいだに二十五人,にんばかりの人,ひとが、主,しゅの宮,みやにその背中,せなかを向,むけ、顔,かおを東,ひがしに向,むけ、東,ひがしに向,むかって太陽,たいようを拝,おがんでいた。","tok":[["彼","かれ"],["は"],["また"],["わたし"],["を"],["連れて","つれて"],["、"],["主","しゅ"],["の"],["家","いえ"],["の"],["内庭","うちにわ"],["に"],["はいった"],["。"],["見よ","みよ"],["、"],["主","しゅ"],["の"],["宮","みや"],["の"],["入口","いりぐち"],["に"],["、"],["廊","ろう"],["と"],["祭壇","さいだん"],["と"],["の"],["間","あいだ"],["に"],["二十五人","にんばかり"],["の"],["人","ひと"],["が"],["、"],["主","しゅ"],["の"],["宮","みや"],["に"],["その"],["背中","せなか"],["を"],["向け","むけ"],["、"],["顔","かお"],["を"],["東","ひがし"],["に"],["向け","むけ"],["、"],["東","ひがし"],["に"],["向かって","むかって"],["太陽","たいよう"],["を"],["拝んで","おがんで"],["いた"],["。"]]},{"verse":17,"text":"時,ときに彼,かれはわたしに言,いわれた、「人,ひとの子,こよ、あなたはこれを見,みたか。ユダの家,いえにとって、彼,かれらがここでしているこれらの憎,にくむべきわざは軽,かるいことであるか。彼,かれらはこの地,ちを暴虐,ぼうぎゃくで満,みたし、さらにわたしを怒,いからせる。見,みよ、彼,かれらはその鼻,はなに木,きの枝,えだを置,おく。","tok":[["時","とき"],["に"],["彼","かれ"],["は"],["わたし"],["に"],["言われた","いわれた"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["は"],["これ"],["を"],["見た","みた"],["か"],["。"],["ユダ"],["の"],["家","いえ"],["にとって"],["、"],["彼","かれ"],["ら"],["が"],["ここ"],["でして"],["いる"],["これ"],["ら"],["の"],["憎むべき","にくむべき"],["わざ"],["は"],["軽い","かるい"],["こと"],["で"],["ある"],["か"],["。"],["彼","かれ"],["ら"],["は"],["この"],["地","ち"],["を"],["暴虐","ぼうぎゃく"],["で"],["満たし","みたし"],["、"],["さらに"],["わたし"],["を"],["怒らせる","いからせる"],["。"],["見よ","みよ"],["、"],["彼","かれ"],["ら"],["は"],["その"],["鼻","はな"],["に"],["木","き"],["の"],["枝","えだ"],["を"],["置く","おく"],["。"]]},{"verse":18,"text":"それゆえ、わたしも憤,いきどおって事,ことを行,おこなう。わたしの目,めは彼,かれらを惜,おしみ見,みず、またあわれまない。たとい彼,かれらがわたしの耳,みみに大声,おおごえで呼,よばわっても、わたしは彼,かれらの言,いうことを聞,きかない」。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["も"],["憤って","いきどおって"],["事","こと"],["を"],["行なう","おこなう"],["。"],["わたし"],["の"],["目","め"],["は"],["彼","かれ"],["ら"],["を"],["惜み","おしみ"],["見ず","みず"],["、"],["また"],["あわれまない"],["。"],["たとい"],["彼","かれ"],["ら"],["が"],["わたし"],["の"],["耳","みみ"],["に"],["大声","おおごえ"],["で"],["呼ばわって","よばわって"],["も"],["、"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["言う","いう"],["こと"],["を"],["聞かない","きかない"],["」"],["。"]]}]
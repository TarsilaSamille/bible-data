[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、あなたの顔,かおをセイル山,やまに向,むけ、これに対,たいして預言,よげんし、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["顔","かお"],["を"],["セイル山","せいるやま"],["に"],["向け","むけ"],["、"],["これ"],["に対して","にたいして"],["預言","よげん"],["し"],["、"]]},{"verse":3,"text":"これに言,いえ。主,しゅなる神,かみはこう言,いわれる、セイル山,やまよ、見,みよ、わたしはあなたを敵,てきとし、わたしの手,てをあなたに向,むかって伸,のべ、あなたを全,まったく荒,あらし、","tok":[["これ"],["に"],["言え","いえ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["セイル"],["山","やま"],["よ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["あなた"],["を"],["敵","てき"],["と"],["し"],["、"],["わたし"],["の"],["手","て"],["を"],["あなた"],["に"],["向かって","むかって"],["伸べ","のべ"],["、"],["あなた"],["を"],["全く","まったく"],["荒し","あらし"],["、"]]},{"verse":4,"text":"あなたの町々,まちまちを滅,ほろぼす。あなたは荒,あれはてる。そしてわたしが主,しゅであることを悟,さとる。","tok":[["あなた"],["の"],["町々","まちまち"],["を"],["滅ぼす","ほろぼす"],["。"],["あなた"],["は"],["荒れはてる","あれはてる"],["。"],["そして"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["。"]]},{"verse":5,"text":"あなたは限,かぎりない敵意,てきいをいだいて、イスラエルの人々,ひとびとをその災,わざわいの時,とき、終,おわりの刑罰,けいばつの時,ときに、つるぎの手,てに渡,わたした。","tok":[["あなた"],["は"],["限","かぎり"],["ない"],["敵意","てきい"],["を"],["いだいて"],["、"],["イスラエル"],["の"],["人々","ひとびと"],["を"],["その"],["災","わざわい"],["の"],["時","とき"],["、"],["終","おわり"],["の"],["刑罰","けいばつ"],["の"],["時","とき"],["に"],["、"],["つるぎ"],["の"],["手","て"],["に"],["渡","わたし"],["た"],["。"]]},{"verse":6,"text":"それゆえ、主,しゅなる神,かみは言,いわれる、わたしは生,いきている。わたしはあなたを血,ちにわたす。血,ちはあなたを追,おいかける。あなたには血,ちのとががあるゆえ、血,ちはあなたを追,おいかける","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["わたし"],["は"],["あなた"],["を"],["血","ち"],["に"],["わたす"],["。"],["血","ち"],["は"],["あなた"],["を"],["追いかける","おいかける"],["。"],["あなた"],["に"],["は"],["血","ち"],["の"],["とが"],["が"],["ある"],["ゆえ"],["、"],["血","ち"],["は"],["あなた"],["を"],["追いかける","おいかける"]]},{"verse":7,"text":"わたしはセイル山,やまを全,まったく荒,あらし、そこに行,ゆき来,きする者,ものを断,たち、","tok":[["わたし"],["は"],["セイル山","せいるやま"],["を"],["全く","まったく"],["荒し","あらし"],["、"],["そこ"],["に"],["行き来","ゆきき"],["する"],["者","もの"],["を"],["断ち","たち"],["、"]]},{"verse":8,"text":"その山々,やまやまを殺,ころされた者,もので満,みたす。つるぎで殺,ころされた者,ものが、あなたのもろもろの丘,おか、もろもろの谷,たに、もろもろのくぼ地,ちに倒,たおれる。","tok":[["その"],["山々","やまやま"],["を"],["殺ろされた","ころされた"],["者","もの"],["で"],["満たす","みたす"],["。"],["つるぎ"],["で"],["殺ろされた","ころされた"],["者","もの"],["が"],["、"],["あなた"],["の"],["もろもろ"],["の"],["丘","おか"],["、"],["もろもろ"],["の"],["谷","たに"],["、"],["もろもろ"],["の"],["くぼ地","くぼち"],["に"],["倒れる","たおれる"],["。"]]},{"verse":9,"text":"わたしはあなたを、永遠,えいえんの荒,あれ地,ちとし、あなたの町々,まちまちには住,すむ者,ものがなくなる。そしてあなたがたは、わたしが主,しゅであることを悟,さとる。","tok":[["わたし"],["は"],["あなた"],["を"],["、"],["永遠","えいえん"],["の"],["荒れ地","あれち"],["と"],["し"],["、"],["あなた"],["の"],["町々","まちまち"],["に"],["は"],["住む","すむ"],["者","もの"],["が"],["なくなる"],["。"],["そして"],["あなた"],["がた"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["。"]]},{"verse":10,"text":"あなたは言,いう、『これら二つの国民,こくみん、二つの国,くにはわたしのもの、われわれはこれを獲,えよう』と。しかし主,しゅはそこにおられる。","tok":[["あなた"],["は"],["言う","いう"],["、"],["『"],["これ"],["ら"],["二","ふた"],["つ"],["の"],["国民","こくみん"],["、"],["二","ふた"],["つ"],["の"],["国","くに"],["は"],["わたし"],["の"],["もの"],["、"],["われわれ"],["は"],["これ"],["を"],["獲よう","えよう"],["』"],["と"],["。"],["しかし"],["主","しゅ"],["は"],["そこ"],["に"],["おられる"],["。"]]},{"verse":11,"text":"それゆえ、主,しゅなる神,かみは言,いわれる、わたしは生,いきている。あなたが彼,かれらを憎,にくんで、彼,かれらに示,しめした怒,いかりと、ねたみにしたがって、わたしはあなたを扱,あつかう。わたしがあなたをさばく時,とき、わたし自身,じしんをあなたに示,しめす。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["あなた"],["が"],["彼","かれ"],["ら"],["を"],["憎んで","にくんで"],["、"],["彼","かれ"],["ら"],["に"],["示めした","しめした"],["怒り","いかり"],["と"],["、"],["ねたみ"],["に"],["したがって"],["、"],["わたし"],["は"],["あなた"],["を"],["扱う","あつかう"],["。"],["わたし"],["が"],["あなた"],["を"],["さばく"],["時","とき"],["、"],["わたし"],["自身","じしん"],["を"],["あなた"],["に"],["示めす","しめす"],["。"]]},{"verse":12,"text":"あなたがイスラエルの山々,やまやまに向,むかって、『これは荒,あれはてて、われわれの食,しょくとなる』と言,いったもろもろのそしりを、主,しゅなるわたしが聞,きいたことをあなたは悟,さとる。","tok":[["あなた"],["が"],["イスラエル"],["の"],["山々","やまやま"],["に"],["向かって","むかって"],["、"],["『"],["これ"],["は"],["荒れはてて","あれはてて"],["、"],["われわれ"],["の"],["食","しょく"],["と"],["なる"],["』"],["と"],["言った","いった"],["もろもろ"],["の"],["そ"],["しり"],["を"],["、"],["主","しゅ"],["なる"],["わたし"],["が"],["聞いた","きいた"],["こと"],["を"],["あなた"],["は"],["悟","さとる"],["。"]]},{"verse":13,"text":"あなたがたは、わたしに対,たいして口,くちをもって誇,ほこり、またわたしに対,たいして、あなたがたの言葉,ことばを多,おおくした。わたしはそれを聞,きいた。","tok":[["あなた"],["がた"],["は"],["、"],["わたし"],["に対して","にたいして"],["口","くち"],["を"],["もって"],["誇","ほこり"],["、"],["また"],["わたし"],["に対して","にたいして"],["、"],["あなた"],["がた"],["の"],["言葉","ことば"],["を"],["多く","おおく"],["した"],["。"],["わたし"],["は"],["それ"],["を"],["聞いた","きいた"],["。"]]},{"verse":14,"text":"主,しゅなる神,かみはこう言,いわれる、全,ぜん地,ちの喜,よろこびのために、わたしはあなたを荒,あれ地,ちとする。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["全地","ぜんち"],["の"],["喜こび","よろこび"],["の"],["ため"],["に"],["、"],["わたし"],["は"],["あなた"],["を"],["荒れ地","あれち"],["と"],["する"],["。"]]},{"verse":15,"text":"あなたが、イスラエルの家,いえの嗣,し業,ぎょうの荒,あれるのを喜,よろこんだように、わたしはあなたに、そのようにする。セイル山,やまよ、あなたは荒,あれ地,ちとなる。エドムもすべてそのようになる。そのとき彼,かれらは、わたしが主,しゅであることを悟,さとるようになる。","tok":[["あなた"],["が"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["嗣業","しぎょう"],["の"],["荒れる","あれる"],["の"],["を"],["喜こんだ","よろこんだ"],["よう"],["に"],["、"],["わたし"],["は"],["あなた"],["に"],["、"],["その"],["よう"],["に"],["する"],["。"],["セイル"],["山","やま"],["よ"],["、"],["あなた"],["は"],["荒れ地","あれち"],["と"],["なる"],["。"],["エドム"],["も"],["すべて"],["その"],["よう"],["に"],["なる"],["。"],["その"],["とき"],["彼","かれ"],["ら"],["は"],["、"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["よう"],["に"],["なる"],["。"]]}]
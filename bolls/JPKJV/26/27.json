"ぐんじん"],["、"],["あなた"],["の"],["中","なか"],["に"],["いる"],["すべて"],["の"],["仲間","なかま"],["は"],["皆","みな"],["、"],["あなた"],["の"],["破滅","はめつ"],["の"],["日","ひ"],["に"],["海","うみ"],["の"],["中","なか"],["に"],["沈む","しずむ"],["。"]]},{"verse":28,"text":"あなたのかじ取,とりの叫,さけび声,ごえに、近郷,きんごうは震,ふるい、","tok":[["あなた"],["の"],["かじ取","かじとり"],["の"],["叫声","さけびごえ"],["に"],["、"],["近郷","きんごう"],["は"],["震い","ふるい"],["、"]]},{"verse":29,"text":"すべてかいをとる者,ものは船,ふねからくだる。船員,せんいんおよび海,うみのすべてのかじ取,とりは海,うみべに立,たち、","tok":[["すべて"],["かい"],["を"],["とる"],["者","もの"],["は"],["船","ふね"],["から"],["くだる"],["。"],["船員","せんいん"],["および"],["海","うみ"],["の"],["すべて"],["の"],["かじ取","かじとり"],["は"],["海べ","うみべ"],["に"],["立ち","たち"],["、"]]},{"verse":30,"text":"あなたのために声,こえをあげて泣,なき、はげしく叫,さけび、ちりをこうべにかぶり、灰,はいの中,なかにまろび、","tok":[["あなた"],["の"],["ため"],["に"],["声","こえ"],["を"],["あげて"],["泣","なき"],["、"],["はげしく"],["叫","さけび"],["、"],["ちり"],["を"],["こうべ"],["に"],["かぶり"],["、"],["灰","はい"],["の"],["中","なか"],["に"],["まろび"],["、"]]},{"verse":31,"text":"あなたのために髪,かみをそり、荒布,あらぬのをまとい、あなたのために心,こころを痛,いためて泣,なき、はげしく嘆,なげく。","tok":[["あなた"],["の"],["ため"],["に"],["髪","かみ"],["を"],["そり"],["、"],["荒布","あらぬ"],["の"],["を"],["まとい"],["、"],["あなた"],["の"],["ため"],["に"],["心","こころ"],["を"],["痛めて","いためて"],["泣","なき"],["、"],["はげしく"],["嘆く","なげく"],["。"]]},{"verse":32,"text":"彼,かれらは悲,かなしんで、あなたのために悲,かなしみの歌,うたをのべ、あなたを弔,とむらって言,いう、『だれかツロのように海,うみの中,なかで滅,ほろびたものがあるか。","tok":[["彼","かれ"],["ら"],["は"],["悲しんで","かなしんで"],["、"],["あなた"],["の"],["ため"],["に"],["悲しみ","かなしみ"],["の"],["歌","うた"],["を"],["のべ"],["、"],["あなた"],["を"],["弔って","とむらって"],["言う","いう"],["、"],["『"],["だれ"],["か"],["ツロ"],["の"],["よう"],["に"],["海","うみ"],["の"],["中","なか"],["で"],["滅びた","ほろびた"],["もの"],["が"],["ある"],["か"],["。"]]},{"verse":33,"text":"あなたの商品,しょうひんが海,うみを越,こえてきた時,とき、あなたは多,おおくの民,たみを飽,あかせ、あなたの多,おおくの財宝,ざいほうと商品,しょうひんとをもって、地,ちの王,おうたちを富,とませた。","tok":[["あなた"],["の"],["商品","しょうひん"],["が"],["海","うみ"],["を"],["越えて","こえて"],["きた"],["時","とき"],["、"],["あなた"],["は"],["多く","おおく"],["の"],["民","たみ"],["を"],["飽かせ","あかせ"],["、"],["あなた"],["の"],["多く","おおく"],["の"],["財宝","ざいほう"],["と"],["商品","しょうひん"],["と"],["を"],["もって"],["、"],["地","ち"],["の"],["王","おう"],["たち"],["を"],["富ませた","とませた"],["。"]]},{"verse":34,"text":"今,いまあなたは海,うみで破船,はせんし、深,ふかい水,みずに沈,しずみ、あなたの商品,しょうひんと、あなたのすべての船員,せんいんとは、あなたと共,ともに沈,しずんだ。","tok":[["今","いま"],["あなた"],["は"],["海","うみ"],["で"],["破船","はせん"],["し"],["、"],["深","ふ"],["かい水","かいみず"],["に"],["沈み","しずみ"],["、"],["あなた"],["の"],["商品","しょうひん"],["と"],["、"],["あなた"],["の"],["すべて"],["の"],["船員","せんいん"],["と"],["は"],["、"],["あなた"],["と"],["共","とも"],["に"],["沈んだ","しずんだ"],["。"]]},{"verse":35,"text":"海沿,うみぞいの国々,くにぐにに住,すむ者,ものは皆,みなあなたについて驚,おどろき、その王,おうたちは大,おおいに恐,おそれてその顔,かおを震,ふるわす。","tok":[["海沿い","うみぞい"],["の"],["国々","くにぐに"],["に"],["住む","すむ"],["者","もの"],["は"],["皆","みな"],["あなた"],["について"],["驚","おどろき"],["、"],["その"],["王","おう"],["たち"],["は"],["大いに","おおいに"],["恐れて","おそれて"],["その"],["顔","かお"],["を"],["震わす","ふるわす"],["。"]]},{"verse":36,"text":"もろもろの民,たみの中,なかの商人,しょうにんらはあなたをあざける。あなたは恐,おそるべき終,おわりを遂,とげ、永遠,えいえんにうせはてる』」。","tok":[["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["の"],["商人","しょうにん"],["ら"],["は"],["あなた"],["を"],["あざける"],["。"],["あなた"],["は"],["恐るべき","おそるべき"],["終","おわり"],["を"],["遂げ","とげ"],["、"],["永遠","えいえん"],["に"],["うせ"],["はてる"],["』"],["」"],["。"]]}]
[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、ツロのために悲,かなしみの歌,うたをのべ、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["ツロ"],["の"],["ため"],["に"],["悲しみ","かなしみ"],["の"],["歌","うた"],["を"],["のべ"],["、"]]},{"verse":3,"text":"海,うみの入口,いりぐちに住,すんで、多,おおくの海沿,うみぞいの国々,くにぐにの民,たみの商人,しょうにんであるツロに対,たいして言,いえ、主,しゅなる神,かみはこう言,いわれる、ツロよ、あなたは言,いった、『わたしの美,びは完全,かんぜんである』と。","tok":[["海","うみ"],["の"],["入口","いりぐち"],["に"],["住んで","すんで"],["、"],["多く","おおく"],["の"],["海沿い","うみぞい"],["の"],["国々","くにぐに"],["の"],["民","たみ"],["の"],["商人","しょうにん"],["で"],["ある"],["ツロ"],["に対して","にたいして"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["ツロ"],["よ"],["、"],["あなた"],["は"],["言った","いった"],["、"],["『"],["わたし"],["の"],["美","び"],["は"],["完全","かんぜん"],["で"],["ある"],["』"],["と"],["。"]]},{"verse":4,"text":"あなたの境,さかいは海,うみの中,なかにあり、あなたの建設,けんせつ者,ものはあなたの美,びを完全,かんぜんにした。","tok":[["あなた"],["の"],["境","さかい"],["は"],["海","うみ"],["の"],["中","なか"],["に"],["あり"],["、"],["あなた"],["の"],["建設者","けんせつもの"],["は"],["あなた"],["の"],["美","び"],["を"],["完全","かんぜん"],["に"],["した"],["。"]]},{"verse":5,"text":"人々,ひとびとはセニルのもみの木,きであなたのために船板,ふないたを造,つくり、レバノンから香柏,こうはくをとって、あなたのために帆柱,ほばしらを造,つくり、","tok":[["人々","ひとびと"],["は"],["セニル"],["の"],["もみ"],["の"],["木","き"],["で"],["あなた"],["の"],["ため"],["に"],["船板","ふないた"],["を"],["造","つくり"],["、"],["レバノン"],["から"],["香","こう"],["柏","かしわ"],["を"],["とって"],["、"],["あなた"],["の"],["ため"],["に"],["帆柱","ほばしら"],["を"],["造","つくり"],["、"]]},{"verse":6,"text":"バシャンのかしの木,きで、あなたのためにかいを造,つくり、クプロの島,しまから来,くる松,まつの木,きに象牙,ぞうげをはめて、あなたのために甲板,かんぱんを造,つくった。","tok":[["バシャン"],["の"],["かし"],["の"],["木","き"],["で"],["、"],["あなた"],["の"],["ため"],["に"],["かい"],["を"],["造","つくり"],["、"],["クプロ"],["の"],["島","しま"],["から"],["来る","くる"],["松","まつ"],["の"],["木","き"],["に"],["象牙","ぞうげ"],["を"],["はめて"],["、"],["あなた"],["の"],["ため"],["に"],["甲板","かんぱん"],["を"],["造った","つくった"],["。"]]},{"verse":7,"text":"あなたの帆,ほはエジプトから来,くるあや布,ぬのであって、あなたの旗,はたに用,もちいられ、あなたのおおいはエリシャの海岸,かいがんから来,くる青,あおと紫,むらさきの布,ぬのである。","tok":[["あなた"],["の"],["帆","ほ"],["は"],["エジプト"],["から"],["来る","くる"],["あ"],["や"],["布","ぬの"],["で"],["あって"],["、"],["あなた"],["の"],["旗","はた"],["に"],["用いられ","もちいられ"],["、"],["あなた"],["の"],["おおい"],["は"],["エリシャ"],["の"],["海岸","かいがん"],["から"],["来る","くる"],["青","あお"],["と"],["紫","むらさき"],["の"],["布","ぬの"],["で"],["ある"],["。"]]},{"verse":8,"text":"あなたのこぎ手,ては、シドンとアルワデの住民,じゅうみん、あなたのかじとりは、あなたのうちにいる熟練,じゅくれんなゼメルの人々,ひとびとである。","tok":[["あなた"],["の"],["こぎ手","こぎて"],["は"],["、"],["シドン"],["と"],["アルワデ"],["の"],["住民","じゅうみん"],["、"],["あなた"],["の"],["かじとり"],["は"],["、"],["あなた"],["の"],["うち"],["に"],["いる"],["熟練","じゅくれん"],["な"],["ゼメル"],["の"],["人々","ひとびと"],["で"],["ある"],["。"]]},{"verse":9,"text":"ゲバルの老人,ろうじんたち、およびその熟練,じゅくれんな人々,ひとびとは、あなたのうちにいて漏,もりを繕,つくろい、海,うみのすべての船,ふねおよびその船員,せんいんらはあなたのうちにいて、あなたの商品,しょうひんを交易,こうえきする。","tok":[["ゲバル"],["の"],["老人","ろうじん"],["たち"],["、"],["および"],["その"],["熟練","じゅくれん"],["な"],["人々","ひとびと"],["は"],["、"],["あなた"],["の"],["うち"],["に"],["いて"],["漏り","もり"],["を"],["繕","つくろい"],["、"],["海","うみ"],["の"],["すべて"],["の"],["船","ふね"],["および"],["その"],["船員","せんいん"],["ら"],["は"],["あなた"],["の"],["うち"],["に"],["いて"],["、"],["あなた"],["の"],["商品","しょうひん"],["を"],["交易","こうえき"],["する"],["。"]]},{"verse":10,"text":"ペルシャ人,ひと、ルデびと、プテびとはあなたの軍,ぐんに加,くわわって、あなたの戦士,せんしとなる。彼,かれらはあなたのうちに、盾,たてとかぶとを掛,かけ、あなたに輝,かがやきをそえた。","tok":[["ペルシャ"],["人","ひと"],["、"],["ルデ"],["び"],["と"],["、"],["プテ"],["びと"],["は"],["あなた"],["の"],["軍","ぐん"],["に"],["加わわって","くわわって"],["、"],["あなた"],["の"],["戦士","せんし"],["と"],["なる"],["。"],["彼","かれ"],["ら"],["は"],["あなた"],["の"],["うち"],["に"],["、"],["盾","たて"],["と"],["かぶと"],["を"],["掛","かけ"],["、"],["あなた"],["に"],["輝やき","かがやき"],["を"],["そえた"],["。"]]},{"verse":11,"text":"アルワデとヘレクの人々,ひとびとは、あなたの周囲,しゅういの城壁,じょうへきの上,うえにあり、ガマデの人々,ひとびとは、あなたのやぐらの中,なかにあり、彼,かれらは、あなたの周囲,しゅういの城壁,じょうへきにその盾,たてを掛,かけて、あなたの美観,びかんを全,まっとうした。","tok":[["アルワデ"],["と"],["ヘレク"],["の"],["人々","ひとびと"],["は"],["、"],["あなた"],["の"],["周囲","しゅうい"],["の"],["城壁","じょうへき"],["の"],["上","うえ"],["に"],["あり"],["、"],["ガマデ"],["の"],["人々","ひとびと"],["は"],["、"],["あなた"],["の"],["やぐら"],["の"],["中","なか"],["に"],["あり"],["、"],["彼","かれ"],["ら"],["は"],["、"],["あなた"],["の"],["周囲","しゅうい"],["の"],["城壁","じょうへき"],["に"],["その"],["盾","たて"],["を"],["掛て","かけて"],["、"],["あなた"],["の"],["美観","びかん"],["を"],["全う","まっとう"],["した"],["。"]]},{"verse":12,"text":"あなたはそのすべての貨物,かもつに富,とむゆえに、タルシシはあなたと交易,こうえきをなし、銀,ぎん、鉄,てつ、すず、鉛,なまりをあなたの商品,しょうひんと交換,こうかんした。","tok":[["あなた"],["は"],["その"],["すべて"],["の"],["貨物","かもつ"],["に"],["富む","とむ"],["ゆえ"],["に"],["、"],["タルシシ"],["は"],["あなた"],["と"],["交易","こうえき"],["を"],["なし"],["、"],["銀","ぎん"],["、"],["鉄","てつ"],["、"],["すず"],["、"],["鉛","なまり"],["を"],["あなた"],["の"],["商品","しょうひん"],["と"],["交換","こうかん"],["した"],["。"]]},{"verse":13,"text":"ヤワン、トバル、およびメセクはあなたと取引,とりひきし、彼,かれらは人身,じんしんと青銅,せいどうの器,うつわとを、あなたの商品,しょうひんと交換,こうかんした。","tok":[["ヤワン"],["、"],["トバル"],["、"],["および"],["メセク"],["は"],["あなた"],["と"],["取引","とりひき"],["し"],["、"],["彼","かれ"],["ら"],["は"],["人身","じんしん"],["と"],["青銅","せいどう"],["の"],["器","うつわ"],["と"],["を"],["、"],["あなた"],["の"],["商品","しょうひん"],["と"],["交換","こうかん"],["した"],["。"]]},{"verse":14,"text":"ベテ・トガルマは馬,うま、軍馬,ぐんば、および騾馬,らばをあなたの商品,しょうひんと交換,こうかんした。","tok":[["ベテ"],["・"],["トガルマ"],["は"],["馬","うま"],["、"],["軍馬","ぐんば"],["、"],["および"],["騾馬","らば"],["を"],["あなた"],["の"],["商品","しょうひん"],["と"],["交換","こうかん"],["した"],["。"]]},{"verse":15,"text":"ローヅ島,とうの人々,ひとびとはあなたと取引,とりひきし、多,おおくの海沿,うみぞいの国々,くにぐには、あなたの市場,しじょうとなり、象牙,ぞうげと黒,くろたんとを、みつぎとしてあなたに持,もってきた。","tok":[["ローヅ"],["島","とう"],["の"],["人々","ひとびと"],["は"],["あなた"],["と"],["取引","とりひき"],["し"],["、"],["多く","おおく"],["の"],["海沿い","うみぞい"],["の"],["国々","くにぐに"],["は"],["、"],["あなた"],["の"],["市場","しじょう"],["と"],["なり"],["、"],["象牙","ぞうげ"],["と"],["黒","くろ"],["たん"],["と"],["を"],["、"],["みつぎ"],["として"],["あなた"],["に"],["持って","もって"],["きた"],["。"]]},{"verse":16,"text":"あなたの製品,せいひんが多,おおいので、エドムはあなたと商売,しょうばいし、彼,かれらは赤玉,あかだま、紫,むらさき、縫,ぬい取,とりの布,ぬの、細,ほそ布,ぬの、さんご、めのうをもって、あなたの商品,しょうひんと交換,こうかんした。","tok":[["あなた"],["の"],["製品","せいひん"],["が"],["多い","おおい"],["ので"],["、"],["エドム"],["は"],["あなた"],["と"],["商売","しょうばい"],["し"],["、"],["彼","かれ"],["ら"],["は"],["赤玉","あかだま"],["、"],["紫","むらさき"],["、"],["縫","ぬい"],["取","とり"],["の"],["布","ぬの"],["、"],["細布","ほそぬの"],["、"],["さんご"],["、"],["めのう"],["を"],["もって"],["、"],["あなた"],["の"],["商品","しょうひん"],["と"],["交換","こうかん"],["した"],["。"]]},{"verse":17,"text":"ユダとイスラエルの地,ちは、あなたと取引,とりひきし、麦,むぎ、オリブ、いちじく、蜜,みつ、油,あぶら、および乳香,にゅうこうをもって、あなたの商品,しょうひんと交換,こうかんした。","tok":[["ユダ"],["と"],["イスラエル"],["の"],["地","ち"],["は"],["、"],["あなた"],["と"],["取引","とりひき"],["し"],["、"],["麦","むぎ"],["、"],["オリブ"],["、"],["いちじく"],["、"],["蜜","みつ"],["、"],["油","あぶら"],["、"],["および"],["乳香","にゅうこう"],["を"],["もって"],["、"],["あなた"],["の"],["商品","しょうひん"],["と"],["交換","こうかん"],["した"],["。"]]},{"verse":18,"text":"あなたの製品,せいひんが多,おおく、あなたの富,とみが多,おおいので、ダマスコはあなたと取引,とりひきし、ヘルボンの酒,さけと、さらした羊毛,ようもうと、","tok":[["あなた"],["の"],["製品","せいひん"],["が"],["多く","おおく"],["、"],["あなた"],["の"],["富","とみ"],["が"],["多い","おおい"],["ので"],["、"],["ダマスコ"],["は"],["あなた"],["と"],["取引","とりひき"],["し"],["、"],["ヘルボン"],["の"],["酒","さけ"],["と"],["、"],["さらした"],["羊毛","ようもう"],["と"],["、"]]},{"verse":19,"text":"ウザルの酒,さけをもって、あなたの商品,しょうひんと交換,こうかんし、銑鉄,せんてつ、肉桂,にっけい、菖蒲,しょうぶをもって、あなたの商品,しょうひんと交易,こうえきした。","tok":[["ウザル"],["の"],["酒","さけ"],["を"],["もって"],["、"],["あなた"],["の"],["商品","しょうひん"],["と"],["交換","こうかん"],["し"],["、"],["銑鉄","せん"],["てつ"],["、"],["肉桂","に"],["っけ"],["い"],["、"],["菖蒲","しょうぶ"],["を"],["もって"],["、"],["あなた"],["の"],["商品","しょうひん"],["と"],["交易","こうえき"],["した"],["。"]]},{"verse":20,"text":"デダンは乗物,のりものの鞍,くら敷,しきをもって、あなたと取引,とりひきした。","tok":[["デダン"],["は"],["乗物","のりもの"],["の"],["鞍敷","くらしき"],["を"],["もって"],["、"],["あなた"],["と"],["取引","とりひき"],["した"],["。"]]},{"verse":21,"text":"アラビヤびと、およびケダルのすべての君,きみたちは小羊,こひつじ、雄羊,おひつじ、やぎをもって、あなたと取引,とりひきし、これらの物,ものをあなたと交易,こうえきした。","tok":[["アラビヤ"],["び"],["と"],["、"],["および"],["ケダル"],["の"],["すべて"],["の"],["君","きみ"],["たち"],["は"],["小羊","こひつじ"],["、"],["雄羊","おひつじ"],["、"],["やぎ"],["を"],["もって"],["、"],["あなた"],["と"],["取引","とりひき"],["し"],["、"],["これ"],["ら"],["の"],["物","もの"],["を"],["あなた"],["と"],["交易","こうえき"],["した"],["。"]]},{"verse":22,"text":"シバとラアマの商人,しょうにんは、あなたと取引,とりひきし、もろもろの尊,たっとい香料,こうりょうと、もろもろの宝石,ほうせきと金,きんとをもって、あなたの商品,しょうひんと交換,こうかんした。","tok":[["シバ"],["と"],["ラアマ"],["の"],["商人","しょうにん"],["は"],["、"],["あなた"],["と"],["取引","と
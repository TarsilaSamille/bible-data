[{"verse":1,"text":"われわれが捕,とらえ移,うつされてから二十五年,ねん、都,みやこが打,うち破,やぶられて後,のち十四年,ねん、その年,ねんの初,はじめの月,つきの十日,か、その日,ひに主,しゅの手,てがわたしに臨,のぞみ、わたしをかの所,ところに携,たずさえて行,いった。","tok":[["われわれ"],["が"],["捕らえ","とらえ"],["移されて","うつされて"],["から"],["二十五","にじゅうご"],["年","ねん"],["、"],["都","み"],["や"],["こ"],["が"],["打ち破られて","うちやぶられて"],["後","の"],["ち"],["十四","じゅうよん"],["年","ねん"],["、"],["その"],["年","ねん"],["の"],["初め","はじめ"],["の"],["月","つき"],["の"],["十日","か"],["、"],["その"],["日","ひ"],["に"],["主","しゅ"],["の"],["手","て"],["が"],["わたし"],["に"],["臨み","のぞみ"],["、"],["わたし"],["を"],["かの"],["所","ところ"],["に"],["携えて","たずさえて"],["行った","いった"],["。"]]},{"verse":2,"text":"すなわち神,かみは幻,まぼろしのうちに、わたしをイスラエルの地,ちに携,たずさえて行,いって、非常,ひじょうに高,たかい山,やまの上,うえにおろされた。その山,やまの上,うえに、わたしと相対,あいたいして、一つの町,まちのような建物,たてものがあった。","tok":[["すなわち"],["神","かみ"],["は"],["幻","まぼろし"],["の"],["うち"],["に"],["、"],["わたし"],["を"],["イスラエル"],["の"],["地","ち"],["に"],["携えて","たずさえて"],["行って","いって"],["、"],["非常","ひじょう"],["に"],["高い","たかい"],["山","やま"],["の"],["上","うえ"],["に"],["おろされた"],["。"],["その"],["山","やま"],["の"],["上","うえ"],["に"],["、"],["わたし"],["と"],["相対","あ"],["いたい"],["して"],["、"],["一","ひと"],["つ"],["の"],["町","まち"],["の"],["よう"],["な"],["建物","たてもの"],["が"],["あった"],["。"]]},{"verse":3,"text":"神,かみがわたしをそこに携,たずさえて行,いかれると、見,みよ、ひとりの人,ひとがいた。その姿,すがたは青銅,せいどうの形,かたちのようで、手,てに麻,あさのなわと、測,はかりざおとを持,もって門,もんに立,たっていた。","tok":[["神","かみ"],["が"],["わたし"],["を"],["そこ"],["に"],["携えて","たずさえて"],["行かれる","いかれる"],["と"],["、"],["見よ","みよ"],["、"],["ひとり"],["の"],["人","ひと"],["が"],["いた"],["。"],["その"],["姿","すがた"],["は"],["青銅","せいどう"],["の"],["形","かたち"],["の"],["よう"],["で"],["、"],["手","て"],["に"],["麻","あさ"],["の"],["なわ"],["と"],["、"],["測り","はかり"],["ざお"],["と"],["を"],["持って","もって"],["門","もん"],["に"],["立って","たって"],["いた"],["。"]]},{"verse":4,"text":"その人,ひとはわたしに言,いった、「人,ひとの子,こよ、目,めで見,み、耳,みみで聞,きき、わたしがあなたに示,しめす、すべての事,ことを心,こころにとめよ。あなたをここに携,たずさえて来,きたのは、これをあなたに示,しめすためである。あなたの見,みることを、ことごとくイスラエルの家,いえに告,つげよ」。","tok":[["その"],["人","ひと"],["は"],["わたし"],["に"],["言った","いった"],["、"],["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["目","め"],["で"],["見","み"],["、"],["耳","みみ"],["で"],["聞","きき"],["、"],["わたし"],["が"],["あなた"],["に"],["示めす","しめす"],["、"],["すべて"],["の"],["事","こと"],["を"],["心","こころ"],["に"],["とめよ"],["。"],["あなた"],["を"],["ここ"],["に"],["携えて","たずさえて"],["来た","きた"],["の"],["は"],["、"],["これ"],["を"],["あなた"],["に"],["示めす","しめす"],["ため"],["で"],["ある"],["。"],["あなた"],["の"],["見る","みる"],["こと"],["を"],["、"],["ことごとく"],["イスラエル"],["の"],["家","いえ"],["に"],["告","つげ"],["よ"],["」"],["。"]]},{"verse":5,"text":"見,みよ、宮,みやの外,そとの周囲,しゅういに、かきがあり、その人,ひとの手,てに六キュビトの測,はかりざおがあった。そのキュビトは、おのおの一キュビトと一,ひと手,て幅,はばとである。彼,かれが、そのかきの厚,あつさを測,はかると、一さおあり、高,たかさも一さおあった。","tok":[["見よ","みよ"],["、"],["宮","みや"],["の"],["外","そと"],["の"],["周囲","しゅうい"],["に"],["、"],["かき"],["が"],["あり"],["、"],["その"],["人","ひと"],["の"],["手","て"],["に"],["六","ろく"],["キュビト"],["の"],["測り","はかり"],["ざお"],["が"],["あった"],["。"],["その"],["キュビト"],["は"],["、"],["おのおの"],["一","いち"],["キュビト"],["と"],["一","ひ"],["と"],["手幅","てはば"],["と"],["で"],["ある"],["。"],["彼","かれ"],["が"],["、"],["その"],["かき"],["の"],["厚","あつ"],["さ"],["を"],["測る","はかる"],["と"],["、"],["一","いち"],["さ"],["おあり"],["、"],["高か","たか"],["さ"],["も"],["一","ひと"],["さお"],["あった"],["。"]]},{"verse":6,"text":"彼,かれが東,ひがし向,むきの門,もんに行,いき、その階段,かいだんを上,のぼって、門,もんの敷居,しきいを測,はかると、その厚,あつさは一さおあり、","tok":[["彼","かれ"],["が"],["東向き","ひがしむき"],["の"],["門","もん"],["に"],["行き","いき"],["、"],["その"],["階段","かいだん"],["を"],["上って","のぼって"],["、"],["門","もん"],["の"],["敷居","しきい"],["を"],["測る","はかる"],["と"],["、"],["その"],["厚","あつ"],["さ"],["は"],["一","いち"],["さ"],["おあり"],["、"]]},{"verse":7,"text":"その詰,つめ所,しょは長,ながさ一さお、幅,はば一さお、詰,つめ所,しょと、詰,つめ所,しょとの間,あいだは五キュビトあり、内,うちの門,もんの廊,ろうのかたわらの門,もんの敷居,しきいは一さおあった。","tok":[["その"],["詰所","つめしょ"],["は"],["長さ","ながさ"],["一","いち"],["さお"],["、"],["幅","はば"],["一","ひと"],["さお"],["、"],["詰所","つめしょ"],["と"],["、"],["詰所","つめしょ"],["と"],["の"],["間","あいだ"],["は"],["五","ご"],["キュビト"],["あり"],["、"],["内","うち"],["の"],["門","もん"],["の"],["廊","ろう"],["の"],["かたわら"],["の"],["門","もん"],["の"],["敷居","しきい"],["は"],["一","いち"],["さお"],["あった"],["。"]]},{"verse":8,"text":"門,もんの廊,ろうを測,はかると八キュビトあり、","tok":[["門","もん"],["の"],["廊","ろう"],["を"],["測る","はかる"],["と"],["八","はち"],["キュビト"],["あり"],["、"]]},{"verse":9,"text":"その脇,わき柱,ばしらは二キュビト、門,もんの廊,ろうは内側,うちがわにあった。","tok":[["その"],["脇柱","わきばしら"],["は"],["二","に"],["キュビト"],["、"],["門","もん"],["の"],["廊","ろう"],["は"],["内側","うちがわ"],["に"],["あった"],["。"]]},{"verse":10,"text":"東,ひがし向,むきの門,もんの詰,つめ所,しょは、こなたに三つ、かなたに三つあり、三つとも同,おなじ寸法,すんぽうである。脇,わき柱,ばしらもまた、こなたかなたともに同,おなじ寸法,すんぽうである。","tok":[["東向き","ひがしむき"],["の"],["門","もん"],["の"],["詰所","つめしょ"],["は"],["、"],["こなた"],["に"],["三","みっ"],["つ"],["、"],["かなた"],["に"],["三","みっ"],["つ"],["あり"],["、"],["三","みっ"],["つ"],["とも"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["ある"],["。"],["脇柱","わきばしら"],["も"],["また"],["、"],["こなた"],["か"],["な"],["た"],["とも"],["に"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["ある"],["。"]]},{"verse":11,"text":"門,もんの入口,いりぐちの広,ひろさを測,はかると十キュビトあり、門,もんの長,ながさは十三キュビトあった。","tok":[["門","もん"],["の"],["入口","いりぐち"],["の"],["広さ","ひろさ"],["を"],["測る","はかる"],["と"],["十","じゅう"],["キュビト"],["あり"],["、"],["門","もん"],["の"],["長さ","ながさ"],["は"],["十三","じゅうさん"],["キュビト"],["あった"],["。"]]},{"verse":12,"text":"詰,つめ所,しょの前,まえの境,さかいは一キュビト、かなたの境,さかいも一キュビトで、詰,つめ所,しょは、こなたかなたともに六キュビトあった。","tok":[["詰所","つめしょ"],["の"],["前","まえ"],["の"],["境","さかい"],["は"],["一","いち"],["キュビト"],["、"],["かなた"],["の"],["境","さかい"],["も"],["一","いち"],["キュビト"],["で"],["、"],["詰所","つめしょ"],["は"],["、"],["こなた"],["か"],["な"],["た"],["とも"],["に"],["六","ろく"],["キュビト"],["あった"],["。"]]},{"verse":13,"text":"彼,かれがまたこの詰,つめ所,しょの裏,うらから、かの詰,つめ所,しょの裏,うらまで、門,もんを測,はかると、入口,いりぐちから入口,いりぐちまで二十五キュビトあった。","tok":[["彼","かれ"],["が"],["また"],["この"],["詰所","つめしょ"],["の"],["裏","うら"],["から"],["、"],["かの"],["詰所","つめしょ"],["の"],["裏","うら"],["まで"],["、"],["門","もん"],["を"],["測る","はかる"],["と"],["、"],["入口","いりぐち"],["から"],["入口","いりぐち"],["まで"],["二十五","にじゅうご"],["キュビト"],["あった"],["。"]]},{"verse":14,"text":"彼,かれがまた廊,ろうを測,はかると二十キュビトあり、門,もんの廊,ろうの周囲,しゅういは、すべて庭,にわである。","tok":[["彼","かれ"],["が"],["また"],["廊","ろう"],["を"],["測る","はかる"],["と"],["二十","にじゅう"],["キュビト"],["あり"],["、"],["門","もん"],["の"],["廊","ろう"],["の"],["周囲","しゅうい"],["は"],["、"],["すべて"],["庭","にわ"],["で"],["ある"],["。"]]},{"verse":15,"text":"入口,いりぐちの門,もんの前,まえから内,うちの門,もんの廊,ろうの前,まえまで五十キュビトあり、","tok":[["入口","いりぐち"],["の"],["門","もん"],["の"],["前","まえ"],["から"],["内","うち"],["の"],["門","もん"],["の"],["廊","ろう"],["の"],["前","まえ"],["まで"],["五十","ごじゅう"],["キュビト"],["あり"],["、"]]},{"verse":16,"text":"詰,つめ所,しょと、門,もんの内側,うちがわの周囲,しゅういの脇,わき柱,ばしらとに窓,まどがあり、廊,ろうの内側,うちがわの周囲,しゅういにも、同様,どうように窓,まどがあり、脇,わき柱,ばしらには、しゅろがあった。","tok":[["詰所","つめしょ"],["と"],["、"],["門","もん"],["の"],["内側","うちがわ"],["の"],["周囲","しゅうい"],["の"],["脇柱","わきばしら"],["と"],["に"],["窓","まど"],["が"],["あり"],["、"],["廊","ろう"],["の"],["内側","うちがわ"],["の"],["周囲","しゅうい"],["に"],["も"],["、"],["同様","どうよう"],["に"],["窓","まど"],["が"],["あり"],["、"],["脇柱","わきばしら"],["に"],["は"],["、"],["しゅろ"],["が"],["あった"],["。"]]},{"verse":17,"text":"彼,かれがまたわたしを外,そと庭,にわに携,たずさえ入,いれると、見,みよ、庭,にわの周囲,しゅういに設,もうけた室,しつと、敷石,しきいしとがあり、敷石,しきいしの上,うえに三十の室,しつがあった。","tok":[["彼","かれ"],["が"],["また"],["わたし"],["を"],["外庭","そとにわ"],["に"],["携え","たずさえ"],["入れる","いれる"],["と"],["、"],["見よ","みよ"],["、"],["庭","にわ"],["の"],["周囲","しゅうい"],["に"],["設けた","もうけた"],["室","しつ"],["と"],["、"],["敷石","しきいし"],["と"],["が"],["あり"],["、"],["敷石","しきいし"],["の"],["上","うえ"],["に"],["三十","さんじゅう"],["の"],["室","しつ"],["が"],["あった"],["。"]]},{"verse":18,"text":"敷石,しきいしは門,もんのわきにあり、門,もんと同,おなじ長,ながさで、これは下,したの敷石,しきいしである。","tok":[["敷石","しきいし"],["は"],["門","もん"],["の"],["わき"],["に"],["あり"],["、"],["門","もん"],["と"],["同じ","おなじ"],["長さ","ながさ"],["で"],["、"],["これ"],["は"],["下","した"],["の"],["敷石","しきいし"],["で"],["ある"],["。"]]},{"verse":19,"text":"彼,かれが下,したの門,もんの内,うちの前,まえから、内庭,うちにわの外,そとの前,まえまでの距離,きょりを測,はかると、百キュビトあった。","tok":[["彼","かれ"],["が"],["下","した"],["の"],["門","もん"],["の"],["内","うち"],["の"],["前","まえ"],["から"],["、"],["内庭","うちにわ"],["の"],["外","そと"],["の"],["前","まえ"],["まで"],["の"],["距離","きょり"],["を"],["測る","はかる"],["と"],["、"],["百","ひゃく"],["キュビト"],["あった"],["。"]]},{"verse":20,"text":"また彼,かれはわたしに先,さきだって北,きたへ行,いった。見,みよ、そこに外,そと庭,にわに属,ぞくする北,きた向,むきの門,もんがあった。彼,かれはその長,ながさと幅,はばとを測,はかった。","tok":[["また"],["彼","かれ"],["は"],["わたし"],["に"],["先き","さき"],["だ"],["って"],["北","きた"],["へ"],["行った","いった"],["。"],["見よ","みよ"],["、"],["そこ"],["に"],["外庭","そとにわ"],["に"],["属する","ぞくする"],["北向き","きたむき"],["の"],["門","もん"],["が"],["あった"],["。"],["彼","かれ"],["は"],["その"],["長さ","ながさ"],["と"],["幅","はば"],["と"],["を"],["測った","はかった"],["。"]]},{"verse":21,"text":"その詰,つめ所,しょが、こなたに三つ、かなたに三つあり、また脇,わき柱,ばしらと廊,ろうとがあった。これらは初,はじめの門,もんと同,おなじ寸法,すんぽうで、長,ながさは五十キュビト、幅,はばは二十五キュビトである。","tok":[["その"],["詰所","つめしょ"],["が"],["、"],["こなた"],["に"],["三","みっ"],["つ"],["、"],["かなた"],["に"],["三","みっ"],["つ"],["あり"],["、"],["また"],["脇柱","わきばしら"],["と"],["廊","ろう"],["と"],["が"],["あった"],["。"],["これ"],["ら"],["は"],["初め","はじめ"],["の"],["門","もん"],["と"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["、"],["長さ","ながさ"],["は"],["五十","ごじゅう"],["キュビト"],["、"],["幅","はば"],["は"],["二十五","にじゅうご"],["キュビト"],["で"],["ある"],["。"]]},{"verse":22,"text":"その窓,まどと、廊,ろうと、しゅろとは、東,ひがし向,むきの門,もんにあるものと同,おなじ寸法,すんぽうである。そして七段,だんの階段,かいだんを経,へて、それに上,のぼると、廊,ろうは内側,うちがわにあった。","tok":[["その"],["窓","まど"],["と"],["、"],["廊","ろう"],["と"],["、"],["しゅろ"],["と"],["は"],["、"],["東向き","ひがしむき"],["の"],["門","もん"],["に"],["ある"],["もの"],["と"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["ある"],["。"],["そして"],["七","なな"],["段","だん"],["の"],["階段","かいだん"],["を"],["経て","へて"],["、"],["それ"],["に"],["上る","のぼる"],["と"],["、"],["廊","ろう"],["は"],["内側","うちがわ"],["に"],["あった"],["。"]]},{"verse":23,"text":"内庭,うちにわの門,もんは北,きたと東,ひがしの門,もんに向,むかっていた。彼,かれが門,もんから門,もんまでを測,はかると、百キュビトあった。","tok":[["内庭","うちにわ"],["の"],["門","もん"],["は"],["北","きた"],["と"],["東","ひがし"],["の"],["門","もん"],["に"],["向かって","むかって"],["いた"],["。"],["彼","かれ"],["が"],["門","もん"],["から"],["門","もん"],["まで"],["を"],["測る","はかる"],["と"],["、"],["百","ひゃく"],["キュビト"],["あった"],["。"]]},{"verse":24,"text":"彼,かれがまたわたしを南,みなみへ行,いかせると、見,みよ、南,みなみ向,むきの門,もんがあった。その脇,わき柱,ばしらと廊,ろうを測,はかると、他,ほかと同,おなじ寸法,すんぽうであった。","tok":[["彼","かれ"],["が"],["また"],["わたし"],["を"],["南","みなみ"],["へ"],["行かせる","いかせる"],["と"],["、"],["見よ","みよ"],["、"],["南向き","みなみむき"],["の"],["門","もん"],["が"],["あった"],["。"],["その"],["脇柱","わきばしら"],["と"],["廊","ろう"],["を"],["測る","はかる"],["と"],["、"],["他","ほか"],["と"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["あった"],["。"]]},{"verse":25,"text":"これと、その廊,ろうの周囲,しゅういとに、他,たの窓,まどのような窓,まどがあって、その長,ながさは五十キュビト、幅,はばは二十五キュビトあった。","tok":[["これ"],["と"],["、"],["その"],["廊","ろう"],["の"],["周囲","しゅうい"],["と"],["に"],["、"],["他","た"],["の"],["窓","まど"],["の"],["よう"],["な"],["窓","まど"],["が"],["あって"],["、"],["その"],["長さ","ながさ"],["は"],["五十","ごじゅう"],["キュビト"],["、"],["幅","はば"],["は"],["二十五","にじゅうご"],["キュビト"],["あった"],["。"]]},{"verse":26,"text":"これを上,のぼるのに七段,だんの階段,かいだんがあり、その廊,ろうは内側,うちがわにあった。その脇,わき柱,ばしらの上,うえには、こなたに一つ、かなたに一つのしゅろがあった。","tok":[["これ"],["を"],["上る","のぼる"],["のに"],["七","しち"],["段","だん"],["の"],["階段","かいだん"],["が"],["あり"],["、"],["その"],["廊","ろう"],["は"],["内側","うちがわ"],["に"],["あった"],["。"],["その"],["脇柱","わきばしら"],["の"],["上","うえ"],["に"],["は"],["、"],["こなた"],["に"],["一","ひと"],["つ"],["、"],["かなた"],["に"],["一","ひと"],["つ"],["の"],["しゅろ"],["が"],["あった"],["。"]]},{"verse":27,"text":"内庭,うちにわには南,みなみ向,むきの門,もんがあり、門,もんから門,もんまで南,みなみの方,ほうへ測,はかると、百キュビトあった。","tok":[["内庭","うちにわ"],["に"],["は"],["南向き","みなみむき"],["の"],["門","もん"],["が"],["あり"],["、"],["門","もん"],["から"],["門","もん"],["まで"],["南","みなみ"],["の"],["方","ほう"],["へ"],["測る","はかる"],["と"],["、"],["百","ひゃく"],["キュビト"],["あった"],["。"]]},{"verse":28,"text":"彼,かれがわたしを南,みなみの門,もんから内庭,うちにわにはいらせ、南,みなみの門,もんを測,はかると、さきのものと、同,おなじ寸法,すんぽうであった。","tok":[["彼","かれ"],["が"],["わたし"],["を"],["南","みなみ"],["の"],["門","もん"],["から"],["内庭","うちにわ"],["に"],["はいらせ"],["、"],["南","みなみ"],["の"],["門","もん"],["を"],["測る","はかる"],["と"],["、"],["さき"],["の"],["もの"],["と"],["、"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["あった"],["。"]]},{"verse":29,"text":"その詰,つめ所,しょと、脇,わき柱,ばしらと、廊,ろうとは、他,たのものと同,おなじ寸法,すんぽうで、その門,もんと、廊,ろうの周囲,しゅういとには窓,まどがあり、門,もんの長,ながさは五十キュビト、幅,はばは二十五キュビトであった。","tok":[["その"],["詰所","つめしょ"],["と"],["、"],["脇柱","わきばしら"],["と"],["、"],["廊","ろう"],["と"],["は"],["、"],["他","た"],["の"],["もの"],["と"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["、"],["その"],["門","もん"],["と"],["、"],["廊","ろう"],["の"],["周囲","しゅうい"],["と"],["に"],["は"],["窓","まど"],["が"],["あり"],["、"],["門","もん"],["の"],["長さ","ながさ"],["は"],["五十","ごじゅう"],["キュビト"],["、"],["幅","はば"],["は"],["二十五","にじゅうご"],["キュビト"],["で"],["あった"],["。"]]},{"verse":30,"text":"周囲,しゅういに廊,ろうがあって、その長,ながさは二十五キュビト、幅,はばは五キュビトである。","tok":[["周囲","しゅうい"],["に"],["廊","ろう"],["が"],["あって"],["、"],["その"],["長さ","ながさ"],["は"],["二十五","にじゅうご"],["キュビト"],["、"],["幅","はば"],["は"],["五","ご"],["キュビト"],["で"],["ある"],["。"]]},{"verse":31,"text":"その廊,ろうは外,そと庭,にわに面,めんして、脇,わき柱,ばしらの上,うえにしゅろがあり、その階段,かいだんは八段,だんであった。","tok":[["その"],["廊","ろう"],["は"],["外庭","そとにわ"],["に"],["面して","めんして"],["、"],["脇柱","わきばしら"],["の"],["上","うえ"],["に"],["しゅろ"],["が"],["あり"],["、"],["その"],["階段","かいだん"],["は"],["八","はち"],["段","だん"],["で"],["あった"],["。"]]},{"verse":32,"text":"彼,かれはまたわたしを内庭,うちにわの東,ひがしの方,ほうに携,たずさえて行,いって、門,もんを測,はかった。それは他,ほかと同,おなじ寸法,すんぽうであった。","tok":[["彼","かれ"],["は"],["また"],["わたし"],["を"],["内庭","うちにわ"],["の"],["東","ひがし"],["の"],["方","ほう"],["に"],["携えて","たずさえて"],["行って","いって"],["、"],["門","もん"],["を"],["測った","はかった"],["。"],["それ"],["は"],["他","ほか"],["と"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["あった"],["。"]]},{"verse":33,"text":"その詰,つめ所,しょと、脇,わき柱,ばしらと、廊,ろうとは、他,ほかと同,おなじ寸法,すんぽうで、その門,もんと、その廊,ろうの周囲,しゅういとに窓,まどがあり、門,もんの長,ながさは五十キュビト、幅,はばは二十五キュビトである。","tok":[["その"],["詰所","つめしょ"],["と"],["、"],["脇柱","わきばしら"],["と"],["、"],["廊","ろう"],["と"],["は"],["、"],["他","ほか"],["と"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["、"],["その"],["門","もん"],["と"],["、"],["その"],["廊","ろう"],["の"],["周囲","しゅうい"],["と"],["に"],["窓","まど"],["が"],["あり"],["、"],["門","もん"],["の"],["長さ","ながさ"],["は"],["五十","ごじゅう"],["キュビト"],["、"],["幅","はば"],["は"],["二十五","にじゅうご"],["キュビト"],["で"],["ある"],["。"]]},{"verse":34,"text":"その廊,ろうは外,そと庭,にわに面,めんし、その脇,わき柱,ばしらの上,うえには、こなたかなたに、しゅろがあり、その階段,かいだんは八段,だんであった。","tok":[["その"],["廊","ろう"],["は"],["外庭","そとにわ"],["に"],["面し","めんし"],["、"],["その"],["脇柱","わきばしら"],["の"],["上","うえ"],["に"],["は"],["、"],["こなた"],["かなた"],["に"],["、"],["しゅろ"],["が"],["あり"],["、"],["その"],["階段","かいだん"],["は"],["八","はち"],["段","だん"],["で"],["あった"],["。"]]},{"verse":35,"text":"彼,かれがまたわたしを北,きたの門,もんに携,たずさえて行,いって、これを測,はかると、それは他,ほかと同,おなじ寸法,すんぽうであった。","tok":[["彼","かれ"],["が"],["また"],["わたし"],["を"],["北","きた"],["の"],["門","もん"],["に"],["携えて","たずさえて"],["行って","いって"],["、"],["これ"],["を"],["測る","はかる"],["と"],["、"],["それ"],["は"],["他","ほか"],["と"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["あった"],["。"]]},{"verse":36,"text":"その詰,つめ所,しょと、脇,わき柱,ばしらと、廊,ろうとは、他,ほかと同,おなじ寸法,すんぽうで、その周囲,しゅういに窓,まどがあり、門,もんの長,ながさは五十キュビト、幅,はばは二十五キュビトである。","tok":[["その"],["詰所","つめしょ"],["と"],["、"],["脇柱","わきばしら"],["と"],["、"],["廊","ろう"],["と"],["は"],["、"],["他","ほか"],["と"],["同じ","おなじ"],["寸法","すんぽう"],["で"],["、"],["その"],["周囲","しゅうい"],["に"],["窓","まど"],["が"],["あり"],["、"],["門","もん"],["の"],["長さ","ながさ"],["は"],["五十","ごじゅう"],["キュビト"],["、"],["幅","はば"],["は"],["二十五","にじゅうご"],["キュビト"],["で"],["ある"],["。"]]},{"verse":37,"text":"その廊,ろうは外,そと庭,にわに面,めんし、その脇,わき柱,ばしらの上,うえには、こなたかなたに、しゅろがあり、その階段,かいだんは八段,だんであった。","tok":[["その"],["廊","ろう"],["は"],["外庭","そとにわ"],["に"],["面し","めんし"],["、"],["その"],["脇柱","わきばしら"],["の"],["上","うえ"],["に"],["は"],["、"],["こなた"],["かなた"],["に"],["、"],["しゅろ"],["が"],["あり"],["、"],["その"],["階段","かいだん"],["は"],["八","はち"],["段","だん"],["で"],["あった"],["。"]]},{"verse":38,"text":"門,もんの廊,ろうに戸,とのある室,しつがあって、そこは燔祭,はんさいの物,ものを洗,あらう所,ところである。","tok":[["門","もん"],["の"],["廊","ろう"],["に"],["戸","と"],["の"],["ある"],["室","しつ"],["が"],["あって"],["、"],["そこ"],["は"],["燔祭","はんさい"],["の"],["物","もの"],["を"],["洗う","あらう"],["所","ところ"],["で"],["ある"],["。"]]},{"verse":39,"text":"門,もんの廊,ろうに、こなたに二つの台,だい、かなたに二つの台,だいがあり、その上,うえで、燔祭,はんさい、罪祭,ざいさい、愆祭,けんさいの物,ものをほふるのであった。","tok":[["門","もん"],["の"],["廊","ろう"],["に"],["、"],["こなた"],["に"],["二","ふた"],["つ"],["の"],["台","だい"],["、"],["かなた"],["に"],["二","ふた"],["つ"],["の"],["台","だい"],["が"],["あり"],["、"],["その"],["上","うえ"],["で"],["、"],["燔祭","はんさい"],["、"],["罪","つみ"],["祭","まつり"],["い"],["さい"],["、"],["愆祭","けんさい"],["の"],["物","もの"],["を"],["ほふる"],["ので"],["あった"],["。"]]},{"verse":40,"text":"北,きたの門,もんの入口,いりぐちにある廊,ろうの外,そとの片側,かたがわに、二つの台,だいがあり、門,もんの廊,ろうの他,たの側,がわにも、二つの台,だいがあり、","tok":[["北","きた"],["の"],["門","もん"],["の"],["入口","いりぐち"],["に"],["ある"],["廊","ろう"],["の"],["外","そと"],["の"],["片側","かたがわ"],["に"],["、"],["二","ふた"],["つ"],["の"],["台","だい"],["が"],["あり"],["、"],["門","もん"],["の"],["廊","ろう"],["の"],["他","た"],["の"],["側","がわ"],["に"],["も"],["、"],["二","ふた"],["つ"],["の"],["台","だい"],["が"],["あり"],["、"]]},{"verse":41,"text":"門,もんのかたわら、内側,うちがわに四つの台,だい、外側,そとがわに四つの台,だいがあって、合,あわせて八つの台,だいである。その上,うえで、犠牲,ぎせいの物,ものをほふるのである。","tok":[["門","もん"],["の"],["かたわら"],["、"],["内側","うちがわ"],["に"],["四","よん"],["つ"],["の"],["台","だい"],["、"],["外側","そとがわ"],["に"],["四","よん"],["つ"],["の"],["台","だい"],["が"],["あって"],["、"],["合","あわせ"],["て"],["八","よう"],["つ"],["の"],["台","だい"],["で"],["ある"],["。"],["その"],["上","うえ"],["で"],["、"],["犠牲","ぎせい"],["の"],["物","もの"],["を"],["ほふる"],["ので"],["ある"],["。"]]},{"verse":42,"text":"そこにまた燔祭,はんさいのために四つの切,きり石,いしの台,だいがあり、その長,ながさは一キュビト半,はん、幅,はばは一キュビト半,はん、高,たかさは一キュビト、その上,うえに燔祭,はんさいおよび犠牲,ぎせいをほふる器,うつわを置,おくのである。","tok":[["そこ"],["に"],["また"],["燔祭","はんさい"],["の"],["ため"],["に"],["四","よん"],["つ"],["の"],["切り石","きりいし"],["の"],["台","だい"],["が"],["あり"],["、"],["その"],["長さ","ながさ"],["は"],["一","いち"],["キュビト"],["半","はん"],["、"],["幅","はば"],["は"],["一","いち"],["キュビト"],["半","はん"],["、"],["高か","たか"],["さ"],["は"],["一","いち"],["キュビト"],["、"],["その"],["上","うえ"],["に"],["燔祭","はんさい"],["および"],["犠牲","ぎせい"],["を"],["ほふる"],["器","うつわ"],["を"],["置く","おく"],["ので"],["ある"],["。"]]},{"verse":43,"text":"内,うちの周囲,しゅういに、一,ひと手,て幅,はばの折,おり釘,くぎが打,うちつけてあって、供,そなえ物,ものの肉,にくは、台,だいの上,うえに置,おかれるのである。","tok":[["内","うち"],["の"],["周囲","しゅうい"],["に"],["、"],["一","ひ"],["と"],["手幅","てはば"],["の"],["折","おり"],["釘","くぎ"],["が"],["打ちつけて","うちつけて"],["あって"],["、"],["供え物","そなえもの"],["の"],["肉","にく"],["は"],["、"],["台","だい"],["の"],["上","うえ"],["に"],["置かれる","おかれる"],["ので"],["ある"],["。"]]},{"verse":44,"text":"彼,かれはまたわたしを、外,そとから内庭,うちにわに連,つれてはいった。見,みよ、内庭,うちにわに二つの室,しつがあり、一つは北,きたの門,もんのかたわらにあって南,みなみに向,むかい、一つは南,みなみの門,もんのかたわらにあって、北,きたに向,むかっていた。","tok":[["彼","かれ"],["は"],["また"],["わたし"],["を"],["、"],["外","そと"],["から"],["内庭","うちにわ"],["に"],["連れて","つれて"],["は"],["いった"],["。"],["見よ","みよ"],["、"],["内庭","うちにわ"],["に"],["二","ふた"],["つ"],["の"],["室","しつ"],["が"],["あり"],["、"],["一","ひと"],["つ"],["は"],["北","きた"],["の"],["門","もん"],["の"],["かたわら"],["に"],["あって"],["南","みなみ"],["に"],["向","むかい"],["、"],["一","ひと"],["つ"],["は"],["南","みなみ"],["の"],["門","もん"],["の"],["かたわら"],["に"],["あって"],["、"],["北","きた"],["に"],["向かって","むかって"],["いた"],["。"]]},{"verse":45,"text":"彼,かれはわたしに言,いった、この南,みなみ向,むきの室,しつは、宮,みやを守,まもる祭司,さいしのためのもの、","tok":[["彼","かれ"],["は"],["わたし"],["に"],["言った","いった"],["、"],["この"],["南向き","みなみむき"],["の"],["室","しつ"],["は"],["、"],["宮","みや"],["を"],["守","まもる"],["祭司","さいし"],["の"],["ため"],["の"],["もの"],["、"]]},{"verse":46,"text":"また北,きた向,むきの室,しつは、祭壇,さいだんを守,まもる祭司,さいしのためのものである。その人,ひとたちは、レビの子孫,しそんのうちのザドクの子孫,しそんであって、主,しゅに近,ちかく仕,つかえる者,ものたちである。","tok":[["また"],["北向き","きたむき"],["の"],["室","しつ"],["は"],["、"],["祭壇","さいだん"],["を"],["守","まもる"],["祭司","さいし"],["の"],["ため"],["の"],["もの"],["で"],["ある"],["。"],["その"],["人","ひと"],["たち"],["は"],["、"],["レビ"],["の"],["子孫","しそん"],["の"],["うち"],["の"],["ザドク"],["の"],["子孫","しそん"],["で"],["あって"],["、"],["主に","しゅに"],["近く","ちかく"],["仕える","つかえる"],["者","もの"],["たち"],["で"],["ある"],["。"]]},{"verse":47,"text":"そして彼,かれが庭,にわを測,はかると、その長,ながさは百キュビト、幅,はばも百キュビトで四角,かくである。宮,みやの前,まえには祭壇,さいだんがあった。","tok":[["そして"],["彼","かれ"],["が"],["庭","にわ"],["を"],["測る","はかる"],["と"],["、"],["その"],["長さ","ながさ"],["は"],["百","ひゃく"],["キュビト"],["、"],["幅","はば"],["も"],["百","ひゃく"],["キュビト"],["で"],["四角くで","かくで"],["ある"],["。"],["宮","みや"],["の"],["前","まえ"],["に"],["は"],["祭壇","さいだん"],["が"],["あった"],["。"]]},{"verse":48,"text":"彼,かれがわたしを宮,みやの廊,ろうに連,つれて行,いって、廊,ろうの脇,わき柱,ばしらを測,はかると、こなたも五キュビト、かなたも五キュビトであり、門,もんの幅,はばは十四キュビトである。門,もんの壁,かべは、こなたも三キュビト、かなたも三キュビトである。","tok":[["彼","かれ"],["が"],["わたし"],["を"],["宮","みや"],["の"],["廊","ろう"],["に"],["連れて","つれて"],["行って","いって"],["、"],["廊","ろう"],["の"],["脇柱","わきばしら"],["を"],["測る","はかる"],["と"],["、"],["こなた"],["も"],["五","ご"],["キュビト"],["、"],["かなた"],["も"],["五","ご"],["キュビト"],["で"],["あり"],["、"],["門","もん"],["の"],["幅","はば"],["は"],["十四","じゅうよん"],["キュビト"],["で"],["ある"],["。"],["門","もん"],["の"],["壁","かべ"],["は"],["、"],["こなた"],["も"],["三","さん"],["キュビト"],["、"],["かなた"],["も"],["三","さん"],["キュビト"],["で"],["ある"],["。"]]},{"verse":49,"text":"廊,ろうの長,ながさは二十キュビト、幅,はばは十二キュビトであり、十の階段,かいだんによって上,のぼるのである。脇,わき柱,ばしらに沿,そって、こなたに一つ、かなたに一つの柱,はしらがあった。","tok":[["廊","ろう"],["の"],["長さ","ながさ"],["は"],["二十","にじゅう"],["キュビト"],["、"],["幅","はば"],["は"],["十二","じゅうに"],["キュビト"],["で"],["あり"],["、"],["十","じゅう"],["の"],["階段","かいだん"],["によって"],["上る","のぼる"],["ので"],["ある"],["。"],["脇柱","わきばしら"],["に"],["沿って","そって"],["、"],["こなた"],["に"],["一","ひと"],["つ"],["、"],["かなた"],["に"],["一","ひと"],["つ"],["の"],["柱","はしら"],["が"],["あった"],["。"]]}]
[{"verse":1,"text":"主,しゅの言葉,ことばが、わたしに臨,のぞんで言,いった、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["、"],["わたし"],["に"],["臨んで","のぞんで"],["言った","いった"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、あなたの顔,かおをイスラエルの山々,やまやまに向,むけ、預言,よげんして、","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["あなた"],["の"],["顔","かお"],["を"],["イスラエル"],["の"],["山々","やまやま"],["に"],["向け","むけ"],["、"],["預言","よげん"],["して"],["、"]]},{"verse":3,"text":"言,いえ。イスラエルの山々,やまやまよ、主,しゅなる神,かみの言葉,ことばを聞,きけ。主,しゅなる神,かみは山,やまと丘,おかと、谷,たにと川,かわに向,むかって、こう言,いわれる、見,みよ、わたしはつるぎをあなたがたに送,おくり、あなたがたの高,たかき所,ところを滅,ほろぼす。","tok":[["言え","いえ"],["。"],["イスラエル"],["の"],["山々","やまやま"],["よ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"],["主","しゅ"],["なる"],["神","かみ"],["は"],["山","やま"],["と"],["丘","おか"],["と"],["、"],["谷","たに"],["と"],["川","かわ"],["に"],["向かって","むかって"],["、"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["つるぎ"],["を"],["あなた"],["がた"],["に"],["送り","おくり"],["、"],["あなた"],["がた"],["の"],["高き","たかき"],["所","ところ"],["を"],["滅ぼす","ほろぼす"],["。"]]},{"verse":4,"text":"あなたがたの祭壇,さいだんは荒,あらされ、あなたがたの香,こうの祭壇,さいだんはこわされる。わたしはあなたがたの偶像,ぐうぞうの前,まえに、あなたがたの殺,ころされた者,ものを投,なげ出,だす。","tok":[["あなた"],["がた"],["の"],["祭壇","さいだん"],["は"],["荒され","あらされ"],["、"],["あなた"],["がた"],["の"],["香","こう"],["の"],["祭壇","さいだん"],["は"],["こわされる"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["偶像","ぐうぞう"],["の"],["前","まえ"],["に"],["、"],["あなた"],["がた"],["の"],["殺ろされた","ころされた"],["者","もの"],["を"],["投出す","なげだす"],["。"]]},{"verse":5,"text":"わたしはイスラエルの民,たみの死体,したいを彼,かれらの偶像,ぐうぞうの前,まえに置,おき、骨,ほねをあなたがたの祭壇,さいだんのまわりに散,ちらす。","tok":[["わたし"],["は"],["イスラエル"],["の"],["民","たみ"],["の"],["死体","したい"],["を"],["彼","かれ"],["ら"],["の"],["偶像","ぐうぞう"],["の"],["前","まえ"],["に"],["置き","おき"],["、"],["骨","ほね"],["を"],["あなた"],["がた"],["の"],["祭壇","さいだん"],["の"],["まわり"],["に"],["散らす","ちらす"],["。"]]},{"verse":6,"text":"すべてあなたがたの住,すむ所,ところで町々,まちまちは滅,ほろぼされ、高,たかき所,ところは荒,あらされる。こうしてあなたがたの祭壇,さいだんはこわし荒,あらされ、あなたがたの偶像,ぐうぞうは砕,くだかれて滅,ほろび、あなたがたの香,こうの祭壇,さいだんは倒,たおされ、あなたがたのわざは消,けし去,さられる。","tok":[["すべて"],["あなた"],["がた"],["の"],["住む","すむ"],["所","ところ"],["で"],["町々","まちまち"],["は"],["滅ぼされ","ほろぼされ"],["、"],["高き","たかき"],["所","ところ"],["は"],["荒される","あらされる"],["。"],["こう"],["して"],["あなた"],["がた"],["の"],["祭壇","さいだん"],["は"],["こわし"],["荒され","あらされ"],["、"],["あなた"],["がた"],["の"],["偶像","ぐうぞう"],["は"],["砕かれて","くだかれて"],["滅び","ほろび"],["、"],["あなた"],["がた"],["の"],["香","こう"],["の"],["祭壇","さいだん"],["は"],["倒され","たおされ"],["、"],["あなた"],["がた"],["の"],["わざ"],["は"],["消し去られる","けしさられる"],["。"]]},{"verse":7,"text":"また殺,ころされた者,ものはあなたがたのうちに倒,たおれる。これによって、あなたがたはわたしが主,しゅであることを知,しるようになる。","tok":[["また"],["殺ろされた","ころされた"],["者","もの"],["は"],["あなた"],["がた"],["の"],["うち"],["に"],["倒れる","たおれる"],["。"],["これ"],["によって"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["。"]]},{"verse":8,"text":"わたしは、あなたがたのある者,ものを生,いかしておく。あなたがたが、つるぎをのがれて国々,くにぐにの中,なかにおり、国々,くにぐにに散,ちらされる時,とき、","tok":[["わたし"],["は"],["、"],["あなた"],["がた"],["の"],["ある"],["者","もの"],["を"],["生かして","いかして"],["おく"],["。"],["あなた"],["が"],["た"],["が"],["、"],["つるぎ"],["を"],["のがれて"],["国々","くにぐに"],["の"],["中","なか"],["に"],["おり"],["、"],["国々","くにぐに"],["に"],["散らされる","ちらされる"],["時","とき"],["、"]]},{"verse":9,"text":"あなたがたのうちののがれた者,ものは、その捕,とらえ移,うつされた国々,くにぐにの中,なかでわたしを思,おもい出,だす。これはわたしが、彼,かれらのわたしを離,はなれた姦淫,かんいんの心,こころと、偶像,ぐうぞうを慕,したって姦淫,かんいんを行,おこなう目,めをくじくからである。そして彼,かれらはそのもろもろの憎,にくむべきことと、その犯,おかした悪,あくのために、みずからをいとうようになる。","tok":[["あなた"],["がた"],["の"],["うち"],["の"],["のがれた"],["者","もの"],["は"],["、"],["その"],["捕らえ","とらえ"],["移された","うつされた"],["国々","くにぐに"],["の"],["中","なか"],["で"],["わたし"],["を"],["思い出す","おもいだす"],["。"],["これ"],["は"],["わたし"],["が"],["、"],["彼","かれ"],["ら"],["の"],["わたし"],["を"],["離れた","はなれた"],["姦淫","かんいん"],["の"],["心","こころ"],["と"],["、"],["偶像","ぐうぞう"],["を"],["慕って","したって"],["姦淫","かんいん"],["を"],["行なう","おこなう"],["目","め"],["を"],["くじく"],["から"],["で"],["ある"],["。"],["そして"],["彼","かれ"],["ら"],["は"],["その"],["もろもろ"],["の"],["憎むべき","にくむべき"],["こと"],["と"],["、"],["その"],["犯した","おかした"],["悪","あく"],["の"],["ため"],["に"],["、"],["みずから"],["を"],["いとう"],["よう"],["に"],["なる"],["。"]]},{"verse":10,"text":"そして彼,かれらはわたしが主,しゅであることを知,しる。この災,わざわいを彼,かれらに対,たいして下,くだすと、わたしが言,いったのは決,けっしてむなしい事,ことではない」。","tok":[["そして"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["。"],["この"],["災","わざわい"],["を"],["彼","かれ"],["ら"],["に対して","にたいして"],["下す","くだす"],["と"],["、"],["わたし"],["が"],["言った","いった"],["の"],["は"],["決っして","けっして"],["むなしい"],["事","こと"],["で"],["は"],["ない"],["」"],["。"]]},{"verse":11,"text":"主,しゅなる神,かみはこう言,いわれる、「あなたは手,てを打,うち、足,あしを踏,ふみならして言,いえ。ああ、イスラエルの家,いえのすべての悪,あしき憎,にくむべき者,ものはわざわいだ。彼,かれらはつるぎと、ききんと、疫病,えきびょうに倒,たおれるからである。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["「"],["あなた"],["は"],["手","て"],["を"],["打ち","うち"],["、"],["足","あし"],["を"],["踏みならして","ふみならして"],["言え","いえ"],["。"],["ああ"],["、"],["イスラエル"],["の"],["家","いえ"],["の"],["すべて"],["の"],["悪しき","あしき"],["憎むべき","にくむべき"],["者","もの"],["は"],["わざわい"],["だ"],["。"],["彼","かれ"],["ら"],["は"],["つるぎ"],["と"],["、"],["ききん"],["と"],["、"],["疫病","えきびょう"],["に"],["倒れる","たおれる"],["から"],["で"],["ある"],["。"]]},{"verse":12,"text":"遠,とおくにいる者,ものは疫病,えきびょうで死,しに、近,ちかくにいる者,ものはつるぎに倒,たおれる。生,いき残,のこって身,みを全,まっとうする者,ものはききんによって死,しぬ。このようにわたしはわが憤,いきどおりを彼,かれらの上,うえに漏,もらし尽,つくす。","tok":[["遠く","とおく"],["に"],["いる"],["者","もの"],["は"],["疫病","え"],["き"],["びょう"],["で"],["死に","しに"],["、"],["近く","ちかく"],["に"],["いる"],["者","もの"],["は"],["つるぎ"],["に"],["倒れる","たおれる"],["。"],["生き残って","いきのこって"],["身","み"],["を"],["全う","まっとう"],["する"],["者","もの"],["は"],["ききん"],["によって"],["死ぬ","しぬ"],["。"],["この"],["よう"],["に"],["わたし"],["は"],["わが"],["憤り","いきどおり"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["漏らし","もらし"],["尽くす","つくす"],["。"]]},{"verse":13,"text":"彼,かれらの殺,ころされる者,ものがその偶像,ぐうぞうの中,なかにあり、その祭壇,さいだんのまわりにあり、すべての高,たかき丘,おかの上,うえにあり、すべての山,やまの頂,いただきにあり、すべての青,あお木,きの下,したにあり、すべての茂,しげったかしの木,きの下,したにあり、彼,かれらがこうばしいかおりを、すべての偶像,ぐうぞうにささげた所,ところにある時,とき、あなたがたはわたしが主,しゅであることを知,しるのである。","tok":[["彼","かれ"],["ら"],["の"],["殺ろされる","ころされる"],["者","もの"],["が"],["その"],["偶像","ぐうぞう"],["の"],["中","なか"],["に"],["あり"],["、"],["その"],["祭壇","さいだん"],["の"],["まわり"],["に"],["あり"],["、"],["すべて"],["の"],["高き","たかき"],["丘","おか"],["の"],["上","うえ"],["に"],["あり"],["、"],["すべて"],["の"],["山","やま"],["の"],["頂","いただき"],["に"],["あり"],["、"],["すべて"],["の"],["青木","あおき"],["の"],["下","した"],["に"],["あり"],["、"],["すべて"],["の"],["茂った","しげった"],["かし"],["の"],["木","き"],["の"],["下","した"],["に"],["あり"],["、"],["彼","かれ"],["ら"],["が"],["こうばしい"],["かおり"],["を"],["、"],["すべて"],["の"],["偶像","ぐうぞう"],["に"],["ささげた"],["所","ところ"],["に"],["ある"],["時","とき"],["、"],["あなた"],["がた"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["ので"],["ある"],["。"]]},{"verse":14,"text":"わたしはまた手,てを彼,かれらの上,うえに伸,のべて、その地,ちを荒,あらし、すべて彼,かれらの住,すむ所,ところを、荒野,あらのからリブラまで荒,あれ地,ちとする。これによって彼,かれらはわたしが主,しゅであることを知,しるようになる」。","tok":[["わたし"],["は"],["また"],["手","て"],["を"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["伸べて","のべて"],["、"],["その"],["地","ち"],["を"],["荒し","あらし"],["、"],["すべて"],["彼","かれ"],["ら"],["の"],["住む","すむ"],["所","ところ"],["を"],["、"],["荒野","あら"],["の"],["から"],["リブラ"],["まで"],["荒れ地","あれち"],["と"],["する"],["。"],["これ"],["によって"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["知る","しる"],["よう"],["に"],["なる"],["」"],["。"]]}]
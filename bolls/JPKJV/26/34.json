[{"verse":1,"text":"主,しゅの言葉,ことばがわたしに臨,のぞんだ、","tok":[["主","しゅ"],["の"],["言葉","ことば"],["が"],["わたし"],["に"],["臨んだ","のぞんだ"],["、"]]},{"verse":2,"text":"「人,ひとの子,こよ、イスラエルの牧者,ぼくしゃたちに向,むかって預言,よげんせよ。預言,よげんして彼,かれら牧者,ぼくしゃに言,いえ、主,しゅなる神,かみはこう言,いわれる、わざわいなるかな、自分,じぶん自身,じしんを養,やしなうイスラエルの牧者,ぼくしゃ。牧者,ぼくしゃは群,むれを養,やしなうべき者,ものではないか。","tok":[["「"],["人","ひと"],["の"],["子","こ"],["よ"],["、"],["イスラエル"],["の"],["牧者","ぼくしゃ"],["たち"],["に"],["向かって","むかって"],["預言","よげん"],["せよ"],["。"],["預言","よげん"],["して"],["彼","かれ"],["ら"],["牧者","ぼくしゃ"],["に"],["言え","いえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["わざわい"],["なる"],["か"],["な"],["、"],["自分","じぶん"],["自身","じしん"],["を"],["養う","やしなう"],["イスラエル"],["の"],["牧者","ぼくしゃ"],["。"],["牧者","ぼくしゃ"],["は"],["群れ","むれ"],["を"],["養うべき","やしなうべき"],["者","もの"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":3,"text":"ところが、あなたがたは脂肪,しぼうを食,たべ、毛織物,けおりものをまとい、肥,こえたものをほふるが、群,むれを養,やしなわない。","tok":[["ところ"],["が"],["、"],["あなた"],["がた"],["は"],["脂肪","しぼう"],["を"],["食べ","たべ"],["、"],["毛織物","けおりもの"],["を"],["まとい"],["、"],["肥","こえ"],["た"],["もの"],["を"],["ほふる"],["が"],["、"],["群れ","むれ"],["を"],["養わない","やしなわない"],["。"]]},{"verse":4,"text":"あなたがたは弱,よわった者,ものを強,つよくせず、病,やんでいる者,ものをいやさず、傷,きずついた者,ものをつつまず、迷,まよい出,でた者,ものを引,ひき返,かえらせず、うせた者,ものを尋,たずねず、彼,かれらを手荒,てあらく、きびしく治,おさめている。","tok":[["あなた"],["がた"],["は"],["弱った","よわった"],["者","もの"],["を"],["強く","つよく"],["せず"],["、"],["病","やん"],["で"],["いる"],["者","もの"],["を"],["いやさず"],["、"],["傷ついた","きずついた"],["者","もの"],["を"],["つつまず"],["、"],["迷い出た","まよいでた"],["者","もの"],["を"],["引","ひき"],["返らせず","かえらせず"],["、"],["うせた"],["者","もの"],["を"],["尋ねず","たずねず"],["、"],["彼","かれ"],["ら"],["を"],["手荒く","てあらく"],["、"],["きびしく"],["治めて","おさめて"],["いる"],["。"]]},{"verse":5,"text":"彼,かれらは牧者,ぼくしゃがないために散,ちり、野,ののもろもろの獣,けもののえじきになる。","tok":[["彼","かれ"],["ら"],["は"],["牧者","ぼくしゃ"],["が"],["ない"],["ため"],["に"],["散り","ちり"],["、"],["野","の"],["の"],["もろもろ"],["の"],["獣","けもの"],["の"],["えじき"],["に"],["なる"],["。"]]},{"verse":6,"text":"わが羊,ひつじは散,ちらされている。彼,かれらはもろもろの山,やまと、もろもろの高,たかき丘,おかにさまよい、わが羊,ひつじは地,ちの全面,ぜんめんに散,ちらされているが、これを捜,さがす者,ものもなく、尋,たずねる者,ものもない。","tok":[["わが"],["羊","ひつじ"],["は"],["散らされて","ちらされて"],["いる"],["。"],["彼","かれ"],["ら"],["は"],["もろもろ"],["の"],["山","やま"],["と"],["、"],["もろもろ"],["の"],["高き","たかき"],["丘","おか"],["に"],["さまよい"],["、"],["わが"],["羊","ひつじ"],["は"],["地","ち"],["の"],["全面","ぜんめん"],["に"],["散らされて","ちらされて"],["いる"],["が"],["、"],["これ"],["を"],["捜す","さがす"],["者","もの"],["も"],["なく"],["、"],["尋ねる","たずねる"],["者","もの"],["も"],["ない"],["。"]]},{"verse":7,"text":"それゆえ、牧者,ぼくしゃよ、主,しゅの言葉,ことばを聞,きけ。","tok":[["それ"],["ゆえ"],["、"],["牧者","ぼくしゃ"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":8,"text":"主,しゅなる神,かみは言,いわれる、わたしは生,いきている。わが羊,ひつじはかすめられ、わが羊,ひつじは野,ののもろもろの獣,けもののえじきとなっているが、その牧者,ぼくしゃはいない。わが牧者,ぼくしゃはわが羊,ひつじを尋,たずねない。牧者,ぼくしゃは自身,じしんを養,やしなうが、わが羊,ひつじを養,やしなわない。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["、"],["わたし"],["は"],["生きて","いきて"],["いる"],["。"],["わが"],["羊","ひつじ"],["は"],["かすめられ"],["、"],["わが"],["羊","ひつじ"],["は"],["野","の"],["の"],["もろもろ"],["の"],["獣","けもの"],["の"],["えじき"],["と"],["なって"],["いる"],["が"],["、"],["その"],["牧者","ぼくしゃ"],["は"],["いない"],["。"],["わが"],["牧者","ぼくしゃ"],["は"],["わが"],["羊","ひつじ"],["を"],["尋ねない","たずねない"],["。"],["牧者","ぼくしゃ"],["は"],["自身","じしん"],["を"],["養う","やしなう"],["が"],["、"],["わが"],["羊","ひつじ"],["を"],["養わない","やしなわない"],["。"]]},{"verse":9,"text":"それゆえ牧者,ぼくしゃらよ、主,しゅの言葉,ことばを聞,きけ。","tok":[["それ"],["ゆえ"],["牧者","ぼくしゃ"],["ら"],["よ"],["、"],["主","しゅ"],["の"],["言葉","ことば"],["を"],["聞け","きけ"],["。"]]},{"verse":10,"text":"主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしは牧者,ぼくしゃらの敵,てきとなり、わたしの羊,ひつじを彼,かれらの手,てに求,もとめ、彼,かれらにわたしの群,むれを養,やしなうことをやめさせ、再,ふたたび牧者,ぼくしゃ自身,じしんを養,やしなわせない。またわが羊,ひつじを彼,かれらの口,くちから救,すくって、彼,かれらの食物,しょくもつにさせない。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["牧者","ぼくしゃ"],["ら"],["の"],["敵","てき"],["と"],["なり"],["、"],["わたし"],["の"],["羊","ひつじ"],["を"],["彼","かれ"],["ら"],["の"],["手","て"],["に"],["求め","もとめ"],["、"],["彼","かれ"],["ら"],["に"],["わたし"],["の"],["群れ","むれ"],["を"],["養う","やしなう"],["こと"],["を"],["やめさせ"],["、"],["再び","ふたたび"],["牧者","ぼくしゃ"],["自身","じしん"],["を"],["養わせない","やしなわせない"],["。"],["また"],["わが"],["羊","ひつじ"],["を"],["彼","かれ"],["ら"],["の"],["口","くち"],["から"],["救って","すくって"],["、"],["彼","かれ"],["ら"],["の"],["食物","しょくもつ"],["に"],["させない"],["。"]]},{"verse":11,"text":"主,しゅなる神,かみはこう言,いわれる、見,みよ、わたしは、わたしみずからわが羊,ひつじを尋,たずねて、これを捜,さがし出,だす。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["、"],["わたし"],["みずから"],["わが"],["羊","ひつじ"],["を"],["尋ねて","たずねて"],["、"],["これ"],["を"],["捜し出す","さがしだす"],["。"]]},{"verse":12,"text":"牧者,ぼくしゃがその羊,ひつじの散,ちり去,さった時,とき、その羊,ひつじの群,むれを捜,さがし出,だすように、わたしはわが羊,ひつじを捜,さがし出,だし、雲,くもと暗,くらやみの日,ひに散,ちった、すべての所,ところからこれを救,すくう。","tok":[["牧者","ぼくしゃ"],["が"],["その"],["羊","ひつじ"],["の"],["散り","ちり"],["去た","さった"],["時","とき"],["、"],["その"],["羊","ひつじ"],["の"],["群れ","むれ"],["を"],["捜し出す","さがしだす"],["よう"],["に"],["、"],["わたし"],["は"],["わが"],["羊","ひつじ"],["を"],["捜し出し","さがしだし"],["、"],["雲","くも"],["と"],["暗やみ","くらやみ"],["の"],["日","ひ"],["に"],["散った","ちった"],["、"],["すべて"],["の"],["所","ところ"],["から"],["これ"],["を"],["救う","すくう"],["。"]]},{"verse":13,"text":"わたしは彼,かれらをもろもろの民,たみの中,なかから導,みちびき出,だし、もろもろの国,くにから集,あつめて、彼,かれらの国,くにに携,たずさえ入,いれ、イスラエルの山,やまの上,うえ、泉,いずみのほとり、また国,くにのうちの人,ひとの住,すむすべての所,ところでこれを養,やしなう。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["を"],["もろもろ"],["の"],["民","たみ"],["の"],["中","なか"],["から"],["導き出し","みちびきだし"],["、"],["もろもろ"],["の"],["国","くに"],["から"],["集めて","あつめて"],["、"],["彼","かれ"],["ら"],["の"],["国","くに"],["に"],["携え","たずさえ"],["入れ","いれ"],["、"],["イスラエル"],["の"],["山","やま"],["の"],["上","うえ"],["、"],["泉","いずみ"],["の"],["ほとり"],["、"],["また"],["国","くに"],["の"],["うち"],["の"],["人","ひと"],["の"],["住む","すむ"],["すべて"],["の"],["所","ところ"],["で"],["これ"],["を"],["養う","やしなう"],["。"]]},{"verse":14,"text":"わたしは良,よき牧場,まきばで彼,かれらを養,やしなう。その牧場,まきばはイスラエルの高,たかい山,やまにあり、その所,ところで彼,かれらは良,よい羊,ひつじのおりに伏,ふし、イスラエルの山々,やまやまの上,うえで肥,こえた牧場,まきばで草,くさを食,くう。","tok":[["わたし"],["は"],["良き","よき"],["牧場","ま"],["きば"],["で"],["彼","かれ"],["ら"],["を"],["養う","やしなう"],["。"],["その"],["牧場","まきば"],["は"],["イスラエル"],["の"],["高い","たかい"],["山","やま"],["に"],["あり"],["、"],["その"],["所","ところ"],["で"],["彼","かれ"],["ら"],["は"],["良い","よい"],["羊","ひつじ"],["の"],["おり"],["に"],["伏し","ふし"],["、"],["イスラエル"],["の"],["山々","やまやま"],["の"],["上","うえ"],["で"],["肥","こえ"],["た"],["牧場","ま"],["きば"],["で"],["草","くさ"],["を"],["食う","くう"],["。"]]},{"verse":15,"text":"わたしはみずからわが羊,ひつじを飼,かい、これを伏,ふさせると主,しゅなる神,かみは言,いわれる。","tok":[["わたし"],["は"],["みずから"],["わが"],["羊","ひつじ"],["を"],["飼","かい"],["、"],["これ"],["を"],["伏させる","ふさせる"],["と"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":16,"text":"わたしは、うせたものを尋,たずね、迷,まよい出,でたものを引,ひき返,かえし、傷,きずついたものを包,つつみ、弱,よわったものを強,つよくし、肥,こえたものと強,つよいものとは、これを監督,かんとくする。わたしは公平,こうへいをもって彼,かれらを養,やしなう。","tok":[["わたし"],["は"],["、"],["うせた"],["もの"],["を"],["尋ね","たずね"],["、"],["迷い出た","まよいでた"],["もの"],["を"],["引","ひき"],["返","かえし"],["、"],["傷ついた","きずついた"],["もの"],["を"],["包","つつみ"],["、"],["弱った","よわった"],["もの"],["を"],["強く","つよく"],["し"],["、"],["肥","こえ"],["た"],["もの"],["と"],["強い","つよい"],["もの"],["と"],["は"],["、"],["これ"],["を"],["監督","かんとく"],["する"],["。"],["わたし"],["は"],["公平","こうへい"],["を"],["もって"],["彼","かれ"],["ら"],["を"],["養う","やしなう"],["。"]]},{"verse":17,"text":"主,しゅなる神,かみはこう言,いわれる、あなたがた、わが群,むれよ、見,みよ、わたしは羊,ひつじと羊,ひつじとの間,あいだ、雄羊,おひつじと雄,おやぎとの間,あいだをさばく。","tok":[["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["言われる","いわれる"],["、"],["あなた"],["がた"],["、"],["わが"],["群れよ","むれよ"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["羊","ひつじ"],["と"],["羊","ひつじ"],["と"],["の"],["間","あいだ"],["、"],["雄羊","おひつじ"],["と"],["雄","おやぎと"],["の"],["間","あいだ"],["を"],["さばく"],["。"]]},{"verse":18,"text":"あなたがたは良,よき牧場,まきばで草,くさを食,くい、その草,くさの残,のこりを足,あしで踏,ふみ、また澄,すんだ水,みずを飲,のみ、その残,のこりを足,あしで濁,にごすが、これは、あまりのことではないか。","tok":[["あなた"],["がた"],["は"],["良き","よき"],["牧場","ま"],["きば"],["で"],["草","くさ"],["を"],["食い","くい"],["、"],["その"],["草","くさ"],["の"],["残り","のこり"],["を"],["足","あし"],["で"],["踏み","ふみ"],["、"],["また"],["澄んだ","すんだ"],["水","みず"],["を"],["飲み","のみ"],["、"],["その"],["残り","のこり"],["を"],["足","あし"],["で"],["濁す","にごす"],["が"],["、"],["これ"],["は"],["、"],["あまり"],["の"],["こと"],["で"],["は"],["ない"],["か"],["。"]]},{"verse":19,"text":"わが羊,ひつじはあなたがたが、足,あしで踏,ふんだものを食,くい、あなたがたの足,あしで濁,にごしたものを、飲,のまなければならないのか。","tok":[["わが"],["羊","ひつじ"],["は"],["あなた"],["が"],["た"],["が"],["、"],["足","あし"],["で"],["踏","ふんだも"],["の"],["を"],["食い","くい"],["、"],["あなた"],["がた"],["の"],["足","あし"],["で"],["濁した","にごした"],["もの"],["を"],["、"],["飲まなければ","のまなければ"],["ならない"],["の"],["か"],["。"]]},{"verse":20,"text":"それゆえ、主,しゅなる神,かみはこう彼,かれらに言,いわれる、見,みよ、わたしは肥,こえた羊,ひつじと、やせた羊,ひつじとの間,あいだをさばく。","tok":[["それ"],["ゆえ"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["こう"],["彼","かれ"],["ら"],["に"],["言われる","いわれる"],["、"],["見よ","みよ"],["、"],["わたし"],["は"],["肥","こえ"],["た"],["羊","ひつじ"],["と"],["、"],["やせた"],["羊","ひつじ"],["と"],["の"],["間","あいだ"],["を"],["さばく"],["。"]]},{"verse":21,"text":"あなたがたは、わきと肩,かたとをもって押,おし、角,つのをもって、すべて弱,よわい者,ものを突,つき、ついに彼,かれらを外,そとに追,おい散,ちらした。","tok":[["あなた"],["がた"],["は"],["、"],["わき"],["と"],["肩","かた"],["と"],["を"],["もって"],["押","おし"],["、"],["角","つ"],["の"],["を"],["もって"],["、"],["すべて"],["弱い","よわい"],["者","もの"],["を"],["突き","つき"],["、"],["ついに"],["彼","かれ"],["ら"],["を"],["外","そと"],["に"],["追い散らした","おいちらした"],["。"]]},{"verse":22,"text":"それゆえ、わたしはわが群,むれを助,たすけて、再,ふたたびかすめさせず、羊,ひつじと羊,ひつじとの間,あいだをさばく。","tok":[["それ"],["ゆえ"],["、"],["わたし"],["は"],["わが"],["群れ","むれ"],["を"],["助けて","たすけて"],["、"],["再び","ふたたび"],["かすめさせず"],["、"],["羊","ひつじ"],["と"],["羊","ひつじ"],["と"],["の"],["間","あいだ"],["を"],["さばく"],["。"]]},{"verse":23,"text":"わたしは彼,かれらの上,うえにひとりの牧者,ぼくしゃを立,たてる。すなわちわがしもべダビデである。彼,かれは彼,かれらを養,やしなう。彼,かれは彼,かれらを養,やしない、彼,かれらの牧者,ぼくしゃとなる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["上","うえ"],["に"],["ひとり"],["の"],["牧者","ぼくしゃ"],["を"],["立る","たてる"],["。"],["すなわち"],["わが"],["しもべ"],["ダビデ"],["で"],["ある"],["。"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["を"],["養う","やしなう"],["。"],["彼","かれ"],["は"],["彼","かれ"],["ら"],["を"],["養い","やしない"],["、"],["彼","かれ"],["ら"],["の"],["牧者","ぼくしゃ"],["と"],["なる"],["。"]]},{"verse":24,"text":"主,しゅなるわたしは彼,かれらの神,かみとなり、わがしもべダビデは彼,かれらのうちにあって君,きみとなる。主,しゅなるわたしはこれを言,いう。","tok":[["主","しゅ"],["なる"],["わたし"],["は"],["彼","かれ"],["ら"],["の"],["神","かみ"],["と"],["なり"],["、"],["わが"],["しもべ"],["ダビデ"],["は"],["彼","かれ"],["ら"],["の"],["うち"],["に"],["あって"],["君","きみ"],["と"],["なる"],["。"],["主","しゅ"],["なる"],["わたし"],["は"],["これ"],["を"],["言う","いう"],["。"]]},{"verse":25,"text":"わたしは彼,かれらと平和,へいわの契約,けいやくを結,むすび、国,くにの内,うちから野獣,やじゅうを追,おい払,はらう。彼,かれらは心,こころを安,やすんじて荒野,あらのに住,すみ、森,もりの中,なかに眠,ねむる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["と"],["平和","へいわ"],["の"],["契約","けいやく"],["を"],["結び","むすび"],["、"],["国","くに"],["の"],["内","うち"],["から"],["野獣","やじゅう"],["を"],["追い払う","おいはらう"],["。"],["彼","かれ"],["ら"],["は"],["心","こころ"],["を"],["安んじて","やすんじて"],["荒野","あら"],["のに"],["住み","すみ"],["、"],["森","もり"],["の"],["中","なか"],["に"],["眠る","ねむる"],["。"]]},{"verse":26,"text":"わたしは彼,かれらおよびわが山,やまの周囲,しゅういの所々,ところどころを祝福,しゅくふくし、季節,きせつにしたがって雨,あめを降,ふらす。これは祝福,しゅくふくの雨,あめとなる。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["および"],["わが"],["山","やま"],["の"],["周囲","しゅうい"],["の"],["所々","ところどころ"],["を"],["祝福","しゅくふく"],["し"],["、"],["季節","きせつ"],["に"],["したがって"],["雨","あめ"],["を"],["降らす","ふらす"],["。"],["これ"],["は"],["祝福","しゅくふく"],["の"],["雨","あめ"],["と"],["なる"],["。"]]},{"verse":27,"text":"野,のの木,きは実,みを結,むすび、地,ちは産物,さんぶつを出,だす。彼,かれらは心,こころを安,やすんじてその国,くににおり、わたしが彼,かれらのくびきの棒,ぼうを砕,くだき、彼,かれらを奴隷,どれいとした者,ものの手,てから救,すくい出,だす時,とき、彼,かれらはわたしが主,しゅであることを悟,さとる。","tok":[["野","の"],["の"],["木","き"],["は"],["実","み"],["を"],["結び","むすび"],["、"],["地","ち"],["は"],["産物","さんぶつ"],["を"],["出す","だす"],["。"],["彼","かれ"],["ら"],["は"],["心","こころ"],["を"],["安んじて","やすんじて"],["その"],["国","くに"],["に"],["おり"],["、"],["わたし"],["が"],["彼","かれ"],["ら"],["の"],["くびき"],["の"],["棒","ぼう"],["を"],["砕き","くだき"],["、"],["彼","かれ"],["ら"],["を"],["奴隷","どれい"],["と"],["した"],["者","もの"],["の"],["手","て"],["から"],["救い出す","すくいだす"],["時","とき"],["、"],["彼","かれ"],["ら"],["は"],["わたし"],["が"],["主","しゅ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["。"]]},{"verse":28,"text":"彼,かれらは重,かさねて、もろもろの国民,こくみんにかすめられることなく、地,ちの獣,けものも彼,かれらを食,くうことはない。彼,かれらは心,こころを安,やすんじて住,すみ、彼,かれらを恐,おそれさせる者,ものはない。","tok":[["彼","かれ"],["ら"],["は"],["重ねて","かさねて"],["、"],["もろもろ"],["の"],["国民","こくみん"],["に"],["かすめられる"],["こと"],["なく"],["、"],["地","ち"],["の"],["獣","けもの"],["も"],["彼","かれ"],["ら"],["を"],["食う","くう"],["こと"],["は"],["ない"],["。"],["彼","かれ"],["ら"],["は"],["心","こころ"],["を"],["安んじて","やすんじて"],["住み","すみ"],["、"],["彼","かれ"],["ら"],["を"],["恐れさせる","おそれさせる"],["者","もの"],["は"],["ない"],["。"]]},{"verse":29,"text":"わたしは彼,かれらのために、良,よい栽培,さいばい所,じょを与,あたえる。彼,かれらは重,かさねて、国,くにのききんに滅,ほろびることなく重,かさねて諸,しょ国民,こくみんのはずかしめを受,うけることはない。","tok":[["わたし"],["は"],["彼","かれ"],["ら"],["の"],["ため"],["に"],["、"],["良い","よい"],["栽培所","さいばいじょ"],["を"],["与える","あたえる"],["。"],["彼","かれ"],["ら"],["は"],["重ねて","かさねて"],["、"],["国","くに"],["の"],["ききん"],["に"],["滅びる","ほろびる"],["こと"],["なく"],["重ねて","かさねて"],["諸","しょ"],["国民","こくみん"],["の"],["はずかし"],["め"],["を"],["受る","うける"],["こと"],["は"],["ない"],["。"]]},{"verse":30,"text":"彼,かれらはその神,かみ、主,しゅなるわたしが彼,かれらと共,ともにおり、彼,かれらイスラエルの家,いえが、わが民,たみであることを悟,さとると、主,しゅなる神,かみは言,いわれる。","tok":[["彼","かれ"],["ら"],["は"],["その"],["神","かみ"],["、"],["主","しゅ"],["なる"],["わたし"],["が"],["彼","かれ"],["ら"],["と"],["共","とも"],["に"],["おり"],["、"],["彼","かれ"],["ら"],["イスラエル"],["の"],["家","いえ"],["が"],["、"],["わが"],["民","たみ"],["で"],["ある"],["こと"],["を"],["悟","さとる"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["。"]]},{"verse":31,"text":"あなたがたはわが羊,ひつじ、わが牧場,まきばの羊,ひつじである。わたしはあなたがたの神,かみであると、主,しゅなる神,かみは言,いわれる」。","tok":[["あなた"],["がた"],["は"],["わが"],["羊","ひつじ"],["、"],["わが"],["牧場","まきば"],["の"],["羊","ひつじ"],["で"],["ある"],["。"],["わたし"],["は"],["あなた"],["がた"],["の"],["神","かみ"],["で"],["ある"],["と"],["、"],["主","しゅ"],["なる"],["神","かみ"],["は"],["言われる","いわれる"],["」"],["。"]]}]